1
00:00:03,560 --> 00:00:04,950
‫افرحا أيها الشابان

2
00:00:05,170 --> 00:00:08,300
‫وصلتنا أخيراً تفاصيل حفل
‫الذكرى السنوية الثانية

3
00:00:09,430 --> 00:00:13,170
‫أشعر أن الحفل يقترب بسرعة بالغة

4
00:00:14,510 --> 00:00:18,120
‫بعد أسبوعين من الآن
‫ستقفان على مسرح قاعة (ميوجو)

5
00:00:18,420 --> 00:00:21,250
‫لم تتقنا تصميم الرقص الجديد بعد

6
00:00:21,330 --> 00:00:23,940
‫لذا سأجعل الدروس
‫أكثر صرامة مما كانت عليه

7
00:00:24,250 --> 00:00:25,160
‫حسن

8
00:00:25,680 --> 00:00:27,460
‫سنبذل ما في وسعنا

9
00:00:34,020 --> 00:00:35,930
‫حفل الذكرى السنوية الثانية...

10
00:00:37,150 --> 00:00:38,890
‫إذاً كنت محبوب جماهير...

11
00:00:39,410 --> 00:00:41,320
‫لكل هذا الوقت؟

12
00:00:43,360 --> 00:00:45,930
‫"معاً تحت السماء الدرامية"

13
00:00:46,010 --> 00:00:48,180
‫"معك"

14
00:00:48,280 --> 00:00:50,270
‫"(هيا جميعكم، لنستمتع)"

15
00:00:52,450 --> 00:00:53,610
‫"حسن"

16
00:00:54,920 --> 00:00:56,740
‫"لنبدأ، الآن"

17
00:00:58,960 --> 00:00:59,750
‫"حسن"

18
00:00:59,830 --> 00:01:01,310
‫"معكم، حسن"

19
00:01:01,390 --> 00:01:03,040
‫"(ها نحن أولاء، نعم)"

20
00:01:03,130 --> 00:01:04,260
‫"(زينغ) من أجل ابتسامة"

21
00:01:04,340 --> 00:01:08,470
‫"هل نسيت كيف هو شعور النبض؟"

22
00:01:08,560 --> 00:01:12,520
‫"الصوت الذي تسمعينه
‫عندما يتسارع قلبك"

23
00:01:12,600 --> 00:01:15,730
‫"لنضعه في طبقات معاً بأغنيتنا"

24
00:01:15,770 --> 00:01:17,940
‫"ثم نطلق سيقاننا للريح"

25
00:01:18,030 --> 00:01:20,940
‫_ "حماس، لا حدود"
‫_ "الاندفاع يتصاعد"

26
00:01:21,030 --> 00:01:22,640
‫"مليء بالروح، لكن من دونك؟"

27
00:01:22,730 --> 00:01:24,590
‫"سيكون هذا مملاً"

28
00:01:24,680 --> 00:01:28,020
‫"أملنا أن نصبح ثنائياً
‫جاهزاً للانطلاق، نعم"

29
00:01:28,120 --> 00:01:31,150
‫"لنرقص معاً إلى الأبد"

30
00:01:31,250 --> 00:01:33,800
‫"إن حدث وتعثّرت"

31
00:01:33,890 --> 00:01:37,500
‫"وابتعدت أيدينا بعيداً جداً عن بعضها"

32
00:01:37,630 --> 00:01:40,670
‫"سنضع ثقتنا بك"

33
00:01:40,840 --> 00:01:44,320
‫"لنقطع عهداً سرياً"

34
00:01:44,360 --> 00:01:45,890
‫"(لنغنّ أغنية الآن)"

35
00:01:45,930 --> 00:01:48,360
‫"معاً تحت الشمس الدرامية"

36
00:01:48,440 --> 00:01:49,620
‫"معك"

37
00:01:49,750 --> 00:01:52,230
‫"في الصباح والظهر وحتى الليل"

38
00:01:52,350 --> 00:01:55,010
‫"سنجعلك تقول إنك تحب هذا"

39
00:01:55,090 --> 00:01:57,560
‫"أكثر ودوماً"

40
00:01:57,660 --> 00:01:58,960
‫"ليغنّ الجميع، صفّقوا بأيديكم"

41
00:01:59,090 --> 00:02:01,910
‫"شعاع النور الآتي من النجمين"

42
00:02:02,000 --> 00:02:05,340
‫"إنها أنوار النجوم التي ستقودكم
‫إلى مستقبل أكثر إشراقاً"

43
00:02:05,520 --> 00:02:07,260
‫_ "دافع فيّاض"
‫_ "أغنية عجائبية"

44
00:02:07,340 --> 00:02:08,910
‫"آمل أن تجعلك تبتسم دوماً"

45
00:02:08,950 --> 00:02:10,990
‫"(زينغ) من أجل ابتسامة"

46
00:02:12,900 --> 00:02:16,730
‫"المرحلة التاسعة"

47
00:02:16,860 --> 00:02:18,860
‫كيف حالكم جميعاً؟

48
00:02:19,340 --> 00:02:21,340
‫نحن فرقة (سويت فارمسي)

49
00:02:22,200 --> 00:02:24,670
‫إنهن جميلات جداً، إنهن الأفضل

50
00:02:24,990 --> 00:02:27,500
‫هل أستطيع مشاهدة
‫القناة المحلية يا (أساهي)؟

51
00:02:27,900 --> 00:02:31,720
‫حسن، (نيودو)، غيّر القناة

52
00:02:31,850 --> 00:02:32,670
‫حسن، حسن

53
00:02:32,810 --> 00:02:34,150
‫بسرعة

54
00:02:34,760 --> 00:02:35,980
‫لقد بدأ

55
00:02:36,020 --> 00:02:37,720
‫هل سيكون (يوشينو) بخير؟

56
00:02:38,630 --> 00:02:39,370
‫أيها السيّد

57
00:02:42,280 --> 00:02:44,360
‫(يوشينو)، اسمي (يوشينو)

58
00:02:44,360 --> 00:02:46,660
‫(يوشينو) خاصتنا يتحرك

59
00:02:47,100 --> 00:02:49,360
‫أنت كثيرة الجلبة! شاهدي بصمت

60
00:02:50,620 --> 00:02:54,130
‫أشعر كأنني أمه وأشاهده
‫في أول يوم له في المدرسة

61
00:02:54,220 --> 00:02:56,700
‫يستطيع حفظ سطوره

62
00:02:56,790 --> 00:02:58,570
‫لو كنت مكانه لفضلت ألا أفعل

63
00:02:58,660 --> 00:03:02,130
‫أن تفكر أن (يوشينو) الذي يعاني
‫رهاب المسرح سيبدأ عملاً بمفرده!

64
00:03:02,210 --> 00:03:04,780
‫في البداية، كان سماع الأمر مفاجئاً

65
00:03:04,870 --> 00:03:05,910
‫بالفعل

66
00:03:06,000 --> 00:03:09,510
‫ذهب إلى التصوير مثل عجل
‫يساق إلى البيع

67
00:03:10,080 --> 00:03:12,510
‫ساعدني يا (يو)

68
00:03:13,250 --> 00:03:17,510
‫كانت الرئيسة تريد جعله
‫يغني بمفرده

69
00:03:17,690 --> 00:03:19,770
‫أنا واثق أنه سيحصل على أعمال
‫أكثر بعد ذلك

70
00:03:19,810 --> 00:03:22,080
‫لا تدع نفسك تترك في الخلف

71
00:03:22,940 --> 00:03:23,860
‫أعلم

72
00:03:23,940 --> 00:03:27,070
‫لنقم بتلك الحاصلة على "المرتبة العليا"

73
00:03:27,110 --> 00:03:27,810
‫ماذا؟

74
00:03:28,030 --> 00:03:31,110
‫الرئيسة و(يوشيمو)
‫أوصيا بذلك أيضاً، أليس كذلك؟

75
00:03:31,240 --> 00:03:31,980
‫اتفقنا؟

76
00:03:32,800 --> 00:03:36,060
‫أرجوك، أرجوك، دعني أجرّبها

77
00:03:36,280 --> 00:03:37,760
‫لبعض الوقت فقط إذاً

78
00:03:38,060 --> 00:03:39,280
‫مرحى!

79
00:03:40,710 --> 00:03:43,450
‫بقي أسبوع حتى موعد حفل
‫الذكرى السنوية الثانية

80
00:03:43,530 --> 00:03:45,540
‫الأكثر من ذلك فإن (يوشيمو)...

81
00:03:45,620 --> 00:03:46,700
‫ظهر للمرة الأولى على التلفاز

82
00:03:47,100 --> 00:03:49,490
‫كان مسلسله عظيماً جداً

83
00:03:49,610 --> 00:03:51,880
‫وارتدى زيّاً مدرسياً

84
00:03:52,220 --> 00:03:55,610
‫لم يرتده على التقويم

85
00:03:55,700 --> 00:03:58,270
‫هل معجباته بخير؟

86
00:03:58,350 --> 00:04:00,780
‫يثور جنونهن نحوه

87
00:04:02,560 --> 00:04:04,650
‫زيّ مدرسي؟

88
00:04:05,090 --> 00:04:06,170
‫"في السنة الأخيرة"؟

89
00:04:06,390 --> 00:04:10,520
‫بالطبع هن كذلك! شهدن محبوبهن
‫المفضل على التلفاز

90
00:04:10,600 --> 00:04:13,210
‫آمل أن يظهر (نيودو)
‫على التلفاز يوماً ما

91
00:04:13,290 --> 00:04:16,500
‫أريد رؤيته يطبخ وهو يضع مئزراً

92
00:04:16,600 --> 00:04:18,030
‫لا أستطيع تخيل هذا

93
00:04:18,200 --> 00:04:19,210
‫هذا منطقي

94
00:04:19,250 --> 00:04:23,500
‫لكن منذ أن حصلنا على التقويم
‫تحسّن تساهلنا

95
00:04:23,600 --> 00:04:24,940
‫يجب أن نكون بخير، صحيح؟

96
00:04:25,070 --> 00:04:27,930
‫لكن بدلاً من التعرض للصدمة

97
00:04:28,030 --> 00:04:32,280
‫أفضّل أن يسكب الماء على قلبي
‫من بعيد جداً

98
00:04:32,420 --> 00:04:33,500
‫أستطيع فهمك

99
00:04:37,450 --> 00:04:39,180
‫ما هذا؟

100
00:04:43,230 --> 00:04:44,930
‫يا لها من مفاجأة!

101
00:04:45,010 --> 00:04:47,920
‫كثير من الناس علّقوا
‫على صورتك الذاتية

102
00:04:48,060 --> 00:04:49,920
‫لنلتقط الكثير منها

103
00:04:50,010 --> 00:04:53,270
‫المبالغة في المشاركة
‫يمكنها التسبّب بمشاكل يا (أساهي)

104
00:04:53,350 --> 00:04:54,700
‫منهك بعد صورة ذاتية...

105
00:04:56,400 --> 00:04:58,130
‫إذاً ما رأيك بمنشور مدوّنة؟

106
00:04:58,270 --> 00:04:59,790
‫لا

107
00:04:59,870 --> 00:05:01,480
‫وظفي كاتباً خفياً

108
00:05:01,610 --> 00:05:03,740
‫حسن، أنا شبح

109
00:05:05,040 --> 00:05:06,350
‫كتب (نيودو)...

110
00:05:06,430 --> 00:05:08,250
‫منشوراً على مدوّنة

111
00:05:08,300 --> 00:05:11,380
‫محبوبي الجماهيريّ المفضل يكتب
‫هذا شيء لا يصدّق

112
00:05:11,420 --> 00:05:12,340
‫تلك الليلة...

113
00:05:12,430 --> 00:05:15,990
‫استمرت الصرخات من معجبات (نيودو)
‫في جميع أرجاء المدينة

114
00:05:21,030 --> 00:05:24,810
‫قابس طاقة؟

115
00:05:25,200 --> 00:05:28,110
‫عندما اعتقدت أنه ليست هناك
‫تحديثات على مدوّنته

116
00:05:28,280 --> 00:05:29,890
‫(نيودو)

117
00:05:30,150 --> 00:05:33,240
‫كنت مفعماً بالحيوية يا (هيكارو)

118
00:05:36,710 --> 00:05:38,270
‫مرحباً أيها الرفاق

119
00:05:38,490 --> 00:05:39,490
‫أهلاً بعودتك

120
00:05:39,970 --> 00:05:44,750
‫(أكيرا)، قال المدير إننا نستطيع
‫العودة باكراً إلى المنزل اليوم

121
00:05:44,750 --> 00:05:45,750
‫مرحى!

122
00:05:45,790 --> 00:05:47,220
‫لنذهب ونتناول بعض شعيرية الرامن

123
00:05:47,360 --> 00:05:48,960
‫أين (هيكارو)؟

124
00:05:49,050 --> 00:05:50,140
‫خرج أولاً

125
00:05:51,010 --> 00:05:52,390
‫ذهب من أجل "ذاك"

126
00:05:52,490 --> 00:05:55,440
‫"الأشياء الهامة لا يمكن تفويتها"

127
00:06:00,610 --> 00:06:02,820
‫_ شاهدت مسلسلك يا (يوشينو)
‫_ "مناسبة لقاء وتحية لـ(زينغ)"

128
00:06:03,170 --> 00:06:04,950
‫الطريقة التي تقول فيها "سيدي" مذهلة

129
00:06:05,040 --> 00:06:06,870
‫وتبدو محبّباً في الزيّ المدرسي

130
00:06:06,950 --> 00:06:09,470
‫أريد قرص الـ(بلو راي) منذ الآن!

131
00:06:09,560 --> 00:06:13,030
‫شكراً لك على تغذية حياتي
‫كل أسبوع

132
00:06:13,120 --> 00:06:16,070
‫الأمر ذاته، شكراً لك

133
00:06:16,160 --> 00:06:19,600
‫سأستمر بالعمل الجاد
‫على عروضنا ومسلسلاتنا

134
00:06:19,680 --> 00:06:21,330
‫آمل دعمك المستمر

135
00:06:21,420 --> 00:06:22,510
‫بالطبع

136
00:06:22,590 --> 00:06:25,680
‫أنا متحمسm جداً
‫بحيث لا أستطيع النوم ليلاً

137
00:06:25,760 --> 00:06:26,800
‫أرجوك ابذل ما في وسعك!

138
00:06:26,900 --> 00:06:28,800
‫و...

139
00:06:28,890 --> 00:06:30,630
‫حسن، التالي

140
00:06:30,670 --> 00:06:33,020
‫(يوشينو)، أنا أشجعك دوماً

141
00:06:33,880 --> 00:06:35,840
‫شكراً جزيلاً لك

142
00:06:39,270 --> 00:06:42,100
‫تأثير مسلسل (يوشينو)
‫شيء مختلف بالتأكيد

143
00:06:43,140 --> 00:06:46,310
‫صحيح أن مسلسله يعطي بعض التأثير

144
00:06:46,610 --> 00:06:48,660
‫لكن معجباتك قد ازداد عددهن أيضاً

145
00:06:49,090 --> 00:06:49,700
‫حقاً؟

146
00:06:49,780 --> 00:06:52,610
‫انظر، دورك أطول

147
00:06:53,050 --> 00:06:54,610
‫(سيتوتشي)؟

148
00:07:01,990 --> 00:07:03,780
‫(يويا نيودو)

149
00:07:03,870 --> 00:07:06,080
‫تبدو فاتراً كالعادة

150
00:07:06,600 --> 00:07:08,510
‫تبدو رائعاً كالعادة أيضاً

151
00:07:08,600 --> 00:07:09,690
‫يدي تؤلمني

152
00:07:10,950 --> 00:07:13,300
‫ما قصة صورتك الذاتية؟

153
00:07:13,380 --> 00:07:17,030
‫مجرد صورة ذاتية أمامية
‫من دون زوايا حقاً

154
00:07:17,160 --> 00:07:20,680
‫لا تعرف أي زاوية تظهر
‫أفضل ما لديك

155
00:07:20,760 --> 00:07:22,110
‫قم بواجبك

156
00:07:22,200 --> 00:07:24,850
‫وعلى الأقل اشتر ضوءاً حلقياً

157
00:07:24,850 --> 00:07:26,070
‫يا للإزعاج!

158
00:07:26,550 --> 00:07:27,460
‫لكن....

159
00:07:28,200 --> 00:07:32,530
‫أطريك لأنك بدأت تحدث مواقع
‫التواصل الاجتماعي خاصتك

160
00:07:35,280 --> 00:07:36,920
‫بقي يومان فقط

161
00:07:37,280 --> 00:07:39,710
‫أنا متشوّق لحفلكما السنوي

162
00:07:40,750 --> 00:07:43,060
‫_ ستحضر؟
‫_ ما الخطأ في مجيئي؟

163
00:07:43,620 --> 00:07:45,620
‫لم أقصد الأمر بهذه الطريقة

164
00:07:48,610 --> 00:07:52,740
‫معجباتك ينتظرن أداءك بفارغ الصبر

165
00:07:52,830 --> 00:07:55,430
‫لا تخذلهن

166
00:07:56,570 --> 00:07:57,350
‫إلى اللقاء

167
00:08:00,520 --> 00:08:03,650
‫كان (هيكارو) غارقاً جداً بالأمر

168
00:08:03,870 --> 00:08:05,510
‫ما دام يستمتع لا بأس بذلك

169
00:08:05,640 --> 00:08:08,640
‫رغم أنه لا يريدنا أن نعرف

170
00:08:08,770 --> 00:08:10,650
‫هذا جانب محبّب لديه

171
00:08:10,810 --> 00:08:11,770
‫صحيح؟

172
00:08:16,980 --> 00:08:18,150
‫إلى أين سنذهب؟

173
00:08:18,250 --> 00:08:20,070
‫غيرت الموضوع فجأة

174
00:08:20,110 --> 00:08:22,280
‫ربما في مغامرة على جزيرة مهجورة؟

175
00:08:22,380 --> 00:08:23,370
‫جدياً؟

176
00:08:23,680 --> 00:08:24,540
‫مستحيل

177
00:08:24,630 --> 00:08:26,850
‫ستكون مشكلة إن كان هذا صحيحاً

178
00:08:27,540 --> 00:08:29,670
‫_ "من أجل غايات توضيحية فقط"
‫_ على جزيرة صحراوية في منطقة نائية

179
00:08:29,760 --> 00:08:32,280
‫وصلنا أخيراً بعد رحلة طويلة

180
00:08:32,360 --> 00:08:33,850
‫هذه هي ملابس المسرح

181
00:08:33,930 --> 00:08:35,670
‫عالقاً في مصايد أطلال

182
00:08:35,750 --> 00:08:37,840
‫صديقنا العزيز يلقى حتفه

183
00:08:37,840 --> 00:08:39,140
‫أنا ميت؟

184
00:08:39,230 --> 00:08:42,010
‫بعد التغلب على المحن
‫والكثير من التضحيات

185
00:08:42,090 --> 00:08:43,350
‫ما الذي حققته فرقة (سيغراس)؟

186
00:08:43,440 --> 00:08:44,840
‫إنه لم يعد تصويراً

187
00:08:45,180 --> 00:08:47,180
‫يبدو شائقاً

188
00:08:47,220 --> 00:08:50,010
‫سأذهب وأسأل مديرنا

189
00:08:52,440 --> 00:08:56,090
‫ماذا عن خطتنا
‫من أجل شعيرية رامن؟

190
00:08:56,220 --> 00:08:58,430
‫أريد نكهة (ميسو)

191
00:08:58,520 --> 00:08:59,860
‫سأختار الملح

192
00:09:01,300 --> 00:09:04,170
‫إذاً يوم واحد قبل
‫حفل الذكرى السنوية

193
00:09:08,520 --> 00:09:09,780
‫"اليوم الرياضي للوسيمين الخارقين"

194
00:09:09,860 --> 00:09:11,030
‫هل هذا هو؟

195
00:09:11,120 --> 00:09:14,210
‫عدد (بلو راي) عن اليوم الرياضي
‫الصادر الشهر الماضي

196
00:09:14,290 --> 00:09:17,120
‫وهل هذه نسخة المخرج؟

197
00:09:17,200 --> 00:09:19,990
‫اعتقدت أن هذا سيثير حماسنا
‫من أجل حفل الغد

198
00:09:20,370 --> 00:09:21,550
‫فكرة جميلة

199
00:09:22,330 --> 00:09:24,060
‫مشغّل الأقراص المضغوطة
‫لا يستطيع تشغيل أقراص (بلو راي)

200
00:09:24,160 --> 00:09:25,800
‫ما هذا؟

201
00:09:25,800 --> 00:09:27,150
‫هذا هو حظنا

202
00:09:27,230 --> 00:09:29,760
‫إذاً مشغّل الأقراص المضغوطة هذا
‫مجرد وهم بصري

203
00:09:31,800 --> 00:09:36,230
‫كنا قريبات جداً من زيادة الحماس
‫قبل حفل الذكرى السنوية

204
00:09:36,270 --> 00:09:38,320
‫الحفل سيقام غداً أخيراً

205
00:09:38,360 --> 00:09:39,740
‫بدلاً من كلمة "أخيراً"

206
00:09:39,840 --> 00:09:42,490
‫فكري أننا نستطيع الاحتفال
‫بالذكرى السنوية الثانية لنا

207
00:09:42,570 --> 00:09:43,530
‫أعرف هذا جيداً

208
00:09:43,830 --> 00:09:44,700
‫أيضاً....

209
00:09:44,790 --> 00:09:48,360
‫من كان يتوقع أن تغني فرقة
‫(زينغز) في قاعة (ميوجو)؟

210
00:09:48,570 --> 00:09:52,700
‫هذا يعني أن سحر (نيودو)
‫قد انتشر في العالم

211
00:09:52,830 --> 00:09:55,080
‫لا بد أن هذا صحيح

212
00:09:55,180 --> 00:09:56,910
‫بدأ كل شيء بـ"ذاك"

213
00:09:57,040 --> 00:09:58,650
‫صحوة (نيودو)

214
00:09:58,950 --> 00:10:01,130
‫كانت بداية أسطورة حرفياً

215
00:10:01,260 --> 00:10:03,780
‫ولادة نموذج الرئيس لـ(نيودو)

216
00:10:03,860 --> 00:10:09,720
‫يجب أن ننقل قصة تلك اللحظة
‫إلى الجيل القادم من معجبات (زينغز)

217
00:10:10,040 --> 00:10:13,770
‫منذ ذلك الحين بدأت أشعر
‫أن فرقة (زينغز) بدأت تدور عجلاتها

218
00:10:13,810 --> 00:10:16,330
‫أو بالأحرى، تتسارع

219
00:10:16,460 --> 00:10:17,200
‫أعلم

220
00:10:17,280 --> 00:10:20,890
‫ولن أنسى يوماً لقاء المعجبات
‫لهذا العام

221
00:10:21,030 --> 00:10:23,890
‫لقاء المعجبات ذاك كان رائعاً

222
00:10:23,980 --> 00:10:27,320
‫لن أنسى أنك ذهبت
‫إلى منتجع جبلي، كما قلت أنت

223
00:10:27,320 --> 00:10:30,010
‫ربما كنت سأخسر
‫لو لم أفعل هذا

224
00:10:30,110 --> 00:10:32,880
‫نحتاج إلى معركة شرسة في النهاية

225
00:10:32,970 --> 00:10:34,360
‫للعبة حجر، ورقة، مقص

226
00:10:34,620 --> 00:10:38,050
‫كنت مستعدة لخسارة حياتي كي أربح

227
00:10:38,790 --> 00:10:45,270
‫لكن (نيودو) و(يوشينو) علّماني
‫أن الربح ليس كل شيء

228
00:10:45,350 --> 00:10:49,740
‫لقد أنهيا دورة الحزن بسبب
‫معارك المعجبات العقيمة

229
00:10:49,880 --> 00:10:51,520
‫لا يمكنني سوى أن أحبّهما

230
00:10:51,610 --> 00:10:53,910
‫كان فضيلاً ووسيماً جداً

231
00:10:54,260 --> 00:10:57,440
‫وقد أبهرني تقويمهما بعمق

232
00:10:57,820 --> 00:11:01,730
‫أردت رؤية شاب جميل يقطر ماء

233
00:11:01,820 --> 00:11:04,820
‫وتمكنت من رؤية (نيودو)
‫في ملابس السباحة

234
00:11:04,860 --> 00:11:06,950
‫إنه مبهر حقاً

235
00:11:07,120 --> 00:11:08,650
‫في حالتي، النظّارة

236
00:11:08,730 --> 00:11:12,160
‫لم أستطع تصديق أنني أرى
‫(نيودو) الجامح يضع نظارة

237
00:11:12,240 --> 00:11:13,380
‫"الجامح"؟

238
00:11:13,860 --> 00:11:15,670
‫صور تبادل الملابس قضت علينا

239
00:11:15,770 --> 00:11:16,410
‫أجل

240
00:11:16,510 --> 00:11:17,590
‫بالضبط

241
00:11:17,680 --> 00:11:21,200
‫اليوم الرياضي للوسيمين الخارقين
‫كان رائعاً أيضاً

242
00:11:21,280 --> 00:11:24,670
‫من كان يتوقع من (نيودو) أن يركض؟

243
00:11:24,710 --> 00:11:26,760
‫فعل روح الرفاق الذي فعله مع (يوشينو)

244
00:11:26,840 --> 00:11:30,410
‫والروح الرياضية بينه وبين (ستيتوتشي)
‫كانت رائعة

245
00:11:30,750 --> 00:11:33,710
‫أغمي علي تلك اللحظة
‫لكنني رأيتهما

246
00:11:34,180 --> 00:11:37,450
‫أما بالنسبة إلى التفاعلات مع (سيتوتشي)
‫يجب أن يكون مركزه حفل (فارمرز هاندسوم)

247
00:11:37,530 --> 00:11:41,180
‫مشاهدة محبوبنا المفضل على مسرح
‫كبير للمرة الأولى كانت مؤثرة

248
00:11:41,270 --> 00:11:43,400
‫مجرد تذكر هذا يجعلني أبكي

249
00:11:43,440 --> 00:11:46,960
‫عندما ظهر (سيتوتشي)
‫وهو يمسك يد (نيودو)

250
00:11:47,090 --> 00:11:49,040
‫اعتقدت أن قلبي سيتوقف

251
00:11:49,180 --> 00:11:50,350
‫لم يستطع ذهني استيعاب الأمر

252
00:11:50,480 --> 00:11:52,830
‫بصراحة، ذاكرتي مشوّشة بسبب الصدمة

253
00:11:52,910 --> 00:11:54,910
‫أتمنى أن يصدروه على قرص (بلو راي)

254
00:11:55,350 --> 00:11:57,380
‫بعد ذلك كان ذلك الحفل

255
00:11:58,220 --> 00:11:59,260
‫ذلك الحفل

256
00:11:59,340 --> 00:12:04,380
‫حينها، كان (نيودو) يتمتع
‫بجاذبية نضج وهدوء

257
00:12:04,560 --> 00:12:07,160
‫لقد جذبنا إليه، أليس كذلك؟

258
00:12:07,250 --> 00:12:09,850
‫كشف سحراً جديداً، ألا تظنون ذلك؟

259
00:12:10,590 --> 00:12:15,020
‫عند إعادة النظر
‫هناك الكثير من الذكريات الرائعة

260
00:12:15,240 --> 00:12:17,330
‫كانت ستة أشهر جنونية

261
00:12:17,460 --> 00:12:21,360
‫مهلاً، مهلاً
‫لا يزال الوقت باكراً على الذكريات

262
00:12:21,460 --> 00:12:23,110
‫اليوم الهام لا يزال غداً

263
00:12:23,190 --> 00:12:24,490
‫أنت على حق بشأن هذا

264
00:12:24,590 --> 00:12:28,280
‫يجب أن نعمل بقلوبنا وأرواحنا
‫للاستمتاع به

265
00:12:28,580 --> 00:12:29,360
‫أجل

266
00:12:29,620 --> 00:12:33,190
‫إليكما ما علينا فعله

267
00:12:33,840 --> 00:12:34,530
‫أولاً

268
00:12:34,880 --> 00:12:35,660
‫نذهب إلى النوم

269
00:12:35,750 --> 00:12:37,010
‫أنا موافقة

270
00:12:37,140 --> 00:12:39,310
‫من تريد الاستحمام أولاً؟

271
00:12:40,610 --> 00:12:44,040
‫فريق (كاسينجيكي) سيشاهد
‫حفل الذكرى السنوية

272
00:12:48,570 --> 00:12:51,040
‫حفل الذكرى السنوية سيحلّ غداً أخيراً

273
00:12:51,130 --> 00:12:53,180
‫أنا متشوّقة جداً بحيث لا أستطيع النوم

274
00:12:53,260 --> 00:12:54,730
‫لكنني أبذل ما في وسعي كي أنام

275
00:12:54,830 --> 00:12:56,780
‫أنا متشوقة للغد

276
00:13:02,810 --> 00:13:04,650
‫حان وقت الذهاب إلى المنزل

277
00:13:06,340 --> 00:13:10,510
‫أذهان الناس تدور... الليل يتقدم

278
00:13:11,470 --> 00:13:15,280
‫الألوان الفاتحة لسماء الليل
‫قد تحولت إلى الماضي

279
00:13:15,940 --> 00:13:22,540
‫لمعان النجوم ليس أزليّاً
‫وكذلك لمعان محبوبي الجماهير

280
00:13:23,360 --> 00:13:26,670
‫لكنها هنا

281
00:13:27,010 --> 00:13:30,540
‫رغم أننا لا نستطيع سماع صوتها
‫أو رؤية وجهها

282
00:13:32,670 --> 00:13:35,620
‫هذه هي قصة محبوبي جماهير

283
00:13:36,400 --> 00:13:38,360
‫قصة محبوبة جماهير كانت رائعة..

284
00:13:38,660 --> 00:13:40,970
‫ومحبوب جماهير فاشل

285
00:13:53,740 --> 00:13:57,030
‫يوم حفل الذكرى السنوية الثانية
‫في قاعة (ميوجو)

286
00:14:00,160 --> 00:14:02,860
‫إنه هائل

287
00:14:07,160 --> 00:14:08,860
‫هل ستملأ هذه المقاعد؟

288
00:14:08,980 --> 00:14:10,460
‫إنها قاعة (ميوجو)

289
00:14:10,550 --> 00:14:13,070
‫لا أصدق أنني أقف هنا ثانية

290
00:14:13,250 --> 00:14:16,800
‫صحيح، أقامت حفلات هنا في السابق

291
00:14:17,160 --> 00:14:18,370
‫هنا

292
00:14:19,150 --> 00:14:21,230
‫وصلنا حقاً إلى هنا إلى هذه المرحلة

293
00:14:21,590 --> 00:14:24,240
‫يبدو مثل حلم

294
00:14:26,150 --> 00:14:27,450
‫(يوشينو)

295
00:14:28,190 --> 00:14:29,750
‫في المرة الأولى لي في فرق (زينغز)

296
00:14:30,150 --> 00:14:33,180
‫لم أكن واثقاً
‫أنني سأقوم بالأمور بشكل صحيح

297
00:14:33,790 --> 00:14:35,570
‫فأنا أعاني رهاب المسرح

298
00:14:35,750 --> 00:14:37,490
‫أنا لست مميّزاً

299
00:14:38,100 --> 00:14:40,700
‫سأرتكب أخطاء

300
00:14:41,180 --> 00:14:46,350
‫ستنسحب وسننفصل، هذا ما اعتقدته

301
00:14:48,040 --> 00:14:52,610
‫لكنني تمكنت من العمل بجد
‫لأنك كنت معي

302
00:14:54,000 --> 00:14:55,480
‫ينطبق الأمر نفسه على مسلسلي

303
00:14:55,820 --> 00:14:57,430
‫في الواقع كنت مذعوراً

304
00:14:57,860 --> 00:15:00,990
‫لكنني أريد الاستمرار بالعمل بجد معك

305
00:15:01,120 --> 00:15:02,560
‫لذا قبلت التحدي

306
00:15:04,300 --> 00:15:05,290
‫هذا هو السبب

307
00:15:05,730 --> 00:15:08,070
‫يسرّني جداً أن أكون هنا معك

308
00:15:08,850 --> 00:15:10,940
‫(يو)، شكراً لك

309
00:15:15,630 --> 00:15:17,110
‫معك حق

310
00:15:25,020 --> 00:15:28,710
‫نحن ممتنات أن عضوي (زيغنز) وصلا
‫إلى هذه المرحلة من دون أن ينفصلا

311
00:15:28,790 --> 00:15:29,710
‫أجل

312
00:15:29,710 --> 00:15:32,660
‫لا نمانع أن تقصف أعيننا بنموذج
‫اليانصيب الخاص بـ(نيودو)

313
00:15:32,840 --> 00:15:34,320
‫سندعمه طوال الوقت

314
00:15:34,400 --> 00:15:35,840
‫أجل

315
00:15:35,920 --> 00:15:37,710
‫معجبات (نيودو) يثرن ضجة كبيرة

316
00:15:40,570 --> 00:15:42,830
‫"الغرفة الخضراء لـ(زينغز)"

317
00:15:44,750 --> 00:15:46,570
‫حسن، أنا جاهز تماماً

318
00:15:46,870 --> 00:15:48,130
‫هيا يا (أساهي)

319
00:15:50,440 --> 00:15:52,950
‫حفل اليوم هام بالنسبة إليك

320
00:15:53,770 --> 00:15:56,940
‫أرجوك اصعد إلى المسرح
‫بشخصيتك يا (نيودو)

321
00:16:06,990 --> 00:16:08,510
‫شبح محبوب الجماهير

322
00:16:09,420 --> 00:16:11,420
‫نحن هنا أخيراً أيها الشابان

323
00:16:11,760 --> 00:16:13,200
‫قدّما شيئاً من روحكما فيه

324
00:16:13,460 --> 00:16:14,500
‫أجل

325
00:16:16,630 --> 00:16:19,500
‫حفل اليوم هام بالنسبة إليك

326
00:16:20,060 --> 00:16:23,150
‫أرجوك أن تصعد إلى المسرح
‫بشخصيتك يا (نيودو)

327
00:16:23,670 --> 00:16:25,970
‫لم أعتقد أنها سترفضني

328
00:16:26,060 --> 00:16:29,320
‫كنت على وشك
‫ترك نصف دوري لها

329
00:16:29,800 --> 00:16:33,660
‫لا تقل لي إنها فقدت دافعها
‫بعد أن أصبح (سيتوتشي) من معجبيّ

330
00:16:33,790 --> 00:16:35,270
‫خاصة أنت يا (نيودو)

331
00:16:35,360 --> 00:16:38,530
‫قمت بعمل جيد
‫لتصل إلى هنا سليماً اليوم

332
00:16:38,610 --> 00:16:41,270
‫أبقيتني قلقة منذ أول ظهور لك

333
00:16:41,350 --> 00:16:44,260
‫فكرت بطردك 800 مرة
‫على مر السنتين الماضيتين

334
00:16:44,400 --> 00:16:47,090
‫أي أكثر من مرة في اليوم

335
00:16:47,390 --> 00:16:50,260
‫حسن، سأقدم لك الإطراء
‫بعد أن ينتهي الحفل

336
00:16:50,480 --> 00:16:53,210
‫هذه هي لحظتك بعد هاتين السنتين

337
00:16:53,650 --> 00:16:55,030
‫أعط كل ما لديك

338
00:16:57,080 --> 00:16:59,160
‫حتى إن الرئيسة قالت إن...

339
00:17:02,950 --> 00:17:05,200
‫هل سيمتلئ نصفها؟

340
00:17:22,620 --> 00:17:24,790
‫(نيودو)؟

341
00:17:25,010 --> 00:17:26,930
‫(يوشينو)

342
00:17:31,100 --> 00:17:32,620
‫إنها ملأى

343
00:17:39,010 --> 00:17:43,180
‫أهلاً بكم إلى حفل
‫الذكرى السنوية الثانية لـ(زينغز)

344
00:17:43,180 --> 00:17:45,140
‫أنا (كازوكي يوشينو)

345
00:17:47,130 --> 00:17:49,470
‫إلى كل من دعمنا دوماً...

346
00:17:49,560 --> 00:17:51,080
‫إلى المعجبين الجدد

347
00:17:51,430 --> 00:17:53,910
‫آمل أن تستطيعوا الاستمتاع
‫اليوم إلى أقصى حد

348
00:17:55,770 --> 00:17:57,210
‫"(يو)، ألق كلمة رجاء"

349
00:18:02,860 --> 00:18:04,110
‫أنا (نيودو)

350
00:18:04,290 --> 00:18:06,240
‫ماذا؟ هل انتهيت؟

351
00:18:06,550 --> 00:18:08,280
‫(نيودو) هو...

352
00:18:08,380 --> 00:18:10,200
‫ربما لا يستطيع القيام بهذا اليوم

353
00:18:13,890 --> 00:18:14,760
‫(يو)؟

354
00:18:14,840 --> 00:18:17,540
‫شاهدت مسلسلك يا (كازوكي)

355
00:18:17,590 --> 00:18:19,800
‫شكراً لك

356
00:18:19,890 --> 00:18:20,970
‫هذا صحيح

357
00:18:21,230 --> 00:18:22,140
‫مسلسل

358
00:18:22,450 --> 00:18:27,890
‫هناك أشخاص شاهدوا (يوشينو)
‫في المسلسل أولاً ثم أتوا إلى هنا

359
00:18:28,140 --> 00:18:29,840
‫الأمر نفسه ينطبق على مسلسلي

360
00:18:30,060 --> 00:18:31,750
‫في الواقع، كنت مذعوراً

361
00:18:32,010 --> 00:18:34,870
‫لكنني أريد الاستمرار بالعمل
‫الجادّ معك

362
00:18:35,230 --> 00:18:36,530
‫لذا قبلت التحدي

363
00:18:37,050 --> 00:18:39,480
‫يريد أن يعمل بجد معي

364
00:18:41,650 --> 00:18:42,610
‫فهمت

365
00:18:43,350 --> 00:18:44,310
‫(يوشينو)

366
00:18:44,610 --> 00:18:45,740
‫أيتها الرئيسة

367
00:18:46,180 --> 00:18:48,820
‫وربما معجباتنا أيضاً

368
00:18:49,950 --> 00:18:51,610
‫الجميع بذلوا ما في وسعهم

369
00:18:58,950 --> 00:18:59,820
‫(يو)؟

370
00:19:04,420 --> 00:19:07,720
‫بعد أن أصبحت محبوب جماهير

371
00:19:08,020 --> 00:19:11,680
‫لم أعتقد قط أنني سأجبر
‫على كل هذا الغناء وما شابه

372
00:19:12,410 --> 00:19:14,930
‫حاولت الانسحاب عدة مرات

373
00:19:15,670 --> 00:19:18,190
‫(نيودو) المعتاد يقول جملة كاملة

374
00:19:18,500 --> 00:19:21,270
‫لكن الجميع كانوا يعملون بجد
‫للمجيء إلى هنا

375
00:19:22,110 --> 00:19:24,020
‫(يوشينو) يعمل بجد أيضاً

376
00:19:24,700 --> 00:19:27,270
‫وكذلك كل من يعمل معي

377
00:19:28,750 --> 00:19:29,880
‫شعرت...

378
00:19:33,360 --> 00:19:37,440
‫أنني سعيد لأنني وصلت إلى هنا
‫من دون أن أنسحب

379
00:19:37,790 --> 00:19:38,920
‫هذا ما اعتقدته

380
00:19:40,880 --> 00:19:42,090
‫هذا كل شيء...

381
00:19:53,390 --> 00:19:55,600
‫أنت تعمل بجد دوماً يا (نيودو)

382
00:19:55,640 --> 00:19:57,770
‫عملت بجد بالفعل لتصل إلى هنا

383
00:19:57,860 --> 00:20:00,730
‫شكراً لك لأنك لم تنسحب

384
00:20:05,810 --> 00:20:07,510
‫أريد الانسحاب من كوني محبوب جماهير

385
00:20:08,150 --> 00:20:11,120
‫لم أفكر بالأمر حقاً أبداً

386
00:20:11,320 --> 00:20:13,200
‫فعلت ما طلب مني فحسب

387
00:20:13,550 --> 00:20:14,970
‫لقد سرقت جسدي

388
00:20:15,230 --> 00:20:18,280
‫كل هذا لترقصي ثانية
‫وتكوني محبوبة جماهير ثانية

389
00:20:18,800 --> 00:20:19,580
‫لا؟

390
00:20:19,670 --> 00:20:22,710
‫معاً لنصبح أفضل محبوب جماهير
‫على الإطلاق

391
00:20:22,840 --> 00:20:25,620
‫يمكنك أن تبقي كما أنت

392
00:20:25,840 --> 00:20:28,840
‫غالباً هذا أفضل بالنسبة إليك أيضاً

393
00:20:29,190 --> 00:20:31,350
‫أنا عديم الاندفاع
‫أكثر من أي شخص آخر

394
00:20:31,570 --> 00:20:36,700
‫نشاطاتي كمحبوب جماهير كانت ستكون
‫في ورطة لولا اندفاعك الذي لا يضاهى

395
00:20:38,830 --> 00:20:40,440
‫يا له من معجب!

396
00:20:42,740 --> 00:20:44,040
‫(نيودو)...

397
00:20:44,650 --> 00:20:46,040
‫شكراً لك

398
00:20:46,570 --> 00:20:51,780
‫شكراً لأنك لا تتخلى...
‫عن كونك محبوب الجماهير

399
00:20:57,250 --> 00:21:01,290
‫"أنت تلمع بإشراق شديد"

400
00:21:01,290 --> 00:21:05,460
‫"لكل منا لمعانه الخاص"

401
00:21:09,630 --> 00:21:13,800
‫"أرفض إطلاع أي شخص آخر
‫على ما أحبه"

402
00:21:13,890 --> 00:21:18,190
‫"إذاً ماذا؟ ماذا يعنيك هذا؟
‫إنها فرادتي"

403
00:21:18,320 --> 00:21:22,670
‫"ربما أكون على خطأ
‫لكن إن التزمت به"

404
00:21:22,800 --> 00:21:27,440
‫"أستطيع خلق نقطة قوتي"

405
00:21:27,660 --> 00:21:31,650
‫"قلت إننا نحب الأشياء ذاتها"

406
00:21:31,750 --> 00:21:34,090
‫"ألست مخطئاً؟"

407
00:21:34,220 --> 00:21:38,090
‫"الآن أريد رؤية فرادتك"

408
00:21:38,220 --> 00:21:40,960
‫"هيا، لا تكذب، كن صادقاً فحسب"

409
00:21:41,040 --> 00:21:43,080
‫"وتصرف على طبيعتك"

410
00:21:43,260 --> 00:21:47,090
‫"حتى إن كنت عنيداً
‫أنا أعرف كل شيء"

411
00:21:47,210 --> 00:21:49,740
‫"ما هو معدن قلبك؟"

412
00:21:49,950 --> 00:21:52,040
‫"أريد التعرف على ذاتك الحقيقية"

413
00:21:52,300 --> 00:21:56,550
‫"سأرسم ابتسامة على وجهك"

414
00:21:57,340 --> 00:21:59,420
‫"لا تكذب، كن صادقاً فحسب"

415
00:21:59,640 --> 00:22:01,730
‫"وتصرف على طبيعتك"

416
00:22:01,850 --> 00:22:05,720
‫"حتى إن كنت عنيداً
‫فأنا أعرف كل شيء"

417
00:22:05,810 --> 00:22:08,330
‫"ما هو معدن قلبك؟"

418
00:22:08,500 --> 00:22:10,590
‫"أريد التعرف على ذاتك الحقيقية"

419
00:22:10,850 --> 00:22:15,150
‫"سأرسم ابتسامة على وجهك"

420
00:22:15,320 --> 00:22:20,190
‫"أنت تلمع بإشراق شديد"

421
00:22:20,320 --> 00:22:24,880
‫"إنه لمعانك الخاص"

422
00:22:32,270 --> 00:22:33,710
‫عجباً!

423
00:22:33,870 --> 00:22:40,220
‫(أساهي)، تبدو سعيدة
‫لكنها لا تصعد إلى مرحلة السكينة

424
00:22:40,790 --> 00:22:44,480
‫إن عملت جاهداً في هذا الحفل
‫وصعدت هي

425
00:22:44,600 --> 00:22:46,910
‫هل ستكون هذه ذكرى جميلة
‫بالنسبة إليها؟

426
00:22:47,040 --> 00:22:48,810
‫ماذا ستكون؟

427
00:22:50,210 --> 00:22:52,860
‫لم أتوقع سماع هذه الكلمات منك

428
00:22:52,940 --> 00:22:54,560
‫لنبذل ما في وسعنا

429
00:22:54,640 --> 00:22:56,730
‫أجل، من أجل هدية
‫سنأخذها إلى الحياة الأخرى

430
00:22:56,810 --> 00:22:57,900
‫كرّر كلامك؟

431
00:23:00,340 --> 00:23:01,200
‫أجل

432
00:23:01,200 --> 00:23:02,030
‫هذا

433
00:23:02,120 --> 00:23:03,730
‫هذا هو (نيودو) الحقيقي

434
00:23:06,070 --> 00:23:08,160
‫لنفعل هذا يا (يوشينو)

435
00:23:08,500 --> 00:23:10,590
‫قبل أن تصعد (أساهي)
‫إلى مرحلة السكينة

436
00:23:11,550 --> 00:23:15,760
‫سنريكم أفضل ما قدمناه
‫في السنتين الماضيتين

437
00:23:15,880 --> 00:23:17,360
‫كل ما لدينا

438
00:23:17,760 --> 00:23:19,190
‫سنبذل كل ما في وسعنا

439
00:23:19,590 --> 00:23:22,970
‫إذاً، هذه هي أغنيتي الأولى

440
00:23:23,220 --> 00:23:25,060
‫دعونا (زينغ)

441
00:23:27,270 --> 00:23:36,530
‫مرة أخرى!

442
00:23:36,650 --> 00:23:38,740
‫لنذهب إلى المرحلة الأخيرة