1
00:00:58,440 --> 00:01:02,050
‫نحن نبيع بضائع من أجل حفل
‫الذكرى السنوية الثانية لـ(زينغز)

2
00:01:02,140 --> 00:01:03,610
‫تقويماً واحداً من فضلك

3
00:01:03,710 --> 00:01:05,360
‫ملصق الذكرى السنوية الثانية من فضلك

4
00:01:12,660 --> 00:01:14,820
‫هذا هو الألبوم الجديد

5
00:01:15,000 --> 00:01:18,090
‫بعد قدومنا مباشرة
‫رأينا دفقاً من البضائع الجديدة

6
00:01:18,250 --> 00:01:20,780
‫لنستخدم مفكرة هذه المناسبة
‫بطريقة مفيدة

7
00:01:20,960 --> 00:01:23,470
‫أنا متشوّقة لسماع أغنيتهما الجديدة

8
00:01:23,820 --> 00:01:24,650
‫(زينغز)

9
00:01:24,950 --> 00:01:27,730
‫نظرة معجباتهما للعالم مخيفة كالعادة

10
00:01:27,820 --> 00:01:29,900
‫أظن أنها أصبحت عادتهن الآن

11
00:01:31,030 --> 00:01:33,990
‫أليس هذا معجبهما الأول
‫الرجل ذا عصابة الرأس؟

12
00:01:34,070 --> 00:01:36,030
‫مدوّنته مذهلة جداً

13
00:01:36,120 --> 00:01:38,680
‫لا أتوقع أقل من هذا من المعجب
‫صاحب عصابة الرأس

14
00:01:39,240 --> 00:01:42,110
‫لماذا يقولون عني إنني المعجب الأول؟

15
00:01:42,460 --> 00:01:45,320
‫لكن علي أن أحصل
‫على بضائع هذا الحفل المحدودة

16
00:01:45,420 --> 00:01:47,540
‫ليس لأنني المعجب الأول المزعوم

17
00:01:47,800 --> 00:01:50,500
‫بل كي أردّ المعروف
‫بعد أن أعطياني البطاقة

18
00:01:59,660 --> 00:02:02,050
‫أخيراً، نحن هنا

19
00:02:02,970 --> 00:02:05,660
‫يفترض أن نشاطاتي
‫كمحبوبة جماهير قد انتهت

20
00:02:06,180 --> 00:02:09,830
‫أن أفكر أنني استطعت العودة إلى هنا...

21
00:02:10,180 --> 00:02:13,010
‫أنا...

22
00:02:13,740 --> 00:02:16,650
‫لا أستطيع التوقف عن كوني
‫محبوبة جماهير رغم أنني ميتة

23
00:02:17,820 --> 00:02:21,650
‫حسن، ها قد أتيت

24
00:02:26,990 --> 00:02:30,900
‫"المرحلة النهائية"

25
00:02:33,160 --> 00:02:36,160
‫حسن، حان الوقت لنبدأ
‫بأغنيتنا الأولى

26
00:02:36,850 --> 00:02:38,070
‫"لنغنّ (زينغ)"

27
00:02:38,600 --> 00:02:41,200
‫"معاً تحت السماء الدرامية"

28
00:02:41,240 --> 00:02:43,370
‫"معك"

29
00:02:43,450 --> 00:02:45,460
‫"(هيا جميعكم، لنستمتع)"

30
00:02:47,630 --> 00:02:48,850
‫"حسن"

31
00:02:50,190 --> 00:02:51,970
‫"لنبدأ، الآن"

32
00:02:54,180 --> 00:02:54,920
‫"حسن"

33
00:02:55,060 --> 00:02:56,580
‫"معكم، حسن"

34
00:02:56,670 --> 00:02:58,270
‫"(ها نحن أولاء، نعم)"

35
00:02:58,350 --> 00:02:59,530
‫"(زينغ) من أجل ابتسامة"

36
00:02:59,620 --> 00:03:03,750
‫"هل نسيت كيف هو شعور النبض؟"

37
00:03:03,830 --> 00:03:07,740
‫"الصوت الذي تسمعينه
‫عندما يتسارع قلبك"

38
00:03:07,830 --> 00:03:10,960
‫"لنضعه في طبقات معاً بأغنيتنا"

39
00:03:11,040 --> 00:03:13,210
‫"ثم نطلق سيقاننا للريح"

40
00:03:13,310 --> 00:03:16,220
‫_ "حماس، لا حدود"
‫_ "الاندفاع يتصاعد"

41
00:03:16,300 --> 00:03:17,860
‫"مليء بالروح، لكن من دونك؟"

42
00:03:17,960 --> 00:03:19,820
‫"سيكون هذا مملاً"

43
00:03:19,870 --> 00:03:23,250
‫"أملنا أن نصبح ثنائياً
‫جاهزاً للانطلاق، نعم"

44
00:03:23,340 --> 00:03:26,380
‫"لنرقص معاً إلى الأبد"

45
00:03:26,470 --> 00:03:29,070
‫"إن حدث وتعثرت"

46
00:03:29,170 --> 00:03:32,720
‫"وابتعدت أيدينا بعيداً جداً عن بعضها"

47
00:03:32,860 --> 00:03:35,890
‫"سنضع ثقتنا بك"

48
00:03:36,110 --> 00:03:39,590
‫"لنقطع عهداً سرياً"

49
00:03:39,640 --> 00:03:41,110
‫"(لنغنّ أغنية الآن)"

50
00:03:41,160 --> 00:03:43,630
‫"معاً تحت الشمس الدرامية"

51
00:03:43,720 --> 00:03:44,850
‫"معك"

52
00:03:44,970 --> 00:03:47,460
‫"في الصباح والظهر وحتى الليل"

53
00:03:47,620 --> 00:03:50,190
‫"سنجعلك تقول إنك تحب هذا"

54
00:03:50,320 --> 00:03:52,840
‫"أكثر ودوماً"

55
00:03:52,930 --> 00:03:54,230
‫"ليغنّ الجميع، صفّقوا بأيديكم"

56
00:03:54,280 --> 00:03:57,180
‫"شعاع النور الآتي من النجمين"

57
00:03:57,280 --> 00:04:00,530
‫"إنها أنوار النجوم التي ستقودكم
‫إلى مستقبل أكثر إشراقاً"

58
00:04:00,750 --> 00:04:02,530
‫_ "دافع فيّاض"
‫_ "أغنية عجائبية"

59
00:04:02,580 --> 00:04:04,140
‫"آمل أن تجعلك تبتسم دوماً"

60
00:04:04,220 --> 00:04:06,220
‫"(زينغ) من أجل ابتسامة"

61
00:04:08,270 --> 00:04:10,260
‫أنتما الأفضل يا (زينغز)

62
00:04:10,920 --> 00:04:11,960
‫هذا!

63
00:04:12,080 --> 00:04:13,040
‫هذه المقدمة....

64
00:04:13,260 --> 00:04:17,480
‫مرة أخرى أنا (كازوكي يوشينو)

65
00:04:17,780 --> 00:04:19,180
‫(يوشينو)!

66
00:04:19,260 --> 00:04:20,990
‫أنت وسيم جداً

67
00:04:21,390 --> 00:04:22,730
‫شكراً جزيلاً

68
00:04:23,290 --> 00:04:24,560
‫هلا تحادثنا يا (يو)

69
00:04:24,690 --> 00:04:26,260
‫أنا متعب
‫هل أستطيع الذهاب إلى المنزل؟

70
00:04:26,380 --> 00:04:28,080
‫لم نغنّ إلا أغنية واحدة فقط؟

71
00:04:31,030 --> 00:04:33,030
‫تالياً، سنقدم لكم هذه الأغنية...

72
00:04:33,340 --> 00:04:35,120
‫"ثنائي الداخل والخارج"

73
00:04:49,190 --> 00:04:52,450
‫"النور، الجوهرة المنسية"

74
00:04:52,540 --> 00:04:55,800
‫"يرفرف في سماء الليل البليدة"

75
00:04:55,880 --> 00:04:59,180
‫"عدد اللقم التي أرميها"

76
00:04:59,270 --> 00:05:02,440
‫"كنت أتظاهر أنني لا ألاحظ"

77
00:05:02,530 --> 00:05:05,700
‫"إن ابتلعنا سراب"

78
00:05:05,780 --> 00:05:09,050
‫"أتساءل كيف سيبدو الأمر"

79
00:05:09,130 --> 00:05:12,130
‫"أنا وأنت، نحن الاثنان"

80
00:05:12,220 --> 00:05:15,690
‫"سنذهب ونراه معاً"

81
00:05:17,430 --> 00:05:23,950
‫"عندما نجمع وجهي
‫العملة النقدية ذاتها"

82
00:05:24,030 --> 00:05:30,770
‫"بإمكاننا الإمساك بصوتك بهذه الأيدي"

83
00:05:38,590 --> 00:05:41,590
‫أنت رائع جداً يا (يوشينو)!

84
00:05:42,760 --> 00:05:44,410
‫رائع جداً!

85
00:05:44,500 --> 00:05:48,670
‫أود رؤيتهما يغنيان هذه الأغنية
‫بزيّ الأجنحة

86
00:05:48,710 --> 00:05:51,880
‫لكنكما تخلصتما من هذه الأزياء
‫التي صنعت من أجلكما

87
00:05:51,980 --> 00:05:53,710
‫أنا تخلصت من ذلك الزيّ الغريب

88
00:05:53,790 --> 00:05:55,230
‫مستحيل!

89
00:05:55,490 --> 00:05:59,360
‫الأشخاص في الطابق الأول
‫يستمتعون بهذا؟

90
00:06:00,750 --> 00:06:01,700
‫هذا رائع!

91
00:06:02,090 --> 00:06:04,490
‫ماذا عن الذين في الطابق الثاني؟

92
00:06:06,880 --> 00:06:08,390
‫شكراً لكم

93
00:06:08,870 --> 00:06:10,690
‫ألست سعيداً يا (يو)؟

94
00:06:10,790 --> 00:06:11,690
‫أنت على حق

95
00:06:12,000 --> 00:06:17,390
‫أولاً، غنّينا لكم "لنغنّ أغنية (زينغ)"
‫وتبعناها بـ"ثنائي الداخل والخارج"

96
00:06:17,470 --> 00:06:18,820
‫هل أعجبتاكم؟

97
00:06:19,820 --> 00:06:24,730
‫أجد أن أغنية "لنغنّ أغنية (زينغ)"
‫مليئة بالمشاعر

98
00:06:24,990 --> 00:06:26,850
‫سمعت أن رئيستنا ومنتجنا الموسيقي

99
00:06:29,860 --> 00:06:30,720
‫حقاً؟

100
00:06:30,760 --> 00:06:35,200
‫فيها اسم فريقنا (زينغ)
‫الذي يأتي من كلمة (سينغ) أي "يغني"

101
00:06:35,290 --> 00:06:37,460
‫بعبارة أخرى، إنها أغنية عن الغناء

102
00:06:37,540 --> 00:06:38,320
‫فهمت

103
00:06:38,420 --> 00:06:39,460
‫هذا مفيد

104
00:06:39,540 --> 00:06:40,630
‫عميق جداً

105
00:06:41,110 --> 00:06:44,200
‫(يوشينو) ظريف جداً
‫عندما يقدم شرحاً لإحدى الأغاني

106
00:06:44,280 --> 00:06:46,240
‫لذا "لنغنّ أغنية (زينغ)" تحمل رسالة

107
00:06:46,280 --> 00:06:51,360
‫"لنغنّ مع معجبينا"
‫و"لنتفجّر حماساً"

108
00:06:51,580 --> 00:06:53,020
‫إنها أول مرة أسمع بها هذا

109
00:06:53,100 --> 00:06:55,100
‫ألم تكن معي حينها؟

110
00:06:55,190 --> 00:06:57,050
‫غالباً لم أكن أستمع إلى شيء

111
00:06:57,090 --> 00:06:58,140
‫إذاً، استمع

112
00:06:58,400 --> 00:07:02,220
‫في ذلك الوقت
‫أنا أيضاً سمعت بالأمر

113
00:07:02,310 --> 00:07:06,090
‫قال منتجنا الموسيقي
‫إنه وضع كل طاقته في "لنغنّ أغنية (زينغ)"

114
00:07:09,910 --> 00:07:14,300
‫لذلك كانت الرئيسة تتذمر
‫بشأن تأخر صدور الأغنية الجديدة

115
00:07:14,430 --> 00:07:16,520
‫لماذا تتذكر هذا؟

116
00:07:16,600 --> 00:07:17,910
‫(نيودو)...

117
00:07:19,210 --> 00:07:23,730
‫"لنغنّ أغنية (زينغ)" أغنية ممتعة جداً
‫فيها الكثير من التعابير

118
00:07:23,820 --> 00:07:27,290
‫لكن حينها عندما تلقينا العرض
‫التسويقي كنت متوتراً جداً

119
00:07:27,370 --> 00:07:30,290
‫(يوشينو) متوتر، رائع جداً

120
00:07:30,380 --> 00:07:32,080
‫فيها أبيات موسيقى (راب) أيضاً، صحيح؟

121
00:07:32,160 --> 00:07:33,680
‫أجل، فيها هذا؟

122
00:07:33,810 --> 00:07:38,900
‫لم أغنّ الـ(راب) من قبل
‫لذا وجدت صعوبة بالغة أثناء التدريب

123
00:07:38,980 --> 00:07:40,760
‫لم أغنّ الـ(راب) من قبل أيضاً

124
00:07:40,890 --> 00:07:43,970
‫لكنك تستطيع غناء اللحن بدقة
‫مع إيقاع مثالي

125
00:07:44,060 --> 00:07:45,760
‫لكنني لم أرغب بإعادة غنائها فحسب

126
00:07:45,840 --> 00:07:48,100
‫يا للمهارة! مقارنة بسلوكه

127
00:07:48,190 --> 00:07:51,360
‫بحقك! أنت تتصرف هكذا دوماً
‫كي تنجز الأمور

128
00:07:51,450 --> 00:07:54,140
‫لكن لصوتك نبرة تختلف
‫عن نبرة صوتي

129
00:07:54,400 --> 00:07:57,140
‫يظهر صوتك الناعم اللطف
‫هذا أمر مهدّئ

130
00:07:57,530 --> 00:07:58,490
‫هل هذا صحيح؟

131
00:07:58,570 --> 00:08:00,790
‫أحدهم قال هذا أثناء التسجيل

132
00:08:00,880 --> 00:08:04,050
‫الأغنية التالية
‫كانت "ثنائي الداخل والخارج"

133
00:08:04,260 --> 00:08:05,870
‫إنها أغنية شائقة جداً أيضاً

134
00:08:06,130 --> 00:08:08,520
‫مقارنة بأغنية "لنغنّ أغنية (زينغ)"
‫التي فيها شعور الاتحاد

135
00:08:08,700 --> 00:08:11,650
‫هذه الأغنية فيها إحساس قوي بالتفرّد

136
00:08:11,740 --> 00:08:12,690
‫التفرد؟

137
00:08:12,780 --> 00:08:14,170
‫قوي؟

138
00:08:14,250 --> 00:08:15,250
‫(يو)؟

139
00:08:15,470 --> 00:08:17,080
‫لا، هذا لا شيء

140
00:08:18,380 --> 00:08:23,990
‫لذا فإن رسالة هذه الأغنية
‫هي أن لكل منا جانباً مختلفاً

141
00:08:24,820 --> 00:08:28,850
‫"الداخل والخارج" في العنوان يحمل
‫معنى الذات الحقيقية والذات المزيّفة

142
00:08:28,950 --> 00:08:33,120
‫يجب أن نتقبّل جانبينا
‫كي نتطور كشخص

143
00:08:34,200 --> 00:08:36,450
‫لهذا لا تسمّى "الخارج والداخل"؟

144
00:08:36,930 --> 00:08:39,630
‫أنا أحتار دوماً هل هي أغنية
‫"الداخل والخارج" أم "الخارج والداخل"؟

145
00:08:39,720 --> 00:08:40,620
‫هذا ما يهمّك؟

146
00:08:40,900 --> 00:08:42,930
‫من الصعب حفظ العنوان

147
00:08:43,020 --> 00:08:44,230
‫احفظه غيباً

148
00:08:44,370 --> 00:08:45,270
‫"الداخل والخارج"

149
00:08:45,370 --> 00:08:46,280
‫أم "الخارج والداخل"؟

150
00:08:46,320 --> 00:08:47,620
‫هذا عميق جداً

151
00:08:47,710 --> 00:08:51,620
‫حسن، ننتقل إلى الأغنية التالية
‫إنها أغنيتنا المعتادة

152
00:08:51,890 --> 00:08:53,530
‫"ابحث عن الدليل المطلق"

153
00:09:07,050 --> 00:09:10,220
‫"قلب قد تم صبغه بالكامل
‫منذ البداية"

154
00:09:10,300 --> 00:09:13,430
‫"سلاسل متشابكة
‫كما كان لدينا دوماً"

155
00:09:13,520 --> 00:09:16,690
‫"أولئك الذين نسوا كيف يقاومون"

156
00:09:16,770 --> 00:09:19,680
‫"هم صور ظلّية آمنة وسالمة"

157
00:09:19,940 --> 00:09:23,030
‫"الكلمات الشائعة التي تزعج أذني"

158
00:09:23,110 --> 00:09:26,200
‫"(أنا مميّز)
‫كان هذا منذ وقت طويل"

159
00:09:26,290 --> 00:09:29,510
‫"أشبعت تواً قلبي الساذج المتمرد"

160
00:09:29,590 --> 00:09:32,590
‫"البقية يسيرون مع التيار"

161
00:09:32,680 --> 00:09:33,720
‫"دوّنت كل شيء"

162
00:09:33,800 --> 00:09:38,970
‫"علامة تامة، وأغرقها في البحر"

163
00:09:39,070 --> 00:09:40,890
‫"قبل أن تغرق"

164
00:09:40,980 --> 00:09:45,370
‫"تذكر الآن من سيظهر الدليل"

165
00:09:46,750 --> 00:09:49,020
‫"هذا صحيح، مزّقها"

166
00:09:49,100 --> 00:09:50,580
‫"نماذج الإجابات"

167
00:09:50,660 --> 00:09:52,970
‫"اقتحم طريقك"

168
00:09:53,050 --> 00:09:53,830
‫"(الآن هو الوقت المناسب)"

169
00:09:53,930 --> 00:09:56,570
‫"الشخص الذي يجلس بتهذيب"

170
00:09:56,660 --> 00:09:59,610
‫"لا حاجة لكاتب نص كهذا"

171
00:09:59,700 --> 00:10:01,390
‫"كل شيء مقدّر؟"

172
00:10:01,530 --> 00:10:03,310
‫"من قرر هذا؟"

173
00:10:03,390 --> 00:10:05,560
‫"دمر كل شهادات الشيطان"

174
00:10:05,700 --> 00:10:06,610
‫"(الآن هو الوقت المناسب)"

175
00:10:06,700 --> 00:10:09,250
‫"بهاتين الساقين اللتين ليستا
‫لمجرد الزينة"

176
00:10:09,350 --> 00:10:14,650
‫"اركل السكك المليئة بالحبكة"

177
00:10:24,990 --> 00:10:28,290
‫لهذه الأغنية تصميم رقص صعب حقاً

178
00:10:28,640 --> 00:10:30,200
‫أنا مستنزف

179
00:10:30,550 --> 00:10:31,890
‫هل أنت بخير يا (يو)؟

180
00:10:31,990 --> 00:10:34,020
‫لننته لهذا اليوم يا (يوشينو)

181
00:10:34,110 --> 00:10:36,060
‫لا يزال لدينا المزيد
‫من الأغاني لنغنيها

182
00:10:38,020 --> 00:10:40,850
‫لماذا يكون تصميم الرقص
‫صعباً جداً أساساً؟

183
00:10:41,890 --> 00:10:45,490
‫قالت رئيستنا إن علينا القيام بهذا
‫ما دمنا لا نزال يافعين

184
00:10:45,580 --> 00:10:47,060
‫ما الذي يجعلك تقول هذا؟

185
00:10:47,410 --> 00:10:50,700
‫لكن بسبب هذا
‫الأغنية رائعة جداً

186
00:10:51,010 --> 00:10:53,320
‫إنها صورة قلب متمرّد

187
00:10:53,400 --> 00:10:54,790
‫هذه هي الصورة؟

188
00:10:54,970 --> 00:10:57,050
‫ماذا تخيلت عندما كنت تغنيها؟

189
00:10:57,310 --> 00:10:59,660
‫غنيت كثيراً بحيث لم أعد أذكر

190
00:10:59,780 --> 00:11:01,570
‫كنت تغنيها الآن تواً!

191
00:11:01,660 --> 00:11:05,000
‫إنه ينسى غناءه ما إن ينتهي منه

192
00:11:05,300 --> 00:11:08,130
‫بالمناسبة، كنت تجد صعوبة
‫في تصميم الرقص عكس العادة

193
00:11:08,870 --> 00:11:09,910
‫حينها؟

194
00:11:10,000 --> 00:11:12,600
‫لكنني أتقنتها بعد ذلك
‫بعد محاولة واحدة فقط

195
00:11:12,820 --> 00:11:14,340
‫ألديك حيلة؟

196
00:11:15,520 --> 00:11:17,120
‫حاول أن تجعلها سهلة، كما أظن؟

197
00:11:17,210 --> 00:11:18,250
‫ماذا تقول؟

198
00:11:18,430 --> 00:11:20,290
‫هذا لا يفيد مطلقاً

199
00:11:20,430 --> 00:11:24,640
‫حاول جعلها سهلة... أنقص
‫عدم الجدوى وتعلم بالسرعة القصوى؟

200
00:11:24,730 --> 00:11:25,470
‫هذا عميق جداً

201
00:11:25,550 --> 00:11:26,470
‫إنه كذلك!

202
00:11:26,550 --> 00:11:28,850
‫تظهر كلمات أساسية جديدة
‫واحدة تلو الأخرى

203
00:11:28,940 --> 00:11:30,860
‫هل هذا هو موضوع
‫لقاء معجبينا التالي؟

204
00:11:30,940 --> 00:11:32,720
‫يا له من تنبّؤ متقدّم!

205
00:11:32,810 --> 00:11:35,370
‫سأكتب كل شيء حتى لو تفتّت ذراعاي

206
00:11:35,460 --> 00:11:38,320
‫ماذا؟ كان يقول تواً إنه يريد
‫أن يجعل كل شيء أسهل؟

207
00:11:38,360 --> 00:11:40,190
‫إنه رائع جداً!

208
00:11:40,370 --> 00:11:44,360
‫حسن، تالياً، سنقدم لكم
‫أربع أغان متلاحقة

209
00:11:45,660 --> 00:11:46,840
‫لنفعل هذا يا (يو)

210
00:11:46,920 --> 00:11:49,310
‫_ ابذل ما في وسعك
‫_ ابذل ما في وسعك أنت أيضاً

211
00:11:50,490 --> 00:11:51,580
‫ها نحن أولاء!

212
00:11:51,840 --> 00:11:54,000
‫"مجموعة أغاني (زينغز) الخاصة"

213
00:11:55,440 --> 00:11:58,790
‫"التفتي حالاً إلى ساحل البحر"

214
00:11:58,870 --> 00:12:01,180
‫"متأنّقة بطريقة ماهرة يا عزيزتي"

215
00:12:02,000 --> 00:12:05,130
‫"حتى الشمس التي توجد
‫في السماء العالية"

216
00:12:05,210 --> 00:12:08,340
‫"تتظاهر أنها كرة ديسكو"

217
00:12:08,440 --> 00:12:11,730
‫"صيفنا لا ينتهي أبداً"

218
00:12:11,820 --> 00:12:13,210
‫"اهرب لتنقذ نفسك"

219
00:12:13,300 --> 00:12:16,040
‫"مقتحماً القدر من دون
‫النظر إلى الخلف مطلقاً"

220
00:12:16,120 --> 00:12:18,730
‫"الجواب بين أيدينا"

221
00:12:18,820 --> 00:12:19,810
‫"(إنه البقاء على قيد الحياة)"

222
00:12:19,910 --> 00:12:23,200
‫"لنذهب كثنائي حتى النهاية
‫إلى أن يشبع قلبانا"

223
00:12:23,290 --> 00:12:26,460
‫"نستطيع رسمه، حلمنا"

224
00:12:26,550 --> 00:12:30,760
‫"اجمع كل الكلمات السحرية
‫من جميع أرجاء العالم"

225
00:12:30,850 --> 00:12:32,800
‫"واصرخ بأمنيتك بصوت مرتفع"

226
00:12:32,890 --> 00:12:34,850
‫"عالم البطل"

227
00:12:36,670 --> 00:12:38,150
‫"صباح الخير لك"

228
00:12:38,240 --> 00:12:39,720
‫"افتح النافذة"

229
00:12:39,800 --> 00:12:41,230
‫"أدخل نور الشمس"

230
00:12:41,320 --> 00:12:43,010
‫"ابتسامة مثالية"

231
00:12:43,110 --> 00:12:44,620
‫"بدّل ملابسك الآن"

232
00:12:44,710 --> 00:12:46,360
‫"اذهب إلى البلدة"

233
00:12:46,440 --> 00:12:49,010
‫"وابدأ يوماً جديداً"

234
00:12:52,050 --> 00:12:55,140
‫"منذ اليوم الذي التقيتك فيه"

235
00:12:55,220 --> 00:12:59,130
‫"كم تتقاطع سبلنا بعضها مع بعض؟"

236
00:12:59,220 --> 00:13:02,260
‫"سرنا كتفاً يستند إلى كتف"

237
00:13:02,340 --> 00:13:06,170
‫"على طريق وعر"

238
00:13:06,250 --> 00:13:09,740
‫"إن وقفنا على المسرح
‫نحن الاثنان فقط"

239
00:13:09,820 --> 00:13:11,560
‫"سننجح بطريقة ما"

240
00:13:11,650 --> 00:13:12,390
‫"اسمعوني، (اسمعوني)"

241
00:13:12,470 --> 00:13:13,250
‫"أنتم، (أنتم)"

242
00:13:13,390 --> 00:13:16,510
‫"رغم أننا شخصان متناقضان"

243
00:13:16,600 --> 00:13:20,550
‫"ما زلنا نتقاسم النظرة نفسها"

244
00:13:25,900 --> 00:13:27,160
‫كانت مجموعة الأغاني مذهلة!

245
00:13:27,240 --> 00:13:29,590
‫لن أنسى هذا اليوم مطلقاً

246
00:13:29,810 --> 00:13:31,680
‫"عزيزني المزعجة"، "البطل"

247
00:13:31,760 --> 00:13:34,020
‫"الصباح"، "إعلان عمل الفريق"

248
00:13:34,320 --> 00:13:36,070
‫قدمنا لكم هذه الأغاني الأربع
‫بشكل متتال

249
00:13:36,370 --> 00:13:37,150
‫كيف تشعر يا (يو)؟

250
00:13:37,230 --> 00:13:38,800
‫أنا مستنزَف جداً

251
00:13:38,890 --> 00:13:39,980
‫بالتأكيد أنت كذلك

252
00:13:40,060 --> 00:13:42,320
‫كانت الدروس صعبة أيضاً

253
00:13:42,580 --> 00:13:46,190
‫غنينا كما لو أننا كنا
‫نعيد النظر إلى سنتينا الماضيتين

254
00:13:46,620 --> 00:13:49,880
‫الأوقات السعيدة تمر بسرعة البرق...

255
00:13:50,750 --> 00:13:54,140
‫في البداية، لم أكن الشخص
‫الذي يصعد على المسرح

256
00:13:54,180 --> 00:13:55,140
‫(يوشينو)

257
00:13:55,480 --> 00:13:58,350
‫لكن بعد هاتين السنتين مع (زينغز)

258
00:13:58,650 --> 00:14:03,480
‫أستطيع الغناء والرقص
‫أمام حضور كبير كهذا

259
00:14:03,700 --> 00:14:06,560
‫ما كان في وسعي تخيل هذا
‫منذ سنتين

260
00:14:07,260 --> 00:14:11,380
‫هذا أيضاً بفضلكم يا معجبيّ
‫لأنكم دعمتموني دوماً

261
00:14:11,740 --> 00:14:12,780
‫شكراً جزيلاً لكم

262
00:14:12,990 --> 00:14:15,070
‫نحن من يجب أن نشكركم

263
00:14:15,170 --> 00:14:17,250
‫نحن ممتنات لـ(زينغز)

264
00:14:17,380 --> 00:14:18,770
‫شكراً لأنكما موجودان

265
00:14:18,900 --> 00:14:20,680
‫نحن ممتنات على كل شيء

266
00:14:20,820 --> 00:14:22,160
‫يؤسفني أن أقول هذا...

267
00:14:22,250 --> 00:14:23,850
‫لكن حان وقت الوداع...

268
00:14:24,510 --> 00:14:26,030
‫شكراً لكم جميعاً

269
00:14:26,200 --> 00:14:27,280
‫إلى اللقاء

270
00:14:30,550 --> 00:14:34,460
‫يغيرون التجهيزات قبل الإعادات
‫ماذا؟

271
00:14:36,060 --> 00:14:36,840
‫ماذا؟

272
00:14:37,150 --> 00:14:38,850
‫لماذا لا يطلب أحد الإعادة؟

273
00:14:39,750 --> 00:14:40,670
‫هذا صحيح!

274
00:14:40,750 --> 00:14:43,970
‫لم يطلب الناس الإعادة يوماً
‫في حفلات (زينغز)

275
00:14:44,270 --> 00:14:46,530
‫ألا يزالون مذهولين برؤيتهما
‫على مسرح كبير؟

276
00:14:46,890 --> 00:14:48,010
‫هل علي...

277
00:14:48,100 --> 00:14:50,360
‫لا، هناك خطر أن يكشف أمرنا

278
00:14:50,960 --> 00:14:52,050
‫ماذا علي...

279
00:14:52,530 --> 00:14:54,050
‫مرة أخرى!

280
00:14:54,390 --> 00:14:59,220
‫مرة أخرى! مرة أخرى! مرة أخرى!

281
00:14:59,480 --> 00:15:01,310
‫إن كان هذا قد حدث
‫ليس منذ وقت طويل جداً...

282
00:15:01,390 --> 00:15:03,210
‫كنا سنحتار كثيراً

283
00:15:03,300 --> 00:15:07,260
‫لكن كليهما عملا بجد كبير
‫لذا علينا دعمهما

284
00:15:07,520 --> 00:15:12,860
‫مرة أخرى! مرة أخرى! مرة أخرى!

285
00:15:13,300 --> 00:15:14,420
‫مستحيل، مستحيل!

286
00:15:14,510 --> 00:15:16,210
‫أخيراً، أتى يوم طلب الإعادة

287
00:15:16,290 --> 00:15:18,940
‫شعرت بالذعر
‫عندما لم يطلب أحد إعادة

288
00:15:18,990 --> 00:15:20,120
‫(نيودو)

289
00:15:20,200 --> 00:15:22,120
‫(كازوكي)!

290
00:15:22,200 --> 00:15:24,030
‫اخرج الآن يا (نيودو)

291
00:15:24,110 --> 00:15:27,460
‫(يوشينو)، (يوشينو)، (يوشينو)
‫(يوشينو)، (يوشينو)، (يوشينو)

292
00:15:30,810 --> 00:15:32,230
‫مرة أخرى!

293
00:15:38,230 --> 00:15:41,450
‫في البداية، لم نواجه سوى المشاكل

294
00:15:43,280 --> 00:15:46,270
‫لكن بدأت الأمور تتحسن
‫أليست كذلك؟

295
00:15:54,220 --> 00:15:56,270
‫_ شبح...
‫_ محبوب جماهير

296
00:15:56,960 --> 00:15:59,820
‫مرة أخرى! مرة أخرى!

297
00:16:01,610 --> 00:16:02,950
‫(نيودو)!

298
00:16:03,170 --> 00:16:05,130
‫كان أداؤك رائعاً جداً

299
00:16:05,390 --> 00:16:08,520
‫أنا سعيدة جداً لأنك لم تنسحب

300
00:16:08,860 --> 00:16:09,600
‫(أساهي)

301
00:16:09,770 --> 00:16:10,300
‫نعم؟

302
00:16:10,340 --> 00:16:12,340
‫هل أنت على وشك
‫دخول الحياة الأخرى؟

303
00:16:12,510 --> 00:16:13,560
‫الحياة الأخرى؟

304
00:16:13,640 --> 00:16:15,340
‫انتهى الحفل، لذا...

305
00:16:15,820 --> 00:16:16,770
‫لا تخبرني

306
00:16:16,860 --> 00:16:19,250
‫كنت تتحدث عني
‫في "هدية للحياة الأخرى"

307
00:16:19,690 --> 00:16:20,810
‫لا

308
00:16:20,900 --> 00:16:24,630
‫بدوت سعيدة جداً بها
‫وأنت طلبت مني الصعود على المسرح

309
00:16:25,200 --> 00:16:26,590
‫ليس هذا هو الأمر

310
00:16:27,190 --> 00:16:33,670
‫اليوم أردت أن أعرف إلى أين وصلت (زينغز)
‫منذ أول مرة شاهدتكما فيها

311
00:16:34,450 --> 00:16:36,760
‫ليس لدي وقت لأصعد

312
00:16:37,020 --> 00:16:41,890
‫سنستمر في هدف الوصول إلى أن تصبح
‫أفضل محبوب جماهير على الإطلاق معاً

313
00:16:43,530 --> 00:16:44,880
‫(يو)؟

314
00:16:45,180 --> 00:16:46,660
‫أنا بخير

315
00:16:47,010 --> 00:16:49,270
‫سأركز قليلاً يا (يوشينو)

316
00:16:49,790 --> 00:16:50,870
‫حسن

317
00:16:50,970 --> 00:16:52,740
‫سنغني "ذاك" بعد ذلك

318
00:16:52,830 --> 00:16:56,270
‫(نيودو)، سنبدأ الإعادة

319
00:16:56,310 --> 00:16:57,430
‫هيا

320
00:16:57,570 --> 00:16:58,310
‫لا

321
00:16:58,480 --> 00:17:01,300
‫لا يزال هناك عضو
‫لم يأت بعد

322
00:17:01,600 --> 00:17:02,820
‫سأبادلك مكاني

323
00:17:03,040 --> 00:17:04,300
‫ماذا؟ من؟

324
00:17:07,520 --> 00:17:08,740
‫ألا يعجبك هذا؟

325
00:17:09,300 --> 00:17:10,510
‫أن تكوني محبوبة جماهير

326
00:17:12,730 --> 00:17:13,690
‫أجل

327
00:17:31,940 --> 00:17:35,670
‫"عندما تابعت البحث"

328
00:17:36,450 --> 00:17:41,490
‫"عن أخطائي"

329
00:17:42,790 --> 00:17:48,270
‫"فقدت الجواب الصحيح"

330
00:17:48,360 --> 00:17:53,700
‫"في ليل من دون فجر، أنا أرتعش"

331
00:17:56,000 --> 00:18:00,430
‫"أستخدم النور الذي كنت أفقده"

332
00:18:00,520 --> 00:18:05,390
‫"أشعله لأبدد ظلمته"

333
00:18:06,950 --> 00:18:11,900
‫"التفكير بالأمر مرة تلو الأخرى"

334
00:18:12,160 --> 00:18:18,020
‫"قد ملأ قلبي الفارغ"

335
00:18:18,120 --> 00:18:23,200
‫"رغم ذلك، ها أنت ذا"

336
00:18:23,980 --> 00:18:26,940
‫"من دون أن أعلم أخذت يدي"

337
00:18:27,020 --> 00:18:30,150
‫"وسرت بي إلى الأمام"

338
00:18:30,230 --> 00:18:36,190
‫"لأننا لا نزال نستطيع
‫العثور على قوّتنا"

339
00:18:36,630 --> 00:18:39,270
‫"بينما نتقبل تلك الأيام"

340
00:18:39,620 --> 00:18:42,580
‫"سنتغلب على هذا"

341
00:18:42,920 --> 00:18:48,740
‫"يمكنك الوثوق بي"

342
00:18:51,220 --> 00:18:54,050
‫"أنت تعاني، أنت تقلق"

343
00:18:54,130 --> 00:18:56,820
‫"لكن رغم ذلك
‫لا يزال في وسعك النهوض ثانية"

344
00:18:56,920 --> 00:18:58,390
‫"من الآن فصاعداً"

345
00:18:58,480 --> 00:19:03,170
‫هل يمكنني أن أكون
‫الشخص الذي يدعمك؟"

346
00:19:03,600 --> 00:19:09,950
‫"كنت دوماً لطيفاً
‫منذ الأبد وإلى الأبد"

347
00:19:10,030 --> 00:19:12,200
‫"هذا لك"

348
00:19:12,300 --> 00:19:16,110
‫"شكراً لك"

349
00:19:19,340 --> 00:19:23,110
‫شكراً لكم على طلب الإعادة جميعكم!

350
00:19:23,200 --> 00:19:27,500
‫بفضل استدعائكم
‫تمكنّا من العودة إلى هنا ثانية

351
00:19:29,150 --> 00:19:31,590
‫أريد أيضاً أن أشكركم

352
00:19:33,230 --> 00:19:34,880
‫إنه (نيودو) بنموذج الرئيس

353
00:19:34,980 --> 00:19:37,530
‫كنت سعيدة جداً
‫لأنه عمل بجد كبير

354
00:19:37,620 --> 00:19:40,490
‫لكنني أشعر بالراحة
‫لأنه يبدو أنه يستمتع بوقته

355
00:19:40,580 --> 00:19:44,570
‫أغنية الإعادة التي سمعتموها تواً
‫كانت "تغلب على المفقود"

356
00:19:44,660 --> 00:19:47,350
‫هذه الأغنية هي أول قصة غنائية
‫لفريق (زينغز)

357
00:19:47,390 --> 00:19:49,830
‫تحدينا نفسينا لنجرب تأليفاً جديداً

358
00:19:50,400 --> 00:19:53,650
‫في الواقع تشجّعت كثيراً
‫بسبب هذه الأغنية

359
00:19:53,750 --> 00:19:55,610
‫هل كان هذا في الوقت نفسه؟

360
00:19:55,690 --> 00:19:56,300
‫أجل

361
00:19:56,390 --> 00:19:59,560
‫كان في الوقت نفسه
‫الذي تلقّيت فيه عرض المسلسل

362
00:19:59,740 --> 00:20:04,950
‫كنت قلقاً لأعرف إن كنت أستطيع التمثيل
‫وإن كان لا بأس أن أفعل هذا

363
00:20:05,040 --> 00:20:08,550
‫عندما وصلتنا هذه الأغنية
‫وضعت مشاعري كلها فيها

364
00:20:08,600 --> 00:20:09,470
‫نعم

365
00:20:09,590 --> 00:20:14,720
‫(يو) أيضاً كان يبذل ما في وسعه
‫في ذلك الوقت

366
00:20:14,810 --> 00:20:17,510
‫لذا فكرت أن أقوم
‫بخطوة إلى الأمام أيضاً

367
00:20:17,590 --> 00:20:18,680
‫(يوشينو)!

368
00:20:18,850 --> 00:20:24,450
‫لذا "تغلب على المقود" هي من أجل
‫الذين يواجهون مشكلة ويتألمون بسببها

369
00:20:24,590 --> 00:20:28,420
‫الذين يعلقون في موقف عاصف

370
00:20:28,500 --> 00:20:30,670
‫هذه الأغنية مقدمة لتشجعهم

371
00:20:30,930 --> 00:20:32,590
‫"أنت لست وحيداً"

372
00:20:32,670 --> 00:20:34,320
‫"كل شيء سيكون بخير"

373
00:20:34,450 --> 00:20:36,240
‫"نريد السير معك"

374
00:20:36,280 --> 00:20:39,530
‫نغني هذه الأغنية ونحن نفكر بهذا

375
00:20:39,880 --> 00:20:41,830
‫في هذه القاعة أيضاً

376
00:20:41,920 --> 00:20:45,000
‫ربما يكون هناك أشخاص
‫متعبون وفاقدون للدافع

377
00:20:45,660 --> 00:20:50,260
‫حتى أنا مررت بوقت
‫كنت فيه وحيداً وشعرت بالضياع

378
00:20:51,090 --> 00:20:56,390
‫لكنني الآن هنا، أمامكم
‫عضو في فريق (زينغز)

379
00:20:56,570 --> 00:20:58,700
‫لا يمكنني أن أكون أكثر سعادة

380
00:20:59,000 --> 00:21:02,820
‫كان من دواعي سرورنا أن نكون معكم
‫في حفل الذكرى السنوية الثانية لنا

381
00:21:06,210 --> 00:21:07,520
‫(نيودو)!

382
00:21:07,600 --> 00:21:10,070
‫كان هذا من دواعي سرورنا أيضاً

383
00:21:10,170 --> 00:21:12,990
‫لا يمكنني تخيل حياة من دونك

384
00:21:14,900 --> 00:21:16,640
‫شكراً جزيلاً لك

385
00:21:16,810 --> 00:21:18,990
‫ما زلنا نغني

386
00:21:19,070 --> 00:21:20,890
‫هل أنتم مستعدون؟

387
00:21:23,460 --> 00:21:25,020
‫تالياً، سنقدم لكم

388
00:21:25,200 --> 00:21:26,410
‫هذه الأغنية

389
00:21:26,710 --> 00:21:28,500
‫"ما وراء الختام"

390
00:21:29,800 --> 00:21:32,020
‫"هيا، لنذهب معاً"

391
00:21:32,100 --> 00:21:38,320
‫"المشهد الختامي البعيد أصبح أمامنا"

392
00:21:43,490 --> 00:21:48,530
‫"الدرب الذي تغلبنا عليه
‫معاً كشخص واحد"

393
00:21:48,870 --> 00:21:54,910
‫"طبعات الأقدام التي لا تحصى
‫التي أرشدتنا"

394
00:21:56,310 --> 00:22:01,160
‫"هذه هي الأدلة المطلقة
‫التي أوصلتنا إلى هنا"

395
00:22:01,820 --> 00:22:06,170
‫"لم يعد هناك ما يدعو للشك"

396
00:22:07,900 --> 00:22:09,680
‫"لمعانك"

397
00:22:09,770 --> 00:22:11,290
‫"وجهك المشاكس"

398
00:22:11,420 --> 00:22:12,890
‫"في الداخل والخارج معاً"

399
00:22:12,990 --> 00:22:14,590
‫"أنا معتاد عليه"

400
00:22:14,680 --> 00:22:17,460
‫"هكذا وصلنا إلى هنا"

401
00:22:17,550 --> 00:22:24,360
‫"الآن، حان الوقت لنا كي نبدأ"

402
00:22:24,460 --> 00:22:27,230
‫"كنا نقطع وعداً"

403
00:22:27,330 --> 00:22:31,540
‫"لنرقص معاً إلى الأبد"

404
00:22:31,620 --> 00:22:33,840
‫"أنا آمنت بذلك"

405
00:22:33,930 --> 00:22:37,190
‫"لقد حلمت أنت به أيضاً"

406
00:22:37,270 --> 00:22:40,180
‫"لا أستطيع التلفّظ بكلمة"

407
00:22:40,280 --> 00:22:44,350
‫"تصف ما رأيناه كلانا على المسرح"

408
00:22:44,450 --> 00:22:50,350
‫"إن أردنا ربط الكلمات
‫لتصبح قصة"

409
00:22:53,170 --> 00:22:56,220
‫"ما وراء الفترة"

410
00:22:56,300 --> 00:23:00,250
‫"تستمر قصتنا"

411
00:23:00,300 --> 00:23:02,780
‫"أنا هنا تماماً"

412
00:23:02,860 --> 00:23:05,950
‫"أنت تبتسم معي أيضاً"

413
00:23:06,030 --> 00:23:08,940
‫"لنغنّ معاً"

414
00:23:09,030 --> 00:23:13,160
‫"ليس نحن الاثنان فقط، بل جميعنا"

415
00:23:13,250 --> 00:23:18,500
‫"إن أردنا خلق قصة جديدة تماماً"

416
00:23:18,590 --> 00:23:20,940
‫"هيا! لنذهب معاً"

417
00:23:21,030 --> 00:23:26,800
‫"المشهد الختامي البعيد يلوح أمامنا"

418
00:23:38,360 --> 00:23:39,310
‫محبوبو جماهير

419
00:23:39,660 --> 00:23:42,480
‫إنهم يلمعون على المسرح

420
00:23:42,790 --> 00:23:45,490
‫يجلبون الفرح إلى معجبيهم

421
00:23:47,180 --> 00:23:51,790
‫هؤلاء المعجبون يجعلونهم يلمعون أكثر

422
00:23:52,990 --> 00:23:55,260
‫وما دام يحبهم المعجبون

423
00:23:55,700 --> 00:23:57,740
‫لن يفقدوا لمعانهم أبداً

424
00:23:58,000 --> 00:24:01,560
‫"إلى اللقاء ثانية"