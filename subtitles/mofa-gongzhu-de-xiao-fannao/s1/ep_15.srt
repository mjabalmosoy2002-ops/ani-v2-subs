1
00:02:07,340 --> 00:02:08,740
ما الّذي يجري في الخارج؟

2
00:02:08,740 --> 00:02:10,420
تبدو الأجواء حافلة

3
00:02:11,060 --> 00:02:13,500
!اليوم هو مهرجان حصاد الخريف الخاصّ بأوغا

4
00:02:13,500 --> 00:02:15,570
هل ترغبين في إلقاء نظرة، سموّكِ؟

5
00:02:26,290 --> 00:02:27,340
...مُذهل

6
00:02:29,330 --> 00:02:30,950
!يوجد كثير من النّاس هنا

7
00:02:32,010 --> 00:02:34,370
!سموّك، انظري من جاء

8
00:02:40,880 --> 00:02:41,860
!أبي

9
00:02:48,810 --> 00:02:52,070
هل ما زلتِ تتذكّرين ما وعدتِني به
قبل أن تُغادري؟

10
00:02:53,020 --> 00:02:57,540
أخيراً... يجب أن تكتبي لي يوميّاً
تقريراً حول الوضع

11
00:02:58,660 --> 00:03:00,360
...أنا

12
00:03:01,750 --> 00:03:02,550
!بئساً لي

13
00:03:02,550 --> 00:03:07,800
حدثتْ أمور كثيرة منذ وصولي إلى هنا لدرجة
...أنّني نسيتُ بأنّه يترتّب عليّ الكتابة له

14
00:03:10,460 --> 00:03:12,500
...لم أنسَ عمداً

15
00:03:12,500 --> 00:03:15,100
ماذا تفعل هنا يا أبي؟

16
00:03:15,100 --> 00:03:19,680
!سموّكِ، إنّه يوم المهرجان، للاحتفال بالحصاد

17
00:03:19,680 --> 00:03:22,550
جلالته مُتوجّه أيضاً إلى نبيع الأصل
لأداء طقس الثّناء

18
00:03:22,550 --> 00:03:25,120
!هكذا إذاً

19
00:03:26,500 --> 00:03:29,490
ينبغي أن تأتي معي هذه المرّة

20
00:03:29,950 --> 00:03:32,340
!رائع! إنّهما جلالته وسموّ الأميرة

21
00:03:32,340 --> 00:03:34,530
!شرف لأوغا أن يتواجدا هنا

22
00:03:34,530 --> 00:03:40,020
اليوم، نُرحّب بجلالة الإمبراطور
وسموّ الأميرة

23
00:03:35,260 --> 00:03:37,520
!يا لها من أميرة حسناء

24
00:03:37,520 --> 00:03:40,020
...وكأنّها خرجت من لوحة فنّية

25
00:03:40,020 --> 00:03:42,960
للشّروع في مراسم الثّناء المُقدّسة هذه

26
00:03:40,540 --> 00:03:42,960
!الأميرة جميلة جدّاً

27
00:03:44,980 --> 00:03:47,490
ها هي أكبر سنابل القمح في هذا العام

28
00:03:47,490 --> 00:03:50,120
إنّها ترمز إلى حصادنا وأملنا

29
00:03:51,350 --> 00:03:54,260
هلّا قدّم جلالته وسموّها مشكورَين
وبالنّيابة عنّا

30
00:03:54,260 --> 00:03:56,650
بذرة الأمل هذه لنبع الأصل

31
00:03:56,650 --> 00:04:02,060
عسى لمجد أوبيليا أن يُلازمنا ويُبارك
بهذه الأرض بازدهار أبديّ

32
00:04:02,060 --> 00:04:03,820
!جلالة الإمبراطور العظيم

33
00:04:03,820 --> 00:04:05,470
!سموّكِ

34
00:04:05,470 --> 00:04:08,900
!يحيا الحصاد والأمل
!يحيا النُّور والازدهار

35
00:04:08,900 --> 00:04:10,780
!عسى أن يدوم مجد أوبيليا للأبد

36
00:04:10,780 --> 00:04:12,770
،بوجود جلالته وسموّها هنا

37
00:04:12,770 --> 00:04:15,240
من المُقدّر لأوغا أن تزدهر
!ازدهاراً عظيماً بكلّ تأكيد

38
00:04:19,580 --> 00:04:20,820
أنتِ ترتدينه

39
00:04:21,780 --> 00:04:25,630
أجل. أحبّ حقّاً هديّة عيد الميلاد
الّتي أعطيتني إيّاها يا أبي

40
00:04:26,520 --> 00:04:27,940
إنّها تلائمكِ كثيراً

41
00:04:27,940 --> 00:04:31,260
جلالتك، سموّك. المنطقة المحظورة
أمامنا فحسب

42
00:04:31,260 --> 00:04:34,620
الطّريق يسمح لدخول أصحاب
الدّم الملكيّ فقط

43
00:04:35,720 --> 00:04:37,720
سوف أنتظر هنا

44
00:04:37,720 --> 00:04:40,780
عسى أن يُلازما مجد أوبيليا

45
00:04:48,770 --> 00:04:51,110
،كنتُ أتقفّى آثار السّحر الظّلاميّ

46
00:04:51,920 --> 00:04:53,780
...لكن لم أتوقّع أن تؤدّي إلى برجي الخاصّ

47
00:04:54,780 --> 00:04:56,700
من يجرؤ على فعل هذا؟

48
00:04:57,480 --> 00:05:00,140
...وحتّى أنّهم عبثوا بمكتبتي

49
00:05:00,900 --> 00:05:02,080
...لنرَ

50
00:05:06,640 --> 00:05:11,050
كما هو مُتوقّع، انجذبوا إلى هنا بواسطة هذا
الكتاب حول السّحر الظّلاميّ المُحرَّم

51
00:05:13,870 --> 00:05:16,840
...ما الّذي يخطّط له

52
00:05:20,100 --> 00:05:23,430
!أتاناشيا؟ ماذا يفعلان هنا؟

53
00:05:25,100 --> 00:05:27,990
إذاً نبع الأصل السّحريّ موجود
تحت برج القدّيس؟

54
00:05:27,990 --> 00:05:31,870
أجل. يتواجد في قمّة البرج السّاحر
الأعظم الّذي يحمي النّبع

55
00:05:31,870 --> 00:05:34,100
من الاضطراب، جيلاً بعد جيل

56
00:05:34,100 --> 00:05:36,070
السّاحر الأعظم؟

57
00:05:36,070 --> 00:05:40,200
ألم أخبرك؟ أنا السّاحر الأعظم

58
00:05:40,200 --> 00:05:43,790
هل يُعقَل أن يكون لوكاس هو السّاحر
الّذي يحمي النّبع؟

59
00:05:43,790 --> 00:05:48,610
ذلك الشّاب الّذي يجلس مُتكاسلاً
!كلّ يوم؟ مستحيل

60
00:05:57,930 --> 00:06:03,630
مُذهل! هل هذا... نبع أساطير الأصل؟

61
00:06:04,210 --> 00:06:08,500
...مسقط رأس الإيلف، أصل كلّ الحياة

62
00:06:12,220 --> 00:06:14,550
يُفترض أن يكون هذا مكاناً مُقدّساً

63
00:06:14,550 --> 00:06:18,260
لكن لماذا أشعر بشعور خانق
في أعماق قلبي؟

64
00:06:18,260 --> 00:06:20,210
تعالي يا أتاناشيا

65
00:06:28,870 --> 00:06:32,340
يا لها من مانا دافئة. وكأنّها حيّة

66
00:06:33,460 --> 00:06:35,830
يبدو أنّ النّبع يحبّكِ

67
00:06:35,830 --> 00:06:37,410
ما هذه الأضواء؟

68
00:06:37,410 --> 00:06:39,340
إنّها الطّاقة الّتي تتسرّب من النّبع

69
00:06:39,340 --> 00:06:41,720
إنّها أيضاً ما يُحافظ على المانا
لكافّة الأشياء

70
00:06:43,940 --> 00:06:47,840
،يمكنها الشُّعور بقلوب النّاس
وتستجيب للصّلوات النّقية فقط

71
00:06:49,060 --> 00:06:51,200
لنبدأ إذاً

72
00:06:53,780 --> 00:06:55,570
،إلى نبع الأصل السّحريّ الأبديّ

73
00:06:56,380 --> 00:07:02,820
أنا، دي آلغير أوبيليا، باسم
،إمبراطوريّة أوبيليا

74
00:07:03,360 --> 00:07:05,920
أقدّم أصدق امتنانٍ لي

75
00:07:14,660 --> 00:07:16,410
دوركِ يا أتاناشيا

76
00:07:34,400 --> 00:07:39,090
،نبع الأصل السّحريّ النّقيّ والمُقدّس
أنا أتاناشيا دي آلغير أوبيليا

77
00:07:39,860 --> 00:07:42,640
شكراً على منح الحياة لكلّ شيء

78
00:07:43,460 --> 00:07:46,090
من فضلك اقبل هذه الهِبة، والّتي
تُمثّل الحصاد

79
00:08:02,120 --> 00:08:04,720
!أبي! قَبِلَ النّبعُ هِبتي

80
00:08:07,670 --> 00:08:08,630
!أتاناشيا

81
00:08:14,030 --> 00:08:16,990
لماذا أشعر... بدُوار...؟

82
00:08:22,200 --> 00:08:24,810
أنا... تحت الماء؟

83
00:08:39,670 --> 00:08:40,640
!أبي

84
00:08:43,870 --> 00:08:45,140
لا تخافي يا أتاناشيا

85
00:08:45,760 --> 00:08:47,100
ثمّة مُشكلة في هذا المكان

86
00:08:47,100 --> 00:08:48,410
سنغادر فوراً

87
00:08:52,250 --> 00:08:54,440
!إنّهم... إنّهم يتكاثرون

88
00:08:59,020 --> 00:08:59,820
!اهربي

89
00:09:01,470 --> 00:09:02,570
!أبي

90
00:09:03,890 --> 00:09:05,700
!أتاناشيا! أتاناشيا

91
00:09:05,700 --> 00:09:06,760
!أتاناشيا

92
00:09:08,760 --> 00:09:09,330
!أبي

93
00:09:10,880 --> 00:09:11,710
أبي؟

94
00:09:13,270 --> 00:09:15,550
لوكاس؟ لماذا أنت هنا؟

95
00:09:16,180 --> 00:09:18,870
رأيتُكما في خطر، لذا سارعتُ إلى هنا

96
00:09:19,400 --> 00:09:22,060
هناك أزهار لوتس الأحلام في الماء

97
00:09:24,720 --> 00:09:26,610
استخدم أحدٌ تعويذةً على زينة شعركِ

98
00:09:26,610 --> 00:09:28,540
أدّى ذلك إلى هيّجان النّباتات هنا

99
00:09:29,640 --> 00:09:31,800
هاجمَتْكِ أزهار لوتس الأحلام قبل قليل

100
00:09:34,930 --> 00:09:36,420
كيف حال أبي؟

101
00:09:36,420 --> 00:09:37,590
إنّه عالق

102
00:09:38,100 --> 00:09:40,660
حفّزتْ أزهار لوتس الأحلام سحر
الدّفاع الذّاتيّ الخاص به

103
00:09:40,660 --> 00:09:44,070
إنّه الآن نائم داخل حاجزه الخاصّ

104
00:09:44,390 --> 00:09:45,740
ماذا؟

105
00:09:49,710 --> 00:09:51,810
!أبي! استيقظ

106
00:09:53,750 --> 00:09:57,520
،حاولتُ دخول منطقته اللّاواعية لإيقاظه

107
00:09:59,280 --> 00:10:03,180
لكن لا يستطيع أحدٌ الدّخول غير
أولئك الّذين يثق بهم كلّياً

108
00:10:04,210 --> 00:10:08,530
إنّ كسر الحاجز بالقوّة سيؤدّي
إلى الإضرار بعقله

109
00:10:11,060 --> 00:10:15,350
كان أبي قد أنقذني للتو، والآن
...هو عالق في الدّاخل هناك

110
00:10:16,270 --> 00:10:17,700
كيف يمكن لهذا أن يحدث؟

111
00:10:18,910 --> 00:10:21,770
أطلقَ جلالته الحاجزَ الواقي
الأقوى حول نفسه

112
00:10:22,100 --> 00:10:24,900
وحدكِ أنتِ والملكة دايانا تستطيعان الدّخول

113
00:10:24,900 --> 00:10:28,500
لأنّكما الوحيدان اللّتان يثق بهما
جلالته ثِقة تامّة

114
00:10:30,300 --> 00:10:32,890
لوكاس، يمكنني دخول حاجز أبي

115
00:10:32,890 --> 00:10:33,870
دعني أوقظه

116
00:10:34,580 --> 00:10:36,320
الوضع أسوأ ممّا تعتقدين

117
00:10:37,090 --> 00:10:39,080
زهور لوتس الأحلام تتغذّى على وعيه

118
00:10:39,080 --> 00:10:42,050
ونبع الأصل يطهّر هذه المنطقة

119
00:10:42,720 --> 00:10:47,200
إذا لم نستطع إخراجه قبل انتهاء
التّطهير، سوف يُمسَح كذلك

120
00:10:47,200 --> 00:10:48,540
!إذاً لا يمكننا الانتظار فترة أطول

121
00:10:48,540 --> 00:10:49,340
!دعني أذهب

122
00:10:49,340 --> 00:10:50,870
!هذا خطيرٌ جدّاً

123
00:10:50,870 --> 00:10:53,060
لوتس الأحلام بارعة في استخدام
الأوهام لخداع النّفس

124
00:10:53,060 --> 00:10:55,270
!إذا فشلتِ، فلن تتمكّني من العودة أبداً

125
00:11:08,880 --> 00:11:10,910
أبي هو العائلة الوحيدة الّتي أملكها

126
00:11:12,950 --> 00:11:15,870
!سأنقذه ولو كلّفني ذلك حياتي

127
00:11:24,370 --> 00:11:26,020
!من فضلك يا لوكاس

128
00:11:26,650 --> 00:11:28,170
!أنت الوحيد القادر على مُساعدتي

129
00:11:43,540 --> 00:11:46,200
،سأطلق طبقةً إضافيّة من سحر الحماية عليكِ

130
00:11:46,200 --> 00:11:48,150
لكن لن يدوم هذا إلّا لفترة قصيرة جدّاً

131
00:11:48,980 --> 00:11:52,860
بعد أن تدخلي الحاجز، سوف أرشدكِ
لإيجاد نُواة وعيه

132
00:11:53,820 --> 00:11:57,130
تذكّري، يجب أن تعودي قبل أن ينتهي
!نبع الأصل من عمليّة تطهيره

133
00:11:57,130 --> 00:11:59,360
شكراً لك يا لوكاس

134
00:12:05,960 --> 00:12:08,800
...أبي... أتيتُ لإنقاذك

135
00:12:17,510 --> 00:12:19,350
اسمعي يا أتاناشيا

136
00:12:20,070 --> 00:12:24,570
إذا أردتِ إيقاظ أبيكِ، يجب عليكِ إيجاد
!الذّاكرة الأعمق داخل منطقة اللّاوعي لديه

137
00:12:25,350 --> 00:12:29,910
!هناك تتواجد نُواة وعيه، وأيضاً فُرصتنا الأخيرة

138
00:12:34,330 --> 00:12:35,350
أمّي؟

139
00:12:37,840 --> 00:12:41,660
أكثر ذاكرة غير منسيّة... هل يُعقل أن تكون هنا؟

140
00:13:18,990 --> 00:13:22,250
هل يُعقَل أن يكون هذا... حيث
!التقى بأمّي أوّل مرّة؟

141
00:13:29,690 --> 00:13:31,300
أتسأل عن اسمي؟

142
00:13:34,830 --> 00:13:36,150
أنا دايانا

143
00:13:41,460 --> 00:13:44,200
أبي! هل يمكنك سماع صوتي؟

144
00:13:49,920 --> 00:13:52,280
كلاود

145
00:13:53,050 --> 00:13:54,900
!انظر يا كلاود

146
00:13:55,280 --> 00:13:56,320
كلاود

147
00:14:01,710 --> 00:14:04,180
لدى أبي الكثير من الذّكريات عن أمّي

148
00:14:06,760 --> 00:14:09,230
...لماذا لم يذكرها أبداً

149
00:14:16,920 --> 00:14:18,350
!بالطّبع لا

150
00:14:18,350 --> 00:14:20,050
!لا أستطيع السّماح بولادة هذه الطّفلة

151
00:14:20,900 --> 00:14:22,840
...لكنّها طفلتنا

152
00:14:23,960 --> 00:14:27,470
!الطّفلة لا قيمة لها مُقارنة بكِ

153
00:14:28,220 --> 00:14:30,000
،حالما تُولد هذه الطّفلة

154
00:14:31,240 --> 00:14:33,760
ستفقدين كلّ المانا خاصّتكِ. أليس كذلك؟

155
00:14:33,760 --> 00:14:34,890
...جلالتك

156
00:14:35,740 --> 00:14:37,770
...لا أقبل فقدانكِ

157
00:14:38,810 --> 00:14:39,910
أنا آسفة

158
00:14:40,580 --> 00:14:41,950
لا أستطيع فعلها

159
00:14:42,900 --> 00:14:43,810
...أمّي

160
00:14:44,310 --> 00:14:45,800
ما الّذي تقوله؟

161
00:14:51,870 --> 00:14:52,970
...أتاناشيا

162
00:14:53,750 --> 00:14:56,260
هذا هو الاسم الّذي أمنحكِ إيّاه

163
00:14:56,260 --> 00:14:58,180
"يعني "أبديّ

164
00:14:59,810 --> 00:15:01,770
...رافقيه لأجلي

165
00:15:02,610 --> 00:15:04,390
يا ابنتي

166
00:15:07,570 --> 00:15:08,390
!أمّي

167
00:15:08,390 --> 00:15:12,380
!سموّكِ

168
00:15:15,230 --> 00:15:17,900
...لماذا... دايانا

169
00:15:20,120 --> 00:15:22,360
لماذا تركَتْني ورحلتْ؟

170
00:15:29,540 --> 00:15:30,420
!أتاناشيا

171
00:15:30,850 --> 00:15:33,290
!ينبغي أن تكوني عند نُواة وعي كلاود

172
00:15:33,290 --> 00:15:34,540
!أيقظيه

173
00:15:36,620 --> 00:15:37,880
احرق

174
00:15:37,880 --> 00:15:39,130
!احرق كلّ شيء

175
00:15:40,380 --> 00:15:41,430
!ماذا تفعل؟

176
00:15:41,430 --> 00:15:43,760
كلّ مُمتلكات الملكة الرّاحلة
يجب أن تُدمَّر

177
00:15:43,760 --> 00:15:46,600
إذاً ماذا عن الأميرة؟ ماذا ينوي
جلالته أن يفعل بها؟

178
00:15:46,600 --> 00:15:47,180
...جلالتك

179
00:15:47,180 --> 00:15:49,180
لا أريد رؤيتها ثانية أبداً

180
00:16:06,030 --> 00:16:08,270
...تركتِني، فلماذا إذاً

181
00:16:09,770 --> 00:16:15,180
فلماذا تُطاردينني في أحلامي دوماً؟

182
00:16:18,210 --> 00:16:19,840
...عالم من دونكِ

183
00:16:20,520 --> 00:16:22,500
...هو أشبه بكابوس

184
00:16:22,500 --> 00:16:23,890
أبي؟

185
00:16:24,540 --> 00:16:26,910
أفضّل فقدان كافّة مشاعري

186
00:16:28,900 --> 00:16:30,750
ولا أتذكّر شيئاً من هذا

187
00:16:37,150 --> 00:16:38,150
!أبي

188
00:16:39,110 --> 00:16:41,780
هل تريد أن تنساني أنا وأمّي؟

189
00:16:41,780 --> 00:16:44,570
!لا! استيقظ

190
00:16:51,010 --> 00:16:53,130
تلاشى العالم إلى أسود وأبيض

191
00:16:54,040 --> 00:16:55,750
سوداويّ جدّاً

192
00:16:56,440 --> 00:16:57,420
مُوحش جدّاً

193
00:17:00,660 --> 00:17:01,590
مُملّ جدّاً

194
00:17:02,600 --> 00:17:04,010
مُحبط جدّاً

195
00:17:06,260 --> 00:17:07,520
هذا مُناسب

196
00:17:08,650 --> 00:17:10,520
كان من المُفترض أن تكون حياتي هكذا

197
00:17:11,050 --> 00:17:12,080
!لا

198
00:17:14,970 --> 00:17:16,560
!ليس بالضّرورة أن يكون كذلك

199
00:17:17,700 --> 00:17:21,090
!استيقظ أرجوك! أبي