1
00:00:19,080 --> 00:00:23,370
في بلد سحريّ بعيد، عاشت
أميرةٌ مسكينة

2
00:00:25,750 --> 00:00:29,170
تُوفّيت أمُّ الأميرة بعد ولادتها بفترة قصيرة

3
00:00:29,630 --> 00:00:33,470
والدها، الّذي لا يُحبّها، كان يمقتها

4
00:00:33,920 --> 00:00:37,180
"قال، "لا أريد رؤيتها ثانية

5
00:00:39,760 --> 00:00:42,220
ترعرعت الأميرة من دون حُبّ الإمبراطور

6
00:00:42,390 --> 00:00:44,730
لفترة طويلة، عاشتْ وحيدة

7
00:00:46,850 --> 00:00:50,980
،ثمّ عندما بلغت التّاسعة من العمر
التقتْ بوالدها للمرّة الأولى

8
00:00:53,240 --> 00:00:57,780
قالت لنفسها، "قد يكون هذا
"الشّخص هو عائلتي الوحيدة

9
00:00:59,080 --> 00:01:02,750
من أجل كسب حُبّ أبيها، بذلتْ
قصارى جهدها

10
00:01:04,580 --> 00:01:11,170
لكن عندما بلغَتِ الرّابعة عشر، في حفلتها
الرّاقصة الأُولى، تحطّمت آمالها

11
00:01:11,840 --> 00:01:15,840
كانت الحقيقة هي أنّ الإمبراطور
لديه ابنة أُخرى

12
00:01:16,630 --> 00:01:20,260
مُتألّقة وحسناء، جانيت أشبه بملاك

13
00:01:20,760 --> 00:01:25,060
في غضون لحظات، أسرتْ
قلوب الجميع وحُبّهم

14
00:01:25,640 --> 00:01:28,600
بما في ذلك حُبّ والدها بالطّبع

15
00:01:29,520 --> 00:01:34,570
لكسب حبّ أبيها، لطّخت الأميرة
المسكينة يديها بسحر أسود

16
00:01:35,030 --> 00:01:40,030
في النّهاية، نفاها والدها وانتهت حياتها

17
00:01:43,290 --> 00:01:45,290
...لا أُبالي للرّواية

18
00:01:45,790 --> 00:01:52,540
،لكن... الأميرة الّتي لا يُحبّها أحد
...الّتي تضلّ في النّهاية

19
00:01:52,710 --> 00:01:55,920
!أنا متأكّدة بأنّها أنا

20
00:01:57,420 --> 00:02:00,930
،أعلم بأنّها شخصيّة ثانويّة فحسب
!لكن هذا مُحزن للغاية

21
00:02:03,140 --> 00:02:04,270
لا

22
00:02:04,560 --> 00:02:08,980
!لن أقبل أبداً، أبداً، أبداً بهذه الحياة لي

23
00:02:09,480 --> 00:02:12,060
!سوف أتحرّر منها

24
00:02:31,000 --> 00:02:33,670
الأميرة السّحريّة المُقدّرة مَن جعلني أميرة

25
00:03:43,950 --> 00:03:46,950
بابا

26
00:03:51,790 --> 00:03:53,620
تولّي المطبخ من فضلكِ

27
00:04:00,880 --> 00:04:05,300
بسبب حادثة اللّصّة تلك، زاد
عدد الأشخاص في المطبخ الآن

28
00:04:05,800 --> 00:04:09,350
يبدو أنّه سيكون من الصّعب
جمع الأموال للهرب

29
00:04:09,520 --> 00:04:12,350
لكن ليلي بأمان، لذا أعتقد
بأنّ الأمور بخير

30
00:04:13,190 --> 00:04:17,440
لن أدع شيئاً كهذا يجعلني أفقد
!الأمل من خطّتي لجمع الأموال

31
00:04:17,820 --> 00:04:20,030
!ذهب

32
00:04:20,990 --> 00:04:22,490
هل يُسعدكِ ذلك؟

33
00:04:24,200 --> 00:04:27,910
بدا أنّ ليلي تعتقد بأنّني أحبّ
،الأشياء اللّامعة

34
00:04:28,080 --> 00:04:30,080
لذا أعطَتْني الكثير من الدُّمى الذّهبيّة

35
00:04:30,620 --> 00:04:31,950
...و

36
00:04:32,120 --> 00:04:34,330
...يا جماعة

37
00:04:35,870 --> 00:04:36,920
...في الواقع

38
00:04:37,330 --> 00:04:39,920
تريد آتي أن تأكل بعض الشّوكولاتة

39
00:04:43,380 --> 00:04:45,050
!تلك المُجوهرات

40
00:04:46,510 --> 00:04:48,890
!شكراً للجميع

41
00:04:49,470 --> 00:04:50,850
!كم هي ظريفة

42
00:04:58,440 --> 00:05:01,070
كلّ هذا هو الكنز رقم ثمانية عشر

43
00:05:01,530 --> 00:05:05,280
وفقاً لأحلامي، سأُصادفه عندما
أبلغ التّاسعة من العمر

44
00:05:05,450 --> 00:05:10,280
لذا إذا استطعتُ مُغادرة هذا المكان
!قبل بلوغي التّاسعة، يمكنني تغيير قدري

45
00:05:10,450 --> 00:05:12,490
!هذه هي خطّتي

46
00:05:13,370 --> 00:05:16,040
وبالطّبع، سآخذ ليلي معي

47
00:05:16,210 --> 00:05:18,460
!سوف أعتني بها

48
00:05:18,630 --> 00:05:20,000
!سموّ الأميرة

49
00:05:21,590 --> 00:05:23,550
علِقَتْ بي شوكولاتة

50
00:05:30,220 --> 00:05:32,470
سيكون من السّيّئ أن ترى ليلي ذلك

51
00:05:52,620 --> 00:05:56,660
يقول النّاس لي بأنّني أشبه ماما كثيراً

52
00:05:56,830 --> 00:05:59,500
لكن من حيث العينين، فإنّهما
تُشبهان عينَي أبي

53
00:06:00,750 --> 00:06:03,960
وحدها العائلة الإمبراطوريّة مَن ترِث
هاتين العينين الجوهريّتين

54
00:06:05,510 --> 00:06:09,050
لكن لم أرِث أي قوى سحريّة

55
00:06:15,020 --> 00:06:19,140
أتساءل ما إن كان هذا
سبب كره أبي لي

56
00:06:22,150 --> 00:06:26,240
الجميع يقولون بأنّني الوحيدة الّتي
،ورثت العينين الجوهريّتين

57
00:06:26,990 --> 00:06:31,370
لكن الحقيقة هي أنّ هناك أميرة
أُخرى تُدعى جانيت

58
00:06:33,280 --> 00:06:35,280
!حمقاء! حمقاء! حمقاء! حمقاء

59
00:06:35,450 --> 00:06:37,410
!لا جدوى من التّفكير في الأمر

60
00:06:37,790 --> 00:06:40,290
،حالما أحصل على ما يكفي من مال
!سوف أهرب

61
00:06:41,330 --> 00:06:45,880
مؤخّراً، أصبحت الحِراسة الأمنيّة في القصر
أشدّ، لذا يجب أخبئ هذا جيّداً

62
00:06:53,470 --> 00:06:55,180
ما هذا المكان؟

63
00:06:56,060 --> 00:06:58,140
إنّه ليس القصر الياقوتيّ

64
00:07:03,730 --> 00:07:06,820
إنّه فارغٌ تماماً. لا يوجد أحدٌ هنا

65
00:07:07,990 --> 00:07:11,990
لا يبدو فاخراً. أتساءل ما إن كان مخزناً

66
00:07:12,950 --> 00:07:15,280
أنا جائعة

67
00:07:18,450 --> 00:07:21,620
للحرص على ألّا يدخل لصوص إلى
،القصر الياقوتيّ ثانية

68
00:07:21,790 --> 00:07:23,710
يجب أن نُنظّف بشكل كامل أوّلاً

69
00:07:24,630 --> 00:07:28,380
بأمر من جلالته، سيخضع القصر
الياقوتيّ لتفتيش شامل

70
00:07:28,800 --> 00:07:30,590
كلّ غرفة؟

71
00:07:30,760 --> 00:07:34,550
أجل، وبتركيز خاصّ على غرف الأميرة

72
00:07:36,220 --> 00:07:37,390
!ماذا قالت للتو؟

73
00:07:37,810 --> 00:07:40,890
!هذا سيّئ! كنوزي كلّها

74
00:07:45,560 --> 00:07:51,990
،ثلاثة، أربعة، خمسة، ستّة
!سبعة، ثمانية، تسعة، عشرة

75
00:07:53,740 --> 00:07:55,370
!جميعها هنا

76
00:07:59,330 --> 00:08:03,250
هذه لأجل مُستقبلي، لذا
يجب عليّ إخباؤها جيّداً

77
00:08:06,460 --> 00:08:08,380
سموّ الأميرة، حان وقت قيلولتكِ

78
00:08:08,550 --> 00:08:09,550
ماذا؟

79
00:08:10,670 --> 00:08:12,050
أنتِ نائمة بالفعل؟

80
00:08:14,800 --> 00:08:17,050
أحلام سعيدة، سموّكِ

81
00:08:28,360 --> 00:08:31,360
بالنّسبة للباقي... أعتقد بأنّني سوف
أنقلها رويداً رويداً

82
00:08:39,790 --> 00:08:41,580
!لم يرَني أحد

83
00:08:41,750 --> 00:08:43,410
!قد يكون هذا أسهل ممّا توقّعت

84
00:08:44,960 --> 00:08:47,540
اليوم، علينا فقط ترتيب ذلك
المكان، أليس كذلك؟

85
00:08:47,710 --> 00:08:50,670
أجل. الأشياء الّتي طلبناها
سوف تصل اليوم

86
00:08:55,800 --> 00:08:58,550
أنا متأكّدة بأنّني دفنتُها في مكانٍ ما هنا

87
00:08:59,470 --> 00:09:00,470
!ماذا؟

88
00:09:02,430 --> 00:09:04,020
!انتظر

89
00:09:07,730 --> 00:09:09,190
!وجدتُها

90
00:09:09,980 --> 00:09:13,240
انظر يا سيّد سنجاب! ما رأيك
بهذا بدلاً من ذلك؟

91
00:09:21,330 --> 00:09:24,120
قد لا يكون دفن هذه في الغابة آمناً أيضاً

92
00:09:24,290 --> 00:09:25,660
ماذا أفعل؟

93
00:09:26,250 --> 00:09:29,540
مكان لا يوجد فيه الكثير من النّاس
...حيث أستطيع إخباء هذه

94
00:09:31,420 --> 00:09:32,750
!ذلك المكان

95
00:09:38,260 --> 00:09:40,510
لا يوجد أحدٌ فعلاً هنا

96
00:09:43,020 --> 00:09:45,270
...هل يُعقَل أن يكو هذا المكان

97
00:09:45,850 --> 00:09:49,310
!مدفن كنزي المُقدَّر؟

98
00:10:00,160 --> 00:10:03,490
كلّ هذا ذهب، أليس كذلك؟

99
00:10:05,870 --> 00:10:07,750
أتساءل ما إن كان ذهباً خالصاً

100
00:10:18,840 --> 00:10:23,430
منذ متى كانت هذه الحشرة الصّغيرة في قصري؟

101
00:10:29,270 --> 00:10:31,520
نفس عينَي الجوهريّتين؟

102
00:10:32,690 --> 00:10:34,020
أبي؟

103
00:10:34,690 --> 00:10:35,690
لكن لماذا؟

104
00:10:36,530 --> 00:10:37,740
هذا الوجه

105
00:10:38,570 --> 00:10:40,030
رأيتُه من قبل

106
00:10:40,700 --> 00:10:43,530
ماذا؟ هذا أبكر بكثير ممّا حدث في أحلامي

107
00:10:44,450 --> 00:10:48,330
يُفترَض أن ألتقي بأبي بعد
أربع سنوات من الآن، أليس كذلك؟

108
00:10:48,870 --> 00:10:50,460
لماذا يحدث هذا الآن؟

109
00:10:51,920 --> 00:10:55,130
قبل قليل، قال "قصري"، أليس كذلك؟

110
00:10:55,710 --> 00:10:58,750
إذاً هذا يعني بأنّني دخلتُ عرين
ملك الشّياطين مباشرة؟

111
00:10:58,920 --> 00:11:00,180
كانت تلك المرأة، أليس كذلك؟

112
00:11:05,220 --> 00:11:06,430
...أنتما

113
00:11:07,310 --> 00:11:08,810
تُشبهان بعضكما كثيراً

114
00:11:12,150 --> 00:11:13,440
!جـ-جلالتك

115
00:11:18,610 --> 00:11:19,820
تذكّرتُ الآن

116
00:11:21,660 --> 00:11:24,320
الاسم الّذي منحَتْكِ إيّاه تلك المرأة

117
00:11:25,490 --> 00:11:27,040
أتاناشيا

118
00:11:40,970 --> 00:11:42,470
ماذا قلتِ؟

119
00:11:43,220 --> 00:11:45,300
اسم هذه الرّضيعة هو أتاناشيا؟

120
00:11:45,850 --> 00:11:49,600
أجل. زوجة الإمبراطور أعطت الاسم بنفسها

121
00:11:51,020 --> 00:11:52,100
كم هذا طريف

122
00:11:54,980 --> 00:11:56,690
لقد كبرتِ

123
00:11:58,070 --> 00:11:59,070
...هذا

124
00:12:01,570 --> 00:12:02,990
دائريّ للغاية

125
00:12:09,870 --> 00:12:11,200
دائريّ؟

126
00:12:11,370 --> 00:12:14,500
في أحلامي، أبي غير مهتمّ بي إطلاقاً

127
00:12:14,670 --> 00:12:16,750
!ما الّذي يجري هنا؟

128
00:12:21,880 --> 00:12:22,880
شاي

129
00:12:23,730 --> 00:12:24,800
أعدده

130
00:12:24,970 --> 00:12:25,970
حاضر، جلالتك

131
00:12:26,140 --> 00:12:29,220
ماذا؟ لا أريد أن أحتسي الشّاي
!مع شخص مثله

132
00:12:33,770 --> 00:12:34,810
أنتِ ثقيلة

133
00:12:42,570 --> 00:12:47,910
!هذا سيّئ! كنوزي! رقم سبعة وثمانية

134
00:12:51,160 --> 00:12:53,330
ما الّذي يجري هنا؟

135
00:12:57,330 --> 00:12:58,540
!بئساً

136
00:12:58,960 --> 00:13:03,130
هل ينتظرني أبي حتّى أعترف؟

137
00:13:04,300 --> 00:13:07,590
ما السّبب؟ هل لأنّني كنتُ
أحمل المجوهرات معي؟

138
00:13:08,050 --> 00:13:13,100
أم... لأنّني تركتُ آثار عضّة
على تمثاله المُفضّل؟

139
00:13:13,270 --> 00:13:16,430
هل هو غاضب وينوي القبض عليّ؟

140
00:13:16,600 --> 00:13:17,940
ألا تستطيعين التكلُّم؟

141
00:13:19,860 --> 00:13:21,230
!كم هذا مُملّ

142
00:13:23,650 --> 00:13:25,650
ماذا يقصد بذلك؟

143
00:13:26,450 --> 00:13:28,030
ألا تستطيعين التكلُّم إطلاقاً؟

144
00:13:28,700 --> 00:13:31,370
!تستطيع آتي التكلُّم

145
00:13:34,750 --> 00:13:36,580
إذاً أستطيع سماع صوتكِ أخيراً

146
00:13:37,620 --> 00:13:39,580
لماذا كنتِ صامتة حتّى الآن؟

147
00:13:42,050 --> 00:13:43,670
لا تتوتّري

148
00:13:43,960 --> 00:13:45,260
تناولي بعض الكعك من فضلكِ

149
00:13:48,140 --> 00:13:51,720
جلالتك، سمعتُ بأنّ الجميع
خجولون أمام الغُرباء

150
00:13:51,890 --> 00:13:54,350
في عمر الأميرة

151
00:13:55,390 --> 00:13:56,730
خجولة؟

152
00:13:57,140 --> 00:13:58,180
فيليكس

153
00:13:59,090 --> 00:14:00,110
غادر الغرفة

154
00:14:00,280 --> 00:14:01,350
ماذا؟

155
00:14:01,520 --> 00:14:02,610
!ماذا؟

156
00:14:02,950 --> 00:14:04,030
أب \ ابنة

157
00:14:04,200 --> 00:14:05,440
غريب \ أب \ ابنة

158
00:14:05,610 --> 00:14:07,730
عُلِم، جلالتك

159
00:14:07,900 --> 00:14:12,080
!ماذا؟! من فضلك لا تذهب يا سيّد

160
00:14:12,990 --> 00:14:16,290
سينتهي المطاف بوجودنا نحن
!الاثنان لوحدنا فقط

161
00:14:17,830 --> 00:14:20,540
هل آتي هو لقبكِ؟

162
00:14:23,960 --> 00:14:25,550
أتاناشيا

163
00:14:26,210 --> 00:14:27,800
أتاناشيا، أليس كذلك؟

164
00:14:28,760 --> 00:14:29,800
أنتِ

165
00:14:30,470 --> 00:14:31,890
هل تعرفين ما يعنيه؟

166
00:14:36,180 --> 00:14:37,390
...عدم الموت

167
00:14:38,270 --> 00:14:39,390
الخلود

168
00:14:40,480 --> 00:14:42,270
إنّه اسمٌ ملكيّ

169
00:14:43,650 --> 00:14:45,070
...في أوبيليا

170
00:14:45,530 --> 00:14:49,610
الوريث الشّرعيّ فقط هو من يُمنَح
اسم بمعنى كهذا

171
00:14:51,700 --> 00:14:54,200
حتّى أنا لم أستطع الحصول
على اسم كهذا لنفسي

172
00:14:54,530 --> 00:14:57,450
...أن تمنح طفلتها اسماً كهذا

173
00:14:58,040 --> 00:15:00,000
كانت امرأة جسورة حقّاً

174
00:15:00,170 --> 00:15:04,290
انتهى أمري. هل أغضبتُ الإمبراطور؟

175
00:15:05,000 --> 00:15:09,880
لم يكن أبي ابن الإمبراطورة، لذا لم يكن
لديه مكان في الخلافة الإمبراطوريّة

176
00:15:10,380 --> 00:15:13,430
هزمَ أخاه الأكبر القاسي واستولى على العرش

177
00:15:13,600 --> 00:15:17,100
لكن حتّى الآن، ما زال يُنتقَد لعدم
امتلاكه اسم إمبراطور

178
00:15:23,770 --> 00:15:26,690
إنّه لا يُحبّ اسمي

179
00:15:27,070 --> 00:15:29,320
لماذا لا تأكلين؟ كُلي

180
00:15:29,950 --> 00:15:31,530
حضّرتُها لأجلكِ

181
00:15:32,280 --> 00:15:33,650
ما الأمر؟

182
00:15:33,820 --> 00:15:35,530
ألا تُلائم ذوقكِ؟

183
00:15:37,080 --> 00:15:39,540
!تبدو هذه الكعكة شهيّة جدّاً

184
00:15:39,910 --> 00:15:43,670
!إن لم آكل، فقد يقتل الخادمات

185
00:15:44,170 --> 00:15:47,920
أريد رؤية ليلي! أريد أن أعود
!إلى القصر الياقوتيّ

186
00:15:48,090 --> 00:15:49,970
من علّمكِ آداب السّلوك؟

187
00:15:51,260 --> 00:15:53,510
كانت ليلي لطيفة بما يكفي لتعليمي

188
00:15:54,430 --> 00:15:56,100
ليليان يورك؟

189
00:15:58,010 --> 00:16:03,730
،قبل خمس سنوات، ظهرتْ أمامي
ابنة كونت تطلب الاعتناء بكِ

190
00:16:04,020 --> 00:16:06,940
ماذا؟ لا أعرف ذلك عن ماضي ليلي

191
00:16:07,520 --> 00:16:11,400
!ليلي! هذا مُؤثِّر جدّاً

192
00:16:12,610 --> 00:16:15,780
الوحيدون الّذين اعترضوا طريقي
...ولم يموتوا بسبب ذلك

193
00:16:18,240 --> 00:16:21,000
هم أمّكِ وتلك المرأة

194
00:16:21,710 --> 00:16:24,290
ماذا؟ ما معنى هذا؟

195
00:16:26,000 --> 00:16:27,750
...هل تعلمين أصلاً

196
00:16:28,250 --> 00:16:29,840
من أكون؟

197
00:16:30,670 --> 00:16:31,670
ماذا؟

198
00:16:32,840 --> 00:16:35,050
كيف ينبغي أن أجيب عن هذا؟

199
00:16:36,140 --> 00:16:39,760
هـ-هل ينبغي أن أناديه بـ"أبي"؟

200
00:16:43,440 --> 00:16:45,600
ماذا أفعل؟ ما الجواب الأمثل؟

201
00:16:45,900 --> 00:16:47,900
ما الجواب الصّحيح هنا؟

202
00:16:53,150 --> 00:16:54,740
...المعذرة

203
00:16:56,700 --> 00:16:58,120
أنت بابا، صحيح؟

204
00:17:04,910 --> 00:17:07,370
ما مُشكلتي؟

205
00:17:07,540 --> 00:17:11,960
!أُناديه "بابا" بالتّحديد! قُضي عليّ

206
00:17:12,130 --> 00:17:13,960
هل سيَنفيني فوراً؟

207
00:17:14,130 --> 00:17:18,680
"كان بوسعي أن أُناديه بـ"جلالة الإمبراطور
!كأيّ شخص عاديّ

208
00:17:20,680 --> 00:17:23,310
!يا فتيات، لنتفرّق ونبحث عن الأميرة

209
00:17:23,480 --> 00:17:24,640
!عُلِم

210
00:17:26,310 --> 00:17:27,650
!سموّك

211
00:17:30,730 --> 00:17:33,480
سموّك، أين كنتِ؟

212
00:17:33,650 --> 00:17:35,610
!كنتُ قلقة للغاية

213
00:17:37,410 --> 00:17:39,280
سموّ الأميرة

214
00:17:45,370 --> 00:17:47,700
هذا الرّجل هو حارس جلالته، أليس كذلك؟

215
00:17:47,870 --> 00:17:50,170
لماذا أنت مع الأميرة؟

216
00:17:50,590 --> 00:17:51,710
...سموّ الأميرة

217
00:17:52,630 --> 00:17:55,050
يقول جلالته بأنّه سيستدعيكِ ثانية

218
00:17:55,220 --> 00:17:56,380
ماذا؟

219
00:17:58,410 --> 00:17:59,420
جلالته؟

220
00:17:59,590 --> 00:18:03,010
أخيراً جاء اليوم الّذي أبدى جلالته
!فيه اهتماماً بالأميرة

221
00:18:03,680 --> 00:18:06,350
يا إلهي! سموّكِ، هل أنتِ بخير؟

222
00:18:06,520 --> 00:18:09,770
أكره هذا! هل عليّ حقّاً الذّهاب
لرؤيته من جديد؟

223
00:18:10,270 --> 00:18:14,860
!لماذا قدري قاسٍ جدّاً؟

224
00:19:46,910 --> 00:19:50,160
.كان لئيماً جدّاً في السّابق
ما الّذي يحاول فعله؟

225
00:19:50,330 --> 00:19:53,330
من الآن فصاعداً، سأُشرف على الأميرة

226
00:19:53,960 --> 00:19:56,290
...ستتلقّى مُعاملة

227
00:19:56,460 --> 00:19:57,460
مُلائمة لأميرة

228
00:19:57,880 --> 00:20:01,590
لن أدعه يغريني بالكعكة

229
00:20:03,640 --> 00:20:06,300
ماذا؟ زهور في البُحيرة؟

230
00:20:06,640 --> 00:20:08,720
هيّا بنا. سأدلّكِ على الطّريق

231
00:20:13,020 --> 00:20:17,820
إنّه بارد جدّاً، لكن هذه البقعة دافئة

232
00:20:18,610 --> 00:20:20,650
هل هذا حلم أيضاً؟

233
00:20:20,820 --> 00:20:23,660
الأميرة السّحريّة المُقدّرة مَن جعلني أميرة