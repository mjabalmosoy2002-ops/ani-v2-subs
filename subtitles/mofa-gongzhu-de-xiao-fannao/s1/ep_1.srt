1
00:00:34,130 --> 00:00:36,800
الأميرة السّحريّة المُقدّرة مَن جعلني أميرة

2
00:01:47,080 --> 00:01:50,080
بدأت عجلات القدر تتحرّك

3
00:01:55,630 --> 00:01:57,220
أتاناشيا

4
00:01:57,720 --> 00:01:59,550
هذا هو اسمكِ

5
00:02:00,320 --> 00:02:02,050
"يعني "الخلود

6
00:02:03,970 --> 00:02:05,520
،حتّى لو كنتِ لا تملكين قوى سحريّة

7
00:02:06,180 --> 00:02:08,600
ابحثي عن سعادة يوميّة لنفسكِ

8
00:02:17,900 --> 00:02:19,780
اعتني بجلالته لأجلي، اتّفقنا؟

9
00:02:21,410 --> 00:02:22,990
يا ابنتي العزيزة

10
00:02:26,620 --> 00:02:28,040
!أنباء من القصر الياقوتيّ

11
00:02:28,210 --> 00:02:29,330
!دايانا-ساما قد تُوفّيت

12
00:02:30,120 --> 00:02:32,770
أمرَ جلالته بأن نجمع كافّة
!مُمتلكات زوجة الإمبراطور

13
00:02:32,940 --> 00:02:33,960
احرقوها

14
00:02:34,130 --> 00:02:35,250
!لا تتركوا أثراً

15
00:02:35,420 --> 00:02:36,550
احرقوها كلّها

16
00:02:38,760 --> 00:02:40,670
ماذا تفعلون؟

17
00:02:40,840 --> 00:02:42,800
يجب التّخلُّص من كافّة أغراض
الزّوجة الرّاحلة

18
00:02:42,970 --> 00:02:45,190
والأميرة؟ ماذا سيحلّ بها؟

19
00:02:45,360 --> 00:02:46,430
...جلالتك

20
00:02:46,600 --> 00:02:48,560
لا تذكروها أمامي ثانية

21
00:02:48,730 --> 00:02:52,730
سمعتُ بأنّ جلالته لم يحبّ زوجته
يوماً. أعتقد كان ذلك صحيحاً

22
00:02:52,900 --> 00:02:56,560
...رغم ذلك، أن يعامل الأميرة بهذا البرود

23
00:02:56,730 --> 00:02:58,770
هل حان الوقت الآن للقلق على الأميرة؟

24
00:02:58,940 --> 00:03:01,450
لا نعلم ما قد يحلّ بنا

25
00:03:03,320 --> 00:03:05,020
هل بكت الأميرة؟

26
00:03:05,190 --> 00:03:06,280
لا

27
00:03:06,450 --> 00:03:09,790
الأمر لا يستحقّ الجهد. لا حاجة
لتكريس أنفسنا للاعتناء بها

28
00:03:09,960 --> 00:03:11,040
هذا صحيح

29
00:03:11,210 --> 00:03:14,710
،حتّى جلالته لا يلقى بالاً لها
لذا يمكننا تركها وشأنها

30
00:03:14,880 --> 00:03:15,880
هذا صحيح

31
00:03:28,220 --> 00:03:29,220
أتاناشيا

32
00:04:49,560 --> 00:04:50,560
راقبي بحرص

33
00:04:52,350 --> 00:04:54,350
هذا هو مُستقبلكِ

34
00:04:58,860 --> 00:05:01,190
أتاناشيا دي آلغير أوبيليا

35
00:05:01,360 --> 00:05:04,440
،أنتِ أميرة إمبراطوريّة أوبيليا

36
00:05:04,610 --> 00:05:10,030
ومع ذلك انتهكتِ القرار واستخدمتِ السّحر
الأسود للتّخطيط لاغتيال الإمبراطور

37
00:05:13,620 --> 00:05:14,790
!أنتم مُخطئون

38
00:05:14,960 --> 00:05:16,040
!أبي

39
00:05:16,210 --> 00:05:18,080
...أبي، كلّ ما أردتُه

40
00:05:18,420 --> 00:05:20,960
هو حُبّك! هذا كلّ شيء

41
00:05:24,130 --> 00:05:27,970
لماذا لا... لماذا لا تنظر إليّ؟

42
00:05:28,140 --> 00:05:29,850
لستِ ابنتي

43
00:05:30,250 --> 00:05:31,680
...كلّ ما رأيتُه

44
00:05:32,010 --> 00:05:33,930
هو القذارة والانحطاط

45
00:05:36,520 --> 00:05:40,190
انفوا المُجرمة. احبسوها في برج للأبد

46
00:05:43,650 --> 00:05:45,980
...إذا لم يُحبّني أبي

47
00:05:46,150 --> 00:05:47,200
...فأنا قد

48
00:05:48,910 --> 00:05:50,620
!ذلك الحلم من جديد

49
00:05:51,330 --> 00:05:54,330
لا يمكن أن يكون هذا مُستقبلي، أليس كذلك؟

50
00:05:57,410 --> 00:05:59,710
سموّ الأميرة! ما الأمر؟

51
00:06:00,790 --> 00:06:01,870
هل تريدين حليباً؟

52
00:06:02,040 --> 00:06:04,960
هل تتألّمين؟ اهدئي، اهدئي

53
00:06:05,630 --> 00:06:07,130
أنتِ فتاة مُهذّبة

54
00:06:07,510 --> 00:06:11,050
ليليان هي الوحيدة الّتي تُواسيني

55
00:06:11,220 --> 00:06:15,180
إنّها ابنة كونت، لكن كانت صديقة أمّي

56
00:06:15,350 --> 00:06:20,640
تخلّتْ عن حياتها في كنف عائلة نبيلة
وأتت إلى القصر للاعتناء بي

57
00:06:20,810 --> 00:06:25,650
لو لم تأتِ ليليان، لتركَتْني تلك الخادمات
اللّئيمات أموت من الجوع

58
00:06:25,820 --> 00:06:27,820
!أحبّكِ يا ليليان

59
00:06:28,490 --> 00:06:31,450
.دائماً ما تبكين في مُنتصف اللّيل
هل رأيتِ أحلامَ مُخيفة؟

60
00:06:31,620 --> 00:06:36,700
أجل! وليست مُخيفة فحسب، بل هي
!أحلام قد تتحقّق

61
00:06:36,870 --> 00:06:42,130
أنا مُجرّد رضيعة، ومع ذلك أعرف
مُستقبلي؟ من سيُصدّقني؟

62
00:06:43,130 --> 00:06:46,210
اهدئي، اهدئي. هل هي حفّاضتكِ هذه المرّة؟

63
00:06:46,380 --> 00:06:48,590
!لم أتبوّل

64
00:06:50,840 --> 00:06:55,220
كلّ ما أعرفه الآن هو أنّ هذا
،عالمٌ من السّحر

65
00:06:55,390 --> 00:06:58,260
وكلّ نبيل يستطيع استخدام السّحر

66
00:06:58,430 --> 00:06:59,430
،طبقاً للأسطورة

67
00:06:59,600 --> 00:07:04,060
،هناك برج يُعَدّ مصدر كلّ السّحر
حيث يقطن ساحر عظيم

68
00:07:04,230 --> 00:07:08,230
يُقال بأنّه من السّهل بالنّسبة للسّاحر
...في البرج أن يمحو الإمبراطوريّة، لكن

69
00:07:08,400 --> 00:07:09,860
!برج! مُذهل

70
00:07:10,030 --> 00:07:13,700
هل تعرفين من لديه قوى سحريّة
مُذهلة أكثر من ذلك؟

71
00:07:15,830 --> 00:07:17,200
...إنّه

72
00:07:17,370 --> 00:07:18,620
!هذا الشّخص

73
00:07:19,410 --> 00:07:21,200
سموّ الأميرة، أنتِ ذكيّة جدّاً

74
00:07:21,370 --> 00:07:23,290
!عرفتِ جلالته بسهولة

75
00:07:23,460 --> 00:07:24,960
كيف لي أن أنساه؟

76
00:07:25,130 --> 00:07:28,090
!إنّه شخص فظيع نفاني في أحلامي

77
00:07:28,260 --> 00:07:32,550
!ماذا؟ ما هذا؟ "حكم مُتألّق"؟ هذا شنيع

78
00:07:32,720 --> 00:07:35,130
إنّه إمبراطور فظيع

79
00:07:35,300 --> 00:07:38,890
!إنّه طاغية

80
00:07:43,690 --> 00:07:46,980
!أنا غاضبة للغاية! هذا مُثير للغضب

81
00:07:47,440 --> 00:07:49,020
!لا أستطيع النّوم إطلاقاً

82
00:07:49,190 --> 00:07:52,530
...فكرة نفيي عندما أكبر هي

83
00:07:54,660 --> 00:07:57,740
هذا فظيع. لماذا أنا؟

84
00:07:59,540 --> 00:08:01,370
...لا أريد ذلك

85
00:08:02,080 --> 00:08:06,750
!أرفُض قطعاً قبول مُستقبل كهذا

86
00:08:14,340 --> 00:08:18,050
لم أتوقّع أبداً أن يكون القصر
الياقوتيّ بهذه الحيويّة

87
00:08:18,220 --> 00:08:20,680
ولدينا وافدون جدُد مثلك الآن أيضاً

88
00:08:20,850 --> 00:08:23,980
سمعتُ بأنّ الأجواء في القصر
الياقوتيّ عائليّة دوماً، صحيح؟

89
00:08:24,440 --> 00:08:26,480
وأنتِ هنا بسبب الأميرة أيضاً؟

90
00:08:26,650 --> 00:08:27,810
أجل

91
00:08:27,980 --> 00:08:31,650
بحسب الإشاعات، الأميرة ظريفة، لذا
أردتُ أن أتحقّق بنفسي

92
00:08:33,650 --> 00:08:34,650
ماذا؟

93
00:08:35,740 --> 00:08:37,320
ما الأمر؟

94
00:08:37,490 --> 00:08:39,110
ستفهمين حالما تلتقين بها

95
00:08:39,280 --> 00:08:40,740
هل هي ظريفة إلى هذا الحدّ؟

96
00:08:40,910 --> 00:08:43,740
بئساً. كم هذا سخيف

97
00:08:43,910 --> 00:08:46,120
أفضّل المال على الأميرة

98
00:08:48,460 --> 00:08:50,540
إنّها تتفتّح بصورة جميلة في هذا العام

99
00:08:50,710 --> 00:08:52,000
أجل، إنّها جميلة جدّاً

100
00:08:52,170 --> 00:08:54,050
إنّها أفضل من زهور العام الماضي

101
00:08:55,380 --> 00:08:57,410
تلك الزّهور الورديّة تفي
بالغرض، أليس كذلك؟

102
00:08:59,580 --> 00:09:00,640
!ما أجملها

103
00:09:00,810 --> 00:09:01,810
!بالفعل

104
00:09:03,520 --> 00:09:05,930
إلى أين أنتم ذاهبون جميعاً؟

105
00:09:06,100 --> 00:09:07,690
!صباح الخير

106
00:09:08,190 --> 00:09:12,030
،تتفتّح الزّهور بصورة جميلة
لذا ارتأينا أن نُزيّن بها

107
00:09:13,030 --> 00:09:14,700
!ستُساعدكم آتي أيضاً

108
00:09:28,080 --> 00:09:29,870
سموّ الأميرة! شكراً جزيلاً لكِ

109
00:09:30,040 --> 00:09:31,210
كلّ شيء جاهز الآن

110
00:09:31,380 --> 00:09:32,420
نحن جاهزون

111
00:09:32,590 --> 00:09:34,670
حسناً. تراجعنَ جميعاً

112
00:09:50,360 --> 00:09:52,570
!ما أجملها

113
00:09:52,770 --> 00:09:55,690
هذه هي أميرتنا. كانت فكرة مُبهرة

114
00:09:59,280 --> 00:10:01,490
يمكن وضع الباقي في غرفة أُخرى

115
00:10:01,660 --> 00:10:04,620
.لحظة فقط يا سموّ الأميرة
ستتّسخ ملابسكِ

116
00:10:12,170 --> 00:10:13,590
انتهيت

117
00:10:17,470 --> 00:10:19,220
!ستعود آتي في الحال

118
00:10:20,010 --> 00:10:21,010
!حسناً

119
00:10:21,180 --> 00:10:23,350
!ظرافتها لا حدود لها

120
00:10:35,980 --> 00:10:38,110
بئساً. هذا غريب

121
00:10:38,280 --> 00:10:42,320
كان الإمبراطور قد خصّصَ القصر
الياقوتيّ لزوجته حصراً

122
00:10:42,490 --> 00:10:46,370
من المُفترَض أن يكون قد جمع كنوزاً
ثمينة من كلّ أنحاء العالم فيه

123
00:10:47,040 --> 00:10:49,160
لكن لا شيء مُميّز هنا

124
00:10:49,670 --> 00:10:53,290
يا آنسة، ماذا تفعلين هنا؟-
...المعذرة-

125
00:10:53,460 --> 00:10:55,710
!أنا جديدة، لذا تهت

126
00:10:56,880 --> 00:10:57,880
طفلة؟

127
00:10:59,470 --> 00:11:02,380
لا بُدّ أنّها ابنة البستانيّ أو ما شابه

128
00:11:02,550 --> 00:11:05,550
تهتِ؟ إلى أين تريدين الذّهاب؟

129
00:11:05,720 --> 00:11:07,520
!سأدلّكِ على الطّريق

130
00:11:10,440 --> 00:11:14,260
في الواقع، أريد الذّهاب إلى مكان
!مليء بالذّهب اللّامع

131
00:11:15,990 --> 00:11:21,880
!ذهب لامع

132
00:11:17,180 --> 00:11:18,230
ليس من هذا النّوع

133
00:11:19,570 --> 00:11:20,620
ولا هذا النّوع أيضاً

134
00:11:22,050 --> 00:11:24,490
!أخبرتُك! ليس هذا النّوع
!كلّ هذا خاطئ

135
00:11:24,660 --> 00:11:26,370
!ليس هذا هو النّوع الّذي أُريده

136
00:11:26,540 --> 00:11:31,750
الذّهب اللّامع" الّذي أريده هو"
!أشياء ثمينة برّاقة! هل تفهمين؟

137
00:11:31,920 --> 00:11:33,290
!عجيب أمركِ

138
00:11:33,460 --> 00:11:35,630
لا جدوى. لن أستفيد من إخباركِ بهذا

139
00:11:36,210 --> 00:11:39,050
إن أتيتِ للسّرقة، فكان يجدر بكِ
أن تذكري ذلك منذ البداية

140
00:11:41,010 --> 00:11:44,010
...هذا غير صحيح إطلاقاً! أنا فقط

141
00:11:44,180 --> 00:11:47,840
تُوضَع الأشياء الثّمينة في أماكن
لا يستطيع النّاس رؤيتها

142
00:11:48,010 --> 00:11:51,060
،بما أنّكِ لم تخبريني من الأساس
فقد مشينا من مكانٍ لآخر عبثاً

143
00:11:51,230 --> 00:11:52,310
تعالي

144
00:11:53,810 --> 00:11:57,020
من هذه الطّفلة؟ هل يُعقَل
أنّها لصّة مثلي؟

145
00:11:57,610 --> 00:11:59,690
انظري. ذاك هو المطبخ

146
00:12:00,780 --> 00:12:03,610
لكنّه ليس غرفة كنز. هل تسخرين منّي؟

147
00:12:03,780 --> 00:12:05,240
مُحال أن يتركوا أشياء ثمينة في مطبخ

148
00:12:05,410 --> 00:12:09,580
يا آنسة، كان القصر الياقوتيّ
مهجوراً لسنوات

149
00:12:09,750 --> 00:12:13,580
،حتّى لو كانت توجد أشياء قيّمة هنا
فقد تمّ إخراجها منذ زمن بعيد

150
00:12:13,960 --> 00:12:15,160
لكن ماذا عن الإمبراطور؟

151
00:12:15,330 --> 00:12:18,880
جلالته مشغول جدّاً لدرجة أنّه
لا يهتمّ لأمرنا

152
00:12:20,170 --> 00:12:21,420
!هناك

153
00:12:24,050 --> 00:12:25,300
!انظري إلى الصّحن

154
00:12:26,010 --> 00:12:28,260
!إنّه مُزخرف بأحجار كريمة

155
00:12:29,430 --> 00:12:31,730
إنّها أحجار كريمة أصليّة وحقيقيّة

156
00:12:32,680 --> 00:12:35,520
.لكن يدخل أُناسٌ إلى المطبخ دوماً
كيف أدخل؟

157
00:12:35,690 --> 00:12:36,810
!انتظري هنا لحظة

158
00:12:36,980 --> 00:12:39,270
!ماذا؟ لا تفعلي

159
00:12:39,440 --> 00:12:40,730
!يا آنسة

160
00:12:44,400 --> 00:12:45,660
ما الأمر؟

161
00:12:46,620 --> 00:12:49,830
أختي الكبرى هانّا، تريد آتي
أن تأكل شوكولاتة

162
00:12:52,910 --> 00:12:54,420
يمكنكِ أن تأكلي بالطّبع

163
00:12:54,620 --> 00:12:55,700
هذا لا يُصدَّق

164
00:12:55,870 --> 00:12:58,000
!كان الأمر بتلك السّهولة؟ مُذهل

165
00:12:58,500 --> 00:12:59,500
لحظة

166
00:13:01,250 --> 00:13:02,460
!سيس

167
00:13:04,010 --> 00:13:06,550
هانّا، لا يجوز أن تعطيها
أشياء بلا إذن

168
00:13:07,220 --> 00:13:09,470
واحدة فقط

169
00:13:09,640 --> 00:13:11,770
وماذا لو فكّر الجميع بأن يفعلوا مثلكِ؟

170
00:13:14,350 --> 00:13:16,560
...أختي الكبرى سيس

171
00:13:17,850 --> 00:13:19,850
لا. حتّى لو نظرتِ إليّ بهذه التّعابير

172
00:13:20,020 --> 00:13:21,780
ألا أستطيع حقّاً؟

173
00:13:25,280 --> 00:13:27,400
!سيس! هذا ليس عدلاً

174
00:13:27,570 --> 00:13:29,280
!سنكتم هذا السّرّ عن ليليان-ساما

175
00:13:29,450 --> 00:13:30,950
!ستتسوّس أسنانكِ

176
00:13:31,280 --> 00:13:32,660
!شكراً لكِ يا سيس

177
00:13:34,660 --> 00:13:37,700
بالمناسبة! كانت ليلي
!تبحث عنكما للتو

178
00:13:37,870 --> 00:13:39,330
ماذا؟ الآن؟

179
00:13:40,000 --> 00:13:42,800
...وفي المطبخ

180
00:13:43,260 --> 00:13:46,250
لا أستطيع السّمع. هل فعلَتْها؟

181
00:13:46,420 --> 00:13:48,640
!من فضلكما أخبرا ليلي بما قلتُه

182
00:13:51,510 --> 00:13:54,180
تلك الطّفلة ماهرة حقّاً

183
00:14:05,150 --> 00:14:08,200
!ذهب مُتألّق! يا له من صيد وفير

184
00:14:09,450 --> 00:14:12,450
مُحال أن تحاول هذه الطّفلة
أن تسرق منّي، أليس كذلك؟

185
00:14:14,370 --> 00:14:16,120
إنّها مُجرّد طفلة في نهاية المطاف

186
00:14:17,460 --> 00:14:20,000
!كلّه لي

187
00:14:27,090 --> 00:14:30,170
يا فتاة البُستانيّ، شكراً على
إرشادي إلى هذا المكان

188
00:14:30,340 --> 00:14:34,350
.يمكنكِ الحصول على كلّ الطّعام
سآخذ كلّ شيء غير صالح للأكل

189
00:14:39,230 --> 00:14:41,980
ماذا تعتقدين أنّكِ تفعلين؟

190
00:14:42,400 --> 00:14:48,190
أنا آسفة حقّاً، لكن كلّ شيء
هنا هو مُلكي

191
00:14:49,860 --> 00:14:53,280
من الأفضل ألّا تتذاكي يا آنسة

192
00:14:58,580 --> 00:15:01,000
!ماذا تفعلين؟ توقّفي

193
00:15:01,170 --> 00:15:03,750
!ايّتها الطّفلة الشّقيّة
!أعطيني المجوهرات

194
00:15:13,850 --> 00:15:15,220
انتهت هذه اللّعبة

195
00:15:15,720 --> 00:15:16,720
ماذا؟

196
00:15:27,690 --> 00:15:28,770
جرذان؟

197
00:15:28,940 --> 00:15:30,980
قالت سموّها بأنّ هناك
جرذان في المطبخ؟

198
00:15:31,150 --> 00:15:32,570
جرذان؟ أين؟

199
00:15:32,740 --> 00:15:34,740
هل أنتِ بخير، سموّكِ؟

200
00:15:37,080 --> 00:15:38,580
ما كلّ هذا؟

201
00:15:39,080 --> 00:15:40,790
!تمّ إيقاع الجرذ في الفخّ

202
00:15:41,330 --> 00:15:42,500
!سموّ الأميرة

203
00:15:43,420 --> 00:15:46,210
كيف تجرئين على مُهاجمة
!سموّها أيّتها الشّرّيرة؟

204
00:15:48,510 --> 00:15:52,300
،وفقاً للفُرسان، لم تكذب بشأن هويّتها فقط

205
00:15:52,470 --> 00:15:54,630
كان بحوزتها سلاح أيضاً

206
00:15:54,800 --> 00:15:56,140
يسرّني أنّكِ على ما يُرام

207
00:15:56,310 --> 00:15:57,340
بالفعل

208
00:15:57,510 --> 00:15:59,890
لا مُشكلة. كنتُ جاهزة

209
00:16:02,390 --> 00:16:04,150
هل قلتِ شيئاً؟

210
00:16:04,520 --> 00:16:06,020
!لا شيء

211
00:16:06,620 --> 00:16:07,690
!بالمناسبة

212
00:16:07,860 --> 00:16:09,780
!ليلي، هذه الزّهرة لكِ

213
00:16:16,780 --> 00:16:19,660
حسناً، سموّكِ. حان وقت النّوم

214
00:16:19,830 --> 00:16:21,450
يجدر بكِ أن تذهبي إلى سريركِ

215
00:16:25,080 --> 00:16:27,250
ليلي، يسرّني أنّكِ بأمان

216
00:16:27,420 --> 00:16:29,380
يعزو كلّ الفضل إلى الحلم
التّنبّؤيّ الّذي رأيتُه

217
00:16:30,010 --> 00:16:31,250
...لو لم

218
00:16:31,420 --> 00:16:33,450
من هناك؟ ماذا تفعلين؟

219
00:16:33,620 --> 00:16:34,630
!الفُرسان

220
00:16:34,800 --> 00:16:36,340
ليليان-ساما

221
00:16:36,510 --> 00:16:38,140
لا تصرخي من فضلكِ

222
00:16:38,560 --> 00:16:39,810
ماذا تفعلين؟

223
00:16:44,350 --> 00:16:45,520
...أنتِ

224
00:16:49,480 --> 00:16:50,810
تصبحين على خير، سموّكِ

225
00:16:50,980 --> 00:16:52,610
تصبحين على خير يا ليلي

226
00:16:55,360 --> 00:16:57,150
كان ذلك ناجحاً

227
00:16:57,320 --> 00:17:01,370
هذا يعني بأنّني قد أتمكّن من تغيير
المُستقبل الّذي أراه في أحلامي

228
00:17:03,540 --> 00:17:07,290
اسمي أتاناشيا، الأميرة السّحريّة
الّتي لا تستطيع استخدام السّحر

229
00:17:09,340 --> 00:17:15,470
لديّ سرّ. وهو أنّني أستطيع
رؤية مُستقبلي الخاصّ

230
00:17:16,260 --> 00:17:18,800
هذا هو أبي

231
00:17:20,180 --> 00:17:22,550
!أرجوك لا تتخلّ عنّي! أبي

232
00:17:22,720 --> 00:17:25,390
يمكنكِ أن تتوبي عن جرائمكِ في البرج

233
00:17:26,640 --> 00:17:31,150
أعتقد بأنّ هذا الحلم الفظيع
هو قدري غالباً

234
00:17:34,320 --> 00:17:38,450
!لكن لا أنوي تقبّله ببساطة فحسب

235
00:17:44,910 --> 00:17:45,910
ادخل

236
00:17:47,000 --> 00:17:49,580
جلالتك، هذه آخر المُراسلات لهذا اليوم

237
00:17:49,750 --> 00:17:50,750
حسناً

238
00:17:55,130 --> 00:17:56,130
...المعذرة

239
00:17:56,880 --> 00:17:58,050
ما الأمر؟

240
00:18:00,220 --> 00:18:01,760
إن لم يكن هناك شيء، فغادر

241
00:18:03,470 --> 00:18:06,850
وفقاً لتقارير الفُرسان، دخل
لصٌّ إلى القصر الياقوتيّ

242
00:18:07,020 --> 00:18:08,930
،تمّ اعتقال الجاني بالفعل

243
00:18:09,100 --> 00:18:11,980
لكن يبدو أنّ الأميرة عالجت
!الأمور بنفسها

244
00:18:12,150 --> 00:18:13,820
هذا مُدهش! أليس... كذلك؟

245
00:18:15,900 --> 00:18:17,650
...تمّ الاهتمام بالأمر بالفعل

246
00:18:18,070 --> 00:18:20,370
لذا لا حاجة للإبلاغ عن كلّ تفصيل

247
00:18:33,880 --> 00:18:35,000
من هذا؟

248
00:18:35,170 --> 00:18:38,050
من غيّر قدرَ إمبراطوريّة أوبيليا؟

249
00:18:39,180 --> 00:18:42,720
في هذا الاتّجاه يقع... القصر؟

250
00:20:17,820 --> 00:20:19,320
!سأخرج من هنا خلسة

251
00:20:22,950 --> 00:20:24,400
!لم يرَني أحد

252
00:20:24,570 --> 00:20:26,820
!قد يكون هذا أبسط ممّا توقّعت

253
00:20:28,870 --> 00:20:30,330
ما هذا المكان؟

254
00:20:31,200 --> 00:20:33,210
هذا ليس القصر الياقوتيّ

255
00:20:35,790 --> 00:20:39,840
منذ متى تواجدتْ هذه الحشرة
الصّغيرة في قصري؟

256
00:20:40,300 --> 00:20:43,680
إذاً هذا يعني بأنّني دخلتُ
عرين ملك الشّياطين مباشرة؟

257
00:20:44,590 --> 00:20:46,220
ما مُشكلتي؟

258
00:20:46,390 --> 00:20:50,970
!أُناديه "بابا" بالتّحديد
!قُضي عليّ