1
00:00:17,740 --> 00:00:18,750
أهذا أنت يا رانمارو؟

2
00:00:19,910 --> 00:00:24,120
.هونّوجي محاصرة بجنود العدوّ

3
00:00:24,120 --> 00:00:25,050
ماذا؟

4
00:00:25,700 --> 00:00:27,050
أقلت العدوّ؟

5
00:00:31,810 --> 00:00:33,660
...شعار زهرة الجرس

6
00:00:33,660 --> 00:00:35,040
!ميتسوهيدي

7
00:00:35,040 --> 00:00:38,160
لكن لماذا تمرّد ميتسوهيدي؟

8
00:00:38,160 --> 00:00:39,690
.هذا ليس منطقيًّا

9
00:00:41,120 --> 00:00:42,810
.لا يهمّ

10
00:00:43,150 --> 00:00:45,050
!أوران، احمل رمحك

11
00:00:45,050 --> 00:00:45,810
.حاضر

12
00:01:06,680 --> 00:01:11,120
رغم أنّ ذلك كان من أجل
التّخلّي عن مبادئ قديمة

13
00:01:11,120 --> 00:01:15,850
ووضع حدّ للفوضى، إلاّ أنّها كانت
.حياة ملأتها الأحداث الشّنيعة

14
00:01:18,840 --> 00:01:22,050
.ربّما سأصبح كلبًا وضيعًا في حياتي التّالية

15
00:01:23,760 --> 00:01:28,110
.حتّى ذلك قد يكون ممتعًا

16
00:01:36,330 --> 00:01:38,290
...أن أصبح كلبًا

17
00:01:38,940 --> 00:01:41,120
.سيكون ذلك أيضًا ممتعًا

18
00:01:46,620 --> 00:01:47,870
نموسينا

19
00:01:50,900 --> 00:01:52,750
!أهذا معقول؟

20
00:01:52,750 --> 00:01:55,520
!عدت للحياة ثانية ككلب بالفعل

21
00:01:55,520 --> 00:01:59,750
ما كان عليّ قول أنّ ذلك سيكون
.ممتعًا، فقط لأبدو رائعًا

22
00:02:00,180 --> 00:02:02,820
".أريد أن أولد كنفسي في الحياة التّالية"

23
00:02:02,820 --> 00:02:06,100
".لا أهتمّ أبدًا لأكون أيّ شيء آخر غير نفسي"

24
00:02:06,380 --> 00:02:11,430
كان عليّ قول ذلك، مهما بدا
.ذلك رديئًا ومبتذلاً وخسيسًا

25
00:02:11,430 --> 00:02:14,060
!وأنا كلب شيبا إينو فوق ذلك؟

26
00:02:14,060 --> 00:02:15,200
!لماذا كلب شيبا إينو بالضّبط؟

27
00:02:15,200 --> 00:02:17,030
!أنا ظريف للغاية

28
00:02:18,070 --> 00:02:19,950
!أنا نوبوناغا

29
00:02:19,950 --> 00:02:22,400
!حاكم الممالك المتحاربة أودا نوبوناغا

30
00:02:22,720 --> 00:02:27,590
،كان بإمكاني أن اصبح كلب دوبرمان
!أو كلب الرّاعي على الأقلّ

31
00:02:27,590 --> 00:02:28,950
...والأسوأ من ذلك

32
00:02:28,950 --> 00:02:30,840
!أيّ نوع من الأسماء هو سينامون؟

33
00:02:28,960 --> 00:02:32,960
نموسينا

34
00:02:30,840 --> 00:02:32,970
!إنّه يعني قرفة وهو ظريف جدًّا

35
00:02:33,610 --> 00:02:34,960
.لقد عدت

36
00:02:39,420 --> 00:02:40,530
.سينامون

37
00:02:40,530 --> 00:02:41,960
هل أحسنتَ التّصرّف؟

38
00:02:43,090 --> 00:02:44,760
!توقّف يا سينامون

39
00:02:43,830 --> 00:02:49,090
وبشكل غريب، بقي عقلي كما هو
.عقل أودا نوبوناغا القويّ والرّزين

40
00:02:45,790 --> 00:02:47,700
.سيتّسخ زيّي المدرسيّ

41
00:02:47,700 --> 00:02:49,090
.على مهلك

42
00:02:49,350 --> 00:02:52,980
،لكنّ جسدي من جهة أخرى
!أصبح جسد كلب شيبا إينو منفوش؟

43
00:02:52,980 --> 00:02:54,710
.مستحيل

44
00:02:55,190 --> 00:02:58,770
!ولماذا أتصرّف بودّيّة زائدة الآن؟

45
00:02:59,160 --> 00:03:01,890
لماذا ألوّح بذيلي؟

46
00:03:01,890 --> 00:03:03,910
!لا أرغب حتّى في ذلك

47
00:03:04,960 --> 00:03:06,790
...كـ-كلاّ... لا يُعقل

48
00:03:08,210 --> 00:03:09,750
!غرائز الكلاب؟

49
00:03:09,750 --> 00:03:11,530
.اكتفيت

50
00:03:11,530 --> 00:03:13,280
.لا أستطيع التّحكّم بجسدي

51
00:03:13,280 --> 00:03:15,410
.تتحرّك أطرافي من تلقاء نفسها

52
00:03:15,410 --> 00:03:16,940
.على شكل كلبيّ

53
00:03:16,940 --> 00:03:18,210
...أنا كلب في النّهاية، لكن

54
00:03:19,390 --> 00:03:20,960
!هذا سخيف

55
00:03:30,080 --> 00:03:31,700
...نـ-نعم

56
00:03:31,700 --> 00:03:35,420
.وكأنّني في النّعيم عندما تداعب بطني

57
00:03:35,420 --> 00:03:37,880
.حسنًا يا سينامون، لنخرج في نزهة

58
00:03:38,350 --> 00:03:39,640
!أجل

59
00:03:39,980 --> 00:03:40,860
!كلاّ

60
00:03:40,860 --> 00:03:44,070
ماذا تقصد بـ"وقت الخروج"؟

61
00:03:44,070 --> 00:03:48,730
،ربّما تكونين مالكتي في هذا العالم
.لكنّ هذا ليس قرارك يا فتاة

62
00:03:49,120 --> 00:03:52,360
إنّه أنا نوبوناغا من سيقرّر
.إن كنّا سنخرج أم لا

63
00:03:54,640 --> 00:03:56,990
!وصل العدوّ إلى أوكيهازاما

64
00:03:56,990 --> 00:03:59,820
.إنّا نسعى خلف رأس إيماغاوا يوشيموتو فقط

65
00:03:59,820 --> 00:04:01,620
!اتبعوني يا رجال

66
00:04:03,410 --> 00:04:06,140
.هكذا يجب أن يكون الأمر

67
00:04:06,980 --> 00:04:13,160
في هذا العالم، أنا مجبر على تلقّي
.المساعدة من شخص آخر لمجرّد التّنزّه

68
00:04:13,930 --> 00:04:17,160
.من الممتع التّنزّه معك يا سينامون

69
00:04:17,810 --> 00:04:19,740
سينامون؟

70
00:04:19,740 --> 00:04:22,580
ألا يمكنك فعل شيء ما لذلك الاسم؟

71
00:04:22,580 --> 00:04:26,520
كما أنّ فكرة التّنزّه وحول عنقي
...طوق تمسك فتاة صغيرة

72
00:04:26,520 --> 00:04:29,440
قد تكون مشهدًا سعيدًا
،لأنّني على هيئة كلب

73
00:04:29,440 --> 00:04:31,660
لكن إن كنتُ على هيئتي
...في حياتي السّابقة

74
00:04:32,550 --> 00:04:34,180
!فهكذا سنبدو

75
00:04:42,780 --> 00:04:45,290
ألا تريد الذّهاب يا سينامون؟

76
00:04:45,290 --> 00:04:47,440
.تمالك نفسك أيّتها الصّغيرة

77
00:04:47,900 --> 00:04:50,190
من الصّعب الانضمام لهم، صحيح؟

78
00:04:50,190 --> 00:04:51,980
.لم نأتِ إلى هنا من قبل

79
00:04:51,980 --> 00:04:54,150
.كم هو ظريف

80
00:04:55,370 --> 00:04:57,080
أهو كلب شيبا إينو؟

81
00:04:57,080 --> 00:04:58,560
.نعم

82
00:04:58,560 --> 00:05:00,150
وما اسمه؟

83
00:05:00,420 --> 00:05:02,140
.اسمه سينامون

84
00:05:02,140 --> 00:05:04,260
سينامون-تشان؟

85
00:05:04,260 --> 00:05:05,040
.لا، لا

86
00:05:05,040 --> 00:05:06,100
.بل اسمي نوبوناغا

87
00:05:06,320 --> 00:05:07,470
!يا لظرافته

88
00:05:07,470 --> 00:05:08,470
!ظريف جدًّا

89
00:05:08,470 --> 00:05:09,860
.وناعم

90
00:05:11,010 --> 00:05:12,820
!هذا يكفي

91
00:05:12,820 --> 00:05:16,250
أنا آسفة، إنّه لا يُبلي حسنًا
.في اللّقاءات الاجتماعيّة

92
00:05:16,250 --> 00:05:17,690
.لا تقلقي

93
00:05:17,690 --> 00:05:20,380
إنّ طبيعة كلاب شيبا إينو المتقلّبة
.هي ما يجعلها مميّزة

94
00:05:21,160 --> 00:05:23,760
الأمر ليس أنّني لا أبلي حسنًا
.في اللّقاءات الاجتماعيّة

95
00:05:24,140 --> 00:05:25,790
.بل لأنّ ذلك هو خياري

96
00:05:25,790 --> 00:05:27,810
.أو لأنّني لا أهتمّ

97
00:05:27,810 --> 00:05:28,880
لماذا؟

98
00:05:29,580 --> 00:05:32,890
!هذا لأنّني نوبوناغا

99
00:05:33,720 --> 00:05:35,690
!توقّفن

100
00:05:35,690 --> 00:05:36,770
!قلت كنّ توقّفن

101
00:05:40,650 --> 00:05:43,330
.أنا لا أحبّ أيّ واحد من هذه الكلاب

102
00:05:45,090 --> 00:05:49,490
.لكنّ الفتاة تعتني بي يوميًّا

103
00:05:49,490 --> 00:05:53,150
.لذلك أفترض أنّني سأتصرّف ككلب الآن

104
00:05:57,450 --> 00:05:58,630
...حسنًا

105
00:05:58,630 --> 00:06:02,110
ما هي أكثر طريقة كلبيّة لتقديم نفسي؟

106
00:06:02,110 --> 00:06:05,540
.أعتقد أنّني سأحاول النّباح

107
00:06:05,950 --> 00:06:09,210
!أنا نوبوناغا

108
00:06:12,550 --> 00:06:16,720
ما كانت هذه الكلاب لتفهم
إن قلتُ ذلك، صحيح؟

109
00:06:16,720 --> 00:06:17,670
.كم هذا مملّ

110
00:06:17,670 --> 00:06:20,640
.سأضيّع الوقت في حفر حفرة

111
00:06:24,610 --> 00:06:25,970
!هذا ممتع

112
00:06:25,970 --> 00:06:27,400
!حفر الحفر ممتع

113
00:06:29,610 --> 00:06:33,230
يا سيّدي، هل أنت هو أودا نوبوناغا-دونو؟

114
00:06:33,900 --> 00:06:36,040
!يا لها من مصادفة

115
00:06:36,040 --> 00:06:39,090
هل عدتَ للحياة ككلب أيضًا؟

116
00:06:40,470 --> 00:06:41,470
من تكون؟

117
00:06:41,470 --> 00:06:43,700
!هذا أنا

118
00:06:43,700 --> 00:06:45,680
هل تقابلنا من قبل؟

119
00:06:45,680 --> 00:06:48,130
.لا، هذه أوّل مرّة نلتقي فيها

120
00:06:48,130 --> 00:06:50,670
كيف تعرف من أكون إذًا؟

121
00:06:50,670 --> 00:06:52,170
.احزر ذلك

122
00:06:52,170 --> 00:06:55,430
.انظر إلى نعومة فروي وعيناي اللاّمعتان

123
00:06:55,430 --> 00:06:57,320
.هذا أنا

124
00:06:58,250 --> 00:07:00,530
عينان لامعتان؟

125
00:07:01,900 --> 00:07:02,960
!أهذا أنت يا رانمارو؟

126
00:07:02,960 --> 00:07:04,320
!كلاّ

127
00:07:04,320 --> 00:07:06,560
!قلتُ أنّنا لم نتقابل من قبل

128
00:07:06,560 --> 00:07:08,110
.أنا مثقّف أكثر

129
00:07:08,110 --> 00:07:09,370
.صاحب جاه أكثر

130
00:07:09,370 --> 00:07:10,980
أرأيت؟

131
00:07:10,980 --> 00:07:12,510
مثقّف؟

132
00:07:12,510 --> 00:07:13,500
صاحب جاه؟

133
00:07:13,500 --> 00:07:15,080
!عرفتك

134
00:07:15,080 --> 00:07:18,330
حبّ

135
00:07:15,080 --> 00:07:18,330
!أنت ناوي كانيتسوغو ذو الخوذة الغبيّة

136
00:07:19,090 --> 00:07:21,220
أهذا هو تخمينك؟

137
00:07:21,220 --> 00:07:23,710
.أنت غبيّ بشكل مفاجئ

138
00:07:24,290 --> 00:07:26,250
.حسنًا، ما عدت أهتمّ

139
00:07:26,250 --> 00:07:27,410
!لا، مهلاً! مهلاً

140
00:07:27,410 --> 00:07:30,130
.ما باليد حيلة

141
00:07:33,220 --> 00:07:38,340
،أنا تجسيد فورين كازان
.حامي إله سوا العظيم

142
00:07:38,820 --> 00:07:41,380
.تبرّر وسائلي كلّ الغايات

143
00:07:41,380 --> 00:07:43,320
،أنا نمر كاي

144
00:07:45,340 --> 00:07:48,590
!تاكيدا شينغن

145
00:07:51,390 --> 00:07:55,330
.عدت للحياة أظرف بكثير أيّها العجوز

146
00:07:55,330 --> 00:07:56,790
.لا تناديني بالعجوز رجاءً

147
00:07:56,790 --> 00:08:01,200
لكن لم يبقَ أيّ شيء
.من حياتك السّابقة فيك الآن

148
00:08:01,200 --> 00:08:02,470
أتظنّ ذلك؟

149
00:08:02,470 --> 00:08:04,060
.أمعن النّظر

150
00:08:07,440 --> 00:08:08,220
.صحيح

151
00:08:08,220 --> 00:08:09,220
.ذلك

152
00:08:09,220 --> 00:08:10,430
.ذلك فقط

153
00:08:10,430 --> 00:08:14,420
.لستُ الوحيد الّذي عاد للحياة ككلب

154
00:08:14,420 --> 00:08:16,300
!أمعن النّظر

155
00:08:19,530 --> 00:08:23,310
كلب البولدوغ الفرنسيّ البشع
...ذاك ذو غطاء العين

156
00:08:29,320 --> 00:08:34,070
!أنا رجل أوشو الشّهير، داتي ماساموني

157
00:08:34,070 --> 00:08:39,490
لا تنسوا أيضًا أنّني التّنّين ذو العين
!الواحدة الّذي يجعل البكّائين يبكون أكثر

158
00:08:42,050 --> 00:08:46,350
خلال مسيرتي، انتصرت في 43
.معركة وتعادلت في 25

159
00:08:46,350 --> 00:08:48,800
.%وذلك يجعل معدّل انتصاراتي فوق 95

160
00:08:51,830 --> 00:08:57,090
،إله الحرب العظيم لإتشيغو
.أنا أوسوغي كنشين

161
00:09:00,660 --> 00:09:04,610
من أكثر من زرع الرّعب في قلوب اليابانيّين؟

162
00:09:04,610 --> 00:09:06,840
نوبوناغا؟ إياسو؟

163
00:09:08,320 --> 00:09:12,730
ل كان أنا، المخطِّط العبقريّ، كورودا كانبي

164
00:09:14,650 --> 00:09:17,740
نسوا أمر حادثة أوكيهازاما

165
00:09:18,270 --> 00:09:22,320
أنا في الحقيقة موهوب أكثر ممّا
.يبدو، أفضل نشّاب في البحار

166
00:09:25,240 --> 00:09:29,000
!أنا إيماغاوا يوشيموتو بعينه

167
00:09:30,620 --> 00:09:35,120
.كما ترى، حاد سادة الحروب للحياة ككلاب

168
00:09:36,300 --> 00:09:39,380
.إ-إنّهم مجموعة من النّجوم المشاهير

169
00:09:39,380 --> 00:09:42,430
،هذا الحيّ في وسط صراع

170
00:09:42,430 --> 00:09:44,890
.تمامًا مثل حقبة الممالك المتحاربة

171
00:09:44,890 --> 00:09:48,760
لكن لماذا يبدو مظهر الجميع
جيّدًا فيما عداك أنت؟

172
00:09:49,100 --> 00:09:51,950
.واضح أنّ الأمر ليس كذلك

173
00:09:51,950 --> 00:09:54,350
...حسنًا

174
00:09:54,350 --> 00:09:56,730
.ستدرك الأمر عندما تكبر

175
00:09:58,110 --> 00:10:01,800
.أنا أحبّ جدًّا كم أنّ الكلاب مسترخية

176
00:10:01,800 --> 00:10:03,660
.مـ-معك حقّ

177
00:11:41,720 --> 00:11:42,720
!ما هذا؟

178
00:11:43,550 --> 00:11:47,500
إنّه ذلك الشّيء المموّج الّذي كان
!يلبسه الأجانب حول رقبتهم

179
00:11:47,500 --> 00:11:49,940
!كان ذلك شائعًا جدًّا في تلك الفترة

180
00:11:49,940 --> 00:11:52,060
!تبدو رائعة جدًّا

181
00:11:52,340 --> 00:11:53,820
!أ-أريدها

182
00:11:54,240 --> 00:11:57,870
.لطالما كنتُ أتكيّف سريعًا

183
00:11:58,900 --> 00:12:01,180
!أريدها بشدّة

184
00:12:01,180 --> 00:12:02,160
ماذا؟ ماذا؟

185
00:12:03,840 --> 00:12:06,400
سينامون، أتريد قبّعة استحمام؟

186
00:12:08,190 --> 00:12:11,360
.أنت ترغب في أغرب الأشياء أحيانًا

187
00:12:11,910 --> 00:12:13,790
.لكنّني سأشتري لك واحدة

188
00:12:13,790 --> 00:12:15,030
!فعلاً؟

189
00:12:15,030 --> 00:12:17,350
!نعم، بالفعل

190
00:12:19,370 --> 00:12:21,640
.قد أبدو هكذا

191
00:12:21,640 --> 00:12:24,540
.سأحمّمك بمجرّد عودتنا للمنزل

192
00:12:25,320 --> 00:12:27,140
أقلتِ حمّام؟

193
00:12:27,640 --> 00:12:30,640
!لا أريد الاستحمام

194
00:12:33,400 --> 00:12:37,610
،في حياتي السّابقة
.كنت أحبّ الاستحمام كثيرًا

195
00:12:37,610 --> 00:12:39,580
.يا له من مشهد رائع

196
00:12:39,580 --> 00:12:41,260
.رجاءً يا سيّدي

197
00:12:41,590 --> 00:12:43,940
.يا ويحي، انزلقت يدي

198
00:12:43,940 --> 00:12:46,440
.يكفي يا سيّدي

199
00:12:47,670 --> 00:12:49,990
.أنا في النّعيم

200
00:12:49,990 --> 00:12:51,920
...وفي حياتي الحاليّة

201
00:12:53,450 --> 00:12:57,270
إنّه شكل من أشكال التّعذيب
.أرشّ فيه بالماء عندما أتّسخ

202
00:13:03,000 --> 00:13:06,150
.لم يكن هذا ما تخيّلته بالتّحديد

203
00:13:07,550 --> 00:13:08,450
.انظر

204
00:13:08,450 --> 00:13:11,730
بارتدائك لها، فلن يدخل الماء
.إلى أذنيك وعينيك

205
00:13:12,570 --> 00:13:17,030
.يا فتاة، دخل كلّ الماء في أذنيّ

206
00:13:23,260 --> 00:13:26,330
.لقد أطلت في ذلك

207
00:13:28,560 --> 00:13:30,410
.هذا أفضل

208
00:13:30,410 --> 00:13:33,250
.دعني أسكب الماء عليه بعدما انتهيت

209
00:13:33,250 --> 00:13:35,160
.نعم، قومي بذلك

210
00:13:35,160 --> 00:13:36,710
.سينامون-دونو

211
00:13:37,600 --> 00:13:39,280
.لم أرك منذ مدّة

212
00:13:39,280 --> 00:13:41,530
.إنّه داتي ماساموني

213
00:13:41,530 --> 00:13:43,090
.أنا بعينه

214
00:13:43,090 --> 00:13:48,220
عند الحديث عن التّنّين ذو العين الواحدة
،المحبوب من طرف التّنّين الإله الأزرق أوشو

215
00:13:49,660 --> 00:13:51,290
.فأنا من يقصدون

216
00:13:52,030 --> 00:13:54,510
.ها قد بدأ بالتّبجّح بنفسه فجأة

217
00:13:54,930 --> 00:13:59,060
لا بدّ أنّ هذه هي "متلازمة تلاميذ
.الفصل الثّامن" الفظيعة اللاّ علاج لها

218
00:14:01,270 --> 00:14:02,550
.مرحبًا

219
00:14:02,550 --> 00:14:04,390
.مرحبًا بك أيضًا

220
00:14:05,530 --> 00:14:10,250
.أريدك أن تكفّ عن مناداتي سينامون

221
00:14:10,250 --> 00:14:11,500
لماذا؟

222
00:14:11,500 --> 00:14:13,030
.أنت سينامون الآن

223
00:14:13,030 --> 00:14:15,780
!لا أحبّ اسم سينامون

224
00:14:16,410 --> 00:14:18,060
.هذه عاقبة أفعالك

225
00:14:18,060 --> 00:14:21,660
لا بدّ أنّ آثامك في حياتك السّابقة
.قد عادت لتنال منك

226
00:14:21,660 --> 00:14:23,180
ماذا تعني؟

227
00:14:23,180 --> 00:14:25,870
.حصلتَ على اسم لا تحبّه

228
00:14:25,870 --> 00:14:29,260
،إن كان ذلك عقابًا إلهيًّا
.فعليك قبوله

229
00:14:29,900 --> 00:14:31,200
.كلام فارغ

230
00:14:31,200 --> 00:14:34,670
وبماذا ينادونك في حياتك الحاليّة؟

231
00:14:35,980 --> 00:14:37,440
أنا؟

232
00:14:37,440 --> 00:14:38,680
...ينادونني

233
00:14:39,740 --> 00:14:43,450
!ناب التّنّين الأزرق الدّمويّ

234
00:14:43,450 --> 00:14:45,320
!تـ-تنّين أزرق؟

235
00:14:45,320 --> 00:14:47,030
!هذا رائع جدًّا

236
00:14:47,030 --> 00:14:48,770
!رفيع! رفيع جدًّا

237
00:14:49,700 --> 00:14:50,800
.أعلم ذلك

238
00:14:50,800 --> 00:14:52,950
.هيّا بنا يا بو-تشان

239
00:14:56,040 --> 00:14:57,940
.لنذهب يا بو

240
00:14:57,940 --> 00:14:59,130
!"لا تناديني "بو

241
00:14:59,510 --> 00:15:00,420
بو؟

242
00:15:00,420 --> 00:15:01,630
.أنا أحبّه. إنّه ظريف

243
00:15:01,630 --> 00:15:02,990
.أجده رائعًا

244
00:15:02,990 --> 00:15:04,020
!بو هي العدالة

245
00:15:04,020 --> 00:15:05,130
!بو رائع

246
00:15:05,130 --> 00:15:06,130
.إلى اللّقاء

247
00:15:07,640 --> 00:15:10,890
أشعر أنّه يحاول جاهدًا
.مواساة نفسه

248
00:15:12,710 --> 00:15:15,140
.نل منهم يا بو-تشان

249
00:15:20,490 --> 00:15:22,530
هل تشعر بالعطش يا سينامون؟

250
00:15:23,160 --> 00:15:24,180
أتريد بعض الماء؟

251
00:15:24,180 --> 00:15:25,210
.نعم

252
00:15:26,290 --> 00:15:27,600
.تفضّل

253
00:15:28,450 --> 00:15:31,050
...صحيح أنّني عطشان

254
00:15:31,050 --> 00:15:32,120
...لكن

255
00:15:32,370 --> 00:15:36,860
...إذلال شرب الماء من يدي فتاة

256
00:15:38,940 --> 00:15:40,610
.لكنّي سأشرب قليلاً

257
00:15:45,510 --> 00:15:47,170
!لذيذ

258
00:15:48,620 --> 00:15:52,670
لا أصدّق أنّ الماء من يدي آنسة
...قد يكون لذيذًا لهذه الدّرجة

259
00:15:52,670 --> 00:15:55,260
.إنّه يعادل كوب شاي من إعداد ريكيو

260
00:15:55,260 --> 00:15:56,720
.تأخذني نكهته للنّعيم

261
00:16:01,250 --> 00:16:02,880
.هذا رائع

262
00:16:02,880 --> 00:16:06,480
مداعب هذه الفتاة لبطني
.لهو نعمة من السّماء

263
00:16:06,480 --> 00:16:08,740
!نوبوناغا-ساما

264
00:16:11,310 --> 00:16:12,240
ما الخطب؟

265
00:16:13,980 --> 00:16:15,790
ماذا؟ أهذا أنا؟

266
00:16:15,790 --> 00:16:17,150
.هذا في هونّوجي

267
00:16:17,150 --> 00:16:20,370
ما كنتَ لتعرف ما يُعرض
في التّلفاز، صحيح؟

268
00:16:20,370 --> 00:16:21,710
!بل أعرف

269
00:16:21,710 --> 00:16:24,830
كما أنّ هذا هو الجزء الّذي
.أستسلم فيه لمصيري

270
00:16:27,070 --> 00:16:28,790
.لقد مات

271
00:16:32,150 --> 00:16:33,920
!أنا أحتجّ

272
00:16:33,920 --> 00:16:35,800
.إنّه مجرّد تمثيل

273
00:16:36,070 --> 00:16:38,660
لكن تخيّلوا التّعرّض للقتل في هونّوجي
،في المسلسلات التّاريخيّة وما شابه

274
00:16:38,660 --> 00:16:42,840
،كلّ بعضة سنوات مرارًا وتكرارًا
.وأكثر من عشرات المرّات

275
00:16:42,840 --> 00:16:46,700
،مرّة تلو الأخرى، ويتمرّد عليّ نفس الرّجل

276
00:16:46,700 --> 00:16:48,850
.وأموت بنفس الطّريقة

277
00:16:48,850 --> 00:16:55,070
لا أتحمّل انتشار إشاعة عنّي
.بأنّ نوبوناغا لا يتعلّم أبدًا

278
00:16:55,370 --> 00:16:58,190
هل تكره ميتسوهيدي؟

279
00:16:58,190 --> 00:16:59,950
.بالطّبع

280
00:16:59,950 --> 00:17:02,380
...في المرّة القادمة الّتي أراه

281
00:17:02,380 --> 00:17:03,870
!سأقضي عليه

282
00:17:04,390 --> 00:17:06,860
.لكنّك لا تختلف عنه

283
00:17:08,890 --> 00:17:11,290
!سُحقًا لك يا نوبوناغا

284
00:17:11,290 --> 00:17:14,390
.قتلتَ يوشيموتو-دونو أيضًا

285
00:17:14,870 --> 00:17:18,190
.كلاّ، ذلك موضوع، وهذا موضوع آخر

286
00:17:18,190 --> 00:17:20,190
.هذا غير منطقيّ

287
00:17:20,190 --> 00:17:24,160
لطالما قيل أنّ المنصر في الحرب
.يختاره الحظّ فحسب

288
00:17:24,160 --> 00:17:27,660
يجمعنا اتّفاق رجاء محترمين بألاّ نكره
.بعضنا سواء انتصرنا أم هُزمنا

289
00:17:27,660 --> 00:17:32,650
في الحقيقة، لم أسمع أبدًا أنّ يوشيموتو-دونو
.منزعج من نوبوناغا-دونو

290
00:17:32,920 --> 00:17:35,290
.بالفعل. هكذا يجب أن تكون الأمور

291
00:17:35,290 --> 00:17:37,050
.لا فائدة من حمل الضّغينة

292
00:17:37,050 --> 00:17:40,130
.يُفترض بالذّكريات السّيّئة أن تُنسى

293
00:17:40,130 --> 00:17:42,200
لكن ماذا إن التقيتَ بميتسوهيدي؟

294
00:17:42,200 --> 00:17:43,190
!سأقضي عليه

295
00:17:44,690 --> 00:17:48,150
هل أنت واثق فعلاً أنّ ميتسوهيدي
هو من حمل السّلاح ضدّك؟

296
00:17:48,150 --> 00:17:49,620
أواثق من ذلك؟

297
00:17:49,930 --> 00:17:52,920
.رأيتُ رمز زهرة الجرس على الأعلام في هونّوجي

298
00:17:52,920 --> 00:17:55,730
هل التقيت ميتسوهيدي إذًا؟

299
00:17:56,340 --> 00:17:58,250
!إنّه غيلبرت-دونو

300
00:17:58,250 --> 00:18:01,860
.ليس من الصّعب تزييف الأعلام

301
00:18:01,860 --> 00:18:03,090
.تشارلي-دونو

302
00:18:03,090 --> 00:18:04,260
.لم نرك منذ مدّة

303
00:18:06,530 --> 00:18:08,050
إذًا، هل التقيته؟

304
00:18:08,050 --> 00:18:10,020
هل التقيت ميتسوهيدي؟

305
00:18:10,530 --> 00:18:13,130
.صحيح أنّني لم ألتقي بميتسوهيدي

306
00:18:13,130 --> 00:18:15,520
.معك حقّ يا تشارلي-دونو

307
00:18:15,520 --> 00:18:18,370
لكن، من الّذي قتلني؟

308
00:18:19,100 --> 00:18:22,540
البلاط الامبراطوريّ
وشوغونيّة أشيتاغا وهونغانجي

309
00:18:22,540 --> 00:18:25,760
ومتطرّفون من إيغا
...وإيشي-ناغاشيما وإنرياكوجي

310
00:18:25,760 --> 00:18:28,660
.هنالك آخرون كُثر ممّن كرهوك

311
00:18:28,660 --> 00:18:31,370
!أكنتُ غير محبوب لهذه الدّرجة؟

312
00:18:31,370 --> 00:18:32,120
.نعم

313
00:18:31,370 --> 00:18:32,120
.صحيح

314
00:18:31,370 --> 00:18:32,120
.بالفعل

315
00:18:31,370 --> 00:18:32,120
.نعم يا رجل

316
00:18:31,370 --> 00:18:32,120
.أجل

317
00:18:34,250 --> 00:18:36,710
.هيديوشي وإياسو مشتبهان فيهما أيضًا

318
00:18:36,710 --> 00:18:39,220
.لا، ليس هما

319
00:18:39,760 --> 00:18:43,490
.القرد-كُن وإياسو رجلان طيّبان جدًّا

320
00:18:43,990 --> 00:18:45,700
.كنّا متوافقين معًا

321
00:18:45,700 --> 00:18:47,510
.مستحيل أن يكونا من تمرّد عليّ

322
00:18:48,350 --> 00:18:51,990
سل نفسك من كان المستفيد من موتك؟

323
00:18:51,990 --> 00:18:53,110
....تلك

324
00:18:56,650 --> 00:18:59,120
!هي أساسيّات حلّ الألغاز

325
00:19:02,050 --> 00:19:05,600
إن كنتَ حيًّا، ما كان هيديوشي
،ليأخذ اليابان

326
00:19:05,600 --> 00:19:08,670
.وما كان إياسو ليصبح شوغن

327
00:19:09,160 --> 00:19:11,270
...صـ-صحيح

328
00:19:11,270 --> 00:19:13,540
.لكن لا يمكن أن يكونا

329
00:19:14,090 --> 00:19:16,550
.يا له من ساذج

330
00:19:16,550 --> 00:19:20,190
.كلاّ، أعتقد أنّه ميتسوهيدي على الأرجح

331
00:19:20,190 --> 00:19:22,540
.لقد تقاتلنا كثيرًا

332
00:19:22,930 --> 00:19:24,320
!ميتسوهيدي

333
00:19:24,320 --> 00:19:25,810
.أتحدّاك أن تقول ذلك ثانية

334
00:19:26,090 --> 00:19:28,040
.سأواصل قول ذلك

335
00:19:28,040 --> 00:19:32,640
مذابح المدنيّين في حصار
.إيسي-ناغاشيما كانت عملاً فظيعًا

336
00:19:32,640 --> 00:19:33,610
!اخرس

337
00:19:33,920 --> 00:19:35,780
.أنت تخدمني

338
00:19:35,780 --> 00:19:38,480
.لا تحتاج لأيّ شيء آخر سوى اتّباع أوامري

339
00:19:38,860 --> 00:19:43,770
،كلاّ، ولأنّني تابعك بالتّحديد
.عليّ مواجهتك بآثامك بكلّ صدق

340
00:19:44,040 --> 00:19:45,270
!ميتسوهيدي

341
00:19:45,270 --> 00:19:46,280
!تراجع عن كلامك الآن

342
00:19:56,820 --> 00:19:59,480
ما كانت تلك الدّموع الّتي ذرفها؟

343
00:20:00,260 --> 00:20:03,350
.لم يرق لي ميستوهيدي يومًا

344
00:20:03,750 --> 00:20:05,980
.كان مثاليًّا جدًّا

345
00:20:05,980 --> 00:20:07,990
.كان وسيمًا وبارعًا في عمله

346
00:20:07,990 --> 00:20:09,840
.وأحبّته كلّ النّساء

347
00:20:09,840 --> 00:20:13,420
كان قويًّا في المعارك وحمله
.للبندقيّة كان في غاية الإتقان

348
00:20:13,420 --> 00:20:15,020
.وكان وسيمًا بالفعل

349
00:20:16,580 --> 00:20:22,150
،ربّما كان يسخر منّي خلف ظهري
.فقط لأنّه كان وسيمًا

350
00:20:22,690 --> 00:20:23,640
.نعم

351
00:20:23,640 --> 00:20:25,570
.هذا شيء كان ليفعله رجل وسيم

352
00:20:25,870 --> 00:20:27,370
!لا بدّ من ذلك

353
00:20:27,370 --> 00:20:30,400
!ميتسوهيدي هو بالتّأكيد من بدأ الانقلاب ضدّي

354
00:20:30,950 --> 00:20:32,660
!أيّها الوغد ميتسوهيدي

355
00:20:32,660 --> 00:20:33,880
...أنا

356
00:20:35,170 --> 00:20:37,890
!أكره ميتسوهيدي

357
00:20:38,540 --> 00:20:40,540
أكلّ هذا له علاقة بمن تحبّ ومن تكره؟

358
00:20:40,540 --> 00:20:43,300
أكان بهذه السّخافة دائمًا؟

359
00:20:44,130 --> 00:20:48,510
.سُحقًا، قلتُ ما أفكّر به عن طريق الخطأ

360
00:20:51,040 --> 00:20:54,370
.ومع ذلك، حتّى إن كرهتَ ميتسوهيدي

361
00:20:54,370 --> 00:20:57,970
فلا يعني ذلك بالضّرورة
أنّ ميتسوهيدي كان يكرهك، صحيح؟

362
00:20:57,970 --> 00:20:59,180
.بالفعل

363
00:20:59,490 --> 00:21:01,000
،في تلك الحالة

364
00:21:01,000 --> 00:21:05,690
من الأفضل ألاّ تلوم أكيتشي ميتسوهيدي
.بسرعة عمّا حدث في هونّوجي

365
00:21:07,290 --> 00:21:10,070
.ومع ذلك، أراهن أنّ ميتسوهيدي من فعلها

366
00:21:10,070 --> 00:21:13,330
هل أنت واثق أنّ ذلك ليس
ما تريد تصديقه فحسب؟

367
00:21:15,990 --> 00:21:17,850
!ذ-ذلك الوجه

368
00:21:19,340 --> 00:21:22,340
!إ-إنّه يبدو مثل ميتسوهيدي

369
00:21:22,340 --> 00:21:23,720
!كلاّ

370
00:21:23,720 --> 00:21:25,840
أ-أهكذا عاد للحياة ثانية؟

371
00:21:28,960 --> 00:21:30,100
!أنت

372
00:21:32,080 --> 00:21:34,400
!مـ-ميتسوهيدي يقترب

373
00:21:34,950 --> 00:21:37,830
!العدوّ في هونّوجي

374
00:21:38,600 --> 00:21:41,610
!سوف يقتلني في حياتي هذه أيضًا

375
00:21:46,380 --> 00:21:52,510
!أ-أ-أنا أحبّك

376
00:21:51,240 --> 00:21:53,480
!ما-ماذا؟

377
00:23:24,440 --> 00:23:25,780
!سينامون-دونو

378
00:23:25,780 --> 00:23:26,490
من؟

379
00:23:26,490 --> 00:23:28,220
.أنا لستُ سينامون

380
00:23:28,220 --> 00:23:31,500
.ماذا؟لكنّك سينامون بالفعل

381
00:23:31,500 --> 00:23:34,860
أنا سيّد الممالك المتحاربة
!أودا نوبوناغا

382
00:23:34,860 --> 00:23:37,690
.لن أقبل أبدًا باسم رخيص مثل سينامون

383
00:23:37,690 --> 00:23:38,600
.صافحني

384
00:23:39,600 --> 00:23:40,700
!توقّف

385
00:23:40,700 --> 00:23:41,600
.هيّا، بالقائمة الأخرى

386
00:23:42,680 --> 00:23:43,740
!قلتُ توقّف

387
00:23:44,220 --> 00:23:45,600
.أنت كلب بالفعل

388
00:23:45,600 --> 00:23:49,240
.أحزن لأنّني أصبح أشبه بالكلب تدريجيًّا

389
00:23:49,570 --> 00:23:53,720
بعد قولي لذلك، أتمنّى منكم
!مشاهدة الحلقة القادمة