1
00:00:00,000 --> 00:00:04,060
(البرنامج التالي موجّه للجمهور البالغ فقط)

2
00:00:09,890 --> 00:00:10,820
...ناسّي، أنتِ

3
00:00:11,270 --> 00:00:13,650
!ما الذي تفعلينه؟
...إذا هربت، فساكي-تشان

4
00:00:13,650 --> 00:00:15,390
لست تهرب

5
00:00:16,960 --> 00:00:19,350
إذا متّ، فستكون النهاية حقّاً

6
00:00:19,350 --> 00:00:22,510
لا يمكنني الإقرار على ذلك
حتّى إذا لم تمانع

7
00:00:22,510 --> 00:00:25,670
اختيار الموت لا يختلف
عن ارتكاب الانتحار

8
00:00:25,670 --> 00:00:29,210
قلت بنفسك أنّ أتعس طريقة
...يموت فيها المرء هي

9
00:00:33,750 --> 00:00:34,860
ناسّي؟

10
00:00:36,140 --> 00:00:39,980
...يبدو أنّ موني كانت محقة، الآن

11
00:00:46,840 --> 00:00:48,080
!ناسّي

12
00:00:48,080 --> 00:00:49,320
!كاكيهاشي-كن

13
00:00:50,190 --> 00:00:51,210
أأنت بخير؟

14
00:00:51,210 --> 00:00:52,430
...ناسّي

15
00:00:57,110 --> 00:00:59,600
ميراي-كن، أنا آسفة

16
00:00:59,600 --> 00:01:04,960
خُفّضت للرتبة الثانية

17
00:02:36,240 --> 00:02:37,400
الرتبة الثانية؟

18
00:02:37,400 --> 00:02:38,620
بالطبع

19
00:02:38,620 --> 00:02:43,520
هذا ثمن التدخّل عندما يوشك مرشّحك
على فشله في أن يصبح إلهاً

20
00:02:44,420 --> 00:02:52,530
لأنّي خُفّضت للرتبة الثانية، فما يمكنني تقديمه لك
هو السهم الأحمر أو الأجنحة فحسب

21
00:02:53,280 --> 00:02:57,030
اختر أيّهما تريد الاحتفاظ به رجاءً

22
00:02:57,630 --> 00:03:00,340
أجنحة أو سهم أحمر؟

23
00:03:00,340 --> 00:03:03,190
إذا تخلّيت عن أجنحتك، فلن تستطيع
تفادي أسهمه

24
00:03:03,190 --> 00:03:05,180
عليك التخلّي عن السهم الأحمر

25
00:03:05,180 --> 00:03:09,140
إذا فعلتُ ذلك، ستفقد ويوميكي-سان
أجنحتكما وأسهمكما فوراً

26
00:03:09,140 --> 00:03:11,640
عليك القلق على نفسك أكثر

27
00:03:11,640 --> 00:03:13,380
!أنت مرشّح إله

28
00:03:13,380 --> 00:03:15,140
لم أعد بحاجةٍ للطيران

29
00:03:16,770 --> 00:03:19,050
ناسّي، سأحتفظ بسهمي الأحمر

30
00:03:20,050 --> 00:03:24,700
سآخذ سهمك الأبيض وحلقات أجنحتك إذاً

31
00:03:36,280 --> 00:03:39,670
آسفة، يبدو أنّك ستموت
إذا أنقذتُك مجدّداً

32
00:03:42,330 --> 00:03:46,730
تمضي الأمور كما خطّطت له
في مجملها

33
00:03:46,730 --> 00:03:50,240
فوق خسارة أحمر للسهم الأبيض
،الذي يحتاجه لقتلي

34
00:03:50,240 --> 00:03:52,660
فهو لا يستطيع الطيران بمفرده الآن

35
00:03:53,310 --> 00:03:55,820
ناكاومي-كن، هل قتلتَ صفراء؟

36
00:03:56,340 --> 00:03:58,090
كلا، ليس بعد

37
00:03:58,650 --> 00:03:59,900
جيّد

38
00:04:01,960 --> 00:04:04,490
هوشي، أنزل أحمر

39
00:04:04,490 --> 00:04:07,820
إذا لم تفعل، سأقتل صفراء
هذه المرّة حقّاً

40
00:04:09,170 --> 00:04:10,410
ما الذي يجري؟

41
00:04:09,170 --> 00:04:15,210
!اقتله! اقتله! اقتله

42
00:04:10,410 --> 00:04:12,060
أحمر في عداد الموتى

43
00:04:12,060 --> 00:04:13,980
ستموت صفراء إذا هرب

44
00:04:13,980 --> 00:04:15,210
عليه النزول

45
00:04:15,210 --> 00:04:17,140
هوشي-سان، أنزلني رجاءً

46
00:04:17,140 --> 00:04:22,080
لا أستطيع، سيقتلك يونيدا
فورما أفعل

47
00:04:22,080 --> 00:04:24,360
لا يمكنني أن أسمح بموتك

48
00:04:24,360 --> 00:04:26,870
أنزلني في مكان
واذهب لمكانٍ آخر إذاً

49
00:04:27,880 --> 00:04:28,990
...كاكيهاشي-كن

50
00:04:29,440 --> 00:04:33,060
إذا هرب أحمر، سأطلق على صفراء
بسهمي الأبيض

51
00:04:33,060 --> 00:04:38,570
.كلّا، سيقتل البروفسور أحمر بلا شكّ
إمّا يفعلها البروفسور أو أنا

52
00:04:38,570 --> 00:04:43,280
لا داعي لأفكّر، عليّ اتّباع
أوامر البروفسور لا أكثر

53
00:04:43,280 --> 00:04:45,370
فسيموت كلّ مرشّحي الإله

54
00:04:46,000 --> 00:04:50,740
كلّ ما يسعنا تمنّيه هو أن
يُنزل هوشي-سان أحمر

55
00:04:50,740 --> 00:04:54,880
ذلك ليس صحيحاً، لا أريد أن يموت أحمر

56
00:04:56,020 --> 00:04:58,150
حتّى لو اقتضى ذلك موتي

57
00:04:58,150 --> 00:05:02,150
ما عمق الحُب الورديّ بينكما؟ أشعر بالغيرة

58
00:05:02,150 --> 00:05:05,550
لكن... لا أريد أن أموت بدوري

59
00:05:05,550 --> 00:05:07,660
أريد أن أعيش وأجد السعادة

60
00:05:07,660 --> 00:05:12,310
،يشاركني كاكيهاشي-كن الشعور
يريد العيش وإيجاد السعادة

61
00:05:12,310 --> 00:05:16,080
فقد تعلّمتُ ذلك منه

62
00:05:16,080 --> 00:05:19,820
لا بدّ أنّ رغبته قويّةٌ أيضاً

63
00:05:19,820 --> 00:05:21,180
!اصمتي

64
00:05:21,180 --> 00:05:23,790
لا تتكلّمي عن هذا الآن

65
00:05:23,790 --> 00:05:27,120
ناكاومي-كن، لا يمكنك قتل شخص

66
00:05:27,120 --> 00:05:30,600
ما الذي تقولينه؟ سبق وأن قتل
العديد من الناس

67
00:05:30,600 --> 00:05:32,680
كانوا أشخاصاً أرادوا الموت

68
00:05:32,680 --> 00:05:35,140
لم يقتل أحداً يريد العيش

69
00:05:35,660 --> 00:05:38,250
أطلق عليه البروفسور بسهمٍ أحمر

70
00:05:38,250 --> 00:05:40,900
إذا أمره بالقتل، فسيفعل بلا شكّ

71
00:05:40,900 --> 00:05:41,760
كلّا

72
00:05:41,760 --> 00:05:42,610
ماذا؟

73
00:05:42,610 --> 00:05:47,500
حتّى لو أطلقت على أحدهم بالسهم الأحمر
وأخبرته بأن يموت، فلن يفعل إن كان يريد العيش

74
00:05:47,500 --> 00:05:52,550
بما أنّ ناكاومي-كن يقدّر حياة
،الآخرين أكثر من حياته

75
00:05:52,550 --> 00:05:56,330
لا بدّ أنّ قتل شخصٍ يريد العيش
سيحمل ثقلاً أكبر

76
00:05:56,940 --> 00:05:59,080
ناكاومي-كن لطيف

77
00:05:59,420 --> 00:06:02,230
أراد مساعدة الناس
الذين كانوا يعانون

78
00:06:02,230 --> 00:06:07,090
اختار استعمال سهمه الأحمر على
من سعوا للموت، وقادهم للطريق لا أكثر

79
00:06:07,090 --> 00:06:10,670
!اصمتي! إذا واصلتِ الكلام فسأقتلكم جميعاً

80
00:06:10,670 --> 00:06:11,820
...إذاً

81
00:06:12,630 --> 00:06:14,830
اقتلني، رغم أنّي لا أريد الموت

82
00:06:15,900 --> 00:06:19,770
اقتلني وأخبر البروفسور أنّك قتلتني

83
00:06:19,770 --> 00:06:22,600
عندها لن يتحتّم على كاكيهاشي-كن الموت

84
00:06:22,600 --> 00:06:23,470
!ساكي

85
00:06:28,060 --> 00:06:29,160
حسناً

86
00:06:32,210 --> 00:06:33,810
سأقتلك

87
00:06:44,260 --> 00:06:46,120
فكّر بالأمر يا ميراي-كن

88
00:06:46,120 --> 00:06:49,630
حتّى لو ماتت ساكي-تشان، فأنا متأكّدة
أنّك ستستطيع تجاوز الأمر

89
00:06:51,370 --> 00:06:52,830
لا تدعيني أكرّر كلامي

90
00:06:52,830 --> 00:06:56,800
لا يمكنني أن أسمح بموت ساكي-تشان
لأنّي قلت أنّي سأصبح الإله

91
00:06:56,800 --> 00:07:00,760
من المستحيل أن أجد السعادة
إذا قُتلت ساكي-تشان

92
00:07:00,760 --> 00:07:02,080
مستحيل؟

93
00:07:02,080 --> 00:07:03,490
مستحيل

94
00:07:03,490 --> 00:07:07,780
الموت هنا سيعطيك
أكبر سعادةٍ إذاً؟

95
00:07:09,140 --> 00:07:14,650
لن أكون سعيداً، بل تعيساً. لكنّ موت
ساكي-تشان سيُشعرني بتعاسةٍ أكبر

96
00:07:14,650 --> 00:07:19,020
،بما أنّي لا أستطيع التفكير بحلٍّ الآن
فهذا أفضل خياراتي المتوفرة

97
00:07:19,970 --> 00:07:21,290
تعيس؟

98
00:07:22,370 --> 00:07:23,800
آسفة

99
00:07:24,860 --> 00:07:29,820
أتيتُ لأجعلك سعيداً، لكن يبدو أنّي لم أنجح

100
00:07:30,990 --> 00:07:37,910
لا بأس، شعرتُ بالسعادة مرّات عديدة
لأنّكِ أنقذتِ حياتي آنذاك

101
00:07:39,730 --> 00:07:44,320
لمتى ستواصلان الثرثرة؟
أتريد أن أبدأ العدّ التنازليّ؟

102
00:07:45,100 --> 00:07:47,050
هوشي-سان، أفهمتَ الآن؟

103
00:07:48,170 --> 00:07:49,050
فهمت

104
00:08:15,510 --> 00:08:16,520
حسناً إذاً

105
00:08:22,470 --> 00:08:23,920
وداعاً

106
00:08:26,100 --> 00:08:29,550
،سأصدّ سهمه الأبيض بسهمي الأحمر
ثمّ أطلق عليه به

107
00:08:29,550 --> 00:08:32,400
كلا، لا فائدة. لا أجنحة لديّ الآن

108
00:08:33,250 --> 00:08:37,040
مهما حاولت تجربته، ستموت ساكي-تشان إذا فشلت

109
00:08:38,620 --> 00:08:39,540
...ساكي-تشان

110
00:08:45,140 --> 00:08:46,130
...اختفى

111
00:08:46,130 --> 00:08:46,980
هل هرب؟

112
00:08:52,370 --> 00:08:53,660
!ساكي-تشان

113
00:08:59,730 --> 00:09:00,890
!ساكي-تشان

114
00:09:01,360 --> 00:09:02,390
كاكيهاشي-كن

115
00:09:04,220 --> 00:09:05,160
صفراء؟

116
00:09:09,400 --> 00:09:11,400
يوميكي؟ ناكاومي-كن؟

117
00:09:16,370 --> 00:09:20,280
!رجع مرشّحو الإله الذين غادروا قبلاً

118
00:09:24,640 --> 00:09:26,180
ما معنى هذا؟

119
00:09:27,720 --> 00:09:33,200
رغم أنّك أطلقت عليه بسهمٍ أحمر، لا يمكن
أن يقتل ناكاومي-كن أشخاصاً يريدون العيش

120
00:09:33,850 --> 00:09:38,000
يونيدا، تفاديت التعامل مع الناس
بكلّ التدابير الممكنة

121
00:09:38,000 --> 00:09:41,570
فيبدو أنّك لا تملك مقدرة
فهم مشاعر الآخرين

122
00:09:42,460 --> 00:09:45,140
بروفسور، أنا آسف

123
00:09:45,140 --> 00:09:48,780
قد أستطيع الإقدام على القتل المتبادل
،"لمنع ولادة "المخلوق

124
00:09:48,780 --> 00:09:52,190
لكن لا يمكنني قتل مرشّحي الإله
الآخرين مهما حاولت

125
00:09:52,190 --> 00:09:53,420
القتل المتبادل؟

126
00:09:54,330 --> 00:09:56,580
نويا قتل كافّة مرشّحي الإله

127
00:09:57,930 --> 00:10:01,750
ثمّ قتل بعضهما نهايةً، وهكذا لن يُولد إله

128
00:10:04,260 --> 00:10:10,080
حسبتُ لهذا، حضّرتُ خطّةً لهذه الحالة

129
00:10:10,080 --> 00:10:14,270
ناكاومي-كن، سأسترجع السهم
الأبيض الذي أعطيتُك إيّاه

130
00:10:17,830 --> 00:10:19,070
ما الخطب؟

131
00:10:20,770 --> 00:10:21,700
مُت

132
00:10:23,910 --> 00:10:25,070
!بروفسور

133
00:10:28,680 --> 00:10:29,450
ماذا؟

134
00:10:29,450 --> 00:10:31,470
!ناسّي! ما الذي تفعلينه؟

135
00:10:31,470 --> 00:10:33,830
!سنفوز إن مات البروفسور

136
00:10:33,830 --> 00:10:37,120
ماذا؟ هل كاد البروفسور يموت؟

137
00:10:37,120 --> 00:10:40,190
اختفى لوهلة، ثمّ ظهر مجدّداً
في الجانب الآخر

138
00:10:43,150 --> 00:10:47,320
لكنّك يا ميراي-كن لا تريد
أن يموت البروفسور أيضاً، صحيح؟

139
00:10:47,920 --> 00:10:48,830
...ناسّي

140
00:10:49,340 --> 00:10:55,070
ألم تقولي أنّ ميراي سيموت إذا لمستِ
مرشّح إله لإنقاذه؟

141
00:11:05,020 --> 00:11:09,120
ميراي-كن، يبدو أنّي رجعت
للرتبة الخاصّة

142
00:11:09,770 --> 00:11:14,770
فهمت، هذا نقيض تأثير إنقاذها لمرشّحها

143
00:11:14,770 --> 00:11:18,750
أي أنّ رتبتها ارتفعت
بدل أن تُخفّض

144
00:11:18,750 --> 00:11:22,500
كلّ ما تفعله ناسّي
لا سابقة له بحقّ

145
00:11:22,920 --> 00:11:26,070
هاك يا ميراي-كن، أجنحتك وسهمك الأبيض

146
00:11:26,070 --> 00:11:28,140
كلّا، لم أعد بحاجةٍ لها

147
00:11:29,350 --> 00:11:34,880
هل... كنتُ سألقى حتفي الآن
لو لم تنقذني الملاك؟

148
00:11:35,540 --> 00:11:39,640
قال البروفسور يونيدا: "كنتُ سألقى حتفي الآن
"لو لم تنقذني الملاك

149
00:11:39,640 --> 00:11:41,220
ما معنى هذا؟

150
00:11:40,740 --> 00:11:42,940
كاد يموت بالفعل إذاً

151
00:11:42,940 --> 00:11:44,010
بسهمٍ أبيض؟

152
00:11:44,010 --> 00:11:44,960
أكان من فعل أحمر؟

153
00:11:44,960 --> 00:11:46,100
كلا

154
00:11:46,100 --> 00:11:47,660
كانت يوري-تشان

155
00:11:48,630 --> 00:11:52,160
أنقذ ملاكٌ حياتي للمرّة الثانية

156
00:11:53,400 --> 00:11:56,170
ناكاومي-كن، لمَ انقلبت عليّ؟

157
00:11:56,840 --> 00:12:01,000
لم أنقلب عليك، لا أزال أعتقد أنّك على حقّ

158
00:12:01,000 --> 00:12:04,870
صحيح، احتلتُ عليه كي يعطيني
سهمه الأبيض

159
00:12:17,830 --> 00:12:19,140
ناكاومي-كن

160
00:12:20,000 --> 00:12:21,360
لا يمكنني قتلك

161
00:12:22,630 --> 00:12:23,840
شكراً لك

162
00:12:24,550 --> 00:12:25,700
حرّرني أنا أيضاً بسرعة

163
00:12:27,560 --> 00:12:29,710
رائع! في آخر لحظة

164
00:12:29,710 --> 00:12:31,200
علينا الذهاب أيضاً

165
00:12:31,200 --> 00:12:33,290
...قبل ذلك

166
00:12:33,290 --> 00:12:36,890
لا أثق بك، سأحتفظ بسهمك الأبيض معي

167
00:12:36,890 --> 00:12:39,200
نحن مرشّحا إله، فيمكنك إعطائي إيّاه، صحيح؟

168
00:12:40,970 --> 00:12:43,790
أعتقد أنّك على حقٍّ يا بروفسور

169
00:12:43,790 --> 00:12:47,970
لكنّه محض اعتقاد، تفكير

170
00:12:47,970 --> 00:12:50,220
حياة الناس تخصّهم

171
00:12:50,220 --> 00:12:53,970
تقدير قيمتها أمرٌ يعود لهم

172
00:12:53,970 --> 00:12:57,360
رأيتُ أنّ من الخطأ إنهاء حياة
شخصٍ يريد العيش

173
00:12:57,360 --> 00:13:00,230
بسبب تفكير شخصٍ آخر

174
00:13:00,980 --> 00:13:04,390
...مُذ أعلنت أنّي مرشّح إله

175
00:13:04,390 --> 00:13:09,080
،كلا، بل مُذ ظهرت في الإعلام
كنتُ متحضّراً للموت

176
00:13:09,790 --> 00:13:12,610
لمَ تتحضّر للموت لأنّك
أظهرت وجهك فحسب؟

177
00:13:16,970 --> 00:13:19,360
لحظة، هل كانت المشكلة فقدانك لمعجباتك؟

178
00:13:19,360 --> 00:13:22,650
أراد البروفسور إتمام
بحثه في هدوءٍ لا أكثر

179
00:13:22,650 --> 00:13:25,890
أتقصد أنّها مشكلةٌ خاصة
بالعلماء العباقرة؟

180
00:13:25,890 --> 00:13:27,050
أجل

181
00:13:27,050 --> 00:13:29,360
لا وجود للعباقرة

182
00:13:29,900 --> 00:13:33,100
أنا ساذج

183
00:13:33,700 --> 00:13:41,100
ما تدعونه بالعبقريّ يجب أن يُعاز لإنجازات
المرء، وليس للمرء نفسه

184
00:13:41,100 --> 00:13:44,310
من الحماقة افتراض قدرة
أحدهم على أداء شيء

185
00:13:44,310 --> 00:13:47,650
مع انتقاده على عدم محاولته

186
00:13:48,080 --> 00:13:49,560
!أفهم ما تقصده

187
00:13:49,560 --> 00:13:52,700
يغيظني الناس الذين يسألون لمَ لا تقوم
!بشيء وأنت قادرٌ عليه

188
00:13:52,700 --> 00:13:54,820
يخصّني اختيار قيامي
بالأمر من عدمه

189
00:13:54,820 --> 00:13:59,060
:هذا تفسيرٌ صالح، تذكّروا مقولتي

190
00:13:59,060 --> 00:14:04,800
ذو القدرة المُطلقة والشرّ الخالص
لا يُظهر نفسه

191
00:14:04,800 --> 00:14:10,540
من الصعب الإقرار وأنت تستعمل
"عبارات مُتعالية مثل "تذكّروا مقولتي

192
00:14:11,070 --> 00:14:16,060
بالفعل، أسلوب الخطاب هذا الذي تقمّصتُه
بعدما أصبحتُ بروفسوراً فخريّاً

193
00:14:16,060 --> 00:14:18,490
هو من خصالي الساذجة

194
00:14:18,490 --> 00:14:20,470
محض كلامٍ مُفخّم

195
00:14:20,470 --> 00:14:23,050
يستحيل أن تكون شخصاً ساذجاً أيّها البروفسور

196
00:14:23,050 --> 00:14:26,420
حقّقت إنجازاتٍ، فأنت عبقريٌّ بلا شكّ

197
00:14:26,750 --> 00:14:30,310
فاز بجائزتيّ نوبل في الأدب والفيزياء

198
00:14:30,310 --> 00:14:32,690
وبحث يونيدا الخلويّ خاصّته
سيجعله يفوز بجائزة الطبّ

199
00:14:32,690 --> 00:14:35,690
يُقال أنّه باع ما يفوق
مليار نسخةٍ من مؤلّفاته

200
00:14:35,690 --> 00:14:37,430
إنّه عبقريّ

201
00:14:37,430 --> 00:14:38,810
أجل، عبقريّ

202
00:14:38,810 --> 00:14:42,430
عبقريّ! عبقريّ! عبقريّ

203
00:14:44,700 --> 00:14:48,800
كلّا، أنتم محقّون

204
00:14:48,800 --> 00:14:54,080
لا أفهم مشاعر الناس لأنّي
تفاديتُ التعامل معهم

205
00:14:54,080 --> 00:14:55,940
لا أصدقاء لديّ، ولا حُب

206
00:14:55,940 --> 00:15:00,490
استعضتُ عنها بأبحاث عن علم النفس
وتظاهرت بأنّي أفهم لا أكثر

207
00:15:00,490 --> 00:15:02,840
أنا إنسانٌ ساذجٌ وجبان

208
00:15:04,050 --> 00:15:08,130
كان عليّ ألّا أتورّط معكم

209
00:15:08,130 --> 00:15:10,850
أو بالأحرى، أسلوبي في ذلك كان خاطئاً

210
00:15:11,580 --> 00:15:16,600
من الأنسب أن أدعو الملائكة الزائفين
أمامي بالشياطين

211
00:15:16,930 --> 00:15:21,110
واصلتُ العيش لأنّ موني حثّتني بقول

212
00:15:21,110 --> 00:15:24,880
أنّ بإمكاني كشف طريقة عمل
عمليّة اختيار الإله وإيجاد الحقيقة

213
00:15:25,870 --> 00:15:31,260
أصبحتُ مرشّح إله، ولم أستطع مقاومة
التدخّل بعدما رأيتكم

214
00:15:31,260 --> 00:15:35,550
لكن بسبب ذلك، تسنّت لي فرصة الإدلاء
بأنّ الوقت للبشريّة قد حان

215
00:15:35,550 --> 00:15:39,580
لتوضّح أنّ لا وجود لإله، وجب قول ذلك

216
00:15:40,250 --> 00:15:42,570
ذلك يرضيني بحدّ ذاته

217
00:15:43,940 --> 00:15:46,660
افعلوا ما يحلو لكم

218
00:15:47,490 --> 00:15:49,000
...بروفسور

219
00:15:49,890 --> 00:15:54,000
من المُحتمل أنّه لا يمكن للبشر
إيجاد السعادة إلّا عبر بعضهم

220
00:15:54,000 --> 00:15:57,480
وليس بالمقارنة بينهم

221
00:15:57,480 --> 00:16:01,530
قلت أنّ دافعك كان ذاتيّاً، لكنّ ما قمتَ به
كان لأجل البشر بنهاية المطاف

222
00:16:01,530 --> 00:16:02,860
لديّ ساكي-تشان

223
00:16:03,450 --> 00:16:08,290
،لديّ شيءٌ أضحّي بحياتي لحمايته
شخصٌ أريد حمايته

224
00:16:08,780 --> 00:16:11,020
هذه السعادة

225
00:16:14,800 --> 00:16:19,260
بالفعل، أعتذر على المتاعب
التي سبّبتُها لكم

226
00:16:19,260 --> 00:16:22,940
حتّى لو أمكن الوصول للسعادة
،عبر الغير فقط

227
00:16:22,940 --> 00:16:25,330
فعلينا ألّا نسبّب متاعب لهم قطعاً

228
00:16:25,330 --> 00:16:28,670
ولذا عليّ قتل نفسي

229
00:16:29,440 --> 00:16:31,040
سأموت الآن

230
00:16:31,450 --> 00:16:34,050
ويمكنك أن تصبح "المخلوق" يا أحمر

231
00:16:34,050 --> 00:16:35,450
يموت؟

232
00:16:35,450 --> 00:16:36,990
سيموت البروفسور يونيدا؟

233
00:16:36,990 --> 00:16:38,010
لمَ؟

234
00:16:38,010 --> 00:16:39,030
!لا يصحّ هذا

235
00:16:39,030 --> 00:16:40,690
!لا يُعقل

236
00:16:39,400 --> 00:16:40,690
...بروفسور

237
00:16:41,000 --> 00:16:45,100
بروفسور، لمَ أنت متعجّلٌ للموت؟

238
00:16:46,720 --> 00:16:52,200
أنا متأهّبٌ للإقدام على أيّ شيءٍ
لإثبات نظريّتي بعدم وجود إله

239
00:16:52,200 --> 00:16:55,440
"تعلّقتُ بفكرة منع ولادة "المخلوق

240
00:16:55,440 --> 00:17:00,180
حاولتُ الوصول للحقيقة عبر إماتة
كافّة مرشّحي الإله

241
00:17:00,180 --> 00:17:02,820
كنتُ مهووساً بالموت

242
00:17:04,710 --> 00:17:09,980
كنتُ ساذجاً، أنقذت ملائكةٌ
حياتي مرّتين

243
00:17:10,360 --> 00:17:15,420
في تلك الحالة، سأصبح المخلوق وأفعل
!كلّ ما بوسعي لأكشف لك كلّ شيء

244
00:17:19,160 --> 00:17:24,620
ما اتّفقنا عليه بدايةً كان أن يصبح
ناكاومي-كن الإله بعد النقاش

245
00:17:24,620 --> 00:17:25,600
لا أمانع

246
00:17:26,230 --> 00:17:30,070
لكن أطلق البروفسور على ناكاومي-كن
بسهمٍ أحمر

247
00:17:31,680 --> 00:17:35,680
ظننتُ أنّ الشخص المُصاب بسهمٍ أحمر
لا يمكن أن يُرغم على أن يصبح إلهاً

248
00:17:35,680 --> 00:17:39,640
يحتفظ البروفسور يونيدا بمبدئه
،على منع ولادة إله

249
00:17:39,640 --> 00:17:44,450
لكنّ ناكاومي شوجي تطوّع ليصبح
الإله من تلقاء رغبته، ووافق على ذلك

250
00:17:44,450 --> 00:17:47,010
لا علاقة للسهم في هذه الحالة

251
00:17:47,010 --> 00:17:50,760
!رائع يا أوغارو! سيصبح شريكك الإله

252
00:17:51,200 --> 00:17:55,210
لكن لا يمكن للإله إيصال
أيّ شيءٍ للبشر

253
00:17:55,210 --> 00:17:59,030
بعد انتهاء عمليّة الاختيار، لن نستطيع
القدوم إلى هنا أيضاً

254
00:17:59,610 --> 00:18:04,270
هنالك أشياءٌ يمكن إيصالها
دون التواصل المباشر

255
00:18:07,720 --> 00:18:13,220
لديك قدرة اكتشاف حقيقة
كلّ شيءٍ في نهاية المطاف

256
00:18:13,220 --> 00:18:17,600
أرفض اعتبارها كذبةً البتّة

257
00:18:17,600 --> 00:18:19,410
...إذاً في هذه الحالة

258
00:18:20,800 --> 00:18:23,870
أأنت راضٍ بهذا حقّاً يا ناكاومي-كن؟

259
00:18:25,390 --> 00:18:26,380
أجل

260
00:18:30,420 --> 00:18:35,400
إذاً، سأصبح الإله. هل أنتم موافقون؟

261
00:18:36,070 --> 00:18:36,800
أجل

262
00:18:37,170 --> 00:18:38,340
نعم

263
00:18:38,340 --> 00:18:39,300
أتّفق

264
00:18:39,880 --> 00:18:41,310
بالفعل

265
00:18:42,520 --> 00:18:48,750
حُسم الأمر، سـ-سيكون ناكاومي شوجي-كن
!ذو الثلاثة عشر عاماً الإله

266
00:18:48,420 --> 00:18:49,560
ماذا؟

267
00:18:49,560 --> 00:18:52,120
طالب في الإعداديّة سيكون الإله؟

268
00:18:51,080 --> 00:18:52,130
لا يصحّ هذا

269
00:18:52,130 --> 00:18:54,820
!يونيدا سينسي

270
00:18:53,330 --> 00:18:54,820
هذا مريع

271
00:19:13,630 --> 00:19:15,610
السماء... ماذا؟

272
00:19:27,160 --> 00:19:28,690
اختفت أجنحتنا

273
00:19:28,690 --> 00:19:29,990
صدقاً؟ أسهمنا أيضاً

274
00:19:31,220 --> 00:19:34,100
لا يتحرّك هوشي-سان أو يوميكي-سان

275
00:19:34,100 --> 00:19:35,730
،باستثناء مرشّحي الإله

276
00:19:36,190 --> 00:19:39,230
فقد محيتُ عمليّة الاختيار
من ذكريات الجميع

277
00:19:44,080 --> 00:19:46,540
أصبح إلهاً بحقّ

278
00:19:46,540 --> 00:19:48,010
إنّه المخلوق

279
00:19:48,010 --> 00:19:52,120
قبل أن أصبح إلهاً كليّاً، أريد أن أطرح
سؤالاً على كافّة مرشّحي الإله

280
00:19:53,100 --> 00:19:56,350
أهنالك من بينكم من يريد
الاحتفاظ بذكرياته عن عمليّة الاختيار

281
00:19:56,350 --> 00:19:58,750
وعن كونه مرشّح إله؟

282
00:20:01,050 --> 00:20:05,530
بروفسور، ستضمن لي حياةً مُترفة، أليس كذلك؟

283
00:20:05,530 --> 00:20:09,480
لا أتراجع عن كلامي، أضمن لك بالفعل

284
00:20:09,480 --> 00:20:13,460
لا داعيّ لأتذكّر هذه التجربة
!الفظيعة إذاً

285
00:20:14,090 --> 00:20:19,360
سأحتفظ بذكرياتي بالطبع
وأنتظر إجابتك يا ناكاومي-كن

286
00:20:19,360 --> 00:20:21,750
،كما إذا لم أحتفظ بهذه الذكريات

287
00:20:21,750 --> 00:20:25,040
فلن أفهم لمَ أدعم تيماري يوري

288
00:20:25,040 --> 00:20:28,530
يجدر بك الاحتفاظ بذكرياتك
!عميقاً يا بروفسور

289
00:20:28,530 --> 00:20:29,740
بالفعل

290
00:20:31,050 --> 00:20:36,180
لا أريد نسيان ما مررتُ به وتعلّمته
في عمليّة الاختيار هذه

291
00:20:36,180 --> 00:20:41,190
أريد الإبقاء على آمال وأحلام
مرشّحي الإله الموتى أيضاً

292
00:20:41,720 --> 00:20:43,690
وكلّ من لقي حتفه

293
00:20:44,730 --> 00:20:46,430
سأحتفظ بذكرياتي أيضاً

294
00:20:46,840 --> 00:20:50,400
فهمت، هذا كلّ ما أردتُ السؤال عنه

295
00:20:51,410 --> 00:20:52,410
وداعاً

296
00:21:23,280 --> 00:21:24,910
ماسايا-سان

297
00:21:24,910 --> 00:21:26,070
مانامي؟

298
00:21:27,040 --> 00:21:27,570
ماذا؟

299
00:21:27,570 --> 00:21:28,650
يونيدا؟

300
00:21:28,650 --> 00:21:29,850
بالفعل

301
00:21:29,850 --> 00:21:31,920
ما هذا؟ أين أنا؟

302
00:21:31,920 --> 00:21:35,170
العاشر من أكتوبر؟ لا أزال
على قيد الحياة؟

303
00:21:35,170 --> 00:21:37,160
ما الذي كنت أفعله؟

304
00:21:38,610 --> 00:21:42,000
أنتِ المساعدة الأولى
في مختبر البروفسور الفخريّ

305
00:21:42,000 --> 00:21:43,890
في قسم العلوم الحيويّة

306
00:21:43,890 --> 00:21:47,260
في كليّة العلوم والهندسة لجامعة طوكيو

307
00:21:47,260 --> 00:21:50,870
ماذا؟ لكنّي رأيتك في مكان ما

308
00:21:50,870 --> 00:21:54,540
لحظة، أنا فتاة علوم وتكنولوجيا
في جامعة طوكيو؟

309
00:21:54,540 --> 00:21:55,770
لا بأس بذلك

310
00:22:02,170 --> 00:22:03,280
لنرجع

311
00:22:03,280 --> 00:22:04,120
أجل

312
00:22:27,210 --> 00:22:29,120
هذه السماء العُليا إذاً؟

313
00:22:31,150 --> 00:22:35,040
...اكتسح المخلوق جسدي