1
00:00:00,350 --> 00:00:06,000
(البرنامج التالي موجّه للجمهور البالغ فقط)

2
00:00:01,140 --> 00:00:03,620
أحمرك ضدّ أبيضي

3
00:00:03,620 --> 00:00:07,650
سيكون قتالاً عادلاً واحد ضدّ واحد، موافق؟

4
00:00:08,910 --> 00:00:09,720
موافق

5
00:00:10,000 --> 00:00:14,120
قتال عادل؟ هذا كلامٌ لا يلائمك أبداً

6
00:00:15,530 --> 00:00:18,860
ما رأيك بأن نضع قواعداً؟

7
00:00:19,290 --> 00:00:20,240
ماذا؟

8
00:00:20,240 --> 00:00:23,250
!كلا يا أحمر! تجاهل أيّ ما يقترحه

9
00:00:24,740 --> 00:00:27,280
يمكننا فعلها بأسلوبك إذاً

10
00:00:27,280 --> 00:00:28,640
بأسلوبي؟

11
00:00:28,640 --> 00:00:33,260
أجل، لا أشعر برغبةٍ بالاقتراح بما أنّه
لا يثق بي، قرّر أنت

12
00:00:37,940 --> 00:00:41,150
نتوقّف عن الهرب ونتبادل إطلاق الأسهم

13
00:00:42,700 --> 00:00:47,480
تريدنا أن نثبّت أقدامنا في نطاق الإطلاق
ونتناوب على الرمي على بعضنا؟

14
00:00:47,480 --> 00:00:48,400
صحيح

15
00:00:48,640 --> 00:00:52,030
يطلق أحدنا بينما يتفادى الآخر

16
00:00:52,030 --> 00:00:55,700
نتناوب ونقلّص المسافة بعد
كلّ تفادٍ ناجح

17
00:00:55,700 --> 00:00:56,530
صحيح

18
00:00:58,340 --> 00:01:01,020
ليست بفكرةٍ سيّئة بالنسبة لساذج

19
00:01:03,960 --> 00:01:07,040
يمكن أن يحمينا ملاكانا من الوراء، أليس كذلك؟

20
00:01:07,040 --> 00:01:08,160
أجل

21
00:01:08,160 --> 00:01:12,050
لا نعرف أين ذهب تابعك الذي هرب
وما الذي يسعى له

22
00:01:12,570 --> 00:01:16,180
ينطبق ذلك على المترنّح على حافّة
الموت والفتاة القطّة

23
00:01:20,180 --> 00:01:22,460
أحمر، أرجوك

24
00:01:22,460 --> 00:01:27,210
،إذا أصبته بسهمك الأحمر وحسب
سأتولّى توجيه الضربة القاضية

25
00:01:28,790 --> 00:01:34,940
...إذا لم يكن قتله ما سيشعرك بالسعادة، فلعلّ

26
00:01:35,190 --> 00:01:38,440
قتله بيديّ هو ما سيشعرني بالسعادة

27
00:01:38,760 --> 00:01:41,100
أشكّ أنّك تفهم مع ذلك

28
00:01:42,040 --> 00:01:43,330
أتفهّمك

29
00:01:43,670 --> 00:01:45,830
يكفي، لنبدأ

30
00:01:46,340 --> 00:01:50,840
لا أرى أنّ من الضروريّ
تسوية النتيجة هنا

31
00:01:51,130 --> 00:01:53,090
احتفظي برأيك

32
00:01:54,060 --> 00:01:55,170
حاضرة

33
00:01:56,440 --> 00:01:57,540
...ميراي-كن

34
00:01:58,720 --> 00:02:01,720
الأبيض ضدّ الأحمر، قتال عادل

35
00:02:02,410 --> 00:02:03,730
واحد ضدّ واحد

36
00:02:04,740 --> 00:02:06,470
صحيح

37
00:02:07,120 --> 00:02:08,990
علينا تحديد من يهاجم أوّلاً

38
00:02:08,990 --> 00:02:11,980
النقش يعني أنا، والظهر يعني أنت

39
00:02:12,240 --> 00:02:13,730
أيّ ما تشاء

40
00:02:19,610 --> 00:02:20,610
!صدّها

41
00:02:21,880 --> 00:02:23,740
مجرّد تحمية

42
00:03:56,670 --> 00:03:58,000
حان دورك

43
00:03:58,000 --> 00:04:01,010
ثلاثة أمتار... كلا، خذ خمسة

44
00:04:01,660 --> 00:04:03,760
تقدّم وأطلق

45
00:04:13,390 --> 00:04:14,530
صدّه بدل الطيران؟

46
00:04:14,530 --> 00:04:17,900
ماذا؟ لا جدوى من فعل هذا
إذا طرتُ وحسب

47
00:04:17,900 --> 00:04:23,780
ألا يعني "نثبّت أقدامنا" ألّا نطير
كي نستطيع تسوية النتيجة؟

48
00:04:24,650 --> 00:04:29,790
مهلك، لم تفكّر بذلك حتّى؟
أيّ قاعدةٍ اقترحت؟

49
00:04:29,790 --> 00:04:34,500
أم ظننت أنّك الوحيد القادر على صدّ الأسهم؟

50
00:04:35,060 --> 00:04:36,750
لا تستهن بي

51
00:04:36,750 --> 00:04:39,690
لا شيء تستطيع فعله، ويستعصي عليّ

52
00:04:39,690 --> 00:04:42,780
لا أقلّ عنك في أيّ وجه

53
00:04:43,160 --> 00:04:44,510
أتفهم كلامي؟

54
00:04:44,510 --> 00:04:49,430
في كلّ النواحي، لا يوجد بشريّ
في هذا العالم يستطيع هزيمتي

55
00:04:50,530 --> 00:04:54,690
أتخال... أنّك أصبحت إلهاً بالفعل؟

56
00:04:55,890 --> 00:04:57,000
إله؟

57
00:05:00,500 --> 00:05:02,130
الإله

58
00:05:04,440 --> 00:05:06,300
يروقني مسمع ذلك

59
00:05:09,770 --> 00:05:11,520
الإله

60
00:05:16,010 --> 00:05:17,410
!مذهل

61
00:05:17,410 --> 00:05:21,300
شكراً لك يا أخي، تذكّرت وعدنا

62
00:05:21,300 --> 00:05:22,210
أجل

63
00:05:22,500 --> 00:05:25,720
جعلت فريقي للأبحاث يصنعها

64
00:05:26,200 --> 00:05:30,660
،لن تذبل هذه الأزهار أبداً
ستبقى جميلةً للأبد

65
00:05:32,730 --> 00:05:34,220
إنّها جميلةٌ جدّاً

66
00:05:37,700 --> 00:05:40,530
يا لجمالها، كأنّي في حلم

67
00:05:40,530 --> 00:05:41,840
أنا سعيدة

68
00:05:43,400 --> 00:05:44,300
أراقتك؟

69
00:05:44,300 --> 00:05:45,860
!إنّها الأروع

70
00:05:46,900 --> 00:05:50,800
أنت تحقّق كلّ أحلامي، أنت إلهي

71
00:05:50,800 --> 00:05:52,210
إلهك؟

72
00:05:52,210 --> 00:05:55,880
في تلك الحالة، أنت ملاكي
الجميل والظريف يا ريا

73
00:05:57,010 --> 00:06:00,230
تسعد الأشياء الجميلة الناس

74
00:06:00,230 --> 00:06:05,430
يمكن صنع الأشياء الجميلة كهذه الأزهار
إذا امتلكت الأموال

75
00:06:06,060 --> 00:06:09,480
جمال جسد وذهن ريا

76
00:06:09,480 --> 00:06:13,890
ينبع من ولادتها في عائلةٍ ثريّة
وترعرعها في كنف السعادة

77
00:06:14,530 --> 00:06:17,020
لأنّ القذارات لم تمسّها

78
00:06:17,430 --> 00:06:20,880
علاقتنا جميلةٌ أيضاً

79
00:06:20,880 --> 00:06:24,600
بيئة الشخص الثريّ تمدّه بالرقيّ طبيعيّاً

80
00:06:24,600 --> 00:06:27,720
،يُقدّم لهم الأفضل، ويتلقّون أفضل تعليم

81
00:06:27,720 --> 00:06:29,450
فيصبحون أكثر وأكثر جمالاً

82
00:06:32,200 --> 00:06:37,160
يجب حمايتهم من العالم
الفقير والقذر

83
00:06:37,460 --> 00:06:40,790
"لا بأس من الفقر إذا كان قلبك صافياً"
من منتهى السفسطة

84
00:06:41,240 --> 00:06:44,550
لا يمكن أن ينتج من الفقر
سوى الأشياء القذرة

85
00:06:45,250 --> 00:06:50,180
تدنّس الجسد، كما يتدنّس الذهن أيضاً

86
00:06:55,260 --> 00:06:58,080
نحبّ الأشياء الجميلة

87
00:06:58,080 --> 00:07:02,510
هكذا يشعر البشر بإخلاص

88
00:07:04,290 --> 00:07:05,500
أخي

89
00:07:05,500 --> 00:07:07,570
أجل؟ ما الأمر؟

90
00:07:07,570 --> 00:07:09,960
لديّ أنباء حسنة

91
00:07:11,980 --> 00:07:15,660
أخبرني صبيّ أنّه يكنّ مشاعراً لي

92
00:07:16,540 --> 00:07:20,080
وأفكّر بمواعدته

93
00:07:22,660 --> 00:07:24,210
!ستُدنّس

94
00:07:24,840 --> 00:07:27,380
من السهل الضلال عن الطريق القويم

95
00:07:27,380 --> 00:07:30,450
أنا الوحيد الذي صقل
جمال ريا للآن

96
00:07:30,450 --> 00:07:33,680
ما الذي سيحلّ بعلاقتنا
الأخويّة الجميلة المثاليّة؟

97
00:07:34,870 --> 00:07:36,220
أخي؟

98
00:07:38,490 --> 00:07:40,230
أنتِ يافعةٌ جدّاً

99
00:07:41,190 --> 00:07:42,200
لا يمكنك

100
00:07:51,100 --> 00:07:52,610
أخي؟

101
00:07:54,440 --> 00:07:55,990
إنّه شخصٌ صالح

102
00:07:55,990 --> 00:07:58,840
إذا التقيتَه، فأنا متأكّدةٌ أنّه سينال إعجابك

103
00:07:58,840 --> 00:08:02,310
ها هي، بدأت بالانهيار بالفعل

104
00:08:04,300 --> 00:08:05,420
!انتظري يا ريا

105
00:08:05,420 --> 00:08:07,160
!كلا! أنت تؤلمني

106
00:08:07,580 --> 00:08:08,560
!ريا

107
00:08:10,280 --> 00:08:12,010
أعرف أنّك تفهمين

108
00:08:14,240 --> 00:08:15,590
...كلا... كلا

109
00:08:15,590 --> 00:08:16,260
!ريا

110
00:08:16,260 --> 00:08:17,680
!لا! دعني

111
00:08:42,580 --> 00:08:44,210
!ريا

112
00:08:44,210 --> 00:08:45,640
أأنتِ بخيرٍ يا ريا؟

113
00:08:45,640 --> 00:08:47,660
!ريا! ريا

114
00:08:52,560 --> 00:08:55,010
ماذا هناك؟ أنا بخيرٍ تماماً

115
00:08:59,650 --> 00:09:02,600
...أشعر... بدوار

116
00:09:09,400 --> 00:09:10,500
ريا؟

117
00:09:12,770 --> 00:09:14,620
إنّها تظهر آثاراً لرضّة دماغيّة

118
00:09:14,620 --> 00:09:16,910
تبّاً، عليّ طلب الإسعاف

119
00:09:21,300 --> 00:09:24,070
...لـ-لو ماتت

120
00:09:24,730 --> 00:09:30,040
،فلن يتمكّن أحدٌ من تدنيسها
ستبقى جميلةً ويافعةً هكذا

121
00:09:51,950 --> 00:09:54,440
لن يُكشف مضمون التابوت أبداً

122
00:09:55,380 --> 00:09:57,200
جميلةٌ للأبد

123
00:09:59,390 --> 00:10:03,200
طاهرة للأبد، في الرابعة عشر للأبد

124
00:10:10,980 --> 00:10:14,520
ليتها... كانت حيّةً بالفعل

125
00:10:19,840 --> 00:10:23,910
ربما... عليّ الانضمام لريا

126
00:10:25,840 --> 00:10:32,980
وريث تكتّل شركات فاحشة الثراء
...مخلصٌ لرغباته

127
00:10:33,440 --> 00:10:36,560
تحزن لفقدانك شخصاً عزيزاً لك

128
00:10:37,630 --> 00:10:40,710
توجد طريقة واحدة فحسب
لتراها مجدّداً

129
00:10:42,140 --> 00:10:47,250
عليك أن تصبح إلهاً وتحوّل
العزيزة عليك لملاك

130
00:10:49,180 --> 00:10:52,750
...قريباً... سأصبح بلا شكّ

131
00:10:55,480 --> 00:10:56,840
!إلهاً

132
00:11:01,070 --> 00:11:03,260
هيّا، أسرع

133
00:11:03,950 --> 00:11:05,650
دورك تالياً

134
00:11:11,350 --> 00:11:12,970
ماذا؟ إنّه ميتروبوليمان

135
00:11:12,970 --> 00:11:14,150
إنّه يتقاتل مجدّداً

136
00:11:14,150 --> 00:11:16,540
هذا متقنٌ جدّاً، إنّها تأثيرات خاصة، صحيح؟

137
00:11:16,540 --> 00:11:19,380
بل حقيقيّة، مثل ما حصل
في المدرّج والبرج

138
00:11:19,380 --> 00:11:21,070
ماذا؟ أتقصد أنّها كذلك أيضاً؟

139
00:11:21,070 --> 00:11:22,560
يُبثّ على الإنترنت

140
00:11:22,560 --> 00:11:24,060
لمَ يحجبون؟

141
00:11:24,060 --> 00:11:26,290
كيلا يكشفون للناس مكانه؟

142
00:11:27,500 --> 00:11:29,710
سهلٌ جدّاً

143
00:11:40,010 --> 00:11:41,360
اقتربا لهذا الحدّ

144
00:11:41,360 --> 00:11:44,550
أجل، يفصل بينهما أقلّ من 20 متراً

145
00:11:44,550 --> 00:11:46,550
...إذا اقتربا أكثر

146
00:11:47,360 --> 00:11:48,790
...كاكيهاشي-كن

147
00:11:50,410 --> 00:11:54,940
،إذا واصلنا تقليص المسافة
فسيصبح نزال سرعة ردّات فعل

148
00:11:55,200 --> 00:11:57,690
ما الخطب؟ إنّه دورك

149
00:11:57,970 --> 00:12:01,190
لا جدوى من التفكير، أنا من سيصبح إلهاً

150
00:12:01,190 --> 00:12:04,630
لن أسمح بذلك، لن أرضى بعالمٍ
تكون فيه إلهاً

151
00:12:04,630 --> 00:12:06,450
لمَ تشاؤمك هذا؟

152
00:12:06,860 --> 00:12:10,040
ستموت، لكن قد يصبح العالم مكاناً أفضل

153
00:12:10,040 --> 00:12:14,620
مستحيل. سيتغيّر، لكن لن يكون ذلك
للأفضل قطعاً

154
00:12:15,420 --> 00:12:20,580
تريد القوّة الإلهيّة كي تحقّق رغباتك وحسب

155
00:12:20,580 --> 00:12:23,460
يستحيل أن تضع صالح العالم في اعتبارك

156
00:12:23,460 --> 00:12:26,220
لم تصب هنا

157
00:12:26,220 --> 00:12:31,730
فكّرتُ بما قد يجعل
العالم مكاناً أفضل

158
00:12:32,020 --> 00:12:35,830
رغم أنّي توقّفت عن التفكير لأنّ
الأمر بدا سخيفاً من فوره

159
00:12:36,180 --> 00:12:40,360
كما كيف يُعقل أن يصدّق أحد
شيئاً غير معقول كالإله؟

160
00:12:40,840 --> 00:12:44,110
ينطبق ذلك على الملائكة في الهواء هنا أيضاً

161
00:12:44,110 --> 00:12:46,130
،لكن سواءً كانوا ملائكةً حقّاً

162
00:12:46,130 --> 00:12:50,890
،أسلحةً خارقة، مخلوقات فضائيّة
،أو أيّ ما قد يكونون

163
00:12:50,890 --> 00:12:56,120
،من الأكيد أنّ المختارين فحسب بإمكانهم رؤيتهم
ويمتلكون قوى خاصّة

164
00:12:56,500 --> 00:12:57,340
ملائكة؟

165
00:12:57,340 --> 00:12:58,630
ما الذي يتكلّم عنه؟

166
00:12:58,930 --> 00:13:03,260
أجل، جيّد، يجب أن يعرف الجميع هذا

167
00:13:03,260 --> 00:13:06,510
إنّه يطلق لسانه

168
00:13:08,910 --> 00:13:10,600
نعمل على ذلك

169
00:13:10,600 --> 00:13:14,040
توجد عدّة طبقات حماية
نعمل على اختراقها

170
00:13:14,760 --> 00:13:17,150
ما هذا برأيك؟

171
00:13:17,400 --> 00:13:20,040
،مما رأيناه في المدرّج والبرج الكبير

172
00:13:20,040 --> 00:13:24,280
يبدو أنّ مرتدي التنكر هذا هو
العقل المدبّر لسلسلة الأحداث هذه

173
00:13:24,690 --> 00:13:26,780
ما هدفه يا ترى؟

174
00:13:27,190 --> 00:13:29,210
إله أوّلاً، ثمّ ملائكة

175
00:13:29,210 --> 00:13:32,450
ما المخفيّ في هذا التصوير؟

176
00:13:33,630 --> 00:13:39,360
اُخترت من قِبلهم، استغلال قواهم هو خيار متوفّر

177
00:13:39,360 --> 00:13:42,800
كلا، بل أستحقّ هذه القوى

178
00:13:43,500 --> 00:13:47,400
ما الذي جعلك تفقد الأمل؟

179
00:13:47,400 --> 00:13:49,300
أيّ أملٍ منحك إيّاه ملاكك؟

180
00:13:51,300 --> 00:13:53,650
كأنّي سأخبرك يا حمقاء

181
00:13:53,650 --> 00:13:57,040
إذا كنتِ تحاولين تشتيت انتباهي
،كي يستطيع أحمر الإطلاق عليّ

182
00:13:57,040 --> 00:13:58,760
فأنتِ تبلين حسناً بالنسبة لفتاة قطّة

183
00:13:58,760 --> 00:14:01,310
لكن اخرسي، سأقتلك

184
00:14:01,740 --> 00:14:03,240
لم تكن تلك نيّتها

185
00:14:03,240 --> 00:14:05,820
سألت صفراء من لطفها

186
00:14:06,410 --> 00:14:08,580
أنا أقاتل بعدل

187
00:14:08,580 --> 00:14:13,060
حاول الدفاع بعدل أمام هذا
!السهم من هذه المسافة

188
00:14:17,590 --> 00:14:18,870
صدّه بالكاد

189
00:14:19,360 --> 00:14:22,380
لعلّه يشعر بوجع بعد تصدّيه لذاك

190
00:14:22,380 --> 00:14:24,730
!أحمر، لا تدعه يستفزّك

191
00:14:24,730 --> 00:14:26,600
إنّه محتال

192
00:14:26,600 --> 00:14:29,260
!لا داعي لتقاتله بعدل

193
00:14:29,540 --> 00:14:34,160
رويدك، لا تتفوّه بكلامٍ
لا يليق عنّي

194
00:14:34,160 --> 00:14:38,470
يجب أن تصدّ سهمي بعدلٍ أيضاً، صحيح؟

195
00:14:38,470 --> 00:14:41,500
أيمكنني... فعل ذلك من هذه المسافة؟

196
00:14:41,500 --> 00:14:45,150
إذا استعملت أجنحتك أو حرّكت قدميك ستخسر

197
00:14:45,980 --> 00:14:47,370
إنّه قريبٌ جدّاً

198
00:14:47,370 --> 00:14:51,360
كلا، قد تسهل قراءة تحرّكاته
من هذا القرب

199
00:14:52,060 --> 00:14:53,030
يمكنني فعلها

200
00:14:53,290 --> 00:14:56,130
تمهّل، أخبرني بأمرٍ واحد

201
00:14:56,130 --> 00:14:59,110
لا أريد أن أصبح إلهاً

202
00:14:59,110 --> 00:15:03,290
لا أعرف أيّ عالم سيكون الأنسب ليعيش
فيه الناس أيضاً

203
00:15:03,510 --> 00:15:06,620
،لذا إذا تحقّقت أمنيتك

204
00:15:06,620 --> 00:15:11,750
ولم يصبح العالم مكاناً سيّئاً
...لنا أو لمن يعيشون فيه، عندها

205
00:15:11,750 --> 00:15:13,050
!لا-لا تفعلي يا صفراء

206
00:15:13,350 --> 00:15:15,490
ما الذي تقولينه أيّتها الفتاة القطّة؟

207
00:15:15,490 --> 00:15:20,540
أتطلبين مني الصفح عنكم مقابل
تركي أصبح إلهاً؟

208
00:15:20,540 --> 00:15:24,000
أم تنوين عقد اتّفاق لإنقاذ عزيزك الأحمر؟

209
00:15:24,000 --> 00:15:25,320
لا تفعلي

210
00:15:25,650 --> 00:15:28,200
قتل العديد من الأشخاص

211
00:15:28,200 --> 00:15:31,570
لا يمكن أن يصبح إلهاً
دون دفع ثمن ذلك

212
00:15:33,100 --> 00:15:34,120
أجل

213
00:15:34,570 --> 00:15:37,700
إيّاك أن تغترّ

214
00:15:37,700 --> 00:15:42,710
،مهما قتلت، فتلك عقوبةٌ إلهيّة
أنا أطبّق العدالة

215
00:15:42,710 --> 00:15:45,590
ذلك إن كان الإله موجوداً

216
00:15:45,880 --> 00:15:49,420
إذا كان يوجد كيانٌ مُطلق
،يعتلي كافة الأشياء الأخرى حقّاً

217
00:15:49,420 --> 00:15:52,590
فأنا الأنسب لأكون هو ببساطة

218
00:15:52,590 --> 00:15:55,980
هل فهمت؟ إذا فعلت، فاركع أمامي

219
00:15:57,380 --> 00:15:58,850
يا لغطرستك

220
00:16:00,960 --> 00:16:02,230
حسنٌ

221
00:16:03,510 --> 00:16:06,230
تظنّ أنّك أوهمتني بترك نفسك سانحاً؟

222
00:16:06,560 --> 00:16:09,410
أعرف ما الذي تفكّر به

223
00:16:09,410 --> 00:16:13,860
أنت تعتقد أنّك المُختار بحقّ

224
00:16:14,120 --> 00:16:17,360
لا أعتقد فحسب، أنا مميّز

225
00:16:17,360 --> 00:16:19,490
لا وجود للمميّز

226
00:16:19,490 --> 00:16:22,210
!لا شخص سامٍ أو دانٍ بين البشر

227
00:16:24,060 --> 00:16:25,560
أأنت أحدهم؟

228
00:16:25,560 --> 00:16:28,750
أحد المعدومين الذين لم يتلقّوا تعليماً لائقاً

229
00:16:28,750 --> 00:16:31,000
ولم يمتلكوا أصدقاءً مثل هاجيمي؟

230
00:16:31,980 --> 00:16:33,870
يبدو أنّي مُصيب

231
00:16:33,870 --> 00:16:38,390
لا يمكنك تقبّل اختياري لأنّك أحمق

232
00:16:38,390 --> 00:16:40,420
ذلك لأنّك ترعرعت في بيئةٍ

233
00:16:40,420 --> 00:16:43,770
لم تمنحك تعليماً لائقاً
ولم تحطك أشياء جميلة

234
00:16:44,060 --> 00:16:47,640
لا يفهم أصحاب الطبقات الدنيا
الأرواح الاستثنائيّة

235
00:16:48,650 --> 00:16:53,150
أنت مُطابقٌ لهاجيمي، لا عجب أنّك تنفرني مثله

236
00:16:53,450 --> 00:16:57,360
غيّرتُ رأيي، أريد تطبيق أفكاري

237
00:16:57,360 --> 00:17:00,540
سأخبرك قبل قتلك، كما أردت

238
00:17:02,140 --> 00:17:05,540
إذا كنتُ إلهاً، فهكذا سأغيّر
هذا العالم المشوّه

239
00:17:05,920 --> 00:17:08,170
سأزيل التفارقات من عالمنا

240
00:17:08,170 --> 00:17:11,170
سأزيل الفقر والظلم

241
00:17:11,610 --> 00:17:15,200
سأصنع عالماً يعيش فيه الجميع برخاء

242
00:17:19,220 --> 00:17:22,310
سيجعل العالم عادلاً؟

243
00:17:22,620 --> 00:17:23,620
ماذا؟

244
00:17:28,180 --> 00:17:30,220
لا تندهش هكذا

245
00:17:30,220 --> 00:17:34,500
ببساطة، عليّ التخلّص من أمثال هاجيمي وحسب

246
00:17:34,500 --> 00:17:38,200
إنّهم طفيليّات تقتات على ضرائبنا

247
00:17:38,480 --> 00:17:41,090
سأطهّر العالم من كلّ الحثالات
الذين يعيشون بلا مبالاة

248
00:17:41,090 --> 00:17:46,460
معتمدين على الدعم الاجتماعيّ
والتبرّعات وجهود المتطوّعين

249
00:17:47,290 --> 00:17:48,940
ما الذي تتكلّم عنه؟

250
00:17:48,940 --> 00:17:53,820
أقصد أنّ فجوة الثراء ستزول إذا
أبدنا الفقراء

251
00:17:53,820 --> 00:17:56,990
من الظلم إرغام الأثرياء على الاعتناء بالفقراء

252
00:17:56,990 --> 00:18:00,000
وإطعامهم دون تلقّي شيءٍ في المقابل

253
00:18:00,000 --> 00:18:03,620
يقتضي العدل ألّا يتلقّى أحد معاملةً مميّزة

254
00:18:03,620 --> 00:18:09,510
يجب أن يموت عديمو الاستحياء الذين يتلقّون
الشفقة والأعمال الخيريّة ويعتبرونها عدلاً

255
00:18:09,900 --> 00:18:10,880
ما هذا؟

256
00:18:10,880 --> 00:18:11,980
يا للفظاعة

257
00:18:11,980 --> 00:18:13,480
أيمكنه قول هذا؟

258
00:18:13,480 --> 00:18:14,980
!هذا تمييز! تمييز

259
00:18:16,490 --> 00:18:18,090
هذه فكرتك؟

260
00:18:19,270 --> 00:18:20,820
أ-أيمكنه فعل ذلك بالأصل؟

261
00:18:20,820 --> 00:18:21,740
يمكنه

262
00:18:22,090 --> 00:18:27,000
توجد عدّة شروط، لكنّ ذلك ممكن
إن أصبح إلهاً

263
00:18:27,000 --> 00:18:30,220
صحيح، إن أصبحتُ إلهاً

264
00:18:30,680 --> 00:18:35,970
،بغضّ النظر عن ظروف ولادة المرء
يملك الجميع الحقّ للسعادة

265
00:18:35,970 --> 00:18:39,020
أجل، يملكون الحقّ! لكن لا يمكنهم
!أن يصبحوا سعداء جميعاً

266
00:18:39,020 --> 00:18:42,860
يتمسّكون بأرجل الآخرين بدل ذلك
!ويجرّونهم إلى تعاستهم

267
00:18:42,880 --> 00:18:46,160
بالنسبة لمن يُجبرون على مساعدة غرباء
،لا تربطهم أيّ صلةٍ بهم

268
00:18:46,140 --> 00:18:48,200
!!لا تعدو كلماتك عن كونها هراءً

269
00:18:48,200 --> 00:18:51,400
!إنّها أعذار مغفّلٍ غسلت دماغه الفضيلة الكاذبة

270
00:18:51,400 --> 00:18:58,650
لا-لا تملك حقّ سلب إمكانيات الناس أو سعادتهم

271
00:18:58,650 --> 00:19:02,990
أستخبرني أنّ هناك من يصعد
من قعر الفقر؟

272
00:19:02,990 --> 00:19:05,030
إنّها مسألة احتمالات

273
00:19:06,290 --> 00:19:08,700
يمتلك المولودون في عوائل ثريّة

274
00:19:08,700 --> 00:19:12,300
أفضليّةً هائلة لإيجاد الهناء
البدنيّ والعاطفيّ

275
00:19:12,710 --> 00:19:15,860
ينجب الجميلون أشخاصاً جميلين

276
00:19:15,860 --> 00:19:18,920
وينجب القبيحون أشخاصاً قبيحين

277
00:19:19,420 --> 00:19:24,680
اكتفيتُ من هذا العالم الذي لا تستطيع
فيه النطق بالحقيقة ما لم ترتدِ قناعاً

278
00:19:25,280 --> 00:19:26,680
أفهمتني؟

279
00:19:27,040 --> 00:19:28,860
هاجيمي مثالٌ ممتاز

280
00:19:28,860 --> 00:19:34,260
لأنّه وُلِد لأبوين متدنّيين، أُجبر على عيش حياةٍ قبيحة

281
00:19:34,260 --> 00:19:38,280
،حتّى بعدما حصل على السهم الأحمر
كان لا يزال أحمقاً

282
00:19:38,280 --> 00:19:43,530
سعى للجمال بنهاية المطاف، وأجرى
كلّ تلك العمليّات التجميليّة

283
00:19:43,530 --> 00:19:44,840
!يشعرني بالغثيان

284
00:19:49,150 --> 00:19:53,480
،لذا حتّى إن كانوا أثرياءً
فسأزيل القبيحين أيضاً

285
00:19:54,410 --> 00:19:59,710
سألت صديقاً ذات مرّة عن أمنيته
إذا أمكنه تحقيق أيّ أمنية

286
00:19:59,710 --> 00:20:02,820
"وردّ صديقي بالتالي: "أريد المال

287
00:20:02,820 --> 00:20:05,720
إذا لم أستطع امتلاك ذلك، فأريد أن"
"تختفي كلّ القبيحات

288
00:20:06,500 --> 00:20:09,570
ما رأيك؟ هكذا يشعر البشر في أعماقهم

289
00:20:09,570 --> 00:20:11,780
...إ-إنّه كانادي

290
00:20:13,020 --> 00:20:17,470
عالمٌ يتزيّن بالجميلين فحسب، يثرى فيه الجميع

291
00:20:17,470 --> 00:20:19,630
هذا العالم الذي أبتغيه

292
00:20:19,630 --> 00:20:20,520
يبدو رائعاً لي

293
00:20:20,520 --> 00:20:21,760
حمقاء! ما الذي تقولينه؟

294
00:20:21,760 --> 00:20:23,610
سأُقتل بالتأكيد

295
00:20:24,230 --> 00:20:26,390
!أحسنت القول يا إله

296
00:20:25,540 --> 00:20:28,620
المعذرة، هل لي بكأسيّ جعّة؟

297
00:20:26,390 --> 00:20:28,620
هلّا تخلّصت من زوجتي؟

298
00:20:29,040 --> 00:20:33,250
لا عجب أنّ ميزا اختارته، إنّه متطرّفٌ جدّاً

299
00:20:34,400 --> 00:20:37,150
لكنّنا سنحتاج للخدم

300
00:20:37,150 --> 00:20:40,930
حتّى لو كانوا متدنّي الطبقة، سنبقيهم عبيداً
إن كانوا حسني المظهر

301
00:20:41,360 --> 00:20:42,880
أيّتها الفتاة القطّة

302
00:20:42,880 --> 00:20:46,480
إذا أصبحتُ إلهاً، سأترككِ تلعقين حذائي

303
00:20:46,480 --> 00:20:50,140
،في الواقع، يمكنك فعل ذلك الآن، فلتلعقيها

304
00:20:50,140 --> 00:20:52,330
!تـ-تبّاً لك

305
00:20:52,330 --> 00:20:54,650
!عالمٌ بلا ظلم"؟ يا للهراء"

306
00:20:54,650 --> 00:20:56,400
...كلّ كلامك

307
00:20:56,780 --> 00:20:59,400
اخرس أيّها المُسنّ، فلتمت وحسب

308
00:21:00,590 --> 00:21:02,400
انتهيت من حديثك؟

309
00:21:06,900 --> 00:21:09,910
خمسة أمتار، إنّه دوري تالياً

310
00:21:09,910 --> 00:21:12,910
عجباً، تغيّرت نظراتك

311
00:21:13,280 --> 00:21:15,180
اقترب أكثر إن أردت

312
00:21:15,180 --> 00:21:16,790
اتّفقنا على هذا

313
00:21:17,190 --> 00:21:18,430
خمسة أمتار

314
00:21:19,110 --> 00:21:22,900
لم يخطر لي من البداية أن
تفي بأيّ من اتّفاقاتنا

315
00:21:22,900 --> 00:21:26,410
لكنك ستفي، فأنت أحمق

316
00:21:26,410 --> 00:21:28,050
...كاكيهاشي-كن

317
00:21:28,680 --> 00:21:30,170
ما الخطب؟

318
00:21:30,170 --> 00:21:33,930
،أنا متأكّدٌ أنّك تدرك خسارتك إن أطلقت
حتّى بكونك أنت

319
00:21:34,220 --> 00:21:39,470
أجل، لحظة إطلاقك للأحمر، سأطلق سهمي الأبيض

320
00:21:41,470 --> 00:21:43,180
،حتّى لو أصابه بسهمٍ أحمر

321
00:21:43,180 --> 00:21:45,820
إذا أصابه السهم الأبيض الذي أطلقه، سيتمكّن منه

322
00:21:46,040 --> 00:21:48,180
بما أنّك ستكون قد
،أطلقت سهماً لتوّك

323
00:21:48,180 --> 00:21:51,550
لن تمتلك وقتاً لتجهيز سهم
آخر لصدّ سهمي الأبيض

324
00:21:51,550 --> 00:21:55,580
سيتعيّن عليك استعمال أجنحتك للهرب
من سهمي الأبيض إن أردت العيش

325
00:21:55,580 --> 00:21:58,820
!لكنّ استعمال أجنحتك للهرب سيكون غشّاً

326
00:21:58,820 --> 00:22:03,210
ستخرق القاعدة التي اقترحتها إن هربت

327
00:22:03,890 --> 00:22:07,930
أنت من أقدم على مختلف الأمور الدنيئة

328
00:22:07,930 --> 00:22:12,850
كما أنّه دور إطلاق أحمر، إطلاق سهمك سيكون ماكراً

329
00:22:12,850 --> 00:22:17,590
مهلك أيّتها الفتاة القطّة، أعقلك عقل قطّة أيضاً؟

330
00:22:17,590 --> 00:22:21,480
،عندما يطلق أحدنا سهماً، يتفاداه الآخر
هذه هي القواعد

331
00:22:21,480 --> 00:22:24,000
الصدّ ليس الطريقة الوحيدة
لتفادي تعرّضك للإصابة

332
00:22:24,000 --> 00:22:27,610
نقض قوّته بإطلاق سهمٍ
هو أسلوبٌ دفاعيّ

333
00:22:27,610 --> 00:22:30,240
سيكون المكر في إطلاقي أوّلاً مع ذلك

334
00:22:31,000 --> 00:22:35,300
إذا هربت، يفوز أحمر. لا أمانع ذلك

335
00:22:35,970 --> 00:22:41,140
رغم أنّي أشكّ بثباتك في مكانك
وترك السهم الأحمر يصيبك

336
00:22:41,140 --> 00:22:45,740
يا لإزعاجك، أدخل قدميك في تابوتٍ واخرس فقط

337
00:22:45,740 --> 00:22:49,040
قلتُ أنّي لن أهرب، لا تدعني أكرّر كلامي

338
00:22:49,040 --> 00:22:52,140
لن أهرب أيضاً، قرّرتُ سلفاً أنّي لن أفعل

339
00:22:54,300 --> 00:22:56,260
لن أقدم على أيّ مكر

340
00:22:56,260 --> 00:22:58,560
،ستخالف طبيعتك بعدم الهرب

341
00:22:58,560 --> 00:23:01,560
،لكن إذا كنت تقول أنّك ستقاتل بعدل
فيسرّني سماع ذلك

342
00:23:01,560 --> 00:23:05,440
فلنقم بتسوية الأمر سريعاً إذاً، أطلق

343
00:23:05,760 --> 00:23:09,430
أنا متأكّدٌ أنّك تفكّر بطريقة
،للفوز دون استخدام أجنحتك

344
00:23:09,430 --> 00:23:10,970
لكن لا يمكنك

345
00:23:10,970 --> 00:23:15,020
...لا أفكّر بذلك، ما أفكّر به

346
00:23:16,900 --> 00:23:20,740
"أأنا أقاتل ميتروبوليمان الحقيقيّ أم لا؟"

347
00:23:21,210 --> 00:23:22,210
ماذا؟

348
00:23:25,620 --> 00:23:27,710
ما الذي تقوله الآن؟

349
00:23:28,020 --> 00:23:30,970
لديّ سهمٌ أبيض في يديّ

350
00:23:30,970 --> 00:23:35,680
!أحمر، أنا متأكّدٌ بنسبة 99% أنّه ميتروبوليمان

351
00:23:35,680 --> 00:23:36,720
أعرف

352
00:23:37,440 --> 00:23:39,980
%لكنّها ليست 100

353
00:23:40,650 --> 00:23:42,700
...%وإذا لم تكن 100

354
00:23:48,830 --> 00:23:51,860
ما الذي يفعله؟ أيماطل؟

355
00:23:53,020 --> 00:23:54,370
كلا

356
00:23:54,940 --> 00:23:59,720
...يتظاهر بتردّده، لكنّه دوماً ما