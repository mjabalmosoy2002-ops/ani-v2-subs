1
00:00:01,000 --> 00:00:06,000
(البرنامج التالي موجّه للجمهور البالغ فقط)

2
00:00:16,670 --> 00:00:23,600
بذلتُ كلّ ما باستطاعتي لجعل العالم
البشريّ مكاناً أفضل لفترةٍ طويلة

3
00:00:23,600 --> 00:00:29,010
...لكن آن أوان أن أتنازل عن عرشي للبشريّ التالي

4
00:00:29,520 --> 00:00:32,140
لقوّة شابة

5
00:00:32,510 --> 00:00:38,050
بين كافة الملائكة، تمّ اختياركم
أيّها الثلاثة عشر المجيدون

6
00:00:38,050 --> 00:00:46,030
احتذاءً بالتقليد، أحد البشر الثلاثة عشر الذين
ستختارونهم سيصبحون الإله الجديد

7
00:00:46,490 --> 00:00:51,510
عندما يصبح بشريّكم المختار إلهاً، سينتهي عملكم كملائكة

8
00:00:51,510 --> 00:00:56,040
وستُجازون بحياةٍ هادئة بجوار الإله الجديد

9
00:00:56,320 --> 00:00:59,780
يمكن للبشريّ الذي يصبح إلهاً
أن يحصل على أيّ ما يشاء

10
00:01:00,860 --> 00:01:05,040
مهمّةٌ مستحيلة لملاك من الرتبة الثانية
مثلي لا يمكنه إلّا منح أسهم حمراء

11
00:01:05,250 --> 00:01:08,920
سأفعلّ أيّ ما يتطلّبه الأمر ليصبح البشريّ الذي
أختاره إلهاً، وأكون خادمه

12
00:01:09,360 --> 00:01:10,290
!رائع

13
00:01:10,290 --> 00:01:14,430
ربما يمكنني جعله... جعل ميراي-كن سعيداً الآن

14
00:01:14,430 --> 00:01:17,930
أمامكم 999 يوماً

15
00:01:20,470 --> 00:01:22,900
هيّا، انطلقوا

16
00:02:57,440 --> 00:02:59,660
...ثلاثة عشر مرشّح إله

17
00:03:00,160 --> 00:03:02,660
اختيار إله جديد؟

18
00:03:07,060 --> 00:03:09,220
إنّها الحقيقة يا ميراي-كن

19
00:03:10,380 --> 00:03:13,420
حسناً، أمامي ملاكٌ بالفعل

20
00:03:14,090 --> 00:03:16,430
لن يكون من الغريب وجود إلهٍ أيضاً

21
00:03:18,260 --> 00:03:19,900
هذا كثيرٌ عليّ

22
00:03:20,330 --> 00:03:23,430
،بالكاد أستطيع الاعتناء بنفسي

23
00:03:23,430 --> 00:03:25,810
لا أقدر ولا أريد أن أصبح إلهاً

24
00:03:25,810 --> 00:03:28,910
،لكن إذا أصبح شخصٌ آخر إلهاً

25
00:03:28,910 --> 00:03:31,190
ستُأخذ أجنحتك وأسهمك منك

26
00:03:31,190 --> 00:03:33,830
إذا أصبحتَ إلهاً، ستستطيع استعمالها بحريّة

27
00:03:33,830 --> 00:03:36,590
فعليك فعل ذلك لسعادتك، اتّفقنا؟

28
00:03:37,700 --> 00:03:40,040
سعادتي؟

29
00:03:43,740 --> 00:03:45,430
...كانت أمّي دائماً ما تقول

30
00:03:47,720 --> 00:03:50,930
،يُولد الجميع بهدف إيجاد السعادة"

31
00:03:51,490 --> 00:03:55,070
"ويعيشون سعياً وراء اكتساب سعادةٍ أكبر

32
00:03:56,720 --> 00:03:57,970
ها نحن

33
00:03:57,970 --> 00:03:59,750
!انطلاق

34
00:04:01,230 --> 00:04:02,220
...وأيضاً

35
00:04:02,610 --> 00:04:07,600
إذا لم تكن سعيداً، لا يمكنك أن تبدي سعادةً
حقيقيّة عندما يجد الآخرون سعادتهم

36
00:04:08,120 --> 00:04:11,360
لكن أتعرف يا ميراي؟ ذلك ليس كلّ شيء

37
00:04:11,570 --> 00:04:16,610
ما لم يكن الجميع سعيدون، فلا يمكنك أن تهنأ
بسعادتك الخاصّة حقّاً

38
00:04:17,400 --> 00:04:19,180
ذلك ما أؤمن به

39
00:04:23,450 --> 00:04:25,860
سعادة الجميع؟

40
00:04:25,860 --> 00:04:27,370
يبدو أنّها كانت أمّاً صالحة

41
00:04:27,960 --> 00:04:32,160
يجد بعض الناس البهجة في مقارنة
تعاسة الآخرين بتعاستهم

42
00:04:32,790 --> 00:04:35,380
لا أحتاج للسهم الأبيض الذي يقتل الناس

43
00:04:35,940 --> 00:04:40,630
وبعدما أستعمل السهم الأحمر لجعل
...عمّي يسلّم نفسه

44
00:04:41,540 --> 00:04:45,190
كلّ ما أريده هي سعادة عاديّة

45
00:04:46,200 --> 00:04:48,390
لا نيّة لي بأن أصبح إلهاً

46
00:04:49,660 --> 00:04:52,900
حسناً، لا بأس إن كان
ذلك ما تريده

47
00:04:53,600 --> 00:04:56,200
لنذهب لجعل عمّك يسلّم
نفسه الآن إذاً

48
00:04:56,200 --> 00:04:58,990
لن يكون عليك القليل
بشأن المال بعدها

49
00:04:58,990 --> 00:05:00,970
لكن تأخّر الوقت اليوم

50
00:05:00,970 --> 00:05:03,630
موعد التسليم النهائيّ الثاني
للتقديم على الثانويّة هو في الغد

51
00:05:03,630 --> 00:05:05,410
يمكننا الذهاب بعدها

52
00:05:06,000 --> 00:05:07,180
حقّاً؟

53
00:05:09,040 --> 00:05:11,480
توضّح أنّ الكوميديّ رودريغيز تونما-سان

54
00:05:11,480 --> 00:05:13,780
في علاقة عاطفيّة مع المزيد من النساء

55
00:05:13,780 --> 00:05:15,900
،علاوةً على الثلاثة المذكورات بالأمس

56
00:05:15,900 --> 00:05:20,000
انجلى الآن أنّه في علاقة مع امرأتين
أخريتين، مما يجعل المجموع خمساً

57
00:05:20,000 --> 00:05:24,300
هذا ما علّق به رودريغيز تونما-سان بعد
إجراء مقابلةٍ معه

58
00:05:23,250 --> 00:05:25,480
...ناسّي، أليس ذلك

59
00:05:24,300 --> 00:05:26,350
تواعد خمس فتيات في الآن ذاته؟

60
00:05:26,330 --> 00:05:30,040
أجل، يبدو أنّي أصبحت جذّاباً
جدّاً للنساء فجأةً

61
00:05:29,130 --> 00:05:30,040
ملاك؟

62
00:05:30,040 --> 00:05:33,090
أنوي عيش حياتي كمشهور
خاطف للقلوب من الآن فصاعداً

63
00:05:31,230 --> 00:05:33,530
لا يمكن للناس رؤيته في العادة، صحيح؟

64
00:05:33,530 --> 00:05:34,440
أجل

65
00:05:33,850 --> 00:05:39,500
،آخر عشيقاته هما لاعبة الغو مي يامادا
والعارضة موموكو كانيساوا

66
00:05:34,440 --> 00:05:37,650
إنّه يتبع هذا الكوميديّ بكلّ وضوح

67
00:05:38,600 --> 00:05:41,770
لا بدّ أنّ رودريغيز تونما هذا مرشّح إله

68
00:05:39,500 --> 00:05:43,130
تمكّنا من الحصول على تعليق من الآنسة
كانيساوا وسؤالها مباشرةً

69
00:05:42,140 --> 00:05:44,320
أحد الثلاثة عشر

70
00:05:43,130 --> 00:05:44,740
أصحيحٌ أنّكِ تواعدينه؟

71
00:05:44,740 --> 00:05:45,570
أجل

72
00:05:45,950 --> 00:05:48,580
إنّه يحبّني الأكثر

73
00:05:48,580 --> 00:05:51,460
كما سمعت. ما رأيك؟

74
00:05:49,390 --> 00:05:51,450
هل يستعمل السهم الأحمر؟

75
00:05:51,450 --> 00:05:55,220
بالتأكيد. يمكن أن يُستعمل السهم الأحمر
على حتّى 14 شخصاً في الآن ذاته

76
00:05:51,460 --> 00:05:54,810
يواعد خمس فتيات علناً؟
إنّه لا يعرف الحياء

77
00:05:54,810 --> 00:05:56,190
هوّن عليك يا ساتو-سان

78
00:05:55,600 --> 00:05:57,800
قالوا أنّه يواعد خمس فتيات

79
00:05:56,190 --> 00:05:58,400
يوجد خطبٌ ما به بوضوح

80
00:05:57,800 --> 00:06:01,140
إن كان ذلك صحيحاً، فلا يزال يستطيع
إصابة تسعة أشخاص إضافيين

81
00:05:58,400 --> 00:06:01,140
:قال التالي أثناء المقابلة أيضاً

82
00:06:01,590 --> 00:06:05,080
أيعني هذا أنّ كلّ نساء
هذا العالم لي الآن؟

83
00:06:05,080 --> 00:06:08,050
!أشعر أنّي أصبحت إلهاً

84
00:06:08,050 --> 00:06:10,220
كانت تلك دعابة

85
00:06:11,830 --> 00:06:14,440
لمَ تقع نساء جميلات في غرام هذا الرجل؟

86
00:06:14,290 --> 00:06:15,850
أهنالك طريقة لإنقاذهنّ؟

87
00:06:14,440 --> 00:06:16,610
أنا خيارٌ أفضل بكثير

88
00:06:17,020 --> 00:06:18,930
،أعتذر على مقاطعة تذمّرك

89
00:06:17,290 --> 00:06:19,740
،أعرف أنّنا نستطيع استعمالها كما نشاء

90
00:06:18,930 --> 00:06:23,240
لكن لنذكّر أنفسنا بمن تربطهنّ علاقة
عاطفية برودريغيز تونما

91
00:06:19,740 --> 00:06:21,610
لكن هنالك حدود

92
00:06:22,000 --> 00:06:25,290
أشعر بالأسى على الفتيات
اللواتي أصابهنّ بالأسهم

93
00:06:23,240 --> 00:06:27,620
قبل الأمس، أعلن أنّه كان
،يواعد الممثلة إيريكو ميناميكاوا

94
00:06:25,640 --> 00:06:27,620
أنت لطيفٌ يا ميراي-كن

95
00:06:27,620 --> 00:06:29,790
،وعارضة الإغراء مويو مايجيما

96
00:06:28,240 --> 00:06:31,280
أهنالك طريقة لحماية نفسك
من الإصابة بالسهم؟

97
00:06:29,790 --> 00:06:32,200
ولاعبة كرة الطائرة يوكي كوتاني

98
00:06:31,280 --> 00:06:32,200
أجل

99
00:06:32,200 --> 00:06:35,540
ألم أخبرك عندما سألتك ما
إن أردت الأجنحة أم الأسهم؟

100
00:06:32,200 --> 00:06:35,910
،أعلن الآن أنّه يواعد لاعبة الغو مي يامادا

101
00:06:35,540 --> 00:06:36,670
كلا

102
00:06:35,910 --> 00:06:38,130
وعارضة الأزياء كانيساوا موموكو

103
00:06:36,670 --> 00:06:38,130
!آسفة

104
00:06:38,730 --> 00:06:42,690
لا تخطئ الأسهم الإصابة، لكن يوجد استثناء لتلك القاعدة

105
00:06:42,690 --> 00:06:45,250
الأجنحة أسرع من الأسهم

106
00:06:45,500 --> 00:06:48,140
إذا هرب شخصٌ بأجنحة، لا تستطيع الأسهم اللحاق به

107
00:06:48,510 --> 00:06:50,780
لذا لا يمكن للناس العاديّين الهرب

108
00:06:51,560 --> 00:06:53,130
لكن لا تقلق

109
00:06:53,130 --> 00:06:57,120
يزول تأثير الأسهم الحمراء بشكل
طبيعيّ بعد 33 يوماً

110
00:06:57,120 --> 00:07:00,640
،لكن إذا أصبت الطرف الآخر مجدّداً
يمكنك مواصلة التحكّم به

111
00:07:00,640 --> 00:07:05,940
،يمكنك الإطلاق على الشخص الواحد مرّةً فقط
وإلّا لن يكون هناك معنى للحدّ الزمني

112
00:07:06,440 --> 00:07:07,510
فهمت

113
00:07:07,810 --> 00:07:09,840
يستعمل رودريغيز-سان قوّة الأسهم لجعل الفتيات

114
00:07:09,840 --> 00:07:13,160
،يقعن في حبّه واحدةً تلو الأخرى
لكن لثلاثةٍ وثلاثين يوماً فقط

115
00:07:13,160 --> 00:07:16,210
هذه طريقةٌ من طرق استعمالها

116
00:07:16,950 --> 00:07:21,310
لن يُختار شخص يستعمل الأسهم مثله
لأن يصبح إلهاً، صحيح؟

117
00:07:40,750 --> 00:07:42,640
هذا رائع

118
00:07:42,640 --> 00:07:46,070
كل هؤلاء الفنّانات النجمات يتوددن
لمنخفض مرتبة مثلي

119
00:07:46,630 --> 00:07:50,150
أرجوك، أعلن علاقتنا أيضاً

120
00:07:50,150 --> 00:07:52,670
!وأنا

121
00:07:52,670 --> 00:07:54,950
!سهم الملاك هو الأروع

122
00:07:54,950 --> 00:07:56,330
!رود-ساما

123
00:07:55,580 --> 00:07:59,680
به، يمكنني جعل أيّ امرأة
!تفعل ما أشاء

124
00:07:59,680 --> 00:08:02,670
!هذا "الأمل للعيش" حرفيّاً

125
00:08:07,600 --> 00:08:08,720
من أنت؟

126
00:08:09,160 --> 00:08:11,410
هذا الزيّ... أتصوّر شيئاً؟

127
00:08:11,410 --> 00:08:13,080
أخطأت في السيّارة

128
00:08:14,350 --> 00:08:15,470
ماذا؟

129
00:08:17,470 --> 00:08:18,970
!من أنت؟

130
00:08:21,370 --> 00:08:22,850
سـ-سهم أبيض؟

131
00:08:39,020 --> 00:08:41,220
لديك سهم أحمر فحسب؟

132
00:08:52,300 --> 00:08:53,930
ما الذي نفعله هنا؟

133
00:08:55,580 --> 00:08:57,050
ما الذي يجري؟

134
00:09:00,270 --> 00:09:01,580
!ما الذي كنت أفعله معه؟

135
00:09:01,580 --> 00:09:03,560
!مسيرتي كفنّانة انتهت

136
00:09:03,560 --> 00:09:07,030
يا إلهي، يا للعذريّ البائس

137
00:09:07,420 --> 00:09:11,740
،حتّى لو كنت بلا شعبيّة
هنالك حدود عليك ألّا تتجاوزها

138
00:09:18,600 --> 00:09:21,910
سأدرس حتّى يوم الامتحان الآن
بما أنّي قدّمت طلبي

139
00:09:21,910 --> 00:09:23,750
ليس عليك فعل ذلك

140
00:09:23,750 --> 00:09:27,020
أصب شخصاً عالي المقام في المدرسة
بسهم أحمر وحسب

141
00:09:27,790 --> 00:09:29,930
أريد الدخول بقدراتي

142
00:09:30,500 --> 00:09:32,450
أنت جادٌّ جدّاً يا ميراي-كن

143
00:09:32,450 --> 00:09:36,450
مع أنّكما الاثنان مرشّحا إله، إلّا أنّك
مختلف تماماً عن ذاك الكوميديّ

144
00:09:44,090 --> 00:09:45,420
ما الخطب؟

145
00:09:46,600 --> 00:09:49,870
3/17 10:36 صباحاً

146
00:09:46,600 --> 00:09:49,870
الكوميديّ رودريغيز تونما
عُثر عليه ميتاً في محطّة تلفاز
ساكورا في اليوم السادس عشر

147
00:09:47,520 --> 00:09:49,860
"سبب الوفاة مجهول حاليّاً"

148
00:09:50,260 --> 00:09:52,480
...أيعني هذا

149
00:10:00,670 --> 00:10:03,360
لُوتا، اُخترت لتكون أحد الثلاثة عشر

150
00:10:03,360 --> 00:10:05,500
هل أُقصيت بالفعل؟

151
00:10:06,410 --> 00:10:08,150
ذلك ما أردتُه

152
00:10:08,150 --> 00:10:10,630
يسرّني أنّي انتهيت سريعاً

153
00:10:10,960 --> 00:10:16,630
بأيّ حال، البشريّ الذي قتله مثيرٌ للاهتمام بحقّ

154
00:10:27,370 --> 00:10:32,380
يبدو أنّهم لا يزالون يجهلون
سبب وفاة رودريغيز

155
00:10:28,560 --> 00:10:30,560
عارضة الأزياء موموكو كانيساوا

156
00:10:28,560 --> 00:10:30,560
الكوميديّ رودريغيز تونما

157
00:10:35,500 --> 00:10:39,460
إ-إذاً... بلاءٌ حسن بالتحاقك بالثانويّة

158
00:10:39,460 --> 00:10:41,200
أنت ذكيّ حقّاً

159
00:10:41,560 --> 00:10:43,200
لست كذلك

160
00:10:43,200 --> 00:10:45,580
كلا، ليس صحيحاً

161
00:10:45,810 --> 00:10:50,340
لم يخطر لي أن تستعمل السهم الأحمر
لجعل عمّك يسلّم نفسه

162
00:10:50,340 --> 00:10:52,710
اشتريت شقّةً بالمال الذي استعدته

163
00:10:52,710 --> 00:10:55,090
وسنتسوّق اليوم لأجل حياتك الجديدة

164
00:10:55,350 --> 00:10:58,090
!أليس ذلك مسليّاً؟ مرحى

165
00:11:03,850 --> 00:11:05,850
...الـ-الحياة التي ذكرتَها

166
00:11:05,850 --> 00:11:10,100
،مكان تنام فيه، طعام تأكله
والذهاب للمدرسة

167
00:11:10,100 --> 00:11:12,210
إنّها تصبح واقعاً رويداً رويداً

168
00:11:12,210 --> 00:11:14,380
أنت تقترب من السعادة العاديّة

169
00:11:14,860 --> 00:11:17,860
الأمور تمضي بشكلٍ ممتاز! أليس ذلك رائعاً؟

170
00:11:20,010 --> 00:11:21,740
أجل، أنتِ محقّة

171
00:11:22,920 --> 00:11:26,870
ربما كنت لأشعر بذاك الشكل
لو لم يمت رودريغيز

172
00:11:28,490 --> 00:11:31,500
كما ظننت، عرفت أنّ ذلك السبب

173
00:11:33,470 --> 00:11:36,420
أنا ممتنٌّ لإنقاذك لحياتي يا ناسّي

174
00:11:37,020 --> 00:11:38,970
،يبدو أنّي سأرتاد الثانويّة

175
00:11:38,970 --> 00:11:42,240
وتمكّني من العيش كما أفعل الآن
بسبب قوى الملاك

176
00:11:43,340 --> 00:11:46,910
لكن هذه القوّة عظيمةٌ جدّاً
بالنسبة لإنسان عاديّ

177
00:11:46,910 --> 00:11:48,520
أمن المقبول لي امتلاكها؟

178
00:11:52,440 --> 00:11:53,840
المزيد من الأنباء
!من ساحة الحدث

179
00:11:53,840 --> 00:11:58,280
مضت ساعة مذ استولى لصوصٌ مسلّحون
على فرع هيتوتسوباشي

180
00:11:58,280 --> 00:11:59,780
لمصرف يوتسوبا طوكيو أوريون

181
00:11:59,780 --> 00:12:04,030
سنقتل رهينةً واحدة كلّ خمس دقائق حتّى"
"نحصل على المال ومروحيّة هروب

182
00:12:04,030 --> 00:12:07,030
كما نصّ تحذيرهم، المجرمون المتحصّنون في المصرف

183
00:12:07,030 --> 00:12:10,980
أطلقوا على ضحيّة أخرى محتجزة
...معهم هناك

184
00:12:11,770 --> 00:12:14,710
!عيار ناري! سمعنا عياراً ناريّاً للتوّ

185
00:12:15,720 --> 00:12:17,020
عمليّة سطو على مصرف؟

186
00:12:17,020 --> 00:12:19,700
ضحايا"؟ أيعني ذلك أنّ اثنان قد قُتلا؟"

187
00:12:21,450 --> 00:12:23,850
،لـ-لقلقهم حيال سلامة الرهائن

188
00:12:23,850 --> 00:12:27,600
تعجز الشرطة عن اتّخاذ حركة حاسمة

189
00:12:29,510 --> 00:12:30,660
ما كان ذلك؟

190
00:12:30,660 --> 00:12:31,680
!من أنت؟

191
00:12:31,920 --> 00:12:33,740
!من أين أتيت؟

192
00:12:33,740 --> 00:12:34,640
!لا تطلقوا

193
00:12:35,030 --> 00:12:36,940
!لستُ خصمكم

194
00:12:38,430 --> 00:12:41,640
!أتيتُ لتطبيق العدالة

195
00:12:42,450 --> 00:12:46,830
ظهر شخصٌ بدرع بدنيّ كامل
من العدم فجأةً

196
00:12:47,660 --> 00:12:48,750
ما خطبه؟

197
00:12:48,750 --> 00:12:52,630
أليس ذلك ميتروبوليمان؟ عُرض سلسله الموسم الفائت

198
00:12:53,130 --> 00:12:54,080
...أهذه

199
00:12:55,220 --> 00:12:56,230
أجنحة؟

200
00:12:56,570 --> 00:12:57,510
ناسّي؟

201
00:12:57,510 --> 00:12:59,570
أجل، إنّه مرشّح إله

202
00:13:00,360 --> 00:13:01,910
أيحاول إقناعهم؟

203
00:13:01,910 --> 00:13:04,730
يبدو أنّه يحاول المفاهمة مع الشرطة

204
00:13:05,100 --> 00:13:06,840
!ماذا؟ طـ-طـ-طار

205
00:13:07,560 --> 00:13:08,820
أهذا تصوير فيلم؟

206
00:13:08,820 --> 00:13:10,310
ما الذي يجري؟

207
00:13:12,700 --> 00:13:14,550
!عليكم أن تصدّقوني

208
00:13:14,550 --> 00:13:17,730
!سأقوم أنا ميتروبوليمان بدحر الشرّ

209
00:13:18,240 --> 00:13:19,740
أصابهم بالأسهم الحمراء

210
00:13:19,740 --> 00:13:21,230
سيصغون له الآن

211
00:13:21,230 --> 00:13:25,510
هذا سخيفٌ قليلاً، لكنّه يستعمل
الأجنحة والأسهم للعدالة

212
00:13:27,070 --> 00:13:29,240
ستدعوني أتكفّل بالأمر؟

213
00:13:29,240 --> 00:13:31,120
!شكراً لكم أيّها الضبّاط

214
00:13:33,610 --> 00:13:35,330
سأذهب إذاً

215
00:13:36,360 --> 00:13:38,500
!أنتم! لمتى ستجعلوننا ننتظر؟

216
00:13:38,500 --> 00:13:43,010
!أيّها الأشرار! ستواجهونني من الآن فصاعداً

217
00:13:43,010 --> 00:13:45,040
ماذا؟ أأنت أحمق؟

218
00:13:45,040 --> 00:13:47,160
!اقترب أكثر وسنطلق عليك

219
00:13:50,440 --> 00:13:52,080
!أنت! أتسمعني؟

220
00:13:52,080 --> 00:13:53,010
!توقّف

221
00:13:55,410 --> 00:13:56,640
...تبّاً لك

222
00:13:58,400 --> 00:13:59,460
!مُت

223
00:14:01,090 --> 00:14:02,070
لا جدوى

224
00:14:02,070 --> 00:14:05,490
يمكنني التحرّك أسرع من الرصاصات

225
00:14:07,700 --> 00:14:08,950
فعلها

226
00:14:10,890 --> 00:14:15,000
أفهمت الآن؟ لستَ ندّاً لي البتّة

227
00:14:15,390 --> 00:14:16,710
من أنت؟

228
00:14:17,020 --> 00:14:18,560
ميتروبوليمان

229
00:14:18,560 --> 00:14:20,650
استسلم وسلّم نفسك

230
00:14:20,650 --> 00:14:21,720
حاضر

231
00:14:28,540 --> 00:14:30,430
أ-أين ذهب؟

232
00:14:32,710 --> 00:14:33,970
...أنت

233
00:14:34,430 --> 00:14:36,210
ماذا؟ لم ينتهِ بعد؟

234
00:14:36,210 --> 00:14:37,930
ألم يطلق للتوّ؟

235
00:14:38,310 --> 00:14:39,940
بسرعة، استعمل السهم الأحمر

236
00:14:40,460 --> 00:14:43,290
!وصل غضبي أوجّه

237
00:14:44,370 --> 00:14:45,690
!اغرب

238
00:14:53,600 --> 00:14:54,960
...ميترو

239
00:14:56,120 --> 00:14:57,440
...بون

240
00:14:58,000 --> 00:15:00,390
!القاتلة

241
00:15:08,940 --> 00:15:11,370
!هيّا، أطلقوا سراح الرهائن

242
00:15:11,720 --> 00:15:13,390
انهار؟

243
00:15:12,410 --> 00:15:13,390
لكن لمَ؟

244
00:15:13,670 --> 00:15:14,880
هل جهّزت المحطّة هذا؟

245
00:15:14,880 --> 00:15:17,890
لديه أسهم بيضاء، وليس أسهماً حمراء فحسب

246
00:15:19,150 --> 00:15:20,290
!انظروا لهذا

247
00:15:20,290 --> 00:15:23,250
!يتمّ تحرير الرهائن الآن

248
00:15:24,780 --> 00:15:27,240
الـ-المعذرة، من أنت؟

249
00:15:27,540 --> 00:15:28,980
ميتروبوليمان

250
00:15:28,980 --> 00:15:32,230
كانت تلك التقنية هي ضربة
ميتروبون القاتلة

251
00:15:32,230 --> 00:15:37,250
مع ذلك، كنتُ يائساً. حصل الأمر
بسرعة كبيرة ولم أستطع التحكّم بقوّتي

252
00:15:38,220 --> 00:15:41,190
التحكم بقوّته؟ الأسهم البيضاء تقتل الناس

253
00:15:41,580 --> 00:15:43,510
نوى قتلهم من البداية

254
00:15:43,510 --> 00:15:47,510
إذا أمكنه رؤية هدفه، فستصيبه السهام
%بنسبة 100

255
00:15:48,350 --> 00:15:49,760
...أسهم بيضاء

256
00:15:49,760 --> 00:15:52,920
أيتبع مرشّح الإله هذا ملاك ذو رتبة خاصّة أيضاً؟

257
00:15:53,850 --> 00:15:59,190
استغلّ خواص الأسهم واستعرض
بأكبر أداء دراميّ ممكن

258
00:15:59,190 --> 00:16:02,210
أسر قلوب الناس هكذا

259
00:16:03,170 --> 00:16:04,680
نال منّا

260
00:16:05,690 --> 00:16:09,100
يا أهل الأرض، أنا ميتروبوليمان

261
00:16:09,440 --> 00:16:13,030
،هدفي هو الحفاظ على سلام الأرض بالطبع

262
00:16:13,030 --> 00:16:18,160
،لكنّي مرسولٌ من السماء أيضاً
وأتيتُ لهزيمة 12 عدوّاً

263
00:16:19,290 --> 00:16:21,790
...ماذا؟ ما الذي تقوله

264
00:16:22,200 --> 00:16:24,290
هزمتُ واحداً سلفاً

265
00:16:24,600 --> 00:16:27,270
لن أهرب أو أختبئ

266
00:16:27,270 --> 00:16:29,170
:للأحد عشر المتبقّين

267
00:16:29,990 --> 00:16:32,050
!تعالوا ونالوا منّي بأيّ وقت

268
00:16:32,590 --> 00:16:34,930
ما-ما الذي يقوله؟

269
00:16:35,210 --> 00:16:37,000
تبّاً، إنّه مخبول

270
00:16:37,000 --> 00:16:39,300
قال أنّه هزم واحداً سلفاً

271
00:16:39,300 --> 00:16:40,860
هل يتكلّم عن رودريغيز-سان؟

272
00:16:42,030 --> 00:16:43,620
ناسّي، ابتعدي عنّي

273
00:16:43,620 --> 00:16:44,310
ماذا؟

274
00:16:44,310 --> 00:16:45,030
!بسرعة

275
00:16:45,030 --> 00:16:46,240
حـ-حسناً

276
00:16:47,320 --> 00:16:51,490
أكاد أصرّح بأنّي مرشّح إله
إذا كان ملاكي بجواري

277
00:16:51,730 --> 00:16:54,370
لا أعرف أين بقيّة مرشّحي الإله الآخرين

278
00:16:55,050 --> 00:16:58,870
إذا كنتُ سأصبح سعيداً، فلا يمكنني الموت قطعاً

279
00:17:05,700 --> 00:17:07,510
اثنا عشر عدوّاً؟

280
00:17:08,090 --> 00:17:10,790
قصد مرشّحي الإله، أليس كذلك؟

281
00:17:10,790 --> 00:17:12,260
بـ-بلى

282
00:17:12,650 --> 00:17:13,680
ناسّي

283
00:17:14,540 --> 00:17:17,010
افسخي ترشيح الإله منّي

284
00:17:17,200 --> 00:17:18,400
ماذا؟

285
00:17:18,400 --> 00:17:21,020
أنقذتِ حياتي

286
00:17:22,660 --> 00:17:24,140
لا أريد الموت

287
00:17:24,770 --> 00:17:27,880
أريد... أن أكون سعيداً

288
00:17:29,010 --> 00:17:30,100
آسفة

289
00:17:31,950 --> 00:17:36,600
خلع ترشيحك سيقتضي إعادة
أجنحتك وأسهمك أيضاً

290
00:17:36,600 --> 00:17:38,410
لا أحتاجها، سأعيدها

291
00:17:39,070 --> 00:17:40,660
ليست تلك المشكلة

292
00:17:41,210 --> 00:17:44,980
إذا أعدت أجنحتك وأسهمك، ستموت

293
00:17:46,150 --> 00:17:47,290
ماذا؟

294
00:17:47,960 --> 00:17:50,860
،بما أنّي أعطيتك إيّاهما كأملك للعيش

295
00:17:50,860 --> 00:17:54,420
التخلّص منهما يعني التخلّص من حياتك

296
00:17:54,710 --> 00:17:57,820
بوصفٍ آخر، أنت على قيد الحياة الآن

297
00:17:57,820 --> 00:18:00,850
لأنّك قبلتهما كمرشّح إله

298
00:18:02,590 --> 00:18:04,060
فهمت

299
00:18:05,350 --> 00:18:10,690
قال الإله أنّ البشر الذين فقدوا إرادتهم
بالعيش وحدهم يُختارون كمرشّحي إله

300
00:18:11,110 --> 00:18:15,170
أي هم الناس غير الراضون
بحال العالم كما هو الآن

301
00:18:15,170 --> 00:18:17,880
أو من يريدون تغييره بشدّة

302
00:18:18,520 --> 00:18:20,930
لا أبالي بتلك الأمور المعقّدة

303
00:18:21,240 --> 00:18:25,460
ما أردت معرفته هو إمكانيّة
نقض حالتي كمرشّح إله

304
00:18:26,350 --> 00:18:27,380
آسفة

305
00:18:29,450 --> 00:18:32,440
لا... أنا من عليه الاعتذار

306
00:18:35,240 --> 00:18:36,590
...حسناً

307
00:18:37,240 --> 00:18:41,310
تملك الملائكة ذات الرتبة الخاصّة أجنحةً
وأسهم حمراء وأسهم بيضاء إذاً

308
00:18:41,310 --> 00:18:43,460
بينما تملك ملائكة الرتبة الأولى
...أسهماً حمراء فحسب

309
00:18:43,460 --> 00:18:44,350
كلا

310
00:18:44,680 --> 00:18:46,220
،أنت محقٌّ بشأن ملائكة الرتبة الخاصّة

311
00:18:46,220 --> 00:18:48,390
لكن يملك ملائكة الرتبة الأولى
أجنحةً وأسهم حمراء

312
00:18:48,390 --> 00:18:51,710
تملك ملائكة الرتبة الثانية أجنحةً
أو أسهم حمراء فحسب

313
00:18:52,050 --> 00:18:53,090
فهمت

314
00:18:53,090 --> 00:18:56,350
بين الثلاثة عشر ملاكاً إذاً، كم عدد
الملائكة ذات الرتب الخاصّة؟

315
00:18:57,010 --> 00:18:58,990
ثلاثة على الأرجح

316
00:18:58,990 --> 00:19:02,420
لكن تترقّى ملائكة الرتبة الأولى أحياناً

317
00:19:02,420 --> 00:19:04,060
ويمكن أن تُخفّض ذات الرتبة الخاصّة أيضاً

318
00:19:04,060 --> 00:19:06,740
وتُخفّض ذات الرتبة الأولى
إلى الرتبة الثانية كذلك

319
00:19:07,810 --> 00:19:12,070
أيّاً يكن، أكبر إزعاج لميتروبوليمان هو

320
00:19:12,070 --> 00:19:15,070
مرشّح إله آخر يملك ملاكاً برتبة
خاصّة معه مثله

321
00:19:15,800 --> 00:19:17,020
ماذا أفعل؟

322
00:19:17,020 --> 00:19:19,310
ينوي أن يصبح إلهاً

323
00:19:19,310 --> 00:19:22,110
وسيقتل أيّ من يعترض طريقه بالتأكيد

324
00:19:22,110 --> 00:19:24,160
قتل رودريغيز ذاك سلفاً

325
00:19:24,680 --> 00:19:26,140
ميراي-كن

326
00:19:26,460 --> 00:19:29,150
ربما يجدر بك البقاء في الداخل

327
00:19:30,820 --> 00:19:33,270
ذلك مؤسفٌ بعدما التحقت بالثانويّة

328
00:19:33,990 --> 00:19:36,110
مراسم حفل الدخول ستجري غداً، صحيح؟

329
00:19:36,110 --> 00:19:38,530
أجل، اليوم في الواقع

330
00:19:39,650 --> 00:19:44,110
يعيش الجميع سعياً وراء اكتساب سعادةٍ أكبر

331
00:19:44,110 --> 00:19:46,760
،ما يعني، مهما كان الوضع

332
00:19:46,760 --> 00:19:50,540
عليّ سلك أيّ اتّجاه
رأيتُ أنّه الأفضل

333
00:19:50,540 --> 00:19:51,920
ميراي-كن؟

334
00:19:51,920 --> 00:19:53,720
...الخيار الأفضل

335
00:19:53,720 --> 00:19:57,680
هل سأعيش خائفاً منه وأبقى
مُحتجزاً هنا لبقيّة حياتي؟

336
00:19:58,310 --> 00:20:02,550
لمَ أنقذتني ناسّي بالأصل؟ ولمَ أعيش الآن؟

337
00:20:07,130 --> 00:20:09,430
سأذهب للثانويّة

338
00:20:10,800 --> 00:20:16,030
لا أستطيع إيجاد السعادة إذا
بقيتُ محتجزاً في الداخل

339
00:20:16,030 --> 00:20:17,910
...صـ-صحيح، لكن

340
00:20:17,910 --> 00:20:18,960
لا تقلقي

341
00:20:19,510 --> 00:20:22,450
طالما لا تكونين معي، لن يعرف
أنّي مرشّح إله

342
00:20:23,110 --> 00:20:28,530
لا أريد أن يسلب منّي ميتروبوليمان
حقّي بالحصول على السعادة

343
00:20:29,530 --> 00:20:31,710
مراسم حفل الدخول غداً إذاً؟

344
00:20:31,710 --> 00:20:35,090
من الرائع أنّي طالب ثانويّة
طبيعيّ عادةً

345
00:20:36,060 --> 00:20:39,980
بعدما أقتل الأحد عشر المتبقّين، سأصبح
إلهاً بشكل آليّ

346
00:20:41,150 --> 00:20:44,220
ميراي-كن، يبدو زيّك جميلاً عليك

347
00:20:44,480 --> 00:20:46,210
حقّاً؟

348
00:20:46,620 --> 00:20:47,570
أجل

349
00:20:47,570 --> 00:20:52,110
عندما رأيتُك فيه، شعرتُ أيضاً أنّ
عليك الذهاب للثانويّة

350
00:20:52,790 --> 00:20:53,780
...ناسّي

351
00:20:53,780 --> 00:20:55,730
استدعني متى حصل شيء، اتّفقنا؟

352
00:20:56,160 --> 00:20:59,020
سأحلّق نحوك مباشرةً
مهما خفض صوتك

353
00:20:59,020 --> 00:21:00,260
فهمت

354
00:21:00,260 --> 00:21:02,650
وأيضاً، عندما تصل المدرسة

355
00:21:03,180 --> 00:21:05,620
أصب ساكي-تشان بسهمك الأحمر

356
00:21:05,620 --> 00:21:06,320
ماذا؟

357
00:21:06,320 --> 00:21:08,680
أقصد صديقة طفولتك، هاناكاغو ساكي-سان

358
00:21:08,680 --> 00:21:11,400
أليست سبب اختيارك لهذه الثانويّة؟

359
00:21:11,400 --> 00:21:12,980
...مـ-مهلك... أنت

360
00:21:12,980 --> 00:21:17,880
،السهم الأحمر فعّالٌ لثلاثة وثلاثين يوماً
ويمكنك الإطلاق على المرء مرّةً واحدة فحسب

361
00:21:18,390 --> 00:21:21,430
لكن إذا أردتما أن تبقيا
،تحبّان بعضكما للأبد

362
00:21:21,430 --> 00:21:25,380
فعليك أن تجعلها تحبّك بحقّ خلال
الثلاثة وثلاثين يوماً تلك

363
00:21:25,910 --> 00:21:29,890
إنّه سهم كيوبيد، سيساعدكما في الواقع
في حبّ بعضكما

364
00:21:32,910 --> 00:21:36,020
لن أستعمل سهماً لذلك

365
00:21:47,570 --> 00:21:51,150
طالب ثانويّة عاديّ، بداية جديدة

366
00:21:51,760 --> 00:21:53,440
ستبدأ أعوامي الثلاثة المقبلة الآن

367
00:22:03,770 --> 00:22:05,260
...ملاك

368
00:22:06,220 --> 00:22:08,810
أهو يخصّ ميتروبوليمان؟

369
00:22:09,370 --> 00:22:12,140
اهدأ، لستُ مع ناسّي

370
00:22:12,140 --> 00:22:14,060
لن يعرف أنّي مرشّح إله

371
00:22:15,810 --> 00:22:18,440
عليّ التصرّف بشكلٍ طبيعيّ وحسب بينما أتجاوزه