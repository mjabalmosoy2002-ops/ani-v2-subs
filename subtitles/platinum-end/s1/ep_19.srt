1
00:00:00,350 --> 00:00:06,000
(البرنامج التالي موجّه للجمهور البالغ فقط)+

2
00:00:00,890 --> 00:00:06,970
لا تقم بشيء يعرقل حركة
مرشّحي الإله من فضلك

3
00:00:06,970 --> 00:00:11,840
قرّرتُ القبض عليهم للحفاظ
على أمن الناس

4
00:00:11,840 --> 00:00:15,660
،أُرسلت المروحيّات للقبض عليهم
وليس لمهاجمتهم

5
00:00:16,340 --> 00:00:20,170
لا تخبرني يا سينسي أنّك تؤمن
بهراء اختيار الإله هذا؟

6
00:00:21,010 --> 00:00:25,370
ما يجري الآن هي عمليّة اختيار إله
حقيقيّة يا سيّدي رئيس الوزراء

7
00:00:26,040 --> 00:00:32,570
،وهم لا يخفون أوجههم هذه المرّة
لا نيّة لهم بأذيّة أحد

8
00:00:32,570 --> 00:00:34,650
وتتوقّع منّي التصديق
بناءً على ذلك فقط؟

9
00:00:34,650 --> 00:00:38,540
سأثبت ذلك لك في غضون 24 ساعة

10
00:00:38,540 --> 00:00:40,890
مهاجمتهم غير مقبولة

11
00:00:40,890 --> 00:00:43,360
بل حريٌّ بك حمايتهم

12
00:00:48,400 --> 00:00:52,560
ماذا؟ رائع! انظروا لهذه المروحيّات
!المحلّقة بجوارنا

13
00:00:53,050 --> 00:00:55,560
سأطلق سهمي الأحمر
على الأشخاص بداخلها

14
00:00:55,560 --> 00:00:57,000
انتظر يا سوسومو-كن

15
00:00:59,800 --> 00:01:01,040
صحيح

16
00:01:01,900 --> 00:01:05,440
لننفصل ونتوجه للمواقع من
بي" حتّى "إف" كما اتّفقنا"

17
00:01:05,440 --> 00:01:06,320
حسناً

18
00:01:06,320 --> 00:01:07,280
فهمت

19
00:01:07,280 --> 00:01:09,480
اختفت الأهداف

20
00:01:53,960 --> 00:01:55,870
إنّهم يرجعون؟

21
00:01:59,650 --> 00:02:01,030
يوميكي-سان؟

22
00:02:02,170 --> 00:02:05,830
أمر رئيس الوزراء سوزوكي
المروحيّات بالانسحاب

23
00:02:05,830 --> 00:02:08,460
ألغوا محاولتهم بالقبض
على مرشّحي الإله

24
00:02:10,120 --> 00:02:11,630
لمَ التغيير المفاجئ؟

25
00:02:26,350 --> 00:02:28,340
فلتستمعوا لنا جميعاً من فضلكم

26
00:02:28,340 --> 00:02:33,470
سنوضّح نحن مرشّحو الإله الخمسة الآن
ما سنفعله في حال أصبح أيّ منّا الإله

27
00:02:34,270 --> 00:02:39,810
قال مرشّح الإله الأخير أنّه لن
يظهر ما لم نفعل هذا

28
00:02:42,690 --> 00:02:44,470
حسناً، لنبدأ إذاً

29
00:04:15,650 --> 00:04:18,210
لحظة، أليس هذا كاكيهاشي؟

30
00:04:18,210 --> 00:04:19,740
!وهاناكاغو-سان

31
00:04:19,740 --> 00:04:20,480
مُحال

32
00:04:20,480 --> 00:04:22,080
إنّهما مرشّحا إله؟

33
00:04:22,080 --> 00:04:24,390
!اثنان منهم من فصلنا؟

34
00:04:24,390 --> 00:04:25,980
أكنتِ تعرفين يا مايكو؟

35
00:04:25,980 --> 00:04:27,450
بالطبع لا

36
00:04:30,150 --> 00:04:32,490
ظهر مرشّحو الإله الخمسة
الذين اختفوا من جادة يوراكوتشو

37
00:04:32,490 --> 00:04:34,650
في محطّات تلفازية متفرّقة

38
00:04:34,650 --> 00:04:39,730
سيسرد كلٌّ منهم ما سيفعله
حال أصبح إلهاً

39
00:04:40,130 --> 00:04:45,130
ستراقب اليابان، بل العالم بأسره هذا

40
00:04:46,820 --> 00:04:50,240
...أيمكنني البدء؟ حسناً

41
00:04:50,240 --> 00:04:55,130
في حال أصبحتُ الإله، سأنشئ عالماً
،يمكن فيه لأيّ من أراد الموت فعل ذلك بحرّيةٍ

42
00:04:55,130 --> 00:04:57,850
،وبراحة وفي أيّ وقت
ويلقى الثناء على ذلك

43
00:04:59,310 --> 00:05:00,020
انتحار؟

44
00:05:00,020 --> 00:05:01,530
الثناء؟

45
00:05:00,860 --> 00:05:01,530
ماذا؟

46
00:05:03,260 --> 00:05:04,550
أنا أوافق

47
00:05:05,010 --> 00:05:08,280
سأموت الآن لو يمكنني الموت براحة

48
00:05:08,280 --> 00:05:10,230
ذلك أفضل من التسبّب بمتاعب للآخرين

49
00:05:11,800 --> 00:05:15,240
لهذا الصبيّ أفكارٌ حسنة

50
00:05:18,700 --> 00:05:22,870
عالميّ المثالي هو عالمٌ
لا يتوجّب على الناس فيه العمل

51
00:05:22,870 --> 00:05:26,100
عالمٌ تنعمون فيه بحياةٍ مسلّية ورخيّة

52
00:05:26,100 --> 00:05:28,740
ستقوم الروبوتات وآليّات الذكاء الاصطناعيّ
بكلّ الأعمال مكاننا

53
00:05:28,740 --> 00:05:31,320
عدم الحاجة للعمل فكرةٌ جميلة

54
00:05:31,320 --> 00:05:34,890
لعلّكم تتساءلون: "لكن كيف
"سيجني الناس المال؟

55
00:05:34,890 --> 00:05:37,890
أي كيف لأحدٍ أن يصبح ثريّاً؟

56
00:05:37,890 --> 00:05:40,010
،لا أعرف إجابة ذلك

57
00:05:40,010 --> 00:05:43,360
لذا أريد أن يصبح شخصٌ قادراً
على اكتشاف ذلك الإله

58
00:05:44,130 --> 00:05:45,610
لا تريد أن تصبح إلهاً

59
00:05:45,610 --> 00:05:48,220
أهذا أفضل ما بجعبة مرشّحي الإله؟

60
00:05:48,220 --> 00:05:51,410
أليس هناك من يأخذ
الأمر بمحمل الجدّ؟

61
00:05:51,890 --> 00:05:56,910
اعتقدتُ أنّ العيش في عالمٍ يمكنني
اللهو فيه مع أصدقائي وحسب فكرةٌ جميلة

62
00:05:57,750 --> 00:06:01,780
اعتقدتُ أنّ زوال المدارس التكميليّة
والهواتف سيكون رائعاً

63
00:06:02,110 --> 00:06:06,770
أليس كذلك؟ مجرّد كلمة واحدة خاطئة
على مواقع التواصل ستجعلك هدفاً

64
00:06:06,770 --> 00:06:11,150
،لكن يعتمد الأمر على استعمالك
الهواتف من ضروريّات هذه الأيام

65
00:06:11,150 --> 00:06:13,160
إنّها مريحةٌ جدّاً، لا أريد فقدانها

66
00:06:15,040 --> 00:06:19,180
،جميعهم يتجاذبون مشاكل العالم المعاصر
لكنّ تفكيرهم سطحيّ

67
00:06:19,690 --> 00:06:25,400
السؤال الحقيقيّ هو ما الذي
ستسعى له البشريّة قدماً؟

68
00:06:25,400 --> 00:06:28,670
لكنّي لم أعد أهتمّ بذلك

69
00:06:29,400 --> 00:06:33,170
مجرّد كوني مرشّح إله يمدّني
بحماسٍ كافٍ الآن، ويروقني ذلك

70
00:06:33,170 --> 00:06:36,330
أشعر بالحياة حرفيّاً كلّ يوم

71
00:06:36,750 --> 00:06:39,580
ربما إن كان بإمكان الجميع
،الشعور بهذه الإثارة

72
00:06:39,580 --> 00:06:43,590
فسيمسي العالم أكثر تسليةً مما
...هو عليه الآن بكثير، لذا

73
00:06:43,980 --> 00:06:48,090
أرى أنّ امتلاك الجميع لأسهمٍ
بيضاء سيكون أمراً رائعاً

74
00:06:48,090 --> 00:06:49,000
ماذا؟

75
00:06:49,000 --> 00:06:50,610
أ-أسهم بيضاء؟

76
00:06:50,610 --> 00:06:52,600
أليست التي تقتل الناس؟

77
00:06:52,600 --> 00:06:54,850
هذا جنونيّ

78
00:06:53,610 --> 00:06:54,850
ما خطب هذا الصبيّ؟

79
00:07:01,200 --> 00:07:04,310
آلت الأمور لهذا فجأةً

80
00:07:04,310 --> 00:07:12,350
كنتُ أفكّر... بما سأفعله إن أصبحتُ
الإله، لكنّي لا أملك إجابة

81
00:07:12,930 --> 00:07:19,860
مع ذلك، أتمنّى عالماً يمكن للجميع فيه
الابتسام وعيش مشاعر دافئة

82
00:07:23,530 --> 00:07:25,690
بقي أحمر فحسب

83
00:07:26,370 --> 00:07:29,380
أعتقد أنّ ملاكه خاصّ الرتبة

84
00:07:31,420 --> 00:07:35,030
...إذا أصبحتُ الإله، فأنا

85
00:07:37,160 --> 00:07:38,380
لن أفعل شيئاً

86
00:07:50,260 --> 00:07:54,030
رجع مرشّحو الإله لجادة يوراكوتشو للتوّ

87
00:07:54,640 --> 00:07:56,530
حسناً، تكلّمنا نحن الخمسة

88
00:07:57,610 --> 00:07:59,530
أريد أن ينضمّ شريكك لنقاشنا

89
00:08:01,320 --> 00:08:05,700
فهمت، لديه صدق الشباب المخيف

90
00:08:05,700 --> 00:08:08,040
عليّ ألّا أخون ذلك

91
00:08:08,610 --> 00:08:12,280
لكن هل سأستطيع إقناعهم يا ترى؟

92
00:08:15,150 --> 00:08:16,850
هيّا بنا يا موني

93
00:08:17,920 --> 00:08:20,130
يونيدا سينسي، أين تذهب؟

94
00:08:22,180 --> 00:08:24,560
لجادة يوراكوتشو

95
00:08:24,870 --> 00:08:25,670
ماذا؟

96
00:08:38,470 --> 00:08:41,280
هذا الرجل هو مرشّح الإله الأخير

97
00:08:41,280 --> 00:08:43,450
بـ-بروفسور يونيدا؟

98
00:08:44,360 --> 00:08:47,530
صدقاً؟ ماذا؟ مذهل، إنّه هو حقّاً

99
00:08:47,530 --> 00:08:48,720
ماذا؟ من هو؟

100
00:08:48,720 --> 00:08:51,710
قرأت كلّ كتبك يا بروفسور

101
00:08:52,330 --> 00:08:53,910
ثانية واحدة

102
00:08:55,020 --> 00:08:59,710
في غضون ثانية واحدة، يمكن للضوء
قطع الأرض سبع مرّاتٍ ونصف

103
00:08:59,710 --> 00:09:02,510
هل جرّبتم الأمر؟

104
00:09:02,510 --> 00:09:07,730
أنا فعلت، جرّبتُ كم مرّةً يمكنني
قطع الأرض في غضون ثانية

105
00:09:07,730 --> 00:09:09,970
كم دورةً أتممت برأيكم؟

106
00:09:10,790 --> 00:09:14,970
جرّبوا، ستدركون أنّ الثانية أبديّة

107
00:09:16,880 --> 00:09:18,880
أليس هذا البروفسور يونيدا؟

108
00:09:18,880 --> 00:09:20,260
!ماذا؟ أنت محقّ

109
00:09:20,260 --> 00:09:21,760
أهو مرشّح إله؟

110
00:09:21,760 --> 00:09:23,850
ماذا؟ البروفسور يونيدا؟

111
00:09:24,250 --> 00:09:26,850
إنّه البروفسور يونيدا بالفعل

112
00:09:27,610 --> 00:09:30,830
فائزة بجائزة نوبل وجائزة الشرف الوطنيّة

113
00:09:30,830 --> 00:09:33,320
ويُقال أنّه الرجل الأذكى في العالم

114
00:09:33,320 --> 00:09:37,630
ظهر البروفسور يونيدا غاكو ذاك
كمرشّح إله

115
00:09:38,410 --> 00:09:42,000
صحيح، أنا يونيدا غاكو

116
00:09:42,560 --> 00:09:49,560
أنا مرشّح إله أيضاً، وأعلن أنّ عمليّة
اختيار الإله هذه حقيقيّة

117
00:09:52,460 --> 00:09:55,810
البروفسور بنفسه مرشّح إله؟

118
00:09:55,810 --> 00:09:59,020
هذا ما قصده عندما قال
أنّه سيثبت الأمر إذاً؟

119
00:10:00,210 --> 00:10:01,290
...يونيدا

120
00:10:03,290 --> 00:10:04,880
!مذهل

121
00:10:04,880 --> 00:10:06,980
!البروفسور يونيدا مرشّح إله

122
00:10:06,980 --> 00:10:08,930
فلتجعلوه الإله وحسب

123
00:10:08,930 --> 00:10:10,780
حُسِم الأمر إذاً، البروفسور لها

124
00:10:10,780 --> 00:10:15,560
لن تحاصروني أنتم الخمسة
كهذه الطائرات المسيّرة، أليس كذلك؟

125
00:10:16,320 --> 00:10:18,720
نريد اختيار الإله التالي بالنقاش

126
00:10:18,720 --> 00:10:22,250
أجل، النقاش... ذاك الخيار الأفضل

127
00:10:22,250 --> 00:10:25,680
فهو شيءٌ من مقدرة البشر

128
00:10:25,680 --> 00:10:28,420
لنذهب لمكانٍ نستطيع
الكلام فيه بهدوءٍ إذاً

129
00:10:28,420 --> 00:10:30,320
لا داعي لذلك

130
00:10:30,320 --> 00:10:34,820
أريد أن يفهم العالم ما الذي يجري الآن

131
00:10:35,430 --> 00:10:39,200
ما سأقوله الآن هو
،محض نظريّةٍ لي

132
00:10:39,200 --> 00:10:42,690
،ومع اعتقادي أنّها صحيحة

133
00:10:42,690 --> 00:10:46,090
إلّا أنّي أريد منكم أن تحكموا بأنفسكم
قرار موافقتكم من عدمها

134
00:10:46,090 --> 00:10:49,860
هنالك أمرٌ مهم لا تستوعبونه بدايةً

135
00:10:49,860 --> 00:10:51,820
وربما يمكن القول بأنّكم تُخدعون

136
00:10:51,820 --> 00:10:56,210
بدا أنّ ميتروبوليمان
يفهم على الأقل

137
00:10:56,210 --> 00:10:57,650
نُخدع؟

138
00:10:57,650 --> 00:10:59,340
ما قصدك؟

139
00:10:59,340 --> 00:11:03,950
لم يؤمن ميتروبوليمان بوجود الإله

140
00:11:04,700 --> 00:11:08,960
كما كيف يُعقل أن يصدّق أحد
شيئاً غير معقول كالإله؟

141
00:11:09,950 --> 00:11:11,590
تقصد أنّ الإله غير موجود؟

142
00:11:11,590 --> 00:11:14,570
...إنّه موجودٌ حالياً

143
00:11:15,130 --> 00:11:18,600
لكنّه ليس الإله الذي تخالونه

144
00:11:20,210 --> 00:11:22,600
إنّه إلهٌ مزيّف

145
00:11:38,660 --> 00:11:44,780
أحمر، قلت أنّك لن تفعل شيئاً
إن أصبحتَ إلهاً، لمَ ذلك؟

146
00:11:44,780 --> 00:11:49,330
لأنّه يجب أن يعيش الناس
وفق قدراتهم جميعاً

147
00:11:49,330 --> 00:11:54,070
إذا أصبح أحدنا إلهاً وغيّر حياة
،الناس من مقامه في السماء

148
00:11:54,070 --> 00:11:56,900
فلن يعدو الأمر عن كونه
ديكتاتوريّةً غير مرئيّة

149
00:11:57,160 --> 00:12:00,680
صدقت، لا حاجة لنا بإلهٍ كذلك

150
00:12:00,680 --> 00:12:03,220
هلّا وضّحتما ببساطة أكبر؟

151
00:12:03,220 --> 00:12:05,370
ببساطة أكبر؟

152
00:12:05,370 --> 00:12:08,810
،دعوني أطرح سؤالاً عليكم الخمسة
بل على البشرية جمعاء

153
00:12:08,810 --> 00:12:13,180
من سبق، البشر أم الإله؟

154
00:12:13,180 --> 00:12:14,620
البشر، أليس كذلك؟

155
00:12:14,620 --> 00:12:16,440
خلق الإله البشر

156
00:12:16,440 --> 00:12:17,550
كلا

157
00:12:17,550 --> 00:12:19,090
أليس الإله؟

158
00:12:19,090 --> 00:12:22,750
،فهنالك قصّة عن وجود الإله أوّلاً
ثمّ خلق آدم وحواء

159
00:12:22,750 --> 00:12:25,770
هذه خرافةٌ اختلقها البشر

160
00:12:25,770 --> 00:12:29,220
وُلِد الكون قبل 13.8 مليار عام

161
00:12:29,220 --> 00:12:32,560
ووُلِدت الأرض قبل 4.6 مليار عام

162
00:12:33,040 --> 00:12:36,020
تشكّل الماء في الأرض، وظهرت الكائنات
الحيّة المجهريّة

163
00:12:36,020 --> 00:12:39,750
تطوّرت لسمكٍ وحيوانات برمائيّة وزواحف

164
00:12:39,750 --> 00:12:43,660
وبنهاية المطاف، نتج البشر

165
00:12:44,060 --> 00:12:51,440
صاد البشر وزرعوا محاصيلاً وبدؤوا
الابتهال للسماء ابتغاء طعامٍ أكثر

166
00:12:51,440 --> 00:12:57,080
وصنع البشر الإله ليكون وجهة دعواتهم

167
00:12:58,240 --> 00:13:03,900
كلّ ما سردتُه للآن هي حقائق تاريخيّة
مقبولة أقرب من كونها نظريّةً لي

168
00:13:03,900 --> 00:13:05,360
هل استوعبتموها؟

169
00:13:05,360 --> 00:13:07,290
نحن نفهم

170
00:13:07,290 --> 00:13:09,090
حسناً، نوعاً ما

171
00:13:09,090 --> 00:13:13,370
قلت أنّنا نُخدع، فلتصل لذاك الجزء سريعاً

172
00:13:13,370 --> 00:13:18,110
يجري البشر الآن عمليّات جراحيّة
وتغييرات جينيّة هذه الأيام

173
00:13:18,110 --> 00:13:20,710
وهي أشياء اُعتبرت انتهاكات في الماضي

174
00:13:20,710 --> 00:13:22,980
ووصلت مواطئ أقدامنا الفضاء

175
00:13:24,020 --> 00:13:27,490
يستحيل اعتقاد وجود إلهٍ في السماء

176
00:13:28,630 --> 00:13:33,740
ربما لا يصحّ بي إخبار العالم
بأسره أنّ لا وجود للإله

177
00:13:33,740 --> 00:13:40,240
لا يمكنني إنكار أنّ التعاليم المنبثقة من الأديان
والأساطير قد حسّنت البشريّة

178
00:13:40,240 --> 00:13:43,900
وبالنسبة لذوي الإيمان، لا شيء يغيظهم أكثر من هذا

179
00:13:45,140 --> 00:13:47,910
في كتاباتي، أنكر وجود الأشياء

180
00:13:47,910 --> 00:13:52,270
مثل الأرواح والأطياف التي
لا يمكن إثباتها علميّاً

181
00:13:52,270 --> 00:13:56,310
،لكن مُذ أصبحت مرشّح إله
أُلقي إليّ وجود الإله

182
00:13:56,310 --> 00:13:58,160
وتواصلت مع ملائكة

183
00:13:58,160 --> 00:14:03,020
،شككتُ بنظري صراحةً في البداية
لكنّها كانت الحقيقة

184
00:14:04,200 --> 00:14:06,650
وبما أنّها الحقيقة، لا خيار بيدي

185
00:14:06,650 --> 00:14:10,990
،بما أنّ الملائكة تحلّق أمامي
عليّ الاعتراف بوجود الإله

186
00:14:10,990 --> 00:14:17,670
ما يصنعهم لا يعدو عن كونها الطاقة
النابعة من المخيلة البشريّة

187
00:14:17,940 --> 00:14:22,940
طاقةٌ تبتغيهم بشدّةٍ كوجهةٍ لدعواتها

188
00:14:23,240 --> 00:14:29,560
سيفسّر العلم تلك الطاقة
في نهاية المطاف بالإله

189
00:14:29,560 --> 00:14:33,450
وقد أنتجت مخلوقات لعبادتها وتبجيلها

190
00:14:33,820 --> 00:14:38,190
مخلوقات؟ أيقصد الوحوش وشاكلتها؟

191
00:14:38,190 --> 00:14:45,330
إنّه من صنع البشر، إلهٌ مزيّف يجذب
الطاقة ممن يؤمنون بالإله

192
00:14:45,330 --> 00:14:50,130
مع تقلّص عدد البشر الذين يؤمنون
بالإله، تقلّصت طاقته

193
00:14:50,130 --> 00:14:53,420
إنّه على حافّة الزوال كليّاً الآن

194
00:14:54,000 --> 00:14:58,340
لذا خدع الملائكة، وبدأ
بعمليّة اختيار الإله هذه

195
00:14:59,420 --> 00:15:01,520
كيلا يختفي؟

196
00:15:01,520 --> 00:15:02,810
صحيح

197
00:15:03,240 --> 00:15:05,220
مضى كلّ شيءٍ وفقاً لخطته

198
00:15:05,220 --> 00:15:08,720
وعمليّة اختيار الإله تُبثّ
في أرجاء العالم الآن

199
00:15:08,720 --> 00:15:14,860
وبعدما يصبح مرشّحٌ إلهاً، سيؤمن المزيد
بوجود الإله من جديد

200
00:15:14,860 --> 00:15:20,620
ما أرمي له هو أنّ عصر
الدعاء للإله قد انتهى

201
00:15:22,630 --> 00:15:27,120
،"علينا طلب النجدة من "أحدهم
وليس "يا ربّ" عند الحاجة

202
00:15:27,120 --> 00:15:33,180
عندما نواجه مشاكلاً، علينا التفكير
بحلولٍ فوريّاً بدل الدعاء

203
00:15:33,180 --> 00:15:35,460
،بدل التكفير وطلب الغفران من الإله

204
00:15:35,460 --> 00:15:38,330
علينا تسليم أنفسنا وتحمّل عواقب ذنوبنا

205
00:15:38,330 --> 00:15:44,540
ستتجاوز المعرفة البشريّة والعلم
والطبّ كلّ الأزمات

206
00:15:44,540 --> 00:15:48,070
في المستقبل القريب، ستجعل من
الخلود نفسه إمكانيّةً بالتأكيد

207
00:15:48,670 --> 00:15:51,690
ما المهم للبشر هو المستقبل

208
00:15:51,690 --> 00:15:54,610
والتفكير المستمر فيما
يجب أن يُفعل حالياً

209
00:15:54,610 --> 00:15:58,780
،لذا علينا أن نقول: "لا وجود للإله
"لم نعد بحاجةٍ لواحد

210
00:15:58,780 --> 00:16:01,190
لنجعل عمليّة الاختيار هذه هي بداية ذلك

211
00:16:01,190 --> 00:16:05,510
لنجعله سبب اختيارنا
لنكون مرشّحي إله

212
00:16:05,510 --> 00:16:09,120
لم يعد هذا العالم بحاجةٍ لإله

213
00:16:10,690 --> 00:16:12,650
لا وجود للإله؟

214
00:16:18,150 --> 00:16:19,590
المسافة: 200 متر

215
00:16:20,020 --> 00:16:22,290
لا يبدو أنّ الهدف يتحرّك

216
00:16:22,290 --> 00:16:24,390
يمكنني أن أصيبه حتميّاً

217
00:16:24,390 --> 00:16:27,670
انتظر، أوامرنا هي أن نطلق
على الستّة في الآن ذاته

218
00:16:27,670 --> 00:16:30,600
لا نملك فكرةً كاملة
عن قدراتهم بعد

219
00:16:30,600 --> 00:16:32,270
لا تزيحوا بأنظاركم عنهم

220
00:16:32,270 --> 00:16:40,850
عُلِم

221
00:16:42,280 --> 00:16:46,320
لدينا الإله الذي تشكّل من دعوات البشر

222
00:16:46,320 --> 00:16:50,020
والملائكة الذين يُستغلّون من قِبل
إلهٍ خارت قواه وحسب

223
00:16:50,020 --> 00:16:54,460
يسعى موني لدمار هذه السماء
الزائفة التي لا تنتج شيئاً

224
00:16:55,040 --> 00:16:56,690
دمار السماء؟

225
00:16:56,690 --> 00:17:00,180
...دعوات البشر والملائكة المُستغلّون

226
00:17:00,180 --> 00:17:01,700
هذه فكرةٌ مثيرةٌ للاهتمام

227
00:17:02,370 --> 00:17:04,120
ما الخطب يا ريفيل؟

228
00:17:04,120 --> 00:17:09,330
من الصحيح أنّ "أصل السماء" يذكر
أنّ دعوةً بشريّة تساند الإله

229
00:17:09,730 --> 00:17:13,310
يُفترض أن يعي كلّ ملاك خاصّ الرتبة ذلك

230
00:17:13,310 --> 00:17:16,730
التصرّف البريء دون التعلّق بالتفاصيل

231
00:17:16,730 --> 00:17:19,030
هو ما يجعل ناسّي خاصّة الرتبة

232
00:17:19,030 --> 00:17:23,160
،لكن لا فائدة لذلك في هكذا ألعاب
فلا يمكنك التخطيط

233
00:17:23,160 --> 00:17:26,440
تجعلاني أبدو كحمقاء نوعاً ما

234
00:17:28,560 --> 00:17:32,360
موني، أفهم هدفك

235
00:17:32,360 --> 00:17:37,220
لكن قد يكون هناك من الملائكة
الاثنيّ عشر من سيعارضك

236
00:17:38,010 --> 00:17:40,690
ما قوّة ذاك الملاك الخاصّة؟

237
00:17:41,650 --> 00:17:44,640
"كانت إجابة موني بالتمتمة، أي "لا أعرف

238
00:17:45,440 --> 00:17:48,380
أهي الملاك خاصّة الرتبة التي
يبدو أنّها لا تعرف شيئاً

239
00:17:48,380 --> 00:17:51,880
أم ملاك آخر يعرف أسرار السماء؟

240
00:17:52,450 --> 00:17:54,500
...أيّاً يكن

241
00:17:54,500 --> 00:17:55,650
أنت محقّ

242
00:17:55,920 --> 00:17:59,920
أرى أنّه من الغرابة
اختيار إلهٍ من بين البشر

243
00:17:59,920 --> 00:18:05,370
لكن أرى أنّ من التمادي إنكار وجود
الإله كما قال البروفسور يونيدا

244
00:18:05,370 --> 00:18:11,260
أليس كذلك؟ الإله الناتج من دعوات
البشر يبقى حقيقيّاً، صحيح؟

245
00:18:11,260 --> 00:18:14,040
كما يوجد مختلف الآلهة حول العالم

246
00:18:14,900 --> 00:18:18,040
أرى أنّنا نحتاج إلهاً

247
00:18:18,040 --> 00:18:19,500
صحيح؟

248
00:18:19,500 --> 00:18:22,360
نحتاجه، لكن لا أظنّه موجوداً

249
00:18:22,360 --> 00:18:24,550
ماذا؟ أيّهما؟

250
00:18:24,550 --> 00:18:28,730
أعتقد أنّه مثل سانتا كلوز

251
00:18:28,730 --> 00:18:34,590
نؤمن به في طفولتنا، لكنّنا ندرك تدريجياً
أنّه من اختلاق البشر مع بلوغنا

252
00:18:34,590 --> 00:18:37,720
لكنّ وجود واحدٍ يمدنا بالأمل

253
00:18:37,720 --> 00:18:39,540
الأمر نفسه مع الإله

254
00:18:43,830 --> 00:18:49,000
لكن لا مفعول لذلك، فلا وجود
لإلهٍ يجيب دعواتك

255
00:18:49,000 --> 00:18:50,870
لا يجب أن يوجد

256
00:18:50,870 --> 00:18:56,130
أعتقد أنّه يكفي أن نحتفظ جميعنا
بـ "إلهٍ" في قلوبنا

257
00:18:56,130 --> 00:19:01,940
،لذا إذا لم يصبح أيٌّ منّا إلهاً
فلن أمانع ذلك

258
00:19:02,540 --> 00:19:03,590
ساكي-تشان

259
00:19:05,160 --> 00:19:11,140
،حسناً، لم أؤمن بالإله في الأصل
،وبعد سماع نظريّة البروفسور يونيدا

260
00:19:11,140 --> 00:19:14,460
أرجّح أنّ معظم الناس لا يؤمنون
بوجوده أيضاً

261
00:19:18,490 --> 00:19:21,610
لذا أوافق البروفسور يونيدا

262
00:19:23,160 --> 00:19:27,360
أنت... ألم تغيّر رأيك في موضوع
أن تصبح إلهاً وحسب؟

263
00:19:27,360 --> 00:19:30,120
ليس كذلك، ماذا عنك أنت يا تيماري-سان؟

264
00:19:30,120 --> 00:19:33,620
تحاولين الاحتفاظ بسهمك الأحمر عبر
إجبار أحدهم على أن يصبح إلهاً وحسب

265
00:19:33,620 --> 00:19:40,960
لـ-لكن... أتذكر ما قالته أوغارو؟ يجب أن
يصبح أحد مرشّحي الإله إلهاً

266
00:19:40,960 --> 00:19:45,240
بروفسور، ألا تعرف طريقةً بحيث لا يتوجّب
على أيٍّ منّا أن يصبح إلهاً؟

267
00:19:45,240 --> 00:19:49,370
بالطبع، توصّلت بطريقةٍ كتلك سلفاً

268
00:19:50,260 --> 00:19:53,500
...لا يمكن... أنا

269
00:19:54,230 --> 00:19:57,280
أحتاج لسهمي الأحمر حقّاً

270
00:19:57,280 --> 00:20:00,280
لا يمكنني المواصلة دونه

271
00:20:00,280 --> 00:20:01,820
!أرجوكم

272
00:20:01,820 --> 00:20:05,050
!ليصبح أحدكم الإله! أرجوكم

273
00:20:07,770 --> 00:20:08,890
بروفسور يونيدا

274
00:20:09,410 --> 00:20:12,310
ألا يوجد هناك ناسٌ يؤمنون
،بالإله، ويعتمدون عليه

275
00:20:12,310 --> 00:20:15,880
ويرونه مصدراً للأمل والخلاص؟

276
00:20:16,470 --> 00:20:21,250
بلى، لعلّهم موجودون، لكنّهم لا يعدون
عن كونهم 0.1% من تعداد أهل الأرض

277
00:20:21,250 --> 00:20:25,300
تبقى 0.1% تلك قرابة سبعة ملايين شخص

278
00:20:25,300 --> 00:20:28,910
ماذا سيحلّ بهم إذا
لم يعد هناك إله؟

279
00:20:30,420 --> 00:20:33,110
لن يستطيعوا لوم الإله على تعاستهم

280
00:20:33,110 --> 00:20:35,570
لن يستطيعوا التكفير وطلب غفرانه

281
00:20:35,570 --> 00:20:37,850
لن يغيّر الدعاء إليه شيئاً

282
00:20:37,850 --> 00:20:40,070
لن يمتلكوا ما يعتمدون عليه

283
00:20:40,070 --> 00:20:42,710
لكنّهم لن يمتلكوا قوّة حلّ
مشاكلهم بأنفسهم أيضاً

284
00:20:42,710 --> 00:20:46,560
سيفقدون الأمل في الحياة
بالتأكيد ويقدمون على الانتحار

285
00:20:46,560 --> 00:20:51,700
،بما أنّهم لا يستطيعون مواكبة العصور
فأرى أنّ هذه طبيعة الحال

286
00:20:51,970 --> 00:20:55,430
انتحار؟ طبيعة... الحال؟

287
00:20:58,980 --> 00:21:00,340
...طبيعة الحال

288
00:21:01,570 --> 00:21:02,570
...في تلك الحالة

289
00:21:03,920 --> 00:21:07,210
أنا متأهّبٌ لأصبح إلهاً لمنع ذلك

290
00:21:14,180 --> 00:21:16,150
أتاه تحفيزٌ أخيراً

291
00:21:17,770 --> 00:21:20,560
أأنت متأكّدٌ يا ميراي-كن؟

292
00:21:20,560 --> 00:21:24,460
اعتقدتُ أنّك أردت إيجاد
سعادةٍ اعتياديّةٍ لك

293
00:21:24,460 --> 00:21:27,850
سيصبح أحمر الإله؟ ألم يفت الأوان على ذلك؟

294
00:21:27,850 --> 00:21:29,820
لن يقرّ أحدٌ على ذلك

295
00:21:30,200 --> 00:21:32,100
حسناً، ربما ستفعل تيماري-سان

296
00:21:33,390 --> 00:21:38,550
أنت! بدأت متغطرساً بقول أنّك ستصبح
!إلهاً إن لم يرد أحدٌ ذلك

297
00:21:38,550 --> 00:21:42,380
لا أزال أريد الانتحار، ولا أمانع الموت في أيّ وقت

298
00:21:42,380 --> 00:21:44,940
لكن إذا أصبحتُ إلهاً، سأسبّب متاعباً

299
00:21:44,940 --> 00:21:47,520
لمعظم مساندي البروفسور يونيدا

300
00:21:47,520 --> 00:21:49,270
يكفي من هذا

301
00:21:49,270 --> 00:21:51,490
لا أمانع، سأصبح الإله

302
00:21:59,570 --> 00:22:00,790
سوسومو-كن؟

303
00:22:02,570 --> 00:22:04,560
لدى هذا الشخص بندقيّة

304
00:22:04,560 --> 00:22:07,310
انظروا، يوجد شخصٌ ببندقيّة هنا

305
00:22:07,310 --> 00:22:09,470
كان يصوّب نحونا طوال الوقت

306
00:22:09,760 --> 00:22:10,720
!تبّاً

307
00:22:10,040 --> 00:22:12,380
!مذهل، كأنّه فيلم

308
00:22:10,720 --> 00:22:11,740
!انتظر، لا تطلق

309
00:22:11,740 --> 00:22:14,110
لكن سيستعمل الهدف سهمه علينا غالباً

310
00:22:14,610 --> 00:22:16,850
أيمكنني أن أطلق السهم
الأحمر عليه؟

311
00:22:16,850 --> 00:22:19,280
!كلا! ابتعد من هناك يا سوسومو-كن

312
00:22:19,280 --> 00:22:21,950
اتبعوا الأوامر وصوّبوا على أهدافكم

313
00:22:21,950 --> 00:22:23,350
واصل تصويبك نحو أحمر

314
00:22:23,350 --> 00:22:24,830
أحمر؟

315
00:22:30,610 --> 00:22:32,090
!أطلقوا