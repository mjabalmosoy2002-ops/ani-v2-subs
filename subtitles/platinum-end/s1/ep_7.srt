1
00:00:00,350 --> 00:00:06,000
(البرنامج التالي موجّه للجمهور البالغ فقط)

2
00:00:00,600 --> 00:00:04,490
أخبرني بوليمان-ساما أنّه عند
،ظهور أحد بأجنحة

3
00:00:04,490 --> 00:00:07,500
عليّ البقاء معه، فلا خيار بيدي

4
00:00:09,300 --> 00:00:10,590
هذا سيّئ

5
00:00:16,240 --> 00:00:20,250
!موكايدو-سان

6
00:00:23,750 --> 00:00:25,500
أصدقاً هذا؟

7
00:00:24,420 --> 00:00:25,500
هجوم إرهابيّ؟

8
00:00:27,190 --> 00:00:29,760
ما الذي... حصل؟

9
00:00:30,330 --> 00:00:32,890
ظننتُ أنّه يُفترض
أن يظهر ميتروبوليمان

10
00:00:35,760 --> 00:00:36,720
!موكايدو-سان

11
00:00:44,070 --> 00:00:47,020
!موكايدو-سان

12
00:00:49,440 --> 00:00:52,250
كلا... لا تمت

13
00:00:52,250 --> 00:00:54,280
!لا تمت رجاءً

14
00:00:54,910 --> 00:00:57,390
!لا أريد أن يموت أحدٌ آخر

15
00:01:04,960 --> 00:01:06,080
...إنّه حيّ

16
00:01:07,020 --> 00:01:08,540
نجا موكايدو-سان

17
00:01:08,930 --> 00:01:10,620
أليس هذا رائعاً يا باري؟

18
00:01:10,620 --> 00:01:14,050
أجل، رغم أنّنا عرفنا فوراً

19
00:01:14,900 --> 00:01:17,040
أ-أهذا أنت يا كاكيهاشي-كن؟

20
00:01:17,040 --> 00:01:18,050
أجل

21
00:01:18,660 --> 00:01:22,210
نجوت لأنّي ارتديت هذه البذلة
المقاومة للانفجارات من باب الحيطة

22
00:01:22,210 --> 00:01:26,550
كنتُ ملماً بوجود احتمالٍ طفيف لإقدامه
على هذا، لكن لم يخطر لي تماديه

23
00:01:26,980 --> 00:01:30,450
إنّه متأهّبٌ لاستعمال أكثر من
سهمه الأبيض لقتل الناس

24
00:01:32,640 --> 00:01:34,320
لا بدّ أنّك مسرور

25
00:01:34,770 --> 00:01:39,460
ألم تقل أنّك لم ترد
أن ترى أحداً آخراً يموت؟

26
00:01:40,280 --> 00:01:41,350
بلى

27
00:01:44,700 --> 00:01:47,340
لا بدّ أنّ الفتاة أ
ماتت في الانفجار

28
00:01:47,340 --> 00:01:51,470
أوافقك، لا أريد أن أرى
أحداً يموت أيضاً

29
00:01:53,240 --> 00:01:57,230
لكن لا يمكننا أن نصبح بهذه العاطفيّة

30
00:01:57,520 --> 00:01:59,220
القتال الحقيقيّ يبدأ الآن

31
00:02:00,280 --> 00:02:01,260
أتى

32
00:02:01,560 --> 00:02:03,720
ما هذا الزيّ؟

33
00:02:03,720 --> 00:02:05,480
إنّه رائعٌ حقّاً

34
00:02:06,330 --> 00:02:07,920
سآخذه

35
00:03:40,320 --> 00:03:41,440
...لمَ

36
00:03:42,480 --> 00:03:44,990
لمَ يمكنك قتل الناس بهذه السهولة؟

37
00:03:45,280 --> 00:03:48,260
بسبب هذه الأجنحة والأسهم
التي مُنحت إيّاها غالباً

38
00:03:49,020 --> 00:03:51,320
لمَ أسألك عن ذلك

39
00:03:53,480 --> 00:03:56,770
أقصد ما إن كنت تعتقد
أنّه من المقبول قتل الناس

40
00:03:57,250 --> 00:03:58,500
...كاكيهاشي-كن

41
00:03:58,940 --> 00:04:01,640
أأنت طفلٌ في الابتدائيّة؟

42
00:04:05,800 --> 00:04:08,330
لا يصحّ قتل الناس

43
00:04:08,330 --> 00:04:12,280
لا شيء أثمن من الحياة، أذلك ما تودّ سماعه؟

44
00:04:12,900 --> 00:04:15,790
تعرف أنّ القتل لا يصحّ، فلمَ تقدم عليه؟

45
00:04:16,100 --> 00:04:18,520
حسناً، ربما لأصبح إلهاً؟

46
00:04:18,520 --> 00:04:23,900
،لا بدّ من التضحيات مع ذلك
أنا أحاول تقليصها للحد الأدنى

47
00:04:24,300 --> 00:04:26,780
للحد الأدنى؟

48
00:04:27,390 --> 00:04:30,260
لم يقل أحدٌ أنّ مرشّح الإله
الأخير المتبقّي

49
00:04:30,260 --> 00:04:33,290
بعد انتهائنا من قتل بعضنا
سيصبح إلهاً بشكلٍ آليّ

50
00:04:34,090 --> 00:04:38,560
معك حقّ، هذه عمليّة اتّخاذ
القرار التي اخترتها

51
00:04:38,560 --> 00:04:40,020
قتلتَ الفتاة أ

52
00:04:40,020 --> 00:04:43,800
استغللتها لقتل فتيات متوسطة بريئات
لا علاقة لهنّ

53
00:04:44,080 --> 00:04:48,030
أتدرك شعور فقدان
!فردٍ من العائلة؟

54
00:04:48,030 --> 00:04:50,930
!أتدرك شعور فقدان شخص غالٍ عليك؟

55
00:04:54,580 --> 00:04:55,440
أجل

56
00:04:57,420 --> 00:05:02,120
فقد فقدتُ أكثر فرد عائلة
كان غالياً عليّ

57
00:05:02,670 --> 00:05:06,400
لذا أدرك أشدّ الإدراك، لحدٍّ مؤلم

58
00:05:06,400 --> 00:05:10,140
أدرك الشعور كليّاً، لكن ما في ذلك؟

59
00:05:11,500 --> 00:05:12,620
...لذا

60
00:05:14,150 --> 00:05:16,700
لن نتمكّن من إقناعه

61
00:05:16,960 --> 00:05:19,250
أعرف، لكنّي لا أستطيع قبول هذا

62
00:05:19,250 --> 00:05:23,160
سأجعل هذا آخر يومٍ يموت فيه أحد
بلا داعٍ بسببي إذاً

63
00:05:23,480 --> 00:05:26,400
لن أقتل غير مرشّحي الإله

64
00:05:28,360 --> 00:05:30,030
أيرضيك ذلك؟

65
00:05:30,030 --> 00:05:31,820
نحن أمام البرج الكبير

66
00:05:31,820 --> 00:05:34,810
وصلنا أنّ الفتاة أ كانت أعلاه
عندما وقع الانفجار

67
00:05:34,810 --> 00:05:38,760
يقول المحقّقون أنّه من المحتمل أنّه كان
انفجاراً انتحارياً من الفتاة أ

68
00:05:35,260 --> 00:05:36,390
سيكون الأمر بخير

69
00:05:36,810 --> 00:05:38,760
...لكنّهما ذهبا هناك

70
00:05:38,760 --> 00:05:40,770
إليكم المنظر الجويّ للبرج الكبير

71
00:05:41,070 --> 00:05:42,570
...كان الانفجار الذي وقع

72
00:05:41,470 --> 00:05:42,630
ناسّي؟

73
00:05:42,570 --> 00:05:43,900
!إنّه ميتروبوليمان

74
00:05:44,180 --> 00:05:47,150
انظروا! إنّه ميتروبوليمان الذي
شُوهد لآخر مرّة في مدرّج جينبو

75
00:05:48,280 --> 00:05:49,660
أيمكنك الطيران؟

76
00:05:49,660 --> 00:05:52,650
أجل، أنا مستفيقٌ تماماً
بفضل ما حصل

77
00:05:52,650 --> 00:05:53,660
ذلك رائع

78
00:05:53,660 --> 00:05:57,660
لكن لا نيّة لي بإنهاء الوضع
بمحض الهروب طيراناً

79
00:05:57,910 --> 00:05:59,020
أعرف

80
00:05:59,020 --> 00:06:01,580
أودّ تجنّب تركه يهرب

81
00:06:01,580 --> 00:06:03,300
،لكن ما هو أكثر من ذلك أهميّة

82
00:06:03,790 --> 00:06:07,830
أودّ تجنّب موتنا بيديه
وسرقته لأجنحتنا وأسهمنا

83
00:06:08,080 --> 00:06:11,930
إن فعل ذلك، سيشقّ طريقه بالقوّة
ليصبح الإله حقّاً

84
00:06:12,280 --> 00:06:15,530
علينا فعل أيّ ما يتطلّبه الأمر
لإصابته بسهمٍ أحمر

85
00:06:15,530 --> 00:06:16,600
أجل

86
00:06:17,400 --> 00:06:18,800
...لكن

87
00:06:19,670 --> 00:06:22,720
لمَ لا يغادر المكان؟

88
00:06:22,720 --> 00:06:27,340
،أنا متأكّدٌ أنّه متحرّقٌ لقتل مرشّحي إله
لكنّها مواجهة 2 ضدّ 1

89
00:06:27,340 --> 00:06:29,820
ليس من الصنف الذي يدخل
قتالاً في موضعٍ خاسر

90
00:06:30,640 --> 00:06:34,330
ألديه خطّة؟ أيحيك واحدةً الآن؟

91
00:06:34,700 --> 00:06:37,330
،لا أعلم ما الذي تتهامسان به

92
00:06:37,760 --> 00:06:40,220
لكنّكما ستموتان هنا

93
00:06:40,220 --> 00:06:41,460
!ميزا

94
00:06:43,640 --> 00:06:45,050
احرسي ظهري

95
00:06:46,040 --> 00:06:46,940
حاضرة

96
00:06:48,100 --> 00:06:51,230
إذا أطلق سهمه الأبيض، سنهرب منه طيراناً وحسب

97
00:06:51,230 --> 00:06:53,180
سأرى ما إن كان بإمكاني خداعه

98
00:06:53,560 --> 00:06:54,370
!ناسّي

99
00:06:54,370 --> 00:06:55,460
ماذا؟

100
00:06:55,460 --> 00:06:59,640
أأنتِ متأكّدة أنّ تلك الملاك ميزا هي
ملاك ذات رتبة خاصّة مثلك؟

101
00:06:59,640 --> 00:07:01,400
أجل، صحيح

102
00:07:01,400 --> 00:07:04,480
ناسّي، باري، احرسانا من الوراء أيضاً

103
00:07:04,480 --> 00:07:05,360
حسناً

104
00:07:05,360 --> 00:07:07,100
أسرع وجهّز سهمك الأحمر

105
00:07:07,100 --> 00:07:08,040
حسناً

106
00:07:10,080 --> 00:07:14,140
سيفترض الآن أنّي الوحيد بالسهم الأبيض

107
00:07:15,350 --> 00:07:18,340
توجد ورائي الملاك ذات الرتبة الخاصّة، ناسّي

108
00:07:18,340 --> 00:07:21,160
وأمرتُك بتجهيز سهمك الأحمر يا كاكيهاشي-كن

109
00:07:21,490 --> 00:07:24,240
من الجليّ الآن من عليه الحذر منه

110
00:07:24,240 --> 00:07:27,220
ستستغلّ ذلك وتصيبه بسهمك الأحمر

111
00:07:27,220 --> 00:07:28,280
فهمت

112
00:07:28,280 --> 00:07:31,180
همسكم كثير

113
00:07:32,100 --> 00:07:34,180
...من سأقتله أوّلاً

114
00:07:39,020 --> 00:07:40,560
هو أنت

115
00:07:41,000 --> 00:07:42,160
كما ظننت

116
00:07:43,790 --> 00:07:46,170
تقتلني؟ كيف؟

117
00:07:46,170 --> 00:07:47,750
هل نتقاتل رجلاً لرجل؟

118
00:07:47,750 --> 00:07:50,820
ماذا؟ لن أقدم على شيءٍ بهذه المجازفة

119
00:07:50,820 --> 00:07:52,570
هذا كلّ ما أحتاجه

120
00:07:52,840 --> 00:07:56,840
شفرة التفجير: إي إن جي إي آر

121
00:07:58,440 --> 00:08:01,210
زرعتُ قنبلةً في مكانٍ آخر

122
00:08:02,520 --> 00:08:04,990
،حتّى لو تركتُ الفتاة أ أعلى البرج

123
00:08:04,990 --> 00:08:08,760
لن يكون هنالك أيّ معنى إذا
لم يأت مرشّح إلهٍ لها

124
00:08:08,760 --> 00:08:14,110
زرعتُ القنبلة كي تهدّد الفتاة أ بتفجير
بنايةٍ إذا لم يظهر أحد

125
00:08:14,450 --> 00:08:18,720
فعّالةٌ كثيرا ضدّ مرهفي القلوب الذين
يرون الحاجة لإنقاذ الآخرين، ألا توافقوني؟

126
00:08:19,500 --> 00:08:21,730
إنّها إحدى البنايات المرئيّة لكم من هنا

127
00:08:23,240 --> 00:08:26,100
،وإذا انفجرت... حسناً، فيما أقلّه

128
00:08:26,100 --> 00:08:29,980
أرواح الأشخاص الثمينة داخل
تلك البناية ستُزهق

129
00:08:30,270 --> 00:08:35,260
إمّا تموتان، أو يموت الكثير من الناس
ممن لا تربطهم علاقة بصراعنا

130
00:08:35,260 --> 00:08:36,620
أيّهما تريدان؟

131
00:08:38,010 --> 00:08:39,250
تكذب

132
00:08:39,860 --> 00:08:42,250
!هذه مجرّد حيلة خطرت لك للتوّ

133
00:08:42,250 --> 00:08:43,760
أجل، إنّه يكذب

134
00:08:43,940 --> 00:08:46,320
إذا قالت ناسّي ذلك، فلا بد أنّها كذبة؟

135
00:08:46,320 --> 00:08:50,990
،تلك الملاك تبرع في كشف الكذبات بالفعل

136
00:08:50,990 --> 00:08:54,270
لكن تتطلّب تلك المهارة
النظر لملامح المرء

137
00:08:54,500 --> 00:08:57,510
الملاك هي من تحتال الآن

138
00:08:58,120 --> 00:08:59,800
حقّاً؟

139
00:08:59,800 --> 00:09:02,640
أي أنّكم لا تهتمّون من يموت

140
00:09:02,850 --> 00:09:04,060
أتعرف؟

141
00:09:04,060 --> 00:09:07,840
لم أكن لأضغط مفتاح التفعيل هذا
لو أنّك لقيت حتفك في الانفجار وحسب

142
00:09:07,840 --> 00:09:10,150
أيّاً يكن، سيموت ناسٌ بسببك

143
00:09:10,540 --> 00:09:12,150
فلتتذكّر

144
00:09:12,590 --> 00:09:16,150
حسناً، سأضغطه

145
00:09:16,150 --> 00:09:16,820
!مهلك

146
00:09:18,810 --> 00:09:20,910
فهمت، لا تفعل

147
00:09:21,170 --> 00:09:22,560
موكايدو-سان؟

148
00:09:22,860 --> 00:09:26,250
لكن واحد منّا سيموت فقط

149
00:09:27,540 --> 00:09:32,240
نويتَ قتل مرشّح إله واحد فحسب
بالانفجار السابق

150
00:09:32,240 --> 00:09:36,720
أي يُفترض أنّ زوال مرشّح إله واحد
هنا سيكفيك، أليس كذلك؟

151
00:09:39,200 --> 00:09:40,810
حسناً

152
00:09:41,740 --> 00:09:45,500
لكنّي أختار من يموت

153
00:09:45,920 --> 00:09:49,360
وآخذ أجنحته وأسهمه الباقية

154
00:09:49,360 --> 00:09:50,820
هذه شروطي

155
00:09:54,480 --> 00:09:56,030
هنا ديماكاوا

156
00:09:56,030 --> 00:09:59,870
هذا ظهور ميتروبوليمان الأوّل مذ حادثة
...مدرّج جينبو، أتربطه

157
00:09:59,870 --> 00:10:02,750
!صلةٌ بانفجار البرج الكبير؟

158
00:10:01,690 --> 00:10:04,360
...كاكيهاشي-كن... موكايدو-سان

159
00:10:09,340 --> 00:10:12,750
رائع، لا بأس بالإعدام العلنيّ

160
00:10:13,580 --> 00:10:16,260
أظنّك من سأقتله بالفعل

161
00:10:17,330 --> 00:10:20,860
لا عجب، ستقتل خاصّ الرتبة أوّلاً بالطبع

162
00:10:21,830 --> 00:10:26,640
كلا، لا علاقة لذلك. السبب لأنّك ستكون
الناجي الذي سيسبّب صعوبات أكبر لي

163
00:10:26,640 --> 00:10:30,580
هراء، تعرف أنّك تريد سهماً أبيضاً آخراً

164
00:10:30,580 --> 00:10:33,510
أيّاً يكن، أقدّر إفراطك في تقييم قدرتي

165
00:10:33,510 --> 00:10:34,400
كلا

166
00:10:34,670 --> 00:10:36,260
!لا يمكنك أن تموت

167
00:10:36,260 --> 00:10:37,720
أعرف

168
00:10:37,720 --> 00:10:40,490
قد يكون كاذباً بالفعل
كما قالت ناسّي

169
00:10:40,490 --> 00:10:41,530
وماذا لو لم يكن؟

170
00:10:42,380 --> 00:10:44,720
لن أدعه يقتلني ببساطة وحسب

171
00:10:44,720 --> 00:10:47,440
،عندما يطلق سهمه الأبيض

172
00:10:47,440 --> 00:10:49,790
ستصيبه بسهمك الأحمر

173
00:10:50,330 --> 00:10:51,480
...لكن

174
00:10:52,560 --> 00:10:54,860
...حياتي

175
00:11:05,560 --> 00:11:08,560
...على هذا النحو، سيموت موكايدو-سان

176
00:11:08,560 --> 00:11:10,180
سيموت أحد

177
00:11:16,570 --> 00:11:19,570
سأضغط المفتاح لحظة هروبك

178
00:11:20,030 --> 00:11:23,030
أي أنّه إذا لم يكن هناك انفجار، ستكون قد تحايلت

179
00:11:24,520 --> 00:11:26,280
أصبت

180
00:11:50,200 --> 00:11:51,360
!كاكيهاشي-كن

181
00:11:51,360 --> 00:11:52,360
مثير

182
00:11:53,440 --> 00:11:56,980
لا تتأثر الأجنحة والأسهم بالماديّات
،في العالم البشريّ

183
00:11:56,980 --> 00:11:58,980
...لكن إن كانت أداةً لملاكٍ آخر

184
00:11:59,520 --> 00:12:02,850
حتّى أنا لم أكن أعرف
إمكانيّة استعمالها بهذا الشكل

185
00:12:02,850 --> 00:12:04,490
ماذا؟ حتّى أنت؟

186
00:12:04,960 --> 00:12:06,620
لمَ تتدخّل؟

187
00:12:08,400 --> 00:12:10,500
لا تهتمّ إن مات أناس؟

188
00:12:12,080 --> 00:12:13,120
...سوف

189
00:12:13,920 --> 00:12:15,500
...أصيبك

190
00:12:16,280 --> 00:12:19,060
!بسهمٍ أحمر

191
00:12:34,840 --> 00:12:37,730
تندفع لطعني بدل إطلاقه؟ أأنت مغفّل؟

192
00:12:40,110 --> 00:12:43,240
!أنت تزعجني، لذا سأقتلك أوّلاً

193
00:12:44,130 --> 00:12:45,310
!اهرب

194
00:12:59,890 --> 00:13:01,760
مُذهل

195
00:13:04,030 --> 00:13:06,160
لمَ لا تهرب؟

196
00:13:09,780 --> 00:13:12,840
حركات إلهية بالنسبة لشخصٍ
لن يصبح إلهاً

197
00:13:12,840 --> 00:13:14,350
...لمتى تعتقد

198
00:13:15,350 --> 00:13:17,810
بإمكانك التفادي هكذا؟

199
00:13:26,220 --> 00:13:27,420
...أنا

200
00:13:29,060 --> 00:13:30,460
...أنا

201
00:13:32,370 --> 00:13:33,910
...سأصيبك

202
00:13:36,980 --> 00:13:38,580
!بسهمٍ أحمر

203
00:13:41,500 --> 00:13:43,340
!جعلتك تنظر

204
00:13:50,120 --> 00:13:51,180
!كاكيهاشي-كن

205
00:13:52,220 --> 00:13:56,440
ما الذي حلّ به؟ لا أستطيع تصوّر
خروجنا سالمين بهذا الحال

206
00:13:58,800 --> 00:14:01,440
لمتى تنوي مواصلة هذا؟

207
00:14:01,440 --> 00:14:03,190
تبدو سخيفاً

208
00:14:05,380 --> 00:14:07,940
إنّك محقّ، منظره بشع

209
00:14:07,940 --> 00:14:09,320
ليس صحيحاً

210
00:14:10,230 --> 00:14:11,830
إنّه رائعٌ جدّاً

211
00:14:14,330 --> 00:14:17,580
نحن نشاهد ميتروبوليمان يطير
في السماء لفترةٍ الآن

212
00:14:15,290 --> 00:14:19,580
لمَ لا يتفادى هجماته بالطيران؟
لمَ لا يطلق عليه؟

213
00:14:17,580 --> 00:14:22,210
،قرب اثنين... بشريّين ربما
يرتديان دروعاً أو بذل قوّةٍ ما

214
00:14:19,920 --> 00:14:22,210
...على هذا النحو، كاكيهاشي-كن سوف

215
00:14:22,210 --> 00:14:23,740
!يُقتل

216
00:14:41,630 --> 00:14:43,120
ماذا أفعل؟

217
00:14:43,940 --> 00:14:46,690
،لا يمكنه إدارة ظهره لي

218
00:14:46,690 --> 00:14:49,320
لكن لا يمكنه إزاحة ناظريه
عن كاكيهاشي-كن أيضاً

219
00:14:50,360 --> 00:14:54,740
منحتنا استماتة كاكيهاشي-كن هذه
الفرصة الذهبيّة

220
00:14:55,180 --> 00:14:56,770
...في هذه الحالة

221
00:14:57,750 --> 00:14:59,020
...عليّ أن أقوم

222
00:15:00,240 --> 00:15:01,180
!بما أقدر عليه

223
00:15:07,110 --> 00:15:07,880
!وراءك

224
00:15:13,220 --> 00:15:14,350
!سهمك

225
00:15:37,350 --> 00:15:39,280
هرب؟

226
00:15:42,150 --> 00:15:44,380
أكان عليّ استهداف قلبه؟

227
00:15:44,870 --> 00:15:48,640
كلا، كانت بذلته مضادةً للرصاص، فلا فرق

228
00:15:50,700 --> 00:15:51,830
!كاكيهاشي-كن

229
00:15:57,080 --> 00:15:58,590
...رأيت

230
00:16:00,530 --> 00:16:02,190
رأيت وجهه

231
00:16:12,240 --> 00:16:13,310
هيّا بنا

232
00:16:18,210 --> 00:16:20,330
...اختفى ميتروبوليمان في السماء

233
00:16:20,790 --> 00:16:23,420
!اختفى الاثنان الغامضان أيضاً

234
00:16:24,040 --> 00:16:27,280
كما حصل في مدرّج جينبو، يظهر ويختفي ميتروبوليمان

235
00:16:26,100 --> 00:16:28,550
!موكايدو-سان! كاكيهاشي-كن

236
00:16:27,280 --> 00:16:29,160
والبقيّة بلمح البصر بشكلٍ مستمرّ

237
00:16:29,160 --> 00:16:31,830
علاوةً على ذلك، أطلق الشخص المدرّع
فوق ميتروبوليمان

238
00:16:31,140 --> 00:16:32,350
أأنت بخير؟

239
00:16:31,830 --> 00:16:34,750
عدّة طلقات عليه مما يبدو أنّه مسدّس

240
00:16:32,350 --> 00:16:33,620
أ-أجل

241
00:16:34,750 --> 00:16:37,550
كاكيهاشي-كن... أشعر بارتياح

242
00:16:34,750 --> 00:16:43,920
تحطّم قناعه، لكن لم تستطع كاميراتنا
تصوير وجهه لسوء الحظّ

243
00:16:43,920 --> 00:16:45,430
لم أستطع الإطلاق عليه

244
00:16:43,920 --> 00:16:49,020
يبدو أنّهما اشتبكا مع ميتروبوليمان في قتال

245
00:16:46,960 --> 00:16:51,190
ارتبك للحظة عندما أطلقتَ النار عليه

246
00:16:52,270 --> 00:16:55,780
لكنّي لم أستطع... الإطلاق عليه

247
00:17:00,920 --> 00:17:04,780
لا أستطيع إطراءك على
أسلوب قتالك مع ذلك

248
00:17:05,280 --> 00:17:08,200
بقاؤك على قيد الحياة معجزة

249
00:17:08,900 --> 00:17:14,140
أم أنّك كنت تهاجم بتهوّر متعمّداً
كي تسنح لي فرصة الإطلاق عليه؟

250
00:17:15,660 --> 00:17:16,720
كلا

251
00:17:17,100 --> 00:17:21,850
لم أرد الموت وحسب، أردت إصابته بسهمٍ أحمر

252
00:17:23,200 --> 00:17:24,980
لا، ليس صحيحاً

253
00:17:26,780 --> 00:17:28,480
لم أكن أفكّر بشيء

254
00:17:30,130 --> 00:17:32,040
لم أعد أستطيع التفكير

255
00:17:34,560 --> 00:17:36,070
لا يلائمني هذا

256
00:17:38,080 --> 00:17:40,240
لا يلائمني القتال

257
00:17:42,480 --> 00:17:43,750
فات الأوان

258
00:17:44,560 --> 00:17:46,750
لم يسبق وأن دخلت قتالاً

259
00:17:47,820 --> 00:17:53,880
،حتّى عندما آذاني أقاربي بعدما أخذوني
قبلتُ التعنيف وحسب

260
00:17:54,900 --> 00:17:59,010
مهما أخبرني به الجميع في المدرسة
أو سخروا منّي

261
00:18:00,160 --> 00:18:04,020
تظاهرتُ بأنّي لا أسمع، ولم أردّ ولو لمرّة

262
00:18:04,020 --> 00:18:05,390
لم أقاومهم

263
00:18:05,390 --> 00:18:08,980
إذا خلتها قوّةً، فأنت مخطئ

264
00:18:09,760 --> 00:18:11,270
أعرف

265
00:18:12,280 --> 00:18:15,780
ليست قوّةً، بل ضعفاً منّي

266
00:18:17,300 --> 00:18:19,410
أخاف مهاجمة الآخرين

267
00:18:20,220 --> 00:18:22,020
أنا جبان

268
00:18:22,630 --> 00:18:25,610
كلا، لن أصل لذاك الحدّ

269
00:18:25,610 --> 00:18:28,790
أجل، لأنّك لطيفٌ يا ميراي-كن

270
00:18:29,050 --> 00:18:34,420
يتنافس الناس ضدّ بعضهم ويعملون جاهدين
للوصول لما يرونه الوضع المثاليّ لهم

271
00:18:34,820 --> 00:18:39,270
يقود ذلك للسعادة، أعرف الأمر

272
00:18:40,210 --> 00:18:45,100
لكن ما أقوم به الآن مختلفٌ كلّياً

273
00:18:46,400 --> 00:18:51,550
لا أستمد أيّ سعادةٍ من أذيّة
الآخرين أو قتلهم

274
00:18:51,550 --> 00:18:54,820
!لا أفهم كيف يمكن أن تسعد بفعل ذلك

275
00:18:54,820 --> 00:18:59,570
ميتروبوليمان هو من يقتل الناس
ويلجؤ للأساليب العنيفة

276
00:18:59,570 --> 00:19:01,570
نحن من يحاولون إيقافه

277
00:19:01,990 --> 00:19:05,740
ولو قتلناه، لا يمكن اعتباره ضحيّة

278
00:19:05,740 --> 00:19:07,200
...لعلّك محقّ، لكنّي

279
00:19:08,290 --> 00:19:12,010
لم أعد أعرف ماذا أفعله

280
00:19:14,200 --> 00:19:16,940
لمَ... نقوم بهذا؟

281
00:19:18,960 --> 00:19:20,980
لكسب السعادة

282
00:19:24,160 --> 00:19:28,600
أليس كذلك؟ لأجل أن يصبح الجميع سعداء

283
00:19:38,600 --> 00:19:41,000
تلقّيتُ الأجنحة والأسهم من ناسّي

284
00:19:41,000 --> 00:19:44,340
هربتُ من الجحيم، وأنا الآن مع ساكي-تشان

285
00:19:44,340 --> 00:19:46,870
شعرتُ أنّي صعدتُ للجنّة

286
00:19:47,540 --> 00:19:50,370
ظننتُني قد أجد السعادة حقّاً

287
00:19:50,610 --> 00:19:51,870
...لكنّ الواقع

288
00:19:53,180 --> 00:19:54,810
...ما نفعله الآن

289
00:19:56,170 --> 00:19:57,750
هو قتل بعضنا

290
00:19:59,910 --> 00:20:03,260
لمَ لا يدعوني أعيش حياةً طبيعيّة؟

291
00:20:03,260 --> 00:20:06,340
سئمتُ من هذا

292
00:20:07,510 --> 00:20:13,670
أتفهّم مشاعرك، لكن هنالك ما يتوجّب
علينا فعله الآن

293
00:20:14,480 --> 00:20:17,980
أخبرني بما رأيته، وتفاصيل ميتروبوليمان

294
00:20:17,980 --> 00:20:19,650
موكايدو-سان

295
00:20:20,250 --> 00:20:23,640
لا يبدو أنّ كاكيهاشي-كن هدأ بعد

296
00:20:23,640 --> 00:20:26,280
كما أنّي اكتفيتُ لليوم

297
00:20:26,280 --> 00:20:29,240
كنتِ قلقةً كثيراً على ميراي

298
00:20:29,240 --> 00:20:32,070
لم تكن قلوب العالم بأسره لتساعدك
على النجاة

299
00:20:32,070 --> 00:20:34,450
من النوبات القلبيّة التي كادت تلحق بك
من ذاك القتال المميت

300
00:20:35,620 --> 00:20:38,000
فهمت، معكما حقّ

301
00:20:38,420 --> 00:20:40,800
سنكمل غداً

302
00:20:41,400 --> 00:20:46,550
مجرّد رؤية وجهه هذه المرّة
تكفي بالنسبة لي

303
00:20:48,280 --> 00:20:53,900
هل كاكيهاشي-كن... سعيدٌ بتواجده معي حقّاً؟

304
00:20:55,840 --> 00:20:57,940
أجل، سيفي هذا بالغرض

305
00:20:58,480 --> 00:21:03,820
أنت أوّل مريضٍ يأتيني
بخدش رصاصةٍ في رأسه

306
00:21:05,010 --> 00:21:07,630
أُصبت على مدى قريب

307
00:21:07,630 --> 00:21:09,950
جعلتها مقاومةً للرصاص حتّى

308
00:21:09,950 --> 00:21:12,080
لا بدّ أنّ الأمر كان مروعاً

309
00:21:12,870 --> 00:21:15,950
شكراً على تفرّغك لي خارج
أوقات استشارتك يا طبيب

310
00:21:15,950 --> 00:21:17,830
البتّة

311
00:21:18,480 --> 00:21:21,280
...تهديد القنبلة الأخرى

312
00:21:21,280 --> 00:21:24,220
...ووعدي بألّا أقتل غير مرشّحي الإله

313
00:21:24,220 --> 00:21:25,340
كانت كذبات

314
00:21:26,300 --> 00:21:29,760
تبّاً، من أولئك؟

315
00:21:30,740 --> 00:21:31,840
صباح الخير

316
00:21:31,840 --> 00:21:34,640
هل رأيتِ انفجار البرج الكبير بالأمس؟

317
00:21:34,640 --> 00:21:37,550
كان جنونيّاً، أليس كذلك؟ مخيف

318
00:21:40,290 --> 00:21:42,540
انظري، لقد رجع

319
00:21:44,120 --> 00:21:46,160
هناك، المُلاحِق

320
00:21:50,230 --> 00:21:52,250
سأذهب للتفاهم معه

321
00:21:52,250 --> 00:21:53,250
لا داعي

322
00:21:53,250 --> 00:21:54,890
لمَ؟

323
00:21:57,500 --> 00:22:01,280
أشكّ بالأمر، لكن أتواعدين كاكيهاشي؟

324
00:22:02,450 --> 00:22:07,110
هنالك شائعةٌ في الفصل، قال أحدهم
أنّه رآكما معاً

325
00:22:08,440 --> 00:22:10,050
لا نتواعد

326
00:22:10,050 --> 00:22:14,060
كما ظننت، من قد يواعد
كاكيهاشي ميراي بالأصل؟

327
00:22:17,560 --> 00:22:21,610
...كما أنا... وكاكيهاشي-كن

328
00:22:22,270 --> 00:22:23,940
لا أستطيع أن أحبّه