1
00:00:00,000 --> 00:00:04,060
(البرنامج التالي موجّه للجمهور البالغ فقط).0

2
00:00:07,650 --> 00:00:12,610
يجب أن يقتل المرشحّين الأخيرين بعضهما
بالسهم الأبيض خلال 0.15 ثانية

3
00:00:13,210 --> 00:00:18,080
إن اُستوفيت هذه الشروط، لن يُصنع المخلوق

4
00:00:23,700 --> 00:00:25,850
لا أفهم

5
00:00:25,850 --> 00:00:29,990
بافتراض أنّك محقّ، وأنّ من يُختار
،"سيصبح "المخلوق

6
00:00:29,990 --> 00:00:32,130
فما المصيبة في ذلك؟

7
00:00:33,030 --> 00:00:37,640
لأنّ نهاية البشر يجب أن تكون
منوطةً بقرار البشر أنفسهم

8
00:00:37,640 --> 00:00:40,340
نهاية البشر منوطة بقرار البشر؟

9
00:00:40,340 --> 00:00:42,850
لا أفهم ما تعنيه أبداً

10
00:00:42,850 --> 00:00:47,760
قال أوغارو أنّ الإله يمتلك
قوّة إنهاء البشريّة

11
00:00:54,370 --> 00:00:58,070
لكنّ أحمر قال أنّه لن يفعل
شيئاً إذا أصبح إلهاً

12
00:00:59,090 --> 00:01:00,570
هذا تسرّع

13
00:01:00,570 --> 00:01:05,500
لم نتحقّق مما يحلّ بدماغ المرء
"بعدما يصبح "المخلوق

14
00:01:06,170 --> 00:01:09,670
ويبدو أنّه يفتقر لقدرة
إيصال أيّ شيءٍ للبشر

15
00:01:10,180 --> 00:01:13,690
لم يتواصل مع أيٍّ منّا

16
00:01:13,690 --> 00:01:18,670
كلّ ما نعرفه عن "المخلوق" هو أنّه
،في حال لم يأخذ أحدٌ شاكلته

17
00:01:18,670 --> 00:01:21,930
فسيموت الإله الحاليّ الزائف
في غضون 790 يوماً

18
00:01:22,530 --> 00:01:27,940
لكنّ البشريّة لن تلحظ
موت ذاك الإله الزائف

19
00:01:27,940 --> 00:01:31,780
هذه أوّل مرةٍ أسمع فيها بارتباط
الحدّ الزمنيّ ذي الـ 999 يوماً

20
00:01:31,780 --> 00:01:35,320
لعمليّة اختيار الإله
بفترة عمر الإله

21
00:01:35,720 --> 00:01:40,320
من الصحيح أنّ "المخلوق" لا يستطيع
...إيصال إرادته للبشر مباشرةً، لكن

22
00:01:40,690 --> 00:01:43,030
لعلّ موني تخبره بأكاذيب

23
00:01:43,030 --> 00:01:44,040
ماذا؟

24
00:01:47,630 --> 00:01:50,480
لنبدأ بمناقشة كيفيّة انتهاء البشر

25
00:01:50,480 --> 00:01:51,460
انتهاء؟

26
00:01:51,970 --> 00:01:54,170
،لن يحلّ حتّى موت الشمس

27
00:01:54,170 --> 00:01:58,020
أو وقوع كارثة جغرافيّة أو تحوّل
مناخيّ حادّ على سطح الأرض

28
00:01:58,020 --> 00:02:01,850
لكن ستمرّ البشريّة بانقراضٍ
في مستقبلٍ ليس ببعيد

29
00:02:01,850 --> 00:02:07,600
ماذا؟ ماذا عن ادّعائك بأنّنا سنصل
للخلود في المستقبل القريب؟

30
00:02:07,860 --> 00:02:11,050
سنحقّق ذلك خلال 300 عام

31
00:02:11,050 --> 00:02:13,890
إمّا باستبدال كلّ شيءٍ
،عدا أدمغتنا بآلات

32
00:02:13,890 --> 00:02:16,610
أو نقل أدمغتنا لأجسادٍ شابة

33
00:02:16,610 --> 00:02:18,520
هذه من قصص الخيال العلميّ

34
00:02:18,520 --> 00:02:24,620
كلا، قرأتُ أنّ ذلك محتملٌ في المستقبل
القريب وليس محض خيالٍ علميّ

35
00:02:24,970 --> 00:02:29,770
،بعدما تصل البشريّة سرّ الخلود
ما الذي ستبتغيه تالياً؟

36
00:02:29,770 --> 00:02:30,960
أتعرفون؟

37
00:02:33,560 --> 00:02:34,850
إنّه الزمن

38
00:02:34,850 --> 00:02:38,880
تجاوز مفهوم الزمن والتحكّم به

39
00:02:39,460 --> 00:02:42,120
معرفة المستقبل ورؤيته

40
00:02:42,610 --> 00:02:45,420
أي الشكل المُطلق للتنبّؤ

41
00:02:45,420 --> 00:02:47,930
وسنصل له بلا شكّ

42
00:02:47,930 --> 00:02:54,650
لكن بعدما يعرف كلّ بشريّ
...ما يخفيه المستقبل

43
00:02:55,420 --> 00:02:57,650
سيعتريهم اليأس

44
00:03:02,380 --> 00:03:06,810
أفهمتم؟ بعدما يعرف البشر
،مساراتهم المقدّر لها

45
00:03:06,810 --> 00:03:09,540
سيصيبهم إحساسٌ بانعدام المعنى

46
00:03:09,860 --> 00:03:13,270
لن يصبح أمامهم سوى الإذعان لتدفق الزمن

47
00:03:13,270 --> 00:03:15,250
،حتّى لو حاولنا تغيير المستقبل

48
00:03:15,250 --> 00:03:18,800
سعينا ونتيجته مقدّرٌ لهما سلفاً

49
00:03:19,220 --> 00:03:23,550
سيفقد البشر إرادة العيش
وينهون حياتهم بأنفسهم

50
00:03:24,190 --> 00:03:29,560
...وفي النهاية، سييأس البشر
من العيش ببساطة

51
00:03:29,980 --> 00:03:34,020
سندفع ثمناً باهظاً للتقدّم
،العلميّ المفرط

52
00:03:34,020 --> 00:03:37,820
لكن لا يمكن إيقاف روح البشر الفضوليّة

53
00:03:38,060 --> 00:03:43,110
في المستقبل القريب، ستفقد البشريّة
الأمل وتتجه نحو الانقراض

54
00:03:46,080 --> 00:03:51,330
أحمر، أأنت راضٍ بمبدأ
أن تصبح "المخلوق"؟

55
00:03:52,750 --> 00:03:53,830
أجل

56
00:03:57,120 --> 00:04:03,370
في تلك الحالة، ستكون النتيجة إمّا أن
تصبح المخلوق، أو أوقفك

57
00:04:03,370 --> 00:04:07,600
هل لنا أن نتحدّث على انفراد؟

58
00:04:08,730 --> 00:04:09,850
لا أمانع

59
00:04:09,850 --> 00:04:11,450
...إذا كان أحمر موافقاً

60
00:04:11,450 --> 00:04:15,070
يوميكي، خذي الثلاثة الآخرين
...وابقي في وضعيّة التأهّب، اذهبي إلى

61
00:04:15,070 --> 00:04:18,650
ماذا عن منزل الضيوف الذي
كنّا نمكث فيه؟

62
00:04:18,650 --> 00:04:19,290
جيّد

63
00:04:19,890 --> 00:04:21,160
...سيّدي

64
00:04:21,160 --> 00:04:22,740
سأبقى هنا

65
00:04:24,600 --> 00:04:26,690
لن أقول شيئاً بالطبع

66
00:04:27,160 --> 00:04:29,490
أريد رؤية نهاية النقاش فحسب

67
00:06:03,630 --> 00:06:06,660
،انفصل مرشّحو الإله إلى مجموعتين

68
00:06:06,660 --> 00:06:11,290
يبدو أنّ البروفسور يونيدا وكاكيهاشي ميراي-كن
سيجريان نقاشاً فرديّاً

69
00:06:13,560 --> 00:06:20,050
سأسألك مُجدّداً، هل ستصبح
الإله الزائف أم لا؟

70
00:06:20,050 --> 00:06:22,070
لا تزال ناوياً على ذلك؟

71
00:06:22,430 --> 00:06:23,240
أجل

72
00:06:23,240 --> 00:06:25,390
حتّى لو كان زيفاً؟

73
00:06:25,390 --> 00:06:28,580
،حتّى لو كان زيفاً كما تقول

74
00:06:28,580 --> 00:06:32,610
لن يشعر أحدٌ برغبةٍ بالموت
،لأنّني أصبحت الإله وحسب

75
00:06:33,510 --> 00:06:39,590
،لكن ما لم يصبح أحد المرشّحين إلهاً
سيفقد بعض الناس الأمل ويعجزون عن العيش

76
00:06:40,430 --> 00:06:44,350
أريد أن يعيش أكبر عدد ممكن من الناس

77
00:06:44,350 --> 00:06:46,330
أريد لهم السعادة

78
00:06:46,820 --> 00:06:50,670
أن يعيش أكبر عدد ممكن
...ويصبحون سعداء

79
00:06:51,150 --> 00:06:53,160
هذا ما يريده ميراي-كن

80
00:06:54,710 --> 00:06:56,350
السعادة؟

81
00:06:57,090 --> 00:07:00,740
هذا ما سيسعدك كبشريّ، صحيح؟

82
00:07:01,280 --> 00:07:05,080
مع اختلاف أدمغة البشر، ليست السعادة بشيءٍ

83
00:07:05,080 --> 00:07:08,270
يمكن قياسه بقيم الدوبامين والأدرينالين

84
00:07:08,880 --> 00:07:12,090
يعطي ميل المرء للتقدير أو البغض

85
00:07:12,090 --> 00:07:13,990
فرقاً كبيراً أيضاً

86
00:07:15,060 --> 00:07:16,490
...البغض

87
00:07:16,900 --> 00:07:21,330
أسوأ ما قد يُقدم عليه المرء
هو إبغاض شخصٍ آخر

88
00:07:21,330 --> 00:07:23,930
لا خير يُثمر من ذلك أبداً

89
00:07:23,930 --> 00:07:27,770
لا يصحّ لذهنك بالطبع، ولا للبقيّة

90
00:07:30,330 --> 00:07:34,000
في الختام، السعادة أمرٌ تباينيّ

91
00:07:34,000 --> 00:07:37,510
تصله باعتبار الآخرين غير سعيدين

92
00:07:37,960 --> 00:07:39,460
أعي ذلك

93
00:07:39,460 --> 00:07:44,610
لكنّ الوصول للسعادة عبر
إسعاد الآخرين ليس بالأمر السيّئ

94
00:07:46,390 --> 00:07:49,790
كما لن أموت لأنّي أصبحت الإله

95
00:07:51,030 --> 00:07:55,800
طالما أبقى حيّاً، فلن أفقد الأمل
في إيجاد السعادة كبشريّ

96
00:07:56,780 --> 00:08:00,200
لا يمكنني الثقة بمن يتفوّهون
بكلمات كهذه

97
00:08:00,200 --> 00:08:01,750
لا يكترث إلّا لنفسه

98
00:08:01,750 --> 00:08:04,040
لا أمانع طالما نحتفظ بالأمان

99
00:08:04,330 --> 00:08:08,310
لن أشعر بقناعة إن أصبح صبيٌّ
إلهاً ونظر بدنوٍّ لنا

100
00:08:09,580 --> 00:08:14,220
لا تمانع إن أصبح كاكيهاشي-سان الإله
أو لا، صحيح يا سينباي؟

101
00:08:14,220 --> 00:08:16,180
بل أميل لأن يصبح الإله

102
00:08:16,820 --> 00:08:21,250
تأثّرتُ عندما قال أنّه لن يفقد
الأمل بإيجاد السعادة كبشريّ

103
00:08:29,100 --> 00:08:30,820
رجعنا هنا مُجدّداً؟

104
00:08:31,770 --> 00:08:35,870
قلت أنّك تريد أن يعيش
،أكبر عددٍ ممكن من الناس

105
00:08:35,870 --> 00:08:40,980
لكن كي تصبح المخلوق، يجب
أن يموت شخصٌ واحدٌ على الأقل

106
00:08:40,980 --> 00:08:42,840
تعي ذلك؟

107
00:08:43,810 --> 00:08:45,080
أجل

108
00:08:45,080 --> 00:08:51,620
سيتوجّب عليك قتلي، المرشّح الذي لا يوافق
"على أن تصبح "المخلوق

109
00:08:51,620 --> 00:08:54,590
لكن لا أرجّح أنّك تملك
عزيمة فعل ذلك

110
00:08:55,670 --> 00:08:56,760
بل لديّ

111
00:09:09,690 --> 00:09:12,630
!لحظة، أخرج أحمر سهمه الأبيض

112
00:09:12,630 --> 00:09:14,600
لا يصحّ هذا، لنرجع

113
00:09:16,220 --> 00:09:17,940
ما الذي يجري؟

114
00:09:17,940 --> 00:09:20,380
،إذا أطعتم ما أقوله

115
00:09:21,670 --> 00:09:23,120
فلن أقتلكم

116
00:09:23,120 --> 00:09:25,620
أي أنّك خدعتنا؟

117
00:09:27,730 --> 00:09:30,540
حتّى نهاية محادثتهما فقط

118
00:09:30,540 --> 00:09:32,870
"ذلك سعياً لمنع ولادة "المخلوق

119
00:09:34,660 --> 00:09:35,900
...يوميكي-سان

120
00:09:46,320 --> 00:09:47,810
!ماذا؟ لم يخترقه

121
00:09:48,150 --> 00:09:50,780
إذا كنتم ستعارضوني، فلا خيار لي

122
00:09:50,780 --> 00:09:52,080
!اهربي يا يوميكي-سان

123
00:09:54,510 --> 00:09:56,610
لا تُقدموا على شيءٍ من فضلكم

124
00:09:56,610 --> 00:10:00,430
أي أنّ علينا ترك الأمر بعهدة أحمر

125
00:10:02,940 --> 00:10:04,910
أيمكنك الإطلاق عليّ حقّاً؟

126
00:10:04,910 --> 00:10:07,100
إنّها مسألةٌ عدديّة لا أكثر

127
00:10:07,100 --> 00:10:10,090
موت فردٍ أهون من موت الكثير

128
00:10:10,090 --> 00:10:11,830
أنتَ لها يا ميراي-كن

129
00:10:12,170 --> 00:10:17,470
لا ضمان لاستعمالي أجنحتي
لتفادي سهمك

130
00:10:17,850 --> 00:10:19,790
لا عجب أنّ هذا سيحصل

131
00:10:19,790 --> 00:10:21,110
فاجأتني

132
00:10:22,030 --> 00:10:25,110
لم أتصوّر أن تطلق
السهم الأبيض دون تردّد

133
00:10:25,810 --> 00:10:28,700
ربما لأنّي أصغيتُ لما قلتَه

134
00:10:28,700 --> 00:10:31,720
كانت له قيمةٌ إذاً

135
00:10:32,240 --> 00:10:34,320
هنالك سؤالٌ واحد
أودّ أن تجيب عليه

136
00:10:34,320 --> 00:10:38,410
قلت أنّ المهمّ للبشر هو المستقبل

137
00:10:38,410 --> 00:10:40,830
لكن ستواجه البشريّة الانقراض

138
00:10:40,830 --> 00:10:44,500
كما سيكون نتيجة التقدّم
العلميّ المُفرط

139
00:10:45,020 --> 00:10:49,750
في تلك الحالة، لمَ لا نوجّه العلم
نحو دربٍ لا يقود لدمار البشريّة؟

140
00:10:50,530 --> 00:10:53,510
لأنّ قدر البشريّة هو الهلاك

141
00:10:54,760 --> 00:10:58,890
،اسمعني، لا يمكن تغيير الماضي
فهو مكتوبٌ سلفاً

142
00:10:58,890 --> 00:11:00,850
أتفهم ذاك القدر؟

143
00:11:00,850 --> 00:11:05,390
ذلك واضح، ليست مسألة
فهمٍ من عدمه

144
00:11:05,390 --> 00:11:09,960
،إذاً بعدما يمضي الحاضر، سيمسي ماضياً
أتفهم ذلك أيضاً؟

145
00:11:09,960 --> 00:11:11,530
ذلك واضحٌ أيضاً

146
00:11:11,530 --> 00:11:16,450
الأرض إذاً، بل الكون بأسره
منذ بدايته إلى نهايته

147
00:11:16,450 --> 00:11:18,450
هو سلسلةٌ من اللحظات المتوالية

148
00:11:18,450 --> 00:11:22,930
أيّ لحظةٍ ركّزتَ عليها، ستكون الماضي
من منظور اللحظة التي تليها

149
00:11:22,930 --> 00:11:24,280
أتفهم ذلك؟

150
00:11:26,790 --> 00:11:32,100
أي ما سيحصل هو مكتوبٌ سلفاً
لأنّه سيصبح الماضي في المستقبل؟

151
00:11:32,100 --> 00:11:34,700
"كلا، لا وجود لـ "في المستقبل

152
00:11:34,700 --> 00:11:38,220
تتواجد كلّ لحظةٍ مقدّرٌ لها تزامنيّاً

153
00:11:38,220 --> 00:11:40,290
هذا معقّدٌ أكثر

154
00:11:41,460 --> 00:11:47,800
يمكن للإله وحده تأكيد نظريّتك، بما أنّه
رأى البشريّة من بدايتها إلى نهايتها

155
00:11:48,140 --> 00:11:51,420
هذا حدّ فهمك إذاً؟

156
00:11:51,420 --> 00:11:54,060
:فلتفكّر بالأمر من هذا المنظور

157
00:11:54,060 --> 00:11:59,930
في هذا الكون، تتواجد ملايين ومليارات الأعوام
في إطار لحظة

158
00:11:59,930 --> 00:12:05,910
وتتضمّن تلك اللحظة ولادات
وانتفاءات لا مُتناهية

159
00:12:05,910 --> 00:12:09,840
عجزك عن فهم ذلك الآن
لا يمثل أيّ مشكلة

160
00:12:09,840 --> 00:12:13,800
،قُدّر أنّه بعد ما يفوق القرن من الآن

161
00:12:13,800 --> 00:12:17,590
ستثبت صحّة كلامي، وسيفهم الناس

162
00:12:18,700 --> 00:12:24,020
أُقدم على أفعالٍ مقدّراً لها الآن
لأخذنا لذاك المستقبل لا أكثر

163
00:12:24,020 --> 00:12:29,340
لا أمانع ذلك، فهو يعني
أنّه مستقبلك المثاليّ وحسب

164
00:12:30,010 --> 00:12:33,440
،"لأجل العالم"، "لأجل البشريّة"
"للمستقبل"

165
00:12:33,440 --> 00:12:35,830
لكن ما تقوم به لنفسك فقط

166
00:12:35,830 --> 00:12:40,770
يعيش كلّ البشر لأنفسهم، وأنت من ضمنهم

167
00:12:41,450 --> 00:12:46,320
مدى اقترابنا من الوصول لتلك المثاليّة
هو ما يجعل الناس سعداء

168
00:12:48,100 --> 00:12:54,130
مثاليّتك لعمليّة الاختيار هذه هي عدم
صنع إلهٍ زائف، وعدم وجود إلهٍ بالأصل

169
00:12:54,610 --> 00:12:56,900
لكنّ ذلك سيكلّف أرواحاً كثيرة

170
00:12:57,480 --> 00:13:01,130
مثاليّتي هي إنهاء الأمر بأقلّ
قدر ممكن من التضحيات

171
00:13:01,870 --> 00:13:04,090
وسعادتي في ذلك

172
00:13:04,710 --> 00:13:08,140
المستقبل هو نتاج الحاضر، ليس محسوماً

173
00:13:08,630 --> 00:13:10,920
سأمسك مستقبلي بنفسي

174
00:13:11,650 --> 00:13:14,040
سأقتلك

175
00:13:14,040 --> 00:13:17,440
لن تطيل في كلامك هذا

176
00:13:18,070 --> 00:13:20,880
بحثتُ في أمرك

177
00:13:20,880 --> 00:13:22,690
انتهى الأمر سلفاً

178
00:13:26,740 --> 00:13:28,260
...يونيدا

179
00:13:28,260 --> 00:13:29,780
ما معنى هذا؟

180
00:13:29,780 --> 00:13:31,400
ألا تفهم؟

181
00:13:31,930 --> 00:13:34,530
عليك اختيار حياة

182
00:13:34,530 --> 00:13:37,400
لا احتيار، بل اختيار

183
00:13:38,130 --> 00:13:42,040
هل ستترك رغبتك
في أن تصبح إلهاً زائفاً؟

184
00:13:42,040 --> 00:13:45,010
إذا لم تفعل، ستلقى صفراء حتفها

185
00:13:45,010 --> 00:13:50,820
هذه أضمن طريقة لمنع ولادة
إلهٍ زائفٍ حاليّاً

186
00:13:52,050 --> 00:13:53,690
فلتختر

187
00:13:55,620 --> 00:13:58,530
أمامك 28 ثانية

188
00:14:07,420 --> 00:14:11,580
ألم تقل أنّك لا تحبّ مضايقة الآخرين؟

189
00:14:11,580 --> 00:14:13,330
وأنّك ستنتحر يوماً ما

190
00:14:13,330 --> 00:14:17,430
ألا ترى أنّ قتل أحدهم
هو أكبر ضيقٍ قد تتسبّب به؟

191
00:14:17,430 --> 00:14:19,200
!فلتمت بمفردك

192
00:14:19,830 --> 00:14:24,510
أنتِ محقّة، لكن لديّ ما عليّ
فعله الآن مع البروفسور

193
00:14:24,510 --> 00:14:25,980
تلك أولويّتي القصوى

194
00:14:27,980 --> 00:14:30,220
كاكيهاشي-كن، الوقت ينفد

195
00:14:31,860 --> 00:14:35,450
فهمت، لن أصبح إلهاً

196
00:14:41,720 --> 00:14:46,230
تخلّى مرشّح الإله كاكيهاشي ميراي
عن رغبته في أن يصبح الإله

197
00:14:46,230 --> 00:14:49,730
أيعني هذا أنّه لن يكون
هناك إلهٌ جديد؟

198
00:14:49,730 --> 00:14:52,860
صرّح كاكيهاشي ميراي بأنّه
لن يصبح الإله

199
00:14:52,860 --> 00:14:56,140
أيعني هذا أنّه لن يكون
هناك إلهٌ جديد؟

200
00:14:56,510 --> 00:15:00,010
هذا ليس جيّداً، أنا بحاجةٍ
لأن يكون هناك إله

201
00:15:02,170 --> 00:15:05,580
ما الذي ستقوله صفراء برأيك
عندما ترى هذا؟

202
00:15:05,580 --> 00:15:10,260
،شيءٌ من سياق: "لا يهمّ ما يحلّ بي
"فلتقتل يونيدا وحسب

203
00:15:10,260 --> 00:15:12,760
ماذا؟ لم تقل ذلك

204
00:15:13,580 --> 00:15:17,330
أيّاً يكن، خاب أملي بك يا أحمر

205
00:15:17,330 --> 00:15:20,920
عندما قلت أنّك لن تفعل
،شيئاً إن أصبحتَ إلهاً

206
00:15:20,920 --> 00:15:24,960
ظننتُك شخصاً قادراً
على اتّخاذ قرارات رزينة

207
00:15:24,960 --> 00:15:27,280
لكن لعلّي بالغت في تقديرك

208
00:15:28,580 --> 00:15:32,690
،قبل محض 12 دقيقة و49 ثانية
قلتَ أنّها مسألةٌ عدديّة

209
00:15:32,690 --> 00:15:37,130
وأنّ قتلي سينقذ ملايين الأرواح

210
00:15:37,130 --> 00:15:43,790
لكن الآن، كأنّك صرّحت بتخليك عن أرواح
أولئك الملايين مقابل صفراء فحسب

211
00:15:43,790 --> 00:15:45,430
...بعد ذاك الكلام المتباهي

212
00:15:45,430 --> 00:15:47,730
تنازل لحبيبته

213
00:15:46,970 --> 00:15:47,730
يا لفظاعته

214
00:15:47,730 --> 00:15:51,410
إلهاً زائفاً أم لا، أنا مسرورٌ لأنّ
شخصاً مثله لم يصبح الإله

215
00:15:52,560 --> 00:15:57,310
لو كنتُ مكانك، لما أقدمتُ
على هذا الخيار الغبيّ قطعاً

216
00:15:57,860 --> 00:16:01,210
بالنسبة لك، حياة صفراء هي الأثمن

217
00:16:01,210 --> 00:16:04,410
ثمّ الملايين، ثمّ أتدنّاهم أنا

218
00:16:04,410 --> 00:16:06,500
هل أصبت؟

219
00:16:07,810 --> 00:16:09,070
أصبت

220
00:16:10,450 --> 00:16:14,090
هاناكاغو ساكي هي الأهمّ لي

221
00:16:19,380 --> 00:16:20,830
الأهمّ؟

222
00:16:21,570 --> 00:16:28,330
أمقت اعتبار الناس لأحدهم أنّه
الأهمّ" لهم بلا مقوّمات"

223
00:16:30,010 --> 00:16:34,510
الأهمّ" و"شريك القدر" هي أوهامٌ للضعفاء"

224
00:16:34,810 --> 00:16:36,610
لا تعدو عن كونها سراباً

225
00:16:36,610 --> 00:16:41,250
يوجد 7.7 مليار بشريّ على الأرض

226
00:16:41,250 --> 00:16:44,560
لعجزك عن التحكّم بالغريزة
الحيوانيّة المتأصّلة

227
00:16:44,560 --> 00:16:49,100
التي جذبت الذكور والإناث لبعضهم
مذ العصور القديمة

228
00:16:49,100 --> 00:16:51,740
تخلّيت عن رغبتك
...في أن تصبح إلهاً زائفاً

229
00:16:51,740 --> 00:16:52,740
بروفسور

230
00:16:53,860 --> 00:16:57,530
أرى أنّك تفتقر لخصلةٍ بشريّة

231
00:16:58,980 --> 00:17:03,820
قرأتُ في مؤلفاتك أنّك تعتبر الصداقة
والعشّاق والأصحاب

232
00:17:03,820 --> 00:17:08,050
محض أدوات في ثنايا الروايات
لتسلية القرّاء

233
00:17:08,050 --> 00:17:10,820
"إنّها "الحُب والصداقة والأصحاب

234
00:17:10,820 --> 00:17:13,770
وعلى أرض الواقع، يفشل الناس
في الحصول عليهم

235
00:17:13,770 --> 00:17:17,890
بل ويتعرّضون للخيانة في نهاية
المطاف إن فعلوا

236
00:17:17,890 --> 00:17:19,520
تماماً

237
00:17:19,520 --> 00:17:23,560
مرّ عليّ وقتٌ شعرت فيه بذلك أيضاً

238
00:17:24,960 --> 00:17:26,190
!رائحته منتنة

239
00:17:26,190 --> 00:17:27,460
!أمسكوا بأنوفكم

240
00:17:27,460 --> 00:17:31,330
!خادم! خادم! خادم

241
00:17:31,690 --> 00:17:33,420
أنا في الخامسة عشر

242
00:17:33,420 --> 00:17:36,350
،حتّى لو قلتُ أنّها الأهمّ لي

243
00:17:36,350 --> 00:17:38,840
قد لا نمضي وقتنا رفقة بعضنا
طوال العمر

244
00:17:40,000 --> 00:17:44,730
لكن ليس من المنطقيّ إنكار
الصداقة والحّب باعتبارهما أوهاماً

245
00:17:44,730 --> 00:17:46,600
ليس كلاماً يصحّ قوله

246
00:17:47,190 --> 00:17:51,990
وسبب قولك له هو لأنّك
لم تتواصل مع الآخرين

247
00:17:51,990 --> 00:17:54,090
لأنّك لا تعرف مشاعر الناس

248
00:17:55,490 --> 00:17:59,500
يستحيل أن يقول شخصٌ وقع
في الحُب بصدق كلاماً كهذا

249
00:18:00,070 --> 00:18:02,800
لا خلل في أيّ ما فعلتُه

250
00:18:03,370 --> 00:18:07,000
إنّه الخيار السليم بما أنّي أحبّها

251
00:18:07,620 --> 00:18:10,620
مذهل، أشعر بالغيرة

252
00:18:10,620 --> 00:18:13,820
أيّها المتطرّف، أنا متأكّدةٌ أنّك
لم تحبّ أحداً من قبل صدقاً

253
00:18:13,820 --> 00:18:14,510
!اخرسي

254
00:18:14,510 --> 00:18:16,010
مخيف

255
00:18:17,280 --> 00:18:20,530
كان كلامك جميلاً

256
00:18:20,530 --> 00:18:23,750
يمدّ خيارك التالي بقيمةٍ أكبر

257
00:18:25,200 --> 00:18:27,430
خياري التالي؟

258
00:18:28,040 --> 00:18:30,040
:خيارك التالي

259
00:18:32,260 --> 00:18:35,260
هل ستموت؟ أم تموت صفراء؟

260
00:18:42,140 --> 00:18:48,540
،حتّى لو تخلّيت عن رغبتك بأن تصبح إلهاً زائفاً
لا يمكن أن أسمح بمغادرتك

261
00:18:49,170 --> 00:18:53,440
،عندما اقتصرت المحادثة علينا

262
00:18:53,440 --> 00:18:57,060
يُفترض أنّك أدركت أنّ أحدنا سيقتل الآخر

263
00:18:57,900 --> 00:19:00,480
مجدّداً، أمامك 28 ثانية

264
00:19:01,620 --> 00:19:05,000
،هل ستترك سهمي الأبيض يصيبك

265
00:19:05,000 --> 00:19:09,330
أم تترك صفراء تُصاب بسهم
ناكاومي شوجي الأبيض؟

266
00:19:09,330 --> 00:19:15,590
إذا اخترتَ الموت لكنّك تفاديت السهم
الأبيض المتوجّه نحوك

267
00:19:15,590 --> 00:19:17,300
فستموت صفراء بالطبع

268
00:19:17,750 --> 00:19:21,580
!ريفيل، أخبر كاكيهاشي-كن أنّي بخير

269
00:19:21,580 --> 00:19:22,320
...ساكي

270
00:19:22,320 --> 00:19:26,810
لا تفعل، إن غادر ريفيل أو يازيلي
هذه الغرفة، فسأقتل الجميع

271
00:19:26,810 --> 00:19:29,440
أخبره وحسب، أرجوك

272
00:19:29,440 --> 00:19:33,820
لا أستطيع يا ساكي، حياتكِ أكثر
أهميّةً لي من حياة ميراي

273
00:19:34,370 --> 00:19:37,090
علينا ائتمان شركائنا الآن

274
00:19:43,090 --> 00:19:45,500
لنبدأ إذاً

275
00:19:49,560 --> 00:19:52,720
يظنّ البروفسور أنّي سأختار الموت

276
00:19:53,100 --> 00:19:56,320
بما أنّي أملك سهماً أبيضاً، فأنا
عقبةٌ في طريقه

277
00:19:56,320 --> 00:20:01,350
في الواقع، أفضل مهرب من هذا
الوضع هو قتل البروفسور

278
00:20:05,630 --> 00:20:08,850
إذا متّ، فهل تضمن سلامة صفراء؟

279
00:20:10,630 --> 00:20:14,310
وتيماري-سان؟ قالت أنّها لا تستطيع
مواصلة العيش ما لم يصبح أحدٌ إلهاً

280
00:20:14,310 --> 00:20:16,480
ويتركها تحتفظ بسهمها الأحمر

281
00:20:16,880 --> 00:20:20,040
ما تحتاجه هو المال

282
00:20:20,040 --> 00:20:23,740
دعمها كي تحظى بحياةٍ ترضيها
لن يكون أمراً صعباً

283
00:20:23,740 --> 00:20:27,800
ماذا؟ أي سيصبح البروفسور داعمي؟

284
00:20:27,800 --> 00:20:30,740
في تلك الحالة، قد أتدبّر وضعي
مهما آل الأمر إليه

285
00:20:31,560 --> 00:20:34,020
البروفسور يكذب

286
00:20:34,020 --> 00:20:38,550
يجب قتل كافّة مرشّحي الإله
"كيلا يُولَد "المخلوق

287
00:20:38,550 --> 00:20:41,940
ولتحقيق ذلك، يجب قتل العقبة الأكبر
أحمر أوّلاً

288
00:20:42,590 --> 00:20:44,510
وإن كان عليه الكذب لأجل ذلك، فسيفعل

289
00:20:50,850 --> 00:20:53,080
ميراي-كن، لا تفعل

290
00:20:53,080 --> 00:20:57,270
أتيتُ لأسعدك، يجب ألّا تموت

291
00:20:57,750 --> 00:21:00,270
فلن تجد السعادة إن متّ

292
00:21:00,270 --> 00:21:03,720
عليك أن تسعد لأجل عائلتك الراحلة أيضاً

293
00:21:03,720 --> 00:21:07,150
صحيح، نهضت على قدميك
حتّى بعد موت عائلتك

294
00:21:07,150 --> 00:21:11,550
لن يستحيل عليك إيجاد السعادة أبداً
إن ماتت ساكي-تشان

295
00:21:18,140 --> 00:21:19,290
تبقّت 5 ثوانٍ

296
00:21:21,560 --> 00:21:23,190
سأعطيكِ إيّاها

297
00:21:25,280 --> 00:21:26,560
شكراً لك

298
00:21:27,450 --> 00:21:29,260
دعسوقة صفراء

299
00:21:29,260 --> 00:21:31,410
هي من وجدتها في الواقع

300
00:21:31,410 --> 00:21:34,570
يُقال أنّ الدعاسيق تجلب للناس السعادة

301
00:21:37,330 --> 00:21:38,860
!أريد العيش

302
00:21:38,860 --> 00:21:42,010
كانت ملامحك عبوسةً لفترةٍ الآن

303
00:21:42,010 --> 00:21:45,450
ليتنا نستطيع الابتسام سويّاً هكذا للأبد

304
00:21:55,800 --> 00:21:58,930
كاكيهاشي-كن، أنا أحبّك

305
00:22:02,500 --> 00:22:06,740
هنالك أشخاصٌ تحمل أرواحهم
قيمةً أكبر منّي

306
00:22:13,470 --> 00:22:14,480
نفد الوقت

307
00:22:14,480 --> 00:22:17,980
ناكاومي، أطلق على صفراء إن هرب أحمر