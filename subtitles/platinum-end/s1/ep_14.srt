1
00:00:00,350 --> 00:00:06,000
(البرنامج التالي موجّه للجمهور البالغ فقط)

2
00:00:00,810 --> 00:00:03,820
،لكن إذا كنت تقول أنّك ستقاتل بعدل
فيسرّني سماع ذلك

3
00:00:03,820 --> 00:00:07,730
فلنقم بتسوية الأمر سريعاً إذاً، أطلق

4
00:00:07,730 --> 00:00:11,650
أنا متأكّدٌ أنّك تفكّر بطريقة
،للفوز دون استخدام أجنحتك

5
00:00:11,650 --> 00:00:13,220
لكن لا يمكنك

6
00:00:13,220 --> 00:00:17,280
...لا أفكّر بذلك، ما أفكّر به

7
00:00:18,460 --> 00:00:22,260
"أأنا أقاتل ميتروبوليمان الحقيقيّ أم لا؟"

8
00:00:22,760 --> 00:00:23,750
ماذا؟

9
00:00:26,680 --> 00:00:30,860
!أحمر، أنا متأكّدٌ بنسبة 99% أنّه ميتروبوليمان

10
00:00:30,860 --> 00:00:32,010
أعرف

11
00:00:32,670 --> 00:00:35,260
%لكنّها ليست 100

12
00:00:35,880 --> 00:00:37,850
...%وإذا لم تكن 100

13
00:00:44,780 --> 00:00:47,560
ما الذي يفعله؟ أيماطل؟

14
00:00:48,960 --> 00:00:50,400
كلا

15
00:00:50,900 --> 00:00:55,680
...يتظاهر بتردّده، لكنّه دوماً ما

16
00:01:01,300 --> 00:01:04,900
يمكنك خلع قناعه بعدما تطلق عليه

17
00:01:04,900 --> 00:01:07,300
فقد رأيتَ وجهه سلفاً

18
00:01:08,270 --> 00:01:10,240
...أعرف، لكن

19
00:01:13,140 --> 00:01:16,260
أنت أحمقٌ ومزعجٌ بحقّ

20
00:01:16,260 --> 00:01:18,720
إذا كان هذا ما يشغلك، فسأريك

21
00:01:28,240 --> 00:01:29,840
خلع قناعه بنفسه؟

22
00:01:29,840 --> 00:01:32,730
لا أستطيع تصوّر كونه
بهذه الصراحة والعدل

23
00:01:33,060 --> 00:01:34,740
هل رضيت؟

24
00:01:36,240 --> 00:01:40,490
أجل، أنت نفس ميتروبوليمان الذي
قاتلتُه على البرج بلا شكّ

25
00:01:40,950 --> 00:01:42,150
شكراً لك

26
00:01:42,780 --> 00:01:45,020
كلّ شيءٍ واضح لي الآن

27
00:03:19,110 --> 00:03:20,120
هل رأيت وجهه؟

28
00:03:20,120 --> 00:03:22,470
كلا، زاوية الكاميرا سيّئة

29
00:03:22,470 --> 00:03:24,940
لن نعرف هويّة ميتروبوليمان إذاً؟

30
00:03:24,940 --> 00:03:26,720
يا للتصوير المُملّ

31
00:03:28,250 --> 00:03:33,350
كـ-كلا، علينا المشاهدة، فهذه معركةٌ
ستحدّد من يصبح الإله

32
00:03:33,350 --> 00:03:37,360
ستقرّر هذه المعركة المقدّسة
...من يكون المنُقذ

33
00:03:37,360 --> 00:03:39,490
!من ينقذ هذا العالم الجنونيّ

34
00:03:39,490 --> 00:03:42,790
!يا إله! أنت لها يا إله

35
00:03:42,790 --> 00:03:46,000
!أنقذني رجاءً

36
00:03:43,580 --> 00:03:44,980
شخصٌ مجنون

37
00:03:44,980 --> 00:03:45,990
إنّه مخبول

38
00:03:47,050 --> 00:03:48,040
إذاً؟

39
00:03:48,780 --> 00:03:51,520
لم نستطع التحقّق من هويّته بما
أنّ وجهه كان خارج التصوير

40
00:03:58,840 --> 00:04:00,670
من سيفوز يا ترى؟

41
00:04:01,110 --> 00:04:05,070
ربما الأحمر؟ إنّه مثيرٌ للاهتمام

42
00:04:05,710 --> 00:04:06,800
!ها نحن ذا

43
00:04:07,270 --> 00:04:12,800
ها نحن ذا"؟ أأنت شخصيّة من مسلسل"
للأبطال الخارقين أو ما شابه؟

44
00:04:12,800 --> 00:04:15,320
أنا أقاتل بعدل

45
00:04:15,320 --> 00:04:20,190
إذا اقتربتُ وأطلقت سهمي بعد قولي
ها نحن ذا"، فسيكون ذلك مُجحفاً"

46
00:04:20,510 --> 00:04:25,300
،لكن إذا تقدّمتُ وطعنتك به بدل الإطلاق
فلن يكون ذلك مجحفاً البتّة

47
00:04:27,870 --> 00:04:28,960
ما الذي يفعله؟

48
00:04:39,310 --> 00:04:40,840
!يندفع من هذه المسافة؟

49
00:04:40,840 --> 00:04:41,710
!كاكيهاشي-كن

50
00:04:41,710 --> 00:04:44,220
!أأنت غبيّ؟ جعلت نفسك لقمةً سائغة

51
00:04:46,720 --> 00:04:48,300
!راقب بإمعان

52
00:05:08,730 --> 00:05:09,730
!لا يخترقه؟

53
00:05:09,730 --> 00:05:11,260
لـ-لمَ؟

54
00:05:11,260 --> 00:05:12,330
!لا-لا يُعقل

55
00:05:16,040 --> 00:05:19,570
كما ظننت، أُصيب بسهمٍ أحمر سلفاً

56
00:05:27,690 --> 00:05:32,100
يتصادم سهمه مع السهم الأبيض
التالي الذي يحضّره؟

57
00:05:32,620 --> 00:05:37,110
،لم ينسحب عندما فقد أفضليّته العدديّة
أو يعدل عن مواجهتنا الفرديّة

58
00:05:37,110 --> 00:05:42,070
وأصرّ على القتال بعدلٍ وإنصاف لأنّ
لا يمكن أن يخترقه سهمٌ أحمر

59
00:05:42,730 --> 00:05:47,060
كان واثقاً من عدم خسارته طالما
لم أستعمل سهمي الأبيض

60
00:05:47,490 --> 00:05:49,440
من أمر بأن يطلق عليه؟

61
00:05:49,440 --> 00:05:51,990
...كلا، ما عليّ فعله الآن

62
00:05:57,750 --> 00:05:58,870
أجنحة؟

63
00:06:06,530 --> 00:06:07,840
يغطّي وجهه بأجنحته؟

64
00:06:10,510 --> 00:06:11,100
...لا أرى

65
00:06:11,100 --> 00:06:13,850
لا يمكنه إطلاق سهمه ما لم
!يستطع رؤية هدفه

66
00:06:13,850 --> 00:06:15,220
!تبّاً

67
00:06:15,610 --> 00:06:17,730
،الأجنحة مرئيّة لمرشّحي الإله

68
00:06:18,030 --> 00:06:22,980
لكن بما أنّها لا تحتكّ بالمواد في العالم
البشريّ، فلا يمكنه إمساكها

69
00:06:23,460 --> 00:06:26,860
مالك الأجنحة وحده يستطيع تحريكها بحريّة

70
00:06:28,000 --> 00:06:29,490
يا للتفكير الدقيق

71
00:06:30,130 --> 00:06:31,400
!تبّاً

72
00:06:31,750 --> 00:06:33,040
هذا سيّئ

73
00:06:33,040 --> 00:06:35,240
أُصيب أحمر من قِبل موكايدو

74
00:06:35,540 --> 00:06:37,460
،حتّى لو لم يقتلني بنفسه

75
00:06:37,460 --> 00:06:40,750
من المُحتمل ألّا يمنع
موكايدو من قتلي

76
00:06:46,170 --> 00:06:46,920
!أحمر

77
00:06:47,250 --> 00:06:49,640
!تبّاً! هذه البذلة اللعينة

78
00:06:51,470 --> 00:06:53,350
!كلّا

79
00:06:58,050 --> 00:07:01,320
!أفلت يدي اليمنى

80
00:07:02,700 --> 00:07:03,770
!ميزا

81
00:07:03,770 --> 00:07:06,520
!انقلي سهمي الأبيض ليدي اليسرى

82
00:07:06,520 --> 00:07:08,280
!إذا لم أستطع رؤيته، سأطعنه مباشرةً

83
00:07:11,740 --> 00:07:12,780
!ميزا

84
00:07:15,910 --> 00:07:17,410
الفتاة القطّة؟

85
00:07:17,410 --> 00:07:18,830
!لن أدعك تفعل ذلك

86
00:07:25,060 --> 00:07:26,520
!صفراء

87
00:07:28,440 --> 00:07:30,290
!لن أفلت أبداً

88
00:07:30,290 --> 00:07:35,510
!أيّها الوغدان

89
00:07:40,140 --> 00:07:43,020
!صفراء، استعملي حلقاتك

90
00:08:15,500 --> 00:08:16,640
!نجحا

91
00:08:18,180 --> 00:08:21,270
...أحمر... صفراء

92
00:08:21,270 --> 00:08:22,430
شكراً لكما

93
00:08:24,780 --> 00:08:27,420
دعا الباقي لي

94
00:08:39,930 --> 00:08:41,080
ناناتو-كن

95
00:08:45,830 --> 00:08:50,900
كنت صادقاً عندما قلت أنّك تقاتل
شرّاً سيدمّر العالم

96
00:08:51,460 --> 00:08:55,330
أنا بطلٌ اختاره الإله

97
00:08:56,510 --> 00:09:01,340
لا تقلقي، ستتبعكِ ناناكا فوراً

98
00:09:02,500 --> 00:09:05,140
وأعدكِ بأن أرجع أيضاً

99
00:09:06,680 --> 00:09:07,840
أمّي

100
00:09:19,440 --> 00:09:23,500
صدّ السهم بالاندفاع وسهمه مجهّز في يده

101
00:09:23,500 --> 00:09:25,710
نجح لأنّ المسافة كانت قريبةً بالفعل

102
00:09:27,090 --> 00:09:30,640
أمسكاه بإحكام

103
00:09:31,380 --> 00:09:34,340
سآتي فوراً لقتله

104
00:09:38,890 --> 00:09:41,510
لا تفعل، كلّا

105
00:09:44,270 --> 00:09:47,020
!ستصبح قاتلاً! أيرضيك ذلك؟

106
00:09:49,930 --> 00:09:51,770
!أحمر، أوقفه

107
00:09:51,770 --> 00:09:56,640
ماذا عن كلامك بأنّ علينا العيش؟
وأنّ من الخطأ قتل الناس؟

108
00:10:00,030 --> 00:10:03,630
...إذا أراد أحمر تحقيق رغبة أخضر، فأنا

109
00:10:10,250 --> 00:10:13,420
أنا مصابٌ بسرطان، مرحلة متأخّرة

110
00:10:15,700 --> 00:10:20,300
على الأقل، يجب ألّا يصبح
ميتروبوليمان إلهاً قطعاً

111
00:10:26,060 --> 00:10:32,050
لا أريد أن أكون أباً عجز عن فعل
شيء لأطفاله، ولم يحاول بالأصل

112
00:10:32,050 --> 00:10:34,160
سنحت لي فرصة أن أصبح مرشّح إله

113
00:10:34,160 --> 00:10:37,440
سأتحمّل تلك المسؤولية وأفعل
كلّ ما بقدرتي

114
00:10:39,690 --> 00:10:44,810
قتله بيديّ هو ما سيجعلني سعيداً

115
00:10:50,360 --> 00:10:52,300
!أتصغي لي؟

116
00:10:52,300 --> 00:10:56,340
لا أمل منه، يجبره السهم الأحمر
على إطاعة موكايدو

117
00:10:56,610 --> 00:10:58,970
سأُقتل على هذا النحو

118
00:11:13,440 --> 00:11:17,090
مُحال. هذا مصطنع، صحيح؟

119
00:11:18,580 --> 00:11:19,990
أحُسم الأمر؟

120
00:11:23,760 --> 00:11:25,370
لنتوجّه هناك فوراً

121
00:11:26,060 --> 00:11:28,240
...كا-كانادي

122
00:11:31,340 --> 00:11:32,630
!اسمعني

123
00:11:32,630 --> 00:11:34,510
!أنا أقوم بهذا لعائلتي أيضاً

124
00:11:34,510 --> 00:11:37,880
أردتُ لقاء أختي التي قتلتُها
!عن طريق الخطأ فقط

125
00:11:37,880 --> 00:11:42,010
أغرتني تلك الملاك بوعدها أنّي سأستطيع
!رؤيتها إذا أصبحتُ إلهاً

126
00:11:42,010 --> 00:11:45,390
!أنا أفعل هذا لأختي

127
00:11:50,180 --> 00:11:53,270
...لـ-لأختي

128
00:11:54,480 --> 00:11:58,020
ألا يمكننا إبقاؤه معصوب العينين
واحتجازه في السجن؟

129
00:11:58,020 --> 00:12:00,650
!صحيح! افعلوا ذلك

130
00:12:00,650 --> 00:12:03,530
!ليس عليكم الإقدام على حماقةٍ مثل القتل

131
00:12:04,740 --> 00:12:08,910
أنت، أتسمعني يا موكايدو؟

132
00:12:08,910 --> 00:12:10,040
!موكايدو

133
00:12:10,910 --> 00:12:12,540
...موكايدو-سان

134
00:12:14,160 --> 00:12:15,790
هذا الوداع، صحيح؟

135
00:12:22,490 --> 00:12:27,650
قبل رحيلي، امنحني قوّة سحب الزنادٍ فحسب

136
00:12:29,120 --> 00:12:30,440
...قوّة

137
00:12:34,360 --> 00:12:38,420
اشهدوا هذا الدليل على كوني قد عشت

138
00:12:39,060 --> 00:12:42,330
هذه عدالتي

139
00:12:43,800 --> 00:12:47,070
أعرف أنّ الأنانيّة نصف دافعي

140
00:12:48,240 --> 00:12:53,080
سيفهم كاكيهاشي-كن وعائلتي يوماً

141
00:12:54,740 --> 00:12:56,720
لأجل عائلتي الغالية

142
00:12:57,330 --> 00:12:59,440
!موكايدو! موكايدو

143
00:12:57,960 --> 00:12:59,440
المكان مُظلم

144
00:12:59,440 --> 00:13:01,020
!لا تُقدم على القتل

145
00:13:00,260 --> 00:13:04,380
ليتني أمضيت وقتاً أطول مع عائلتي

146
00:13:01,020 --> 00:13:05,360
ما الذي سيحلّ بعائلتك التي ستتركها؟
!أتسمع؟ موكايدو

147
00:13:05,360 --> 00:13:07,740
أتسمعني؟

148
00:13:05,360 --> 00:13:10,850
لم يخطر لي أنّ قتل شخصٍ قد يُسعدني

149
00:13:07,740 --> 00:13:09,350
!لا تفعل

150
00:13:15,100 --> 00:13:17,890
يا لها من حياة

151
00:13:21,680 --> 00:13:24,140
أبي بخير، صحيح؟

152
00:13:24,140 --> 00:13:26,050
!كلا! لا تلمسيها

153
00:13:29,080 --> 00:13:30,340
أمّي؟

154
00:13:31,050 --> 00:13:32,120
لا بأس

155
00:13:35,300 --> 00:13:38,640
أبوكِ بطل

156
00:13:46,550 --> 00:13:49,060
...آيا

157
00:13:57,820 --> 00:13:59,120
...عليّ الهرب

158
00:14:03,920 --> 00:14:05,320
!تبّاً

159
00:14:05,320 --> 00:14:06,650
!دعاني

160
00:14:06,650 --> 00:14:10,300
بناءً على الصوت، فهو يُطلق من مدى قريب جدّاً

161
00:14:11,100 --> 00:14:13,030
!أحمر، لنجرِ اتّفاقاً

162
00:14:13,710 --> 00:14:16,280
!لا أريد أن أصبح إلهاً! المقام لك

163
00:14:16,280 --> 00:14:18,160
...لذا

164
00:14:18,160 --> 00:14:20,260
!سأعطيك مالاً! قدرما تشاء

165
00:14:20,260 --> 00:14:22,920
كم تريد؟ مليار؟ عشرة مليارات؟

166
00:14:22,920 --> 00:14:24,920
!سأعطيك ملأ رغبتك

167
00:14:25,290 --> 00:14:30,590
!الفتاة القطّة! سأجعلك زوجتي
!سأعطيكِ أيّ ما تشائين

168
00:14:30,590 --> 00:14:32,920
!أعد بأن أجعل حياتكِ سعيدة

169
00:14:33,220 --> 00:14:34,370
ما قولك؟

170
00:14:36,760 --> 00:14:38,950
أملك كلّ شيء

171
00:14:39,590 --> 00:14:40,960
...كلّ شيء

172
00:14:57,120 --> 00:15:03,420
!كلا

173
00:15:09,640 --> 00:15:11,480
...ريا

174
00:15:18,370 --> 00:15:19,250
...ريـ

175
00:15:33,320 --> 00:15:35,330
!رائع

176
00:15:35,330 --> 00:15:39,700
!خسر بوليمان

177
00:15:41,080 --> 00:15:44,520
يا للأسف يا أوريو كانادي

178
00:15:44,520 --> 00:15:46,270
كنتَ الساذج

179
00:15:58,680 --> 00:16:02,020
...كان... كان هذا

180
00:16:07,610 --> 00:16:15,100
لو لم نفعله... لزُهقت أرواح أكثر، صحيح؟

181
00:16:23,520 --> 00:16:24,550
أجل

182
00:16:27,420 --> 00:16:28,520
...لكن

183
00:16:31,000 --> 00:16:35,560
مع ذلك... كانت حياةً واحدة

184
00:16:37,380 --> 00:16:38,510
رائع

185
00:16:39,320 --> 00:16:43,230
خطا ميراي-كن خطوةً أخرى نحو السعادة

186
00:16:48,600 --> 00:16:49,770
!الحلقات

187
00:16:52,650 --> 00:16:58,530
هل ستتّجه لمرشّح الإله الذي
أصاب ميتروبوليمان بسهمٍ أحمر؟

188
00:16:59,660 --> 00:17:00,910
!موكايدو-سان

189
00:17:05,200 --> 00:17:06,540
رحلت

190
00:17:11,650 --> 00:17:14,360
!يجب... يجب أن نأخذه لمشفى

191
00:17:23,450 --> 00:17:29,400
كيف لشخصٍ امتلك ذاك الثراء، وانتمى لتلك
الطبقة الرفيعة من المجتمع أن يسقط؟

192
00:17:29,790 --> 00:17:32,920
يحدّد المال صراعات البشر فحسب

193
00:17:32,920 --> 00:17:35,320
لا معنى له أمام الأجنحة والأسهم

194
00:17:35,680 --> 00:17:40,700
حتّى سوكوتاني هاجيمي الفقير
لم يكن عديم القوى كليّاً

195
00:17:41,910 --> 00:17:44,220
لمَ تتدخّل في مخطّطاتي؟

196
00:17:44,220 --> 00:17:45,830
لم تكن نيّتي

197
00:17:46,200 --> 00:17:51,340
،"إقحام هاجيمي سيجعل الأمور مسليّة أكثر"
تبعتُ حدسي ذاك لا أكثر

198
00:17:52,560 --> 00:17:54,210
إلى اللقاء إذاً

199
00:17:54,210 --> 00:17:56,900
تسنّت لي رؤية أمرٍ مثيرٍ بحقّ

200
00:18:04,020 --> 00:18:07,770
أنا ملاكٌ ذات رتبة خاصّة، وها أنا ذي

201
00:18:09,760 --> 00:18:12,840
لا أصدّق أنّي أنقل بشريّاً ميتاً من جديد

202
00:18:38,060 --> 00:18:39,400
إنّه يمرّ بالازرقاق

203
00:18:39,400 --> 00:18:43,440
وظائفه القلبيّة الرئويّة ومعدّل
نبضات قلبه يتلاشيان سريعاً

204
00:18:43,440 --> 00:18:45,560
بدأ التنفّس الفكّي

205
00:18:45,560 --> 00:18:48,120
انخفض ضغط دمه لـ 25

206
00:18:50,340 --> 00:18:52,980
استدعوا عائلته

207
00:19:01,410 --> 00:19:02,700
سرطان مرحلة متأخّرة

208
00:19:03,240 --> 00:19:05,920
ليس هنالك ما نستطيع مساعدته به

209
00:19:06,890 --> 00:19:10,200
سيتباطأ تنفّسه أكثر فأكثر

210
00:19:12,190 --> 00:19:14,590
من المذهل بقاؤه حيّاً حتّى الآن

211
00:19:16,380 --> 00:19:19,950
أنا آسف، لكن حان وقت توديعكم له

212
00:20:45,680 --> 00:20:52,600
موكايدو ناناتو، إنسانٌ فقد الأمل بالحياة
وكان ينتظر موته بامتثال

213
00:20:54,270 --> 00:20:56,310
أدهشتني

214
00:20:56,920 --> 00:21:00,960
اكتسب الكثير من البشر أجنحةً
،وأسهماً حتّى الآن

215
00:21:02,130 --> 00:21:06,700
لكن أن يضحّي شخصٌ بهذا القدر
،من نفسه لعائلته

216
00:21:06,700 --> 00:21:09,880
...ويموت راضياً بحياته

217
00:21:10,830 --> 00:21:13,330
لا أعرف شخصاً وصل ذلك من قبل

218
00:21:14,900 --> 00:21:16,710
هذا بفضلكما

219
00:21:19,180 --> 00:21:21,590
خذا هذا السهم وهذه الأجنحة

220
00:21:21,590 --> 00:21:26,040
أبقيا آمال موكايدو ناناتو
وأحلامه في قلبيكما

221
00:21:35,240 --> 00:21:37,100
سنودّعكِ أيضاً يا باري

222
00:21:37,100 --> 00:21:38,360
لا تقلقي

223
00:21:39,060 --> 00:21:43,580
فلديكِ ريفيل، ملاكٌ بمعرفة تفوق معرفتي حتّى

224
00:21:49,010 --> 00:21:53,420
حسناً، هيّا بنا يا موكايدو ناناتو

225
00:22:01,080 --> 00:22:08,200
لا تقلقي، ستتبعكِ ناناكا فوراً

226
00:22:09,660 --> 00:22:14,080
وأعدكِ بأن أرجع أيضاً