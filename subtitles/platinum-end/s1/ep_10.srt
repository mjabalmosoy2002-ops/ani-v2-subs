1
00:00:00,350 --> 00:00:06,000
(البرنامج التالي موجّه للجمهور البالغ فقط)

2
00:00:00,610 --> 00:00:03,510
!آيا! ناناكا

3
00:00:06,690 --> 00:00:07,620
هذا هو المكان

4
00:00:07,620 --> 00:00:08,950
إنّها حديقة ملاهي

5
00:00:08,950 --> 00:00:10,460
!أين هما؟

6
00:00:10,750 --> 00:00:12,070
!آيا! ناناكا

7
00:00:12,070 --> 00:00:15,960
!ميتروبوليمان، أتيتُ كما أردتْ

8
00:00:23,910 --> 00:00:25,470
إنّه ذاك الشخص

9
00:00:28,600 --> 00:00:30,850
!آيا! ناناكا! إنّهما على قيد الحياة

10
00:00:31,850 --> 00:00:33,350
!آيا! ناناكا

11
00:00:33,350 --> 00:00:34,620
!هنا

12
00:00:36,320 --> 00:00:37,740
إنّها مرآة أحاديّة الاتّجاه

13
00:00:37,740 --> 00:00:39,760
!سآتي لإنقاذكما

14
00:00:40,220 --> 00:00:42,290
!لا تدخل يا موكايدو-سان

15
00:00:43,480 --> 00:00:44,640
دخل

16
00:00:48,220 --> 00:00:52,650
مضحك، لا-لا أصدّق أنّه
دخل بتلك البساطة

17
00:00:52,650 --> 00:00:56,240
الـ-الرهائن فعّالون حقّاً

18
00:00:56,590 --> 00:00:59,160
لكنّه لن يخرج بعدما دخل هناك

19
00:00:59,160 --> 00:01:03,130
هذه نقطة الجذب المُطلقة
!للقبض على مرشّحي الإله

20
00:01:03,130 --> 00:01:04,620
!مضحك

21
00:01:04,620 --> 00:01:09,290
أهو مرتبط بميتروبوليمان؟ لا بدّ أنّه
كان ليقتله لو كان مرشّح إله

22
00:01:09,290 --> 00:01:12,920
مما يعني أنّه بشريّ عاديّ أصابه
بسهمٍ أحمر على الأرجح

23
00:01:13,250 --> 00:01:15,930
...لا يمكنني إصابته بسهمٍ أحمر، لكن

24
00:01:16,900 --> 00:01:18,430
عليّ أن أجرّب

25
00:01:19,130 --> 00:01:20,430
!آيا! ناناكا

26
00:01:20,650 --> 00:01:21,740
أأنتما بخير؟

27
00:01:22,600 --> 00:01:25,550
أهنالك رجلٌ تحبّينه غيري الآن؟

28
00:01:25,550 --> 00:01:28,010
ما الذي تقوله في وقتٍ كهذا؟

29
00:01:28,330 --> 00:01:29,650
!أتحبّيني؟

30
00:01:29,650 --> 00:01:32,190
أ-أجل، أحبّك

31
00:01:33,320 --> 00:01:35,820
جيّد، لم يصبك بالسهم

32
00:01:34,930 --> 00:01:36,320
حـ-حبّ؟

33
00:01:35,820 --> 00:01:36,930
ماذا؟

34
00:01:37,110 --> 00:01:40,110
تـ-تحبّه؟

35
00:01:40,110 --> 00:01:42,240
...حبّ... حبّ

36
00:01:42,240 --> 00:01:45,340
ما هو... الحبّ؟

37
00:01:45,830 --> 00:01:46,790
!أنت

38
00:01:50,290 --> 00:01:51,170
أبيض؟

39
00:01:52,570 --> 00:01:55,000
ميراي-كن يستعمل سهمه الأبيض

40
00:03:26,510 --> 00:03:29,100
!أطلق سراحهم، وإلّا سأطلق عليك

41
00:03:29,100 --> 00:03:33,100
ظـ-ظننتك جباناً لا يستطيع
إطلاق سهمه الأبيض

42
00:03:43,070 --> 00:03:46,780
!وشيك

43
00:03:50,790 --> 00:03:52,460
لا بأس

44
00:03:52,460 --> 00:03:53,540
فهمت

45
00:03:53,540 --> 00:03:58,220
،إذا أظهر سهمه الأبيض له قبل إطلاقه
فسيعرف أنّه سيستطيع تفاديه

46
00:03:58,770 --> 00:04:01,680
كيفما كان استعماله، فقد أطلق سهمه الأبيض

47
00:04:01,680 --> 00:04:03,050
!فعلها

48
00:04:03,050 --> 00:04:05,430
موكايدو-سان! أتسمعني؟

49
00:04:05,840 --> 00:04:08,180
أجل، بالكاد

50
00:04:08,180 --> 00:04:11,090
لا نعرف أين يختبئ العدوّ هنا

51
00:04:11,090 --> 00:04:12,390
لا يمكننا الدفاع عن أنفسنا

52
00:04:12,390 --> 00:04:14,310
!نحن في موضع خاسر كليّاً

53
00:04:18,470 --> 00:04:19,320
كما توقّعت

54
00:04:19,730 --> 00:04:23,320
نا-ناناتو-كن، من أين جلبت هذه المسدّسات؟

55
00:04:23,540 --> 00:04:26,520
ما-ما الذي يجري؟

56
00:04:26,520 --> 00:04:27,320
...أبي

57
00:04:27,320 --> 00:04:29,240
أعتذر على توريطكما

58
00:04:29,870 --> 00:04:34,330
حتّى لو استطعنا الخروج، لا يمكنني
حملهما معاً أثناء الطيران

59
00:04:35,010 --> 00:04:35,900
تبّاً

60
00:04:35,900 --> 00:04:41,800
على هذا النحو، سأكون أباً فاشلاً
ومرشّح إلهٍ فاشل

61
00:04:43,180 --> 00:04:47,680
هاجيمي-كن، اجعل ملاكك
يتبعك بعد 10 ثوانٍ

62
00:04:47,680 --> 00:04:52,840
،ودعه يظهر نفسه عشرين قدماً في الهواء
عشرون متراً شمال منزل المرايا

63
00:04:52,840 --> 00:04:54,980
فـ-فهمت

64
00:04:54,980 --> 00:04:57,140
...بـ-بوليمان-سينباي

65
00:04:57,140 --> 00:04:58,370
ماذا؟

66
00:04:58,370 --> 00:05:02,460
استدرجتُه للصندوق، اجعلني خادمك
الآن من فضلك

67
00:05:04,350 --> 00:05:08,170
فهمت، سأثبت لك الآن

68
00:05:16,340 --> 00:05:18,750
!ملاك؟ إنّه مرشّح إلهٍ إذاً

69
00:05:18,750 --> 00:05:19,840
!خلفك

70
00:05:21,810 --> 00:05:23,170
ميتروبوليمان

71
00:05:26,800 --> 00:05:29,890
ظـ-ظهر بوليمان-سينباي

72
00:05:31,320 --> 00:05:34,560
أ-أنا ممتنٌّ لهذه السعادة

73
00:05:34,560 --> 00:05:37,210
،رغم أنّه مرشّح إله

74
00:05:37,210 --> 00:05:39,960
إلّا أنّ ميتروبوليمان أصابه
بسهمٍ أحمر بدل قتله

75
00:05:39,960 --> 00:05:43,640
انقضى أمركم مُذ دخل موكايدو الصندوق

76
00:05:44,020 --> 00:05:46,820
سنستطيع قتله على الأقل
في أسوأ الأحوال

77
00:05:48,820 --> 00:05:51,330
إذاً... هل أطلق عليه؟

78
00:05:51,330 --> 00:05:54,330
ما الذي يجري في الخارج؟

79
00:05:55,130 --> 00:05:58,330
إذا أصاب موكايدو-سان بسهمٍ
أبيض، فستكون النهاية

80
00:05:58,740 --> 00:06:02,590
اهرب، سئمتُ من قتالك

81
00:06:04,220 --> 00:06:06,590
لا تنوي قتالنا بالتأكيد، صحيح؟

82
00:06:06,590 --> 00:06:08,480
إنّها اثنان ضدّ واحد

83
00:06:08,480 --> 00:06:12,100
العناد والحظّ اللذين أبديتهما المرّة الفائتة
لن يكفيا هذه المرّة

84
00:06:12,350 --> 00:06:16,350
أخبرتك بإمكانك الهرب، ستنجو بحياتك إن فعلت

85
00:06:18,020 --> 00:06:19,100
...لا أريد

86
00:06:19,100 --> 00:06:20,230
ماذا؟

87
00:06:21,020 --> 00:06:22,780
لا أريد أن يموت أحد

88
00:06:23,220 --> 00:06:24,480
لن أسمح بذلك

89
00:06:34,110 --> 00:06:35,520
دخل

90
00:06:36,720 --> 00:06:38,020
موكايدو-سان

91
00:06:38,020 --> 00:06:41,610
احمل زوجتك وطر بسرعة تفوق
رؤية العين داخل هذا الصندوق

92
00:06:41,610 --> 00:06:42,810
سأفعل ذلك مع ابنتك

93
00:06:42,810 --> 00:06:43,880
لمَ في الداخل؟

94
00:06:44,250 --> 00:06:45,380
للنجاة

95
00:06:46,380 --> 00:06:49,750
إنّها الطريقة الوحيدة لنستطيع نحن
الأربعة تفادي التعرّض للقتل

96
00:06:55,330 --> 00:06:57,170
لا أستطيع رؤيتهم

97
00:06:57,640 --> 00:06:59,560
حُسِم أمرهم الآن

98
00:07:00,030 --> 00:07:03,120
كلّ ما علينا هو انتظار إصابتهما بالإرهاق

99
00:07:03,120 --> 00:07:04,650
إنّهما غبيّان بحقّ

100
00:07:04,990 --> 00:07:08,400
لكن، لـ-لمَ قد يفعل موكايدو ذلك؟

101
00:07:09,230 --> 00:07:11,910
لحبّه لعائلته على الأرجح

102
00:07:14,520 --> 00:07:16,660
حبّه... لعائلته؟

103
00:07:18,140 --> 00:07:21,450
ما معنى حبّ العائلة؟

104
00:07:22,840 --> 00:07:25,350
!ما معناه؟! إنّه يغيظني لسببٍ ما

105
00:07:26,170 --> 00:07:29,970
كلّا، عليّ ألّا أفقد تماسكي
أمام بوليمان-سينباي

106
00:07:30,200 --> 00:07:32,940
ألم تقولي أنّ موتي سيسرّكِ كثيراً؟

107
00:07:32,940 --> 00:07:35,970
وشيئاً عن قتل شريكك لي؟

108
00:07:36,380 --> 00:07:40,840
إنّها مسألة وقتٍ الآن فحسب
قبل أن يموت شريكك ذاك

109
00:07:40,840 --> 00:07:41,980
يا للطرافة

110
00:07:43,350 --> 00:07:44,700
ما الخطب؟

111
00:07:44,700 --> 00:07:48,870
،أعرف أنّ الملائكة لا يستطيعون التدخّل مباشرةً
لكن أحتّى لسانك معقودٌ اليوم؟

112
00:07:51,030 --> 00:07:57,490
حسناً يا هاجيمي-كن، أخبرني متى توقّفا
عن الحركة، وسآتي لإصابتهما بالسهم الأبيض

113
00:07:57,490 --> 00:07:59,600
ماذا؟ ستغادر؟

114
00:07:59,600 --> 00:08:03,180
بالطبع، لا حاجة لي للمكوث هنا حتّى يتوقّفا

115
00:08:03,180 --> 00:08:05,500
كما أنّي أشعر بالريبة بتواجدي حولك

116
00:08:06,290 --> 00:08:09,920
أتظن أنّي سـ-سأطلق عليك بسهم؟

117
00:08:09,920 --> 00:08:13,090
على المرء وضع كلّ الاحتمالات في الاعتبار

118
00:08:13,090 --> 00:08:16,010
يجب ألّا تتواجد حول مرشّحي إله بلا مبالاة

119
00:08:16,910 --> 00:08:18,510
كما يُتوقّع من بوليمان-سينباي

120
00:08:18,760 --> 00:08:20,520
حسناً، أعتمد عليك

121
00:08:26,050 --> 00:08:27,730
ألديك خطّة؟

122
00:08:27,730 --> 00:08:29,590
كلا، ليس لديّ

123
00:08:29,590 --> 00:08:31,700
لـ-ليس لديك؟

124
00:08:31,700 --> 00:08:35,070
،البقاء أحياء هو الأمر المهمّ
لا يمكننا فعل شيءٍ إن متنا

125
00:08:35,070 --> 00:08:36,990
!ولا حتّى التفكير بطريقة للهرب

126
00:08:37,340 --> 00:08:42,500
مـ-معك حقّ، لكنّي لا أدري لمتى سأستطيع الصمود

127
00:08:42,770 --> 00:08:46,000
إذا كان هنالك ما يمكننا فعله
!ونحن أحياء، فعلينا القيام به

128
00:08:52,760 --> 00:08:55,410
لمتى سيصمدان؟

129
00:08:57,160 --> 00:08:59,260
لم يملك خطّةً حقّاً

130
00:08:59,650 --> 00:09:02,750
لو لم يدخل، لنجا بنفسه

131
00:09:13,130 --> 00:09:17,030
كم مضى؟ لا أستطيع الإحساس
بالوقت الذي مرّ

132
00:09:17,560 --> 00:09:21,030
،لا يمكننا مواصلة الطيران للأبد
علينا التوقّف بنهاية المطاف

133
00:09:21,030 --> 00:09:24,040
ماذا نفعل؟ أهنالك طريقة للهرب؟

134
00:09:32,210 --> 00:09:34,470
لا تقلقي، لا داعي للخوف

135
00:09:37,830 --> 00:09:39,180
سأجرّب

136
00:09:39,420 --> 00:09:42,000
موكايدو-سان، قد تكون هنالك طريقةٌ للخروج

137
00:09:45,330 --> 00:09:50,440
بـ-بوليمان-سينباي، قال شيئاً
عن طريقة للخروج للتوّ

138
00:09:50,440 --> 00:09:53,810
لا تهلع، من المستحيل أن يستطيعوا الخروج

139
00:09:53,810 --> 00:09:55,570
سأخبرك بها

140
00:09:55,570 --> 00:09:59,120
انتظر، لا بدّ أنّهما يتنصّتان على محادثتنا

141
00:09:59,120 --> 00:10:01,510
إذا كانا يسمعاننا، فسيسهّل ذلك الفهم

142
00:10:01,510 --> 00:10:04,830
بعدما نخرج، لن يستطيعا الاستماع لمحادثتنا

143
00:10:05,230 --> 00:10:07,580
أو لصوت زوجتك أو صوت ناناكا-تشان

144
00:10:08,310 --> 00:10:09,540
فهمت

145
00:10:09,540 --> 00:10:11,220
حسناً، لنخرج

146
00:10:11,220 --> 00:10:12,460
!ها نحن

147
00:10:26,690 --> 00:10:28,900
قد يكون هذا مثيراً

148
00:10:28,900 --> 00:10:32,610
الطريقة الوحيدة للتيقّن
من وجودهما في الداخل

149
00:10:32,610 --> 00:10:35,530
هو عبر رؤية ما نفعله نحن، ملاكيهما

150
00:10:36,920 --> 00:10:41,410
هـ-هل خرجوا؟ لا أشعر أنّهم فعلوا

151
00:10:43,030 --> 00:10:46,910
،يصمتون ويتظاهرون أنّهم خرجوا
يا للخطّة الطفوليّة

152
00:10:47,140 --> 00:10:52,420
فـ-فهمت، هـ-هذه الخطّة اليائسة
هي خيارهما الوحيد

153
00:10:52,420 --> 00:10:54,570
صحيح، أنصت لي

154
00:10:54,570 --> 00:10:57,570
،مهما يحصل، فحتّى نقتلهما

155
00:10:57,570 --> 00:11:00,430
لا تحاول التحقّق من تواجدهما في الداخل

156
00:11:00,820 --> 00:11:03,810
كلّ ما علينا فعله هو عدم فتح الصندوق

157
00:11:03,810 --> 00:11:05,410
حـ-حاضر

158
00:11:15,600 --> 00:11:17,710
بـ-بوليمان-سينباي

159
00:11:17,710 --> 00:11:18,500
ما الأمر؟

160
00:11:18,500 --> 00:11:21,410
مضى نصف يومٍ مذ دخلا

161
00:11:21,410 --> 00:11:24,030
هما موجودان في الداخل حقّاً، صحيح؟

162
00:11:24,510 --> 00:11:28,920
تقصد أنّنا سنفعل ما يريدانه
إن فكّرنا بذلك، صحيح؟

163
00:11:28,920 --> 00:11:32,420
!آ-آسف! كان عليّ ألّا أسأل

164
00:11:48,530 --> 00:11:49,890
بوليمان-سينباي

165
00:11:49,890 --> 00:11:50,760
ما الخطب؟

166
00:11:50,760 --> 00:11:53,810
لا أرى ملاكيهما، ما معنى هذا؟

167
00:11:53,810 --> 00:11:55,700
"إنّها رسالة: "ليسا في الداخل

168
00:11:55,700 --> 00:11:59,760
أنا متأكّدٌ أنّ ملاكيهما سيساعدان إن
كانت هنالك فرصة بإيهامنا بذلك

169
00:12:00,130 --> 00:12:01,470
!فـ-فهمت

170
00:12:01,470 --> 00:12:04,570
خـ-خطر لي أن أبلّغ بأيّ حال

171
00:12:06,810 --> 00:12:09,950
ليس من الواضح ما الذي
يفكّر به بالتا

172
00:12:09,950 --> 00:12:14,110
أجل، لا يبدو أنّه مهتمٌ لحركتنا

173
00:12:14,110 --> 00:12:16,840
لا يحاول البحث عنّا
حتّى ونحن هنا

174
00:12:20,380 --> 00:12:23,310
...بـ-بوليمان-سينباي

175
00:12:23,310 --> 00:12:25,210
من جديد؟ ماذا الآن؟

176
00:12:25,210 --> 00:12:29,790
الـ-الصندوق مقفل، لا بدّ أنّه حارٌ في الداخل

177
00:12:29,790 --> 00:12:34,850
ظلّا يطيران دون شـ-شرب الماء طوال الوقت

178
00:12:34,850 --> 00:12:37,620
ذلك مـ-مبهر، صحيح؟

179
00:12:38,390 --> 00:12:41,850
سيموتان إذا توقّفا عن الحركة، إنّهما يائسان

180
00:12:42,880 --> 00:12:44,720
سأستريح قليلاً

181
00:12:44,720 --> 00:12:48,870
اتّصل بي إذا توقّفا عن الحركة
أو طرأ أيّ تغيير فحسب

182
00:12:49,110 --> 00:12:50,150
واضح؟

183
00:12:50,150 --> 00:12:51,690
حـ-حاضر

184
00:12:52,640 --> 00:12:54,610
سوكوتاني هاجيمي

185
00:12:54,610 --> 00:12:58,400
كنتُ متوقعاً، لكنّه عديم الجدوى حقّاً

186
00:13:06,970 --> 00:13:10,520
يكاد رأسي... ينفجر

187
00:13:26,040 --> 00:13:29,410
ساكي، أبقيتِ تنتظرينهما طوال الليل؟

188
00:13:31,370 --> 00:13:34,080
لم يرجعا

189
00:13:35,550 --> 00:13:40,550
موكايدو-سان وعائلته، وكاكيهاشي-كن

190
00:13:40,550 --> 00:13:42,590
إنّهم على قيد الحياة، صحيح؟

191
00:13:43,630 --> 00:13:46,790
...لا بدّ أنّهم يقاتلون لحياتهم الآن

192
00:13:47,670 --> 00:13:49,720
...بينما أنا

193
00:13:49,930 --> 00:13:50,970
...لكن

194
00:13:50,970 --> 00:13:53,170
!لا يمكنك القتال بلا أجنحة

195
00:13:55,060 --> 00:13:56,980
لا أستطيع مساعدتهما بشيء

196
00:13:58,390 --> 00:14:03,170
لا بأس يا ساكي، سأجتهد وأصبح
ملاكاً من الرتبة الأولى

197
00:14:03,540 --> 00:14:04,990
شكراً لك يا ريفيل

198
00:14:05,560 --> 00:14:09,490
لكن لا بأس، سأذهب لهم

199
00:14:10,380 --> 00:14:11,590
...ساكي

200
00:14:12,530 --> 00:14:14,370
سأقاتل ولو لم أمتلك أجنحة

201
00:14:14,370 --> 00:14:17,410
لا يمكنك يا ساكي! أنتِ تكرّرين ما فعلتِه آنذاك

202
00:14:17,410 --> 00:14:19,670
فقدتِ ثقتكِ لشعورك بالعجز

203
00:14:19,870 --> 00:14:21,920
ستُقدمين على خطأٍ كبير

204
00:14:22,330 --> 00:14:24,550
...لكن على هذا النحو

205
00:14:25,420 --> 00:14:28,120
أفهمك، أنا في نفس موقفك

206
00:14:28,690 --> 00:14:32,220
،لو أصبحتُ ملاكاً من الرتبة الأولى
سأستطيع منحكِ أجنحة

207
00:14:32,220 --> 00:14:34,560
وأمدّكِ بالأمل

208
00:14:35,580 --> 00:14:38,380
...لكن لأنّي ضعيف القوى

209
00:14:39,650 --> 00:14:40,870
...ريفيل

210
00:14:41,490 --> 00:14:45,110
آسفٌ يا ساكي لكوني ملاكاً عديم الفائدة

211
00:14:45,110 --> 00:14:47,450
ر-ريفيل؟

212
00:14:49,770 --> 00:14:51,110
...دموعك

213
00:14:53,020 --> 00:14:55,830
ماذا؟ هذا غريب

214
00:14:56,470 --> 00:14:58,670
لا يبكي الملائكة

215
00:14:59,330 --> 00:15:06,010
ورد في الكتب السماويّة أنّ البشر
وحدهم من يستطيعون البكاء للغير

216
00:15:08,170 --> 00:15:10,340
ما-ما هذا؟

217
00:15:12,790 --> 00:15:17,180
تبّاً، تشوّش بصري... ووعيي يتلاشى

218
00:15:19,140 --> 00:15:23,180
...أهذه النهاية؟ دون معجزةٍ ما، فلن نستطيع

219
00:15:24,070 --> 00:15:25,060
...آيا

220
00:15:25,990 --> 00:15:27,080
...ناناكا

221
00:15:27,980 --> 00:15:29,150
آسف

222
00:15:30,490 --> 00:15:35,410
يا للسخرية، أصبحتُ في هذا الوضع
،لأنّي تمسّكتُ بملاك

223
00:15:36,430 --> 00:15:40,000
لكن أمام الموت، ألجأ للربّ

224
00:15:41,340 --> 00:15:42,870
...ريفيل

225
00:15:43,810 --> 00:15:45,210
ريفيل

226
00:15:45,210 --> 00:15:46,000
الإله؟

227
00:15:46,770 --> 00:15:50,010
ذرفت دموعاً

228
00:15:50,010 --> 00:15:51,850
أ-أجل

229
00:15:52,170 --> 00:15:56,200
بعدما ذرفتُ دموعاً، لا أستحقّ أن أكون ملاكاً

230
00:15:56,200 --> 00:16:02,020
لا سابقة لهذا، لم يتمكّن ملاك
قبلك من بلوغ ما بلغته

231
00:16:02,730 --> 00:16:09,030
أنت أوّل ملاك يذرف دموعاً لبشريّ

232
00:16:09,910 --> 00:16:15,860
أصبحت ملاكاً يفهم مشاعر البشر
ويستطيع التعاطف معهم

233
00:16:15,860 --> 00:16:17,910
مشاعر البشر؟

234
00:16:18,630 --> 00:16:23,630
:أنت الآن ملاكٌ من الرتبة الأولى، ستحمل هذا اللقب

235
00:16:26,030 --> 00:16:29,550
ملاك المشاعر ريفيل

236
00:16:31,330 --> 00:16:33,550
ملاك المشاعر؟

237
00:16:34,300 --> 00:16:36,650
أصبحتُ ملاكاً برتبة أولى

238
00:16:37,760 --> 00:16:39,890
خذيها يا ساكي

239
00:16:47,960 --> 00:16:48,710
ريفيل

240
00:16:48,710 --> 00:16:50,190
ساكي، هيّا بنا

241
00:16:50,520 --> 00:16:52,070
لميراي والبقيّة

242
00:16:53,480 --> 00:16:54,570
أجل

243
00:17:00,460 --> 00:17:01,580
!ساكي-تشان

244
00:17:02,180 --> 00:17:04,120
ريفيل، نجحت

245
00:17:05,060 --> 00:17:07,070
باري، ما الوضع؟

246
00:17:07,070 --> 00:17:08,210
...إنّه

247
00:17:08,500 --> 00:17:11,460
عجباً، يبدو أنّكم اجتمعتم

248
00:17:11,720 --> 00:17:12,590
بالتا

249
00:17:12,980 --> 00:17:16,590
ريفيل-كن، تمّت ترقيتك للرتبة الأولى؟ مُبارك

250
00:17:16,840 --> 00:17:19,030
شخص مزعج آخر

251
00:17:19,030 --> 00:17:22,600
ملاك الحدس بالتا، ما الذي تنوي فعله؟

252
00:17:22,600 --> 00:17:26,430
سأقرّر ما أفعل بنفسي، عبر حدسي

253
00:17:26,430 --> 00:17:27,980
،ووفقاً لحدسي

254
00:17:27,980 --> 00:17:31,980
فالوافدة الجديدة تحمل مفتاح كلّ شيء

255
00:17:34,770 --> 00:17:36,480
ما قصدك؟

256
00:17:36,480 --> 00:17:39,620
أظنّ المعنى أن تفعلي
أيّ ما تريدين فعله

257
00:17:41,220 --> 00:17:42,530
...أنا

258
00:17:48,140 --> 00:17:53,760
ساكي، لا بدّ أنّ ميتروبوليمان أصابه
بسهمٍ أحمر، ستكشفين نفسكِ وحسب

259
00:17:53,760 --> 00:17:57,040
لا بأس يا ساكي-تشان، لمَ لا تجرّبي الإطلاق عليه؟

260
00:17:57,040 --> 00:18:00,050
انتبهي من أيّ كاميرات قد يستعملها
ميتروبوليمان للمراقبة فقط

261
00:18:08,040 --> 00:18:11,350
لا يزالان في الداخل، صحيح؟ لا يزالان يطيران؟

262
00:18:11,350 --> 00:18:12,770
لمَ هما يائسان لهذا الحدّ؟

263
00:18:13,340 --> 00:18:15,280
تطبيق إخراج الكاميرا، تشغيل

264
00:18:20,410 --> 00:18:22,780
حسنٌ، ما الذي سيجري؟

265
00:18:23,870 --> 00:18:27,540
ثلاثة كاميرات، المسافة: 29.2 متراً

266
00:18:27,540 --> 00:18:30,790
أ-أهذا لحبّه لعائلته؟

267
00:18:31,060 --> 00:18:34,210
أنا في منطقة عمياء له، أنا بخير

268
00:18:34,490 --> 00:18:38,420
!مُغيظ! مُغيظ

269
00:18:41,750 --> 00:18:42,750
!أصبته

270
00:18:42,750 --> 00:18:43,470
!ممتاز

271
00:18:46,900 --> 00:18:50,550
أصابني، من؟

272
00:18:51,450 --> 00:18:53,980
من؟ من؟

273
00:19:05,170 --> 00:19:07,130
...هذا الشعور

274
00:19:08,290 --> 00:19:10,000
هذا الشعور

275
00:19:10,480 --> 00:19:15,000
!الحبّ! أحبّ هذه الفتاة بأذنيّ القطّة

276
00:19:15,670 --> 00:19:18,260
!أحبّها... أحبّها

277
00:19:21,350 --> 00:19:24,510
...بـ-بوليمان-سينباي

278
00:19:26,310 --> 00:19:27,640
كلا، لا أستطيع

279
00:19:27,640 --> 00:19:31,410
أ-أنا خادم بوليمان-سينباي

280
00:19:32,120 --> 00:19:34,750
لديّ بوليمان سينباي

281
00:19:36,160 --> 00:19:38,650
!بوليمان-سينباي

282
00:19:39,070 --> 00:19:40,280
...ذاك الصوت

283
00:19:40,540 --> 00:19:41,530
ما الأمر؟

284
00:19:42,100 --> 00:19:47,120
...أ-أنا خادم بوليمان-سينباي

285
00:19:48,060 --> 00:19:50,540
...لكن... لكن

286
00:19:52,430 --> 00:19:54,540
...لكن تلك الفتاة

287
00:19:55,240 --> 00:19:58,240
!حبّي لها ينمو أكثر فأكثر

288
00:19:59,350 --> 00:20:01,230
شيءٌ ما يجري في الخارج؟

289
00:20:01,230 --> 00:20:05,050
،كلا، كلّ ما يفعلانه هو الانتظار
لديهما أفضليّة مهيمنة

290
00:20:05,560 --> 00:20:10,380
إن قاموا بحركة، ألن تكون لقتلنا وحسب؟

291
00:20:10,380 --> 00:20:15,010
تبّاً، لا بدّ من سنوح فرصةٍ ما
لنا للتصرّف

292
00:20:19,460 --> 00:20:21,180
آسف

293
00:20:21,180 --> 00:20:25,550
آيا، ناناكا... أنا آسف

294
00:20:26,140 --> 00:20:27,830
أنا سعيد

295
00:20:29,210 --> 00:20:32,100
يتسنّى لي الموت محاطاً بعائلتي التي أحبّها

296
00:20:32,100 --> 00:20:34,140
لا سعادة أكبر

297
00:20:34,140 --> 00:20:36,670
توجد أغنية قديمة لهذا أيضاً

298
00:20:36,670 --> 00:20:39,670
"لا يمكنك الموت قبلي"

299
00:20:39,670 --> 00:20:42,470
حتّى بعدي بيوم فلا بأس"، شيءٌ من ذلك السياق"

300
00:20:42,910 --> 00:20:45,670
أعرف أنّها أنانيّة منّي، لكنّكِ تفهميني، أليس كذلك؟

301
00:20:46,040 --> 00:20:48,040
حتّى لو وصفت بهذا الشكل، لا يمكنني

302
00:20:48,040 --> 00:20:49,220
لا يمكنك؟

303
00:20:49,220 --> 00:20:51,760
هلّا وعدتني بشيءٍ يا ناناتو-كن؟

304
00:20:51,760 --> 00:20:56,230
،وعد؟ لم يتبق لي وقتٌ طويل
لا أظنّ بإمكاني ترك التدخين

305
00:20:57,940 --> 00:20:59,230
لا تستسلم

306
00:21:01,250 --> 00:21:05,990
فلترِ ناناكا والجنين داخلي

307
00:21:06,550 --> 00:21:08,990
أنّك أبٌ مجتهد لم يفقد الأمل في الحياة

308
00:21:10,060 --> 00:21:12,690
حتّى آخر لحظاته

309
00:21:14,720 --> 00:21:16,670
!لا يمكنني الموت هنا

310
00:21:16,670 --> 00:21:21,160
،إذا عنى موتي قتلهم جميعاً

311
00:21:21,160 --> 00:21:23,760
!فلا يمكنني أن أموت هكذا قطعاً

312
00:21:31,980 --> 00:21:34,210
ما الأمر يا هاجيمي-كن؟

313
00:21:35,340 --> 00:21:36,770
لمَ لا تقول شيئاً؟

314
00:21:37,510 --> 00:21:42,150
أخبرتك أن تتواصل معي إذا توقّفا
عن الحركة، أو طرأ أمرٌ ما فقط

315
00:21:42,150 --> 00:21:43,170
فما الخطب؟

316
00:21:43,170 --> 00:21:48,660
خادمه... أ-أنا خادم بوليمان-سينباي

317
00:21:49,600 --> 00:21:54,180
...لـ-لديّ بلاغ، فـ-في الواقع

318
00:22:01,390 --> 00:22:03,350
!يا لظرافتها

319
00:22:03,350 --> 00:22:05,710
عليّ أن أجعله يحبّني قدر المستطاع

320
00:22:05,710 --> 00:22:08,000
وأوهمه أنّي أحبّه في المقابل

321
00:22:13,590 --> 00:22:15,910
!ما الخطب يا هاجيمي-كن؟

322
00:22:17,040 --> 00:22:18,440
أحبّها

323
00:22:22,940 --> 00:22:25,390
حُبّ؟ تحبّني؟

324
00:22:26,510 --> 00:22:29,430
...هـ-هذا... الحُبّ

325
00:22:30,150 --> 00:22:31,740
...حُبّ

326
00:22:33,400 --> 00:22:34,280
!حُبّ