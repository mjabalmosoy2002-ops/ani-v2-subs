1
00:00:00,350 --> 00:00:06,000
(البرنامج التالي موجّه للجمهور البالغ فقط)

2
00:00:04,100 --> 00:00:08,980
يا سادة، أنا أوصي بأحمر هذا
ليكون الإله

3
00:00:09,270 --> 00:00:15,220
رأيتُه يخاطر بحياته لإنقاذ
ملايين الناس

4
00:00:17,220 --> 00:00:21,750
يمتلك حسّاً بالعدالة، وتحلّى
بشجاعة مواجهة ميتروبوليمان

5
00:00:21,750 --> 00:00:25,200
!أرى أنّه ملائمٌ تماماً ليكون الإله

6
00:00:26,430 --> 00:00:28,570
أحمر هو بطلي

7
00:00:28,570 --> 00:00:30,640
أريده أن يصبح إلهاً

8
00:00:32,500 --> 00:00:34,640
تشاهدني، أليس كذلك يا أحمر؟

9
00:00:36,630 --> 00:00:40,780
أفضّل أن يصرّح أحمر بنفسه
عن رغبته بأن يصلح إلهاً

10
00:00:40,780 --> 00:00:46,020
،لكن حتّى لو لم يُظهر أحمر نفسه
سيُبرز بقيّة مرشّحي الإله أنفسهم

11
00:00:46,020 --> 00:00:48,890
وسنستطيع مناقشة من نريده
أن يصبح الإله

12
00:00:49,590 --> 00:00:50,910
هذا جنونيّ

13
00:00:50,910 --> 00:00:54,170
حقّاً؟ إنّه حلٌّ طفولي، لكن لا أرى سوءاً فيه

14
00:00:54,170 --> 00:00:56,530
استدراج أحدهم لك لتخرج
يكون فخّاً في العادة

15
00:00:57,630 --> 00:01:02,540
لكن لا أرى ضيراً من أن يبحث
الجميع عن مرشّحي الإله

16
00:01:02,910 --> 00:01:06,790
...أريد أن يُحدّد الإله سريعاً، وإلّا لن

17
00:01:08,930 --> 00:01:11,280
نتمكّن من العيش باطمئنان

18
00:01:13,190 --> 00:01:14,280
هذا جميل

19
00:01:14,280 --> 00:01:16,920
أتّفق معك تماماً يا سوسومو-كن

20
00:01:16,920 --> 00:01:21,210
إذا كان شخصاً بذاك اللطف، فيجب
أن يصبح أحمر إلهاً لأجلي أيضاً

21
00:01:21,570 --> 00:01:23,670
تساندين أحمر بدورك؟

22
00:01:24,460 --> 00:01:29,150
إنّه بطلٌ للعدالة، أليس كذلك؟
لا بدّ أنّه سيعامل الجميلات بلطف

23
00:01:29,150 --> 00:01:30,460
أخبرني يا يازيلي

24
00:01:30,460 --> 00:01:35,650
هل يتلقّى مرشّحو الإله السابقون
معاملةً خاصّة حتّى بعد اختيار الإله؟

25
00:01:35,650 --> 00:01:37,950
ذلك بيد الإله التالي

26
00:01:37,950 --> 00:01:43,120
له أن يمحي وجود مرشّحي الإله
وعمليّة الاختيار كأنّ شيئاً لم يكن

27
00:01:43,120 --> 00:01:47,470
مذهل، يمكن للإله فعل أيّ شيءٍ حقّاً

28
00:01:47,470 --> 00:01:48,950
...لكن

29
00:01:50,450 --> 00:01:53,990
صيد مرشّحي الإله على وشك البدء

30
00:03:26,360 --> 00:03:30,450
يبدو أنّه يريدك أن تصبح إلهاً

31
00:03:31,830 --> 00:03:36,860
إذا رشّح كافة مرشّحو الإله المتبقّون
كاكيهاشي-كن، أسيصبح إلهاً؟

32
00:03:36,860 --> 00:03:39,210
،من الضروريّ امتلاك دعم الجميع

33
00:03:39,210 --> 00:03:42,800
لكن يُشترط أن يريد مرشّح الإله نفسه
أن يصبح إلهاً

34
00:03:43,590 --> 00:03:47,270
واستعمال السهم الأحمر عليه
لجعله يقبل لن يُجدي بالطبع

35
00:03:47,270 --> 00:03:50,750
لكن إذا هدّدت بقتله بسهمٍ أبيض
،ما لم يصبح إلهاً

36
00:03:50,750 --> 00:03:53,050
ورضخ لأمرك، فلا بأس في ذلك

37
00:03:53,050 --> 00:03:54,750
ماذا؟ حقّاً؟

38
00:03:54,750 --> 00:03:55,740
...ناسّي

39
00:03:55,740 --> 00:03:58,140
ماذا؟ هل قلتُ أمراً سيّئاً؟

40
00:03:58,870 --> 00:03:59,760
...هذا الصبيّ

41
00:04:00,950 --> 00:04:05,390
،يبدو أنّه يخبرنا بكلّ شيء
لكن هنالك أمرٌ تلافى ذكره

42
00:04:07,700 --> 00:04:10,520
امتلاكه لسهمٍ أبيض

43
00:04:14,120 --> 00:04:16,690
وافق تلفاز ساكورا على مساعدتنا

44
00:04:16,690 --> 00:04:18,100
نحن جاهزون

45
00:04:19,140 --> 00:04:20,270
انطلقوا

46
00:04:21,770 --> 00:04:23,590
إنّه إيدا-كن

47
00:04:23,590 --> 00:04:28,980
آسف، أظهرتُ وجه إيدا-كن على
التلفاز، لذا عليّ الاعتذار فوراً

48
00:04:28,980 --> 00:04:30,770
سأرسل له رسالة

49
00:04:38,150 --> 00:04:41,250
...المعذرة، سوسومو-كن

50
00:04:41,880 --> 00:04:42,980
ما الأمر؟

51
00:04:42,980 --> 00:04:46,390
...لمَ تريد أن

52
00:04:56,310 --> 00:04:58,730
،أخبرتكم بأن تبحثوا عن مرشّحي الإله

53
00:04:58,730 --> 00:05:01,690
لكن محاولة القبض عليّ
هي نقيض ذلك

54
00:05:01,690 --> 00:05:03,140
خاب أملي

55
00:05:03,510 --> 00:05:07,540
حسناً، فلتبحثوا يا متابعي التلفاز
عن مرشّحي الإله الآخرين أيضاً

56
00:05:15,800 --> 00:05:19,010
ا-اختفى! تبخّر بلمح البصر

57
00:05:19,010 --> 00:05:21,520
يعرف الجميع الآن وجود مرشّحي الإله

58
00:05:23,240 --> 00:05:25,820
ما الذي سيحلّ بنا؟

59
00:05:35,100 --> 00:05:37,730
ما الخطب يا ميناميكاوا-سينباي؟

60
00:05:37,730 --> 00:05:39,190
لا شيء

61
00:05:40,890 --> 00:05:44,900
،الكلام كثيرٌ مؤخراً عن مرشّحي الإله
لا يروقني ذلك

62
00:05:45,780 --> 00:05:51,030
جعل تونما رودريغيز النساء يقعن في حبّه
عبر سهمٍ أحمر، وقُتِل بسهمٍ أبيض

63
00:05:51,030 --> 00:05:55,000
فهمت، توضّحت الصورة الآن

64
00:05:56,170 --> 00:05:58,690
يُقال أنّك مرشّح إلهٍ أيضاً

65
00:05:58,690 --> 00:05:59,800
ماذا؟

66
00:05:59,800 --> 00:06:02,430
لا تعرف هاشتاغ "مرشّح إله"؟

67
00:06:02,430 --> 00:06:04,530
هاشتاغ "مرشّح إله"؟

68
00:06:04,530 --> 00:06:07,700
لم يمتلك طالب السنة الأولى في"
،أكاديميّة جوسو، ميناميكاوا ميزوكيو

69
00:06:07,700 --> 00:06:11,320
أي شعبيّة بين الفتيات سابقاً، لكنّه
.حصل على حبيبة ظريفة فجأةً

70
00:06:11,320 --> 00:06:14,440
لا بدّ أنّه مرشح إله
"يملك سهماً أحمراً

71
00:06:14,440 --> 00:06:18,390
توخّ الحذر حتّى
لا يُقبض عليك

72
00:06:26,080 --> 00:06:27,130
لـ-لنذهب

73
00:06:28,650 --> 00:06:29,820
ما الخطب؟

74
00:06:29,820 --> 00:06:31,890
أكان ذاك الشخص يراقبني؟

75
00:06:31,890 --> 00:06:33,820
أهو عميلٌ للحكومة أو ما شابه؟

76
00:06:33,820 --> 00:06:35,830
أهذا لأنّي كنت صديقاً لكانادي؟

77
00:06:38,570 --> 00:06:42,160
لا بدّ أنّ هنالك رؤساء دول
يريدون الاستحواذ عليهم

78
00:06:42,160 --> 00:06:45,100
الاغتيال سهلٌ لهم

79
00:06:45,100 --> 00:06:49,040
،إذا كان مرشّحو الإله موجودين حقّاً

80
00:06:49,040 --> 00:06:53,300
فيمكن أن يستبدلوا الأسلحة
النووية كدرعٍ مُطلق

81
00:06:57,860 --> 00:06:59,320
كان لذيذاً

82
00:06:59,320 --> 00:07:00,830
اكتفيت من الأكل؟

83
00:07:00,830 --> 00:07:02,490
أجل، شكراً على الطعام

84
00:07:03,190 --> 00:07:04,530
سأغسل الأطباق

85
00:07:06,630 --> 00:07:10,180
تمتّعنا بحياةٍ هادئة لما بدا
أنّها محض لحظةٍ عابرة

86
00:07:11,240 --> 00:07:15,240
ليتنا نعيش هكذا سويّاً للأبد

87
00:07:21,780 --> 00:07:25,160
اكتشاف أمر مرشّحي الإله
أغرق العالم في الفوضى

88
00:07:25,160 --> 00:07:27,140
الموضوع رائجٌ على الإنترنت

89
00:07:27,140 --> 00:07:29,980
يبدو أنّ الشرطة تحاول تعقّب
مرشّحي الإله

90
00:07:29,980 --> 00:07:32,780
وليس هم وحدهم، بل عملاء
من دول أخرى أيضاً

91
00:07:35,700 --> 00:07:36,660
لنهرب

92
00:07:37,290 --> 00:07:38,840
لنهرب معاً

93
00:07:38,840 --> 00:07:41,890
لنعش في مكانٍ
لا يعرفنا أحدٌ فيه

94
00:07:41,890 --> 00:07:45,660
لم أعد أرد القتال، أريد عيش
حياةٍ هادئةٍ معك

95
00:07:46,570 --> 00:07:51,210
لا شيء يُسعدني أكثر
من تواجدي معك يا كاكيهاشي-كن

96
00:08:00,220 --> 00:08:02,680
ساكي-تشان، لا يمكننا الهرب

97
00:08:03,860 --> 00:08:09,320
كنتُ أفكّر مليّاً فيما كان موكايدو-سان
ليفعله في هذا الوضع

98
00:08:11,400 --> 00:08:16,140
،لم يكن ليهرب، لذا لن أفعل أيضاً
وسأعيش حياتي صامداً

99
00:08:17,020 --> 00:08:22,440
لستُ متأكّداً بعد، لكنّي أستشعر
وجود سعادةٍ في منتهى الدرب

100
00:08:24,130 --> 00:08:25,380
لا تقلقي

101
00:08:25,380 --> 00:08:27,700
لن يتعرّف أحدٌ علينا
من التصوير فحسب

102
00:08:27,700 --> 00:08:29,840
والعالم يفيض بمعلومات
عن مرشّحي الإله

103
00:08:30,860 --> 00:08:33,360
لنذهب للمدرسة بشكلٍ طبيعيّ
عند بدء الفصل الثاني

104
00:08:33,360 --> 00:08:35,310
لن نثير الشبهة هكذا

105
00:08:35,310 --> 00:08:36,350
أجل

106
00:08:36,810 --> 00:08:39,420
سأفعل ما تقوله

107
00:08:41,760 --> 00:08:45,860
لا يزال مكان الصبيّ الذي دعا
نفسه بمرشّح الإله مجهولاً

108
00:09:00,620 --> 00:09:02,360
الفتيات يُعجبن بي أخيراً

109
00:09:02,360 --> 00:09:04,110
أنت تستعمل سهماً أحمراً، أليس كذلك؟

110
00:09:04,110 --> 00:09:07,290
هذا جنونيّ، تصبح مرشّح إله
فورما ترتفع شعبيّتك قليلاً

111
00:09:16,600 --> 00:09:19,790
لا بأس، الوضع كالمعتاد

112
00:09:23,230 --> 00:09:25,260
كالمعتاد

113
00:09:25,260 --> 00:09:27,060
أنت كاكيهاشي ميراي، صحيح؟

114
00:09:30,600 --> 00:09:33,410
ادخل السيّارة فوراً

115
00:09:45,030 --> 00:09:46,260
الشرطة؟

116
00:09:48,650 --> 00:09:51,870
قرّر المسؤولون اعتقال
كافّة مرشّحي الإله

117
00:09:54,230 --> 00:09:55,810
لكنّي أرفض ذلك

118
00:09:55,810 --> 00:09:57,000
ترفض؟

119
00:09:57,000 --> 00:09:58,970
من الخطأ اعتقالكم

120
00:09:59,500 --> 00:10:01,230
أذلك سهمٌ أحمر؟

121
00:10:03,070 --> 00:10:04,570
أهو أحمر أم أبيض؟

122
00:10:04,570 --> 00:10:07,470
،أهو ما يُوقع الناس في حبّك
أم ما يقتلهم؟

123
00:10:08,220 --> 00:10:11,790
إذا نزعت السهم، فهل تزول
مشاعر الحُب تلك؟

124
00:10:14,560 --> 00:10:18,800
يتواصل أحد أتباعي حالياً
مع هاناكاغو ساكي

125
00:10:32,200 --> 00:10:33,080
!ساكي-تشان

126
00:10:35,370 --> 00:10:38,950
...اقتربت... منّي فجأةً و

127
00:10:40,830 --> 00:10:42,950
هل أُصبتِ يا يوميكي؟

128
00:10:44,990 --> 00:10:47,660
من أكثر من تحبّينه الآن؟

129
00:10:57,610 --> 00:10:58,740
آسفة

130
00:11:00,010 --> 00:11:02,110
من أحبّه الآن

131
00:11:02,810 --> 00:11:04,480
هي هاناكاغو ساكي-سان

132
00:11:05,550 --> 00:11:07,110
مُبهر

133
00:11:07,900 --> 00:11:12,870
يوميكي تابعتي المُخلصة، لكنّنا
وعدنا بأن نمضي حياتنا معاً أيضاً

134
00:11:12,870 --> 00:11:16,650
نقدّر ونثق ببعضنا
في حياتنا الخاصّة

135
00:11:16,650 --> 00:11:19,190
لا بأس، سترجع لطبيعتها بعد مضيّ شهر

136
00:11:19,190 --> 00:11:23,130
ليست مشكلة، هذا يؤكّد صدق
يويتو سوسومو

137
00:11:23,820 --> 00:11:27,110
أتصدّق ما قاله سوسومو-كن؟

138
00:11:27,110 --> 00:11:28,130
بالطبع

139
00:11:28,860 --> 00:11:31,000
،أشكّ بأنّ العالم يصدّقه

140
00:11:31,000 --> 00:11:34,140
لكنّنا كنّا نجري تحقيقاً ونجمع أدلّة

141
00:11:35,840 --> 00:11:37,880
أنتم مُستهدفون

142
00:11:38,740 --> 00:11:41,630
،بدأت البلدان الأخرى بالتحرّك سلفاً

143
00:11:41,630 --> 00:11:43,550
كما بلادنا

144
00:11:44,860 --> 00:11:46,860
من أنت؟

145
00:11:48,810 --> 00:11:52,650
أنا هوشي ماسايا، أريد مساعدتكم

146
00:11:52,650 --> 00:11:53,940
مساعدتنا؟

147
00:11:53,940 --> 00:11:56,900
لم يتعرّف عليكما الناس
كمرشّحي إلهٍ بعد

148
00:11:57,390 --> 00:11:59,660
لكنّها مسألة وقت قبل
أن يحصل ذلك

149
00:12:00,710 --> 00:12:02,170
هلّا رافقتماني؟

150
00:12:03,270 --> 00:12:05,170
،أتفهّم حذركما

151
00:12:08,810 --> 00:12:13,220
لكن يمكنكما استعمال أجنحتكما
للهرب متى شئتما

152
00:12:16,560 --> 00:12:19,170
أُمرنا نحن الشرطة من قِبل الحكومة

153
00:12:19,170 --> 00:12:22,280
بالقبض على مرشّحي
الإله فور العثور عليهم

154
00:12:22,280 --> 00:12:25,690
اكتشفت يوميكي أنّكما
كنتما أحمر وصفراء

155
00:12:26,370 --> 00:12:29,930
لكن لا أحد آخر مشارك في التحقيق
يعرف الأمر باستثنائنا

156
00:12:31,810 --> 00:12:34,200
ما الذي تنويان فعله بنا؟

157
00:12:35,210 --> 00:12:36,850
أعيراني قوّتكما

158
00:12:36,850 --> 00:12:38,130
قوّتنا؟

159
00:12:38,860 --> 00:12:42,700
سنجد بقيّة مرشّحي الإله معاً

160
00:12:42,700 --> 00:12:45,440
أحتاج مساعدتكما للقيام بذلك

161
00:12:49,720 --> 00:12:51,910
مساعدتنا؟

162
00:12:51,910 --> 00:12:56,590
هل ستقومون بشيءٍ
لبقيّة مرشّحي الإله؟

163
00:12:57,080 --> 00:12:58,960
سأعيد كلامي

164
00:12:58,960 --> 00:13:03,290
يسعى محقّقون وجواسيس من مختلف
البلدان في العالم وراءكم

165
00:13:03,290 --> 00:13:06,360
ووراءك أنت تحديداً يا كاكيهاشي ميراي

166
00:13:07,850 --> 00:13:11,770
أحمر هو الوحيد الذي تمّ تأكيد
امتلاكه لسهمٍ أبيض حالياً

167
00:13:12,460 --> 00:13:15,740
تصبح كافّة سبل الاغتيال
ممكنةً بالأجنحة والأسهم

168
00:13:16,750 --> 00:13:20,250
أنت سلاحٌ قاتل، أعظم مُغتال في العالم

169
00:13:23,630 --> 00:13:26,990
استعمالك أنسب بكثير
من الأسلحة النووية

170
00:13:27,550 --> 00:13:30,010
ذلك ما هو أنت عليه الآن

171
00:13:32,820 --> 00:13:36,690
يمكن أن تسبّب قوّة قتل الناس
عند المشيئة أزمةً عالميّة

172
00:13:37,340 --> 00:13:39,000
أريد منع ذلك

173
00:13:39,560 --> 00:13:41,060
إذا قُبض عليك، ستكون النهاية

174
00:13:41,060 --> 00:13:44,050
لن تتردّد بعض الدول في غسل دماغك

175
00:13:44,050 --> 00:13:46,250
وتحويلك لسلاحٍ قاتل

176
00:13:47,030 --> 00:13:49,770
وقد لا يخطر لك ذلك، لكن لن تمانع
هذه البلاد فعل ذلك أيضاً

177
00:13:55,480 --> 00:13:59,240
...سلاح... قاتل

178
00:14:10,210 --> 00:14:14,360
لن أصبح كذلك، أبداً

179
00:14:18,680 --> 00:14:22,170
لدينا كاميرات مراقبة مثبّتة هنا، حراستنا مشدّدة

180
00:14:24,570 --> 00:14:27,170
أريدكما أن تختبئا هنا لفترة

181
00:14:41,670 --> 00:14:42,690
مرحباً؟

182
00:14:44,270 --> 00:14:45,280
كلا

183
00:14:47,330 --> 00:14:48,970
لم أجدهم بعد

184
00:14:50,630 --> 00:14:51,970
فهمت

185
00:14:53,710 --> 00:14:55,770
استدعانا نائب الرئيس، أنا وأنت يا يوميكي

186
00:14:55,770 --> 00:14:59,340
كلا، سأبقى هنا. أريد البقاء رفقة ساكي-سان

187
00:15:00,930 --> 00:15:03,080
فلتذهبي رجاءً يا يوميكي-سان

188
00:15:05,250 --> 00:15:07,590
حاضرة، إذا أردتِ ذلك يا ساكي-سان

189
00:15:08,880 --> 00:15:10,990
أهذه قوّة السهم الأحمر أيضاً؟

190
00:15:12,030 --> 00:15:15,560
حطّما هاتفيكما السابقين
واستعملا هذين الآن

191
00:15:18,890 --> 00:15:20,230
...لكن هذا المكان

192
00:15:21,050 --> 00:15:23,590
يوميكي مولعةٌ بك حالياً

193
00:15:23,590 --> 00:15:25,970
يجب أن تبقي هنا

194
00:15:25,970 --> 00:15:28,340
لن نرجع حتّى الليل غالباً

195
00:15:28,340 --> 00:15:31,360
فلتتفاديا الخروج حتّى حينها

196
00:15:34,690 --> 00:15:37,220
ما رأيكِ بهما؟

197
00:15:38,210 --> 00:15:39,750
لا أدري

198
00:15:40,560 --> 00:15:46,160
لكن لو أرادا القبض علينا، فهنالك
طرق أخرى لفعل ذلك

199
00:15:46,160 --> 00:15:47,230
أجل

200
00:15:48,680 --> 00:15:54,710
حتّى عندما أُصيبت يوميكي-سان بسهمٍ
أحمر، لم يتأثّر هوشي بذلك

201
00:15:54,710 --> 00:15:59,040
كأنّه قدّمها لنا كي يكسب ثقتنا

202
00:16:00,890 --> 00:16:04,370
،كنتُ خائفةً منهما في البداية

203
00:16:04,780 --> 00:16:09,050
لكن يمكنني أن أستشعر حياتهما السعيدة
التي بنياها معاً في هذه الغرفة

204
00:16:09,710 --> 00:16:13,340
لا أظنّهما يحاولان خداعنا

205
00:16:14,840 --> 00:16:16,310
ما رأيك يا ناسّي؟

206
00:16:16,310 --> 00:16:19,540
ماذا؟ لم يكن ذاك الشخص يكذب

207
00:16:19,540 --> 00:16:23,060
كما نريد معلوماتاً

208
00:16:25,220 --> 00:16:26,220
أجل

209
00:16:27,800 --> 00:16:32,910
ظننتكما ستكشفان أحمر وصفراء
بتحليل التصوير

210
00:16:32,910 --> 00:16:35,060
يوميكي هي الخبيرة، فستشرح

211
00:16:35,060 --> 00:16:38,430
الفيديو المقصود مشفّرٌ ليعارض أنظمة

212
00:16:38,430 --> 00:16:42,050
التعرّف على الوجه الحالية، ويمنع
التعرّف على الناس الظاهرين فيه

213
00:16:42,050 --> 00:16:44,580
نكرّس كلّ مواردنا لتحليل الصور حالياً

214
00:16:44,580 --> 00:16:46,960
فهمت، فلتسرعوا

215
00:16:46,960 --> 00:16:49,250
لا أرى حاجةً لذاك القلق

216
00:16:50,320 --> 00:16:53,460
لن يستهدف أحدٌ رئيس
وزراء هذا البلد

217
00:16:56,060 --> 00:16:59,200
أتيتِ بعذرٍ مبهر قابل للتصديق

218
00:16:59,200 --> 00:17:02,200
لا يمكنني أن أسمح
بتعرّض ساكي-سان للخطر

219
00:17:04,060 --> 00:17:06,740
لم يسبق وأن رأيتُ
هذه النظرة في عينيّ يوميكي

220
00:17:06,740 --> 00:17:10,980
هذه قوّة مرشّحي الإله، لا عجب أن
أصحاب السلطة يريدون الحصول عليها

221
00:17:12,020 --> 00:17:14,790
يُفترض ألّا تتواجد هكذا قوّة
في هذا العالم

222
00:17:14,790 --> 00:17:17,270
يجب ألّا يُسمح لأحدٍ بالحصول عليها

223
00:17:20,020 --> 00:17:20,950
أنا هوشي

224
00:17:28,130 --> 00:17:33,360
سنساعدكما، سنخبرك بكلّ ما نعرفه

225
00:17:33,360 --> 00:17:34,310
أأنت متأكّد؟

226
00:17:34,310 --> 00:17:35,210
أجل

227
00:17:35,210 --> 00:17:37,230
أقدّر ذلك

228
00:17:37,230 --> 00:17:40,390
قُبض على مرشّح إلهٍ للتوّ

229
00:17:41,450 --> 00:17:43,740
أريد إيجاد البقيّة
بأسرع ما يمكن

230
00:17:44,730 --> 00:17:46,800
أخبرنا بما لديكما أوّلاً

231
00:17:49,370 --> 00:17:50,620
هذا كلّ شيء

232
00:17:52,430 --> 00:17:56,900
،كلّما سمعنا عن قدرات مرشّحي الإله
كلّما بدت معقّدةً أكثر

233
00:17:56,900 --> 00:17:58,390
سأجلب لنا شراباً

234
00:17:59,230 --> 00:18:03,960
أي من الصحيح أنّ من أرادوا الموت
وحدهم اُختيروا ليكونوا مرشّحي إله

235
00:18:03,960 --> 00:18:07,910
وحصل هذا الفتى على أجنحةٍ
تمكّنه من الانتقال الآنيّ

236
00:18:07,910 --> 00:18:10,760
ويملك سهماً أبيضاً يمكن أن يقتل
عدداً لا متناهياً من الناس

237
00:18:11,850 --> 00:18:15,770
يمكن أن يكون كاكيهاشي ميراي
مرعباً أكثر مما ظننت

238
00:18:16,910 --> 00:18:21,280
لكن لم يسبق وأن أطلق
على أحدٍ بسهمه الأبيض

239
00:18:23,180 --> 00:18:27,690
مهما تدهور وضعه، احتفظ بتقديره للحياة البشريّة

240
00:18:28,300 --> 00:18:31,960
لا يمكن أن أسمح بأن يصبح هذا الشاب
في مقتبل العمر سلاحاً

241
00:18:33,490 --> 00:18:37,500
وفقاً لما أخبرتنا به، فيمكن أن
تُمنح يوميكي أجنحةً وأسهماً

242
00:18:37,500 --> 00:18:40,790
بما أنّها أُصيبت بسهم أحمر

243
00:18:40,790 --> 00:18:44,390
لكنّي لست مرتاحةً بتسليم
سهمٍ أحمر فوراً

244
00:18:44,390 --> 00:18:46,270
ماذا عن الأجنحة إذاً؟

245
00:18:46,270 --> 00:18:50,480
إذا أمكن تسليمها إيّاها في غضون الثلاثة وثلاثين
،يوماً فحسب وهي تحت تأثير السهم الأحمر

246
00:18:50,480 --> 00:18:52,500
فعلينا استغلال ذاك الوقت بفعاليّة

247
00:18:52,500 --> 00:18:55,640
...وما أكثر أهميّة، إذا مكّنها ذلك من رؤية الملائكة

248
00:18:56,190 --> 00:18:57,850
أريد رؤيتهم أيضاً

249
00:18:57,850 --> 00:19:01,050
،لا يمكنها معارضة رغبات ساكي
سيجعل ذلك البحث سهلاً

250
00:19:01,050 --> 00:19:02,070
صحيح؟

251
00:19:05,850 --> 00:19:07,190
حسناً

252
00:19:19,520 --> 00:19:22,270
أراهما، مخلوقان شبيهان بملائكة

253
00:19:22,270 --> 00:19:24,070
أفضّل لو دعيتنا بملاكين وحسب

254
00:19:24,070 --> 00:19:26,700
أنا ناسّي، وهذا ريفيل

255
00:19:27,360 --> 00:19:30,640
يدعوان نفسيهما بناسّي وريفيل

256
00:19:33,380 --> 00:19:34,490
هذا مُذهل

257
00:19:35,100 --> 00:19:37,710
ملائكة إذاً؟ ليتني أستطيع رؤيتهم

258
00:19:37,710 --> 00:19:40,760
لكن لا يمكننا إهدار الأسهم
في حال اضطررنا لاستعمالها لاحقاً

259
00:19:41,470 --> 00:19:43,700
أيمكنني طرح سؤال واحد على الملاكين؟

260
00:19:43,700 --> 00:19:44,500
لا بأس

261
00:19:45,170 --> 00:19:47,270
يقولان لا بأس

262
00:19:48,540 --> 00:19:50,500
من أنتم بالضبط؟

263
00:19:51,760 --> 00:19:53,970
لا يمكننا الكشف عن ذلك بعد

264
00:19:53,970 --> 00:19:55,700
الملائكة هم ملائكة

265
00:19:55,700 --> 00:19:57,690
الملائكة هم ملائكة" وفقما يبدو"

266
00:19:57,690 --> 00:20:02,300
فهمت، أعتذر على طرح سؤالٍ سخيفٍ كهذا

267
00:20:04,580 --> 00:20:07,520
انظرا لما أثمر به تحقيقنا

268
00:20:08,240 --> 00:20:12,160
تعرفون الكثير سلفاً عن ميتروبوليمان

269
00:20:14,880 --> 00:20:18,250
لم تكن يامادا ميمي هذه مرشّحة إله

270
00:20:18,250 --> 00:20:21,830
أعطاها ميتروبوليمان سهماً أحمراً

271
00:20:21,830 --> 00:20:23,240
هكذا إذاً

272
00:20:23,870 --> 00:20:26,600
أهذه من قلتم أنّكم قبضتم عليها؟

273
00:20:26,600 --> 00:20:27,540
أجل

274
00:20:27,540 --> 00:20:32,040
إنّها أوّل من ظهرت بعد
إعلان يويتو سوسومو

275
00:20:32,970 --> 00:20:36,550
تيماري يوري: امرأة في الثالثة والعشرين، عاطلة

276
00:20:38,330 --> 00:20:43,710
لا يزال هنالك مرشّحا إله مجهولان

277
00:20:43,710 --> 00:20:46,660
سنبدأ بحثنا عن مرشّحي الإله غداً

278
00:20:47,390 --> 00:20:51,210
يمرّ العالم بفوضى
لا سابق لها الآن

279
00:20:51,210 --> 00:20:54,960
الحروب والمجاعات وحالات الطقس
الغريبة على نطاقٍ عالميّ

280
00:20:54,960 --> 00:20:59,420
وصلنا مرحلةً لا تكفي فيها
قوّة البشريّة لإصلاح كلّ شيء

281
00:20:59,420 --> 00:21:04,570
!عندما أصبح إلهاً، سيكون كلّ الناس سعداء

282
00:21:12,260 --> 00:21:15,930
ا-اختفى؟! ألم يكن هناك شخصٌ للتوّ؟

283
00:21:16,760 --> 00:21:18,420
لا يبدو أنّه أحدهم أيضاً

284
00:21:19,380 --> 00:21:21,290
...هوشي-سان، هذا الشخص

285
00:21:22,220 --> 00:21:24,230
ميناميكاوا ميزوكيو

286
00:21:24,230 --> 00:21:28,980
"ذكرت تغريدةٌ ملحق بها هاشتاغ "مرشّح إله
أنّه حصل على حبيبةٍ ظريفةٍ فجأة

287
00:21:29,370 --> 00:21:33,580
ذلك شائع، لكن من المثير للاهتمام
أنّه زميلٌ لأوريو كانادي

288
00:21:33,580 --> 00:21:34,570
أجل

289
00:21:35,120 --> 00:21:36,070
انظرا هنا أيضاً

290
00:21:36,560 --> 00:21:38,990
طالبان في المتوسطة، الأخوان ناكاومي

291
00:21:38,990 --> 00:21:41,660
في غضون الثلاثة أشهرٍ الفائتة، تُوفي أبواهما

292
00:21:41,660 --> 00:21:44,620
وجدّهما وثلاثةٌ من أصدقائهما
الواحد تلو الآخر

293
00:21:44,620 --> 00:21:47,220
مات الكثير حولهما بالفعل

294
00:21:47,510 --> 00:21:49,250
المعذرة، يوميكي-سان

295
00:21:49,250 --> 00:21:49,950
أجل؟

296
00:21:51,280 --> 00:21:54,320
أرى أنّكِ قد تحتاجين
سهماً أحمراً بالفعل

297
00:21:57,610 --> 00:21:59,430
أأنتِ متأكّدةٌ أنّ هذا المكان مناسب؟

298
00:21:59,950 --> 00:22:03,170
لا أريد أن ترانا أمّي

299
00:22:03,170 --> 00:22:04,740
أودّ تقديم نفسي لها

300
00:22:04,740 --> 00:22:06,600
كلا، سيكون ذلك محرجاً

301
00:22:06,600 --> 00:22:08,000
محرج؟

302
00:22:08,000 --> 00:22:09,340
!كلا! ليس كذلك

303
00:22:09,340 --> 00:22:14,070
لا أشعر بالحرج بسببك، لكن إذا
...اكتشفت أنّ لديّ حبيب

304
00:22:17,920 --> 00:22:19,660
حسناً، أراك لاحقاً

305
00:22:22,830 --> 00:22:24,130
!رائع

306
00:22:24,130 --> 00:22:26,350
...رائع! را