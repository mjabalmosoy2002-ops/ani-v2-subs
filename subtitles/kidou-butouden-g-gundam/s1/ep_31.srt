.وأخذوا الجمهور رهائن

201
00:13:43,420 --> 00:13:46,340
!ماما! ماما! انتظري يا ماما! لا تذهبي

202
00:13:46,740 --> 00:13:52,600
!ماما

203
00:13:58,270 --> 00:13:59,900
...في خضمّ الهلع

204
00:13:59,900 --> 00:14:01,730
.أُخِذت كرهينة

205
00:14:02,940 --> 00:14:04,780
أتدرين كم كان ذلك مرعبًا؟

206
00:14:05,440 --> 00:14:06,530
ماذا عن أمّك؟

207
00:14:06,990 --> 00:14:09,000
.استمررت في سماع أصوات الطّلقات فحسب

208
00:14:09,990 --> 00:14:11,950
.لا أتخيّل أنّها ما زالت حيّة

209
00:14:11,950 --> 00:14:14,120
...وكلّما فكّرتُ في أمّي

210
00:14:14,660 --> 00:14:17,330
...أسمع صوت ذلك الرّجل وهو يضحك على الصبيّ

211
00:14:17,320 --> 00:14:18,580
.الّذي بقي لوحده

212
00:14:19,170 --> 00:14:20,380
...تشيبودي

213
00:14:22,170 --> 00:14:24,090
إنّها لقصّة تثير الشّفقة، صحيح؟

214
00:14:25,260 --> 00:14:26,920
.لا بأس. لا بأس

215
00:14:29,130 --> 00:14:31,600
.بما أنّني أخبرتك بهذا، لديّ معروف أسأله

216
00:14:32,370 --> 00:14:33,350
ماذا؟

217
00:14:33,640 --> 00:14:36,390
.هناك أغنية كانت أمّي تغنّيها لي

218
00:14:36,640 --> 00:14:37,390
أغنيّة؟

219
00:14:41,690 --> 00:14:43,860
.يجب أن ندع راين تتكفّل بالأمر

220
00:14:43,860 --> 00:14:45,480
.لكن ما باليد حيلة

221
00:14:45,480 --> 00:14:47,320
كيف يبليان ذلكما الاثنان؟

222
00:14:47,320 --> 00:14:48,990
.ليس أنت أيضًا يا شيرلي

223
00:14:48,990 --> 00:14:50,450
.أسمع شيئًا

224
00:14:51,820 --> 00:14:52,970
...الآن

225
00:14:53,910 --> 00:14:54,580
غناء؟

226
00:14:54,580 --> 00:14:55,580
.إنّه أغنيّة

227
00:14:55,580 --> 00:14:57,580
فكرةٌ عابرةٌ

228
00:14:58,860 --> 00:15:04,090
تطير في السّماء

229
00:15:05,960 --> 00:15:12,010
نعم أيّتها الرّوح الحنونة

230
00:15:13,260 --> 00:15:14,430
.ماما

231
00:15:13,260 --> 00:15:18,560
بسمتك ساطعة

232
00:15:14,430 --> 00:15:18,560
تريد أن تؤمن أنّ أمّك لا تزال حيّة، أليس كذلك؟

233
00:15:20,640 --> 00:15:26,730
متشبّثًا بشظيّة واحدة من الشّجاعة الكامنة

234
00:15:26,730 --> 00:15:36,330
تخفيها عمّن حولك

235
00:15:36,830 --> 00:15:40,020
تفيض

236
00:15:51,680 --> 00:15:52,680
.صباح الخير

237
00:15:53,590 --> 00:15:54,720
...عذرًا

238
00:15:54,720 --> 00:15:56,180
.لا تقولي كلمةً

239
00:15:56,470 --> 00:15:59,480
.أنا بخير. أنت الطّبيبة الأفضل

240
00:15:59,480 --> 00:16:02,190
.كما أنّني لا يمكنني أن أخسر الآن

241
00:16:02,190 --> 00:16:03,900
.ليس أمامهنّ

242
00:16:12,700 --> 00:16:15,420
...الآن، ها هنا في حلبة كوينز رود الشرقيّة

243
00:16:15,420 --> 00:16:18,330
.بدأنا نقترب من بداية مباراة اللّيلة

244
00:16:19,410 --> 00:16:21,460
.انظر. راين هناك

245
00:16:21,460 --> 00:16:22,410
.هناك

246
00:16:22,580 --> 00:16:25,270
لكن لمَ لا تأتي لنا؟

247
00:16:26,170 --> 00:16:27,420
...أتساءل

248
00:16:27,800 --> 00:16:28,630
!لكنّ هذا يقلقني

249
00:16:29,090 --> 00:16:29,710
!الآن

250
00:16:29,710 --> 00:16:32,380
.أوّل المقبلين إلى الحلبة هي غاندام ماكستر

251
00:16:32,380 --> 00:16:35,590
المقاتل، الرّجل ذو القبضتين
!الحارقتين، تشيبودي كروكيت

252
00:16:35,590 --> 00:16:36,600
...و

253
00:16:38,220 --> 00:16:38,970
ماذا؟

254
00:16:47,270 --> 00:16:49,070
...ها هو آتٍ على حبلٍ بهلوان

255
00:16:49,070 --> 00:16:51,240
!راكبًا على درّاجة هوائيّة، غاندام جيستر

256
00:16:51,490 --> 00:16:54,280
!هل تحاول أن تكون مضحكًا يا سيّد مهرّج؟

257
00:17:00,740 --> 00:17:02,660
!إنّه يستعرض

258
00:17:02,660 --> 00:17:04,420
!يجدر بها أن تكون مباراة شيّقة

259
00:17:05,000 --> 00:17:06,920
.سأهزمك بسرعة

260
00:17:07,330 --> 00:17:08,920
!قتال غاندام

261
00:17:09,630 --> 00:17:10,630
!استعداد

262
00:17:10,960 --> 00:17:11,920
!هيّا

263
00:17:14,880 --> 00:17:15,880
!تشيبودي

264
00:17:16,590 --> 00:17:18,390
هل تظنّين أنّه سيكون بخير؟

265
00:17:18,390 --> 00:17:19,720
.لا أدري

266
00:17:19,720 --> 00:17:21,560
...بما أنّ القتال بدأ الآن

267
00:17:21,560 --> 00:17:23,850
.لا يمكننا فعل أيّ شيء

268
00:17:26,020 --> 00:17:28,820
أتحاول صدّ هجماتي بالهجوم عليّ مباشرةً؟

269
00:17:36,110 --> 00:17:38,850
.إنّه يملك نفس حركات تشيبودي

270
00:17:38,850 --> 00:17:39,700
.أجل

271
00:17:41,080 --> 00:17:43,580
...خسرتُ مباراتي بسبب تلك التكتيكات نفسها

272
00:17:43,750 --> 00:17:46,500
.كان الأمر وكأنّني أقاتل نفسي

273
00:17:50,420 --> 00:17:52,710
إلى متى تنوي تقليدي؟

274
00:18:01,470 --> 00:18:03,060
!اخرس

275
00:18:07,770 --> 00:18:09,400
!ما هذا المسخ؟

276
00:18:11,480 --> 00:18:14,230
!كفّ عن الضّحك! كفّ عن الضّحك

277
00:18:15,940 --> 00:18:17,240
!تشيبودي

278
00:18:17,530 --> 00:18:19,950
!لا! لا يجب أن تفكّر في الأمر

279
00:18:20,320 --> 00:18:22,220
.لكنّه يضحك

280
00:18:22,220 --> 00:18:24,120
...مثل تلك المرّة

281
00:18:24,330 --> 00:18:27,030
!إنّه يضحك مثل تلك المرّة

282
00:18:30,250 --> 00:18:31,420
!ماما

283
00:18:38,800 --> 00:18:41,770
.ماما. إنّي وحدي وخائف

284
00:18:42,340 --> 00:18:43,220
.ماما

285
00:18:53,860 --> 00:18:54,440
...ماما

286
00:18:54,730 --> 00:18:55,690
!تشيبودي

287
00:18:55,990 --> 00:18:57,900
!...ماما... ماما

288
00:18:58,700 --> 00:18:59,410
.لا

289
00:18:59,410 --> 00:19:00,700
.إنّه هلع ثانيةً

290
00:19:00,700 --> 00:19:02,030
...على هذا الحال

291
00:19:02,030 --> 00:19:04,620
.لكن لا يوجد ما يمكننا فعله

292
00:19:08,280 --> 00:19:09,210
!رجاءً

293
00:19:09,540 --> 00:19:11,250
!يجب أن تغنّي تلك الأغنيّة

294
00:19:11,250 --> 00:19:14,920
.نعلم أنّك استطعت التّرويح عنه بغنائك لتلك الأغنيّة

295
00:19:15,380 --> 00:19:17,120
...هـ-هذا صحيح، لكن

296
00:19:22,640 --> 00:19:23,760
...دومون

297
00:19:28,640 --> 00:19:31,060
.أنا مع طاقم نيو يابان

298
00:19:31,810 --> 00:19:33,400
...من الآن فصاعدًا

299
00:19:33,400 --> 00:19:34,940
.عليكنّ التّعامل مع الأمر بأنفسكنّ

300
00:19:39,400 --> 00:19:40,610
لكن ما الّذي يمكننا فعله؟

301
00:19:43,410 --> 00:19:44,370
...تراجع

302
00:19:44,370 --> 00:19:46,700
.تراجع رجاءً

303
00:19:47,080 --> 00:19:47,870
...ماما

304
00:19:49,710 --> 00:19:51,250
!الأغنيّة

305
00:19:51,500 --> 00:19:52,210
!ماما

306
00:19:52,210 --> 00:19:54,840
متشبّثًا بشظيّة واحدة من الشّجاعة الكامنة

307
00:19:54,840 --> 00:20:04,600
تخفيها عمّن حولك

308
00:20:04,600 --> 00:20:09,350
...تفيض

309
00:20:09,600 --> 00:20:15,110
بعينين مدمعتين، أريد أن أقول لك

310
00:20:15,110 --> 00:20:17,990
...شيلي، كاث، باني، جانيت

311
00:20:18,780 --> 00:20:20,150
.أرى الأمر الآن

312
00:20:20,150 --> 00:20:22,950
.كنتنّ معي دائمًا، مثل أمّي

313
00:20:22,950 --> 00:20:24,950
.لا تخدعن أنفسكنّ

314
00:20:24,950 --> 00:20:28,080
...لن أدعكنّ تعاملنني

315
00:20:28,080 --> 00:20:29,870
!كطفل صغير

316
00:20:34,290 --> 00:20:34,880
!لقد تفاداها

317
00:20:34,880 --> 00:20:35,920
!لقد أوقفه

318
00:20:39,760 --> 00:20:42,550
!لكمتي أقوى بكثير من ذلك

319
00:20:46,300 --> 00:20:47,180
!لا مهرب لك

320
00:20:52,670 --> 00:20:55,900
.كيف تجرؤ على فتح جرحي القديم

321
00:20:57,230 --> 00:20:59,110
!ستدفع الثّمن

322
00:21:04,110 --> 00:21:05,200
!ها أنا ذا

323
00:21:05,450 --> 00:21:06,790
...هذه اللّكمة الحارقة

324
00:21:07,160 --> 00:21:09,700
!الحقيقيّة

325
00:21:23,250 --> 00:21:24,270
ما الخطب؟

326
00:21:24,580 --> 00:21:26,010
لمَ لا تحاول الضّحك ثانيةً؟

327
00:21:41,820 --> 00:21:43,640
.فاز تشيبودي بالقتال

328
00:21:47,070 --> 00:21:49,070
!أرى أنّ علاج الطّبيبة الخاصّ أفلح

329
00:21:49,740 --> 00:21:52,790
.كلّا. منحت علاجًا مؤقّتًا ليس إلّا

330
00:21:54,620 --> 00:21:55,790
...أعني

331
00:21:55,790 --> 00:21:58,000
.معه أولئك الأربع

332
00:21:58,380 --> 00:22:00,710
!تشيبودي

333
00:22:03,380 --> 00:22:04,420
!حسنًا

334
00:22:04,420 --> 00:22:07,340
!سأفوز بالبطولة حتمًا

335
00:22:07,340 --> 00:22:09,870
!لا سيّما لأجل أمّهاتي الأربع

336
00:23:34,640 --> 00:23:36,680
!جميعًا، حانت اللّحظة الّتي كنتم في انتظارها

337
00:23:36,680 --> 00:23:39,940
.يحبك العديد من المقاتلين خطّة وهم ينوون على الشرّ

338
00:23:39,940 --> 00:23:43,980
وخلف كلّ ذلك، ميكيلو تشاريوت
.الّذي يهدفه للانتقام من دومون

339
00:23:43,980 --> 00:23:44,730
...لكن

340
00:23:44,730 --> 00:23:46,980
...تظهر غاندام مرعبة وغامضة

341
00:23:46,980 --> 00:23:49,450
!وتهاجم دومون من السّماء

342
00:23:49,840 --> 00:23:52,160
:في الحلقة القادمة من المقاتل المتنقل جي غاندام

343
00:23:52,160 --> 00:23:55,990
.فخّ خطير! تردّ غاندام نيروس الهجوم

344
00:23:55,990 --> 00:23:58,370
!استعداد! هيّا