1
00:01:22,890 --> 00:01:24,770
.والآن جميعًا

2
00:01:24,770 --> 00:01:27,060
...بدءًا بخيانة المعلّم أسيا

3
00:01:27,060 --> 00:01:29,440
.ظهر جيش الموت

4
00:01:29,440 --> 00:01:32,610
...وبمنحهم شارتهم لتشيبودي والبقيّة

5
00:01:32,610 --> 00:01:34,360
.ضحّى تحالف شافل بحياتهم

6
00:01:34,360 --> 00:01:39,950
بالتّفكير في الأمر، شهدنا الكثير
.من المفاجآت هنا في شينجوكو

7
00:01:39,950 --> 00:01:42,450
.وهذه المعركة على وشك أن تصل ذروتها

8
00:01:43,290 --> 00:01:45,120
...أيضًا

9
00:01:45,120 --> 00:01:48,250
هل سيظهر الغاندام الشرّير اليوم يا ترى؟

10
00:01:48,460 --> 00:01:51,420
وماذا عن المعركة بين كيوجي ودومون؟

11
00:01:51,750 --> 00:01:53,210
!...والآن

12
00:01:53,210 --> 00:01:57,630
!قتال غاندام! استعداد! هيّا

13
00:02:05,020 --> 00:02:06,310
!أعارض هذا

14
00:02:07,810 --> 00:02:11,310
هل تتوقّع منّا أن نقبل أولئك المقاتلين كحلفائنا؟

15
00:02:11,310 --> 00:02:13,520
.كانّوا أعداءنا منذ وقتٍ وجيز

16
00:02:13,770 --> 00:02:16,860
.لكنّنا بحاجة لكلّ الدّعم الّذي نستطيع الحصول عليه

17
00:02:16,860 --> 00:02:17,950
!أنصت لنفسك

18
00:02:18,110 --> 00:02:20,530
...النّاس الّذين تعرّضوا للأذى بسببهم

19
00:02:20,530 --> 00:02:22,950
!هل تتوقّع منهم أن يسايروا الأمر؟

20
00:02:23,330 --> 00:02:25,370
...لـ-لكن، كما ترون

21
00:02:31,710 --> 00:02:33,840
...مع أنّه كان متحكّمًا بي

22
00:02:33,840 --> 00:02:36,810
.يا له من عارٍ بالنّسبة لفارسٍ عليه حماية النّاس

23
00:02:37,590 --> 00:02:39,130
...بعد حدوث هذا

24
00:02:39,130 --> 00:02:42,470
.سأكرّس نفسي تمامًا لهزيمة المعلّم أسيا

25
00:02:42,470 --> 00:02:46,020
...هكذا نستطيع شكر تحالف شافل

26
00:02:46,020 --> 00:02:51,480
!لأجل تضحيتهم بحياتهم وعهدهم لنا بإرثهم

27
00:02:51,940 --> 00:02:55,480
.إلى أن أحقّق هذا، لن أشارك في أيّ قتال غاندام

28
00:02:55,520 --> 00:02:57,000
...في الواقع

29
00:02:57,000 --> 00:02:59,450
...أكره قول هذا بعد كلّ ما حدث لنا

30
00:02:59,780 --> 00:03:02,450
.لكنّي لا أشعر بأيّ اختلاف بعد حصولي على هذه

31
00:03:03,490 --> 00:03:06,950
".لا يمكنني أن أقول أنّني مهتمّ بلقب "ملكة البستوني

32
00:03:06,950 --> 00:03:09,410
...لكن عليّ أن أردّ الصّاع لذلك النّذل

33
00:03:09,410 --> 00:03:11,170
.الّذي استخدمني كدمية

34
00:03:11,250 --> 00:03:12,370
.اسمعوا

35
00:03:12,370 --> 00:03:14,840
.احرصوا ألّا يتدخّل أيّ منكم

36
00:03:14,840 --> 00:03:17,800
!لن أتردّد في سحق أيّ من يعترض طريقي

37
00:03:18,550 --> 00:03:22,130
.أوافق أنّه يصعب التّعامل مع حليفٍ ضعيف للغاية

38
00:03:22,340 --> 00:03:24,010
ما الّذي ترمين إليه؟

39
00:03:24,010 --> 00:03:26,260
ما رأيك أن نتواجه الآن وها هنا؟

40
00:03:26,260 --> 00:03:27,220
.تمهّل

41
00:03:27,220 --> 00:03:29,700
.هذا ليس الوقت المناسب للعبث

42
00:03:30,640 --> 00:03:32,850
...أعلم ذلك، لكن

43
00:03:33,100 --> 00:03:36,400
.لم أشعر بهكذا إحباط في حياتي كلّها

44
00:03:36,400 --> 00:03:39,360
.وأنا واثق أنّ الأمر سيان بالنّسبة للجميع

45
00:03:40,400 --> 00:03:41,480
.دومون

46
00:03:42,110 --> 00:03:45,570
.لعلّك من يجب أن يأخذ زمام الأمور الآن

47
00:03:45,570 --> 00:03:47,280
...ستكون لديما فرصة أفضل ضدّ المعلّم

48
00:03:47,280 --> 00:03:48,540
.كلّا

49
00:03:49,040 --> 00:03:51,210
.لا أعتبر المعلّم عدوّي

50
00:03:51,370 --> 00:03:52,170
.هذا صحيح

51
00:03:52,500 --> 00:03:54,580
...العدوّان الوحيدان الّلذان يجب أن أهزمهما

52
00:03:54,580 --> 00:03:56,290
.هما الغاندام الشرّير وكيوجي

53
00:03:56,880 --> 00:03:58,840
.ولا علاقة لذلك بالآخرين

54
00:03:59,920 --> 00:04:01,090
...دومون

55
00:04:03,010 --> 00:04:04,050
زلزال؟

56
00:04:07,300 --> 00:04:08,260
!إنّه شديد

57
00:04:16,810 --> 00:04:18,400
مـ-ما الّذي يجري؟

58
00:04:18,400 --> 00:04:19,940
.إنّه لا يهمد

59
00:04:19,940 --> 00:04:21,650
.هذه ليست هزّةً عاديّة

60
00:04:25,950 --> 00:04:26,990
!راين

61
00:04:39,750 --> 00:04:41,170
...القليل بعد

62
00:04:41,170 --> 00:04:43,800
.بقي القليل حتّى نستطيع المغادرة

63
00:04:44,050 --> 00:04:45,010
.أجل

64
00:04:45,010 --> 00:04:47,510
.حينما يحين ذلك الوقت، سنودّع شينجوكو

65
00:05:02,860 --> 00:05:04,360
!...مؤلم

66
00:05:04,360 --> 00:05:05,950
.هذا ليس جيّدًا

67
00:05:05,950 --> 00:05:08,780
.يبدو أنّني سقطتُ من ارتفاع كبير

68
00:05:09,450 --> 00:05:12,540
.كما يبدو أنّني انفصلتُ عن البقيّة

69
00:05:13,200 --> 00:05:15,540
.يجب أن أبحث عن مخرج

70
00:05:22,170 --> 00:05:23,630
!مؤلم

71
00:05:24,050 --> 00:05:26,090
تـ-تشيبودي؟

72
00:05:26,340 --> 00:05:27,380
!أهلًا

73
00:05:27,380 --> 00:05:29,800
!هل تأخذين نزهةً في مكانٍ كهذا؟

74
00:05:31,260 --> 00:05:35,230
على آنسةٍ صغيرةٍ أن تعرف أنّها
.لا يجب أن تسير لوحدها

75
00:05:35,730 --> 00:05:36,690
ما رأيك؟

76
00:05:36,690 --> 00:05:39,060
ما رأيك أن أرافقك إلى المخرج؟

77
00:05:40,230 --> 00:05:40,940
هل تقصد أنّك...؟

78
00:05:40,940 --> 00:05:43,570
هل تعرف المخرج؟

79
00:05:44,400 --> 00:05:47,740
.في تلك الحالة، سأكون ممتنًّا

80
00:05:53,910 --> 00:05:56,160
.لم يصب أيّ أحد لحسن الحظ

81
00:05:56,160 --> 00:05:58,890
...افتقرنا عن

82
00:05:58,890 --> 00:06:00,530
.دومون كاشو والبقيّة

83
00:06:03,670 --> 00:06:05,670
أما زلت ترتعشين من وقعِ ذلك؟

84
00:06:05,960 --> 00:06:08,380
.كلّا. ليس كما تظنّين

85
00:06:08,380 --> 00:06:10,510
.تذكّرتُ شيئًا فحسب

86
00:06:11,550 --> 00:06:13,140
عمّاذا تتحدّثين بالضّبط؟

87
00:06:13,510 --> 00:06:16,230
.رأيتُ شيئًا عندما قبض عليّ المعلّم أسيا

88
00:06:16,230 --> 00:06:17,270
.نعم

89
00:06:17,270 --> 00:06:18,810
.أذكر الآن

90
00:06:19,140 --> 00:06:21,690
.كان هناك غاندام ضخم مدفون تحت الأرض

91
00:06:22,060 --> 00:06:24,230
.بدا وكأنّه نائم

92
00:06:25,570 --> 00:06:27,110
.لا بدّ أنّكم رأيتموه جميعًا

93
00:06:27,110 --> 00:06:28,200
!أنا واثقة

94
00:06:28,900 --> 00:06:32,200
.أراهن أنّه يراقبنا من حيث لا ندري

95
00:06:32,570 --> 00:06:33,530
.صحيح

96
00:06:33,530 --> 00:06:35,910
...الزلزال وجيش الموت

97
00:06:36,410 --> 00:06:39,370
.لا بدّ أنّ هذا من صنيع ذلك الغاندام الفظيع

98
00:06:39,710 --> 00:06:41,380
...وفي أيّة لحظة

99
00:06:41,380 --> 00:06:43,840
.قد يحدث شيءٌ أشدّ رعبًا حتّى

100
00:06:44,250 --> 00:06:45,500
!في أيّ لحظة

101
00:06:50,290 --> 00:06:51,950
.زلزال آخر

102
00:06:51,950 --> 00:06:53,700
ما الّذي يجري؟

103
00:07:02,270 --> 00:07:03,690
!جرذان

104
00:07:05,610 --> 00:07:08,190
.يبدو أنّها تهرب

105
00:07:08,360 --> 00:07:14,120
تتخلّى الحيوانات بشكلٍ غريزيّ
.عن مكانها عند شعورها بالخطر

106
00:07:14,120 --> 00:07:15,580
...إذًا

107
00:07:15,580 --> 00:07:16,450
...ما يعني

108
00:07:17,080 --> 00:07:19,830
مـ-ما الخطب يا أخي؟ ما الّذي يجري؟

109
00:07:20,080 --> 00:07:21,420
!أسرع يا ساي سايشي

110
00:07:21,420 --> 00:07:24,000
!علينا أن نجد البقيّة ونخرج من هنا

111
00:07:24,000 --> 00:07:28,210
!كيف سوف...؟
!انتظر

112
00:07:30,720 --> 00:07:33,110
...أيّها السيّد، لا أستطيع سوى أن ألاحظ

113
00:07:33,110 --> 00:07:36,720
.أنّ الطّريق الّذي اخترته يقودنا إلى الأسفل أكثر

114
00:07:37,060 --> 00:07:38,640
.أطبق فمك

115
00:07:38,640 --> 00:07:40,520
.بوسعك أن تذهب من طريقك إن كان هذا لا يعجبك

116
00:07:40,680 --> 00:07:44,940
...إن تركتُ الآنسة راين لوحدها مع وحشٍ مثلك

117
00:07:44,940 --> 00:07:46,730
.سأنتهك عهدي كفارس

118
00:07:47,480 --> 00:07:48,900
ما الّذي تقصده؟

119
00:07:48,900 --> 00:07:49,940
هل تقترح نزالًا؟

120
00:07:50,190 --> 00:07:52,400
بـ-بربّكما، هل أنتما بحاجةٍ لفعل هذا الآن؟

121
00:07:52,400 --> 00:07:53,320
.تراجعي

122
00:08:01,910 --> 00:08:03,170
!ما الّذي...؟

123
00:08:03,170 --> 00:08:05,330
.أرى أنّك لاحظت أيضًا

124
00:08:05,330 --> 00:08:06,290
.أجل

125
00:08:12,380 --> 00:08:14,510
.سيكون هذا صعبًا

126
00:08:14,510 --> 00:08:16,930
...سنمهّد لك الطّريق يا آنسة

127
00:08:16,930 --> 00:08:18,900
.لذا غادري بسرعة بينما نعني بهؤلاء

128
00:08:19,350 --> 00:08:20,180
...لكن أنا

129
00:08:20,180 --> 00:08:21,850
.افعلي رجاءً

130
00:08:21,850 --> 00:08:23,560
.قد لا نستطيع حمايتك هنا

131
00:08:32,070 --> 00:08:33,700
!ما الّذي يؤخّرك؟

132
00:08:33,700 --> 00:08:35,240
!اذهبي بسرعة

133
00:08:36,030 --> 00:08:37,370
!شـ-شكرًا على كلّ شيء

134
00:08:39,030 --> 00:08:41,000
...حسنًا، من الآن

135
00:08:41,000 --> 00:08:43,910
.لن ندعكم تعبرون، مهما كان

136
00:08:48,040 --> 00:08:51,840
!لكن من أيّ اتّجاه المخرج؟

137
00:08:54,050 --> 00:08:55,340
أذلك الضّوء من الخارج؟

138
00:09:06,810 --> 00:09:08,440
أذلك الغاندام الشرّير؟

139
00:09:08,810 --> 00:09:12,020
لكن ما احتمال وجوده هنا بالقرب منّا؟

140
00:09:27,040 --> 00:09:28,580
.فـ-فهمت الآن

141
00:09:28,580 --> 00:09:30,830
.بتّ أعرف لمَ هُدّمت شينجوكو

142
00:09:31,420 --> 00:09:33,460
.أعرف فيمَ يفكّر المعلّم

143
00:09:42,600 --> 00:09:43,680
!...كيوجي

144
00:09:53,190 --> 00:09:54,030
!تنحّي

145
00:09:58,200 --> 00:09:59,530
ما كان ذلك؟

146
00:09:59,530 --> 00:10:00,370
.اخرجي

147
00:10:00,620 --> 00:10:02,280
...اخرجي فورًا

148
00:10:02,280 --> 00:10:04,830
.وأبعدي الجميع عن شينجوكو

149
00:10:05,160 --> 00:10:06,040
من أنت؟

150
00:10:06,040 --> 00:10:07,080
!أسرعي

151
00:10:07,080 --> 00:10:10,170
.بإمكانك الخروج إن اتّبعت ذلك الطّريق مباشرةً

152
00:10:10,170 --> 00:10:11,640
!اذهبي -
!حسنًا -

153
00:10:19,930 --> 00:10:21,550
!أيّتها الأشياء القذرة

154
00:10:26,230 --> 00:10:30,350
.عليّ أن أسرع وإلّا سارت الأمور كما خطّط لها المعلّم

155
00:10:30,350 --> 00:10:31,490
.يجب أن أخبر دومون

156
00:10:36,860 --> 00:10:39,200
رأيته، أليس كذلك؟

157
00:10:39,910 --> 00:10:41,240
!أليس كذلك؟

158
00:10:42,950 --> 00:10:44,330
.لا بأس

159
00:10:44,330 --> 00:10:47,710
.رؤيتك له لا تعني أيّ شيء

160
00:10:47,710 --> 00:10:50,830
!لكن، لا يمكنني أن أسمح لك بالرّحيل

161
00:10:55,750 --> 00:10:56,880
.ساي سايشي

162
00:10:56,880 --> 00:10:58,880
.خذ راين واصعد

163
00:10:58,880 --> 00:11:00,550
.حسنًا يا أخي

164
00:11:00,550 --> 00:11:02,220
.سنذهب من هذا الطّريق

165
00:11:02,220 --> 00:11:02,970
...لكن

166
00:11:03,220 --> 00:11:04,560
!اذهبي يا راين

167
00:11:04,560 --> 00:11:06,350
.أحتاج أن أسأل معلّمي شيئًا

168
00:11:07,930 --> 00:11:08,780
...حسنًا

169
00:11:09,560 --> 00:11:10,730
!معلّمي

170
00:11:10,730 --> 00:11:13,520
!بتّ أعرف الآن أين هو الغاندام الشرّير

171
00:11:14,270 --> 00:11:16,900
.فات الأوان كثيرًا على ذلك الآن يا دومون

172
00:11:20,360 --> 00:11:21,700
...حان وقت إحياء

173
00:11:22,200 --> 00:11:24,070
!الغاندام الشرّير

174
00:11:24,330 --> 00:11:25,330
ما ذلك؟

175
00:11:26,240 --> 00:11:27,190
.أجل

176
00:11:27,950 --> 00:11:30,660
.ذلك الشّخص على وشك أن يُحيا

177
00:11:37,800 --> 00:11:41,090
غاندام جي المقاتل المتنقل

178
00:11:48,470 --> 00:11:50,350
.إنّه يزداد شدّةً

179
00:11:50,350 --> 00:11:52,560
أهذا من صنيع ذلك الشّيء المروع أيضًا؟

180
00:11:53,310 --> 00:11:54,060
.كلّا

181
00:11:57,610 --> 00:11:58,820
.حمدًا للرّب

182
00:11:58,820 --> 00:11:59,910
!نحن بأمان

183
00:12:06,120 --> 00:12:08,830
وكيف هو الوضع مع البقيّة؟

184
00:12:08,830 --> 00:12:11,750
...إنّه فظيع حقًّا

185
00:12:12,380 --> 00:12:13,460
ما الّذي يجري؟

186
00:12:17,670 --> 00:12:19,420
.يبدو أنّنا سنكون بأمان

187
00:12:19,590 --> 00:12:22,380
أجل، لكن ماذا حلّ بالآنسة راين؟

188
00:12:24,690 --> 00:12:25,510
!مرحبًا

189
00:12:25,800 --> 00:12:28,640
!جاء ساي سايشي أيضًا

190
00:12:28,640 --> 00:12:29,600
.مهلًا

191
00:12:29,600 --> 00:12:30,470
.إنّها تحاول إخبارنا بشيء

192
00:12:30,770 --> 00:12:33,850
!ابتعدوا من هنا جميعًا

193
00:12:33,850 --> 00:12:35,600
!الغاندام الشرّير تحتنا

194
00:12:37,900 --> 00:12:39,860
!إنّها هزّة كبيرة

195
00:12:42,280 --> 00:12:45,030
.أعتقد أنّ الوقت قد حان أخيرًا

196
00:12:45,030 --> 00:12:46,280
!ماذا...؟

197
00:12:51,450 --> 00:12:52,960
.فات الأوان الآن

198
00:12:52,960 --> 00:12:56,040
...ألقِ نظرة جيّدة على ملكنا

199
00:12:56,040 --> 00:12:58,130
!وأعد التّفكير بمستقبلك

200
00:12:58,130 --> 00:13:01,090
!اتّخذ القرار لتمضي قدمًا معي يا دومون

201
00:13:07,800 --> 00:13:08,600
ما ذلك؟

202
00:13:19,610 --> 00:13:20,190
!هذا صحيح

203
00:13:20,190 --> 00:13:21,480
!أذكر الآن

204
00:13:21,820 --> 00:13:24,490
!ذلك الوحش هو من استدرجنا إلى فخّ

205
00:13:38,330 --> 00:13:41,710
.كما يقال، الظلام أحلك في قاعدة المنارة

206
00:13:42,560 --> 00:13:45,090
لكن لماذا هاجموا شينجوكو لوقتٍ طويل؟

207
00:13:45,090 --> 00:13:46,130
.لا

208
00:13:46,130 --> 00:13:47,890
.لم يكونوا يهاجمون المدينة

209
00:13:47,890 --> 00:13:49,220
.بل كانوا يجمونها

210
00:13:49,220 --> 00:13:50,050
ماذا؟

211
00:13:50,680 --> 00:13:52,220
.انظروا إليه

212
00:13:52,510 --> 00:13:55,640
...كانسلاخ حشرةٍ أثناء نموّها

213
00:13:55,640 --> 00:13:57,810
.كان الغاندام الشرّير يُجدّد ذاته

214
00:13:57,810 --> 00:13:59,650
.إنّه في خضمّ العمليّة

215
00:13:59,650 --> 00:14:01,480
.كيرقة

216
00:14:02,110 --> 00:14:05,110
ما كان جيش الموت الضّخم ذلك إذًا؟

217
00:14:05,650 --> 00:14:07,200
.كانوا أشبه بالطّعام

218
00:14:07,660 --> 00:14:11,830
نُشرت النّسخ الروبوتات تلك
.قبل مجيء الغاندام الشرّير

219
00:14:12,370 --> 00:14:14,330
.رأيته يبتلعها بينما يجدّد ذاته

220
00:14:14,500 --> 00:14:17,250
...أتقصدين أنّ الجنود الّذين رأيناهم تحت الأرض

221
00:14:17,250 --> 00:14:19,210
كانوا شعب شينجوكو؟

222
00:14:19,210 --> 00:14:19,920
.أجل

223
00:14:19,920 --> 00:14:23,590
.إنّه أنسب مكان يُوفّر له كلّ ما يحتاجه

224
00:14:23,800 --> 00:14:27,300
.لكن هناك شيء لم يلقِ له المعلّم اعتبارًا في خطّته

225
00:14:27,840 --> 00:14:30,180
!ظهور دومون

226
00:14:30,510 --> 00:14:33,760
.أراهن أنّك لسانك عاجز عن الكلام بعد رؤيتك لعظمة هذا

227
00:14:33,760 --> 00:14:34,680
.هذا صحيح

228
00:14:34,680 --> 00:14:38,560
.على عكس الآخرين، لا يُسيطر عليّ أيّ أحد

229
00:14:38,560 --> 00:14:41,440
...تأثّرتُ بقوّة الغاندام الشرّير المطلقة

230
00:14:41,440 --> 00:14:43,770
.وقرّرتُ أن أكون تابعه

231
00:14:44,190 --> 00:14:45,940
.لا بدّ أنّك تمزح

232
00:14:45,940 --> 00:14:47,530
!بات الأمر منطقيًّا

233
00:14:50,910 --> 00:14:54,490
!هذه نهايتك أيّها المعلّم أسيا

234
00:14:58,120 --> 00:15:01,460
.هذا كلامٌ متعالٍ بالنّسبة لشلّةٍ من المبتدئين

235
00:15:01,670 --> 00:15:03,040
!اخرس

236
00:15:03,040 --> 00:15:05,750
!لا يهمّني إن كنتَ المدافع عن اللّقب أو أيًّا كان

237
00:15:05,750 --> 00:15:08,670
!فلنسوّ هذا الآن وللأبد

238
00:15:08,670 --> 00:15:09,880
!انتظر يا تشيبودي

239
00:15:12,180 --> 00:15:14,050
!ماذا؟ ما الّذي...؟

240
00:15:15,260 --> 00:15:18,180
!لا تملك أدنى فكرة ما الّذي تواجهه

241
00:15:18,480 --> 00:15:20,560
!لا

242
00:15:21,270 --> 00:15:22,310
!والآن

243
00:15:22,310 --> 00:15:24,360
!أقبلوا عليّ يا شباب

244
00:15:24,350 --> 00:15:27,030
!سأفعل! روز بيت

245
00:15:30,950 --> 00:15:32,280
!سأهاجم أيضًا

246
00:15:36,040 --> 00:15:37,490
.حشرات مزعجة

247
00:15:37,790 --> 00:15:39,160
!ها أنا ذا

248
00:15:39,160 --> 00:15:42,960
.مدرسة غير المهزوم في الشّرق
!اثنا عشر أوهوباي

249
00:15:43,330 --> 00:15:44,080
!ماذا؟

250
00:15:45,040 --> 00:15:47,670
!دايشاهي

251
00:15:50,970 --> 00:15:52,040
!جورج

252
00:15:53,050 --> 00:15:55,140
!المعلّم

253
00:15:55,140 --> 00:15:56,930
!اخرس

254
00:16:03,230 --> 00:16:06,110
.يا لك من هاوٍ بالنّسبة لملك القلوب

255
00:16:06,110 --> 00:16:08,320
...لا بدّ أنّ تحالف شافل في الجانب الآخر

256
00:16:08,320 --> 00:16:09,530
!يبكون دموع النّدم

257
00:16:14,450 --> 00:16:18,490
...كنتُ أماطل الوقت إلى حين إحياء ذلك الشّخص الكامل

258
00:16:18,490 --> 00:16:21,460
.لكن أدركتُ أنّني كنتُ أهدر مواهبي فحسب

259
00:16:22,000 --> 00:16:25,830
!لذا أفترض أنّني سأجهز عليكم فحسب يا فتيان

260
00:16:28,250 --> 00:16:29,800
!لن أدعك

261
00:16:35,090 --> 00:16:37,060
!عودي إليّ

262
00:16:40,350 --> 00:16:42,690
.المعلّم أسيا، غير المهزوم في الشّرق

263
00:16:42,690 --> 00:16:44,600
.لن أدعك تفعل ما يحلو لك

264
00:16:45,150 --> 00:16:46,310
ماذا؟

265
00:16:46,560 --> 00:16:48,270
!مـ-ما هذا...؟

266
00:16:57,370 --> 00:16:58,580
.فليكن

267
00:16:58,580 --> 00:17:00,700
...قتال أحد آخر في هذه المرحلة

268
00:17:00,700 --> 00:17:02,620
!لن يشكّل أيّ فارق بالنّسبة لي

269
00:17:08,420 --> 00:17:10,340
!إنّه يسلّط الكثير من الصّور

270
00:17:21,220 --> 00:17:22,430
...إنّه بارع

271
00:17:22,430 --> 00:17:23,730
!من أنت؟

272
00:17:25,390 --> 00:17:28,940
.أنا شفارز برودر، ممثّل نيو ألمانيا

273
00:17:28,940 --> 00:17:30,480
.سيكون من العاقِل أن تتذكّرني

274
00:17:34,150 --> 00:17:37,870
.ذ-ذاك الشّخص يستطيع القتال في نفس مستوى معلّمي

275
00:17:38,030 --> 00:17:39,660
!ما الّذي تنتظره يا دومون؟

276
00:17:40,410 --> 00:17:43,120
!عليك أن تسرع! اهزم الغاندام الشرّير

277
00:17:43,750 --> 00:17:46,580
!افعل ذلك قبل أن ينكشف جسده كاملًا

278
00:17:46,920 --> 00:17:47,790
!الآن

279
00:17:48,170 --> 00:17:50,210
!لكن، ما الّذي...؟

280
00:17:50,210 --> 00:17:52,760
!هذا ليس مهمًّا. أسرع

281
00:17:53,090 --> 00:17:54,840
.معه حق يا دومون كاشو

282
00:17:54,840 --> 00:17:57,130
!أولى أوليّاتنا هي هزيمة الغاندام الشرّير

283
00:17:57,130 --> 00:17:59,720
!أنت الوحيد القادر على هزيمته

284
00:18:00,010 --> 00:18:02,090
!أسرع الآن! بسرعة

285
00:18:03,810 --> 00:18:05,930
.هـ-هذا صحيح

286
00:18:05,930 --> 00:18:07,390
.هذا

287
00:18:07,940 --> 00:18:11,360
...بسبب هذا الرّجل
...بسبب هذا الرّجل

288
00:18:11,820 --> 00:18:13,440
...كلٌّ من أمّي

289
00:18:13,440 --> 00:18:14,940
!ولأبي

290
00:18:15,050 --> 00:18:17,820
!كلّ ذلك بسبب هذا الشّخص

291
00:18:18,610 --> 00:18:21,370
!كلّا! ليست تلك القوّة ثانية

292
00:18:24,660 --> 00:18:27,500
!يدي هذه تشعّ وتزمجر

293
00:18:28,420 --> 00:18:30,830
!صرختها السّاطعة تخبرني أن أهزمك

294
00:18:30,830 --> 00:18:31,590
!خذ هذه

295
00:18:31,590 --> 00:18:34,760
!حبّي وغضبي وحزني

296
00:18:34,960 --> 00:18:38,130
!الإصبع المشعّ

297
00:18:38,430 --> 00:18:42,550
!هيّا! هيّا! هيّا

298
00:18:51,900 --> 00:18:54,360
!أيّها الأحمق! لمَ تجنّبت الرّأس؟

299
00:18:55,990 --> 00:18:56,870
!ماذا؟

300
00:18:57,570 --> 00:19:00,360
!إنّه يمتصّ طاقتي

301
00:19:02,030 --> 00:19:03,160
!جميل

302
00:19:03,160 --> 00:19:05,370
!ستكون طاقة دومون كافية لبعثه

303
00:19:21,010 --> 00:19:21,720
...لا بدّ أنّ ذلك هو

304
00:19:22,180 --> 00:19:23,690
!الغاندام الشرّير

305
00:19:24,180 --> 00:19:25,680
...مـ-مذهل

306
00:19:30,890 --> 00:19:33,020
...إذًا هذا هو

307
00:19:50,750 --> 00:19:52,080
!ذاك الشّخص

308
00:19:52,080 --> 00:19:54,170
!إنّه ذلك الشّخص في الصّورة الّتي كان يحملها دومون

309
00:19:54,380 --> 00:19:55,540
...أ

310
00:19:55,540 --> 00:19:56,600
...أخي

311
00:20:01,010 --> 00:20:02,300
!أخي

312
00:20:05,550 --> 00:20:06,330
!احترس

313
00:20:25,320 --> 00:20:26,400
!دومون

314
00:20:27,080 --> 00:20:29,950
.ألق نظرة جيّدة على جسده

315
00:20:30,500 --> 00:20:32,580
...بفضل تلك القوّة الّتي وفّرتها

316
00:20:32,580 --> 00:20:36,210
!تجدّد الغاندام الشرّير بالكامل

317
00:20:37,210 --> 00:20:38,600
.كان ذلك كرمًا سخيًّا منك

318
00:20:42,130 --> 00:20:45,890
!وداعًا يا دومون، ملك القلوب

319
00:20:47,730 --> 00:20:49,240
!ا-انتظر

320
00:20:49,640 --> 00:20:51,640
!انتظر، لا ترحل بعد يا معلّمي

321
00:20:51,640 --> 00:20:53,350
!كيوجي

322
00:20:55,100 --> 00:20:56,230
!كيوجي

323
00:20:59,230 --> 00:21:02,070
!كيوجي

324
00:21:24,470 --> 00:21:25,680
.خسرنا

325
00:21:25,680 --> 00:21:28,110
.هُزمنا شرّ هزيمة

326
00:21:29,010 --> 00:21:29,970
.ما باليد حيلة

327
00:21:31,020 --> 00:21:34,440
.نظرة واحدة عليه وكانت النّتيجة واضحة

328
00:21:34,810 --> 00:21:37,520
...لكن، الأهمّ الآن

329
00:21:40,520 --> 00:21:41,480
.أدري

330
00:21:42,280 --> 00:21:43,890
...لا أستطيع أن أنكر أنّ أخي

331
00:21:44,570 --> 00:21:46,240
...كيوجي

332
00:21:47,990 --> 00:21:50,080
.كان جادًّا عندما صوّب عليّ

333
00:21:51,200 --> 00:21:52,760
.رأيتُ أنّه كان جادًّا تمامًا

334
00:21:53,870 --> 00:21:56,540
...لم يعد كيوجي

335
00:21:57,540 --> 00:21:58,360
...دومون

336
00:23:34,010 --> 00:23:36,270
!جميعًا، حانت اللّحظة الّتي انتظرتموها

337
00:23:36,270 --> 00:23:38,640
.يلاحق دومون الغاندام الشرّير

338
00:23:38,640 --> 00:23:42,060
.والفخّ المنصوب من قِبل المعلّم أسيا

339
00:23:42,060 --> 00:23:45,570
...ثمّ يقوم مقاتل الغاندام من نيو ألمانيا

340
00:23:45,570 --> 00:23:48,490
!بتحدّي دومون إلى قتال غاندام

341
00:23:49,030 --> 00:23:51,530
:في الحلقة القادمة من المقاتل المتنقل جي غاندام

342
00:23:51,530 --> 00:23:54,780
تحدّي! المقاتل المقنّع الغامض

343
00:23:54,780 --> 00:23:57,480
!استعداد! هيّا