1
00:00:12,200 --> 00:00:14,490
...ليست هنا. لا أجدها

2
00:00:15,080 --> 00:00:16,780
!فُقِدت سن

3
00:00:17,910 --> 00:00:20,450
!سقطت للتو

4
00:00:20,910 --> 00:00:25,950
هذه السن تلفازي
!الذي كنت أشاهد مسلسلًا عليه

5
00:00:26,370 --> 00:00:29,410
!والمشهد الأخير كاد يدمعني

6
00:00:32,950 --> 00:00:37,200
قالت أمي إن الأسنان
.القديمة تنمو مكانها أخرى

7
00:00:37,280 --> 00:00:40,370
!وستكون أكبر

8
00:00:44,490 --> 00:00:46,700
سوسة، أتريدين اللعب؟

9
00:00:46,780 --> 00:00:47,910
.ليس الآن

10
00:00:48,990 --> 00:00:51,240
!اُنمي بسرعة

11
00:00:56,700 --> 00:00:58,490
ألم تنمُ بعد؟

12
00:01:03,490 --> 00:01:05,120
!لن ألعب

13
00:01:06,240 --> 00:01:08,700
!اُنمي! اُنمي

14
00:01:19,870 --> 00:01:22,280
!نمت وكبرت

15
00:01:22,700 --> 00:01:23,910
!ماري

16
00:01:24,490 --> 00:01:25,870
!أخرجوني

17
00:01:25,950 --> 00:01:27,030
ماما؟

18
00:01:27,700 --> 00:01:29,700
هل أنتِ داخل السن؟

19
00:01:31,490 --> 00:01:33,620
!كبرت السن كثيرًا

20
00:01:39,080 --> 00:01:41,200
!أخرجيني من هنا

21
00:01:41,700 --> 00:01:43,530
!سأخرجكِ الآن

22
00:01:46,030 --> 00:01:48,330
لمَ السن بهذه القساوة؟

23
00:01:49,160 --> 00:01:50,780
!سوسة

24
00:01:56,410 --> 00:01:58,270
أتريدين اللعب؟

25
00:01:58,270 --> 00:01:59,540
.ليس الآن

26
00:02:15,450 --> 00:02:18,280
هل أذبتِ السن بدموعكِ؟

27
00:02:19,410 --> 00:02:22,280
.التسوس مذهل بحق

28
00:02:22,370 --> 00:02:23,370
!ماما

29
00:02:27,780 --> 00:02:29,620
أنشاهد مسلسلًا معًا؟

30
00:02:32,120 --> 00:02:35,950
.بشرط ألَّا يكون مُبكِيًا