1
00:00:08,460 --> 00:00:11,240
ألستُ أفضل في هذا من ميكيو-سان؟

2
00:00:14,180 --> 00:00:18,030
ظننتُ بأنّه كان سيقبّلني حقّاً

3
00:00:21,050 --> 00:00:23,620
لماذا حفظت عبارات روميو؟

4
00:00:24,470 --> 00:00:26,650
أتذكّرها لأنّني أردتُ لعِبَ دوره

5
00:00:27,530 --> 00:00:32,570
،إذا حاولتِ ما بوسعكِ لأجل المهرجان الثّقافيّ
فسأبذل قصارى جهدي ألّا أتدخّل

6
00:00:34,930 --> 00:00:39,500
ماذا كان ليحدث لو قبّلني؟

7
00:00:44,170 --> 00:00:45,600
!يا إلهي

8
00:00:46,130 --> 00:00:49,570
!أعود لأخذ هاتفي فأرى هذا

9
00:00:50,580 --> 00:00:51,850
هل أقاطعكما؟

10
00:00:52,720 --> 00:00:56,280
لـ-لا. كنّا على وشك المغادرة فحسب

11
00:00:56,720 --> 00:00:58,320
هل تنامان معاً؟

12
00:00:59,420 --> 00:01:02,290
لـ-لا، لسنا كذلك! لِمَ تطرح هذا السّؤال؟

13
00:01:02,620 --> 00:01:07,500
مهلاً، ألم تكونا تستكينان لبعضكما الآخر قبل ثانيتين؟

14
00:01:08,910 --> 00:01:11,400
لا بدّ أنّه كان يراقبنا لبعض الوقت

15
00:01:11,400 --> 00:01:13,720
...ظننتُ بأنّني سأتلقّى قبلة، لكن

16
00:01:14,120 --> 00:01:17,090
لا. كنّا نمثّل لأجل المسرحيّة فحسب

17
00:01:21,580 --> 00:01:23,050
!ما مشكلتك؟

18
00:01:23,420 --> 00:01:24,890
حقّاً؟

19
00:01:33,200 --> 00:01:34,450
أجل، حقّاً

20
00:01:35,440 --> 00:01:38,440
حسناً، هذا مملّ

21
00:01:39,280 --> 00:01:41,280
تفضّل هاتفك

22
00:01:41,510 --> 00:01:42,650
شكراً

23
00:01:48,380 --> 00:01:50,170
هيّا بنا يا إيساكو-سان

24
00:03:43,570 --> 00:03:46,870
!روميو وجولييت

25
00:03:46,870 --> 00:03:47,830
نعم؟

26
00:03:48,650 --> 00:03:51,450
تمّ تصميم الملابس. انظرا

27
00:03:52,170 --> 00:03:54,930
!هذا ظريف حقّاً

28
00:03:54,930 --> 00:03:57,570
قد نغيّر بعض التّفاصيل الصّغيرة

29
00:03:57,570 --> 00:03:59,360
هذا روميو

30
00:03:59,360 --> 00:04:01,800
روميو رائع أيضاً

31
00:04:02,060 --> 00:04:03,840
ما رأيك يا تانوكي-كن؟

32
00:04:04,250 --> 00:04:07,270
ماذا؟ هذا لا يهمّني

33
00:04:07,270 --> 00:04:10,350
!لا تكن سخيفاً. إنّه الزيّ الّذي سترتديه

34
00:04:12,770 --> 00:04:16,060
كيف وجدتِ الملابس؟ جميلة جدّاً، صحيح؟

35
00:04:16,060 --> 00:04:18,470
آندو-سان، كاتسكي-سان

36
00:04:18,470 --> 00:04:21,110
أجل، إنّها رائعة

37
00:04:21,110 --> 00:04:23,960
أريتهما إيّاها قبل قليل بما أنّهما المديرتان

38
00:04:23,960 --> 00:04:26,660
!حسناً، سنعتبر هذه نهائيّة بعض الشّيء

39
00:04:26,660 --> 00:04:28,840
والآن سوف نحصل على المواد

40
00:04:28,840 --> 00:04:31,630
يوجد متجر أقمشة في جناح التسوُّق، صحيح؟

41
00:04:31,630 --> 00:04:33,950
هل لديهم أشياء تلائم هذه الصّورة؟

42
00:04:34,680 --> 00:04:39,820
مـ-من المثير التّعاون جميعاً معاً لصنع شيء، صحيح؟

43
00:04:39,820 --> 00:04:41,010
أجل

44
00:04:41,010 --> 00:04:44,680
الأشخاص الّذين يجهّزون الدّعائم وقطع المسرح
والإضاءة والموسيقى

45
00:04:44,680 --> 00:04:46,640
...بالإضافة إلى الممثّلين الآخرين

46
00:04:46,640 --> 00:04:48,950
،لم يكونوا متلهّفين في البداية

47
00:04:48,950 --> 00:04:52,120
!لكنّهم ينجذبون للأمر أكثر فأكثر

48
00:04:52,120 --> 00:04:55,410
أجل، والفِرق المختلفة تنسجم مع بعضها

49
00:04:55,410 --> 00:04:59,040
لا أطيق انتظار كيف سينتهي المطاف بهذا

50
00:04:59,890 --> 00:05:03,670
!حسناً أيُّها الممثّلون! عودوا إلى التّدريب

51
00:05:03,670 --> 00:05:05,320
!حسناً

52
00:05:06,940 --> 00:05:13,620
مسكينة أنتِ، لن تتمكّني من رؤية
كي-تشان بزيّ روميو

53
00:05:14,090 --> 00:05:18,080
إنّه يحرّض من جديد. ابقي هادئة يا إيساكو

54
00:05:19,100 --> 00:05:22,950
لـ-لـ-لـ-لماذا كيا؟

55
00:05:22,950 --> 00:05:24,890
أنتِ مكشوفة تماماً

56
00:05:25,250 --> 00:05:28,330
أنتما تنامان معاً، أليس كذلك؟

57
00:05:28,330 --> 00:05:30,380
أخبرتُك، لا

58
00:05:30,740 --> 00:05:33,940
إذاً هو الإعجاب من طرف واحد؟

59
00:05:38,270 --> 00:05:39,690
أصبت

60
00:05:41,160 --> 00:05:45,140
وقائيّة كي-تشان الشّديدة صرفَتني
عن الملاحظة من قبل

61
00:05:45,690 --> 00:05:49,170
اسمع، من فضلك لا تخبر كيا

62
00:05:49,170 --> 00:05:51,200
أنا متأكّدٌ بأنّه يعلم سلفاً

63
00:05:51,510 --> 00:05:53,360
!بجدّية، لا تخبره

64
00:05:53,360 --> 00:05:56,160
...لا أعدكِ بذلك

65
00:05:56,850 --> 00:06:02,680
مشاعر إيساكو-تشان واضحة، لكن
ما الّذي يعتقده كي-تشان؟

66
00:06:03,700 --> 00:06:06,410
أوتو-كن، سنقيس خصرك تالياً

67
00:06:10,910 --> 00:06:13,490
لماذا حفظت عبارات روميو؟

68
00:06:14,400 --> 00:06:16,560
أتذكّرها لأنّني أردتُ لعِبَ دوره

69
00:06:17,490 --> 00:06:22,460
،إذا حاولتِ ما بوسعكِ لأجل المهرجان الثّقافيّ
فسأبذل قصارى جهدي ألّا أتدخّل

70
00:06:24,400 --> 00:06:27,630
ما كان ينبغي أن أقول ذلك أبداً

71
00:06:30,490 --> 00:06:33,530
!كي-تشان ينظر إلى هذه النّاحية

72
00:06:34,000 --> 00:06:36,290
!لوّحي له

73
00:06:36,290 --> 00:06:37,700
!كُفّ عن ذلك

74
00:06:37,700 --> 00:06:38,650
لماذا؟

75
00:06:39,150 --> 00:06:41,060
أوتو-كن، لا تمانع؟

76
00:06:41,060 --> 00:06:42,250
ماذا؟ أمانع ماذا؟

77
00:06:42,250 --> 00:06:44,540
...المعذرة، ذلكما الاثنان

78
00:06:45,160 --> 00:06:47,090
أو بالأحرى تانوكي-كن

79
00:06:58,980 --> 00:07:03,480
أنا مُرهَقة للغاية. مجرّد التّواجد
مع ميكيو-سان مُتعِب

80
00:07:05,480 --> 00:07:09,100
لا مشكلة أثناء التّدريب، لكن
...عندما نكون في استراحة

81
00:07:11,140 --> 00:07:12,700
هل تسمعني؟

82
00:07:12,940 --> 00:07:14,450
أسمعكِ

83
00:07:15,790 --> 00:07:17,930
هل هو بمزاج عكر؟

84
00:07:20,490 --> 00:07:21,960
رائحة سجائرك تفوح

85
00:07:23,650 --> 00:07:27,380
لا ينبغي أن ترخي دفاعكِ وتثقي به

86
00:07:27,720 --> 00:07:28,470
ماذا؟

87
00:07:29,770 --> 00:07:35,930
لا نعلم ما الّذي يفكّر فيه، أو ما الّذي قد يفعله

88
00:07:37,830 --> 00:07:40,390
لم أرخِ دفاعي

89
00:07:43,540 --> 00:07:47,910
هذا ما تقولينه. لكنّكِ تسمحين
للنّاس بتسييركِ بسهولة

90
00:07:47,910 --> 00:07:49,180
عفواً؟

91
00:07:50,490 --> 00:07:54,320
أخبريني، ما الّذي يعجبكِ في كي-تشان؟

92
00:07:56,370 --> 00:08:00,550
!أخفِض صوتك! قلتُ لك هذا سرّ

93
00:08:00,550 --> 00:08:03,420
ولِمَ يجدر بي أن أخبرك بذلك على أي حال؟

94
00:08:01,760 --> 00:08:03,420
!يا رِفاق

95
00:08:03,420 --> 00:08:07,350
—إيساكو-تشان هنا هي في الواقع

96
00:08:07,350 --> 00:08:09,840
!أنا آسفة

97
00:08:10,100 --> 00:08:12,800
هل هو وجهه؟ إنّه وسيم

98
00:08:16,410 --> 00:08:19,850
...أ-أعني، يعجبني وجهه

99
00:08:21,020 --> 00:08:22,520
...لكن

100
00:08:23,270 --> 00:08:27,360
يعجبني صوته أيضاً، وأعتقد يديه أيضاً؟

101
00:08:28,770 --> 00:08:32,670
أحببتُه منذ لحظة لقائي به على ما أعتقد

102
00:08:34,090 --> 00:08:37,820
لطالما كان الأقرب إليّ، ويصغي إليّ

103
00:08:40,520 --> 00:08:47,180
التّعبير عن الأمر بالكلام يجعلني
أحبّ كيا أكثر من السّابق حتّى

104
00:08:59,770 --> 00:09:00,930
كيا؟

105
00:09:10,170 --> 00:09:12,160
!تانوكي-كن

106
00:09:12,160 --> 00:09:14,280
!سيفنا

107
00:09:14,280 --> 00:09:17,150
!تـ-تانوكي-كن

108
00:09:17,150 --> 00:09:19,620
...سـ-سيفنا

109
00:09:24,000 --> 00:09:26,930
كيف كان الأداء يا حضرة المديرتين؟

110
00:09:27,360 --> 00:09:28,240
ماذا تقول؟

111
00:09:30,740 --> 00:09:33,390
ماذا تفعل بالتّحديد؟

112
00:09:35,090 --> 00:09:37,310
لم أعد أستطيع التحمّل

113
00:09:37,720 --> 00:09:42,780
!لماذا في تلك اللّحظة؟ ووعدتني ألّا تتدخّل

114
00:09:42,780 --> 00:09:44,720
...لكن يا إيساكو-سان، أنتِ

115
00:09:45,730 --> 00:09:47,480
ما الّذي فعلتُه أنا؟

116
00:09:50,180 --> 00:09:52,530
قدّري جهودي رجاء

117
00:09:52,530 --> 00:09:53,430
عفواً؟

118
00:09:53,780 --> 00:09:55,740
تحمّلتُ قدر ما أستطيع حتّى الآن

119
00:09:55,990 --> 00:09:58,360
لا يمكنني البقاء جيّداً ما لم تشجّعيني
بربتة على الرّأس

120
00:09:58,360 --> 00:10:00,280
يقول هذا الكلام مُدمِّر الدّعائم

121
00:10:02,230 --> 00:10:06,350
هل ينبغي أن أسلّيه الآن لتلطيف الأجواء؟

122
00:10:06,760 --> 00:10:09,370
...وجدتُ بصراحة ما فعله مُريحاً للأعصاب، لكن

123
00:10:10,060 --> 00:10:13,130
،عرفتُ سلفاً طبع كيا وما الّذي كان ليفعله

124
00:10:13,130 --> 00:10:17,980
ولم أتدخّل لتقديم المساعدة، لذا
قد أكون مسؤولة جزئيّاً

125
00:10:20,810 --> 00:10:23,150
أنت بائس

126
00:10:36,490 --> 00:10:37,900
حسناً، حسناً

127
00:10:42,370 --> 00:10:43,290
ماذا؟

128
00:10:44,080 --> 00:10:45,200
ألم يكن كذلك؟

129
00:11:04,890 --> 00:11:06,230
!كيا

130
00:11:08,310 --> 00:11:10,980
تبّاً، انقلبت تنّورتي

131
00:11:18,340 --> 00:11:19,960
!لا تشمّني

132
00:11:37,490 --> 00:11:39,310
حسناً، انتهيت

133
00:11:39,310 --> 00:11:40,520
هذا لا يكفي

134
00:11:40,850 --> 00:11:44,430
من النّادر أن تكوني أنتِ من يستهلّ
الأمور. أريد المزيد

135
00:11:45,470 --> 00:11:47,780
انتهيت يعني انتهيت

136
00:11:47,780 --> 00:11:48,500
بئساً

137
00:11:48,500 --> 00:11:49,980
لن ينفعك العبوس

138
00:11:50,810 --> 00:11:53,520
سوف نعود، وستعتذر من الجميع

139
00:11:53,520 --> 00:11:54,440
حسناً

140
00:11:57,760 --> 00:12:00,690
من الواضح أنّ كي-تشان يبادلك المشاعر

141
00:12:04,190 --> 00:12:07,360
أرى الدّمار أكثر إمتاعاً من الخلق

142
00:12:10,450 --> 00:12:11,710
كم بطني يؤلمني

143
00:12:28,260 --> 00:12:29,180
أهلاً بعودتك

144
00:12:29,180 --> 00:12:30,330
مرحباً

145
00:12:30,980 --> 00:12:32,980
"إنَّ "مرحباً" هذه ينبغي أن تكون "آسف

146
00:12:32,980 --> 00:12:35,240
هل هدأت يا أوتو-كن؟

147
00:12:35,240 --> 00:12:38,160
أجل. أنا آسف بشأن ما سبق

148
00:12:38,160 --> 00:12:39,140
هكذا إذاً

149
00:12:40,620 --> 00:12:43,430
حسناً، عاد تانوكي-كن من عيادة المُمرّضة أيضاً

150
00:12:44,280 --> 00:12:46,490
حسناً؟ لماذا تشاجرتما؟

151
00:12:46,490 --> 00:12:49,300
،كانت هناك حشرة عليه

152
00:12:49,300 --> 00:12:52,690
لذا حاولتُ إبعادها، لكن لوّحتُ بقوّة زائدة

153
00:12:53,740 --> 00:12:57,710
أليس لطيفاً؟ أكره الحشرات فحسب

154
00:12:57,710 --> 00:13:00,400
لا يحاولان حتّى الكذب كما ينبغي

155
00:13:00,400 --> 00:13:05,180
اسمعا، نحن نحضّر للمهرجان

156
00:13:05,180 --> 00:13:08,320
لا تُقحِما أحداً في نزاعاتكما

157
00:13:08,320 --> 00:13:14,410
على كلّ شخص أن يتعاون معنا
لإنجاح هذا! مفهوم؟

158
00:13:14,950 --> 00:13:16,310
أجل

159
00:13:16,310 --> 00:13:19,750
حسناً، أعيدا المقاعد والكراسي

160
00:13:19,750 --> 00:13:22,430
!الآخرون، عودوا إلى التّدريب

161
00:13:25,070 --> 00:13:27,390
!كانت الحشرة هي أنا

162
00:13:29,160 --> 00:13:31,420
إذاً ألم تفعلها مع إيساكو-تشان بعد؟

163
00:13:33,410 --> 00:13:36,410
أمزح فحسب، أعلم بأنّكما لم تفعلا

164
00:13:37,120 --> 00:13:41,040
أنت ممثّل، لكن أظنّك غير خبير في الحبّ

165
00:13:41,330 --> 00:13:45,720
إذا ظللتَ تستغرق وقتك، فإنّ حشرة
ما قد تفتعل مشكلة

166
00:13:47,660 --> 00:13:50,720
آسف، هل قلت شيئاً لي؟

167
00:13:50,720 --> 00:13:54,210
!تتجاهلني تماماً؟ يا للوقاحة

168
00:13:54,210 --> 00:13:59,740
أعتذر بشأن تلك الحادثة. كان
السّيف خفيفاً كالرّيشة

169
00:14:00,230 --> 00:14:02,590
!عديم المصداقيّة

170
00:14:03,110 --> 00:14:05,770
أنتما، تعالا إلى هنا عندما تنتهيان

171
00:14:06,080 --> 00:14:07,140
حسناً

172
00:14:10,750 --> 00:14:11,580
!كيا

173
00:14:12,760 --> 00:14:15,490
،كان ينبغي أن أسأل من قبل
لكن هل ستكون بخير حقّاً؟

174
00:14:16,250 --> 00:14:20,010
ألن تقع في مشكلة لفعلك شيئاً كهذا لميكيو-سان؟

175
00:14:20,620 --> 00:14:23,290
سأكون بخير. غالباً

176
00:14:23,820 --> 00:14:24,620
"غالباً"

177
00:14:37,350 --> 00:14:40,060
!حسناً! خمسة أيّام على العرض

178
00:14:40,420 --> 00:14:42,830
!اليوم سنقوم بمراجعة شاملة

179
00:15:02,200 --> 00:15:04,570
هذا الفستان ظريف جدّاً

180
00:15:04,570 --> 00:15:06,330
!إيساكو-تشان، اتّخذي وضعيّة

181
00:15:06,330 --> 00:15:07,010
!انظري إليّ

182
00:15:07,010 --> 00:15:08,210
!هنا

183
00:15:09,760 --> 00:15:11,340
ماذا؟

184
00:15:17,910 --> 00:15:21,320
!تبدين جميلة مثل أوليفيا هوسّي

185
00:15:21,320 --> 00:15:24,030
تماماً! لحظة، من تكون هذه؟

186
00:15:25,890 --> 00:15:27,950
أنا مُحرَجة قليلاً

187
00:15:29,240 --> 00:15:34,550
!كي-تشان، لا أريد ارتداء ملابس ضيّقة
!إنّها مُزعجة للغاية

188
00:15:34,550 --> 00:15:35,950
هكذا إذاً

189
00:15:40,090 --> 00:15:43,140
يبدو كيا رائعاً

190
00:15:48,700 --> 00:15:49,850
حدّقتُ لفترة طويلة

191
00:16:05,690 --> 00:16:07,490
كي-تشان، هل تسمعني؟

192
00:16:12,970 --> 00:16:16,540
جولييت وتيبالت تحيط حولهما هالة رائعة

193
00:16:16,540 --> 00:16:18,450
إنّها لا تلاحظ روميو حتّى

194
00:16:45,130 --> 00:16:46,830
!كم هذا جميل

195
00:16:46,830 --> 00:16:48,570
مثاليّ

196
00:16:48,920 --> 00:16:52,260
!حسناً، لنبدأ من مشهد جولييت

197
00:16:52,260 --> 00:16:54,490
!ابدئي حالما تصبحين جاهزة

198
00:16:56,800 --> 00:17:03,250
يا روميو، يا روميو، أين أنت يا روميو؟

199
00:17:05,960 --> 00:17:08,050
!حسناً، حسناً

200
00:17:08,940 --> 00:17:11,300
انتظري لحظة فحسب

201
00:17:11,300 --> 00:17:14,120
...الصّور البصريّة مثاليّة

202
00:17:14,120 --> 00:17:17,300
،بصراحة، بما أنّني لم أشهد أي فرصة تحسُّن لها

203
00:17:17,300 --> 00:17:21,940
أخبرتُها بلطف بأنّها ليس عليها أن تجبر
...نفسها على لعِب الدّور، لكن قالت

204
00:17:23,280 --> 00:17:29,350
شكراً على القلق بشأن مشاعري. لكن سأكون بخير

205
00:17:29,910 --> 00:17:32,440
عامليني معاملة قاسية

206
00:17:32,810 --> 00:17:34,850
!سأعمل بجدّ ولن أستسلم

207
00:17:35,770 --> 00:17:40,490
.فهمت، ستعملين بجدّ ولن تستسلمي
...هذا جدير بالثّناء

208
00:17:40,810 --> 00:17:41,590
لذا أجل

209
00:17:42,050 --> 00:17:43,180
هكذا إذاً

210
00:17:43,750 --> 00:17:46,330
!لنفعل ذلك مرّة أخرى

211
00:17:47,000 --> 00:17:52,710
يا روميو، يا روميو، أين أنت يا روميو؟

212
00:17:53,400 --> 00:17:55,900
!حسناً، هذا يكفي لليوم

213
00:17:55,900 --> 00:17:59,370
يستطيع الجميع الذّهاب إلى المنزل
حالما ينتهون من التّنظيف

214
00:18:00,180 --> 00:18:03,900
!شكراً لعملكم اليوم

215
00:18:03,900 --> 00:18:07,590
!أوتو-كن، تانوكي-كن، كنتما مذهلين

216
00:18:07,590 --> 00:18:08,780
!نصر

217
00:18:09,520 --> 00:18:10,860
...ويا إيساكو-تشان

218
00:18:10,860 --> 00:18:11,840
!نعم؟

219
00:18:14,950 --> 00:18:16,970
ماذا؟

220
00:18:18,990 --> 00:18:25,290
"التّرجمة: "استسلمنا وقبلنا تمثيلكِ السيّئ

221
00:18:26,590 --> 00:18:27,500
...مستحيل

222
00:18:28,100 --> 00:18:32,320
!ظننتُ بأنّني تحسّنتُ كثيراً

223
00:18:33,740 --> 00:18:36,330
ميكيو-سان، لماذا تقول هذا؟

224
00:18:36,730 --> 00:18:39,470
جسّدَتْ إيساكو-سان شخصيّةَ جولييت

225
00:18:39,720 --> 00:18:43,230
سيتأثّر الجمهور بأكمله لدرجة البُكاء

226
00:18:43,680 --> 00:18:47,100
تكذب بوجه صريح كهذا

227
00:18:47,100 --> 00:18:51,450
أوتو كيا: الرّجل الّذي يكذب كلّما تنفّس

228
00:18:51,800 --> 00:18:55,370
...أشعر أنّ ميكيو-سان هو الّذي على حقّ

229
00:18:57,400 --> 00:19:00,990
!تمثيلك بلا نكهة كالفجل

230
00:19:04,250 --> 00:19:06,740
أفراد عائلة تانوكي لا تكذب أبداً

231
00:19:08,730 --> 00:19:11,110
إيساكو-سان، لا تقلقي

232
00:19:11,110 --> 00:19:14,610
إنّه مجرّد مهرجان ثقافيّ. حتّى
لو فشلنا، لن نموت

233
00:19:14,610 --> 00:19:18,270
أنت لا تساعدها يا كي-تشان

234
00:19:18,580 --> 00:19:21,720
!تريد أن ينجح هذا

235
00:19:21,980 --> 00:19:26,660
ماذا أفعل؟ اقترب المهرجان

236
00:19:26,660 --> 00:19:31,730
هل الجميع رأوا تمثيلي فظيعاً؟

237
00:19:33,210 --> 00:19:39,650
إن لم أفعل شيئاً، فسيفسد مهرجان الجميع بسببي

238
00:19:39,650 --> 00:19:42,740
أتريدان منّي أن أسهر وأتدرّب معكما؟

239
00:19:46,450 --> 00:19:48,160
!أجل من فضلك

240
00:19:46,450 --> 00:19:48,160
لا ضرورة لذلك

241
00:19:48,160 --> 00:19:50,380
لماذا قلت ذلك يا كيا؟

242
00:19:50,380 --> 00:19:52,870
أحفظ عبارات روميو

243
00:19:52,870 --> 00:19:54,450
يمكنك التمرّن معي

244
00:19:54,450 --> 00:19:55,800
هذا لن يفلح

245
00:19:55,800 --> 00:20:00,330
ميكيو-سان هو روميو، لذا يجب
أن أتماشى معه

246
00:20:00,330 --> 00:20:01,400
تتماشى؟

247
00:20:02,510 --> 00:20:06,390
!أجل، أجل. أنا روميو

248
00:20:06,390 --> 00:20:10,060
أنا متفرّغ الآن، لذا هل نفعلها هنا فحسب؟

249
00:20:12,290 --> 00:20:15,410
لنغيّر الملابس أوّلاً

250
00:20:15,410 --> 00:20:18,480
سأذهب وأستدعي ذات النظّارة

251
00:20:19,580 --> 00:20:24,740
أنا متأكّدة بأنّ ميكيو-سان يفعل هذا
فقط بنزوة منه، لكنّه مفيد

252
00:20:25,050 --> 00:20:27,120
مرحباً، هذا أنا

253
00:20:30,540 --> 00:20:32,230
ما الأمر يا كيا؟

254
00:20:32,230 --> 00:20:33,090
لا شيء

255
00:20:35,760 --> 00:20:38,830
!حسناً جميعاً، نظِّفوا بسرعة

256
00:20:38,830 --> 00:20:41,570
سنعود إلى المنزل. هل ستكونين بخير؟

257
00:20:41,570 --> 00:20:43,170
أجل

258
00:20:46,350 --> 00:20:48,480
شكراً على البقاء حتّى وقت متأخّر

259
00:20:48,480 --> 00:20:51,220
لا عليكِ. نحن زملاء

260
00:20:51,220 --> 00:20:52,920
لنعُد إلى المنزل

261
00:20:52,920 --> 00:20:54,570
في هذه اللّحظة. حالاً

262
00:20:54,570 --> 00:20:57,160
كي-تشان، أنت حشرة

263
00:21:00,240 --> 00:21:04,340
...يا روميو، روميو... روميو، روميو، روميو

264
00:21:04,340 --> 00:21:07,270
تبدين وكأنّكِ تلعنين شخصاً

265
00:21:07,270 --> 00:21:09,320
تحرّكاتكِ متشنّجة أيضاً

266
00:21:09,320 --> 00:21:10,700
راقبي وتعلّمي

267
00:21:10,970 --> 00:21:16,640
يا روميو، روميو، أين أنت يا روميو؟

268
00:21:17,180 --> 00:21:18,420
هكذا

269
00:21:19,810 --> 00:21:21,840
إنّه بارع

270
00:21:22,250 --> 00:21:25,050
حسناً يا إيساكو-تشان. جرّبي ذلك

271
00:21:27,290 --> 00:21:30,200
...يا روميو

272
00:21:30,660 --> 00:21:32,510
!يبدو صوتكِ خجولاً جدّاً

273
00:21:33,690 --> 00:21:36,890
!يا روميو، روميو

274
00:21:37,180 --> 00:21:38,650
!أجل، هكذا

275
00:21:39,630 --> 00:21:40,820
هذا جيّد

276
00:21:52,160 --> 00:21:54,600
لا تتحرّك يا كي-تشان

277
00:21:56,220 --> 00:21:59,500
وإلّا جرحتُ إيساكو-تشان

278
00:21:59,980 --> 00:22:00,710
ماذا؟

279
00:22:00,710 --> 00:22:02,320
ما الّذي يجري؟