1
00:00:01,860 --> 00:00:04,940
،الآن، في المسرح

2
00:00:05,520 --> 00:00:10,060
ليس عليّ إخفاء حبّي لكيا، أليس كذلك؟

3
00:00:10,900 --> 00:00:16,100
...ثمّ يا عزيزي القدّيس
فلتدع الشّفتين تفعلان ما تفعله الأيدي

4
00:00:42,860 --> 00:00:44,710
...عمليّة العاشق والمعشوق

5
00:00:44,710 --> 00:00:46,810
قد نجحَتْ...

6
00:00:47,230 --> 00:00:50,150
سار هذا بشكل أفضل ممّا توقّعتُ

7
00:00:51,020 --> 00:00:52,970
كم هذا مُملّ

8
00:01:15,920 --> 00:01:23,060
إنّه اليوم الأوّل من المهرجان. أحسنتم
!صنعاً في روميو وجولييت أيّها الصفّ 3-1

9
00:01:23,060 --> 00:01:26,590
!بصحّتكم

10
00:01:26,590 --> 00:01:30,270
!كان عرضاً رائعاً، ويعزو كلّ الفضل لكم جميعاً

11
00:01:33,850 --> 00:01:38,470
بالرّغم من العديد من الحوادث غير
المُتوقّعة، انتهت المسرحيّة بأمان

12
00:01:38,470 --> 00:01:40,490
أنا مطمئنّة جدّاً

13
00:01:41,700 --> 00:01:45,550
...ماذا؟ هل كان صفّنا دوماً

14
00:01:48,480 --> 00:01:49,860
لاحظت إذاً

15
00:01:50,920 --> 00:01:53,300
...بأعمال ما بعد دوام المدرسة والتّدريبات

16
00:01:56,250 --> 00:01:59,850
!هذا صحيح! ازدهر الحبُّ في كلّ مكان

17
00:01:59,850 --> 00:02:02,180
فلتشهدوا: سحر المهرجان الثّقافيّ

18
00:02:02,180 --> 00:02:04,880
حقّاً؟

19
00:02:06,540 --> 00:02:09,890
!وماذا عنكِ؟ كيف هي الأمور مع أوتو-كنظ

20
00:02:09,890 --> 00:02:12,330
حدّثينا عن ثِمار عمليّة العاشق والمعشوق

21
00:02:12,330 --> 00:02:15,910
!كنتُما شاردين في عالمكما في المسرح

22
00:02:16,820 --> 00:02:18,570
...لم نكن كذلك

23
00:02:20,370 --> 00:02:22,550
إذا دنّستُ بيدي عديمة القيمة
،هذا المزار المُقدّس

24
00:02:22,550 --> 00:02:26,350
شفتايّ جاهزتان لقبلة رقيقة

25
00:02:26,350 --> 00:02:31,750
الكفّ بالكفّ وقبلة مُقدّسة

26
00:02:31,750 --> 00:02:36,950
...ثمّ يا عزيزي القدّيس
فلتدع الشّفتين تفعلان ما تفعله الأيدي

27
00:02:41,510 --> 00:02:43,640
!لا، كان ذلك شيئاً قائماً بذاته

28
00:02:44,910 --> 00:02:46,580
!لماذا سرحتِ إلى هناك؟

29
00:02:46,580 --> 00:02:48,320
!هل حدث شيء؟

30
00:02:48,320 --> 00:02:49,370
!لـ-لا

31
00:02:49,890 --> 00:02:53,130
أين كيا على أيّ حال؟

32
00:02:55,190 --> 00:02:58,820
شخصيّاً، أحبّ أكل البسكويت
والحشوة بشكل منفصل

33
00:02:59,150 --> 00:03:02,460
شكراً لك على هذه المعلومة التّافهة غير المُثيرة

34
00:03:03,130 --> 00:03:04,910
!كي-تشان، انظر، انظر

35
00:03:04,910 --> 00:03:06,010
!افتح

36
00:03:13,700 --> 00:03:16,620
ما زال هنا؟

37
00:05:16,010 --> 00:05:17,040
إلى المنزل؟

38
00:05:17,440 --> 00:05:18,500
أجل

39
00:05:18,500 --> 00:05:21,720
لم أتوقّع أن تأتي إلى حفلة الاختتام

40
00:05:21,720 --> 00:05:25,200
كنتُ أمضي الوقت فحسب حتّى
أتى ذو النظّارة ليقلني

41
00:05:27,000 --> 00:05:31,530
،حسناً، أعتقد كنتُ متردّداً قليلاً عن المُغادرة

42
00:05:31,890 --> 00:05:34,710
بما أنّ اليوم هو آخر مرّة سأتمكّن
فيها من رؤيتك ورؤية كي-تشان

43
00:05:35,360 --> 00:05:36,940
سأفتقدكِ

44
00:05:36,940 --> 00:05:39,480
أعلم بأنّكِ لا تعني ذلك

45
00:05:39,740 --> 00:05:44,470
!بل أعنيه! فأنا أحبّكما

46
00:05:44,810 --> 00:05:47,410
!أحبّكما حبّاً جمّاً

47
00:05:47,960 --> 00:05:50,030
ابتعد وذلك كي أتمكّن من العودة إلى الدّاخل

48
00:05:53,130 --> 00:05:57,030
ستتعرّضين لخطر حتّى بعد
مغادرتي يا إيساكو-تشان

49
00:05:57,390 --> 00:06:00,490
مراراً وتكراراً، ما دمتِ مع كي-تشان

50
00:06:03,550 --> 00:06:05,210
مسكينة

51
00:06:06,170 --> 00:06:07,710
مسكينة"؟"

52
00:06:08,990 --> 00:06:13,390
،لا أريد الذّهاب إلى المدرسة معك قطعاً

53
00:06:13,760 --> 00:06:17,680
!لذا ابقَ بعيداً عنّي ما دمت هنا

54
00:06:18,150 --> 00:06:22,660
لا أتحمّل الوقوع في حبّه، لذلك
حاولتُ إبعاد نفسي

55
00:06:30,370 --> 00:06:35,190
لأنّه من المؤلم التّواجد مع شخص
يعيش في عالم المجرمين

56
00:06:39,270 --> 00:06:41,770
...لكنّني

57
00:06:42,670 --> 00:06:45,500
!تـ-توقّف

58
00:06:51,210 --> 00:06:53,760
كنتِ تحاولين حمايتي، أليس كذلك؟

59
00:06:53,990 --> 00:06:55,380
شكراً لكِ

60
00:06:56,950 --> 00:06:58,720
لطالما اخترتُه

61
00:07:02,610 --> 00:07:03,440
أطلِق عليه النّار

62
00:07:03,440 --> 00:07:04,690
!حسناً

63
00:07:05,150 --> 00:07:06,020
!يا للهول

64
00:07:09,390 --> 00:07:10,710
فاجأتِني

65
00:07:12,090 --> 00:07:14,330
،قلقتِ عليّ أكثر من قلقكِ على نفسكِ

66
00:07:15,080 --> 00:07:19,040
رغم أنّ تعرّضكِ لخطر هو غلطتي أنا

67
00:07:19,730 --> 00:07:20,660
!كيا

68
00:07:24,190 --> 00:07:26,810
!لا أريدك أن ترحل

69
00:07:28,260 --> 00:07:30,310
...كلّما تعرّضتُ لخطر

70
00:07:37,290 --> 00:07:40,180
!أنا على وشك مُهاجمة إيساكو-تشان

71
00:07:40,500 --> 00:07:41,190
ماذا؟

72
00:07:44,020 --> 00:07:46,480
!مُحال أن أسمح لك

73
00:07:53,660 --> 00:07:54,730
!إيساكو-سان

74
00:08:01,530 --> 00:08:08,230
كلّما رأيتُ كيا عن كثب أكثر، كان
...التّواجد معه هو كلّ ما أنا

75
00:08:10,520 --> 00:08:12,720
لستُ شخصاً يحتاج شفقة

76
00:08:14,990 --> 00:08:17,420
أنا أفعل هذا رغبةً منّي

77
00:08:19,790 --> 00:08:21,090
شكراً لك

78
00:08:22,090 --> 00:08:23,090
ماذا؟

79
00:08:24,400 --> 00:08:29,020
بفضلك، تمكّنتُ من التأكُّد من مشاعري فعلاً

80
00:08:39,880 --> 00:08:43,500
لديكِ أعصاب فولاذيّة

81
00:08:43,500 --> 00:08:47,580
عد إلى المنزل. سينفجر هاتفك

82
00:08:47,960 --> 00:08:49,440
حسناً، حسناً

83
00:08:51,710 --> 00:08:55,750
كان ذلك إلهاء جيّداً عن الضّجر

84
00:08:56,330 --> 00:08:58,410
!وداعاً الآن

85
00:09:12,330 --> 00:09:13,410
إيساكو-سان؟

86
00:09:13,410 --> 00:09:14,270
كيا

87
00:09:14,270 --> 00:09:15,780
ماذا تفعلين هنا؟

88
00:09:16,010 --> 00:09:18,230
أودّع ميكيو

89
00:09:18,230 --> 00:09:20,670
هل فعل شيئاً لكِ؟

90
00:09:21,210 --> 00:09:22,190
لا تقلق

91
00:09:34,730 --> 00:09:36,560
إنّه صباح مُنعش، أليس كذلك؟

92
00:09:37,030 --> 00:09:40,050
وكأنّ الارتباك في قلبي قد زال

93
00:09:40,330 --> 00:09:42,850
!مرحباً بكما

94
00:09:43,220 --> 00:09:45,700
هل يمكنني لفت اهتمامكما ببانكيك
مع كثير من الكريمة المخفوقة؟

95
00:09:46,170 --> 00:09:47,500
هل ندخل؟

96
00:09:47,500 --> 00:09:48,380
أجل

97
00:09:50,650 --> 00:09:52,020
!أهلاً وسهلاً

98
00:09:55,980 --> 00:09:57,400
...هذا

99
00:10:06,340 --> 00:10:08,440
هذا يشبه المواعيد الغراميّة

100
00:10:08,440 --> 00:10:10,460
تفضّلا طلبكما

101
00:10:10,460 --> 00:10:12,230
شكراً لكِ

102
00:10:12,630 --> 00:10:14,820
!مذهل

103
00:10:15,630 --> 00:10:17,330
هذه كريمة

104
00:10:17,330 --> 00:10:20,590
!بالتّأكيد. يا سلام

105
00:10:21,130 --> 00:10:25,180
خاصّتك على شكل قلب. ربّما
ينبغي أن ألتقط صورة

106
00:10:29,110 --> 00:10:31,700
أليس ذاك هو الثّنائي من البارحة؟

107
00:10:31,700 --> 00:10:34,110
!كلاهما جميلان

108
00:10:34,110 --> 00:10:35,930
!أريد التقاط صورة

109
00:10:35,930 --> 00:10:37,200
!لا تكوني وقحة

110
00:10:37,810 --> 00:10:39,820
هل يتحدّثون عنّا؟

111
00:10:39,820 --> 00:10:43,050
كان ينبغي أن أعلم بأنّ روميو وجولييت يتواعدان

112
00:10:43,450 --> 00:10:45,890
يقصدوننا نحن

113
00:10:45,890 --> 00:10:49,660
لا عجب. كانت الأداء مُقنِعاً لأنّهما
زوجان حقيقيّان

114
00:10:53,380 --> 00:10:55,850
لا بدّ أنّ كيا يسمعهم أيضاً، صحيح؟

115
00:10:57,620 --> 00:10:59,230
ما الّذي يفكّر فيه؟

116
00:10:59,770 --> 00:11:04,460
"سئمتُ من "هل هو كذا وهل هو كذا؟
...أريد ما هو أوضح

117
00:11:07,110 --> 00:11:09,630
هل تريدين من خاصّتي؟

118
00:11:11,320 --> 00:11:13,150
المعذرة، لا تمانع؟

119
00:11:13,150 --> 00:11:14,440
بالطّبع لا

120
00:11:15,250 --> 00:11:17,650
افتحي فمكِ

121
00:11:20,350 --> 00:11:22,550
يمكنني إطعام نفسي

122
00:11:23,190 --> 00:11:25,050
لن تحصلي على أي لقمة إذاً

123
00:11:26,030 --> 00:11:27,930
إذاً لا أريد

124
00:11:56,220 --> 00:11:57,740
نبضات قلبي تتسارع

125
00:12:00,100 --> 00:12:01,990
أكثر ممّا كانت من قبل

126
00:12:03,850 --> 00:12:04,740
كيا؟

127
00:12:05,820 --> 00:12:07,120
هل أنت مستمتع؟

128
00:12:07,510 --> 00:12:08,290
أجل

129
00:12:12,520 --> 00:12:13,580
أنا أيضاً

130
00:12:14,720 --> 00:12:17,300
أريد أن أكون معه هكذا للأبد

131
00:12:17,770 --> 00:12:19,580
هذا ما أعتقده الآن

132
00:12:19,920 --> 00:12:23,650
حسناً، والآن أطعميني لقمة من فضلكِ

133
00:12:23,650 --> 00:12:25,890
مرفوض. هذا مُحرج للغاية

134
00:12:25,890 --> 00:12:28,970
!عفواً، رأيتكما في روميو وجولييت

135
00:12:29,260 --> 00:12:31,150
...إن لم تكونا تمانعان

136
00:12:34,930 --> 00:12:37,480
!مرحى! شكراً جزيلاً لكما

137
00:12:41,950 --> 00:12:45,380
الظّلام أحلك ممّا توقّعت. لا أرى بوضوح

138
00:12:45,380 --> 00:12:48,750
هل أنتِ بخير؟ هل نمسك بأيدي بعضنا؟

139
00:12:49,110 --> 00:12:49,800
لا

140
00:12:53,530 --> 00:12:55,330
...أ-أفزعني ذلك

141
00:12:55,330 --> 00:12:56,540
إيساكو-سان

142
00:13:01,990 --> 00:13:05,760
...لعنة عليك

143
00:13:05,760 --> 00:13:10,140
ما الّذي يجعلك تعتقد بأنّك تستطيع
!ضمّ إيساكو-سان هكذا؟

144
00:13:11,290 --> 00:13:16,980
كيف ستدفع ثمن هذا أيّها المُخيف؟

145
00:13:12,330 --> 00:13:16,980
!توقّف يا كيا، أنت تُخيفه

146
00:13:13,020 --> 00:13:14,980
!غول

147
00:13:17,280 --> 00:13:21,490
مهلاً، ما الفائدة من إخافة الغيلان؟

148
00:13:21,490 --> 00:13:22,580
ليست غلطتي

149
00:13:22,580 --> 00:13:24,230
بل هي كذلك

150
00:13:25,290 --> 00:13:26,750
...فهمت، فهمت

151
00:13:27,270 --> 00:13:30,280
سأقرأ بخت الحبيبة قبل بخت الحبيب

152
00:13:31,030 --> 00:13:31,950
"الحبيبة"

153
00:13:32,840 --> 00:13:37,280
إنّه لا ينكر ذلك؟ أو ربّما لا يفكّر في الأمر حقّاً

154
00:13:38,020 --> 00:13:43,410
أرى بأنّ المُتطفِّل قد هرب، وقلبك
الآن يفيض بالأمل

155
00:13:43,410 --> 00:13:44,890
إنّها غير مخطئة

156
00:13:44,890 --> 00:13:46,280
يسرّني ذلك

157
00:13:50,230 --> 00:13:55,570
تقول هذه البطاقة بأنّكِ ستواجهين
!مصيبة جديدة في المستقبل

158
00:13:57,270 --> 00:13:58,980
فهمت

159
00:13:59,500 --> 00:14:01,920
لا جدوى من الإيمان بهذه الأشياء

160
00:13:59,980 --> 00:14:01,920
!ماذا؟ مهلاً لحظة

161
00:14:01,920 --> 00:14:03,000
!مهلاً

162
00:14:03,000 --> 00:14:07,610
سأقضي على أيّ مصيبة قادمة إليكِ

163
00:14:09,070 --> 00:14:11,820
ألا تريد أن يُقرَا بختك يا كيا؟

164
00:14:11,820 --> 00:14:13,300
لا داعي

165
00:14:14,790 --> 00:14:16,180
!أوتو-تشان

166
00:14:20,490 --> 00:14:21,840
عرفتُ بأنّه أنت

167
00:14:24,650 --> 00:14:25,920
كاوري-سان

168
00:14:28,250 --> 00:14:29,610
أتيتُ لرؤيتك

169
00:14:47,070 --> 00:14:48,310
أتيتُ لرؤيتك

170
00:14:49,690 --> 00:14:52,130
ما الّذي جاء بكِ إلى هنا؟

171
00:14:52,130 --> 00:14:55,830
مذهل، أنت تؤدّي دور طالب الثّانويّة حقّاً

172
00:14:57,600 --> 00:15:01,140
!يبدو هذا الزيّ الرّسمي سخيفاً عليك
هذا مضحك للغاية

173
00:15:01,140 --> 00:15:03,020
—إيساكو-سان، هذه المرأة هي

174
00:15:01,800 --> 00:15:03,020
إيساكو"؟"

175
00:15:03,020 --> 00:15:05,420
إنّها هي إذاً

176
00:15:07,980 --> 00:15:11,200
!ظريفة للغاية! تشبه الدّمية

177
00:15:11,200 --> 00:15:13,640
!أريد أخذها إلى المنزل

178
00:15:15,850 --> 00:15:19,370
...تبدو هذه الرّائحة الحلوة مألوفة

179
00:15:20,830 --> 00:15:22,040
هل أنتِ بخير؟

180
00:15:24,400 --> 00:15:25,770
رائحته حلوة

181
00:15:26,430 --> 00:15:27,460
عطر؟

182
00:15:28,890 --> 00:15:31,660
ربّما انتقل بعض من عطرها إليّ

183
00:15:31,890 --> 00:15:33,060
أفلتني

184
00:15:33,910 --> 00:15:35,410
!لا تلمسني

185
00:15:40,620 --> 00:15:44,170
كاوري-سان، أنتِ تُزعجين إيساكو-سان

186
00:15:44,640 --> 00:15:46,380
آسفة بشأن ذلك

187
00:15:46,970 --> 00:15:49,640
هذه زميلة عمل لي

188
00:15:50,450 --> 00:15:52,260
اسمي سيكيا كاوري

189
00:15:52,650 --> 00:15:55,800
أدير نادياً خاصّ بالأعضاء فقط

190
00:15:56,220 --> 00:15:58,680
شكراً لكِ

191
00:15:59,050 --> 00:16:01,160
اسمي سيناغاكي إيساكو

192
00:16:01,160 --> 00:16:04,510
سررتُ بلقائكِ

193
00:16:07,590 --> 00:16:09,930
إنّها حسناء

194
00:16:11,440 --> 00:16:13,590
ما الّذي جاء بكِ إلى هنا اليوم؟

195
00:16:14,060 --> 00:16:19,180
.أتيتُ لأرى حياتك الثّانويّة هذه
بدَتْ مُثيرة للاهتمام

196
00:16:20,650 --> 00:16:26,130
شخص مثلك، متستّر في مدرسة للأطفال
!بمستقبل مشرق... هذا مُخيف

197
00:16:26,630 --> 00:16:32,170
حسناً، أفترض أنّها لا يمكن أن تكون
مدرسة إذا قبِلوك

198
00:16:29,900 --> 00:16:31,170
...إنّها

199
00:16:32,170 --> 00:16:33,850
هل نتكلّم في مكان آخر؟

200
00:16:34,780 --> 00:16:36,640
هل هذا مناسب يا إيساكو-سان؟

201
00:16:36,640 --> 00:16:38,600
حـ-حسناً

202
00:16:42,450 --> 00:16:44,730
هل أنتِ منتسبة لأيّ نادٍ مدرسيّ يا إيساكو-تشان؟

203
00:16:44,730 --> 00:16:50,010
لا، لستُ كذلك، لكن أنا وكيا عرّيفا صفّ

204
00:16:50,010 --> 00:16:53,240
عرّيفا صفّ؟ أتفعل ذلك يا أوتو-تشان؟

205
00:16:53,240 --> 00:16:54,040
أجل

206
00:16:56,430 --> 00:16:57,940
أخبرني يا أوتو-تشان

207
00:16:58,960 --> 00:17:03,930
أنا عطشانة. هلّا ذهبت واشتريت لي شيئاً أشربه؟

208
00:17:05,210 --> 00:17:06,300
حسناً

209
00:17:11,820 --> 00:17:14,860
!لكن يبدو من المُحرج التّواجد لوحدي معها

210
00:17:15,440 --> 00:17:18,020
!إيساكو-تشان! لنجلس

211
00:17:18,780 --> 00:17:20,460
حـ-حسناً

212
00:17:26,730 --> 00:17:30,410
كنتُ مهتمّة برؤية أوتو-تشان
،بوضع طالب المدرسة الثّانويّة

213
00:17:30,810 --> 00:17:33,110
لكن أردتُ لقاءكِ أيضاً

214
00:17:33,960 --> 00:17:35,650
يسرّني أنّنا تمكنّا من التّحادث

215
00:17:37,180 --> 00:17:41,640
هل أخبرها كيا عنّي؟

216
00:17:42,980 --> 00:17:44,650
...لا بدّ أنّها بالنّسبة لكيا

217
00:17:46,320 --> 00:17:50,670
أليس من الصّعب التّواجد مع شخص وقائيّ جدّاً؟

218
00:17:52,020 --> 00:17:55,560
أجل، أحياناً. لكن هذا مُسلٍّ

219
00:17:57,370 --> 00:17:59,040
كانت نبرتي حادّة للتو

220
00:18:04,830 --> 00:18:06,870
أنتِ ظريفة حقّاً

221
00:18:07,690 --> 00:18:09,210
!فتيات المدرسة الثّانويّة

222
00:18:11,100 --> 00:18:16,090
لا تقلقي. أنا أشجّعكِ يا إيساكو-تشان

223
00:18:16,760 --> 00:18:18,360
ماذا تفعلين؟

224
00:18:19,220 --> 00:18:21,290
أهلاً بعودتك

225
00:18:25,200 --> 00:18:26,410
شكراً

226
00:18:27,310 --> 00:18:29,620
يجب أن أغادر

227
00:18:30,080 --> 00:18:30,820
ماذا؟

228
00:18:31,610 --> 00:18:34,340
!شكراً لكما على اليوم

229
00:18:34,800 --> 00:18:36,890
استمتعا بالمهرجان الثّقافيّ

230
00:18:38,100 --> 00:18:39,110
!إلى اللّقاء

231
00:18:44,570 --> 00:18:47,130
عمّاذا كنتُما تتكلّمان؟

232
00:18:47,680 --> 00:18:51,770
ماذا؟ لا شيء مهمّ

233
00:18:54,130 --> 00:18:56,470
هل أتَتْ لرؤيتي فقط حقّاً؟

234
00:18:57,270 --> 00:18:59,240
هذا ما أريد معرفته

235
00:19:00,680 --> 00:19:04,480
سوف نغلق المكان أمام العامّة
على السّاعة 5 مساء

236
00:19:05,910 --> 00:19:07,250
!لنسرع إلى الميدان

237
00:19:07,250 --> 00:19:09,600
لدينا متّسع من الوقت

238
00:19:10,180 --> 00:19:13,140
إيساكو-سان، حدث الاختتام على وشك البدء

239
00:19:13,140 --> 00:19:14,040
...أجل

240
00:19:15,130 --> 00:19:16,800
هل نخرج؟

241
00:19:20,250 --> 00:19:21,260
سأشاهد من هنا

242
00:19:25,320 --> 00:19:26,560
حسناً

243
00:19:39,540 --> 00:19:40,110
...هل

244
00:19:42,240 --> 00:19:50,250
هل كاوري-سان... حـ-حبيبتك؟

245
00:19:55,450 --> 00:19:56,090
ماذا؟

246
00:20:00,530 --> 00:20:02,410
لا، ليست حبيبتي

247
00:20:03,330 --> 00:20:06,250
ليست حبيبته؟

248
00:20:07,600 --> 00:20:11,610
وماذا يعني؟ من تكون إذاً؟

249
00:20:13,370 --> 00:20:15,900
من الواضح أنّه يوجد شيء بينهما

250
00:20:17,950 --> 00:20:19,140
هكذا إذاً

251
00:20:20,300 --> 00:20:23,320
لكن لا أستطيع سؤاله

252
00:20:39,050 --> 00:20:41,380
هل تغارين؟

253
00:20:44,300 --> 00:20:45,550
!كلّا

254
00:21:24,840 --> 00:21:25,860
أنتِ ظريفة

255
00:21:31,120 --> 00:21:32,900
لا تقترب كثيراً

256
00:21:41,850 --> 00:21:45,520
أنتِ الوحيدة الّتي تستطيعين جعلي
أجلس" أو "أبقى" يا إيساكو-سان"

257
00:21:47,250 --> 00:21:48,050
ماذا؟

258
00:21:49,840 --> 00:21:52,340
لكن لا أعلم إلى متى سأظلّ جالساً

259
00:21:54,470 --> 00:21:56,540
لستُ كلباً حسن التصرُّف