1
00:00:38,410 --> 00:00:38,930
تفضّلي

2
00:00:38,930 --> 00:00:39,680
!ماذا؟

3
00:01:00,710 --> 00:01:02,250
!ها أنا ذا

4
00:01:02,250 --> 00:01:04,080
حسناً! هذا جيّد

5
00:01:05,350 --> 00:01:06,510
!هيّا بنا

6
00:01:15,090 --> 00:01:17,370
!إنّه يتدفّق

7
00:01:21,340 --> 00:01:24,060
سيكون كلّ شيء مختلفاً الآن

8
00:01:25,140 --> 00:01:29,780
سيتمكّن بلدنا من النّهوض بمفرده
من دون دعم عشيرة أُخرى

9
00:01:31,730 --> 00:01:34,580
لعلّ ضيوفنا أُرسِلوا بواسطة الآلهة

10
00:01:35,070 --> 00:01:36,420
لمُساعدتنا

11
00:01:37,660 --> 00:01:39,840
أعتذر يا سوغوري

12
00:01:41,470 --> 00:01:45,850
أعلم أنّه كان من الثّقيل عليك
تحمّل الذّهاب إلى المعركة بمفردك

13
00:01:45,850 --> 00:01:50,380
...وحماية بلدنا وعائلتنا وأخواتنا

14
00:01:51,270 --> 00:01:53,380
وكلّ هذا مع الانحناء لساكاكي-ساما

15
00:01:54,230 --> 00:01:57,000
حسناً، هذا مُخيّب

16
00:01:57,880 --> 00:02:02,250
بذلتُ قصارى جهدي للادّعاء بأنّني
حقّقتُ كلّ هذا بسهولة

17
00:02:03,050 --> 00:02:05,290
مع ذلك، يبدو أنّني فشلت

18
00:02:06,070 --> 00:02:09,990
،أتعلمين؟ حالما رأيتُ وجهكِ ثانية
غمرتني السّعادة

19
00:02:07,780 --> 00:02:10,140
!ناتسومي

20
00:02:10,140 --> 00:02:13,650
!ماء النّبع يتدفّق

21
00:02:10,490 --> 00:02:12,990
ظننتُ بأنّه سيكون كلّ شيء
...قد تمّ تولّي أمره الآن

22
00:02:14,570 --> 00:02:18,820
حالما تمدّين يدكِ لساكاكي-ساما

23
00:02:20,310 --> 00:02:23,110
أنا متأكّدة بأنّكِ فعلتِ. أعتذر

24
00:02:23,590 --> 00:02:27,170
لا حاجة. أنا فقط خجلة من نفسي

25
00:02:28,850 --> 00:02:29,670
على ماذا؟

26
00:02:30,460 --> 00:02:35,490
أردتِ أن تكوني حُرّة. كنتُ مُدرِكة
تماماً لنواياكِ يا ناتسومي

27
00:02:35,870 --> 00:02:40,790
.لكن حاولتُ أن أُخفيها خلف طموحاتي
كان ذلك مُخزياً

28
00:02:42,730 --> 00:02:45,070
سامحيني أرجوكِ يا أختي العزيزة

29
00:02:46,100 --> 00:02:48,250
ما زال أبي يُبهرني حتّى يومنا هذا

30
00:02:48,590 --> 00:02:49,190
ماذا؟

31
00:02:49,190 --> 00:02:54,870
حتّى عندما كنتِ طفلة، رأى فيكِ
الإمكانيّة في أن تصبحي قائدة حقيقيّة

32
00:02:55,700 --> 00:02:58,660
!ما-ماذا؟ كم هذا سخيف

33
00:02:58,660 --> 00:03:03,700
لكن يا سوغوري، هناك بعض الأشياء
الّتي يجب ألّا تنسيها أبداً. وهي أنّكِ حُرّة أيضاً

34
00:03:04,220 --> 00:03:09,350
وبينما أقدّر حُرّيتي، لا أنوي التخلّي عنكِ

35
00:03:09,350 --> 00:03:10,710
...أختي

36
00:03:11,670 --> 00:03:14,260
ولا أن أجبركِ على حمل أعباء

37
00:03:14,260 --> 00:03:17,750
بلدنا وعائلتنا وأخواتنا بمفردك

38
00:03:19,110 --> 00:03:20,470
...أو

39
00:03:22,500 --> 00:03:26,720
أثمن سرّ لدى عائلتنا

40
00:05:02,780 --> 00:05:04,750
أنا أتحلّل

41
00:05:04,750 --> 00:05:06,700
بل وأتبخّر حتّى

42
00:05:06,700 --> 00:05:08,450
أذوب

43
00:05:08,450 --> 00:05:10,450
نعم يا مدام

44
00:05:10,450 --> 00:05:12,350
أذوب وأختفي تدريجيّاً

45
00:05:13,850 --> 00:05:17,140
آمل ألّا نفعل، بعد تغيير التّاريخ

46
00:05:18,210 --> 00:05:21,090
،أنا واثقة بأنّكِ من النّوع الّذي يسأل دوماً

47
00:05:21,090 --> 00:05:24,430
"ألم تُنجزي وظيفتكِ الصّيفيّة بعد؟"
في حين أنّنا ما زلنا في إجازة

48
00:05:24,430 --> 00:05:25,970
لا أعرف ما الّذي يعنيه ذلك حتّى

49
00:05:25,970 --> 00:05:30,410
حسناً، إذا لم نعُد مُتواجدين، فأنا
متأكّدة بأنّنا سنُفكّر في شيء

50
00:05:30,410 --> 00:05:32,070
أجل، معكِ حقّ

51
00:05:32,070 --> 00:05:34,110
إذا توقّفنا عن الوجود، لن نفكّر إطلاقاً

52
00:05:34,950 --> 00:05:37,650
لكن كانت هذه مُفاجأة في الواقع

53
00:05:37,650 --> 00:05:41,950
لم أتوقّع أبداً أن تشاركينا في حفر
نبع ساخن وما شابه

54
00:05:41,950 --> 00:05:43,490
،أجل، في الواقع

55
00:05:43,490 --> 00:05:46,890
ربّما يمكنكِ القول بأنّها الاستماتة
على فعل شيء ما

56
00:05:47,240 --> 00:05:50,450
ربّما أردتِ تحويل ذلك الحضيض
!إلى مصدر ثروة احتياطيّ

57
00:05:50,450 --> 00:05:51,660
لم أفهم شيئاً

58
00:05:51,660 --> 00:05:52,990
ماذا؟ لِمَ لا؟

59
00:05:53,220 --> 00:05:56,150
بالمناسبة، ماذا كنتِ تقولين
حول ذلك من قبل؟

60
00:05:56,150 --> 00:05:56,750
ماذا؟

61
00:05:56,750 --> 00:05:59,650
شيء عن وصول سومومو-سان للحضيض
أو ما شابه ذلك

62
00:05:59,650 --> 00:06:02,130
أجل

63
00:06:02,130 --> 00:06:07,260
ذكرتْ شيئاً عن أنّها هي السّبب في عدم
بلوغها حزام سراجها بعد

64
00:06:07,770 --> 00:06:10,630
كما لو أنّها كانت تُعاقَب أو ما شابه

65
00:06:10,630 --> 00:06:11,660
تُعاقَب؟

66
00:06:11,660 --> 00:06:13,760
قالت لأنّها خرجتْ

67
00:06:14,460 --> 00:06:16,110
ماذا؟ ماذا تقصدين؟

68
00:06:16,770 --> 00:06:23,020
خرجتُ والتقيتُ بشخص وقضيتُ
وقتاً مُمتعاً. بمفردي فحسب

69
00:06:23,020 --> 00:06:24,460
بمُفردكِ؟

70
00:06:24,460 --> 00:06:26,030
!لا شيء

71
00:06:26,030 --> 00:06:27,810
!لا مزيد من الكلام عن ذلك

72
00:06:28,190 --> 00:06:29,030
رأيتِ؟

73
00:06:29,250 --> 00:06:32,820
ماذا قصدتْ؟ ما علاقة هذا بذاك؟

74
00:06:32,820 --> 00:06:35,420
أليس كذلك؟ إنّه حضيض حقيقيّ

75
00:06:35,420 --> 00:06:36,790
لا، هذا مُختلف

76
00:06:36,790 --> 00:06:38,280
هذا غير مفهوم

77
00:06:38,280 --> 00:06:39,940
!أجل، إنّه حضيض

78
00:06:39,940 --> 00:06:40,900
بدأتْ تفهم ذلك

79
00:06:40,900 --> 00:06:42,790
أجل، بدأتُ أشعر بذلك فعلاً

80
00:06:43,770 --> 00:06:45,490
ما الخطب يا ناناسي؟

81
00:06:45,490 --> 00:06:47,420
ماذا؟ لا شيء

82
00:06:49,050 --> 00:06:50,800
حريّ بي الذّهاب. أشعر بدُوار خفيف

83
00:07:01,540 --> 00:07:02,930
أهلاً بعودتك

84
00:07:03,270 --> 00:07:05,530
آسفة على المُقاطعة

85
00:07:05,530 --> 00:07:08,400
لا عليكِ. كيف كان الماء؟

86
00:07:08,400 --> 00:07:13,600
جيّد! طلبنا منهن الاستحمام كلّ
شخص على حِدة كذلك

87
00:07:13,600 --> 00:07:14,070
ماذا؟

88
00:07:14,300 --> 00:07:17,140
إذاً يمكنك الاستحمام هناك أيضاً يا سوغوري-سان

89
00:07:18,610 --> 00:07:20,040
!شكراً جزيلاً لكِ

90
00:07:20,970 --> 00:07:23,040
...على ذكر الأمر

91
00:07:23,040 --> 00:07:23,810
نعم؟

92
00:07:23,810 --> 00:07:28,370
ألم تذكر شيئاً من قبل عن وجود
خمسة أخوات؟

93
00:07:29,580 --> 00:07:32,150
أليس لديك أخت أُخرى؟

94
00:07:32,700 --> 00:07:37,020
لا، أنا آسف. لا بُدّ أنّني أخطأتُ التّعبير

95
00:07:46,380 --> 00:07:48,420
شكراً لك

96
00:07:48,420 --> 00:07:49,610
أين الجميع؟

97
00:07:49,610 --> 00:07:54,170
القائد هو سومومو-سان، ونوزومي-سان
،مع آنزو-تشان

98
00:07:54,170 --> 00:07:56,200
وناناسي مع ناتسومي-سان

99
00:07:56,200 --> 00:07:58,690
أعتقد بأنّهم مُنسجمون جميعاً

100
00:07:58,690 --> 00:08:01,210
من الأفضل غالباً ألّا ينسجموا

101
00:08:01,210 --> 00:08:05,140
قـ-قد تكونين على حقّ. قد ينتهي
المطاف بنا بتغيير التّاريخ

102
00:08:05,140 --> 00:08:06,820
...لا، هذا ليس

103
00:08:08,250 --> 00:08:08,960
ماي"؟"

104
00:08:08,960 --> 00:08:11,470
ماذا؟

105
00:08:11,750 --> 00:08:12,900
بخصوص هذا أيضاً

106
00:08:13,580 --> 00:08:16,660
دائماً ما تفقد ماي-تشان الأشياء
عندما تذهب إلى المسبح أو ما شابه

107
00:08:16,660 --> 00:08:17,970
كطفلة؟

108
00:08:18,230 --> 00:08:19,490
صحيح؟

109
00:08:19,490 --> 00:08:22,150
قالت هارو-تشان لهذا السّبب كانت
تُطرّز اسمها عليها

110
00:08:22,150 --> 00:08:23,480
هارو-تشان؟

111
00:08:23,480 --> 00:08:25,840
!حسناً! وهكذا يتمّ الأمر

112
00:08:25,840 --> 00:08:27,230
!كم هذا جميل

113
00:08:27,230 --> 00:08:29,500
...والآن نفعل هذا

114
00:08:31,420 --> 00:08:34,570
مُبهر! هل كانت هذه فكرتكِ يا ماي؟

115
00:08:34,570 --> 00:08:37,840
لا. هارو-تشان من علّمتني كيفيّة فعل ذلك

116
00:08:37,840 --> 00:08:38,950
هارو-تشان؟

117
00:08:38,950 --> 00:08:43,250
الشّخص الّذي ربّاني منذ كنتُ في العاشرة

118
00:08:44,490 --> 00:08:48,090
كلّاً من والدَي القائد قد تُوفّيا، أليس كذلك؟

119
00:08:48,550 --> 00:08:51,860
حدث ذلك عندما كانت ماي-تشان في العاشرة

120
00:08:53,330 --> 00:08:56,640
أمّي وأبي كلاهما أحبّا البولينغ

121
00:08:56,640 --> 00:09:01,180
بدآ يعلّمانني عندما كنتُ صغيرة
بل وحتّى سمحا لي بالانضمام لنادٍ

122
00:09:02,150 --> 00:09:07,390
كنتُ كلّما ربحتُ ببطولة، كانا
يعتزّان بي دوماً

123
00:09:07,390 --> 00:09:10,380
!لطالما أسعداني

124
00:09:11,210 --> 00:09:13,710
كنتُ في الواقع في بطولة
في اليوم الّذي حدث ذلك

125
00:09:14,410 --> 00:09:17,490
ذهبتُ إلى هناك على متن حافلة
مع جميع زميلاتي في النّادي

126
00:09:17,490 --> 00:09:21,450
قال أبي وأمّي بأنّهما سيذهبان
إلى هناك بسيّارة لمُشاهدتي

127
00:09:21,910 --> 00:09:22,870
...لكن حينها

128
00:09:27,370 --> 00:09:30,820
تعرّضا لحادث في الطّريق إلى حلبة البولينغ

129
00:09:30,820 --> 00:09:33,380
مع سائق شاحنة كان نائماً أثناء السّير

130
00:09:33,610 --> 00:09:37,980
في البداية، انتقلتْ ماي-تشان
،مع بعض أقربائها

131
00:09:37,980 --> 00:09:40,570
لكن يبدو أنّ ذلك لم يفلح

132
00:09:41,140 --> 00:09:45,710
أتفهّم تماماً سبب عدم رغبتكِ في
البقاء مع شخص لا يحبّك

133
00:09:46,470 --> 00:09:49,310
ماي-تشان لم تقل ذلك باستخفاف
إطلاقاً. لم تفعل ذلك

134
00:09:53,630 --> 00:09:55,810
ثمّ تمّ إرسالي إلى ميتم

135
00:09:58,170 --> 00:10:02,110
.كانت هارو-تشان إحدى المُتطوِّعات هناك
انتهى المطاف بتبنّيها لي

136
00:10:03,620 --> 00:10:06,530
...الميتم هو أشبه بـ

137
00:10:06,530 --> 00:10:07,750
كيف فعلتِها؟

138
00:10:08,100 --> 00:10:08,620
ماذا؟

139
00:10:08,620 --> 00:10:12,900
بعد تحمُّل مأساة فظيعة كهذه
،وإيجاد نفسك وحيدة تماماً

140
00:10:13,250 --> 00:10:15,450
كيف أصبحتِ الشّخص الّذي أنتِ عليه الآن؟

141
00:10:16,260 --> 00:10:17,350
من أنا الآن؟

142
00:10:17,970 --> 00:10:20,390
أجل. مُشرِقة كما الشّمس

143
00:10:20,390 --> 00:10:24,710
،ا-الشّمس؟! في الواقع،
...لا أدري بشأن ذلك

144
00:10:25,140 --> 00:10:26,640
أخبريني أرجوكِ

145
00:10:31,090 --> 00:10:34,060
ربّما لأنّني التقيتُ بهارو-تشان على ما أعتقد

146
00:10:34,520 --> 00:10:36,530
هكذا إذاً

147
00:10:36,780 --> 00:10:41,030
.آسفة! لم أقصد تعكير صفو الأجواء
!لنذهب ونلعب البولينغ

148
00:10:41,470 --> 00:10:43,530
...ماي، أنا في الواقع

149
00:10:43,530 --> 00:10:46,410
أعلم. لا تريدين الخروج، صحيح؟

150
00:10:46,410 --> 00:10:49,540
No problem! We'll use that set you had before.

151
00:10:50,470 --> 00:10:54,170
آسفة. تخلّيتُ عن كلّ ذلك

152
00:10:54,900 --> 00:10:55,710
ماذا؟

153
00:10:55,710 --> 00:10:57,930
سئمتُ من البولينغ

154
00:11:00,190 --> 00:11:01,300
...في الحقيقة

155
00:11:01,300 --> 00:11:04,660
بدلاً من ذلك يا ماي، هلّا
علّمتني مزيداً من الأوريغامي؟

156
00:11:05,350 --> 00:11:07,930
بالتّأكيد! أنا متأكّدة بأنّكِ أدمنتِ

157
00:11:09,810 --> 00:11:12,660
قد يكون هذا مُمتعاً حتّى
لو كنتِ لوحدكِ

158
00:11:14,550 --> 00:11:17,820
بالتّأكيد. لعبة مُمتعة أستطيع
أن ألعبها لوحدي

159
00:11:19,380 --> 00:11:23,140
سومومو-تشان، ناناسي وناتسومي-سان
قالتا شيئاً قبل قليل

160
00:11:23,140 --> 00:11:26,330
النّبع السّاخن ليس جيّداً فقط
لجذب السّائحين

161
00:11:26,330 --> 00:11:31,160
يمكن استخدام الحرارة من الماء لزراعة
المحاصيل وما شابه. لديه استعمالات كثيرة

162
00:11:31,160 --> 00:11:35,340
قيل ربّما أنّه إذا امتلكت واحداً، فلن
تحتاج حماية عشيرة أُخرى بعد الآن

163
00:11:38,270 --> 00:11:39,850
لذا قد يكون كلّ شيء على ما يُرام

164
00:11:40,420 --> 00:11:45,760
إذا، أقول إذا، لكن إذا لم تأتِ دورتك
—بعد، فقد لا تحتاجين للذّهاب والزّواج

165
00:11:45,760 --> 00:11:46,610
لكن يجب عليّ ذلك

166
00:11:47,350 --> 00:11:52,350
يجب عليّ أن أذهب. بلا شكّ

167
00:11:52,350 --> 00:11:53,350
—لكن لماذا

168
00:11:54,220 --> 00:11:58,510
لكن حينئذ قلتُ لنفسي أنّه لم يكن
ذلك مكاني فعلاً

169
00:11:58,510 --> 00:12:01,530
إنّ صدّ قِيَم شخص ووجهة نظره

170
00:12:01,530 --> 00:12:05,500
لا يختلف عن رفض حياتهم
كلّها وصولاً إلى تلك اللّحظة

171
00:12:06,370 --> 00:12:07,490
ماي؟

172
00:12:07,490 --> 00:12:08,390
ماذا؟

173
00:12:08,940 --> 00:12:11,620
هل تعتقدين بأنّني أستطيع أن أتألّق
أيضاً كما الشّمس يوماً ما؟

174
00:12:13,050 --> 00:12:19,010
أتساءل إذا، حالما أصبح وحيدة، سوف
ألتقي بهارو-تشان خاصّتي يوماً ما

175
00:12:24,610 --> 00:12:26,050
صاعقة برق؟

176
00:12:26,300 --> 00:12:30,390
أجل. كذلك الشّيء من قبل. ومض ضوء برّاق

177
00:12:30,390 --> 00:12:32,250
ثمّ "دويّ"! ليضرب الأرض

178
00:12:32,250 --> 00:12:35,980
أعلم ذلك! كفّي عن السّخرية منّي
!وكأنّني طفلة ما

179
00:12:36,620 --> 00:12:38,320
!آسفة، آسفة

180
00:12:41,050 --> 00:12:44,730
فهمت. إذاً ضربَ البرقُ في نهاية المطاف

181
00:12:44,730 --> 00:12:48,460
أجل. ضرب عندما أُحضِرنا إلى هنا كذلك

182
00:12:48,460 --> 00:12:52,110
إذا استطعنا اكتشاف الصّلة بين البرق
،والسّفر عبر الزّمن

183
00:12:52,110 --> 00:12:56,350
فقد نتمكّن من إيجاد طريقة لإعادتكن
إلى المنزل من دون البرق

184
00:13:00,100 --> 00:13:02,090
ستعُدن إلى المنزل إذاً

185
00:13:02,090 --> 00:13:02,940
ماذا؟

186
00:13:02,940 --> 00:13:08,700
،في المرّة المُقبلة الّتي يضرب فيها البرق
ستعُدن جميعاً... إلى المُستقبل

187
00:13:11,750 --> 00:13:17,110
أحياناً أتساءل فيما إن كان من الأفضل
البقاء هنا، بصراحة

188
00:13:17,110 --> 00:13:18,020
ماذا؟

189
00:13:18,020 --> 00:13:23,720
،في المدرسة الثّانويّة، قبل أن ألتقي بصديقاتي
كنتُ كالهواء فعلاً

190
00:13:23,720 --> 00:13:29,530
قضيتُ كلّ وقتي في المكتبة وقرأتُ
كلّ كتاب وجدتُه في طريقي

191
00:13:29,980 --> 00:13:36,150
،تلقّيتُ الكثير من المعرفة العشوائيّة
لكن لم تكُن مفيدة قبل مجيئي إلى هنا

192
00:13:36,750 --> 00:13:37,930
لم تكن كذلك؟

193
00:13:39,170 --> 00:13:41,950
نعيش في عالم حيث لا نحتاج
للمعرفة لتدبّر أمورنا

194
00:13:41,950 --> 00:13:46,850
لدينا آلات مثل الحاسوب الشّخصيّ والهواتف
الذّكيّة الّتي تدعكِ تبحثين عن أيّ شيء فوراً

195
00:13:47,980 --> 00:13:50,380
آلات تستطيع فعل ذلك فوراً؟

196
00:13:51,100 --> 00:13:55,060
.لم يراودني هذا الشّعور من قبل
...لكن هذا أشبه... لا أدري

197
00:13:55,060 --> 00:13:57,870
،أنا نافعة أخيراً ولو لمرّة في حياتي
أو شيء من هذا القبيل

198
00:14:00,820 --> 00:14:04,570
.لكن ليس عليكِ القلق. أتفهّم ذلك
سأعود إلى الدّيار

199
00:14:04,570 --> 00:14:07,620
سأحرص على أن تعود الفتيات الأُخريات
إلى الدّيار كذلك

200
00:14:09,750 --> 00:14:14,830
لستُ قلقة بشأن ذلك. أنا فقط أتمنّى
أن أستطيع إبقاءكن هنا فترة أطول

201
00:14:17,670 --> 00:14:21,310
على ذكر الأمر، ماذا كنتم تفعلون بالضّبط

202
00:14:21,310 --> 00:14:23,490
عندما ضربَ وميض الضّوء ذاك من السّماء؟

203
00:14:24,020 --> 00:14:24,810
ماذا؟

204
00:14:24,810 --> 00:14:29,090
ظننتُ بأنّ ذلك قد يوفّر لنا
طرف خيط من نوع ما

205
00:14:29,090 --> 00:14:30,640
كنّا نلعب البولينغ

206
00:14:30,640 --> 00:14:31,340
ماذا؟

207
00:14:31,610 --> 00:14:34,190
!هل سمعتِ بها؟ إنّها مُسلّية

208
00:14:34,190 --> 00:14:37,350
نصفّ قطعاً خشبيّة ونُدحرج كُرة لإسقاطها

209
00:14:37,640 --> 00:14:42,540
الرّحال هو من علّمني. قال بأنّه كان
يلعبها مع طفله

210
00:14:47,070 --> 00:14:48,180
!رينا

211
00:14:52,970 --> 00:14:55,530
المعذرة، آسفة لأنّني لم أستأذن

212
00:14:55,530 --> 00:14:59,090
كان سكّان القرية يستخدمون
مسار البولينغ في المزار

213
00:14:59,620 --> 00:15:02,660
هذا غير مُهمّ. هذا ليس لأجلي
فقط على أيّ حال

214
00:15:03,370 --> 00:15:07,630
هذا صحيح. صنعتِه لنا جميعاً، أليس كذلك؟

215
00:15:09,670 --> 00:15:10,700
هذا غير مُهمّ

216
00:15:21,690 --> 00:15:24,400
هذا مستحيل تماماً. إنّه غير مُرجّح تماماً

217
00:15:24,400 --> 00:15:25,650
ما الأمر؟

218
00:15:25,650 --> 00:15:27,380
!أتكلّم مع نفسي فقط

219
00:15:28,220 --> 00:15:30,770
لكن من المؤكّد أنّنا لا نحظى بكثير من البرق

220
00:15:30,770 --> 00:15:32,840
...ناناسي

221
00:15:32,840 --> 00:15:33,870
نعم؟

222
00:15:34,210 --> 00:15:36,660
ذكّريني لماذا سنعود إلى الدّيار؟

223
00:15:38,300 --> 00:15:40,410
وهل عليّ الإجابة؟

224
00:15:44,430 --> 00:15:47,670
كان ذلك مُمتعاً! شكراً جزيلاً يا رينا

225
00:15:48,910 --> 00:15:50,490
تخسرين باستمرار يا قائدة

226
00:15:50,490 --> 00:15:51,420
ماذا؟

227
00:15:51,420 --> 00:15:55,010
هل للأمر علاقة بما حدث مع والديكِ؟

228
00:15:56,430 --> 00:16:01,940
حدّثتني سايوري عن الأمر. إن لم تُريديني
أن أعرف، فأعتذر إذاً

229
00:16:02,440 --> 00:16:05,440
لا، هذا لا يُضايقني إطلاقاً

230
00:16:05,440 --> 00:16:08,960
ليس وكأنّني كنتُ أحاول إخفاء
الأمر عنكِ أو ما شابه

231
00:16:08,960 --> 00:16:11,340
إنّها مُجرّد قصّة كئيبة، هذا كُلّ ما في الأمر

232
00:16:11,340 --> 00:16:12,560
ليست كئيبة

233
00:16:12,560 --> 00:16:13,460
ماذا؟

234
00:16:13,460 --> 00:16:15,340
ليست قصّة كئيبة إطلاقاً

235
00:16:15,750 --> 00:16:18,450
إنّها مُلهِمة يا قائدة. إنّها تُثبت
كم أنتِ قويّة

236
00:16:21,210 --> 00:16:22,460
!شكراً

237
00:16:31,870 --> 00:16:36,910
لكن بصراحة، لا أعلم. بدأتُ أخسر
،بعد أن حدث ذلك

238
00:16:36,910 --> 00:16:39,210
لذا ربّما هناك رابط من نوع ما

239
00:16:39,620 --> 00:16:44,190
.لكن لا أملك أدنى فكرة عن ماهيّة ذلك
ما قد يكون يا ترى؟

240
00:16:44,620 --> 00:16:45,720
توركي

241
00:16:45,720 --> 00:16:46,340
ماذا؟

242
00:16:46,340 --> 00:16:48,390
عندما أحرزتِ توركي، أمست
الأمور غريبة الأطوار

243
00:16:49,190 --> 00:16:51,090
ماذا؟ ماذا تقصدين؟

244
00:16:51,090 --> 00:16:52,210
أنتِ يا قائدة

245
00:16:52,210 --> 00:16:53,240
!أنا؟

246
00:16:53,240 --> 00:16:55,280
،دائماً ما تبدئين بطريقة مثاليّة

247
00:16:56,250 --> 00:16:59,240
لكن بعد أن تصلي إلى الإطار
الرّابع، تبدئين بتضييعها

248
00:16:59,240 --> 00:17:00,620
أظنّكِ على حقّ

249
00:17:01,770 --> 00:17:05,370
أعتذر على قولي هذا الكلام

250
00:17:06,210 --> 00:17:08,710
لا مُشكلة. أنا آسفة أيضاً

251
00:17:09,700 --> 00:17:12,370
لم أفهم حقّاً ما الّذي كنتِ تقصدينه

252
00:17:13,650 --> 00:17:15,710
لكن سأحاول إيجاد حلّ لهذا
الأمر يا رينا

253
00:17:16,610 --> 00:17:18,700
لا أريدكِ أن ينتهي المطاف بكِ وحيدة

254
00:17:19,100 --> 00:17:20,660
سأحاول إيجاد حلّ أيضاً

255
00:17:22,180 --> 00:17:23,260
...إيجاد حلّ

256
00:17:25,150 --> 00:17:27,520
لكِ لتفوزي ضدّ نفسكِ يا قائدة

257
00:17:29,130 --> 00:17:30,270
!شكراً

258
00:17:31,070 --> 00:17:33,250
لكن قبل كلّ شيء، يجب علينا
!العودة إلى المنزل

259
00:17:38,780 --> 00:17:39,700
!أجل

260
00:17:58,310 --> 00:17:59,300
بولينغ؟

261
00:17:59,670 --> 00:18:01,410
ماذا الآن؟

262
00:18:01,410 --> 00:18:03,820
ألم يبدُ ذلك كبولينغ؟

263
00:18:03,820 --> 00:18:05,530
كبولينغ؟

264
00:18:05,530 --> 00:18:08,770
ماذا لو بدا كبولينغ؟

265
00:18:09,310 --> 00:18:11,450
سمعتُن ذلك، صحيح؟

266
00:18:11,450 --> 00:18:12,880
سمعتُ ذلك

267
00:18:12,880 --> 00:18:14,460
من يكون برأيكن؟

268
00:18:14,460 --> 00:18:16,070
!لا، لا، لا، لا، لا

269
00:18:16,070 --> 00:18:17,120
هذا مستحيل

270
00:18:17,120 --> 00:18:20,410
من يلعب بولينغ في منتصف اللّيل؟

271
00:18:20,820 --> 00:18:23,670
ما الّذي يصدر ذلك الصّوت إذاً؟

272
00:18:24,080 --> 00:18:24,970
لصّ

273
00:18:24,970 --> 00:18:25,830
!ماذا؟

274
00:18:27,750 --> 00:18:30,830
ما زلتُ أعتقد بأنّنا ينبغي أن
نحضر سوغوري-سان

275
00:18:31,100 --> 00:18:34,060
الأهمّ، لِمَ عليّ الذّهاب أوّلاً؟

276
00:18:34,060 --> 00:18:36,580
حسناً، أنتِ الصُّغرى، أليس كذلك؟

277
00:18:36,580 --> 00:18:37,710
سنذهب بحسب الطّول؟

278
00:18:38,590 --> 00:18:40,670
ماذا؟ لماذا أحضرتِ كُراتكِ؟

279
00:18:40,670 --> 00:18:43,220
ماذا؟ لأنّه إذا كان هناك مَن يلعب
البولينغ، فسوف ننضمّ له

280
00:18:43,220 --> 00:18:46,960
ما أنتنّ بالنّسبة للبولينغ على أيّ حال؟ أنصار؟

281
00:18:46,960 --> 00:18:47,980
..."أنصار"

282
00:18:49,230 --> 00:18:52,770
يزداد الصّوت علواً. يا إلهي

283
00:18:55,290 --> 00:18:56,850
إنّها نهاية مسدودة

284
00:18:56,850 --> 00:18:58,350
ماذا؟ ما معنى هذا؟

285
00:18:59,470 --> 00:19:02,220
!إ-إ-إنّه قادم من خلف الجدار

286
00:19:02,220 --> 00:19:05,530
ماذا؟ تقصدين بأنّ الأمور تؤول إلى إحدى
تلك المواقف؟ مواقف مُخيفة؟

287
00:19:05,530 --> 00:19:07,270
ماذا تقصدين؟ أيّ موقف؟

288
00:19:07,270 --> 00:19:09,300
مثل زومبي؟ شيء شنيع؟

289
00:19:09,300 --> 00:19:12,570
!شيء مُخيف! قلتُ ذلك للتو! كموقف رُعب

290
00:19:12,570 --> 00:19:14,730
مـ-موقف رُعب؟ مثل ساداكو؟

291
00:19:14,730 --> 00:19:16,750
كاياكو؟ مايكل؟ أيّهما؟

292
00:19:17,470 --> 00:19:20,030
—كبيت مسكون أو ما شابـ

293
00:19:46,430 --> 00:19:47,540
!مُخيف

294
00:19:48,930 --> 00:19:49,770
هيّا بنا

295
00:19:50,790 --> 00:19:52,520
!لا، لا، لا، لا، لا

296
00:19:52,520 --> 00:19:54,790
ربّما لا يجدر بنا ذلك

297
00:19:54,790 --> 00:19:58,020
يجب علينا الذّهاب وإحضار حقيبة رينا

298
00:20:01,850 --> 00:20:03,810
!كفّي عن دفعي

299
00:20:03,810 --> 00:20:07,210
أنا لا أدفعكِ. أنتِ بطيئة
جدّاً فأصطدم بكِ

300
00:20:11,750 --> 00:20:12,750
!مُخيف

301
00:20:12,750 --> 00:20:14,060
غرفة تحت الأرض؟

302
00:20:15,020 --> 00:20:16,290
ينبغي أن نُغادر

303
00:20:16,290 --> 00:20:16,850
ماذا؟

304
00:20:16,850 --> 00:20:20,390
من الواضح أنّ هذا المكان ليس لنا. إطلاقاً

305
00:20:20,750 --> 00:20:23,010
ماي-سان، أسرعي واسترجعي الكُرة رجاء

306
00:20:23,770 --> 00:20:25,590
حـ-حسناً

307
00:20:43,590 --> 00:20:44,490
من؟

308
00:20:51,060 --> 00:20:52,850
سومومو-تشان؟

309
00:20:52,850 --> 00:20:53,900
ماي

310
00:20:54,850 --> 00:20:55,850
ماذا؟

311
00:20:56,850 --> 00:20:57,830
توقّعتُ ذلك

312
00:20:57,830 --> 00:20:58,460
ماذا؟

313
00:20:58,460 --> 00:21:00,820
من المُؤسف أن تروا ذلك

314
00:21:12,250 --> 00:21:13,420
...أن تروا

315
00:21:15,310 --> 00:21:16,670
!سرّ هذا المنزل