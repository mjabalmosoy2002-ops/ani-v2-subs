183
00:13:32,300 --> 00:13:33,430
!هذا هُراء

184
00:13:36,120 --> 00:13:37,340
مُوافقة

185
00:13:41,110 --> 00:13:42,950
سومومو-تشان، هل تتذكّرين الآن؟

186
00:13:42,950 --> 00:13:43,760
أجل

187
00:13:43,760 --> 00:13:47,930
صوّبي نحو الفتحة بين المُثلّث الأوسط
والّذي على يمينه

188
00:13:47,930 --> 00:13:49,010
الفتحة بينهما

189
00:13:49,010 --> 00:13:53,010
ثمّ عندما ترمين الكُرة، تخيّلي
بأنّكِ تُصافحينها

190
00:13:53,250 --> 00:13:55,050
حتّى آخر، آخر لحظة

191
00:13:55,050 --> 00:13:57,770
حتّى بعد أن أُفلت. للأبد

192
00:14:05,170 --> 00:14:07,770
!فعلتِها! ضربة إصابة كاملة

193
00:14:10,790 --> 00:14:13,620
.سايوري، نوزومي، ناناسي
الدّبابيس، الدّبابيس

194
00:14:30,510 --> 00:14:32,600
—لا مُشكلة. في البولينغ، هناك دوماً

195
00:14:32,600 --> 00:14:34,000
رمية ثانية

196
00:14:34,000 --> 00:14:34,980
!صحيح

197
00:14:35,300 --> 00:14:36,470
هذا ليس عدلاً

198
00:14:36,990 --> 00:14:37,810
ماذا؟

199
00:14:38,810 --> 00:14:42,240
علّمتِ سومومو-سان كيفيّة اللّعب يا قائدة

200
00:14:42,240 --> 00:14:43,410
حسناً

201
00:14:46,490 --> 00:14:47,470
ابتعدي عنّي

202
00:14:47,820 --> 00:14:49,320
سنرميها معاً

203
00:14:49,320 --> 00:14:52,200
قلتُ ابتعدي عنّي. تراجعي

204
00:14:52,200 --> 00:14:56,370
هل أنتِ متأكّدة؟ ستخسرين
وستموت سومومو-سان

205
00:14:57,130 --> 00:15:01,270
أنا مُلطّخة. ستحلّ عليكم المصائب

206
00:15:01,960 --> 00:15:03,130
أكيبي

207
00:15:03,130 --> 00:15:04,270
...أكيبي-تشان

208
00:15:04,270 --> 00:15:08,210
لكنّكِ مُخطئة يا أكيبي. أنا المُلطّخة

209
00:15:08,210 --> 00:15:11,660
لا. لا يمكن أن تكوني المُلطّخة يا سومومو

210
00:15:12,140 --> 00:15:16,860
أنتِ مُبتسمة دوماً. تجلبين السّعادة
لكلّ مَن حولكِ

211
00:15:17,620 --> 00:15:18,660
...حسناً، إذاً

212
00:15:20,620 --> 00:15:24,450
.لِمَ لا تُحاولين الابتسام أيضاً؟ فهمت
لستُ ماهرة في ذلك أيضاً

213
00:15:25,270 --> 00:15:26,610
ابتعدي عنّي

214
00:15:26,610 --> 00:15:29,610
أتعلمين ماذا؟ لا أؤمن بالحظوظ

215
00:15:40,220 --> 00:15:41,370
!ضربة بديلة

216
00:15:41,370 --> 00:15:42,820
!رمية مُتقَنة

217
00:15:42,820 --> 00:15:43,700
أختي

218
00:15:46,250 --> 00:15:48,380
المعذرة، لماذا تفعلين هذا؟

219
00:15:48,380 --> 00:15:49,420
لا أدري

220
00:15:49,420 --> 00:15:51,760
!سومومو-تشان، إلى الأمام

221
00:16:01,860 --> 00:16:04,520
لا تقلقي. في البولينغ، هناك
—دوماً رمية ثا

222
00:16:04,520 --> 00:16:06,660
اسمحي لي أن أكون رميتكِ الثّانية يا سومومو

223
00:16:06,660 --> 00:16:07,670
ماذا؟

224
00:16:07,670 --> 00:16:09,010
أختي؟

225
00:16:09,010 --> 00:16:10,260
دعي هذا الأمر لي

226
00:16:12,300 --> 00:16:14,380
علّمني السّائح

227
00:16:20,790 --> 00:16:23,580
أنا آسفة يا سومومو

228
00:16:23,580 --> 00:16:26,190
لا عليكِ. ما زال أمامنا ثمانية أدوار

229
00:16:26,190 --> 00:16:28,350
جيّد. إذاً سأتولّى التّالية

230
00:16:30,940 --> 00:16:32,800
...واحد، اثنان

231
00:16:35,390 --> 00:16:37,030
سأؤدّي رميتك الثّانية

232
00:16:39,110 --> 00:16:41,300
يبدو أنّكِ  تتعافين يا سوغوري

233
00:16:41,300 --> 00:16:43,690
لـ-ليس إلى هذه الدّرجة

234
00:16:47,490 --> 00:16:49,070
هيّا. تفضّلي

235
00:16:50,940 --> 00:16:53,950
!ثمّ أنا أيضاً! أريد أن ألعب أيضاً

236
00:16:54,330 --> 00:16:58,470
أجل. لِمَ لا؟ لنلعب جميعاً معاً

237
00:17:16,970 --> 00:17:18,330
!ربحت

238
00:17:18,990 --> 00:17:20,410
!مرحى

239
00:17:20,410 --> 00:17:23,530
ماذا؟ لحظة. هل يُفترَض أن يكون
هذا شيئاً جيّداً؟

240
00:17:23,530 --> 00:17:26,100
لا ألومك على تحفّظك

241
00:17:26,100 --> 00:17:28,000
لنلعب مرّة أُخرى

242
00:17:28,000 --> 00:17:29,260
مرّة أُخرى؟

243
00:17:29,260 --> 00:17:31,220
تعلّمتُ مسار الكُرة

244
00:17:31,220 --> 00:17:33,930
سنربح التّالية بالتّأكيد يا أكيبي

245
00:17:37,140 --> 00:17:39,620
!أسقطتُ مجموعة! انظرن، انظرن

246
00:17:39,960 --> 00:17:41,250
إنّها فوضى

247
00:17:41,570 --> 00:17:43,120
أتّفق

248
00:17:44,270 --> 00:17:45,620
أكيبي-تشان

249
00:17:45,990 --> 00:17:48,370
ألا تعتقدين بأنّ البولينغ مُمتعة؟

250
00:17:49,980 --> 00:17:55,380
،لا أعرف السّبب، لكن عندما يكون المرء حيّاً
هناك دوماً شيء مُمتع لفعله

251
00:17:55,380 --> 00:17:56,950
ماي-تشان

252
00:17:56,950 --> 00:17:59,640
أعلم... أعلم بأنّ الأمور يمكن
...أن تغدو سيّئة حقّاً

253
00:17:59,990 --> 00:18:03,070
...لدرجة أنّ المرء قد يُفكّر في الموت وما شابه

254
00:18:03,070 --> 00:18:07,890
ثمّ يبدأ بالتّفكير بأنّه لن يستمتع
ثانية أبداً، أليس كذلك؟

255
00:18:08,710 --> 00:18:10,150
لكن أليس هذا غريباً؟

256
00:18:10,970 --> 00:18:16,410
إذا نجونا من ذلك... إذا نجونا، فسيحدث
أمر جيّد دوماً

257
00:18:16,410 --> 00:18:19,300
"!يجعلك تقولين "ما أمتع الحياة

258
00:18:20,940 --> 00:18:22,100
...لذا في الواقع

259
00:18:23,660 --> 00:18:26,410
لا أريدكِ أن تموتي حقّاً، مفهوم؟

260
00:18:28,160 --> 00:18:30,480
أجل، لا أريدكِ أن تموتي

261
00:18:30,480 --> 00:18:34,800
أريدكِ فقط أن تحظي بكثير من الأوقات
المُمتعة الّتي تنتظركِ

262
00:18:34,800 --> 00:18:36,050
ماي

263
00:18:36,050 --> 00:18:37,910
هكذا هي طبيعة المُستقبل

264
00:18:38,580 --> 00:18:40,930
إنّه مكان حيث تنتظركِ المتعة

265
00:18:40,930 --> 00:18:42,980
...لكن، يجب عليّ أن

266
00:18:45,090 --> 00:18:46,130
أكيبي

267
00:18:46,900 --> 00:18:51,440
لستِ مُلطّخة إطلاقاً. لا شيء
من هذا مُهمّ أصلاً

268
00:18:51,440 --> 00:18:54,190
جميعنا نريدكِ أن تعيشي

269
00:18:55,890 --> 00:18:59,640
أعدكِ بأنّني سأجد طريقة لمنحكِ حرّيتكِ

270
00:18:59,640 --> 00:19:01,850
من فضلكِ لا تهدري وقتكِ عليّ

271
00:19:02,180 --> 00:19:02,950
ماذا؟

272
00:19:02,950 --> 00:19:05,210
،أريدكِ أن تعيشي كما تختارين

273
00:19:05,990 --> 00:19:09,250
وتفعلين الأشياء الّتي تريدين فعلها حقّاً

274
00:19:09,810 --> 00:19:12,940
أنا مُعجبة بطريقة عيشكِ بحرّية يا ناتسومي

275
00:19:12,940 --> 00:19:14,810
حسناً، ما زلتُ حرّة

276
00:19:16,470 --> 00:19:20,430
...اخترتُ بحرّية أكثر ما أريده في الحياة، وهو

277
00:19:20,430 --> 00:19:24,270
إيجاد طريقة لتحريركِ كذلك

278
00:19:25,710 --> 00:19:31,580
إذا كان هذا يعني حمايتكِ، فسأكون
فخورة بالاستمرار في العيش كرجل

279
00:19:31,910 --> 00:19:33,930
يراودني نفس الشّعور يا أكيبي

280
00:19:33,930 --> 00:19:37,540
.سأذهب إلى أيّ مكان يترتّب عليّ
،لا أُبالي إذا انتهى المطاف بي وحيدة

281
00:19:37,540 --> 00:19:39,580
ما دمتُ أستطيع حمايتكِ

282
00:19:40,750 --> 00:19:46,750
أعلم بأنّني ما زلتُ صغيرة ولا أستطيع فعل
الكثير، لكن سأحاول وأنضج بسرعة

283
00:19:48,370 --> 00:19:49,580
لا بُدّ أنّكِ تشعرين بذلك

284
00:19:51,120 --> 00:19:55,630
"صحيح؟ بوزن وعبء "نحن نفعلها لأجلك

285
00:19:56,430 --> 00:20:00,470
لكن هذا ليس مُجرّد كلام. إنّهن
مُستعدّات للمُعاناة لأجلكِ

286
00:20:01,700 --> 00:20:06,140
أعلم كم من الصّعب التّصديق بأنّكِ
تُساوين هذه القيمة بالنّسبة لشخص

287
00:20:07,310 --> 00:20:08,820
كان يراودني نفس الشّعور

288
00:20:09,890 --> 00:20:15,650
لكن أتعلمين؟ هذا حقيقيّ. حتّى
...شخصاً مثلي أو مثلكِ

289
00:20:15,970 --> 00:20:20,310
هناك أشخاص مُستعدّون لوضع أنفسهم
على المحكّ من أجلنا

290
00:20:21,650 --> 00:20:25,150
لذا أريدكِ أن تتوقّفي عن المُقاومة

291
00:20:26,230 --> 00:20:32,940
"كفّي عن المُقاومة وحاولي قول "شكراً لكُن
لهؤلاء اللّواتي يهتممن كثيراً بشأنكِ

292
00:20:35,470 --> 00:20:41,300
حينها ربّما يمكنكِ تعلُّم الاهتمام
بشأنهن بنفس الطّريقة

293
00:20:43,430 --> 00:20:45,060
أحاول أن أتعلّم ذلك أيضاً

294
00:20:46,530 --> 00:20:47,710
أبذل قصارى جهدي

295
00:20:57,740 --> 00:20:59,190
أكيبي

296
00:20:59,940 --> 00:21:01,210
!أكيبي

297
00:20:59,940 --> 00:21:01,210
!أختي

298
00:21:06,700 --> 00:21:07,750
أكيبي

299
00:21:34,850 --> 00:21:35,750
ماذا؟

300
00:21:37,350 --> 00:21:38,710
بجدّية؟

301
00:21:40,060 --> 00:21:41,480
ها هي ذي

302
00:21:41,480 --> 00:21:42,390
ماذا؟

303
00:21:42,390 --> 00:21:43,740
ماذا تقصدين؟

304
00:21:44,710 --> 00:21:46,550
عاد المُستقبل لأجلكن