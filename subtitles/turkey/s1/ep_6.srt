1
00:01:33,420 --> 00:01:36,670
!لم تظهر سومومو-تشان أبداً

2
00:01:36,670 --> 00:01:38,180
هل دعيتِها؟

3
00:01:38,180 --> 00:01:42,300
"قالت، "سأذهب إذا استطعت

4
00:01:42,300 --> 00:01:45,250
أجل، هذا يعني دوماً بأنّها لن تفعل

5
00:01:45,560 --> 00:01:49,880
رجاء لا تستخدمي تجربتكِ المُؤسفة
مع كوساكا-كن كمعيار لكلّ شيء

6
00:01:49,880 --> 00:01:51,630
!ماذا؟ أنا لا أفعل ذلك

7
00:01:51,880 --> 00:01:53,630
!تخلّصي من هذا التّعبير في وجهكِ

8
00:01:59,590 --> 00:02:00,750
...يبدو هذا

9
00:02:02,020 --> 00:02:04,140
!سأذهب وأبلغ سوغوري-ساما

10
00:02:15,390 --> 00:02:19,300
أعتذر على عدم اللّباقة، لكن
تفضّلوا بالدّخول

11
00:02:19,300 --> 00:02:21,250
لا، يكفي إلى هنا

12
00:02:22,810 --> 00:02:24,890
،قبل خمسة أيّام في ساعة الكلب

13
00:02:25,350 --> 00:02:31,250
تواردت تقارير عن ضوء مشؤوم
ينبعث من الغابة في منطقتكم

14
00:02:32,730 --> 00:02:34,920
هل لديك أي علم بهذا؟

15
00:02:35,860 --> 00:02:36,670
لا، ليس لديّ

16
00:02:36,670 --> 00:02:37,800
هل أنت متأكّد؟

17
00:02:42,930 --> 00:02:43,750
أجل

18
00:02:47,030 --> 00:02:49,890
فهمت. أعتذر على الإزعاج

19
00:02:53,470 --> 00:02:57,070
ألم تجرِ تحضيرات الأميرة سومومو بعد؟

20
00:02:57,710 --> 00:02:59,410
أعتذر من أعماق قلبي

21
00:03:01,730 --> 00:03:03,750
!خليلها؟

22
00:03:04,810 --> 00:03:05,880
المعذرة، ماذا يعني؟

23
00:03:05,880 --> 00:03:07,580
!أقصد خطيبها

24
00:03:07,580 --> 00:03:09,780
ماذا؟ خطيب سومومو-تشان؟

25
00:03:10,130 --> 00:03:11,870
الرّجل الّذي كان هنا للتو؟

26
00:03:11,870 --> 00:03:13,830
لا، كان رسولاً

27
00:03:14,210 --> 00:03:17,090
ماذا؟ لكن تصرّف وكأنّه شخصيّة بارزة

28
00:03:18,330 --> 00:03:23,300
بلدنا خاضعة لوصاية عشيرة واشيو

29
00:03:23,300 --> 00:03:25,150
وصاية؟

30
00:03:25,150 --> 00:03:27,430
يعني أنّهم محميّون بواسطتهم

31
00:03:28,130 --> 00:03:34,190
كانت صحّة أبي مُتدهورة للغاية، لذا
قدّم طلباً رسميّاً من حاكم واشيو

32
00:03:34,900 --> 00:03:37,690
لحماية بلادنا

33
00:03:38,170 --> 00:03:39,580
...مقابل ذلك

34
00:03:42,550 --> 00:03:47,380
،عندما تبلغ سومومو سنّ البلوغ
سوف تُطلَب يدها للزّواج

35
00:03:47,850 --> 00:03:48,450
ماذا؟

36
00:03:48,950 --> 00:03:52,670
هل تحبّ سومومو-تشان ذلك
الشّخص أيّاً يكن؟

37
00:03:53,430 --> 00:03:55,850
الحُبّ والكره غير مُهمّين

38
00:03:55,850 --> 00:03:57,840
فيما يخصّ شخصاً لم تلتقي به من قبل

39
00:03:57,840 --> 00:03:58,840
ماذا؟

40
00:03:58,840 --> 00:04:00,710
هل هو زواج سياسيّ؟

41
00:04:02,030 --> 00:04:04,780
حسناً، تبقى هذه فترة سينغوكو

42
00:04:05,690 --> 00:04:09,970
ذكرَ الرّجل شيئاً عن "تحضيراتها". ماذا يعني؟

43
00:04:12,210 --> 00:04:16,790
ما زالت سومومو لم تجرّب حِزام سرجها الأوّل

44
00:04:17,610 --> 00:04:20,330
حِزام سرج؟ ماذا يعني؟

45
00:04:22,220 --> 00:04:24,460
...أتسألين عن معنى ذلك؟! إنّه

46
00:04:26,370 --> 00:04:29,370
!يـ-يعني بوضوح تجربتها الأولى لحزام السّرج

47
00:04:29,770 --> 00:04:32,230
!كفى سخرية منّي وكأنّني طفلة

48
00:04:34,850 --> 00:04:36,270
مِحنة؟

49
00:04:36,270 --> 00:04:37,870
من يدري؟

50
00:04:37,870 --> 00:04:38,880
يا قائدة؟

51
00:04:38,880 --> 00:04:40,380
ماي-تشان؟

52
00:04:40,380 --> 00:04:42,850
لكن لا تستطيع فعل ذلك

53
00:04:42,850 --> 00:04:43,590
ماذا؟

54
00:04:44,130 --> 00:04:48,100
لا يمكن الزّواج من شخص لم تلتقي به أبداً

55
00:04:48,100 --> 00:04:50,810
—حسناً، في هذا العصر الّذي كان هادئـ

56
00:04:51,390 --> 00:04:52,890
!سومومو-تشان

57
00:04:53,230 --> 00:04:54,640
ماي؟

58
00:04:55,020 --> 00:04:57,620
هل أنتِ موافقة على هذا حقّاً
يا سومومو-تشان؟

59
00:04:58,050 --> 00:04:59,150
ماذا؟

60
00:04:59,150 --> 00:05:02,900
كيف لكِ أن تتزوّجي من شخص
لم تلتقِ به من قبل؟

61
00:05:03,310 --> 00:05:04,900
أتزوّج؟

62
00:05:04,900 --> 00:05:07,050
...فـ-في الواقع

63
00:05:08,110 --> 00:05:10,130
أن تكوني عروسة شخص

64
00:05:10,660 --> 00:05:12,710
هل تقصدين كاغيتوكي-ساما؟

65
00:05:15,540 --> 00:05:16,920
هل هذا مقبول؟

66
00:05:18,170 --> 00:05:19,920
أن يكون شخصاً لا تُحبّينه؟

67
00:05:21,780 --> 00:05:24,050
!اعذريها رجاء

68
00:05:26,430 --> 00:05:28,180
!لا يجوز أن تقولي كلاماً كهذا

69
00:05:28,180 --> 00:05:33,060
إذا قالت سومومو-سان لنفسها، "سئمتُ
"من كلّ هُراء الزّواج هذا

70
00:05:33,060 --> 00:05:35,560
!سوف تتغيّر الأمور! سيتغيّر التّاريخ

71
00:05:35,560 --> 00:05:37,260
...لكن

72
00:05:37,260 --> 00:05:38,270
ماي؟

73
00:05:41,540 --> 00:05:45,340
أنا راضية عن هذا، رغم أنّه ليس
شخصاً أُحبّه

74
00:05:45,940 --> 00:05:46,950
ماذا؟

75
00:05:48,030 --> 00:05:50,740
في الواقع، يُسعدني جدّاً معرفة

76
00:05:51,730 --> 00:05:57,820
أنّه حتّى أنا سأحظى بدور
في حماية بلدنا

77
00:06:04,010 --> 00:06:06,970
سومومو-تشان رهيبة حقّاً

78
00:06:07,450 --> 00:06:11,330
لا أحبّذ أولويّات النّاس في هذا العصر

79
00:06:21,020 --> 00:06:23,170
أخطأتُ من جديد

80
00:06:26,530 --> 00:06:31,910
لم أفكّر بمشاعرها حتّى. تحمّستُ
زيادة عن اللّزوم

81
00:06:35,710 --> 00:06:38,870
لكن يروقني ذلك

82
00:06:39,650 --> 00:06:42,380
يروقني ذلك فيكِ يا ماي-تشان

83
00:06:43,050 --> 00:06:44,630
!بربّكِ

84
00:06:51,640 --> 00:06:53,830
ما-ماذا يجدر بي أن أفعل؟

85
00:06:53,830 --> 00:06:55,160
!بدأ ذلك

86
00:06:55,160 --> 00:06:57,700
!لكن لم أحضر شيئاً معي

87
00:06:58,890 --> 00:07:00,010
هل يمكنني سؤال شخص؟

88
00:07:02,170 --> 00:07:06,180
المناديل غير مجودة بعد في هذه الفترة

89
00:07:06,180 --> 00:07:07,650
!إنّها ممنوعة

90
00:07:10,310 --> 00:07:11,810
ماذا يجدر بي أن أفعل إذاً؟

91
00:07:12,460 --> 00:07:14,160
هل من مُشكلة؟

92
00:07:15,100 --> 00:07:16,300
هل أنتِ بخير؟

93
00:07:17,210 --> 00:07:18,460
أتشعرين بوعكة؟

94
00:07:18,910 --> 00:07:22,980
أ-أنا بخير! لـ-لا توجد مُشكلة

95
00:07:26,700 --> 00:07:28,650
،سامحيني على صراحتي

96
00:07:30,530 --> 00:07:34,460
لكن هل تريدين حزام سرج؟

97
00:07:35,950 --> 00:07:37,290
حزام سرج؟

98
00:07:38,750 --> 00:07:44,290
!حـ-حقّاً، شكراً جزيلاً لك

99
00:07:44,740 --> 00:07:45,590
العفو

100
00:07:46,260 --> 00:07:47,290
كيف شعوركِ الآن؟

101
00:07:48,420 --> 00:07:52,580
،إنّه أثخن قليلاً من الطّبيعيّ
لكن سأعتاد عليه

102
00:07:52,580 --> 00:07:53,300
ماذا؟

103
00:07:53,650 --> 00:07:57,310
لا، لا مُشكلة إطلاقاً! إنّه خفيف جدّاً

104
00:07:59,190 --> 00:08:00,450
يسرّني سماع ذلك

105
00:08:04,090 --> 00:08:09,430
المعذرة، كيف... رغم أنّك فتى؟

106
00:08:11,850 --> 00:08:13,530
يسرّني سماع هذا أيضاً

107
00:08:13,530 --> 00:08:14,230
ماذا؟

108
00:08:14,700 --> 00:08:18,490
يبدو أنّني نجحتُ في خداعكِ، أليس كذلك؟

109
00:08:19,270 --> 00:08:20,230
ماذا؟

110
00:08:23,670 --> 00:08:26,020
أنا أُنثى

111
00:08:26,020 --> 00:08:27,480
أُنثى؟

112
00:08:30,900 --> 00:08:32,470
!ماذا؟

113
00:08:33,850 --> 00:08:37,910
كلّما ساورت الشّكوك قلبي، آتي إلى هنا

114
00:08:48,260 --> 00:08:52,580
قبل عشر سنوات، عندما أمرني
،أبي بأن أصبح رجلاً

115
00:08:52,580 --> 00:08:54,620
أتيتُ إلى هنا لتبديد شكوكي

116
00:08:56,030 --> 00:08:59,070
هل كان هذا لأنّه لم يُنجب سوى إناثاً؟

117
00:09:00,020 --> 00:09:04,550
أجل. بالطّبع كان جسدي لا يزال
جسد امرأة آنذاك

118
00:09:04,550 --> 00:09:07,620
وغالبيّة رجالي كانوا مُدركين لذلك

119
00:09:08,630 --> 00:09:14,140
بغضّ النّظر، أتيتُ إلى هنا في ذلك اليوم
وأقسمتُ أمام هذا النّبع بأن أكون رجلاً

120
00:09:17,710 --> 00:09:22,090
لكن أليس هذا... صعباً بالنّسبة لك؟

121
00:09:23,140 --> 00:09:27,070
إن ترتّب عليك تبديد شكوكك، فهذا
يعني أنّه ساورتك شكوك

122
00:09:27,750 --> 00:09:32,230
لا بُدّ أنّك أردت الاستمرار في العيش
كامرأة، أليس كذلك؟

123
00:09:35,300 --> 00:09:38,680
أهذا مُناسب لك حقّاً يا سوغوري-ساما؟

124
00:09:39,600 --> 00:09:43,410
...أ-أنا آسفة! ما كان ينبغي أن

125
00:09:46,090 --> 00:09:49,340
أنتِ وصديقاتكِ غير عاديّات حقّاً

126
00:09:49,340 --> 00:09:50,180
ماذا؟

127
00:09:50,580 --> 00:09:53,450
أتذكّر كلمات ماي-سان في الأمس

128
00:09:54,620 --> 00:09:57,450
"سألتْ، "هل أنتِ مُوافقة على هذا حقّاً؟

129
00:09:58,620 --> 00:10:04,540
أعتقد هذا يعني، "كيف تعتبرين هذا الوضع
شخصيّاً؟" أليس كذلك؟

130
00:10:07,390 --> 00:10:08,460
أجل

131
00:10:10,430 --> 00:10:12,710
هذا شيء لم أفكّر فيه حتّى

132
00:10:13,710 --> 00:10:16,740
ما أفضل طريقة لي لخدمة الآخرين؟

133
00:10:17,380 --> 00:10:19,060
هذا كلّ ما يهمّني

134
00:10:20,810 --> 00:10:22,790
هل أنتِ مختلفة؟

135
00:10:26,340 --> 00:10:28,690
أجل، ربّما أكون كذلك

136
00:10:30,580 --> 00:10:35,950
.أظنّني أحسدك قليلاً يا سوغوري-سان
على تفانيك

137
00:10:37,740 --> 00:10:40,700
ومع ذلك، أنا أحسدك

138
00:10:41,190 --> 00:10:41,990
ماذا؟

139
00:10:42,270 --> 00:10:45,540
،إذا كنتُ قد بورِكتُ بقوامكِ وقوّتك

140
00:10:45,870 --> 00:10:50,620
فأستطيع حماية بلدي وشعبي بيدَي هاتين

141
00:10:51,890 --> 00:10:53,130
...يا إلهي

142
00:10:53,130 --> 00:10:56,980
هل خضعتِ لتدريب خاص ما؟

143
00:10:56,980 --> 00:11:00,990
لـ-لا! وُلِدتُ ضخمة فحسب

144
00:11:02,150 --> 00:11:04,540
لكن هذا إسراف عليّ

145
00:11:04,540 --> 00:11:05,380
إسراف؟

146
00:11:07,710 --> 00:11:10,310
أنا جبانة. جبانة حقّاً

147
00:11:11,010 --> 00:11:13,250
وأكره نفسي بسبب ذلك

148
00:11:13,900 --> 00:11:16,400
ومع ذلك أنقذتِني في ذلك اليوم

149
00:11:16,400 --> 00:11:19,780
هذا فقط لأنّ ماي-تشان كانت هنا

150
00:11:20,790 --> 00:11:25,620
يمكنني الوثوق بأنّ ماي-تشان
ستكون بجانبي

151
00:11:26,660 --> 00:11:29,100
بالفعل، أنتِ قويّة حقّاً

152
00:11:29,100 --> 00:11:29,910
ماذا؟

153
00:11:30,660 --> 00:11:37,090
الجبناء الحقيقيّون يفتقرون لثقة ترك
حياتهم بين يدي الآخرين

154
00:11:37,970 --> 00:11:39,100
...أنا لا

155
00:11:40,890 --> 00:11:42,660
هذا غامض حقّاً

156
00:11:43,530 --> 00:11:46,630
لماذا اختارني أبي؟

157
00:11:48,470 --> 00:11:53,300
من بيننا نحن الأخوات الخمسة، كنتُ
حتماً الأكثر جبناً

158
00:11:57,140 --> 00:12:02,860
لكن لعلّ أبي قد آمن بأنّني سأتمكّن
من التغلُّب على ذلك يوماً ما

159
00:12:12,960 --> 00:12:15,330
أجل، سأكون راضياً عن هذا

160
00:12:15,330 --> 00:12:17,530
أظنّني سأستخدم هذا

161
00:12:17,530 --> 00:12:18,430
!في الدّاخل

162
00:12:18,770 --> 00:12:19,420
ماذا؟

163
00:12:20,570 --> 00:12:21,700
!سايوري

164
00:12:22,460 --> 00:12:24,670
!يسرّني ذلك

165
00:12:25,100 --> 00:12:26,660
!كنتُ قلقة للغاية

166
00:12:26,660 --> 00:12:27,470
ماذا؟

167
00:12:28,750 --> 00:12:31,270
قطّاع طُرُق رحّالين كما في السّابق؟

168
00:12:32,420 --> 00:12:37,740
،لا أعلم ما إن كانوا نفس الرّجال السّابقين
لكن عندما ذهب بعض القرويّين

169
00:12:37,740 --> 00:12:40,900
لجمع الخضراوات، رصدوا قُطّاع
طُرُق ينزلون من الجبل

170
00:12:41,740 --> 00:12:44,050
مهلاً! ألا يجدر بنا أن نتكلّم الآن

171
00:12:44,050 --> 00:12:47,890
عن سايوري وسوغوري-ساما
وعمّا كانا يفعلانه معاً؟

172
00:12:47,890 --> 00:12:49,490
لا بالطّبع

173
00:12:55,000 --> 00:12:55,950
!سايوري

174
00:13:02,500 --> 00:13:03,740
!لقنّاهم درساً

175
00:13:07,970 --> 00:13:09,310
كيف سار الأمر؟

176
00:13:09,310 --> 00:13:13,250
!ممتاز! قتلنا كلّ واحد منهم

177
00:13:16,670 --> 00:13:18,450
!رائع

178
00:13:18,450 --> 00:13:20,430
أفلت واحداً منهم

179
00:13:20,930 --> 00:13:25,290
أجل، لكن جرحنا وجهه بشكل بليغ. لا بُدّ
أنّه ميّت في مكان ما في الجبل

180
00:13:26,030 --> 00:13:26,950
لنعُد

181
00:13:28,260 --> 00:13:29,280
!هيّا

182
00:13:29,860 --> 00:13:31,910
لحظة. أين سوغوري-ساما؟

183
00:13:32,570 --> 00:13:34,310
قال بأنّ لديه مكان يذهب إليه

184
00:13:48,790 --> 00:13:51,870
هذه أنتِ

185
00:13:54,610 --> 00:13:58,210
هـ-هل قتلتهم... حقّاً؟

186
00:13:58,700 --> 00:13:59,550
ماذا؟

187
00:13:59,550 --> 00:14:02,980
!لكن لم يشنّوا هجوماً بعد

188
00:14:04,020 --> 00:14:07,070
إذا انتظرنا حتّى يُهاجموا، فسيفوت الأوان

189
00:14:07,790 --> 00:14:08,440
...لكن

190
00:14:08,440 --> 00:14:12,370
كوموغي وعائلة أزوكي قد قُتِلوا
بواسطة قُطّاع طُرُق

191
00:14:14,130 --> 00:14:20,230
أمام أنظارهم. منذ ذلك الحين، لم تعُد
أزوكي قادرة على الكلام

192
00:14:23,610 --> 00:14:26,830
استهترتُ وسمحتُ لأحدهم بالإفلات

193
00:14:27,410 --> 00:14:31,380
غداً، سأعود إلى الجبل بحثاً عنه

194
00:14:31,870 --> 00:14:32,850
بحث؟

195
00:14:34,130 --> 00:14:35,340
ثمّ ماذا؟

196
00:14:37,010 --> 00:14:40,460
إذا كان لا يزال حيّاً، فسوف أجهز عليه

197
00:14:41,950 --> 00:14:47,260
تكلّمتُ معك عن مدى جبني

198
00:14:48,780 --> 00:14:53,510
أنا خائفة. خائفة جدّاً ولا أعرف ماذا أفعل

199
00:14:54,470 --> 00:14:58,850
أخشى موتي. أخشى خسارة أحبّائي

200
00:15:00,010 --> 00:15:00,670
...لكن

201
00:15:03,750 --> 00:15:04,930
الأمر سيّان

202
00:15:05,770 --> 00:15:07,730
تبقى الحياة حياة، أليس كذلك؟

203
00:15:09,170 --> 00:15:11,390
حتّى لو كانت تنتمي لقُطّاع طُرق

204
00:15:12,210 --> 00:15:13,760
ليست مُتشابهة

205
00:15:14,390 --> 00:15:17,640
...لكن... لكن حينها

206
00:15:17,640 --> 00:15:22,580
من أجل إنقاذ روح واحدة، عليك
زهق روح أُخرى؟

207
00:15:23,820 --> 00:15:27,130
لا يبدو هذا صحيحاً بالنّسبة لي

208
00:15:27,870 --> 00:15:32,900
أليس هذا ما يعنيه حماية شخص؟

209
00:15:33,660 --> 00:15:34,780
ماذا؟

210
00:15:35,740 --> 00:15:39,630
ألا تعني الحماية أنّه يجب عليك اختيار

211
00:15:40,930 --> 00:15:44,180
الحياة الّتي ستنقذينها والحياة
الّتي ستتخلّصين منها؟

212
00:15:45,210 --> 00:15:46,670
...لكن لا أستطيع

213
00:15:47,500 --> 00:15:50,170
إذا فكّرتُ لوهلة بأنّ شخصاً
،كان على وشك قتلك

214
00:15:51,390 --> 00:15:55,210
فلن أتردّد عن قتل ذلك الشّخص بدلاً من ذلك

215
00:15:58,820 --> 00:16:01,810
كنتُ لأحميكِ

216
00:16:03,550 --> 00:16:04,810
لا تفعلي من فضلكِ

217
00:16:06,530 --> 00:16:12,860
إذا فعلتِ هذا لأجلي، فلن... أتمكّن من العودة

218
00:16:14,910 --> 00:16:17,260
،حتّى لو استطعتُ العودة إلى زمني

219
00:16:17,990 --> 00:16:20,910
!مـ-محال أن أعود إلى ذاتي القديمة

220
00:16:22,080 --> 00:16:24,540
زمنك؟

221
00:16:27,370 --> 00:16:31,710
أنا... في الواقع، أتينا من المُستقبل

222
00:16:32,810 --> 00:16:33,700
المُستقبل؟

223
00:16:35,150 --> 00:16:41,220
من أيّام بعيدة جدّاً. من غد بعيد جدّاً

224
00:16:43,100 --> 00:16:49,510
في ذلك الزّمن، لا يمكنك ببساطة أن
تقتل النّاس. لا يمكنك أن تُقتَل ببساطة

225
00:16:50,250 --> 00:16:52,890
!الحياة تستحقّ أكثر من ذلك بكثير

226
00:16:59,420 --> 00:17:03,670
عندما رأيتُ ذلك، صرختُ كما لو
أنّني كنتُ أشاهد فيلم رُعب

227
00:17:03,670 --> 00:17:07,750
!لكن كان ذلك شخصاً. كانت حياة ثمينة لشخص

228
00:17:09,380 --> 00:17:15,710
في ذلك الزّمان، لا يمكنك قتل آخرين
ببساطة. لا يمكن أن تُقتَل بهذه البساطة

229
00:17:16,390 --> 00:17:19,260
!الحياة تستحقّ أكثر من ذلك بكثير

230
00:17:21,130 --> 00:17:22,270
لكن هل الأمر كذلك حقّاً؟

231
00:17:43,950 --> 00:17:46,170
ما هذا الّذي أراه؟

232
00:17:46,170 --> 00:17:48,890
شعرتُ بأنّك ضعيف، لكنّك امرأة في الواقع

233
00:17:49,290 --> 00:17:50,540
!اصمت

234
00:17:58,540 --> 00:18:01,870
ماذا يجدر بي أن أفعل؟ ماذا يجدر
بي أن أفعل يا ماي-تشان؟

235
00:18:12,020 --> 00:18:13,470
ماذا كان ذلك بالضّبط؟

236
00:18:18,320 --> 00:18:19,380
أنا خائفة

237
00:18:20,340 --> 00:18:21,530
!أنا خائفة

238
00:18:21,530 --> 00:18:22,950
!النّجدة يا ماي-تشان

239
00:18:24,350 --> 00:18:26,590
!لا داعي للقلق يا سايوري

240
00:18:28,890 --> 00:18:31,670
!في البولينغ، هناك دوماً رمية ثانية

241
00:18:47,380 --> 00:18:51,980
.لا، ماي-تشان ليست هنا الآن
لا يوجد سوايّ

242
00:18:53,010 --> 00:18:57,240
الوحيدة الّتي تستطيع رمي كُرة
!ثانية هي أنا

243
00:18:57,240 --> 00:18:59,240
!فلتقي حتفكِ الآن

244
00:19:00,090 --> 00:19:01,490
...لنذهب إلى المنزل معاً

245
00:19:14,150 --> 00:19:16,170
معاً، اتّفقنا؟

246
00:19:32,440 --> 00:19:35,410
هـ-هل مات؟

247
00:19:38,260 --> 00:19:40,380
لا، لا يزال يتنفّس

248
00:19:47,900 --> 00:19:50,350
من فضلك عودي إلى القصر قبلي

249
00:19:56,050 --> 00:19:59,090
هـ-هل... هل ستقتلينه؟

250
00:20:02,590 --> 00:20:06,430
سـ-سوف تُجهزين عليه، أليس كذلك؟

251
00:20:19,650 --> 00:20:20,660
سوف أبقى

252
00:20:21,210 --> 00:20:26,350
لا... أستطيع المُشاهدة، لكن سأبقى

253
00:20:27,450 --> 00:20:28,450
...لذا أرجوك

254
00:20:34,780 --> 00:20:35,860
شكراً لك

255
00:21:00,850 --> 00:21:01,990
انتهينا

256
00:21:10,410 --> 00:21:11,160
سامحيني

257
00:21:12,780 --> 00:21:15,990
أدركتُ شيئاً للتو

258
00:21:16,470 --> 00:21:17,420
ماذا؟

259
00:21:17,420 --> 00:21:19,590
بأنّ إذا كان ذلك كفيلاً
،بحمايتك يا سوغوري-سان

260
00:21:20,740 --> 00:21:22,540
فأنا مُستعدّة للقتل

261
00:21:28,990 --> 00:21:30,990
...وأدركتُ

262
00:21:31,980 --> 00:21:33,170
...بأنّ هذا يعني بأنّني

263
00:21:38,010 --> 00:21:42,950
لا، لا مُشكلة. تبقين الشّخص
الّذي كنتِ عليه دوماً

264
00:21:43,820 --> 00:21:48,020
لطيفة لكن قويّة. أنتِ ما زالت أنتِ

265
00:21:48,910 --> 00:21:49,830
حسناً

266
00:21:50,980 --> 00:21:56,630
عصر الحروب هذا سيؤدّي يوماً ما
إلى أيّام الغد البعيدة تلك

267
00:21:57,170 --> 00:21:59,230
،إنّها مرتبطة بزمن أكثر هدوءاً

268
00:21:59,830 --> 00:22:06,220
مُتّصلة بالمُستقبل الّذي ستعودين
إليه يوماً ما. هذا واضح الآن

269
00:22:12,100 --> 00:22:13,050
ولهذا السّبب

270
00:22:14,450 --> 00:22:15,490
كلّ شيء على ما يُرام