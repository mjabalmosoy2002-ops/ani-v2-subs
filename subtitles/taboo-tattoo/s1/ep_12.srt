1
00:00:06,580 --> 00:00:10,110
القوى المُحْتَويةُ في الوشم الذي لا منشطَ له

2
00:00:10,110 --> 00:00:13,340
.تتوافق مع الوظائف الأساسيةِ لضوابط الأنقاض

3
00:00:21,670 --> 00:00:25,340
،أي أن صانع الفراغِ يُشَغَّلُ

4
00:00:25,340 --> 00:00:27,580
،وقوةُ الشفاء تتجدد

5
00:00:27,580 --> 00:00:30,190
.وقوةُ ختمِ الوشم تُغلق

6
00:00:36,110 --> 00:00:39,620
أيعقلُ أنني أفرطُ في استخدامِ
قوتي في وقتٍ كهذا؟

7
00:00:43,240 --> 00:00:47,020
وما هو يلزمُ لاستخدامِ قوةِ ختم الوشم

8
00:00:47,020 --> 00:00:50,680
،هو توافقٌ عالٍ مع المختومِ ومع الإيثار

9
00:00:50,680 --> 00:00:52,440
.ومع روحِ التضحيةِ بالنفس

10
00:00:52,740 --> 00:00:56,210
والانتقامُ نقيضُ هذا تمامًا
بما أنهُ شيءٌ لإرضاء النفس

11
00:00:57,590 --> 00:00:59,980
أتخبرينني أنكِ مؤهلةٌ لاستخدامه؟

12
00:01:00,410 --> 00:01:02,350
شخصٌ أنانيٌ مثلكِ؟

13
00:01:03,720 --> 00:01:06,540
لا يوجدُ أحد يحبُّ هذا العالم الثمين

14
00:01:06,540 --> 00:01:08,480
!وجميعِ الحيواتِ التي فيهِ بقدر ما أُحبهُ أنا

15
00:01:08,950 --> 00:01:12,110
.ولا بدَّ أن يهلكَ الجنس البشري من أجل هذا الحب

16
00:01:12,110 --> 00:01:14,650
.من أجل هذا الحبِّ يجب أن يُنفى الجنس البشري

17
00:01:15,280 --> 00:01:18,070
القصةُ الخيالةُ التي تحكي عن
الآلهةِ التي خلقت البشر

18
00:01:18,070 --> 00:01:19,820
.كانت أسطوريةً فحسب

19
00:01:20,270 --> 00:01:23,350
كانوا مجردَ انعكاسِ شرٍّ حبس ضوء

20
00:01:23,350 --> 00:01:26,790
الذكاء البشري في قفصٍ مظلم
.وغذَّاهم بنيرانِ الحرب

21
00:01:27,130 --> 00:01:29,080
،خلقُ إلهي

22
00:01:29,450 --> 00:01:32,940
.هو خلق الإمكانية التي سأقدمها للعالم وحياته

23
00:01:32,940 --> 00:01:36,520
لهذا السببِ سأقدم حياتي بكلِّ سرور

24
00:01:36,520 --> 00:01:39,180
.كتضحيةٍ من أجل ولادةِ هذا الإله

25
00:01:40,460 --> 00:01:42,190
أيمكنُ حدوثُ هذا حتى؟

26
00:01:51,210 --> 00:01:54,250
(وايزمان) يدعمك، أليس كذلك؟

27
00:01:54,550 --> 00:01:56,940
لا بدَّ أنهُ كان على معرفة

28
00:01:56,940 --> 00:01:59,230
.لسببِ عدمِ قدرتكَ على استخدامِ قوةِ الختم

29
00:01:59,880 --> 00:02:01,530
...الجرحُ لا يلتئم

30
00:02:01,530 --> 00:02:03,690
أي أنهُ لم يملك

31
00:02:03,690 --> 00:02:06,120
.أيَّ نيةٍ بجعلكَ تهزمني

32
00:02:06,730 --> 00:02:09,000
...ربما كان ينوي جعلي أتغذى عليك

33
00:02:09,300 --> 00:02:10,670
.بعدما يشبعني بالسم

34
00:02:11,150 --> 00:02:13,040
سحقًا... لِمَ؟

35
00:02:13,560 --> 00:02:14,800
لِمَ لا يمكنني الوصول؟

36
00:02:20,610 --> 00:02:21,670
!(سيجي)

37
00:02:21,670 --> 00:02:22,720
!(سيجي-كن)

38
00:02:40,100 --> 00:02:41,360
.يبدو أن وقت إنهاء الأمر قد حان

39
00:02:41,360 --> 00:02:43,740
!سننقذكَ حالاً أيها العقيد

40
00:02:43,740 --> 00:02:44,990
!انتظر قليلًا رجاءً

41
00:02:44,990 --> 00:02:45,620
!لا حاجةَ لهذا

42
00:02:45,960 --> 00:02:48,130
.فلتتراجع جميعُ القوات حالًا

43
00:02:48,870 --> 00:02:50,600
.اتركوني واذهبوا

44
00:02:51,870 --> 00:02:53,610
.قوةُ الشفاء تتناقص

45
00:02:54,230 --> 00:02:55,500
.إنها في أقصى حدودها

46
00:02:56,520 --> 00:02:57,440
...لا

47
00:02:58,090 --> 00:03:01,010
.يجبُ أن أكونَ الشخص الذي يهزمها

48
00:03:01,310 --> 00:03:02,840
!لقد قمتَ بما يكفي يا (سيجي)

49
00:03:03,180 --> 00:03:04,550
!لا يمكنكَ القتالُ أكثر

50
00:03:05,240 --> 00:03:06,080
...يجب عليَّ

51
00:03:07,040 --> 00:03:09,320
.الانتقامُ لـ(توكو)

52
00:03:09,980 --> 00:03:11,320
!يجبُ عليَّ

53
00:03:11,710 --> 00:03:13,950
!لا بدَّ أن أكون الشخص الذي يفعلها

54
00:03:15,700 --> 00:03:17,240
.(توم)، (إيزي)

55
00:03:17,860 --> 00:03:21,400
،سأكسبُ بعض الوقت
.خُذا (سيجي-كن) واهربا

56
00:03:24,670 --> 00:03:26,950
.هذا محالٌ عليكَ بمفردك

57
00:03:27,790 --> 00:03:30,380
.سأعيدكَ للديارِ حيًّا يا (سيجي)

58
00:03:30,890 --> 00:03:32,610
.ما زلتَ في طورِ النمو

59
00:03:32,980 --> 00:03:34,420
.يمكنكَ الغدو أقوى

60
00:03:35,160 --> 00:03:38,740
.لا تسئ الفهم. أنا أصفي حساباتي الخاصة

61
00:03:39,240 --> 00:03:41,590
أنا لا أفعلُ هذا من أجلك، اتفقنا؟

62
00:03:42,180 --> 00:03:44,430
.(توم) يحبُ هذا النوع من الأشياءِ كما تعلم

63
00:03:44,430 --> 00:03:46,340
"أهذا ما يدعونه بـ"تسوندي؟

64
00:03:46,640 --> 00:03:48,180
.هيَّا الآن، اذهبا

65
00:03:48,940 --> 00:03:49,850
.حظًا موفقًا

66
00:03:50,190 --> 00:03:53,620
لا تفعلا، ليست عدوةً بمقدوركما
.التعاملُ معها أنتما الاثنان

67
00:03:53,620 --> 00:03:55,010
!سَتُقتلان

68
00:03:58,680 --> 00:04:00,680
.أنا أراعيكما

69
00:04:00,980 --> 00:04:03,030
.إذا كنتما تستطيعان الهرب فيجدر بكما ذلك

70
00:04:03,370 --> 00:04:06,860
بالرغم ممَّا قلته، ولكن
سيحدثُ فرقٌ لو قاتلناها

71
00:04:06,860 --> 00:04:09,990
بجنودٍ متنقلين أو أسحلةٍ شاملةٍ تشبهُ البشر

72
00:04:10,580 --> 00:04:12,500
.حتى بطلُ قصةٍ محترفٍ سيعاني من هذا

73
00:04:13,000 --> 00:04:14,790
.يُفضلُ أن تكونَ مستعدًا يا (تاماكي)

74
00:04:15,140 --> 00:04:17,420
،خلال بضعِ دقائق

75
00:04:17,420 --> 00:04:19,800
.الأنقاضُ التي تمَّ امتصاصها سَتربطُ بروحي

76
00:04:20,120 --> 00:04:22,410
عندما يحدثُ هذا، سألتهمُ كليكما

77
00:04:22,410 --> 00:04:24,730
!ولن أتركَ أيَّ أثر

78
00:04:25,490 --> 00:04:27,620
!لقد تجاهلتم الأوامر

79
00:04:28,150 --> 00:04:30,520
!أخبرتكم أنني لا أحتاجُ المساعدة

80
00:04:30,760 --> 00:04:33,020
!أيَّها العقيد! أيَّها العقيد (ساندرز)

81
00:04:33,680 --> 00:04:35,980
هذا الصوت... (توم)؟

82
00:04:40,240 --> 00:04:41,690
...كان من شأن هذا قتلُ معظم الناس

83
00:04:51,440 --> 00:04:52,360
!عجبًا

84
00:04:52,660 --> 00:04:54,950
لقد قمتِ بإنشاءِ تفاوتٍ في كثافةِ الهواء

85
00:04:54,950 --> 00:04:56,670
لكي تحرِّفي مسار شعاع الضوءِ ذاك؟

86
00:05:00,100 --> 00:05:02,420
.يمكنني فعلُ شيءٍ مشابهٍ لذلك

87
00:05:13,980 --> 00:05:15,060
!أهذا حمضٌ قوي؟

88
00:05:16,790 --> 00:05:19,190
!أرمني يا (تاماكي)

89
00:05:22,860 --> 00:05:25,190
!فلتصلي

90
00:05:26,920 --> 00:05:28,200
...ذبابة صغيرة

91
00:05:31,240 --> 00:05:31,910
!(إيزي)

92
00:05:38,500 --> 00:05:41,800
!ليس من أسلوبي أن أهزم دائمًا

93
00:05:59,150 --> 00:06:01,440
!(إيزي)

94
00:06:02,730 --> 00:06:04,820
!أعتقدُ أن هذه نهايةُ التساهلِ معكِ

95
00:06:22,520 --> 00:06:24,270
!لقد دُمرت آلة التصوير الرئيسية

96
00:06:24,270 --> 00:06:26,230
!اعرضوا الصورة من قمر الاستطلاع الصناعي

97
00:06:41,750 --> 00:06:44,550
!أرى الأميرةَ باتجاهِ الساعة الثالثة

98
00:06:44,550 --> 00:06:45,940
!إنها عائمةٌ في الهواء

99
00:06:46,200 --> 00:06:49,150
!يجبُ علينا الابتعادُ من هنا أيَّها العقيد

100
00:06:49,880 --> 00:06:51,780
،بما أن الأميرة استولت على الأنقاض الآن

101
00:06:52,080 --> 00:06:55,160
فيجبُ علينا القيام بكلِ ما يتطلب لإبقاء
!(سيجي-كن) حيًا، بما أنهُ يعد المفتاح

102
00:06:55,680 --> 00:06:56,400
.لا

103
00:06:56,700 --> 00:06:59,540
.سننسفها بقنبلةٍ نوويةٍ انتحارية

104
00:07:00,880 --> 00:07:02,090
!ماذا؟

105
00:07:02,390 --> 00:07:04,960
وأيضًا، لِمَ تملكُ زرَّ تفعليلٍ لقنبلةٍ نووية؟

106
00:07:05,350 --> 00:07:07,220
هذا الزرَّ كبيرٌ جدًا

107
00:07:07,520 --> 00:07:09,590
.على مؤخرةِ رئيسنا ليتحمله

108
00:07:09,920 --> 00:07:11,300
.لا يمكنني تركهُ بين يديه

109
00:07:18,820 --> 00:07:20,270
.المعذرةُ يا رجال

110
00:07:22,770 --> 00:07:24,440
!سامحيني يا (إيزي)

111
00:07:24,440 --> 00:07:26,430
!مـ-مـ-مـ-مـ-مهلاً

112
00:07:26,430 --> 00:07:28,190
!انتظر لحظةً رجاءً أيها العقيد

113
00:07:28,190 --> 00:07:30,030
!إذا فعلتَ هذا، فسنموتُ نحن كذلك

114
00:07:30,270 --> 00:07:33,250
!هذه طريقةُ الأمريكان يا (أريا)

115
00:07:33,550 --> 00:07:36,920
!سأجعلكِ تلعقين مؤخرتي في الآخِرَة

116
00:07:54,250 --> 00:07:56,710
!أنا مهرج

117
00:07:56,710 --> 00:07:58,710
!مهرج! مهرج

118
00:07:58,710 --> 00:08:02,700
!مُهرج

119
00:08:01,400 --> 00:08:05,310
تفجيرُ كلِّ شيء لن يحلَّ
.جميع مشاكلكَ ببساطة

120
00:08:05,610 --> 00:08:08,480
.لقد شاهدتَ الكثير من أفلام "هوليوود" يا (ساندرز)

121
00:08:17,750 --> 00:08:18,530
!(سيجي-كن)

122
00:08:27,860 --> 00:08:28,760
...لا

123
00:08:29,710 --> 00:08:31,110
.لا مزيدَ من هذا

124
00:08:31,670 --> 00:08:34,570
!لا أريد خسارةَ أحدٍ آخر

125
00:08:38,370 --> 00:08:40,560
...أخبرتكَ أن تعيش

126
00:08:43,040 --> 00:08:46,150
.أنتَ حقًا... أحمق

127
00:09:08,170 --> 00:09:09,160
...(بي بي)

128
00:09:09,490 --> 00:09:13,420
.كنَّا شخصين من نفس النوع في النهاية

129
00:09:27,060 --> 00:09:28,440
.لا يمكننا حمايةُ أيِّ أحد

130
00:09:28,760 --> 00:09:30,030
.لا يمكننا إنقاذُ أيِّ أحد

131
00:09:30,610 --> 00:09:33,010
.كلُّ ما نفعلهُ هو رؤيةُ الناس يموتون

132
00:09:33,740 --> 00:09:36,170
.لا أملكُ الحقَّ بحملِ العالم على عاتقي

133
00:09:45,960 --> 00:09:48,560
.سأنكرُ نفسي

134
00:09:48,910 --> 00:09:51,280
لذا دعني

135
00:09:51,580 --> 00:09:54,400
!أُقدم حياتي لإنقاذِ (إيزي)

136
00:10:06,710 --> 00:10:07,730
!خَاتمُ الوشوم؟

137
00:10:08,110 --> 00:10:09,730
!إنهُ حي؟! ما الذي حدث؟

138
00:10:10,850 --> 00:10:13,740
فكرتُ في أنهُ إذا مات شخصٌ
،أو اثنين من المقربين إليه

139
00:10:14,040 --> 00:10:17,030
...فإنهُ سيغيِّر الطريقة التي يفكرُ بها حول الأشياء

140
00:10:18,110 --> 00:10:20,500
.لقد تعامل مع الأمور أفضل ممَّا توقعت

141
00:10:21,280 --> 00:10:23,000
،ولكن في النهاية

142
00:10:23,300 --> 00:10:25,670
.أظنُ أنهُ يتعينُ عليَّ فعلُ هذا بنفسي

143
00:10:44,250 --> 00:10:45,100
ما هذا؟

144
00:10:45,400 --> 00:10:45,970
...هذا

145
00:10:46,450 --> 00:10:47,940
المصدر يلتهمني؟

146
00:10:47,940 --> 00:10:50,390
!لا... شيءٌ مختلف

147
00:10:50,840 --> 00:10:53,340
!سحقًا لكَ يا (وايزمان)

148
00:10:54,790 --> 00:10:57,510
إذا اعتقدتِ أنني كنتُ أنوي
،إعطاءكِ السمَّ مباشرةً

149
00:10:57,510 --> 00:11:00,070
.فأنتِ مخطئةٌ تمامًا أيتها الأميرة

150
00:11:09,370 --> 00:11:12,030
.لقد اقترفتِ خطأين

151
00:11:12,600 --> 00:11:13,460
،الأول

152
00:11:14,420 --> 00:11:16,920
لقد ظننتِ أن المصدر يلتهمُ

153
00:11:16,920 --> 00:11:20,170
.المختومين فقط عندما ينهكون أرواحهم

154
00:11:20,700 --> 00:11:24,690
.الثاني، لقد شكلتِ رابطًا معه

155
00:11:25,490 --> 00:11:27,060
،في بُعد الوشوم

156
00:11:27,060 --> 00:11:30,060
.لا وجودَ لروابطٍ من جهةٍ واحدة فقط

157
00:11:30,360 --> 00:11:33,900
.لقد قدمتِ لنا ثغرةً لنستفيدَ منها

158
00:11:35,230 --> 00:11:37,530
أنا متأكدٌ من أنكِ تدركين الآن

159
00:11:39,450 --> 00:11:42,910
.أن أرواحَ أخواتكِ هنَّ وقودُ مصدركِ

160
00:11:43,210 --> 00:11:46,280
!وغد... أيها الوغد

161
00:11:54,230 --> 00:11:58,230
إذا كنَّا نواجهُ وحشًا قد ظهر
،من مكانٍ خارج حدود المنطق

162
00:11:58,740 --> 00:12:02,260
.فمن المنطقي مجابهتهُ بواحدٍ من نفس نوعه

163
00:12:52,720 --> 00:12:54,850
مصدر الوشم الذي لا منشط له

164
00:12:54,850 --> 00:12:57,550
،نَشَّطَ خاتمَ الوشومِ بدونِ شروط

165
00:12:58,030 --> 00:13:00,440
.مُجردًا كليكما من درعِ الفراغ

166
00:13:07,650 --> 00:13:10,910
ما بقي هو وحشينِ عاريين
،يحاولان التهامِ بعضهما البعض

167
00:13:11,210 --> 00:13:13,250
.معركةٌ بين ذاتين

168
00:13:24,560 --> 00:13:26,850
الأسلحةُ التَكْتِيكِيّة لا تؤثرُ

169
00:13:26,850 --> 00:13:29,100
.في مصدرٍ صخمٍ مغطىً بالفراغ

170
00:13:29,680 --> 00:13:32,180
...حاليًا، لا يمكننا فعلُ شيءٍ

171
00:13:33,150 --> 00:13:37,150
أنتَ الوحيدُ الذي بمقدورهِ قتال
!الأميرةِ الآن يا (سيجي-كن)

172
00:13:37,620 --> 00:13:39,870
!فلتحمنا رجاءً

173
00:13:39,870 --> 00:13:41,070
!واحمِ أمريكا

174
00:13:41,070 --> 00:13:42,650
!والعالم

175
00:13:57,040 --> 00:13:58,290
.هذا ليس صحيحًا

176
00:14:04,540 --> 00:14:05,840
.هذا ليس صحيحًا

177
00:14:10,840 --> 00:14:12,050
...هذا خاطئ

178
00:14:12,380 --> 00:14:15,640
احمِ أفكار العدالةِ التي تبلغ سبعة بلايين
!فكرةً والتي توجدُ في هذه الأرض

179
00:14:23,330 --> 00:14:26,380
!هكذا تفعلينها

180
00:14:52,560 --> 00:14:53,640
.أهلًا يا (إيزي)

181
00:14:54,460 --> 00:14:56,800
يبدو أن أروحنا ارتبطت مؤقتًا

182
00:14:56,800 --> 00:14:59,350
.عندما التهمكِ مصدر (سيجي)

183
00:14:59,710 --> 00:15:01,810
...سحقًا لـ(وايزمان) الوغد

184
00:15:05,030 --> 00:15:06,190
!(بلود)

185
00:15:13,670 --> 00:15:16,740
.شكرًا لأنكِ فتحتِ عينيه

186
00:15:16,970 --> 00:15:19,620
...أ-أجل

187
00:15:21,840 --> 00:15:23,670
.سينتهي كلُّ شيءٍ قريبًا

188
00:15:52,740 --> 00:15:55,290
!أجل! لقد حطَّمَ جبلها

189
00:15:57,460 --> 00:15:59,040
.شكرًا يا (توم-سان)

190
00:15:59,660 --> 00:16:01,120
.أفقتُ بفضلك

191
00:16:07,740 --> 00:16:09,910
،إذا كان بمقدورها التحكم بالمصدر

192
00:16:10,360 --> 00:16:13,340
فهذا يعني أنها تستخدمُ روح شخصٍ
.آخر بالإضافةِ إلى روحي لكي تُجَسدهُ

193
00:16:18,800 --> 00:16:21,730
.بالتفكير في الأمر، لا غير سوى أخواتِ الأميرة

194
00:16:21,730 --> 00:16:23,410
...سحقًا لكَ يا (وايزمان)

195
00:16:23,410 --> 00:16:25,640
في هذه المرحلة، كلُّ ما بوسعي فعله
،هو إنهاء الأمر بأسرع ما يمكن

196
00:16:25,640 --> 00:16:29,110
.والتقليل من الإجهاد الذي عليهن

197
00:16:30,910 --> 00:16:32,240
.آسف يا (إيزي)

198
00:16:33,110 --> 00:16:34,390
.لقد كنتُ أحمقًا

199
00:16:34,900 --> 00:16:38,470
.ولقد خُنتكَ يا (بي بي)

200
00:16:39,370 --> 00:16:40,910
.ولكن لا يوجدُ شكٌّ الآن

201
00:16:41,640 --> 00:16:43,150
!سأحمي الجميع

202
00:16:44,340 --> 00:16:45,540
،وهذا يتضمنكِ أيضًا

203
00:16:45,970 --> 00:16:47,670
!يا (أريا)

204
00:17:19,980 --> 00:17:22,120
أيحرِّكهُ بإرادتهِ الآن؟

205
00:17:38,000 --> 00:17:40,640
.لـ-لا تقلقن جميعكن

206
00:17:41,140 --> 00:17:43,060
.سيتحسن الوضع قريبًا

207
00:17:43,890 --> 00:17:46,580
حتى لو كان إجهادُ تجسيدِ

208
00:17:46,970 --> 00:17:48,830
،مصدرين منقسمًا بيننا جميعًا

209
00:17:49,290 --> 00:17:52,440
،إذا لم نختر واحدةً لتحمله
.فجميعنا سنسقط

210
00:17:53,860 --> 00:17:56,880
..وأنا الأختُ الكبرى

211
00:17:57,900 --> 00:18:01,590
!لذا لديَّ واجبٌ بحمايةِ أخواتي الصغيرات

212
00:18:03,650 --> 00:18:06,080
...ماذا؟ صداعي

213
00:18:15,630 --> 00:18:16,630
...(أريا)

214
00:18:18,710 --> 00:18:20,050
.هذا يشملكِ أيضًا

215
00:19:07,260 --> 00:19:09,530
،ربما يكونانِ تحت شروطٍ متساوية

216
00:19:09,530 --> 00:19:12,280
ولكن بما أن الأميرة لا تملكُ خبرةً
،بفنون الدفاعِ عن النفس

217
00:19:12,280 --> 00:19:14,600
.هذا هو نوع القتال الذي لم ترغب في خوضه

218
00:19:15,110 --> 00:19:17,320
.حان وقتُ دفع الثمن لاعتمادها على قواها دائمًا

219
00:19:24,200 --> 00:19:26,910
!أيها الوغد... أيها الوغد

220
00:19:36,730 --> 00:19:39,300
!ها أنتِ ذا

221
00:19:44,350 --> 00:19:46,470
!انطلق

222
00:19:46,470 --> 00:19:48,840
!هذه هي يا (سيجي-كن)

223
00:19:48,840 --> 00:19:51,940
!مهلًا، أأنتَ حيٌّ يا (تاماكي-سان)؟! هذا محال

224
00:19:55,150 --> 00:19:57,020
.أنهِهَا يا (سيجي)

225
00:20:00,370 --> 00:20:01,700
!أيها الوغد

226
00:20:07,490 --> 00:20:09,830
!ستندم على هذا أيها الفتى

227
00:20:09,830 --> 00:20:12,210
!لا تظنَّ أنكَ هزمتني

228
00:20:48,990 --> 00:20:51,620
!لقد فعلها! لقد انتصر (سيجي-كن)

229
00:20:51,620 --> 00:20:54,040
!لقد هربت الأميرة جارَّةً ذيلها بين ساقيها

230
00:20:54,040 --> 00:20:55,370
!أجل

231
00:20:55,930 --> 00:21:03,990
!(الولايات المتحدة الأمريكية/USA)

232
00:21:03,990 --> 00:21:06,820
...(سيجي-كن)، لا أصدقُ أنكَ

233
00:21:07,140 --> 00:21:08,100
!أجل

234
00:21:08,100 --> 00:21:09,810
!لقد فزنا! لقد فزنا

235
00:21:12,350 --> 00:21:14,740
كنَّا محظوظين بأن

236
00:21:14,740 --> 00:21:16,810
.العمليةَ انتهت كما توقعت

237
00:21:17,620 --> 00:21:19,680
.سنكونُ مشغولين لفترة

238
00:21:20,660 --> 00:21:24,050
.جميعكم، فلتبدأوا الاستعداد للتفاوض مع أمريكا

239
00:21:24,920 --> 00:21:26,820
.سأمسكُ الحقيقة بين يديَّ

240
00:21:50,140 --> 00:21:51,150
أنا ما عليهِ الآن

241
00:21:51,450 --> 00:21:54,900
.لأن (بي بي) أخذ بيدي ذاك اليوم

242
00:21:55,570 --> 00:21:58,430
لهذا الآن، يجبُ عليَّ أن أرثَ معتقداته

243
00:21:58,800 --> 00:22:01,860
.والأمل الذي أبقاهُ حيًّا للجميع

244
00:22:02,440 --> 00:22:05,110
كيف سأنسى شيئًا واضحًا كهذا؟

245
00:22:15,720 --> 00:22:16,770
.شكرًا

246
00:22:19,790 --> 00:22:23,150
.لكنتُ عاجزًا لو كنت بمفردي

247
00:22:49,700 --> 00:22:52,450
!جيشي هو الأقوى في العالم

248
00:22:58,920 --> 00:23:01,880
!لننهِ كلَّ شيءٍ هنا في القطب الجنوبي

249
00:23:06,490 --> 00:23:07,470
.سأصبحُ إلهًا

250
00:23:08,510 --> 00:23:10,760
!أنا الرقم واحد

251
00:23:13,040 --> 00:23:14,810
.ها قد حان موعد المعركةِ الحاسمة

252
00:23:25,020 --> 00:23:31,160
!مهرج

253
00:23:35,580 --> 00:23:39,550
ما الشيئينِ الباقيين برأيك؟