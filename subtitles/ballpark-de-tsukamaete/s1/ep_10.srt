1
00:01:32,490 --> 00:01:39,440
!هل يريد أحدكم هايبر دراي؟

2
00:01:47,960 --> 00:01:51,420
...أشعر وكأنّني رأيتُها في مكانٍ ما من قبل

3
00:01:51,700 --> 00:01:54,430
!يمكننا حتّى رؤية الدكّة من هنا

4
00:01:59,480 --> 00:02:01,000
ا-المعذرة

5
00:02:01,000 --> 00:02:03,160
...آسفة إن كنتُ مُخطئة، لكن

6
00:02:03,160 --> 00:02:06,520
!لستِ أودا ناتسومي، الآيدول، صحيح؟

7
00:02:06,520 --> 00:02:10,550
...لدي... حصلتُ على أسطواناتكِ في الإعداديّة

8
00:02:15,420 --> 00:02:16,870
أخطأتِ الشّخص

9
00:02:18,020 --> 00:02:19,990
حـ-حقّاً؟

10
00:02:19,990 --> 00:02:21,160
أنا آسفة

11
00:02:25,120 --> 00:02:26,890
إنّها مُحقّة

12
00:02:26,890 --> 00:02:28,860
أنا أودا ناتسومي

13
00:02:28,860 --> 00:02:30,470
لكنّني لستُ آيدول

14
00:02:30,470 --> 00:02:32,030
أنا مُمثّلة الآن

15
00:02:32,030 --> 00:02:34,340
!هذا مذكور على الإنترنت أيضاً

16
00:02:34,830 --> 00:02:39,140
كانت إطلالتي الأولى قبل تسع سنوات كجزء
مسرح فرقة الآيدول داي دريم

17
00:02:39,140 --> 00:02:41,050
تفكّكنا بسبب المبيعات السيّئة

18
00:02:41,050 --> 00:02:43,930
،قبل ستّ سنوات، انتقلتُ إلى التّمثيل
حلمي الحقيقيّ

19
00:02:44,490 --> 00:02:49,400
كنتُ أعاني من إيجاد أدوار منذ ذلك الحين

20
00:02:50,070 --> 00:02:53,360
لكن أعترف، لم يُحالفني الحظّ كثيراً

21
00:02:54,980 --> 00:02:59,590
ربّما لن فلت أبداً من كوني آيدول فاشلة

22
00:03:00,900 --> 00:03:01,900
ماذا؟

23
00:03:01,900 --> 00:03:03,580
...هل أنتِ

24
00:03:09,580 --> 00:03:11,340
!كـ-كوهيناتا؟

25
00:03:11,340 --> 00:03:12,340
!توقّعت

26
00:03:12,340 --> 00:03:15,060
مستحيل! ما زلتِ تعملين كبائعة آلة؟

27
00:03:15,060 --> 00:03:15,990
!أجل

28
00:03:16,380 --> 00:03:19,720
...وهذه معلومات ليست مذكورة على الإنترنت حتّى

29
00:03:19,980 --> 00:03:24,950
قبل أن أصبح آيدول، كنتُ أبيع
البيرة في هذا الملعب

30
00:03:28,600 --> 00:03:33,200
لن أنسى أبداً تلك اللّيلة الّتي
!أخذتِني فيها للشّرب حتّى الفجر

31
00:03:33,200 --> 00:03:34,820
!كم أحنّ لذلك

32
00:03:35,380 --> 00:03:39,170
كان ذلك اليوم الّذي غادر فيه
تسوباكي موتورسانز

33
00:03:39,170 --> 00:03:40,160
صحيح؟

34
00:03:41,100 --> 00:03:42,860
تسوباكي ميتسوتيرو

35
00:03:42,860 --> 00:03:48,320
لاعب واعد في المدرسة الثّانويّة، جزء
،من ثنائي تي المُزدوج مع كوجيرو

36
00:03:48,320 --> 00:03:51,880
كان من المُتوقَّع أن يصبح اللّاعب
الأوّل في موتورسانز

37
00:03:51,880 --> 00:03:53,150
!هذا صحيح

38
00:03:53,150 --> 00:03:56,080
كنتِ تحبّين تسوباكي فحسب، أليس كذلك؟

39
00:03:56,080 --> 00:04:00,670
،حدّثتِني كثيراً عنها في تلك اللّيلة
وصولاً إلى أيّامه في الثّانويّة

40
00:04:00,670 --> 00:04:02,990
!هذا مُحرج للغاية

41
00:04:02,990 --> 00:04:05,150
لكن كانت ذكرى رائعة

42
00:04:05,960 --> 00:04:09,840
ما زلتُ أتذكّر ما قاله في
مُقابلته عند الخروج

43
00:04:09,840 --> 00:04:11,690
كان من المُؤلم مُشاهدتها

44
00:04:11,690 --> 00:04:15,440
،تمّت تغطيتها بواسطة عدد قليل من الصّحفيّين
مُقارنة بوقت انضمامه

45
00:04:16,180 --> 00:04:19,550
...عندما أصعد التلّة، لا أنفك أُفكّر

46
00:04:19,550 --> 00:04:22,970
ماذا لو لم أستطع إيصال الكُرة"
"إلى منطقة الهجوم؟

47
00:04:23,760 --> 00:04:27,650
،لكن عندما أتبنّى ذلك التّفكير
أفشل دوماً

48
00:04:29,290 --> 00:04:31,470
...منذ لحظة صعودي التلّة

49
00:04:32,040 --> 00:04:34,560
!كنتُ قد خسرتُ بالفعل

50
00:04:34,560 --> 00:04:35,550
!هكذا

51
00:04:35,550 --> 00:04:38,190
!هذا صحيح! تماماً

52
00:04:38,190 --> 00:04:41,790
!أنتِ مُمثّلة فعلاً! يا له من أداء عظيم

53
00:04:41,790 --> 00:04:43,050
كُفّي عن ذلك الآن

54
00:04:43,590 --> 00:04:45,360
عندما أقوم بجلسات تصوير لمجلّة

55
00:04:45,360 --> 00:04:47,470
،أو أظهر في محطّة تلفزيونيّة محلّية

56
00:04:47,470 --> 00:04:49,560
"فدائماً ما يكون التّعليق "آيدول سابقة

57
00:04:50,070 --> 00:04:52,560
لا أحد يقبلني كمُمثّلة حقيقيّة

58
00:04:52,940 --> 00:04:55,630
فشلتُ في تجارب أداء لا تُحصَى

59
00:04:56,360 --> 00:04:59,170
أنا مثل موتورسانز فحسب

60
00:05:04,350 --> 00:05:07,370
فشل دائم

61
00:05:13,400 --> 00:05:18,090
موتورسانز بفئة ب دوماً، بإنهاء
،أقلّ من 500

62
00:05:18,090 --> 00:05:20,590
وفريق فشله مضمون، صحيح؟

63
00:05:20,590 --> 00:05:24,970
،كنتُ أعلم بأنّني اخترتُ طريقاً وعراً
!لكن مع ذلك أثّر الأمر بي

64
00:05:25,290 --> 00:05:28,280
الجميع يقولون بأنّ الفشل
،ضروريّ للنّجاح

65
00:05:28,280 --> 00:05:30,180
!لكن لا أريد أن أفشل

66
00:05:30,180 --> 00:05:34,750
لذا أتيتُ إلى هنا لأرتاح من فشلي
!الّذي يُلازمني

67
00:05:34,750 --> 00:05:35,860
!المزيد من فضلك

68
00:05:41,820 --> 00:05:42,820
تفضّلي

69
00:05:47,380 --> 00:05:49,920
أعتقد أنّ موتورسانز يُدافعون الآن

70
00:05:49,920 --> 00:05:52,900
الجميع يزورون المحلّات ودورات المياه
في نفس الوقت

71
00:05:52,900 --> 00:05:54,780
والرّواق يزدحم

72
00:05:54,780 --> 00:05:55,920
أحنّ لتلك الأيّام

73
00:05:55,920 --> 00:05:58,300
هذا يجعل دماءك كبائعة آلة يغلي، صحيح؟

74
00:05:59,340 --> 00:06:03,020
حتّى كبائعة آلة، لم أملك أي موهبة

75
00:06:06,740 --> 00:06:08,810
!إنّها إصابة أُخرى

76
00:06:08,810 --> 00:06:11,120
!خروج واحد مع راكضين في القاعدتين الأولى والثّانية

77
00:06:11,120 --> 00:06:14,250
لا يروقني ما يجري

78
00:06:14,250 --> 00:06:16,910
أعتقد من الأفضل أن نعود إلى مقاعدنا

79
00:06:16,910 --> 00:06:19,710
...ماذا؟ ألستِ

80
00:06:19,710 --> 00:06:20,710
!أنتش

81
00:06:22,150 --> 00:06:24,860
المزيد من النّاس الّذين يعرفونني كآيدول؟

82
00:06:24,860 --> 00:06:26,520
!توقّعت

83
00:06:26,520 --> 00:06:29,670
أنتِ ناتسومي، بائعة الآلة
!من عقد مضى

84
00:06:29,670 --> 00:06:32,450
!أجل! أتذكّر تلك الأيّام

85
00:06:34,990 --> 00:06:36,490
!وكُرة أربع مرّات

86
00:06:36,490 --> 00:06:37,790
!خروج واحد مع امتلاء القواعد

87
00:06:37,790 --> 00:06:40,980
موتورسانز في ورطة في النّصف
!الأوّل من الشّوط السّابع

88
00:06:40,980 --> 00:06:42,420
!هل يستطيع ميتسي الخروج من هذا؟

89
00:06:42,420 --> 00:06:44,070
!هيّا يا ميتسي

90
00:06:44,070 --> 00:06:45,880
!انتبه للرّاكضين أيضاً

91
00:06:46,250 --> 00:06:48,800
!يرمي مُباشرة

92
00:06:48,800 --> 00:06:49,940
!يضرب بقوّة

93
00:06:49,940 --> 00:06:51,220
!بئساً! سوف تعبر

94
00:06:51,960 --> 00:06:53,840
!لاعب الارتكاز شيشيو يُحلّق نحوها

95
00:06:53,840 --> 00:06:55,770
!يقذفها نحو إتشينوميا! إنّه خروج ثانٍ

96
00:06:55,770 --> 00:06:56,750
!الرّمية نحو الأوّل

97
00:06:56,750 --> 00:06:59,150
!فيخرج، في لعبة مزدوجة

98
00:07:03,280 --> 00:07:05,690
آسف، عمّاذا كنّا نتكلّم؟

99
00:07:05,690 --> 00:07:06,990
هذا صحيح

100
00:07:07,490 --> 00:07:09,790
سمعتُ أنّكِ مُمثّلة الآن، صحيح؟

101
00:07:09,790 --> 00:07:12,850
تتكلّم كوشيناتا عنكِ دوماً

102
00:07:12,850 --> 00:07:14,260
ليس تماماً

103
00:07:14,260 --> 00:07:16,460
لستُ بالأمر الجلل

104
00:07:16,460 --> 00:07:17,620
!لا تقولي ذلك

105
00:07:17,620 --> 00:07:20,700
!الأمر الجلل هو أنّكِ تُكافحين باستمرار

106
00:07:20,700 --> 00:07:24,490
!أنتِ خرّيجة موتورسانز، هذا يعني أنّكِ مرِنة

107
00:07:24,490 --> 00:07:26,510
واظبي على ذلك، مفهوم؟

108
00:07:28,040 --> 00:07:29,650
شـ-شكراً

109
00:07:32,460 --> 00:07:34,460
مع ذلك خسروا في النّهاية

110
00:07:35,440 --> 00:07:37,560
!كان ذلك وشيكاً

111
00:07:37,560 --> 00:07:40,070
!مع الأسف، لم ينتهِ الأمر بعد

112
00:07:40,070 --> 00:07:43,270
أجل، سيبلون بشكل أفضل
!في المرّة المُقبلة

113
00:07:43,270 --> 00:07:45,510
!كافح اللّاعبون حتّى النّهاية

114
00:07:45,510 --> 00:07:48,060
!يجب أن نبقى مُؤمنين أيضاً

115
00:07:48,060 --> 00:07:49,800
!الأمر يتعلّق حول المرّة المُقبلة

116
00:07:53,590 --> 00:07:55,160
ما-ما خطبكِ؟

117
00:07:55,160 --> 00:07:58,960
صحيح أنّ فريقنا يخسر كثيراً

118
00:07:59,350 --> 00:08:01,680
،لكن مهما بدونا سيّئين

119
00:08:01,680 --> 00:08:05,170
سنظلّ نُحاول شقّ طريقنا
!نحو مُباراة نهائيّة

120
00:08:05,640 --> 00:08:07,760
لا أحد هنا قد استسلم بعد

121
00:08:09,150 --> 00:08:12,970
!أعتقد هذا الأمر رائع بحدّ ذاته

122
00:08:18,260 --> 00:08:19,820
لا مُشكلة، أليس كذلك؟

123
00:08:19,820 --> 00:08:21,840
...إذا اعتبرتُ نفسي خرّيجة

124
00:08:22,350 --> 00:08:26,110
ذلك الفريق الرّديء، وهذا الملعب؟

125
00:08:30,000 --> 00:08:35,760
كنتُ أخسر غالباً في اللّحظة الّتي
أخوض فيها تجارب الأداء

126
00:08:38,870 --> 00:08:41,520
!أتعلمين؟ كما قال تسوباكي

127
00:08:41,520 --> 00:08:45,000
أنتِ تُحبّينه حقّاً، صحيح؟

128
00:08:46,470 --> 00:08:49,470
آمل أنّه ما زال يُكافح في مكانه أيضاً

129
00:08:49,470 --> 00:08:51,080
لا تقلقي

130
00:08:51,080 --> 00:08:54,290
خرّيجو موتورسانز جميعهم مرنون

131
00:08:59,370 --> 00:09:03,010
اسمعي، ما زلنا في النّصف الثّاني من الشّوط
الخامس في حياتنا، صحيح؟

132
00:09:03,010 --> 00:09:04,730
!كُفّي عن ذلك الآن

133
00:09:04,730 --> 00:09:07,010
!هذا هو شوطنا الثّاني

134
00:09:07,910 --> 00:09:10,070
هذا صحيح. هل ما زال أحد من
الأيّام الخوالي في المقرّ؟

135
00:09:10,070 --> 00:09:11,720
ما زال ناكايزومي هناك

136
00:09:11,720 --> 00:09:13,240
!إنّه قائد المُراقبين

137
00:09:13,240 --> 00:09:14,640
!مستحيل

138
00:09:15,260 --> 00:09:17,210
!ستُصدَمين إذا رأيتِه

139
00:09:27,340 --> 00:09:29,370
!هذه قد خرجتْ أيضاً

140
00:09:29,370 --> 00:09:31,340
كم مرّة صاروا فوق السّياج؟

141
00:09:32,680 --> 00:09:34,940
!واظب على أدائك في المُباراة اليوم يا برايان

142
00:09:34,940 --> 00:09:37,750
!حسناً! سأفعل بالتّأكيد يا شيشيو

143
00:09:38,680 --> 00:09:42,120
!شارك بعضاً من تلك القوّة معنا يا رجل

144
00:09:42,120 --> 00:09:45,950
كُل جيّداً وستصل إلى ما تُريد
!قريباً يا إتشينوميا

145
00:09:53,480 --> 00:09:55,710
ما الأمر يا دينيس؟

146
00:09:55,710 --> 00:09:57,110
تبدو مُحبَطاً

147
00:09:58,360 --> 00:10:01,410
لا شيء. ليس عليك القلق

148
00:10:01,410 --> 00:10:03,290
هيّا، دعنا نتحدّث

149
00:10:03,290 --> 00:10:04,580
ربّما يمكنني المُساعدة

150
00:10:06,920 --> 00:10:08,010
...لماذا

151
00:10:08,410 --> 00:10:10,900
لماذا الجميع مهتمّون بك؟

152
00:10:10,900 --> 00:10:11,670
ماذا؟

153
00:10:11,670 --> 00:10:14,390
تقصد كما في أقسام التّعليق؟

154
00:10:14,390 --> 00:10:16,270
...أنا لا أتصفّح الإنترنت أبداً

155
00:10:16,270 --> 00:10:18,340
!لـ-لا أقصد ذلك

156
00:10:18,340 --> 00:10:19,970
!ليس الإنترنت

157
00:10:19,970 --> 00:10:22,350
ماذا تقصد إذاً؟

158
00:10:22,350 --> 00:10:23,560
...أقصد

159
00:10:24,480 --> 00:10:26,110
مُؤخّرتك

160
00:10:29,230 --> 00:10:30,630
!مُؤخّرتك

161
00:10:30,940 --> 00:10:33,470
الجميع يربتون على مُؤخّرتك

162
00:10:33,470 --> 00:10:37,050
!لا أحد يربت على مُؤخّرتي

163
00:10:38,360 --> 00:10:40,700
!د-دينيس، أحسنت الضّرب

164
00:10:40,700 --> 00:10:43,550
!هذا مُذهل! يمكنك ضرب الكُرة أينما كانت

165
00:10:45,220 --> 00:10:48,440
لستُ شخصاً اجتماعيّاً كثيراً. أعي ذك

166
00:10:48,440 --> 00:10:52,790
لكن قرّرتُ البقاء في اليابان في الموسم
...المُقبل، لذا آمل أن يُظهِروا قليلاً من

167
00:10:54,070 --> 00:10:55,550
هذا فقط؟

168
00:10:56,570 --> 00:10:59,760
"وحدة المُستورد من الخارج"

169
00:11:00,140 --> 00:11:04,140
أغار من سرعتك في التكيُّف
هنا في اليابان

170
00:11:04,140 --> 00:11:05,700
أنا؟

171
00:11:05,700 --> 00:11:06,730
على ما أعتقد

172
00:11:06,730 --> 00:11:12,130
زوجتي يابانيّة، وافتتحنا مطعم بيرتو
،ريكان في طوكيو

173
00:11:12,130 --> 00:11:13,940
ويُحقّق نجاحاً جيّداً

174
00:11:13,940 --> 00:11:18,950
بالإضافة إلى ذلك، حلمي هو إحراز 2000 ضربة
ودخول نادي اللّاعبين الذّهبيّين

175
00:11:18,950 --> 00:11:22,030
لكن ليس هذا ما يهمّ

176
00:11:22,030 --> 00:11:23,390
—تكمن أخطاؤك في

177
00:11:23,390 --> 00:11:24,750
!دينيس

178
00:11:25,560 --> 00:11:27,110
طلبَك المُدير

179
00:11:27,110 --> 00:11:28,640
مُرّ به قليلاً

180
00:11:28,640 --> 00:11:29,650
حسناً

181
00:11:29,990 --> 00:11:32,750
آسف يا برايان. يمكننا التكلّم لاحقاً

182
00:11:33,130 --> 00:11:34,460
دينيس

183
00:11:34,460 --> 00:11:37,900
سُجِّلَتْ عليك إصابتان البارحة. هل أنت بخير؟

184
00:11:47,640 --> 00:11:49,390
أنا بخير تماماً

185
00:11:49,390 --> 00:11:52,570
أنا جاهز لأفعل ما بوسعي كما أفعل دوماً

186
00:11:53,480 --> 00:11:55,380
هذه هي المُشكلة يا دينيس

187
00:11:55,380 --> 00:11:57,280
هنا تكمن أخطاؤك

188
00:11:57,610 --> 00:11:59,840
،حتّى لو كنتَ لا تُجيد اليابانيّة

189
00:11:59,840 --> 00:12:03,790
عليك أن تنظر في وجه الشّخص
الّذي تتكلّم معه، لا المُترجم

190
00:12:04,680 --> 00:12:06,170
النّصف الثّاني من الشّوط الخامس

191
00:12:06,170 --> 00:12:08,040
،التّالي في القاعدة الرّئيسيّة لموتورسانز

192
00:12:08,040 --> 00:12:11,040
الرّابع في التّرتيب، رجل القاعدة
الثّالث دينيس يونغ

193
00:12:11,610 --> 00:12:14,210
تفضّل البيرة الخاصّة بك

194
00:12:14,210 --> 00:12:16,480
شـ-شكراً

195
00:12:16,480 --> 00:12:17,670
...أخرج مِحفظتي

196
00:12:18,000 --> 00:12:20,240
...تـ-تفضّلي. ألف ين

197
00:12:21,560 --> 00:12:23,780
أ-أحرز دينيس إصابتين اليوم

198
00:12:23,780 --> 00:12:25,850
إنّه يبلي حسناً، صحيح؟

199
00:12:26,860 --> 00:12:28,940
أجل، هذا ما أعتقده

200
00:12:29,340 --> 00:12:32,900
...تتصرّف روريكو بشكل مختلف اليوم

201
00:12:32,900 --> 00:12:35,750
!لم تنظر في عيني ولو مرّة

202
00:12:35,750 --> 00:12:39,400
تفضّل. فكّتك

203
00:12:39,400 --> 00:12:43,330
آ-آسف. هل أنتِ غاضبة منّي؟

204
00:12:43,330 --> 00:12:46,040
لا، لستُ غاضبة

205
00:12:46,640 --> 00:12:48,150
إلى اللّقاء

206
00:12:48,150 --> 00:12:50,720
...أ-أنا آسف

207
00:12:54,820 --> 00:12:56,190
!كان ذلك مُحرجاً للغاية

208
00:12:56,190 --> 00:12:59,630
لِمَ كان عليّ أن أناديه السيّد
!موراتا في المرّة السّابقة؟

209
00:13:00,480 --> 00:13:01,970
سيّد موراتا

210
00:13:01,970 --> 00:13:05,680
!مُحرج للغاية

211
00:13:07,190 --> 00:13:09,230
...من النّاحية الأُخرى

212
00:13:13,690 --> 00:13:14,970
ذلك الرّجل

213
00:13:14,970 --> 00:13:17,860
يبدو مُقرّباً جدّاً بإلَهتي

214
00:13:17,860 --> 00:13:21,970
أشعر وكأنّ ذلك الرّجل ينظر
!إلى أعماق روحي

215
00:13:25,590 --> 00:13:29,040
والآن النّتيجة مُتعادلة ثلاثة مُقابل
!ثلاثة في النّصف الثّاني من السّابع

216
00:13:29,040 --> 00:13:31,990
أحرز دينيس يونغ ثلاث إصابات اليوم

217
00:13:31,990 --> 00:13:34,790
يستطيع تحقيق دورة كاملة من الإصابات
!إذا حصدَ هوم ران

218
00:13:34,790 --> 00:13:36,110
،هذا إنجاز عظيم

219
00:13:36,110 --> 00:13:39,810
لكن لا يتحمّل موتورسانز خسارة إذا
!أراد بلوغ النّهائي

220
00:13:40,620 --> 00:13:43,890
"وحدة المُستورد من الخارج"

221
00:13:44,170 --> 00:13:47,890
هل يستطيع تجاوز كاتابيرا
!من فوكوكا ستيكس؟

222
00:13:49,070 --> 00:13:51,350
...المُستورد من الخارج

223
00:13:51,760 --> 00:13:53,600
نادِني كما تشاء

224
00:13:53,600 --> 00:13:55,810
...إذاً هذا المُستورد سيقود فريقه

225
00:13:57,070 --> 00:13:59,150
!إلى مجموعة الذّروة

226
00:14:00,200 --> 00:14:01,820
!إنّها إصابة

227
00:14:01,820 --> 00:14:04,240
!إصابة بليغة نحو الميدان الأيمن

228
00:14:04,240 --> 00:14:07,280
!لاعب الميدان الأيمن يرجع
!إنّه عند السّياج

229
00:14:07,280 --> 00:14:09,240
!هل ستخرج؟

230
00:14:11,690 --> 00:14:13,120
!خرجَتْ

231
00:14:13,120 --> 00:14:15,130
!إنّها هوم ران

232
00:14:15,130 --> 00:14:18,380
!حقّق موتورسانز نقطة التقدُّم الّتي يحتاجها

233
00:14:19,590 --> 00:14:22,470
يمشي دينيس يونغ مُتباهياً
!فوق القاعدة الرّئيسيّة

234
00:14:22,470 --> 00:14:24,300
!أحرز دورة إصابات

235
00:14:26,170 --> 00:14:27,850
!أ-أحسنت الضّرب

236
00:14:27,850 --> 00:14:29,260
!كان ذلك مثاليّاً

237
00:14:29,540 --> 00:14:33,890
"من المُدهش أن تُحرز إصابة بـ"قاطعة مُنخفضة
!كلّ المسافة نحو المُدرّجات

238
00:14:41,670 --> 00:14:42,480
...د

239
00:14:42,940 --> 00:14:45,860
دومو أريغاتو غوزايماسو

240
00:14:49,760 --> 00:14:53,260
!أعتقد بالغت كثيراً في تلك الإصابة يا دينيس

241
00:14:53,260 --> 00:14:54,750
!تهانينا تحقيقك دورة إصابات

242
00:14:54,750 --> 00:14:57,130
أهذه هي المرّة الأولى الّتي
تتحدّث فيها اليابانيّة؟

243
00:15:03,050 --> 00:15:05,030
!روح الشّباب

244
00:15:05,030 --> 00:15:07,760
!ليتني أكون جزءاً من ذلك

245
00:15:09,280 --> 00:15:11,390
...بعد المُباراة

246
00:15:12,630 --> 00:15:13,670
!دينيس

247
00:15:15,560 --> 00:15:18,780
أحضرتُ الفتاة الّتي أصبتَها بالهوم ران

248
00:15:18,780 --> 00:15:21,400
قلتَ بأنّك أردت الاعتذار، صحيح؟

249
00:15:21,400 --> 00:15:22,980
أجل. شكراً

250
00:15:25,610 --> 00:15:27,940
!قـ-قدري

251
00:15:27,940 --> 00:15:30,450
!أصبتُ إلَهتي بتلك الكُرة؟

252
00:15:30,750 --> 00:15:33,430
...أ-أنا آسف جدّاً

253
00:15:33,430 --> 00:15:35,260
...لـ-لا، لا

254
00:15:35,260 --> 00:15:37,420
غومين ناساي... صحيح؟

255
00:15:42,280 --> 00:15:43,210
!ماذا؟

256
00:15:43,920 --> 00:15:45,440
!ضربة مُوفّقة

257
00:15:46,350 --> 00:15:50,310
!أ-أريغاتو غوزايماسو

258
00:15:56,090 --> 00:15:58,500
!سمعنا الأخبار يا كوجيرو

259
00:15:58,500 --> 00:16:01,360
!تهانينا حمل زوجتك

260
00:16:02,030 --> 00:16:03,500
تنتشر الأنباء بسرعة إذاً

261
00:16:03,500 --> 00:16:06,490
شكراً. أخجلتم تواضعي

262
00:16:06,770 --> 00:16:09,900
كيف كانت ردّة فعل زملائك في الفريق؟

263
00:16:09,900 --> 00:16:12,700
جميعهم تمنّوا لنا التّوفيق

264
00:16:12,700 --> 00:16:17,710
هل هناك شخص آخر تريد أن تخبره
غير عائلك وزملائك؟

265
00:16:18,630 --> 00:16:21,080
أحد آخر؟

266
00:16:21,080 --> 00:16:22,650
سؤال وجيه

267
00:16:23,910 --> 00:16:28,310
هناك شخص واحد يجب عليّ إخباره

268
00:16:35,130 --> 00:16:37,860
كوجيرو. إلى أين أنت ذاهب؟

269
00:16:37,860 --> 00:16:39,600
اجتماع الفريق على وشك البدء

270
00:16:39,600 --> 00:16:42,380
صـ-صحيح. عليّ إجراء مُكالمة فحسب

271
00:16:42,380 --> 00:16:43,530
سأعود في الحال

272
00:16:46,800 --> 00:16:49,840
يجب أن أبحث عن مكان
لأكون فيه وحدي

273
00:16:49,840 --> 00:16:51,400
!طاب يومك يا سيّد

274
00:16:51,830 --> 00:16:54,020
سيّد إيغاراشي. تسرّني رؤيتك

275
00:16:54,020 --> 00:16:57,080
!بئساً! تأخّرتُ ثانية

276
00:16:59,120 --> 00:17:01,830
...غرفة انتظار الطّاقم

277
00:17:01,830 --> 00:17:03,080
إنّها مُتاحة

278
00:17:08,420 --> 00:17:09,470
حسناً

279
00:17:16,440 --> 00:17:19,350
مرحباً؟ كوجيرو؟

280
00:17:19,350 --> 00:17:21,040
نـ-نعم

281
00:17:21,040 --> 00:17:22,940
آسف لاتّصالي بك فجأة

282
00:17:22,940 --> 00:17:24,370
هل أنت مُتفرّغ؟

283
00:17:24,860 --> 00:17:25,860
ما الأمر؟

284
00:17:28,710 --> 00:17:30,740
لم أرك منذ وقت يا تسوباكي

285
00:17:33,110 --> 00:17:35,360
...تسوباكي... أنا

286
00:17:35,360 --> 00:17:36,740
كيف حالك؟

287
00:17:37,070 --> 00:17:39,830
بخير. شكراً على السّؤال

288
00:17:39,830 --> 00:17:43,360
آخر مرّة رأينا فيها بعضنا الآخر
،كانت في مُباراة الدّوري الدّاخليّ

289
00:17:43,360 --> 00:17:47,210
عندما كنتُ مع سبيدواغون
وكنتَ أنت مع موتورسانز

290
00:17:47,210 --> 00:17:50,550
قبل ثلاثة عشر عاماً. يُعيدني
ذلك إلى الذّكريات

291
00:17:51,110 --> 00:17:56,510
آسف لأنّني غادرتُ قبل أن نتمكّن من إحياء
ثنائي تي المُزدوج لموتورسانز

292
00:17:57,680 --> 00:17:59,520
أين أنت الآن؟

293
00:17:59,520 --> 00:18:03,230
سمعتُ أنّك كنتَ تلعب لدوري مُستقلّ
في الولايات المُتّحدة الأمريكيّة

294
00:18:03,480 --> 00:18:06,120
اعتزلتُ قبل ثلاث سنوات

295
00:18:06,120 --> 00:18:07,430
حقّاً؟

296
00:18:07,430 --> 00:18:09,480
لا بُدّ أنّ الأمور كانت صعبة هناك

297
00:18:09,740 --> 00:18:10,990
لستُ نادماً على ذلك

298
00:18:10,990 --> 00:18:14,960
كنتُ ألعب كما المعتاد، لكن
إنجليزيّتي قد تحسّنت

299
00:18:16,240 --> 00:18:19,580
كان يجدر بك أن تتّصل بي عندما عُدت

300
00:18:19,580 --> 00:18:21,410
ماذا تعمل الآن؟

301
00:18:23,370 --> 00:18:26,660
سأخبرك في المرّة المُقبلة الّتي
نلتقي فيها

302
00:18:26,660 --> 00:18:29,600
لكن أعتزّ فيما أفعله

303
00:18:29,600 --> 00:18:31,190
،ليس عليك القلق

304
00:18:31,190 --> 00:18:33,840
فهمت. هذا ما هو مُهمّ حقّاً

305
00:18:34,140 --> 00:18:37,370
يبدو أنّك تُنظّف مؤخّراً يا كوجي

306
00:18:37,370 --> 00:18:38,710
لا يمكنني الجزم

307
00:18:38,710 --> 00:18:41,740
بلغتُ تصنيفاً أقلّ من 100 لأوّل
،مرّة منذ مدّة

308
00:18:41,740 --> 00:18:43,560
لكنّني ابتعدتُ كثيراً عن قمّة أدائي

309
00:18:43,560 --> 00:18:45,120
غير صحيح إطلاقاً

310
00:18:45,120 --> 00:18:47,660
...وضعيّة البدء خاصّتك وتموضُع مِرفقيك

311
00:18:47,660 --> 00:18:50,520
كان كلّ شيء يبدو ممتازاً
في الشّهر الماضي وما شابه

312
00:18:50,520 --> 00:18:52,350
بجدّية؟

313
00:18:52,350 --> 00:18:54,280
كنتَ تُشاهدني حقّاً، صحيح؟

314
00:18:54,650 --> 00:18:55,690
كوجي

315
00:18:55,690 --> 00:18:58,240
لا أريدك أن تعتزل لفترة طويلة

316
00:18:59,920 --> 00:19:03,120
...مهلاً، تلك كانت الخطّة على أيّ حال

317
00:19:04,120 --> 00:19:05,500
تسوباكي

318
00:19:05,500 --> 00:19:07,330
—لديّ شيء لأخبرك بـ

319
00:19:10,540 --> 00:19:13,100
!حسناً! لنشرع في العمل

320
00:19:18,300 --> 00:19:20,930
آسف، هل هذه الغرفة الخطأ؟

321
00:19:20,930 --> 00:19:24,350
آ-آسف! تريدان الغرفة، صحيح؟

322
00:19:24,350 --> 00:19:25,850
سأخرج حالاً

323
00:19:28,320 --> 00:19:30,940
سننتظر في الغرفة المُجاورة

324
00:19:30,940 --> 00:19:33,550
هـ-هل أنتما متأكّدان؟

325
00:19:35,780 --> 00:19:38,000
!اعذرنا رجاء

326
00:19:39,030 --> 00:19:41,870
—آسف بشأن ذلك. أتى بعض الأشخاص

327
00:19:41,870 --> 00:19:43,610
!المعذرة

328
00:19:47,190 --> 00:19:52,050
آسف، السيّد كوجيرو يستخدم غرفة
انتظارنا لإجراء مُكالمة

329
00:19:52,050 --> 00:19:55,100
هل يمكنني تبديل ملابسي هنا؟

330
00:19:56,630 --> 00:19:58,110
!تسوباكي

331
00:19:58,110 --> 00:19:59,980
!أين أنت الآن؟

332
00:19:59,980 --> 00:20:01,050
كوجي

333
00:20:01,050 --> 00:20:04,040
لديّ عمل، لذا أنا مضطرّ للإغلاق

334
00:20:04,390 --> 00:20:06,080
!انتظر لحظة

335
00:20:06,080 --> 00:20:06,720
—هل أنت

336
00:20:06,720 --> 00:20:08,520
إلى اللّقاء يا كوجي

337
00:20:08,520 --> 00:20:09,360
!انتظر لحظة

338
00:20:09,360 --> 00:20:11,730
—أودّ أن أخبرك بشيء

339
00:20:24,620 --> 00:20:27,200
!آسف بشأن الإزعاج قبل قليل

340
00:20:27,200 --> 00:20:28,980
هل كان يوجد شخص آخر في الدّاخل؟

341
00:20:31,040 --> 00:20:31,960
!ا-المعذرة

342
00:20:31,960 --> 00:20:33,250
!اسمحا لي بالمرور رجاء

343
00:20:34,590 --> 00:20:36,340
!تسوباكي! أنت في الدّاخل، أليس كذلك؟

344
00:20:36,340 --> 00:20:37,840
!تسوباكي

345
00:20:39,840 --> 00:20:41,820
!تسوباكي! سأدخل

346
00:20:50,700 --> 00:20:53,270
سان... شيرو؟

347
00:21:00,710 --> 00:21:03,340
كـ-كان... أنت؟

348
00:21:06,110 --> 00:21:07,070
!تسوباكي

349
00:21:07,070 --> 00:21:08,910
!أنت تسوباكي، أليس كذلك؟

350
00:21:13,380 --> 00:21:15,160
!لا، لا أقصد ذلك

351
00:21:15,160 --> 00:21:17,100
!أنا جادّ

352
00:21:23,660 --> 00:21:25,960
أفتخر فيما أفعله

353
00:21:25,960 --> 00:21:27,220
ليس عليك القلق

354
00:21:35,080 --> 00:21:36,260
هكذا إذاً

355
00:21:36,260 --> 00:21:38,110
أجل، بالطّبع

356
00:21:50,150 --> 00:21:52,770
...أجل. شكراً

357
00:21:54,220 --> 00:21:57,170
شكراً لك يا سان-شيرو