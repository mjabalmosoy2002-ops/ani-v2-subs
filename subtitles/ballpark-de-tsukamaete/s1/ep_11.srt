1
00:01:37,640 --> 00:01:39,950
!تفضّلوا

2
00:01:39,950 --> 00:01:42,950
!اللّيلة هي الحاسمة لموتورسانز

3
00:01:42,950 --> 00:01:45,720
!احرصوا على زيارة الملعب

4
00:01:47,530 --> 00:01:50,340
...إنّه فريق التّشجّيع

5
00:01:50,810 --> 00:01:53,540
ماذا يعني "حاسمة"؟

6
00:01:56,140 --> 00:01:58,260
...ماذا؟ هذه

7
00:02:03,100 --> 00:02:04,980
!زورونا رجاء

8
00:02:09,810 --> 00:02:12,920
الفريق يلعب بشكل أفضل عندما
!يكون المُعجبون خلفه

9
00:02:12,920 --> 00:02:17,440
هذا عامنا للوصول أخيراً إلى
!مجموعة الذّروة

10
00:02:17,440 --> 00:02:19,550
!لنُقدّم دعمنا جميعاً

11
00:02:27,900 --> 00:02:28,960
...المعذرة

12
00:02:31,370 --> 00:02:34,740
...أنا... في الواقع

13
00:02:34,740 --> 00:02:35,850
ما الأمر؟

14
00:02:35,850 --> 00:02:38,010
هل تحبّين موتورسانز؟

15
00:02:46,070 --> 00:02:48,110
،كما أعتقد بأنّكم تعلمون جميعاً

16
00:02:48,110 --> 00:02:52,710
مُباراة اليوم هي ضدّ فوكوكا ستيكس

17
00:02:52,710 --> 00:02:55,530
وستكون الأهمّ في تاريخ
!فريقنا: الحاسِمة

18
00:02:55,530 --> 00:02:57,870
!تذكّرت! الحاسِمة

19
00:02:58,370 --> 00:03:00,830
!نحن مُتعادلان حالياً في المركز الثّالث

20
00:03:01,290 --> 00:03:06,190
،لكن إذا هزمنا ستيكس اللّيلة
،فسنستحوذ على المركز 3 لوحدنا

21
00:03:06,190 --> 00:03:09,340
!ونؤمّن مكاناً لنا في المُباريات الفاصلة

22
00:03:09,860 --> 00:03:13,980
قد تكون اللّيلة بداية عصر جديد
...في تاريخ موتورسانز

23
00:03:17,890 --> 00:03:21,810
ولنحاول أن نكون العلامة التّجاريّة
!الّتي تُحقّق أكبر مبيعات اللّيلة

24
00:03:21,810 --> 00:03:22,960
!حاضرة

25
00:03:24,630 --> 00:03:27,420
،بدأتُ عمل بيع البيرة قبل أربعة أشهر

26
00:03:28,220 --> 00:03:33,400
أشعر وكأنّ الملعب في حالة
توتّر طوال اليوم

27
00:03:35,610 --> 00:03:38,610
!شكراً على توزيع المناشير

28
00:03:38,610 --> 00:03:40,960
!لنبذل قصارى جهدنا ثانية اليوم

29
00:03:42,030 --> 00:03:43,080
من هذه؟

30
00:03:44,090 --> 00:03:46,790
ستنضمّ لفريق التّشجيع! ليس تماماً

31
00:03:46,790 --> 00:03:48,920
!لا تضعها في موقف كهذا

32
00:03:49,730 --> 00:03:51,850
...ا-المعذرة

33
00:03:51,850 --> 00:03:55,170
هل تُمانعون أن أتفرّج معكم؟

34
00:03:55,720 --> 00:03:59,000
...إنّها مُباراتي الثّانية فقط، لكن

35
00:03:59,760 --> 00:04:01,740
!نتمنّى أن نضمّكِ

36
00:04:01,740 --> 00:04:04,620
لكن ما زلتِ في يومكِ الثّاني
...بالنّسبة ليوم كهذا

37
00:04:04,620 --> 00:04:09,140
!أعتقد بأنّ المُباراة العاديّة لا تمتلك نفس الوقع

38
00:04:09,140 --> 00:04:11,040
لكن ما الّذي جاء بكِ إلى هنا؟

39
00:04:11,470 --> 00:04:13,130
هذه آلة موسيقيّة، صحيح؟

40
00:04:13,130 --> 00:04:14,570
هل أنتِ في طريق عودتكِ من نادٍ؟

41
00:04:17,780 --> 00:04:21,130
سأعلن الآن عن المُشاركين في المُنافسة

42
00:04:21,130 --> 00:04:22,910
...على البوق

43
00:04:22,910 --> 00:04:26,400
...سوزوكي، أوياما، آيسوغاي

44
00:04:24,930 --> 00:04:25,430
!حاضر

45
00:04:26,400 --> 00:04:27,810
!هذا كلّ شيء

46
00:04:29,620 --> 00:04:34,530
...بدا فقط... أنّكم تستمتعون بتوزيع المناشير فقط

47
00:04:34,530 --> 00:04:35,840
...لذا قلتُ لنفسي

48
00:04:35,840 --> 00:04:38,170
حسناً، أنا آسفة

49
00:04:38,170 --> 00:04:41,160
أعتقد هذا لا يرقى لشرح الأمر

50
00:04:44,800 --> 00:04:47,770
لا بدّ أنّكم قضيتُما أمتع لحظاتكما
في توزيع المناشير

51
00:04:47,770 --> 00:04:49,690
هل كان ذلك مكشوفاً؟

52
00:04:49,690 --> 00:04:51,230
!أعتقد بأنّ هذا صحيح

53
00:04:51,230 --> 00:04:53,100
حسناً، السّبب غير مهمّ

54
00:04:53,100 --> 00:04:54,940
استمتعي فحسب، اتّفقنا؟

55
00:04:56,120 --> 00:04:58,520
شكراً جزيلاً لك

56
00:04:58,900 --> 00:05:02,680
!حسناً، لنجهّز أنفسنا في دقيقة، ثمّ نتدرّب

57
00:05:02,680 --> 00:05:04,240
!حسناً

58
00:05:07,240 --> 00:05:10,660
أعتقد اتّخذتِ قراراً حكيماً بمجيئكِ اليوم

59
00:05:12,570 --> 00:05:16,020
...إن كان هناك ما يُؤرقكِ

60
00:05:16,020 --> 00:05:18,840
أعتقد بأنّ فتياننا سيعالجون الأمر

61
00:05:19,820 --> 00:05:21,590
فتياننا"؟"

62
00:05:23,540 --> 00:05:27,820
وبهذا ننتهي من تشكيلة البداية

63
00:05:31,400 --> 00:05:34,310
...أخبرتُ كوجيرو بأنّني كنتُ أُقيم في المنزل

64
00:05:35,600 --> 00:05:38,600
لكن علينا أن نشهد لحظات
أبي المُهمّة، أليس كذلك؟

65
00:05:42,110 --> 00:05:44,770
...بمعرفتي لميتسوي

66
00:05:44,770 --> 00:05:48,900
...غالباً لن يتقدّم للخطبة ما لم نربح اليوم

67
00:05:49,750 --> 00:05:51,890
!فوزوا أرجوكم! فوزوا أرجوكم

68
00:05:51,890 --> 00:05:56,210
!حريّ بكم أن تدعموه اليوم

69
00:05:59,240 --> 00:06:00,960
ابذلوا قصارى جهدكم

70
00:06:06,340 --> 00:06:09,600
الحرص على قراءة نصّ الرّابح، صحيح؟

71
00:06:11,850 --> 00:06:13,850
!وجبة دجاج مقليّ واحدة

72
00:06:13,850 --> 00:06:15,070
—هذا

73
00:06:15,540 --> 00:06:16,690
ما هذا؟

74
00:06:16,690 --> 00:06:20,140
!أجل، طلبنا عيدان الطّعام بشكل خاصّ اليوم

75
00:06:28,160 --> 00:06:29,310
!حاضرة

76
00:06:32,260 --> 00:06:34,880
يجب أن أتعامل مع هذا كمُجازفة أيضاً

77
00:06:36,480 --> 00:06:38,980
!انظروا إلى هذا الجمهور

78
00:06:38,980 --> 00:06:42,460
كنتُ مُعجباً منذ أيّام اللّون الأرجوانيّ الخاصّ
بتشيبا، ولم أشهد شيئاً كهذا من قبل

79
00:06:42,460 --> 00:06:45,550
!هذا مُؤثّر جدّاً

80
00:06:45,550 --> 00:06:47,020
!هذا جنونيّ

81
00:06:47,020 --> 00:06:49,020
!جنونيّ تماماً

82
00:06:49,020 --> 00:06:50,930
!أجل، بلدة الجنود

83
00:06:52,080 --> 00:06:54,270
أتساءل ما إن كان موراتا هنا اليوم

84
00:07:00,630 --> 00:07:02,470
...من الأفضل أن نلتقط صوراً كثيرة

85
00:07:02,470 --> 00:07:03,860
!لسارة اللّيلة...

86
00:07:03,860 --> 00:07:05,280
!أجل

87
00:07:18,300 --> 00:07:21,370
هل يريد أحدٌ هايبر دراي؟

88
00:07:21,370 --> 00:07:23,140
!روريكو

89
00:07:23,140 --> 00:07:24,400
أريد بيرة

90
00:07:24,400 --> 00:07:27,300
مرحباً يا سيّد! توقّعتُ أن أراك هنا

91
00:07:27,300 --> 00:07:29,170
لأنّه يوم مُميّز

92
00:07:29,170 --> 00:07:31,580
شكراً جزيلاً

93
00:07:31,580 --> 00:07:34,270
!لكن أجل. إنّها الحاسمة

94
00:07:35,360 --> 00:07:41,340
بما أنّ وقت البدء قد اقترب، كنتُ
مُتوتّرة للغاية أيضاً

95
00:07:44,620 --> 00:07:46,430
!ها هُم

96
00:07:46,430 --> 00:07:48,410
!أبطالنا

97
00:07:50,870 --> 00:07:53,830
أخيراً، جاء هذا اليوم

98
00:07:54,190 --> 00:07:56,180
المُباراة الحاسمة، والّتي ستُقرّر

99
00:07:56,180 --> 00:07:59,790
فيما إذا كان تشيبا موتورسانز سيبلغ
!مُبارياته الفاصلة الأولى

100
00:08:00,170 --> 00:08:02,880
!يجب عليه الفوز في هذه حتماً

101
00:08:02,880 --> 00:08:05,660
!إن خسروا، سيضيع الأمل كلّه

102
00:08:05,660 --> 00:08:09,380
!في كلّ الأحوال، سيُحدَّد ذلك اللّيلة

103
00:08:21,960 --> 00:08:24,890
سفي نهاية الشّوط الأوّل بين تشيبا
،موتورسانز وفوكوكا ستيكس

104
00:08:24,890 --> 00:08:26,950
النّتيجة هي صفر لصفر

105
00:08:26,950 --> 00:08:28,900
هذان الفريقان مُتعادلان عند المركز الثّالث

106
00:08:28,900 --> 00:08:30,910
الفريق الّذي يربح سيُواصل
،إلى مجموعة الذّروة

107
00:08:30,910 --> 00:08:34,120
!حيث سينتهي موسم الخاسر اللّيلة

108
00:08:34,390 --> 00:08:39,290
سيّد كوريهارا. بدأ كلا الفريقين بثلاثة
انتصارات وثلاث خسارات

109
00:08:39,290 --> 00:08:43,050
...كاتابيرا من ستيكس وميتسوي من موتورسانز

110
00:08:43,050 --> 00:08:46,670
كلا الرّاميّين يبدوان راسخين

111
00:08:46,670 --> 00:08:48,380
إنّهما يُقاتلان وكأنّ حياتهما على المحكّ بالطّبع

112
00:08:51,140 --> 00:08:52,540
!ميتسوي

113
00:08:54,330 --> 00:08:56,420
!يا بائعة الآلة، أريد بيرة أُخرى

114
00:08:56,420 --> 00:08:58,640
!تـ-تمهّلي

115
00:08:58,640 --> 00:08:59,960
!هذه هي الرّابعة لكِ

116
00:09:01,650 --> 00:09:03,400
إنّه النّصف الأوّل من الشّوط الثّاني

117
00:09:03,400 --> 00:09:04,980
...ستيكس في الضّرب

118
00:09:07,090 --> 00:09:08,890
،الرّابع في الضّرب، لاعب ميدان أوسط

119
00:09:08,890 --> 00:09:10,350
إيرايبا شين

120
00:09:12,190 --> 00:09:17,060
بمُعدّل 355 و 40 هوم ران و 115
...نقطة مُكتسبة بالضّرب

121
00:09:17,750 --> 00:09:21,260
إنّه أحد أفضل الضّاربين في دوري المُحيط
!الهادئ... في اليابان حتّى

122
00:09:22,010 --> 00:09:24,630
كيسا، راقبيني

123
00:09:24,630 --> 00:09:27,220
...أنا... ميتسوي ريتو

124
00:09:27,670 --> 00:09:30,340
!اللّيلة، سوف أصبح رجلاً

125
00:09:30,340 --> 00:09:34,720
...يبدأ ميتسوي برمية استعداديّة

126
00:09:34,720 --> 00:09:35,600
!وها هي ذي

127
00:09:38,820 --> 00:09:41,430
!إنّها إصابة! تبتعد كثيراً

128
00:09:41,430 --> 00:09:43,060
!خرجتْ من هنا

129
00:09:43,370 --> 00:09:46,690
!يتقدّم ستيكس بهوم ران صريحة

130
00:09:47,760 --> 00:09:50,150
يصل أرايبا الّذي لا مُنازع له
!إلى القاعدة الرّئيسيّة

131
00:09:50,150 --> 00:09:52,610
...مـ-ميتسوي

132
00:09:56,060 --> 00:09:58,830
آسف! عرفتُ بأنّه سيكون قويّاً

133
00:09:59,180 --> 00:10:01,590
لكن سأُخرج الشّخص التّالي بالتّأكيد

134
00:10:02,960 --> 00:10:04,810
لا يسعني القول بأنّ هذا لم يكن مُتوقَّعاً

135
00:10:04,810 --> 00:10:05,730
اصمت

136
00:10:05,730 --> 00:10:08,260
الهوم ران الوحيدة خاصّتنا لا تعني شيئاً

137
00:10:08,260 --> 00:10:09,050
!صحيح

138
00:10:10,560 --> 00:10:14,640
...لا أعرف الكثير عن البيسبول

139
00:10:14,970 --> 00:10:18,830
!لكن من الواضح أنّهم شُجعان أكثر من المعتاد

140
00:10:19,600 --> 00:10:23,550
سمحنا لهم بالتقدُّم بنقطة، ثمّ
،أخرجنا الضّاربين الثّلاثة التّاليين

141
00:10:23,550 --> 00:10:25,060
لإنهاء الشّوط

142
00:10:25,470 --> 00:10:31,280
،في النّصف الثّاني من الشّوط الثّاني
حقّق دينيس وبرايان إصابات للوصول إلى القاعدة

143
00:10:31,590 --> 00:10:32,770
...ثمّ

144
00:10:37,280 --> 00:10:41,080
قلبَ كوجيرو الأمور بهوم ران ثلاثيّة النّقاط

145
00:10:43,310 --> 00:10:44,510
!يتحقّق هذا

146
00:10:44,510 --> 00:10:46,630
!قد نتمكّن من فعلها

147
00:10:47,230 --> 00:10:52,140
لكن في الأشواط الثّلاثة التّالية، يُوصل
،موتورسانز لاعبين إلى القاعدة في كلّ مرّة

148
00:10:52,140 --> 00:10:54,340
...لكن فشلوا في إضافة شيء إلى النّتيجة

149
00:10:54,920 --> 00:10:58,180
بينما أرايبا من ستيكس يُحرز الهوم
ران الثّانية له في الخامس

150
00:10:58,180 --> 00:11:00,350
لإضافة نقطة أُخرى إلى اللّائحة

151
00:11:00,860 --> 00:11:06,810
بدأ الشّوط السّادس بحفاظنا على تقدُّم
بسيط جدّاً، 3 إلى 2

152
00:11:06,810 --> 00:11:09,590
!حسناً! لنُقصِهم بالدّفاع

153
00:11:10,000 --> 00:11:12,750
!برايان! أريدك أن تُشجّعنا

154
00:11:12,750 --> 00:11:13,880
!طب يومك

155
00:11:13,880 --> 00:11:15,200
!واظبوا على الدّفاع

156
00:11:19,640 --> 00:11:20,770
شيشيو؟

157
00:11:21,620 --> 00:11:23,230
ما الأمر؟ هيّا بنا

158
00:11:23,230 --> 00:11:25,260
حسناً. قادم

159
00:11:26,250 --> 00:11:29,330
،إنّه النّصف الأوّل من الشّوط السّادس
خروج واحد، ولاعب في القاعدة

160
00:11:29,330 --> 00:11:31,210
ما الإستراتيجية الّتي سيُسخّرها ثنائي
الرّامي والماسِك؟

161
00:11:31,210 --> 00:11:33,570
ظلّ ميتسوي صامداً حتّى الآن

162
00:11:33,570 --> 00:11:36,050
وكاواماتسو يحكم على الرّميات
بشكل صحيح أيضاً

163
00:11:36,050 --> 00:11:39,440
كان موتورسانز يتلقّى انتقادات
،على الرّمي السيّئ في الماضي

164
00:11:39,440 --> 00:11:42,350
لكن قطعوا شوطاً طويلاً بالطّبع

165
00:11:45,030 --> 00:11:46,090
!التِحام

166
00:11:46,090 --> 00:11:47,710
هل يستطيعون تحقيق لعِب مُزدوج؟

167
00:11:47,710 --> 00:11:49,860
يقذف إتشينوميا نحو شيشيو
!لتحقيق الخروج الثّاني

168
00:11:51,040 --> 00:11:52,480
—الرّمية نحو الأوّل

169
00:11:55,010 --> 00:11:58,150
!يا للهول! رمية جامحة نادرة بواسطة شيشيو

170
00:12:00,960 --> 00:12:02,620
!يتوجّه الضّارب نحو الثّانية

171
00:12:02,620 --> 00:12:05,410
!لكن كان الماسِك هناك لتغطية الرّمية

172
00:12:05,410 --> 00:12:07,370
!كاواماتسو! تغطية جيّدة

173
00:12:09,000 --> 00:12:09,900
!لمس

174
00:12:09,900 --> 00:12:12,180
!خرَج، لعِب مزدوج

175
00:12:12,180 --> 00:12:14,680
!كاواماتسو هو حقّاً نجم هذا الفريق

176
00:12:14,680 --> 00:12:17,150
!يبدو كرجل يؤدّي عمله

177
00:12:17,150 --> 00:12:18,880
!يا له من حضور مُتواضع

178
00:12:27,400 --> 00:12:30,060
!أجل، تلك هي الفتاة من اليوم الماطِر

179
00:12:35,720 --> 00:12:39,140
يصدح صوت الجمهور كزلزال

180
00:12:39,140 --> 00:12:41,820
كان وكأنّ الملعب بأكمله جسد واحد

181
00:12:42,380 --> 00:12:45,490
إذا واظبنا على هذا، فسوف تتحقّق أُمنيتنا

182
00:12:45,490 --> 00:12:47,350
!سنصل إلى المُباريات النّهائيّة

183
00:12:49,150 --> 00:12:52,250
النّصف الأوّل من الشّوط السّابع. خروج
واحد وراكضين في القاعدة الثّانية والثّالثة

184
00:12:52,250 --> 00:12:55,850
دور ضارب الضّربات القويّة روبّونماتسو من ستيكس

185
00:12:55,850 --> 00:13:00,720
بنتيجة 3 إلى 2، إصابة متينة واحدة
ستوصل ستيكس إلى المُقدّمة

186
00:13:00,720 --> 00:13:03,400
!مـ-ميتسوي! غانباتّي

187
00:13:03,400 --> 00:13:05,930
!لا تقلق! ما زلتَ تبلي حسناً

188
00:13:06,270 --> 00:13:08,430
اخرج إلى هناك وأرِهم يا ميتسوي

189
00:13:11,730 --> 00:13:13,710
!والآن، هيّا بنا

190
00:13:15,010 --> 00:13:17,800
!ندخل الثّلث الأخير بأجواء التّعادُل

191
00:13:23,440 --> 00:13:25,140
فوز يقودنا إلى المُباريات النّهائيّة

192
00:13:25,140 --> 00:13:26,880
الفوز يسمح لي بالتقدُّم للخطبة

193
00:13:26,880 --> 00:13:28,420
فوز يقودنا إلى المُباريات النّهائيّة

194
00:13:28,420 --> 00:13:30,000
...فوز يسمح لي بالتقدُّم للخطبة

195
00:13:30,290 --> 00:13:33,310
!ويوصلني إلى فوزي المُزدوج الأوّل

196
00:13:38,250 --> 00:13:39,510
!لقد أصاب الكُرة

197
00:13:39,510 --> 00:13:40,640
!إنّها مُتوجّهة نحو لاعب الارتكاز

198
00:13:40,640 --> 00:13:41,840
!شيشيو مُقبل إليها

199
00:13:41,840 --> 00:13:43,590
!لا داعي للقلق! سيفعلها شيشيو

200
00:13:47,020 --> 00:13:48,250
!لا يصل إليها

201
00:13:48,250 --> 00:13:49,430
!لقد مرّتْ

202
00:13:49,430 --> 00:13:51,100
يصل الرّاكض من القاعدة الثّالثة
!إلى الرّئيسيّة

203
00:13:51,100 --> 00:13:53,410
!وكذلك الرّاكض من القاعدة الثّانية

204
00:13:53,890 --> 00:13:56,270
!إنّها 3-4! يستعيد ستيكس الصّدارة

205
00:13:57,400 --> 00:14:00,060
لماذا فكّرتُ في ذلك؟

206
00:14:00,060 --> 00:14:02,800
!لماذا كنتُ أفكّر بإحصائيّات فوزي فقط؟

207
00:14:05,380 --> 00:14:06,480
...ميتسوي

208
00:14:06,480 --> 00:14:09,680
!انظروا إلى هذا! ميتسوي عاجز تماماً

209
00:14:10,120 --> 00:14:12,070
!أخرجوا هذا الفاشل من هناك

210
00:14:12,070 --> 00:14:15,460
قُضي علينا. انتهت المُباراة

211
00:14:18,000 --> 00:14:19,480
لنُغادر فحسب

212
00:14:20,780 --> 00:14:24,140
!لا تشعر بالإحباط! انظر أمامك

213
00:14:24,720 --> 00:14:27,100
!لم ينتهِ الأمر بعد

214
00:14:27,100 --> 00:14:29,920
!ميتسوي! لا تدع الأمر يؤرقك

215
00:14:29,920 --> 00:14:32,260
!كان ذلك مجرّد حظّ سيّئ

216
00:14:32,260 --> 00:14:33,690
!غالباً

217
00:14:34,020 --> 00:14:35,350
بائعة الآلة؟

218
00:14:35,350 --> 00:14:37,330
ر-روريكو؟

219
00:14:37,330 --> 00:14:38,460
!روريكو

220
00:14:38,460 --> 00:14:39,270
...إنّها

221
00:14:39,270 --> 00:14:41,510
!بائعة الآلة تلك مُحقّة

222
00:14:41,510 --> 00:14:43,230
!لم ينتهِ الأمر بعد

223
00:14:43,230 --> 00:14:44,890
!أجل، هذا صحيح

224
00:14:44,890 --> 00:14:46,780
!روريكو على حقّ

225
00:14:46,780 --> 00:14:48,740
!تمالك نفسك

226
00:14:48,740 --> 00:14:50,500
!شدّ عزمك يا ميتسوي

227
00:14:50,500 --> 00:14:53,490
!نحن معك! يمكنك فعلها

228
00:14:53,490 --> 00:14:55,710
!أحسنت الرّمي يا ميتسوي

229
00:14:55,710 --> 00:14:57,140
!انخرط في أجواء اللّعبة

230
00:14:57,140 --> 00:14:58,920
!اصمد يا ميتسوي

231
00:14:58,920 --> 00:15:00,510
!لم تنتهِ المُباراة بعد

232
00:15:00,510 --> 00:15:03,080
!أرِهم ما الّذي يستطيع موتورسانز فعله

233
00:15:03,080 --> 00:15:06,610
!أوصلنا إلى المُباريات النّهائيّة يا ميتسوي

234
00:15:09,470 --> 00:15:13,900
في ذلك اليوم، صرختُ بصوتٍ
أعلى من أيّ وقت سبق

235
00:15:13,900 --> 00:15:19,270
لم يكن أحد يعلم بأنّ أمواج أعتى
!حتّى ما زالت قادمة

236
00:15:21,400 --> 00:15:22,740
!لم ينتهِ الأمر

237
00:15:22,740 --> 00:15:23,910
!لا تستسلموا

238
00:15:23,910 --> 00:15:25,570
!هناك المزيد من البيسبول

239
00:15:25,570 --> 00:15:29,320
،إنّه النّصف الأوّل من الشّوط السّابع
!والأجواء تزداد لهيباً

240
00:15:29,590 --> 00:15:33,450
إصابة مُؤاتية بواسطة روبّونماتسو تضع
ستيكس في المُقدّمة بنتيجة 3-4

241
00:15:33,450 --> 00:15:37,770
!يريد فريق موتورسانز تجنُّب مزيد من الأضرار

242
00:15:37,770 --> 00:15:40,250
!وهناك حركة في الدكّة

243
00:15:40,740 --> 00:15:43,730
بديل للرّامي، ميتسوي

244
00:15:43,730 --> 00:15:47,220
نانامي، رقم القميص 54

245
00:15:49,990 --> 00:15:51,100
!ميتسوي

246
00:15:51,370 --> 00:15:53,060
!أبليت بلاء حسناً يا ميتسوي

247
00:15:53,060 --> 00:15:54,600
!كانت رمية ممتازة

248
00:15:54,870 --> 00:15:56,490
!ميتسوي

249
00:15:56,490 --> 00:15:58,570
!بدوت رائعاً

250
00:15:58,570 --> 00:16:01,360
!أحبّك يا ميتسوي

251
00:16:01,360 --> 00:16:03,110
...ميتسوي

252
00:16:03,530 --> 00:16:06,240
:بديلاً للاعب الارتكاز، شيشيو

253
00:16:06,240 --> 00:16:07,490
موري

254
00:16:10,840 --> 00:16:12,160
شيشيو؟

255
00:16:16,410 --> 00:16:18,850
!أنت... أُصيبَتْ قدمك

256
00:16:18,850 --> 00:16:19,820
هل كان ذلك في تلك المُباراة؟

257
00:16:19,820 --> 00:16:20,880
واتارو

258
00:16:21,910 --> 00:16:24,340
آسف. يبدو أنّني سأخرج أيضاً

259
00:16:26,190 --> 00:16:27,570
تولّ الباقي

260
00:16:32,510 --> 00:16:34,500
!تبّاً لك يا شيشيو

261
00:16:34,500 --> 00:16:37,280
...تدّعي الصّلابة حتّى أمامي

262
00:16:37,780 --> 00:16:38,980
أيّها الوغد

263
00:16:39,420 --> 00:16:41,690
ماذا؟ هل خرج شيشيو الآن؟

264
00:16:41,690 --> 00:16:43,030
هل تعرّض لإصابة؟

265
00:16:43,030 --> 00:16:44,980
!مُحال أن نتمكّن من الفوز الآن

266
00:16:48,730 --> 00:16:53,100
خمسة من مُبارياتنا في هذا العام عدنا فيها
مُنتصرين في الشّوط الثّامن أو بعد

267
00:16:53,100 --> 00:16:55,430
اثنتان منها كانت ضدّ ستيكس

268
00:16:55,430 --> 00:16:58,130
!لا مُشكلة. ستكون الأمور على ما يُرام

269
00:17:04,520 --> 00:17:05,920
!ر-روريكو

270
00:17:06,590 --> 00:17:08,130
نـ-نعم؟

271
00:17:09,310 --> 00:17:11,270
!بيرة من فضلكِ

272
00:17:13,930 --> 00:17:15,000
!حسناً

273
00:17:18,260 --> 00:17:22,260
الرّامي البديل نانامي أخرج
،كلّاً من أرايبا وكروسبي

274
00:17:22,260 --> 00:17:26,420
واجتاز موتورسانز الشّوط السّابع
مُتخلّفاً بنقطة واحدة

275
00:17:26,930 --> 00:17:32,030
لكن لم يتمكّن من الإحراز في الشّوطين السّابع
...أو الثّامن، وفي النّهاية

276
00:17:32,820 --> 00:17:34,540
!خروج لياغينو

277
00:17:34,540 --> 00:17:35,610
!تبّاً

278
00:17:35,610 --> 00:17:36,960
إنّه النّصف الثّاني من الشّوط التّاسع

279
00:17:36,960 --> 00:17:38,730
خرج ياغينو

280
00:17:38,730 --> 00:17:40,500
خروج واحد، ولا أحد في القاعدة

281
00:17:40,500 --> 00:17:43,740
!موتورسانز على حافّة الإقصاء

282
00:17:44,080 --> 00:17:46,220
!من فضلكم! افعلوا شيئاً

283
00:17:46,220 --> 00:17:48,170
!أتوسّل إليكم

284
00:18:01,780 --> 00:18:05,150
هل يستطيع إيشيمارو، رجل اللّحظات
النّهائيّة الحاسمة لستيكس، من فعل شيء؟

285
00:18:05,150 --> 00:18:07,770
!يريد نوكوغيرياما حقّاً أن يصل إلى القاعدة

286
00:18:08,650 --> 00:18:11,840
!...الاستعداد، والرّمية الأولى

287
00:18:11,840 --> 00:18:12,940
!إنّها إصابة

288
00:18:14,550 --> 00:18:16,180
!كسرَ العصا

289
00:18:16,180 --> 00:18:17,950
!يضربها مُنخفضة نحو الميدان الأيسر

290
00:18:18,650 --> 00:18:22,250
إصابة نوكوغيرياما الحازمة تضع
!راكضاً في القاعدة الأولى

291
00:18:25,580 --> 00:18:28,590
والآن، هل يستطيع موتورسانز
الحفاظ على الزّخم؟

292
00:18:29,000 --> 00:18:30,880
!ينزلق دينيس

293
00:18:30,880 --> 00:18:31,920
!أمان

294
00:18:32,180 --> 00:18:33,520
!كُرة أربع مرّات

295
00:18:33,520 --> 00:18:34,720
!برايان يتقدّم أيضاً

296
00:18:34,720 --> 00:18:37,050
!خروج واحد وقواعد مُمتلئة

297
00:18:37,050 --> 00:18:38,940
!ا-القواعد مُمتلئة

298
00:18:39,750 --> 00:18:42,100
!يتحقّق... يتحقّق هذا فعلاً

299
00:18:42,100 --> 00:18:43,980
!سترايك ثلاث مرّات

300
00:18:43,980 --> 00:18:46,480
!سترايك لتاكادا في الحفرة 6

301
00:18:46,790 --> 00:18:48,530
!هذا فظيع

302
00:18:48,530 --> 00:18:50,940
...لا، لا مُشكلة! الضّارب التّالي هو

303
00:18:50,940 --> 00:18:53,370
،في النّصف الثّاني من الشّوط التّاسع
!القواعد مُمتلئة

304
00:18:53,370 --> 00:18:57,640
اللّحظة الأكثر تأثيراً في المُباراة
!قد امتدّت للشّوط الأخير

305
00:18:57,640 --> 00:19:01,870
يصل إلى القاعدة الرّئيسيّة الرّجل الّذي حقّق هوم ران
ثلاثيّة النّقاط في النّصف الثّاني من الشّوط الثّاني

306
00:19:02,330 --> 00:19:05,830
يضرب سابعاً، لاعب الميدان الأيمن، كوجيرو

307
00:19:08,030 --> 00:19:09,570
كوجيرو ضدّ إيشيمارو

308
00:19:09,570 --> 00:19:11,370
ماذا سيرمي أوّلاً؟

309
00:19:15,630 --> 00:19:17,040
!سترايك

310
00:19:17,040 --> 00:19:21,930
يُمسك إيشيمارو الكُرة في زاوية داخليّة
!من ضربة قاطعة ذات 150 كم\سا

311
00:19:25,330 --> 00:19:27,200
أي إصابة جيّدة ستؤدّي إلى فوز بالإنهاء

312
00:19:27,200 --> 00:19:30,480
!الخروج يُنهي موسم موتورسانز

313
00:19:30,760 --> 00:19:32,080
يومئ الرّامي برأسه

314
00:19:32,080 --> 00:19:33,780
!تروقه تلك الإشارة

315
00:19:38,770 --> 00:19:40,820
...بعد توقُّف طويل، يرمي

316
00:19:42,940 --> 00:19:45,020
!الرّمية الثّانية

317
00:19:45,500 --> 00:19:46,740
!إنّها إصابة

318
00:19:46,740 --> 00:19:49,290
!اسمعوا قرقعة المضرب

319
00:20:12,110 --> 00:20:15,900
كـ-كرة خطّية منخفضة نحو الرّامي؟

320
00:20:23,210 --> 00:20:25,810
!انتهت هذه المُباراة

321
00:20:25,810 --> 00:20:29,250
!الرّابح هو فوكوكا ستيكس

322
00:20:29,250 --> 00:20:32,130
!سيتأهّل ستيكس إلى المُباريات النّهائيّة

323
00:20:32,130 --> 00:20:38,400
!يُفوّت موتورسانز سباقه الأوّل لما بعد الموسم

324
00:20:40,130 --> 00:20:42,890
!هذه... هذه غلطتي

325
00:20:42,890 --> 00:20:46,270
أنا آسف. أنا آسف جميعاً

326
00:20:46,270 --> 00:20:47,840
...ميتسوي

327
00:20:47,840 --> 00:20:49,660
هذه ليست غلطتك

328
00:20:49,660 --> 00:20:52,730
لم أدعمك بمضربي إطلاقاً

329
00:20:54,700 --> 00:20:57,490
كوجيرو. هل أنت بخير؟

330
00:20:59,670 --> 00:21:02,080
أجل. أنا بخير

331
00:21:05,190 --> 00:21:08,260
آسف. كنتُ قائداً عديم القيمة

332
00:21:10,620 --> 00:21:12,080
دينيس

333
00:21:12,080 --> 00:21:13,860
—لماذا توقّفـ

334
00:21:17,480 --> 00:21:20,340
!الجميع. اخرجوا إلى هنا حالاً

335
00:21:28,210 --> 00:21:29,560
...هـ-هذا

336
00:21:29,560 --> 00:21:30,810
مُذهل

337
00:21:31,120 --> 00:21:33,570
!شكراً لكم يا موتورسانز

338
00:21:33,570 --> 00:21:37,440
!كوجيرو! أمتعتنا كثيراً

339
00:21:37,440 --> 00:21:40,200
!شيشيو! بذلت جهداً طيّباً

340
00:21:40,200 --> 00:21:44,290
أوصلنا إلى مجموعة الذّروة في العام
!المُقبل بكلّ تأكيد

341
00:21:47,570 --> 00:21:52,460
...الملعب مكان مُؤلم وقاسٍ

342
00:21:53,530 --> 00:21:56,960
أنا مُحاط ببالغين يجهشون بالبكاء

343
00:21:58,250 --> 00:22:01,260
،ما زلتُ لا أعرف قواعد البيسبول جيّداً

344
00:22:02,680 --> 00:22:04,700
...لكن اليوم، أعتقد

345
00:22:06,030 --> 00:22:09,670
!بأنّني أحبّ هذا المكان أكثر من أيّ وقت سبق