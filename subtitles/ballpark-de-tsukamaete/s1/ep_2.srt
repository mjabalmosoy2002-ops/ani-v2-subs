1
00:01:37,390 --> 00:01:39,740
اسمي تاكينو يوكي

2
00:01:39,740 --> 00:01:41,980
بالرّغم من ظهري، كنتُ مُذيعة تلفزيونيّة

3
00:01:42,990 --> 00:01:45,130
أستقلّ قطار خطّ كيو على السّاعة 5 مساء

4
00:01:45,940 --> 00:01:48,210
أنا مُمتعضة

5
00:01:49,070 --> 00:01:51,640
في الواقع، كلّما اقترب القطار
،من كايهين-ماكوهاري

6
00:01:51,640 --> 00:01:55,610
امتلأ أكثر بأشخاص أكرههم

7
00:01:56,550 --> 00:01:59,460
يرتدون قُبّعاتهم وملابسهم الرّسميّة

8
00:02:00,060 --> 00:02:03,060
وأدوات التّشجيع بارزة من حقائبهم

9
00:02:07,150 --> 00:02:10,070
!توقّعتُ هذا! إنّه إيقاع التّشجيع

10
00:02:16,640 --> 00:02:19,620
!أنا مُحاطة بمُعجبي البيسبول

11
00:02:19,620 --> 00:02:21,330
!هذا مُغيظ

12
00:02:24,690 --> 00:02:28,450
وضعيّة إيواكاوا الجديدة في الرّمي
تُؤتي أُكُلها

13
00:02:28,450 --> 00:02:31,070
...ثلاثة هـ.كيو.س مُتتالية

14
00:02:32,280 --> 00:02:33,840
ماذا يعني هـ.كيو.س؟

15
00:02:35,220 --> 00:02:37,040
!حتّى تلك الغيارو؟

16
00:02:39,100 --> 00:02:43,440
أيّ شخص صغير في السنّ يقرأ
!صحيفة رياضيّة في قطار؟

17
00:02:43,440 --> 00:02:45,950
!لهذا أكره مُعجبي البيسبول

18
00:02:46,560 --> 00:02:50,680
المحطّة التّالية، كايهين-ماكوهاري. كايهين-ماكوهاري

19
00:02:50,680 --> 00:02:52,940
ستُفتح الأبواب في الجانب الأيمن

20
00:02:53,890 --> 00:02:55,150
...رغم ذلك

21
00:02:55,500 --> 00:02:59,150
أنا ذاهبة إلى الملعب أيضاً

22
00:03:01,020 --> 00:03:04,660
لكن لديّ سبب لذلك

23
00:03:06,070 --> 00:03:07,700
...ارتداء القميص رقم واحد

24
00:03:08,130 --> 00:03:10,470
لباس كوجيرو الرّسميّ

25
00:03:12,420 --> 00:03:14,490
!شيشيو

26
00:03:14,490 --> 00:03:16,380
!هيّا

27
00:03:18,220 --> 00:03:19,640
بئس الأمر

28
00:03:20,550 --> 00:03:24,110
النّساء الصّغيرات في أيّامنا هذه
جميعهن مهتمّات بشيشيو

29
00:03:24,480 --> 00:03:28,380
في حين أنّ كوجيرو الأعزّ على قلبي
!لا يحظى باهتمام نسائيّ

30
00:03:31,400 --> 00:03:33,780
ما هي طلباتكم؟

31
00:03:33,780 --> 00:03:36,900
ما رأيكم بهايبر دراي؟

32
00:03:39,900 --> 00:03:41,790
سأطلب بيرة

33
00:03:41,790 --> 00:03:43,200
!المعذرة

34
00:03:45,020 --> 00:03:46,160
!شكراً

35
00:03:47,280 --> 00:03:49,580
الغيارو الّتي كانت تقرأ تلك
الصّحيفة الرّياضيّة؟

36
00:03:49,580 --> 00:03:51,630
!إنّها بائعة آلة هنا؟

37
00:03:54,110 --> 00:03:56,620
!أعلم هذا اللّباس الرّسميّ! إنّه لكوجيرو

38
00:03:57,410 --> 00:04:01,900
ا-المعذرة... هل تحبّين كوجيرو؟

39
00:04:02,320 --> 00:04:04,580
إنّه لاعب جيّد، أليس كذلك؟

40
00:04:05,060 --> 00:04:06,250
سأطلب بيرة

41
00:04:06,250 --> 00:04:07,390
!شكراً

42
00:04:07,390 --> 00:04:11,680
قلّما أرى من النّساء الصّغيرات
يرتدين لباس كوجيرو

43
00:04:11,680 --> 00:04:13,640
!أنتِ نوع نادر حقّاً

44
00:04:15,920 --> 00:04:18,660
!لا انجذاب نسائي إطلاقاً

45
00:04:18,660 --> 00:04:21,160
...رغم أنّني أقدّر أن أُدعَى بامرأة صغيرة

46
00:04:26,660 --> 00:04:29,860
تسألون عن سبب تركيزي على كوجيرو؟

47
00:04:32,800 --> 00:04:37,670
عن سبب مجيئي إلى ملعب البيسبول
بالرّغم من كرهي الشّديد له؟

48
00:04:38,420 --> 00:04:40,630
...السّبب هو

49
00:04:40,900 --> 00:04:44,380
السّابع في اضّرب: لاعب ميدان أيمن، كوجيرو

50
00:04:44,380 --> 00:04:46,300
الزي الرّسميّ رقم واحد

51
00:04:47,070 --> 00:04:49,580
!لأنّني زوجته

52
00:04:50,860 --> 00:04:54,300
لا أريد أن أسمع بأنّه تعثّر في تحقيق
!ضربات بسبب زواجه

53
00:04:57,150 --> 00:04:58,990
خروجان، وراكض في القاعدتين الأولى والثّالثة

54
00:04:58,990 --> 00:05:01,140
!إنّه وقت مُثير بالنّسبة لضارب الكُرة

55
00:05:03,370 --> 00:05:05,400
تبّاً. هل من داعٍ ليكون كوجيرو؟

56
00:05:05,400 --> 00:05:07,370
!أدخلوا ضارباً بديلاً

57
00:05:07,370 --> 00:05:11,750
!لن نحرز أي نقطة مع ذلك الفاشل

58
00:05:11,750 --> 00:05:14,760
لماذا يستمرّون في إدخال ذلك الكهل؟

59
00:05:14,760 --> 00:05:17,590
!عمره 35 سنة، تبّاً

60
00:05:17,590 --> 00:05:20,680
في دور الضّرب السّابق له أرسل
!الكُرة بعيداً نحو اليمين بشكل بائس

61
00:05:20,680 --> 00:05:22,590
!يجب عليه أن يتماسك

62
00:05:22,590 --> 00:05:26,350
!لهذا أكره مُعجبي البيسبول

63
00:05:26,730 --> 00:05:29,470
!إنّه يقف عقبة في وجه روح الشّباب

64
00:05:29,470 --> 00:05:31,970
!ربّما سيغادر بعد هذا العام

65
00:05:31,970 --> 00:05:34,400
ليس وكأنّ فريقاً آخر سوف يضمّه

66
00:05:34,400 --> 00:05:37,010
لكن هل يستطيع حتّى أن يعيش إذا تقاعد؟

67
00:05:37,010 --> 00:05:38,260
!وجهة نظر سديدة

68
00:05:41,740 --> 00:05:43,740
!لم أعُد قادرة على التحمُّل

69
00:05:44,270 --> 00:05:47,170
!أيّها النّاقدون المُنظِّرون

70
00:05:47,170 --> 00:05:51,550
ألا يبحث المُعجب الحقيقيّ عن
!الخِصال الجيّدة للّاعب؟

71
00:05:53,100 --> 00:05:58,590
!كنتَ تتكلّم بكلام فارغ طوال هذا الوقت
!سمعتُك أيّها الوغد

72
00:05:58,590 --> 00:06:02,530
ما-ما مُشكلتك؟ ما قلتُه صحيح، أليس كذلك؟

73
00:06:04,010 --> 00:06:09,780
إذاً أما كان المُعجب الحقيقيّ أن
!يُصفّق من أجل دعمه؟

74
00:06:11,270 --> 00:06:15,120
!أيّتها البائعة! توافقينني، أليس كذلك؟

75
00:06:16,940 --> 00:06:19,950
ماذا؟ أنا؟

76
00:06:19,950 --> 00:06:21,710
...المعذرة

77
00:06:26,610 --> 00:06:30,370
!+كوجيرو يحقّق 120 دبليو.آر.سي

78
00:06:31,560 --> 00:06:33,500
ماذا؟ ما هذا؟

79
00:06:33,810 --> 00:06:35,810
...يعني

80
00:06:36,860 --> 00:06:39,870
!ما زال لدى كوجيرو فُرصة

81
00:06:46,090 --> 00:06:48,720
كوجيرو يحقّق ضربة مُتفجّرة
!ناجحة ذات ثلاث نقاط

82
00:06:48,720 --> 00:06:50,970
!مرحى

83
00:06:50,970 --> 00:06:52,520
!فعلَها حقّاً

84
00:06:52,520 --> 00:06:54,610
!لا أصدّق ذلك

85
00:06:55,000 --> 00:06:56,680
!مُبهر

86
00:06:56,680 --> 00:06:59,940
!كوجيرو

87
00:07:06,740 --> 00:07:08,750
آسفة لإقحامك في هذا

88
00:07:08,750 --> 00:07:10,880
هل يمكنني شراء بيرة أخرى لتعويضكِ؟

89
00:07:12,110 --> 00:07:14,380
...لا ضرورة لذلك حقّاً

90
00:07:14,380 --> 00:07:16,060
!سأشتري منكِ أيضاً

91
00:07:16,060 --> 00:07:17,350
!أنا أيضاً

92
00:07:17,350 --> 00:07:20,390
!بئساً، شكراً

93
00:07:21,400 --> 00:07:23,010
...لكن

94
00:07:23,510 --> 00:07:25,510
!حسناً، ها نحن أولاء

95
00:07:25,510 --> 00:07:28,540
اللّاعب المُخضرم الّذي لديه أكثر
!من 200 هوم ران في مسيرته

96
00:07:28,540 --> 00:07:31,870
!+وهو يُحقّق حاليّاً 120 دبليو.آر.سي

97
00:07:33,730 --> 00:07:37,550
ماذا يعني دبليو.آر.سي+ بالضّبط؟

98
00:07:44,150 --> 00:07:45,740
أنت على وشك الاستحمام؟

99
00:07:46,400 --> 00:07:48,580
آسفة لاتّصالي بك أثناء انشغالك

100
00:07:49,580 --> 00:07:51,470
!أجل، رأيت

101
00:07:51,470 --> 00:07:54,840
!+لا عجب في أنّ لديك 120 دبليو.آر.سي

102
00:07:54,840 --> 00:07:58,470
!ماذا؟ لا أعلم حقّاً، لكن كنتَ مُذهلاً

103
00:07:59,570 --> 00:08:02,760
أحسنت صنعاً اليوم! بالتّوفيق لك
!في الطّريق إلى المنزل

104
00:08:05,760 --> 00:08:10,130
،عندما كنتُ أجلس في مقاعد الشّخصيّات الهامّة
فالأمر يبدو مُحرجاً عندما لا يُحقّق كوجيرو ضربة

105
00:08:10,130 --> 00:08:12,840
لذا قرّرتُ تجربة الجلوس في المقاعد العاديّة
لأوّل مرّة منذ مدّة طويلة

106
00:08:20,130 --> 00:08:24,860
أعتقد لا ضير من إجراء تغييرات
بين الفيّنة والأُخرى

107
00:08:34,450 --> 00:08:37,540
أراكِ هنا يا روريكو! أتقرئين صحيفة رياضيّة؟

108
00:08:38,070 --> 00:08:41,210
!سيّد ناكايزومي. شكراً لعملك اليوم

109
00:08:41,680 --> 00:08:45,070
من المُهمّ للبائع أن يتعرّف على الرّياضة

110
00:08:45,070 --> 00:08:47,380
هل من قصص طريفة اليوم؟

111
00:08:49,470 --> 00:08:52,550
!أجل! كانت هذه طريفة حقّاً

112
00:08:53,420 --> 00:08:57,310
اكتشفتُ كيف أحرز 100 نقطة"
"!في ثلاثة أشواط

113
00:08:57,310 --> 00:09:00,860
أحرز هوم ران في النّصف"
"!الثّاني من الشّوط الأوّل

114
00:09:00,860 --> 00:09:04,820
ثمّ الأشواط واحد واثنان وثلاثة"
"!في الثّاني والثّالث! خروج

115
00:09:05,240 --> 00:09:08,680
"!أترى؟ مكتوب 100! لكنّك تخسر"

116
00:09:12,810 --> 00:09:15,200
!هذه مجرّد رسوم هزليّة

117
00:09:16,790 --> 00:09:19,480
البيسبول صعبة

118
00:09:30,410 --> 00:09:33,930
سينباي! هل تمانعون
أن أطلب مشورة ما؟

119
00:09:34,350 --> 00:09:39,300
ما زلتُ لا أعرف ماذا أفعل
عندما يحاول زبون مُغازلتي

120
00:09:39,300 --> 00:09:42,730
ماذا تفعلنَ عندما يطلب شخص
معلومات الاتّصال بكن؟

121
00:09:42,730 --> 00:09:44,440
أفهمك

122
00:09:44,440 --> 00:09:46,750
عانيتُ من ذلك في البداية أيضاً

123
00:09:46,750 --> 00:09:49,740
في هذه الأيّام، أحاول تجاهل ذلك فحسب

124
00:09:49,740 --> 00:09:54,030
أعطيهم حسابكِ على نينستا بدلاً من رقمكِ

125
00:09:56,140 --> 00:09:57,990
أليس كذلك يا كوهيناتا؟

126
00:09:57,990 --> 00:09:59,730
...بالفعل

127
00:09:59,730 --> 00:10:04,700
لكن الحصول على حساب بعدد مُتابعين عالٍ
ليس الشّيء المهمّ الوحيد في نينستا

128
00:10:06,080 --> 00:10:09,710
انشري صوراً لوجبات طعام
تناولتِها بين الحين والآخر

129
00:10:10,170 --> 00:10:14,470
هذا سيمنحكِ مواضيع للنّقاش مع
!المُتحمّسين الّذين يتابعونكِ

130
00:10:14,830 --> 00:10:17,080
!ذهبتُ إلى ذلك المطعم الّذي ذكرتِه

131
00:10:17,080 --> 00:10:19,610
أليس الطّعام لذيذاً هناك؟

132
00:10:21,350 --> 00:10:22,600
!مُحترفة

133
00:10:22,600 --> 00:10:24,390
!أنتِ مُذهلة يا كوهيناتا

134
00:10:24,390 --> 00:10:26,120
!أريد أن أكون مثلكِ فحسب

135
00:10:26,690 --> 00:10:29,570
جميعهن يحظين بزبائن يُغازلهن؟

136
00:10:29,570 --> 00:10:34,570
لذا يا أونا، هل بدأتِ تُواعدين المُدقِّق أوماتسو؟

137
00:10:34,570 --> 00:10:37,320
!تساءلتُ حول ذلك أيضاً

138
00:10:38,260 --> 00:10:39,240
كشفتِ الأمر؟

139
00:10:39,240 --> 00:10:42,300
!أجل، أخيراً. كنتُ أنتظر لفترة طويلة

140
00:10:42,300 --> 00:10:44,290
!تهانينا

141
00:10:44,660 --> 00:10:47,210
أنتما لا تتصرّفان بحميميّة معاً أمام العامّة

142
00:10:47,210 --> 00:10:49,370
!لن نفعل ذلك

143
00:10:50,010 --> 00:10:52,420
...لا أحد يُغازلني

144
00:10:54,480 --> 00:10:57,790
هل مررتِ بأي تجربة مع شاب يا روريكو؟

145
00:10:57,790 --> 00:10:58,970
هل أنتِ بخير؟

146
00:11:02,890 --> 00:11:07,350
أجل... هناك شخص يُغازلني مؤخّراً

147
00:11:07,850 --> 00:11:12,230
جميعنا لدينا طُرُق مختلفة لتشجيع النّاس

148
00:11:13,040 --> 00:11:16,240
!أخذني ذلك على حين غرّة

149
00:11:16,590 --> 00:11:19,860
ربّما يجدر بكِ أن تستخدمي النينستا
خاصّتكِ أيضاً

150
00:11:19,860 --> 00:11:21,910
قد أبدأ في القيام بذلك أيضاً

151
00:11:22,720 --> 00:11:24,420
نينستا؟

152
00:11:24,420 --> 00:11:25,710
!أجل، بالطّبع

153
00:11:25,710 --> 00:11:28,490
روريكو، أعطيني معلومات حسابكِ لاحقاً

154
00:11:28,490 --> 00:11:29,730
أجل، وأنا أيضاً

155
00:11:29,730 --> 00:11:30,780
!كذلك أنا

156
00:11:30,780 --> 00:11:32,960
!شاركيها معي من فضلكِ

157
00:11:32,960 --> 00:11:34,850
!بكلّ تأكيد

158
00:11:35,150 --> 00:11:38,220
هل يمكنكن حضور الاجتماع من دوني؟

159
00:11:38,220 --> 00:11:39,810
سأوافيكن بعد قليل

160
00:11:39,810 --> 00:11:40,880
حسناً

161
00:11:50,300 --> 00:11:53,190
كيف أنشئ حساب نينستا؟

162
00:11:53,540 --> 00:11:56,280
...أنا سيّئة جدّاً في هذه الأمور

163
00:12:01,660 --> 00:12:02,990
!ما هذا؟

164
00:12:04,430 --> 00:12:07,960
حسناً، لنبدأ الاجتماع جميعاً

165
00:12:08,350 --> 00:12:11,920
أنا متأكّد بأنّكن سمعتُن الإشاعات
،حول هذا الأمر هنا وهناك

166
00:12:17,880 --> 00:12:25,190
أنا متأكّد بأنّكن تعلمنَ هذا، لكن لا تعطينَ
معلوماتكن الشّخصيّة لزبون

167
00:12:25,190 --> 00:12:29,580
فلا أحد يعلم متى يستغلّ شخصٌ
هذه المعلومات لمُراقبتكن

168
00:12:29,580 --> 00:12:33,680
سنبقى نحن المُدقِّقون يقظين أيضاً

169
00:12:33,680 --> 00:12:37,590
لكن حاولنَ أن تختصرنَ من التّفاعل
مع الزّبون وجعله حياديّاً

170
00:12:38,570 --> 00:12:41,320
!هل تسمعين يا روريكو؟

171
00:12:42,060 --> 00:12:43,550
!أ-أجل

172
00:12:43,550 --> 00:12:46,340
!لا للمعلومات الشّخصيّة! أبداً

173
00:12:47,500 --> 00:12:52,150
!اللّعنة! لم أعرف كيف أنشئ حساباً

174
00:12:52,150 --> 00:12:54,480
...نينستا الغبيّ

175
00:13:00,650 --> 00:13:03,120
!لا شيء يتفوّق على ملعب البيسبول

176
00:13:03,120 --> 00:13:04,960
!لنشرع في العمل

177
00:13:04,960 --> 00:13:08,100
مَن البائعات المُتنقِّلات اللّواتي
سوف نراهُن اللّيلة؟

178
00:13:08,100 --> 00:13:09,710
!أفكّر في المُجازفة اليوم

179
00:13:10,150 --> 00:13:12,480
...ربّما تلك الظّريفة في المرّة السّابقة

180
00:13:13,010 --> 00:13:15,230
...ثُلاثي مُنعدمي الأخلاق

181
00:13:15,230 --> 00:13:16,510
أعتقد هذا ما قصدَه

182
00:13:17,830 --> 00:13:20,990
!أيّتها البائعة المُتنقّلة
!تعالي إلى هنا يا صغيرة

183
00:13:20,990 --> 00:13:22,650
!سنطلب بعض البيرة

184
00:13:22,650 --> 00:13:24,070
!عدد ثلاثة

185
00:13:25,330 --> 00:13:27,870
ثمن البيرة عدد ثلاثة هو 2100 ين

186
00:13:28,800 --> 00:13:30,880
!ويحي، أنتِ جذّابة بعض الشّيء

187
00:13:30,880 --> 00:13:32,060
ما اسمكِ؟

188
00:13:32,750 --> 00:13:34,090
روريكو؟

189
00:13:34,090 --> 00:13:35,650
كم عمركِ يا ظريفة؟

190
00:13:35,650 --> 00:13:37,500
!سوف أصوّركِ بالفيديو

191
00:13:39,290 --> 00:13:42,510
!لا للمعلومات الشّخصيّة! أبداً

192
00:13:42,510 --> 00:13:44,810
حسناً أيّتها الآنسة الصّغيرة روريكو

193
00:13:44,810 --> 00:13:46,760
ما رأيكِ أن تعطيني رقمكِ؟

194
00:13:47,190 --> 00:13:50,490
آسفة. إعطاء الرّقم مُخالف للقوانين

195
00:13:50,490 --> 00:13:52,450
لا. أبداً

196
00:13:53,040 --> 00:13:54,760
أين تقطنين؟

197
00:13:54,760 --> 00:13:56,480
ربّما يمكننا تناول مشروب في وقت لاحق

198
00:13:56,840 --> 00:13:58,570
المدينة

199
00:13:58,570 --> 00:14:00,440
!لا. أبداً

200
00:14:00,820 --> 00:14:02,580
ما هي اهتماماتكِ؟

201
00:14:02,580 --> 00:14:03,570
هل أنتِ في الكلّية؟

202
00:14:04,040 --> 00:14:05,990
ما رأيك؟

203
00:14:05,990 --> 00:14:07,830
!لا! أبداً

204
00:14:07,830 --> 00:14:10,350
تـ-تبدين ناضجة جدّاً

205
00:14:10,350 --> 00:14:12,750
!أنا واثق بأنّ لديكِ أخ أو أخت صغرى

206
00:14:13,070 --> 00:14:16,690
أعتقد لديّ أخ أصغر... أو أخت؟

207
00:14:16,690 --> 00:14:18,310
ربّما... أو ربّما لا؟

208
00:14:18,310 --> 00:14:20,250
!لا! أبداً

209
00:14:20,250 --> 00:14:23,790
!مهلاً، لا تكوني وقائيّة جدّاً

210
00:14:23,790 --> 00:14:25,340
هل لديكِ حبيب؟

211
00:14:25,680 --> 00:14:29,210
أنا وحيدة تماماً في هذا العالم

212
00:14:29,210 --> 00:14:30,970
!لا! أبداً

213
00:14:31,300 --> 00:14:35,190
وحيدة؟ لديكِ عائلة، صحيح؟

214
00:14:35,550 --> 00:14:39,200
أجل، تلقّيتُ مكالمة هاتفيّة
من جدّي يوم أمس

215
00:14:39,200 --> 00:14:41,260
هيدياكي، 65 عاماً

216
00:14:41,260 --> 00:14:43,430
يمكنني إخبارهم بذلك غالباً

217
00:14:44,260 --> 00:14:46,910
...أخبرَتْنا بشيء أخيراً

218
00:14:48,590 --> 00:14:52,390
:معلوماتنا الشّخصيّة الوحيدة حول روريكو
اسم الجدّ، هيدياكي

219
00:14:52,740 --> 00:14:55,110
حسناً، فهمنا

220
00:14:55,110 --> 00:14:58,500
.أعطينا حسابكِ على نينستا على الأقلّ
حينها سوف نكفّ عن سؤالكِ

221
00:14:59,300 --> 00:15:00,590
نينستا؟

222
00:15:01,870 --> 00:15:03,740
...نين... ستا

223
00:15:05,230 --> 00:15:07,180
!نينستا

224
00:15:07,480 --> 00:15:10,950
!لا أعرف كيف أنشئ حساباً، مفهوم؟

225
00:15:10,950 --> 00:15:16,140
ستكونون أوّل مُتابعين لي إذا علّمتموني
!كيفيّة إنشاء حساب لعين

226
00:15:17,750 --> 00:15:18,670
حسناً

227
00:15:18,670 --> 00:15:20,480
...إن أردتِ

228
00:15:20,480 --> 00:15:23,190
أوّلاً، يجب عليكِ تنزيل التّطبيق

229
00:15:23,190 --> 00:15:27,170
هل أرسلوا لكِ رمزاً عندما أدخلتِ
رقم هاتفكِ أو بريدكِ الالكترونيّ؟

230
00:15:27,170 --> 00:15:29,480
!لا أعرف ما الّذي يعنيه هذا الهُراء

231
00:15:29,480 --> 00:15:30,430
!بجدّية؟

232
00:15:30,430 --> 00:15:33,700
...آسف. الرّمز هو

233
00:15:34,750 --> 00:15:38,180
يا لها من شابّة مُثيرة للاهتمام

234
00:15:39,550 --> 00:15:43,550
ملعب البيسبول يخلو من الملل حقّاً

235
00:15:48,970 --> 00:15:51,930
!علّموني كيفيّة إنشاء حساب لعين

236
00:15:53,730 --> 00:15:54,950
اشتهرت

237
00:15:56,020 --> 00:15:58,540
!نينستا! نينستا

238
00:16:02,960 --> 00:16:06,760
قبل عامين، عندما كنتُ في سنتي
،الثّالثة من المرحلة الثّانويّة

239
00:16:06,760 --> 00:16:11,620
أنا، يامادا ناتسونو، أتيتُ إلى
...ملعب البيسبول رفقة صديقة

240
00:16:12,120 --> 00:16:14,730
!ووقعتُ في حُبّ بائعات البيرة بالآلة

241
00:16:14,730 --> 00:16:16,540
هل يريد أحدٌ بيرة؟

242
00:16:16,920 --> 00:16:20,460
...ابتسامتهن المُشرِقة، والزّهور في شعرهن

243
00:16:20,950 --> 00:16:23,010
!ولباسهن الظّريف

244
00:16:23,730 --> 00:16:28,450
كُنّ بمثابة آيدول في نظري

245
00:16:31,900 --> 00:16:33,640
!تفضّل

246
00:16:33,640 --> 00:16:36,040
!وجبة طعام قياسيّة

247
00:16:36,600 --> 00:16:38,650
!شكراً لقدومك

248
00:16:39,420 --> 00:16:47,110
لماذا إذاً أبيع طعاماً بشال يغطّي
شعري بدلاً من زهرة؟

249
00:16:40,660 --> 00:16:42,380
!شكراً لقدومك

250
00:16:47,980 --> 00:16:50,760
تقدّمتُ لعمل بدوام جزئي في ملعب البيسبول

251
00:16:50,760 --> 00:16:52,990
وانتهى المطاف بي بالعمل هنا بطريقة ما

252
00:16:52,990 --> 00:16:55,020
!حسناً، سنراكِ في أوّل يوم لكِ غداً

253
00:16:57,990 --> 00:17:00,810
أين كان الخطأ بالضّبط؟

254
00:17:05,180 --> 00:17:06,720
...بائعة آلة

255
00:17:07,810 --> 00:17:11,210
...ليتني أستطيع ارتداء لباسهن الرّسميّ

256
00:17:12,180 --> 00:17:15,800
!أ-أريد إظهار ساقَي أيضاً

257
00:17:15,800 --> 00:17:18,150
...ساقاي... ساقاي

258
00:17:18,150 --> 00:17:20,890
!إنّهما جميلتان، أليس كذلك؟

259
00:17:21,800 --> 00:17:25,060
!كيف انتهى المطاف بي هنا؟

260
00:17:25,060 --> 00:17:28,170
المعذرة... وجبة حجم كبير فائقة من فضلك

261
00:17:28,650 --> 00:17:30,590
!شكراً لقدومك

262
00:17:30,590 --> 00:17:32,380
!حجم كبير فائقة

263
00:17:32,910 --> 00:17:36,070
!ماذا أفعل؟

264
00:17:36,070 --> 00:17:37,770
يخنة كِرش من فضلك

265
00:17:38,370 --> 00:17:41,330
!يخنة كِرش من فضلك! تفضّلي

266
00:17:41,580 --> 00:17:44,870
!مصير قاسٍ

267
00:17:44,870 --> 00:17:47,300
!وجبة نوري واحدة من فضلك

268
00:17:47,300 --> 00:17:49,350
!أجل، وجبة نوري واحدة

269
00:17:49,350 --> 00:17:52,010
!ومجموعتان من عيدان الطّعام

270
00:17:52,590 --> 00:17:56,310
!ثـ-ثلاثمئة ين الفكّة خاصّتك

271
00:17:57,550 --> 00:18:05,520
مضى عامان دون أن يرى أحدٌ ساقَي
وفق تعبيرها) يامادا ناتسونو الجميلتين)

272
00:18:06,600 --> 00:18:08,050
!يامادا

273
00:18:08,050 --> 00:18:09,480
مرحباً

274
00:18:09,480 --> 00:18:11,460
هلّا حصلتُ على دجاج مقليّ؟

275
00:18:11,460 --> 00:18:13,330
!على الفور

276
00:18:13,710 --> 00:18:16,450
!بعتِ الكثير من المخزون اليوم

277
00:18:16,450 --> 00:18:17,760
شكراً على المُلاحظة

278
00:18:17,760 --> 00:18:19,830
تجاوزنا وقت الفورة على ما أعتقد

279
00:18:20,300 --> 00:18:24,750
جاءنا موجةٌ كبيرة بعد أن تعادلوا
في الشّوط الخامس

280
00:18:24,750 --> 00:18:27,060
شيشيو يشتعل حماساً، صحيح؟

281
00:18:27,060 --> 00:18:29,050
حقّقَ ثلاث ضربات وثلاث
!نقاط مُحرَزة بالضّرب

282
00:18:29,050 --> 00:18:30,880
تفضّل

283
00:18:30,880 --> 00:18:32,010
شكراً

284
00:18:32,010 --> 00:18:34,350
!إلى اللّقاء. بالتّوفيق

285
00:18:34,350 --> 00:18:37,500
!شكراً! زُرنا ثانية

286
00:18:38,320 --> 00:18:39,970
يامادا

287
00:18:39,970 --> 00:18:41,760
حضرة المُدير

288
00:18:41,760 --> 00:18:44,140
تبدين مُحبَطة قليلاً

289
00:18:44,140 --> 00:18:45,310
هل أنتِ بخير؟

290
00:18:45,310 --> 00:18:48,690
!لا، أنا بخير فحسب

291
00:18:50,040 --> 00:18:52,190
كنتُ أُفكّر

292
00:18:52,190 --> 00:18:56,410
مُفاوضات العقود لا تقتصر على اللّاعبين فقط

293
00:18:56,770 --> 00:18:57,920
عفواً؟

294
00:19:04,660 --> 00:19:08,040
...شـ-شكراً لك

295
00:19:09,670 --> 00:19:12,550
!حصلتُ على زيادة

296
00:19:12,900 --> 00:19:17,050
!أنتِ مُجدّة في العمل. يسرّني أن أرى ذلك

297
00:19:17,050 --> 00:19:19,720
!بئساً لي ولأخلاقي السّخيفة في العمل

298
00:19:19,720 --> 00:19:22,070
!يا لي من حمقاء

299
00:19:23,160 --> 00:19:24,160
المعذرة

300
00:19:25,750 --> 00:19:27,410
!أهلاً بك

301
00:19:27,910 --> 00:19:30,150
هل بقي لديك أي دجاج مقليّ؟

302
00:19:30,600 --> 00:19:33,870
...بالتّأكيد. واحد دجاج مقليلّ

303
00:19:34,510 --> 00:19:36,460
شكراً لزيارتك

304
00:19:37,160 --> 00:19:38,160
...المعذرة

305
00:19:39,120 --> 00:19:41,570
تبدين مُتوعّكة

306
00:19:41,570 --> 00:19:43,080
هل أنتِ بخير؟

307
00:19:44,660 --> 00:19:48,000
...لـ-لا شيء

308
00:19:48,000 --> 00:19:49,400
و-وداعاً

309
00:19:53,300 --> 00:19:56,340
أ-أستمتع دوماً بالطّعام هنا

310
00:19:59,620 --> 00:20:03,700
!للتو... كان يبدو كأمير جذّاب

311
00:20:03,700 --> 00:20:06,510
يسرّني أن أخطف قلبكِ كذلك

312
00:20:08,390 --> 00:20:11,160
كُفّي عن ذلك. لا تفكّري بهذه
!الطّريقة يا حمقاء

313
00:20:11,160 --> 00:20:13,040
!هذا لا يعني شيئاً

314
00:20:13,780 --> 00:20:15,210
يامادا

315
00:20:15,640 --> 00:20:18,910
هل أنتِ متأكّدة بأنّكِ بخير؟
لستِ مريضة أو ما شابه؟

316
00:20:19,260 --> 00:20:23,740
.كـ-كانت الفورة، هذا كلّ ما في الأمر
ربّما ارتفعت حرارتي

317
00:20:25,120 --> 00:20:26,830
كنتُ أقول لنفسي

318
00:20:26,830 --> 00:20:31,960
العمل هو كالمواقع الميدانيّة. يجب
عليك البحث عن المكان الّذي يلائمك

319
00:20:32,390 --> 00:20:33,480
عفواً؟

320
00:20:34,040 --> 00:20:37,220
!كنتُ أفكّر في تعيينكِ رئيسة مُناوبة

321
00:20:44,770 --> 00:20:47,900
!سأحصل على ترقية

322
00:20:49,270 --> 00:20:53,090
لطالما شعرتُ براحة كبيرة متى
رأيتكِ على رأس عملكِ

323
00:20:54,410 --> 00:20:56,690
...يسرّني سماع ذلك

324
00:21:01,160 --> 00:21:02,960
ها أنا ذي

325
00:21:03,330 --> 00:21:05,820
!أعتقد بعنا الكثير اليوم

326
00:21:05,820 --> 00:21:10,480
أجل، أقيمت حفلات كثيرة
في مقاعد القاعدة الأولى والثّالثة

327
00:21:16,670 --> 00:21:19,060
...شال رأس وسروال طويل

328
00:21:19,760 --> 00:21:23,300
هل سأقضي حياتي في الكلّية هكذا؟

329
00:21:23,710 --> 00:21:25,480
!يا آنسة

330
00:21:26,180 --> 00:21:29,350
!أكلنا الوجبة الّتي أعطيتنا إيّاها بأكملها

331
00:21:29,350 --> 00:21:30,890
!سوف نعود ثانية

332
00:21:32,240 --> 00:21:33,860
حـ-حسناً

333
00:21:35,800 --> 00:21:38,110
سوف تعود ثانية؟

334
00:21:45,540 --> 00:21:49,570
،قد لا يكون هناك زهرة في شعري
...ولا أستطيع الكشف عن ساقَي أيضاً

335
00:21:50,400 --> 00:21:52,500
!لكن ربّما سأبقى مزيداً من الوقت

336
00:21:53,260 --> 00:21:54,480
!يامادا

337
00:21:55,600 --> 00:21:59,090
!سأوظّف خرّيجاً في العام المُقبل
أتريدين أن تكوني أنتِ؟

338
00:22:00,360 --> 00:22:02,730
...فـ-في الواقع... أنا

339
00:22:03,260 --> 00:22:06,510
!المعذرة... سأفكّر في الأمر