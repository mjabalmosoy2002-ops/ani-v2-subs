عُذراً

820
01:06:05,370 --> 01:06:06,380
كوروساكي-كُن

821
01:06:06,710 --> 01:06:08,290
...إينوي، يوزو سـ

822
01:06:09,290 --> 01:06:10,550
ارجوكِ ساعدي يوزو

823
01:06:10,880 --> 01:06:11,710
اعلمُ ذلِكَ

824
01:06:13,170 --> 01:06:14,550
تماسكي، يوزو-تشان

825
01:06:17,050 --> 01:06:17,840
يوزو

826
01:06:23,560 --> 01:06:24,520
ما هذا؟

827
01:06:28,730 --> 01:06:29,690
يوزو

828
01:06:29,770 --> 01:06:30,860
لماذا؟

829
01:06:44,160 --> 01:06:45,000
إينوي

830
01:06:45,580 --> 01:06:46,620
اووي، إينوي

831
01:06:47,460 --> 01:06:48,460
ما الخطب ؟

832
01:06:49,250 --> 01:06:50,630
ارجوكِ، افعلي شيئاً ما

833
01:06:50,750 --> 01:06:51,590
لا فائدة

834
01:06:54,130 --> 01:06:58,220
لقد اخترقت من قبل سلاسل الجحيم

835
01:06:58,510 --> 01:07:00,720
لقد أصبحت واحدة مِنهُم

836
01:07:01,390 --> 01:07:03,810
قوتُنا لا تستطيع مُساعدتها

837
01:07:05,270 --> 01:07:07,440
مُــ ...مُستحيل

838
01:07:07,890 --> 01:07:10,730
أنت سبب كل هذا

839
01:07:25,620 --> 01:07:28,830
يوزو

840
01:07:49,810 --> 01:07:54,110
يبدو أنك ذهبت إلى الجحيم بنفسك

841
01:07:54,570 --> 01:07:57,490
و جعلت من المُشكلة تسوء أكثر

842
01:08:01,240 --> 01:08:06,450
الشيطان الذي بِداخِلك قطع سلاسل الجحيم

843
01:08:06,700 --> 01:08:09,620
و التي كانت تماماً غير قابلة للقطع

844
01:08:13,290 --> 01:08:18,340
بالواقع، هذا يعني انَ هذا العالم سيتحول إلى جحيم

845
01:08:19,760 --> 01:08:27,810
افعالكَ الآنانية ستُعرض جميعَ البشرِ إلى الخطر

846
01:08:38,990 --> 01:08:40,070
سأدخل

847
01:08:44,620 --> 01:08:45,530
...بياكويا

848
01:08:49,910 --> 01:08:51,290
كوروساكي إيتشيغو

849
01:08:51,710 --> 01:08:53,460
لماذا لم تنظر إلى عيناي؟

850
01:08:55,590 --> 01:09:01,510
...لقد تركتُ، روكيا ... رينجي ... و إيشيدا

851
01:09:02,130 --> 01:09:03,680
لقد تركتُهُم خلفي و عُدت

852
01:09:04,720 --> 01:09:06,050
...و الأسوء، يوزو ســ

853
01:09:06,760 --> 01:09:08,720
...لقد ظلمتُ الجميع

854
01:09:11,350 --> 01:09:12,520
و ماذا يعني؟

855
01:09:14,480 --> 01:09:15,480
...بياكويا

856
01:09:17,570 --> 01:09:21,400
روكيا، أُختك الصغيرة، مُحاصرة في الجحيم

857
01:09:22,950 --> 01:09:25,570
...لجعلي اهرُب، انهُم

858
01:09:25,950 --> 01:09:28,200
...روكيا شينيغامي فخور

859
01:09:28,580 --> 01:09:30,910
لقد كانتَ مُستعدة لعواقِب اعمالها

860
01:09:33,790 --> 01:09:36,460
...إذا كانوا جميعهُم ساعدوكَ وحدكَ على الهربِ

861
01:09:37,000 --> 01:09:39,130
أقترِحُ عليكَ ان تُفكر بمعنى ذلكَ

862
01:09:41,670 --> 01:09:42,760
آسف لإزعاجك

863
01:09:49,720 --> 01:09:50,470
يوزو

864
01:09:52,310 --> 01:09:53,230
يوزو

865
01:09:55,310 --> 01:09:56,230
يوزو

866
01:10:03,280 --> 01:10:04,070
يوزو

867
01:10:04,280 --> 01:10:05,410
اووي! يوزو

868
01:10:08,830 --> 01:10:09,910
مالذي حدثَ، سيدي؟

869
01:10:11,410 --> 01:10:12,040
أُدخُلي

870
01:10:12,120 --> 01:10:12,830
حاضر

871
01:10:45,650 --> 01:10:48,530
...إذا كانوا جميعهُم ساعدوكَ وحدكَ على الهربِ

872
01:10:48,660 --> 01:10:51,280
أقترِحُ عليكَ ان تُفكر بمعنى ذلكَ

873
01:10:56,250 --> 01:10:57,620
إينوي، كيف حال يوزو؟

874
01:10:58,210 --> 01:11:00,790
يبدو انها استقرت قليلاً

875
01:11:04,130 --> 01:11:04,840
شُكراً لكِ

876
01:11:05,220 --> 01:11:07,970
لا، عليكَ ان تشكُر الجميع

877
01:11:08,340 --> 01:11:09,300
أينَ تشادُ؟

878
01:11:10,180 --> 01:11:11,680
كيفَ حالُ تشادُ؟

879
01:11:12,010 --> 01:11:13,970
لم يستعد وعيهُ بعد

880
01:11:14,520 --> 01:11:15,810
لكن لا تقلق

881
01:11:16,060 --> 01:11:18,270
سأحتاجُ إلى بعض وقت، لكنِ سأُراقِبهُ أيضاً

882
01:11:18,810 --> 01:11:19,690
فهمت

883
01:11:21,940 --> 01:11:23,570
.شُكراً جزيلاً لك

884
01:11:25,320 --> 01:11:27,150
.لا بدَ و انكِ مُرهقة
أتُريدين شيئاً لتشربيه؟

885
01:11:28,200 --> 01:11:29,030
...كوروساكي-كُن

886
01:11:29,360 --> 01:11:30,070
هاه؟

887
01:11:34,370 --> 01:11:36,500
هل سوفَ تعود مرة أُخرى؟

888
01:11:38,210 --> 01:11:41,580
يوزو أُبتُعلت مِن قِبلِ الجحيم، لكنها عادت معنا على قيد الحياة

889
01:11:42,750 --> 01:11:45,260
يجِبُ علي ان أُنقذ روكيا و الآخرين كذلك

890
01:11:46,050 --> 01:11:47,840
...لكن إذا عُدت

891
01:11:48,050 --> 01:11:48,930
أعلمُ ذلِكَ

892
01:11:49,550 --> 01:11:51,850
...إذا ذهبتُ مرة أُخرى و هيأتي " الهولو" خرجت عن السيطرة

893
01:11:51,970 --> 01:11:54,470
رُبما سأُدمر العالم هذهِ المرة

894
01:11:56,270 --> 01:11:57,520
العجوز مُحق

895
01:12:00,600 --> 01:12:02,520
لكن هذه المرة، لن أفقد السيطرة

896
01:12:03,060 --> 01:12:04,230
ذلِكَ الرجُل قوي

897
01:12:04,570 --> 01:12:06,990
الجميع لا يستطيعون مُجاراتهُ

898
01:12:07,240 --> 01:12:10,780
...أنا لا أستطيعُ القول بأنني أستطيعُ هزيمتهُ بدون تحولي إلى هولو

899
01:12:11,110 --> 01:12:13,070
لكن، علي هزيمتهُ

900
01:12:14,240 --> 01:12:15,450
إذا لم استطع ذلِكَ

901
01:12:15,830 --> 01:12:18,830
عندها لن أستطيع مواجهة الأشخاص الذين عهدوا بحياتهُم لي

902
01:12:25,880 --> 01:12:26,880
...كُن مُتأكد

903
01:12:28,340 --> 01:12:30,220
من عودتك

904
01:12:31,800 --> 01:12:32,680
بالتأكيد

905
01:12:33,640 --> 01:12:34,550
سأذهبُ الآن

906
01:12:48,400 --> 01:12:49,400
التقرير

907
01:12:49,610 --> 01:12:52,740
الشينيغامي البديل كوروساكي إيتشيغو الذي كانَ تحتَ الاقامة الاجبارية

908
01:12:52,820 --> 01:12:55,740
دمر الحاجز و سلك هذا الطريق

909
01:12:56,280 --> 01:12:57,240
إيتشيغو-كُن...؟

910
01:12:57,410 --> 01:12:58,750
ذلِكَ الوغد

911
01:12:59,040 --> 01:12:59,910
اوكيتاكي

912
01:13:00,160 --> 01:13:02,960
إصلاح البوابات يأخذ الأولوية

913
01:13:03,170 --> 01:13:05,040
مفهوم، أنا سأعتني بِكوروساكي

914
01:13:11,130 --> 01:13:12,760
ما الذي تفعلهُ كوروساكي؟

915
01:13:13,680 --> 01:13:16,720
هل أنتَ ذاهب للانتِقام؟

916
01:13:20,060 --> 01:13:23,100
إذا كان كذلك، لن أجعلكَ تمرُ اياً كانَ السببِ

917
01:13:23,480 --> 01:13:26,360
إذا فقدت السيطرة مرة أُخرى، هذا يعني

918
01:13:27,070 --> 01:13:27,980
بان كاي

919
01:13:31,990 --> 01:13:34,320
أنا ذاهِبٌ فقط لِكي أُنقذ أصدقائي

920
01:13:34,860 --> 01:13:35,910
...كوروساكي

921
01:13:43,420 --> 01:13:44,500
ماذا الآن؟

922
01:13:51,510 --> 01:13:52,550
خُذُ مواقِعكُم الدِفاعية

923
01:13:52,840 --> 01:13:54,300
لا تسمحوا لكوشانادا بالدخول إلى العالم الحقيقي

924
01:13:55,260 --> 01:13:56,550
اوه، إيتشيغو

925
01:13:56,970 --> 01:13:58,140
دعيه يذهبُ

926
01:13:58,260 --> 01:14:00,810
نحنُ لا نملكُ الوقتِ له الآن

927
01:14:58,490 --> 01:14:59,910
إذاً لقد أتيتَ

928
01:15:08,920 --> 01:15:09,920
إيتشيغو

929
01:15:10,880 --> 01:15:13,050
فكرتُ بالذهابِ لكي أجلُبكَ

930
01:15:13,130 --> 01:15:16,880
لكن تخيل ذلكَ ... أنتَ اتيتَ من تلقاء نفسك

931
01:15:17,340 --> 01:15:19,140
هل هذا من أجل الانتقام بأختك؟

932
01:15:19,590 --> 01:15:20,890
يوزو، نجت

933
01:15:22,560 --> 01:15:23,970
فاجأتني

934
01:15:24,890 --> 01:15:26,730
إذاً لِماذا عُدتَ؟

935
01:15:28,770 --> 01:15:30,020
...أتيتُ

936
01:15:30,480 --> 01:15:32,150
لإنقاذ أصدقائي

937
01:15:32,610 --> 01:15:33,980
لإنقاذهم

938
01:15:35,070 --> 01:15:38,070
أنتَ مازلتَ لا تفهمُ هذا المكان، أليسَ كذلِكَ؟

939
01:15:38,530 --> 01:15:41,280
لقد حُوصروا من قِبلِ سلاسل الجحيم

940
01:15:41,780 --> 01:15:42,660
أُنظُر

941
01:15:45,540 --> 01:15:47,000
إيشيدا، رينجي

942
01:15:47,500 --> 01:15:50,080
الاشخاص مازالوا مُتعفنين

943
01:15:51,790 --> 01:15:52,750
لا تستعجل

944
01:15:53,250 --> 01:15:57,050
لكن أُنثى الشينيغامي على ابواب التعفُن

945
01:16:06,770 --> 01:16:07,730
روكيا

946
01:16:18,740 --> 01:16:20,450
إيتشيغو، لماذا؟

947
01:16:22,160 --> 01:16:25,120
.الجحيم يعمل بطريقة بسيطة

948
01:16:25,490 --> 01:16:28,960
الاشخاص الذي يُحاصرون هُنا يعودون للحياة مرات لا تُحصى

949
01:16:29,160 --> 01:16:31,170
لكن كلما تطول مُدة السلاسل عليهُم

950
01:16:31,290 --> 01:16:34,290
لن يكونوا قادرين على مُجابهة العيش هُنا

951
01:16:35,250 --> 01:16:38,090
إذاً كُل ما عليّ فِعلهُ هو قطع هذه السلاسل

952
01:16:38,720 --> 01:16:40,430
يالها من شهامة

953
01:16:41,180 --> 01:16:43,970
إذاً ستقطعُ سلاسلي أيضاً، أليسَ كذلكَ؟

954
01:16:45,680 --> 01:16:46,810
هذا، لا يُمكنُني ذلك

955
01:16:48,810 --> 01:16:50,810
أنا سأهزِمُكَ

956
01:17:14,130 --> 01:17:15,210
أنتَ غبي

957
01:17:15,380 --> 01:17:18,460
!هل حقاً تعتقدُ انكَ تستطيع هزيمتي من دون قناعك؟

958
01:17:24,840 --> 01:17:26,010
أصبحتَ ساذجاً

959
01:17:26,550 --> 01:17:29,520
,لا اعلمُ ماهي آمالُكَ بتحديكَ لي

960
01:17:29,640 --> 01:17:32,020
لا شيء تفعلهُ سينفع ضدي بهيئتُكَ الحالية

961
01:17:39,280 --> 01:17:42,240
غيتسوجا تينشو

962
01:17:46,320 --> 01:17:47,370
هذهِ هي

963
01:18:05,010 --> 01:18:05,890
إيتشيغو

964
01:18:17,900 --> 01:18:18,730
ما الخطبُ؟

965
01:18:20,610 --> 01:18:22,280
ما الذي أنت خائف منه؟

966
01:18:25,950 --> 01:18:30,280
هل هذا لأن الجانب الغير مألوف لكَ دمر كُل شيءِ؟

967
01:18:31,790 --> 01:18:35,250
بهذه الحالة، لم يكُن عليكَ ان تأتي كُل هذه المسافة إلى هُنا

968
01:18:39,340 --> 01:18:41,130
استطعتَ انقاذ أُختكَ

969
01:18:41,460 --> 01:18:44,510
لأنكَ كُنت مُتحولاً إلى ذلكَ الوحش

970
01:18:45,050 --> 01:18:48,220
بدون ذلكَ، أنتَ لا تستطيعُ فعلِ أي شيء

971
01:19:01,980 --> 01:19:03,280
ألم أُخبِركَ؟

972
01:19:03,990 --> 01:19:06,950
شيءٌ واحدٌ فهمتهُ خِلال هذهِ الأوقات

973
01:19:07,030 --> 01:19:09,370
عِندما لا تستجِبُ لكَ آمالُكَ

974
01:19:09,820 --> 01:19:11,490
سيكونَ هذا بِسببِ الكراهية

975
01:19:12,700 --> 01:19:15,460
رغبتي في الأنتِقام كانَ الشيءُ الوحيدَ الذي جعلَ مني قوياً

976
01:19:17,330 --> 01:19:18,830
ما الخطّبُ؟

977
01:19:38,600 --> 01:19:40,350
إكرهني أكثر

978
01:19:41,360 --> 01:19:44,230
سوفَ اجعلُ منكَ قوياً أيضاً

979
01:20:12,640 --> 01:20:17,680
أتُمانعُ إذا خطفتُ أُختكَ مرةٍ أُخرى؟

980
01:20:33,700 --> 01:20:35,950
...هذهِ هي، جيد

981
01:20:36,950 --> 01:20:39,040
جّسَدُكَ فقد السيطرة هُنا قبلاً

982
01:20:39,250 --> 01:20:41,540
المره الثانية يجبُ ان تكونَ سهلة

983
01:20:42,210 --> 01:20:46,050
لا يُمكِنُكَ أبداً الهروب مِن ذلك الوحشِ

984
01:20:46,590 --> 01:20:50,050
الآمال وحدها لنَ تستطيع فعلَ أيّ شيء

985
01:20:56,060 --> 01:20:56,890
...إيتشيغو

986
01:20:58,100 --> 01:20:59,020
إيتشيغو

987
01:20:59,680 --> 01:21:00,600
إخرس

988
01:21:01,770 --> 01:21:03,650
هُنا بدأ كُل شيء

989
01:21:12,110 --> 01:21:13,740
أتسمعُ ذلِكَ إيتشيغو؟

990
01:21:14,570 --> 01:21:19,620
الـ" كوشانادا "  أحس بأن الـ" الرياتسو " الخاصة بِكَ قد تغيرت

991
01:21:25,880 --> 01:21:30,090
!سيكونون هُنا قريبًا لإلتهامكَ، لإلتهام الشخص الذي دمر الجحيم

992
01:21:35,890 --> 01:21:38,100
اسرع، و كُن وحشاً إيتشيغو

993
01:21:38,430 --> 01:21:40,430
أم تُريد ان يتم التِهامُكَ؟

994
01:21:40,850 --> 01:21:42,230
هذا حقاً لا يهُم

995
01:21:42,310 --> 01:21:44,100
هُنا، ستعود على الفورِ للحياة

996
01:21:45,060 --> 01:21:50,320
!هذه الحَلَقةُ سوفَ تُعيدُ نفسها حتى يُدمر الجحيمْ

997
01:22:00,080 --> 01:22:01,700
حسناً؟ ما الخطبِ؟

998
01:22:02,580 --> 01:22:05,290
...هذا لن يحدُث

999
01:22:06,380 --> 01:22:08,090
أنا لن افعلها

1000
01:22:10,300 --> 01:22:12,720
...الإنتقامُ للآمال ليسَ جواباً

1001
01:22:13,930 --> 01:22:16,550
هذهِ تفاهةٌ

1002
01:22:18,050 --> 01:22:22,480
...هذا سهلٌ بأن تقوم بإلقاء اللوم

1003
01:22:23,020 --> 01:22:25,650
على من حولكَ

1004
01:22:32,030 --> 01:22:35,990
كُل ما تفعلهُ هو الركضِ خلفَ الألم من خلال الإنتِقام

1005
01:22:41,910 --> 01:22:44,290
أُريدُ ان أُساعدَ أصدقائي

1006
01:22:45,540 --> 01:22:50,840
لكنِ ... لا أُريدُ ان أضحي بمن حولي من أجلِ ذلكَ

1007
01:22:54,050 --> 01:22:55,420
إيتشيغو، أُهرُب

1008
01:22:56,090 --> 01:22:57,260
إيتشيغو

1009
01:22:58,590 --> 01:23:03,310
...قتال معَ ذلِكَ العهد

1010
01:23:03,720 --> 01:23:05,430
بِداخل

1011
01:23:09,610 --> 01:23:12,320
إيتشيغو

1012
01:23:31,790 --> 01:23:33,550
لقد فقدت السيطرة بعدة كُل شيء

1013
01:23:34,130 --> 01:23:35,210
جيد

1014
01:23:35,300 --> 01:23:37,800
و الآن دمِرهُم

1015
01:23:45,930 --> 01:23:47,060
ماذا؟

1016
01:24:24,140 --> 01:24:26,270
ما ذلكَ الزي؟

1017
01:24:29,980 --> 01:24:31,600
مالذي فعلتهُ؟

1018
01:24:33,900 --> 01:24:34,820
...كوكُتو

1019
01:24:35,730 --> 01:24:39,360
هل طلبت منكَ أُختكَ ان تنتقمَ لها ؟

1020
01:24:40,650 --> 01:24:41,740
ماذا؟

1021
01:24:42,660 --> 01:24:46,870
هل أرادت مِنكَ ان تُعيد هذهِ الحَلَقة مِن القِتال و القتل ؟

1022
01:24:47,830 --> 01:24:50,120
لا يمكِنُكَ إنهاءُ الكراهية بالكراهية

1023
01:24:51,920 --> 01:24:56,920
أنتَ وضعتَ أُختكَ بأعماق الكراهية

1024
01:24:59,340 --> 01:25:02,680
ما يُريدهُ مني أصدقائي لفعلهُ ليسَ الإنتِقام

1025
01:25:03,550 --> 01:25:05,010
بل يُريدونَ مني إيقافكَ

1026
01:25:06,560 --> 01:25:07,680
أتراها؟

1027
01:25:08,020 --> 01:25:10,390
.الجحيمُ مُتمسِكٌ بي

1028
01:25:11,140 --> 01:25:13,810
الجحيم مُستعدٌ لاستعارة المُساعدة من الخارج

1029
01:25:13,940 --> 01:25:16,150
لمنعك من الهروب

1030
01:25:17,530 --> 01:25:20,780
الجحيم يمدُ يدَ المُساعدة إلى بشر ؟

1031
01:25:21,610 --> 01:25:24,620
هذا مُستحيل

1032
01:25:25,660 --> 01:25:28,330
نحن متشابهان

1033
01:25:34,040 --> 01:25:35,170
هذا صحيح

1034
01:25:35,420 --> 01:25:37,960
أنا مُجرد انسان وحيد وحد مِثلكَ

1035
01:25:38,380 --> 01:25:40,970
و أنا أخٌ كبير

1036
01:26:21,710 --> 01:26:22,760
...سلاسلي

1037
01:26:26,090 --> 01:26:30,310
...أنا حُر، هذا يعني

1038
01:26:30,760 --> 01:26:32,770
أنا حُر بالنهاية

1039
01:26:44,860 --> 01:26:45,700
ماذا؟

1040
01:26:48,120 --> 01:26:48,780
توقف

1041
01:26:49,950 --> 01:26:50,870
...انا

1042
01:26:58,040 --> 01:27:01,750
هذه السلاسل هي عِقابُكَ لأنكَ خدعتَ الجحيم

1043
01:27:03,170 --> 01:27:04,010
كوكُتو

1044
01:27:04,130 --> 01:27:07,260
توب من ذنوبكَ مرة أُخرى في أعماقُ الجحيم

1045
01:27:42,750 --> 01:27:43,710
فعلتُها

1046
01:27:45,300 --> 01:27:46,510
!فعلتُها

1047
01:27:49,930 --> 01:27:50,890
...إيتشيغو

1048
01:27:53,260 --> 01:27:54,100
!لقد فعلتها

1049
01:27:55,310 --> 01:27:57,890
و الآن علينا ان نجد إيشيدا و رينجي

1050
01:27:58,640 --> 01:27:59,900
نعم، صحيح

1051
01:28:00,150 --> 01:28:02,900
لقد قطعتُ سلاسِلهُم قبلَ فترة قصيرة

1052
01:28:03,320 --> 01:28:04,150
أينَ هُم

1053
01:28:04,570 --> 01:28:05,650
نحنُ هُنا ؟

1054
01:28:07,570 --> 01:28:09,320
جسدي بالكامل يؤلمُني

1055
01:28:09,570 --> 01:28:10,570
انا، أيضاً

1056
01:28:10,950 --> 01:28:12,570
انهُ ثقيل كالصخور

1057
01:28:13,490 --> 01:28:16,500
لقد كُنتَ تتعفن، فمالذي أعتقدتهُ؟

1058
01:28:16,910 --> 01:28:19,540
اتعفن ؟ مالذي تقصدينهُ؟

1059
01:28:20,170 --> 01:28:21,000
...لاشيء

1060
01:28:22,000 --> 01:28:23,840
يبدو أنَ الأمور قد إنتهت

1061
01:28:24,840 --> 01:28:26,170
مالذي حدثَ لذلِكَ الرجُل؟

1062
01:28:26,380 --> 01:28:29,170
لقد سُحِبَ إلى أعماقُ الجحيم

1063
01:28:30,380 --> 01:28:32,590
...أعتقدُ ان ذلكَ يعني أنكَ ربحتَ

1064
01:28:32,720 --> 01:28:34,850
مالخطبُ بِشكلك؟

1065
01:28:35,310 --> 01:28:36,720
اوه ، هذا؟

1066
01:28:37,220 --> 01:28:39,520
لم افهم الامر، أيضاً

1067
01:28:40,270 --> 01:28:41,810
لقد ساعدوني

1068
01:28:42,350 --> 01:28:44,110
!أعتقدُ ذلك

1069
01:28:44,860 --> 01:28:45,480
هل أبدو غريباً؟

1070
01:28:45,570 --> 01:28:47,820
هذا  أكثر مِن الغرابة

1071
01:28:48,190 --> 01:28:49,530
هل هي قوة الجحيم ؟

1072
01:28:49,610 --> 01:28:51,200
...لا يُصدق، أنتَ

1073
01:28:51,320 --> 01:28:53,370
هل جميعُ المصادر تتجِهُ لك وحدك

1074
01:28:53,490 --> 01:28:55,450
أسرع و إخلع هذه

1075
01:28:56,160 --> 01:28:58,200
سمعتُكَ، سأفعلها الآن

1076
01:28:59,460 --> 01:29:00,500
إنتظر إيتشيغو

1077
01:29:00,750 --> 01:29:03,880
إذا خلعتها، رُبما ستُهاجم مره أُخرى

1078
01:29:04,250 --> 01:29:04,790
هاه؟

1079
01:29:07,760 --> 01:29:08,630
أنظُر

1080
01:33:21,470 --> 01:33:22,180
يوزو

1081
01:33:22,840 --> 01:33:24,510
اوه، صباحُ الخيرِ، كارين-تشان

1082
01:33:33,520 --> 01:33:34,610
ما الخطب؟

1083
01:33:34,770 --> 01:33:35,810
هذا جيّد

1084
01:33:35,900 --> 01:33:37,610
مـ-ماذا؟

1085
01:33:38,780 --> 01:33:40,440
لقد عدتُ

1086
01:33:40,990 --> 01:33:41,990
اووي

1087
01:33:42,200 --> 01:33:44,320
لقد جلبتُ الكثير من الأمور التذكارية

1088
01:33:45,160 --> 01:33:47,330
اووي، هل هُناك احد في المنزل؟

1089
01:33:48,240 --> 01:33:49,240
اووي