1
00:00:01,600 --> 00:00:03,600
خذي هذه

2
00:00:06,300 --> 00:00:07,610
أستسلم

3
00:00:08,500 --> 00:00:11,620
ماثيو-سان، أنت بارعٌ حقّاً في هذه اللّعبة

4
00:00:11,620 --> 00:00:15,680
أنا واثقة أنّك ستهزم إكتا-سان أو ياتوري-سان
إذا لعبتَ معهما

5
00:00:16,170 --> 00:00:17,660
مستحيل

6
00:00:18,260 --> 00:00:21,840
أهذه موضوع محرِج بالنسبة لك؟

7
00:00:21,840 --> 00:00:23,980
ليس في الشّطرنج فحسب

8
00:00:23,980 --> 00:00:26,660
بل كلّ شيء

9
00:00:26,660 --> 00:00:28,540
ألا تشعرين نفس شعوري يا هارو؟

10
00:00:28,950 --> 00:00:31,050
...أعني كيف أنّهما

11
00:00:32,940 --> 00:00:34,680
بمُستوى مختلف تماماً عنك؟

12
00:00:35,290 --> 00:00:36,500
!آسفة

13
00:00:36,500 --> 00:00:38,680
اعتدتُ أن أقول كلّ ما أفكّر به

14
00:00:40,050 --> 00:00:41,480
أعلم

15
00:00:42,420 --> 00:00:43,810
...على أي حال

16
00:00:44,330 --> 00:00:45,560
هل غضِبت؟

17
00:00:46,870 --> 00:00:48,410
لا

18
00:00:48,410 --> 00:00:50,530
سأذهبُ إلى غرفة سجلّات الحرب

19
00:00:50,530 --> 00:00:53,570
أريدُ أن أعرف المزيد عن تشكيل الدّفاع النهريّ

20
00:00:54,030 --> 00:00:55,700
هذا مدهش

21
00:00:55,700 --> 00:00:57,070
!حظّاً سعيداً

22
00:00:58,320 --> 00:01:00,580
مستوى مختلف تماماً؟

23
00:01:00,580 --> 00:01:03,050
!أعلم ذلك، لكن لن أستسلم

24
00:01:03,050 --> 00:01:07,830
سأريهم يوماً ما ما الذي يستطيعُ
ماثيو تيتجيريتش فعله

25
00:01:14,550 --> 00:01:16,790
،كنتُ قادراً على إصابتهم

26
00:01:16,790 --> 00:01:17,800
!من تلك المسافة

27
00:01:20,390 --> 00:01:24,080
البُعد عن الهدف ليس بالضرورة أن يكون سيّئاً دائماً

28
00:01:24,080 --> 00:01:27,060
،فمن ناحية، يُصعِّب عليهم عمليّة الردّ

29
00:01:27,060 --> 00:01:29,730
.ويصعِّب عمليّة بحثهم عنك من ناحية أخرى

30
00:01:29,730 --> 00:01:31,110
،والأهمّ من هذا

31
00:01:31,110 --> 00:01:33,530
لن تكون قلقاً عندما تطلق النّار

32
00:01:34,560 --> 00:01:36,470
...غلطتي ومخاوفي

33
00:01:37,090 --> 00:01:38,700
...وما أريد فعله

34
00:01:39,530 --> 00:01:41,740
،كنتَ على دراية بذلك لمدّة طويلة

35
00:01:42,590 --> 00:01:44,230
أليس كذلك يا إيكّون؟

36
00:03:25,480 --> 00:03:26,180
،إكتا-سان

37
00:03:27,220 --> 00:03:29,680
هل من المناسب أن تنام هنا؟

38
00:03:31,770 --> 00:03:33,180
لا تقلقي

39
00:03:33,180 --> 00:03:34,210
،أينما نمت

40
00:03:34,210 --> 00:03:38,320
أوفِّر الجانب الأيمن من السّرير لكِ

41
00:03:39,970 --> 00:03:42,320
على أي حال، ماذا كنت تقرأ؟

42
00:03:42,750 --> 00:03:43,540
صحيح

43
00:03:45,430 --> 00:03:47,580
صندوق أناراي على وشك أن يُفتَح

44
00:03:48,680 --> 00:03:51,080
صندوق من؟

45
00:03:51,810 --> 00:03:53,660
إنّه خزنة من النّاحية الجوهريّة

46
00:03:53,660 --> 00:03:55,580
.بما يحتويه من ملكيّات فكريّة

47
00:03:55,820 --> 00:04:00,420
هل أخبرتُكِ أنّني درستُ على يد أناراي كان؟

48
00:04:00,870 --> 00:04:03,580
الرّجل الذي طلب اللّجوء إلى كيوكا؟

49
00:04:03,580 --> 00:04:05,970
العلوم، صحيح؟

50
00:04:05,970 --> 00:04:07,640
التي تعلّمتَها منه

51
00:04:08,090 --> 00:04:11,700
نعم، أنا أحد تلاميذه

52
00:04:12,790 --> 00:04:16,330
نتائج البحث التي عملنا عليها سوية

53
00:04:16,330 --> 00:04:19,130
،وُضِعَتْ في البداية داخل صندوق أناراي

54
00:04:19,130 --> 00:04:22,150
ولم يكُن مسموحاً لأحد أن يعرف بأمرها غيرنا

55
00:04:22,660 --> 00:04:27,560
،لكن مُقابل قبول طلب لجوئه

56
00:04:27,560 --> 00:04:31,280
.احتاجت كيوكا لتكنولوجيا كي تطبّقها عسكريّاً

57
00:04:31,870 --> 00:04:34,710
ولهذا، كي تبقى الأمور متّزنة مع كيوكا

58
00:04:34,710 --> 00:04:37,040
.أخبَرَنا بما كان سيُعطيهم إيّاه

59
00:04:37,340 --> 00:04:40,920
ماذا يعني هذا؟

60
00:04:43,870 --> 00:04:46,270
لا بدّ وأنّني أشعرتُكِ بالملل

61
00:04:46,270 --> 00:04:50,360
حسناً، هذا يعني أنّ الأمور ستتطوّر في ساحة المعركة مجدّداً

62
00:04:50,360 --> 00:04:51,980
يا له من هدر للمعرفة

63
00:04:54,890 --> 00:04:58,020
حان وقتُ الذهاب إلى المنطقة الشماليّة أخيراً، صحيح؟

64
00:04:58,020 --> 00:05:00,770
سنتوجّه إلى الحامية في سومين

65
00:05:01,500 --> 00:05:04,100
تقعُ في أسفل سلسلة الجبال الواقعة في الرّيف

66
00:05:04,100 --> 00:05:06,820
،ريفيّو شيناك متواجدون في كلّ مكان

67
00:05:08,950 --> 00:05:12,040
هل سمعتُ شخصاً يسخرُ من المنطقة الشماليّة؟

68
00:05:12,500 --> 00:05:16,410
من الانحياز أن تعتقدا أنّه لا يوجد
ما يستحقّ الرّؤية في الرّيف

69
00:05:16,410 --> 00:05:17,910
خاصّة أنت يا ماثيو

70
00:05:17,910 --> 00:05:21,090
أنت لا تفهم أعاجيب شيناك

71
00:05:21,090 --> 00:05:24,260
أنت تعرفُ الكثير عن شيناك

72
00:05:25,190 --> 00:05:30,040
زرتُ قرية شيناك مع العجوز أناراي
كجزء من بعثة البحث

73
00:05:31,440 --> 00:05:34,930
،درَسْنا الطقس والطبقات الجيولوجيّة في الجبال العالية

74
00:05:34,930 --> 00:05:38,650
لكن كان الجزء المفضّل بالنسبة لي
هو التعرّف على السكّان المحلِّيين

75
00:05:40,020 --> 00:05:42,880
إنّهم همجيّون جبليّون، صحيح؟

76
00:05:42,880 --> 00:05:44,650
ما الذي أمتعَك في ذلك؟

77
00:05:45,120 --> 00:05:47,180
،إذا اضطررتُ لذكر سبب واحد

78
00:05:47,180 --> 00:05:49,160
كانت الفتيات حسناوات ومُفعمات بالحيويّة

79
00:05:49,530 --> 00:05:51,910
ظننتُك تحبُّ النّساء الكبيرات في السنّ

80
00:05:51,910 --> 00:05:54,760
معاييرك مختلفة عن معاييري، لِذا لا جدوى من ذلك

81
00:05:54,760 --> 00:05:57,040
أنا لا أتحدّث عن مظهرهن

82
00:05:57,270 --> 00:06:00,280
،إنّه مجتمع أمومي بامتياز

83
00:06:00,280 --> 00:06:03,630
وقد خلق ذلك تقاليده الخاصّة به

84
00:06:03,630 --> 00:06:04,750
...على سبيل المثال

85
00:06:06,690 --> 00:06:08,340
!تزورنا الفتيات ونحنُ في السّرير ليلاً؟

86
00:06:08,340 --> 00:06:10,410
!هذا داعرٌ جدّاً

87
00:06:10,820 --> 00:06:12,820
العالم واسع يا ماثيو

88
00:06:12,820 --> 00:06:14,810
أنتُم بمزاج جيّد

89
00:06:15,660 --> 00:06:17,310
عمّاذا تتكلّمون؟

90
00:06:18,060 --> 00:06:20,400
أنصح بعدم السّؤال

91
00:06:20,400 --> 00:06:23,520
تسعون بالمئة من كلامهم قلّة أدب

92
00:06:24,150 --> 00:06:26,490
—لم أكن أتكلّم عن أي شيء

93
00:06:26,490 --> 00:06:29,720
هل تقصدين بقلّةِ الأدب طريقة ارتداء

94
00:06:29,720 --> 00:06:32,930
،هارو لقميصها المتعرِّق والمُلتصِق بصدرها

95
00:06:32,930 --> 00:06:36,480
بحيث تكون فيه تقاسيم الجسم واضحة للعيان؟

96
00:06:36,480 --> 00:06:38,870
تقصدين شيئاً بهذه الرّوعة، أليس كذلك؟

97
00:06:41,160 --> 00:06:42,880
اعتذر

98
00:06:43,260 --> 00:06:46,650
وحدهم الرّجال المقرفون من يقولون كلاماً كهذا لامرأة

99
00:06:47,120 --> 00:06:48,490
وبعد؟

100
00:06:48,490 --> 00:06:50,590
كنّا نناقشُ رحلة الشّمال

101
00:06:50,920 --> 00:06:53,470
الانتشار الذي مدّته ستّة أشهر، أليس كذلك؟

102
00:06:53,910 --> 00:06:57,130
،بعيداً عن التّعامل مع اللّصوص ومراقبة أهل الجبل

103
00:06:57,130 --> 00:06:59,380
إنّه مركز مملّ جدّاً حسبما سمعت

104
00:06:59,380 --> 00:07:02,980
ياتوري، ألن تشعري بالملل؟

105
00:07:03,350 --> 00:07:05,720
لا، إنّه ممتاز

106
00:07:06,140 --> 00:07:09,570
أريدُ أن أخوض أكبر عدد مُمكن
من المعارك الحقيقيّة

107
00:07:10,510 --> 00:07:14,700
ليت الشّخص في بالي يكون بهذا الحماس

108
00:07:17,790 --> 00:07:19,620
!كانّا

109
00:07:20,690 --> 00:07:23,130
!لقد وصلوا، لقد وصلوا

110
00:07:23,430 --> 00:07:25,920
!المُرشُّحون الضبّاط الجدُد تماماً

111
00:07:27,530 --> 00:07:32,260
!الذين أنقذوا الأميرة قد وصلوا أيضاً

112
00:07:43,490 --> 00:07:46,270
،أرحّبُ بكُل من المرشّحين الضباط ذوي المستوى الرّفيع

113
00:07:46,620 --> 00:07:49,350
،ووحداتهم التدريبيّة

114
00:07:49,350 --> 00:07:51,400
.في هذا العام مجدّداً

115
00:07:51,400 --> 00:07:57,280
نحنُ في الحامية الشماليّة تغمرُنا السّعادة لحضوركم

116
00:07:57,860 --> 00:08:00,460
أنا متردّدٌ في مناقشة أمور غير سارّة فوراً

117
00:08:00,460 --> 00:08:04,530
لكن كلّكم يعلم بسقوط المنطقة الشرقيّة

118
00:08:04,530 --> 00:08:09,800
لو كنتُ أنا وقلّة من رجالي هناك

119
00:08:09,800 --> 00:08:14,510
...عندما تجرّأ همجيّو كيوكو على انتهاك الأرض الامبراطوريّة

120
00:08:16,150 --> 00:08:19,450
يعتمد هجومنا المضادّ النّهائي على كيوكا

121
00:08:19,450 --> 00:08:24,660
على ولاءنا ووطنيّتنا نحن الجنود

122
00:08:25,030 --> 00:08:28,310
،كقادة مُستقبليين لجيشنا

123
00:08:28,310 --> 00:08:31,190
عسى أن تكون وطنيّتكم راسخة ونقيّة

124
00:08:31,790 --> 00:08:33,170
،آسف على الخطاب القصير

125
00:08:33,170 --> 00:08:35,320
.لكن هذا كُل ما لديّ

126
00:08:35,590 --> 00:08:37,550
أهذا الخطاب قصير؟

127
00:08:40,520 --> 00:08:44,490
،الازدهار الأبديّ للأرض التي يحكمها الامبراطور

128
00:08:44,490 --> 00:08:46,690
!والتي نحميها نحن الجنود

129
00:08:47,120 --> 00:08:48,460
!بصحّتكم

130
00:08:48,460 --> 00:08:50,460
!بصحّتك

131
00:08:54,370 --> 00:08:56,470
استمرّوا في دردشتكم أثناء استماعكم لي

132
00:08:57,470 --> 00:09:01,290
،أنا مساعد قائد الحامية

133
00:09:01,290 --> 00:09:04,310
الرّائد يوسكشيرام تواك

134
00:09:04,930 --> 00:09:09,060
سأشرح ما ستفعلونه هنا

135
00:09:09,700 --> 00:09:12,830
هل هو بخير؟

136
00:09:10,500 --> 00:09:17,610
،يمكنكم إيجاد التّنظيم الهرمي منشوراً في رواق المُعسكرات

137
00:09:12,830 --> 00:09:15,880
أشعرُ بأنّه قد يخرّ ميّتاً في أي لحظة

138
00:09:15,880 --> 00:09:18,070
رُبَّما مرّ على رأسه الكثير

139
00:09:18,070 --> 00:09:22,080
وتسلسل القيادة منشور هناك أيضاً
لذا احرصوا على الاطّلاع عليه

140
00:09:18,610 --> 00:09:22,080
.باعتباره يعمل لحساب زعيم بِلا رأس

141
00:09:22,600 --> 00:09:23,880
هذا كُل ما في الأمر

142
00:09:23,880 --> 00:09:26,690
إن كانت لديكم أي أسئلة فاطرحوها الآن

143
00:09:27,290 --> 00:09:30,030
بات من الواضح ماذا يفعلُ كلّ شخص هنا

144
00:09:35,000 --> 00:09:35,850
مرحباً

145
00:09:36,750 --> 00:09:38,270
هل تستمتع بوقتك؟

146
00:09:38,880 --> 00:09:39,770
نعم

147
00:09:39,770 --> 00:09:41,090
شكراً

148
00:09:41,090 --> 00:09:43,560
لديك روحُ النّور أيضاً، أليس كذلك؟

149
00:09:44,680 --> 00:09:47,590
،ضابط الصفّ إكتا سولورك

150
00:09:47,590 --> 00:09:49,190
فصيل قوّات النّور 3

151
00:09:49,490 --> 00:09:51,690
وهذا كوس، شريكي

152
00:09:51,960 --> 00:09:54,390
الملازم أوّل سينبا سازالوف

153
00:09:54,390 --> 00:09:57,950
سأكون مدرّبك لبعض الوقت

154
00:09:58,280 --> 00:10:00,910
وهذا شريكي كي، روح النُّور

155
00:10:00,910 --> 00:10:02,030
سررتُ بلقائك

156
00:10:02,540 --> 00:10:06,680
سمعتُ أنّ هناك طفل مزعج اختلط مع الفرسان
وصار حديث النّاس

157
00:10:06,680 --> 00:10:07,940
هل كان أنت؟

158
00:10:07,940 --> 00:10:10,470
،لا أنسجم معهم عندما أرافقهم

159
00:10:10,470 --> 00:10:13,380
لهذا أبقى بعيداً عنهم

160
00:10:13,650 --> 00:10:16,660
لا تبدو كفارس حقّاً

161
00:10:17,440 --> 00:10:20,720
...قد يكون ذلك الفتى الوسيم، لكن

162
00:10:21,140 --> 00:10:23,260
!أنتَ قاسٍ

163
00:10:24,920 --> 00:10:26,450
!أكرهه

164
00:10:26,450 --> 00:10:29,050
أكره كلّ الوسيمين الّذين تتقرّب منهم النّساء

165
00:10:29,050 --> 00:10:30,730
!دون أن يقولوا كلمة

166
00:10:30,920 --> 00:10:32,300
...تبّاً

167
00:10:34,730 --> 00:10:39,360
!لقد كنتُ أنتظر هذه اللّحظة يا ابنة إغسيم

168
00:10:42,530 --> 00:10:44,540
هل تريد شيئاً منّي؟

169
00:10:44,890 --> 00:10:46,250
!اسمعي جيّداً

170
00:10:46,620 --> 00:10:49,040
!اسمي هو دينكون هارغونسكا

171
00:10:49,550 --> 00:10:51,000
!عمري 26

172
00:10:51,530 --> 00:10:52,880
!رتبتي هي ضابط صفّ

173
00:10:53,150 --> 00:10:55,250
!أعرف اسمكِ جيّداً

174
00:10:55,830 --> 00:10:57,920
والآن لندع سيوفنا هي التي تتكلّم

175
00:11:02,210 --> 00:11:05,640
الفريق سافيدا، لقد تلقّيتُ طلباً بالمُبارزة

176
00:11:05,640 --> 00:11:08,020
هل من مكان نتبارز فيه؟

177
00:11:09,630 --> 00:11:10,940
ماذا نفعل؟

178
00:11:10,940 --> 00:11:12,360
لا بأس بهذا المكان على ما أعتقد

179
00:11:12,360 --> 00:11:14,020
نعم، افعلاها هنا

180
00:11:14,020 --> 00:11:17,970
لكن مهارات ضابط الصفّ هارغونسكا بالسّيف

181
00:11:17,970 --> 00:11:21,280
هي الأجوَد في الحاميّة الشّمالية

182
00:11:25,990 --> 00:11:28,200
ماذا تفعلين؟

183
00:11:28,740 --> 00:11:32,710
أسلوب السّيفين الذي تستخدمه عشيرة إغسيم
مخصَّص لمقاتلة أكثر من خصم في آن واحد

184
00:11:33,070 --> 00:11:34,210
،إذا واجهتُ خصماً واحداً

185
00:11:35,060 --> 00:11:36,710
فلستُ بحاجة لأكثر من سيف واحد

186
00:11:38,390 --> 00:11:41,380
لا بدّ وأنّكِ تقلّلين من شأن مهاراتي إذاً

187
00:11:44,170 --> 00:11:46,410
يا له من استعراض فاحش

188
00:11:46,410 --> 00:11:48,980
مهارات ياتوري في المُبارزة بالسّيف ليس شيئاً يُهزأ به

189
00:11:49,580 --> 00:11:50,940
هذا غير صحيح

190
00:11:50,940 --> 00:11:52,020
—لا يجوز أن

191
00:11:51,590 --> 00:11:53,700
أسلوب إغسيم هو شيء يُهزَأ به

192
00:11:54,620 --> 00:11:58,810
هذا استعراض هزلي تقليدي يُقام في كلّ مكان

193
00:11:58,810 --> 00:12:00,780
يصلُ فيه شخصٌ من إغسيم إلى حامية أخرى

194
00:12:00,780 --> 00:12:01,530
ماذا؟

195
00:12:01,940 --> 00:12:04,750
أسلوب السّلاحين هو امتياز خاصّ

196
00:12:04,750 --> 00:12:07,040
،مُنِحَ لإغسيم بطلب مُلحّ من قِبَل الامبراطور

197
00:12:07,040 --> 00:12:08,890
.كرمز يعبّر عن قوّتهم القاهرة

198
00:12:08,890 --> 00:12:13,560
يسمح الجيشُ بذلك ما داموا لا يخسرون في مبارزة بالسّيف

199
00:12:21,100 --> 00:12:23,380
لِذا هذا كلّه مجرّد استعراض الغاية منه الاستهزاء

200
00:12:24,270 --> 00:12:27,650
يثمّنُ أفراد عائلة إغسيم
النّظام في الامبراطوريّة كثيراً

201
00:12:27,650 --> 00:12:30,270
،للاستمرار في حملِ سيفين على حزامهم

202
00:12:30,800 --> 00:12:34,730
،لا بدّ أن يُثبِتوا للجميع تفوّقهم

203
00:12:35,280 --> 00:12:38,480
وذلك كي يحموا ذلك النّظام

204
00:12:40,190 --> 00:12:43,100
هل تواجه ياتوري-سان صعوبة أمامه؟

205
00:12:43,100 --> 00:12:46,070
...لا، لم تردّ بعد، لكن

206
00:12:46,070 --> 00:12:47,230
نعم

207
00:12:47,230 --> 00:12:50,450
لم يتغيّر مكانها منذُ بداية المعركة

208
00:12:51,340 --> 00:12:55,830
عائلة إغسيم هي تجسيدٌ لأسطورة الحصانة والقوّة

209
00:13:06,830 --> 00:13:08,740
كانت هجماتك قويّة كالفولاذ

210
00:13:09,460 --> 00:13:12,100
تشرّفتُ بالحصول على فُرصة لمُقاتلتك

211
00:13:13,470 --> 00:13:16,810
!مذهل يا ياتوريشينو إغسيم

212
00:13:21,410 --> 00:13:24,900
هذا ما توقّعتُ أن أراه على ما أظنّ

213
00:13:24,900 --> 00:13:28,290
كلّ هذا لحماية نظام الامبراطوريّة

214
00:13:28,560 --> 00:13:31,310
تخاطرُ بحياتها لحمايتكِ لأنّها تُؤمن

215
00:13:31,310 --> 00:13:33,650
ومن دون شكّ أنّكِ ستؤدّين واجباتكِ

216
00:13:33,650 --> 00:13:37,360
.كفرد في العائلة الامبراطوريّة طيلة حياتكِ

217
00:13:40,060 --> 00:13:43,050
لا تنسي هذا يا سعادة الأميرة

218
00:13:43,550 --> 00:13:45,760
،مهما كانت أحلامكِ عظيمة

219
00:13:46,350 --> 00:13:49,290
لا تنسي هذا

220
00:13:52,280 --> 00:13:55,430
حسناً، لنكون صريحين، أتيتُم إلى هنا
يا جماعة في وقتٍ مُمتاز

221
00:13:56,060 --> 00:13:59,220
،كانت الأمور متوتّرة جدّاً منذُ مدّة قصيرة

222
00:13:59,220 --> 00:14:01,320
.باعتبارها كانت سيّئة للغاية في الحامية الشرقيّة

223
00:14:02,590 --> 00:14:05,320
اعتقدنا أنّهم سيطلبون الإمدادات

224
00:14:05,730 --> 00:14:07,450
ألم ترد الذهاب؟

225
00:14:08,240 --> 00:14:10,700
من ذا الذي يُريد؟

226
00:14:11,060 --> 00:14:14,160
لكن لو كانت هُناك إمدادات كبيرة وكافية

227
00:14:14,160 --> 00:14:16,330
.لرُبَّما تغيّر مسار المعركة

228
00:14:16,920 --> 00:14:20,260
"في الشّمال، نطلِق على النّاس الشُّجعان باسم "الجنود المركزيّون

229
00:14:20,260 --> 00:14:23,440
إنّهم من الأشخاص الذين يبقون متحمّسين
لأداء عملهم

230
00:14:24,660 --> 00:14:28,840
.حتّى بعد القدوم إلى هنا في الشّمال

231
00:14:29,270 --> 00:14:31,920
أشخاص كهؤلاء هم أقلّية هنا

232
00:14:32,500 --> 00:14:36,730
يعزو الفضلُ لجبال ألافاترا

233
00:14:37,870 --> 00:14:38,810
لماذا؟

234
00:14:38,810 --> 00:14:40,200
...هذا صحيح

235
00:14:40,200 --> 00:14:42,930
ألافاترا العظيم هو درجٌ يؤدّي إلى الإله

236
00:14:44,120 --> 00:14:49,820
لم يسبق أن عبرَ عدوٌّ هذه الجبال في تاريخ الامبراطوريّة

237
00:14:50,270 --> 00:14:53,580
نعم، هذا صحيح يا حضرة ضابط الصفّ ريميون

238
00:14:53,960 --> 00:14:55,690
،حتّى من دون المخاطر الخارجيّة

239
00:14:55,690 --> 00:14:58,620
أعتقدُ أنّ هُناك مخاطر داخليّة كائنة هُنا

240
00:14:59,080 --> 00:14:59,830
نعم

241
00:15:00,340 --> 00:15:03,340
عملُنا هو كذلك فحسب

242
00:15:03,710 --> 00:15:07,720
مُراقبة شعوب جبل شيناك، صحيح؟

243
00:15:07,880 --> 00:15:09,720
تماماً

244
00:15:10,500 --> 00:15:14,590
إنّهم امبراطوريّون لكنّهم ليسوا من كاتفارنا

245
00:15:14,590 --> 00:15:19,100
لقد تناوشنا معهم عدّة مرّات

246
00:15:19,480 --> 00:15:24,610
لكن منذُ حوالي سنتين، توقّفوا عن إثارة المشاكل

247
00:15:25,270 --> 00:15:30,490
في الأشهر الستّة الماضية لم نشنّ أي غارات تأديبيّة حتّى

248
00:15:30,620 --> 00:15:33,120
حضرة المُلازم أوّل، ما الفائدة من هذا التّمرين؟

249
00:15:33,710 --> 00:15:36,440
،نحن نمرُّ بنفس المنطقة منذ ثلاث ساعات

250
00:15:36,440 --> 00:15:38,940
.هذا لا يدرّبنا على أي شيء

251
00:15:39,030 --> 00:15:40,260
معك حقّ

252
00:15:41,020 --> 00:15:44,220
هذا خطرٌ نُطلِقُ عليه باسم تمرين

253
00:15:44,720 --> 00:15:49,510
ندعهم يرون قوّاتنا ونستخدم الضغط الصّامت للحفاظ على السّلام

254
00:15:51,470 --> 00:15:54,760
ضابط الصفّ سولورك، أليس لديك ما تقوله؟

255
00:15:57,250 --> 00:15:59,450
تقرير يا حضرة المُلازم أوّل

256
00:15:59,450 --> 00:16:01,520
أحملُ رسالة من ضابط الصفّ سولورك

257
00:16:02,390 --> 00:16:06,670
لقد خرقتُ النظُم العسكريّة ودخلتُ طوعاً"
مُعسكرات الاعتقال

258
00:16:06,670 --> 00:16:11,120
القانون الذي خرقتُه كان مُغادرتي
"...للفرقة أثناء التّمرينات

259
00:16:13,060 --> 00:16:14,450
!أرفضُ قبول هذا

260
00:16:14,770 --> 00:16:19,830
!لماذا تمّت مُصادرة كافّة الكتُب في مُعسكراتنا؟

261
00:16:20,430 --> 00:16:24,580
جنديّة المُشاة كانّا، أهكذا تتكلّمين مع ضابط أعلى منكِ رتبة؟

262
00:16:25,310 --> 00:16:27,090
أتجرؤين على توبيخي وأنتِ بِلا رتبة؟

263
00:16:28,280 --> 00:16:29,850
،إن كان لديكِ الوقت لقراءة الكتُب

264
00:16:29,850 --> 00:16:31,370
!فاذهبي واركضي وعزّزي لياقتكِ

265
00:16:32,720 --> 00:16:33,720
!انتظر

266
00:16:33,980 --> 00:16:36,540
!بما أنّك رددتِ بهذه الطريقة فلا بدّ وأنّ هذا كتابكِ

267
00:16:36,880 --> 00:16:39,220
"سجلّات استطلاع ألافاترا العظيم"

268
00:16:39,220 --> 00:16:44,100
من تأليف الكافر أناراي

269
00:16:44,430 --> 00:16:48,360
!لا علاقة لمُحتويات الكتاب بالمؤلِّف

270
00:16:48,580 --> 00:16:51,000
!لقد سئمتُ منكِ

271
00:16:51,000 --> 00:16:52,950
استعدّي

272
00:16:52,950 --> 00:16:54,240
مهلاً

273
00:16:54,780 --> 00:16:57,240
لا يجوز استعمال هذا الكتاب بهذه الطريقة

274
00:16:58,470 --> 00:17:00,120
!من أنت بالضبط؟

275
00:17:00,520 --> 00:17:03,320
فارس امبراطوري عابر

276
00:17:03,320 --> 00:17:07,960
مهمّتي في الحياة هي مسح كافّة
الدموع عن وجنتي الفتيات في العالم

277
00:17:08,290 --> 00:17:09,730
فارس امبراطوري؟

278
00:17:10,200 --> 00:17:12,340
أحد الفُرسان الذين يتكلّمُ عنه الجميع؟

279
00:17:12,700 --> 00:17:14,860
أعتذر على وقاحتي

280
00:17:14,860 --> 00:17:18,260
لكن ثمّة شيء مُثير جدّاً للاهتمام هنا

281
00:17:18,440 --> 00:17:23,200
اختراع دار النّشر قد جعلَ الحصول
على الكتُب أكثر سهولة

282
00:17:23,200 --> 00:17:25,270
وبعض الكتُب قد حقّقَتْ نجاحاً كبيراً

283
00:17:26,020 --> 00:17:30,270
لكنّها تبقى غير رخيصة بعض الشيء بالنسبة لشخص عاديّ

284
00:17:31,430 --> 00:17:35,350
تبقى هذه الكتُب الكثيرة ثروة حقيقيّة
حتّى لو كانت مُستعمَلة

285
00:17:36,000 --> 00:17:39,000
هذا ما ظننتَه، أليس كذلك يا حضرة المُلازم أوّل؟

286
00:17:39,710 --> 00:17:42,040
!ماذا تقول أيُّها الحقير؟

287
00:17:42,190 --> 00:17:46,210
هل أخذتَها إذاً لتبيعها؟

288
00:17:46,210 --> 00:17:48,030
!لـ-لا تكوني غبيّة

289
00:17:48,290 --> 00:17:49,970
وردة مياكانّي

290
00:17:49,970 --> 00:17:51,130
حياة داليس

291
00:17:51,650 --> 00:17:54,170
انتقاء جيّد

292
00:17:54,170 --> 00:17:56,760
تعلمُ مُسبقاً من سيشتريها، أليس كذلك؟

293
00:17:56,130 --> 00:17:57,300
!أيُّها الحقير

294
00:17:57,300 --> 00:17:59,220
!سئمتُ من ثرثرتك

295
00:17:59,220 --> 00:18:03,890
كنتُ سأدعك وشأنك لأنّك المفضّل
لدى الأميرة الثّالثة

296
00:18:06,560 --> 00:18:10,400
حسناً، سؤال. هل تحبُّ الحشرات يا حضرة المُلازم أوّل؟

297
00:18:10,900 --> 00:18:13,780
!لا يهمّني أمرها! تبقى الحشرات حشرات

298
00:18:14,080 --> 00:18:18,220
لكن هنالك بعض الحشرات السامّة جدّاً

299
00:18:18,220 --> 00:18:21,370
من الخطير مُحاولة التّعامُل معها دون أي معرفة

300
00:18:22,020 --> 00:18:26,250
كأي شيء آخر، قلب الجنديّ قويّ بما يكفي
للتغلُّبِ على هذه الصِّعاب

301
00:18:26,440 --> 00:18:30,780
وثمّة أمر أخير، إن كنتَ تعتقدُ أنّ روح الجنديّ
تمنحُك قوى قاهرة

302
00:18:30,780 --> 00:18:32,130
فسوف تتأذّى

303
00:18:32,410 --> 00:18:34,460
!لا تتكلّم كما لو أنّك تعرف أي شيء

304
00:18:40,990 --> 00:18:41,800
!ها أنت ذا

305
00:18:46,110 --> 00:18:49,300
مبروك نجاح المهمّة يا حضرة الرّقيب ذي السّيقان الطويلة

306
00:18:50,640 --> 00:18:53,020
،يبيتون بعيداً عن أشعّة الشمس المُباشرة في ساعات النّهار

307
00:18:53,020 --> 00:18:56,440
لِذا يمكنُ إيجادها تحت الحواف والأسقُف

308
00:18:56,640 --> 00:19:00,280
لو قرأ هذا الكتاب لرُبَّما علِمَ بذلك

309
00:19:01,030 --> 00:19:02,910
هذا لكِ، صحيح؟

310
00:19:03,030 --> 00:19:06,790
شـ-شكراً لك يا حضرة ضابط الصفّ

311
00:19:07,160 --> 00:19:09,470
أيمكنكِ أن تناديني بإيكّون؟

312
00:19:11,020 --> 00:19:12,170
ما اسمكِ؟

313
00:19:13,260 --> 00:19:16,120
،الحامية الشماليّة الفوج الأوّل

314
00:19:16,120 --> 00:19:18,190
جنديّة المشاة كانّا تيماري

315
00:19:18,190 --> 00:19:20,680
شريكتي هي تاب، روحُ الرّياح

316
00:19:21,610 --> 00:19:23,330
سُرِرتُ بلقائك

317
00:19:23,330 --> 00:19:25,640
المعذرة... إيكّون-دونو

318
00:19:25,880 --> 00:19:27,850
إيكّون-دونو؟

319
00:19:27,850 --> 00:19:29,050
حسناً، هذا يفي بالغرض

320
00:19:29,600 --> 00:19:30,910
كانّا؟

321
00:19:30,910 --> 00:19:33,430
ماذا كان جزءكِ المفضَّل في الكتاب؟

322
00:19:34,530 --> 00:19:38,530
تحليل دين آلديرا على ما أعتقد

323
00:19:39,020 --> 00:19:41,180
دين آلديرا؟

324
00:19:41,800 --> 00:19:44,780
ليس جزء عبادة الرُّوح الخاصّة بأهل شيناك؟

325
00:19:45,550 --> 00:19:46,790
صحيح

326
00:19:46,790 --> 00:19:50,200
ورد فيها أنّه عندما تحلِّلُ دينَ الامبراطوريّة، آلديرا

327
00:19:50,200 --> 00:19:52,670
،على ضوء عبادة روح سيناك

328
00:19:53,000 --> 00:19:57,350
.فإنّك ترى الكثير من الأشياء التي تبدو غريبة

329
00:19:58,950 --> 00:20:03,650
لم أرَ رجلاً يترك التّمارين ليذهب ويتكلّم مع فتيات من قبل

330
00:20:04,310 --> 00:20:07,180
!كانّا! سنرى بعضنا الآخر مجدّداً

331
00:20:07,340 --> 00:20:09,810
!كِلانا طالبا علوم

332
00:20:09,810 --> 00:20:14,310
!إن كنتِ تقرئين ذاك الكتاب فأنتِ تلميذة أناراي مثلي

333
00:20:14,990 --> 00:20:16,980
!أنتِ وأنا تلميذان زميلان

334
00:20:19,690 --> 00:20:21,360
أرى أنّك تستمتع في وقتك

335
00:20:21,360 --> 00:20:25,840
!لكن أتعلم؟ آملُ أن تبقى حيّاً لتراها مجدّداً

336
00:20:23,290 --> 00:20:24,370
تلميذان زميلان؟

337
00:20:30,970 --> 00:20:32,710
حاول أن تتحمّل هذا لمدّة ثلاثة أيّام

338
00:20:32,710 --> 00:20:34,230
لا طعام ولا ماء

339
00:20:34,230 --> 00:20:36,250
!سيقتلني هذا

340
00:20:36,960 --> 00:20:40,760
إلى أن تتمكّن من التوقُّفِ عن الكلام طوال الوقت إذاً

341
00:20:41,280 --> 00:20:45,510
اسمع، ما الذي كنتَ تفكّرُ به عندما وصلتَ
إلى حيثُ أنت الآن؟

342
00:20:46,090 --> 00:20:49,010
%كان حظّاً سيّئاً بنسبة 100

343
00:20:49,760 --> 00:20:51,000
...تبّاً

344
00:20:51,000 --> 00:20:53,140
...سمعتُ أنّك شخص غريب، لكن

345
00:20:55,130 --> 00:20:57,900
!مهلاً! مهلاً! لا تذهب من هنا

346
00:21:00,970 --> 00:21:01,840
!أنت

347
00:21:07,200 --> 00:21:08,700
،حضرة المُلازم أوّل

348
00:21:10,300 --> 00:21:11,640
ما هذا؟

349
00:21:18,130 --> 00:21:19,480
ناناكو دارو

350
00:21:19,720 --> 00:21:21,920
متى نبدأ؟

351
00:21:23,310 --> 00:21:26,090
حربنا لاستعادة هاهاشيكو المسروقة

352
00:21:28,380 --> 00:21:31,350
لن ننتظر مهرجان الرُّوح الممنونة التّالي

353
00:21:31,830 --> 00:21:36,100
هل يمكننا الانتصار على شياطين السُّهول المروعين أولئك؟

354
00:21:37,150 --> 00:21:38,800
أتعلم يا ميرايزي

355
00:21:38,800 --> 00:21:41,730
عالمنا الآن هو عبارة عن نصف فقط

356
00:21:42,340 --> 00:21:43,860
لهذا سنستعيد

357
00:21:44,910 --> 00:21:48,780
