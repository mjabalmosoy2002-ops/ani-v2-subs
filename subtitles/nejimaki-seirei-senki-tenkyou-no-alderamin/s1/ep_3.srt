1
00:00:03,040 --> 00:00:04,710
دعوني بداية

2
00:00:04,710 --> 00:00:07,570
أن أهنّئكم على نجاحكم في الالتحاق

3
00:00:07,570 --> 00:00:10,610
بمدرسة الضابط ذي المستوى الرّفيع
التابعة للقاعدة المركزيّة لامبراطوريّة كاتفارنا

4
00:00:10,610 --> 00:00:14,380
يتضمّنُ هذا الصفّ الخمسة الذين أنقذوا
الأميرة تشاميلي من قبضة العدوّ

5
00:00:14,380 --> 00:00:17,490
ومُنِحوا رتبة الفارس الامبراطوري

6
00:00:18,510 --> 00:00:23,450
لقد قرّرَت الأميرة تشاميلي أيضاً أن تتعلّم معكم

7
00:00:23,450 --> 00:00:26,000
عن عمرٍ صغير وهو الثّانية عشر

8
00:00:26,500 --> 00:00:30,220
آملُ أن تلتمسوا الإلهام من هذا
لتجتهدوا في دروسكم

9
00:02:08,370 --> 00:02:09,900
!اركضوا! استمرّوا في الرّكض

10
00:02:10,230 --> 00:02:13,760
!أنتَ متأخّرٌ دورة كاملة يا ضابط الصفّ إكتا سولورك

11
00:02:14,550 --> 00:02:18,080
لِمَ لا تُلملم أغراضك وتعود إلى المنزل فحسب؟

12
00:02:18,570 --> 00:02:21,340
—تبدو فكرة سديدة لي

13
00:02:21,340 --> 00:02:22,870
!أعلى

14
00:02:23,130 --> 00:02:25,730
!حاضر، حاضر سيّدي

15
00:02:27,020 --> 00:02:30,590
ما الذي فعلتُه لأستحقّ شيئاً كهذا؟

16
00:02:30,590 --> 00:02:32,250
تشجَّع يا إيكّون

17
00:02:32,520 --> 00:02:36,260
لم يبقَ أمامنا سوى تمرين النشّابية
ومُحاضرة وسِباق طويل المسافات في فترة العصر

18
00:02:36,260 --> 00:02:38,920
وهل هذا يحسّنُ مزاجي؟

19
00:02:38,920 --> 00:02:40,290
ولا تُنادِني إيكّون

20
00:02:40,290 --> 00:02:41,510
مرحباً

21
00:02:41,510 --> 00:02:43,510
أيّها الفارس الامبراطوريّ البطيء

22
00:02:44,540 --> 00:02:46,140
من أنتم؟

23
00:02:47,740 --> 00:02:50,850
حضّرنا شيئاً مميّزاً يمنحُك الطّاقة

24
00:02:51,080 --> 00:02:52,350
خذ

25
00:02:53,480 --> 00:02:54,980
لا تخجل، كُل

26
00:02:57,610 --> 00:02:59,400
ما-ماذا؟ هل ستشاجر؟

27
00:02:59,920 --> 00:03:01,210
...واحد، اثنان

28
00:03:06,010 --> 00:03:08,750
شكراً، مئويات الأقدام لها أنيابٌ سامّة

29
00:03:08,750 --> 00:03:11,970
لذا عليك أن تقطع رأسها وإلّا أمسَتْ خطيرة

30
00:03:11,970 --> 00:03:13,130
ضعوا ذلك في الحسبان

31
00:03:13,960 --> 00:03:15,590
هـ-هيّا بنا

32
00:03:17,140 --> 00:03:21,010
أتستخدمون الحشرات ضدّ إكتا؟ أنتُم تجهلون
عدوّكم حقّاً

33
00:03:21,510 --> 00:03:23,540
مع هذا، كان ذلك فظيعاً

34
00:03:23,540 --> 00:03:25,390
ما تحمّلتُه لو كنتُ مكانه

35
00:03:25,670 --> 00:03:28,640
أليسَتْ طريقتهم الطفوليّة ظريفة برأيكم؟

36
00:03:28,640 --> 00:03:32,340
خير وسيلة للتّعامل مع هؤلاء الأصناف هي تجاهلهم

37
00:03:32,340 --> 00:03:34,730
الضُّعفاء لا يعرفون سِوى النُّباح

38
00:03:34,730 --> 00:03:37,270
يبدو كلاماً صحيحاً خاصّة أنّك أنت قائله

39
00:03:37,690 --> 00:03:40,150
لماذا تتكلّمان في آن واحد؟

40
00:03:42,910 --> 00:03:44,260
شكراً على المُرافقة

41
00:03:44,260 --> 00:03:45,530
أقدّر هذا

42
00:03:46,000 --> 00:03:47,240
كلماتُكِ هي شرفٌ لنا

43
00:03:47,240 --> 00:03:49,910
ركّزي على دراستكِ من دون قلق رجاء

44
00:03:55,890 --> 00:03:59,000
هل يمكنني الجلوس هُنا يا ضابط الصفّ سولورك؟

45
00:03:59,490 --> 00:04:03,030
لا المقعد ولا الكرسي ملكاً لي

46
00:04:03,030 --> 00:04:06,890
افعلي ما تشائين يا ضابطة الصفّ تشاميلي

47
00:04:07,940 --> 00:04:09,190
هدوء جميعاً

48
00:04:09,190 --> 00:04:11,390
هذه محاضرة حول التّكتيكات الأساسيّة

49
00:04:13,340 --> 00:04:17,990
سنبدأ بالفصل الثّاني، القسم الرّابع
حول الحرب اليابانيّة

50
00:04:18,680 --> 00:04:21,370
،في العام الامبراطوري 788

51
00:04:21,370 --> 00:04:24,420
أرسِلَتْ بعثة استطلاعيّة إلى دولة اليابان
الواقعة في أقصى الشّرق

52
00:04:24,420 --> 00:04:26,870
والتي هي منطقة جمهوريّة كيوكا في الوقت الحاضر

53
00:04:44,160 --> 00:04:48,620
ما هي المعركة التي أبدعَ فيها ضبّاطها منخفضي الرّتب
بشكل جدير بالملاحظة؟

54
00:04:48,620 --> 00:04:50,310
ضابطة الصفّ تشاميلي؟

55
00:04:53,340 --> 00:04:54,940
الصفحة 132

56
00:04:57,360 --> 00:04:59,940
معركة أ-أبهيليا

57
00:04:59,940 --> 00:05:01,240
صحيح

58
00:05:01,240 --> 00:05:05,070
،والآن أخبرني ما سبب أهمّية هذه المعركة تاريخيّاً

59
00:05:05,570 --> 00:05:06,610
يا ضابط الصفّ سولورك

60
00:05:10,060 --> 00:05:13,920
الضابط القيادي في الجانب الامبراطوريّ
كان النّقيب إلشيم غيورغو

61
00:05:13,920 --> 00:05:16,730
هو ورجاله الثمانمئة في كتيبته المستقلّة

62
00:05:16,730 --> 00:05:20,390
كانوا مُحاصَرين في مُستقنعاتِ أبهيليا
بواسطة ثلاثة فيالق من الجنود اليابونيّين

63
00:05:20,390 --> 00:05:22,630
،والذي يبلغُ عددهم 1600

64
00:05:22,800 --> 00:05:24,870
وكانوا على شفا حفرة من الإبادة

65
00:05:25,880 --> 00:05:27,930
،اقتضَت التّكتيكات آنذاك الانسحاب

66
00:05:27,930 --> 00:05:30,060
لكن طلبَ من رجالِه خلع دروعهم

67
00:05:30,060 --> 00:05:32,140
والقضاء على كلّ قوّة بالتّناوب

68
00:05:32,140 --> 00:05:34,890
قبل أن يتمكّنوا من إعادة تنظيم أنفسهم

69
00:05:34,890 --> 00:05:37,390
"يُدعى هذا عملياً بـ"الهزيمة بإسهاب

70
00:05:37,800 --> 00:05:40,220
المعركة لها أهمّية تاريخيّة

71
00:05:40,220 --> 00:05:45,900
كمثالٍ على كيفيّة تفوّق نصر تكتيكي
على هزيمةٍ استراتيجيّة

72
00:05:45,900 --> 00:05:47,040
ممتاز

73
00:05:47,040 --> 00:05:49,530
لكن هل هذا صحيحٌ فعلاً؟

74
00:05:49,530 --> 00:05:51,380
عبقريّته الفعليّة

75
00:05:56,640 --> 00:05:57,790
أتعي ذلك؟

76
00:05:57,790 --> 00:06:02,530
في حربٍ تكونُ فيه القرارات مُستنِدة على أماكن
،تمركُز الوحدات والقوّة النسبيّة

77
00:06:02,530 --> 00:06:06,300
أضافَ عاملاً جديداً وهو: أين ستكونُ كلّ وحدة في وقت مُعيّن من الزمن

78
00:06:06,760 --> 00:06:09,300
كان ذلك إنجازه الحقيقيّ

79
00:06:09,300 --> 00:06:10,800
!ضابط الصفّ س-سولورك

80
00:06:10,800 --> 00:06:12,620
،لو أردنا التعلّم منه حقّاً

81
00:06:12,620 --> 00:06:15,750
فلا يجوز أن نجلس هنا ونحدِّق بالخريطة فحسب

82
00:06:16,310 --> 00:06:18,690
،يجبُ أن نتصوّرَ الوحدات وهي تتحرّكُ على أرض الواقع

83
00:06:18,690 --> 00:06:21,710
كما لو أنّنا نلعبُ شطرنج معصوبيّ العينَين

84
00:06:22,390 --> 00:06:23,210
هذا كُل ما في الأمر

85
00:06:40,520 --> 00:06:41,890
،أكرهُ قول هذا

86
00:06:41,890 --> 00:06:45,210
لكن بمهاراتك، قد تتمكّن من قنص قائد عدوّ

87
00:06:45,560 --> 00:06:47,230
شكراً يا ما-كُن

88
00:06:47,230 --> 00:06:50,560
،القدرة على قنصِ عدوّ بعيد هو أفضليّة هائلة

89
00:06:50,560 --> 00:06:52,980
لهذا أردتُ إتقان تِلك المهارة أولاً

90
00:06:53,810 --> 00:06:54,970
هذا هدفٌ كبير

91
00:06:55,340 --> 00:06:57,590
أهذا أنت يا تورورو؟

92
00:06:58,250 --> 00:07:01,600
انظر يا سوشورا، وصل الفارسُ الامبراطوريّ

93
00:07:02,470 --> 00:07:05,020
لم أرك منذُ وقتٍ طويل يا تورورو

94
00:07:05,020 --> 00:07:09,990
لقد عدنا للتو من حصن الحاميّة الشماليّة

95
00:07:10,360 --> 00:07:12,030
أأنتَ صديقه؟

96
00:07:12,030 --> 00:07:14,400
اسمي ساريهاسلاغ ريميون

97
00:07:14,400 --> 00:07:16,600
أخوه

98
00:07:16,600 --> 00:07:20,000
والضّخم هو سوشوراف ريميون

99
00:07:20,000 --> 00:07:20,760
وأنت؟

100
00:07:20,760 --> 00:07:23,500
ضـ-ضابط الصفّ ما-ماثيو تيتجيريتش

101
00:07:24,920 --> 00:07:28,200
أحد الخمسة الذين أنقذوا الأميرة الثّالثة، صحيح؟

102
00:07:28,200 --> 00:07:31,260
حسناً، بصِفتي أخيه، ينبغي أن أشكرك

103
00:07:31,260 --> 00:07:33,970
لقد عرقلَك، أليس كذلك؟

104
00:07:33,970 --> 00:07:35,390
أعني أخي الصّغير

105
00:07:35,390 --> 00:07:38,220
...لا، إنّ تورواي في الواقع

106
00:07:38,220 --> 00:07:41,850
لا داعي للدّفاعِ عنه في الوقتِ الذي
لا يستحقُّ فيه الدّفاع

107
00:07:41,850 --> 00:07:44,480
،مع أنّه بارع في القنصِ من بعيد

108
00:07:44,480 --> 00:07:46,930
إلّا أنّ يعزو سبب ذلك إلى عدم
رغبته بالاقترابِ من العدوّ

109
00:07:46,930 --> 00:07:49,230
إنّه جبان للغاية

110
00:07:49,230 --> 00:07:51,030
أليس كذلك يا تورورو؟

111
00:07:53,030 --> 00:07:54,930
لِذا يا ماثيو-كُن

112
00:07:54,930 --> 00:07:57,480
،حالما تبدو الأمور تؤولُ للأسوأ ولو قليلاً

113
00:07:57,480 --> 00:07:59,470
—سيتخلّى عن رفاقه ويهرب

114
00:07:59,470 --> 00:08:01,200
!لن أهرب

115
00:08:02,540 --> 00:08:04,580
،تورورو

116
00:08:04,580 --> 00:08:07,540
من طلبَ منك أن تقاطعني؟

117
00:08:08,520 --> 00:08:09,800
...أ-أنا

118
00:08:09,800 --> 00:08:12,000
!أنت ماذا؟

119
00:08:12,000 --> 00:08:13,730
!أكمل وقلْها

120
00:08:14,200 --> 00:08:18,010
"أشعرُ بالاشمئزاز بمجرّد النَّظر في وجهك"

121
00:08:18,010 --> 00:08:22,020
"ليته ينفجر"

122
00:08:23,430 --> 00:08:25,740
...هذا مُدوّن في منحوتات أليديلانز

123
00:08:25,740 --> 00:08:29,020
"لا رحمة للأوغاد الحمِئين السّاديين"

124
00:08:36,090 --> 00:08:37,310
لا تقلق

125
00:08:37,310 --> 00:08:38,450
قطعتُ الرأس

126
00:08:38,660 --> 00:08:40,200
...إ-إيكّون

127
00:08:40,620 --> 00:08:42,080
كفّ عن مُناداتي بهذا الاسم

128
00:08:42,510 --> 00:08:43,770
من أنت؟

129
00:08:43,770 --> 00:08:44,960
صديق تورورو؟

130
00:08:45,300 --> 00:08:49,020
بعض الوسيمين أستطيعُ تحمّلهم بينما
البعض الآخر لا أستطيع

131
00:08:49,020 --> 00:08:50,880
وأنتَ من المُعسكر الأخير

132
00:08:50,880 --> 00:08:52,750
محكمة الأشكال تُعلِنُك مذنباً

133
00:08:52,750 --> 00:08:55,020
أنتَ محكوكٌ بالانفجارِ فوراً

134
00:08:58,100 --> 00:08:59,130
!إكتا

135
00:09:00,250 --> 00:09:02,050
!كما قلتُ للتو

136
00:09:02,050 --> 00:09:04,400
،تلقّى صديقُه ضربةً أمام ناظريه

137
00:09:04,400 --> 00:09:05,730
!لكنّه خائف جدّاً من إيقافي

138
00:09:06,780 --> 00:09:10,730
لستَ ساديّاً حقيراً فحسب، بل أنتَ غبيّ أيضاً

139
00:09:11,990 --> 00:09:15,550
،لو كنتَ القائد في حربِ استنزاف

140
00:09:15,550 --> 00:09:19,580
لوقعتَ ضحيّةً لاستفزازاتِ العدوّ وأبِدتَ إبادة كاملة

141
00:09:19,580 --> 00:09:21,830
!أما زلتَ تتفوّه بهراء؟

142
00:09:21,830 --> 00:09:23,570
بالتأكيد

143
00:09:23,570 --> 00:09:26,420
،فالهمجيّ يلكمُ شخصاً عندما يشعرُ برغبةٍ في ذلك

144
00:09:26,420 --> 00:09:29,190
،والجنديّ يُهاجمُ عندما يحينُ وقت الهجوم

145
00:09:29,190 --> 00:09:34,050
ويقولُ سولورك كلّ ما يُريده عندما يشعرُ برغبةٍ في ذلك

146
00:09:39,890 --> 00:09:40,890
!أيُّها الحقير

147
00:09:42,560 --> 00:09:43,810
دورك

148
00:09:44,700 --> 00:09:47,020
لا أعرف ما يجري، لكن لا بأس

149
00:09:48,160 --> 00:09:53,150
أرى أنّ التفاعل بين الجنود هو أمرٌ غاية في الخطورة يا ياتوري

150
00:09:53,150 --> 00:09:55,740
...الـ-الأميرة تشاميلي

151
00:09:55,980 --> 00:09:56,910
نعم

152
00:09:56,910 --> 00:10:01,480
أعتقدُ أنّ إكتا طلبَ من زملائه السينباي
أن يبارزوه

153
00:10:01,480 --> 00:10:02,740
إكتا، ما هي القواعد؟

154
00:10:02,740 --> 00:10:06,500
خمسة على واحد، ويُسمَح لك بالهجوم
بعدما يسقطون على ما أعتقد

155
00:10:06,500 --> 00:10:07,760
عُلِم

156
00:10:09,570 --> 00:10:11,860
بما أنّه قد سقط، فأنا، ياتوريشينو إغسيم

157
00:10:11,860 --> 00:10:14,130
سأحلُّ مكانه

158
00:10:14,530 --> 00:10:16,130
لنستأنف

159
00:10:17,440 --> 00:10:18,460
—مهلاً

160
00:10:23,550 --> 00:10:24,940
—لا تعبثي معنا

161
00:10:28,440 --> 00:10:29,440
...والآن

162
00:10:30,240 --> 00:10:31,480
من التّالي؟

163
00:10:32,750 --> 00:10:34,230
لا تغترّي

164
00:10:35,220 --> 00:10:36,850
لا تفعل يا سوشورا

165
00:10:36,850 --> 00:10:37,530
توقّف

166
00:10:37,900 --> 00:10:39,910
كفى شِجاراً

167
00:10:40,310 --> 00:10:44,320
سعادة الأميرة، سنغادر

168
00:10:47,160 --> 00:10:49,340
إيّاك والظنّ أنّها النّهاية

169
00:10:50,140 --> 00:10:51,950
ميل، اصنع بعضاً من الثّلج

170
00:10:51,950 --> 00:10:54,110
...معدتي تؤلمني

171
00:10:54,670 --> 00:10:56,380
...ظهري يؤلمني

172
00:10:57,530 --> 00:10:59,680
لا تقلق

173
00:11:00,100 --> 00:11:02,230
إكتا أقوى بكثير ممّا يبدو

174
00:11:02,230 --> 00:11:03,170
...لكن

175
00:11:03,830 --> 00:11:05,260
...أنا السّبب فيما قامَ به أخو

176
00:11:05,260 --> 00:11:07,470
من أين جئتَ بهذه الفكرة أيُّها الوسيم؟

177
00:11:08,330 --> 00:11:13,440
أفسدَ وسيمٌ ساديّ غفوَتي فرددتُ اعتباري
منه، هذا كلّ شيء

178
00:11:14,320 --> 00:11:15,900
أنتَ مجنون

179
00:11:15,900 --> 00:11:17,440
أعلمُ أنّ ذلك كان مخطَّطاً يا سولورك

180
00:11:18,120 --> 00:11:22,570
أنتَ من بدأ بذلك الشّجار رُغمَ علمك
أنّني وياتوري كنّا قادمتَين

181
00:11:22,920 --> 00:11:24,250
هارو

182
00:11:24,250 --> 00:11:27,110
هل يمكنُكِ أن تسدي إلى هذه الأميرة
التي تريدُ أن تتباهى ببصيرتِها

183
00:11:27,110 --> 00:11:30,580
نصيحة من شيخ ما؟

184
00:11:31,320 --> 00:11:32,610
...لنرَ

185
00:11:33,450 --> 00:11:34,920
الصّمتُ عن بعض الأمور أفضل؟

186
00:11:36,090 --> 00:11:37,520
!أنا آسفة

187
00:11:38,470 --> 00:11:39,970
تورواي

188
00:11:40,530 --> 00:11:42,970
أتعلمُ لماذا نخوضُ حربَ استنزاف؟

189
00:11:43,370 --> 00:11:44,490
أ-أجل

190
00:11:44,890 --> 00:11:47,300
،تخوضُها عندما ترغبُ بتجنُّب معركة حاسمة

191
00:11:47,300 --> 00:11:50,980
وكسب الوقت وانتظار فرصة أخرى، صحيح؟

192
00:11:51,970 --> 00:11:53,480
إن كنتَ تفهم ذلك فهذا جيّد إذاً

193
00:11:54,050 --> 00:11:57,330
لكن في الواقع، هذا هو الأمر الأصعب على الإطلاق

194
00:12:00,950 --> 00:12:01,990
اسمعوا

195
00:12:01,990 --> 00:12:06,490
سيُمنَحُ كلّ شخص منكم الآن فصيلة
من الجنودِ الامبراطوريين

196
00:12:07,080 --> 00:12:09,120
هذه مسؤوليّةٌ كبيرةٌ لِذا تحمّلوها

197
00:12:09,870 --> 00:12:12,080
!حاضر، حاضر سيّدي

198
00:12:12,600 --> 00:12:14,540
ضابطة الصفّ ياتوريشينو إغسيم

199
00:12:14,540 --> 00:12:16,340
!فصيلة فرقة المشاة النّارية

200
00:12:17,860 --> 00:12:19,710
هذا شرفٌ لي يا سيّدي

201
00:12:21,470 --> 00:12:25,090
ضابط الصفّ تورواي ريميون، فصيلة البنادق الهوائيّة 1

202
00:12:26,730 --> 00:12:28,350
هذا شرفٌ لي يا سيّدي

203
00:12:30,760 --> 00:12:32,350
ضابط الصفّ إكتا سولورك

204
00:12:32,820 --> 00:12:34,850
فصيلة فرقة المشاة الضوئيّة

205
00:12:35,930 --> 00:12:38,120
هذا شرفٌ لي يا سيّدي

206
00:12:40,350 --> 00:12:44,110
مبروك تكليفك بقيادة الفصيلة يا ضابط الصفّ سولورك

207
00:12:44,110 --> 00:12:45,990
يسرُّنا حضورك هنا

208
00:12:46,430 --> 00:12:48,650
شكراً لك أيضاً

209
00:12:48,650 --> 00:12:50,200
ما اسمك يا حضرة الرّقيب أوّل؟

210
00:12:50,470 --> 00:12:53,210
أظنُّك تعرف اسمي مسبقاً

211
00:12:53,960 --> 00:12:55,960
ماذا؟ هل سبقَ والتقينا؟

212
00:12:56,840 --> 00:12:58,850
الرّقيب أوّل سويا ميتكاليف

213
00:12:58,850 --> 00:13:01,800
كنتَ على علاقةٍ طيّبة مع أمّي منذُ عامين

214
00:13:04,070 --> 00:13:07,550
...هل أنتِ ابنة آميشيا

215
00:13:07,550 --> 00:13:09,550
أجل، ابنة آميشيا

216
00:13:09,910 --> 00:13:14,730
لكن يا حضرة ضابط الصفّ
لا تلفظ اسمَها مجدّداً رجاء

217
00:13:15,540 --> 00:13:17,840
أيُّها الزّاني

218
00:13:18,700 --> 00:13:21,050
!ابنة امرأة كنتَ تنام معها؟

219
00:13:22,340 --> 00:13:25,110
لا أقول أنّني أقبلُ بالنّكث بعهودِ
امرأة متزوّجة

220
00:13:25,640 --> 00:13:27,610
قيلَ لي أنّها مُطلَّقة

221
00:13:28,070 --> 00:13:32,370
على أي حال، الفصيلة العسكريّة
بأكملها تعلمُ بالأمر

222
00:13:33,190 --> 00:13:36,330
لن يطيع أحدٌ أوامري

223
00:13:36,330 --> 00:13:39,290
لن تدعني سويا أتولّى القيادة

224
00:13:39,290 --> 00:13:40,840
حُلَّ تِلك المعضلة بنفسك

225
00:13:41,230 --> 00:13:43,550
فأنا لا أتعاطف معك البتّة في هذا الأمر

226
00:13:44,690 --> 00:13:46,270
حسناً

227
00:13:46,270 --> 00:13:48,630
لن أطلبَ مساعدتكم بعد الآن

228
00:13:50,690 --> 00:13:53,150
ابقي جالسة من فضلكِ يا فخامتكِ

229
00:13:53,150 --> 00:13:54,640
وأنتَ أيضاً يا تورواي

230
00:13:54,640 --> 00:13:56,130
...لكن يا ياتوري

231
00:13:56,130 --> 00:13:59,400
...لقد خدمَني كثيراً

232
00:13:59,400 --> 00:14:01,900
لا مُبالاته هي ما تسبّبَ بهذا

233
00:14:04,380 --> 00:14:07,220
هذا يعني أنّه لا حاجة للقلق فحسب

234
00:14:07,220 --> 00:14:09,280
،إن كان هذا كافياً لعرقلتِه

235
00:14:09,660 --> 00:14:13,540
لما وجدتُم إكتا سولورك هنا أساساً

236
00:14:13,540 --> 00:14:14,710
توقّفوا

237
00:14:15,440 --> 00:14:17,880
إلى كافّة العناصر، يسار

238
00:14:20,450 --> 00:14:22,540
إنّهم مُدرَّبون أحسن تدريب

239
00:14:27,160 --> 00:14:28,490
انظر هناك

240
00:14:28,490 --> 00:14:30,430
عناصره يتجاهلونه

241
00:14:31,060 --> 00:14:34,410
علينا أن نريه حجمَه

242
00:14:35,590 --> 00:14:36,930
!لـ-لقد نالوا منّا

243
00:14:36,930 --> 00:14:38,940
!هذا سيّئ! سيّئ للغاية

244
00:14:38,940 --> 00:14:40,730
ما هو السيّئ؟

245
00:14:40,730 --> 00:14:42,380
!المعركة الوهميّة

246
00:14:42,380 --> 00:14:44,740
!لقد رسموا تفاصيلها

247
00:14:44,740 --> 00:14:49,150
ستنقسمُ ستّة فصائل إلى فصيلَين
ويتقاتلون بطلقاتٍ طِلائيّة، صحيح؟

248
00:14:49,150 --> 00:14:50,610
!المُشكلة تكمنُ في كيفيّة التّوزيع

249
00:14:51,070 --> 00:14:53,900
في إحدى الطّرفين أنا وإكتا وتورواي

250
00:14:53,900 --> 00:14:58,120
وفي الطّرف الآخر ياتوري والنّقيب ساريهاسلاغ والمُلازم سوشورا

251
00:15:00,300 --> 00:15:05,630
هل سيعودُ الضبّاطُ المتخرِّجون إذاً للتنمُّرِ علينا؟

252
00:15:05,630 --> 00:15:09,010
أنا مُتفاجئة من محبّتِهم لي إلى هذا الحدّ

253
00:15:09,010 --> 00:15:11,390
وهل الوقتُ مناسبٌ للاسترخاء الآن؟

254
00:15:11,660 --> 00:15:14,290
أ-أنا آسف، هذه غلطتي

255
00:15:14,890 --> 00:15:16,810
لا تغترّ كثيراً أيُّها الوسيم

256
00:15:16,810 --> 00:15:20,560
من الواضح بأنّ الهدف الرئيسيّ من انتقاهم هو أنا

257
00:15:20,910 --> 00:15:23,700
بصراحة، ماثيو هو مجرّد مُلحَق

258
00:15:23,700 --> 00:15:24,930
أتّفِق معك

259
00:15:24,930 --> 00:15:26,320
أشعرُ بالشفقة عليه

260
00:15:26,630 --> 00:15:29,820
ولماذا أنتُما لا تتّفِقان معاً إلّا عندما
يتعلّقُ الأمر بمُضايقتي؟

261
00:15:30,350 --> 00:15:32,950
ماذا عن فرقة هارو الطبّية؟

262
00:15:32,950 --> 00:15:36,330
أظنُّنا سنُعالجُ جرحى كلا الطرفَين

263
00:15:36,330 --> 00:15:38,700
عوضاً عن المُشارَكة في القتال

264
00:15:39,010 --> 00:15:41,580
!الوقتُ ليس مناسباً للقلقِ بشأن النّاس الآخرين

265
00:15:42,110 --> 00:15:43,880
اهدأ حالاً يا ماثيو

266
00:15:44,150 --> 00:15:45,880
هذا مجرّد تمرين

267
00:15:45,880 --> 00:15:50,880
لقد خضنا تجربةً حقيقيّةً حيثُ خاطرنا بأرواحنا، صحيح؟

268
00:15:51,140 --> 00:15:54,670
على أي حال، سأغادرُ لتحويل الخطر إلى فرصة ننتهزُها

269
00:15:58,370 --> 00:16:00,790
حسناً، ماذا تريد؟

270
00:16:00,790 --> 00:16:04,050
لستُ بحاجةٍ لمُساهماتك في تمرين التّدريب المقبل

271
00:16:04,050 --> 00:16:06,070
ألن تمنحيني فُرصة حتّى؟

272
00:16:06,610 --> 00:16:10,400
هل السّببُ هو لأنّني نمتُ مع أمّكِ؟

273
00:16:12,200 --> 00:16:13,530
...لا

274
00:16:13,780 --> 00:16:14,990
هكذا إذاً

275
00:16:14,990 --> 00:16:18,470
لن تعرقلي سلسلةَ القيادة إذاً على حقدٍ شخصيّ

276
00:16:19,380 --> 00:16:20,650
ما هو السّبب إذاً؟

277
00:16:20,650 --> 00:16:22,040
...السّبب هو

278
00:16:22,600 --> 00:16:25,540
مؤهّلاتك الجسديّة هي دون المعايير

279
00:16:25,540 --> 00:16:28,300
ولا أراك مناسباً لتكون قائداً على أرض الواقع

280
00:16:29,600 --> 00:16:30,600
أهذا هو السّبب؟

281
00:16:30,600 --> 00:16:32,190
أ-أجل

282
00:16:32,190 --> 00:16:36,180
إن كنتَ جيّداً جدّاً في الأعمال المكتبيّة
فينبغي أن تعمل فيها بدلاً من القيادة

283
00:16:36,670 --> 00:16:37,810
هكذا إذاً

284
00:16:38,600 --> 00:16:42,230
بالمناسبة يا سويا، سمعتِ عن المعركة الوهميّة، صحيح؟

285
00:16:42,230 --> 00:16:44,310
أتعتقدين نفسكِ قادرة على الفوزِ فيها؟

286
00:16:46,810 --> 00:16:49,130
،أكرهُ الاعتراف بذلك

287
00:16:49,130 --> 00:16:51,140
لكن ربّما لا

288
00:16:51,140 --> 00:16:53,650
إنّهم يفوقونني مهارة بكثير

289
00:16:53,930 --> 00:16:57,320
في هذه الحالة، إذا قدتُكم للنصر

290
00:16:57,320 --> 00:17:00,410
فهذا يعني أنّني قائد أفضل منكِ، صحيح؟

291
00:17:00,410 --> 00:17:01,450
...لماذا

292
00:17:01,450 --> 00:17:04,970
لأنّني سأفعلُ شيئاً تعجزين عن أنتِ

293
00:17:04,970 --> 00:17:08,000
لِذا سأثبِتُ على الأقلّ أنّني لستُ بقائد عاجز

294
00:17:12,340 --> 00:17:13,760
مُوافقة

295
00:17:13,760 --> 00:17:15,400
،إن ربِحنا في المعركة الوهميّة

296
00:17:15,400 --> 00:17:18,720
...ولعبتَ أنتَ دوراً جوهريّاً في النّصر

297
00:17:18,720 --> 00:17:21,770
ستدعينني أقودُ الفصيلة؟

298
00:17:22,200 --> 00:17:24,770
لكن ماذا لو خسِرت؟

299
00:17:25,160 --> 00:17:29,740
سأعملُ عملاً مكتبيّاً إذاً كما قلتِ

300
00:17:29,740 --> 00:17:30,770
هل أنتِ موافقة؟

301
00:17:32,730 --> 00:17:34,120
حسناً

302
00:17:46,010 --> 00:17:48,390
هذا الطّقس معضلة حقيقيّة

303
00:17:48,390 --> 00:17:52,390
إنّه يُفسِدُ مُحاولاتنا في إقناعِ أنفسنا
بأنّنا نقضي نزهةً ممتعة

304
00:17:53,430 --> 00:17:55,610
أنا آسف يا ضابط الصفّ ريميون

305
00:17:56,110 --> 00:17:58,930
...لكن لماذا قائدنا... هو

306
00:17:59,460 --> 00:18:00,970
ذاك الرّجل؟

307
00:18:02,020 --> 00:18:03,970
لأنّه الرّجُل الأنسب لذلك

308
00:18:06,730 --> 00:18:09,060
يبعدُ الهدف 30 كيلومتراً نحو الجنوب

309
00:18:09,430 --> 00:18:10,760
سننامُ في الخارج اللّيلة

310
00:18:10,760 --> 00:18:13,270
ونصِل بعد ظهر الغدّ

311
00:18:13,270 --> 00:18:16,710
لا، سننصبُ مخيّماً في المواقع مع حلول اللّيل

312
00:18:17,810 --> 00:18:19,460
اسمع يا ضابط الصفّ

313
00:18:19,460 --> 00:18:22,290
ثلاثين كيلومتراً على خطٍّ مستقيم

314
00:18:22,290 --> 00:18:24,370
—عليك أن تفكّر

315
00:18:24,600 --> 00:18:25,500
نعم

316
00:18:25,500 --> 00:18:27,790
فكّرتُ بالأمرِ طبعاً

317
00:18:27,790 --> 00:18:30,760
على أي حال، هل يمكنكِ أن تخفضي صوتكِ قليلاً؟

318
00:18:30,760 --> 00:18:32,800
فأنتِ تُخيفين العناصر

319
00:18:37,300 --> 00:18:39,770
لا داعي للعجلة يا رجال

320
00:18:39,770 --> 00:18:42,300
فالضّياع سهلٌ في طريقهم المُعقَّد

321
00:18:42,300 --> 00:18:43,980
سيكونُ هذا سهلاً

322
00:18:42,650 --> 00:18:47,790
يبدو أنّ النّقيب ساريهاسلاغ على دراية
بساحة التّدريب هذه جيّداً

323
00:18:47,790 --> 00:18:49,190
ماذا سيفعلُ سولورك؟

324
00:18:50,020 --> 00:18:52,440
توقُّع ما سيفعله إكتا صعبٌ دوماً

325
00:18:52,880 --> 00:18:55,070
حتّى بعدَ معرفته هذه المدّة الطويلة؟

326
00:18:55,730 --> 00:19:00,870
يضعُ في الحسبانِ ما تظنّين أنّه سيفعله أيضاً

327
00:19:01,380 --> 00:19:03,090
بالمناسبة يا فخامتكِ

328
00:19:03,090 --> 00:19:06,810
احرصي على عدمِ وقوعكِ ضحيّة النِّيران المُتبادَلة

329
00:19:07,280 --> 00:19:08,990
ابقي خلفهم طوال الوقت

330
00:19:09,990 --> 00:19:11,330
أعلمُ ذلك

331
00:19:11,830 --> 00:19:15,840
يا رفاق، أخرجتُم ما طلبتُ من أمتعتكم، أليس كذلك؟

332
00:19:16,290 --> 00:19:18,420
حسناً، إلى كافّة الفصائل، اتّجهوا يساراً

333
00:19:21,180 --> 00:19:22,090
!حسناً

334
00:19:22,090 --> 00:19:23,650
!عودة إلى المسير

335
00:19:25,680 --> 00:19:29,690
يا ضابط الصفّ، رمي أمتعتنا هو عملٌ مُخالِف للأوامر

336
00:19:30,090 --> 00:19:32,270
أنا لا أرميها

337
00:19:32,270 --> 00:19:33,440
هذه محطّةُ مخزون

338
00:19:33,890 --> 00:19:36,940
ماذا لو احتجنا لها في المعركة؟

339
00:19:36,940 --> 00:19:38,830
اخترتُ ما تركناه بعناية

340
00:19:38,830 --> 00:19:42,520
يمكنُنا تخفيف طلاء الرّصاص بالماء
لنحظى بالمزيد منه

341
00:19:42,520 --> 00:19:44,480
وبالهياكل الخارجيّة للخيَم

342
00:19:44,480 --> 00:19:45,700
يمكنّنا الاحتماء من الطّقس

343
00:19:45,700 --> 00:19:47,640
—لكن حدّدَ الضبّاط الكبار قائمة

344
00:19:47,640 --> 00:19:52,000
بكيفيّة استخدام الأمتعة بحسبِ ما تراه القيادة البرّية مناسباً

345
00:19:52,000 --> 00:19:53,960
!لهذا السّبب شكَّلنا محطّة تخزين

346
00:20:00,260 --> 00:20:02,720
حسناً، تسجيل الحضور

347
00:20:03,930 --> 00:20:05,970
...وصلنا قبل غروب الشّمس بالفعل

348
00:20:06,590 --> 00:20:08,000
هل سبق وأن أتيت إلى هنا؟

349
00:20:08,000 --> 00:20:09,740
لا، هذه هي المرّة الأولى لي

350
00:20:09,740 --> 00:20:10,900
!أنتَ تكذب

351
00:20:10,900 --> 00:20:14,610
لم تستخدم خريطةً طوال الطريق إلى هنا
!يا ضابط الصفّ

352
00:20:14,610 --> 00:20:18,510
من المُزعِج إخراج الخريطة في كلّ مرّة
أثناء هطول الأمطار

353
00:20:18,860 --> 00:20:22,600
من ناحية أخرى، الخريطةُ هُنا لا تبتلّ
ولا تستغرق وقتاً على الإطلاق

354
00:20:22,600 --> 00:20:24,870
الباقي هو... الخبرة ربّما؟

355
00:20:26,110 --> 00:20:28,940
درّبَني معلّمي مُذ كنتُ صغيراً

356
00:20:28,940 --> 00:20:31,620
العملُ الميدانيّ هو أهمّ عنصر جوهري
من عناصر العلوم

357
00:20:31,620 --> 00:20:32,940
علوم؟

358
00:20:33,390 --> 00:20:36,410
سأذهبُ وألقي نظرة إلى نهر كوريري
إلى الجنوب قليلاً

359
00:20:39,180 --> 00:20:39,880
—ماذا

360
00:20:39,880 --> 00:20:41,440
!انتظر أرجوك

361
00:20:41,440 --> 00:20:43,930
—أفادَت الأوامر بأنّ السّهول الشماليّة كانَتْ حيثُ نحن

362
00:20:43,930 --> 00:20:48,010
أفادَتْ بأنّها كانَت المكان الأمثل
لاجتماع قوّاتنا، هذا كُل ما في الأمر

363
00:20:48,310 --> 00:20:49,810
أستطيعُ تفسير ذلك على أنّه

364
00:20:49,810 --> 00:20:52,810
يُسمَح لي بالتّخييم في أي مكانٍ في الغابة كيفما أشاء

365
00:20:53,320 --> 00:20:55,160
،إذا كان الخيار بيدي

366
00:20:55,160 --> 00:20:58,320
أحتاجُ إلى ساحة معركة تصبُّ في صالحي

367
00:21:06,350 --> 00:21:09,700
إنّنا في منتصفِ النّهار تقريباً ولا أثر لهم إلى الآن

368
00:21:10,130 --> 00:21:12,390
هل سيصلون مع غروب الشّمس؟

369
00:21:13,410 --> 00:21:15,070
النّقيب ساريهاسلاغ

370
00:21:16,000 --> 00:21:18,680
لقد عاد الكشّافين

371
00:21:18,680 --> 00:21:20,700
خيّمَ العدوُّ في الضفّة الأخرى

372
00:21:20,700 --> 00:21:22,720
من نهر كوريري، في جهة الجنوب

373
00:21:23,100 --> 00:21:24,210
!ماذا؟

374
00:21:24,210 --> 00:21:25,870
!يُفترَضُ أن نتقاتل هنا

375
00:21:25,870 --> 00:21:29,470
أفادت كلّ الأوامر بأنّ هذا المكان
سيكون المكان الأمثل للالتقاء

376
00:21:30,290 --> 00:21:33,480
لن أفسّر ذلك على أنّه أوامر بتحديد
المكان الذي سنتقاتلُ فيه

377
00:21:35,200 --> 00:21:37,260
!إ-إلى كافّة القوّات، تقدّموا نحو الجنوب

378
00:21:37,260 --> 00:21:38,480
!بسرعة

379
00:21:38,480 --> 00:21:39,900
حسناً إذاً

380
00:21:39,900 --> 00:21:42,230
ينبغي أن تكون ياتوري قد لاحظَت ذلك الآن

381
00:21:42,520 --> 00:21:45,380
،وسيرتعدُ الوسيم الساديّ ويتوجّه إلى هنا

382
00:21:45,380 --> 00:21:47,870
باعتباره لا يريد أن يتأخّر عن عجزٍ منه

383
00:21:47,870 --> 00:21:50,740
ماثيو، تورواي، جاهزان، صحيح؟

384
00:21:50,950 --> 00:21:51,740
نعم

385
00:21:52,000 --> 00:21:53,000
أجل

386
00:21:54,380 --> 00:21:57,490
السّنة الامبراطوريّة 906، يونيو

387
00:21:57,490 --> 00:22:02,300
قيلَ أنّ هذه المعركة الوهميّة هي المرّة
الأولى التي يُبرِز فيها إكتا سولورك

388
00:22:02,300 --> 00:22:04,650
لمحةً من عبقريّتِه

389
00:23:37,110 --> 00:23:39,860
الحلقة القادمة: كِلاب حِراسة شجرة الرُّوح

390
00:23:37,810 --> 00:23:41,020
كِلاب حِراسة شجرة الرُّوح