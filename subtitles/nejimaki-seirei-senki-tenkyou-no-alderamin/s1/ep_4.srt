1
00:00:06,890 --> 00:00:09,900
يستحقّون الثّناء على وصولهم أبكر ممّا توقّعت
على ما أظنّ

2
00:00:09,900 --> 00:00:12,240
نصبوا قوّاتهم على طول النّهر إذاً

3
00:00:12,910 --> 00:00:14,350
،إن كان الطرفان بقوّة مُكافِئة

4
00:00:14,350 --> 00:00:16,160
فالخاسر هو الطّرف الذي يبادرُ بالهجوم

5
00:00:16,360 --> 00:00:18,450
سنتأمّلُ بعضنا الآخر لبعض الوقت

6
00:00:18,450 --> 00:00:21,890
أخي، لِمَ لا تدع الرّجال يقيسون عمقَ النّهر؟

7
00:00:21,890 --> 00:00:24,810
أعرفُ جيّداً عمقَ نهر كوريري

8
00:00:24,810 --> 00:00:27,030
،منسوب مياه النّهر مرتفع من بعيد

9
00:00:27,030 --> 00:00:27,920
—لِذا فهو بمُستوى الصّدر

10
00:00:29,370 --> 00:00:31,810
هنالك فرقة تغادرُ الرّتل

11
00:00:31,810 --> 00:00:33,170
فصيل سولورك؟

12
00:00:33,460 --> 00:00:35,300
هنالك بقعةٌ ضحلةٌ في جهةِ عكس تيّار النّهر

13
00:00:35,300 --> 00:00:39,070
ينوي إرسال رجاله إلى هُناك ومهاجمتنا من الخلف

14
00:00:39,070 --> 00:00:40,310
!ضابطة الصفّ ياتوريشينو

15
00:00:40,790 --> 00:00:41,610
حاضرة

16
00:00:41,610 --> 00:00:45,730
قودي فرقتكِ إلى عكس تيّار النّهر لاعتراضهم

17
00:00:46,440 --> 00:00:48,810
أليس من الخطير تقسيم قوّاتنا الآن؟

18
00:00:49,160 --> 00:00:51,740
هنالك نهرٌ بيننا

19
00:00:51,740 --> 00:00:53,030
،ما دمنا في وضعيّةٍ دفاعيّة

20
00:00:53,030 --> 00:00:54,640
فالأفضليّة بحوزتنا

21
00:00:58,210 --> 00:01:02,450
ألا ترى أنّه من الغريب أن يجعلوه مكاناً مفيداً لنا؟

22
00:01:02,450 --> 00:01:03,450
!اخرسي

23
00:01:03,450 --> 00:01:05,500
!أطيعي أوامر رئيسكِ

24
00:01:06,330 --> 00:01:11,460
مُواجهة هؤلاء سهلٌ جدّاً بالنسبة لك، أليس كذلك يا إكتا؟

25
00:01:14,340 --> 00:01:16,600
حسناً أيُّها الوسيم السّادي

26
00:01:17,330 --> 00:01:18,470
استعدّ

27
00:01:26,040 --> 00:01:30,370
ضابطة الصفّ، هل ينبغي أن نتوقّف حقّاً بدلاً
من التوجُّه إلى الهدف؟

28
00:01:31,030 --> 00:01:33,490
إن كانوا هنا فيمكنُنا مُلاقاتهم

29
00:01:33,490 --> 00:01:36,900
وإن لم يكونوا هنا فيمكنُنا العودة
إلى الجيش الرئيسيّ بسرعة كبيرة

30
00:01:37,600 --> 00:01:39,950
أفضل تصرُّف نقوم به الآن هو الانتظار

31
00:01:41,660 --> 00:01:43,960
لا أثر لوحدة العدوّ

32
00:01:43,960 --> 00:01:45,030
هل هو فخّ؟

33
00:01:45,390 --> 00:01:46,830
!لنبلغ ضابط الصفّ ياتوريشينو

34
00:01:48,580 --> 00:01:49,710
ماذا؟

35
00:01:51,650 --> 00:01:53,670
أرسلوا كشّافين فحسب إذاً؟

36
00:01:54,090 --> 00:01:55,830
،لكن على الأقلّ

37
00:01:55,830 --> 00:01:59,250
ياتوري-سان بعيدة عن الجيش الرئيسيّ كثيراً

38
00:02:01,900 --> 00:02:02,920
تِلك هي الإشارة

39
00:02:02,920 --> 00:02:04,720
!إلى كافّة الجنود، استعدّوا لإطلاق النّار

40
00:02:10,260 --> 00:02:11,320
!حسناً

41
00:02:14,480 --> 00:02:17,110
!إلى كافّة القوّات، هجوم

42
00:02:28,370 --> 00:02:30,780
صنع جسر في الماء؟

43
00:02:30,780 --> 00:02:33,360
نعم، جسر تحت الماء

44
00:02:33,870 --> 00:02:35,580
تُدعى هذه بشجرة إيسو

45
00:02:35,580 --> 00:02:37,450
إنّه ثقيلةٌ جدّاً ومتينة

46
00:02:37,450 --> 00:02:39,050
سنُغرقُها في الماء

47
00:02:39,390 --> 00:02:42,270
الماء وحليّ لهذا لن يتمكّنوا من رؤيته

48
00:02:42,270 --> 00:02:45,280
وبالتالي، نحنُ الأشخاص الوحيدون الّذين نعلم

49
00:02:45,280 --> 00:02:47,680
بأنّ النّهر لا يحمي أحداً

50
00:02:48,870 --> 00:02:50,910
!لا يمكن أن يكون ضحلاً إلى هذا الحدّ

51
00:02:50,910 --> 00:02:52,580
!أخي، أوامرك

52
00:02:52,580 --> 00:02:55,690
!أطلقوا النّار! أطلقوا عليهم النّار

53
00:03:05,550 --> 00:03:07,010
!كما قالت ضابطة الصفّ

54
00:03:07,010 --> 00:03:10,100
العدوّ عاجز عن التصدِّي لهذا الهجوم المُباغِت

55
00:03:10,630 --> 00:03:14,590
ولدينا ثلاثة فصائل عسكريّة، بينما لديهم فصيلان

56
00:03:17,410 --> 00:03:19,370
!إن مُتَّ فابتعد إذاً

57
00:03:19,370 --> 00:03:20,340
!انسحبوا

58
00:03:20,340 --> 00:03:22,330
!استمرّوا في إطلاق النّار أثناء الانسحاب

59
00:03:23,340 --> 00:03:25,510
!نلتُ منك

60
00:03:30,600 --> 00:03:32,230
!يبدو أنّني وصلتُ في الوقت المناسب

61
00:03:32,630 --> 00:03:34,250
هل أتيتِ إلى هنا بهذه السّرعة يا ياتوري؟

62
00:03:34,250 --> 00:03:36,530
!حسناً يا جماعة، انتهى وقتُ القتال

63
00:03:36,530 --> 00:03:37,980
!انسحاب

64
00:03:39,780 --> 00:03:42,490
!احموا حلفائنا أثناء انسحابهم وتوجّهوا نحو الغابة الشماليّة

65
00:03:54,980 --> 00:03:56,510
لقد عدتُ يا إيكّون

66
00:03:56,840 --> 00:03:59,370
حسبما يبدو، سارت الأمور على ما يُرام

67
00:03:59,370 --> 00:04:00,990
نعم، أظنُّني سعيدٌ بذلك

68
00:04:00,990 --> 00:04:02,910
!ولا تنادِني إيكّون

69
00:04:03,260 --> 00:04:05,090
ماثيو

70
00:04:05,090 --> 00:04:06,970
أما زلتَ حيّاً؟

71
00:04:06,970 --> 00:04:07,740
أجل

72
00:04:07,740 --> 00:04:09,820
بالكاد أنا حيّ

73
00:04:09,820 --> 00:04:12,410
،قضينا على كثير من رجالهم

74
00:04:12,410 --> 00:04:14,610
هل تظنُّ إذاً أنّهم سيستسلمون؟

75
00:04:15,150 --> 00:04:17,100
،بوجودِ الوسيم الساديّ معهم

76
00:04:17,100 --> 00:04:19,400
فقد يدفعهم للقتالِ حتّى آخر رجُل منهم

77
00:04:20,000 --> 00:04:22,470
.ما لم نقتله

78
00:04:24,240 --> 00:04:25,970
لنغيّر تشكيلنا

79
00:04:26,520 --> 00:04:29,120
هارو، تولّي أمرَ الجرحى

80
00:04:29,520 --> 00:04:31,830
هـ-هل رأيتنا هنا؟

81
00:04:31,830 --> 00:04:34,700
...حسناً، بما أنّ المعركة قد انتهت حسبما يبدو

82
00:04:34,700 --> 00:04:36,040
نستأذن

83
00:04:37,550 --> 00:04:42,210
ماذا كانت الخطّة لو أنّ العدوّ قد تفقّدَ
عمقَ النّهر قبلنا؟

84
00:04:43,350 --> 00:04:47,980
يعرفُ منطقةَ التّدريب هذه خير المعرفة
ما يعني أنّ احتمالات قيامه بذلك ضئيلة

85
00:04:47,980 --> 00:04:50,480
وإن فعلَ ذلك

86
00:04:50,480 --> 00:04:52,430
فإنّ بنادقنا الهوائيّة كانَتْ ستمنعهم من ذلك

87
00:04:57,450 --> 00:04:59,060
سأجمع النّجاة معاً

88
00:04:59,380 --> 00:05:01,250
نعم، شكراً

89
00:05:01,720 --> 00:05:04,610
يبدو أنّك خدعتَهم يا سولورك

90
00:05:04,610 --> 00:05:07,260
كان ينبغي أن ترى نظرة عينيه

91
00:05:07,260 --> 00:05:09,320
ما زلنا نؤدّي تمريناً تدريبيّاً هنا

92
00:05:09,320 --> 00:05:12,000
اغربي عن وجهي أرجوكِ يا أميرة

93
00:05:21,250 --> 00:05:22,680
!اللّعنة

94
00:05:23,850 --> 00:05:25,170
!ياتوريشينو

95
00:05:25,170 --> 00:05:27,400
!كان ينبغي أن تصلي إلى هناك في وقتٍ أبكر

96
00:05:27,950 --> 00:05:29,360
أنا آسفة

97
00:05:29,360 --> 00:05:31,660
،لو كانت لديك فرقة قادرة على التحرّك بشكلٍ أسرع

98
00:05:31,660 --> 00:05:33,060
لوددتُ رؤية ذلك

99
00:05:34,510 --> 00:05:35,500
أخي

100
00:05:36,170 --> 00:05:38,010
ما هو تحرّكنا التالي؟

101
00:05:38,950 --> 00:05:41,480
ينبغي أن يأتوا صوبنا

102
00:05:41,480 --> 00:05:44,240
،سننصبُ كميناً لهم في الطريق إلى الغرب

103
00:05:44,240 --> 00:05:46,450
!ومن ثمّ نُمسِك بهم بتشكيلِ الكمّاشة

104
00:05:46,990 --> 00:05:50,050
!استمتع بنصرك ما دامت الفُرصة متاحة يا إكتا سولورك

105
00:05:50,650 --> 00:05:55,450
!سأمسح ابتسامة المعتدّ بنفسه عن وجهِك الغبيّ

106
00:05:55,650 --> 00:06:00,300
ولعلّه الآن يتحرّقُ شوقاً للانتقام الآن

107
00:06:00,300 --> 00:06:04,720
بناء على هذا، لن نستهدفهم نحن

108
00:06:05,640 --> 00:06:07,840
كيف سنربح إذاً؟

109
00:06:08,180 --> 00:06:12,600
سويا، أرجو أن تنسى فكرة مطاردتنا للعدوّ

110
00:06:13,360 --> 00:06:15,090
،مطاردة شخص ما هو أمر متعب

111
00:06:15,090 --> 00:06:17,060
لكنّ التعرُّض للمُطارَدة هو مُنهِك نفسياً

112
00:06:17,060 --> 00:06:20,350
لكن دفع شخص ما على مُطاردتك قد يكون ممتعاً

113
00:06:20,860 --> 00:06:23,700
الحرب هي كما الحبّ من هذه النّاحية

114
00:06:27,120 --> 00:06:28,750
ما الذي يجري؟

115
00:06:28,750 --> 00:06:31,080
أليسوا مهتمّين بالقتال الفعليّ؟

116
00:06:32,150 --> 00:06:33,790
!تقرير

117
00:06:33,790 --> 00:06:37,270
فصائل العدوّ الثّلاثة قد نشروا جنودهم

118
00:06:37,270 --> 00:06:39,070
!لسدِّ المخرج الشمالي للغابة

119
00:06:40,460 --> 00:06:41,720
ما الذي يخطِّطون له؟

120
00:06:42,650 --> 00:06:43,630
لقد نالوا منّا

121
00:06:44,250 --> 00:06:46,510
لقد قطعوا طريق هربنا يا حضرة القائد

122
00:06:47,490 --> 00:06:52,150
في لحظة ما، علينا استخدام المخرج
الشّمالي للوصول إلى القاعدة المركزيّة

123
00:06:52,510 --> 00:06:56,010
،إذا سدّوا المخرج في نهاية المعركة الوهميّة

124
00:06:56,010 --> 00:06:59,140
سنخسرُ لأنّنا لن نتمكّن حتّى من العودة إلى الدّيار

125
00:07:00,420 --> 00:07:04,270
هل ربِحوا إذاً؟

126
00:07:05,270 --> 00:07:07,020
!

127
00:07:08,560 --> 00:07:09,940
ها هُم

128
00:07:10,320 --> 00:07:11,240
حسناً، إلى كافّة الوحدات

129
00:07:11,240 --> 00:07:13,490
أوهموهم بأنّكم تتهيّأون لإطلاق النّار

130
00:07:13,860 --> 00:07:17,410
.بينما تهيّأوا للهجوم في واقع الأمر

131
00:07:17,410 --> 00:07:18,710
،لا تبتعدوا كثيراً

132
00:07:18,710 --> 00:07:21,750
.وتعاونوا مع من في جواركم

133
00:07:22,600 --> 00:07:24,650
،مُقارنة بقيمة التّعاون الجماعي

134
00:07:24,650 --> 00:07:28,510
.نَيل شرف أوّل من يدخل إلى خطوط جبهتهم لا قيمة له

135
00:07:28,820 --> 00:07:31,520
!هيّا، اصطفّوا

136
00:07:31,520 --> 00:07:33,640
أخي، هل سنهجم؟

137
00:07:33,640 --> 00:07:34,300
أجل

138
00:07:34,760 --> 00:07:38,400
الخطّ الحدودي لمنطِقة القتال يقعُ خلفهم

139
00:07:38,400 --> 00:07:40,910
،إذا تجاوزَ أحدُهم ذلك الخطّ

140
00:07:40,910 --> 00:07:42,770
!فسيخسرون نتيجة خرقهم للقواعد

141
00:07:43,270 --> 00:07:46,780
اسمعوا يا رجال، حتّى لو متُّم، لا تسقطوا فوراً

142
00:07:46,780 --> 00:07:50,280
!ادّعوا أنّكم لم تنتبهوا واضغطوا عليهم

143
00:07:50,480 --> 00:07:52,380
...لكن هذا مُخالف للقواعد

144
00:07:52,380 --> 00:07:53,280
!صه

145
00:07:57,740 --> 00:08:02,250
!حسناً، إلى كافّة القوّات، هجوم

146
00:08:19,930 --> 00:08:23,190
!تورواي، أيُّها الحقير

147
00:08:25,280 --> 00:08:29,360
!إلى كافّة الجنود، هجوم

148
00:08:38,150 --> 00:08:39,120
المُلازم شوشوراف

149
00:08:39,400 --> 00:08:40,960
لقد سقطَ القائد

150
00:08:40,960 --> 00:08:42,620
تولَّ القيادة

151
00:08:42,800 --> 00:08:44,200
حسناً إذاً

152
00:08:44,200 --> 00:08:46,230
الفوز في هذه المعركة مستحيل

153
00:08:46,230 --> 00:08:48,790
!سنشقُّ طريقنا ونهرب

154
00:08:50,760 --> 00:08:53,090
!مهِّدي طريقاً يا ياتوريشينو

155
00:08:53,900 --> 00:08:55,470
!عُلِم

156
00:08:56,520 --> 00:08:58,660
!إلى كافّة الجنود، إلى الأمام

157
00:09:08,180 --> 00:09:09,800
لا أًصدِّق هذا

158
00:09:10,290 --> 00:09:13,650
...هل يعني هذا أنّنا

159
00:09:14,400 --> 00:09:16,940
،عجِزنا عن القضاء عليهم

160
00:09:16,940 --> 00:09:18,780
لكن يُعَدُّ انتصاراً، أجل

161
00:09:20,930 --> 00:09:22,230
...نحنُ حقّاً

162
00:09:24,730 --> 00:09:28,070
حسناً يا جماعة، اهدأوا

163
00:09:28,070 --> 00:09:32,050
حان وقتُ المُحاضرة لرجالنا الأحبّاء

164
00:09:32,410 --> 00:09:33,920
جندي المُشاة ويمب

165
00:09:34,310 --> 00:09:35,800
جندي المُشاة آيغي

166
00:09:36,250 --> 00:09:37,880
جندي المُشاة بيو

167
00:09:38,200 --> 00:09:39,300
العريف توباي

168
00:09:39,820 --> 00:09:41,270
تقدّموا

169
00:09:42,310 --> 00:09:44,060
،أنتُم

170
00:09:44,600 --> 00:09:46,100
،حذّرتُكم كثيراً

171
00:09:46,100 --> 00:09:48,730
ومع ذلك اندفعتُم للأمام كثيراً أثناء الهجوم

172
00:09:48,730 --> 00:09:49,910
ماذا كان ذلك بالضبط؟

173
00:09:49,910 --> 00:09:53,070
لا يحتاجُ فصيل إكتا لأبطال

174
00:09:53,070 --> 00:09:55,670
بدلاً من مُحاولة الفوز في معركة ضدّ
ثلاثة رجال بمفردِك

175
00:09:55,670 --> 00:09:59,660
جِد وسيلةً تستطيعُ من خلالها أن تواجه
أنتَ ورفيقاك رجلاً واحداً

176
00:10:00,330 --> 00:10:03,200
هذه هي الطريقةُ العلميّة في التَّفكير

177
00:10:03,540 --> 00:10:04,530
"علميّة؟"

178
00:10:04,880 --> 00:10:06,050
ماذا يعني هذا؟

179
00:10:06,430 --> 00:10:08,250
.منطقيّة، انسيابيّة، وفعّالة

180
00:10:08,250 --> 00:10:11,020
ونتيجة ذلك، تمهّدُ لكم الطريق نحو الكسل

181
00:10:11,020 --> 00:10:12,840
إنّها طريقة رائعة في التّفكير

182
00:10:13,720 --> 00:10:15,830
بدأ النّاس يحصدون المحاصيل لأنّ الخروج

183
00:10:15,830 --> 00:10:18,630
للصيد دون معرفة ما إن كنتَ ستصطادُ شيئاً

184
00:10:18,630 --> 00:10:20,080
.كان مُتعِباً للغاية

185
00:10:20,790 --> 00:10:26,220
حفرَ النّاسُ الآبار لأنّ السّير نحو
النّهر كان متعباً للغاية

186
00:10:26,840 --> 00:10:31,870
نجمَ تطوُّر البشر عن الرّغبةِ بالتّكاسُل

187
00:10:31,870 --> 00:10:34,210
ولا يختلف هذا في مجال الحرب بالطبع

188
00:10:34,690 --> 00:10:37,360
،إن كان بمقدورِك التّكاسُل أثناء خوض حرب
يجب أن تُتقِن عملك

189
00:10:38,400 --> 00:10:42,670
.لذا اتبعوني أنا، إكتا سولورك

190
00:10:42,670 --> 00:10:47,000
يخوضُ رجالُ إكتا سولورك معركة سهلة، ويربحون بسهولة

191
00:10:47,500 --> 00:10:48,910
!يحيا الكسل

192
00:10:48,910 --> 00:10:50,250
!يحيا التّراخي

193
00:10:51,260 --> 00:10:54,860
كلّ من يتبعني

194
00:10:54,860 --> 00:10:56,510
يعيشُ حياةً سهلة

195
00:11:00,850 --> 00:11:03,050
...إكتا سولورك

196
00:11:04,500 --> 00:11:07,560
!إكتا سولورك

197
00:11:11,000 --> 00:11:12,950
ماذا؟

198
00:11:12,950 --> 00:11:15,070
ما الذي يجري؟

199
00:11:14,160 --> 00:11:17,070
!إكتا سولورك! إكتا سولورك

200
00:11:15,400 --> 00:11:16,590
ماذا؟

201
00:11:18,050 --> 00:11:22,490
أصبح إيكّون مشهوراً حقّاً في غفلةٍ منّي

202
00:11:22,490 --> 00:11:25,040
لا، بل حدثَ ذلك بينما كنّا نحدِّق

203
00:11:25,530 --> 00:11:28,540
لقد تأثّرت، ولا أعرف السّبب

204
00:11:28,950 --> 00:11:32,580
لعلِّي قد بالغتُ قليلاً

205
00:11:33,380 --> 00:11:35,470
حسناً يا جماعة، اهدأوا

206
00:11:35,470 --> 00:11:36,700
فهمت، فهمت

207
00:11:36,700 --> 00:11:38,790
شكراً لكم، شكراً لكم

208
00:11:39,620 --> 00:11:40,830
!تورواي

209
00:11:40,830 --> 00:11:41,470
ماذا؟

210
00:11:42,020 --> 00:11:44,260
هل نجحَتْ حربُنا المُطوَّلة؟

211
00:11:48,520 --> 00:11:51,770
كنّا قادرين على انتظارِ أنسب فُرصة
يمكنُنا انتهازها

212
00:11:52,120 --> 00:11:53,100
هكذا إذاً

213
00:11:53,570 --> 00:11:54,550
جيّد

214
00:11:54,550 --> 00:11:59,190
رأيتُ الأميرة تشاميلي بينما كنتُ أختبئ في الغابة

215
00:11:59,490 --> 00:12:04,000
كانت تركضُ نحو الغرب برفقةِ حرّاسها الملكيين

216
00:12:04,000 --> 00:12:05,910
لعلَّها ذهبَتْ لرؤية ياتوري، صحيح؟

217
00:12:06,590 --> 00:12:09,900
ذلك الاتّجاه خاطئ تماماً يا ماثيو

218
00:12:09,900 --> 00:12:12,920
ينبغي أن تكون الأميرة على علمٍ بذلك

219
00:12:12,920 --> 00:12:15,540
لا سبب يدفعُها للتوجُّهِ غرباً

220
00:12:20,950 --> 00:12:21,880
...أين

221
00:12:21,880 --> 00:12:23,300
أين سولورك؟

222
00:12:27,500 --> 00:12:28,880
!أيُّها الحقير

223
00:12:29,620 --> 00:12:31,150
!سعادة الأميرة، اهربي

224
00:12:38,960 --> 00:12:43,320
إذاً جرح سولورك كان طعماً لاستدراجي؟

225
00:12:45,980 --> 00:12:47,640
القائد إيسون هو

226
00:12:48,200 --> 00:12:49,840
لماذا تفعلُ هذا؟

227
00:12:59,280 --> 00:13:00,600
...سولورك

228
00:13:06,650 --> 00:13:09,280
المعركة الوهميّة على وشك أن تنتهي

229
00:13:09,280 --> 00:13:11,160
هل نُرسِلُ إشارةَ الاستسلام؟

230
00:13:12,340 --> 00:13:13,640
استسلام؟

231
00:13:13,640 --> 00:13:15,030
ولماذا نفعلُ ذلك؟

232
00:13:15,030 --> 00:13:18,730
حضرة القائد، المُلازم شوشوراف هو المسؤول الآن

233
00:13:18,730 --> 00:13:20,560
لن أسمح بحدوث هذا

234
00:13:20,560 --> 00:13:23,240
!لن أستسلم أبداً

235
00:13:23,600 --> 00:13:26,230
الرّفض لن يضرّ إلّا بسمعتِك

236
00:13:26,230 --> 00:13:28,370
القائد الذي لم يقوَ على الاستسلام

237
00:13:30,430 --> 00:13:34,880
إن استسلمتَ الآن فيمكنُك أن تقول
أنّك نجحتَ في انسحابك الأخير

238
00:13:37,520 --> 00:13:39,000
اصنع القرار الصّائب يا سيّدي

239
00:13:49,220 --> 00:13:51,850
يتواصلون بالصّوت بدلاً من التّواصل بالضوء؟

240
00:13:53,420 --> 00:13:55,640
"الغرب... الأميرة"

241
00:13:57,750 --> 00:14:02,140
ياتوريشينو إغسيم وجنودها الثّمانية
سيتوجّهون غرباً

242
00:14:02,140 --> 00:14:03,700
تلك الإشارة؟

243
00:14:03,700 --> 00:14:04,640
أجل

244
00:14:04,640 --> 00:14:06,500
يبدو أنّه حدث شيء ما

245
00:14:06,500 --> 00:14:09,350
خذي الاثنين المتبقّيين من فرقتي

246
00:14:10,740 --> 00:14:13,990
لقد أنقذتِ أخي الأكبر أثناء المعركة الأولى

247
00:14:14,650 --> 00:14:16,750
أنا مُمتنٌّ لذلك

248
00:14:20,310 --> 00:14:21,560
،إن تمكنَّا من بلوغ الطريق

249
00:14:21,560 --> 00:14:23,630
.سنجدُ العربة في انتظارنا

250
00:14:24,240 --> 00:14:26,170
.ومن ثمّ ستكتملُ المهمّة

251
00:14:26,680 --> 00:14:27,630
هذا صحيح

252
00:14:28,180 --> 00:14:29,890
لقد شارفنا على الانتهاء

253
00:14:30,540 --> 00:14:32,280
،إن كان النّظر إلى الأميرة يجرحك

254
00:14:32,280 --> 00:14:33,770
.فلا تنظر إذاً

255
00:14:33,770 --> 00:14:36,160
تعلمُ أنّك كنتَ مُشاركاً منذُ البداية

256
00:14:38,230 --> 00:14:38,990
حاضر

257
00:14:48,150 --> 00:14:51,470
قشَبوا الرّأسَ بدلاً من محاولة استخدام رأس سهم؟

258
00:14:51,830 --> 00:14:55,360
لو كنتُم فصيلاً ضوئياً لحاولتُم إبهار عيوننا

259
00:14:55,810 --> 00:14:58,490
ومُحال أن تكونوا مُسعفين

260
00:14:59,040 --> 00:15:03,660
بعبارة أخرى، أنتُم فصيلٌ ناريّ تنقصُه التّجهيزات

261
00:15:03,660 --> 00:15:06,690
أليس كذلك يا ضابطة الصفّ ياتوريشينو إغسيم؟

262
00:15:07,570 --> 00:15:10,680
والآن أطلقوا رشقاتكم الثّانية

263
00:15:10,680 --> 00:15:11,800
...حينها نحن سـ

264
00:15:13,670 --> 00:15:16,340
،أتعرف أين نحن

265
00:15:16,780 --> 00:15:18,120
أيّها القائد إيسون هو؟

266
00:15:19,010 --> 00:15:20,460
لا تتحرّك

267
00:15:20,460 --> 00:15:23,540
حركة واحدة وسيسقط رأسك أرضاً

268
00:15:24,090 --> 00:15:25,390
عظيم

269
00:15:25,390 --> 00:15:28,880
إلى كافّة القوّات، أطلقوا عليها النّار حالاً

270
00:15:33,100 --> 00:15:34,450
أنتَ محظوظ

271
00:15:35,400 --> 00:15:39,100
يبدو أنّهم لا يُريدونك أن تموت

272
00:15:40,690 --> 00:15:43,670
ظننتُ نفسي قد درّبتُهم جيّداً

273
00:15:46,160 --> 00:15:47,340
...سعادة الأميرة

274
00:15:47,640 --> 00:15:49,920
ياتوري؟

275
00:15:50,640 --> 00:15:52,180
أين أنا؟

276
00:15:52,180 --> 00:15:54,950
سعادة الأميرة، هل تأذّيتِ؟

277
00:15:55,920 --> 00:15:57,060
!اتركني

278
00:15:58,160 --> 00:15:59,530
اهدئي أرجوكِ

279
00:15:59,530 --> 00:16:01,110
سأنقذكِ حالاً

280
00:16:01,110 --> 00:16:02,640
...لكن... لكن

281
00:16:02,640 --> 00:16:03,650
...إنّ سولورك

282
00:16:05,600 --> 00:16:07,430
سيأتي إكتا إلى هنا قريباً

283
00:16:08,010 --> 00:16:09,650
أطلق سراح الأميرة

284
00:16:14,780 --> 00:16:17,250
سأخبركِ بدافعنا

285
00:16:17,540 --> 00:16:18,640
دافع؟

286
00:16:19,200 --> 00:16:22,290
سأخبركِ عن سببِ تخلّينا عن كبريائنا كجنود

287
00:16:22,290 --> 00:16:24,370
.وتصرّفنا الطائش هذا

288
00:16:24,790 --> 00:16:29,410
كلّنا تلاميذ للضابط الفريق هازاف ريكان

289
00:16:30,550 --> 00:16:32,370
...الفريق ريكان

290
00:16:32,370 --> 00:16:35,180
كان قائداً موهوباً

291
00:16:35,180 --> 00:16:39,890
لكنّه توفّي أثناء المعركة في الحاميّة الشرقيّة

292
00:16:39,890 --> 00:16:42,820
...إذاً هدفك هو

293
00:16:42,820 --> 00:16:45,050
أجل يا سعادة الأميرة

294
00:16:45,500 --> 00:16:49,010
،سنثأرُ لمعلّمنا

295
00:16:49,010 --> 00:16:51,380
،الذي قُتِلَ أثناء تستُّره على فشلٍ سياسي

296
00:16:51,790 --> 00:16:55,850
!بحياتك الّتي لا قيمة لها

297
00:16:55,850 --> 00:16:57,280
...سعادة الأميرة، من فضلك

298
00:17:11,790 --> 00:17:14,240
لكن يستحقُّ الأمرُ العناء بين الفيّنة والأخرى

299
00:17:14,240 --> 00:17:16,180
يُرجى الانتباه ممّا يحيطُ بنا

300
00:17:16,180 --> 00:17:17,510
!توقّف

301
00:17:16,880 --> 00:17:17,510
أيّها الرُّوح

302
00:17:18,100 --> 00:17:19,860
حركة واحدة وتموت سيّدتك

303
00:17:19,600 --> 00:17:20,810
!ابتعد عنّي

304
00:17:22,210 --> 00:17:25,280
!توقّف! اترك ياتوري

305
00:17:27,340 --> 00:17:30,010
...أ-أميرة

306
00:18:27,190 --> 00:18:31,540
هل أنتِ بخير يا سعادة الأميرة؟

307
00:18:32,150 --> 00:18:33,560
...يسرُّني هذا

308
00:18:40,620 --> 00:18:43,470
...يدايّ لا تُفلتان سيفي

309
00:18:45,030 --> 00:18:48,480
تبّاً، تسبّبتِ بفوضى مجدّداً

310
00:18:48,480 --> 00:18:51,090
لن أتمكّن من أكل الطماطم لبعض الوقت

311
00:18:51,610 --> 00:18:52,830
...إكتا

312
00:18:53,760 --> 00:18:55,110
ياتوري

313
00:18:55,720 --> 00:18:57,360
،لعلّكِ تعلمين هذا

314
00:18:57,360 --> 00:18:59,990
لكن يملؤكِ اللّون الأحمر الآن

315
00:19:02,490 --> 00:19:04,450
،لا أمانع أن أكون حمراء اللّون

316
00:19:04,890 --> 00:19:07,480
لكن لا أحبّ أن تفوح رائحةٌ
كرائحة المعدن من جسدي

317
00:19:08,330 --> 00:19:09,990
رائحة؟

318
00:19:09,990 --> 00:19:12,290
لا علاقة لهذا بلونكِ الأحمر

319
00:19:13,210 --> 00:19:16,810
هذا لأنّك تُمسِكين بهذه الكتل المعدنيّة
الكبيرة بيديكِ، صحيح؟

320
00:19:18,880 --> 00:19:22,720
مهما حدث، لا تنسي أنّني يدكِ اليُسرى

321
00:19:28,370 --> 00:19:29,650
حسناً، تخلّصتِ منها

322
00:19:30,410 --> 00:19:31,450
أحسنتِ صنعاً

323
00:19:38,470 --> 00:19:39,900
شكراً لك

324
00:19:41,570 --> 00:19:44,040
...لكن أتعلم

325
00:19:44,580 --> 00:19:46,930
قد أكون متعبة قليلاً

326
00:19:48,250 --> 00:19:50,780
تُنهكين نفسكِ بالعمل دوماً

327
00:19:51,140 --> 00:19:53,740
أقولُ لكِ مراراً أنّكِ عليكِ أن تتكاسلي أكثر

328
00:20:03,820 --> 00:20:07,810
هلّا شرحت الأمر لي أيُّها القائد إيسون هو؟

329
00:20:08,450 --> 00:20:12,600
قـ-قالوا أنّهم كانوا تلاميذاً للفريق ريكان

330
00:20:15,180 --> 00:20:18,490
،أتفهّمُ ذلك كلّياً

331
00:20:18,490 --> 00:20:21,180
.ولا أرغب بإدانتكم

332
00:20:21,180 --> 00:20:24,160
كان بمقدوركم أن تطلبوا منّي الانضمام إليكم

333
00:20:27,800 --> 00:20:28,830
!إكتا

334
00:20:29,370 --> 00:20:33,040
...تكتيكاتك مُشابهة تقريباً لتكتيكات الفريق ريكان

335
00:20:33,410 --> 00:20:38,400
لا بل معلّمه، بادا سانكري

336
00:20:38,400 --> 00:20:43,060
أهذه صدفة؟

337
00:20:43,360 --> 00:20:44,800
...هذا

338
00:20:54,220 --> 00:20:55,330
إيكّون

339
00:20:55,330 --> 00:20:56,310
انتهى الأمر

340
00:20:56,930 --> 00:20:58,580
أجل

341
00:20:58,580 --> 00:21:00,520
لقد كانَتْ أيّام قليلة متعِبة

342
00:21:01,050 --> 00:21:04,780
كانَتْ رحلة تخييمنا القصيرة في كيوكا أسهل بكثير

343
00:21:06,880 --> 00:21:08,510
سعادة الأميرة

344
00:21:08,510 --> 00:21:11,020
يبدو أنّكِ حصلتِ على فُستانٍ جديدٍ ذي ألوان زاهية

345
00:21:11,020 --> 00:21:14,510
أم أنّكِ سكبتِ كثيراً من صلصةِ الطّماطم على نفسكِ؟

346
00:21:14,510 --> 00:21:15,870
التّمييز صعب

347
00:21:16,450 --> 00:21:19,570
بالمناسبة، هذا سرّ

348
00:21:19,870 --> 00:21:23,010
لكنّكِ حمراء حقّاً الآن

349
00:21:25,650 --> 00:21:27,010
...إكتا

350
00:21:38,630 --> 00:21:40,420
لماذا؟

351
00:21:40,970 --> 00:21:45,040
!سولورك! سولورك، أيُّها التّافه

352
00:21:48,060 --> 00:21:51,230
العام الامبراطوري 906، يونيو

353
00:21:51,230 --> 00:21:56,060
قليل من النّاس يعلمون بهذه الهديّة الأخيرة
للفريق هازاف ريكان

354
00:21:56,420 --> 00:21:59,960
لكن لا ننكر أيضاً أنّ أصحاب الصِّلة بالأمر

355
00:21:59,960 --> 00:22:04,190
قد تُرِكوا بجروحٍ لن تتلاشى أبداً في قلوبهم

356
00:23:37,300 --> 00:23:40,940
الحلقة القادمة: اثنان هما واحد

357
00:23:37,680 --> 00:23:40,940
اثنان هما واحد