1
00:00:10,000 --> 00:00:14,540
هذا ليس عدلاً، لا يُعاملونني إلّا كطفل في أوقات كهذه

2
00:00:21,990 --> 00:00:23,660
...مؤلم

3
00:00:26,290 --> 00:00:28,420
أتيتُ في زيارة ليليّة يا إكتا

4
00:00:28,420 --> 00:00:30,110
أنتِ؟

5
00:00:30,510 --> 00:00:32,540
أخفتِني يا نانا

6
00:00:32,540 --> 00:00:33,470
حسناً؟

7
00:00:33,470 --> 00:00:34,720
ماذا تعني زيارة ليليّة؟

8
00:00:34,720 --> 00:00:36,160
ألا تعرف معناها؟

9
00:00:36,160 --> 00:00:39,060
في ليلة المهرجان، تزور امرأة

10
00:00:39,060 --> 00:00:40,800
رجلاً تحبّه في السّرير

11
00:00:40,800 --> 00:00:41,950
وبعد؟

12
00:00:41,950 --> 00:00:43,230
ماذا يحدث بعد ذلك؟

13
00:00:44,560 --> 00:00:46,190
...في الواقع

14
00:00:46,190 --> 00:00:48,480
يخلدان إلى النّوم معاً؟

15
00:00:49,810 --> 00:00:51,890
لا يمكن فعل شيء أثناء النّوم

16
00:00:52,930 --> 00:00:54,990
...معك حقّ

17
00:00:57,350 --> 00:01:00,080
أتريد أن نتكلّم إذاً؟

18
00:01:07,730 --> 00:01:09,380
...جدّتي، جدّي

19
00:01:30,690 --> 00:01:32,320
!أيّتها الهمجيّة الحقيرة

20
00:01:32,320 --> 00:01:33,570
انتظروا

21
00:01:34,170 --> 00:01:35,880
إنّها امرأة

22
00:01:40,670 --> 00:01:41,830
...جيشنا

23
00:01:42,580 --> 00:01:44,080
!خرج عن السّيطرة

24
00:01:44,460 --> 00:01:48,300
سيادة القائد، أرسل فصيل ياتوري وفصيلي إلى الدّاخل

25
00:01:48,300 --> 00:01:49,350
!ليس بعد

26
00:01:49,350 --> 00:01:51,140
—كثير منهم هائجون

27
00:01:50,330 --> 00:01:53,340
!إن لم نذهب الآن فسيفوت الأوان

28
00:01:55,850 --> 00:01:57,080
!ابتعد أيّها الوغد

29
00:01:58,120 --> 00:02:00,590
أنا الضابط الأعلى، سأبدأ أولاً

30
00:02:00,590 --> 00:02:01,170
اصمت

31
00:02:01,170 --> 00:02:02,880
من يأبه لرتبتك؟

32
00:02:02,880 --> 00:02:06,460
عليكم أن تكفّوا عن هذا الهُراء

33
00:02:07,870 --> 00:02:10,540
،تبدو وكأنّك تتكلّم معنا بفوقيّة

34
00:02:10,540 --> 00:02:14,290
ولكن لماذا ينبغي عليّ الإصغاء لمجرّد ضابط صفّ؟

35
00:02:15,890 --> 00:02:22,700
إيّاك والظنّ أنّ إجابتي ستكون مقبولة لديكم دوماً

36
00:02:28,450 --> 00:02:30,460
ياتوري، أمّني على نانا

37
00:02:30,460 --> 00:02:31,900
من الأفضل أن تفعل فتاةٌ ذلك

38
00:02:32,900 --> 00:02:34,050
إنّها بخير

39
00:02:34,050 --> 00:02:35,090
وصلنا في الوقت المُناسب

40
00:02:37,030 --> 00:02:38,130
هكذا إذاً

41
00:02:38,400 --> 00:02:40,070
فعلناها هذه المرّة

42
00:02:42,030 --> 00:02:44,640
لا يهمّني إن كنتُم أبطالاً أو محاربين

43
00:02:45,180 --> 00:02:48,240
لكن لا أتحلّى بصبر أمام وحوش

44
00:04:26,100 --> 00:04:29,420
،كانت هذه النّهاية المُحتملة الأسوأ

45
00:04:29,420 --> 00:04:33,580
لكن لم يعُد من المُمكن لشيناك أن ينسّقوا
هجوماً ضدّنا بعد الآن

46
00:04:34,360 --> 00:04:37,080
انتهت هذه الحرب

47
00:04:37,500 --> 00:04:38,540
...نهاية

48
00:04:38,870 --> 00:04:41,590
...انتهت

49
00:04:41,970 --> 00:04:44,200
يبدو أنّنا سنعود إلى الدّيار بأمان

50
00:04:44,200 --> 00:04:45,570
نعم

51
00:04:45,570 --> 00:04:48,720
لكن لم أتوقّع أن تكون هذه المعركة بهذه الصّعوبة

52
00:04:48,720 --> 00:04:51,260
كانت هناك مشاكل كثيرة مع ضبّاطنا الكبار

53
00:04:51,260 --> 00:04:54,730
ولم نكن نواجه شيناك فحسب

54
00:04:55,180 --> 00:04:57,070
ماذا تعني؟

55
00:04:57,070 --> 00:05:02,110
أولئك النّاس الذين ظهروا في نهاية المعركة السّابقة

56
00:05:02,890 --> 00:05:05,110
كانوا ربّما كالا كارم

57
00:05:05,570 --> 00:05:06,930
كالا كارم؟

58
00:05:06,930 --> 00:05:07,830
أجل

59
00:05:07,830 --> 00:05:09,200
فرقة الشّبح

60
00:05:09,700 --> 00:05:12,240
وحدة قوّات خاصّة تابعة لجيش كيوكا

61
00:05:12,450 --> 00:05:13,560
لحظة

62
00:05:13,560 --> 00:05:17,000
هل تعني أنّ كيوكا كانت متورّطة في تمرُّد شيناك؟

63
00:05:17,510 --> 00:05:19,630
كانت تكتيكاتهم ذات كفاءة عالية

64
00:05:21,120 --> 00:05:22,760
،اغتيال الرّائد تواك

65
00:05:23,380 --> 00:05:25,510
...تلك التكتيكات الحربيّة الفدائيّة الجبليّة

66
00:05:25,510 --> 00:05:26,510
...و

67
00:05:26,510 --> 00:05:28,140
إيكّون، يمتلكونها أيضاً، صحيح؟

68
00:05:28,520 --> 00:05:30,640
أجل، يستخدمون بنادق الهواء

69
00:05:31,140 --> 00:05:32,490
...تذكّرت

70
00:05:32,490 --> 00:05:35,120
إن كان هُناك من يحمل بندقيّة هوائيّة

71
00:05:35,120 --> 00:05:38,810
فلا بدّ أن يكون من جمهوريّة كيوكا، حيثُ فرّ
الدكتور أناراي

72
00:05:38,810 --> 00:05:40,170
هذا صحيح

73
00:05:41,320 --> 00:05:42,840
!مرحباً يا رجال

74
00:05:42,840 --> 00:05:47,070
يبدو أنّكم لقّنتُم همجيي شيناك درساً قاسياً

75
00:05:48,200 --> 00:05:49,790
—هذا

76
00:05:51,840 --> 00:05:55,460
نحن فريق تفتيش من ألديرا

77
00:05:55,460 --> 00:05:57,460
هل الرّجل المسؤول موجود هنا؟

78
00:05:57,750 --> 00:06:00,620
،أنا الفريق تامتوكتسك سافيدا

79
00:06:00,620 --> 00:06:03,370
!قائد الحاميّة الشّمالية

80
00:06:03,370 --> 00:06:04,960
ماذا تريد؟

81
00:06:05,250 --> 00:06:07,450
تلقّيتُ رسالةً مفادها

82
00:06:07,450 --> 00:06:12,230
أنّ وصايا الدّين الألديري قد انتُهِكَتْ
في المنطقة الشماليّة

83
00:06:15,170 --> 00:06:17,990
والانتهاك هو إساءة للأرواح العظيمة الأربعة

84
00:06:21,810 --> 00:06:25,580
أُرسِلنا للتّحقيق حول الحقيقة

85
00:06:25,580 --> 00:06:26,530
...لكن

86
00:06:28,780 --> 00:06:31,390
يبدو أنّه لا داعي لأتعب نفسي حتّى

87
00:06:32,370 --> 00:06:34,410
!لحظة! لدينا أسبابنا

88
00:06:34,410 --> 00:06:36,150
،إن أردت اختلاق الأعذار

89
00:06:36,150 --> 00:06:39,920
فافعل هذا بعد وصول إدانة رسميّة من المقرّ

90
00:06:45,170 --> 00:06:46,080
!طاردهم

91
00:06:46,800 --> 00:06:48,860
!الحق بهم وأوقفهم

92
00:06:48,860 --> 00:06:51,430
!اختر سريّة ما زالت تمتلك روحاً سليمة وأرسلها

93
00:06:52,940 --> 00:06:55,060
سريّة تمتلك روحاً؟

94
00:07:16,300 --> 00:07:18,570
لا سايا ألديرامين؟

95
00:07:18,570 --> 00:07:20,960
جيش دولة ألديرا؟

96
00:07:24,540 --> 00:07:26,230
...فقط لتنفيذ واجبات مقدّسة

97
00:07:26,230 --> 00:07:28,340
ما-ماذا تعني؟

98
00:07:29,310 --> 00:07:32,010
،غزو عسكري لبلد آخر

99
00:07:32,010 --> 00:07:34,090
يُشَنُّ باسم الربّ

100
00:07:34,090 --> 00:07:36,040
...يا للهول

101
00:07:36,040 --> 00:07:38,740
،كانوا يستعدّون لهذا منذ فترة طويلة

102
00:07:38,740 --> 00:07:42,600
وكان هذا مجرّد تحذير أخير منهم قبل البدء بالحرب

103
00:07:43,140 --> 00:07:45,130
هذا سيّئ

104
00:07:45,130 --> 00:07:46,430
هذا صحيح

105
00:07:46,430 --> 00:07:48,870
الحامية الشّمالية مُنهَكة

106
00:07:48,870 --> 00:07:50,610
هذا هو التّوقيت الأسوأ

107
00:07:51,820 --> 00:07:53,890
...يبدو وكأنّ شخصاً قد نصبَ كميناً لنا

108
00:07:53,890 --> 00:07:57,120
!هكذا إذاً

109
00:07:58,420 --> 00:08:02,620
رأينا ملابس حجّ خاصّة بألديرا في المكان
الذي قُتِلَ فيه الرّائد تواك

110
00:08:03,340 --> 00:08:06,520
،نعلمُ أنّ شيناك استخدموها لإخفاء هويّتهم

111
00:08:07,460 --> 00:08:09,880
لكن لماذا ملابس حجّ؟

112
00:08:09,880 --> 00:08:13,150
،لكن إن وضعنا كيوكا في الخليط

113
00:08:13,150 --> 00:08:14,630
...يغدو الأمر منطقيّاً

114
00:08:15,220 --> 00:08:18,140
،كانت كيوكا تتحكّم بشيناك

115
00:08:18,220 --> 00:08:23,300
وحثّوا كهنة ألديرا على غزو الامبراطوريّة

116
00:08:24,740 --> 00:08:28,850
لديهم مخطِّط استراتيجي مُحنَّك

117
00:08:31,610 --> 00:08:34,880
!جيش ألديرا المُقدّس أمامنا مباشرة

118
00:08:34,880 --> 00:08:37,650
!فإمّا أن ننسحب بكامل جيوشنا أو نُقاتل

119
00:08:37,650 --> 00:08:40,310
يمكنكم اتّخاذ ذلك القرار على الأقلّ، صحيح؟

120
00:08:46,040 --> 00:08:47,630
لديّ اقتراح

121
00:08:47,630 --> 00:08:50,630
ينبغي أن نضع وحدة انسحاب داعِمة في خطّنا الخلفيّ

122
00:08:50,630 --> 00:08:52,840
ونُحاول تأخير العدوّ

123
00:08:54,590 --> 00:08:55,950
!نعم، هذه هي الطريقة الوحيدة

124
00:08:55,950 --> 00:08:56,890
!هذا صحيح

125
00:08:56,890 --> 00:08:59,560
،لدينا أقلّ من 8،000 جنديّ

126
00:08:59,560 --> 00:09:02,350
،وإن أردنا المتابعة في معركة دفاعيّة

127
00:09:02,350 --> 00:09:06,140
نحتاج على الأقلّ إلى 6.000 للعودة إلى القاعدة

128
00:09:06,140 --> 00:09:09,610
ما يعني أنّ لدينا 2.000 على الأكثر
يُساهمون كوحدة انسحاب داعِمة

129
00:09:10,280 --> 00:09:13,840
...يكمنُ السُّؤال في كيفيّة استخدام هذه الجيوش

130
00:09:14,710 --> 00:09:16,240
أعواني سيشرحون الباقي

131
00:09:16,700 --> 00:09:19,980
قبل أن نتمكّن بالبدء بمعركة دفاعيّة
،لكسب الوقت للانسحاب

132
00:09:19,980 --> 00:09:24,030
علينا أن نُبادر بمعركة أولى لتوفير وقتٍ للاستعداد

133
00:09:24,030 --> 00:09:29,440
يمكننا استخدام كتيبة واحدة قوامها 600 لفعل ذلك

134
00:09:30,120 --> 00:09:31,270
!انتظري

135
00:09:31,270 --> 00:09:34,630
هل يستطيع 600 تأخير جيش قوامه 12.000؟

136
00:09:34,970 --> 00:09:38,520
،سنشرح الخطّة بالتفصيل لاحقاً

137
00:09:38,520 --> 00:09:41,130
،لكن بما أنّني كنتُ أنا من رسمَ هذه الخطّة

138
00:09:41,500 --> 00:09:46,140
أنا، سينبا سازالوف، أودُّ أن أكون المسؤول

139
00:09:46,140 --> 00:09:49,080
لديّ اقتراح فيما يتعلّق بقضيّة القوّة العاملة

140
00:09:49,080 --> 00:09:52,150
سنطلبُ مُساعدة شيناك للتعويض عن الأعداد النّاقصة

141
00:09:52,150 --> 00:09:55,790
ماذا؟ ستطلب مُساعدة شيناك؟

142
00:10:01,020 --> 00:10:02,980
لماذا فككتُم القيود؟

143
00:10:02,980 --> 00:10:05,760
الاعتذار من شخصٍ أثناء تقييده بالحبال

144
00:10:05,760 --> 00:10:08,250
هو طريقة أخرى لتهديده

145
00:10:08,980 --> 00:10:10,000
اعتذار؟

146
00:10:10,470 --> 00:10:14,660
!ربحتُم الحرب! فلماذا تعتذرون من الخاسر؟

147
00:10:15,100 --> 00:10:17,510
عن الأفعال الوحشيّة التي ارتكبناها

148
00:10:17,510 --> 00:10:19,140
!أغلق فمك

149
00:10:19,140 --> 00:10:21,880
تقليل الرّابح من شأنِك والاعتذار

150
00:10:21,880 --> 00:10:24,800
هو إهانة لمحارب

151
00:10:24,800 --> 00:10:25,980
معكِ حقّ

152
00:10:26,670 --> 00:10:31,620
لا أنوي الاعتذار عن الأعمال الوحشيّة
في الحربِ بحدّ ذاتها

153
00:10:32,640 --> 00:10:38,560
لكن علينا أن نعتذر عن العنف وسفك الدّماء الذي لا معنى له

154
00:10:38,900 --> 00:10:42,280
للمدنيين الذين يقعون ضمن منطقة حكمنا

155
00:10:56,390 --> 00:11:00,890
ومجرّد اعتذار مُبتذَل لا يكفي بالتأكيد لمسح جرائمنا

156
00:11:00,890 --> 00:11:03,930
ولن يُعيد الموتى

157
00:11:05,960 --> 00:11:07,730
سمعتُ قصّة ذات مرّة

158
00:11:08,350 --> 00:11:12,110
أنّ صائداً عاش في ألافاترا

159
00:11:12,110 --> 00:11:14,710
أطلق سهماً على فتاةٍ بالخطأ

160
00:11:15,410 --> 00:11:20,070
،أنفق كلّ ثروته في شراء الهدايا للتّكفير

161
00:11:20,070 --> 00:11:22,880
ونطقَ بكلّ كلمات الاعتذار التي خطرت في ذهنه

162
00:11:23,390 --> 00:11:26,520
لكن والد الفتاة

163
00:11:26,520 --> 00:11:28,850
أعطاه خنجراً صغيراً بصمت

164
00:11:29,640 --> 00:11:32,550
أدرك الصيّاد ما طُلِب منه

165
00:11:33,090 --> 00:11:34,730
،إذا استخدم الخنجر

166
00:11:34,730 --> 00:11:37,280
،فبمقدوره تجنّب ارتكاب نفس الخطأ

167
00:11:37,760 --> 00:11:38,790
.مرّة أخرى

168
00:11:47,310 --> 00:11:48,960
،منذُ ذلك الحين

169
00:11:48,960 --> 00:11:52,810
يقطعون أهل شيناك أصابعهم

170
00:11:53,090 --> 00:11:57,520
كطريقة تقليديّة في إظهار الاعتذار

171
00:11:58,860 --> 00:12:03,900
هذه هي القصّة القديمة التي رويتها لي، أليس كذلك يا نانا؟

172
00:12:05,400 --> 00:12:07,270
...لـ-لحظة

173
00:12:07,800 --> 00:12:08,750
...أنت

174
00:12:09,490 --> 00:12:13,400
إكتا سولورك، ضابط صفّ في الجيش الامبراطوري

175
00:12:13,400 --> 00:12:17,000
حدثَ الكثير واختلفت كنيتي الآن

176
00:12:17,380 --> 00:12:21,380
أهذا أنت حقّاً يا إكتا؟

177
00:12:21,380 --> 00:12:23,620
مضت فترة طويلة يا نانا

178
00:12:24,270 --> 00:12:26,220
،الوقتُ ليس مناسباً لقول ذلك

179
00:12:26,220 --> 00:12:28,890
لكنّكِ كبرتِ وأمسيتِ جميلة جدّاً

180
00:12:34,420 --> 00:12:35,310
...نانا

181
00:12:35,310 --> 00:12:37,480
،أعلم أنّني لا أملك الحقّ بذلك

182
00:12:37,480 --> 00:12:39,760
لكن أطلبُ ثلاثة طلبات

183
00:12:40,310 --> 00:12:41,490
الأوّل

184
00:12:41,490 --> 00:12:45,520
هو أن تقبلي باعتذاري عن أعمالنا السيّئة

185
00:12:46,330 --> 00:12:47,670
والثّاني هو

186
00:12:47,670 --> 00:12:51,450
أن يساعدنا أهل شيناك في التمرّد
على جيش ألديرا المقدّس

187
00:12:53,430 --> 00:12:55,830
،لا أعلم ما إن كان هذا سيجعل الأمر مستحقّاً

188
00:12:56,280 --> 00:12:57,460
...لكن سأقطع ضعفَين

189
00:12:58,150 --> 00:13:01,800
!كتعبير عن اعتذاري

190
00:13:05,550 --> 00:13:11,340
يحاولون مُهاجمة شيناك والحامية الشّمالية
مستغلّين إنهاكنا

191
00:13:11,760 --> 00:13:13,810
كي يقضوا علينا كِلَينا

192
00:13:14,210 --> 00:13:17,920
إذاً عبرت دولة ألديرا درج الإله

193
00:13:17,920 --> 00:13:19,610
لغزو الامبراطوريّة؟

194
00:13:20,110 --> 00:13:23,330
أرادوا سحق كلّاً من شيناك

195
00:13:23,330 --> 00:13:27,200
والحامية الشّمالية باسم إنقاذ الأرواح

196
00:13:29,190 --> 00:13:33,450
بعبارة أدقّ، جيش ألديرا بحدِّ ذاته هو مجرّد بيدق

197
00:13:34,020 --> 00:13:38,540
الأشخاص الذين خطّطوا لهذا كانوا من علّموكِ
،التّكتيكات الفدائيّة

198
00:13:38,540 --> 00:13:40,710
"وكذلك مُصطلح "حرب مُقدّسة

199
00:13:41,710 --> 00:13:43,100
...هل تعني

200
00:13:43,100 --> 00:13:43,960
هذا صحيح

201
00:13:44,530 --> 00:13:45,970
جمهوريّة كيوكا

202
00:13:47,240 --> 00:13:51,830
،إذا تولّت دولة ألديرا القيادة هنا

203
00:13:52,460 --> 00:13:56,730
فلن يرحموا مُعتقدات شيناك الهرطقيّة

204
00:13:57,490 --> 00:14:01,190
،كلّ ما يمكنني قوله هو أنّكم إن ساعدتمونا هنا

205
00:14:01,190 --> 00:14:05,990
أضمن لكِ مكاناً لشيناك في الامبراطوريّة
عندما ينتهي كلّ هذا

206
00:14:06,870 --> 00:14:09,870
أهذا عرض شخصيّ؟

207
00:14:10,280 --> 00:14:12,630
إنّه عرض الحامية الشّمالية بأكملها

208
00:14:12,630 --> 00:14:14,620
لن أدعهم ينكثون بوعدهم

209
00:14:15,960 --> 00:14:18,120
أعلمُ أنّها أنانيّة، لكن الوقت يُداهمنا

210
00:14:18,490 --> 00:14:21,740
أريدكِ أن تصنعي قراركِ هنا يا رئيسة شيناك

211
00:14:22,850 --> 00:14:24,630
وما هو الطلب الأخير؟

212
00:14:25,340 --> 00:14:28,880
طلبتَ طلبَين غير منطقيين

213
00:14:29,570 --> 00:14:33,080
قد يكون الأخير هو الأهمّ

214
00:14:33,910 --> 00:14:38,140
أودّ منكِ أن تسمحي لي بالاستمرار في مُناداتكِ نانا

215
00:14:40,770 --> 00:14:42,170
...مستحيل

216
00:14:42,170 --> 00:14:43,860
...لأجل هذا فقط أنت

217
00:14:45,110 --> 00:14:48,800
الأوّل والثّاني كانا طريقتي في الاعتذار كجنديّ

218
00:14:48,800 --> 00:14:52,160
والثّالث كان اعتذاري كصديق لكِ

219
00:14:53,850 --> 00:14:56,730
،إن كبرتَ لتصبح شخصاً سيّئاً

220
00:14:56,730 --> 00:14:59,160
فما كان عليّ أن أقلق حيال أي شيء

221
00:14:59,160 --> 00:15:00,160
حقّاً؟

222
00:15:00,160 --> 00:15:03,370
قطعتُ خنصري دون تردّد

223
00:15:03,370 --> 00:15:06,180
لأنّكِ كبرتِ لتمسي امرأة رائعة

224
00:15:10,310 --> 00:15:11,520
حسناً

225
00:15:11,520 --> 00:15:13,360
،قد لا تملك الحقّ بالسّؤال

226
00:15:13,870 --> 00:15:17,930
لكن بصِفتي رئيسة شيناك، أنا، ناناكو دارو، أقبلُ بطلباتك

227
00:15:18,850 --> 00:15:24,270
هل تعلم أنّ الأصابع لا تنمو بعد قطعها؟

228
00:15:24,950 --> 00:15:27,440
لماذا لم تقولي شيئاً؟

229
00:15:28,840 --> 00:15:30,600
لا، أنا آسف

230
00:15:30,600 --> 00:15:32,540
لم أكن أملك خياراً

231
00:15:32,540 --> 00:15:35,950
لم يكن الوقتُ يُسعفنا لإقناعها بالكلام

232
00:15:37,080 --> 00:15:39,710
لم تكن وحدتك التي خرجَتْ عن السّيطرة

233
00:15:40,130 --> 00:15:44,620
،كانت المُفاوضات مع نانا مُمكِنة من خلالي فقط

234
00:15:44,620 --> 00:15:46,960
لهذا انتهَتْ بهذا الشّكل فحسب

235
00:15:48,290 --> 00:15:50,220
إيكّون، هل نجحت المُفاوضات؟

236
00:15:51,060 --> 00:15:54,440
قالت أنّها سترسل 800 رجلاً في غضون يومين

237
00:15:54,440 --> 00:15:57,190
علينا أن نكون ممتنّين للنّقيب سازالوف أيضاً

238
00:15:57,660 --> 00:16:00,860
،جمع كلّ أهالي القرى المحترقة في مكان واحد

239
00:16:00,860 --> 00:16:02,980
لِذا لن يستغرق جمع النّاس وقتاً طويلاً

240
00:16:03,270 --> 00:16:04,980
شكراً لك

241
00:16:06,440 --> 00:16:09,040
أعتذر عن الإزعاج يا حضرة النّقيب

242
00:16:09,870 --> 00:16:12,110
لم أعهدك هكذا

243
00:16:12,720 --> 00:16:15,950
أنا من قرّر التّماشي مع اقتراحك

244
00:16:16,760 --> 00:16:20,120
على أي حال، حان الوقتُ لمنحكم مكافأة
الفريق سافيدا

245
00:16:20,500 --> 00:16:21,770
أولاً، ضابط الصفّ إكتا

246
00:16:21,770 --> 00:16:23,350
وضابطة الصفّ ياتوريشينو

247
00:16:23,350 --> 00:16:25,040
!تهانينا التّرقية الميدانيّة

248
00:16:25,850 --> 00:16:28,090
!من الآن فصاعداً، أنتُما برتبة ملازم أوّل

249
00:16:28,610 --> 00:16:32,010
ضبّاط الصفّ ماثيو وتورواي وهاروما

250
00:16:32,400 --> 00:16:35,410
من الآن فصاعداً، رتبتكم الرّسمية هي ملازم ثانٍ

251
00:16:35,410 --> 00:16:36,580
ماذا؟

252
00:16:36,580 --> 00:16:39,560
!ما خطبكم؟ ينبغي أن تكون أكثر سعادة

253
00:16:39,560 --> 00:16:41,100
!حالما نعود، يمكنكم التّباهي

254
00:16:41,920 --> 00:16:43,810
...هذا إن عدنا

255
00:16:44,790 --> 00:16:45,890
الملازم ثاني ماثيو

256
00:16:45,890 --> 00:16:47,120
المُلازم ثاني هاروما

257
00:16:47,550 --> 00:16:49,710
،إن أردتُما

258
00:16:49,710 --> 00:16:52,690
أستطيعُ إرسالكما أنتُما ووحدتكما إلى الخلف الآن

259
00:16:53,910 --> 00:16:59,080
لكن لحظة، ألم يقرّروا مسبقاً من سيكون
في وحدة الانسحاب الدّاعمة؟

260
00:16:59,080 --> 00:17:01,370
لم تكتمل بشكل رسميّ، لِذا لا

261
00:17:02,130 --> 00:17:05,250
ماثيو، رأيي بك قد تغيّر كثيراً

262
00:17:06,010 --> 00:17:08,380
كنتَ ضابطاً مؤثّراً رائعاً

263
00:17:08,380 --> 00:17:10,040
يمكنك أن تكون فخوراً

264
00:17:11,280 --> 00:17:12,260
وأنتِ أيضاً يا هارو

265
00:17:12,880 --> 00:17:14,260
،لولا وحدتكِ

266
00:17:14,630 --> 00:17:16,640
لوقع عددٌ أكبر بكثير من الضحايا

267
00:17:18,430 --> 00:17:19,760
هذا شرف لي

268
00:17:20,340 --> 00:17:22,900
ستغدوان ضابطين ممتازين

269
00:17:22,900 --> 00:17:26,270
لذا انتهزا هذه الفرصة لتعلّم الوقت المناسب للانسحاب

270
00:17:26,640 --> 00:17:29,810
قالت ياتوري كلّ ما أردتُ قوله

271
00:17:29,810 --> 00:17:31,420
،لكن يا تورواي

272
00:17:31,420 --> 00:17:34,030
سأعتذر منك بما أنّ الفرصة سانحة

273
00:17:34,030 --> 00:17:37,280
لا أملك بديلاً عن وحدتك وبنادقهم الهوائيّة

274
00:17:41,080 --> 00:17:44,620
—الوداع حالياً، لكن في المرّة المقبلة التي نلتقي فيها

275
00:17:45,450 --> 00:17:47,500
!من تعتقدان نفسيكما بالضبط؟

276
00:17:48,360 --> 00:17:50,240
دعني أسأل سؤالاً واحداً

277
00:17:51,000 --> 00:17:54,260
هل عرقلتُكما في أي معركة من المعارك حتّى الآن؟

278
00:17:54,850 --> 00:17:56,130
،لا

279
00:17:56,130 --> 00:17:58,140
كنتَ رفيقاً مأموناً

280
00:17:58,430 --> 00:17:59,580
،إن كنتَ جادّاً في كلامك

281
00:17:59,580 --> 00:18:03,470
!فلماذا إذاً تطلب من "رفيقك" الهرب أوّلاً؟

282
00:18:04,000 --> 00:18:04,770
...ما-كُن

283
00:18:07,800 --> 00:18:10,990
ستكون هذه معركة صعبة للغاية يا ماثيو

284
00:18:10,990 --> 00:18:11,770
!أجل

285
00:18:11,770 --> 00:18:13,800
قد يموت كثير من رجالك

286
00:18:13,800 --> 00:18:15,000
!أجل

287
00:18:15,000 --> 00:18:17,360
حركة واحدة خاطئة وستموت أيضاً

288
00:18:17,360 --> 00:18:18,920
—حتّى القليل من الحظّ السيّئ يعني

289
00:18:18,920 --> 00:18:19,820
!أجل

290
00:18:20,350 --> 00:18:24,830
هذا ينطبقُ عليك أيضاً ومع ذلك ستذهب، صحيح؟

291
00:18:26,720 --> 00:18:28,830
هل سأعرقلُك بوجودي معك؟

292
00:18:31,620 --> 00:18:33,550
أسحب كلامي

293
00:18:33,550 --> 00:18:36,090
أنا آسف يا صديقي ماثيو

294
00:18:36,440 --> 00:18:38,500
أعتذر كذلك

295
00:18:38,500 --> 00:18:41,600
مدّنا بمُساعدتك في المعركة القادمة من فضلك

296
00:18:43,370 --> 00:18:46,600
كـ-كان ينبغي أن تقولا ذلك من البداية

297
00:18:47,260 --> 00:18:48,600
أنا سأبقى أيضاً

298
00:18:49,070 --> 00:18:51,860
!فأنا أنتمي للفرسان

299
00:18:52,970 --> 00:18:57,400
دعيني أحميكِ ولو قليلاً أرجوكِ

300
00:18:57,960 --> 00:18:59,660
أنا آسفة يا هارو

301
00:19:00,320 --> 00:19:02,410
للاستهانة بعزيمتك

302
00:19:04,080 --> 00:19:04,940
!نعم

303
00:19:05,820 --> 00:19:07,910
العودة إلى الشّباب مجدّداً

304
00:19:09,360 --> 00:19:12,100
...بمقدوري أن أطلب مُساعدتك في أمر الآن يا هارو

305
00:19:12,100 --> 00:19:14,630
ماذا حدث؟

306
00:19:14,630 --> 00:19:16,370
!ماذا؟ ماذا؟

307
00:19:16,370 --> 00:19:17,840
!إكتا-سان! إصبعك

308
00:19:17,840 --> 00:19:19,440
!إصبعك

309
00:19:32,370 --> 00:19:34,440
كالعادة، خطّة إكتا جريئة

310
00:19:35,160 --> 00:19:37,400
لكن أمامنا ثلاثة أيّام ونصف

311
00:19:37,820 --> 00:19:40,130
القوّة العاملة والوقت محدودان

312
00:19:40,900 --> 00:19:45,910
إن أراد جيش ألديران البالغ 12.000
غزو كاتفارنا

313
00:19:46,220 --> 00:19:49,280
فعليه أن يمرّ بغابة غاغال كاساكان العظيمة

314
00:19:56,370 --> 00:19:58,630
هل سيحرقون الغابة برمّتها إذاً؟

315
00:19:58,630 --> 00:20:00,170
!جنون

316
00:20:00,720 --> 00:20:04,440
هذا ما تراه تماماً عندما تحاصر شخصاً في زاوية

317
00:20:04,440 --> 00:20:07,380
لكن إن أهدرنا كثيراً من الوقت هنا

318
00:20:07,380 --> 00:20:09,170
فهذا سيُعيق عمليّة المطاردة

319
00:20:09,170 --> 00:20:10,180
!أعلم ذلك

320
00:20:10,410 --> 00:20:14,020
ربّما بمقدورنا أن نخمد النّار إذا تبوّلنا عليها جميعاً؟

321
00:20:14,020 --> 00:20:17,920
سيادة الجنرال أكوغالبا، هذه فكرة مبتكرة جدّاً

322
00:20:17,920 --> 00:20:18,690
لكن لا

323
00:20:19,480 --> 00:20:21,570
!يا للإزعاج

324
00:20:21,570 --> 00:20:24,700
ميشوري، ألم يصل ذلك الفتى إلى هنا بعد؟

325
00:20:25,190 --> 00:20:28,230
...أرسلتُ شخصاً إليه، لكن

326
00:20:28,230 --> 00:20:30,700
لا أدري ما إن كان من الحكمة الاعتماد عليه كثيراً

327
00:20:30,700 --> 00:20:33,110
،حتّى لو كان ضابطاً ضيفاً

328
00:20:33,110 --> 00:20:35,590
،بما أنّه جزء في تسلسلنا القيادي

329
00:20:35,590 --> 00:20:37,640
!فهو مجرّد رجل آخر من رجالي

330
00:20:37,640 --> 00:20:39,840
فما الضير من إشراكه بقوّة؟

331
00:20:41,620 --> 00:20:43,590
يبدو أنّنا فعلناها في الوقت المُناسب

332
00:20:44,300 --> 00:20:47,160
إنّها تحترق جيّداً

333
00:20:47,160 --> 00:20:48,100
أليس كذلك يا كوس؟

334
00:20:48,100 --> 00:20:52,100
إكتا، الجرح في يدك اليُسرى قد انفتح مجدّداً

335
00:20:52,580 --> 00:20:54,740
إن لم تتعالج منه فقد يتلوّث

336
00:20:56,730 --> 00:20:58,420
،عندما تتألّم

337
00:20:58,420 --> 00:21:00,590
فينبغي أن تخبر أحداً

338
00:21:00,590 --> 00:21:02,490
أنا لا أتكلّم عن جرحك فقط

339
00:21:02,830 --> 00:21:06,490
هارو، هل أبدو من النّوع الذي يتكتّم على مشاكله؟

340
00:21:07,180 --> 00:21:09,420
سمعتُ من ياتوري

341
00:21:10,150 --> 00:21:13,630
أنّك كنتَ مقرّباً من رئيسة شيناك

342
00:21:14,140 --> 00:21:19,050
لا أعتقد أنّه مرّت لحظة واحدة منذُ بداية هذه الحرب

343
00:21:19,780 --> 00:21:23,380
لم تكن تتحمّل فيها نوعاً ما من الألم، أليس كذلك؟

344
00:21:23,380 --> 00:21:25,380
هذه مُبالَغة

345
00:21:25,380 --> 00:21:30,390
يبدو أنّك تحمل أعباءً أكبر بكثير ممّا يحمله الآخرون

346
00:21:33,150 --> 00:21:34,980
بدأ العدوّ بتحرّكاته

347
00:21:36,650 --> 00:21:38,580
أشعلوا حريقاً ليطغى على حريقنا؟

348
00:21:38,580 --> 00:21:40,980
هذه خطوة جريئة

349
00:21:41,660 --> 00:21:44,200
وصنعوا القرار بسرعة عجيبة

350
00:21:44,200 --> 00:21:48,400
كانوا بلداً مُحايداً لم يخض أي حرب
كبيرة منذُ أكثر من قرن

351
00:21:48,400 --> 00:21:51,800
هل يستطيعون فعل شيء فعّال كهذا بهذه السّرعة؟

352
00:21:52,330 --> 00:21:56,450
لا سايا ألديرامين مزوّدة بمُستشارين من الامبراطوريّة

353
00:21:56,450 --> 00:22:00,420
والجمهوريّة للحفاظ على قوّتها العسكريّة

354
00:22:01,000 --> 00:22:02,380
ضابط ضيف؟

355
00:22:02,820 --> 00:22:06,160
سمعتُ كلاماً عندما كنتُ في إحدى القواعد المركزيّة

356
00:22:06,770 --> 00:22:10,440
ضابط الذي أرسلَتْه كيوكا إلى لا سايا ألديرامين

357
00:22:10,440 --> 00:22:14,040
كان ما يزال شابّاً لكن كان شعره
أبيضاً كشعر عجوز

358
00:22:14,520 --> 00:22:17,360
بذلَ مجهوداً أكثر من أي شخص آخر ليلاً نهاراً

359
00:22:17,360 --> 00:22:20,690
لم يسبق أن رآه أحدٌ مستلقياً

360
00:22:21,320 --> 00:22:28,200
وكأنّ الربّ خلقَه معي للحفاظ على التّوازن

361
00:22:28,200 --> 00:22:32,570
نعم، فكّرتُ في الشيء ذاته عندما سمعتُ الإشاعات

362
00:22:33,080 --> 00:22:35,950
أعتقدُ أنّ الاسم المُستعار الذي منحوه إيّاه كان

363
00:22:35,950 --> 00:22:37,710
"الضابط المتألّق الذي لا ينام"

364
00:22:40,420 --> 00:22:41,960
سأدخل يا جان

365
00:22:42,590 --> 00:22:44,100
أحضرتُ الشّاي

366
00:22:46,710 --> 00:22:49,980
...أراك منغمساً جدّاً في أوراقنا

367
00:22:49,980 --> 00:22:51,550
هل من شيء يُضايقك؟

368
00:22:54,370 --> 00:22:57,210
كنتُ أرسم الانتشارات التكتيكيّة من الآن فصاعداً

369
00:22:57,700 --> 00:22:59,810
تبدو أنّها ستكون معركة صعبة

370
00:23:00,270 --> 00:23:01,380
صعبة؟

371
00:23:01,940 --> 00:23:04,070
لم نخض أي معركة إلى الآن

372
00:23:04,590 --> 00:23:07,700
،استسلم العدوّ بسُرعة عن شنّ هجوم مضادّ حقيقيّ

373
00:23:07,700 --> 00:23:11,170
وكرّس كلّ طاقته في كسبِ الوقتِ للانسحاب

374
00:23:11,910 --> 00:23:13,510
من كان الشّخص

375
00:23:13,510 --> 00:23:17,460
الذي استطاع إنجاح خطّة يائسة كهذه

376
00:23:17,460 --> 00:23:19,360
للامبراطوريّة في السّاعة 11؟

377
00:23:20,600 --> 00:23:23,590
أغسطس، العام الامبراطوري 906

378
00:23:23,590 --> 00:23:27,570
أعظم أعجوبة في زمانه قد أُرسِل
إلى جيش ألديرا المُقدّس

379
00:23:28,060 --> 00:23:30,640
يُطلِق النّاس عليه اسم الضابط المتألِّق الذي لا ينام

380
00:23:31,300 --> 00:23:35,500
رائد في جيش كيوكا، جان ألكينيكس

381
00:23:37,070 --> 00:23:40,170
الحلقة القادمة: الكسول ضدّ الذي لا ينام

382
00:23:37,070 --> 00:23:40,170
الكسول ضدّ الذي لا ينام