1
00:00:02,720 --> 00:00:06,240
!كنّا بانتظارك يا راي

2
00:00:07,340 --> 00:00:08,730
أخيراً

3
00:00:08,970 --> 00:00:13,370
أنا آسف، لكن يجب عليّ هزيمتكما هنا

4
00:00:23,400 --> 00:00:25,630
أقصى قوّة من البداية

5
00:00:25,630 --> 00:00:27,960
أجل، سأستخدم كُلّ ما لديّ هنا

6
00:00:27,960 --> 00:00:30,230
!ضدّك، لن أعتمد على إستراتيجيّات مُبهرَجة

7
00:00:33,510 --> 00:00:35,020
!اقضِ عليه

8
00:00:41,510 --> 00:00:42,750
لا بأس

9
00:00:42,750 --> 00:00:44,140
...لكن ليس جيّداً بما يكفي لـ

10
00:00:46,300 --> 00:00:48,280
...هذا مُستحيل

11
00:00:52,990 --> 00:00:55,140
!أروم ريفارس

12
00:00:55,670 --> 00:00:57,990
آرياني، لنطلق العنان

13
00:00:57,990 --> 00:00:59,330
أتريدين استخدامها من الآن؟

14
00:00:59,780 --> 00:01:02,790
انظري إلى حقل الماتيريا القاهر هذا

15
00:01:03,040 --> 00:01:05,720
إنّه ليس شخصاً يمكننا الاهتمام بأسلوبنا ضدّه

16
00:01:05,720 --> 00:01:07,130
عُلِم

17
00:01:10,230 --> 00:01:11,110
!غول

18
00:01:14,990 --> 00:01:16,500
حركات جيّدة

19
00:01:16,500 --> 00:01:18,420
قوّة كافية كذلك

20
00:01:18,780 --> 00:01:20,460
لكن لا يمكنكما الوصول إليّ

21
00:01:25,350 --> 00:01:26,680
!أميليا

22
00:01:27,470 --> 00:01:29,330
!تأثير الفراشة

23
00:01:31,340 --> 00:01:34,940
تقنيّة السّيف السّرّية الثّامنة، تعتيم الوهج

24
00:01:43,240 --> 00:01:44,780
لم أكن أتوقّع ذلك

25
00:01:44,780 --> 00:01:47,550
،إذا نظرنا إلى مهارة تركيب الشّفرة خاصّتك

26
00:01:47,550 --> 00:01:49,910
فيمكن إدراجكِ هناك مع السّحرة العُظماء السّبعة

27
00:01:50,810 --> 00:01:52,070
استسلم

28
00:01:52,070 --> 00:01:55,240
سببيّة هذا العالم قد أُسِّسَتْ بالفعل

29
00:02:00,970 --> 00:02:02,560
،دفاع مثاليّ

30
00:02:02,560 --> 00:02:05,390
ليس مُستنداً إلى الحقيقة المادّية، لكن
!إلى التحكُّم بمبادئ السّببيّة؟

31
00:02:05,390 --> 00:02:06,500
هكذا يبدو

32
00:02:06,500 --> 00:02:08,720
تأثير الفراشة الخاصّ بأميليا

33
00:02:08,720 --> 00:02:12,660
خلقَ بالفعل نتيجةً لا تُصيب
فيها هجمة لوكاس هدفَها

34
00:02:13,230 --> 00:02:14,500
كارلا

35
00:02:14,500 --> 00:02:17,580
هل أكلت الحمقاءُ الورديّة شيئاً سيّئاً؟

36
00:02:17,580 --> 00:02:18,600
من يدري؟

37
00:02:18,600 --> 00:02:21,480
تعويذتكِ الأصليّة... مصدر إزعاج

38
00:02:23,670 --> 00:02:26,740
إذاً لنرَ مَن منّا يستطيع الصُّمود لفترة أطول

39
00:02:33,430 --> 00:02:34,330
هكذا إذاً

40
00:02:34,330 --> 00:02:35,790
...انتهى الوقت

41
00:02:36,330 --> 00:02:39,260
...نقطة ضعف تأثير الفراشة هو

42
00:02:39,260 --> 00:02:40,960
الفترة الّتي يمكنها فيه أن تكون نشِطة

43
00:02:44,700 --> 00:02:49,330
!آرياني، أعِدُكِ بألّا أدع أي هجمة تُصيبك

44
00:02:49,330 --> 00:02:51,620
!لذا قاتلي بملء إرادتكِ

45
00:02:51,620 --> 00:02:53,400
!أجل، تلك كانت الخطّة

46
00:02:54,510 --> 00:02:57,780
يبدو أنّها معركة ضدّ الزّمن لكلا الطّرفين

47
00:02:57,780 --> 00:03:04,330
إيثر آرياني آلغرين تهزم لوكاس فورست
...قبل أن يزول مفعول تأثير الفراشة

48
00:03:05,840 --> 00:03:08,840
أو سيصمد لوكاس بدلاً من ذلك

49
00:03:08,840 --> 00:03:12,380
!لا تنوبوا عنّي في التّعليق

50
00:03:12,380 --> 00:03:13,770
اصمتي أيّتها الحمقاء الورديّة

51
00:03:13,770 --> 00:03:16,600
!لكن حان وقت كاروكارو لتتألّق

52
00:03:15,740 --> 00:03:19,140
كيف تنسجم هؤلاء الفتيات معاً؟

53
00:03:16,600 --> 00:03:18,350
لا تكوني كذلك يا كارو

54
00:03:47,080 --> 00:03:49,290
إذاً تلك هي "ملابس الحظّ الدّاخليّة" الشّهيرة؟

55
00:03:49,290 --> 00:03:50,240
أسمعت عنها يا فران؟

56
00:03:50,240 --> 00:03:50,830
أجل

57
00:03:50,830 --> 00:03:57,590
مُؤخِّرة

58
00:03:50,830 --> 00:03:57,590
موتشي

59
00:03:50,830 --> 00:03:57,590
نظريّة

60
00:03:50,830 --> 00:03:52,830
منذ الأزل، إنّه أفضل زيّ للرّجال

61
00:03:52,830 --> 00:03:56,030
!بحفر عقيدته في أردافه، يُبرِز العزيمة

62
00:03:56,030 --> 00:03:59,330
يا شعب آرنولد، انظروا إلى نظريّة
الخطأ المُحرِج

63
00:04:02,470 --> 00:04:06,890
الفتى الّذي يُعدّ السّاحر الأقوى في العالم
يستمرّ في الفوز مع فريقه

64
00:04:07,180 --> 00:04:10,970
الحلقة 4
الفتى الّذي يُعدّ السّاحر الأقوى في العالم
وأصدقاؤه يتحادثون بقبضاتهم

65
00:04:15,030 --> 00:04:18,410
!هل لي بهذه الرّقصة؟

66
00:04:18,410 --> 00:04:21,240
مع الأسف، لستُ مهتمّاً بالرّقص

67
00:04:21,610 --> 00:04:23,340
...آروم ريفارس

68
00:04:23,340 --> 00:04:24,240
هذا صحيح

69
00:04:24,490 --> 00:04:26,250
،بينما نحن داخل منطقته

70
00:04:26,250 --> 00:04:29,110
لا يستطيع أيّ منّا استخدام سحر مُفيد

71
00:04:29,110 --> 00:04:30,930
هذا ما يفعله إذاً

72
00:04:30,930 --> 00:04:32,490
ما الّذي يجري هناك؟

73
00:04:32,490 --> 00:04:35,150
...حسناً، البريما ماتيريا تُصبح

74
00:04:34,210 --> 00:04:36,860
يبدو أنّ التّعويذة الأصليّة هي من النّوع
المُشوِّش على نِطاق منطقة واسعة

75
00:04:36,860 --> 00:04:39,810
تمنع تفعيل البريما ماتيريا

76
00:04:39,810 --> 00:04:41,890
!ريبيكا، أنتِ أيضاً؟

77
00:04:42,500 --> 00:04:44,400
!أنتِ ذكيّة للغاية

78
00:04:44,400 --> 00:04:45,500
على الإطلاق

79
00:04:45,880 --> 00:04:48,760
إذاً هذا ما كنتُما قد خطّطتما له منذ البداية

80
00:04:48,760 --> 00:04:51,650
مُحال أن نتمكّن من الفوز إذا
استطعتَ استخدام السّحر

81
00:04:51,650 --> 00:04:55,770
!هكذا خطّطنا لتحقيق النّصر

82
00:04:55,770 --> 00:04:57,990
!راي، لنتحادث

83
00:04:57,990 --> 00:04:59,150
!بعضلاتنا

84
00:04:59,480 --> 00:05:02,830
!حسناً. أنا جاهز

85
00:05:02,830 --> 00:05:07,290
!تعرّى؟

86
00:05:09,970 --> 00:05:11,410
!لماذا؟

87
00:05:22,890 --> 00:05:25,830
...هذا هو من دون تعزيزات سحريّة

88
00:05:26,250 --> 00:05:27,630
...إنّه

89
00:05:27,630 --> 00:05:28,630
!بعيد

90
00:05:30,500 --> 00:05:33,000
جسدي بأكمله يؤلمني

91
00:05:33,000 --> 00:05:35,890
إجهاد آروم ريفارس ثقيل أيضاً

92
00:05:35,890 --> 00:05:38,260
...لكن لسبب ما

93
00:05:39,280 --> 00:05:40,810
أشعر برغبة في الضّحك

94
00:05:40,810 --> 00:05:42,140
!أليس كذلك يا ألبيرت؟

95
00:05:42,140 --> 00:05:44,400
!أجل. هذا صحيح

96
00:05:45,390 --> 00:05:46,390
راي

97
00:05:46,670 --> 00:05:50,580
اللّقاء بك سمح لي بالتغيُّر

98
00:05:50,580 --> 00:05:52,810
سمح لي بالمضيّ قُدماً

99
00:05:52,810 --> 00:05:53,980
...لهذا السّبب بالضّبط

100
00:05:54,650 --> 00:05:57,140
!أريد أن أفوز ضدّك...

101
00:06:05,840 --> 00:06:06,800
راي

102
00:06:06,800 --> 00:06:07,800
...راي

103
00:06:07,970 --> 00:06:09,290
!راي

104
00:06:18,560 --> 00:06:22,570
أعتمد عليك يا ألبيرت

105
00:06:25,310 --> 00:06:27,710
بالطّبع يا إيفي

106
00:06:30,090 --> 00:06:31,980
يبدو أنّك أُنهِكتَ تماماً

107
00:06:31,980 --> 00:06:34,770
ألبيرت، أصبحتَ قويّاً

108
00:06:35,790 --> 00:06:37,520
هاجمني بكلّ ما أوتيت من قوّة

109
00:06:38,060 --> 00:06:40,200
سأواجهك بشكل صريح

110
00:06:40,630 --> 00:06:41,950
...حسناً

111
00:06:41,950 --> 00:06:43,200
!ها أنا قادم

112
00:06:54,970 --> 00:06:56,280
هكذا إذاً

113
00:06:56,280 --> 00:06:58,870
...بما أنّها تحميك

114
00:06:59,700 --> 00:07:02,970
فهي عزلاء تماماً الآن

115
00:07:02,970 --> 00:07:04,160
هذا صحيح

116
00:07:04,160 --> 00:07:07,430
الآن، أستطيع التحكُّم بسببيّة واحدة فقط

117
00:07:09,340 --> 00:07:12,240
!لن أدعك تقترب منها

118
00:07:12,240 --> 00:07:15,270
!الآن كافّة هجماته ملغيّة

119
00:07:15,270 --> 00:07:19,490
!ما يجب عليّ فعله هو إضعاف لوكاس فورست

120
00:07:21,880 --> 00:07:24,120
سحر شعوذة؟

121
00:07:24,450 --> 00:07:25,750
أجل

122
00:07:25,750 --> 00:07:30,140
هل سيكون شيئاً تفعله آميليا
صعباً بالنّسبة لي؟

123
00:07:30,140 --> 00:07:31,300
أجل

124
00:07:31,590 --> 00:07:35,130
أنتِ مُشعوذة مُناسبة لسحر الشّفرة الدّاخليّة

125
00:07:35,130 --> 00:07:37,530
هذا شيء تُمليه الموهبة الفطريّة

126
00:07:38,390 --> 00:07:42,860
لكن "سحر شعوذة". يا له من تعبير غريب

127
00:07:43,520 --> 00:07:48,420
يبقى السّحر سحراً، سواء كان شفرة
داخليّة أو شفرة خارجيّة

128
00:07:48,420 --> 00:07:50,180
لا يوجد فرق

129
00:07:52,970 --> 00:07:56,020
فضلاً عن ذلك، أحبّ سحركِ

130
00:07:56,840 --> 00:07:59,930
قدرتكِ على التّعامل مع الشّفرة
الدّاخليّة مُدهشة

131
00:07:59,930 --> 00:08:02,670
هذا أشبه بانعكاس لشخصيّتكِ الصّادقة

132
00:08:03,010 --> 00:08:05,160
أ-أوتظنّ ذلك حقّاً؟

133
00:08:05,360 --> 00:08:09,360
إتقان الشّفرة الدّاخليّة سيمنحكِ قوّةً قاهرة

134
00:08:09,740 --> 00:08:11,660
ينبغي أن تستمرّي على هذا المنوال

135
00:08:11,960 --> 00:08:13,720
!تقدّمي للأمام مباشرة

136
00:08:19,610 --> 00:08:24,300
إنّه هادئ دوماً ورزين، ووجهه لا يخونه أبداً

137
00:08:24,720 --> 00:08:27,050
لكن ثمّة نار مُتأجّجة في قلبه

138
00:08:27,410 --> 00:08:30,070
...أحياناً، قد يكون غريب الأطوار كذلك

139
00:08:31,850 --> 00:08:36,220
أحبّ شكله عندما يضحك بملء قلبه

140
00:08:36,780 --> 00:08:39,070
...الآن فهمت

141
00:08:44,180 --> 00:08:48,320
ظللتُ أنكر ذلك للتّركيز على البطولة

142
00:08:48,810 --> 00:08:52,820
لأنّني شعرتُ وكأنّ الاعتراف سيجعلني أتردّد

143
00:08:53,600 --> 00:08:55,840
وبأنّ ذلك سيُضعفني

144
00:08:56,320 --> 00:08:57,690
...لكن في الواقع

145
00:08:57,690 --> 00:09:01,350
!حالما اعترفتُ بذلك، أزداد قوّة أكثر فأكثر

146
00:09:09,420 --> 00:09:10,970
!يا للهول

147
00:09:14,480 --> 00:09:16,510
...أخيراً فورست

148
00:09:16,510 --> 00:09:17,740
!قد سقط...

149
00:09:19,050 --> 00:09:21,990
!انهارت آرياني على ركبتيها

150
00:09:33,500 --> 00:09:37,250
كان ذلك وشيكاً، لكن انتهى الوقت الآن

151
00:09:37,520 --> 00:09:39,330
ما هذا؟

152
00:09:39,330 --> 00:09:44,480
عادَ فورست للنّهوض على قدميه
!وكأنّه لم يتلقَّ أيّ ضرر

153
00:09:44,480 --> 00:09:45,760
...هذا غير مُمكن

154
00:09:46,130 --> 00:09:48,460
هل هو لا يُقهَر؟

155
00:09:48,460 --> 00:09:50,390
لا. أمعني النّظر

156
00:09:51,920 --> 00:09:54,120
!هذا بليغ

157
00:09:54,120 --> 00:09:55,400
إنّه يدّعي الصّلابة

158
00:09:55,400 --> 00:09:56,140
هذا صحيح

159
00:09:58,130 --> 00:09:59,590
ما زلتِ تقفين؟

160
00:09:59,590 --> 00:10:01,020
!بالطّبع

161
00:10:01,020 --> 00:10:02,530
!ما زال بإمكاننا القتال

162
00:10:02,530 --> 00:10:04,160
مُدهش

163
00:10:04,390 --> 00:10:07,220
!لا شيء أقوى من عذراء واقعة في الحُبّ

164
00:10:07,220 --> 00:10:08,270
هكذا إذاً

165
00:10:16,860 --> 00:10:19,400
!والنّصر من حليف فريق آلغرين

166
00:10:19,400 --> 00:10:21,640
!إنّهم أبطال حرب ماجيكس

167
00:10:22,300 --> 00:10:23,340
...آل

168
00:10:23,340 --> 00:10:24,550
...إيفي

169
00:10:26,310 --> 00:10:29,080
!فعلوها! فعلوها

170
00:10:29,080 --> 00:10:31,070
!كان الجميع مُذهلين

171
00:10:31,070 --> 00:10:32,600
!هذا هو بطلي راي

172
00:10:32,600 --> 00:10:34,200
!أخي الكبير

173
00:10:34,200 --> 00:10:36,340
!ماريا، انضمّي معنا

174
00:10:36,340 --> 00:10:38,230
!أخي الكبير

175
00:10:38,230 --> 00:10:40,390
...لكنّه ليس أخي الكبير

176
00:10:40,390 --> 00:10:42,320
!أخي الكبير

177
00:10:44,460 --> 00:10:47,140
راي. أنت مُبهر

178
00:10:49,300 --> 00:10:51,250
هل رأيتِ ذلك يا كارلا؟

179
00:10:51,250 --> 00:10:52,830
أجل، بالطّبع

180
00:10:52,830 --> 00:10:54,810
!راي غاية في الرّوعة

181
00:10:56,470 --> 00:10:58,580
كان نِزالاً مُمتعاً

182
00:10:58,580 --> 00:10:59,440
بالفعل

183
00:10:59,440 --> 00:11:02,980
مضى وقت منذ تسلّيتُ هكذا

184
00:11:02,980 --> 00:11:04,120
!ّراي

185
00:11:04,120 --> 00:11:06,140
!أنت الرّقم واحد لدى آرنولد

186
00:11:05,600 --> 00:11:07,730
فعلتها يا راي

187
00:11:07,730 --> 00:11:10,330
ر... ربحنا؟

188
00:11:10,330 --> 00:11:12,730
!أجل! فعلَها راي لأجلنا

189
00:11:12,960 --> 00:11:14,030
...راي

190
00:11:14,030 --> 00:11:15,480
آرياني

191
00:11:16,220 --> 00:11:19,110
الآن، كنتِ تفكّرين في رغبتكِ
برؤية راي، أليس كذلك؟

192
00:11:20,910 --> 00:11:22,810
لستِ بحاجة لإخفاء ذلك

193
00:11:22,810 --> 00:11:24,560
أعلم هذا منذ مدّة طويلة

194
00:11:24,560 --> 00:11:26,120
!منذ مدّة طويلة؟

195
00:11:26,120 --> 00:11:30,870
تقولين إذاً بأنّكِ تعرفين شعوري حتّى
!قبل أن أعرف شعوري؟

196
00:11:30,870 --> 00:11:33,020
من السّهل جدّاً قراءة تعابيركِ

197
00:11:33,630 --> 00:11:35,890
!وكذلك أنتِ

198
00:11:38,420 --> 00:11:39,730
هذا صحيح

199
00:11:39,730 --> 00:11:42,340
أحبّ راي حقّاً

200
00:11:43,510 --> 00:11:44,940
حسناً إذاً

201
00:11:44,940 --> 00:11:47,390
أعتقد بأنّنا مُنافستان في الحُبّ

202
00:11:47,680 --> 00:11:49,640
نحن كذلك؟

203
00:11:49,640 --> 00:11:50,390
أجل

204
00:11:50,390 --> 00:11:53,650
وقعنا في حُبّ نفس الشّخص

205
00:11:53,650 --> 00:11:56,380
...أميليا، أنتِ

206
00:11:56,380 --> 00:11:59,230
شعرتِ بلمسة راي أيضاً، صحيح؟

207
00:11:59,230 --> 00:12:00,660
لقلبكِ

208
00:12:01,570 --> 00:12:03,140
هذا صحيح

209
00:12:03,140 --> 00:12:07,900
من الآن فصاعداً، سأنافسكِ في الحُبّ

210
00:12:07,900 --> 00:12:08,900
أجل

211
00:12:14,940 --> 00:12:17,410
مُثير جدّاً

212
00:12:15,890 --> 00:12:17,410
كينوكوكون

213
00:12:17,660 --> 00:12:19,780
وريبيكا أيضاً

214
00:12:19,780 --> 00:12:21,180
...صحيح

215
00:12:23,790 --> 00:12:25,180
...يبدو هذا وكأنّه

216
00:12:25,580 --> 00:12:26,880
فهمت

217
00:12:27,310 --> 00:12:29,680
كنتُم فريقاً عظيماً حقّاً

218
00:12:29,680 --> 00:12:32,740
،كنتُ أبذل كُلّ ما لديّ حتّى النّهاية

219
00:12:32,740 --> 00:12:35,690
لكن يبدو أنّ فريقكم كان بمستوى أعلى بكثير

220
00:12:35,690 --> 00:12:37,040
هذا لطف منك

221
00:12:37,040 --> 00:12:40,570
أنت أيضاً لديك فريق قويّ ومُذهل

222
00:12:40,570 --> 00:12:42,030
شكراً لك

223
00:12:42,030 --> 00:12:46,950
لكن أريد حقّاً مُواجهتك في معركة فرديّة

224
00:12:47,280 --> 00:12:50,890
أتطلّع بشوق للفروسيّة السّحريّة العام المُقبل

225
00:12:50,890 --> 00:12:53,490
!أجل. أنا أيضاً

226
00:12:59,990 --> 00:13:01,460
أتحتاجان مُساعدة؟

227
00:13:01,870 --> 00:13:03,630
أنا بخير

228
00:13:05,640 --> 00:13:07,980
أنا آسف. خسرنا

229
00:13:07,980 --> 00:13:10,470
...كان راي لا يزال أفضل منّا بكثير

230
00:13:10,470 --> 00:13:13,560
لا، أبليتُما بلاء ممتازاً

231
00:13:14,330 --> 00:13:18,480
وكان القتال في فريق تجربة جيّدة لي

232
00:13:18,750 --> 00:13:21,900
وجود شُركاء ليس أمراً سيّئاً

233
00:13:24,740 --> 00:13:26,720
!أميليا! آرياني

234
00:13:26,720 --> 00:13:27,750
!راي

235
00:13:29,310 --> 00:13:31,550
!لماذا خلعت ملابسك؟

236
00:13:31,550 --> 00:13:32,680
هناك سبب

237
00:13:32,680 --> 00:13:33,990
!على أيّ حال، فعلناها

238
00:13:33,990 --> 00:13:35,990
!ربحنا بفضلكما

239
00:13:35,990 --> 00:13:38,410
لا، جميعنا فعلنا هذا

240
00:13:38,410 --> 00:13:42,140
أجل، جميعنا ربحنا اللّقب... معاً

241
00:13:42,140 --> 00:13:43,760
معكما حقّ

242
00:13:43,760 --> 00:13:46,530
!على أيّ حال، ارتدِ بعض الملابس

243
00:13:46,530 --> 00:13:47,580
(اختلاس نظرة)

244
00:13:49,260 --> 00:13:53,020
تأثير الفراشة إذاً؟

245
00:13:53,580 --> 00:13:55,740
إذاً أنتِ أميليا روز

246
00:13:57,280 --> 00:13:59,950
يغدو الأمر مُثيراً

247
00:14:02,750 --> 00:14:04,170
!انتباه من فضلكم

248
00:14:04,170 --> 00:14:09,100
،فريق آلغرين، الرّابحون في حرب ماجيكس
تلقّوا كأسَهم

249
00:14:10,560 --> 00:14:11,910
،انتهت المعارك الأشرس

250
00:14:11,910 --> 00:14:15,910
!لذا من فضلكم صفّقوا لمُنافسينا اليوم بحرارة

251
00:14:15,910 --> 00:14:18,530
تهانينا يا فريق آلغرين

252
00:14:19,360 --> 00:14:21,920
!تشعر كاروكارو بعواطف جيّاشة

253
00:14:22,720 --> 00:14:24,650
شكراً جزيلاً

254
00:14:24,650 --> 00:14:27,020
أردتُ الوقوف بجانب راي

255
00:14:24,650 --> 00:14:26,540
أبليت بلاء حسناً

256
00:14:27,670 --> 00:14:30,700
فريق فورست، كانت معركتك رائعة أيضاً

257
00:14:27,670 --> 00:14:30,700
كان وقتاً مُمتعاً بالفعل

258
00:14:30,700 --> 00:14:32,230
لم تتردّدوا أبداً

259
00:14:32,230 --> 00:14:33,090
!ماذا؟

260
00:14:34,190 --> 00:14:37,360
!أحسنت صنعاً يا آل

261
00:14:36,510 --> 00:14:38,660
!كنتَ رائعاً يا إيفي

262
00:14:39,290 --> 00:14:41,960
!تهانينا يا أميليا

263
00:14:41,960 --> 00:14:43,090
!رهيب جدّاً

264
00:14:43,090 --> 00:14:45,200
!كان هذا النّزال هو الأفضل

265
00:14:52,640 --> 00:14:53,940
كلاريس

266
00:14:55,460 --> 00:14:56,710
آسفة

267
00:14:56,710 --> 00:14:59,270
سأعود إلى المنزل الآن

268
00:15:00,210 --> 00:15:04,090
أعتقد بأنّني سآخذ استراحة
من المدرسة لبعض الوقت

269
00:15:05,990 --> 00:15:07,420
...لحـ

270
00:15:07,850 --> 00:15:09,160
إيليسا

271
00:15:09,460 --> 00:15:11,930
!ليزي، كان ذلك مُمتعاً للغاية

272
00:15:09,460 --> 00:15:12,330
أين الحمقاء الورديّة؟

273
00:15:11,930 --> 00:15:13,600
كان كذلك فعلاً

274
00:15:12,330 --> 00:15:13,430
...المعذرة

275
00:15:13,230 --> 00:15:14,190
ماذا؟

276
00:15:13,600 --> 00:15:16,480
بئساً يا ليزي، أنتِ مُتحفِّظة دوماً

277
00:15:16,480 --> 00:15:18,110
يمكنكِ الاحتفال أيضاً

278
00:15:16,810 --> 00:15:17,970
...لا

279
00:15:18,110 --> 00:15:19,530
لكنّني أفعل ذلك

280
00:15:18,630 --> 00:15:19,610
!من جديد؟

281
00:15:19,530 --> 00:15:21,140
أشعر حتّى برغبة في الرّقص قليلاً

282
00:15:19,610 --> 00:15:20,830
!حسناً

283
00:15:20,830 --> 00:15:23,370
!كان حدثاً آخر مُمتعاً للغاية

284
00:15:21,140 --> 00:15:21,740
!بجدّية؟

285
00:15:23,370 --> 00:15:27,480
!بالطّبع لاختتام البطولة، إليكم أغنية

286
00:15:26,570 --> 00:15:28,660
!ليس بعد

287
00:15:28,660 --> 00:15:30,510
!هيّا يا آبي

288
00:15:30,510 --> 00:15:32,990
هذا ليس وقت الغناء

289
00:15:32,990 --> 00:15:34,290
!هذا غير صحيح

290
00:15:34,290 --> 00:15:35,390
!الجميع ينتظرون

291
00:15:35,390 --> 00:15:37,710
على أيّ حال، لا يمكنك الغناء بعد

292
00:15:39,490 --> 00:15:42,000
...لكن لماذا

293
00:15:39,630 --> 00:15:42,000
مولاتي إيليسا، هيّا بنا

294
00:15:42,850 --> 00:15:43,880
...حسناً

295
00:15:53,720 --> 00:15:54,990
(اختلاس نظرة)

296
00:15:56,130 --> 00:16:00,270
أنا حزين لأنّه لا المُعلّمة ولا آبي ستصلان

297
00:16:00,270 --> 00:16:01,580
حقّاً؟

298
00:16:01,580 --> 00:16:05,110
من المؤسف أنّهما دُعيتا إلى اجتماع
تخطيط مُضادّ لليوجينيّين

299
00:16:06,390 --> 00:16:09,620
يبدو أنّ نشاطهما قد ازداد

300
00:16:10,460 --> 00:16:11,530
كارول؟

301
00:16:12,110 --> 00:16:13,040
كارول؟

302
00:16:13,650 --> 00:16:14,840
ما الأمر؟

303
00:16:14,840 --> 00:16:17,020
أشعر وكأنّكِ لستِ هنا

304
00:16:17,020 --> 00:16:18,780
!هذا غير صحيح

305
00:16:18,780 --> 00:16:21,450
!أنا على طبيعتي تماماً

306
00:16:24,090 --> 00:16:25,370
حقّاً؟

307
00:16:26,070 --> 00:16:27,610
مهرجان التّرنيم؟

308
00:16:28,030 --> 00:16:29,060
!أجل

309
00:16:29,060 --> 00:16:31,540
استراحة الشّتاء تمثّل مهرجان التّرنيم

310
00:16:31,540 --> 00:16:32,990
هذا صحيح

311
00:16:32,990 --> 00:16:35,360
سمعتُ بأنّ أصله يعود لحدَث

312
00:16:35,360 --> 00:16:38,400
كانت تُغنَّى فيه التّرنيمات في كنائس
مملكة آرنولد

313
00:16:38,400 --> 00:16:40,550
حسناً، هل كنت تعلم هذا؟

314
00:16:40,550 --> 00:16:42,700
مؤخّراً، أصبحت عادة لدى النّاس

315
00:16:42,700 --> 00:16:46,070
بأن يقضوا مهرجان التّرنيم مع عشّاقهم
عوضاً عن عائلاتهم

316
00:16:47,150 --> 00:16:49,140
...لذا على أيّ حال

317
00:16:49,140 --> 00:16:51,220
،كعضو في العائلات النّبيلة الثّلاثة الأفضل

318
00:16:51,220 --> 00:16:54,720
دعيتُ إلى حفلة تستضيفها رابطة السّحر

319
00:16:54,720 --> 00:16:55,610
...هل ترغب في

320
00:16:55,610 --> 00:16:57,000
يا لها من صدفة

321
00:16:57,000 --> 00:16:57,820
ماذا؟

322
00:16:57,820 --> 00:16:59,990
دعيتُ أيضاً

323
00:16:59,990 --> 00:17:02,390
كأحد السّحرة العُظماء السّبعة

324
00:17:02,390 --> 00:17:04,000
بالطّبع

325
00:17:04,000 --> 00:17:06,470
إنّها فُرصة جيّدة، لذا ارتأيتُ بأنّني
ينبغي أن أذهب

326
00:17:06,470 --> 00:17:09,740
بالطّبع، المُعلّمة آبي وكارول
ستكونان معي أيضاً

327
00:17:09,740 --> 00:17:11,210
...أجل

328
00:17:13,510 --> 00:17:15,970
!أنا مدعوّة بالطّبع أيضاً

329
00:17:15,970 --> 00:17:17,610
!ريبيكا؟

330
00:17:19,880 --> 00:17:21,750
!دُعينا أيضاً

331
00:17:21,750 --> 00:17:24,420
!لحلولنا في المركز الثّاني في حرب ماجيكس

332
00:17:24,420 --> 00:17:25,100
!ماذا؟

333
00:17:25,100 --> 00:17:27,910
بالطّبع، سأذهب أيضاً

334
00:17:28,540 --> 00:17:29,890
آرياني؟

335
00:17:30,730 --> 00:17:32,790
لماذا أنتِ هنا أيضاً؟

336
00:17:32,790 --> 00:17:34,230
!لأنّني كذلك

337
00:17:34,600 --> 00:17:37,430
يبدو أنّه سيكون مهرجان ترنيم حيويّاً

338
00:17:34,600 --> 00:17:35,960
!لا أطيق الانتظار

339
00:17:35,960 --> 00:17:37,610
!أجل! سيكون مُسلّياً

340
00:17:37,430 --> 00:17:38,800
...على ما اعتقد

341
00:17:38,110 --> 00:17:39,410
كثيراً

342
00:17:40,490 --> 00:17:43,590
لماذا سنذهب إلى آلفيليا في مهرجان
التّرنيم لهذا العام؟

343
00:17:43,590 --> 00:17:46,490
لا أدري

344
00:17:46,760 --> 00:17:50,720
مملكة يحيط بها الغموض، حيث
لا يقطنها سوى الإيلف

345
00:17:50,720 --> 00:17:53,060
،حكمَهم ملكٌ جديدٌ قبل ستّة أشهر

346
00:17:53,060 --> 00:17:55,520
لذا تنتشر إشاعات مُختلفة كثيرة

347
00:17:55,520 --> 00:17:58,760
لا أتوقّع بأنّنا نستطيع حتّى دخول البلد

348
00:17:59,610 --> 00:18:01,510
ثمّة أمر غريب حتماً

349
00:18:01,890 --> 00:18:06,370
كارول مُهذّبة جدّاً بالنّسبة لكونها
تخوض رحلة صغيرة

350
00:18:06,370 --> 00:18:08,010
راي، ما الخطب؟

351
00:18:08,010 --> 00:18:09,710
لا شيء

352
00:18:10,110 --> 00:18:11,780
مهلاً لحظة

353
00:18:12,090 --> 00:18:15,200
هل ما زال راي ينظر تجاهي؟

354
00:18:15,790 --> 00:18:16,890
!ساخن

355
00:18:16,890 --> 00:18:18,070
!نظرته ساخنة مُلتهبة

356
00:18:18,070 --> 00:18:19,770
ونحن لوحدنا تماماً؟

357
00:18:19,770 --> 00:18:23,110
أقصد بأنّه بالغ الآن، ويزداد
أناقة في كلّ عام

358
00:18:23,110 --> 00:18:26,010
،وبصراحة، إن لم يكن من باب المُزاح
لكانت مُعانقته وما شابه مُستحيلة

359
00:18:26,010 --> 00:18:27,620
!مُستحيل، مُستحيل، مُستحيل

360
00:18:27,620 --> 00:18:30,090
هل يمكنني التحقُّق من أنّه استمتع بالفعل؟

361
00:18:30,090 --> 00:18:32,890
أقصد بأنّه كان غالباً يتطلّع بلهفة
!لخوض هذه الرّحلة مع الجميع

362
00:18:32,890 --> 00:18:34,560
،أقصد، أنا متأكّدة بأنّه لا يكرهني

363
00:18:33,200 --> 00:18:35,550
كارول؟ كارول؟

364
00:18:34,560 --> 00:18:35,550
...لكنّه يقسو عليّ دوماً

365
00:18:37,850 --> 00:18:40,800
إن كنتِ مُتوعِّكة، فينبغي أن نطلب
منهم إيقاف العربة

366
00:18:43,080 --> 00:18:44,180
!أنا في أفضل حال

367
00:18:44,440 --> 00:18:46,270
!أنا على خير ما يُرام

368
00:18:46,270 --> 00:18:47,720
حقّاً؟

369
00:18:48,650 --> 00:18:54,180
على أيّ حال، سوف أتولّى القيادة
في هذه الرّحلة كامرأة أكبر سنّاً

370
00:19:02,410 --> 00:19:05,260
سيستغرق تقريباً نصف يوم
للوصول إلى آلفيليا

371
00:19:05,260 --> 00:19:08,190
سنكتفي بهذا القدر اليوم ونحظى
براحة لطيفة هنا

372
00:19:10,260 --> 00:19:11,710
يا لها من غرفة جميلة

373
00:19:13,700 --> 00:19:15,710
وإطلالة خلّابة أيضاً

374
00:19:16,550 --> 00:19:20,670
...لكن لم أكن أتوقّع مُشاركة غرفة

375
00:19:22,810 --> 00:19:27,810
!لا أصدّق بأنّ خطأ في الحجز أدّى إلى هذا

376
00:19:28,220 --> 00:19:29,670
كان ذلك شهيّاً

377
00:19:29,670 --> 00:19:30,660
أجل

378
00:19:31,460 --> 00:19:34,230
راي بالغ حقّاً

379
00:19:34,540 --> 00:19:37,200
كان ظريفاً جدّاً آنذاك

380
00:19:37,740 --> 00:19:41,210
والآن انظري كم هو رائع

381
00:19:41,720 --> 00:19:43,730
أعتقد سنعود إلى غرفتنا ونستحمّ؟

382
00:19:46,840 --> 00:19:49,500
كارول، ما الّذي تُفكِّرين فيه؟

383
00:19:50,600 --> 00:19:52,850
ينبغي أن تستعمل الحمّامَ أوّلاً

384
00:19:52,850 --> 00:19:54,800
أنتِ من ينبغي أن يدخل أوّلاً

385
00:19:55,290 --> 00:19:57,340
!أنا أستغرق وقتاً طويلاً

386
00:19:57,340 --> 00:19:58,520
...ثمّ

387
00:19:58,520 --> 00:20:00,430
سأزيل صحونكما الفارغة

388
00:20:00,430 --> 00:20:01,380
حسناً

389
00:20:03,680 --> 00:20:04,880
كارول؟

390
00:20:04,880 --> 00:20:06,440
المعذرة

391
00:20:06,440 --> 00:20:07,860
شكراً لكِ

392
00:20:08,490 --> 00:20:11,530
!الدّخول أوّلاً مُحرج

393
00:20:11,530 --> 00:20:13,780
...مثلاً... نزولك في الماء الّذي كنتُ فيه

394
00:20:13,780 --> 00:20:15,400
هل تريدان بعض الماء؟

395
00:20:15,400 --> 00:20:16,740
!لا داعي

396
00:20:19,530 --> 00:20:21,900
...دخولك سيعني

397
00:20:24,890 --> 00:20:26,690
أنا آسف لعدم مُراعاتي لذلك

398
00:20:27,100 --> 00:20:28,710
سأدخل الحمّامَ أوّلاً

399
00:20:29,400 --> 00:20:32,690
أجل. شكراً لك

400
00:20:52,810 --> 00:20:54,930
هل غلبَها النّعاس فعلاً؟

401
00:20:56,120 --> 00:20:59,270
...راي. بخصوص إيليسا

402
00:20:59,270 --> 00:21:00,350
،يبدو أنّه منذ ذلك اليوم

403
00:21:00,350 --> 00:21:02,690
كانت تأخذ إجازة من المدرسة
بسبب مُشكلة في المنزل

404
00:21:02,690 --> 00:21:06,650
مؤخّراً، بدتْ مشغولة بشيء حقّاً

405
00:21:06,650 --> 00:21:08,210
...أنا قلقة عليها قليلاً

406
00:21:08,210 --> 00:21:10,310
معكِ حقّ

407
00:21:10,310 --> 00:21:13,200
إيليسا نُقِلَتْ بواسطة إيلف، صحيح؟

408
00:21:13,200 --> 00:21:16,140
أجل. أنا متأكّدة تماماً

409
00:21:31,390 --> 00:21:34,540
أجّلي صحوة راي وايت

410
00:21:34,540 --> 00:21:36,440
هذا ما يريده المسؤولون الكبار، على أيّ حال

411
00:21:37,290 --> 00:21:39,130
...لكن هدفي الحقيقيّ هو

412
00:21:39,130 --> 00:21:40,170
...هذا

413
00:21:42,490 --> 00:21:43,470
!ماذا؟

414
00:21:43,470 --> 00:21:44,740
قِناع وجه

415
00:21:48,320 --> 00:21:50,170
تبّاً

416
00:21:50,170 --> 00:21:52,440
انخفض دافِعي عن الصّفر

417
00:21:52,810 --> 00:21:55,740
لكن... أعتقد بأنّ الأرض المُقدّسة
لها الأولويّة حاليّاً

418
00:21:56,090 --> 00:21:58,060
كيف تسير الأمور؟

419
00:21:58,060 --> 00:22:00,340
يسير كُلّ شيء بسلاسة

420
00:22:00,340 --> 00:22:01,000
حسناً

421
00:22:09,540 --> 00:22:11,870
!إنّها جميلة جدّاً

422
00:22:11,870 --> 00:22:13,500
هذه هي آلفيليا إذاً

423
00:22:13,500 --> 00:22:15,780
!ما زلتُ لا أستطيع تصديق ذلك

424
00:22:15,780 --> 00:22:19,760
يبدو أنّ تعيين الملك الجديد
أحدثَ تغييرات كثيرة

425
00:22:21,030 --> 00:22:22,780
شكراً لك يا راي

426
00:22:23,260 --> 00:22:25,460
أهلاً بكما في بلدنا

427
00:22:26,180 --> 00:22:29,520
كنّا ننتظرك يا راي وايت

428
00:22:30,060 --> 00:22:35,860
اسمي ميا، وسأكون دليلتك إلى القصر

429
00:22:35,860 --> 00:22:39,290
أُمِرتُ بالمجيء إلى هنا بشكل عاجل

430
00:22:41,660 --> 00:22:44,040
إنّه من هذا الاتّجاه

431
00:22:46,870 --> 00:22:48,560
أحضرتُهما

432
00:22:57,060 --> 00:22:57,890
!إيليسا؟

433
00:22:57,890 --> 00:22:58,670
ماذا؟

434
00:23:00,220 --> 00:23:01,610
...راي

435
00:23:48,820 --> 00:23:53,870
~ الحلقة القادمة ~

436
00:23:48,820 --> 00:23:53,870
~ الحلقة القادمة ~

437
00:23:48,820 --> 00:23:50,480
هل يمكنكم سماعي؟ حان وقت
!مُقتطفات من الحلقة القادمة

438
00:23:50,480 --> 00:23:51,280
أنا إيليسا

439
00:23:51,280 --> 00:23:52,170
أنا ميا

440
00:23:52,170 --> 00:23:53,860
!أنا بطلتكم، كاروكارو

441
00:23:53,860 --> 00:23:55,570
أنتما، ما الّذي يجري هنا؟

442
00:23:55,570 --> 00:23:56,440
لا تعليق حاليّاً

443
00:23:56,440 --> 00:23:57,240
!إلى الأمام

444
00:23:57,240 --> 00:23:58,800
!أحسنتِ يا إيليسا

445
00:23:58,800 --> 00:24:00,620
!هذا الزيّ ظريف للغاية

446
00:23:59,670 --> 00:24:00,620
!خفقان قلب

447
00:24:00,620 --> 00:24:01,570
!نبض قلبكِ عالٍ

448
00:24:01,570 --> 00:24:02,660
!أجل

449
00:24:02,660 --> 00:24:03,280
...الحلقة القادمة من

450
00:24:03,280 --> 00:24:05,370
!ساحر نصل الجليد سيحكم العالم

451
00:24:05,370 --> 00:24:06,390
!اثنان

452
00:24:05,380 --> 00:24:09,170
ساحر نصل الجليد
الّذي سيحكم العالم

453
00:24:07,110 --> 00:24:09,170
لوف يو تيندر، الحلقة 5

454
00:24:09,170 --> 00:24:15,040
الحلقة 5
الفتى الّذي يُعدّ السّاحر الأقوى في العالم
يخرج في مُواعدة مع تلك الفتاة في بلد أجنبيّ

455
00:24:09,390 --> 00:24:11,700
...الفتى الّذي يُعدّ السّاحر الأقوى في العالم"

456
00:24:11,700 --> 00:24:13,600
