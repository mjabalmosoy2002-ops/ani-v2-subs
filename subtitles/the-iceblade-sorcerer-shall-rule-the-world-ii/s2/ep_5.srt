1
00:00:01,770 --> 00:00:06,530
منذ كنتُ طفلة، لاحظتُ بأنّني
لستُ مثل الآخرين

2
00:00:06,990 --> 00:00:11,180
كان أبي بشريّاً، لكن كانت أمّي من الإيلف

3
00:00:11,610 --> 00:00:13,620
لذا كنتُ نصف إيلف

4
00:00:15,170 --> 00:00:16,890
!انظروا إلى هذه

5
00:00:16,890 --> 00:00:18,680
!أجل. يا لها من أُذنين غريبتين

6
00:00:18,680 --> 00:00:22,820
عاملَني النّاسُ من حولي كغريبة وحملقوا بي

7
00:00:23,200 --> 00:00:24,370
...لهذا السّبب

8
00:00:24,930 --> 00:00:27,150
لستُ بحاجة أصدقاء

9
00:00:28,090 --> 00:00:30,720
...هذا ما كنتُ أعتقده دوماً

10
00:00:33,350 --> 00:00:35,380
!مُذهل

11
00:00:35,670 --> 00:00:39,970
نمط أبنيتهم وتصميمها مُختلف
جدّاً عن مملكتنا

12
00:00:39,970 --> 00:00:42,730
هذه هي ثقافة آلفيريا إذاً

13
00:00:42,730 --> 00:00:46,120
يُفترض أن يُعزّز هذا الحدَث
،العلاقات الودّية مع آرنولد أيضاً

14
00:00:46,120 --> 00:00:50,100
لذا أعتقد بأنّ آلفيريا تبذل ما بوسعها
لترك انطباع جيّد

15
00:00:50,100 --> 00:00:51,650
!تماماً

16
00:00:51,650 --> 00:00:54,190
،آلفيريا معروفة بشعبها المُحافظ

17
00:00:54,190 --> 00:00:56,490
!وانفتحوا أخيراً على الدّبلوماسيّة

18
00:00:56,490 --> 00:00:59,410
سيُدوَّن مهرجان التّرنيم هذا في التّاريخ

19
00:00:59,410 --> 00:01:01,480
!الأميرة أوليفيا

20
00:01:01,480 --> 00:01:03,920
تسرّني رؤيتكن يا آنسات

21
00:01:04,270 --> 00:01:06,210
مضى وقت طويل

22
00:01:06,210 --> 00:01:07,250
طويل جدّاً

23
00:01:07,250 --> 00:01:08,720
بالمُناسبة يا ماريا

24
00:01:09,180 --> 00:01:11,290
أين عزيزي راي؟

25
00:01:11,290 --> 00:01:13,010
أنا لا أراه

26
00:01:13,010 --> 00:01:14,430
...في الواقع

27
00:01:14,430 --> 00:01:15,660
..."عزيزي"

28
00:01:15,660 --> 00:01:16,430
راي؟

29
00:01:16,430 --> 00:01:17,410
...ماريا

30
00:01:18,940 --> 00:01:21,200
هل تعرفين شيئاً عن هذا؟

31
00:01:21,930 --> 00:01:24,640
في الواقع، لم نأتِ إلى هنا معاً

32
00:01:24,640 --> 00:01:25,820
هكذا إذاً

33
00:01:25,820 --> 00:01:28,430
ما الّذي تفعله الأميرة هنا؟

34
00:01:28,640 --> 00:01:30,790
أعتقد إن كنتِ جزءاً من العائلات النّبيلة
،الثّلاث الأفضل

35
00:01:30,790 --> 00:01:32,950
فستتمكّنين من التعرُّف على الأميرة

36
00:01:32,950 --> 00:01:35,400
كافّة الشّخصيّات الهامّة موجودة هناك

37
00:01:35,400 --> 00:01:37,240
...أليس من المُفترض لها أن تكون

38
00:01:37,240 --> 00:01:38,370
!مـ-مهلاً

39
00:01:38,950 --> 00:01:40,140
ماذا؟

40
00:01:40,140 --> 00:01:41,200
...هذا

41
00:01:42,040 --> 00:01:43,330
راي؟

42
00:01:43,330 --> 00:01:45,740
!وإيليسا؟

43
00:01:46,610 --> 00:01:49,360
ماذا تفعل إيليسا هناك؟

44
00:01:49,360 --> 00:01:51,040
...هذا الشّخص

45
00:01:51,900 --> 00:01:55,240
!هذا الشّخص هو حبيبي

46
00:02:21,000 --> 00:02:23,850
!ماذا؟

47
00:02:28,490 --> 00:02:32,460
ساحر نصل الجليد
الّذي سيحكم العالم

48
00:02:33,220 --> 00:02:37,010
الحلقة 5
الفتى الّذي يُعدّ السّاحر الأقوى في العالم
يخرج في مُواعدة مع تلك الفتاة في بلد أجنبيّ

49
00:02:38,500 --> 00:02:41,250
أنتِ من عائلة آلفيريّة ملكيّة؟

50
00:02:41,820 --> 00:02:44,760
أعتقد بأنّني وليّة العهد الرّابعة

51
00:02:44,760 --> 00:02:47,340
اكتشفتُ ذلك مؤخّراً فقط

52
00:02:47,340 --> 00:02:48,260
ماذا؟

53
00:02:48,560 --> 00:02:50,270
ما معنى هذا؟

54
00:02:50,600 --> 00:02:54,770
كانت أمّي من العائلة الآلفيريّة الملكيّة

55
00:02:55,080 --> 00:02:58,270
لكن يبدو أنّها غادرت البلد طوال الوقت

56
00:02:58,540 --> 00:03:02,610
هكذا التقت بأبي وهربتْ معه

57
00:03:02,610 --> 00:03:05,570
يبدو أنّ أمّكِ مُفعمة بالحيويّة

58
00:03:05,570 --> 00:03:07,370
هربتْ؟

59
00:03:07,370 --> 00:03:09,740
لِهذا وقع رومانسيّ

60
00:03:08,900 --> 00:03:10,390
هذا ما حدث إذاً

61
00:03:10,780 --> 00:03:14,540
سواء كنتِ ملكيّة أم لا، هذا هو أنت

62
00:03:14,540 --> 00:03:16,300
هذا لا يُغيّر شيئاً

63
00:03:21,290 --> 00:03:25,940
حضّرنا غرفة... لكلّ واحد منكم
!خلال فترة إقامتكم

64
00:03:21,300 --> 00:03:24,010
!لا، لا

65
00:03:25,940 --> 00:03:27,130
!هذا ليس عدلاً

66
00:03:27,130 --> 00:03:30,250
في الأمس، كنّا في نفس الغرفة

67
00:03:29,570 --> 00:03:32,590
!أحسني السُّلوك رجاء

68
00:03:33,690 --> 00:03:38,560
سمعتُ بأنّ أصدقاءك من المدرسة
دخلوا البلد قبل مدّة

69
00:03:38,560 --> 00:03:41,360
ينبغي أن يصلوا إلى قاعة
الاجتماعات عمّا قريب

70
00:03:41,360 --> 00:03:42,620
شكراً لكِ

71
00:03:46,190 --> 00:03:47,400
راي

72
00:03:48,560 --> 00:03:50,230
يبدو هذا رائعاً عليكِ

73
00:03:50,230 --> 00:03:53,340
تبدين كجنّية أنيقة بهذا الفُستان

74
00:03:54,150 --> 00:03:56,210
شكراً لك

75
00:03:56,530 --> 00:03:58,390
...و... المعذرة

76
00:03:58,390 --> 00:03:59,450
ما الأمر؟

77
00:03:59,450 --> 00:04:03,580
سأعرّف عن نفسي لكافّة أولئك
الأشخاص الهامّين

78
00:04:03,960 --> 00:04:06,520
هل تُمانع المجيء معي؟

79
00:04:06,520 --> 00:04:08,470
يمكنكِ الاعتماد عليّ

80
00:04:11,720 --> 00:04:13,910
أتلك هي الأميرة الشّهيرة إيليسا؟

81
00:04:13,910 --> 00:04:15,830
أجل. ابنة ساريا-ساما

82
00:04:15,830 --> 00:04:17,730
يُقال بأنّها كانت في آرنولد
طوال هذا الوقت

83
00:04:18,680 --> 00:04:21,850
يسرّني أنّكِ استطعتِ المجيء يا إيليسا

84
00:04:22,240 --> 00:04:25,050
أنا الملِك أبيل آلفيريوس

85
00:04:25,050 --> 00:04:27,000
سررتُ بلقائك

86
00:04:27,000 --> 00:04:30,770
كانت أمّكِ ساريا أختي الصُّغرى

87
00:04:30,770 --> 00:04:33,500
يعني بأنّني خالُكِ على ما أعتقد

88
00:04:33,500 --> 00:04:35,830
حـ-حقّاً؟

89
00:04:35,830 --> 00:04:38,910
وهذا أخي الأصغر سيريل

90
00:04:38,910 --> 00:04:41,140
سررتُ بلقائكِ. أهلاً وسهلاً

91
00:04:41,140 --> 00:04:42,560
...كـ-كذلك أنا

92
00:04:42,560 --> 00:04:44,280
أعتقد هذا هو لقاؤنا الأوّل

93
00:04:44,280 --> 00:04:46,260
أنا وليّ العهد رالد

94
00:04:46,700 --> 00:04:49,510
شرف لي أن أمتلك أختاً صُغرى ظريفة مثلكِ

95
00:04:49,510 --> 00:04:52,130
سـ-سررتُ بلقائك

96
00:04:52,130 --> 00:04:53,030
كذلك أنا

97
00:04:53,030 --> 00:04:55,060
!مرحباً يا إيليسا

98
00:04:55,390 --> 00:04:58,220
أنا كاثي، وليّة العهد الثّالثة

99
00:04:58,220 --> 00:04:59,300
أ-أجل

100
00:04:59,300 --> 00:05:00,860
!من الرّائع أن ألتقي بكِ يا إيليسا

101
00:05:00,860 --> 00:05:02,250
،منذ سمعتُ بأنّ لديّ أخت صُغرى

102
00:05:02,250 --> 00:05:05,420
!أردتُ أن ألتقي بكِ بحماس شديد

103
00:05:05,420 --> 00:05:09,030
وجود أخت صُغرى ظريفة مثلكِ
هو كحلم قد تحقّق

104
00:05:09,030 --> 00:05:11,540
ناديني "أختي الكُبرى" رجاء

105
00:05:11,540 --> 00:05:13,120
أعتقد يمكنكِ أن تُناديني "أختاه الكُبرى" أيضاً

106
00:05:13,120 --> 00:05:15,980
لكن أحبّ أن يكون ذلك أكثر عفويّة

107
00:05:15,980 --> 00:05:18,440
إذاً ما رأيكِ بـ"أختي الكُبرى"؟

108
00:05:19,600 --> 00:05:20,930
...في الواقع

109
00:05:20,930 --> 00:05:22,050
وأيضاً

110
00:05:22,310 --> 00:05:24,970
بخصوص الرّجل المُهذّب البشريّ

111
00:05:25,580 --> 00:05:27,790
ما يكون في نظركِ؟

112
00:05:27,790 --> 00:05:29,280
...أجل. أنا

113
00:05:29,280 --> 00:05:31,210
...هذا الشّخص

114
00:05:31,210 --> 00:05:33,800
!هذا الشّخص هو حبيبي

115
00:05:33,800 --> 00:05:35,390
!حبيبي

116
00:05:47,430 --> 00:05:51,080
أجل. أنا حبيبها

117
00:05:56,580 --> 00:06:00,130
...وأنا الّتي اعتبرتُها خجولة ومُؤدّبة

118
00:06:00,130 --> 00:06:01,860
!إنّها ليست سيّئة

119
00:06:03,980 --> 00:06:06,690
!ما... ماذا؟

120
00:06:08,090 --> 00:06:12,090
هلّا كرّرت ذلك مرّة أُخرى؟

121
00:06:12,090 --> 00:06:13,300
أجل

122
00:06:13,300 --> 00:06:15,970
أنا وإيليسا تظاهرنا في النّهاية بأنّنا حبيبان

123
00:06:16,230 --> 00:06:19,970
من فضلكِ انصحيني حول كيفيّة
التصرُّف كحبيب

124
00:06:19,970 --> 00:06:23,990
وصلنا للتو إلى آلفيريا فيحدث هذا؟

125
00:06:24,410 --> 00:06:25,980
ما رأيك يا آبي؟

126
00:06:26,410 --> 00:06:28,030
لا تعليق

127
00:06:29,960 --> 00:06:33,990
...حسناً، أنا خبيرة في كلّ الجوانب

128
00:06:33,990 --> 00:06:36,230
!لم أتوقّع أقلّ من ذلك يا مُعلِّمة

129
00:06:37,610 --> 00:06:40,600
هل من شيء تُضيفينه يا كارلا؟

130
00:06:40,880 --> 00:06:43,880
تريد أن تتصرّف وكأنّك على علاقة مع إيليسا

131
00:06:43,880 --> 00:06:45,620
هل هذا صحيح؟

132
00:06:45,860 --> 00:06:46,830
أجل

133
00:06:48,100 --> 00:06:50,150
!أنا آسفة جدّاً بشأن ما سبق

134
00:06:50,150 --> 00:06:52,260
لا أُمانع

135
00:06:52,260 --> 00:06:54,380
لكن ماذا حدث؟

136
00:06:54,380 --> 00:07:00,470
لكن شعرتُ وكأنّ الجميع كانوا
يُعاملونني وكأنّني شيء

137
00:07:00,470 --> 00:07:01,960
...شعرتُ بالخوف

138
00:07:02,990 --> 00:07:07,170
لأجل إيليسا، أريد أن ألعب
!دور حبيبها بشكل مثاليّ

139
00:07:07,170 --> 00:07:08,550
عُلِم

140
00:07:08,550 --> 00:07:12,940
ما مُستوى المُغازلة الّذي تتصوّره؟

141
00:07:12,940 --> 00:07:14,760
ماذا كان سبب تقاربكما؟

142
00:07:14,760 --> 00:07:17,380
ما الّذي تُحبّ إيليسا فعله في المُواعدات؟

143
00:07:17,380 --> 00:07:18,650
أنا آسف

144
00:07:18,650 --> 00:07:20,650
لم أفكِّر في كلّ ذلك إطلاقاً

145
00:07:20,650 --> 00:07:22,020
هكذا إذاً

146
00:07:22,020 --> 00:07:25,490
ستحتاج كثيراً من التّدريب

147
00:07:25,490 --> 00:07:26,920
شكراً على توجيهاتكِ

148
00:07:26,920 --> 00:07:28,070
...هل يُعقَل

149
00:07:28,070 --> 00:07:31,420
!كارلا ماهرة جدّاً في مجال... الرّومانسيّة؟

150
00:07:31,420 --> 00:07:33,880
سنبدأ من الأساسيّات

151
00:07:33,880 --> 00:07:34,750
!حاضر

152
00:07:37,270 --> 00:07:40,170
لم أكن أتوقّع هذا

153
00:07:40,170 --> 00:07:41,940
...من كان يتوقّع أن تكون أنت وإيليسا

154
00:07:41,940 --> 00:07:43,950
متى بدأ ذلك حتّى؟

155
00:07:44,150 --> 00:07:45,450
أنا آسف

156
00:07:45,450 --> 00:07:47,440
لا أستطيع شرح التّفاصيل لكما

157
00:07:48,330 --> 00:07:52,350
،حسناً، بغضّ النّظر عن الظّروف
نحن في صفّك

158
00:07:52,350 --> 00:07:53,200
!هذا صحيح

159
00:07:53,430 --> 00:07:54,770
...أنتما

160
00:07:55,190 --> 00:07:56,480
...حسناً إذاً

161
00:07:56,480 --> 00:07:57,700
حان الوقت...

162
00:07:57,700 --> 00:07:59,240
ستخرجان من الآن؟

163
00:07:59,240 --> 00:08:01,670
...إن لم نحصل على ذلك التّقرير

164
00:08:01,670 --> 00:08:03,340
!إنّه وقت التّدريب

165
00:08:04,890 --> 00:08:07,010
صحيح، التّدريب

166
00:08:07,010 --> 00:08:08,130
!إلى اللّقاء يا راي

167
00:08:08,130 --> 00:08:09,910
...حسناً

168
00:08:17,700 --> 00:08:20,970
إذاً أنت راي وايت؟

169
00:08:21,240 --> 00:08:24,480
...أجل. وأنت

170
00:08:24,480 --> 00:08:27,720
ماريوس باسّي

171
00:08:27,940 --> 00:08:29,250
...ماريوس

172
00:08:30,620 --> 00:08:32,640
ساحر الفسفوريّة

173
00:08:32,640 --> 00:08:35,150
يسرّني لقاؤك يا نصل الجليد

174
00:08:36,350 --> 00:08:39,960
سأبقى هنا لبعض الوقت

175
00:08:39,960 --> 00:08:42,240
إن حدث شيء، فأبلغني رجاء

176
00:08:42,240 --> 00:08:45,170
المعذرة، شكراً جزيلاً لك

177
00:08:46,810 --> 00:08:49,380
سأذهب الآن

178
00:08:53,280 --> 00:08:54,890
الماء السّاخن قد أثّرَ عليه

179
00:08:59,760 --> 00:09:00,890
...أنتن

180
00:09:00,890 --> 00:09:02,500
يـ-يا لها من صدفة

181
00:09:02,500 --> 00:09:05,170
كنّا نتمشّى للتو

182
00:09:05,170 --> 00:09:06,260
ماذا؟

183
00:09:06,260 --> 00:09:10,920
...في الواقع، ما شعورك تجاه

184
00:09:10,920 --> 00:09:12,160
تجاه؟

185
00:09:12,160 --> 00:09:14,890
...حتّى لو لم تستطع إعطاء تفاصيل

186
00:09:14,890 --> 00:09:18,260
!ما موقفك من المُواعدة والرّومانسيّة؟

187
00:09:22,690 --> 00:09:24,110
لا أعلم

188
00:09:25,020 --> 00:09:27,590
،تعلّمتُ الكثير من كارلا

189
00:09:27,590 --> 00:09:29,800
لكن ما زلتُ لا أملك خبرةً في ذلك

190
00:09:29,800 --> 00:09:31,810
!هكذا إذاً

191
00:09:31,810 --> 00:09:33,800
هذا ما حدث إذاً

192
00:09:34,620 --> 00:09:36,970
لـ-لا شيء

193
00:09:36,970 --> 00:09:40,550
أردنا فقط أن نكون في الجانب السّليم

194
00:09:42,150 --> 00:09:44,120
رومانسيّة؟

195
00:09:44,120 --> 00:09:46,060
كيف هو شعور إيليسا يا تُرى؟

196
00:09:50,080 --> 00:09:51,240
يامو

197
00:09:52,130 --> 00:09:55,610
راي، هذه هي غرفتك في هذه اللّيلة

198
00:09:55,960 --> 00:09:56,810
تصبح على خير

199
00:10:00,140 --> 00:10:02,140
سأنام على الأرض

200
00:10:02,140 --> 00:10:06,420
أعتقد هذا لأنّه يُفترض بنا أن نكون حبيبين

201
00:10:06,420 --> 00:10:07,820
...لكنّني

202
00:10:08,850 --> 00:10:12,330
!لا أُمانع

203
00:10:15,420 --> 00:10:17,290
راي، هل أنت مُستيقظ؟

204
00:10:18,540 --> 00:10:19,540
أجل

205
00:10:20,160 --> 00:10:23,230
من جديد، دعني أعتذر

206
00:10:23,230 --> 00:10:24,810
ليس عليك القلق بشأن ذلك

207
00:10:24,810 --> 00:10:26,200
...لكن

208
00:10:26,200 --> 00:10:28,090
نحن صديقان

209
00:10:28,090 --> 00:10:30,480
إذا احتجتِ مُساعدتي، فيمكنكِ
أن تطلبي في أيّ وقت

210
00:10:31,680 --> 00:10:35,680
وأيضاً أريد سماع كلام امتنان بدلاً من اعتذار

211
00:10:35,980 --> 00:10:37,310
امتنان؟

212
00:10:37,310 --> 00:10:38,200
أجل

213
00:10:38,200 --> 00:10:40,190
لا شيء يدعو للشّعور بتأنيب الضّمير

214
00:10:40,600 --> 00:10:42,700
لذا يمكنكِ أن تقولي "شكراً لك" فحسب

215
00:10:42,700 --> 00:10:43,950
هذا يكفي

216
00:10:44,530 --> 00:10:48,380
راي. شكراً لك

217
00:10:48,380 --> 00:10:49,290
على الرّحب

218
00:10:50,050 --> 00:10:53,720
من كان يتوقّع بأنّ إيليسا هي
وليّة العهد الرّابعة؟

219
00:10:54,020 --> 00:10:55,960
هل كنتِ تعلمين أيضاً يا آبي؟

220
00:10:55,960 --> 00:10:57,560
تقريباً

221
00:10:57,560 --> 00:10:59,340
فأنا المُديرة في نهاية المطاف

222
00:10:59,340 --> 00:11:01,210
!مُديرتنا المُذهلة

223
00:11:01,210 --> 00:11:06,800
لكن توقيت هذا الاستدعاء يجعلني
أتساءل ما إن كان هناك خطّة خفيّة

224
00:11:07,720 --> 00:11:09,710
أجل

225
00:11:09,710 --> 00:11:12,720
لكن تلك الفتاة قد عانت

226
00:11:13,180 --> 00:11:16,390
أقصد بأنّ عليها مُواجهة نفسها الآن

227
00:11:19,320 --> 00:11:21,890
إيليسا، استيقظي رجاء

228
00:11:21,890 --> 00:11:22,980
إيليسا

229
00:11:28,250 --> 00:11:31,400
صباح الخير يا راي

230
00:11:31,400 --> 00:11:33,150
صباح الخير

231
00:11:33,670 --> 00:11:37,650
يجدر بكِ أن تغلقي الأزرار على صدركِ

232
00:11:43,660 --> 00:11:45,270
الطّقس مُبهر

233
00:11:45,270 --> 00:11:47,520
إيليسا، لنخرج في مُواعدة

234
00:11:47,520 --> 00:11:49,060
!خفقان

235
00:11:49,060 --> 00:11:53,020
...خفقان... خفقان... خفقان

236
00:11:53,550 --> 00:11:54,420
هيّا

237
00:11:56,330 --> 00:11:59,780
يُفترض أن نكون حبيبين

238
00:11:59,780 --> 00:12:03,950
والحبيبان يمسكان بأيدي بعضهما الآخر
...بالطّبع عندما يمشيان في الخارج

239
00:12:03,950 --> 00:12:05,270
حسبما يُزعَم

240
00:12:05,670 --> 00:12:07,900
المُواعدة تعني الإمساك بالأيدي

241
00:12:07,900 --> 00:12:09,990
رافقها بمهارة

242
00:12:10,570 --> 00:12:12,810
رُبّما لا تريدين ذلك؟

243
00:12:12,810 --> 00:12:13,540
ماذا؟

244
00:12:13,540 --> 00:12:15,570
!لا

245
00:12:16,560 --> 00:12:19,050
!حسناً إذاً، المعذرة

246
00:12:22,200 --> 00:12:23,490
!مرحى

247
00:12:23,490 --> 00:12:24,430
!توري

248
00:12:24,430 --> 00:12:25,690
ماذا يا سوغاري؟

249
00:12:25,690 --> 00:12:27,050
!أُحبّك

250
00:12:27,050 --> 00:12:28,090
!أُحبّك أيضاً

251
00:12:28,090 --> 00:12:29,870
!مرحى

252
00:12:35,750 --> 00:12:39,580
على الرّجل أيضاً أن يُوافق مشيَتَه
مع مشية الفتاة

253
00:12:43,860 --> 00:12:48,420
أحياناً، التّباهي بقوّتك الجسديّة مُهمّ أيضاً

254
00:12:51,200 --> 00:12:56,420
القيام بذلك يسمح لشريكتك بالشّعور
بالرّاحة والاسترخاء في المُواعدة

255
00:13:01,090 --> 00:13:02,760
!يا لها من زهور غريبة

256
00:13:02,760 --> 00:13:04,660
،رأيتُ هذه في كِتاب مرجعيّ سابقاً

257
00:13:04,660 --> 00:13:07,190
لكن هذه أوّل مرّة أراها فيها
في الحياة الواقعيّة

258
00:13:07,190 --> 00:13:08,760
!إنّها الأميرة

259
00:13:08,760 --> 00:13:09,970
!أجل

260
00:13:10,340 --> 00:13:11,940
!سموّ الأميرة

261
00:13:12,360 --> 00:13:13,740
إنّها جميلة جدّاً

262
00:13:13,740 --> 00:13:14,890
!يا للرّوعة

263
00:13:15,460 --> 00:13:18,190
يبدو أنّ حتّى هؤلاء الأطفال
يعلمون من تكونون

264
00:13:18,190 --> 00:13:19,620
...المعذرة

265
00:13:19,620 --> 00:13:22,600
أنتما حبيبان، أليس كذلك؟

266
00:13:23,820 --> 00:13:27,130
هيّا، أفشيا السرّ. إلى أين
وصلتُما في العلاقة؟

267
00:13:27,130 --> 00:13:28,440
!إلى أين؟

268
00:13:28,870 --> 00:13:30,640
!تشابُك الأيدي؟

269
00:13:30,970 --> 00:13:32,570
مُشاركة سرير؟

270
00:13:33,370 --> 00:13:35,250
!النّوم معاً؟

271
00:13:34,520 --> 00:13:36,430
...ثمّ

272
00:13:36,430 --> 00:13:37,770
قُبلات؟

273
00:13:37,770 --> 00:13:38,880
وما شابه؟

274
00:13:38,880 --> 00:13:41,150
...قُـ-قُـ

275
00:13:41,150 --> 00:13:42,120
!إيليسا

276
00:13:42,120 --> 00:13:43,170
هل أنتِ بخير؟

277
00:13:43,930 --> 00:13:45,720
المعذرة رجاء

278
00:13:46,580 --> 00:13:48,720
الأميرة إيليسا مُرهَقة

279
00:13:48,720 --> 00:13:50,390
يجب أن نذهب الآن

280
00:13:50,390 --> 00:13:51,890
حسناً

281
00:13:54,290 --> 00:13:55,390
متِّعنَ أنظاركن

282
00:13:55,390 --> 00:13:58,120
هذا حملُ أميرة حقيقيّ

283
00:13:58,120 --> 00:13:59,190
!بكلّ تأكيد

284
00:13:59,190 --> 00:14:00,340
هكذا إذاً

285
00:14:00,340 --> 00:14:03,330
الإيلف أكبر سنّاً ممّا يبدين

286
00:14:09,750 --> 00:14:11,560
راي؟

287
00:14:11,940 --> 00:14:13,370
هل تعافيتِ؟

288
00:14:14,280 --> 00:14:16,590
...أنا آسفة جدّاً! أنا

289
00:14:16,590 --> 00:14:17,720
لا تقلقي بشأن ذلك

290
00:14:20,430 --> 00:14:24,710
لكن هذا ليس سهلاً، أليس كذلك؟

291
00:14:24,710 --> 00:14:27,400
التصرُّف وكأنّنا زوجان

292
00:14:28,840 --> 00:14:31,480
أجل... معك حقّ

293
00:14:36,050 --> 00:14:37,280
إيليسا؟

294
00:14:37,280 --> 00:14:38,310
!راي

295
00:14:39,430 --> 00:14:41,550
هل يمكنني التمرُّن أكثر؟

296
00:14:43,600 --> 00:14:44,560
أجل

297
00:14:43,930 --> 00:14:46,300
توقّفا عندكما

298
00:14:47,420 --> 00:14:49,540
وليّة العهد الثّالثة كاثي؟

299
00:14:50,810 --> 00:14:54,320
أنت حبيب إيليسا، صحيح؟

300
00:14:54,320 --> 00:14:55,990
أجل، صحيح

301
00:14:55,990 --> 00:14:58,570
!كيف تجرؤ على أن تكون وقحاً هكذا؟

302
00:14:58,840 --> 00:15:00,410
!رأيتُك البارحة

303
00:15:00,410 --> 00:15:03,530
!تستمتع مع مجموعة من الفتيات البشريّات

304
00:15:03,530 --> 00:15:04,880
!خائن، خائن

305
00:15:04,880 --> 00:15:05,970
!غير مُخلص

306
00:15:06,530 --> 00:15:07,820
!غير مُخلص! غير مُخلص

307
00:15:07,820 --> 00:15:09,340
!خائن لعين

308
00:15:09,340 --> 00:15:11,030
!مُخادع

309
00:15:10,190 --> 00:15:12,210
!مُخادع

310
00:15:13,340 --> 00:15:15,420
إنّهن صديقاتي

311
00:15:15,420 --> 00:15:17,030
لا توجد خيانة إطلاقاً

312
00:15:17,030 --> 00:15:21,400
كنتُ سعيدة منذ سمعتُ بأنّ
لديّ أخت صُغرى

313
00:15:21,400 --> 00:15:25,110
أقسمتُ بأن أهتمّ بها مهما
كلّف الأمر، وأينما تواجدت

314
00:15:25,110 --> 00:15:29,530
ونخرج معاً وأُلبسها ملابس جميلة
وأمشّط شعرها الجميل

315
00:15:29,530 --> 00:15:31,570
!كم من الرّائع القدرة على فعل تلك الأمور

316
00:15:31,570 --> 00:15:36,670
قلتُ بأنّني سأفعل كُلّ شيء لأجلها
!وأجعلها تُحبّ آلفيريا

317
00:15:36,670 --> 00:15:38,260
!لماذا إذاً؟

318
00:15:38,260 --> 00:15:41,740
!لماذا تحظى بحبيب بشريّ؟

319
00:15:42,240 --> 00:15:45,330
رغم ذلك، حاولتُ المُستحيل لتفهُّم الأمر

320
00:15:45,330 --> 00:15:49,860
،أقنعتُ نفسي أنّه بما أنّ إيليسا اختارته
فلا يمكن أن يكون رجلاً فظيعاً

321
00:15:50,260 --> 00:15:52,240
!لكن كان كُلّ ذلك خاطئاً

322
00:15:52,240 --> 00:15:53,920
!يا زير النّساء

323
00:15:53,920 --> 00:15:56,300
الأميرة كاثي، هذا التّعبير غير لائق

324
00:15:56,300 --> 00:15:57,540
حقّاً؟

325
00:15:57,540 --> 00:15:58,650
صدّقيني

326
00:15:59,750 --> 00:16:02,480
يا مُحبّ النّساء، عسى أن تهوي
!في جحيم من الزّيت

327
00:16:03,580 --> 00:16:06,400
أنت غير جدير بثِقتي

328
00:16:06,400 --> 00:16:09,850
من الواضح بأنّ قلبك لا ينبض
!لأجل إيليسا لوحدها

329
00:16:09,850 --> 00:16:11,400
...المعذرة يا سموّ الأميرة كا

330
00:16:11,400 --> 00:16:12,760
!هذا غير صحيح

331
00:16:13,140 --> 00:16:16,230
!أحبّ إيليسا من كلّ أعماق قلبي

332
00:16:19,080 --> 00:16:20,170
إيليسا؟

333
00:16:20,170 --> 00:16:21,700
إيليسا، هل أنتِ بخير؟

334
00:16:21,700 --> 00:16:22,990
!أنت لا تُجيد سوى الكلام

335
00:16:22,990 --> 00:16:26,870
،لكن إذا نجحتَ في اختبار منّي

336
00:16:25,240 --> 00:16:26,310
!إيليسا

337
00:16:26,870 --> 00:16:29,200
فيمكنني القبول حينها إذاً

338
00:16:29,200 --> 00:16:30,160
رُبّما

339
00:16:30,810 --> 00:16:32,590
اختبار؟

340
00:16:32,590 --> 00:16:33,430
أجل

341
00:16:33,430 --> 00:16:38,450
أحد أخطر الأماكن في آلفيريا
هو غابة بارادي

342
00:16:38,450 --> 00:16:42,260
!أحضر لي لُفّاحاً من تلك الغابة

343
00:16:42,260 --> 00:16:43,680
هذا كُلّ شيء؟

344
00:16:44,710 --> 00:16:48,430
!حتّى بين الإيلف، يُعدّ هذا الاختبار الأصعب

345
00:16:48,430 --> 00:16:49,930
!وما السّبب؟

346
00:16:49,930 --> 00:16:52,110
...عندما تسحب اللُّفّاح من التّربة

347
00:16:52,110 --> 00:16:53,970
!يطلق اللُّفّاح صرخةً قبيحة

348
00:16:53,970 --> 00:16:55,750
أيّ شخص يراه سيُغمى عليه
ويشعر بألم مُبرح

349
00:16:55,750 --> 00:16:58,160
!على أيّ حال، إنّه توقيتٌ سيّئ جدّاً

350
00:16:58,160 --> 00:17:00,570
ما قولك؟ هذا مُرعب، أليس كذلك؟

351
00:17:00,790 --> 00:17:04,530
أنا مُدركة تماماً لمدى استحالة هذه المهمّة

352
00:17:04,530 --> 00:17:08,260
لكن لن أقبل شيئاً أقلّ من قوّة كافية
!لحماية العائلة الملكيّة الآلفيريّة

353
00:17:08,260 --> 00:17:12,170
ويمكنك أن تبكي وتعتذر وتنفصل
عن إيليسا إن أردت

354
00:17:11,450 --> 00:17:12,620
مُوافق

355
00:17:13,580 --> 00:17:16,590
سأذهب وأحصد لُفّاحاً

356
00:17:16,840 --> 00:17:20,600
سأبدأ بالتّحضيرات حالاً وأغادر
في صباح الغد باكراً

357
00:17:20,920 --> 00:17:22,610
هل هناك حدٌّ زمنيّ؟

358
00:17:23,690 --> 00:17:27,860
حتّى الغسق... رُبّما؟

359
00:17:28,050 --> 00:17:29,250
عُلِم

360
00:17:29,620 --> 00:17:30,750
أعدكِ بأنّني سأعود به

361
00:17:35,530 --> 00:17:37,360
أنا آسف يا ميا

362
00:17:37,360 --> 00:17:40,610
سأحضّر نفسي هنا اللّيلة لأجل يوم غد

363
00:17:40,610 --> 00:17:42,730
اهتمّي بإيليسا رجاء

364
00:17:42,730 --> 00:17:45,240
أجل. سأعتني بها

365
00:17:47,190 --> 00:17:49,240
أنا لوحدي ثانية

366
00:17:55,750 --> 00:17:57,490
كلاريس؟

367
00:17:57,490 --> 00:17:58,900
ها أنا هنا

368
00:18:00,020 --> 00:18:05,530
لهذا السّبب يخضع راي
لاختبار أختكِ الكُبرى

369
00:18:05,530 --> 00:18:08,600
أجل. كان قد أُنجِزَ بالفعل عندما استيقظت

370
00:18:08,600 --> 00:18:10,630
استيقظتِ من ماذا؟

371
00:18:10,630 --> 00:18:13,520
في الواقع، أقصد كنتُ أنظر
!في اتّجاه آخر حينها

372
00:18:14,500 --> 00:18:19,410
منذ أتيتُ إلى هنا، كان كُلّ شيء مُشوّشاً

373
00:18:20,720 --> 00:18:25,290
والآن، انتهى المطاف بي بتوريط
راي والتسبُّب بمتاعب له

374
00:18:25,290 --> 00:18:27,790
لا أعرف ماذا أفعل

375
00:18:27,790 --> 00:18:29,980
ما كنتُ لأقلق بشأن ذلك

376
00:18:29,980 --> 00:18:32,350
إنّه راي، لذا سيكون بخير مهما حدث

377
00:18:32,350 --> 00:18:33,370
...لكن

378
00:18:35,040 --> 00:18:36,340
إيليسا؟

379
00:18:36,340 --> 00:18:37,880
هل هناك شخص معك؟

380
00:18:37,880 --> 00:18:40,390
لا! أنا أتكلّم مع نفسي

381
00:18:40,390 --> 00:18:41,480
حسناً

382
00:18:41,480 --> 00:18:44,650
هل ترغبين في تناول عشائكِ في غرفتكِ؟

383
00:18:44,650 --> 00:18:46,690
سأنزل للأكل

384
00:18:46,690 --> 00:18:47,940
أمركِ

385
00:18:47,940 --> 00:18:49,540
إذاً سأذهب للتّحضير

386
00:18:47,940 --> 00:18:49,260
يجدر بي الذّهاب

387
00:18:49,540 --> 00:18:51,260
!شكراً لكِ

388
00:18:50,530 --> 00:18:51,800
أراكِ غداً

389
00:18:52,310 --> 00:18:53,820
غداً؟

390
00:18:53,820 --> 00:18:55,810
هل هذا يعني بأنّكِ ستأتين أيضاً؟

391
00:18:56,570 --> 00:18:58,630
أهذا ما يفعله الأصدقاء؟

392
00:19:11,030 --> 00:19:12,010
!حسناً

393
00:19:26,480 --> 00:19:30,740
ظننتُ بأنّه شعر بنا، لكن يبدو أنّنا بخير

394
00:19:31,120 --> 00:19:35,640
إذاً ذلك المكان موجود في الخلف هنا؟

395
00:19:35,640 --> 00:19:37,560
حسناً، هذا لا يهمّني

396
00:19:37,560 --> 00:19:39,650
لن أتدخّل

397
00:19:39,650 --> 00:19:42,150
عليك بأداء دورك دون خطأ فحسب

398
00:19:44,580 --> 00:19:47,150
لِمَ لا تقولين شيئاً؟

399
00:19:47,150 --> 00:19:50,850
تطرفين بعينيكِ هكذا! أنتِ
!تُركّزين كثيراً على المظهر

400
00:19:50,850 --> 00:19:52,150
!بئساً

401
00:19:54,210 --> 00:19:57,160
