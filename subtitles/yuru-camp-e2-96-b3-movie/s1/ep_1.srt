1182
01:32:15,240 --> 01:32:20,070
لكن سينباي في العمل ترتّب عليه
سدّ مكاني في هذه الأثناء

1183
01:32:20,070 --> 01:32:22,420
واجه وقتاً عصيباً بسببي

1184
01:32:22,420 --> 01:32:23,910
هل أوقعكِ ذلك في مشكلة؟

1185
01:32:23,910 --> 01:32:25,130
لا

1186
01:32:25,130 --> 01:32:27,640
كان يدعمني طوال الوقت

1187
01:32:28,680 --> 01:32:33,150
كنتُ أعتقد أنّ بمقدوري فعل
أيّ شيء حالما أكبر أيضاً

1188
01:32:33,770 --> 01:32:40,020
لكن في الواقع، ازدادت مسؤوليّاتي والأشياء
التي يجب عليّ فعلها

1189
01:32:40,680 --> 01:32:45,890
حتّى كبالغة، ما زال يدعمني المُحيطون بي

1190
01:32:46,400 --> 01:32:49,970
أدركتُ بأنّني لستُ بمُفردي حقّاً

1191
01:32:50,680 --> 01:32:51,810
هكذا إذاً

1192
01:32:52,630 --> 01:32:53,920
معكِ حقّ

1193
01:33:05,590 --> 01:33:06,880
لكن أتعلمين؟

1194
01:33:06,880 --> 01:33:12,870
هناك بعض الأشياء الّتي لا يمكننا فعلها
إلّا الآن بعد أن كبرنا أيضاً

1195
01:33:14,620 --> 01:33:15,690
مثل ماذا؟

1196
01:33:17,030 --> 01:33:17,940
...مثل

1197
01:33:18,990 --> 01:33:24,660
نتمكّن من مشاركة الأشياء التي
نستمتع بها مع الآخرين

1198
01:33:26,140 --> 01:33:31,000
ثمّ يشاركها أولئك النّاس بالمقابل

1199
01:33:33,870 --> 01:33:38,430
ويمكننا صنع أماكن حيث يمكن لتلك
الأشياء أن تحدث طوال الوقت

1200
01:33:42,600 --> 01:33:47,220
أليس هذا ما كنّا نحاول فعله؟

1201
01:33:49,270 --> 01:33:51,500
أنتِ مُذهلة يا ناديشيكو

1202
01:33:53,170 --> 01:33:56,190
سيكون من المذهل أن نتمكّن فعل ذلك

1203
01:33:56,700 --> 01:33:57,230
يمكننا ذلك

1204
01:33:58,440 --> 01:34:04,360
كنتِ أوّل شخص علّمني كم أنّ
التّخييم ممتع يا رين-تشان

1205
01:34:07,520 --> 01:34:08,740
حقّاً؟

1206
01:34:08,740 --> 01:34:10,280
!نسيتِ؟

1207
01:34:10,280 --> 01:34:11,480
أتذكّر

1208
01:34:15,720 --> 01:34:17,840
ربّما لا تزال هناك طريقة لفعلها

1209
01:34:19,560 --> 01:34:20,750
لنفكّر في الأمر

1210
01:34:22,320 --> 01:34:25,260
هل نبدأ بتحرّكاتنا إذاً؟

1211
01:34:25,500 --> 01:34:26,280
أجل

1212
01:34:58,380 --> 01:35:00,670
مرحباً

1213
01:35:06,540 --> 01:35:08,440
لا أحد هنا

1214
01:35:08,440 --> 01:35:10,400
ربّما أتينا باكراً

1215
01:35:15,490 --> 01:35:16,840
كوز صنوبر

1216
01:35:17,380 --> 01:35:18,810
!مرحباً

1217
01:35:25,170 --> 01:35:26,560
آكي

1218
01:35:28,340 --> 01:35:29,810
ماذا تفعلين؟

1219
01:35:29,810 --> 01:35:32,080
!لدينا دُخلاء

1220
01:35:35,090 --> 01:35:37,580
إنّهما ناديشيكو-تشان ورين-تشان

1221
01:35:37,940 --> 01:35:39,740
هذا أنتما فحسب

1222
01:35:39,740 --> 01:35:41,700
لا تفاجئاني هكذا

1223
01:35:41,700 --> 01:35:43,310
لم نكن نفاجئكِ

1224
01:35:47,000 --> 01:35:50,340
...كنتُ أنتظركم جميعاً

1225
01:35:59,000 --> 01:36:01,060
!لم أرَكُن منذ مدّة جميعاً

1226
01:36:03,470 --> 01:36:05,980
آسفة، بالغتُ كثيراً

1227
01:36:09,290 --> 01:36:11,110
...حسناً، على أيّ حال

1228
01:36:11,470 --> 01:36:13,280
ها نحن ذا من جديد

1229
01:36:13,280 --> 01:36:14,230
عُلِم

1230
01:36:14,820 --> 01:36:16,030
اسمعن جميعاً

1231
01:36:19,930 --> 01:36:22,630
،لذا للتغلّب على هذه الأزمة

1232
01:36:22,990 --> 01:36:26,520
توصّلتُ أنا وإينوكو إلى طريقة للتقرُّب
من بلديّة المُحافظة

1233
01:36:26,520 --> 01:36:29,630
وفريق التّنقيب معاً

1234
01:36:34,850 --> 01:36:36,590
نعيد رسمها؟

1235
01:36:41,180 --> 01:36:43,810
لكن ليس علينا مُحاربتهم

1236
01:36:48,090 --> 01:36:49,140
...بالتّحديد

1237
01:36:54,630 --> 01:36:55,920
أوغاكي

1238
01:36:56,480 --> 01:36:57,660
أنتِ جادّة، أليس كذلك؟

1239
01:36:59,150 --> 01:37:01,160
أجل، أنا جادّة

1240
01:37:03,110 --> 01:37:05,420
الخطوة التّالية، التّنقيب

1241
01:37:05,600 --> 01:37:10,170
تنقصهم الأيدي العاملة ومتأخّرون
عن الجدول الزمني الآن

1242
01:37:10,530 --> 01:37:14,170
لا يمكننا الانتقال إلى الخطوة التّالية
،ما لم ينتهوا على أيّ حال

1243
01:37:14,170 --> 01:37:17,750
لذا سنساعدهم في التّنقيب

1244
01:37:20,150 --> 01:37:22,190
سوف نتناوب على مساعدتكم ابتداء من اليوم

1245
01:37:22,540 --> 01:37:24,420
!نتطلّع قُدماً لذلك

1246
01:37:24,420 --> 01:37:26,440
أنتنّ مُنقِذات

1247
01:37:26,780 --> 01:37:30,440
وأيضاً يمكنني إعداد الغداء وما شابه أيضاً

1248
01:37:30,640 --> 01:37:31,740
ماذا؟

1249
01:38:24,420 --> 01:38:25,750
شكراً على الطبخ

1250
01:38:26,070 --> 01:38:28,030
كان ذلك شهيّاً

1251
01:38:28,030 --> 01:38:29,830
شكراً لك

1252
01:38:29,830 --> 01:38:31,260
...ا-المعذرة

1253
01:38:32,260 --> 01:38:35,490
إن لم يكن لديك مانع، هلّا أخبرتني رجاء بالمزيد

1254
01:38:35,490 --> 01:38:37,390
عن الفخّاريات وفترة جومون؟

1255
01:38:39,410 --> 01:38:42,890
شاتشيهوكو
للنشر

1256
01:38:40,890 --> 01:38:42,890
تريدين استئناف السّلسلة؟

1257
01:38:43,170 --> 01:38:43,960
أجل

1258
01:38:49,400 --> 01:38:52,710
سأستمرّ في واجباتي المعتادة أيضاً بالطبع

1259
01:38:55,730 --> 01:38:56,530
حسناً

1260
01:38:58,020 --> 01:38:59,280
فقط؟

1261
01:38:59,920 --> 01:39:02,510
دعيه يدلّلكِ ما دامت الفُرصة سانحة

1262
01:39:03,590 --> 01:39:07,790
كان رئيس التّحرير يدعمني عندما
كنتُ أصغر سنّاً أيضاً

1263
01:39:08,550 --> 01:39:10,920
كنتَ أكثر إزعاجاً في الواقع

1264
01:39:10,920 --> 01:39:13,070
على رسلِك

1265
01:39:14,680 --> 01:39:16,310
!شكراً لك

1266
01:39:18,050 --> 01:39:20,550
سريع كالرّياح
رقيق كالغابة
شديد كالنّار
راسخ كالجبل

1267
01:39:28,130 --> 01:39:32,350
هناك مُقترح لمركز ثقافي لعرض التّحف الأثريّة

1268
01:39:32,570 --> 01:39:37,230
المعذرة، لدينا أيضاً مقترح من منظّمة السّياحة

1269
01:39:37,230 --> 01:39:37,820
أجل

1270
01:39:38,560 --> 01:39:41,010
ألقوا نظرة إلى هذا من فضلكم

1271
01:40:01,090 --> 01:40:03,920
حول المُنشأت القائمة الحاليّة

1272
01:40:05,370 --> 01:40:08,540
"فكرة المشروع هي "التّجديد

1273
01:40:09,260 --> 01:40:11,350
كان مخطّطنا هو استخدام

1274
01:40:11,350 --> 01:40:16,860
ما كان مُتاحاً هناك لخلق مساحة للناس
كي يستمتعوا على طريقتهم الخاصّة

1275
01:40:17,880 --> 01:40:22,620
،إنّ اكتشاف فخّار جومون علّقَ المشروع

1276
01:40:22,780 --> 01:40:27,830
لكن رغم ذلك، تمكّنا من التوصُّل
لاكتشافات جديدة بحدّ أنفسنا

1277
01:40:28,460 --> 01:40:30,870
تُدعى هذه حُفر الإصلاح

1278
01:40:31,140 --> 01:40:36,400
يُعتقَد بأنّها صُنِعَتْ لإصلاح الصّدوع
بربطها معاً من خلال خيط

1279
01:40:36,960 --> 01:40:42,460
كان شعب جومون يمتلك ثقافة إصلاح
والاهتمام بأشيائهم

1280
01:40:42,460 --> 01:40:43,890
مُذهل

1281
01:40:46,600 --> 01:40:52,560
إنّ التّخييم يمنحنا مساحة لمواجهة
أنفسنا، بعيداً عن أنفسنا المعتادة

1282
01:40:59,020 --> 01:41:04,770
فُرصة للمّ الشّمل مع الأصدقاء
القدامى والنّظر إلى داخل أنفسنا

1283
01:41:05,790 --> 01:41:09,180
سواء من خلال المُنشأت القائمة أو
،الفخّاريّات من الزمن القديم

1284
01:41:09,780 --> 01:41:13,880
مُنِحنا فُرص للنظر إلى الأمور من منظور جديد

1285
01:41:13,880 --> 01:41:14,830
...لهذا السّبب

1286
01:41:20,720 --> 01:41:22,220
فخّاريّات

1287
01:41:20,720 --> 01:41:22,220
تخييم

1288
01:41:26,550 --> 01:41:29,430
مساحات لعرض التّحف

1289
01:41:29,430 --> 01:41:32,690
تجارب الفخّاريات وإيقاد النّار

1290
01:41:32,690 --> 01:41:36,190
مساحات لنار التّخييم وصنع الفخّار

1291
01:41:44,010 --> 01:41:47,200
هذا هو مُقترحنا الجديد

1292
01:41:47,650 --> 01:41:50,700
من فضلكم ضعوه بعين الاعتبار

1293
01:42:02,260 --> 01:42:03,410
عُلِم

1294
01:42:04,790 --> 01:42:09,730
أمهلينا وقتاً لدراسته مع المُقترحات الأخرى

1295
01:42:10,500 --> 01:42:11,470
حسناً

1296
01:42:17,840 --> 01:42:19,820
هل ننطلق؟

1297
01:42:19,820 --> 01:42:21,100
أجل

1298
01:42:28,990 --> 01:42:31,490
منظّمة ياماناشي للسياحة

1299
01:42:28,990 --> 01:42:31,490
رابطة المصالح العامّة

1300
01:42:30,140 --> 01:42:33,700
...أوغاكي، نموذج التّسليم هذا

1301
01:42:33,700 --> 01:42:34,370
ماذا؟

1302
01:43:01,400 --> 01:43:05,400
فعلناها

1303
01:43:01,400 --> 01:43:05,400
تمّت المُوافقة

1304
01:43:12,630 --> 01:43:16,660
...نما كثيراً خلال الفترة القصيرة الّتي غبنا فيها

1305
01:43:16,960 --> 01:43:19,920
العشب هنا لديه بعض العزم

1306
01:43:20,110 --> 01:43:22,670
لدينا عزم أيضاً

1307
01:43:23,100 --> 01:43:28,550
سيكون الصّيف قاسياً، لكن نسعى لافتتاح خريفيّ

1308
01:43:28,820 --> 01:43:29,620
أجل

1309
01:43:32,380 --> 01:43:33,200
ماذا؟

1310
01:43:33,200 --> 01:43:34,740
ما-ماذا؟

1311
01:43:35,660 --> 01:43:37,960
أنتِ مُتشوِّقة جدّاً يا رين-تشان

1312
01:43:37,960 --> 01:43:39,540
...ليس تماماً

1313
01:43:39,540 --> 01:43:42,170
والآن كلمة من مديرتنا القياديّة

1314
01:43:42,170 --> 01:43:43,570
ماذا؟

1315
01:43:48,340 --> 01:43:49,570
لنفعلها

1316
01:43:49,900 --> 01:43:51,760
!أجل

1317
01:43:57,110 --> 01:44:00,580
لنعمل على تنظيف المستوي الأعلى أوّلاً

1318
01:44:00,580 --> 01:44:01,470
حسناً

1319
01:44:01,470 --> 01:44:02,610
أتّفق

1320
01:44:05,090 --> 01:44:08,340
مساحة التّجارب

1321
01:44:05,090 --> 01:44:08,340
مساحة صناعة الفخّار

1322
01:44:05,090 --> 01:44:08,340
مساحة عرض التّحف

1323
01:44:05,510 --> 01:44:08,340
نريد تخصيص مساحة للخيام هنا

1324
01:44:08,810 --> 01:44:11,630
هل يمكننا بناؤها قريبة من الحافّة قدر الإمكان؟

1325
01:44:16,660 --> 01:44:17,600
جاهزة

1326
01:44:17,600 --> 01:44:18,850
حسناً

1327
01:44:19,010 --> 01:44:20,600
...واحد، اثنان

1328
01:44:24,610 --> 01:44:25,790
بئساً

1329
01:44:28,670 --> 01:44:30,860
عليكِ أن تشدّي عزمكِ أكثر

1330
01:44:30,860 --> 01:44:33,120
رجل
الجبل

1331
01:44:31,050 --> 01:44:32,430
!أوكازاكي-سان

1332
01:44:45,350 --> 01:44:46,880
وهكذا يتمّ الأمر

1333
01:44:48,810 --> 01:44:51,910
!رين-تشان! ناديشيكو-تشان

1334
01:44:52,690 --> 01:44:54,140
هلّي بدقيقة؟

1335
01:45:01,630 --> 01:45:05,530
سُمِحَ لنا بأخذ ما هو هنا

1336
01:45:06,790 --> 01:45:09,780
ارتأيتُ أنّ بوسعنا ربّما استخدامها لمنطقة الأطفال

1337
01:45:29,220 --> 01:45:30,310
ما رأيكِ؟

1338
01:45:32,460 --> 01:45:33,850
أجل، ممتازاة

1339
01:45:43,840 --> 01:45:45,640
!تبلّلتُ تماماً

1340
01:46:14,460 --> 01:46:15,990
هذا لذيذ، أليس كذلك؟

1341
01:46:25,410 --> 01:46:27,860
استعرتُ هذا من أكاري

1342
01:46:33,300 --> 01:46:35,610
هل دعيتُنّ عائلاتكن؟

1343
01:46:35,610 --> 01:46:36,650
أجل

1344
01:46:36,650 --> 01:46:39,620
كانوا أكثر حماساً ممّا توقّعت

1345
01:46:39,960 --> 01:46:43,240
دعيتُ زملائي في العمل

1346
01:46:43,240 --> 01:46:44,870
ستكون أكاري-تشان هنا، صحيح؟

1347
01:46:45,090 --> 01:46:46,770
بالطبع

1348
01:46:46,770 --> 01:46:49,270
ستأتي رفقة توبا-سينسي

1349
01:46:50,170 --> 01:46:51,790
ها نحن ذا

1350
01:46:54,850 --> 01:46:56,200
هكذا؟

1351
01:46:56,200 --> 01:46:57,030
أجل

1352
01:46:57,030 --> 01:46:58,500
حسناً

1353
01:47:34,310 --> 01:47:35,670
...واحد، اثنان

1354
01:47:36,150 --> 01:47:38,470
!انتهيت

1355
01:47:46,320 --> 01:47:47,410
...لنرَ

1356
01:47:47,410 --> 01:47:50,190
...مرق، ملح، ثوم

1357
01:47:50,490 --> 01:47:52,510
أظنّنا سنحتاج زيت زيتون أيضاً

1358
01:47:52,510 --> 01:47:54,080
صحيح

1359
01:47:54,830 --> 01:47:57,450
لم أذهب للتخييم منذ مدّة طويلة

1360
01:47:57,960 --> 01:47:59,630
حسناً، سأراكما هناك

1361
01:47:59,630 --> 01:48:01,620
أجل. رافقتكِ السّلامة

1362
01:48:12,900 --> 01:48:14,920
...ضوء التحقّق من المُحرّك

1363
01:48:15,440 --> 01:48:18,390
ينبغي أن نأخذها إلى الصّيانة من باب الحيطة فقط

1364
01:48:18,860 --> 01:48:21,220
كيف ينبغي أن أصل إلى تاكاوري؟

1365
01:48:21,800 --> 01:48:24,190
يمكنكِ أن تستقلّي الأخرى

1366
01:48:36,820 --> 01:48:40,490
ينبغي أن في هذا بالغرض بالنسبة
لقائمة الضّيوف وأدوات الكتابة

1367
01:48:40,730 --> 01:48:43,170
ولدينا صندوق المال أيضاً

1368
01:48:43,170 --> 01:48:45,170
تمّ تنظيف الحمّام

1369
01:48:45,170 --> 01:48:46,740
شكراً

1370
01:48:46,740 --> 01:48:51,250
قائمة حجوزات قاعدة تخييم فوجيكاوا ماتسوبوكّوري

1371
01:48:46,740 --> 01:48:51,250
لا حيوانات أليفة                         مع حيوانات أليفة                    قضاء اللّيل                      تخييم نهاري

1372
01:48:46,740 --> 01:48:51,250
الإثنين              الثّلاثاء                الأربعاء               الخميس                الجمعة                   السّبت                   الأحد

1373
01:48:46,980 --> 01:48:51,250
لدينا عشر مجموعات من المُخيّمين اليوم
واثنان من المُخيّمين الفرديّين

1374
01:48:51,500 --> 01:48:52,840
لدينا الكثير

1375
01:48:52,840 --> 01:48:55,920
رغم أنّ نصفهم أشخاص نعرفهم

1376
01:48:55,920 --> 01:48:58,510
إنّها بداية جيّدة كيوم افتتاح

1377
01:49:01,030 --> 01:49:02,380
ها نحن ذا

1378
01:49:02,380 --> 01:49:03,140
أجل

1379
01:49:13,120 --> 01:49:13,770
ماذا؟

1380
01:49:18,200 --> 01:49:19,790
لا أحد هنا

1381
01:49:21,380 --> 01:49:24,080
لم نتلقَّ أيّ اتّصال بالإلغاء

1382
01:49:24,080 --> 01:49:28,370
حسناً، لا أعتقد أنّ النّاس سيأتون
في لحظة الافتتاح فوراً

1383
01:49:28,370 --> 01:49:29,730
بالطبع

1384
01:49:32,370 --> 01:49:35,300
هنا قاعدة تخييم فوجيكاوا ماتسوبوكّوري

1385
01:49:37,530 --> 01:49:39,050
لا تعرفون كيفيّة الوصول إلى هنا؟

1386
01:49:40,250 --> 01:49:41,300
علامات؟

1387
01:49:41,810 --> 01:49:44,850
سألقي نظرة وأعاود الاتّصال بك

1388
01:49:46,820 --> 01:49:49,560
وضعنا كثيراً من لافتات الاتّجاهات، صحيح؟

1389
01:49:49,860 --> 01:49:51,650
صنعناها معاً

1390
01:49:52,660 --> 01:49:55,790
تقصدنَ هذه؟

1391
01:49:54,310 --> 01:49:56,060
قاعدة تخييم ماتسوبوكّوري

1392
01:49:57,550 --> 01:49:59,820
!ما الفائدة إن لم نعلّقها؟

1393
01:49:59,980 --> 01:50:04,030
أعتقد أنّ كلّ الضّيوف قد تاهوا

1394
01:50:05,820 --> 01:50:08,330
أكاري

1395
01:50:08,470 --> 01:50:11,040
أكاري، أين أنتِ الآن؟

1396
01:50:11,040 --> 01:50:12,260
...بخصوص ذلك

1397
01:50:12,260 --> 01:50:14,080
لا أملك أدنى فكرة

1398
01:50:14,530 --> 01:50:16,830
تهنا تماماً

1399
01:50:16,830 --> 01:50:18,380
سأذهب لإحضارهم

1400
01:50:19,260 --> 01:50:23,560
ناديشيكو وسايتو، هل يمكنكما أن تُرشداني
إلى حيث تاه النّاس؟

1401
01:50:23,560 --> 01:50:24,080
حسناً

1402
01:50:24,080 --> 01:50:24,840
عُلِم

1403
01:50:26,260 --> 01:50:29,220
ينبغي أن تُسهِّل خريطة النّشرة عمليّة الشّرح كثيراً

1404
01:50:29,570 --> 01:50:32,170
قالوا بأنّهم يرون ما يُشبه مزاراً

1405
01:50:32,170 --> 01:50:34,550
هذا هو المزار الوحيد في المنطقة هنا

1406
01:50:34,550 --> 01:50:35,970
سيّارة فان بيضاء

1407
01:50:35,970 --> 01:50:37,980
مع صحون يوكوهاما، ينبغي أن يكون سهل الرّصد

1408
01:50:37,980 --> 01:50:39,730
!نعتمد عليكِ يا رين-تشان

1409
01:50:40,030 --> 01:50:41,030
دعنَ الأمر لي

1410
01:50:47,300 --> 01:50:48,150
هيّا بنا

1411
01:50:48,150 --> 01:50:49,490
!أنا جاهز

1412
01:51:50,320 --> 01:51:51,570
ياماناشي

1413
01:51:53,330 --> 01:51:54,160
جبل فوجي

1414
01:52:02,090 --> 01:52:06,970
شيزوكا

1415
01:52:10,590 --> 01:52:12,350
موتوسو

1416
01:52:25,440 --> 01:52:27,140
هذا نابض بالحياة

1417
01:52:38,780 --> 01:52:41,170
إنّه بحجم خيمة كبيرة

1418
01:53:04,920 --> 01:53:07,880
هل دعيتِ التّلاميذ من مدرستك الجديد؟

1419
01:53:08,110 --> 01:53:09,170
أجل

1420
01:53:09,170 --> 01:53:12,130
جميعنا ننسجم بشكل ممتاز

1421
01:53:14,790 --> 01:53:16,390
!ناديشيكو

1422
01:53:16,800 --> 01:53:18,370
!ساعديني

1423
01:53:18,370 --> 01:53:20,640
!حسناً! قادمة

1424
01:53:22,950 --> 01:53:25,540
مُذهل، أنتِ محترفة حقّاً

1425
01:53:26,570 --> 01:53:27,590
أجل

1426
01:53:28,540 --> 01:53:31,280
!رين-تشان

1427
01:53:39,350 --> 01:53:40,260
رين

1428
01:53:44,760 --> 01:53:46,020
جدّي

1429
01:53:47,410 --> 01:53:49,930
أهلاً. شكراً على المجيء

1430
01:53:50,410 --> 01:53:51,420
أجل

1431
01:53:52,650 --> 01:53:54,230
أنجزتُن العمل

1432
01:54:08,460 --> 01:54:09,470
شكراً

1433
01:55:14,220 --> 01:55:16,230
الجميع مستمتعون

1434
01:55:16,230 --> 01:55:17,050
أجل

1435
01:55:17,970 --> 01:55:20,750
هذا يُسعدني حقّاً

1436
01:55:20,750 --> 01:55:21,760
أجل

1437
01:55:22,890 --> 01:55:24,770
يسرّني أنّنا فعلناها

1438
01:55:36,400 --> 01:55:40,080
لمَ لا نُقيم رحلة تخييم عام جديد أخرى هنا؟

1439
01:55:40,080 --> 01:55:41,670
فكرة سديدة

1440
01:55:41,670 --> 01:55:45,570
لنطمح لمشاهدة إشراقة شمس العام
الجديد خلف جبل الماسة إذاً

1441
01:55:45,570 --> 01:55:46,930
ماذا يجدر بنا أن نأكل؟

1442
01:55:46,930 --> 01:55:49,670
سيكون العام الجديد، لذا لمَ لا
نأكل السّوبا معاً؟

1443
01:55:50,150 --> 01:55:51,920
وهذا يشملكِ يا رين-تشان، صحيح؟

1444
01:55:55,650 --> 01:55:56,920
...أعتقد

1445
01:56:02,710 --> 01:56:03,930
ربّما

1446
01:56:05,580 --> 01:56:07,040
سأفكّر في الأمر

1447
01:57:06,010 --> 01:57:10,810
سوبا
أودون

1448
01:57:31,370 --> 01:57:36,130
لمَ لا تجرّب التّخييم
مع كلبك؟

1449
01:57:51,560 --> 01:57:56,020
"إلى أي مسافة تستطيع الابتعاد على درّاجة ناريّة صغيرة؟"

1450
02:00:02,690 --> 02:00:06,650
النّهاية