789
01:00:28,640 --> 01:00:32,470
يبدو أنّهم يستأجرون هذه الخيام في متجر ناديشيكو-تشان

790
01:00:32,470 --> 01:00:35,110
لديهم خدمات تأجير أيضاً؟

791
01:00:37,500 --> 01:00:38,560
إنّها ضخمة

792
01:00:38,560 --> 01:00:41,240
والآن يمكننا جميعاً أن ننام في نفس الخيمة، صحيح؟

793
01:00:41,520 --> 01:00:43,600
الإطار جاهز

794
01:00:43,600 --> 01:00:44,490
حسناً

795
01:00:54,680 --> 01:00:55,500
جيّد

796
01:00:56,200 --> 01:00:58,240
!اكتملت الخيمة

797
01:00:58,500 --> 01:01:00,640
تدبّرنا أمرنا بطريقة ما

798
01:01:01,470 --> 01:01:05,010
لنُعدّ التّجهيزات الأخرى بسرعة أيضاً

799
01:01:10,020 --> 01:01:12,020
تونا برّية

800
01:01:12,020 --> 01:01:15,400
سمك طازج

801
01:01:12,020 --> 01:01:15,400
!تنزيلات خاصّة اليوم فقط

802
01:01:17,970 --> 01:01:20,650
أتريدين فعلها اليوم يا أوي-تشان؟

803
01:01:20,650 --> 01:01:21,750
حسناً

804
01:01:21,750 --> 01:01:24,210
سيكون هذا مثاليّاً بالنسبة لنا

805
01:01:30,290 --> 01:01:32,770
رين، هل هنا مناسب؟

806
01:01:32,770 --> 01:01:33,730
أجل

807
01:01:45,910 --> 01:01:47,460
جرو سعيد

808
01:01:48,050 --> 01:01:49,510
!عدنا

809
01:01:49,510 --> 01:01:51,430
!انتهينا من التسوّق

810
01:01:51,430 --> 01:01:53,170
!أهلاً بعودتكما

811
01:01:53,170 --> 01:01:55,910
!أبليتُن حسناً جميعاً

812
01:01:57,440 --> 01:01:59,880
ينبغي أن تفي هذه المؤونات بالغرض

813
01:01:59,880 --> 01:02:01,060
أجل

814
01:02:01,060 --> 01:02:04,190
نسيتُ إحضار الإناء

815
01:02:04,390 --> 01:02:07,000
آكي-تشان، سأنقل كلّ أغراضنا

816
01:02:07,000 --> 01:02:07,720
حسناً

817
01:02:09,600 --> 01:02:11,470
!إنّه فرن حطب

818
01:02:13,470 --> 01:02:16,900
استأجرناه من المتجر أيضاً

819
01:02:16,900 --> 01:02:18,460
إنّه جميل

820
01:02:23,960 --> 01:02:26,720
منطقة الأطفال
قيد الإنشاء

821
01:02:27,670 --> 01:02:29,420
...مجموعة الأراجيح تلك

822
01:02:30,320 --> 01:02:32,970
سيكون من الصّعب إحضارها إلى هنا غالباً، صحيح؟

823
01:02:44,660 --> 01:02:46,170
تبدو هذه صالحة

824
01:02:46,170 --> 01:02:47,740
!مرحباً

825
01:02:51,300 --> 01:02:52,490
!حارّ جدّاً

826
01:02:51,360 --> 01:02:52,490
!هذا حارّ جدّاً

827
01:03:13,470 --> 01:03:17,080
...اللّيلة سوف نطبخ

828
01:03:15,020 --> 01:03:19,020
!سعر خاص

829
01:03:17,080 --> 01:03:18,770
!سلمون

830
01:03:19,190 --> 01:03:21,800
أليس هذا باهظ الثّمن؟

831
01:03:21,800 --> 01:03:24,530
كان عليه حسم كبير

832
01:03:25,290 --> 01:03:28,280
!سنقيم حفلة سلمون اللّيلة

833
01:03:29,250 --> 01:03:32,030
:كيفيّة تحضير حساء السّلمون

834
01:03:32,500 --> 01:03:34,900
أوّلاً، نغلي بعض الماء

835
01:03:34,900 --> 01:03:36,460
،نضيف حبّ الفلفل

836
01:03:36,460 --> 01:03:37,740
،وورق الغار

837
01:03:38,220 --> 01:03:41,500
وبعض البصل المُقطّع والجزر

838
01:03:42,020 --> 01:03:46,040
ونتركه يغلي لبعض الوقت ثمّ نضيف البطاطا

839
01:03:46,040 --> 01:03:49,050
نغطّيه حتّى يُطهَى لمدّة من الوقت

840
01:03:49,410 --> 01:03:52,520
أنا متحمّسة لرؤية كيف سيبدو مظهره

841
01:03:57,570 --> 01:04:00,750
!السّلمون المشويّ هو الأفضل مع السّاكي الياباني

842
01:04:07,790 --> 01:04:09,220
من الآن؟

843
01:04:09,220 --> 01:04:11,860
إنّها الآنسة مُدمنة الشّرب الجديدة حرفيّاً

844
01:04:14,720 --> 01:04:19,890
حالما تُطهى الخضراوات، يحين وقت إضافة السّلمون

845
01:04:20,490 --> 01:04:23,960
ثمّ بعض الكريمة والملح

846
01:04:24,380 --> 01:04:26,460
...وأخيراً، نرشّ بعضاً من الشّبث

847
01:04:27,160 --> 01:04:30,040
ليتكوّن لدينا حساء السّلمون

848
01:04:31,940 --> 01:04:33,970
!لنأكل

849
01:04:41,320 --> 01:04:42,850
!إنّه لذيذ

850
01:04:43,930 --> 01:04:45,610
يمنح دفئاً فوريّاً

851
01:04:45,610 --> 01:04:49,150
إنّه بسيط وغنيّ ولذيذ في نفس الوقت

852
01:04:49,750 --> 01:04:50,990
يسرُّني ذلك

853
01:04:51,180 --> 01:04:56,990
أومامي السّلمون والخضراوات تذوب
في حساء الكريمة الرّقيق

854
01:05:00,370 --> 01:05:02,500
!لذيذ

855
01:05:03,210 --> 01:05:05,950
أعددتُ بعضاً لتشيكووا أيضاً

856
01:05:05,950 --> 01:05:08,000
شكراً يا ناديشيكو-تشان

857
01:05:08,200 --> 01:05:10,950
أشتمّ رائحة زكيّة

858
01:05:10,950 --> 01:05:12,380
إنّه الشّبث

859
01:05:12,670 --> 01:05:14,380
نوع من الأعشاب

860
01:05:15,830 --> 01:05:18,810
لديه رائحة عذبة تتماشى جيّداً مع السّلمون

861
01:05:18,810 --> 01:05:20,130
أجل

862
01:05:20,130 --> 01:05:23,210
يأخذكِ المذاق إلى وسط غابة في فنلندا

863
01:05:23,210 --> 01:05:24,460
أيّ مذاق هذا؟

864
01:05:28,850 --> 01:05:31,150
ماذا؟ اختفى تماماً؟

865
01:05:31,620 --> 01:05:34,040
لا يبقى شيء عندما نكون نحن الخمسة

866
01:05:34,940 --> 01:05:37,840
لم ينتهِ العرض بعد يا آكي-تشانا

867
01:05:39,890 --> 01:05:42,630
أعتقد أنّ الآخر شبه جاهز الآن

868
01:05:45,430 --> 01:05:47,130
!إناء آخر؟

869
01:05:47,130 --> 01:05:48,420
متى حدث ذلك؟

870
01:05:50,340 --> 01:05:52,970
!حفلة السّلمون قد بدأت للتو

871
01:05:53,280 --> 01:05:55,540
!إناء إيشيكاري ساخن مع يوبا

872
01:06:03,070 --> 01:06:04,430
!لذيذ

873
01:06:07,350 --> 01:06:09,940
الميسو في هذا مُهدّئ حقّاً

874
01:06:10,110 --> 01:06:13,690
لم أتوقّع أبداً أن يتماشى اليوبا
جيّداً مع إناء إيشيكاري السّاخن

875
01:06:14,120 --> 01:06:16,760
حصلتُ على بعض اليوبا الفاخر من مينوبو

876
01:06:16,760 --> 01:06:20,040
وأضفتُ حليباً وزبدة لتثبيت النّكهة

877
01:06:20,040 --> 01:06:22,080
لهذا الكريمة دسمة

878
01:06:22,080 --> 01:06:28,960
خاصّ بكوشو
هوتو

879
01:06:22,400 --> 01:06:24,810
سنختتمها بـ هوتو

880
01:06:24,810 --> 01:06:25,780
!مرحى

881
01:06:25,780 --> 01:06:28,710
أنتِ ماهرة جدّاً في الارتجال يا أوي-تشان

882
01:06:37,100 --> 01:06:39,100
مع أنّه لم يكتمل بعد

883
01:06:39,760 --> 01:06:44,830
لكن هذا فاخر حقّاً، أليس كذلك؟

884
01:06:45,660 --> 01:06:46,590
أاجل

885
01:06:48,150 --> 01:06:51,850
لا أقول أنّنا لم نعمل بجدّ، لكن أعتقد
بأنّنا لطالما امتلكنا المؤهّلات

886
01:06:51,850 --> 01:06:53,230
بالفعل

887
01:07:09,000 --> 01:07:10,960
بلاك يا إينا-تشان؟

888
01:07:10,960 --> 01:07:12,750
أجل. شكراً

889
01:07:13,180 --> 01:07:16,380
ينبغي أن نبدأ بالتفكير في دليل التشغيل أيضاً

890
01:07:16,650 --> 01:07:18,710
لقد فكّرتُ في الأمر

891
01:07:18,710 --> 01:07:20,390
أحسنتِ صنعاً يا ناديشيكو-تشان

892
01:07:20,390 --> 01:07:26,080
وأايضاً لاحظتُ أنّ الحمّام بعيد جدّاً من هنا

893
01:07:26,080 --> 01:07:27,520
أجل، معكِ حقّ

894
01:07:27,730 --> 01:07:29,430
الطريق وعر كذلك

895
01:07:29,430 --> 01:07:31,400
كدتُ أتعثّر قبل مدّة قصيرة

896
01:07:31,680 --> 01:07:35,490
ومن الصّعب حمل الأغراض صعوداً ونزولاً عبر الدّرج

897
01:07:35,490 --> 01:07:39,610
ربّما ينبغي أن نُعير عربات وندع
النّاس يستخدمون منحدرات

898
01:07:39,610 --> 01:07:41,780
ما زالت هناك عوائق كثيرة، صحيح؟

899
01:07:48,670 --> 01:07:49,840
...المعذرة

900
01:07:49,840 --> 01:07:51,190
أتُرِدنَ الذّهاب إلى هناك؟

901
01:08:04,570 --> 01:08:06,150
توقّعت

902
01:08:07,260 --> 01:08:09,260
إنّه أشبه بقبّة سماء

903
01:08:10,010 --> 01:08:12,230
ولا في الأحلام

904
01:08:12,230 --> 01:08:14,060
بالفعل

905
01:08:14,580 --> 01:08:18,790
رغم كلّ المُشكلات، أعتقد هنالك دوماً
طريقة لجعل الأمور ممتعة

906
01:08:24,050 --> 01:08:25,450
إنّها مُستمتعة زيادة عن اللّزوم

907
01:08:29,450 --> 01:08:30,730
!تشيكووا

908
01:08:32,460 --> 01:08:34,230
هل عثرت على شيء؟

909
01:08:38,760 --> 01:08:40,540
ما هذا؟

910
01:08:40,540 --> 01:08:42,930
جزء من أصيص زهور؟

911
01:08:42,930 --> 01:08:45,710
تخيّلنَ لو تبيّن بأنّه ثمين

912
01:08:45,710 --> 01:08:48,100
لعلّك توصّلت لاكتشاف مهمّ يا تشيكووا

913
01:09:50,600 --> 01:09:53,220
حان وقت العمل على حديقة الكلاب

914
01:09:53,220 --> 01:09:55,920
تجاوزنا جدول الأعمال بكثير

915
01:09:56,570 --> 01:09:58,830
أوغاكي، هلّي بدقيقة؟

916
01:09:59,950 --> 01:10:01,060
حاضرة

917
01:10:01,670 --> 01:10:02,670
أوغاكي

918
01:10:07,700 --> 01:10:10,680
شاتشيهوكو
للنشر

919
01:10:10,680 --> 01:10:13,180
نيشيو

920
01:10:10,680 --> 01:10:13,180
هاندا

921
01:10:10,680 --> 01:10:13,180
شيما

922
01:10:10,680 --> 01:10:13,180
ياماناشي

923
01:10:14,410 --> 01:10:15,700
سأغادر

924
01:10:15,700 --> 01:10:17,120
نراكِ قريباً

925
01:10:25,520 --> 01:10:26,680
ما الأمر؟

926
01:10:32,970 --> 01:10:34,200
فريق تحرٍّ؟

927
01:10:34,550 --> 01:10:39,040
تحسُّباً فقط، أخبرتُ مُديري عن تلك
القطعة التي وجدها تشيكووا

928
01:10:39,040 --> 01:10:41,460
يبدو أنّها قد تكون تحفة فخّار صلصال حقيقيّة

929
01:10:41,680 --> 01:10:42,830
فخّار صلصال؟

930
01:10:43,320 --> 01:10:46,900
تظهر فجأة في كلّ أنحاء ياماناشي

931
01:10:46,900 --> 01:10:48,300
حقّاً؟

932
01:10:48,300 --> 01:10:52,840
حسناً، يبدو أنّ الفريق سيستغرق
أسبوعاً إلى أسبوعين

933
01:10:52,840 --> 01:10:56,190
إذاً يمكننا الاستئتناف بعد أن ينتهي، صحيح؟

934
01:10:56,190 --> 01:10:57,100
أجل

935
01:10:57,550 --> 01:10:59,730
حان وقت استراحة ريثما يحين ذلك

936
01:10:59,730 --> 01:11:00,760
أجل

937
01:11:00,760 --> 01:11:04,360
على أيّ حال، سأوافيكِ بكلّ جديد

938
01:11:04,960 --> 01:11:07,890
لذا تروّي لبعض الوقت

939
01:11:07,890 --> 01:11:10,100
حسناً. فهمت

940
01:11:10,620 --> 01:11:11,370
وداعاً

941
01:11:16,890 --> 01:11:17,920
ماذا؟

942
01:11:17,920 --> 01:11:19,740
ستفعل كلّ هذا بمفردك يا كاريا؟

943
01:11:19,740 --> 01:11:21,130
...أعني

944
01:11:21,450 --> 01:11:25,380
مضى وقت طويل منذ ألقيتُ التحيّة
على مُوظّفي الطباعة

945
01:11:25,620 --> 01:11:27,820
هل أنت متأكّد من أنّك لا تُجهِد نفسك في العمل؟

946
01:11:27,820 --> 01:11:29,630
لمَ لا تدع شيما-كن تتولّى بعضه؟

947
01:11:31,570 --> 01:11:36,520
أريد أن أمنحها مساحة للتركيز
على ما تريد فعله حاليّاً

948
01:11:37,790 --> 01:11:40,270
أعتقد إنّه وقتها لترتقي

949
01:11:41,840 --> 01:11:42,960
!كاريا-سان

950
01:11:43,690 --> 01:11:45,560
لحظة، هل كنتِ تتنصّتين؟

951
01:11:45,560 --> 01:11:48,040
أريد زيارة موظّفي الطباعة معك

952
01:11:48,040 --> 01:11:48,660
ماذا؟

953
01:11:49,140 --> 01:11:50,030
...لكن

954
01:11:50,470 --> 01:11:53,280
أُلغيتْ مخطّطات ياماناشي اليوم

955
01:11:54,200 --> 01:11:56,210
حسناً

956
01:11:57,540 --> 01:12:00,540
المشفى البيطري
صالون الحيوانات الأليفة

957
01:12:00,540 --> 01:12:02,110
مهلك، مهلك

958
01:12:02,110 --> 01:12:03,540
كلب وديع

959
01:12:03,850 --> 01:12:06,160
ستأتي عائلتك إلى هنا لأجلك قريباً

960
01:12:12,850 --> 01:12:14,800
أجل

961
01:12:15,280 --> 01:12:17,810
لن أمرّ بتاكاوري بعدا لآن

962
01:12:19,110 --> 01:12:20,720
لذا سأعود إلى الدّيار مباشرة

963
01:12:46,720 --> 01:12:49,220
!إلى اللّقاء يا أوي-تشان

964
01:12:49,730 --> 01:12:52,340
قولا أوي-سينسي

965
01:12:54,070 --> 01:12:56,100
!وداعاً يا أوي-تشان

966
01:13:21,370 --> 01:13:25,380
تجديد بناء الإدارة
والحرص على عمل الطاقة الكهربائيّة
والمواسير في غرفة الاستقبال
والمستودع والنُّزُل والحمّامات

967
01:13:21,370 --> 01:13:25,380
الحفاظ على المَطيَر والاستفادة منه

968
01:13:21,370 --> 01:13:25,380
لا يوجد مياه، نحتاج
للتحقّق ما إن كنّا بحاجة لإنجاز إنشاءات

969
01:13:21,370 --> 01:13:25,380
مبنى الإدارة

970
01:13:21,370 --> 01:13:25,380
مواقع التّخييم الفردي

971
01:13:21,370 --> 01:13:25,380
مواقع تخييم
العائلات

972
01:13:21,370 --> 01:13:25,380
ماء

973
01:13:28,380 --> 01:13:32,130
شارع
ناغاشيما-تشو

974
01:13:47,560 --> 01:13:48,740
مرحباً؟

975
01:13:49,650 --> 01:13:51,620
...المعذرة

976
01:13:53,490 --> 01:13:54,660
...اسمعي

977
01:13:55,370 --> 01:13:59,730
يبدو أنّ فخّار الصلصال يعود إلى فترة جومون

978
01:14:01,120 --> 01:14:06,170
سيستغرق فريق البحث بضعة أشهر
للتنقيب عن التّحف والآثار

979
01:14:07,200 --> 01:14:09,610
يمكننا أن نفتتح عقب ذلك إذاً

980
01:14:09,610 --> 01:14:11,300
...في الواقع

981
01:14:12,200 --> 01:14:14,800
نقّبوا عن تحف كثيرة لدرجة

982
01:14:14,800 --> 01:14:19,270
أنّه قُدِّم اقتراح بتحويل المكان إلى متحف

983
01:14:14,800 --> 01:14:19,550
مِتحف تاكاوري للآثار
(اسم مبدئي)

984
01:14:14,800 --> 01:14:19,550
مُقترَح

985
01:14:14,800 --> 01:14:19,550
تطوير

986
01:14:14,800 --> 01:14:19,550
عيّنة عن التّحف

