1
00:00:01,330 --> 00:00:04,650
العشائر الإلهيّة تحكم العالم

2
00:00:05,160 --> 00:00:08,570
البشر، الّذين يشتعلون بسهولة
،أمام النّار الطبيعيّة

3
00:00:08,570 --> 00:00:15,020
يُسمَح لهم بالعيش فقط من خلال نار
الوحوش، الّتي تُحصَد من وحوش اللّهب

4
00:00:17,160 --> 00:00:19,560
الإلاهة اللّهب الخفّاق تعود

5
00:00:19,560 --> 00:00:22,580
يقترب وصولها أكثر فأكثر مع مضي كلّ لحظة

6
00:00:23,040 --> 00:00:28,170
أغرقَ غزو العناكب العاصمةَ
في فوضى غير مسبوقة

7
00:00:29,000 --> 00:00:33,440
آكيرا متوجّهة نحو القصر لتقديم
مُناشدتها للسيّدة الإلاهة

8
00:00:34,320 --> 00:00:37,990
كوشي يطلق على العناكب
بمدفع البرق الخاص به

9
00:00:38,890 --> 00:00:45,020
،في هذه الأثناء، في قصر الأوكيبي
تحاول الآلهة اختطاف كيرا

10
00:00:49,110 --> 00:00:53,860
صيّاد النّار

11
00:02:16,150 --> 00:02:19,700
الشّجرة العظيمة

12
00:02:27,580 --> 00:02:28,750
كاناتا؟

13
00:02:28,750 --> 00:02:30,260
ما الخطب يا كاناتا؟

14
00:02:31,920 --> 00:02:34,460
الآنسة الصّغيرة تنادي؟

15
00:02:35,120 --> 00:02:36,940
توكو في خطر

16
00:02:37,620 --> 00:02:38,920
كون، أرسِل حشراتك

17
00:02:47,770 --> 00:02:48,820
هيّا بنا يا كون

18
00:02:49,380 --> 00:02:50,270
وأنت يا روروكو؟

19
00:02:50,680 --> 00:02:54,600
يبدو أنّ ميزوري أُعجب بكلب آكيرا

20
00:02:55,080 --> 00:02:57,080
سأذهب لأبحث عنه

21
00:02:58,360 --> 00:03:00,470
أنا ذاهب إلى توكو

22
00:03:01,090 --> 00:03:03,910
روروكو... انتبه على نفسك

23
00:03:05,560 --> 00:03:06,870
هيّا بنا يا كون

24
00:03:08,240 --> 00:03:11,080
لا أصدّق أنّ العناكب يستطيعون
التحكُّم بحشرات حقّاً

25
00:03:12,290 --> 00:03:15,560
،وظننتُ أنّ كوشي كان مجرّد فتى مغرور

26
00:03:15,560 --> 00:03:18,790
لكن أعتقد أنّ خوضه في صيد الوحوش
ذاك قد أتى أُكُله حقّاً

27
00:03:19,840 --> 00:03:21,550
هيّا بنا يا ميزوري

28
00:03:25,650 --> 00:03:28,120
هذا جميلٌ حقّاً

29
00:03:28,560 --> 00:03:32,280
،مضى وقتٌ طويل منذ رأيتُ واحدة

30
00:03:32,280 --> 00:03:36,140
لكن أحبّ ما تصنعه بالورق يا هيباري

31
00:03:36,870 --> 00:03:40,280
لكن أليس الورق للكتابة عليه؟

32
00:03:40,820 --> 00:03:44,360
أختنا، تايوراهيمي، أعطتني إيّاه

33
00:03:44,840 --> 00:03:48,380
شاركَتْه معي منذ فترة طويلة

34
00:03:50,480 --> 00:03:53,520
ما زلت تبدو كطفل يا هيباري

35
00:03:53,520 --> 00:03:58,180
رغم أنّه في الحقيقة، لا بدّ أنّك
أحد أقدم الآلهة الموجودين الآن

36
00:03:58,630 --> 00:04:01,470
لذا مضى وقتٌ طويلٌ منذ ذلك
الحين، أليس كذلك؟

37
00:04:02,130 --> 00:04:05,930
لكن بقيتِ طفلة أيضاً يا أختي

38
00:04:08,520 --> 00:04:09,890
...تلك الفتاة

39
00:04:11,570 --> 00:04:16,650
،إنّها مُتحالِفة مع صيّاد نار يهدف لاصطيادك
لكن هل آخذها إلى القصر؟

40
00:04:17,510 --> 00:04:20,320
يجب لتلك الفتاة أن تمضي

41
00:04:20,980 --> 00:04:24,820
هناك كلب يجب أن تلتقيه

42
00:04:25,250 --> 00:04:26,220
كلب؟

43
00:04:29,120 --> 00:04:34,830
على ذكرك للأمر، في العادة يرافقها كلبُ صيد

44
00:04:35,330 --> 00:04:37,700
أجل، مثل تايورا

45
00:04:38,680 --> 00:04:43,720
كان يرافق تايورا كلبٌ أيضاً، أتتذكّرين؟
كلب يُدعى إن

46
00:04:43,720 --> 00:04:50,390
تايوراهيمي

47
00:04:44,360 --> 00:04:46,220
هل ستذهبين إلى أختنا؟

48
00:04:46,830 --> 00:04:50,390
أجل. أريد رؤية تايورا

49
00:04:51,240 --> 00:04:56,280
—وأعيد تلك الفتاة إلى المنزل بسرعة

50
00:04:56,280 --> 00:05:00,770
قرّرت العشائرُ الإلهيّة تعيينكِ
السيّدة الإلاهة المُقبلة

51
00:05:01,320 --> 00:05:06,320
،يمكنكِ الولوج إلى الفراغ، اللّهب الخفّاق

52
00:05:06,320 --> 00:05:09,200
لكن عندما يستدعيكِ واجبكِ المفروض
،إلى هذه الأرض

53
00:05:09,550 --> 00:05:13,910
سوف تخلفين السيّدة تايوراهيمي

54
00:05:14,530 --> 00:05:17,190
ستغدو تلك الفتاة الجسد المُضيف لكِ

55
00:05:18,610 --> 00:05:23,070
إجبار السيّدة الإلاهة تحمُّل عبء كبير لوحدها

56
00:05:23,070 --> 00:05:27,050
يسمح لنا بالاحتفاظ بقوّتنا الإلهيّة

57
00:05:27,600 --> 00:05:30,620
نحن نحكم البشر النّاجين

58
00:05:31,680 --> 00:05:35,560
لا يجوز أن يدوم عالمٌ بهذا الشّكل

59
00:05:46,280 --> 00:05:50,320
يجب أن ألحّ بأن ترافقني الآنسة الصّغيرة

60
00:05:57,800 --> 00:06:01,470
سآخذك إلى حيث يوجد الكلاب

61
00:06:03,520 --> 00:06:04,880
كاناتا

62
00:06:11,340 --> 00:06:13,580
فقدتُ أثر كاناتا

63
00:06:13,580 --> 00:06:18,020
يجب أن تكون توكو في مكان قريب من كاناتا

64
00:06:18,480 --> 00:06:21,230
لكن لِمَ تتواجد توكو في مصنع؟

65
00:06:22,040 --> 00:06:25,690
.ظننتُها هربَتْ رفقة أولئك الأطفال
ما الّذي يمكن أن يكون قد حدث؟

66
00:06:26,800 --> 00:06:29,120
كون، حاول أن تبحث عن كاناتا من جديد

67
00:06:29,120 --> 00:06:31,700
الحشرات تضعف، لذا لا أستطيع التّحديد بدقّة

68
00:06:32,290 --> 00:06:36,280
حاول يا كون. حشراتُك هي أملنا الوحيد

69
00:06:37,080 --> 00:06:39,460
سأجرّب مرّة أخرى

70
00:07:31,840 --> 00:07:34,090
حديد
&
فولاذ

71
00:07:47,940 --> 00:07:49,530
شاحنة تجميع؟

72
00:07:56,910 --> 00:07:58,490
جدّتي

73
00:08:00,120 --> 00:08:01,370
عمّتي

74
00:08:06,660 --> 00:08:08,210
رين

75
00:09:17,970 --> 00:09:19,960
آثار أقدام مَن هذه؟

76
00:09:37,500 --> 00:09:43,160
...سيّد كوشي... آنسة آكيرا... كاناتا

77
00:09:45,640 --> 00:09:47,340
!كاناتا

78
00:09:51,750 --> 00:09:53,080
...كاناتا

79
00:09:54,280 --> 00:09:57,540
كاناتا عثرَ على الآنسة الصّغيرة

80
00:09:58,000 --> 00:09:59,680
أين توكو؟

81
00:09:59,680 --> 00:10:03,050
،الحشرات في حالٍ يُرثى لها
لذا لا أستطيع الرّؤية بوضوح

82
00:10:04,080 --> 00:10:05,250
هناك

83
00:10:31,020 --> 00:10:33,040
ما الأمر؟ ما الخطب يا كون؟

84
00:10:33,040 --> 00:10:34,020
...في الواقع

85
00:10:37,600 --> 00:10:42,250
برج كبير وحطبة سوداء كبيرة

86
00:10:42,880 --> 00:10:44,990
كذلك الشّيء السّابق

87
00:10:44,990 --> 00:10:50,660
...كون، هل تقصد أنّ توكو رأت شيئاً
شيئاً يشبه مدفع البرق؟

88
00:10:51,450 --> 00:10:53,630
لا بدّ أنّ ذلك هو المدفع الأوّل لتاكيغوتشي

89
00:10:54,980 --> 00:10:56,420
...يا سيّد

90
00:10:57,140 --> 00:11:00,240
!ثمّة ظلّ كبير قادم نحو الآنسة الصّغيرة

91
00:11:00,240 --> 00:11:03,080
—كلمة "ظلّ" لا تقودني إلى شيء. ما الّذي

92
00:11:03,640 --> 00:11:04,470
!زلزال

93
00:12:23,940 --> 00:12:26,010
قوم الشّجر العمالقة؟

94
00:12:30,130 --> 00:12:32,470
كنت في الحيّ المُحرَّم

95
00:12:46,470 --> 00:12:50,340
أرى بأنّك وصلت سليماً أيضاً

96
00:12:50,920 --> 00:12:53,620
صديقة الجاسوس؟

97
00:12:55,380 --> 00:12:57,210
...قوم الشّجر

98
00:12:57,210 --> 00:12:59,990
لكن لماذا أنتم فوق الأرض؟

99
00:13:00,880 --> 00:13:06,250
أسقطت الآلهةُ الأرضيّةَ لإخماد نيران العناكب

100
00:13:06,250 --> 00:13:12,350
بسبب ذلك، تمكّن كونوغي من التحرّر
من ذلك الجدار والصُّعود إلى هنا

101
00:13:12,760 --> 00:13:17,310
إذاً عن الآنسة كيري وبقيّة قوم الشّجر؟

102
00:13:17,310 --> 00:13:19,680
كيري وإن هربا

103
00:13:19,680 --> 00:13:22,190
لا نعرف أين شويو

104
00:13:22,190 --> 00:13:24,180
...الآخرون

105
00:13:26,820 --> 00:13:31,960
وحشٌ قتلَ شويو. أنا آسفة

106
00:13:31,960 --> 00:13:34,870
عجزتُ عن فعل شيء

107
00:13:35,780 --> 00:13:37,590
هكذا إذاً

108
00:13:38,500 --> 00:13:44,410
رغم أنّ هذا مُحزن، لا ينبغي أن تدعي
هذا يثير قلقكِ كثيراً

109
00:13:44,410 --> 00:13:48,760
لا يمكننا العيش طويلاً على السّطح

110
00:13:49,240 --> 00:13:50,220
ماذا؟

111
00:13:58,650 --> 00:14:03,510
لا شيء يمكنني... لا شيء يمكننا فعله

112
00:14:03,510 --> 00:14:07,110
،قلتُ أنّنا ينبغي أن نعود إلى التّربة فحسب

113
00:14:07,110 --> 00:14:13,000
،لكن صعدَ كونوغي إلى فوق الأرض
على أمل صنع قبور لزملائنا

114
00:14:13,000 --> 00:14:18,380
يجب أن نحفر القبور. قبور لقوم الشّجر

115
00:14:18,970 --> 00:14:24,590
إذا أردتَ صنع قبور لزملائك، فادفن
العناكب الموتى أوّلاً

116
00:14:27,190 --> 00:14:30,940
لا يجوز أن نترك الجثثَ مُبعثَرة. الموت مُدنِّس

117
00:14:31,920 --> 00:14:38,330
يجب أن ننظّف المنطقة المُحيطة بالقصر
قبل أن يسبّب العفن أضواء شبح

118
00:14:39,960 --> 00:14:40,980
!كاناتا

119
00:15:03,400 --> 00:15:07,500
أنت روري-ماتسوري من عشيرة الخشب

120
00:15:08,500 --> 00:15:14,250
،أعدت صنعنا نحن، قوم الشّجر
من الحيّ المُحرَّم

121
00:15:14,250 --> 00:15:17,430
ماذا؟ ذاكرتك قويّة

122
00:15:20,260 --> 00:15:24,990
لم يكن لديّ أي شيء جديد
أتذكّره تحت الأرض

123
00:15:24,990 --> 00:15:27,850
أين كيري؟

124
00:15:27,850 --> 00:15:31,590
ينبغي أن تتمكّني من التّحديد
حتّى من دون وضع الجذور

125
00:15:35,410 --> 00:15:39,470
يبدو أنّها ترعى البشر الجرحى

126
00:15:39,470 --> 00:15:43,000
هذا ملائم لمهمّة قوم شجر أخيرة

127
00:15:44,100 --> 00:15:47,290
البشريّة المدعوّة هيناكو معها

128
00:15:49,720 --> 00:15:54,050
هل أنتِ من يضع هيباري نصب عينيه عليه؟

129
00:15:55,080 --> 00:16:04,160
هيباري... بقيّتنا نعمل جاهدين لإخماد
،النّيران واستدعاء المطر وتحويل مياه القنوات

130
00:16:04,160 --> 00:16:07,770
والتسبُّب بانهيار الأرض وتوجيه
سقوط الأشجار والمباني

131
00:16:08,320 --> 00:16:14,060
لكنّه يركّز فقط على السيّدة الإلاهة ومُذنّب الألفيّة

132
00:16:14,060 --> 00:16:16,380
يرفض أن يؤدّي عملاً حقيقيّاً

133
00:16:29,540 --> 00:16:31,800
الأشجار تحترق

134
00:16:31,800 --> 00:16:35,300
ألم تخمد الآلهةُ نار العناكب؟

135
00:16:35,960 --> 00:16:37,320
البشر من فعلوا هذا

136
00:16:40,210 --> 00:16:44,760
لماذا يستخدم البشرُ النّار؟
لماذا يحرقون الأشجار؟

137
00:16:45,600 --> 00:16:49,700
البشر الّذين يفعلون ذلك يقعون
في شبكة العناكب

138
00:16:50,440 --> 00:16:55,180
عرفتُ أنّ بعض البشر دعموا العناكبَ سرّاً

139
00:16:56,100 --> 00:17:00,620
،غير مكتفيين بحفر أنفاق سرّية تحت المصانع

140
00:17:00,620 --> 00:17:05,240
يُشعلون أجسادهم لحرق المصانع والأشجار

141
00:17:06,000 --> 00:17:08,330
يحرقون أنفسهم؟

142
00:17:09,130 --> 00:17:13,450
!أتى العناكب! أحضر العناكبُ النّار

143
00:17:11,160 --> 00:17:13,970
!ليس وحوشاً ناريّة قذرة! نار مُطهِّرة

144
00:17:13,450 --> 00:17:16,090
!العناكب سوف تُنقذنا، حتّى بعد مماتنا

145
00:17:13,970 --> 00:17:19,510
!لا بدّ أنّكم رأيتم سقوط النّجم ذاك
ستحصل العناكب عليه وتهزم الآلهة

146
00:17:16,090 --> 00:17:17,930
!العناكب مُنقِذونا الحقيقيّون

147
00:17:17,930 --> 00:17:21,640
!سوف يحرّروننا! سوف يحرّروننا

148
00:17:19,510 --> 00:17:21,640
!سنكون أحراراً

149
00:17:22,440 --> 00:17:28,250
أولئك البشر صدّقوا تلك الرّواية السّخيفة
بشأن إعادة إحياء

150
00:17:28,250 --> 00:17:31,790
ضحايا نار العناكب بأجسام لا تحترق

151
00:17:31,790 --> 00:17:37,610
وكلّ هذا لأنّه لم يُشعِر أحداً بنشاطه

152
00:17:38,370 --> 00:17:43,820
لا أصدّق بأنّه ظلَّ يخدع عشيرة
الرّياح ذات حاسّة السّمع الحادّة

153
00:17:43,820 --> 00:17:49,820
كان ينبغي للعشائر أن تراقب ذلك الغبيّ أكثر

154
00:17:51,190 --> 00:17:54,800
هل تقصدين... السيّد هيباري؟

155
00:18:07,990 --> 00:18:12,150
سأذهب مع كاناتا. علينا إيجاد السيّد كوشي

156
00:18:12,540 --> 00:18:17,850
إذا ذهبتُما وساعدتما الآنسة كيري، من فضلكما
احميا هيناكو، الفتاة الّتي معها، أيضاً

157
00:18:17,850 --> 00:18:19,830
إنّها جزءٌ من عائلة هذا الكلب

158
00:18:27,840 --> 00:18:30,580
...كون، بخصوص ذلك العنكبوت المدعو أون

159
00:18:31,460 --> 00:18:34,010
كانت أون معنا في الغابة

160
00:18:34,490 --> 00:18:38,980
قال أبي أنّ أون كانت أفضل
بالسّيوف منه بالحشرات

161
00:18:43,240 --> 00:18:47,770
ما شكل الحشرات الّتي تقيك من الاحتراق؟

162
00:18:48,390 --> 00:18:52,480
سمعتُ أنّ بعض الحشرات الخاصّة قد وُلِدت

163
00:18:52,480 --> 00:18:58,680
،وحالما تلسع تلك الحشرات الجميع
فإنّ الاقتراب من النّار لا يضرّهم

164
00:18:59,790 --> 00:19:04,440
كنتُ الوحيد الّذي لم تعطِ الحشرات
مفعولها معه، لذا تركوني في الغابة

165
00:19:04,440 --> 00:19:07,590
أخبرتني أمّي أن أصبح جزءاً من الغابة وغادرتْ

166
00:19:09,700 --> 00:19:10,970
هكذا إذاً

167
00:19:12,280 --> 00:19:16,240
هل يُعقَل لحشرة أن تمتلك ذلك التّأثير؟

168
00:19:16,240 --> 00:19:21,150
،لكن أدخل العناكبُ اللّهبَ القديم إلى العاصمة

169
00:19:21,150 --> 00:19:25,960
لذا لا بدّ أنّ لديهم على الأقلّ طريقة ما
لوقاية أجسامهم من الاحتراق

170
00:19:26,980 --> 00:19:33,300
لكن حتّى لو فعلوا، لِمَ يرغبون
في مُشاركته مع البشر؟

171
00:19:34,500 --> 00:19:38,310
أكثر من أي أحد آخر، ينبغي
للبشر أن يستردّوا النّار

172
00:19:38,730 --> 00:19:43,070
أن يعودوا إلى العصر الّذي كانوا
يتبجّحون فيه بالتحكّم بقوّتها

173
00:19:43,070 --> 00:19:46,870
لِمَ... لِمَ تهتمّين كثيراً بشأن ما يفعله البشر؟

174
00:19:48,950 --> 00:19:52,220
"هذه هي الطبيعة الحقيقيّة للبشر"

175
00:19:52,220 --> 00:19:55,340
"هذه هي طبيعة المخلوقات البشريّة"

176
00:19:55,880 --> 00:20:01,560
ألم تقتلوا ما يكفي باستخدام قوّة وحوش الهواء؟

177
00:20:03,040 --> 00:20:06,970
كبشر العالم القديم

178
00:20:09,750 --> 00:20:12,570
"هذه هي طبيعة المخلوقات البشريّة"

179
00:20:13,160 --> 00:20:15,880
"لذا استرِدّوا النّار"

180
00:20:16,440 --> 00:20:17,820
يا سيّد؟

181
00:20:21,300 --> 00:20:25,270
كيف برأيك عثر كاناتا على الآنسة الصّغيرة؟

182
00:20:25,680 --> 00:20:29,880
وجدَ كاناتا من ينبغي له حمايته من تلقاء نفسه

183
00:20:29,880 --> 00:20:30,970
من تلقاء نفسه؟

184
00:20:31,410 --> 00:20:34,990
صيّادو النّار لا يختارون كلاب صيدهم

185
00:20:34,990 --> 00:20:37,610
كلاب الصّيد هي ما يختار صيّاديهم

186
00:20:47,670 --> 00:20:49,320
ون، بسرعة

187
00:21:23,510 --> 00:21:25,130
يجب ألّا تذهبا

188
00:21:30,260 --> 00:21:31,850
يجب ألّا تذهبا

189
00:21:33,520 --> 00:21:34,860
لا تفعل يا كون

190
00:21:38,180 --> 00:21:40,060
ألم تكوني تعملين لصالح عائلة أوكيبي؟

191
00:21:42,040 --> 00:21:45,030
يجب ألّا تتابعا أكثر

192
00:21:54,280 --> 00:21:57,210
عليّ الذّهاب. أصدقائي في خطر

193
00:21:58,370 --> 00:21:59,590
اختبئ

194
00:22:00,150 --> 00:22:01,850
ستحترق

195
00:22:01,850 --> 00:22:03,880
يجب ألّا تموت

196
00:22:05,140 --> 00:22:06,840
...يا سيّد

197
00:22:07,120 --> 00:22:08,390
أنا آسفة

198
00:22:08,790 --> 00:22:12,180
لم أعُد شخصاً

199
00:23:49,990 --> 00:23:51,990
الحلقة القادمة

200
00:23:56,870 --> 00:24:00,000
نار
مُدَّخَرة