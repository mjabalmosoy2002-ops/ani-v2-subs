1
00:00:04,520 --> 00:00:08,620
أنتم... يجب ألّا تستخدموا النّار

2
00:00:09,460 --> 00:00:12,180
قتلتُم بعضكم الآخر بما يكفي

3
00:00:13,200 --> 00:00:15,110
ستحترق الحياة

4
00:00:15,720 --> 00:00:17,540
سيحترق العالم

5
00:00:19,910 --> 00:00:25,920
انتهت الحرب الأخيرة للبشريّة بخلق
سلاح بيولوجيّ

6
00:00:25,920 --> 00:00:33,000
عدّلَ البشريّة بحيث يحترقون من الدّاخل
إذا مسّتْهم نارٌ طبيعيّة

7
00:00:34,000 --> 00:00:36,760
مع ذلك نجا العرق البشريّ

8
00:00:37,330 --> 00:00:41,600
،رغم أنّ غابة الظّلام طوّقَتْهم مع العالم

9
00:00:41,600 --> 00:00:42,600
توكوهاناهيمي

10
00:00:41,600 --> 00:00:44,900
أجيال متعاقبة محرومة لكن شديدة العزم

11
00:00:46,660 --> 00:00:50,970
احتوَتْ وحوش الغابة على نار
لا تسبّب احتراق البشر

12
00:00:50,970 --> 00:00:53,820
"أطلقَ النّاسُ عليها "وحوش النّار

13
00:00:52,690 --> 00:00:53,820
وحوش النّار

14
00:00:54,780 --> 00:00:59,950
أولئك الّذين قتلوا الوحوش لأجل هذا الضّوء
"المُبارَك والدّفء أُطلِق عليهم "صيّادو النّار

15
00:00:58,870 --> 00:00:59,950
صيّادو النّار

16
00:00:59,950 --> 00:01:08,040
وهلّلوا للمُنقِذ الّذي لم يُرَ بعد والّذي
كان ليحرف الهلاك العائد للبشريّة

17
00:01:08,040 --> 00:01:10,420
"سيّد صيّادي النّار"

18
00:01:08,040 --> 00:01:11,300
سيّد صيّادي
النّار

19
00:01:10,340 --> 00:01:13,880
(موكو (براءة

20
00:01:11,490 --> 00:01:12,970
...آنسة آكيرا

21
00:01:12,970 --> 00:01:17,400
آنسة آكيرا، أعتقد بأنّكِ ينبغي
أن تصبحي سيّدة صيّادي النّار

22
00:01:21,060 --> 00:01:25,810
صيّاد النّار

23
00:02:49,510 --> 00:02:52,500
هيباري من العشائر الإلهيّة
وآكيرا صيّادة النّار

24
00:02:53,400 --> 00:02:57,550
اشتبكا في معركة عنيفة كادت فيها
توكو أن تغرق في قناة

25
00:02:57,550 --> 00:03:04,200
لكن أخت كوشي، هيناكو، أنقذَتْ توكو
وكذلك كلب صيد آكيرا، تيماري

26
00:03:11,800 --> 00:03:13,640
كاناتا؟

27
00:03:16,520 --> 00:03:17,930
هل استيقظتِ؟

28
00:03:18,440 --> 00:03:19,880
آنسة آكيرا

29
00:03:20,870 --> 00:03:22,110
...هل كون

30
00:03:22,110 --> 00:03:24,300
لا تقلقي. إنّه نائمٌ فحسب

31
00:03:29,970 --> 00:03:32,140
لماذا يوجد أحدٌ من قوم الشّجر ووحش هنا؟

32
00:03:34,980 --> 00:03:36,270
...شويو

33
00:03:36,920 --> 00:03:40,240
توكو، هل أنتِ من قتل ذلك الوحش؟

34
00:03:40,240 --> 00:03:42,880
لا أتذكّر بصراحة

35
00:03:42,880 --> 00:03:46,880
قفز فجأة أمامي بوجود شويو في فكّيه

36
00:03:46,880 --> 00:03:48,830
...تيماري وأنا

37
00:03:48,830 --> 00:03:53,210
أخت كوشي الصّغرى سحبتنا للأعلى نحو الضفّة

38
00:03:53,620 --> 00:03:54,560
ماذا؟

39
00:03:54,560 --> 00:03:59,760
لم أصدِّق كم كانت قويّة. بدتْ غريبة أيضاً

40
00:03:59,760 --> 00:04:04,150
ثمّ عبرَتِ القناةَ وغادرتْ

41
00:04:04,970 --> 00:04:06,250
كيف عبرَتْ؟

42
00:04:07,520 --> 00:04:10,550
بدا وكأنّها طارَتْ

43
00:04:12,690 --> 00:04:14,450
ما الّذي يجري بالضبط؟

44
00:04:14,450 --> 00:04:19,850
ظننتُ أنّ أخت كوشي كانت مريضة
وكان الأوكيبي يعتنون بها

45
00:04:19,850 --> 00:04:21,780
...لكنّها

46
00:04:22,790 --> 00:04:24,680
شكراً لكِ على ما فعلته لكاناتا

47
00:04:25,740 --> 00:04:29,350
شكرَتْني على إعادة كاناتا

48
00:04:29,350 --> 00:04:30,550
...كان ذلك

49
00:04:45,720 --> 00:04:48,010
تسلّل وحوش إلى داخل العاصمة

50
00:04:49,080 --> 00:04:55,350
،بما أنّهم حطّموا حواجز الوحوش
فلا بدّ أنّ العناكب تتحكّم بهم

51
00:05:26,870 --> 00:05:29,690
كلّ صيّاد نار وكلب صيد في العاصمة
سوف يتوجّهون إلى هنا

52
00:05:30,430 --> 00:05:32,500
توكو، خُذي كون واهربوا

53
00:05:33,700 --> 00:05:35,460
هذا المكان على وشك أن يتحوّل
إلى ساحة معركة

54
00:05:37,380 --> 00:05:38,940
اهربي أنتِ يا آنسة آكيرا

55
00:05:41,940 --> 00:05:44,360
سوف تصبحين سيّدة صيّادي النّار

56
00:05:44,360 --> 00:05:47,690
لم أشرع في رحلتي لأصبح
شيئاً عظيماً كهذا

57
00:05:47,690 --> 00:05:51,560
.لا أريد أن يموت هذا العالم بعد فحسب
...بالإضافة إلى ذلك

58
00:05:53,240 --> 00:05:55,740
لستِ صيّادة نار الآن

59
00:06:02,000 --> 00:06:03,160
ها هم قادمون

60
00:06:03,160 --> 00:06:06,550
آسفة يا توكو، لكن سأستعير كاناتا

61
00:06:07,280 --> 00:06:11,420
قطيع من الوحوش يخترق الحواجز
ويدخل العاصمة

62
00:06:11,830 --> 00:06:15,480
يجتمع صيّادو الوحوش لدحرهم

63
00:06:15,480 --> 00:06:20,470
كما قالت آكيرا، يتحوّل هذا المكان
إلى ساحة معركة

64
00:06:27,150 --> 00:06:30,070
آكيرا وتيماري تقاتلان ببسالة

65
00:06:30,490 --> 00:06:32,260
وكذلك كاناتا

66
00:06:51,650 --> 00:06:52,720
توكو؟

67
00:07:00,640 --> 00:07:02,860
أيّتها الحمقاء

68
00:07:28,050 --> 00:07:29,030
!توكو

69
00:07:40,100 --> 00:07:42,560
!توكو! تراجعي حاليّاً

70
00:07:45,650 --> 00:07:46,770
...توكو

71
00:07:55,730 --> 00:07:56,700
!توكو

72
00:08:06,350 --> 00:08:07,090
!يا آنسة

73
00:08:19,800 --> 00:08:21,140
!ابتعد يا ميزوري

74
00:08:35,050 --> 00:08:37,140
آنسة آكيرا، أنتِ مُصابة

75
00:08:37,140 --> 00:08:39,500
تبّاً، كم أنا مُثيرة للشّفقة

76
00:08:39,910 --> 00:08:41,690
بالغتِ كثيراً

77
00:08:41,690 --> 00:08:43,620
والآن خذي الفتاة وتراجعا

78
00:08:45,080 --> 00:08:48,090
كلّ صيّاد نار في العاصمة رأى مذنّب الألفيّة

79
00:08:49,050 --> 00:08:52,550
لن ترقد روح أخيكِ بسلام أبداً إذا متِّ هنا

80
00:08:53,460 --> 00:08:56,970
توجّهي إلى القصر قبل أن يسبقك
العناكب إلى هناك

81
00:08:59,040 --> 00:09:00,340
هيّا بنا يا ميزوري

82
00:09:05,680 --> 00:09:07,810
...كوشي

83
00:09:08,420 --> 00:09:10,020
علينا الابتعاد من هنا

84
00:09:11,440 --> 00:09:13,940
لستِ بحاجة لاستخدام هذا بعد الآن

85
00:09:20,900 --> 00:09:22,330
!انظروا هناك

86
00:09:22,330 --> 00:09:24,940
!دخل العناكبُ إلى هنا

87
00:09:25,930 --> 00:09:26,820
ماذا؟

88
00:09:28,750 --> 00:09:29,790
!لا

89
00:09:30,250 --> 00:09:31,680
!الوحوش في ذلك الاتّجاه

90
00:09:31,680 --> 00:09:32,210
!انتظروا

91
00:09:33,300 --> 00:09:34,860
!أنتم ترتكبون خطأ

92
00:09:34,860 --> 00:09:35,630
!اقتلوه

93
00:09:40,050 --> 00:09:41,810
!انتظروا! لا تقتلوه

94
00:09:58,550 --> 00:09:59,910
هيناكو؟

95
00:10:10,310 --> 00:10:12,130
تعالي معي من فضلكِ

96
00:10:12,130 --> 00:10:14,670
تحتاجين إلى علاج إذا كنتِ ذاهبة إلى القصر

97
00:10:14,670 --> 00:10:16,900
توكو، هل يمكنكِ النّهوض؟

98
00:10:23,400 --> 00:10:25,800
مثل أختي الكبرى فحسب

99
00:10:26,760 --> 00:10:27,850
من أنتِ؟

100
00:10:28,480 --> 00:10:33,590
لكن توكوهاناهيمي قد رحلت عن هذا العالم

101
00:10:34,010 --> 00:10:37,110
لا أستطيع رؤية أختي بشحمها ولحمها الآن

102
00:10:37,990 --> 00:10:41,560
،غادرتُ مداري لأنّني لم أستطع تحمُّل الخوف

103
00:10:42,000 --> 00:10:43,880
ومع ذلك عدتُ

104
00:10:44,400 --> 00:10:47,780
هل أنا ميّتة؟

105
00:10:48,120 --> 00:10:49,770
لستِ ميّتة

106
00:10:50,290 --> 00:10:54,030
كانت أختنا الكبرى مَن ماتت

107
00:10:54,030 --> 00:10:56,700
والكثير من البشر أيضاً

108
00:10:57,110 --> 00:10:59,640
تقريباً كلّ الحياة

109
00:11:00,520 --> 00:11:02,440
أنتِ حيّة

110
00:11:03,140 --> 00:11:05,640
من أنتِ؟

111
00:11:06,340 --> 00:11:08,140
اللّهب الخفّاق؟

112
00:11:09,560 --> 00:11:15,640
مات بما يكفي بالفعل، مع ذلك
ما زالوا يقتلون بعضهم الآخر

113
00:11:17,280 --> 00:11:20,940
أنتِ اللّهب الخفّاق

114
00:11:22,930 --> 00:11:24,620
ضمّد كون

115
00:11:24,620 --> 00:11:27,470
العناكب هم كما الآلهة جسديّاً

116
00:11:27,470 --> 00:11:30,500
الأولويّة لجروحكِ

117
00:11:30,940 --> 00:11:34,500
لستُ طبيباً، لذا يمكنني منحكِ
،إسعافات أوّلية فحسب

118
00:11:34,920 --> 00:11:36,820
لكن يمكنني إيقاف النّزيف على الأقلّ

119
00:11:38,000 --> 00:11:39,040
ماذا عن توكو؟

120
00:11:39,040 --> 00:11:41,120
نائمة من شدّة إرهاقها

121
00:11:41,120 --> 00:11:43,100
...إنّها ضئيلة الحجم، ومع ذلك

122
00:11:44,360 --> 00:11:47,350
أنتم. لم ينتهِ عملنا بعد

123
00:11:48,340 --> 00:11:51,210
لن أدع توكو تمسك مِنجلاً بعد الآن

124
00:11:54,000 --> 00:11:56,010
إنّها تقتل بإسراف

125
00:11:57,000 --> 00:11:59,340
القتل مختلف عن الصّيد

126
00:11:59,340 --> 00:12:02,120
يجب ألّا ندع توكو تمسك مِنجلاً ثانية

127
00:12:54,440 --> 00:12:55,540
هيناكو؟

128
00:12:56,210 --> 00:12:57,380
!هيناكو

129
00:12:58,950 --> 00:13:01,460
كوشي. لا تذهب بحثاً عنها

130
00:13:02,080 --> 00:13:04,170
...إنّها غالباً

131
00:13:04,650 --> 00:13:06,980
مُعاد صنعها بواسطة الآلهة

132
00:13:07,580 --> 00:13:10,140
كما قوم الشّجر في الحيّ المُحرَّم

133
00:13:12,720 --> 00:13:16,060
...أعتقد أنّ الطبيب الّذي عالج هيناكو

134
00:13:16,460 --> 00:13:18,520
يعمل لصالح الآلهة؟

135
00:13:18,920 --> 00:13:23,990
قد يكون إلَهاً. وقد لا يكون الوحيد في قصر أوكيبي

136
00:13:24,560 --> 00:13:26,710
هل السيّد أوكيبي يعلم؟

137
00:13:27,260 --> 00:13:29,620
أشكّ في أنّه أدرك ذلك

138
00:13:30,040 --> 00:13:32,450
إنّه يبغض العشائر الإلهيّة

139
00:13:33,720 --> 00:13:35,960
...تلك الفتاة لم تعُد

140
00:13:45,060 --> 00:13:46,250
ماذا الآن؟

141
00:13:46,250 --> 00:13:50,010
سأناشد السيّدة الإلاهة

142
00:13:50,010 --> 00:13:52,520
...لكن حينئذ سينتهي المطاف بكِ مثل

143
00:13:52,520 --> 00:13:56,830
سرّب أخي معلومات عن مُذنّب الألفيّة
،وسيّد صيّادي النّار

144
00:13:56,830 --> 00:13:58,730
فقتلَتْه الآلهةُ على ذلك

145
00:13:59,740 --> 00:14:05,630
أنا الأخت الصّغرى لذلك الأحمق، وصيد
وحوش النّار هو كلّ ما أعرف القيام به

146
00:14:05,630 --> 00:14:07,820
لذا سأفعل ما اتّخذتُ قراري لفعله

147
00:14:08,650 --> 00:14:11,370
لكن لديّ آمل هذه المرّة

148
00:14:11,770 --> 00:14:16,090
السيّدة الإلاهة يجب أن تقرأ مُناشدة
،مكتوبة على ورق موكو

149
00:14:16,090 --> 00:14:20,660
والآلهة لا يستطيعون تجاهل الأمر الآن
بعد أن شنّت العناكب غزوها

150
00:14:22,260 --> 00:14:24,750
وبعد؟ ماذا ستفعلين؟"

151
00:14:25,830 --> 00:14:31,450
ستستخدمين الأنفاق الّتي تربط المصانع
للوصول إلى مصنع إيبوشي للاستنبات

152
00:14:34,520 --> 00:14:37,850
،لديهم مدفع البرق الثّاني

153
00:14:42,340 --> 00:14:44,320
سأنضمّ لهم

154
00:14:44,320 --> 00:14:50,160
لا بدّ أنّ السيّد أوكيبي في طريقه إلى المدفع
الأوّل في مصنع الفولاذ تاكيغوتشي

155
00:14:54,120 --> 00:14:59,240
كوشي، لست بحاجة للوقوف بجانب
العجوز الثّري أوكيبي بعد الآن

156
00:15:00,180 --> 00:15:02,820
ليس عليك تعريض نفسك للخطر أيضاً

157
00:15:03,410 --> 00:15:06,620
إذا توجّهتَ إلى البلدة مباشرة، يمكنك
الوصول إلى الجسر

158
00:15:06,620 --> 00:15:08,550
خذ توكو وكون معك

159
00:15:08,550 --> 00:15:10,570
لا، سأبقى مُلتزماً بالخطّة

160
00:15:13,360 --> 00:15:18,760
صمّمتُ تلك الآلة، ذلك السّلاح، لحماية أهل البلدة

161
00:15:18,760 --> 00:15:21,370
من حرب العناكب مع الآلهة

162
00:15:22,870 --> 00:15:26,390
لديّ مسؤوليّة لإكمال هذا

163
00:15:26,820 --> 00:15:29,490
أتساءل ما إن كان هايجو مثلك

164
00:15:30,240 --> 00:15:31,320
أبي؟

165
00:15:31,320 --> 00:15:35,690
تخلّى هايجو حتّى عن عائلته
بحثاً عن ورق موكو

166
00:15:37,200 --> 00:15:41,610
سافر إلى قرية توكو، لكن قبل أن يتمكّن
،من الحصول على ما أراده

167
00:15:41,610 --> 00:15:45,210
تُوفِّي وهو يُنقِذ توكو من هجوم وحش

168
00:15:46,770 --> 00:15:48,220
حماقة كبيرة، صحيح؟

169
00:15:48,840 --> 00:15:51,300
يبدو هذا سخيفاً

170
00:15:51,730 --> 00:15:55,260
،لو تجاهلَ توكو وحصلَ على ورق موكو

171
00:15:55,260 --> 00:16:01,080
لتمكّن هايجو ربّما من إرسال عريضة إلى السيّدة
الإلاهة ليصبح سيّد صيّادي النّار

172
00:16:02,040 --> 00:16:09,450
لكن كما تعلم، وحده الأحمق طيّب القلب
مَن يفكّر في مخالفة القانون الإلهي

173
00:16:09,450 --> 00:16:11,100
ناهيك عن تنفيذه

174
00:16:14,160 --> 00:16:19,620
لم يذكر أبي شيئاً عن سيّد
صيّادي النّار أمامي أبداً

175
00:16:20,260 --> 00:16:24,250
لدى سيّد صيّادي النّار القوّة"
"لتغيير العالم

176
00:16:25,120 --> 00:16:27,880
،تبدو كحكاية خرافيّة

177
00:16:28,520 --> 00:16:34,330
لكن بالنّظر إلى العاصمة، نحتاج
حقّاً لبديل عن القانون الإلهي

178
00:16:35,350 --> 00:16:38,300
قال السيّدُ أوكيبي نفس الكلام

179
00:16:41,040 --> 00:16:45,100
أخبرني أنّنا بحاجة لسلاح ضدّ
الآلهة لتحقيق ذلك

180
00:16:45,530 --> 00:16:52,470
ومن أجل أن يأكل كلُّ البشر كفايتهم
من اللّحم، يجب تقديم تضحيات

181
00:16:53,530 --> 00:16:58,630
سيّد صيّادي الوحوش هو شخص يقضي
حياته في التّفكير بكيفيّة عيش الآخرين

182
00:16:59,400 --> 00:17:02,700
لا يُعاملون النّاس كعملة ورقيّة

183
00:17:03,070 --> 00:17:06,500
إذاً ليس أي شخص مؤهّل لذلك؟

184
00:17:06,980 --> 00:17:09,750
مهارة صيد اللّهب الخفّاق لا تكفي

185
00:17:10,360 --> 00:17:14,600
صحيح. نحتاج شخصاً جديراً ليصبح
سيّد صيّادي النّار

186
00:17:31,460 --> 00:17:33,560
سهل تخلون إلى المدينة؟

187
00:17:33,560 --> 00:17:35,320
لم يبقَ أحد

188
00:17:36,120 --> 00:17:38,240
من أين أتيتم؟

189
00:17:38,240 --> 00:17:42,860
هلّا أخذت هذه الطفلة معك؟ إنّها جريحة

190
00:17:42,860 --> 00:17:44,580
،بالتّأكيد، يمكنني أخذها

191
00:17:44,580 --> 00:17:49,200
لكن إذا كانت جريحة، فهناك شخص من قوم الشّجر
تُدعى كيري تعالج النّاس في الأطراف الجنوبيّة

192
00:17:49,200 --> 00:17:52,380
كيري؟ تقصد أنّ كيري صعدت إلى فوق الأرض أيضاً؟

193
00:17:53,170 --> 00:17:55,050
لا، انسَ الأمر

194
00:17:55,490 --> 00:17:56,860
ماذا عن هذا الفتى؟

195
00:17:57,880 --> 00:17:59,180
إنّه ابني

196
00:18:00,850 --> 00:18:03,140
ألن تخلوا المكان؟

197
00:18:03,140 --> 00:18:05,850
ما زال هناك عمل يجب أن نقوم به

198
00:18:06,500 --> 00:18:08,310
عمل؟

199
00:18:09,900 --> 00:18:17,210
،اسأل لحّام المعادن وغسّالة الملابس في ميناتوزاكا
المنطقة 22. سيحدّثانك عنها

200
00:18:25,270 --> 00:18:27,460
ستستشيط غضباً لاحقاً

201
00:18:28,550 --> 00:18:31,660
لا أحد يتصوّر ذلك، لكن تتّصف توكو بمزاج عكِر

202
00:18:35,510 --> 00:18:39,720
لن أتركك، حسناً؟ سوف أعود

203
00:18:39,720 --> 00:18:42,730
ابقَ مع هذا الفتى وافعل ما يطلبه منك

204
00:18:42,730 --> 00:18:46,460
آنسة آكيرا، سيبدأ البرقُ قريباً. كوني حذرة

205
00:18:46,460 --> 00:18:49,940
أنا متحمّسة لرؤية اختراعك

206
00:18:51,000 --> 00:18:57,400
تاركاً توكو لعطف الآخرين، كوشي يأخذ
كون إلى مدفع البرق

207
00:18:57,960 --> 00:19:04,440
تتوجّه آكيرا إلى القصر الإلهيّ رفقة
تيماري لتقديم مُناشدة للسيّدة الإلاهة

208
00:19:05,330 --> 00:19:09,940
قد يكون وقت افتراقهما طويلاً

209
00:19:21,410 --> 00:19:23,260
ما هذا المكان؟

210
00:19:23,260 --> 00:19:27,140
إنّه حيث ينمو الطّعام عندما لا يمتلك
النّاس في العاصمة ما يكفي

211
00:19:27,640 --> 00:19:30,350
كون، سوف نخبئك هنا

212
00:19:30,350 --> 00:19:32,620
لا تقلق. سيكون كاناتا معك

213
00:19:33,150 --> 00:19:34,580
أعتمد عليك يا كاناتا

214
00:19:35,700 --> 00:19:39,220
لا تخرج حتّى لو سمعت صوتَ ضجيج

215
00:20:09,480 --> 00:20:12,120
مرحباً! هل من أحدٍ هنا؟

216
00:20:12,940 --> 00:20:15,430
هذا أنا، كوشي! هل من أحد هنا؟

217
00:20:16,160 --> 00:20:17,780
استغرقتَ وقتاً طويلاً

218
00:20:18,920 --> 00:20:21,690
أنت... هيباري

219
00:20:24,540 --> 00:20:25,870
هل قتلتهم جميعاً؟

220
00:20:26,330 --> 00:20:32,830
بالطبع لا. لاذوا بالفرار حالما رأوا جواسيسي

221
00:20:36,580 --> 00:20:39,250
هل الآلهة من أنزلوا هذا المطر أيضاً؟

222
00:20:39,250 --> 00:20:42,040
لعلّهم جعلوه غزيراً زيادة عن اللّزوم

223
00:20:42,040 --> 00:20:47,850
،استدعوا المطر بهذا الشّكل من قبل
عندما حاولوا إيقاف الحريق العظيم

224
00:20:49,360 --> 00:20:57,050
أخمدت الآلهةُ المالكة للماء أخيراً
اللّهب باستدعاء عاصفة مطريّة

225
00:20:57,720 --> 00:21:01,560
أعتقد أنّ العشائر الإلهيّة اختارت
التّأخير والسّماح بحدوث ذلك

226
00:21:01,560 --> 00:21:04,700
قتلوا البشر لتقليص الفائض السكّاني البشريّ

227
00:21:08,080 --> 00:21:09,120
لقد وصلوا

228
00:21:09,760 --> 00:21:12,250
دخلت العناكبُ العاصمة

229
00:21:28,680 --> 00:21:32,210
استخدموا الوحوشَ لصرف الانتباه

230
00:21:32,210 --> 00:21:38,730
أرى أنّ الحِيَل البدائيّة المعتادة للعناكب
أثبتت فعاليّتها ضدّ البشر

231
00:21:40,150 --> 00:21:46,460
ويبدو أنّ بعض البشر خطّطوا لدعوتهم
إلى داخل المدينة

232
00:21:46,860 --> 00:21:54,830
ابتداء بإعادة الإعمار عقب الحريق
العظيم، شيّدوا معابرَ خفيّة

233
00:21:54,830 --> 00:21:57,480
وذلك كي يتمكّن العناكبُ من الوصول إلى الأنفاق

234
00:21:58,590 --> 00:22:04,160
كان أمام العناكب وسيلة لدخول
العاصمة طوال هذا الوقت

235
00:22:04,160 --> 00:22:06,760
والبشر مهّدوا ذلك لهم