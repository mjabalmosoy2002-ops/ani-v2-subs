1
00:00:01,510 --> 00:00:04,830
،وسط معركة مُميتة بين الوحوش وصيّادي النّار

2
00:00:04,830 --> 00:00:08,220
شنَّت العناكبُ غزوها للعاصِمة أخيراً

3
00:00:10,280 --> 00:00:16,240
تتوجّه آكيرا إلى القصر لتقدّم مُناشدة
على ورق موكو للسيّدة الإلاهة

4
00:00:16,580 --> 00:00:17,990
...و

5
00:00:21,080 --> 00:00:25,830
صيّاد النّار

6
00:01:49,160 --> 00:01:54,960
أخبرني كيف ستُقاتل العناكب
بهذه الآلة القبيحة؟

7
00:01:56,050 --> 00:02:01,680
،هل أخبرت حلفاءك، الآلهة الآخرين
عن هذا المكان سلفاً؟

8
00:02:02,120 --> 00:02:06,520
لا. أقربائي لا يُبالون لي

9
00:02:06,520 --> 00:02:09,000
والعناكب القادمة من تحت الأرض؟

10
00:02:09,000 --> 00:02:13,450
لا أبالي لما تزحفون في التُّراب لأجله

11
00:02:14,360 --> 00:02:18,920
البشر والعناكب وهذه المدينة لا يعنون لي شيئاً

12
00:02:18,920 --> 00:02:22,950
لن أقتلك ما لم تحقّق الغرض
بالنّسبة للّهب الخفّاق

13
00:02:24,240 --> 00:02:26,910
أكره الدِّماء

14
00:02:27,240 --> 00:02:29,440
كيف أمكنك قول ذلك؟

15
00:02:29,440 --> 00:02:32,960
كثير من البشر يتأذّون وينزفون

16
00:02:32,960 --> 00:02:34,880
يقاتلون وهم مضرجون بالدِّماء

17
00:02:35,180 --> 00:02:39,130
لكن تريدين أن تبقي في الأعلى فحسب
دون ذرف قطرة واحدة؟

18
00:02:40,400 --> 00:02:43,100
عرفتُ بأنّك سوف تسلّيني

19
00:02:43,500 --> 00:02:46,460
آمل أن تؤدّي آلتك غرضَها

20
00:02:47,030 --> 00:02:50,810
لكن الآن، يجب أن أعود
إلى مُراقبة أبيك بالتبنّي

21
00:02:51,590 --> 00:02:57,480
قد أوجّه سيوف جواسيسي نحو شعبه
،إذا استدعى الأمر ذلك

22
00:02:57,480 --> 00:03:00,740
لكن لا تلُمني إذا خسرتَ منزلك الدّافئ

23
00:03:10,750 --> 00:03:13,840
هل صحيح أنّ الوحوش أصبحوا في الدّاخل؟

24
00:03:13,840 --> 00:03:17,530
وهل هناك سببٌ آخر يدفعهم
لإخلائنا إلى هذا المكان؟

25
00:03:17,530 --> 00:03:19,160
كان جرس الإنذار يرنّ

26
00:03:19,160 --> 00:03:21,740
هربَ الرّاشدون من دوننا

27
00:03:21,740 --> 00:03:24,140
لكن لِمَ لا يمكننا الذّهاب إلى المنزل؟

28
00:03:24,140 --> 00:03:28,120
سيُعيدوننا للعمل حالما يتحقّقون
من أنّ الأوضاع آمنة

29
00:03:26,820 --> 00:03:28,560
هل أنتِ بخير؟

30
00:03:28,930 --> 00:03:32,620
هل أنتِ جريحة؟ من أي مصنع أتيتِ؟

31
00:03:32,620 --> 00:03:34,230
إنّها ليست عاملة

32
00:03:34,230 --> 00:03:36,190
إنّها لا ترتدي زيّاً رسميّاً حتّى

33
00:03:36,480 --> 00:03:39,900
،اصمت. أنت لستَ قائد فريق حتّى
لذا لا تتدخّل

34
00:03:42,260 --> 00:03:45,530
أخفضي صوتكِ. سيوبّخنا الرّئيس من جديد

35
00:03:45,530 --> 00:03:47,230
من تكون؟

36
00:03:47,230 --> 00:03:48,990
ليستْ عاملة، صحيح؟

37
00:03:48,990 --> 00:03:51,750
هل هي طفلة من الأحياء الفقيرة يا تُرى؟

38
00:03:51,750 --> 00:03:54,460
لكن أتَتْ رفقة مجموعة لاجئين، صحيح؟

39
00:03:52,790 --> 00:03:54,460
هل تريدين الخروج؟

40
00:03:55,360 --> 00:03:57,500
لا بدّ أنّها اختلطَتْ بينهم

41
00:03:56,890 --> 00:03:58,170
ما الّذي تنظرون إليه؟

42
00:03:58,170 --> 00:03:59,960
أفسِحوا الطّريق

43
00:03:58,840 --> 00:04:01,870
سمعتُ أنّ صيّادين توجّهوا إلى النّفق
للقضاء على الوحوش

44
00:04:01,870 --> 00:04:04,160
تقصد أنّ الحواجز تحطّمت؟

45
00:04:04,160 --> 00:04:08,810
ستحطّم العناكبُ حواجزَ الآلهة
وتُهاجم من غابة الظّلام

46
00:04:08,810 --> 00:04:12,520
العناكب؟ هل الآلهة ستقاتل العناكب إذاً؟

47
00:04:12,910 --> 00:04:15,150
صيّادو النّار سيقاتلونهم أوّلاً

48
00:04:15,150 --> 00:04:17,530
ألن يفعل البالغون الآخرون شيئاً؟

49
00:04:17,530 --> 00:04:20,030
كيف ننتظر هنا فحسب مكتوفي الأيدي؟

50
00:04:20,030 --> 00:04:24,070
اصمتوا أيُّها التّافهون. لا تتكلّموا
وكأنّكم تفهمون أكثر من غيركم

51
00:04:24,520 --> 00:04:28,090
،إذا ظللنا نعمل في المصانع
سيقتلُنا التلوّث على أي حال

52
00:04:28,090 --> 00:04:30,540
!أفضِّل الموت وأنا أقاتل العناكب

53
00:04:30,880 --> 00:04:35,120
لا تتذاكوا معي! سأرميكم في مكبّ
!النِّفايات إذا استمررتُم في هذا الهُراء

54
00:04:35,120 --> 00:04:39,790
أم تُفضِّلون خدمة الأنفاق حتّى تنحني ظهوركم؟

55
00:04:35,970 --> 00:04:39,790
لم يرَ أحدٌ منهم وحشاً أو عنكبوتاً من قبل

56
00:04:39,790 --> 00:04:43,510
الفتيان الأكبر سنّاً دائماً ما يتشاجرون مع البالغين

57
00:04:43,840 --> 00:04:46,870
لا يجوز أن تخرجا فحسب

58
00:04:47,680 --> 00:04:52,330
.أظنُّ أنّ هذه الفتاة هنا بالخطأ
تقول بأنّها من الأحياء الفقيرة

59
00:04:52,990 --> 00:04:54,490
جُبناء

60
00:04:55,310 --> 00:05:00,200
أخافَهم ذلك لأنّ الأحياء الفقيرة
قيل بأنّها مليئة بالعدوى

61
00:05:00,200 --> 00:05:03,820
لكن كان الأمر أسوأ مع أمّي

62
00:05:03,820 --> 00:05:07,740
لم تعُد قادرة على الكلام بسبب تسمُّم
المصنع. لا يمكنها سوى الأنين

63
00:05:08,920 --> 00:05:12,700
وسوف ينتهي بنا المطاف هكذا عاجلاً أم آجلاً

64
00:05:13,270 --> 00:05:14,760
مثل أمّي تماماً

65
00:05:16,230 --> 00:05:20,170
هل نحن في منطقة مصانع؟

66
00:05:20,170 --> 00:05:24,270
لا، نحن في مطبخ مُشترَك في الحيّ السّكنيّ

67
00:05:24,270 --> 00:05:26,930
لكن لا شيء يُؤكَل هنا الآن

68
00:05:29,510 --> 00:05:31,230
!انظروا إلى هذا

69
00:05:31,230 --> 00:05:32,380
!مُذهل

70
00:05:32,380 --> 00:05:34,890
هل تفعل الآلهة شيئاً؟

71
00:05:34,890 --> 00:05:38,100
!لقد وصلوا. وصلت العناكب

72
00:05:38,400 --> 00:05:40,620
لِمَ أنت سعيد؟

73
00:05:41,750 --> 00:05:44,070
حدّثتني جماعتي عنهم

74
00:05:44,630 --> 00:05:49,180
يُقال بأنّ الآلهة يتركون سموم
المصنع تنتشر عمداً

75
00:05:49,180 --> 00:05:53,450
عندما يصل العناكب، يتمكّن البشر من استخدام
النّار كما في الأيّام الخوالي

76
00:05:53,450 --> 00:05:55,920
سنكون أقوى من الآلهة

77
00:05:55,920 --> 00:05:58,030
أحقّاً هذا؟

78
00:05:58,030 --> 00:06:02,920
،يقول أبي أنّ سُمّ الحشرة يقتلك
فاحرص على ألّا تحترق

79
00:06:03,210 --> 00:06:06,680
سيعتقلك الحرسُ على كلامك هذا

80
00:06:06,680 --> 00:06:10,390
لا تكن أحمق. لا أحد يعود من الموت

81
00:06:10,720 --> 00:06:14,890
اصمتي! أفضِّل الموت من سُمِّ
!حشرة على التسمُّم بسبب مصنع

82
00:06:15,200 --> 00:06:17,400
!كفّوا عن إحداث جلبة

83
00:06:18,350 --> 00:06:21,420
عـ-عـ-على أي حال، ادخلوا جميعاً

84
00:06:24,290 --> 00:06:26,240
لم أكن أملك فكرة

85
00:06:26,740 --> 00:06:31,570
لم أكن أعرف شيئاً عن ماهيّة العاصمة

86
00:06:32,040 --> 00:06:34,950
تقصدين بأنّكِ لستِ من المدينة؟

87
00:07:22,040 --> 00:07:24,910
كون، لا أستطيع تشغيل هذا لوحدي

88
00:07:24,910 --> 00:07:27,420
أحتاج مساعدتك

89
00:07:28,400 --> 00:07:29,160
حسناً

90
00:07:29,840 --> 00:07:34,300
لكن أوّلاً، ثمّة أمر أودُّ إخبارك به

91
00:07:34,600 --> 00:07:38,010
أعلم. الجميع سيموتون، صحيح؟

92
00:07:38,920 --> 00:07:39,910
أجل

93
00:07:40,440 --> 00:07:44,520
لكن سيترتّب عليك استخدام هذا
الشّيء، أليس كذلك؟

94
00:07:47,090 --> 00:07:47,880
أجل

95
00:08:18,350 --> 00:08:19,560
كون، هنا

96
00:08:21,490 --> 00:08:24,270
اسحب تلك العصا الطّويلة تجاهك بأقصى قوّتك

97
00:08:24,270 --> 00:08:25,020
حسناً

98
00:08:42,370 --> 00:08:45,960
أعتقد أنّ الأطفال من المصانع
قد اجتمعوا هنا؟

99
00:08:45,960 --> 00:08:47,380
هل الأوكيبي من أرسلكما؟

100
00:08:47,960 --> 00:08:50,380
من فضلكم استمتعوا بهذا الطّعام معاً

101
00:08:50,380 --> 00:08:52,230
وقت الطّعام جميعاً

102
00:08:53,510 --> 00:08:57,160
شاركونا. هيّا. هذه فُرصتكم
للحصول على طعام

103
00:08:53,950 --> 00:08:54,930
!طعام

104
00:08:54,930 --> 00:08:56,720
!أنا أتضوّر جوعاً

105
00:09:17,680 --> 00:09:20,120
كون، كاناتا، هنا

106
00:09:27,330 --> 00:09:27,750
مصنع تاكيغوتشي

107
00:09:27,330 --> 00:09:27,750
I

108
00:09:27,330 --> 00:09:27,750
II

109
00:09:27,330 --> 00:09:27,750
III

110
00:09:27,750 --> 00:09:28,330
مصنع تاكيغوتشي

111
00:09:27,750 --> 00:09:28,670
I

112
00:09:27,750 --> 00:09:28,670
II

113
00:09:27,750 --> 00:09:28,670
III

114
00:09:28,330 --> 00:09:28,790
مصنع تاكيغوتشي

115
00:09:28,670 --> 00:09:29,960
I

116
00:09:28,670 --> 00:09:29,960
II

117
00:09:28,670 --> 00:09:29,960
III

118
00:09:37,810 --> 00:09:41,100
كون، تكوَّر وأبقِ رأسك مُنخفِضاً

119
00:09:59,740 --> 00:10:01,150
!انظروا، برق

120
00:10:00,460 --> 00:10:01,920
برق؟

121
00:10:01,150 --> 00:10:04,540
!برق مُتشعِّب! ضربَ طرف منطقة المصنع

122
00:10:07,800 --> 00:10:10,000
!كفى بُكاء

123
00:10:08,530 --> 00:10:10,170
...سيّد كوشي

124
00:10:10,170 --> 00:10:13,170
ماذا؟ تعرفين كوشي؟

125
00:10:15,760 --> 00:10:17,760
من أي مصنع هذه الفتاة؟

126
00:10:17,760 --> 00:10:22,840
في الحقيقة، تركتها صيّادة نار
معنا أثناء الإخلاء

127
00:10:31,910 --> 00:10:33,520
!رشقة من المدفع الأوّل

128
00:10:47,670 --> 00:10:49,740
—بسرعة يا كون. لقِّم التّالية

129
00:10:52,240 --> 00:10:54,340
ماذا تفعل؟

130
00:10:57,240 --> 00:11:02,040
لا أصدِّق ذلك. يمكنك جعل البرق
يضرب بواسطة هذه؟

131
00:11:04,790 --> 00:11:07,390
...أنت تستدعي البرق

132
00:11:07,940 --> 00:11:10,560
وتقتل زملائي؟

133
00:11:39,580 --> 00:11:40,470
!ذراعها

134
00:11:44,970 --> 00:11:45,970
!كاناتا

135
00:12:12,410 --> 00:12:14,290
كان ذلك وشيكاً

136
00:12:14,420 --> 00:12:15,420
!روروكو

137
00:12:15,540 --> 00:12:20,510
خلعَتْ مِرفقيها وكتِفيها لتمدّ
ذراعيها الطّويلتين أصلاً

138
00:12:20,510 --> 00:12:21,800
كان من الصّعب قياس مداها

139
00:12:21,920 --> 00:12:23,380
أنت بخير إذاً

140
00:12:24,240 --> 00:12:28,100
أتظنّ أنّ هناك مَن هو بخير في هذه الظُّروف؟

141
00:12:29,160 --> 00:12:30,650
...ذِراعك

142
00:12:32,160 --> 00:12:34,980
بدأتْ تشتعل، فبترتُها بمِنجلي

143
00:12:35,500 --> 00:12:40,650
أولئك الّذين هربوا ذهبوا لحراسة المدفع
الأوّل عند تاكيغوتشي كما خطّطنا

144
00:12:42,120 --> 00:12:46,630
لم يكن هذا الشّيء يُطلِق، لذا
أرسلوني للتحقُّق منه

145
00:12:47,080 --> 00:12:48,280
أين الطّاقم؟

146
00:12:49,000 --> 00:12:54,500
طردَته الآلهة. كان قد غادر عندما وصلتُ إلى هنا

147
00:12:54,500 --> 00:12:57,630
إذاً أطلقت ذلك الشّيء لوحدك؟

148
00:12:58,520 --> 00:13:02,100
لا، هذا الفتى وكاناتا أعاناني

149
00:13:04,470 --> 00:13:06,620
!كم هذا ساخر

150
00:13:06,620 --> 00:13:11,180
لديهم مجموعة من الرّجال البالغين
،يُثيرون جلبة هناك

151
00:13:11,560 --> 00:13:17,870
لكن فتى بنظّارة وطفل وكلب
جعلوا هذا الوحش يصيح

152
00:13:17,870 --> 00:13:20,400
ما الّذي يجري في الخارج؟

153
00:13:21,240 --> 00:13:24,360
خرجت العناكبُ من الأنفاق تحت
الأرض وانتشرت

154
00:13:25,000 --> 00:13:28,740
لا بدّ أنّهم كانوا ينسجون شبكتهم
تحت العاصمة لفترة طويلة

155
00:13:29,520 --> 00:13:35,020
النّارُ قتلَتِ الآلهةَ الّذين ظنّوا
أنّ لديهم أفضليّة عليهم

156
00:13:35,810 --> 00:13:38,460
احترقَ مُعظم صيّادي النّار أيضاً

157
00:13:38,810 --> 00:13:40,420
ماذا عن آكيرا والفتاة؟

158
00:13:40,730 --> 00:13:43,110
غادرت آكيرا نحو القصر الإلهيّ

159
00:13:43,750 --> 00:13:49,190
طلبنا من مجموعة عمّال إخلاء
أن يوصلوا توكو إلى البلدة

160
00:13:55,990 --> 00:13:58,380
أون لن تُقاتل بعد الآن

161
00:13:58,380 --> 00:14:00,470
تعرف هذه العنكبوت؟

162
00:14:00,470 --> 00:14:02,250
كنّا معاً في الغابة

163
00:14:02,250 --> 00:14:05,040
لدى أون مزاج عكِر ولم تكن تلعب معي كثيراً

164
00:14:06,200 --> 00:14:07,400
...أنت

165
00:14:08,180 --> 00:14:12,370
لا أريد بشراً بخلاف ذلك

166
00:14:12,370 --> 00:14:17,370
أنتِ قويّة. كان البشريّ ليموت الآن

167
00:14:17,800 --> 00:14:20,100
لا بدّ أنّها دماء العناكب الإلهيّة

168
00:14:23,080 --> 00:14:29,260
في هذه اللّحظة، زملاؤنا يفتحون بوّابة
الوطن الّذي طُرِدنا منه

169
00:14:29,670 --> 00:14:32,220
اذهب إليهم يا كون

170
00:14:32,220 --> 00:14:36,480
الحشرة الّتي تجعلكم لا تحترقون لا تفلح معي

171
00:14:36,480 --> 00:14:44,900
،لا يهمّ. اذهب وراقب العالم وهو يستعيد نارَه

172
00:14:45,520 --> 00:14:50,220
،والعناكب وهي تحرق الآلهة
،والعشيرة الرّئيسيّة الّتي انحدرنا منها

173
00:14:50,220 --> 00:14:53,530
ومسقط رأسنا

174
00:14:53,910 --> 00:14:55,380
مسقط رأسكم"؟"

175
00:14:56,120 --> 00:14:59,050
كانت العناكب جزءاً من عشيرة النّار

176
00:14:56,120 --> 00:15:04,090
نار

177
00:14:56,120 --> 00:15:04,090
ماء

178
00:14:56,120 --> 00:15:04,090
رياح

179
00:14:56,120 --> 00:15:04,090
أرض

180
00:14:56,120 --> 00:15:04,090
خشب

181
00:14:59,490 --> 00:15:03,290
ألِهذا تركّزين كثيراً على النّار؟

182
00:15:03,170 --> 00:15:19,520
نار

183
00:15:03,990 --> 00:15:09,640
كانت النّار القديمة هي القوّة
الّتي نستحوذ عليها

184
00:15:09,640 --> 00:15:12,430
ورغم أنّ العشيرة الرّئيسيّة الآن
،صارت هي المُتسيِّدة

185
00:15:12,430 --> 00:15:18,920
لا تستطيع حتّى الاقتراب من اللّهب
والّذي هو قوّتهم، ناهيك عن امتلاكها

186
00:15:19,520 --> 00:15:25,400
،ألا يُشعرك هذا بالإحباط؟ أكثر من أي أحد
ينبغي للبشر أن يستعيدوا النّار

187
00:15:25,400 --> 00:15:29,400
أن يعودوا إلى العصر الّذي كانوا
يعتزّون بالتحكُّم بقوّتها

188
00:15:29,400 --> 00:15:33,070
لماذا... لماذا تهتمّين كثيراً بما يفعله البشر؟

189
00:15:33,400 --> 00:15:36,530
توقّف. لا تُزعج نفسك بمُجادلتها

190
00:15:36,530 --> 00:15:40,760
نهاجم العاصمةَ حيث تستقرّ العشائر الإلهيّة

191
00:15:40,760 --> 00:15:44,920
لتحقيق طموحنا العظيم والّذي
هو منح البشريّة النّار

192
00:15:45,310 --> 00:15:48,330
بعد أن قتلتُم الكثير من نفس أولئك البشر؟

193
00:15:48,680 --> 00:15:52,540
تتصرّفون تماماً كشعب العالم القديم

194
00:15:54,110 --> 00:16:00,890
البشر القُدماء دمّروا العالمَ بالنّار
للحصول على ما أرادوه

195
00:16:03,320 --> 00:16:08,980
ألم تقتلوا ما يكفي باستخدام
قوّة وحوش الهواء؟

196
00:16:10,290 --> 00:16:14,440
كبشر العالم القديم

197
00:16:14,440 --> 00:16:20,840
مهما تغيّر العالم، العِرق البشريّ لن يتغيّر أبداً

198
00:16:20,840 --> 00:16:24,500
هذه هي الطبيعة الحقيقيّة للبشر

199
00:16:26,020 --> 00:16:31,070
يستخدم البشرُ النّارَ لصنع
الأشياء ومُقاتلة بعضهم الآخر

200
00:16:31,070 --> 00:16:35,190
ثمّ ينهضون من جديد وسط رماد الدّمار

201
00:16:35,600 --> 00:16:37,920
هكذا ينبغي أن يكون الأمر

202
00:16:37,920 --> 00:16:41,270
هكذا هي طبيعة المخلوقات البشريّة

203
00:16:41,710 --> 00:16:45,860
لذا استرجِعوا النّار

204
00:16:47,360 --> 00:16:49,370
إلى أين نحن ذاهبون؟

205
00:16:49,370 --> 00:16:51,580
سنوصلكِ إلى عقار أوكيبي

206
00:16:51,580 --> 00:16:54,190
لا بدّ أنّكِ رأيتِ كوشي في المصانع

207
00:16:54,190 --> 00:16:55,690
إنّه حيّ، أليس كذلك؟

208
00:16:56,220 --> 00:17:02,370
تركَني مع بعض الأشخاص وذهب
إلى مصنع على ما أعتقد

209
00:17:02,370 --> 00:17:04,110
أتت العناكب

210
00:17:04,110 --> 00:17:07,500
أحضرت العناكبُ ناراً حقيقيّة لإنقاذنا

211
00:17:07,500 --> 00:17:10,380
نار مُطهِّرة، لا نار وحوش قذِرة

212
00:17:12,760 --> 00:17:16,260
!تحرّكوا! وأسرعوا في ذلك

213
00:17:16,260 --> 00:17:19,880
!أفسحوا الطّريق

214
00:17:16,840 --> 00:17:20,510
العناكب سينقذوننا، حتّى بعد أن نموت

215
00:17:20,510 --> 00:17:25,980
!سيحرّروننا من عذاب المصانع وألم الحياة

216
00:17:27,840 --> 00:17:29,980
من صاحبة العكّازة؟

217
00:17:30,710 --> 00:17:34,860
إنّها السيّدة إيبوشي. تُدير معمل الزّراعة

218
00:17:35,900 --> 00:17:39,490
يجب أن تُوقف هذا. لا تذهب

219
00:17:39,490 --> 00:17:42,140
لم تكن الآلهة فحسب

220
00:17:42,140 --> 00:17:45,210
يتدفّقون من الأماكن المُظلمة

221
00:17:45,550 --> 00:17:50,740
فليُرافق أحدٌ السيّدة إيبوشي إلى منزلها

222
00:18:03,300 --> 00:18:05,100
جبانة ضعيفة

223
00:18:11,860 --> 00:18:13,150
توكو؟

224
00:18:13,620 --> 00:18:15,110
مولاتي كيرا

225
00:18:15,490 --> 00:18:18,720
ما الخطب؟ ما الّذي جاء بكِ إلى هنا؟

226
00:18:18,720 --> 00:18:21,500
قالت أنّها كانت في منطقة المصنع مع كوشي

227
00:18:21,910 --> 00:18:25,030
صادفناها في مطبخ عامّ

228
00:18:25,680 --> 00:18:28,710
توكو، لنذهب إلى غرفتي

229
00:18:29,120 --> 00:18:31,600
أحضرا لها لباساً نظيفاً وطعاماً ساخناً

230
00:18:31,600 --> 00:18:33,170
انتظري لحظة

231
00:18:36,360 --> 00:18:37,370
كيرا

232
00:18:38,790 --> 00:18:41,100
نعم يا أمّي

233
00:18:43,980 --> 00:18:47,300
يجب ألّا تقرّري هذه الأمور من تلقاء نفسكِ

234
00:18:48,050 --> 00:18:50,490
سامحيني يا أمّي

235
00:18:54,180 --> 00:18:57,280
ما الّذي تنتظرينه؟ أحضري غيارَ
ملابس لهذه الفتاة

236
00:18:57,710 --> 00:18:58,660
حاضرة

237
00:18:59,700 --> 00:19:01,760
اسمعي جيّداً

238
00:19:01,760 --> 00:19:06,950
دُعي ذلك الفتى إلى منزلنا
لأجل هذه اللّحظة

239
00:19:07,960 --> 00:19:14,020
توقّعَ والدُكِ بأنّ هذا سوف يحدث
واحتفظ بمُساعد بين يديه

240
00:19:14,520 --> 00:19:19,510
،أخذ الفتى كامل راحته في المنزل هنا

241
00:19:19,800 --> 00:19:24,530
لكن لا بدّ أنّه كان على دراية
بهذه المعلومة بحدِّ ذاته

242
00:19:24,530 --> 00:19:26,200
...لذا يا كيرا

243
00:19:27,680 --> 00:19:32,940
أوقفي مشاعركِ الوضيعة تجاه خادم أبيكِ

244
00:19:33,240 --> 00:19:34,200
ماذا؟

245
00:19:45,970 --> 00:19:52,120
كوشي وهيناكو وحتّى كاناتا
في منطقة المصنع غالباً الآن

246
00:19:52,920 --> 00:19:55,160
لم أكن أعلم

247
00:19:55,780 --> 00:19:59,430
كم... كم مضى على حدوث هذا؟

248
00:20:00,190 --> 00:20:01,480
عليّ الذّهاب

249
00:20:01,480 --> 00:20:04,150
عليّ الذّهاب إلى حيث هُم

250
00:20:05,800 --> 00:20:07,140
!كيرا! انتظري

251
00:20:08,890 --> 00:20:09,720
...أنا

252
00:20:09,720 --> 00:20:11,050
!مولاتي كيرا

253
00:20:11,050 --> 00:20:12,710
!آنسة كيرا

254
00:20:41,050 --> 00:20:45,130
يجب أن أصرّ على أن تُرافقتي الآنسة الصّغيرة

255
00:20:47,850 --> 00:20:52,030
وذلك كي يصبح اللّهب الخفّاق سيّدتنا
،الإلاهة الجديدة

256
00:20:52,030 --> 00:20:58,930
يجب أن نختار طفلة بشريّة
كجسدٍ مُضيف مؤقّت

257
00:20:58,930 --> 00:21:06,570
فتاة برّاقة وسليمة صحّياً كالآنسة
كيرا ينبغي أن تؤدّي الغرض جيّداً

258
00:21:09,280 --> 00:21:12,600
كوهاتشي. كنتَ جاسوساً إذاً؟

259
00:21:12,600 --> 00:21:17,170
تظاهرتَ بأنّك بشريّ وتسلّلت
إلى داخل منزلنا أيُّها الوحش

260
00:21:17,170 --> 00:21:19,040
!أعِد إليّ ابنتي

261
00:21:20,800 --> 00:21:23,460
تمّ اختيار عائلة أوكيبي

262
00:21:23,930 --> 00:21:28,140
تمّ اختيارها بواسطة الآلهة لدرء
الهلاك عن عالم البشر

263
00:21:28,140 --> 00:21:30,230
حتّى أنت يا تاكيمي؟

264
00:21:32,800 --> 00:21:36,700
أثبتت هيناكو الصّغيرة أنّها الأنسب

265
00:21:36,700 --> 00:21:40,230
إنّها سلالة جديدة من البشر لا تحتاج ناراً

266
00:21:41,940 --> 00:21:43,780
...أبنتي

267
00:21:43,780 --> 00:21:45,530
!أعِد كيرا إليّ

268
00:21:47,700 --> 00:21:52,460
مع الأسف، هذا ليس وقت التحفُّظات

269
00:21:52,460 --> 00:21:54,070
افهمي من فضلكِ

270
00:21:54,690 --> 00:21:57,540
نفعل هذا من أجل أجيال المستقبل

271
00:21:58,980 --> 00:22:01,540
!كيرا

272
00:22:12,980 --> 00:22:16,300
سآخذك إلى حيث توجد الكلاب