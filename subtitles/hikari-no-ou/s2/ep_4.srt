1
00:00:01,830 --> 00:00:07,060
هجوم العناكب والوحوش يحوّل منطقة
المصنع إلى ساحة معركة

2
00:00:07,060 --> 00:00:13,850
يأتي كونوغي إلى السّطح للإفلات
من انهيار الحيّ المُحرَّم

3
00:00:14,880 --> 00:00:18,700
لدى لقائها مع كاناتا، توكو تبحث عن كوشي

4
00:00:19,080 --> 00:00:25,070
وكذلك كوشي يبحث عنها، عابراً
الأنفاق بمساعدة كون

5
00:00:29,090 --> 00:00:33,840
صيّاد النّار

6
00:01:58,510 --> 00:02:02,060
نار
مُدَّخرة

7
00:02:36,480 --> 00:02:39,160
مع ذلك اشتبكوا مع بعضهم

8
00:02:45,810 --> 00:02:49,890
العشائر الإلهيّة والعناكب والبشر
الّذين يؤمنون بهم

9
00:02:50,380 --> 00:02:53,880
مُعظم صيّادي النّار سقطوا وهم
،يقاتلون أسراباً من الوحوش

10
00:02:53,880 --> 00:02:56,840
البشر الّذين يستخدمون الشّعلة
،السّماويّة دمّروا أنفسهم

11
00:02:56,840 --> 00:03:00,390
وأهل البلدة سيتحوّلون في نهاية
المطاف إلى غوغائيّين عنيفين

12
00:03:02,020 --> 00:03:04,870
،لم نعُد نستطيع إخماد هذه النِّيران

13
00:03:05,620 --> 00:03:11,240
،لأنّه بخلاف النّار العظيمة في الماضي
البشر يُشعلون هذه النّار بأنفسهم

14
00:03:11,830 --> 00:03:16,300
الدّمار آتٍ سواء تصرّفتُ أم لا

15
00:03:16,760 --> 00:03:20,480
لم يبقَ الكثير من البشر والآلهة

16
00:03:20,480 --> 00:03:24,050
أي شخص يستطيع رؤية هذا العالم ينحسر

17
00:03:24,550 --> 00:03:30,650
كان بشر الماضي ليكرِّسوا
،كلّ مهاراتهم في إيجاد حلّ

18
00:03:30,650 --> 00:03:33,630
لكن تفتقر البشريّة للموارد الآن

19
00:03:33,630 --> 00:03:36,550
لهذا سوف نمدّ لكم يد العون

20
00:03:37,460 --> 00:03:39,750
ماذا فعلت لهيناكو؟

21
00:03:40,710 --> 00:03:44,640
كانت السُّموم الصّناعيّة لتسبّب
،لها ألماً أعظم بكثير

22
00:03:44,640 --> 00:03:47,690
ليؤدّي ذلك إلى مقتلها في غضون
عشر دقائق في نهاية المطاف

23
00:03:47,690 --> 00:03:51,240
لكن هيناكو قد تغلّبَتْ على تلك العقبة بالفعل

24
00:03:52,040 --> 00:03:53,080
!كفى هراء

25
00:03:55,220 --> 00:03:56,860
نحن نرفض ذلك

26
00:04:00,680 --> 00:04:02,200
...يكفي

27
00:04:03,590 --> 00:04:07,390
لا تقاتل في حضرة اللّهب الخفّاق

28
00:04:08,850 --> 00:04:13,470
عملك هو إخماد النّار، لا الوقوف والثّرثرة

29
00:04:13,470 --> 00:04:16,040
أنا أتّخذ عملي بجدّية تامّة

30
00:04:16,040 --> 00:04:19,320
مع أنّني أتصوّر بأنّه لن يحقّق نتائج

31
00:04:19,650 --> 00:04:23,780
عليك أن تفهم بأنّ لا وقت لدينا للشّكوى

32
00:04:24,240 --> 00:04:29,240
وكيف فشلنا في كشف العناكب
قبل أن تتأزّم الأوضاع؟

33
00:04:29,830 --> 00:04:33,640
أعتقد بأنّ المعلومات الاستخباراتيّة تندرج
تحت سلطة عشيرة الرّياح

34
00:04:34,220 --> 00:04:39,060
أم أنّ شخصاً كان يخفي نشاطاً مشبوهاً ما؟

35
00:04:39,760 --> 00:04:41,480
دعه يذهب الآن

36
00:04:43,960 --> 00:04:46,550
...ماذا فعلتم؟ ولا أقصد لهيناكو فقط

37
00:04:46,550 --> 00:04:51,820
ماذا فعلتُم لخدم أوكيبي؟ للبشر؟

38
00:04:51,820 --> 00:04:57,690
نحن من عشيرة الرّياح تصرّفنا فقط بناء
على رغبتنا في مساعدة البشريّة على النَّجاة

39
00:04:58,390 --> 00:05:04,070
بخلاف العشائر الأخرى، لا نرضى بالجلوس
مكتوفي الأيدي منتظرين مُذنّب الألفيّة

40
00:05:04,410 --> 00:05:08,680
بالطّبع، محاولاتنا في إعادة صنع
الأجساد واجهت عقبات عديدة

41
00:05:09,450 --> 00:05:13,420
لكن بمساعدة رعيّة رائعة، أتقنّا الصِّيغة بشكل كامل

42
00:05:14,240 --> 00:05:22,490
صنعنا جنساً بشريّاً جديداً. جنس
يعيش في الظّلام دون الحاجة لنار

43
00:05:23,710 --> 00:05:27,150
كيف تعبثون مع النّاس هكذا؟

44
00:05:27,150 --> 00:05:31,350
لِمَ تفعلون المستحيل لإبقائنا أحياء؟

45
00:05:31,350 --> 00:05:35,860
لأنّ تقديم تضحيات الآن سيُثبِت
منافعه على المدى البعيد

46
00:05:36,760 --> 00:05:41,740
أيّتها اللّهب الخفّاق، يبدو أنّكِ ترفضين
أن تصبحي السيّدة الإلاهة الجديدة

47
00:05:41,740 --> 00:05:45,470
لكن بما أنّه لم تولد سيّدة ملائمة
،في كنف العشائر الإلهيّة

48
00:05:45,470 --> 00:05:48,070
أنتِ الوحيدة القادرة على خِلافة هذه المسؤوليّة

49
00:05:48,660 --> 00:05:51,080
هل سأصبح مثل تايورا؟

50
00:05:52,040 --> 00:05:56,370
ماذا سيحدث لتايورا إذا خلفتُها؟

51
00:05:56,810 --> 00:06:01,910
عشيرة الأرض اختارَتْ مُضيفاً من بين البشر

52
00:06:02,320 --> 00:06:06,590
يخطّطون لإسقاطكِ كسيّدة إلاهة
بالقوّة إن لَزِمَ الأمر

53
00:06:06,590 --> 00:06:11,600
أختي، عليكِ ألّا تصغي لهذه الثّرثرة

54
00:06:17,430 --> 00:06:20,010
!يا أخي. أخي

55
00:06:20,010 --> 00:06:21,610
هل أنت بخير؟

56
00:06:22,400 --> 00:06:23,610
أجل

57
00:06:23,610 --> 00:06:24,680
أين نحن؟

58
00:06:25,470 --> 00:06:28,900
هل ارتطام رأسك جعلك ترى كابوساً؟

59
00:06:29,460 --> 00:06:31,360
أعلم بأنّك أنت من أراني ذلك

60
00:06:31,360 --> 00:06:33,690
فكِّر كما تريد

61
00:06:34,470 --> 00:06:36,060
انسَ أمره يا كون

62
00:06:36,520 --> 00:06:41,180
.إنّ التجوُّل سوف يؤدّي إلى مقتلك
ما زالت الحرائق تشتعل هنا وهناك

63
00:06:42,340 --> 00:06:45,210
الفتاة مع الكلب من ذاك الاتِّجاه

64
00:06:45,210 --> 00:06:46,520
توكو؟

65
00:06:47,650 --> 00:06:53,180
عشيرة الماء تخمد النّيران، لكن لا بدّ
أنّه يوجد عناكب في الأرجاء أيضاً

66
00:06:53,180 --> 00:06:54,850
لذا كُن حذراً

67
00:06:55,230 --> 00:06:57,060
ما هو "المُضيف"؟

68
00:06:57,670 --> 00:07:01,210
بشريّ يستضيف اللّهبَ الخفّاق

69
00:07:01,210 --> 00:07:02,400
يستضيفها لها؟

70
00:07:03,090 --> 00:07:06,860
اختاروا ابنة والديك بالتبنّي

71
00:07:06,860 --> 00:07:08,410
كيرا؟

72
00:07:08,410 --> 00:07:12,510
احتاجا فتاة ثريّة غير مُلوّثة بالمُخلّفات السامّة

73
00:07:12,510 --> 00:07:16,830
فتاة ملائمة جسديّاً وعقليّاً لتكون السيّدة الإلاهة

74
00:07:16,830 --> 00:07:19,130
المرشّحون قليلون

75
00:07:19,790 --> 00:07:22,720
لا بدّ أنّك تمتلك فكرة ما

76
00:07:22,720 --> 00:07:25,740
،بمعزل عن الطّبيب الّذي سمّى نفسه تاكيمي

77
00:07:25,740 --> 00:07:29,560
ثمّة إله آخر تردّد على منزل أوكيبي

78
00:07:29,560 --> 00:07:32,590
تظاهر بأنّه معلّم بشريّ

79
00:07:33,840 --> 00:07:36,300
لم تشكّك به أبداً؟

80
00:07:36,720 --> 00:07:41,220
حسناً، مهما كنتَ لامع الذّكاء، تبقى بشريّاً

81
00:07:41,810 --> 00:07:46,570
أو ربّما ينبغي أن أمدح العجوز على تنكُّره

82
00:07:51,640 --> 00:07:54,170
متى غادر؟

83
00:07:54,680 --> 00:07:56,530
لم أشح بنظري عنه

84
00:08:56,390 --> 00:08:57,510
!كون

85
00:08:57,940 --> 00:08:59,220
!أختي

86
00:09:04,140 --> 00:09:05,820
!أختي

87
00:09:05,820 --> 00:09:06,560
!كون

88
00:09:16,860 --> 00:09:18,710
سيّد كوشي

89
00:09:23,870 --> 00:09:26,630
...أنا آسف. أنا... أنا

90
00:09:27,260 --> 00:09:31,980
كنتُ أعمل كالمجنون لأسبّب هذا الرُّعب

91
00:09:31,980 --> 00:09:36,490
بالشّعلة السّماويّة الّتي تركها
،أبي وبنفوذ عائلة أوكيبي

92
00:09:36,940 --> 00:09:40,890
أقنعتُ نفسي بأنّني أستطيع
حماية هذه المدينة

93
00:09:40,890 --> 00:09:44,040
انتهى المطاف بصنعي أسلحة فظيعة

94
00:09:44,930 --> 00:09:46,710
حماية المدينة؟

95
00:09:47,560 --> 00:09:51,520
كوّمتُ جثثاً محترقة فحسب

96
00:10:01,400 --> 00:10:03,080
آلهة؟

97
00:10:16,160 --> 00:10:17,970
يا له من مشهد عظيم

98
00:10:22,900 --> 00:10:24,310
يوشيتشي

99
00:10:24,930 --> 00:10:30,440
لماذا أنت هنا؟ وما هذا الدّماء؟

100
00:10:31,880 --> 00:10:38,450
الآلهة يحكمون البشر، مع ذلك يكرهون
الدّماء في عروقنا ويعتبرونه غير طاهر

101
00:10:41,990 --> 00:10:46,120
رغم ذلك، يبدو أنّ البرق
لا يضرب إلّا العناكب

102
00:10:46,880 --> 00:10:50,060
أتمنّى لو كان يقتل الآلهة أيضاً

103
00:10:51,790 --> 00:10:55,520
يذكّرني هذا بالنّار العظيمة

104
00:10:55,520 --> 00:11:00,310
،الجثث الّتي تفرش الأرض
...ورائحة التفحّم في الهواء

105
00:11:00,950 --> 00:11:04,270
احترقَتْ أمّي آنذاك

106
00:11:04,270 --> 00:11:08,640
ساعدَتْني في دخول قناة قبل أن تحترق

107
00:11:08,640 --> 00:11:12,770
،دامت رائحة البشر المحترقين لأيّام
بل لأسابيع حتّى

108
00:11:13,680 --> 00:11:20,680
الأطفال الّذين كانوا قد فقدوا طعامهم ومنازلهم لم يكن
أمامهم خيار سوى البحث عن طعام بين النّفايات

109
00:11:21,610 --> 00:11:27,050
سأدع أولئك الآلهة المغرورين
يشعرون بغضب البشريّة

110
00:11:27,050 --> 00:11:32,260
هذا كلّ ما عشتُ لأجله منذ
نجاتي من النّار العظيمة

111
00:11:34,100 --> 00:11:37,780
لم أعد بحاجة خدماتك

112
00:11:38,960 --> 00:11:43,060
استخدم هذا النّفق للهرب إلى حيث تشاء

113
00:11:43,590 --> 00:11:45,030
سيّدي

114
00:11:53,310 --> 00:11:57,790
حاول أن تنجو، مثلما فعلتُ أنا

115
00:12:10,950 --> 00:12:12,560
!تيماري

116
00:12:12,560 --> 00:12:15,360
آنسة آكيرا؟ هل أنتِ هناك؟

117
00:12:29,370 --> 00:12:31,340
!آنسة آكيرا

118
00:12:31,340 --> 00:12:32,680
!أختي

119
00:12:36,330 --> 00:12:37,740
أين آكيرا؟

120
00:12:37,740 --> 00:12:40,030
إنّها ليست هنا. تيماري فقط

121
00:12:44,280 --> 00:12:45,580
...آكيرا

122
00:12:51,950 --> 00:12:55,500
انفصلَتْ آكيرا عن تيماري

123
00:12:56,290 --> 00:12:59,230
وما زلنا لا نعرف أين هيناكو

124
00:12:59,230 --> 00:13:01,340
المعذرة يا سيّد كوشي

125
00:13:01,840 --> 00:13:05,970
أعتقد هيناكو في محطّة إغاثة
في منطقة المصنع

126
00:13:06,450 --> 00:13:07,160
ماذا؟

127
00:13:07,160 --> 00:13:13,430
إنّها تساعد الآنسة كيري من قوم الشّجر
على مُعالجة صيّادي النّار الّذين تأذّوا

128
00:13:13,430 --> 00:13:17,150
إلاهة أخبرَتْني بذلك

129
00:13:17,910 --> 00:13:19,860
من العشائر الإلهيّة؟

130
00:13:20,280 --> 00:13:22,280
أخافَتْني

131
00:13:22,720 --> 00:13:27,500
واحدة من قوم الشّجر في الحيّ المُحرّم
قالت بأنّها الإلاهة الّتي صنعتهم

132
00:13:27,500 --> 00:13:31,660
إلاهة"؟ لا شيء مُقدّس فيهم"

133
00:13:32,090 --> 00:13:36,780
هيناكو، قوم الشّجر من الحيّ المُحرّم، والآن كيرا

134
00:13:37,750 --> 00:13:39,750
يُعاملوننا كفئران تجارب

135
00:13:40,130 --> 00:13:42,200
آنسة كيرا؟

136
00:13:43,370 --> 00:13:45,400
تمّ اختيار كيرا كمُضيف

137
00:13:45,400 --> 00:13:47,040
ماذا يعني؟

138
00:13:47,040 --> 00:13:49,980
يبدو وكأنّ السيّدة الإلاهة تلتقط أنفاسها الأخيرة

139
00:13:49,980 --> 00:13:54,560
لذلك تريد العشائر الإلهيّة إخماد
اللّهب الخفّاق داخل كيرا

140
00:13:54,560 --> 00:13:56,410
لجعلها السيّدة الإلاهة الجديدة

141
00:13:56,410 --> 00:13:58,400
وضع إلاهة داخلها؟

142
00:13:59,280 --> 00:14:03,400
هذا يُثبت كم أنّ البشر لا يعنون لهم شيئاً

143
00:14:03,400 --> 00:14:07,740
لا يأبهون لما نفكّر فيه أو نشعر به

144
00:14:10,470 --> 00:14:13,450
لماذا يا سيّد كوشي؟

145
00:14:13,960 --> 00:14:19,210
لطالما قالت جدّتي بأنّ صيّادي النّار
جعلوا العالمَ مكاناً أفضل

146
00:14:19,910 --> 00:14:26,760
كان البشر يعيشون في الغابة ويختبئون
من الوحوش دون قرى أو منازل

147
00:14:27,430 --> 00:14:34,330
لم يكن لدينا نار، لذا لم يكن لدينا شيء
لنأكله، وكثير من النّاس ماتوا من الجوع

148
00:14:36,240 --> 00:14:41,480
أتمنّى لو لم تعيشي هذه الظّروف يا توكو

149
00:14:41,480 --> 00:14:46,990
لو بقيتِ في قريتكِ، لما تعرّضتِ
على الأقلّ لهذا الخطر الكبير

150
00:14:46,990 --> 00:14:51,620
لكن لو بقيتُ في المنزل لما عرفتُ شيئاً

151
00:14:51,620 --> 00:14:59,990
ما كنتُ لألتقي بكاهو والسيّد شوزو
وهوتارو وبينيو والآنسة آكيرا

152
00:15:00,700 --> 00:15:03,840
اذهب وابحث عن هيناكو يا سيّد كوشي

153
00:15:03,840 --> 00:15:07,840
سأبحث عن الآنسة آكيرا وأذهب
إلى القصر معها

154
00:15:11,030 --> 00:15:12,940
لا، سأذهب معك

155
00:15:13,350 --> 00:15:14,760
...لكن

156
00:15:14,760 --> 00:15:18,750
لا عليكِ. ستكون هيناكو أكثر
،أماناً مع قوم الشّجر

157
00:15:18,750 --> 00:15:22,120
...ولن تضطرّ للقتال أو أذيّة الآخرين

158
00:15:22,920 --> 00:15:25,320
أو القتل ثانية

159
00:15:28,530 --> 00:15:30,810
يجدر بنا أن نبقى جميعاً معاً من الآن فصاعداً

160
00:15:41,740 --> 00:15:44,170
لكن من أي طريق نتّجه؟

161
00:15:48,930 --> 00:15:50,140
...هذا الشّيء

162
00:15:50,800 --> 00:15:54,440
كان بالقرب من مدخل النّفق قبل قليل أيضاً

163
00:15:55,050 --> 00:15:56,250
ماذا؟

164
00:15:57,080 --> 00:16:00,730
هل يحاول شخصٌ أن يرشدنا؟

165
00:16:00,730 --> 00:16:01,770
ماذا؟

166
00:16:04,040 --> 00:16:05,910
السيّدة لهب خفّاق؟

167
00:16:08,920 --> 00:16:10,580
أعتقد يجب علينا اتّباعه فحسب

168
00:16:29,960 --> 00:16:34,630
يبدو هذا كمُنشأة لتطهير مياه
المجاري وإرسالها إلى مكان ما

169
00:16:36,400 --> 00:16:37,380
!ماء

170
00:16:38,440 --> 00:16:39,810
لنأخذ استراحة

171
00:16:40,210 --> 00:16:43,270
بوسعنا استخدام بعض الماء أيضاً

172
00:16:44,610 --> 00:16:45,770
سيّد كوشي

173
00:16:46,880 --> 00:16:48,830
ما هو اللّهب الخفّاق؟

174
00:16:48,830 --> 00:16:50,410
لا أدري

175
00:16:50,410 --> 00:16:56,780
،كانت تُدعى بمُذنّب الألفيّة
...طفلة النّجم، الدُّمية الميكانيكيّة

176
00:16:57,720 --> 00:17:00,410
هل تعتقد بأنّها إلاهة حقّاً؟

177
00:17:00,950 --> 00:17:05,420
صحيح. قلتِ أنّ اللّهب الخفّاق
تدلّنا إلى الطريق قبل قليل

178
00:17:06,020 --> 00:17:11,130
لستُ متأكّدة، لكن أشعر وكأنّني
التقيتُ بها كثيراً في أحلامي

179
00:17:11,540 --> 00:17:13,000
في أحلامكِ؟

180
00:17:13,670 --> 00:17:16,490
هذا ما فعلوه بي

181
00:17:17,620 --> 00:17:20,970
،أوشك العالم أن ينتهي بسبب التلوُّث والحروب

182
00:17:20,970 --> 00:17:25,480
وتمّ إرسالي لإنقاذه من السّماء

183
00:17:25,480 --> 00:17:29,860
للبحث عن أشخاص احتاجوا للمساعدة من المدار

184
00:17:31,020 --> 00:17:33,360
مستوطنات معزولة

185
00:17:33,360 --> 00:17:35,260
جنود عالقون

186
00:17:35,740 --> 00:17:38,730
أطفال وماشية مدفونون أحياء

187
00:17:38,730 --> 00:17:41,530
مُشرّدون فقدوا منازلهم

188
00:17:44,000 --> 00:17:45,720
أخافني ذلك

189
00:17:46,310 --> 00:17:50,310
الأشخاص الّذين كان ينبغي أن يتمّ
إنقاذهم ظلّوا يحتضرون للموت

190
00:17:50,780 --> 00:17:55,370
الأشخاص الّذين كان ينبغي أن ينقذوهم
قتلوا آخرين غيرهم بدلاً من ذلك

191
00:17:55,880 --> 00:18:01,030
بدا وكأنّ الكوكب كان يخنق نفسه

192
00:18:02,010 --> 00:18:07,120
لم تبقَ أي مُنشأة تقريباً لتلقّي إشاراتي

193
00:18:07,120 --> 00:18:12,020
،حتّى عندما وصلَ نداء استغاثة
لم يبقَ أحدٌ ليقدّم المساعدة

194
00:18:13,160 --> 00:18:15,080
لم أرد أن أكتفي بالمشاهدة

195
00:18:15,940 --> 00:18:19,480
لم أرد أن أراقب من الأعلى في السّماء

196
00:18:20,880 --> 00:18:23,750
لم أقصد العودة

197
00:18:24,320 --> 00:18:28,220
ما كانت عودتي لتعني شيئاً

198
00:18:28,960 --> 00:18:35,880
لكن تمّ تصميمي بحيث لا أستطيع تغيير ذلك
بنفسي، رغم مُحاولاتي لفترة طويلة

199
00:18:36,240 --> 00:18:39,390
لم أستطع تعديل التّعليمات في داخلي

200
00:18:39,390 --> 00:18:41,220
لذلك عدتُ

201
00:18:43,380 --> 00:18:44,490
توكو

202
00:18:44,490 --> 00:18:45,510
!توكو

203
00:18:49,000 --> 00:18:55,020
توكو، التقيتِ باللّهب الخفّاق، أليس كذلك؟
ماذا قالت؟

204
00:18:55,020 --> 00:19:01,640
حاولتْ "تعديل التّعليمات" في داخلها
لكن لم تستطع

205
00:19:01,640 --> 00:19:02,820
أي تعليمات؟

206
00:19:03,400 --> 00:19:08,110
قالت بأنّها لا تستطيع تغيير ذلك
بنفسها. لقد صُمِّمَتْ لتكون كذلك

207
00:19:08,110 --> 00:19:10,330
ولهذا عادَتْ

208
00:19:10,330 --> 00:19:12,040
لا تستطيع تعديلها؟

209
00:19:19,990 --> 00:19:21,390
ما الّذي عثرا عليه؟

210
00:19:21,390 --> 00:19:22,640
لستُ أدري

211
00:19:25,440 --> 00:19:27,040
جاسوس؟

212
00:19:27,040 --> 00:19:30,350
لا، لا يعملون في الماء

213
00:19:39,530 --> 00:19:40,780
!كون

214
00:19:46,270 --> 00:19:47,230
!كون

215
00:19:47,230 --> 00:19:48,950
!توكو! احذري

216
00:19:59,860 --> 00:20:01,930
...ما-ما الّذي

217
00:20:01,930 --> 00:20:03,220
جواسيس؟

218
00:20:15,430 --> 00:20:16,770
شخص؟

219
00:20:42,520 --> 00:20:43,840
كم هذا مُزعج

220
00:20:44,400 --> 00:20:46,890
،عادت اللّهبُ الخفّاقُ إلى الدِّيار

221
00:20:48,390 --> 00:20:50,460
مع ذلك، العرقلات لا تتوقّف أبداً

222
00:20:51,390 --> 00:20:53,590
أنت ذلك الإله

223
00:20:56,500 --> 00:21:00,060
هيباري، لماذا أنقذتنا؟

224
00:21:00,570 --> 00:21:04,320
تعلّم أن تتوخّى بعض الحذر

225
00:21:04,320 --> 00:21:06,360
أنت لست سوى بشريّ

226
00:21:06,820 --> 00:21:08,530
!وهم كانوا كذلك

227
00:21:08,830 --> 00:21:10,740
ليسوا بشراً

228
00:21:10,740 --> 00:21:14,500
!بلى! العشائر الإلهيّة تُعيد صنعهم فحسب

229
00:21:14,830 --> 00:21:16,750
ماذا لو فعلنا إذاً؟

230
00:21:16,750 --> 00:21:19,930
هل ستتخلّى عن الطّفل العنكبوت
لإنقاذ أولئك البشر؟

231
00:21:20,710 --> 00:21:25,430
تتحكّم عشيرةُ الماء بهؤلاء المخلوقات

232
00:21:25,820 --> 00:21:30,180
أفلتوهم داخل الممرّات المائيّة
لقتل العناكب حالما يرصدونهم

233
00:21:30,820 --> 00:21:34,680
،وحتّى لو كنتُ قد عفوتُ عنهم
لن يسترجعوا بشريّتهم أبداً

234
00:21:37,640 --> 00:21:39,940
أين اختفت اللّهبُ الخفّاق؟

235
00:21:40,520 --> 00:21:43,740
إلى باقي العشائر الإلهيّة

236
00:21:44,340 --> 00:21:46,700
ما زالت اللّهب الخفّاق مُتردِّدة

237
00:21:47,280 --> 00:21:50,980
،الخيار لها

238
00:21:51,870 --> 00:21:55,780
لكن مهما كان قرارها الأخير، يجب أن يكون مُرضياً

239
00:21:56,310 --> 00:21:59,120
يمكنكم بلوغ مستوى أعمق حتّى من هنا

240
00:21:59,120 --> 00:22:01,160
سيؤدّي بكم إلى منحدر

241
00:22:01,670 --> 00:22:04,570
استمرّوا في التقدُّم حتّى تصلوا إلى القصر

242
00:22:05,640 --> 00:22:08,840
لا تهدروا التّوجيه الّذي منحَتْكم إيّاه اللّهبُ الخفّاق

243
00:22:15,410 --> 00:22:18,550
...القرار الأخير للّهب الخفّاق

244
00:23:49,990 --> 00:23:53,530
الحلقة القادمة

245
00:23:56,950 --> 00:24:00,000
بحر الأشجار