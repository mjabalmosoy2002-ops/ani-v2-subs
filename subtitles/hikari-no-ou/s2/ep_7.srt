1
00:00:02,070 --> 00:00:11,450
الإنسان الشّجرة العملاق، كونوغي، يضحّي
بحياته لنقل كوشي وهيناكو إلى القصر الإلهيّ

2
00:00:12,590 --> 00:00:17,240
:وينتظرهم الرّجل الّذي غيّرَتْ تجاربه هيناكو

3
00:00:17,240 --> 00:00:26,180
،طبيب عائلة أوكيبي، تاكيمي
والّذي تبيّن بأنّه إله

4
00:00:31,090 --> 00:00:35,840
صيّاد النّار

5
00:01:58,510 --> 00:02:02,060
الفتاة الفارغة

6
00:02:04,990 --> 00:02:06,180
...أنت

7
00:02:07,820 --> 00:02:13,780
،أعي بأنّ هذا الزيّ لا يلائمني
لكنّه مُتعارف عليه في القصر

8
00:02:15,060 --> 00:02:20,200
لا تقلق. ستتعافى رعيّة التّجربة قريباً

9
00:02:22,070 --> 00:02:23,260
!تاكيمي

10
00:02:24,970 --> 00:02:28,060
من فضلك أعطني الرّعيّة

11
00:02:33,980 --> 00:02:38,720
لا يمكنك خداعنا نحن الآلهة بدُمية كهذه

12
00:02:39,890 --> 00:02:43,180
إيّاك وفعل شيء آخر لهيناكو

13
00:02:43,950 --> 00:02:48,680
هربت تلك الطّفلة من الموت
الّذي كان يحدّق في وجهها

14
00:02:49,350 --> 00:02:53,720
إنّها حاليّاً تستجيب بصورة سلبيّة لتحوُّلها

15
00:02:53,720 --> 00:02:57,070
أريد استخدام دواء لمعالجة ألمها

16
00:02:57,870 --> 00:02:59,030
!هذا كذب

17
00:03:00,090 --> 00:03:02,770
سوف أحقنك أيضاً

18
00:03:03,780 --> 00:03:10,710
رغم ولادتك من نفس الرّحم، يبدو
أنّك تجنّبت العدوى الجنينيّة

19
00:03:11,420 --> 00:03:16,390
لكن من الآن فصاعداً، يمكنك
مُشاركة ألم أختك

20
00:03:17,800 --> 00:03:21,570
وكيرا؟ ماذا عن كيرا؟

21
00:03:21,960 --> 00:03:24,390
ابنة أوكيبي؟

22
00:03:24,900 --> 00:03:28,170
،كنتُ لأحبّذ إجراء تجربة عليها أيضاً

23
00:03:28,170 --> 00:03:33,180
لكن وضعتْ عشيرةُ الأرض نصب
أعينهم عليها أوّلاً

24
00:03:33,930 --> 00:03:39,900
كنتُ لأتقن عقّاري في وقتٍ أبكر
بكثير لو كانَتْ هي رعيّة تجاربي

25
00:03:42,220 --> 00:03:47,860
لا يسير البحث بسلاسة عندما تعمل
عليها مجموعات كثيرة

26
00:03:48,690 --> 00:03:51,660
أنا متأكّد بأنّك توافقني

27
00:03:53,640 --> 00:04:00,210
،إذا لم أستطع الحصول على العاصمة
فسوف أقيم تجاربَ على قرية كاملة ما

28
00:04:01,770 --> 00:04:07,210
إذا استطعتُ إثبات جدوى الحياة
،من دون نار الوحوش

29
00:04:08,260 --> 00:04:13,300
سأتمكّن من إنقاذ كلّ بشريّ
في هذا البلد يوماً ما

30
00:04:33,970 --> 00:04:34,920
!ميزوري

31
00:04:38,040 --> 00:04:39,880
!مخلوق دنيء

32
00:04:52,940 --> 00:04:54,170
ماذا عن روروكو؟

33
00:04:55,510 --> 00:04:59,230
ميزوري، أين روروكو؟ أين روروكو الآن؟

34
00:04:59,910 --> 00:05:05,490
أجل. صيّاد النّار المُتجوّل ذاك
أبقى كلب الصّيد هذا معه

35
00:06:00,280 --> 00:06:01,130
!كيرا

36
00:06:02,860 --> 00:06:05,380
أهذا هو اسم هذه الفتاة؟

37
00:06:06,910 --> 00:06:11,260
لا بدّ أنّكما صديقان

38
00:06:12,470 --> 00:06:14,340
لكن سامحني

39
00:06:15,330 --> 00:06:17,940
لستُ كيرا

40
00:06:19,290 --> 00:06:23,940
أنا في داخلها الآن فحسب

41
00:06:26,500 --> 00:06:27,820
اللّهب الخفّاق؟

42
00:06:56,010 --> 00:06:59,180
هل هذا... السيّد كونوغي؟

43
00:07:00,700 --> 00:07:03,580
هل هذا إنسان شجرة؟

44
00:07:19,390 --> 00:07:20,460
آنسة كيري

45
00:07:21,710 --> 00:07:23,050
!كوني حذرة

46
00:07:23,050 --> 00:07:24,180
!آنسة كيري

47
00:07:34,580 --> 00:07:36,350
!آنسة كيري

48
00:07:40,750 --> 00:07:42,020
في الأعلى

49
00:07:42,420 --> 00:07:46,980
!آنسة كيري، لا أستطيع... لا أستطيع سماعكِ

50
00:07:49,350 --> 00:07:56,290
عبرَتْ مجموعةُ كوشي جسد إنسان الشّجرة
هذا إلى القصر في الطّرف الأقصى؟

51
00:07:57,720 --> 00:07:59,230
توكو. كون

52
00:08:00,090 --> 00:08:02,520
سنذهب إلى القصر أيضاً

53
00:08:09,750 --> 00:08:13,310
أصدقاؤكم سبقوكم

54
00:08:15,220 --> 00:08:19,220
هل ستُنجِبون سيّد صيّادي النّار؟

55
00:08:19,770 --> 00:08:25,830
إذاً اطلبوا المغفرة. فاللّهب الخفّاق
سوف تحرق هذا الكوكب قريباً

56
00:08:25,830 --> 00:08:30,340
كوني سيّد النّار واطلبوا معفرة طفل النّجم

57
00:08:35,390 --> 00:08:36,910
إنّها غاضبة

58
00:08:37,480 --> 00:08:40,130
هذه الفتاة مُستشيطة غضباً

59
00:08:41,170 --> 00:08:45,420
نتيجة غضبها الشّديد، لا تستطيع البقاء ثابتة

60
00:08:46,540 --> 00:08:49,770
أعيدوني إلى جسدي القديم

61
00:08:51,250 --> 00:08:54,380
وجودي في هذا يُشعرني بالبؤس

62
00:08:56,020 --> 00:09:02,710
وإذا استمرّ هذا، لن يصمد جسدُ
هذه الفتاة أيضاً

63
00:09:06,920 --> 00:09:10,510
هل تلك كيرا؟ أقصد، "المُضيف"؟

64
00:09:10,510 --> 00:09:16,590
فُتِحَتْ خمسة شقوق لإدخال
الرُّوح، ثمّ تمّ إحكام إغلاقها

65
00:09:17,470 --> 00:09:19,410
هذا من صنيع عشيرة الأرض

66
00:09:20,110 --> 00:09:22,040
وضعوا روحها داخل كيرا؟

67
00:09:22,420 --> 00:09:27,230
اللّهب الخفّاق تسكن داخل الفتاة
الّتي جُعِلَتْ مُضيفاً لها

68
00:09:28,600 --> 00:09:30,540
هذا هو اللّهب الخفّاق

69
00:09:31,620 --> 00:09:38,490
لعلّها لا تزال قادرة على الإفلات من مُضيفها
والعودة إلى مُذنّب الألفيّة

70
00:09:39,380 --> 00:09:44,490
لكن ستحتاج لمساعدة عشيرة
الأرض من أجل فعل ذلك

71
00:09:44,490 --> 00:09:45,350
...كيرا

72
00:09:46,890 --> 00:09:50,380
اللّهب الخفّاق، ينبغي أن تختاري

73
00:09:50,910 --> 00:09:56,900
لا أحد لديه قوّة إيقاف قراركِ على أيّ حال

74
00:09:59,300 --> 00:10:00,500
أختار؟

75
00:10:02,120 --> 00:10:04,460
اخترتُ منذ زمن بعيد

76
00:10:06,310 --> 00:10:14,350
عندما غادرتُ الأرض، اخترتُ عدم
العودة حتّى أصبح غُباراً لوحدي

77
00:10:15,560 --> 00:10:19,510
بغضّ النّظر، يجب ألّا تخرجي من هنا

78
00:10:19,990 --> 00:10:22,930
مُضيفتكِ لم تستقرّ بعد

79
00:10:23,800 --> 00:10:27,430
،إذا ضغطتِ على نفسكِ كثيراً
فسوف تموتين معها

80
00:10:27,960 --> 00:10:30,400
ادخلي القصر حاليّاً

81
00:10:30,820 --> 00:10:32,910
كفى كلاماً

82
00:10:38,690 --> 00:10:39,610
!هيباري

83
00:10:40,680 --> 00:10:45,740
ماذا؟ ظننتُك مشغولاً بالمُتمرّدين البشر

84
00:10:46,780 --> 00:10:49,860
وماذا عنك؟

85
00:10:50,520 --> 00:10:55,460
كيف تجرؤ على سفك الدّماء بمُقاتلة
حيوان أمام السيّدة الإلاهة؟

86
00:10:56,920 --> 00:11:00,040
لن تطأ قدمُك القصر حتّى يُطهَّر هذا الدِّماء

87
00:11:01,170 --> 00:11:02,910
أوجِّه نفس الكلام لك

88
00:11:03,350 --> 00:11:09,330
،سمعتُ أنّ أوكيبي وخادمه، الخائنان المُدنّسان

89
00:11:09,330 --> 00:11:12,090
قد دخلا القصر

90
00:11:12,730 --> 00:11:17,570
من المؤكّد أنّ عشيرة الرّياح تتحمّل
لوم إهمال مثل هؤلاء المُنتهكين؟

91
00:11:18,230 --> 00:11:26,790
"أبقَتْ عشيرةُ الماء "رعايا التّجارب
في القصر وفقدت السّيطرة عليهم

92
00:11:27,190 --> 00:11:29,860
ارموهم في الخارج حالاً

93
00:11:30,440 --> 00:11:36,750
وإلّا سوف أبيدهم حتّى آخر قطرة دم

94
00:11:37,900 --> 00:11:42,300
كفّوا عن العبث بالبشر

95
00:11:43,110 --> 00:11:46,220
سئمتُ من كلّ هذا

96
00:11:47,450 --> 00:11:48,680
أختي

97
00:11:49,580 --> 00:11:54,150
الوقت يُداهمنا. عودي إلى السيّدة
تايوراهيمي من فضلكِ

98
00:11:55,180 --> 00:12:02,360
داخل ذلك القصر، يستعدّون لوضعي
على عرش السيّدة الإلاهة

99
00:12:03,050 --> 00:12:06,620
وزرع أوامر في داخلي لا أستطيع مسحها

100
00:12:07,900 --> 00:12:13,540
أعلم أنّ لديهم مكان لكتابة أوامر داخل رأسي

101
00:12:13,940 --> 00:12:18,700
لا أريدكِ أن تصبحي دُمية
للعشائر الإلهيّة يا أختي

102
00:12:19,260 --> 00:12:21,530
أريدكِ أن تتحرّري

103
00:12:21,990 --> 00:12:26,050
لن أدع أحداً ينتقد خياركِ مهما كان

104
00:12:27,790 --> 00:12:35,070
إذاً أعد مُضيفة هذه الفتاة وذلكما
الاثنين إلى مدينتهما

105
00:12:36,310 --> 00:12:38,270
سأقرّر بعد ذلك

106
00:12:39,330 --> 00:12:42,610
من فضلكِ تجنّبي التعلُّق الّذي
لا ضرورة له بالبشر حاليّاً

107
00:12:43,140 --> 00:12:48,030
بعضهم يحاولون صيدكِ يا أختي

108
00:13:04,310 --> 00:13:06,220
استبعدهما من هذا

109
00:13:07,590 --> 00:13:14,610
كُفّ عن إقحام كوشي وهيناكو في الأمر

110
00:13:24,850 --> 00:13:25,530
!هيناكو

111
00:13:35,750 --> 00:13:37,710
!هيناكو. هيناكو

112
00:13:47,450 --> 00:13:50,430
!يا رعيّة التّجارب، اثبتي

113
00:13:50,760 --> 00:13:52,500
!أبعد يديك عن هيناكو

114
00:13:52,500 --> 00:13:54,430
!توقّف

115
00:13:59,610 --> 00:14:00,270
!ميزوري

116
00:14:41,470 --> 00:14:42,190
!هيناكو

117
00:15:31,030 --> 00:15:32,120
!روروكو

118
00:15:37,500 --> 00:15:38,670
اللّعنة

119
00:15:55,000 --> 00:15:56,430
هكذا إذاً

120
00:15:56,930 --> 00:16:03,420
أنت غير... متوافق

121
00:16:03,940 --> 00:16:05,980
!يا للخسارة

122
00:16:10,250 --> 00:16:12,840
هؤلاء لا يعلمون متى يبقون ميّتين

123
00:16:13,480 --> 00:16:15,720
كنتُ لأفضّل مقاتلة قطيع من الوحوش

124
00:16:17,240 --> 00:16:18,580
آسف لتأخُّري

125
00:16:19,230 --> 00:16:22,580
تصارعتُ مع بقايا العنكبوت
،على الطّريق القديم

126
00:16:23,090 --> 00:16:24,630
فاستهلكَ ذلك الوقت

127
00:16:36,610 --> 00:16:38,390
لا أصدِّق ذلك

128
00:16:39,000 --> 00:16:41,610
إذاً جعلوا الفتاة مُضيفة لهم؟

129
00:16:44,520 --> 00:16:45,350
كوشي

130
00:16:46,030 --> 00:16:50,190
سأسلّم العريضة للسيّدة الإلاهة

131
00:16:50,820 --> 00:16:56,530
عليك أن تأخذ أختك والفتاة
إلى المنزل. مفهوم؟

132
00:17:36,630 --> 00:17:37,850
آكيرا

133
00:17:38,570 --> 00:17:41,460
كان يُفترَض أن يكون هذا عملك

134
00:17:42,270 --> 00:17:45,150
آكيرا، أين أنتِ؟

135
00:18:46,690 --> 00:18:55,400
لا أصدّق أن تدع عشيرتا الماء والرّياح
بشريّاً قذراً يقطع هذه المسافة. كم هذا بائس

136
00:19:03,320 --> 00:19:09,830
،لا أحد يُسمَح له بدخول القصر
ناهيك عن السيّدة الإلاهة

137
00:19:11,210 --> 00:19:12,500
...لا

138
00:19:26,440 --> 00:19:31,300
ما الّذي يستطيع حيوان دونيّ جريح فعله؟

139
00:19:51,990 --> 00:19:55,380
...السيّدة الإلاهة... تايوراهيمي

140
00:20:24,910 --> 00:20:29,660
أخيراً. تمكّنتُ من ذلك أخيراً

141
00:20:30,440 --> 00:20:32,210
بشريّ قذر

142
00:20:32,670 --> 00:20:37,170
هل لديك أدنى فكرة عمّا فعلت؟

143
00:20:37,170 --> 00:20:39,660
!اللّعنة عليك

144
00:20:39,660 --> 00:20:41,600
!سأمزّقك إرباً

145
00:20:55,220 --> 00:20:56,770
!سيّد يوشيتشي

146
00:20:57,270 --> 00:20:59,770
...هذا مستحيل. لكن

147
00:21:00,900 --> 00:21:03,330
...تلك السيّدة الإلاهة

148
00:22:02,650 --> 00:22:04,680
واحد آخر

149
00:22:04,970 --> 00:22:09,510
إذا سحقتُ واحداً آخر، سينتهي
حكم العشائر الإلهيّة

150
00:22:10,680 --> 00:22:15,780
والأخير يجب أن يكون في الدّاخل هناك

151
00:23:49,990 --> 00:23:52,240
الحلقة القادمة

152
00:23:56,830 --> 00:24:00,000
الوحش السّماويّ