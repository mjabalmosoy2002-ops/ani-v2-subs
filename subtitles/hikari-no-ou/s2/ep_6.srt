1
00:00:01,890 --> 00:00:07,650
اختطفَتْ عشيرةُ الأرض كيرا لاستخدامها
كمُضيف للّهب الخفّاق

2
00:00:09,540 --> 00:00:12,600
،حاملاً عريضة من العرائض الثّلاثة

3
00:00:12,600 --> 00:00:16,010
كوشي يغادر روروكو ويشقّ طريقه
نحو القصر الإلهيّ

4
00:00:17,020 --> 00:00:22,890
في غابة الظّلام، توكو وآكيرا وكون
،يجدون الحشرة الّتي يبحثون عنها

5
00:00:22,890 --> 00:00:27,550
ومع كاناتا، يتركون الأشجّار خلفهم
ويتوجّهون نحو القصر أيضاً

6
00:00:31,090 --> 00:00:35,840
صيّاد النّار

7
00:01:58,510 --> 00:02:02,060
القصر
الإلهيّ

8
00:02:04,600 --> 00:02:08,830
تقول بأنّك عملت على الشّعلة السّماويّة؟

9
00:02:09,750 --> 00:02:11,550
هذا أمرٌ جلل

10
00:02:12,330 --> 00:02:17,210
عليك أن تفكّر مليّاً في كيفيّة
استخدام مثل هذه النّار الهائلة

11
00:02:18,210 --> 00:02:21,980
بحثتَ عن طريقة لصنع البرق

12
00:02:22,420 --> 00:02:25,140
لكن يجب ألّا تتوقّف عند هذا الحدّ

13
00:02:25,140 --> 00:02:28,660
واظب على ذلك. فكّر مليّاً وبإسهاب

14
00:02:28,660 --> 00:02:32,950
إذا احتجت نصيحة، فسأمنحك
كلّ المساعدة هذه المرّة

15
00:02:32,950 --> 00:02:34,670
...ماذا؟ هل هذا

16
00:02:39,810 --> 00:02:40,840
!هيناكو

17
00:02:44,840 --> 00:02:45,810
وجدتُك

18
00:02:59,360 --> 00:03:00,180
كيري

19
00:03:01,590 --> 00:03:04,450
لا تتصرّف بشكلٍ ودود أيُّها الخلد

20
00:03:09,440 --> 00:03:10,420
...يسرّني أنّك

21
00:03:11,350 --> 00:03:14,100
وكوغي وغوموجو تُوفّيا

22
00:03:14,900 --> 00:03:20,660
أعتقد أنّ ياناغي قد نجا، لكن
...بجسدٍ كجسدها

23
00:03:21,800 --> 00:03:25,260
اذهب إلى مكان آخر بسرعة

24
00:03:25,950 --> 00:03:28,720
لا أحد هنا سوى الموتى

25
00:03:29,340 --> 00:03:33,940
كيري، هل يمكنك أن تخمّني
إلى أين ذهبت ياناغي؟

26
00:03:35,850 --> 00:03:36,900
ربّما

27
00:03:37,340 --> 00:03:39,290
لنذهب إلى هناك إذاً

28
00:03:40,790 --> 00:03:46,300
ستكون مع كونوغي. سيكون
من السّهل رؤية عملاق مثله

29
00:03:46,300 --> 00:03:47,240
من كونوغي؟

30
00:03:47,240 --> 00:03:51,370
عندما أتيتَ إلى الحيّ المُحرّم
،في ذلك الوقت

31
00:03:51,370 --> 00:03:55,750
كان أمامك مباشرة، لكن أعتقد
بأنّك لم تشعر

32
00:03:57,660 --> 00:03:58,750
كوشي

33
00:04:01,250 --> 00:04:06,590
أعتقد تلك الحفرة قد تشير إلى حيث
انبثقَ شيء من تحت الأرض

34
00:04:17,060 --> 00:04:19,020
كونوغي

35
00:04:51,400 --> 00:04:54,140
تبّاً. عدنا إلى المُربَّع الأوّل ثانية

36
00:04:54,410 --> 00:04:57,630
توكو. كون. ابقيا قريبين منّي

37
00:05:05,430 --> 00:05:08,990
...آنسة آكيرا، بخصوص تلك الأصوات في الغابة

38
00:05:09,490 --> 00:05:10,870
سمعتُها أيضاً

39
00:05:11,750 --> 00:05:13,610
قد يكونون على حقّ

40
00:05:14,320 --> 00:05:18,600
الوحوش لا تملك عقولاً ماكرة كالبشر

41
00:05:20,010 --> 00:05:26,730
،على الأقلّ، عندما يقترب وحشٌ من بشريّ
فلا يعني ذلك سوى معركة حتّى الموت

42
00:05:27,330 --> 00:05:33,720
قد أتمكّن من الاسترخاء في الغابة
أكثر من أيّ مكان آخر

43
00:05:40,910 --> 00:05:42,580
ذلك الرّمز من جديد

44
00:05:43,160 --> 00:05:45,720
أجل. علامات للعناكب

45
00:05:46,890 --> 00:05:50,180
يبدو أنّ هذا المكان ليس آمناً أيضاً

46
00:05:56,450 --> 00:05:57,160
من هناك؟

47
00:06:05,940 --> 00:06:08,580
هل أنتما عاملان في المصنع؟

48
00:06:08,580 --> 00:06:09,760
هل علِقتما؟

49
00:06:15,500 --> 00:06:16,390
أبي

50
00:06:49,500 --> 00:06:50,600
!أحمق

51
00:06:50,600 --> 00:06:52,800
!هل تريد القضاء على الطّفل معك؟

52
00:07:01,080 --> 00:07:02,770
كنتُ وشيكاً جدّاً

53
00:07:03,550 --> 00:07:09,060
كنتُ قد أوشكتُ على تحريره
من هذا العالم

54
00:07:09,530 --> 00:07:10,900
تحريره؟

55
00:07:11,510 --> 00:07:17,370
كان بوسعه أن يغادر هذا العالم
الملعون ويُولَد من جديد

56
00:07:17,370 --> 00:07:20,770
بجسدٍ لا يحترق

57
00:07:26,410 --> 00:07:30,170
عسى أن تحرقك الآلهة يا كلب الآلهة

58
00:07:31,070 --> 00:07:33,950
لستُ أحد صيّادي النّار من العاصمة

59
00:07:41,210 --> 00:07:42,060
هيّا بنا

60
00:07:47,000 --> 00:07:50,250
أعلم بأنّني لا ينبغي أن أشتكي
،عندما أستند عليك

61
00:07:50,250 --> 00:07:52,200
لكن أنت ضعيف حقّاً

62
00:07:53,970 --> 00:07:57,620
معك حقّ. أنت آخر شخص أريد
سماع ذلك منه الآن

63
00:07:58,350 --> 00:07:59,480
هيّا بنا

64
00:08:05,850 --> 00:08:07,500
—هيّا بنا يا هينا

65
00:08:09,910 --> 00:08:11,010
هيناكو؟

66
00:08:16,250 --> 00:08:19,480
هيناكو، دعي هذا الشّيء جانباً

67
00:08:40,460 --> 00:08:42,380
من كان أولئك؟

68
00:08:42,380 --> 00:08:47,020
اثنان من مُشعلي النّيران الّذين
سقطا ضحيّة وعود العناكب الفارغة

69
00:08:47,020 --> 00:08:49,010
هل كانت فكرة جيّدة أن نتركهما؟

70
00:08:50,280 --> 00:08:54,040
أمثالهما لا يصغون للمنطق

71
00:08:54,710 --> 00:08:57,300
عانيا لفترة طويلة جدّاً

72
00:08:58,500 --> 00:09:02,280
لهذا يتشبّثون بما يريدون سماعه

73
00:09:02,280 --> 00:09:06,340
ويرمون بحياة عائلاتهم وحياتهم أيضاً

74
00:09:16,070 --> 00:09:18,570
كاهو

75
00:09:27,540 --> 00:09:30,910
كاهو؟

76
00:09:28,790 --> 00:09:30,140
!كاهو

77
00:09:40,500 --> 00:09:45,270
.ظننتُ بأنّني لن أراك ثانية أبداً
هذا مُطمئن

78
00:09:45,660 --> 00:09:49,080
كاهو، ماذا تفعلين في مكانٍ كهذا؟

79
00:09:52,660 --> 00:09:55,740
لماذا... لماذا أنتِ هنا؟

80
00:09:56,190 --> 00:10:00,700
أتى بعض قوم الشّجر إلى هنا
لمساعدة صيّادي النّار الجرحى

81
00:10:01,290 --> 00:10:03,160
لحقتُ بهم

82
00:10:03,540 --> 00:10:06,700
هل أنتم من طاقم شاحنة التّجميع؟

83
00:10:09,230 --> 00:10:12,180
لا بدّ أنّكِ تعتقدين بأنّنا كِبار قليلاً على ذلك

84
00:10:12,840 --> 00:10:13,830
...في الحقيقة

85
00:10:14,300 --> 00:10:18,760
كما ترين. استدعوا أيّ شخص يمتلك خبرة

86
00:10:19,390 --> 00:10:21,470
هذه المنطقة ليست آمنة

87
00:10:22,130 --> 00:10:23,460
نعلم

88
00:10:24,350 --> 00:10:30,400
لكن لأجل أهل القرية، علينا أن ندع
الشّاحنات تتحرّك عمّا قريب

89
00:10:32,580 --> 00:10:36,380
الموكب الأخير لم يعُد أبداً من الغابة

90
00:10:36,380 --> 00:10:40,820
قيل بأنّ تنّيناً قد هاجمه وقتل الطّاقمَ بأكمله

91
00:10:41,240 --> 00:10:46,540
،سمِعنا فحوى الأمر من شوزو
بما في ذلك ما تحاولين فعله

92
00:10:48,780 --> 00:10:54,260
كاهو هنا طالبتْ أن نأخذها إلى المصنع

93
00:10:57,490 --> 00:11:01,790
قال شوزو بأنّ أخبركِ بأمر إذا التقينا بكِ يا آكيرا

94
00:11:02,680 --> 00:11:08,770
كثير من سكّان المدينة يعتقدون بأنّ البشر
سيُنقَذون إذا أصغينا للعناكب

95
00:11:11,630 --> 00:11:16,670
لا أحد يعلم ما الّذي يجري، لذا
جميعهم بدؤوا بالإيمان بالشّيء ذاته

96
00:11:17,290 --> 00:11:19,910
إذا استمرّ هذا، ستحدث كارثة

97
00:11:21,400 --> 00:11:26,660
آكيرا. قال، "قولي لصيّادة النّار ذات الشّعر
"الأحمر أن تصبح سيّدة الصّيادين الجديدة

98
00:11:28,750 --> 00:11:32,420
وأنّ الجميع بحاجة شيء يمكنهم الإيمان به

99
00:11:38,660 --> 00:11:43,590
بدا شوزو وكأنّه آمن بأنّكِ تستطيعين فعلها

100
00:11:44,600 --> 00:11:47,180
آكيرا، أليس كذلك؟

101
00:11:50,460 --> 00:11:57,480
العاصمة عبارة عن حفرة جحيم. فقدتُ
زوجتي وأطفالي بسبب سموم المصنع

102
00:11:58,100 --> 00:12:05,000
،أدّيتُ عملاً مُجهِداً أكثر من أيّ شخص
،يملؤني الزّيت بينما أقوم بالإصلاح

103
00:12:05,000 --> 00:12:07,870
لكن أنا الوحيد الّذي نجا

104
00:12:08,360 --> 00:12:11,080
تُوفِّي أصدقائي بشكل فظيع أيضاً

105
00:12:11,080 --> 00:12:17,410
لطالما تمنّيتُ أن نعيش على الأقلّ
،ونموت كما النّاس في هذه المدينة

106
00:12:17,410 --> 00:12:19,660
وكبرتُ بينما لا أزال أتمنّى ذلك

107
00:12:21,630 --> 00:12:23,020
لذا من فضلكِ

108
00:12:28,330 --> 00:12:30,260
تفضّل يا كون. طعام

109
00:12:30,670 --> 00:12:32,530
إنّه من والدة شوزو

110
00:12:33,630 --> 00:12:35,950
حريّ بكِ العودة يا توكو

111
00:12:36,930 --> 00:12:37,690
حسناً

112
00:12:49,530 --> 00:12:50,960
آنسة آكيرا

113
00:12:50,960 --> 00:12:52,040
ابقي صامتة وامشي

114
00:13:34,230 --> 00:13:36,500
شعرتُ بأنّني أعرفكم

115
00:13:39,360 --> 00:13:40,950
...هذا الكلب

116
00:13:41,290 --> 00:13:45,670
هذا الكلب جلبَ كلّ البليّة معه

117
00:13:46,940 --> 00:13:50,110
عرفتُ بأنّني أبغض الحيوانات لسبب

118
00:13:55,950 --> 00:13:58,570
أنت السيّدة أوكيبي، أليس كذلك؟

119
00:13:59,450 --> 00:14:02,220
هل يُعقَل أنّ الآلهة توصّلَتْ إليكِ أيضاً؟

120
00:14:06,290 --> 00:14:07,960
أين كيرا؟

121
00:14:09,140 --> 00:14:12,690
إلى أين أُخِذَتْ ابنتي؟

122
00:14:12,690 --> 00:14:15,620
هل تعملين لصالحي أيضاً؟

123
00:14:16,090 --> 00:14:20,730
تسلّلتِ إلى داخل منزلي وتنعّمتِ
،بنِعم وخيرات زوجي

124
00:14:21,480 --> 00:14:24,130
!أيّتها الثّعلبة القذرة

125
00:14:24,630 --> 00:14:27,840
لا أعمل لصالح العشائر الإلهيّة

126
00:14:27,840 --> 00:14:30,640
أخذوا كيرا إلى قصرهم

127
00:14:30,640 --> 00:14:33,510
،سنذهب إلى هناك لاسترجاعها
لذا ابتعدي عن طريقنا

128
00:14:34,010 --> 00:14:36,570
،لا يمكنكِ تخيُّل الشُّعور بذلك

129
00:14:37,050 --> 00:14:44,110
بينما أشقّ طريقي زاحفة للخروج من الأحياء الفقيرة
وذلك كي أتمكّن من حجز مكاني في ذلك المنزل

130
00:14:44,520 --> 00:14:47,810
لا يهمّني. لا أكترث لقصصكِ المُحزِنة

131
00:14:48,290 --> 00:14:53,850
،لا أتحمّل فكرة أنّنا حتّى لو أنقذنا كيرا
سوف ينتهي المطاف بعودتها إلى ذلك المنزل

132
00:14:54,380 --> 00:14:56,270
كيف يمكنك العيش مع ذلك الرّجل؟

133
00:14:56,830 --> 00:15:03,660
عندما كان كلّ ما منحني إيّاه الفقر
هو جلد وعِظام، منحَني ذلك الرّجل اللّحم

134
00:15:03,660 --> 00:15:06,610
قال لي أن آكل وأغدو جميلة

135
00:15:07,500 --> 00:15:09,420
لذا لحقتُ به

136
00:15:09,800 --> 00:15:15,480
،ارتأيتُ بأنّني إذا استطعتُ العيش معه
،والتكبُّر على رعاع المدينة

137
00:15:15,480 --> 00:15:18,600
يمكنني أن أكون بشريّة أيضاً

138
00:15:18,600 --> 00:15:19,520
...آنسة آكيرا

139
00:15:20,420 --> 00:15:22,730
فشلتُ في أن أصبح شخصاً

140
00:15:23,010 --> 00:15:24,440
!يا سيّدة، توقّفي

141
00:15:24,840 --> 00:15:27,400
ألن تساعدي الآنسة كيرا؟

142
00:15:27,400 --> 00:15:30,320
ألستِ في طريقكِ لإعادتها؟

143
00:15:31,950 --> 00:15:33,400
!تراجعي يا توكو

144
00:15:33,400 --> 00:15:34,910
فقدَتْ صوابها

145
00:15:45,840 --> 00:15:47,300
!توقّفي

146
00:15:47,300 --> 00:15:49,760
!موتي

147
00:16:06,740 --> 00:16:10,150
سأقتل أيّ شخص يزعجها

148
00:16:18,810 --> 00:16:19,690
تيماري

149
00:16:23,490 --> 00:16:25,020
نجوتِ أيضاً إذاً

150
00:16:53,070 --> 00:16:56,490
كوشي، هيناكو، كيري... كونوغي

151
00:17:08,250 --> 00:17:11,290
هذا كونوغي؟

152
00:17:20,680 --> 00:17:23,700
!ياناغي

153
00:17:31,340 --> 00:17:35,500
إذاً بقي اثنان من قوم الشّجر من الحديقة؟

154
00:17:40,700 --> 00:17:46,770
إنّها روري-ماتسوري من عشيرة
الخشب الّتي صنعَتْنا

155
00:17:47,410 --> 00:17:50,380
اغربي عن وجهي! ماذا تريدين
بعد كلّ هذا الوقت؟

156
00:17:50,780 --> 00:17:53,230
أتيتُ لأنّه مضى وقت طويل

157
00:17:54,040 --> 00:17:58,280
بالإضافة إلى ذلك، قوم الشّجر الّذين
ينتمون للحيّ المُحرّم يتجوّلون

158
00:17:59,000 --> 00:18:04,450
صحيح، لا يمكنكِ العيش بعيداً
عن ذلك المكان

159
00:18:05,020 --> 00:18:09,870
لكن ما زال عليّ تنظيف مُخلّفات مصنوعاتي

160
00:18:10,270 --> 00:18:14,420
...شويو، موكوغي، غوموجو، حتّى ياناغي

161
00:18:14,420 --> 00:18:17,110
كلّ مصنوعاتك الفاشلة ماتت

162
00:18:17,500 --> 00:18:20,140
لم يبقَ لي أنا وكونوغي الكثير من الوقت أيضاً

163
00:18:20,450 --> 00:18:22,280
ما الّذي بقي "لتنظيفه"؟

164
00:18:23,300 --> 00:18:28,120
ألستَ البشريّ الّذي صنع ذلك البرق؟

165
00:18:29,310 --> 00:18:33,790
شكّلتَ ضربة مُوجعة فعلاً لأعداد
العناكب. أحسنت صنعاً

166
00:18:35,990 --> 00:18:38,930
ما الّذي حدث للّهب الخفّاق عقب ذلك؟

167
00:18:39,300 --> 00:18:41,970
ماذا تريد منها؟

168
00:18:42,520 --> 00:18:44,470
اللّهب الخفّاق خطيرة

169
00:18:44,900 --> 00:18:50,900
علينا إسكاتها ودفنها تحت
الأرض حالما تعود

170
00:18:51,300 --> 00:18:57,590
لكن عشيرة النّار والعناكب
والبشر جميعهم يريدونها

171
00:18:58,380 --> 00:19:03,410
لا أحد في هذا العالم الآن
يستطيع ترويض النّار بداخلها

172
00:19:03,970 --> 00:19:07,310
ولا حتّى العناكب الّذين قد أبطلوا الاحتراق

173
00:19:07,880 --> 00:19:10,870
جميعهم يتحدّثون عن تمديد أجل هذا العالم

174
00:19:11,300 --> 00:19:16,690
عثرَ حمقى عشيرة الأرض أولئك
على فتاة لتؤدّي دور المُضيف

175
00:19:16,690 --> 00:19:20,490
أعادت عشيرةُ الماء صنع البشر
إلى شيء جديد

176
00:19:22,280 --> 00:19:25,010
مثل تلك الفتاة على ما أعتقد

177
00:19:27,900 --> 00:19:28,830
هيناكو

178
00:19:29,140 --> 00:19:31,610
ما المشكلة؟ هل تشعرين بوعكة؟

179
00:19:31,610 --> 00:19:33,700
لا بدَّ أنَّ العقاقير قد أثّرتْ

180
00:19:34,370 --> 00:19:40,490
في الواقع، سُبُل عشيرة الماء لا تُعيد
بناء الجسد من الصّفر

181
00:19:41,160 --> 00:19:45,240
يجب عليهم الاستمرار في تناول
الدّواء للحِفاظ على ديمومتهم

182
00:19:45,730 --> 00:19:50,550
صِراعهم العقيم لن يخلق سوى
مزيداً من الانشغالات

183
00:19:52,010 --> 00:19:53,290
!هيناكو

184
00:19:53,290 --> 00:19:54,970
!تمالكي نفسكِ يا هيناكو

185
00:20:10,580 --> 00:20:14,330
!عملك هو هناك أيّها الخلد

186
00:21:12,820 --> 00:21:15,160
!هيناكو. هيناكو

187
00:21:15,160 --> 00:21:18,750
إنّها ليست ميّتة. اطمئنّ

188
00:21:20,140 --> 00:21:21,460
...أنت

189
00:21:23,060 --> 00:21:28,950
،أعي بأنّ هذا الزيّ لا يلائمني
لكنّه مُتعارف عليه في القصر

190
00:21:30,250 --> 00:21:35,400
لا تقلق. ستتعافى رعيّة التّجربة قريباً

191
00:21:37,320 --> 00:21:38,600
!تاكيمي

192
00:21:40,170 --> 00:21:43,320
من فضلك أعطِني رعيّة التّجربة

193
00:23:49,990 --> 00:23:52,700
الحلقة القادمة

194
00:23:56,990 --> 00:24:00,000
الفتاة الفارغة