1
00:00:02,160 --> 00:00:08,010
أخيراً، التقت توكو بكوشي، فرد من أفراد
عائلة كلب الصّيد كاناتا، في العاصمة

2
00:00:08,840 --> 00:00:18,030
:لكنّها التقت أيضاً بأعجوبة جديدة
"العشائر الإلهيّة و"جواسيسها

3
00:00:22,620 --> 00:00:33,550
صيّاد النّار

4
00:01:51,320 --> 00:01:56,220
القناة الكبرى في العاصمة تفصل
المنطقتين السكّانيّة والصّناعيّة

5
00:01:56,220 --> 00:01:59,280
،ما وراء الجسر الطويل الّذي يغطّيها

6
00:01:59,280 --> 00:02:07,140
يقع توسّع المصانع الآخذ في الامتداد
والّذي تتقاطع معه الممرّات المائيّة

7
00:02:08,350 --> 00:02:12,020
سيّدي، أهذه هي بلاد الموتى؟

8
00:02:12,400 --> 00:02:18,190
لا، إنّها منطقة المصنع، رغم أنّ
"النّاس يسمّونها "حديقة الآلهة

9
00:02:18,190 --> 00:02:20,710
إنّها مربوطة بالغابة أيضاً

10
00:02:21,260 --> 00:02:25,690
هناك نفق يؤدّي إلى الجنوب يستخدمه
صيّادو النّار وشاحنات التجميع

11
00:02:29,830 --> 00:02:32,280
يمكنكِ مُناداتي كوشي فحسب بالمناسبة

12
00:02:32,280 --> 00:02:33,610
كوشي

13
00:02:33,610 --> 00:02:39,040
إنّ "كو" تعني وهجاً أحمر، و"شي" تعني الأمن والكمال

14
00:02:39,040 --> 00:02:40,540
كيرا علّمتني ذلك

15
00:02:41,010 --> 00:02:42,810
وهج عظيم؟

16
00:02:42,810 --> 00:02:44,980
أجل، مع أنّني لا أعرف ما طبيعة ناره

17
00:02:45,880 --> 00:02:50,320
ذلك الشّيء الّذي رميته كان أشبه ببرق

18
00:02:50,320 --> 00:02:55,050
كان برقاً مُعبأ. كما رأيتِ، يومض حال وقوع الاصطدام

19
00:02:56,170 --> 00:03:02,410
إنّه كما النّوع العاديّ، لكنّه مليء
بالشّعلة السماويّة بدلاً من نار الوحش

20
00:03:02,410 --> 00:03:07,160
شعلة سماويّة مُعبَّأة؟ لكن هذه قيّمة جدّاً

21
00:03:07,870 --> 00:03:10,890
ذلك الجاسوس كان مجرّد قطعة ورق

22
00:03:11,420 --> 00:03:16,300
يتحكّم به إله، لكنّه يعود إلى ورق
إذا كسرت التّعويذة فحسب

23
00:03:17,480 --> 00:03:19,530
أنا مسرور فحسب لأنّ البرق المُعبّأ قد نجح

24
00:03:44,080 --> 00:03:45,540
أتيتِ لأجل الدّواء، صحيح؟

25
00:03:46,210 --> 00:03:50,910
شخص فعل الكثير لأجلي مُصاب إصابة بليغة

26
00:03:51,480 --> 00:03:54,780
قوم الشّجر يوفّرون الدّواء للقرويّين

27
00:03:54,780 --> 00:03:58,880
ولديهم معرفة قديمة. أشياء لا تعرفها سوى الآلهة

28
00:03:59,390 --> 00:04:01,970
حتّى عن اللّهب الخفّاق؟

29
00:04:01,970 --> 00:04:04,220
ماذا؟ ما أدراكِ بهذا؟

30
00:04:08,710 --> 00:04:11,370
هذه إشارة العطل. لنسرع

31
00:04:26,450 --> 00:04:27,200
هذا سيّئ

32
00:04:27,790 --> 00:04:29,930
إنّه مُغلَق بإحكام من الصّدأ

33
00:04:37,580 --> 00:04:39,610
كاناتا، أهذا هو الطريق؟

34
00:04:44,760 --> 00:04:46,180
أحد قوم الشّجر

35
00:04:50,140 --> 00:04:52,920
!سيّد قوم الشّجر، أريد دواء

36
00:04:52,920 --> 00:04:58,710
صديقي متأذٍّ حقّاً! هلّا شاركت دواء معي من فضلك؟

37
00:05:00,320 --> 00:05:01,220
هيّا بنا

38
00:05:09,120 --> 00:05:15,120
توكو وقوم الشّجر

39
00:05:10,450 --> 00:05:15,120
كاناتا وأنا ركبنا شاحنة التّجميع

40
00:05:15,780 --> 00:05:22,350
لم نكن نحن فقط. كانت هناك نساء
تمّ إرسالهن للزواج أيضاً

41
00:05:22,350 --> 00:05:25,630
...ثمّ حامي قرية كاهو، الإله التنّين

42
00:05:29,010 --> 00:05:34,250
لا أصدّق أنّ العناكب حرّضوا إلاهاً
حامياً على شاحنة التّجميع

43
00:05:34,700 --> 00:05:37,640
...لكن إذا كانت صيّادة النّار تلك، آكيرا، على حقّ

44
00:05:39,140 --> 00:05:44,530
أتساءل ما الّذي أراد أبي كتابته
على ورق موكو وإلى من

45
00:05:45,000 --> 00:05:50,460
في قريتي، يُقال أنّه هِبة لتكتب
عليه السيّدة الإلاهة

46
00:05:50,460 --> 00:05:56,360
السيّدة الإلاهة، تايوراهيمي، تكتب
الصّلوات. قصائد تمدح العالم

47
00:05:57,440 --> 00:06:02,680
يُزعَم أنّ حياتها تسمح للعشائر الإلهيّة
،بالحكم بواسطة قواهم

48
00:06:02,680 --> 00:06:06,810
وأختها، توكوهاناهيمي، كانت أوّل صيّادة نار

49
00:06:14,720 --> 00:06:20,700
توكوهاناهيمي استخدمت ناراً طبيعيّة
لصناعة مِنجل أثناء احتراق جسدها

50
00:06:20,700 --> 00:06:25,240
:اختفَتْ عن العالم، لكن تركت كلاماً أخيراً قبل موتها

51
00:06:26,610 --> 00:06:32,570
بنار مُذنّب الألفيّة، لم نعد بحاجة"
"للخوف من الغابة المُظلِمة

52
00:06:32,970 --> 00:06:37,540
ومن يمسك بها سيصبح معروفاً"
"كسيّد لصيّادي النّار

53
00:06:38,170 --> 00:06:40,860
"هذا الحاكم سيحصد اللّهب الخفّاق"

54
00:06:53,100 --> 00:06:56,890
هذه ليست جذوع أشجّار. هل هي جذور؟

55
00:07:03,010 --> 00:07:06,650
لا تُزمجر. لا ينوي إن إلحاق أيّ ضرر

56
00:07:08,110 --> 00:07:09,140
هناك

57
00:07:09,960 --> 00:07:16,030
أيّها الزوّار. أحضر شويو شيئاً نادراً

58
00:07:16,490 --> 00:07:18,040
استدعِ كيري

59
00:07:19,460 --> 00:07:20,710
بشر؟

60
00:07:21,210 --> 00:07:24,360
ضيوف. أحضرهم شويو

61
00:07:25,670 --> 00:07:29,820
لهذا أخبرتُك ألّا تحتفظ بالطيور

62
00:07:29,820 --> 00:07:34,190
لا بدّ من وجود طريقة أفضل لتمضية الوقت

63
00:07:34,190 --> 00:07:36,640
حسناً، ماذا تريدان أيّها البشريّان؟

64
00:07:37,070 --> 00:07:39,210
تريد هذه الفتاة دواء

65
00:07:39,210 --> 00:07:42,850
وكنتُ آمل أن أطرح عليك بعض الأسئلة

66
00:07:43,420 --> 00:07:46,820
لا نملك دواء نعطيكما إيّاه هنا

67
00:07:47,440 --> 00:07:54,780
وحدهم النّاجحون الّذين أُرسِلوا إلى الغابة تعلّموا الطبّ

68
00:07:54,780 --> 00:07:58,490
النّاجحون"؟ ماذا تقصدين؟"

69
00:07:58,490 --> 00:08:00,750
إذاً، حدّثيني عن هذا العالم

70
00:08:01,280 --> 00:08:02,640
أحدّثك عن ماذا؟

71
00:08:02,640 --> 00:08:08,050
الحرب على الأبواب. ألم تخبركم الآلهة بأيّ شيء؟

72
00:08:08,440 --> 00:08:16,010
العشائر الإلهيّة؟ لا يخبرون قوم الشّجر
بما يحدث في العاصمة

73
00:08:16,840 --> 00:08:24,550
نحن لسنا كجماعات اختبار... كالّذين
أُرسِلوا لمساعدة القرويّين

74
00:08:25,360 --> 00:08:27,650
نحن تجارب فاشلة

75
00:08:28,140 --> 00:08:30,900
كانت الآلهة خجِلة جدّاً من السّماح
،لنا برؤية نور النّهار

76
00:08:31,200 --> 00:08:36,060
لذا يحبسوننا هنا في الحيّ المُحرّم

77
00:08:36,640 --> 00:08:42,800
!شويو! لا تخرج ثانية. ولا تحضر بشراً ثانية إلى هنا

78
00:08:43,440 --> 00:08:45,370
!انتظري. انتظري من فضلكِ

79
00:08:45,370 --> 00:08:54,340
اصمتي. لا أعرف ماذا قيل لكِ، لكن
نحن لا نستمتع بمعروف العشائر الإلهيّة

80
00:08:55,270 --> 00:08:56,550
خِلدان

81
00:08:56,940 --> 00:08:57,910
خِلدان؟

82
00:09:00,070 --> 00:09:02,350
هؤلاء هم؟

83
00:09:02,350 --> 00:09:05,850
الّذين يدفنون البرق المُعبّأ في كلّ مكان؟

84
00:09:07,200 --> 00:09:09,610
يمكننا التّمييز من خلال جذور الشّجر

85
00:09:11,400 --> 00:09:13,360
هذا سرّ، صحيح؟

86
00:09:13,360 --> 00:09:18,660
،إن كنتم لا تريدون أن تكتشف الآلهة
كفّوا عن حشر أنفكم هنا

87
00:09:19,570 --> 00:09:24,220
لا يعنينا ما يحدث للعالم السّطحي

88
00:09:24,760 --> 00:09:27,120
إن، اطردهما

89
00:09:57,240 --> 00:09:59,030
توقّف

90
00:09:59,320 --> 00:10:04,920
لدى هذه الطفلة مِنجل. سيتأذّى إن

91
00:10:08,880 --> 00:10:10,270
ياناغي

92
00:10:10,270 --> 00:10:18,000
كما قالت كيري، نحن قوم الشّجر
الفاشلون محبوسون هنا

93
00:10:18,990 --> 00:10:25,690
لكن بخلاف غوموجو وأنا، كيري وشويو
قد يصمدان في الغابة

94
00:10:26,310 --> 00:10:30,120
تظلّ هذه الأشياء تنمو مهما قطعتُها

95
00:10:30,120 --> 00:10:33,730
هذا مؤلم، ودائماً ما يشكّل عقبة

96
00:10:33,730 --> 00:10:40,240
وشويو لا يزال طفلاً. لا يستطيع ذلك
الصّغير العيش هناك

97
00:10:41,110 --> 00:10:47,700
عبرتُما الغابة، أليس كذلك؟ رائحتكما كرائحة إخواننا

98
00:10:48,450 --> 00:10:51,530
أنا آسفة لأنّنا لا نستطيع إعطائكم دواء

99
00:10:52,510 --> 00:11:00,760
آنذاك عندما مات العالم، حاولت الآلهة
ائتمان الوحوش النّاجية على النّار

100
00:11:01,510 --> 00:11:06,060
الحيوانات البرّية كانت في السّابق تمنح البشرَ ناراً

101
00:11:06,640 --> 00:11:11,140
مثّلت الآلهة تلك الرّوايات بشكل عكسي

102
00:11:11,960 --> 00:11:19,840
البشر والآلهة على حدٍّ سواء أصبحوا
قابلين للاشتعال وفقدوا قدرة استخدام النّار

103
00:11:19,840 --> 00:11:25,770
لتخليص أنفسهم من النّار البغيضة، أعادوها إلى الوحوش

104
00:11:26,450 --> 00:11:31,870
هل تقصدين بأنّ الآلهة صنعت وحوش نار الغابة أيضاً؟

105
00:11:32,350 --> 00:11:35,140
وهكذا وُلِدت وحوش النّار

106
00:11:35,770 --> 00:11:43,800
وحوش لم يُشهَد مثلها من قبل، تكيّفت
مع الغابة المُظلمة وتحمل داخلها ناراً

107
00:11:44,790 --> 00:11:52,060
مع أنّني أشكّ في أنّ الآلهة تنبّأت
بأنّ نارها ستتّخذ الهيئة الّتي تتّخذها اليوم

108
00:11:53,100 --> 00:11:57,060
لكن رغم ذلك، لماذا صنعت توكوهاناهيمي مناجل النّار؟

109
00:11:58,160 --> 00:12:05,930
اكتشفت توكوهاناهيمي بأنّ النّار في
الوحوش لم تعُد تحرق النّاس

110
00:12:05,930 --> 00:12:09,940
صنعَتْ مِنجلها للحفاظ على جنس البشر حيّاً

111
00:12:10,790 --> 00:12:18,520
كان البشر قد خسروا النّار والغابة المُظلمة
كانت قد ابتلعت منازلهم، لكنّهم واصلوا العيش

112
00:12:18,520 --> 00:12:22,380
لعلّ قوّتهم أشعلت ناراً في قلب السيّدة الإلاهة

113
00:12:24,720 --> 00:12:33,480
مثلكم أنتم البشر، خشيت العشائر
الإلهيّة أن يموت العالم حقّاً

114
00:12:33,480 --> 00:12:39,690
إذاً الآلهة صنعت هذا العالم؟ صنعته كما هو الآن؟

115
00:12:39,690 --> 00:12:47,470
أعتقد أنّ البشر القدماء كانوا قُساة
وطائشين كما الآلهة

116
00:12:48,580 --> 00:12:55,230
،لقتل أعدائهم بكفاءة وتقليل أعدادهم الفائضة

117
00:12:55,230 --> 00:13:01,660
استخدموا كائنات مُسبّبة للمرض لصنع
أجسام تشتعل أمام النّار

118
00:13:02,090 --> 00:13:08,220
،إذا اعترضوا طريقهم، سيختفي بشرٌ بلا ضرورة

119
00:13:08,220 --> 00:13:12,300
فلا يترك ذلك سوى الأحياء الجديرين على هذا الكوكب

120
00:13:40,520 --> 00:13:44,230
ثمّة طبيب جيّد في القصر الّذي أقيم فيه

121
00:13:45,100 --> 00:13:50,680
قد أتمكّن من إحضار دواء منه. أو قد
أطلب منه مُعالجة صديقك

122
00:14:06,860 --> 00:14:07,830
!اهربي

123
00:14:34,220 --> 00:14:35,640
!تيماري

124
00:14:41,270 --> 00:14:43,980
!توكو، أيّتها الحمقاء! أين كنتِ؟

125
00:14:44,500 --> 00:14:46,110
!آنسة آكيرا

126
00:14:46,110 --> 00:14:47,940
ماذا تفعلين هنا؟

127
00:14:47,940 --> 00:14:50,410
!قلتُ لكِ اعتني بكون

128
00:14:50,760 --> 00:14:52,340
يمكنكِ تقديم الأعذار لاحقاً

129
00:14:52,870 --> 00:14:55,700
!كاناتا! تيماري! احميا الطفلين

130
00:15:37,460 --> 00:15:39,850
أعتقد هذا يكفي

131
00:15:50,280 --> 00:15:55,240
وأنتِ يا صيّادة النّار. لا تريقي دماء
غير نظيفة أمام السيّدة الإلاهة

132
00:16:06,850 --> 00:16:11,780
كلب جيّد. الوحوش البيضاء تُرضي السيّدة الإلاهة

133
00:16:12,360 --> 00:16:14,320
غادروا في الحال

134
00:16:43,460 --> 00:16:46,060
...كان ذلك إلاهاً

135
00:16:48,760 --> 00:16:51,990
مكان مُذهل تقيم فيه هنا

136
00:16:53,590 --> 00:16:57,600
ألا ينتمي هذا المنزل لأحد
أثرى الرّجال في العاصمة؟

137
00:16:57,600 --> 00:17:02,790
.أجل، لكن لستُ جزءاً من العائلة
أعيش معهم فحسب

138
00:17:02,790 --> 00:17:07,960
إذاً تبنّوك جوهريّاً، لكن لن ترِث شيئاً؟

139
00:17:08,480 --> 00:17:12,170
لهذا يجب أن أقدّم شيئاً نافعاً

140
00:17:18,000 --> 00:17:19,610
هيّا يا توكو

141
00:17:20,100 --> 00:17:27,700
شكراً جزيلاً لك. على أخذي لرؤية قوم الشّجر

142
00:17:35,890 --> 00:17:38,510
هل يمكنك الاحتفاظ بهذا؟

143
00:17:38,510 --> 00:17:38,990
ماذا؟

144
00:17:39,420 --> 00:17:42,450
يراودني شعور بأنّكِ ستستفيدين منه أكثر منّي

145
00:17:43,730 --> 00:17:47,920
في الوضع الرّاهن، إذا تسرّبت معلومات بأنّكِ
،أحضرتِ أغراض أبي إلى هنا

146
00:17:48,520 --> 00:17:51,910
فقد تجدين نفسكِ في ورطة عاجلاً أم آجلاً

147
00:17:55,600 --> 00:17:57,340
وخذي هذه

148
00:17:59,960 --> 00:18:02,260
!لـ-لا أستطيع قبول هذه

149
00:18:07,320 --> 00:18:09,080
خُذيها يا توكو

150
00:18:09,920 --> 00:18:12,860
شكراً لك على السّفر كلّ هذه المسافة

151
00:18:13,540 --> 00:18:15,420
وعلى إعادة أغراض كاناتا

152
00:18:40,820 --> 00:18:42,820
أنا مُندهشة يا توكو

153
00:18:43,490 --> 00:18:45,700
قول الوداع لكلب ليس سهلاً

154
00:18:51,520 --> 00:18:58,140
أنتِ مجرّد طفلة، لكن غادرتِ قريتكِ وقطعتِ
كلّ هذه المسافة من خلال الغابة المُظلمة

155
00:19:00,080 --> 00:19:01,580
أحسنتِ صنعاً

156
00:19:08,480 --> 00:19:11,350
والآن هيّا بنا نعود. سأحملك

157
00:19:11,350 --> 00:19:14,860
لـ-لا مشكلة. يمكنني المشي

158
00:19:14,860 --> 00:19:18,320
أتظنّينني أستطيع المشي معكِ
وأنتِ تبكين هكذا؟

159
00:19:18,320 --> 00:19:20,660
سيظنُّ المُراقبون ظنّ السّوء بأنّني فعلتُ لكِ شيئاً

160
00:19:31,100 --> 00:19:32,590
!يا آنسة

161
00:19:31,100 --> 00:19:39,780
E

162
00:19:32,590 --> 00:19:34,060
ما الأمر يا كون؟

163
00:19:34,060 --> 00:19:38,540
حشرتي المُرافقة ماتت، لذا خلتُكِ متِّ أيضاً

164
00:19:38,540 --> 00:19:39,780
حشرتك؟

165
00:19:40,320 --> 00:19:41,820
أنتِ على قيد الحياة

166
00:19:41,820 --> 00:19:44,520
توكو! أين كنتِ؟

167
00:19:44,520 --> 00:19:48,750
توقّف كون عن الحركة، وحالما استفاق، غضب بشدّة

168
00:19:52,210 --> 00:19:54,920
هل توكو نائمة؟

169
00:19:56,390 --> 00:19:58,540
لحظة، أين كاناتا؟

170
00:20:08,480 --> 00:20:09,620
توكو

171
00:20:19,970 --> 00:20:21,650
يمكنني سماعه

172
00:20:22,360 --> 00:20:23,200
ماذا؟

173
00:20:29,520 --> 00:20:30,700
شوزو

174
00:20:39,330 --> 00:20:41,340
!تبّاً! الألم

175
00:20:42,320 --> 00:20:44,360
ماذا حدث بالضبط؟

176
00:20:47,140 --> 00:20:49,870
أنا أتألم وجائع

177
00:20:49,870 --> 00:20:52,910
أهذا كلّ ما لديك لتقوله؟

178
00:20:52,910 --> 00:20:56,460
بجدّية. لا يحقّ لي الكلام، بما
،أنّني عجزتُ عن حمايتك

179
00:20:56,460 --> 00:20:59,110
لكن حاول ألّا تصعّب الأمر كثيراً على كاهو

180
00:21:08,450 --> 00:21:13,960
رؤية العالم بهذا الشّكل يُغضب اللّهب الخفّاق

181
00:21:14,430 --> 00:21:20,920
تظلُّ تايوراهيمي تكتب الرّسائل لتهدئته

182
00:21:21,810 --> 00:21:26,930
إذا هاج اللّهب الخفّاق، سيحترق العالم مرّة أخرى

183
00:21:27,860 --> 00:21:32,180
تخشى العشائر الإلهيّة هذا الاحتمال

184
00:21:32,180 --> 00:21:34,620
أعلم

185
00:21:34,620 --> 00:21:38,650
،سيظهر سيّد صيّادي النّار قريباً

186
00:21:38,650 --> 00:21:43,650
كما رغبتْ توكوهاناهيمي عندما استحدثت اللّقب

187
00:21:44,140 --> 00:21:49,360
البشر سيتوسّلون اللّهب الخفّاق بدلاً من الآلهة

188
00:21:49,360 --> 00:21:53,620
سيطلب السيّدُ غفرانَه

189
00:21:54,120 --> 00:22:01,720
لكن اللّهب الخفّاق لن يصغي. لن ينخمد غضبه

190
00:22:01,720 --> 00:22:06,020
دعه يحرق العالم إذا شاء

191
00:22:06,400 --> 00:22:11,640
!أشعِل المنارة. أشعل النّار للترحيب بالنّجم