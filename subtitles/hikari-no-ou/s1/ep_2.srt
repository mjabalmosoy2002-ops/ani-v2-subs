1
00:00:02,020 --> 00:00:07,680
يصطاد البشر وحوشَ النّار
،ويحصدون النّار الّتي بداخلهم

2
00:00:07,680 --> 00:00:10,220
ثمّ يبنون حياتهم حولها

3
00:00:11,540 --> 00:00:17,000
تشدُّ توكو الرّحال نحو العاصمة، موطِن
كوشي، رجل لا تعرفه بعد

4
00:00:20,620 --> 00:00:31,550
صيّاد النّار

5
00:02:09,960 --> 00:02:12,110
!استيقظت

6
00:02:12,460 --> 00:02:18,070
.لا تتكلّمي معها فجأة يا هوتارو
سيستاء الكلبُ إذا أفزعتِها هكذا

7
00:02:21,000 --> 00:02:22,700
عجيب أمرك

8
00:02:22,700 --> 00:02:26,380
تقيّأتِ وأُغمي عليكِ حالما صعدتِ

9
00:02:27,410 --> 00:02:29,080
اشربي بعض الماء

10
00:02:40,000 --> 00:02:41,770
اسمي هوتارو

11
00:02:41,770 --> 00:02:43,850
وهذه بينيو

12
00:02:45,600 --> 00:02:47,520
وتلك الفتاة هناك هي كاهو

13
00:02:55,780 --> 00:02:59,780
جميعنا نسافر إلى قُرى أخرى

14
00:03:00,480 --> 00:03:01,700
نغادر للزواج

15
00:03:02,770 --> 00:03:04,170
ستتزوّجن؟

16
00:03:04,700 --> 00:03:06,810
لماذا أنتُنّ في شاحنة التّجميع إذاً؟

17
00:03:07,690 --> 00:03:11,460
لكنّكِ لستِ هنا كعروس، أليس كذلك؟

18
00:03:17,710 --> 00:03:21,240
أنا مُسافرة إلى العاصمة

19
00:03:21,240 --> 00:03:24,040
إلى العاصمة؟ لماذا؟

20
00:03:24,040 --> 00:03:28,750
مـ-مات شخصٌ بسببي

21
00:03:28,750 --> 00:03:31,660
سوف أعيد مُمتلكاته

22
00:03:34,050 --> 00:03:37,770
ما اسمكِ؟ كم عمركِ؟

23
00:03:38,410 --> 00:03:41,530
توكو. عمري 11

24
00:03:43,750 --> 00:03:46,030
استيقظتِ يا صغيرة؟ تعالي معي

25
00:03:46,030 --> 00:03:47,660
حـ-حسناً

26
00:03:47,660 --> 00:03:49,260
اتركي حقيبتكِ

27
00:03:50,160 --> 00:03:53,240
يستطيع الكلب أن يأتي معكِ
إذا كان لا يستطيع ترككِ

28
00:03:53,240 --> 00:03:54,460
...انتظر

29
00:03:56,460 --> 00:03:58,400
اهتممنَ بهذا رجاء

30
00:03:58,400 --> 00:03:59,430
حسناً

31
00:04:00,310 --> 00:04:03,590
،شاحنات التّجميع تربط بين القُرى المُتفرِّقة

32
00:04:03,590 --> 00:04:08,220
لتنقل السّلع الثّمينة المُصنَّعة
في مصانع العاصمة إليهم

33
00:04:08,220 --> 00:04:13,980
بالنسبة لسكّان هذا العالم، كانت بمثابة حبل نجاة

34
00:04:15,430 --> 00:04:19,630
،مُقابل الضّوء الآمن ودفء البرق المُعبَّأ

35
00:04:19,630 --> 00:04:24,440
كانت كلّ قرية تُرسل مُنتجاتها الفريدة
وعطاياها إلى العاصمة

36
00:04:25,320 --> 00:04:31,930
كانت الشّاحنات تنقل السّلع والأخبار
بين القرى، لكن لم يكن ذلك كلّ شيء

37
00:04:33,780 --> 00:04:41,220
كانت الخيط الأخير الّذي يربط البشر
المعزولين داخل عنبر واقٍ

38
00:04:42,990 --> 00:04:44,620
هذه هي غرفة المُحرّك

39
00:04:44,620 --> 00:04:45,990
!شوزو

40
00:04:46,810 --> 00:04:47,690
ماذا؟

41
00:04:48,390 --> 00:04:52,220
جلَبْنا هذه الصّغيرة من القرية البارحة. كلّفها بعمل

42
00:04:52,220 --> 00:04:53,850
ماذا؟

43
00:04:54,220 --> 00:04:57,740
لماذا أنا؟ لديّ ما يكفي من أعمال

44
00:04:57,740 --> 00:05:01,510
اصمت. إنّها مُشكلتك الآن، لا تُناقشني

45
00:05:11,040 --> 00:05:12,490
اتبعيني

46
00:05:12,910 --> 00:05:16,770
سمعتُ بأنّكِ حُمِّلتِ عبء مُمتلكات صيّاد نار مُتوفٍّ

47
00:05:16,770 --> 00:05:19,000
حظّ سيّئ بالنسبة لطفلة مثلكِ

48
00:05:19,400 --> 00:05:23,960
أنا السّبب في موت صيّاد النّار

49
00:05:24,300 --> 00:05:30,470
كنتُ لأبيع المِنجَل لصيّاد عابر بمبلغ مُعتبَر
وأحتفظ بالكلب للحِراسة

50
00:05:31,080 --> 00:05:33,820
أنتم أهل القرية طيّبون حقّاً

51
00:05:33,820 --> 00:05:37,390
حسناً، هذا من صالح المصانع

52
00:05:40,010 --> 00:05:41,820
نظّفيه جيّداً حتّى يلمع

53
00:05:41,820 --> 00:05:43,140
...حاضرة

54
00:05:44,130 --> 00:05:46,170
هناك المزيد عقب هذا

55
00:06:05,690 --> 00:06:08,750
يُفترَض أن تكون قد ألِفتَني الآن

56
00:06:08,750 --> 00:06:11,350
الكِلاب سريعة التعلّم حسب علمي

57
00:06:12,120 --> 00:06:13,850
انتهى عملُكِ هنا

58
00:06:13,850 --> 00:06:15,470
عودي إلى غرفتكِ وكُلي

59
00:06:18,960 --> 00:06:23,070
المعذرة، هل تعرف أين السيّد أينجي؟

60
00:06:24,740 --> 00:06:29,660
آسف، لكن أينجي في الشّاحنة الأخرى، العربة 2

61
00:06:30,240 --> 00:06:33,010
إنّه جيّد مع النّاس

62
00:06:33,010 --> 00:06:36,160
لكن هنا، لدينا ذلك المُدير العجوز المُخيف

63
00:06:43,250 --> 00:06:46,420
!رائحتكِ نتنة

64
00:06:48,160 --> 00:06:49,880
طعامكِ هنا

65
00:06:50,830 --> 00:06:53,390
سبقناكِ في الأكل

66
00:07:15,350 --> 00:07:17,470
لستُ بحاجته

67
00:07:17,470 --> 00:07:18,410
...لكن

68
00:07:19,040 --> 00:07:20,500
!كما قلتُ لكِ

69
00:07:21,670 --> 00:07:24,840
هذا لا ينفع يا كاهو. عليكِ أن تأكلي

70
00:07:25,380 --> 00:07:28,930
وإلّا مُتِّ من الجوع قبل أن تتزوّجي

71
00:07:28,930 --> 00:07:33,180
...وإذا متنا في الشّاحنة، حينها

72
00:07:34,170 --> 00:07:35,510
لماذا نحن هنا؟

73
00:07:38,160 --> 00:07:41,560
جمعونا وأرسلونا كعرائس للقضاء على اللّعنات

74
00:07:42,160 --> 00:07:44,260
للقضاء على اللّعنات؟

75
00:07:45,920 --> 00:07:49,280
تصنع قريتي الفّخاريّات

76
00:07:50,060 --> 00:07:52,400
كالزّبادي وفناجين الشّاي

77
00:07:52,400 --> 00:07:56,060
باستثناء مؤخّراً، أمسى الصّلصال سيّئاً

78
00:07:56,060 --> 00:08:00,000
يمرُّ خلال أصابعك وكأنّه دِماء وحش

79
00:08:00,000 --> 00:08:04,170
القوم القديم يقرأ الطّالع وقال بأنّها لعنة

80
00:08:04,170 --> 00:08:10,380
،وقوم الشّجر لا يأخذني بعيداً بما يكفي بالنسبة لهم

81
00:08:10,380 --> 00:08:12,760
لذا زجّوا بي في هذه الشّاحنة

82
00:08:12,760 --> 00:08:15,280
نفس الرّواية هنا

83
00:08:15,280 --> 00:08:19,470
تعمل قريتي على الخيزران. المكان
برمّته عبارة عن بستان كبير

84
00:08:19,470 --> 00:08:22,610
وفي هذا العام، لم يعُد ينمو

85
00:08:22,610 --> 00:08:28,250
لا يحتاج عادةً أيّ مساعدة منّا، لكن
ما إن يبدأ هذا المحصول بالنموّ، يفسد

86
00:08:28,730 --> 00:08:30,670
لديّ نفس مُشكلة هوتارو

87
00:08:35,070 --> 00:08:39,160
كان بوسعي إنجاز عمل خمسة
رجال لو تركوني وشأني فقط

88
00:08:40,000 --> 00:08:42,200
كاهو في نفس المركب

89
00:08:42,200 --> 00:08:46,020
مناجم قريتها متألّقة جدّاً

90
00:08:46,750 --> 00:08:50,090
سئمتُ من هذا الأمر كثيراً

91
00:08:50,700 --> 00:08:53,880
أنتِ محظوظة لأنّهم سمحوا لكِ بالعمل يا توكو

92
00:08:53,880 --> 00:08:56,510
لا يكون الطّعام لذيذاً إلّا بعد العمل

93
00:08:56,920 --> 00:09:02,180
أعشق العمل. حبسي في هذه الغرفة
الصّغيرة لا يلائمني البتّة

94
00:09:09,090 --> 00:09:10,730
!كُل بسرعة

95
00:09:10,730 --> 00:09:15,400
قد يكون هذا أسهل بالنسبة لكلب
مثلك مقارنة بنا نحن

96
00:09:15,760 --> 00:09:19,030
لا تُصدِر صوتَ هرير وكأنّك واثق
!من نفسك. تأدّب

97
00:09:28,210 --> 00:09:30,100
أنتِ طريفة جدّاً يا بينيو

98
00:09:30,590 --> 00:09:33,400
أريتِ كلبَ توكو مَن الزعيم

99
00:09:33,400 --> 00:09:35,720
هذا يجعلكِ القائدة العليا

100
00:09:36,170 --> 00:09:41,140
.مهلاً يا هوتارو. اضحكي أو ابكي
لكن لا تفعلي الأمرين معاً

101
00:09:41,140 --> 00:09:45,870
لكن انظري يا بينيو. إنّه يأكل

102
00:09:45,870 --> 00:09:47,610
انظري يا توكو

103
00:09:55,640 --> 00:09:56,740
كاناتا؟

104
00:09:57,440 --> 00:09:59,490
هل يُعقَل أن تكون صافرة كلب؟

105
00:10:01,170 --> 00:10:05,050
هناك صيّاد نار على متن الشّاحنة الأخرى

106
00:10:05,930 --> 00:10:12,020
يُقال بأنّه يأمر كلبَه بصافرة
لا يستطيع سماعها إلّا الكلاب

107
00:10:13,000 --> 00:10:15,910
أنا واثقة أنّ كاناتا يستطيع سماعها أيضاً

108
00:10:17,250 --> 00:10:19,380
هل تريد العمل أيضاً؟

109
00:10:33,430 --> 00:10:35,110
تُصدرين ضجيجاً عالياً

110
00:10:36,680 --> 00:10:39,780
آسفة. هل كنتُ أشخر؟

111
00:10:39,780 --> 00:10:42,740
لا. ظللتِ تأنّين أثناء نومكِ

112
00:10:44,200 --> 00:10:47,750
خُذي. سقطت هذه من حقيبتك عندما صعدتِ

113
00:10:48,500 --> 00:10:51,880
ظلّت تلكما الاثنتان تُلّحّان عليّ كي أعيدها

114
00:10:52,590 --> 00:10:53,900
حسناً، حصلتِ عليها الآن

115
00:10:54,620 --> 00:10:58,310
نادراً ما تتكلّمين وأنتِ صاحية، لكن
في منامكِ لا تصمتين أبداً

116
00:11:25,200 --> 00:11:27,580
رين

117
00:11:32,170 --> 00:11:36,670
توكوهاناهيمي

118
00:11:35,670 --> 00:11:39,130
رين

119
00:11:59,030 --> 00:12:01,530
كوشي

120
00:12:29,360 --> 00:12:31,130
تلقّيتُ هذه الرّسالة

121
00:12:31,130 --> 00:12:36,700
صيّاد النّار هايجو هو أبي. أعتقد
بأنّكم استضفتموه هنا من قبل

122
00:12:36,700 --> 00:12:39,560
كنّا ننتظر وصولك يا سيّد. تفضّل من هنا

123
00:12:45,960 --> 00:12:49,500
سيتواصل معك مولايّ يوشيتشي قريباً

124
00:13:07,160 --> 00:13:10,760
تحطّمتُ عند سماع ما حدث

125
00:13:10,760 --> 00:13:14,880
أمّك المسكينة. وفي ظلّ غياب أبيك أيضاً

126
00:13:14,880 --> 00:13:17,270
أقدّم لك أحرّ التّعازي

127
00:13:17,270 --> 00:13:22,320
كنتُ مَديناً لأبيك هايجو لسنوات عديدة

128
00:13:22,320 --> 00:13:28,630
أقلقَتْني صحّةُ أمّك، لكن لم أتوقّع
مثل هذا التّدهور الحادّ

129
00:13:31,560 --> 00:13:32,940
لديّ أخت صغرى

130
00:13:34,030 --> 00:13:40,200
إنّها مريضة، لكن أنا تلميذ ولا أملك عملاً بعد

131
00:13:40,200 --> 00:13:44,760
هلّا سمحتَ لي بالعمل في مصنعك؟

132
00:13:45,380 --> 00:13:51,810
لم أمدّ يد العون لكم أنتم الأطفال
لأنّني أريد أن أُشغّلكم

133
00:13:52,360 --> 00:13:56,810
أخبرني، كيف ترغب في العيش هنا؟

134
00:13:57,400 --> 00:13:58,080
ماذا؟

135
00:13:58,080 --> 00:14:03,570
إنّها أفضل ممّا كانت من قبل، لكن
العاصمة ما زالت بعيدة عن الأمان

136
00:14:03,570 --> 00:14:08,970
سأمنح كلّاً منكما غرفاً في منزلي. ما قولك؟

137
00:14:08,970 --> 00:14:10,030
قسم المُتدرّبين؟

138
00:14:10,600 --> 00:14:15,040
في الواقع، أودُّ التّرحيب بكما كجزء من العائلة

139
00:14:15,760 --> 00:14:20,210
أنا مُمتنٌّ امتناناً شديداً، لكن لا أستطيع
الاعتماد على سخائك

140
00:14:20,520 --> 00:14:24,170
أعي بأنّ هذا مُفاجئ. لا بدّ أنّك مُشوَّش

141
00:14:24,570 --> 00:14:26,760
لكن فكّر في الأمر مليّاً

142
00:14:26,760 --> 00:14:33,430
سواء عملت أو بقيت في المدرسة، ستكون
أختك بمفردها طوال اليوم

143
00:14:33,940 --> 00:14:39,140
إذا انضممت إليّ هنا، يمكنني
أن أوفّر لها طبيباً جيّداً

144
00:14:39,730 --> 00:14:47,450
يمكنني أن أجد لك مُدرّساً بل وأوفّر لك
رخصة إلى الأرشيف المركزيّ

145
00:14:48,520 --> 00:14:49,900
...وأيضاً

146
00:14:50,910 --> 00:14:57,160
ستكون لك حرّية التصرّف في استخدام
الشّعلة السّماويّة الّتي تركَها والدُك

147
00:14:57,860 --> 00:15:12,430
شعلة سماويّة

148
00:15:00,260 --> 00:15:08,710
أخبرَني هايجو ذات مرّة بأنّه خزّنَ شعلةَ
سماويّة في منزله لأجل يوم ماطر

149
00:15:09,280 --> 00:15:17,930
رغم أنّه بالقانون، يجب على كافّة الشّعلات السّماويّة
ونيران الوحوش أن تُسلّم لحُكّامنا، العشائر الإلهيّة

150
00:15:09,510 --> 00:15:20,440
العشائر الإلهيّة

151
00:15:19,010 --> 00:15:26,430
كوشي، غادرَ والدُك العاصمة لأنّه
شعر بأنّ الزّمن يتغيّر

152
00:15:26,430 --> 00:15:30,400
حكومة هذه البلد على شفير انهيارها غالباً

153
00:15:31,150 --> 00:15:37,800
يجب أن تكون على دراية بهذا. بخلاف النّار
،المحصودة من الوحوش في غابة الظّلام

154
00:15:38,200 --> 00:15:42,870
مصدر الشّعلة السّماويّة هو وحوش الهواء

155
00:15:39,910 --> 00:15:46,540
وحوش الهواء

156
00:15:43,590 --> 00:15:49,390
وهي أكثر فعّاليّة بكثير من نار الوحش العاديّة

157
00:15:49,390 --> 00:15:52,620
إنّها لا تشتعل. إنّها تنفجر

158
00:15:52,620 --> 00:15:55,510
حتّى القليل منها يشكّل وقوداً ممتازاً

159
00:15:56,000 --> 00:16:01,180
وقلّة من نخبة صيّادي النّار فقط
مَن يستطيعون النّيل من وحوش الهواء

160
00:15:58,520 --> 00:16:01,180
صيّادو النّار

161
00:16:01,180 --> 00:16:04,780
صيّادون مثل أبيك، هايجو

162
00:16:05,610 --> 00:16:11,790
مع الأسف، استخدام الشّعلة السّماويّة
يفوق قدرات الفنّيين في مصنعي

163
00:16:11,790 --> 00:16:18,370
لكن أؤمن بأنّك تستطيع إعادة اختراع
البرق المُعبَّأ لغاية جديدة

164
00:16:19,410 --> 00:16:22,840
نوع جديد من البرق المُعبّأ؟

165
00:16:23,290 --> 00:16:31,800
البرق المُعبَّأ

166
00:16:24,530 --> 00:16:28,510
اصرف كلّ الأموال والمواد الّتي تحتاجها

167
00:16:28,510 --> 00:16:36,090
أشارِك هاجسَ والدك. هذه الدّولة ستترنّح قريباً

168
00:16:38,620 --> 00:16:44,120
عندما يحدث ذلك، نحتاج القوّة للدّفاع
عن أنفسنا وعن قُرانا

169
00:16:45,650 --> 00:16:48,000
أجبني عن سؤال واحد رجاء

170
00:16:48,000 --> 00:16:53,180
لماذا أنا من عليه استخدام الشّعلة السّماويّة؟
ألن يكون من الأفضل أن يفعل ذلك خبير؟

171
00:16:53,740 --> 00:16:59,930
هذا خطير، وما زلتُ تلميذاً. معرفتي محدودة

172
00:17:00,830 --> 00:17:07,480
إذا ساعدتَ أختي، سيكون من دواعي سروري
أن أعطيك الشّعلة السّماويّة الّتي تركَها أبي

173
00:17:08,930 --> 00:17:13,790
لا، أشكُّ في أنّ هناك من هو
أفضل منك لهذه المهمّة

174
00:17:13,790 --> 00:17:18,140
سامحني، لكن سمحتُ لنفسي أن أتحرّى عنك

175
00:17:18,740 --> 00:17:26,760
لم تُولَد ثريّاً، لكن تلقّيتَ منحةً دراسيّةً للأكاديميّة

176
00:17:26,760 --> 00:17:32,110
:لأنّهم رأوا أنّك تمتلك موهبة يفتقر لها الآخرون

177
00:17:32,110 --> 00:17:37,160
ليست إمكانيّة التعلّم فحسب، بل
إمكانيّة ابتكار أشياء جديدة

178
00:17:37,970 --> 00:17:42,470
وفوق كلّ شيء، تلك النّار هي إرث والدك

179
00:17:43,080 --> 00:17:46,580
توكو

180
00:18:13,070 --> 00:18:16,030
...مهلاً، نحن نفطر

181
00:18:19,720 --> 00:18:21,550
أنت كلبُ صيدٍ جيّد

182
00:18:21,550 --> 00:18:24,240
أنا ذاهب للصّيد. انضمّ لي

183
00:18:26,040 --> 00:18:29,430
تعال. اصطد مع كلب صيدي يا إيزومو

184
00:18:45,110 --> 00:18:49,810
.نحتاج فقط ما يكفي لنتدبّر أمورنا
لا تبالغ كثيراً. كُن حذراً

185
00:18:50,400 --> 00:18:54,820
نحن لا نعمل إلّا لأنّ هناك خطر

186
00:18:54,820 --> 00:18:58,970
من يعتقد نفسه؟ لا أستطيع تحمّله

187
00:19:00,100 --> 00:19:01,280
!يا للهول

188
00:19:01,840 --> 00:19:04,660
اختفت كاهو! أظنّها خرجَتْ

189
00:19:10,200 --> 00:19:12,680
!ما مُشكلة تلك الفتاة؟

190
00:19:14,530 --> 00:19:15,500
!كاناتا

191
00:19:18,760 --> 00:19:22,760
!من فضلكن اتركنَ هذا مفتوحاً
!سوف أعيد كاهو

192
00:19:25,990 --> 00:19:27,100
!توكو

193
00:19:35,400 --> 00:19:38,740
!كاهو

194
00:19:40,110 --> 00:19:42,340
!كـ-كاهو

195
00:20:19,360 --> 00:20:20,620
كاناتا

196
00:20:37,440 --> 00:20:39,300
!كـ-كاهو

197
00:20:58,440 --> 00:21:00,830
!كاناتا! إيزومو! أحسنتُما صنعاً

198
00:21:39,140 --> 00:21:40,680
!بلهاء

199
00:21:41,460 --> 00:21:45,740
سأوبّخ الفتاةَ الأخرى أيضاً إذا لم تتأذّ

200
00:21:49,080 --> 00:21:50,950
لا تُزمجِر في وجهي

201
00:21:51,240 --> 00:21:54,410
هذه الطفلة ليست سيّدتك

202
00:21:54,890 --> 00:21:58,880
إنّها مُرافقتك إلى العاصمة فحسب

203
00:22:00,640 --> 00:22:02,600
لا تخرجي من دون إذن

204
00:22:03,280 --> 00:22:07,640
حياة طاقمنا بأكمله تعتمد على قوانيننا

205
00:22:10,550 --> 00:22:14,390
آسف يا صغيرة، لكن لا أستطيع إبقاءكِ على متن القطار

206
00:22:14,980 --> 00:22:18,010
انزلي في القرية التّالية مع إحدى العرائس