1
00:00:02,060 --> 00:00:06,570
صيّاد النّار هايجو أنقذَ توكو ثمّ هلك أمام ناظريها

2
00:00:07,150 --> 00:00:11,280
ابنه، كوشي، وُضِع تحت رعاية
عائلة أوكيبي الثريّة

3
00:00:11,920 --> 00:00:16,890
تشقُّ توكو طريقها نحو العاصمة
رفقة كلب هايجو، كاناتا

4
00:00:20,620 --> 00:00:31,550
صيّاد النّار

5
00:01:50,450 --> 00:01:52,960
آمل أن يُعجبك

6
00:01:52,960 --> 00:01:57,830
مع الأسف، جهته غربيّة، لذا لا تتسلّط
عليه أشعّة الشّمس كثيراً. آسف بشأن ذلك

7
00:02:00,070 --> 00:02:07,340
أريدك وأريد من أختك أن تعتبرا هذا منزلكما

8
00:02:07,340 --> 00:02:11,230
،أستأذن الآن. لديّ عمل بعد ظهر اليوم

9
00:02:11,230 --> 00:02:14,870
لكن سنتعشّى مع زوجتي وابنتي اللّيلة

10
00:02:28,600 --> 00:02:30,230
هل يمكنني الدّخول؟

11
00:02:35,720 --> 00:02:38,140
آسفة لأنّني لم أرحّب بك قبل مدّة

12
00:02:38,600 --> 00:02:43,990
تمنّيتُ أن ألتقي بأمّك، لكن
لم تخرج من غرفتها بعد

13
00:02:49,170 --> 00:02:52,710
كيف حالك؟ اسمي كيرا. أنا فرد من عائلة أوكيبي

14
00:02:53,110 --> 00:02:55,270
كيرا

15
00:02:57,950 --> 00:03:02,990
يريد الطبيبُ رؤيتك بخصوص تشخيص حالة أختك

16
00:03:09,720 --> 00:03:11,870
ها هو يا طبيب

17
00:03:12,550 --> 00:03:14,920
اسمي تاكيمي، الطبيب الرّئيسي لعائلة أوكيبي

18
00:03:16,550 --> 00:03:19,510
تاكيمي

19
00:03:17,970 --> 00:03:20,790
أنا أخو هيناكو، كوشي

20
00:03:22,470 --> 00:03:25,580
هذه حالة واضحة لعدوى جنينيّة

21
00:03:26,570 --> 00:03:33,400
بصراحة، لا يوجد علاج حقيقيّ لحالتها مع الأسف

22
00:03:33,870 --> 00:03:39,900
،لكن بالتّغذية الصحّية والبيئة النّظيفة
ينبغي أن تستعيد قوّتها

23
00:03:40,960 --> 00:03:43,820
تناولت الكثير من المُسكّنات، أليس كذلك؟

24
00:03:44,850 --> 00:03:46,920
ستُزيد حالتَها سوءاً ليس إلّا

25
00:03:47,370 --> 00:03:53,350
مُعظم الأطفال ذوي العدوى الجنينيّة
يرخضون عن عمر مُبكّر جدّاً

26
00:03:53,870 --> 00:03:56,790
لا بدّ أنّ هيناكو فتاة قويّة

27
00:03:56,790 --> 00:03:58,520
قويّة؟

28
00:03:58,520 --> 00:04:04,050
في حالات كحالة هيناكو، المُضاعفات
من العدوى تشكّل الخطر الأكبر

29
00:04:04,050 --> 00:04:10,310
ينبغي أن تكون أكثر أماناً هنا. إنّه بعيد
عن منطقة المصنع، والهواء نقيّ

30
00:04:10,720 --> 00:04:16,060
سأبدأ بمُعالجة أعراضها بتفانٍ
حالما تسترجع قوّتها

31
00:04:16,480 --> 00:04:22,020
،حدّثَني عميد المنزل عن أمّك
أقدّم أحرّ التّعازي

32
00:04:22,510 --> 00:04:25,420
من فضلك لا تخف على أختك

33
00:04:25,420 --> 00:04:28,090
سأبذل قصارى جهدي لمُعالجتها

34
00:04:36,980 --> 00:04:40,200
الطبيب تاكيمي رائع، أليس كذلك؟

35
00:04:40,200 --> 00:04:44,460
شكراً على تكبّدكم عناء أمثالنا. أنا مُمتنّ

36
00:04:44,460 --> 00:04:47,400
من فضلك لا تكُن رسميّاً

37
00:04:49,110 --> 00:04:54,300
لأصدقك القول، عشتُ وترعرعتُ
وحيدة في هذا المنزل

38
00:04:55,310 --> 00:04:57,590
يسرّني أنّكما أتيتُما. وكأنّني حصلتُ على أشقاء

39
00:04:58,150 --> 00:05:01,850
تُدعى أختك هيناكو، أليس كذلك؟ هذا اسم جميل

40
00:05:03,800 --> 00:05:05,940
بماذا تريدني أن أناديك؟

41
00:05:06,960 --> 00:05:08,120
كوشي

42
00:05:08,120 --> 00:05:09,580
كيف يُكتَب؟

43
00:05:17,520 --> 00:05:21,080
"كو" تعني "إمبراطور" و"نار

44
00:05:25,930 --> 00:05:28,540
شي" هي الرّقم 4. كوشي"

45
00:05:29,270 --> 00:05:30,890
يا له من اسم رائع

46
00:05:31,340 --> 00:05:36,200
"إنّ "كو" تعني "توهُّج عظيم" و"شي
"تعني "الأمان والكمال

47
00:05:31,760 --> 00:05:36,770
كوشي

48
00:05:37,660 --> 00:05:38,960
كمال"؟"

49
00:05:38,960 --> 00:05:46,310
إنّ الأرقام في أسماء الرّجال لا تعكس
ترتيب ميلادهم. كلّ واحد له معنى

50
00:05:42,820 --> 00:05:45,990
كوشي

51
00:05:45,990 --> 00:05:47,030
كو

52
00:05:45,990 --> 00:05:59,290
شي

53
00:05:46,360 --> 00:05:59,290
أربعة

54
00:05:47,320 --> 00:05:59,290
واحد

55
00:05:47,320 --> 00:05:59,290
إتشي

56
00:05:47,600 --> 00:05:50,250
"واحد تعني "الأوّل والأفضل

57
00:05:50,200 --> 00:05:59,290
اثنان

58
00:05:50,200 --> 00:05:59,290
ني

59
00:05:50,800 --> 00:05:53,600
"واثنان تعني "الرّاحة واللّطف

60
00:05:52,830 --> 00:05:59,290
ثلاثة

61
00:05:52,830 --> 00:05:59,290
سان

62
00:05:53,600 --> 00:05:56,320
"ثلاثة تعني "قدر ما يلزم

63
00:05:56,320 --> 00:05:59,290
حقّاً؟ لم أكن أعلم ذلك

64
00:05:59,600 --> 00:06:07,000
يبدو أنّ النّاس بدؤوا بهذا العرف
في فترة ما بعد فقدان النّار الطبيعيّة

65
00:06:07,000 --> 00:06:09,530
كان ذلك يعني الكثير آنذاك، لكن
لا أحد يتذكّر الآن

66
00:06:09,530 --> 00:06:11,800
أين تعلّمتِ ذلك؟

67
00:06:12,540 --> 00:06:17,730
.مُعلّمي، السيّد كوهاتشي، هو من علّمني
إنّه مُذهل. يعرف كلّ شيء

68
00:06:18,480 --> 00:06:20,940
عمري 16. ماذا عنك؟

69
00:06:21,370 --> 00:06:23,470
عمري 15. أصغر بعام

70
00:06:23,470 --> 00:06:25,690
ألا ترتادين المدرسة يا كيرا؟

71
00:06:29,170 --> 00:06:34,870
أردتُ ذلك، لكن قرّر والدايّ أنّني
ينبغي أن أحظى بمُعلّم بدلاً من ذلك

72
00:06:35,360 --> 00:06:39,480
أنا طفلة فقط، لذا سوف أرِث المصنع يوماً ما

73
00:06:40,690 --> 00:06:42,580
أشكّ في ذلك

74
00:06:45,080 --> 00:06:49,010
هل أفهم أنّ هذا هو أخوكِ الجديد؟

75
00:06:52,400 --> 00:06:53,540
أمّي

76
00:06:54,140 --> 00:06:59,720
أنا زوجة يوشيتشي. سامحني على
عدم التّرحيب بك قبلاً

77
00:06:59,720 --> 00:07:04,630
غُمِرَتْ ابنتي بالسّعادة منذ
عَلِمَتْ بأنّكما قادمان

78
00:07:06,710 --> 00:07:09,700
كيرا، لا ترسمي الوقائع من مخيّلتك

79
00:07:10,800 --> 00:07:14,660
قد لا تكونين الوريثة المُحتملة الوحيدة

80
00:07:15,600 --> 00:07:18,600
أجل. أنا آسفة يا أمّي

81
00:07:18,600 --> 00:07:20,120
سأذهب للرّاحة

82
00:07:20,820 --> 00:07:23,450
لا تزعجيني حتّى العشاء

83
00:07:29,510 --> 00:07:31,390
هل هي على ما يُرام؟

84
00:07:31,390 --> 00:07:33,980
الأمر ليس كذلك. أعتذر بالنيابة عنها

85
00:07:33,980 --> 00:07:36,810
لم تعرّفك أمّي على اسمها حتّى

86
00:07:38,000 --> 00:07:42,060
هيبانا

87
00:07:39,540 --> 00:07:42,060
اسم أمّي هو هيبانا

88
00:07:42,550 --> 00:07:44,460
ليست مريضة أو ما شابه

89
00:07:44,460 --> 00:07:50,360
،تقول بأنّها عاشت طفولة قاسية
لكنّها تخلد إلى نومها أحياناً

90
00:07:50,840 --> 00:07:52,860
لكنّها في العادة نابضة في الحياة

91
00:07:54,080 --> 00:07:56,000
يسرّني أنّها ليست مريضة

92
00:07:56,000 --> 00:08:00,620
أمّي وأمّ هيناكو توفّيت بسبب سموم المصنع قبل أيّام

93
00:08:02,770 --> 00:08:08,300
ما الّذي أفكّر فيه وأنا أحتفل بينما
فقدتُما أمّكما مؤخّراً؟

94
00:09:16,110 --> 00:09:17,860
توكو

95
00:09:21,590 --> 00:09:25,070
جروح المخلب عميقة لكن ليست قاتلة

96
00:09:25,070 --> 00:09:28,380
لو عضّها، لكانت في عداد الموتى

97
00:09:28,770 --> 00:09:31,660
إنّ الوقوف هنا قلَقاً لن يجعلها تتحسّن

98
00:09:32,080 --> 00:09:35,340
طلب منك المُدير النّزول في القرية
التّالية، أتتذكّرين ذلك؟

99
00:09:35,950 --> 00:09:38,890
أنا حزين لأجلك، لكن هكذا تجري الأمور هنا

100
00:09:38,890 --> 00:09:42,400
جميعنا نحرص على بقاء بعضنا الآخر هنا

101
00:09:42,810 --> 00:09:46,900
أيّ شخص لا يستطيع فعل ذلك
يجب عليه الرّحيل، ولو كان طفلاً

102
00:09:48,920 --> 00:09:50,330
!كاهو، أيّتها الحمقاء

103
00:09:50,330 --> 00:09:53,180
!لا نريد الزواج مثلكِ تماماً

104
00:09:53,180 --> 00:09:55,690
!لكن لم تشتكي أبداً! تسلّلتِ للخارج فحسب

105
00:09:56,090 --> 00:09:58,360
!ماذا لو مُتِّ؟

106
00:09:58,880 --> 00:10:00,230
!توكو

107
00:10:00,230 --> 00:10:03,640
هذه كدمة فظيعة. هل ضربَكِ أحد؟

108
00:10:04,340 --> 00:10:07,130
سمعتُ الأنباء من أحد أفراد الطّاقم فحسب

109
00:10:07,130 --> 00:10:11,120
هل ستنزلين حقّاً في قرية الحبّاك معي؟

110
00:10:11,120 --> 00:10:14,630
!هذا غير عقلانيّ! خرجتْ توكو لإنقاذ كاهو

111
00:10:15,020 --> 00:10:17,090
سأذهب وأتكلّم معهم

112
00:10:17,470 --> 00:10:18,680
!بينيو

113
00:10:20,760 --> 00:10:24,160
لا أعلم ما الّذي تتأمّلين منه فعله بشأن ذلك

114
00:10:24,160 --> 00:10:27,520
لا يجوز أن ترموها في الخارج فقط
لأنّها حاولت إنقاذ أحد

115
00:10:28,000 --> 00:10:31,160
،أعلم بأنّ أهل القُرى مُلتزمون بمسؤوليّاتهم

116
00:10:31,160 --> 00:10:35,750
لكن المُدير ليس غاضباً لأنّ الطفلة خرجت

117
00:10:36,870 --> 00:10:40,490
لم تُغلِق البابَ خلفها، صحيح؟

118
00:10:41,280 --> 00:10:43,840
طلبَتْ منّا تركه مفتوحاً

119
00:10:43,840 --> 00:10:46,500
بعض الوحوش أشقياء سريعون

120
00:10:47,400 --> 00:10:52,740
هل تعلمين ماذا سيحدث لو تسلّل
أحدهم إلى الدّاخل هنا؟

121
00:10:53,210 --> 00:10:55,860
سنكون مُستضعفين تماماً في هذه الأماكن الضيّقة

122
00:10:56,530 --> 00:11:00,770
أنتِ وأنا والجميع سنُذبَح ويُسفَك دماؤنا

123
00:11:00,770 --> 00:11:01,680
ماذا؟

124
00:11:02,060 --> 00:11:06,940
فضلاً عن ذلك، ألم تلحظي أنّ تلك
الفتاة كاهو كانت تُقدِم على شيء؟

125
00:11:06,940 --> 00:11:09,920
!بالطبع لا! وإلّا كنّا أوقفناها

126
00:11:09,920 --> 00:11:13,080
أو هربنا معها

127
00:11:14,400 --> 00:11:16,650
سأحاول تلطيف الأمور مع المُدير

128
00:11:18,430 --> 00:11:21,930
المُدير والصيّاد لا يفهمان ذلك فحسب

129
00:11:21,930 --> 00:11:27,080
إذا حاولنا طرد تلك الطفلة، لن يقبل
ذلك الكلب الأمر بلا مُقاومة

130
00:11:27,560 --> 00:11:30,090
دعي الأمر لي. لن أخذلكِ

131
00:11:40,470 --> 00:11:42,010
إنّها تستغرق وقتها

132
00:11:42,010 --> 00:11:44,930
دعيها. إنّه يوم مُميّز

133
00:12:04,950 --> 00:12:07,060
ما زلتُن تتجهّزن؟

134
00:12:10,010 --> 00:12:12,300
هديّة وداع للعروس

135
00:12:14,200 --> 00:12:16,620
لا تُخبري بقيّة أفراد الطاقم

136
00:12:16,620 --> 00:12:19,670
هل أنتِ متأكّدة؟ هذه للبيع

137
00:12:20,120 --> 00:12:23,210
لهذا أطلب منكِ التكتّم على الأمر

138
00:12:23,210 --> 00:12:27,320
لم أقبل بخروجكِ ومعكِ الشّيء اليسير

139
00:12:27,320 --> 00:12:30,100
سأبيع شيئاً آخر بسعر مُضاعَف فحسب

140
00:12:30,560 --> 00:12:33,060
ولا تقلقي

141
00:12:33,440 --> 00:12:38,200
ما زالت هذه الفتاة نائمة بفعل الدّواء، لكنّها ستعيش

142
00:12:38,200 --> 00:12:42,030
كانت قويّة بما يكفي للتسلّل إلى
،أسفل الشّاحنة

143
00:12:42,030 --> 00:12:44,030
لذا ستنهض وتتعافى خلال وقت قصير

144
00:12:46,740 --> 00:12:49,530
هل ستعطينني شيئاً عندما يحين دوري يا عمّة؟

145
00:12:50,040 --> 00:12:54,360
ربّما. إذا وجدتُ شيئاً يلائم ريفيّة مثلكِ

146
00:12:55,170 --> 00:12:58,700
تذكّرت. نجت الطّفلة

147
00:12:58,700 --> 00:13:01,610
تستطيع هي والكلب البقاء معنا
كلّ الطريق إلى العاصمة

148
00:13:02,760 --> 00:13:04,910
!أنا مسرورة لأجلكِ يا توكو

149
00:13:04,910 --> 00:13:09,070
أعتقد شوزو ذاك أنقذكِ فعلاً

150
00:13:09,070 --> 00:13:12,980
أنا مسرورة جدّاً يا توكو. هذا رائع، أليس كذلك؟

151
00:13:18,850 --> 00:13:20,230
جميلة

152
00:13:20,840 --> 00:13:23,160
معكِ حقّ. إنّها باهرة الجمال

153
00:13:23,160 --> 00:13:26,200
من يتزوّجكِ ينبغي أن يشكر حظّه يا هوتارو

154
00:13:30,020 --> 00:13:35,080
بينيو. توكو. أنا مسرورة لأنّني عرفتُكما

155
00:13:44,520 --> 00:13:48,980
كان اللّقاء بكما نعمة

156
00:13:50,450 --> 00:13:54,170
قضينا معاً فترة قصيرة فقط، لكن أنا مُمتنّة حقّاً

157
00:13:54,800 --> 00:13:58,600
آمل أن تكونا سعيدتين وبأمان

158
00:14:00,100 --> 00:14:04,780
لم تتمكّن توكو وبينيو من رؤية هوتارو تتزوّج

159
00:14:14,880 --> 00:14:21,160
هل كانت المراسم ضخمة بما يكفي لتسميتها زفافاً؟

160
00:14:22,440 --> 00:14:26,600
هل كانت العروس مُرحّباً بها حتّى في ديارها الجديدة؟

161
00:14:26,600 --> 00:14:30,070
لم يكن أحدٌ يعلم

162
00:14:35,970 --> 00:14:41,480
كوشي

163
00:14:36,880 --> 00:14:41,480
،قلّ من النّاس يعلمون بهذه الغرفة
حتّى بين أفراد عائلتي

164
00:14:42,120 --> 00:14:46,560
طلبتُ إحضار مخزون والدك من الشّعلة السّماويّة إلى هنا

165
00:15:00,160 --> 00:15:04,130
هنا أريدك أن تصنع البرق المُعبَّأ

166
00:15:16,340 --> 00:15:18,060
هلّا طرحتُ سؤالاً؟

167
00:15:18,700 --> 00:15:22,440
...قلتَ بأنّ هذه البلد ستسقط، ولهذا السّبب أبي

168
00:15:24,110 --> 00:15:27,610
لهذا دخلَ الغابة بمفرده دون أن يخبر زملاءه الصيّادين

169
00:15:29,090 --> 00:15:30,650
لكن لماذا سيفشل ذلك؟

170
00:15:31,410 --> 00:15:35,140
ما الّذي سيهدّد حكم العشائر الإلهيّة؟

171
00:15:39,950 --> 00:15:42,120
ما الّذي سيحدث؟

172
00:15:42,680 --> 00:15:45,360
هل سمعتَ بالعناكب؟

173
00:15:45,360 --> 00:15:50,540
قال أبي بأنّهم أكثر خطورة بكثير
على الصّيادين مقارنة بالوحوش

174
00:15:51,090 --> 00:15:56,550
العناكب

175
00:15:51,680 --> 00:15:55,970
،رغم أنّهم كانوا جزءاً من العشائر الإلهيّة

176
00:15:55,970 --> 00:15:59,930
إلّا أنّهم الآن يقبعون في الغابة
ويخطّطون لإسقاط حكم العاصمة

177
00:16:00,690 --> 00:16:03,320
إذاً ستبدأ العناكب بتحرّكاتها؟

178
00:16:04,300 --> 00:16:09,130
...لكن إذا تمرّدوا، فإنّ العشائر الإلهيّة الّتي تحكمنا سوف

179
00:16:09,130 --> 00:16:15,340
تحكمنا؟ أجل، يفعلون ذلك حتماً

180
00:16:17,910 --> 00:16:20,370
نار

181
00:16:17,910 --> 00:16:20,370
ماء

182
00:16:17,910 --> 00:16:20,370
رياح

183
00:16:17,910 --> 00:16:20,370
أرض

184
00:16:17,910 --> 00:16:20,370
خشب

185
00:16:21,730 --> 00:16:29,610
لدى العشائر الإلهيّة قوّة غريبة تفوق
النّار والماء والخشب والأرض والرّياح

186
00:16:22,870 --> 00:16:30,760
نار

187
00:16:22,870 --> 00:16:30,760
ماء

188
00:16:22,870 --> 00:16:30,760
رياح

189
00:16:22,870 --> 00:16:30,760
أرض

190
00:16:22,870 --> 00:16:30,760
خشب

191
00:16:31,240 --> 00:16:36,470
أظنّك سمعتَ بالنّار العظيمة الّتي
سبقَ ودمّرت العاصمة

192
00:16:37,150 --> 00:16:40,240
كان ذلك قبل ولادتك بكثير بالطبع

193
00:16:40,240 --> 00:16:42,980
أعرف ما تعلّمتُه في المدرسة

194
00:16:43,990 --> 00:16:50,400
في مصنع جديد كلّياً، وقعَ انفجار ليس
من نار الوحوش، بل من نار طبيعيّة

195
00:16:58,500 --> 00:17:05,790
انتشرَ من شخص لأآخر في الحيّ
السّكني المُزدحم بالنّاس

196
00:17:05,790 --> 00:17:13,360
امتلأت قنوات المدينة بجثث النّاس
الّذين حاولوا الفرار من اللّهب

197
00:17:15,430 --> 00:17:21,310
الآلهة مالِكو الماء أخمدوا أخيراً
،اللّهب باستدعاء عاصفة ماطِرة

198
00:17:21,310 --> 00:17:23,060
لكن كانوا قد تأخّروا كثيراً

199
00:17:23,550 --> 00:17:27,500
كان كثير من النّاس قد ماتوا سلفاً
ليحترقوا كما الشّعلة

200
00:17:27,500 --> 00:17:30,170
كان مشهداً مُروّعاً

201
00:17:31,230 --> 00:17:37,860
وأعتقد بأنّ العشائر لإلهيّة تعمّدت
التأخّر وسمحت بحدوث ذلك

202
00:17:38,530 --> 00:17:40,250
...إذاً تقصد بأنّهم

203
00:17:41,220 --> 00:17:44,010
قلّلت من الفائض السكّاني البشري

204
00:17:44,400 --> 00:17:47,600
دامت حياة الآلهة ثلاثة قرون

205
00:17:47,600 --> 00:17:53,290
يتحكّمون بالطبيعة ويمتلكون التّكنولوجيا القديمة

206
00:17:53,290 --> 00:17:57,010
إذاً لماذا يتركون البشر يتسمّمون بواسطة المصانع؟

207
00:17:58,150 --> 00:18:03,970
أرسلتُ صيّادي نار موثوقين للتحرّي
،في قضيّة العناكب سرّاً

208
00:18:03,970 --> 00:18:07,190
لكن لم يتوصّلوا إلى معلومة حاسمة بعد

209
00:18:07,190 --> 00:18:12,200
رغم ذلك، أيّاً كان ما يفعلونه يسبّب
فوضى في العاصمة بلا شكّ

210
00:18:13,350 --> 00:18:20,040
سنكون حمقى إذا اعتمدنا على آلهة
قاموا بقتلنا لتقليل عددنا كما الحشائش

211
00:18:20,420 --> 00:18:25,620
نحتاج أسلحة قويّة للدفاع عن أنفسنا بأيدينا

212
00:18:28,440 --> 00:18:29,580
سأفعل ما يمكنني فعله

213
00:18:29,980 --> 00:18:31,290
أعلّق آمالاً كبيرة عليك

214
00:18:32,020 --> 00:18:34,710
وأبقِ هذا سرّاً بينن

215
00:18:35,120 --> 00:18:37,470
لن أخبر أحداً البتّة

216
00:18:37,950 --> 00:18:41,220
سجّلتُك لدى الأرشيف المركزيّ

217
00:18:41,220 --> 00:18:46,930
ينبغي أن تحظى بصلاحيّة وصول
كاملة بعد غد على الأقلّ

218
00:18:50,850 --> 00:18:53,360
توكو

219
00:18:53,360 --> 00:18:55,320
1

220
00:19:25,310 --> 00:19:28,220
1

221
00:19:28,220 --> 00:19:33,610
2

222
00:19:42,140 --> 00:19:42,990
ما الأمر؟

223
00:19:46,830 --> 00:19:49,000
2

224
00:19:51,640 --> 00:19:52,460
شوزو

225
00:19:53,000 --> 00:19:55,020
سوف نتزوّد بالوقود هنا

226
00:19:55,620 --> 00:19:57,960
هل ذهبَ كاناتا لمساعدة إيزومو؟

227
00:19:58,320 --> 00:20:00,380
خرجَ كاناتا مسرعاً

228
00:20:00,380 --> 00:20:04,470
هكذا هم كلاب الصّيد. بأعلى انسجام من الآن

229
00:20:04,470 --> 00:20:06,430
2

230
00:20:06,970 --> 00:20:08,730
واجهتِ وقتاً عصيباً قبل أيّام

231
00:20:10,470 --> 00:20:14,150
لا تلقي بالاً للمدير

232
00:20:14,150 --> 00:20:18,480
إنّه عصبيّ، لكن أخبرني بأنّه مُنبهر
بمدى عملكِ الجبّار

233
00:20:18,810 --> 00:20:19,390
ماذا؟

234
00:20:20,270 --> 00:20:22,560
قال بأنّكِ أكثر نفعاً منّي

235
00:20:22,560 --> 00:20:27,030
من يعتقد بأنّه يحافظ على استمراريّة عمل الشّاحنة؟

236
00:20:28,950 --> 00:20:32,790
سمعتُ بأنّنا ما زلنا لا نعرف حقيقة نار الوحش

237
00:20:32,790 --> 00:20:40,260
لكن يمكننا تشغيل هذه الشّاحنة الكبيرة
باستخدامها لغلي الماء ببخار عالي الضّغط

238
00:20:40,750 --> 00:20:43,880
قديماً، كانوا يخلطون الوقود
،والهواء لإحداث انفجار

239
00:20:43,880 --> 00:20:47,320
ويستخدمون الطاقة لتشغيل مُختلَف الآليّات

240
00:20:49,040 --> 00:20:53,680
لكن إذا جرّبنا ذلك الآن، سرعان ما سنحترق

241
00:20:54,140 --> 00:20:58,400
الآن بعد أن انضمّ كاناتا له، أينزين
لا يستهدف إلّا الفرائس الكبيرة

242
00:20:58,760 --> 00:21:02,020
—لذا ليس علينا التّقنين في استخدام الماء المغلي

243
00:21:03,980 --> 00:21:05,780
...ما-ماذا

244
00:21:05,780 --> 00:21:08,730
!شوزو! سأعود للعربة 2

245
00:21:08,730 --> 00:21:13,150
أشعل كلّ خزّانت النّار وذلك كي نتمكّن
!من الإسراع والخروج من هنا بأسرع وقت

246
00:21:13,150 --> 00:21:17,250
،أينجي! الكلام أسهل من الفعل
...لكن فصلتُ الخزّان 2 للتو كي

247
00:21:17,600 --> 00:21:20,420
!اللّعنة! ما الّذي يجري؟

248
00:21:19,630 --> 00:21:21,960
!إلى كافّة العمّال، حالة طارئة! في مواقعكم

249
00:21:21,960 --> 00:21:24,650
!احذروا، ابقوا يقظين
!ثمّة شيء في الخارج

250
00:21:22,780 --> 00:21:24,650
!مِدفعيّو الجزء العلوي، تحرّكوا

251
00:21:24,650 --> 00:21:25,630
!مِدفعيو الميسرة، قادمون

252
00:21:38,980 --> 00:21:40,340
!بينيو

253
00:21:40,980 --> 00:21:43,620
ما-ما هذا الشّيء؟