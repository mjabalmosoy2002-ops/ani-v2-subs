1
00:00:03,990 --> 00:00:09,290
صيّادة النّار المُتجوّلة آكيرا، وفتى
،العنكبوت المهجور كون

2
00:00:09,290 --> 00:00:13,990
انضمّا لكاهو وشوزو كشريكَين لتوكو

3
00:00:16,240 --> 00:00:23,710
رحلتُها إلى العاصمة رفقة كلب
الصّيد كاناتا شارفتْ على نهايتها

4
00:00:28,630 --> 00:00:39,560
صيّاد النّار

5
00:02:25,240 --> 00:02:29,540
إنّه حوت القبر، إله البحر

6
00:02:29,820 --> 00:02:31,960
إله بحر؟

7
00:02:31,960 --> 00:02:35,670
يُقال بأنّه يحرس البشر الموتى

8
00:02:36,140 --> 00:02:41,470
يحمل جسد حوت القبر ذكريات الموتى

9
00:02:42,550 --> 00:02:44,820
يريد هذا الشّخص أن يموت إذاً؟

10
00:02:45,730 --> 00:02:48,720
أنا أحميه. لن يموت أمام ناظرَي

11
00:02:48,720 --> 00:02:49,930
!ليس هو

12
00:02:50,720 --> 00:02:54,860
!ليس هذا الرّجل! لن ينضمّ إليك بعد

13
00:03:33,940 --> 00:03:38,400
كوشي وصيّاد النّار

14
00:03:36,230 --> 00:03:38,400
وصلت إلى هنا أبكر ممّا توقّعت

15
00:03:40,470 --> 00:03:41,860
ماذا عن المُراقبين؟

16
00:03:41,860 --> 00:03:45,910
عرفتُ بأنّك ستأتي، لذا طلبتُ
منهم أن يأخذوا إجازة

17
00:03:46,620 --> 00:03:50,590
جواسيس القصر هم دُمى يتمّ
التحكّم بها من خلال السّحر

18
00:03:50,960 --> 00:03:53,230
كائنات مُرافِقة بالمعنى الجوهري

19
00:04:00,980 --> 00:04:04,180
ابقَ قريباً منّي أثناء وجودنا في الغابة

20
00:04:04,180 --> 00:04:07,860
إن توخّيت الحذر ولم تنحرف عن طريقك، ستكون بخير

21
00:04:08,320 --> 00:04:10,640
لا أضواء حتّى نصل إلى الغابة

22
00:04:10,940 --> 00:04:12,700
اتبع صوت خُطى ميزوري

23
00:04:13,240 --> 00:04:15,140
،تقول بأنّك أتيت كي تبيع لعائلة أوكيبي

24
00:04:17,490 --> 00:04:22,110
لكن لا يُسمَح لصيّادي النّار أن
يبيعوا النّار بشكل مُستقلّ

25
00:04:22,820 --> 00:04:25,080
كنتُ أتحرّى نواياهم

26
00:04:25,080 --> 00:04:25,820
ماذا؟

27
00:04:26,200 --> 00:04:30,040
السيّد أوكيبي كما الوحش

28
00:04:30,400 --> 00:04:32,710
لا يهتمّ إلّا لنفسه

29
00:04:34,460 --> 00:04:38,420
أنا مندهش من أنّك سمحت لشخص مثله يتبنّاك

30
00:04:42,290 --> 00:04:47,970
أختي مريضة. عندما توفّيت أمّنا، لم يكن
لديّ شخص آخر ألجأ إليه

31
00:04:48,630 --> 00:04:51,060
ألم تكن لديك مُدّخرات؟

32
00:04:51,500 --> 00:04:56,900
والدك صيّاد نار، صحيح؟ وماهر
بما يكفي لصيد وحوش هواء

33
00:04:57,520 --> 00:05:03,740
لماذا يريد مالِك مصنع لحم مُزيّف
إحكام السّيطرة على ابن صيّاد نار؟

34
00:05:03,740 --> 00:05:06,490
ماذا يحاول أن يفعل بالشّعلة السّماويّة؟

35
00:05:19,510 --> 00:05:23,610
،سمعتُ أنّ صيّادي نار العاصمة لا يعملون ليلاً

36
00:05:23,610 --> 00:05:25,980
لكن يمكنك اصطياد المزيد من الفرائس
بعد أن يخيّم الظّلام

37
00:05:26,680 --> 00:05:29,590
ينجذب وحوش النّار إلى الأضواء الصّناعيّة

38
00:05:30,920 --> 00:05:32,650
ابقَ خلفي

39
00:05:51,910 --> 00:05:54,430
يبدو أنّ التّالي قويّ

40
00:05:54,430 --> 00:05:55,700
تراجع يا فتى

41
00:05:57,710 --> 00:06:01,130
!عُد إلى النّفق. تحرّك

42
00:06:41,570 --> 00:06:46,440
.أوّل صيد شهدتَه كان صيداً ليليّاً
أنا واثق بأنّك مصدوم

43
00:06:46,440 --> 00:06:49,670
كيف حصلت على برقٍ مُعلّب انفجاريّ؟

44
00:06:51,360 --> 00:06:52,590
توقّعت

45
00:06:52,590 --> 00:06:53,700
ماذا؟

46
00:06:55,650 --> 00:07:02,730
توقّعتُ أنّ ذلك الشّيطان لم يكن يحتجزك
في قصره كتلميذ عاديّ

47
00:07:07,680 --> 00:07:11,530
صيّادو النّار المُتجوّلون يستخدمون
هذه لإعماء الوحوش

48
00:07:11,530 --> 00:07:16,230
صيّادو العاصمة لا يملكونها. سمعتُ
أنّ رؤساءهم يمنعونها

49
00:07:16,880 --> 00:07:20,540
يبدو أنّ العمل لحساب العاصمة مُزعج

50
00:07:22,630 --> 00:07:23,510
هيّا بنا

51
00:07:54,560 --> 00:07:57,080
التقط ميزوري رائحة ما

52
00:07:57,560 --> 00:07:59,410
غالباً دماء

53
00:08:02,320 --> 00:08:05,960
وليس دماء وحش على ما أعتقد

54
00:08:26,210 --> 00:08:30,690
قد يكون جسدك إلَهيّاً، لكن مع ذلك
لا يمكنك الوقوف بلا قدمين

55
00:08:31,830 --> 00:08:36,160
تكلّم. إذا تكلّمت، سنعينك على النّهوض

56
00:08:45,990 --> 00:08:49,130
يبدو أنّكم توصّلتُم إلى عنكبوت

57
00:08:49,450 --> 00:08:50,760
أعرف هذا الصّوت

58
00:08:51,520 --> 00:08:53,340
ساكن الجزيرة روروكو

59
00:08:54,360 --> 00:08:58,940
ستتكاثر عليكم الوحوش إذا طرطشتم
الكثير من الدّماء في كلّ مكان

60
00:09:00,120 --> 00:09:02,100
حريّ بكم الخروج من هنا ما دامت الفُرصة سانحة

61
00:09:02,500 --> 00:09:04,110
نعلم

62
00:09:04,110 --> 00:09:08,440
لكن نريده أن يخبرنا بشيء أوّلاً

63
00:09:09,430 --> 00:09:10,900
كوشي، أهذا أنت؟

64
00:09:12,530 --> 00:09:16,570
،كوشي، قد تكون ابن هايجو

65
00:09:16,570 --> 00:09:20,410
لكن القانون يمنع أيّ شخص غير
صيّادي النّار من دخول الغابة

66
00:09:22,230 --> 00:09:26,240
،اسمعوا، أعلم أنّني غريب هنا

67
00:09:26,240 --> 00:09:29,670
لكن ألا ينبغي أن تُسلّموه للآلهة؟

68
00:09:30,380 --> 00:09:34,760
ستفوتنا أدسم المعلومات إذا فعلنا ذلك

69
00:09:34,760 --> 00:09:38,060
ومكافأة لا يمكننا الحصول عليها حتّى في أحلامنا

70
00:09:38,060 --> 00:09:41,760
،توقّعت ذلك. أنت تعمل لصالح أوكيبي
السيّد ثريّ بحدّ ذاته

71
00:09:41,760 --> 00:09:48,770
حذّرنا قوم الشّجر نحن طليعة العناكب
سيتسلّلون إلى داخل العاصمة قريباً

72
00:09:48,770 --> 00:09:53,310
يمكنهم مراقبة الأحداث القريبة من
خلال جذور الشّجر

73
00:09:53,310 --> 00:09:56,700
لكن أعتقد أنّ شخصاً جوّالاً مثلك يعرف ذلك سلفاً

74
00:09:56,700 --> 00:10:01,700
حاول هذا الرّجل عبور المُنحدرات إلى
داخل المدينة؟ من تلقاء نفسه؟

75
00:10:02,400 --> 00:10:07,080
إنّه كشّاف. سيتبعه مزيد من العناكب

76
00:10:07,490 --> 00:10:14,640
،حطّمنا وقطّعنا إحدى أرجله
لكن ما زال لن يتكلّم

77
00:10:14,640 --> 00:10:16,220
ربّما هذا دمه الإلهيّ

78
00:10:17,120 --> 00:10:19,970
آسف لأنّك اضطررت لرؤية هذا

79
00:10:20,280 --> 00:10:23,900
ستُصبح عالِماً رفيع المستوى

80
00:10:23,900 --> 00:10:27,980
الوحوش والغابة هما مستوطنة صيّاد النّار

81
00:10:27,980 --> 00:10:31,980
ابقَ بعيداً عنهما واسلك دربك الخاصّ

82
00:10:37,190 --> 00:10:39,400
حصلنا على النّار

83
00:10:41,360 --> 00:10:46,410
نحن العناكب حصلنا على النّار القديمة

84
00:10:47,190 --> 00:10:52,420
معرفة متى سيأتي زملاؤنا ليس كفيلاً بإنقاذنا

85
00:10:52,420 --> 00:10:59,930
نحن العناكب لدينا النّار القديمة. يمكننا
الاقتراب من النّار دون احتراق

86
00:11:00,840 --> 00:11:04,780
أنتم البشر ترتعدون خوفاً من النّار القديمة

87
00:11:04,780 --> 00:11:07,270
لا تملكون فرصة أمامنا

88
00:11:10,100 --> 00:11:16,300
انظروا. دمائي جذبت وحوش النّار إليكم

89
00:11:19,000 --> 00:11:23,070
ما كنّا صيّادي نار لو كان الوحوش يُخيفوننا

90
00:11:23,070 --> 00:11:26,280
لكن هذه ليست وحوشاً عاديّة

91
00:11:26,750 --> 00:11:32,350
الآن بعد أن عضّتها حشراتنا، لم يعودوا
يخشون النّار القديمة

92
00:11:32,350 --> 00:11:34,920
لم نأتِ للصيد اللّيلة

93
00:11:34,920 --> 00:11:39,720
أشكّ في أنّنا سندعه يتكلّم في أيّ
وقت قريب. لنخرج من هنا

94
00:11:40,670 --> 00:11:43,450
هل أنتم مذعورون أيّها البشر؟

95
00:11:43,450 --> 00:11:45,430
لا يجدر بنا البقاء أيضاً

96
00:12:20,760 --> 00:12:23,760
توكو

97
00:13:15,980 --> 00:13:27,410
E

98
00:13:19,240 --> 00:13:23,440
لا أصدّق بأنّك جعلتني أنهض عن
السّرير في مثل هذه السّاعة

99
00:13:24,120 --> 00:13:26,460
أعِدُك بأنّني سأدفع لك أجرك

100
00:13:26,460 --> 00:13:30,960
قالت صيّادة النّار بأنّها ستغطّي التّكاليف سلفاً

101
00:13:30,960 --> 00:13:34,370
أحضَروه إلى هنا في آخر لحظة قبل فوات الأوان

102
00:13:34,370 --> 00:13:37,330
أي تأخّر إضافي كان ليحلّ النّخر

103
00:13:37,950 --> 00:13:42,670
،لن أحتاج لبتر ذِراعه، لكن حالما تُشفَى

104
00:13:45,610 --> 00:13:49,580
ويؤسفني القول بأنّه أعمى في عينه اليمنى

105
00:13:49,580 --> 00:13:53,550
بالنسبة للدم الّذي فقدَه، كلّ ما يمكنني
فعله هو إعطاؤه مُقوٍّ للدم

106
00:13:53,550 --> 00:13:56,430
وأدع الأمر لجسده كي يُقاوم ويصمد

107
00:14:23,320 --> 00:14:25,880
مهما شكرتُك لا يكفي يا طبيب

108
00:14:25,880 --> 00:14:29,070
لن أسأل عمّا حدث

109
00:14:29,070 --> 00:14:31,960
والآن نالي قسطاً من الرّاحة

110
00:14:39,640 --> 00:14:44,110
E

111
00:15:23,720 --> 00:15:26,170
توكو. استيقظت

112
00:15:36,580 --> 00:15:40,630
كون غارق في النّوم، وكذلك الآنسة آكيرا

113
00:15:41,120 --> 00:15:45,830
ما زال أمام آكيرا أشياء تفعلها عندما تستيقظ

114
00:15:46,410 --> 00:15:48,490
ما هي الأشياء؟

115
00:15:49,960 --> 00:15:52,090
وكذلك أنتِ يا توكو

116
00:15:58,470 --> 00:16:00,460
ر-رائحتنا كريهة

117
00:16:00,460 --> 00:16:01,300
ماذا؟

118
00:16:04,120 --> 00:16:06,620
أجل. نحن كذلك

119
00:16:45,570 --> 00:16:48,310
إنّها قديمة ومُستعملة

120
00:16:48,310 --> 00:16:53,780
مع ذلك هذا مُمتع. أشعر وكأنّ
لديّ ابنتان فجأة

121
00:16:54,140 --> 00:16:58,480
هل يمكنني حقّاً الحصول على هذه الملابس؟

122
00:16:58,480 --> 00:17:01,280
لا أمانع ارتداء هذا

123
00:17:02,200 --> 00:17:05,020
حسناً، النّظافة هي الأهمّ

124
00:17:05,020 --> 00:17:07,210
سأذهب لتفقّد شوزو

125
00:17:13,460 --> 00:17:14,740
...المعذرة

126
00:17:15,610 --> 00:17:20,040
قال السيّد شوزو أنّكِ كنتِ مريضة يا سيّدتي

127
00:17:20,040 --> 00:17:25,160
إنّه دُوار الرّماد فحسب يا عزيزتي. يُصاب
به عُمّال المصنع طوال الوقت

128
00:17:25,160 --> 00:17:27,690
حريّ بي أن أشرع في الطبخ

129
00:17:28,240 --> 00:17:31,700
آمل أن يكون لدينا ما يكفي من طعام لنا نحن الستّة

130
00:17:34,070 --> 00:17:41,370
E

131
00:17:34,850 --> 00:17:36,780
وحتّى أنّهم سيُطعموننا

132
00:17:36,780 --> 00:17:40,280
لنفعل ما تقوله يا توكو. احرصي على أكل كفايتكِ

133
00:17:42,220 --> 00:17:48,440
لا بدّ أنّها اكتشفت أنّ كون كان عنكبوتاً
عندما رأت جلد الوحش الخاص به

134
00:17:50,240 --> 00:17:52,220
لكنّه لم تطرده

135
00:17:54,340 --> 00:17:56,300
ينبغي أن نصغي إليها

136
00:17:59,330 --> 00:18:04,220
سوف أتعافى. وأساعد المُمرّضة شوزو

137
00:18:05,830 --> 00:18:08,870
وأنا عليّ البحث عن عائلة كاناتا

138
00:18:11,200 --> 00:18:13,770
!الطعام جاهز يا فتيات

139
00:18:14,220 --> 00:18:15,400
!حسناً

140
00:18:36,940 --> 00:18:37,720
!خذ هذه

141
00:18:37,720 --> 00:18:38,730
!مهلاً

142
00:18:46,910 --> 00:18:50,980
"اعبري القناة عند الجسر بالقرب من المنزل"

143
00:18:50,980 --> 00:18:54,940
"ثمّ اقطعي طريق التلّة المؤدّية إلى الميناء"

144
00:18:55,810 --> 00:18:58,900
"...بعد ستّة شوارع جانبيّة"

145
00:18:59,520 --> 00:19:02,620
"وانعطفي يميناً عند الزاوية الثانية"

146
00:19:05,260 --> 00:19:10,460
انتظر هنا يا كاناتا. سأحضر دواء السيّد شوزو

147
00:19:22,480 --> 00:19:23,960
تفضّلي

148
00:19:23,960 --> 00:19:28,140
المعذرة، أتيتُ لأجل دواء السيّد شوزو

149
00:19:28,140 --> 00:19:31,900
هذا أنتِ. حضّرتُه

150
00:19:34,690 --> 00:19:38,540
صيّادة النّار تلك... ماذا كان اسمها؟

151
00:19:38,540 --> 00:19:40,140
آنسة آكيرا

152
00:19:40,140 --> 00:19:42,010
هذا صحيح

153
00:19:42,530 --> 00:19:45,440
خذي دواءها أيضاً. تفضّلي

154
00:19:45,440 --> 00:19:48,040
...أنا مُندهش من أنّ فتاة مثلها

155
00:19:48,450 --> 00:19:53,370
،تستطيع الصّمود كصيّادة نار مُتجوّلة
لا سيّما بكلب صيدها الضّئيل ذاك

156
00:20:07,480 --> 00:20:08,630
كاناتا؟

157
00:20:11,100 --> 00:20:12,440
كاناتا

158
00:20:12,760 --> 00:20:14,070
!كاناتا

159
00:20:56,810 --> 00:20:59,990
أهذا هو يا كاناتا؟

160
00:21:00,480 --> 00:21:03,450
أهذا هو منزل صيّاد النّار؟

161
00:21:04,840 --> 00:21:06,280
!من تكونين أيّتها الطفلة؟

162
00:21:06,990 --> 00:21:10,490
يبدو هذا ككلب صيد! أهو لك؟

163
00:21:12,870 --> 00:21:14,000
!كاناتا

164
00:21:14,000 --> 00:21:15,290
!توقّفا مكانكما

165
00:21:53,560 --> 00:21:57,170
كاناتا... أين نحن؟

166
00:22:07,330 --> 00:22:09,130
تبدين تائهة