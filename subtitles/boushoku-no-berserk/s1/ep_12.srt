1
00:00:09,870 --> 00:00:12,490
—مهلاً... بدون الرّجوع لي

2
00:00:16,060 --> 00:00:20,280
!ليس وأنا هنا

3
00:00:27,140 --> 00:00:29,920
...استعمال فن الدّرع السّرّي بالقوّة

4
00:00:29,920 --> 00:00:31,990
!هذا مثيرًا للإعجاب يا فيت

5
00:00:33,310 --> 00:00:34,450
في؟

6
00:00:34,970 --> 00:00:36,160
أهذا أنت يا في؟

7
00:00:39,260 --> 00:00:40,750
...لم أرك منذ مدّة

8
00:00:43,600 --> 00:00:44,900
.يا سيّدتي روكسي

9
00:00:46,070 --> 00:00:47,160
!في

10
00:00:56,730 --> 00:01:00,790
.غادري هذا المكان بسرعة رجاءً
.سيهاجم ثانية بعد قليل

11
00:01:01,690 --> 00:01:03,570
.سأوفّر لك بعض الوقت

12
00:01:04,780 --> 00:01:05,940
...في

13
00:01:08,800 --> 00:01:12,820
.آسف لأنّي كذبت عليك طوال هذا الوقت

14
00:01:16,870 --> 00:01:19,980
!وشكرًا على كلّ شيء يا سيّدتي روكسي

15
00:01:19,980 --> 00:01:20,940
!في

16
00:01:22,340 --> 00:01:23,520
...في

17
00:01:25,940 --> 00:01:26,980
!في

18
00:01:39,160 --> 00:01:40,710
.أرى أنّه متأهّب ثانية

19
00:01:41,840 --> 00:01:44,770
لم تظنّ أنّ الأمر سيكون بتلك السّهولة، صحيح؟

20
00:01:45,380 --> 00:01:47,870
!اخرس! هيّا بنا يا جشع

21
00:01:47,870 --> 00:01:50,810
!أجل! يمكنك استعماله الآن

22
00:01:50,810 --> 00:01:53,150
!مفهوم! أعتمد عليك يا شريكي

23
00:01:53,630 --> 00:01:57,540
!الصّليب الكبير الرّاجع

24
00:03:28,530 --> 00:03:31,070
!هيّا

25
00:03:37,720 --> 00:03:39,530
!إنّه مقيّد الآن

26
00:03:41,700 --> 00:03:42,850
!فيت

27
00:03:45,410 --> 00:03:47,170
.كان ذلك ماكرًا

28
00:03:47,170 --> 00:03:50,190
تقييد حركة التّنّين المقدّس
...بفنّ ما لم أره من قبل

29
00:03:51,110 --> 00:03:53,000
.بإمكاننا الآن القتال رجلاً لرجل بالفعل

30
00:03:56,020 --> 00:03:57,540
...إنّه متفوّق عليّ

31
00:03:57,540 --> 00:04:00,570
لا بدّ أنّ إحصائيّاتي انخفضت
!بعد استعمال الفنّ السّرّيّ

32
00:04:01,340 --> 00:04:03,350
.هناك ثلاثة أسباب

33
00:04:03,690 --> 00:04:08,410
الأوّل هو أنّك صرتَ منهكًا
.لدخولك المجال إي بالقوّة

34
00:04:08,410 --> 00:04:12,230
الثّاني هو أنّك تلتهم جزءًا من قوّتك
.للحفاظ على ذلك الفنّ

35
00:04:12,230 --> 00:04:13,320
...والثّالث

36
00:04:13,320 --> 00:04:15,860
!لم أقرّر قتالك بجدّيّة بعد

37
00:04:20,940 --> 00:04:21,660
!نلت منك

38
00:04:21,660 --> 00:04:23,570
!كان ذلك خطيرًا

39
00:04:23,570 --> 00:04:26,150
!ابق قريبًا منه! لا تدعه يبتعد كثيرًا

40
00:04:26,150 --> 00:04:27,200
!أعلم

41
00:04:27,610 --> 00:04:31,530
.يا له من هجوم متهوّر
...تتسرّع كثيرًا في هجماتك

42
00:04:31,830 --> 00:04:33,620
.فهمت

43
00:04:33,620 --> 00:04:37,380
إن ابتعدت كثيرًا، فلن تستطيع
.الحفاظ على ذاك الفنّ السّرّيّ

44
00:04:38,630 --> 00:04:40,930
.يبدو أنّي كنتُ محقًّا

45
00:04:40,930 --> 00:04:42,090
!لم ينتهي الأمر بعد

46
00:04:42,390 --> 00:04:44,570
تشعر بالذّعر الآن بعد أن اكتشفت أمرك؟

47
00:04:44,570 --> 00:04:46,970
!إنّ الهجوم بتلك الطّريقة يتركك عرضة لهجومي

48
00:04:56,220 --> 00:04:58,710
.للأسف. أعتقد أنّ الأمر قد انتهى

49
00:04:59,030 --> 00:05:02,380
...علّقت إريس آمالاً كثيرة عليك

50
00:05:02,380 --> 00:05:05,240
،لكن بعد كلّ المشاكل الّتي تسبّبتَ بها

51
00:05:07,090 --> 00:05:09,500
.عليك دفع الثّمن

52
00:05:12,880 --> 00:05:14,080
!ماذا؟

53
00:05:14,370 --> 00:05:16,240
!سحر وهم...؟

54
00:05:18,550 --> 00:05:20,480
—متى قمت

55
00:05:20,890 --> 00:05:25,670
توقّعت أن ترخي دفاعاتك
.عندما تصير واثقًا من فوزك

56
00:05:25,670 --> 00:05:29,640
!كلاّ.. ثمّ ضحّيتَ بذراعك؟

57
00:05:29,960 --> 00:05:32,350
.كان رهانًا بكلّ شيء أو لا شيء

58
00:05:33,070 --> 00:05:35,100
.يمكنك الحصول على ذراعي اليسرى

59
00:05:37,690 --> 00:05:39,640
!خذها معك

60
00:05:43,870 --> 00:05:46,260
.تمّ تفعيل مهارة الشّراهة

61
00:05:49,020 --> 00:05:50,240
أين أنا؟

62
00:05:50,760 --> 00:05:52,270
...أعتقد أنّي رأيت هذا من قبل

63
00:05:52,270 --> 00:05:55,290
...مع أنّي حاولت تحذيرك مرّات عدّة

64
00:05:55,550 --> 00:05:59,370
.أنت... الفتاة الّتي كانت جوهر هانييل

65
00:06:01,330 --> 00:06:04,840
.اسمي لونا. شكرًا لك

66
00:06:04,840 --> 00:06:06,060
علام؟

67
00:06:06,670 --> 00:06:08,710
.على قتلي

68
00:06:10,320 --> 00:06:14,750
.لا تحزن. أظنّ أنّ ذلك كان للأفضل

69
00:06:15,600 --> 00:06:19,320
.لكن... أنا آسفة

70
00:06:19,680 --> 00:06:21,530
لماذا تعتذرين؟

71
00:06:22,100 --> 00:06:24,080
.لا يمكنني مواصلة هذا

72
00:06:31,230 --> 00:06:33,040
.كنتُ أقوم بكبحها هنا

73
00:06:33,400 --> 00:06:37,130
إذًا فقد كانت مهارة الشّراهة هادئة بفضلك؟

74
00:06:37,490 --> 00:06:42,320
.لكن ليس بعد الآن
.ما عدت قادرة على دعمك

75
00:06:42,930 --> 00:06:44,130
دعمي...؟

76
00:06:44,790 --> 00:06:48,560
،إن التهمتَ التّنّين المقدّس
.فستفقد السّيطرة على نفسك

77
00:06:51,790 --> 00:06:53,640
...وقريبًا سوف

78
00:06:57,350 --> 00:07:01,130
.كنتُ أتساءل لماذا صمتّ فجأة
!لكنّك كنت هنا

79
00:07:02,590 --> 00:07:04,110
!جشع؟

80
00:07:10,840 --> 00:07:12,570
.لا تحدّق بي

81
00:07:12,570 --> 00:07:14,000
.إنّ الوقت يداهمنا. عليك العودة

82
00:07:14,000 --> 00:07:15,850
!مـ-مهلاً

83
00:07:19,300 --> 00:07:21,030
.شكرًا على التّحذير

84
00:07:21,030 --> 00:07:24,910
لكنّي لا أستطيع السّماح للتّنّين المقدّس
.بالتّجوال بحرّيّة دون سيّده

85
00:07:26,180 --> 00:07:28,020
.سأقوم بقتله

86
00:07:28,750 --> 00:07:29,850
.هكذا إذًا

87
00:07:37,640 --> 00:07:40,200
.إنّك تشكّل تحدّيًا بالفعل

88
00:07:40,200 --> 00:07:42,470
إذًا فقد كنت شخصًا في السّابق؟

89
00:07:42,470 --> 00:07:44,480
.اعتبره مجرّد شكل مؤقّت

90
00:07:46,650 --> 00:07:48,320
هل أنت جاهز؟

91
00:07:53,910 --> 00:07:56,620
!لأنّه لدينا تنّين مقدّس هائج للتّعامل معه

92
00:07:56,620 --> 00:08:00,090
.لا أعرف كم بقي لي. لننه هذا بسرعة

93
00:08:00,090 --> 00:08:03,890
ما الخطّة؟ من الصّعب استعمال
.درع أو قوس بذراع واحدة

94
00:08:03,890 --> 00:08:05,130
...جشع

95
00:08:05,880 --> 00:08:07,190
—لا تقل لي أنّك

96
00:08:07,190 --> 00:08:09,970
!هل سبق ورغبت في الطّيران من قبل؟

97
00:08:09,970 --> 00:08:13,390
!ما الّذي تفعله يا فيت؟

98
00:08:17,180 --> 00:08:20,270
!فنّ الشّجار: لكمة الدّمار

99
00:08:25,300 --> 00:08:28,130
...تُعاملني كسلاح يُرمى

100
00:08:28,130 --> 00:08:29,820
ماذا تقول؟ ألم أستعدك بعدها؟

101
00:08:29,820 --> 00:08:31,790
.لن ينتهي هذا الموضوع هنا

102
00:08:31,790 --> 00:08:33,490
!لنستعمل التّعرّف على هذا الشيء

103
00:08:35,950 --> 00:08:38,360
...أنا متفوّق قليلاً من ناحية الإحصائيّات

104
00:08:38,360 --> 00:08:42,530
.المجال إي هو عالم القوّة غير البشريّة
.ما كنتُ لأثق في الأرقام كثيرًا

105
00:08:42,530 --> 00:08:45,130
!في تلك الحالة، لنركّز على ما يمكننا فعله

106
00:08:49,510 --> 00:08:50,590
!لم أنتهِ بعد

107
00:09:03,500 --> 00:09:04,240
!فيت

108
00:09:04,240 --> 00:09:05,150
!لا بأس

109
00:09:05,530 --> 00:09:09,180
سأعزّز مهارة الحافّة الحادّة بمهارة
!القوّة لمضاعفتها تأثيرها

110
00:09:14,620 --> 00:09:18,390
!سينتهي هذا الآن

111
00:09:26,640 --> 00:09:28,830
.تمّ تفعيل مهارة الشّراهة

112
00:09:34,300 --> 00:09:35,500
...ليس بعد

113
00:09:35,840 --> 00:09:39,820
.لا يمكنني... السّماح لك بأخذي بعد

114
00:09:41,230 --> 00:09:43,700
...إن هجتُ الآن

115
00:09:43,700 --> 00:09:47,480
!سأصير تهديدًا أكبر من التّنّين المقدّس

116
00:09:50,510 --> 00:09:52,570
...قبل حدوث ذلك

117
00:09:59,030 --> 00:10:01,190
!أنت...هـ-هل يُعقل—؟

118
00:10:04,250 --> 00:10:07,780
...ما عاد... بإمكاني المواصلة أكثر

119
00:10:09,590 --> 00:10:11,670
...لذلك السّبب

120
00:10:11,670 --> 00:10:13,510
!إيّاك! إيّاك أن تفعلها يا فيت

121
00:10:14,740 --> 00:10:16,970
.أنا آسف يا جشع

122
00:10:23,470 --> 00:10:26,930
الحصول على مستواك الجديد أعاد
.كلّ إحصائيّاتي لبدايتها

123
00:10:27,360 --> 00:10:32,940
...والآن حتّى إن هجت
.سيكون الضّرر في أقلّ مستوياته

124
00:10:34,290 --> 00:10:37,840
في النّهاية... ستلتهمك المهارة أيضًا؟

125
00:11:00,380 --> 00:11:03,650
.لم أعتقد أنّ هذا اليوم سيأتي سريعًا

126
00:11:05,240 --> 00:11:06,400
...أرجوك

127
00:11:06,400 --> 00:11:10,340
.اقتليني يا ماين

128
00:11:11,350 --> 00:11:15,430
إن ضغطت على نفسك كثيرًا، ستتغلّب
...عليك المهارة وتجعلك تفقد السّيطرة

129
00:11:15,430 --> 00:11:17,070
.سبق وحذّرتك

130
00:11:18,040 --> 00:11:19,030
.آسف

131
00:11:21,330 --> 00:11:22,470
.مفهوم

132
00:11:27,170 --> 00:11:29,080
.سأفي بوعدي

133
00:11:37,680 --> 00:11:39,390
!كلاّ

134
00:11:46,470 --> 00:11:49,120
سيّدتي روكسي...؟

135
00:11:50,400 --> 00:11:51,670
لماذا؟

136
00:11:56,880 --> 00:11:59,030
!هل حقًّا تسألني عن السّبب؟

137
00:11:59,580 --> 00:12:01,990
!ما الّذي كنتَ تحاول فعله؟

138
00:12:03,120 --> 00:12:04,840
.لا تنظري إليّ

139
00:12:04,840 --> 00:12:09,570
...لم أرد أبدًا أن تريني هكذا

140
00:12:13,020 --> 00:12:14,730
سيّدتي روكسي؟

141
00:12:15,610 --> 00:12:20,010
هل تعتقد فعلاً أنّ هذا سيكون
!كافيًا لجعلي أكرهك؟

142
00:12:20,740 --> 00:12:23,720
،لا يهمّ ما القوّة الّتي تحملها
!ستظلّ أنت هو أنت

143
00:12:24,930 --> 00:12:29,090
.لذلك... لا تحاول قتل نفسك

144
00:12:30,530 --> 00:12:32,080
...هذا غريب

145
00:12:32,550 --> 00:12:36,070
كانت مهارة الشّراهة هائجة
.قبل قليل، لكنّها هدأت الآن

146
00:12:41,580 --> 00:12:42,820
.تعال

147
00:12:44,500 --> 00:12:46,300
.لنعد إلى بابيلون

148
00:12:48,830 --> 00:12:53,720
.كنتُ خائفًا... أن تكرهني

149
00:12:54,800 --> 00:12:59,530
.لكنّها قبلت بي حتّى بعد معرفة الحقيقة

150
00:13:00,470 --> 00:13:04,040
...واصلتُ قول أنّي أردت إنقاذها

151
00:13:05,950 --> 00:13:10,980
لكنّ الحقيقة هي أنّي أردتها
.أن تنقذني... كما فعلتْ في السّابق

152
00:13:25,780 --> 00:13:30,660
.وجدت من يدعمك

153
00:13:44,970 --> 00:13:46,500
!لا أحد منكم

154
00:13:46,500 --> 00:13:47,680
!هلاّ خرست؟

155
00:13:52,630 --> 00:13:54,100
أين أنا؟

156
00:13:56,410 --> 00:13:58,080
غرفتي في النُّزل؟

157
00:13:59,280 --> 00:14:02,890
.صحيح... قطع نورذرن ذراعي اليسرى

158
00:14:06,830 --> 00:14:08,540
.إنّها الظّهيرة سلفًا

159
00:14:08,940 --> 00:14:10,690
منذ متى وأنا نائم؟

160
00:14:11,240 --> 00:14:12,250
.لأسبوع كامل

161
00:14:12,720 --> 00:14:13,710
!...إريس

162
00:14:14,340 --> 00:14:17,000
ما زلت قلقًا بشأني؟

163
00:14:17,920 --> 00:14:19,110
ماين؟

164
00:14:19,580 --> 00:14:20,380
.تنام كثيرًا

165
00:14:21,420 --> 00:14:24,760
،لا يسعه فعل أيّ شيء
.بالنّظر كم أنّه بالغ في استعمال قوّته

166
00:14:24,760 --> 00:14:26,220
.خذ، نسيت هذا

167
00:14:26,220 --> 00:14:27,930
!جشع

168
00:14:28,230 --> 00:14:31,090
هل تذكّرت للتّوّ أنّني مفقود؟

169
00:14:31,090 --> 00:14:32,890
...طـ-طبعًا لا

170
00:14:33,380 --> 00:14:36,350
.ولكن يبدو أنّك في حالة سيّئة

171
00:14:37,320 --> 00:14:40,320
.كان علينا الذّهاب لمركز غاليا لإيجاده

172
00:14:40,320 --> 00:14:42,260
فلماذا لا يكون متّسخًا؟

173
00:14:42,260 --> 00:14:45,390
...ظننتُ بالفعل أنّي لن أعود

174
00:14:45,390 --> 00:14:47,400
.كان بعيدًا جدًّا ومصدر إزعاج

175
00:14:47,400 --> 00:14:49,530
ماذا كان يفعل هنا؟

176
00:14:49,530 --> 00:14:51,780
.أعتقد أنّ وحشًا حمله معه

177
00:14:51,780 --> 00:14:54,200
.كلّ هذا لأنّ ماين نسيت حمله

178
00:14:54,200 --> 00:14:56,120
!...ماين

179
00:14:56,120 --> 00:14:58,750
.كنتُ مشغولة بالتّعامل مع الآخر

180
00:14:58,750 --> 00:15:00,360
الآخر؟

181
00:15:00,360 --> 00:15:01,530
.حسد

182
00:15:01,530 --> 00:15:04,290
سيكون من السّيّئ إن وجد
وعاءً آخر مثل نورذرن

183
00:15:04,290 --> 00:15:06,470
.وبدأ في التّسبّب بالمشاكل ثانية

184
00:15:06,870 --> 00:15:09,930
وعاء؟ ما الّذي كان يحدث مع نورذرن
وحسد على أيّ حال؟

185
00:15:10,720 --> 00:15:12,890
.كان تحت سيطرته فحسب

186
00:15:13,510 --> 00:15:15,100
.مثل دمية لا غير

187
00:15:15,100 --> 00:15:17,810
إنّ من كان يتحكّم بالوضع هو سيف
.المسدّس الأسود حسد

188
00:15:18,140 --> 00:15:21,400
كان حسد هو المتحكّم؟
هل عرفتَ بشأن ذلك يا جشع؟

189
00:15:21,720 --> 00:15:25,110
لا. لم تكن لديّ أدنى فكرة أنّه يستطيع
.استعمال التّحكّم بالعقل

190
00:15:25,660 --> 00:15:29,080
لكن بالنّظر للحالة الفظيعة
.الّتي كان فيها، فذلك لا يفاجئني

191
00:15:29,080 --> 00:15:31,080
التّحكّم بالعقل؟

192
00:15:31,640 --> 00:15:33,670
.لم نستطع السّماح بذلك فحسب

193
00:15:34,030 --> 00:15:36,880
هل دمّرتماه إذًا؟

194
00:15:36,880 --> 00:15:39,130
.لا يمكن تدمير أسلحة الخطايا المميتة

195
00:15:40,430 --> 00:15:42,580
ماذا فعلتما إذًا؟

196
00:15:45,680 --> 00:15:47,840
.رميته للجانب الآخر من غاليا

197
00:15:51,140 --> 00:15:53,600
!...الجواب المثاليّ لمغفّلة مثلها

198
00:15:54,030 --> 00:15:56,060
.انس ذلك الآن يا فيت

199
00:15:56,870 --> 00:16:00,290
،بعد هزيمة التّنّين المقدّس
.أثبتّ إمكانيّاتك بذلك

200
00:16:02,310 --> 00:16:04,110
.نحتاج لمساعدتك

201
00:16:04,480 --> 00:16:06,020
مساعدتي؟

202
00:16:06,020 --> 00:16:10,360
ما عادت هناك خطّة لإنشاء بشريّ
.متوّج بموت روكسي

203
00:16:12,330 --> 00:16:15,370
أقسمي لي أنّك لن تسعي خلف
.السّيّدة روكسي ثانية

204
00:16:16,040 --> 00:16:17,960
.سأستمع لما لديك لاحقًا

205
00:16:18,330 --> 00:16:22,810
.موافقة. كان حسد هو صاحب الفكرة من الأساس

206
00:16:22,810 --> 00:16:26,550
،وبالتّفكير في الأمر الآن
.كنتُ غبيّة لأنّي وافقته عليها

207
00:16:27,390 --> 00:16:32,040
،بعد رحيل التّنّين المقدّس الآن
.ستدخل البلاد حقبة جديدة

208
00:16:32,040 --> 00:16:34,420
.وسنحتاج لقوّتك للمساعدة فيما سيأتي لاحقًا

209
00:16:34,420 --> 00:16:37,020
.وبالطّبع، لستَ في وضع يسمح لك بالرّفض

210
00:16:38,000 --> 00:16:41,480
هذا أمر على كلّ حاملي مهارات
.الخطايا المميتة أن يتولّوه

211
00:16:46,750 --> 00:16:51,180
...لا أفهم ما الّذي تقصدينه بكلّ ذلك

212
00:16:51,180 --> 00:16:54,760
،لكن بما أنّي وُلدت بمهارة الشّراهة

213
00:16:55,590 --> 00:16:58,250
.فأعتقد أنّ هنالك سببًا لذلك

214
00:17:02,790 --> 00:17:05,040
.وأريد معرفة ذلك السّبب

215
00:17:06,250 --> 00:17:10,080
.ولكن أوّلاً... لنقم بشيء حيال تلك الذّراع

216
00:17:10,080 --> 00:17:11,750
ستعالجين ذراعي؟

217
00:17:11,750 --> 00:17:14,090
.لم أسمع بسحر كهذا من قبل

218
00:17:14,090 --> 00:17:15,220
.إنّه ممكن

219
00:17:15,690 --> 00:17:17,350
سأستعيد ذراعي ثانية...؟

220
00:17:18,180 --> 00:17:22,130
،بعد أن قرّرنا هذا
.لنغادر المكان قبل عودة روكسي

221
00:17:22,130 --> 00:17:23,150
لماذا؟

222
00:17:23,600 --> 00:17:26,570
.من الخطير جدًّا عليك أن تتواجد قربها الآن

223
00:17:26,900 --> 00:17:32,120
مجرّد سماع اسمها جعل الشّراهة تهيج، صحيح؟

224
00:17:34,850 --> 00:17:36,240
.مفهوم

225
00:17:38,330 --> 00:17:39,200
!هيّا، هيّا

226
00:17:40,070 --> 00:17:43,030
!حرّكي قدميك يا ميريا

227
00:17:45,540 --> 00:17:46,920
!إنّها رايني

228
00:17:46,920 --> 00:17:48,880
!ماذا؟! أين؟ أين هي؟

229
00:17:48,880 --> 00:17:50,600
!نلت منك

230
00:17:53,130 --> 00:17:54,450
!سيّدتي روكسي

231
00:17:54,450 --> 00:17:55,600
!كان ذلك لئيمًا يا ميريا

232
00:17:55,600 --> 00:17:58,000
هل ستخرجين يا سيّدتي روكسي؟

233
00:17:58,000 --> 00:17:59,810
.نعم. اعتني بالأمور في غيابي

234
00:18:00,290 --> 00:18:02,500
!أكيد! رافقتك السّلامة

235
00:18:03,520 --> 00:18:06,150
...أراهن أنّها ذاهبة لرؤية ذلك المغفّل ثانية

236
00:18:07,510 --> 00:18:09,560
.مرّ أسبوع بالفعل

237
00:18:10,300 --> 00:18:12,450
!هيّا، اقتربوا

238
00:18:21,090 --> 00:18:23,750
...انظر يا في، رأيت بعض العنب اليوم و

239
00:18:26,320 --> 00:18:27,430
في؟

240
00:18:31,920 --> 00:18:34,180
في! أين أنت؟

241
00:18:39,180 --> 00:18:42,340
.سامحيني لأنّني اختفيت فجأة هكذا

242
00:18:50,510 --> 00:18:54,560
.آسف لأنّي لم أخبرك عن مهارة الشّراهة خاصّتي

243
00:18:55,270 --> 00:18:58,200
.وأيضًا... أريد أن أشكرك

244
00:18:59,010 --> 00:19:04,670
عليّ المغادرة الآن، لكنّي أعد
.أن أعود إليك يا سيّدتي روكسي

245
00:19:05,310 --> 00:19:06,950
.اعتني بنفسك حتّى ذلك اليوم

246
00:19:07,640 --> 00:19:08,680
.فيت

247
00:19:11,090 --> 00:19:14,280
...يصارع شيئًا كهذا بمفرده

248
00:19:15,330 --> 00:19:19,590
.كنت أنت من منحني الكثير من الشّجاعة

249
00:19:35,740 --> 00:19:36,990
!أنت هناك

250
00:19:37,300 --> 00:19:39,910
.من الخطير جدًّا التّجوال في هذا الوقت المتأخّر

251
00:19:39,910 --> 00:19:41,340
.عليك العودة للمنزل

252
00:19:41,340 --> 00:19:44,200
!أ-أنا آسف! لا تضربيني رجاءً

253
00:19:44,200 --> 00:19:47,670
أضربك؟ لماذا تعتقد أنّي سأضربك؟

254
00:19:47,920 --> 00:19:51,630
...لـ-لأنّني أغضبت فارسة مقدّسة

255
00:19:52,090 --> 00:19:53,590
!كنتُ أحذّرك فحسب

256
00:19:53,590 --> 00:19:55,300
!أ-أنا آسف

257
00:19:59,200 --> 00:20:04,180
...يخاف النّاس من الفرسان المقدّسين بالفعل

258
00:20:05,270 --> 00:20:06,420
.أنا آسفة

259
00:20:07,780 --> 00:20:09,190
لماذا تعتذرين؟

260
00:20:09,190 --> 00:20:14,090
.أشعر بالخزي كوني فارسة مقدّسة

261
00:20:18,630 --> 00:20:20,110
.انتظر لحظة

262
00:20:20,540 --> 00:20:21,600
.تفضّل

263
00:20:26,570 --> 00:20:29,990
.خذ، عد إلى المنزل بمجرّد أن تنتهي من أكلها

264
00:20:30,400 --> 00:20:32,210
.واثقة أنّ عائلتك قلقة عليك

265
00:20:33,270 --> 00:20:36,600
.لا عائلة لدي لتنتظر عودتي

266
00:20:39,140 --> 00:20:41,940
.لكنّي سأذهب. شكرًا على الشّطائر

267
00:20:42,320 --> 00:20:44,350
هل لديك مكان تمكث فيه؟

268
00:20:44,870 --> 00:20:49,470
.لا. لكنّي صرت أعلم الآن أنّ العاصمة ليست سيّئة

269
00:20:50,060 --> 00:20:53,560
!أنا جدّ مسرور لأنّي قابلت فارسة مقدّسة لطيفة مثلك

270
00:20:56,530 --> 00:20:57,410
!إلى اللّقاء

271
00:20:57,410 --> 00:20:59,660
مهلاً! ما اسمك؟

272
00:20:59,660 --> 00:21:01,200
!فيت! مع السّلامة

273
00:21:01,790 --> 00:21:03,160
!إلى اللّقاء

274
00:21:14,350 --> 00:21:15,930
سنلتقي ثانية، صحيح؟

275
00:21:16,900 --> 00:21:20,050
.عليّ أن أصير أقوى عندما يحين ذلك اليوم

276
00:21:22,480 --> 00:21:24,600
.سترى يا في

277
00:21:28,870 --> 00:21:31,070
...كان الجثّة هو فيت من البداية

278
00:21:31,070 --> 00:21:33,600
يا لها من صدمة، صحيح يا أخي رافال؟

279
00:21:33,600 --> 00:21:34,440
...نعم

280
00:21:36,150 --> 00:21:38,490
.لديّ بحث لأعود إليه

281
00:21:41,330 --> 00:21:46,250
ما الّذي يفعله بالضّبط خلال بحثه هذا؟

282
00:21:51,370 --> 00:21:55,830
...أنا مسرور لأنّك قتلت هادو

283
00:21:57,310 --> 00:21:58,890
!يا فيت

284
00:22:12,960 --> 00:22:15,860
!خذ 40 بالمائة ممّا لديّ

285
00:22:18,620 --> 00:22:22,570
!هذا هو الفنّ السّرّيّ لمستواي الرّابع، شفاء الشّفق

286
00:22:29,750 --> 00:22:30,920
!أجل

287
00:22:32,310 --> 00:22:33,960
.يبدو أنّ الأمر قد نجح

288
00:22:34,640 --> 00:22:36,310
.سأراك لاحقًا في العاصمة

289
00:22:38,490 --> 00:22:39,810
.عليّ الذّهاب أيضًا

290
00:23:02,360 --> 00:23:05,200
!لكنّنا حصلنا على غمد جديد للتّوّ

291
00:23:05,490 --> 00:23:09,890
لكنّك الآن صرت محاربًا استثنائيًّا
.وصل إلى مجال إي

292
00:23:09,890 --> 00:23:12,630
!لذلك أنت بحاجة لسيف يتماشى مع ذلك

293
00:23:12,630 --> 00:23:17,170
وماذا في ذلك؟ لست راضيًا بحجارة
الشّحذ العاديّة؟ أتريد الفاخرة منها الآن؟

294
00:23:17,170 --> 00:23:20,920
.نعم! أفكّر في حجر شحذ من البهرمان

295
00:23:20,920 --> 00:23:22,870
.إنّه انعكاس جيّد لروعتي

296
00:23:22,870 --> 00:23:25,190
وأين قد نجد المال لشيء كهذا؟

297
00:23:25,190 --> 00:23:27,940
،إن لم يكن معنا مال الآن
!سيكون علينا اكتسابه فحسب

298
00:23:29,000 --> 00:23:30,870
.أظنّك على حقّ

299
00:23:30,870 --> 00:23:32,560
!لنقم بهذا يا شريكي

300
00:23:32,920 --> 00:23:36,490
!أكيد! قاتل بشراهة