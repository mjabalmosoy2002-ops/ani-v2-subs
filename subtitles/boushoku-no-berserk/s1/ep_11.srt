1
00:00:08,190 --> 00:00:10,160
!استلّ سيفك الآن

2
00:00:10,910 --> 00:00:13,120
!أنا أتحدّاك لنزال

3
00:00:14,080 --> 00:00:17,040
عفوًا... هل فعلتُ شيئًا ما؟

4
00:00:17,040 --> 00:00:18,830
.كفّ عن التّظاهر بالبراءة

5
00:00:19,340 --> 00:00:22,380
.ستّة وخمسون حادثة عنف مع محاربين آخرين

6
00:00:22,380 --> 00:00:24,480
.عشرون حالة لتدمير ممتلكات

7
00:00:24,480 --> 00:00:27,450
...مرّ شهر فقط منذ عودتنا من الوادي العظيم

8
00:00:27,450 --> 00:00:28,800
كيف تمكّنت من فعل كلّ هذا؟

9
00:00:28,800 --> 00:00:31,290
.اسمع، أظنّها تحاول أن تبدو مثل روكسي

10
00:00:31,290 --> 00:00:33,170
!ولا تجيد ذلك إطلاقًا

11
00:00:34,020 --> 00:00:36,710
.كلّها كانت حالات هاجمني فيها آخرون

12
00:00:37,180 --> 00:00:39,270
هذه ضريبة الشّهرة، صحيح؟

13
00:00:39,610 --> 00:00:44,370
بغضّ النّظر، لا أستطيع التّغاضي
.عن أيّ نزاعات عنيفة أخرى

14
00:00:44,740 --> 00:00:46,230
ماذا يفترض بي فعله؟

15
00:00:46,690 --> 00:00:48,190
.انضمّ للجيش الملكيّ

16
00:00:49,070 --> 00:00:54,580
بمجرّد أن تفعل، فحتّى أكثر المحاربين
.شغبًا سيتردّدون قبل السّعي خلفك

17
00:00:55,790 --> 00:00:59,630
.أقدّر قلقك، لكنّي لا أرى نفسي تابعًا لأحد

18
00:00:59,630 --> 00:01:02,170
.علينا أن نحظى بحرّيّتنا قبل كلّ شيء

19
00:01:03,720 --> 00:01:07,060
.توقّعت أن تقدّم ردًّا كهذا

20
00:01:08,470 --> 00:01:10,010
،إن كنتَ تنوي الرّفض

21
00:01:10,370 --> 00:01:14,470
.فسيكون عليك التّفكير بشأن أفعالك في السّجن

22
00:01:15,460 --> 00:01:18,040
.أفضّل ألاّ أفعل

23
00:01:22,450 --> 00:01:26,170
.ستتركه في غمده؟ لا تنزعج إن تضرّر

24
00:01:26,590 --> 00:01:28,690
.لقد صُنع خصّيصًا لسيفي

25
00:01:29,120 --> 00:01:31,950
!لا نيّة لي بالتّهاون

26
00:03:18,120 --> 00:03:19,090
...هجوم ثقيل

27
00:03:19,430 --> 00:03:23,010
،يجدر أن تكون لي الأفضليّة بخصوص الإحصائيّات
!لكنّي عاجز عن التّغلّب عليها

28
00:03:23,010 --> 00:03:25,560
.لا تنسَ أنّها فارسة مقدّسة

29
00:03:27,800 --> 00:03:31,270
!سبق وأخبرتك، لا أنوي التّهاون معك

30
00:03:32,900 --> 00:03:36,110
هذه هي المهارات التّقنيّة الّتي يحصل
...عليها المرء من التّدريب اليوميّ

31
00:03:36,110 --> 00:03:39,620
!شردت في التّفكير في خضمّ معركة؟

32
00:03:42,210 --> 00:03:43,240
!تسعى خلف قناعي؟

33
00:03:44,220 --> 00:03:48,540
،إن كنتَ لن تأخذ هذا على محمل الجدّ
.فسأفضحك... بالمعنى الحرفيّ

34
00:03:48,540 --> 00:03:49,420
—مهلاً

35
00:03:48,540 --> 00:03:52,230
!انطلقي يا سيّدتي روكسي

36
00:03:54,470 --> 00:03:55,280
!سريعة

37
00:03:55,280 --> 00:03:56,590
!أهذا تعزيز جسديّ؟

38
00:03:59,260 --> 00:04:01,510
.لا يمكنك الفوز إن قمت بتفادي هجماتي فحسب

39
00:04:01,910 --> 00:04:05,470
،إن كنتَ لا تريد الكشف عن هويّتك
.خذ الأمر على محمل الجدّ رجاءً

40
00:04:07,170 --> 00:04:08,840
...إن كان هذا ما تريدين

41
00:04:11,580 --> 00:04:12,770
.فلا خيار أمامي

42
00:04:13,280 --> 00:04:14,230
...ذلك

43
00:04:14,230 --> 00:04:17,600
تقنية السّيف تلك... إنّها مهارة
!تقنية السّيف المقدّس

44
00:04:17,600 --> 00:04:19,710
كيف يمكنك استعمالها بدون سيف مقدّس؟

45
00:04:19,710 --> 00:04:23,200
.سبق وأخبرتك، هذا الغمد مصنوع خصّيصًا لسيفي

46
00:04:24,110 --> 00:04:27,280
إنّه في الحقيقة إضافة لسلاحي
تعزّز تقنيات السّيف المقدّس

47
00:04:27,280 --> 00:04:30,420
صُنع من بلّورات سحريّة جمعتها
.من الوادي العظيم

48
00:04:31,630 --> 00:04:34,330
إن كنت تملك المهارة لحمل فنون
...من هذا النّوع

49
00:04:34,850 --> 00:04:37,630
فهل أنت فارس مقدّس سابق؟

50
00:04:38,840 --> 00:04:40,090
.لا

51
00:04:41,110 --> 00:04:44,230
.ما عدت نفس الشّخص

52
00:04:46,030 --> 00:04:49,180
.أنا مجرّد محارب

53
00:04:57,890 --> 00:05:00,490
!ستخسر السّيّدة روكسي

54
00:05:03,870 --> 00:05:05,670
—سأفوز الآن

55
00:05:14,160 --> 00:05:16,740
...إنّها... من ذلك الحجر الكريم

56
00:05:16,740 --> 00:05:18,060
!يا فيت

57
00:05:22,430 --> 00:05:23,890
.تركت ثغرة

58
00:05:24,630 --> 00:05:27,970
!أيّها المغفّل

59
00:05:28,460 --> 00:05:30,060
.لقد فزتِ

60
00:05:33,960 --> 00:05:37,980
وكأنّ السّيّدة روكسي قد تخسر
!في مواجهة وغد بليد مثله

61
00:05:38,410 --> 00:05:40,880
لماذا تهاونتَ فجأة؟

62
00:05:41,290 --> 00:05:42,850
.لا أدري عمّ تتحدّثين

63
00:05:42,850 --> 00:05:44,450
!لا تتظاهر بالغباء

64
00:05:44,880 --> 00:05:47,190
على رسلك عليّ. ألم تكتفين بعد؟

65
00:05:47,590 --> 00:05:48,700
—حان الوقت كي

66
00:05:48,700 --> 00:05:50,200
...مهاراتك في المسايفة

67
00:05:50,840 --> 00:05:55,110
طريقة قتالك... هل تعلّمتها من السّيّد هارون؟

68
00:05:55,880 --> 00:06:00,390
ذلك واضح لي لأنّه قام بتدريبي أيضًا
.خلال رحلتي إلى هنا

69
00:06:00,860 --> 00:06:04,470
.طريقة هجومك وتحرّكك تذكّرني به

70
00:06:04,890 --> 00:06:06,350
...قال السّيّد هارون

71
00:06:07,310 --> 00:06:10,400
،بعد لقائي بمسافر متّجه إلى غاليا

72
00:06:10,400 --> 00:06:13,380
.قرّرت حمل السّيف مرّة أخرى

73
00:06:14,940 --> 00:06:20,860
وقال أنّ هذا المسافر يملك قوّة عظيمة
.جدًّا لدرجة أنّها سببت له المتاعب

74
00:06:21,530 --> 00:06:24,480
—إن كان هو أنت، فأودّ

75
00:06:24,480 --> 00:06:28,330
.إنّها مشكلتي أنا حتّى إن كنتُ هو

76
00:06:29,160 --> 00:06:33,560
.عليك أن تركّزي على حماية نفسك في غاليا

77
00:06:38,240 --> 00:06:43,400
.سيّدتي روكسي... لطالما كنتِ طيّبة وصادقة

78
00:06:44,280 --> 00:06:47,090
...حتّى بوجود خطر يهدّد حياتك

79
00:06:47,570 --> 00:06:49,310
.ما زلت قلقة عليّ

80
00:06:49,760 --> 00:06:53,490
،كان ذلك مذهلاً بالفعل
.بالنّظر لأنّك كنت تواجه السّيّدة روكسي

81
00:06:54,550 --> 00:06:55,710
.موغان

82
00:06:55,710 --> 00:06:57,690
.لا عجب أنّك قادر على قتل كيميرا

83
00:06:58,650 --> 00:07:01,060
.كان هنالك شخص آخر يتحكّم به

84
00:07:01,400 --> 00:07:04,180
أتظنّ ذلك أيضًا؟

85
00:07:05,450 --> 00:07:08,280
.كان عليه نفس الشّعار الّذي على السّلمندر

86
00:07:09,070 --> 00:07:10,610
هل إريس خلف كلّ هذا؟

87
00:07:11,440 --> 00:07:14,250
...ألقيتُ نظرة عن كثب على الكيميرا بعد ذلك

88
00:07:14,760 --> 00:07:18,160
.كان استعمال وحش كجوهر له فكرة جريئة

89
00:07:18,800 --> 00:07:22,080
أنا مندهش من قدرتك على اكتشاف
.ذلك فقط من النّظر إليه

90
00:07:22,630 --> 00:07:27,100
لقد درست عائلتي تكنولوجيا
.غاليا المفقودة لأجيال

91
00:07:27,100 --> 00:07:30,970
،كان أبي باحثًا موهوبًا
.وكذلك هي ابنتي الآن

92
00:07:30,970 --> 00:07:32,430
.يا له من أب حنون

93
00:07:32,840 --> 00:07:35,270
.لا تشبهني أبدًا! إنّها ذكيّة جدًّا

94
00:07:35,270 --> 00:07:39,510
الكيميرا وحوش اصطناعيّة صُنعت
.باستعمال تكنولوجيا تابعة لغاليا

95
00:07:40,050 --> 00:07:42,900
إنّ سماحك لابنتك بفحص واحد منها
.قد تكون فكرة جيّدة

96
00:07:42,900 --> 00:07:45,110
هل تحاول القول أنّك تريدني أن أعرّفك بابنتي؟

97
00:07:46,540 --> 00:07:48,320
...لا، ذلك ليس ما قصدت بتاتًا

98
00:07:48,320 --> 00:07:51,530
!لن أسمح لك بمقابلة رايني

99
00:07:51,530 --> 00:07:54,460
!سبق وأخبرتك! ذلك ليس ما أحاول قوله

100
00:07:54,460 --> 00:07:56,600
!ماذا تقصد إذًا؟

101
00:07:56,600 --> 00:07:58,570
!كان مجرّد اقتراح

102
00:07:56,600 --> 00:07:59,560
،ما عاد يبدو لي كأب حنون
!بل صار مجرّد غبيّ عجوز

103
00:08:02,130 --> 00:08:04,840
أخبريني يا رايني، هل سمعت بأمر رافال؟

104
00:08:05,290 --> 00:08:08,750
هناك أمر ما يخصّ وريث فليريك؟

105
00:08:09,320 --> 00:08:12,800
هل سبّب له موت هادو الجنون أو ما شابه؟

106
00:08:12,800 --> 00:08:14,460
.قد يكون لذلك علاقة أيضًا

107
00:08:14,460 --> 00:08:18,930
تقول الشّائعات أنّه حبس نفسه
.في غرفته ويدرس حجر الفيلسوف

108
00:08:19,930 --> 00:08:21,310
حجر الفيلسوف؟

109
00:08:21,310 --> 00:08:23,930
.يبدو أنّه حصل عليه في تنبرن

110
00:08:23,930 --> 00:08:27,660
.ذهب في رحلة بحث إلى هناك قبل موت هادو

111
00:08:29,280 --> 00:08:30,990
حجر الفيلسوف...؟

112
00:08:30,990 --> 00:08:33,950
.جحر الفيلسوف... ها هو ذا

113
00:08:34,770 --> 00:08:38,860
.يُفترض أنّ بإمكانه شفاء كلّ الجروح

114
00:08:38,860 --> 00:08:40,170
!هذا مذهل

115
00:08:40,680 --> 00:08:44,230
...كما يمنح مالكه قوّة كبيرة

116
00:08:44,230 --> 00:08:45,420
قوّة؟

117
00:08:45,420 --> 00:08:50,290
.ولكن في المقابل، يتغلّب على عقله وجسده

118
00:08:50,290 --> 00:08:51,590
...هذا

119
00:08:51,590 --> 00:08:53,140
.السّيطرة على العقل

120
00:08:53,650 --> 00:08:57,230
علام ينوي في رأيك؟

121
00:08:57,700 --> 00:08:59,280
.لا أدري

122
00:09:04,110 --> 00:09:08,130
.المجال إي. ذلك ما عليك أن تصبو إليه

123
00:09:08,780 --> 00:09:10,490
ما هو المجال إي؟

124
00:09:10,840 --> 00:09:13,000
.إنّه مستوى قوّة يوجد فيه التّنّين المقدّس

125
00:09:13,360 --> 00:09:17,440
.إن لم تستطع بلوغه، فلن تتمكّن من مقاتلته

126
00:09:17,440 --> 00:09:22,000
،لكن إن ضغطت على نفسك أكثر
.فستتغلّب عليك مهارتك وستفقد السّيطرة

127
00:09:22,660 --> 00:09:26,210
كيف يمكنني بلوغ قوّة من ذلك المستوى...؟

128
00:09:33,070 --> 00:09:34,720
...ذلك الإنذار

129
00:09:36,570 --> 00:09:37,720
.سيّدتي روكسي

130
00:09:38,390 --> 00:09:42,390
.هناك تدافع كبير... ثمّة مسيرة موت في طريقها إلينا

131
00:09:47,590 --> 00:09:48,940
.سننطلق للتّصدّي لها

132
00:10:01,720 --> 00:10:02,740
!سننطلق إلى غاليا

133
00:10:05,320 --> 00:10:06,550
!اهربوا

134
00:10:18,360 --> 00:10:20,090
.هذه هي مسيرة الموت إذًا

135
00:10:21,090 --> 00:10:22,200
...الجيش الملكيّ

136
00:10:26,610 --> 00:10:28,790
ستقوم بدور البطل ثانية؟

137
00:10:29,130 --> 00:10:32,710
،إن كانت مجرّد مسيرة موت
.فإنّ السّيّدة روكسي أهل لذلك

138
00:10:37,360 --> 00:10:39,210
ستدخل وضع الاقتراب من التّضوّر جوعًا؟

139
00:10:39,210 --> 00:10:42,000
.صرت قادرًا على التّحكّم به أفضل من ذي قبل

140
00:10:42,660 --> 00:10:45,070
.سيكون علينا أن نتأهّب للانطلاق في أيّ لحظة

141
00:10:45,070 --> 00:10:46,880
.يجب أن نكتشف ما يحدث ونضع حدًّا له

142
00:10:46,880 --> 00:10:50,820
.ما يحدث؟ لا أظنّنا سننتظر كثيرًا يا فيت

143
00:10:50,820 --> 00:10:51,460
ماذا؟

144
00:10:52,010 --> 00:10:55,600
.هناك شيء ما يقترب من الجيش الملكيّ من الشّرق

145
00:10:57,370 --> 00:10:58,890
...لا أرى أيّ شيء

146
00:11:01,310 --> 00:11:02,310
!أهو تحت الأرض؟

147
00:11:02,670 --> 00:11:05,010
.إنّه يتحرّك عبر الأرض كما يسبح حوت في الماء

148
00:11:05,010 --> 00:11:06,770
.ويبدو كبيرًا جدًّا

149
00:11:07,580 --> 00:11:10,980
،إن استمرّ في ذلك الاتّجاه
!فسيكون تحت الجيش الملكيّ قريبًا

150
00:11:11,590 --> 00:11:14,640
.تركّز روكسي والبقيّة على مسيرة الموت

151
00:11:14,640 --> 00:11:17,950
سيكونون في ورطة كبيرة
.إن تعرّضوا لهجوم مفاجئ

152
00:11:17,950 --> 00:11:20,140
!سُحقًا... تعرف ما العمل يا جشع

153
00:11:20,140 --> 00:11:21,160
!بالطّبع

154
00:11:22,160 --> 00:11:25,870
بنفس الطّريقة الّتي استطاع بها هارون
...تجاوز حدوده بفضل مهارة الشّراهة

155
00:11:26,680 --> 00:11:31,840
أستطيع استعمال الشّراهة لتضخيم
!شحن الطّلقة ومنحها مدى مضاعفًا

156
00:11:32,510 --> 00:11:36,560
فنّ معدّل، يُمكن استعماله فقط
.في حالة الاقتراب من التّضوّر جوعًا

157
00:11:36,560 --> 00:11:38,600
!الطّلقة اللّولوبيّة المشحونة

158
00:11:43,100 --> 00:11:45,680
تعزيز المدى وقوّة الاختراق؟

159
00:11:45,680 --> 00:11:47,810
.فكرة ممتازة

160
00:11:47,810 --> 00:11:51,720
لا يمكنني الاعتماد دائمًا على التّقنيّات
.السّرّيّة نظرًا لكونها مكلّفة كثيرًا

161
00:11:52,270 --> 00:11:53,480
!ها هو قادم

162
00:11:56,270 --> 00:11:58,610
!أرأيت؟! صِدتُ واحدًا كبيرًا

163
00:11:59,720 --> 00:12:00,850
!ذلك الشّعار

164
00:12:00,850 --> 00:12:02,870
...إنّه نفس الشّعار السّابق

165
00:12:02,870 --> 00:12:05,120
!سنكتشف هذه المرّة من خلف هذا

166
00:12:10,010 --> 00:12:12,130
ما بالك؟ لماذا تضحك؟

167
00:12:12,130 --> 00:12:18,960
كنتُ أفكّر فقط... أنّي ما كنتُ لأفكّر
.أبدًا في القفز من ارتفاع كهذا من قبل

168
00:12:18,960 --> 00:12:20,090
ما الّذي تتحدّث عنه؟

169
00:12:20,730 --> 00:12:23,890
!حان الوقت لتخبرني من تكون

170
00:12:25,810 --> 00:12:27,480
...وحش متوّج

171
00:12:27,480 --> 00:12:31,340
إحصائيّات قدرته على التّحمّل وسحره
.وروحه كلّها تجاوزت العشرة ملايين

172
00:12:31,690 --> 00:12:34,700
حتّى فارس مقدّس سيكون في ورطة
.كبيرة في مواجهة هذا الشّيء

173
00:12:35,370 --> 00:12:37,190
!حوّلني إلى الدّرع السّحريّ

174
00:12:43,030 --> 00:12:44,360
!ما هذا؟

175
00:12:44,360 --> 00:12:45,490
.حمض قويّ

176
00:12:45,490 --> 00:12:47,070
!إنّها تُمطر حمضًا؟

177
00:12:47,770 --> 00:12:49,460
...والرّائحة فظيعة

178
00:12:49,460 --> 00:12:53,720
يُمكن لسحر التّآكل إضافة تأثيره
.للهجمات الجسديّة

179
00:12:54,500 --> 00:12:57,070
...إنّه مزيج من الحمض وسحر التّآكل

180
00:12:57,070 --> 00:12:59,970
لا بدّ أنّه كان يستعمل هذا
.لإذابة الأرض والسّباحة خلالها

181
00:13:00,410 --> 00:13:03,180
.ستموت إن لمسك. كن حذرًا

182
00:13:03,180 --> 00:13:05,670
.لن نتمكّن من القتال عن قرب هكذا

183
00:13:06,200 --> 00:13:08,900
،وإن قمتَ بتقطيعه
،فسينشر الحمض في كلّ مكان

184
00:13:08,900 --> 00:13:11,900
.سيذيب حتّى عظامك وتصير وحلاً مقرفًا

185
00:13:12,370 --> 00:13:14,860
!كفّ عن محاولة جعلي أتصوّر أشياء مقرفة

186
00:13:14,860 --> 00:13:16,940
ما الّذي ستفعله الآن؟

187
00:13:17,260 --> 00:13:19,570
!خذ 10 في المائة

188
00:13:20,950 --> 00:13:23,200
!ثمّ سنعزّز التّقنيّة السّرّيّة بالنّار

189
00:13:23,510 --> 00:13:24,790
!لنبخّره

190
00:13:29,690 --> 00:13:30,640
هل نجحنا؟

191
00:13:31,550 --> 00:13:32,620
لقد اختفى؟

192
00:13:42,010 --> 00:13:44,030
!كيف استطاع ذلك؟

193
00:13:44,030 --> 00:13:48,160
.انفصل وواصل الهجوم. هكذا إذًا

194
00:13:48,160 --> 00:13:52,480
حمى نفسه من تقنيتي السّرّيّة
.باستعمال جزء فصله من نفسه

195
00:13:53,240 --> 00:13:54,300
!ذلك الاتّجاه

196
00:13:54,300 --> 00:13:56,230
!إنّه في طريقه إلى الجيش الملكيّ

197
00:13:56,230 --> 00:13:57,380
—مهلاً

198
00:13:58,360 --> 00:13:59,350
!فيت

199
00:13:59,820 --> 00:14:01,290
...إنّها تحاول تأخيري

200
00:14:01,780 --> 00:14:03,190
!الصّليب الكبير

201
00:14:07,450 --> 00:14:10,810
،يبدو أنّها كانت تتجاهلك
...رغم أنّك ستكون وجبة لذيذة لها

202
00:14:10,810 --> 00:14:13,250
.لكن كانت تلك مجرّد خدعة

203
00:14:13,250 --> 00:14:15,410
.هذه ليست حركات قد يقوم بها وحش

204
00:14:18,090 --> 00:14:19,940
.لديه جوهر واحد فقط

205
00:14:20,300 --> 00:14:24,500
بعد التّحرّك تحت الأرض، سيتوجّب
.عليه الصّعود للسّطح من هذا الشّقّ

206
00:14:25,320 --> 00:14:29,850
!وعندما يظهر، سأصوّب وأسحق جوهره

207
00:14:31,200 --> 00:14:33,120
!جشع! خذ 20 بالمائة

208
00:14:33,960 --> 00:14:35,850
!ثمّ أضف هذا أيضًا

209
00:14:38,800 --> 00:14:42,390
!طلقة طائر التّرمغان الدّمويّ اللّولوبيّة المشحونة

210
00:14:42,390 --> 00:14:45,860
أأنت جادّ...؟! تريد فعلاً القيام بهذا
!دون تجربته أوّلاً؟

211
00:14:45,860 --> 00:14:49,250
سيتمكّن الهجوم من المرور
.عبر أيّ طُعم وبلوغ الجوهر

212
00:14:49,870 --> 00:14:51,940
.وأراهن أنّ بإمكانك السّيطرة عليه أيضًا

213
00:14:51,940 --> 00:14:54,130
!بطبيعة الحال

214
00:14:57,730 --> 00:14:59,260
!هيّا

215
00:15:05,950 --> 00:15:08,330
.تمّ تفعيل مهارة الشّراهة

216
00:15:06,640 --> 00:15:08,330
ما كان ذلك...؟

217
00:15:14,020 --> 00:15:17,060
...ماذا يحدث هنا؟ سلبتُه روحه، ولكن

218
00:15:17,470 --> 00:15:19,030
لماذا ما زال حيًّا؟

219
00:15:26,480 --> 00:15:29,390
قناع يتلاعب بالإدراك مثل قناعي؟

220
00:15:29,390 --> 00:15:31,960
!أهي إريس؟ تلك المقلّدة اللّعينة

221
00:15:33,330 --> 00:15:34,960
!دعيني أرى وجهك يا إريس

222
00:15:38,430 --> 00:15:42,130
!إنّه سلاح من أسلحة الخطايا المميتة
!سيف المسدّس الأسود، حسد

223
00:15:42,960 --> 00:15:46,520
هذا يجعل من المحتمل جدًّا
.أن تكون إريس من تحمله

224
00:15:51,410 --> 00:15:53,390
.فهمت الآن

225
00:15:53,390 --> 00:15:56,740
هل رأيت كيف أنّ السلايم أصيبت بشيء ما من قبل؟

226
00:15:56,740 --> 00:16:00,500
كان نوعًا ما من الطّلقات السّحريّة
.تُخرج القوّة الكامنة

227
00:16:00,500 --> 00:16:02,970
لذلك السّبب ما زال حيًّا بدون جوهر؟

228
00:16:02,970 --> 00:16:03,990
.نعم

229
00:16:03,990 --> 00:16:07,860
الجوهر بحدّ ذاته صار قادرًا على
.الانفصال، وذلك ما فعله للنّجاة

230
00:16:08,420 --> 00:16:13,080
...عدوّ ينسخ نفسه بشكل لانهائيّ
.أخشى أنّه خصم فظيع بالنّسبة لك

231
00:16:16,050 --> 00:16:17,750
!هـ-هيّا يا فيت! إنّها تهاجم

232
00:16:22,490 --> 00:16:24,160
فيت... هل...؟

233
00:16:32,530 --> 00:16:34,850
.حبس أنفاسي ليس ممتعًا

234
00:16:35,210 --> 00:16:39,840
...سحر تآكل أوميغا سلايم
عرفتَ كيف يعمل سلفًا؟

235
00:16:39,840 --> 00:16:41,860
أنا أقاتل بشراهة، صحيح؟

236
00:16:41,860 --> 00:16:44,160
.تمّ تفعيل مهارة الشّراهة

237
00:16:42,910 --> 00:16:45,200
.كنتُ أقول لنفسي من قبل أنّي لم آكل ما يكفي

238
00:16:45,200 --> 00:16:46,570
.لا تضغط على نفسك كثيرًا

239
00:16:47,200 --> 00:16:49,120
.لن يكون السلايم ندًّا لي بعد الآن

240
00:16:50,060 --> 00:16:54,030
،إن ارتفعت إحصائيّاتك فجأة
!فقد تدفع مهارتك للعمل بشكل مفرط

241
00:16:54,700 --> 00:16:55,990
...قبل حدوث ذلك

242
00:16:55,990 --> 00:16:58,000
!سأطيح بإريس

243
00:17:00,420 --> 00:17:01,990
!صدّت سهمي؟

244
00:17:01,990 --> 00:17:03,960
.انظر إلى إحصائيّاتك

245
00:17:05,100 --> 00:17:07,340
.لقد بلغت أعلى حدّ يمكن لبشريّ بلوغه

246
00:17:07,340 --> 00:17:11,240
...سيكون عليك الارتقاء لمستويات غير بشريّة
.المجال إي هو الخيار الوحيد للتّقدّم أكثر

247
00:17:11,240 --> 00:17:13,720
...إذًا فلم تنفع هجماتي

248
00:17:14,570 --> 00:17:16,830
لأنّ شخصًا وصل للمجال إي

249
00:17:16,830 --> 00:17:20,130
.سيكون منيعًا لهجمات أيّ أحد آخر

250
00:17:21,730 --> 00:17:23,650
!سُحقًا

251
00:17:30,030 --> 00:17:31,490
.إنّك تضيّع وقتك

252
00:17:31,490 --> 00:17:32,950
!هذا الشّخص ليس إريس؟

253
00:17:53,060 --> 00:17:56,300
...إنّه... قويّ جدًّا

254
00:18:00,590 --> 00:18:02,730
...لكن لا يمكنني الانتظار

255
00:18:04,600 --> 00:18:07,900
...عليّ أن أكون جاهزًا للقتل... وجاهزًا لأموت

256
00:18:10,350 --> 00:18:12,570
!مهما كان الثّمن

257
00:18:14,030 --> 00:18:15,400
.انتهى أمرك

258
00:18:16,520 --> 00:18:17,990
...لذا

259
00:18:19,040 --> 00:18:21,450
!امنحيني القوّة الّتي أحتاج

260
00:18:21,920 --> 00:18:23,610
!يا مهارة الشّراهة

261
00:18:31,920 --> 00:18:34,630
...هذه القوّة... لا يُعقل

262
00:18:34,630 --> 00:18:36,590
!...المجال إي

263
00:18:37,840 --> 00:18:39,060
.أنا مدين لك

264
00:18:39,470 --> 00:18:43,520
.لو أنّي لم ألتقِ بك، لما وصلت لهذا الحدّ

265
00:18:44,880 --> 00:18:45,880
!هيّا بنا

266
00:18:51,820 --> 00:18:53,610
!لا تعترض طريقي

267
00:18:57,740 --> 00:18:59,670
!يمكنني رؤية طلقاته بوضوح الآن

268
00:19:03,340 --> 00:19:04,410
ستار دخانيّ؟

269
00:19:17,950 --> 00:19:19,190
!نورذرن؟

270
00:19:21,170 --> 00:19:23,350
.تلك نصف الحقيقة

271
00:19:23,350 --> 00:19:25,960
نصف الحقيقة؟ ماذا تقصد بذلك؟

272
00:19:26,780 --> 00:19:28,230
.سؤال وجيه

273
00:19:28,810 --> 00:19:31,910
.لكنّي أكثر حذرًا من إريس

274
00:19:32,690 --> 00:19:35,650
ناي؟ ما الّذي تفعله؟

275
00:19:37,590 --> 00:19:39,130
.سترى قريبًا

276
00:19:48,000 --> 00:19:49,480
!تنّين مقدّس

277
00:19:49,480 --> 00:19:52,050
!فيت، إنّه متّجه غربًا

278
00:19:53,110 --> 00:19:54,420
!...السّيّدة روكسي

279
00:19:54,420 --> 00:19:57,630
.يحتاج لثلاثين ثانية أخرى فحسب

280
00:19:57,630 --> 00:19:58,590
!سُحقًا

281
00:19:58,590 --> 00:20:03,240
سنبذل أنا والتّنّين المقدّس الآن
!كلّ جهدنا لقتلها

282
00:20:03,240 --> 00:20:06,810
!لذلك دعنا نراك تبذل كلّ شيء لإيقافنا

283
00:20:10,410 --> 00:20:11,800
!أمامك يا فيت

284
00:20:12,150 --> 00:20:13,900
!جدار من السلايم؟

285
00:20:13,900 --> 00:20:15,860
.واضح أنّه يحاول توفير الوقت

286
00:20:16,150 --> 00:20:17,820
!...ذلك الوغد

287
00:20:17,820 --> 00:20:19,860
!سُحقًا، عليّ الإسراع

288
00:20:29,090 --> 00:20:30,120
!ما ذلك الشّيء؟

289
00:20:30,120 --> 00:20:32,540
!إنّه التّنّين المقدّس! جدوا مكانًا آمنًا جميعًا

290
00:20:35,130 --> 00:20:36,590
...أبي

291
00:20:37,640 --> 00:20:39,900
!أعرني قوّتك

292
00:20:52,460 --> 00:20:53,750
!سيّدتي روكسي

293
00:21:18,280 --> 00:21:22,960
!ليس وأنا هنا

294
00:21:33,840 --> 00:21:34,950
في؟

295
00:21:39,850 --> 00:21:41,200
أهذا أنت يا في؟

296
00:21:55,650 --> 00:21:57,140
...لم أرك منذ مدّة

297
00:22:01,020 --> 00:22:02,370
.يا سيّدتي روكسي

298
00:23:36,440 --> 00:23:38,220
".التهام"