1
00:00:11,780 --> 00:00:13,290
!اهربن جميعاً

2
00:00:14,610 --> 00:00:15,820
...إنّها

3
00:00:23,000 --> 00:00:25,880
!ما الذي تفعلينه يا كيورورو؟ اهربي بسرعة

4
00:00:25,880 --> 00:00:27,260
...أ-أجل

5
00:00:27,920 --> 00:00:29,380
!كيورورو-تشان

6
00:00:45,610 --> 00:00:46,610
!كيورورو

7
00:00:47,250 --> 00:00:49,900
من كان ذاك الصديق؟

8
00:00:58,450 --> 00:00:59,500
!من هنا

9
00:01:01,830 --> 00:01:04,890
!بسرعة، قبل أن ترجع

10
00:01:17,370 --> 00:01:18,680
سرفال

11
00:01:19,330 --> 00:01:20,640
...أنتِ

12
00:01:22,970 --> 00:01:25,830
!بسرعة! سترجع هنا في أيّ لحظة

13
00:01:29,180 --> 00:01:30,770
!سرفال

14
00:01:35,910 --> 00:01:36,820
أأنتِ بخير؟

15
00:01:39,290 --> 00:01:39,910
أجل

16
00:01:42,620 --> 00:01:46,330
يبدو أنّ تحذيري أنقذ حياتكن

17
00:01:46,330 --> 00:01:49,860
!أنت، حذّرنا مُبكراً المرة القادمة

18
00:01:49,860 --> 00:01:51,730
...إن كان الخطر بذاك القرب بالفعل

19
00:01:53,050 --> 00:01:56,390
أنتِ يا سرفال، حمداً لله

20
00:01:56,390 --> 00:01:57,630
حسنٌ

21
00:01:57,630 --> 00:02:00,430
يبدو أنّكم لم تعودا بحاجة لمرشد غابة

22
00:02:00,430 --> 00:02:02,390
انتهى عملي هنا

23
00:02:02,390 --> 00:02:03,500
وداعاً

24
00:02:05,600 --> 00:02:07,410
ماذا؟ مُحال

25
00:02:07,410 --> 00:02:11,650
لاكي-سان هذا لم يقم بعمل كثير أبداً

26
00:02:12,190 --> 00:02:13,310
!رجعت؟

27
00:02:14,190 --> 00:02:14,890
!شيءٌ ما قادم

28
00:02:14,890 --> 00:02:15,780
ما هو؟

29
00:02:18,540 --> 00:02:19,070
اصعدن

30
00:02:19,780 --> 00:02:20,490
!بسرعة

31
00:02:22,380 --> 00:02:23,770
انطلق يا لاكي-سان

32
00:02:23,770 --> 00:02:26,290
عُلِم، سنرجع عبر أقصر طريق

33
00:04:13,940 --> 00:04:16,090
أأنتن بخير؟

34
00:04:16,090 --> 00:04:16,930
أجل

35
00:04:16,930 --> 00:04:18,610
بخير تماماً

36
00:04:19,650 --> 00:04:23,530
أنقذتِنا حقاً، لكن تُقلقني هذه المركبة

37
00:04:23,530 --> 00:04:26,010
ستحتاج بعض الصّيانة قريباً

38
00:04:26,010 --> 00:04:27,320
سأقوم بذلك عندما نرجع

39
00:04:29,690 --> 00:04:32,410
مُذهل، شعورٌ رائع

40
00:04:32,410 --> 00:04:35,350
سرفال، لا تسقطي

41
00:04:35,350 --> 00:04:37,190
سأكون بخير

42
00:04:38,270 --> 00:04:40,340
ما اسمك إذاً؟

43
00:04:40,340 --> 00:04:41,810
أنا كيورورو

44
00:04:41,810 --> 00:04:43,480
أنا سرفال

45
00:04:43,480 --> 00:04:45,010
أنا كاركال

46
00:04:45,010 --> 00:04:46,100
ماذا عنك؟

47
00:04:46,610 --> 00:04:49,680
ينادونني... كابان

48
00:04:50,910 --> 00:04:53,890
كابان-سان، شكراً لك على إنقاذنا

49
00:04:54,320 --> 00:04:55,650
على الرحب

50
00:04:56,180 --> 00:04:59,660
كنتُ أبحث عن بعض الأشياء للعشاء

51
00:05:00,090 --> 00:05:01,610
افتحن الحقيبة هناك

52
00:05:04,190 --> 00:05:05,450
يمكنك أكل هذه؟

53
00:05:05,450 --> 00:05:06,530
كما هي؟

54
00:05:06,530 --> 00:05:07,910
كلا، سأقوم بطهوها

55
00:05:08,540 --> 00:05:11,120
ماذا كنتن تفعلن هناك؟

56
00:05:11,120 --> 00:05:14,160
كنتُ أبحث عن منزلي

57
00:05:14,160 --> 00:05:15,340
منزلك؟

58
00:05:15,340 --> 00:05:17,490
...أجل، المنزل هو

59
00:05:17,490 --> 00:05:19,730
المكان الذي عشتِ فيه، صحيح؟

60
00:05:19,730 --> 00:05:20,680
أجل

61
00:05:20,680 --> 00:05:24,420
أيمكن أنّك... بشرية؟

62
00:05:24,420 --> 00:05:28,580
ماذا؟ أجل... أظنّ ذلك

63
00:05:28,580 --> 00:05:30,190
أنتِ مثلي إذاً

64
00:05:30,190 --> 00:05:31,680
ماذا؟ حقاً؟

65
00:05:32,090 --> 00:05:35,190
...أجل، بالمناسبة، منزلي

66
00:05:35,810 --> 00:05:36,530
!هو ذاك

67
00:05:38,290 --> 00:05:40,650
ذاك... منزلك؟

68
00:05:44,780 --> 00:05:47,040
يبدو مُذهلاً جداً

69
00:05:47,040 --> 00:05:47,910
أليس كذلك؟

70
00:06:03,470 --> 00:06:05,460
هذا هو العرين البشري إذاً؟

71
00:06:06,140 --> 00:06:08,600
أيبدو منزلك هكذا أيضاً؟

72
00:06:08,600 --> 00:06:11,510
كلا، لا أظنّه يشبهه البتّة

73
00:06:13,310 --> 00:06:14,470
من هنا

74
00:06:14,470 --> 00:06:16,020
تفّضلوا بالدخول لمنزلي

75
00:06:20,910 --> 00:06:24,780
حتّى الفتاة التي كانت تلاحقنا
لا يمكنها الدخول هنا

76
00:06:24,780 --> 00:06:25,940
لذا يمكنكن الاسترخاء

77
00:06:25,940 --> 00:06:28,400
أيّ صديق كانت تلك؟

78
00:06:29,460 --> 00:06:30,740
وحش

79
00:06:30,740 --> 00:06:31,950
وحش؟

80
00:06:31,950 --> 00:06:32,830
ما ذلك؟

81
00:06:33,410 --> 00:06:36,210
أتعرفن عن تحوّل الحيوانات لأصدقاء

82
00:06:36,210 --> 00:06:37,790
عندما يلمسها نجم رملي؟

83
00:06:37,790 --> 00:06:40,370
أجل، ذلك ما حصل لنا

84
00:06:40,740 --> 00:06:45,110
لكن لا تتحول كلّ الحيوانات لأصدقاء

85
00:06:45,110 --> 00:06:46,210
في حالات نادرة

86
00:06:47,110 --> 00:06:49,250
تتحوّل بعضهم لذاك الشكل

87
00:06:50,620 --> 00:06:56,010
من لم يصبحوا أصدقاء يُعرفون بالوحوش

88
00:06:57,590 --> 00:06:58,980
...وحوش

89
00:06:58,980 --> 00:07:02,560
بخلاف الأصدقاء، الوحوش شرسةٌ جداً

90
00:07:02,970 --> 00:07:04,400
هل رأيتن معصمي ذاك الوحش؟

91
00:07:04,800 --> 00:07:08,240
أجل، كان يتدلى منهما ما يشبه السلاسل

92
00:07:08,670 --> 00:07:13,500
قبل زمن طويل، حاول البشر التحكم بالوحوش

93
00:07:13,500 --> 00:07:15,360
لكن لم يستطيعوا

94
00:07:15,360 --> 00:07:18,200
السلاسل المكسورة بقايا من ذاك الوقت

95
00:07:22,210 --> 00:07:24,300
أعددنا شاياً

96
00:07:24,300 --> 00:07:26,250
خبزنا حلويات أيضاً

97
00:07:26,250 --> 00:07:27,750
شكراً لك يا بروفسورة

98
00:07:27,750 --> 00:07:30,490
هيّا، سنقيم جلسة شاي

99
00:07:30,490 --> 00:07:31,720
أجل

100
00:07:33,930 --> 00:07:35,180
شاي؟

101
00:07:35,670 --> 00:07:36,910
رائحته طيّبة

102
00:07:36,910 --> 00:07:38,770
...أجل! هذه

103
00:07:39,180 --> 00:07:42,670
عندما يسقط الرمل كلّه، سيصبح الشاي جاهزاً

104
00:07:44,070 --> 00:07:45,650
ما هذا؟

105
00:07:45,650 --> 00:07:46,990
رمل؟

106
00:07:47,430 --> 00:07:49,250
إنّها أداة لقياس الوقت

107
00:07:50,570 --> 00:07:52,290
هذا جميل

108
00:07:53,270 --> 00:07:55,980
إن كانت تعجبك يمكنك أخذها

109
00:07:57,530 --> 00:07:58,820
سأقدمهما لكن

110
00:07:59,290 --> 00:08:02,230
هذه البروفسورة، بوم أبيض الوجه شمالي

111
00:08:02,230 --> 00:08:03,870
ومساعدتها، بوم النسر الأوراسي

112
00:08:04,230 --> 00:08:08,200
مرحباً، أنا مساعدة كابان، البروفسورة

113
00:08:08,200 --> 00:08:12,340
مرحباً، أنا مساعدة كابان، مساعدة البروفسورة

114
00:08:12,340 --> 00:08:14,850
إنّهما زميلتاي في البحث

115
00:08:14,850 --> 00:08:15,850
البحث؟

116
00:08:15,850 --> 00:08:17,430
أيّ بحث تقومين به؟

117
00:08:17,790 --> 00:08:20,950
مختبر بحثنا في الغرفة المجاورة

118
00:08:20,950 --> 00:08:25,520
إن كنتن مُهتمات، لن نمانع أن نريكن إيّاه
لهذه المرّة فقط

119
00:08:25,950 --> 00:08:27,590
هذا مُتعالٍ نوعاً ما

120
00:08:27,590 --> 00:08:29,110
!أريد رؤيته

121
00:08:29,570 --> 00:08:32,130
إن كنتن مُصرّات لهذا الحد، ربما علينا ذلك

122
00:08:32,130 --> 00:08:33,200
لكن أوّلاً

123
00:08:33,650 --> 00:08:35,160
سنشرب الشاي

124
00:08:35,160 --> 00:08:37,870
أجل، بينما لا يزال دافئاً

125
00:08:54,140 --> 00:08:55,590
اشربيه

126
00:08:58,250 --> 00:08:59,350
إنّه لذيذ

127
00:09:00,460 --> 00:09:02,070
مذاقه طيّب

128
00:09:02,070 --> 00:09:04,150
يُعطيني شعوراً رائعاً

129
00:09:27,770 --> 00:09:29,100
ما هذا المكان؟

130
00:09:29,100 --> 00:09:30,500
!إنّه مُذهل

131
00:09:30,500 --> 00:09:32,540
حسناً، بالطبع ذلك

132
00:09:32,540 --> 00:09:33,460
كذلك

133
00:09:33,890 --> 00:09:36,050
أيّ بحث تقومون به هنا؟

134
00:09:36,050 --> 00:09:37,630
هذا

135
00:09:39,180 --> 00:09:40,540
ما هو؟

136
00:09:40,540 --> 00:09:42,090
نجم رملي

137
00:09:42,670 --> 00:09:45,900
نجري بحوثاً حول التأثيرات التي يتسبب بها

138
00:09:47,770 --> 00:09:52,570
النجم الرملي يحوّل الحيوانات لأصدقاء ووحوش

139
00:09:53,080 --> 00:09:54,150
يقوم بذلك؟

140
00:09:55,060 --> 00:09:56,310
...إنّه جميل

141
00:09:57,270 --> 00:10:00,750
وهذا السيروليوم، نتيجة تحفيز ما

142
00:10:00,750 --> 00:10:02,850
يتحول لسيروليان

143
00:10:02,850 --> 00:10:04,200
سيروليان؟

144
00:10:04,200 --> 00:10:07,100
إنّه ما تأتي منه السيروليان بشكل أساسي

145
00:10:07,590 --> 00:10:10,220
إنّه خطرٌ جداً لذا تعاملي معه بحذر

146
00:10:11,610 --> 00:10:13,420
ما ذلك؟

147
00:10:14,980 --> 00:10:16,260
خريطة لهذه المنطقة

148
00:10:16,850 --> 00:10:18,570
الأماكن المُعلمة بتقاطع

149
00:10:18,570 --> 00:10:21,470
هي حيث ظهر سيروليان أقوياء في الفترة الأخيرة

150
00:10:21,930 --> 00:10:23,260
لمَ يوجد كلّ هذا العدد؟

151
00:10:23,260 --> 00:10:24,990
هذا كثير

152
00:10:24,990 --> 00:10:26,450
...السبب

153
00:10:26,450 --> 00:10:28,690
مجهولٌ حتّى لنا

154
00:10:29,040 --> 00:10:31,390
يُفترض أن نتوج هذا العدد من السيروليان

155
00:10:31,390 --> 00:10:34,400
يتطلّب قدراً هائلاً من السيروليوم

156
00:10:34,800 --> 00:10:40,240
كالنجم الرملي، السيروليوم يصدر من البراكين

157
00:10:40,240 --> 00:10:42,970
لكننا تفقّدنا مختلف البراكين السطحية

158
00:10:42,970 --> 00:10:45,950
ولم يبد أنّ أحدها نشط

159
00:10:45,950 --> 00:10:47,760
هذا غامضٌ حقاً

160
00:10:47,760 --> 00:10:50,250
من أين يمكن أنّها تأتي يا ترى؟

161
00:10:50,250 --> 00:10:52,080
غامضٌ حقاً

162
00:10:55,030 --> 00:10:56,420
تشعرين بالجوع؟

163
00:10:56,850 --> 00:10:59,090
لمَ لا نأكل العشاء إذاً؟

164
00:10:59,090 --> 00:11:01,550
لدينا الفطر الذي جمعتُه قبلاً

165
00:11:02,090 --> 00:11:04,210
سنطلب من البروفسورة طهوه

166
00:11:04,210 --> 00:11:07,770
سأعدّ اليوم وجبة ذوق مُكتسب

167
00:11:11,750 --> 00:11:13,230
!حارق

168
00:11:13,230 --> 00:11:15,690
!ما هذا بالضبط؟

169
00:11:15,690 --> 00:11:17,930
إنّها كسرولة فطر حارّة جداً

170
00:11:17,930 --> 00:11:19,780
!هل من الآمن أكل هذا؟

171
00:11:19,780 --> 00:11:22,820
بالطبع، ستعتادين مع الوقت

172
00:11:22,820 --> 00:11:24,490
لن تريدي التوقف عن أكله

173
00:11:24,490 --> 00:11:28,130
حقاً؟ لا أرى حصول ذلك

174
00:11:29,470 --> 00:11:31,150
كلا، مُحال

175
00:11:34,180 --> 00:11:36,270
تقولين ذلك، لكن لا يمكنك التوقف عن أكله

176
00:11:36,270 --> 00:11:38,340
يجذبك تدريجياً

177
00:11:40,370 --> 00:11:42,590
كيورورو-تشان، ما الخطب؟

178
00:11:42,590 --> 00:11:44,490
كنتُ أفكّر فقط

179
00:11:44,490 --> 00:11:45,300
بمَ؟

180
00:11:45,860 --> 00:11:50,640
ماذا سيحصل لو ألتهم سيروليان أحدهم؟

181
00:11:51,410 --> 00:11:55,580
عندما يُلتهم صديق، سيعود لهيئته الحيوانية

182
00:11:55,580 --> 00:11:58,110
ويفقد كلّ الذكريات من زمن كونه صديقاً

183
00:12:00,310 --> 00:12:04,040
وحتّى لو أصبح صديقاً في وقت ما لاحقاً

184
00:12:04,040 --> 00:12:06,280
لا يستعيد ذكرياته السابقة

185
00:12:06,280 --> 00:12:09,870
هكذا إذاً، هذا مُحزن نوعاً ما

186
00:12:10,500 --> 00:12:11,590
أجل

187
00:12:31,770 --> 00:12:33,360
دُلفين

188
00:12:33,360 --> 00:12:35,100
ما الذي تفعلينه هنا؟

189
00:12:35,520 --> 00:12:37,510
عليكِ الهرب سريعاً

190
00:12:37,510 --> 00:12:38,480
لمَ؟

191
00:12:38,480 --> 00:12:42,780
تذكرين ما قلتُه؟ البحر ليس في حال جيّدة مؤخراً

192
00:12:42,780 --> 00:12:44,500
رأيتِ؟ ها هو

193
00:13:25,220 --> 00:13:27,450
ها هي، وجدتُها

194
00:13:28,330 --> 00:13:29,780
ماذا؟

195
00:13:30,280 --> 00:13:31,530
بروفسورة

196
00:13:31,530 --> 00:13:33,230
ما الذي وجدتِه؟

197
00:13:33,230 --> 00:13:35,740
المكان الذي يأتي منه كلّ السيروليان

198
00:13:35,740 --> 00:13:36,590
ماذا؟

199
00:13:36,590 --> 00:13:37,860
أين هو؟

200
00:13:37,860 --> 00:13:39,250
...برأيي

201
00:13:39,990 --> 00:13:41,960
البحر غالباً

202
00:13:42,370 --> 00:13:43,390
ماذا؟

203
00:13:43,390 --> 00:13:44,220
البحر؟

204
00:13:44,220 --> 00:13:48,110
أجل، تأتي السيروليان من البحر

205
00:13:49,290 --> 00:13:50,420
ماذا؟

206
00:13:50,420 --> 00:13:53,140
ذلك مُحال للأسف

207
00:13:53,140 --> 00:13:54,190
لمَ؟

208
00:13:57,020 --> 00:14:01,310
النجم الرملي والسيروليان يأتيان من البراكين

209
00:14:01,310 --> 00:14:04,610
ليس من المحيط، يأتيان من الجبال

210
00:14:04,610 --> 00:14:07,820
لكني سمعتُ أنّ هناك براكين
في قاع المحيط أيضاً

211
00:14:08,180 --> 00:14:09,720
براكين في المحيط؟

212
00:14:09,720 --> 00:14:11,030
انظرا

213
00:14:12,270 --> 00:14:15,110
هناك أشياء تُدعى ببراكين تحت الماء

214
00:14:15,860 --> 00:14:18,500
!هذا... بركان حتماً

215
00:14:18,500 --> 00:14:22,030
لم أكن أعلم أنّ هناك براكين في البحر

216
00:14:22,030 --> 00:14:25,590
أظنّها تأتي من هناك

217
00:14:26,090 --> 00:14:28,550
هذه السيروليوم

218
00:14:28,550 --> 00:14:29,690
فهمت

219
00:14:29,690 --> 00:14:33,260
...المكان الذي شُوهد فيه أكثر السيروليان مؤخراً

220
00:14:35,610 --> 00:14:38,480
بالفعل، كلّها بجوار المحيط

221
00:14:38,480 --> 00:14:40,500
الأمور تصبح منطقية

222
00:14:40,500 --> 00:14:42,550
منطقية تماماً

223
00:14:42,550 --> 00:14:43,490
أليس كذلك؟

224
00:14:46,100 --> 00:14:46,900
ما هذا؟

225
00:14:47,270 --> 00:14:50,170
علينا الذهاب لأخذ عينة من المحيط فوراً

226
00:14:50,170 --> 00:14:52,010
ماذا؟ الآن؟

227
00:14:52,010 --> 00:14:53,490
أسرعي وتجهّزي

228
00:14:53,490 --> 00:14:55,200
ماذا؟ سأذهب أيضاً؟

229
00:14:55,200 --> 00:14:59,480
!بالطبع! فأنتِ من وضع هذه الفرضية

230
00:14:59,480 --> 00:15:02,920
بما أنّها فرضيتك، عليكِ إثباتها

231
00:15:02,920 --> 00:15:08,170
علينا إخبار كابان-سان وسرفال وكاركال
أننا سنغادر إذاً

232
00:15:23,230 --> 00:15:27,570
هذه منطقة وُجِد فيها الكثير من السيروليان مؤخراً

233
00:15:28,010 --> 00:15:30,700
سيظهر المحيط قريباً

234
00:15:32,410 --> 00:15:34,620
هذا مخيف

235
00:15:34,620 --> 00:15:37,230
نكاد نصل، تماسكي

236
00:15:37,230 --> 00:15:39,980
نقوم بهذا لحماية الحديقة

237
00:15:41,970 --> 00:15:45,790
!أمامنا مهمة كبيرة الآن

238
00:15:46,700 --> 00:15:49,630
!كيورورو-تشان

239
00:15:50,460 --> 00:15:53,870
هذا غريب... أين ذهبت كيورورو-تشان؟

240
00:15:53,870 --> 00:15:55,320
!سرفال

241
00:15:55,320 --> 00:15:56,720
!لا أحد هنا أيضاً

242
00:15:57,250 --> 00:15:58,390
ما الخطب؟

243
00:15:59,060 --> 00:16:01,350
اختفت كيورورو-تشان

244
00:16:01,350 --> 00:16:02,140
ماذا؟

245
00:16:02,470 --> 00:16:05,480
لم أجد البروفسورة والمساعدة أيضاً

246
00:16:05,820 --> 00:16:07,450
اختفيتا أيضاً؟

247
00:16:07,450 --> 00:16:09,070
أين ذهبن يا ترى؟

248
00:16:09,070 --> 00:16:12,720
من المُرجح أنّهن معاً

249
00:16:12,720 --> 00:16:14,750
آمل ألا يقمن بأمرٍ خطر

250
00:16:17,870 --> 00:16:19,230
ما هذا الصوت؟

251
00:16:19,230 --> 00:16:20,120
!لنذهب ونرى

252
00:16:20,120 --> 00:16:20,830
!أجل

253
00:16:24,370 --> 00:16:26,710
سيروليان! ما الذي يفعله هنا؟

254
00:16:26,710 --> 00:16:27,820
!إنّه عملاق

255
00:16:27,820 --> 00:16:30,510
!ويبدو كتلك المركبة تماماً

256
00:16:30,510 --> 00:16:34,070
أجل، يبدو أنّه قلّد شكل الحافلة

257
00:16:34,070 --> 00:16:36,590
لا تظنّين أنّه قام بأكلهن، صحيح؟

258
00:16:36,590 --> 00:16:37,640
!علينا إنقاذهن

259
00:16:37,640 --> 00:16:39,410
!أجل، لننل منه

260
00:16:39,410 --> 00:16:40,930
لمَ الحافلة؟

261
00:16:42,180 --> 00:16:43,940
وصلنا المحيط

262
00:16:43,940 --> 00:16:46,020
ابحثي عن النجم الرملي

263
00:16:46,020 --> 00:16:48,700
الظلام حالك، لا يمكنني رؤية شيء

264
00:16:49,140 --> 00:16:51,450
يمكننا الرؤية بلا مشاكل

265
00:16:51,450 --> 00:16:53,250
ماذا؟ حقاً؟

266
00:16:53,250 --> 00:16:54,660
وجدتُه

267
00:16:54,660 --> 00:16:56,450
رأيتِ؟ إنّه يضيء

268
00:16:56,450 --> 00:16:57,410
أين؟

269
00:17:02,310 --> 00:17:03,410
...أقرب قليلاً

270
00:17:06,490 --> 00:17:08,060
يا لجماله

271
00:17:09,550 --> 00:17:10,900
!لـ-لحظة

272
00:17:12,610 --> 00:17:14,810
!كدتما تُسقطاني

273
00:17:14,810 --> 00:17:16,770
!كان هناك شيءٌ خطر يقترب

274
00:17:16,770 --> 00:17:18,170
انظري للماء

275
00:17:25,770 --> 00:17:27,580
ما-ما هذا؟

276
00:17:27,580 --> 00:17:31,230
لا أستطيع التصديق، لكن يبدو أنّه سيروليان

277
00:17:31,230 --> 00:17:35,010
لكن أيمكن للسيروليان التواجد في الماء؟

278
00:17:35,010 --> 00:17:38,720
بأيّ حال، علينا العودة سريعاً برأيي

279
00:17:38,720 --> 00:17:40,020
أ-أجل

280
00:18:02,610 --> 00:18:04,810
!ماذا نفعل؟ لا يمكننا الاقتراب

281
00:18:04,810 --> 00:18:07,860
!سأبقيه هنا، اذهبي حوله

282
00:18:07,860 --> 00:18:08,520
!حسناً

283
00:18:08,870 --> 00:18:10,900
!تعال هنا! هنا

284
00:18:10,900 --> 00:18:12,770
!قلتُ هنا

285
00:18:14,620 --> 00:18:17,820
!هنا! كلا، هنا

286
00:18:17,820 --> 00:18:20,160
حسنٌ، وقت إنهاء هذا

287
00:18:30,260 --> 00:18:31,850
كان صعباً

288
00:18:31,850 --> 00:18:33,500
أجل

289
00:18:35,710 --> 00:18:38,510
أأنتِ بخير؟

290
00:18:38,510 --> 00:18:39,340
أجل

291
00:18:39,910 --> 00:18:40,750
شكراً لكما

292
00:18:40,750 --> 00:18:42,550
على الرحب

293
00:18:42,550 --> 00:18:45,200
...حسنٌ، علينا الذهاب للبحث عن كيورورو

294
00:18:46,770 --> 00:18:48,350
!يا رفاق

295
00:18:50,560 --> 00:18:52,500
!كيورورو-تشان

296
00:18:52,500 --> 00:18:53,650
!أنتن بخير

297
00:18:53,650 --> 00:18:55,980
يا إلهي، أين ذهبتن؟

298
00:18:55,980 --> 00:18:56,990
للمحيط

299
00:18:56,990 --> 00:18:58,210
!انظري

300
00:18:59,570 --> 00:19:01,010
ما هذا؟

301
00:19:01,010 --> 00:19:04,160
إجابة السؤال الذي كان يحيرنا

302
00:19:08,570 --> 00:19:11,230
أدعو بأن تجدي منزلك

303
00:19:11,230 --> 00:19:14,100
كوني حذرة في رحلتك

304
00:19:14,100 --> 00:19:17,050
خذي هذه معك، سيكون ذا فائدة

305
00:19:17,050 --> 00:19:18,210
ما هو؟

306
00:19:18,210 --> 00:19:19,630
إنّه لاكي بيست

307
00:19:21,930 --> 00:19:24,010
هذا لاكي-سان؟

308
00:19:24,010 --> 00:19:27,640
صحيح، سأرشدكن من هنا

309
00:19:27,640 --> 00:19:29,350
!شكراً

310
00:19:29,700 --> 00:19:32,630
إن واجهتن أيّ مشاكل في سفركن

311
00:19:32,630 --> 00:19:38,390
ابحثن عن صديقة تُدعى مارغي في مكان
يُدعى بالمسرح الحيّ

312
00:19:38,390 --> 00:19:40,950
أنا متأكدة أنّها ستساعدكن

313
00:19:40,950 --> 00:19:43,410
!مارغي؟ حسناً. شكراً لكن

314
00:19:43,410 --> 00:19:45,310
اعتنين بأنفسكن إذاً

315
00:19:45,310 --> 00:19:47,120
شكراً لك على كلّ شيء

316
00:19:47,610 --> 00:19:49,370
هيّا بنا يا كيورورو-تشان

317
00:19:49,370 --> 00:19:50,710
أجل

318
00:19:50,710 --> 00:19:53,540
!منزل! منزل

319
00:19:53,540 --> 00:19:54,670
!انتظري يا سرفال

320
00:19:54,670 --> 00:19:55,930
!أنا متشوقة لإيجاده

321
00:19:55,930 --> 00:19:57,380
!انتظري

322
00:19:58,130 --> 00:20:00,840
...أخبريني، أيمكن أنّها

323
00:20:01,690 --> 00:20:03,010
كانت أنت؟

324
00:20:03,010 --> 00:20:03,740
ماذا؟

325
00:20:04,780 --> 00:20:06,840
كانت سرفال تتكلم عن هذا طوال الوقت

326
00:20:06,840 --> 00:20:10,020
ذهبت في رحلة مع صديق غريب وفق كلامها

327
00:20:10,330 --> 00:20:11,480
ماذا؟

328
00:20:11,480 --> 00:20:14,990
"آسفة، ربما لم تقل "غريب

329
00:20:16,020 --> 00:20:17,350
أجل، ربما

330
00:20:18,270 --> 00:20:20,250
كاركال، أسرعي

331
00:20:21,690 --> 00:20:24,030
!سنتقدم عليك

332
00:20:24,950 --> 00:20:27,550
اعتني بها، حسناً؟

333
00:20:36,910 --> 00:20:38,790
!آسفة، هيّا بنا

334
00:20:38,790 --> 00:20:39,700
!أجل

335
00:22:25,570 --> 00:22:27,310
ها هو السؤال

336
00:22:27,310 --> 00:22:28,560
...يُستعمل عادةً في الكاري

337
00:22:28,560 --> 00:22:30,630
أعرف، الكُركم

338
00:22:30,630 --> 00:22:31,830
صحيح

339
00:22:31,830 --> 00:22:34,490
سأسأل أنا الآن

340
00:22:34,490 --> 00:22:35,720
...قِرفة، قرنفل

341
00:22:35,720 --> 00:22:37,630
أعرف، غارام ماسالا

342
00:22:37,630 --> 00:22:38,890
صحيح

343
00:22:38,890 --> 00:22:41,780
كلتاكما سريعتان في هذا

344
00:22:41,780 --> 00:22:44,170
أجبتُ أسرع قليلاً

345
00:22:44,170 --> 00:22:45,740
كلا، كنتُ أنا أسرع

346
00:22:45,740 --> 00:22:48,410
العبا بلطف! ما رأيكما بالمزيد من الشاي؟

347
00:22:48,410 --> 00:22:49,120
!أجل

348
00:22:49,120 --> 00:22:50,810
!الآن أنتما على وفاق

349
00:22:50,810 --> 00:22:52,760
:الحلقة القادمة السابعة

350
00:22:52,760 --> 00:22:55,250
وراء السرعة