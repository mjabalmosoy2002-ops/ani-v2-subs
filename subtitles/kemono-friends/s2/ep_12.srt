1
00:00:05,390 --> 00:00:07,910
!الأرض مليئة بالماء

2
00:00:09,450 --> 00:00:10,960
...قد يكون هذا

3
00:00:11,170 --> 00:00:13,420
سيّئاً بحق

4
00:00:13,800 --> 00:00:16,110
!إنّه سيّئ جداً

5
00:00:15,880 --> 00:00:21,560
تقصدين أنّ رسمة الوحش قد تأخذ هيئة سيروليان؟

6
00:00:21,430 --> 00:00:24,070
وفقاً لما قالته كاركال-تشان

7
00:00:23,940 --> 00:00:26,660
هذا مُرجّح

8
00:00:26,460 --> 00:00:27,590
...كما

9
00:00:28,060 --> 00:00:29,840
أين هذه الرسمة الآن؟

10
00:00:30,010 --> 00:00:31,310
حسناً

11
00:00:31,870 --> 00:00:34,780
يبدو أنّها بحوزة الحمامة المهاجرة

12
00:00:39,110 --> 00:00:42,340
الحمامة المهاجرة، أين أنت؟

13
00:00:46,020 --> 00:00:49,300
بأيّ حال، علينا البحث عن كيورورو بدايةً

14
00:00:49,080 --> 00:00:50,100
أجل

15
00:00:50,170 --> 00:00:52,900
حسناً، سنساعدك

16
00:00:52,810 --> 00:00:54,340
!إنّها حملة

17
00:00:54,230 --> 00:00:56,200
...حسناً إذاً، سنصعد لـ

18
00:01:00,550 --> 00:01:02,910
ما كان ذلك؟

19
00:01:02,860 --> 00:01:05,500
يا له من مُمتلك خطير

20
00:01:07,790 --> 00:01:09,630
!يا رفاق

21
00:01:09,770 --> 00:01:10,770
كابان؟

22
00:01:10,890 --> 00:01:13,510
من أين حصلتِ على ذاك القارب؟

23
00:01:13,320 --> 00:01:18,590
طلبتُ من لاكي بيست جلبه هنا لأجلي

24
00:01:18,280 --> 00:01:21,080
لكن تطلّب إصلاحه وقتاً

25
00:01:21,060 --> 00:01:22,540
بأيّ حال، أصغين إليّ

26
00:01:22,620 --> 00:01:25,820
أظنّ هذا الفندق سيغرق في البحر قريباً

27
00:01:25,550 --> 00:01:26,670
ماذا؟

28
00:01:26,540 --> 00:01:27,920
...كلا

29
00:01:28,520 --> 00:01:31,860
نشاط البركان تحت الماء يتصاعد

30
00:01:31,580 --> 00:01:34,630
حاله سيصبح أكثر سوءاً على الأرجح

31
00:01:34,600 --> 00:01:37,090
!مما يؤدي للمزيد من السيروليان

32
00:01:36,910 --> 00:01:39,110
سنراقب البحر

33
00:01:39,070 --> 00:01:40,860
!أما أنتن فاعثرن على تلك الفتاة والرسمة

34
00:03:13,860 --> 00:03:15,320
حمامة مهاجرة؟

35
00:03:29,310 --> 00:03:31,810
عُذراً، حمامة مهاجرة؟

36
00:03:37,300 --> 00:03:39,220
أهذا... سيروليان؟

37
00:03:39,390 --> 00:03:41,030
أعرف

38
00:03:41,990 --> 00:03:44,270
لحظة... ما الذي تفعلينه؟

39
00:03:44,190 --> 00:03:46,850
أعرف أنّه سيروليان

40
00:03:47,340 --> 00:03:50,040
لكنّه يذكرني بأصدقائي بشكلٍ ما

41
00:03:51,390 --> 00:03:52,550
آسفة

42
00:03:53,310 --> 00:03:56,640
أعرف أنّه لا معنى لهذا

43
00:03:57,370 --> 00:03:59,200
!انتبهي أيّتها الحمامة المهاجرة

44
00:04:05,730 --> 00:04:06,820
كيورورو-سان؟

45
00:04:08,120 --> 00:04:10,260
لستِ وحيدة

46
00:04:10,120 --> 00:04:11,160
...فنحن

47
00:04:11,390 --> 00:04:12,790
!كيورورو-سان، خلفك

48
00:04:14,130 --> 00:04:16,210
!سرفال! كاركال

49
00:04:16,270 --> 00:04:18,210
!نحن هنا

50
00:04:18,170 --> 00:04:20,390
!بحثنا عنك في كلّ مكان

51
00:04:20,260 --> 00:04:21,960
!شكراً لكما

52
00:04:21,870 --> 00:04:23,860
لسنا بمفردنا

53
00:04:24,580 --> 00:04:26,770
!رفاق... أنتن هنا جميعاً

54
00:04:26,540 --> 00:04:28,830
أجل، فالحديقة في خطر

55
00:04:28,620 --> 00:04:33,420
تقولين ذلك، لكن بدا أنّكِ قلقة
جداً على كيورورو-هان

56
00:04:34,830 --> 00:04:38,380
!انسيا أمر ذلك، افعلا شيئاً حيالها

57
00:04:38,020 --> 00:04:42,720
الباندا العملاقة لا تستيقظ بسهولة
بعدما تغطّ في النوم

58
00:04:42,420 --> 00:04:45,490
!فلتحمليها أنتِ إذاً

59
00:04:45,390 --> 00:04:48,470
إنّها ثقيلةٌ جداً عليّ

60
00:04:46,350 --> 00:04:48,690
رأيتِ؟ لستِ وحيدة

61
00:04:47,980 --> 00:04:50,510
لمَ عليّ أن أحملها؟

62
00:04:49,300 --> 00:04:52,600
!الجميع هنا... كما أنا أيضاً

63
00:04:49,470 --> 00:04:51,630
...أعلم، لكن

64
00:04:53,090 --> 00:04:54,450
!نحن أصدقاؤك

65
00:04:57,270 --> 00:04:58,180
أجل

66
00:04:58,540 --> 00:05:00,480
رفاق، يؤسفني قول هذا

67
00:05:00,750 --> 00:05:03,630
لكن يبدو أنّ لا وقت لدينا للاسترخاء

68
00:05:04,280 --> 00:05:06,120
انظرن حولكن

69
00:05:08,310 --> 00:05:10,860
!نحن محاصرات بالكامل

70
00:05:10,370 --> 00:05:13,160
!مُذهل! إنّهم كثيرون

71
00:05:12,670 --> 00:05:14,380
...يا لهذا العدد

72
00:05:13,890 --> 00:05:16,310
أهم أكثر من السابق؟

73
00:05:15,820 --> 00:05:18,610
أخذوا رسمات كيورورو

74
00:05:18,570 --> 00:05:21,840
سيواصل السيروليان مضاعفة أعدادهم مع وجودها

75
00:05:21,610 --> 00:05:25,070
صحيح! أين رسمتي أيّتها الحمامة المهاجرة؟

76
00:05:24,780 --> 00:05:26,660
لا تزال في الغرفة

77
00:05:27,590 --> 00:05:28,790
!علينا العودة

78
00:05:28,820 --> 00:05:30,990
!كلا! لا يمكنك

79
00:05:30,610 --> 00:05:32,940
!المكان مليء بالسيروليان في الأسفل أيضاً

80
00:05:32,820 --> 00:05:35,190
...لكن إن لم نسترجع الرسمة

81
00:05:35,270 --> 00:05:38,040
سببت رسوماتي كلّ هذا

82
00:05:38,920 --> 00:05:40,880
عليّ فعل شيء

83
00:05:41,570 --> 00:05:42,850
...في هذه الحالة

84
00:05:42,950 --> 00:05:45,100
!سنرافقك

85
00:05:45,020 --> 00:05:46,320
...أنتما

86
00:05:46,410 --> 00:05:51,140
!حسناً، سأمهد طريقاً لكن إذاً

87
00:05:51,880 --> 00:05:53,060
...غوريلا

88
00:05:52,950 --> 00:05:55,090
!هذه هي زعيمتنا

89
00:05:54,890 --> 00:05:56,320
!أنتِ أهلٌ للثقة

90
00:05:57,410 --> 00:05:59,300
لكنّ ساقان ترتجفان

91
00:05:58,810 --> 00:06:00,510
!ا-اخرسي

92
00:06:00,540 --> 00:06:03,150
!حسناً! اتبعن الغوريلا جميعاً

93
00:06:03,090 --> 00:06:05,230
!ليس مُنصفاً أن تنطلقي قبلي

94
00:06:13,180 --> 00:06:15,240
!مُذهل

95
00:06:14,750 --> 00:06:17,080
!تعالا بسرعة بينما الفرصة سانحة

96
00:06:17,210 --> 00:06:18,100
!أجل

97
00:06:21,970 --> 00:06:23,810
كيف حال البحر؟

98
00:06:24,570 --> 00:06:26,160
!لم يهدأ بعد

99
00:06:25,990 --> 00:06:28,030
!قد تكون واحدة أخرى كبيرة في طريقها

100
00:06:27,890 --> 00:06:30,400
أتظنين أنّهن تمكن من استعادة الرسمة؟

101
00:06:30,420 --> 00:06:31,640
لا أدري

102
00:06:31,800 --> 00:06:34,070
لكن علينا الإسراع

103
00:06:36,010 --> 00:06:37,990
كيورورو، فرصتنا الآن

104
00:06:37,670 --> 00:06:38,540
!أجل

105
00:06:40,790 --> 00:06:41,910
...تلك الغرفة

106
00:06:48,890 --> 00:06:50,080
...أهذه

107
00:06:58,810 --> 00:07:00,020
!الآن

108
00:07:10,930 --> 00:07:15,030
يبدو أنّ السيروليان الوحش لم يكن
مُكتملاً بعد

109
00:07:15,020 --> 00:07:16,690
!حمداً لله

110
00:07:16,350 --> 00:07:17,940
يبدو أنّ الرسمة سليمة أيضاً

111
00:07:17,800 --> 00:07:18,850
أجل

112
00:07:18,860 --> 00:07:20,630
لنعد إلى حيث الجميع

113
00:07:20,920 --> 00:07:21,830
أجل

114
00:07:28,090 --> 00:07:29,990
غلبنا الكثير منهم

115
00:07:29,820 --> 00:07:31,460
لا نهاية لهم

116
00:07:31,390 --> 00:07:34,130
سين-تشان، هل اختفوا بعد؟

117
00:07:33,950 --> 00:07:36,460
!أنتِ انظري

118
00:07:36,200 --> 00:07:38,000
يوجد الكثير منهم

119
00:07:37,700 --> 00:07:41,830
!أنتن، توقفن عن التخاذل وقاتلن

120
00:07:41,580 --> 00:07:44,720
أتظنين أنّهن استعدن الرسمة؟

121
00:07:44,790 --> 00:07:46,000
لا أدري

122
00:07:47,250 --> 00:07:50,240
!رفاق! لقد استعدناها

123
00:07:50,140 --> 00:07:51,230
أترون؟

124
00:07:52,710 --> 00:07:54,000
!بلاءٌ حسن

125
00:07:53,690 --> 00:07:54,960
!أحسنتن

126
00:07:54,840 --> 00:07:58,360
!هذا رائع... رائعٌ حقاً

127
00:07:58,120 --> 00:07:59,790
لمَ تبكين؟

128
00:08:00,650 --> 00:08:02,940
لا يزال الوقت باكراً على الاحتفال

129
00:08:02,870 --> 00:08:04,580
انظرن هناك

130
00:08:12,350 --> 00:08:13,500
...أيُفترض أنّهما

131
00:08:13,010 --> 00:08:15,360
نحن؟

132
00:08:14,870 --> 00:08:16,360
...يبدو أنّ

133
00:08:16,130 --> 00:08:18,670
المزيد من الأقوياء قد ظهروا

134
00:08:18,520 --> 00:08:20,440
يكفي هذا

135
00:08:20,210 --> 00:08:22,390
!كلّهم مزيّفون

136
00:08:22,380 --> 00:08:23,940
!هيّا بنا يا سرفال

137
00:08:23,750 --> 00:08:24,690
!أجل

138
00:08:25,150 --> 00:08:26,660
!تمهلا

139
00:08:32,170 --> 00:08:35,430
!ما خطب هذا الشيء؟ إنّه قوي جداً

140
00:08:35,230 --> 00:08:37,240
أأنتما بخير؟

141
00:08:37,030 --> 00:08:39,160
بالطبع هما قويّان

142
00:08:39,350 --> 00:08:41,120
قوّة السيروليان تتغير

143
00:08:41,110 --> 00:08:44,100
بناءً على رابطة البشري التي صنعته

144
00:08:44,260 --> 00:08:50,000
وليس هناك من ترتبط كيورورو به
أكثر من سرفال وكاركال

145
00:08:50,090 --> 00:08:51,500
...لكن هذا

146
00:08:51,970 --> 00:08:55,590
كيورورو، انزلي أوّلاً واحتمي

147
00:08:56,460 --> 00:08:59,060
سنتكفل بالأمر هنا

148
00:08:58,820 --> 00:09:02,230
!كلا! لا يمكنني الذهاب بمفردي وترككن جميعاً

149
00:09:01,740 --> 00:09:02,920
إنّهما محقّتان

150
00:09:03,510 --> 00:09:06,270
وجود شخص بطيء حولنا سيعيقنا فقط

151
00:09:06,190 --> 00:09:08,590
ما علاقة السرعة بهذا؟

152
00:09:08,460 --> 00:09:11,550
كيورورو-تشان، ابقي في مكان آمن مع الرسمة

153
00:09:11,450 --> 00:09:14,260
!أجل، كيلا يظهر المزيد من السيروليان

154
00:09:13,980 --> 00:09:15,430
...لكن

155
00:09:16,390 --> 00:09:17,740
!وجدتُها

156
00:09:18,310 --> 00:09:22,450
تخافين القفز فوق تلك، صحيح؟

157
00:09:22,290 --> 00:09:23,330
ماذا؟

158
00:09:23,510 --> 00:09:26,780
!لذا لا تريدين الذهاب أيّتها الضعيفة

159
00:09:26,460 --> 00:09:28,200
!كـ-كلا

160
00:09:28,100 --> 00:09:29,380
كيورورو-تشان

161
00:09:29,750 --> 00:09:32,370
!اقفزي بأقصى قدرتك وستكونين بخير

162
00:09:33,590 --> 00:09:36,270
لديكِ ما عليكِ فعله

163
00:09:36,270 --> 00:09:37,880
دعينا نتكفل بهذا

164
00:09:38,630 --> 00:09:39,440
حسناً

165
00:09:40,110 --> 00:09:41,440
!علينا الإسراع

166
00:09:41,320 --> 00:09:43,160
!اذهبي يا كيورورو

167
00:09:58,760 --> 00:10:02,360
يسرّني أنكِ هنا حيث عدت

168
00:10:02,460 --> 00:10:05,520
تمكّنا من استعادة الرسمة بأيّ حال، صحيح؟

169
00:10:05,390 --> 00:10:07,460
...لكن لا يزال البقية

170
00:10:07,610 --> 00:10:10,230
أخبرتكِ سرفال بالذهاب، أليس كذلك؟

171
00:10:10,450 --> 00:10:13,240
لذا عليكِ الإيمان بهنّ فقط

172
00:10:13,550 --> 00:10:17,340
كما أنّهما الوحيدتان القادرتان على قتال
أولئك السيروليان غالباً

173
00:10:24,920 --> 00:10:26,350
لا تقلقي

174
00:10:26,500 --> 00:10:30,450
سأعود لهما فورما آخذك لمكان آمن

175
00:10:31,170 --> 00:10:34,540
سرفال... كاركال... رفاق

176
00:10:38,930 --> 00:10:40,590
إنّهما بارعان

177
00:10:40,570 --> 00:10:42,630
!يتحرّكان مثلنا أيضاً

178
00:10:42,380 --> 00:10:44,100
...وكلّ ذلك

179
00:10:44,450 --> 00:10:46,900
بسبب ارتباط تلك الفتاة

180
00:10:46,690 --> 00:10:50,360
يا إلهي... يا لها من مُثيرة متاعب

181
00:10:51,290 --> 00:10:53,750
تبدين سعيدةً مع ذلك

182
00:10:53,420 --> 00:10:54,340
ماذا؟

183
00:10:54,200 --> 00:10:58,340
!لم نكن في تلك الرسمة حتّى

184
00:10:57,850 --> 00:10:59,960
لكنّ الحديقة في خطر

185
00:11:05,990 --> 00:11:08,550
أنا من سبّب كل هذا

186
00:11:09,860 --> 00:11:10,920
...لكن

187
00:11:12,120 --> 00:11:13,630
لا يمكنني فعل شيء

188
00:11:14,630 --> 00:11:16,320
هل هذه النهاية إذاً؟

189
00:11:17,460 --> 00:11:19,800
!جاثمة! طير الفردوس

190
00:11:20,430 --> 00:11:22,740
أهذا ما أردتِه؟

191
00:11:23,410 --> 00:11:27,580
هل رسمتِ تلك الرسمة لجعل كلّ هذا يحصل؟

192
00:11:27,940 --> 00:11:30,880
!كـ-كلا

193
00:11:31,320 --> 00:11:34,390
هل أردتِ فرض صنيعك عليهن

194
00:11:34,600 --> 00:11:37,080
وتعريض الجميع للخطر؟

195
00:11:37,180 --> 00:11:39,840
!كلا! كلا! كلا

196
00:11:39,790 --> 00:11:41,310
أجيبينا إذاً

197
00:11:41,740 --> 00:11:43,760
لمَ رسمتِها؟

198
00:11:44,700 --> 00:11:47,440
لمَ؟ حسناً

199
00:11:47,510 --> 00:11:48,770
لا-لا أدري حقاً

200
00:11:49,730 --> 00:11:54,680
لكنّي أردتُ مصادقتهن... جميعاً

201
00:11:58,670 --> 00:12:00,880
ساعدنني دوماً

202
00:12:01,500 --> 00:12:03,620
لكن لا يمكنني فعل شيء لهن

203
00:12:04,070 --> 00:12:06,440
أردتُ إشعارهن بالسعادة ولو قليلاً

204
00:12:07,100 --> 00:12:08,750
فهمهن

205
00:12:09,240 --> 00:12:11,060
أن أصبح صديقتهن

206
00:12:11,570 --> 00:12:13,300
أحبّهن جميعاً

207
00:12:13,740 --> 00:12:16,770
...كثيراً

208
00:12:18,500 --> 00:12:24,180
!أحبّهن كثيراً

209
00:12:31,260 --> 00:12:34,760
هذا... كلّ ما بالأمر

210
00:12:35,970 --> 00:12:37,580
...سواءً كان حظّاً حسناً أم سيّئاً

211
00:12:37,470 --> 00:12:40,580
يبدو أنّكِ جذبتهن لك بصنع فوضى كهذه

212
00:12:41,710 --> 00:12:44,060
أو ربما كانت مجرد مصادفة

213
00:12:48,530 --> 00:12:49,540
ماذا؟

214
00:12:50,060 --> 00:12:51,540
خطر، خطر

215
00:12:53,860 --> 00:12:54,920
!الوحش

216
00:12:58,580 --> 00:13:00,070
ما الذي ستفعلينه؟

217
00:12:59,990 --> 00:13:01,900
قومي بما يحلو لك الآن

218
00:13:03,220 --> 00:13:04,940
!كيورورو-تشان، هنا

219
00:13:04,450 --> 00:13:06,310
!اصعدي علينا

220
00:13:08,340 --> 00:13:09,540
!كابان-سان

221
00:13:09,670 --> 00:13:12,200
!ارجعي للفندق

222
00:13:12,070 --> 00:13:13,480
!ماذا؟

223
00:13:14,180 --> 00:13:15,230
أرجوك

224
00:13:19,590 --> 00:13:21,310
...غلبنا الكثير

225
00:13:20,820 --> 00:13:22,820
لكنهم يواصلون القدوم

226
00:13:23,390 --> 00:13:25,860
هل هربت كيورورو بسلام؟

227
00:13:26,020 --> 00:13:27,790
آمل ذلك

228
00:13:27,620 --> 00:13:31,030
!رفاق

229
00:13:31,620 --> 00:13:33,840
...سرفال، ألم تكن تلك

230
00:13:33,640 --> 00:13:35,040
!كيورورو-تشان

231
00:13:34,910 --> 00:13:38,560
!رفاق! أحضرتُ أحدهم هنا

232
00:13:39,450 --> 00:13:41,090
أحضرتِ أحدهم؟

233
00:13:40,870 --> 00:13:42,180
لكن من؟

234
00:13:41,860 --> 00:13:43,940
يراودني شعورٌ سيّئ

235
00:13:43,670 --> 00:13:45,030
أنا أيضاً

236
00:13:44,540 --> 00:13:45,940
...أيمكن

237
00:13:50,890 --> 00:13:52,370
!كما ظننت

238
00:13:51,880 --> 00:13:54,690
!كيف يمكنكِ جلبها هنا؟

239
00:13:55,950 --> 00:13:56,990
!ها هي

240
00:14:02,440 --> 00:14:03,430
مُذهل

241
00:14:03,180 --> 00:14:05,590
!غلبت ذاك العدد من السيروليان في لمح البصر

242
00:14:05,100 --> 00:14:07,360
...أختي، تظنين أنّها ربما

243
00:14:07,190 --> 00:14:09,030
!أجل، قد تكون في صفّنا

244
00:14:14,750 --> 00:14:17,600
!ليست في صفّنا أبداً

245
00:14:18,130 --> 00:14:20,050
!إنّها تهاجم الكلّ

246
00:14:19,730 --> 00:14:22,100
!ستنقضّ على أيّ ما يتحرك

247
00:14:22,630 --> 00:14:25,000
علينا التصرّف بينما هي في ثورتها

248
00:14:24,780 --> 00:14:25,720
!أجل

249
00:14:28,050 --> 00:14:30,660
!سرفال! وقت الجدية

250
00:14:30,330 --> 00:14:31,620
!بالطبع

251
00:14:45,870 --> 00:14:48,070
أ-أنتِ بخير؟

252
00:14:48,010 --> 00:14:49,430
!بلاءٌ حسن

253
00:14:48,940 --> 00:14:51,590
!كما يتوقع من أتباع بشر

254
00:14:52,440 --> 00:14:53,750
!واحدة أخرى

255
00:14:53,630 --> 00:14:55,680
!إنّها أكبر من السابقة

256
00:14:58,030 --> 00:14:59,560
!ماذا؟

257
00:14:59,290 --> 00:15:01,860
!قد ينهار في أيّ لحظة

258
00:15:02,140 --> 00:15:04,700
...فندقي

259
00:15:04,210 --> 00:15:05,490
!ثعلبة خفاشية الأذنين

260
00:15:06,290 --> 00:15:07,560
!كيورورو-سان

261
00:15:07,950 --> 00:15:10,080
يجب أن تخبري الجميع في الأعلى

262
00:15:10,230 --> 00:15:12,130
!عليهن صعود هذا القارب

263
00:15:12,250 --> 00:15:15,080
سيغرق الفندق قريباً

264
00:15:15,930 --> 00:15:18,130
!بسرعة جميعاً

265
00:15:17,640 --> 00:15:20,520
!سيغرق هذا الفندق قريباً

266
00:15:20,910 --> 00:15:21,950
...مؤلم

267
00:15:21,670 --> 00:15:23,140
أأنتِ بخير؟

268
00:15:23,790 --> 00:15:28,400
!لا تهلعن! انتظمن في صفّ واحد

269
00:15:31,770 --> 00:15:33,460
ما الذي تفعلينه يا سرفال؟

270
00:15:34,070 --> 00:15:36,260
!علينا الإسراع أيضاً

271
00:15:36,170 --> 00:15:37,660
أ-أجل

272
00:16:07,500 --> 00:16:09,510
نمتُ جيّداً

273
00:16:09,250 --> 00:16:11,150
باندا عملاقة

274
00:16:10,840 --> 00:16:15,250
!أنتِ... مررنا بالكثير هنا

275
00:16:14,760 --> 00:16:17,600
ماذا؟ ما قصدك؟

276
00:16:15,780 --> 00:16:18,230
...فندقي

277
00:16:17,740 --> 00:16:20,110
اختفى تماماً

278
00:16:19,810 --> 00:16:22,280
أحلامي

279
00:16:21,790 --> 00:16:24,110
لا تكتئبي هكذا

280
00:16:23,860 --> 00:16:27,200
انظري! لا تزال نقطة هبوط المروحية
موجودة على الأقل

281
00:16:26,970 --> 00:16:28,460
!ما خطبك؟

282
00:16:28,200 --> 00:16:32,000
!لا جدوى من نقطة المروحية إن زال الفندق

283
00:16:31,750 --> 00:16:33,600
هذا ليس صحيحاً

284
00:16:33,370 --> 00:16:36,950
قال أعضاء ببب أنّهن سيقمن حفلةً لنا

285
00:16:36,690 --> 00:16:38,460
ماذا؟ تمزحين

286
00:16:38,250 --> 00:16:42,030
هذا صحيح، تكلّمنا مع مديرتهن بالفعل

287
00:16:41,730 --> 00:16:43,840
لـ-لكن... كيف سندفع لهن؟

288
00:16:45,070 --> 00:16:46,680
!مئة كعك جاباري

289
00:16:46,410 --> 00:16:47,550
!ماذا؟

290
00:16:48,670 --> 00:16:50,710
!كيف لكِ فعل ذلك؟

291
00:16:50,220 --> 00:16:52,800
لا تكوني شحيحةً هكذا

292
00:16:52,840 --> 00:16:55,440
عليّ المساعدة في التحضير للحفلة إذاً

293
00:16:54,950 --> 00:16:57,670
!انتظري لحظة

294
00:16:57,570 --> 00:17:00,620
!لا تتركاني

295
00:17:10,450 --> 00:17:12,580
إنّهن ثلاثي مُسلٍ، أليس كذلك؟

296
00:17:12,930 --> 00:17:15,310
ليس مثلكن

297
00:17:15,000 --> 00:17:16,960
ماذا؟ نحن؟

298
00:17:16,990 --> 00:17:19,520
كيورورو، كاركال، وأنت

299
00:17:20,040 --> 00:17:21,670
أنتن فريق جيّد

300
00:17:21,640 --> 00:17:23,860
!حقاً؟ مرحى

301
00:17:24,780 --> 00:17:25,560
أخبريني

302
00:17:26,870 --> 00:17:29,480
تظنين أنّنا كنا فريقاً جيّداً أيضاً؟

303
00:17:29,750 --> 00:17:30,620
ماذا؟

304
00:17:31,270 --> 00:17:33,440
!سرفال

305
00:17:34,280 --> 00:17:36,310
!سنذهب الآن

306
00:17:36,520 --> 00:17:39,060
!حسناً! قادمة الآن

307
00:17:39,990 --> 00:17:42,700
آسفة... ما الذي قلتِه؟

308
00:17:42,570 --> 00:17:45,500
لا شيء، لا تهتمي

309
00:17:48,660 --> 00:17:49,800
حسناً

310
00:17:50,470 --> 00:17:51,340
!إلى اللقاء

311
00:18:05,210 --> 00:18:06,770
!آمل أن أراكِ مُجدداً

312
00:18:10,870 --> 00:18:12,070
سرفال

313
00:18:13,580 --> 00:18:16,160
أجل، إنّه وعد

314
00:18:17,130 --> 00:18:18,350
يا كابان-تشان

315
00:18:33,720 --> 00:18:36,460
أأنتِ واثقة أنّك راضية بهذا؟

316
00:18:38,950 --> 00:18:40,510
ما-ما قصدك؟

317
00:18:40,230 --> 00:18:44,670
يا إلهي... المخلوقات المدعوة بالبشر
لا تزال مليئة بالغموض

318
00:18:44,180 --> 00:18:45,380
بالفعل

319
00:18:49,910 --> 00:18:51,960
تأخّرتِ يا سرفال

320
00:18:51,960 --> 00:18:53,500
!آسفة

321
00:18:53,670 --> 00:18:55,170
لا بأس

322
00:18:55,070 --> 00:18:56,530
إذاً يا كيورورو

323
00:18:56,770 --> 00:18:58,470
أين سنذهب تالياً؟

324
00:18:58,310 --> 00:19:01,250
!صحيح! نحن نبحث عن منزلك

325
00:19:02,490 --> 00:19:05,100
وجدتُه بالفعل

326
00:19:04,860 --> 00:19:06,220
!ماذا؟

327
00:19:06,140 --> 00:19:07,790
!أين هو؟

328
00:19:07,690 --> 00:19:11,280
إنّه مكان بهيج ولطيف ودافئ

329
00:19:11,470 --> 00:19:15,010
ليس ما تصورّتُه، لكنّي وجدتُه مع ذلك

330
00:19:17,390 --> 00:19:19,540
يروقني المكان هنا

331
00:19:20,100 --> 00:19:23,650
ماذا؟ الفندق المُنهار هو عرينك؟

332
00:19:23,370 --> 00:19:24,920
!لا تعيشي هناك

333
00:19:24,620 --> 00:19:26,440
ليس ذلك

334
00:19:27,880 --> 00:19:31,360
لديّ أنتما كما البقيّة

335
00:19:31,390 --> 00:19:33,560
لم أعد بحاجة للعودة للمنزل

336
00:19:33,800 --> 00:19:36,420
لذا لا عليّ البحث عنه

337
00:19:37,570 --> 00:19:41,960
أريد إيجاد أشياء أكثر يمكنني فعلها
لمساعدة الجميع من الآن فصاعداً

338
00:19:42,260 --> 00:19:45,580
أريد خوض مغامرات أكثر لتحقيق ذلك

339
00:19:46,730 --> 00:19:48,040
كيورورو

340
00:19:49,030 --> 00:19:51,940
!حسنٌ! لنبدأ الآن

341
00:19:51,800 --> 00:19:53,340
ماذا؟ الآن؟

342
00:19:53,190 --> 00:19:55,560
وأين تنوين أن نذهب؟

343
00:19:55,570 --> 00:19:58,840
...حسناً... بدايةً

344
00:20:02,840 --> 00:20:04,700
لنذهب لأكل شيء

345
00:20:04,930 --> 00:20:07,260
يا لرخاء بالك

346
00:22:02,260 --> 00:22:03,350
ماذا؟

347
00:22:14,370 --> 00:22:16,120
رسمةٌ جميلة