190
00:12:12,970 --> 00:12:14,210
!الجوّ رائع ودافئ قبل كلّ شيء

191
00:12:15,080 --> 00:12:19,170
،ليتنا نستطيع إخراجه من الماء
...فسأختمه حينها

192
00:12:21,050 --> 00:12:22,720
...حسنًا، في تلك الحالة

193
00:12:23,670 --> 00:12:28,490
.مرحبًا أيّها القرد، سيروقني الأمر إن أتيتَ إلى هنا

194
00:12:29,240 --> 00:12:31,060
ما رأيك؟

195
00:12:32,230 --> 00:12:34,840
هل أنت واثق أنّ بإمكاننا استدراجه؟

196
00:12:35,270 --> 00:12:37,990
.لن يُفيد هذا يا رينا-تشان

197
00:12:37,990 --> 00:12:39,360
!افعلي هكذا

198
00:12:41,690 --> 00:12:43,050
هكذا؟

199
00:12:45,940 --> 00:12:49,910
...أريد أن أكون صديقتك أيّها القرد

200
00:12:50,240 --> 00:12:51,410
ألا بأس بذلك؟

201
00:12:52,240 --> 00:12:53,710
!إنّهُ يخرج

202
00:12:53,980 --> 00:12:55,170
...قليلاً بعد

203
00:12:55,170 --> 00:12:56,290
.قليلاً بعد

204
00:13:14,280 --> 00:13:17,100
...لكنّي بذلت جهدي

205
00:13:17,100 --> 00:13:20,420
.لا أظنّ أنّه كان مفتونًا بك لتلك الدّرجة

206
00:13:21,190 --> 00:13:22,440
.أنا لستُ جذّابة

207
00:13:22,780 --> 00:13:24,770
...كان قد بقي القليل وحسب

208
00:13:24,770 --> 00:13:28,440
حسنًا يا كورومي-تشان، أيمكنك استعمال
يد الدّبّ الذّهبيّة؟

209
00:13:28,440 --> 00:13:34,330
...اختفت عندما عدنا من عالم الدّببة

210
00:13:39,750 --> 00:13:41,460
!استعملي هذه بدلاً منها إذًا

211
00:13:41,800 --> 00:13:46,340
!يـ-يـ-يد الدّبّ الذّهبيّة

212
00:13:52,060 --> 00:13:53,140
...كلاّ

213
00:13:53,140 --> 00:13:54,470
!حان دوركِ يا كويْتو-تشان

214
00:13:54,740 --> 00:13:56,490
لِمَ أنا؟

215
00:13:56,490 --> 00:13:59,060
.لأنّك جذّابة للغاية

216
00:13:59,060 --> 00:13:59,900
.صحيح

217
00:14:01,620 --> 00:14:02,990
!توقّف عن التّحديق

218
00:14:02,990 --> 00:14:04,220
...هيّا

219
00:14:04,220 --> 00:14:05,690
.يمكنك أن تنجحي يا كويْتو-تشان

220
00:14:05,690 --> 00:14:06,990
.مستحيل

221
00:14:11,720 --> 00:14:13,330
.تبدو مخيفة نوعًا ما

222
00:14:13,330 --> 00:14:15,290
!كويْتو-سان، جرّبي أن تبتسمي

223
00:14:15,290 --> 00:14:18,080
.تملّقيه وارمقيه بنظرة تشبه نظرة رينا-تشان

224
00:14:18,560 --> 00:14:19,250
أتملّقه؟

225
00:14:20,130 --> 00:14:21,400
.هيّا، ابتسمي

226
00:14:21,920 --> 00:14:24,420
!انظري إليه وتملّقيه

227
00:14:25,620 --> 00:14:27,770
...تبدو مخيفة أكثر من ذي قبل

228
00:14:27,760 --> 00:14:29,010
!تبدين كفتاة جانحة

229
00:14:29,260 --> 00:14:31,300
.كوني أكثر إثارة، أخرجي لسانك وما شابه

230
00:14:31,300 --> 00:14:32,550
!هكذا

231
00:14:33,470 --> 00:14:35,770
.هذا ليس ظريفًا على الإطلاق، هذا كثير

232
00:14:35,770 --> 00:14:37,600
!لوّحي له بيدك، ناده ليأتي إليك

233
00:14:37,600 --> 00:14:38,310
.هكذا

234
00:14:38,690 --> 00:14:40,100
!إنّك تتحدّينه لقتال هكذا

235
00:14:43,060 --> 00:14:44,360
...هذا حارّ

236
00:14:44,360 --> 00:14:45,480
!انسحاب

237
00:14:46,110 --> 00:14:49,240
.ماذا نفعل؟ هُزم الجميع

238
00:14:54,280 --> 00:14:55,330
.لا فرصة أمامك

239
00:14:55,330 --> 00:14:57,200
!ما الذي تعنيه بذلك؟

240
00:14:57,200 --> 00:14:59,250
!مت! مت! مت

241
00:14:57,200 --> 00:14:59,250
.لدينا خيار واحد فقط

242
00:14:59,540 --> 00:15:00,250
وما هو؟

243
00:15:01,830 --> 00:15:03,250
ما الّذي ستقترحه هذه المرّة؟

244
00:15:03,590 --> 00:15:07,880
هل تعلمن أنّ مؤخّرات إناث القردة
.تصبح حمراء بالحرارة

245
00:15:08,130 --> 00:15:10,550
.كما أنّها تبرز مؤخّراتها لاستدراج الذّكور

246
00:15:10,550 --> 00:15:11,720
!فهمت

247
00:15:11,720 --> 00:15:13,760
.إذًا فعلينا أن نجعل مؤخّراتنا حمراء

248
00:15:14,180 --> 00:15:15,930
—والشّخص المناسب بشكل كبير لهذه المهمّة هو

249
00:15:15,930 --> 00:15:16,810
!مستحيل

250
00:15:17,180 --> 00:15:18,100
!أنا أرجوكِ

251
00:15:18,100 --> 00:15:21,060
!ستتمكّنين من استدراج الطّيف بشكل أكثر

252
00:15:21,060 --> 00:15:22,190
!لا أستطيع

253
00:15:22,190 --> 00:15:24,560
!لقد لعقني مرّتين

254
00:15:24,560 --> 00:15:25,770
!أتوسّل إليكِ

255
00:15:26,820 --> 00:15:31,400
أنت لا تأبه لأنّ ذلك الطّيف قد اعتدى عليّ؟

256
00:15:32,200 --> 00:15:35,370
!سأختمه قبل أن يحدث ذلك

257
00:15:37,370 --> 00:15:38,240
.حسنًا

258
00:15:38,910 --> 00:15:40,460
.سأقوم بالأمر إذًا

259
00:15:40,460 --> 00:15:41,870
!سأقوم به

260
00:15:46,090 --> 00:15:47,380
سينباي؟

261
00:15:49,750 --> 00:15:51,630
.هيّا يا هاروهيكو، أسرع

262
00:16:10,820 --> 00:16:12,320
!هذا ليس جيّدًا كفاية

263
00:16:12,320 --> 00:16:13,490
!اجعلها أكثر حيويّة

264
00:16:13,490 --> 00:16:14,740
!أكثر تحرّرًا

265
00:16:14,740 --> 00:16:15,410
...لكن

266
00:16:15,410 --> 00:16:16,780
!بدون لكن

267
00:16:16,780 --> 00:16:20,170
ألا تقدّم كلّ ما لديك وأنت ترسم
!على قماش الرّسم؟

268
00:16:20,170 --> 00:16:22,830
أهذا كلّ ما يعنيه الفنّ لك؟

269
00:16:22,830 --> 00:16:24,640
!هذا أمر خطير أيّها الأبله

270
00:16:30,670 --> 00:16:31,930
!حسنًا

271
00:16:34,560 --> 00:16:35,010
.إنّها باردة

272
00:16:37,260 --> 00:16:39,310
ما هذا الملمس؟

273
00:16:39,680 --> 00:16:41,310
.وكأنّ شعيرات الفرشات ترقص

274
00:16:47,480 --> 00:16:49,820
...يا للنّعومة

275
00:16:50,400 --> 00:16:51,690
.يا للنّعومة

276
00:16:52,240 --> 00:16:53,610
!يا للنّعومة

277
00:16:54,320 --> 00:16:56,450
.إنّها أشبه بقماش رسم من النّوع الرّفيع

278
00:16:57,200 --> 00:16:58,320
.حسنًا، انتهيت

279
00:16:59,330 --> 00:17:00,540
.جيّد

280
00:17:05,160 --> 00:17:05,830
.ها هي ذي

281
00:17:05,830 --> 00:17:08,380
.هيّا يا ماي

282
00:17:08,380 --> 00:17:11,210
هل سينجح هذا في جذبه حقًّا؟

283
00:17:11,210 --> 00:17:15,470
أكان من الضّروريّ أن يكون هاروهيكو من يرسمه؟

284
00:17:16,130 --> 00:17:18,800
!والآن، ننتقل للحدث الأهمّ من العرض

285
00:17:48,040 --> 00:17:50,750
!رائع! إنّك رائعة يا ماي-تشي

286
00:17:54,010 --> 00:17:55,260
.ها هو سيخرج

287
00:17:55,670 --> 00:17:57,630
...لو أمكنني فقط أن أرى قدمي الطّيف

288
00:17:59,260 --> 00:18:01,180
!تماسكِ يا ماي-سينباي! نكاد نحقّق غايتنا

289
00:18:05,600 --> 00:18:06,480
!سينباي

290
00:18:09,310 --> 00:18:09,980
!لا يعقل

291
00:18:11,310 --> 00:18:14,900
!كلاّ

292
00:18:13,780 --> 00:18:14,900
.ها هي ذي

293
00:18:14,900 --> 00:18:15,740
!دفتر رسومي

294
00:18:16,110 --> 00:18:17,950
.إنّه ملطّخ بالطّلاء الأحمر

295
00:18:17,950 --> 00:18:19,160
!ماذا؟

296
00:18:19,140 --> 00:18:20,740
.سُحقًا، إمّا هذا أو لا شيء

297
00:18:22,330 --> 00:18:26,620
!أيّها المقدّس، أيّها الخالد، بركات للمولى الصّامت

298
00:18:27,030 --> 00:18:29,840
!افتحي، افتحي... افتحي يا بوّابة الجحيم

299
00:18:30,370 --> 00:18:32,250
!استدعاء كثولو

300
00:18:45,770 --> 00:18:47,010
أخطبوط؟

301
00:18:47,010 --> 00:18:48,880
!كثولو

302
00:18:48,880 --> 00:18:50,210
.أجل، لقد نجحت

303
00:18:50,210 --> 00:18:50,970
!انطلق

304
00:19:04,120 --> 00:19:05,200
هل أنتِ بخير؟

305
00:19:05,460 --> 00:19:06,680
.أنا بخير

306
00:19:06,680 --> 00:19:08,850
...ظننتُ أنّه سيلعقني ثانية

307
00:19:10,090 --> 00:19:12,710
هاروهيكو-كُن، من هذا الأخطبوط؟

308
00:19:12,990 --> 00:19:14,200
،إنّه كثولو العظيم

309
00:19:14,210 --> 00:19:19,670
الّذي نزل إلى الأرض من زمن بعيد
.في كتاب تعاويذ نيكرونوميكون

310
00:19:19,680 --> 00:19:21,720
!كثولو

311
00:19:21,720 --> 00:19:23,970
كيف نجحتَ في استدعائه؟

312
00:19:24,180 --> 00:19:26,350
.يسمّى هذا اصبع أبرامِلين

313
00:19:26,350 --> 00:19:28,400
.بإمكاني استدعاء مخلوقات دون صور

314
00:19:28,840 --> 00:19:30,410
سابقًا، كنتُ أفقد دفتر رسوماتي

315
00:19:30,410 --> 00:19:33,690
،كثيرًا عندما أحتاج القيام بالاستدعاء
.لذلك كنتُ أتمرّن

316
00:19:35,190 --> 00:19:37,070
.أوني-سان، إنّه قادم

317
00:19:38,910 --> 00:19:39,570
!كثولو

318
00:19:57,010 --> 00:19:58,670
.مذهل

319
00:20:04,550 --> 00:20:05,640
!مرحى

320
00:20:05,640 --> 00:20:07,180
رينا-تشان، أيمكنك التهامه؟

321
00:20:07,180 --> 00:20:10,510
.لا أريد، إنّه لا يفتح الشّهيّة

322
00:20:10,510 --> 00:20:11,640
.يبدو مقرفًا بالفعل

323
00:20:11,930 --> 00:20:13,670
.سأضطرّ لحرقه إذًا

324
00:20:14,700 --> 00:20:16,150
.تمهّلي لحظة

325
00:20:16,150 --> 00:20:18,150
.القرد يبكي

326
00:20:18,410 --> 00:20:19,570
.معك حقّ

327
00:20:19,570 --> 00:20:21,410
.أتساءل عن السّبب

328
00:20:31,250 --> 00:20:33,160
!هربت زوجته؟

329
00:20:33,160 --> 00:20:34,300
.نعم

330
00:20:34,300 --> 00:20:38,120
لذلك كان يحاول أن يهدّئ من روعه
.في الينبوع الحارّ

331
00:20:38,120 --> 00:20:41,050
التّواجد في ينبوع حارّ أمر مريح، صحيح؟

332
00:20:41,050 --> 00:20:45,990
تقصدين أنّه يبكي لأنّه يعتقد أنّ
هاروهيكو قد أخذني منه؟

333
00:20:45,990 --> 00:20:47,040
.ربّما

334
00:20:47,040 --> 00:20:49,380
صحيح أنّي لا أهتم، لكن ما العمل؟

335
00:20:49,830 --> 00:20:54,670
أراهن أنّنا سنتمكّن من التّخلّص من الينبوع
.الحارّ إذا ما داوينا قلب القرد المفطور

336
00:20:55,940 --> 00:21:00,400
أتعنين أنّ على أحد أن يتزوّج القرد؟

337
00:21:02,400 --> 00:21:04,620
.سمعتُ ما يحدث

338
00:21:04,620 --> 00:21:06,160
!سأهتم بالأمر

339
00:21:08,090 --> 00:21:10,080
هذا من نادي التّمثيل أيضًا؟

340
00:21:10,080 --> 00:21:11,980
.تبدو رائعًا

341
00:21:23,010 --> 00:21:24,220
.يبدو أنّ هذا قد أعجبه

342
00:21:28,490 --> 00:21:31,820
.مساعدتك لي هكذا أمر رائع للغاية

343
00:21:32,270 --> 00:21:34,190
.لن أنسى لك هذا

344
00:21:34,190 --> 00:21:35,480
.وداعًا

345
00:21:35,480 --> 00:21:37,300
.الوداع

346
00:21:37,300 --> 00:21:40,480
.وداعًا

347
00:21:41,170 --> 00:21:44,330
!مهلاً، ماذا؟ ماذا؟

348
00:21:45,780 --> 00:21:47,990
!مهلاً، ساعدوني

349
00:21:52,410 --> 00:21:54,550
!هذا لا يبشّر بخير

350
00:21:55,130 --> 00:21:57,300
!أيّ أحد

351
00:21:57,290 --> 00:22:01,920
!فليساعدني أيّ أحد