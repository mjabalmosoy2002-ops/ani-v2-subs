00:11:52,600 --> 00:11:56,360
...أنا متعبة ولديّ مشاكل ماليّة كبيرة

205
00:11:56,940 --> 00:12:00,240
ألا تستطيعين الاهتمام به يا سينسي؟

206
00:12:00,570 --> 00:12:04,780
.أنا أمضي وقتي في ألاياشيكي ليلًا في العادة

207
00:12:06,530 --> 00:12:11,960
،على هاروهيكو-أونيسان العودة لسابق عهده قريبًا
.وإلاّ ستنهار ماي أوني-سان من التّعب

208
00:12:13,580 --> 00:12:17,960
أتساءل إن كان بإمكاننا إعادته لطبيعته
.إذا حفّزناه بشيء كان يحبّ فعله

209
00:12:23,590 --> 00:12:24,880
!أمعن النّظر جيّدًا

210
00:12:24,880 --> 00:12:26,260
!توقّفي

211
00:12:26,640 --> 00:12:28,100
...لم ينفع ذلك

212
00:12:28,100 --> 00:12:29,470
...ماي أوني-ساما

213
00:12:29,890 --> 00:12:34,730
!سنعمل بجدّ لمعرفة السّبب من أجلكِ أيضًا

214
00:12:35,940 --> 00:12:36,690
...رينا

215
00:12:37,520 --> 00:12:38,610
.شكرًا

216
00:12:38,610 --> 00:12:39,980
.أنا مدينة لكُنّ

217
00:12:46,070 --> 00:12:47,780
!أكثر يا أمّي

218
00:12:47,780 --> 00:12:48,780
.حسنًا، حسنًا

219
00:12:53,120 --> 00:12:55,210
!هذا رائع

220
00:12:59,500 --> 00:13:00,210
،والآن

221
00:13:00,550 --> 00:13:02,670
.علينا أن نخلد للنّوم

222
00:13:02,670 --> 00:13:04,720
.لديّ عمل في الغد

223
00:13:05,430 --> 00:13:07,140
.سأعمل أيضًا

224
00:13:11,600 --> 00:13:12,890
ماذا تقول؟

225
00:13:13,100 --> 00:13:16,230
من قد يُعيّن تلميذًا في الابتدائيّة؟

226
00:13:17,100 --> 00:13:20,270
.هيا، تعال معي، لننظّف أسناننا

227
00:13:23,360 --> 00:13:25,150
أتنظّف أسنانك بطريقة صحيحة؟

228
00:13:25,150 --> 00:13:26,740
.نعم

229
00:13:29,070 --> 00:13:30,200
.المعجون على وجهك

230
00:13:36,120 --> 00:13:37,420
.حسنًا

231
00:13:37,870 --> 00:13:39,630
.سوف أطفئ الأنوار

232
00:13:40,130 --> 00:13:40,880
.حسنًا

233
00:13:42,090 --> 00:13:44,010
.ما الخطب؟ تبدو مطيعًا للغاية اليوم

234
00:13:53,350 --> 00:13:54,430
.تصبح على خير

235
00:13:55,520 --> 00:13:57,100
.تصبحين على خير

236
00:14:05,320 --> 00:14:08,610
هل تخاف من الرّعد؟

237
00:14:08,610 --> 00:14:10,820
...إ-إنّه ليس مخيفًا لذلك الحدّ

238
00:14:16,700 --> 00:14:19,120
.يمكنك أن تصرخ إن كنتَ خائفًا

239
00:14:19,120 --> 00:14:22,750
!...هكذا... أو هكذا

240
00:14:26,670 --> 00:14:31,890
لقد تحمّلتَ كلّ شيء بمفردك
دائمًا، أليس كذلك؟

241
00:14:34,060 --> 00:14:35,350
كيف عرفتِ ذلك؟

242
00:14:36,060 --> 00:14:37,930
.هذا لأنّي وحيدة أيضًا

243
00:14:37,930 --> 00:14:39,560
.يمكنني معرفة هذه الأمور

244
00:14:39,560 --> 00:14:41,060
أنتِ أيضًا؟

245
00:14:41,060 --> 00:14:41,770
.نعم

246
00:14:42,560 --> 00:14:44,440
.إنّها قصّة طويلة

247
00:14:45,400 --> 00:14:46,690
.مثلي تمامًا

248
00:14:47,440 --> 00:14:50,700
.يسافر أبي حول العالم بسبب عمله

249
00:14:52,320 --> 00:14:56,330
.وأمّي... هجرتنا

250
00:14:59,080 --> 00:15:00,290
.فهمت

251
00:15:00,290 --> 00:15:04,790
أوني-تشان، كيف هي أمّك؟

252
00:15:08,420 --> 00:15:10,970
.كانت لطيفة للغاية ولا تتدخّل في شؤون الآخرين

253
00:15:11,430 --> 00:15:13,220
.كنت معجبة بها

254
00:15:15,220 --> 00:15:19,480
ربّما لهذا السّبب ظننتُ أنّي كنتُ
.كذلك عندما كنتُ صغيرة

255
00:15:27,150 --> 00:15:30,070
.سأنتهي من عملي غدًا عند الظهيرة

256
00:15:30,070 --> 00:15:31,740
!لنذهب للّعب بعد ذلك

257
00:15:32,360 --> 00:15:33,410
...لكن

258
00:15:33,820 --> 00:15:38,660
ألن نقوم بالبحث عن طريقة لإعادتي
إلى سابق عهدي مع البقيّة؟

259
00:15:38,910 --> 00:15:40,620
.لا تقلق

260
00:15:40,620 --> 00:15:43,250
!سأتحدّث معهنّ

261
00:15:43,250 --> 00:15:48,500
!سنلعب كثيرًا لدرجة أنّك ستنام من التّعب في الحديقة

262
00:15:49,210 --> 00:15:51,970
...أوني-تشان، هذا يدغدغ

263
00:15:52,800 --> 00:15:54,390
!خذ هذا وهذا وهذا

264
00:15:57,390 --> 00:15:58,140
ما رأيك؟

265
00:15:58,140 --> 00:15:59,640
أتريد اللّعب معي؟

266
00:16:03,690 --> 00:16:04,560
.نعم

267
00:16:06,520 --> 00:16:08,150
!هذا ما أردتُ سماعه

268
00:16:18,240 --> 00:16:19,450
.لستَ سيّئًا

269
00:16:20,040 --> 00:16:22,370
!هيّا

270
00:16:24,370 --> 00:16:26,080
!أوني-تشان

271
00:16:26,290 --> 00:16:27,500
!نعم

272
00:16:31,880 --> 00:16:32,420
ماذا؟

273
00:16:32,920 --> 00:16:33,800
أوني-تشان؟

274
00:16:35,840 --> 00:16:37,300
.آسفة

275
00:16:37,300 --> 00:16:39,060
.لنستمتع بوقتنا

276
00:16:49,070 --> 00:16:49,900
ما الخطب؟

277
00:16:51,230 --> 00:16:54,900
.أريد البقاء في منزلك دائمًا

278
00:16:58,370 --> 00:16:59,450
...هاروهيكو

279
00:17:11,130 --> 00:17:15,720
!كيف تجرؤ على توسيخ صندوق الرّمال؟

280
00:17:16,840 --> 00:17:18,550
!طيفُ رجلِ رمال

281
00:17:19,390 --> 00:17:21,850
!يا لها من رائحة كريهة

282
00:17:25,020 --> 00:17:26,560
.ابقَ هنا يا هاروهيكو

283
00:17:27,400 --> 00:17:30,360
...بول مقرف، بول مقرف

284
00:17:30,360 --> 00:17:32,650
!بول مقرف، مقرف

285
00:17:34,150 --> 00:17:35,320
.الخشب جزء من الأرض

286
00:17:35,320 --> 00:17:39,280
—من بين العناصر الخمسة، أستدعي قوّة الـ

287
00:17:40,950 --> 00:17:41,700
...قوة الـ

288
00:17:41,700 --> 00:17:42,740
!أوني-تشان

289
00:17:43,040 --> 00:17:46,750
!بول القطط مقرف للغاية

290
00:17:54,420 --> 00:17:55,720
!أوني-تشان

291
00:17:56,920 --> 00:17:57,840
...اهرب

292
00:17:59,300 --> 00:17:59,930
!كلاّ

293
00:18:00,220 --> 00:18:00,970
!بسرعة

294
00:18:02,970 --> 00:18:04,430
!كلاّ

295
00:18:09,310 --> 00:18:10,560
!توقّف

296
00:18:10,560 --> 00:18:13,150
!لا تهاجم أوني-تشان

297
00:18:23,990 --> 00:18:24,950
...كلاّ

298
00:18:25,540 --> 00:18:26,500
.كلاّ

299
00:18:27,040 --> 00:18:28,960
.أريد مساعدة ماي أوني-تشان

300
00:18:29,580 --> 00:18:30,540
...أنا

301
00:18:30,540 --> 00:18:31,710
—أنا

302
00:18:31,710 --> 00:18:34,630
!ليتني لم أكن طفلًا

303
00:18:40,680 --> 00:18:41,970
...هذا مؤلم

304
00:18:43,050 --> 00:18:44,560
.لباسي الدّاخليّ ضيّق للغاية

305
00:18:45,390 --> 00:18:46,390
لماذا أنا شبه عارٍ هكذا؟

306
00:18:47,430 --> 00:18:48,310
...هذا

307
00:18:48,640 --> 00:18:50,100
ماي-سينباي؟

308
00:18:50,600 --> 00:18:51,770
.طيف

309
00:18:51,770 --> 00:18:53,650
...أيّها الوغد

310
00:18:53,900 --> 00:18:55,860
ما الّذي فعلتَه بماي-سينباي؟

311
00:18:56,400 --> 00:19:00,400
.في الجحيم أو الموت، المجد لتكون المولى

312
00:19:00,400 --> 00:19:03,120
!افتحي، افتحي... افتحي يا بوّابة الجحيم

313
00:19:03,450 --> 00:19:08,330
!استدعاء كثولو

314
00:19:14,670 --> 00:19:17,760
!لكنّ ذلك كان مقرفًا للغاية

315
00:19:25,050 --> 00:19:25,970
!ماي-سينباي

316
00:19:29,390 --> 00:19:31,100
...هاروهيكو

317
00:19:33,230 --> 00:19:35,060
لماذا لا ترتدي أيّ شيء؟

318
00:19:35,060 --> 00:19:37,320
!كلاّ، الأمر ليس كما تظنّين

319
00:19:37,320 --> 00:19:40,110
...أنا لم أقصد شيئًا

320
00:19:42,860 --> 00:19:45,070
هل ارتديتَ ملابسك يا هاروهيكو؟

321
00:19:45,070 --> 00:19:46,450
.سوف أدخل

322
00:19:46,450 --> 00:19:47,200
.حسنًا

323
00:19:49,120 --> 00:19:53,750
.آسف، يبدو أنّي تسبّبتُ بالكثير من المشاكل

324
00:19:53,750 --> 00:19:56,960
.أكيد، لقد كنتَ متعِبًا

325
00:19:59,710 --> 00:20:00,460
.خذ

326
00:20:01,170 --> 00:20:05,220
.اشتريتُ هذا لك من المتجر عندما كنتَ طفلًا

327
00:20:05,220 --> 00:20:08,720
مذهل، هذه هي الأشياء الّتي كنتُ أقرأها؟

328
00:20:08,720 --> 00:20:12,440
.رغم أنّك كنتَ غاضبًا نوعًا ما عندما اخترتُها لك

329
00:20:12,440 --> 00:20:14,020
أحقًا؟

330
00:20:14,020 --> 00:20:15,560
.أنا لا أتذكّر أيّ شيء من ذلك بالفعل

331
00:20:18,520 --> 00:20:20,030
هكذا إذًا؟

332
00:20:20,030 --> 00:20:21,610
لا تتذكّر شيئًا إذًا؟

333
00:20:22,530 --> 00:20:27,330
من المستحيل إذًا أن تعرف كيف
.انتهى بك المطاف كطفل

334
00:20:28,080 --> 00:20:29,080
...أيعقل

335
00:20:32,410 --> 00:20:33,210
ماذا؟

336
00:20:33,660 --> 00:20:37,790
...ظننتُ أنّ ذلك حدث لأنّي قرأتُ هذه

337
00:20:37,790 --> 00:20:40,920
!هاروهيكو، نحن جميعًا هنا

338
00:20:41,130 --> 00:20:41,960
.حسنًا

339
00:20:42,470 --> 00:20:44,590
.ماي-سينباي، سأراك هناك

340
00:20:45,340 --> 00:20:46,640
.أكيد

341
00:20:52,100 --> 00:20:54,350
".ما حدث يوم الأحد"

342
00:20:54,350 --> 00:20:57,610
".القسم أ-1، إيتشيجو هاروهيكو"

343
00:20:58,060 --> 00:21:03,360
".لعبتُ اليوم مع أبي وأمّي في الحديقة"

344
00:21:03,820 --> 00:21:10,370
،لعبنا في لعبة الميزان والأرجوحة"
".ولعبتُ أيضًا على المزلقة

345
00:21:15,250 --> 00:21:18,460
".كان ذلك ممتعًا"

346
00:21:21,840 --> 00:21:25,630
لقد اختلق كلّ هذا، صحيح؟

347
00:21:27,090 --> 00:21:31,350
أصبح هاروهيكو طفلًا لأنّه أراد أن يكون
.مقاله حقيقيًّا

348
00:21:31,970 --> 00:21:35,770
تفاعلت قدراته مع عقله، تمامًا كما
.حدث مع كورومي-تشان

349
00:21:36,520 --> 00:21:39,110
!سينباي، الجميع بانتظارك

350
00:21:44,940 --> 00:21:45,610
.قادمة

351
00:21:46,860 --> 00:21:50,160
لماذا عدتَ لطبيعتك يا هاروهيكو أونِي-سان؟

352
00:21:50,160 --> 00:21:51,080
.بالفعل

353
00:21:51,080 --> 00:21:53,080
.لقد كان ظريفًا للغاية وهو طفل

354
00:21:53,080 --> 00:21:53,950
.هذا صحيح

355
00:21:53,950 --> 00:21:55,370
.يا لها من خسارة

356
00:21:55,370 --> 00:21:57,120
!ليس أنتِ أيضًا يا رينا-تشان

357
00:21:57,120 --> 00:21:59,420
ألا يجدر بكنّ أن تكنّ سعيدات لأنّي عدتُ لطبيعتي؟

358
00:21:59,420 --> 00:22:00,750
.كنّا نكذب فحسب

359
00:22:00,750 --> 00:22:01,960
.نكذب فحسب

360
00:22:02,550 --> 00:22:05,260
.يا إلهي، لا تفعلنَ هذا

361
00:22:08,550 --> 00:22:09,550
.هذا صحيح