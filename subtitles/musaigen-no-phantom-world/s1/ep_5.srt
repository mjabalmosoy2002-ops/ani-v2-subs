1
00:00:01,140 --> 00:00:04,190
حادثة الانتشار الفيروسيّ الّذي حدثت منذ عشر سنوات

2
00:00:04,690 --> 00:00:07,690
.غيّرت أدمغة البشر بشكل جذريّ

3
00:00:08,520 --> 00:00:12,400
.أصبح النّاس يرون أطيافًا ووُلِدَ أطفال بقدرات مميّزة

4
00:00:13,240 --> 00:00:15,200
.هنالك أنواع مختلفة من القدرات المميّزة

5
00:00:16,820 --> 00:00:19,450
،تمتلك ميناسي كويْتو-سان، بطلة هذه الحلقة

6
00:00:19,450 --> 00:00:23,410
.قدرة قويّة تحت سيطرتها باستعمال الأغاني

7
00:00:24,330 --> 00:00:27,080
هل الغناء مميّز لتلك الدّرجة؟

8
00:00:27,080 --> 00:00:28,420
.بالطّبع

9
00:00:28,420 --> 00:00:34,550
.يساعد غناء أغنية مفضّلة لأحد ما على تحفيز الدّماغ ليفرز كميّة هائلة من هرمونات المتعة

10
00:00:34,930 --> 00:00:40,100
.إنّه مفيد كثيرًا في إعادة التّأهيل ويساعد على تذكّر الكثير من الكلمات

11
00:00:40,100 --> 00:00:44,180
.كما أنّ الغناء في مجموعات يساعد على القيام بالمهام الصّعبة بشكل متقن أكثر

12
00:00:44,520 --> 00:00:47,310
الغناء صديق للإنسانيّة إذًا؟

13
00:00:47,310 --> 00:00:52,110
.بذكر هذا، أحد أصدقائي مُخرج أنمي

14
00:00:52,440 --> 00:00:57,110
.يقول أنّ غناء الكاراوُكي يساعده على الحفاظ على إيقاعه، ممّا يحسّن من روايته للقصص

15
00:00:57,360 --> 00:01:00,030
تعرفين الكثير من الأشخاص المهمّين، أليس كذلك؟

16
00:01:00,030 --> 00:01:02,950
!رغم أنّي لا أدري إن كان ذلك صحيحًا

17
00:02:53,400 --> 00:02:58,320
.افتح، افتح، افتح، افتح يا لحن بداية الخلق

18
00:02:58,740 --> 00:03:02,950
.أيّها اللّحن، أيها اللّحن، أيّها اللّحن، أيّها اللّحن أرِ النّور

19
00:03:18,210 --> 00:03:20,380
.ميناسي-سان، أحسنتِ

20
00:03:20,760 --> 00:03:25,760
.كان ذلك الطّيف يزعجنا وما كنّا نستطيع استعمال الطّريق السّريع

21
00:03:26,010 --> 00:03:26,970
...شكرًا على

22
00:03:26,970 --> 00:03:28,680
.سأترك البقيّة لكم من هنا

23
00:03:29,390 --> 00:03:30,020
.وداعًا

24
00:03:31,100 --> 00:03:32,190
...حـ-حسنًا

25
00:03:35,980 --> 00:03:38,030
أخبريني، ما الّذي سنفعله بشأن الغداء؟

26
00:03:38,650 --> 00:03:42,400
.أحافظ دائمًا على مسافة بيني وبين الآخرين

27
00:03:42,910 --> 00:03:46,490
.وأنا على هذه الحال مذ أن استيقظت قدراتي قبل أربع سنوات

28
00:03:47,120 --> 00:03:51,790
.لم أنضمّ إلى أيّ نادٍ مدرسيّ، وأمضي وقتي كلّه بالتّعامل مع الأطياف

29
00:03:52,330 --> 00:03:55,170
.هذا لأنّي أدرك أنّي مختلفة

30
00:03:58,300 --> 00:04:00,260
...أنت محظوظ يا هاروهيكو

31
00:04:00,260 --> 00:04:04,380
.كلّ عضوات فريقك جميلات

32
00:04:04,380 --> 00:04:06,600
!أنا جميلة أيضًا

33
00:04:06,600 --> 00:04:09,010
.هذا صحيح، أنتِ جميلة الجميلات

34
00:04:09,010 --> 00:04:10,270
!أجل

35
00:04:10,270 --> 00:04:11,930
.انضمّي إلينا يا رورو-تشان

36
00:04:11,930 --> 00:04:13,440
.سأعطيك بعض الحلويّات

37
00:04:13,440 --> 00:04:14,980
!مرحى

38
00:04:14,980 --> 00:04:17,810
.تقول هذا فقط لأنّك لا تعرف كيف هو الحال في الفريق

39
00:04:17,810 --> 00:04:20,530
.تميل ماي-سينباي للعنف دائمًا

40
00:04:20,530 --> 00:04:22,780
ومن يهتم لذلك إن كانت جذّابة؟

41
00:04:22,780 --> 00:04:28,120
.ومع ذلك، لا أدري بشأن الفتيات من أمثال ميناسي كويْتو، بغض النّظر عن جاذبيّتها

42
00:04:28,120 --> 00:04:30,200
ماذا تعرف عن ميناسي-سان؟

43
00:04:30,740 --> 00:04:33,750
.يبدو أنّها كانت ذات شعبيّة كبيرة في الفصل في بادئ الأمر

44
00:04:33,750 --> 00:04:36,420
.لكنّها انعزاليّة ولا توافق على مخالطة الآخرين

45
00:04:36,420 --> 00:04:39,040
.لم يعد أحد يتحدّث إليها بعد الآن

46
00:04:39,460 --> 00:04:43,300
...ورغم جمالها الخارجيّ، فشخصيتها تلك

47
00:04:43,300 --> 00:04:46,470
.ربّما هي متعالية هكذا لأنّها من نخبة مستعملي القدرات المميّزة

48
00:04:46,470 --> 00:04:48,680
!مرحبًا يا كويْتو-تشان

49
00:04:48,680 --> 00:04:51,390
...مـ-مـ-ميناسي-سان، مرحبًا

50
00:04:51,390 --> 00:04:54,140
.صحيح، أقدّم لكِ موراهاشي شوسكي

51
00:04:54,140 --> 00:04:56,810
...لديه قدرات مميّزة، وهو في نادينا

52
00:04:56,810 --> 00:04:58,230
!مر-مرحبًا

53
00:05:01,360 --> 00:05:02,440
.أحسنت

54
00:05:02,440 --> 00:05:03,360
.كان ذلك مخيفًا

55
00:05:09,870 --> 00:05:11,290
منازل طيور؟

56
00:05:11,910 --> 00:05:13,370
.نعم، هذا صحيح

57
00:05:13,750 --> 00:05:19,790
.هنالك طيف ينتقل من مدرسة إلى أخرى مهاجمًا منازل الطّيور وأقفاص الأرانب

58
00:05:19,790 --> 00:05:21,710
.قد نكون هدفه التّالي

59
00:05:22,880 --> 00:05:28,840
.ربّما تكون مهمّة سهلة عليكِ، لكنّي ظننتُ أنّكِ قد تكونين مهتمّة بها

60
00:05:29,340 --> 00:05:30,640
.اسمحي لي بالقيام بها

61
00:05:35,600 --> 00:05:37,100
.أنت مُثير للشفقة

62
00:05:37,100 --> 00:05:38,270
.تمالك نفسك

63
00:05:38,730 --> 00:05:39,690
ماذا؟

64
00:05:40,110 --> 00:05:41,980
إنّها ميناسي-سان، صحيح؟

65
00:05:41,980 --> 00:05:43,570
إلى أين هي ذاهبة؟

66
00:05:44,070 --> 00:05:45,940
.آسف، عليّ الذّهاب

67
00:05:48,240 --> 00:05:49,610
ما الذي ستفعله؟

68
00:05:49,610 --> 00:05:51,030
أليس هذا واضحًا؟

69
00:05:51,030 --> 00:05:53,040
.سأعتذر عمّا حدث قبل قليل

70
00:06:00,830 --> 00:06:02,590
أهو لذيذ؟

71
00:06:03,590 --> 00:06:04,250
.أنتِ

72
00:06:05,130 --> 00:06:06,510
نـ-نعم؟

73
00:06:07,170 --> 00:06:09,470
هل أنتِ المسؤولة عن الأقفاص؟ بمفردك؟

74
00:06:19,020 --> 00:06:20,770
...أ... أنا

75
00:06:20,770 --> 00:06:22,480
.يبدو أنّي أتيتُ إلى هنا في الوقت المناسب

76
00:06:42,790 --> 00:06:43,670
!ميناسي-سان

77
00:06:43,960 --> 00:06:44,670
هل أنتِ بخير؟

78
00:06:44,670 --> 00:06:45,340
.إنّه طيف

79
00:06:45,550 --> 00:06:46,670
...لماذا أنت

80
00:06:48,800 --> 00:06:50,050
!احذر! اهرب

81
00:07:03,560 --> 00:07:05,690
!ألبريشت، ساعدهم

82
00:07:22,420 --> 00:07:23,420
!سينباي

83
00:07:23,420 --> 00:07:25,590
هاروهيكو-كُن، هل أنت بخير؟

84
00:07:25,590 --> 00:07:26,750
.أنا بخير

85
00:07:38,100 --> 00:07:39,640
ميناسي-سان، أأنتِ بخير؟

86
00:07:39,640 --> 00:07:40,730
...نعم، أنا بخير

87
00:07:43,940 --> 00:07:48,020
.أظنّ أنّكِ لن تستطيعي قتال الأطياف ما دمتِ لا تستطيعين استعمال قدراتك

88
00:07:48,020 --> 00:07:51,450
.ولكن من الجيّد أنّكِ لم تتعرّضي لإصابات بليغة

89
00:07:52,070 --> 00:07:54,570
.شكرًا لمساعدتكِ لنا قبل قليل

90
00:07:54,570 --> 00:07:56,830
لديكِ قدرة مميّزة أيضًا، صحيح؟

91
00:07:56,830 --> 00:07:57,830
...نعم

92
00:07:57,830 --> 00:07:59,620
ما هو اسمك؟

93
00:07:59,620 --> 00:08:03,830
.أ-أنا كوماماكورا كورومي، من الفصل 4-ب

94
00:08:03,830 --> 00:08:06,290
.وهذا هو ألبريشت

95
00:08:06,290 --> 00:08:07,840
.ألبريشت

96
00:08:07,840 --> 00:08:10,960
إنّه مرزبانُ براندينبيرغ من القرن الثّاني عشر، صحيح؟

97
00:08:10,960 --> 00:08:12,260
..."لُقّب بـ"الدّبّ

98
00:08:12,670 --> 00:08:16,430
.مذهل، لم أقابل أحدًا يعرف ذلك من قبل

99
00:08:17,390 --> 00:08:19,180
!لا تعترضوا طريقي

100
00:08:19,470 --> 00:08:21,680
.سأهزم هذا الطّيف بمفردي

101
00:08:22,350 --> 00:08:23,940
.لن أقبل مساعدتكم

102
00:08:25,850 --> 00:08:29,440
.تقولين هذا مع أنّكِ لا تستطيعين حتّى استعمال قدراتك الآن

103
00:08:29,440 --> 00:08:30,940
.سنهتمّ نحن بالبقيّة بدءًا من هنا

104
00:08:31,230 --> 00:08:33,780
.عليكِ أن ترتاحي حتّى تستعيدي قدرتك

105
00:08:33,780 --> 00:08:35,700
.سيعود صوتي قريبًا

106
00:08:35,700 --> 00:08:37,030
.لذلك تراجعي

107
00:08:38,120 --> 00:08:42,200
!في البداية، لماذا تتصرّفين بفظاظة مع زميلة أكبر منكِ؟

108
00:08:42,200 --> 00:08:44,460
!سأهتمّ بذلك الطّيف بنفسي

109
00:08:44,460 --> 00:08:46,040
.هذا ليس قراركِ

110
00:08:46,040 --> 00:08:47,920
.لقد كُلّفتُ بالمهمّة

111
00:08:49,040 --> 00:08:50,880
...ماي أوني-ساما، اهدئي

112
00:08:50,880 --> 00:08:52,880
.سمعتُ ما يحدث

113
00:08:53,130 --> 00:08:54,340
!سينسي

114
00:08:54,340 --> 00:08:58,260
.لنقم بسباق لنعرف من بإمكانه هزيمة الطّيف أوّلاً

115
00:08:58,510 --> 00:09:02,390
.وسيأخذ الفائز المكافأة

116
00:09:02,390 --> 00:09:03,930
!أعجبني هذا

117
00:09:04,270 --> 00:09:07,940
.لقد بدأ فريقك يتحسّن في الآونة الأخيرة يا كاواكومي-سان

118
00:09:07,940 --> 00:09:09,810
.أظنّ أنّ باستطاعتي ترك الأمر لكم

119
00:09:09,810 --> 00:09:13,280
.ميناسي-سان، عليكِ أن تتحسّني أوّلاً

120
00:09:13,780 --> 00:09:14,950
.الصّحّة في المقام الأوّل

121
00:09:15,320 --> 00:09:16,700
مفهوم؟

122
00:09:17,780 --> 00:09:18,740
!ميناسي-سان

123
00:09:18,740 --> 00:09:21,120
مهلاً يا هاروهيكو، إلى أين أنت ذاهب؟

124
00:09:21,830 --> 00:09:24,000
...آسف، أنا

125
00:09:25,410 --> 00:09:27,120
!سوف أساعد ميناسي-سان

126
00:09:28,830 --> 00:09:30,590
ما الّذي يحدث؟

127
00:09:30,590 --> 00:09:34,630
.أظنّ أنّ هاروهيكو-كُن يشعر أنّه المسؤول

128
00:09:34,630 --> 00:09:38,510
...بسبب ما حدث لحلق ميناسي-سان

129
00:09:38,510 --> 00:09:41,180
.أظنّ أنّ هذا سيعدّل الكفّة بشكل جيّد

130
00:09:41,180 --> 00:09:44,390
.قد تكون لهم الأفضليّة بمجرّد أن تستعيد ميناسي-سان عافيتها

131
00:09:47,560 --> 00:09:48,480
...أخبريني

132
00:09:48,480 --> 00:09:49,600
نـ-نعم؟

133
00:09:49,980 --> 00:09:52,150
اسمك كورومي-تشان، صحيح؟

134
00:09:52,150 --> 00:09:53,070
.نـ-نعم

135
00:09:53,360 --> 00:09:56,440
أتريدين مساعدتنا؟

136
00:09:56,700 --> 00:09:59,450
أترغبين بالانضمام لنا كعضوة احتياطيّة؟

137
00:09:59,450 --> 00:10:01,740
ماذا؟ ماذا؟

138
00:10:06,080 --> 00:10:07,330
.لا تتبعني

139
00:10:07,580 --> 00:10:09,290
.لا أستطيع ترككِ بمفردك

140
00:10:09,290 --> 00:10:12,000
...خسرتِ قدرتك بسببي أنا

141
00:10:12,000 --> 00:10:13,380
.لن يدوم الأمر طويلاً

142
00:10:17,010 --> 00:10:19,720
هل تسعلين في كلّ مرّة تحاولين استعمالها؟

143
00:10:19,720 --> 00:10:22,050
.ربّما عليك أن ترتاحي بالفعل

144
00:10:22,390 --> 00:10:25,430
.سأهتمّ بذلك الطّيف بمفردي، مهما كلّف الأمر

145
00:10:25,720 --> 00:10:28,060
هل هنالك شيء ما بخصوص ذلك الطّيف؟

146
00:10:30,600 --> 00:10:32,060
!ميناسي-سان

147
00:10:33,150 --> 00:10:34,980
ألن تحظي بفرصة أفضل للإمساك

148
00:10:34,980 --> 00:10:37,780
بذلك الطّيف إن انتظرتِه في المدرسة فحسب؟

149
00:10:37,780 --> 00:10:41,320
.أشكّ أنّه سيعود لمكان ما للمرّة الثّانية، بعد أن واجهناه

150
00:10:41,570 --> 00:10:44,240
.لكنّنا لا نعرف أين سيظهر

151
00:10:44,700 --> 00:10:47,540
.أستطيع الإحساس بتواجد الأطياف

152
00:10:47,540 --> 00:10:50,210
!رائع! أنتِ كالرّادار

153
00:10:50,210 --> 00:10:52,670
.لكنكِ لا تملكين طريقة لقتاله

154
00:10:52,960 --> 00:10:56,210
.أستطيع استدعاء ماركوسياس ويمكنني الإمساك بالأطياف

155
00:10:56,210 --> 00:10:57,710
.أظنّ أنّ بإمكاني المساعدة

156
00:11:00,510 --> 00:11:03,090
.نحن نمشي لثلاث ساعات

157
00:11:03,090 --> 00:11:06,060
.إنّ قدرتك على التّحمّل متدنّية يا هاروهيكو

158
00:11:06,060 --> 00:11:08,730
هلّا عدتَ للمنزل الآن؟

159
00:11:08,730 --> 00:11:11,020
...لا أستطيع الذّهاب

160
00:11:11,020 --> 00:11:12,810
إلى أين ستذهبين الآن؟

161
00:11:12,810 --> 00:11:13,980
.اكتفيتُ لهذا اليوم

162
00:11:14,610 --> 00:11:16,690
.هذه هي شقّتي

163
00:11:16,690 --> 00:11:17,980
.والآن، اذهب

164
00:11:20,900 --> 00:11:22,700
ما الّذي ستفعله غدًا؟

165
00:11:25,410 --> 00:11:34,990
TM&COC: shx

166
00:11:25,410 --> 00:11:34,990
Enco&TLOP+ED: ناروتو الزعيم

167
00:11:25,410 --> 00:11:34,990
Kara "OP": Yaru

168
00:11:53,020 --> 00:11:54,440
لم يعد صوتي لطبيعته بعد؟

169
00:11:57,230 --> 00:11:57,980
.صباح الخير

170
00:11:58,610 --> 00:12:00,110
كيف حال حلقك؟

171
00:12:00,110 --> 00:12:01,360
أكنتَ هنا طوال اللّيل؟

172
00:12:01,570 --> 00:12:02,860
.بالطّبع لا

173
00:12:02,860 --> 00:12:05,370
.ذهبت للمنزل، وعدت إلى هنا للتّوّ

174
00:12:06,700 --> 00:12:09,040
...هذه هي غرفة كويْتو-تشان إذًا

175
00:12:09,040 --> 00:12:11,330
.أنتِ، لا تقتحمي المكان هكذا

176
00:12:12,660 --> 00:12:14,170
أتعيشين بمفردك؟

177
00:12:17,340 --> 00:12:21,460
.آسفة لأنّنا جعلناكِ تأتين معنا في هذا الوقت الباكر

178
00:12:21,670 --> 00:12:25,470
.لا بأس، أنا قلقة على الأرانب أيضًا

179
00:12:25,470 --> 00:12:30,850
.كما أنّي لطالما اعتقدتُ أنّكم رائعون

180
00:12:30,850 --> 00:12:33,310
أتعرفين بأمرنا؟

181
00:12:33,310 --> 00:12:34,770
.نـ-نعم

182
00:12:34,770 --> 00:12:38,360
لكن عليك أن تهربي بمجرّد أن تصبح الأمور خطيرة، موافقة؟

183
00:12:38,360 --> 00:12:41,230
...حـ-حسنًا! أنا متوتّرة

184
00:12:43,070 --> 00:12:46,030
!أهلاً، الجميع هنا

185
00:12:46,320 --> 00:12:48,870
هل تقومون بدوريّات أنتم أيضًا؟

186
00:12:49,530 --> 00:12:51,660
.أظنّ أنّه خطرت لنا نفس الفكرة

187
00:12:52,080 --> 00:12:54,540
...إحضار فتاة لا علاقة لها بالأمر

188
00:12:54,540 --> 00:12:56,120
.لم يحز هذا على إعجابي

189
00:12:56,120 --> 00:12:57,790
.دعيني وشأني

190
00:12:57,790 --> 00:12:59,500
.كان ذلك قرارها

191
00:13:00,460 --> 00:13:03,760
...اسمعن! ربّما علينا أن نتعاون

192
00:13:03,760 --> 00:13:05,590
.أنا لا أتحدّث إليك بعد الآن

193
00:13:05,590 --> 00:13:06,340
!كلاّ

194
00:13:06,340 --> 00:13:09,220
رورو، لماذا لا تنضمّين إلينا ثانية؟

195
00:13:12,060 --> 00:13:14,600
.يبدو هذا الجانب ممتعًا أكثر، لذلك أرفض عرضك

196
00:13:15,440 --> 00:13:16,480
!ميناسي-سان

197
00:13:16,980 --> 00:13:17,850
.وداعًا

198
00:13:17,850 --> 00:13:20,320
.حسنًا، اهتمّوا بأنفسكم

199
00:13:20,320 --> 00:13:22,820
.لم يتوجّب عليكِ أن تقولي ذلك بتلك الطّريقة

200
00:13:23,360 --> 00:13:24,610
.أعلم

201
00:13:24,610 --> 00:13:26,650
.لكنّي لا أزال غاضبة

202
00:13:26,650 --> 00:13:28,200
أولستِ غاضبة؟

203
00:13:28,200 --> 00:13:29,820
.انظري إليه

204
00:13:30,160 --> 00:13:33,120
أنتِ غاضبة يا ماي أوني-ساما؟

205
00:13:34,750 --> 00:13:37,960
الأمر غريب بالكامل، أليس كذلك يا ألبريشت؟

206
00:13:38,750 --> 00:13:42,050
.هل أنت واثق؟ ستخسر صديقتاك إن ظللتَ بقربي

207
00:13:42,670 --> 00:13:45,170
.سأعتذر لاحقًا، سوف تُسامحاني

208
00:13:45,470 --> 00:13:47,300
.كما أنّكِ صديقة أيضًا يا كويْتو-سان

209
00:13:47,840 --> 00:13:48,760
كويْتو-سان"؟"

210
00:13:48,760 --> 00:13:52,970
.أعني، ظننتُ أنّ علينا أن نتحدّث بودّيّة أكثر

211
00:13:53,640 --> 00:13:54,930
آسف، أأزعجكِ هذا؟

212
00:13:56,810 --> 00:13:57,810
ما الخطب؟

213
00:13:57,810 --> 00:13:58,810
.إنّه هنا

214
00:13:58,810 --> 00:13:59,850
!لا ريب في ذلك

215
00:14:16,910 --> 00:14:17,830
!لم ينجح الأمر

216
00:14:25,800 --> 00:14:26,880
!ياكين وبوز

217
00:14:28,550 --> 00:14:32,050
.تحذير في السّابق وتحذير الآن وتحذير لما بعد ذلك

218
00:14:32,050 --> 00:14:34,760
.افتحي، افتحي... افتحي يا بوّابة الجحيم

219
00:14:34,760 --> 00:14:37,020
!استدعاء ماركوسياس

220
00:14:39,190 --> 00:14:40,850
!انطلق يا ماركوسياس

221
00:14:48,820 --> 00:14:49,700
...كويْتو-سان

222
00:14:50,200 --> 00:14:52,240
.توقّف عن مناداتي بذلك

223
00:14:52,240 --> 00:14:53,030
إلى أين أنتِ ذاهبة؟

224
00:14:53,320 --> 00:14:54,450
إلى أين في رأيك؟

225
00:14:54,990 --> 00:14:57,000
.سأبحث عن ذلك الطيف

226
00:14:57,000 --> 00:14:58,080
ماذا؟

227
00:14:58,080 --> 00:15:00,580
أليس عليك أن ترتاحي قليلاً أوّلاً؟

228
00:15:00,580 --> 00:15:04,540
.سوف تسبقني صديقاتك إن أبطأتُ من تقدّمي

229
00:15:05,380 --> 00:15:07,010
...لماذا هي

230
00:15:07,840 --> 00:15:09,760
ألن تتبعها؟

231
00:15:10,220 --> 00:15:11,260
...كويْتو

232
00:15:11,260 --> 00:15:12,220
!ميناسي-سان

233
00:15:17,220 --> 00:15:18,220
.لقد أضعتُها

234
00:15:19,230 --> 00:15:21,190
تسأل عن ميناسي-سان؟

235
00:15:21,520 --> 00:15:23,940
...لا أظنّ أنّها قد أتت اليوم

236
00:15:26,570 --> 00:15:30,190
لماذا ميناسي-سان مهووسة بهذا الطّيف؟

237
00:15:30,740 --> 00:15:36,200
سبق وأخبرتك أنّها تملك قدرة مميّزة قويّة منذ طفولتها، صحيح؟

238
00:15:36,200 --> 00:15:37,200
.نعم

239
00:15:37,200 --> 00:15:42,920
.حسنًا، لقد حفزّ طيف، كان يهاجم حيوانات المدرسة، ظهور تلك القدرة

240
00:15:43,920 --> 00:15:47,550
،كانت ميناسي-سان تلميذة في مدرسة عاديّة حينها

241
00:15:47,550 --> 00:15:50,340
.حيث لم يكن هنالك نادٍ لصيد الأطياف

242
00:15:52,340 --> 00:15:56,890
...وفي أحد الأيّام، هاجم طيف قفص أرانب في المدرسة

243
00:15:58,100 --> 00:16:02,390
.وكانت ميناسي-سان مسؤولة عن الأرانب حينها

244
00:16:02,390 --> 00:16:06,770
.استيقظت قدرتها المميّزة وختمت الطّيف

245
00:16:11,950 --> 00:16:17,580
.لكنّ قدرتها كانت قويّة جدًّا وقد أخافت الأساتذة وزملاءها

246
00:16:17,580 --> 00:16:19,910
...حتّى والداها كانا مذعورين

247
00:16:21,160 --> 00:16:23,620
،في نهاية المطاف، لم تتمكّن من البقاء في المنزل

248
00:16:23,620 --> 00:16:26,290
.فأخذتها وكالة السّيطرة على الأطياف

249
00:16:28,460 --> 00:16:33,010
.وقد انغلقت على نفسها منذ ذلك الحين

250
00:16:33,380 --> 00:16:37,140
الطّيف الّذي أيقظ قدراتها... أيعقل أن يكون...؟

251
00:16:37,640 --> 00:16:42,020
.قد يكون نفس الطّيف الّذي تطاردونه الآن

252
00:16:43,350 --> 00:16:49,570
.يصبح طيف قد تمّ ختمه سابقًا ناشطًا أحيانًا بعد مرور الوقت

253
00:16:50,570 --> 00:16:54,110
أنا واثقة أنّ ميناسي-سان تكره الأطياف

254
00:16:54,110 --> 00:16:57,530
.لأنّها أبعدتها عن أصدقائها وعائلتها

255
00:16:57,530 --> 00:16:59,410
.بالنّسبة لها، الأطياف أعداء

256
00:17:01,830 --> 00:17:02,660
.وجدتُها

257
00:17:02,660 --> 00:17:09,670
على أيّ حال، آمل أن تتغيّر الأوضاع للأفضل بالنّسبة لها

258
00:17:09,670 --> 00:17:11,340
.عن طريق التّواجد معكم يا رفاق

259
00:17:16,630 --> 00:17:18,220
رورو، هل وجدتِها؟

260
00:17:18,220 --> 00:17:19,430
.نعم

261
00:17:19,430 --> 00:17:21,310
.إنّها متّجهة إلى حديقة الحيوانات

262
00:17:21,310 --> 00:17:23,060
.حسنًا، سأكون هناك في الحال

263
00:17:23,640 --> 00:17:24,310
...سينسي

264
00:17:24,520 --> 00:17:26,190
.اذهب لمساعدتها

265
00:17:27,310 --> 00:17:28,190
!حسنًا

266
00:17:40,830 --> 00:17:44,700
.تبدو منزعجًا لأنّه قد فاتتك ثلاث وجبات بسببي

267
00:17:45,080 --> 00:17:49,460
.لا بدّ أنّكِ تكرهني أيضًا لأنّي ختمتك

268
00:17:49,830 --> 00:17:52,000
.لنُنهي هذا الأمر

269
00:17:53,550 --> 00:17:57,550
.افتح، افتح، افتح، افتح يا لحن بداية الخلق

270
00:17:57,550 --> 00:18:00,850
.أيّها اللّحن، أيها اللّحن، أيّها اللّحن، أيّها اللّحن أرِ النّور

271
00:18:06,270 --> 00:18:07,310
.بدأت قدراتي تعود إليّ

272
00:18:07,690 --> 00:18:08,600
!يمكنني أن أنجح

273
00:18:15,940 --> 00:18:16,570
!...عنقه قد

274
00:18:37,630 --> 00:18:39,220
!أحسنتَ يا ماركوسياس

275
00:18:43,180 --> 00:18:44,350
!كويْتو-تشان

276
00:18:45,640 --> 00:18:46,560
.تماسكي

277
00:18:47,600 --> 00:18:48,480
!هاروهيكو

278
00:18:48,480 --> 00:18:49,350
!ميناسي-سان

279
00:18:49,350 --> 00:18:52,270
.ألبريشت، ساعد أوني-سان

280
00:18:53,360 --> 00:18:57,740
.من بين العناصر الخمسة، لقوّة الماء القدرة على القضاء على النّار

281
00:18:58,320 --> 00:19:00,860
.أستدعي مرحلة طور الماء من كليتَيّ إلى قبضتَيّ

282
00:19:01,610 --> 00:19:03,280
!إنّه قويّ

283
00:19:11,750 --> 00:19:15,840
!أيّها الطّيف الضّارب، اكشف أسرارك لكتابِ تحوت

284
00:19:22,590 --> 00:19:24,010
!سقط واحد

285
00:19:28,220 --> 00:19:29,230
...كويْتو-سان

286
00:19:29,230 --> 00:19:30,180
ما العمل؟

287
00:19:30,730 --> 00:19:32,190
.لنتّصل بسيّارة إسعاف

288
00:19:32,190 --> 00:19:36,440
إيزومي-سان، أليست لديك قدرات شافية؟

289
00:19:36,440 --> 00:19:37,860
.جرّبيها

290
00:19:37,860 --> 00:19:39,070
.هذا صحيح

291
00:19:39,070 --> 00:19:40,190
.سأجرّبها

292
00:19:45,740 --> 00:19:46,530
كويْتو-سان؟

293
00:19:46,950 --> 00:19:47,910
الطّيف؟

294
00:19:48,120 --> 00:19:49,290
.آسف

295
00:19:50,450 --> 00:19:51,370
...تمهّلي

296
00:19:51,370 --> 00:19:53,420
.لا يحقّ لكِ أن تغضبي

297
00:19:53,420 --> 00:19:56,130
.قام هاروهيكو بذلك من أجلك

298
00:20:04,470 --> 00:20:09,390
.لا يبدو هذا الطّيف كالّذي هزمته ميناسي-سان

299
00:20:11,020 --> 00:20:13,140
.لقد تحقّقتُ من السّجلاّت

300
00:20:13,140 --> 00:20:18,440
.يبدو هذا الطّيف مختلفًا قليلاً عن الّذي هزمته ميناسي-سان

301
00:20:19,320 --> 00:20:23,280
.إنّه من نفس النّوع، لكنّه ليس الّذي هاجم منذ أربع سنوات

302
00:20:24,280 --> 00:20:29,370
.يبدو أنّي أقحمتكم في فوضى عن طريق الخطأ

303
00:20:36,000 --> 00:20:38,170
.إنّها صعبة المراس

304
00:20:38,170 --> 00:20:39,800
.لا بأس

305
00:20:39,800 --> 00:20:41,840
.أحسنتِ يا كورومي-تشان

306
00:20:41,840 --> 00:20:43,800
!شكرًا على المساعدة

307
00:20:43,800 --> 00:20:45,430
.نـ-نعم، كلاّ، أقصد شكرًا

308
00:20:45,760 --> 00:20:48,550
.أتمنّى أن تساعدينا أحيانًا

309
00:20:50,850 --> 00:20:52,230
...حسنًا

310
00:21:04,450 --> 00:21:05,740
!هاروهيكو

311
00:21:06,030 --> 00:21:08,740
!أتت رورو-تشان لتوقظك من النّوم

312
00:21:08,740 --> 00:21:10,530
!استيقظ

313
00:21:12,500 --> 00:21:15,460
إلى أين تذهبين في اللّيل؟

314
00:21:15,460 --> 00:21:16,790
.لا أدري

315
00:21:16,790 --> 00:21:18,580
!إلى كلّ مكان على ما أظنّ

316
00:21:20,340 --> 00:21:22,090
ألا زلت تصلح هذا الشّيء؟

317
00:21:22,090 --> 00:21:22,960
.نعم

318
00:21:22,960 --> 00:21:25,090
.قد يأخذ بعض الوقت

319
00:21:29,350 --> 00:21:30,720
ما الّذي تفعلينه هنا؟

320
00:21:30,720 --> 00:21:33,100
كيف عرفتِ عنوان منزل هاروهيكو؟

321
00:21:33,100 --> 00:21:35,270
.سألتُ هيمينو-سينسي عنه

322
00:21:35,940 --> 00:21:38,190
.أردت أن أتحدّث إليك

323
00:21:38,190 --> 00:21:39,770
ما-ماذا؟

324
00:21:39,770 --> 00:21:41,520
.لا تقولي لي أنّكِ لا تزالين غاضبة

325
00:21:43,440 --> 00:21:45,490
...شكرًا على مساعدتي

326
00:21:45,950 --> 00:21:47,950
.وآسفة على كلّ شيء آخر

327
00:21:49,870 --> 00:21:50,530
.مع السّلامة

328
00:21:51,700 --> 00:21:53,160
.مهلاً يا كويْتو-سان

329
00:21:53,160 --> 00:21:54,700
.توقّف عن مناداتي بذلك

330
00:21:54,700 --> 00:21:57,460
.يمكنكِ مناداتي "هاروهيكو" أيضًا

331
00:21:57,460 --> 00:21:59,130
!أرفض تمامًا

332
00:22:02,250 --> 00:22:04,510
سأساعدهم ثانية؟

333
00:22:04,840 --> 00:22:07,880
...أتساءل إن كنتُ أستطيع ذلك