1
00:00:03,350 --> 00:00:04,400
...جين-إي

2
00:00:05,020 --> 00:00:08,520
.كفّ عن النّظر إليّ هكذا أيّها الباتّوساي

3
00:00:08,520 --> 00:00:14,740
.بدت عيناك أفضل بكثير عندما قلتَ أنّك ستقتلني

4
00:00:16,200 --> 00:00:19,200
.طبيعتك الحقيقيّة ما زالت هيتوكيري

5
00:00:19,200 --> 00:00:22,450
،وهذا صادر من هيتوكيري آخر
.لذلك كن واثقًا من كلامي

6
00:00:22,710 --> 00:00:26,250
.يظلّ الهيتوكيري كذلك حتّى يموت

7
00:00:26,750 --> 00:00:29,880
.لا يمكنه أن يصير أيّ شيء آخر

8
00:00:30,300 --> 00:00:32,590
سأراقبك من أطراف الجحيم لأرى إلى متى

9
00:00:32,590 --> 00:00:37,390
.ستواصل وصف نفسك بروروني

10
00:00:41,430 --> 00:00:45,560
جين-إي، يمكنك على الأقلّ
.المشاهدة من أطراف الجحيم رجاءً

11
00:00:46,480 --> 00:00:48,860
حتّى إن كانت طبيعتي الحقيقيّة
...هي أنّي هيتوكيري

12
00:00:49,520 --> 00:00:51,610
.فسأكبحها لبقيّة حياتي

13
00:00:58,530 --> 00:01:02,750
.أنا روروني يرفض القتل حتّى أموت

14
00:01:03,620 --> 00:01:04,500
.لقد عدنا

15
00:01:05,080 --> 00:01:06,290
.لو سمحتم

16
00:02:46,930 --> 00:02:48,230
!توقّفي

17
00:02:49,980 --> 00:02:52,400
!قلت لك توقّفي أيّتها الحقيرة

18
00:02:54,980 --> 00:02:55,860
!كنشين

19
00:02:56,820 --> 00:02:57,820
أين أنت؟

20
00:02:58,780 --> 00:02:59,780
!هيّا، اظهر

21
00:03:01,820 --> 00:03:02,780
!كنشين

22
00:03:04,660 --> 00:03:05,740
.مستحيل

23
00:03:05,910 --> 00:03:08,450
،إن كنت تبحثين عن كنشين
.فقد أخذه سانوسكي لمكان ما

24
00:03:09,330 --> 00:03:10,370
فعلاً؟

25
00:03:10,370 --> 00:03:11,870
ماذا قد أكتسب من الكذب؟

26
00:03:11,870 --> 00:03:16,710
فهمت. ظننتُ فعلاً أنّه انطلق
.في رحلة بالفعل هذه المرّة

27
00:03:16,710 --> 00:03:18,130
.سرّني سماع هذا

28
00:03:18,130 --> 00:03:21,340
.إنّك تقلقين كثيرًا بالفعل

29
00:03:21,340 --> 00:03:23,760
لماذا لا تضعين طوقًا حول عنق كنشين أو ما شابه؟

30
00:03:24,390 --> 00:03:27,770
...سيّدة وحيوانها الأليف كنشين

31
00:03:27,770 --> 00:03:29,180
!هاو، رجاءً

32
00:03:30,270 --> 00:03:31,100
!كلاّ

33
00:03:31,100 --> 00:03:32,730
!لا تقوليها بتلك النّبرة

34
00:03:33,690 --> 00:03:36,480
إلى أين ذهبا؟

35
00:03:36,480 --> 00:03:38,280
.إلى مطعم يُدعى شُووِييَا

36
00:03:38,280 --> 00:03:40,860
.قال أنّه سيقام هناك قمار من نوع ما اليوم

37
00:03:41,150 --> 00:03:42,910
قـ-قمار؟

38
00:03:44,110 --> 00:03:46,080
!حسنًا! لنأخذ الرّهانات

39
00:03:46,080 --> 00:03:47,910
!راهنوا على أعداد فرديّة أو زوجيّة

40
00:03:47,910 --> 00:03:49,620
!فرديّة -
!زوجيّة -

41
00:03:49,620 --> 00:03:50,870
أيّها نختار؟

42
00:03:50,870 --> 00:03:52,870
.بخمسة و ستّة، أي فرديّ... في رأيي

43
00:03:53,370 --> 00:03:54,290
!فرديّ

44
00:03:54,290 --> 00:03:55,290
!النّتيجة

45
00:03:56,340 --> 00:03:57,420
!خمسة وستّة! المجموع فرديّ

46
00:03:58,000 --> 00:04:00,590
كما توقّعت من مستعمل هيتن ميتسوروغي-ريو

47
00:04:00,590 --> 00:04:02,970
أسلوب من مستوى مختلف
.تمامًا إن استُخدم لتوقّع النّرد

48
00:04:02,970 --> 00:04:06,760
.رافقتك لأنّك قلت أنّ هنالك مشكلة كبيرة يا سانو

49
00:04:06,760 --> 00:04:08,390
.المقامر غير قانونيّ رجاءً

50
00:04:08,890 --> 00:04:10,520
عمّ تتكلّم؟

51
00:04:10,520 --> 00:04:12,890
.السّاكاباتو الّذي تحمله غير قانونيّ أيضًا

52
00:04:13,310 --> 00:04:15,020
.إنّه يخالف قانون منع حمل السّيف

53
00:04:15,020 --> 00:04:17,150
.أنت محقّ... لو سمحت

54
00:04:17,150 --> 00:04:21,570
.لا داعي للقلق. كلّ هؤلاء رفاق لي

55
00:04:22,070 --> 00:04:25,660
.هذا ليس قمارًا بهدف خداع النّاس وسرقة أموالهم

56
00:04:25,660 --> 00:04:28,330
.إنّها لعبة للاستمتاع بها مع الأصدقاء

57
00:04:28,530 --> 00:04:29,540
—ولكن

58
00:04:29,540 --> 00:04:30,790
.أتينا إلى هنا سلفًا

59
00:04:30,790 --> 00:04:35,040
لنستمتع بوقتنا ونكفّ عن التّصرّف
.بكآبة بدءًا من اليوم

60
00:04:37,330 --> 00:04:41,380
سمعت عن لحظات جين-إي الأخيرة من
كاورو-دونو، أليس كذلك لو سمحت؟

61
00:04:41,550 --> 00:04:43,800
.لا أعرف أيّ شيء

62
00:04:44,340 --> 00:04:45,550
!لنأخذ الرّهانات

63
00:04:46,340 --> 00:04:48,260
!لننتقل للرّهان التّالي في كلّ الأحوال

64
00:04:48,760 --> 00:04:50,510
أنراهن على الفرديّ أم الزّوجيّ هذه المرّة؟

65
00:04:52,180 --> 00:04:54,480
...كلاهما واحد، أي زوجيّ لو سمحت

66
00:04:54,980 --> 00:04:55,900
.على الأرجح

67
00:04:56,480 --> 00:04:58,980
!أجل! حطّ كِلا النّردين على واحد

68
00:04:58,980 --> 00:05:01,980
.يا سانو، أنت تبلي حسنًا اليوم

69
00:05:01,980 --> 00:05:05,610
،هذه أوّل مرّة منذ مدّة
!لذلك تساهل معنا يا رجل

70
00:05:05,610 --> 00:05:07,160
.يا لها من مزحة

71
00:05:07,160 --> 00:05:10,490
سأجرّدكم من كلّ شيء اليوم حتّى
.ملابسكم الدّاخليّة، فاستعدّوا

72
00:05:10,490 --> 00:05:11,910
...سانو

73
00:05:13,000 --> 00:05:14,910
!جعلت الأمر صعبًا علينا بالفعل

74
00:05:14,910 --> 00:05:18,630
ظننتِ أنّ بإمكانك الهرب وحدك، صحيح؟

75
00:05:21,380 --> 00:05:23,550
ماذا؟ ما زلت تنوين على الهرب؟

76
00:05:23,550 --> 00:05:24,800
!مكانك

77
00:05:26,260 --> 00:05:30,180
بالمناسبة، ما بال بائع السّكاكر يويتا اليوم؟

78
00:05:30,220 --> 00:05:32,970
.أتا متفاجئ لأنّ مقامرًا مثله لم يحضر

79
00:05:33,970 --> 00:05:36,270
ألم تعلم يا سانو-سان؟

80
00:05:37,940 --> 00:05:41,400
.إنّ يويتا... مات قبل حوالي شهر

81
00:05:42,480 --> 00:05:46,200
ماذا قلت؟ مات جرّاء المرض أم حادثًا ما؟

82
00:05:48,160 --> 00:05:49,280
.الأفيون

83
00:05:50,620 --> 00:05:53,240
.لقد استنشق الكثير منه عن طريق الخطأ

84
00:05:57,580 --> 00:06:01,750
تجفيف اللّثى الحليبيّ الّذي يمكن
.جمعه من بذور الخشخاش المنوّم

85
00:06:02,250 --> 00:06:05,550
،إنّه يتسبّب في إعراض انسحاب فظيعة جدًّا

86
00:06:05,550 --> 00:06:08,590
لذلك تمّ منعه بالكامل في هذه الفترة

87
00:06:08,590 --> 00:06:11,550
.بصفته مخدّرًا شرّيرًا لإمكانه تدمير أمّة بأكملها

88
00:06:13,560 --> 00:06:17,390
ذلك الغبيّ! لماذا بدأ بتعاطي الأفيون؟

89
00:06:18,060 --> 00:06:19,850
.لكنّ ذلك غريب إن جاز لي التّعليق

90
00:06:20,350 --> 00:06:22,690
.الأفيون مخدّر باهظ الثّمن

91
00:06:23,190 --> 00:06:27,150
لا يجب أن يكون شيئًا يستطيع
.رجل عاديّ وضع يديه عليه

92
00:06:31,280 --> 00:06:32,870
من تكونين؟

93
00:06:37,040 --> 00:06:38,210
!أنقذني رجاءً

94
00:06:38,210 --> 00:06:39,290
أورو؟

95
00:06:39,580 --> 00:06:43,590
.يلاحقني رجال رجلان شرّيران
!ساعدني رجاءً

96
00:06:44,590 --> 00:06:46,260
!اللّعنة عليك يا ميغومي

97
00:06:46,840 --> 00:06:48,470
!لن تفلتي منّا الآن

98
00:06:49,430 --> 00:06:52,430
.يتوافدون الواحد تلو الآخر
من تكونون؟

99
00:06:52,430 --> 00:06:54,350
!اخرس ولا تتدخّل

100
00:06:54,350 --> 00:06:56,310
!سلّموني تلك المرأة بسرعة

101
00:06:56,310 --> 00:06:57,430
—وإلاّ

102
00:06:59,770 --> 00:07:02,310
!أنا منزعج الآن نوعًا ما

103
00:07:02,310 --> 00:07:04,520
!من الأفضل أن تنتبه كيف تحدّثني

104
00:07:04,520 --> 00:07:08,610
.ا-ا-اللّعنة عليك
أتظنّ أنّ بإمكانك الإفلات من هذا؟

105
00:07:08,820 --> 00:07:11,910
!نحن جيش كانريو-سان الخاصّ

106
00:07:11,910 --> 00:07:13,570
إنّ حقيقة مجابهتك لنا وحدها

107
00:07:13,570 --> 00:07:16,290
!تعني أنّك ستصير عدوًّا لكانريو-سان

108
00:07:16,290 --> 00:07:17,240
ماذا؟

109
00:07:17,240 --> 00:07:19,500
!أخبرتك أن تنتبه لحديثك معي أيّها التّابع

110
00:07:19,500 --> 00:07:20,580
.كانريو

111
00:07:20,580 --> 00:07:21,580
.هذا سيّئ

112
00:07:21,580 --> 00:07:23,750
.إنّه يتكلّم عن تاكيدا كانريو

113
00:07:23,750 --> 00:07:25,500
تاكيدا كانريو؟

114
00:07:25,500 --> 00:07:27,550
من يكون هذا الرّجل لو سمحت؟

115
00:07:29,090 --> 00:07:32,550
،إنّه رجل أعمال شابّ يعيش في ضواحي البلدة

116
00:07:32,550 --> 00:07:33,890
.يبدو كذلك من الخارج على الأقلّ

117
00:07:34,430 --> 00:07:36,680
.لكن لا أحد يدري ماذا يفعل في الخفاء

118
00:07:36,680 --> 00:07:39,930
.صار فاحش الثّراء فجأة في السّنوات القليلة الماضية

119
00:07:39,930 --> 00:07:42,480
.حتّى أنّ لديه جيشًا خاصًّا ضخمًا هذه الأيّام

120
00:07:42,480 --> 00:07:44,230
.إنّه رجل مثير للشّبهات في رأيي

121
00:07:44,690 --> 00:07:49,490
جميع من في هذه البلدة، من الياكوزا
.إلى السّياسيّين، يتفادون قتاله

122
00:07:50,150 --> 00:07:52,240
،لذلك إن كانا جزءًا من جيشه الخاصّ

123
00:07:52,240 --> 00:07:54,280
فهل أنت من نساء كانريو؟

124
00:07:54,280 --> 00:07:55,370
!كلاّ

125
00:07:55,990 --> 00:07:58,910
.أنا لا أعرف أيّ شيء بالفعل

126
00:07:59,500 --> 00:08:01,620
.ولا حتّى عن هذا المدعوّ كانريو أيضًا

127
00:08:01,620 --> 00:08:05,000
.كفاك كذبًا يا تاكاني ميغومي

128
00:08:09,340 --> 00:08:10,420
...ما الّذي

129
00:08:10,420 --> 00:08:12,420
متى دخل إلى هنا؟

130
00:08:13,930 --> 00:08:17,470
يبدو أنّك هربت لأنّك ظننت
.أنّ رجلان فقط يراقبانك

131
00:08:17,470 --> 00:08:21,930
.لكنّ واحدًا من رجال زعيمنا يراقبك دائمًا

132
00:08:25,190 --> 00:08:28,900
!لكنّي لم أكذب عندما قلت أنّي لست من نسائه

133
00:08:29,400 --> 00:08:33,820
عد من حيث أتيت وأخبر كانريو
!أنّي سأحرص على الهرب منه

134
00:08:35,990 --> 00:08:37,870
.كم هذا ظريف

135
00:08:37,870 --> 00:08:41,790
.وخاصّة الجزء الّذي تظنّين فيه أنّ بإمكانك الهرب

136
00:08:42,500 --> 00:08:43,330
!أيّها الوغد

137
00:08:43,330 --> 00:08:44,960
!غادر المكان في الحال

138
00:08:46,750 --> 00:08:47,960
!تومو! غينجي

139
00:08:48,540 --> 00:08:50,670
.السّهام الدّوّارة الثّاقبة

140
00:08:50,670 --> 00:08:54,180
،كان ذلك مجرّد ترحيب
...ولكن في المرّة القادمة يا ميغومي

141
00:08:54,680 --> 00:08:56,640
.سأحطّم قدميك

142
00:08:56,640 --> 00:08:58,890
.سيكون ذلك بمثابة عقاب لك

143
00:09:06,310 --> 00:09:08,150
قلَب حصيرة التّاتامي؟

144
00:09:08,150 --> 00:09:10,150
—لكنّ سهامي بإمكانها

145
00:09:10,150 --> 00:09:12,110
.أنا لا أفهم ما هي الظّروف بالضّبط

146
00:09:15,030 --> 00:09:20,990
لكنّي لا أستطيع مشاهدة النّاس
.يتأذّون أو يقتلون هكذا بعد إذنك

147
00:09:21,540 --> 00:09:22,870
!أنت لا تعلم شيئًا

148
00:09:23,120 --> 00:09:25,160
أيّها الوغد، كيف تجرؤ على فعل ذلك برفاقي؟

149
00:09:25,160 --> 00:09:26,040
ماذا؟

150
00:09:29,710 --> 00:09:31,590
.هذا سيّئ

151
00:09:31,800 --> 00:09:35,220
لقد أطاحوا بثلاثة رجال من جيش
.تاكيدا كانريو الخاصّ

152
00:09:37,760 --> 00:09:38,840
.إنّهما قويّان

153
00:09:39,350 --> 00:09:42,180
.وخاصّة السّيّاف. يبدو لا يقهر

154
00:09:43,520 --> 00:09:47,690
اسمعا أيّها الفتيان. هل يمكنكما حمايتي
والسّماح لي بالهرب من قبضة كانريو؟

155
00:09:48,190 --> 00:09:51,440
.سأدفع لكما مكافأة معتبرة
ما قولكما؟

156
00:09:51,440 --> 00:09:54,740
لماذا لا تفسّرين ماذا يحدث قبل ذلك؟

157
00:09:55,650 --> 00:09:56,530
!هذا مؤلم

158
00:09:56,530 --> 00:09:58,530
.تأذّى اثنان من رفاقي بسببك

159
00:09:58,530 --> 00:10:00,950
!لن يهنأ لي بال حتّى أسمع السّبب وراء ذلك

160
00:10:00,950 --> 00:10:01,950
!أنت تؤلمني

161
00:10:01,950 --> 00:10:03,830
!لا تمسك بي بقوّتك السّخيفة هذه

162
00:10:08,330 --> 00:10:09,750
!إنّه أفيون

163
00:10:09,750 --> 00:10:12,460
!كانت مثل تلك الأكياس في منزل يويتا

164
00:10:14,800 --> 00:10:19,010
لا أظنّك كنت تقصدين هذه
عندما قلت مكافأة لو سمحت؟

165
00:10:29,730 --> 00:10:32,360
.لقد تأخّرا كثيرًا بالفعل

166
00:10:32,360 --> 00:10:35,480
أعتقد أنّهما إمّا فازا فوزًا كبيرًا
.أو خسرا خسارة فادحة

167
00:10:35,480 --> 00:10:36,740
،إن كانا قد خسرا

168
00:10:36,740 --> 00:10:39,280
فعلى الأرجح أنّهما فقدا ملابسهما
.ولا يرتديان سوى ملابسهما الدّاخليّة

169
00:10:39,280 --> 00:10:40,280
ماذا؟

170
00:10:43,780 --> 00:10:45,580
.كلاّ. لا أريد رؤية شيء كهذا

171
00:10:46,200 --> 00:10:47,080
!لقد عدنا

172
00:10:47,790 --> 00:10:49,870
—كنشين! مرحبًا بـ

173
00:10:51,330 --> 00:10:53,420
.يا له من منزل رثّ

174
00:10:53,420 --> 00:10:54,920
أهذا دوجو مسايفة؟

175
00:10:56,380 --> 00:10:59,220
.هذه هي تاكاني ميغومي-دونو

176
00:10:59,630 --> 00:11:01,840
—حدثت مشاكل في منزل القمار و

177
00:11:02,090 --> 00:11:05,260
،ورفضوا دفع ما فزنا به

178
00:11:05,260 --> 00:11:07,350
.لذلك أحضرنا هذه الفتاة مقابل ذلك

179
00:11:07,770 --> 00:11:10,190
.آسف، لكن سيكون عليها البقاء هنا لبعض الوقت

180
00:11:10,690 --> 00:11:13,690
.فهمت. إذًا فقد كان فوزًا كبيرًا لصالحكما

181
00:11:13,980 --> 00:11:15,360
...سانو

182
00:11:15,360 --> 00:11:16,900
،إن أخبرناها بالحقيقة

183
00:11:16,900 --> 00:11:18,780
فسيكون الأفيون جزءًا من الحديث، صحيح؟

184
00:11:18,780 --> 00:11:20,610
.من الأفضل إن أبقينا ذلك سرًّا هنا

185
00:11:20,950 --> 00:11:22,030
...كنشين

186
00:11:23,320 --> 00:11:25,870
أهذه هي الحقيقة؟

187
00:11:26,160 --> 00:11:28,870
لا تريد أن تتهوّر وتورّطهما في هذا، صحيح؟

188
00:11:31,580 --> 00:11:32,830
.كنشين

189
00:11:35,500 --> 00:11:38,670
.إنّها الحقيقة رجاءً

190
00:11:38,920 --> 00:11:40,220
!أسأت الحكم عليك بالكامل

191
00:11:42,050 --> 00:11:44,680
!لم أتوقّع أن تتعامل مع شيء مثل المتاجرة بالبشر

192
00:11:44,680 --> 00:11:45,470
...أورو

193
00:11:45,470 --> 00:11:48,010
،ذلك متوقّع من سانوسكي
لكن كيف تفعل أنت هذا يا كنشين؟

194
00:11:48,010 --> 00:11:49,600
كيف أردتّ على ذلك؟

195
00:11:49,810 --> 00:11:52,810
عفوًا... اسمك تاكاني-سان، صحيح؟

196
00:11:53,060 --> 00:11:56,570
.آسفة. سأحرص على تلقينه درسًا حيال هذا

197
00:11:56,570 --> 00:11:58,230
.لذلك يمكنك العودة لمنزلك الآن

198
00:11:58,230 --> 00:12:01,450
.يا إلهي. لا أنوي العودة للمنزل -
ماذا؟ -

199
00:12:01,450 --> 00:12:04,410
.لقد أعجبت به كثيرًا

200
00:12:04,410 --> 00:12:06,910
.لا أريد الانفصال عنه ولو للحظة واحدة

201
00:12:08,200 --> 00:12:14,080
أنت أفضل حالاً برفقتي أنا من تلك
الفتاة المتعرّقة، صحيح يا كِن-سان؟

202
00:12:14,080 --> 00:12:16,790
—آه يا كنشين، لا يُستهان بك

203
00:12:17,800 --> 00:12:20,130
!كـ-كلاّ! لا يمكنك فعل ذلك على الإطلاق

204
00:12:20,130 --> 00:12:22,130
ولماذا لا؟

205
00:12:22,470 --> 00:12:26,640
.لا يبدو لي أنّك حبيبة كِن-سان أو ما شابه

206
00:12:26,640 --> 00:12:29,010
فهل لديك الحقّ لقول كلام كهذا؟

207
00:12:29,680 --> 00:12:31,810
.لا تضايقيها كثيرًا

208
00:12:31,810 --> 00:12:34,400
.هذه الفتاة بسيطة التّفكير

209
00:12:35,400 --> 00:12:38,360
!اخرجوا! غادروا جميعًا

210
00:12:41,150 --> 00:12:42,320
.يا إلهي

211
00:12:42,820 --> 00:12:44,570
.يا إلهي بالفعل

212
00:12:44,570 --> 00:12:48,620
.إنّه خطؤك لقولك شيئًا لا تعنينه بالكامل

213
00:12:48,830 --> 00:12:52,410
ماذا؟ لم أكذب عندما قلت أنّي
.لا أريد الانفصال عنه ولو للحظة

214
00:12:52,410 --> 00:12:56,330
.إنّه قويّ بشكل كبير، وناضج تمامًا

215
00:12:56,580 --> 00:13:00,050
،أشعر أنّي إن كنت إلى جانبك
.فأنا واثق أنّه سيحميني حتّى إن هوجمت

216
00:13:00,840 --> 00:13:05,260
اسمك هيمورا كنشين، صحيح؟
.أنت مثاليّ لتكون حارسي

217
00:13:06,470 --> 00:13:10,640
إن كان الوضع هكذا، أودّ على
.الأقلّ معرفة ظروفك لو سمحت

218
00:13:10,810 --> 00:13:14,350
معه حقّ. ما قصّتك؟

219
00:13:14,890 --> 00:13:17,940
لماذا تحاولين الهرب من كانريو؟

220
00:13:17,940 --> 00:13:21,070
لماذا كانريو مصرّ كثيرًا على ملاحقتك؟

221
00:13:21,280 --> 00:13:25,030
وهناك هذا أيضًا! كيف ومن أين حصلت عليه؟

222
00:13:25,530 --> 00:13:27,820
.أنت عديم الإحساس لسؤالك عن ماضي امرأة

223
00:13:27,820 --> 00:13:28,820
!أيّتها المغفّلة

224
00:13:28,820 --> 00:13:29,830
.مهلاً، مهلاً

225
00:13:30,530 --> 00:13:33,540
،حسنًا. ما دمت سأظلّ قريبًا منك

226
00:13:33,540 --> 00:13:36,000
.فسأحصل إلى مصدر هذا الأفيون قريبًا

227
00:13:36,000 --> 00:13:38,540
!لقد كان السّبب في موت رفيقي

228
00:13:39,040 --> 00:13:43,380
لا يجب أن أسمح بانتشار هذا
.في الشّوارع أكثر من ممّا هو عليه الآن

229
00:13:43,550 --> 00:13:45,720
!سأضع لهذا حدًّا بكلّ تأكيد

230
00:13:47,470 --> 00:13:48,550
!سانو-سان

231
00:13:49,550 --> 00:13:52,520
!ها أنت هنا! كنت أبحث عنك منذ مدّة

232
00:13:52,520 --> 00:13:56,520
شو. ألم تكن في طريقك لأخذ غين وتومو للطّبيب؟

233
00:13:56,520 --> 00:13:59,520
.نعم. إنّها بخير الآن

234
00:13:59,650 --> 00:14:01,570
.لكن هنالك مشكلة كبيرة

235
00:14:01,570 --> 00:14:02,820
!تعال معي رجاءً

236
00:14:04,740 --> 00:14:06,650
ما الّذي يحدث؟

237
00:14:11,990 --> 00:14:14,620
!إنّهما الرّجلان من جيش كانريو الخاصّ

238
00:14:15,160 --> 00:14:16,710
.يا له من وضع فظيع

239
00:14:17,250 --> 00:14:20,290
.يتمّ الإطاحة بكلّ من لا فائدة منهم عنده

240
00:14:21,040 --> 00:14:22,960
.هكذا يدير كانريو أعماله

241
00:14:35,680 --> 00:14:36,520
.بشيمي

242
00:14:36,520 --> 00:14:37,350
!حاضر

243
00:14:37,730 --> 00:14:40,270
،السّيّاف الّذي سحق أنفك

244
00:14:40,270 --> 00:14:44,480
قلتَ أنّه أصهب بندبة على شكل
صليب على خدّه الأيسر، صحيح؟

245
00:14:44,690 --> 00:14:45,530
,نعم

246
00:14:47,570 --> 00:14:49,990
!إنّه ذلك الوغد! كما أنّ ميغومي معه أيضًا

247
00:14:49,990 --> 00:14:52,450
—هذا مثاليّ! سأقتلهما في الحا

248
00:14:52,580 --> 00:14:56,200
.إنّ المشاكل أمام حشد كهذا ستعود عليّ بالضّرر

249
00:14:56,330 --> 00:14:57,160
.توقّف

250
00:14:57,660 --> 00:14:59,790
.شكرًا جزيلاً

251
00:15:00,290 --> 00:15:03,290
.في كلّ الأحوال، ذلك الرّجل ليس عاديًّا

252
00:15:03,290 --> 00:15:06,590
.بشيمي، لا يمكنك تولّي أمره وحدك

253
00:15:07,210 --> 00:15:09,510
...إنّ حقيقة وجودهم هنا تعني

254
00:15:10,010 --> 00:15:12,470
هانيا، أنت هنا أيضًا، صحيح؟

255
00:15:13,100 --> 00:15:14,310
.نعم

256
00:15:14,810 --> 00:15:16,890
هل اكتشفت مكان اختبائهم؟

257
00:15:17,390 --> 00:15:21,560
،نعم. كان ذلك الرّجل حريصًا جدًّا

258
00:15:21,560 --> 00:15:24,820
،لذلك كان من الصّعب ملاحقته
.لكنّي تدبّرت الأمر

259
00:15:25,270 --> 00:15:29,490
جيّد. عليك إذًا أن ساعد بشيمي
.في مهمّة استعادة تاكاني ميغومي

260
00:15:29,490 --> 00:15:33,200
.اطلب مساعدة هيوتّوكو أيضًا

261
00:15:33,700 --> 00:15:34,780
.مفهوم

262
00:15:35,030 --> 00:15:38,200
.اسمع يا بشيمي. عيّنتُ رجلين لمساعدتك

263
00:15:38,830 --> 00:15:40,920
.لن أسمح بفشل آخر

264
00:15:41,420 --> 00:15:44,290
.سأضع ذلك حلقة في أذني. أستأذن الآن

265
00:15:46,250 --> 00:15:49,130
.تمنحه فرصة ثانية

266
00:15:49,130 --> 00:15:51,930
.يا له من زعيم متعاطف

267
00:15:51,930 --> 00:15:53,390
أتظنّ ذلك؟

268
00:15:53,390 --> 00:15:57,560
.بالفعل. ما كنتُ لأقوم بشيء كهذا في مكانك

269
00:15:58,100 --> 00:16:00,640
.أنا رجل أعمال حتّى النّخاع

270
00:16:01,350 --> 00:16:04,610
،يجب التّخلّص منا لرّجال عديمي الفائدة

271
00:16:04,610 --> 00:16:06,610
.وإلاّ فلن يهنأ لي بال

272
00:16:07,610 --> 00:16:13,070
،وعندما يتمّ التّخلّص منهم
.أشعر بانتعاش كامل

273
00:16:13,820 --> 00:16:15,320
...لنترك ذلك جانبًا

274
00:16:15,700 --> 00:16:18,660
.ميغومي-سان هي أكثر من يقلقني

275
00:16:19,450 --> 00:16:23,620
إنّها دجاجتي الصّغيرة العزيزة
.الّتي تبيض لي بيضًا من ذهب

276
00:16:23,620 --> 00:16:26,130
.لن أسمح أن تفلت منّي أبدًا

277
00:16:28,050 --> 00:16:28,880
!كانريو

278
00:16:29,340 --> 00:16:31,050
.لا مجال للشّكّ

279
00:16:31,050 --> 00:16:34,090
.كنشين، صاحب النّظّارات ذاك هو كانريو

280
00:16:34,090 --> 00:16:36,970
.الرّجل الّذي يقف إلى جانبه أهمّ بكثير

281
00:16:37,510 --> 00:16:39,520
من يكون لو سمحت؟

282
00:16:39,520 --> 00:16:42,980
.لا أدري. ربّما يكون قائد جيشه الخاصّ

283
00:16:42,980 --> 00:16:43,810
!كلاّ

284
00:16:44,810 --> 00:16:45,650
...إنّه

285
00:16:45,650 --> 00:16:46,860
!الزّعيم

286
00:16:47,860 --> 00:16:53,400
يتزعّم ذلك الرّجل مجموعة منفصلة
عن الجيش الخاصّ تسمّى الأونيوانبانشو

287
00:16:53,400 --> 00:16:56,450
وتتكوّن من أونميتسو سابقين
.عيّنهم كانريو مؤخّرًا

288
00:16:57,450 --> 00:17:02,830
الأونميتسو هم مخادعون كانوا
.ينشطون خلال فترة إيدو

289
00:17:03,370 --> 00:17:06,580
.لكنّهم الآن يُشار إليهم عادة كشينوبي أو نينجا

290
00:17:07,290 --> 00:17:09,040
أمّا الأونيوانبانشو

291
00:17:09,040 --> 00:17:13,420
فهي منظّمة سرّيّة من بينهم تعمل مباشرة
تحت إمرة الشّوغن وتتكوّن من أولئك

292
00:17:13,420 --> 00:17:17,010
الّذين يتميّزون في المهارات القتاليّة
.أكثرَ من أيّ أونميتسو آخر

293
00:17:17,930 --> 00:17:24,390
وذاك هناك هو الأونميتسو العبقريّ
الّذي صار زعيم أونيوانبانشو قلعة إيدو

294
00:17:24,390 --> 00:17:28,770
قُبيل ثورة ميجي وهو في الخامسة عشر
!من العمر، واسمه شينوموري أَوُشي

295
00:17:30,320 --> 00:17:33,940
كيف انتهى المطاف برجل كهذا
ضمن صفوف كانريو؟

296
00:17:33,940 --> 00:17:35,070
.لا فكرة لديّ

297
00:17:35,070 --> 00:17:40,410
في كلّ الأحوال، إنّنا في مواجهة رجل
.أعمال مشبوه وأونيوانبانشو خطيرين

298
00:17:40,870 --> 00:17:44,080
لا يمكننا تحمّل خسارة ميغومي-دونو
.في هذه المرحلة رجاءً

299
00:17:45,580 --> 00:17:47,540
.أصهب بندبة على شكل صليب

300
00:17:48,500 --> 00:17:49,540
...مستحيل

301
00:17:55,220 --> 00:17:56,010
،بتعبير آخر

302
00:17:56,010 --> 00:18:00,220
هنالك 60 رجلاً ضمن جيش كانريو الخاصّ، صحيح؟

303
00:18:00,640 --> 00:18:01,470
.صحيح

304
00:18:01,850 --> 00:18:03,310
ماذا عن الأونيوانبانشو؟

305
00:18:03,310 --> 00:18:05,270
.أظنّهم خمسة أو ستّة

306
00:18:07,140 --> 00:18:11,480
والآن، من أين حصلت على الأفيون لو سمحت؟

307
00:18:13,110 --> 00:18:16,700
ما زلت تلتزمين الصّمت عندما يتعلّق
.الأمر بالأفيون لو سمحت

308
00:18:16,860 --> 00:18:20,780
.قرّرت الحديث فقط لتسهيل القتال عليك

309
00:18:20,780 --> 00:18:22,620
.لا علاقة للأفيون بالأمر

310
00:18:23,120 --> 00:18:26,910
،لا تسأل عمّا لا تحتاج أن تسأل عنه
.وأبقهم بعيدًا عنّي فحسب

311
00:18:27,750 --> 00:18:32,090
رغم ذلك، إن كانت الأونيوانبانشو
،تتحرّك في الوقت الحاليّ

312
00:18:32,090 --> 00:18:34,380
.فلن يكونا ندًّا لمجموعة مثلها

313
00:18:34,880 --> 00:18:36,550
.لا حاجة للبقاء هنا لوقت طويل

314
00:18:36,550 --> 00:18:38,430
من الأفضل أن أستعمل جلبة القتال

315
00:18:38,430 --> 00:18:40,590
.كغطاء لأهرب أبعد من هنا

316
00:18:41,140 --> 00:18:43,350
—حسنًا يا ميغومي-دونو

317
00:18:43,350 --> 00:18:46,100
!أخبرتك أنّي لن أجيب عن أيّ أسئلة شخصيّة

318
00:18:46,270 --> 00:18:48,690
.ليس من الأدب استراق السّمع يا آنسة

319
00:18:48,890 --> 00:18:50,770
...لكن، لكن، لكن، لكن

320
00:18:50,770 --> 00:18:53,650
لقد قرّرا الانفراد ببضعهما معًا بعد
!أن عادا مباشرة

321
00:18:53,980 --> 00:18:58,280
.لا بأس. الأمر ليس كما تتخيّلين على الإطلاق

322
00:18:58,780 --> 00:19:00,490
ما الأمر إذًا؟

323
00:19:00,910 --> 00:19:03,530
.هذا من شيمه، من شيمه

324
00:19:04,580 --> 00:19:09,330
لا يسعه سوى مساعدة من هم
.بحاجة أو من يواجهون مشاكل

325
00:19:09,830 --> 00:19:12,000
.هذا من شيم الرّوروني

326
00:19:12,710 --> 00:19:14,960
،تعلمين كم أنّه سيّاف قويّ

327
00:19:14,960 --> 00:19:17,170
.لكنّه ضعيف تمامًا أمام المحتاجين

328
00:19:17,670 --> 00:19:19,630
.خاصّة إن كانوا أطفالاً أو نساءً

329
00:19:20,890 --> 00:19:22,180
.معك حقّ في هذا

330
00:19:22,600 --> 00:19:24,310
إذًا هل أنت تشبهه في ذلك يا سانوسكي؟

331
00:19:24,310 --> 00:19:25,350
.قطعًا لا

332
00:19:25,350 --> 00:19:27,770
.أريد الانتقام لرفيقي فحسب

333
00:19:27,770 --> 00:19:30,850
!لا أهتمّ ما قد يحدث لماكرات مثلها

334
00:19:32,060 --> 00:19:34,650
سانو، هل كلّ شيء طبيعيّ؟

335
00:19:34,650 --> 00:19:35,570
.نعم

336
00:19:35,860 --> 00:19:37,990
.هذا مبيان عن منظّمة كانريو

337
00:19:37,990 --> 00:19:40,070
.سيكون من الأفضل لو تلقي نظرة عليها لو سمحت

338
00:19:40,530 --> 00:19:43,120
،أمّا بالنّسبة للأونيوانبانشو الّذين إلى جانبهم

339
00:19:43,120 --> 00:19:45,780
من الأفضل أن نفترض أنّهم يعرفون
.هذا المكان سلفًا

340
00:19:46,330 --> 00:19:48,370
.لا يجب أن ندعهم يأخذونا على حين غرّة لو سمحت

341
00:19:49,080 --> 00:19:52,500
،كاورو-دونو، لا يمكنني التّكلّم عن التّفاصيل

342
00:19:52,500 --> 00:19:56,090
.لكن قد تحدث مشاكل هنا في المستقبل

343
00:19:56,630 --> 00:19:59,800
.لن أفشل ثانية كما حدث مع جين-إي

344
00:20:00,260 --> 00:20:03,180
.سأحرص على حمايتك كلّ الحرص

345
00:20:05,430 --> 00:20:07,010
.مفهوم

346
00:20:07,010 --> 00:20:10,390
،لكن بعد انتهاء كلّ شيء
.عليك أن تشرح لي ما يحدث بالكامل

347
00:20:14,190 --> 00:20:16,770
.سمعتُ ذلك يا كنشين

348
00:20:17,690 --> 00:20:19,610
قلت أنّه قد تكون هنالك مشاكل؟

349
00:20:19,610 --> 00:20:21,610
ياهيكو، منذ متى وأنت هناك؟

350
00:20:21,610 --> 00:20:23,070
.منذ أن حلّ اللّيل

351
00:20:23,070 --> 00:20:24,820
.لم أنتبه لذلك

352
00:20:24,820 --> 00:20:28,290
على أيّ حال، هل أنا الوحيد الّذي
بقيت خارج هذه الصّورة؟

353
00:20:28,290 --> 00:20:30,370
أنا جزء من فريق كنشين أيضًا، صحيح؟

354
00:20:30,620 --> 00:20:32,000
ما هذا؟

355
00:20:32,000 --> 00:20:33,580
متى تشكّل ذلك الفريق رجاءً؟

356
00:20:36,290 --> 00:20:37,840
ماذا قلت؟

357
00:20:37,840 --> 00:20:40,130
!سانوسكي، عليك أن تفكّر قبل أن تتكلّم

358
00:20:40,420 --> 00:20:42,090
—أتيتُ إلى هنا قبلك

359
00:20:44,970 --> 00:20:47,390
.ولذلك السّبب أنت ما زلت شقيًّا

360
00:20:47,390 --> 00:20:48,310
ماذا؟ ما الّذي تعنيه؟

361
00:20:50,560 --> 00:20:51,850
!لقد أتوا

362
00:20:52,060 --> 00:20:53,060
!عند البوّابة

363
00:21:02,740 --> 00:21:04,950
.لا بدّ أنّهم الأونيوانبانشو

364
00:21:05,950 --> 00:21:08,700
.سلّمونا ميغومي بهدوء

365
00:21:08,700 --> 00:21:11,700
.سأتساهل معكم إن قمت بذلك

366
00:22:46,090 --> 00:22:48,840
."الحلقة القادمة: "هجوم الأونيوانبانشو