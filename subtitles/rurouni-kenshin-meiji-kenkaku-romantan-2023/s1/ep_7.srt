1
00:00:00,470 --> 00:00:01,390
.اسمع

2
00:00:01,390 --> 00:00:02,850
.أنا أعيرك إيّاه فحسب

3
00:00:03,230 --> 00:00:04,190
.عليك أن تعيده لي

4
00:00:06,770 --> 00:00:08,070
.مفهوم

5
00:00:08,070 --> 00:00:09,980
،سأحرص على أن أعيده لك

6
00:00:09,980 --> 00:00:12,530
.لذلك اطمئنّي وانتظريني في الدّوجو رجاءً

7
00:00:15,910 --> 00:00:16,740
.حسنًا

8
00:00:22,790 --> 00:00:23,660
!كنشين

9
00:02:28,250 --> 00:02:30,250
.لا تحدّقي بي كثيرًا

10
00:02:30,250 --> 00:02:34,340
.فأنا لم أختطفك ساعيًا لأكلك أو ما شابه

11
00:02:34,590 --> 00:02:35,880
.أعلم ذلك

12
00:02:36,300 --> 00:02:38,720
.فعلت هذا للتّقليل من بعض قوّة كنشين

13
00:02:38,720 --> 00:02:40,840
.اتّضح أنّ كوروغاسا مجرّد جبان لا غير

14
00:02:41,340 --> 00:02:43,220
.أنت لا تفهمين بالفعل

15
00:02:44,560 --> 00:02:47,770
.سيُثار غضب الباتّوساي إن أخذتك كرهينة

16
00:02:48,270 --> 00:02:52,310
وسيعيده الغضب إلى الهيتوكيري
.الّذي كان في السّابق

17
00:02:53,270 --> 00:02:55,610
.فقد الباتّوساي الحاليّ حدّته

18
00:02:56,230 --> 00:02:59,400
أستطيع هزيمته قبل حتّى
.أن أنهي تدخين سيجارة واحدة

19
00:02:59,990 --> 00:03:01,780
.وسيكون ذلك مملاًّ

20
00:03:03,490 --> 00:03:05,910
أنت لست جبانًا فحسب، بل وكاذب أيضًا؟

21
00:03:05,910 --> 00:03:09,040
لا يُعقل أن تكون جاهلاً بقوّة كنشين، صحيح؟

22
00:03:10,290 --> 00:03:12,330
...أنت من لا تعرفين

23
00:03:13,000 --> 00:03:15,210
مهارات الهيتوكيري باتّوساي

24
00:03:15,210 --> 00:03:19,550
الّتي تُشعر المرء بالقشعريرة
.بمجرّد سماع أسمائهم

25
00:03:23,970 --> 00:03:29,140
كانت أوّل مرّة أراه فيها
.في كيوتو خلال فترة باكوماتسو

26
00:03:30,020 --> 00:03:32,560
.سمعتُ إشاعات عن الهيتوكيري

27
00:03:32,560 --> 00:03:36,070
.لكنّنا كنّا من الشّينسنغومي

28
00:03:36,070 --> 00:03:38,280
.من المستحيل أن نخسر في مواجهة رجل واحد

29
00:03:38,780 --> 00:03:40,360
.ذلك ما ظننتُه على الأقلّ

30
00:03:55,540 --> 00:03:57,210
.حدث الأمر في رمشة عين

31
00:03:57,800 --> 00:04:00,380
،بمجرّد أن ملأ ضوء القمر الشّارع

32
00:04:00,380 --> 00:04:03,930
.قتل الرّجال الثّلاثة الآخرين

33
00:04:05,970 --> 00:04:06,970
.اسمع

34
00:04:07,720 --> 00:04:09,220
.أخبر رفاق

35
00:04:09,930 --> 00:04:12,430
إن كنتم ستقتلون المزيد من
...المحاربين الثّوريّين

36
00:04:12,980 --> 00:04:16,190
.فسيكون عليكم قتالي

37
00:04:31,950 --> 00:04:34,460
،لو أنّي قاتلته وقتها

38
00:04:34,960 --> 00:04:38,540
.لكنتُ قد لقيت حتفي هناك وقتها

39
00:04:39,000 --> 00:04:40,460
.لكنّ الوضع مختلف الآن

40
00:04:40,960 --> 00:04:44,630
.قتلتُ الكثيرين، أصدقاء وأعداء

41
00:04:46,840 --> 00:04:51,100
،تمكّنت من أن أصير هيتوكيري
.مثله تمامًا

42
00:04:51,720 --> 00:04:56,060
اثنان من الهيتوكيري يقتلان بعضهما
.في وضع حرج

43
00:04:56,850 --> 00:04:59,110
.تلك هي قمّة المتعة

44
00:04:59,320 --> 00:05:00,150
—إنّ كنشين

45
00:05:00,360 --> 00:05:04,360
أستطيع أن أميّز تمامًا أيّ نوع
من الرّجال أنظر إليه

46
00:05:04,360 --> 00:05:09,370
.وأيّ نوع من الرّجال تنظرين إليه

47
00:05:19,590 --> 00:05:20,920
...والآن

48
00:05:23,010 --> 00:05:24,340
.إنّه منتصف اللّيل

49
00:05:25,090 --> 00:05:27,550
.بداية أكثر اللّحظات متعة

50
00:05:28,470 --> 00:05:31,430
أليس كذلك أيّها الباتّوساي؟

51
00:05:31,640 --> 00:05:32,470
!كنشين

52
00:05:39,860 --> 00:05:41,520
.تعجبني تلك النّظرة

53
00:05:41,520 --> 00:05:43,030
.أنت غاضب بالفعل

54
00:05:43,650 --> 00:05:44,490
.نعم

55
00:05:44,820 --> 00:05:47,360
غاضب منك لأنّك أقحمت كاورو-دونو في هذا

56
00:05:47,860 --> 00:05:51,080
.وغاضب منّي لأنّي كنت عاجزًا عن إيقافك

57
00:05:51,910 --> 00:05:52,910
قال "منّي"؟

58
00:05:53,580 --> 00:05:55,660
.مذهل، مذهل

59
00:05:55,660 --> 00:05:58,870
أرى أنّ طريقة كلامك عادت
.كما كانت في فترة باكوماتسو

60
00:05:59,670 --> 00:06:00,670
...والآن

61
00:06:00,840 --> 00:06:03,250
،إن قلبت نصل ذلك السّيف

62
00:06:03,250 --> 00:06:06,260
.يكون الهيتوكيري الأسطوريّ قد عاد

63
00:06:06,670 --> 00:06:07,630
.كنشين

64
00:06:33,780 --> 00:06:34,740
!هذه وقاحة

65
00:06:34,950 --> 00:06:35,870
.هذا ليس هو

66
00:06:36,370 --> 00:06:38,250
.هذا ليس كنشين الّذي أعرفه

67
00:06:38,960 --> 00:06:41,750
!أخبرتك أنّ شين نو إبّو لن تنجح ضدّي

68
00:06:43,170 --> 00:06:45,500
...يبدأ أسلوب نيكايدو هيهو

69
00:06:45,710 --> 00:06:46,760
!بكاتاتي هيرازوكي

70
00:06:48,010 --> 00:06:48,920
...ثمّ

71
00:06:49,800 --> 00:06:52,010
.وضعيّة الرّمز واحد، يوكوناغي

72
00:06:52,970 --> 00:06:55,260
.وضعيّة الرّمز عشرة، كاراتاكي-ماري

73
00:06:56,140 --> 00:06:57,390
...وهنا

74
00:06:57,390 --> 00:06:58,310
!أصدّها

75
00:07:13,490 --> 00:07:16,450
،يبدو أنّك كنت تقرأ تحرّكاتي

76
00:07:16,450 --> 00:07:19,000
.لكنّك لم تستطع توقّع هايشاتو

77
00:07:20,160 --> 00:07:21,250
.ما زلت لم تعد بالكامل

78
00:07:21,750 --> 00:07:25,670
أستطيع قتلك في وضعك الحاليّ
.في نفس وقت تدخيني لثلاث سجائر

79
00:07:25,880 --> 00:07:26,800
!كنشين

80
00:07:28,760 --> 00:07:30,300
.هذا مملّ

81
00:07:30,930 --> 00:07:33,140
.أريدك أن تشعر بغضب أكثر

82
00:07:44,610 --> 00:07:45,560
!كاورو-دونو

83
00:07:45,900 --> 00:07:49,400
،طبّقتُ عليها شين نو إبّو أقوى بقليل

84
00:07:49,400 --> 00:07:51,990
.لدرجة أنّ وظائف رئتيها أصيبت بالشّلل

85
00:07:52,320 --> 00:07:54,320
.لن تدوم لأكثر من دقيقتين

86
00:07:55,280 --> 00:07:58,160
.لا يمكن وضع حدّ لهذا بسهولة كليلة الأمس

87
00:07:58,370 --> 00:08:00,580
.الموت اختناقًا ميتة بشعة

88
00:08:01,080 --> 00:08:04,710
.يسيل لعاب المُختنق ويخرج البول والبراز من جثّته

89
00:08:05,210 --> 00:08:06,710
.حين-إي

90
00:08:07,630 --> 00:08:09,880
.لا تملك وقتًا للحديث

91
00:08:10,550 --> 00:08:13,180
.إن كان لديك ما تقوله، فاستعمل سيفك

92
00:08:19,720 --> 00:08:21,810
...ممتاز، ما حدث توًّا

93
00:08:21,810 --> 00:08:23,390
،لم ألاحظ لمعة السّيف فحسب

94
00:08:23,390 --> 00:08:25,770
.بل لم ألاحظ حتّى كيف تحرّكت

95
00:08:25,770 --> 00:08:28,110
.هذا هو أسلوب هيتن ميتسوروغي-ريو

96
00:08:28,400 --> 00:08:30,730
!هذا هو الهيتوكيري باتّوساي

97
00:08:33,950 --> 00:08:36,160
.لا يوجد وقت للحديث

98
00:08:37,240 --> 00:08:40,120
.سأقتلك، لذلك قف وواصل القتال بسرعة

99
00:08:44,500 --> 00:08:45,670
.كنشين

100
00:08:46,170 --> 00:08:48,170
أقلت "سأقتلك"؟

101
00:08:49,380 --> 00:08:50,670
.هذا مذهل

102
00:08:53,170 --> 00:08:56,140
.جملة تليق بهيتوكيري

103
00:08:57,010 --> 00:08:57,970
!كنشين

104
00:09:00,470 --> 00:09:04,060
بما أنّك عدت لتصير الهيتوكيري باتّوساي
،من فترة باكوماتسو

105
00:09:04,060 --> 00:09:06,730
!فسيبدأ عرضنا الحقيقيّ الآن

106
00:09:06,730 --> 00:09:08,400
!ها أنا ذا أيّها الباتّوساي

107
00:09:12,400 --> 00:09:13,530
ما الخطب؟

108
00:09:14,950 --> 00:09:18,120
يكون الوضع مختلفًا جدًّا
.عندما تصدر منك رغبة القتل هذه

109
00:09:18,820 --> 00:09:20,990
،إن كنت تخشى على حياتك

110
00:09:20,990 --> 00:09:23,410
.حرّر الشّين نو إبّو الّتي طبّقتها على كاورو-دونو

111
00:09:23,910 --> 00:09:26,000
.ما عدتُ أستطيع ذلك

112
00:09:26,000 --> 00:09:27,540
،عليها أن تحرّر نفسها بنفسها

113
00:09:27,540 --> 00:09:30,380
.أو يجب قتل من طبّقها لقطع هالة السّيف

114
00:09:31,130 --> 00:09:33,460
.أمامك خياران

115
00:09:33,760 --> 00:09:37,680
.بالطّبع، الخيار الثّاني ممكن أكثر

116
00:09:37,930 --> 00:09:40,140
.إذًا سيكون عليّ قتلك فحسب

117
00:09:40,640 --> 00:09:42,390
.ذلك مستحيل أيضًا

118
00:09:42,770 --> 00:09:47,350
البشر مخلوقات ضعيفة بشكل
.مفاجئ في مواجهة المزاعم

119
00:09:48,310 --> 00:09:51,230
تستغلّ شين نو إبّو نقطة الضّعف تلك

120
00:09:51,230 --> 00:09:55,400
وتستعمل هالة السّيف العالية لجعل
.العدوّ ينكمش خوفًا وتُشلّ حركته

121
00:09:55,900 --> 00:09:59,910
.المزاعم تؤثّر حقًّا على جسم الإنسان

122
00:10:00,200 --> 00:10:03,740
!وأنا بصفتي مطبّق التّقنية لستُ استثناءً

123
00:10:10,630 --> 00:10:13,300
!لا... يمكن... هزيمتي

124
00:10:14,000 --> 00:10:15,460
.فهمت

125
00:10:15,460 --> 00:10:21,300
إنّه يطبّق تقنية تنويم قويّة
.على نفسه لتحرير إمكاناته

126
00:10:21,890 --> 00:10:24,720
!أنا... لا... أقهر

127
00:10:30,480 --> 00:10:33,570
!أنا... هو... الأقوى

128
00:10:35,030 --> 00:10:38,950
!شين نو إبّو: مهارة الظّلّ، تعويذة هيوكي

129
00:10:39,610 --> 00:10:44,080
هذه أوّل مرّة أستعمل فيها هذه
،التّقنية منذ تركي للشّينسنغومي

130
00:10:44,080 --> 00:10:46,080
.المرّة الأولى بعد 15 سنة

131
00:10:54,920 --> 00:10:57,420
.إنّها مهارة غير عادلة بالفعل إن بدت لك كذلك

132
00:10:58,670 --> 00:11:00,550
.لكنّي سأستعملها في كلّ الأحوال

133
00:11:01,050 --> 00:11:01,930
.لا أهتمّ

134
00:11:02,430 --> 00:11:04,720
.يمكنك استعمال أيّ مهارة تريد

135
00:11:06,060 --> 00:11:06,890
...ولكن

136
00:11:13,610 --> 00:11:15,860
...بعد أن قلتُ أنّي سأقتلك

137
00:11:17,360 --> 00:11:19,530
.صار موت حقيقة ثابتة

138
00:11:34,630 --> 00:11:37,710
.هذه وضعية هجوم باتّوجتسو

139
00:11:38,590 --> 00:11:40,380
...باتّوجتسو

140
00:11:40,380 --> 00:11:44,680
أو فنّ سحب السّيف وهي تقنية يتسارع
فيها نصل السّيف وهو يخرج من غمده

141
00:11:44,680 --> 00:11:48,520
.وتتضاعف سرعته، وقد تُثلّث عندما يُسحب

142
00:11:48,810 --> 00:11:51,810
هجوم نسبة القتل فيه مضمونة تطيح بالخصم

143
00:11:51,810 --> 00:11:54,480
.دون السّماح له بتنفيذ هجوم مضادّ

144
00:11:55,480 --> 00:12:00,990
هلّم إليّ. سأسمح لك أن تتذوّق
."لقب الشّوارع "الباتّوساي

145
00:12:01,450 --> 00:12:06,080
الباتّوساي، مستعمل أسلوب سيف هيتن
.ميتسوروغي-ريو ذو السّرعة المقدّسة

146
00:12:06,700 --> 00:12:08,620
!إنّه الأسرع بالفعل

147
00:12:09,410 --> 00:12:11,960
!ولكن بإمكاني الفوز إن تفاديتُه

148
00:12:12,540 --> 00:12:14,170
،القتل مضمون بهجمات الباتّوجتسو

149
00:12:14,170 --> 00:12:16,500
.ما يعني أنّ الإخفاق سيعني موته هو

150
00:12:16,500 --> 00:12:18,750
.سيف ذو حدّين بالفعل

151
00:12:20,590 --> 00:12:21,720
أيمكنني تفاديه؟

152
00:12:25,340 --> 00:12:27,680
!يمكنني! يمكنني بكلّ تأكيد

153
00:12:29,010 --> 00:12:32,520
!وقت العرض يا هيمورا باتّوساي

154
00:12:35,940 --> 00:12:40,150
!أيّها الباتّوساي، أنت غافل عن عيبك القاتل

155
00:12:40,320 --> 00:12:41,650
.وذاك سيفك

156
00:12:42,150 --> 00:12:44,320
!السّاكاباتو مضرّ في حالة استعمال باتّوجتسو

157
00:12:44,820 --> 00:12:47,490
،بما أنّ ظهره هو الجزء المحدّب

158
00:12:47,490 --> 00:12:49,990
،لا يمكن جعل النّصل يتسارع بما يكفي في غمده

159
00:12:49,990 --> 00:12:52,500
.ما يبطئ من سرعة سحب السّيف

160
00:12:52,660 --> 00:12:56,000
!وذلك الاختلاف فرصة مثاليّة للنّصر

161
00:12:59,670 --> 00:13:00,670
!سريع

162
00:13:00,670 --> 00:13:02,800
...لكن إن استطعتُ تفاديه

163
00:13:05,260 --> 00:13:06,510
!تفاديته

164
00:13:06,510 --> 00:13:07,930
!أنا المنتصر

165
00:13:08,140 --> 00:13:09,720
!أيّها الباتّوساي

166
00:13:13,980 --> 00:13:16,400
—ما— هذا

167
00:13:17,350 --> 00:13:21,440
!باتّوجتسو مزدوج باستعمال السّيف والغمد معًا

168
00:13:24,070 --> 00:13:27,660
:باتّوجتسو هيتن ميتسوروغي-ريو
.وميض التّنّين التّوأم

169
00:13:28,450 --> 00:13:31,620
أنا مدرك تمامًا أنّ الباتّوجتسو
سيف ذو حدّين

170
00:13:31,620 --> 00:13:34,290
.وأنّ السّاكاباتو ليس مناسبًا لهجمات الباتّوجتسو

171
00:13:34,290 --> 00:13:38,880
كوني الرّجل الّذي أتقن أقوى هجمات الباتّوجتسو

172
00:13:39,380 --> 00:13:42,210
.هو أصل حصولي على لقب الشّوارع الباتّوساي

173
00:13:43,090 --> 00:13:45,720
.حطّمت كوعك وقطعت أوتارك

174
00:13:46,590 --> 00:13:49,050
.انتهت حياتك كسيّاف

175
00:13:49,300 --> 00:13:50,640
...وهذه

176
00:13:51,810 --> 00:13:53,640
.هي نهاية حياتك

177
00:13:59,150 --> 00:14:00,020
.مت

178
00:14:00,860 --> 00:14:01,820
!كنشين

179
00:14:11,620 --> 00:14:13,240
ما الخطب أيّها الباتّوساي؟

180
00:14:13,740 --> 00:14:15,620
لماذا هذا التّردّد؟

181
00:14:16,080 --> 00:14:19,710
.عليك قتلي لتحرير الشّين نو إبّو

182
00:14:20,710 --> 00:14:22,880
.لا يجد خيار أسهل من هذا

183
00:14:23,710 --> 00:14:26,130
.النّصل الشّرّير للهيتوكيري الأسطوريّ

184
00:14:26,720 --> 00:14:30,340
.أضرب بسيفك الآن لإرسالي للحياة الآخرة

185
00:14:31,050 --> 00:14:35,470
.صحيح. لا أريد منحك أيّ شيء لتأخذه معك

186
00:14:35,930 --> 00:14:41,940
،ولكن لحماية كاورو-دونو
.عليّ العودة لأكون هيتوكيري ثانية

187
00:14:43,400 --> 00:14:44,940
!هكذا يجب أن تكون

188
00:14:44,940 --> 00:14:48,530
!دعني أنا جين-إي أتذوّق النّصل الشّرّير

189
00:14:48,650 --> 00:14:49,490
.مت

190
00:14:53,450 --> 00:14:55,200
.السّيوف أسلحة

191
00:14:55,200 --> 00:14:57,000
.المسايفة وسيلة للقتل

192
00:14:57,500 --> 00:15:01,960
لا يهمّ كم ستحاول تلطيف ذلك
.أو تبنّي مُثل عليا، فستظلّ تلك الحقيقة

193
00:15:02,710 --> 00:15:05,960
...ولكن في مواجهة حقيقة فظيعة كهذه

194
00:15:07,050 --> 00:15:11,590
.أفضّل كذبة كاورو-دونو السّاذجة أكثر

195
00:15:12,600 --> 00:15:16,060
.كنـ... شين

196
00:15:18,060 --> 00:15:19,020
!كنشين

197
00:15:20,520 --> 00:15:23,110
!إيّاك

198
00:15:26,900 --> 00:15:29,650
.لا تعد لتصير هيتوكيري

199
00:15:30,200 --> 00:15:33,620
.لا تستعمل... السّيف القاتل

200
00:15:33,950 --> 00:15:34,870
!كاورو-دونو

201
00:15:35,620 --> 00:15:38,580
!كاورو-دونو، تماسكي
هل أنت بخير رجاءً؟

202
00:15:40,080 --> 00:15:40,920
!كاورو-دونو

203
00:15:42,170 --> 00:15:45,000
.أنا بخير لو سمحت يا كنشين

204
00:15:45,000 --> 00:15:45,840
أورو؟

205
00:15:47,050 --> 00:15:50,800
.عاد أسلوب حديثك المهذّب

206
00:15:52,260 --> 00:15:53,760
.أنا بخير

207
00:15:54,390 --> 00:15:55,600
،أنا بخير تمامًا

208
00:15:55,600 --> 00:15:56,430
—لذلك رجاءً

209
00:15:58,640 --> 00:16:02,060
يمكنني فهم لماذا نجح رأس
،العصفور ذلك ليلة الأمس

210
00:16:02,060 --> 00:16:06,400
لكنّ هذه الفتاة استطاعت التّحرّر
من شين نو إبّو أيضًا؟

211
00:16:07,020 --> 00:16:10,070
.يبدو أنّه حتّى أنا فقدت حدّتي

212
00:16:11,030 --> 00:16:12,280
.إيّاك يا جين-إي

213
00:16:12,820 --> 00:16:16,870
،لديك فقط سيف واكيزاشي واحد
.ويمكنك استعمال يدك اليسرى فقط

214
00:16:16,870 --> 00:16:20,410
،لا فرصة لك بالفوز
.انتهى الأمر إن جاز لي التّعبير

215
00:16:21,040 --> 00:16:23,460
.عليك الانتظار حتّى يتمّ اعتقالك فحسب رجاءً

216
00:16:24,170 --> 00:16:26,420
.لا، لم ينتهِ الأمر بعد

217
00:16:27,130 --> 00:16:30,050
.ما زال عليّ التّعامل مع العواقب

218
00:16:37,100 --> 00:16:39,970
.هذا الشّعور... رائع

219
00:16:46,610 --> 00:16:50,320
.تـ-تبدو وكأنّك لا تفهمه

220
00:16:51,320 --> 00:16:52,740
.سبق وأخبرتك

221
00:16:53,650 --> 00:16:55,360
.هذه هي العواقب

222
00:16:56,370 --> 00:17:01,700
...إ-إن تمّ الإمساك بي واستمرّ التّحقيق

223
00:17:02,200 --> 00:17:06,130
فسيتمكّنون من تعقّب مسؤول الحكومة الإمبراطوريّ

224
00:17:06,130 --> 00:17:08,590
.الّذي طلب تعيني كهيتوكيري

225
00:17:08,590 --> 00:17:09,420
ماذا؟

226
00:17:11,050 --> 00:17:13,170
لا يُعقل أنّك قد صدّقت

227
00:17:13,170 --> 00:17:17,510
.أنّ الهيتوكيري ما عاد لهم حاجة في فترة ميجي

228
00:17:17,970 --> 00:17:20,760
.لهذا السّبب قلتُ أنّك فقدت حدّتك

229
00:17:22,310 --> 00:17:23,560
الجميع متحمّسون

230
00:17:23,560 --> 00:17:27,060
.حيال الثّورة وفترة ميجي والحكومة الجديدة

231
00:17:27,060 --> 00:17:28,440
،ولكن في الدّاخل

232
00:17:28,440 --> 00:17:32,320
هناك صراع قوّة مشابه
.لفترة باكوماتسو ما زال متواصلاً

233
00:17:33,030 --> 00:17:37,280
،يريدون التّخلّص ممّن يقفون في طريقهم

234
00:17:37,280 --> 00:17:40,990
،ولكن بسبب تحديث النّظام وتطوير قوّات الشّرطة

235
00:17:40,990 --> 00:17:44,910
.ما عاد بإمكانهم قتل النّاس بسهولة كالسّابق

236
00:17:45,460 --> 00:17:50,290
ومن جهة أخرى، لا أستطيع الهروب
،بسهولة من الطّريق الّذي سلكته

237
00:17:50,290 --> 00:17:51,800
.هذا إن كنتُ أريد تركه من الأساس

238
00:17:52,300 --> 00:17:56,470
لذلك فإنّ السّياسيّين والهيتوكيري
،لديهم اهتمام مشترك

239
00:17:56,470 --> 00:18:00,600
وهكذا وُلد قاطع الطّريق كوروغاسا
.ذو السّيف الشّرّير

240
00:18:01,680 --> 00:18:04,520
.هيتوكيري يقتل النّاس بملء إرادته

241
00:18:05,020 --> 00:18:08,520
.ولكنّه لا يختار أهدافه

242
00:18:09,100 --> 00:18:12,780
،تجاهلت ذلك وتحدّيتك

243
00:18:12,780 --> 00:18:16,150
ولهذا السّبب انتهى بي المطاف
.أموت موتًا مثيرًا للشّفقة

244
00:18:16,150 --> 00:18:17,450
.لكن لا بأس

245
00:18:18,320 --> 00:18:22,830
،بعد أن صارت ذراعي اليمنى بلا جدوى
.فلن يجلب بقائي حيًّا سوى الملل

246
00:18:23,740 --> 00:18:24,790
...جين-إي

247
00:18:25,080 --> 00:18:28,540
.كفّ عن النّظر إليّ هكذا أيّها الباتّوساي

248
00:18:28,540 --> 00:18:33,920
.بدت عيناك أفضل بكثير عندما قلتَ أنّك ستقتلني

249
00:18:35,210 --> 00:18:38,510
.طبيعتك الحقيقيّة ما زالت هيتوكيري

250
00:18:38,510 --> 00:18:41,300
،وهذا صادر من هيتوكيري آخر
.لذلك كن واثقًا من كلامي

251
00:18:42,050 --> 00:18:45,600
.يظلّ الهيتوكيري كذلك حتّى يموت

252
00:18:46,100 --> 00:18:49,310
.لا يمكنه أن يصير أيّ شيء آخر

253
00:18:49,690 --> 00:18:53,860
سأراقبك من أطراف الجحيم لأرى إلى متى

254
00:18:53,860 --> 00:18:56,780
.ستواصل وصف نفسك بروروني

255
00:19:08,540 --> 00:19:12,500
".يظلّ الهيتوكيري كذلك حتّى يموت"

256
00:19:17,340 --> 00:19:18,510
".حتّى يموت"

257
00:19:20,930 --> 00:19:22,010
.كنشين

258
00:19:23,760 --> 00:19:25,850
.لنعد للمنزل لو سمحت يا كاورو-دونو

259
00:19:26,520 --> 00:19:28,640
.هذه مشكلة الشّرطة الآن

260
00:19:29,520 --> 00:19:30,940
.لنتركها لهم

261
00:19:39,070 --> 00:19:40,030
.كنشين

262
00:19:42,320 --> 00:19:43,160
.كنشين

263
00:19:43,740 --> 00:19:45,950
ماذا هنالك لو سمحت؟

264
00:19:46,740 --> 00:19:51,250
.شكرًا على إنقاذي. سأقدّم لك شكري الآن

265
00:19:52,750 --> 00:19:56,840
.لا، أنا من عليه أن يشكرك لو سمحت

266
00:19:57,420 --> 00:19:58,550
.لك كلّ امتناني

267
00:19:58,550 --> 00:19:59,800
...ماذا؟ لكن

268
00:19:59,800 --> 00:20:01,180
.لا مشكلة

269
00:20:02,680 --> 00:20:05,720
،لو لم توقفيني وقتها

270
00:20:06,220 --> 00:20:09,600
.لكنتُ قد عدت لأصير هيتوكيري باتّوساي بالكامل

271
00:20:12,390 --> 00:20:13,560
...بالمناسبة

272
00:20:13,560 --> 00:20:16,690
.عليّ أن أعيد شريطك النّيليّ رجاءً

273
00:20:16,690 --> 00:20:17,530
!صحيح

274
00:20:19,150 --> 00:20:20,280
أورو؟

275
00:20:20,650 --> 00:20:22,450
!ما هذا؟ إنّ الدّماء تغطّيه

276
00:20:22,910 --> 00:20:26,490
فهمت. إنّها دماء من إصابة كتفي الأيسر

277
00:20:26,490 --> 00:20:28,660
.وسالة حتّى وصلت جيبَ صدري

278
00:20:28,660 --> 00:20:30,250
ماذا ستفعل حيال هذا؟

279
00:20:30,250 --> 00:20:32,040
.كان من المستحيل تفادي ذلك رجاءً

280
00:20:32,210 --> 00:20:34,380
!كم هذا فظيع! لن أسامحك

281
00:20:35,420 --> 00:20:36,250
!كنشين

282
00:20:36,840 --> 00:20:38,800
!انتظر

283
00:20:42,840 --> 00:20:47,100
جين-إي، يمكنك على الأقلّ
.المشاهدة من أطراف الجحيم رجاءً

284
00:20:48,220 --> 00:20:51,020
حتّى إن كانت طبيعتي الحقيقيّة
...هي أنّي هيتوكيري

285
00:20:51,640 --> 00:20:53,770
.فسأكبحها لبقيّة حياتي

286
00:20:54,940 --> 00:20:58,980
.لن أعود أبدًا لأكون هيتوكيري باتّوساي

287
00:21:05,660 --> 00:21:10,120
.أنا روروني يرفض القتل حتّى أموت

288
00:21:11,120 --> 00:21:12,120
.لقد عدنا

289
00:21:12,790 --> 00:21:14,000
.لو سمحتم

290
00:22:46,050 --> 00:22:48,590
."في الحلقة القادمة: "حسناء هاربة