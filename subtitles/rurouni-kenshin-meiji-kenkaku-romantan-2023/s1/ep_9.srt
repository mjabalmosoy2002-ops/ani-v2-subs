1
00:00:07,490 --> 00:00:09,480
.لا بدّ أنّكم الأونيوابانشو

2
00:00:09,860 --> 00:00:12,280
.الأشهر بين الأونيوابانشو

3
00:00:12,280 --> 00:00:14,990
!أنا هو المدعوّ هيوتّوكو

4
00:00:15,160 --> 00:00:16,620
هيوتّوكو؟

5
00:00:16,620 --> 00:00:18,620
.يبدو اسمًا ظريفًا لشخص مثلك

6
00:00:18,620 --> 00:00:19,830
.أنصحك بتغييره

7
00:00:21,000 --> 00:00:23,330
.سلّماني ميغومي بكلّ هدوء

8
00:00:23,330 --> 00:00:26,290
.ربّما قد أتساهل معكما إن فعلتما ذلك

9
00:00:26,790 --> 00:00:28,790
بمن سأبدأ بينكما؟

10
00:00:28,790 --> 00:00:31,630
.لا أهتمّ إن هاجمتماني معًا دفعة واحدة

11
00:00:31,840 --> 00:00:34,550
.واضح أنّ قويّ جدًّا ويقاتل بدون أسلحة

12
00:00:35,050 --> 00:00:36,590
.دع هذا الأمر لي

13
00:00:36,840 --> 00:00:38,890
.ولكنّنا نواجه الأونيوابانشو

14
00:00:39,310 --> 00:00:41,560
من يدري إن كان هذا كلّ ما لديه؟

15
00:00:41,560 --> 00:00:43,480
لا أهتم! سأمسك به حيًّا

16
00:00:43,480 --> 00:00:45,520
!وأحبره على قول الحقيقة عن الأفيون

17
00:00:45,520 --> 00:00:47,650
.أنت الأوّل إذًا

18
00:00:51,150 --> 00:00:54,990
قوّتك الغاشمة لا شيء
.إن لم تستطع إصابة هدفك

19
00:00:56,360 --> 00:00:58,030
...يا لكرمك

20
00:00:58,410 --> 00:01:01,490
.بقدومك لمداي من تلقاء نفسك

21
00:01:03,450 --> 00:01:04,790
!سونو

22
00:01:06,000 --> 00:01:07,080
—ما

23
00:02:43,140 --> 00:02:43,970
!سانو

24
00:02:45,180 --> 00:02:46,060
—ما

25
00:02:46,810 --> 00:02:47,640
!سانوسكي

26
00:02:53,190 --> 00:02:55,400
!كان ذلك خطيرًا أيّها المغفّل

27
00:02:56,360 --> 00:03:01,200
.لقد تفاجأت من تفاديك لتقنية نفَس اللّهب خاصّتي

28
00:03:01,200 --> 00:03:05,030
ولكن، لن تتمكّن من تفادي الهجوم
.التّالي بساقك تلك

29
00:03:08,080 --> 00:03:10,620
إنّه ينفث النّار باستعمال كيس
زيت وُضع داخل بطنه

30
00:03:10,620 --> 00:03:12,460
.وباستعمال أسنانه كفتيل

31
00:03:12,460 --> 00:03:14,750
.مستعمل النّار الأعظم في الأونيوابانشو

32
00:03:15,000 --> 00:03:18,090
اسمه هيوتّوكو يُكتب في الأصل
."بالكانجي كـ"رجل النّار

33
00:03:18,090 --> 00:03:20,010
!لا يوجد ما لا يستطيع حرقه

34
00:03:24,430 --> 00:03:25,470
.ها أنا ذا

35
00:03:28,470 --> 00:03:30,060
لماذا تنظر بعيدًا؟

36
00:03:30,060 --> 00:03:32,140
.أنا خصمك لو سمحت

37
00:03:33,100 --> 00:03:35,480
.سيحين دورك بعده

38
00:03:35,650 --> 00:03:38,820
.لا تقلق. ستحترق أنت التّالي بلهيبي

39
00:03:39,030 --> 00:03:40,900
ما كان عرض شوارع كهذا

40
00:03:40,900 --> 00:03:43,700
.أن يستطيع حرق ولو شعرة منّي لو سمحت

41
00:03:43,950 --> 00:03:46,870
هـ-هل وصفت هذا بعرض شوارع؟

42
00:03:50,960 --> 00:03:54,290
!قطع النّار بالسّاكاباتو خاصّته

43
00:03:59,000 --> 00:04:02,550
أيّها الغبيّ! لا تظنّ أنّ بإمكانك
!صدّ كلّ شيء بسيف واحد

44
00:04:05,800 --> 00:04:06,850
إلى أين تذهبين؟

45
00:04:07,970 --> 00:04:11,020
.يقاتل كنشين من أجلك

46
00:04:11,520 --> 00:04:14,350
.يجدر بك مشاهدة كلّ ما يحدث خارجًا كما يجب

47
00:04:15,230 --> 00:04:17,400
.إنّه ليس خصمًا يستطيع سيّاف الفوز في مواجهته

48
00:04:17,900 --> 00:04:19,570
،بإمكانه توفير الوقت

49
00:04:19,570 --> 00:04:22,240
لكنّه يواجه أونميتسو متوسّط
.الرّتبة من الأونيوابانشو

50
00:04:22,650 --> 00:04:25,110
.إنّه لا يشبه الأونميتسو متدنّي الرّتبة بشيمي ذاك

51
00:04:25,870 --> 00:04:26,870
!بل سينتصر

52
00:04:28,330 --> 00:04:30,120
.لا تعرفين شيئًا عن كنشين

53
00:04:30,740 --> 00:04:34,170
.قد يكون سيّافًا، لكنّه ليس سيّافًا عاديًّا

54
00:04:36,420 --> 00:04:39,300
مستحيل. نفد مخزوني مع أنّه كان
لديّ تسعة لترات من الزّيت؟

55
00:04:40,590 --> 00:04:41,960
.لهذا السّبب قلتُ لك

56
00:04:42,510 --> 00:04:44,930
.لا تستطيع حرق ولو شعرة من رأسي

57
00:04:46,390 --> 00:04:49,010
.صدّ كلّ تلك النّيران بسيف واحد

58
00:04:49,430 --> 00:04:51,970
!إنّه ليس سيّافًا عاديًّا بالفعل

59
00:04:52,730 --> 00:04:54,770
ما هذا الرّجل يا ترى؟

60
00:04:57,400 --> 00:04:58,690
.اللّعنة عليك

61
00:04:58,690 --> 00:05:00,610
!لم أنتهِ بعد

62
00:05:00,860 --> 00:05:02,490
!إنّه ينوي إعادة تزويد نفسه بالزّيت

63
00:05:04,490 --> 00:05:05,320
!سانو

64
00:05:05,780 --> 00:05:07,780
.شكرًا على المساعدة

65
00:05:08,200 --> 00:05:10,990
.لكن أنا من سيتولّى أمره

66
00:05:11,740 --> 00:05:14,460
!آسف، لكنّي سأبدأ هذا القتال من البداية

67
00:05:16,830 --> 00:05:19,920
.مفهوم. سأترك الباقي لك إذًا لو سمحت

68
00:05:20,170 --> 00:05:22,130
!نعم، اعتمد عليّ

69
00:05:22,130 --> 00:05:25,470
مهلاً! لماذا تتظاهران بالقوّة هكذا؟

70
00:05:25,720 --> 00:05:27,590
.أعدت ملء خزّاني

71
00:05:27,590 --> 00:05:32,770
.أنت مجرّد أحمق يهيم ضائعًا حتّى تحترق

72
00:05:32,770 --> 00:05:34,600
.لا، أنت الأحمق

73
00:05:35,480 --> 00:05:39,400
تعتقد أنّ خدعة سحريّة كهذه ستنفعك
مرّة أخرى بعد انكشاف سرّك؟

74
00:05:40,480 --> 00:05:42,110
!ستلتهمك نيراني

75
00:05:42,110 --> 00:05:44,400
وكلّ من يصف تقنيتي هذه الّذي أفخر بها

76
00:05:44,400 --> 00:05:48,660
!بعرض الشّوارع أو خدعة سحريّة سيتحوّل إلى رماد

77
00:05:48,660 --> 00:05:50,120
!نفَس اللّهيب الأقصى

78
00:05:51,280 --> 00:05:54,700
!لن تتمكّن من تفاديها هذه المرّة

79
00:05:54,950 --> 00:05:57,460
!لا تستخفّ بي

80
00:05:57,460 --> 00:05:58,210
ماذا؟

81
00:06:00,670 --> 00:06:02,340
.يا له من متهوّر

82
00:06:02,340 --> 00:06:05,550
هذا بالضّبط ما يعنيه العثور
.على مخرج من وضع مميت

83
00:06:05,760 --> 00:06:08,380
!سألقي نظرة للسّرّ خلف خدعتك السّحريّة

84
00:06:10,340 --> 00:06:13,720
.وصفته بمصدر فخرك مع أنّه سرّ قذر ووضع

85
00:06:15,020 --> 00:06:17,100
.لا فرصة أمامك للفوز الآن

86
00:06:17,430 --> 00:06:19,190
.أحسن التّصرّف واستسلم فحسب

87
00:06:20,560 --> 00:06:21,690
.غبيّ

88
00:06:22,570 --> 00:06:25,320
!أنت من لا فرص له للفوز

89
00:06:25,320 --> 00:06:29,740
لن تستطيع أن تلكم كما السّابق
!بذراعك المحترقة تلك

90
00:06:30,030 --> 00:06:34,240
!خذ قبضتي الملتهبة الّتي تشتعل كنار حقيقيّة

91
00:06:36,660 --> 00:06:39,500
.الرّكلات مشروعة تمامًا في القتالات

92
00:06:39,500 --> 00:06:43,670
،ولكن بساقيك القصيرتين هاتين
.لن تخطر تلك الفكرة في بالك أبدًا

93
00:06:48,220 --> 00:06:49,220
!فوز سهل

94
00:06:50,340 --> 00:06:53,430
.هذا ما تقوله، لكنّك مصاب بشدّة

95
00:06:53,430 --> 00:06:54,890
ماذا قلت؟

96
00:06:54,890 --> 00:06:59,390
.لقد فاز. إنّه قويّ بالرّغم من كلّ شيء

97
00:06:59,980 --> 00:07:02,730
.إنّهما أكثر من قويّين

98
00:07:02,730 --> 00:07:05,020
ما هذان الرّجلان؟

99
00:07:05,020 --> 00:07:08,570
!أخبرتك، لم يكن عليك قول أيّ من ذلك

100
00:07:05,270 --> 00:07:07,690
.أخبرتك. أنت لا تعرفينهما

101
00:07:08,570 --> 00:07:11,360
.على مهلك -
!لا تقل لي تمهّل بعد كلّ ذلك -

102
00:07:08,570 --> 00:07:12,450
.إنّهما صديقان يُعتمد عليهما وصدر فخر

103
00:07:12,280 --> 00:07:13,870
!كفّ عن الضّحك

104
00:07:13,870 --> 00:07:15,240
هل أنتما بخير؟

105
00:07:16,290 --> 00:07:18,330
.أنت مصاب بشدّة بالفعل

106
00:07:18,330 --> 00:07:20,080
.يبدو أنّك بالكاد استطعت الفوز

107
00:07:20,370 --> 00:07:21,500
أليس كذلك؟

108
00:07:21,500 --> 00:07:23,040
ماذا قلت؟

109
00:07:23,420 --> 00:07:26,800
!كان ذلك فوزًا سهلاً مهما نظرت إليه! سُحقًا

110
00:07:23,830 --> 00:07:25,340
.على مهلك -
.يا إلهي -

111
00:07:25,340 --> 00:07:27,300
مهلاً. أورو؟

112
00:07:27,300 --> 00:07:28,380
.أصدقاء

113
00:07:30,220 --> 00:07:32,510
ماذا سنفعل به الآن؟

114
00:07:32,510 --> 00:07:35,350
.صحيح. يمكننا سكب الماء عليه

115
00:07:37,180 --> 00:07:38,890
.سُحقًا. سُحقًا

116
00:07:38,890 --> 00:07:41,770
.سمح هيوتّوكو لنفسه أن يُهزم بسهولة

117
00:07:41,980 --> 00:07:45,270
.سيقودنا هذا إلى فشل آخر

118
00:07:46,900 --> 00:07:47,730
.كلاّ

119
00:07:48,360 --> 00:07:50,610
!كلّ هذا بسبب تاكاني ميغومي

120
00:07:50,610 --> 00:07:52,610
،لو لم تهربي تحت مسؤوليّتي

121
00:07:52,610 --> 00:07:54,660
!ما كان هذا ليحدث

122
00:07:54,660 --> 00:07:59,410
إنّ من أقحمني في هذا الوضع
!لن يفلت منّي سالمًا أبدًا

123
00:08:00,580 --> 00:08:01,660
!سأقتلك

124
00:08:02,410 --> 00:08:03,370
!رغبة بالقتل

125
00:08:03,580 --> 00:08:06,210
!كونوا حذرين! ما زال هنالك مترصّد في الجوار

126
00:08:06,750 --> 00:08:08,380
!هناك -
!موتي -

127
00:08:11,550 --> 00:08:12,380
!انتبهي

128
00:08:13,760 --> 00:08:14,760
ماذا؟

129
00:08:15,800 --> 00:08:16,720
!ياهيكو

130
00:08:17,050 --> 00:08:19,310
!يا إلهي، أنت متهوّر بالفعل

131
00:08:19,310 --> 00:08:20,470
.هذا مؤلم

132
00:08:20,470 --> 00:08:22,430
!الوضع خطير، لذلك عليك التّراجع

133
00:08:22,770 --> 00:08:24,440
!لا تمزحي معي

134
00:08:24,440 --> 00:08:28,270
لا أفهم أبدًا، لكنّ كنشين وسانوسكي
يحميان هذه المرأة، صحيح؟

135
00:08:28,520 --> 00:08:30,860
!أنا جزء من فريق كنشين أيضًا

136
00:08:30,860 --> 00:08:34,410
حتّى إن لم أستطع الهجوم، أستطيع
!القيام بعمل ممتاز بالدّفاع

137
00:08:34,950 --> 00:08:37,240
...عليك أن تؤمني أكثر بتلاميذك

138
00:08:39,990 --> 00:08:41,000
!ياهيكو

139
00:08:41,870 --> 00:08:42,710
.هذا سيّئ

140
00:08:43,580 --> 00:08:44,670
!سمّ

141
00:08:46,040 --> 00:08:47,960
!هذا ما يستحقّه لأنّه أقحم أنفه في الأمر

142
00:08:47,960 --> 00:08:50,380
!لن يعيش ذلك الفتى لأكثر من ساعة

143
00:08:50,840 --> 00:08:52,630
.السّهام الدّوّارة السّامّة

144
00:08:52,630 --> 00:08:56,720
!هذه هي تقنية بشيمي من الأونيوابانشو الحقيقيّة

145
00:08:56,930 --> 00:08:58,930
...أنت التّالي أيّها الأصهـ

146
00:09:11,400 --> 00:09:12,690
.إنّه موهوب

147
00:09:12,690 --> 00:09:13,900
!كنشين

148
00:09:14,200 --> 00:09:16,320
...ياهيكو... إنّ ياهيكو

149
00:09:16,530 --> 00:09:18,780
!ياهيكو، تبًّا! تماسك

150
00:09:19,240 --> 00:09:21,990
!ياهيكو

151
00:09:29,790 --> 00:09:30,750
!ياهيكو

152
00:09:36,590 --> 00:09:39,930
،يكفي. حتّى إن واصلنا القتال

153
00:09:39,930 --> 00:09:42,560
أشعر أنّه من المستحيل لنا
.أن نستعيد تاكاني ميغومي

154
00:09:42,930 --> 00:09:45,730
أنا أيضًا أريد حمل رفيقيّ اللّذين سقطا

155
00:09:45,730 --> 00:09:48,940
.وأبلّغ زعيمي بالأمر في أسرع وقت ممكن

156
00:09:49,770 --> 00:09:53,440
.أنتم من بدأتم الهجوم. لن أقف في طريقك

157
00:09:53,440 --> 00:09:57,990
ولكن، ستترك الأصغر حجمًا هنا لنحصل
.منه على ترياق للسّمّ من أجل ياهيكو

158
00:09:58,320 --> 00:10:00,950
.لسنا مجبرين على القيام بذلك من أجل العدوّ

159
00:10:01,280 --> 00:10:03,870
.سأرغمك على تركه هنا في تلك الحالة بأيّ ثمن

160
00:10:06,750 --> 00:10:10,670
.أنت شغوف جدًّا رغم مظهرك الهادئ هذا

161
00:10:14,800 --> 00:10:16,260
.لا داعي للقلق

162
00:10:16,260 --> 00:10:20,260
سنتقاتل في مرحلة ما ما دمتم
.تجيرون تاكاني ميغومي عندكم

163
00:10:20,760 --> 00:10:23,260
.سيتأجّل النّزال حتّى ذلك الحين

164
00:10:25,060 --> 00:10:29,350
حسب طريقة تحرّكه، فهو خبير
!كنبو تدرّب بشدّة فائقة

165
00:10:30,310 --> 00:10:32,060
...كنشين! إنّ ياهيكو

166
00:10:32,610 --> 00:10:33,610
!ياهيكو

167
00:10:35,650 --> 00:10:36,490
كيف حاله؟

168
00:10:37,110 --> 00:10:40,200
لديّ خبرة في علاج إصابات السّيوف
،والرّماح أو العظام المكسورة

169
00:10:40,200 --> 00:10:41,700
...أمّا علاج السّمّ

170
00:10:42,160 --> 00:10:44,830
.على أيّ حال، بإمكاننا مصّ السّمّ من الجرح

171
00:10:44,830 --> 00:10:45,740
!مفهوم

172
00:10:45,740 --> 00:10:46,580
.توقّفي

173
00:10:48,910 --> 00:10:51,130
هل تقترحين أن أشاهد ياهيكو وهو يموت فحسب؟

174
00:10:51,130 --> 00:10:52,130
!لا تتدخّلي في الأمر

175
00:10:52,130 --> 00:10:53,210
!حمقاء

176
00:10:53,210 --> 00:10:56,760
،مصّ السّمّ من الجرح قد يسبّب التهابات بكتيريّة

177
00:10:56,760 --> 00:10:58,010
!لذلك ستزيدين الأمر سوءًا لا غير

178
00:10:58,420 --> 00:11:00,970
!هذا ليس مكانًا للهواة. تراجعوا

179
00:11:03,640 --> 00:11:05,680
...حمّى خفيفة وفقدان وعي

180
00:11:05,680 --> 00:11:10,390
وألم طفيف وتوسّع في البؤبؤ
...فوق ذلك. إنّ هذا

181
00:11:10,730 --> 00:11:12,400
.سمّ ورقة تفّاح الشّيطان

182
00:11:12,900 --> 00:11:16,980
يا آنسة، لا بدّ أنّ لديك طبيبًا خاصًّا بالدّوجو، صحيح؟

183
00:11:17,150 --> 00:11:19,780
،سأكتب لك لائحة أدوية
!لذلك اطلبي منه إحضارها

184
00:11:19,950 --> 00:11:23,450
كن-سان، اغلِ بعض الماء! وجهّز بعض
!المناشف اليدويّة والأدوية الّتي هنا

185
00:11:23,950 --> 00:11:26,950
وأنت، اذهب إلى متجر الثّلج
!واشتر منهم كلّ الثّلج الّذي لديهم

186
00:11:27,290 --> 00:11:30,370
!علاج إزالة السّمّ سباق ضدّ الوقت
!تحرّكوا بسرعة

187
00:11:33,630 --> 00:11:35,840
.حسنًا. سيفي هذا بالغرض

188
00:11:36,420 --> 00:11:39,550
.سيستعيد عافته بعد ثلاثة أو أربعة أيّام

189
00:11:39,800 --> 00:11:42,550
.حمدًا على هذا يا ياهيكو

190
00:11:42,550 --> 00:11:45,010
.هذا إن ارتاح بكلّ هدوء

191
00:11:45,720 --> 00:11:47,390
.شكرًا أيّها العجوز

192
00:11:47,390 --> 00:11:49,350
.أنت مذهل بالفعل

193
00:11:49,350 --> 00:11:51,690
.لا يبدو أنّك تشكرني على الإطلاق

194
00:11:52,020 --> 00:11:55,190
،إن أردتم أن تشكروا أحدًا ما
.فاشكروا من كتب هذه

195
00:11:55,440 --> 00:11:56,980
.عمل مذهل

196
00:11:56,980 --> 00:12:01,070
لائحة مثاليّة من المكوّنات
.وتعليمات مركّبة لصنع التّرياق

197
00:12:01,860 --> 00:12:05,070
،إن من كتبها متمرّس جدًّا في الدّراسات الهولنديّة

198
00:12:05,070 --> 00:12:08,700
.وهو ما يوصف في هذه الأيّام بالطّبّ الغربيّ

199
00:12:08,700 --> 00:12:12,120
ربّما من كتبها يعرف الكثير عن السّموم فحسب؟

200
00:12:12,120 --> 00:12:14,830
.الخطّ بين السّمّ والدّواء رفيع للغاية

201
00:12:14,830 --> 00:12:19,000
يمكن صناعة دواء ممتاز من أوراق تفّاح
.الشّيطان حسب طريقة الاستعمال

202
00:12:19,300 --> 00:12:25,220
،إنّ من كتبها هو خبير متمرّس
.وفي عقاقير الطّبّ الغربيّ على الخصوص

203
00:12:25,430 --> 00:12:27,140
.فاجأني هذا

204
00:12:27,140 --> 00:12:29,930
.ظننتُ أنّها مجرّد امرأة لئيمة الطّباع

205
00:12:30,140 --> 00:12:31,600
امرأة؟

206
00:12:31,600 --> 00:12:33,850
أيعقل أنّك تقصدين تاكاني ميغومي؟

207
00:12:34,690 --> 00:12:36,060
أتعرفها؟

208
00:12:36,560 --> 00:12:43,360
كانت تاكاني ميغومي مساعِدة
.لطبيب معيّن قُتل قبل ثلاث سنوات

209
00:12:49,030 --> 00:12:50,540
إلى أين تذهبين رجاءً؟

210
00:12:51,500 --> 00:12:54,210
من الخطير على امرأة أن تسير
.وحدها في اللّيل لو سمحت

211
00:12:54,620 --> 00:12:57,130
.لا ينفكّ هذا الرّجل يفاجئني

212
00:12:58,420 --> 00:13:00,800
ألا يجدر بك أن تظلّ إلى جانب الفتى؟

213
00:13:01,170 --> 00:13:05,720
لا بأس. ياهيكو فتى مثابر جدًّا على عكس
.ما يبدو عليه ول سمحت

214
00:13:06,180 --> 00:13:07,760
.شكرًا جزيلاً لك على علاجه

215
00:13:08,260 --> 00:13:10,560
.اسمحي لي أن أشكرك بدلاً من ياهيكو

216
00:13:10,890 --> 00:13:12,770
.لا داعي لذلك

217
00:13:12,770 --> 00:13:14,730
.بشيمي يستهدفني

218
00:13:15,480 --> 00:13:17,900
إلى أين كنت ذاهبة رجاءً؟

219
00:13:18,400 --> 00:13:20,230
.ولا يسمح لي بتغيير الموضوع

220
00:13:20,820 --> 00:13:22,650
.كبداية، سأغادر طوكيو

221
00:13:23,150 --> 00:13:25,910
.يمكنك الاطمئنان، سيختفي هذ الإزعاج بسرعة

222
00:13:26,410 --> 00:13:28,450
إذًا لا أحد في مسقط رأسك في أيزو

223
00:13:28,450 --> 00:13:30,660
ينتظر عودتك للمنزل، إن جاز لي السّؤال؟

224
00:13:31,990 --> 00:13:36,870
"كيفية نطقك لكلمة "إزعاج
.شائعة لدى ساكني منطقة أيزو

225
00:13:37,290 --> 00:13:42,340
قاتلتُ ضدّ ساموراي من أيزو مرّات
،عديدة في طوكيو فترةِ باكوماتسو

226
00:13:42,340 --> 00:13:43,920
.لذلك لم تخفَ عنّي اللّهجة

227
00:13:46,340 --> 00:13:49,390
.إنّك تفاجئني مرارًا وتكرارًا

228
00:13:50,760 --> 00:13:55,020
هل يمكنك إخبارنا الحقيقة قريبًا رجاءً؟

229
00:13:56,440 --> 00:14:02,020
كان آل تاكاني من منطقة أيزو
.عائلة مشهورة ضمن الأطبّاء

230
00:14:02,860 --> 00:14:08,030
كان آل تاكاني غير عاديّين بحث
.حتّى النّساء والأطفال تعلّموا الطّبّ

231
00:14:08,280 --> 00:14:11,450
،رغم المكانة العالية الّتي يتمتّع بها طبيب الشّوغن

232
00:14:11,450 --> 00:14:15,750
إلاّ أنّ أيّ شخص مريض كان يُعالج بتفانٍ
.بغضّ النّظر عن وضعه الاجتماعيّ

233
00:14:17,250 --> 00:14:21,670
وفي نظر أولئك من طبقة السّاموراي
،الّذين يؤمنون بشدّة بنظام الطّبقات

234
00:14:21,670 --> 00:14:23,840
.كانوا مجرّد حقيرين

235
00:14:23,840 --> 00:14:27,260
،ولكن بالنّسبة لنا نحن الأطبّاء
.كانوا تجسيدًا لمُثُلنا

236
00:14:28,010 --> 00:14:32,260
،ومن بينهم، اعتلى تاكاني ريوسي
.والد ميغومي-سان، القمّة

237
00:14:32,720 --> 00:14:36,850
صار بلا سيّد بمجرّد أن علم بمدى
،فائدة الدّراسات الهولنديّة

238
00:14:36,850 --> 00:14:40,310
.وأخذ عائلته بالكامل للتّعلّم في ناغاساكي

239
00:14:40,860 --> 00:14:43,860
لا يمكن لليافعين في هذه الأيّام أن يفهموا

240
00:14:43,860 --> 00:14:47,320
.مقدار العزم الّذي كان ليحتاجه المرء ليصير بلا سيد

241
00:14:47,820 --> 00:14:53,330
عادت عائلة تاكاني إلى أيزو بعد
،حصولها على إعفاء خاصّ

242
00:14:53,330 --> 00:14:55,700
.لكنّ معركة أيزو نشبت في نفس الوقت أيضًا

243
00:14:56,700 --> 00:15:01,500
،كانت معركة أيزو المعركة الرّابعة في حرب بوشين

244
00:15:01,500 --> 00:15:04,500
.حدث بين عشيرة أيزو وجيش الحكومة الإمبراطوريّ

245
00:15:05,050 --> 00:15:08,090
،استخدمت عشيرة أيزو الجميع
،رجالاً ونساءً، صغارًا وكبارًا

246
00:15:08,090 --> 00:15:09,590
.حتّى أنّها حاصرت قلعتهم

247
00:15:09,590 --> 00:15:14,470
.ولكن استسلموا في 22 سبتمبر 1868

248
00:15:14,470 --> 00:15:20,560
وبما أنّ عشيرة أيزو قامت بحماية كيوتو
،قبل الثّورة واعتقلت المناصرين الإمبراطوريّين

249
00:15:20,560 --> 00:15:24,860
تمّ اضطهاد أفراد العشيرة من طرف الشّرطة

250
00:15:24,860 --> 00:15:28,070
.لسنوات طويلة مذّاك الحين

251
00:15:28,740 --> 00:15:34,240
توجّهت عائلة تاكاني جميعها إلى الحرب
.تاركة خلفها ميغومي-سان الصّغيرة

252
00:15:34,240 --> 00:15:36,290
.ومات ريوسي في المعركة نتيجة لذلك

253
00:15:36,290 --> 00:15:40,080
فُقدت أمّها إلى جانب أخويها
.الأكبر في نيران المعركة

254
00:15:40,660 --> 00:15:45,210
.صارت ميغومي-سان وحيدة مذّاك الحين

255
00:15:46,800 --> 00:15:51,720
انتقلت إلى طوكيو قبل خمس سنوات
.وأصبحت مساعدة لطبيب ما

256
00:15:52,260 --> 00:15:56,930
.كان من معارفي، وهكذا عرفت بشأن ميغومي

257
00:15:57,220 --> 00:16:03,900
،قُتل ذلك الطّبيب قبل ثلاث سنوات
.واختفت هي في نفس ذلك الوقت

258
00:16:04,650 --> 00:16:06,900
.أودّ بشدّة أن ألتقي بميغومي

259
00:16:06,900 --> 00:16:08,360
أين هي الآن؟

260
00:16:08,610 --> 00:16:12,820
،ماذا؟ بالتّفكير في الأمر
!لم أرها منذ مدّة الآن

261
00:16:12,820 --> 00:16:15,910
...كلاّ. هل يعقل أنّها قد

262
00:16:17,030 --> 00:16:20,660
لم أكن شخصًا يحسن الحكم
.على النّاس قبل خمس سنوات

263
00:16:21,250 --> 00:16:23,960
.كانت لذلك الطّبيب علاقات مع كانريو

264
00:16:24,790 --> 00:16:29,000
صقل الطّبيب مكوّنات الأفيون
،الّتي اشتراها كانريو بثمن رخيص

265
00:16:29,000 --> 00:16:30,920
.ثمّ باع كانريو بعدها المخدّر المحسّن

266
00:16:31,340 --> 00:16:33,470
...هكذا كانت تسير الأمر بشكل جيّد لهم

267
00:16:34,300 --> 00:16:36,720
.حتّى ابتكر الطّبيب هذا

268
00:16:37,640 --> 00:16:39,100
.إنّه يُدعى شبكة العنكبوت

269
00:16:39,770 --> 00:16:41,310
إنّ عملية صقله الخاصّة

270
00:16:41,310 --> 00:16:44,940
،تتطلّب فقط نصف المكوّنات
.ولكنّها تضاعف الرّغبة لتعاطيها

271
00:16:45,440 --> 00:16:47,310
.ما يعني أنّ الأرباح تضاعفت أربع مرّات

272
00:16:47,900 --> 00:16:52,240
إن انتشر، فإنّ كلّ طوكيو قد تصير مدمنة
.على الأفيون خلال خمس سنوات فقط

273
00:16:54,410 --> 00:16:57,530
وحاول الحصول على عمليّة صقل
.المكوّنات من الطّبيب

274
00:16:58,030 --> 00:17:01,450
،لكن لم يتفوّه الطّبيب بأيّ كلمة
.محاولاً احتكار الأرباح

275
00:17:02,040 --> 00:17:04,040
،حدث شجار بينهم جرّاء ذلك

276
00:17:04,040 --> 00:17:07,080
.وقتل رجال كانريو الطّبيب عن طريق الخطأ

277
00:17:07,420 --> 00:17:11,670
وأنا، الّتي كنتُ الوحيدة الّتي تعرف كيف
،تصقل المكوّنات بصفتي مساعدته

278
00:17:11,670 --> 00:17:13,760
.أُجبرت على صناعته

279
00:17:15,630 --> 00:17:18,640
وعندما عرفت أنّ ما كنت أصنعه

280
00:17:18,640 --> 00:17:21,600
،لم يكن دواءً ينقذ النّاس، بل العكس

281
00:17:21,600 --> 00:17:23,230
.فكّرت في الموت

282
00:17:24,100 --> 00:17:26,730
.لكنّي لم أنجح في قتل نفسي

283
00:17:28,520 --> 00:17:33,110
،إن عشت وزدت معرفتي بالأدوية
فقد يلتمّ شملي يومًا ما

284
00:17:33,110 --> 00:17:36,820
.بأمّي وأخوَيّ الّذين انفصلت عنهم

285
00:17:37,620 --> 00:17:42,950
وواصلت صناعة المخدّر الّذي دفع النّاس
.لموتهم لثلاث سنوات وأنا أفكّر في ذلك

286
00:17:47,290 --> 00:17:49,630
إذًا يا ميغومي-دونو، سبب ملاحقة كانريو لك

287
00:17:49,920 --> 00:17:53,960
هو أنّ لا أحد غيرك يعرف كيف يصقل
المخدّر ليومنا هذا، صحيح؟

288
00:17:59,800 --> 00:18:01,930
لم تتخلّي أبدًا عن شعورك بالذّنب

289
00:18:01,930 --> 00:18:04,980
وقرّرت تحمّل كلّ هذا العبء وحدك، صحيح؟

290
00:18:06,270 --> 00:18:09,480
،إذا كنت تتألّمين هكذا لمدّة ثلاث سنوات

291
00:18:09,480 --> 00:18:12,860
.فقد حان الوقت ليُغفر لك وتتحرّري رجاءً

292
00:18:14,280 --> 00:18:15,110
...كن-سان

293
00:18:16,240 --> 00:18:19,200
.من المستحيل أن يتراجعوا بهذه السّهولة

294
00:18:19,530 --> 00:18:22,410
من الأفضل أن تظلّي في الدّوجو
.لبعض الوقت لو سمحت

295
00:18:22,620 --> 00:18:23,870
...لكن

296
00:18:23,870 --> 00:18:26,000
لا تمانعين ذلك، صحيح يا كاورو-دونو؟

297
00:18:35,170 --> 00:18:38,930
.لا بأس. أعرف كم من الصّعب أن يكون المرء وحيدًا

298
00:18:39,760 --> 00:18:43,220
.لكاني حالي مثل حالك دون وجود كنشين

299
00:18:43,970 --> 00:18:47,270
...والآن، بشأن كيفية تعاملنا مع جماعة كانريو

300
00:18:49,060 --> 00:18:52,570
.ولكن من الأفضل ألاّ تحاولي التّقرّب من كنشين

301
00:18:52,570 --> 00:18:55,360
.سألقيك في الشّارع بلا رحمة إن حدث ذلك

302
00:19:03,410 --> 00:19:07,960
هكذا إذًا. سيكون بشيمي وهيوتّوكو
.بلا فائدة لبعض الوقت

303
00:19:08,460 --> 00:19:09,370
.نعم

304
00:19:09,540 --> 00:19:10,880
...إذًا يا هانيا

305
00:19:11,580 --> 00:19:13,040
ماذا عن إصاباتك أنت؟

306
00:19:13,540 --> 00:19:15,880
.نعم، ولكن بالكاد

307
00:19:16,550 --> 00:19:21,140
.لم يكن ذلك الرّجل رجلاً عاديًّا كما ذكرت يا زعيم

308
00:19:21,430 --> 00:19:24,850
لم أتوقّع منه أن يتصدّى لهجومي

309
00:19:24,850 --> 00:19:30,190
واستعمل ردّة الفعل ليصيب
.نقطة حيويّة في كبدي

310
00:19:31,230 --> 00:19:32,270
أيمكنك التّحرّك؟

311
00:19:32,480 --> 00:19:35,270
،لا أستطيع القتال ليومين أو ثلاثة

312
00:19:35,270 --> 00:19:36,780
...ولكن أستطيع التّجسّس

313
00:19:37,280 --> 00:19:40,610
حسنًا. اكتشف كلّ شيء عن ماضي
.ذلك الرّجل في هذه الأيّام الثّلاثة

314
00:19:41,110 --> 00:19:42,110
.حاضر

315
00:19:44,410 --> 00:19:47,160
.أصهب وبندبة تشبه الصّليب

316
00:19:48,120 --> 00:19:49,960
...إنّ ذلك الرّجل هو بالفعل

317
00:21:33,850 --> 00:21:35,140
ماذا قلت؟

318
00:21:35,140 --> 00:21:39,060
."قال "مرحبًا بك، القائد بانتظارك

319
00:21:39,060 --> 00:21:42,150
.فعلاً؟ يا لها من معاملة مضيافة

320
00:21:42,610 --> 00:21:45,780
.هذا بالفعل حديث المال

321
00:21:56,250 --> 00:21:58,960
حسنًا أيّها القائد، ماذا عن هذه البضائع؟

322
00:22:07,380 --> 00:22:09,680
أهذه هي؟

323
00:22:21,570 --> 00:22:23,400
!سأصير لا أقهر بهذه

324
00:22:23,900 --> 00:22:25,690
!مرحبًا في اليابان

325
00:22:25,690 --> 00:22:28,360
!واثق أنّ الجميع سينحني لي بسبب هذا

326
00:22:28,820 --> 00:22:30,910
!وكلّ هذا بفضل المال

327
00:22:30,910 --> 00:22:32,280
!هذه قوّة المال

328
00:22:32,280 --> 00:22:35,580
!أنا جدّ مسرور لأنّي ثريّ

329
00:22:46,590 --> 00:22:49,220
."في الحلقة القادمة: "سبب للتّحرّك