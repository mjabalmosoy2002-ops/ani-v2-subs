1
00:00:01,430 --> 00:00:06,360
.إنّه سيّاف متميّز حتّى بين خبرائنا

2
00:00:06,900 --> 00:00:09,860
أجره عالٍ جدًّا. هل يمكنك دفعه؟

3
00:00:16,030 --> 00:00:18,450
.هذا فيروس الجدريّ

4
00:00:20,160 --> 00:00:21,410
.تنّينتو أي الجدريّ

5
00:00:22,410 --> 00:00:25,290
.يُعرف أيضًا في اليابان بهوسو وتوسو

6
00:00:25,290 --> 00:00:29,300
.إنّه مرض معدٍ يسبّبه فيروس الجدريّ

7
00:00:30,340 --> 00:00:37,260
.إنّه شديد العدوى بين البشر وكان يُخشى كمرض فتاك

8
00:00:38,550 --> 00:00:41,850
،إن نشرتُ هذا في الشّوارع وجعلتُ النّاس مرضى

9
00:00:41,850 --> 00:00:44,440
.يمكنني جني مال بقدر ما أشاء

10
00:00:44,940 --> 00:00:48,940
،لا يهمّ كم سيكون الثّمن
.لا مشكلة لديّ على الإطلاق

11
00:00:50,070 --> 00:00:51,570
.حسنًا

12
00:00:51,570 --> 00:00:53,860
...أكره قول هذا الآن

13
00:00:54,650 --> 00:00:57,200
لكنّه جزء من عملي أن أكون على دراية

14
00:00:57,200 --> 00:01:00,120
.أنّ الطّبّ متدنّي الجودة لا فائدة منه بتاتًا

15
00:01:00,580 --> 00:01:02,910
.يُمكن قول نفس الشّيء عن الحرّاس الشّخصيّين

16
00:01:05,080 --> 00:01:10,040
،سأنفق مبلغًا كبير من المال
.لذلك أودّ التّحقّق من مميّزاته

17
00:01:10,420 --> 00:01:14,630
حسنًا. كلّ ما سيثبته ذلك هو أنّه سيجعل
.حارسك الشّخصيّ بلا فائدة

18
00:01:17,840 --> 00:01:18,800
ماذا؟

19
00:01:20,760 --> 00:01:23,640
.لذلك السّيف شكل فريد من نوعه

20
00:01:25,020 --> 00:01:26,690
!انظر

21
00:01:27,390 --> 00:01:32,940
أتظنّ أنّ بإمكانك الفوز ضدّ مضربي
المعدنيّ بنكّاشة أسنان كهذه؟

22
00:01:33,690 --> 00:01:35,610
!سألقّنك درسًا

23
00:01:43,370 --> 00:01:44,790
ما الّذي حدث للتّوّ؟

24
00:01:46,290 --> 00:01:52,040
أيّهما أقوى، الكاتانا الشّرقيّ أم السّيف الغربيّ؟

25
00:01:52,500 --> 00:01:55,970
!حان وقت النّزال أيّها الهيتوكيري باتّوساي

26
00:03:26,970 --> 00:03:30,980
الحلقة 21
قصّة سيّاف ميجي الرّومانسيّة
الفصل صفر الجزء الثّاني

27
00:03:31,810 --> 00:03:33,190
...في كلّ الأحوال

28
00:03:33,400 --> 00:03:38,150
.تفاجأت لكونك فتاة ترتدي ملابس رجال

29
00:03:38,730 --> 00:03:41,360
.هذه مشكلة لا تقتصر على الأطبّاء فقط

30
00:03:41,860 --> 00:03:44,200
،في عالمنا هذا الّذي يهيمن عليه الذّكور

31
00:03:44,200 --> 00:03:48,660
لا توضع الكثير من الثّقة في النّساء
.بغضّ النّظر عن مهارتهنّ

32
00:03:49,660 --> 00:03:55,420
في الحقيقة، توضع الكثير من الثّقة
.في الممرّضات والمساعدات في حالتي

33
00:03:55,630 --> 00:03:57,880
هذا هو الحال حتّى في الغرب؟

34
00:03:57,880 --> 00:03:58,750
.نعم

35
00:03:59,340 --> 00:04:03,090
،لهذا السّبب قرّرت ارتداء أحذية بنعل عالٍ وقبّعة

36
00:04:03,590 --> 00:04:07,760
.زيّفت صوتي وتصرّفاتي ووضعت قناعًا على وجهي

37
00:04:07,970 --> 00:04:11,180
،تفاجأت من تغيّر مظهرك

38
00:04:11,180 --> 00:04:13,600
.لكنّ الصّوت ليس شيئًا يمكن تغييره بسهولة

39
00:04:14,230 --> 00:04:16,940
.لا بدّ أنّ تدرّبت كثيرًا على ذلك

40
00:04:16,940 --> 00:04:19,480
.لطالما كنت جيّدة في أمور كهذه

41
00:04:19,480 --> 00:04:22,700
.في بلادي، قمت بعروض مسرحيّة منفردة

42
00:04:23,150 --> 00:04:24,530
...آهٍ يا روميو

43
00:04:25,030 --> 00:04:26,120
!جولييت

44
00:04:26,660 --> 00:04:28,830
أين أنت يا روميو؟

45
00:04:28,830 --> 00:04:30,160
!أحسنت

46
00:04:33,370 --> 00:04:34,750
...ومع ذلك

47
00:04:36,000 --> 00:04:36,960
قناع؟

48
00:04:36,960 --> 00:04:38,250
.غامض

49
00:04:38,590 --> 00:04:40,090
هل هو طبيب بالفعل؟

50
00:04:40,090 --> 00:04:42,260
.من الأفضل ألاّ نتدخّل في الأمر

51
00:04:43,130 --> 00:04:45,180
.إنّها قصّة لا تخلو من المشاقّ

52
00:04:45,760 --> 00:04:48,010
،بما أنّك تتنكّرين كرجل الآن

53
00:04:48,010 --> 00:04:50,260
.يتمّ التّعامل معك كشخص غامض

54
00:04:50,720 --> 00:04:51,640
.لا بأس

55
00:04:52,140 --> 00:04:54,310
.اخترت أن أعيش حياتي هكذا

56
00:04:56,560 --> 00:05:01,900
إن وُجد عالمٌ خلف هذا القناع بإمكان
...الجميع أن يعيشوا فيه بصحّة جيّدة

57
00:05:03,320 --> 00:05:05,490
.يبدو هذا مبالغة كبيرة منّي

58
00:05:06,360 --> 00:05:07,280
.لا

59
00:05:08,490 --> 00:05:10,370
.لم تكن هنالك ضرورة لقولك ذلك

60
00:05:10,780 --> 00:05:13,250
.سأغادر الآن إن سمحت لي

61
00:05:14,200 --> 00:05:17,960
.لا أستطيع البقاء هنا بعد أن عرفتُ أنّك فتاة

62
00:05:19,590 --> 00:05:20,420
.إلدر-دونو

63
00:05:20,880 --> 00:05:21,880
نعم؟

64
00:05:22,210 --> 00:05:26,220
.يثق بك دانكيتشي كثيرًا

65
00:05:26,470 --> 00:05:30,550
وتلك الأمّ وابنتها ستكونان سعيدتان
.بكلّ تأكيد حيال ما فعلته من أجلهما

66
00:05:32,140 --> 00:05:36,640
على الأرجح أنّ الطّريقة الّتي اخترت
.أن تعيشي بها ليست خطأ

67
00:05:37,600 --> 00:05:38,310
.إلى اللّقاء

68
00:05:48,200 --> 00:05:52,330
...هيتن ميتسوروغي-ريو، سمعتُ عنه من قبل

69
00:05:54,410 --> 00:05:57,000
.لكنّي لم أظنّ أنّه موجود فعلاً

70
00:05:58,460 --> 00:06:01,920
هل سبق وقتلت رجالاً بهيتن ميتسوروغي-ريو؟

71
00:06:02,420 --> 00:06:03,300
.لا

72
00:06:03,710 --> 00:06:07,050
إذًا هل تظنّ أنّ بإمكانك قتل الرّجال؟

73
00:06:10,890 --> 00:06:15,600
إن وُجد عصر جديد بإمكان الجميع
...العيش فيه باطمئنان

74
00:06:16,350 --> 00:06:19,730
بدون سيفي المغطّى بالدّماء
...وحياة الضّحايا

75
00:06:21,810 --> 00:06:27,150
إن وُجد عالمٌ خلف هذا القناع بإمكان
...الجميع أن يعيشوا فيه بصحّة جيّدة

76
00:06:35,910 --> 00:06:36,750
أورو؟

77
00:06:40,500 --> 00:06:42,840
!أيّها الطّبيب! أيّها الطّبيب إلدر

78
00:06:43,840 --> 00:06:46,420
ما الخطب يا دانكيتشي-سان؟

79
00:06:46,800 --> 00:06:50,510
.ماذا؟ سمعتُ أنّك تلقّيت الرّسالة سلفًا

80
00:06:50,970 --> 00:06:53,260
.لا يهمّ. تعال معي رجاءً

81
00:06:54,680 --> 00:06:55,850
أهي حالة طارئة؟

82
00:06:55,850 --> 00:07:00,060
،لا. لقد قالوا أن أحضرك في وقت معيّن
.لذلك لا أعتبرها حالة طارئة

83
00:07:00,190 --> 00:07:04,270
،في وقت معيّن؟ في جنح اللّيل
وقبل طلوع الفجر؟

84
00:07:06,860 --> 00:07:08,150
.هذا غريب

85
00:07:08,150 --> 00:07:09,280
.غريب بالفعل

86
00:07:09,490 --> 00:07:11,950
!مهلاً! هناك رجل في وسط الطّريق

87
00:07:12,070 --> 00:07:13,700
!هذا خطير! ابتعد عن الطّريق

88
00:07:20,330 --> 00:07:21,540
ما ذلك الشّيء؟

89
00:07:21,920 --> 00:07:23,250
ما الّذي ينوي عليه؟

90
00:07:23,250 --> 00:07:24,670
!ابتعد عن الطّريق

91
00:07:24,920 --> 00:07:28,130
...أسلوب سيف المفكّ

92
00:07:28,380 --> 00:07:31,050
!عاصفة الجحيم

93
00:07:39,390 --> 00:07:43,230
.لم يكن علينا القدوم لمشاهدة هذا
!ذلك الرّجل مذهل

94
00:07:43,230 --> 00:07:46,190
.من المهمّ أن أشهد على هذا بأمّ عينيّ

95
00:07:46,440 --> 00:07:49,150
.لا أثق بأيّ أحد في هذا العالم

96
00:07:49,400 --> 00:07:50,860
.ولا حتّى بك

97
00:07:52,490 --> 00:07:54,660
يقوم بليّ جسده حتّى آخر حدوده

98
00:07:54,660 --> 00:07:59,410
ويستعمل اللّفّ النّاجم عن ذلك
...لاكتساب أقصى قوّة ممكنة

99
00:07:59,870 --> 00:08:03,830
.ذاك هو أسلوب سيف المفكّ الّذي يستعمله

100
00:08:05,170 --> 00:08:06,000
!أيّها الطّبيب

101
00:08:06,210 --> 00:08:07,960
أين السّاموراي؟

102
00:08:08,130 --> 00:08:08,960
ماذا؟

103
00:08:08,960 --> 00:08:11,220
.الرّجل ذو النّدبة على شكل صليب

104
00:08:11,300 --> 00:08:12,550
.أبعد يدك عنه

105
00:08:16,180 --> 00:08:19,680
.نسيت تسليم الرّسالة إلى إلدر-دونو من قبل

106
00:08:19,810 --> 00:08:22,940
تطلّب الأمر بعض المجهود
.حتّى تُترجم لليابانيّة في الفندق

107
00:08:23,270 --> 00:08:25,730
.لكنّها كانت رسالة لاستدراج إلدر-دونو

108
00:08:26,610 --> 00:08:28,730
...الرّوروني

109
00:08:29,440 --> 00:08:33,200
.ندبة على شكل صليب بالفعل
.أنت السّاموراي بالفعل

110
00:08:34,660 --> 00:08:39,740
،كرجلين أتقنا فنون المسايفة بحقّ
.فأنا أتحدّاك في نزال

111
00:08:40,240 --> 00:08:44,500
.أريد معرفة من هو السّيّاف الأكثر تفوّقًا

112
00:08:44,710 --> 00:08:47,710
!الرّجل الأسطوريّ الّذي يُوصف بالأقوى على الإطلاق

113
00:08:48,040 --> 00:08:49,710
!الهيتوكيري باتّوساي

114
00:08:52,300 --> 00:08:55,800
قتْل العديد من الشّخصيّات البارزة كقاتل مأجور

115
00:08:55,800 --> 00:09:00,390
ومحاربة عدّة محاربين مخضرمين
!في فترة باكوماتسو كسيّاف مرتزقة

116
00:09:01,020 --> 00:09:05,600
أنت بلا أدنى شكّ أحد أقوى السّاموراي
!أيّها الهيتوكيري باتّوساي

117
00:09:07,020 --> 00:09:09,520
.تخلّيت عن ذلك الاسم قبل عشر سنوات

118
00:09:09,520 --> 00:09:11,070
!كم هذا سخيف

119
00:09:11,070 --> 00:09:14,700
تخلّيت عن ذلك الاسم؟
ما ذلك الكاتانا الّذي تحمله إذًا؟

120
00:09:15,070 --> 00:09:16,450
!هيّا استلّه

121
00:09:16,450 --> 00:09:18,660
!استلّه وقاتلني

122
00:09:33,920 --> 00:09:37,430
.لا خيار أمامي إن كان هذا ما تريده بشدّة

123
00:09:42,140 --> 00:09:44,640
.أعتذر على معاملتي لك بقسوة

124
00:09:49,900 --> 00:09:52,400
.سمعتُ أنّ الكاتانا هو روح السّاموراي

125
00:09:57,860 --> 00:10:00,570
!أطلق روحك تلك الآن

126
00:10:00,910 --> 00:10:03,990
!قبل أن تصير أيّام السّيف في خبر كان

127
00:10:04,330 --> 00:10:06,960
!عاصفة الجحيم

128
00:10:08,830 --> 00:10:09,670
!يا لها من طعنة

129
00:10:11,590 --> 00:10:13,090
!لا تتصدّى لها

130
00:10:13,090 --> 00:10:14,800
!ستلتفّ معها ويُقذف بك بعيدًا

131
00:10:22,640 --> 00:10:25,390
!زوبعة الجحيم

132
00:10:41,280 --> 00:10:45,370
،تمّ تعديل ذلك السّيف ليصير أصلب

133
00:10:45,370 --> 00:10:49,250
،درّب إسبيرال جسده لمستويات غيّرت حتّى شكله

134
00:10:49,250 --> 00:10:52,590
لكنّ كلّ تقنية أُطلقت تمّ تفاديها
.بشكل مثاليّ بهامش شعرة

135
00:10:52,920 --> 00:10:55,460
.لم أتوقّع أقلّ من هذا من القاتل الأسطوريّ

136
00:11:00,430 --> 00:11:07,100
يبدو أنّنا سنرى تقنية أسلوب سيف
.المفكّ الأقوى لأوّل مرّة منذ مدّة

137
00:11:08,810 --> 00:11:12,150
!ما هذا؟ إنّ جسده ملتفّ بالكامل

138
00:11:13,270 --> 00:11:17,230
.نحن السّاموراي الأخير والسّيّاف الأخير

139
00:11:17,690 --> 00:11:20,700
من سيكون آخر من سيظلّ واقفًا بيننا؟

140
00:11:20,950 --> 00:11:23,200
!لنقرّر ذلك الآن

141
00:11:31,960 --> 00:11:35,960
.نحن السّاموراي الأخير والسّيّاف الأخير

142
00:11:36,460 --> 00:11:39,170
من سيكون آخر من سيظلّ واقفًا بيننا؟

143
00:11:39,670 --> 00:11:41,680
!لنقرّر ذلك الآن

144
00:11:41,880 --> 00:11:45,350
!خذ هذا! هجومي الأقوى والأسرع

145
00:11:45,970 --> 00:11:48,850
!إعصار الجحيم

146
00:11:53,900 --> 00:11:54,730
!أيّها الرّوروني

147
00:12:07,200 --> 00:12:08,040
!لقد نجح

148
00:12:11,410 --> 00:12:12,960
ماذا؟

149
00:12:12,960 --> 00:12:18,380
أخذ قوّة هجوم إسبيرال الأقوى
.وأضافها إلى هجومه القاطع ليصدّه

150
00:12:27,260 --> 00:12:30,270
.آخر من ظلّ واقفًا هو السّاموراي

151
00:12:31,270 --> 00:12:37,190
لا بأس، إن كان شخص من مستواك
.من سيقضي عليّ، فذلك أكثر ممّا أتمنّاه

152
00:12:38,190 --> 00:12:40,400
.حسنًا، وجّه ضربتك الأخيرة

153
00:12:41,190 --> 00:12:42,700
.يا لها من فضيحة

154
00:12:42,900 --> 00:12:44,450
.أمعن النّظر رجاءً

155
00:12:45,410 --> 00:12:47,660
.هذا هو الكاتانا خاصّتي الآن

156
00:12:48,120 --> 00:12:49,790
ساكاباتو؟

157
00:12:50,830 --> 00:12:55,750
أسلوب سيف هيتن ميتسوروغي-ريو هو
.أسلوب قاتل سيذبح منافسيّ بكلّ تأكيد

158
00:12:56,330 --> 00:13:00,710
لذلك السّبب أستعمل هذا الكاتانا
.المبتكر كي لا أقتلهم

159
00:13:04,470 --> 00:13:07,470
.الكاتانا هو روح السّاموراي

160
00:13:07,970 --> 00:13:08,930
.فهمت

161
00:13:09,430 --> 00:13:12,060
.تلك هي روحك الحاليّة إذًا

162
00:13:13,810 --> 00:13:15,810
!مستواك مختلف تمامًا من ناحية المهارة والتّصنيف

163
00:13:16,060 --> 00:13:18,770
—سُحقًا! على الأقلّ

164
00:13:24,950 --> 00:13:26,200
!"جدريّ"

165
00:13:26,320 --> 00:13:27,160
!مهلاً

166
00:13:27,160 --> 00:13:29,490
!إنّه فيروس الجدريّ! إنّه خطير للغاية

167
00:13:38,420 --> 00:13:39,630
!أيّها الجدريّ

168
00:13:39,840 --> 00:13:42,420
!اركب الرّياح وانتشر في كلّ يوكوهاما

169
00:13:42,420 --> 00:13:45,260
!ووسط كلّ هذا الارتباك، سأهرب من هنا

170
00:13:59,100 --> 00:14:00,860
.تمّ تسوية الأمر

171
00:14:00,860 --> 00:14:03,030
.لا تلحق مزيدًا من العار على هزيمتي

172
00:14:05,690 --> 00:14:07,110
!اللّعنة عليك يا إيشيزو

173
00:14:12,740 --> 00:14:15,450
.أنا راض بكوني شاهدًا على قتال عظيم

174
00:14:15,450 --> 00:14:16,830
.أستسلم

175
00:14:38,640 --> 00:14:40,810
أنقذتني؟

176
00:14:41,310 --> 00:14:44,440
.كلّ المصابين والمرضى سواسية في نظري كطبيب

177
00:14:44,940 --> 00:14:46,240
هكذا إذًا؟

178
00:14:46,240 --> 00:14:47,070
.نعم

179
00:14:48,530 --> 00:14:53,660
سعيتُ أن أكون أقوى من حمل السّيف
.في عصر ستنقرض فيه السّيوف

180
00:14:54,200 --> 00:14:55,040
...ولكن

181
00:14:55,240 --> 00:14:59,370
.حتّى ذلك تحطّم أمام السّاموراي الشّرقيّ

182
00:15:00,120 --> 00:15:04,170
،لا سبب لديّ لأعيش
.حتّى إن شفيت جراحي

183
00:15:06,550 --> 00:15:08,590
السّعي لتكون الأفضل

184
00:15:08,590 --> 00:15:11,430
على الرّغم من كونك في عصر
...تقترب فيه نهاية المسايفة

185
00:15:12,140 --> 00:15:14,310
.أعتقد أنّ هذا أمر يستحقّ أن تفخر به

186
00:15:15,180 --> 00:15:20,390
ولكن، عندما تكون أهدافك كبيرة
.جدًّا، يصير الضّياع محتملاً

187
00:15:22,980 --> 00:15:27,860
ما كان أحد ليحمل خريطة لليابان بأكملها
فقط ليجول يوكوهاما فحسب، صحيح؟

188
00:15:28,440 --> 00:15:31,820
ضعت خلال مسعاي؟

189
00:15:35,490 --> 00:15:38,580
.بالفعل، قد يكون الأمر كذلك

190
00:15:41,460 --> 00:15:45,920
.اعتُقل إيشيزو وتمّ ترحيل الوسيط

191
00:15:46,460 --> 00:15:48,260
.إذًا يمكننا أن نرتاح الآن

192
00:15:49,170 --> 00:15:53,390
.في نظري، هذا مريح أكثر بكثير ممّا أتوقّع

193
00:15:54,260 --> 00:15:57,640
.كان شرفًا لي أن أقاتلك أيّها الباتّوساي

194
00:15:58,140 --> 00:16:01,850
.لا، قلتَ أنّك تخلّيت عن ذلك الاسم

195
00:16:02,270 --> 00:16:03,810
.أنا روروني

196
00:16:04,310 --> 00:16:05,940
.وذلك يعني سيّاف متجوّل

197
00:16:06,400 --> 00:16:07,980
.أنا إسبيرال

198
00:16:08,480 --> 00:16:11,570
.شعرت باليأس مع اقتراب نهاية عصر السّيوف

199
00:16:12,110 --> 00:16:15,660
ولكنّي أدركت عندما أخبرني الطّبيب إلدر

200
00:16:15,660 --> 00:16:18,290
...أنّي سأضيع إن استعملتُ خريطة كبيرة جدًّا

201
00:16:19,500 --> 00:16:23,420
،ليس من السّيئ أن نعيش بآمال صغيرة

202
00:16:23,420 --> 00:16:27,290
.بدل أن نيأس بشأن شيء ضخم كعصر بأكمله

203
00:16:27,960 --> 00:16:29,840
آمال صغيرة؟

204
00:16:30,590 --> 00:16:36,300
.ما دمتُ سيّافًا، فلن ينتهي عصر السّيوف في نظري

205
00:16:36,970 --> 00:16:38,430
.هكذا قرّرت أن أنظر للأمر

206
00:16:39,220 --> 00:16:40,270
...وأيضًا

207
00:16:42,310 --> 00:16:43,600
...ذلك السّيف

208
00:16:44,100 --> 00:16:48,070
،كما اخترت أنت السّاكاباتو بدل الكاتانا القاتل

209
00:16:48,440 --> 00:16:51,740
.اخترتُ أنا أن أحمل سيفًا مستقيمًا بل الملتفّ

210
00:16:51,740 --> 00:16:54,780
.اخترتُ أن أكون سيّافًا يحمي الطّبيب إلدر

211
00:16:55,530 --> 00:16:58,410
.مع أنّي سأكون بخير وحدي

212
00:16:58,620 --> 00:17:02,870
على الأقلّ، دعني أرافقك إلى هدفك
.التّالي في الولايات المتّحدة

213
00:17:03,370 --> 00:17:05,000
.استسلمت لمثابرته

214
00:17:05,000 --> 00:17:06,330
.فهمت

215
00:17:06,330 --> 00:17:09,300
.عدوّ الأمس هو صديق اليوم

216
00:17:09,800 --> 00:17:10,630
.نعم

217
00:17:11,840 --> 00:17:15,590
هل ستغادران البلاد الآن؟

218
00:17:16,090 --> 00:17:17,600
.نعم –
.صحيح –

219
00:17:18,050 --> 00:17:19,050
.مع السّلامة إذًا

220
00:17:30,110 --> 00:17:32,070
.سأقوم بإجراءات الرّكوب

221
00:17:33,190 --> 00:17:35,400
.أنا مسرورة لأنّك ستودّعنا

222
00:17:35,400 --> 00:17:36,950
،عندما يكون هناك من يودّعونني

223
00:17:36,950 --> 00:17:40,700
.أشعر أنّهم سيرحّبون بي عندما أعود ثانية

224
00:17:41,040 --> 00:17:42,910
.لكنّي لستُ الوحيد

225
00:17:44,370 --> 00:17:46,960
!أيّها الطّبيب! أيّها الطّبيب إلدر

226
00:17:47,250 --> 00:17:49,210
!أخبرنا دانكيتشي برحيلك

227
00:17:49,210 --> 00:17:52,340
حميت المستوطنة من ذلك الحثالة ديان، صحيح؟

228
00:17:52,840 --> 00:17:54,300
!إلى اللّقاء ثانية

229
00:17:54,510 --> 00:17:56,760
!أمّي بخير الآن

230
00:17:56,970 --> 00:17:58,180
!شكرًا لك

231
00:17:58,180 --> 00:17:59,850
!شكرًا جزيلاً

232
00:17:59,850 --> 00:18:02,810
سيكون هنالك الكثير ممّن سيرحّبون بك
.في المرّة القادمة

233
00:18:03,390 --> 00:18:04,730
!شكرًا جزيلاً

234
00:18:05,600 --> 00:18:07,730
!اعتنوا بأنفسكم جميعًا

235
00:18:07,940 --> 00:18:09,860
!ماذا؟ يا لها من حسناء

236
00:18:11,860 --> 00:18:12,940
.مع السّلامة

237
00:18:12,940 --> 00:18:18,110
أرجو أن تكوني عونا لأولئك الّذين يعانون
.من الإصابات أو الأمراض

238
00:18:18,610 --> 00:18:23,830
نعم. سأبذل جهدي ليستطيع أكبر عدد
.من النّاس أن يعيشوا بصحّة جيّدة

239
00:18:29,080 --> 00:18:30,460
.يا لها من ندبة كبيرة

240
00:18:30,960 --> 00:18:33,300
،يبدو أنّها إصابة سيف قديمة

241
00:18:33,800 --> 00:18:36,590
.ولكنّها تبدو وكأنّها حديثة أيضًا نوعًا ما

242
00:18:37,420 --> 00:18:42,760
عقلك وجسدك مرتبطان بشكل أعمق
.وأقوى ممّا يمكنك تخيّله

243
00:18:43,890 --> 00:18:46,770
،أجهل ما حدث في ماضيك

244
00:18:47,270 --> 00:18:50,150
...لكن إن كان ذلك الماضي مرتبط بهذه النّدبة

245
00:18:50,730 --> 00:18:55,360
فما رأيك أن تنتقل إلى أرض جديدة
وتبدأ حياة جديدة هناك من الصّفر؟

246
00:18:56,320 --> 00:18:58,110
.يُسمّى هذا علاج تغيير الجوّ

247
00:18:58,110 --> 00:19:00,070
ترك منطقة اعتدت على العيش فيها

248
00:19:00,200 --> 00:19:02,320
ووضع نفسك في بيئة مختلفة تمامًا

249
00:19:02,320 --> 00:19:04,330
.سيجلب السّلام لعقلك ويشفيك

250
00:19:06,200 --> 00:19:07,910
.أقدّر لك اهتمامك

251
00:19:08,790 --> 00:19:12,330
.ولكن، ماضيّ أمر اخترته بنفسي لنفسي

252
00:19:13,250 --> 00:19:15,670
.لا يمكنني نسيانه ببساطة

253
00:19:16,300 --> 00:19:19,510
.سأحتفظ بالماضي وهذه النّدبة أيضًا

254
00:19:21,090 --> 00:19:22,890
...وبهذا السّيف على الأقلّ

255
00:19:23,850 --> 00:19:28,350
سأحمي أكبر قدر من النّاس
.ألتقيهم في ترحالي

256
00:19:30,190 --> 00:19:31,940
.معك حقّ

257
00:19:31,940 --> 00:19:34,480
،إن كان الكاتانا هو روح السّاموراي

258
00:19:34,480 --> 00:19:40,280
فإنّ حمل ذلك السّيف غير القاتل
.بالنّسبة لك هي طريقة الحياة الأفضل

259
00:21:13,120 --> 00:21:15,080
.وهكذا انتهت هذه القصّة

260
00:21:15,580 --> 00:21:19,460
أخبرني يا كنشين، متى وقعت أحداث هذه القصّة؟

261
00:21:19,670 --> 00:21:21,090
.دعني أفكّر

262
00:21:21,090 --> 00:21:25,050
أعتقد أنّها قبل خمسة أيّام مذ بدأت
.أقيم في دوجو كاميا

263
00:21:25,340 --> 00:21:26,260
خمسة أيّام؟

264
00:21:26,430 --> 00:21:28,850
إذًا فقد كانت قصّة حديثة؟

265
00:21:29,180 --> 00:21:32,220
.ظننتُ أنّها قصّة من ماضيك البعيد

266
00:21:33,140 --> 00:21:36,770
.لم أقل أنّي سأروي لكم قصّة قديمة

267
00:21:36,770 --> 00:21:37,940
.معك حقّ

268
00:21:38,650 --> 00:21:41,280
.ولكن، هناك أمر يزعجني

269
00:21:41,400 --> 00:21:42,230
أورو؟

270
00:21:42,440 --> 00:21:43,610
...المعذرة

271
00:21:48,240 --> 00:21:49,490
...كِن-سان، أنت

272
00:21:49,910 --> 00:21:52,410
،قلت أنّك تستطيع شمّ نبات الغار في الحديقة

273
00:21:52,410 --> 00:21:55,160
.ولكن لم تستطع شمّ الشّاي الأسود

274
00:21:55,920 --> 00:21:57,790
.هذا صحيح

275
00:21:57,790 --> 00:22:02,050
.لكنّك قلت أنّ هذا الشّاي لذيذ قبل قليل

276
00:22:03,840 --> 00:22:05,170
.هذا صحيح

277
00:22:05,670 --> 00:22:06,880
.إذًا فأنت بخير إذًا

278
00:22:10,180 --> 00:22:13,720
.إليك نصيحة أخيرة كطبيبة

279
00:22:14,890 --> 00:22:19,650
،مهما كانت الإصابة أو المرض
.عليك أن ترتاح إضافة للعلاج

280
00:22:20,310 --> 00:22:22,610
من المهمّ أن تستقرّ في مكان واحد

281
00:22:22,610 --> 00:22:25,400
.وتهدّئ عقلك وجسدك مع الوقت

282
00:22:26,400 --> 00:22:30,780
وإن حدث والتقيتَ بشخص ما يعتمد
...عليك في المستقبل

283
00:22:31,280 --> 00:22:35,290
.فرجاء جرّب أن توقف ترحالك حينها

284
00:22:38,250 --> 00:22:39,250
.مفهوم

285
00:22:40,330 --> 00:22:42,500
.سأتذكّر نصيحتك جيّدًا

286
00:22:45,010 --> 00:22:50,010
الحلقة القادمة
عودة الذّئب للحياة

287
00:22:46,220 --> 00:22:49,010
."في الحلقة القادمة: عودة الذّئب للحياة