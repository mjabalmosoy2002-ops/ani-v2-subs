1
00:00:06,650 --> 00:00:08,480
.مرّ أسبوع الآن

2
00:00:09,150 --> 00:00:12,070
.حُلّت قضيّة جرائم قتل مفترقات الطّرق أيضًا

3
00:00:13,400 --> 00:00:15,740
!لكن لم يعد أيٌّ من تلاميذي بعد

4
00:00:16,240 --> 00:00:17,870
!كم هذا مزعج

5
00:00:18,280 --> 00:00:20,870
.إنّنا في عصر تنوير لو سمحت

6
00:00:21,000 --> 00:00:25,000
.تكون العودة صعبة بعد المغادرة

7
00:00:25,500 --> 00:00:26,790
...بالحديث عن الإزعاج

8
00:00:26,790 --> 00:00:27,960
!عمرك يزعجني يا كنشين

9
00:00:28,630 --> 00:00:31,050
عمرك 28 سنة مع أنّك تبدو هكذا؟

10
00:00:31,050 --> 00:00:32,670
!هذه كذبة! أنت تخدعني

11
00:00:32,840 --> 00:00:35,470
إنّك يافع جدًّا لتكون مناصرًا
!إمبراطوريًّا للإصلاح أيضًا

12
00:00:36,550 --> 00:00:39,180
إذًا هل سيكون من المناسب
لو قلتُ أنّي تجاوزت الثّلاثين؟

13
00:00:41,560 --> 00:00:42,680
.لا أريد ذلك أيضًا

14
00:00:43,100 --> 00:00:44,980
.اسمحي لي أن أقول أنّك أنانيّة

15
00:02:22,740 --> 00:02:24,620
.لا فائدة من القلق

16
00:02:25,120 --> 00:02:27,580
.سيعود التّلاميذ في الوقت المناسب

17
00:02:28,000 --> 00:02:31,000
.لكن لا يوجد أحد هنا حتّى للتّدريب

18
00:02:31,000 --> 00:02:34,840
لهذا السّبب تجدني مضطرّة للذّهاب
!لدوجو أحد معارفي لأتدرّب

19
00:02:35,210 --> 00:02:37,460
!لأنّك ترفض حتّى النّظر إليّ

20
00:02:37,970 --> 00:02:40,970
كلاّ، أنا فقط لستُ معتادًا على
.القتال بسيف خيزران

21
00:02:42,260 --> 00:02:43,100
أورو؟

22
00:02:43,600 --> 00:02:44,560
!انتظر

23
00:02:45,260 --> 00:02:47,100
!كنشين، هذا الفتى نشّال

24
00:02:47,390 --> 00:02:49,390
هذه محفظتك، صحيح؟

25
00:02:49,390 --> 00:02:51,480
!سُحقًا! أتركيني أيّتها القبيحة

26
00:02:51,480 --> 00:02:52,310
—قبـ

27
00:02:52,310 --> 00:02:56,360
!يا لفظاظتك
!يصفني النّاس هنا بحسناء المسايفة

28
00:02:56,360 --> 00:02:57,690
!اخرسي أيّتها القبيحة

29
00:02:57,690 --> 00:02:59,400
.على رسلكما -
!أراك قد ردّدت ذلك -

30
00:02:59,400 --> 00:03:02,070
لا يوجد ما بوسعي فعله إن كنتُ
.قد تعرّضت للنّشل رجاءً

31
00:02:59,450 --> 00:03:01,490
وهل سأكذب عليك؟ -
ماذا؟ -

32
00:03:03,240 --> 00:03:05,530
خذ يا صغير، لا تسمح لهم بالإمساك
.بك المرّة القادمة

33
00:03:05,990 --> 00:03:07,830
.حسنًا، لنواصل طريقنا لو سمحت

34
00:03:08,370 --> 00:03:09,750
!انتظر يا كنشين

35
00:03:16,710 --> 00:03:17,590
!أورو

36
00:03:17,920 --> 00:03:19,800
!لستُ صغيرًا

37
00:03:19,800 --> 00:03:22,180
!أنا سليل  ساموراي طوكيو ميوجين ياهيكو

38
00:03:22,680 --> 00:03:25,180
!لم أبلغ الحضيض بعد حتّى يشفق عليّ الآخرون

39
00:03:25,470 --> 00:03:30,140
أوقعتك في مقبل لا غير لأنّك تجرّأت
!على حمل سيف

40
00:03:30,640 --> 00:03:32,850
!لا تسئ فهمي أيّها الوغد

41
00:03:35,610 --> 00:03:36,770
...يا صغير

42
00:03:36,770 --> 00:03:38,440
!أخبرتك أنّي لستُ صغيرًا

43
00:03:39,490 --> 00:03:42,450
،ما زلت تملك ملامح طفل صغير

44
00:03:42,450 --> 00:03:44,820
.لكنّ قلبك قلب رجل شجاع إن سمحت لي

45
00:03:46,030 --> 00:03:48,790
.أعتذر منك. قلّلتُ من شأنك

46
00:03:54,460 --> 00:03:56,710
!يا له من فتى وقح

47
00:04:15,940 --> 00:04:18,690
طوكيو مكان صاخب بالفعل
.إن جاز لي التّعبير

48
00:04:19,190 --> 00:04:22,150
أين كنت قبل مجيئك إلى هنا يا كنشين؟

49
00:04:22,360 --> 00:04:24,530
.جُلت عدّة أماكن مختلف هنا وهناك

50
00:04:24,530 --> 00:04:26,120
.أنا روروني قبل كلّ شيء لو سمحت

51
00:04:27,700 --> 00:04:30,370
أتساءل لماذا يقضي حياته كروروني؟

52
00:04:33,500 --> 00:04:37,080
معظم المناصرين الإمبراطوريّين
،قد تخلّوا عن سيوفهم منذ مدّة

53
00:04:37,460 --> 00:04:40,460
،وأخذوا واجبات مشرّفة في حكومة ميجي

54
00:04:40,460 --> 00:04:42,510
.مستغلّين سلطتهم

55
00:04:44,180 --> 00:04:46,590
.تبدين وكأنّك تودّين طرح سؤال

56
00:04:46,590 --> 00:04:47,510
ماذا؟

57
00:04:49,930 --> 00:04:50,970
.لا بأس

58
00:04:50,970 --> 00:04:53,890
ليس من المفاجئ أن يكون للمرء قصصًا من ماضيه

59
00:04:53,890 --> 00:04:55,690
.لا يريد إطلاعها لأيّ أحد آخر

60
00:04:57,560 --> 00:04:58,940
!لا شيء على الإطلاق

61
00:04:58,940 --> 00:05:01,360
!ولكن ذلك السّيف

62
00:05:01,360 --> 00:05:03,240
!أخبرتك أن تخفيه بشيء ما

63
00:05:03,360 --> 00:05:07,110
على رسلك. كان العديد من النّاس
.يحملون السّيوف قبل سنتين فحسب

64
00:05:07,620 --> 00:05:10,950
،انظري لو سمحت
.لا يبدو أنّ هنالك من يهتمّ لذلك

65
00:05:10,950 --> 00:05:13,200
!لكن هنالك من تدخّل في شؤونك للتّوّ

66
00:05:13,200 --> 00:05:15,250
.يوجد الكثير من رجال الشّرطة في البلدة أيضًا

67
00:05:15,250 --> 00:05:18,000
،حتّى إن كان سيفك ساكاباتو
!فبإمكانهم اعتقالك بالتّأكيد

68
00:05:18,000 --> 00:05:20,250
.سأقلق حيال تلك المشكلة عند حدوثها لو سمحت

69
00:05:21,050 --> 00:05:22,340
.يا إلهي

70
00:05:24,840 --> 00:05:27,130
.سأذهب للتّدرّب الآن

71
00:05:27,130 --> 00:05:28,800
.لذلك اذهب للتّسوّق من أجلي يا كنشين

72
00:05:29,220 --> 00:05:31,060
.اشتر بعض الميسو والملح وصلصة الصّويا

73
00:05:31,060 --> 00:05:32,770
.جميعها تبدو ثقيلة

74
00:05:32,770 --> 00:05:34,020
!لا تتذمّر

75
00:05:47,660 --> 00:05:49,370
.آسف لطرح سؤالي من داخل العربة

76
00:05:49,660 --> 00:05:53,950
لكن هل هذا هو الطّريق الصّحيح
إلى مركز الشّرطة؟

77
00:05:53,950 --> 00:05:55,910
.صـ-صحيح، هو كذلك

78
00:05:56,410 --> 00:05:59,580
واصل طريقك حتّى تصل الشّارع
.الرّئيسيّ تمّ استدر يمينًا

79
00:05:59,580 --> 00:06:00,540
.شكرًا لك

80
00:06:01,040 --> 00:06:03,170
.سمعتها. واصل مسيرك

81
00:06:06,800 --> 00:06:08,510
.كانت عربة رائعة

82
00:06:07,930 --> 00:06:11,510
.لم أر ذلك الرّجل في البلدة من قبل
من يكون يا ترى؟

83
00:06:08,510 --> 00:06:10,050
!لم أرَ مثيلاً لها من قبل

84
00:06:10,050 --> 00:06:11,510
من أين ذلك الرّجل الغنيّ؟

85
00:06:13,260 --> 00:06:14,640
فعلاً؟

86
00:06:15,140 --> 00:06:17,940
هل أنت هنا في هذه البلدة بالفعل؟

87
00:06:18,980 --> 00:06:20,900
...يا هيمورا باتّوساي

88
00:06:26,110 --> 00:06:27,950
.مرحبًا يا ياهيكو

89
00:06:27,950 --> 00:06:30,360
.عليك الدّفع اليوم

90
00:06:30,360 --> 00:06:32,620
المبلغ جاهز، صحيح؟

91
00:06:33,280 --> 00:06:34,240
.ليس بعد

92
00:06:34,240 --> 00:06:35,080
ماذا؟

93
00:06:35,330 --> 00:06:38,040
اخرس! لا يمكنك التّذمّر إن جهّزته
—قبل حلول المساء

94
00:06:40,370 --> 00:06:41,880
...غا-غاسكي-سان

95
00:06:45,840 --> 00:06:48,760
.إيّاك أن تسخر منّي أيّها الشّقيّ القذر

96
00:06:49,260 --> 00:06:54,930
.اسمع. لا قيمة لك عندي ما لم تحضر لي مالي

97
00:06:56,930 --> 00:06:58,850
.سأمرّ ثانية في المساء

98
00:06:58,850 --> 00:07:02,020
.لن تر نهاية هذا اليوم لو لم يكن معك مال

99
00:07:05,230 --> 00:07:06,440
مفهوم؟

100
00:07:14,330 --> 00:07:16,410
.المكان صاخب هناك نوعًا ما

101
00:07:17,370 --> 00:07:19,370
مهلاً! هل حدث أمر ما؟

102
00:07:19,370 --> 00:07:20,710
!حالة اعتقال

103
00:07:20,710 --> 00:07:23,830
يطارد شرطيّ رجلاً يخالف مرسوم
!منع حمل السّيف

104
00:07:29,510 --> 00:07:31,130
!يا لك من رجل مراوغ

105
00:07:31,260 --> 00:07:32,890
!استسلم فحسب

106
00:07:32,890 --> 00:07:35,680
.يا إلهي. إنّهم مثابرون بالفعل

107
00:07:37,560 --> 00:07:38,390
...إنّه

108
00:07:39,180 --> 00:07:42,900
.لا خيار أمامي
.أعتقد أنّي سأسمح لهم باعتقالي بهدوء

109
00:07:42,900 --> 00:07:44,020
!ابتعدوا عن الطّريق

110
00:07:44,770 --> 00:07:46,940
!لا يستطيع رجال الشّرطة الحاملين للسّيف المرور

111
00:07:46,940 --> 00:07:48,610
!إن لم تبتعدوا، فسنقطعكم

112
00:08:00,750 --> 00:08:02,710
.مـ-مفتّش الشّرطة أوجيكي

113
00:08:03,460 --> 00:08:06,420
.أحسنتم عملاً. ستتولّى فرقتنا الباقي

114
00:08:07,000 --> 00:08:08,630
.يمكنكم المغادرة الآن

115
00:08:08,630 --> 00:08:13,010
و-ولكنّ هذا الرّجل لا يظهر
.أيّ نوايا على استلال سيفه

116
00:08:13,010 --> 00:08:15,260
.وقد قمنا بمحاصرته سلفًا كما ترون

117
00:08:15,510 --> 00:08:17,720
لسنا بحاجة لإثقال كاهل رجال
—الشّرطة الحاملـ

118
00:08:19,680 --> 00:08:22,180
كيف يجرؤ شرطيّ من الدّرجة
الثّالث على إبداء رأيه أمامي

119
00:08:22,180 --> 00:08:24,690
وأنا محارب من ثورة ساتسوما؟

120
00:08:25,310 --> 00:08:27,520
،عندما أقول اغرب عن وجهي
.فاغرب عن وجهي

121
00:08:29,690 --> 00:08:32,650
ما رأيك أن تستلّ سيفك أيّها الرّقيق؟

122
00:08:33,200 --> 00:08:35,950
،بما أنّك تحمل سيفك هنا في طوكيو

123
00:08:35,950 --> 00:08:38,120
.فلا بدّ أنّ واثق من مهاراتك

124
00:08:38,530 --> 00:08:41,910
ليس لديّ سيف أستلّه في أيّ
.وكلّ مكان لو سمحت

125
00:08:42,620 --> 00:08:43,540
،في البداية

126
00:08:43,540 --> 00:08:47,710
.لا أحمل سيفًا بغرض التّفاخر بقوّتي لو سحمت

127
00:08:50,130 --> 00:08:51,380
!كنشين

128
00:08:52,840 --> 00:08:55,300
إنّها برفقتك، صحيح؟

129
00:08:55,300 --> 00:08:56,510
!لا تقتربي يا كاورو-دونو

130
00:09:02,600 --> 00:09:05,640
سأقطع الكيمونو الّذي ترتديه
.وأذلّها بضربتي التّالية

131
00:09:06,270 --> 00:09:07,610
.سأكرّر كلامي ثانية

132
00:09:08,110 --> 00:09:09,980
ما رأيك أن تستلّ سيفك؟

133
00:09:11,360 --> 00:09:12,530
...هل أنت

134
00:09:13,240 --> 00:09:15,240
ضابط شرطة بالفعل؟

135
00:09:15,450 --> 00:09:16,280
.نعم

136
00:09:16,700 --> 00:09:19,950
بإمكاني قتل النّاس قانونًا
.برخصة حمل السّيف الّتي معي

137
00:09:20,450 --> 00:09:22,200
.أنا من رجال الشّرطة الحاملين للسّيف

138
00:09:22,200 --> 00:09:24,870
!لا تكن متغطرسًا فقط لأنّك موظّف حكوميّ

139
00:09:24,870 --> 00:09:26,000
!ما هذا الاضطهاد؟

140
00:09:26,000 --> 00:09:27,170
!كفى يا قطّاع الطّرق

141
00:09:28,750 --> 00:09:31,920
كيف تجرؤون على إهانتي؟

142
00:09:31,920 --> 00:09:34,130
...اعتقلوا كلّ واحد منهم

143
00:09:34,630 --> 00:09:36,340
.بتهمة مقاومة ضابط حكوميّ

144
00:09:36,550 --> 00:09:37,760
!تمّ السّماح باستعمال السّيف

145
00:09:38,800 --> 00:09:41,220
.لا تقلقوا حيال من يقاومون

146
00:09:41,220 --> 00:09:42,060
.اقطعوهم

147
00:09:49,360 --> 00:09:50,690
...ضدّ كاورو-دونو

148
00:09:51,230 --> 00:09:52,650
...وسكّان البلدة

149
00:09:53,400 --> 00:09:55,650
!فإنّ ذلك السّيف لن يمسّ شعرة منهم

150
00:09:57,030 --> 00:09:59,950
.إن كنت تريد خصمًا، فأنا غريمك

151
00:10:01,200 --> 00:10:04,660
.وقعتَ ضحيّة لاستفزازاتي أخيرًا أيّها الرّقيق

152
00:10:05,370 --> 00:10:08,040
...ذلك السّاكاباتو سيف غريب بالفعل

153
00:10:08,540 --> 00:10:10,630
لكنّي الآن صرت قادرًا على القتل
.بذريعة حماية النّفس

154
00:10:13,710 --> 00:10:19,510
يحتاج السّيّاف لقتل رجل من حين
.لآخر ليُبقي على حدّة حواسه

155
00:10:24,430 --> 00:10:25,350
!كنشين

156
00:10:30,650 --> 00:10:33,610
.هكذا إذًا. كان مزيّفًا

157
00:10:33,610 --> 00:10:34,480
.نعم

158
00:10:34,730 --> 00:10:37,950
،كنتُ مشغولاً بتداعيات حرب سينان

159
00:10:37,950 --> 00:10:40,660
.ولم أستطع المرور عليك حتّى هذا اليوم

160
00:10:40,660 --> 00:10:43,780
،لكن لو أنّي فكّرت في الأمر مليًّا
.لوجب عليّ اكتشافه

161
00:10:43,780 --> 00:10:47,120
.هيمورا رجل لم يحمل يومًا سيفًا بهذا الشّرّ

162
00:10:48,120 --> 00:10:52,670
صحيح أنّه قتل ما يكفي من النّاس
.ليكتسب لقب الهيتوكيري باتّوساي

163
00:10:53,250 --> 00:10:57,340
.لكنّه لم يقتل يومًا رجلاً لمصلحته الخاصّة

164
00:10:57,840 --> 00:11:00,760
.كان كلّ شيء من أجل فترة ميجي الجديدة

165
00:11:01,180 --> 00:11:05,430
إنّه بطل أنقذ أرواح العديد
.من المحاربين الثّوريّين بسيفه

166
00:11:06,310 --> 00:11:09,850
.ما كانت الثّورة لتنجح لولاه

167
00:11:13,360 --> 00:11:19,400
أردت العثور عليه والتّرحيب به بصفته ضابطًا
.عالي المستوى في قوّات الجيش الإمبراطوريّ

168
00:11:19,400 --> 00:11:21,820
...بشأن ذلك، تمّ إحضار الجناة في الحقيقة

169
00:11:22,280 --> 00:11:26,160
،أمام مركز الشّرطة في الصّباح الباكر

170
00:11:26,160 --> 00:11:28,790
.ما زلنا لا نعرف من الّذي أمسك بهم

171
00:11:29,370 --> 00:11:32,580
وبعد التّحقيق، ذكر أولئك الأشخاص
."أنّ "الحقيقيّ نال منهم

172
00:11:32,790 --> 00:11:33,790
ماذا؟

173
00:11:33,790 --> 00:11:37,340
لكنّي واثق أنّه مجرّد هراء من مجرمين
.لا يمكن أن نثق بهم

174
00:11:38,920 --> 00:11:40,300
!لدينا مشكلة يا رئيس الشّرطة

175
00:11:40,550 --> 00:11:43,470
!أيّها الغبيّ! لدينا ضيف في المركز
!اطرق أوّلاً على الباب على الأقلّ

176
00:11:43,800 --> 00:11:47,470
أنا جدّ آسف! ولكنّ رجاء الشّرطة
...الحاملين للسّيف

177
00:11:47,470 --> 00:11:50,390
تسبّب أوجيكي بفوضى أخرى، صحيح؟

178
00:11:50,890 --> 00:11:54,020
رجال الشّرطة الحاملين للسّيف؟
.لم أسمع بهم

179
00:11:54,270 --> 00:11:57,440
صحيح. إنّها فرقة تمّ إنشاؤها
وفق أوامر من المقرّ الرّئيسيّ

180
00:11:57,440 --> 00:12:00,240
.للتّعامل مع الواقعة الحاليّة

181
00:12:00,610 --> 00:12:02,450
،لكنّهم جميعًا قساة

182
00:12:02,450 --> 00:12:05,410
...وقائدهم من ساتسوما و

183
00:12:05,950 --> 00:12:07,990
.ومناصر إمبراطوريّ

184
00:12:07,990 --> 00:12:09,700
...من الصّعب التّعامل معه

185
00:12:11,000 --> 00:12:13,750
صُنّف المناصرون الإمبراطوريّون
إلى خمس مجموعات بشكل عامّ

186
00:12:13,750 --> 00:12:15,540
...وفق المكان الّذي أتوا منه

187
00:12:15,920 --> 00:12:19,460
ساتوما وتشوشو وتوسا وهيزن

188
00:12:19,460 --> 00:12:21,840
.وآخرون من أماكن مثل ميتو وفوكووكا

189
00:12:22,340 --> 00:12:23,970
من بينها، ساتسوما وتشوشو

190
00:12:23,970 --> 00:12:27,680
الّذين خدموا كفصيلين عظيمين
.لحكومة ميجي لوقت طويل

191
00:12:28,310 --> 00:12:30,890
في هذا الوقت، سلطة ساتسوما ضمن الشّرطة

192
00:12:30,890 --> 00:12:35,440
.وسلطة تشوشو ضمن الجيش كانتا مطلقتين

193
00:12:36,690 --> 00:12:40,650
.فهمت. شخص من ساتسوما محارب ثوريّ

194
00:12:40,650 --> 00:12:42,440
.لا يمكن فعل أيّ شيء حيال وقاحته

195
00:12:43,650 --> 00:12:46,240
ولكن، ما الّذي فعله هذه المرّة؟

196
00:12:46,740 --> 00:12:48,740
...إنّه... في الحقيقة

197
00:12:49,030 --> 00:12:53,080
.هُزم على يد سيّاف واحد فقط

198
00:12:53,370 --> 00:12:55,080
!ماذا؟ مستحيل

199
00:12:55,080 --> 00:12:58,040
رجال الشرطة الحاملين للسّيف
!هم نخبة هذا المركز

200
00:12:58,250 --> 00:12:59,840
.لكن هذه هي الحقيقة

201
00:13:00,340 --> 00:13:02,170
.لا أصدّق

202
00:13:02,170 --> 00:13:04,510
ومن يكون هذا الرّجل؟

203
00:13:04,510 --> 00:13:05,760
.لا أدري

204
00:13:06,180 --> 00:13:10,350
إنّه رجل رقيق الملامح، قصير القامة
...ورفيع الجسد وله شعر أحمر

205
00:13:11,180 --> 00:13:14,350
.ومهارته في المسايفة كانت سريعة كالبرق

206
00:13:14,940 --> 00:13:17,400
،صحيح، إن أسعفتني الذّاكرة

207
00:13:17,400 --> 00:13:19,520
له ندبة كبيرة على شكل تقاطع
!على خدّه الأيسر

208
00:13:21,150 --> 00:13:22,320
...هذا لا يعقل

209
00:13:25,570 --> 00:13:27,450
.إ-إنّه قويّ

210
00:13:28,780 --> 00:13:32,080
أيّها الوغد. كنّا نتساهل معك
.بما أنّنا كنّا نفوقك عددًا

211
00:13:32,080 --> 00:13:33,540
!لا تغترّ بنفسك

212
00:13:33,870 --> 00:13:35,920
!إليك أسلوب سيكيري إيتّو-ريو

213
00:13:36,250 --> 00:13:38,420
!وأسلوب ياجيو شيشيكاغي-ريو

214
00:13:38,420 --> 00:13:40,590
!وأسلوب شيندو كينن-ريو

215
00:13:51,350 --> 00:13:52,810
.بقي واحد

216
00:13:53,430 --> 00:13:54,980
!واحد فقط! نل منه

217
00:13:54,980 --> 00:13:57,810
ماذا كنتم تقولون عن الشّرطة
!حاملي السّيف؟ أوسعهم ضربًا

218
00:13:58,060 --> 00:14:02,900
أقسم لسكّان البلدة أنّكم لن
...تعاملوهم باضطهاد لو سحمت

219
00:14:03,570 --> 00:14:05,490
.وستنتهي الأمر على هذا

220
00:14:06,070 --> 00:14:08,740
.وبعد ذلك، يمكنك اعتقالي كما تشاء

221
00:14:08,950 --> 00:14:12,200
لا تعبث معي! لا يمكنني فعل
!شيء مثير للشّفقة كهذا

222
00:14:13,160 --> 00:14:14,200
...تلك الوضعيّة

223
00:14:15,410 --> 00:14:17,160
،أسلوب السّيف الأقوى في ساتسوما، جيغن-ريو

224
00:14:17,160 --> 00:14:18,710
!ويُعرف أنّه لا يحتاج لضربات ثانية

225
00:14:19,210 --> 00:14:20,080
.توقّف يا أوجيكي

226
00:14:20,330 --> 00:14:21,630
—ذلك الرّجل

227
00:14:21,630 --> 00:14:23,460
.يا له من رجل أحمق

228
00:14:23,460 --> 00:14:26,380
صحيح أنّ جيغن-ريو هو أسلوب
.سيف قويّ لا نظير له

229
00:14:26,380 --> 00:14:28,430
!تشيستو

230
00:14:28,430 --> 00:14:29,260
...ولكن

231
00:14:29,720 --> 00:14:34,220
كلّ ذلك لا معنى له في مواجهة
.أسلوب هيتن ميتسوروغي-ريو

232
00:14:43,270 --> 00:14:44,110
!كنشين

233
00:14:44,940 --> 00:14:46,280
لم تصابي بأيّ أذى، صحيح؟

234
00:14:46,740 --> 00:14:48,740
أورو؟ -
!كنتَ رائعًا أيّها الشّابّ -

235
00:14:48,740 --> 00:14:50,240
من أين أنت أيّها السّيّاف؟

236
00:14:50,240 --> 00:14:51,700
!تعال واشرب معنا

237
00:14:53,950 --> 00:14:54,870
!هيمورا

238
00:14:56,950 --> 00:14:58,960
.التقيتك أخيرًا

239
00:14:59,540 --> 00:15:01,420
.كنتُ أبحث عنك طوال عشر سنين

240
00:15:01,920 --> 00:15:05,210
.أرى أنّك قرّرت أن تربّي شاربًا يا ياماغاتا-سان

241
00:15:05,210 --> 00:15:08,470
...ماذا؟ ياماغاتا؟ هل يُعقل

242
00:15:08,510 --> 00:15:12,390
الجنرال السّابق للجيش الأقوى
،في الثّورة المعروف بالكيهيتاي

243
00:15:12,390 --> 00:15:14,760
.والجنرال الحاليّ لجيش حكومة ميجي

244
00:15:14,760 --> 00:15:17,430
!المناصر الإمبراطوريّ ياماغاتا أريتومو

245
00:15:18,310 --> 00:15:20,440
.أخل المنطقة أيّها الرّئيس

246
00:15:20,440 --> 00:15:21,270
!حاضر

247
00:15:21,480 --> 00:15:23,020
!هيّا! انتشروا! انتشروا

248
00:15:23,020 --> 00:15:24,900
!ماذا؟ إنّك تضطهدنا

249
00:15:24,900 --> 00:15:26,230
!إلى اللّقاء أيّها الشّابّ

250
00:15:26,530 --> 00:15:28,690
.لديّ عربة بانتظاري هناك

251
00:15:29,400 --> 00:15:33,660
ينتظر العديد من المحاربين
.الثّوريّين عودتك بفارغ الصّبر

252
00:15:34,990 --> 00:15:35,830
...هيّا

253
00:15:40,790 --> 00:15:42,040
...أنا آسف

254
00:15:43,130 --> 00:15:47,550
.لا نيّة لي أن أخدم بشرف كشخص يقتل الآخرين

255
00:15:48,460 --> 00:15:49,550
ما الّذي تقوله؟

256
00:15:49,550 --> 00:15:53,680
رغم أنّك قتلت من قبل، وكنت
!جزءًا مهمًّا من الثّورة العظمى

257
00:15:54,220 --> 00:15:57,390
!صحيح أنّ البعض يزدريك ويصفك بالقاتل

258
00:15:57,390 --> 00:15:59,100
—لكنّي سأتعامل مع أولئك شخـ

259
00:15:59,100 --> 00:16:01,390
.ستجبرهم على الاستسلام كضابط حكوميّ

260
00:16:02,730 --> 00:16:07,650
هذا النّوع من الغرور هو ما يسمح
.لأمثاله من الرّجال بفعل ما يحلو له

261
00:16:08,400 --> 00:16:11,280
لم يكن ذلك من أجل واجب مشرّف
.كضابط حكوميّ أو من أجل القوّة

262
00:16:11,650 --> 00:16:14,620
حملنا سيوفنا وقاتلنا

263
00:16:14,620 --> 00:16:18,330
.لبناء وحماية عالم يعيش فيه النّاس بسعادة

264
00:16:18,790 --> 00:16:24,710
،إن نسيت ذلك يا ياماغاتا-سان
.فلن نكون سوى مُغتني حرب لا غير

265
00:16:30,970 --> 00:16:32,260
!مهلاً يا هيمورا

266
00:16:32,550 --> 00:16:34,220
!تغيّر الزّمن

267
00:16:34,220 --> 00:16:35,970
!نحن في فترة ميجي الجديدة

268
00:16:36,180 --> 00:16:39,180
،مرسوم منع حمل السّيف قائم
!وما عاد هنالك وجود للسّاموراي

269
00:16:39,180 --> 00:16:42,350
هذه الفترة مختلفة عن فترة باكوماتسو
!حيث كان للسّيوف صيت أعلى

270
00:16:42,350 --> 00:16:46,440
بدون قوّة الضّبّاط الحكوميّين
،في فترة ميجي هذه

271
00:16:46,440 --> 00:16:48,440
!لا يمكنك فعل أيّ شيء بسيف واحد

272
00:16:51,490 --> 00:16:53,110
...حتّى بسيف واحد

273
00:16:56,120 --> 00:17:01,330
أستطيع على الأقلّ حماية أولئك
.الّذين يقع عليه نظري لو سمحت

274
00:17:03,000 --> 00:17:05,750
.لم أتغيّر أبدًا، أنا نفس الرّجل في الماضي أو الحاضر

275
00:17:06,580 --> 00:17:10,090
.فيما عدى تحوّلي من هيتوكيري إلى روروني

276
00:17:17,640 --> 00:17:18,470
...يا رئيس الشّرطة

277
00:17:18,970 --> 00:17:22,390
أعلم. نظرة واحدة من ردّ فعل سكّان البلدة

278
00:17:22,390 --> 00:17:24,850
.تجعل من الواضح تحديد على من يقع اللّوم

279
00:17:25,440 --> 00:17:28,400
.حتّى أنّ سيفه أكثر أمانًا من سيوف القصب

280
00:17:29,020 --> 00:17:30,190
.سأغضّ النّظر هذه المرّة

281
00:17:30,690 --> 00:17:31,820
.أعتذر منك

282
00:17:32,070 --> 00:17:35,030
،ولكن نظرًا لقضيّة المزيّف وما إلى ذلك

283
00:17:35,030 --> 00:17:39,780
.افترضتُ أنّ الهيتوكيري باتّوساي شخص شرّير وخطير

284
00:17:41,410 --> 00:17:44,250
.لكنّ الحقيقيّ مختلف كلّ الاختلاف

285
00:17:47,080 --> 00:17:49,710
.أودّ الاعتذار منك يا كاورو-دونو لو سمحت

286
00:17:49,710 --> 00:17:50,750
عمّاذا؟

287
00:17:51,090 --> 00:17:52,340
.بشأن شريطك

288
00:17:52,840 --> 00:17:55,380
.لقد قطعه بسببي

289
00:17:56,760 --> 00:18:00,970
لا بأس بذلك ما دمت ستعمل
.بجدّ للقيام بواجباتك في المقابل

290
00:18:01,760 --> 00:18:03,560
.بإمكانك الذّهاب للتّسوّق كبداية

291
00:18:03,560 --> 00:18:05,180
لم تذهب بعد، صحيح؟

292
00:18:05,480 --> 00:18:08,900
وعندما تعود، سيكون عليك
.إدخال كلّ الغسيل الجافّ

293
00:18:13,820 --> 00:18:18,530
أعتقد أنّني أفهم ولو قليلاً
.لماذا اختار كنشين طريق الرّوروني

294
00:18:20,370 --> 00:18:25,290
فليحمي النّاس بسيفه ذاك بحرّيّة
،دون أن يعيقه أيّ شيء

295
00:18:26,250 --> 00:18:28,710
.اختار العيش مع التّيّار

296
00:18:28,710 --> 00:18:30,880
.لهذا السّبب هو رحّالة

297
00:18:39,300 --> 00:18:42,140
،ما زلت تملك ملامح طفل صغير

298
00:18:42,140 --> 00:18:44,600
.لكنّ قلبك قلب رجل شجاع إن سمحت لي

299
00:18:44,930 --> 00:18:46,180
...ضدّ كاورو-دونو

300
00:18:46,810 --> 00:18:47,850
...وسكّان البلدة

301
00:18:48,480 --> 00:18:51,020
!فإنّ ذلك السّيف لن يمسّ شعرة منهم

302
00:18:51,690 --> 00:18:54,690
.إن كنت تريد خصمًا، فأنا غريمك

303
00:18:56,150 --> 00:18:57,070
.سُحقًا

304
00:19:05,160 --> 00:19:09,750
.لا قيمة لك عندي ما لم تحضر لي مالي

305
00:19:16,880 --> 00:19:18,170
.ها قد عدت

306
00:19:29,440 --> 00:19:30,390
.ذلك الصّغير

307
00:19:31,190 --> 00:19:33,060
!لستُ صغيرًا

308
00:19:33,060 --> 00:19:35,610
!أنا سليل ساموراي طوكيو ميوجين ياهيكو

309
00:19:36,070 --> 00:19:39,360
!لم أبلغ الحضيض بعد حتّى يشفق عليّ الآخرون

310
00:19:42,240 --> 00:19:43,700
،لم يتغيّر الزّمن

311
00:19:43,700 --> 00:19:47,160
كان ليصير واحدًا من أفضل
.السّاموراي عندما يكبر

312
00:20:15,730 --> 00:20:16,570
.سُحقًا

313
00:20:17,190 --> 00:20:18,650
.ياهيكو

314
00:20:20,110 --> 00:20:25,070
.حلّ المساء. هيّا، ادفع ما عليك من مال

315
00:20:25,320 --> 00:20:27,030
.ليس معي -
ماذا؟ -

316
00:20:27,240 --> 00:20:28,870
.اكتفيت من نشل الجيوب

317
00:20:28,870 --> 00:20:31,040
.سأقطع كلّ علاقاتي معم أيّها الياكوزا أيضًا

318
00:20:31,250 --> 00:20:33,120
—ماذا؟ ما الّذي تتحدّ

319
00:20:47,970 --> 00:20:50,220
ماذا تقصد بكلامك هذا؟

320
00:20:52,230 --> 00:20:54,190
.لا أقصد أيّ شيء آخر

321
00:20:57,400 --> 00:21:01,280
سئمت فحسب من شيء بائس
.جدًّا مثل نشل الجيوب

322
00:21:04,570 --> 00:21:07,320
.أنت لا تروق لي. وقاحتك لا نظير لها

323
00:21:07,660 --> 00:21:09,330
.لن تجد فرصة أفضل من هذه

324
00:21:09,740 --> 00:21:13,750
.سآخذ وقتي وأريك من السّيّد هنا

325
00:22:46,050 --> 00:22:49,010
."في الحلقة القادمة: "كاشّين-ريو، يولد من جديد