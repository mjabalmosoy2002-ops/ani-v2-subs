1
00:00:08,980 --> 00:00:12,780
،قائد الوحدة الثّالثة للشّينسنغومي
...سايتو هاجيمي

2
00:00:14,700 --> 00:00:15,570
...ها أنا ذا

3
00:00:16,410 --> 00:00:18,240
.أيّها الهيتوكيري باتّوساي

4
00:00:27,540 --> 00:00:31,130
!كنشين

5
00:00:34,010 --> 00:00:37,340
"سيف بسيط قويّ"

6
00:00:34,470 --> 00:00:35,970
.عدتُ من التّدريب في الخارج

7
00:00:36,470 --> 00:00:38,260
!هيّا، قف بسرعة

8
00:00:42,020 --> 00:00:42,930
أورو؟

9
00:00:42,930 --> 00:00:44,520
لماذا أنت شارد هكذا؟

10
00:00:44,520 --> 00:00:48,020
!أنت! نحن نتحدّث إليك
هل هناك كنشين آخر؟

11
00:00:48,270 --> 00:00:50,860
.حسنًا، لنعد للمنزل بسرعة –
...أورو –

12
00:02:21,990 --> 00:02:26,000
الحلقة الثّانية والعشرين
عودة الذّئب للحياة

13
00:02:26,950 --> 00:02:28,160
شينسنغومي؟

14
00:02:28,660 --> 00:02:31,080
،لاحظتُ أنّك تنام بعمق أكبر من المعتاد

15
00:02:31,080 --> 00:02:32,840
لكنّك كنت تحلم بماضيك؟

16
00:02:33,340 --> 00:02:37,090
.مرّ وقت مذ راودني علم من أيّام باكوماتسو

17
00:02:37,590 --> 00:02:43,100
قلتَ الشّينسنغومي، فهل تقصد المجموعة
المعروفة بعدائها لمناصري الإمبراطوريّة؟

18
00:02:43,720 --> 00:02:47,220
.نعم. أعداؤنا اللّدودين

19
00:02:47,220 --> 00:02:49,480
.دارت بيننا معارك كثيرة

20
00:02:50,020 --> 00:02:51,730
"إيكِدايا"

21
00:02:50,730 --> 00:02:55,440
كانت الشّينسنغومي مجموعة متكوّنة
.من سيّافين من منطقة تاما في الأصل

22
00:02:55,440 --> 00:02:58,570
وحدة احتُفظ بها كجيش للدّفاع
.عن كيوتو تابعة للشّوغونيّة

23
00:03:00,030 --> 00:03:02,700
كان المحاربون الثّوريّون يقاتلون
.بشكل مستقلّ حينها

24
00:03:02,700 --> 00:03:05,950
ونتيجة لذلك، تحوّلت كيوتو
،إلى معقل لمجازر دمويّة

25
00:03:05,950 --> 00:03:08,290
عاصمةً شيطانيّة تدور فيها معارك
.سيوف على الدّوام

26
00:03:10,040 --> 00:03:14,590
.حملوا السّيوف لحماية سلام كيوتو

27
00:03:15,750 --> 00:03:23,510
"صدق"

28
00:03:16,500 --> 00:03:18,630
."كانت أعلامهم قرمزيّة كُتب عليها عبارة "صدق

29
00:03:19,130 --> 00:03:21,510
وارتدوا معاطف زرقاء فاتحة
.قصيرة بخطوط مسنّنة

30
00:03:22,590 --> 00:03:26,430
كانت مهاراتهم في المسايفة وروحهم
،القتاليّة الّتي لا تخشى الموت ممتازين

31
00:03:26,430 --> 00:03:29,770
.زرعت ذئاب ميبو الخوف في كلّ كيوتو

32
00:03:30,890 --> 00:03:34,900
لكنّهم اختفوا مع مرور الوقت
.بعد أن هُزموا من الأسلحة المعاصرة

33
00:03:35,400 --> 00:03:38,780
لكنّهم كانوا أعظم وأقوى

34
00:03:38,780 --> 00:03:41,990
وآخر مجموعة سيّافين
.على الأرجح في تاريخ اليابان

35
00:03:43,280 --> 00:03:47,370
لكنّي سمعتُ أنّ الشّينسنغومي
برعوا أكثر في القتال الجماعيّ

36
00:03:47,370 --> 00:03:49,620
.حيث يهاجم عدّة أعضاء هدفًا واحدًا

37
00:03:50,160 --> 00:03:51,870
.لا يبدو ذلك عادلاً

38
00:03:52,330 --> 00:03:56,290
.كانت أولويّتهم هي حفظ السّلام في كيوتو

39
00:03:56,840 --> 00:04:01,720
.بالطّبع ما كانوا ليخوضوا قتالاً عادلاً

40
00:04:02,170 --> 00:04:05,930
،رغم أنّ النّاس أشادوا بقوّتهم
.كانت هناك اختلافات بينهم

41
00:04:06,640 --> 00:04:10,140
لكنّ طبقة الضّبّاط، وبالأخصّ الّذين
...يشاركون في المعارك بالفعل

42
00:04:10,520 --> 00:04:14,850
مثل قادة الوحدات الأولى والثّانية
.والثّالثة، كانوا أقوياء بدون أدنى شكّ

43
00:04:16,560 --> 00:04:19,020
،قاتلتهم عدّة مرّات رجلاً لرجل

44
00:04:19,020 --> 00:04:22,070
لكنّي لم أستطع تسوية الحساب
.مع أيّ منهم

45
00:04:23,030 --> 00:04:25,740
...سمعتُ أنّ معظم هؤلاء الضّبّاط ماتوا بالفعل

46
00:04:26,240 --> 00:04:27,780
.ولا يزال ذلك يفطر الفؤاد

47
00:04:28,530 --> 00:04:31,000
.يبدو أنّ رأيك عنهم إيجابيّ جدًّا

48
00:04:31,000 --> 00:04:32,290
كانوا أعداءك، صحيح؟

49
00:04:32,750 --> 00:04:33,750
...نعم

50
00:04:34,250 --> 00:04:35,500
.بطبيعة الحال

51
00:04:36,210 --> 00:04:38,590
.لقد كانوا أعدائي بالفعل إن جاز التّعبير

52
00:04:38,590 --> 00:04:39,960
.لكنّي لا أحمل أيّ ضغائن تجاههم

53
00:04:40,460 --> 00:04:41,920
،كانت ظروفنا مختلفة

54
00:04:41,920 --> 00:04:46,390
لكن لا يوجد اختلاف بشأن قتالنا ونحن
.نضع حياتنا وقناعاتنا على حدّ سيفنا

55
00:04:47,640 --> 00:04:52,020
ربّما أشعر أنّي أقرب إليهم أكثر ممّا أنا
عليه بالنّسبة للمحاربين الثّوريّين

56
00:04:52,020 --> 00:04:54,600
.الّذين في الحكومة الآن

57
00:04:56,560 --> 00:04:57,730
...هكذا إذًا

58
00:04:58,480 --> 00:05:00,520
هل من الغريب الشّعور بهذا؟

59
00:05:00,520 --> 00:05:03,740
...لا، ذلك ليس صحيحًا بالضّرورة. لكن

60
00:05:04,530 --> 00:05:08,370
كان من غير العادة قليلاً أن نراك
.تتحدّث عن ماضيك هكذا

61
00:05:10,660 --> 00:05:11,950
.حسنًا، لنعد للمنزل

62
00:05:14,120 --> 00:05:18,750
لقد مرّ وقت طويل بالفعل منذ
.آخر مرّة حلمت فيها بذلك الوقت

63
00:05:19,880 --> 00:05:22,380
لماذا تشرد هكذا يا كنشين؟

64
00:05:22,380 --> 00:05:23,880
.لنعد للمنزل بسرعة

65
00:05:24,840 --> 00:05:27,680
.لم تراودني تلك الأحلام مؤخّرًا

66
00:05:28,470 --> 00:05:29,970
لماذا الآن؟

67
00:05:35,140 --> 00:05:39,650
سُحقًا! كنتُ آمل الحصول على
.وجبة مجّانيّة هنا

68
00:05:39,860 --> 00:05:41,900
أين ذهبوا جميعًا؟

69
00:05:41,900 --> 00:05:42,820
!مرحبًا

70
00:05:43,360 --> 00:05:45,950
ماذا؟ من تكون؟

71
00:05:46,400 --> 00:05:48,450
.صحيح... هذه أوّل مرّة تلقاني فيها

72
00:05:48,910 --> 00:05:54,120
أنا بائع أدوية من تاما أبيع دواءً عجيبًا
.يُدعى دواء إيشيدا المسحوق

73
00:05:55,410 --> 00:05:57,120
.اسمي فوجيتا غورو

74
00:05:59,000 --> 00:05:59,880
أتريد بعضه؟

75
00:06:00,170 --> 00:06:03,840
دواء إيشيدا المسحوق هذا ممتاز
—للكدمات والعظام المكسورة

76
00:06:03,840 --> 00:06:07,220
.مهلاً، مهلاً. لا أحد من سكّان هذا المنزل هنا

77
00:06:07,420 --> 00:06:09,760
أهكذا إذًا؟

78
00:06:09,760 --> 00:06:10,890
.كم هذا مؤسف

79
00:06:11,430 --> 00:06:12,600
.أنت

80
00:06:12,600 --> 00:06:13,430
نعم؟

81
00:06:13,640 --> 00:06:17,020
.لا أهتمّ لهذا كثيرًا، لكنّ عينيك ضيّقتان جدًّا

82
00:06:18,690 --> 00:06:20,520
.وُلدتُ بهذين العينين

83
00:06:20,770 --> 00:06:21,860
هكذا إذًا؟

84
00:06:23,230 --> 00:06:24,230
...أخبرني

85
00:06:26,150 --> 00:06:29,860
هذا الثّفن على يدك بسبب استعمال سيوف
.الخيزران لا يناسب بائع أدوية مثلك إطلاقًا

86
00:06:29,860 --> 00:06:32,320
لم تولد به أيضًا، صحيح؟

87
00:06:32,700 --> 00:06:34,950
من تكون يا هذا؟

88
00:06:37,620 --> 00:06:41,790
.أرى أنّك حادّ النّظر كعادتك يا ساغارا سانوسكي-كُن

89
00:06:45,460 --> 00:06:46,710
.هكذا إذًا

90
00:06:46,710 --> 00:06:48,590
.الباتّوساي ليس هنا

91
00:06:48,800 --> 00:06:52,090
.هذا الرّجل يعرف من هو كنشين

92
00:06:52,800 --> 00:06:53,930
...في تلك الحالة

93
00:06:56,100 --> 00:06:58,310
.عليّ ترك هديّة وداع

94
00:06:59,810 --> 00:07:02,060
كنتَ تخفي شيئًا كهذا؟

95
00:07:02,730 --> 00:07:05,480
.أتيت إلى هنا وأنت عازم تمامًا على القتال

96
00:07:06,780 --> 00:07:08,070
.حسنًا، لا بأس

97
00:07:08,070 --> 00:07:09,150
!سأواجهك

98
00:07:09,650 --> 00:07:12,820
!سأسألك بقبضتيّ من تكون بالفعل

99
00:07:17,540 --> 00:07:18,500
.هكذا إذًا

100
00:07:19,500 --> 00:07:24,130
لكماتك جيّدة، مناسبة تمامًا لشخص
.عُرف عنه أنّه الأفضل في قتال الشّوارع

101
00:07:24,500 --> 00:07:25,590
...إنّه

102
00:07:26,300 --> 00:07:30,010
.لكنّ ذلك في عالم ميجي المسالم

103
00:07:30,840 --> 00:07:34,350
،خلال فترة باكوماتسو في كيوتو
...هذا المستوى من اللّكم

104
00:07:35,050 --> 00:07:36,390
.ما كان ليحظى بثناء عالٍ

105
00:07:41,850 --> 00:07:44,480
لماذا تسير ببطء يا كنشين؟

106
00:07:44,480 --> 00:07:47,110
!إنّك تماطل، تكاد الشّمس تغرب الآن

107
00:07:47,570 --> 00:07:49,690
.إنّه يبدو كئيبًا بالفعل

108
00:07:49,690 --> 00:07:51,070
هل معدته تؤلمه؟

109
00:07:51,570 --> 00:07:54,620
.ماذا؟ إن كان الأمر كذلك، فهذا صار شأني الآن

110
00:07:54,620 --> 00:07:58,040
مـ-ميغومي-سان! لماذا أنت هنا؟

111
00:07:58,040 --> 00:08:00,040
لماذا أنت متفاجئة؟

112
00:08:00,040 --> 00:08:01,790
.هذا طريق عامّ

113
00:08:02,290 --> 00:08:04,420
هل من سبب يمنعني من السّير عليه؟

114
00:08:04,790 --> 00:08:06,290
.أمزح فحسب

115
00:08:06,290 --> 00:08:09,510
،في الحقيقة، لديّ إجازة من العمل اليوم وغدًا

116
00:08:09,510 --> 00:08:11,340
.لذلك أردت قضاء الوقت معكم

117
00:08:12,010 --> 00:08:14,300
!مستحيل! لا يُسمح بأيّ ثعالب ماكرة معنا

118
00:08:14,800 --> 00:08:19,430
ماذا؟ من الّتي تعالج جراحكم
في كلّ مرّة يحدث فيها أيّ شيء؟

119
00:08:19,430 --> 00:08:21,060
وبدون أيّ مقابل أيضًا؟

120
00:08:22,140 --> 00:08:24,560
أنت لا تمانع، صحيح يا ياهيكو-كُن؟

121
00:08:24,560 --> 00:08:26,520
.أستطيع إعداد العشاء لكم

122
00:08:26,730 --> 00:08:28,480
.لا بأس يا كاورو

123
00:08:28,480 --> 00:08:29,610
.لا تكوني مثيرة للشّفقة

124
00:08:29,610 --> 00:08:31,240
!يا لك من خائن

125
00:08:31,400 --> 00:08:34,660
أخبرني يا كِن-سان، لن تمانع
إن قضيت الوقت معكم، صحيح؟

126
00:08:37,830 --> 00:08:40,700
.يبدو لي أنّك تفتقر للحماسة قليلاً

127
00:08:40,700 --> 00:08:42,710
هل أقوم بفحصك إن كنت لا تمانع؟

128
00:08:43,040 --> 00:08:44,670
.لا، أنا بخير

129
00:08:44,670 --> 00:08:46,670
.لا أعاني من أيّ خطب

130
00:08:49,090 --> 00:08:51,170
.لا يجب أن أدع الأمر يزعجني

131
00:08:51,170 --> 00:08:53,300
.إنّي أدفع جميع من حولي للقلق لا غير

132
00:08:54,550 --> 00:08:59,560
لا فائدة من التّفكير في الأمر مطوّلاً
.فقط لأنّ حلمًا عن الماضي راودني

133
00:09:00,100 --> 00:09:02,020
...مستحيل أن أجد إجابة على

134
00:09:04,480 --> 00:09:05,310
ما هذا؟

135
00:09:05,770 --> 00:09:07,350
ما الّذي حدث هنا؟

136
00:09:11,190 --> 00:09:12,150
...رائحة دماء

137
00:09:15,740 --> 00:09:16,570
!سانو

138
00:09:29,420 --> 00:09:32,920
"مطعم تسوكيوا"

139
00:09:29,590 --> 00:09:32,920
.لنشرب قليلاً يا فوجيتا-كُن

140
00:09:33,550 --> 00:09:38,180
أم أنّه عليّ مناداتك سايتو-كُن في هذه الحالة؟

141
00:09:38,840 --> 00:09:40,350
.نادني بما تجده مناسبًا

142
00:09:40,850 --> 00:09:43,850
.لكنّي سأعتذر عن شرب السّاكي

143
00:09:44,140 --> 00:09:47,560
هل قدرة تحمّلك له ضعيفة؟
.لم أتوقّع هذا

144
00:09:48,060 --> 00:09:50,810
.لا، الأمر ليس كذلك على الإطلاق

145
00:09:51,520 --> 00:09:55,740
تراودني رغبة شديدة في قتل
.الآخرين عندما أثمل لا غير

146
00:10:00,030 --> 00:10:02,410
.هذا يطمئنني كثيرًا

147
00:10:04,160 --> 00:10:07,000
.سأدخل صلب الموضوع مباشرة

148
00:10:07,000 --> 00:10:09,170
—إنّ هيمورا الباتّوساي الآن

149
00:10:09,170 --> 00:10:12,670
يمكث في مكان يُدعى دوجو كاميا، صحيح؟

150
00:10:12,670 --> 00:10:14,090
.ذهبت لزيارته هذه الظّهيرة

151
00:10:14,090 --> 00:10:14,920
!هكذا إذًا

152
00:10:15,380 --> 00:10:17,380
.لكنّ الباتّوساي لم يكن هناك

153
00:10:17,630 --> 00:10:21,220
كلّ احترامي للقائد السّابق للوحدة
.الثّالثة للشّينسنغومي

154
00:10:21,600 --> 00:10:26,600
.بصراحة، كنتُ متفاجئًا من تعاونك معنا

155
00:10:26,980 --> 00:10:31,060
ولكنّك بالفعل شخص يمكنني
.الاعتماد علي لإتمام أعمالي

156
00:10:31,520 --> 00:10:34,020
.بالحديث عن التّفاجؤ، كنتُ متفاجئًا أنا أيضًا

157
00:10:34,480 --> 00:10:38,860
العقل المدبّر وراء قضيّة كوروساغا
...والموظّف خلف مسألة أودو جين-إي

158
00:10:38,860 --> 00:10:42,740
كان أنت في الحقيقة يا أمين مجلس
.الشّيوخ شيبومي-سان

159
00:10:43,490 --> 00:10:48,290
حسنًا، تجري أمور عديدة
.في كواليس حكومة ميجي

160
00:10:48,290 --> 00:10:49,580
.ذلك ما يبدو

161
00:10:50,080 --> 00:10:53,670
لكن لا علاقة لهذا الأمر بي
.أنا الخاسر في الثّورة

162
00:10:54,840 --> 00:11:01,180
يكفيني عيش سنواتي المتبقّية الّتي حصلت
.عليها بشكل غير متوقّع بطريقة مسلّية

163
00:11:01,640 --> 00:11:04,390
،القتل هو اختصاصي

164
00:11:04,390 --> 00:11:08,180
لذا ما كنتُ لأتمنّى عملاً جانبيًّا أفضل
.أقبض منه مقابل كلّ عملية قتل

165
00:11:08,890 --> 00:11:14,270
وفوق ذلك، أوّل عملي لي هو القضاء
...على عدوّي اللّدود

166
00:11:18,780 --> 00:11:21,660
.ومع ذلك، هناك شيء واحد لا يبدو منطقيًّا لي

167
00:11:22,280 --> 00:11:26,990
ترك فرصة حصوله على السّلطة
.مقابل أن يصير روروني

168
00:11:27,620 --> 00:11:29,410
فلماذا تتكبّد عناء قتله؟

169
00:11:29,410 --> 00:11:31,460
من الزّبون الّذي قدّم طلبًا كهذا؟

170
00:11:31,460 --> 00:11:32,460
!أنت

171
00:11:32,960 --> 00:11:33,960
.المعذرة

172
00:11:34,340 --> 00:11:35,920
.سأهتمّ بشؤوني فحسب

173
00:11:36,590 --> 00:11:39,220
.لا عليك. لا بأس إن كنت تفهم الوضع

174
00:11:39,220 --> 00:11:44,350
،والآن، لنترك الحديث عن العمل جانبًا
!ودعنا نستمتع بوقتنا هنا

175
00:11:44,850 --> 00:11:49,560
عفوًا، عليّ العودة لعملي الرّئيسيّ
.أو قد أجلب الشّبهات إليّ

176
00:11:54,560 --> 00:11:57,530
...أنا أستأذن الآن

177
00:12:03,320 --> 00:12:08,160
،القائد السّابق للوحدة الثّالثة للشّينسنغومي
.سايتو هاجيمي

178
00:12:08,160 --> 00:12:11,160
.تبنّى اسم فوجيتا غورو بعد الثّورة

179
00:12:11,160 --> 00:12:14,540
كان ضمن فرقة السّيّافين في شرطة
المدينة خلال حرب سينان

180
00:12:14,540 --> 00:12:16,840
.وهو يخدم الآن كمفتّش مساعد

181
00:12:17,290 --> 00:12:24,180
يُقال أنّه كان أقوى حتّى من أوكيتا سوجي
.المعروف بأقوى رجل في الشّينسنغومي

182
00:12:24,840 --> 00:12:28,560
.حتّى جين-إي لم يستطع هزيمة الباتّوساي

183
00:12:29,010 --> 00:12:30,640
...لكنّه قد

184
00:12:31,270 --> 00:12:33,140
.لا يروق هذا لي

185
00:12:33,140 --> 00:12:35,270
.إنّه خانع بشكل غريب

186
00:12:35,520 --> 00:12:38,860
.لا تكن متحيّزًا هكذا يا أكاماتسو

187
00:12:38,860 --> 00:12:40,480
.يجب أن تكونا على وفاق

188
00:12:41,690 --> 00:12:44,530
،إن سار القضاء على الباتّوساي كما يجب

189
00:12:44,530 --> 00:12:48,830
أستطيع أخيرًا توديع عمل قذر
.مثل اغتيال شخصيّات قياديّة

190
00:12:49,330 --> 00:12:51,910
من الممتع أنّ من سيقوم بذلك

191
00:12:51,910 --> 00:12:57,290
هو شخص من الشّينسنغومي
.الّذين هدّدوني كثيرًا

192
00:12:57,920 --> 00:13:01,590
كان الجميع يخشى الشّينسنغومي
،المعروفين بذئاب ميبو

193
00:13:02,090 --> 00:13:05,380
،ولكن في فترة ميجي
.صاروا كلابًا منزليّة بدون أنياب

194
00:13:10,640 --> 00:13:12,680
.المكان مظلم جدًّا
!لا يمكنني رؤية الجرح جيّدًا

195
00:13:12,680 --> 00:13:15,230
لا أهتمّ إن كانت شمعة أو أيّ شيء
!آخر، أحتاج لضوء أكثر هنا

196
00:13:15,480 --> 00:13:16,310
!حالاً

197
00:13:30,870 --> 00:13:31,990
هل يُعقل...؟

198
00:13:34,870 --> 00:13:37,370
"بعد ثلاثة أيّام"

199
00:13:41,920 --> 00:13:43,170
.ميغومي-سان

200
00:13:44,130 --> 00:13:45,380
.الحمّام متوفّر

201
00:13:45,880 --> 00:13:49,510
،سأراقب سانوسكي
.لذلك خذي حمّامًا وأريحي نفسك قليلاً

202
00:13:50,930 --> 00:13:51,760
.شكرًا لك

203
00:13:52,470 --> 00:13:53,720
كيف يُبلي؟

204
00:13:54,230 --> 00:13:55,850
.لا جديد

205
00:13:56,350 --> 00:13:58,100
هل كِن-سان في الدّوجو ثانية؟

206
00:13:58,440 --> 00:14:01,650
.نعم. لا جديد حياله أيضًا

207
00:14:01,650 --> 00:14:04,150
تعلو وجهه ملامح مخيفة
.ويفكّر بعمق طوال الوقت

208
00:14:06,400 --> 00:14:10,740
لا يهمّ كيف أفكّر في الأمر، لا أستطيع
.التّفكير في أيّ أحد آخر قد يفعل هذا

209
00:14:11,780 --> 00:14:14,410
صندوق الأدوية ذاك الّذي عليه
رمز مظلّة ودائرة

210
00:14:14,410 --> 00:14:18,210
كان واحدًا من الّتي يستعملها
.الشّينسنغومي كتنكّر

211
00:14:19,040 --> 00:14:21,750
مسار طعن رأس السّيف الموازي للأرض

212
00:14:21,750 --> 00:14:25,550
،هي من علامات الهيرازوكي
.تقنية يتميّز بها أعضاء الشّينسنغومي

213
00:14:26,300 --> 00:14:30,300
وحتّى بين أعضائهم، تلك القوّة المدمّرة

214
00:14:30,300 --> 00:14:35,100
،كانت اختصاصه هو بلا أدنى شكّ
.هيرازوكي اليد اليسرى المنفردة

215
00:14:37,020 --> 00:14:38,020
...بتعبير آخر

216
00:14:44,070 --> 00:14:45,110
.طعنة النّاب

217
00:14:53,870 --> 00:14:57,750
،قائد الوحدة الثّالثة للشّينسنغومي
.سايتو هاجيمي

218
00:14:58,540 --> 00:15:01,210
أتى إلى هنا لتسوية حسابه
.الّذي ظلّ مفتوحًا معي

219
00:15:01,710 --> 00:15:04,960
أم أنّ هدفه كان مختلفًا؟

220
00:15:07,300 --> 00:15:11,510
في كلّ الأحوال، مهاراته في المسايفة
.لم تتدهور على الإطلاق

221
00:15:24,230 --> 00:15:25,440
...بالسّاكاباتو خاصّتي

222
00:15:26,440 --> 00:15:31,030
ورفضي للقتل، فهل سأكون قادرًا على إبعاده؟

223
00:15:38,620 --> 00:15:40,120
.شكرًا على الانتظار

224
00:15:40,330 --> 00:15:41,710
.تفضّل وجبتك

225
00:15:42,210 --> 00:15:43,460
.شكرًا لك

226
00:15:44,290 --> 00:15:46,590
.سأبدأ في الأكل

227
00:15:48,710 --> 00:15:54,390
ماذا؟ زبديّة سوبا واحدة مع الحساء؟
.يا له من غداء رخيص

228
00:15:54,760 --> 00:15:56,470
ألا تظنّ ذلك يا سايتو-سان؟

229
00:15:57,470 --> 00:15:59,680
.أحبّ السّوبا مع الحساء

230
00:16:00,180 --> 00:16:02,350
.واسمي الآن هو فوجيتا

231
00:16:03,100 --> 00:16:07,270
اسمك أكاماتسو-سان، صحيح؟
هل لديك أيّ شيء لأجلي؟

232
00:16:07,860 --> 00:16:09,400
.لا

233
00:16:09,400 --> 00:16:11,610
.لكنّك لا تروق لي

234
00:16:13,280 --> 00:16:18,450
.كان يُفترض بي أنا الاهتمام بهذا

235
00:16:18,450 --> 00:16:22,920
لكنّ السّيّد شيبوني منح هذه
.المهمّة لمبتدئ مثلك

236
00:16:23,210 --> 00:16:26,040
،اسمع. إن كنت ستنجز المهمّة
فقم بذلك بسرعة

237
00:16:26,040 --> 00:16:28,380
.ودعني أراك تنهزم

238
00:16:31,300 --> 00:16:32,420
ما المضحك؟

239
00:16:33,260 --> 00:16:34,510
.المعذرة

240
00:16:35,220 --> 00:16:36,850
.مفهوم

241
00:16:36,850 --> 00:16:41,060
ما رأيك إذًا أن نتعامل معًا لإنجاز هذه المهمّة؟

242
00:16:41,560 --> 00:16:42,560
ماذا؟

243
00:16:43,020 --> 00:16:46,730
.تركت عدّة دلائل خلفي ذلك اليوم

244
00:16:47,360 --> 00:16:52,070
وبطبيعة الحال، سيكون الباتّوساي
.قد لاحظها الآن

245
00:16:52,530 --> 00:16:57,370
واثق أنّه سيلتهم الطّعم
.إن وصلته رسالة منّي الآن

246
00:16:58,120 --> 00:17:00,370
...إذًا فأنت من دبّر لذلك

247
00:17:00,580 --> 00:17:02,660
.وستكون أنت من سيُنهي الأمر

248
00:17:03,330 --> 00:17:04,580
ما رأيك؟

249
00:17:07,630 --> 00:17:09,420
.لست سيّئًا

250
00:17:09,420 --> 00:17:11,300
.لكن ما زال هذا الأمر لا يروقني

251
00:17:12,590 --> 00:17:16,640
.يُفترض بالباتّوساي أن يكون عدوّ الشّينسنغومي

252
00:17:16,640 --> 00:17:20,100
.لا أفهم لماذا قد تسلّمني الأمر بهذه السّهولة

253
00:17:21,310 --> 00:17:24,850
سبق ووصفته بعدوّي من قبل
...أمام شيبومي

254
00:17:25,350 --> 00:17:27,270
.لكنّي لا أهتمّ بذلك على الإطلاق

255
00:17:28,310 --> 00:17:29,610
.سبق وقلتُ هذا

256
00:17:30,320 --> 00:17:35,490
يكفيني عيش سنواتي المتبقّية الّتي حصلت
.عليها بشكل غير متوقّع بطريقة مسلّية

257
00:17:36,240 --> 00:17:40,990
أفضّل نتيجة صغيرة مضمونة
.على مثيلتها الكبيرة المليئة بالمخاطر

258
00:17:41,620 --> 00:17:44,410
.هكذا هو فوجيتا غورو

259
00:17:47,920 --> 00:17:49,670
.أعجبني هذا

260
00:17:49,670 --> 00:17:51,920
.يمكنك اعتباري جزءًا من خطّتك

261
00:17:52,760 --> 00:17:55,630
.لكن أصغ جيّدًا لنصيحتي هذه

262
00:17:56,090 --> 00:18:00,350
!أنا الأكثر مهارة في منظّمتنا

263
00:18:05,140 --> 00:18:06,520
...لسوء الحظّ

264
00:18:07,060 --> 00:18:13,110
لا أهتمّ على الإطلاق بقتالات تافهة
.لضفدع لم يغادر البئر يومًا

265
00:18:14,360 --> 00:18:17,320
"هاجيمي"

266
00:18:19,110 --> 00:18:20,530
!يا كنشين

267
00:18:20,910 --> 00:18:23,410
!تريد منك كاورو الذّهاب لشراء بعض التّوفو

268
00:18:23,870 --> 00:18:25,500
.آسف يا ياهيكو

269
00:18:25,500 --> 00:18:28,500
.لديّ أمر عليّ الاهتمام به الآن

270
00:18:29,000 --> 00:18:32,920
قد أعود متأخّرًا، لذلك احرص
.على إقفال المكان لو سمحت

271
00:18:37,510 --> 00:18:39,180
...و... التّوفو

272
00:18:44,600 --> 00:18:45,430
.سايتو

273
00:18:46,230 --> 00:18:48,270
—كفاك تظاهر واظهر في الحال

274
00:18:52,480 --> 00:18:57,530
.تفاديت سلسلتي بكلّ سهولة
.توقّعت هذا من الباتّوساي

275
00:18:58,490 --> 00:19:00,740
من أنت؟

276
00:19:01,450 --> 00:19:06,200
.أكاماتسو أروندو. الرّجل الّذي سيسلبك حياتك

277
00:19:06,910 --> 00:19:10,920
.من الطّبيعيّ أن يستهدفني النّاس

278
00:19:11,500 --> 00:19:15,090
لكن لا أنوي السّماح لك بسلبي
.حياتي بدون أيّ سبب

279
00:19:15,590 --> 00:19:18,130
.لذلك أودّ سماع هذا السّبب أوّلاً

280
00:19:18,130 --> 00:19:20,180
تسأل عن السّبب؟

281
00:19:20,890 --> 00:19:22,640
.لا داعي للقلق

282
00:19:22,850 --> 00:19:25,680
!سأخبرك به عند قبرك

283
00:19:25,930 --> 00:19:27,890
!أراه! أراه

284
00:19:27,890 --> 00:19:29,020
—أنت على اليسار أيّها الباتّوسا

285
00:19:29,980 --> 00:19:31,600
أقلت "أراه، أراه"؟

286
00:19:32,060 --> 00:19:34,820
هل رأيت مجرّد صورة بعديّة لي؟

287
00:19:35,270 --> 00:19:38,280
.لكنّي لا أظنّ أنّي تحرّكت بتلك السّرعة

288
00:19:42,200 --> 00:19:43,240
ماذا؟

289
00:19:48,290 --> 00:19:49,290
.استسلم

290
00:19:49,790 --> 00:19:52,370
.لا فرصة أمامك لهزيمتي

291
00:19:55,630 --> 00:19:58,420
أجبني. من تكون بالضّبط؟

292
00:19:59,300 --> 00:20:01,930
ما علاقتك بسايتو؟

293
00:20:04,850 --> 00:20:07,060
!أنا آسف! كنتُ مخطئًا

294
00:20:07,060 --> 00:20:09,020
!لا تقتلني رجاءً

295
00:20:09,020 --> 00:20:11,850
!لم أكن أرغب في القيام بهذا حقًّا

296
00:20:12,480 --> 00:20:16,070
،لكنّ سايتو هدّدني
...ولم يكن لديّ أيّ خيار

297
00:20:16,820 --> 00:20:18,570
.مجرّد نكرة

298
00:20:19,280 --> 00:20:24,530
ما الّذي يفكّر فيه سايتو بإرساله لشخص مثله؟

299
00:20:25,240 --> 00:20:26,740
،لا أصدّق كلّ ما قلته

300
00:20:26,740 --> 00:20:28,740
،لكن ليكن هذا درسًا لك

301
00:20:28,740 --> 00:20:31,160
.ودعك من هذا الأمر برمّته

302
00:20:31,160 --> 00:20:32,330
...أ-أكيد

303
00:20:33,250 --> 00:20:36,380
!وكأنّي سأقول ذلك أيّها الأحمق

304
00:20:41,380 --> 00:20:44,090
.لمنع السّلسلة من خنقك

305
00:20:44,090 --> 00:20:45,260
لكن ماذا ستفعل الآن؟

306
00:20:45,720 --> 00:20:49,060
...كلتا يديك مشغولتان الآن

307
00:20:49,060 --> 00:20:50,560
!وحركاتك محدودة

308
00:21:02,400 --> 00:21:03,900
.يا لكنشين ذاك

309
00:21:04,450 --> 00:21:06,950
ما ذلك الأمر الّذي عليه الاهتمام به؟

310
00:22:45,050 --> 00:22:50,050
الحلقة القادمة
أنياب الذّئب

311
00:22:46,420 --> 00:22:49,220
."في الحلقة القادمة :"أنياب الذّئب