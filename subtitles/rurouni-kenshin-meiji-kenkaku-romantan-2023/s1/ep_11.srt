1
00:00:00,890 --> 00:00:05,600
.العميل السّرّيّ هانيا من أونيوابانشو قلعة إيدو

2
00:00:05,940 --> 00:00:09,020
.سأحمي هذا المكان بحياتي نزولاً لأوامر الزّعيم

3
00:00:10,070 --> 00:00:13,070
أودّ تفادي أيّ معارك غير ضروريّة
.إن أمكنني لو سمحت

4
00:00:13,490 --> 00:00:15,160
هلاّ ابتعدت عن طريقنا رجاءً؟

5
00:00:15,490 --> 00:00:17,990
.أوامر الزّعيم لا تُردّ

6
00:00:21,200 --> 00:00:25,170
يرتدي ذلك الوغد قفّازات حديديّة
.تحت قفّازاته الجلديّة

7
00:00:25,750 --> 00:00:30,800
.هكذا إذًا استطاع التّصدّي لهجمات كنشين ذلك اليوم

8
00:00:32,630 --> 00:00:35,550
.يبدو أنّنا سنضطرّ للقتال هنا إذًا

9
00:00:36,430 --> 00:00:38,720
.آسف، لكن لا يمكنني التّهاون

10
00:00:38,720 --> 00:00:41,560
.يمكنني قول نفس الشّيء أيضًا

11
00:00:42,560 --> 00:00:43,480
.لنبدأ

12
00:02:13,980 --> 00:02:17,990
الحلقة 11
هانيا الشّرس • شيكيجو ذو النّدوب

13
00:02:32,080 --> 00:02:32,960
ضربة مباشرة؟

14
00:02:34,590 --> 00:02:36,050
!ظاهر اليد

15
00:02:46,600 --> 00:02:48,560
لماذا تسمح له بضربك هكذا؟

16
00:02:48,810 --> 00:02:50,190
!هذا ليس من طباعك

17
00:02:50,190 --> 00:02:53,900
أسرع واستعمل توقّعك لحركات خصمك
!الخاصّ بأسلوب هيتن ميتسوروغي-ريو

18
00:02:53,900 --> 00:02:55,770
.أستعمل ذلك مسبقًا

19
00:02:56,820 --> 00:02:58,990
.أتوقّع لكمته وهجوم ظاهر اليد

20
00:02:59,280 --> 00:03:01,450
.كما تمكّنت من تفادي هجماته

21
00:03:01,860 --> 00:03:05,490
.ولكن، صارت ذراعه أطول لوهلة أمام عينيّ

22
00:03:06,290 --> 00:03:08,410
ما الخطب أيّها الباتّوساي؟

23
00:03:08,410 --> 00:03:11,250
.هذه ليست قوّتك الحقيقيّة على الإطلاق

24
00:03:11,540 --> 00:03:14,290
،إن لم تستطع حتّى هزيمة تقنيتي

25
00:03:14,290 --> 00:03:17,590
.فلن تدوم طويلاً في قتالك لزعيمنا

26
00:03:17,840 --> 00:03:18,670
تقنية؟

27
00:03:19,380 --> 00:03:24,760
،سبق ووقعت ضحيّة لتقنيتي قبل أسبوع

28
00:03:24,760 --> 00:03:27,640
،في اللّحظة الّتي رأيتني فيها بهذا التّنكّر

29
00:03:27,810 --> 00:03:30,180
.ولم تدرك الأمر

30
00:03:35,730 --> 00:03:36,940
.يبدو أنّ المعركة بدأت

31
00:03:37,980 --> 00:03:39,150
.هانيا مرعب

32
00:03:39,740 --> 00:03:42,820
،إنّه ليس خبيرًا ممتازًا في الكنبو فحسب

33
00:03:42,820 --> 00:03:45,450
.بل ويستعمل تقنية شينوان المميتة

34
00:03:46,030 --> 00:03:48,620
،وما لم تستطع معرفة طريق عمل التّعويذة

35
00:03:48,620 --> 00:03:50,120
.فلا فرصة أمامك للنّصر

36
00:03:50,870 --> 00:03:52,120
.فهمت

37
00:03:52,120 --> 00:03:54,000
.قلتَ تقنية إذًا

38
00:03:54,540 --> 00:03:58,800
.عليّ أوّلاً صدّ إبطال تلك التّقنية مهما بدت عسيرة

39
00:04:03,180 --> 00:04:05,640
مهلاً، ما قصّة تلك الوضعيّة؟

40
00:04:05,640 --> 00:04:06,930
.لا أدري

41
00:04:07,600 --> 00:04:11,020
إنّها قريبة من سيغان الّتي تعدّ من
،وقفات السّيف الأساسيّة الخمسة

42
00:04:11,020 --> 00:04:12,480
.لكنّها مختلفة قليلاً

43
00:04:13,480 --> 00:04:15,560
!إنّها وقفة شينكن

44
00:04:16,150 --> 00:04:18,480
،تشبه وقفة سيغان ولكن مع مدّ كِلا الذّراعين

45
00:04:18,480 --> 00:04:22,280
والإمساك بالسّيف على مستوى
.نظر الخصم وبين حاجبيه

46
00:04:22,570 --> 00:04:26,070
وضعية دفاعيّة حصينة عُرفت
،في فنون السّيف القديمة

47
00:04:26,070 --> 00:04:29,790
!وقادرة على التّفاعل مع أيّ تغيّر في الخصم

48
00:04:30,240 --> 00:04:32,040
،ولكن في المقابل

49
00:04:32,040 --> 00:04:36,710
إنّها وضعية دفاعيّة محضة
!من الصّعب الانتقال للهجوم منها

50
00:04:36,710 --> 00:04:40,090
هل تختبئ خلفها أيّها الباتّوساي؟

51
00:04:41,800 --> 00:04:42,880
!أجبني

52
00:04:45,800 --> 00:04:48,800
هذا، إنّ رجلاً كهذا

53
00:04:48,800 --> 00:04:50,970
!هو الهويّة الحقيقيّة للهيتوكيري الأسطوريّ

54
00:04:51,970 --> 00:04:55,190
!يبدو أنّي تصرّفت بحماقة عندما استخففت بك

55
00:04:55,770 --> 00:05:00,980
إنّ شخصًا مثلك لا يملك المؤهّلات
!لقتال زعيمنا أوشي-ساما

56
00:05:01,440 --> 00:05:03,240
!لذلك سأقتلك ها هنا

57
00:05:03,780 --> 00:05:07,700
لا يهمّ ما مدى حصانة دفاعك
،الّذي توفّره لك وقفة شينكن

58
00:05:07,700 --> 00:05:10,030
فما دمت لا تستطيع معرفة سرّ
،تقنية الشّينوان خاصّتي

59
00:05:10,030 --> 00:05:11,620
!فمن المستحيل تفاديها

60
00:05:17,420 --> 00:05:18,250
!تفاداها

61
00:05:18,250 --> 00:05:19,080
هل اكتشف سرّها؟

62
00:05:22,880 --> 00:05:23,800
!لقد تجح

63
00:05:23,800 --> 00:05:25,760
استطعت اكتشاف سرّها، صحيح يا كنشين؟

64
00:05:26,050 --> 00:05:28,800
نعم. حقيقة تلك التّقنية

65
00:05:28,800 --> 00:05:33,020
.تكمن في وشم الخطوط الأفقيّة على ذراعيه

66
00:05:33,350 --> 00:05:34,560
الخطوط الأفقيّة؟

67
00:05:35,600 --> 00:05:37,810
!إنّه مجرّد وهم بصريّ

68
00:05:38,310 --> 00:05:42,190
تجعل الخطوط الأفقيّة ذراعيه تبدو
.أسمك وأقصر ممّا هي عليه

69
00:05:42,690 --> 00:05:45,950
!وذلك هو ما كان يشوّش تقديرك البصريّ

70
00:05:46,150 --> 00:05:49,660
.كانت ذراعه أطول ببضعة أصابع من تقديري

71
00:05:50,280 --> 00:05:53,410
،وجعل ذلك الفرق ذراعه تبدو وكأنّها تمتدّ

72
00:05:53,620 --> 00:05:57,290
.ما سمح له بإصابتي مع أنّي ظننتُ أنّي تفاديته

73
00:05:57,540 --> 00:05:59,580
...هكذا إذًا، إنّك

74
00:06:00,080 --> 00:06:06,380
استعملت طرف السّيف خلال
!وقفة شينكن لقياس الفارق

75
00:06:06,920 --> 00:06:08,680
.فهمت

76
00:06:08,680 --> 00:06:12,220
.إنّ السّيّاف مدرك بالكامل بطول سيفه

77
00:06:12,220 --> 00:06:14,890
!هذا يعني أنّه مناسب كأداة قياس

78
00:06:15,140 --> 00:06:20,600
عندما رأيتك أوّل مرّة، كنتُ متردّدًا
.بشأن زيّ الشّينوبي الغريب هذا

79
00:06:20,600 --> 00:06:23,360
وخاصّة الخطوط على ذراعيك
الّتي تجلب الأنظار إليك

80
00:06:23,360 --> 00:06:26,240
.وخلتُ أنّها ستعمل ضدّك بصفتك أونميتسو

81
00:06:26,240 --> 00:06:30,110
.ولكنّها كانت تعمل لصالحك كخبير كنبو

82
00:06:30,110 --> 00:06:33,280
إضافة لذلك، استعملت قناع هانيا
،ذاك لإخفاء نظراتك وتعابيرك

83
00:06:33,280 --> 00:06:35,830
ما يجعل من الصّعب الحكم
.على مصدر هجماتك

84
00:06:36,620 --> 00:06:39,000
.معك حقّ

85
00:06:39,000 --> 00:06:43,040
.ولكن، هناك سبب أكبر لارتدائي قناع هانيا

86
00:06:43,340 --> 00:06:47,090
.إنّه لإخفائي وجهي بحدّ ذاته

87
00:06:58,270 --> 00:06:59,520
.إنّه وحش

88
00:07:00,140 --> 00:07:01,940
وحش؟

89
00:07:02,900 --> 00:07:07,400
،رغم ذلك، فإنّ هذا الوجه مفيد
.لذا لا يزعجني ذلك الوصف

90
00:07:07,400 --> 00:07:08,240
...أنت

91
00:07:08,990 --> 00:07:10,700
...هل فعلتَ هذ لوجهك

92
00:07:11,240 --> 00:07:14,030
.أنا جاسوس

93
00:07:14,030 --> 00:07:16,910
.مهمّتي الرّئيسيّة هي جمع المعلومات

94
00:07:17,830 --> 00:07:22,920
،ولكي أتمكّن من أن أتنكّر بأيّ وجه
حرقتُ شفتاي

95
00:07:23,250 --> 00:07:27,510
،وقطعتُ أذناي وجذعتُ أنفي
.كما سحقت عظام خدّيّ أيضًا

96
00:07:28,760 --> 00:07:31,340
،لا أعرف أين وُلدتم جميعًا

97
00:07:31,840 --> 00:07:35,800
لكنّ المنطقة الّتي وُلدت فيها
.أنا ضمّت قرى كثيرة فقيرة

98
00:07:36,310 --> 00:07:40,270
وفي مثل هذه القرى وحتّى
يومنا هذا، هناك تقليد سرّيّ

99
00:07:40,270 --> 00:07:43,560
.حيث يقتل الآباء أولادهم لتقليل نفقات الطّعام

100
00:07:43,850 --> 00:07:47,400
.إنّهم يدعونه "إعادة الأطفال" في قريتي

101
00:07:47,610 --> 00:07:49,490
...هذا لا يُعقل

102
00:07:50,070 --> 00:07:54,530
،حتّى إن نجوت بالكاد من الموت
.فلا يمكنك البقاء في منزلك

103
00:07:55,030 --> 00:07:58,450
وتصير شاردًا كالقطط والكلاب بعد ذلك

104
00:07:58,450 --> 00:08:02,160
وتسير على درب الوحشيّة حيث تضطرّ
.فيه للقتل والنّهب مثل ذئب وحيد

105
00:08:03,580 --> 00:08:04,420
...ولكن

106
00:08:05,330 --> 00:08:06,170
!مخالب

107
00:08:06,380 --> 00:08:10,920
أواني أوشي-ساما حتّى وإن كنت ذئبًا وحيدًا

108
00:08:10,920 --> 00:08:14,130
!وربّاني لأصير أونميتسو من الدّرجة الرّفيعة

109
00:08:14,130 --> 00:08:17,430
كما منحتني الأونيوابانشو من قلعة إيدو

110
00:08:17,430 --> 00:08:20,720
!سببًا لأعيش ومجموعة من الرّفاق

111
00:08:21,060 --> 00:08:26,690
وإن كنتُ أستطيع مساعدة
!أوشي-ساما، فلا أحتاج وجهًا أو حياة

112
00:08:26,900 --> 00:08:28,150
!انتبه يا كنشين

113
00:08:28,150 --> 00:08:29,020
!إنّه خطير

114
00:08:29,570 --> 00:08:30,900
هذا الرّجل وحش مهووس

115
00:08:30,900 --> 00:08:35,110
!يخاطر بكلّ شيء من أجل زعيمه والأونيوابانشو

116
00:08:37,280 --> 00:08:39,330
.هانيا، أجب عن سؤالي

117
00:08:39,740 --> 00:08:43,080
هل تعرف ماضي ميغومي-دونو لو سحمت؟

118
00:08:43,080 --> 00:08:44,460
!لا تستخفّ بي

119
00:08:44,460 --> 00:08:49,300
!لا يوجد أيّ شيء لا يعرفه جواسيس الأونيوابانشو

120
00:09:08,520 --> 00:09:09,940
.لا فائدة

121
00:09:10,360 --> 00:09:14,530
...بمهاراتك تلك، فأنت لستَ ندًّا لأوشي-ساما

122
00:09:15,200 --> 00:09:17,160
.على... الإطلاق

123
00:09:22,490 --> 00:09:24,120
.هُزم أخيرًا

124
00:09:24,620 --> 00:09:26,460
.كان خصمًا مرعبًا

125
00:09:27,830 --> 00:09:28,830
...هانيا

126
00:09:29,750 --> 00:09:33,630
.يجب أن تكون أدرى بصعاب الوحدة أكثر من غيرك

127
00:09:34,340 --> 00:09:37,550
ولكن لماذا لم تكن مراعيًا لوضع ميغومي-دونو أيضًا؟

128
00:09:39,800 --> 00:09:40,800
.كنشين

129
00:09:42,180 --> 00:09:44,060
.أنا قلق حيال ميغومي-دونو لو سمحتما

130
00:09:44,560 --> 00:09:45,520
.لنسرع

131
00:09:55,280 --> 00:09:56,150
!ميغومي

132
00:09:56,450 --> 00:09:57,700
هل تستمعين؟

133
00:09:58,610 --> 00:09:59,490
!ميغومي

134
00:09:59,700 --> 00:10:01,370
.اخرس

135
00:10:01,370 --> 00:10:03,790
.يمكنك فتح الباب والدّخول بسرعة

136
00:10:03,790 --> 00:10:06,120
!أخذ أوشي المفتاح

137
00:10:06,620 --> 00:10:08,710
ما الّذي تريده إذًا؟

138
00:10:08,870 --> 00:10:11,500
!أنا آسف. هذا خطئي. أنا أعتذر

139
00:10:12,000 --> 00:10:14,050
!سأفعل شيئًا ما حيال مفتاح الغرفة

140
00:10:14,050 --> 00:10:16,300
!لذلك دعينا نهرب من هنا معًا

141
00:10:16,630 --> 00:10:19,050
،إن استعملنا الممرّ السّرّيّ
!فلن يستطيعوا اللّحاق بنا

142
00:10:19,550 --> 00:10:20,970
.أنت تمازحني

143
00:10:20,970 --> 00:10:23,140
ما الّذي قد أجنيه من الهرب معك؟

144
00:10:23,140 --> 00:10:25,220
!بإمكاننا فعل أيّ شيء

145
00:10:25,220 --> 00:10:28,440
،فبمعرفتك وأدواتي
،إضافة لمهاراتي كرجل أعمال

146
00:10:28,440 --> 00:10:31,020
!بإمكاننا ابتكار أيّ عقار جديد نتمنّاه

147
00:10:31,020 --> 00:10:33,570
!بإمكاننا إنقاذ النّاس الّذين يعانون من الأمراض

148
00:10:34,610 --> 00:10:37,490
،سأفكّر في— بل سأكفّر عن نشاطاتي السّابقة

149
00:10:37,820 --> 00:10:40,820
وكيف كنت أعاملك والجرائم
!الّتي اقترفتها ضدّ المجتمع

150
00:10:41,320 --> 00:10:43,580
،أريد أن أبدأ من جديد إن أمكنني

151
00:10:43,580 --> 00:10:46,250
!معك أنت بما أنّك تحملين نفس العبء

152
00:10:50,670 --> 00:10:52,840
.اذهب لمكان آخر يا كانريو

153
00:10:52,840 --> 00:10:54,840
.سئمت كذبك

154
00:10:54,840 --> 00:10:55,670
—ما

155
00:10:56,090 --> 00:10:58,340
.لا يتوجد طريقة للتّكفير عن خطايانا

156
00:10:58,840 --> 00:11:03,180
الشّيء الوحيد الّذي يمكنني فعله الآن
.هو منع أيّ ضرر إضافيّ من الأفيون

157
00:11:03,850 --> 00:11:04,890
.هذا كلّ شيء

158
00:11:06,100 --> 00:11:08,520
.سأراك في الجحيم يا كانريو

159
00:11:09,350 --> 00:11:13,360
!لا-لا-لا بدّ أنّك تمازحيني

160
00:11:13,360 --> 00:11:15,480
!أنت الوحيدة المخطئة هنا

161
00:11:15,690 --> 00:11:18,280
!صنع الأفيون خطؤك أنت لا غير

162
00:11:18,280 --> 00:11:21,070
!وعدم صنعه خطؤك أيضًا

163
00:11:21,530 --> 00:11:23,280
!لا تقحميني في هذا معك

164
00:11:23,280 --> 00:11:26,410
أيّتها المرأة الحقيرة الشّقيّة الشّرّيرة

165
00:11:26,410 --> 00:11:28,000
!السّاقطة

166
00:11:28,000 --> 00:11:29,250
!نلت كفايتي

167
00:11:29,250 --> 00:11:31,670
!يمكنك أن تثملي على حسّ البطولة ذاك هناك

168
00:11:31,670 --> 00:11:35,420
ما الّذي سيظنّه كلّ زبائني الّذين ماتوا بسببك؟

169
00:11:41,510 --> 00:11:42,760
...حثالة

170
00:11:48,390 --> 00:11:49,980
كيف إصاباتك؟

171
00:11:50,230 --> 00:11:51,770
.إنّها سطحيّة

172
00:11:51,770 --> 00:11:53,400
.توقّف النّزيف سلفًا

173
00:11:58,070 --> 00:11:59,070
...لكن

174
00:11:59,360 --> 00:12:01,150
أيّ نوع من الرّجال يكون شينوموري أوشي

175
00:12:01,150 --> 00:12:06,450
إن كان شخص من مستوى هانيا وفيًّا له لهذا الحدّ؟

176
00:12:11,330 --> 00:12:15,330
إنّ حقيقة تواجدكم هنا تعني أنّ هانيا هُزم، صحيح؟

177
00:12:15,580 --> 00:12:17,420
.أنتم بارعون

178
00:12:17,880 --> 00:12:22,260
أنا حارس الحصن الرّئيسيّ شيكيجو
.من أونيوابانشو قلعة إيدو

179
00:12:22,260 --> 00:12:25,260
!إليكم واحدة أخرى كترحيب

180
00:12:27,180 --> 00:12:28,180
!سانو

181
00:12:28,390 --> 00:12:32,560
،دع أمر هذا الأبله ذو العضلات لي
.وواصل أنت تقدّمك

182
00:12:32,940 --> 00:12:35,980
.أستطيع تولّي أمر رجل مثله بسهولة

183
00:12:35,980 --> 00:12:38,650
!لذلك أسرع وأخرج تلك المرأة الشّقيّة من هنا

184
00:12:39,070 --> 00:12:40,150
.سانو

185
00:12:41,610 --> 00:12:42,860
!هيّا بنا يا ياهيكو

186
00:12:42,860 --> 00:12:43,820
!أجل

187
00:12:50,700 --> 00:12:51,660
.اسمع يا هذا

188
00:12:51,830 --> 00:12:54,620
لا تمانع أبدًا من تركه يذهب، صحيح؟

189
00:12:54,870 --> 00:13:00,500
صحيح. ترك الجزء الأفضل للزّعيم
.هو ما نقوم به في مجموعتنا

190
00:13:01,010 --> 00:13:03,590
...لذلك سأرضى بتابع مثلك

191
00:13:03,590 --> 00:13:05,180
.أيّها المقاتل المأجور زانزا

192
00:13:07,010 --> 00:13:11,060
.هل تفاجأت؟ قام هانيا ببحث إضافيّ أيضًا

193
00:13:11,560 --> 00:13:15,640
سمعتُ أنّك كنت ذائع الصّيت
.في مجتمعات عالم الجريمة

194
00:13:15,900 --> 00:13:20,980
وبالطّبع صرت نكرة الآن
.بما أنّك ما عدت تملك الزّانباتو

195
00:13:21,780 --> 00:13:24,280
!لا تسئ الفهم أيّها الوغد

196
00:13:24,570 --> 00:13:26,030
،لا أملك الزّانباتو

197
00:13:26,030 --> 00:13:30,120
!لكنّ ذراعَيّ اللّتان كانتا تحملانه ما زالتا موجودتين

198
00:13:30,450 --> 00:13:33,910
!أنا من يرضى بالتّابع فقط هنا

199
00:13:36,370 --> 00:13:39,880
اسمع يا كنشين، هل سيكون سانوسكي بخير وحده؟

200
00:13:39,880 --> 00:13:42,130
.بدا ذلك الرّجل قويًّا جدًّا

201
00:13:42,130 --> 00:13:44,880
.إنّه سانو، لذلك سيكون بخير لو سمحت

202
00:13:44,880 --> 00:13:48,590
فقبل كلّ شيء، لن يسمح لنا
.بالمساعدة حتّى وإن كنّا هناك

203
00:13:49,350 --> 00:13:50,300
.سندخل إلى هناك

204
00:13:50,300 --> 00:13:52,310
قاعة الرّقص

205
00:13:50,930 --> 00:13:52,310
!تماسك

206
00:13:56,230 --> 00:13:58,560
،أنا حارس الحصن الرّئيسيّ

207
00:13:58,560 --> 00:14:01,730
.وأنت تدعوني بالتّابع؟ كم هذا ممتع

208
00:14:02,270 --> 00:14:06,110
ما رأيك أن يستعمل كلانا أيدينا الّتي نفخر بها

209
00:14:06,110 --> 00:14:08,910
ونختبر قوّتها بالفعل؟

210
00:14:08,910 --> 00:14:10,030
!أرني ما لديك

211
00:14:13,240 --> 00:14:14,080
!تبًّا لك

212
00:14:14,370 --> 00:14:16,330
ألم نكن سنخوض قتالاً بأيدينا فقط؟

213
00:14:16,330 --> 00:14:17,460
.لا داعي للقلق

214
00:14:21,340 --> 00:14:23,420
.هكذا سأستعملها

215
00:14:26,380 --> 00:14:27,300
!هيّا

216
00:14:30,680 --> 00:14:34,100
.والآن... سنحدّد الآن من منّا التّابع

217
00:14:39,560 --> 00:14:41,060
.انتهى الأمر

218
00:14:41,810 --> 00:14:43,860
...يبدو أنّ لك روحًا قويّة

219
00:14:43,860 --> 00:14:46,690
.لكنّك واجهت الرّجل الخطأ

220
00:14:48,240 --> 00:14:49,280
...إيّاك

221
00:14:50,990 --> 00:14:54,160
.إيّاك والاعتقاد أنّك فزت بهذه السّرعة

222
00:14:54,660 --> 00:14:57,330
.إنّك تقاتل بطريقة غريبة بالتأكيد

223
00:14:57,830 --> 00:14:59,870
ماذا عن استعمال أيدينا فقط كما اتّفاقنا؟

224
00:14:59,870 --> 00:15:01,250
.لا تستهن بي

225
00:15:01,710 --> 00:15:05,880
!على الرّجل أن يقاتل دون أن يخفي أيّ شيء

226
00:15:06,510 --> 00:15:10,010
!فكفاك من اللّهو بألعاب كهذه

227
00:15:11,180 --> 00:15:13,550
.أشعر براحة أكثر

228
00:15:13,550 --> 00:15:15,680
.أستطيع أنّ بإمكاني المواصلة الآن

229
00:15:15,680 --> 00:15:16,890
!مذهل

230
00:15:17,560 --> 00:15:20,980
!إجاباتك السّريعة هذه رائعة

231
00:15:20,980 --> 00:15:24,270
.لا تبدو كتابع عاديّ بالفعل

232
00:15:24,520 --> 00:15:26,980
من تصفه بالتّابع أيّها المغفّل؟

233
00:15:31,950 --> 00:15:33,950
!رائع، رائع

234
00:15:33,950 --> 00:15:34,780
...لكن

235
00:15:40,920 --> 00:15:43,000
.أنا آسف

236
00:15:43,330 --> 00:15:45,590
.لم يسعني سوى نطحك برأسي

237
00:15:46,090 --> 00:15:48,840
،فحسب هذه النّدوب على كامل جسدي

238
00:15:48,840 --> 00:15:51,970
.كانت حياتي كلّها قتال في قتال

239
00:15:52,470 --> 00:15:56,060
.يتحرّك جسدي من تلقاء نفسه

240
00:15:57,010 --> 00:15:58,180
!تبًّا لك

241
00:15:58,720 --> 00:16:00,520
.توقّف

242
00:16:00,520 --> 00:16:04,480
من المذهل أنّ جمجمتك لم تتحطّم
،بسبب نطحتي

243
00:16:04,480 --> 00:16:06,480
.لكنّ الأمر مختلف لما بداخلها

244
00:16:07,020 --> 00:16:09,530
فالصّدمة الّتي شعر بها دماغك

245
00:16:09,530 --> 00:16:12,740
ستتركك غير قادر على تحريك
.ولو إصبع واحد لمدّة

246
00:16:13,360 --> 00:16:14,200
...ولكن

247
00:16:14,820 --> 00:16:17,580
.إنّك تجعل يدي ترتعش

248
00:16:18,410 --> 00:16:20,120
.أنت تروق لي يا فتى

249
00:16:20,120 --> 00:16:21,120
ما رأيك بهذا إذًا؟

250
00:16:21,250 --> 00:16:25,830
لماذا لا تقطع علاقتك بذلك
الباتّوساي وتصير واحدًا منّا؟

251
00:16:25,830 --> 00:16:26,710
ماذا؟

252
00:16:26,920 --> 00:16:29,630
.لا نهتمّ لتاريخ عائلتك

253
00:16:30,130 --> 00:16:32,550
.أنت قويّ وذلك يكفي

254
00:16:32,550 --> 00:16:37,560
.حتّى أنا كنتُ أونميتسو من منطقة ساتسوما

255
00:16:37,560 --> 00:16:41,430
.ما يعني أنّي كنت في جانب مناصري الامبراطوريّة

256
00:16:42,060 --> 00:16:45,940
وفي 1866، مُنحت أوامر بتحرّي أمر قلعة إيدو

257
00:16:45,940 --> 00:16:48,820
.للتّحضير للمعركة القادمة

258
00:16:49,230 --> 00:16:52,700
،لكنّي هُزمت على يد الزّعيم
.الّذي كان في الثّالثة عشر وقتها

259
00:16:53,320 --> 00:16:55,700
.قوّتك العضليّة تفوق أيّ شخص آخر

260
00:16:56,370 --> 00:16:58,490
.سيكون من العار قتل جاسوس مثلك

261
00:16:58,660 --> 00:17:02,910
إن استعملتَ إكسير تضخيم العضلات
،المتوارث في الأونيوابانشو

262
00:17:02,910 --> 00:17:04,620
.فستصير أقوى بكثير

263
00:17:04,870 --> 00:17:06,540
.عليك الانضمام لصفوفنا

264
00:17:07,000 --> 00:17:09,840
.يمكنك أن تصير منيعًا إن فعلت ذلك

265
00:17:10,800 --> 00:17:11,960
منيعًا؟

266
00:17:13,630 --> 00:17:18,010
!وهكذا، اكتسبت هذه القوّة العضليّة المنيعة

267
00:17:18,350 --> 00:17:19,810
.ونفس الأمر ينطبق عليك

268
00:17:19,810 --> 00:17:22,770
.لديك الإمكانية لتصير قويًّا بلا نهاية

269
00:17:23,270 --> 00:17:28,480
إن استعملت إكسير الأونيوابانشو
!فقد تتجاوزنا حتّى أنا وهانيا

270
00:17:30,020 --> 00:17:32,990
،إن كنتَ لا تبالغ

271
00:17:32,990 --> 00:17:36,320
.فهذا المدعوّ شينوموري أوشي قويّ بالفعل

272
00:17:36,570 --> 00:17:41,410
نعم! إن كان زعيمنا في كيوتو
،لهزيمة مناصري الإمبراطوريّة

273
00:17:41,410 --> 00:17:44,620
فما كانت أسطورة الأقوى لتكون
.عن شخص مثل الباتّوساي

274
00:17:44,620 --> 00:17:47,790
!ولكانت من نصيب زعيمنا

275
00:17:47,790 --> 00:17:50,500
.الأونيوابانشو أقوياء

276
00:17:50,500 --> 00:17:54,220
.أنتما بالطّبع، وكذلك بشيمي وهيوتّوكو أيضًا

277
00:17:54,220 --> 00:17:57,300
.لا يُستهان بكم أبدًا حسب طريقة قتالكم

278
00:17:57,300 --> 00:17:58,550
...لكن

279
00:17:59,140 --> 00:18:01,010
.تلك هي النّهاية

280
00:18:01,430 --> 00:18:03,640
يبدو أنّ الأقوياء

281
00:18:03,640 --> 00:18:06,770
.يجتمعون حول شينوموري أوشي لسبب ما أو لآخر

282
00:18:06,770 --> 00:18:08,600
.وذلك كلّ شيء

283
00:18:08,600 --> 00:18:11,020
ماذا تقصد بكلامك؟

284
00:18:11,400 --> 00:18:15,320
.إنّ كلّ واحد منكم قويّ بالفعل

285
00:18:15,320 --> 00:18:21,080
لذلك السّبب يصير جمع الأشخاص
.الأقوياء والقتال هو كلّ شيء لكم

286
00:18:21,080 --> 00:18:23,790
.لكنّ هيمورا كنشين مختلف

287
00:18:23,790 --> 00:18:27,920
...الآنسة وياهيكو وحتّى تاكاني ميغومي

288
00:18:28,080 --> 00:18:30,960
.يحصل على إعجاب مختلف الأشخاص ويجمعهم حوله

289
00:18:31,460 --> 00:18:35,010
،الهيتوكيري لقب من الماضي
،إنّه الآن روروني

290
00:18:35,010 --> 00:18:38,880
.لكنّ القتال يجدر طريقه له دائمًا

291
00:18:39,390 --> 00:18:40,800
...ومع ذلك

292
00:18:41,100 --> 00:18:44,060
ماذا تحاول قوله يا فتى؟

293
00:18:46,520 --> 00:18:49,060
.يعرف الجميع هذا

294
00:18:49,060 --> 00:18:51,060
،لا يهمّ كم أنّه قويّ

295
00:18:51,060 --> 00:18:54,610
.لكنّه لن يحمل سيفه أبدًا لقتال معاركه الخاصّة

296
00:18:54,780 --> 00:18:55,610
—اللّعنة

297
00:18:56,900 --> 00:19:01,660
!إنّ السّاكاباتو خاصّته موجود فقط لحماية الآخرين

298
00:19:01,990 --> 00:19:04,080
غرق الأونيوابانشو في قوّتهم الخاصّة

299
00:19:04,080 --> 00:19:07,120
.وقلّلتم من أنفسكم لتصيروا مجرّد بيادق لتاكيدا كانريو

300
00:19:07,410 --> 00:19:10,330
!أما هيمورا كنشين فهو من معيار مختلف تمامًا

301
00:19:10,330 --> 00:19:12,630
!تبًّا لك

302
00:19:12,840 --> 00:19:17,720
أثنيتُ عليك قليلاً، ولكنّك سمحت
!لذلك بجعلك تغترّ بنفسك أيّها الحثالة

303
00:19:17,970 --> 00:19:21,180
من الّذي يغرق في قوّته الخاصّة؟

304
00:19:22,640 --> 00:19:26,720
!أعاملك بلطف، لكنّك تغترّ بنفسك

305
00:19:27,220 --> 00:19:33,310
!قل كلامًا كبيرًا كهذا بعد هزيمة شيكيجو-ساما

306
00:19:33,310 --> 00:19:35,230
...التّصرّف هكذا

307
00:19:35,440 --> 00:19:40,150
هو ما وصفتُه بالغرق في قوّتكم
!الخاصّة أيّها الأبله

308
00:19:40,150 --> 00:19:41,860
...ما الّذي

309
00:19:45,990 --> 00:19:48,370
.هذه النّهاية أيّها التّابع

310
00:19:54,920 --> 00:19:57,380
،لا يهم كم أنّ جمجمتك صلبة

311
00:19:57,380 --> 00:20:01,050
لكنّ الأمر مختلف لما بداخلها"، صحيح؟"

312
00:20:04,090 --> 00:20:10,100
شيكيجو، عليك قتال كنشين يومًا ما
.إن حصلتَ على فرصة

313
00:20:10,640 --> 00:20:15,810
.ربّما ستكون قادرًا على استعادة شيء مهمّ خسرتَه

314
00:20:20,490 --> 00:20:26,660
ولكن، كم هنالك من هؤلاء الأونيوابانشو يا ترى؟

315
00:20:26,660 --> 00:20:28,370
..إن استمرّ هذا

316
00:20:28,870 --> 00:20:31,250
...فلن يواصل جسدي

317
00:20:35,750 --> 00:20:41,300
نعرف وجوه بعضنا، لكنّ هذه أوّل
...مرّة نتحدّث فيها على ما أظنّ

318
00:20:42,010 --> 00:20:42,880
.نعم

319
00:20:43,260 --> 00:20:46,550
أودّ تفادي أيّ معارك غير ضروريّة
.إن أمكنني لو سمحت

320
00:20:47,260 --> 00:20:51,770
لذلك هل بإمكانك التّنحّي وإخباري
بمكان كانريو وميغومي-دونو؟

321
00:20:52,350 --> 00:20:55,100
هل تنحّى هانيا عن طريقك عندما أخبرته بذلك؟

322
00:20:56,190 --> 00:20:57,520
.بالطّبع لم يفعل

323
00:21:00,400 --> 00:21:04,070
.سيكون عليك أن تسألني عن مكانهما بذلك السّاكاباتو

324
00:21:05,570 --> 00:21:08,490
.وأنا سأجيب... بهذا

325
00:22:44,960 --> 00:22:49,970
الحلقة القادمة
الزّعيم • شينوموري أوشي

326
00:22:46,170 --> 00:22:49,390
."في الحلقة القادمة: "الزّعيم شينوموري أوشي