1
00:00:05,350 --> 00:00:09,440
.أظنّ أنّك هو مايكاوا كوناي مؤسّس تشويتسو-ريو

2
00:00:10,070 --> 00:00:12,570
.أودّ أن أتحدّاك

3
00:00:15,030 --> 00:00:17,320
!أنا إيسوروغي رايجوتا

4
00:00:17,830 --> 00:00:21,080
!أنا قلق بحقّ على مستقبل المسايفة

5
00:00:25,120 --> 00:00:27,670
عينان يغطّيهما الغمام ولا يمكنني
...الرّؤية بعمق خلالهما

6
00:00:28,000 --> 00:00:29,380
!لكنّه قويّ

7
00:00:36,800 --> 00:00:38,760
ما الّذي تريده منّي لو سمحت؟

8
00:00:39,390 --> 00:00:42,430
كيف يجب أن تكون المسايفة هذه الأيّام في رأيك؟

9
00:00:42,930 --> 00:00:44,810
هل تظنّ أنّها ضعيفة؟

10
00:00:45,310 --> 00:00:47,690
ألا تظنّ أنّها شحيحة وهشّة؟

11
00:00:48,480 --> 00:00:50,860
.أسلوبي هو شينكو-ريو

12
00:00:50,860 --> 00:00:55,450
أسعى لتحقيق الأفعال العظيمة
.المتمثّلة في إعادة المسايفة لمجدها

13
00:00:55,990 --> 00:01:01,580
أرغب في القضاء على أساليب المسايفة
.الحاليّة الّتي تتجاوز الخمسمائة أسلوب

14
00:01:02,040 --> 00:01:03,040
.فهمت

15
00:01:04,540 --> 00:01:08,670
في تلك الحالة، لا أظنّنا أنا وأنت
.سنتّفق بخصوص هذا

16
00:01:09,960 --> 00:01:12,050
لا تعير الأمر أيّ اهتمام حتّى
إن اندثرت المسايفة

17
00:01:12,050 --> 00:01:14,010
ما لم يتمّ القيام بشيء ما؟

18
00:01:15,380 --> 00:01:17,800
.أنا أيضًا سيّاف وإن لم أكن الأفضل

19
00:01:18,090 --> 00:01:20,720
.وأشعر بالقلق حيال مستقبل المسايفة

20
00:01:21,510 --> 00:01:25,310
ولكن إن كان ذلك المستقبل
،مستقبل يزدهر فيه القتل بالسّيف

21
00:01:25,310 --> 00:01:26,850
.فسأرفض بكلّ سرور

22
00:01:29,060 --> 00:01:30,440
.فهمت

23
00:01:30,980 --> 00:01:33,860
.إذًا فأنت لا توافق على خطّتي الكبرى

24
00:01:35,690 --> 00:01:39,740
!في تلك الحالة، أنت عدوّي بدءًا من هذه اللّحظة

25
00:03:17,960 --> 00:03:21,970
الحلقة السّادسة عشر
الرّجل المثاليّ

26
00:03:32,980 --> 00:03:36,070
هذه نفس التّقنية الّتي استعملتَها
.لكسر أرضيّة دوجو مايكاوا

27
00:03:37,320 --> 00:03:39,320
!السّيف السّرّيّ: ماتوي إيزونا

28
00:03:39,820 --> 00:03:43,910
هذه تقنية أعدتُها للوجود من كتاب
!عن فنون السّيف السّرّيّة القديمة

29
00:03:45,700 --> 00:03:47,830
!مذهل! هذا ما أتوقّعه من سيسي

30
00:03:48,580 --> 00:03:51,290
!لا يمكنك الفوز ضدّي بمجرّد الهرب منّي

31
00:03:57,630 --> 00:03:58,880
...سيف بنصل معكوس

32
00:04:00,340 --> 00:04:05,050
كما يُظهر هذا السّيف، فقد منعت
.نفسي من استعمال السّيف للقتل

33
00:04:08,060 --> 00:04:12,730
،بعد أن اعتبرتك عدوًّا لي الآن
.فسأحرص على سحقك

34
00:04:21,990 --> 00:04:24,780
.يبدو أنّ الأمور قد سُوّيت في الوقت الحاليّ

35
00:04:25,450 --> 00:04:26,410
.لنعد للمنزل

36
00:04:31,950 --> 00:04:34,460
!لن أسامحكم أبدًا

37
00:04:34,920 --> 00:04:38,790
،نعم، مفهوم. نحن آسفون
.فلا داعي للغضب يا صغير

38
00:04:38,790 --> 00:04:40,050
!لا تربّت على رأسي هكذا

39
00:04:40,500 --> 00:04:43,340
ربطتموه إلى شجرة؟

40
00:04:43,340 --> 00:04:45,010
.سانوسكي من فعل ذلك

41
00:04:45,970 --> 00:04:49,470
أسمعتم؟ سأحرص على تقطيعكم
!بتقنيتي السّرّيّة

42
00:04:49,470 --> 00:04:51,560
!اخرس فحسب

43
00:04:51,680 --> 00:04:52,520
ماذا؟

44
00:04:53,100 --> 00:04:55,600
،إن كانت لديك طاقة للتّذمّر هكذا

45
00:04:55,600 --> 00:04:59,320
،فلا تتبع ذلك الضّخم فحسب
!وتعال إلى الدّوجو وحدك

46
00:04:59,650 --> 00:05:02,150
!سأواجهك حينها إن أتيت

47
00:05:02,400 --> 00:05:04,490
!ولكن بسيوف الخيزران

48
00:05:14,710 --> 00:05:16,620
!أتيتُ كما وعدت

49
00:05:17,080 --> 00:05:20,130
اسمع... ما السّاعة الآن في رأيك؟

50
00:05:20,460 --> 00:05:22,170
!لم تحدّد وقتًا معيّنًا

51
00:05:22,670 --> 00:05:24,380
!هيّا، تحدّاني

52
00:05:27,130 --> 00:05:28,510
!سأسوّي المسألة معك

53
00:05:29,220 --> 00:05:30,260
!استعدّ

54
00:05:31,720 --> 00:05:33,810
يا كاورو، هلاّ حكمت بيننا؟

55
00:05:35,270 --> 00:05:37,060
.حسنًا، الجولة الأولى

56
00:05:37,060 --> 00:05:38,650
!قوليها بحماس أكبر

57
00:05:38,650 --> 00:05:40,270
!لا يمكنني خوض تحدٍّ هكذا

58
00:05:40,520 --> 00:05:42,860
!لا تصرخ في أذني

59
00:05:42,860 --> 00:05:44,360
هل استيقظت الآن أيّتها القبيحة؟

60
00:05:44,360 --> 00:05:46,900
!أنا مستيقظة
لكن هل وصفتني بالقبيحة ثانية؟

61
00:05:45,490 --> 00:05:46,900
!تحدّاني

62
00:05:46,900 --> 00:05:48,490
!اسمعا

63
00:05:46,900 --> 00:05:48,490
!لكنّك قبيحة بالفعل –
ماذا؟ –

64
00:05:48,490 --> 00:05:50,950
"كاميا كاشّين-ريو"

65
00:05:49,950 --> 00:05:50,950
!الجولة الأولى

66
00:05:51,410 --> 00:05:52,660
!حسنًا، أرني ما لديك

67
00:05:53,990 --> 00:05:54,830
ماذا؟

68
00:05:55,200 --> 00:05:56,040
أورو؟

69
00:05:57,750 --> 00:06:00,840
ألا تمسك بسيف الخيزران ذاك بطريقة غريبة؟

70
00:06:01,790 --> 00:06:04,710
...يجب أن تكون يدك اليمنى فوق اليسرى

71
00:06:05,210 --> 00:06:08,630
.وعلى اليد اليسرى أن تمسك بنهاية مقبض السّيف

72
00:06:08,970 --> 00:06:12,680
!أ-أنا أتدرّب بالسّيوف الحقيقيّة فحسب

73
00:06:13,010 --> 00:06:15,180
—لذلك لا أعرف كيف أمسك بسيف خيزران

74
00:06:15,430 --> 00:06:19,190
كيفية حملك لسيف حقيقيّ لا تختلف
.عن حملك لسيف خيزران بعد إذنك

75
00:06:21,400 --> 00:06:26,280
هل يعقل أنّك لم تمارس المسايفة من قبل؟

76
00:06:27,440 --> 00:06:32,700
فهمت. لهذا السّبب أتيت بمجرّد
.أن استيقظتُ ليسهل الفوز عليك

77
00:06:33,030 --> 00:06:34,660
.هذا ليس تحدّيًا

78
00:06:37,160 --> 00:06:39,830
يرفض رايجوتا تدريبك؟

79
00:06:40,290 --> 00:06:46,170
.ما بيده حيلة. إنّه مشغول بالشّينكو-ريو

80
00:06:46,880 --> 00:06:52,090
يقول دائمًا أنّ الشّينكو-ريو
.مهمّ للغاية للمسايفة اليابانيّة

81
00:06:52,800 --> 00:06:55,890
.لذلك لا يعقل أن أكون أنانيًّا وأعترض طريقه

82
00:07:01,020 --> 00:07:02,610
.ما بيدك حيلة بالفعل

83
00:07:02,610 --> 00:07:08,780
"كاميا كاشّين-ريو"

84
00:07:03,190 --> 00:07:07,570
،حسنًا. بما أنّك أتيت إلى هنا سلفًا
.فسأمنحك دروسًا اليوم

85
00:07:07,570 --> 00:07:08,780
ماذا؟

86
00:07:09,240 --> 00:07:11,700
.حسنًا، في البداية، هكذا يُحمل سيف الخيزران

87
00:07:12,070 --> 00:07:17,040
اقبض بخنصرك الأيسر النّصف السّفليّ
.لمقبض السّيف هكذا

88
00:07:18,040 --> 00:07:19,830
لماذا احمرّ وجهك هكذا؟

89
00:07:19,830 --> 00:07:21,040
!اخرس

90
00:07:21,210 --> 00:07:23,000
!كفاك سخرية يا ياهيكو

91
00:07:26,130 --> 00:07:29,880
!وجه! وجه! وجه! وجه

92
00:07:30,010 --> 00:07:30,840
!وجه

93
00:07:31,180 --> 00:07:32,800
!أجل! هذا هو المطلوب

94
00:07:33,760 --> 00:07:35,300
.أحسنت يا يوتارو-كُن

95
00:07:35,800 --> 00:07:36,810
فعلاً؟

96
00:07:36,970 --> 00:07:39,230
.نعم. لديك إمكانيّات كثيرة

97
00:07:39,230 --> 00:07:40,560
!أنا سعيد

98
00:07:41,600 --> 00:07:45,610
وقت الاستراحة. بما أنّ لا أحد منكم
،تناول أيّ شيء هذا الصّباح

99
00:07:45,610 --> 00:07:47,860
.أعددت بعض كرات الأرزّ من أجلكم

100
00:07:48,190 --> 00:07:49,190
.تفضّل يا ياهيكو

101
00:07:49,690 --> 00:07:50,690
.حسنًا

102
00:07:51,950 --> 00:07:55,620
.يا لكاورو تلك. إنّها تقف إلى جانبه

103
00:07:57,910 --> 00:07:59,290
.تفضّلي يا كاورو-دونو

104
00:07:59,290 --> 00:08:00,120
.شكرًا لك

105
00:08:02,330 --> 00:08:04,330
.يبدو ياهيكو عبوسًا

106
00:08:07,380 --> 00:08:09,380
.يا إلهي، إنّه طفل بالفعل

107
00:08:10,260 --> 00:08:11,470
!ياهيكو

108
00:08:11,470 --> 00:08:12,680
ماذا تريدين يا قبيحة؟

109
00:08:12,680 --> 00:08:13,930
ماذا؟

110
00:08:15,720 --> 00:08:17,180
.تفضّل يا يوتارو-دونو

111
00:08:18,180 --> 00:08:19,180
.لا أريد

112
00:08:20,390 --> 00:08:22,940
.قال سينسي أنّك عدوّه

113
00:08:23,440 --> 00:08:25,520
.لن أقبل أيّ شيء من الأعداء

114
00:08:26,020 --> 00:08:28,020
.لا تكن عنيدًا هكذا لو سمحت

115
00:08:28,520 --> 00:08:32,030
اسمع، قيل أنّ الجنرال القديم
أويسوغي كنشين في فترة سنغوكو

116
00:08:32,030 --> 00:08:34,450
.قد أعطى الملح لجنرال العدوّ

117
00:08:44,080 --> 00:08:45,580
.حسنًا

118
00:08:45,790 --> 00:08:48,540
!لا تجلس إلى جانبي دون طلب الإذن

119
00:08:49,420 --> 00:08:52,920
كيف وجدت الأمر؟
هل المسايفة بالخيزران ممتعة؟

120
00:08:53,130 --> 00:08:57,510
.إنّه مجرّد لهو في البداية
.وكلّ لهو قد يكون ممتعًا

121
00:09:00,600 --> 00:09:02,890
.لكن لا يمكنني أن أصير قويًّا باللّهو فحسب

122
00:09:02,890 --> 00:09:03,730
أورو؟

123
00:09:04,810 --> 00:09:10,360
أريد أن أصير سيّافًا لا يُقهر
.مثل سينسي وألحق العار بأبي

124
00:09:11,610 --> 00:09:14,320
تلحق العار بأبيك؟

125
00:09:14,820 --> 00:09:15,910
.نعم

126
00:09:16,360 --> 00:09:18,990
.لقد تخلّى عن فخر كونه ساموراي ليصير تاجرًا

127
00:09:19,490 --> 00:09:22,330
يرسم ابتسامة مزيّفة على وجهه
.دائمًا وينحني يمينًا وشِمالاً

128
00:09:22,700 --> 00:09:25,790
وليس ذلك فحسب، لكنّه يعمل بجدّ
في تجارة سيوف الكاتانا

129
00:09:25,790 --> 00:09:28,290
.الّتي هي روح السّاموراي، في الخارج

130
00:09:29,420 --> 00:09:36,090
أريد أن أظهر له كيف يعيش ساموراي
.حقيقيّ بلا شيء سوى سيفه

131
00:09:36,550 --> 00:09:40,600
إنّه يشبه ياهيكو من ناحية فخرهما
.بكونهما سليلان من السّاموراي

132
00:09:41,310 --> 00:09:47,100
ولكن، الرّغبة في الحصول على القوّة
.تنبع من مكان مختلف تمامًا عنه

133
00:09:48,690 --> 00:09:53,440
يوتارو-كُن. هل تودّ أن تتدرّب معنا
لبعض الوقت إن كنت لا تمانع؟

134
00:09:53,730 --> 00:09:54,570
ماذا؟

135
00:09:55,400 --> 00:09:59,160
لنضع مشاعر إلحاق العار بالآخرين
.أو إظهار أيّ شيء بالقوّة لهم جانبًا

136
00:09:59,570 --> 00:10:03,410
.عليك مواجهة مشاعر الرّغبة في تعلّم المسايفة أوّلاً

137
00:10:04,040 --> 00:10:07,580
،إن واصلت التّنافس مع ياهيكو
.فأنا واثقة أنّك ستصير أقوى

138
00:10:08,420 --> 00:10:11,380
.فهمت. قد تكون هذه فكرة جيّدة

139
00:10:11,880 --> 00:10:14,550
ما الّذي تفكّران به يا كنشين وكاورو؟

140
00:10:14,550 --> 00:10:16,590
!إنّه تلميذ رايجوتا

141
00:10:17,090 --> 00:10:18,550
.فهمت

142
00:10:18,550 --> 00:10:19,390
ماذا؟

143
00:10:20,010 --> 00:10:23,890
!لا بدّ أنّك خائف من أن أصير أقوى منك

144
00:10:24,140 --> 00:10:26,810
!غبيّ! الأمر ليس كذلك تمامًا

145
00:10:26,810 --> 00:10:28,940
!مستحيل أن أخسر في مواجهتك

146
00:10:28,940 --> 00:10:30,020
!نلت منك

147
00:10:31,480 --> 00:10:33,860
ستبدأ في التّدرّب في دوجو كاميا؟

148
00:10:34,980 --> 00:10:36,400
!أرجوك أن تسمح لي

149
00:10:41,780 --> 00:10:43,030
.لا بأس بذلك

150
00:10:43,200 --> 00:10:45,830
!فعلاً؟ شكرًا جزيلاً لك

151
00:10:46,330 --> 00:10:48,710
،يُقال أنّك إذا كنت تعرف العدوّ وتعرف نفسك

152
00:10:48,710 --> 00:10:50,920
.فلا حاجة بك للخوف من نتائج مائة معركة

153
00:10:50,920 --> 00:10:52,500
!هذه استراتيجيّة سون تزو

154
00:10:53,040 --> 00:10:55,300
.اذهب للحصول على تجربة وأنت تتعلّم من العدوّ

155
00:10:55,460 --> 00:10:58,010
!حاضر! شكرًا جزيلاً لم

156
00:10:58,470 --> 00:11:01,640
!تلقّيتُ أوّل تعاليم لي من سينسي

157
00:11:01,640 --> 00:11:03,390
!إنّه يعلق آمالاً كبيرة عليّ

158
00:11:14,480 --> 00:11:17,940
إذًا فذلك الفتى يأتي إلى الدّوجو
كلّ يوم مذّاك الحين؟

159
00:11:18,440 --> 00:11:19,990
.إنّ شغوف بالفعل

160
00:11:20,200 --> 00:11:23,160
.نعم. كما أنّه تقرّب من ياهيكو أيضًا

161
00:11:24,410 --> 00:11:27,040
!من تصف بالقرد القصير يا ذا عيون القطط

162
00:11:27,160 --> 00:11:30,660
كنت تقول في البداية أنّك لن تتدرّب
!على المسايفة بالخيزران

163
00:11:30,790 --> 00:11:33,420
!المسايفة بالخيزران مجرّد لهو

164
00:11:33,420 --> 00:11:38,510
أنا هنا للاستطلاع من أجل معركة
!سينسي مع هيمورا كنشين القادمة

165
00:11:38,710 --> 00:11:43,220
.للاستطلاع؟ إنّه يساعد في المهام المنزليّة فقط

166
00:11:43,220 --> 00:11:46,100
،نعم. فاجأني ذلك أيضًا

167
00:11:46,100 --> 00:11:48,970
خبير فنون مسايفة مثله يساعد
.في المهام المنزليّة فقط

168
00:11:48,970 --> 00:11:50,730
!كفّ عن المجيء إلى هنا إذًا

169
00:11:50,730 --> 00:11:53,730
ماذا؟! لا أذك أنّي سمحت لك
!بإلقاء الأوامر عليّ

170
00:11:53,730 --> 00:11:55,560
أقلت صارا مقرّبين؟

171
00:11:56,940 --> 00:11:59,030
!حسنًا، حسنًا! كفاكما جدالاً

172
00:12:00,150 --> 00:12:01,740
ياهيكو؟ –
ماذا؟ –

173
00:12:01,950 --> 00:12:06,490
سيتدرّب يوتا-كُن على هجوم استهداف
الوجه بالقفز، هلاّ قمت بدور الهدف؟

174
00:12:06,740 --> 00:12:08,120
لماذا أنا؟

175
00:12:08,120 --> 00:12:11,710
،أنا طويلة بالمقارنة به
.لذلك فلن يكون تدريبًا جيّدًا

176
00:12:11,910 --> 00:12:16,380
.كفاك تذمّرًا وارتد قناعك
!هذا أمر من معلّمتك

177
00:12:17,130 --> 00:12:18,380
!سُحقًا

178
00:12:19,460 --> 00:12:21,260
.أسرع

179
00:12:21,260 --> 00:12:24,680
،سأتلقّى هجمات سيفك الضّعيفة
.فكن شاكرًا لي

180
00:12:26,890 --> 00:12:28,220
!وجه

181
00:12:29,520 --> 00:12:30,680
ما رأيك؟

182
00:12:30,680 --> 00:12:32,180
.هذا مفاجئ

183
00:12:33,520 --> 00:12:37,520
ربّما تكون له إمكانيّات في المسايفة
.أكثر ممّا توقّعت

184
00:12:38,270 --> 00:12:39,020
!وجه

185
00:12:40,610 --> 00:12:44,860
كان مجرّد هاوٍ لم يعرف حتّى كيف
.يمسك سيف خيزران

186
00:12:45,030 --> 00:12:47,660
لم أتوقّع أنّه سيتحسّن بهذا القدر
.في وقت وجيز كهذا

187
00:12:47,660 --> 00:12:48,620
!وجه

188
00:12:49,660 --> 00:12:51,910
!إنّه ليس مجرّد أقوال

189
00:12:52,250 --> 00:12:53,120
!وجه

190
00:12:54,250 --> 00:12:55,080
...لكن

191
00:12:55,330 --> 00:12:58,590
يُثير غضبي بالفعل أن تواصل
!ضربي هكذا بلا سبب

192
00:12:58,790 --> 00:13:01,210
!ماذا قلت؟ سأتحدّاك

193
00:13:01,210 --> 00:13:03,630
!سأهاجم أنا أيضًا –
!أرني ما لديك –

194
00:13:01,920 --> 00:13:03,630
!هذا يكفي

195
00:13:05,050 --> 00:13:06,260
.أورورو

196
00:13:07,510 --> 00:13:11,140
مطعم أكابيكو للحم بقر"
"في القدر السّاخن والسّاكي

197
00:13:11,350 --> 00:13:14,810
!الطّعام ألذّ بالفعل بعد التّدريب

198
00:13:15,270 --> 00:13:19,020
!أنت أيّها الخادم، أريد المزيد

199
00:13:19,230 --> 00:13:21,360
!لا يوجد أرزّ لك هنا

200
00:13:21,570 --> 00:13:24,240
!ماذا؟ أنا زبون

201
00:13:24,240 --> 00:13:26,660
!لا أعلم ما تقول! لم أعترف بك كزبون قطّ

202
00:13:24,740 --> 00:13:26,660
ألن توقفيهما رجاءً؟

203
00:13:26,660 --> 00:13:28,240
.ما عدت أهتمّ

204
00:13:26,660 --> 00:13:29,950
!يا لك من خادم وقح! سأريك

205
00:13:28,240 --> 00:13:29,120
.المعذرة

206
00:13:29,950 --> 00:13:32,240
!ماذا قلت؟! أرني ما لديك

207
00:13:30,280 --> 00:13:31,620
.هذا أنت يا تسوبامي-تشان

208
00:13:32,240 --> 00:13:35,540
هل ذاك صديق لياهيكو-كُن؟

209
00:13:32,240 --> 00:13:35,540
!يمكنني مواجهتك في أيّ وقت

210
00:13:36,580 --> 00:13:38,580
.نعم، نوعًا ما

211
00:13:39,080 --> 00:13:41,130
.يبدو أنّهما متقرّبان جدًّا من بعضهما

212
00:13:41,710 --> 00:13:44,470
نحن نتشاجر! أيّ جزء من ذلك أوحى لك
أنّنا متقرّبان من بعض؟

213
00:13:44,470 --> 00:13:46,090
!لا بدّ أنّك عمياء

214
00:13:46,090 --> 00:13:47,470
!أ-أنا آسفة

215
00:13:47,680 --> 00:13:51,100
!ياهيكو! لا تخف تسوبامي-تشان هكذا

216
00:13:51,760 --> 00:13:52,600
.مـ-مـ-مهلاً لحظة

217
00:13:52,600 --> 00:13:55,060
.تفضّلي لو سمحت

218
00:13:55,180 --> 00:13:57,020
!يوتا-كُن لطيف جدًّا

219
00:13:57,350 --> 00:13:59,480
!إنّه مختلف كثيرًا عن شقيّ أعرفه

220
00:14:01,820 --> 00:14:03,150
.سُحقًا

221
00:14:05,950 --> 00:14:08,820
...يوتا-كُن، لديّ طلب ولكن إن لم تمانع

222
00:14:09,320 --> 00:14:10,320
ما هو؟

223
00:14:10,780 --> 00:14:13,290
لماذا لا تصير واحدًا من تلاميذنا؟

224
00:14:14,700 --> 00:14:15,830
ما رأيك؟

225
00:14:15,830 --> 00:14:17,870
.أعتقد أنّك ستتقدّم كثيرًا

226
00:14:18,210 --> 00:14:22,750
صرتَ سيّافًا يحمل أسلوب
.كاميا كاشّين-ريو مثل ياهيكو بالفعل

227
00:14:25,380 --> 00:14:26,260
.أنا آسف

228
00:14:27,840 --> 00:14:30,140
...أنت معلّمة ممتازة يا كاورو-سان

229
00:14:30,850 --> 00:14:34,350
.وأنا مسرور جدًّا لأنّ لك توّقّعات عالية لي

230
00:14:34,810 --> 00:14:39,770
وواضح لي أنّ هيمورا كنشين
.سيّاف قويّ بالفعل

231
00:14:40,770 --> 00:14:43,020
.مع أنّي أكره رأس الطّائر ذاك

232
00:14:43,020 --> 00:14:45,610
.لا رغبة لي أن أروق لك من الأساس

233
00:14:46,740 --> 00:14:49,200
،لقد استخففت بمسايفة الخيزران

234
00:14:49,200 --> 00:14:51,660
.لكنّها كانت مثيرة للاهتمام فعلاً بمجرّد أن جرّبتها

235
00:14:51,660 --> 00:14:53,580
.التّدريب ممتع في دوجو كاميا

236
00:14:53,580 --> 00:14:58,210
،لكن إن كنتُ أريد أن أصير أقوى
...فأريد بالفعل

237
00:14:59,210 --> 00:15:02,290
.أن أتدرّب على يد رايجوتا-سينسي

238
00:15:10,590 --> 00:15:15,060
.لقد قابلتُه أوّل مرّة في ليلة مثل هذه

239
00:15:16,850 --> 00:15:18,730
.وكان ذلك أمام تمثال الجيزو ذاك

240
00:15:19,390 --> 00:15:21,480
.كنّا نتعرّض للهجوم على يد قطّاع طرق

241
00:15:23,360 --> 00:15:24,190
!أبي

242
00:15:24,940 --> 00:15:28,190
.يمكنك طلب المساعدة يا تسوكاياما-سان

243
00:15:29,070 --> 00:15:33,660
مع أنّ لا أحد سيصغي لك
.ونحن في ضواحي البلدة هكذا

244
00:15:33,870 --> 00:15:34,870
!سُحقًا

245
00:15:35,080 --> 00:15:39,370
!سأعطيكم مالاً قدر ما تريدون
!لذلك أبقوا على حياتي رجاءً

246
00:15:39,370 --> 00:15:40,330
!أبي

247
00:15:40,660 --> 00:15:42,630
.كم هذا مثير للشّفقة

248
00:15:42,630 --> 00:15:47,300
هل حوّلت فخرك كساموراي إلى مال
كما فعلت بالسّيف الّذي كنت تحمله؟

249
00:15:47,670 --> 00:15:50,930
أنت، أن تتوسّل إلينا لنبقي على حياتك أيضًا؟

250
00:15:51,130 --> 00:15:54,090
،كفاك عبثًا معي! أنا ساموراي من طوكيو

251
00:15:54,090 --> 00:15:54,970
—تسوكاياما يو

252
00:15:55,470 --> 00:15:56,350
!يوتارو

253
00:15:57,310 --> 00:15:59,560
.لا تحاول التّظاهر بالقوّة يا فتى

254
00:15:59,560 --> 00:16:05,230
على الأطفال التّصرّف كأطفال
.وتقليد والديهم وهم يتوسّلون

255
00:16:05,730 --> 00:16:07,440
صحيح يا تسوكاياما-سان؟

256
00:16:07,440 --> 00:16:10,440
!أرجوك! أبق على حياتنا

257
00:16:21,460 --> 00:16:22,920
.كانت ضربة واحدة فقط

258
00:16:23,790 --> 00:16:25,790
.أنهت تلك الضّربة كلّ شيء

259
00:16:26,540 --> 00:16:30,420
.انتشر قطّاع الطّرق في كلّ الاتّجاهات وهربوا

260
00:16:30,920 --> 00:16:33,220
!كان سينسي لا يُقهر بالفعل

261
00:16:34,300 --> 00:16:36,430
.شعرتُ بذلك بحقّ ليلتها

262
00:16:38,760 --> 00:16:41,600
رايجوتا ذاك يساعد النّاس؟

263
00:16:41,600 --> 00:16:44,020
.تبدو لي ككذبة كبيرة لا غير

264
00:16:44,020 --> 00:16:45,560
!اخرس يا رأس الطّائر

265
00:16:46,060 --> 00:16:49,900
للجميع مفاهيم خاطئة عنه
.لأنّه لا يتكلّم كثيرًا ولا يظهر مشاعره

266
00:16:51,070 --> 00:16:56,070
تلك القوّة للتّغلّب علىّ كل شيء آخر
.في العالم هي المثل الأعلى بالنّسبة لي

267
00:16:58,490 --> 00:17:00,830
،إن تمكّنت من أن أصير قويًّا مثله

268
00:17:00,830 --> 00:17:04,330
ما كنت لأضطرّ لعيش حياة مثيرة
.للشّفقة مثل والدي

269
00:17:06,670 --> 00:17:07,670
...هيمورا كنشين

270
00:17:08,790 --> 00:17:11,010
ستقاتله في مرحلة ما، صحيح؟

271
00:17:11,710 --> 00:17:15,720
لذلك عندما تقاتله، قاتله بعدل
.وإنصاف في معركة صريحة

272
00:17:17,800 --> 00:17:18,640
.مفهوم

273
00:17:19,350 --> 00:17:21,060
—هكذا على المعارك بين رجلين أن

274
00:17:26,770 --> 00:17:27,730
!سينسي

275
00:17:31,070 --> 00:17:32,320
سينسي؟

276
00:17:32,860 --> 00:17:35,530
كمين من الخلف على الشّارع ليلاً؟

277
00:17:35,860 --> 00:17:38,740
.يبدو أنّ تنكّرك الزّائف ذاك قد سقط أخيرًا

278
00:17:38,740 --> 00:17:41,950
!أنت مخطئ! كانت تلك مجرّد تحيّة

279
00:17:41,950 --> 00:17:43,910
!لم يكن جادًّا بالفعل

280
00:17:44,290 --> 00:17:46,000
أليس كذلك يا سينسي؟

281
00:17:47,880 --> 00:17:49,000
...سينسي

282
00:17:51,420 --> 00:17:53,710
.عليك المغادرة يا كاورو-دونو رجاءً

283
00:18:03,970 --> 00:18:07,020
.هذا تمامًا مثل الزّانباتو خاصّتي

284
00:18:07,480 --> 00:18:11,230
،لا يهمّ ما قدر القوّة الّتي يملكها
.لا فائدة منها إن لم يصب خصمه

285
00:18:12,780 --> 00:18:13,650
!هجوم ليُعمي الخصم

286
00:18:13,650 --> 00:18:14,490
!هذا قذر

287
00:18:14,490 --> 00:18:15,400
!سينسي

288
00:18:17,070 --> 00:18:18,070
.ذلك ليس كافيًا

289
00:18:19,160 --> 00:18:20,410
!وميض مطرقة التّنّين

290
00:18:31,630 --> 00:18:35,920
.يبدو أنّي لن أتمكّن من هزيمتك بالماتوي إيزونا

291
00:18:39,390 --> 00:18:42,560
!كان هذا ورقتي الرّابحة، لكن لا خيار أمامي

292
00:18:45,140 --> 00:18:47,430
!السّيف السّرّيّ: توبي-إيزونا

293
00:18:48,440 --> 00:18:49,310
...ما الّذي

294
00:18:57,110 --> 00:18:58,110
!يوتارو

295
00:18:59,820 --> 00:19:01,700
!أوقف النّزيف ولنأخذه بسرعة للطّبيب

296
00:19:01,950 --> 00:19:04,700
.لن يموت إن لم يصب في نقطة حيويّة

297
00:19:07,160 --> 00:19:11,000
!أيّها الغبيّ! تسبّب هجوك بإصابة تلميذك

298
00:19:11,380 --> 00:19:12,710
ألا تفهم؟

299
00:19:13,420 --> 00:19:17,800
هل تعتقدون فعلاً أنّي سآخذ طفلاً مثله تحت جناحي؟

300
00:19:18,050 --> 00:19:20,010
ماذا قلت؟

301
00:19:20,470 --> 00:19:24,970
لا بدّ أنّكم تعرفون أنّه لا يمكن جني
.المال من المسايفة هذه الأيّام

302
00:19:25,560 --> 00:19:30,100
ولكنّي بحاجة لرأس مال وفير إن أردت
.أن يزدهر أسلوب شينكو-ريو

303
00:19:30,640 --> 00:19:33,560
،ذلك الفتى ابن مستثمر كبير

304
00:19:33,560 --> 00:19:37,610
لذلك تحمّلت طبيعته المزعجة
.وتظاهرت أنّي معلّمه

305
00:19:38,190 --> 00:19:40,990
،من المؤسف أنّي سأفقد مستثمري الآن

306
00:19:40,990 --> 00:19:43,530
.وخاصّة بعد أن جهّزت لسرقة مزيفة للحصول عليه

307
00:19:43,780 --> 00:19:47,040
.لكن لا يهمّ، هناك بدائل كُثر له

308
00:19:47,660 --> 00:19:49,330
...سينسي

309
00:19:50,040 --> 00:19:52,830
.أوّل شيء في جدولي الآن هو هزيمتك

310
00:19:53,920 --> 00:19:54,880
!هيّا بنا

311
00:19:54,880 --> 00:19:56,840
.انتظر هناك فحسب

312
00:19:58,090 --> 00:20:00,300
.سآخذ يوتارو إلى الطّبيب

313
00:20:01,800 --> 00:20:03,930
.وسأواجهك بمجرّد أن أتولّى ذلك

314
00:20:07,010 --> 00:20:08,350
.لا بأس

315
00:20:09,890 --> 00:20:11,890
.ها أنت جادّ أخيرًا

316
00:20:12,600 --> 00:20:17,730
.يا إلهي، لا يدرك رجل الرّيش هذا ما قد فعل

317
00:20:18,190 --> 00:20:24,660
.لقد أجّجت غضب أكثر الرّجال رعبًا في هذا العالم

318
00:20:27,660 --> 00:20:29,620
"عيادة أوغوني"

319
00:20:32,250 --> 00:20:33,330
!ميغومي-سان

320
00:20:33,870 --> 00:20:34,960
كيف حال يوتا-كُن؟

321
00:20:35,500 --> 00:20:38,250
ما الّذي تسبّب في قطع ذلك الفتى؟

322
00:20:38,590 --> 00:20:43,380
،كانت تقطيعًا مثاليًّا وجرحه مفتوح
.لكن لم يكن هناك نزيف كثير

323
00:20:43,380 --> 00:20:45,220
.لم أر شيئًا كهذا من قبل

324
00:20:45,430 --> 00:20:48,260
.لا أعرف الكثير أيضًا

325
00:20:48,260 --> 00:20:49,930
كيف حاله على أيّ حال؟

326
00:20:49,930 --> 00:20:51,770
.حياته ليست في خطر

327
00:20:53,770 --> 00:20:54,650
...ولكن

328
00:20:55,860 --> 00:20:56,770
ماذا؟

329
00:20:57,110 --> 00:21:00,730
.قُطعت أعصابه وأوتاره كلّها

330
00:21:01,320 --> 00:21:03,150
،يا له من فتى مسكين

331
00:21:03,150 --> 00:21:06,700
لن يتمكّن أبدًا من ممارسة المسايفة
.ثانية على الإطلاق

332
00:22:44,960 --> 00:22:49,970
الحلقة القادمة
تسوية المسألة

333
00:22:46,470 --> 00:22:48,760
."في الحلقة القادمة: "تسوية المسألة