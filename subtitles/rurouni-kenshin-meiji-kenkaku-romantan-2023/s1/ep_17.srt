1
00:00:04,520 --> 00:00:06,650
!السّيف السّرّي: توبي إيزونا

2
00:00:10,730 --> 00:00:14,950
،سواء للضّرّاء أو السّرّاء
،أصاب الهجوم ذراع كنشين اليمنى

3
00:00:14,950 --> 00:00:18,740
ما خفّف من قوّته بما يكفي
.كي لا تقطع ذراع الفتى

4
00:00:19,240 --> 00:00:23,120
ولكن لن يتمكّن ذلك الفتى
.من ممارسة المسايفة أبدًا

5
00:00:24,420 --> 00:00:25,750
.مستحيل

6
00:00:29,960 --> 00:00:32,090
.هذا غير معقول أبدًا

7
00:00:32,420 --> 00:00:36,050
!إنّه يراهن بحياته على المسايفة
!وهو موهوب للغاية

8
00:00:36,300 --> 00:00:38,760
لماذا وجب أن تنتهي الأمور هكذا؟

9
00:00:39,010 --> 00:00:42,470
!أولست طبيبًا؟ افعل شيئًا حيال ذلك! هيّا

10
00:00:43,520 --> 00:00:45,810
.الأشياء المستحيلة مستحيلة ببساطة

11
00:00:48,360 --> 00:00:49,940
.آسفة يا ياهيكو-كُن

12
00:00:50,520 --> 00:00:53,900
،هذا أمر مؤسف بالفعل
.لكنّ الأطبّاء لا يصنعون المعجزات

13
00:02:32,000 --> 00:02:36,010
الحلقة 17
تسوية المسألة

14
00:02:36,760 --> 00:02:37,720
هل أنت بخير؟

15
00:02:38,420 --> 00:02:39,510
.يوتا-كُن

16
00:02:40,340 --> 00:02:41,970
...لا يمكنني تحريك ذراعي اليمنى

17
00:02:43,100 --> 00:02:44,680
.أي أنّني لا أحلم

18
00:02:46,850 --> 00:02:48,020
...إنّ سينسي

19
00:02:49,270 --> 00:02:50,520
.خانني بالفعل

20
00:02:54,770 --> 00:02:56,820
.لقد غادر هيمورا-كُن

21
00:02:59,860 --> 00:03:00,910
!سنغادر نحن أيضًا

22
00:03:02,280 --> 00:03:03,120
ماذا؟

23
00:03:03,370 --> 00:03:05,080
.لا يجب عليك أن تتحرّك بهذه السّرعة

24
00:03:05,280 --> 00:03:07,200
.عليك أن تتريّث

25
00:03:07,200 --> 00:03:09,910
.كلاّ. عليه رؤيتهما يسوّيان المسألة

26
00:03:10,410 --> 00:03:12,250
،إن لم تشاهد الأمر بأمّ عينيك

27
00:03:12,250 --> 00:03:13,880
.لن تستطيع الوقوف على قدميك ثانية

28
00:03:18,550 --> 00:03:20,800
.لا أمل يُرجى منهما بالفعل

29
00:03:21,260 --> 00:03:24,680
.راقبيهما جيّدًا كي لا يفعلا أيّ عمل متهوّر

30
00:03:25,180 --> 00:03:26,010
.مفهوم

31
00:03:32,100 --> 00:03:33,230
.لقد تأخّر

32
00:03:33,940 --> 00:03:36,320
.مرّت أزيد من ساعتين الآن

33
00:03:37,150 --> 00:03:41,150
.خاف ذلك الرّجل من سيفي السّرّيّ وهرب

34
00:03:41,650 --> 00:03:42,740
هل أنت غبيّ؟

35
00:03:43,610 --> 00:03:47,240
ما السّبب الّذي يدفعه للهرب منك؟

36
00:03:48,200 --> 00:03:52,710
آسف. أفسدت فرصتك لخلق عذر
.يدفعك للانسحاب

37
00:03:52,920 --> 00:03:54,960
.لن أوقفك إن كنت تريد الذّهاب

38
00:03:54,960 --> 00:03:57,170
.ما باليد حيلة عندما يكون خصمك هو كنشين

39
00:03:58,630 --> 00:04:01,920
،إن هربت الآن بينما تستطيع ذلك
.فسيكون هذا لمصلحتك

40
00:04:02,510 --> 00:04:04,680
.انتبه لكلامك أيّها الشّابّ

41
00:04:05,180 --> 00:04:08,930
.لا أمانع اللّهو بك لإضاعة الوقت

42
00:04:09,390 --> 00:04:12,640
لا أمانع ذلك، ولكن ماذا عنك؟

43
00:04:13,140 --> 00:04:15,020
،ما زالت الخسارة أمام سيّاف مقبولة

44
00:04:15,480 --> 00:04:19,860
،لكن إن خسرت أمام مقاتل مأجور
.فسينتهي أمرك في الحال

45
00:04:30,700 --> 00:04:32,710
.أظنّ أنّ الحظّ ليس لصالحنا

46
00:04:32,910 --> 00:04:35,710
.أخذتَ وقتًا طويلاً، لكنّه عاد الآن

47
00:04:37,630 --> 00:04:39,840
.وصل نجمنا

48
00:04:42,510 --> 00:04:45,130
!سأجعلك تقاتلني بجدّيّة هذه المرّة

49
00:04:45,470 --> 00:04:49,760
!سأهزمك وأطلق حقبة جديدة بالشّنيكو-ريو خاصّتي

50
00:04:53,600 --> 00:04:55,980
تقنيتك الّتي تُدعى إيزونا

51
00:04:55,980 --> 00:05:00,230
هي عبارة عن موجة فراغ نشأت
.عن طريق إزاحة الهواء

52
00:05:00,730 --> 00:05:03,530
.ظاهرة طبيعيّة تُدعى أحيانًا بمنجل الرّياح

53
00:05:03,740 --> 00:05:05,950
.إذًا فقد لاحظت

54
00:05:06,320 --> 00:05:09,330
.لا يوجد نزيف كثير رغم أنّ الجرح مفتوح

55
00:05:09,330 --> 00:05:12,330
.وهذا بالفعل من خصائص إصابات مناجل الرّياح

56
00:05:12,660 --> 00:05:16,040
!لن تتغيّر قوّة إيزونا حتّى إن اكتشفت كيف تعمل

57
00:05:18,040 --> 00:05:23,260
إنّ تغيّر شكل طرف النّصل للحظة
،يشبه تمامًا الارتعاش في الصّيف

58
00:05:23,670 --> 00:05:27,130
.وهو ما ينجم عن تغيّر لحظيّ في كثافة الهواء

59
00:05:29,510 --> 00:05:31,510
.كانت مفتاح اكتشاف ذلك واضحًا

60
00:05:32,010 --> 00:05:35,270
.لكنّني فشلت في القيام بذلك

61
00:05:35,270 --> 00:05:36,440
،من قبل على الأقل

62
00:05:37,060 --> 00:05:39,020
!أمّا الآن فيمكنني الإطاحة بإيزونا

63
00:05:39,270 --> 00:05:40,310
!اخرس

64
00:05:41,730 --> 00:05:45,950
وحدهم أشخاص من المستوى الثّالث
.قد يُصابون بنفس الهجوم مرّتين

65
00:05:46,280 --> 00:05:48,740
.ما كان كنشين ليرتكب ذلك الخطأ ثانية

66
00:05:49,740 --> 00:05:54,830
بما أنّ تقنية التّوبي إيزونا للسّيّف السّرّيّ
.حادّة بشكل كبير، فلا يمكنه صدّ الهجمة

67
00:05:55,330 --> 00:06:00,580
ولكن بالنّسبة لنخبة النّخبة الّذي يستطيع رؤية حتّى
.الرّصاص المنطلق من مسدّس، فتفاديها ليس مستحيلاً

68
00:06:01,590 --> 00:06:03,670
ما رأيك بهذا إذًا؟

69
00:06:05,420 --> 00:06:06,840
!وابل من التّوبي إيزونا

70
00:06:20,190 --> 00:06:23,150
!أرأيت؟ هذه هي إيزونا

71
00:06:23,150 --> 00:06:24,940
أسلوب سيفي السّرّيّ

72
00:06:24,940 --> 00:06:28,610
الّذي وجدته في كتاب للفنون القديمة
.وكرّست 10 من حياتي سنوات لإتقانه

73
00:06:28,820 --> 00:06:31,490
!إنّه ليس شيئًا يمكن هزيمته بسهولة

74
00:06:31,490 --> 00:06:37,450
إنّه رمز أسلوب شينكو-ريو
!والسّيف القاتل الأقوى

75
00:06:38,000 --> 00:06:39,080
هل أنت سعيد؟

76
00:06:43,090 --> 00:06:47,590
تبدو لي في غاية السّعادة لمجرّد
.أنّك استطعت خدشي

77
00:06:48,420 --> 00:06:50,130
ماذا قلت؟

78
00:06:51,140 --> 00:06:53,890
.صرتُ واثقًا من أمر ما يا رايجوتا

79
00:06:54,390 --> 00:06:57,140
واثقًا ممّاذا؟

80
00:06:57,850 --> 00:07:00,480
...تدّعي ممارستك للسّيف القاتل

81
00:07:01,520 --> 00:07:04,360
.لكنّك لم تقتل شخصًا من قبل

82
00:07:05,820 --> 00:07:09,780
إنّ القاتل الحقيقيّ الّذي سقط
على يده آخرون في الماضي

83
00:07:09,780 --> 00:07:13,780
لن يكون فخورًا بلا خجل هكذا
.بسيفه الّذي لم يقتل هدفه

84
00:07:15,160 --> 00:07:20,540
.أنت تجعل عمق هاوية سيفِ قاتِل

85
00:07:20,750 --> 00:07:27,340
كما أنّ سيفك الطّائف الّذي تفخر به
.سلب حقّ ممارسة المسايفة من يوتارو

86
00:07:29,590 --> 00:07:32,470
!تجهّز لدفع ثمن يناسب الجرم الّذي اقترفتَه

87
00:07:35,010 --> 00:07:36,680
!لن أسمح لك بإهانتي هكذا

88
00:07:36,680 --> 00:07:37,850
!سأقتلك

89
00:07:44,520 --> 00:07:47,480
.فهمت. ما زلت تخبّئ ذلك في جعبتك

90
00:07:47,730 --> 00:07:50,400
!مزيج من هجمات ماتوي إيزونا وتوبي إيزونا

91
00:07:52,110 --> 00:07:56,080
،يستعمل ماتوي إيزونا عندما يكون في مداه
.ولا يسمح له بالهجوم

92
00:07:56,280 --> 00:07:59,540
ثمّ بمجرّد خروجه من مداه، ينتقل
.إلى هجوم قاتل باستعمال التّوبي إيزونا

93
00:07:59,750 --> 00:08:02,460
،بما أنّه لا يمكن صدّ أو إيقاف تقنية إيزونا

94
00:08:02,460 --> 00:08:04,630
.فالخيار الوحيد المتبقّي هو مواصلة تفاديها

95
00:08:04,920 --> 00:08:07,130
.وفوق ذلك، ذراعه اليمنى مصابة

96
00:08:07,500 --> 00:08:11,170
ستتقلّص فعالية هجوم وميض مطرق التّنّين
.إلى النّصف باستخدام ذراعه اليسرى فقط

97
00:08:11,420 --> 00:08:14,260
وفوق ذلك، لا يمكنه تنفيذ تقنيات
.سحب السّيف الّذي يتميّز بها

98
00:08:14,590 --> 00:08:17,390
.قد يواجه المشاكل إن ظلّ هذا استنزافًا من طرف واحد

99
00:08:17,680 --> 00:08:19,430
!رأيتُ ثغرة! هناك

100
00:08:20,640 --> 00:08:21,600
!كنشين

101
00:08:22,560 --> 00:08:24,190
!انتهى النّزال

102
00:08:24,690 --> 00:08:29,280
لا يهمّ كم أنت سريع، لا يمكنك
.التّحرّك بحرّيّة على ساق مصابة

103
00:08:29,940 --> 00:08:33,490
سبق وأخبرتك، لا تبتهج كثيرًا في كلّ
.مرّة تخدشني فيها بهجماتك

104
00:08:33,490 --> 00:08:39,450
،اخرس. حتّى إن تباهيتُ بقتالي
.لا يمكنك تنفيذ هجوم مضاد من تلك المسافة

105
00:08:39,660 --> 00:08:44,170
مع أنّ الأمر مختلف إن كنت
.تستطيع استعمال التّوبي إيزوما مثلي

106
00:08:44,500 --> 00:08:48,000
.توبي إيزونا... ذلك شيء أعجز عن القيام به

107
00:08:48,210 --> 00:08:52,210
.بالفعل. أسلوب الشّينكو-ريو هو الأسمى

108
00:08:52,210 --> 00:08:54,550
.وتقنية إيزونا هي الأقوى

109
00:08:55,220 --> 00:08:56,050
!مت

110
00:08:56,260 --> 00:09:00,010
ولكن، الهجمات من خارج المدى
.هو أمر أجيده جيّدًا

111
00:09:06,310 --> 00:09:08,520
!فنّ سحب السّيف لأسلوب هيتن ميتسوروغي-ريو

112
00:09:09,230 --> 00:09:10,520
!وميض التّنّين الطّائر

113
00:09:10,650 --> 00:09:11,860
—ما

114
00:09:52,690 --> 00:09:53,530
!كنشين

115
00:10:01,120 --> 00:10:02,620
!مـ-مكانك

116
00:10:03,160 --> 00:10:05,500
!سأقتل هذا الشّقيّ إن تحرّكت

117
00:10:08,210 --> 00:10:10,840
!أخبرتك أنّي سأقتل هذا الشّقيّ

118
00:10:10,840 --> 00:10:12,840
!ا-ارم ذلك السّيف

119
00:10:13,340 --> 00:10:14,760
.قم بذلك

120
00:10:15,550 --> 00:10:17,550
!هيّا قم بذلك إن استطعت

121
00:10:17,930 --> 00:10:21,300
!حتّى متُّ، فلن أستسلم لشخص مثلك

122
00:10:22,850 --> 00:10:25,020
.الفتى بنفسه يقولك لك أن تفعلها

123
00:10:25,520 --> 00:10:26,890
.دعي أراك تحاول

124
00:10:27,480 --> 00:10:30,190
شينكو-ريو أسلوب سيف قاتل، صحيح؟

125
00:10:33,110 --> 00:10:35,610
...سيف حقيقيّ وفنّ قديم

126
00:10:35,610 --> 00:10:38,990
إنّ مثل هذه الأشياء لا تحدّد سواء
.كان السّيف قاتلاً أم لا لو سحمت

127
00:10:39,450 --> 00:10:43,490
إنّ السّيف الّذي يسقط في الهاوية
...بثقل الأرواح الّتي سلبها

128
00:10:43,990 --> 00:10:45,700
.هو ما يوصف بالسّيف القاتل

129
00:10:46,790 --> 00:10:49,710
.لم تقتل أيّ أحد من قبل

130
00:10:50,170 --> 00:10:54,880
قد يكون أسلوب شينكو-ريو قادرًا على
.قطع الآخرين، لكنّه يعجز عن قتلهم

131
00:10:56,300 --> 00:10:57,670
...تخلّ عن سيفك

132
00:10:58,170 --> 00:11:02,550
.قبل أن تلتقي حامل سيف قاتل حقيقيّ وتفقد حياتك

133
00:11:30,410 --> 00:11:31,250
.هيّا بنا

134
00:11:34,210 --> 00:11:35,340
هل نذهب؟

135
00:11:46,970 --> 00:11:49,520
.الوداع... يا سينسي

136
00:12:05,490 --> 00:12:09,950
أنا جدّ آسف، لكنّ السّيّد الصّغير
.قال أنّه لا يرغب في رؤية أيّ أحد

137
00:12:10,410 --> 00:12:11,790
.هكذا إذًا

138
00:12:12,330 --> 00:12:14,040
.هذه هديّة من أجله

139
00:12:14,040 --> 00:12:15,540
.شكرًا لك

140
00:12:16,250 --> 00:12:18,880
.سنزوره قريبًا

141
00:12:19,340 --> 00:12:21,050
.شكرًا جزيلاً لكم

142
00:12:22,260 --> 00:12:24,050
.أنا أيضًا أتمنّى أن تقوموا بذلك

143
00:12:26,930 --> 00:12:29,180
.لا عجب أنّه منغلق على نفسه الآن

144
00:12:29,520 --> 00:12:32,270
،خانه معلّمه الّذي كان يعتبره الرّجل المثاليّ

145
00:12:32,600 --> 00:12:35,980
وقيل له أنّه لن يستطيع ممارسة
.المسايفة ثانية فوق كلّ ذلك

146
00:12:36,440 --> 00:12:38,940
،كاميا كاشّين-ريو أسلوب مانح للحياة

147
00:12:39,440 --> 00:12:41,940
لكن ماذا عليّ فعله في أوقات كهذه؟

148
00:12:41,940 --> 00:12:43,570
.أشعر أنّي بلا حول ولا قوّة

149
00:12:43,570 --> 00:12:45,950
.لا أستطيع حتّى التّفكير في جملة مواساة واحدة

150
00:13:08,550 --> 00:13:10,430
...بالتّفكير في الأمر

151
00:13:10,890 --> 00:13:14,100
،عندما تغيّرت حياتنا بسرعة بعد ثورة ميجي

152
00:13:14,440 --> 00:13:17,650
،بصفتي كنت ساموراي متدنّي المستوى وبلا علاقات

153
00:13:17,650 --> 00:13:22,570
اعتمدت كثيرًا على مهارات تقييم
.السّيف خاصّتي لأصير تاجر سيوف

154
00:13:22,780 --> 00:13:25,910
،وحقّق ذلك نجاحًا كبيرًا مع الزّبائن الأجانب

155
00:13:25,910 --> 00:13:28,490
.وتمكّنت من جمع ثروتي الحاليّة

156
00:13:29,490 --> 00:13:32,910
في حين أنّ العديد من السّاموراي
،لاقوا نهايتهم في الآونة الأخيرة

157
00:13:32,910 --> 00:13:36,500
.إلاّ أنّ حياتي تعتبر ناجحة من وجهة نظر خارجيّة

158
00:13:37,000 --> 00:13:41,500
،ولكن بعد تغيير كيف تنظر للأمور
.يُمكن القول أنّها حياة فاشل

159
00:13:41,880 --> 00:13:45,760
رغم أنّ هذا كان بغرض إعالة عائلتي
،وحماية منزلي

160
00:13:46,260 --> 00:13:49,600
قدّمت خدمات لأولئك الّذين وصفناهم
ذات يوم بالهمجيّين

161
00:13:49,600 --> 00:13:52,810
.وبعت سيوفًا تُعتبر روح السّاموراي

162
00:13:53,720 --> 00:13:59,690
لا بدّ أنّ هذا هو السّبب الّذي دفع يوتارو
...ليرغب في حياة تختلف عن حياتي

163
00:14:00,360 --> 00:14:02,230
.بدلاً منّي

164
00:14:03,480 --> 00:14:09,450
.ولكنّه خُدع بالقوّة السّطحيّة لإيسوروغي رايجوتا

165
00:14:12,330 --> 00:14:13,410
.ها أنت هنا

166
00:14:14,290 --> 00:14:15,700
.كانت زيارتكم سريعة

167
00:14:16,540 --> 00:14:21,040
،يوزايمون-دونو، يبدو أنّ زيارتنا قد انتهت
...لذلك سنستأذن منك

168
00:14:21,540 --> 00:14:23,050
.حتّى لقاء آخر

169
00:14:23,500 --> 00:14:25,630
.شكرًا جزيلاً لك

170
00:14:25,630 --> 00:14:28,880
.لكن ربّما سيكون لقاؤنا التّالي هو الأخير

171
00:14:29,840 --> 00:14:32,300
،كنتُ أفكّر في خياراتي كثيرًا

172
00:14:32,300 --> 00:14:37,730
.وقرّرت الانتقال إلى ألمانيا وسآخذ يوتارو معي

173
00:14:37,730 --> 00:14:39,060
ألمانيا؟

174
00:14:40,060 --> 00:14:44,610
إنّ ألمانيا هي البلاد الأكثر تقدّمًا
.في العالم من النّاحية الطّبّيّة الآن

175
00:14:44,610 --> 00:14:49,740
،إن ركّزنا على علاجه هناك
...أظنّ أنّه ربّما هناك أمل

176
00:14:49,740 --> 00:14:52,410
وقد تكون الحياة في الخارج

177
00:14:52,410 --> 00:14:56,500
.هو ما يحتاجه يوتارو لينسى أمر المسايفة

178
00:14:57,620 --> 00:15:00,120
.سنغادر بعد أسبوع

179
00:15:00,120 --> 00:15:03,090
.لا فكرة لديّ متى سنعود لليابان

180
00:15:07,630 --> 00:15:11,090
"محطّة شينباشي"

181
00:15:14,260 --> 00:15:17,520
.أشكركم فعلاً جزيل الشّكر على كلّ ما فعلتموه

182
00:15:17,890 --> 00:15:20,940
.قم بتوديعهم الآن يا يوتارو

183
00:15:24,570 --> 00:15:25,610
...يوتا-كُن

184
00:15:27,190 --> 00:15:30,910
.لا أستطيع فعلاً التّفكير في أيّ شيء لمواساته

185
00:15:31,360 --> 00:15:36,370
،"إنّ محاولة إبهاجه بقول "ابذل جهدك
.لن يكون فيها أيّ مواساة له

186
00:15:40,160 --> 00:15:42,920
.سيّدي، حان وقت الذّهاب

187
00:15:42,920 --> 00:15:44,460
.حسنًا، مفهوم

188
00:15:45,040 --> 00:15:46,250
...إذًا

189
00:16:00,560 --> 00:16:01,480
!يوتارو

190
00:16:07,270 --> 00:16:08,650
ياهيكو؟

191
00:16:08,650 --> 00:16:10,150
...هل ستظلّ

192
00:16:10,490 --> 00:16:12,660
محبطًا وكئيبًا هكذا حتّى النّهاية؟

193
00:16:14,320 --> 00:16:17,540
إن كان تعرّضك للخيانة على يد رايجوتا
،قد آلمك بشدّة هكذا

194
00:16:17,870 --> 00:16:21,500
عليك فقط أن تصير أقوى منه
!وتترك عنك ذلك الشّعور بالكامل

195
00:16:21,790 --> 00:16:25,420
!وأنا لا أقصد رايجوتا الّذي هزمه كنشين

196
00:16:25,830 --> 00:16:30,510
!بل رايجوتا الحقيقيّ الّذي حلمت وآمنت به

197
00:16:30,630 --> 00:16:34,510
إن عجزت عن ذلك، فلن تكون سوى
!فاشل خاسر طوال حياتك

198
00:16:36,180 --> 00:16:37,470
!سُحقًا لك

199
00:16:39,930 --> 00:16:42,310
!استمعتُ لك بصمت وأنت تقول كلّ ما يحلو لك

200
00:16:42,640 --> 00:16:44,520
من تصف بالفاشل؟

201
00:16:44,520 --> 00:16:45,650
!يوتارو

202
00:16:45,650 --> 00:16:48,110
!لن أتخلّى أبدًا عن المسايفة

203
00:16:48,520 --> 00:16:49,980
!مستحيل أن أستسلم

204
00:16:50,190 --> 00:16:53,950
،إن كانت ذراعي اليمنى بلا فائدة
!فسأقوم بذلك بيُسراي فحسب

205
00:16:53,950 --> 00:16:57,950
أنا قادر على الإطاحة بك بذراعي اليسرى
!وحدها على أيّ حال قبل كلّ شيء

206
00:16:58,280 --> 00:17:01,830
!كفّ عن وقاحتك معي يا ذا عيون القطّط الكئيبة

207
00:17:02,040 --> 00:17:04,540
!اخرس أيّها الغبيّ الغريب

208
00:17:07,380 --> 00:17:08,210
.هكذا إذًا

209
00:17:09,340 --> 00:17:10,250
.أحسنت

210
00:17:11,760 --> 00:17:12,800
.فهمت

211
00:17:16,260 --> 00:17:18,390
.لا داعي للقلق

212
00:17:22,310 --> 00:17:24,440
.حسنًا، من الأفضل ألاّ تنسى

213
00:17:24,440 --> 00:17:27,270
.ما زلت لم أسوّي المسألة معك بعد

214
00:17:27,560 --> 00:17:29,440
.احرص على العودة

215
00:17:29,440 --> 00:17:34,030
سأحتفظ لك بمقعد التّلميذ الثّاني
.في كاميا كاشّين-ريو في انتظار عودتك

216
00:17:46,830 --> 00:17:48,580
.كانوا أشخاصًا جيّدين

217
00:17:49,420 --> 00:17:54,720
.ما زلتُ مصابًا، لكنّه هاجمني بكلّ قوّته ولم يتهاون

218
00:17:58,260 --> 00:18:02,890
ميوجين ياهيكو، إنّ أوّل شيء سأقوم
.به عندما أعود هو هزيمتك

219
00:18:04,980 --> 00:18:08,400
،حسنًا، بما أنّنا هنا في شينباشي

220
00:18:08,400 --> 00:18:10,110
.دعونا نجرّب بعض الطّبخ الغربيّ

221
00:18:10,360 --> 00:18:12,190
تريدني أن أدعوك للطّعام ثانية؟

222
00:18:13,650 --> 00:18:16,860
هل من خطب يا كنشين؟
.تعلو وجهك نظرة جادّة

223
00:18:17,990 --> 00:18:18,820
...لا شيء

224
00:18:19,410 --> 00:18:22,280
.كنت أفكّر فقط حيال إيسوروغي رايجوتا

225
00:18:22,790 --> 00:18:24,330
.يا له من شخص فظيع

226
00:18:24,830 --> 00:18:29,170
لكنّ ماتوي إيزونا وتوبي إيزونا
.تقنيتان مذهلتان بالفعل

227
00:18:29,670 --> 00:18:31,540
.كان موهوبًا باستعمال السّيف بالفعل

228
00:18:32,130 --> 00:18:37,260
،ولكن لأنّ موهبته لم تكن مثاليّة
لم يشكّك في جوهر السّيوف

229
00:18:37,260 --> 00:18:40,260
.وسعي خلف التّقنيات فقط بكلّ بساطة

230
00:18:41,220 --> 00:18:44,720
لو لم يكن متشبّثًا جدًّا بأسلوب شينكو-ريو
،للسّيوف القاتلة

231
00:18:44,970 --> 00:18:49,190
لكان قادرًا على أن يبدأ أسلوبًا جديدًا
.للمسايفة في عالم فترة ميجي

232
00:18:50,400 --> 00:18:53,860
آمل أن يستطيع إدراك أنّه كان محظوظًا

233
00:18:53,860 --> 00:18:58,400
.لأنّه لم يتجاوز الحدود ويقتل شخصًا آخر

234
00:19:01,070 --> 00:19:03,200
أنتما، ماذا تفعلان؟

235
00:19:03,200 --> 00:19:04,490
!لنذهب بسرعة

236
00:19:06,830 --> 00:19:12,590
تحدّث مايكاوا-دونو من تشويتسو-ريو
.من قبل عن مستقبل المسايفة

237
00:19:13,170 --> 00:19:15,800
.وقتها، بدا لي خائب الأمل بالفعل

238
00:19:17,170 --> 00:19:20,300
،لكن بالنّظر إلى ياهيكو ويوتارو

239
00:19:20,890 --> 00:19:23,510
.لا أعتقد أنّ هنالك ما نقلق عليه

240
00:19:26,060 --> 00:19:28,600
"كاميا كاشّين-ريو"

241
00:19:28,600 --> 00:19:34,060
تسوكاياما يوتارو"
"(محجوز)

242
00:19:28,600 --> 00:19:34,060
"ميوجين ياهيكو"

243
00:19:28,600 --> 00:19:34,060
"تلاميذ"

244
00:19:28,600 --> 00:19:34,060
"كاميا كاورو"

245
00:19:30,900 --> 00:19:31,940
.معك حقّ

246
00:21:15,790 --> 00:21:19,920
!سأقتل

247
00:21:17,460 --> 00:21:18,920
!لا يهمّ من يكون

248
00:21:28,390 --> 00:21:34,230
إنّ مثل هذه الأشياء لا تحدّد سواء
.كان السّيف قاتلاً أم لا لو سحمت

249
00:21:35,230 --> 00:21:39,440
إنّ السّيف الّذي يسقط في الهاوية
...بثقل الأرواح الّتي سلبها

250
00:21:40,230 --> 00:21:42,150
.هو ما يوصف بالسّيف القاتل

251
00:22:03,010 --> 00:22:05,050
...يا إلهي، هذا

252
00:22:45,050 --> 00:22:50,010
الحلقة القادمة
سانوسكي ورسومات نيشيكيي

253
00:22:46,720 --> 00:22:49,510
."في الحلقة القادمة: "سانوسكي ورسومات نيشيكيي