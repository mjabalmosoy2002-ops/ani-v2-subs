1
00:00:01,980 --> 00:00:05,150
،مناصر الإمبراطوريّة من تشوشو
.هيمورا باتّوساي

2
00:00:05,940 --> 00:00:09,480
عملتَ لخمس سنوات مذ كنتَ
.في 14 حتّى 19 سنة

3
00:00:09,480 --> 00:00:11,570
،قضيت النّصف الأوّل كقاتل

4
00:00:11,570 --> 00:00:14,450
.مغتال بلا رحمة يقبع في الظّلال

5
00:00:14,700 --> 00:00:17,870
وفي النّصف الثّاني، كنتَ سيّافًا مغوارًا

6
00:00:17,870 --> 00:00:20,490
.يحمي زملاءه في سيّافي الشّوغونيّة

7
00:00:21,250 --> 00:00:25,370
أنت مشهور حتّى يومنا هذا
.بسبب عملك الثّاني

8
00:00:26,080 --> 00:00:27,080
!مهلاً لحظة

9
00:00:27,500 --> 00:00:28,880
.لا أنصحك بهذا

10
00:00:29,380 --> 00:00:33,090
،إن ظلّ الباتّوساي الحقيقيّ هنا
.فسيضيع كلّ شيء سدى

11
00:00:33,090 --> 00:00:35,550
.لا أقول أنّي أريد من الباتّوساي البقاء هنا معي

12
00:00:35,550 --> 00:00:37,220
—أريدك أنت أيّها الرّوروني أن تظلّ

13
00:00:39,220 --> 00:00:41,930
!لا-لا بأس! اذهب إن كان هذا ما تريده

14
00:00:42,640 --> 00:00:46,520
ولكن يمكنك إطلاعي على اسمك
.قبل ذهابك على الأقلّ

15
00:00:46,980 --> 00:00:51,360
أم أنّك لا تريد حتّى أن تخبرني باسمك الحقيقيّ؟

16
00:00:54,650 --> 00:00:55,530
.كنشين

17
00:00:57,820 --> 00:00:59,030
.هيمورا كنشين

18
00:01:00,160 --> 00:01:02,450
.ذاك هو اسمي الحاليّ

19
00:01:03,450 --> 00:01:07,080
وبصفتي روروني، لا أعرف متى
.سأرتحل لوجهتي التّالية

20
00:01:07,580 --> 00:01:08,920
...ولكن إن لم تمانعي

21
00:01:09,420 --> 00:01:12,170
.فسأظلّ هنا في الوقت الحاليّ

22
00:01:21,140 --> 00:01:24,060
.أورو؟ يا لها من رائحة عطِرة

23
00:01:24,390 --> 00:01:28,480
أذلك واضح؟ قلت لنفسي لماذا لا أقوم
.بشراء شاي أعلى جودة من المعتاد

24
00:01:28,480 --> 00:01:30,860
.معك حقّ. إنّه لذيذ جدًّا

25
00:01:31,070 --> 00:01:34,320
.إنّك يا آنسة تحبّين الأمور ذات المذاق الجيّد

26
00:01:35,240 --> 00:01:37,200
.لا تفكّر سوى في معدتها

27
00:01:37,200 --> 00:01:40,240
.ولكن يتسنّى لي تناول طعام جيّد بفضل ذلك

28
00:01:40,240 --> 00:01:42,030
.أقدّر لك هذا إن كان ما تشعر به

29
00:01:42,830 --> 00:01:44,450
.أقدّر لك هذا

30
00:01:47,540 --> 00:01:51,210
كم مرّت من سنة مذ تذوّقت
.شايًا لذيذًا كهذا

31
00:01:52,090 --> 00:01:54,090
.أنت تبالغ يا كِن-سان

32
00:01:54,090 --> 00:01:57,300
.واثقة أنّك حظيت ببعض الشّاي أثناء تجوالك

33
00:01:58,800 --> 00:02:00,850
،بما أنّي كنت بعيدًا عن المنزل

34
00:02:00,850 --> 00:02:03,510
.فلم أستقرّ في أيّ مكان لشرب الشّاي

35
00:02:03,720 --> 00:02:06,770
ماذا؟ لماذا لا تقصّ علينا إحدى قصص تجوالك؟

36
00:02:06,770 --> 00:02:08,980
.أريد سماع قصّة غير عاديّة

37
00:02:09,190 --> 00:02:10,860
.يبدو ذلك جيّدًا

38
00:02:10,860 --> 00:02:13,230
إذًا هل يمكنك إخبارنا بقصّة ممتعة؟

39
00:02:13,230 --> 00:02:16,440
أريد أن ينتابني شعور ممتاز بعد سماع
.قصّة عن هزيمتك لبعض الأشرار

40
00:02:16,780 --> 00:02:17,900
...ذلك

41
00:02:17,900 --> 00:02:19,030
.تمهّلوا جميعًا

42
00:02:19,280 --> 00:02:21,160
.إنّكم تزعجون كنشين

43
00:02:21,160 --> 00:02:22,740
.لا تطلبوا منه المستحيل

44
00:02:22,740 --> 00:02:24,700
...أمهلوني لحظة رجاءً

45
00:02:24,950 --> 00:02:31,040
...غير عاديّة وممتعة وتضمّ هزيمة أشرار

46
00:04:05,930 --> 00:04:09,930
الحلقة 20
قصّة سيّاف ميجي الرّومانسيّة
الفصل صفر الجزء الأوّل

47
00:04:11,640 --> 00:04:14,770
.مستوطنة يوكوهاما للأجانب

48
00:04:15,520 --> 00:04:19,980
في فترة باكوماتسو، تمّ توقيع معاهدات
،صداقة وتجارة مع عدّة دول

49
00:04:19,980 --> 00:04:22,190
.فُتح ميناء يوكوهاما

50
00:04:22,780 --> 00:04:29,080
خُصّصت هذه المنطقة لتكون مكانًا
.للإقامة والتّجارة للأجانب

51
00:04:30,160 --> 00:04:31,910
!ابتعد عن الطّريق

52
00:04:32,410 --> 00:04:33,250
أورو؟

53
00:04:33,460 --> 00:04:34,460
!لديّ عمل مستعجل

54
00:04:34,460 --> 00:04:36,920
أورو؟ أورو؟ أورو؟ –
!ابتعد! ابتعد! ابتعد –

55
00:04:38,500 --> 00:04:40,880
كلاّ! هل أنت بخير؟

56
00:04:42,210 --> 00:04:43,760
ماذا يحدث هنا رجاءً؟

57
00:04:43,760 --> 00:04:44,590
!مهلاً

58
00:04:44,840 --> 00:04:47,510
!كم ارتحت الآن! سرّني أنّك بخير

59
00:04:47,510 --> 00:04:49,560
!ظننتُ أنّي أفسدت الأمور فعلاً هذه المرّة

60
00:04:50,140 --> 00:04:54,690
.هكذا إذًا، أبدو بخير في نظرك
.هذا جيّد على ما أظنّ

61
00:04:55,190 --> 00:04:56,940
.أنا جدّ آسف بالفعل

62
00:04:56,940 --> 00:04:58,900
.أنا سائق هذه العربة وأدعى دانكيتشي

63
00:04:58,900 --> 00:05:00,320
...وأنت

64
00:05:00,770 --> 00:05:02,150
.أنا روروني

65
00:05:02,740 --> 00:05:03,740
—رورو

66
00:05:03,740 --> 00:05:05,990
.تعني سيّاف جوّال بدلا أيّ أهدف محدّد

67
00:05:06,490 --> 00:05:07,740
...سيّاف

68
00:05:07,740 --> 00:05:10,200
هل يعني هذا أنّك ساموراي؟

69
00:05:11,120 --> 00:05:12,580
!تحمل كاتانا بالفعل

70
00:05:13,040 --> 00:05:13,870
أورو؟

71
00:05:13,870 --> 00:05:15,620
!هذا يخالف مرسوم منع حمل السّيف

72
00:05:16,120 --> 00:05:20,340
،صحيح أنّ هذا سيفُ كاتانا
—ولكنّه في الحقيقة

73
00:05:20,540 --> 00:05:22,710
!تعال إلى هنا يا سائق العربة

74
00:05:22,710 --> 00:05:25,050
!صحيح! لا يمكنني الوقوف هنا فحسب

75
00:05:25,050 --> 00:05:25,880
أورورو؟

76
00:05:28,510 --> 00:05:30,350
انهارت في الشّارع؟

77
00:05:30,350 --> 00:05:32,520
!بسرعة! خذها إلى الطّبيب رجاءً

78
00:05:32,770 --> 00:05:34,810
".العلاج سباق مع الزّمن"

79
00:05:35,310 --> 00:05:37,850
هذا ما توقّعته، لذلك أحضرت معي
...على عربتي الجميلة

80
00:05:38,060 --> 00:05:39,060
!الطّبيب

81
00:05:43,030 --> 00:05:43,860
!هذا مثير للشّبهة

82
00:05:44,610 --> 00:05:46,280
!لا بأس

83
00:05:46,280 --> 00:05:48,320
!لستُ مثيرًا للشّبهات

84
00:05:51,580 --> 00:05:52,950
.شخص غربيّ

85
00:05:52,950 --> 00:05:54,290
.ويرتدي قناعًا

86
00:05:54,500 --> 00:05:58,870
،إن لم يكن هذا مثيرًا للشّبهات
.فإنّ يوكوهاما مكان رائع بالفعل

87
00:05:59,330 --> 00:06:01,250
!هذا سوء فهم! مجرّد سوء فهم

88
00:06:01,460 --> 00:06:04,340
أما من مانع يا دانكيتشي-سان؟

89
00:06:04,340 --> 00:06:05,170
ماذا؟

90
00:06:05,460 --> 00:06:08,380
،الأجانب كثيرون في هذه المناطق

91
00:06:08,380 --> 00:06:12,100
لكن هل يمكنك الوثوق في طبيب
لا تعرف حتّى وجهه أو أصله؟

92
00:06:12,220 --> 00:06:13,640
عمّ تتحدّث؟

93
00:06:13,640 --> 00:06:16,730
يُقال أنّه إن عاش المرء في إيدو
،لثلاثة أجيال، فسيصير منها

94
00:06:16,730 --> 00:06:19,690
لكن إن عشت في يوكوهاما
.لثلاثة أيّام، فستصير منها

95
00:06:19,690 --> 00:06:20,520
.بالفعل

96
00:06:20,520 --> 00:06:21,980
...هذا ما يقال، لكن

97
00:06:21,980 --> 00:06:25,610
إنّ الطّبيب إلدر يقيم في يوكوهاما
.لأكثر من ثلاثة أيّام

98
00:06:25,610 --> 00:06:28,400
ألا يمكنكم الوثوق في أحد مواطني يوكوهاما مثلكم؟

99
00:06:28,530 --> 00:06:33,620
،أنا أثق بك يا دانكيتشي-سان
...أمّا الأجنبيّ

100
00:06:33,830 --> 00:06:35,700
!جميعنا مواطنو يوكوهاما

101
00:06:35,700 --> 00:06:37,830
!إنّنا في طليعة عصر التّنوير

102
00:06:37,830 --> 00:06:39,670
!أمّي

103
00:06:40,920 --> 00:06:44,380
لا داعي للقلق! الطّبيب إلدر
!هو الأفضل في العالم بأسره

104
00:06:44,750 --> 00:06:47,170
!إنّه إلى جانب كلّ المصابين والمرضى

105
00:06:54,180 --> 00:06:55,510
.دانكيتشي-سان

106
00:06:55,510 --> 00:06:56,350
!نعم

107
00:06:56,350 --> 00:06:58,430
.أحتاج لإعداد أدوية

108
00:06:58,640 --> 00:07:02,100
.خذ هذه المرأة إلى غرفتي في الفندق رجاءً

109
00:07:02,100 --> 00:07:02,940
!حاضر

110
00:07:03,310 --> 00:07:04,150
!في الحال

111
00:07:04,150 --> 00:07:06,320
!ابتعد عن الطّريق

112
00:07:06,730 --> 00:07:07,650
—ما الّذي تظنّ

113
00:07:08,610 --> 00:07:09,780
...أنت

114
00:07:10,110 --> 00:07:11,320
!إيشيزو ديان

115
00:07:11,820 --> 00:07:15,740
.سمعتُ بالجلبة هنا وأتيت
...إذًا فهذا أنت ثانية

116
00:07:15,950 --> 00:07:19,210
.أيّها الطّبيب الغربيّ المتجوّل الغامض

117
00:07:19,500 --> 00:07:25,170
إنّك تزعجني فعلاً بعلاجاتك الطّبّيّة
.بدون إذن في منطقتي

118
00:07:25,380 --> 00:07:26,880
بدون إذنك؟

119
00:07:26,880 --> 00:07:30,260
!إنّك لا تعالج سوى الغربيّين والأثرياء

120
00:07:30,260 --> 00:07:31,840
.بطبيعة الحال

121
00:07:31,840 --> 00:07:34,470
.من لا يدفع لا يحقّ له العيش

122
00:07:34,680 --> 00:07:37,520
!إذًا فهذا لا يعنيك أبدًا

123
00:07:37,520 --> 00:07:40,100
!يعتني الطّبيب إلدر بمن لا يمكنهم الدّفع

124
00:07:40,230 --> 00:07:42,560
.لهذا السّبب يزعجني هذا الأمر

125
00:07:43,520 --> 00:07:47,820
الرّعاية الطّبّيّة تكنولوجيا لها تكلفة
.عالية بحدّ ذاتها من الأساس

126
00:07:47,820 --> 00:07:53,240
إنّ قيمة الطّبّ الغربيّ الّذي تمّ استيراده
.في فترة ميجي تصاعدت بشكل كبير

127
00:07:53,820 --> 00:07:58,700
،لذلك إن تركتُ شخصًا يقدّمها بدون أيّ مقابل

128
00:07:59,040 --> 00:08:02,410
،فسيؤثّر ذلك على الجميع
.وستنهار الأثمنة بكلّ تأكيد

129
00:08:03,710 --> 00:08:07,840
لا تعالج تلك المرأة الّتي تحتضر
...في الشّارع. وإن فعلت

130
00:08:07,840 --> 00:08:10,300
ستلحق الأذى بي؟

131
00:08:10,510 --> 00:08:15,930
هذه سخافة. يعرف الجميع أنّ مهاجمة
.أجنبيّ في مستوطنته ممنوع

132
00:08:15,930 --> 00:08:17,390
...من سيتعرّض للأذى

133
00:08:17,640 --> 00:08:19,390
.هو تلك المرأة

134
00:08:19,390 --> 00:08:23,350
،إن لم يكن هنالك أمل من علاج مريض
!فمن المستحيل أن ينجح العلاج

135
00:08:23,350 --> 00:08:24,560
!أمّي

136
00:08:28,400 --> 00:08:29,900
.هذا يكفي كلاكما

137
00:08:30,360 --> 00:08:33,360
.الأولويّة هنا هي لعلاج هذه المرّة ولا شيء آخر

138
00:08:33,700 --> 00:08:35,410
!على الفضوليّين عدم حشر أنوفهم فيما لا يعنيهم

139
00:08:35,910 --> 00:08:39,160
...هل ترى خنجري اللاّمع

140
00:08:39,580 --> 00:08:42,040
!كـ-كـ-كاتانا

141
00:08:42,160 --> 00:08:44,790
ما قصّة ذلك؟ إنّه يخالف
!مرسوم منع حمل السّيف

142
00:08:44,790 --> 00:08:46,130
!لا يحقّ لك قول ذلك

143
00:08:46,540 --> 00:08:50,380
تتظاهر أنّك ساموراي هنا في يوكوهاما
خلال فترة ميجي؟

144
00:08:50,550 --> 00:08:51,380
.لقد طار

145
00:08:55,760 --> 00:08:57,680
!كفاك قفزًا من مكان لآخر

146
00:09:01,140 --> 00:09:03,270
!أيّها الرّوروني! كان ذلك مثاليًّا

147
00:09:03,480 --> 00:09:05,480
!دع أمر الأمّ وابنتها لي

148
00:09:06,560 --> 00:09:07,560
!اللّعنة عليك

149
00:09:07,560 --> 00:09:09,360
!بسرعة يا إلدر-دونو

150
00:09:11,030 --> 00:09:11,980
قناع؟

151
00:09:11,980 --> 00:09:13,150
.غامض

152
00:09:13,690 --> 00:09:15,200
هل هو طبيب بالفعل؟

153
00:09:15,200 --> 00:09:17,410
.من الأفضل ألاّ نتدخّل في الأمر

154
00:09:17,410 --> 00:09:18,450
.صحيح

155
00:09:20,080 --> 00:09:21,620
حارس شخصيّ؟

156
00:09:22,370 --> 00:09:26,710
،فهمت. إن كان الأمر هكذا
!فلديّ خطّة أنا أيضًا

157
00:09:27,500 --> 00:09:29,590
.تعقّب أين يعيش ذلك الرّجل

158
00:09:29,590 --> 00:09:31,210
.سأرسل له رسالة

159
00:09:31,210 --> 00:09:32,090
.حاضر

160
00:09:44,060 --> 00:09:46,440
.لديّ غرفة أخرى في هذا الفندق

161
00:09:46,940 --> 00:09:50,110
.سيكون من الأفضل أن ترتاح حتّى يتحسّن حالها

162
00:09:50,560 --> 00:09:52,570
.يبدو أنّ الدّواء ينفع

163
00:09:53,070 --> 00:09:55,570
.ستكون بخير بمجرّد أن تنزل حرارتها

164
00:09:56,070 --> 00:09:58,110
.شكرًا لك أيّها الطّبيب الأجنبيّ

165
00:09:58,320 --> 00:10:00,070
.على الرّحب والسّعة

166
00:10:01,410 --> 00:10:03,660
.يا له من عمل متقن

167
00:10:03,660 --> 00:10:06,410
.هذا ما حدث أيضًا عندما كسرت قدمي

168
00:10:06,620 --> 00:10:08,960
،لم يقبل أنخذ أيّ مال منّي

169
00:10:08,960 --> 00:10:11,750
بما أنّي لن أستطيع جني المال
.من عربتي حتّى أشفى

170
00:10:11,960 --> 00:10:16,050
وفوق ذلك، إنّه يسمح لي بجني المال
.باستمراره لدعمي حتّى بعد أن شفيت

171
00:10:16,590 --> 00:10:19,050
.إنّه لا يأخذ المال ممّن لا يمكنهم الدّفع

172
00:10:19,050 --> 00:10:21,350
.ويعالج من هم بحاجة لعلاج بملء إرادته

173
00:10:21,850 --> 00:10:23,850
.هذه هي طبيعة ذلك الطّبيب

174
00:10:24,060 --> 00:10:26,680
.شكرًا جزيلاً لك يا دانكيتشي-سان

175
00:10:26,680 --> 00:10:27,690
.لا، لا، لا

176
00:10:27,850 --> 00:10:31,150
.أنا من عليه شكرك لمواصلتك دعمي

177
00:10:31,650 --> 00:10:33,570
أتريد أن أوصلك أيّها الرّوروني؟

178
00:10:33,770 --> 00:10:36,070
.لا تأخذ المال ممّن لا يمكنهم الدّفع

179
00:10:36,070 --> 00:10:37,990
...والعمل من أجل من من يحتاجون العون

180
00:10:37,990 --> 00:10:40,030
.الرّكوب بدون دفع يقود بك للشّرطة مباشرة

181
00:10:42,450 --> 00:10:45,200
.أنا روروني، لذلك سأسير على قدميّ لو سمحت

182
00:10:45,700 --> 00:10:48,460
.نعم. هذا يليق بك أكثر

183
00:10:48,750 --> 00:10:52,000
.أيّها الرّوروني، شكرًا جزيلاً لك على المساعدة

184
00:10:52,590 --> 00:10:55,050
ما رأيك أن أدعوك لشرب شاي كعربون شكر؟

185
00:10:55,050 --> 00:10:56,510
.شاي المساء

186
00:10:56,510 --> 00:10:57,340
أورو؟

187
00:10:57,550 --> 00:10:59,840
.أنت مدعوّ أيضًا يا دانكيتشي-سان

188
00:10:59,840 --> 00:11:03,260
،ماذا؟ لا أعرف ما هو هذا الشّيء
!لكنّي سأرافقك بكلّ سرور

189
00:11:05,100 --> 00:11:08,810
،الجوّ جميل هذا اليوم
.لذلك لنشرب الشّاي في الخارج

190
00:11:08,810 --> 00:11:10,140
.هذا يناسبني

191
00:11:10,140 --> 00:11:12,650
هذا يشبه مراسم شرب شاي
في الهواء الطلق، صحيح؟

192
00:11:15,770 --> 00:11:16,610
.تفضّلوا

193
00:11:18,780 --> 00:11:19,740
.شكرًا لك

194
00:11:23,990 --> 00:11:25,740
.سيف ساموراي

195
00:11:26,330 --> 00:11:29,210
.يستحقّ الأمر قدومي كلّ هذه المسافة لليابان

196
00:11:31,960 --> 00:11:33,710
سيف غربيّ؟

197
00:11:41,300 --> 00:11:43,090
.إنّها حديقة جيّدة إن جاز لي التّعبير

198
00:11:43,720 --> 00:11:45,890
.رائحة نبات الغار رائعة

199
00:11:45,890 --> 00:11:47,310
.الرّبيع وشيك

200
00:11:48,140 --> 00:11:50,140
.تفضّلا، بالهناء والشّفاء

201
00:11:50,350 --> 00:11:54,610
!حسنًا، احتفالاً بلقاء الرّوروني، سأقول بصحّتكما

202
00:11:56,570 --> 00:11:59,400
.لا تقلق حيال التّفاصيل الصّغيرة أيّها الطّبيب

203
00:12:01,820 --> 00:12:05,030
!مهلاً! هكذا هو الشّاي والحلويّات الغربيّة إذًا

204
00:12:05,030 --> 00:12:07,280
!سأبدأ في الأكل

205
00:12:12,620 --> 00:12:13,460
!لذيذة

206
00:12:14,380 --> 00:12:17,920
.هيّا أيّها الرّوروني
.من الخسارة أن تتصرّف بتحفّظ الآن

207
00:12:19,420 --> 00:12:20,970
.سأتناولها بعد إذنكما

208
00:12:30,520 --> 00:12:32,430
هل الرّائحة زكيّة؟

209
00:12:34,140 --> 00:12:36,480
.الحلويّات حلوة ولذيذة

210
00:12:36,810 --> 00:12:38,570
ماذا عن الشّاي الأسود؟

211
00:12:38,570 --> 00:12:40,940
.لقد استعملوا أوراق شاي عالية الجودة

212
00:12:41,440 --> 00:12:44,320
.شكرًا لتقديمك شيئًا ليس مألوفًا عندي

213
00:12:45,530 --> 00:12:49,830
هل يعقل أنّه لا يمكنك شمّ روائح الشّاي؟

214
00:12:51,410 --> 00:12:53,040
.ليس كثيرًا في الحقيقة

215
00:12:53,290 --> 00:12:54,790
.هكذا إذًا

216
00:12:54,790 --> 00:12:57,250
.تبدو متعبًا قليلاً أيضًا

217
00:12:57,460 --> 00:13:00,460
!هذا طبيعيّ بعد تلك الفوضى الكبيرة

218
00:13:01,050 --> 00:13:05,180
.لكنّي لا أشعر بأيّ إعياء لو سمحت

219
00:13:05,180 --> 00:13:08,890
.هناك إعياء يختلف عن التّعب الجسديّ

220
00:13:09,720 --> 00:13:14,020
،بإمكانك شمّ الزّهور
.ولكن لا يمكنك شمّ الشّاي الأسود

221
00:13:14,020 --> 00:13:16,350
.هذه علامة للإعياء النّفسيّ

222
00:13:17,440 --> 00:13:18,650
...النّفسيّ

223
00:13:19,570 --> 00:13:22,940
.يقول الأطبّاء الغربيّون أشياء كثيرة مثيرة للاهتمام

224
00:13:24,240 --> 00:13:27,530
أخبرني، أنت ساموراي مشهور جدًّا، صحيح؟

225
00:13:27,780 --> 00:13:29,700
...لا، ما كنت

226
00:13:29,700 --> 00:13:32,870
لا بدّ أنّ شهدت على الكثير من الأحداث
!في فترة باكوماتسو

227
00:13:33,080 --> 00:13:35,120
...عرفتك! أن واحد من أولئك

228
00:13:35,120 --> 00:13:36,080
!الشّينسنغومي

229
00:13:37,920 --> 00:13:39,340
هل أنت بخير؟

230
00:13:40,790 --> 00:13:43,920
لا بدّ أنّ الوضع كان صعبًا في كيوتو
...في فترة باكوماتسو

231
00:13:43,920 --> 00:13:45,930
.لكنّه كان صعبًا هنا في يوكوهاما أيضًا

232
00:13:46,430 --> 00:13:50,050
!فمستوطنة الأجانب هذه بُنيت فجأة وبسرعة

233
00:13:51,100 --> 00:13:53,640
.صارت مدينة مثيرة للاهتمام بالفعل

234
00:13:54,140 --> 00:13:58,100
أراهن إنّ مستوى التّنوير فيها يعادل
.مستوى طوكيو وهاكوداتي

235
00:13:59,100 --> 00:14:02,770
واثق أنّ العديد من الأغراض والابتكارات
الغربيّة المثيرة للاهتمام

236
00:14:02,770 --> 00:14:06,570
من تكنولوجيا جديدة موجودة هنا
.في يوكوهاما الآن

237
00:14:06,700 --> 00:14:09,910
!بالتّأكيد! هذا مكان رائع بالفعل

238
00:14:09,910 --> 00:14:11,240
!أحبّه كثيرًا

239
00:14:11,490 --> 00:14:14,830
،في الحقيقة، هناك مناظر كثير أوصي بها

240
00:14:14,830 --> 00:14:16,290
لذا أتريد جولة في عربتي؟

241
00:14:16,790 --> 00:14:19,670
.ليس لديّ مال كافٍ لسوء الحظّ

242
00:14:19,670 --> 00:14:21,290
.هكذا إذًا

243
00:14:22,290 --> 00:14:24,460
ما رأيك في هذا؟

244
00:14:24,460 --> 00:14:26,510
.قم أنت بجرّي بالعربة

245
00:14:26,760 --> 00:14:29,470
.وسأعطيك قائمة بجميع المعالم

246
00:14:29,470 --> 00:14:31,600
.لن تحتاج للدّفع بهذه الطّريقة

247
00:14:31,600 --> 00:14:33,600
!فكرة مثيرة للاهتمام

248
00:14:34,970 --> 00:14:37,520
!عليك القدوم معنا أيضًا أيّها الطّبيب إلدر

249
00:14:37,730 --> 00:14:39,230
ماذا؟ أنا أيضًا؟

250
00:14:39,730 --> 00:14:41,270
.تسع العربة شخصًا واحدًا

251
00:14:41,270 --> 00:14:44,070
.سيظلّ أحدنا في الخلف إن كنّا ثلاثة

252
00:14:44,230 --> 00:14:46,320
!سنسوّى المسألة بحجر-ورقة-مقصّ

253
00:14:46,320 --> 00:14:48,650
!سيجرّ العربة أوّل من سيخسر

254
00:14:48,650 --> 00:14:49,820
!وسيركب الفائز

255
00:14:50,320 --> 00:14:52,780
.ويستطيع الثّاني الرّكض إلى جانب العربة

256
00:14:52,990 --> 00:14:56,120
...ولكن هكذا، إن خسرت أنت

257
00:14:56,620 --> 00:14:58,580
!لا داعي للقلق حيال التّفاصيل

258
00:15:00,120 --> 00:15:01,580
...حجر، ورقة، مقصّ

259
00:15:01,790 --> 00:15:02,630
!هيّا

260
00:15:02,630 --> 00:15:03,460
أورو؟

261
00:15:03,670 --> 00:15:04,920
.تعادل

262
00:15:05,050 --> 00:15:05,960
!هيّا

263
00:15:05,960 --> 00:15:06,800
أورو؟

264
00:15:07,130 --> 00:15:09,050
!هيّا –
أورو؟ –

265
00:15:09,180 --> 00:15:10,680
!هيّا! هيّا –
أورو؟ أورو؟ –

266
00:15:10,930 --> 00:15:12,180
!هيّا –
أورو؟ –

267
00:15:12,800 --> 00:15:14,890
!إنّها متوافقون كثيرًا بالفعل

268
00:15:15,260 --> 00:15:18,600
!هذا لا يعقل بالفعل! إنّها معجزة

269
00:15:18,850 --> 00:15:20,310
أورو؟

270
00:15:20,640 --> 00:15:23,810
.لكنّ هذا لن يوصلنا لأيّ نتيجة

271
00:15:23,810 --> 00:15:24,940
ماذا عن سحب عيدان القشّ؟

272
00:15:25,440 --> 00:15:27,440
!سنحترم النّتيجة مهما كانت

273
00:15:33,070 --> 00:15:35,080
!سأجرّ العربة

274
00:15:35,080 --> 00:15:36,950
.أنا هو الرّاكب، بعد إذنكما

275
00:15:36,950 --> 00:15:38,910
!حسنًا! لننطلق

276
00:15:48,550 --> 00:15:52,090
.مستوطنة يوكوهاما 39

277
00:15:52,090 --> 00:15:56,640
بذل المبشّر الأمريكيّ هيبورن جهودًا كبيرة
لنشر الطّبّ في اليابان

278
00:16:03,150 --> 00:16:09,530
في تلك الفترة، لم يكن ميناء يوكوهاما
،بعمق كافٍ لرسو السّفن الكبيرة

279
00:16:09,530 --> 00:16:14,410
لذا قامت السّفن الصّغيرة المعروفة
.بالبوارج بنقل البضائع إلى الأرصفة

280
00:16:14,910 --> 00:16:20,080
صار يُطلق على الرّصيف المنحني
.لكسر الأمواج اسم خرطوم الفيل

281
00:16:24,460 --> 00:16:26,170
.محطّة يوكوهاما

282
00:16:26,670 --> 00:16:29,260
انطلقت أوّل خدمة قطارات في اليابان

283
00:16:29,260 --> 00:16:32,470
في السّنة الخامسة لفترة ميجي
،بين سانباشي ويوكوهاما

284
00:16:32,470 --> 00:16:34,890
.ورمزت لحركة التّنوير

285
00:16:35,550 --> 00:16:38,850
كان مبنى المحطّة من تصميم المهندس
،الأمريكيّ ر. ب. بريجنس

286
00:16:38,850 --> 00:16:43,980
وكانت شعبيّته كبيرة لدرجة
.أنّ المبنى رُسم في لوحات أوكيو

287
00:16:53,110 --> 00:16:56,120
ما رأيك؟ ما قولك بعد أن جلت يوكوهاما؟

288
00:16:56,450 --> 00:16:59,540
.إنّها بلدة جيّدة تسمح لك بالشّعور بالعصر الجديد

289
00:16:59,540 --> 00:17:01,200
أليس كذلك؟ –
أورو؟ –

290
00:17:01,200 --> 00:17:02,370
!فهمت الأمر بالفعل

291
00:17:02,370 --> 00:17:04,660
،إن عشت هنا لثلاثة أيّام
!فأنت من مواطني يوكوهاما سلفًا

292
00:17:04,660 --> 00:17:07,960
ما رأيك أن تتخلّى عن كونك روروني
وتصير من مواطني يوكوهاما؟

293
00:17:08,460 --> 00:17:09,420
أورو؟

294
00:17:11,710 --> 00:17:14,130
!حسنًا، سأغادر الآن. إلى اللّقاء

295
00:17:18,850 --> 00:17:20,600
هل يمكنني هذا بالفعل؟

296
00:17:21,100 --> 00:17:22,730
.لا بأس

297
00:17:22,730 --> 00:17:25,480
سيكون من الصّعب العثور على
.مكان تقيم فيه في هذه السّاعة

298
00:17:30,690 --> 00:17:31,530
.تفضّل

299
00:17:31,980 --> 00:17:32,820
.شكرًا لك

300
00:17:33,860 --> 00:17:36,950
أرى أنّك تغيّر حذاءك لآخر داخليّ
.بعد دخول الغرفة

301
00:17:37,950 --> 00:17:41,410
.يبدو أنّ طولك قد نقص فجأة يا إلدر-دونو

302
00:17:41,410 --> 00:17:45,960
تتخيّل فحسب. يبدو الغربيّون أقصر
.عندما يكون هناك سقف فوق رؤوسهم

303
00:17:45,960 --> 00:17:48,380
هل الأمر هكذا إذًا؟

304
00:17:48,380 --> 00:17:49,840
.كم هذا غريب

305
00:17:49,840 --> 00:17:51,340
.سأغيّر لملابس مريحة أكثر

306
00:17:51,460 --> 00:17:53,260
!سأستعمل غرفة النّوم

307
00:18:03,850 --> 00:18:04,980
...مرحبًا

308
00:18:08,230 --> 00:18:10,110
هذه لإلدر-دونو؟

309
00:18:13,030 --> 00:18:16,280
.أظنّني سأسلّمها له فحسب

310
00:18:17,400 --> 00:18:19,910
.إلدر-دونو، وصلتك رسالة ما

311
00:18:21,080 --> 00:18:21,910
أورو؟

312
00:18:30,040 --> 00:18:32,460
.أعتذر. كنتَ فتاة

313
00:18:32,460 --> 00:18:36,880
.تتخيّل فحسب
!يتغيّر جنس الغربيّين من وقت لآخر

314
00:18:40,970 --> 00:18:43,560
.أنا آسفة. كانت كذبة

315
00:18:45,520 --> 00:18:47,180
هل لديك سبب لهذا؟

316
00:18:50,940 --> 00:18:52,270
.سأخبرك به

317
00:18:52,770 --> 00:18:54,400
.تفضّل بالدّخول

318
00:18:57,650 --> 00:18:59,280
...الدّكتور إلدر

319
00:18:59,780 --> 00:19:03,660
يخفي وجهه خلف قناع دائمًا
.وأصوله مجهولة

320
00:19:03,830 --> 00:19:07,410
،لكنّ مهاراته من أعلى مستوى
.كما أنّه طبيب متجوّل

321
00:19:07,410 --> 00:19:10,500
،يبحث عنه أفراد بارزون وأثرياء من مختلف البلدان

322
00:19:10,500 --> 00:19:12,380
.لذلك يجول كلّ العالم

323
00:19:12,380 --> 00:19:16,010
.ومن جهة أخرى، نجده يعالج الفقراء هنا وهناك

324
00:19:16,260 --> 00:19:19,470
وأنت تريد التّخلّص من الدّكتور إلدر؟

325
00:19:19,720 --> 00:19:23,010
.نعم. هذه منطقتي أنا

326
00:19:23,010 --> 00:19:26,350
إنّ من يعيقون تحرّكاتي سيصيرون جثثًا مرعبة

327
00:19:26,350 --> 00:19:29,270
.ستكون عبرة لآخرين سيحاولون اتّباع خطاه

328
00:19:29,270 --> 00:19:35,190
ولكن لأنّني يابانيّ، لن أنجو بفعلتي
.هذه إن قتلت رجلاً غربيًّا

329
00:19:35,690 --> 00:19:38,690
.فهمت. ولهذا السّبب تطلب منّا هذا

330
00:19:38,690 --> 00:19:40,150
.ليس ذلك فحسب

331
00:19:40,780 --> 00:19:46,120
لدى الدّكتور إلدر حارس خاصّ
.لن يستطيع رجالي هزيمته

332
00:19:46,620 --> 00:19:50,960
ساموراي سابق بندبة على شكل
.صليب على خدّه الأيسر

333
00:19:51,290 --> 00:19:54,000
.هذا مناسب تمامًا

334
00:19:54,000 --> 00:19:58,710
.لديّ سيّاف كان يتوق بشدّة لقتال ساموراي قويّ

335
00:20:00,010 --> 00:20:02,130
.لديّ عمل لك يا إسبيلار

336
00:20:04,300 --> 00:20:06,140
.ساموراي بندبة على شكل صليب

337
00:20:06,640 --> 00:20:08,100
.لا بدّ أنّه ذاك الرّجل

338
00:20:09,100 --> 00:20:15,020
ساموراي. عبر ذلك الاسم البحار
.ويُعرف الآن في كلّ أرجاء العالم

339
00:20:15,020 --> 00:20:19,110
.خبراء سيوف رائعون يحملون أنصال كاتانا

340
00:20:19,440 --> 00:20:23,570
ساموراي. يقتلون الأعداء الّذين يفترون عليهم

341
00:20:23,570 --> 00:20:27,990
بل وقد يقومون بقطع بطونهم
.بأنفسهم لإثبات براءتهم

342
00:20:27,990 --> 00:20:30,580
.محاربون هائجون ذوي كبرياء

343
00:20:30,830 --> 00:20:33,290
سمعتُ أنّهم اختفوا من هذا العالم

344
00:20:33,290 --> 00:20:36,210
.في ثورة ميجي قبل 10 سنوات

345
00:20:36,500 --> 00:20:42,510
لكنّي أتيتُ كلّ هذه المسافة
...لهذه الجزيرة وأملي يكاد ينعدم

346
00:20:43,340 --> 00:20:45,640
!لقتال ساموراي

347
00:20:46,470 --> 00:20:48,810
يبدو أنّ هذا السّاموراي ذو النّدبة

348
00:20:48,810 --> 00:20:52,730
كان سيّافًا مشهورًا في كيوتو
.خلال فترة باكوماتسو

349
00:20:54,060 --> 00:20:56,520
.إذًا فهو ناجٍ من فترة باكوماتسو

350
00:20:56,520 --> 00:20:58,690
.لا عجب أنّه قويّ

351
00:20:59,570 --> 00:21:01,940
.إنّه خصم كنت تتمنّى لقاءه

352
00:21:03,990 --> 00:21:06,280
...ساموراي بندبة على شكل صليب

353
00:21:07,780 --> 00:21:11,000
...الرّجل الأسطوريّ الّذي يوصف بالأقوى

354
00:21:11,870 --> 00:21:13,830
!هيتوكيري باتّوساي

355
00:22:44,920 --> 00:22:49,930
