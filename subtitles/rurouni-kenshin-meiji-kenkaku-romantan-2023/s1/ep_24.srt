1
00:00:04,720 --> 00:00:05,940
.هكذا إذًا

2
00:00:06,550 --> 00:00:10,110
.إذًا فالعقل المدبّر خلف سايتو هاجيمي هو أنت

3
00:00:10,500 --> 00:00:13,010
...المحارب الثّوريّ السّابق من ساتسوما

4
00:00:13,130 --> 00:00:15,220
...ووزير الدّاخليّة في حكومة ميجي

5
00:00:15,450 --> 00:00:17,320
.أوكوبو توشيميتشي

6
00:00:22,830 --> 00:00:26,320
لا أفهم ما الّذي يحدث؟
!لم أرَ هذا الرّجل في حياتي

7
00:00:26,450 --> 00:00:29,930
.ما كان طفل مثلك لا يقرأ الأخبار أن يعرف

8
00:00:30,700 --> 00:00:34,220
،يُعدّ إضافة لسايغو تاكاموري وكاتسورا كوغورو

9
00:00:34,220 --> 00:00:39,280
.واحدًا من ثلاثة من أعظم أبطال ثورة ميجي

10
00:00:39,750 --> 00:00:42,850
،وبما أنّه يترأّس وزارة الدّاخليّة الأقوى

11
00:00:43,150 --> 00:00:47,190
.فهو يُعتبر الرّجل الأقوى في دولة اليابان

12
00:00:47,660 --> 00:00:50,040
.آسف لأنّني لجأت لأساليب وحشيّة كهذه

13
00:00:50,830 --> 00:00:51,840
،ولكن

14
00:00:51,960 --> 00:00:55,500
.كان علينا أن نقيس قدراتك القتالية بأيّ ثمن

15
00:00:56,440 --> 00:00:58,570
هلاّ وافقت على الحديث معي؟

16
00:00:59,400 --> 00:01:02,130
.حسنًا. لا أظنّ أنّ لي خيارًا في هذه المسألة

17
00:01:04,160 --> 00:01:05,970
.صار الوضع أكثر خطورة

18
00:01:06,090 --> 00:01:09,990
ما علاقة شخصيّة بارزة مثل أوكوبو في هذه المسألة؟

19
00:01:10,120 --> 00:01:12,670
!هذا أسوء حتّى من الباتّوساي

20
00:01:16,710 --> 00:01:18,270
.شعرت بالملل

21
00:01:18,580 --> 00:01:21,260
.لنؤجّل هذا القتال لوقت آخر

22
00:01:21,440 --> 00:01:23,220
.كانت حياتك توشك أن تنتهي

23
00:01:23,420 --> 00:01:24,790
.وكذلك حياتك

24
00:01:30,090 --> 00:01:31,190
!سايتو

25
00:01:31,710 --> 00:01:33,070
.إليك تقريرًا لمهمّتي

26
00:01:33,420 --> 00:01:36,860
.لن نستفيد شيئًا من هيمورا كنشين

27
00:01:37,180 --> 00:01:41,160
.أمّا هيمورا الباتّوساي، فما زال لديه ما يقدّمه لنا

28
00:01:41,290 --> 00:01:42,280
.نهاية التّقرير

29
00:01:43,580 --> 00:01:45,700
!يا له من رجل متوحّش

30
00:01:45,820 --> 00:01:48,090
،إنّه أفضل جاسوس لدى الشّرطة

31
00:01:48,220 --> 00:01:51,770
.لكنّ ذئب ميبو سيظلّ عنيدًا مهما كان

32
00:01:52,470 --> 00:01:54,700
.تعال معنا يا هيمورا

33
00:01:54,830 --> 00:01:56,010
هل تمازحني؟

34
00:01:56,140 --> 00:01:59,190
...لستُ الوحيد الّذي تورّط

35
00:02:01,080 --> 00:02:02,030
كنشين؟

36
00:02:06,080 --> 00:02:08,400
لستُ الوحدي الّذي تورّط

37
00:02:08,860 --> 00:02:10,940
.في هذه المسألة لو سمحت

38
00:02:11,250 --> 00:02:13,660
.نستحقّ جميعًا تفسيرًا لهذا

39
00:02:14,440 --> 00:02:15,780
...عاد لأسلوبه المهذّب

40
00:02:17,660 --> 00:02:20,870
!ممتاز! عدت لسابق عهدك يا كنشين

41
00:02:20,870 --> 00:02:22,370
!أورو

42
00:02:23,380 --> 00:02:24,540
!بسرعة يا ميغومي-سان –
سيّدي أوكوبو؟ –

43
00:02:24,540 --> 00:02:26,960
ما الّذي تفعلينه أيّتها الغبيّة؟ –
.لنفعل ما يقول –

44
00:02:27,280 --> 00:02:30,270
.إنّنا بحاجة مطلقة إليه في الوقت الحاليّ

45
00:04:10,730 --> 00:04:13,600
.سأدخل في صلب الموضوع مباشرة يا هيمورا

46
00:04:14,200 --> 00:04:17,190
.يقوم شيشيو بتحرّكات في كيوتو ثانية

47
00:04:18,650 --> 00:04:22,090
ربّما عليك أن تجرّب جعل الأمر
.أبسط بالنّسبة لبقيّتنا

48
00:04:22,210 --> 00:04:23,720
من يكون شيشيو هذا؟

49
00:04:23,840 --> 00:04:25,940
!انتبه لكلامك يا هذا

50
00:04:26,070 --> 00:04:27,660
.شيشيو ماكوتو

51
00:04:28,490 --> 00:04:30,920
،تعلمون أنّي كنتُ قاتلاً من قبل

52
00:04:31,050 --> 00:04:33,120
.وانضممت للجيش الاعتياديّ بعد ذلك

53
00:04:33,240 --> 00:04:35,600
ثمّ قام محارب ثوريّ من تشوشو

54
00:04:35,910 --> 00:04:38,250
.بأخذ دور القاتل في الظّلال

55
00:04:39,000 --> 00:04:42,880
.بتعبير آخر، صار خليفة للباتّوساي

56
00:04:44,300 --> 00:04:46,560
.إنّه أمر بالغ السّرّيّة

57
00:04:46,680 --> 00:04:49,320
.لا يعرف بوجوده إلاّ قلّة من النّاس

58
00:04:50,160 --> 00:04:53,720
.حتّى أنا لم ألتق به مباشرة من قبل

59
00:04:54,450 --> 00:04:56,380
.لكنّي لا أفهم بعد

60
00:04:56,680 --> 00:05:00,190
قيل أنّه مات قبل عشر سنوات
.في حرب بوشين

61
00:05:03,870 --> 00:05:04,830
.فهمت

62
00:05:05,130 --> 00:05:07,250
.لم يمت في تلك الحرب

63
00:05:07,380 --> 00:05:09,780
.بل تمّ القضاء عليه من زملائه

64
00:05:12,220 --> 00:05:13,920
،لمنعهم من قول أيّ كلمة

65
00:05:14,040 --> 00:05:17,250
.كان علينا القضاء على كلّ رجالنا في الظّلال سرًّا

66
00:05:17,390 --> 00:05:18,780
.لدواعٍ أمنيّة

67
00:05:19,760 --> 00:05:22,280
.لم يكن هذا نادرًا وقتها

68
00:05:23,040 --> 00:05:24,640
تقنيات سيف شيشيو ماكوتو

69
00:05:24,760 --> 00:05:27,100
ورجاحة عقله كانتا متساويتين

70
00:05:27,220 --> 00:05:29,760
.للمهارات الّتي تمتلكها

71
00:05:30,290 --> 00:05:34,060
لسوء الحظّ، كان طموحه المتزايد
وتعطّشه للمجد

72
00:05:34,190 --> 00:05:36,230
.كافيان لجعله يشكّل خطرًا علينا

73
00:05:36,910 --> 00:05:39,280
كان قد وافق على القتل في الظّلال

74
00:05:39,420 --> 00:05:42,440
.لإظهار قدراته والحصول على التّقدير

75
00:05:43,180 --> 00:05:46,120
،لا يمكن الكشف عن الجرائم الّتي ارتكبها

76
00:05:46,240 --> 00:05:50,060
.لأنّها قادرة على الإطاحة بحكومة ميجي

77
00:05:50,540 --> 00:05:53,720
،لو أنّنا دخلنا هذه الحقبة وشيشيو لا يزال حيًّا

78
00:05:53,870 --> 00:05:56,810
لاستغلّ نقطة الضّعف تلك

79
00:05:57,220 --> 00:06:01,630
.لإعلاء شأنه وتحويل اليابان لخاتم في إصبعه

80
00:06:01,860 --> 00:06:06,790
إذًا فقد استغللتم فوضى
حرب بوشين للقضاء عليه؟

81
00:06:07,440 --> 00:06:09,780
.نعم. قتلناه بالفعل

82
00:06:10,330 --> 00:06:13,200
.حتّى أنّنا حرقنا جثّته

83
00:06:14,490 --> 00:06:17,960
،ولكن، رغم أنّ ألسنة اللّهب التهمت جسده

84
00:06:18,090 --> 00:06:20,260
.إلاّ أنّ شيشيو ماكوتو نجا

85
00:06:21,070 --> 00:06:25,450
لقد شكّل منذ ذلك الحين جيشًا
هائلاً من المتمرّدين

86
00:06:25,800 --> 00:06:29,380
واتّخذ كيوتو قاعدة له ليبدأ حرب انتقام

87
00:06:29,500 --> 00:06:33,700
.ستُقسّم الياباني إلى نصفين

88
00:06:35,160 --> 00:06:39,000
.تمّ القضاء على كلّ القوّات الّتي أرسلناها

89
00:06:39,470 --> 00:06:42,700
.أنت الآن هو أملنا الأخير

90
00:06:43,420 --> 00:06:45,840
،بهدف حماية شعب هذه البلاد

91
00:06:46,170 --> 00:06:49,510
.أطلب منك أن تعود إلى كيوتو يا هيمورا

92
00:06:52,460 --> 00:06:53,800
،بتعبير آخر

93
00:06:54,090 --> 00:06:58,270
أنت تطلب من كنشين أن يقتل شيشيو ماكوتو؟

94
00:06:59,660 --> 00:07:01,480
.بالضّبط

95
00:07:01,600 --> 00:07:03,810
.ستتمّ مكافأتك بسخاء

96
00:07:03,930 --> 00:07:08,610
.سنغضّ النّظر أيضًا عن كلّ انتهاكاتك للقانون

97
00:07:08,760 --> 00:07:13,200
.على سبيل المثال، تجارة تاكاني ميغومي للأفيون

98
00:07:13,450 --> 00:07:14,990
.لا بدّ وأنّكم تمازحونني

99
00:07:15,410 --> 00:07:19,250
،بدل أن أكون ورقة مساومة للتّأثير على كنشين

100
00:07:19,450 --> 00:07:22,710
.فأنا أفضّل الحكم بالموت

101
00:07:23,920 --> 00:07:28,780
.كلّ هذا بسبب طُرقكم المشبوهة

102
00:07:28,960 --> 00:07:32,040
لماذا على كنشين أن ينظّف فوضاكم الآن؟

103
00:07:32,160 --> 00:07:34,640
.ألا ترى أنّك تطلب الكثير من شخص واحد

104
00:07:34,780 --> 00:07:36,930
!لا تتدخّل في الأمر أيّها الجاهل

105
00:07:37,050 --> 00:07:39,480
!إنّ نجاة الحكومة على المحكّ هنا

106
00:07:39,600 --> 00:07:42,720
.تستحقّ الحكومة الفاسدة أن تختفي

107
00:07:43,080 --> 00:07:47,900
ولكن، لا أريد أن تضطرب حياة
.النّاس العاديّة بسبب هذا

108
00:07:48,030 --> 00:07:50,080
،بدون ازدهار الحكومة

109
00:07:50,200 --> 00:07:52,500
!لن يحظى النّاس بالسّلام أبدًا أيّها الغبيّ

110
00:07:52,630 --> 00:07:54,870
!كفاك تحدّثًا بتعجرف هكذا

111
00:07:55,070 --> 00:07:56,940
!كفاك وقاحة وإلاّ اعتقلتك

112
00:07:57,070 --> 00:07:58,290
!جرّب ذلك أيّها الأصلع

113
00:07:58,430 --> 00:08:01,290
،هذا معقّد بالنّسبة لطفل مثلي

114
00:08:02,100 --> 00:08:03,320
،ولكن على الأقلّ

115
00:08:03,450 --> 00:08:08,300
ما أفهمهم هو أنّه كان ليتمّ القضاء
.على كنشين أيضًا بنفس الطّريقة

116
00:08:08,730 --> 00:08:10,030
،لا يختلف اليوم عن الأمس

117
00:08:10,160 --> 00:08:13,510
.تلجؤون للقتل وقتما ناسبكم ذلك

118
00:08:13,960 --> 00:08:16,890
.لا أودّ أبدًا التّعامل معكم

119
00:08:18,250 --> 00:08:19,400
،يا سيّد أوكوبو

120
00:08:20,060 --> 00:08:25,020
.نفهم من هذا أنّك تريد الباتّوساي القاتل

121
00:08:25,330 --> 00:08:28,780
.ولكنّ كنشين الآن مجرّد روروني اعتزل القتل

122
00:08:29,540 --> 00:08:32,880
.سنمنعه بكلّ الوسائل من الذّهاب إلى كيوتو

123
00:08:37,550 --> 00:08:40,370
...أغبياء! إنّكم لا تدركون فداحة الـ

124
00:08:40,510 --> 00:08:42,200
اصمت يا كاواجي-كُن

125
00:08:45,620 --> 00:08:47,900
.سأمنحك أسبوعًا للتّفكير في الأمر

126
00:08:48,450 --> 00:08:50,920
سأعود إلى هنا في 14 ماي

127
00:08:51,340 --> 00:08:53,880
.للحصول على جوابك النّهائيّ

128
00:08:58,410 --> 00:08:59,530
...أوكوبو-سان

129
00:09:01,700 --> 00:09:04,940
.تركت هذه السّنوات العشر علامات عليك

130
00:09:06,190 --> 00:09:08,480
إنّ بناء هذه الحقبة الجديدة

131
00:09:08,680 --> 00:09:11,800
.يتطلّب جهدًا أكثر من وضع حدّ للحقبة السّابقة

132
00:09:12,480 --> 00:09:13,820
.هذا كلّ ما في الأمر

133
00:09:14,520 --> 00:09:16,420
.آمل أن يكون ردّك إيجابيًّا

134
00:09:25,120 --> 00:09:26,920
أوكوبو توشيميتشي؟

135
00:09:27,040 --> 00:09:30,000
!سأهرب إلى شانغهاي حيث سأكون آمنًا

136
00:09:30,170 --> 00:09:31,130
مفهوم؟

137
00:09:31,280 --> 00:09:34,460
.أعرف مكانًا أكثر أمنًا من شانغهاي

138
00:09:38,040 --> 00:09:40,300
.إنّه يُدعى الجحيم

139
00:09:42,160 --> 00:09:43,870
أنتم يا مناصري الإمبراطوريّة

140
00:09:44,010 --> 00:09:47,870
تعتقدون أنّكم الوحيدون من جلب
.الإصلاح في فترة ميجي

141
00:09:48,190 --> 00:09:50,650
،لكنّنا نحن أيضًا مناصرو الشّوغونيّة

142
00:09:50,770 --> 00:09:54,590
.كرّسنا حياتنا لذلك حتّى إن كنّا في جانب الخاسرين

143
00:09:55,130 --> 00:09:58,030
،إن كنتُ جاسوسًا تدفع له الحكومة

144
00:09:58,290 --> 00:10:01,100
فإنّ ذلك لتحقيق مهمّة الشّينسنغومي

145
00:10:01,390 --> 00:10:05,440
عن طريق معاقبة طفيليّات مثلكم
.ممّن يمتصّون دماء مجتمع ميجي

146
00:10:05,900 --> 00:10:08,180
،سواء أكان أوكوبو أو غيره

147
00:10:08,360 --> 00:10:12,490
،"فسأقتل باسم مبدأ "القتل الفوريّ للشّرّ

148
00:10:12,800 --> 00:10:15,380
.كلّ من يفسد هذه البلاد على حساب الشّعب

149
00:10:15,840 --> 00:10:18,220
!مهلاً، سمّ المبلغ الّذي تريد

150
00:10:18,700 --> 00:10:20,730
،يمكنك ترويض كلب بعظمة

151
00:10:20,920 --> 00:10:22,990
.ويمكنك شراء النّاس بالمال

152
00:10:23,210 --> 00:10:28,140
.ولكنّك لن تستطيع أبدًا شراء أو ترويض ذئب ميبو

153
00:10:35,010 --> 00:10:36,780
.يظلّ الذّئب ذئبًا

154
00:10:37,320 --> 00:10:39,740
.ويظلّ الشّينسنغومي شينسنغومي

155
00:10:40,620 --> 00:10:43,990
.وكذلك... يظلّ القاتل قاتلاً

156
00:10:46,320 --> 00:10:49,020
!أليس كذلك أيّها الباتّوساي؟

157
00:11:02,440 --> 00:11:04,410
.جيّد. إنّها نظيفة

158
00:11:04,550 --> 00:11:05,370
!أنت

159
00:11:07,160 --> 00:11:09,360
.ظننت بالفعل أنّي سأموت

160
00:11:09,490 --> 00:11:12,430
.هذا ليس الوقت المناسب للغسيل

161
00:11:12,560 --> 00:11:14,230
بماذا تنوي أن تجيبه؟

162
00:11:14,370 --> 00:11:16,950
.كفّ عن ذلك، لا أصدّقك بتاتًا

163
00:11:17,070 --> 00:11:21,450
،إنّ رجلاً مثله يدير رجال الحكومة الفاسدين ذاك

164
00:11:21,570 --> 00:11:23,560
.هو رجل لا يمكنني أن أثق به

165
00:11:24,800 --> 00:11:28,660
.إنّك تكره حكومة ميجي بشدّة يا سانو

166
00:11:28,800 --> 00:11:30,830
بالطّبع. هل في ذلك مشكلة؟

167
00:11:30,970 --> 00:11:31,920
.لا

168
00:11:32,440 --> 00:11:36,380
،إن كان السّيّد أوكوبو يتصرّف لمصلحته الخاصّة

169
00:11:37,000 --> 00:11:39,630
.لكان سايتو قد قضى عليه سلفًا

170
00:11:41,120 --> 00:11:43,180
ذلك الشّرطيّ المخادع؟

171
00:11:43,360 --> 00:11:45,180
.إنّه مجرّد كلب للحكومة

172
00:11:46,030 --> 00:11:48,230
،قبل أن يبدأ قتاله معي

173
00:11:48,400 --> 00:11:51,390
.تحدّث عن العدالة

174
00:11:51,850 --> 00:11:54,230
،إن كان مجرّد كلب بلا أيّ قناعة

175
00:11:54,430 --> 00:11:57,440
.ما كان ليأخذ ذلك في اعتباره

176
00:11:58,030 --> 00:11:59,920
،وحتّى اليوم

177
00:12:00,160 --> 00:12:01,780
يظلّ ذئب ميبو

178
00:12:02,400 --> 00:12:04,480
الّذي يكشّر عن أنيابه في الظّلال

179
00:12:04,730 --> 00:12:07,440
."باسم مبدأ "القتل الفوريّ للشّرّ

180
00:12:09,460 --> 00:12:13,250
.ومع ذلك، أنا لا أتعاطف معه أبدًا

181
00:12:13,390 --> 00:12:14,270
!بالطّبع

182
00:12:14,390 --> 00:12:15,330
!هذا واضح

183
00:12:15,450 --> 00:12:16,560
!كم أكرهه

184
00:12:20,180 --> 00:12:22,280
.بربّك يا فوجيتا-سان، هذا ليس مهذّبًا

185
00:12:22,750 --> 00:12:23,880
.المعذرة

186
00:12:24,400 --> 00:12:27,830
.أربع عطسات؟ هناك من يكرهني بالفعل

187
00:12:28,570 --> 00:12:29,530
.لا يهمّ

188
00:12:30,000 --> 00:12:33,290
.لطالما عُومل الشّينسنغومي بعداء

189
00:12:35,130 --> 00:12:39,590
والآن، ما الّذي ستفعله أيّها الباتّوساي؟

190
00:12:43,520 --> 00:12:47,200
.سأذهب لمقابلة السّيّد أوكوبو الآن

191
00:12:48,190 --> 00:12:48,990
لماذا؟

192
00:12:49,290 --> 00:12:51,370
.قال أنّه سيحضر بنفسه

193
00:12:51,510 --> 00:12:55,040
.إنّه رجل مشغول للغاية

194
00:12:55,270 --> 00:12:57,380
...لذلك –
!ها أنت ذا –

195
00:12:57,750 --> 00:12:59,250
.صباح الخير يا كِن-سان

196
00:12:59,460 --> 00:13:01,990
.ستقدّم ردّك لذلك الرّجل اليوم

197
00:13:02,200 --> 00:13:03,840
.أودّ سماعه أيضًا

198
00:13:03,960 --> 00:13:05,530
.شكرًا، هذا لطف منك

199
00:13:05,810 --> 00:13:09,070
.ولكنّي كنتُ مغادرًا الآن

200
00:13:09,980 --> 00:13:12,600
هل تعرف أين يقطن أوكوبو هذا؟

201
00:13:12,740 --> 00:13:17,340
لا، لكن قيل لي أنّه سيذهب
.إلى المجلس الأعلى في أكاساكا

202
00:13:17,460 --> 00:13:20,400
.على الأرجح أنّي سأقابله في كيويزاكا

203
00:13:20,540 --> 00:13:22,440
لماذا لا أرافقك إذًا؟

204
00:13:22,730 --> 00:13:25,600
،لا. بما أنّ حديثنا سيأخذ وقتًا على الأرجح

205
00:13:25,800 --> 00:13:27,450
.أفضّل الذّهاب وحدي

206
00:13:30,500 --> 00:13:31,620
.لا داعي للقلق

207
00:13:31,870 --> 00:13:34,910
.لن يتركك كنشين هنا ويذهب إلى كيوتو

208
00:13:35,080 --> 00:13:39,450
.نعم، لن يُقدم كنشين على القتل كما في السّابق

209
00:13:39,580 --> 00:13:42,110
.ما كنتُ لأتركه يذهب

210
00:13:44,910 --> 00:13:45,990
...كنشين

211
00:13:52,640 --> 00:13:56,230
هل ستأتي بالفعل يا هيمورا؟

212
00:13:57,650 --> 00:14:00,890
.في كلّ الأحوال، علينا دفعه للتّحرّك بأيّ ثمن

213
00:14:03,380 --> 00:14:07,080
.بدون مساعدته، فستحلّ كارثة بالبلاد

214
00:14:09,160 --> 00:14:11,210
.لا تقلق حيال البلاد

215
00:14:11,350 --> 00:14:14,330
.فإنّك ستموت ها هنا قبل كلّ شيء

216
00:14:17,910 --> 00:14:19,880
.إليك رسالة من شيشيو-سان

217
00:14:21,110 --> 00:14:25,860
".كانت فكرة جيّدة أن ترسل هيمورا الباتّوساي لقتلي"

218
00:14:26,290 --> 00:14:28,510
".لكنّ الأوان قد فات للأسف"

219
00:14:28,650 --> 00:14:32,260
".هذه البلاد لي سلفًا"

220
00:14:37,870 --> 00:14:40,270
!نحن ساموراي من عشيرة إيشيكاوا، شيمادا إيتشيرو

221
00:14:40,400 --> 00:14:44,190
!وأنا تشو تسوناهيدي! ستموت على أيدينا يا أوكوبو

222
00:14:46,930 --> 00:14:48,030
!أوكوبو

223
00:14:50,640 --> 00:14:52,160
!قُتل سلفًا

224
00:14:52,940 --> 00:14:55,220
من سبقنا إليه يا ترى؟

225
00:14:55,540 --> 00:14:59,820
.سبق وأرسلنا مطالبنا إلى الحكومة والصُّحف

226
00:15:00,380 --> 00:15:02,160
.لن يُغيّر هذا أيّ شيء

227
00:15:02,960 --> 00:15:05,580
.نحن من قتل أوكوبو

228
00:15:05,840 --> 00:15:07,300
!شيمادا

229
00:15:09,150 --> 00:15:10,690
!لا يوجد أيّ شاهد

230
00:15:10,810 --> 00:15:13,390
!نحن من قتلناه

231
00:15:18,400 --> 00:15:23,400
وقعت حادثة كيويزاكا في 14 ماي
.من السّنة 11 لفترة ميجي

232
00:15:23,790 --> 00:15:29,470
.قُتل الرّجل الأقوى في الحكومة في وضح النّهار

233
00:15:29,720 --> 00:15:34,570
نُسبت الجريمة لمجموعة من سبعة
،قتلة من إيشيكاوا

234
00:15:34,710 --> 00:15:38,770
.ولم يُذكر تورّط مجموعة شيشيو في الأمر بتاتًا

235
00:15:40,080 --> 00:15:41,410
...أوكوبو-سان

236
00:15:42,430 --> 00:15:46,250
لا أنصحك أنت أيضًا بالوقوف
.في وجه شيشيو-سان

237
00:15:53,130 --> 00:15:54,960
...شيشيو ماكوتو

238
00:15:56,960 --> 00:15:59,100
!هذه من تصرّفات شيشيو بكلّ تأكيد

239
00:15:59,550 --> 00:16:03,360
لا يظهر للعلن ويُضعف الحكومة بشكل تدريجيّ

240
00:16:03,480 --> 00:16:06,440
.إلى أن يحين يوم إعلانهم عن تمرّدهم

241
00:16:08,010 --> 00:16:09,610
!سيّدي أوكوبو

242
00:16:11,830 --> 00:16:13,070
.أستأذن

243
00:16:13,450 --> 00:16:16,000
.إنّه يامايوشي-دونو من مقاطعة فوكوشيما

244
00:16:16,570 --> 00:16:19,680
.إنّه آخر رجل تحدّث مع السّيّد أوكوبو

245
00:16:20,190 --> 00:16:22,750
،قبل مغادرة فوكوشيما هذا الصّباح

246
00:16:22,940 --> 00:16:26,580
.ذهبت لألقي عليه التّحيّة في منزله

247
00:16:28,480 --> 00:16:30,810
،بعد عشر سنوات من الإصلاح

248
00:16:31,500 --> 00:16:35,530
.لا يمكنني القول سوى أنّنا حقّقنا القليل فحسب

249
00:16:36,160 --> 00:16:37,610
.ما زال هناك الكثير لفعله

250
00:16:39,120 --> 00:16:43,520
.نحتاج لثلاثين سنة لوضع أسس راسخة للدّولة

251
00:16:44,250 --> 00:16:48,230
كانت هذه السّنوات العشر
.هي مرحلة الإنشاء الأولى

252
00:16:48,640 --> 00:16:51,080
.وستكون المرحلة التّالية مرحلة التّطوير

253
00:16:51,580 --> 00:16:54,900
.سننشئ السّياسات الّتي ستؤدّي لاستقرار بلاد

254
00:16:55,240 --> 00:16:57,700
.ستكون مرحلة حاسمة

255
00:16:58,170 --> 00:17:01,840
رغم كلّ العراقيل، آمل بكلّ تواضع

256
00:17:01,970 --> 00:17:04,150
.أن أكرّس نفسي بالكامل لهذه المهام

257
00:17:05,040 --> 00:17:09,450
،سأترك العقد الأخير لمن يخلفني
.ستكون مرحلة التّوطيد

258
00:17:09,550 --> 00:17:13,380
وسننشئ في نفس الوقت مجلس
.نوّاب لتصير حكومتنا مدنيّة

259
00:17:14,090 --> 00:17:17,680
،وستولد اليابان هكذا كدولة قوميّة

260
00:17:18,180 --> 00:17:20,720
.وستكتمل الثّورة بهذا بحقّ

261
00:17:22,430 --> 00:17:23,890
.دولة قوميّة

262
00:17:24,560 --> 00:17:25,900
.دولة للأمّة

263
00:17:26,770 --> 00:17:29,770
،دولة حيث للمواطنين الحقّ في اختيار مصيرهم

264
00:17:30,270 --> 00:17:33,280
على عكس الماضي حيث كانت السّلطات
.هي الّتي تقرّر كلّ شيء

265
00:17:34,530 --> 00:17:36,780
.إنّه مثال يبدو بعيد المنال

266
00:17:37,030 --> 00:17:39,870
.لكنّه كان مثالاً يستحقّ أن يؤمن به المرء

267
00:17:41,120 --> 00:17:43,790
.ليت السّيّد أوكوبو كان لا يزال على قيد الحياة

268
00:17:45,040 --> 00:17:46,540
!إصدار إضافيّ! إصدار إضافيّ

269
00:17:47,040 --> 00:17:49,960
!تمّ اغتيال السّيّد أوكوبو! اغتيال وزير الدّاخليّة

270
00:17:49,960 --> 00:17:52,130
!إصدار إضافيّ! إصدار إضافيّ

271
00:17:52,130 --> 00:17:56,930
وهكذا فقدنا آخر واحد من عظماء
الثّورة الثّلاثة وأحد أكبر القادة

272
00:17:57,430 --> 00:18:01,510
ولم يبقَ في الحكومة سوى الحثالة
.الّذين لا يصلحون للقيام بذلك الدّور

273
00:18:03,640 --> 00:18:07,650
ستخرج اليابان عن الطّريق المستقيم
.بكلّ تأكيد بدءًا من الآن

274
00:18:08,100 --> 00:18:11,820
.ولن يدع شيشيو هذه الفرصة تفلت منه

275
00:18:13,730 --> 00:18:17,280
.بدأ الزّمن بالتّدفّق ثانية

276
00:18:22,030 --> 00:18:24,750
.لديّ مريض في حالة عاجلة اللّيلة دون سواها

277
00:18:25,750 --> 00:18:27,500
.سأرافقها إلى المحطّة

278
00:18:27,870 --> 00:18:29,540
.حسنًا. كونا حذرين

279
00:18:34,760 --> 00:18:37,090
.تأخّر كنشين

280
00:18:39,930 --> 00:18:40,890
!كنشين

281
00:18:47,600 --> 00:18:48,640
أين ياهيكو؟

282
00:18:49,310 --> 00:18:50,770
...صحيح، إنّه

283
00:18:50,770 --> 00:18:52,820
.تعب من الانتظار وذهب للنّوم

284
00:18:53,270 --> 00:18:54,280
.هكذا إذًا

285
00:18:55,610 --> 00:18:56,530
كنشين؟

286
00:18:57,610 --> 00:18:59,990
.قُتل السّيّد أوكوبو هذا الصّباح

287
00:19:00,490 --> 00:19:02,700
.نعم. قرأت الإصدار الإضافيّ للصّحف

288
00:19:04,030 --> 00:19:06,250
.لكنّ الجاني الحقيقيّ هو شيشيو

289
00:19:08,120 --> 00:19:11,130
.لا أستطيع ترك شيشيو يتصرّف كما يحلو له

290
00:19:12,130 --> 00:19:14,590
.قرّرت الذّهاب إلى كيوتو

291
00:19:19,260 --> 00:19:22,180
هل ستقتل شيشيو ماكوتو؟

292
00:19:22,680 --> 00:19:23,510
...لا

293
00:19:24,260 --> 00:19:25,930
.لكنّي لا أعرف أيضًا

294
00:19:27,810 --> 00:19:31,600
،بعد مجيئي إلى هنا
...عشت الكثير من الأيّام الهادئة

295
00:19:32,100 --> 00:19:37,940
شعرتُ فعلاً أنّ بإمكاني أن أصير
.مجرّد سيّاف عاديّ بدل أن أكون قاتلاً

296
00:19:39,450 --> 00:19:43,200
.ولكن، أدركتُ شيئًا خلال معركتي مع سايتو

297
00:19:43,910 --> 00:19:46,490
،في أعماق قلبي

298
00:19:46,490 --> 00:19:51,120
.يكمن قاتل مجنون لن تتغيّر طُرقه أبدًا

299
00:19:52,040 --> 00:19:54,130
!لكنّك تعود من ذلك بسرعة

300
00:19:54,130 --> 00:19:56,630
،لا يهمّ كم قد تقترب من كونك الباتّوساي يا كنشين

301
00:19:56,630 --> 00:19:57,760
!ستظلّ دائمًا كنشين

302
00:19:58,090 --> 00:20:01,470
!حدث نفس الشّيء مع جين-إي ومع سايتو

303
00:20:01,970 --> 00:20:03,010
!ستكون بخير

304
00:20:03,840 --> 00:20:05,180
.كان الأمر مختلفًا

305
00:20:06,470 --> 00:20:07,810
،في حالة جين-إي

306
00:20:07,810 --> 00:20:11,810
رجعت لطبيعتي كباتّوساي لأنّي أردت بكلّ
.إخلاص أن أنقذك يا كاورو-دونو

307
00:20:11,810 --> 00:20:14,520
كنتُ قادرًا على العودة من ذلك
.بفضل صوتك أيضًا

308
00:20:14,770 --> 00:20:19,320
ولكن في حالة سايتو، رجعت
.لطبيعتي تلك فقط لأقاتل

309
00:20:20,610 --> 00:20:23,700
.حتّى صوتك لم يصل إليّ

310
00:20:24,870 --> 00:20:26,700
.يوجد اختلاف كبير هنا

311
00:20:28,950 --> 00:20:31,460
.بدأ الزّمن بالتّدفّق ثانية

312
00:20:33,040 --> 00:20:35,000
،عندما التقينا أوّل مرّة

313
00:20:35,000 --> 00:20:37,630
منعتني من المغادرة وأنت تعرفين
.أنّي الباتّوساي القاتل

314
00:20:38,130 --> 00:20:43,510
.قلتِ أنّك لا تهتمّين لماضي الآخرين

315
00:20:44,010 --> 00:20:48,470
.أسعدني ذلك كثيرًا

316
00:20:50,310 --> 00:20:59,280
"مدرسة كاميا كاشّين للكندو"

317
00:20:50,720 --> 00:20:52,980
،إن بقيت هنا لوقت أطول

318
00:20:52,980 --> 00:20:56,560
،فسأقحمكم جميعًا في الخطر في كلّ مرّة

319
00:20:56,560 --> 00:21:00,610
.وسأرجع لكوني الباتّوساي في كلّ مرّة

320
00:21:01,400 --> 00:21:04,700
،إضافة لذلك، بالنّسبة لرجال الحكومة ومجموعة شيشيو

321
00:21:04,700 --> 00:21:09,700
ولكلّ شخص آخر لديه ضغينة ضدّ
،الباتّوساي القاتل، وأشعر أنّهم كُثر

322
00:21:09,700 --> 00:21:12,830
.فلن يعتبروني أيّ شخص آخر سوى الباتّوساي

323
00:21:13,750 --> 00:21:16,580
.ما عاد يُسمح لي بالبقاء هنا أكثر من هذا

324
00:21:22,170 --> 00:21:23,510
.شكرًا على كلّ شيء

325
00:21:24,260 --> 00:21:25,090
...وأيضًا

326
00:21:26,430 --> 00:21:27,340
.الوداع

327
00:21:28,970 --> 00:21:30,470
.أنا روروني

328
00:21:31,180 --> 00:21:33,890
.وسأجول في هذه الأرض ثانية

329
00:21:48,570 --> 00:21:50,240
...كنشين

330
00:21:56,710 --> 00:21:59,880
!كنشين

331
00:22:00,960 --> 00:22:04,420
.في 14 ماي من العام 11 لفترة ميجي

332
00:22:04,800 --> 00:22:09,140
عاد هيمورا كنشين ليصير روروني

333
00:22:09,140 --> 00:22:13,560
.واختفى وحيدًا في حلكة ظلام الظّلال

334
00:22:15,230 --> 00:22:17,190
إلى أين اختفى الباتّوساي؟

335
00:22:17,690 --> 00:22:20,900
!سأخذ ذلك السّيف اليابانيّ بدل المال

336
00:22:21,520 --> 00:22:25,070
.قرّرتَ الظّهور بلا أيّ مبالاة بعد كلّ هذا الوقت

337
00:22:25,740 --> 00:22:27,570
ما الّذي تريده منّي؟

338
00:22:28,070 --> 00:22:30,280
.كان شيشيو-سان يتوقّع مجيئك

339
00:22:30,780 --> 00:22:32,410
.حسنًا، تفضّل

340
00:22:33,740 --> 00:22:38,000
إذًا أنت هو... شيشيو ماكوتو؟

341
00:22:40,210 --> 00:22:42,210
.يمكنك على الأقلّ إضافة "كُن" لاسمي

342
00:22:42,710 --> 00:22:44,630
.يا لك من سينباي فظّ