1
00:00:43,930 --> 00:00:45,600
.لا داعي للقلق

2
00:00:46,100 --> 00:00:49,980
.أنا قائد الوحدة الأولى للشّينسنغومي قبل كلّ شيء

3
00:00:49,980 --> 00:00:53,190
لكن أليست رئتاك مريضتان الآن؟

4
00:00:54,820 --> 00:00:56,820
.سيموت على يديّ

5
00:01:11,170 --> 00:01:15,170
،قائد الوحدة الثّالثة للشّينسنغومي
...سايتو هاجيمي

6
00:01:17,090 --> 00:01:17,970
...ها أنا ذا

7
00:01:17,970 --> 00:01:20,220
.أيّها الهيتوكيري باتّوساي

8
00:03:06,120 --> 00:03:07,290
!أيّها الهيتوكيري باتّوساي

9
00:03:09,710 --> 00:03:10,920
!وجدتك أخيرًا

10
00:03:11,670 --> 00:03:14,880
!ستنتهي سلسلة جرائم قتلك هنا
!جهّز نفسك

11
00:03:15,090 --> 00:03:15,920
أورو؟

12
00:03:16,050 --> 00:03:16,880
!لا تتظاهر بالغباء

13
00:03:16,880 --> 00:03:21,260
ما كان أيّ أحد آخر ليتجوّل ليلاً حاملاً سيفًا
!متجاهلاً تمامًا مرسوم منع حمل السّيف

14
00:03:29,520 --> 00:03:30,940
.هذا مؤلم

15
00:03:31,440 --> 00:03:32,650
.كان ذلك سهلاً

16
00:03:33,150 --> 00:03:35,110
أهذا هيتوكيري باتّوساي الّذي تحدّثت عنه الإشاعات؟

17
00:03:35,730 --> 00:03:36,940
.روروني

18
00:03:38,610 --> 00:03:40,650
،أنا مجرّد روروني

19
00:03:40,650 --> 00:03:43,360
.سيّاف عابر سبيل في رحلة بدون وجهة لا غير

20
00:03:43,610 --> 00:03:45,740
.وصلت إلى هذه البلدة حديثًا

21
00:03:45,740 --> 00:03:48,240
—قلتِ "سلسلة جرائم قتل"، لكن لا فكرة لي

22
00:03:48,240 --> 00:03:50,080
إذًا ما هذا الّذي تحمله حول خصرك؟

23
00:03:50,080 --> 00:03:53,460
!لا يُسمح لك بحمل السّيف حتّى إن كنتَ سيّافًا

24
00:03:58,670 --> 00:03:59,760
ما هذا؟

25
00:04:00,340 --> 00:04:01,510
ساكاباتو؟

26
00:04:02,010 --> 00:04:04,800
هل يمكن قتل شخص ما بهذا السّيف؟

27
00:04:05,850 --> 00:04:07,010
.لا يمكن

28
00:04:07,930 --> 00:04:11,180
قبل كلّ شيء، لا توجد أيّ ثلوم
،على هذا النّصل المعكوس

29
00:04:11,180 --> 00:04:13,690
.ولا حتّى أيّ رائحة للدّم أو تغييمٍ من الزّيت

30
00:04:13,690 --> 00:04:15,690
.وكأنّه لا يزال جديدًا

31
00:04:16,770 --> 00:04:18,940
...إنّك بالفعل مجرّد

32
00:04:19,480 --> 00:04:21,110
.روروني كما قلت لك

33
00:04:21,110 --> 00:04:23,860
لكن لماذا تحمل سيفًا لا فائدة منه كهذا؟

34
00:04:25,490 --> 00:04:26,320
!الشّرطة

35
00:04:26,530 --> 00:04:27,910
!إنّه هو الآن بكلّ تأكيد

36
00:04:32,330 --> 00:04:35,750
.يبدو أنّ هنالك شيئًا ما يحدث

37
00:04:37,840 --> 00:04:38,790
!ضعفاء

38
00:04:38,920 --> 00:04:41,630
!ضعفاء، ضعفاء، ضعفاء

39
00:04:41,920 --> 00:04:43,840
!جميعكم ضعفاء

40
00:04:44,010 --> 00:04:46,050
!إ-إنّه قويّ جدًّا

41
00:04:46,550 --> 00:04:48,050
...إنّ هذه القوّة هي قوّة

42
00:04:48,390 --> 00:04:51,520
!الباتّوساي المشاع عنه بكلّ تأكيد

43
00:04:52,850 --> 00:04:54,940
!توقّف مكانك أيّها الباتّوساي

44
00:05:00,900 --> 00:05:01,730
—كلاّ

45
00:05:09,410 --> 00:05:11,450
.إنّكِ بالفعل شخص متهوّر

46
00:05:11,450 --> 00:05:12,290
.الرّوروني

47
00:05:18,330 --> 00:05:20,960
!هنا! قاطع الطّريق هنا

48
00:05:23,050 --> 00:05:24,510
!أنا هو الباتّوساي

49
00:05:25,050 --> 00:05:28,140
،هيمورا باتّوساي من كاميا كاشّين-ريو

50
00:05:28,140 --> 00:05:31,260
!والمعروف بهيتوكيري باتّوساي

51
00:05:31,390 --> 00:05:32,220
!تمهّل

52
00:05:33,270 --> 00:05:36,100
!مهلاً، ما الّذي تفعله؟ ضعني أرضًا

53
00:05:36,100 --> 00:05:38,770
قد تكون المطاردة لفترة طويلة
.أثناء الإصابة قاتلة بحدّ ذاتها

54
00:05:39,150 --> 00:05:41,480
سبق وادّعى أنّه سيّاف يستعمل
،أسلوب سيف معيّن

55
00:05:41,480 --> 00:05:42,320
—لذلك لا تقلقي

56
00:05:42,320 --> 00:05:44,740
!كاميا كاشّين-ريو هو أسلوب سيفنا

57
00:05:45,030 --> 00:05:48,070
إنّه يستعمل اسمنا لاقتراف
!جرائم قتل على مفترقات الطّرق

58
00:05:48,990 --> 00:05:49,950
!ضعني أرضًا

59
00:05:50,240 --> 00:05:51,990
—سأذهب للإمساك به في الحال

60
00:05:51,990 --> 00:05:54,160
.لن تلحقي به إن ذهبتِ خلفه الآن

61
00:05:54,410 --> 00:05:57,830
علينا المغادرة قبل أن تأتي الشّرطة
.للتّحقيق في أمرنا لو سحمت

62
00:05:57,830 --> 00:05:59,670
!ضعني أرضًا

63
00:06:05,340 --> 00:06:07,510
...كاميا كاشّين-ريو

64
00:06:10,090 --> 00:06:12,600
.المعلّم الحاليّ، كاميا كاورو

65
00:06:13,060 --> 00:06:14,350
...التّلاميذ

66
00:06:15,350 --> 00:06:16,180
أورو؟

67
00:06:16,810 --> 00:06:19,230
.كنّا أسلوب سيف صغير للغاية من الأساس

68
00:06:19,810 --> 00:06:24,440
لكن كان لدينا حوالي عشرة تلاميذ
.وكنّا نعمل معًا بجدّ

69
00:06:25,070 --> 00:06:29,280
لكن بدأ ذلك الشّخص باقتراف جرائم قتل
،على مفترقات الطّرق فجأة قبل شهرين

70
00:06:29,280 --> 00:06:30,570
.وانظر كيف صار حالنا

71
00:06:31,530 --> 00:06:34,870
غادر كلّ التّلاميذ مخافة من لقب
،الباتّوساي"، أي ساحب السّيف"

72
00:06:34,870 --> 00:06:38,290
.ولا أحد في البلدة يودّ حتّى الاقتراب من الدّوجو

73
00:06:39,000 --> 00:06:42,500
حتّى في فترة ميجي، فإنّ الهيتوكيري باتّوساي

74
00:06:42,500 --> 00:06:44,210
.ما زال يزرع الخوف في قلوب النّاس

75
00:06:45,460 --> 00:06:47,720
لماذا يدّعي أنّه من كاميا كاشّين-ريو؟

76
00:06:48,220 --> 00:06:51,340
هل هو الباتّوساي بالفعل؟
.لا فكرة لديّ

77
00:06:51,840 --> 00:06:55,350
.لكن عليّ إنهاء وحشيّته في أقرب وقت

78
00:06:56,770 --> 00:06:57,770
.مفهوم

79
00:06:58,890 --> 00:07:02,560
لكن من الأفضل ألاّ تتجوّلي
.في الأرجاء ليلاً بعد الآن رجاءً

80
00:07:02,690 --> 00:07:03,520
ماذا؟

81
00:07:03,520 --> 00:07:06,440
.إنّ ذلك الرّجل أقوى منك بكثير يا كاورو-دونو

82
00:07:06,440 --> 00:07:07,280
ماذا؟

83
00:07:07,280 --> 00:07:11,570
إنّ الاعتراف بأنّ الآخرين أقوى منك
.هو جزء من كون المرء سيّافًا

84
00:07:12,070 --> 00:07:15,410
يجدر أن يكون واضحًا أين ستنتهي
تلويحتك التّالية بالسّيف؟

85
00:07:16,370 --> 00:07:18,040
فخر أسلوب السّيف

86
00:07:18,040 --> 00:07:20,960
ليس مهمًّا بما يكفي للمخاطرة
.بحياتك لحمايته لو سمحت

87
00:07:24,040 --> 00:07:25,790
...إنّ كاميا كاشّين-ريو

88
00:07:27,250 --> 00:07:31,970
إنّ كاميا كاشّين-ريو هو أسلوب سيف
أنشأه أبي في فترة ميجي

89
00:07:31,970 --> 00:07:34,430
.بعد النّجاة من اضطرابات فترة باكوماتسو

90
00:07:35,260 --> 00:07:37,720
.لم يوافق أبي على السّيوف القاتلة

91
00:07:37,720 --> 00:07:40,310
،وبطموح من أجل سيف يمنح الحياة

92
00:07:40,310 --> 00:07:43,100
.كرّس كلّ شيء يملكه لعشر سنوات لهذا الأسلوب

93
00:07:44,020 --> 00:07:45,690
لكن حتّى هو تمّ إرساله

94
00:07:45,690 --> 00:07:51,320
للمشاركة في حرب سينان كجزء
،من فرقة سيّافي شرطة المدينة

95
00:07:51,320 --> 00:07:56,370
،وفي مكان بعيد جدًّا عن مُثله الخاصّة
.غادر هذا العالم

96
00:07:57,330 --> 00:08:02,540
يستعلم ذلك الرّجل الّذي يدّعي
أنّه هيتوكيري باتّوساي اسم كاميا كاشّين-ريو

97
00:08:02,540 --> 00:08:05,210
.وتسبّب سلفًا في أزيد من عشرة إصابات وضحايا

98
00:08:06,290 --> 00:08:11,300
،يعتبر كاميا كاشّين-ريو، أسلوب أبي المتوارث
.السّيف المانح للحياة مثالاً يحتذى به

99
00:08:11,300 --> 00:08:13,340
!لكنّ سمعته تلطّخت بسبب سيف قاتل

100
00:08:14,050 --> 00:08:15,720
!أنت مجرّد روروني

101
00:08:15,720 --> 00:08:18,060
!ما كنت لتفهم الإحباط الّذي أشعر به

102
00:08:25,560 --> 00:08:28,070
،ولكن بتلك الذّراع وفي كلّ الأحوال

103
00:08:28,070 --> 00:08:30,280
.لا يمكنك القيام بدوريّاتك ليلاً مع كلّ احترامي

104
00:08:31,280 --> 00:08:33,570
.من الأفضل لو تبقين آمنة هنا

105
00:08:34,240 --> 00:08:37,620
وقبل كلّ شيء، عجز شخص يسعى
خلف سيف مانح للحياة

106
00:08:37,620 --> 00:08:41,370
.عن عيش حياته الخاصّة ليس مزحة رجاءً

107
00:08:42,410 --> 00:08:46,580
إضافة لذلك، ما كان والدك المتوفّى
أن يرغب في رؤية أسلوب سيفه

108
00:08:46,580 --> 00:08:51,670
.يتمّ حمايته على حساب حياة ابنته

109
00:08:52,880 --> 00:08:53,720
.المعذرة

110
00:08:56,340 --> 00:08:58,510
.انتهيت من كلّ شيء

111
00:08:58,510 --> 00:09:00,100
.شكرًا لك يا كيهي

112
00:09:00,560 --> 00:09:04,230
.كاورو-سان، لا يجدر بك مصارحة شخص مثله

113
00:09:04,730 --> 00:09:08,310
.إنّ الرّوروني مجرّد فاشلين في الحياة

114
00:09:08,900 --> 00:09:09,770
.نعم

115
00:09:09,770 --> 00:09:13,150
.إنّك لطيفة جدًّا لملاحظة هذا

116
00:09:14,780 --> 00:09:15,610
.أعلم

117
00:09:19,120 --> 00:09:20,410
.أعلم ذلك

118
00:09:30,000 --> 00:09:31,170
!كفاك مقاومة يا هذا

119
00:09:31,170 --> 00:09:32,050
!أحسن التّصرّف

120
00:09:32,300 --> 00:09:34,170
ماذا؟ هل أمسكوا بأحد ما؟

121
00:09:38,390 --> 00:09:39,850
...أورورو

122
00:09:40,300 --> 00:09:41,350
!الرّوروني

123
00:09:41,850 --> 00:09:43,810
ما الّذي اقترفه هذا الرّجل؟

124
00:09:44,560 --> 00:09:47,480
!إنّه يعارض مرسوم منع حمل السّيف كما ترين

125
00:09:47,480 --> 00:09:49,520
...إن أسعفتني الذّاكرة، فأنت

126
00:09:49,770 --> 00:09:52,020
—مِن دوجو الهيتوكيري باتّوساي

127
00:09:52,020 --> 00:09:54,150
!أخبرتكم أنّها اتّهامات باطلة

128
00:09:54,150 --> 00:09:56,490
كيف تجرئين على محاولة مواجهة ضابط؟

129
00:09:56,490 --> 00:09:58,610
!لا تتصرّف بتعالٍ سواء كنت ضابطًا أم لا

130
00:09:58,610 --> 00:09:59,110
ماذا؟

131
00:09:59,110 --> 00:10:01,830
.مهلاً، مهلاً. لا داعي لهذا الغضب رجاءً

132
00:10:01,830 --> 00:10:04,370
.لنحلّ هذه المسألة بهدوء

133
00:10:06,620 --> 00:10:07,460
.هيّا بنا

134
00:10:09,460 --> 00:10:11,670
.سنغضّ الطّرف عنه بسبب احترامنا للعجوز

135
00:10:12,130 --> 00:10:13,550
.لن ينجو بفعلته في المرّة القادمة

136
00:10:16,670 --> 00:10:18,720
.شكرًا لك، فقد نجوت بحياتي بفضلك

137
00:10:18,840 --> 00:10:20,720
.على الرّحب والسّعة

138
00:10:20,720 --> 00:10:24,060
أما زلت في هذه البلدة؟

139
00:10:24,060 --> 00:10:25,770
هل لديك شأن ما هنا؟

140
00:10:25,930 --> 00:10:27,310
.لا، ليس تمامًا

141
00:10:28,440 --> 00:10:32,110
ماذا حدث في قضيّة قاتل مفترقات الطّرق ذاك؟

142
00:10:32,110 --> 00:10:35,480
.صحيح، لديّ دلائل عمّن قد يكون الجاني

143
00:10:35,940 --> 00:10:38,570
.هناك دوجو مسايفة آخر في البلدة المجاورة

144
00:10:38,570 --> 00:10:39,410
فعلاً؟

145
00:10:39,610 --> 00:10:41,910
.بل وإنّه دوجو مشهور أيضًا

146
00:10:41,910 --> 00:10:44,870
.صار الآن مرتعًا للمقامرين والعصابات

147
00:10:45,120 --> 00:10:49,330
ويبدو أنّ سيّافَ ساموراي سابق
.استولى عليه قبل شهرين

148
00:10:49,830 --> 00:10:54,130
قيل أنّ ذلك الشّخص ضخم
.ويبلغ طوله حوالي المترين

149
00:10:54,340 --> 00:10:56,170
أرأيت؟ ألا يبدو ذلك مريبًا؟

150
00:10:56,170 --> 00:10:58,800
بدأت جرائم قتل مفترقات الطّرق
.قبل شهرين أيضًا

151
00:10:59,010 --> 00:11:00,970
.بواسطة سيّاف ماهر بنفس الطّول

152
00:11:01,220 --> 00:11:03,720
!الأشخاص الضّخام من أمثاله ليسوا شائعين

153
00:11:03,720 --> 00:11:08,390
،عليّ تحضير العشاء يا كاورو-سان
.لذلك سأغادر الآن

154
00:11:08,390 --> 00:11:10,440
.حسنًا، شكرًا لك

155
00:11:10,440 --> 00:11:11,270
.إلى اللّقاء

156
00:11:14,520 --> 00:11:16,530
ما قرابتك بذلك الرّجل؟

157
00:11:16,530 --> 00:11:20,030
.كيهي؟ إنّه أشبه بخادم يعيش معي

158
00:11:20,400 --> 00:11:22,490
.حدث ذلك بعد وفاة أبي مباشرة

159
00:11:22,870 --> 00:11:26,540
وجدته ملقًى في الشّارع أمام الدّوجو
.واعتنيت به حتّى استعاد عافيته

160
00:11:26,990 --> 00:11:28,870
إنّه يقلق كثيرًا عليّ

161
00:11:28,870 --> 00:11:32,040
.ويخبرني أنّ عليّ بيع الدّوجو وأعيش بسلام

162
00:11:32,040 --> 00:11:33,080
أتعرفين ماضيه؟

163
00:11:33,080 --> 00:11:34,630
.لا، لأنّني لم أسأله أبدًا

164
00:11:34,630 --> 00:11:36,500
.إنّ بالك هانئ بالفعل

165
00:11:36,500 --> 00:11:37,590
أتظنّ ذلك؟

166
00:11:38,510 --> 00:11:39,340
.لا بأس

167
00:11:39,840 --> 00:11:42,760
ليس من المفاجئ أن يكون للمرء قصصًا من ماضيه

168
00:11:42,760 --> 00:11:44,550
.لا يريد إطلاعها لأيّ أحد آخر

169
00:11:44,760 --> 00:11:46,680
يمكنني قول نفس الشّيء عنك، صحيح؟

170
00:11:46,680 --> 00:11:48,220
ألست روروني لهذا السّبب؟

171
00:11:53,230 --> 00:11:54,980
.إنّك محقّة تمامًا

172
00:11:55,310 --> 00:11:58,400
أخبرني أيّها الرّوروني، ليس لديك
مال كافٍ للمبيت في نزل، صحيح؟

173
00:11:58,400 --> 00:11:59,990
لماذا لا تبيت في منزلنا إذًا؟

174
00:11:59,990 --> 00:12:03,490
،لديّ أعمال أقوم بها
.لذلك سأعود في يوم لاحق

175
00:12:04,820 --> 00:12:05,700
.انتظر

176
00:12:06,700 --> 00:12:07,830
أهنالك شيء آخر؟

177
00:12:08,790 --> 00:12:09,750
...عفوًا

178
00:12:10,250 --> 00:12:12,790
...في ذلك اليوم

179
00:12:13,250 --> 00:12:15,540
،لم تتسنّى لي فرصة شكرك على مساعدتي

180
00:12:15,540 --> 00:12:18,250
...كما أنّي وصفتك بمجرّد روروني

181
00:12:19,000 --> 00:12:19,840
...لذلك

182
00:12:21,510 --> 00:12:22,630
.أنا آسفة

183
00:12:23,220 --> 00:12:24,840
هل أنت مصابة بحمّى أو ما شابه؟

184
00:12:25,340 --> 00:12:27,810
!أنا أحاول جاهدة الاعتذار لك

185
00:12:27,810 --> 00:12:29,680
.لم أتوقّع أنّ هذا ما كنت تفعلينه

186
00:12:30,640 --> 00:12:33,940
.لا يهتمّ الرّوروني بمثل هذه الأمور الطّفيفة

187
00:12:34,230 --> 00:12:37,270
لا يجدر بك أن تقلقي حيالها أيضًا
.يا كاورو-دونو لو سمحت

188
00:12:40,530 --> 00:12:43,530
بالتّفكير في الأمر، ما هذه الأعمال الّتي سيقوم بها؟

189
00:12:45,490 --> 00:12:47,740
.دوجو في بلدة مجاورة

190
00:12:48,950 --> 00:12:52,660
لا عجب أنّي لم أستطع إيجادهم
.عندما بحثت في هذه البلدة

191
00:12:55,330 --> 00:12:57,840
!المعذرة! المعذرة

192
00:12:58,000 --> 00:13:00,590
!المعذرة! المعذرة! المعذرة
—المعذرة! المعذ

193
00:13:00,590 --> 00:13:02,970
اخرس! من تكون يا هذا؟

194
00:13:02,970 --> 00:13:04,470
—قائد هذا المكان

195
00:13:04,470 --> 00:13:07,600
!هيروما-سينسي ليس هنا الآن
!عد في وقت لاحق

196
00:13:08,010 --> 00:13:11,310
!فعلاً! اسمه هيروما إذًا من بعد إذنك

197
00:13:11,310 --> 00:13:13,810
أتيت إلى هنا دون معرفة ذلك أيّها الشّقيّ؟

198
00:13:13,810 --> 00:13:16,020
...لا، كنتُ مقتنعًا تمامًا

199
00:13:16,810 --> 00:13:19,480
.أنّ اسمه قاتل مفترقات الطّرق الباتّوساي

200
00:13:21,480 --> 00:13:24,650
.يبدو أنّ كاورو-دونو كانت محقّة بشأن هذا المكان

201
00:13:24,950 --> 00:13:26,570
ما الخطب يا نيشيواكي-سان؟

202
00:13:27,490 --> 00:13:29,620
من ذلك القصير؟

203
00:13:29,620 --> 00:13:32,330
.ماذا؟ إنّه مجرّد جرذ

204
00:13:34,040 --> 00:13:35,790
.تولّوا أمره

205
00:13:37,500 --> 00:13:39,420
.كلاّ. انكسر وحده

206
00:13:40,920 --> 00:13:42,090
.كاورو-سان

207
00:13:42,670 --> 00:13:43,800
!هذا أنت يا كيهي

208
00:13:44,510 --> 00:13:45,880
ما الأمر؟

209
00:13:45,880 --> 00:13:48,390
...حسنًا، بخصوص هذه الأرض والمبنى

210
00:13:49,550 --> 00:13:52,470
.سبق وأخبرتك أنّي لا أنوي إغلاق الدّوجو

211
00:13:52,470 --> 00:13:54,350
...ولكن كما هو بادٍ لك

212
00:13:55,100 --> 00:13:57,560
.تمّت كلّ المعاملات الورقيّة بالفعل

213
00:13:58,480 --> 00:13:59,650
كيهي؟

214
00:13:59,650 --> 00:14:02,400
.وكلّ ما نحتاجه هو ختمك فحسب

215
00:14:03,030 --> 00:14:07,110
!وستصير هذه الأرض وما عليها ملكًا لنا هكذا

216
00:14:09,530 --> 00:14:10,450
!مرحبًا

217
00:14:11,580 --> 00:14:12,410
...أنت

218
00:14:13,080 --> 00:14:14,910
.هيروما غوهي

219
00:14:14,910 --> 00:14:16,870
.إنّه أخي الصّغير

220
00:14:19,210 --> 00:14:23,460
،إنّ شعاري هو إن كنت ستقوم بأمر ما
.قم به بشكل شرعيّ

221
00:14:23,460 --> 00:14:27,760
،ولكن بما أنّك اكتشفت هويّة أخي الصّغير
.لم أستطع مواصلة قول ذلك

222
00:14:28,050 --> 00:14:32,600
مرّ لعب دور عجوز طيّب لاكتساب
.ثقتك كما خطّطت له

223
00:14:32,600 --> 00:14:37,140
إنّك ساذجة في أمور عدّة، ولكنّك
.عنيدة عندما يتعلّق الأمر بالمسايفة

224
00:14:37,310 --> 00:14:41,020
طلبت من أخي التّسبّب بفوضى
جرائم القتل في مفترقات الطّرق

225
00:14:41,020 --> 00:14:43,230
.لتشويه اسم أسلوب سيفك

226
00:14:43,230 --> 00:14:46,900
كما أنّ استعمال اسم هيتوكيري
،باتّوساي أفادنا كثيرًا أيضًا

227
00:14:46,900 --> 00:14:50,820
رغم حقيقةِ أنّه قاتل أسطوريّ
.وجوده مشكوك في أمره من الأساس

228
00:14:50,950 --> 00:14:54,410
وصلنا لهذه المرحلة في شهرين
.فحسب بفضل ذلك

229
00:14:54,910 --> 00:14:59,710
ستتضاعف قيمة الأراضي هنا بخمسة
.أو ستّة أضعاف بفضل سياسة التّغريب

230
00:14:59,710 --> 00:15:02,710
.وهذا لا يناسب أبدًا وجود دوجو مسايفة هنا

231
00:15:03,170 --> 00:15:04,000
...كيهي

232
00:15:04,500 --> 00:15:06,920
.سمعت بالأمر من أخي

233
00:15:06,920 --> 00:15:11,050
مسعاك هو سيف مانح للحياة؟

234
00:15:11,050 --> 00:15:12,140
.كم هذا ممتع

235
00:15:12,140 --> 00:15:15,220
لماذا لا تحاولين إنقاذ حياتك به أوّلاً؟

236
00:15:18,980 --> 00:15:23,310
كما توقّعت، سيف فتاة صغيرة
.تتحدّث في نومها لن ينفع ضدّي

237
00:15:29,240 --> 00:15:32,490
!وُجدت من أجل العنف والقتل حتّى جوهرها

238
00:15:32,490 --> 00:15:34,910
!هذه هي طبيعة المسايفة الحقيقيّة

239
00:15:35,490 --> 00:15:36,580
.هذا مؤلم

240
00:15:36,580 --> 00:15:39,410
.وها قد صارت هذه الأرض والمبنى ملكنا

241
00:15:40,290 --> 00:15:43,210
.انتهى أمر الأسلوب المسمّى كاميا كاشّين-ريو

242
00:15:45,670 --> 00:15:47,130
ما الخطب يا نيشيواكي؟

243
00:15:48,710 --> 00:15:51,050
.إ-إنّه قويّ

244
00:15:53,590 --> 00:15:55,350
!ا-الرّوروني

245
00:15:55,850 --> 00:15:57,310
.آسف على التّأخّر

246
00:15:57,810 --> 00:15:59,600
.سمعت القصّة بأكملها

247
00:16:00,560 --> 00:16:02,230
أنت ثانية؟

248
00:16:02,560 --> 00:16:08,030
هل تثرثر حيال السّيوف المانحة
للحياة كما تفعل هذه الفتاة؟

249
00:16:08,030 --> 00:16:08,900
.لا

250
00:16:10,030 --> 00:16:11,740
.السّيوف أسلحة

251
00:16:11,740 --> 00:16:13,570
.المسايفة وسيلة للقتل

252
00:16:14,070 --> 00:16:18,950
لا يهمّ كم ستحاول تلطيف ذلك
.أو تبنّي مُثل عليا، فستظلّ تلك الحقيقة

253
00:16:21,790 --> 00:16:23,870
تقول كاورو-دونو كذبة لطيفة وساذجة

254
00:16:23,870 --> 00:16:29,130
لا يقولها سوى أولئك الّذين
.لم يُلطّخوا أيديهم بالدّماء أبدًا

255
00:16:29,800 --> 00:16:30,630
.أيّها الرّوروني

256
00:16:31,550 --> 00:16:34,760
...ولكن في مواجهة حقيقة فظيعة كهذه

257
00:16:36,140 --> 00:16:40,100
.أفضّل كذبة كاورو-دونو السّاذجة أكثر

258
00:16:41,310 --> 00:16:46,810
.أتمنّى لو تصير كذبتها هي حقيقة هذا العالم

259
00:16:47,480 --> 00:16:51,780
يا أخي، لا تمانع إن قتلتُ هذا الرّجل، صحيح؟

260
00:16:51,780 --> 00:16:54,820
.صحيح. يمكنك تعذيبه حتّى الموت

261
00:16:55,070 --> 00:16:56,370
!يا رجال

262
00:16:56,370 --> 00:16:57,200
!نعم

263
00:16:57,200 --> 00:16:58,530
!أهرب أيّها الرّوروني

264
00:16:58,830 --> 00:17:01,330
.لا أريد زيادة أعداد المصابين بشكل متهوّر

265
00:17:01,910 --> 00:17:05,880
،إن كنتم لا تريدون زيارة طبيب
.فالزموا الصّمت وتراجعوا رجاءً

266
00:17:05,880 --> 00:17:07,790
!لن يصاب أيّ أحد هنا

267
00:17:07,790 --> 00:17:10,210
!الإصابة الوحيدة هنا هي الّتي ستؤدّي لموتك

268
00:17:15,380 --> 00:17:18,850
مستحيل! بتلويحة واحدة، أطاح
!بأربعة أو خمسة دفعة واحدة

269
00:17:18,850 --> 00:17:20,810
هل يستعمل شعوذة ما؟

270
00:17:20,970 --> 00:17:24,520
...كلاّ، هذه ليست شعوذة. إنّها

271
00:17:25,440 --> 00:17:26,730
!السّرعة

272
00:17:26,730 --> 00:17:33,070
سرعة السّيف وسرعة الوضعيّات
.وسرعة قراءة حركات الخصم

273
00:17:33,440 --> 00:17:36,160
إنّه يستفيد من كلّ أنواع السّرعة بالكامل

274
00:17:36,160 --> 00:17:40,990
للإطاحة بعدّة خصوم بأقلّ قدر
!من الحركة في وقت واحد

275
00:17:42,080 --> 00:17:44,210
.نسيت ذكر أمر واحد

276
00:17:44,750 --> 00:17:48,920
سيف هيتوكيري باتّوساي
.ليس من أسلوب كاميا كاشّين-ريو

277
00:17:49,210 --> 00:17:52,670
إنّه من فنّ مسايفة قديم تتجذّر
.أصوله عميقًا في فترة سنغوكو

278
00:17:53,210 --> 00:17:55,880
.اسم أسلوب السّيف ذاك هو هيتن ميتسوروغي-ريو

279
00:17:56,760 --> 00:17:59,140
إنّه يتفوّق في مواجهات واحد
.ضدّ عدّة خصوم

280
00:17:59,680 --> 00:18:01,760
،لو لم أكن أملك سيفًا كهذا

281
00:18:01,760 --> 00:18:03,770
.لكان قاتلاً بكلّ تأكيد

282
00:18:04,270 --> 00:18:07,100
.إنّه سيف قاتل بسرعة إلهيّة

283
00:18:07,310 --> 00:18:10,230
—مستحيل. إذًا فأنت هو الهيتوكيري با

284
00:18:10,980 --> 00:18:15,280
،هذا ممتع! لم أواجهك ذلك اليوم

285
00:18:15,280 --> 00:18:17,700
!لكنّي لم أظنّ أنّك بهذه القوّة

286
00:18:18,740 --> 00:18:21,450
!كنت تكبح نفسك في مواجهتي

287
00:18:21,950 --> 00:18:25,960
.لا أحبّ التّصرّف بعنف كثيرًا على عكسك أنت

288
00:18:26,290 --> 00:18:30,290
.لكنّي الآن أفكّر أنّه كان عليّ الإطاحة بك وقتها

289
00:18:30,540 --> 00:18:32,250
ما كلّ هذه الثّقة؟

290
00:18:32,630 --> 00:18:35,130
!لكنّ هذا هو ما يصفه النّاس بالغرور

291
00:18:35,460 --> 00:18:38,470
!لا يحتاج هذا العالم لاثنين من الباتّوساي

292
00:18:41,470 --> 00:18:42,600
.أنا هنا

293
00:18:51,650 --> 00:18:54,440
."لستُ نادمًا ولا متعلّقًا بلقب "باتّوساي

294
00:18:54,940 --> 00:18:58,650
.ورغم ذلك، لا أستطيع تسليمه لشخص مثلك

295
00:19:00,780 --> 00:19:04,660
،كنتَ العقل المدبّر لهذا
.لذلك لن تنجو بسهولة

296
00:19:13,750 --> 00:19:14,960
.يا إلهي

297
00:19:15,920 --> 00:19:17,800
،كلّما زادت مكائد المرء

298
00:19:18,170 --> 00:19:20,510
.أثبت ذلك أكثر ما مدى طبيعته الجبانة

299
00:19:22,760 --> 00:19:25,100
.أنا آسف يا كاورو-دونو

300
00:19:25,640 --> 00:19:28,980
.لم أكن أنوي خداعك أو إخفاء أيّ شيء عنك

301
00:19:29,600 --> 00:19:34,440
،لكن لو أمكنك هذا
.أتمنّى ألاّ نتحدّث عن هذا الأمر

302
00:19:35,650 --> 00:19:37,610
.المعذرة. الوداع

303
00:19:38,860 --> 00:19:41,110
!مـ-مهلاً لحظة

304
00:19:41,410 --> 00:19:44,870
أتتوقّع منّي إحياء أسلوب السّيف
وإدارة الدّوجو وحدي؟

305
00:19:44,870 --> 00:19:47,500
!يمكنك على الأقلّ تقديم بعض المساعدة

306
00:19:47,660 --> 00:19:50,750
!أنا لا أهتمّ كثيرًا لماضي الآخرين

307
00:19:52,000 --> 00:19:53,500
.لا أنصحك بهذا

308
00:19:54,000 --> 00:19:56,300
.هذه فرصتك لتبرئة اسمك

309
00:19:56,420 --> 00:20:00,260
،إن ظلّ الباتّوساي الحقيقيّ هنا
.فسيضيع كلّ شيء سدى

310
00:20:00,260 --> 00:20:02,680
.لا أقول أنّي أريد من الباتّوساي البقاء هنا معي

311
00:20:02,680 --> 00:20:04,550
—أريدك أنت أيّها الرّوروني أن تظلّ

312
00:20:05,760 --> 00:20:09,230
!لا-لا بأس! اذهب إن كان هذا ما تريده

313
00:20:09,930 --> 00:20:13,940
ولكن يمكنك إطلاعي على اسمك
.قبل ذهابك على الأقلّ

314
00:20:14,400 --> 00:20:17,320
الباتّوساي هو اسم المحارب
القديم خاصّتك، صحيح؟

315
00:20:18,400 --> 00:20:22,610
أم أنّك لا تريد حتّى أن تخبرني باسمك الحقيقيّ؟

316
00:20:29,120 --> 00:20:30,080
.كنشين

317
00:20:32,250 --> 00:20:33,580
.هيمورا كنشين

318
00:20:34,630 --> 00:20:37,090
.ذاك هو اسمي الحاليّ

319
00:20:38,170 --> 00:20:40,800
.أنا متعب قليلاً من التّرحال

320
00:20:41,130 --> 00:20:44,760
وبصفتي روروني، لا أعرف متى
.سأرتحل لوجهتي التّالية

321
00:20:45,260 --> 00:20:46,640
...ولكن إن لم تمانعي

322
00:20:47,140 --> 00:20:49,470
.فسأظلّ هنا في الوقت الحاليّ

323
00:20:52,730 --> 00:20:54,440
...بداية القصّة البطوليّة

324
00:20:54,940 --> 00:20:58,270
كانت في السّنة الحادية عشر من
.فترة ميجي في وسط مدينة طوكيو

325
00:20:58,770 --> 00:21:02,400
.وبدأت بوصول الرّوروني هيمورا كنشين

326
00:21:04,610 --> 00:21:05,610
.مهلاً لحظة

327
00:21:05,990 --> 00:21:08,370
،إن كنتَ محاربًا من فترة باكوماتسو

328
00:21:08,370 --> 00:21:09,450
فكم عمرك بالضّبط؟

329
00:21:09,830 --> 00:21:12,660
لا يعقل أنّ تكون في الثّلاثين
بهذه الملامح اليافعة، صحيح؟

330
00:21:12,870 --> 00:21:13,830
أورو؟

331
00:22:46,130 --> 00:22:49,340
في الحلقة القادمة: "ساموراي
."طوكيو ميوجين ياهيكو