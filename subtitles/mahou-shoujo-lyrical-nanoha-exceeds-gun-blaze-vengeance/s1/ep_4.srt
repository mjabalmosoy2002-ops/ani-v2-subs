1
00:01:32,070 --> 00:01:33,920
فقرتنا التّالية من أخبار اليوم

2
00:01:33,920 --> 00:01:37,490
الإجراءات المُضادّة لكوارث الكائنات
الحيّة الخطيرة من قِبَل الولايات المُتّحدة

3
00:01:37,490 --> 00:01:39,730
قد عرضتْ آثاراً مُدمِّرة

4
00:01:40,140 --> 00:01:42,950
المسؤولون عن تنفيذ هذه الإجراءات المُضادّة

5
00:01:42,950 --> 00:01:45,090
،ويُبيدون هذه الكائنات الحيّة الخطيرة
،والمُلقّبة بالغُزاة

6
00:01:45,090 --> 00:01:49,250
كانت إكشيد، وحدة القوّات الخاصّة التّابعة
لمقرّ إغاثة الكوارث الخاصّة بالأُمم المُتّحدة

7
00:01:49,250 --> 00:01:52,180
الأنواع الغازية الهائلة والخطيرة
،"والمعروفة بـ"السّلَف

8
00:01:52,180 --> 00:01:54,750
،كانت تُعدّ حصينة في الماضي

9
00:01:54,750 --> 00:01:57,580
وتمّ استئصال تسعة منهم بنجاح حاليّاً

10
00:01:57,580 --> 00:02:00,440
أحرزوا تقدُّماً ثابتاً في تطهير وتحرير المناطق

11
00:02:00,440 --> 00:02:02,940
الّتي أُغلِقَتْ ومُنِعَ من الوصول إليها

12
00:02:02,940 --> 00:02:06,590
ما أثارَ حالة فرح لدى السُكّان المُجاورين

13
00:02:07,500 --> 00:02:10,970
،مُديرة إكشيد، الآنسة ياغامي هاياتي

14
00:02:10,970 --> 00:02:14,030
تبذل قصارى جهدها مع فرعها
في أقصى الشّرق بهدف

15
00:02:14,030 --> 00:02:18,520
إتمام إبادة السّلَف عالميّاً خلال العام

16
00:02:19,480 --> 00:02:21,380
،وبالتّالي

17
00:02:21,380 --> 00:02:25,550
!نكون قد أتممنا عمليّة إبادة سلَفنا العاشر

18
00:02:26,160 --> 00:02:28,540
!فعلناها

19
00:02:31,050 --> 00:02:33,540
!أحسنتما صنعاً

20
00:02:33,540 --> 00:02:35,210
لم نفعل شيئاً يُذكَر

21
00:02:36,110 --> 00:02:39,710
حالما ننتهي من تطهير وتأمين
،سلامة هذه المنطقة

22
00:02:39,710 --> 00:02:41,890
ستُزال من قائمة المناطق الخطيرة أيضاً

23
00:02:42,300 --> 00:02:45,190
هذا يعني المزيد من الأماكن الآمنة

24
00:02:45,190 --> 00:02:47,470
!هذا عظيم، هذا عظيم

25
00:02:49,800 --> 00:02:53,810
إذاً كم بقي من هؤلاء السّلَف الّذين
نعمل على إبادتهم هناك؟

26
00:02:53,810 --> 00:02:56,930
بقي ثلاثة في هذه الدّولة

27
00:02:56,930 --> 00:03:00,070
!فريقنا سينتهي قريباً

28
00:03:00,070 --> 00:03:01,270
أجل

29
00:03:01,710 --> 00:03:03,880
ماذا عن خارج البلاد؟

30
00:03:03,880 --> 00:03:09,200
كُلّ فرع من إكشيد يُحرز تقدُّماً
بين الحين والآخر في التّعامُل معهم

31
00:03:09,870 --> 00:03:11,320
شكراً

32
00:03:11,320 --> 00:03:16,250
ليس لدينا مُقاتلة قويّة مثلكِ
،في فروعنا خارج البلاد

33
00:03:16,250 --> 00:03:20,580
لكن جميع أفراد طاقمنا يتكاتفون
معاً للتّعويض عن ذلك

34
00:03:20,580 --> 00:03:22,940
جميعهن سحَرة أيضاً، صحيح؟

35
00:03:22,940 --> 00:03:26,470
من ناحية أنّهن يستطعن استخدام
السّحر، أجل

36
00:03:26,470 --> 00:03:30,160
الفُرسان الشّخصيّون لدى المُديرة ياغامي
يعملون هناك أيضاً

37
00:03:30,160 --> 00:03:31,610
!فُرسان؟

38
00:03:32,190 --> 00:03:34,290
،مُساعدتها وأربعة فُرسان يُشكّلون تنظيماً

39
00:03:34,290 --> 00:03:37,560
وكُنّ يعملن بجدٍّ في كلّ منطقة

40
00:03:37,560 --> 00:03:38,870
مُذهل

41
00:03:39,340 --> 00:03:42,340
لدى هاياتي-تشان لقب ومنصب أيضاً

42
00:03:42,340 --> 00:03:45,960
ضمن الكنيسة العالميّة من حيث أتينا

43
00:03:45,960 --> 00:03:48,630
المُديرة مُدهشة

44
00:03:48,960 --> 00:03:50,040
ماذا؟

45
00:03:50,040 --> 00:03:53,140
كم عمر المُديرة ياغامي؟

46
00:03:53,140 --> 00:03:56,110
هذا سرّيّ

47
00:03:57,970 --> 00:04:02,250
لكن غالباً أنا أصغر ممّا تعتقدين يا كوزي-سان

48
00:04:02,250 --> 00:04:03,940
مرحباً

49
00:04:03,940 --> 00:04:05,610
شكراً على عملكِ الدّؤوب

50
00:04:05,610 --> 00:04:06,390
العفو

51
00:04:07,280 --> 00:04:12,400
كوزي-سان، هزمتِ السّلَف العشرة
في غضون شهرين منذ الانضمام

52
00:04:12,680 --> 00:04:16,990
بالإضافة إلى ذلك، عزّزتِ قوّتكِ بوتيرة
تفوق ما أتخيّله بكثير

53
00:04:16,990 --> 00:04:18,810
قدّمتِ الكثير لنا فعلاً

54
00:04:18,810 --> 00:04:20,510
شكراً جزيلاً لكِ

55
00:04:20,910 --> 00:04:23,690
كوزي شينا، اللّوتس القرمزيّة الشّيطانيّة

56
00:04:23,690 --> 00:04:25,900
أنتِ بطلتنا

57
00:04:26,360 --> 00:04:28,870
يسرّني أنّني كنتُ مُفيدة

58
00:04:29,700 --> 00:04:34,160
بصراحة، أتمنّى لو أمنحكِ نقاطاً
...على هذا، لكن

59
00:04:34,160 --> 00:04:37,660
لا، لا، ليس عليكِ فعل ذلك حقّاً

60
00:04:37,660 --> 00:04:42,520
كان العامّة يضجّون بشأن
جريمة الشّيطانيّ كذلك

61
00:04:42,520 --> 00:04:45,100
أحقّاً ذلك؟

62
00:04:45,100 --> 00:04:48,170
،تدمير الطّرُق التّجاريّة لعقاقير الشّيطانيّين

63
00:04:48,170 --> 00:04:50,650
ووفاة أصحاب النّفوذ

64
00:04:50,650 --> 00:04:53,710
في المُنظّمات الإجراميّة الّتي
...تُعَدّ مصدراً خطيراً للشّيطانيّين

65
00:04:54,190 --> 00:04:58,600
تُصنَّف على أنّها صِراع بين أعضاء
،العالم السُّفليّ البشريّين

66
00:04:58,600 --> 00:05:01,220
لكن هناك إشاعات مُنتشرة

67
00:05:01,220 --> 00:05:03,540
بأنّ الشّيطانيّين يتقاتلون فيما بينهم

68
00:05:04,240 --> 00:05:07,310
...المجموعة الّتي تُعرَف بسفّاحي الشّيطانيّين

69
00:05:07,310 --> 00:05:10,940
رغم أنّ جريمة الشّيطانيّين
،خارج نِطاق صلاحيّاتنا

70
00:05:10,940 --> 00:05:14,990
إلّا أنّ مُحاولة اعتقال شيطانيّ
تبدو صعبة للغاية

71
00:05:14,990 --> 00:05:18,170
نحن نسعى جاهدين لضمان عدم
حدوث ذلك بعد الآن

72
00:05:18,170 --> 00:05:19,960
!شكراً جزيلاً لكِ

73
00:05:20,280 --> 00:05:22,080
!حضرة المُديرة

74
00:05:22,080 --> 00:05:25,620
من المقبول التّفاعل مع جيراني، صحيح؟

75
00:05:25,620 --> 00:05:26,880
بالطّبع

76
00:05:26,880 --> 00:05:28,830
،علينا التّفكير في المُستقبل أيضاً

77
00:05:28,830 --> 00:05:31,180
لذا من فضلكن استمعنَ لهموم السُكّان

78
00:05:31,180 --> 00:05:32,710
!عُلِم

79
00:05:34,220 --> 00:05:35,960
!السّترة، إزالة

80
00:05:38,780 --> 00:05:41,460
هذا عمليّ للغاية

81
00:05:41,460 --> 00:05:43,730
،يُصلح نفسه عندما يتضرّر

82
00:05:43,730 --> 00:05:45,540
!ويسمح لي بتبديله فوراً

83
00:05:45,540 --> 00:05:46,570
إنّه السّحر

84
00:05:46,570 --> 00:05:48,670
إنّها تكنولوجيا من خارج البلاد

85
00:05:48,670 --> 00:05:51,490
!السّحر من خارج البلاد مُذهل

86
00:05:52,300 --> 00:05:54,740
حسناً، سأغادر إذاً

87
00:05:54,740 --> 00:05:56,240
بالتّوفيق

88
00:05:56,980 --> 00:06:00,560
،أحضرتُ أكلات خفيفة للجميع
لذا خذيها من فضلكِ

89
00:06:00,940 --> 00:06:02,300
!شكراً

90
00:06:02,750 --> 00:06:05,370
سألتقي بكِ بعد قليل

91
00:06:05,370 --> 00:06:06,760
!حسناً

92
00:06:11,660 --> 00:06:13,710
شينا-سان مُبتهجة جدّاً

93
00:06:13,710 --> 00:06:16,510
بالإضافة إلى أنّها تصبح أقوى بثبات

94
00:06:16,840 --> 00:06:19,150
،اكتشفتِها لأجلنا

95
00:06:19,150 --> 00:06:21,520
لذا أنا متأكّدة بأنّكِ أحسنتِ الاختيار

96
00:06:22,350 --> 00:06:23,960
لا أعتقد بأنّ من المُبالغة

97
00:06:23,960 --> 00:06:26,660
القول بأنّها الفتاة الّتي تستطيع
إنقاذ هذا العالم

98
00:06:27,270 --> 00:06:28,630
!أتّفق

99
00:06:30,520 --> 00:06:35,550
رغم ذلك، لم يمضِ وقت طويل
منذ وفاة أُختها الصّغرى

100
00:06:35,550 --> 00:06:40,200
أنا قلق عليها، وأعتقد بأنّ علينا العناية بها

101
00:06:40,830 --> 00:06:43,440
نانوها-تشان، كنتِ تُراقبينها عن كثب

102
00:06:43,440 --> 00:06:44,700
ما رأيكِ؟

103
00:06:44,700 --> 00:06:46,800
أظنّها ستكون بخير

104
00:06:46,800 --> 00:06:51,430
فهي تتكلّم معي كثيراً حول أختها
الصّغرى، سيتسونا-تشان

105
00:06:52,080 --> 00:06:54,120
،الأهمّ

106
00:06:54,120 --> 00:06:59,610
غالباً ما تقول شينا-سان بأنّها تستطيع
الشّعور بأنّ سيتسونا-تشان تعيش بداخلها

107
00:07:00,300 --> 00:07:04,160
يبدو أنّها أيضاً تعرّفتْ على صديقة
،جديدة مُؤخّراً

108
00:07:04,160 --> 00:07:06,200
لذا يبدو أنّها تستمتع بحياتها

109
00:07:06,200 --> 00:07:07,320
!بالفعل

110
00:07:07,320 --> 00:07:09,790
ماذا؟ من تكون صديقتها؟

111
00:07:10,890 --> 00:07:13,260
،إنّها فتاةٌ في مثل سنّها تقريباً

112
00:07:13,260 --> 00:07:15,420
!وتقول بأنّها لطيفة حقّاً

113
00:07:17,250 --> 00:07:20,120
كنتُ في الخارج أُساهم في الإبادة

114
00:07:24,380 --> 00:07:26,090
...هذان الشّخصان

115
00:07:26,090 --> 00:07:29,810
يشبهان أمّي وأبي بعض الشّيء

116
00:07:34,360 --> 00:07:37,920
أوّل شيء أتذكّره هو أنّني كنتُ محبوسة

117
00:07:41,570 --> 00:07:45,870
كنّا فئران تجارب لمالكي المركز

118
00:07:52,060 --> 00:07:55,040
،كُنّا نُحقَن بعقاقير ونخضع لتجارُب

119
00:07:55,040 --> 00:07:57,370
،وإذا لم نستطع تحمُّل العقّار ومتنا

120
00:07:57,370 --> 00:07:58,810
ينتهي الأمر على هذا الحال

121
00:08:00,800 --> 00:08:04,730
نُقِلَ العديد من الأطفال كجثامين

122
00:08:08,310 --> 00:08:10,510
المهرب الوحيد من مُعاناتنا

123
00:08:10,510 --> 00:08:15,970
كان التغلُّب على آثار العقاقير
وتحقيق نتائج نافعة

124
00:08:23,190 --> 00:08:25,970
،بخلاف الأطفال الآخرين

125
00:08:25,970 --> 00:08:27,520
لا أذكر شيئاً عن عائلة

126
00:08:27,520 --> 00:08:29,550
أو مكان أردتُ العودة إليه

127
00:08:30,780 --> 00:08:33,110
لا أعرف السّبب، لكن نجوت

128
00:08:35,280 --> 00:08:37,280
،كنتُ في كلّ مرّة أُحقَن فيها بعقاقير

129
00:08:37,280 --> 00:08:39,250
،وفي كلّ مرّة آكل

130
00:08:39,250 --> 00:08:40,860
أشعر بشيء غير مُريح وخاطئ

131
00:08:43,330 --> 00:08:47,690
بين الفيّنة والأُخرى، كانوا يأخذون
أجزاء من ذِراعَي أو أعضائي الحيويّة

132
00:08:47,690 --> 00:08:49,390
لكنّها كانت تنمو من جديد

133
00:08:53,670 --> 00:08:56,270
عندما نما شعري وصار أطول
،وزدتُ طولاً

134
00:08:56,800 --> 00:09:00,310
عرفتُ الغايةَ الحقيقيّة من المركز

135
00:09:05,610 --> 00:09:08,410
كان مركز تصنيع عقّار شيطانيّ

136
00:09:08,410 --> 00:09:10,730
يمنح البشرَ قوّةَ الأنواع الغازية

137
00:09:13,240 --> 00:09:18,220
ذات الشّعر الأسود لا تمتلك القوّة
الّتي كنتِ تأملينها؟

138
00:09:18,220 --> 00:09:19,280
هذا صحيح

139
00:09:19,280 --> 00:09:21,670
لديها القوّة لتخفيف مخاطر التفسُّخ

140
00:09:21,670 --> 00:09:24,310
من أكل الشّيطانيّين والغُزاة

141
00:09:24,700 --> 00:09:26,200
،كتأثير جانبيّ

142
00:09:26,200 --> 00:09:31,470
تكتسب أيضاً قدرةَ استخدام
قِوى أولئك الّذين تلتهمهم

143
00:09:31,470 --> 00:09:33,060
هذا مُدهش، أليس كذلك؟

144
00:09:33,060 --> 00:09:34,270
!كلّا، كلّا

145
00:09:34,270 --> 00:09:35,820
!هذا عديم الفائدة تماماً

146
00:09:35,820 --> 00:09:39,220
لا يمكننا استخراج أو نقل قوّتها

147
00:09:40,330 --> 00:09:43,460
لذا لن تؤدّي وظيفة مُكوِّن
لعقاقير الشّيطانيّين؟

148
00:09:43,460 --> 00:09:44,480
تماماً

149
00:09:44,480 --> 00:09:47,860
لم يفلح ذلك، حتّى أكل أعضائها
الحيويّة أو أجزائها البهيميّة

150
00:09:48,160 --> 00:09:52,040
لذا الّتي أُركّز عليها هي تلك النّاريّة

151
00:09:52,040 --> 00:09:55,800
،صنعتُ العديدَ مِمَّن يُصنَّفون كأنواع مُشابِهة

152
00:09:55,800 --> 00:09:58,850
وحالما ينمون ويصبحون أقوياء
،كما أتأمّل منهم

153
00:09:59,710 --> 00:10:01,690
،سأتذوّقهم بنفسي

154
00:10:01,690 --> 00:10:05,160
!وأصبح أقوى بكثير وأجمل

155
00:10:06,420 --> 00:10:09,740
ستُساعدني، أليس كذلك يا إيجي-كن؟

156
00:10:09,740 --> 00:10:12,060
هذا ما وعدتُ به

157
00:10:24,250 --> 00:10:27,700
أنا آسفة

158
00:10:39,100 --> 00:10:40,550
أنا آسفة

159
00:10:55,610 --> 00:10:59,280
لم أكن أملك فكرة عمّا أصابني

160
00:11:02,680 --> 00:11:05,820
هل ينبغي أن نتخلّص
من مادّة التّجربة هذه؟

161
00:11:06,560 --> 00:11:07,980
هذا ما أعتقده

162
00:11:07,980 --> 00:11:09,520
،لا نفع منها لنا

163
00:11:09,520 --> 00:11:12,270
لذا لنبعها لعُملائنا كطعام أو ما شابه

164
00:11:12,270 --> 00:11:14,030
عُلِم

165
00:11:26,080 --> 00:11:28,420
،عندما استيقظت

166
00:11:29,210 --> 00:11:31,680
وجدتُ نفسي في شارع وبعض الأنقاض

167
00:11:32,910 --> 00:11:35,090
!إيما! إنّها فتاة

168
00:11:35,090 --> 00:11:36,350
!لا تزال حيّة

169
00:11:36,350 --> 00:11:38,220
!حقّاً؟

170
00:11:38,900 --> 00:11:42,350
،السّيّارة الّتي تنقلني قد انقلبتْ

171
00:11:42,350 --> 00:11:44,350
والسّائق قد مات

172
00:11:47,590 --> 00:11:50,370
الحادِث... أو هجوم الأنواع الغازية

173
00:11:50,370 --> 00:11:53,110
...لا أعرف أيُّهما وقع أوّلاً، لكن

174
00:11:54,730 --> 00:11:56,690
إنّها مُنهَكة

175
00:11:56,690 --> 00:11:58,190
لننقلها إلى مشفى أوّلاً

176
00:11:58,190 --> 00:12:00,340
أجل، ألغيَتْ عمليّة الإبادة خاصّتنا

177
00:12:00,340 --> 00:12:02,360
!تويا، لنعُد بسرعة

178
00:12:02,360 --> 00:12:04,040
!ما زالت الأمور على ما يُرام

179
00:12:04,040 --> 00:12:06,690
لا داعي للقلق حيال أيّ شيء

180
00:12:06,690 --> 00:12:11,420
،أوّل مرّة غادرتُ فيها ذلك السّجن

181
00:12:11,860 --> 00:12:14,390
التقيتُ ببعض الأشخاص الغُرباء قليلاً

182
00:12:22,670 --> 00:12:25,740
تووا-سان، يوزو تتكلّم

183
00:12:26,830 --> 00:12:30,900
شيوري-سان ويونا-سان قالتا
بأنّهما ستحضران طعاماً

184
00:12:30,900 --> 00:12:32,340
...إن أحببتِ

185
00:12:33,390 --> 00:12:34,550
أنا قادمةٌ في الحال

186
00:12:35,010 --> 00:12:36,570
يوزو هنا

187
00:12:37,610 --> 00:12:39,340
سأفتحه

188
00:12:40,510 --> 00:12:42,260
شكراً

189
00:13:01,530 --> 00:13:03,390
المعذرة

190
00:13:03,390 --> 00:13:05,630
اشترينا كثيراً من الأشياء

191
00:13:05,630 --> 00:13:09,060
أحضرتُ بعض الأطعمة الخفيفة لأو ويوزو أيضاً

192
00:13:09,060 --> 00:13:10,490
!مرحى

193
00:13:11,220 --> 00:13:13,340
!تفضّلي يا تووا-تشان! هذه لكِ

194
00:13:13,340 --> 00:13:14,760
!علبة غداء كبيرة الحجم

195
00:13:14,760 --> 00:13:15,810
شكراً لكِ

196
00:13:16,300 --> 00:13:19,820
ماذا عن الطّعام المحفوظ والمؤونات لأنشطتنا؟

197
00:13:19,820 --> 00:13:21,580
سأخزّنها

198
00:13:32,090 --> 00:13:33,850
أوي، قدّمي المُساعدة أيضاً

199
00:13:33,850 --> 00:13:35,310
قادمة

200
00:13:36,010 --> 00:13:38,760
،جميعكن كنتُن مُفيدات

201
00:13:38,760 --> 00:13:41,150
ومُؤتمنات أيضاً

202
00:13:41,510 --> 00:13:43,740
لكن حان الوقت للتوقُّف

203
00:13:43,740 --> 00:13:46,250
من الآن فصاعداً، سأعمل بشكل انفراديّ

204
00:13:46,770 --> 00:13:51,120
يمكنني استبعاد قواكن الشّيطانيّة
في أيّ لحظة أيضاً

205
00:13:51,510 --> 00:13:55,610
شيوري، ليس عليكِ إنفاق مالكِ
للاعتناء بي

206
00:13:55,610 --> 00:13:56,980
!بلى

207
00:13:59,830 --> 00:14:02,510
،لو لم تُنقذيني

208
00:14:02,510 --> 00:14:06,140
لاستُهلِكَتْ حياتي ومالي بواسطة الشّيطانيّين

209
00:14:11,680 --> 00:14:14,140
أنا أُسخّره للخير

210
00:14:14,530 --> 00:14:17,900
،ليس وكأنّ بقيّتنا لديهن شيء آخر يفعلنَه

211
00:14:17,900 --> 00:14:20,050
وجميعنا نريد أن ندعمكِ يا تووا-تشان

212
00:14:27,290 --> 00:14:31,040
!نحن نستمتع بمُساعدتكِ

213
00:14:40,390 --> 00:14:42,150
!أريد أن أكون مُفيدة لكِ

214
00:14:42,150 --> 00:14:43,420
!سأبذل قصارى جهدي

215
00:14:58,250 --> 00:15:00,330
!لقد أنقذتِنا

216
00:15:00,680 --> 00:15:03,760
!جميعنا جزء من فريق سفّاحي الشّيطانيّين

217
00:15:03,760 --> 00:15:05,060
!هذا صحيح

218
00:15:05,060 --> 00:15:09,840
فضلاً عن ذلك، سنكون بخير لو أنّ الدّولة
والشّرطة يتعاملون مع الأمر كما ينبغي

219
00:15:09,840 --> 00:15:14,060
هذا ينطبق على كلتَي الحادثتين اللّتين
تخصّان الشّيطانيّين والعقاقير أيضاً

220
00:15:14,060 --> 00:15:17,160
أجل، هذا صحيح

221
00:15:17,160 --> 00:15:20,960
لا يمكننا الوثوق بالشّرطة والمُنظّمات
الدّوليّة لمُعالجة الأمر

222
00:15:20,960 --> 00:15:22,770
لا أريدكن أن تتورّطن

223
00:15:23,620 --> 00:15:28,710
أريدكن حقّاً أن تعِشنَ حياة طبيعيّة
،في مُجتمع صحّيّ

224
00:15:28,710 --> 00:15:32,350
لكن لم يبقَ الكثير من الوقت
حتّى نقطة اللّاعودة

225
00:15:32,710 --> 00:15:36,240
...سأعتمد عليكن إلى ذلك الحين، لكن

226
00:15:36,240 --> 00:15:36,970
!حاضرات

227
00:15:38,630 --> 00:15:42,280
أهداف ثأركن هُم الزُعماء الّذين
،يقِفون خلف عقّار الشّيطانيّين

228
00:15:42,280 --> 00:15:44,620
كوراغي إيجي وشينوميا مانا

229
00:15:44,950 --> 00:15:46,890
سنبذل قصارى جهدنا لإيجادهما

230
00:15:46,890 --> 00:15:48,380
!سوف نقتلهما

231
00:15:53,660 --> 00:15:57,550
عمل الأطفال هو الدِّراسة واللّعب

232
00:15:57,550 --> 00:15:59,520
،تعرّفي على أصدقاء ومعارِف

233
00:15:59,520 --> 00:16:02,080
،بما يكفي لمُواصلة العيش

234
00:16:02,080 --> 00:16:04,700
ويمكنكِ أن تستمتعي بحياة سعيدة

235
00:16:04,700 --> 00:16:08,030
وسيكون أفضل حتّى إذا وجدتِ
شخصاً عزيزاً عليكِ

236
00:16:08,670 --> 00:16:11,780
كان هناك شخصان غريبان

237
00:16:11,780 --> 00:16:14,900
تبنّيا طفلة ذات أصل مجهول

238
00:16:16,820 --> 00:16:18,410
يورومي تووا

239
00:16:18,410 --> 00:16:19,780
اسم جميل، صحيح؟

240
00:16:20,100 --> 00:16:22,850
،يُشبه "تووا" اسمي قليلاً بالفعل

241
00:16:22,850 --> 00:16:26,010
لكن مُشاركة الكنية أروع حتّى، أليس كذلك؟

242
00:16:26,010 --> 00:16:28,670
يمكنكِ أن تُناديني بأبيكِ

243
00:16:28,670 --> 00:16:31,520
وأُرحّب بكِ بمُناداتي بأمّكِ أيضاً

244
00:16:32,000 --> 00:16:36,050
لماذا تريدان ضمّي إلى عائلتكما؟

245
00:16:37,550 --> 00:16:40,070
السّبب الرّئيسيّ هو لأنّنا احتجنا لطفلة دوماً

246
00:16:40,070 --> 00:16:41,870
هذا أحد الأسباب

247
00:16:41,870 --> 00:16:45,860
وأيضاً، لا يمكن أن نترك طفلة
تُعاني لوحدها في الخارج

248
00:16:45,860 --> 00:16:47,570
هذا سبب من الأسباب

249
00:16:48,120 --> 00:16:51,080
مضى ستّة أشهر منذ مجيئكِ وعيشكِ معنا

250
00:16:51,080 --> 00:16:52,240
كيف هو شعوركِ حيال الأمر؟

251
00:16:52,240 --> 00:16:54,650
!كان ذلك مُمتعاً بالنّسبة لنا

252
00:16:56,580 --> 00:16:59,070
لم أستطع الفهم

253
00:16:59,400 --> 00:17:04,480
لم أفهم لطفهما ولا الرّوابط بين النّاس
أو حتّى معنى الشُّعور بالمتعة

254
00:17:05,080 --> 00:17:09,090
نرغب في أن نُصبح عائلة بشكل رسميّ

255
00:17:09,090 --> 00:17:12,090
ليس عليكِ الإجابة فوراً

256
00:17:12,090 --> 00:17:14,700
!أريد أن أدعكِ ترتادين المدرسة أيضاً

257
00:17:19,320 --> 00:17:20,570
رغم أنّني

258
00:17:21,100 --> 00:17:23,170
نصف وحش؟

259
00:17:23,170 --> 00:17:26,360
،الإصابة بحالة مُزمنة أو اثنتين ليست أمراً جللاً

260
00:17:26,360 --> 00:17:28,850
ستكونين بخير ما دمتِ حذرة

261
00:17:29,890 --> 00:17:35,100
بصراحة، لم أكن أشعر بأي مشاعر
خاصّة تجاههما في ذلك الوقت

262
00:17:36,010 --> 00:17:39,140
،وفّرا لي مكاناً آمناً للنّوم

263
00:17:39,140 --> 00:17:42,170
لذا لم أكن أملك سبباً لتركهما ببساطة

264
00:17:47,510 --> 00:17:49,370
،هكذا كنت

265
00:17:51,370 --> 00:17:56,370
،لكن لطالما كانا يبتسمان ويُقدّرانني

266
00:17:56,780 --> 00:18:01,730
لذا بدأتُ أفهم بضعة أشياء
لم أكُن أفهمها من قبل

267
00:18:07,360 --> 00:18:11,640
كسبب اعتذار طفلة النّار منّي

268
00:18:12,660 --> 00:18:15,930
أنا متأكِّدة بأنّ تلك المكان كان
،لديها مكان تعود إليه

269
00:18:15,930 --> 00:18:18,340
،وأشخاص سيحزنون لو ماتت

270
00:18:19,310 --> 00:18:21,920
وأخبرَتْني بأنّها آسفة

271
00:18:22,450 --> 00:18:24,860
لأنّها لم تُرِد أن تقتلني

272
00:18:26,180 --> 00:18:28,780
أتساءل ما إن كانت لا تزال حيّة؟

273
00:18:28,780 --> 00:18:32,260
،بدأتُ أرغب في أن تبقى حيّة

274
00:18:37,840 --> 00:18:38,900
...لكن

275
00:18:40,460 --> 00:18:44,470
أوّل مرّة ذهبتُ فيها في رحلة
...مع ذلكما الشّخصين

276
00:18:58,530 --> 00:19:00,070
أنا آسفة

277
00:19:03,590 --> 00:19:04,890
...لا أستطيع

278
00:19:05,870 --> 00:19:07,960
إيقاف نفسي بعد الآن

279
00:19:08,790 --> 00:19:11,950
فهمتُ في الواقع حقيقةَ أنّها
،قتلَتْ والدَي

280
00:19:12,540 --> 00:19:18,600
وبأنّها لم تستطع منع قوّتها بعد
أن جعلَتْها العقاقير تفقد سيطرتها

281
00:19:20,710 --> 00:19:23,470
...بسبب ذلكما الأمرين

282
00:19:25,460 --> 00:19:27,980
هذه ليست غلطتك

283
00:20:07,210 --> 00:20:10,140
...أبي، أمّي

284
00:20:12,730 --> 00:20:14,900
أدركتُ لاحقاً

285
00:20:15,650 --> 00:20:19,780
بأنّ الحادث في المطار كان
سببه كوراغي وشينوميا

286
00:20:21,640 --> 00:20:25,420
استُخدِمَت شيطانيّة اللّهب كقُنبلة
حيّة قابلة للإزالة

287
00:20:25,960 --> 00:20:29,750
كان استعراضاً لبيع العقاقير
المُستخدَمة لصنعها

288
00:20:31,350 --> 00:20:33,370
...عائلة، أصدقاء

289
00:20:33,370 --> 00:20:38,660
،ما زلتُ غالباً لا أفهم تلك الأمور الثّمينة

290
00:20:39,600 --> 00:20:44,810
لكن أعرف ما لا يمكنني مُسامحته
وما يجب عليّ فعله

291
00:20:45,930 --> 00:20:47,810
لم تكن تلك الفتاة مُلامة

292
00:20:48,660 --> 00:20:53,860
يقع اللّوم على أولئك الّذين جعلوها
شيطانيّة وأجبروها على فعل ما فعلَتْه

293
00:20:54,960 --> 00:20:57,610
...البشر الّذين صنعوا العقاقير وذلك المركز

294
00:20:58,020 --> 00:21:01,480
سأقتل شينوميا وكوراغي

295
00:21:02,180 --> 00:21:04,950
سأقتل أيّ شيطانيّ يعترض
طريقي إلى ذلك

296
00:21:04,950 --> 00:21:07,810
سأضع حدّاً للعقّار الشّيطانيّ
الخاص بشينوميا

297
00:21:08,200 --> 00:21:11,760
اكتسبتُ القوّةَ للقيام بذلك

298
00:21:12,950 --> 00:21:16,320
...أشعر بتأنيب الضّمير لتوريط أولئك الفتيات

299
00:21:16,750 --> 00:21:20,520
...وضحايا عقّار الشّيطانيّين وحوادث الشّيطانيّين تلك

300
00:21:21,190 --> 00:21:23,340
لكن كُلّ ذلك سينتهي قريباً

301
00:21:23,970 --> 00:21:28,210
لا أنوي العيش بعد أن أُكمل
،ما يجب عليّ فعله

302
00:21:28,210 --> 00:21:30,570
ولا أعتقد بأنّني سأنجو من ذلك أيضاً

303
00:21:31,880 --> 00:21:37,340
حالما أرحل، ينبغي أن ترغب هؤلاء
الفتيات في عيش حياة طبيعيّة أيضاً

304
00:21:46,840 --> 00:21:48,540
أتساءل ما إن كنتُ

305
00:21:49,200 --> 00:21:51,960
سأدع شينا تحزن عندما أموت؟

306
00:23:30,810 --> 00:23:33,840
هل أنتِ عضوة في سفّاحيّ الشّيطانيّين؟

307
00:23:33,840 --> 00:23:35,300
وماذا لو قلتُ بأنّني كذلك؟