1
00:01:38,570 --> 00:01:40,310
هل أنت جادّة بشأن الدُّخلاء؟

2
00:01:40,720 --> 00:01:41,950
أنا جادّة

3
00:01:41,950 --> 00:01:44,170
دخلوا إلى المُختبر

4
00:01:54,740 --> 00:01:57,460
!حسناً، ولا حركة رجاء

5
00:01:57,890 --> 00:02:02,090
أنتم مُتّهمون بإخفاء واستخدام غير شرعيّ
للأنواع الغازية الخطيرة

6
00:02:02,090 --> 00:02:06,470
!أنتم قيد التّحقيق أيضاً بخصوص تهمة اختطاف

7
00:02:06,470 --> 00:02:07,810
!لماذا؟

8
00:02:07,810 --> 00:02:10,360
!إيجي-كن! إيجي-كن

9
00:02:10,360 --> 00:02:11,380
لا أعلم

10
00:02:11,380 --> 00:02:13,480
أتحرّى حول الأمر بالفعل

11
00:02:13,480 --> 00:02:16,080
ماذا نفعل يا إيجي-كن؟

12
00:02:18,780 --> 00:02:20,090
حقّاً؟

13
00:02:20,090 --> 00:02:22,110
،إمّا أن نتخلّى عن المُختبر ونهرب

14
00:02:22,110 --> 00:02:26,980
أو نقتل جميع مَن أتوا إلى هنا للعثور علينا

15
00:02:27,390 --> 00:02:29,770
،لا أُمانع الهرب

16
00:02:30,260 --> 00:02:33,750
لكن هناك الكثير من الأشياء الّتي
من الصّعب إخراجها من هنا

17
00:02:33,750 --> 00:02:35,000
،الأهمّ

18
00:02:35,000 --> 00:02:39,130
كنّا قد بنينا هذا المُختبر لأجلي
تحت توجيهاتك

19
00:02:39,130 --> 00:02:41,500
لدينا نباتنا المُؤصَّص هنا

20
00:02:41,500 --> 00:02:44,400
مع مُختلف أنواع الكنوز الأُخرى أيضاً

21
00:02:44,400 --> 00:02:45,900
،لذا يا إيجي-كن

22
00:02:46,470 --> 00:02:48,340
هل يمكنني قتلهم؟

23
00:02:48,600 --> 00:02:51,250
أجل، افعلي ما يحلو لكِ

24
00:02:51,690 --> 00:02:53,470
يمكنكِ ترك المُخلّفات على عاتقي

25
00:02:53,470 --> 00:02:54,640
!شكراً لك

26
00:02:54,640 --> 00:02:56,230
!أُحبّك يا إيجي-كن

27
00:02:56,980 --> 00:03:00,980
حسناً إذاً، هذه رسالة إلى كافّة
!العاملين في المُختبر

28
00:03:00,980 --> 00:03:04,490
!لا ضير من قتل كافّة الدُّخلاء

29
00:03:04,490 --> 00:03:07,490
!احرصوا على حماية المركز والمُمتلكات

30
00:03:07,490 --> 00:03:09,130
عُلِم

31
00:03:14,250 --> 00:03:15,440
...هؤلاء

32
00:03:15,440 --> 00:03:17,120
سمعتُ عنهم من تووا-سان

33
00:03:17,980 --> 00:03:22,310
مُعظم العاملين في هذا المُختبر
لا هُم بشر ولا شيطانيّون

34
00:03:23,080 --> 00:03:25,570
إنّهم وحوش على هيئة بشر

35
00:03:26,400 --> 00:03:28,420
لسنا بحاجة للتحفُّظ إذاً

36
00:03:28,420 --> 00:03:29,280
أجل

37
00:03:32,280 --> 00:03:34,020
تمّ تأكيد وجود فعل عِدائيّ

38
00:03:35,940 --> 00:03:39,530
!لا تُعرقِلوا تحقيقاتنا

39
00:03:46,520 --> 00:03:48,970
،بفضل كوديرا-سان والمُديرة ياغامي

40
00:03:48,970 --> 00:03:51,130
كنّا قادرين على إدخال وحدة تحرّياتنا

41
00:03:52,400 --> 00:03:55,000
وحدة التحرّيات وأنا

42
00:03:55,000 --> 00:03:57,550
سنضع الأولويّة للبحث عن المارّة
،في المركز وإنقاذهم

43
00:03:58,260 --> 00:04:00,320
،لذا يا شينا-سان وأيزاوا-سان وبقيّتكن

44
00:04:00,320 --> 00:04:02,150
الرّجاء التّركيز على البحث عن يورومي-سان

45
00:04:02,150 --> 00:04:03,150
حسناً

46
00:04:03,150 --> 00:04:04,360
...بالنّسبة لكِ يا نانوها

47
00:04:05,070 --> 00:04:09,230
بئساً، أحببتُ هذا المُختبر حقّاً

48
00:04:09,230 --> 00:04:12,560
كان مثاليّاً لإتمام الأمور دون عراقيل

49
00:04:13,050 --> 00:04:18,190
بالإضافة إلى ذلك، سيترتّب عليّ نقل
...ذلك النّبات المُؤصَّص لتغيير المواقع

50
00:04:18,800 --> 00:04:20,450
،أيُّها المُساعدون

51
00:04:20,450 --> 00:04:24,440
!أسرعوا وحضِّروا نباتي المُؤصَّص لعمليّة النّقل

52
00:04:24,660 --> 00:04:28,030
أجل، بدأنا بالفعل بإخراج المواد

53
00:04:28,030 --> 00:04:31,430
سنتجهّز لنقل السّلَف صفر بعجالة

54
00:04:32,700 --> 00:04:35,570
سأُبيد السّلَف صفر

55
00:04:35,570 --> 00:04:38,300
لكن أعتقد بأنّني ينبغي أن أكون
أنا من يفعل ذلك

56
00:04:38,300 --> 00:04:39,830
لا مانع

57
00:04:39,830 --> 00:04:44,590
اهتمّي رجاء بالبحث عن يورومي-سان
والقبض على شينوميا

58
00:04:44,590 --> 00:04:45,640
حسناً

59
00:04:45,640 --> 00:04:50,340
،آيزاوا-سان، نينا-سان، كيتاموري-سان
توخّينَ الحذر رجاء

60
00:04:56,210 --> 00:04:57,340
حسناً

61
00:04:58,000 --> 00:05:01,100
!لنحرص على إنقاذ يورومي-سان

62
00:05:01,900 --> 00:05:03,610
شكراً جزيلاً

63
00:05:04,030 --> 00:05:05,020
أجل

64
00:05:08,750 --> 00:05:12,320
كوزي-سان، هل نتفرّق للبحث عنها؟

65
00:05:12,730 --> 00:05:15,190
...يمكننا جميعاً البحث عنها، وعندما نجدها

66
00:05:15,190 --> 00:05:17,870
!من يجد تووا-سان فليُنقذها

67
00:05:17,870 --> 00:05:19,660
!أجل، يا لها من خطّة

68
00:05:20,630 --> 00:05:22,320
...لكن عدنَني

69
00:05:22,320 --> 00:05:25,930
،أنّه إذا واجهت إحداكُن عدوّاً قويّاً
أن تصرخنَ لنا

70
00:05:25,930 --> 00:05:30,070
!أنا أو شخص من إكشيد ستأتي لمُساعدتكن

71
00:05:33,160 --> 00:05:34,400
!أجل

72
00:05:35,780 --> 00:05:37,020
،شينا

73
00:05:38,270 --> 00:05:39,560
كوني حذرة أيضاً

74
00:05:40,480 --> 00:05:42,720
شكراً يا يونا

75
00:05:43,890 --> 00:05:44,950
!بالتّوفيق

76
00:05:44,950 --> 00:05:46,280
أراكُن لاحقاً

77
00:05:52,710 --> 00:05:57,700
ائتمنتْ تووا-سان العنكبوت الّذي تركَتْه
في زنزانة السّجن على رسالة

78
00:05:58,620 --> 00:05:59,800
أنا آسفة

79
00:05:59,800 --> 00:06:01,460
،وجدتُ شينوميا

80
00:06:02,020 --> 00:06:03,610
لكن لم أستطع هزيمتها

81
00:06:04,570 --> 00:06:08,590
،رغم ذلك، أُخطّط لهزيمة شينوميا، وتدمير مركزها

82
00:06:08,590 --> 00:06:12,120
والمُتابعة لهزيمة كوراغي كذلك

83
00:06:12,860 --> 00:06:17,270
ارتأيتُ بأنّه سيكون من الجيّد تخليص
،العالم من الشّيطانيّين وعقاقيرهم

84
00:06:18,150 --> 00:06:23,530
،لكن حتّى لو هزمتُ شينوميا وكوراغي
سيستغرق ذلك وقتاً غالباً

85
00:06:24,600 --> 00:06:28,370
،للحرص على قدرتكن على حماية أنفسكن

86
00:06:28,370 --> 00:06:30,650
سأُعيد قِواكن على الأقلّ

87
00:06:33,330 --> 00:06:35,190
،إذا رأيتُن شينا

88
00:06:36,660 --> 00:06:38,660
فأخبرنَها بأنّني آسفة

89
00:06:41,150 --> 00:06:46,510
،ينبغي أن تنسينَ أمري جميعاً
،وتذهبنَ إلى المدرسة بشكلٍ طبيعيّ

90
00:06:46,770 --> 00:06:48,950
...وتجدنَ أشخاصاً ينسجمون معكن

91
00:06:49,430 --> 00:06:55,290
ثمّ تعِشنَ حياةً سعيدة حيث لا تضطررنَ
لاستخدام قِواكن الشّيطانيّة

92
00:06:55,770 --> 00:06:57,880
باستثناء عندما تقعنَ في ورطة حقّاً

93
00:07:04,620 --> 00:07:06,750
كنّا حزينات للغاية

94
00:07:07,330 --> 00:07:08,890
...ومُمتعضات

95
00:07:09,450 --> 00:07:11,780
لدرجة أنّنا بكينا

96
00:07:16,560 --> 00:07:18,050
!لنبحث عن تووا

97
00:07:20,410 --> 00:07:23,310
!لنبحث عنها ونُنقذها

98
00:07:23,980 --> 00:07:25,420
!حضرة المُديرة

99
00:07:25,420 --> 00:07:29,300
تلقّينا للتو بعض المعلومات الإيجابيّة

100
00:07:29,300 --> 00:07:31,140
رين، فيت-تشان

101
00:07:31,140 --> 00:07:32,190
!حاضرة

102
00:07:32,190 --> 00:07:36,300
العقّار الشّيطانيّ ذو الدّرجة الخاصّة
الّذي وفّرَتْه لنا كوديرا-سان

103
00:07:36,910 --> 00:07:41,020
كشفَ بأنّ بويضة الأنواع الغازية
المُستخدَمة لصنعه

104
00:07:41,020 --> 00:07:44,930
تُطابق البيانات الوراثيّة للسّلَف صفر

105
00:07:45,220 --> 00:07:46,440
...ما يعني

106
00:07:46,440 --> 00:07:52,340
بحسب وضع الخلايا، لا بُدّ أنّ العقّار
قد أُنتِجَ في مكانٍ ما

107
00:07:52,340 --> 00:07:55,430
قريب من المكان الّذي يتواجد فيه
السّلَف صفر ويتكاثر

108
00:07:58,580 --> 00:08:02,550
سنتمكّن من مُداهمته

109
00:08:02,550 --> 00:08:04,330
أليس كذلك يا حضرة الضّابطة التّنفيذيّة؟

110
00:08:04,630 --> 00:08:07,580
سنمتلك الصّلاحيّة لتنفيذ مُداهمة وبحث

111
00:08:07,580 --> 00:08:09,930
من أجل تأكيد وجود غازٍ خطير كهذا

112
00:08:13,030 --> 00:08:16,130
ينبغي أن أكون قادرة على تعقُّب أثرهم
وتحديد الإحداثيّات

113
00:08:17,890 --> 00:08:20,340
!أعدُ بأنّني أستطيع ذلك

114
00:08:20,660 --> 00:08:22,930
إن كنتِ تستطيعين، فباشِري من فضلكِ

115
00:08:22,930 --> 00:08:24,680
سأجري بحثاً أيضاً

116
00:08:24,680 --> 00:08:27,590
هل من شيء أستطيع فعله
لدعمكِ يا كوديرا-سان؟

117
00:08:27,970 --> 00:08:31,690
،كتخفيف الألم أو الإعياء من استخدام قوّتك

118
00:08:31,690 --> 00:08:33,610
أو تعميق تركيزكِ؟

119
00:08:35,270 --> 00:08:37,680
هل لديكِ قوّة داعمة؟

120
00:08:37,680 --> 00:08:40,740
ما الأشياء الّتي يمكنكِ فعلها؟

121
00:08:41,090 --> 00:08:43,250
أستطيع فعل أيّ شيء تقريباً

122
00:08:43,730 --> 00:08:46,720
فأنا فارسة وساحرة في نفس الوقت

123
00:08:47,360 --> 00:08:51,260
قد تكون هذه أوّل مرّة أرى فيها
دوائر المُديرة ياغامي السّحريّة

124
00:08:51,600 --> 00:08:53,180
بالفعل، أليس كذلك؟

125
00:08:58,490 --> 00:08:59,770
وجدتُها

126
00:09:00,160 --> 00:09:04,100
إنّها موجودة في القطب الجنوبيّ، على انخفاض
مئتَي متر تحت الأرض

127
00:09:11,210 --> 00:09:14,870
!تووا-سان وشينوميا هناك

128
00:09:16,720 --> 00:09:19,510
شكراً جزيلاً لكِ يا كوديرا-سان

129
00:09:19,910 --> 00:09:21,330
أحسنتِ صنعاً

130
00:09:26,020 --> 00:09:29,290
وحدة التحرّيات، ابدئي بالتّحضير للانتشار حالاً

131
00:09:31,170 --> 00:09:33,880
!سأذهب وأحضِّر أسلحتنا المُضادّة للسّلَف

132
00:09:36,730 --> 00:09:38,940
كوزي-سان، هل أنتِ جاهزة؟

133
00:09:39,250 --> 00:09:40,770
!بالطّبع

134
00:09:41,900 --> 00:09:44,390
!حسناً، لنتعاون معاً جميعاً

135
00:09:45,930 --> 00:09:47,780
!لنذهب ونُنقذ تووا

136
00:09:52,590 --> 00:09:56,090
لم تكن هناك أي لحظة تردُّد
في كلام تلك الفتاة

137
00:09:56,840 --> 00:10:01,290
كان هناك الكثير من الحنان
والدّفء في صوتها

138
00:10:26,020 --> 00:10:27,070
!أنتما

139
00:10:28,530 --> 00:10:31,790
!نـ-نحن مُجرّد موظّفين

140
00:10:31,790 --> 00:10:34,730
!لسنا وحوشاً! نحن بشر

141
00:10:34,730 --> 00:10:36,820
لا أُبالي لذلك

142
00:10:36,820 --> 00:10:38,180
!أين تووا-تشان؟

143
00:10:38,180 --> 00:10:41,120
الفتاة ذات الشّعر الأسود الّتي
!أُحضِرَتْ إلى هنا

144
00:10:41,120 --> 00:10:43,250
...إ-إذا أردتِ تلك الفتاة، فإذاً

145
00:10:50,710 --> 00:10:52,510
ماذا؟

146
00:10:55,750 --> 00:10:59,060
حسناً يا تووا-تشان، متى استيقظتِ؟

147
00:10:59,060 --> 00:11:00,630
هل تريدين شيئاً؟

148
00:11:00,630 --> 00:11:02,490
،أنا مشغولةٌ قليلاً حاليّاً

149
00:11:02,490 --> 00:11:07,010
لذا يمكن تأجيل تشريحكِ وتجاربكِ
لبعض الوقت

150
00:11:08,060 --> 00:11:10,060
،لم أستطع هزيمتكِ آنذاك

151
00:11:12,420 --> 00:11:15,850
...لأنّني كنتُ لا أزال مُتعلِّقة بحياتي، لكن

152
00:11:24,090 --> 00:11:25,170
ماذا؟

153
00:11:25,170 --> 00:11:26,200
...تقصدين

154
00:11:26,200 --> 00:11:28,620
...إذا كنتُ لا أُمانع إنهاء الأمر كُلّياً، فإذاً

155
00:11:30,520 --> 00:11:31,800
...إذا كنتُ أستطيع قتلها

156
00:11:33,080 --> 00:11:36,580
إذا كان هذا يعني أنّني أستطيع
،قتل هذا الوحش هنا اليوم

157
00:11:37,330 --> 00:11:41,350
...وأمنع تكرار مأساة كهذه للأبد

158
00:11:49,480 --> 00:11:51,320
فلا يهمّني

159
00:11:51,860 --> 00:11:53,820
!ولو حرقتُ حياتي

160
00:11:54,220 --> 00:11:56,510
قوّة لهب؟

161
00:11:56,510 --> 00:11:59,700
سرقتِ هذه القدرة من إحدى أنواع اللّهب خاصّتنا؟

162
00:12:00,270 --> 00:12:01,920
هل أنتِ بخير؟

163
00:12:02,680 --> 00:12:06,110
فهذه قوّة خطيرة

164
00:12:59,740 --> 00:13:01,100
!إنّها تفلح

165
00:13:01,100 --> 00:13:02,010
!أستطيع فعلها

166
00:13:03,420 --> 00:13:04,640
!يمكنني قتلها

167
00:13:17,650 --> 00:13:18,890
رأيتِ؟ خذي

168
00:13:23,400 --> 00:13:26,660
سيكون من المُزعج أن تُقاومي، لذا سأُقيّدكِ

169
00:13:36,730 --> 00:13:38,610
...هكذا إذاً

170
00:13:38,610 --> 00:13:42,160
...إذاً أنتِ تُطبّقين قوّةً من نوع اللّهب

171
00:13:42,660 --> 00:13:45,130
الميكانيكيّة بسيطة

172
00:13:46,060 --> 00:13:52,270
حرق سنوات من حياتكِ لتوليد
نار وقوّة انفجاريّة؟

173
00:13:53,060 --> 00:13:55,940
،حسناً، لا بأس بذلك

174
00:13:55,940 --> 00:13:58,510
!لكن هذا لا يكفي إطلاقاً

175
00:13:58,510 --> 00:14:00,430
!لسوء حظّكِ

176
00:14:00,770 --> 00:14:04,280
،مهما سعيتِ جاهدة، ومهما استمتِّ

177
00:14:04,280 --> 00:14:06,340
أو حتّى ولو راهنتِ على حياتكِ ذاتها

178
00:14:06,340 --> 00:14:10,070
!لا يستطيع الضّعيف هزيمة القويّ

179
00:14:16,070 --> 00:14:18,090
أخبرتُكِ بأنّه لا جدوى من ذلك

180
00:14:18,090 --> 00:14:19,950
...قبل أيّ شيء

181
00:14:22,450 --> 00:14:26,580
لماذا أنتِ غاضبة منّي أصلاً يا تووا-تشان؟

182
00:14:28,050 --> 00:14:33,730
ليس وكأنّ الحادِثة الّتي أدّتْ إلى مقتل
والديكِ بالتبنّي كانت غلطتي

183
00:14:33,730 --> 00:14:36,900
كان ذلك مُجرّد حادث مُؤسف، أليس كذلك؟

184
00:14:39,140 --> 00:14:42,400
أصبحتِ فقط إحدى فئران تجاربي

185
00:14:42,730 --> 00:14:46,740
لأنّني اشتريتُ بعض الأطفال المهجورين

186
00:14:46,740 --> 00:14:49,280
الّذين بِيعوا كمُنتجات بواسطة شخص آخر

187
00:14:49,760 --> 00:14:53,580
لم أرتكب أيّ خطأ، صحيح؟

188
00:14:53,580 --> 00:14:57,070
لذا، أليس من السّخيف السّعي للانتقام؟

189
00:14:57,070 --> 00:15:02,790
أشكُّ في أنّ والديكِ أرادا أن تقضي
كُلّ هذا الوقت من عمركِ في الانتقام

190
00:15:02,790 --> 00:15:05,610
"!كانا ليقولا بأنّ "الانتقام لا يُحقّق أي فوائد

191
00:15:05,610 --> 00:15:08,180
"!أو "توقّفي فحسب يا تووا-تشان

192
00:15:08,900 --> 00:15:12,550
!إيّاكِ والحديث عن أمّي وأبي

193
00:15:12,550 --> 00:15:15,980
يا عزيزتي، تغضبين منّي لأنّكِ
لا تستطيعين دحض ذلك؟

194
00:15:18,710 --> 00:15:23,400
،وحتّى أنّكِ ورّطتِ أتباعكِ في انتقامكِ السّخيف

195
00:15:23,400 --> 00:15:25,690
لترمي بأرواحهن إلى التّهلكة أيضاً

196
00:15:25,690 --> 00:15:28,590
ألا تشفقين عليهن؟

197
00:15:28,590 --> 00:15:31,170
ماذا يا تووا-تشان؟

198
00:15:48,840 --> 00:15:51,400
!أغلقي فمكِ اللّعين أيّتها القمامة

199
00:15:51,400 --> 00:15:54,720
!لم تُرمَ حياتنا إلى التّهلكة

200
00:16:10,510 --> 00:16:13,150
!سأنتزع هذه الأشواك عنكِ حالاً

201
00:16:14,840 --> 00:16:17,670
الجميع... لماذا؟

202
00:16:17,670 --> 00:16:19,060
ماذا عنكِ؟

203
00:16:19,060 --> 00:16:21,240
لماذا تركتِنا جميعاً ورحلتِ؟

204
00:16:21,480 --> 00:16:25,160
أسعدتِنا ومنحتِنا مكاناً للانتماء

205
00:16:25,160 --> 00:16:26,830
أنتِ تُمثّلين العالمَ كُلّه في نظرنا

206
00:16:27,250 --> 00:16:31,000
من الطّبيعيّ أن نتبعكِ أينما ذهبتِ

207
00:16:31,240 --> 00:16:34,340
شكراً جزيلاً لكِ على إعادة قِوانا

208
00:16:34,340 --> 00:16:37,590
هكذا تمكنّا من إنقاذكِ

209
00:16:38,040 --> 00:16:39,980
!اسمعي يا تووا-سان

210
00:16:39,980 --> 00:16:41,630
...هؤلاء الأشخاص اللّطيفون

211
00:16:41,940 --> 00:16:46,760
الأشخاص الّذين مع شينا-سان
!أوصلونا كُلّ الطّريق إلى هنا

212
00:16:48,400 --> 00:16:52,390
...أعلم بأنّني وأوي حمقاوتان قليلاً

213
00:16:52,790 --> 00:16:55,770
!لكن لن ندعكِ تكونين وحيدة يا تووا-سان

214
00:16:56,200 --> 00:16:58,800
!لن ندعكِ تبقين لوحدكِ

215
00:16:59,410 --> 00:17:01,420
!هذا شيء عقدنا العزم عليه

216
00:17:01,880 --> 00:17:04,030
!كُلّنا كذلك

217
00:17:15,440 --> 00:17:18,170
...لذا أيّ شخص يريد أذيّتكِ

218
00:17:19,720 --> 00:17:22,940
!سيُسحَق بواسطة سفّاحي الشّيطانيّين

219
00:17:22,940 --> 00:17:24,450
...بئس الامر

220
00:17:24,450 --> 00:17:27,190
أنا مشغولةٌ حاليّاً

221
00:18:00,330 --> 00:18:02,280
أنا مُتحرّية من الأُمم المُتّحدة

222
00:18:03,010 --> 00:18:05,000
أتيتُ لإنقاذ الجميع

223
00:18:14,230 --> 00:18:17,390
النّوع عديم الشّكل الّذي قالوا بأنّه
ظهرَ في النّفق؟

224
00:18:17,390 --> 00:18:19,320
!النّوع الّذي ينشر السُّمّ

225
00:18:26,630 --> 00:18:29,130
...اهربي رجاء يا فتاة الأُمم المُتّحدة

226
00:18:29,490 --> 00:18:30,750
لماذا؟

227
00:18:30,750 --> 00:18:32,630
أتيتُ إلى هنا لإنقاذكم جميعاً

228
00:18:33,750 --> 00:18:37,800
لأنّ ذلك الشّيء خطيرٌ جدّاً ومُخيف

229
00:18:45,800 --> 00:18:47,400
أنتِ لطيفةٌ جدّاً

230
00:18:47,720 --> 00:18:49,750
شكراً على قلقكِ عليّ

231
00:18:50,200 --> 00:18:51,910
لكن سأكون بخير

232
00:18:51,910 --> 00:18:54,930
نحن ساحرات الأُمم المُتّحدة قويّات جدّاً

233
00:18:55,270 --> 00:18:58,750
سأستأصل ذلك بلمح البصر ثمّ أُنقذكم جميعاً

234
00:19:00,280 --> 00:19:03,650
إذا خفتُم، فأغمضوا عيونكم وعدّوا إلى عشرة

235
00:19:05,420 --> 00:19:07,900
!لأنّ الأمر سيكون قد انتهى مع انتهاء العدّ

236
00:19:29,470 --> 00:19:30,540
رأيتِ؟

237
00:19:30,540 --> 00:19:32,070
أخبرتُكِ بأنّ الأمور ستكون بخير

238
00:19:46,120 --> 00:19:49,320
!كان هذا الطّريق هو الأسوأ بالفعل

239
00:19:49,320 --> 00:19:51,780
!يوجد الكثير من الحُرّاس هنا في الأسفل

240
00:20:02,470 --> 00:20:04,630
...كان يُراودني شكّ كبير

241
00:20:05,260 --> 00:20:06,960
...بأنّ الرّجل الّذي هاجمَ جزيرتنا

242
00:20:07,880 --> 00:20:10,950
...الشّيطانيّ الّذي قتلَني أنا وسيتسونا

243
00:20:10,950 --> 00:20:14,430
كان قد صُنِعَ بالعقاقير المُصنَّعة هنا

244
00:20:17,860 --> 00:20:20,110
رغم أنّه فات الأوان قليلاً في هذه المرحلة

245
00:20:21,580 --> 00:20:23,480
!لأكترث أو أهتمّ

246
00:20:27,990 --> 00:20:29,370
أنت تعترض طريقي

247
00:20:29,370 --> 00:20:30,770
!ابتعد

248
00:20:45,370 --> 00:20:47,470
!يجب عليّ إيجاد تووا بسرعة

249
00:20:51,510 --> 00:20:53,550
هذا هو السّلَف صفر إذاً؟

250
00:20:54,000 --> 00:20:56,370
يمكننا إبادتهم جميعاً، صحيح؟

251
00:20:56,370 --> 00:20:57,730
لنقضِ عليهم

252
00:20:58,270 --> 00:21:01,380
نِظام إكستيم، اشتعال

253
00:21:16,940 --> 00:21:19,830
!الدّافع الانفجاريّ إكستيم

254
00:21:21,670 --> 00:21:22,710
!إطلاق

255
00:21:36,680 --> 00:21:38,430
،كما قلتُ

256
00:21:39,210 --> 00:21:42,310
أيّ شيء تفعلينه لا جدوى منه

257
00:21:43,390 --> 00:21:45,590
أنا قويّة

258
00:21:46,070 --> 00:21:48,850
لن أخسر أبداً

259
00:21:49,590 --> 00:21:51,560
أبداً

260
00:23:30,590 --> 00:23:33,840
!امنحيني قوّتكِ

261
00:23:33,840 --> 00:23:35,170
!المُسدّس، جاهز