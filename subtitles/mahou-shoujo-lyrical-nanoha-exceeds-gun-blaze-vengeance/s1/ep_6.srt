1
00:01:32,700 --> 00:01:34,330
سفّاحو الشّيطانيّين

2
00:01:35,070 --> 00:01:38,750
إنّهم مجموعة من الشّيطانيّين الّذين كانوا
نشِطين محلّياً منذ مدّة

3
00:01:39,730 --> 00:01:44,030
هدفهم هو تدمير عقاقير الشّيطانيّين
وطُرُق توزيعها

4
00:01:45,170 --> 00:01:47,840
أقدم أثر لهم يعود إلى أربع سنوات مضت

5
00:01:48,410 --> 00:01:51,500
كانوا يقضون على المجموعات الّتي تبيع عقاقيرنا

6
00:01:53,110 --> 00:01:55,270
أجل، هذا فظيع

7
00:01:55,270 --> 00:01:58,200
،لقد انتشروا لسحق مُوزّعيننا

8
00:01:58,200 --> 00:02:01,630
لذا توزيعنا المحلّي قد دُمِّر بشكل شبه كامل

9
00:02:01,630 --> 00:02:03,640
،إذا كانوا سيُعرقلون مبيعات عقاقيرنا

10
00:02:03,640 --> 00:02:05,890
فهذا يجعلهم عدوّاً لمجال عملك، صحيح؟

11
00:02:05,890 --> 00:02:08,180
لماذا تجاهلتهم؟

12
00:02:08,480 --> 00:02:12,890
لم أكن أهتمّ بصفقات على مُستوى
الشّوارع قبل أربع سنوات

13
00:02:12,890 --> 00:02:15,400
تركتُ المبيعات والإدارة للتُجّار

14
00:02:15,400 --> 00:02:17,840
وذلك كي نبدأ بعيش حياة هانئة

15
00:02:17,840 --> 00:02:23,210
هكذا إذاً، حينئذ بدأت تأخذني
!لخوض رحلات كثيرة

16
00:02:23,400 --> 00:02:28,370
كنّا ندرّ مالاً طائلاً بفضل العقاقير الّتي ابتكرتِها

17
00:02:31,480 --> 00:02:34,450
عندما بدأ ذلك، كانت هذه المرأة فقط

18
00:02:34,450 --> 00:02:38,050
،بدؤوا بالتوسُّع قبل ثلاث سنوات
والآن هناك خمسة منهن

19
00:02:43,870 --> 00:02:45,230
أجل

20
00:02:45,720 --> 00:02:49,280
هذه هي الّتي قلتِ بأنّها كانت مادّة
تجربة في مختبركِ، صحيح؟

21
00:02:49,280 --> 00:02:50,970
أجل، تلك الفتاة

22
00:02:51,440 --> 00:02:53,660
ينبغي أن تكون قد رأيتها أيضاً، إيجي-كن

23
00:02:53,940 --> 00:02:57,030
الفتاة الّتي كانت تستطيع امتصاص
قدرات أولئك الّذين أكلَتْهم

24
00:02:58,870 --> 00:03:00,730
لا أتذكّرها

25
00:03:00,730 --> 00:03:03,310
تخلّصنا منها لأنّها كانت عديمة
الجدوى، أليس كذلك؟

26
00:03:03,310 --> 00:03:04,530
أجل

27
00:03:04,530 --> 00:03:08,700
كانت قوّتها حكراً لها، لذا لم نستطع استخراجها

28
00:03:09,280 --> 00:03:14,550
ثمّة شيء قد حطّمها، لذا بعناها
في مكان ما على ما أعتقد

29
00:03:14,840 --> 00:03:17,180
لكنّها نافعة لنا الآن؟

30
00:03:17,180 --> 00:03:18,290
!هذا صحيح

31
00:03:19,270 --> 00:03:22,800
يبدو أنّ تلك الفتاة قد حصلتْ على قدرة

32
00:03:22,800 --> 00:03:27,750
نقل القوى للآخرين بالإضافة إلى سرقتها

33
00:03:28,550 --> 00:03:30,180
هذا مُدهش

34
00:03:30,180 --> 00:03:34,430
إنّها الطّريقة الوحيدة لتبرير قوّة حليفاتها

35
00:03:34,820 --> 00:03:37,390
،إذا استطعنا الحصول على هذه الفتاة

36
00:03:37,390 --> 00:03:39,680
!فسوف نصبح أقوى فأقوى

37
00:03:40,080 --> 00:03:44,300
إذا تمكّنّا من استخراج قدرتها لنقل
،قوى إلى عقّار، فرائع إذاً

38
00:03:44,300 --> 00:03:45,830
...لكن حتّى لو لم نستطع

39
00:03:46,080 --> 00:03:48,820
نريد أن نستفيد منها لأجلك

40
00:03:48,820 --> 00:03:50,710
!تماماً

41
00:03:51,050 --> 00:03:53,060
،حتّى لو كانت قوّتها فاشلة

42
00:03:53,060 --> 00:03:56,970
شيطانيّة نضجتْ إلى هذا الحدّ
!ستكون شهيّة للأكل

43
00:03:58,040 --> 00:04:00,440
عرفتُ اسمها وخلفيّتها التّاريخيّة

44
00:04:00,940 --> 00:04:02,090
أتريدين سماعها؟

45
00:04:02,460 --> 00:04:03,550
!هذا سريع

46
00:04:03,550 --> 00:04:04,670
!هذا رائع

47
00:04:04,670 --> 00:04:05,720
!كُلّي آذان صاغية

48
00:04:06,010 --> 00:04:08,300
اسمها يورومي تووا

49
00:04:08,300 --> 00:04:12,100
تمّ تبنّيها كيتيمة حرب بواسطة
زوجين مدنيّين

50
00:04:13,330 --> 00:04:18,230
تُوفّي والداها بفعل حريق في مطار
قبل أربع سنوات

51
00:04:18,230 --> 00:04:21,200
أُعلِنَ عن وفاتها غالباً فاختبأت

52
00:04:21,790 --> 00:04:23,930
حريق في مطار؟

53
00:04:23,930 --> 00:04:25,020
هذا

54
00:04:25,940 --> 00:04:28,800
الّتي تخلّصنا منها بالحرق

55
00:04:29,740 --> 00:04:35,090
الفتاة الّتي بعناها للإرهابيّين عندما
لم نعُد بحاجتها

56
00:04:35,090 --> 00:04:38,370
كانت تجربة حرق وإثبات

57
00:04:38,990 --> 00:04:42,590
هذا يعني بأنّكِ قتلتِ هذه المرأة مرّتين

58
00:04:43,130 --> 00:04:44,880
هذا أكثر من دافعٍ كافٍ

59
00:04:44,880 --> 00:04:47,660
لها لتستهدفكِ أنتِ وعقاقير الشّيطانيّين

60
00:04:48,130 --> 00:04:51,250
أنت تُدرك بأنّها مُشكلتك أيضاً، صحيح؟

61
00:04:51,250 --> 00:04:54,760
!نحن صديقان، وقدرانا مُتشابكان

62
00:04:55,020 --> 00:04:56,420
،أعلم ذلك

63
00:04:56,420 --> 00:05:00,170
لكن لا أتخيّلكِ تموتين أو تُهزَمين أصلاً

64
00:05:00,720 --> 00:05:02,280
هذا صحيح

65
00:05:03,520 --> 00:05:07,070
،لديك شيطانيّون يحمونك أيضاً

66
00:05:07,640 --> 00:05:09,280
لكن كُن حذراً، اتّفقنا؟

67
00:05:09,630 --> 00:05:10,590
أجل

68
00:05:11,820 --> 00:05:12,790
...حسناً

69
00:05:12,790 --> 00:05:17,540
،أرغب في إحضار تووا-تشان هذه
!أو أيّاً كانت، إلى مُختبري

70
00:05:17,830 --> 00:05:19,700
!ما زلتُ حيّة

71
00:05:20,040 --> 00:05:21,190
أجل

72
00:05:21,190 --> 00:05:23,310
،أستطيع تعيين ذلك لمُوزّعينا

73
00:05:23,310 --> 00:05:25,370
لكن لنستخدم الشّرطة

74
00:05:25,370 --> 00:05:27,310
الشّرطة؟

75
00:05:27,310 --> 00:05:31,140
هل الشّرطة قادرة على اعتقال
شيطانيّة بهذه القوّة؟

76
00:05:31,140 --> 00:05:32,860
يعتمد الأمر على أسلوبهم المُتّبع

77
00:05:32,860 --> 00:05:37,430
،سأحتاج لجمع مزيد من المعلومات أوّلاً
لكن يستطيعون النّجاح غالباً

78
00:05:37,680 --> 00:05:39,160
!توقّعتُ ذلك

79
00:05:39,160 --> 00:05:40,700
!أنت ذكيٌّ للغاية

80
00:05:40,700 --> 00:05:42,080
انتظري قليلاً فحسب

81
00:05:42,080 --> 00:05:44,680
سأسلّم هذه المرأة لمُختبرنا

82
00:05:45,210 --> 00:05:49,950
للمُختبر الّذي بنيتَه لي، صحيح؟

83
00:05:50,300 --> 00:05:52,450
!شكراً لك يا إيجي-كن

84
00:05:52,450 --> 00:05:53,820
!أُحبّك

85
00:05:54,420 --> 00:05:55,480
أجل

86
00:05:55,480 --> 00:05:56,790
!حسناً

87
00:05:57,460 --> 00:06:01,220
،الآن بعد أن بدأت بتلبية طلبي
!سأعود إلى المُختبر

88
00:06:08,170 --> 00:06:10,460
!حسناً، أتطلّع لذلك

89
00:06:10,460 --> 00:06:11,340
أجل

90
00:06:18,930 --> 00:06:22,610
حتّى 10 سنوات مضتْ، لم يكن لديّ شيء

91
00:06:23,080 --> 00:06:25,860
استُنزِفتُ من العمل المُرهِق في شركتي

92
00:06:25,860 --> 00:06:29,610
واعتُبِرتُ عديم القيمة بسبب
درجاتي ومستوى ثقافتي

93
00:06:30,150 --> 00:06:32,680
وحتّى أ نّني نقلتُ العمل إلى المنزل
،في أيّام عطلتي

94
00:06:32,680 --> 00:06:36,110
مُتدبّراً أمري بكوب رامن وبينتو بنصف القيمة

95
00:06:38,080 --> 00:06:42,130
ثمّ ذات يوم، أُرسلتُ إلى منطقة مُلوّثة
،لاستعادة مرافق عامّة

96
00:06:42,780 --> 00:06:46,410
فالتقيتُ بها

97
00:06:47,130 --> 00:06:49,920
كادت تقتلني بعد ثانيتين من لقائنا

98
00:06:51,180 --> 00:06:52,710
!اللّعنة

99
00:06:58,680 --> 00:07:01,640
ألم تُرِد الموت؟

100
00:07:01,930 --> 00:07:03,580
!بالطّبع لا

101
00:07:04,990 --> 00:07:07,400
وجهك من نوعي المُفضّل، رُبّما

102
00:07:12,880 --> 00:07:16,300
،إن كنتَ مُستعدّاً لفعل ما أطلبه

103
00:07:16,300 --> 00:07:18,280
فلا أُمانع العفو عنك

104
00:07:19,910 --> 00:07:23,110
،كنتُ في الأصل قويّة جدّاً

105
00:07:23,110 --> 00:07:25,540
لكنّني الآن ضعيفة للغاية

106
00:07:26,170 --> 00:07:28,770
يجب عليّ أن آكل كثيراً

107
00:07:29,270 --> 00:07:32,130
،إذا استطعتَ تحضير ذلك لي

108
00:07:32,850 --> 00:07:36,550
...فسيكون من دواعي سروري مُكافأتك

109
00:07:37,120 --> 00:07:38,390
مُكافأتي؟

110
00:07:38,390 --> 00:07:39,890
أنتِ؟ الوحش؟

111
00:07:39,890 --> 00:07:43,650
حالما أستردّ قوّتي، سأتمكّن من فعل أيّ شيء

112
00:07:44,440 --> 00:07:48,160
وحتّى تحقيق مُعظم الأُمنيات

113
00:07:48,880 --> 00:07:53,030
هذه فكرة مُثيرة للاهتمام، لكنّني
على حافّة الموت الآن

114
00:07:53,530 --> 00:07:55,590
وقطعتِ ذراعي أيضاً

115
00:07:55,590 --> 00:07:56,780
لا يسعني فعل الكثير

116
00:07:57,370 --> 00:08:00,530
يمكنني مُشاركة بعض من دمي معك

117
00:08:00,530 --> 00:08:03,170
...قد تموت إذا لم يتوافق معك، لكن

118
00:08:17,330 --> 00:08:18,710
شُفيت

119
00:08:18,710 --> 00:08:21,800
أجل، لأنّني جعلتُك شيطانيّاً بدمي

120
00:08:22,060 --> 00:08:25,800
لكن الآن، التجدُّد هو كُلّ ما يمكنني تقديمه

121
00:08:26,470 --> 00:08:28,560
،كادت هذه الوحش تقتلني

122
00:08:28,560 --> 00:08:30,850
ثمّ أعادتني إلى الحياة

123
00:08:35,900 --> 00:08:37,810
ما اسمكِ؟

124
00:08:37,810 --> 00:08:41,320
شينوميا مانا، أو شيء من هذا القبيل؟

125
00:08:41,970 --> 00:08:45,340
أعتقد هذا ما يطلقونه على مالك هذا الجسد

126
00:08:45,640 --> 00:08:49,080
هذه غالباً طُفيليّة من الأنواع الغازية

127
00:08:49,400 --> 00:08:53,060
إنّها وحشٌ سرقَ جسداً بشريّاً ومعرفته

128
00:08:53,060 --> 00:08:55,430
...أنت كوراغي إيجي

129
00:08:55,430 --> 00:08:56,960
إيجي-كن، صحيح؟

130
00:08:57,260 --> 00:09:00,710
ستعمل لصالحي الآن، اتّفقنا؟

131
00:09:03,020 --> 00:09:05,770
!أريد مزيداً من اللّحم

132
00:09:05,770 --> 00:09:07,150
عندما نعود

133
00:09:07,950 --> 00:09:11,240
لكن الغريب أنّني لم أستطع أن أكرهها

134
00:09:11,530 --> 00:09:13,880
!إيجي-كن! لحم

135
00:09:13,880 --> 00:09:15,910
!أريد أكل مزيد من اللّحم

136
00:09:15,910 --> 00:09:17,910
!وسكاكر أيضاً

137
00:09:17,910 --> 00:09:19,610
!أرجوك، أرجوك-
!نفدت الكمّية كُلّها لدينا-

138
00:09:19,610 --> 00:09:21,240
!هذا كلّ ما لدينا اليوم

139
00:09:21,240 --> 00:09:22,370
!ماذا؟

140
00:09:22,370 --> 00:09:26,490
الطّعام اللّذيذ يُكلّف مالاً، وأنا لا أملك ذلك

141
00:09:26,810 --> 00:09:29,550
سأشتري لكِ طبقاً من لحم العجل غداً

142
00:09:38,160 --> 00:09:41,880
...أتمنّى أن يموت أولئك الحمقى في شركتي

143
00:09:46,740 --> 00:09:49,490
!إيجي-كن، استيقظ

144
00:09:54,420 --> 00:09:56,030
!إنّه بعد الظّهر؟

145
00:09:56,280 --> 00:09:58,290
!تبّاً، استغرقتُ في النّوم؟

146
00:09:59,830 --> 00:10:01,990
!أحضرتُ مالاً لنا

147
00:10:02,280 --> 00:10:04,020
هل سيَفي هذا؟

148
00:10:05,660 --> 00:10:10,900
،اليوم، هوجِمت خزينة بنك دايسان
وسُرِق 200 مليون ين

149
00:10:10,900 --> 00:10:11,750
—وقعتْ عمليّة السّطو

150
00:10:11,750 --> 00:10:15,460
ليس عليك العمل إن لم تملك مالاً، صحيح؟

151
00:10:15,460 --> 00:10:16,920
—هذا صحيح، لكن

152
00:10:17,140 --> 00:10:19,830
وأيضاً، أتتذكّر كيف كنتَ تقول بأنّك تتمنّى

153
00:10:19,830 --> 00:10:22,180
موت كافّة الأشخاص في شركتك؟

154
00:10:22,940 --> 00:10:23,920
،حسناً

155
00:10:24,620 --> 00:10:27,120
!قتلتُهم جميعاً لأجلك

156
00:10:27,930 --> 00:10:31,200
!عملتُ بجدّ! ألست فخوراً؟

157
00:10:31,200 --> 00:10:35,820
الآن ليس عليك الذّهاب إلى تلك
الشّركة بعد الآن، صحيح؟

158
00:10:35,820 --> 00:10:39,450
لذا هل ستقضي وقتاً أطول معي بدلاً من ذلك؟

159
00:10:39,740 --> 00:10:42,460
!دعني آكل طعاماً لذيذاً

160
00:10:50,620 --> 00:10:53,540
،هذا الشّيء ليس بشريّاً حتماً

161
00:10:54,150 --> 00:10:55,300
...لكن

162
00:10:55,950 --> 00:10:58,800
استمتعتُ بمُجاورتها

163
00:10:59,390 --> 00:11:03,760
قاتلتُ شيطانيّاً آخر وخسرت

164
00:11:04,170 --> 00:11:07,100
،كنتُ واهنة وعلى حافّة الموت

165
00:11:07,100 --> 00:11:09,420
فأتيت وأنقذتني

166
00:11:09,720 --> 00:11:12,170
تقصدين بأنّكِ حاولتِ قتلي وأكلي

167
00:11:12,170 --> 00:11:13,810
!قلتُ بأنّني آسفة

168
00:11:14,230 --> 00:11:16,070
هل تريدين أن تصبحي أقوى ثانية؟

169
00:11:17,080 --> 00:11:18,320
أريد ردّ الاعتبار

170
00:11:18,950 --> 00:11:21,950
التّفكير في الشّيء الّذي كاد يقتلني

171
00:11:21,950 --> 00:11:24,320
يدفعني للجنون أحياناً

172
00:11:24,650 --> 00:11:29,090
أحتاج فقط لأكل كثير من الشّيطانيّين
الأقوياء ودمجهم بي

173
00:11:29,700 --> 00:11:31,830
،فعلتُ ذلك بضع مرّات إلى الآن

174
00:11:32,260 --> 00:11:35,330
لكن البحث عنهم وهزيمتهم مُزعج

175
00:11:37,950 --> 00:11:42,150
هل تريدينني أن أنشئ نظاماً يساعدكِ
في أن تصبحي أقوى؟

176
00:11:42,150 --> 00:11:43,360
!حقّاً؟

177
00:11:44,130 --> 00:11:46,520
كان العالم السّفليّ يجري بحثاً

178
00:11:46,520 --> 00:11:50,310
حول استخدام نسيج الأنواع الغازية
لصنع شيطانيّين

179
00:11:50,860 --> 00:11:54,260
لذا استأجرتُ أُناساً وأحطتُ نفسي بباحثين

180
00:11:54,740 --> 00:11:59,060
استخدمنا مواداً من الغُزاة والشّيطانيّين
،الّذين هزمَتْهم مانا

181
00:11:59,060 --> 00:12:01,720
لإنشاء عقاقير الشّيطانيّين الأمثل والأعظم

182
00:12:02,320 --> 00:12:06,940
عقاقير الشّيطانيّين الّذين تداولناها في العالم
،السّفليّ خلقتْ سوقاً كُبرى

183
00:12:07,280 --> 00:12:12,540
وبدأت تتدفّق أموال طائلة إليّ
بصفتي المُدير والمُنتِج

184
00:12:13,360 --> 00:12:17,280
الأنواع الغازية الشّبيهة بالإنسان والّتي أنشأتها
مانا تُعوّض عن أيّ نقص في القوّة العاملة

185
00:12:18,350 --> 00:12:20,200
سأستخدم هذه الأشياء

186
00:12:21,040 --> 00:12:24,300
ليسوا بحاجة راحة أو أجر، ولا يعصون الأوامر

187
00:12:24,700 --> 00:12:26,550
إنّهم الأتباع المثاليّون

188
00:12:27,380 --> 00:12:28,310
...ثُمّ

189
00:12:28,580 --> 00:12:31,560
اختارتْ مانا الشّيطانيّين الموهوبين
،الّذين صنعناهم بالعقّار

190
00:12:31,560 --> 00:12:35,320
،وأكلتْ أكثر الّذين ينفعونها

191
00:12:35,320 --> 00:12:37,840
لتُعزِّز قوّتَها بكفاءة

192
00:12:38,420 --> 00:12:41,400
متى ذكرتُ بأنّني أريد شيئاً
،أو أريد فعل شيء

193
00:12:41,820 --> 00:12:46,210
!تُحقّقه أنت وأتباعك لأجلي

194
00:12:46,500 --> 00:12:49,160
!أنت الأفضل يا إيجي-كن

195
00:12:50,570 --> 00:12:54,030
هناك أشخاص يريدون عقّار الشّيطانيّين
وشيطانيّون يطيعون الأوامر

196
00:12:54,030 --> 00:12:57,140
ضمن الصّفوف العليا في سلك الشّرطة
والحكومة كذلك

197
00:12:58,140 --> 00:13:00,660
لستُ مُهتمّاً بهذا العالم

198
00:13:01,060 --> 00:13:04,510
سرعان ما سئمتُ المال والنّساء والنّفوذ

199
00:13:05,600 --> 00:13:07,180
!إيجي-كن

200
00:13:11,120 --> 00:13:16,690
لكن حاليّاً، أنا الوحيد الّذي يستطيع
،جعل ذلك الشّيء سعيداً

201
00:13:17,040 --> 00:13:19,170
لذا سأواظب على الأمر لمدّة من الزّمن

202
00:13:23,570 --> 00:13:24,440
ماذا؟

203
00:13:24,440 --> 00:13:26,310
هل تووا-تشان قد خرجت؟

204
00:13:26,310 --> 00:13:27,240
أجل

205
00:13:27,240 --> 00:13:30,700
،قالت بأنّ لديها عمل في المدرسة
ثمّ لقاء مع صديق

206
00:13:30,700 --> 00:13:32,380
من؟

207
00:13:32,380 --> 00:13:33,950
وسيط معلومات؟

208
00:13:33,950 --> 00:13:34,840
لا شيء من هذا القبيل

209
00:13:34,840 --> 00:13:36,500
مُجرّد صديق

210
00:13:38,320 --> 00:13:41,260
لدى تووا-تشان صديق؟ بجدّية؟

211
00:13:41,260 --> 00:13:42,970
!هذا ليس عدلاً يا يوزو

212
00:13:42,970 --> 00:13:44,640
!أخبرَتْكِ، أليس كذلك؟

213
00:13:45,270 --> 00:13:47,950
بدتْ تووا-تشان سعيدة مُؤخّراً

214
00:13:47,950 --> 00:13:50,640
كلّما تفقّدتْ هاتفها النقّال من وقت لآخر

215
00:13:50,640 --> 00:13:51,690
!أليس كذلك

216
00:13:51,690 --> 00:13:53,020
!لكن لم أستطع سؤالها عن ذلك

217
00:13:53,340 --> 00:13:55,820
وعدتُ بأن أحتفظ بذلك سرّاً

218
00:13:55,820 --> 00:13:57,800
!من يأبه؟ أخبرينا فحسب

219
00:13:57,800 --> 00:13:59,310
!لن نُخبر أحداً

220
00:13:59,310 --> 00:14:00,730
حسناً، هذا يكفي

221
00:14:01,250 --> 00:14:04,780
،تحتاج تووا-سان لخصوصيّتها أيضاً
بالإضافة إلى فُرصة للاسترخاء

222
00:14:04,780 --> 00:14:06,740
لا ينبغي أن تتطفّلا

223
00:14:07,270 --> 00:14:08,730
حسناً

224
00:14:09,260 --> 00:14:13,600
لكن أحتاج دعماً أفضل لتووا-سان

225
00:14:13,600 --> 00:14:15,030
أنا أيضاً

226
00:14:15,030 --> 00:14:17,090
كلتاكما تفعلان ذلك أصلاً

227
00:14:17,090 --> 00:14:19,920
بخلافي أنا، تُساهمان بشكل
مُباشر في المعركة

228
00:14:20,230 --> 00:14:21,960
...قد يكون هذا صحيحاً، لكن

229
00:14:24,660 --> 00:14:27,290
،أنا مَدينة لها بإنقاذي

230
00:14:29,170 --> 00:14:32,960
وأستطيع أن أفهم شعور تووا-تشان بالحزن

231
00:14:32,960 --> 00:14:34,100
أجل

232
00:14:34,100 --> 00:14:37,830
كُلّ ما في الأمر هو أنّ تووا-تشان
ما زالت لا تعتبرنا

233
00:14:37,830 --> 00:14:41,180
حليفات وصديقات

234
00:14:41,570 --> 00:14:44,350
إنّها تعتبرنا جِراء بالتبنّي أو ما شابه

235
00:14:44,350 --> 00:14:45,940
أجل، هذا

236
00:14:45,940 --> 00:14:49,570
حسناً، لا ننكر بأنّها تعتني بنا جيّداً

237
00:14:49,570 --> 00:14:52,580
...قد يكون كذلك بالفعل، لكن رغم هذا

238
00:14:58,720 --> 00:14:59,910
نعتمد عليكِ

239
00:14:59,910 --> 00:15:00,980
بالتّوفيق

240
00:15:03,880 --> 00:15:06,250
،منذ التقيتُ بفرقة الأمم المُتّحدة تلك

241
00:15:06,250 --> 00:15:09,220
من المُمكن أنّ شخصاً يُنقّب عن معلومات
حولنا، بما في ذلك أنا

242
00:15:09,850 --> 00:15:12,080
ينبغي أن أتجنّب ترك آثار أقدام

243
00:15:12,080 --> 00:15:15,760
يمكنني نقلنا إلى قاعدة خارج البلاد
وأخذ إذن غياب من المدرسة

244
00:15:19,130 --> 00:15:24,550
قد أضطرّ للإحجام عن التّواصل مع شينا واللّقاء بها

245
00:15:28,230 --> 00:15:29,370
!شينا

246
00:15:29,770 --> 00:15:31,610
!تووا

247
00:15:31,610 --> 00:15:34,020
أنا آسفة. هل تأخّرتُ عليكِ؟

248
00:15:34,020 --> 00:15:38,280
لا، تمشّيتُ سريعاً لأنّني أنجزتُ
أموري في العمل باكراً

249
00:15:38,280 --> 00:15:39,390
حقّاً؟

250
00:15:39,390 --> 00:15:40,550
هل سمعتِ؟

251
00:15:40,550 --> 00:15:43,980
التقطتُ صورة قبل ثانية عندما كنّا نتكلّم

252
00:15:43,980 --> 00:15:45,570
!انظري هناك يا ت ووا

253
00:15:48,040 --> 00:15:49,300
حسناً، حسناً

254
00:15:49,300 --> 00:15:51,060
...تلك القطّة

255
00:15:51,060 --> 00:15:53,430
!أجل، إنّها نفسها الّتي أنقذتِها من قبل

256
00:15:53,780 --> 00:15:55,920
كانت حيواناً مُروّضاً لأحدهم إذاً

257
00:15:56,240 --> 00:15:58,120
قالوا بأنّها هربت

258
00:15:59,150 --> 00:16:00,840
هل أردتِ قول شيء لها أيضاً؟

259
00:16:02,220 --> 00:16:04,830
سمعتُ بأنّكِ أنتِ من أنقذها

260
00:16:05,190 --> 00:16:07,710
أنا مُمتنّة لأجلك بصراحة

261
00:16:08,420 --> 00:16:10,250
!شكراً جزيلاً

262
00:16:10,940 --> 00:16:11,880
العفو

263
00:16:11,880 --> 00:16:13,250
أنا مسرورة لأنّ جميعكم بأمان

264
00:16:16,700 --> 00:16:17,780
!وداعاً

265
00:16:17,780 --> 00:16:19,200
!إلى اللّقاء

266
00:16:20,280 --> 00:16:22,230
حسناً، هل نذهب؟

267
00:16:22,230 --> 00:16:23,200
أجل

268
00:16:50,740 --> 00:16:52,690
يبدو النّسيم عليلاً، أليس كذلك؟

269
00:16:52,690 --> 00:16:55,230
أجل، الجوّ يزداد برودة

270
00:16:56,250 --> 00:16:57,430
...اسمعي

271
00:16:57,430 --> 00:17:02,080
حدثت بعض الأمور، لذا سأغادر إلى خارج
البلاد لبعض الوقت

272
00:17:02,490 --> 00:17:06,140
قد لا أتمكّن من رؤيتكِ لبعض الوقت

273
00:17:06,870 --> 00:17:08,160
هكذا إذاً

274
00:17:08,980 --> 00:17:10,250
كم المدّة؟

275
00:17:10,530 --> 00:17:11,990
لا أعلم

276
00:17:11,990 --> 00:17:14,050
لكن لن أغيب طوال الوقت

277
00:17:14,050 --> 00:17:15,970
سأعود إلى الدّيار من وقتٍ لآخر

278
00:17:15,970 --> 00:17:18,510
!يسرّني سماع ذلك

279
00:17:18,510 --> 00:17:21,000
!إذاً لنخرج معاً عندما تعودين إلى الدّيار

280
00:17:21,290 --> 00:17:23,800
!سأُخصّص وقتاً في جدولي

281
00:17:25,240 --> 00:17:28,160
لديكِ مدرسة وعملكِ الخاصّ أيضاً، صحيح؟

282
00:17:28,160 --> 00:17:29,880
!سأتدبّر الأمر

283
00:17:29,880 --> 00:17:32,000
!لأنّني أريد الخروج معكِ أيضاً

284
00:17:33,230 --> 00:17:34,460
شكراً

285
00:17:39,100 --> 00:17:42,420
هل يمكنني أن أتصرّف بدلال لبعض الوقت؟

286
00:17:42,420 --> 00:17:43,710
قدر ما تشائين

287
00:17:48,570 --> 00:17:52,740
أنا متأكّدة بأنّه سيكون السّفر إلى خارج
البلاد شاقّاً، لكن اصمدي

288
00:17:52,740 --> 00:17:54,300
سوف أشجّعكِ

289
00:17:54,300 --> 00:17:55,560
شكراً

290
00:17:56,740 --> 00:17:58,660
هل سمعتِ الأخبار؟

291
00:17:58,660 --> 00:18:01,550
قالوا بأنّ أنواعاً غازية خطيرة قد هُزِمت

292
00:18:01,870 --> 00:18:06,060
يبدو أنّ جماعة الأُمم المُتّحدة يعملون بجدّ

293
00:18:07,050 --> 00:18:09,160
رغم أنّني أنا من فعل ذلك

294
00:18:10,530 --> 00:18:15,930
هل تعتقدين بأنّنا سنرى يوماً عالَماً بلا
أنواع غازية وشيطانيّين؟

295
00:18:16,770 --> 00:18:19,570
سيكون الأمر صعباً، لكن أعتقد بأنّنا سنفعل

296
00:18:19,570 --> 00:18:24,220
لكن الأُمم المُتّحدة والشّرطة وأولئك
الّذين تحت الأضواء

297
00:18:24,220 --> 00:18:28,820
لا يبدون أي اهتمام بقتل الشّيطانيّين
لعائلاتنا، أليس كذلك؟

298
00:18:29,210 --> 00:18:34,430
في مكانٍ ما، يُقتَل شخص آخر بواسطة
شيطانيّ دون معرفة أحد

299
00:18:36,160 --> 00:18:42,890
أتعجّب وأسأل نفسي كيف آلت
الأمور إلى هذا

300
00:18:45,290 --> 00:18:47,060
،لا أعلم

301
00:18:47,060 --> 00:18:49,340
لكن لا يمكننا تغيير حقيقة أنّه كذلك

302
00:18:49,930 --> 00:18:53,470
كلّ ما يمكننا فعله هو بذل قصارى
جهدنا بالإمكانيّات المُتاحة لدينا

303
00:18:55,670 --> 00:18:58,290
أنا آسفة، لم أقصد وضعكِ في موقف مُحرج

304
00:18:58,290 --> 00:18:59,170
!ماذا؟

305
00:18:59,170 --> 00:19:01,350
!أنا بخير تماماً

306
00:19:01,350 --> 00:19:03,220
هذا غريب

307
00:19:03,220 --> 00:19:05,990
لا أعبِّر عن هذه الشّكاوى في العادة

308
00:19:05,990 --> 00:19:07,460
!لا عليكِ، لا عليكِ

309
00:19:07,460 --> 00:19:08,630
!قولي ما تشائين

310
00:19:08,970 --> 00:19:10,840
نحن صديقتان، صحيح؟

311
00:19:13,150 --> 00:19:15,300
أنا سعيدة لأنّكِ تعتمدين على دعمي

312
00:19:15,300 --> 00:19:17,380
!عندما يصيبكِ مكروه أو أمر مُحزن

313
00:19:18,620 --> 00:19:19,970
شكراً

314
00:19:20,990 --> 00:19:22,510
هذه هي

315
00:19:22,510 --> 00:19:26,990
إنّ هذه الفتاة رمز يُجسّد العالم
الّذي لم أستطع حمايته

316
00:19:27,310 --> 00:19:29,630
لهذا السّبب هي مُبهرة وعزيزة

317
00:19:30,650 --> 00:19:34,250
إذا كانت معركتي تستطيع حماية
...ابتسامتها، فإذاً

318
00:19:35,560 --> 00:19:40,530
أريد أكل كثير من الطّعام الشّهيّ والخروج
معكِ أيضاً يا شينا

319
00:19:41,040 --> 00:19:44,680
!أنتِ ظريفة للغاية يا تووا

320
00:19:46,930 --> 00:19:48,980
أنا متأكّدة بأنّكِ ستكونين بخير

321
00:19:49,370 --> 00:19:51,700
،أنتِ قويّةٌ ولطيفة

322
00:19:51,700 --> 00:19:53,640
لذا أعلم بأنّكِ تستطيعين تجاوز أي عقبة

323
00:19:55,820 --> 00:19:56,740
أجل

324
00:19:59,060 --> 00:20:02,150
،أتشوّق للاستمتاع معكِ من جديد

325
00:20:02,150 --> 00:20:03,720
!لذا سأبذل ما بوسعي في العمل

326
00:20:03,720 --> 00:20:04,490
أجل

327
00:20:04,490 --> 00:20:06,150
اعملي بجدّ يا شينا

328
00:20:14,090 --> 00:20:15,640
حالة طارئة

329
00:20:16,430 --> 00:20:21,200
تمّ رصد غازٍ بالقرب من المدخل
الجنوبيّ للحديقة

330
00:20:24,290 --> 00:20:27,150
أيُّها الزّوار، الرّجاء الالتزام بأوامر
الإخلاء والخروج من الحديقة

331
00:20:27,150 --> 00:20:29,030
بطريقة هادئة ومُنظَّمة

332
00:20:31,200 --> 00:20:32,280
حالة طارئة

333
00:20:32,280 --> 00:20:33,630
غازٍ؟

334
00:20:34,440 --> 00:20:35,990
في وسط البلدة؟

335
00:20:36,480 --> 00:20:38,780
...ليتني أستطيع الاستجابة له

336
00:20:40,410 --> 00:20:41,590
!لكن تووا هنا أيضاً

337
00:20:41,590 --> 00:20:43,970
!الأولويّة لتأمين السّلامة لشينا

338
00:20:44,800 --> 00:20:47,060
...حالما أُرافق تووا إلى مركز الإخلاء

339
00:20:50,540 --> 00:20:51,990
!لنُخلِ

340
00:21:12,040 --> 00:21:13,120
!حضرة المُدير

341
00:21:13,120 --> 00:21:15,380
!هذه حالة تتطلّب انتشاراً طارئاً

342
00:21:15,380 --> 00:21:18,360
،أنواع غازية قويّة، أو ربّما شيطانيّون

343
00:21:18,360 --> 00:21:20,250
ظهروا في حيّ سكنيّ

344
00:21:20,520 --> 00:21:22,490
نانوها-تشان، هل يمكنكِ التّعبئة؟

345
00:21:22,770 --> 00:21:24,250
!أنا في طريقي بالفعل

346
00:21:25,280 --> 00:21:26,520
...بالإضافة إلى ذلك

347
00:21:49,660 --> 00:21:51,230
!سأقتلك

348
00:23:30,560 --> 00:23:32,280
يجب عليّ قتلها

349
00:23:32,280 --> 00:23:34,180
!يجب أن أفعلها في أسرع وقت

350
00:23:34,180 --> 00:23:35,230
تووا...؟