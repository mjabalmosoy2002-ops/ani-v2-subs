1
00:00:15,970 --> 00:00:16,980
شينوميا ما زلت

2
00:00:20,630 --> 00:00:22,140
على قيد الحياة؟

3
00:00:23,260 --> 00:00:26,190
جسدها السّفليّ ولوامسها
،كانوا يستهدفونك

4
00:00:26,190 --> 00:00:28,020
لكن تخلّصتُ منهم

5
00:00:29,520 --> 00:00:30,970
شكراً

6
00:00:30,970 --> 00:00:35,340
لكن جسدها العلويّ هربَ قبل
أن أوجّه الضّربة القاضية

7
00:00:36,750 --> 00:00:38,190
يجب علينا إيجادها

8
00:00:39,750 --> 00:00:41,670
!نانو-تشان، فاي-تشان

9
00:00:41,670 --> 00:00:43,830
شينا-سان! هل أنتِ بخير؟

10
00:00:43,830 --> 00:00:45,040
بعض الشّيء

11
00:00:45,040 --> 00:00:46,010
ماذا عنكما؟

12
00:00:46,480 --> 00:00:48,650
،أبدنا زيرو

13
00:00:48,650 --> 00:00:50,610
لكن ثمّة أمر غريب

14
00:00:51,020 --> 00:00:52,550
أنا آسفة لما حدث من ناحيتي

15
00:00:52,550 --> 00:00:54,320
أفلتتْ شينوميا منّي

16
00:01:09,670 --> 00:01:14,100
قيل لي بأنّ شينوميا رفضت التّعاون
معنا في البحث وهربت

17
00:01:14,910 --> 00:01:17,800
بدأ زيرو يخرج عن السّيطرة

18
00:01:18,200 --> 00:01:20,180
هل يمكنك إيقافها لأجلنا؟

19
00:01:21,910 --> 00:01:27,070
أنت وشينوميا ستخضعان لتحقيق رسميّ

20
00:01:27,070 --> 00:01:31,930
وكذلك تعاملاتك مع كبار ضبّاط الشّرطة
الّذين استخدموا عقاقيرك الشّيطانيّة

21
00:01:31,930 --> 00:01:34,360
ستُتَّهم لِقاء جرائمك

22
00:01:34,360 --> 00:01:37,010
—لذا أيّ ضرر إضافيّ سوف

23
00:01:37,010 --> 00:01:40,170
تقترحين بأن أتعاون مع اعتقال
مانا لأنّه لا جدوى من عدم فعل ذلك؟

24
00:01:41,220 --> 00:01:42,200
أجل

25
00:01:42,940 --> 00:01:44,950
ولِمَ أفعل ذلك؟

26
00:01:45,510 --> 00:01:49,910
لا أملك أيّ شيء أريد حمايته
على حساب خيانتها

27
00:01:50,810 --> 00:01:52,630
...هل شينوميا

28
00:01:52,630 --> 00:01:54,310
هل هي...؟

29
00:01:58,560 --> 00:02:01,100
إنّها وحشٌ خطيرٌ وعنيف

30
00:02:01,100 --> 00:02:03,290
إنّها أنانيّة وطائشة

31
00:02:05,140 --> 00:02:08,480
ومع ذلك هي صادقة بعض
الشّيء بشأن حلمها

32
00:02:12,410 --> 00:02:14,490
!هذا مُمتع

33
00:02:14,490 --> 00:02:16,330
!أنا سعيدةٌ للغاية

34
00:02:18,110 --> 00:02:20,620
!يعزو كُلّ الفضل لك يا إيجي-كن

35
00:02:20,620 --> 00:02:22,970
!هذا هو إيجي-كن الّذي أعرفه

36
00:02:22,970 --> 00:02:25,170
!أنت أعزّ صديق لي

37
00:02:26,780 --> 00:02:30,020
لديها ابتسامة بريئة رغم شرورها

38
00:02:32,280 --> 00:02:34,230
إنّها شريكتي في الجريمة فحسب

39
00:02:36,630 --> 00:02:39,540
سوف أقيّده الآن

40
00:02:39,540 --> 00:02:40,990
راقبوه من فضلكم

41
00:02:46,640 --> 00:02:50,120
!هذا مُؤلم

42
00:02:50,900 --> 00:02:53,250
جروحي لا تُشفَى

43
00:02:53,250 --> 00:02:56,590
سرقتْ كُلّ القوّة الّتي خزّنتُها

44
00:02:58,640 --> 00:03:02,160
!لكن... لم ينتهِ هذا الأمر بعد

45
00:03:02,430 --> 00:03:08,560
حالما أعود إلى إيجي-كن، سيكتشف
!حُلّاً لأجلي

46
00:03:08,560 --> 00:03:14,190
لكن عليّ أن أستعيد بعض
القوّة قبل ذلك الحين

47
00:03:22,680 --> 00:03:27,430
مجموعة الأُمم المُتّحدة تلك مُتمركزة
حول الشّجيرة الّتي زرعتُها

48
00:03:27,430 --> 00:03:29,050
!لسوء حظّكم

49
00:03:29,050 --> 00:03:33,440
الجسد الرّئيسيّ لنباتي المُؤصَّص
!الظّريف موجود هنا

50
00:03:34,170 --> 00:03:36,020
!النّبات المُؤصَّص

51
00:03:36,020 --> 00:03:38,930
!امنحني القوّةَ ثانية

52
00:03:45,730 --> 00:03:49,130
!هذه هي، هذه هي، هذه هي

53
00:03:50,790 --> 00:03:52,970
!جروحي تُشفى تماماً

54
00:03:52,970 --> 00:03:55,710
!يُراودني شعور رائع

55
00:03:55,950 --> 00:04:00,580
سأحصل على قوّة سيتسونا
!وأقوم بأسر تووا-تشان أيضاً

56
00:04:00,580 --> 00:04:02,960
!لا حدود لأحلامي

57
00:04:02,960 --> 00:04:05,270
تعديل البذور؟

58
00:04:05,270 --> 00:04:07,020
!لا جدوى من ذلك

59
00:04:07,020 --> 00:04:10,710
!أحتاج لأصبح أقوى فأقوى

60
00:04:11,560 --> 00:04:12,750
ماذا؟

61
00:04:12,750 --> 00:04:15,220
لا أستطيع امتصاصها؟

62
00:04:17,730 --> 00:04:19,190
!لحظة؟

63
00:04:19,190 --> 00:04:21,530
!لماذا يمتصّني؟

64
00:04:24,740 --> 00:04:26,180
!لا أستطيع إيقافه

65
00:04:26,180 --> 00:04:27,900
!لا، لا

66
00:04:27,900 --> 00:04:29,940
!إنّه يأخذ قدرتي أيضاً

67
00:04:29,940 --> 00:04:34,050
!هذا يعني بأنّ زيرو يلتهمني أيضاً

68
00:04:34,050 --> 00:04:35,840
!لا

69
00:04:35,840 --> 00:04:41,260
!لا أريد هذا

70
00:04:51,480 --> 00:04:55,340
ما الخطأ الّذي ارتكبتُه؟

71
00:04:56,000 --> 00:04:58,830
لا أستطيع فعل شيء
إن لم أُصبح أقوى

72
00:04:59,140 --> 00:05:01,900
لا أستطيع فعل شيء لأحد

73
00:05:02,340 --> 00:05:06,990
عندما كنتُ ضعيفة، لم أستطع
...فعل شيء، لكن

74
00:05:07,620 --> 00:05:11,880
!إيجي-كن، أنقذني

75
00:05:31,850 --> 00:05:33,060
ما هذا؟

76
00:05:34,840 --> 00:05:36,680
!السّلَف زيرو؟

77
00:05:46,460 --> 00:05:48,740
هنا مركز قيادة فرع أقصى الشّرق

78
00:05:49,280 --> 00:05:53,830
تأكّدنا من وجود مُتحوِّر مُفاجئ
للسّلَف زيرو في القطب الجنوبيّ

79
00:05:54,350 --> 00:05:56,940
الأجزاء الّتي اخترقت السّطح
هي خراطيم قذف

80
00:05:56,940 --> 00:06:00,490
يبدو أنّ هدف العضو الحيويّ هو
إطلاق ونثر بذور وبيوض

81
00:06:00,840 --> 00:06:02,520
ما هو نِطاق النّثر؟

82
00:06:02,520 --> 00:06:05,300
سيصل إلى نصف الكُرة الأرضيّة
الجنوبيّ بأكمله خلال أسبوع

83
00:06:05,300 --> 00:06:09,550
بحسب الكمّية المُطلَقة، قد يصل
إلى العالم بأسره حتّى

84
00:06:10,190 --> 00:06:11,550
هنا ياغامي من المقرّ الرّئيسيّ

85
00:06:12,080 --> 00:06:15,780
يُشارك مقرُّنا حاليّاً معلومات
مع كُلّ فرع

86
00:06:16,380 --> 00:06:19,020
،إذا بدأ مُتحوِّر زيرو هذا بالتّكاثر

87
00:06:19,020 --> 00:06:21,340
فسيُسبّب كارثةً عالميّة

88
00:06:21,720 --> 00:06:24,360
هل ترغبين في طلب انتشار فُرسانك؟

89
00:06:24,360 --> 00:06:25,780
أجل، من فضلك

90
00:06:32,200 --> 00:06:34,280
!كُلّ ما علينا هو تنظيف المكان هنا أوّلاً

91
00:06:38,820 --> 00:06:41,160
شينوميا في الدّاخل

92
00:06:41,160 --> 00:06:43,410
تقصدين بأنّها تتحكّم به؟

93
00:06:43,410 --> 00:06:46,710
لا، قد تمّ امتصاص شينوميا غالباً

94
00:06:47,030 --> 00:06:49,350
إرادتها ووعيها ينبغي أن تزولا

95
00:07:00,270 --> 00:07:04,630
لا يمكننا السّماح لمُفترسين أمثالنا
بازدياد عددهم كثيراً

96
00:07:05,270 --> 00:07:07,510
القوّة الفائضة هي أمرٌ سيّئ أيضاً

97
00:07:08,320 --> 00:07:11,140
لأنّ الوحدة في عالمٍ لا يوجد فيه أحد

98
00:07:11,730 --> 00:07:13,630
ستكون مُحزِنة حقّاً

99
00:07:17,820 --> 00:07:20,900
أظنّني قادرة على منع ذلك

100
00:07:22,180 --> 00:07:23,780
لا، هذا ليس صحيحاً

101
00:07:23,780 --> 00:07:25,980
يجب عليّ منع ذلك

102
00:07:27,610 --> 00:07:29,340
إذاً لنذهب معاً

103
00:07:29,880 --> 00:07:31,340
—لا، ينبغي لكِ

104
00:07:31,340 --> 00:07:34,020
شينوميا هي الّتي كنتُ أطاردها

105
00:07:34,020 --> 00:07:36,590
بالإضافة إلى ذلك، لستِ
في أحسن حال، صحيح؟

106
00:07:37,020 --> 00:07:40,860
تبدين غير مُستقرّة بتاتاً، وكأنّكِ
قد تنكسرين في أيّ لحظة

107
00:07:41,260 --> 00:07:42,860
لذا سنذهب معاً

108
00:07:42,860 --> 00:07:45,230
سأدعمكِ

109
00:07:46,320 --> 00:07:47,280
حسناً

110
00:07:48,760 --> 00:07:51,040
مرحباً؟

111
00:07:51,040 --> 00:07:53,490
كوزي شينا تتكلّم، من فرع أقصى الشّرق

112
00:07:53,490 --> 00:07:54,530
كوزي-سان؟

113
00:07:54,980 --> 00:07:55,950
نعم

114
00:07:55,950 --> 00:07:59,570
أنا مُتوجِّهة إلى الجسد الرّئيسيّ
للسّلَف زيرو

115
00:07:59,570 --> 00:08:02,130
!لا، أنا وكوزي سيتسونا

116
00:08:02,130 --> 00:08:06,760
ويورومي تووا-سان سوف تُساعدني
في عمليّة الإبادة

117
00:08:07,140 --> 00:08:08,640
!اعتمدوا علينا رجاء

118
00:08:10,640 --> 00:08:11,690
!سجن الجليد

119
00:08:21,280 --> 00:08:24,060
القوّة الّتي تلقّيتُها من سيتسونا

120
00:08:24,060 --> 00:08:28,250
هي قوّة إبادة أيّ شيء من بذرة
إلى شخص خطير

121
00:08:29,180 --> 00:08:35,590
غايتها قتل الآخرين من بَني جنسها
لمنع أيّ مُفترس

122
00:08:36,560 --> 00:08:39,430
من تدمير النِّظام البيئيّ والعالم بأسره

123
00:08:40,570 --> 00:08:42,680
،هذا مُحزنٌ للغاية

124
00:08:42,680 --> 00:08:44,210
!مُسدّس، جاهز

125
00:08:47,410 --> 00:08:50,640
لكن أنا متأكِّدة بأنّها قوّةٌ لطيفةٌ أيضاً

126
00:08:51,850 --> 00:08:53,780
!سأتولّى أمر الخراطيم

127
00:08:53,780 --> 00:08:55,180
!تولّي أنتِ الجسدَ الرّئيسيّ

128
00:08:55,450 --> 00:08:56,430
!أجل

129
00:09:22,090 --> 00:09:23,660
!لم أنتهِ بعد

130
00:09:31,340 --> 00:09:32,460
!أجل

131
00:09:35,810 --> 00:09:36,710
!ثلاثة

132
00:09:37,350 --> 00:09:38,470
!اثنان

133
00:09:38,780 --> 00:09:39,730
!واحد

134
00:09:40,130 --> 00:09:43,800
!هيّا

135
00:10:07,500 --> 00:10:08,740
!مُدهش

136
00:10:08,740 --> 00:10:10,240
!هل نلتُما منه؟

137
00:10:10,750 --> 00:10:12,510
!أنا آسفة، ليس بعد

138
00:10:14,070 --> 00:10:15,730
دخلَ الجسدُ الرّئيسيّ إلى تحت الأرض

139
00:10:16,510 --> 00:10:18,570
يجب عليّ إسقاطه

140
00:10:18,570 --> 00:10:21,480
!...رغم أنّ الخراطيم في السّطح تظلّ

141
00:10:37,010 --> 00:10:38,770
!آسفة لو تأخّرت

142
00:10:39,160 --> 00:10:41,380
!نانو-تشان، فاي-تشان

143
00:10:42,750 --> 00:10:46,310
!انتهينا من إعادة زيرو إلى مكانه

144
00:10:47,780 --> 00:10:49,900
هل يمكنني ترك السّطح على عاتقكما؟

145
00:10:49,900 --> 00:10:53,510
!سنسحق الجسدَ الرّئيسيّ تحت الأرض

146
00:10:53,510 --> 00:10:54,670
!عُلِم

147
00:10:54,670 --> 00:10:56,030
!افعلا رجاء

148
00:10:56,640 --> 00:10:59,360
هيّا بنا يا تووا. تمسّكي بي

149
00:10:59,360 --> 00:11:00,020
حسناً

150
00:11:04,300 --> 00:11:07,060
قوّة سيتسونا لقتل بَني جلدها

151
00:11:07,060 --> 00:11:09,870
هي قوّةٌ تختفي عندما لا تعود مطلوبة

152
00:11:14,310 --> 00:11:17,990
فضلاً عن ذلك، ضغطتُ على نفسي
أكثر من اللّازم

153
00:11:18,470 --> 00:11:20,870
،عندما تُخمَد هذه النِّيران

154
00:11:20,870 --> 00:11:24,570
فإنّ قوّتي كشيطانيّة تختفي غالباً أيضاً

155
00:11:25,420 --> 00:11:27,810
إنّ امتلاك القوّة الّتي منحَتْني إيّاها سيتسونا

156
00:11:27,810 --> 00:11:33,760
وذكرياتي مع سيتسونا هكذا مُؤلم للغاية

157
00:11:34,440 --> 00:11:36,210
لكن لا بأس في ذلك

158
00:11:36,210 --> 00:11:39,050
،كنتُ قادرة على إنقاذ أولئك الفتيات اللّطيفات

159
00:11:39,570 --> 00:11:43,540
وإذا كان ذلك يعني منع وقوع كارثة
،عظيمة في النّهاية

160
00:11:44,320 --> 00:11:50,110
فأنا متأكِّدة بأنّها ستقبل بأنّني
عشتُ صادقة مع نفسي

161
00:11:59,410 --> 00:12:00,990
لذا الأمور بخير

162
00:12:14,550 --> 00:12:16,840
شينوميا مُندمجة مع هذا؟

163
00:12:16,840 --> 00:12:17,790
أجل

164
00:12:18,370 --> 00:12:19,620
ساعديني

165
00:12:19,620 --> 00:12:21,390
سأحرقه من الأعلى

166
00:12:21,390 --> 00:12:22,940
وأنتِ هاجمي من الأسفل

167
00:12:35,380 --> 00:12:37,820
وداع سيتسونا من جديد

168
00:12:38,260 --> 00:12:40,880
سيكون مُحزِناً

169
00:12:53,870 --> 00:12:55,070
!يا للهول

170
00:13:29,390 --> 00:13:30,820
!تووا

171
00:13:30,820 --> 00:13:32,830
!لا يمكنك! هذا خطير

172
00:13:32,830 --> 00:13:33,980
سأُساعدك

173
00:13:34,560 --> 00:13:36,400
لا تقلقي يا شينا

174
00:13:36,400 --> 00:13:40,200
لن أموت، ولن أدعكِ تموتين أيضاً

175
00:13:42,860 --> 00:13:44,090
شكراً

176
00:13:44,090 --> 00:13:48,280
أنتِ ولهيب سيتسونا جميلان حقّاً

177
00:13:48,280 --> 00:13:50,980
أجل. إنّهما كنزي

178
00:13:58,570 --> 00:13:59,980
لكن أنا آسفة

179
00:14:02,460 --> 00:14:06,440
سيتسونا، سـأستخدمها كُلّها هنا

180
00:14:07,680 --> 00:14:09,460
!فلنبدأ يا تووا

181
00:14:09,460 --> 00:14:10,300
!حسناً

182
00:14:31,640 --> 00:14:33,700
!شينا، أخرجينا

183
00:14:38,020 --> 00:14:39,390
شينا

184
00:14:55,280 --> 00:14:56,660
شينا

185
00:14:57,300 --> 00:14:59,360
استيقظي

186
00:15:00,800 --> 00:15:01,820
ماذا؟

187
00:15:02,410 --> 00:15:05,830
انتهت حصّة النّشاط، لذا سنعود إلى المنزل

188
00:15:07,710 --> 00:15:08,910
يونا؟

189
00:15:08,910 --> 00:15:09,660
أجل

190
00:15:09,660 --> 00:15:12,510
كنتِ غائبة عن الوعي تماماً يا شينا

191
00:15:12,510 --> 00:15:16,560
كان من الصّعب منع سينسي
من كشف الأمر

192
00:15:18,520 --> 00:15:20,970
نحن في المدرسة؟

193
00:15:19,320 --> 00:15:20,550
!لا

194
00:15:20,550 --> 00:15:23,690
يجب عليكما الالتزام بالموعد النّهائيّ
لتسليم تقريركما

195
00:15:21,300 --> 00:15:23,690
أنا تلميذة ثانويّة سنة ثانية؟

196
00:15:24,490 --> 00:15:26,380
!شينا، يونا

197
00:15:26,380 --> 00:15:28,340
!تأخّرتما

198
00:15:28,340 --> 00:15:30,660
هذا لأنّ شينا كانت تغطّ في النّوم

199
00:15:30,660 --> 00:15:32,830
أجل، آسفة، آسفة

200
00:15:32,830 --> 00:15:34,960
ما زال لديّ ما يكفيكما

201
00:15:34,960 --> 00:15:35,880
تفضّلا

202
00:15:35,880 --> 00:15:37,130
!مرحى

203
00:15:37,710 --> 00:15:40,190
أجل، فهمت

204
00:15:40,190 --> 00:15:41,740
هذا حلم

205
00:15:42,200 --> 00:15:43,710
هذا ليس واقعيّاً

206
00:15:43,710 --> 00:15:47,610
لكنّه عالم كان من المُمكن أن يكون

207
00:15:49,080 --> 00:15:53,460
،هناك نِظامٌ في المُدن والمُجتمع
ولا يوجد خطر

208
00:15:54,150 --> 00:15:55,980
الأصدقاء وأفراد العائلة

209
00:15:56,420 --> 00:15:59,390
لا يُهاجَمون بواسطة وحوش
في طريقهم إلى المنزل

210
00:16:00,510 --> 00:16:05,080
النّاس لا يصبحون وحوشاً
من تناول عقاقير خطيرة

211
00:16:05,970 --> 00:16:10,460
إنّه عالمٌ حيث أخبار الكوارث
وصوت الصّافرات غير شائعة

212
00:16:13,740 --> 00:16:16,090
تووا، شينا-تشان

213
00:16:16,090 --> 00:16:18,350
أهلاً بعودتكما إلى المنزل

214
00:16:18,740 --> 00:16:21,600
عدتُ يا أبي وأمّي

215
00:16:23,010 --> 00:16:24,350
أهلاً بعودتكِ يا تووا

216
00:16:24,350 --> 00:16:25,780
تويا

217
00:16:27,210 --> 00:16:31,660
عملتُ بجدّ لبناء عالم كهذا
كي يعيش فيه البشر

218
00:16:34,290 --> 00:16:36,110
ما الأمر يا شينا؟

219
00:16:36,110 --> 00:16:38,020
لا شيء

220
00:16:38,020 --> 00:16:39,770
هل هذا هو الطّريق المُؤدِّي إلى منزلكِ؟

221
00:16:40,650 --> 00:16:44,900
سنبقى في منزلكِ اليوم يا شينا

222
00:16:44,900 --> 00:16:46,680
منزلي؟

223
00:16:46,680 --> 00:16:49,780
أجل. منزلكِ. في أماتوريشيما

224
00:16:51,100 --> 00:16:52,700
في الجزيرة؟

225
00:16:58,340 --> 00:16:59,640
تووا، أنا آسفة

226
00:16:59,640 --> 00:17:01,820
فقط... فقط انتظريني لحظة

227
00:17:01,820 --> 00:17:03,540
حسناً، لأطول فترة تحتاجينها

228
00:17:08,790 --> 00:17:12,790
ظننتُ بأنّني لن أستطيع
رؤيتها حتّى في حلم

229
00:17:16,550 --> 00:17:17,540
سيتسونا؟

230
00:17:18,160 --> 00:17:19,560
!هنا

231
00:17:28,710 --> 00:17:30,900
!شي-تشان! أهلاً بعودتكِ

232
00:17:33,100 --> 00:17:35,320
سيتسونا

233
00:17:38,560 --> 00:17:39,930
...سيتسونا

234
00:17:40,400 --> 00:17:42,070
!سيتسونا

235
00:17:42,910 --> 00:17:45,090
ما الأمر يا شينا؟

236
00:17:45,090 --> 00:17:46,840
تتصرّفين كمُدلَّلة

237
00:17:46,840 --> 00:17:50,090
!هذا لأنّني... افتقدتُكِ

238
00:17:50,090 --> 00:17:51,630
تتصرّفين بغرابة أطوار

239
00:17:51,630 --> 00:17:53,370
لطالما كنّا معاً، صحيح؟

240
00:17:53,370 --> 00:17:55,640
فأنا أختكِ الصُّغرى

241
00:17:56,480 --> 00:18:01,570
عملتِ بجدٍّ حقّاً... لأجلي
ولأجل الجميع

242
00:18:01,570 --> 00:18:02,900
أعلم بأنّكِ فعلتِ

243
00:18:03,860 --> 00:18:06,370
حتّى لو انفصلنا، ولم نعُد نتمكّن
من التّحادُث بعد الآن

244
00:18:06,370 --> 00:18:08,230
سأبقى قريبة دوماً

245
00:18:08,770 --> 00:18:10,600
لذا لا تبكي

246
00:18:11,130 --> 00:18:12,730
أُحبّكِ يا شي-تشان

247
00:18:13,520 --> 00:18:17,990
أحببتُك آنذاك، وللأبد

248
00:18:21,410 --> 00:18:23,210
!أنا أيضاً

249
00:18:23,210 --> 00:18:24,860
!أُحبّكِ أيضاً يا سيتسونا

250
00:18:25,410 --> 00:18:26,930
سأبقى معكِ دوماً

251
00:18:27,410 --> 00:18:29,640
للأبد، اتّفقنا؟

252
00:18:38,620 --> 00:18:40,890
شينا. شينا

253
00:18:42,870 --> 00:18:43,890
تووا؟

254
00:18:45,120 --> 00:18:47,880
صباح الخير

255
00:18:48,290 --> 00:18:51,470
تمّتْ إبادة زيرو بالكامل

256
00:18:51,470 --> 00:18:53,290
أحسنتِ صنعاً يا شينا

257
00:18:53,900 --> 00:18:55,110
أنتِ أيضاً يا تووا

258
00:18:55,110 --> 00:18:57,350
شكراً. كنتِ خير مُعين

259
00:18:58,390 --> 00:19:01,650
استريحي لفترة أطول ريثما يصل الإنقاذ

260
00:19:02,000 --> 00:19:04,910
كنتُ قد شاهدتُ حلماً بينما أنا
على حافة الموت

261
00:19:06,620 --> 00:19:09,920
حلم حيث نعيش في عالمٍ مُسالم؟

262
00:19:11,400 --> 00:19:12,410
أجل

263
00:19:12,690 --> 00:19:17,720
...تمكّنتُ من اللِّقاء بأبي وأمّي
وتلك الفتاة أيضاً

264
00:19:17,720 --> 00:19:19,930
ابتسموا ورحّبوا بعودتي إلى المنزل

265
00:19:20,380 --> 00:19:23,290
لم أشعر برضا أكبر من ذلك سابقاً

266
00:19:23,960 --> 00:19:27,190
هل تمكّنتِ من التكلُّم
مع سيتسونا كثيراً؟

267
00:19:27,190 --> 00:19:28,370
أجل

268
00:19:28,370 --> 00:19:30,780
كانت سيتسونا تبتسم حقّاً

269
00:19:30,780 --> 00:19:32,440
قالتْ بأنّها ستبقى معي دوماً

270
00:19:33,160 --> 00:19:37,280
،أنا سعيدةٌ لأنّني تمكّنتُ من رؤيتها
ولو كان ذلك في حلم

271
00:19:39,470 --> 00:19:40,350
أجل

272
00:19:45,190 --> 00:19:46,270
!تووا-سان

273
00:19:46,270 --> 00:19:47,310
!شينا-سان

274
00:19:57,300 --> 00:19:58,630
...وهكذا

275
00:19:58,630 --> 00:20:01,160
،بعد الانتهاء من إبادة زيرو

276
00:20:01,160 --> 00:20:04,990
تكون عمليّة الإبادة العظيمة الخاصّة
بإكشيد قد اكتملت حاليّاً

277
00:20:05,470 --> 00:20:11,050
،عندما عَلِمَ كوراغي إيجي بموت شينوميا
مات في السّجن

278
00:20:11,050 --> 00:20:15,350
سمعتُ بأنّه لم يكشف شيئاً
عن شينوميا طوال الوقت

279
00:20:17,690 --> 00:20:19,720
بحثه حول عقاقير الشّيطانيّين

280
00:20:19,720 --> 00:20:22,740
قد تمّ تبنّيه بواسطة مقرّ إغاثة
الكوارث التّابع للأُمم المُتَّحدة

281
00:20:23,130 --> 00:20:24,300
،بالطّبع

282
00:20:24,300 --> 00:20:28,520
الآن أصبح بحثهم يقتصر على ضمان سلامة
الجميع، لا لتحويل النّاس إلى شيطانيّين

283
00:20:29,230 --> 00:20:33,050
،تمّ استبدال قيادة الشّرطة الفاسدة أيضاً

284
00:20:33,050 --> 00:20:36,410
وتمّ اتِّهامهم بجرائم شيطانيّين كذلك

285
00:20:37,270 --> 00:20:41,040
طوارئ الأنواع الغازية وتهديدها

286
00:20:41,040 --> 00:20:43,550
،بانقراض البشر قد ولّى أخيراً

287
00:20:44,010 --> 00:20:46,470
لذا المُديرة ياغامي، ونانو-تشان، والأُخريات

288
00:20:46,470 --> 00:20:50,500
على وشك التوجُّه إلى مكانٍ آخر
من أجل مهمّة أُخرى ثانية

289
00:20:51,510 --> 00:20:53,610
أنا متأكِّدةٌ بأنّنا سنرى بعضنا
الآخر ثانية عمّا قريب

290
00:20:53,610 --> 00:20:55,290
أجل، أنا متأكِّدة بأنّنا سنفعل

291
00:20:55,290 --> 00:20:58,110
كان وداعنا قصيراً جدّاً

292
00:20:58,780 --> 00:21:02,640
حصلتُ أيضاً على إجازة مدفوعة طويلة

293
00:21:07,850 --> 00:21:10,030
،والآن بعد عودتي إلى الجزيرة

294
00:21:10,350 --> 00:21:12,480
انضمّتْ تووا والفتيات لي

295
00:21:19,040 --> 00:21:21,960
غالباً في مكانٍ ما خارج البلاد ثانية

296
00:21:21,960 --> 00:21:24,220
أنا متأكِّدةٌ بأنّهن يبلينَ حسناً

297
00:21:29,410 --> 00:21:30,980
!شينا-سان

298
00:21:31,870 --> 00:21:33,300
نانو-تشان، ما الأمر؟

299
00:21:33,300 --> 00:21:34,660
نحن آسفتان

300
00:21:38,420 --> 00:21:39,430
!يا إلهي

301
00:21:39,430 --> 00:21:41,780
،نأسف لطلبِنا هذا

302
00:21:41,780 --> 00:21:46,450
لكن هل من المُمكن أن تُساعدينا
أنتِ وتووا-سان؟

303
00:21:46,450 --> 00:21:48,530
الوضع صعبٌ قليلاً

304
00:21:51,960 --> 00:21:53,820
حسناً. اعتمدا عليّ

305
00:21:53,820 --> 00:21:55,200
سأُقدّم المُساعدة أيضاً

306
00:21:55,200 --> 00:21:57,720
هل أُحضر فتياتي معي كذلك؟

307
00:21:57,720 --> 00:21:58,970
!أجل، من فضلكِ

308
00:22:01,210 --> 00:22:02,970
شكراً يا يوزو

309
00:22:03,790 --> 00:22:05,070
!حسناً

310
00:22:05,070 --> 00:22:06,230
...والآن

311
00:22:06,230 --> 00:22:07,940
!حان وقت المُغادرة

312
00:22:28,610 --> 00:22:33,640
!حسناً، لنفعلها جميعاً

313
00:22:33,640 --> 00:22:35,360
!أجل