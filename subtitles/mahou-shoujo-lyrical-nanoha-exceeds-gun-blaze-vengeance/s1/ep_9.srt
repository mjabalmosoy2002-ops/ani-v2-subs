1
00:01:32,110 --> 00:01:33,460
!هل يورومي في الدّاخل؟

2
00:01:33,460 --> 00:01:35,580
!من فضلكم أطلعونا على آخر المُستجدّات

3
00:01:41,350 --> 00:01:43,490
!يا لها من فوضى عارمة

4
00:01:44,070 --> 00:01:48,170
انتهى الاستجواب، والمُتَّهمة
يورومي قد جرى اعتقالها

5
00:01:48,800 --> 00:01:50,990
،لمنعها من الهرب أثناء عمليّة النّقل

6
00:01:50,990 --> 00:01:54,940
قيّدناها وحقنّاها بمُهدِّئات

7
00:01:54,940 --> 00:01:56,440
عظيم

8
00:01:56,440 --> 00:01:58,510
هذا سيُسهّل عمليّةَ النّقل

9
00:02:02,630 --> 00:02:03,860
مرحباً؟

10
00:02:03,860 --> 00:02:04,890
هذه أنا

11
00:02:05,290 --> 00:02:06,650
هل ما زالت عمليّة النّقل جارية؟

12
00:02:06,650 --> 00:02:07,640
أجل

13
00:02:07,940 --> 00:02:10,120
نسيتُ إبلاغكِ

14
00:02:10,120 --> 00:02:15,640
اتّصل عميلُنا وقال بأنّه يريد عقّاركِ
الشّيطانيّ ذا الدّرجة الخاصّة

15
00:02:15,640 --> 00:02:18,700
هل نفدت الكمّية لدينا من الآن؟

16
00:02:18,700 --> 00:02:20,410
ليس بحوزتي منه

17
00:02:20,410 --> 00:02:23,040
آسف، لكن هلّا أحضرتِ معكِ بعضاً منه؟

18
00:02:23,040 --> 00:02:25,160
سأخبر المُساعدين

19
00:02:25,160 --> 00:02:29,680
فالعقّار ذو الدّرجة الخاصّة لا يمكن
تصنيعه إلّا في مُختبري

20
00:02:29,680 --> 00:02:33,180
لا أستطيع صنعه ما لم أكن في المكان
المُناسب بالمُكوّنات المُناسبة

21
00:02:33,180 --> 00:02:35,180
!فهو أداة فاخرة جدّاً

22
00:02:35,450 --> 00:02:40,000
آمل أن تُثبتي بأنّكِ مُكوِّن جيّد
أيضاً يا تووا-تشان

23
00:02:42,980 --> 00:02:47,550
من جديد، أهلاً بكن في الفرع الشّرق
الأقصى التّابع لإكشيد

24
00:02:47,850 --> 00:02:50,930
أنا مُديرة إكشيد، ياغامي هاياتي

25
00:02:50,930 --> 00:02:52,520
أنا آيزاوا شيوري

26
00:02:52,520 --> 00:02:54,230
وأنا كيتاموري يونا

27
00:02:54,230 --> 00:02:55,890
وأنا كوديرا يوزو

28
00:02:56,830 --> 00:02:58,810
نينا أوي

29
00:02:58,810 --> 00:03:00,900
اسمي تاكاماتشي نانوها

30
00:03:00,900 --> 00:03:03,070
وأنا فيت تيستاروسّا هارلاون

31
00:03:03,530 --> 00:03:06,450
التقينا قبل أيّام يا آيزاوا-سان

32
00:03:07,140 --> 00:03:09,280
آسفة على المتاعب الّتي سبّبناها

33
00:03:09,820 --> 00:03:12,390
اسمحنَ لي أن أتحقّق من التّفاصيل ثانية

34
00:03:12,390 --> 00:03:18,080
تواصلتُن مع كوزي-سان، وأتيتُن إلى هنا

35
00:03:18,540 --> 00:03:21,190
لتبرئة يورومي تووا-سان من التّهم
الباطلة المُوجَّهة إليها

36
00:03:21,190 --> 00:03:23,850
وتحريرها من الاعتقال الجائر

37
00:03:23,850 --> 00:03:25,820
هل هذا صحيح؟

38
00:03:26,350 --> 00:03:31,590
جزءٌ منه، لكن هدفنا كُلّه تقريباً
هو إنقاذ تووا-سان

39
00:03:31,590 --> 00:03:34,860
على هذا المُعدَّل، تووا-سان ستموت

40
00:03:34,860 --> 00:03:36,860
ما السّبب؟

41
00:03:38,900 --> 00:03:40,620
!السّبب؟

42
00:03:40,850 --> 00:03:45,860
لأنّ حكومتكم ورجال الشّرطة يستمرّون
!في تجاهل عقاقير الشّيطانيّين

43
00:03:45,860 --> 00:03:46,530
!أوي

44
00:03:46,530 --> 00:03:52,030
تأذّى كثير من النّاس وقُتِلوا بواسطة
!الشّيطانيّين الّذين صُنِعوا باستخدام تلك العقاقير

45
00:03:52,030 --> 00:03:54,410
!دُمِّرَت الكثير من الأرواح

46
00:03:54,410 --> 00:03:56,730
كانت تووا-سان تسعى لتقليص
عدد النّاس

47
00:03:56,730 --> 00:03:58,870
!الّذين يُعانون بسبب عقاقير الشّيطانيّين

48
00:03:58,870 --> 00:04:01,440
!مع ذلك الشّرطة تتعاون معهم

49
00:04:01,440 --> 00:04:04,880
الآن يخطّطون لتسليم تووا-سان
!لشينوميا وكوراغي

50
00:04:04,880 --> 00:04:08,400
!لهذا ذهبتْ تووا-سان بمُفردها

51
00:04:08,400 --> 00:04:09,230
!أوي

52
00:04:09,230 --> 00:04:10,530
الوقت غير مُناسب لذلك الآن

53
00:04:10,530 --> 00:04:11,880
لا داعي للقلق

54
00:04:12,650 --> 00:04:15,980
،مهمّتُنا الرّئيسيّة هي إبادة الأنواع الغازية

55
00:04:15,980 --> 00:04:21,810
لكن يؤسفنا جدّاً عجزنا عن حرف
الضّرر الّذي تُسبّبه العقاقير

56
00:04:23,820 --> 00:04:26,100
،لا يمكننا إرجاع ما حدث في الماضي

57
00:04:26,100 --> 00:04:29,700
لكن يمكننا صياغة المُستقبل كيفما نشاء

58
00:04:30,290 --> 00:04:33,870
هلّا حدّثتنّا أكثر عن أنفسكن؟

59
00:04:37,540 --> 00:04:41,490
ترعرعت تووا-سان في مركز
أبحاث عقاقير الشّيطانيّين

60
00:04:41,490 --> 00:04:44,040
كانت إحدى الأطفال الّذين تخلّصوا منهم

61
00:04:44,040 --> 00:04:49,740
كان مُختبر الأبحاث ذاك يُدار بواسطة
كوراغي إيجي وشينوميا مانا

62
00:04:54,100 --> 00:04:57,230
بينما كوراغي يدعمها

63
00:04:57,570 --> 00:05:01,590
إذاً شينوميا هذه افتعلت الحادثةَ الأخيرة

64
00:05:01,590 --> 00:05:03,580
من أجل الحصول على يورومي-سان؟

65
00:05:03,580 --> 00:05:06,170
هذا ما ارتأته تووا-سان

66
00:05:06,170 --> 00:05:07,710
أتّفق معها

67
00:05:08,070 --> 00:05:11,580
وبالفعل كانت الشّرطة تتصرّف بشكل غريب

68
00:05:11,580 --> 00:05:15,540
ضبّاط الشّرطة الكبار يشترون عقاقير
الشّيطانيّين باستمرار

69
00:05:16,140 --> 00:05:19,580
قبل كُلّ شيء، لماذا بدأت يورومي
تووا-سان بقتل الشّيطانيّين؟

70
00:05:21,420 --> 00:05:26,880
والدا تووا-سان بالتبنّي أنقذاها
،من حافّة الموت

71
00:05:27,620 --> 00:05:30,670
وبالكاد كانت قد حظيتْ بحياة
سعيدة لبعض الوقت

72
00:05:35,680 --> 00:05:40,360
لكن بعدها، قبل أربع سنوات، قتلَ
حريقٌ في المطار والديها

73
00:05:40,360 --> 00:05:41,740
هل كان حادِثاً عرّضيّاً؟

74
00:05:41,740 --> 00:05:47,120
لا. أطلقَ الإرهابيّون عنان شيطانيّ
،صُنِعَ بعقّار

75
00:05:47,120 --> 00:05:50,830
،طفلة أُخرى من مركز تووا-سان السّابق

76
00:05:50,830 --> 00:05:52,280
لمُهاجمة المطار

77
00:05:54,570 --> 00:05:56,460
كانت هذه الفتاة

78
00:05:56,950 --> 00:05:58,580
شيطانيّة اللّهب

79
00:05:58,580 --> 00:06:03,330
أعتقد بأنّ نيرانها تُشبه نيراني
ونيران سيتسونا

80
00:06:03,330 --> 00:06:08,830
قِوى شيطانيّة اللّهب غير مُستقرّة
وتميل للخروج عن السّيطرة

81
00:06:08,830 --> 00:06:12,350
سمعتُ بأنّهم استُخدِموا كأسلحة انتحاريّة

82
00:06:13,600 --> 00:06:18,360
الوصول إلى قدرات قويّة يأتي
على حساب فقدان السّيطرة بسهولة

83
00:06:18,360 --> 00:06:22,320
ما يُسبّب انفجاراً يُحوّل كُلّ ما يُحيط
بهم إلى كتلة من النّيران

84
00:06:23,370 --> 00:06:27,650
،يتجدّدون بشكل مصحوب بالألم
ليُحدِثوا انفجاراً ثانياً

85
00:06:29,310 --> 00:06:33,470
تُسهِّل عقاقير الشّيطانيّين عمليّة
صنع شيطانيّ كهذا

86
00:06:35,620 --> 00:06:40,250
واجهنا هذا النّوع من الشّيطانيّين
مرّتين من قبل

87
00:06:41,120 --> 00:06:46,060
من بينهم الفتاة الأولى، ليُصبحوا ثلاثة
تمكّنتْ منهم تووا-سان

88
00:06:46,880 --> 00:06:52,350
،تكره تووا-سان عقاقير الشّيطانيّين
وكوراغي وشينوميا اللّذين صنعاهم

89
00:06:53,220 --> 00:06:56,570
قالت بأنّها ستستأصل كُلّ شخص

90
00:06:56,570 --> 00:06:59,790
،أصبح شيطانيّاً لتحقيق رغباته الأنانيّة

91
00:06:59,790 --> 00:07:02,560
وكُلّ شخص تاجر بعقاقير الشّيطانيّين

92
00:07:03,240 --> 00:07:09,160
مع ذلك انسحبَ كوراغي بالفعل من مُمارسة
العمل علناً وأصبح يعمل بشكلٍ مُتخفٍّ

93
00:07:13,420 --> 00:07:17,410
لذا كنّا نسحق التُجّار وطُرُق توزيع العقّار

94
00:07:17,410 --> 00:07:19,830
لكسب النّفوذ أثناء البحث عنهم

95
00:07:20,490 --> 00:07:24,170
...نتفهّم بأنّ هذه جريمة، لكن

96
00:07:24,170 --> 00:07:27,780
!لو لم نفعل ذلك، لمات مزيدٌ من النّاس

97
00:07:27,780 --> 00:07:29,130
!بالغون وأطفال

98
00:07:29,130 --> 00:07:30,930
أوي، اهدئي

99
00:07:30,930 --> 00:07:32,450
لا داعي للقلق

100
00:07:32,450 --> 00:07:36,000
يمكنكن أن تكُن صريحات تماماً
بالتّعبير عن أفكاركن

101
00:07:36,000 --> 00:07:39,680
كم مضى على وجودكن مع يورومي-سان؟

102
00:07:39,680 --> 00:07:43,190
أنا العضوة الأقدم، وانضممتُ لها
قبل ثلاث سنوات

103
00:07:46,590 --> 00:07:48,890
هوجِمتُ بواسطة شيطانيّ عنكبوت

104
00:07:49,590 --> 00:07:51,350
وحُقِنتُ بعقّار

105
00:07:55,190 --> 00:07:58,200
نفس الأمر تقريباً بالنّسبة لي

106
00:07:58,470 --> 00:08:03,240
،تمّ بيعي كطعام للشّيطانيّين
وتحوّلتُ إلى واحد بواسطة العقّار

107
00:08:03,240 --> 00:08:07,850
يبدو أنّ البشريّ الّذي يتحوّل
إلى شيطانيّ بواسطة عقّار

108
00:08:07,850 --> 00:08:10,970
هو طعام أعلى جودة لهم من بشريّ عاديّ

109
00:08:10,970 --> 00:08:12,200
،بالنّسبة ليوزو

110
00:08:12,780 --> 00:08:17,650
والدها التّاجر الخسيس استخدمها لاختبار
أخلاط تجريبيّة من عقاقير الشّيطانيّين

111
00:08:18,810 --> 00:08:22,510
حُقِنَتْ بمُختلف أنواع العقاقير
...حتّى أُنهِكَتْ تماماً

112
00:08:23,490 --> 00:08:27,510
عندما أنقذتْها تووا-سان، كانت
في حالة مُزرية حقّاً

113
00:08:28,870 --> 00:08:32,430
أنا مُمتنّة لتووا-سان حتّى الممات

114
00:08:33,870 --> 00:08:37,530
المعذرة، في حين أنّنا كنّا
،نقتل الشّيطانيّين

115
00:08:37,530 --> 00:08:42,880
كنّا نضطرّ أحياناً لأذيّة وقتل أشخاص
لم يكونوا أشراراً

116
00:08:44,310 --> 00:08:48,370
الأشخاص، أو الأحرى... أولئك الّذين
،أصبحوا شيطانيّين وفقدوا السّيطرة

117
00:08:48,650 --> 00:08:53,030
،أولئك الّذين أُصيبوا بعدوى الأنواع الغازية
...وأولئك الّذين صارت حالتهم مُستعصية

118
00:08:54,420 --> 00:08:56,930
،كُلّما اضطررنا لمُواجهتهم

119
00:08:57,470 --> 00:09:01,610
كانت تووا-سان تحرص على ألّا نتدخّل

120
00:09:01,610 --> 00:09:03,970
تحمّلتْ كُلَّ ذلك بمُفردها

121
00:09:05,580 --> 00:09:08,800
،كانت تتصرّف بصورة طبيعيّة أمامنا

122
00:09:09,280 --> 00:09:13,310
لكن أعتقد بأنّ ذلك كان مُؤلماً
وقاسياً جدّاً بالنّسبة لها

123
00:09:13,690 --> 00:09:16,160
...لكن كان ذلك عندما

124
00:09:17,500 --> 00:09:20,450
التقتْ تووا-سان بشينا-سان

125
00:09:22,700 --> 00:09:26,300
صادفَتا بعضهما الآخر بصراحة في المدينة

126
00:09:27,320 --> 00:09:31,660
وأصبحتا صديقتين كأيّ أشخاص عاديّين

127
00:09:34,280 --> 00:09:36,530
نسيتْ تووا-تشان هاتفها خلفها

128
00:09:37,520 --> 00:09:40,370
،أعلم بأنّنا ما كان ينبغي أن نختلس النّظر

129
00:09:40,720 --> 00:09:42,870
لكنّنا تفقّدناه

130
00:09:43,780 --> 00:09:46,530
كان مليئاً بصوركن

131
00:09:47,030 --> 00:09:49,500
وبدتْ سعيدة جدّاً برسائلها معكن

132
00:09:50,200 --> 00:09:53,400
وحتّى أنّها كتبتْ عن مشاعرها
في التّقويم، كمُذكّرات

133
00:09:54,460 --> 00:09:58,030
تكلّمتُ مع شينا ثانية اليوم. كان ذلك مُمتعاً

134
00:09:59,470 --> 00:10:05,100
أريد الحرص على ألّا تُعاني فتيات
لطيفات مثل شينا ثانية

135
00:10:07,100 --> 00:10:11,600
سأقضي على كافّة الشّيطانيّين وعقاقيرها

136
00:10:14,960 --> 00:10:17,880
كتبَتْ عنّا كذلك

137
00:10:18,740 --> 00:10:23,640
عن امتنانها على أشياء بسيطة
مثل الطّعام وغسيل الملابس

138
00:10:24,370 --> 00:10:31,000
كم شعرتْ بالدّفء عندما رأت
بأنّنا كنّا مُستمتعات

139
00:10:35,020 --> 00:10:39,430
أو كم أرادتْ أن تنتهي مهمّة
قتلنا للشّيطانيّين في أسرع وقت

140
00:10:39,430 --> 00:10:41,790
وذلك كي نعيش حياةً طبيعيّة

141
00:10:42,940 --> 00:10:46,930
فكّرتْ في مُستقبلنا وانهمكتْ في ذلك

142
00:10:47,960 --> 00:10:49,820
كانت تقلق على أوي، وعلى يوزو أيضاً

143
00:10:50,290 --> 00:10:53,100
وكم تمنّتْ أن أن تُصبحا صديقتين

144
00:10:54,290 --> 00:10:57,260
سلّمتْ تووا-سان نفسها

145
00:10:58,040 --> 00:11:01,990
لأنّها كانت خائفة من أن تستهدفنا
شينوميا أيضاً

146
00:11:03,150 --> 00:11:08,330
،لكن أخذتْ تووا-سان قِوانا الشّيطانيّة معها

147
00:11:08,330 --> 00:11:10,270
...لذا لا يسعنا فعل شيء الآن

148
00:11:11,570 --> 00:11:12,770
...لهذا السّبب

149
00:11:22,220 --> 00:11:23,970
!أنا آسفة

150
00:11:23,970 --> 00:11:26,850
أعلم بأنّه لا يحقّ لنا أن
!نطلب منكم هذا الآن

151
00:11:28,170 --> 00:11:31,780
أنا آسفة عن الكلام القاسي الّذي
قلتُه بحقّ شينا-سان أيضاً

152
00:11:32,160 --> 00:11:35,080
ولأنّني لكمتُها

153
00:11:35,690 --> 00:11:38,620
!أنا آسفة أيضاً

154
00:11:38,620 --> 00:11:42,590
!يمكنكم اعتقالي حالما ينتهي كُلُّ هذا

155
00:11:43,160 --> 00:11:47,600
!لكن... أرجوكم

156
00:11:48,080 --> 00:11:53,160
!أرجوكم دعونا نُنقذ تووا-سان

157
00:11:54,730 --> 00:11:56,330
!أرجوكم

158
00:11:59,230 --> 00:12:00,600
!مـ-مهلاً

159
00:12:02,660 --> 00:12:05,860
!كنّا ننوي التّعاون معكن على أيّ حال

160
00:12:06,170 --> 00:12:07,260
...لا حاجة لذلك

161
00:12:07,260 --> 00:12:08,880
سيكون كلّ شيء بخير، اتّفقنا؟

162
00:12:08,880 --> 00:12:10,760
نحن هنا لأجلكن

163
00:12:10,760 --> 00:12:16,210
قاتلنَ بمُفردهن، دون مُساعدة
الحكومة أو أيّ شخص آخر

164
00:12:16,750 --> 00:12:18,380
لا أحد يعلم ما مررنَ به

165
00:12:18,890 --> 00:12:21,960
أو كم كان طلب مُساعدتنا صعباً

166
00:12:22,800 --> 00:12:25,770
كم من المُؤلم أن نعلم بأنّهن
لا يملكن القوّةَ للقتال

167
00:12:25,770 --> 00:12:30,060
أو لحماية شخص عزيز جدّاً عليهن

168
00:12:31,140 --> 00:12:32,590
المُديرة ياغامي

169
00:12:34,160 --> 00:12:35,630
أعلم

170
00:12:36,630 --> 00:12:40,870
أطمئنكن بأنّني أفهم كُلَّ ما تشعرن به

171
00:12:40,870 --> 00:12:44,430
كوزي-سان، نانوها-تشان، ابقيا معهن رجاء

172
00:12:44,430 --> 00:12:45,140
!حاضرة

173
00:12:45,140 --> 00:12:46,400
عُلِم

174
00:12:49,240 --> 00:12:51,620
المُديرة ياغامي، ماذا عن خطّتنا؟

175
00:12:51,910 --> 00:12:53,380
لديّ خطّة بالفعل

176
00:12:54,080 --> 00:12:55,710
مُدير الفرع لوكي

177
00:12:55,710 --> 00:12:56,670
حاضر؟

178
00:12:56,890 --> 00:13:00,670
تواصل مع الصّحُف والشّرطة
بخصوص هذه الحادثة

179
00:13:00,670 --> 00:13:05,330
أخبرهم بأنّنا احتجزنا أربعة من مُتواطئي
يورومي تووا

180
00:13:05,330 --> 00:13:06,420
—أبلغ الشّرطة

181
00:13:06,420 --> 00:13:08,560
بأنّنا نُطالب بإجراء مُقابلة مع يورومي

182
00:13:08,560 --> 00:13:10,680
ونريد منهم أن يُشاركوا تفاصيل قضيّتهم، صحيح؟

183
00:13:10,680 --> 00:13:11,670
أجل

184
00:13:11,890 --> 00:13:14,610
رغم أنّنا أرسلنا بالفعل طلباً
لإجراء مُقابلة

185
00:13:14,610 --> 00:13:16,680
سأحرص على تشكيل ضغط حقيقيّ عليهم

186
00:13:16,680 --> 00:13:18,100
من فضلك

187
00:13:18,500 --> 00:13:20,070
،حالما تتمّ المُوافقة على طلبنا

188
00:13:20,070 --> 00:13:23,780
سأتوجّه إلى سجن الولاية 1 رفقة
آيزاوا-سان والأُخريات

189
00:13:23,780 --> 00:13:24,700
حاضر

190
00:13:28,860 --> 00:13:30,700
...ا-المعذرة

191
00:13:30,980 --> 00:13:31,990
نعم؟

192
00:13:31,990 --> 00:13:36,030
هل سينفع هذا في تحقيقكم أو ما شابه؟

193
00:13:36,030 --> 00:13:37,200
ما هذا؟

194
00:13:38,330 --> 00:13:40,640
"هذا العقّار يُعدّ ذو "درجة خاصّة

195
00:13:40,640 --> 00:13:44,200
حتّى بين عقاقير الشّيطانيّين الّتي صُنِعَتْ
بواسطة كوراغي وشينوميا

196
00:13:44,690 --> 00:13:48,460
إنّه عقّار خاصّ يُباع بمبالغ طائلة

197
00:13:48,790 --> 00:13:51,990
احتفظتُ به مُعتقدة بأنّه سيُصوّبنا
نحو المسار الصّحيح

198
00:13:51,990 --> 00:13:53,870
شكراً جزيلاً لكِ

199
00:13:53,870 --> 00:13:57,220
هل من المُناسب أن أحتفظ بهذا
أثناء سَير عمليّة تحقيقنا؟

200
00:13:57,220 --> 00:13:58,270
أجل

201
00:14:00,570 --> 00:14:02,910
تووا، انتظريني

202
00:14:04,040 --> 00:14:05,910
سأنقذكِ

203
00:14:26,700 --> 00:14:28,220
جيّد، جيّد

204
00:14:28,500 --> 00:14:31,070
خُدّرَتْ بشكل ممتاز

205
00:14:31,070 --> 00:14:35,710
ظننتِ بأنّ تلك القوى الّتي تعتزّين بها
يمكنها كسر القيود والعقاقير؟

206
00:14:36,110 --> 00:14:39,850
!مع الأسف! إنّها تؤثِّر بكِ

207
00:14:39,850 --> 00:14:43,380
زمنكِ وأنتِ تلهين كسفّاحة
شيطانيّين قد ولّى

208
00:14:43,380 --> 00:14:48,480
،الآن بعد أن حصلتِ على قوّة مُفيدة
يجب تسخيركِ لأجلي

209
00:15:38,160 --> 00:15:40,950
هكذا إذاً، هكذا إذاً

210
00:15:50,580 --> 00:15:52,240
مُذهلة

211
00:15:52,240 --> 00:15:54,420
أنا مُتفاجئة قليلاً

212
00:15:54,420 --> 00:15:56,730
لقد أصبحتِ قويّة حقّاً

213
00:15:56,730 --> 00:15:57,990
...أجل

214
00:15:57,990 --> 00:16:04,150
قد تكونين من بين أقوى الشّيطانيّين
!الّذين على هيئة بشريّ

215
00:16:05,230 --> 00:16:07,490
!عملتِ بجدٍّ حقّاً

216
00:16:09,340 --> 00:16:11,350
...لكن لسوء حظّكِ

217
00:16:26,080 --> 00:16:29,060
لن يفلح ذلك ضدّي

218
00:16:29,060 --> 00:16:31,290
لماذا تفترضين بأنّكِ لا تستطيعين هزيمتي؟

219
00:16:31,720 --> 00:16:34,580
لأنّ المُهدِّئات ما زالت تؤثِّر بكِ؟

220
00:16:34,580 --> 00:16:38,560
لأنّني أستخدم قوّةً خاصّة ما؟

221
00:16:39,020 --> 00:16:41,310
ليس هذا السّبب

222
00:16:52,540 --> 00:16:54,890
الجواب بسيط

223
00:16:57,630 --> 00:17:00,730
أنا أقوى منكِ فحسب

224
00:17:09,840 --> 00:17:15,460
كنتُ أعمل بجدٍّ أيضاً منذ
مُغادرتكِ مُختبري

225
00:17:15,800 --> 00:17:22,190
أكلتُ كثيراً من الأطفال بعد إجراء تجارُب عليهم
وصنعتُ واستخدمتُ عقاقيرَ جديدة

226
00:17:24,240 --> 00:17:27,340
بماذا تشعرين الآن يا تووا-تشان؟

227
00:17:29,210 --> 00:17:34,680
،قضيتِ مدّة طويلة وأنتِ تُخطّطين لانتقامكِ
لكن لا يمكنكِ حتّى لمسي

228
00:17:34,680 --> 00:17:36,060
فما شعوركِ بذلك؟

229
00:17:37,850 --> 00:17:40,050
مُحبِط، أليس كذلك؟

230
00:17:40,050 --> 00:17:42,150
مُستفزّ، صحيح؟

231
00:17:42,150 --> 00:17:44,460
...كما تعلمين، على هذا المُعدّل

232
00:17:44,750 --> 00:17:51,320
قد ينتهي المطاف بقتلي كافّة
أصدقائكِ وأتباعكِ

233
00:17:52,020 --> 00:17:55,350
لأنّكِ... ضعيفةٌ جدّاً

234
00:17:57,960 --> 00:17:59,270
مهلاً

235
00:18:02,970 --> 00:18:05,460
ماذا؟ ما هذه النّار؟

236
00:18:07,380 --> 00:18:12,490
!شينوميا

237
00:18:13,980 --> 00:18:14,850
!خذي

238
00:18:16,340 --> 00:18:17,740
،واحد، اثنان

239
00:18:17,740 --> 00:18:19,320
!دويّ

240
00:18:23,490 --> 00:18:25,870
!لا جدوى، لا جدوى، لا جدوى

241
00:18:29,800 --> 00:18:34,130
والآن لنُعدكِ إلى دياركِ، إلى مُختبري

242
00:18:42,390 --> 00:18:46,810
سأُشرّحكِ، وأمزّقكِ، وأعاين
،دمكِ وأعضاءكِ الحيويّة

243
00:18:46,810 --> 00:18:49,590
!وأجري مُختلَف أنواع التّجارُب عليكِ

244
00:19:08,160 --> 00:19:09,930
!أيُّها المُساعِدات

245
00:19:09,930 --> 00:19:15,920
،أعدتُ تووا-تشان إلى المنزل معي
لذا حضِّرنَ اختبارات استخراج القوّة

246
00:19:15,920 --> 00:19:17,490
عُلِم

247
00:19:17,490 --> 00:19:21,000
لقد اتّسخت، لذا سأعود
بعد أن أستحمّ

248
00:19:21,380 --> 00:19:22,930
استغرقي وقتكِ من فضلكِ

249
00:19:24,410 --> 00:19:25,820
،من يجد نفسه مُتفرِّغاً

250
00:19:25,820 --> 00:19:29,930
فليُسلّم حقيبة من عقاقير الدّرجة الخاصّة
لإيجي-كن لأجلي

251
00:19:29,930 --> 00:19:32,710
سأترك بوّابةً مفتوحة لأجلك

252
00:19:32,710 --> 00:19:34,380
أمركِ

253
00:19:38,980 --> 00:19:42,280
ماذا تقصد بأنّنا لا نستطيع رؤيتها؟

254
00:19:42,280 --> 00:19:45,100
،المُتَّهمة يورومي قد قاومتْ

255
00:19:47,040 --> 00:19:50,700
لذا نُقِلَتْ إلى سجن مُختلف
لأسباب أمنيّة

256
00:19:51,220 --> 00:19:53,360
أيّ سجن؟

257
00:19:54,900 --> 00:19:56,410
لا يمكننا الإجابة عن ذلك

258
00:19:56,410 --> 00:19:57,460
!ماذا؟

259
00:19:58,820 --> 00:20:01,330
!مهلاً! لا تتجوّلنَ من تلقاء أنفسكن

260
00:20:01,330 --> 00:20:04,830
في الواقع، لا يمكننا المُغادرة بجملة
"لا يمكننا الإجابة عن ذلك"

261
00:20:05,450 --> 00:20:07,660
هل أنت واثق بأنّه من المُناسب

262
00:20:07,660 --> 00:20:12,350
التصرُّف بهذه الطّريقة تجاه العامّة
ذوي النّيّة الحسنة وموظّفي الأمم المُتّحدة؟

263
00:20:12,350 --> 00:20:14,120
...لا، لكن

264
00:20:14,660 --> 00:20:15,610
ماذا؟

265
00:20:17,100 --> 00:20:18,170
انظرن

266
00:20:21,990 --> 00:20:24,360
لا بُدَّ أنّ تووا-سان قد تركَتْها

267
00:20:31,170 --> 00:20:35,990
حلّلتُ البيانات الجينيّة في العقّار
الشّيطانيّ الّذي أرسلتموه لنا

268
00:20:36,460 --> 00:20:39,680
أنا متأكّدة بأنّه كما توقّعتْ نانوها-سان

269
00:20:40,460 --> 00:20:43,610
حضرة المُديرة ياغامي، استجمعنا معلوماتنا

270
00:20:44,000 --> 00:20:45,240
أحسنتُن صنعاً

271
00:20:45,750 --> 00:20:49,170
تركتْ يورومي-سان دليلاً لنا هنا كذلك

272
00:20:50,220 --> 00:20:52,170
سنمضي قُدماً بالخطّة

273
00:20:52,610 --> 00:20:54,900
استعددن للتّعبئة رجاء

274
00:21:15,040 --> 00:21:16,100
ماذا؟

275
00:21:16,100 --> 00:21:17,790
هل انفجر شيء؟

276
00:21:18,300 --> 00:21:21,040
مانا-ساما، هناك دُخلاء في المُختبر

277
00:21:21,040 --> 00:21:22,040
ماذا؟

278
00:21:28,220 --> 00:21:32,150
نحن من وكالة التّحقيق حول الكائنات الحيّة
الغازية الخطيرة، إكشيد

279
00:21:33,800 --> 00:21:35,620
أتينا لإجراء تفتيش إلزاميّ

280
00:21:35,620 --> 00:21:37,480
كجزء من تحقيقاتنا حول الأنواع الغازية

281
00:21:39,900 --> 00:21:41,440
نحن هنا أيضاً

282
00:21:45,240 --> 00:21:47,430
لاستعادة

283
00:21:47,950 --> 00:21:50,020
!صديقتي المخطوفة

284
00:23:31,020 --> 00:23:33,290
يُسمَح لنا بإبادتهم جميعاً، صحيح؟

285
00:23:33,290 --> 00:23:34,550
لنقضِ عليهم