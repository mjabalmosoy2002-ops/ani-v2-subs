1
00:01:32,200 --> 00:01:35,320
كم عاماً مضى حتّى الآن؟

2
00:01:35,320 --> 00:01:37,400
،لم أعُد أتذكّر

3
00:01:37,840 --> 00:01:40,820
لكن أقدم ذِكرى لي

4
00:01:40,820 --> 00:01:45,170
هي مشهد سقوط نيزك في قاعدة
الاستطلاع الّتي عشتُ فيها

5
00:01:45,770 --> 00:01:50,220
أصدقائي وعائلتي فُرِّقوا وقُتِلوا

6
00:01:50,220 --> 00:01:52,880
،ظهرَ وحوشٌ فجأة

7
00:01:52,880 --> 00:01:56,180
،والتهموا كُلّاً من الأحياء والموتى

8
00:01:56,180 --> 00:01:59,160
لأبقى النّاجية الوحيدة

9
00:02:15,740 --> 00:02:17,870
كنتُ قويّة

10
00:02:18,670 --> 00:02:22,910
كنتُ قويّة جدّاً بين الغُزاة

11
00:02:22,910 --> 00:02:27,510
يبدو أنّني اندمجتُ مع سلَف ذي قوّة استثنائيّة

12
00:02:37,420 --> 00:02:42,720
أنا انصهار للسّلَف أكس، سلَف
،لم تُعرّفه الأُمم المُتّحدة

13
00:02:42,720 --> 00:02:44,930
وفتاة في الثّالثة عشر من العمر

14
00:02:44,930 --> 00:02:47,860
هذه هي أنا: الشّيطانيّة مانا

15
00:02:48,580 --> 00:02:52,150
،زرتُ أماكنَ كثيرة للقتال

16
00:02:52,970 --> 00:02:56,000
وأكلتُ وأصبحتُ قويّة

17
00:03:01,150 --> 00:03:05,020
حصلتُ على هذا النّبات المُؤصَّص المُفيد

18
00:03:05,020 --> 00:03:07,250
وزرعتُه في مخبئي

19
00:03:17,830 --> 00:03:21,620
أجل، أصبحتُ قويّة جدّاً

20
00:03:22,730 --> 00:03:24,550
...ومع ذلك

21
00:03:24,840 --> 00:03:27,810
...تلك الّتي التقيتُ بها قبل عشر سنوات

22
00:03:27,810 --> 00:03:30,720
الشّيطانيّة، الّتي كانت سلَفاً مثلي

23
00:03:31,390 --> 00:03:32,860
لنُوقف هذا

24
00:03:33,200 --> 00:03:34,590
!ماذا؟

25
00:03:34,590 --> 00:03:36,560
!أنتِ شيطانيّة أيضاً، صحيح؟

26
00:03:36,560 --> 00:03:39,060
!شيطانيّة سلَف، مثلي

27
00:03:39,390 --> 00:03:44,320
ما الهدف الآخر في الحياة سوى الأكل
والسّرقة وتعزيز القوّة؟

28
00:03:45,690 --> 00:03:47,570
الأمر ليس كذلك بالنّسبة لي

29
00:03:48,160 --> 00:03:53,560
لا بُدّ من وجود شخص مثلي
لمنع أشخاص مثلكِ

30
00:03:53,560 --> 00:03:55,630
من تدمير العالم

31
00:03:55,950 --> 00:03:57,350
حقّاً؟

32
00:03:57,350 --> 00:04:00,200
!هذا يجعلكِ عدوّتي إذاً

33
00:04:00,200 --> 00:04:05,050
!إذا أكلتُكِ، فيمكنني أن أصبح أقوى حتّى

34
00:04:15,340 --> 00:04:18,790
قاتلنا بأقصى قوّة وحاولنا قتل بعضنا الآخر

35
00:04:18,790 --> 00:04:21,820
...ظننتُ بأنّني وجّهتُ لها ضربةً قاتلة

36
00:04:23,130 --> 00:04:26,700
،لكن في النّهاية، لم أستطع أكلها

37
00:04:26,700 --> 00:04:31,330
واضطررتُ للهرب بعد فقدان قوّتي

38
00:04:31,740 --> 00:04:34,730
لم أُرِد الخسارة ثانية أبداً

39
00:04:54,100 --> 00:04:58,280
أخبريني، لماذا تعتقدين بأنّكِ تستطيعين الفوز؟

40
00:04:59,780 --> 00:05:04,780
لا جدوى من الحياة كشيطانيّة إن
كنتِ لن تُصبحي قويّة

41
00:05:06,980 --> 00:05:12,660
إذا أردتِ قتلي، فلماذا لم تُضعافي جهدوكِ

42
00:05:17,160 --> 00:05:21,210
،كان يجدر بكِ أن تأكلي شيطانيّين وسلَفاً وأُناساً

43
00:05:21,210 --> 00:05:25,540
أو حتّى تستخدمي تلك العقاقير
الشّيطانيّة الّتي سرقتِها

44
00:05:25,540 --> 00:05:27,500
...أم أنّكِ

45
00:05:27,500 --> 00:05:31,550
أردتِ البقاء بشريّة حتّى بعد أن أصبحتِ شيطانيّة؟

46
00:05:32,020 --> 00:05:36,300
هل كنتِ تأملين إيجاد السّعادة حالما
تُنفّذين انتقامكِ؟

47
00:05:36,300 --> 00:05:37,660
!بلهاء

48
00:05:37,660 --> 00:05:39,250
!بلهاء، بلهاء

49
00:05:39,250 --> 00:05:43,950
تلك الفكرة مُلبّسة بالسكّر أكثر من دونات
!مسحوق مُنقّع بالعسل

50
00:05:49,020 --> 00:05:52,780
...الجبناء أمثالكِ

51
00:05:52,780 --> 00:05:55,570
،ضعفاء، لذا ينبغي أن تنحني فحسب

52
00:05:55,570 --> 00:05:58,950
وتزحفي على الأطراف الأربعة
وتسمحي لنفسكِ أن تُستعمَلي

53
00:05:59,860 --> 00:06:01,320
ما زال بمقدوري الحركة

54
00:06:01,890 --> 00:06:03,660
لن أدع الجميع يموتون

55
00:06:04,410 --> 00:06:07,960
لن أسمح لحقيقة أنّهن أتينَ وقاتلنَ

56
00:06:08,250 --> 00:06:09,850
تذهب سُدى

57
00:06:11,190 --> 00:06:13,150
الفارق في قوّتنا واضح تماماً

58
00:06:14,360 --> 00:06:15,560
...رغم ذلك

59
00:06:16,280 --> 00:06:18,240
،إذا كانت تنزف

60
00:06:19,280 --> 00:06:21,280
فلا بُدّ من وجود طريقة لقتلها

61
00:06:23,470 --> 00:06:25,850
،إذا قطعتُ رأسها عن جذعها

62
00:06:25,850 --> 00:06:28,120
فينبغي لذلك أن يُوفّر ثغرة

63
00:06:29,220 --> 00:06:31,000
أنا أقتل الشّيطانيّين

64
00:06:31,610 --> 00:06:34,620
!لذا سأعزّز قوّتي لفعل ذلك

65
00:06:37,950 --> 00:06:39,160
...سأستهدف

66
00:06:39,520 --> 00:06:40,610
!رأسها

67
00:06:47,750 --> 00:06:49,810
!قليلاً فقط

68
00:06:49,810 --> 00:06:53,010
جعلتِني أتعرّق قليلاً يا تووا-تشان

69
00:06:53,010 --> 00:06:57,150
حسناً، حتّى لو تدحرج رأسي، لن أموت
بتلك السّرعة

70
00:06:57,150 --> 00:06:59,340
سيؤلم ذلك كثيراً فحسب

71
00:06:59,340 --> 00:07:01,390
استفزّني ذلك

72
00:07:01,780 --> 00:07:05,390
،أشكُّ في أنّكِ ستموتين بتلك السّهولة يا تووا-تشان

73
00:07:05,900 --> 00:07:09,350
لكن ماذا عن أتباعكِ؟

74
00:07:15,350 --> 00:07:16,690
!أنتن

75
00:07:18,400 --> 00:07:21,910
ألم تفهمي ذلك بعد؟

76
00:07:22,180 --> 00:07:28,930
أنا أتحفّظ بجدّية لتجنُّب تحطيمكِ
وتحطيم هؤلاء الفتيات

77
00:07:29,410 --> 00:07:35,450
لو كنتِ فتاة مُطيعة وأصبحتِ
،عبدتي وفأر تجاربي

78
00:07:35,820 --> 00:07:40,050
لما مانعتُ العفو عن حياتهن لأجلكِ

79
00:07:40,320 --> 00:07:43,690
أم أنّكِ تُفضِّلين التخلّي عنهن

80
00:07:43,690 --> 00:07:47,190
وتُحاولين تحدّيّي مرّة أُخرى؟

81
00:07:47,480 --> 00:07:50,270
!رغم معرفتكِ بأنّكِ لا تستطيعين الفوز

82
00:07:53,910 --> 00:07:56,580
لا عليكِ يا تووا-سان

83
00:07:58,160 --> 00:08:01,780
لا تقلقي علينا

84
00:08:02,100 --> 00:08:05,460
نعلم بأنّكِ لن تخسري يا تووا-سان

85
00:08:05,890 --> 00:08:10,800
!لأنّكِ البطلة الّتي نحن مُعجبات بها

86
00:08:11,220 --> 00:08:12,850
...وأيضاً

87
00:08:12,850 --> 00:08:17,280
وعدَتْنا بأنّها ستأتي لإنقاذنا

88
00:08:17,710 --> 00:08:20,800
!لذا أنا متأكّدة بأنّ شينا-سان ستأتي

89
00:08:22,290 --> 00:08:23,550
شينا؟

90
00:08:24,680 --> 00:08:28,110
فعلتُ أشياء سيّئة كثيرة لشينا

91
00:08:28,730 --> 00:08:30,810
كذبتُ عليها

92
00:08:31,570 --> 00:08:34,440
لمتُها دون الاستماع إليها

93
00:08:35,010 --> 00:08:38,590
أذيتُ أشياء ثمينة بالنّسبة لها

94
00:08:39,200 --> 00:08:42,590
...لكن إذا استطعتُ رؤيتها ثانية

95
00:08:43,840 --> 00:08:47,610
أودُّ تقديمها للجميع للتعرُّف عليها

96
00:08:48,500 --> 00:08:54,020
،وأن أخبرها بأنّ هؤلاء الفتيات كُنّ معي دوماً
وهُنّ عزيزات عليّ

97
00:08:54,910 --> 00:08:56,800
لن أتخلّى عنهن، ولن أخسر

98
00:08:57,320 --> 00:09:01,200
سأبني عالماً حيث يستطيع فيه
الأشخاص اللّطيفون لطيفين

99
00:09:02,220 --> 00:09:03,480
...للقيام بذلك

100
00:09:05,020 --> 00:09:06,710
!سأقتل الشّيطانيّين

101
00:09:10,690 --> 00:09:13,100
أجل، هكذا تماماً

102
00:09:13,100 --> 00:09:15,770
حسناً، حان وقت تقطيعهن

103
00:09:27,150 --> 00:09:28,420
!مُسدّس، جاهز

104
00:09:32,680 --> 00:09:35,280
أنا كوزي شينا من وكالة التّحقيق حول الكائنات الحيّة
،الخطيرة التّابعة للأمم المُتّحدة

105
00:09:35,280 --> 00:09:37,670
!وحدة الإبادة إكشيد

106
00:09:37,950 --> 00:09:40,540
!آسفة لتأخُّري! أنا هنا لإنقاذكن

107
00:09:46,310 --> 00:09:48,040
!شينوميا مانا

108
00:09:48,040 --> 00:09:50,140
أنتِ رهن الاعتقال بتهمة إخفاء

109
00:09:50,140 --> 00:09:52,240
!سلَف وتصنيع عقاقير غير قانونيّة

110
00:09:52,740 --> 00:09:54,080
!شينا

111
00:09:54,080 --> 00:09:55,950
!—تووا، يسرّني أنّك بخـ

112
00:09:56,210 --> 00:09:58,190
!لحظة، لستُن بخير؟

113
00:09:58,470 --> 00:10:01,100
!يونا والأُخريات على حافّة الموت أيضاً

114
00:10:01,100 --> 00:10:03,750
!اصمدن، سأنقذكن حالاً

115
00:10:04,490 --> 00:10:06,950
هذا مُؤلم

116
00:10:08,360 --> 00:10:11,330
تلقّيتُ ضرراً من هذه؟

117
00:10:11,810 --> 00:10:13,460
...هذا أشبه بـ

118
00:10:13,460 --> 00:10:16,830
طاقة حياتي قد انخفضت؟

119
00:10:17,170 --> 00:10:18,350
...أيُعقَل

120
00:10:19,200 --> 00:10:21,400
...أيُعقَل أنّ تلك الفتاة

121
00:10:23,200 --> 00:10:25,740
!تمتلك نفس قوّتها؟

122
00:10:26,870 --> 00:10:27,980
!لا

123
00:10:28,790 --> 00:10:31,980
!إنّها تلك الفتاة

124
00:10:32,570 --> 00:10:33,570
!أنتِ

125
00:10:34,480 --> 00:10:35,980
كوزي-تشان؟

126
00:10:35,980 --> 00:10:39,330
كيف حصلتِ على قوّتكِ تلك؟

127
00:10:39,330 --> 00:10:42,500
هل تعرفين شيطانيّة تُدعى سيتسونا؟

128
00:10:42,500 --> 00:10:45,680
تِلك هي قوّتها، أليس كذلك؟

129
00:10:46,860 --> 00:10:50,460
عرفتُ بأنّني لم أقتلها بشكل كامل

130
00:10:50,460 --> 00:10:51,960
لكن أنا مسرورة

131
00:10:51,960 --> 00:10:55,140
مسرورة لأنّ قوّة تلك السّلَف قد بقيتْ

132
00:10:55,500 --> 00:11:00,770
هل أكلتِ سيتسونا بعد أن كادت تموت وهربتْ؟

133
00:11:00,770 --> 00:11:04,140
أهكذا حصلتِ على تِلك القوى النّاريّة؟

134
00:11:04,330 --> 00:11:08,060
!فهمت! إنّها ميّتة الآن إذاً

135
00:11:08,060 --> 00:11:11,960
!مع بقاء قِواها سليمة

136
00:11:15,400 --> 00:11:18,560
!حالفكِ حظٌّ عظيمٌ يا كوزي-تشان

137
00:11:18,560 --> 00:11:22,400
!أعطيني قوّتكِ

138
00:11:28,610 --> 00:11:30,120
!مهلاً

139
00:11:30,120 --> 00:11:32,780
!كنتُ أطلب منكِ بهدوء

140
00:11:40,180 --> 00:11:41,540
!مُسدّس، جاهز

141
00:11:42,090 --> 00:11:46,240
!كفّي عن هذا الكلام الفارغ حول أختي الصُّغرى

142
00:11:46,240 --> 00:11:47,350
أختكِ الصُّغرى؟

143
00:11:47,350 --> 00:11:48,560
!هذا غير مُهمّ

144
00:11:48,560 --> 00:11:51,610
!يمكنني أن أسألكِ عن أيّ شيء بعد أن أتبنّاكِ

145
00:11:51,610 --> 00:11:54,260
!لذا إذا سمحتِ لي باعتقالكِ بهدوء، فلا بأس

146
00:11:54,260 --> 00:11:57,380
!لكن إذا قاومتِ، فسوف أسحقكِ

147
00:11:57,840 --> 00:11:59,560
تمزحين، أليس كذلك؟

148
00:11:59,560 --> 00:12:01,560
!سنتمكّن أخيراً من رؤية بعضنا الآخر

149
00:12:06,680 --> 00:12:11,130
تنبع هذه القوّة من شيطانيّة وُلِدت
من سلَف مثلما حدث معي

150
00:12:20,250 --> 00:12:24,890
!قد أصبح أكثر قوّة حتّى بتلك القوّة

151
00:12:24,890 --> 00:12:26,880
قوّة تووا-تشان

152
00:12:26,880 --> 00:12:30,390
وقوّة السّلَف سيتسونا

153
00:12:30,390 --> 00:12:32,610
!ستكون مُلكي

154
00:12:34,740 --> 00:12:36,530
!اصمتي! كفّي عن الثّرثرة

155
00:12:37,290 --> 00:12:40,600
تووا، والجميع، انتظرن إنقاذ إكشيد

156
00:12:40,600 --> 00:12:43,020
المُسعِفون في طريقهم

157
00:12:43,020 --> 00:12:44,280
...لكن

158
00:12:44,280 --> 00:12:48,410
سحقها واعتقالها هو واجبي

159
00:12:48,850 --> 00:12:50,200
دعنَ الأمر لي

160
00:12:50,970 --> 00:12:55,090
سأحرص على أن تُعاني مثلما عانيتُن أيضاً

161
00:12:55,750 --> 00:12:57,090
أعِدُكن بذلك

162
00:12:57,840 --> 00:12:58,750
...لكن

163
00:12:59,170 --> 00:13:03,170
،إذا شعرتُ بأنّها أقوى من اللّازم
فقد أطلب مُساعدتكن

164
00:13:03,670 --> 00:13:06,590
إن حدث ذلك، فأعتذر حينها، لكن ساعدنَني

165
00:13:07,830 --> 00:13:08,870
!حسناً

166
00:13:13,560 --> 00:13:18,090
هذه الفتاة قد ورثتْ كامل قوّة سيتسونا

167
00:13:18,490 --> 00:13:24,240
في كلّ مرّة تجرحني فيها، تستنزف
!حياتي وقوّتي

168
00:13:26,830 --> 00:13:29,380
إذا قاتلنا هنا، فسوف نُعرّض الجميع لخطر

169
00:13:29,380 --> 00:13:30,820
!لذا سنُبدِّل المواقع

170
00:13:31,530 --> 00:13:32,830
!لننتقل إلى الأعلى

171
00:13:44,110 --> 00:13:45,010
!مهلاً

172
00:13:46,500 --> 00:13:48,640
!على رسلكِ

173
00:13:52,800 --> 00:13:53,810
!ماذا؟

174
00:13:53,810 --> 00:13:55,760
!...يا للتهوُّر

175
00:13:55,760 --> 00:13:57,790
!سأسحقكِ

176
00:14:39,210 --> 00:14:40,730
ينبغي أن تكون هنا قريباً، صحيح؟

177
00:14:43,940 --> 00:14:45,220
!ها هي ذي

178
00:14:50,020 --> 00:14:51,480
!غضب الرّعد

179
00:15:04,750 --> 00:15:06,350
!آسفة لو تأخّرتُ يا نانوها

180
00:15:06,350 --> 00:15:08,180
!ساعدتِني كثيراً يا فيت-تشان

181
00:15:08,480 --> 00:15:11,350
شينا-سان ستأسر شينوميا لأجلنا

182
00:15:11,680 --> 00:15:14,480
!لنتعامل مع زيرو معاً

183
00:15:14,480 --> 00:15:15,430
!حسناً

184
00:15:19,420 --> 00:15:21,450
شكراً على الدّروع

185
00:15:21,450 --> 00:15:22,300
!العفو

186
00:15:28,100 --> 00:15:31,760
نمط إكستيم، فول بريكر

187
00:15:32,690 --> 00:15:35,000
،التّصويب على الجُزيئات المُتناغمة

188
00:15:35,000 --> 00:15:37,820
جمع وتكثيف الطّاقة إلى عصفة إبادة

189
00:15:42,880 --> 00:15:44,480
تمّت عمليّة الجمع

190
00:15:44,480 --> 00:15:45,490
استعداد للإطلاق

191
00:15:48,720 --> 00:15:49,720
إطلاق

192
00:16:09,140 --> 00:16:11,820
فاقت قوّات الأُمم المُتّحدة التوقُّعات

193
00:16:12,450 --> 00:16:15,150
،تمّت السّيطرة على قرابة 90% من هذا المركز

194
00:16:15,150 --> 00:16:17,070
...ومُعظم مرتزقتنا قد

195
00:16:17,390 --> 00:16:18,370
ومانا؟

196
00:16:18,720 --> 00:16:21,540
مانا-ساما تشتبك حاليّاً في معركة
مع شيطانيّة الأمم المُتحدّة

197
00:16:21,540 --> 00:16:23,160
ورسالة لك يا كوراغي-ساما

198
00:16:23,720 --> 00:16:28,220
،مفادها، "اختبئ في مكان آمن
"وسأتواصل معك ثانية قريباً

199
00:16:39,710 --> 00:16:42,220
هل تمانع أن تخبرنا

200
00:16:42,220 --> 00:16:48,150
عن كافّة نشاطاتك غير القانونيّة المُتعلّقة
بالعقاقير وعلاقتك بشينوميا-سان؟

201
00:16:50,090 --> 00:16:51,130
حسناً

202
00:17:38,400 --> 00:17:41,660
،يبدو أنّكِ تواجهين صعوبة في التصدّي لضربة واحدة

203
00:17:41,660 --> 00:17:43,880
لذا ما رأيكِ بهذه؟

204
00:18:09,070 --> 00:18:12,980
إنّها تستمرّ في امتصاص طاقة حياتي فعلاً

205
00:18:12,980 --> 00:18:15,260
!يا لها من قوّة هائلة

206
00:18:15,260 --> 00:18:16,510
!هذا قاسٍ جدّاً

207
00:18:20,430 --> 00:18:24,270
رغم ذلك، أنا مُستعدّة للقتال ضدّ
سيتسونا هذه المرّة

208
00:18:24,970 --> 00:18:29,710
تبدين وكأنّكِ تتألّمين أو ما شابه الآن

209
00:18:33,180 --> 00:18:35,540
أتؤلمكِ معدتكِ من الأكل المُفرط؟

210
00:18:35,540 --> 00:18:37,220
لا تستطيعين الحركة بعد الآن؟

211
00:18:37,780 --> 00:18:41,330
قضيتُ 10 سنوات أجمع كُلّ هذه القوّة

212
00:18:41,330 --> 00:18:45,470
مُحال أن تتمكّني من امتصاصها كُلّها
خلال فترة قصيرة، صحيح؟

213
00:18:45,730 --> 00:18:49,650
،لكن إن لم تستمرّي في امتصاصها
فلا يمكنكِ هزيمتي

214
00:18:50,070 --> 00:18:53,370
والآن، هلّا أعدتِها؟

215
00:18:53,370 --> 00:18:57,240
كُلّاً من طاقة حياتي وقوّة سيتسونا

216
00:18:59,310 --> 00:19:01,240
كافّة الشّيطانيّين والأنواع الغازية

217
00:19:01,490 --> 00:19:06,120
هي وجبات خفيفة وذلك كي أتمكّن
من أن أصبح أقوى

218
00:19:06,400 --> 00:19:11,370
والآن أحسِني السُّلوك واملئي بطني، اتّفقنا؟

219
00:19:19,750 --> 00:19:23,480
!لا أريد عيش تلك التّجربة ثانية

220
00:19:36,220 --> 00:19:38,540
!مُسدّس، جاهز

221
00:19:39,290 --> 00:19:40,530
!مهلاً! مهلاً

222
00:19:46,560 --> 00:19:47,790
!يا للهول، يا للهول

223
00:19:48,270 --> 00:19:49,940
...على هذا المُعدّل

224
00:20:06,620 --> 00:20:07,370
!انتظري

225
00:20:07,370 --> 00:20:08,590
!مهلاً

226
00:20:34,460 --> 00:20:36,960
!ما زال بمقدوري القتال

227
00:20:43,110 --> 00:20:47,380
!والآن... أستطيع سرقتها

228
00:21:18,960 --> 00:21:20,440
شينا

229
00:21:23,320 --> 00:21:24,940
...هذا الاهتزاز

230
00:21:25,420 --> 00:21:27,630
هل نجتْ شينا-سان؟

231
00:21:27,630 --> 00:21:29,770
!أجل، أنا متأكّدة

232
00:21:33,210 --> 00:21:34,190
...لم

233
00:21:35,870 --> 00:21:37,450
ينتهِ الأمر بعد

234
00:21:49,420 --> 00:21:51,150
...شينوميا

235
00:21:52,220 --> 00:21:55,090
!لا تزال حيّة

236
00:23:30,110 --> 00:23:33,280
نيرانكِ ونيران سيتسونا جميلة حقّاً

237
00:23:33,280 --> 00:23:34,680
أجل. إنّها كنزي