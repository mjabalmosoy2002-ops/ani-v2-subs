1
00:01:36,820 --> 00:01:37,800
تووا؟

2
00:01:39,250 --> 00:01:41,470
إنّها شيطانيّةٌ أيضاً؟

3
00:01:42,590 --> 00:01:45,930
شينا، أنتِ شيطانيّةٌ مع الأُمم المُتّحدة؟

4
00:01:48,340 --> 00:01:50,530
!تووا-سان! أنباء سيّئة

5
00:01:52,220 --> 00:01:53,820
أعضاء سفّاحي الشّيطانيّين؟

6
00:01:54,620 --> 00:01:57,390
!لهبٌ الأُمم المُتّحدة

7
00:01:57,390 --> 00:01:59,070
كلتاكما، انتظرا

8
00:01:59,070 --> 00:02:00,380
...لكن

9
00:02:00,700 --> 00:02:04,150
المعذرة، شكراً على المرّة السّابقة

10
00:02:05,960 --> 00:02:09,500
طلبَ مقرُّنا تعاونكم، صحيح؟

11
00:02:09,500 --> 00:02:12,660
يبدو أنّ الرّسالة قد وصلَتْكم، لذا
لذا كان هذا مُفيداً جدّاً

12
00:02:11,750 --> 00:02:12,660
!ماذا؟

13
00:02:13,030 --> 00:02:17,600
كان الأمر أقرب إلى إلحاحكِ
!وانبعاث هالة سيّئة منكِ

14
00:02:17,600 --> 00:02:19,680
أوي، ما هي الأنباء السّيّئة؟

15
00:02:19,680 --> 00:02:22,460
...فـ-في الواقع، هذا

16
00:02:23,780 --> 00:02:26,620
أعلنتْ يورومي تووا عن نفسها
،كسفّاحة شيطانيّين

17
00:02:26,620 --> 00:02:29,810
مُستخدمةً العنف ضدّ المدنيّين
،وتدمير مُنشآت

18
00:02:29,810 --> 00:02:32,770
بالإضافة إلى جرائم أُخرى مثل الاختلاس

19
00:02:32,770 --> 00:02:37,130
أدرجتْها الشّرطةُ علناً كمُتَّهمة مطلوبة

20
00:02:37,130 --> 00:02:40,180
في العمليّة الإرهابيّة واسِعة النّطاق
في الولاية 4

21
00:02:40,180 --> 00:02:41,430
!ماذا؟

22
00:02:41,660 --> 00:02:45,110
بالإضافة إلى ذلك، مكتب الجرائم المُنظَّمة الخاصّ
بفرع الأمانة العامّة

23
00:02:45,110 --> 00:02:48,070
طالبَ بتعاون وحدة الإكشيد التّابعة
،للأُمم المُتَّحدة

24
00:02:48,070 --> 00:02:50,430
الّذي يتعامل مع الإجراءات المُضادّة
للأنواع الغازية

25
00:02:51,410 --> 00:02:55,090
أعلنت الشّرطةُ بأنّها شاركت
معلومات حول يورومي المُتَّهمة

26
00:02:55,090 --> 00:02:57,290
وتسعى لاعتقالها في أسرع وقت مُمكن

27
00:02:58,760 --> 00:03:01,450
تجري المُنظَّمات المُرتبِطة تحرّيات

28
00:03:01,450 --> 00:03:03,510
حول أهداف المُتَّهمة يورومي وانحرافها

29
00:03:05,610 --> 00:03:08,400
...شينا، هل

30
00:03:08,400 --> 00:03:11,830
تقرّبتِ منّي للتحرِّي حول سفّاحي الشّيطانيّين؟

31
00:03:11,830 --> 00:03:12,700
!ماذا؟

32
00:03:12,700 --> 00:03:14,440
!قطعاً لا

33
00:03:14,440 --> 00:03:17,310
!لن أتحمّل هذا، حتّى منكِ

34
00:03:17,600 --> 00:03:20,210
إذاً فسِّري تلك القوّة النّاريّة

35
00:03:21,580 --> 00:03:23,910
...أنا آسفة لإخفاء الأمر، لكن

36
00:03:23,910 --> 00:03:27,050
أين وكيف حصلتِ على قوّةٍ كهذه؟

37
00:03:27,050 --> 00:03:29,590
هل استخدمتِ العقاقير بأمر شخص؟

38
00:03:30,470 --> 00:03:31,740
عقاقير؟

39
00:03:31,740 --> 00:03:36,970
هل فعلتِها بأمر من مُنظَّمة إكشيد
تلك في الأُمم المُتَّحدة؟

40
00:03:36,970 --> 00:03:38,420
!أنتِ مُخطئة

41
00:03:38,420 --> 00:03:40,390
!لم أستخدم أي عقاقير

42
00:03:40,390 --> 00:03:44,300
أصبحتُ شيطانيّة بالصّدفة، ثمّ
!اكتشفَتْني إكشيد

43
00:03:44,300 --> 00:03:48,250
كنتُ فتاة ثانويّة عاديّة أعيش
!في جزيرة نائية

44
00:03:49,060 --> 00:03:52,670
قوّة شيطانيّة اللّهب خطيرةٌ للغاية

45
00:03:53,070 --> 00:03:57,730
شيطانيّة اللّهب الّتي عرفتُها
لم تكن تستطيع التحكُّم بقِواها

46
00:03:58,750 --> 00:04:02,810
واستُخدِمَتْ كسلاح انتحاريّ
في هجوم إرهابيّ على مطار

47
00:04:03,750 --> 00:04:06,850
أسقطتْ معها عدداً لا يُحصى من النّاس

48
00:04:07,850 --> 00:04:09,120
أنا آسفة

49
00:04:09,120 --> 00:04:11,260
...لا أعرف شيئاً عن تلك الفتاة، لكن

50
00:04:11,660 --> 00:04:15,010
أعتقد بأنّ تلك القوّة مُختلفة

51
00:04:15,010 --> 00:04:16,780
!حتّى لو كانت مُختلفة

52
00:04:17,390 --> 00:04:21,670
أنا سفّاحةٌ شيطانيّة، لذا لا أستطيع السّماح
لشيطانيّين آخرين بالتجوُّل بحرّيّة

53
00:04:22,620 --> 00:04:24,950
أعطيني تلك القوّة

54
00:04:25,640 --> 00:04:27,900
،قد يؤلم هذا قليلاً

55
00:04:27,900 --> 00:04:30,980
لكن قدرتي تسمح لي بسرقة
قوّة الشّيطانيّين الآخرين

56
00:04:33,220 --> 00:04:36,680
سأزيل تلك القوّة الخطيرة عنكِ

57
00:04:37,630 --> 00:04:40,410
أنا آسفة. لا أستطيع السّماح بذلك

58
00:04:40,790 --> 00:04:45,420
لستُ نفس شيطانيّة اللّهب تلك
،الّتي كنتِ تعرفينها

59
00:04:45,850 --> 00:04:47,910
وقوّتي هذه

60
00:04:47,910 --> 00:04:51,050
هي هديّة من شخص عزيز عليّ

61
00:04:59,520 --> 00:05:03,580
!لا يُفترض للبشر أن يمتلِكوا قوّةَ شيطانيّ

62
00:05:03,580 --> 00:05:08,230
لذا يموت كثيرٌ من النّاس بسبب الشّيطانيّين
!وعقاقير الشّيطانيّين

63
00:05:08,230 --> 00:05:10,420
!لذا فَسُدَت حياة كثير من النّاس

64
00:05:10,770 --> 00:05:12,220
!أعلم

65
00:05:12,220 --> 00:05:15,500
غُرِقَتْ حياتي بحدِّ ذاتها في فوضى
!بواسطة شيطانيّ

66
00:05:16,550 --> 00:05:18,610
!قتلَ أختي الصُّغرى

67
00:05:21,230 --> 00:05:23,430
نفس الأمر ينطبق على حُلفائكِ، صحيح؟

68
00:05:23,760 --> 00:05:27,760
جميعهم خسروا شيئاً عزيزاً عليهم
!بسبب الشّيطانيّين والغُزاة

69
00:05:28,130 --> 00:05:31,880
!هُم وأحبّاؤهم أصابتهم الفاجعة

70
00:05:40,940 --> 00:05:46,320
لهذا السّبب تصطادين الشّيطانيّين
حتّى عندما يشتدّ الأمر

71
00:05:46,890 --> 00:05:49,030
لهذا ترغبين في التّضحية بنفسكِ

72
00:05:49,030 --> 00:05:51,940
لإنقاذ الآخرين من تلك المأساة

73
00:05:52,290 --> 00:05:53,190
هل أنا مُخطئة؟

74
00:05:58,040 --> 00:06:01,080
،لن أعتقلكِ هنا يا تووا

75
00:06:01,570 --> 00:06:05,730
وسأشهد بأنّكِ لم تكوني الجانية
!في هذه القضيّة

76
00:06:05,730 --> 00:06:06,310
—لذا

77
00:06:06,310 --> 00:06:07,220
هذا لا يكفي

78
00:06:07,770 --> 00:06:10,000
الكلام وحده لا يُغيِّر شيئاً

79
00:06:11,460 --> 00:06:14,960
إذا كان أصحاب النُّفوذ وأولئك الّذين
يتحكّمون بالسّرد

80
00:06:14,960 --> 00:06:17,440
قد اعتبروني شرّيرة، فالأمر انتهى إذاً

81
00:06:18,220 --> 00:06:20,460
سأمسح الشّيطانيّين الّذين صُنِعوا
،بواسطة العقاقير

82
00:06:20,460 --> 00:06:23,730
،والعقاقير الّتي تصنع الشّيطانيّين
عن هذا العالم

83
00:06:24,360 --> 00:06:26,790
،لهذا ما زلتُ حيّة إلى اليوم

84
00:06:26,790 --> 00:06:29,110
وسأسخِّر حياتي لتلك الغاية

85
00:06:29,110 --> 00:06:30,120
...هذا

86
00:06:30,120 --> 00:06:32,440
!سأفعل المُستحيل لتحقيق ذلك

87
00:06:32,440 --> 00:06:34,180
،لأجل الأطفال الّذين حُرِموا من عائلاتهم

88
00:06:34,180 --> 00:06:37,290
والّذين سُحِقَتْ حياتهم وكرامتهم
!بواسطة شيطانيّين

89
00:06:38,330 --> 00:06:40,880
ولأجل أمّي وأبي اللّذين احترقا حتّى الموت

90
00:06:40,880 --> 00:06:43,830
!بعد أن اعتبراني عائلتهما

91
00:06:45,100 --> 00:06:46,390
...لكن

92
00:06:54,200 --> 00:06:58,130
،لستُ أفهم الأمور المُعقَّدة حقّاً

93
00:06:58,510 --> 00:07:03,130
لكنّكِ قادرة على عيش حياة طبيعيّة
،لأنّكِ تعملين لصالح الأُمم المُتَّحدة

94
00:07:03,130 --> 00:07:05,060
لذا أنتِ سعيدةٌ جدّاً، صحيح؟

95
00:07:05,730 --> 00:07:08,990
لا أريد سماع جِدال أنانيّ
،من أشخاص يعيشون بهناء

96
00:07:08,990 --> 00:07:12,150
ولا ينبغي لتووا-تشان أن تفعل أيضاً

97
00:07:12,530 --> 00:07:15,720
لا يمكنكِ إنقاذ أحد هكذا

98
00:07:15,720 --> 00:07:19,530
لا أنا ولا تووا ولا الأشخاص الّذين ماتوا

99
00:07:19,900 --> 00:07:21,660
،أنا آسفة

100
00:07:21,990 --> 00:07:25,890
لكن لا ننوي طاعة الأُمم المُتَّحدة
أو أي مُنظَّمة أُخرى

101
00:07:26,580 --> 00:07:29,670
!لن نتوقّف عن قتل الشّيطانيّين

102
00:07:30,250 --> 00:07:33,550
...شينا، تلك القوّة النّاريّة

103
00:07:33,550 --> 00:07:35,790
،إنّها خطيرةٌ حقّاً

104
00:07:35,790 --> 00:07:38,180
،ولا أريدكِ أن تُستغَلّي بواسطة شخص آخر

105
00:07:38,750 --> 00:07:40,600
لذا أودُّ استئصالها

106
00:07:40,600 --> 00:07:44,440
هذا هو رأيي، لكن جماعة الأُمم المُتَّحدة

107
00:07:44,440 --> 00:07:48,480
والشّخص الّذي منحكِ تلك القوّة
،أهمّ بالنّسبة لكِ منّي

108
00:07:49,020 --> 00:07:51,190
ويمكنكِ الوثوق بهم؟

109
00:07:51,190 --> 00:07:52,610
...هذا

110
00:07:52,610 --> 00:07:55,310
!أنتِ مُخطئة! الأمر ليس كذلك

111
00:07:59,250 --> 00:08:00,580
...نيراني هي

112
00:08:01,130 --> 00:08:03,330
قُوّتي تُمتَصّ؟

113
00:08:25,020 --> 00:08:30,720
كانت هذه الهديّة الأخيرة الّتي تُمنَح
لي بواسطة شخص عزيز

114
00:08:31,690 --> 00:08:34,100
!لذا لا أستطيع تسليمها

115
00:08:34,750 --> 00:08:36,510
...هذا صحيحٌ إذاً

116
00:08:36,510 --> 00:08:41,130
تقاطعَ طريقانا فحسب، وتبادلنا
بضعة كلمات

117
00:08:42,050 --> 00:08:44,410
هذا كُلّ ما كان يدور بيننا في نهاية المطاف

118
00:08:45,350 --> 00:08:46,490
!هذا غير صحيح

119
00:08:46,490 --> 00:08:47,880
!ليس هذا بيت القصيد

120
00:08:51,940 --> 00:08:55,940
لقد استمتعتُ، ولو أنّها كانت فترة قصيرة

121
00:09:01,870 --> 00:09:03,520
لن نرى بعضنا الآخر ثانية أبداً

122
00:09:04,530 --> 00:09:05,760
وداعاً

123
00:09:10,850 --> 00:09:12,280
!المُديرة ياغامي

124
00:09:12,280 --> 00:09:13,730
—هذا الإعلان

125
00:09:13,730 --> 00:09:15,550
!هذا صحيح يا هاياتي-تشان

126
00:09:15,550 --> 00:09:19,740
إذا أصدروا بياناً كهذا بعد
...أن طلبنا مُساعدتهم

127
00:09:19,740 --> 00:09:24,800
أجل، الشّرطة والصّحُف كلاهما
يُعلنان عن هذا من تلقاء أنفسهم

128
00:09:25,170 --> 00:09:29,770
،تحرَّكوا بصورةٍ أسرع ممّا توقّعت
ولم أستطع منعهم

129
00:09:30,540 --> 00:09:33,610
صحيح أيضاً بأنّني أخبرتُهم سلفاً
بأنّنا لن ندّخر جهداً

130
00:09:33,610 --> 00:09:36,250
لمُساعدتهم في تحرّياتهم حول
،جرائم الشّيطانيّين

131
00:09:40,550 --> 00:09:42,170
كانت تلك غلطتي

132
00:09:42,170 --> 00:09:43,570
!أنا آسفة جدّاً

133
00:09:43,930 --> 00:09:46,970
تبدو تحرُّكات الشّرطة مشبوهة، أليس كذلك؟

134
00:09:46,970 --> 00:09:48,600
هل ينبغي أن أُحقِّق؟

135
00:09:48,600 --> 00:09:50,280
أجل، من فضلكِ

136
00:09:53,540 --> 00:09:57,940
سيترتّب علينا اعتقال سفّاحي الشّيطانيّين
قبل أن تفعل الشّرطة، صحيح؟

137
00:09:57,940 --> 00:09:59,260
هذا صحيح

138
00:09:59,260 --> 00:10:00,830
يجب علينا اعتقالهم

139
00:10:00,830 --> 00:10:04,570
إذا اصطدموا مع الشّرطة، فالجميع
في خطر حينئذ

140
00:10:04,950 --> 00:10:06,310
،على الأقلّ

141
00:10:06,310 --> 00:10:12,380
شينا-سان وأنا نستطيع أن نشهد بأنّهم
تعاونوا معنا في هذه المهمّة الأخيرة

142
00:10:14,010 --> 00:10:15,350
...على ذكر الأمر

143
00:10:15,350 --> 00:10:16,380
كوزي-سان؟

144
00:10:16,380 --> 00:10:18,070
كوزي هنا

145
00:10:18,070 --> 00:10:19,620
كيف هو الوضع؟

146
00:10:20,000 --> 00:10:22,470
...في الحقيقة

147
00:10:23,630 --> 00:10:27,090
كانت سفّاحة الشّيطانيّين صديقتك؟

148
00:10:27,090 --> 00:10:28,300
أجل

149
00:10:28,300 --> 00:10:31,690
حاولتُ إقناعها، لكن لم أستطع إيقافها

150
00:10:32,170 --> 00:10:35,810
،يُؤلمني إجراء هذه المُحادثة

151
00:10:35,810 --> 00:10:39,400
لكن بصِفتي صديقتها، هل هناك
أي معلومات اكتسبتِها

152
00:10:39,400 --> 00:10:41,290
تستطيعين الكشف عنها باطمئنان؟

153
00:10:41,290 --> 00:10:42,490
...أجل

154
00:10:42,820 --> 00:10:45,440
شينا-سان، هل أنتِ بخير؟

155
00:10:45,440 --> 00:10:47,570
أ-أجل

156
00:10:47,570 --> 00:10:52,070
شعرتُ وكأنّنا كنّا نتجادل ونجرح
بعضنا الآخر فحسب

157
00:10:52,640 --> 00:10:56,100
لكن سأكون بخير. شكراً على القلق بشأني

158
00:10:56,100 --> 00:10:57,320
العفو

159
00:11:04,830 --> 00:11:05,950
...تووا

160
00:11:14,880 --> 00:11:16,640
!إيجي-كن

161
00:11:17,160 --> 00:11:19,490
!سمعتُ الأخبار في المُختبر

162
00:11:19,490 --> 00:11:22,450
حرّكتَ الشّرطة والأُمم المُتّحدة
تجاه هذه القضيّة؟

163
00:11:22,450 --> 00:11:23,630
أجل

164
00:11:23,630 --> 00:11:28,110
بضعة من زبائنك المُنتظمين هُم
مسؤولون في سلك الشّرطة

165
00:11:28,750 --> 00:11:32,560
إنَّ القبض السّريع على الجاني المسؤول
عن هذا الحادِث الإرهابيّ على نِطاق مدينة

166
00:11:32,560 --> 00:11:36,780
كان بمثابة جزرة شهيّة للضبّاط
النّخبة الّذين اقتربَ تقاعدهم

167
00:11:37,290 --> 00:11:40,100
البالغون وقِحون للغاية

168
00:11:40,100 --> 00:11:43,200
أتعتقد بأنّ هذا سيُقنع تووا-تشان لأجلنا؟

169
00:11:43,200 --> 00:11:46,620
،من خلال بحثي، إنّها ليست حمقاء
،لكنّها عاطفيّة حسّاسة

170
00:11:46,620 --> 00:11:49,880
وهي من النّوع الّتي لا تستطيع
التخلّي عن أصدقائها

171
00:11:50,900 --> 00:11:55,300
ينبغي أن تكون الرّسالة الّتي أرسلتُها
قد وصلَتْها، ولا بُدّ أن تكون فعّالة

172
00:11:55,300 --> 00:11:57,010
رسالة؟

173
00:11:57,010 --> 00:11:59,060
حسناً، انتظري وسترين فحسب

174
00:11:59,060 --> 00:12:03,000
،إن لم تكشف عن نفسها قريباً
هناك خُطوات أُخرى أستطيع اتّخاذها

175
00:12:03,000 --> 00:12:04,310
!حسناً

176
00:12:04,310 --> 00:12:05,950
!أتشوّق لذلك

177
00:12:12,950 --> 00:12:17,040
تطلب الشّرطة أي معلومات حول
رؤية المُتَّهمة يورومي تووا

178
00:12:17,040 --> 00:12:22,470
بخصوص الحادث الإرهابيّ الّذي
وقع في الولاية 4

179
00:12:19,830 --> 00:12:22,970
يونا، أطفئي التّلفزيون

180
00:12:22,970 --> 00:12:25,900
يجب أن نُتابع معلوماتهم، صحيح؟

181
00:12:25,900 --> 00:12:27,730
شيوري تريد أن تعرف

182
00:12:27,980 --> 00:12:29,270
...أجل، لكن

183
00:12:29,270 --> 00:12:33,510
الشّرطة والإعلام كلاهما يتجاهلان
جرائم الشّيطانيّين

184
00:12:33,510 --> 00:12:37,060
الآن بعد أن صاروا يلومون تووا-سان على جريمة
،لم تكن لها أي صِلة بها

185
00:12:37,060 --> 00:12:39,480
!ويحاولون اعتقالها بعد كُلّ هذا الوقت

186
00:12:39,750 --> 00:12:43,740
من المعروف أنّ هناك عدداً
،من سفّاحيّ الشّيطانيّين

187
00:12:43,740 --> 00:12:47,000
لكن الأنباء لا تُذيع سوى معلومات تووا-سان

188
00:12:47,450 --> 00:12:51,640
إنّهم يتحكَّمون بالمعلومات لتصوير سفّاحيّ
،الشّيطانيّين كمُجرمين خطيرين

189
00:12:52,490 --> 00:12:56,640
مع ذلك لا يُعلنون عن شيء بشأننا

190
00:13:00,000 --> 00:13:01,360
إلى أين أنتِ ذاهبة؟

191
00:13:01,360 --> 00:13:02,750
لرؤية يوزو

192
00:13:05,090 --> 00:13:10,060
،إذاً يريدون تووا-سان فقط
وهُم غير قلقين بشأننا؟

193
00:13:11,840 --> 00:13:13,440
"...سفّاحو الشّيطانيّين

194
00:13:13,440 --> 00:13:16,460
"رُبّما يورومي تووا لا تتصرّف لوحدها"

195
00:13:16,460 --> 00:13:20,030
سيتمّ تعيينهم مطلوبين أيضاً"
"حالما تتوضَّح مزيدٌ من التّفاصيل

196
00:13:20,030 --> 00:13:23,160
!أنا جاهزة! اجعلوني مطلوبة جميعاً

197
00:13:23,160 --> 00:13:26,050
!نحن سفّاحو شيطانيّين أيضاً

198
00:13:26,860 --> 00:13:30,770
نحن في هذا الظّرف فقط لأنّني فاشلة

199
00:13:36,220 --> 00:13:38,500
!لما حدث هذا

200
00:13:45,330 --> 00:13:46,450
تووا-سان؟

201
00:13:47,300 --> 00:13:51,450
لم تعثري على مُختبَر أبحاث شينوميا بعد، صحيح؟

202
00:13:51,450 --> 00:13:52,940
أنا آسفة

203
00:13:52,940 --> 00:13:54,050
لا عليكِ

204
00:13:54,050 --> 00:13:57,320
أعلم بأنّكِ كنتِ تبذلين قصارى جهدكِ يا يوزو

205
00:13:59,730 --> 00:14:01,420
لكن الأمور بخير الىن

206
00:14:02,590 --> 00:14:05,570
سأستعير قوّتكِ يا يوزو

207
00:14:06,120 --> 00:14:07,940
تووا-سان...؟

208
00:14:07,940 --> 00:14:09,700
لماذا؟

209
00:14:11,700 --> 00:14:12,980
!تووا-سان

210
00:14:12,980 --> 00:14:14,110
!توقّفي

211
00:14:14,110 --> 00:14:15,590
!لماذا فعلتِ ذلك ليوزو؟

212
00:14:19,030 --> 00:14:20,760
أعتذر منكِ أيضاً يا أوي

213
00:14:22,720 --> 00:14:23,730
تووا-سان؟

214
00:14:23,730 --> 00:14:24,960
لا. لماذا؟

215
00:14:30,580 --> 00:14:31,860
تووا-سان؟

216
00:14:31,860 --> 00:14:33,840
!سمعتُ أوي تصرخ

217
00:14:34,420 --> 00:14:36,180
كلتاهما بأمان

218
00:14:36,180 --> 00:14:39,110
أستعير قوّتهما فحسب

219
00:14:39,110 --> 00:14:40,890
...تقصدين

220
00:14:40,890 --> 00:14:43,530
،شكراً لكما على مُساعدتي طوال هذا الوقت

221
00:14:43,530 --> 00:14:45,970
لكن سأتصرّف بمُفردي ثانية

222
00:14:46,560 --> 00:14:48,700
سأقابل شينوميا

223
00:14:49,370 --> 00:14:51,930
حقّاً؟ لكن كيف؟

224
00:14:51,930 --> 00:14:53,510
!وماذا تقصدين بـ"بمُفردكِ"؟

225
00:14:53,980 --> 00:14:56,870
أنتِ لا تنوين تسليم نفسكِ، صحيح؟

226
00:14:58,120 --> 00:15:00,290
تعتقدين بأنّ كوراغي وشينوميا يقفان وراء

227
00:15:00,290 --> 00:15:02,490
،العمليّة الإرهابيّة والإعلان

228
00:15:02,490 --> 00:15:06,300
وبأنّهما يستدعيانكِ إلى شينوميا؟

229
00:15:06,880 --> 00:15:11,620
هناك احتمالٌ كبير بأن يتمّ إرسالكِ
،إلى شينوميا إذا اعتُقِلتِ

230
00:15:11,960 --> 00:15:16,040
وتخطِّطين للإجهاز عليها بعد
أن يُسلِّموكِ لها

231
00:15:16,510 --> 00:15:17,650
هل أنا مُخطئة؟

232
00:15:18,300 --> 00:15:19,550
...في الواقع

233
00:15:19,930 --> 00:15:23,040
هدفهما هو أنا فقط

234
00:15:23,040 --> 00:15:26,270
هذا هو سبب عدم ذِكر أحد آخر في الأأنباء

235
00:15:26,270 --> 00:15:30,260
إن لم أذهب، فسوف يتّهمونكن أيضاً

236
00:15:30,260 --> 00:15:34,040
يُهدِّدون لجعل عودتكن إلى المُجتمع مُستحيلة

237
00:15:38,660 --> 00:15:42,040
،لذا إذا كانا يستدعيانني إليهما
فهذا جُلّ ما أُريده

238
00:15:42,600 --> 00:15:47,280
سأقتل شينوميا وأمنعها من توزيع
وتطوير عقاقير الشّيطانيّين

239
00:15:48,380 --> 00:15:49,850
!لا يمكنكِ

240
00:15:49,850 --> 00:15:51,730
!من الواضح بأنّه فخّ

241
00:15:51,730 --> 00:15:55,480
قد يبرحونكِ ضرباً أو يغمونكِ عن الوعي
!قبل حتّى أن تري شينوميا

242
00:15:55,480 --> 00:15:57,300
لا أُمانع ذلك

243
00:15:57,300 --> 00:16:00,310
العقاقير والقيود لا تنجح ضدِّي

244
00:16:00,310 --> 00:16:01,920
لكن أستطيع التّظاهر بأنّها كذلك

245
00:16:02,230 --> 00:16:07,340
على الأقلّ، أنا واثقة بأنّنا لن
!نكون عقبة في وجهكِ

246
00:16:08,190 --> 00:16:10,560
لذا إن كنتِ ستذهبين، فسنذهب
!جميعنا معاً إذاً

247
00:16:11,060 --> 00:16:12,410
!هذا صحيح

248
00:16:12,410 --> 00:16:16,520
أعيدي قوّة أو ويوزو. جميعنا نحن
!الخمسة نستطيع الذّهاب معاً

249
00:16:19,100 --> 00:16:20,930
...إن كنّا معاً، فأنا متأكِّدة

250
00:16:21,540 --> 00:16:24,000
...إن تعاونّا جميعنا معاً في هذا، فإذاً

251
00:16:24,000 --> 00:16:26,620
،مهما حدث أو كائناً من نُواجه

252
00:16:26,620 --> 00:16:29,670
!يمكننا حمايتكِ يا تووا-تشان

253
00:16:35,530 --> 00:16:36,600
!تووا-سان

254
00:16:44,810 --> 00:16:46,480
!قوّة الفتاة تلك؟

255
00:16:46,480 --> 00:16:49,780
كنتُ وحيدة من الأساس

256
00:16:49,780 --> 00:16:51,640
لا أُمانع أن أكون وحيدة حتّى الرّمق الأخير

257
00:16:52,020 --> 00:16:56,350
يمكنكما أن تكرهاني، أو يمكنكما
أن تنسياني تماماً

258
00:17:14,530 --> 00:17:17,940
سأستعير قوّتكما أيضاً

259
00:17:41,690 --> 00:17:43,200
أين تووا-سان؟

260
00:17:43,200 --> 00:17:44,400
أين الجميع؟

261
00:17:52,520 --> 00:17:54,560
...أوي، يوزو

262
00:17:57,310 --> 00:17:58,570
...الأنباء

263
00:17:58,570 --> 00:17:59,840
تفقّدي الأنباء

264
00:18:00,090 --> 00:18:01,720
أنباء عاجلة

265
00:18:01,720 --> 00:18:05,500
اليوم، يورومي تووا، المُتَّهمة المطلوبة
،بسبب الحادِث الإرهابيّ واسع النِّطاق

266
00:18:05,500 --> 00:18:08,910
سلّمتْ نفسها لمركز شرطة الولاية 4

267
00:18:08,910 --> 00:18:10,630
وتمّ اعتقالها فوراً

268
00:18:11,100 --> 00:18:14,430
نُقِلَتْ يورومي إلى مركز احتجاز خاصّ

269
00:18:14,430 --> 00:18:17,330
حيث سيجري استجوابها

270
00:18:18,900 --> 00:18:20,980
!مرحى! مرحى

271
00:18:20,980 --> 00:18:22,620
!فعلتها يا إيجي-كن

272
00:18:23,160 --> 00:18:26,660
توقّعتُ بأنّ فُرَص تسليم نفسها
،كانت مُنخفضة

273
00:18:26,660 --> 00:18:29,180
لكن أعتقد بأنّها أحمق ممّا توقّعت

274
00:18:30,490 --> 00:18:32,660
إنّها في زنزانة سجن، صحيح؟

275
00:18:32,660 --> 00:18:35,210
هل يمكننا استلامها حالاً؟

276
00:18:35,210 --> 00:18:39,290
هناك أمور كثيرة أريد دراستها
حالما تُنقَل إلى المُختبر

277
00:18:39,660 --> 00:18:43,010
من الأفضل أن ننتظر قليلاً ريثما
تهدأ الفوضى

278
00:18:43,010 --> 00:18:45,170
ما زالوا بحاجة لإجراء استجوابهم

279
00:18:46,520 --> 00:18:50,150
ألا تعتقد بأنّ تووا-تشان ستستخدم العنف
مع الشّرطة قبل ذلك الحين؟

280
00:18:50,480 --> 00:18:54,680
أخبرتُهم بأن يحقنوها بالمُهدِّئات
المُستخدَمة للشّيطانيّين في مُختبرنا

281
00:18:55,760 --> 00:18:58,770
سينتهي استجوابها قبل نهاية اليوم

282
00:19:00,650 --> 00:19:02,870
إذاً يمكننا الذّهاب لنقلها

283
00:19:03,390 --> 00:19:04,660
!حسناً

284
00:19:05,990 --> 00:19:09,670
!أتطلّع قُدماً حقّاً لرؤية تووا-تشان

285
00:19:09,670 --> 00:19:14,670
أتساءل كيف ستستجيب عندما يلتمّ شملنا

286
00:19:20,200 --> 00:19:22,330
يجب علينا إنقاذ تووا-سان

287
00:19:22,670 --> 00:19:25,680
شيوري، هل من شيء يمكننا فعله؟

288
00:19:25,950 --> 00:19:29,440
.لم يمضِ وقتٌ طويل منذ اعتقالها
،إذا أسرعنا

289
00:19:29,440 --> 00:19:34,060
فقد نتمكّن من استعادة تووا-سان قبل
أن تُرسَل إلى شينوميا

290
00:19:34,410 --> 00:19:36,680
لكن كيف؟

291
00:19:36,680 --> 00:19:41,390
من دون قِوانا، نحن مُجرّد مدنيّات عاديّات

292
00:19:41,390 --> 00:19:43,480
،لا يمكننا اختراق مركز الشّرطة

293
00:19:43,480 --> 00:19:46,200
وقد لا نتمكّن من هزيمة ضابط
شرطيّ عاديّ أيضاً

294
00:19:46,970 --> 00:19:48,260
!ولو كان كذلك

295
00:19:48,260 --> 00:19:51,040
!أكره فكرة التخلِّي عن تووا-سان

296
00:19:51,040 --> 00:19:52,640
!أكره ذلك قطعاً

297
00:19:52,640 --> 00:19:56,450
!تووا-تشان هي المرأة الّتي أنقذت حياتنا

298
00:19:56,450 --> 00:19:59,180
!لا يروقني هذا أيضاً بالطّبع

299
00:19:59,180 --> 00:20:03,320
لكن ما أقصده هو أنّنا لا نملك
!فكرة عمّا يمكننا فعله

300
00:20:03,320 --> 00:20:06,400
أنا آسفة

301
00:20:06,850 --> 00:20:08,770
...لو كنتُ أسرع

302
00:20:12,370 --> 00:20:15,000
!لا شيء يدفعكِ للاعتذار يا يوزو

303
00:20:15,000 --> 00:20:17,200
...لو كنّا بقيّتنا أقوى

304
00:20:17,710 --> 00:20:20,840
...لو تمكنّا من مُساعدة تووا-سان أكثر، حينئذ

305
00:20:22,940 --> 00:20:26,230
!لا تبكيا

306
00:20:37,050 --> 00:20:39,770
!سأذهب لإنقاذ تووا-تشان

307
00:20:39,770 --> 00:20:40,390
...لكن

308
00:20:40,390 --> 00:20:42,810
!سأفعل شيئاً، حتّى من دون قِواي

309
00:20:42,810 --> 00:20:45,400
!أرفُض قطعاً التخلِّي عن تووا-تشان

310
00:20:45,840 --> 00:20:47,020
!انتظري، انتظري

311
00:20:47,530 --> 00:20:48,650
!لحظة

312
00:21:07,400 --> 00:21:08,630
...اسمعي

313
00:21:11,660 --> 00:21:12,960
!حان الوقت

314
00:21:13,880 --> 00:21:15,920
سأقلها، اتّفقنا؟

315
00:21:16,130 --> 00:21:19,190
ينتظركِ مُرافق شرطيّ في الطّابق السّفليّ

316
00:21:19,190 --> 00:21:23,410
تصرّفي بصورة طبيعيّة وتظاهري
بأنّكِ بشريّة حتّى تلتقي بيورومي

317
00:21:23,670 --> 00:21:24,880
!حسناً

318
00:21:24,880 --> 00:21:26,820
!سأُغادر

319
00:21:31,260 --> 00:21:33,930
وردتنا أنباء عن الحادِث الإرهابيّ
في الولاية 4

320
00:21:33,930 --> 00:21:36,800
وفقاً لإعلان من وكالة التحرِّي التّابعة
،للأُمم المُتّحدة

321
00:21:36,800 --> 00:21:39,940
يُعتقَد بأنّ هناك مُتواطئين مع الجانية

322
00:21:39,940 --> 00:21:41,960
قد جرى اعتقالهم

323
00:21:42,360 --> 00:21:46,180
،من بين الأربعة، ثلاثة فتيات في فترة المُراهقة

324
00:21:46,180 --> 00:21:48,490
والأُخرى هي امرأة في العشرينيّات

325
00:21:48,490 --> 00:21:52,060
تجري تحقيقات حاليّاً بشأن التّفاصيل
المُتعلِّقة بهذه الحادِثة

326
00:23:30,680 --> 00:23:32,880
!لا جدوى، لا جدوى، لا جدوى

327
00:23:31,500 --> 00:23:33,410
سوف نتقدّم

328
00:23:33,410 --> 00:23:35,170
من فضلكم الاستعداد للتّعبئة