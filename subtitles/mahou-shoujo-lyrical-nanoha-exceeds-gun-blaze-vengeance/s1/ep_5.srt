1
00:01:31,450 --> 00:01:35,570
إبادة إكشيد للأنواع الغازية
تسير بشكل سلِس

2
00:01:37,020 --> 00:01:40,920
،أبدنا كافّة الغُزاة السّيّئين بشكل كامل، السّلف

3
00:01:40,920 --> 00:01:44,240
والّذين يندرجون تحت نِطاق
فرع الشّرق الأقصى

4
00:01:44,570 --> 00:01:47,290
والآن يتمّ إرسالي إلى الفروع خارج البلاد

5
00:01:47,290 --> 00:01:49,940
للمُساعدة في هزيمة السّلَف
المُتبقّيين في كلّ أنحاء العالم

6
00:01:51,540 --> 00:01:54,730
تمكّنتُ حتّى من اللِّقاء بفُرسان المُديرة ياغامي

7
00:01:54,730 --> 00:01:57,720
الّذين كانوا يلعبون دوراً هامّاً
في الفروع خارج البلاد

8
00:01:58,790 --> 00:02:03,280
الفُرسان هم زملاء قُدماء
لنانو-تشان وفاي-تشان

9
00:02:04,510 --> 00:02:08,370
،الجميع يعملون بجدّ لإنجاز مسؤوليّاتهم

10
00:02:08,370 --> 00:02:10,270
ويحترمون المُديرة ياغامي

11
00:02:10,560 --> 00:02:12,730
إنّها كبالِغة رائعة

12
00:02:13,640 --> 00:02:18,290
تفاجأتُ عندما رأيتُ فتاة أصغر
،حجماً حتّى من نانو-تشان

13
00:02:18,770 --> 00:02:20,660
لكن كانت سينباي بالنّسبة لي

14
00:02:20,660 --> 00:02:22,300
وبالغة مُوقَّرة

15
00:02:22,770 --> 00:02:25,830
!أهلاً بكن في مقرّ إكشيد

16
00:02:25,830 --> 00:02:29,060
،الأمينة العامّة في المقرّ، رين-سان

17
00:02:29,060 --> 00:02:30,790
هي ابنة المُديرة ياغامي

18
00:02:31,320 --> 00:02:33,380
،رغم أنّه لا يوجد ما يربطهما بالدّم

19
00:02:33,380 --> 00:02:35,310
إلّا أنّهما مُقرّبتان كثيراً

20
00:02:36,330 --> 00:02:39,540
هناك شبَه كبير واضح

21
00:02:40,040 --> 00:02:43,050
،وفقاً لأمينتنا العامّة، رين-سان

22
00:02:43,050 --> 00:02:45,590
،بالوتيرة الحاليّة للإبادة خاصّتنا

23
00:02:45,590 --> 00:02:48,470
ينبغي أن يكون من المُمكن القضاء
على السّلَف جميعهم خلال العام

24
00:02:49,000 --> 00:02:52,130
باستثناء واحد

25
00:02:52,690 --> 00:02:54,000
واحد؟

26
00:02:55,260 --> 00:02:59,820
السّلَف الّذي تمّ التّأكيد بأنّه الأقدم بينهم

27
00:03:09,320 --> 00:03:12,400
لم نتمكّن من التحقُّق من أيّ نشاط من زيرو

28
00:03:12,400 --> 00:03:15,500
،منذ اختفائه قبل 12 عام

29
00:03:15,500 --> 00:03:18,580
لكن نحن متأكِّدون بأنّه ما زال على قيد الحياة

30
00:03:18,580 --> 00:03:24,830
أشعر وكأنّني أتذكّر بأنّني قرأتُ في الأخبار
،أنّ سلَفاً سيّئاً اختفى منذ مدّة طويلة

31
00:03:24,830 --> 00:03:26,590
لكن هل هو بتلك الخطورة؟

32
00:03:27,700 --> 00:03:29,450
إنّه خطير

33
00:03:29,450 --> 00:03:31,400
،تكاثره المُتفجِّر الواضح

34
00:03:31,400 --> 00:03:34,490
حيث يضع عشرات المليارات من البيوض
في كلّ موسم تزاوج

35
00:03:34,710 --> 00:03:40,110
الصّغار الّذين يخرجون من تلك البيوض يُحلّقون
في السّماء، ويطوفون الأنهار

36
00:03:40,110 --> 00:03:42,750
وينتشرون لالتهام النّباتات والحيوانات
طولاً وعرضاً

37
00:03:42,750 --> 00:03:46,860
لا نرى هذا التّكاثر الجماعيّ إلّا بين السّلَف

38
00:03:46,860 --> 00:03:52,020
إنّها تدمج بين شكلَي التّناسل الّذي
،تنتهجه النّباتات والحشرات

39
00:03:52,020 --> 00:03:55,290
مع خلق وحوش أكثر خطورة حتّى من الدّببة

40
00:03:55,290 --> 00:03:58,410
هناك سُمٌّ أيضاً يدوم في جثث
،تلك الوحوش

41
00:03:58,410 --> 00:04:00,870
لتُسبِّب طفرات في الأنظمة البيئيّة المُتأثِّرة

42
00:04:01,260 --> 00:04:04,790
تحقّقنا الآن بأنّ العديد من الأنواع الغازية الشّائعة

43
00:04:04,790 --> 00:04:06,940
نشأتْ من ذلك الضّرر

44
00:04:07,480 --> 00:04:12,550
يبدو هذا كعدائيّة نشِطة تجاه
المخلوقات الموجودة

45
00:04:12,550 --> 00:04:14,370
هذا صحيح، أليس كذلك؟

46
00:04:18,640 --> 00:04:23,650
إذاً، أنتِ متأكّدة بأنّه لم يهزمه
أحد وهو غير ميّت بالفعل؟

47
00:04:23,650 --> 00:04:28,480
صِغاره ومُنتجاته الثّانويّة تستمرّ
في التدفُّق عبر السّوق السّوداء

48
00:04:28,900 --> 00:04:33,080
...دولة ما، أو رُبّما مُنظَّمة ما تدعم الشّيطانيّين

49
00:04:33,080 --> 00:04:37,750
شيء من هذا القبيل غالباً يستغلّ
زيرو ويُبقيه مخفيّاً

50
00:04:38,220 --> 00:04:42,340
،لذا حالما نتمكّن من إبادة كافّة السّلَف
،بما في ذلك زيرة

51
00:04:42,340 --> 00:04:46,140
فإنّ الخطر على هذا العالم
سيتناقص بشكل جذريّ

52
00:04:46,140 --> 00:04:48,420
هذه هي طبيعة مهمّتنا

53
00:04:48,860 --> 00:04:53,250
إذاً سنستمرّ في إبادة السّلَف
حتّى نجد زيرو؟

54
00:04:53,690 --> 00:04:56,380
أجل، حدّدنا بالفعل الهدفَ التّالي

55
00:04:56,380 --> 00:05:00,450
،الّذي نودُّ أن نطلب من الفرع الشّرقيّ
:أو بالأحرى أنتِ يا كوزي-سان، تولّي أمره

56
00:05:01,190 --> 00:05:06,200
اثنان من الكائنات الخطيرة، ثلاثة وأربعة

57
00:05:06,200 --> 00:05:08,570
نودّ منكن هزيمتهما معاً

58
00:05:08,570 --> 00:05:09,680
!عُلِم

59
00:05:11,290 --> 00:05:14,300
هدفنا التّالي خارج البلاد

60
00:05:14,300 --> 00:05:17,460
لُوّثَت المنطقة بشكل كبير بسبب المعركة
،بين البشريّة والغُزاة

61
00:05:17,460 --> 00:05:20,400
لذا إنّها مُخصّصة كمنطقة سامّة
بصورة استثنائيّة

62
00:05:21,580 --> 00:05:25,750
يُطلِقون عليها ببلاد الموت، حيث
،لا يستطيع مخلوقٌ النّجاة

63
00:05:25,750 --> 00:05:29,380
لكن هناك مصنع لعقاقير الشّيطانيّين بداخلها

64
00:05:30,400 --> 00:05:34,220
،هناك أيضاً نوعان غازيان خطيران جواره

65
00:05:34,220 --> 00:05:38,870
لذا يبدو أنّ أجزاء منهما تُستخدَم
لصنع عقاقير شيطانيّين

66
00:05:40,260 --> 00:05:42,580
،يستطيعون الحصول على ما يريدون من مُكوِّنات

67
00:05:42,580 --> 00:05:46,220
ولا يستطيع الأشخاص العاديّون
التحرّي عنهم أو مُهاجمتهم؟

68
00:05:46,680 --> 00:05:49,010
،يبدو التجوُّل شاقّاً

69
00:05:49,010 --> 00:05:52,160
لذا غالبهم لديهم شخص يمتلك قوّةَ
انتقال مثل يوزو

70
00:05:54,490 --> 00:05:55,860
...وأيضاً

71
00:05:56,560 --> 00:05:59,160
تمكنّا من التحقُّق بأنّ شينوميا وكوراغي

72
00:05:59,160 --> 00:06:01,460
كانا يدخلان ويخرجان من هذا المركز

73
00:06:02,120 --> 00:06:06,070
يبدو أنّ هناك ما يُشبه مُختبر
أبحاث تحت الأرض

74
00:06:06,070 --> 00:06:10,760
هناك احتمال أيضاً بأن يكون هذا هو
المركز الّذي قضتْ فيه تووا-سان طفولتها فيه

75
00:06:13,890 --> 00:06:16,140
...والأشخاص الّذين قتلوا عائلةَ تووا-سان

76
00:06:16,430 --> 00:06:17,750
أحسنت صنعاً

77
00:06:18,210 --> 00:06:20,650
شكراً على تحرّياتكِ يا يوزو

78
00:06:20,650 --> 00:06:21,870
العفو

79
00:06:21,870 --> 00:06:24,430
هلّا طلبتُ منكِ تحضير بوّابة؟

80
00:06:24,430 --> 00:06:27,020
...المعذرة، لكن

81
00:06:27,550 --> 00:06:31,180
،أستطيع تخصيص منطقة عامّة لها فقط

82
00:06:31,180 --> 00:06:33,780
ولا أعرف سوى أنّه يوجد اثنان
من السّلَف في مكانٍ قريب ما

83
00:06:34,340 --> 00:06:38,980
في هذه الحالة، يمكننا أن نطلب منكِ إنشاء
...بوّابتكِ بالقرب من النّقطة المركزيّة

84
00:06:39,540 --> 00:06:41,540
حينها يمكننا التفرُّق للبحث

85
00:06:41,540 --> 00:06:43,990
ومُهاجمتهم عند إيجادهم؟

86
00:06:43,990 --> 00:06:45,010
!تماماً

87
00:06:45,010 --> 00:06:46,760
ما رأيكِ يا تووا-سان؟

88
00:06:48,160 --> 00:06:49,520
حسناً

89
00:06:49,520 --> 00:06:50,550
هل ستُساعدنَني؟

90
00:06:50,550 --> 00:06:51,700
!أجل

91
00:06:58,380 --> 00:07:00,630
،سنصل ليلاً

92
00:07:00,630 --> 00:07:02,780
لذا ارتاحي رجاء إن أحببتِ

93
00:07:02,780 --> 00:07:04,060
!شكراً

94
00:07:04,890 --> 00:07:07,230
هل نانو-تشان في القمرة ثانية؟

95
00:07:07,230 --> 00:07:08,320
أجل

96
00:07:08,940 --> 00:07:11,900
لدينا هذه الطّائرات مُتمركِزة في فرع
،أقصى الشّرق أيضاً

97
00:07:11,900 --> 00:07:13,860
لذا أرادتْ رؤية القمرة

98
00:07:14,230 --> 00:07:17,190
تعشق نانو-تشان الطّائرات حقّاً

99
00:07:17,630 --> 00:07:18,950
بالفعل

100
00:07:19,300 --> 00:07:24,050
كثيراً ما أتكلّم مع نانو-تشان عن الطّائرات
،والأمور القتاليّة

101
00:07:24,460 --> 00:07:27,920
لكن عادةً ما أتكلّ مع في-تشان
حول العائلة

102
00:07:27,920 --> 00:07:32,340
تسألني عن ذكرياتي عن سيتسونا
من وقت لآخر

103
00:07:32,340 --> 00:07:36,530
هل لدى سيتسونا-سان أي هوايات
أو أشياء تُحبّها؟

104
00:07:37,050 --> 00:07:38,600
...في الواقع

105
00:07:39,750 --> 00:07:42,170
رُبّما الطّبخ أو البستنة؟

106
00:07:42,170 --> 00:07:46,460
يمكنني القول بأنّها تحبٌّ الرّعاية وصنع
مُختلف الأشياء الأُخرى أيضاً

107
00:07:48,500 --> 00:07:51,360
،أشعر وكأنّني تكلّمتُ معها كثيراً

108
00:07:51,360 --> 00:07:56,590
لكن هناك أوقات أتمنّى فهيا حقّاً
لو تكلّمتُ معها أكثر

109
00:07:56,590 --> 00:07:58,590
عندما كانت تُبلي حسناً

110
00:07:58,590 --> 00:08:00,050
فهمت

111
00:08:01,520 --> 00:08:04,490
،آخر مرّة رأيتُ فيها سيتسونا شخصيّاً

112
00:08:04,920 --> 00:08:06,860
بدتْ حزينة

113
00:08:07,530 --> 00:08:11,380
أشعر وكأنّها تقلق عليّ من وقت
لآخر، حتّى الآن

114
00:08:15,160 --> 00:08:19,800
هل ستدوم هذه القوّة الّتي منحَتْني
،إيّاها سيتسونا للأبد

115
00:08:19,800 --> 00:08:21,960
أم أنّها ستختفي يوماً ما؟

116
00:08:21,960 --> 00:08:23,440
لا أعلم

117
00:08:23,890 --> 00:08:25,890
،إنّها قوّةٌ مُدهشة

118
00:08:25,890 --> 00:08:28,060
لكن هناك احتمال أن تبلغَ حدّاً مُعيّناً

119
00:08:28,060 --> 00:08:30,650
أو قد يجعلها شيء ما تختفي

120
00:08:31,540 --> 00:08:34,150
لكن رُبّما ستكون الأمور على ما يُرام

121
00:08:35,110 --> 00:08:36,740
،كنتُ صادقة مع نفسي

122
00:08:36,740 --> 00:08:39,050
،وفعلتُ كُلّ ما يمكنني فعله

123
00:08:39,050 --> 00:08:41,650
وساعدتُ أصدقائي وحُلفائي

124
00:08:42,550 --> 00:08:46,660
أريد من سيتسونا أن تبتسم وتخبرني
،بأنّني أبليتُ حسناً يوماً ما

125
00:08:47,340 --> 00:08:50,720
لذا إلى ذلك الحين، سأبذل قصارى
جهدي بكُل ما أوتيت من قوّة

126
00:08:59,770 --> 00:09:05,100
شينا-سان، فيت-تشان، سنصل قريباً

127
00:09:06,310 --> 00:09:07,530
حسناً

128
00:09:07,960 --> 00:09:11,130
سنتمكّن من رؤية ثلاثة وأربعة قريباً

129
00:09:15,650 --> 00:09:19,800
يمكنني الشُّعور بالضّغط حتّى من هذه المسافة

130
00:09:19,800 --> 00:09:21,260
يبدوان خصمين قويّين

131
00:09:22,200 --> 00:09:23,620
!ماذا كان ذلك؟

132
00:09:23,620 --> 00:09:25,520
!هل كان انفجاراً؟

133
00:09:25,520 --> 00:09:27,950
هل فعل ثلاثة أو أربعة شيئاً؟

134
00:09:28,520 --> 00:09:30,600
أجري مسحاً الآن

135
00:09:31,930 --> 00:09:33,940
!يوجد أشخاص في الأسفل

136
00:09:33,940 --> 00:09:36,960
بقيت مسافة قصيرة عن ثلاثة وأربعة

137
00:09:58,600 --> 00:10:04,380
هناك خمسة بالمُجمَل، مُتفرِّقة بين ثلاثة
مواقع أسفل الأرض تحت بعض الأنقاض

138
00:10:04,380 --> 00:10:07,620
!لماذا؟! ظننتُ بأنّه لا يوجد أحدٌ هنا

139
00:10:07,620 --> 00:10:10,580
!لا يمكننا تنفيذ الإبادة بوجود أُناس هنا

140
00:10:10,580 --> 00:10:12,960
!سيترتّب علينا الطّلب منهم الإخلاء أوّلاً

141
00:10:12,960 --> 00:10:15,910
لنتفرّق بما أنّه توجد ثلاثة مواقع

142
00:10:15,910 --> 00:10:16,910
!حسناً-
!حسناً-

143
00:10:22,710 --> 00:10:24,060
حسناً إذاً

144
00:10:24,890 --> 00:10:26,780
!السّترة، تجهيز

145
00:10:28,480 --> 00:10:29,960
!سترة الحاجز

146
00:10:31,300 --> 00:10:32,890
!تركيب

147
00:11:16,010 --> 00:11:17,260
!هيّا

148
00:11:24,040 --> 00:11:27,290
يبدو أنّ هذا هو المكان الّذي يعبثون فيه

149
00:11:27,290 --> 00:11:29,710
بالبيوض وأجزاء من الأنواع الغازية

150
00:11:29,710 --> 00:11:33,330
صحيح، لا يبدو كمُختبر أبحاث

151
00:11:33,330 --> 00:11:34,710
لا يوجد أحدٌ هنا أيضاً

152
00:11:35,710 --> 00:11:37,970
المخزن هنا

153
00:11:37,970 --> 00:11:42,610
كان هناك بعض الغُزاة، لذا
يوزو وأنا سحقناهم

154
00:11:43,130 --> 00:11:45,520
لا يبدو أنّه يوجد أيّ شيء مشبوه هنا

155
00:11:52,300 --> 00:11:55,600
هذا ليس المكان الّذي قضيتُ طفولتي فيه

156
00:11:56,230 --> 00:11:57,620
!لحظة

157
00:11:57,620 --> 00:11:59,240
!ثمّة شيء في السّماء

158
00:11:59,240 --> 00:12:00,520
!أحدهم قادم

159
00:12:02,480 --> 00:12:04,450
من الأفضل ألّا يُكشَف أمرنا

160
00:12:04,860 --> 00:12:07,470
تستطيع عناكب شيوري إخفاءنا

161
00:12:07,470 --> 00:12:08,860
الجميع، اختبئنَ

162
00:12:08,860 --> 00:12:10,130
عُلِم

163
00:12:10,450 --> 00:12:14,380
يوزو، كوني حذرة جدّاً واتركي مسافة
وتجنّبي كشف أمركِ

164
00:12:14,380 --> 00:12:15,280
!عُلم

165
00:12:15,280 --> 00:12:16,850
سأحميها

166
00:12:16,850 --> 00:12:19,120
!إذاً سأعيد الاتّصال مع أوي لاحقاً

167
00:12:19,120 --> 00:12:21,250
،إذا كُشِفَ أمركِ واضطررتِ للقتال

168
00:12:21,250 --> 00:12:25,150
فأضعفيهم بسرعة مُسبّبةً أقلّ ضرر مُمكن

169
00:12:37,320 --> 00:12:38,060
!مهلاً

170
00:12:38,060 --> 00:12:40,640
لِمَ يأتينَ تجاهنا مُباشرة

171
00:12:40,640 --> 00:12:43,570
!لأنّكِ كنتِ تُصدرين أصوات يا يونا

172
00:12:43,570 --> 00:12:45,900
!أنا سيّئة في التسلُّل

173
00:12:46,880 --> 00:12:49,090
هذا مخزن؟

174
00:12:52,130 --> 00:12:53,450
مساء الخير

175
00:12:53,450 --> 00:12:55,230
أنا من الأُمم المُتّحدة

176
00:12:58,870 --> 00:13:02,020
أنا من وكالة التّحقيق التّابعة للأُمم
المُتّحدة، إكشيد

177
00:13:03,720 --> 00:13:06,190
هل من أحد هنا؟

178
00:13:10,080 --> 00:13:13,050
أنت هناك، أليس كذلك؟

179
00:13:21,470 --> 00:13:26,560
سيّدتي، هذا الضّباب هو قوّة تحجب
الرّؤية وتُشوّش الاتِّصالات

180
00:13:26,880 --> 00:13:30,710
لا يمكننا إرسال أو تلقّي تسجيلات
صوت أو فيديو

181
00:13:31,290 --> 00:13:33,830
حقّاً؟ هذا مُدهش

182
00:13:34,570 --> 00:13:36,940
المعذرة

183
00:13:36,940 --> 00:13:38,800
أنا من الولايات المُتّحدة

184
00:13:38,800 --> 00:13:43,080
أتينا لإبادة الأنواع الغازية الضّخمة القريبة

185
00:13:43,420 --> 00:13:45,840
لذا نودُّ منكم إخلاء المكان

186
00:13:48,750 --> 00:13:50,010
أحقّاً ذلك؟

187
00:13:54,300 --> 00:13:56,660
هل من أحد هناك؟

188
00:13:57,160 --> 00:13:59,780
!هذا المكان خطير

189
00:14:04,660 --> 00:14:05,890
وجدتُك

190
00:14:05,890 --> 00:14:07,600
أنت هناك، أليس كذلك؟

191
00:14:08,680 --> 00:14:10,210
ماذا يجدر بنا أن نفعل؟

192
00:14:10,210 --> 00:14:14,260
أشفق عليها، لكن هل نُحيّدها؟

193
00:14:14,260 --> 00:14:17,120
إنّها من شرطة الأُمم المُتّحدة، صحيح؟

194
00:14:17,120 --> 00:14:19,880
لن أشفق عليها إطلاقاً

195
00:14:43,370 --> 00:14:44,730
!اهربي يا يونا

196
00:14:44,730 --> 00:14:45,690
!حسناً

197
00:14:50,600 --> 00:14:52,410
...مؤلم

198
00:14:53,130 --> 00:14:55,530
انخلع كتفي؟

199
00:14:55,530 --> 00:14:56,660
قوّة؟

200
00:14:58,910 --> 00:15:00,660
!سترة، إعادة تفعيل

201
00:15:04,920 --> 00:15:07,130
!جيّد، لقد عولِجَتْ

202
00:15:08,060 --> 00:15:11,270
،يجب أن أشرح الأمور لها وأطلب منها الإخلاء

203
00:15:11,270 --> 00:15:14,030
لكن لا أريد أن أتأذّى من جديد

204
00:15:15,180 --> 00:15:17,410
!أعتقد حان الوقت لتأجيج الأمور

205
00:15:20,800 --> 00:15:23,440
فعلناها الآن، لكن هل تعتقدين بأنّها بخير؟

206
00:15:23,670 --> 00:15:26,020
كانت شيطانيّة قويّة جدّاً، صحيح؟

207
00:15:26,020 --> 00:15:28,130
!لن تموت ممّا فعلناه

208
00:15:29,460 --> 00:15:30,880
!وجدتُكما

209
00:15:35,540 --> 00:15:36,950
قيود؟

210
00:15:39,430 --> 00:15:41,910
آسفة لتقييدكما هكذا

211
00:15:46,170 --> 00:15:47,720
،المكان خطيرٌ هنا

212
00:15:47,720 --> 00:15:49,910
لذا أريدكما أن تسمعاني قليلاً

213
00:15:50,630 --> 00:15:51,940
...تلك الفتاة

214
00:15:53,130 --> 00:15:56,920
هل هي شيطانيّة اللّهب الّتي
ذكرَتْها تووا-سان؟

215
00:16:12,230 --> 00:16:13,990
!أوي! يونا

216
00:16:14,320 --> 00:16:15,620
!انسحبا

217
00:16:18,470 --> 00:16:20,210
!أحسنتِ صنعاً يا يوزو

218
00:16:20,210 --> 00:16:21,610
!أنقذتِنا

219
00:16:22,120 --> 00:16:24,570
!تواصلتُ بالفعل مع شيوري-سان وتووا-سان

220
00:16:24,570 --> 00:16:26,390
!سنخرج من هنا

221
00:16:26,390 --> 00:16:27,360
!أجل

222
00:16:34,550 --> 00:16:37,380
ماذا كان ذلك بالضّبط؟

223
00:16:37,950 --> 00:16:43,630
حليفتك هي شخص ذات قوّة
شيطانيّة تفوق اللّهب؟

224
00:16:43,630 --> 00:16:45,530
...في الواقع

225
00:16:45,530 --> 00:16:50,440
هذا سرّيٌّ عمليّاً، لذا لا أستطيع
الإجابة عن ذلك

226
00:16:57,900 --> 00:16:59,160
!عفواً؟

227
00:16:59,160 --> 00:17:00,520
أجيبيني من فضلكِ

228
00:17:00,520 --> 00:17:06,410
هل تستخدمون شيطانيّين صُنِعوا
بعقاقير ليكونوا جنوداً؟

229
00:17:06,640 --> 00:17:08,500
...نحن لا

230
00:17:08,500 --> 00:17:10,280
!نفعل ذلك

231
00:17:19,440 --> 00:17:20,900
!مُسرِّع

232
00:17:43,730 --> 00:17:46,230
هل يُعقَل أنّكِ

233
00:17:46,230 --> 00:17:48,440
إحدى سفّاحي الشّيطانيّين؟

234
00:17:50,090 --> 00:17:51,840
وماذا لو قلتُ "أجل"؟

235
00:17:52,350 --> 00:17:54,810
المعذرة، أنا آسفة

236
00:17:54,810 --> 00:17:59,350
نحن مُدركات أيضاً بأنّ شيئاً
يجب فعله

237
00:17:59,350 --> 00:18:02,020
بخصوص توزيع عقاقير الشّيطانيّين

238
00:18:02,020 --> 00:18:06,180
لكن، ترتبط مهمّتنا بالأنواع الغازية الخطيرة

239
00:18:06,180 --> 00:18:08,770
،نحن الآن نُبيد السّلَف

240
00:18:08,770 --> 00:18:12,480
كي نحمي سلامة شعوب هذا العالم

241
00:18:12,480 --> 00:18:18,310
لا أحد من الطّاقم في إكشيد أو فروعنا
يستخدمون عقاقير شيطانيّة

242
00:18:18,900 --> 00:18:21,140
هل ستُصدّقينني؟

243
00:18:22,180 --> 00:18:24,960
شيطانيّتنا الأولى

244
00:18:24,960 --> 00:18:27,560
أصبحتْ هكذا من خلال أحداث مأساويّة

245
00:18:28,010 --> 00:18:31,930
ورغم ذلك، إنّها تتعاون معنا بمحض إرادتها

246
00:18:34,220 --> 00:18:39,310
،لا أعرف ما طبيعتكِ كشيطانيّة لهب

247
00:18:40,350 --> 00:18:42,960
لكن هناك احتمال أن تُدمّر نفسها
ذاتيّاً وتنفجر

248
00:18:42,960 --> 00:18:45,860
قد يُثبت هذا بأنّها قوّة خطيرة وهشّة

249
00:18:46,680 --> 00:18:48,740
توخّي الحذر رجاء

250
00:18:49,180 --> 00:18:53,990
وذلك كي لا يتعرّض المُحيطون بها لمصير مأساويّ

251
00:18:53,990 --> 00:18:55,960
،كنتُ لأتمنّى تجنُّب ذلك

252
00:18:55,960 --> 00:18:59,740
لذا أحتاج فُرصة للتحدُّث معكِ
في وقت لاحق بالتّفصيل

253
00:19:00,240 --> 00:19:04,440
للتّعويض عن مُهاجمتكِ، سأُساعدكِ في إبادتكِ

254
00:19:04,990 --> 00:19:08,000
!من فضلكِ لا تقلقي بشأن ذلك

255
00:19:08,000 --> 00:19:10,400
هذا لأجلي أيضاً

256
00:19:14,480 --> 00:19:16,410
!نانو-تشان! هل أنتِ بخير؟

257
00:19:16,410 --> 00:19:18,400
أجل، أنا بخير

258
00:19:23,000 --> 00:19:25,710
هل ستعتقلنَنا؟

259
00:19:26,230 --> 00:19:29,870
لا نملك الصّلاحية لفعل ذلك

260
00:19:30,720 --> 00:19:33,610
،إن كان هدفكم هو تحطيم عقاقير الشّيطانيّين

261
00:19:33,610 --> 00:19:36,150
إذاً أليست هناك طريقة يمكننا
التّعاون من خلالها معاً؟

262
00:19:36,150 --> 00:19:38,880
لا نثِق بالمُنظّمات الكُبرى

263
00:19:42,120 --> 00:19:44,780
،لن نعترض طريقكن

264
00:19:44,780 --> 00:19:47,280
لذا لا تعترضنَ طريقنا رجاء

265
00:19:49,530 --> 00:19:52,170
سنُدمِّر هذا المركز

266
00:20:08,770 --> 00:20:10,730
!في-تشان، لدينا حالة طارئة

267
00:20:10,730 --> 00:20:11,930
شينا-سان؟

268
00:20:12,360 --> 00:20:15,360
!السّلَف أربعة قد أُبيد

269
00:20:15,360 --> 00:20:16,390
ماذا؟

270
00:20:16,390 --> 00:20:21,170
سفّاحة الشّيطانيّين الّتي تكلّمتْ مع نانو-تشان
أسقطَتْه لأجلنا على ما يبدو

271
00:20:22,740 --> 00:20:26,780
سفّاحة الشّيطانيّين تلك قويّة جدّاً، أليس كذلك؟

272
00:20:43,750 --> 00:20:46,810
إيجي-كن؟

273
00:20:47,910 --> 00:20:49,130
ما الأمر؟

274
00:20:49,980 --> 00:20:53,160
تلقّينا رسالة طارئة من مُشرف إحدى مُختبراتنا

275
00:20:53,160 --> 00:20:57,100
المركز بالقرب من السّلَف ثلاثة
وأربعة قد دُمِّر

276
00:20:57,100 --> 00:21:00,600
قيل بأنّ ثلاثة وأربعة قد هُزِما أيضاً

277
00:21:01,480 --> 00:21:03,330
مجموعة الأُمم المُتّحدة؟

278
00:21:03,330 --> 00:21:05,310
بواسطة مُستخدمة اللّهب تلك؟

279
00:21:05,310 --> 00:21:07,440
لم يكونوا هُم فقط

280
00:21:07,870 --> 00:21:11,000
يبدو أنّ سفّاحي الشّيطانيّين قد تصرّفوا أيضاً

281
00:21:11,300 --> 00:21:16,390
يبدو أنّ قائد سفّاحي الشّيطانيّين هو
فتاة من إحدى مُختبراتنا

282
00:21:16,390 --> 00:21:19,000
قيل بأنّها هزمَتْ أربعة والتهمَتْه

283
00:21:22,090 --> 00:21:23,250
!أنت

284
00:21:25,080 --> 00:21:27,740
،أريد استرجاع هذه الفتاة

285
00:21:27,740 --> 00:21:30,770
لكن هل يمكنك رسم خطّة
لي يا إيجي-كن؟

286
00:21:31,160 --> 00:21:35,260
تريدينها سليمة وفي أسرع
وقت مُمكن، صحيح؟

287
00:21:36,110 --> 00:21:37,050
!أجل

288
00:21:37,650 --> 00:21:39,340
سأفعل ما يمكنني فعله

289
00:21:41,890 --> 00:21:43,860
حسناً، ينبغي أن يكون هذا سهلاً

290
00:21:43,860 --> 00:21:45,650
!مرحى

291
00:21:46,400 --> 00:21:48,310
!إنّها أعزّ صديقة لي

292
00:21:48,310 --> 00:21:49,400
!شكراً

293
00:23:30,630 --> 00:23:33,760
،حتّى قبل 10 سنوات مضتْ
لم أكن أملك شيئاً

294
00:23:33,800 --> 00:23:35,370
!لهذا قتلتُهم جميعاً