1
00:00:12,500 --> 00:00:17,410
كنتُ أنتظر هذا اليوم، يوم انكسار المفهوم

2
00:00:17,410 --> 00:00:20,350
أنتم نخبة أفراد وحداتنا الخاصّة

3
00:00:20,350 --> 00:00:22,830
فستنشطون كمستعملي قوى خارقة

4
00:00:33,640 --> 00:00:34,970
لا أحد يراقب

5
00:00:38,230 --> 00:00:41,390
ناوتو، ناويا. جلبتُ صودا لكما

6
00:00:43,140 --> 00:00:47,400
هل تسليمهما لكم هي الطريقة الوحيدة؟

7
00:00:49,670 --> 00:00:51,030
!ناوتو! ناويا

8
00:00:51,030 --> 00:00:53,780
!أبي! أمّي

9
00:01:03,420 --> 00:01:07,750
سيتذكّرنا أبي وأمّي، أليس كذلك؟

10
00:01:08,710 --> 00:01:10,060
سيفعلون

11
00:01:10,930 --> 00:01:12,940
مضى وقتٌ مذ رأيناهما

12
00:01:13,820 --> 00:01:15,840
سيندهشون بالتأكيد

13
00:01:15,840 --> 00:01:16,940
أجل

14
00:01:17,560 --> 00:01:20,680
لنزرهما ونستفسر منهما
عمَّ حصل حتّى الآن

15
00:01:20,680 --> 00:01:24,540
أجل، لا بدّ أنّهما سيخبراننا بالكثير

16
00:03:01,720 --> 00:03:04,900
اختفى... منزلنا

17
00:03:04,900 --> 00:03:05,700
لمَ؟

18
00:03:07,470 --> 00:03:10,790
كان هذا المكان بالفعل، صحيح؟

19
00:03:11,200 --> 00:03:12,230
أجل

20
00:03:14,100 --> 00:03:15,710
...أين أبي وأمّي

21
00:03:23,180 --> 00:03:24,260
من أنت؟

22
00:03:24,260 --> 00:03:27,370
القَدر الذي يجلبه الحالون

23
00:03:27,810 --> 00:03:31,190
كي ترتبط كلّ اللحظات

24
00:03:32,230 --> 00:03:33,340
اختفت

25
00:03:34,290 --> 00:03:35,980
من تكون؟

26
00:03:35,980 --> 00:03:38,980
فوتامي شوكو

27
00:03:40,270 --> 00:03:44,570
لا أدري، لكني استلمت اسمها مع رسالة

28
00:03:44,570 --> 00:03:45,770
رسالة؟

29
00:03:45,770 --> 00:03:50,190
أجل، تخبرنا أنّ علينا التوجّه هناك الآن

30
00:04:08,620 --> 00:04:10,180
شوكو

31
00:04:15,620 --> 00:04:19,280
أي نحن أتباعٌ يطيعون وسطاء الإله؟

32
00:04:19,560 --> 00:04:22,470
لا تأتي من الإله

33
00:04:22,470 --> 00:04:25,290
النبوءات من ميساكي-سان، ويجب أن نؤمن بها

34
00:04:26,570 --> 00:04:27,930
...ميكوريا

35
00:04:27,930 --> 00:04:31,380
...لوشكوف، أسرع

36
00:04:32,780 --> 00:04:33,830
حسناً

37
00:05:02,280 --> 00:05:04,780
لا تقلق، سيفلح هذا

38
00:05:07,530 --> 00:05:08,850
!ميكوريا

39
00:05:12,540 --> 00:05:14,960
...إنّها من الفصل ب

40
00:05:14,960 --> 00:05:16,250
لا يُعقل

41
00:05:16,250 --> 00:05:17,970
انتحار؟ أيعني أنّه تنمّر؟

42
00:05:17,970 --> 00:05:20,200
صدقاً؟ هذا مخيف

43
00:05:20,200 --> 00:05:22,210
هل ستأتي الشرطة؟

44
00:05:40,640 --> 00:05:42,570
رأيتم ذلك جميعاً، صحيح؟

45
00:05:43,260 --> 00:05:45,200
لمَ قد تنتحر ميغ؟

46
00:05:46,120 --> 00:05:47,310
...يوجي

47
00:05:48,340 --> 00:05:51,780
قالوا أنّ يوجي انتحر صباح اليوم أيضاً

48
00:05:56,210 --> 00:05:59,030
...ميغ... يو-تشان

49
00:05:59,620 --> 00:06:01,980
لا بدّ أنّه السبب

50
00:06:01,980 --> 00:06:05,920
!ماتا لأنّنا تورّطنا في السحر الأسود

51
00:06:05,920 --> 00:06:07,620
!ذلك مستحيل

52
00:06:07,620 --> 00:06:10,890
!فقد فعلنا الأمر للعنه

53
00:06:11,150 --> 00:06:13,820
...صحيح، لكن

54
00:06:14,330 --> 00:06:17,740
سينسي بخير، لم يصبه شيء

55
00:06:19,370 --> 00:06:22,340
!و-وكانت مجرّد لعبة

56
00:06:22,340 --> 00:06:25,760
يُفترض أنّه لم يمت أحد

57
00:06:25,760 --> 00:06:27,700
لمَ انتحار؟

58
00:06:27,700 --> 00:06:28,570
لمَ؟

59
00:06:29,180 --> 00:06:31,570
لمَ؟ لمَ؟

60
00:06:33,210 --> 00:06:36,610
عبث يوسا-سينسي بمشاعري ورمى بي

61
00:06:36,610 --> 00:06:38,600
سأجعله يدفع الثمن

62
00:06:41,590 --> 00:06:45,950
زيت خروع ورأس سمكة وسنابل قمح

63
00:06:45,950 --> 00:06:48,890
ودم حيوان

64
00:06:49,440 --> 00:06:51,390
أهذا حقيقيّ؟

65
00:06:51,680 --> 00:06:53,940
مـ-من أين جلبتِه؟

66
00:06:53,940 --> 00:06:56,500
حسناً، بشكلٍ ما وحسب

67
00:07:02,400 --> 00:07:07,360
أخبروني، ألم تعتقل فرقة حفظ
الأمن القوميّ ميك المعجزات وتعدمه؟

68
00:07:07,360 --> 00:07:10,830
تعدمه مقابل ذلك؟ مستحيل

69
00:07:10,830 --> 00:07:13,910
...لكن إذا اكتشفوا قيامنا بهذا

70
00:07:14,290 --> 00:07:15,370
!اخرسوا

71
00:07:15,370 --> 00:07:18,220
!ركّزوا كي ننتقم من يوسا

72
00:07:20,410 --> 00:07:23,300
لمَ؟ لمَ؟

73
00:07:34,490 --> 00:07:35,890
!إنّه موجود

74
00:07:35,890 --> 00:07:39,150
!مصنع أبي لا يزال موجوداً يا أخي

75
00:07:39,150 --> 00:07:40,390
أجل

76
00:07:40,390 --> 00:07:43,310
لكن يبدو أنّه هُجر

77
00:08:00,340 --> 00:08:03,790
طلبت تلك الفتاة أن نأتي هنا؟

78
00:08:04,120 --> 00:08:04,990
أجل

79
00:08:08,330 --> 00:08:09,260
ما لك؟

80
00:08:19,290 --> 00:08:21,230
إنّهما أبانا وأمّنا

81
00:08:21,560 --> 00:08:23,730
!نحن موجودان أيضاً

82
00:08:26,890 --> 00:08:27,730
أتذكّر هذا

83
00:08:28,400 --> 00:08:32,820
إنّه حقيقيّ، كذلك أبونا وأمّنا

84
00:08:33,540 --> 00:08:36,450
ذكرياتنا ليست خاطئة

85
00:08:36,450 --> 00:08:37,450
أجل

86
00:08:37,870 --> 00:08:41,160
إذاً، أين ذهبا؟

87
00:09:24,520 --> 00:09:28,530
أخبرني، ما رأيك بما قاله الرئيس؟

88
00:09:28,530 --> 00:09:30,900
عن تواجد مستعملي القوى الخارقة؟

89
00:09:30,900 --> 00:09:33,170
ليس ذلك

90
00:09:34,410 --> 00:09:38,010
ستنشطون كمستعملي قوى خارقة

91
00:09:38,870 --> 00:09:41,810
سنصبح مستعملي قوى خارقة؟

92
00:09:42,260 --> 00:09:45,900
أجل، هل تصدّق ذلك؟

93
00:09:45,900 --> 00:09:47,930
ما رأيك أنت يا يويا؟

94
00:09:47,930 --> 00:09:50,590
قالوا أنّ شقيقك أصبح كذلك سلفاً

95
00:09:50,590 --> 00:09:51,670
أهي الحقيقة؟

96
00:09:53,450 --> 00:09:54,430
...أنا

97
00:09:56,260 --> 00:10:01,250
كان كلام الرئيس، وسنطيعه لا أكثر

98
00:10:02,040 --> 00:10:03,640
بسيط التفكير

99
00:10:03,640 --> 00:10:05,930
،يُفترض أنّنا في طريقنا لمدرسة ثانويّة

100
00:10:05,930 --> 00:10:07,630
فلمَ لا تقرأ كتباً أثناء وجودك هنا؟

101
00:10:07,630 --> 00:10:09,790
!اخرسي! لستِ أحسن حالاً منّي

102
00:10:09,790 --> 00:10:11,530
إنّهما مفعمان بالحيويّة

103
00:10:11,530 --> 00:10:13,000
هل المكان هكذا دوماً؟

104
00:10:13,000 --> 00:10:16,300
أجل، ستعتادين بنهاية المطاف

105
00:10:16,300 --> 00:10:21,430
،أجد نفسي أستمتع بالقيادة معك
لكن ما مهمّتنا في المدرسة بالضبط؟

106
00:10:22,230 --> 00:10:25,860
وقع هناك انتحار، ستعرف عندما نصل

107
00:10:26,290 --> 00:10:29,290
كوروكي تاكويا، هل أناديك بتاكويا؟

108
00:10:29,290 --> 00:10:30,400
لا أمانع

109
00:10:31,710 --> 00:10:34,370
كلانا ذوي قوى خارقة، فلنكن على وفاق

110
00:10:34,830 --> 00:10:36,620
ذوي قوى خارقة؟

111
00:10:36,620 --> 00:10:39,580
دعني أحذّرك بصفتي سينباي لك

112
00:10:39,580 --> 00:10:44,750
يبدو أنّك نشّطت قواك، لكن التحكّم بها صعب

113
00:10:44,750 --> 00:10:48,210
الإفراط في استعمالها قد يقود لدمارك

114
00:10:48,950 --> 00:10:50,890
توخَّ الحذر

115
00:10:50,890 --> 00:10:55,270
أعي ذلك، قال كاكيتاني-سان الأمر نفسه

116
00:10:55,270 --> 00:10:57,240
شكراً على التنبيه

117
00:11:02,710 --> 00:11:04,380
!لا يتحرّك أحد

118
00:11:04,740 --> 00:11:05,720
ماذا؟

119
00:11:05,720 --> 00:11:07,660
!ابقوا في أماكنكم

120
00:11:07,660 --> 00:11:09,730
!سنحقّق في هذا المكان

121
00:11:11,240 --> 00:11:15,540
عجباً، هذا المكان مليء بالكتب المحظورة

122
00:11:16,680 --> 00:11:17,800
ما هذا؟

123
00:11:17,800 --> 00:11:20,170
إنّه غير شرعيّ كليّاً

124
00:11:20,170 --> 00:11:23,730
...كـ-كنّا نمارس السحر الأسود

125
00:11:23,730 --> 00:11:25,420
السحر الأسود؟

126
00:11:25,820 --> 00:11:28,620
يا للفوضى

127
00:11:28,620 --> 00:11:32,910
،أعتقد أنّنا أخطأنا في القيام بالأمر
وانقلبت اللعنة علينا

128
00:11:33,620 --> 00:11:35,870
لذا مات صديقانا

129
00:11:36,820 --> 00:11:39,250
...علينا فكّ اللعنة وإلّا سنلقى

130
00:11:40,390 --> 00:11:41,510
...سنلقى نحن أيضاً

131
00:11:42,770 --> 00:11:44,640
كما سمعتما

132
00:11:44,640 --> 00:11:46,650
يبدو أنّها كومة كنوز

133
00:11:46,650 --> 00:11:50,720
أجل، لكن لمَ لا يزالون
يحتفظون بكتب محظورة؟

134
00:11:51,050 --> 00:11:55,520
هل نقوم بعمل المفتّشين عنهم ونصادرها؟

135
00:11:56,840 --> 00:12:00,140
أيُعقل حقّاً عبث أحدهم بالسحر الأسود

136
00:12:00,140 --> 00:12:02,040
ثم الموت جرّاء لعنة؟

137
00:12:02,040 --> 00:12:03,680
من يدري؟

138
00:12:03,680 --> 00:12:06,990
لكن ما وقع هنا لم يكن جرّاء السحر الأسود

139
00:12:08,790 --> 00:12:10,500
إنّها فعلة مستعمل قوى خارقة

140
00:12:11,940 --> 00:12:14,140
،لا أدري من يكون

141
00:12:14,140 --> 00:12:17,250
لكنّ قوّته هائلة

142
00:12:17,570 --> 00:12:19,280
قوّته هائلة؟

143
00:12:19,280 --> 00:12:23,920
أجل، لذا لا تهملا واحمياني بانتباه

144
00:12:26,570 --> 00:12:27,690
...أشعر به

145
00:12:28,110 --> 00:12:30,490
سحر أسود؟ لعنات؟

146
00:12:30,490 --> 00:12:33,500
فوق احتفاظكم بهذا العدد
،من الكتب المحظورة

147
00:12:33,500 --> 00:12:36,430
تؤمنون بها واتّبعتم ما تملي عليه؟

148
00:12:36,430 --> 00:12:40,680
ما اقترفتموه كان جريمةً شائنة
!تخالف القانون الوطنيّ

149
00:12:40,680 --> 00:12:42,900
جريمة تحمل عقوبة الإعدام

150
00:12:42,900 --> 00:12:44,010
جنيتم على أنفسكم

151
00:12:44,010 --> 00:12:45,930
!لا-لا أهتم أيّاً يكن

152
00:12:45,930 --> 00:12:49,410
!لا أريد الموت فقط! ساعدوني

153
00:12:49,410 --> 00:12:53,000
!ساعدوني! ساعدوني أرجوكم! أتوسّل إليكم

154
00:12:53,000 --> 00:12:55,920
!لحظة، أنتِ! توقّفي

155
00:12:57,690 --> 00:12:58,700
!مهلك

156
00:12:59,290 --> 00:13:00,510
!ماريكا

157
00:13:11,620 --> 00:13:14,380
سـ-سنُقتل جميعاً

158
00:13:14,380 --> 00:13:15,970
!نحن ملعونون حقّاً

159
00:13:15,970 --> 00:13:17,650
ما الذي يحصل بالضبط؟

160
00:13:17,650 --> 00:13:20,770
...لا أريد الموت... لا أريد الموت

161
00:13:21,830 --> 00:13:23,080
...ساعدوني

162
00:13:32,250 --> 00:13:33,750
ما الذي أصابه فجأةً؟

163
00:13:35,250 --> 00:13:38,170
!لحظة، ما الذي تفعلينه؟ توقّفي

164
00:13:38,170 --> 00:13:39,360
!مهلك

165
00:13:43,560 --> 00:13:45,490
!يا حمقاء! هذا خطر

166
00:13:48,680 --> 00:13:50,560
!مهلك! لا تطلقي عليها يا ريكا

167
00:13:51,000 --> 00:13:53,550
مهلك! ما الذي تفعلينه؟

168
00:13:55,090 --> 00:13:56,350
!توقّفي

169
00:13:57,220 --> 00:13:58,060
!أنت

170
00:13:58,060 --> 00:14:00,270
ما الذي تفعله؟

171
00:14:00,570 --> 00:14:02,770
!أخبرتك أن تتوقّفي! تبّاً

172
00:14:03,780 --> 00:14:05,600
ما الذي حلّ بك؟

173
00:14:09,780 --> 00:14:11,700
...تاكويا، تلك

174
00:14:12,820 --> 00:14:14,240
!ميتشيو

175
00:14:16,460 --> 00:14:18,420
ما الذي يفعله؟

176
00:14:19,310 --> 00:14:20,940
ماذا حصل؟

177
00:14:23,750 --> 00:14:24,380
ما الخطب؟

178
00:14:25,780 --> 00:14:26,460
!انتبهي

179
00:14:33,590 --> 00:14:35,470
أتذكّر هذا المكان أيضاً

180
00:14:35,470 --> 00:14:37,760
كنّا نلهو هنا كثيراً

181
00:14:37,760 --> 00:14:39,030
صحيح

182
00:14:52,790 --> 00:14:56,160
عبث يوسا-سينسي بمشاعري ورمى بي

183
00:14:56,160 --> 00:14:57,300
سأجعله يدفع الثمن

184
00:14:57,380 --> 00:14:58,410
دم حيوان

185
00:14:58,410 --> 00:14:59,490
وتعدمه

186
00:14:59,490 --> 00:15:00,960
من أين جلبتِه؟

187
00:15:00,310 --> 00:15:02,200
تعدمه مقابل ذلك؟

188
00:15:03,870 --> 00:15:04,960
!ناويا

189
00:15:08,040 --> 00:15:09,110
ما الخطب؟

190
00:15:09,110 --> 00:15:10,590
هل رأيتَ شيئاً؟

191
00:15:10,930 --> 00:15:14,280
كانت... كتلة حقدٍ قويّة

192
00:15:14,280 --> 00:15:15,320
أأنت بخير؟

193
00:15:15,320 --> 00:15:18,060
أ-أجل، بخير

194
00:15:18,060 --> 00:15:19,940
تفاد النظر لها

195
00:15:19,940 --> 00:15:22,640
آ-آسف يا أخي

196
00:15:23,210 --> 00:15:26,400
!ساعدوني! ساعدوني رجاءً

197
00:15:29,480 --> 00:15:30,400
ماذا هناك؟

198
00:15:36,240 --> 00:15:38,420
!ما الذي حلّ به؟

199
00:15:38,420 --> 00:15:40,740
تتحكّم به قوّة كبيرة

200
00:15:40,740 --> 00:15:41,960
!تتحكّم؟

201
00:15:41,960 --> 00:15:43,460
!تراجعا

202
00:15:47,250 --> 00:15:48,260
ميتشيو

203
00:15:49,140 --> 00:15:50,600
أعطني المسدّس

204
00:16:05,930 --> 00:16:06,560
!يويا

205
00:16:06,560 --> 00:16:08,950
!تاكويا، علينا إعادة التنظيم

206
00:16:08,950 --> 00:16:10,360
!لاحق تلك الفتاة

207
00:16:11,210 --> 00:16:14,010
مات أصدقاؤك؟

208
00:16:14,010 --> 00:16:14,860
أجل

209
00:16:15,460 --> 00:16:17,260
ما الذي حصل؟

210
00:16:20,030 --> 00:16:23,080
!لا بدّ أنّه بسبب السحر الأسود

211
00:16:23,080 --> 00:16:24,830
السحر الأسود؟

212
00:16:26,270 --> 00:16:31,160
أظنّ ذلك لأنّ أصدقاءك قتلوا جرواً

213
00:16:31,160 --> 00:16:33,900
!لا علم لي عن ذلك

214
00:16:33,900 --> 00:16:35,760
!ماريكا من أقدمت عليه

215
00:16:38,750 --> 00:16:40,770
...أخي... رأسي

216
00:16:40,770 --> 00:16:41,890
!ما الأمر يا ناويا؟

217
00:16:42,250 --> 00:16:46,180
...قوّة كراهية عالية جدّاً

218
00:16:46,740 --> 00:16:49,930
...عليّ فعل شيءٍ ما... وإلّا

219
00:16:51,570 --> 00:16:54,430
هذا تحكّم دماغي

220
00:16:54,430 --> 00:16:55,350
أجل

221
00:16:55,350 --> 00:16:58,840
أستشعر غضباً وكراهيّةً شديدين
من صاحب القوى الخارقة

222
00:17:00,940 --> 00:17:02,790
غضب وكراهية؟

223
00:17:02,790 --> 00:17:03,680
أجل

224
00:17:04,170 --> 00:17:07,610
لعلّهم أقدموا على شيءٍ أثار غضب
مستعمل القوى الخارقة

225
00:17:07,610 --> 00:17:10,020
أثناء ممارسة السحر الأسود

226
00:17:10,020 --> 00:17:12,390
أيمكنكِ تعقّبه؟

227
00:17:12,390 --> 00:17:16,290
،أجل، تمكّنت من ضبط قوّته مرّة
فسأستطيع على الأرجح

228
00:17:16,290 --> 00:17:17,300
أسرعي

229
00:17:17,300 --> 00:17:18,520
عُلِم

230
00:17:20,300 --> 00:17:23,150
تعلّم التحكّم بقوّتك

231
00:17:25,400 --> 00:17:26,810
أعي ذلك

232
00:17:30,340 --> 00:17:32,510
...إنّها في خطر

233
00:17:32,510 --> 00:17:33,410
...أشعر بذلك

234
00:17:33,410 --> 00:17:36,400
!ناويا! أأنت بخير؟ لا تنظر

235
00:17:36,400 --> 00:17:37,360
...غضب

236
00:17:37,360 --> 00:17:38,340
أتسمعني؟

237
00:17:39,090 --> 00:17:42,510
...أشعر بها... رغبة قتلٍ هائلة

238
00:17:50,340 --> 00:17:51,090
!لا تفعلي

239
00:18:06,150 --> 00:18:09,320
...أخي... على هذا النحو

240
00:18:09,320 --> 00:18:10,770
لا يمكننا تركها هنا

241
00:18:10,770 --> 00:18:11,750
أجل

242
00:18:15,990 --> 00:18:17,740
أهذا هو المكان يا ناويا؟

243
00:18:17,740 --> 00:18:19,450
أجل، إنّه قريب

244
00:18:20,060 --> 00:18:23,550
أظنّه نفس المكان الذي ذكرته تلك الفتاة

245
00:18:39,810 --> 00:18:42,140
من أنتما؟ من فرقة حفظ الأمن؟

246
00:18:42,140 --> 00:18:44,980
أخي، ليست هي

247
00:18:44,980 --> 00:18:46,060
بل الطفل وراءها

248
00:18:48,150 --> 00:18:49,920
لمَ تتدخّلان؟

249
00:18:50,860 --> 00:18:52,110
أهو أنت؟

250
00:18:52,560 --> 00:18:55,780
!قتلوا كوتارو

251
00:18:55,780 --> 00:18:59,190
!لم يفعل شيئاً! ارحلا

252
00:18:59,190 --> 00:19:01,460
!فلترحلا رجاءً! اخرجا

253
00:19:01,460 --> 00:19:02,640
...أخي

254
00:19:04,960 --> 00:19:08,170
قتل ذاك الصبيّ أشخاصاً عدّة منهم

255
00:19:08,170 --> 00:19:10,940
!ما الذي تقوله؟! دعك من الهراء

256
00:19:13,070 --> 00:19:15,290
أخي، انتظر

257
00:19:22,270 --> 00:19:25,020
إنّها هي، فوتامي شوكو

258
00:19:25,600 --> 00:19:29,060
لعلّها من قادتنا إلى هنا

259
00:19:29,060 --> 00:19:33,190
!أرجوكما، لا تأخذاه! لا تأخذا ماسايوكي

260
00:19:33,190 --> 00:19:35,400
!لم يقتل أحداً

261
00:19:35,940 --> 00:19:38,110
!لا بدّ من وجود التباسٍ ما

262
00:19:39,920 --> 00:19:43,990
لم نأتِ لفعل شيءٍ له

263
00:19:44,290 --> 00:19:48,800
إنّه يسيء استعمال قواه

264
00:19:49,370 --> 00:19:52,120
...لذا تكلّم معنا

265
00:19:53,150 --> 00:19:54,150
!إنّهما هما

266
00:19:54,150 --> 00:19:56,840
كلا، بل هو

267
00:19:58,590 --> 00:20:00,050
لحظة، ما الذي تفعلينه؟

268
00:20:00,510 --> 00:20:03,300
!ماسايوكي! تماسك يا ماسايوكي

269
00:20:03,300 --> 00:20:04,510
!أأنت بخير؟

270
00:20:04,800 --> 00:20:06,420
من أنتما؟

271
00:20:06,420 --> 00:20:07,060
...ما الذي تفعلانه

272
00:20:07,060 --> 00:20:08,060
!هيّا بنا

273
00:20:10,400 --> 00:20:11,380
!ناويا

274
00:20:13,550 --> 00:20:14,950
...ماسايوكي

275
00:20:14,950 --> 00:20:16,520
!ماسايوكي

276
00:20:18,040 --> 00:20:19,080
!توقّفا

277
00:20:20,730 --> 00:20:22,030
...أنتما من بالأمس

278
00:20:22,030 --> 00:20:24,640
!دعنا وشأننا، لا علاقة لنا

279
00:20:25,000 --> 00:20:26,840
لمَ أنتما هنا إذاً؟

280
00:20:26,840 --> 00:20:30,120
أخي، إنّهما مستعملا قوى خارقة، أليس كذلك؟

281
00:20:39,380 --> 00:20:42,550
ناوتو، ناويا. جلبتُ صودا لكما

282
00:20:44,690 --> 00:20:45,670
...ما

283
00:20:45,670 --> 00:20:46,890
هذا؟

284
00:21:03,160 --> 00:21:04,290
هيّا بنا يا ناويا

285
00:21:04,290 --> 00:21:05,110
!أجل

286
00:21:05,110 --> 00:21:06,230
!انتظرا

287
00:21:17,290 --> 00:21:18,380
!تعالا

288
00:21:20,640 --> 00:21:21,620
!بسرعة