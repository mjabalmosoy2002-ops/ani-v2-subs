1
00:00:07,480 --> 00:00:10,200
دخل رجالٌ مسلّحون المكان فجأةً

2
00:00:10,200 --> 00:00:12,270
ظننت أنّي سأموت

3
00:00:13,910 --> 00:00:16,580
كانوا يتكلّمون عن إظهار قوى خارقة لي

4
00:00:16,580 --> 00:00:18,650
إنّهم مجانين بحقّ

5
00:00:18,650 --> 00:00:22,800
من يعلم ما الذي كان سيحلّ بي
دون تدخّل فرقة حفظ الأمن

6
00:00:22,800 --> 00:00:24,710
!اليابان بلدٌ رائع

7
00:00:24,710 --> 00:00:27,080
!وقوّة فرقة حفظ الأمن القومي مهيبة

8
00:00:27,080 --> 00:00:29,190
هايتاني منفعل جدّاً

9
00:00:29,190 --> 00:00:32,800
!فرقة حفظ الأمن مذهلة! إنّهم رائعون

10
00:00:32,800 --> 00:00:36,940
،لكنّي أحبّ مشاهدة برنامج ساساكي
ولم يعرضوه بسبب هذه الأحداث

11
00:00:36,940 --> 00:00:38,240
مع أنّي ضبطت جهاز التسجيل حتّى

12
00:00:38,240 --> 00:00:41,270
تقصد ذاك الذي يكشف فيه هايتاني
حيل ذوي القوى الخارقة

13
00:00:41,270 --> 00:00:42,050
أحبّه أيضاً

14
00:00:42,050 --> 00:00:44,850
!عليّ تسجيله أيضاً! المقدّمة ساساكي ظريفة جدّاً

15
00:00:44,850 --> 00:00:46,240
إنّهم يغيظونني حقّاً

16
00:00:46,240 --> 00:00:48,730
كان عليهم الحصول على عمل
بدل القيام بهذه الهراءات

17
00:00:48,730 --> 00:00:50,920
لا بدّ أنّهم مجموعة فاشلين

18
00:00:50,920 --> 00:00:52,810
يتهرّبون من إخفاقهم ويلومون العالم

19
00:00:52,810 --> 00:00:54,070
حمقى

20
00:00:54,070 --> 00:00:55,360
والآن جميعهم موتى

21
00:00:55,860 --> 00:00:58,790
الوغد... أين ذهب؟

22
00:01:00,460 --> 00:01:02,440
اختفى ناوتو أيضاً؟

23
00:01:03,870 --> 00:01:06,130
تواصل معنا يويا

24
00:01:06,130 --> 00:01:08,210
اختفى أخوه ناويا أيضاً

25
00:01:08,210 --> 00:01:11,750
اختفى؟ من يكونان بالضبط؟

26
00:01:11,750 --> 00:01:13,860
لا أدري

27
00:01:14,550 --> 00:01:16,790
لديهم صلة بما حلّ بوالديّ أيضاً

28
00:01:16,790 --> 00:01:17,680
ماذا؟

29
00:01:17,680 --> 00:01:19,670
إنّهما يخفيان شيئاً

30
00:01:20,700 --> 00:01:23,790
سنجدهما مهما تطلّب الأمر

31
00:01:23,790 --> 00:01:25,330
إنّهما خطيران

32
00:01:25,330 --> 00:01:27,400
اقتلهما المرّة القادمة إن كان عليك ذلك

33
00:01:27,990 --> 00:01:29,400
واضح يا تاكويا؟

34
00:01:30,090 --> 00:01:30,980
أجل

35
00:03:11,270 --> 00:03:12,160
!ناويا

36
00:03:14,030 --> 00:03:15,850
...أخي

37
00:03:16,270 --> 00:03:19,140
حمداً لله... أنت بأمان

38
00:03:19,770 --> 00:03:21,770
أجل، أنت كذلك

39
00:03:21,770 --> 00:03:23,020
أين نحن؟

40
00:03:31,300 --> 00:03:32,920
إنّه ميكوريا بالتأكيد

41
00:03:33,390 --> 00:03:34,590
لنذهب للقائه

42
00:03:39,620 --> 00:03:41,000
لمَ هي هنا؟

43
00:03:44,370 --> 00:03:45,450
!إيميلي-سان

44
00:03:50,010 --> 00:03:51,120
اختفت؟

45
00:03:52,350 --> 00:03:53,330
هيّا بنا

46
00:04:07,990 --> 00:04:10,190
ناوتو، ناويا

47
00:04:10,920 --> 00:04:12,740
تسرّني رؤيتكما مُجدّداً

48
00:04:12,740 --> 00:04:15,730
!ما كانت نيّتك؟ لمَ كذبت علينا؟

49
00:04:16,700 --> 00:04:18,240
كذبت؟

50
00:04:18,240 --> 00:04:21,310
قلتَ أنّ العالم سينتبه لوجود الطاقة الروحيّة

51
00:04:21,310 --> 00:04:24,410
وأنّ التخاطر ورؤية المستقبل وتحريك الأشياء
سيُعترف بها جميعاً

52
00:04:24,410 --> 00:04:27,140
كقدرات من استطاعة البشر أساساً

53
00:04:27,140 --> 00:04:28,440
ذلك ما قلتَه

54
00:04:28,440 --> 00:04:30,390
!أكانت كلها كذبة؟

55
00:04:30,390 --> 00:04:31,570
لم تكن كذبة

56
00:04:31,570 --> 00:04:35,170
!لا تعبث معي! حاولوا قتلنا

57
00:04:35,170 --> 00:04:37,270
وكانوا أصحاب قوى خارقة أيضاً

58
00:04:37,270 --> 00:04:39,870
هذا مخالف للعالم الذي وصفتَه تماماً

59
00:04:39,870 --> 00:04:42,880
أهذا العالم الذي تكلّمتَ عنه يا ميكوريا-سان؟

60
00:04:43,740 --> 00:04:50,010
ناوتو، ناويا، لدينا دورٌ لنؤديه جميعاً

61
00:04:50,390 --> 00:04:51,660
دور؟

62
00:04:52,010 --> 00:04:54,380
...طبيعة ذاك الدور

63
00:04:58,270 --> 00:04:59,780
!يكفي

64
00:04:59,780 --> 00:05:02,080
!لا علاقة لهذا بنا

65
00:05:02,750 --> 00:05:04,330
!أجبني يا ميكوريا

66
00:05:08,130 --> 00:05:13,150
عام 2023، وقعت حادثةٌ كبيرة على الأرض

67
00:05:14,520 --> 00:05:15,790
سفر أبعاد

68
00:05:16,830 --> 00:05:18,290
سفر أبعاد؟

69
00:05:23,570 --> 00:05:27,800
في أحد الأيام، اختفى ثلثا البشريّة فجأةً

70
00:05:28,190 --> 00:05:31,020
انتقلوا لبعدٍ آخر

71
00:05:31,020 --> 00:05:31,880
ماذا؟

72
00:05:31,880 --> 00:05:33,410
ما قصدك؟

73
00:05:34,040 --> 00:05:38,200
تبقّى ثلث في هذا العالم

74
00:05:38,670 --> 00:05:41,440
طرأ على الأرض تغييرٌ كبير

75
00:05:41,440 --> 00:05:44,230
أتتوقّع منّا تصديق هذا الكلام؟

76
00:05:48,120 --> 00:05:50,740
من خضع لسفر الأبعاد

77
00:05:50,740 --> 00:05:53,490
كانوا أناساً قبلوا الطاقة الروحيّة

78
00:05:53,490 --> 00:05:56,860
سفر الأبعاد... أين ذهبوا؟

79
00:05:56,860 --> 00:05:58,300
الأرض

80
00:05:58,300 --> 00:06:00,910
أتقصد أنّهم انتقلوا للماضي أو المستقبل؟

81
00:06:00,910 --> 00:06:03,460
كلا، أرض أخرى

82
00:06:03,460 --> 00:06:05,150
أرض أخرى؟

83
00:06:05,150 --> 00:06:09,400
العالم الخارجي الذي رأيتموه هو العالم المهجور

84
00:06:09,400 --> 00:06:11,180
وهو الأرض أيضاً

85
00:06:11,180 --> 00:06:12,910
ما الذي تتكلّم عنه؟

86
00:06:12,910 --> 00:06:20,020
نحن... وبقيّة البشر في هذا العالم
على الأرض المهجورة؟

87
00:06:20,020 --> 00:06:21,240
أجل

88
00:06:21,240 --> 00:06:26,870
لكنّكما مختلفان، قبلتما التغيير

89
00:06:26,870 --> 00:06:29,520
وقواكما دليلٌ على ذلك

90
00:06:30,810 --> 00:06:36,870
أخبرني ميساكي-سان سابقاً أنّ
هذا التغيير الكبير قادم

91
00:06:37,360 --> 00:06:43,340
بإرشاده تمكّنت من بناء هذا المختبر وجلبكما إليه

92
00:06:43,340 --> 00:06:45,030
!كيف لك التصرّف بهذه الأنانيّة؟

93
00:06:45,030 --> 00:06:47,420
!لم نرد أيّاً من هذا

94
00:06:47,420 --> 00:06:49,090
!ناوتو! ناويا

95
00:06:49,090 --> 00:06:51,510
!أبي! أمّي

96
00:06:53,680 --> 00:06:55,180
آسف

97
00:06:55,180 --> 00:06:59,230
لكن كان شيئاً يحتاجه العالم

98
00:06:59,230 --> 00:07:01,000
يحتاجه؟ كيف؟

99
00:07:01,000 --> 00:07:06,410
كان العالم يحتاج لانفصالنا عن والدينا
وأن نُجلب هنا؟

100
00:07:06,410 --> 00:07:07,520
اختفى الكثير من الناس

101
00:07:07,520 --> 00:07:11,080
وهُجِر عالمٌ ينكر وجود الطاقة الروحيّة

102
00:07:11,080 --> 00:07:12,710
!خُدعت أنت أيضاً

103
00:07:12,710 --> 00:07:14,320
!هراء "الدور" مجرّد خيال

104
00:07:14,320 --> 00:07:16,490
ناوتو، إنّها الحقيقة

105
00:07:17,140 --> 00:07:20,630
...في ذاك اليوم وتلك اللحظة، عام 2014

106
00:07:20,630 --> 00:07:23,140
خضتما سفر أبعاد

107
00:07:24,000 --> 00:07:25,900
...أسرع من أيّ أحد

108
00:07:26,270 --> 00:07:30,660
غادرتما أمام ناظريّ

109
00:07:38,770 --> 00:07:41,730
اختفيتما من على سطح هذه الأرض قبلاً

110
00:07:41,730 --> 00:07:45,030
كنذير بسفر الأبعاد المُقبل

111
00:07:45,480 --> 00:07:48,730
كذب، لا أتذكّر أيّاً من هذا

112
00:07:49,080 --> 00:07:52,030
،قبلتَ وجود الطاقة الروحيّة

113
00:07:52,030 --> 00:07:54,000
فلمَ لا تستطيع التصديق؟

114
00:07:57,080 --> 00:07:59,070
أنا لا أفهم أيضاً

115
00:07:59,670 --> 00:08:03,500
لكن لا يبدو لي أنّ ميكوريا-سان يكذب علينا

116
00:08:07,710 --> 00:08:12,350
أتى وقت انتقال الأرض القديمة لبعدٍ آخر

117
00:08:12,350 --> 00:08:14,970
لتصبح أرضاً يُقبل فيها العالم الروحيّ

118
00:08:14,970 --> 00:08:17,470
يُقبل فيها العالم الروحيّ؟

119
00:08:17,470 --> 00:08:18,460
أجل

120
00:08:18,460 --> 00:08:22,500
في الأرض الأخرى، الطاقة الروحيّة جزء
لا يتجزأ من الحياة العاديّة

121
00:08:22,500 --> 00:08:27,280
والمجتمع مبنيّ على إدراك عميق له

122
00:08:27,280 --> 00:08:30,690
إنّه عالمٌ جميل بلا حروب أو حدود

123
00:08:31,310 --> 00:08:34,100
إنّه العالم الذي ذكرته لكما

124
00:08:34,710 --> 00:08:38,970
والعالم الذي يُفترض أن تكونا فيه رفقة والديكما

125
00:08:39,930 --> 00:08:45,220
لكن من الصحيح أنّه يوجد أشخاص
ليسوا جديرين بذاك العالم أيضاً

126
00:08:45,220 --> 00:08:51,520
لذا تركتهم إرادة الأرض في بعدهم
القديم قبل مغادرتها

127
00:08:53,630 --> 00:08:56,180
هناك أرضان؟ عالمان؟

128
00:08:56,180 --> 00:09:00,600
نحن في العالم المهووس بالعالم الماديّ

129
00:09:00,600 --> 00:09:03,490
ومعزولون عن العالم الروحيّ

130
00:09:03,490 --> 00:09:06,460
عالمٌ مهجور

131
00:09:07,480 --> 00:09:11,360
هذا العالم كما شهدتم

132
00:09:11,800 --> 00:09:15,270
مجموعة صغيرة من الناس
يعبدون العالم الماديّ

133
00:09:15,270 --> 00:09:20,630
يفرضون سيطرتهم على المجتمع
عبر إنكار الطاقة الروحيّة

134
00:09:21,210 --> 00:09:25,910
يتملّكهم الهوس بالماديّة والمال والقوّة

135
00:09:25,910 --> 00:09:30,560
،القتال والتنافس والفقر والثراء
تشتدّ حدّة كلّ هذه الأشياء

136
00:09:31,300 --> 00:09:35,690
ميكوريا، قلتَ أنّنا غادرنا

137
00:09:35,690 --> 00:09:39,280
إن كان ذلك صحيحاً، فماذا نفعل هنا؟

138
00:09:39,900 --> 00:09:41,520
كانت كلماته الأخيرة

139
00:09:41,520 --> 00:09:48,160
ترك ميساكي-سان طلباً في عهدتي
بأن أعيدكما هنا مرّةً أخرى

140
00:09:48,520 --> 00:09:50,580
تعيدنا؟

141
00:09:50,580 --> 00:09:53,920
هل ميساكي-سان هذا مستعمل قوى خارقة؟

142
00:09:53,920 --> 00:09:56,720
حديثي معكما الآن

143
00:09:56,720 --> 00:10:02,000
هي لأنّي اتّبعت كلماته الأخيرة... بل نبوءته

144
00:10:08,540 --> 00:10:10,460
حان الوقت أخيراً

145
00:10:12,100 --> 00:10:13,320
أأنت بخير؟

146
00:10:15,360 --> 00:10:20,510
ميكوريا، هل لا تزال تصدّق
كلمات ميساكي-سان الأخيرة؟

147
00:10:20,900 --> 00:10:22,960
بالطبع

148
00:10:22,960 --> 00:10:26,440
كان لآخرين نبوءات مشابهة، أليس كذلك؟

149
00:10:26,440 --> 00:10:30,350
بلى، لكن من الصعب على الناس أن يصدّقوها

150
00:10:30,350 --> 00:10:33,600
يوجد مستعملو قوى خارقة
متمسّكون بالعالم الماديّ أيضاً

151
00:10:34,250 --> 00:10:38,080
الثروة والقوّة والشهوة

152
00:10:38,470 --> 00:10:43,120
يصبح الناس مهووسين بهذه الأشياء
فورما تتوفر لهم مرّةً

153
00:10:43,450 --> 00:10:47,770
في قصّة سفينة نوح، مات كلّ المهجورين

154
00:10:48,830 --> 00:10:52,790
وستنقذ أنت المهجورين مع ذلك؟

155
00:10:53,210 --> 00:10:57,300
هذا دورنا الذي أظهره لنا ميساكي-سان

156
00:11:00,600 --> 00:11:06,260
لوشكوف، للجميع في هذا العالم دورٌ ليؤدوه

157
00:11:06,260 --> 00:11:07,960
واصل جهودك

158
00:11:07,960 --> 00:11:08,810
أجل

159
00:11:14,990 --> 00:11:19,980
في اليوم الخامس والعشرين من يوليو، 2023

160
00:11:19,980 --> 00:11:23,390
كنتُ رفقة لوشكوف في روسيا

161
00:11:24,120 --> 00:11:25,890
،كما أخبرتني به نبوءة ميساكي-سان

162
00:11:25,890 --> 00:11:30,010
أمضيتُ الليلة في المختبر، ثمّ خرجت

163
00:11:30,880 --> 00:11:34,410
تحقّقت من التاريخ، وكانت 3 أشهر قد مضت

164
00:11:36,550 --> 00:11:41,280
لم يمتلك المهجورون أيّ ذكريات
للثلاثة أشهر الفائتة

165
00:11:41,880 --> 00:11:45,100
اختفى ثلثا البشريّة فجأةً

166
00:11:45,100 --> 00:11:49,520
وثارت الفوضى في العالم المنتقل زمنيّاً

167
00:11:50,140 --> 00:11:51,320
...أخي

168
00:11:51,320 --> 00:11:54,730
أجل، قالت تاتشيبانا-سان الشيء نفسه

169
00:11:56,600 --> 00:12:02,700
كانت لديهم أدوراهم عندما ظهروا أمامكم

170
00:12:04,090 --> 00:12:08,080
،وبعد وفائهم بأدوارهم

171
00:12:08,080 --> 00:12:10,000
رجعوا لحيث ينتمون

172
00:12:11,620 --> 00:12:13,580
الأمر نفسه مع فوتامي شوكو

173
00:12:15,030 --> 00:12:21,170
...إعادتكما للعالم الذي غادرتماه

174
00:12:21,690 --> 00:12:24,660
كان دوري

175
00:12:24,660 --> 00:12:27,810
والتقيتُ تلك الفتاة كما ذكرت نبوءة ميساكي-سان

176
00:12:29,280 --> 00:12:33,440
احتجتها لإعادتكما

177
00:12:33,440 --> 00:12:37,050
كان دماغ شوكو قد اتّصل بأبعاد
،أسمى لسوء الحظّ

178
00:12:37,050 --> 00:12:40,320
فكانت تجوب مجالات الزمكان

179
00:12:41,330 --> 00:12:44,710
كانت رسائلها أحياناً موجّهة أيضاً

180
00:12:44,710 --> 00:12:48,330
للناس المهجورين في هذا العالم

181
00:12:52,320 --> 00:12:55,000
انتهيتُ من ضبط شوكو والأطفال

182
00:12:55,000 --> 00:12:56,710
!صلهم فوريّاً

183
00:12:56,710 --> 00:12:58,840
!أسرع! ميكوريا يغادر

184
00:12:58,840 --> 00:12:59,870
عُلِم

185
00:13:01,820 --> 00:13:05,140
،كما ذكرت نبوءة ميساكي-سان

186
00:13:05,140 --> 00:13:12,570
استعملتُ قوّة شوكو كما ثمانية
أطفال آخرين لإعادتكما

187
00:13:12,570 --> 00:13:16,830
فصنعتُ عالماً وسيطاً بين الأرضين

188
00:13:31,370 --> 00:13:32,940
هل نجح الأمر؟

189
00:13:56,210 --> 00:13:57,880
!دعنا نرجع للمنزل

190
00:13:57,880 --> 00:14:00,620
!سنرجع للبيت

191
00:14:00,620 --> 00:14:03,230
!سنرجع

192
00:14:07,630 --> 00:14:10,540
...ناوتو... ناويا

193
00:14:18,290 --> 00:14:20,700
عدتما

194
00:14:20,700 --> 00:14:23,840
بدأ الزمن بالجريان مُجدداً من تلك اللحظة

195
00:14:23,840 --> 00:14:26,860
وتتوقّع منّا تصديق هذا؟

196
00:14:27,460 --> 00:14:31,240
مُنحت وقتاً لتربيتكما

197
00:14:31,710 --> 00:14:34,880
في هذا المختبر في العالم الوسيط

198
00:14:34,880 --> 00:14:36,930
العالم الوسيط؟

199
00:14:37,550 --> 00:14:41,870
ناوتو، ناويا، لم تُتركا

200
00:14:41,870 --> 00:14:43,940
بل رجعتما للإيفاء بدوركما

201
00:14:43,940 --> 00:14:46,640
...ادّعاءات أنانيّة! أنت من أعاد

202
00:14:45,620 --> 00:14:48,400
ما هو دورنا؟

203
00:14:48,720 --> 00:14:51,340
إنقاذ المهجورين في هذا العالم

204
00:14:51,340 --> 00:14:55,000
الجديرون منهم بالعالم الآخر

205
00:14:55,000 --> 00:14:56,520
إنقاذ؟

206
00:14:56,520 --> 00:15:00,070
ننقذ سكّان هذا العالم الذين
يكرهوننا ويسخرون منّا؟

207
00:15:00,070 --> 00:15:00,990
أجل

208
00:15:00,990 --> 00:15:05,450
،الذين اختفوا مع آبائنا موجودون في العالم الآخر

209
00:15:05,450 --> 00:15:08,490
إذا كنت هناك، تختفي الحاجة للصراع

210
00:15:08,490 --> 00:15:11,070
لدينا حياة مسالمة لنعيشها في ذاك المكان

211
00:15:11,070 --> 00:15:12,220
صحيح

212
00:15:12,220 --> 00:15:13,300
!هراء

213
00:15:13,600 --> 00:15:16,080
!لا نريد هذا الدور

214
00:15:16,080 --> 00:15:17,910
...نحن فقط

215
00:15:17,910 --> 00:15:18,850
...أخي

216
00:15:18,850 --> 00:15:23,290
أردنا حياةً عاديّة فقط

217
00:15:23,660 --> 00:15:27,110
!هذا... هذا كلّ شيء

218
00:15:28,740 --> 00:15:30,860
تخبرنا بالتضحية بأنفسنا

219
00:15:30,860 --> 00:15:34,820
وأن نبقى في هذا العالم لأداء دورنا؟

220
00:15:34,820 --> 00:15:38,350
صنعت هذا المكان لإعادتنا؟

221
00:15:38,660 --> 00:15:41,120
!أرجعنا لعالمنا

222
00:15:41,680 --> 00:15:44,110
التضحية؟ أجل

223
00:15:44,110 --> 00:15:47,070
يتطلّب أداء الدور ألماً أحياناً

224
00:15:47,070 --> 00:15:48,500
ألماً؟

225
00:15:48,500 --> 00:15:49,790
أجل

226
00:15:49,790 --> 00:15:55,680
لأجل المهجورين... شاركوهم ألمهم ومعاناتهم

227
00:16:04,080 --> 00:16:04,560
!تبّاً

228
00:16:05,540 --> 00:16:07,790
مهلك، لا تنفعل هكذا

229
00:16:07,790 --> 00:16:09,190
!لستُ منفعلاً

230
00:16:13,900 --> 00:16:16,120
إنّه متضايق حقّاً

231
00:16:17,660 --> 00:16:19,620
تركناهما يهربان مجدّداً إذاً؟

232
00:16:20,440 --> 00:16:22,970
لم أصمد ولا ميتشيو لحظةً حتّى

233
00:16:22,970 --> 00:16:25,490
يبدو أنّنا بحاجةٍ لتمرين أكثر

234
00:16:25,490 --> 00:16:28,940
ريكا، من تظنّينهما؟

235
00:16:30,680 --> 00:16:32,030
مستعملا قوى خارقة

236
00:16:32,030 --> 00:16:33,210
أعرف ذلك

237
00:16:33,210 --> 00:16:35,560
مجرمان يشكّلان تهديداً للمجتمع

238
00:16:35,560 --> 00:16:37,380
هذا ما يقوله مسؤولنا

239
00:16:37,380 --> 00:16:38,570
أجل

240
00:16:46,450 --> 00:16:47,570
!درع

241
00:16:54,090 --> 00:16:56,910
تحسّنتَ في التحكّم به

242
00:16:57,680 --> 00:17:01,660
تحكّم بالمعلومات التي تأتي من الخارج هكذا

243
00:17:01,660 --> 00:17:02,550
أجل

244
00:17:02,550 --> 00:17:07,210
تحكّم بتدفق المعلومات القادمة، وخذ منها حاجتك فقط

245
00:17:07,530 --> 00:17:09,720
لا يمكنني أن أذهب وأرى بنفسي؟

246
00:17:09,720 --> 00:17:14,090
أتوقّع ذلك ممكناً، لكن لا تتعمّق

247
00:17:17,240 --> 00:17:20,100
لكن كذلك الضغط على دماغك

248
00:17:20,100 --> 00:17:21,720
التعمّق المفرط خطير

249
00:17:21,720 --> 00:17:24,410
فهمت ذلك، لكن أريد أن أجرّب

250
00:17:26,580 --> 00:17:28,230
يا لطمعك

251
00:17:28,680 --> 00:17:33,230
لا بأس، وجّه نظرك على ما تريد معرفته

252
00:17:34,230 --> 00:17:37,200
وركّز في مجالٍ واسع

253
00:17:44,450 --> 00:17:46,160
تاكويا، يويا

254
00:17:46,160 --> 00:17:47,600
جلبت صودا لكما

255
00:17:49,600 --> 00:17:51,710
...المعلومات التي أريدها

256
00:17:52,190 --> 00:17:55,680
أجل، ما تريد معرفته

257
00:18:11,700 --> 00:18:13,300
لا خيار بيدنا

258
00:18:27,210 --> 00:18:29,330
!أعد التفكير رجاءً

259
00:18:31,690 --> 00:18:33,170
!يويا، توقّف

260
00:18:33,840 --> 00:18:35,760
!لا تتعمّق أكثر

261
00:18:50,190 --> 00:18:51,690
!يوكو! يوكو

262
00:18:55,190 --> 00:18:56,280
!يويا

263
00:18:56,550 --> 00:18:58,030
!يويا! تماسك

264
00:19:00,500 --> 00:19:01,610
أهو بخير؟

265
00:19:01,950 --> 00:19:03,050
أجل

266
00:19:03,050 --> 00:19:04,930
سأرسل الفريق الطبيّ فوراً

267
00:19:04,930 --> 00:19:06,040
من فضلك

268
00:19:08,250 --> 00:19:10,040
قوّة مذهلة

269
00:19:10,500 --> 00:19:15,330
يمكنه إعادة تصوير الذكريات
في لا وعيه بهذا الوضوح

270
00:19:15,330 --> 00:19:17,830
لا يمكن لصاحب قوى خارقة عاديّ فعل ذلك

271
00:19:19,340 --> 00:19:23,580
لكن... لمَ يوجد الأخوان كيريهارا
داخل ذكريات يويا؟

272
00:19:27,590 --> 00:19:30,320
هنالك ما أريد أن أريكما إيّاه

273
00:19:31,830 --> 00:19:33,140
ما هو؟

274
00:19:36,980 --> 00:19:38,140
ما هذا؟

275
00:19:38,680 --> 00:19:41,060
مذكّرة لشوكو

276
00:19:41,490 --> 00:19:44,060
يُفترض أن تفيدكما

277
00:19:44,790 --> 00:19:47,260
مذكّرة لشوكو-سان؟

278
00:20:04,280 --> 00:20:06,320
ناوتو، ناويا

279
00:20:07,060 --> 00:20:12,820
الأعوام التي أمضيتها معكما كانت زمناً ثميناً لي

280
00:20:13,860 --> 00:20:16,720
أشكركما من أعماق قلبي

281
00:20:18,500 --> 00:20:19,890
ميكوريا-سان

282
00:20:33,290 --> 00:20:37,000
ناوتو، ناويا، أعتمد عليكما

283
00:20:37,940 --> 00:20:42,690
...بقوّتكما... فلتقوما بإنقاذ هذه الأرض

284
00:20:42,690 --> 00:20:44,970
...وهذا العالم

285
00:20:45,400 --> 00:20:48,000
!ما الذي تقول أنّ بمقدورنا فعله؟

286
00:20:50,450 --> 00:20:51,890
ميكوريا؟

287
00:21:03,240 --> 00:21:04,330
أخي

288
00:21:04,330 --> 00:21:07,190
،لا أدري ما هو دورنا تماماً

289
00:21:07,190 --> 00:21:10,450
...لكن إن كان هناك ما يسعنا فعله