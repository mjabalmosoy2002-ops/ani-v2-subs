1
00:00:01,290 --> 00:00:05,530
يبدو وكأنّه لم يمضِ الوقت إطلاقاً
،منذ أتيتُ إلى الجملونات الخضراء

2
00:00:05,530 --> 00:00:08,990
لكن انتهى الرّبيع، وبلغتُ الثّانية عشر

3
00:00:09,650 --> 00:00:12,000
اليوم ينتهي الفصل المدرسيّ

4
00:00:12,000 --> 00:00:14,190
وغداً تبدأ عطلة الصّيف

5
00:00:18,700 --> 00:00:22,740
لم أتوقّع أبداً أن تكوني مُولعة بالمُعلّم فيليبس

6
00:00:22,740 --> 00:00:25,330
لم أكن مُولعة به كثيراً

7
00:00:25,330 --> 00:00:27,260
بكيتُ فقط لأنّ الآخرين بكوا جميعاً

8
00:00:27,260 --> 00:00:30,220
حان الوقت كي نفترق

9
00:00:27,760 --> 00:00:32,130
لطالما صرّحت روبي غيليس بأنّها
،تكره المُعلّم فيليبس

10
00:00:32,130 --> 00:00:36,880
،لكن ما إن شرع في إلقاء خطاب الوداع
حتّى أجهشت بالبُكاء

11
00:00:36,880 --> 00:00:40,250
أوليس الفُراق مُؤلماً؟

12
00:00:42,140 --> 00:00:45,830
لكن لا يُصاب المرء بيأس شديد

13
00:00:45,830 --> 00:00:48,720
بوجود عطلة مدّتها شهران أمامه، أليس كذلك؟

14
00:00:49,090 --> 00:00:53,600
وفضلاً عن ذلك، التقينا بالوزير الجديد
!وزوجته من المحطّة

15
00:00:53,970 --> 00:00:56,610
يبدو الوزير الجديد لطيفاً جدّاً

16
00:00:57,120 --> 00:01:01,080
!وزوجته حسناء للغاية

17
00:01:01,610 --> 00:01:05,050
كانت ترتدي لباساً أزرق رقيقاً
بأكمام فضفاضة جميلة

18
00:01:05,610 --> 00:01:10,370
قالت جين آندروز أنّها شعرتٍ بأنّ الأكمام
الفضفاضة ليست بمستوى زوجة وزير

19
00:01:10,700 --> 00:01:15,130
لكن أعلم ما الّذي يعنيه أن يتوق
المرء للأكمام الفضفاضة

20
00:01:15,130 --> 00:01:18,130
لا أؤيّد ذلك بالتّأكيد

21
00:01:18,420 --> 00:01:21,410
حسناً، يسرّني أنّ مظهر الزّوجة أعجبكِ

22
00:01:21,410 --> 00:01:24,140
يجب أن ندعوهما لاحتساء الشّاي
يوماً قريباً ما

23
00:01:24,140 --> 00:01:25,640
!هذا رائع

24
00:01:25,980 --> 00:01:29,090
لكن لا تتفوّهي بكلمة عن ذلك أمام ماثيو

25
00:01:29,090 --> 00:01:31,480
سيبحث عن عذر ليغيب في ذلك اليوم

26
00:01:31,940 --> 00:01:36,860
فزوجة وزير جديد ستُرعبه بشدّة

27
00:01:37,480 --> 00:01:38,780
فهمت

28
00:01:38,780 --> 00:01:43,080
وسيأتينا مُعلّم جديد في الخريف المُقبل

29
00:01:43,080 --> 00:01:44,950
أليس من الرّائع اللّقاء بأشخاص جدُد؟

30
00:03:21,220 --> 00:03:23,460
!انتظرنَ

31
00:03:23,800 --> 00:03:25,470
!أمسكتُ بكِ

32
00:03:28,580 --> 00:03:30,190
لم أعُد قادرة على الجري خُطوة واحدة

33
00:03:30,190 --> 00:03:31,620
ولا أنا

34
00:03:31,620 --> 00:03:34,420
لنلعب لعبة التحدّي تالياً إذاً

35
00:03:34,420 --> 00:03:36,100
التحدّي؟

36
00:03:36,100 --> 00:03:37,810
القواعد بسيطة

37
00:03:37,810 --> 00:03:40,110
نتحدّى شخصاً أن يفعل شيئاً

38
00:03:40,320 --> 00:03:45,250
.إذا فعله بشكل صحيح، يربح
وإن لم يستطع، فمن تحدّاه يربح

39
00:03:45,250 --> 00:03:47,120
تبدو مُمتعة

40
00:03:47,120 --> 00:03:48,820
من سيبدأ؟

41
00:03:48,820 --> 00:03:50,810
أنا

42
00:03:50,810 --> 00:03:52,820
!وأنا أتحدّى... دايانا

43
00:03:53,880 --> 00:03:57,710
اقفزي على ساقكِ اليمنى حول
!الحديقة دون التوقُّف لحظة

44
00:03:57,960 --> 00:04:00,580
تخسرين إذا لامستْ قدمُكِ اليُسرى الأرض

45
00:04:00,580 --> 00:04:01,750
!سأفعلها

46
00:04:04,840 --> 00:04:06,840
!يمكنكِ فعلها يا دايانا

47
00:04:06,840 --> 00:04:10,220
انظرنَ. ستربح إذا واظبتْ على ذلك

48
00:04:10,760 --> 00:04:12,730
أشكُّ في ذلك

49
00:04:19,910 --> 00:04:21,650
أظنّني خسرت

50
00:04:22,980 --> 00:04:24,930
لم يكن ذلك صعباً جدّاً

51
00:04:26,010 --> 00:04:29,000
!سأتحدّاكِ تالياً يا جوسي

52
00:04:30,240 --> 00:04:32,870
!امشي على سطح ذلك السّياج

53
00:04:45,840 --> 00:04:49,110
لم يكن ذلك التحدّي صعباً إطلاقاً

54
00:04:50,310 --> 00:04:54,220
لا أعتقد بأنّ السّير على سياج
عريض مُنخفض صغير أمراً مُبهراً

55
00:04:54,220 --> 00:04:57,990
أعرف فتاة تستطيع المشي
على دعامة سقف

56
00:04:58,230 --> 00:05:01,230
حقّاً؟ لكن أنتِ لا تستطيعين على أيّ حال

57
00:05:01,230 --> 00:05:02,340
لا أستطيع؟

58
00:05:02,340 --> 00:05:03,410
!آن

59
00:05:03,410 --> 00:05:05,760
أثبتي ذلك إذاً

60
00:05:06,540 --> 00:05:07,900
،آن شارلي

61
00:05:08,250 --> 00:05:10,530
أتحدّاكِ أن تتسلّقي إلى هناك
وتمشي على الدّعامة

62
00:05:13,080 --> 00:05:14,470
لا تفعليها يا آن

63
00:05:14,470 --> 00:05:16,870
!ستسقطين وتُقتَلين

64
00:05:16,870 --> 00:05:20,210
جوسي، ليس من العدل أن تتحدّي شخصاً
!أن يفعل شيئاً خطيراً كهذا

65
00:05:20,210 --> 00:05:24,350
لكن آن ليست مُضطرّة لقبول التحدّي

66
00:05:24,350 --> 00:05:26,970
بوسعها أن ترفض دوماً

67
00:05:28,460 --> 00:05:29,480
سأفعلها

68
00:05:29,480 --> 00:05:30,470
!آن

69
00:05:35,770 --> 00:05:38,580
!أرجوكِ يا آن! لا تفعليها

70
00:05:38,580 --> 00:05:40,940
يجب أن أفعلها

71
00:05:40,940 --> 00:05:43,550
فكبريائي على المحكّ

72
00:05:44,620 --> 00:05:49,710
سأمشي على تلك الدّعامة يا دايانا
أو أموت وأنا أُحاول

73
00:06:26,300 --> 00:06:27,570
!آن

74
00:06:32,740 --> 00:06:33,490
!آن

75
00:06:40,140 --> 00:06:41,330
!آن

76
00:06:43,180 --> 00:06:44,910
!آن! استيقظي

77
00:06:45,190 --> 00:06:47,380
!آن! آن

78
00:06:47,380 --> 00:06:49,180
آن

79
00:06:49,180 --> 00:06:51,090
آن، هل أنتِ بخير؟

80
00:06:51,090 --> 00:06:54,390
لستُ مُتأكّدة. أظنّني غبتُ عن الوعي

81
00:06:54,390 --> 00:06:56,400
هل يؤلمكِ شيء؟

82
00:06:56,910 --> 00:06:58,370
كاحلي

83
00:07:04,950 --> 00:07:07,080
!ماثيو! إنّها آن

84
00:07:08,660 --> 00:07:09,650
!آن

85
00:07:09,650 --> 00:07:10,910
!ماذا حدث لها؟

86
00:07:10,910 --> 00:07:13,340
أظنّها كانت تمشي على دعامة
سقف منزلنا فسقطتْ

87
00:07:14,640 --> 00:07:16,610
لا ترتعدي يا ماريلّا

88
00:07:16,610 --> 00:07:18,410
أعتقد بأنّ كاحلي قد التوى

89
00:07:18,640 --> 00:07:22,100
لكن كان من المُمكن أن ينكسر عنقي

90
00:07:22,100 --> 00:07:25,440
لننظر إلى الجانب المُشرق من الأشياء

91
00:07:26,200 --> 00:07:28,420
!أدخلوها إلى هنا

92
00:07:28,420 --> 00:07:30,470
!يجب أن نستدعي طبيباً

93
00:07:30,470 --> 00:07:31,170
آن؟

94
00:07:31,590 --> 00:07:33,820
!آن؟! آن

95
00:07:34,320 --> 00:07:36,180
كاحلها مكسور

96
00:07:36,490 --> 00:07:39,430
تحتاج ستّة أسابيع من الرّاحة

97
00:07:39,820 --> 00:07:41,200
بالتّوفيق

98
00:07:41,200 --> 00:07:43,140
شكراً لك

99
00:07:43,690 --> 00:07:49,960
أظنّني عوقِبتُ لدرجة لن تكوني فيها
بحاجة للامتعاض منّي يا ماريلّا

100
00:07:50,450 --> 00:07:53,260
ألا تشفقين عليّ؟

101
00:07:53,260 --> 00:07:55,410
كانت غلطتكِ

102
00:07:55,410 --> 00:07:57,560
لكن ماذا كنتِ لتفعلي يا ماريلّا

103
00:07:57,560 --> 00:08:00,940
لو تحدّاكِ شخصٌ بأن تمشي
على دعامة سقف؟

104
00:08:01,210 --> 00:08:06,340
لبقيتُ ثابتة على الأرض ورفضتُ تحدّيه

105
00:08:07,280 --> 00:08:09,730
لن أتمكّن من الخروج لستّة أسابيع

106
00:08:09,730 --> 00:08:12,690
أليس من الجيّد أن أمتلك مُخيّلة كهذه؟

107
00:08:12,690 --> 00:08:15,590
ستُساعدني في تجاوز هذا الأمر
بصورة برّاقة على ما أعتقد

108
00:08:15,970 --> 00:08:21,310
ما الّذي يفعله النّاس الّذين لا يملكون مُخيّلة
عندما تُكسَر عظامهم؟

109
00:08:26,050 --> 00:08:30,600
من السّيّئ حقّاً أن يكون المرء طريح الفراش

110
00:08:29,150 --> 00:08:30,600
!آن

111
00:08:30,960 --> 00:08:33,400
لكن ثمّة جانب مُشرق للأمر

112
00:08:30,960 --> 00:08:33,610
!لا تُخيفيني هكذا يا بُنيتي

113
00:08:34,030 --> 00:08:35,600
كيف حالكِ يا آن؟

114
00:08:34,290 --> 00:08:37,750
حيث نكتشف كم لدينا من أصدقاء

115
00:08:35,600 --> 00:08:38,620
كان الجميع قلقين عليكِ

116
00:08:38,610 --> 00:08:43,450
!كانت غلطتي يا سيّدة كاثبارت
!أنا من أتى بفكرة التحدّي

117
00:08:43,450 --> 00:08:46,760
تحدّيتُها بأن تمشي على دعامة السّقف

118
00:08:47,040 --> 00:08:49,940
!لذا لا تُعاقبي آن أكثر من ذلك

119
00:08:49,940 --> 00:08:52,950
،إذا أردتِ أن تغضبي من شخص
!فاغضبي منّي أنا

120
00:08:52,950 --> 00:08:54,590
مهلاً يا آن

121
00:08:54,590 --> 00:08:57,090
ما الّذي كنتِ تزرعينه في أذهان
هؤلاء الفتيات؟

122
00:08:57,990 --> 00:08:59,520
!مُفاجأة

123
00:08:59,520 --> 00:09:01,160
أ-أليس هذا ما أعتقد؟

124
00:09:01,160 --> 00:09:03,340
!أحدث إصدارات السيّدة مورغان

125
00:09:03,340 --> 00:09:06,300
!لن تُصدّقي الحدث المُفاجئ في النّهاية

126
00:09:06,300 --> 00:09:08,070
!أنا مُتلهّفة

127
00:09:08,970 --> 00:09:12,860
تزورينني كل يوم. وأستطيع قراءة
ما أشاء من الكُتُب

128
00:09:12,860 --> 00:09:15,610
حياة المرض ليست سيّئة، أليس كذلك؟

129
00:09:15,610 --> 00:09:17,220
!يا للسّخافة

130
00:09:17,220 --> 00:09:20,580
عادت المدرسة

131
00:09:20,580 --> 00:09:23,370
ماذا عن المُعلّم الجديد؟

132
00:09:23,370 --> 00:09:28,370
المُعلّمة ستيسي لطيفة جدّاً

133
00:09:28,670 --> 00:09:34,000
لديها شعر مُتموّج جميل جدّاً
!وعينان ساحرتان

134
00:09:34,430 --> 00:09:38,120
في كلّ أسبوع لديها إلقاء

135
00:09:38,120 --> 00:09:41,040
أو تأخذ الجميع لدراسة الزّهور
والطّيور في الغابة

136
00:09:41,040 --> 00:09:43,680
ولديهم تمارين ثقافيّة جسديّة
في كلّ صباح وتمارين

137
00:09:43,680 --> 00:09:46,090
!هل سبق ورأيتِ مُعلّمة بنصف هذه الرّوعة؟

138
00:09:46,090 --> 00:09:49,050
ثمّة أمر وحيد واضح بالنّسبة لي يا آن

139
00:09:49,050 --> 00:09:52,610
وهو أنّ سقوطكِ من سطح منزل باري
لم يُصِب لسانكِ بأذى إطلاقاً

140
00:10:07,410 --> 00:10:10,250
بدأنا في تعلُّم هذه القصيدة

141
00:10:19,090 --> 00:10:21,310
صباح الخير جميعاً

142
00:10:21,310 --> 00:10:22,860
صباح الخير

143
00:10:23,170 --> 00:10:25,510
ما رأيكِ؟ أليست جميلة؟

144
00:10:25,510 --> 00:10:26,350
أجل

145
00:10:26,350 --> 00:10:31,600
شُفي كاحل آن شارلي، وعادت
إلى المدرسة اليوم

146
00:10:32,200 --> 00:10:34,860
سُررتُ بلقائكِ يا آن

147
00:10:34,860 --> 00:10:37,590
!أجل، وأنا مسرورة بلقائكِ

148
00:10:43,410 --> 00:10:45,940
أنتِ من صنع كلّ هذا يا مُعلّمة ستيسي؟

149
00:10:45,940 --> 00:10:46,740
أجل

150
00:10:46,740 --> 00:10:48,340
!مُذهل

151
00:10:48,340 --> 00:10:51,190
آمل أن تتشاركن الطّعام فيما بينكن

152
00:10:51,190 --> 00:10:52,700
باشرنَ في الطّعام

153
00:10:52,700 --> 00:10:55,220
!شكراً لكِ

154
00:10:56,720 --> 00:10:57,770
!لذيذ

155
00:10:57,770 --> 00:10:59,800
من فضلكِ، كُلي من حصّتي

156
00:10:59,800 --> 00:11:01,050
وحصّتي

157
00:11:01,530 --> 00:11:03,960
في هذه الحالة، لا أمانع أن أفعل

158
00:11:09,070 --> 00:11:11,220
لحظة، أين المُعلّمة ستيسي؟

159
00:11:19,650 --> 00:11:24,890
،وبهذا نختتم درسنا لهذا اليوم
لكن في جعبتي اقتراح

160
00:11:24,890 --> 00:11:28,420
ما رأيكم أن نُقيم حفلاً موسيقيّاً
في كريسمس المُقبل

161
00:11:28,420 --> 00:11:31,570
للمُساهمة في جمع المال وشراء
راية لبناء المدرسة؟

162
00:11:32,210 --> 00:11:34,780
فالمدرسة لا تملك راية كما تعلمون

163
00:11:34,780 --> 00:11:38,290
وفضلاً عن ذلك، أنا متأكّدة بأنّ الحفل
الموسيقىّ سيكون مُمتعاً للجميع

164
00:11:38,290 --> 00:11:40,300
!فكرة رائعة

165
00:11:40,300 --> 00:11:41,540
!جميلة للغاية

166
00:11:41,540 --> 00:11:43,060
أرغب في المُشاركة

167
00:11:43,060 --> 00:11:43,680
!وأنا

168
00:11:44,950 --> 00:11:48,420
إذاً لنُنظّم برنامجاً حالاً

169
00:11:50,540 --> 00:11:53,310
!أحبُّ المُعلّمة ستيسي من أعماق قلبي

170
00:11:53,310 --> 00:11:55,400
لديها صوت عذب

171
00:11:55,400 --> 00:12:01,200
عندما تلفظ اسمي فإنّني أشعر غريزيّاً
"بأنّها تُنهيه بحرف "إي

172
00:12:01,200 --> 00:12:03,100
يسرّني سماع هذا

173
00:12:04,320 --> 00:12:08,700
!وسألقي في حفل الكريسمس

174
00:12:09,000 --> 00:12:13,450
آمل ألّا يقتطع ذلك من وقتكِ المُخصّص لدروسكِ

175
00:12:13,450 --> 00:12:19,460
إن كان لديكِ وقت للّهو، فالأفضل أن تقضيه
على أدائكِ في الهندسة

176
00:12:19,780 --> 00:12:24,080
لا أقبل بإقامة أطفال لحفلات موسيقيّة
وسباقات على حساب الدّراسة

177
00:12:37,350 --> 00:12:42,620
حسناً إذاً، أعتقد بأنّها ستكون حفلة مُمتعة جدّاً

178
00:12:45,810 --> 00:12:52,550
وأتأمّل منكِ أن تؤدّي دوركِ بإتقان

179
00:12:53,720 --> 00:12:55,540
شكراً لك يا ماثيو

180
00:13:02,560 --> 00:13:04,560
"!عزيزي غدير بلادي"

181
00:13:04,560 --> 00:13:07,440
"!يا جدول براري الغرب"

182
00:13:07,810 --> 00:13:09,430
!رائع يا آن

183
00:13:12,440 --> 00:13:16,300
بالمُناسبة يا آن، ماذا ستلبسين
في الحفل الموسيقيّ؟

184
00:13:16,300 --> 00:13:17,230
ماذا سألبس؟

185
00:13:17,770 --> 00:13:19,310
هذا على ما أعتقد

186
00:13:24,950 --> 00:13:28,570
!الجميع بأكمام فضفاضة باستثناء آن

187
00:13:35,090 --> 00:13:38,330
بما يمكنني خدمتك هذا المساء
يا سيّد كاثبارت؟

188
00:13:38,920 --> 00:13:40,510
—هل لديكِ أي

189
00:13:40,510 --> 00:13:44,750
أي... أي... أعني، قشّاشة عشب؟

190
00:13:44,750 --> 00:13:45,640
بالتّأكيد

191
00:13:50,180 --> 00:13:52,440
هل من شيء آخر اللّيلة يا سيّد كاثبارت؟

192
00:13:52,440 --> 00:13:56,960
...في الواقع، أ... أريد... أعني
...أريد شراء

193
00:13:56,960 --> 00:13:59,220
بذر حشيش

194
00:13:59,220 --> 00:14:02,130
لا نحتفظ ببذر الحشيش إلّا في الرّبيع

195
00:14:02,670 --> 00:14:05,820
بالتّأكيد... معكِ حقّ

196
00:14:05,820 --> 00:14:06,830
سيّد كاثبارت! لم تدفع

197
00:14:08,860 --> 00:14:10,660
آسف بشأن ذلك

198
00:14:12,750 --> 00:14:14,210
...في الحقيقة

199
00:14:14,210 --> 00:14:14,950
!تفضّل

200
00:14:14,950 --> 00:14:18,450
،إن لم يكن لديكِ مانع

201
00:14:18,450 --> 00:14:23,910
...أريد... أعني... أريد أن أنظر إلى... بعض

202
00:14:23,910 --> 00:14:25,600
!سكّر أسمر

203
00:14:27,730 --> 00:14:31,840
ولدينا الكثير من القشّاشات في الحظيرة

204
00:14:31,840 --> 00:14:33,980
ارتأيتُ أنّها ستنفع بين الحين والآخر

205
00:14:40,230 --> 00:14:41,930
أختار فستاناً لتعطيه لآن؟

206
00:14:41,930 --> 00:14:44,490
لم أستطع الطّلب من ماريلّا

207
00:14:45,130 --> 00:14:48,980
هل يجول شيء مُحدّد في ذهنك؟

208
00:14:49,250 --> 00:14:51,780
...لا أدري. الأكمام

209
00:14:51,780 --> 00:14:55,370
!فضفاضة؟ بالطّبع

210
00:15:07,550 --> 00:15:10,350
لديّ ما طلبَتْه بالضّبط

211
00:15:10,350 --> 00:15:11,680
وماذا طلبت؟

212
00:15:15,070 --> 00:15:20,190
هذا ما كان ماثيو يُخفيه طوال أسبوعين إذاً؟

213
00:15:24,380 --> 00:15:26,610
!عيد ميلاد مجيد يا ماريلّا

214
00:15:26,610 --> 00:15:28,970
!عيد ميلاد مجيد يا ماثيو

215
00:15:28,970 --> 00:15:33,080
أوليس هذا كريسمس جميلاً؟
يسرّني أنّه مكسو بالأبيض

216
00:15:34,830 --> 00:15:36,220
ما الأمر؟

217
00:15:40,870 --> 00:15:42,720
تفضّلي يا آن

218
00:15:42,720 --> 00:15:45,690
ماذا؟ هل هذا لي؟

219
00:15:45,690 --> 00:15:47,230
افتحيه وسترين

220
00:15:54,340 --> 00:15:58,480
يمكنكِ ارتداؤه في حفلكِ الموسيقيّ اللّيلة

221
00:16:03,470 --> 00:16:06,340
ما الأمر يا آن؟ ألم يُعجبكِ؟

222
00:16:07,020 --> 00:16:10,680
!لقد أعجبني كثيراً

223
00:16:12,280 --> 00:16:16,710
!ماثيو، إنّه مُبهر جدّاً

224
00:16:17,200 --> 00:16:19,950
لا أوفيك حقّك مهما شكرتُك

225
00:16:20,270 --> 00:16:23,950
أشعر وكأنّني أرى حلماً جميلاً

226
00:16:25,810 --> 00:16:29,970
بصراحة يا آن، لا أعتقد بأنّكِ
تحتاجين الفستان

227
00:16:30,290 --> 00:16:34,680
لكن بما أنّ ماثيو أحضره لكِ، فاحرصي
على أن تعتني به جيّداً

228
00:16:34,680 --> 00:16:35,970
سأفعل بالطّبع

229
00:16:35,970 --> 00:16:39,970
أقسم بهذه الأكمام بأنّني
سأنجح بينما أرتديه

230
00:16:40,270 --> 00:16:43,320
لذا يجب أن تأتيا ورؤية إلقائي

231
00:16:43,320 --> 00:16:44,580
حسناً

232
00:16:48,730 --> 00:16:52,740
"كانتا روبي وجين في "ملكة الجنّ

233
00:16:52,740 --> 00:16:53,900
حظّاً سعيداً

234
00:16:53,900 --> 00:16:54,700
شكراً

235
00:16:54,700 --> 00:16:57,730
"التّالي، إلقاء "إلى نهر أوتر

236
00:16:58,110 --> 00:17:00,730
آن شارلي، تقدّمي لو سمحتِ

237
00:17:43,310 --> 00:17:45,790
!عزيزي غدير بلادي

238
00:17:46,910 --> 00:17:50,510
!يا جدول براري الغرب

239
00:17:51,150 --> 00:17:55,970
ولوح العبور الخشبيّ، وأشجّار
الصّفصاف الرّماديّة على جانبيه

240
00:17:56,400 --> 00:18:00,680
،وسرير الرّمال المصبوغة بألوان مختلفة

241
00:18:01,000 --> 00:18:04,920
!تلمع من وراء سطح شفّاف برّاق

242
00:18:05,560 --> 00:18:07,710
،تجول في خاطري

243
00:18:07,710 --> 00:18:09,050
!رؤى الطّفولة

244
00:18:09,050 --> 00:18:11,090
كم أفتنتني رؤياك

245
00:18:12,790 --> 00:18:16,760
،هموم رجل وحيد

246
00:18:16,760 --> 00:18:19,880
تتلوها تنهيدة عميقة

247
00:18:20,690 --> 00:18:25,000
!وكأنّني عدتُ طفلاً مُستهتراً

248
00:18:41,550 --> 00:18:44,350
آن! كان ذلك بديعاً حقّاً

249
00:18:44,710 --> 00:18:46,500
ما كنتُ لأنجح في ذلك لولاكم جميعاً

250
00:18:46,860 --> 00:18:51,400
التّالي، دايانا باري ستُنشد
"ترنيمة الجزيرة"

251
00:18:51,400 --> 00:18:54,600
يا إلهي. أشعر بتوتُّر شديد

252
00:18:54,600 --> 00:18:56,860
هل يمكنني الصّعود والغناء هكذا حقّاً؟

253
00:18:56,860 --> 00:19:00,580
ابحثي عن أمّكِ وأبيكِ بين الجمهور

254
00:19:00,580 --> 00:19:02,610
ينبغي هذا أن يهدّئ أعصابكِ

255
00:19:02,610 --> 00:19:03,780
!مُحال أن أستطيع

256
00:19:03,780 --> 00:19:06,880
النّظر إلى النّاس بينما يُشاهدونني
لن يُزيد الأمور إلّا سوءاً

257
00:19:06,880 --> 00:19:08,890
إذاً انظري إليّ

258
00:19:08,890 --> 00:19:12,880
يجدر بكِ أن تتمكّني من فعل ذلك
بما أنّني سأكون في الصفّ الأوّل

259
00:19:14,790 --> 00:19:17,890
والآن انظري إليّ أنا، لا مكان آخر، وغنّي

260
00:19:17,890 --> 00:19:19,570
حسناً. سأحاول

261
00:19:19,570 --> 00:19:21,200
أنا متأكّدة بأنّكِ ستُلهبين حماس الجمهور

262
00:19:28,350 --> 00:19:30,810
ألم تكن أُمسية رائعة؟

263
00:19:30,810 --> 00:19:34,170
أجل. أعتقد حقّقنا مبلغاً قدره عشر جنيهات

264
00:19:34,650 --> 00:19:38,120
قصدتُ أداءكِ الفرديّ يا دايانا

265
00:19:38,120 --> 00:19:41,650
شعرتُ بفخر أكبر ممّا شعرتِ
عندما تمّ إعادة إلقائها

266
00:19:41,970 --> 00:19:47,260
قلتُ لنفسي فحسب، "إنّها صديقتي الحميمة
"العزيزة المُوقّرة جدّاً

267
00:19:47,660 --> 00:19:49,730
تستحقّين كلّ المديح يا آن

268
00:19:49,730 --> 00:19:52,190
لم تشيحي بنظركِ عنّي أبداً

269
00:19:52,190 --> 00:19:55,460
وقلتِ شيئاً، أليس كذلك؟

270
00:19:57,550 --> 00:19:59,860
ما الّذي قلتِه؟

271
00:19:59,860 --> 00:20:01,540
ما الّذي قلتُه؟

272
00:20:11,150 --> 00:20:12,550
ستبلين حسناً

273
00:20:14,140 --> 00:20:19,940
أظنّني قلتُ، "ستبلين حسناً" رغم
أنّني لستُ مُتيقّنة

274
00:20:19,940 --> 00:20:21,240
لستِ مُتيقّنة؟

275
00:20:21,240 --> 00:20:25,870
فهمت، "ستبلين حسناً"، لكنّكِ
لستِ مُتيقّنة ممّا قلتِه؟

276
00:20:25,870 --> 00:20:28,240
قلتُ بأنّني لستُ مُتيقّنة
لأنّني لا أستطيع التذكُّر

277
00:20:29,320 --> 00:20:31,580
،على ذكر ذلك

278
00:20:31,990 --> 00:20:34,130
...قُبيل أن أصعد خشبة المسرح

279
00:20:34,130 --> 00:20:35,120
آن؟

280
00:20:38,070 --> 00:20:42,140
رأيتُ غيلبارت يلتقط وردة من الأرض

281
00:20:42,860 --> 00:20:46,240
أعتقد كانت الوردة الّتي وضعتِها في شعركِ

282
00:20:46,700 --> 00:20:50,970
لـ-لا يعنيني ما يفعله ذلك الشّخص

283
00:20:50,970 --> 00:20:52,720
!انتظري يا آن

284
00:20:52,720 --> 00:20:55,740
...لستُ مُتيقّنة، لكن أعتقد أنّ غيلبارت

285
00:20:56,890 --> 00:21:00,490
إذاً أعتقد بأنّ ابنتنا آن أبلتْ
حسناً مثلها كمثل الآخرين

286
00:21:00,950 --> 00:21:01,850
أجل، صحيح

287
00:21:01,850 --> 00:21:06,190
،كنتُ مُعارضة لفكرة الحفل هذه
لكن كنتُ فخورة بآن اللّيلة

288
00:21:06,570 --> 00:21:10,770
إنّها أكثر إشراقاً وتستحقّ
أكثر ممّا منحناها إيّاه

289
00:21:11,220 --> 00:21:16,580
أجل، تحتاج شيئاً أفضل من مدرسة
أفونليا شيئاً فشيئاً

290
00:21:17,570 --> 00:21:25,080
يجب أن نرى ما الّذي يمكننا فعله
لأجلها في إحدى هذه الأيّام

291
00:21:26,500 --> 00:21:33,040
ماثيو، أعتقد أفضل شيء يمكننا فعله
لأجلها هو إرسالها إلى منزل الملِكة

292
00:21:36,840 --> 00:21:43,360
حسناً، لا ضير من التّفكير في الأمر
بين الحين والآخر

293
00:21:44,350 --> 00:21:51,010
الفستان الّذي طرّزته السيّدة ليندي
طويل جدّاً حتّى بدت آن طويلة القامة