1
00:00:02,600 --> 00:00:03,480
!أنت

2
00:00:04,460 --> 00:00:05,940
!استيقظ

3
00:00:09,840 --> 00:00:12,920
أأفقت أخيرًا أيها المدلل؟

4
00:00:14,250 --> 00:00:17,760
كان علينا إعدامه

5
00:00:17,770 --> 00:00:19,140
...اسمح لي

6
00:00:19,160 --> 00:00:20,220
توقف

7
00:00:20,230 --> 00:00:21,380
نـ-نعم

8
00:00:23,740 --> 00:00:27,820
أحسبت أنك ستهزمني بذلك الرون؟

9
00:00:29,960 --> 00:00:32,050
هيا، قاتلني

10
00:00:32,060 --> 00:00:34,000
ألا تخفي شيئًا آخر في جعبتك؟

11
00:00:35,650 --> 00:00:37,220
ما بك؟

12
00:00:37,340 --> 00:00:41,800
سنشن غارةً على ميوز بعد يومين عند بزوغ الشمس

13
00:00:42,020 --> 00:00:43,520
غارة؟

14
00:00:43,740 --> 00:00:47,520
سنذبح أصدقائك إذا لم تقتلني الآن

15
00:00:49,220 --> 00:00:50,200
ماذا أصنع؟

16
00:00:50,720 --> 00:00:52,100
ماذا أفعل؟

17
00:00:53,990 --> 00:00:55,270
مُضجِر

18
00:00:55,990 --> 00:00:57,260
...اسمح لي

19
00:00:57,810 --> 00:01:00,080
!بخدمتك

20
00:02:32,610 --> 00:02:34,300
تأخر جوي

21
00:02:34,820 --> 00:02:37,500
اطمئني، فسيعود

22
00:02:37,580 --> 00:02:38,320
نعم

23
00:02:38,720 --> 00:02:40,900
أتتذكر؟

24
00:02:40,910 --> 00:02:43,760
لمّا ضعت في الغابة

25
00:02:43,900 --> 00:02:47,400
طال انتظارنا كما يحدث الآن

26
00:02:47,770 --> 00:02:52,220
أتعلم ما حدث؟ ظلّ جوي يبكي

27
00:02:53,900 --> 00:02:56,050
أتصدقني؟

28
00:02:56,070 --> 00:02:58,960
إن جوي ذرف العبرات بلا هوادة

29
00:03:00,060 --> 00:03:05,140
كلّي يقين أن جوي يتذكر عودتك ذلك اليوم

30
00:03:05,150 --> 00:03:06,860
فجوي سيعود حتمًا

31
00:03:06,870 --> 00:03:07,890
نعم

32
00:03:08,820 --> 00:03:11,140
لا تخبره أني فضحته

33
00:03:11,300 --> 00:03:15,120
إذ وعدته بعدم إخبارك

34
00:03:17,940 --> 00:03:19,890
نامت بيليكا

35
00:03:20,310 --> 00:03:22,300
كانت تجاهد نفسها

36
00:03:22,770 --> 00:03:25,890
كنتُ أفكّر يا ريليو

37
00:03:26,690 --> 00:03:28,480
...إذا عاد جوي

38
00:03:28,490 --> 00:03:32,280
...لنهرب من هذه الحرب ثلاثتنا

39
00:03:32,290 --> 00:03:33,170
!انظري

40
00:03:39,300 --> 00:03:40,430
!جوي

41
00:03:45,890 --> 00:03:47,090
!جوي

42
00:03:47,100 --> 00:03:49,830
!طابت نفسي بعودتك

43
00:03:49,840 --> 00:03:51,490
!علمت أنك ستعود

44
00:03:51,500 --> 00:03:52,520
أهلًا بعودتك

45
00:03:53,370 --> 00:03:56,920
صنت العهد بيننا

46
00:03:58,160 --> 00:03:59,390
عدت

47
00:03:59,400 --> 00:04:02,550
هل انتظرتني يا بيليكا؟ شكرًا لكِ

48
00:04:04,090 --> 00:04:05,810
...من الجميل

49
00:04:06,350 --> 00:04:09,830
أن يكون للمرء من ينتظر عودته

50
00:04:11,710 --> 00:04:13,560
أهلًا بعودتك يا جوي

51
00:04:13,570 --> 00:04:16,570
بربك، ماذا كنت تفكر؟

52
00:04:16,580 --> 00:04:18,880
أعيانا القلق

53
00:04:19,050 --> 00:04:21,410
أعتذر من إقلاقكم

54
00:04:21,420 --> 00:04:25,700
تذكرت، قالت أنابيل إنها متفرغة غدًا فاذهبوا لها ليلًا

55
00:04:25,900 --> 00:04:27,530
صحيح

56
00:04:27,540 --> 00:04:30,680
نريد سماع بقية قصة جدي غينكاكو

57
00:04:30,690 --> 00:04:31,920
نعم

58
00:04:32,220 --> 00:04:35,920
لا بد أنكم متعبون فارتاحوا

59
00:04:36,140 --> 00:04:37,110
حاضر

60
00:04:40,090 --> 00:04:41,300
جوي؟

61
00:04:42,430 --> 00:04:44,510
أنا بخير

62
00:04:51,040 --> 00:04:52,510
ما ألطف كلبك

63
00:04:52,520 --> 00:04:55,640
أتحب الكلاب؟

64
00:04:55,650 --> 00:04:57,420
شكرًا لك

65
00:04:57,430 --> 00:05:00,380
كل محبين الكلاب صالحين

66
00:05:05,610 --> 00:05:07,410
عندي خطة

67
00:05:07,980 --> 00:05:10,000
اسمح لي العودة إلى ميوز

68
00:05:11,790 --> 00:05:14,380
سأثبت لك منفعتي لهايلاند

69
00:05:17,500 --> 00:05:18,670
حسنًا

70
00:05:19,070 --> 00:05:20,960
اذهب معه يا كاغي

71
00:05:21,460 --> 00:05:22,200
!حاضر

72
00:05:30,690 --> 00:05:33,360
إنه ذلك الرجل

73
00:05:35,430 --> 00:05:36,280
!جوي

74
00:05:36,980 --> 00:05:38,560
كنت هنا إذن

75
00:05:39,500 --> 00:05:40,520
...ريليو

76
00:05:41,520 --> 00:05:44,600
ستصل نيران الحرب إلى هذه المدينة

77
00:05:44,810 --> 00:05:48,790
خذ بيليكا مع نانامي وارحلا

78
00:05:49,170 --> 00:05:51,300
ما بكَ تتحدث هكذا؟

79
00:05:51,510 --> 00:05:54,290
أرجوك... غادرا المدينة

80
00:05:55,010 --> 00:05:57,460
ألن ترافقنا؟

81
00:05:57,470 --> 00:05:59,380
فقد وعَدْنا جدي

82
00:06:08,140 --> 00:06:10,020
ما الخطب يا جيل؟

83
00:06:10,570 --> 00:06:12,960
أتثق بذلك الفتى؟

84
00:06:13,660 --> 00:06:15,600
ألفت نظركِ؟

85
00:06:16,080 --> 00:06:20,240
أجدني فضوليةً قليلًا

86
00:06:23,900 --> 00:06:26,860
!ما أطيب طهي ليونا

87
00:06:26,870 --> 00:06:28,370
أسعدتني

88
00:06:28,380 --> 00:06:30,200
أتريدين المزيد يا بيليكا؟

89
00:06:33,890 --> 00:06:35,290
إليكِ المزيد

90
00:06:35,690 --> 00:06:38,220
كلوا حتى تشبعوا

91
00:06:38,510 --> 00:06:41,920
سأخرج لأنهي عملًا

92
00:06:42,340 --> 00:06:44,100
اهتمي بهم يا ليونا

93
00:06:44,420 --> 00:06:46,120
رافقتك السلامة

94
00:06:47,000 --> 00:06:49,160
شبعت

95
00:06:49,570 --> 00:06:51,560
ألن تأكل؟

96
00:06:51,620 --> 00:06:54,380
نعم، أنا متعب

97
00:06:54,680 --> 00:06:57,020
سأنام مبكرًا

98
00:06:57,420 --> 00:06:59,580
كُلي حتى ترضين

99
00:06:59,930 --> 00:07:02,390
واسمعي كلام نانامي

100
00:07:03,980 --> 00:07:06,480
أعهدكِ بيليكا

101
00:07:06,610 --> 00:07:09,830
ماذا؟ أكيد، لا تقلق عليها

102
00:07:09,840 --> 00:07:11,260
صح يا بيليكا؟

103
00:07:15,850 --> 00:07:19,520
أراه منهكًا فعلًا

104
00:07:21,210 --> 00:07:23,620
ولا شهية له

105
00:07:23,760 --> 00:07:26,860
ما يهم أن جوي عاد لنا سالمًا

106
00:07:26,940 --> 00:07:31,040
لا تنسى موعدنا مع أنابيل فسنذهب بعد نوم بيليكا

107
00:07:31,220 --> 00:07:32,000
نعم

108
00:07:32,800 --> 00:07:34,940
أهلًا، أما زلتِ تعملين؟

109
00:07:35,060 --> 00:07:37,380
انتهيت قبل هنيهة

110
00:07:37,390 --> 00:07:39,650
لنشرب معًا

111
00:07:40,810 --> 00:07:42,650
جلبت نبيذًا فريدًا

112
00:07:43,070 --> 00:07:45,360
من كاناكان في الجنوب

113
00:07:45,490 --> 00:07:48,160
حفظته لأجلكِ

114
00:07:48,500 --> 00:07:52,720
إنها القارورة الوحيدة التي أخذتها بعد احتراق حصني

115
00:07:55,170 --> 00:07:57,080
ما أذكى رائحته

116
00:07:58,660 --> 00:08:00,580
ومذاقه طيب

117
00:08:02,540 --> 00:08:03,400
!أنت

118
00:08:03,980 --> 00:08:06,010
!لا تحدق بي

119
00:08:06,330 --> 00:08:09,970
وكأنك تنظر عبري

120
00:08:10,410 --> 00:08:13,140
أعتذر، عادتي السيئة

121
00:08:13,510 --> 00:08:14,760
صحيح

122
00:08:15,220 --> 00:08:16,640
لا أقدر على مقارعتكِ

123
00:08:21,560 --> 00:08:23,150
أعتذر عن يوم أمس

124
00:08:24,370 --> 00:08:27,400
ذهب الطفلان إلى معقل العدو بسببنا

125
00:08:27,760 --> 00:08:30,980
هذا ذنب مرؤوسيكِ

126
00:08:32,000 --> 00:08:35,280
بيد أني مسؤولةٌ عنه

127
00:08:35,460 --> 00:08:38,700
لننسَ هموم العمل

128
00:08:39,000 --> 00:08:40,340
أعتذر

129
00:08:43,200 --> 00:08:48,840
...ينام أهل المدينة قريرةً أعينهم ولكن

130
00:08:49,110 --> 00:08:52,720
...إن خسرنا أمام لوكا بلايت في المعركة القادمة

131
00:08:52,890 --> 00:08:55,240
فسيموت كثيرٌ من الناس

132
00:08:55,820 --> 00:09:01,010
أفكر أحيانًا إن كان الاستسلام خيرٌ من القتال

133
00:09:01,020 --> 00:09:04,470
ويحكِ، فكلامكِ المتخاذل لا يليق بقائدة

134
00:09:04,480 --> 00:09:05,950
أعتذر

135
00:09:06,120 --> 00:09:09,980
ألوم نبيذك ومسامرتي لك

136
00:09:11,950 --> 00:09:15,900
لأصدقك القول، انسحبت تينتو من التحالف

137
00:09:16,080 --> 00:09:17,940
هذا خبرٌ جلل

138
00:09:18,160 --> 00:09:22,260
...فشلت في توحيد دويلة جوستون

139
00:09:22,640 --> 00:09:26,140
ونحن في أمسِّ الحاجة لبعضنا

140
00:09:26,330 --> 00:09:29,940
ها أنتِ تثرثرين عن العمل مجددًا

141
00:09:31,160 --> 00:09:34,170
أعتذر، عادتي السيئة

142
00:09:35,610 --> 00:09:36,900
صحيح

143
00:09:36,980 --> 00:09:41,350
غير أنكِ تتحدثين من حرصكِ على أهل ميوز والتحالف

144
00:09:41,810 --> 00:09:43,920
مع ذلك ارتاحي إن سنحت لكِ الفرصة

145
00:09:44,100 --> 00:09:46,780
فالإجهاد يصيب صاحبه بالوهن

146
00:09:48,430 --> 00:09:53,140
....ماذا لو وُلدت في عصرٍ ومنطقةٍ مختلفة

147
00:09:53,240 --> 00:09:56,370
...وكنتُ أقصر قامة

148
00:09:56,700 --> 00:10:01,620
لصرنا متحابين أو هذا ما أظنه

149
00:10:03,140 --> 00:10:05,830
لا أمانع ذلك

150
00:10:06,110 --> 00:10:10,340
عدا أن مكانتكِ أعلى

151
00:10:11,220 --> 00:10:13,620
ألم تنوي محادثة الأطفال الليلة؟

152
00:10:13,940 --> 00:10:14,970
نعم

153
00:10:15,250 --> 00:10:16,300
أراكِ لاحقًا

154
00:10:16,360 --> 00:10:18,180
نعم، أراك لاحقًا

155
00:10:31,540 --> 00:10:32,740
جوي؟

156
00:10:33,100 --> 00:10:34,760
لعلي أخطأت

157
00:10:38,220 --> 00:10:40,180
!سندخل يا جوي

158
00:10:41,060 --> 00:10:43,160
أين ذهب؟

159
00:10:43,580 --> 00:10:45,240
لم أجده في الخارج

160
00:10:45,500 --> 00:10:48,740
إذن من رأيته قبل هنيهةٍ كان جوي

161
00:10:48,860 --> 00:10:50,890
أرأيته؟

162
00:10:50,980 --> 00:10:52,540
في القاعة

163
00:10:52,660 --> 00:10:54,900
لم تكونا معه

164
00:10:54,960 --> 00:10:58,840
لعله سبقنا

165
00:11:02,700 --> 00:11:03,790
تفضلوا

166
00:11:04,670 --> 00:11:05,770
المعذرة

167
00:11:07,280 --> 00:11:10,300
أجئتَ لتسمع قصة السيد غينكاكو؟

168
00:11:13,310 --> 00:11:14,830
ما الخطب يا جوي؟

169
00:11:15,600 --> 00:11:18,800
جئتُ لأسلب حياتكِ

170
00:11:26,820 --> 00:11:29,360
لا يروق لي مزاحك أيها الطفل

171
00:11:32,340 --> 00:11:35,420
أو سأقتلكِ

172
00:11:35,780 --> 00:11:37,780
لا تقل لي إنك جاد

173
00:11:38,230 --> 00:11:40,930
!هجوم جيش هايلاند وشيك

174
00:11:41,270 --> 00:11:44,820
استسلمي إن أردتِ حماية شعبكِ

175
00:11:46,280 --> 00:11:48,900
لن تنتصر الدويلة على هايلاند أبدًا

176
00:11:49,210 --> 00:11:53,140
!أرجوكِ! لا تورطي شعبكِ بالحرب فأنتِ صاحبة القرار

177
00:11:53,150 --> 00:11:54,720
سنقاتل

178
00:11:54,730 --> 00:11:57,900
لهذه الأرض وشعبها تاريخًا وفخرًا يحملونه لأجيال

179
00:11:58,290 --> 00:12:02,150
سيُمرَّغ أنف شعبنا بالتراب إن خضعنا لهم

180
00:12:02,160 --> 00:12:04,120
أي تاريخٍ وفخر؟

181
00:12:04,480 --> 00:12:08,500
أما كان الضعفاء يتجرعون دومًا مرارة تلك المآسي؟

182
00:12:08,790 --> 00:12:12,680
توجد مفاهيم يجب حمايتها وإن سُفكت الدماء

183
00:12:12,690 --> 00:12:16,720
إذ يتخذ الناس القتال حتى آخر رمقٍ ويقدمون التضحيات لصونها

184
00:12:16,820 --> 00:12:19,550
ستقع مجزرة

185
00:12:20,020 --> 00:12:22,720
نعم، أنا مستعدةٌ للقتال

186
00:12:23,160 --> 00:12:26,430
ما دمتِ حيةً فستسفك دماء الأبرياء

187
00:12:27,310 --> 00:12:28,420
...ولهذا

188
00:12:29,160 --> 00:12:31,610
سأنهي الحرب بيدي

189
00:12:32,090 --> 00:12:35,100
لن تقتنع إن طلبت منك إنزال خنجرك

190
00:12:35,770 --> 00:12:37,690
جئنا لرؤية أنابيل

191
00:12:37,700 --> 00:12:39,350
أخبرتني العمدة عنكم

192
00:12:39,360 --> 00:12:41,360
سبقكما صديقكما إليها

193
00:12:42,360 --> 00:12:44,330
إذن جاء جوي إلى هنا

194
00:12:45,030 --> 00:12:49,080
أتسمح لي ارتشاف آخر ما تبقى من النبيذ؟

195
00:12:49,550 --> 00:12:52,000
إذ كان هديةً من صديقٍ عزيز

196
00:12:52,010 --> 00:12:53,840
فمن الإسراف ألا أكمله

197
00:12:54,770 --> 00:12:55,830
أعتذر

198
00:12:55,840 --> 00:12:56,840
أيها الغِرّ

199
00:12:59,960 --> 00:13:01,130
ما هذا الصوت؟

200
00:13:04,090 --> 00:13:05,580
!أنابيل

201
00:13:06,850 --> 00:13:08,470
أأنتِ بخير؟

202
00:13:09,560 --> 00:13:11,640
!لا! إنها تنزف

203
00:13:13,690 --> 00:13:14,760
!جوي

204
00:13:14,840 --> 00:13:16,140
ماذا حدث؟

205
00:13:16,220 --> 00:13:18,460
!أخبرنا بما حدث

206
00:13:18,750 --> 00:13:21,860
اغفرا لي، ولكن غادرا ميوز حالًا

207
00:13:21,980 --> 00:13:24,340
وعيشا بعيدًا عن الصراع

208
00:13:24,350 --> 00:13:25,300
!جوي

209
00:13:25,380 --> 00:13:26,620
!مـ-مهلًا

210
00:13:28,580 --> 00:13:30,500
لا تتحركي

211
00:13:30,730 --> 00:13:31,640
نانامي

212
00:13:31,650 --> 00:13:33,450
نزيفها حاد

213
00:13:33,460 --> 00:13:36,160
شنت هايلاند غارةً يا أنابيل

214
00:13:36,170 --> 00:13:38,090
مـ-ماذا حدث؟

215
00:13:38,130 --> 00:13:39,920
!نادي الطبيب -
!حاضر -

216
00:13:39,930 --> 00:13:41,570
ما الذي اقترفتماه؟

217
00:13:41,580 --> 00:13:43,130
...جيس -
نعم؟ -

218
00:13:43,510 --> 00:13:47,300
لم... يقترفا الجريمة

219
00:13:47,310 --> 00:13:49,090
مـ-مفهوم -
!جيس -

220
00:13:49,100 --> 00:13:50,390
ماذا تريد؟

221
00:13:50,400 --> 00:13:52,520
دخل جيش العدو المدينة

222
00:13:52,530 --> 00:13:53,430
ماذا؟

223
00:13:53,440 --> 00:13:55,380
كيف دخلوا بوقتٍ قصير؟

224
00:13:55,390 --> 00:13:58,320
شهد أحدهم أن البوابة الشرقية فُتحت من داخل المدينة

225
00:13:58,570 --> 00:14:00,660
أتقول إن بيننا خائن؟

226
00:14:00,670 --> 00:14:02,570
!نحتاج إلى أن تقودنا

227
00:14:02,580 --> 00:14:04,730
...لكني

228
00:14:04,740 --> 00:14:06,610
...جـ-جيس

229
00:14:06,620 --> 00:14:07,690
آنسة أنابيل؟

230
00:14:07,700 --> 00:14:10,870
...أرجوك... لا تقلق

231
00:14:10,880 --> 00:14:12,710
تستطيع... أن تقودهم

232
00:14:13,030 --> 00:14:14,480
فهمت

233
00:14:14,490 --> 00:14:17,020
سأستجوبكما لاحقًا

234
00:14:17,030 --> 00:14:18,830
حتى ذلك الوقت لا تتحركا

235
00:14:18,840 --> 00:14:20,210
!لنذهب

236
00:14:25,020 --> 00:14:25,710
!كاغي

237
00:14:25,720 --> 00:14:27,220
رأيت كل ما حدث

238
00:14:27,650 --> 00:14:29,830
قتلتها

239
00:14:32,730 --> 00:14:34,730
لمَ استعجلتم الهجوم؟

240
00:14:35,280 --> 00:14:36,990
هذه طبيعة الحرب

241
00:14:37,000 --> 00:14:39,680
أين لوكا؟ علي إبلاغه

242
00:14:39,860 --> 00:14:42,360
أنت غِرٌ فعلًا

243
00:14:45,330 --> 00:14:46,360
!أنابيل

244
00:14:48,030 --> 00:14:54,900
ر-ريليو... أخبرهم... أني لن أحتاج إلى طبيب

245
00:14:54,910 --> 00:14:55,800
...ولكن

246
00:14:56,020 --> 00:14:56,900
...ريليو

247
00:14:58,080 --> 00:14:59,280
...نانامي

248
00:15:00,700 --> 00:15:03,260
...يا أبناء غينكاكو

249
00:15:04,130 --> 00:15:10,380
ما زلت أدين لكما... باعتذار

250
00:15:11,590 --> 00:15:13,500
...لمَ اقترفته الدويلة

251
00:15:13,510 --> 00:15:18,310
وأبي... للسيد غينكاكو

252
00:15:18,620 --> 00:15:20,660
!لا تتحدثي

253
00:15:20,670 --> 00:15:21,780
...أكنتما

254
00:15:22,340 --> 00:15:26,520
سعيدان... مع غينكاكو؟

255
00:15:26,530 --> 00:15:27,470
نعم

256
00:15:27,480 --> 00:15:28,570
بالطبع

257
00:15:28,580 --> 00:15:29,910
...فهمت

258
00:15:30,550 --> 00:15:35,250
...اطمأن... قلبي

259
00:15:36,320 --> 00:15:39,920
فرّا... هربًا

260
00:15:40,150 --> 00:15:43,120
سيدخل جيش العدو القاعة قريبًا

261
00:15:44,100 --> 00:15:45,560
...اهربا

262
00:15:45,570 --> 00:15:47,300
...ولكن... ولكن

263
00:15:47,680 --> 00:15:50,960
...هذا طلبي الأخير

264
00:15:52,040 --> 00:15:56,110
!لا تموتا يا ريليو ونانامي

265
00:15:57,030 --> 00:15:58,530
!عيشا

266
00:16:01,120 --> 00:16:02,900
لنذهب

267
00:16:02,910 --> 00:16:03,780
نعم

268
00:16:04,160 --> 00:16:05,610
غادرا المكان

269
00:16:07,690 --> 00:16:14,100
لعله قُدِّر... لي لقاءكما

270
00:16:16,340 --> 00:16:20,420
ألا توافقني... يا فيكتور؟

271
00:16:34,280 --> 00:16:36,640
لمَ طعن جوي أنابيل؟

272
00:16:36,650 --> 00:16:37,730
لا أعلم

273
00:16:43,520 --> 00:16:45,320
!اردعوا فئرانهم من الدخول

274
00:16:45,330 --> 00:16:47,530
!نبأٌ مفجع يا فيكتور -
ما الأمر؟ -

275
00:16:48,080 --> 00:16:50,350
!طُعنت أنابيل وحالتها صعبة

276
00:16:50,480 --> 00:16:51,450
ماذا؟

277
00:16:51,460 --> 00:16:53,700
من يقود الجيش؟

278
00:16:53,970 --> 00:16:54,950
جيس

279
00:16:55,260 --> 00:16:58,220
سينهار سُلّم السلطة دون أنابيل

280
00:16:58,230 --> 00:17:00,960
الدفاع عن البوابة الرئيسية أولويتنا الآن

281
00:17:01,610 --> 00:17:02,460
!بيليكا

282
00:17:04,960 --> 00:17:07,580
أعلم أنكِ خائفة، اطمئني

283
00:17:07,710 --> 00:17:10,490
اذهبا إلى ليونا فمن الخطر بقائكم

284
00:17:10,500 --> 00:17:11,550
!نعم

285
00:17:13,470 --> 00:17:16,220
ألستِ قلقةً على جوي؟

286
00:17:17,940 --> 00:17:20,940
لن يأتي معنا الآن ولكننا سنلتقي به مجددًا

287
00:17:22,260 --> 00:17:23,220
!لنذهب

288
00:17:28,640 --> 00:17:31,300
سقطت القاعة يا فيكتور

289
00:17:31,510 --> 00:17:33,860
يتجه جيشهم نحونا

290
00:17:34,020 --> 00:17:36,200
يخططون للقضاء علينا من الجهتين

291
00:17:37,610 --> 00:17:38,950
جاؤوا

292
00:17:39,380 --> 00:17:42,460
!قاتل معي يا ريليو

293
00:17:42,710 --> 00:17:43,460
!نعم

294
00:17:49,750 --> 00:17:51,210
من أنت؟

295
00:17:51,220 --> 00:17:53,220
!أنا مستعجل! اسمح لي بالمرور

296
00:17:53,230 --> 00:17:54,650
اسمح له بالمرور

297
00:17:54,660 --> 00:17:55,470
!سمعًا وطاعة

298
00:17:56,840 --> 00:17:58,220
أبلغك تقريري

299
00:17:58,650 --> 00:18:01,600
!قتلت عمدة ميوز أنابيل

300
00:18:01,940 --> 00:18:02,850
ماذا؟

301
00:18:04,920 --> 00:18:06,860
ما صحة كلامه يا كاغي؟

302
00:18:08,060 --> 00:18:09,440
لم يكذب

303
00:18:12,520 --> 00:18:15,260
!أوقف المعركة رجاءً

304
00:18:15,390 --> 00:18:16,780
...استسلمت ميـ -
!أنت -

305
00:18:17,240 --> 00:18:19,040
!لا تأمرني

306
00:18:20,030 --> 00:18:23,380
غير أنك قتلت أنابيل

307
00:18:23,520 --> 00:18:26,040
إن أردت خدمتي فلك ذلك

308
00:18:32,270 --> 00:18:33,120
!تعسًا

309
00:18:33,260 --> 00:18:34,420
وضعنا مزري

310
00:18:44,660 --> 00:18:45,900
!حطموه

311
00:18:53,390 --> 00:18:55,400
!نستسلم

312
00:18:55,410 --> 00:18:57,150
!أوقفوا هجومكم

313
00:18:57,160 --> 00:18:58,660
!نستسلم

314
00:19:06,290 --> 00:19:08,290
!لا تكترثوا! تقدموا

315
00:19:08,650 --> 00:19:11,040
!اقتلوا كل جنديٍ من ميوز

316
00:19:11,300 --> 00:19:13,920
ألا ترون العلم الأبيض؟

317
00:19:14,050 --> 00:19:15,800
لا أراه

318
00:19:18,090 --> 00:19:20,700
!أيتها الوحوش المنحطة

319
00:19:21,840 --> 00:19:23,270
!سننسحب

320
00:19:23,630 --> 00:19:25,990
لم يقبلوا استسلامنا

321
00:19:27,140 --> 00:19:29,220
سنباد عن بكرة أبينا

322
00:19:29,340 --> 00:19:30,980
!اقتلوهم

323
00:19:34,730 --> 00:19:35,580
!ريليو

324
00:19:36,030 --> 00:19:36,900
!سننسحب

325
00:19:36,910 --> 00:19:38,020
!من هنا! بسرعة

326
00:19:38,030 --> 00:19:39,210
!حـ-حاضر

327
00:19:39,220 --> 00:19:39,960
!لنذهب

328
00:19:44,210 --> 00:19:45,350
...انسحاب

329
00:19:45,970 --> 00:19:49,180
أترتعد فرائصك يا ولد؟

330
00:19:49,260 --> 00:19:51,440
...سلّم نفسك يا ريليو بـ

331
00:19:51,450 --> 00:19:52,050
...أنا

332
00:19:53,010 --> 00:19:55,550
أريد حماية الجميع

333
00:20:00,420 --> 00:20:04,840
!لأحمينّهم

334
00:20:08,540 --> 00:20:10,500
!هذا الرون الأصيل

335
00:20:10,630 --> 00:20:11,770
منذ متى...؟

336
00:20:12,020 --> 00:20:14,530
لنغادر قبل بلوغ جيش لوكا المدينة

337
00:20:14,820 --> 00:20:17,320
حسنًا، سننسحب من ميوز

338
00:20:18,700 --> 00:20:20,140
أبلغك تقريري

339
00:20:20,270 --> 00:20:22,280
سيطرنا على القاعة وشوارعها

340
00:20:22,810 --> 00:20:24,920
استسلمت ميوز دون مقاومة

341
00:20:25,520 --> 00:20:26,410
حسنًا

342
00:20:26,970 --> 00:20:31,290
غير أن قواتنا في البوابة الرئيسية فقدو وعيهم

343
00:20:31,670 --> 00:20:34,300
فهرب المئات من جنود العدو

344
00:20:34,570 --> 00:20:35,800
ماذا حدث؟

345
00:20:36,170 --> 00:20:39,800
باغتهم هجومٌ من رون الدرع النيِّر

346
00:20:40,730 --> 00:20:41,800
أولئك الفئران

347
00:20:42,080 --> 00:20:44,430
...ريليو، أنت

348
00:20:56,010 --> 00:20:58,320
غطّت في النوم أخيرًا

349
00:20:58,490 --> 00:20:59,200
نعم

350
00:20:59,490 --> 00:21:00,700
...يا ريليو

351
00:21:01,190 --> 00:21:05,240
...بشأن أنابيل... أجوي

352
00:21:05,250 --> 00:21:08,220
لجوي أسبابه أكيد

353
00:21:08,910 --> 00:21:13,040
ألن نراه مرةً أخرى؟

354
00:21:13,500 --> 00:21:16,000
سنراه... حتمًا

355
00:21:17,710 --> 00:21:19,560
ألي محادثتك يا فيكتور؟

356
00:21:19,710 --> 00:21:20,740
ما الأمر؟

357
00:21:21,280 --> 00:21:25,440
سمعت أن أنابيل ماتت

358
00:21:26,630 --> 00:21:27,620
فهمت

359
00:21:30,330 --> 00:21:32,200
سأشتاق إليها

360
00:21:46,470 --> 00:21:48,760
لماذا ترتجف؟

361
00:21:48,940 --> 00:21:49,870
الأميرة جيليا

362
00:21:50,450 --> 00:21:53,840
لطالما رافقت ريليو

363
00:21:54,010 --> 00:21:55,880
لكننا افترقنا للمرة الأولى

364
00:21:56,340 --> 00:21:57,880
أنادم؟

365
00:21:58,140 --> 00:22:01,380
لا، عقدت عزمي

366
00:22:02,420 --> 00:22:04,640
فسأسلك الدرب الذي اخترته

367
00:22:06,140 --> 00:22:07,460
أستميحك عذرًا

368
00:22:13,810 --> 00:22:15,690
...لوكا بلايت

369
00:22:16,900 --> 00:22:19,270
...يومًا ما أقسم أني

370
00:23:52,530 --> 00:23:54,920
في الحلقة القادمة: الإستراتيجي شو