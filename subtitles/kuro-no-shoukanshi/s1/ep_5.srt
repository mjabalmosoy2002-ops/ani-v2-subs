1
00:00:02,230 --> 00:00:05,230
كنتُ أتساءل... ما هذه النّظرة في وجهك؟

2
00:00:05,230 --> 00:00:08,940
!لم ألتقِ عدوّاً بقوّتك من قبل

3
00:00:09,490 --> 00:00:11,980
أنا متحمّس جداً لدرجة لا أستطيع
!فيها التحكّم بنفسي

4
00:00:11,980 --> 00:00:14,060
مُبهِر

5
00:00:16,380 --> 00:00:19,830
دعني أريك شيئاً ستستمتع به إذاً

6
00:00:20,200 --> 00:00:22,510
جيش هاديس

7
00:00:25,820 --> 00:00:30,240
سحر أسود. كم هذا أنيق

8
00:00:31,480 --> 00:00:34,850
والآن لم تعُد أعدادكم أكبر

9
00:00:34,850 --> 00:00:37,950
!على الأقلّ، نحن الأقلّ عدداً الآن

10
00:00:38,550 --> 00:00:42,050
والآن لنرَ ما لديكم لتستعرضونه

11
00:02:20,110 --> 00:02:21,770
جميعهم بقوّة وحوش ذات رتبة ب

12
00:02:23,400 --> 00:02:25,680
!سأقضي عليهم قبل أن يقتربوا

13
00:02:25,680 --> 00:02:26,810
!طلقة الرّياح

14
00:02:33,810 --> 00:02:36,770
بكلّ هؤلاء الأعداء، قد نحطّم عظمة أو اثنتين

15
00:02:37,180 --> 00:02:38,890
!والجيّد أنّها ستكون عِظامهم

16
00:02:42,470 --> 00:02:45,090
!نكاته سيّئة لكن ضرباته قويّة

17
00:02:45,090 --> 00:02:46,710
لكن نكاته سيّئة

18
00:02:49,420 --> 00:02:52,130
!يا ملِكي، عليك بالّذين لا أتمكّن من إصابتهم

19
00:02:52,130 --> 00:02:53,250
!دع المر لي

20
00:02:55,260 --> 00:02:57,180
مُذهِل

21
00:02:57,180 --> 00:03:01,230
،جميعهم أقوياء، لكن ليس ذلك فحسب
يتحرّكون بانسجام مثاليّ

22
00:03:01,480 --> 00:03:07,700
أنت يافع جدّاً، لكنّك تقاتل كمُحارب
!يمتلك سنوات من الخبرة

23
00:03:10,740 --> 00:03:13,500
لا تبدو خائفاً جدّاً

24
00:03:13,500 --> 00:03:15,420
ما يعني بأنّك لديك المزيد لتُريني إيّاه

25
00:03:15,420 --> 00:03:18,580
هذا ما تتأمّله، صحيح؟

26
00:03:18,580 --> 00:03:20,390
،أنت بالعباءة السّوداء

27
00:03:20,390 --> 00:03:23,490
يبدو أنّك مهووس بالقتال

28
00:03:23,490 --> 00:03:27,170
كنتَ هكذا منذ بدء المعركة

29
00:03:27,170 --> 00:03:30,620
أجل. يمكنك القول بأنّه مرض

30
00:03:30,620 --> 00:03:32,880
!أنا مُستمتع كثيراً لدرجة لا أستطيع ضبط نفسي

31
00:03:32,880 --> 00:03:36,960
!دعني أمسح هذه الابتسامة عن وجهك إذاً

32
00:03:38,720 --> 00:03:40,260
استخدمَها كقنبلة دخانيّة؟

33
00:03:40,260 --> 00:03:41,530
اهدأ يا جيرارد

34
00:03:41,530 --> 00:03:43,120
أنا أتعقّبه

35
00:03:43,520 --> 00:03:46,520
!إنّه قادم من تحت الأرض لمُهاجمتنا

36
00:03:49,850 --> 00:03:51,500
شعرَ بي؟

37
00:03:51,830 --> 00:03:53,480
!لن تفلت منّي

38
00:03:54,330 --> 00:03:55,450
!ممتاز

39
00:04:08,710 --> 00:04:12,670
درعه متين ولديه مُقاومة ضرر
%الضربات الجارحة بنسبة 50

40
00:04:13,370 --> 00:04:15,370
جيرارد غير ملائم لمُواجهته

41
00:04:15,560 --> 00:04:19,580
التّالية أسرع بكثير من السّابقة

42
00:04:29,480 --> 00:04:30,120
!كلوتو

43
00:04:32,040 --> 00:04:33,790
هُلام؟

44
00:04:33,790 --> 00:04:37,530
يبدو أنّ الهجمات الجسديّة لن تنفع معك

45
00:04:37,530 --> 00:04:39,710
ما رأيك بامتصاص السّحر إذاً؟

46
00:04:41,250 --> 00:04:42,840
!حُلَّ عنّي

47
00:04:42,840 --> 00:04:44,200
!لا، لن تفعل

48
00:04:44,200 --> 00:04:46,360
!ملاذ المجد

49
00:04:49,700 --> 00:04:53,100
...لم أكن أدري بأنّك تمتلك مثل هذه القوّة

50
00:04:54,770 --> 00:04:56,780
أحسنتَ يا ملِكي

51
00:04:57,140 --> 00:04:59,560
لكن لن يُثبّته هذا لفترة طويلة

52
00:05:05,500 --> 00:05:07,060
!إنّه قويٌّ جدّاً

53
00:05:07,060 --> 00:05:07,830
!جيرارد

54
00:05:07,830 --> 00:05:09,270
...بإذنك

55
00:05:09,270 --> 00:05:11,110
!حافّة الدوّامة

56
00:05:16,820 --> 00:05:20,120
أنت لا تسترعي انتباهاً، أليس كذلك؟

57
00:05:22,710 --> 00:05:24,410
!ربِحت

58
00:05:24,820 --> 00:05:26,220
كلّا

59
00:05:26,220 --> 00:05:27,610
خسِرت

60
00:05:27,610 --> 00:05:28,390
!أيفيل

61
00:05:28,390 --> 00:05:29,280
!حاضرة

62
00:05:30,050 --> 00:05:33,720
تخفٍّ مُتقَن لدرجة لا أشعر به؟

63
00:05:33,720 --> 00:05:36,650
!اخترقه... أيُّها السّهم المُتّقد

64
00:05:43,950 --> 00:05:46,030
!لم ننتهِ بعد

65
00:05:52,940 --> 00:05:57,030
أحسنتُم صنعاً! لكن انتهت صلاحيّة ملاذ المجد

66
00:05:57,030 --> 00:05:58,420
!تراجعوا

67
00:06:05,350 --> 00:06:10,130
أنت ثاني شخص يُلحِق هذا الضّرر الكبير بي

68
00:06:10,130 --> 00:06:15,640
...يبدو أنّ السّلام في هذا العصر قد أضعفَ شوكتي

69
00:06:16,040 --> 00:06:18,280
أتستسلم إذاً؟

70
00:06:19,360 --> 00:06:22,040
من الآن؟

71
00:06:22,040 --> 00:06:25,450
أنت مُدمن على القتال. لا بدَّ أنّك تمزح

72
00:06:25,450 --> 00:06:28,270
فالمعركة لم تبدأ بعد

73
00:06:31,180 --> 00:06:34,570
!عِراك الجنّ

74
00:06:36,070 --> 00:06:37,100
!مولايّ

75
00:06:37,100 --> 00:06:39,380
أجل، لن ننتظره حتّى ينتهي من إطلاق هذا

76
00:06:39,650 --> 00:06:41,400
!تفجير الصّدع

77
00:06:42,750 --> 00:06:45,320
!بيروهيدرا الأوّليّة

78
00:06:48,240 --> 00:06:49,510
!أغيتو

79
00:06:51,670 --> 00:06:53,400
تأخّرنا قليلاً؟

80
00:06:53,670 --> 00:06:56,290
ما القوّة التي يستخدمها؟

81
00:06:59,050 --> 00:07:01,650
متأكّد؟ لن تدوم طويلاً

82
00:07:01,960 --> 00:07:03,970
!ستحتاجها للنجاة من ذلك الشيء

83
00:07:04,420 --> 00:07:08,070
حان الوقت للجولة الأخيرة إذاً

84
00:07:08,070 --> 00:07:10,480
!أجل. إليّ بكلّ ما عندك

85
00:07:10,790 --> 00:07:12,410
!بالتأكيد

86
00:07:12,410 --> 00:07:14,320
!جيرارد! الدّفاع الطارئ

87
00:07:15,250 --> 00:07:17,050
!السٌّور الأرضيّ

88
00:07:20,670 --> 00:07:24,620
جيرارد، إن لم تستطع التصدّي لهذه
الهجمة، فسينهار الفريق

89
00:07:24,620 --> 00:07:26,730
!ابذل كلّ ما لديك

90
00:07:26,730 --> 00:07:30,210
أنتِ مُحدِّدة مهام مُلِحّة يا أميرة

91
00:07:30,210 --> 00:07:33,450
!لكن مُحال لفارس حقيقيّ أن يخسر هنا

92
00:07:36,810 --> 00:07:39,990
!أنت أحمق

93
00:07:45,750 --> 00:07:48,720
!جيرارد، لا تستسلم

94
00:07:48,720 --> 00:07:50,580
!أنا معك

95
00:07:53,240 --> 00:07:54,370
هذا صحيح

96
00:07:54,370 --> 00:07:57,800
!ما زلنا... ما زلنا لم نبدأ بعد

97
00:08:00,150 --> 00:08:01,660
!ما زال يُهاجم

98
00:08:02,460 --> 00:08:04,060
!الثّانويّة

99
00:08:05,700 --> 00:08:08,240
أنتم لا تعرفون الاستسلام، صحيح؟

100
00:08:08,240 --> 00:08:10,880
!أجل، لأنّنا واثقون من الفوز

101
00:08:11,680 --> 00:08:14,380
ذلك الهُلام من جديد؟

102
00:08:14,690 --> 00:08:16,530
!اضربه يا كلوتو

103
00:08:21,600 --> 00:08:23,520
لماذا لديك العديد من الأسلحة الملعونة؟

104
00:08:23,910 --> 00:08:25,950
!إنّهم فاشلون عندما كنتُ أتدرّب على الحِدادة

105
00:08:25,950 --> 00:08:27,720
هذا نافع جدّاً، صحيح؟

106
00:08:28,020 --> 00:08:29,350
!هذا هو

107
00:08:29,350 --> 00:08:31,930
!الرّمح البرّاق

108
00:08:31,930 --> 00:08:33,820
!السّهم المُتّقِد

109
00:09:12,370 --> 00:09:16,150
ربحتُم

110
00:09:16,330 --> 00:09:18,590
أريد أن أطرح عليك سؤالاً

111
00:09:18,590 --> 00:09:20,160
ما هو؟

112
00:09:20,160 --> 00:09:25,530
لم تكن ستأكل ابنة ملك الشّيطان
فعلاً، أليس كذلك؟

113
00:09:26,300 --> 00:09:27,870
لمَ الكذب؟

114
00:09:28,200 --> 00:09:32,920
إذا لم أفعل، فما كنتَ لتُقاتلني بكامل قوّتك

115
00:09:32,920 --> 00:09:37,340
...وائتمنني غوستاف عليها

116
00:09:37,690 --> 00:09:46,520
قبل سنوات عديدة، تمّ تعييني لأكون راعيها

117
00:09:47,060 --> 00:09:52,070
الاسم: فيكتور
المستوى: 86
نقاط الصحّة: 1525/1525
نقاط السّحر: 883
العمر: 670   القوّة: 540
التحمُّل: 628
الجنس: ذكر    الرّشاقة: 378
السّحر: 396
الحظّ: 437

118
00:09:54,680 --> 00:09:57,300
لكماتك تخلو من السّحر

119
00:09:57,300 --> 00:09:59,650
وميكانيكيّة حركتكِ بطيئة للغاية

120
00:10:01,150 --> 00:10:05,790
لن تكوني مُلاكمة سرّية مُحترفة
إذا اعتمدتِ على مهاراتكِ فقط

121
00:10:06,630 --> 00:10:08,070
!مؤلم

122
00:10:08,800 --> 00:10:12,500
!لا أعلم ماذا يعني أن أكرّس سحري في لكماتي

123
00:10:13,490 --> 00:10:17,850
إذا تعلّمتِ ذلك فوراً، فماذا عليّ
أن أعلّمكِ حينها؟

124
00:10:17,850 --> 00:10:19,900
لنستغرق وقتنا في التّدريب

125
00:10:19,900 --> 00:10:23,120
نحن الشّياطين نعيش عمراً مديداً

126
00:10:23,120 --> 00:10:24,730
عمراً مديداً؟

127
00:10:26,210 --> 00:10:30,650
هل سأقضي طوال حياتي في هذا القصر؟

128
00:10:30,650 --> 00:10:33,810
،يأتي أبي لرؤيتي يوميّاً

129
00:10:33,810 --> 00:10:37,480
لكن عندما يغادر للعمل، لا يعود إلّا بعد مدّة

130
00:10:37,480 --> 00:10:39,120
...الأميرة سيرا

131
00:10:39,850 --> 00:10:47,250
أبقى غوستاف ابنته مخفيّة كي
لا يستخدمها أعداؤه ضدّه

132
00:10:49,650 --> 00:10:53,570
حالما تنتهين من الأكل، سنعود إلى النّزال

133
00:10:53,570 --> 00:10:54,630
!حسناً

134
00:10:57,380 --> 00:11:01,710
لم يكن لديها أصدقاء. لم تغادر المنزل أبداً

135
00:11:01,710 --> 00:11:06,090
كان هذا القصر كلّ ما تعرفه

136
00:11:06,090 --> 00:11:12,250
وفي ذلك اليوم، هاجمَ البطلُ ووصلَ إلى غوستاف أخيراً

137
00:11:12,250 --> 00:11:15,240
كانت جيوش العدوّ هائلة وشارفت القلعة على السّقوط

138
00:11:15,240 --> 00:11:20,170
لكن آمنتُ بأنّ القتال والموت لأجل سيّدي

139
00:11:20,170 --> 00:11:22,730
سيكون أفضل موت أحظى به

140
00:11:22,730 --> 00:11:32,990
لكن سيّدي، غوستاف، أمرَني بالاستمرار
في العناية بسيرا

141
00:11:32,990 --> 00:11:36,080
،فلو أصبحَ وجودها معلوماً

142
00:11:36,080 --> 00:11:40,200
،فليس البطل من سيستهدفها حينها فحسب
بل الشّياطين الآخرون كذلك

143
00:11:40,200 --> 00:11:45,980
لذا وضع الملك الشّيطان ختماً عليها
لا يستطيع كسره سوى البشر

144
00:11:45,980 --> 00:11:50,310
مُقارنة بالشّياطين والوحوش، البشر ضُعفاء

145
00:11:50,310 --> 00:11:56,920
فإذا وجدَها شخصٌ غير البطل، ستكون بأمان

146
00:11:56,920 --> 00:12:01,370
،عندما مات، تفعّلَ السّحر الّذي أطلقَه

147
00:12:01,370 --> 00:12:05,940
،وأُرسِلَت الأميرة سيرا إلى أرض بعيدة

148
00:12:05,940 --> 00:12:10,990
وذلك كي تعيش بسعادة في العصر
المُسالم الّذي سيأتي يوماً ما

149
00:12:11,210 --> 00:12:15,460
!مولايّ، هذه... أنانيّة شديدة

150
00:12:15,460 --> 00:12:18,490
هل تعتقد بأنّ ذلك سيُسعدها؟

151
00:12:20,240 --> 00:12:25,830
لهذا هي هنا، في هذا المكان الخفيّ

152
00:12:25,830 --> 00:12:29,610
انتظرتُ وانتظرت، اليوم الّذي
يموت فيه البطل

153
00:12:29,610 --> 00:12:34,900
وكانت الحرب لتصبح عبارة عن ذكرى بعيدة

154
00:12:35,130 --> 00:12:37,810
عصر من السّلام والوهن

155
00:12:37,810 --> 00:12:41,510
عصر حيث تستطيع الأميرة سيرا
!أن تحكم بصفة الملك الشّيطان الجديد

156
00:12:47,110 --> 00:12:51,940
لكن... فشلت خطّتي

157
00:12:53,730 --> 00:12:56,660
لديّ طلب أخير

158
00:12:56,660 --> 00:13:00,970
هلّا ضممتها لفريقك؟

159
00:13:01,870 --> 00:13:03,260
لمَ هذا الطلب فجأة؟

160
00:13:04,060 --> 00:13:08,490
أنت قويّ وموثوق بواسطة أصدقائك

161
00:13:08,490 --> 00:13:10,100
...حتّى الوحوش

162
00:13:11,760 --> 00:13:14,100
...أنت مُستدعٍ

163
00:13:14,980 --> 00:13:16,590
لاحظت؟

164
00:13:17,580 --> 00:13:24,290
لعلَّ الأميرة سيرا قد ضَعُفَت بسبب نومها العميق

165
00:13:24,290 --> 00:13:27,810
اكسر الختم وستُفتَح عيناها

166
00:13:27,810 --> 00:13:30,610
إنّها تسمع ما نقوله الآن

167
00:13:32,210 --> 00:13:33,840
إنّه يقول الحقيقة

168
00:13:33,840 --> 00:13:36,760
هل تريد أن تكون خادمي أيضاً؟

169
00:13:37,210 --> 00:13:39,300
إن كان كذلك، سأُعالجك

170
00:13:40,300 --> 00:13:43,120
،عرض جذّاب

171
00:13:43,120 --> 00:13:46,280
لكن لا أخدم سوى الملك الشّيطان

172
00:13:46,280 --> 00:13:50,010
وقد فات الأوان على أيّ حال

173
00:13:51,970 --> 00:14:01,070
!أرجوك... أرِ الأميرة سيرا العالم

174
00:14:08,320 --> 00:14:12,500
!مولايّ، من الممكن أن تصبح هي الملك الشّيطان

175
00:14:14,680 --> 00:14:17,200
...أحدثتُ فوضى هنا

176
00:14:34,180 --> 00:14:37,510
حسناً إذاً، هل يمكنكِ سماعي؟

177
00:14:39,980 --> 00:14:45,090
!أبي... فيكتور... جميعهم أغبياء

178
00:14:50,860 --> 00:14:56,090
فيكتور... سألبّي طلبك

179
00:15:05,490 --> 00:15:06,570
!كيلفن

180
00:15:07,590 --> 00:15:08,750
!أورد

181
00:15:08,750 --> 00:15:10,220
هل سارت الأمور على ما يُرام؟

182
00:15:10,220 --> 00:15:13,380
أجل. قضينا على الشّيطان، لكن كان ذلك وشيكاً

183
00:15:13,380 --> 00:15:14,230
أيفيل

184
00:15:17,660 --> 00:15:18,940
...هذا

185
00:15:18,940 --> 00:15:20,400
هذا هو الدّليل

186
00:15:20,870 --> 00:15:23,730
دعهم يُعايونه في النّقابة، وسيخبرونك

187
00:15:23,730 --> 00:15:26,460
فهمت. يسرّني أنّكم بخير

188
00:15:26,460 --> 00:15:27,560
من هذه؟

189
00:15:28,690 --> 00:15:33,360
يبدو أنّ الشّيطان كان يستحوذ
عليها عندما تمّ ختمها

190
00:15:33,360 --> 00:15:36,810
كانت غالباً ما رآه فريق المُغامرين الأوّل

191
00:15:37,740 --> 00:15:39,440
ربطة شعر التّمويه

192
00:15:39,790 --> 00:15:43,080
...يمنعهم هذا من رؤية قرنيها وجناحيها الشّيطانيّين

193
00:15:43,080 --> 00:15:46,450
لعلّ غوستاف أعدَّه لأجلك

194
00:15:46,450 --> 00:15:48,730
من باب الحُبِّ لابنته؟

195
00:15:49,330 --> 00:15:53,080
يبدو أنّها خائرة القوى، لذا سوف أعيدها

196
00:15:53,360 --> 00:15:54,510
...هل يمكنكم

197
00:15:54,740 --> 00:15:57,310
أجل، سنتولّى الأمور هنا

198
00:16:01,480 --> 00:16:04,680
ويبدو فارسك مُنهك جدّاً أيضاً

199
00:16:06,610 --> 00:16:08,170
...أجل، ربّما

200
00:16:18,930 --> 00:16:20,830
أشعر بتحسّن كبير

201
00:16:20,830 --> 00:16:23,460
أعتقد أنّ شيئاً ما كاد يتسرّب

202
00:16:23,460 --> 00:16:27,250
أهذا أوّل كلام تقوله بعد أن
طوّرتُك واستدعيتُك من جديد؟

203
00:16:27,250 --> 00:16:28,980
ماذا تتأمّل مني؟

204
00:16:28,980 --> 00:16:32,010
ارتفع مستوايّ وكنتُ على وشك التطوُّر

205
00:16:32,290 --> 00:16:35,350
بدا كلوتو غريباً قبل التطوّر أيضاً

206
00:16:36,070 --> 00:16:37,730
قائد فارس غَوريّ

207
00:16:37,730 --> 00:16:41,730
شكل نادر من الفارس الغَوريّ، وحش لا يظهر
إلّا في ديماس برتبة أس

208
00:16:41,720 --> 00:16:46,730
الاسم: جيرارد
المستوى: 80  اللّقب: حارس وطنيّ
نقاط الصحّة: 2130/2130
نقاط السّحر: 411/411
العمر: 138   القوّة: 1044
العِرق: قائد فارس الشّبح الأسود  التحمُّل: 1109
الجنس: ذكر   الرّشاقة: 373
الفئة: قائد الفارس الغَوريّ   السّحر: 277
الحظّ: 290

209
00:16:41,730 --> 00:16:44,100
!وانظر إلى هذه الإحصائيّات

210
00:16:44,100 --> 00:16:46,230
!هذا مُدهش جدّاً

211
00:16:46,230 --> 00:16:51,650
!تمّ إصلاح ترسه المكسور... لا، أظنّه أقوى حتّى

212
00:16:52,760 --> 00:16:55,730
!هذه مُكافأتي لتطبيقي مُثُل الفروسيّة

213
00:16:55,730 --> 00:16:59,180
كنتَ ترتجف كما لو أنّك على وشك
!أن تتبوّل على نفسك قبل لحظات

214
00:16:59,180 --> 00:17:00,170
ماذا؟

215
00:17:06,010 --> 00:17:08,840
يبدو أنّك هدئتِ أخيراً يا سيرا

216
00:17:08,840 --> 00:17:10,070
أجل

217
00:17:10,070 --> 00:17:15,560
لكن هل أنت متأكّد بأنّك تريد ابنة
الملك الشّيطان غوستاف كخادمة؟

218
00:17:15,560 --> 00:17:19,290
أعلم بأنّني لا ينبغي أن أخبرك بهذا، لكن
!إذا علِموا بالأمر، ستكون في ورطة

219
00:17:19,290 --> 00:17:22,300
!لديّ إخفاء برتبة أس

220
00:17:22,300 --> 00:17:25,560
لذا ليس عليكِ القلق بشأن شخص يستخدم
عين التّقييم كي يرى حالتكِ

221
00:17:25,560 --> 00:17:28,480
كان من المُذهل بما يكفي أن تهزم فيكتور

222
00:17:28,480 --> 00:17:30,250
من أنت؟

223
00:17:30,250 --> 00:17:32,100
لستَ البطل، صحيح؟

224
00:17:32,400 --> 00:17:34,260
البطل هو شيء آخر على ما أعتقد

225
00:17:34,660 --> 00:17:38,420
أنا مجرّد مُغامر يحبّ القتال قليلاً

226
00:17:38,420 --> 00:17:39,800
قليلاً"؟"

227
00:17:39,800 --> 00:17:41,360
لماذا جميعكم قلتُم هذا في آن واحد؟

228
00:17:43,230 --> 00:17:44,790
أنت غريب حقّاً

229
00:17:46,020 --> 00:17:47,500
هل أنتِ جاهزة للانطلاق؟

230
00:17:47,500 --> 00:17:51,340
لم أزُر بلدة من قبل

231
00:17:51,340 --> 00:17:54,300
لم أغادر القصر في حياتي

232
00:17:54,850 --> 00:17:56,330
هل أنتِ متوتّرة؟

233
00:17:56,740 --> 00:17:57,850
قليلاً

234
00:17:57,850 --> 00:18:01,130
لا تقلقي. جميعهم أُناس طيّبون

235
00:18:01,130 --> 00:18:02,920
أجل. ستعتادين عليهم سريعاً

236
00:18:04,210 --> 00:18:06,540
حسناً. سأفعل ما بوسعي

237
00:18:08,760 --> 00:18:10,330
هذه بارث

238
00:18:10,330 --> 00:18:12,310
البلدة التي نعيش فيها

239
00:18:13,770 --> 00:18:15,330
ما هذا؟

240
00:18:15,330 --> 00:18:17,060
!بائع فاكهة

241
00:18:17,060 --> 00:18:19,370
!لديهم مُختلَف أنوع الفواكه هنا

242
00:18:19,370 --> 00:18:20,920
ماذا عن هذا؟

243
00:18:20,920 --> 00:18:22,270
متجر أسلحة

244
00:18:22,270 --> 00:18:26,660
لديهم مُختلف الأنواع، من الأسلحة
العاديّة إلى عصيّ السّحر

245
00:18:26,660 --> 00:18:28,790
ماذا عن هذا إذاً؟

246
00:18:29,440 --> 00:18:32,300
احرصي على ألّا تصطدمي بأحد

247
00:18:32,810 --> 00:18:34,360
كنتُ قلقاً عن عبث

248
00:18:34,360 --> 00:18:35,530
هذا ما أعتقده

249
00:18:38,460 --> 00:18:39,920
أنتِ مُستمتعة، صحيح؟

250
00:18:39,920 --> 00:18:42,550
!هذه أوّل مرّة أخرج فيها

251
00:18:42,550 --> 00:18:44,810
!من الطبيعي أن يكون هذا مُمتعاً

252
00:18:45,060 --> 00:18:48,580
!لم أرَ أيّاً من هذه الأشياء من قبل

253
00:18:48,580 --> 00:18:51,630
!"الكثير من الثّافة والتجارة مُحتواة في هذه "البلدة

254
00:18:51,630 --> 00:18:53,450
...هذا مُبهِر جدّاً

255
00:18:54,330 --> 00:18:55,680
ما هذا؟

256
00:18:56,500 --> 00:18:59,270
أوّل مرّة لها في عالم جديد؟

257
00:19:01,800 --> 00:19:05,390
أيفيل، أعيدي سيرا إلى النُّزُل

258
00:19:05,830 --> 00:19:07,920
سأذهب إلى النّقابة لأسلّم تقريري

259
00:19:07,920 --> 00:19:10,770
حسناً. دعها لي

260
00:19:10,770 --> 00:19:12,720
!كيلفن! أيفيل

261
00:19:12,720 --> 00:19:15,410
!أريد الذّهاب لإلقاء نظرة هناك! بسرعة! بسرعة

262
00:19:15,410 --> 00:19:17,100
!حسناً يا سيرا

263
00:19:20,080 --> 00:19:21,960
لا تُعامليني كطفلة

264
00:19:21,960 --> 00:19:24,170
!أنا أكبر منكِ

265
00:19:27,750 --> 00:19:31,340
بعد هذه المهمّة، ترقّيتُ إلى الرّتبة أ

266
00:19:31,770 --> 00:19:36,140
قيل لي بأنّ الشّيطان الّذي عثرنا عليه
،قد كُشِفَ بأنّه برتبة أ أو أعلى

267
00:19:36,550 --> 00:19:39,790
لكانوا قد استخدموه كاختبار للامتحان الترويجيّ

268
00:19:42,050 --> 00:19:42,990
...عُدت

269
00:19:42,990 --> 00:19:45,410
!وصلَ نجمُنا

270
00:19:45,940 --> 00:19:47,500
!أهلاً بعودتك يا كيلفن

271
00:19:47,500 --> 00:19:48,940
...تهانينا

272
00:19:48,940 --> 00:19:51,200
!الترقّي إلى الرّتبة أ...

273
00:19:51,470 --> 00:19:55,340
سمِعت آنجي بترقّيي إلى الرّتبة أ

274
00:19:55,340 --> 00:19:58,710
وأقامت حفلةً لي في نُزُل أغنية الرُّوح

275
00:19:59,100 --> 00:20:03,790
يبدو أنَّ سيرا لم تعرف كيف تتصرّف بعد
رؤية كلّ هؤلاء دُفعة واحدة

276
00:20:04,090 --> 00:20:08,510
بدت أيفيل وكلير في مُنافسة غريبة بينهما

277
00:20:08,750 --> 00:20:12,010
!وعلمتُ أيضاً بأنّ كلير وأورد مُتزوّجان

278
00:20:12,340 --> 00:20:15,990
وكان النّاس مُرتابين جدّاً بشأن علاقتي
مع سيرا، الفتاة الجديدة

279
00:20:16,530 --> 00:20:22,060
استمتعتُ كثيراً بكلّ هذا الجنون
...لدرجة أنّ الوقت مضى سريعاً

280
00:20:36,050 --> 00:20:37,100
سيرا؟

281
00:20:42,190 --> 00:20:44,000
...فيكتور

282
00:20:44,400 --> 00:20:48,880
العالم الخارجيّ صاخب وضوضائيّ
حقّاً، أليس كذلك؟

283
00:20:49,410 --> 00:20:51,310
لكن... أجل

284
00:20:51,860 --> 00:20:56,030
إنّه أمتع بكثير ممّا توقّعت. كلّ شيء جديد

285
00:20:58,860 --> 00:21:00,320
!إنّها كبيرة

286
00:21:01,120 --> 00:21:04,240
توجد بركة كبيرة هنا

287
00:21:04,240 --> 00:21:06,790
سأطلب من المُزارعين إصلاح ذلك

288
00:21:07,150 --> 00:21:10,920
الشيء الّذي يطلقون عليه "بحر" أكبر بكثير، صحيح؟

289
00:21:10,920 --> 00:21:12,170
!قرأتُ ذلك في كتاب

290
00:21:12,170 --> 00:21:13,880
هذا صحيح

291
00:21:13,880 --> 00:21:17,540
إنّه ماء على مدّ النّظر

292
00:21:17,540 --> 00:21:21,760
!مذهل! أتساءل ما إن كنتُ سأراه يوماً ما

293
00:21:21,760 --> 00:21:23,450
!سترينه بالطبع

294
00:21:23,450 --> 00:21:29,100
!وعندما تفعلين، أنا، فيكتور، سأعلّمكِ كيفيّة السّباحة

295
00:21:30,130 --> 00:21:32,110
!هذا وعدٌ يا فيكتور

296
00:21:33,300 --> 00:21:35,420
سيرا، ماذا تفعلين؟

297
00:21:35,630 --> 00:21:37,760
هكذا نستمتع في البحر، أليس كذلك؟

298
00:21:37,760 --> 00:21:39,550
!شاركني أيضاً يا فيكتور

299
00:21:39,550 --> 00:21:41,980
!ا-انتظري يا سيرا

300
00:21:42,330 --> 00:21:44,210
...توقّفي

301
00:21:44,210 --> 00:21:46,490
...ملابسكِ تتبلّل

302
00:21:47,610 --> 00:21:50,440
هذا صحيح... أريد الذّهاب لرؤية البحر أيضاً

303
00:21:51,080 --> 00:21:54,490
...الجبال وبلدات وقارّات أخرى

304
00:21:55,200 --> 00:21:59,950
سأعيش أفضل حياة يمكنني عيشها
في العالم الّذي منحتني إيّاه أنت وأبي

305
00:22:02,260 --> 00:22:03,720
!لذا راقبني