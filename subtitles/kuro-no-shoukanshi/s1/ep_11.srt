180
00:12:45,120 --> 00:12:46,770
لا تتوقّف. استمرّ

181
00:12:49,770 --> 00:12:54,030
يا قائد، يبدو أنّ جبناء غاون لا وجود لهم

182
00:12:54,940 --> 00:12:58,580
غالباً ذُعِروا من جيش الوحوش
الشّياطين المختلط

183
00:12:59,150 --> 00:13:02,250
نحن نسبّب كثيراً من الضّوضاء

184
00:13:02,250 --> 00:13:04,590
...أنا متأكّد بأنّهم لاحظوا، لكن

185
00:13:05,330 --> 00:13:10,200
!إنّهم جبناء! احذروا من كمائن

186
00:13:11,820 --> 00:13:17,280
نمنح كثيراً من المعلومات لغاون، ثمّ
نقضي على مَن يرسلونه إلينا

187
00:13:17,630 --> 00:13:22,540
!خطّة القائد تريستان جاهزة لأهمّ مرحلة لها

188
00:13:22,730 --> 00:13:27,760
لكن لماذا برأيك يمتلك القائد
تريستان تلك الياقة؟

189
00:13:27,760 --> 00:13:31,950
يُقال بأنّها نوع خاصّ يؤثّر حتّى
على الرُّتَب أس حسبما يقولون

190
00:13:31,950 --> 00:13:36,960
تفيد الإشاعات بأنّه حصل عليها من تاجر
كان يزور القلعة مؤخّراً

191
00:13:37,200 --> 00:13:41,200
بهذا النّوع من القوّة الناريّة، حتّى ملك
...الوحوش ورجاله بأنفسهم لم يتمكّنوا

192
00:13:42,740 --> 00:13:43,710
ماذا حدث؟

193
00:13:43,710 --> 00:13:47,330
!لا أعلم! لقد... سقط أرضاً

194
00:13:48,710 --> 00:13:50,080
ما الّذي يجري؟

195
00:13:50,710 --> 00:13:52,510
!أصيبَ بشيء أشبه بسهم

196
00:13:52,510 --> 00:13:56,510
!هذا مستحيل! لم أسمع شيئاً إطلاقاً

197
00:13:56,510 --> 00:13:59,650
!وقرية الإيلف بعيدة كثيراً

198
00:13:59,650 --> 00:14:01,810
—لكنّه أصيبَ بشيء للتو

199
00:14:02,630 --> 00:14:04,480
!هجوم من العدوّ! هجوم من العدوّ

200
00:14:07,490 --> 00:14:10,100
!احتموا بالوحش

201
00:14:10,100 --> 00:14:12,570
!يستخدمون هجوماً خفيّاً ما

202
00:14:13,400 --> 00:14:15,110
!مستحيل

203
00:14:15,440 --> 00:14:18,120
!ما الّذي يجري هنا؟

204
00:14:18,950 --> 00:14:22,390
التّالي، أطلقي على مَن يختبئ
خلف كائن الترول

205
00:14:22,390 --> 00:14:26,140
أجل، اتركي الّذي يبدو أنّه برتبة
أعلى لوقت لاحق

206
00:14:26,470 --> 00:14:28,410
سنقبض عليه ونستجوبه

207
00:14:28,410 --> 00:14:29,830
!عُلِم

208
00:14:33,080 --> 00:14:34,510
جيّد، إصابة

209
00:14:34,870 --> 00:14:36,650
يبدو أنّ القوس ينجح على ما يُرام

210
00:14:36,650 --> 00:14:41,690
أجل. قوس الظلّ عديم الرّحمة
هذا الّذي صنعته لي

211
00:14:41,690 --> 00:14:44,490
يستطيع بلوغ أيّ مسافة ما دمتُ
أنقعه بالسّحر

212
00:14:45,010 --> 00:14:46,890
!إنّها لا تُصدر صوتاً أيضاً

213
00:14:47,430 --> 00:14:51,570
"شيّدتُ هذا البرج بمهارة "السّور الّذي لا ينكسر

214
00:14:52,110 --> 00:15:00,310
وتعويذة السّحر الأزرق الخاصّة بـ ميل، الضّباب
المُزيّف تجعله خفيّاً خارج جدران قرية الإيلف

215
00:15:00,980 --> 00:15:03,910
جعلتُ تلك الجدران أقوى بكثير أيضاً

216
00:15:04,520 --> 00:15:08,760
والماء في الخنادق المائيّة مُعزّز الآن
بسحر سيرا الأسود

217
00:15:09,200 --> 00:15:14,080
حتّى لو اقترب العدوّ، لن يتمكّن من الدّخول

218
00:15:15,510 --> 00:15:19,580
سأبقى في خطّ الدّفاع هذه المرّة، صحيح؟

219
00:15:19,580 --> 00:15:21,690
استمتعوا جميعاً

220
00:15:21,690 --> 00:15:22,990
!عُلِم

221
00:15:22,990 --> 00:15:25,950
لن يكون عليك فعل شيء، لذا خذ قيلولة

222
00:15:25,950 --> 00:15:28,120
سيرا، لا تكوني قاسية كثيراً، اتّفقنا؟

223
00:15:28,120 --> 00:15:30,500
!أجل! أختي ميل على حقّ

224
00:15:31,090 --> 00:15:33,620
سوف نأسر الشّخص الّذي يبدو مُهمّاً، صحيح؟

225
00:15:33,620 --> 00:15:35,160
إذا استطعنا

226
00:15:35,630 --> 00:15:38,750
هدفنا الرّئيسي هو حماية القرية

227
00:15:38,750 --> 00:15:41,610
لا تفعلوا أيّ شيء يسبّب كثيراً
من الأضرار للغابة أيضاً

228
00:15:42,930 --> 00:15:44,960
!حسناً، فلنبدأ

229
00:15:50,140 --> 00:15:51,920
!نائب القائد

230
00:15:52,250 --> 00:15:54,050
!مُصيبة

231
00:15:54,960 --> 00:15:57,420
اهدأا! ماذا حدث؟

232
00:15:57,420 --> 00:16:01,130
وصلنا تقريباً لقرية الإيلف عندما
!هوجِمنا بواسطة عدوّ مجهول

233
00:16:01,130 --> 00:16:06,160
!أبيدت الوحدة 4 وأُسِر قائد الكتيبة

234
00:16:06,160 --> 00:16:08,180
!إنّهم ليسوا جنود غاون

235
00:16:08,180 --> 00:16:13,540
ماذا؟! إن لم يكونوا غاون، فمن أين
هم إذاً؟ توراج؟ ديراميس؟

236
00:16:14,070 --> 00:16:17,330
إنّهم ليسوا جنوداً. يبدو أنّهم فريق مُغامِر

237
00:16:17,330 --> 00:16:18,620
!ماذا؟

238
00:16:19,020 --> 00:16:20,710
،لا نعلم من يكونوا

239
00:16:20,710 --> 00:16:24,540
!لكن تأكّدنا من وجود ثلاث نساء وذئب ظلّ واحد

240
00:16:24,730 --> 00:16:28,660
إنّهم أقوياء جدّاً ولا يستطيع
!وحوش الرّتبة ب إيقافهم

241
00:16:29,060 --> 00:16:31,290
!لا يمكننا متابعة التقدّم

242
00:16:31,290 --> 00:16:32,620
ماذا؟

243
00:16:32,840 --> 00:16:38,600
تشتبك الوحدة 5 معهم الآن، لكن لن يمضي
!وقت طويل حتّى يصلوا إلى معسكرنا

244
00:16:41,630 --> 00:16:43,950
سنضطرّ لاستخدام سلاحنا السرّي إذاً

245
00:16:44,480 --> 00:16:47,190
سيكون تكتيكنا الرّئيسي الّذي
نستخدمه لهزيمة العدوّ

246
00:16:47,190 --> 00:16:49,430
هل تسمعونني؟

247
00:16:50,120 --> 00:16:51,730
!نائب القائد

248
00:16:52,620 --> 00:16:55,190
!ها هو ذا

249
00:16:55,420 --> 00:16:58,420
هذا قائد العدوّ، أليس كذلك يا أختي ميل؟

250
00:16:58,420 --> 00:17:00,950
شكراً على إرشادنا إلى هنا

251
00:17:00,950 --> 00:17:04,090
بفضلك، لم نتُه

252
00:17:04,090 --> 00:17:06,010
...هل يُعقَل أنّهم

253
00:17:07,130 --> 00:17:08,260
!أنت

254
00:17:09,750 --> 00:17:12,340
!استيقظ يا غيغانت لورد

255
00:17:12,340 --> 00:17:14,420
!نحتاجك

256
00:17:25,240 --> 00:17:27,820
!لا تهمل دفاعك ولو للحظة

257
00:17:28,600 --> 00:17:31,930
!انظري! هذا العملاق الهائل

258
00:17:31,930 --> 00:17:33,140
!وكأنّه قادم من مانغا

259
00:17:35,040 --> 00:17:39,490
ريون، اهزميه أنتِ وأليكس

260
00:17:40,800 --> 00:17:42,170
نحن الاثنان فقط؟

261
00:17:42,450 --> 00:17:48,210
أجل. إذا استطعتِ فعلها، فهذا يعني
أنّكِ مُغامرة مُتكاملة

262
00:17:48,460 --> 00:17:51,570
غالباً هو مكافئ لوحش برتبة أس

263
00:17:51,960 --> 00:17:53,450
هل يمكنك معالجة أمره؟

264
00:18:01,780 --> 00:18:05,140
كان جدّي جيرارد وأخي كيل يعلّمانني
مهارات المبارزة بالسّيف

265
00:18:05,140 --> 00:18:08,460
والسّحر من الغسق إلى الفجر يوميّاً

266
00:18:08,940 --> 00:18:10,240
!يمكنني فعلها

267
00:18:10,240 --> 00:18:14,100
لا يمكن أن أكون الأخت الصّغرى
!الّتي يحميها الجميع للأبد

268
00:18:14,100 --> 00:18:16,730
!أريد حماية الجميع بنفسي

269
00:18:16,730 --> 00:18:18,940
يمكننا فعلها، أليس كذلك يا أليكس؟

270
00:18:22,260 --> 00:18:23,220
!حسناً

271
00:18:25,290 --> 00:18:26,770
ستكونين بخير

272
00:18:26,770 --> 00:18:30,680
،إذا استطعتِ استخدام قوّتكِ الكاملة
فأنا متأكّدة بأنّكِ ستكونين بخير

273
00:18:30,990 --> 00:18:32,940
!ذهبتْ بمفردها

274
00:18:32,940 --> 00:18:34,460
!يستخفّون بنا

275
00:18:34,460 --> 00:18:35,710
!غيغانت لورد

276
00:18:41,600 --> 00:18:43,590
!هيّا بنا يا أليكس

277
00:18:50,930 --> 00:18:55,640
!هذا السّيف عديم الجدوى لا يستطيع أذيّة رتبة أس

278
00:18:57,340 --> 00:18:58,610
...إذاً

279
00:19:04,460 --> 00:19:05,620
!تستحقّين هذا

280
00:19:05,620 --> 00:19:06,750
!اقضِ عليها

281
00:19:11,170 --> 00:19:13,510
...هذا سيّئ

282
00:19:13,510 --> 00:19:15,930
!إذا أصابَني بضربة مباشرة، فأنا في عداد الموتى

283
00:19:16,390 --> 00:19:17,400
...لكن

284
00:19:18,130 --> 00:19:23,130
أجل. إذا استطعتِ فعلها، فهذا يعني
أنّكِ مُغامرة مُتكاملة

285
00:19:25,900 --> 00:19:29,270
!كلوتو، ساندني من الخلف! أنت أيضاً يا أليكس

286
00:19:30,730 --> 00:19:34,360
!حان وقت الجدّية يا سيّد عملاق

287
00:19:35,770 --> 00:19:40,110
!مبارزة بسلاحين؟ وحده البطل من يستطيع فعلها

288
00:19:40,110 --> 00:19:44,340
حقّاً؟ كانت من ضمن قائمة مهاراتي
!لذا، لم أكن أعلم

289
00:19:48,660 --> 00:19:53,720
صنع لي أخي كيل سيف السّحر كالادبولغ
والسّيف المُقدّس المُزيّف ويل

290
00:19:53,720 --> 00:19:56,660
!وبالنسبة لأليكس، السّيف الهائج الفتّاك

291
00:19:57,070 --> 00:19:59,240
لا نستخدم سيفين

292
00:19:59,500 --> 00:20:01,730
!ذئب وفتاة، سوية نستخدم ثلاثة

293
00:20:02,210 --> 00:20:04,180
!حافّة التّوليد الكهربائي

294
00:20:06,780 --> 00:20:09,210
!مستحيل

295
00:20:09,520 --> 00:20:11,720
طفلة قتلت عملاقنا؟

296
00:20:11,720 --> 00:20:12,950
!فعلناها

297
00:20:12,950 --> 00:20:14,870
!غيغانت لورد

298
00:20:14,870 --> 00:20:16,890
!تحوّل الآن

299
00:20:24,770 --> 00:20:28,860
هذا شكله الحقيقيّ إذاً

300
00:20:28,860 --> 00:20:32,700
!محظوظة. أريد مقاتلته أيضاً

301
00:20:33,060 --> 00:20:34,900
...مولايّ

302
00:20:34,900 --> 00:20:37,240
ستكون ريون بخير

303
00:20:38,040 --> 00:20:39,010
أجل

304
00:20:39,630 --> 00:20:42,830
!هيّا، فرن غيغانت

305
00:20:42,830 --> 00:20:47,430
!احرقها بالنّيران التطهيريّة

306
00:20:49,390 --> 00:20:52,370
حسناً، هذا لا يغيّر من الحقيقة شيئاً

307
00:20:52,370 --> 00:20:53,150
...والسّبب

308
00:20:58,130 --> 00:21:01,870
!تبدو تلك النّيران أضعف بكثير من نيران أختي أيفيل

309
00:21:01,870 --> 00:21:04,240
!ها نحن ذا، مرّة أخرى

310
00:21:04,810 --> 00:21:06,950
!حافّة التّوليد الكهربائي

311
00:21:13,970 --> 00:21:18,650
...طفلة واحدة أبادت جيش الوحوش الشّياطين المختلط

312
00:21:19,130 --> 00:21:22,870
أبادت جيش ترايسن؟

313
00:21:26,210 --> 00:21:28,870
!أختي ميل، فعلتُها

314
00:21:30,040 --> 00:21:31,520
!أحسنتِ صنعاً

315
00:21:31,520 --> 00:21:33,230
أبليتِ بلاء حسناً

316
00:21:34,620 --> 00:21:37,230
سيكون أخي بيل سعيداً أيضاً، صحيح؟

317
00:21:37,600 --> 00:21:41,010
فازت ريون، أليس كذلك؟

318
00:21:41,010 --> 00:21:45,290
أجل، أصبحت قويّة خلال فترة قصيرة

319
00:21:45,460 --> 00:21:45,980
!أيفيل

320
00:21:51,380 --> 00:21:55,420
ماذا؟ ظننتُ بأنّني نلتُ منكم

321
00:21:55,770 --> 00:21:57,800
لكن لم تموتوا، أليس كذلك؟

322
00:22:01,750 --> 00:22:03,100
...مولايّ

323
00:22:05,110 --> 00:22:06,920
...إنّه

324
00:22:08,890 --> 00:22:10,130
!قويّ