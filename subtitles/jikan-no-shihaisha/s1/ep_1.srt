.تراجعي يا كويوكي-سان

189
00:14:25,540 --> 00:14:26,220
!كويوكي-سان

190
00:14:27,180 --> 00:14:28,300
!لا توقفني

191
00:14:28,460 --> 00:14:31,260
!أنتما لا تفهمان معاناتي

192
00:14:31,260 --> 00:14:33,850
!لأنّ كلاكما أنتما الأخوان حيّان

193
00:14:34,170 --> 00:14:36,900
،إن كان سيُرجع أخي إلى الحياة

194
00:14:36,900 --> 00:14:39,600
فلا يهمّني ما إن كان هذا
!الشيء شيطانًا أو أيّ شيءٍ آخر

195
00:14:40,730 --> 00:14:41,700
ألم أخبرك؟

196
00:14:42,330 --> 00:14:45,010
.لا تُمحى رغبات البشر بسهولة

197
00:14:48,060 --> 00:14:49,360
...أعده

198
00:14:49,610 --> 00:14:54,410
!أعد زمني لي

199
00:14:55,870 --> 00:14:57,160
معلّمة إيميلي؟

200
00:14:58,580 --> 00:15:00,210
!لا! ابتعدي عنه

201
00:15:02,200 --> 00:15:04,710
...زمن

202
00:15:19,520 --> 00:15:21,250
.هذه حقيقة الأسطورة

203
00:15:21,670 --> 00:15:23,770
.هذه الأشياء شياطين تدعى شياطين الزمن

204
00:15:24,120 --> 00:15:28,110
تظهر لتحقيق أماني الأشخاص
،الذين يريدون العودة إلى الماضي

205
00:15:28,540 --> 00:15:32,270
ولكن في الحقيقة، إنّها
.تأكل زمن البشر فحسب

206
00:15:32,870 --> 00:15:34,790
،عندما يُعضّ إنسان من قِبل شياطين الزمن

207
00:15:34,790 --> 00:15:37,380
.فإنّ زمنهم يستنزف، ويعودون إلى العدم

208
00:15:37,380 --> 00:15:40,830
.هذا ما يعنيه إبرام صفقة معهم

209
00:15:47,370 --> 00:15:47,880
!فيكتو

210
00:15:48,300 --> 00:15:50,600
!قسَم الزمن، تفعيل

211
00:16:00,680 --> 00:16:01,190
!تمهّل

212
00:16:17,470 --> 00:16:19,870
.توقّف الوقت

213
00:16:19,870 --> 00:16:22,840
.لا، لأكون دقيقًا، لم أوقفه

214
00:16:24,110 --> 00:16:25,930
فيكتو يستخدم الأوراق فحسب

215
00:16:25,930 --> 00:16:29,390
لتخفيف سرعة عبور شيء خلال
.الوقت إلى أبطأ سرعة ممكنة

216
00:16:30,110 --> 00:16:32,050
ماذا تكونان؟

217
00:16:32,260 --> 00:16:36,050
،نتحكّم بالزمن باستخدام هذه، قسَم الزمن

218
00:16:36,340 --> 00:16:40,060
لمقاتلة شياطين الزمن، الشياطين
.التي تتغذّى على زمن البشر

219
00:16:44,170 --> 00:16:45,610
.نحن حكّام كرونوس

220
00:16:46,870 --> 00:16:49,190
حكّام كرونوس؟

221
00:16:50,000 --> 00:16:53,970
ولكن كلّ ما يمكننا التحكّم
.به حقًّا هو سرعة الزمن

222
00:16:54,340 --> 00:16:57,750
لا يمكننا معرفة المستقبل
.أو العودة إلى الماضي

223
00:16:57,750 --> 00:16:58,990
.استسلمي بشأن أخيك

224
00:16:59,370 --> 00:17:01,750
!لا يمكنني الاستسلام

225
00:17:01,750 --> 00:17:04,120
!كان عائلتي الوحيدة، وفقدته

226
00:17:04,120 --> 00:17:07,230
—هل لديكما فكرة عن شعوري؟! لا يمكن

227
00:17:07,230 --> 00:17:07,920
.نعم

228
00:17:10,170 --> 00:17:12,550
.ترك فيكتو والدتنا تموت

229
00:17:13,390 --> 00:17:16,320
.بندمه، تمنّى أن يغيّر الماضي

230
00:17:16,320 --> 00:17:18,870
.استجلب ندمه شيطانًا زمنيًّا إلينا

231
00:17:19,640 --> 00:17:21,170
.انظري جيّدًا

232
00:17:21,870 --> 00:17:24,230
.هذا ما تبدو عليه الخسارة الحقيقيّة

233
00:17:26,390 --> 00:17:30,230
يوقف قسَم الزمن مجرى فيكتو
.الخاص بالزمن من داخله

234
00:17:31,160 --> 00:17:32,690
.كانت تلك الطريقة الوحيدة

235
00:17:33,350 --> 00:17:35,650
أن يتم عضّك من قِبل شيطان زمن

236
00:17:36,290 --> 00:17:38,480
.لا يعني جعلك أصغر سنًّا فحسب

237
00:17:38,480 --> 00:17:39,950
.بل تختفي ذكرياتك أيضًا

238
00:17:40,410 --> 00:17:43,120
.هنالك الكثير ممّا لم يعد بإمكاني تذكّره

239
00:17:44,070 --> 00:17:45,230
...لا

240
00:17:49,060 --> 00:17:51,380
!قسَم الزمن، تفعيل

241
00:17:57,510 --> 00:18:00,070
كيري، أنت احمِ كويوكي

242
00:18:00,070 --> 00:18:01,570
!بسيف المراهقة الخيالي خاصّتك

243
00:18:01,570 --> 00:18:03,220
!لا تدعوه بأسماءٍ غريبة

244
00:18:06,930 --> 00:18:08,010
!تمهّل

245
00:18:13,030 --> 00:18:13,820
!تمهّل

246
00:18:31,110 --> 00:18:31,840
!فيكتو-كن

247
00:18:33,930 --> 00:18:35,880
.أنت أقوى ممّا توقّعت

248
00:18:41,270 --> 00:18:42,720
!رائعٌ هكذا

249
00:18:42,720 --> 00:18:44,010
لماذا؟

250
00:18:44,010 --> 00:18:45,470
.إنّه مجروح بشدّة

251
00:18:46,110 --> 00:18:48,330
،قد نتمكن من التحكّم بالزمن

252
00:18:48,330 --> 00:18:51,440
ولكن ما حدث في الماضي
.لا يمكن أن يتغيّر

253
00:18:51,840 --> 00:18:54,930
المهم هو مدى اهتمامكما ببعضكما

254
00:18:54,930 --> 00:18:59,320
وتقوية الرابط بينكما خلال
.الوقت الذي قضيتماه معًا

255
00:19:01,270 --> 00:19:02,410
...والآن

256
00:19:02,880 --> 00:19:04,930
إنّ الهرب يخلو من أي براعة

257
00:19:06,260 --> 00:19:08,370
.حان الوقت لأردّ الهجوم

258
00:19:08,590 --> 00:19:09,670
!توقّف يا فيكتو

259
00:19:09,670 --> 00:19:12,790
.تمهّل يا كيري. عملك هو حماية كويوكي

260
00:19:12,990 --> 00:19:14,510
.دع هذا لي

261
00:19:14,990 --> 00:19:18,740
.في النهاية، وعدت أمّي بأن أحميك

262
00:19:19,100 --> 00:19:20,630
.ذلك مكتوب في يوميّاتي

263
00:19:20,630 --> 00:19:22,220
!لا! توقّف

264
00:19:22,700 --> 00:19:24,720
ما الذي يجري؟

265
00:19:25,090 --> 00:19:26,660
،عندما يستخدم التسريع

266
00:19:26,660 --> 00:19:29,260
.فمجرى زمن فيكتو من داخله يتسارع

267
00:19:29,640 --> 00:19:30,730
...هذا يعني

268
00:19:31,290 --> 00:19:36,190
إنّه على وشك أن يتنازل
.عن زمنه مقابل سلامتنا

269
00:19:37,060 --> 00:19:39,760
،اعتقدت أنّه إذا فقدت ذكرياتي

270
00:19:40,360 --> 00:19:43,870
فإنّ شعور الألم في قلبي
.سيتوقّف تدريجيًّا أيضًا

271
00:19:45,100 --> 00:19:46,300
.ولكن لا تقلق

272
00:19:46,770 --> 00:19:48,040
.ما زال مؤلمًا جدًّا

273
00:19:50,540 --> 00:19:54,530
بالمقابل، سأدعك تختبر
،ما هو شعور كونك حيًّا

274
00:19:54,950 --> 00:19:57,170
!ببطاقة يمكنها أن تطلق بسرعة ماخ 10

275
00:19:57,420 --> 00:19:58,670
...فيكتو-كن

276
00:20:05,820 --> 00:20:06,430
!تسريع

277
00:20:13,400 --> 00:20:15,110
!طلقة أيس

278
00:20:39,270 --> 00:20:40,550
أين أنا؟

279
00:20:40,790 --> 00:20:41,740
!فيكتو

280
00:20:42,770 --> 00:20:43,650
هاه؟

281
00:20:44,110 --> 00:20:45,840
ما الذي حدث؟

282
00:20:46,010 --> 00:20:46,850
.هذا أنا، كيري

283
00:20:47,380 --> 00:20:49,090
هل تعرفني يا فيكتو؟

284
00:20:49,480 --> 00:20:50,280
كيري؟

285
00:20:54,110 --> 00:20:56,020
.خذ، كل هذه المعكرونة من خلال أنفك

286
00:20:56,020 --> 00:20:57,230
!أهذا ما تبدأ به؟

287
00:20:57,410 --> 00:21:00,660
.هاه؟ المعكرونة يابسة

288
00:20:59,640 --> 00:21:03,290
.الحمد لله، لم يفقد الكثير من الزمن

289
00:21:00,660 --> 00:21:03,450
أكل هذه من خلال أنفك
.سيسبّب لك نزيفًا بالأنف

290
00:21:05,020 --> 00:21:07,870
في الواقع، هل أكلت المعكرونة
من خلال أنفك مسبقًا؟

291
00:21:08,050 --> 00:21:10,490
...هاه؟ ذلك

292
00:21:10,490 --> 00:21:12,370
!نـ-نعم، أكلتها

293
00:21:12,570 --> 00:21:14,620
ماذا، حقًّا؟ هل أنت جاد؟

294
00:21:14,620 --> 00:21:17,500
!نعم، أنا جاد! ولم تكن مطبوخة بشكلٍ تام

295
00:21:20,680 --> 00:21:22,510
.أعتقد أنّك أسقطتِ هذه

296
00:21:24,090 --> 00:21:25,770
.انظري لخلف الصورة

297
00:21:25,770 --> 00:21:26,720
الخلف؟

298
00:21:33,550 --> 00:21:34,890
...دائمًا

299
00:21:36,720 --> 00:21:39,400
.سأكون في جانبك يا كويوكي

300
00:21:55,820 --> 00:21:57,180
...أخي

301
00:21:59,030 --> 00:22:03,260
،كويوكي، لم يعد أخوك في هذا العالم

302
00:22:03,260 --> 00:22:06,680
ولكنّك لم تفقدي ذكريات الوقت
الذي قضيتِه معه، أليس كذلك؟

303
00:22:07,470 --> 00:22:10,160
.هذا بحدّ ذاته كنزٌ لا يقدّر بثمن

304
00:22:13,430 --> 00:22:14,280
.نعم

305
00:22:52,720 --> 00:22:54,220
...بالتفكير بالأمر

306
00:22:54,780 --> 00:22:57,100
ما هو عمر فيكتو-كن الحقيقي؟

307
00:22:57,590 --> 00:23:00,450
،إنه يصغر يومًا بمرور كلّ يوم

308
00:23:00,450 --> 00:23:02,110
.وتضيع ذكرياته بالوقت نفسه

309
00:23:02,410 --> 00:23:06,360
إذًا هل يعني ذلك أنّ
فيكتو هو الأخ الأكبر في الحقيقة؟

310
00:23:09,610 --> 00:23:13,180
.فيكتو بوتين. العمر الحقيقي: 39

311
00:23:13,180 --> 00:23:17,410
.والدي