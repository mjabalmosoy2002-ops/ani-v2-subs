1
00:00:14,850 --> 00:00:20,620
لم تريدي أن يسمعني ابنك
وأنا أقول المزيد، أليس كذلك؟

2
00:00:21,130 --> 00:00:24,750
،إن استمررت بالتفوّه بالتفاهات

3
00:00:24,750 --> 00:00:29,090
.فسأُغلق فمك إلى الأبد

4
00:00:37,200 --> 00:00:40,120
.هذا مخيف

5
00:00:40,120 --> 00:00:42,930
أتحاولين قتلي حقًّا؟

6
00:00:49,930 --> 00:00:53,440
!لا بأس، فأنا أيضًا كذلك

7
00:00:57,490 --> 00:00:59,240
...عيني اليسرى

8
00:00:59,690 --> 00:01:02,200
.كان فيكتو من أصابها

9
00:01:02,910 --> 00:01:05,210
.أنا واهن في نهاية المطاف

10
00:01:05,550 --> 00:01:10,060
منذ ذلك الحين، لم أفكّر
.بسوى كيف آخذ بانتقامي

11
00:01:10,060 --> 00:01:10,960
...وبعدها، في أحد الأيّام

12
00:01:11,930 --> 00:01:15,230
!أتيت بفكرة رائعة

13
00:02:46,500 --> 00:02:49,680
!أتيت بفكرة رائعة

14
00:02:51,700 --> 00:02:54,440
!كلّ ما كان عليّ فعله هو قتل زوجته

15
00:02:56,080 --> 00:02:57,280
!هذا سهل

16
00:02:58,780 --> 00:03:00,350
.أنت سريع ولكن هذا كلّ ما لديك

17
00:03:00,350 --> 00:03:01,990
!ليس لديك تقنيات

18
00:03:03,490 --> 00:03:04,480
ماذا؟

19
00:03:04,480 --> 00:03:05,240
!تسريع

20
00:03:17,330 --> 00:03:20,050
.انتهت لعبتنا الصغيرة

21
00:03:20,050 --> 00:03:23,140
فليأكلك شيطان الزمن ذاك
.الذي لم تعد تستطيع التحكم به

22
00:03:23,140 --> 00:03:26,360
...انتهى أمري

23
00:03:27,060 --> 00:03:29,140
!أمزح

24
00:03:31,630 --> 00:03:32,480
!لماذا؟

25
00:03:32,930 --> 00:03:35,270
.لماذا؟ بالله عليك

26
00:03:35,530 --> 00:03:40,030
.لم أعلم أنّك ساذجة إلى تلك الدرجة

27
00:03:40,360 --> 00:03:45,200
هل اعتقدت حقًّا أنّي سأرتدي الخاتم
الحقيقي حيث يمكن رؤيته بسهولة؟

28
00:03:45,450 --> 00:03:48,160
!إنّه مخبّأ بالطبع

29
00:03:51,890 --> 00:03:53,670
.لا بأس إذًا

30
00:03:53,670 --> 00:03:56,250
.عليّ هزيمة شيطان الزمن ذاته فحسب

31
00:03:56,250 --> 00:03:59,210
!سأجهز عليك بعدها

32
00:04:10,080 --> 00:04:13,110
...لا يمكنني... الحراك

33
00:04:13,740 --> 00:04:16,810
.بدأ مفعوله أخيرًا

34
00:04:21,170 --> 00:04:23,240
ليس لديّ تقنيات، صحيح؟

35
00:04:23,670 --> 00:04:28,200
تقولين هذا لأنّك لا تعرفين كيف
.يجب أن يُستخدم شيطان الزمن

36
00:04:28,480 --> 00:04:31,410
كيف يجب... أن يُستخدم؟

37
00:04:31,410 --> 00:04:33,980
.غذاء شياطين الزمن الأساسي هو الوقت

38
00:04:33,980 --> 00:04:38,210
،الوقت يتضمّن الذكريات
.الخبرات، والتقنيات

39
00:04:38,450 --> 00:04:43,510
،عندما يلتهم شيطان الزمن الوقت
.فإنّه يكسب تلك الأشياء أيضًا

40
00:04:44,110 --> 00:04:46,510
.واسم هذا هو فودوكو

41
00:04:47,730 --> 00:04:53,580
نبات البيش، العقارب، الضفادع
...الرتيلاء، الكوبرا

42
00:04:53,580 --> 00:04:56,520
.أكل كلّ أنواع الكائنات السامّة

43
00:04:57,180 --> 00:04:59,190
تفهمين الباقي، صحيح؟

44
00:05:00,120 --> 00:05:02,530
،عندما حميتِ ابنك الحبيب

45
00:05:02,530 --> 00:05:05,780
.اقتحمت السموم العصبيّة جسدك

46
00:05:06,860 --> 00:05:09,180
.لكن لا تقلقي

47
00:05:09,180 --> 00:05:12,390
تأثير ذلك السم يبقى لساعة
.أو ساعتين على الأكثر فقط

48
00:05:12,970 --> 00:05:18,710
ولكن هنالك أشياء أودّ اختبارها
.عليك في الوقت الراهن

49
00:05:20,130 --> 00:05:21,920
من أين نبدأ؟

50
00:05:24,160 --> 00:05:27,890
!أنا متحكّم كرونوس السادس، بليز

51
00:05:28,390 --> 00:05:31,390
،عجوز مثلك ليس ندًّا لي

52
00:05:31,620 --> 00:05:33,350
.ولكن لا بدّ وأنّ هذا القدر

53
00:05:33,590 --> 00:05:34,930
!تسريع

54
00:05:47,640 --> 00:05:49,240
.لا يمكن

55
00:05:49,640 --> 00:05:52,870
عجوز مثلك أوقف هجمتي؟

56
00:05:53,250 --> 00:05:54,410
كيف؟

57
00:05:55,760 --> 00:05:58,090
شيطان زمن؟ قسَم زمن؟

58
00:05:58,090 --> 00:06:00,630
!يستحيل أنّك فعلت ذلك بنفسك

59
00:06:00,630 --> 00:06:05,630
وجودي حتّى آخر قطرة من
.دمائي ينتمي لسموّه

60
00:06:06,830 --> 00:06:10,260
"جميعكم تتحدثون عن "سموّه
من يكون ذلك؟

61
00:06:10,460 --> 00:06:14,010
،أعطاني سموّه جسدًا جديدًا

62
00:06:14,010 --> 00:06:17,480
.ومنه اكتسبت حياةً جديدة

63
00:06:17,810 --> 00:06:18,850
حياة؟

64
00:06:19,150 --> 00:06:21,660
...بالتالي أوامر سموّه

65
00:06:23,620 --> 00:06:27,360
!حتميّة حتّى وإن كلفتني حياتي

66
00:06:29,560 --> 00:06:32,370
!مـ-ما هذا؟

67
00:06:32,670 --> 00:06:35,350
اندمجتَ مع شيطان زمن؟

68
00:06:35,350 --> 00:06:38,040
!أيّ مريض نفسيٍّ أنت؟

69
00:06:38,040 --> 00:06:39,920
،عندما كنت يافعًا

70
00:06:40,750 --> 00:06:45,260
،تسبّب مرض بضمور عضلاتي
.وتخلّى والداي عنّي

71
00:07:01,280 --> 00:07:04,780
.كان سموّه من احتضنني

72
00:07:07,020 --> 00:07:09,920
،بزراعة شيطان زمن في لحمي

73
00:07:09,920 --> 00:07:12,240
.نلتُ جسدًا جديدًا

74
00:07:12,620 --> 00:07:17,750
...سموّه هو أبٌ وإله لي، ولهذا

75
00:07:17,970 --> 00:07:22,700
!لن أدع أحدًا يقف في طريق سموّه

76
00:07:28,830 --> 00:07:33,180
.يا لها من قصّة رائعة
.عانيتَ حقًّا أيّها العجوز

77
00:07:33,180 --> 00:07:36,450
.ولا بدّ أنّ "سموّه" هذا شخصٌ رائع أيضًا

78
00:07:37,110 --> 00:07:40,020
أتفهم حنان سموّه؟

79
00:07:40,330 --> 00:07:41,990
!بالطبع

80
00:07:41,990 --> 00:07:45,770
ولكن أيّها العجوز، هنالك
!شخصٌ مهم لي أيضًا

81
00:07:45,770 --> 00:07:47,650
...ولحماية أخي الصغير كيري

82
00:07:47,650 --> 00:07:50,780
!سأهزمك باسم الشر

83
00:07:51,070 --> 00:07:53,490
!قوّة عزيمتك جديرة بالاحترام

84
00:07:53,490 --> 00:07:55,780
!سأواجهك أيّها الشاب

85
00:07:59,510 --> 00:08:03,970
منحني سموّه رشاقة شيطان
،زمن من نوع القرد

86
00:08:03,970 --> 00:08:06,250
.بالإضافة إلى قوّة عظيمة

87
00:08:07,720 --> 00:08:08,920
قرد، هاه؟

88
00:08:09,610 --> 00:08:13,030
.إن كنتَ قردًا، فأنا تجسّد تنين

89
00:08:13,440 --> 00:08:14,680
أتعرف ما معنى هذا؟

90
00:08:14,930 --> 00:08:18,170
!أنا أقوى منك بكثير

91
00:08:18,810 --> 00:08:23,390
!مجرّد نوري لا يمكنه التحليق مع النسور

92
00:08:35,410 --> 00:08:36,660
.ما هذا أيّها العجوز

93
00:08:37,220 --> 00:08:39,160
.إنّك أقوى بكثير ممّا توقعت

94
00:08:39,900 --> 00:08:45,750
لا أمانع الآن بأن أريك
!القوّة الحقيقيّة للكمتي

95
00:09:02,640 --> 00:09:06,430
حصافة فنوني القتاليّة، وقوّة
شيطان الزمن منقطعة النظير

96
00:09:06,430 --> 00:09:11,070
اجتمعي فيّ لإكمال
!القوّة القتاليّة القصوى

97
00:09:20,080 --> 00:09:20,950
...والآن

98
00:09:21,920 --> 00:09:26,210
هذا لديه سم يقتل بواسطة
،جعل كلّ الدم في جسدك ينزف

99
00:09:26,210 --> 00:09:32,210
وهذا لديه سم يقتل بالصدمة
.الناتجة عن خيال الألم

100
00:09:32,210 --> 00:09:33,960
...وهذا

101
00:09:34,450 --> 00:09:39,300
لديه سم أكثر لطفًا والذي
.يضعك في بلاد الأحلام إلى الأبد

102
00:09:39,750 --> 00:09:42,810
،أيًّا من السموم الثلاثة تريدين

103
00:09:43,340 --> 00:09:45,210
يا آنسة؟

104
00:09:45,210 --> 00:09:47,480
.أعتقد أنّك تعني أربعة سموم

105
00:09:47,480 --> 00:09:51,570
لم تذكر التي أعضّك فيها
.وتموت من السم

106
00:09:53,310 --> 00:09:55,470
تتظاهرين بالقوّة يا نانا-تشان؟

107
00:09:55,470 --> 00:09:58,740
...إذًا، بدافع الاحترام لشجاعتك

108
00:09:58,960 --> 00:10:01,200
!سأجربهم كلّهم عليك

109
00:10:06,180 --> 00:10:08,830
.بدأ سمّي يأخذ مفعوله أخيرًا

110
00:10:12,960 --> 00:10:15,300
ما الذي... حدث؟

111
00:10:15,680 --> 00:10:16,930
لمَ اختفوا؟

112
00:10:18,100 --> 00:10:19,930
.أخبرتك للتو

113
00:10:19,930 --> 00:10:20,930
.أنّه سم

114
00:10:21,340 --> 00:10:23,350
أقلتِ... سم؟

115
00:10:25,960 --> 00:10:28,350
...كيف... قمتِ

116
00:10:28,760 --> 00:10:32,860
دماء كرونوس لديها القوّة
.لتطهير شياطين الزمن

117
00:10:33,190 --> 00:10:33,950
...ماذا

118
00:10:34,540 --> 00:10:36,300
لم تعرف، أليس كذلك؟

119
00:10:36,300 --> 00:10:39,240
،منذ اللحظة التي جرحني فيها شيطان زمنك

120
00:10:39,240 --> 00:10:42,420
.بدأ دمي بالعمل

121
00:10:42,420 --> 00:10:44,580
يطهّر دمي شياطين الزمن

122
00:10:44,580 --> 00:10:47,120
وبالطبع، يتخلّص من
.أيّ سم يمتلكونه

123
00:10:49,000 --> 00:10:51,830
...قاتل السم بالسم

124
00:10:51,830 --> 00:10:54,130
.مثلٌ مناسب لك

125
00:10:54,130 --> 00:10:56,840
...قوّة تطهيريّة؟ لا يمكن

126
00:10:57,250 --> 00:10:59,250
—ماذا تكونين

127
00:11:02,360 --> 00:11:06,050
.ماذا؟ آسفة، لا أستطيع سماعك

128
00:11:06,050 --> 00:11:08,680
!أنشأت فراغًا حولك

129
00:11:09,000 --> 00:11:13,190
كان بالإمكان أن تعيش لوقتٍ أطول
.لو أنّك أبقيتَ فمك مغلقًا

130
00:11:13,690 --> 00:11:17,570
ولكن بما أنّك تعرف أكثر من اللازم
...الآن، فيجب أن تختفي

131
00:11:19,810 --> 00:11:21,260
.إلى الأبد

132
00:11:32,880 --> 00:11:35,590
ما الخطب يا فتى؟ هل انتهت حركاتك؟

133
00:11:35,590 --> 00:11:39,240
!سحقًا، سحقًا! لا يمكن أن أسقط هكذا

134
00:11:39,240 --> 00:11:41,590
!فكّر بشيء يا أنا
!ابذل جهدك يا أنا

135
00:11:43,990 --> 00:11:46,760
أما تزال تنوي القتال أيّها الفتى؟

136
00:11:48,630 --> 00:11:50,100
!بالطبع

137
00:11:50,100 --> 00:11:52,850
!أنا أكثر شرير شرًّا في العالم

138
00:11:54,930 --> 00:11:57,480
!إنّك شجاع حقًّا

139
00:11:57,480 --> 00:12:01,860
،ولكن عندما أرى هجماتك قادمة
—مهما كانت السرعة

140
00:12:03,460 --> 00:12:05,740
هل هذا... بارود؟

141
00:12:06,050 --> 00:12:08,620
!إنّه يحافظ على احتراق تدريجي

142
00:12:08,920 --> 00:12:10,330
أدركت ذلك أخيرًا؟

143
00:12:11,710 --> 00:12:12,920
!تأخّرت

144
00:12:14,670 --> 00:12:16,380
!صاعقة القنبلة الناريّة

145
00:12:16,700 --> 00:12:19,610
أبطأ العديد من الشرارات المحترقة

146
00:12:19,610 --> 00:12:22,710
!وبعثرها كلّها من حولي؟

147
00:12:22,710 --> 00:12:25,140
!لا يمكنني تفادي كلّ هذا العدد منها

148
00:12:25,140 --> 00:12:27,870
،وعلى الرغم من صغر كلّ واحدة منها

149
00:12:27,870 --> 00:12:30,890
...تأثير هذا العدد منها هو

150
00:12:33,410 --> 00:12:35,950
!هائل...

151
00:12:57,040 --> 00:12:59,760
.لقد فزت أيّها العجوز

152
00:13:01,240 --> 00:13:03,710
...أشعر بالعار

153
00:13:04,330 --> 00:13:08,390
...سموّك، أنا آسف حقًّا

154
00:13:09,180 --> 00:13:13,890
...ديني لك... لوالدي... لا يمكنني

155
00:13:15,130 --> 00:13:17,030
...الأب الذي ربّاك

156
00:13:17,030 --> 00:13:18,860
...دين لعائلتك

157
00:13:21,560 --> 00:13:25,090
،ولكن، آسف لهذا

158
00:13:25,090 --> 00:13:27,930
.أنا أقاتل لشيء كهذا أيضًا

159
00:13:34,220 --> 00:13:36,960
مثير للشفقة لحد البكاء؟

160
00:13:37,230 --> 00:13:41,460
لماذا إذًا تريد حماية فيكتو؟

161
00:13:43,610 --> 00:13:46,590
.لا يمكنني فهم البشر حقًّا

162
00:13:46,840 --> 00:13:48,080
.سأخبرك

163
00:13:48,080 --> 00:13:52,720
كونهم يستحيل فهمهم هو
!ما يجعل البشر بشرًا

164
00:13:53,290 --> 00:13:54,290
.تبطيء

165
00:13:57,060 --> 00:13:59,540
!المطر الحقيقي للألف مخيّم

166
00:14:10,530 --> 00:14:11,370
!ماذا؟

167
00:14:19,250 --> 00:14:21,150
!تناول تقنيتي بذاتها؟

168
00:14:23,270 --> 00:14:25,990
.أودّ معرفة المزيد عنك أيضًا

169
00:14:25,990 --> 00:14:26,960
.حقًّا

170
00:14:27,730 --> 00:14:31,080
كيري، إنّه يفصل نفسه عن
!شيطان الزمن لتناول الوقت

171
00:14:31,080 --> 00:14:32,040
!كن حذرًا

172
00:14:32,040 --> 00:14:34,370
.أرى ذلك بوضوح

173
00:14:34,370 --> 00:14:36,850
.أنت ابقَ هناك ساكنًا يا فيكتو

174
00:14:38,310 --> 00:14:40,190
!الآكلين الأبديين

175
00:14:56,500 --> 00:14:58,620
.إنّهم يأكلون كلّ شيء حقًّا

176
00:14:58,890 --> 00:15:00,880
.هذا مجرّد لعب

177
00:15:00,880 --> 00:15:02,380
أتريد الاستمرار؟

178
00:15:02,590 --> 00:15:03,460
.بالطبع

179
00:15:04,110 --> 00:15:08,220
!لا أنوي التوقّف إلى أن أهزمك

180
00:15:08,540 --> 00:15:11,340
.يا إلهي. لا أفهم حقًّا

181
00:15:15,320 --> 00:15:20,390
سأراقب هذا الشيء الغريب
.براحتي بعد تناوله

182
00:15:20,390 --> 00:15:21,120
!كيري

183
00:15:25,020 --> 00:15:28,280
لا أريدك أن تقرّر أين
.سأذهب من تلقاء نفسك

184
00:15:29,030 --> 00:15:30,320
!إلغاء التبطيء

185
00:15:32,300 --> 00:15:33,410
لا يزال لا يجدي نفعًا؟

186
00:15:45,930 --> 00:15:50,470
هل أنا مُحق بالتفكير أنّك عزمت
التوقّف عن المقاومة وستتركني أتناولك؟

187
00:15:50,790 --> 00:15:53,840
.اكتشف بنفسك إن كنت تريد معرفة ذلك

188
00:15:53,840 --> 00:15:58,060
!ممتع، سأفعل ذلك بكلّ سرور

189
00:16:10,810 --> 00:16:14,030
لستَ تستخدم سيفك؟

190
00:16:14,430 --> 00:16:17,420
سرّعتُ تبخر الماء على الأرض

191
00:16:17,420 --> 00:16:19,160
.وحوّلتُه إلى سيوف عديدة

192
00:16:20,460 --> 00:16:23,420
توقّعتُ أن هذا لن يقضي
.على شيطان زمن

193
00:16:23,820 --> 00:16:26,630
لكن حتّى لو كنتَ قادرًا
،على معالجة نفسك

194
00:16:26,630 --> 00:16:28,690
.فلا بدّ أنّ ذلك يستهلك الطاقة

195
00:16:28,690 --> 00:16:31,520
.عليّ أن أنهيك قبل أن تعالج نفسك فحسب

196
00:16:31,930 --> 00:16:33,180
.انتهى الأمر

197
00:16:35,290 --> 00:16:40,100
الشعور الذي يراودك الآن هو
".انفعال يطلق عليه البشر "الخوف

198
00:16:53,070 --> 00:16:54,090
أكانت هذه معالجة؟

199
00:16:55,070 --> 00:16:57,940
،لا، لقد تناول زمنه

200
00:16:57,940 --> 00:17:00,370
يعيد نفسه إلى الحالة
!التي كان فيها قبل أن ألحق به الضرر

201
00:17:01,600 --> 00:17:05,290
لم نقابل شيطان زمن بمثل
!هذا النوع من القوّة من قبل

202
00:17:05,770 --> 00:17:11,520
القليل جدًّا من شياطين الزمن يمكنهم
.معالجة أنفسهم بأكل جزء من أجسادهم

203
00:17:11,520 --> 00:17:16,490
أشعر بالقليل من الاضطراب، ولكن
.هذا يعيدني إلى حالتي الطبيعيّة فورًا

204
00:17:16,490 --> 00:17:18,390
!إنّه رائع حقًّا

205
00:17:20,200 --> 00:17:23,600
!ولكن لا يمكنني الاستسلام الآن

206
00:17:25,640 --> 00:17:26,520
!كيري

207
00:17:30,490 --> 00:17:34,350
.ألم تنل كفايتك؟ دعه يأكلك فحسب

208
00:17:45,250 --> 00:17:46,040
!كيري

209
00:17:46,720 --> 00:17:50,540
حتى الإصابة لا تمنعك من
.مقاتلة عدوّك

210
00:17:50,740 --> 00:17:52,830
.أنا متفاجئ حقًّا

211
00:17:53,560 --> 00:17:54,300
...ولكن

212
00:17:54,740 --> 00:17:57,300
.لم تتبقَ لديك أيّ حركات

213
00:18:03,190 --> 00:18:05,350
...آه، صحيح

214
00:18:05,670 --> 00:18:07,620
!ذلك التعبير

215
00:18:07,620 --> 00:18:10,710
أجريت العديد من التجارب والمراقبة

216
00:18:10,710 --> 00:18:14,110
.من أجل فهم مشاعر البشر

217
00:18:14,880 --> 00:18:17,860
،البشر يبتسمون عندما يعانون

218
00:18:17,860 --> 00:18:20,870
،يحزنون عندما يرحل عنهم شخص يحبّونه

219
00:18:21,240 --> 00:18:24,330
وفي بعض الأحيان، يقولون
.أشياء لا يعنونها حتّى

220
00:18:25,330 --> 00:18:27,210
...وأنت

221
00:18:27,650 --> 00:18:30,330
تواصل مهاجمتي على الرغم
.من أنّك لا تملك فرصة للفوز

222
00:18:30,330 --> 00:18:32,330
،جرحتَ نفسك حتّى

223
00:18:32,330 --> 00:18:36,590
حين لو توقّفت عن المقاومة، فلن
.تكون قد شعرت بذلك الألم أبدًا

224
00:18:37,010 --> 00:18:41,330
كلّما راقبتهم أكثر، قلَّ
.فهمي لمشاعر البشر

225
00:18:41,690 --> 00:18:44,720
.لا يمكنني تفسيره منطقيًّا أبدًا

226
00:18:45,020 --> 00:18:47,850
.ولكن هنالك شيءٌ واحد أنا متأكّد منه

227
00:18:48,160 --> 00:18:51,830
،في آلاف التجارب هذه التي أجريتها

228
00:18:51,830 --> 00:18:55,360
،كلّما شعر البشر باقتراب الموت

229
00:18:55,360 --> 00:18:58,110
.فإنّهم يقومون بهذا التعبير دائمًا

230
00:19:00,080 --> 00:19:02,870
!"هذا هو... "الخوف

231
00:19:04,120 --> 00:19:05,490
خائف، أليس كذلك؟

232
00:19:05,490 --> 00:19:07,490
.يجب أن تكون كذلك

233
00:19:08,000 --> 00:19:13,380
الشعور البشري الوحيد الذي
..أفهمه هو الخوف

234
00:19:14,850 --> 00:19:21,340
وذلك بالنسبة لي هو
!أغلى شيء على الإطلاق

235
00:19:21,500 --> 00:19:22,090
!كيري

236
00:19:40,190 --> 00:19:44,700
.أعاد آيكس لمّ شمل عائلتنا
.ندين له بكلّ شيء

237
00:19:45,030 --> 00:19:49,460
فيكتو، هل كنت جاحدًا دائمًا؟

238
00:19:50,160 --> 00:19:51,460
...أبي

239
00:19:54,460 --> 00:19:58,180
!أنت مخطئ يا أبي! إنّ كيري في خطر

240
00:19:58,180 --> 00:19:59,840
!عليّ مساعدته

241
00:19:59,840 --> 00:20:01,280
ماذا عنّا إذًا؟

242
00:20:07,080 --> 00:20:10,210
.سنختفي إلى الأبد إن قتلتَ آيكس

243
00:20:10,210 --> 00:20:11,350
أهذا ما تريده؟

244
00:20:17,110 --> 00:20:19,840
،حتّى بعد أن أصبحت بالغًا

245
00:20:19,840 --> 00:20:21,900
.إنّك أنانيّ كالسابق

246
00:20:44,680 --> 00:20:45,990
!تماسك

247
00:20:46,430 --> 00:20:48,520
!أمّي وأبي ميّتان منذ زمنٍ طويل

248
00:20:48,900 --> 00:20:52,140
لا يمكنني إنقاذ كيري إن
!بقيت عالقًا في الماضي

249
00:21:11,970 --> 00:21:12,760
...أنا

250
00:21:16,870 --> 00:21:17,980
أنا

251
00:21:18,450 --> 00:21:20,420
!فائز

252
00:21:25,400 --> 00:21:27,340
.لن أستعير القوّة من أحد

253
00:21:27,710 --> 00:21:30,300
.سأنال الفوز بقوّتي

254
00:21:30,300 --> 00:21:32,180
!أنا الفائز المُطلق

255
00:21:32,180 --> 00:21:34,580
سأقاتل كما أرادت والدتي

256
00:21:34,580 --> 00:21:36,440
!وأفوز

257
00:21:36,440 --> 00:21:37,900
!أيس شوت

258
00:21:41,870 --> 00:21:44,400
.وقت الوداع يا فيك-تشان