5
00:00:22,020 --> 00:00:22,860
!توا-ساما

6
00:00:24,570 --> 00:00:26,240
!ريون! ريكو

7
00:00:28,360 --> 00:00:29,200
ماذا؟

8
00:00:31,410 --> 00:00:34,410
ريون

9
00:00:31,410 --> 00:00:34,410
ريكو

10
00:00:31,950 --> 00:00:33,240
هل من مشكلة؟

11
00:00:33,660 --> 00:00:35,870
.كان يوجد فتى هنا

12
00:00:36,250 --> 00:00:38,080
كنت هنا بمفردك

13
00:00:38,460 --> 00:00:40,000
...الأهمّ من ذلك يا توا-ساما

14
00:00:41,080 --> 00:00:43,380
.اسمحي لنا بمرافقتك رجاءً

15
00:00:43,880 --> 00:00:44,880
مرافقتي؟

16
00:00:45,460 --> 00:00:48,880
.عمتي زيرو تستهدف حياتك

17
00:00:49,470 --> 00:00:50,300
ماذا؟

18
00:02:44,540 --> 00:02:46,880
.هذا هو منزل ناناهوشي إذًا

19
00:02:48,630 --> 00:02:49,550
.فهمت

20
00:02:50,000 --> 00:02:53,380
إنه مكان ملائم للموت بالفعل

21
00:02:52,420 --> 00:02:55,380
زيرو

22
00:02:53,380 --> 00:02:55,010
.والهرب من الألم

23
00:02:56,510 --> 00:02:58,510
.أهلًا بك في قصري

24
00:02:59,430 --> 00:03:01,390
.أدعى ناناهوشي

25
00:03:00,060 --> 00:03:03,060
ناناهوشي

26
00:03:01,810 --> 00:03:04,020
أقرأ حركة النجوم

27
00:03:04,020 --> 00:03:07,020
.لتحقيق أمنيتك

28
00:03:09,320 --> 00:03:13,940
،بعد أن تحقّق أمنيتي يا ناناهوشي-دونو
ما الذي ترغب فيه بالمقابل؟

29
00:03:15,110 --> 00:03:19,700
.أرغب بالألم والحزن اللذان في قلبك

30
00:03:20,280 --> 00:03:26,000
.دموع المعاناة من عوام مثلكم تعتبر طعاما فاخرًا

31
00:03:27,420 --> 00:03:29,960
كما يشاع عنك، لديك نظامٌ غذائي غريب، صحيح؟

32
00:03:30,800 --> 00:03:34,470
.إن لم ترغبي في أيّ شيء، فسآخذ دموعك فحسب

33
00:03:35,050 --> 00:03:37,720
.تفضّل

34
00:03:40,180 --> 00:03:43,220
.هذا أرقى خشب عطري في العالم، المجرّة الصغرى

35
00:03:43,220 --> 00:03:48,230
.إن قدّمته مع حزن الناس، فسيطلق أروع العطور

36
00:03:59,910 --> 00:04:00,740
ماذا؟

37
00:04:01,580 --> 00:04:05,250
هل استمتعت بالنظر إلى داخل قلبي؟

38
00:04:06,660 --> 00:04:08,250
.وكأنك لا تحملين أيّ حزن

39
00:04:08,830 --> 00:04:10,630
ما الذي يحدث؟

40
00:04:16,130 --> 00:04:20,390
.ختمت كل دموعي داخل هذه اللآلئ السبعة الملوّنة

41
00:04:20,800 --> 00:04:22,890
.لهذا السبب لا أملك أيّ حزن

42
00:04:29,850 --> 00:04:31,980
.لا أستطيع التحرّك

43
00:04:31,980 --> 00:04:34,650
ما الذي تنوين فعله لي؟

44
00:04:35,570 --> 00:04:38,530
.سأضع فخًّا هنا

45
00:04:38,990 --> 00:04:40,950
أنا واثقة أنك لن تمانع، أليس كذلك يا ناناهوشي؟

46
00:04:47,710 --> 00:04:50,620
قاتلة الشياطين — سيتسونا

47
00:04:51,170 --> 00:04:52,710
ما هذه؟

48
00:04:51,170 --> 00:04:54,170
كيرارا

49
00:04:51,170 --> 00:04:54,170
هيسوي

50
00:04:53,380 --> 00:04:55,670
.إنه... كريم لليدين

51
00:04:57,670 --> 00:04:59,970
.سيتسونا، خذي هذا معك

52
00:05:01,260 --> 00:05:02,300
.كريم لليدين

53
00:05:02,640 --> 00:05:04,140
.برائحة الخزامى

54
00:05:05,810 --> 00:05:07,640
كريم لليدين؟

55
00:05:09,270 --> 00:05:10,600
.قد تصبح يداك جافتين

56
00:05:11,060 --> 00:05:13,900
كما أنّي سمعت أنّ القرية التي في الشمال أكثر
.برودة من المكان هنا

57
00:05:15,020 --> 00:05:15,900
.حسنًا

58
00:05:16,690 --> 00:05:19,400
.كوني حذرة أثناء قتل الشياطين

59
00:05:32,170 --> 00:05:34,880
أتتساءل عن هذه؟

60
00:05:35,960 --> 00:05:38,460
.لم أكن أتحدّث معك يا هيسوي

61
00:05:44,510 --> 00:05:47,600
.ربما كان طيفًا أو روحًا من نوعٍ ما

62
00:05:48,560 --> 00:05:50,430
.بدأ الثلج يتساقط

63
00:05:50,890 --> 00:05:53,770
.يبدو أننا سنرى الكثير من الثلج في الشمال

64
00:05:53,770 --> 00:05:54,810
!فلنسرع

65
00:05:54,810 --> 00:05:56,940
.علينا الوصول إلى هناك في الوقت المناسب من أجل موعدنا

66
00:06:10,250 --> 00:06:11,580
!ادخلي هناك

67
00:06:15,250 --> 00:06:17,750
!أخرجوني! أنا بريئة

68
00:06:17,750 --> 00:06:19,090
!اخرسي

69
00:06:19,090 --> 00:06:20,590
.سنقوم باستجوابك عن قريب

70
00:06:20,760 --> 00:06:23,760
موروها

71
00:06:21,260 --> 00:06:24,090
.من أجل ماذا؟ كنت أمرّ من هنا فحسب

72
00:06:24,590 --> 00:06:28,100
!نعلم أنك تعملين مع تاكيتشيو

73
00:06:28,470 --> 00:06:30,100
!ستنالين ما تستحقّينه

74
00:06:30,980 --> 00:06:33,770
يبدو أنهم اكتشفوا كلّ شيء

75
00:06:34,520 --> 00:06:38,770
.ممّا يعني أنّ المقاومة لن تنفع

76
00:06:43,780 --> 00:06:45,360
.يا للغرابة

77
00:06:46,490 --> 00:06:47,450
تقصدين هذه العربة؟

78
00:06:48,030 --> 00:06:49,950
.تدعى دراجة

79
00:06:50,330 --> 00:06:53,460
،أجل، إنها غريبة هي أيضًا

80
00:06:53,460 --> 00:06:56,290
.لكني كنت أقصدك أنت يا توا-ساما

81
00:06:56,290 --> 00:06:57,210
أنا؟

82
00:06:57,840 --> 00:07:01,960
.حسنًا، أعتقد أنّني غريبةٌ على هذه الفترة الزمنية

83
00:07:05,430 --> 00:07:08,930
لا خيار آخر أمامي سوى إبقاء مسافة بعيدة

84
00:07:08,930 --> 00:07:11,890
.حتى لا يكتشف كيرينمارو مكانهما

85
00:07:15,190 --> 00:07:16,230
.يا إلهي

86
00:07:17,440 --> 00:07:19,730
.قد لا يكون الأمر كذلك

87
00:07:20,780 --> 00:07:22,740
توا-ساما، أنت شخص طيّب

88
00:07:23,320 --> 00:07:25,650
.لكنك قويّة أيضًا

89
00:07:26,990 --> 00:07:31,410
.لهذا أرغب في الاعتماد عليك للمساعدة يا توا-ساما

90
00:07:32,580 --> 00:07:35,460
أتعتقدين أنني قوية حقًا؟

91
00:07:36,040 --> 00:07:39,670
.قيل لي أنني أرفض الانسحاب مما يجعلني عرضة للهجوم

92
00:07:39,670 --> 00:07:40,670
.كلا

93
00:07:40,670 --> 00:07:45,380
.توا-ساما، أنت شعاع نور يملأ قلبي وقلب ريكو

94
00:07:45,380 --> 00:07:48,010
...آسف لمقاطعة حديثكما

95
00:07:48,800 --> 00:07:51,510
.لكنه أتى، ضيفنا المزعج

96
00:07:52,220 --> 00:07:53,770
ضيف مزعج؟

97
00:07:59,730 --> 00:08:00,820
!كيرينمارو

98
00:08:00,820 --> 00:08:01,770
!أبي

99
00:08:01,820 --> 00:08:03,780
الملك الوحش — كيرينمارو

100
00:08:04,610 --> 00:08:05,950
.لا تقلقا

101
00:08:06,700 --> 00:08:09,030
.سأحميكما بحياتي

102
00:08:17,710 --> 00:08:20,630
كوهاكو

103
00:08:18,960 --> 00:08:20,630
.هذا صفّ مذهل من المنازل

104
00:08:21,420 --> 00:08:23,130
.يبدو أنهم أثرياء

105
00:08:23,960 --> 00:08:25,670
.بالطبع

106
00:08:25,670 --> 00:08:28,630
.تمكّنوا من توظيف قتلة شياطين من بلد بعيد

107
00:08:28,760 --> 00:08:31,760
روكوتا

108
00:08:28,760 --> 00:08:31,760
ناناسكي

109
00:08:29,180 --> 00:08:33,140
أيها الزعيم، لماذا هذه المنطقة ثريّة؟

110
00:08:34,470 --> 00:08:38,140
.كل هذا بفضل ضريح القرية هناك

111
00:08:38,140 --> 00:08:41,270
."يقدّسون حبوبًا تدعى "نعمة الحبوب الخمسة

112
00:08:41,270 --> 00:08:43,690
.يقال أنها تجلب الحظّ السعيد

113
00:08:45,070 --> 00:08:49,200
وهذه هي قرية غوكوكو التي طلبت خدماتنا؟

114
00:08:49,740 --> 00:08:50,570
.هذا صحيح

115
00:08:55,620 --> 00:08:57,620
!مرحبًا يا كوهاكو

116
00:08:57,620 --> 00:08:59,250
!كوزو وياماتا

117
00:08:59,250 --> 00:09:00,540
.مرّ وقت طويل

118
00:09:00,710 --> 00:09:03,710
كوزو

119
00:09:00,710 --> 00:09:03,710
ياماتا

120
00:09:01,040 --> 00:09:02,420
كيف حالكما؟

121
00:09:02,420 --> 00:09:04,130
.نحن بخير

122
00:09:04,130 --> 00:09:05,710
مرّت 15 سنة، صحيح؟

123
00:09:05,710 --> 00:09:08,760
.زعيم الشمال يبلّغك تحياته

124
00:09:09,680 --> 00:09:11,760
زعيم الشمال لن ينضمّ إلينا؟

125
00:09:12,600 --> 00:09:15,430
.قال أنه لا يمكنه مكافحة أعراض الكِبر

126
00:09:15,430 --> 00:09:17,480
.سيحلّ غورو مكانه

127
00:09:15,810 --> 00:09:18,810
غورو

128
00:09:17,810 --> 00:09:19,390
.أتطلّع للعمل رفقتكم

129
00:09:21,150 --> 00:09:26,150
.هؤلاء هم روكوتا، ناناسكي، هيسوي وسيتسونا

130
00:09:27,360 --> 00:09:28,900
.امرأة قاتلة شياطين

131
00:09:29,400 --> 00:09:31,410
لم نر واحدة منذ سانغو-ساما، صحيح؟

132
00:09:31,950 --> 00:09:36,160
هل ستتمكن هذه الفتاة الصغيرة
من قتل الشياطين كما ينبغي؟

133
00:09:36,580 --> 00:09:41,290
.سيتسونا ماهرة كفاية لتقارع أختي الكبرى

134
00:09:42,540 --> 00:09:44,540
.لا تبدو كذلك بالنسبة لي

135
00:09:45,130 --> 00:09:48,800
.إن أردت اختبار مهاراتي، فسأواجهك في أيّ وقت

136
00:09:48,800 --> 00:09:50,050
.لا تضيّعي وقتك يا سيتسونا

137
00:09:50,590 --> 00:09:52,470
.لن يكون هذا عملًا سهلًا

138
00:09:52,470 --> 00:09:56,560
.طلب منا قتل قطيع كبير من ثيران اللهب

139
00:09:57,100 --> 00:09:58,060
ثيران اللهب؟

140
00:09:58,520 --> 00:09:59,810
.إنها شياطين ماشية

141
00:10:00,270 --> 00:10:01,980
تقوم يحرق المنازل

142
00:10:01,190 --> 00:10:04,190
ثيران اللهب

143
00:10:01,980 --> 00:10:03,480
.وكذلك الجبال والغابات

144
00:10:05,190 --> 00:10:06,190
،انتظر لحظة يا كوزو

145
00:10:06,520 --> 00:10:10,400
.في العادة ما تطيع ثيران اللهب إلهًا محليًا

146
00:10:10,400 --> 00:10:11,990
لماذا تثور هكذا؟

147
00:10:12,660 --> 00:10:14,410
.هذه ليست حالة عادية

148
00:10:14,410 --> 00:10:18,870
مالكها، الإله المحليّ، هو من أمرها بالثوران

149
00:10:19,580 --> 00:10:22,540
،مما يعني أنه إن لم نتمكّن من استرضاء الإله المحليّ

150
00:10:22,540 --> 00:10:25,130
.فلا يمكننا إيقاف ثيران اللهب

151
00:10:26,250 --> 00:10:27,880
يبدو أمرًا مزعجًا، صحيح؟

152
00:10:30,210 --> 00:10:31,380
!إنه ثور لهب

153
00:10:31,380 --> 00:10:33,590
!وصل ثور لهب إلى هنا

154
00:10:42,690 --> 00:10:43,730
!هيرايكوتسو

155
00:10:47,360 --> 00:10:48,480
!تفاداها

156
00:10:48,480 --> 00:10:49,360
!انتظري هنا يا كيرارا

157
00:10:50,480 --> 00:10:52,280
!وباء السنونو

158
00:10:57,990 --> 00:11:00,200
.هزمت ثور اللهب ذاك بهجوم واحد

159
00:11:00,620 --> 00:11:05,250
.يمكنني رؤية مضاهاة مهاراتها لسانغو-ساما

160
00:11:06,000 --> 00:11:08,500
!ناناسكي، روكوتا، أطفئا النيران

161
00:11:08,500 --> 00:11:09,340
!حاضر -
!حاضر -

162
00:11:15,930 --> 00:11:18,850
.قمت بتربية قاتلة شياطين رائعة يا كوهاكو

163
00:11:18,850 --> 00:11:21,180
.كلا. لا يزال الطريق طويلًا أمامها

164
00:11:25,600 --> 00:11:27,190
.أعتقد أنّ هذا هو الوقت المناسب

165
00:11:28,860 --> 00:11:29,690
!مفاجأة

166
00:11:30,150 --> 00:11:33,990
!كلاب الراكون أولئك لم يلاحظوا هذه الأداة المفيدة

167
00:11:42,700 --> 00:11:43,540
!مرحى

168
00:11:44,290 --> 00:11:46,580
.أنا عبقرية حقًا

169
00:11:51,630 --> 00:11:53,420
.حدسي يخبرني بأن نهرب

170
00:11:54,800 --> 00:11:56,930
.يجدر بنا الهرب قطعًا

171
00:11:59,970 --> 00:12:01,180
...لكن لسبب ما

172
00:12:02,060 --> 00:12:04,600
!لا يمكنني فعل ذلك وحسب

173
00:12:07,060 --> 00:12:15,860
قصة خيالية إقطاعية — ياشاهيمي: الأميرة نصف الشيطانية

174
00:12:17,780 --> 00:12:19,530
!صاحب الجلالة الشاب

175
00:12:30,210 --> 00:12:32,920
.لنرَ ما يجري الآن

176
00:12:33,550 --> 00:12:36,550
كيكونوسكي

177
00:12:34,010 --> 00:12:36,550
ماذا فعلتم مع الدخيلة ليلة البارحة؟

178
00:12:37,090 --> 00:12:38,300
ماذا؟

179
00:12:38,300 --> 00:12:40,680
!يبدو مشابهًا لتاكيتشيو تمامًا

180
00:12:41,100 --> 00:12:43,680
.وضعناها في الزنزانة يا سيدي

181
00:12:43,780 --> 00:12:46,060
شوغن ماميانا

182
00:12:43,970 --> 00:12:48,350
إنها ابنة تلك الراهبة كاغومي

183
00:12:48,350 --> 00:12:50,770
.هذا يعني أنها عدوّة لكلاب راكون البدر

184
00:12:50,770 --> 00:12:54,320
،زيادة على ذلك، إن كانت ابنة نصف الشيطاني إينوياشا ذاك

185
00:12:54,320 --> 00:12:57,450
!فهي ابنة العدوّ الذي وضع ندبة على وجهي

186
00:12:58,110 --> 00:13:02,200
.يبدو أنهم يكرهونني حقًا

187
00:13:02,830 --> 00:13:07,290
هل أنت واثق أنها تعمل لدى أخي الأكبر؟

188
00:13:07,290 --> 00:13:09,080
.لا شكّ في ذلك

189
00:13:09,870 --> 00:13:11,750
،أخي العزيز

190
00:13:11,750 --> 00:13:13,090
.أشتاق إليه كثيرًا

191
00:13:13,250 --> 00:13:15,170
.كيكونوسكي-ساما

192
00:13:15,170 --> 00:13:18,920
.تاكيتشيو شخص شرّير قام بتخريب عشيرة ماميدايرا

193
00:13:18,920 --> 00:13:21,510
!أرجو أن تتوقّف عن مخاطبته بأخيك

194
00:13:21,510 --> 00:13:24,430
.صحيح، أعتذر على ذلك

195
00:13:25,510 --> 00:13:26,720
!بلاغ

196
00:13:26,720 --> 00:13:28,730
!هربت الفتاة من الزنزانة

197
00:13:29,020 --> 00:13:31,230
!غبيّ! ابحثوا عنها في كلّ مكان

198
00:13:31,480 --> 00:13:32,480
!حاضر

199
00:13:33,400 --> 00:13:35,900
.يبدو أنني سأعود لاحقًا من أجل قوسي وسهمي

200
00:13:38,070 --> 00:13:40,150
.مرّ وقت طويل يا ريون

201
00:13:41,160 --> 00:13:42,910
.ليس بالوقت الطويل

202
00:13:43,280 --> 00:13:47,160
.كنت أراك في أحلامي يا أبي

203
00:13:47,790 --> 00:13:50,870
.الأحلام مجرّد أحلام. الحقيقة هي الحقيقة

204
00:13:51,750 --> 00:13:55,630
،ما دمت مستمتعة بشعور المشي على قدميك في هذا العالم

205
00:13:55,630 --> 00:13:56,670
.فهذا كل ما يهمّ

206
00:13:58,260 --> 00:14:02,680
.هذا الجسد مجرّد وعاء مصنوع من تربة القبور والعظام

207
00:14:03,930 --> 00:14:07,310
هل تكرهينني، أنا والدك؟

208
00:14:07,720 --> 00:14:11,560
لا يمكنني مسامحتك على الحاجز الذي وضعته
.على جبل موسوبي

209
00:14:13,770 --> 00:14:16,020
لا تفهمين لمَ فعلت ذلك، صحيح؟

210
00:14:16,020 --> 00:14:17,480
.في تلك الحالة، لا خيار آخر أمامي

211
00:14:19,440 --> 00:14:21,450
لكن، لن أسمح لك

212
00:14:21,450 --> 00:14:24,740
.باعتراض حلمي بالسفر ما وراء الزمكان

213
00:14:25,620 --> 00:14:28,240
.حتى وإن كنت ابنتي الحبيبة

214
00:14:29,250 --> 00:14:30,620
!سأوقفك

215
00:14:31,210 --> 00:14:34,630
هل ستتمكنان من حماية ريون؟

216
00:14:44,180 --> 00:14:45,850
!سأقوم بحماية ريون

217
00:14:47,180 --> 00:14:49,810
ريون، منحتها سيف التعويذة؟

218
00:14:50,810 --> 00:14:55,810
.بما أنني سأواجه الزانسيكن، فلا حاجة لأكبح نفسي

219
00:14:59,480 --> 00:15:01,820
!فلنجعله نزالًا عادلًا

220
00:15:03,400 --> 00:15:08,200
.ريون، انظري كم أصبح والدك أكثر قوّة

221
00:15:08,660 --> 00:15:10,410
.يا لوقاحتك

222
00:15:10,410 --> 00:15:11,450
!توا-ساما

223
00:15:11,450 --> 00:15:13,370
.هذا ليس الوقت المناسب للتواجه بالسيوف

224
00:15:13,710 --> 00:15:15,080
!لن أتراجع

225
00:15:15,750 --> 00:15:16,830
.توا-ساما

226
00:15:20,920 --> 00:15:21,760
!كان ذلك وشيكًا

227
00:15:25,890 --> 00:15:26,760
.إنه ذلك الفتى

228
00:15:27,260 --> 00:15:29,510
ماذا هناك؟ ماذا ترين؟

229
00:15:33,180 --> 00:15:34,270
...ريون-ساما

230
00:15:34,940 --> 00:15:37,270
هل ترين أو تحسيّن بشيء ما؟

231
00:15:37,860 --> 00:15:39,770
.كلا، لا شيء

232
00:15:41,980 --> 00:15:43,780
يمكنك رؤية أكورو؟

233
00:15:54,000 --> 00:15:54,870
.لقد رحل

234
00:15:56,870 --> 00:15:59,000
!حسنًا إذًا! فلنبدأ

235
00:15:59,540 --> 00:16:02,380
هل كان ذلك الفتى ممسكًا بمروحة؟

236
00:16:03,550 --> 00:16:05,300
لمَ تسأل ذلك؟

237
00:16:05,300 --> 00:16:06,380
.بالطبع

238
00:16:07,840 --> 00:16:10,220
.أنت هي ابنة سيشّومارو فعلًا

239
00:16:14,310 --> 00:16:19,610
.القدرة على رؤية أكورو قد تكون خاصة بعشيرتكم

240
00:16:21,360 --> 00:16:22,730
!أبي

241
00:16:22,730 --> 00:16:26,030
.دولاب الزمن لم يعد يفضّلك

242
00:16:26,360 --> 00:16:28,780
.لقد انقضى زمنك

243
00:16:29,200 --> 00:16:31,280
.فلتحاولي إيقافه إذًا

244
00:16:31,740 --> 00:16:36,540
.أعتقد أنّ العالم القادم بيدي توا-ساما

245
00:16:37,710 --> 00:16:39,250
.يبدو هذا مسليًا أيضًا

246
00:16:39,670 --> 00:16:40,790
...لكن

247
00:16:40,790 --> 00:16:43,090
،بما أنك اخترت عصيان والدك

248
00:16:43,090 --> 00:16:45,840
!استعدّي لقطع طريق صعب أمامك

249
00:16:49,010 --> 00:16:50,590
!عد إلى هنا يا كيرينمارو

250
00:16:50,590 --> 00:16:51,470
!توا-ساما

251
00:16:52,010 --> 00:16:52,850
!ريكو

252
00:16:54,640 --> 00:16:57,810
.سنلتقي مجددًا يا ابنة سيشّومارو

253
00:16:59,310 --> 00:17:00,940
!ريكو، أنا آسفة

254
00:17:00,940 --> 00:17:02,360
.كل ذلك بسببي

255
00:17:02,820 --> 00:17:04,360
.أرخيت دفاعي

256
00:17:05,440 --> 00:17:07,860
.أصيبت عيناي

257
00:17:18,790 --> 00:17:21,790
الإله المحلّي — مايوناكا

258
00:17:20,080 --> 00:17:22,380
أولًا ظهر شامان، والآن قتلة شياطين؟

259
00:17:22,880 --> 00:17:25,000
.كالعادة، يا لهم من حمقى

260
00:17:28,340 --> 00:17:30,260
سيدي، ما الذي يفعلونه؟

261
00:17:30,260 --> 00:17:34,010
.طلبت من الشامان أن يخلق عاصفة ثلجية

262
00:17:34,210 --> 00:17:37,060
رئيس قرية غوكوكو

263
00:17:34,390 --> 00:17:36,470
...هذه العاصفة الثلجية إذًا

264
00:17:36,470 --> 00:17:38,270
.هي نتيجة لصلواته

265
00:17:39,060 --> 00:17:42,310
.لن تهاجم ثيران اللهب خلال عاصفة ثلجية

266
00:17:42,730 --> 00:17:45,480
.ستضعف لهب قرونهم

267
00:17:45,860 --> 00:17:49,570
.إن كان هذا يحلّ المشكلة، فلم يكن هنالك داعٍ لاستدعائنا

268
00:17:50,360 --> 00:17:52,240
.ليس الأمر بتلك البساطة

269
00:17:52,660 --> 00:17:56,330
.لا يمكننا الاستمرار في حياتنا اليومية هكذا

270
00:17:56,910 --> 00:17:58,500
،عندما تتوقّف العاصفة

271
00:17:58,500 --> 00:18:00,500
.ستهاجم ثيران اللهب في قطيع كبير

272
00:18:00,830 --> 00:18:03,710
أهذا افتراض مؤكد يا سيدي؟

273
00:18:04,420 --> 00:18:05,340
.أجل

274
00:18:06,800 --> 00:18:11,340
.سنقوم نحن الثمانية بالحراسة في كلّ اتجاه

275
00:18:07,440 --> 00:18:11,340
قرية غوكوكو — منظور عين الطائر

276
00:18:11,760 --> 00:18:14,050
سنتمكن من الدفاع ضدّ ثيران اللهب

277
00:18:14,390 --> 00:18:17,100
.لكن المشكلة الرئيسية هي زعيمها، الإله المحليّ

278
00:18:17,520 --> 00:18:21,690
.الإله المحليّ، مايوناكا، عنيد للغاية

279
00:18:22,310 --> 00:18:25,110
مايوناكا؟ ذاك هو اسم الإله المحليّ؟

280
00:18:25,690 --> 00:18:26,610
.أجل

281
00:18:27,230 --> 00:18:30,030
لماذا يهاجم مايوناكا هذه القرية؟

282
00:18:30,530 --> 00:18:32,360
هل من سبب وراء ذلك؟

283
00:18:32,530 --> 00:18:35,370
.من يدري؟ لا فكرة لديّ

284
00:18:37,120 --> 00:18:40,870
سيدي، سمعت أنّ إلهًا محليًا يدعى ماهيروما

285
00:18:40,870 --> 00:18:43,120
.كان يعيش في هذه الأرض

286
00:18:44,750 --> 00:18:46,630
تعرف ذاك القدر سلفًا؟

287
00:18:47,040 --> 00:18:50,130
،الغرض الإلهي الذي تسميه بحبوب النعم الخمسة

288
00:18:50,130 --> 00:18:51,260
هلا ألقينا نظرة عليها؟

289
00:18:53,970 --> 00:18:55,510
.حسنًا

290
00:19:01,770 --> 00:19:05,020
.وكأنّ الشمس كانت هنا

291
00:19:05,560 --> 00:19:09,360
بفضل هذا الغرض الإلهي، جميع القرى في هذه المنطقة

292
00:19:09,360 --> 00:19:13,570
.تتمكّن من تلقّي حقول خصبة ومحاصيل وفيرة

293
00:19:14,820 --> 00:19:16,910
.هذه هي نعمة الحبوب الخمسة إذًا

294
00:19:17,530 --> 00:19:20,790
.هذا ما يسعى خلفة مايوناكا إذًا

295
00:19:20,790 --> 00:19:24,620
،ليس الآلهة المحليّون قد يريدون هذا فحسب

296
00:19:24,620 --> 00:19:29,050
.لكن العديد من الشياطين وحكّام مناطق أخرى أيضًا

297
00:19:29,590 --> 00:19:32,920
.ساعدونا رجاءً يا قتلة الشياطين

298
00:19:32,920 --> 00:19:35,550
.سندفع لكم مكافأة سخيّة

299
00:19:36,470 --> 00:19:37,510
...عمّي

300
00:19:39,470 --> 00:19:43,060
...قائد قتلة الشياطين الشماليّ قبل بهذا العمل، لذا

301
00:19:43,520 --> 00:19:47,230
.كوهاكو، فلنضع بعض الفخاخ ونقضي على ثيران اللهب تلك

302
00:19:47,230 --> 00:19:48,810
.أجل، لنفعل ذلك

303
00:19:50,570 --> 00:19:51,530
ما الذي قد يحدث

304
00:19:51,530 --> 00:19:54,950
إذا سلّمتم نعمة الحبوب الخمسة لمايوناكا؟

305
00:19:55,650 --> 00:19:59,870
إن فعلنا ذلك، فكيف سنعيش؟

306
00:19:59,870 --> 00:20:01,450
!لا تكوني سخيفة

307
00:20:02,750 --> 00:20:05,960
.آسفة يا ريكو. كل هذا بسببي

308
00:20:06,420 --> 00:20:09,670
.كلا. تأذّى ريكو بسببي أنا

309
00:20:10,840 --> 00:20:12,630
.توقّفا رجاءً

310
00:20:13,170 --> 00:20:14,970
.أنا من أخفق

311
00:20:22,520 --> 00:20:24,730
.لذا فهو أمر حيّد

312
00:20:25,180 --> 00:20:27,350
...لكن، لو كنتُ أكثر حذرًا

313
00:20:27,810 --> 00:20:29,730
.لا تقلقي بخصوص ذلك يا توا-ساما

314
00:20:30,360 --> 00:20:34,610
.هنالك أوقات يعميك النظر فيها عن رؤية الحقيقة

315
00:20:38,110 --> 00:20:39,120
!عودي إلى هنا

316
00:20:41,120 --> 00:20:44,620
!أعلم أنّه تمّ توظيفكم للقيام بهذا، لكن لا تتمادوا

317
00:20:45,200 --> 00:20:46,830
!احرصوا على تفادي هذه

318
00:20:47,500 --> 00:20:48,830
!موجة التنّين القرمزيّ

319
00:21:00,090 --> 00:21:02,810
!حان وقت ردّ الدين من السنوات السابقة

320
00:21:02,810 --> 00:21:04,850
راكون كلب البدر

321
00:21:02,920 --> 00:21:04,850
شيطان راكون كلب جزيرة ماميانا القديم

322
00:21:06,310 --> 00:21:07,600
...ظهرت أخيرًا

323
00:21:08,020 --> 00:21:09,400
!يا راكون كلب البدر

324
00:21:12,400 --> 00:21:14,360
...بهذه الحمرة

325
00:21:14,820 --> 00:21:17,360
.أصبح بينياشا، مدمّرة الأراضي

326
00:21:17,950 --> 00:21:19,610
!انتظري يا موروها

327
00:21:20,030 --> 00:21:24,290
!إن استخدمت حمرتك الآن، فلن تستيقظي ليوم كامل

328
00:21:24,830 --> 00:21:28,120
!لن أسمح بحدوث ذلك بعد الآن

329
00:21:31,750 --> 00:21:35,500
!فلتشهدوا قوّة بينياشا الجديدة والمحسّنة

330
00:21:39,050 --> 00:21:42,800
!موجة الارتداد القرمزية

331
00:23:32,460 --> 00:23:35,330
يحاول قتلة الشياطين حماية قرية غوكوكو

332
00:23:35,330 --> 00:23:37,130
.من إله محليّ يدعى مايوناكا

333
00:23:37,750 --> 00:23:40,130
!لكن هنالك خائن بينهم

334
00:23:40,840 --> 00:23:42,970
!موروها، هذا ليس الوقت المناسب للنوم

335
00:23:43,300 --> 00:23:46,430
.علينا الإنصات لكشف الحقيقة المغطّاة بالظلام

336
00:23:46,970 --> 00:23:49,010
في الحلقة القادمة من ياشاهيمي: الأميرة نصف الشيطانية

337
00:23:49,010 --> 00:23:50,560
"مايوناكا الزائر"

338
00:23:51,220 --> 00:23:53,890
ماذا؟ ستستخدمين يوكاري نو تاتشيكيري؟