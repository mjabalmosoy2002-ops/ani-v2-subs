1
00:00:04,220 --> 00:00:05,760
أتعتقدين أنّ هذا البسكويت سيحقّق مبيعات؟

2
00:00:05,760 --> 00:00:08,310
سوما-كن صمّم هذه اللّصيقة

3
00:00:08,310 --> 00:00:09,710
أليست ظريفة؟

4
00:00:09,710 --> 00:00:11,310
هذه ساكورا

5
00:00:11,570 --> 00:00:12,270
!نُباح

6
00:00:12,470 --> 00:00:14,490
إنّها كلب ظريف

7
00:00:15,700 --> 00:00:17,570
لدينا نوع آخر أيضاً

8
00:00:16,740 --> 00:00:17,570
صديقة أسامي
الّتي تقدّم المساعدة
في المقهى

9
00:00:18,090 --> 00:00:19,060
!هذه صورتي

10
00:00:19,060 --> 00:00:20,030
إنّها ظريفة

11
00:00:20,400 --> 00:00:22,780
عندما أرسم، تغدو رسمتي جميلة

12
00:00:22,780 --> 00:00:26,360
وارتأيتُ أنّ رسمك الغبيّ سيكون أظرف

13
00:00:26,360 --> 00:00:27,510
هل تسخر منّي؟

14
00:00:27,510 --> 00:00:29,380
!لا أسخر صدّقني

15
00:00:29,910 --> 00:00:31,230
هذا ليس شيئاً مُبتكَراً

16
00:00:31,230 --> 00:00:34,330
لكن أحاول حاليّاً أن أفعل ما يمكنني فعله

17
00:00:35,250 --> 00:00:36,420
مُبهر

18
00:00:36,720 --> 00:00:39,610
عندما يكون لديك هدف، فإنّ كلّ
يوم يبدو مليئاً بالإنجاز، صحيح؟

19
00:00:39,610 --> 00:00:40,390
!أجل

20
00:00:40,390 --> 00:00:43,150
شون، عليك أن تُنجز وظيفتك المدرسيّة الصّيفيّة

21
00:00:43,150 --> 00:00:45,790
لكن هاياتي-سان ليس هنا بعد

22
00:00:45,790 --> 00:00:47,880
إذاً ابدأ بمفردك

23
00:00:47,880 --> 00:00:48,490
لا أستطيع

24
00:00:48,600 --> 00:00:49,690
هاياتي-سان

25
00:00:50,260 --> 00:00:51,520
على ذكرِه

26
00:00:52,170 --> 00:00:53,170
مرحباً

27
00:00:53,170 --> 00:00:54,160
هل كلّ شيء على ما يُرام؟

28
00:00:54,160 --> 00:00:55,350
مرحباً شون-كن

29
00:00:55,350 --> 00:00:56,180
آسف لتأخُّري

30
00:00:56,480 --> 00:00:58,350
ليست مُشكلة

31
00:00:58,350 --> 00:01:01,540
لم أستطع إيجاد هاتفي وجعلَني البحث عنه أتأخّر

32
00:01:01,540 --> 00:01:04,050
حسناً، يسرّني أنّك وجدته

33
00:01:04,050 --> 00:01:07,380
لا، استسلمتُ وقرّرتُ المجيء

34
00:01:09,030 --> 00:01:11,310
إذاً كيف تتّصل بي الآن؟

35
00:01:11,310 --> 00:01:12,970
ماذا؟ بهاتفي

36
00:01:12,970 --> 00:01:14,220
ماذا؟

37
00:01:16,060 --> 00:01:17,270
شارفتُ على الوصول

38
00:01:17,270 --> 00:01:18,350
حسناً

39
00:01:18,910 --> 00:01:20,140
ما الّذي يجري؟

40
00:01:20,140 --> 00:01:23,800
كان هاياتي-سان يتّصل بي عبر
هاتفه بينما كان يبحث عن هاتفه

41
00:01:23,680 --> 00:01:24,220
!بصق

42
00:02:55,730 --> 00:02:56,920
حسناً

43
00:02:56,920 --> 00:02:58,210
سأكتفي بهذا القدر

44
00:02:58,210 --> 00:02:59,590
شكراً جزيلاً لك

45
00:02:59,590 --> 00:03:00,790
ستذهب من الآن؟

46
00:03:00,790 --> 00:03:01,840
لديك شيء تفعله؟

47
00:03:01,840 --> 00:03:02,600
أجل

48
00:03:02,610 --> 00:03:09,830
...استماع

49
00:03:03,000 --> 00:03:08,150
ثمّة صديق لي يصنع الأسطوانة خاصّته
وأنا سأصمّم الغلاف

50
00:03:08,150 --> 00:03:09,840
سنجتمع لمناقشة ذلك

51
00:03:10,400 --> 00:03:11,810
إلى اللّقاء

52
00:03:12,750 --> 00:03:14,880
كان مُتحمّساً للغاية

53
00:03:15,670 --> 00:03:18,170
يبدو أنّ لديه أشياء كثيرة يريد فعلها

54
00:03:18,170 --> 00:03:19,350
هذا مُذهل

55
00:03:19,680 --> 00:03:22,260
هاياتي-سان، هل لديك أيّ مخطّطات للمستقبل؟

56
00:03:22,260 --> 00:03:23,920
ليس بعد

57
00:03:24,190 --> 00:03:26,320
بوسعك أن تصبح معلّماً أو ما شابه

58
00:03:26,320 --> 00:03:27,630
فأنت ماهر في التّعليم

59
00:03:28,510 --> 00:03:30,220
،فكّرتُ في الأمر

60
00:03:30,220 --> 00:03:32,690
لكن لستُ جيّداً في التّعامل مع عدد كبير من النّاس

61
00:03:32,690 --> 00:03:33,970
صحيح

62
00:03:33,970 --> 00:03:35,180
غالباً لن يتحمّسوا لك

63
00:03:35,400 --> 00:03:36,270
بئساً

64
00:03:35,480 --> 00:03:36,270
طعنة

65
00:03:37,320 --> 00:03:38,830
إنّها استراحة الصّيف خاصّتي

66
00:03:38,830 --> 00:03:40,480
أريد فعل شيء مذهل

67
00:03:40,480 --> 00:03:43,630
هذا ما قلته في الشّهر الماضي
أيضاً في عيد ميلادك

68
00:03:43,630 --> 00:03:45,060
عمري 17 الآن

69
00:03:45,060 --> 00:03:46,280
أريد فعل شيء مذهل

70
00:03:46,530 --> 00:03:48,370
يبدو وكأنّه سيقول ذلك مهما كانت المناسبة

71
00:03:48,660 --> 00:03:50,440
هذه مفاجأة

72
00:03:50,440 --> 00:03:53,090
يبدو شون-كن كشخص ينحرج من احتفال عائلته به

73
00:03:53,350 --> 00:03:56,410
تحبّ أمّنا الاحتفالات حقّاً

74
00:03:56,410 --> 00:03:59,920
...يذكّرني هذا بما أخبرتني به أمّنا

75
00:03:59,920 --> 00:04:00,890
شون؟

76
00:04:00,890 --> 00:04:03,130
سنُخرج الكيك، لذا انزل من فضلك

77
00:04:03,130 --> 00:04:05,760
!عيد ميلاد سابع عشر سعيد

78
00:04:05,760 --> 00:04:07,800
عمرك 17 إذاً

79
00:04:07,800 --> 00:04:08,880
الوقت يمضي سريعاً

80
00:04:08,880 --> 00:04:11,400
مهلاً، توقّفا

81
00:04:11,400 --> 00:04:12,810
لا تُعاملاني كطفل

82
00:04:12,810 --> 00:04:15,240
،لكن بالنسبة لأبيك ولي

83
00:04:12,810 --> 00:04:17,900
شون-كن
عيد ميلاد سعيد

84
00:04:15,240 --> 00:04:17,910
أنت وأختك ستبقيان طفلينا دوماً

85
00:04:18,230 --> 00:04:21,600
علينا القيام بهذه الاحتفالات ما دمتُما تعيشان هنا

86
00:04:19,190 --> 00:04:20,610
هيراغانا

87
00:04:22,010 --> 00:04:23,940
خُذ. ضع الشّمع

88
00:04:23,940 --> 00:04:24,820
شمع؟

89
00:04:24,820 --> 00:04:27,340
مهلاً، ليس علينا فعل ذلك

90
00:04:27,340 --> 00:04:29,420
يقول ذلك، لكنّه أخذها مع ذلك

91
00:04:29,970 --> 00:04:31,490
سأذهب لإحضار ولّاعة

92
00:04:31,490 --> 00:04:33,360
حسناً، ليس عليكما فعل هذا في العام المقبل

93
00:04:33,680 --> 00:04:35,750
لكن مع ذلك تريد كيكاً، صحيح؟

94
00:04:35,750 --> 00:04:37,160
سأتناول الكيك

95
00:04:37,160 --> 00:04:38,830
لكن لا مزيد من الشّمع بعد هذا العام

96
00:04:39,140 --> 00:04:40,850
لا تكن كذلك

97
00:04:40,850 --> 00:04:44,560
الشّمع على الكيك الخاص بك لن يشتعل
...إلّا مرّة في العام

98
00:04:43,300 --> 00:04:45,260
شون-كن
عيد ميلاد سعيد

99
00:04:45,410 --> 00:04:47,730
كلّها مقلوبة

100
00:04:48,290 --> 00:04:51,560
إنّها دلالة على أنّني لا أريدها مُشتعلة

101
00:04:51,810 --> 00:04:53,260
ارتكبتَ خطأ بسيطاً

102
00:04:53,260 --> 00:04:54,840
لا، كان ذلك مُتعمَّداً

103
00:04:54,840 --> 00:04:55,590
حسناً، حسناً

104
00:04:55,590 --> 00:04:56,910
لنقلبها

105
00:04:56,910 --> 00:04:58,180
!أخبرتُكِ

106
00:04:58,180 --> 00:05:00,470
لذا هذا ما حدث

107
00:05:00,470 --> 00:05:02,500
ليس هذه الرّواية ثانية

108
00:05:02,500 --> 00:05:04,520
يبدو أنّ أفراد عائلتك مُتحابّون

109
00:05:04,800 --> 00:05:07,390
هاياتي-كن، هل ستذهب إلى المنزل لأجل الأوبون؟

110
00:05:08,400 --> 00:05:11,490
كنتُ أفكّر في الانتظار قليلاً والعودة
إلى المنزل في أوائل سبتمبر

111
00:05:11,940 --> 00:05:13,290
من أين كنت ذكّرني؟

112
00:05:13,290 --> 00:05:14,190
مي

113
00:05:14,190 --> 00:05:15,170
مي؟

114
00:05:15,500 --> 00:05:17,530
هل هو المكان الّذي يوجد فيه
ذلك المزار الّذي يشبه القريدس؟

115
00:05:17,530 --> 00:05:19,880
ما الجزء في إيسي جينغو يذكّرك بالقريدس؟

116
00:05:22,170 --> 00:05:22,710
خبط

117
00:05:22,420 --> 00:05:23,500
!انتهيت

118
00:05:23,500 --> 00:05:24,840
نعم

119
00:05:24,140 --> 00:05:25,730
لكن من الرّياضيّات فقط

120
00:05:25,730 --> 00:05:28,460
أتريد القراءة قليلاً لتحليل الكتاب
كنوع من التّغيير؟

121
00:05:28,830 --> 00:05:30,170
أريد أن أنتهي

122
00:05:30,550 --> 00:05:31,010
استرخاء

123
00:05:30,610 --> 00:05:32,950
أنجزتُ كلّ المانغا في الأمس

124
00:05:32,950 --> 00:05:33,970
هل هذا محسوب؟

125
00:05:34,180 --> 00:05:34,890
تجاهل

126
00:05:34,240 --> 00:05:36,640
ماذا عن كتاب إيغاراشي-سينسي؟

127
00:05:36,950 --> 00:05:38,330
،رأينا الفيلم منذ مدّة ليست ببعيدة

128
00:05:38,330 --> 00:05:40,100
لذا بوسعك غالباً تخيُّل المشاهد بسهولة

129
00:05:40,360 --> 00:05:40,810
أوه

130
00:05:40,930 --> 00:05:43,300
!بوسعي كتابة تقرير يستند على الفيلم فقط

131
00:05:43,300 --> 00:05:46,320
لكن هناك فوارق كبيرة بين الكتاب
والفيلم، لذا سينكشف أمرك

132
00:05:46,760 --> 00:05:49,780
بوسعك كتابتها لي فحسب يا هاياتي-سان إذاً

133
00:05:50,390 --> 00:05:52,750
لكنّه كتاب جيّد. أريدك أن تقرأه

134
00:05:52,750 --> 00:05:55,240
أنا مشغول جدّاً بالرّياضة

135
00:05:55,240 --> 00:05:57,550
إذا ركّزت، بوسعك إكماله في نصف يوم

136
00:05:57,550 --> 00:05:59,400
سيستغرق معي عاماً حتماً

137
00:05:59,750 --> 00:06:00,410
مهلاً

138
00:06:00,710 --> 00:06:02,840
،بما أنّك لن تفعلها لأجلي

139
00:06:02,840 --> 00:06:04,990
فقد أسأل المصدر كي يخبرني بمجموعة أشياء

140
00:06:05,540 --> 00:06:06,710
المصدر؟

141
00:06:06,710 --> 00:06:07,620
موتوهارو-سان

142
00:06:08,630 --> 00:06:11,420
!لا يمكنك فعل ذلك، إنّه مشغول

143
00:06:12,270 --> 00:06:13,680
قال بأنّه سيأتي

144
00:06:13,680 --> 00:06:14,330
ماذا؟

145
00:06:14,330 --> 00:06:15,810
...إنّه مرن جدّاً

146
00:06:16,090 --> 00:06:18,630
شكراً على مساعدتك اليوم يا شيكي-كن

147
00:06:18,630 --> 00:06:20,120
!أتطلّع قدماً لذلك

148
00:06:20,120 --> 00:06:20,900
رائع

149
00:06:21,480 --> 00:06:24,040
انتهى ذلك سريعاً، ربّما سأعود إلى المقهى

150
00:06:28,540 --> 00:06:30,110
...الكثير من النّاس يرتدون اليوكاتا

151
00:06:30,110 --> 00:06:32,570
!تذكّرت

152
00:06:30,450 --> 00:06:32,580
!اليوم وغداً هو مهرجان الصّيف

153
00:06:32,580 --> 00:06:36,120
ينبغي أن أدعو شون وهاياتي-كن للمجيء
وتفقّد العربات معي في هذا المساء

154
00:06:36,120 --> 00:06:38,710
!موتوهارو-كن

155
00:06:39,360 --> 00:06:40,760
!سوما

156
00:06:40,760 --> 00:06:41,580
كيف الأحوال؟

157
00:06:41,580 --> 00:06:46,340
صديقان على السّريع

158
00:06:41,850 --> 00:06:43,180
تسرّني رؤيتك

159
00:06:43,180 --> 00:06:44,370
ماذا تفعل هنا؟

160
00:06:44,370 --> 00:06:45,680
هل ستلتقي بشخص؟

161
00:06:45,680 --> 00:06:46,320
لا

162
00:06:46,630 --> 00:06:49,340
ضللتُ طريقي ولم أعرف ماذا أفعل تالياً

163
00:06:47,680 --> 00:06:52,590
ها ها

164
00:06:49,340 --> 00:06:50,560
مُذهل

165
00:06:50,560 --> 00:06:52,590
لم أتوقّع أن تكون تائهاً

166
00:06:52,960 --> 00:06:54,280
لمَ لا تتفقّد الخريطة على هاتفك؟

167
00:06:54,280 --> 00:06:55,950
بطّاريته على وشك أن تنفد

168
00:06:55,950 --> 00:06:57,920
بقي ثلاثة بالمئة فقط

169
00:06:57,920 --> 00:07:00,890
أعتقد قد يكون موتوهارو-كن أحمق أيضاً

170
00:07:01,790 --> 00:07:02,690
عُدت

171
00:07:03,840 --> 00:07:04,980
شكراً على دعوتي

172
00:07:05,520 --> 00:07:06,960
انتهيت من عملك؟

173
00:07:06,960 --> 00:07:07,560
أجل

174
00:07:08,030 --> 00:07:09,820
،سمعتُ أنّ المقهى مُغلَق اليوم

175
00:07:09,820 --> 00:07:11,900
لذا أحضرتُ تشيزكيك

176
00:07:10,450 --> 00:07:16,040
خفقان قلب

177
00:07:11,900 --> 00:07:13,770
من فضلكم استمتعوا بذلك معاً

178
00:07:13,770 --> 00:07:16,030
مذهل، شكراً جزيلاً لك

179
00:07:16,280 --> 00:07:17,240
انحناء
انحناء

180
00:07:16,360 --> 00:07:18,120
،إيغاراشي-سينسي

181
00:07:18,120 --> 00:07:20,630
شكراً لك على المجيء إلى هنا
رغم جدول أعمالك المزدحم بالأعمال

182
00:07:20,980 --> 00:07:22,380
لا مشكلة على الإطلاق

183
00:07:22,380 --> 00:07:23,930
هل تعمل؟

184
00:07:23,930 --> 00:07:24,850
كنتُ كذلك

185
00:07:25,350 --> 00:07:28,800
شون، أنت تكتب تقرير كتاب عن روايتي؟

186
00:07:28,800 --> 00:07:29,720
أجل

187
00:07:29,720 --> 00:07:31,300
يسرّني سماع ذلك حقّاً

188
00:07:31,610 --> 00:07:33,770
—إذاً هل يمكنك أن تخبرني عنه و

189
00:07:33,770 --> 00:07:34,560
تفضّل

190
00:07:34,560 --> 00:07:35,270
ماذا؟

191
00:07:35,490 --> 00:07:37,220
اقرأه بنفسك

192
00:07:37,220 --> 00:07:39,970
لستُ لطيفاً بما يكفي للمساعدة في وظيفتك

193
00:07:42,230 --> 00:07:43,960
دعني أقرأه عندما تنتهي

194
00:07:43,960 --> 00:07:46,440
هاياتي-كن، إلى متى ستُبقي رأسك مُنحنياً؟

195
00:07:46,670 --> 00:07:49,290
أخبرتُك بأنّني لا أستطيع قراءة الكتُب

196
00:07:49,290 --> 00:07:51,440
من الوقاحة قول ذلك أمام مُؤلّف

197
00:07:51,440 --> 00:07:53,190
إن لم تكن عادة، فهذا صعب

198
00:07:53,570 --> 00:07:54,770
دعني أرى لبعض الوقت

199
00:07:54,770 --> 00:07:55,530
ماذا؟

200
00:07:55,920 --> 00:07:58,230
سأضع حِلية سحر عليه وذلك كي تُحفّزك

201
00:07:58,570 --> 00:08:00,190
!حقّاً؟ شكراً

202
00:08:00,750 --> 00:08:03,790
—سَخِرَ منّي للتو و

203
00:08:03,870 --> 00:08:04,790
إلى شون

204
00:08:03,870 --> 00:08:04,790
إيغاراشي
موتوهارو

205
00:08:03,870 --> 00:08:04,790
!حظّاً سعيداً

206
00:08:03,870 --> 00:08:05,880
المُفكّرة المفقودة
إيغاراشي موتوهارو

207
00:08:04,020 --> 00:08:04,800
تفضّل

208
00:08:04,800 --> 00:08:05,880
إلى شون

209
00:08:04,800 --> 00:08:05,880
إيغاراشي
موتوهارو

210
00:08:04,800 --> 00:08:05,880
!حظّاً سعيداً

211
00:08:04,800 --> 00:08:05,890
وقّعتُه

212
00:08:06,800 --> 00:08:08,280
مُذهل، أشعر بغيرة شديدة

213
00:08:08,280 --> 00:08:09,830
...أقصد، شكراً لكن

214
00:08:11,280 --> 00:08:12,640
ما الطريف في الأمر؟...

215
00:08:12,640 --> 00:08:13,670
أنا آسف

216
00:08:14,020 --> 00:08:19,030
كلّ ما في الأمر أنّ كلّاً من هاياتي-كن
،وموتوهارو-كن أتيا لمساعدتك في وظيفتك

217
00:08:19,030 --> 00:08:20,610
كما لو أنّهما أخوان أكبر سنّاً أو ما شابه

218
00:08:20,610 --> 00:08:22,630
جعلني ذلك أرى أنّ حماس أخيك
الأصغر كان ظريفاً

219
00:08:22,630 --> 00:08:24,240
!هذا ليس ظريفاً

220
00:08:24,240 --> 00:08:25,820
!لا تقل عنّي ظريف

221
00:08:25,820 --> 00:08:26,850
آسف

222
00:08:27,590 --> 00:08:31,450
لكن معك حقّ، أشعر وكأنّني محظوظ بوجودكم

223
00:08:32,620 --> 00:08:33,920
!شغوف للغاية

224
00:08:33,920 --> 00:08:34,860
!اصمت

225
00:08:35,110 --> 00:08:36,070
!فرقعة

226
00:08:35,420 --> 00:08:37,320
!سأقرأ هذا في غضون ثانية، لذا دعني بمفردي فحسب

227
00:08:37,700 --> 00:08:38,780
إنّه مقلوب

228
00:08:39,180 --> 00:08:41,840
هذا مُتعمّد! يمكنني القراءة هكذا أيضاً

229
00:08:41,840 --> 00:08:44,500
فهمت. يمكنك أن تعيد قلبه عندما يصبح ذلك صعباً

230
00:08:45,590 --> 00:08:46,860
أعادَ قلبه

231
00:08:48,020 --> 00:08:50,820
بالمناسبة، سيُقام مهرجان اليوم

232
00:08:50,820 --> 00:08:51,520
هل تعلمون؟

233
00:08:51,520 --> 00:08:53,150
لم نعلم

234
00:08:53,150 --> 00:08:54,730
ما رأيكم أن نتناول العشاء في العربات؟

235
00:08:54,730 --> 00:08:55,930
فكرة سديدة

236
00:08:55,930 --> 00:08:57,040
أريد تناول سوبا بالعجّة

237
00:08:57,320 --> 00:08:59,420
لمَ لا ندعو تاكايوكي أيضاً؟

238
00:08:59,710 --> 00:09:03,890
يبدو أنّ موتوهارو-سان لا يعمل
لأنّ ميما-سان يعمل

239
00:09:03,890 --> 00:09:04,940
أنا أعمل

240
00:09:05,960 --> 00:09:06,970
يبدو أنّهم مستمتعون

241
00:09:07,400 --> 00:09:09,230
هلّا اتّصل أحدكم بتاكايوكي؟

242
00:09:09,230 --> 00:09:11,340
!أجل! سأفعلها أنا

243
00:09:11,340 --> 00:09:12,100
ما رأيك؟

244
00:09:12,100 --> 00:09:12,940
ماذا؟

245
00:09:12,940 --> 00:09:15,470
أتعتقد أنّك ستتمكّن من فعل
شيء مذهل في استراحة الصّيف هذه؟

246
00:09:15,990 --> 00:09:17,000
إطلاقاً

247
00:09:17,000 --> 00:09:17,730
ماذا؟

248
00:09:18,240 --> 00:09:21,900
لكن الأيّام كهذه حيث لا يحدث شيء مُميّز مُمتعة أيضاً

249
00:09:22,260 --> 00:09:23,170
هذا جيّد بما يكفي

250
00:09:24,830 --> 00:09:27,880
يجدر بك أن تطلب شمعات للكيك
الخاص بعيد ميلادك العام المقبل أيضاً

251
00:09:27,880 --> 00:09:28,650
ماذا؟

252
00:09:28,650 --> 00:09:30,990
!لماذا عدنا إلى هذا الموضوع؟

253
00:11:01,010 --> 00:11:06,010
الحلقة القادمة

254
00:11:06,020 --> 00:11:11,010
!نأمل أن تتابعونا ثانية