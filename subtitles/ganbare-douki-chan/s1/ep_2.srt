1
00:00:15,140 --> 00:00:16,990
.أرسلت إليك الملف للتوّ

2
00:00:17,560 --> 00:00:19,160
.حسنان سأقوم بمراجعته

3
00:00:26,680 --> 00:00:29,090
.لم يقم بأي حركة تجاهي حقا

4
00:00:29,610 --> 00:00:33,780
ألا يراني كشريك حبّ محتمل؟

5
00:00:33,780 --> 00:00:34,920
ألديك لحظة؟

6
00:00:34,920 --> 00:00:36,460
ماذا؟

7
00:00:37,570 --> 00:00:39,560
.كنت أتساءل بخصوص هذا الجزء

8
00:00:43,230 --> 00:00:44,420
فهمت

9
00:00:44,420 --> 00:00:47,370
أعتقد أنني إن قمت بتعديله فسيمنحنا ذلك
.فسحة في الجدول

10
00:00:47,370 --> 00:00:48,690
.فهمت

11
00:01:11,780 --> 00:01:13,920
أنا وزميل عملي كنّا في المصعد مع بعض

12
00:01:13,920 --> 00:01:16,570
.ثمّ علقنا في الداخل مع بعض

13
00:01:18,890 --> 00:01:21,260
!لماذا توقّف؟

14
00:01:21,260 --> 00:01:22,180
.لا تقلقي

15
00:01:28,950 --> 00:01:30,040
...حسنا

16
00:01:35,330 --> 00:01:38,380
.عفوًا. لقد توقّف المصعد

17
00:01:40,740 --> 00:01:43,790
.في العادة لا يمكن الاعتماد عليه

18
00:01:46,530 --> 00:01:48,500
...لكن هذا ما يميّزه

19
00:01:49,460 --> 00:01:51,340
.قالوا أنه علينا الانتظار لبعض الوقت

20
00:01:52,890 --> 00:01:53,880
.حسنا

21
00:02:02,550 --> 00:02:03,530
هل أنت بخير؟

22
00:02:03,880 --> 00:02:04,800
...أجل

23
00:02:10,160 --> 00:02:13,070
.أشعر بالبرد

24
00:02:13,770 --> 00:02:16,560
هل يمكنني الاقتراب قليلا؟

25
00:02:27,860 --> 00:02:30,040
!ا-انتظر

26
00:02:39,390 --> 00:02:40,750
.لقد تحرّك

27
00:02:48,440 --> 00:02:51,810
!أحسنتم في الصمود

28
00:02:52,440 --> 00:02:55,030
!لا بدّ أنّ الأمر كان فظيعا

29
00:02:54,260 --> 00:02:55,440
...انتظري

30
00:02:57,550 --> 00:02:59,270
...أجل

31
00:04:58,110 --> 00:05:01,860
!أبقي يديك بعيدتين عنه