1
00:00:00,800 --> 00:00:02,470
،بإضافة فاكهة رويلي

2
00:00:02,780 --> 00:00:05,720
جمعتْ روزيماين بنجاح كافّة المواد

3
00:00:06,260 --> 00:00:08,170
...في هذه الأثناء

4
00:00:11,030 --> 00:00:12,180
اسمعوا جيّداً

5
00:00:12,180 --> 00:00:17,990
استدعوا ويلفريد-ساما للّعب وإرشاده إلى البرج
الأبيض في أعماق الغابة

6
00:00:17,990 --> 00:00:22,050
لكن يجب عليكم ألّا تدخلوا أبداً. مفهوم؟

7
00:00:22,050 --> 00:00:23,120
!أجل

8
00:00:23,370 --> 00:00:26,050
!سنبدأ الآن بمُنافسة الصّيد

9
00:00:48,450 --> 00:00:54,250
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

10
00:02:05,980 --> 00:02:10,980
الحلقة 22
أفعال ويلفريد

11
00:02:13,230 --> 00:02:16,480
كان الجميع مسرورين بأنّ الحصاد أفضل
من العام الماضي

12
00:02:16,480 --> 00:02:19,230
فهمت. شكراً على عملكم الدّؤوب

13
00:02:19,870 --> 00:02:21,530
الكهنة ذوو الرِّداء الأزرق

14
00:02:21,530 --> 00:02:23,990
الّذين حضروا مهرجانَ الحصاد في أراضي
الغيبي المُتنوّعين

15
00:02:23,990 --> 00:02:26,250
عادوا وبحوزتهم الكؤوس المُقدّسة الصّغيرة

16
00:02:26,730 --> 00:02:30,120
بعد جمع معلومات عن الحصاد
،ووضع كُلّ منطقة

17
00:02:30,120 --> 00:02:32,380
أريد إبلاغ الأوب

18
00:02:32,660 --> 00:02:34,250
...بعد ذلك

19
00:02:34,610 --> 00:02:39,040
حالما ننتهي من التّقرير عن مهرجان
الحصاد، سنبدأ بصنع اليوريفي

20
00:02:39,550 --> 00:02:41,380
!مرحى

21
00:02:48,390 --> 00:02:49,600
من فضلكِ ضعي هذه هناك

22
00:02:49,600 --> 00:02:52,150
...تلك الغرفة المُجاورة لغرفتي

23
00:02:52,150 --> 00:02:54,570
تلك هي الأميرة تشارلوت

24
00:02:54,570 --> 00:02:59,370
،سيتمّ تعميدها في هذا الشّتاء
لذا يحضّرون غرفتها

25
00:03:04,330 --> 00:03:07,540
m 0 0 l 200 0 200 40 0 40

26
00:03:04,330 --> 00:03:07,540
الابنة الثّانية لسيلفيستر
تشارلوت

27
00:03:05,430 --> 00:03:07,530
!أختي الكبرى روزيماين

28
00:03:09,120 --> 00:03:13,420
أختي الكبرى"؟"

29
00:03:15,070 --> 00:03:18,290
هلّا ألقيتُ عليكِ التّحيّة؟

30
00:03:19,950 --> 00:03:22,300
أجل، بالطّبع

31
00:03:23,550 --> 00:03:29,950
في هذا اليوم المُثمِر المحميّ بواسطة
،شوتزاريا، إلَهة الرّياح

32
00:03:28,380 --> 00:03:31,000
،بما أنّ تشارلوت لم يتمّ تعميدها

33
00:03:29,950 --> 00:03:32,960
هل لي أن أصلِّي طلباً لتحلّ البرَكة على هذا
الاجتماع الّذي تُرشده الآلهة؟

34
00:03:31,000 --> 00:03:34,320
لا يمكنها الصّلاة طلباً لبرَكات حقيقيّة بعد

35
00:03:32,960 --> 00:03:34,320
يمكنكِ ذلك

36
00:03:34,320 --> 00:03:40,830
.أنا تشارلوت، ابنة أوب إيرينفيست
من دواعي سروري أن ألتقي بكِ

37
00:03:40,830 --> 00:03:43,590
أهلاً بكِ يا تشارلوت

38
00:03:43,590 --> 00:03:45,710
أنا أختكِ الكُبرى

39
00:03:46,060 --> 00:03:50,570
!أنا سعيدةٌ للغاية! لطالما أردتُ أُختاً كُبرى

40
00:03:52,100 --> 00:03:54,830
آمل أن نتمكّن من الانسجام من الآن فصاعداً

41
00:03:55,060 --> 00:03:57,720
!تشارلوت ظريفة للغاية

42
00:03:57,720 --> 00:04:00,360
!إنّها الملاك الثّاني الّتي ألتقي به بعد تولي

43
00:04:00,360 --> 00:04:03,850
أختي روزيماين، ألستِ كبيرة الأساقفة أيضاً؟

44
00:04:04,310 --> 00:04:08,350
هل ستكونين من يمنح البرَكات أثناء
مراسم تعميدي؟

45
00:04:08,350 --> 00:04:11,040
أنتِ أختي الصُّغرى الظّريفة في نهاية المطاف

46
00:04:11,040 --> 00:04:13,480
سأكون أنا من يمنح برَكاتكِ

47
00:04:13,740 --> 00:04:16,130
!أتطلّع بلهفةٍ لذلك

48
00:04:16,130 --> 00:04:22,230
أيّتها الأميرتان الصّغيرتان، لِمَ لا تستأنفان
مُحادثكما لاحقاً مع بعض الشّاي؟

49
00:04:23,460 --> 00:04:24,620
!أجل

50
00:04:24,880 --> 00:04:30,110
وهكذا، وعدتُ تشارلوت بأنّني سوف
!أُشرِف على مراسم تعميدها

51
00:04:33,050 --> 00:04:37,870
يُفترض بكِ أن تبلغي عن مهرجان
الحصاد أيّتها الحمقاء

52
00:04:39,520 --> 00:04:41,010
...أجل

53
00:04:41,270 --> 00:04:44,380
بعد أن انتهيتُ التّقرير، انصرفَ الجميع

54
00:04:46,900 --> 00:04:49,890
...روزيماين، بخصوص طريقة ضغط المانا خاصّتكِ

55
00:04:51,520 --> 00:04:55,560
وُعِدتُ بأنّنا سوف نصنع اليوريفي
بعد مهرجان الحصاد

56
00:04:55,560 --> 00:04:58,270
سأعلّمك الطّريقةَ بعد أن نصنع اليوريفي

57
00:04:58,480 --> 00:05:01,900
لا بأس بالنّسبة لصنعه، لكن يجب
عليكِ استخدامه في وقتٍ لاحق

58
00:05:02,180 --> 00:05:03,530
ما السّبب؟

59
00:05:03,730 --> 00:05:08,190
سيُسبّب اليوريفي لك نوماً من عشرة
...أيّام إلى شهر

60
00:05:08,190 --> 00:05:11,100
بل وموسماً كاملاً بحسب ظروفك

61
00:05:11,100 --> 00:05:13,770
،إذا كنتِ ستُشرفين على تعميد تشارلوت

62
00:05:13,770 --> 00:05:15,410
فسيكون من الأفضل التوقُّف حاليّاً

63
00:05:16,920 --> 00:05:20,290
...فهمت. إذاً، بعد التّعميد

64
00:05:20,290 --> 00:05:21,590
لا، لحظة

65
00:05:22,270 --> 00:05:25,190
بعد التّعميد، هناك موسم الشّتاء الاجتماعيّ

66
00:05:25,190 --> 00:05:27,600
مراسم التّكريس، وصلاة الرّبيع

67
00:05:27,600 --> 00:05:30,040
استخدمي اليوريفي بعد صلاة الرّبيع

68
00:05:32,170 --> 00:05:33,870
!لا

69
00:05:33,870 --> 00:05:38,060
!صحّتي تبتعد أكثر فأكثر

70
00:05:38,400 --> 00:05:42,510
إذاً، لن أعلّم الآخرين كيفيّة ضغط
المانا خاصّتي قبل ذلك الحين

71
00:05:43,190 --> 00:05:46,310
سوف أصبح فتاة عاديّة

72
00:05:52,590 --> 00:05:57,770
تريدين إظهار جانبكِ الجيّد لأختكِ
الصّغرى كأخت كُبرى؟

73
00:05:57,770 --> 00:05:58,830
هذا صحيح

74
00:05:59,080 --> 00:06:02,910
إذاً، إن لم يقتصر الأمر على منحكِ برَكاتكِ
،أثناء مراسم التّعميد

75
00:06:02,910 --> 00:06:06,220
وشرحتِ لتشارلوت كيف تُساهمين
في دوقيّة إيرينفيست

76
00:06:06,480 --> 00:06:10,970
بصفة ابنة الحاكم بالتبنّي في مراسم
،التّكريس وصلاة الرّبيع

77
00:06:10,970 --> 00:06:13,300
ألن يُكسبكِ ذلك احتراماً أكبر حتّى؟

78
00:06:14,670 --> 00:06:19,860
ألا تعتقدين بأنّ ذلك يُلائم الأخت
الكُبرى في عائلة الأرشيدوق؟

79
00:06:19,860 --> 00:06:21,240
!أجل

80
00:06:21,240 --> 00:06:24,120
إذاً، اعملي بجدّ حتّى صلاة الرّبيع

81
00:06:24,120 --> 00:06:25,100
!حسناً

82
00:06:27,870 --> 00:06:28,990
ماذا؟

83
00:06:29,240 --> 00:06:34,090
روزيماين، يمكنكِ الانصراف. اعتني بتشارلوت

84
00:06:34,090 --> 00:06:35,710
!حسناً

85
00:06:44,990 --> 00:06:49,260
صنعتِ الكاروتا والكُتُب المُصوَّرة
للنّصوص المُقدّسة، أليس كذلك؟

86
00:06:49,260 --> 00:06:51,000
كانت رائعة بحقّ

87
00:06:51,000 --> 00:06:53,440
شكراً لكِ يا تشارلوت

88
00:06:54,000 --> 00:06:58,510
ماذا يجدر بي أن أفعل؟ أتلقّى مديحاً
!بواسطة أختي الصُّغرى الظّريفة

89
00:07:01,650 --> 00:07:05,270
هل فكّرتِ في هذه الحلويّات كذلك
يا أختي الكُبرى؟

90
00:07:05,730 --> 00:07:07,660
!إنّها شهيّةٌ جدّاً

91
00:07:09,270 --> 00:07:11,740
أوتّيلّي، لُفّي هذه لأجلها

92
00:07:11,740 --> 00:07:13,290
عُلِم

93
00:07:13,290 --> 00:07:16,030
...لم أقصد أن

94
00:07:16,030 --> 00:07:20,540
هذه مشاعري. اقبليها رجاء يا تشارلوت

95
00:07:23,260 --> 00:07:24,550
دامويل

96
00:07:24,550 --> 00:07:28,970
روزيماين-ساما، يريد ويلفريد-ساما
دخول الغرفة

97
00:07:28,970 --> 00:07:30,240
...يريد التكلُّم مع تشارلوت-ساما

98
00:07:30,240 --> 00:07:31,470
!ويلفريد-ساما

99
00:07:32,880 --> 00:07:36,150
!تشارلوت! غادري هذه الغرفة فوراً

100
00:07:36,150 --> 00:07:38,180
!يجب ألّا تدعي روزيماين تخدعكِ

101
00:07:38,420 --> 00:07:39,710
ماذا تقول؟

102
00:07:40,040 --> 00:07:43,790
أخي، ما الّذي تقوله فجأة؟

103
00:07:43,790 --> 00:07:47,680
بالفعل... كُفّ عن إطلاق اتِّهامات باطلة رجاء

104
00:07:47,680 --> 00:07:49,510
!لا تدّعي الجهل

105
00:07:49,510 --> 00:07:51,690
!لا تفعل! توقّف أرجوك

106
00:07:50,400 --> 00:07:51,370
!هذا سيّئ

107
00:07:56,900 --> 00:07:59,370
!مؤلم! ماذا تفعلين؟

108
00:07:59,370 --> 00:08:01,130
لم تتلقّ إذناً بعد لدخول الغرفة

109
00:08:01,130 --> 00:08:03,920
من فضلك لا تقترب من روزيماين-ساما

110
00:08:03,920 --> 00:08:05,290
!أفلتيني

111
00:08:05,550 --> 00:08:09,540
كفارِسة حارسة، لا أستطيع السّماح
لشخص مشبوه بالدّخول

112
00:08:09,770 --> 00:08:14,160
!الشّخص المشبوه هنا هي روزيماين
!سمعتُ كُلَّ شيء

113
00:08:14,160 --> 00:08:17,420
!روزيماين وفيرديناند لفّقوا تُهماً للآخرين

114
00:08:17,420 --> 00:08:19,490
!كلاهما شرّيران

115
00:08:19,490 --> 00:08:23,440
أخي ويلفريد، مِمَن سمعتَ ذلك؟

116
00:08:23,440 --> 00:08:25,030
!من جدّتي

117
00:08:25,030 --> 00:08:27,060
!سمعتُ ذلك بشكل مُباشر من جدّتي

118
00:08:30,200 --> 00:08:35,450
لكن أليست جدّة أخي محبوسة حاليّاً؟

119
00:08:35,770 --> 00:08:37,130
!متى؟

120
00:08:37,400 --> 00:08:40,290
!متى تكلّمت مع فيرونيكا-ساما؟

121
00:08:40,290 --> 00:08:42,650
!أجِب من فضلك يا ويلفريد-ساما

122
00:08:42,650 --> 00:08:48,660
هل اللِّقاء بجدّتي هو أمرٌ جلَل إلى هذا الحدّ؟

123
00:08:49,230 --> 00:08:50,230
...أجل

124
00:08:51,000 --> 00:08:52,660
...أخي

125
00:08:53,360 --> 00:08:56,600
ريهياردا. استدعي الأوب رجاء

126
00:08:56,600 --> 00:08:58,750
عُلِم يا سموّ الأميرة

127
00:09:00,940 --> 00:09:04,700
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

128
00:09:07,240 --> 00:09:10,950
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

129
00:09:18,740 --> 00:09:21,580
هناك طُرُق مُختلفة للنّظر إلى شيء

130
00:09:21,850 --> 00:09:25,970
يجب علينا أن نكشف عن كُلّ شيء
قبل أن نتمكّن من الحُكم

131
00:09:26,390 --> 00:09:29,830
يجب أن تفهم بأنّ الكذِب سيُعَدّ جريمة

132
00:09:30,150 --> 00:09:34,210
ويلفريد، متى التقيتَ بأمِّي؟

133
00:09:34,440 --> 00:09:37,210
أثناء مُنافسة الصّيد يا أبي

134
00:09:40,620 --> 00:09:43,220
مُنافسة الصّيد؟

135
00:09:43,220 --> 00:09:46,360
إنّه صيدٌ يجري في غابة القلعة

136
00:09:46,360 --> 00:09:48,970
أثناء الفترة الّتي تُسافرين فيها عادةً
من أجل مهرجان الحصاد

137
00:10:05,440 --> 00:10:07,880
لعبة الالتقاط هذه تؤدّي أيضاً
غرض توفير طعام للشّتاء

138
00:10:08,240 --> 00:10:11,130
،وهناك مُكافآت على عدد الحيوانات المُصطادة

139
00:10:11,130 --> 00:10:13,600
لذا فهو حدثٌ يتحمّس له الفُرسان دوماً

140
00:10:14,020 --> 00:10:17,750
ألم تكُن مع فلورينشيا أثناء مُنافسة الصّيد؟

141
00:10:18,020 --> 00:10:20,340
...كنتُ معها حتّى مُنتصف الطّريق

142
00:10:20,630 --> 00:10:24,070
كنتُ سعيداً جدّاً برؤية أصدقائي
من قاعة اللّعب ثانية

143
00:10:24,070 --> 00:10:26,090
لدرجة أنّنا انغمسنا في المُحادثة

144
00:10:26,470 --> 00:10:27,710
...إذاً

145
00:10:28,020 --> 00:10:30,420
هل نلعب الغُمّيضة؟

146
00:10:30,420 --> 00:10:33,800
يمكننا المُنافسة لنرَ من يستطيع عبور

147
00:10:33,800 --> 00:10:37,520
ساحة حفلة الشّاي بشكل أسرع
دون أن يراه البالغون

148
00:10:37,810 --> 00:10:39,460
يبدو ذلك مُمتعاً

149
00:10:39,460 --> 00:10:40,780
!حسناً. لنتنافس

150
00:10:42,440 --> 00:10:47,510
كنّا نتسلّل من تحت الطّاولات وذلك
كي لا يرانا البالغون

151
00:10:48,090 --> 00:10:50,140
حينئذ سمعتُ ذلك

152
00:10:50,950 --> 00:10:55,840
يبدو أنَّ الابنة المُتبنّاة بواسطة الأرشيدوق كانت
مُتورِّطة في عمليّة أسر فيرونيكا-ساما

153
00:10:55,840 --> 00:10:57,680
هل يتحدّث عن روزيماين؟

154
00:10:57,680 --> 00:11:00,060
وفيرديناند-ساما كذلك، صحيح؟

155
00:11:00,060 --> 00:11:01,230
أنت مُخطئ

156
00:11:01,230 --> 00:11:02,800
!ويلفريد-ساما

157
00:11:03,040 --> 00:11:05,870
طلبَ خالُ أبي من جدّتي

158
00:11:05,870 --> 00:11:08,180
استخدام ختم الأرشيدوق دون إذن

159
00:11:08,180 --> 00:11:11,650
اتُّهِمَتْ وعوقِبَتْ بجرم دعوة نبيل
من دوقيّة أُخرى إلى البلدة

160
00:11:11,650 --> 00:11:13,310
عندما كان ذلك مُحرَّماً

161
00:11:13,560 --> 00:11:16,050
هذا ما أخبرني به أبي

162
00:11:16,050 --> 00:11:18,070
...هذا صحيح

163
00:11:18,070 --> 00:11:22,220
لكن كانت روزيماين-ساما السّبب في ارتكابها
جريمة كهذه في المقام الأوّل

164
00:11:22,220 --> 00:11:26,050
وكان فيرديناند-ساما العقل المُدبِّر
وراء الكواليس

165
00:11:26,050 --> 00:11:31,450
ذلكما الاثنان يحاولان احتكار إيرينفيست
لنفسيهما يا ويلفريد-ساما

166
00:11:31,750 --> 00:11:32,960
!كذِب

167
00:11:33,750 --> 00:11:36,430
،إن سألتَ فيرونيكا-ساما بشكل مُباشر

168
00:11:36,430 --> 00:11:40,090
فقد تتمكّن من اكتشاف حقيقة الأمر؟

169
00:11:40,090 --> 00:11:44,340
حسبما أذكُر، فيرونيكا-ساما محبوسة
حاليّاً في البرج الأبيض

170
00:11:44,340 --> 00:11:46,130
البرج الأبيض؟

171
00:11:46,130 --> 00:11:47,850
سمعتُ أنّه كائن في أعماق الغابة

172
00:11:47,850 --> 00:11:50,360
!لنذهب ونلقِ نظرة يا ويلفريد-ساما

173
00:11:50,360 --> 00:11:51,980
!لنستكشف

174
00:11:52,390 --> 00:11:54,340
نستكشف؟

175
00:11:54,850 --> 00:11:55,850
حسناً

176
00:12:02,570 --> 00:12:05,110
...دخلنا الغابةَ كما لو أنّها مُغامرة و

177
00:12:06,180 --> 00:12:07,850
أليس ذلك هو؟

178
00:12:09,710 --> 00:12:13,910
...هذا هو البرج الأبيض

179
00:12:15,490 --> 00:12:17,570
إنّه هنا بالفعل

180
00:12:32,740 --> 00:12:37,160
لا يمكن أن يُفتَح هذا الباب إلّا بواسطة
الأرشيدوق أو سليليه

181
00:12:37,160 --> 00:12:38,770
لا يستطيع أيّ أحد آخر الدُّخول

182
00:12:52,610 --> 00:12:57,660
كما قال، فُتِح الباب فعلاً عندما حاولتُ فتحه

183
00:12:58,980 --> 00:13:01,370
...ثمّ انتهى المطاف بك بالدّخول

184
00:13:02,600 --> 00:13:05,010
أمست الأمور مُزعجة

185
00:13:05,010 --> 00:13:08,010
لهذا طلبتُ منك حرمانه من الميراث

186
00:13:08,330 --> 00:13:09,880
مُزعجة؟

187
00:13:10,760 --> 00:13:12,890
من دخلَ أيضاً؟

188
00:13:12,890 --> 00:13:14,330
أنا فقط

189
00:13:14,330 --> 00:13:20,150
كانت جدّتي محبوسة في ذلك البرج
وأخبرَتْني بالحقيقة

190
00:13:20,380 --> 00:13:25,130
سبب حبس جدّتي ومُعاناتها
في مكان كهذا

191
00:13:25,900 --> 00:13:29,280
!هو روزيماين وفيرديناند

192
00:13:32,040 --> 00:13:36,060
...أبي، أتوسّل إليك. أنقذ جدّتي أرجـ

193
00:13:36,610 --> 00:13:37,640
!لا تقلها

194
00:13:37,640 --> 00:13:39,530
!لا يجوز أن تُكمل هذه الجملة

195
00:13:39,530 --> 00:13:41,790
!لا ترتكب أيّ جريمة إضافيّة

196
00:13:43,090 --> 00:13:44,480
جريمة؟

197
00:13:44,480 --> 00:13:46,920
هل ارتكبتُ جريمة؟

198
00:13:47,170 --> 00:13:48,340
هذا صحيح

199
00:13:48,340 --> 00:13:50,550
يُستخدَم البرج لحبس أعضاء الأرشيدوق

200
00:13:50,550 --> 00:13:54,410
الّذين ارتكبوا جرائمَ خطيرة

201
00:13:54,410 --> 00:13:59,680
!والدّخول دون إذن الأوب يُعدّ خيانة

202
00:13:59,890 --> 00:14:00,690
!ماذا؟

203
00:14:00,980 --> 00:14:01,800
!ماذا؟

204
00:14:02,680 --> 00:14:05,940
...لم يخبرني أحدٌ بشيء كهذا

205
00:14:06,270 --> 00:14:08,450
تمّ تضليلك

206
00:14:08,450 --> 00:14:09,860
تضليلي؟

207
00:14:09,860 --> 00:14:13,610
كانت لعبة الغُمّيضة بحدِّ ذاتها
ذريعة لاستدراجك

208
00:14:13,610 --> 00:14:16,320
إلى إعادة لمّ شمل جماعة فيرونيكا السّابقة

209
00:14:16,660 --> 00:14:18,320
...مُستحيل

210
00:14:18,320 --> 00:14:22,970
تذكّرتُ ما قالته ريهياردا ذات مرّة لي

211
00:14:22,970 --> 00:14:28,180
لا تنسي بأنّ هناك آباء وأُمّهات
يقِفون خلف كُلّ أولئك الأطفال

212
00:14:28,540 --> 00:14:32,510
...لـ-لكن، كانت روزيماين هي من خطّطت

213
00:14:32,510 --> 00:14:39,400
كانت فيرونيكا-ساما من خطّطتْ وسبّبتْ
فوضى داخل الدّوقيّة يا ويلفريد

214
00:14:40,530 --> 00:14:42,900
عمّاذا تتكلّمين يا أُمّي؟

215
00:14:43,240 --> 00:14:48,280
أمِّي وخالي ارتكبا جرائمَ وحاولا
أذيّة روزيماين

216
00:14:48,530 --> 00:14:52,770
تبنّيتُها من أجل حمايتها

217
00:14:52,770 --> 00:14:53,790
ماذا؟

218
00:14:54,170 --> 00:14:57,710
هناك حقائق كثيرة بعدد البشر

219
00:14:57,710 --> 00:15:00,670
روزيماين، أخبريه بحقيقتكِ

220
00:15:02,970 --> 00:15:04,720
قبل ذلك الحين، كنتُ

221
00:15:04,720 --> 00:15:07,940
أصنع كُتُباً في الكاتدرائيّة مع سُكّان
المدينة السُّفليّة

222
00:15:08,490 --> 00:15:11,090
تكلّمتُ طبقاً للخلفيّة القصصيّة الّتي نسجناها

223
00:15:11,090 --> 00:15:14,060
عندما أصبحتُ الابنة المُتبنّاة بواسطة الأرشيدوق

224
00:15:14,060 --> 00:15:18,700
حالما قُرِّرَ بأنّني سأُصبح ابنة
،الأرشيدوق بالتبنِّي

225
00:15:18,700 --> 00:15:22,120
مُنِعتُ من الذّهاب إلى المدينة السُّفليّة
أو التّفاعل مع النّاس هناك

226
00:15:22,120 --> 00:15:25,010
...كانت هناك أشياء أُخرى أُخِذَتْ منّي، لكن

227
00:15:25,010 --> 00:15:27,040
فقدتُ حُرّيتي

228
00:15:27,460 --> 00:15:30,070
هذه هي روايتي عن الحقيقة

229
00:15:30,360 --> 00:15:31,610
...هذا مُختلف

230
00:15:32,130 --> 00:15:35,580
!مُختلف عمّا أخبرتني به جدّتي

231
00:15:35,580 --> 00:15:40,390
،غير أنّك صدّقتَ تِلك الرّواية وأهنتَ روزيماين

232
00:15:40,390 --> 00:15:42,830
ودخلتَ البرجَ المُحرَّم

233
00:15:43,180 --> 00:15:46,220
هل أنت مُستعدّ لمُواجهة عقوبتك؟

234
00:15:46,680 --> 00:15:47,970
...عقوبة

235
00:15:48,620 --> 00:15:51,250
سيكون من المُناسب حرمانه
من الميراث وإرساله

236
00:15:51,250 --> 00:15:53,710
إلى الكاتدرائيّة أو حبسه داخل البرج

237
00:16:00,230 --> 00:16:03,470
...كنتُ قد تمكّنتُ أخيراً من إعادتك إلى حضني

238
00:16:03,940 --> 00:16:06,230
...حرمان من الميراث

239
00:16:06,480 --> 00:16:07,990
...أخي

240
00:16:09,590 --> 00:16:12,730
هنا يجب عليّ أن أبذل قصارى
...جهدي كأخت كُبرى

241
00:16:13,240 --> 00:16:17,700
أبي، تمّ تحريض أخي ويلفريد
!على فعل مثل هذه الأشياء

242
00:16:17,700 --> 00:16:22,370
...لو كنتُ مكانه، لفعلتُ الشّيء ذاته رُبّما

243
00:16:22,620 --> 00:16:27,880
لأنّ، بالنّسبة لأخي، فيرونيكا-ساما
فرد هامّ في عائلته

244
00:16:28,120 --> 00:16:29,650
عائلة؟

245
00:16:29,650 --> 00:16:31,750
أنتِ ساذجةٌ حقّاً

246
00:16:32,170 --> 00:16:36,130
،أبي، لا أنكر بأنّ أخي دخلَ البرج

247
00:16:36,130 --> 00:16:38,380
إلّا أنّه كان من الواضح أنّ هذا
نتيجة التحكُّم به

248
00:16:38,380 --> 00:16:41,010
رغم ذلك، هل ما زال سيُتَّهم بجريمة؟

249
00:16:44,870 --> 00:16:49,880
عقب ذلك، ناقشنا ما يجب فعله
بشأن أخي ويلفريد

250
00:16:50,620 --> 00:16:52,360
هذا صعب

251
00:16:52,360 --> 00:16:54,040
لماذا؟

252
00:16:54,290 --> 00:16:58,780
كان كثير من النّاس مُتورِّطين ولا نعرف
نوايا العدوّ

253
00:16:59,230 --> 00:17:04,030
،وأيضاً، حالما تُفتَح أبواب البرج
يستطيع الآخرون الدّخول

254
00:17:04,030 --> 00:17:05,580
!أحقّاً ذلك؟

255
00:17:05,580 --> 00:17:06,660
أجل

256
00:17:06,660 --> 00:17:11,910
لكن، لم يأتِ أحد لإنقاذ جدّتك السّجينة

257
00:17:14,030 --> 00:17:18,060
فقط عدد محدود من النّاس عَلِموا
بوجود البرج من الأساس

258
00:17:18,480 --> 00:17:22,760
،البرج محميّ بواسطة حاجز
لذا لا يوجد حُرّاس مُتمركِزون هناك

259
00:17:27,070 --> 00:17:28,760
توقّعتُ بأنّ

260
00:17:28,760 --> 00:17:33,680
جماعة فيرونيكا السّابقة أرادت جعل
ويلفريد رئيسهم الصُّوريّ الجديد

261
00:17:33,680 --> 00:17:38,180
إن كان الأمر كذلك، فإنّ إخباره بالوضع الرّاهن

262
00:17:38,180 --> 00:17:40,890
للجدّة المُولعة به سيكون فعّالاً

263
00:17:40,890 --> 00:17:43,610
تكتيك نفسيّ لخلق شقّ بينه وبين والديه

264
00:17:45,060 --> 00:17:48,580
لكن، على هذا المُعدّل، سيُحرَم
من الميراث أو يُعدَم

265
00:17:49,040 --> 00:17:52,830
يبدو أنّ الهدف الحقيقيّ هنا
هو القضاء على ويلفريد

266
00:17:52,830 --> 00:17:54,040
،في هذه الحالة

267
00:17:54,040 --> 00:17:57,080
ألن يكون من الأفضل القضاء عليه
في اللّحظة الّتي يُؤخذ فيها بعيداً؟

268
00:17:58,770 --> 00:18:05,730
رُبّما سقوط ويلفريد هو تمهيد والخطّة
الحقيقيّة ستبدأ بعد ذلك؟

269
00:18:07,860 --> 00:18:10,290
ما غايتهم؟

270
00:18:11,230 --> 00:18:13,680
من الواضح أنّها مُضايقة

271
00:18:14,430 --> 00:18:15,780
مُضايقة؟

272
00:18:15,780 --> 00:18:17,020
هذا صحيح

273
00:18:17,020 --> 00:18:19,500
كما ترى، سبّبَ ذلك شرخاً في عائلتنا

274
00:18:19,500 --> 00:18:23,740
وأبي مُنهمكٌ في التّفكير حاليّاً بشأن
ما يجب فعله بخصوص أخي

275
00:18:23,740 --> 00:18:28,250
لكن، مهما فعلنا، ستكون هناك
شكاوى من النُّبلاء

276
00:18:28,250 --> 00:18:34,140
رغم ذلك، لا يمكننا تحمُّل فقدان المانا
من مُعاقبة كافّة النُّبلاء المُتورِّطين

277
00:18:34,140 --> 00:18:36,300
من الخطير أيضاً ترك الأمور على حالها

278
00:18:36,300 --> 00:18:39,760
مهما حدث، لن يكون ذلك جيّداً
بالنّسبة لإيرينفيست

279
00:18:40,040 --> 00:18:44,010
بصيغة أُخرى... أعتقد بأنّ هذه
مُضايقة من خارج الدّوقيّة

280
00:18:44,010 --> 00:18:45,540
...هكذا إذاً

281
00:18:45,540 --> 00:18:49,670
هذا ليس صِراعاً بين النُّبلاء، إنّما
مُضايقة من الخارج

282
00:18:49,670 --> 00:18:52,520
أنتِ ذكيّةٌ بشكل مُفاجئ

283
00:18:52,520 --> 00:18:53,700
بشكل مُفاجئ؟

284
00:18:53,700 --> 00:18:58,470
إن كان الأمر كذلك، فهل غايتهم هو إلحاق
ضرر بسُلطة الأرشيدوق؟

285
00:18:58,470 --> 00:19:02,540
أو رُبّما يحاولون إضعاف مُستوى
المانا في إيرينفيست

286
00:19:03,130 --> 00:19:06,040
في تلك الحالة، فإنّ استبعاد أخي

287
00:19:06,040 --> 00:19:10,780
أو مُعاقبة النُّبلاء المُتورِّطين سوف يُرضي
فقط الطّرفَ الآخر

288
00:19:11,120 --> 00:19:14,290
حاليّاً، أعتقد يجدر بنا الحِفاظ
على الوضع الرّاهن

289
00:19:14,290 --> 00:19:18,800
وجمع معلومات وذلك كي نتمكّن من التّفكير
في أفضل طريقة للتّعامُل مع الوضع

290
00:19:18,800 --> 00:19:20,540
...أختي

291
00:19:20,780 --> 00:19:24,910
لا، لا يمكننا إنهاء هذه القضيّة
دون أيّ تأديب

292
00:19:24,910 --> 00:19:27,990
التخلُّص من ويلفريد حاجةٌ مُلِحّة

293
00:19:30,950 --> 00:19:33,930
أريد إثارة إعجاب تشارلوت

294
00:19:33,930 --> 00:19:36,530
!فكِّري في شيء يا أنا

295
00:19:39,840 --> 00:19:41,690
!هذا صحيح! وجدتُها

296
00:19:42,060 --> 00:19:45,320
إذاً، لنستخدم أداةَ السّحر الّتي
تنظر إلى ذكريات الآخرين

297
00:19:45,660 --> 00:19:47,830
الأداة السّحريّة

298
00:19:47,830 --> 00:19:51,000
الّتي تنظر إلى ذكريات الآخرين هي في الأصل
أداة تُستخدَم فقط ضدّ المُجرمين الخطيرين

299
00:19:51,410 --> 00:19:55,190
بهذا الشّكل، يمكننا إعطاء انطباع بأنّ عقوبةً

300
00:19:55,190 --> 00:19:57,590
قد أُنزِلَتْ ونُحدِّد هويّة أعدائنا أيضاً

301
00:19:57,880 --> 00:20:02,590
يمكننا أيضاً أن نُوهمهم بالسّماح لهم
...باستخدام أنفسهم طُعماً

302
00:20:06,200 --> 00:20:09,440
سنُعاقب النُّبلاء الّذين حدّدنا هويّتهم كأعداء

303
00:20:09,440 --> 00:20:12,270
وويلفريد لن يكون وريثاً مضموناً بعد الآن

304
00:20:12,270 --> 00:20:14,380
ما رأيك ذلك يا سيلفيستر؟

305
00:20:15,680 --> 00:20:20,520
ويلفريد، سأُعاملك كمُجرم ارتكب جريمة خطيرة

306
00:20:20,520 --> 00:20:22,830
وأستخدم أداةً سحريّة للبحث في ذكرياتك

307
00:20:23,190 --> 00:20:26,730
في نفس الوقت، سيُلغى ترشيحك كأرشيدوق جديد

308
00:20:26,730 --> 00:20:28,820
ستكون هذه هي عقوبتك

309
00:20:29,130 --> 00:20:32,330
لا تتصرّف بمزيد من الطّيش من الآن فصاعداً

310
00:20:32,990 --> 00:20:33,960
...حاضر

311
00:20:33,960 --> 00:20:35,450
هذا مُطمئن

312
00:20:38,440 --> 00:20:43,450
ويلفريد، أنا سعيدةٌ حقّاً لأنّك
لا تزال قادراً

313
00:20:43,450 --> 00:20:45,600
على البقاء بجانبي

314
00:20:47,940 --> 00:20:49,160
...روزيماين

315
00:20:49,600 --> 00:20:55,500
أحبُّ جدّتي، لكن فهمتُ الآن بأنّها
كانت على خطأ

316
00:20:55,500 --> 00:20:58,470
كان خطأ منّي الاشتباه بكِ. أنا آسف

317
00:20:58,470 --> 00:21:01,120
لا عليك يا أخي

318
00:21:01,600 --> 00:21:03,740
!أنتِ مُذهلة يا أختي

319
00:21:03,740 --> 00:21:07,370
!أنا مُعجبةٌ بكِ كثيراً

320
00:21:10,180 --> 00:21:11,410
!فعلتُها

321
00:21:11,410 --> 00:21:14,980
!أصبحتُ أُختاً كُبرى تحظى بالإعجاب

322
00:21:18,620 --> 00:21:22,160
،ويلفريد، كابن للأرشيدوق

323
00:21:22,160 --> 00:21:24,620
لُوِّثَ اسمُك بلطخة لا يمكن محوها

324
00:21:25,210 --> 00:21:29,520
لكن، إذا استمررتَ في العمل الدّؤوب
دون أن تتثبّط عزيمتُك، فسوف تتطوّر

325
00:21:30,180 --> 00:21:33,180
صدقك هذا هو فضيلةٌ نادرة

326
00:21:35,770 --> 00:21:39,510
،سأعمل بجدّ يا فيردي... لا

327
00:21:40,650 --> 00:21:41,760
!يا عمّي

328
00:21:42,440 --> 00:21:46,270
من أجل تجنُّب ارتكاب نفس
،أخطاء أخي ويلفريد

329
00:21:46,270 --> 00:21:53,170
قرّرتُ بجدّيةٍ حفظ قائمة النُّبلاء
الّتي أعددَتْها أُمِّي لأجلي

330
00:23:26,840 --> 00:23:29,850
الحلقة القادمة
تعميد تشارلوت

331
00:23:29,840 --> 00:23:34,920
الرّسم بواسطة: هيهارا يوه