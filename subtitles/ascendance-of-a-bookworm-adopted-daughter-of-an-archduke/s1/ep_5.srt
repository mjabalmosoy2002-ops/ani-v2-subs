1
00:00:00,990 --> 00:00:04,220
أثناء المُثابرة في التّحضير لحفل
،جمع التبرُّعات الموسيقيّ

2
00:00:04,220 --> 00:00:08,090
تعمل روزيماين على صنع ورق روسميّ شمعيّ

3
00:00:09,310 --> 00:00:11,790
صباح الخير يا روزيماين-ساما

4
00:00:12,280 --> 00:00:15,950
ماين... روزيماين-ساما؟

5
00:00:15,950 --> 00:00:19,630
أعتذر على الدّعوة المُفاجئة يا يوهان

6
00:00:19,630 --> 00:00:23,710
،لم أعُد في مركز يسمح لي بالخروج بحرّيّة

7
00:00:23,710 --> 00:00:26,190
الآن بعد أن عُيِّنتُ كبيرة أساقفة

8
00:00:26,190 --> 00:00:27,960
!كـ-كبيرة أساقفة؟

9
00:00:27,960 --> 00:00:28,910
أجل

10
00:00:28,910 --> 00:00:33,660
لذا، من الآن فصاعداً، أريدك أن
...تأتي إليّ بدلاً من ذلك

11
00:00:33,660 --> 00:00:36,280
!هـ-هذا طلبٌ بسيط! سوف آتي

12
00:00:36,590 --> 00:00:39,100
كيف أجرؤ على الطّلب منكِ
!المجيء إلى ورشتي؟

13
00:00:39,480 --> 00:00:41,670
يبدو أنّه يعتقد بأنّني

14
00:00:41,670 --> 00:00:46,360
،كنتُ كاهنة برِداء أزرق مُتنمّرة
مثلما خطّطَ السّيّد بينّو فحسب

15
00:00:46,360 --> 00:00:48,580
بالمُناسبة، من يكون هذا؟

16
00:00:49,960 --> 00:00:51,970
هذا زاك من ورشة فيردي

17
00:00:51,970 --> 00:00:57,610
،في مهمّتك الأخيرة بالنّسبة للنّوع المعدنيّ
تمّ تقييمه كثاني شخص بعد يوهان{?}

18
00:00:57,610 --> 00:01:00,620
لا بُدّ أنّه موهوب جدّاً

19
00:01:00,620 --> 00:01:04,880
يبدو أنّ زاك أيضاً يرغب في كسب
لقب غوتينبيرغ

20
00:01:04,880 --> 00:01:06,630
غوتينبيرغ؟

21
00:01:06,630 --> 00:01:07,740
أجل

22
00:01:07,740 --> 00:01:09,660
حتّى الآن، لم يحصل يوهان على رُعاة

23
00:01:09,660 --> 00:01:12,210
ولم يتلقّ أيّ اعتراف بعمله

24
00:01:12,210 --> 00:01:15,390
لكن بعد العمل معكِ، تلقّى اعترافاً مرموقاً فجأة

25
00:01:15,390 --> 00:01:18,350
والآن الجميع يعرفونه بذلك اللّقب

26
00:01:18,350 --> 00:01:20,400
...لكن لا أريد لقباً كهذا

27
00:01:20,400 --> 00:01:24,010
أنتِ لا تعرفين حدّادين آخرين فحسب
يا روزيماين-ساما

28
00:01:24,010 --> 00:01:28,140
أعتقد بأنّني أنسب للقب غوتينبيرغ

29
00:01:28,140 --> 00:01:30,690
!قارني عملي بعمله رجاء

30
00:01:33,160 --> 00:01:36,530
...شخصيّته مُختلفة كلّياً عن يوهان

31
00:01:36,900 --> 00:01:38,380
شخصيّاً، سأكون سعيدة

32
00:01:38,380 --> 00:01:42,150
بقبول حِرفيّين أكثر تحفيزاً ومهارة

33
00:01:42,150 --> 00:01:43,040
...إذاً

34
00:01:43,040 --> 00:01:45,530
من فضلك أرِني مهاراتك يا زاك

35
00:01:46,830 --> 00:01:47,770
!حاضر

36
00:02:04,190 --> 00:02:11,580
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

37
00:03:23,970 --> 00:03:28,980
الحلقة 5
تحضيرات الحفل الموسيقيّ

38
00:03:29,950 --> 00:03:32,230
هذه المرّة، أرغب منكما أن تصنعا

39
00:03:32,230 --> 00:03:34,720
بكَرات ضروريّة لصنع ورق
روسميّ شمعيّ

40
00:03:34,720 --> 00:03:36,310
ورق روسميّ شمعيّ؟

41
00:03:36,310 --> 00:03:37,500
بكَرات؟

42
00:03:37,500 --> 00:03:39,050
هذه ورقة روسميّة شمعيّة

43
00:03:39,830 --> 00:03:41,600
إنّها ورقة مطليّة بالشّمع

44
00:03:46,830 --> 00:03:51,350
مثل هذه، نريد طلاء ورق رقيق
جدّاً لدرجة يكون فيها شفّافاً

45
00:03:53,210 --> 00:03:54,640
لقد تفتّتت

46
00:03:54,640 --> 00:03:57,760
بمقدار من الشّمع بحيث لا يتفتّت الورق

47
00:04:00,250 --> 00:04:02,350
...طِلاء أرقّ من هذا حتّى

48
00:04:03,020 --> 00:04:04,080
لوتز

49
00:04:04,080 --> 00:04:04,930
حاضر

50
00:04:06,800 --> 00:04:08,620
انظرا إلى هذا رجاء

51
00:04:09,780 --> 00:04:12,590
،تُوضَع بكَرتان فوق بعضهما الآخر

52
00:04:12,960 --> 00:04:16,060
تحت البكَرتَين توجد صينيّة تحتوي
على شمع مُسخَّن وذائب

53
00:04:16,060 --> 00:04:18,330
ينساب الشّمع الذّائب

54
00:04:20,420 --> 00:04:26,560
،من البكَرة السّفليّة إلى البكَرة العلويّة
ليضمن طِلاء شمع مُوحَّد

55
00:04:27,680 --> 00:04:30,420
...عندما ينتقل الورق بين هاتين البكَرتين

56
00:04:32,350 --> 00:04:36,360
ينبغي أن يُصنَع ورق روسميّ
شمعيّ مُتساوٍ

57
00:04:37,620 --> 00:04:39,170
هل فهمتُما الفكرة؟

58
00:04:40,410 --> 00:04:44,800
هل من المُناسب تغيير التّصميم ما دام
الورق يُطلَى بالشّمع لترقيقه؟

59
00:04:44,800 --> 00:04:46,550
أجل. بالطّبع

60
00:04:52,490 --> 00:04:55,620
قرّرنا رؤية تصميمهما

61
00:04:55,620 --> 00:04:58,690
حالما ينتهيان، ثمّ نُقرّر
من منهما نتبنّى

62
00:05:01,440 --> 00:05:04,600
!سوف أصبح غوتينبيرغ حتماً

63
00:05:04,600 --> 00:05:08,510
أريد صنع شيء يُسعد روزيماين-ساما

64
00:05:08,510 --> 00:05:11,950
لكن يمكنك الحصول على لقب
غوتينبيرغ يا زاك

65
00:05:13,090 --> 00:05:15,310
!لوتز! هل سمعت ذلك؟

66
00:05:15,310 --> 00:05:16,970
!حماس زاك

67
00:05:16,970 --> 00:05:18,740
...ويوهان

68
00:05:18,740 --> 00:05:23,450
قال بأنّه يريد الاستمرار في العمل
معي حتّى من دون لقب

69
00:05:23,450 --> 00:05:26,110
!مُتواضع جدّاً ومُخلص

70
00:05:26,110 --> 00:05:29,220
لا. لا أعتقد بأنّ يوهان قال
ذلك ليبدو مُتواضعاً

71
00:05:29,510 --> 00:05:35,100
أريد من يوهان أن يعمل بجدّ
!ويستمرّ في توسيع مجال الطّباعة

72
00:05:35,390 --> 00:05:37,440
!بالمُناسبة يا روزيماين-ساما

73
00:05:37,440 --> 00:05:38,350
نعم؟

74
00:05:38,350 --> 00:05:42,780
حِرفيّة زينة الشّعر خاصّتنا
لديها زينة جديدة

75
00:05:42,780 --> 00:05:45,990
تريد أن تُريكِ إيّاها يا روزيماين-ساما

76
00:05:45,990 --> 00:05:48,000
ماذا؟ تولي؟

77
00:05:53,240 --> 00:05:56,550
كانت تعمل بجدّ على دروس
آداب السُّلوك خاصّتها

78
00:05:57,120 --> 00:05:59,450
...يمكنني اللّقاء بتولي

79
00:06:00,370 --> 00:06:02,380
!أحضرها لرؤيتي من فضلك

80
00:06:02,660 --> 00:06:04,310
أمركِ

81
00:06:04,310 --> 00:06:05,840
هذا لكِ أيضاً

82
00:06:07,140 --> 00:06:09,130
!رسالة من العائلة

83
00:06:10,460 --> 00:06:13,640
سأحضر لك زينةَ شعر جديدة
في المرّة المُقبلة

84
00:06:13,980 --> 00:06:17,130
يستطيع كاميل أن ينقلب الآن

85
00:06:17,400 --> 00:06:21,780
أصبح أبوكِ قائداً. أصبحتُ
!مشغولاً حقّاً بالعمل

86
00:06:29,280 --> 00:06:31,620
يسرّني أنّ الجميع يبدون بخير

87
00:06:31,620 --> 00:06:33,540
أنا بحالٍ جيّدة أيضاً

88
00:06:35,290 --> 00:06:39,290
شكراً على المجيء إلى الكاتدرائيّة
أثناء مهرجان النّجوم

89
00:06:39,290 --> 00:06:40,900
أسعدَني ذلك

90
00:06:40,900 --> 00:06:45,540
الآن، أنا مشغولة جدّاً لحفل
...كبير الكهنة الموسيقيّ

91
00:06:49,670 --> 00:06:52,420
برنامج؟ ما هو هذا؟

92
00:06:52,420 --> 00:06:56,300
إنّها مجموعة ورق مطبوعة تُدرِج
المقطوعات الّتي ستُعزَف في الحفل

93
00:06:56,300 --> 00:06:58,760
ستُطبَع صورتك في الواجهة

94
00:06:58,760 --> 00:07:02,060
وسيُطبَع في الخلف عناوين
وكلمات الأغاني

95
00:07:02,060 --> 00:07:05,000
سنبيع هذه كتذكار

96
00:07:06,200 --> 00:07:08,490
لا ضرورة لصورة لي

97
00:07:08,490 --> 00:07:10,560
هذا للتّرويج للعمل

98
00:07:11,350 --> 00:07:14,350
فأساساً، هذا حفل يدعم
مجال الطّباعة

99
00:07:32,190 --> 00:07:34,980
فيرديناند-ساما، هذه إلفيرا

100
00:07:34,980 --> 00:07:36,850
ماذا؟ أمّي؟

101
00:07:37,100 --> 00:07:39,820
أريد اللّقاء بروزيماين

102
00:07:39,820 --> 00:07:44,610
أودُّ التحدُّث معها حول الحفل
الموسيقيّ وويلفريد-ساما

103
00:07:48,580 --> 00:07:52,640
...إلفيرا قادمة إلى الكاتدرائيّة؟ مُستحيل

104
00:07:52,640 --> 00:07:56,620
لا. أمّي قادمة بسبب البرامج

105
00:07:56,620 --> 00:08:02,680
تُحضّر أمّي للحفل الموسيقيّ
مع أمّي بالتبنّي، السّيّدة فلورينشيا

106
00:08:02,680 --> 00:08:07,250
ترغب حتّى في المجيء إلى الكاتدرائيّة
الّتي يكرهها الجميع

107
00:08:07,250 --> 00:08:10,540
لأنّها تُعلِّق كلَّ شيء على إنجاح
مجال الطّباعة

108
00:08:17,200 --> 00:08:18,760
هل ستكون ثلاثة أيّام من الآن مقبولة؟

109
00:08:20,160 --> 00:08:24,520
،شركة غيلبيرتا ستزور في ذلك اليوم
لكن أنا مُتفرّغة قبل ذلك الحين

110
00:08:27,750 --> 00:08:30,020
الطّيور الرّسولة عمليّة جدّاً

111
00:08:30,550 --> 00:08:33,910
آمل أن أتمكّن من تعلُّم
...كيفيّة استعمالها قريباً

112
00:08:38,230 --> 00:08:39,320
روزيماين

113
00:08:40,930 --> 00:08:44,030
احرصي على إطلاعي على
البرنامج للمُوافقة

114
00:08:44,370 --> 00:08:45,800
عُلِم

115
00:08:46,260 --> 00:08:47,460
!حسناً

116
00:08:51,250 --> 00:08:53,800
،للحصول على مُوافقة كبير الكهنة

117
00:08:53,800 --> 00:08:57,280
هل سيكون من الأفضل استخدام
طبعة ورقيّة مرسومة في الغلاف؟

118
00:08:57,780 --> 00:09:00,560
حسناً، سأُقرّر بعد استشارة ويلما

119
00:09:00,840 --> 00:09:02,800
...أنا آسفة جدّاً

120
00:09:03,080 --> 00:09:06,160
لا أعرف شكل كبير الكهنة

121
00:09:06,160 --> 00:09:08,730
...ماذا؟ لكن رأيتِه أثناء المُعاينة

122
00:09:10,200 --> 00:09:11,550
...في الواقع

123
00:09:12,350 --> 00:09:16,600
...بذلتُ جهدي لأتجنّب رؤية وجهه

124
00:09:17,810 --> 00:09:19,590
...هذا صحيح

125
00:09:19,590 --> 00:09:22,700
ويلما لا تُجيد التّعامل مع الرّجال

126
00:09:23,380 --> 00:09:27,580
وهكذا، طلبتُ من روزينا
رسم كبير الكهنة

127
00:09:27,580 --> 00:09:31,450
وطلبتُ من ويلما رسمه
استناداً إلى الرّسمة

128
00:09:32,840 --> 00:09:39,080
روزيماين-ساما، هلّا سمحتِ لي رجاء
برؤية وجه كبير الكهنة؟

129
00:09:39,080 --> 00:09:41,600
لِمَ هذا الطّلب المُفاجئ؟

130
00:09:42,630 --> 00:09:43,820
...في الواقع

131
00:09:43,820 --> 00:09:46,900
...رسم روزينا الأوّليّ له فاجأني كثيراً

132
00:09:46,900 --> 00:09:50,600
لم أرَ من قبل شخصاً بهذه
الملامح المثاليّة

133
00:09:51,030 --> 00:09:53,360
!أريد رؤيته شخصيّاً لرسم شكله بدقّة

134
00:09:59,020 --> 00:10:03,020
إذاً يا روزيماين. أريدكِ
أن تُوفّري الأغنية

135
00:10:03,020 --> 00:10:03,790
حاضرة

136
00:10:05,160 --> 00:10:10,540
دندندتُ أغنيةَ أنمي للأطفال
بمشاعر الحُبّ والشّجاعة

137
00:10:10,540 --> 00:10:16,110
،والحنان الّتي يفتقر لها كبير الكهنة
والّتي أضاف لها كبير الكهنة الكلمات

138
00:10:23,620 --> 00:10:27,680
هذه أُغنية حُبّ مُخصّصة
لإلَهة الأرض غيدولد

139
00:10:27,680 --> 00:10:30,430
بواسطة إله الحياة إيويغليبين

140
00:10:30,430 --> 00:10:31,960
...مُذهل

141
00:10:31,960 --> 00:10:34,700
...حتّى أنا انسحرت

142
00:10:45,730 --> 00:10:48,100
!ماذا؟ حتّى دامويل؟

143
00:10:58,640 --> 00:11:00,710
...هذه الأُغنية من جديد

144
00:11:05,520 --> 00:11:10,340
لم أستطع إيقاف يدَي منذ جاءت
عينايّ على كبير الكهنة

145
00:11:10,340 --> 00:11:15,860
لدرجة أنّني أعتقد بأنّني كنتُ مُبارَكة
!بواسطة كونتزيل، إلَهة الرّسم

146
00:11:18,610 --> 00:11:21,610
...حفل كبير الكهنة بآلة الهارشبيل

147
00:11:22,410 --> 00:11:25,990
!ربّما يكون هذا خطيراً جدّاً؟

148
00:11:26,000 --> 00:11:29,760
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

149
00:11:32,300 --> 00:11:36,010
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

150
00:11:36,820 --> 00:11:38,240
بعد ثلاثة أيّام

151
00:11:38,240 --> 00:11:43,000
زارتْ أمّي الكاتدرائيّة برفقة
أخي لامبريشت

152
00:11:56,940 --> 00:11:58,160
!...هذا

153
00:11:58,460 --> 00:12:00,640
هذا بسكويت يُعرَف بـ لانغيس دي تشات

154
00:12:00,640 --> 00:12:02,900
هذه أوّل مرّة أُقدّمه للآخرين

155
00:12:02,900 --> 00:12:06,650
هكذا إذاً. لم يتناولها كورنيليوس بعد

156
00:12:07,800 --> 00:12:11,660
يبدو أنّ أخي لامبريشت جاء
لأكل طعام إيلا

157
00:12:11,660 --> 00:12:14,170
يسرّني أن أرى روزيماين بخير

158
00:12:14,520 --> 00:12:18,140
لا بُدّ أنّ الفضل يعزو لعناية
فيرديناند-ساما بها

159
00:12:18,140 --> 00:12:19,920
أنا مُمتنّة لذلك حقّاً

160
00:12:20,240 --> 00:12:22,680
هذا هو سبب أمّي للزيارة

161
00:12:23,190 --> 00:12:25,950
يسرّني أنّني قرّرتُ المجيء إلى الكاتدرائيّة

162
00:12:25,950 --> 00:12:30,730
الجميع مُهذّبون وكلُّ شيء نظيف ومُرتَّب

163
00:12:33,890 --> 00:12:35,690
أنا مُطمئنّة

164
00:12:35,690 --> 00:12:37,610
...أمّي

165
00:12:38,180 --> 00:12:39,300
!حسناً

166
00:12:43,940 --> 00:12:46,700
وبعد، ما الشّأن الّذي لديك؟

167
00:12:46,960 --> 00:12:47,930
حاضر

168
00:12:47,930 --> 00:12:49,880
...إنّه بخصوص ويلفريد-ساما

169
00:12:50,450 --> 00:12:52,690
يدّعي بأنّه ليس من العدل
ألّا تحتاج للدّراسة

170
00:12:52,970 --> 00:12:53,830
ماذا؟

171
00:12:54,690 --> 00:12:56,950
أتقول بأنّ هذا ليس عادلاً؟

172
00:12:56,950 --> 00:12:58,130
أجل

173
00:12:58,130 --> 00:13:00,780
يشتكي أيضاً بأنّ روزيماين
لا تملك مُدرّساً

174
00:13:00,780 --> 00:13:03,640
...ودائماً ما تخرج من القلعة خِلسة

175
00:13:03,640 --> 00:13:05,960
أنا لا أخرج خِلسة

176
00:13:06,270 --> 00:13:07,400
قال أيضاً بأنّه

177
00:13:07,400 --> 00:13:11,970
ليس من المُنصف أن تتكلّم روزيماين
دوماً مع سيلفيستر-ساما أثناء الطّعام

178
00:13:12,300 --> 00:13:14,260
!روزيماين، أنتِ غير مُنصِفة

179
00:13:17,840 --> 00:13:22,310
أنا أُبلغ عن مسار تقدُّم العمل فقط

180
00:13:22,310 --> 00:13:27,260
على أيّ حال، من فضلكِ ادرسي مع ويلفريد-ساما
مرّةً لإشعال روحه التّنافسيّة

181
00:13:27,260 --> 00:13:29,000
لا تملك وقتاً لذلك

182
00:13:29,350 --> 00:13:33,750
هناك أولويّات عديدة بالنّسبة لروزيماين

183
00:13:34,040 --> 00:13:38,120
خدَم ويلفريد هم الّذين ينبغي
أن يتعاملوا مع وضعه

184
00:13:41,260 --> 00:13:45,760
بعد الغداء، عاد كبير الكهنة إلى عمله

185
00:13:45,760 --> 00:13:50,000
!ماذا؟ بيعت تذاكر الحفل الموسيقيّ من الآن؟

186
00:13:50,340 --> 00:13:53,360
أجل. هل من المُمكن زيادة عدد المقاعد؟

187
00:13:53,990 --> 00:13:56,330
إلى أيّ عدد؟

188
00:13:56,330 --> 00:13:59,270
ربّما ضعف العدد الحاليّ؟

189
00:13:59,270 --> 00:14:01,950
الضّعف؟

190
00:14:01,950 --> 00:14:06,520
يبدو أنّنا قد نحتاج للبدء من جديد
...باختيار موقع أكبر

191
00:14:07,040 --> 00:14:09,570
...هذا صحيح... على ذِكر المواقع

192
00:14:10,520 --> 00:14:12,310
أخي لامبريشت

193
00:14:12,310 --> 00:14:18,780
أرغب في الطّلب من الفُرسان توفير حِراسة
أمنيّة للموقع. مِمَّن ينبغي أن أطلب؟

194
00:14:18,780 --> 00:14:20,540
إنّه مُجرّد حفل بالهارشبيل، صحيح؟

195
00:14:20,790 --> 00:14:22,410
لا ضرورة لذلك

196
00:14:22,410 --> 00:14:25,290
يبدو أنّ العطاء أفضل من القول

197
00:14:27,700 --> 00:14:31,410
هذه هي صورة كبير الكهنة الّتي
أنوي بيعها في الحفل

198
00:14:32,760 --> 00:14:36,820
يا إلهي! ما هذا؟! دعيني أُعاينها
بحرص أكبر

199
00:14:37,560 --> 00:14:40,320
تنوين بيع هذه أثناء حفل الهارشبيل؟

200
00:14:40,320 --> 00:14:41,940
...أ-أجل

201
00:14:41,940 --> 00:14:42,980
سوف أشتريها

202
00:14:42,980 --> 00:14:48,160
سيُعدّ شراء هذه تبرُّعاً! إنّه
!عملٌ خيريّ! أليس كذلك؟

203
00:14:49,300 --> 00:14:53,670
أعتقد بأنّ السيّدات سيُصبحن
هكذا، الواحدة تِلو الأُخرى

204
00:14:53,670 --> 00:14:55,860
سأطلب من أبي فوراً

205
00:14:55,860 --> 00:14:57,570
شكراً لك من القلب

206
00:15:01,260 --> 00:15:03,450
أمّي، هلّا استعدتُ هذه؟

207
00:15:08,810 --> 00:15:11,380
سأعطيكِ هذه بالمُقابل

208
00:15:12,630 --> 00:15:14,970
!هذه رائعة كذلك

209
00:15:14,970 --> 00:15:17,520
هذه هي الصّورة الّتي سنطبعها في البرنامج

210
00:15:17,520 --> 00:15:20,360
بوضع نُسخ إضافيّة واحتياطيّة
...بعين الاعتبار

211
00:15:20,360 --> 00:15:24,100
ننوي طبع حوالي مئة نسخة من هذه الصُّورة

212
00:15:24,410 --> 00:15:26,830
هل العامّة قادرون حقّاً
على صنع مئة نسخة

213
00:15:26,830 --> 00:15:29,600
!من هذه دون استعمال أدوات سحريّة؟

214
00:15:29,600 --> 00:15:32,480
أجل. هذه تقنيّة طِباعة

215
00:15:36,250 --> 00:15:38,480
...بعد عودة أمّي وأخي إلى المنزل

216
00:15:39,550 --> 00:15:44,760
روزيماين-ساما، أحضرتُ حِرفيّة
زينة الشّعر خاصّتنا اليوم

217
00:15:50,870 --> 00:15:55,140
سررتُ بلقائكِ يا روزيماين-ساما

218
00:15:55,140 --> 00:15:56,770
اسمي تولي

219
00:15:58,510 --> 00:16:02,310
دائماً ما أقدّر زينة الشّعر
...الّتي تصنعينها

220
00:16:04,080 --> 00:16:05,520
!تلك الحقيبة

221
00:16:06,510 --> 00:16:08,600
أرغب في تقديم هذا لروزيماين-ساما

222
00:16:09,550 --> 00:16:11,820
صنعتُ زينةَ الشّعر هذه بتقنيّة

223
00:16:11,820 --> 00:16:13,960
علّمَتْني إيّاها أختي المُتوفّاة الصُّغرى

224
00:16:20,510 --> 00:16:26,140
حتّى الآن، دائماً ما أفكّر فيها
عندما أصنع هذه الزّينة

225
00:16:29,800 --> 00:16:31,730
!ما أجملها

226
00:16:33,090 --> 00:16:35,850
...مثلما قدّرتِ أختكِ الصّغرى

227
00:16:36,570 --> 00:16:41,830
سأُقدّر دوماً زينة الشّعر
هذه عندما أستعملها

228
00:16:45,040 --> 00:16:46,190
!حسناً

229
00:16:51,580 --> 00:16:53,340
أودّ أن أشكركِ

230
00:16:57,880 --> 00:17:00,070
هذه رسوم ملابس نُبلاء

231
00:17:00,490 --> 00:17:03,080
من فضلكِ استعمليها لمشاريعكِ المُستقبليّة

232
00:17:03,720 --> 00:17:05,080
شكراً جزيلاً لكِ

233
00:17:05,430 --> 00:17:08,060
تولي، لا بُدّ أنّكِ عملتِ بجدّ

234
00:17:08,060 --> 00:17:12,340
لتحسين أسلوب كلامكِ وآداب
سلوككِ للوصول إلى هنا

235
00:17:13,110 --> 00:17:17,210
ثمّ تحادثنا لوقتٍ طويل

236
00:17:17,600 --> 00:17:22,590
أخي الأصغر غالباً ما ينظر بإمعان
إلى كتابه المًصوَّر بالأسود والأبيض

237
00:17:22,880 --> 00:17:24,080
تعلّمَ أيضاً

238
00:17:24,080 --> 00:17:28,090
الإمساك بدُمية شوميل الّتي
تُصدر صوتَ رنين عند هزّها

239
00:17:40,700 --> 00:17:42,330
،روزيماين-ساما

240
00:17:42,330 --> 00:17:46,610
هل يمكنني المجيء لأعرض شخصيّاً
زينةَ الشّعر التّالية حالما تكتمل؟

241
00:17:47,190 --> 00:17:49,990
أجل! بالطّبع. سأكون في انتظاركِ

242
00:18:00,070 --> 00:18:01,840
روزيماين-ساما

243
00:18:01,840 --> 00:18:02,930
نعم

244
00:18:05,140 --> 00:18:09,260
يجب أن نُسرع إذا كنتِ تنوين الذّهاب
إلى الورشة قبل غروب الشّمس

245
00:18:10,780 --> 00:18:12,290
!هيّا بنا

246
00:18:13,100 --> 00:18:17,650
ليست بريغيتّي فحسب، تركتُ
دامويل اليوم أيضاً

247
00:18:22,910 --> 00:18:28,380
أريد تجنُّب السّماح للنُّبلاء بمعرفة
سرّ فاكهة تاو مهما كلّف الأمر

248
00:18:28,380 --> 00:18:29,800
روزيماين-ساما

249
00:18:37,150 --> 00:18:39,210
لم أركِ منذ وقت يا ديليا

250
00:18:39,210 --> 00:18:40,920
يسرّني أن أراكِ بخير

251
00:18:42,570 --> 00:18:44,370
شكراً جزيلاً لكِ

252
00:18:44,370 --> 00:18:46,190
ديرك وأنا نُبلي حسناً

253
00:18:56,700 --> 00:18:57,880
ديليا

254
00:18:58,340 --> 00:19:01,200
من فضلكِ دعي ديرك يُمسك بتلك الفاكهة

255
00:19:02,490 --> 00:19:03,700
حسناً

256
00:19:12,470 --> 00:19:14,700
!روزيماين-ساما! الفاكهة

257
00:19:15,010 --> 00:19:16,930
يمتلك ديرك المُلتهِم

258
00:19:16,930 --> 00:19:22,510
،إن لم نستخرج القوّة السّحريّة من جسده
فقد تؤثّر على حياته

259
00:19:26,160 --> 00:19:28,650
والآن، ينبغي أن يكون بخير
لبعض الوقت

260
00:19:28,650 --> 00:19:30,470
يمكنكما العودة

261
00:19:32,980 --> 00:19:35,420
تقول بأنّك بخير الآن

262
00:19:35,420 --> 00:19:38,150
شكراً جزيلاً لكِ يا روزيماين-ساما

263
00:19:42,250 --> 00:19:45,880
أتساءل ما إن أصبح كاميل بهذا الحجم

264
00:19:46,480 --> 00:19:47,650
لا. لا

265
00:19:47,650 --> 00:19:50,380
سأحنُّ للدّيار إذا فكّرتُ في ذلك

266
00:19:50,770 --> 00:19:52,750
فران. من فضلك

267
00:19:58,200 --> 00:20:01,890
حسناً جميعاً! هل أنتم مُستعدّون؟

268
00:20:04,910 --> 00:20:06,410
!لنبدأ

269
00:20:17,570 --> 00:20:18,660
...حسناً إذاً

270
00:20:22,930 --> 00:20:24,100
!قطّعوها

271
00:20:23,390 --> 00:20:27,910
ما كان ليُصدّق أحدٌ بأنّ فاكهة
تاو تتحوّل إلى أشجار ترومبي

272
00:20:27,910 --> 00:20:32,410
إذا نمتْ إلى حجم كبير، فسيترتّب على الفُرسان
أن ينتشروا لإبادة بذور الكارثة هذه

273
00:20:32,410 --> 00:20:36,130
إذا اكتشفَ الآخرون بأنّها تُستخدَم
...كمادّة خامّة للورق

274
00:20:36,130 --> 00:20:40,710
علاوة على ذلك، إن علِموا بأنّ فواكه تاو
الّتي يمكن قطفها بسهولة في الغابة

275
00:20:40,710 --> 00:20:43,630
،تستطيع امتصاص المانا كأدوات سحريّة

276
00:20:43,630 --> 00:20:47,560
فسينقلب مُجتمع النُّبلاء الّذي يُحكم السّيطرة
على المانا رأساً على عقب

277
00:20:47,560 --> 00:20:50,090
!سيتمّ إقصائي قبل حدوث ذلك

278
00:20:50,930 --> 00:20:54,220
!لهذا يجب إبقاء هذا سرّاً مهما كلّف الأمر

279
00:20:55,300 --> 00:20:56,310
...ثمّ

280
00:20:57,040 --> 00:21:00,590
أجريتُ تحسينات على الأداة
الّتي طلبتِها يا روزيماين-ساما

281
00:21:00,590 --> 00:21:02,550
...إنّه شيء ما كنتُ لأتمكّن من ابتكاره

282
00:21:04,510 --> 00:21:06,950
أيُّهم تعتقد بأنّه الأفضل؟

283
00:21:06,950 --> 00:21:08,040
سأخبركِ

284
00:21:08,040 --> 00:21:13,090
ستكون هذه الأكثر فعاليّة، لكن سيكون
صنع هذه الأكثر واقعيّة

285
00:21:14,480 --> 00:21:16,210
ما رأيك يا يوهان؟

286
00:21:17,880 --> 00:21:19,200
...أنا

287
00:21:21,090 --> 00:21:24,340
.من المُستحيل صنع هذه
يمكنك معرفة ذلك، صحيح؟

288
00:21:25,950 --> 00:21:26,830
أستطيع صنعها

289
00:21:28,090 --> 00:21:30,970
...أنا من صنع التّصميم! فلماذا أنت

290
00:21:33,250 --> 00:21:38,420
إذاً أرغب من كلّ واحد منكما أن
يصنع آلة التّشميع الّتي اخترتُماها

291
00:21:38,420 --> 00:21:40,850
سأقرّر أيّ واحدة سنستخدم
حالما أرى النّتائج

292
00:21:42,530 --> 00:21:43,610
حاضر-
حاضر-

293
00:23:19,040 --> 00:23:22,040
الحلقة القادمة
حفل الهارشبيل

294
00:23:25,040 --> 00:23:27,050
!أريد فعل ذلك أيضاً

295
00:23:27,050 --> 00:23:29,040
لستِ جاهزة بعد

296
00:23:29,040 --> 00:23:31,860
لا تستطيعين استخدام أوردونانز
من دون شتابّي

297
00:23:31,860 --> 00:23:35,310
الشتابّي هي أداة تسمح لكِ
باستخدام السّحر بكفاءة أكبر

298
00:23:35,310 --> 00:23:37,260
لكن يمكنكِ فقط الحصول عليها
مرّةً خلال حياتكِ

299
00:23:37,260 --> 00:23:40,340
للحصول على واحدة، يجب أن
تذهبي إلى حديقة البدايات

300
00:23:40,340 --> 00:23:42,850
وامتصاص الإرادة القدسيّة للآلهة بجسدكِ

301
00:23:42,180 --> 00:23:44,590
!هـ-هذه كثير من المعلومات

302
00:23:42,850 --> 00:23:43,840
...من أجل القيام بذلك

303
00:23:44,980 --> 00:23:50,060
الرّسم بواسطة: كوساكابي ري