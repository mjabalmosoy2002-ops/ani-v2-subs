1
00:00:01,110 --> 00:00:06,350
عُيّنَتْ روزيماين مسؤولة عن القلعة
إلى جانب بونيفاتيوس وويلفريد

2
00:00:07,210 --> 00:00:11,150
ثمّ عاد الأرشيدوق وزوجته بعد نهاية
مُؤتمر الأرشيدوق

3
00:00:12,810 --> 00:00:14,640
أهلاً بعودتكما

4
00:00:15,120 --> 00:00:16,980
مسرورين لعودتنا

5
00:00:16,980 --> 00:00:20,450
هل تمكّنتما من أداء واجبكما
على أكمل وجه؟

6
00:00:20,730 --> 00:00:22,690
!بالطّبع يا أمّي

7
00:00:22,690 --> 00:00:25,450
أعدنا تعبئة المانا بمُثابرة كُلّ يوم

8
00:00:25,830 --> 00:00:28,530
،أخي، لقد أصبحتَ ضليعاً في هذا
أليس كذلك؟

9
00:00:28,530 --> 00:00:32,400
أجل. عَمِلَ بجدٍّ فعلاً

10
00:00:35,080 --> 00:00:37,420
أنا فخورةٌ بك يا ويلفريد

11
00:00:46,350 --> 00:00:48,730
!ما الأمر يا أبي؟

12
00:00:49,090 --> 00:00:50,990
كُلّ هذه غلطتك

13
00:01:14,480 --> 00:01:20,280
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

14
00:02:32,010 --> 00:02:37,010
الحلقة 18
تقدُّم دامويل للخطوبة

15
00:02:39,750 --> 00:02:43,890
سمعتُ بأنّكِ أخبرتِ أختكِ الكبرى
عن وفاة خالي

16
00:02:44,360 --> 00:02:48,950
...لا أملك أدنى فكرة عمّا تتكلّم

17
00:02:48,950 --> 00:02:52,440
خال أبي هو كبير الأساقفة السّابق، صحيح؟

18
00:02:52,440 --> 00:02:55,020
لكن أختك الكُبرى؟

19
00:02:55,020 --> 00:02:59,150
أختي الكبرى، الّتي تزوّجتْ
من جهة أرينسباخ

20
00:02:59,380 --> 00:03:03,410
...لم يخبروني كم أخاً يملك أبي

21
00:03:04,200 --> 00:03:08,500
أخبرتني أختي بأنّ كبيرة الأساقفة
الجديدة قد أبلغَتْها

22
00:03:08,910 --> 00:03:11,660
كنتِ أنتِ من أخبرها حتماً

23
00:03:11,950 --> 00:03:16,920
لا أعلم مَن بين الرّسائل رددتُ
...عليه بصِفة كبيرة الأساقفة

24
00:03:18,680 --> 00:03:20,850
!تلك الرّسالة السّحريّة؟

25
00:03:21,300 --> 00:03:22,710
!لا بُدّ أنّها هي

26
00:03:22,710 --> 00:03:25,440
فهمت. لم تكوني تعلمين

27
00:03:25,440 --> 00:03:27,810
ماذا حدث بينك وبين أختك؟

28
00:03:28,030 --> 00:03:31,810
كان خالي مُولعاً بأختي الكُبرى

29
00:03:31,810 --> 00:03:34,560
يبدو أنّهما ظلّا على تواصُل بعد زواجها

30
00:03:34,860 --> 00:03:38,290
لذا وبّختْني بلا رحمة أثناء
،مُؤتمر الأرشيدوق

31
00:03:38,290 --> 00:03:41,570
قائلة بأنّه كان من الفظاعة منّي
ألّا أُبلغها عن وفاته

32
00:03:41,570 --> 00:03:44,490
...إذاً لهذا السّبب تبدو مُرهَقاً

33
00:03:45,440 --> 00:03:49,270
لهذا هي قادمة لزيارة قبره
في آخر الصّيف

34
00:03:49,270 --> 00:03:53,080
قالتْ بأنّها أرادت المجيء لتشكركِ
على إبلاغها بذلك

35
00:03:53,400 --> 00:03:56,500
ستقطع كُلّ المسافة لتشكرني؟

36
00:03:56,500 --> 00:03:57,900
...يا لتواضعها

37
00:03:57,230 --> 00:03:59,430
أنتِ لا تفهمين إطلاقاً

38
00:03:59,430 --> 00:04:00,200
ماذا؟

39
00:04:00,480 --> 00:04:02,420
،أعرف أختي الكُبرى خير معرفة

40
00:04:02,420 --> 00:04:06,080
إذا اكتشفتْ بأنّكِ أنتِ سبب
،القبض على خالي

41
00:04:06,080 --> 00:04:09,090
فستنهال عليكِ بتعليقات حقودة
تخترق قلبكِ كالسكّين

42
00:04:09,090 --> 00:04:10,100
!ماذا؟

43
00:04:10,330 --> 00:04:14,160
دوقيّة أرينسباخ تفوق إيرينفيست رتبةً

44
00:04:14,160 --> 00:04:17,980
إذا هاجمتِها فقد تتحوّل المسألة
ببساطة إلى حادث دبلوماسيّ

45
00:04:17,980 --> 00:04:19,840
،إذاً إنّها ليست مُتواضعة

46
00:04:19,840 --> 00:04:22,980
إنّما من النّوع الّذي يضمر ضغينة
...ويُسبّب إزعاجاً

47
00:04:22,980 --> 00:04:25,120
حريّ بكِ أن تتوخّي الحذر

48
00:04:25,120 --> 00:04:26,230
...حسناً

49
00:04:26,230 --> 00:04:29,940
وبهذا نختتم هذه المسألة" هو"
،ما كنتُ أودّ قوله

50
00:04:29,940 --> 00:04:31,620
لكن ثمّة مسألة هامّة أُخرى

51
00:04:31,620 --> 00:04:34,030
أريد أن أخبركِ بها، غير أختي الكُبرى

52
00:04:34,030 --> 00:04:35,260
ما هي؟

53
00:04:35,620 --> 00:04:38,750
كنتُ أُفكِّر في الاستفادة من مراسم
اجتماع النّجوم لهذا العام

54
00:04:38,750 --> 00:04:40,760
لأدع فيرديناند يعود إلى العالم الدّنيويّ

55
00:04:40,970 --> 00:04:43,670
ستدع فيرديناند-ساما يعود
!إلى صفوف النّبلاء؟

56
00:04:43,670 --> 00:04:45,210
!تمهّل لحظة

57
00:04:45,210 --> 00:04:47,720
!هل تنوي تدمير الكاتدرائيّة؟

58
00:04:48,380 --> 00:04:50,790
!هذه ليست مسألة مُضحكة

59
00:04:51,770 --> 00:04:55,770
حاليّاً، أعمال الكاتدرائيّة تعتمد
بشكل كبير على فيرديناند-ساما

60
00:04:56,140 --> 00:04:58,320
،الآن، من دون خُلفاء مُدرَّبين جيّداً

61
00:04:58,320 --> 00:05:00,870
!سينهار كُلّ شيء إذا حدث شيء كهذا

62
00:05:01,270 --> 00:05:04,260
،وفوق كُلّ ذلك، إذا غادر فيرديناند-ساما

63
00:05:04,260 --> 00:05:07,140
فسيُصبح العبء على عاتقي طاغياً

64
00:05:07,140 --> 00:05:09,220
!سوف أنهار حتماً

65
00:05:09,960 --> 00:05:12,400
ستكون تلك مُشكلة حقيقيّة

66
00:05:13,410 --> 00:05:15,950
يسرّني أنّك فهمت

67
00:05:15,950 --> 00:05:17,390
...لكن

68
00:05:17,910 --> 00:05:21,800
هل تعلمين سبب وجود فيرديناند
في الكاتدرائيّة؟

69
00:05:21,800 --> 00:05:24,910
،بجمع خيوط المعلومات المُتنوِّعة معاً

70
00:05:24,910 --> 00:05:30,670
يبدو أنّه دخلَ إلى الكاتدرائيّة للهرب
...من مُضايقات أمّك

71
00:05:30,670 --> 00:05:32,050
...لكن التّفاصيل

72
00:05:34,200 --> 00:05:36,810
...كانت امرأة قاسية أساساً، لكن

73
00:05:37,090 --> 00:05:39,700
قبل فترة قصيرة من وفاة
،الأرشيدوق السّابق

74
00:05:39,700 --> 00:05:44,820
ازداد حقد فيرونيكا-ساما لدرجة تهديد
حياة فيرديناند

75
00:05:45,130 --> 00:05:46,580
لطالما اعتقدت أمّي

76
00:05:46,580 --> 00:05:49,220
بأنّ فيرديناند كان يتمنّى وفاة
الأرشيدوق السّابق

77
00:05:49,220 --> 00:05:52,320
وكان يخطِّط للسّيطرة على المنصِب

78
00:05:52,580 --> 00:05:55,380
...هذا جنون الارتياب

79
00:05:55,380 --> 00:05:56,810
،من أجل تفريقهما

80
00:05:56,810 --> 00:06:00,440
كنتُ أنا من طلب من فيرديناند
دخول الكاتدرائيّة

81
00:06:01,210 --> 00:06:03,110
حتّى بعد وفاة أبي

82
00:06:03,110 --> 00:06:06,640
،وبعد أن أصبحتُ الأرشيدوق
...لم تتغيّر أمّي

83
00:06:07,230 --> 00:06:10,960
لا أريد ترك فيرديناند في وضع كهذا

84
00:06:12,510 --> 00:06:15,840
ما زال قلقاً بشأن ذلك؟ إنّه مُزعج للغاية

85
00:06:16,250 --> 00:06:17,600
ماذا ستفعل؟

86
00:06:17,840 --> 00:06:19,350
أفعل؟

87
00:06:19,620 --> 00:06:22,140
أتفهّم حسرة أبي

88
00:06:22,140 --> 00:06:25,480
،لكن بالنّظر إلى صحّتك

89
00:06:25,480 --> 00:06:28,430
أعتقد من الأفضل ألّا تُغيّر بيئتك

90
00:06:28,430 --> 00:06:32,990
إن كنت لا ترغب في العودة، فسوف أتكلّم
مع أبي بموجب رغبتك

91
00:06:33,260 --> 00:06:35,760
لا، لا ضرورة لذلك

92
00:06:35,760 --> 00:06:38,460
سيعمل على إعادتي غالباً
،إلى العالم الدّنيويّ

93
00:06:38,460 --> 00:06:41,760
ثمّ يُرسلني للعمل في الكاتدرائيّة
تحت أوامره

94
00:06:41,760 --> 00:06:44,620
،إذا لم يتغيّر منصبي ككبير كهنة

95
00:06:44,620 --> 00:06:46,610
فلن تُواجهي أي مُعوِّقات

96
00:06:48,360 --> 00:06:51,550
فوق كُلّ هذا، إيكهارد وإيوستاكيوس قد تعرّضا

97
00:06:51,550 --> 00:06:55,610
لتصرُّفات حقد وضغينة بمُجرّد ارتباطهما بي

98
00:06:56,020 --> 00:06:59,510
سيكون من الجيّد العودة إلى الطّبقة
النّبيلة من أجل سُمعتهما كذلك

99
00:06:59,510 --> 00:07:01,010
كبير الكهنة

100
00:07:01,320 --> 00:07:02,270
ما الأمر؟

101
00:07:02,660 --> 00:07:04,940
لا أكترث بشأن أفضليّات ومُعوِّقات الآخرين

102
00:07:04,940 --> 00:07:09,020
أسألك كيف هو شعورك تجاه العودة شخصيّاً

103
00:07:09,370 --> 00:07:11,220
شعوري أنا؟

104
00:07:11,220 --> 00:07:12,680
ماذا ستفعل؟

105
00:07:14,300 --> 00:07:19,030
سأُسحَب إلى القلعة للمُساهمة في
العمل الإداريّ في كلّ الأحوال

106
00:07:19,030 --> 00:07:22,540
في هذه الحالة، ينبغي أن أختار الخيار
الّذي يُوفِّر الأفضليّات الكُبرى

107
00:07:22,910 --> 00:07:27,470
أردتُ سماعك تقول "تريد" لا "ينبغي" هنا

108
00:07:27,930 --> 00:07:29,420
فهمت

109
00:07:29,420 --> 00:07:31,810
...إن كان هذا هو رأيك يا كبير الكهنة

110
00:07:33,860 --> 00:07:36,320
يبدو أنّه يرغب في الإعلان عن عودتك

111
00:07:36,320 --> 00:07:39,600
عندما يجتمع كافّة النُّبلاء في مراسم النُّجوم

112
00:07:39,950 --> 00:07:42,750
،قيل لي بأنّك بعد أن تعود إلى صفوف النُّبلاء

113
00:07:42,750 --> 00:07:44,940
سوف تُصبح وصيّي رسميّاً

114
00:07:44,940 --> 00:07:47,220
وصيّكِ؟

115
00:07:47,220 --> 00:07:49,680
لعلَّ العودة كانت قراراً عجولاً

116
00:07:49,680 --> 00:07:51,570
!ما معنى هذا بالضّبط؟

117
00:07:51,570 --> 00:07:53,570
ما قلتُه تماماً

118
00:07:56,070 --> 00:07:57,010
...ثمّ

119
00:07:57,010 --> 00:07:58,760
أجرينا التّحضيرات

120
00:07:58,760 --> 00:08:02,880
لحدث المبيعات في القلعة
ومراسم اجتماع النُّجوم

121
00:08:07,440 --> 00:08:12,110
!آمل أن يقبل الجميع زيّ بريغيتّي الجديد

122
00:08:16,220 --> 00:08:17,960
أتيتَ يا فيرديناند

123
00:08:18,300 --> 00:08:21,590
على ذكر الأمر، لماذا عباءته بلون مُختلف؟

124
00:08:40,970 --> 00:08:44,270
يمكنك الزّواج إذا عدتَ إلى
الطّبقة النّبيلة، صحيح؟

125
00:08:44,270 --> 00:08:47,100
ألا ينبغي أن تبحث عن شريكة؟

126
00:08:47,420 --> 00:08:48,710
لا جدوى من ذلك

127
00:08:48,710 --> 00:08:52,040
لا توجد امرأة هنا تُوافق مُستوى المانا خاصّتي

128
00:08:52,040 --> 00:08:53,560
ولا واحدة حتّى؟

129
00:08:55,230 --> 00:08:59,140
يبدو أنّ امتلاك مقدار كبير من المانا
...قد يكون مُشكلة حقيقيّة أيضاً

130
00:08:59,380 --> 00:09:03,650
في هذه الحالة، لِمَ لا تتزوّج روزيماين ببساطة؟

131
00:09:05,920 --> 00:09:08,890
كلّما كبِرَتْ، قدرة المانا خاصّتها
سوف تتوافق مع خاصّتك غالباً

132
00:09:09,240 --> 00:09:12,550
تريدني أن أهتمّ بهذه الطّفلة المُشاكسة
طيلة حياتي؟

133
00:09:12,550 --> 00:09:14,530
!أيّ مزحة قاسية هي هذه؟

134
00:09:14,530 --> 00:09:16,580
!تماماً

135
00:09:16,580 --> 00:09:18,980
،إذا كان عليّ الإصغاء لهذا المُزعج اللّحوح للأبد

136
00:09:18,980 --> 00:09:22,040
!فلن تعدو كونها أكثر من نكتة قاسية

137
00:09:22,040 --> 00:09:24,140
أنتما مُتناغمان بشكل مثاليّ

138
00:09:24,140 --> 00:09:26,300
أجل، بالفعل

139
00:09:26,590 --> 00:09:29,530
روزيماين، ستسنح لكِ أعظم فُرصة
لإيجاد شخص

140
00:09:29,530 --> 00:09:32,960
يتوافق مع مُستوى المانا خاصّتكِ
أثناء وجودكِ في الأكاديميّة الملكيّة

141
00:09:32,960 --> 00:09:36,050
أخفي طبيعتكِ الحقيقيّة وابحثي
عن شريك بجدّية

142
00:09:36,380 --> 00:09:40,540
سأبذل جهوداً حثيثة للعثور على
!شريك لديه مكتبة كبيرة

143
00:09:40,830 --> 00:09:43,720
لا تُقرّري في مسألة هامّة كهذه تؤثّر
!على منطقة نفوذكِ من تلقاء نفسكِ

144
00:09:43,720 --> 00:09:46,940
لا يملك فيرديناند الصّلاحيّة لمنحكِ
!هذا النّوع من الإذن

145
00:09:47,330 --> 00:09:48,790
عمّاذا تتكلّم؟

146
00:09:48,790 --> 00:09:52,440
سوف أصبح وصيّ روزيماين رسميّاً

147
00:09:53,740 --> 00:09:56,940
الوصيّ هو بمثابة الأب، صحيح؟

148
00:10:02,120 --> 00:10:03,570
!مُذهلة

149
00:10:11,330 --> 00:10:12,580
...جميلة للغاية

150
00:10:22,970 --> 00:10:26,970
من الصّعب التّصديق بأنّ هذه هي
نفس الفارسة في العام الماضي

151
00:10:28,550 --> 00:10:31,740
أليست فارسِتي الحارِسة جميلة؟

152
00:10:35,120 --> 00:10:38,360
سنبدأ الآن بمراسم اجتماع النُّجوم

153
00:10:38,360 --> 00:10:40,380
!والآن أيّها العروسات والعرسان، تجمّعوا

154
00:10:42,460 --> 00:10:46,860
عسى أن تُباركهم بحمايتك القدسيّة

155
00:10:55,580 --> 00:10:57,640
!تمّ عملي

156
00:10:59,970 --> 00:11:02,320
والآن حان دور البالغين

157
00:11:02,320 --> 00:11:05,690
بما أنّ دوري قد انتهى، حان الوقت
...كي أخرج

158
00:11:09,330 --> 00:11:12,430
هذا ليس وقتاً مُناسباً لتكون
!فيه جباناً يا دامويل

159
00:11:12,430 --> 00:11:13,670
سموّ الأميرة

160
00:11:17,230 --> 00:11:19,730
...فـ-فهمت

161
00:11:24,110 --> 00:11:25,830
!أريد أن أعرف

162
00:11:25,830 --> 00:11:29,230
!ماذا سيحدث لدامويل وبريغيتّي؟

163
00:11:30,000 --> 00:11:33,760
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

164
00:11:36,300 --> 00:11:40,010
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

165
00:11:45,590 --> 00:11:47,760
من فضلكِ يا أمّي

166
00:11:50,230 --> 00:11:51,780
أمّي؟

167
00:11:52,410 --> 00:11:54,610
المعذرة، أنا آسفة

168
00:11:58,510 --> 00:12:03,520
،عذراً، إن كنتِ تشعرين بوعكة
فيمكننا احتساء الشّاي في يوم آخر

169
00:12:03,820 --> 00:12:05,880
الأمر ليس كذلك

170
00:12:05,880 --> 00:12:10,910
عندما أُفكِّر في بريغيتّي في اللّيلة
...الماضية، يوجهني قلبي

171
00:12:10,910 --> 00:12:13,280
!ماذا حدث؟

172
00:12:13,910 --> 00:12:16,040
...بريغيتّي في اللّيلة الماضية

173
00:12:16,040 --> 00:12:18,620
كانت مُدهشة ببساطة

174
00:12:19,680 --> 00:12:25,420
بدأ كُلُّ شيء بُعيد إعلان عودة
...فيردينناد-ساما

175
00:12:26,720 --> 00:12:28,330
إيلفيرا-ساما

176
00:12:28,870 --> 00:12:30,690
...هاسهايت

177
00:12:30,690 --> 00:12:35,050
ظهرَ خطيب بريغيتّي السّابق أمامها

178
00:12:33,300 --> 00:12:37,940
m 0 0 l 165 0 165 40 0 40

179
00:12:33,300 --> 00:12:37,940
خطيب بريغيتّي السّابق
هاسهايت

180
00:12:35,050 --> 00:12:39,400
إيلفيرا-ساما، يبدو أنّ خيوطي
،الّتي حاكَتْها إلَهة الزّمن

181
00:12:39,400 --> 00:12:42,060
قد تشابكتْ مع خيوط الآنسة بريغيتّي

182
00:12:42,360 --> 00:12:45,780
هلّا قضيتُ بعض الوقت معها؟

183
00:12:50,180 --> 00:12:52,570
...لا أملك سبباً لمنعك

184
00:12:52,950 --> 00:12:56,710
المُهمّ أن تبقيا ضمن مجال نظري

185
00:12:59,520 --> 00:13:01,840
ماذا تريد منّي؟

186
00:13:02,460 --> 00:13:05,330
!يا لها من كلمات باردة

187
00:13:05,590 --> 00:13:09,970
هل تحاولين تجميد قلبي الآن
بعد جرحه بشكل بليغ

188
00:13:09,970 --> 00:13:12,590
من خلال فسخ خطوبتنا؟

189
00:13:12,880 --> 00:13:15,110
...كانت بريغيتّي ترتجف من الغضب

190
00:13:15,410 --> 00:13:19,390
ولا تُلام على ذلك. فسبب فسخها للخطوبة

191
00:13:19,390 --> 00:13:25,100
كان لأنّ هاسهايت حاول الاستيلاء
على منصب أخيها، غيبي إيلغنير

192
00:13:25,690 --> 00:13:30,520
كيفما عاملتِني، سأبقى أُفكِّر فيكِ

193
00:13:30,930 --> 00:13:34,550
،لا أحد سوى إله الحياة، إيويغليبين

194
00:13:34,550 --> 00:13:38,500
سيرغب في إلَهة أرض ذابِلة، غيدولدي

195
00:13:40,040 --> 00:13:44,130
بريغيتّي، آمل أن تَقبلي يدي هذه المرّة

196
00:13:44,440 --> 00:13:49,890
فأنا أستطيع استعادة كرامتكِ المجروحة

197
00:13:50,710 --> 00:13:54,580
هل يُعقَل أنّ هاسهايت-ساما
لم يكن مُجتهداً في دراسته؟

198
00:13:56,040 --> 00:14:01,520
حتّى غيدولدي الذّابلة كان يرغبها الكثيرون

199
00:14:01,860 --> 00:14:03,900
!هيّا يا دامويل

200
00:14:04,850 --> 00:14:08,280
...ا-المعذرة، حسناً

201
00:14:12,530 --> 00:14:15,170
بريغيتّي هي نبيلة مُتوسِّطة الطّبقة

202
00:14:15,170 --> 00:14:18,160
لا مكان لنبيل مُتدنٍّ مثلك هنا

203
00:14:20,380 --> 00:14:22,660
ينبغي أن تدرك حجمك

204
00:14:28,820 --> 00:14:30,040
...حجمي

205
00:14:30,300 --> 00:14:31,300
ماذا؟

206
00:14:31,530 --> 00:14:36,560
إدراك حجمي والتّراجُع هو ما جعلَني
أتلقّى عِقاباً

207
00:14:36,880 --> 00:14:39,410
عندما يكون لدى فارس أحد
،يجب عليه حمايته

208
00:14:39,410 --> 00:14:41,820
فلا يستطيع التّراجُع فقط بسبب المكانة

209
00:14:41,820 --> 00:14:45,050
لهذا السّبب لا أستطيع التّراجُع
في هذه اللّحظة

210
00:14:52,960 --> 00:14:56,860
من خلال توجيه الزّوجين المُقدّسين اللّذين
،يقطنان في أعالي الجِنان

211
00:14:56,860 --> 00:14:58,780
تمكّنتُ من اللِّقاء بكِ

212
00:15:00,580 --> 00:15:05,210
أتمنّى أن تُصبحي إلَهة النُّور
خاصّتي، يا بريغيتّي

213
00:15:06,200 --> 00:15:07,380
...لكن

214
00:15:08,100 --> 00:15:13,610
أتفهّم شعوركِ بعدم الرّاحة كوني
نبيلاً أدنى

215
00:15:13,610 --> 00:15:19,970
لكن سأرفع المانا خاصّتي بما يُلائمكِ
في غضون عام وأتقدّم لخطبتكِ رسميّاً

216
00:15:21,320 --> 00:15:25,650
إلى ذلك الحين، هلّا انتظرتِني دون
قبول أي عروض زواج أُخرى؟

217
00:15:29,480 --> 00:15:31,350
هل أنت راضٍ الآن؟

218
00:15:31,350 --> 00:15:33,550
!إن كان كذلك، فينبغي أن تُغادر فوراً

219
00:15:33,550 --> 00:15:34,850
هاسهايت-ساما

220
00:15:35,610 --> 00:15:38,140
أنا آسفة جدّاً

221
00:15:38,140 --> 00:15:43,530
يبدو أنّ هناك آخرين يريدون
غيدولدي ذابِلة كهذه

222
00:15:44,080 --> 00:15:45,370
!ماذا؟

223
00:15:54,150 --> 00:15:57,460
أنا مسرورة جدّاً بعرضك يا دامويل

224
00:15:58,040 --> 00:16:00,540
سأنتظر حتّى عام من الآن

225
00:16:05,770 --> 00:16:11,140
في اللّيلة الماضية، كانا ذلكما الاثنان
كشخصيّتين من رواية فُرسان

226
00:16:11,140 --> 00:16:15,710
إذاً، الطّلب في أن تكون إلَهة النُّور خاصّته

227
00:16:15,710 --> 00:16:19,410
هو أشبه بالطّلب منها الزّواج منه، صحيح؟

228
00:16:22,140 --> 00:16:24,420
!إنّها لا تصغي إطلاقاً

229
00:16:30,160 --> 00:16:33,470
على أيّ حال، ليس هاسهايت فقط

230
00:16:33,470 --> 00:16:37,680
سيبدأ النُّبلاء بالتجمُّع حول
أولئك المُقرّبين منكِ

231
00:16:37,680 --> 00:16:39,430
ماذا تقصدين؟

232
00:16:39,430 --> 00:16:41,860
الآن بعد أن عاد فيرديناند-ساما إلى

233
00:16:41,860 --> 00:16:44,350
،العالم الدّنيويّ وأصبح وصيّكِ

234
00:16:44,350 --> 00:16:48,430
من المُؤكَّد أنَّ نُبلاء فِرقة فيرونيكا
سوف يفقدون نفوذَهم

235
00:16:48,890 --> 00:16:51,650
،إذاً تقصدين بأنّ فِرقة فيرونيكا

236
00:16:51,650 --> 00:16:56,190
،بعد فقدان ركن من أركان دعمهم
سيُحاولون كسب استحساني؟

237
00:16:56,190 --> 00:17:01,190
ليس فِرقة فيرونيكا فحسب. كافّة النُّبلاء

238
00:17:02,580 --> 00:17:07,340
من الآن فصاعداً، يجب عليكِ
أن تكوني أكثر يقظة

239
00:17:07,620 --> 00:17:08,660
!حسناً

240
00:17:14,860 --> 00:17:19,100
شكراً لكِ حقّاً لاقتطاعكِ من وقتكِ
واللّقاء بأخي

241
00:17:19,100 --> 00:17:23,090
كنتُ أرغب أيضاً في اللّقاء بغيبي إيلغنير

242
00:17:25,850 --> 00:17:27,980
!أتطلّع بشوق للعام المُقبل

243
00:17:31,850 --> 00:17:34,870
يبدو أنّ القصّة قد انتشرت في أرجاء القلعة

244
00:17:35,360 --> 00:17:39,620
رغم أنّ دامويل فعلَها فقط لحماية كرامتي

245
00:17:39,620 --> 00:17:40,630
!ماذا؟

246
00:17:41,110 --> 00:17:43,580
!لم تتّخذ الأمر بجدّية؟

247
00:17:44,400 --> 00:17:47,370
مع ذلك، كنتُ سعيدة للغاية

248
00:17:47,990 --> 00:17:50,120
...أ-أجل

249
00:17:50,120 --> 00:17:52,270
بعد عام من الآن؟

250
00:17:52,270 --> 00:17:55,730
آمل أن يتمكّن من تعزيز مُستوى
المانا خاصّته في الوقت

251
00:18:02,230 --> 00:18:08,480
مهما شكرتُكِ لا أوفيكِ حقّكِ على
الزيّ الجديد الّذي منحتِه لبريغيتّي

252
00:18:02,440 --> 00:18:07,390
m 0 0 l 200 0 200 40 0 40

253
00:18:02,440 --> 00:18:07,390
الأخ الأكبر لبريغيتّي
غيبي إيلغنير

254
00:18:08,870 --> 00:18:13,260
،لا أعلم ما إن سيكون كافياً التّعبير عن امتناني
لكن من فضلكِ تعالي إلى إيلغنير

255
00:18:13,260 --> 00:18:14,670
!بكلِّ تأكيد

256
00:18:14,670 --> 00:18:18,390
!لطالما أردتُ زيارة إيلغنير

257
00:18:20,050 --> 00:18:24,040
ألم يُطلَب منكِ توخّي حذر أكبر للتو؟

258
00:18:25,580 --> 00:18:26,940
روزيماين

259
00:18:26,940 --> 00:18:32,190
يريد غيبي إيلغنير أن يُري هاسهايت
بأنّه لديه دعم

260
00:18:32,190 --> 00:18:35,640
ابنة الأرشيدوق بالتبنِّي لدرء
أي مشاكل مُستقبليّة

261
00:18:38,700 --> 00:18:41,530
أجيبي أثناء وضع ذلك في الحسبان

262
00:18:42,280 --> 00:18:43,900
لا أُمانع

263
00:18:43,900 --> 00:18:45,550
روزيماين-ساما؟

264
00:18:45,550 --> 00:18:49,480
إجراء بحث على ورق النّبات في إيلغنير

265
00:18:49,480 --> 00:18:51,940
هو شيء حقّقَ لي المنفعة

266
00:18:52,360 --> 00:18:54,810
...بحث حول ورق النّبات

267
00:18:55,090 --> 00:18:58,530
الطّباعة تتطلّب ورقاً

268
00:18:58,530 --> 00:19:03,830
لتوسيع صناعة الطّباعة، يجب علينا إنشاء
ورشات ورق النّبات

269
00:19:04,140 --> 00:19:07,820
هل تأتمنين إيلغنير على هذا؟

270
00:19:08,720 --> 00:19:09,820
أجل

271
00:19:10,270 --> 00:19:11,540
!هذا شرفٌ لي

272
00:19:11,820 --> 00:19:18,460
،إذاً سأستدعي شركة بلانتين
ورشة الطّباعة الحصريّة لي

273
00:19:18,460 --> 00:19:22,740
من فضلك اسمح لي بتعريفك عليهم
ثانية كذلك يا فيرديناند-ساما

274
00:19:26,060 --> 00:19:27,390
...ثمّ

275
00:19:33,500 --> 00:19:38,110
سنبدأ الآن بحدث مبيعات شركة بلانتين

276
00:19:43,410 --> 00:19:44,790
،روزيماين-ساما

277
00:19:45,900 --> 00:19:48,610
حضّرنا ما طلبتِه

278
00:19:48,610 --> 00:19:51,450
...عُلِم. إذاً، فلنبدأ

279
00:19:54,480 --> 00:19:58,550
هذه هي النّوتات الموسيقيّة للمقطوعات
...الّتي عزفَها فيرديناند-ساما في الحفل الموسيقيّ

280
00:19:58,550 --> 00:20:01,060
من فضلكِ اعتني بها جيّداً

281
00:20:04,030 --> 00:20:06,970
روزيماين-ساما، المعذرة، هل لديكِ

282
00:20:06,970 --> 00:20:10,650
أي لوحة من اللّوحات الّتي بيعَتْ
في الحفل الموسيقيّ؟

283
00:20:10,650 --> 00:20:12,200
لا

284
00:20:12,200 --> 00:20:13,920
هكذا إذاً

285
00:20:13,930 --> 00:20:16,750
...إن لم تُمانعي، كعمليّة تبادُل

286
00:20:25,320 --> 00:20:26,700
!ما هذه؟

287
00:20:26,700 --> 00:20:29,950
إنّها مجموعة خاصّة من الرُّسوم
من حكايا الفُرسان

288
00:20:31,930 --> 00:20:36,460
بالمُناسبة، حكايا الفُرسان هذه
هي عمل خياليّ

289
00:20:36,460 --> 00:20:40,740
كافّة الشّخصيّات والمُنظّمات الّتي تظهر
فيها هي من وحي الخيال

290
00:20:40,740 --> 00:20:42,950
،حتّى لو بدت مُشابهة لشخصيّات حقيقيّة
فإنّها تبقى مُختلفة

291
00:20:43,810 --> 00:20:44,540
،إذاً

292
00:20:44,540 --> 00:20:48,410
أريد نسخة من حكاية الفارس الّذي
يُقدّم حجر ماسيكي لأميرة

293
00:20:51,230 --> 00:20:55,470
رغم ذلك، من المُؤسف ألّا تتوفّر
أي رسومات للبيع

294
00:20:55,870 --> 00:20:58,980
...منعَ فيرديناند-ساما ذلك

295
00:20:59,500 --> 00:21:01,480
أما من شيء يمكننا فعله؟

296
00:21:01,800 --> 00:21:05,650
،حتّى لو قلتِ ذلك، بعض الأمور مُستحيلة

297
00:21:05,650 --> 00:21:08,920
يا أمّي... بالنّسبة لي

298
00:21:09,500 --> 00:21:11,270
هذا صحيح

299
00:21:11,270 --> 00:21:12,540
!صحيح تماماً

300
00:21:12,540 --> 00:21:15,160
إنّها مُستحيلة بالنّسبة لكِ، أليس كذلك؟

301
00:21:15,160 --> 00:21:20,260
أجل. مع الأسف، كنتُ ممنوعة من فعلها

302
00:21:20,810 --> 00:21:26,130
روزيماين، يريد الأوب توسيع
مجال الطّباعة، صحيح؟

303
00:21:26,430 --> 00:21:27,630
أجل

304
00:21:27,630 --> 00:21:32,860
في هذه الحالة، سأطلب من أخي
،الأكبر، غيبي هالدينزيل

305
00:21:32,860 --> 00:21:37,020
مُساعدتي في نشر أعمال ابنتي الظّريفة

306
00:21:37,270 --> 00:21:40,250
أتطلّع بلهفة لذلك يا أمّي

307
00:21:40,250 --> 00:21:42,330
حسناً يا روزيماين

308
00:23:18,040 --> 00:23:21,050
الحلقة القادمة
تفتيش إيلغنير وتجمُّع الصّيف

309
00:23:22,670 --> 00:23:25,360
!فيرديناند-ساما، يا للرّوعة

310
00:23:25,360 --> 00:23:28,050
!فيرديناند-ساما، يا للأناقة

311
00:23:28,050 --> 00:23:31,200
!فيرديناند-ساما، يا للجمال

312
00:23:31,200 --> 00:23:33,180
أمّي. أمّي

313
00:23:33,180 --> 00:23:35,420
ما الأمر يا روزيماين؟

314
00:23:37,940 --> 00:23:40,570
.هذه القصّة خياليّة

315
00:23:40,550 --> 00:23:42,590
—كيفما نظرتِ له، إنّه فيردينـ

316
00:23:41,880 --> 00:23:44,310
!إنّه ليس كذلك

317
00:23:44,980 --> 00:23:50,010
الرّسم بواسطة: مانمارو إينو