1
00:00:12,500 --> 00:00:18,300
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

2
00:01:30,030 --> 00:01:35,030
الحلقة 24
إنقاذ

3
00:01:35,790 --> 00:01:39,280
أتمّتْ روزيماين بنجاح تعميد تشارلوت

4
00:01:39,280 --> 00:01:40,340
...لكن

5
00:01:40,790 --> 00:01:43,920
!هوجِمنا بالقرب من المُلحَق الشّماليّ

6
00:01:46,030 --> 00:01:47,690
!أغلقوا القاعة الكبيرة

7
00:01:47,690 --> 00:01:51,090
!أيّ نبيل غير حاضر سيُوضَع تحت دائرة الشكّ

8
00:01:52,360 --> 00:01:55,220
لا أرى الفيكونت غيرلاخ في أيّ مكان

9
00:01:55,220 --> 00:01:56,960
...ذهبَ لإحضار شيء للشّرب

10
00:02:01,120 --> 00:02:01,970
!سُمّ؟

11
00:02:02,180 --> 00:02:05,760
هناك عربة غير مُراقبة مركونة خارج المطبخ

12
00:02:05,760 --> 00:02:07,090
خذها إلى هناك

13
00:02:11,110 --> 00:02:14,290
!سأنقذ روزيماين حتماً

14
00:02:27,910 --> 00:02:29,320
!بونيفاتيوس-ساما

15
00:02:29,740 --> 00:02:31,890
دمّر نفسه ذاتيّاً

16
00:02:31,890 --> 00:02:34,640
الأهمّ، ماذا حدث لروزيماين وتشارلوت؟

17
00:02:40,770 --> 00:02:41,960
!أنغيليكا

18
00:02:42,740 --> 00:02:45,900
!أميرتنا الصّغيرة تشارلوت بأمان

19
00:02:46,120 --> 00:02:51,140
!أتتْ أختي لإنقاذي واختُطِفت بواسطة شخص

20
00:02:51,450 --> 00:02:52,400
!ماذا؟

21
00:02:52,400 --> 00:02:55,010
كورنيليوس يُلاحقه حاليّاً

22
00:02:55,010 --> 00:02:56,770
سوف أُطارده كذلك

23
00:02:59,380 --> 00:03:00,790
!سأذهب أنا

24
00:03:17,030 --> 00:03:18,250
!أهذا هو؟

25
00:03:31,510 --> 00:03:33,310
!اهدأ

26
00:03:34,630 --> 00:03:37,600
!توقّف

27
00:03:37,600 --> 00:03:39,280
!أنت هو

28
00:03:39,280 --> 00:03:40,950
...ماذا؟ هذا الصّوت

29
00:03:43,270 --> 00:03:47,330
!أنت الأحمق الّذي اختطفَ حفيدتي الوحيدة

30
00:03:47,330 --> 00:03:49,330
!جـ-جدّي؟

31
00:04:01,570 --> 00:04:02,970
أهذا هو؟

32
00:04:04,970 --> 00:04:07,470
روزيماين، هل أنتِ في الدّاخل؟

33
00:04:07,470 --> 00:04:09,690
!جدّي! أنا مقلوبة

34
00:04:09,690 --> 00:04:13,480
لا أستطيع الشّعور بشيء، لكن
!الدّم يتدفّق إلى رأسي

35
00:04:15,480 --> 00:04:18,730
!توقّف! كُفّ عن هزّي

36
00:04:18,730 --> 00:04:20,170
لا يوجد ردّ

37
00:04:20,170 --> 00:04:22,880
...لا يُمكن أن تكون قد ماتت

38
00:04:25,670 --> 00:04:28,970
!روزيماين! سأُخرجكِ في الحال

39
00:04:34,440 --> 00:04:36,410
!مُستحيل! سأموت

40
00:04:36,410 --> 00:04:40,410
!فليُوقف أحدٌ جدّي

41
00:04:42,830 --> 00:04:46,530
!حلّقتْ روزيماين بعيداً

42
00:04:46,920 --> 00:04:49,050
!سأموت

43
00:04:58,130 --> 00:04:59,790
!كبير الكهنة

44
00:05:00,680 --> 00:05:01,930
...فيرديناند

45
00:05:03,760 --> 00:05:05,470
،بونيفاتيوس-ساما

46
00:05:05,470 --> 00:05:10,280
هل نسيت بأنّ كارستيد قد أخبرك
بألّا تقترب من روزيماين؟

47
00:05:10,690 --> 00:05:11,930
...عجباً

48
00:05:12,380 --> 00:05:17,780
أتفهّم قلقك، لكن مثل هذه التصرُّفات
قد تقتل حتّى أكثر النّاس السّليمين صحّياً

49
00:05:18,700 --> 00:05:21,040
هل أنتِ بخير يا روزيماين؟

50
00:05:21,040 --> 00:05:25,020
كبير الكهنة، أنقذت حياتي

51
00:05:27,330 --> 00:05:30,060
روزيماين لم تمُت، أليس كذلك؟

52
00:05:32,740 --> 00:05:38,230
إنّها لا تستجيب إطلاقاً، لذا لا يمكنني القول
بأنّها بخير، لكن نبضها يعمل

53
00:05:40,430 --> 00:05:42,160
...رائحة الدّواء

54
00:05:42,160 --> 00:05:43,180
هذا سيّئ

55
00:05:43,510 --> 00:05:45,630
من بين كُلّ الأشياء الّتي يمكنهم
!استخدامها، استخدموا هذا

56
00:05:46,060 --> 00:05:47,200
ما الخطب؟

57
00:05:47,440 --> 00:05:49,400
علينا إزالة السّمّيّة عنها فوراً

58
00:05:49,400 --> 00:05:51,830
على هذا المُعدّل، روزيماين ستموت

59
00:05:51,830 --> 00:05:52,830
!ماذا؟-
!ماذا؟-

60
00:06:06,220 --> 00:06:11,190
يُقاوم هذا الدّواء الآثار ليُكسبنا بعض الوقت

61
00:06:11,570 --> 00:06:14,490
يجب علينا العودة إلى ورشتي
من أجل التّرياق الفعليّ

62
00:06:14,490 --> 00:06:16,590
،سآخذها إلى ورشتي في الكاتدرائيّة فوراً

63
00:06:16,590 --> 00:06:19,110
حيث يمكنها تلقّي العِلاج والنّقاهة

64
00:06:19,110 --> 00:06:21,420
!ماذا؟ الكاتدرائيّة؟

65
00:06:21,420 --> 00:06:24,600
...كيف لروزيماين أن تُعالَج في مكان كذلك

66
00:06:24,870 --> 00:06:26,910
أعرف ضعفَ روزيماين

67
00:06:26,910 --> 00:06:31,010
ومقدار الدّواء الّذي يمكن منحها إيّاه

68
00:06:31,010 --> 00:06:34,670
وفوق كُلّ هذا، إنّه مكانٌ أفضل من القلعة
بمُجرّد حقيقة أنّ

69
00:06:34,670 --> 00:06:36,740
لا أحد من النّبلاء يستطيع الاقتراب

70
00:06:36,740 --> 00:06:39,710
حتّى التكلُّم بهذه الطّريقة هو مضيعة
للوقت الثّمين، لذا اعذرني

71
00:06:40,400 --> 00:06:41,460
!انتظر

72
00:06:41,460 --> 00:06:43,880
!سيتمّ الاهتمام بروزيماين في منزلي

73
00:06:45,510 --> 00:06:48,560
!أنا الوحيد القادر على إنقاذ روزيماين الآن

74
00:06:48,560 --> 00:06:50,000
!لا تعترض طريقي

75
00:06:53,300 --> 00:06:57,890
جدّي، من فضلك اترك روزيماين
!لفيرديناند-ساما

76
00:07:00,450 --> 00:07:03,890
فيرديناند-ساما، هذا حجر ماسيكي
الوحش السّامي الخاصّ بروزيماين

77
00:07:07,270 --> 00:07:09,020
...أعتذر على عجزي عن حمايتها

78
00:07:09,850 --> 00:07:12,530
لا تقلق بشأن ذلك يا أخي

79
00:07:12,770 --> 00:07:17,290
إن كنت تشعر بالحسرة، فاذهب واقبض
على أولئك الّذين أذوا روزيماين

80
00:07:17,540 --> 00:07:19,750
ينبغي أن يكون الجاني نبيلاً

81
00:07:19,750 --> 00:07:20,810
...أجل

82
00:07:24,460 --> 00:07:25,540
!أنغيليكا؟

83
00:07:25,820 --> 00:07:27,540
هل قبضَتْ على العدوّ؟

84
00:07:28,170 --> 00:07:31,340
بونيفاتيوس-ساما، من فضلك اقبض
على الجاني بطريقة

85
00:07:31,340 --> 00:07:33,380
تسمح لنا الحصول على معلومات منه

86
00:07:33,770 --> 00:07:36,680
وإلّا فلن نتمكّن من البحث في ذكرياته

87
00:07:36,680 --> 00:07:41,170
فهمت. فيرديناند، اهتمّ بحفيدتي

88
00:07:42,930 --> 00:07:45,170
هيّا بنا يا كورنيليوس

89
00:07:45,170 --> 00:07:46,840
!حاضر يا جدّي

90
00:07:56,640 --> 00:08:00,560
روزيماين، سوف أنقذك حتماً

91
00:08:00,560 --> 00:08:03,770
!لذا يجب عليكِ مُقاومة العقّار حتّى النّهاية

92
00:08:26,170 --> 00:08:28,280
أعتقد بأنّنا وصلنا في الوقت

93
00:08:30,310 --> 00:08:32,340
سأحضِّر اليوريفي

94
00:08:47,780 --> 00:08:50,600
هل أنت بخير يا روزيماين-ساما؟

95
00:08:50,600 --> 00:08:52,260
سأقرأ كُتُباً لكِ

96
00:08:52,260 --> 00:08:55,760
!لذا، من فضلكِ تعافي قريباً، يا روزيماين-ساما

97
00:08:56,390 --> 00:08:57,920
...أنتم

98
00:09:02,830 --> 00:09:04,660
!روزيماين-ساما

99
00:09:04,660 --> 00:09:06,130
...عينايّ

100
00:09:11,610 --> 00:09:14,820
...فران... والجميع

101
00:09:16,520 --> 00:09:17,840
!هذا مُطمئن

102
00:09:16,640 --> 00:09:18,210
!روزيماين-ساما

103
00:09:27,290 --> 00:09:30,990
كبير الكهنة، روزيماين-ساما
قد فتحتْ عينيها

104
00:09:33,290 --> 00:09:35,270
...كبير الكهنة

105
00:09:35,270 --> 00:09:39,790
...يبدو أنّ المانا خاصّتي تتصلّب

106
00:09:40,140 --> 00:09:42,430
اشربي اليوريفي فوراً

107
00:09:56,350 --> 00:09:58,340
فران، أحضرها إلى هنا

108
00:10:22,690 --> 00:10:25,820
يبدو أنّه لا توجد مُشكلة في الدّائرة السّحريّة

109
00:10:25,820 --> 00:10:28,230
...لكن، المانا خاصّتكِ

110
00:10:28,980 --> 00:10:32,480
...أشعر بنُعاس

111
00:10:32,480 --> 00:10:34,570
الدّواء يأخذ مفعوله

112
00:10:34,570 --> 00:10:36,420
اخلدي إلى النّوم

113
00:10:36,420 --> 00:10:38,260
تصبحين على خير يا روزيماين

114
00:10:39,040 --> 00:10:42,990
...سأدع الباقي لك

115
00:10:42,990 --> 00:10:44,130
أجل

116
00:10:44,130 --> 00:10:47,820
سأتخلّص من أيّ شيء يحاول عرقلة نومك

117
00:10:48,410 --> 00:10:50,490
نامي بسلام

118
00:10:52,380 --> 00:10:55,300
...تصبحين على خير

119
00:11:08,980 --> 00:11:12,740
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

120
00:11:15,280 --> 00:11:18,990
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

121
00:11:19,340 --> 00:11:22,480
!لم أختطف روزيماين-ساما

122
00:11:22,780 --> 00:11:27,750
تمّ اعتقال المُهاجمين بعد فترة
قصيرة من إنقاذ تشارلوت

123
00:11:30,390 --> 00:11:32,240
!الفيكونت جويسونتاك

124
00:11:32,650 --> 00:11:35,740
!اختطفتُ تشارلوت-ساما فقط

125
00:11:36,110 --> 00:11:40,380
إذاً من أخذ روزيماين؟ من هو
المُتواطئ معك؟

126
00:11:40,930 --> 00:11:44,040
!لا يوجد أحد. تصرّفتُ من تلقاء نفسي

127
00:11:45,080 --> 00:11:48,680
هل أولئك الجنود المُلتهِمون ذوو الرّداء
الأسود هم جيشك الخاصّ؟

128
00:11:48,680 --> 00:11:52,530
إنّهم جنود خاصّون استعرتُهم
من الفيكونت غيرلاخ

129
00:11:53,490 --> 00:11:55,230
أحضروا غيبي غيرلاخ إلى هنا

130
00:11:55,230 --> 00:11:56,170
!حاضر

131
00:11:57,580 --> 00:12:02,660
صحيح، كنتُ أنا من أعارَ الفيكونت
...جويسونتاك الجنودَ الخاصّين، لكن

132
00:12:02,660 --> 00:12:06,780
أليس أولئك الجنود هم الجنود الخاصّين
للكونت بينديوالد؟

133
00:12:08,890 --> 00:12:10,870
كنتُ أعتني بهم فحسب

134
00:12:10,870 --> 00:12:13,340
لم أعرف ماذا أفعل بهم بعد
،أن تمّ أسر الكونت

135
00:12:13,340 --> 00:12:15,660
...لذا سلّمتُهم للفيكونت جويسونتاك

136
00:12:16,150 --> 00:12:21,380
لا أعرف ما هي شكوكك، لكن
لا علاقة لي بهذه المسألة

137
00:12:21,920 --> 00:12:24,680
كنتُ في القاعة الكبيرة أثناء
حدوث كُلّ شيء

138
00:12:25,050 --> 00:12:26,380
كارستيد

139
00:12:26,380 --> 00:12:27,690
تمّ تأكيد ذلك بالفعل

140
00:12:28,360 --> 00:12:30,620
!شخصٌ ما ليس هنا؟ مَن؟

141
00:12:30,940 --> 00:12:34,390
الفيكونت جويسونتاك. الآخرون جميعهم حاضرون

142
00:12:34,920 --> 00:12:38,570
لا أحد آخر غير الفيكونت جويسونتاك
كان قد غادر المنطقة

143
00:12:38,810 --> 00:12:40,570
هل من شيء آخر؟

144
00:12:41,900 --> 00:12:44,000
يكفي. يمكنك المُغادرة

145
00:12:57,670 --> 00:13:01,210
هناك عربة غير مُراقبة مركونة خارج المطبخ

146
00:13:01,210 --> 00:13:02,530
خذها إلى هناك

147
00:13:02,950 --> 00:13:07,630
بالفعل، كانت هناك عربة مركونة
،في الموقع بشهادة الخادم

148
00:13:07,950 --> 00:13:10,770
لكن بقي المالكُ مجهولاً بسبب عدم
وجود شعار النّبالة

149
00:13:11,210 --> 00:13:13,800
هل كان هو من أصدر عليك الأمر؟

150
00:13:14,520 --> 00:13:16,900
لا، لم يكن هو

151
00:13:17,270 --> 00:13:21,270
لم يُعثَر على دليل قاطع
على تدخُّل غيرلاخ

152
00:13:21,970 --> 00:13:23,820
إنّه الجاني

153
00:13:24,940 --> 00:13:26,360
معبر سرّيّ؟

154
00:13:27,140 --> 00:13:28,400
هذا صحيح

155
00:13:28,400 --> 00:13:32,640
بعد أن تلقّى ذلك الرّجل روزيماين
من الفيكونت غيرلاخ

156
00:13:32,640 --> 00:13:34,720
...وحملَها بعيداً بواسطة حصان

157
00:13:34,720 --> 00:13:39,560
ينبغي أن يكون هناك معبراً سرّياً
يؤدّي إلى القاعة الكبيرة

158
00:13:44,680 --> 00:13:49,850
إذا استخدمَ ذلك المعبر، فحتّى لو كانت
...القاعة الكبيرة مُغلقة

159
00:14:07,840 --> 00:14:09,820
بمقدوره العودة

160
00:14:10,080 --> 00:14:13,450
لكن وحده الأوب ينبغي أن يعلم
...بشأن المعبر السّرّيّ

161
00:14:13,820 --> 00:14:18,960
كانت هناك فترة تلقّيتُ فيها أنا وجيورغيني
تعليماً لنكون الورَثة المُقبلين

162
00:14:19,230 --> 00:14:21,560
أختي الكُبرى تمّ تعليمها
!لتكون الوريث المُقبل؟

163
00:14:22,180 --> 00:14:25,440
أعتقد بأنّها تمتلك نفس معرفة أرشيدوق

164
00:14:25,440 --> 00:14:28,550
هذا مُزعج، لكن يمكننا حاليّاً
رفض أي زيارات مُستقبليّة

165
00:14:28,550 --> 00:14:32,340
أجل. في هذه الأثناء، سنُعيد بناء إيرينفيست

166
00:14:34,270 --> 00:14:39,100
لا حاجة لحرَس ملكيّ يفتقر للقوّة
لحماية روزيماين

167
00:14:39,370 --> 00:14:41,030
!حاضرة، مولايّ

168
00:14:43,160 --> 00:14:46,970
وهكذا، بدأت الأيّام من دون روزيماين

169
00:14:48,710 --> 00:14:53,250
،من أجل استعادة صحّتي ثانية
سأنام لبعض الوقت

170
00:14:53,710 --> 00:14:59,610
من فضلكم استمرّوا في صنع كُتُب
كالمعتاد أثناء غيابي

171
00:15:01,990 --> 00:15:07,250
تمكّنتْ من النّجاة، لكن سيستغرق
...نجاحُ دواءٍ عاماً الآن

172
00:15:07,770 --> 00:15:12,040
قالتْ ماين بأنّها ستنام لبعض
...الوقت في رسالتها

173
00:15:13,060 --> 00:15:15,360
!تبّاً! تبّاً! تبّاً

174
00:15:16,930 --> 00:15:20,100
...ماين طفلة قويّة. لا داعي للقلق

175
00:15:20,420 --> 00:15:24,120
ستكون بخير. لنثِق بها وننتظر

176
00:15:25,220 --> 00:15:29,470
حياتها ليست في خطر. هذا هو
الشّيء الوحيد الّذي يشفع

177
00:15:38,850 --> 00:15:41,420
حياتها ليست في خطر، صحيح؟

178
00:15:42,190 --> 00:15:45,410
إذاً، سنستمرّ كما كنّا فحسب

179
00:15:47,200 --> 00:15:49,180
أجل يا سيّدي

180
00:15:53,590 --> 00:15:55,800
مضى عامٌ تقريباً

181
00:15:56,220 --> 00:15:58,970
ما زالت روزيماين لم تُظهِر
أي أثر للاستيقاظ؟

182
00:16:10,340 --> 00:16:14,560
يبدو أنّ صحوة روزيماين ستتأخّر أكثر

183
00:16:14,560 --> 00:16:15,500
ماذا؟

184
00:16:16,010 --> 00:16:21,170
المانا خاصّتها مضغوطة جدّاً. يستغرق
إذابتها بالكامل وقتاً طويلاً

185
00:16:22,470 --> 00:16:29,350
كيف تمكّنتِ من النّجاة بهذا الكمّ
الكبير من المانا في جسدكِ؟

186
00:16:31,080 --> 00:16:34,960
فران، استبدل أحجار الماسيكي
بأُخرى جديدة

187
00:16:34,960 --> 00:16:35,820
حاضر

188
00:16:42,080 --> 00:16:44,370
،استيقظي بسرعة أرجوكِ

189
00:16:45,770 --> 00:16:47,390
يا روزيماين-ساما

190
00:17:08,730 --> 00:17:11,090
!مرحى

191
00:17:13,640 --> 00:17:15,490
!أحتاج للمُواظبة على ذلك فحسب

192
00:17:19,230 --> 00:17:22,870
...ثمّ حالما يمضي الرّبيع

193
00:17:28,250 --> 00:17:29,960
...وفي نهاية الصّيف

194
00:17:38,420 --> 00:17:41,020
بدأت رؤوس أصابعها تتحرّك من جديد

195
00:17:41,410 --> 00:17:44,280
علينا الآن أن ننتظرها حتّى تستيقظ فحسب

196
00:17:44,630 --> 00:17:46,020
هكذا إذاً

197
00:17:48,260 --> 00:17:50,970
...كبير الكهنة يحضر حاليّاً مهرجانَ الحصاد

198
00:17:51,290 --> 00:17:54,920
أجل، من المُخطّط أن يعود بعد أسبوعين

199
00:17:54,920 --> 00:17:59,690
ماذا سنفعل إذا استيقظت روزيماين-ساما
خلال تلك الفترة؟

200
00:17:59,990 --> 00:18:02,580
...لدينا بعض الإجراءات، لكن

201
00:18:03,530 --> 00:18:05,890
لا، لا شيء

202
00:18:17,490 --> 00:18:18,570
دعني أعبر

203
00:18:20,780 --> 00:18:23,330
توقّعتُ عودتك

204
00:18:32,190 --> 00:18:33,410
...ليس بعد

205
00:18:34,320 --> 00:18:39,300
بعد ذلك، استمرّ فيرديناند في العودة
وتفقّدها بين كلّ بضعة أيّام

206
00:18:41,840 --> 00:18:44,590
...نحن في وسط مهرجان الحصاد ومع ذلك

207
00:18:44,590 --> 00:18:48,090
لا بُدّ أنّ روزيماين-ساما مُهمّة جدّاً بالنّسبة له

208
00:18:48,090 --> 00:18:51,470
أجل. أظنّها كذلك

209
00:18:55,250 --> 00:19:01,250
كم من المتاعب تنوين أن تُسبّبي لي بالضّبط؟

210
00:19:17,760 --> 00:19:20,360
ما زال هناك الكثير لفعله

211
00:19:20,830 --> 00:19:22,140
...يجب عليكِ قريباً

212
00:19:40,300 --> 00:19:43,280
استيقظي يا روزيماين

213
00:19:59,610 --> 00:20:02,420
هذا مُؤلم يا كبير الكهنة

214
00:20:02,740 --> 00:20:05,310
نمتِ لفترة طويلة جدّاً

215
00:20:06,340 --> 00:20:08,360
يبدو أنّه لا توجد مشاكل

216
00:20:09,800 --> 00:20:11,390
هل تشارلوت بخير؟

217
00:20:11,390 --> 00:20:12,630
إنّها بأمان

218
00:20:12,630 --> 00:20:15,770
أُعدِمَ المُعتدون عليها قبل عامين

219
00:20:16,890 --> 00:20:18,240
ماذا؟

220
00:20:18,240 --> 00:20:21,510
هل قلتَ للتو "قبل عامين"؟

221
00:20:21,510 --> 00:20:22,690
هذا صحيح

222
00:20:22,950 --> 00:20:27,470
عمركِ الآن عشر سنوات ومهرجان
الحصاد قد انتهى للتو

223
00:20:27,470 --> 00:20:30,570
يسرّني أنّكِ تداركتِ الوقت قبل
التحاقكِ بالأكاديميّة الملكيّة

224
00:20:30,820 --> 00:20:33,640
...مـ-مستحيل

225
00:20:34,340 --> 00:20:37,170
!لا

226
00:20:46,220 --> 00:20:49,600
ماذا؟ تشارلوت وأخي ويلفريد كانا يؤدّيان

227
00:20:49,600 --> 00:20:51,730
!المراسم الدّينيّة بدلاً عنّي؟

228
00:20:51,730 --> 00:20:54,520
!سنبذل قصارى جهدنا بالنّيابة عنكِ يا أختي الكُبرى

229
00:20:56,530 --> 00:20:58,530
...وأمّي

230
00:20:58,930 --> 00:21:04,490
من واجب الأمّ توسيع مجال الطّباعة الخاصّ
بروزيماين بالنّيابة عنها

231
00:21:04,490 --> 00:21:09,000
ويبدو أنّها بنتْ ورشةً في موطنها هالدينزيل

232
00:21:09,710 --> 00:21:11,970
...آسفة يا سيّد بينّو

233
00:21:13,700 --> 00:21:16,250
ماذا حدث لتقدُّم دامويل للخطوبة؟

234
00:21:16,560 --> 00:21:18,870
الزّواج لم يُثمر

235
00:21:21,160 --> 00:21:23,630
هل ستأتي إلى إيلغنار؟

236
00:21:28,060 --> 00:21:30,630
...لا أستطيع الذّهاب إلى إيلغنار

237
00:21:35,640 --> 00:21:37,440
...مُستحيل

238
00:21:38,770 --> 00:21:41,990
...مضى عامان. حدثتْ أمور كثيرة

239
00:21:42,570 --> 00:21:48,220
خدمُكِ كانوا ينتظرون استيقاظكِ طوال ذلك الوقت

240
00:21:48,610 --> 00:21:50,310
كُلّ ذلك أثناء صنع الكُتُب

241
00:21:52,260 --> 00:21:53,990
!كُتُب جديدة

242
00:21:58,610 --> 00:22:04,600
كبير الكهنة... هل استعدتُ كامل
عافيتي حقّاً؟

243
00:22:06,690 --> 00:22:09,650
،مع الأسف، بسبب آثار السُّمّ

244
00:22:09,650 --> 00:22:11,320
لم يتمكّن اليوريفي

245
00:22:11,320 --> 00:22:14,810
من الإذابة الكاملة للمانا المُتصلِّبة
داخل جسدكِ

246
00:22:14,810 --> 00:22:16,330
!ماذا؟

247
00:22:16,330 --> 00:22:18,870
!قلتَ بأنّني سأتعافى تماماً

248
00:22:18,870 --> 00:22:21,320
!كبير الكهنة، أنت كاذب

249
00:22:30,190 --> 00:22:32,360
!فتحتْ ماين عيناها؟

250
00:22:32,360 --> 00:22:33,440
أجل

251
00:22:34,080 --> 00:22:35,810
!هذا مُطمئن

252
00:22:38,680 --> 00:22:40,880
!ممتاز! ممتاز

253
00:22:40,880 --> 00:22:42,710
!مرحى

254
00:22:42,710 --> 00:22:44,350
...هـ-هذا رائع

255
00:22:44,350 --> 00:22:46,190
!هذا رائع يا ماين

256
00:22:45,630 --> 00:22:48,220
!أريد رؤية وجه ماين في أسرع وقت

257
00:22:48,220 --> 00:22:49,620
أجل

258
00:22:49,620 --> 00:22:52,990
عليها ارتياد مدرسة نُبلاء تُدعى
،الأكاديميّة الملكيّة في الشّتاء

259
00:22:52,990 --> 00:22:55,190
لذا لن تتمكّن من رؤيتنا فوراً

260
00:23:03,280 --> 00:23:05,990
إذاً، سأُغادر

261
00:23:14,950 --> 00:23:20,030
الرّسم بواسطة: يو شينا