1
00:00:00,670 --> 00:00:03,550
جمعتْ روزيماين مادّة الرّبيع خاصّتها بنجاح

2
00:00:04,980 --> 00:00:06,390
...من النّاحية الأُخرى

3
00:00:06,650 --> 00:00:09,400
حضرة القائد، شكراً لك على كلّ
شيء حتّى الآن

4
00:00:09,620 --> 00:00:12,770
،حريّ بك أن تبذل قصارى جهدك
!حتّى كتاجر يا أوتّو

5
00:00:13,080 --> 00:00:14,090
!حاضر

6
00:00:13,830 --> 00:00:15,790
m 0 0 l 495 0 165 40 0 40

7
00:00:13,830 --> 00:00:15,790
مُوظّف في شركة غيلبيرتا
أوتّو

8
00:00:16,570 --> 00:00:19,780
غادر السّيّد أوتّو إلى شركة غيلبيرتا؟

9
00:00:20,020 --> 00:00:22,900
أجل. يبدو أنّ السّيّدة كورينّا والسّيّد بينّو

10
00:00:22,900 --> 00:00:26,420
كانا يطلبان منه المُساعدة
في المحلّ منذ مدّة

11
00:00:26,420 --> 00:00:30,170
علاقاتهما مع النّبلاء قد ازدهرت بفضل ماين

12
00:00:30,610 --> 00:00:32,350
!هذا ما قاله لوتز

13
00:00:34,300 --> 00:00:36,480
...عسى أن تمنح إلَهة الماء فروتني

14
00:00:36,480 --> 00:00:37,720
!فريوترين

15
00:00:38,770 --> 00:00:42,730
m 0 0 l 435 0 145 40 0 40

16
00:00:38,770 --> 00:00:42,730
زوجة أوتّو
كورينّا

17
00:00:39,250 --> 00:00:41,050
...فريوترين، الّتي تُرشد

18
00:00:41,050 --> 00:00:43,610
...الّتي هدتْ هذا اللّقاء بنقاء وصدق

19
00:00:44,020 --> 00:00:49,670
،الّتي هدتْ هذا اللّقاء بنقاء وصدق
...عسى أن تمنحنا بركَتها

20
00:00:51,170 --> 00:00:53,190
هل حفظتْ كُلَّ هذا حقّاً؟

21
00:00:53,190 --> 00:00:56,110
ماين مُذهلة جدّاً

22
00:00:56,730 --> 00:00:58,490
!روزيماين-ساما

23
00:01:19,480 --> 00:01:25,280
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

24
00:02:37,010 --> 00:02:42,010
الحلقة 16
فُستان جديد ومطبعة

25
00:02:44,150 --> 00:02:46,760
،بفضل زيارتك يا روزيماين-ساما

26
00:02:46,760 --> 00:02:50,130
تعاملاتنا مع الطّبقة النّبيلة تحسّنتْ بشكل ملحوظ

27
00:02:50,130 --> 00:02:52,050
أنا مُمتنّ لكِ من أعماق قلبي

28
00:02:52,050 --> 00:02:54,590
بعبارة أُخرى، إنّه مشغولٌ جدّاً

29
00:02:54,590 --> 00:02:57,400
سيّد بينّو، لستُ جيّدة في فهم
الكلمات المُبطَّنة

30
00:02:57,400 --> 00:02:59,530
هلّا سألتُك عن رأيك الصّادق؟

31
00:03:00,900 --> 00:03:05,700
أتعبتُ شركةَ غيلبيرتا كثيراً، أليس كذلك؟

32
00:03:05,700 --> 00:03:08,580
،إن كان العمل أكبر من أن تتحمّله طاقتهم
فهل نوزّع بعضاً من العمل على آخرين؟

33
00:03:08,580 --> 00:03:10,910
!أنتِ! لا تُحاولي فعل شيء لا ضرورة له

34
00:03:10,910 --> 00:03:13,650
!سيعتقد النّاس بأنّكِ قطعتِ علاقتكِ بنا

35
00:03:13,650 --> 00:03:15,920
!هل تحاولين وضعنا في موقف حرج؟

36
00:03:15,920 --> 00:03:17,860
!إطلاقاً

37
00:03:18,480 --> 00:03:22,090
أنتما... حافِظا رجاء على درجة من اللّباقة

38
00:03:22,970 --> 00:03:24,960
المعذرة

39
00:03:28,850 --> 00:03:34,050
لكن إن كنتُم مشغولين إلى هذه الدّرجة، فأعتقد
بأنّ الذّهاب إلى إيلنغير أمر مُستبعد؟

40
00:03:34,630 --> 00:03:36,450
إيلغنير؟

41
00:03:36,450 --> 00:03:40,450
أجل، سمعتُ أنّ لديهم الكثير من الخشب
ومصنع حِراجة مُزدهر

42
00:03:40,450 --> 00:03:43,820
كنتُ آمل الذّهاب ومُعاينة المنطقة
...في فترة ما

43
00:03:45,450 --> 00:03:47,250
سيكون ذلك صعباً

44
00:03:47,250 --> 00:03:50,430
حاليّاً، لوتز هو الوحيد الّذي
أستطيع أن أعفيه

45
00:03:50,430 --> 00:03:52,530
لن يكون من الآمن إرساله لوحده

46
00:03:52,530 --> 00:03:54,340
ماذا عن أوتّو؟

47
00:03:54,630 --> 00:03:57,950
كتبَ أبي في الرّسالة الّتي استلمها لوتز

48
00:03:57,950 --> 00:04:02,210
بأنّ أوتّو قد اعتزل كجنديّ ليصبح تاجراً

49
00:04:02,540 --> 00:04:04,840
،لا مانع لديه أن يُمارس العمل مع العوام

50
00:04:04,840 --> 00:04:07,590
لكن لا يمكن تقديم أوتّو أمام
أيّ نبيل بعد

51
00:04:07,970 --> 00:04:14,270
،إذاً، ماذا عن تدريب أوتّو هنا
كما فعلنا مع لوتز تماماً؟

52
00:04:15,110 --> 00:04:16,980
أهذا مُمكن يا فران؟

53
00:04:17,550 --> 00:04:23,360
حسناً، الآن بعد أن أصبح زام رسميّاً
،أحد مُرافقي روزيماين-ساما

54
00:04:23,360 --> 00:04:25,590
لدينا وقت أطول قليلاً

55
00:04:25,590 --> 00:04:29,290
،من أجل تخفيف العبء عن فران، زام

56
00:04:29,290 --> 00:04:32,380
الّذي كان مُرافق كبير الكهنة، قد نُقِل إليّ

57
00:04:32,380 --> 00:04:34,890
إذا سأدع الأمر لك

58
00:04:34,890 --> 00:04:38,140
لكن لا أستطيع سوى تعليم
...آداب السّلوك الصّحيحة

59
00:04:38,140 --> 00:04:41,010
لا، قلّ من النّاس يستطيعون
تعليم آداب السُّلوك

60
00:04:41,010 --> 00:04:43,420
المطلوبة للتّفاعل مع النُّبلاء

61
00:04:43,720 --> 00:04:45,620
أنا مُمتنّ حقّاً

62
00:04:47,670 --> 00:04:50,620
روزيماين-ساما، هذه هي الإشارة من مونيكا

63
00:04:52,630 --> 00:04:54,140
!يا للرّوعة

64
00:04:57,040 --> 00:04:59,520
!هذا يلائمكِ كثيراً يا بريغيتّي

65
00:04:59,960 --> 00:05:05,010
بما أنّ القماش لا يُغطّي الكتِفَين، فإنّه
من السّهل تحريك ذِراعَي

66
00:05:05,010 --> 00:05:08,160
إذا استدعت الحاجة، أستطيع تغطية
نفسي بحجارة ماسيكي

67
00:05:09,570 --> 00:05:12,980
آمل أن تقلقي أكثر حول فيما إذا
كان يمكنكِ إيجاد

68
00:05:12,980 --> 00:05:16,620
زوج رائع به، بدلاً من النّاحية العمليّة

69
00:05:18,940 --> 00:05:22,640
بريغيتّي، هل يمكنني إدخال دامويل؟

70
00:05:22,640 --> 00:05:25,040
أريد سماع رأي رجُل حقيقيّ

71
00:05:25,040 --> 00:05:26,470
هذه فكرة سديدة

72
00:05:26,470 --> 00:05:28,680
أرغب في معرفة رأيي حول

73
00:05:28,680 --> 00:05:31,640
الفارسان اللّواتي يرتدينَ شيئاً كهذا

74
00:05:35,320 --> 00:05:36,400
دامويل

75
00:05:41,120 --> 00:05:43,360
رأيي بصدق؟

76
00:05:43,360 --> 00:05:44,470
أجل

77
00:05:44,470 --> 00:05:47,010
في نهاية المطاف، لعلّ بريغيتّي
ترتدي الفستان فقط

78
00:05:47,010 --> 00:05:49,570
احتراماً لي، حتّى لو كانت لا تُحبّ الطّراز

79
00:05:49,570 --> 00:05:52,490
لا أستطيع السّماح لحسّي الذّوقيّ المُشوّه

80
00:05:52,490 --> 00:05:55,020
أن يُسبّب لها أي إحراج، صحيح؟

81
00:05:55,850 --> 00:05:57,260
فهمت

82
00:05:58,980 --> 00:06:00,910
سأُدخِل دامويل

83
00:06:00,910 --> 00:06:02,500
أجل، من فضلك

84
00:06:15,100 --> 00:06:16,850
دامويل؟

85
00:06:18,600 --> 00:06:23,630
أعتقد بأنّني أشهد اللّحظةَ الّتي يقع
فيها شخصٌ في الحُبّ

86
00:06:24,260 --> 00:06:26,350
دامويل، ما رأيك؟

87
00:06:32,730 --> 00:06:34,830
...أ-أجل

88
00:06:35,800 --> 00:06:37,990
يبدو جميلاً

89
00:06:37,990 --> 00:06:39,400
!أكثر قليلاً

90
00:06:39,400 --> 00:06:42,190
المديح لا يصل قلب الآخرين
!إن لم تكن واضحاً

91
00:06:42,190 --> 00:06:44,000
!هيّا! يمكنك فعلها يا دامويل

92
00:06:44,360 --> 00:06:47,050
هل هذا يعني بأنّك تنصح بطراز كهذا

93
00:06:47,050 --> 00:06:48,870
للفارِسات الأُخريات كذلك؟

94
00:06:49,190 --> 00:06:51,600
...في الواقع، أجل

95
00:06:52,750 --> 00:06:56,000
شكراً لك على رأيك القيّم يا دامويل

96
00:06:56,000 --> 00:06:58,260
هيّا، هيّا، هيّا

97
00:06:59,720 --> 00:07:02,280
من السّهل جدّاً قراءة أفكار دامويل

98
00:07:02,660 --> 00:07:06,370
هذه أوّل مرّة ينظر فيها إليّ رجلٌ
،بمثل هذه الطّريقة

99
00:07:06,370 --> 00:07:08,110
لذا هذا أشعرني بالخجل قليلاً

100
00:07:08,400 --> 00:07:10,900
...بريغيتّي، المعذرة

101
00:07:10,900 --> 00:07:13,180
ماذا عن دامويل؟

102
00:07:13,180 --> 00:07:15,150
...أعتقد بأنّه ليس سيّئاً

103
00:07:16,350 --> 00:07:17,160
...إذاً

104
00:07:17,160 --> 00:07:20,420
لكن مُستويات المانا خاصّتنا مُختلفة
لدرجة عدم التّفكير فيه حتّى

105
00:07:20,420 --> 00:07:22,210
...هذا صحيح

106
00:07:22,610 --> 00:07:26,410
مانا الطّفل يتأثّر بشكل كبير بواسطة أمّه

107
00:07:26,410 --> 00:07:30,310
،من دون توازُن مُناسب من المانا
لا يحلم المرء بطفل

108
00:07:30,890 --> 00:07:34,670
استُبعِدَ كمُرشَّح مُمكن في اللّحظة
...الّتي وقع فيها في الحُبّ

109
00:07:34,670 --> 00:07:37,310
!هذا مُحزنٌ للغاية يا دامويل

110
00:07:37,630 --> 00:07:39,710
ماذا؟ لحظة

111
00:07:39,710 --> 00:07:41,060
...حسبما أذكر

112
00:07:41,060 --> 00:07:44,850
...بعد أن تلقّيتُ برَكتي، المانا الخاصّة بدامويل

113
00:07:48,950 --> 00:07:51,430
،رغم أنّ طور تطوّره قد توقّف

114
00:07:51,430 --> 00:07:54,400
إلّا أنّ المانا خاصّته تنمو تدريجيّاً كلّما تدرّب

115
00:07:55,440 --> 00:07:59,350
،إذا استطاع مُعالجة مُشكلة المانا
...فقد يُمهَّد طريق أمامه

116
00:08:01,210 --> 00:08:03,410
!يمكنك فعلها يا دامويل

117
00:08:05,590 --> 00:08:09,640
،أخيراً، لوتز وغيل لديهما شيء للإبلاغ عنه
يا روزيماين-ساما

118
00:08:09,980 --> 00:08:12,460
المطبعة الجديدة قد اكتملت

119
00:08:12,460 --> 00:08:13,880
!يا سلام

120
00:08:16,780 --> 00:08:19,110
!تمّ تحضير الحبر المطلوب بالفعل

121
00:08:19,110 --> 00:08:22,610
،حالما نحصل على مخطوطة
يمكننا البدء بالطّباعة فوراً

122
00:08:23,090 --> 00:08:26,010
!مرحى! المجد للآلهة

123
00:08:26,010 --> 00:08:27,540
!يا للرّوعة

124
00:08:27,540 --> 00:08:31,480
سأتوجّه إلى الورشة فوراً وأعلّم
!الجميع كيفيّة استخدامها

125
00:08:31,480 --> 00:08:34,000
...روزيماين-ساما، هذا

126
00:08:34,000 --> 00:08:37,860
لطالما كان بناء مطبعة هدفي
طوال هذا الوقت

127
00:08:37,860 --> 00:08:39,860
!أريد أن أكون أوّل من يلمسها

128
00:08:40,140 --> 00:08:42,400
...لا يمكن إيقاف روزيماين-ساما

129
00:08:42,400 --> 00:08:44,750
ستهدأ بعد أن ندعها تُجرّبها

130
00:08:48,690 --> 00:08:54,830
وهكذا، لاختبار المطبعة، كتبتُ
فوراً رواية فارس

131
00:08:56,590 --> 00:08:59,890
من فضلكِ استخدمي كبير الكهنة
كنموذج لرسومكِ

132
00:09:00,330 --> 00:09:03,130
ألن يُوبّخكِ كبير الكهنة ثانية؟

133
00:09:03,440 --> 00:09:04,770
!ستكون الأمور على ما يُرام

134
00:09:04,770 --> 00:09:08,080
"هذه القصّة خياليّة"

135
00:09:08,080 --> 00:09:12,020
كافّة المُنظّمات والشّخصيّات المذكورة"
"هنا هي خياليّة تماماً

136
00:09:12,020 --> 00:09:14,830
سنحرص على أن يُدوَّن ذلك بوضوح في الكتاب

137
00:09:16,200 --> 00:09:17,140
...عجباً

138
00:09:17,140 --> 00:09:20,290
أنتِ تبتكرين الفكرة تلو الأُخرى حقّاً

139
00:09:20,290 --> 00:09:24,130
روزيماين-ساما، هل ستصنعين كتاباً مُصوّراً جديداً؟

140
00:09:24,130 --> 00:09:26,400
ماذا سيكون هذه المرّة يا تُرى؟

141
00:09:26,660 --> 00:09:29,910
إنّها قصّة حول فارس سمعتُ عنه
من طفل نبيل

142
00:09:30,380 --> 00:09:36,180
أتطلّع لليوم الّذي يبدأ فيه الجميع
!بإنشاء المزيد من الكُتُب الجديدة

143
00:09:36,430 --> 00:09:37,430
!أجل

144
00:09:45,360 --> 00:09:47,970
إنّه ضيّقٌ قليلاً. هل يناسبكِ؟

145
00:09:47,970 --> 00:09:51,600
أجل. هذا الشّيء الوحيد الّذي لديّ
والّذي من المُمكن أن يتّسخ

146
00:09:52,060 --> 00:09:55,600
...احتفظوا بهذه الملابس لأجلي

147
00:09:56,080 --> 00:09:57,860
لوتز، شكراً على الانتظار

148
00:10:02,990 --> 00:10:05,440
!ماين؟! لا، أنا مُخطئ

149
00:10:05,440 --> 00:10:06,500
لستِ كذلك

150
00:10:06,770 --> 00:10:08,240
أصابك الحنين، أليس كذلك؟

151
00:10:09,150 --> 00:10:10,750
هذا مُشوِّش

152
00:10:10,750 --> 00:10:13,980
حسناً، أين مصفّ الأحرف المطبعيّة
ومُنضّد السّطور؟

153
00:10:16,770 --> 00:10:19,130
...يا للجمال

154
00:10:22,400 --> 00:10:27,520
ثمّ نضبط النّمط لتجربة الطّباعة في اليوم المُوالي

155
00:10:29,740 --> 00:10:34,030
!والآن لنقُم بتجريب الطّباعة على المطبعة الجديدة

156
00:10:39,850 --> 00:10:44,780
والآن، سنتمكّن من الطّباعة على الوجهين
!حيث لم نستطع ذلك من قبل

157
00:11:13,740 --> 00:11:16,580
!طُبِعَتْ بنجاح

158
00:11:17,440 --> 00:11:19,560
ستكون مُشكلة لو لم تنجح

159
00:11:19,890 --> 00:11:22,200
مُذهل، أهذه هي الطّباعة؟

160
00:11:22,200 --> 00:11:23,230
هذا مُبهر

161
00:11:23,620 --> 00:11:26,150
إينغو. زاك. يوهان

162
00:11:26,150 --> 00:11:31,770
بفضل تضافُر جهودكم، نجحت
الطّباعة بشكل مُبهر

163
00:11:31,770 --> 00:11:35,070
!أريدكم أن تصنعوا واحدةً أُخرى كهذه

164
00:11:35,070 --> 00:11:37,500
أريد أن أنصّبَ مطبعةً في هاسّي كذلك

165
00:11:37,500 --> 00:11:38,450
ماذا؟

166
00:11:38,450 --> 00:11:41,630
زاك، ثمّة شيء آخر أريدك أن تصنعه

167
00:11:41,630 --> 00:11:42,470
!حاضر

168
00:11:42,820 --> 00:11:46,760
لوتز، ألم تقل بأنّها ستهدأ حالما
تُجرّب العمليّة بالكامل؟

169
00:11:46,760 --> 00:11:48,490
أصبحت غير قابلة للإيقاف حقّاً

170
00:11:51,980 --> 00:11:55,740
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

171
00:11:58,280 --> 00:12:01,990
:هيمنة عثّة كُتُب
ابنة أرشيدوق بالتبنّي

172
00:12:04,980 --> 00:12:07,620
قصّة جديدة أُخرى؟

173
00:12:09,990 --> 00:12:11,210
ماذا؟

174
00:12:12,480 --> 00:12:14,130
هذا شيء مُختلف

175
00:12:14,770 --> 00:12:19,120
ما أكتبه، في لحظات فراغ أحظى بها
خلال العمل، هو هديّة عيد ميلاد تولي

176
00:12:19,850 --> 00:12:22,750
أريد إنجازها قبل بدء الصّيف

177
00:12:24,820 --> 00:12:26,530
روزيماين-ساما

178
00:12:27,380 --> 00:12:30,700
تلقّينا رسالة بعنوان كبير الأساقفة السّابق

179
00:12:31,970 --> 00:12:34,020
من جديد؟

180
00:12:34,020 --> 00:12:36,230
هل هناك أماكن غير هاسّي

181
00:12:36,230 --> 00:12:39,660
ما زالت لا تعلم بأنّ كبير الأساقفة قد تُوفّي؟

182
00:12:40,750 --> 00:12:42,400
...خطّ اليد هذا

183
00:12:42,740 --> 00:12:44,500
!إنّه الشّخص الّذي كتبَ رسائل الحُبّ تلك

184
00:12:45,170 --> 00:12:48,610
هناك أمر يجب أن أطلبه منك"

185
00:12:48,610 --> 00:12:51,860
"لا يمكنني الاعتماد على سِواك
حسبما ورد

186
00:12:52,650 --> 00:12:54,780
أرفقتْ ورقةً للردّ

187
00:12:56,320 --> 00:12:59,680
حاليّاً، سأكتب ردّاً مفاده بأنّه قد تُوفّي

188
00:12:59,680 --> 00:13:02,540
ثمّ سيترتّب عليّ استشارة كبير الكهنة
حول هذا الأمر

189
00:13:12,780 --> 00:13:13,810
ماذا؟

190
00:13:24,430 --> 00:13:26,380
أوردونّانز؟

191
00:13:26,380 --> 00:13:28,820
هذه أداة سحريّة لإرسال الرّسائل

192
00:13:29,210 --> 00:13:30,610
أداة سحريّة؟

193
00:13:31,070 --> 00:13:34,770
هل انتهى المطاف بقيامي بشيء فظيع؟

194
00:13:35,690 --> 00:13:36,950
أمر تكتُّم؟

195
00:13:37,200 --> 00:13:40,330
أجل. هل حقيقة وفاة كبير الأساقفة

196
00:13:40,330 --> 00:13:42,710
عُتّمَ عليه عن الدّوقيّات الأُخرى؟

197
00:13:43,430 --> 00:13:47,530
لا، صحيح أنّه صدر أمر تكتُّم بخصوص
عقوبة وحبس

198
00:13:47,530 --> 00:13:49,970
أمّ الأرشيدوق من أجل منع الدّوقيّات الأُخرى

199
00:13:49,970 --> 00:13:51,720
،من إيجاد ذريعة للتدخُّل

200
00:13:52,040 --> 00:13:54,070
إلّا أنّه لا شيء يخصُّ كبير الأساقفة السّابقة

201
00:13:54,070 --> 00:13:55,360
!أمان

202
00:13:55,760 --> 00:13:57,590
أهذا كلُّ شيء؟

203
00:13:57,590 --> 00:14:00,470
شكراً لك على نقل زام إليّ

204
00:14:00,840 --> 00:14:05,110
لكن، أنا متأكّدة أنّه سيكون من الصّعب
عليك أن تفقد شخصاً مُؤهّلاً كهذا

205
00:14:05,490 --> 00:14:10,370
هذه ليست بمُشكلة. أنا أدرّب كامبفير وفريتاك حاليّاً

206
00:14:08,370 --> 00:14:10,370
m 0 0 l 495 0 165 40 0 40

207
00:14:08,370 --> 00:14:10,370
كاهن أزرق
كامبفير

208
00:14:10,370 --> 00:14:12,360
m 0 0 l 495 0 165 40 0 40

209
00:14:10,370 --> 00:14:12,360
كاهن أزرق
فريتاك

210
00:14:12,360 --> 00:14:15,120
سيترتّب عليهما الخضوع للتّدريب
الشّغوف" الخاصّ بكبير الكهنة؟"

211
00:14:15,470 --> 00:14:18,670
كنتِ أنتِ من طلب منّي تدريب الجيل التّالي

212
00:14:18,670 --> 00:14:19,500
ماذا؟

213
00:14:20,490 --> 00:14:21,870
!هذه غلطتي؟

214
00:14:22,410 --> 00:14:26,300
بغضّ النّظر عن ذلك، هل أنتِ مُستعدّة
للعودة إلى القلعة؟

215
00:14:28,610 --> 00:14:30,510
أجل، أنا كذلك

216
00:14:30,850 --> 00:14:34,730
أثناء غياب الأرشيدوق وزوجته
،يحضران مُؤتمر الأرشيدوق

217
00:14:34,730 --> 00:14:38,140
يجب عليكِ أنتِ وويلفريد حماية القلعة

218
00:14:38,140 --> 00:14:40,470
هذا هو واجب أطفال الأرشيدوق

219
00:14:40,950 --> 00:14:41,810
أجل

220
00:14:43,670 --> 00:14:45,140
...قبل ذلك

221
00:14:46,390 --> 00:14:48,730
لديّ اجتماع اليوم مع هوغو

222
00:14:53,410 --> 00:14:55,170
m 0 0 l 495 0 165 40 0 40

223
00:14:53,410 --> 00:14:55,170
طبّاخ
هوغو

224
00:14:55,440 --> 00:14:56,660
تفضّل وكُل

225
00:14:56,660 --> 00:15:00,670
،هذا هو البسكويت الجديد الّذي أعدّتْه إيلّا
ويُدعى لانغو دوشا

226
00:15:06,200 --> 00:15:08,500
...اليوم يا إيلّا

227
00:15:08,500 --> 00:15:12,300
!سأثبت لمُعلّمي السّابق كم تطوّرت

228
00:15:17,000 --> 00:15:19,930
...تبّاً! تحسّنتْ أكثر حتّى

229
00:15:22,220 --> 00:15:27,470
...إذاً، سمعتُ بأنّك أردت أن تُصبح طبّاخ قلعة

230
00:15:27,470 --> 00:15:28,310
!أجل

231
00:15:28,640 --> 00:15:32,630
هل أنت مُسعدّ للتخلّي عن هوغو يا بينّو؟

232
00:15:32,630 --> 00:15:34,680
انضمام طبّاخ من مطعمنا

233
00:15:34,680 --> 00:15:37,820
للخدمة في القلعة يُضيف سمعةً جيّدة
لمجال عملنا، لذا هذه ليست مُشكلة

234
00:15:38,080 --> 00:15:40,670
،قبل افتتاح المطعم الإيطاليّ

235
00:15:40,670 --> 00:15:45,710
تمّ الاعتراف بمهارات هوغو وعَمِلَ
كطبّاخ قلعة لفترة قصيرة

236
00:15:45,710 --> 00:15:46,860
...ثمّ

237
00:15:47,110 --> 00:15:51,180
ما رأيك في ذلك؟ هل تودّ البقاء كطبّاخ قلعة؟

238
00:15:51,510 --> 00:15:54,660
،بما أنّك رفضت عرضه آنذاك

239
00:15:54,660 --> 00:15:57,890
فأعتقد بأنّه سيترتّب عليك البدء
...كمُساعد طبّاخ ثانويّ

240
00:15:57,890 --> 00:15:59,130
!لا مُشكلة

241
00:15:59,420 --> 00:16:01,710
أن تقول بأنّك لا تُمانع التّراجع
في ظروف عملك

242
00:16:01,710 --> 00:16:03,900
...يعني أنّ شيئاً خطيراً قد حدث

243
00:16:03,900 --> 00:16:06,140
هل أنت مُمتعض من المطعم؟

244
00:16:06,140 --> 00:16:07,830
...هـ-هذا

245
00:16:07,830 --> 00:16:09,640
...حبيبته السّابقة

246
00:16:09,640 --> 00:16:11,770
بدأتْ تُقابل أحد الجيران ويترتّب
عليه مُشاهدتهما

247
00:16:11,770 --> 00:16:14,650
،وهما يتباهيان بعلاقتهما السّعيدة في كلّ يوم

248
00:16:14,650 --> 00:16:16,820
لذا يريد الآن مُغادرة الدّيار

249
00:16:17,170 --> 00:16:20,020
!سأركّز على الطّبخ فقط من الآن فصاعداً

250
00:16:20,460 --> 00:16:23,430
هكذا إذاً. فهمتُ الآن

251
00:16:25,250 --> 00:16:28,450
بالمُناسبة، إن أردت ببساطة
،مُغادرة ديارك

252
00:16:28,450 --> 00:16:33,160
،فيمكنني توظيفك كطبّاخ شخصيّ لي
مع توفير غرفة ومنامة

253
00:16:34,040 --> 00:16:36,680
الطبّاخ الشّخصيّ لروزيماين-ساما؟

254
00:16:36,680 --> 00:16:41,050
،أجل. أثناء تقديم مونيكا ونيكولا للمُساعدة

255
00:16:41,050 --> 00:16:43,940
إيلّا هي طبّاختي الوحيدة، لذا
لديها فائض من العمل

256
00:16:43,940 --> 00:16:46,960
ألا تعتقد بأنّها ستكون بيئة عمل
أفضل من قلعة كئيبة

257
00:16:46,960 --> 00:16:49,180
حيث لن تكون مُحاطاً سوى بواسطة الرّجال؟

258
00:16:51,140 --> 00:16:53,050
!أتطلّع للعمل تحت جناحكِ

259
00:16:54,290 --> 00:16:59,260
وهكذا، في نهاية الرّبيع، انتقلتُ عائدة إلى القلعة

260
00:17:00,220 --> 00:17:01,560
أنتِ هنا

261
00:17:01,560 --> 00:17:02,750
هيّا بنا إذاً

262
00:17:03,080 --> 00:17:06,330
سنصبُّ المانا الآن في الأساس

263
00:17:17,090 --> 00:17:19,440
روزيماين. ويلفريد

264
00:17:19,440 --> 00:17:22,800
خذا هذه وسجّلا المانا خاصّتكما فيها

265
00:17:31,180 --> 00:17:34,550
والآن أنتما قادران على دخول
هذا المكان كذلك

266
00:17:45,360 --> 00:17:46,330
هيّا بنا

267
00:17:55,250 --> 00:17:56,850
هيّا

268
00:17:58,040 --> 00:18:01,740
ويلفريد-ساما، روزيماين-ساما

269
00:18:02,980 --> 00:18:06,240
هذا هو واجبكما الرّسميّ الأوّل
كأبناء للأرشيدوق

270
00:18:06,240 --> 00:18:11,020
ولو كان إلحاحاً منّي، لكن أتمنّى
منكما أن تبذلا قصارى جهدكما

271
00:18:29,990 --> 00:18:32,490
!خيال

272
00:18:36,460 --> 00:18:40,480
هذه هي قاعة إعادة تعبئة المانا لنقل المانا

273
00:18:40,480 --> 00:18:42,770
إلى أساس إيرينفيست

274
00:18:42,770 --> 00:18:46,020
إذاً هذا ليس الأساس بنفسه؟

275
00:18:46,020 --> 00:18:50,030
وحده الأرشيدوق من يستطيع
الوصول إلى الأساس

276
00:18:50,440 --> 00:18:53,840
تستطيع عائلة الأرشيدوق الوصول إلى
قاعة إعادة تعبئة المانا فقط

277
00:18:54,560 --> 00:18:58,280
حجر الماسيكي هذا مُتّصل بالأساس

278
00:18:58,920 --> 00:19:00,730
،أثناء مُؤتمر الأرشيدوق

279
00:19:00,730 --> 00:19:04,000
أريدكما أن تنقلا المانا إلى داخل
الأساس من خلال هذا

280
00:19:04,360 --> 00:19:07,700
...ليس من العادة تكليف أطفال بمهمّة كهذه، لكن

281
00:19:07,700 --> 00:19:10,210
أنا مُدرك تماماً لنقص المانا الحاليّ

282
00:19:10,500 --> 00:19:11,850
من المُطمئن سماع ذلك

283
00:19:14,490 --> 00:19:17,490
اسكب المانا هنا

284
00:19:35,140 --> 00:19:40,740
أنا الشّخص الّذي يُقدّم الصّلاة والامتنان
للآلهة الّذين صنعوا هذا العالم

285
00:19:41,090 --> 00:19:46,950
أنا الشّخص الّذي يُقدّم الصّلاة والامتنان
للآلهة الّذين صنعوا هذا العالم

286
00:19:47,500 --> 00:19:51,380
الآلهة الرّفيعون الّذين يتسيّدون
السّماوات الّتي لا حدود لها

287
00:19:51,380 --> 00:19:53,850
هما الثّنائيّ القدسيّ ظلام ونور

288
00:19:54,800 --> 00:19:59,610
الخمسة الخالدون العُظماء، الّذين يحكمون
هذه الأرض الواسعة الّتي لا حدود لها

289
00:19:59,610 --> 00:20:02,340
إلَهة الماء، فريوترين

290
00:20:03,290 --> 00:20:05,220
إله النّار، لايدنشافت

291
00:20:05,610 --> 00:20:08,010
إلَهة الرّياح، شوتزاريا

292
00:20:08,010 --> 00:20:10,890
إلهة الأرض، غيدولدي

293
00:20:10,890 --> 00:20:13,640
إله الحياة، إيويغليبين

294
00:20:13,940 --> 00:20:18,360
نُقدّركم أنتم يا من باركتم بكافّة الكائنات

295
00:20:18,360 --> 00:20:25,150
بالحياة والصّلاة وعسى أن نتبارك
أكثر بجبروتكم الإلهيّ

296
00:20:26,030 --> 00:20:27,290
هذا يكفي

297
00:20:38,100 --> 00:20:40,670
هل أنت بخير يا ويلفريد؟

298
00:20:41,030 --> 00:20:43,060
...أنا بخير يا أمّي

299
00:20:45,150 --> 00:20:47,440
تبدين بخير يا روزيماين

300
00:20:47,440 --> 00:20:51,180
نظراً لوهنكِ، ظننتُ بأنّكِ أوّل
من سيُغمى عليه

301
00:20:51,180 --> 00:20:54,190
أفعل هذا كثيراً في الكاتدرائيّة

302
00:20:56,650 --> 00:20:58,680
تولّي مسؤوليّة الأرشيدوق؟

303
00:20:58,680 --> 00:21:01,490
أجل. يبدو أنّها ستكون هناك حتّى الصّيف

304
00:21:01,490 --> 00:21:02,570
...هكذا إذاً

305
00:21:02,960 --> 00:21:04,060
مارك

306
00:21:04,700 --> 00:21:07,420
حدِّد اجتماعاً في أسرع وقت مُمكن

307
00:21:07,930 --> 00:21:09,320
هل هذا يخصُّ تلك المسألة؟

308
00:21:09,720 --> 00:21:11,830
ما الأمر؟

309
00:21:12,090 --> 00:21:16,020
تعلم بأنّ مبيعات المواد الدّراسيّة
ارتفعت، أليس كذلك يا لوتز؟

310
00:21:16,020 --> 00:21:17,100
...أجل

311
00:21:17,100 --> 00:21:20,350
أصحاب مصارِف التّجّار الكُبرى يغارون بسبب ذلك

312
00:21:20,600 --> 00:21:24,250
يشتكون بأنّ شركة غيلبيرتا يُفترض
أن تكون متجر ملابس

313
00:21:24,710 --> 00:21:25,840
...لذا

314
00:21:26,170 --> 00:21:27,850
سأعمل على فصل مجال صِناعة الكُتُب

315
00:21:27,850 --> 00:21:30,240
!عن شركة غيلبيرتا والعمل بشكل مُستقلّ

316
00:23:03,990 --> 00:23:07,000
الحلقة القادمة
تولّي المسؤوليّة أثناء مُؤتمر الأرشيدوق

317
00:23:08,170 --> 00:23:11,400
إذاً، هذا ما يُلبَس تحت الملابس؟

318
00:23:11,400 --> 00:23:15,210
،أجل. هذا يؤدّي وظيفة درع للفارس
والّذي يكون مصنوعاً من أحجار ماسيكي

319
00:23:15,210 --> 00:23:19,500
يرتدي الفُرسان هذا تحت ملابسهم وذلك
كي يكونوا جاهزين للمعركة في أيّ وقت

320
00:23:19,500 --> 00:23:21,860
هل أخي كورنيليوس يرتدي هذا أيضاً؟

321
00:23:21,860 --> 00:23:22,750
أجل

322
00:23:22,750 --> 00:23:25,500
في الدّوقيّات المليئة بالاضطراب، يُقال
بأنّه حتّى العُلماء

323
00:23:25,500 --> 00:23:28,310
والخدَم يرتدونه لحماية أنفسهم
من هجمات مُباغِتة

324
00:23:28,310 --> 00:23:29,790
ستتعلّمين كيفيّة ارتداء واحد

325
00:23:29,790 --> 00:23:32,000
حالما تلتحقين بالأكاديميّة الملكيّة
يا روزيماين-ساما

326
00:23:32,000 --> 00:23:34,380
!ماذا؟ سأرتدي درعاً أيضاً

327
00:23:35,070 --> 00:23:38,560
...إ-إنّه ثقيل جدّاً لدرجة لا أستطيع الحركة

328
00:23:39,560 --> 00:23:44,230
...أريد أن أُحمَى بواسطتك للأبد يا بريغيتّي

329
00:23:42,020 --> 00:23:44,940
،بما أنّه صُنِع بالمانا الخاصّة بها
فهو يبدو بلا وزن عادة

330
00:23:44,940 --> 00:23:49,970
الرّسم بواسطة: شينا ساتسكي