20
00:00:50,800 --> 00:00:53,260
يا له من مسار دخاني جميل

21
00:00:57,480 --> 00:01:00,030
!كونيّ فائق

22
00:02:33,810 --> 00:02:38,110
وبهذا نختتم مُخطّطاتنا حول كيفيّة استخدامنا

23
00:02:38,110 --> 00:02:42,050
لصالة الجمعيّة أثناء حدَث افتتاح الصّالة

24
00:02:42,330 --> 00:02:45,080
كوزورو ميكا-كن من حزب الثّقافة الثانويّة الجديدة

25
00:02:47,920 --> 00:02:49,890
كوزورو ميكا-كن

26
00:02:49,890 --> 00:02:52,420
ميكا-دونو، إنّه يناديكِ

27
00:02:53,280 --> 00:02:54,590
كوزورو ميكا-كن

28
00:02:54,590 --> 00:02:55,770
نعم

29
00:02:57,430 --> 00:03:04,430
...فيما يخصُّ مخطّطاتنا لحدَث افتتاح الصّالة

30
00:03:04,430 --> 00:03:08,450
من فضلكم اطّلعوا إلى المُستند الذي زُوِّدتُم به

31
00:03:08,450 --> 00:03:09,210
رصد مسارات القطع المُكافئ
باستخدام صواريخ القناني

32
00:03:11,560 --> 00:03:14,540
هلّا طرحتُ سؤالاً؟

33
00:03:15,000 --> 00:03:15,500
تفضّل

34
00:03:15,500 --> 00:03:21,310
لِمَ يجب علينا استخدام غرفة رصد في بناء
المجلس لإطلاقِ صواريخ القناني؟

35
00:03:21,310 --> 00:03:23,240
هل هنالك سبب؟

36
00:03:23,240 --> 00:03:26,470
هل أفتقرُ لقدرة الاستيعاب؟

37
00:03:26,760 --> 00:03:29,040
...فـ-في الواقع

38
00:03:29,040 --> 00:03:30,680
...أنا

39
00:03:31,280 --> 00:03:35,960
ظننتُ أنّه إذا فعلنا شيئاً عاديّاً

40
00:03:35,960 --> 00:03:39,550
في مكانٍ غير عاديّ كبناء المجلس

41
00:03:37,930 --> 00:03:39,320
هكذا

42
00:03:39,320 --> 00:03:40,440
استمرّي

43
00:03:40,090 --> 00:03:43,270
فسيولّد ذلك اهتماماً بالفضاء

44
00:03:44,130 --> 00:03:45,290
طموح؟

45
00:03:46,000 --> 00:03:49,790
كنتُ آمل أن أستنهض شيئاً كهذا في نفوس الزوّار

46
00:03:49,790 --> 00:03:51,120
هكذا إذاً

47
00:03:51,120 --> 00:03:54,000
أعتقد أنّها لفكرة جميلة جدّاً أن نرى
الأمور من منظور طفلة

48
00:03:54,270 --> 00:03:55,900
شكراً لك

49
00:03:55,900 --> 00:03:58,440
...لكن لا أدري

50
00:03:58,440 --> 00:04:00,630
أنا لا أشعر بشغفكِ

51
00:04:01,030 --> 00:04:02,880
أو حماسكِ ربّما

52
00:04:03,320 --> 00:04:07,450
لا يمكننا تمرير مشروع يخلو من الحماس

53
00:04:08,220 --> 00:04:11,500
إضافةً إلى أنّنا لم نسبق أن فعلنا ذلك

54
00:04:11,970 --> 00:04:15,390
وتقولين أنّكِ تريدين استخدام غرفة الرّصد؟

55
00:04:15,390 --> 00:04:19,650
لم تسمعي بالأسطورة الفظيعة حولَ ذلك المكان، أليس كذلك؟

56
00:04:25,170 --> 00:04:27,480
إيناغاوا

57
00:04:27,480 --> 00:04:29,900
سيسبّبُ لنا بعضَ المتاعب

58
00:04:29,900 --> 00:04:31,040
من هذا؟

59
00:04:31,040 --> 00:04:33,040
إنّه مزعج

60
00:04:33,040 --> 00:04:35,470
يظهر في كلّ صيف خلالَ هذه الفترة

61
00:04:35,470 --> 00:04:38,920
فقد ليعرقل مقترحاتنا

62
00:04:39,210 --> 00:04:42,420
ما زال حصار إيناغاوا الصيفيّ راسِخاً على ما أعتقد

63
00:04:42,730 --> 00:04:44,600
لم أكن أدري

64
00:04:45,460 --> 00:04:49,430
أرجو أن تكون هنالك طريقة لمُساعدة
حزب الثّقافة الثانويّة الجديدة

65
00:04:49,910 --> 00:04:52,680
إن لم يكن لديكنّ أي نقض، فقد انتهينا

66
00:05:01,780 --> 00:05:04,330
أنفي متهيّج

67
00:05:04,330 --> 00:05:07,110
مهلاً، مهلاً، أتصابين برشح الصّيف؟

68
00:05:08,530 --> 00:05:09,960
...أنتَ ذلك المزعج

69
00:05:11,350 --> 00:05:13,840
هل ناديتِني بشيء ما؟

70
00:05:13,840 --> 00:05:16,490
شكراً على عملِك الدّؤوب يا إيناغاوا-سينسي

71
00:05:17,000 --> 00:05:21,930
يمكن للرشح أن يصيبكِ في الأوقات
غير المتوقّعة أثناء الصّيف

72
00:05:21,930 --> 00:05:24,780
بالتوفيق

73
00:05:29,020 --> 00:05:32,410
لا بدّ وأنّ السّبب هو عطره

74
00:05:32,410 --> 00:05:34,600
إنّه حادٌّ جدّاً كما سمعنا من إشاعات

75
00:05:37,590 --> 00:05:39,930
أخطأتُ ثانية

76
00:05:40,830 --> 00:05:44,940
لستُ جيّدة في التعبيرِ عن رأيي

77
00:05:45,560 --> 00:05:50,440
ماذا أفعل لأصبح سياسيّة عظيمة مثلكِ؟

78
00:05:54,830 --> 00:05:56,710
عرفتُ أنّني سأجدكِ هنا

79
00:05:57,200 --> 00:06:00,120
جاء حزبُ البطلاتِ إلى هنا

80
00:06:00,120 --> 00:06:02,130
يجبُ ألّا تدعينهن ينتظرن

81
00:06:03,590 --> 00:06:05,470
شكراً للانتظار

82
00:06:05,470 --> 00:06:08,040
آسفة لاستدعائكن

83
00:06:09,300 --> 00:06:12,490
سندعوكن على حسابنا اليوم يا أشرف ضيوفنا

84
00:06:12,490 --> 00:06:14,260
كُلنَ ما تشأن رجاء

85
00:06:14,570 --> 00:06:17,850
هذا ما أردتُ الحديث عنه

86
00:06:19,280 --> 00:06:23,260
إنّه صغير، لكنّه مثل صاروخ حقيقيّ

87
00:06:24,980 --> 00:06:31,230
سيطير من غرفةِ الرّصد في بناء المجلس
على شكلِ قطع مكافئ

88
00:06:31,230 --> 00:06:33,400
تخيّلن الأمر

89
00:06:33,400 --> 00:06:34,870
!سيفعلُ هذا

90
00:06:35,130 --> 00:06:38,180
ونرى الفضاءَ الخارجيّ خلفه

91
00:06:39,370 --> 00:06:40,780
آسفة

92
00:06:43,570 --> 00:06:44,380
مفاجأة

93
00:06:44,380 --> 00:06:45,520
ما رأيكما؟

94
00:06:44,380 --> 00:06:48,380
إطلاق صاروخ القنينة رقم 37
نتائج الرّصد

95
00:06:45,520 --> 00:06:48,380
أليس هذا قطعاً مكافئاً جميلاً؟

96
00:06:49,090 --> 00:06:50,300
بالتأكيد

97
00:06:50,300 --> 00:06:52,410
قطع مكافئ؟

98
00:06:52,410 --> 00:06:57,050
...الانفجار الكبير والثّقوب السّوداء وحتّى الكائنات الفضائيّة

99
00:06:57,050 --> 00:07:01,000
هنالك كثير من الألغازِ غير المحلولة حتّى بعلمنا المتطوِّر

100
00:07:01,000 --> 00:07:02,890
!إنّه كونيّ بامتياز

101
00:07:02,890 --> 00:07:05,800
الفضاء مليء بالأحلام

102
00:07:05,800 --> 00:07:08,860
...لذا أريدُ أن أطلق صواريخَ القناني

103
00:07:08,860 --> 00:07:12,160
لمشاركة أحلام الفضاء

104
00:07:12,160 --> 00:07:13,600
تماماً

105
00:07:13,600 --> 00:07:16,540
هل تتذكّرين إينواشي؟

106
00:07:16,540 --> 00:07:17,540
إينواشي؟

107
00:07:17,850 --> 00:07:21,340
إنّه المسبار الكويكبيّ الذي قطعَ مسافة 6 مليار كم

108
00:07:21,340 --> 00:07:24,040
نجحَ في العودةِ ببعضِ العيّنات

109
00:07:24,350 --> 00:07:27,550
حقّقَ نجاحاً باهراً آنذاك

110
00:07:27,550 --> 00:07:32,140
بفضل تلك المهمّة، كانت عيون كلّ اليابانيين تتأمّل النجوم

111
00:07:32,720 --> 00:07:36,240
أريدُ أن يهتمَّ الناسُ أكثر بالفضاء

112
00:07:36,240 --> 00:07:38,390
لهذا خطرَ ذلك الحدَث على بالي

113
00:07:39,200 --> 00:07:43,350
أنتِ تتكلّمين كثيراً مُقارنة بكلامكِ في الاجتماع

114
00:07:44,120 --> 00:07:47,290
مع الأسف، لا أظنُّه سيكون من السّهل

115
00:07:47,290 --> 00:07:51,670
كسب التمويل لحدَث افتتاح الصّالة بطريقتكِ في شرح الأمر

116
00:07:52,790 --> 00:07:55,240
توقّعتُ أن تكون الانطباعات كذلك

117
00:07:55,650 --> 00:08:01,990
وليزيد الطين بلّة، إيناغاوا-سينسي يستغلُّ خجلَ
ميكا-دونو المعتاد ويستفزّها

118
00:08:03,070 --> 00:08:07,040
تمنّينا أن يدعمنا حزب البطلات

119
00:08:07,040 --> 00:08:10,670
إذاً سنجعله حدثاً مُشتركاً مع حزب الثّقافة
الثانويّة الجديدة؟

120
00:08:10,940 --> 00:08:15,390
باتَ حزب البطلات يحلُّ كافّة المشاكل

121
00:08:15,390 --> 00:08:18,810
سيكون من العظيم أن تمدّوا لنا يد العون

122
00:08:18,810 --> 00:08:23,040
لكن لم أكن أعلم بوجود غرفة رصد
في بناء المجلس

123
00:08:23,040 --> 00:08:27,000
الطابق الثّامن وما فوق يُمنَع دخولهم

124
00:08:27,000 --> 00:08:28,540
يُمنَع؟

125
00:08:28,540 --> 00:08:29,740
لماذا؟

126
00:08:33,110 --> 00:08:37,370
أتريدين معرفة سبب منع النّاس من دخوله؟

127
00:08:38,140 --> 00:08:41,660
هل تريدين أن تسمعي السّبب الفظيع الذي جعلَ

128
00:08:41,660 --> 00:08:44,120
الطابق الثّامن يُعرَف بالغرفة المحظورة؟

129
00:08:45,330 --> 00:08:50,320
حدثَ ذلك في ليلةٍ صيفيّةٍ دافئة في مبنى المجلس

130
00:08:50,320 --> 00:08:58,360
صعدَ حارسٌ بتردُّد وخوف إلى الطابق الثّامن

131
00:08:58,360 --> 00:09:01,520
عندما شعرَ برعشةٍ غريبة

132
00:09:03,510 --> 00:09:06,730
مُتسارعة نبضات قلبه، مقشعراً بدنه، أحسُّ
بوجود شيء ما في الغرفة

133
00:09:06,730 --> 00:09:09,400
...فاستدار ليجد

134
00:09:15,600 --> 00:09:19,470
العاملون في بناءِ المجلس كانوا يستخدمون الغرفة

135
00:09:19,470 --> 00:09:23,820
كانوا يتمرّنون على رقصِ الصّالات قبل الحرب

136
00:09:23,820 --> 00:09:25,370
في صالة المجلس الوطني؟

137
00:09:25,370 --> 00:09:26,790
هذا مفاجئ

138
00:09:27,500 --> 00:09:32,440
كان هناك زوجان تعرّفا إلى بعضهما الآخر
أثناء الرّقص في تلك الغرفة

139
00:09:32,440 --> 00:09:34,460
لكن لم يكتمل حبّهما

140
00:09:34,760 --> 00:09:37,880
قيل أنَّ تلك المرأة قد جُرِحَ قلبها بشكلٍ بليغ

141
00:09:37,880 --> 00:09:42,180
فرمَتْ بنفسها من الطابق الثّامن
حيثُ صنعا ذكرياتٍ ثمينة معاً

142
00:09:43,470 --> 00:09:47,260
إذاً تلك المرأة عالقة هناك دون أن ترقد روحها بسلام؟

143
00:09:47,260 --> 00:09:49,500
لا تعقدن الحدثَ هناك

144
00:09:49,500 --> 00:09:52,730
البيت المسكون ليس مكاناً لتجمُّع الناس

145
00:09:53,050 --> 00:09:55,310
،ما لم تكوني إلهة أو قدِّيسة

146
00:09:55,310 --> 00:09:58,740
لن تتمكّني من التخلُّص من الشبح

147
00:10:00,370 --> 00:10:03,990
أتعني أنَّ وحده الإله أو القدّيس من يستطيع طرد روحها؟

148
00:10:04,600 --> 00:10:07,840
أظنُّني أنا من تبحثون عنه

149
00:10:07,840 --> 00:10:11,630
أنا، ياميرينغو-ساما، سأخضِع الشبحَ على ركبتيه

150
00:10:11,630 --> 00:10:14,170
!نحن صيّادات الشبح

151
00:10:14,170 --> 00:10:16,670
!إنّه حزب الإنقاذ

152
00:10:17,120 --> 00:10:18,680
،بمُساعدة الرّائعة جدّاً

153
00:10:18,680 --> 00:10:23,680
والفيجوال-كي يامي رينغو-ساما، سيكون حالنا
أفضل بكثير

154
00:10:23,680 --> 00:10:24,680
شكراً لكُن

155
00:10:24,940 --> 00:10:26,760
مقابل إطعامنا وإشرابنا

156
00:10:26,760 --> 00:10:28,650
ستحصلن على دعمي

157
00:10:28,650 --> 00:10:30,700
مع أنّه لم يكن هنالك أي مشروب

158
00:10:30,700 --> 00:10:32,440
حلفكِ هو شرف لي يا ناتسكي-دونو

159
00:10:32,930 --> 00:10:34,220
حسناً، هيّا بنا

160
00:10:34,220 --> 00:10:35,260
!نعم

161
00:10:35,260 --> 00:10:37,690
نحن بأيدٍ أمينة يا ميكا-دونو

162
00:10:38,720 --> 00:10:40,140
انتظرن

163
00:10:41,650 --> 00:10:45,080
يبدو وكأنّ تلك الفتيات لم يستسلمن بعد

164
00:10:49,530 --> 00:10:52,300
لن أقبل بصواريخ القناني إطلاقاً

165
00:10:52,300 --> 00:10:54,840
،إن أردنا ميزانيّةً جيّدةً في العامِ المقبل

166
00:10:54,840 --> 00:11:00,220
نحتاج لعقدِ حدثٍ يستهلك كلّ الفائض
كحدثِنا نحن

167
00:11:00,490 --> 00:11:01,660
بالفعل

168
00:11:01,660 --> 00:11:04,300
سنعرقلُ مشروعهن

169
00:11:04,300 --> 00:11:07,080
لسنا بحاجةٍ لتمويل أحلام سخيفة

170
00:11:07,080 --> 00:11:07,970
...لكن

171
00:11:09,460 --> 00:11:11,980
لا داعي للقلق

172
00:11:18,420 --> 00:11:22,650
سيُقدِّمن المُساعدة لنا في القضاءِ على الشبح

173
00:11:22,650 --> 00:11:26,010
آمل أن يمضي الحدث على خير ما يُرام

174
00:11:49,960 --> 00:11:52,230
هل سنكون بأمان حقّاً؟

175
00:11:53,220 --> 00:11:56,100
سنستخدم هذا لإيجادِ الشّبح

176
00:12:03,460 --> 00:12:05,000
أخفتني

177
00:12:05,000 --> 00:12:06,280
أنا آسفة

178
00:12:11,580 --> 00:12:14,090
أحسُّ بوجود الشبح هنا

179
00:12:14,680 --> 00:12:17,350
لا أرى أي أشباح

180
00:12:24,810 --> 00:12:28,030
شعرتُ بشيء للتو

181
00:12:28,030 --> 00:12:30,020
هل أنت بخير؟

182
00:12:32,520 --> 00:12:34,310
!هذا يكفي

183
00:12:41,140 --> 00:12:42,490
!عليك أن تتخطّيني

184
00:12:44,320 --> 00:12:49,040
تتحلِّين بجرأةٍ كافية لإخافتي

185
00:12:49,040 --> 00:12:50,240
!ملح

186
00:12:50,240 --> 00:12:52,200
!طهِّروها بالملح

187
00:12:52,200 --> 00:12:53,790
ملح

188
00:12:52,690 --> 00:12:53,790
!ارجعي

189
00:12:56,580 --> 00:12:58,670
!هذا لا ينجح

190
00:12:59,460 --> 00:13:00,800
لا بأس

191
00:13:00,800 --> 00:13:03,920
حزب الثقافة الثانويّة الجديدة
كوزورو ميكا

192
00:13:02,070 --> 00:13:03,920
شكراً لكِ

193
00:13:05,890 --> 00:13:07,620
هل أخدمكم بشيء؟

194
00:13:08,310 --> 00:13:10,810
ألستِ خائفة منّا؟

195
00:13:11,160 --> 00:13:13,180
في الواقع، هذا شرفٌ لي

196
00:13:14,260 --> 00:13:16,060
تتمتّعين بحكمةٍ بالغة

197
00:13:16,060 --> 00:13:19,950
تمكُّني من التحدُّث مع الرجال

198
00:13:19,950 --> 00:13:22,690
الذين أسّسوا اليابان يُثبِت إمكانيّة الكون اللّامحدودة

199
00:13:23,840 --> 00:13:27,560
لعلّنا صادفنا فتاةً ذات عقليّة منفتحة

200
00:13:27,960 --> 00:13:31,590
هذا العالمُ مليء بالكونيّات

201
00:13:33,270 --> 00:13:35,960
!هذا يبعثُ على السّرور

202
00:13:39,590 --> 00:13:40,990
مشروب أرزّ مقدّس

203
00:13:40,990 --> 00:13:42,460
!قُضي عليكِ

204
00:13:43,410 --> 00:13:45,610
لا أدري ما إن كان يجوز الشرب

205
00:13:45,610 --> 00:13:47,180
نحن تحت السنّ القانوني

206
00:13:47,180 --> 00:13:49,980
سنواجه قضايا الإذعان التنظيمي

207
00:13:51,010 --> 00:13:52,180
هذا صحيح

208
00:13:52,510 --> 00:13:54,600
حسناً إذاً

209
00:13:54,600 --> 00:13:57,270
سأتولَّى أنا هذا الأمر

210
00:14:02,570 --> 00:14:03,740
!يا إلهي

211
00:14:03,740 --> 00:14:05,070
!لا تظهري العديدَ منها أرجوكِ

212
00:14:05,070 --> 00:14:06,070
!تصرُّف لا جدوى منه

213
00:14:06,070 --> 00:14:08,200
جاءَ أجلُنا

214
00:14:07,270 --> 00:14:08,200
!جدّتي

215
00:14:08,200 --> 00:14:10,490
!لم يؤثّر هذا

216
00:14:10,490 --> 00:14:12,740
فشلتُ في الالتزام بوعدي

217
00:14:13,540 --> 00:14:17,240
أنتُنّ مشاغبات حقّاً

218
00:14:17,240 --> 00:14:20,780
لكن أستمتع بمُشاهدتكن أيّتها الفتيات

219
00:14:20,780 --> 00:14:23,440
ومشاهدة سلوككن الجريء

220
00:14:23,440 --> 00:14:26,330
أتعرفوننا؟

221
00:14:26,330 --> 00:14:27,470
عضوات المجلس النجمات

222
00:14:27,470 --> 00:14:29,050
نعرفكن بالطبع

223
00:14:29,320 --> 00:14:35,230
كنتُنّ تُلقِّنَّ حزبَ روغاي درساً قاسياً

224
00:14:35,230 --> 00:14:38,230
كلّ ما تفعلنه مُمتع

225
00:14:38,230 --> 00:14:41,940
جعلَنا ذلك نتعلّقُ كثيراً بحزب المجلس النجمات

226
00:14:41,940 --> 00:14:44,570
من المفضَّلة لديكم؟

227
00:14:46,340 --> 00:14:49,720
هنالك كثير من السيِّدات المسلِّيات

228
00:14:49,720 --> 00:14:52,570
لكن أنتِ المفضَّلة بلا شكّ

229
00:14:53,400 --> 00:14:54,830
أنا؟

230
00:14:55,300 --> 00:14:59,760
لطالما تلعثمتِ كثيراً أثناء اجتماعات المجلس

231
00:14:59,760 --> 00:15:02,710
لدرجةٍ تستفزُّني كثيراً

232
00:15:03,240 --> 00:15:05,920
لا أستطيع إلّا أن أشجّعكِ

233
00:15:05,920 --> 00:15:07,340
كم هذا مُحرِج

234
00:15:07,720 --> 00:15:12,360
مع ذلك تصبحين ثرثارة كثيراً عندما يتعلّق
الأمر بما تكنّين له مشاعر شغف

235
00:15:12,360 --> 00:15:16,000
لا ينبغي أن تدعي أشرار حزب روغاي يضغطون عليكِ

236
00:15:16,000 --> 00:15:17,970
تحلِّي بالثقة

237
00:15:18,250 --> 00:15:23,480
لكن أولئك الرّجال ليسوا أشراراً بالنسبة إليّ

238
00:15:23,480 --> 00:15:25,320
..."لا أسبقيّة"

239
00:15:25,320 --> 00:15:30,110
يجب أن تضربي بكلامهم المُبتذل وأعذارهم عرض الحائط

240
00:15:30,110 --> 00:15:33,870
أعتقد أنَّ ما فعلناه كان بِلا سابِقة أيضاً

241
00:15:35,320 --> 00:15:37,790
بِلا سابِقة؟

242
00:15:37,790 --> 00:15:41,550
لكن لا يتمحور الأمر حول ضرب الأمور عرض الحائط فقط

243
00:15:41,550 --> 00:15:44,250
بل يجب أن تكون لديكِ رؤيتكِ الخاصّة

244
00:15:44,250 --> 00:15:47,130
هل لديكِ رؤيتكِ الخاصّة؟

245
00:15:47,510 --> 00:15:48,800
...في الواقع

246
00:15:49,130 --> 00:15:52,620
لهذا تتردّدين كثيراً أثناء الاجتماعات

247
00:15:52,620 --> 00:15:55,340
لماذا تريدين أن تقيمي حدَثاً هنا؟

248
00:15:55,340 --> 00:15:56,540
ما السبب؟

249
00:15:57,110 --> 00:16:02,560
...في الواقع، لأنّ

250
00:16:07,080 --> 00:16:11,500
حتّى بهذا الاقتصاد، حتّى بعدمِ المساواة
الذي يزدادُ سوءاً

251
00:16:11,500 --> 00:16:14,410
أريد أن يتحلّى الناسُ بشجاعةِ الحلم

252
00:16:15,650 --> 00:16:19,600
أريد أن أقيم حدثاً هنا في بناء المجلس

253
00:16:19,600 --> 00:16:25,190
لأعلّم النّاس أن يطمحوا وينظروا للأعلى، نحو الفضاء

254
00:16:28,080 --> 00:16:31,210
لديكِ رؤية إذاً

255
00:16:34,510 --> 00:16:36,720
تبّاً للاقتصادِ العالمي

256
00:16:36,720 --> 00:16:38,780
تبّاً للعولمة

257
00:16:38,780 --> 00:16:41,350
نحن ندع القوى العالميّة هي التي تدفعنا فحسب

258
00:16:41,350 --> 00:16:45,650
لا تدعي الأشرار يتفوّقون عليكِ بمخطّطاتهم المملّة

259
00:16:45,650 --> 00:16:47,850
فلينعتوكِ بالساذجة

260
00:16:47,850 --> 00:16:50,170
فلينعتوكِ بالمؤمنة بالمثاليّات

261
00:16:50,170 --> 00:16:52,190
امضي وأريهم ثقتكِ

262
00:16:53,200 --> 00:16:58,140
تستطِعن أنتنّ عضوات المجلس النجمات رسم البسمة
على وجوهِ النّاس

263
00:16:58,140 --> 00:17:03,580
قد تجدن تمثايلكن البرونزيّة هنا يوماً ما

264
00:17:06,960 --> 00:17:09,770
نؤمن بأنَّ ذلك سيتحقّق

265
00:17:15,630 --> 00:17:16,430
خذوا

266
00:17:16,430 --> 00:17:17,840
شكراً جزيلاً لكم

267
00:17:19,090 --> 00:17:20,980
أهذا مهمٌّ لكِ؟

268
00:17:22,400 --> 00:17:24,480
هل يُفترَض أن تكون هذه رسوم تعليمكِ؟

269
00:17:27,860 --> 00:17:30,330
أما من شيء نستطيع فعله؟

270
00:17:30,330 --> 00:17:31,180
!اصمتي

271
00:17:31,180 --> 00:17:33,610
أفكِّرُ بطريقةٍ أخرى لطردهم

272
00:17:33,610 --> 00:17:35,320
حريّ بكِ فعل ذلك

273
00:17:35,750 --> 00:17:37,180
!هذا يكفي

274
00:17:37,180 --> 00:17:38,080
!يكفي

275
00:17:40,610 --> 00:17:43,670
لم أتوقَّع أن يكون لديكِ أشياء كهذه يا رينغو-ساما

276
00:17:45,700 --> 00:17:49,290
!كنزي

277
00:17:56,380 --> 00:17:57,800
اختفَتْ

278
00:17:59,880 --> 00:18:00,760
...أليست هذه

279
00:18:01,590 --> 00:18:03,360
لإيناغاوا-سينسي؟

280
00:18:04,040 --> 00:18:06,670
...وعطسكِ يا ناتسكي-دونو

281
00:18:06,670 --> 00:18:10,090
لا بدَّ وأنَّ إيناغاوا-سينسي كان هنا

282
00:18:13,320 --> 00:18:16,250
هذه أشبه بقبّةٍ فلكيّة

283
00:18:20,770 --> 00:18:22,910
كان ذلك وشيكاً

284
00:18:22,910 --> 00:18:24,910
كُدنَ يكشفنني

285
00:18:25,920 --> 00:18:27,040
إيناغاوا-سينسي

286
00:18:27,040 --> 00:18:31,350
سأقترحُ حدثَ غرفة الرّصد في اجتماع
المجلس ثانيةً

287
00:18:31,890 --> 00:18:36,060
سنتحدّثُ عن يابان مثاليّة من وجهةِ
نظر كونيّة

288
00:18:36,720 --> 00:18:38,700
لا تكوني ساذجة

289
00:18:38,700 --> 00:18:42,050
من المُحال أن يمضي المشروع من دون وجود سابِقة

290
00:18:42,400 --> 00:18:45,390
إن لم تكن هنالك سابِقة، فسأكون أنا السّابِقة

291
00:18:46,520 --> 00:18:48,980
يمكنك أن تنعتني بالساذجة

292
00:18:49,440 --> 00:18:53,150
لكن السّذاجة التي خسرتَها

293
00:18:53,150 --> 00:18:55,690
هي سلاحنا كعضوات مجلِس نجمات

294
00:18:55,690 --> 00:18:59,300
هذا السّلاح هو ما سيرسمُ البسمة
على وجوهِ النّاس

295
00:18:59,880 --> 00:19:04,010
كلّ عضوة منّا تتمتّع باختصاص

296
00:19:04,630 --> 00:19:06,880
أعتقدُ أنّه من واجبنا

297
00:19:06,880 --> 00:19:12,970
أن نستخدم ذلك العلم لدعمِ أحلام النّاس

298
00:19:12,970 --> 00:19:13,670
سينسي

299
00:19:15,190 --> 00:19:17,090
أتطلّعُ قدماً للعمل معك

300
00:19:20,670 --> 00:19:23,190
كان ذلك مدهشاً يا ميكا-دونو

301
00:19:23,600 --> 00:19:25,900
لا بدَّ وأنَّ الفضل يعزو لرجال الدولة العظماء

302
00:19:25,900 --> 00:19:27,510
لِمَن؟

303
00:19:37,520 --> 00:19:40,110
هزمنا الشّبح

304
00:19:40,110 --> 00:19:45,020
عندما هزمنا الشّبح، لمعَ السّقف كقبّة

305
00:19:45,020 --> 00:19:46,990
كان جميلاً للغاية

306
00:19:48,160 --> 00:19:50,880
...تأمُّل النجوم في بناء المجلس

307
00:19:50,880 --> 00:19:52,260
ميكا-دونو؟

308
00:19:54,280 --> 00:19:56,270
سأعيد صياغة المشروع

309
00:19:56,270 --> 00:19:57,630
هلّا ساعدتّني؟

310
00:19:57,630 --> 00:19:59,130
سأفعل بالطبع

311
00:20:00,690 --> 00:20:03,640
كوزورو ميكا-كن من حزبِ الثّقافة الثانويّة الجديدة

312
00:20:03,640 --> 00:20:04,550
حاضرة

313
00:20:04,550 --> 00:20:07,310
مشاهدة زخّات الشهب في غرفة
رصد بناء المجلس

314
00:20:04,550 --> 00:20:07,560
من فضلكم اطّلعوا إلى المُستنَد الذي زُوِّدتُم به

315
00:20:07,560 --> 00:20:12,240
كما تدركون، عندما أنشئ بناء المجلس

316
00:20:12,240 --> 00:20:15,200
كان البناء الأطول في اليابان

317
00:20:15,200 --> 00:20:19,190
كان يُستخدَم كمنارة وكذلك كمرصد

318
00:20:19,480 --> 00:20:25,240
أقترحُ قيام حدث سياحي باستخدام
غرفة المرصد في بناءِ المجلس

319
00:20:25,240 --> 00:20:29,210
نأملُ أن نستذكر الأيّام القديمة الجميلة
عندما أنشئ البناء

320
00:20:29,210 --> 00:20:35,320
بينما نرصدُ النجوم التي كانت ترعانا منذُ ذلك الحين

321
00:20:35,320 --> 00:20:38,840
وندع الزوّار يحلمون

322
00:20:44,760 --> 00:20:46,840
حقّقَ ذلك نجاحاً باهراً

323
00:20:49,120 --> 00:20:53,620
ما كنَّا لننجزه بهذه السرعة لولا مساعدة
حزب البطلات

324
00:20:54,390 --> 00:20:56,420
شكراً جزيلاً لكُن

325
00:20:57,130 --> 00:21:00,730
لكن لماذا ألغيتِ حدثَ إطلاق صاروخ القنينة؟

326
00:21:00,730 --> 00:21:02,650
قالتْ ناتسكي-سان

327
00:21:02,650 --> 00:21:09,050
أنَّ تأمُّل النجوم قد يجمع جمهوراً أوسع

328
00:21:09,970 --> 00:21:11,870
أنا قلتُ ذلك؟

329
00:21:11,870 --> 00:21:13,930
ألا تتذكّرين؟

330
00:21:13,930 --> 00:21:16,370
هذا ليس غريباً من فتاةٍ مثلكِ

331
00:21:17,570 --> 00:21:20,650
حسناً، لنذهب جميعاً يا أصدقاء

332
00:21:20,650 --> 00:21:22,260
...كونيّ

333
00:21:22,540 --> 00:21:25,060
!فائق

334
00:21:28,590 --> 00:21:30,410
...أبي، أنا

335
00:21:30,410 --> 00:21:34,580
لن أقبل بعملكِ كنجمة مهما حاولتِ إقناعي

336
00:21:35,170 --> 00:21:38,400
ثمّة أمور أريدُ إنجازها كعضوة مجلس نجمة

337
00:21:38,400 --> 00:21:39,980
"قلتُ "لن أقبل بذلك

338
00:21:43,810 --> 00:21:45,360
حان الوقتُ، سألتقي بشخص

339
00:21:49,730 --> 00:21:52,440
الرّئيس أونيمارو، شكراً على صبرك

340
00:23:29,970 --> 00:23:39,980
الرّسم: ميكوتو أكيمي

341
00:23:30,480 --> 00:23:33,500
أنا عضوة المجلس النجمة من محافظةِ ساغا
ميتسوتاكي رينا

342
00:23:33,500 --> 00:23:36,940
يجبُ أن تستمعوا لأسطوانتي أنا وميكا-دونو
المتألِّقة التي أصدرناها

343
00:23:36,940 --> 00:23:39,610
!إلى الأمام إلى الحلقة القادمة