1
00:00:02,560 --> 00:00:03,550
كساد

2
00:00:03,550 --> 00:00:04,700
فقر

3
00:00:04,700 --> 00:00:06,480
عدم مساواة

4
00:00:06,480 --> 00:00:08,890
تعيشُ اليابان في عصرٍ مظلم

5
00:00:08,890 --> 00:00:13,740
لكن في عصرِ الشكّ هذا، تنزلُ إلينا
فرقة الإلاهات

6
00:00:17,700 --> 00:00:20,140
،بابتساماتٍ ظريفةٍ وأصوات طربيّة

7
00:00:20,140 --> 00:00:24,080
بهدفِ تغيير اليابان الكئيبة كلّياً

8
00:00:25,880 --> 00:00:27,130
ما اسمها؟

9
00:00:28,050 --> 00:00:31,370
عضوات المجلِس النّجمات

10
00:00:41,840 --> 00:00:44,980
!مياه من كافّة الاتّجاهات

11
00:00:44,980 --> 00:00:47,760
لم نأتِ إلى هنا لنلعب يا ناتسكي

12
00:00:47,760 --> 00:00:51,710
المكان لطيفٌ ومنعشٌ مقارنة بطوكيو

13
00:00:51,710 --> 00:00:52,820
بالفعل

14
00:00:53,400 --> 00:00:54,590
...هذا الشكل

15
00:00:54,590 --> 00:00:56,440
أستطيع رؤية نيكونوشيما

16
00:00:56,440 --> 00:00:59,900
كيف هي نيكونوشيما يا كاماشيرو-سان؟

17
00:00:59,900 --> 00:01:02,660
تشتهر بكثرة القطط

18
00:01:03,040 --> 00:01:06,250
يعيش النّاس والقطط بانسجامٍ تامّ

19
00:01:06,250 --> 00:01:09,290
إنّها جزيرة تُعَدُّ نموذج لمُستقبل مجتمعنا

20
00:01:09,630 --> 00:01:11,360
هنالك كثيرٌ من القطط

21
00:01:11,360 --> 00:01:14,420
أنا واثقة أنّها ستتجمّع حولنا حالما ننزل
من السّفينة

22
00:01:14,720 --> 00:01:19,800
أصحيح ما وردَ في الرّسالة من أطفال نيكونوشيما؟

23
00:01:20,580 --> 00:01:23,720
"القطط مفقودة من الجزيرة"

24
00:01:23,720 --> 00:01:27,190
"ساعدنَنا يا عضوات المجلِس النجمات"

25
00:01:27,530 --> 00:01:30,820
أنا متأكّدة أنّه بقي كثير من القطط

26
00:01:33,470 --> 00:01:37,610
لا توجد ولا قطّة واحدة

27
00:01:39,490 --> 00:01:41,780
أنتم من حزب البطلات، صحيح؟

28
00:01:42,060 --> 00:01:44,360
شكراً لقدومكم إلى هنا

29
00:01:44,360 --> 00:01:48,010
قطّتاي، ماكارون وهانا مفقودتان

30
00:01:48,010 --> 00:01:51,920
قطّاي كورومي وناتس مفقودان أيضاً

31
00:01:52,180 --> 00:01:54,540
أنتُم من أرسل لنا الرّسائل؟

32
00:01:54,540 --> 00:01:55,210
أجل

33
00:01:55,210 --> 00:01:57,420
لماذا غادرت القطط؟

34
00:01:58,210 --> 00:01:59,550
لا ندري

35
00:02:01,480 --> 00:02:03,180
هيّا، ابتعد بسرعة

36
00:02:03,550 --> 00:02:06,440
لماذا تتوقّف هنا؟

37
00:02:06,440 --> 00:02:09,190
دعنا ندخل الجزيرة

38
00:02:09,190 --> 00:02:11,100
إنّها ممثِّلة نيكوشيما

39
00:02:11,100 --> 00:02:12,480
ممثّلة نيكوشيما؟

40
00:02:12,780 --> 00:02:15,610
إنّها عضوة مجلس تمثّل سكّان هذه الجزيرة

41
00:02:15,610 --> 00:02:17,720
لكنّها تكره القطط كثيراً

42
00:02:17,720 --> 00:02:20,870
كتبنا لها لكنّها لم تستجِب لنا

43
00:02:21,160 --> 00:02:24,620
إنّها السيّدة التي تُعادي عضوات المجلس النجمات دوماً

44
00:02:24,890 --> 00:02:27,400
لم أتوقّع رؤيتها هنا

45
00:02:29,760 --> 00:02:33,150
هل الألواح التي تمتدُّ من سقفٍ لآخر هي ممشى للقطط؟

46
00:02:33,150 --> 00:02:34,130
أجل

47
00:02:34,130 --> 00:02:36,510
مخرج للقطط

48
00:02:34,440 --> 00:02:36,030
وما هذه اللّافتات التي في الشّارع؟

49
00:02:36,030 --> 00:02:38,380
تطلب منكِ إفساح المجال للقطط

50
00:02:38,380 --> 00:02:41,510
معبر قطط

51
00:02:38,770 --> 00:02:40,540
أهذه اللّافتة للسيّارات؟

52
00:02:40,540 --> 00:02:41,510
نعم

53
00:02:41,820 --> 00:02:43,020
مذهل

54
00:02:43,020 --> 00:02:45,150
الجميع يحبُّون القطط

55
00:02:45,150 --> 00:02:46,330
بالفعل

56
00:02:47,760 --> 00:02:49,000
يا إلهي

57
00:02:49,000 --> 00:02:50,730
هذا قطُّ الألفا

58
00:02:50,730 --> 00:02:52,400
أهمّ قطّ بينهم على الإطلاق

59
00:02:52,400 --> 00:02:55,320
،يطمئنُّ على القطط في كلّ أرجاء الجزيرة

60
00:02:55,320 --> 00:02:57,150
لكنّه الوحيد هنا الآن

61
00:02:57,510 --> 00:02:59,180
إنّه مُقدَّس في هذه الجزيرة

62
00:02:59,180 --> 00:03:01,590
يجلبُ الحظّ السّعيد إذا لمستموه

63
00:03:01,590 --> 00:03:02,960
،لكن الآن بعد رحيل كلّ القطط

64
00:03:02,960 --> 00:03:05,900
باتَ بمزاجٍ سيّئ، ولا يسمح لنا بلمسه

65
00:03:06,450 --> 00:03:12,670
مهرجان نيكونوشيما هاتشيفوكو دايجين
موجة القطط العملاقة

66
00:03:06,750 --> 00:03:09,260
سيُقامُ مهرجان

67
00:03:09,260 --> 00:03:10,000
نعم

68
00:03:10,000 --> 00:03:12,140
إنّه المهرجان الأكبر في الجزيرة

69
00:03:12,960 --> 00:03:15,090
ماذا يعني موجة قطط عملاقة؟

70
00:03:15,090 --> 00:03:18,420
مهرجان نيكونوشيما هاتشيفوكو دايجين
موجة القطط العملاقة

71
00:03:15,420 --> 00:03:20,990
نجمعُ كثيراً من القطط وندعهم يركضون من خطِّ البداية
حتّى خطّ النّهاية

72
00:03:20,990 --> 00:03:24,970
تتوافد القطط كأمواج هائلة ونغرق جميعاً
في بحرٍ من القطط

73
00:03:25,700 --> 00:03:27,850
يبدو هذا ممتعاً

74
00:03:26,780 --> 00:03:27,850
...لكن

75
00:03:28,960 --> 00:03:32,740
بعد اختفاء كافّة القطط، لا يمكننا أن نقيم المهرجان

76
00:03:33,380 --> 00:03:34,610
لا داعي للقلق

77
00:03:34,880 --> 00:03:37,260
سنتولّى الأمر

78
00:03:37,260 --> 00:03:39,660
لنغرق جميعاً في بحرٍ من القطط

79
00:03:39,660 --> 00:03:41,530
...بحر من القطط

80
00:05:16,840 --> 00:05:21,500
أعلم أنّنا اتّفقنا على مُساعدتهم، لكن
لا أرى أي قطّة

81
00:05:22,480 --> 00:05:24,760
طاب يومكم جميعاً

82
00:05:24,760 --> 00:05:26,060
يا إلهي

83
00:05:26,060 --> 00:05:27,230
ساكوراكو-سان

84
00:05:27,230 --> 00:05:28,570
وإيسوزو-سان

85
00:05:28,570 --> 00:05:31,600
مرحباً

86
00:05:31,860 --> 00:05:33,160
من تلكما الاثنتان؟

87
00:05:33,160 --> 00:05:37,370
إيزوكا ساكوراكو-سان وناروكامي إيسوزو-سان
من حزب ضوء الشّمس

88
00:05:37,830 --> 00:05:40,650
أنتُما عضوتا مجلس نجمتان مثلنا إذاً

89
00:05:40,650 --> 00:05:43,920
أنتِ عضوة المجلس النجمة الجديدة، أليس كذلك؟

90
00:05:43,920 --> 00:05:45,000
نـ-نعم

91
00:05:45,000 --> 00:05:46,060
اسمي هوشينا ناتسكي

92
00:05:46,060 --> 00:05:47,960
سُرِرتُ بلقائك

93
00:05:47,960 --> 00:05:49,370
إتسوكا ساكوراكو

94
00:05:49,370 --> 00:05:50,680
سُرِرتُ بلقائكِ أيضاً

95
00:05:50,680 --> 00:05:53,780
شيرايوكي-سان

96
00:05:54,880 --> 00:05:56,240
!شيرايوكي-سان

97
00:05:56,240 --> 00:05:57,870
عليكِ أن تلقي التّحية أيضاً

98
00:05:59,570 --> 00:06:00,790
جيّد

99
00:06:01,100 --> 00:06:02,830
أياي شيرايوكي-سان

100
00:06:02,830 --> 00:06:05,130
إنّها من مُحافظة أودون

101
00:06:05,130 --> 00:06:08,070
هذا الحساء استثنائي

102
00:06:09,000 --> 00:06:09,900
مرحباً

103
00:06:09,900 --> 00:06:11,930
سُرِرتُ بلقائكِ

104
00:06:12,370 --> 00:06:16,060
هل تلقّيتُما رسالةً أيضاً؟

105
00:06:16,330 --> 00:06:17,310
نعم

106
00:06:17,310 --> 00:06:22,180
سنذهب إلى أي مكان إذا ما احتاجنا أحد

107
00:06:24,640 --> 00:06:26,800
تتمتّع بابتسامة نجمة مثاليّة

108
00:06:26,800 --> 00:06:29,400
لا عجب في أنّها أفضل نجمة في ضوء الشّمس

109
00:06:29,400 --> 00:06:31,030
يا للهول يا ساكوراكو-سان

110
00:06:31,590 --> 00:06:33,820
انجرفت السّفينة بعيداً

111
00:06:33,820 --> 00:06:34,540
يا للهول

112
00:06:35,540 --> 00:06:38,830
تأتينا أمواج غريبة خلال هذا الموسم

113
00:06:39,710 --> 00:06:40,760
يا إلهي

114
00:06:40,760 --> 00:06:44,030
سنضطرُّ لشراء سفينة جديدة للعودةِ بها إلى المنزل

115
00:06:44,030 --> 00:06:45,920
عمّاذا تتكلّمين؟

116
00:06:45,920 --> 00:06:47,460
سنلحق بالسّفينة

117
00:06:48,280 --> 00:06:49,880
أنتِ أيضاً يا شيرايوكي-سان

118
00:07:03,110 --> 00:07:04,200
يا إلهي

119
00:07:04,200 --> 00:07:07,440
حتّى شيزوكا "الأوني" تخاف من شيء ما

120
00:07:07,440 --> 00:07:08,490
!شيزوكا

121
00:07:08,840 --> 00:07:10,730
هل أنتِ بخير؟

122
00:07:10,730 --> 00:07:16,490
اربطن قاربكن جيّداً وإلّا انجرف بعيداً

123
00:07:16,490 --> 00:07:19,500
هل تعرفين الكثير عن هذه الجزيرة؟

124
00:07:19,790 --> 00:07:23,310
عشتُ لفترةٍ طويلةٍ فحسب

125
00:07:23,310 --> 00:07:25,200
فترة طويلة جدّاً

126
00:07:25,200 --> 00:07:29,040
تُعرَف جدّتي بالموسوعة المتنقّلة للجزيرة

127
00:07:29,040 --> 00:07:31,510
تعرف كلّ شيء عن هذه الجزيرة

128
00:07:33,250 --> 00:07:36,010
هل كنتِ هنا تطبخين الأودون دوماً؟

129
00:07:37,440 --> 00:07:41,820
ستأتي أربع جوارٍ من وراء البحر

130
00:07:41,820 --> 00:07:44,500
"وترقصن على منصّة حجريّة من القطط

131
00:07:45,580 --> 00:07:50,780
إنّها أسطورة قديمة جدّاً

132
00:07:52,130 --> 00:07:54,030
!ناتسكي-تشان

133
00:07:54,030 --> 00:07:56,120
إلى اللِّقاء يا جدّتي

134
00:07:58,420 --> 00:08:02,790
هذه الجزيرة لطيفة جدّاً من دون قطط

135
00:08:03,280 --> 00:08:05,230
هل أنتِ متأكّدة من هذا يا سينسي؟

136
00:08:05,230 --> 00:08:07,580
المعلَم السياحي الوحيد الذي لدينا هنا هو القطط

137
00:08:07,580 --> 00:08:11,510
لن يأتي أحدٌ إلى هذه الجزيرة بعد الآن
في ظلِّ عدم وجود قطط هنا

138
00:08:12,000 --> 00:08:14,040
لا يهمّني

139
00:08:14,040 --> 00:08:17,110
أكره القطط أكثر من أي شيء آخر في هذا العالم

140
00:08:19,170 --> 00:08:23,600
بينما كنتُ صغيرة فعلت القطط ما يحلو لها

141
00:08:23,600 --> 00:08:25,660
بينما عشتُ أنا حياة تعيسة

142
00:08:26,600 --> 00:08:29,920
...سلوكها التافه والمُتعالي

143
00:08:29,920 --> 00:08:31,850
مجرّد رؤيتها يشعرني بالغضب

144
00:08:33,940 --> 00:08:37,960
بحثنا في كلّ مكان، لماذا لا نرى حتّى قطّة واحدة؟

145
00:08:37,960 --> 00:08:41,500
لنسأل سكّان الجزيرة إن كانت لديهم أي أفكار غداً

146
00:08:41,500 --> 00:08:43,830
إلى أين ذهبتما؟

147
00:08:45,110 --> 00:08:47,020
لنسأل قطّ الألفا

148
00:08:47,020 --> 00:08:49,770
أنا واثق أنّه سيخبرنا إذا سمح لنا باللّعب معه

149
00:08:49,770 --> 00:08:52,200
هل سيخبرنا قطّ الألفا؟

150
00:08:52,200 --> 00:08:55,030
...أرجوكِ، أوني-تشان

151
00:08:55,030 --> 00:08:57,220
هلّا أتيتِ معنا؟

152
00:08:57,520 --> 00:08:59,100
اللّيل يخيّم

153
00:08:59,100 --> 00:09:00,040
لنذهب إلى المنزل

154
00:09:00,040 --> 00:09:05,020
ساتشي-سان، هل يمكنني الذهاب معهم غداً؟

155
00:09:05,020 --> 00:09:06,380
بالتأكيد

156
00:09:06,380 --> 00:09:08,730
شيزوكا وأنا سنجري مقابلة مع النّاس

157
00:09:09,090 --> 00:09:12,030
لنلتقِ بعد أن تتحرّي معهم

158
00:09:12,030 --> 00:09:13,360
حسناً

159
00:09:14,020 --> 00:09:17,590
لنذهب إلى المنزل اللّيلة ونلعب مع قطّ الألفا غداً

160
00:09:18,640 --> 00:09:19,640
حسناً

161
00:09:21,240 --> 00:09:23,500
كم طبق أودون تحتاجين؟

162
00:09:23,500 --> 00:09:25,690
!قضيتِ طوال هذا الوقت وأنتِ تأكلين

163
00:09:25,690 --> 00:09:28,350
لهذا أوصَتْ شيرايوكي-سان به

164
00:09:28,350 --> 00:09:31,320
طبق أودون هذا يحظى بسعادة ثلاثة نجوم

165
00:09:31,860 --> 00:09:34,210
متى بدأتِ بإعداد هذا الأودون؟

166
00:09:34,520 --> 00:09:37,950
بدأتُ بإعداده منذُ زمنٍ بعيد جدّاً

167
00:09:37,950 --> 00:09:39,520
لنعد إلى العمل

168
00:09:39,520 --> 00:09:42,650
يريد سكّان هذه الجزيرة عودة قططهم

169
00:09:42,650 --> 00:09:45,100
كيف نعيدُ تلك القطط؟

170
00:09:45,450 --> 00:09:50,950
الإجابة هي بالتأكيد طبق حساء أودون
السّمك الطائر الدّافئ هذا

171
00:09:51,510 --> 00:09:53,560
إنّه إدمانيّ للغاية

172
00:09:53,560 --> 00:09:55,280
القطط لا تستطيع أكل الطعام السّاخن

173
00:09:55,550 --> 00:09:56,760
...لنرَ

174
00:09:58,050 --> 00:10:00,290
في أوقات الحاجة، ينبغي أن نصلّي للربّ

175
00:10:00,290 --> 00:10:04,860
توقّعتُ أن تقولي ذلك، لهذا تفقّدتُ مزارات هذه الجزيرة

176
00:10:04,860 --> 00:10:07,190
أحسنتِ صنعاً يا إيسوزو-سان

177
00:10:07,670 --> 00:10:11,340
هل تعرفين أي مزارات جيّدة يا عمّتي؟

178
00:10:12,540 --> 00:10:16,170
نيكونوشيما
خريطة الرّحلة

179
00:10:13,010 --> 00:10:14,980
هذه المزارات الأربعة جيّدة

180
00:10:16,480 --> 00:10:20,170
ستأتي أربع جوارٍ من وراء البحر"

181
00:10:20,170 --> 00:10:22,730
"وترقصن على منصّة حجريّة من القطط

182
00:10:22,730 --> 00:10:25,820
إنّها أسطورة قديمة جدّاً

183
00:10:25,820 --> 00:10:26,890
المزيد رجاء

184
00:10:27,760 --> 00:10:29,230
أما زلتِ تأكلين؟

185
00:10:29,230 --> 00:10:33,890
أليس من الرّائع أن نعلم بوجود
أسطورة جميلة كهذه هنا؟

186
00:10:33,890 --> 00:10:35,760
إن صلّينا في تلك المزارات

187
00:10:35,760 --> 00:10:37,520
فسيحلُّ هذا مُشكلاتنا

188
00:10:37,520 --> 00:10:39,460
حان وقتُ زيارة مزار غداً

189
00:10:40,600 --> 00:10:41,820
انظرن للساعة

190
00:10:42,090 --> 00:10:44,090
بما أنّنا حسمنا أمرنا، لنخلد إلى النّوم

191
00:10:44,090 --> 00:10:46,170
الأرق هو العدوّ الأوّل للبشرة الجيّدة

192
00:10:46,170 --> 00:10:48,440
