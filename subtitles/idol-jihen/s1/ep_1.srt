1
00:00:02,550 --> 00:00:03,550
كساد

2
00:00:03,550 --> 00:00:04,700
فقر

3
00:00:04,700 --> 00:00:06,460
عدم مساواة

4
00:00:06,460 --> 00:00:08,910
تعيشُ اليابان في عصرٍ مظلم

5
00:00:08,910 --> 00:00:13,740
لكن في عصرِ الشكّ هذا، تنزلُ إلينا
فرقة الإلاهات

6
00:00:17,700 --> 00:00:20,140
،بابتساماتٍ ظريفةٍ وأصوات طربيّة

7
00:00:20,140 --> 00:00:24,080
بهدفِ تغيير اليابان الكئيبة كلّياً

8
00:00:25,840 --> 00:00:27,060
ما اسمها؟

9
00:00:27,970 --> 00:00:31,270
عضوات المجلِس النّجمات

10
00:00:34,640 --> 00:00:40,250
شكراً جزيلاً على كلّ ما فعلته لأجلي يا سيّد تونومورا

11
00:00:44,060 --> 00:00:47,940
إليك هديّةٌ متواضِعة تصفِّي فيها ذهنك من عبء العمل

12
00:00:52,190 --> 00:00:55,480
تبدو هذه حلويات لذيذة

13
00:00:55,480 --> 00:01:00,030
لكن يا إتشيغو-سان، أنتَ مجرمٌ حقيقيّ

14
00:01:00,030 --> 00:01:02,270
إطلاقاً

15
00:01:02,270 --> 00:01:04,960
أنا نكرة مُقارنة بك

16
00:01:15,200 --> 00:01:18,140
!سينسي

17
00:01:19,430 --> 00:01:21,890
وفاة عضو المجلس تونومورا على نحوٍ مُفاجئ

18
00:01:19,550 --> 00:01:21,890
مقعد شاغر في نيغاتا

19
00:01:28,280 --> 00:01:31,730
التصريح الرسميّ هو أنّه توفّي بنوبة قلبيّة

20
00:01:31,730 --> 00:01:35,690
لكن الحقيقة هي أنّه توفّي نتيجة اختناقه أثناء تناول الطعام

21
00:01:36,100 --> 00:01:37,840
يا إلهي

22
00:01:37,840 --> 00:01:41,600
لطالما كان ذلك الرّجل مهووساً بتذوُّق الأطعمة

23
00:01:41,600 --> 00:01:44,700
...بالمناسبة، بخصوصِ المُرشَّحين للمقعدِ الشاغر

24
00:01:45,320 --> 00:01:47,710
أنا آسف، ليس بعد

25
00:01:49,540 --> 00:01:54,020
حسناً يا سيّدتي، هل نتوجّه إلى طوكيو للبحث
عن مرشّحين للانتخابات؟

26
00:01:50,030 --> 00:02:09,270
!ناتسكي! ناتسكي

27
00:01:54,450 --> 00:01:56,890
كانت نيغاتا في حالةِ فوضى اليوم

28
00:01:56,890 --> 00:01:59,920
أعلم أنّنا نبحثُ عن فتاةٍ مشهورة محلّياً

29
00:01:59,920 --> 00:02:02,640
لكن لا أدري من أين يمكننا حتّى أن نبدأ بالبحث

30
00:02:04,120 --> 00:02:07,000
كاميشيرو-سان، أوقف السيّارة

31
00:02:14,570 --> 00:02:19,320
!ناتسكي! ناتسكي

32
00:02:15,640 --> 00:02:16,890
ما الأمر؟

33
00:02:16,890 --> 00:02:19,320
الوقتُ يُداهمنا

34
00:02:25,220 --> 00:02:27,350
سيّدتي، هل تسمعينني؟

35
00:02:29,000 --> 00:02:35,090
يا ناس، لنزرع الحقول مجدّداً! لذا غنّوا معي

36
00:02:36,160 --> 00:02:39,640
!لنزرع هذا الأرزّ

37
00:02:42,940 --> 00:02:44,230
مدهش

38
00:02:46,080 --> 00:02:48,600
حظينا بزراعةٍ جيّدةٍ أخرى هذا العام

39
00:02:48,600 --> 00:02:49,560
بالفعل

40
00:02:54,550 --> 00:02:58,430
كرات أرزّكِ هي الأطيب يا جدّتي

41
00:02:58,430 --> 00:03:01,830
لا تأكلي بسرعة وإلّا اختنقتِ

42
00:03:02,760 --> 00:03:06,870
كم تحبِّين الغناء مع النّاس

43
00:03:07,230 --> 00:03:11,120
وبهذا تكون قد زُرِعَتْ كافّة الحقول وقضينا وقتاً ممتعاً

44
00:03:11,120 --> 00:03:13,120
ناتسكي-تشان

45
00:03:13,120 --> 00:03:15,260
شكراً على أغنيةِ زرع البذور

46
00:03:15,260 --> 00:03:18,170
نعتمدُ على عودتكِ إلينا يا نجمة قريتنا

47
00:03:18,170 --> 00:03:20,430
مهلاً، أنا لستُ نجمة

48
00:03:20,430 --> 00:03:24,090
غناؤكِ يرسمُ البسمة في شفاهِ النّاس

49
00:03:24,710 --> 00:03:26,960
لطالما أحببتِ الغناء

50
00:03:26,960 --> 00:03:30,180
ولطالما أسعدتِ النّاس بالغناء

51
00:03:31,310 --> 00:03:34,010
لقد نضجتِ جيّداً

52
00:03:34,010 --> 00:03:36,000
مرحى، تلقّيتُ مديحاً

53
00:03:36,000 --> 00:03:38,040
أحبُّكِ يا جدّتي

54
00:03:38,440 --> 00:03:39,740
مرحباً

55
00:03:41,090 --> 00:03:44,620
هل ترغبين في الغناءِ للبلد بأكمله؟

56
00:03:45,240 --> 00:03:47,700
أنا؟ عضوة مجلِس نجمة؟

57
00:03:48,030 --> 00:03:48,680
أجل

58
00:03:48,680 --> 00:03:52,280
هل تودِّين التقدُّم لتجربةِ الأداء المقبلة؟

59
00:03:51,660 --> 00:03:53,960
حزب البطلات
تجربة أداء نجمات نيغاتا بالانتخاب في طوكيو

60
00:03:54,320 --> 00:03:55,290
!سأفعلها

61
00:03:55,290 --> 00:03:56,750
—أتمنّى أن

62
00:03:56,750 --> 00:03:58,560
جدّتي، ماء

63
00:03:58,560 --> 00:04:00,520
قلتُ لكِ ذلك

64
00:04:01,480 --> 00:04:03,320
أنا آسفة جدّاً

65
00:04:03,320 --> 00:04:04,120
لا عليكِ

66
00:04:04,120 --> 00:04:05,760
إنّها مُفعمةٌ بالحيويّة

67
00:04:07,700 --> 00:04:10,470
أنا؟ نجمة؟

68
00:05:41,570 --> 00:05:44,430
نُعلِن هاهنا عن بدء حزب البطلات

69
00:05:44,430 --> 00:05:49,110
تجارب أداء المرشّحين بالانتخاب في الحيّ الأوّل من نيغاتا

70
00:05:49,110 --> 00:05:53,370
شكراً لاجتماعكن هنا اليوم في كلّ أنحاء البلاد

71
00:05:53,680 --> 00:05:56,790
ستُقامُ تجارب الأداء هنا

72
00:06:05,030 --> 00:06:05,770
هذا مستحيل

73
00:06:05,770 --> 00:06:06,880
هل أنتم جادُّون؟

74
00:06:06,880 --> 00:06:08,460
ما سبب وجود تلّة؟

75
00:06:08,460 --> 00:06:10,970
القمّة تبلغ عنان السّماء

76
00:06:11,460 --> 00:06:16,490
تُعرَف هذه التلّة بتلّة النجمات، وتقولُ الأسطورة
أنَّ من يتسلّقها

77
00:06:16,490 --> 00:06:18,350
فإنّه يبلغُ قمّة اللّعبة

78
00:06:18,720 --> 00:06:22,730
أوّل فتاة تبلغُ القمّة ستتأهّل

79
00:06:22,730 --> 00:06:25,280
أظهِرنَ لنا عزيمتكن

80
00:06:26,040 --> 00:06:29,120
"حسناً، "استعداد، انطلاق

81
00:06:29,120 --> 00:06:31,410
هي إشارة البدء...

82
00:06:38,780 --> 00:06:42,080
تماسكن جميعاً

83
00:06:42,370 --> 00:06:46,030
سينسي، أنا حقّاً لا أعلم بشأنِ تجربة الأداء هذه

84
00:06:46,050 --> 00:06:50,060
لكن أساس النجمة هو جسدها

85
00:06:50,060 --> 00:06:52,340
هذه هي عقبتهن الأولى

86
00:06:52,340 --> 00:06:53,470
حرفيّاً

87
00:06:54,020 --> 00:06:55,320
هذا شاقّ

88
00:06:55,320 --> 00:06:58,440
أعتقدُ أنّ النجوميّة عمل صعب

89
00:06:59,800 --> 00:07:00,880
انتهيت

90
00:07:00,880 --> 00:07:02,230
وأنا أيضاً

91
00:07:03,280 --> 00:07:06,150
لم أكن أعلم بوجودِ مثل هذه التلّة شديدة الانحدار في طوكيو

92
00:07:18,370 --> 00:07:20,140
لا يجوز أن أستسلم

93
00:07:20,140 --> 00:07:23,920
سوف أصبح نجمة

94
00:07:25,040 --> 00:07:26,200
سأصبح كذلك

95
00:07:28,980 --> 00:07:31,580
!ها أنا ذي

96
00:07:34,230 --> 00:07:35,480
!فعلتُها! فعلتُها! فعلتُها! فعلتُها

97
00:07:35,480 --> 00:07:36,970
!فعلتُها

98
00:07:38,480 --> 00:07:40,540
!جدّتي، فعلتُها

99
00:07:40,540 --> 00:07:41,390
ناتسكي

100
00:07:41,390 --> 00:07:42,400
ما الأمر؟

101
00:07:42,400 --> 00:07:43,480
ما الذي يجري؟

102
00:07:44,120 --> 00:07:46,950
!أصبحتُ عضوة مجلِس نجمة

103
00:07:49,030 --> 00:07:51,560
هل أنتِ متأكّدة من اختيارِ تلك الفتاة؟

104
00:07:51,990 --> 00:07:56,030
هي الوحيدة التي بلغَتْ أعلى التلّة

105
00:07:56,330 --> 00:07:58,360
وهل هذا يجعلها مؤهَّلة؟

106
00:07:58,360 --> 00:07:59,580
...تلك الفتاة

107
00:08:00,040 --> 00:08:01,140
!ماذا؟

108
00:08:01,140 --> 00:08:03,830
!ليس لدى اليابان رئيس؟

109
00:08:04,080 --> 00:08:06,080
نحن لا نؤدِّي هنا فكاهةً هزليّة

110
00:08:06,600 --> 00:08:08,830
ارتكبتُ خطأ

111
00:08:08,830 --> 00:08:11,210
هلّا اتّخذتِ هذا الأمر على محمل الجدّ؟

112
00:08:11,210 --> 00:08:14,720
إذا استمررتَ في القلقِ من كلّ شيء، ستصبح أصلعاً

113
00:08:15,410 --> 00:08:16,720
لا مُشكلة

114
00:08:16,720 --> 00:08:18,640
سنتبيّن من ذلك

115
00:08:18,640 --> 00:08:22,980
هوشينا ناتسكي
حشد الجميع معاً

116
00:08:19,510 --> 00:08:22,980
مرحباً أيُّها المورّ— أيُّها المارّة

117
00:08:22,980 --> 00:08:28,150
هوشينا ناتسكي

118
00:08:23,440 --> 00:08:26,140
—اسمي هوشينا ناتسكي وسأعمل لأجل

119
00:08:26,140 --> 00:08:30,310
سأعمل لصالحِ مكتبٍ منضوٍ تحت حِسب البطلات

120
00:08:31,880 --> 00:08:34,270
إنّها متشنِّجة جدّاً

121
00:08:34,270 --> 00:08:37,050
قلتُ لكِ أنّ هذا كثيرٌ عليها

122
00:08:37,050 --> 00:08:40,160
يكفيها نقداً أنَّها عضوة مجلِس نجمة

123
00:08:40,440 --> 00:08:42,720
عضوة مجلِس نجمة في عصرنا هذا؟ تبّاً

124
00:08:42,720 --> 00:08:43,880
...المعذرة

125
00:08:43,880 --> 00:08:47,290
يا آنسة، هل ستقدّمين شيئاً جيّداً لنا
إن ربحتِ؟

126
00:08:47,290 --> 00:08:48,470
...الـ-المعذرة

127
00:08:48,470 --> 00:08:50,120
سأفعلُ ما بوشعي

128
00:08:50,120 --> 00:08:53,080
أحسنتنّ صنعاً يا عضوات حزب البطلات

129
00:08:53,080 --> 00:08:54,220
يا إلهي

130
00:08:54,220 --> 00:08:55,680
في الوقتِ المناسب

131
00:08:55,680 --> 00:09:02,560
سوغيميا
حزب روغاي
عدالة
ممثِّلكم في الحكومة

132
00:08:56,010 --> 00:08:57,450
تتطلّب السياسة القوّة

133
00:08:57,450 --> 00:08:58,600
تتطلّب القدرة

134
00:08:58,600 --> 00:09:02,560
يجبُ ألّا تسمحوا لعروضٍ مُنمَّقة أن تخدعكم

135
00:09:02,940 --> 00:09:06,300
من فضلِكم صوّتوا لصالح حزب روغاي

136
00:09:06,300 --> 00:09:09,060
اجعلوني أنا، ساغيميا، رجلاً قيّماً

137
00:09:14,150 --> 00:09:15,380
...المعذرة

138
00:09:15,380 --> 00:09:18,890
اصنعوا امرأة منّي أيضاً من فضلكم

139
00:09:20,310 --> 00:09:22,640
لا يُسمَح للنجماتِ أن يكوِّنَّ علاقات

140
00:09:21,240 --> 00:09:22,640
!هذا ليس ما قصدت

141
00:09:22,640 --> 00:09:25,500
قلتُ لها أن تصون لسانها

142
00:09:23,460 --> 00:09:24,520
—كنتُ فقط

143
00:09:25,270 --> 00:09:26,510
!لم أقصد ذلك

144
00:09:25,500 --> 00:09:28,210
تفوّهَتْ للتو بكلامٍ سيّئ جدّاً نتيجة هلعها

145
00:09:29,040 --> 00:09:30,650
بالفعل

146
00:09:30,650 --> 00:09:32,570
ماذا سنفعل، سينسي؟

147
00:09:32,570 --> 00:09:34,920
ينبغي أن تأتي إلى هنا في أي لحظةٍ الآن

148
00:09:40,980 --> 00:09:41,900
أتيت

149
00:09:41,900 --> 00:09:45,760
ظننتُ نفسي سأصبح أحفورة ريثما تأتين

150
00:09:45,760 --> 00:09:48,380
جعلتِني أخال أنّكِ رفضتِ دعوتي

151
00:09:48,380 --> 00:09:55,610
كيف أرفض دعوة من المرأة التي قادت حزب البطلات؟

152
00:09:59,960 --> 00:10:01,020
تلك الفتاة؟

153
00:10:01,020 --> 00:10:03,330
أجل، واعدة جدّاً، أليس كذلك؟

154
00:10:03,970 --> 00:10:09,830
ساتشي، أواجه أحياناً وقتاً عصيباً في فهمكِ

155
00:10:10,080 --> 00:10:11,260
أونيمارو-سان؟

156
00:10:11,260 --> 00:10:13,260
الأونيمارو شيزوكا-سان؟

157
00:10:13,260 --> 00:10:14,590
انتُخِبَت مرّتين

158
00:10:14,590 --> 00:10:17,590
يمكنكِ القول أنّها سينباي بالنسبةِ إليكِ يا ناتسكي-تشان

159
00:10:17,880 --> 00:10:19,370
اسمي هوشينا ناتسكي

160
00:10:20,290 --> 00:10:23,350
أنا معجبةٌ بكِ منذ فترة طويلة

161
00:10:23,630 --> 00:10:24,860
فترة طويلة"؟"

162
00:10:24,860 --> 00:10:26,990
تتكلّمين كما لو أنّني أكبر منكِ

163
00:10:26,990 --> 00:10:28,880
أنا في مثل سنّكِ

164
00:10:28,880 --> 00:10:29,780
!حقاً؟

165
00:10:29,780 --> 00:10:33,660
حسناً يا ساتشي، ماذا تريدين أن تفعلي؟

166
00:10:34,720 --> 00:10:35,980
...في الحقيقة

167
00:10:36,250 --> 00:10:38,380
من فضلك وشكراً لك

168
00:10:39,400 --> 00:10:44,370
أونيمارو شيزوكا مع هوشينا ناتسكي

169
00:10:39,460 --> 00:10:41,510
ما الذي يجري؟

170
00:10:42,050 --> 00:10:44,370
لن تطلبي منّي أن أغنِّي، أليس كذلك؟

171
00:10:44,370 --> 00:10:46,750
إنّه طلب يُطلَب مرّة في العمر

172
00:10:46,750 --> 00:10:47,520
أرجوكِ

173
00:10:47,520 --> 00:10:49,320
هذا ما قلتِه في المرّة السّابِقة

174
00:10:49,320 --> 00:10:50,480
أرجوكِ

175
00:10:50,480 --> 00:10:52,880
لهذا استدعيتُكِ أصلاً

176
00:10:52,880 --> 00:10:54,680
ماذا تقصدين بـ"أصلاً"؟

177
00:10:54,680 --> 00:10:56,230
كفاكِ مزاحاً

178
00:10:57,720 --> 00:11:00,010
أتستسلمين منذ الآن؟

179
00:11:00,580 --> 00:11:01,510
ماذا؟

180
00:11:01,800 --> 00:11:05,900
أظنُّكِ غير مؤهَّلة للعملِ مع جديدة

181
00:11:06,950 --> 00:11:10,040
!يا للأسف، يا للضياع

182
00:11:10,040 --> 00:11:11,500
فتاة جيّدة كهذه

183
00:11:12,280 --> 00:11:14,700
إنّها كذلك بالفعل

184
00:11:15,930 --> 00:11:17,320
حسناً، لا مانع

185
00:11:17,320 --> 00:11:19,070
أنا موافقة. أرضيتِ؟

186
00:11:19,070 --> 00:11:23,450
لكن سأتصرّفُ على طريقتي أنا

187
00:11:25,810 --> 00:11:27,130
دروس؟

188
00:11:27,720 --> 00:11:31,630
بصراحة، أنتِ لا تستحقِّين الغناء معي حاليّاً

189
00:11:31,630 --> 00:11:35,900
إذا أردتِ أن تغنّي معي على نفس المسرح
عليكِ أن تثبتي ذلك بجهودكِ

190
00:11:35,900 --> 00:11:37,210
حسناً

191
00:11:37,630 --> 00:11:38,920
لن أتساهل معكِ

192
00:11:38,920 --> 00:11:41,720
،إن قرّرتُ أنَّكِ غير مؤهَّلة

193
00:11:41,720 --> 00:11:44,350
فسوف أفصلكِ دون تردُّد

194
00:11:44,350 --> 00:11:47,080
إن لم يكن هذا ما تريدينه فعليكِ بالالتزام
معي بكلِّ ما أوتيتِ من قوّة

195
00:11:47,080 --> 00:11:47,850
مفهوم؟

196
00:11:47,850 --> 00:11:50,080
!درِّبيني تدريباً شاقّاً

197
00:11:50,080 --> 00:11:53,150
سأتدرّبُ إلى أن أكحَّ دماً وأتحوَّل إلى زومبي

198
00:11:53,570 --> 00:11:55,860
أ-أنتِ متفائلة على نحوٍ غريب

199
00:11:57,440 --> 00:11:59,320
ها أنتِ ذي قد خرجتِ عن الإيقاع

200
00:11:59,320 --> 00:11:59,930
ثانية

201
00:11:59,930 --> 00:12:00,440
حسناً

202
00:12:01,090 --> 00:12:02,440
...مؤلم

203
00:12:02,440 --> 00:12:03,480
أنا أموت

204
00:12:03,480 --> 00:12:04,240
ليس بعد

205
00:12:04,870 --> 00:12:06,240
لن أستسلم

206
00:12:06,510 --> 00:12:08,870
...يمين، يسار، يمين، يسار

207
00:12:11,010 --> 00:12:12,210
هل أنتِ بخير؟

208
00:12:12,600 --> 00:12:15,210
أجل، هذا غير مؤلم البتّة

209
00:12:16,160 --> 00:12:17,710
لن أستسلم

210
00:12:20,550 --> 00:12:22,830
لا يجوز أن تصرخي فحسب

211
00:12:22,830 --> 00:12:23,850
مجدّداً

212
00:12:23,850 --> 00:12:24,890
شكراً لكِ

213
00:12:26,120 --> 00:12:27,800
فهمتُها

214
00:12:30,400 --> 00:12:32,980
بذلَتْ ناتسكي-تشان مجهوداً كبيراً

215
00:12:32,980 --> 00:12:34,980
إنّها مثابرة جدّاً

216
00:12:35,280 --> 00:12:36,980
قلتُ لك ذلك

217
00:12:38,850 --> 00:12:41,030
هل ما زلتِ قلقة بشأن ما حدث؟

218
00:12:43,110 --> 00:12:44,240
هذا يكفي

219
00:12:46,300 --> 00:12:48,260
تنتهي دروسكِ اليوم

220
00:12:48,950 --> 00:12:49,870
...إذاً

221
00:12:49,870 --> 00:12:52,580
ليس لديكِ المقوِّمات التي تؤهّلكِ للوقوف
في نفس المسرح معي

222
00:12:53,610 --> 00:12:55,330
كان ذلك مضيعة للوقت

223
00:13:03,110 --> 00:13:04,520
ناتسكي

224
00:13:08,150 --> 00:13:09,500
رأيتُ المنشورات

225
00:13:09,500 --> 00:13:12,100
أعدكِ أنّني سأحضر الفعاليّة لتشجيعكِ

226
00:13:12,100 --> 00:13:16,270
لا أصدِّقُ أنّكِ ستكونين هناك مع الأونيمارو شيزوكا-سان

227
00:13:16,740 --> 00:13:20,480
كنتُ مشغولاً جدّاً في المزرعة لهذا لم أستطع
رؤيتكِ في التمرينِ اليوم

228
00:13:20,480 --> 00:13:24,100
لكن سأحضرُ هناك في الفعاليّة لأجلكِ
مع جميع أهل القرية

229
00:13:27,620 --> 00:13:29,580
ناتسكي

230
00:13:35,640 --> 00:13:37,000
ماذا دهاكِ؟

231
00:13:47,320 --> 00:13:49,680
أتطردينني من الفريق؟

232
00:13:49,680 --> 00:13:50,840
لماذا؟

233
00:13:50,840 --> 00:13:51,930
أليس هذا واضحاً؟

234
00:13:52,260 --> 00:13:54,680
أدّيتُ أداءً ممتازاً

235
00:13:55,190 --> 00:13:59,120
غناؤكِ مبهرٌ بالفعل يا شيزوكا

236
00:13:59,120 --> 00:14:01,570
أنتِ موهوبةٌ بشكل استثنائيّ

237
00:14:02,230 --> 00:14:05,070
...لكن هالتكِ

238
00:14:08,240 --> 00:14:12,740
هالتكِ قد أذَتْ أناساً كثُر

239
00:14:13,140 --> 00:14:17,500
هالتكِ هي سيفٌ ذو حدَّين لا يتوافق مع الآخرين

240
00:14:29,330 --> 00:14:31,480
سيف ذو حدَّين

241
00:14:36,580 --> 00:14:37,700
...هل أنا

242
00:14:38,230 --> 00:14:40,410
!المعذرة

243
00:14:40,800 --> 00:14:42,330
نعم؟

244
00:14:43,400 --> 00:14:44,720
هكذا إذاً

245
00:14:44,720 --> 00:14:46,740
أتيتِ إلى هنا للاطمئنانِ عليها فقط

246
00:14:47,020 --> 00:14:48,740
لذا كيفَ حالُ ناتسكي-تشان؟

247
00:14:48,740 --> 00:14:51,520
لا تضغطي على نفسكِ يا ناتسكي-تشان

248
00:14:51,520 --> 00:14:54,650
عليكِ أن تنالي قسطاً من الرّاحة
وإلّا أذيتِ نفسكِ

249
00:14:54,650 --> 00:14:55,580
أنا بخير

250
00:14:55,580 --> 00:14:58,840
أستطيعُ المُتابعة

251
00:14:58,840 --> 00:15:01,330
أشعر بالفشل

252
00:15:01,330 --> 00:15:03,250
لا يمكنني أن أسامح نفسي

253
00:15:03,520 --> 00:15:06,250
كانَتْ تعملُ بجدٍّ لأجلي

254
00:15:06,250 --> 00:15:10,260
تصبّبَتْ عرقاً لساعات وأيّام لأجلي

255
00:15:11,930 --> 00:15:13,270
...و

256
00:15:14,580 --> 00:15:17,500
أضعتُ وقتها فحسب

257
00:15:21,160 --> 00:15:22,090
...لكن

258
00:15:23,260 --> 00:15:26,810
لا بدَّ أن أفعلها

259
00:15:30,840 --> 00:15:33,370
!سأصمُد

260
00:15:34,250 --> 00:15:35,420
أحسنتِ

261
00:15:35,420 --> 00:15:36,460
لا تستسلمي

262
00:15:36,460 --> 00:15:37,660
هلّا نظرت إلى ذلك؟

263
00:15:37,660 --> 00:15:40,070
أعتقدُ أنَّه لا يوجدُ ما يثير القلق

264
00:15:41,000 --> 00:15:42,290
محطّة نيغاتا
مخرج بانداي

265
00:15:45,330 --> 00:15:46,200
انتهيت

266
00:15:46,610 --> 00:15:48,840
قِفي هناك وقدِّمي ما لديكِ فحسب

267
00:15:49,810 --> 00:15:53,350
سأبذلُ قصارى جهدي

268
00:15:54,450 --> 00:15:56,070
حان الوقت

269
00:15:56,960 --> 00:15:59,180
لكن لستُ مستعدّة نفسيّاً بعد

270
00:15:59,180 --> 00:16:01,710
ناتسكي-تشان، ما هذا الذي هناك؟

271
00:16:06,200 --> 00:16:07,880
أين أونيمارو شيزوكا؟

272
00:16:08,680 --> 00:16:10,840
أليست أونيمارو شيزوكا هنا؟

273
00:16:13,480 --> 00:16:14,500
...المعذرة

274
00:16:14,500 --> 00:16:17,930
شكراً لقدومِكم اليوم

275
00:16:17,930 --> 00:16:21,850
...الطقس لطيفٌ اليوم، والسّماء مليئة بالنجوم

276
00:16:21,850 --> 00:16:23,600
هل هذا خطاب زفاف؟

277
00:16:23,600 --> 00:16:26,220
فقدَتْ صوابها كلّياً

278
00:16:26,220 --> 00:16:27,210
أجل

279
00:16:27,210 --> 00:16:29,020
لكنّها ستتركُ أثراً

280
00:16:29,020 --> 00:16:30,760
ماذا عن الانتخابات؟

281
00:16:30,760 --> 00:16:33,020
سنخسرُ بلا شكّ إذاً بهذه الرّياح العكسيّة

282
00:16:33,020 --> 00:16:35,140
دعنا نحظى ببعض الرّياح إذاً

283
00:16:36,040 --> 00:16:37,300
برياحٍ إلهيّة

284
00:16:37,890 --> 00:16:39,310
أونيمارو-سان

285
00:16:39,650 --> 00:16:42,310
بدأ عرض ناتسكي-تشان

286
00:16:45,200 --> 00:16:47,580
لكن غريب

287
00:16:47,580 --> 00:16:50,320
لم أرَ شيزوكا تعاني من ألمٍ عضليّ

288
00:16:50,710 --> 00:16:53,420
لا أصدِّقُ أنّكِ، يا من تدرّبتِ تدريباً شاقّاً

289
00:16:53,420 --> 00:16:56,510
لدرجة أنّكِ أصبحتِ ترقصين في المسرح
،لساعاتٍ متواصِلات

290
00:16:56,510 --> 00:16:59,830
ستحتاجين لكمّادات بعد إلقاء دروس لناتسكي-تشان

291
00:17:03,210 --> 00:17:06,170
بما أنّكِ وصلتِ إلى هنا لعلّكِ تغنّين معها كذلك

292
00:17:08,760 --> 00:17:09,750
...أنا

293
00:17:10,020 --> 00:17:12,260
أما زلتِ قلِقة بشأن ما حدث؟

294
00:17:13,840 --> 00:17:16,220
هالتكِ أذَتْ أناساً كثُر

295
00:17:16,630 --> 00:17:21,350
هالتكِ هي سيفٌ ذو حدَّين لا يتوافق مع الآخرين

296
00:17:24,340 --> 00:17:26,270
لا تخافي، غنِّي فحسب

297
00:17:29,750 --> 00:17:32,280
ستكونُ الأمور على ما يُرام

298
00:17:32,540 --> 00:17:36,030
هالة ناتسكي-تشان ليسَتْ ضعيفة إلى ذلك الحدّ

299
00:17:38,620 --> 00:17:42,760
...يداً بيد

300
00:17:41,760 --> 00:17:43,080
ما هذا؟

301
00:17:43,080 --> 00:17:44,160
تبّاً

302
00:17:44,160 --> 00:17:45,290
هيّا بنا

303
00:17:45,290 --> 00:17:47,200
ما خطبكِ يا ناتسكي؟

304
00:17:47,200 --> 00:17:49,790
أين اختفَتْ طاقتكِ المعتادة؟

305
00:17:51,890 --> 00:17:53,920
!مرحباً يا نيغاتا

306
00:17:53,920 --> 00:17:55,800
!مساء الخير

307
00:17:58,560 --> 00:18:00,050
إنّها أونيمارو شيزوكا

308
00:18:00,870 --> 00:18:01,900
ماذا تفعلين؟

309
00:18:01,900 --> 00:18:02,680
غنِّي

310
00:18:03,010 --> 00:18:04,180
شيزوكا-سان

311
00:18:04,180 --> 00:18:06,000
إنّها أونيمارو شيزوكا

312
00:18:06,000 --> 00:18:07,020
!أريدُ رؤيتها

313
00:18:07,920 --> 00:18:11,520
وحده حزب روغاي هو القادر على إنقاذ
مبادئكم في الحياة

314
00:18:11,520 --> 00:18:15,690
ساغيميا
حزب روغاي
عدالة
!ممثّلكم في الحكومة

315
00:18:12,480 --> 00:18:15,690
صوّتوا لرئيس حزب روغاي، ساغيميا، من فضلكم

316
00:18:15,690 --> 00:18:17,160
حزب البطلات؟

317
00:18:17,160 --> 00:18:20,950
ما الفائدة المرجوّة من عضوة مجلِس نجمة
وهي لا تستطيع أن تمارس سوى الغناء والرّقص؟

318
00:18:21,280 --> 00:18:22,990
السّياسة تتطلّب القوّة

319
00:18:22,990 --> 00:18:24,120
تتطلّب الثبات

320
00:18:24,120 --> 00:18:25,800
لا تنخدعوا

321
00:18:25,800 --> 00:18:29,580
صوّتوا لساغيميا من فضلكم

322
00:18:29,840 --> 00:18:32,090
،صوِّتوا لي

323
00:18:32,090 --> 00:18:38,320
وأعدكم بحياةٍ مستقرّة ومزدهرة للجميع

324
00:18:38,320 --> 00:18:42,720
هل حكومتكم بحاجةٍ للغناءِ والرقص حقّاً؟

325
00:18:42,720 --> 00:18:43,280
!كلّا

326
00:18:43,280 --> 00:18:44,920
!على الإطلاق

327
00:18:44,920 --> 00:18:46,940
...ما هو مطلوب فعلاً

328
00:18:51,100 --> 00:18:55,070
ضع يدك بيدي

329
00:18:55,070 --> 00:18:58,110
وانطلق نحو المستقبل

330
00:18:57,760 --> 00:18:59,740
ما هذه الهالة؟

331
00:18:58,510 --> 00:19:08,120
ثِق بما هو مُمكِن، حينئذ نستطيع الوصول إلى أي مكان

332
00:19:08,120 --> 00:19:11,620
لنبدأ بالحلم

333
00:19:20,340 --> 00:19:25,310
أشعر أنَّ قلبي بدأ بالنبض

334
00:19:25,310 --> 00:19:28,200
انظر إلى اخلاصي الشغوف

335
00:19:28,200 --> 00:19:30,670
إلى عواطفي المتأجِّجة

336
00:19:31,310 --> 00:19:36,380
وإلى مشاعري الصّادقة

337
00:19:33,960 --> 00:19:35,230
!ناتسكي-تان

338
00:19:36,380 --> 00:19:42,110
أريدُ مُشاركة المزيد من البسمات والإثارة

339
00:19:42,110 --> 00:19:44,360
آمِن بقوّتِك الخاصّة

340
00:19:43,480 --> 00:19:44,870
لديها هالةٌ جميلة

341
00:19:44,360 --> 00:19:47,840
ودع الجميع يسمعون

342
00:19:47,840 --> 00:19:53,850
...أريد العالم بأسرِه أن يسمع

343
00:19:51,940 --> 00:19:55,020
!لنبدأ! احلم معي

344
00:19:53,850 --> 00:19:56,920
الغد سيتغيّر

345
00:19:56,920 --> 00:19:59,170
سوف نغيّره

346
00:19:59,170 --> 00:20:04,780
سنغنِّي بأمل راسِخ

347
00:20:04,780 --> 00:20:10,220
ضع يدك بيدي ولننطلق نحو المستقبل

348
00:20:10,220 --> 00:20:17,900
لنعد بعضنا أن نرى مستقبلاً مشرقاً معاً

349
00:20:33,010 --> 00:20:37,070
يا ناس، أعدكم أنّني سأرسم البسمة في شفاهكم جميعاً

350
00:20:37,720 --> 00:20:41,690
من فضلِكم صوِّتوا لي أنا، هوشينو ناتسكي

351
00:20:41,690 --> 00:20:43,010
اتّفقنا؟

352
00:20:43,010 --> 00:20:45,050
!اتّفقنا

353
00:20:46,610 --> 00:20:47,850
تفضّلي

354
00:20:48,290 --> 00:20:49,880
سأغادر

355
00:20:49,880 --> 00:20:50,760
ناتسكي

356
00:20:52,550 --> 00:20:53,710
اصمدي

357
00:20:53,710 --> 00:20:54,480
لا تستسلمي

358
00:20:58,000 --> 00:21:00,620
أصبحتِ الآن عضوة مجلس بشكلٍ رسميّ

359
00:21:00,620 --> 00:21:03,230
حظّاً سعيداً يا هوشينو-سينسي

360
00:21:03,230 --> 00:21:05,760
لا تناديني بذلك رجاء

361
00:21:05,760 --> 00:21:06,760
لا تتصرّفي كالأطفال

362
00:21:06,760 --> 00:21:07,530
قفي منتصبة القامة

363
00:21:07,530 --> 00:21:08,160
حاضر

364
00:21:08,160 --> 00:21:09,550
حسناً، هيّا بنا

365
00:21:09,550 --> 00:21:10,300
حسناً

366
00:21:20,960 --> 00:21:23,310
ما هو شعوركِ بعدما حصلتِ على المنصب؟

367
00:21:24,010 --> 00:21:26,130
ماذا ترغبين أن تفعلي كعضوة مجلس نجمة؟

368
00:21:26,400 --> 00:21:28,730
...أنا، في البداية

369
00:21:28,730 --> 00:21:30,730
سأفعل ما بوشعي

370
00:21:31,140 --> 00:21:33,060
يا إلهي، تلعثمت مجدّداً

371
00:21:36,840 --> 00:21:40,820
نحن، حزب روغاي، ما زلنا نحظى بالأغلبيّة في المجلس

372
00:21:41,150 --> 00:21:46,240
لكن لا أعلم ما إن كان لصالحنا أن تكسب
عضوات المجلِس النّجمات الزخم

373
00:21:47,490 --> 00:21:48,760
لا تقلق

374
00:21:49,250 --> 00:21:51,490
سنضربهنّ بيدٍ من حديد عمّا قريب

375
00:23:30,010 --> 00:23:33,230
اسمي هوشينا ناتسكي، عضوة مجلِس من نيغاتا

376
00:23:30,010 --> 00:23:40,020
الرّسم: تيف

377
00:23:33,230 --> 00:23:34,490
سأؤدّي عروضاً حيّة

378
00:23:34,490 --> 00:23:36,830
سأحصل على طلباتٍ مُسبَقة لأقراص مضغوطة أيضاً

379
00:23:36,830 --> 00:23:38,540
...في الحلقةِ المقبلة أيضاً، سأفعل ما بوشعي