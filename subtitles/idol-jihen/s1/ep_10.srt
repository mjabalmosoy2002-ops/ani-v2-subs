عليّ أن أعمل بجدّ

52
00:05:30,500 --> 00:05:32,200
مرحباً بالجميع

53
00:05:32,200 --> 00:05:34,700
إنّها معركة القرن الهائلة

54
00:05:34,700 --> 00:05:39,280
الكرزات السّبع وسمايل كيس ستتواجهان في عرض مباشر

55
00:05:39,280 --> 00:05:43,210
هل الكرزات السّبع وسمايل كيس نجمات حقيقيّات؟

56
00:05:43,210 --> 00:05:45,080
أصواتكم هي التي تحدّد نتيجة المنافسة

57
00:05:44,010 --> 00:05:45,130
من تشجّعون؟

58
00:05:45,080 --> 00:05:46,710
!تابعوا من فضلكم

59
00:05:45,130 --> 00:05:46,410
الكرزات السّبع بالطبع

60
00:05:46,410 --> 00:05:47,820
سمايل كيس بلا شكّ

61
00:05:47,820 --> 00:06:12,600
سمايل كيس
!على الهواء

62
00:05:48,170 --> 00:05:52,190
أنا مُعجبة بالكرزات السّبع بصفتهن سينباي بالنسبة لنا

63
00:05:52,190 --> 00:05:55,520
لكن أرى أنّنا يجب أن نتفوّق عليهن

64
00:05:55,520 --> 00:05:58,160
هل تخفين شيئاً في جعبتكن؟

65
00:05:58,160 --> 00:05:59,260
جعبتنا؟

66
00:05:59,260 --> 00:06:00,580
بالطبع

67
00:06:01,040 --> 00:06:05,300
أداؤنا الفريد من نوعه وابتساماتنا

68
00:06:05,960 --> 00:06:07,940
نصرنا مضمون

69
00:06:07,940 --> 00:06:12,220
سنستجمع قوّة الظلام ونهزم الكرزات السّبع

70
00:06:18,600 --> 00:06:26,610
الكرزات السّبع
تاكازاكي & إيزوميزاوا
مباشر

71
00:06:18,960 --> 00:06:21,340
واجهننا يا سمايل كيس

72
00:06:21,340 --> 00:06:26,180
سنُريكن من هنّ النّجمات الأفضل

73
00:06:26,890 --> 00:06:28,640
!اهزمن الكرزات السّبع

74
00:06:28,640 --> 00:06:31,660
!انطلِقن يا سمايل كيس

75
00:06:38,870 --> 00:06:45,430
!لنرَ كلّ الابتسامات التي زوّدتُنّ الجماهير بها

76
00:06:47,630 --> 00:06:53,370
وهكذا أقترح مشروع قانون بحظر عضوات المجلس النّجمات

77
00:06:57,480 --> 00:07:00,060
!نعم لحظر عضوات المجلس النّجمات

78
00:07:00,060 --> 00:07:02,570
تبّاً لعضوات المجلس النّجمات

79
00:07:02,570 --> 00:07:04,380
!السّياسة ليست هزلاً

80
00:07:14,260 --> 00:07:20,790
سمايل كيس والكرزات السّبع هما أكثر الكلمات
التي يبحث عنها النّاس في محرّكات البحث في الأيّام القليلة الماضية

81
00:07:21,170 --> 00:07:26,340
بصراحة، لم أتوقّع أن تسير الأمور بهذه السّلاسة

82
00:07:27,720 --> 00:07:30,700
حسناً، كلّ ما نريده هو أن تسير بسلاسة معقولة

83
00:07:56,390 --> 00:07:59,120
لـ-لا أستطيع التحرّك

84
00:07:59,780 --> 00:08:01,750
لا أستطيع الكلام

85
00:08:03,520 --> 00:08:05,340
ناتسكي، ما الأمر؟

86
00:08:05,340 --> 00:08:06,880
الوقت يداهمنا

87
00:08:07,300 --> 00:08:09,100
...شيزوكا-سان، أنا

88
00:08:09,100 --> 00:08:10,800
لا أريد أن أسمع أعذارك

89
00:08:10,800 --> 00:08:14,130
علينا أن نهزم الكرزات السّبع

90
00:08:14,600 --> 00:08:17,850
نحن نضع مسيرة عضوات المجلس النّجمات على المحكّ

91
00:08:19,360 --> 00:08:20,810
يكفي لليوم

92
00:08:20,810 --> 00:08:21,900
غادري

93
00:08:22,930 --> 00:08:24,600
أنتِ تهدرين الوقت

94
00:08:45,540 --> 00:08:47,560
مرّة أخرى، من البداية

95
00:08:47,560 --> 00:08:49,260
حسناً

96
00:09:05,850 --> 00:09:12,030
في الخارج
كاماشيرو

97
00:09:09,700 --> 00:09:12,030
مكتب رئاسة حزب البطلات

98
00:09:12,030 --> 00:09:15,160
نزال مع الكرزات السّبع؟

99
00:09:15,160 --> 00:09:20,250
لِمَ لا تقضين ذلك الوقت وتنفقين المال لبناء الملعب
في نيغاتا بدلاً من ذلك؟

100
00:09:20,870 --> 00:09:23,720
أنفقنا أموالاً طائلة على مواد البناء

101
00:09:23,720 --> 00:09:26,220
وفي النّهاية نخسر نحن المُقاولون كلّ شيء؟

102
00:09:26,220 --> 00:09:27,260
ماذا بعد؟

103
00:09:27,260 --> 00:09:28,570
أريد أن أعيد أموالي

104
00:09:45,160 --> 00:09:46,640
ناتسكي-تشان

105
00:09:46,640 --> 00:09:49,540
تعملين بجدٍّ بمفردكِ كلّ يوم، صحيح؟

106
00:09:50,040 --> 00:09:51,830
لا تضغطي على نفسكِ

107
00:09:53,790 --> 00:09:56,830
لا داعي للقلق بشأن شيزوكا

108
00:09:56,830 --> 00:10:00,640
ساتشي-سان، لا أستطيع الرّقص

109
00:10:00,640 --> 00:10:01,960
لا أستطيع الغناء

110
00:10:02,980 --> 00:10:09,560
أعلم أنّ عليّ الغناء لأجل شيزوكا-سان
ولأجلِ الجميع

111
00:10:10,210 --> 00:10:12,040
لكن جسدي لا يتحرّك

112
00:10:15,540 --> 00:10:20,680
أصبحتُ عضوة مجلس نجمة كي أتمكّن
من رسم البسمة في وجوه النّاس

113
00:10:21,320 --> 00:10:23,440
لكن نيكونوشيما ومكبّ النّفايات

114
00:10:23,440 --> 00:10:26,140
...والحضانة والملعب في نياغاتا

115
00:10:26,980 --> 00:10:28,860
بات كلّ شيء أسوأ من السّابق

116
00:10:29,460 --> 00:10:31,440
هذه ليست غلطتكِ يا ناتسكي-تشان

117
00:10:31,440 --> 00:10:33,580
تقع المسؤوليّة على عاتقنا جميعاً

118
00:10:35,010 --> 00:10:37,580
لستُ مناسبة لأكون عضوة مجلس نجمة

119
00:10:38,290 --> 00:10:41,950
ما كان ينبغي أن أصبح نجمة

120
00:10:42,330 --> 00:10:43,830
هذا غير صحيح

121
00:10:43,830 --> 00:10:48,160
أنتِ أكثر عطفاً من أي شخص آخر

122
00:10:48,160 --> 00:10:52,330
هذا مهمٌّ جدّاً لعضوة مجلس نجمة

123
00:10:52,650 --> 00:10:58,470
أنا سعيدةٌ حقّاً لأنّني تمكّنتُ من العمل معكِ

124
00:11:01,220 --> 00:11:03,420
اذهبي وانظري لوجوه الجميع

125
00:11:05,300 --> 00:11:06,200
وجوههم؟

126
00:11:06,200 --> 00:11:06,970
أجل

127
00:11:07,230 --> 00:11:10,220
أنتِ قلقة على سكّان نيغاتا، أليس كذلك؟

128
00:11:10,960 --> 00:11:13,230
اذهبي وزوري الجميع

129
00:11:25,140 --> 00:11:26,240
لنبدأ

130
00:11:26,840 --> 00:11:28,630
لم تأتِ ناتسكي-تشان إلى هنا بعد

131
00:11:29,990 --> 00:11:31,870
لن تأتي ناتسكي-تشان إلى هنا

132
00:11:31,870 --> 00:11:34,320
أرسلتُها إلى نيغاتا

133
00:11:34,320 --> 00:11:35,550
نيغاتا؟

134
00:11:35,550 --> 00:11:36,620
لماذا؟

135
00:11:36,620 --> 00:11:39,000
متى ستعود؟

136
00:11:39,000 --> 00:11:39,880
لا أدري

137
00:11:42,150 --> 00:11:45,140
تشيناتسو، هل يمكنكِ أداء دور ناتسكي؟

138
00:11:47,360 --> 00:11:49,120
أراكِ لم تعلّقي على ذلك

139
00:11:49,120 --> 00:11:53,150
ألا تعني لكِ شيئاً؟

140
00:11:53,540 --> 00:11:57,700
تخلّيتِ عنها ببساطة كما فعلتِ معنا تماماً

141
00:11:59,680 --> 00:12:01,650
هذا يكفي

142
00:12:03,160 --> 00:12:05,670
لنتمرّن الآن

143
00:12:15,140 --> 00:12:16,190
ناتسكي؟

144
00:12:16,190 --> 00:12:17,420
لقد عُدت

145
00:12:51,440 --> 00:12:55,950
وقعنا جميعاً في مأزق بعد إيقاف مشروع الملعب

146
00:12:55,950 --> 00:13:00,310
كانت آمال الجميع كبيرة، لكن تثبّطت معنوياتنا الآن

147
00:13:02,020 --> 00:13:06,720
يجب أن ألتقي بهم

148
00:13:06,720 --> 00:13:07,640
ناتسكي

149
00:13:16,790 --> 00:13:19,190
لا بدّ أن أعتذر

150
00:13:20,790 --> 00:13:24,570
يجب أن أنظر في وجوههم وأعتذر

151
00:14:09,650 --> 00:14:11,530
جدّتي، هل رأيتِ ناتسكي؟

152
00:14:11,530 --> 00:14:12,990
لقد خرجَتْ

153
00:14:12,990 --> 00:14:14,570
إنّها سريعة جدّاً

154
00:14:14,570 --> 00:14:18,140
أليسَتْ قلقة بشأن النّزال في العرض المباشر اللّيلة؟

155
00:14:19,840 --> 00:14:21,340
مرحباً

156
00:14:29,590 --> 00:14:31,200
تأخّرتِ يا ناتسكي

157
00:14:31,200 --> 00:14:33,680
عمّال البناء كلّهم هنا

158
00:14:36,730 --> 00:14:39,710
أهلاً بعودتكِ

159
00:14:39,710 --> 00:14:43,950
صرتِ تأتين يومياً لهذا أتوا ليخبروكِ
أنّهم مسرورون بذلك

160
00:14:43,950 --> 00:14:47,280
وأرادوا الاعتذار عن الكلام السيّئ
الذي قالوه على الهاتف

161
00:14:47,280 --> 00:14:48,610
عندما كانوا ثمالى

162
00:14:48,610 --> 00:14:51,790
أنا آسف يا ناتسكي-تشان

163
00:14:51,790 --> 00:14:54,270
إنّه ثمل سيّئ

164
00:14:54,270 --> 00:14:56,560
لا تختلف عنه كثيراً

165
00:14:56,560 --> 00:14:58,490
لا، أنت أسوأ بكثير

166
00:14:58,490 --> 00:15:00,580
تكلّم عن نفسك

167
00:15:07,570 --> 00:15:09,130
اللّيلة ليلتنا

168
00:15:09,130 --> 00:15:13,880
لنقدّم كل ما لدينا أثناء التمرّن ونهزم الكرزات السّبع

169
00:15:14,310 --> 00:15:15,350
نعم

170
00:15:15,610 --> 00:15:20,790
وأيضاً شكراً للجميع على التعاون

171
00:15:31,600 --> 00:15:33,340
!لنهزم الكرزات السّبع

172
00:15:33,340 --> 00:15:34,870
!هيّا

173
00:15:42,920 --> 00:15:45,880
ناتسكي، هل تريدين كرة أرزّ أخرى؟

174
00:15:46,550 --> 00:15:47,670
لا

175
00:15:48,310 --> 00:15:49,110
حسناً

176
00:15:54,360 --> 00:15:57,530
ألن تقولي شيئاً يا جدّتي؟

177
00:15:59,970 --> 00:16:04,270
عليّ أن أقضي الوقت معكِ وآكل معكِ

178
00:16:04,270 --> 00:16:06,400
هذا يكفيني

179
00:16:07,280 --> 00:16:09,360
ليسَ لديّ ما أقوله

180
00:16:18,120 --> 00:16:24,500
لم أكن نافعة لفتاة أحبّها

181
00:16:27,740 --> 00:16:31,050
حاولتُ ما بوسعي كي أنال مديحها

182
00:16:31,970 --> 00:16:35,060
حاولتُ مراراً

183
00:16:36,040 --> 00:16:37,510
اسمي هوشينا ناتسكي

184
00:16:37,820 --> 00:16:40,730
أنا معجبة بكِ منذ زمن بعيد

185
00:16:41,710 --> 00:16:42,970
بعيد"؟"

186
00:16:42,970 --> 00:16:45,270
تتكلّمين وكأنّني أكبر منكِ

187
00:16:45,270 --> 00:16:47,400
أنا في مثل سنّكِ

188
00:16:47,760 --> 00:16:51,420
لكن كان ذلك بلا جدوى

189
00:16:51,420 --> 00:16:53,540
كان كلّ ما تلقّيته هو التوبيخ

190
00:16:56,920 --> 00:17:01,060
إنّها في الحقيقة شخصيّة لطيفة وحنونة

191
00:17:02,130 --> 00:17:04,280
لكنّها تتصرّف بقسوة فحسب

192
00:17:05,960 --> 00:17:08,460
ما دام هذا الثّنائي سيمثّل حزب البطلات

193
00:17:08,810 --> 00:17:11,120
لا يجوز أن نؤدّي أداء ناقصاً

194
00:17:12,220 --> 00:17:12,960
حاضرة

195
00:17:16,630 --> 00:17:19,860
أسّسنا فرقة

196
00:17:21,410 --> 00:17:24,740
وحاولتُ باستماتة أن أجاري مستواها

197
00:17:27,040 --> 00:17:27,980
...لكن في النهاية

198
00:17:37,420 --> 00:17:39,560
أردتُ أن أكون نافعة لها

199
00:17:41,960 --> 00:17:45,500
أردتُ أن أغنّي معها

200
00:17:46,280 --> 00:17:47,800
هذا كلّ شيء

201
00:17:48,980 --> 00:17:51,560
لا أكثر

202
00:17:54,000 --> 00:17:57,400
أردتُها أن تفهم

203
00:18:01,720 --> 00:18:03,400
لا تقلقي

204
00:18:03,400 --> 00:18:05,300
قلباكما متناغمان

205
00:18:05,990 --> 00:18:08,520
أنتِ تعلمين أكثر من أي شخص آخر

206
00:18:11,400 --> 00:18:15,460
أظنّكِ تستطيعين أن تؤمني مرّة أخرى

207
00:18:19,720 --> 00:18:21,500
يا إلهي

208
00:18:24,980 --> 00:18:27,710
ناتسكي، حدث رهيب

209
00:18:28,480 --> 00:18:31,290
سمايل كيس

210
00:19:14,250 --> 00:19:17,210
تبّاً، الكرزات السّبع ما زلن في الصّدارة

211
00:19:18,510 --> 00:19:20,380
تماسكي يا سمايل كيس

212
00:19:20,380 --> 00:19:22,890
تماسكي

213
00:19:25,260 --> 00:19:27,360
ناتسكي، كفّي عن البكاء

214
00:19:27,360 --> 00:19:29,020
!شجّعيهن

215
00:19:50,080 --> 00:19:54,210
والآن سنعلن نتائج الاستطلاع

216
00:19:59,480 --> 00:20:02,590
،من أصل 36.000.000 صوت

217
00:20:02,590 --> 00:20:05,800
تكسب الكرزات السّبع 16.500.000 صوتاً

218
00:20:06,260 --> 00:20:09,560
بينما تكسب سمايل كيس 19.500.000 صوتاً

219
00:20:09,560 --> 00:20:12,730
!سمايل كيس هي الرّابحة

220
00:20:18,980 --> 00:20:20,570
سنقيم لقاء صحفيّاً

221
00:20:20,570 --> 00:20:21,540
حسناً

222
00:20:25,010 --> 00:20:27,000
...عضوات المجلس النّجمات

223
00:20:27,000 --> 00:20:29,210
افرحن بنصركن قدر ما تستطعن

224
00:20:31,020 --> 00:20:32,840
بورِك عملكن

225
00:20:32,840 --> 00:20:34,400
بورك عملك

226
00:20:34,400 --> 00:20:36,130
شكراً جزيلاً لك

227
00:20:36,770 --> 00:20:41,370
يعقد رئيس الوزراء ساكورابا لقاء صحفيّاً
في المقرّ الرسميّ

228
00:20:47,320 --> 00:20:53,820
بعد مشاهدة أداء الكرزات السّبع ضدّ سمايل كيس
في البثّ المباشر في التلفزيون

229
00:20:54,370 --> 00:20:59,150
قرّرتُ أن أعقد لقاء صحفيّاً طارئاً

230
00:20:59,420 --> 00:21:04,720
كان أداء سمايل كيس، كأداء نجمات، رائعاً

231
00:21:04,720 --> 00:21:07,160
أعترف بذلك

232
00:21:07,160 --> 00:21:11,880
لكن يجب ألّا تنخدعوا بالأداء المُبهرَج

233
00:21:11,880 --> 00:21:15,850
مهما كان أدائهن رائعاً، يبقى مجرّد متعة عابرة

234
00:21:15,850 --> 00:21:17,610
إنّه ليس سوى وهماً

235
00:21:19,240 --> 00:21:22,280
لا يمكن للأداء أن يحلّ المشاكل

236
00:21:22,280 --> 00:21:26,420
ولا يثري حياة النّاس في الحياة الواقعيّة

237
00:21:27,810 --> 00:21:32,200
بل يمكن القول أنّ ذلك لا يخدم إلّا أنفسهن فقط

238
00:21:33,220 --> 00:21:37,400
في الواقع، لأنّ المغنّيات النّجمات كنَّ
منغمسات جدّاً في الأداء

239
00:21:37,910 --> 00:21:42,690
لم يحقّقن شيئاً كسياسيّات في الأسابيع
القليلة الماضية

240
00:21:45,240 --> 00:21:51,320
لذلك قرّرتُ أن أسألكم أيّها المواطنين
بطريقة الاستفتاء

241
00:21:51,320 --> 00:21:54,520
عن آرائكم حول مشروع قانون حظر عضوات
المجلس النّجمات

242
00:23:29,970 --> 00:23:32,640
أنا إيزوكا ساكوراكو، عضوة المجلس النّجمة نارا

243
00:23:30,010 --> 00:23:40,020
الرّسم: إيشي ماي

244
00:23:32,640 --> 00:23:34,720
سيصدر القرص المضغوط قريباً

245
00:23:34,720 --> 00:23:35,900
علينا أن نحتفل

246
00:23:35,900 --> 00:23:37,710
آمل ألّا تفوّتوا الحلقة المقبلة

247
00:23:37,710 --> 00:23:39,050
وعد؟