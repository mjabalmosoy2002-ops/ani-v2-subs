1
00:00:05,530 --> 00:00:07,640
وها هي تُمطر الآن

2
00:00:09,140 --> 00:00:12,270
لكن كيف لم يأتِ أي شخص من الجمهور؟

3
00:00:13,230 --> 00:00:15,920
أعلنّا عن ذلك عبر الإنترنت

4
00:00:18,120 --> 00:00:22,500
إعلان هامّ من حزب البطلات
"بإلغاء الحفل المُباشَر لـ"ويز
الحفل المُباشَر المُزعم عقده
"بواسطة المنتسبتين إلينا، ثنائي عضوتي المجلس النجمتين "ويز
.سيُلغى لأسباب إداريّة
.ولا مخطّطات حالياً لتأجيل أو إعادة تحديد موعد للحفل
.نعتذر من أعماق قلبنا من معجبينا الذين كانوا يتطلّعون قدماً للحفل
سنوافيكم قريباً بأي مستجدّات
...متعلّقة باسترداد أموالكم مستقبلاً

5
00:00:18,350 --> 00:00:20,920
ما الذي يجري؟

6
00:00:21,370 --> 00:00:22,500
خدعونا

7
00:00:22,700 --> 00:00:24,350
كيف خدعونا؟

8
00:00:24,350 --> 00:00:26,110
إنّه إعلاننا عبر الإنترنت

9
00:00:26,110 --> 00:00:27,630
ألغوه

10
00:00:28,300 --> 00:00:31,130
اخترقَ أحدهم إعلاننا وعدّله

11
00:00:31,700 --> 00:00:33,100
اختراق برمجي

12
00:00:33,530 --> 00:00:35,630
هذا وضع خطير جدّاً

13
00:00:36,420 --> 00:00:38,240
من يفعل شيئاً كهذا؟

14
00:00:47,250 --> 00:00:51,900
من المؤكّد أنّهن يرتعدن الآن، أليس كذلك يا رئيس الوزراء؟

15
00:00:52,560 --> 00:00:54,070
،وبهذا الطقس

16
00:00:54,690 --> 00:00:58,290
حتّى لو كُنَّ محظوظات بما يكفي بمجيء
عدد من النّاس إلى الحفل

17
00:00:58,290 --> 00:01:01,310
لن يكون الطقس ملائماً للقيامِ بالحفل

18
00:01:01,310 --> 00:01:03,920
إنّها مطر مُباركة بالفعل

19
00:01:05,420 --> 00:01:10,470
لن أدع أولئك الفتيات الدّنيئات فعل ما يشأن هذه المرّة

20
00:01:13,290 --> 00:01:15,830
سأقضي عليهنّ

21
00:01:18,540 --> 00:01:20,850
ماذا سنفعل الآن؟

22
00:01:20,850 --> 00:01:22,480
ماذا تعنين بـ"ماذا سنفعل"؟

23
00:01:22,480 --> 00:01:26,870
حتّى لو نشرنا إعلاناً آخر، لن يأتي أحدٌ
وسط هذه الأمطار

24
00:01:26,870 --> 00:01:27,790
انتظري

25
00:01:27,790 --> 00:01:28,850
هوشينا-سان

26
00:01:32,370 --> 00:01:33,760
الطقس بارد جدّاً

27
00:01:35,250 --> 00:01:37,990
لكنّه جميل

28
00:01:38,250 --> 00:01:39,190
أجل

29
00:01:39,190 --> 00:01:42,000
قد يكون الغناء تحت المطر لطيفاً أيضاً

30
00:01:42,620 --> 00:01:46,420
!انتظرا، لا يوجد أحدٌ هنا

31
00:01:46,420 --> 00:01:48,920
أما زلتُما ترغبان في القيامِ بالحفل؟

32
00:01:51,230 --> 00:01:52,750
بالتأكيد

33
00:01:57,310 --> 00:01:58,660
فنحن نجمتان

34
00:01:59,670 --> 00:02:01,800
سنغنّي لأجل الجميع

35
00:02:02,810 --> 00:02:04,000
كما سمعت

36
00:02:04,000 --> 00:02:05,920
لكنّها تمطر

37
00:02:05,920 --> 00:02:07,380
ماذا لو مرِضتا؟

38
00:02:07,380 --> 00:02:09,780
!لا، أصلاً لا يوجد جمهور

39
00:02:09,780 --> 00:02:14,150
إن لم يكن لدينا جمهور فكلّ ما علينا
هو أن نقيم حفلاً لجلبه إلينا

40
00:02:15,560 --> 00:02:18,080
لا تستهن بالمغنّيات النجمات

41
00:02:30,880 --> 00:02:32,590
ما هذا الصّوت؟

42
00:02:32,590 --> 00:02:34,270
لقد سبقَ وسمعتُه من قبل

43
00:02:35,100 --> 00:02:39,900
أليس هذه "ابدأ بالحلم" الخاصّة بـ"ويز"؟

44
00:02:39,900 --> 00:02:42,190
سمعتُ أنّهن سيُقمن حفلاً مباشراً اليوم

45
00:02:42,190 --> 00:02:44,100
لكن سمعتُ أنّه ألغي

46
00:02:44,550 --> 00:02:46,070
ما هذه الأغنية إذاً؟

47
00:02:46,070 --> 00:02:49,550
مصدر الأغنية من المنصّة في الهواء الطلق

48
00:02:49,550 --> 00:02:50,370
لنذهب

49
00:02:50,370 --> 00:02:51,380
لنتفقّدها

50
00:02:56,440 --> 00:02:57,870
معقول؟

51
00:02:57,870 --> 00:02:59,830
هذا جنون

52
00:02:59,830 --> 00:03:01,160
!أعجبني هذا

53
00:03:22,340 --> 00:03:25,850
ما الذي تفكّران فيه بالضبط؟

54
00:03:26,100 --> 00:03:28,900
ستقعان في ورطةٍ كبيرةٍ إن علمَ النّاس

55
00:03:28,900 --> 00:03:32,390
ستفقدان مؤهّلاتهما كعضوتي مجلس نجمتين

56
00:03:32,390 --> 00:03:36,740
ألم يفت الأوان قليلاً على القلق الآن؟

57
00:03:38,110 --> 00:03:40,070
بدأتا بالغناء أخيراً

58
00:03:43,120 --> 00:03:44,950
!أومي-تشان! أومي-تشان

59
00:03:44,950 --> 00:03:46,200
!موموي-سينسي

60
00:03:46,710 --> 00:03:47,990
كاتسوراياما-سينسي

61
00:03:48,570 --> 00:03:49,510
!أنباء هامّة

62
00:03:49,510 --> 00:03:50,120
!انظري

63
00:03:50,580 --> 00:03:52,420
!انظري إلى هذا

64
00:03:56,370 --> 00:03:57,950
وداعاً

65
00:03:58,770 --> 00:04:00,050
رائع

66
00:04:01,240 --> 00:04:03,140
إلامَ تنظرن؟

67
00:04:03,140 --> 00:04:05,790
هذا هاتفي

68
00:04:05,790 --> 00:04:07,810
تلك السيّدة تغنّي

69
00:04:10,130 --> 00:04:10,920
!عجباً

70
00:04:10,920 --> 00:04:11,560
مستحيل

71
00:04:11,560 --> 00:04:13,190
هذه مفاجأة حقيقيّة

72
00:04:13,930 --> 00:04:15,020
حسناً

73
00:04:15,020 --> 00:04:16,320
أعتمد عليك

74
00:04:16,910 --> 00:04:21,580
يبدو أنّ عضوات المجلس النّجمات الأخريات
بدأن بتحرّكاتهن كذلك

75
00:04:21,580 --> 00:04:22,730
وبعد؟

76
00:04:22,730 --> 00:04:24,060
لا تقلق

77
00:04:24,060 --> 00:04:25,820
لقد تصرّفت

78
00:04:33,640 --> 00:04:35,960
هُنّ لا يعلمن مع من يتعاملن

79
00:04:39,200 --> 00:04:42,730
لا يأتي عددٌ كبيرٌ من النّاس كما توقَّعنا

80
00:04:42,730 --> 00:04:47,720
ربّما كان هذا الحدث فاشلاً منذ البداية

81
00:04:48,650 --> 00:04:51,840
ناتسكي-تشان، شيزوكا، تماسكا

82
00:04:52,470 --> 00:04:55,600
لسنا وحدنا

83
00:05:02,410 --> 00:05:04,640
،تقبّلنا مسألة الازدحام المروري

84
00:05:04,640 --> 00:05:07,800
لكن ألا ندور في حلقة مفرغة؟

85
00:05:07,800 --> 00:05:12,620
أنا آسف، يبدو أنّ مخارج الطريق السّريع مُغلَقة

86
00:05:13,670 --> 00:05:15,840
!ما الذي يجري؟

87
00:05:21,710 --> 00:05:24,010
:انتباه إلى كافّة الركّاب

88
00:05:24,510 --> 00:05:29,350
اضطررنا لتوقُّف طارئ بسبب عطل
في إحدى النقاط أمامنا

89
00:05:29,350 --> 00:05:32,770
ولا نعلم بالضبط متى سيتمّ إصلاح العطل

90
00:05:32,770 --> 00:05:36,140
نعتذر عن الإزعاج الذي سبّبناه

91
00:05:36,400 --> 00:05:38,770
!ماذا أفعل؟

92
00:05:40,020 --> 00:05:41,000
ما هذا؟

93
00:05:41,000 --> 00:05:41,650
...ماذا

94
00:05:42,630 --> 00:05:44,800
تبّاً، ما الذي يجري؟

95
00:05:44,800 --> 00:05:46,480
ماذا تقصدين بـ"ما الذي يجري"؟

96
00:05:46,480 --> 00:05:50,280
ألا ترين؟ أنا آخذ استراحة

97
00:05:50,280 --> 00:05:52,800
أبعد الشّاحنة

98
00:05:52,800 --> 00:05:54,840
إنّها تعترض طريقنا

99
00:05:56,980 --> 00:05:58,790
هل قلتِ شيئاً؟

100
00:05:58,790 --> 00:06:01,820
أذنايّ تستريحان الآن

101
00:06:02,310 --> 00:06:05,050
ماذا نفعل يا موموي-سينسي؟

102
00:06:09,510 --> 00:06:11,450
ازدحام مروري؟

103
00:06:12,030 --> 00:06:13,260
...الشّارع

104
00:06:19,690 --> 00:06:22,440
!ها نحن قادمون، موجة كبيرة

105
00:06:22,830 --> 00:06:24,170
!ابتعدي يا غبيّة

106
00:06:24,170 --> 00:06:24,800
!ابتعدي

107
00:06:24,800 --> 00:06:26,420
!هيّا

108
00:06:26,420 --> 00:06:27,240
!انتظري

109
00:06:27,240 --> 00:06:29,700
!اقفزي

110
00:06:35,720 --> 00:06:36,910
مستحيل

111
00:06:36,910 --> 00:06:38,660
!اتبعوها

112
00:06:42,910 --> 00:06:45,320
حمداً لله لأنّني قصيرة

113
00:06:51,550 --> 00:06:53,020
كياريا-سينسي

114
00:06:53,020 --> 00:06:54,350
هل أنتِ بأمان؟

115
00:06:54,350 --> 00:06:55,380
أجل

116
00:06:55,380 --> 00:06:56,540
لنسرع

117
00:07:00,560 --> 00:07:03,710
أما كان بإمكاننا إتمام هذا الأمر بطريقةٍ أخرى؟

118
00:07:04,160 --> 00:07:06,480
هذا ليس كونيّاً على الإطلاق

119
00:07:06,800 --> 00:07:07,740
لا تكوني سخيفة

120
00:07:07,740 --> 00:07:09,810
كيف تخافين من الظلام؟

121
00:07:09,810 --> 00:07:12,990
الظلام يمدُّ الجسدَ بالقوّة

122
00:07:17,930 --> 00:07:19,720
ما مشكلتكم؟

123
00:07:19,720 --> 00:07:21,550
اسمحوا لنا بالمرور

124
00:07:21,550 --> 00:07:22,800
لا نستطيع فعل ذلك

125
00:07:22,800 --> 00:07:25,480
عودي إلى المنزل إن أردتِ ألّا تتأذّين

126
00:07:25,480 --> 00:07:26,830
مستحيل

127
00:07:26,830 --> 00:07:28,670
لا تدعيني أكرّر كلامي

128
00:07:28,670 --> 00:07:30,050
...إن كنتِ لا تريدين أن تتأذّي

129
00:07:34,350 --> 00:07:37,240
لا تستخدموا السّكاكين

130
00:07:37,670 --> 00:07:39,810
ألستم رجالاً؟

131
00:07:41,780 --> 00:07:43,190
فوروساتو-سينسي

132
00:07:43,520 --> 00:07:46,760
تابعا، اتركا هذا الأمر لنا

133
00:07:46,760 --> 00:07:47,440
...لكن

134
00:07:47,440 --> 00:07:51,130
اتركاني أبدو رائعاً ولو لمرّة

135
00:07:51,130 --> 00:07:53,050
هيّا بنا يا تشيناتسو

136
00:07:53,050 --> 00:07:54,380
حسناً

137
00:07:54,380 --> 00:07:57,190
شكراً لك يا فوروساتو-سينسي

138
00:08:00,540 --> 00:08:04,380
سأريكم ماذا يحدث

139
00:08:04,380 --> 00:08:06,500
عندما تعبثون مع مغنّياتنا النّجمات

140
00:08:10,080 --> 00:08:12,490
ساكوراكو-سان، هل أنتِ جاهزة؟

141
00:08:12,490 --> 00:08:13,090
أجل

142
00:08:13,350 --> 00:08:14,510
بالتوفيق

143
00:08:14,510 --> 00:08:15,440
ها أنا ذي

144
00:08:28,280 --> 00:08:29,500
لن أستسلم

145
00:08:29,500 --> 00:08:31,150
مهما كلّف الأمر

146
00:08:31,150 --> 00:08:32,730
سوف أغنّي

147
00:08:32,730 --> 00:08:34,530
للجميع

148
00:08:34,530 --> 00:08:36,040
ليبتسم الجميع

149
00:08:36,040 --> 00:08:40,190
—لم أتوقّع أن يكون ممتعاً إلى هذا الحدّ أن تغنّي لهدف

150
00:08:40,190 --> 00:08:42,250
لأجل شخص آخر

151
00:08:42,460 --> 00:08:44,500
اسمعونا

152
00:08:44,500 --> 00:08:46,130
!اسمعونا

153
00:08:53,060 --> 00:08:54,760
!أنباء سيّئة يا حضرة رئيس الوزراء

154
00:08:55,070 --> 00:08:58,370
المغنّيات النّجمات وعدد لا يُحصى من المعجبين
قد عبروا الحواجز

155
00:09:03,420 --> 00:09:04,470
!رئيس الوزراء

156
00:09:04,910 --> 00:09:07,610
هذه فرصة العمر

157
00:09:07,610 --> 00:09:08,150
ماذا؟

158
00:09:18,470 --> 00:09:22,790
شكراً لقدومكم وسط هذه الأمطار

159
00:09:23,040 --> 00:09:24,610
هذا مذهل

160
00:09:24,610 --> 00:09:28,600
الجمهور يزداد شيئاً فشيئاً

161
00:09:28,600 --> 00:09:33,550
لكن ليس كافياً لتغيير العالم

162
00:09:40,170 --> 00:09:41,850
...مؤلم

163
00:09:42,140 --> 00:09:43,060
!عجباً

164
00:09:43,290 --> 00:09:45,330
ما زال الوقتُ مبكّراً جدّاً على الاستسلام

165
00:09:45,330 --> 00:09:47,980
هذه ليست معركة حزب البطلات وحده

166
00:09:48,550 --> 00:09:52,470
لم تنسوا أمرنا، صحيح؟

167
00:09:52,470 --> 00:09:54,900
معها حقّ

168
00:09:59,500 --> 00:10:01,570
طاب يومكم جميعاً

169
00:10:01,570 --> 00:10:05,880
ربّما كان دخولي مبالغاً فيه

170
00:10:05,880 --> 00:10:07,370
آسفة لتأخّري

171
00:10:07,370 --> 00:10:09,630
هل يمكنني الانضمام؟

172
00:10:09,630 --> 00:10:12,210
ابتعدي عن طريقي

173
00:10:12,580 --> 00:10:17,070
كيف تجرؤين على الوقوف فوق
المرأة التي تتحكّم بالظلام؟

174
00:10:19,620 --> 00:10:21,300
استعدّي للعقوبة

175
00:10:22,590 --> 00:10:24,800
حسناً، فهمت، اخرجي فحسب

176
00:10:24,800 --> 00:10:26,430
لقد أفسدتِ متعتي

177
00:10:26,430 --> 00:10:29,190
لماذا تمشين بهذا الشيء المخيف؟

178
00:10:29,190 --> 00:10:30,560
لأجل العمل

179
00:10:32,620 --> 00:10:34,560
...لماذا أنتن جميعاً

180
00:10:34,560 --> 00:10:36,570
لماذا برأيكِ؟

181
00:10:36,840 --> 00:10:38,110
ميزوكي-سان

182
00:10:38,110 --> 00:10:41,300
رغم اختلاف مبادئنا وآرائنا وأحزابنا

183
00:10:41,300 --> 00:10:43,580
إلّا أنّ قلوبنا واحدة

184
00:10:44,100 --> 00:10:47,680
هذه معركةٌ تعنينا جميعاً نحن عضوات
المجلس النّجمات

185
00:10:52,000 --> 00:10:52,940
ناتسكي

186
00:10:59,190 --> 00:11:04,430
أنا سعيدةٌ جدّاً لأنّني سأغنّي معكِ مجدّداً

187
00:11:04,750 --> 00:11:07,570
صمدتُ حتّى الآن بفضل وقوفكِ معي

188
00:11:07,570 --> 00:11:09,560
لنكمل هذا حتّى النهاية

189
00:11:09,790 --> 00:11:10,800
حسناً

190
00:11:10,800 --> 00:11:13,380
سنناضل معكما

191
00:11:13,790 --> 00:11:14,960
يا فتيات

192
00:11:14,960 --> 00:11:16,570
أين حصلتُن على الأزياء الرسميّة؟

193
00:11:16,570 --> 00:11:19,750
لن ندعكما تلفتان كلّ الانتباه

194
00:11:19,750 --> 00:11:22,170
لا تكوني باردة يا هوشينا-سان

195
00:11:22,170 --> 00:11:24,330
كلّنا نواجه نفس المشكلة

196
00:11:24,330 --> 00:11:27,560
لنجعل هذا أفضل حفل على الإطلاق يا ناتسكي

197
00:11:27,560 --> 00:11:28,700
تماماً

198
00:11:28,700 --> 00:11:31,080
نودّ مشاركة المسرح معكِ

199
00:11:35,440 --> 00:11:37,340
يمكنكِ أن ترجعي هذا

200
00:11:39,060 --> 00:11:39,750
...لكن

201
00:11:39,750 --> 00:11:41,110
لا تسيئي الفهم

202
00:11:41,110 --> 00:11:43,340
هذا لا يعني أنّني أعترف بكِ أو ما شابه

203
00:11:43,830 --> 00:11:47,600
سأحلّ مكانكِ في معركة منصِفة ذات يوم

204
00:11:47,830 --> 00:11:49,360
تشيناتسو-سان

205
00:11:57,480 --> 00:11:58,980
هوشينا ناتسكي

206
00:11:58,030 --> 00:12:15,010
!مرّة أخرى

207
00:12:37,830 --> 00:12:39,070
ما هذا؟

208
00:12:39,330 --> 00:12:41,600
كيف يُفترَض أن نصل إلى وجهتنا هكذا؟

209
00:12:42,040 --> 00:12:44,450
نحن مضطرّون لشقِّ طريقنا بالقوّة

210
00:12:45,480 --> 00:12:49,190
اطردوا كافّة عضوات المجلس النّجمات والجمهور

211
00:12:49,190 --> 00:12:52,330
اعتقلوا أي شخص يُقاوم

212
00:12:52,630 --> 00:12:53,830
مفهوم؟

213
00:12:55,920 --> 00:12:57,040
ما الأمر؟

214
00:12:57,040 --> 00:12:59,070
إلى رجال الشرطة، دوران

215
00:13:00,770 --> 00:13:01,960
ماذا تفعلون؟

216
00:13:01,960 --> 00:13:04,260
!يُفترَض بكم أن تتخلّصوا منهم

217
00:13:04,650 --> 00:13:06,260
ما هذا؟

218
00:13:06,540 --> 00:13:08,860
ألا تسمعون أوامري؟

219
00:13:08,860 --> 00:13:10,220
لا

220
00:13:10,220 --> 00:13:11,160
ماذا؟

221
00:13:11,160 --> 00:13:12,200
ما الذي يجري؟

222
00:13:12,200 --> 00:13:15,320
لن يصغي أحدٌ لأوامرك

223
00:13:15,320 --> 00:13:16,270
من أنت؟

224
00:13:16,950 --> 00:13:19,440
أنا أونوديرا وهذه أرضي

225
00:13:21,440 --> 00:13:24,270
،بمساعدة هوشينا-سينسي

226
00:13:24,270 --> 00:13:27,110
حالفني الحظّ بالترقّي إلى مركز القيادة

227
00:13:27,110 --> 00:13:28,310
!أنت

228
00:13:28,310 --> 00:13:29,760
هل تريد أن تُطرَد؟

229
00:13:29,760 --> 00:13:32,040
لا تستعجل كثيراً يا هارا-سان

230
00:13:32,690 --> 00:13:37,780
حتّى سكرتير الوزارة العامّ غير مخوّل
بطرد المسؤولين الحكوميين

231
00:13:37,780 --> 00:13:38,480
...أنت

232
00:13:38,480 --> 00:13:39,710
!ساغيميا

233
00:13:39,710 --> 00:13:40,830
تماماً

234
00:13:40,830 --> 00:13:43,550
إضافة إلى ذلك، ما العيب في حفل مباشر؟

235
00:13:43,550 --> 00:13:48,030
ربّما تنتهك حقّهم في حرّية التعبير

236
00:13:48,030 --> 00:13:50,260
لنستمتع بذلك معاً

237
00:13:50,500 --> 00:13:54,890
قانون حظر عضوات المجلس النّجمات
لم يكن عمليّاً أصلاً

238
00:13:55,330 --> 00:13:56,690
!نيكوشيما

239
00:13:56,690 --> 00:13:57,540
!فوروساتو

240
00:13:57,540 --> 00:13:58,490
!كاتسوراياما

241
00:13:58,490 --> 00:14:00,360
وكيارا أيضاً؟

242
00:14:00,360 --> 00:14:02,890
...أيُّها الحقراء

243
00:14:59,030 --> 00:15:02,500
يا رئيس الوزراء، يتجمّع مزيد من النّاس القادمين من المحطّة

244
00:15:03,020 --> 00:15:05,080
كيف علم كثيرٌ من النّاس بهذا الأمر؟

245
00:15:05,080 --> 00:15:08,190
لنتّصل بالمفوّض العام للشرطة الوطنيّة

246
00:15:08,190 --> 00:15:11,140
لا، لنأمر قوّات الدفاع بالتحرّك

247
00:15:11,140 --> 00:15:14,050
!لندع أولئك الفتيات يغادرن

248
00:15:18,690 --> 00:15:19,990
رئيس الوزراء؟

249
00:15:31,300 --> 00:15:33,300
إنّهن لسن مغنّيات نجمات

250
00:15:34,050 --> 00:15:35,030
ماذا؟

251
00:15:35,400 --> 00:15:37,000
إنّهن عضوات مجلس نجمات

252
00:15:41,860 --> 00:15:43,370
عظيم

253
00:15:43,370 --> 00:15:44,990
سأواجههن

254
00:16:34,290 --> 00:16:35,970
لماذا أنتنّ جميعاً هنا؟

255
00:16:36,820 --> 00:16:39,140
:من دون أدنى شكّ

256
00:16:39,140 --> 00:16:42,050
لأنّنا شعرنا أنّ هذا هو التصرّف الصّائب

257
00:16:42,790 --> 00:16:43,980
هذا كُل ما في الأمر

258
00:16:44,250 --> 00:16:47,270
لكن لا تعترفن بنا على حدّ علمي

259
00:16:47,520 --> 00:16:51,810
صحيح، لستُن منافسات لجيل ميكازوكي كاغورا

260
00:16:51,810 --> 00:16:55,990
لهذا عليكن المتابعة... والمضيّ قدماً

261
00:16:56,230 --> 00:17:01,000
سنستمرُّ في كوننا جداراً في وجهكن إلى أن تهزمننا

262
00:17:06,430 --> 00:17:14,880
شكراً جزيلاً لكن لمجيئكن وسماع أغنيتنا

263
00:17:41,830 --> 00:17:43,750
حفل سمايل كيس
!لقد تحقّق
‏200.000 مشترك

264
00:17:43,750 --> 00:17:46,250
تزايد الشكوك حيال قانون حظر عضوات المجلس النّجمات

265
00:17:47,920 --> 00:17:53,580
الحفل المُباشَر لعضوات المجلس النّجمات
صدمَ النّاس

266
00:17:53,580 --> 00:17:57,090
بصِفتي سياسيّ، لا بل بصِفتي رئيس الوزراء

267
00:17:57,090 --> 00:18:00,010
لا أسمح بتجاهل هذا الأمر

268
00:18:00,010 --> 00:18:06,830
أسألكم: ما هي متطلّبات مواطني هذا البلد
منّا كسياسيين؟

269
00:18:07,870 --> 00:18:11,610
بصفتي رئيس الوزراء، أعلن هاهنا عن حلِّ المجلس

270
00:18:12,270 --> 00:18:16,150
وعقد حملة انتخابات عامّة

271
00:18:16,390 --> 00:18:18,200
توقّعتُ أنّه سيفعل ذلك

272
00:18:19,910 --> 00:18:22,160
انتخابات عامّة؟

273
00:18:22,160 --> 00:18:24,370
لا بدّ وأنّه يحضِّر للأسوأ

274
00:18:24,370 --> 00:18:25,260
ستكون الأمور على ما يُرام

275
00:18:25,260 --> 00:18:26,340
سنربح

276
00:18:26,900 --> 00:18:29,670
نستطيع نحن الاثنتان فعل أي شيء معاً

277
00:18:32,220 --> 00:18:33,550
معكِ حقّ

278
00:18:36,110 --> 00:18:39,360
والآن، أنتما، لنبتهج

279
00:18:39,360 --> 00:18:40,050
أجل

280
00:20:22,780 --> 00:20:24,700
هل أنتِ راضية عن هذا يا ناتسكي؟

281
00:20:24,700 --> 00:20:26,880
ألا تريدين إبقاء التلفاز يعمل؟

282
00:20:26,880 --> 00:20:28,360
لا مشكلة

283
00:20:28,360 --> 00:20:31,740
فأخبار الانتخابات لا تزيدني إلّا توتّراً

284
00:20:31,740 --> 00:20:34,560
إضافة إلى أنّنا فعلنا ما علينا فعله

285
00:20:34,560 --> 00:20:37,020
أنتِ لا تتغيّرين أبداً، أليس كذلك؟

286
00:20:37,320 --> 00:20:38,710
ها أنتما هنا

287
00:20:38,880 --> 00:20:41,410
كُلي حتّى الشّبع

288
00:20:41,410 --> 00:20:42,780
مرحى

289
00:20:42,780 --> 00:20:44,470
كرات أرزّ جدّتي

290
00:20:44,790 --> 00:20:45,900
تفضّلا

291
00:20:45,900 --> 00:20:46,720
ماذا؟

292
00:20:47,200 --> 00:20:49,140
أليستا أكبر من المعتاد؟

293
00:20:49,140 --> 00:20:50,200
بالطبع

294
00:20:50,200 --> 00:20:51,910
بذلتُ جهداً إضافيّاً عليها

295
00:20:51,910 --> 00:20:54,350
وأنت أيضاً يا سانبي، كُل حتّى الشّبع

296
00:20:55,640 --> 00:20:57,930
حان وقتُ الطعام

297
00:20:59,940 --> 00:21:00,730
مهلاً

298
00:21:06,930 --> 00:21:09,110
نعم؟ هوشينا تتكلّم

299
00:21:09,640 --> 00:21:11,840
أجل، هذه أنا

300
00:21:14,090 --> 00:21:15,750
حقّاً؟

301
00:21:15,750 --> 00:21:17,460
هوشينا

302
00:21:16,000 --> 00:21:17,490
!شكراً لك

303
00:21:26,730 --> 00:21:28,180
لقد عُدت

304
00:21:34,100 --> 00:21:36,410
لِمَ هذه العواطف؟

305
00:21:37,300 --> 00:21:40,330
معركتنا قد بدأت للتو

306
00:21:40,330 --> 00:21:41,500
آسفة

307
00:21:41,500 --> 00:21:43,930
تأثّرتُ فحسب

308
00:21:43,930 --> 00:21:45,770
لا مشكلة

309
00:21:45,770 --> 00:21:52,620
أنا مسرورة أنّ كلّ عضوة مجلس نجمة
قد تمّ إعادة انتخابها، ألستِ كذلك؟

310
00:21:52,620 --> 00:21:54,040
حقّاً؟

311
00:21:54,350 --> 00:21:55,250
أجل

312
00:21:55,250 --> 00:21:57,420
ستريهن في القاعة الرئيسيّة عمّا قريب

313
00:21:57,420 --> 00:21:59,000
لنذهب يا شيزوكا-سان

314
00:21:59,000 --> 00:22:00,160
اهدئي

315
00:22:00,160 --> 00:22:03,100
ممنوع الرّكض في الأروقة كما في المدرسة

316
00:22:03,100 --> 00:22:04,810
أعلم، أعلم

317
00:22:06,930 --> 00:22:07,830
رئيس الوزراء

318
00:22:07,830 --> 00:22:11,060
يبدو أنّكن اجتزتُن الانتخابات

319
00:22:11,060 --> 00:22:13,680
،أبارك لكُنّ حاليّاً

320
00:22:13,960 --> 00:22:17,380
لكن معتقداتي تبقى ثابتة

321
00:22:17,380 --> 00:22:20,360
عضوات المجلس ينبغي ألّا يغنّين

322
00:22:20,360 --> 00:22:23,880
بل يجب عليهنّ أن يكرّسن حياتهن للحكومة الوطنيّة

323
00:22:26,210 --> 00:22:31,740
لكن إن كنتُنّ مصرّات على سلوك
الطريق الذي تؤمننّ به، فليكن إذاً

324
00:22:31,930 --> 00:22:33,660
أنا جاهز للمواجهة

325
00:22:33,660 --> 00:22:35,700
سأواجهكن

326
00:22:43,200 --> 00:22:45,190
لن ندعه يفوز يا ناتسكي

327
00:22:46,190 --> 00:22:48,220
حلمنا

328
00:22:48,470 --> 00:22:49,710
...حلمنا

329
00:22:50,860 --> 00:22:52,550
هو رسم البسمة في وجه الجميع

330
00:22:53,210 --> 00:22:53,980
صحيح؟

331
00:22:55,930 --> 00:22:56,660
أجل

332
00:23:30,010 --> 00:23:40,310
الرّسم: تيف

333
00:23:30,590 --> 00:23:33,510
اسمي أونيمارو شيزوكا، عضوة مجلس نجمة من فوكوكا

334
00:23:33,510 --> 00:23:35,750
وصلنا إلى هنا بفضلِ دعمكم

335
00:23:35,750 --> 00:23:36,640
شكراً

336
00:23:36,640 --> 00:23:39,120
أنا محظوظة بشراكتكم