1
00:00:04,430 --> 00:00:10,100
كان يوجد طابور لا ينتهي من المقترعين طوال اليوم

2
00:00:05,020 --> 00:00:08,020
مشروع قانون حظر عضوات المجلس النّجمات
اليوم الأخير للتصويت

3
00:00:10,920 --> 00:00:15,100
كيف سيستجيب المواطنون لطرح رئيس الوزراء ساكورابا

4
00:00:15,100 --> 00:00:20,620
قانوناً ينهي عمل عضوات المجلس النّجمات؟

5
00:00:20,620 --> 00:00:21,410
شيزوكا

6
00:00:25,760 --> 00:00:28,630
يكفي حتّى إثارة قلق شيزوكا، صحيح؟

7
00:00:30,360 --> 00:00:33,470
بذلنا قصارى جهدنا

8
00:00:33,470 --> 00:00:34,390
أليس كذلك؟

9
00:00:55,060 --> 00:00:58,100
ناتسكي، نتائج الاستفتاء قد بدأت تصدر

10
00:00:59,200 --> 00:01:01,270
هل أنتِ خائفة من معرفتها؟

11
00:01:01,910 --> 00:01:04,540
لا تقلقي، سأجلس بجانبكِ

12
00:01:04,540 --> 00:01:06,010
لنشاهدها معاً

13
00:01:08,210 --> 00:01:13,390
لحظة، لقد أُعلِن عن نتائج الاستفتاء

14
00:01:09,170 --> 00:01:12,170
تقرير إحصاء أصوات "مشروع قانون حظر عضوات
"المجلس النّجمات

15
00:01:13,390 --> 00:01:16,080
حالياً، تمّ إحصاء 80% من الأصوات حتّى الآن

16
00:01:16,080 --> 00:01:19,450
...لكن مشروع قانون حظر عضوات المجلس النّجمات قد

17
00:02:53,520 --> 00:02:58,400
حزب روغاي

18
00:02:54,020 --> 00:02:55,550
تقرير مباشر

19
00:02:55,550 --> 00:02:58,400
،على ضوء نتائج الاستفتاء

20
00:02:58,400 --> 00:03:00,540
الأجواء هنا في حزب روغاي مفعمة بالحيويّة

21
00:03:00,540 --> 00:03:04,030
!مرحى

22
00:03:04,030 --> 00:03:07,760
سيادة رئيس الوزراء، لقد تمّت الموافقة
على قانون حظر عضوات المجلس النّجمات

23
00:03:07,760 --> 00:03:09,050
ما هو رأيك؟

24
00:03:09,050 --> 00:03:15,120
كما سلفَ ووضّحت، لا أرفض وجود مغنّيات نجمات

25
00:03:15,120 --> 00:03:20,520
لكن إن كُنَّ مشغولات جدّاً بالغناء والنجوميّة

26
00:03:20,520 --> 00:03:26,120
لدرجة إهمال واجباتهن الحكوميّة، فسيُصبِحن بلا فائدة

27
00:03:26,820 --> 00:03:31,360
من هذا المنطلق، أعتقد أنّ المواطنين

28
00:03:31,360 --> 00:03:35,190
قد اختاروا خياراً حكيماً في اقتراع اليوم

29
00:03:35,720 --> 00:03:38,730
ما رأيك بمستقبل عضوات المجلس النّجمات؟

30
00:03:39,040 --> 00:03:41,220
،ممّا لا شكّ فيه

31
00:03:41,220 --> 00:03:44,360
عليهنّ أن يفعلن ما كان من المُفترض
عليهن أن يفعلنه

32
00:03:45,740 --> 00:03:48,490
مقرّ حزب ضوء الشّمس

33
00:03:51,010 --> 00:03:54,550
...لا أصدّق أنّهم استخدموا استراتيجيّتنا ضدّنا

34
00:03:55,540 --> 00:03:57,690
هذا غير معقول

35
00:03:59,990 --> 00:04:01,430
هذه غلطتي أنا

36
00:04:02,700 --> 00:04:07,300
هذا لأنّني تحمّستُ كثيراً وقدتُ الجميع
للاتّجاه الخطأ

37
00:04:07,300 --> 00:04:09,100
فات الأوان على قول ذلك

38
00:04:09,370 --> 00:04:10,800
لكنّه صحيح

39
00:04:10,800 --> 00:04:14,350
لا يمكننا جذب النّاس إلينا إن كنّا
نغنّي ونؤدّي لنربح فقط

40
00:04:17,640 --> 00:04:26,280
من الطبيعي أن يرفضنا جمهورنا بعد حضور استعراضنا

41
00:04:27,120 --> 00:04:30,790
لم أكن أحتسب لأي شيء

42
00:04:38,230 --> 00:04:39,300
هل تتهرّبين؟

43
00:04:39,580 --> 00:04:40,670
!شيزوكا

44
00:04:40,920 --> 00:04:42,010
تشيناتسو

45
00:04:42,010 --> 00:04:43,330
توقّفي

46
00:04:43,330 --> 00:04:44,520
...لكن

47
00:04:44,520 --> 00:04:47,060
إلقاء اللّوم على شيزوكا غير منطقي

48
00:04:47,760 --> 00:04:50,270
علينا تقبُّل هذه النتيجة بصدر رحب

49
00:04:50,270 --> 00:04:55,100
والتفكير بما سنفعله مستقبلاً

50
00:04:55,810 --> 00:04:56,760
هل أنا مخطئة؟

51
00:05:04,150 --> 00:05:07,190
سأتحمّل مسؤوليّة هذا

52
00:05:11,700 --> 00:05:14,580
هل أنتِ متأكّدة من تركها تذهب أيضاً؟

53
00:05:15,810 --> 00:05:18,580
سأؤمن بهما

54
00:05:19,140 --> 00:05:20,590
ستكون الأمور على ما يُرام

55
00:05:28,840 --> 00:05:30,970
هذا محزن، أليس كذلك؟

56
00:05:32,360 --> 00:05:35,690
وكأنّ الدّنيا اسودّت في وجهنا

57
00:05:36,100 --> 00:05:40,300
حتّى الرّاديو لم يعد يبثّ أي أغنية

58
00:05:40,300 --> 00:05:45,610
أعتقد أنّ السبب يعزو لمشروع قانون
حظر عضوات المجلس النّجمات ذاك

59
00:05:51,020 --> 00:05:53,300
ومع ذلك تستمرّ الحياة

60
00:05:54,200 --> 00:05:56,710
لا شيء يتغيّر

61
00:05:57,620 --> 00:06:00,870
لا، لم أستطع تغيير شيء

62
00:06:26,130 --> 00:06:27,720
...جسدي

63
00:06:27,720 --> 00:06:28,870
...لماذا

64
00:06:29,380 --> 00:06:33,180
ناتسكي، لماذا تستلقين هكذا طوال اليوم؟

65
00:06:33,180 --> 00:06:35,950
يريد جدّي أن تساعديه في المزرعة

66
00:06:41,640 --> 00:06:44,740
غبيّة، لماذا تحرثين هناك؟

67
00:06:45,300 --> 00:06:47,720
يُفترَض أن تحرثي هنا

68
00:06:50,130 --> 00:06:51,300
آسفة

69
00:06:51,560 --> 00:06:53,150
يا إلهي

70
00:06:53,150 --> 00:06:55,840
لا بأس يا سانبي

71
00:06:55,840 --> 00:06:58,510
لا ينبغي أن تكون كثير الأنين

72
00:06:58,510 --> 00:07:00,840
لن تشتهر في أوساط الفتيات هكذا

73
00:07:00,840 --> 00:07:02,060
!جدّي

74
00:07:08,980 --> 00:07:11,070
ما الأمر يا ناتسكي؟

75
00:07:11,070 --> 00:07:13,070
قانون حظر عضوات المجلس النّجمات
!تُعاقَب المُخالِفات وتُجرَّدن من مؤهّلات عضوة مجلس نجمة؟

76
00:07:13,380 --> 00:07:15,020
عليكِ أن تأكلي شيئاً

77
00:07:15,020 --> 00:07:16,600
لا ينفع أن تجوّعي نفسكِ

78
00:07:17,520 --> 00:07:18,540
هيّا

79
00:07:37,140 --> 00:07:38,160
ما الأمر؟

80
00:07:38,160 --> 00:07:39,100
هل كان سيّئاً؟

81
00:07:41,360 --> 00:07:42,860
إنّه لذيذ

82
00:07:43,730 --> 00:07:47,860
طعمه لذيذ بالنسبة لي حتّى بالظروف الرّاهنة

83
00:07:49,320 --> 00:07:53,560
ما كان ينبغي أن أصبح عضوة مجلس نجمة

84
00:07:55,000 --> 00:07:57,850
كان ينبغي أن أعيش حياةً عاديّة كما كنت

85
00:07:58,310 --> 00:08:00,780
لما انتابَني إحساسٌ كهذا

86
00:08:03,640 --> 00:08:09,270
لا أستطيع رسم البسمة في وجهِ أحد بعد الآن

87
00:08:10,960 --> 00:08:12,760
امسحي دموعكِ

88
00:08:19,480 --> 00:08:23,320
ناتسكي، هل سمعتِ بميكازوكي كاغورا؟

89
00:08:23,890 --> 00:08:25,380
قليلاً

90
00:08:25,770 --> 00:08:29,650
هل تعلمين أنّها كانت أوّل عضوة مجلس
نجمة في اليابان؟

91
00:08:31,010 --> 00:08:33,640
حدث ذلك منذُ أكثر من 20 عاماً

92
00:08:33,640 --> 00:08:38,030
ظهرَتْ ميكازوكي كاغورا عندما طوّقَ
الظلامُ هذا البلد

93
00:08:39,010 --> 00:08:41,560
سخِرَ الجميع في البداية بالطبع

94
00:08:41,560 --> 00:08:45,180
ما الذي تستطيع فتاةٌ صغيرةٌ فعله بمفردها؟

95
00:08:45,180 --> 00:08:47,240
كانَتْ معركة مُوحِشة

96
00:08:48,080 --> 00:08:52,520
لكن سرعان ما بدأ النّاس تدريجياً

97
00:08:52,520 --> 00:08:57,020
يشاركونها نظرتها ويصطفّون معها

98
00:08:57,740 --> 00:09:02,220
أصبحت رئيسة الوزراء وغيّرَتْ هذا البلد

99
00:09:03,110 --> 00:09:06,970
...من زمن الظلام إلى زمن النّور

100
00:09:07,850 --> 00:09:11,110
هل كان رئيس الوزراء ميكازوكي بتلك العظَمة؟

101
00:09:13,080 --> 00:09:15,180
كانَتْ أيّاماً جميلة

102
00:09:15,960 --> 00:09:20,200
ذات يوم، سألها شخصٌ لماذا اختارت أن تصبح
عضوة مجلس نجمة

103
00:09:20,200 --> 00:09:21,580
:فأجابت

104
00:09:22,440 --> 00:09:25,180
"لأنّني أردتُ أن أرسم بسمةً في وجه أحد"

105
00:09:25,790 --> 00:09:29,130
وما الذي تفعله ميكازوكي كاغورا الآن؟

106
00:09:29,780 --> 00:09:31,260
لا أدري

107
00:09:32,240 --> 00:09:39,120
لكن كانت ميكازوكي كاغورا في مثل
سنّك الآن يا ناتسكي

108
00:09:39,120 --> 00:09:43,560
كانت شابّة آمنَتْ بنفسها وناضلَتْ

109
00:09:45,660 --> 00:09:48,440
لا يوجد ما يمنعكِ

110
00:09:48,730 --> 00:09:52,330
لكن لستُ ميكازوكي كاغورا

111
00:09:53,120 --> 00:09:56,030
لم أستطع فعل شيء

112
00:09:56,030 --> 00:09:58,330
لم أستطع رسم البسمة في وجه أحد

113
00:09:59,010 --> 00:10:03,420
حسناً إذاً، ما رأيكِ أن تري بأمّ عينكِ؟

114
00:10:05,750 --> 00:10:09,710
محطّة نيغاتا

115
00:10:09,990 --> 00:10:12,640
أرى بأمّ عيني؟

116
00:10:12,640 --> 00:10:15,560
ماذا يُفترَض أن أرى هنا؟

117
00:10:16,500 --> 00:10:18,470
هوشينا-سينسي

118
00:10:22,720 --> 00:10:25,580
مهلاً، هل نسيتِني؟

119
00:10:25,580 --> 00:10:27,430
هذا أنا، أتذكرين؟

120
00:10:29,470 --> 00:10:32,250
هل أنت المشارك في الانتخابات الخاصّة؟

121
00:10:32,250 --> 00:10:33,420
لم أرك منذ وقت طويل

122
00:10:33,420 --> 00:10:34,720
ساغيميا في خدمتك

123
00:10:34,720 --> 00:10:37,350
ماذا تفعل هنا؟

124
00:10:37,800 --> 00:10:39,850
أنظّف أمام المحطّة

125
00:10:39,850 --> 00:10:44,910
ارتأيتُ أن أدع المصوّتين يعرفونني لأجل الانتخابات القادمة

126
00:10:45,200 --> 00:10:47,630
،إن أردتِ أن تغيّري شيئاً

127
00:10:47,630 --> 00:10:50,370
فعليكِ أن تبدئي بما يحيط بكِ

128
00:10:50,700 --> 00:10:51,480
أجل

129
00:10:51,480 --> 00:10:54,440
سمعتُ بقانون حظر عضوات المجلس النّجمات

130
00:10:54,440 --> 00:10:55,800
،هذا مؤسف

131
00:10:56,360 --> 00:11:00,890
لكن لا تحسبي أنّ كافّة المواطنين قد عارضوا
عضوات المجلس النّجمات

132
00:11:00,890 --> 00:11:02,970
لا تفقدي عزيمتكِ

133
00:11:02,970 --> 00:11:05,080
شكراً لك

134
00:11:05,080 --> 00:11:07,890
ماذا تفعل الآن يا ساغيميا-سان؟

135
00:11:07,890 --> 00:11:10,440
أكسب قوت يومي كعمل مستقلّ

136
00:11:10,440 --> 00:11:13,280
لا داعي لتكوني في حزبٍ كبير مثل حزب روغاي

137
00:11:13,280 --> 00:11:15,270
ما دمتِ تملكين رؤية

138
00:11:15,970 --> 00:11:21,480
أنتِ من علّمني ذلك يا هوشينا-سينسي

139
00:11:24,080 --> 00:11:26,160
راقبيني فحسب

140
00:11:26,160 --> 00:11:29,900
سأهزمكِ في الانتخابات القادمة يا سينسي

141
00:11:34,180 --> 00:11:36,040
لن أنهزم

142
00:11:36,920 --> 00:11:39,380
إلى اللّقاء يا هوشينا-سينسي

143
00:11:39,920 --> 00:11:41,930
سأعملُ بجدٍّ أيضاً

144
00:11:54,450 --> 00:11:55,710
هل من مشكلة؟

145
00:11:55,710 --> 00:11:57,900
أوني-تشان، هل تبكين؟

146
00:11:59,190 --> 00:12:03,450
تبدين حزينة جدّاً

147
00:12:03,450 --> 00:12:05,160
هل أنتِ قلقة عليّ؟

148
00:12:05,160 --> 00:12:06,410
شكراً

149
00:12:07,820 --> 00:12:08,730
خذي هذه

150
00:12:08,730 --> 00:12:11,240
أعددتُها بنفسي

151
00:12:11,660 --> 00:12:12,330
تفضّلي

152
00:12:12,680 --> 00:12:14,960
كرة الأرزّ هذه ستحسّن مزاجكِ

153
00:12:18,480 --> 00:12:20,020
أنا هوشينا ناتسكي

154
00:12:20,760 --> 00:12:23,670
لطالما كنتُ من المُعجبات بكِ يا أونيمارو-سان

155
00:12:26,150 --> 00:12:27,160
ناتسكي

156
00:12:37,450 --> 00:12:40,320
حسناً يا جماعة، انتظروا دوركم

157
00:12:40,320 --> 00:12:43,300
لن تهرب الفنون منكم

158
00:12:45,250 --> 00:12:47,360
هوشينا-سينسي، مرحباً

159
00:12:47,360 --> 00:12:49,760
فوروساتو-سينسي

160
00:12:49,760 --> 00:12:50,700
ما هذا؟

161
00:12:51,070 --> 00:12:55,470
انتشرت أخبارنا في كلّ مكان في الإنترنت
منذ ما حدث

162
00:13:00,590 --> 00:13:05,050
لكن سمعتُ أنّ هناك الكثير من القمامة
التي تُرِكَتْ من دون مُعالجة بسبب ذلك

163
00:13:05,050 --> 00:13:07,150
كان ذلك في الماضي

164
00:13:07,150 --> 00:13:10,040
لكن لم يعد هذا مشكلة بعد الآن

165
00:13:10,760 --> 00:13:12,410
إعادة تدوير

166
00:13:12,410 --> 00:13:15,610
طلبنا من بلديّة القرية إعادة تدوير المزيد والمزيد

167
00:13:15,610 --> 00:13:18,300
تقلّصت القمامة كثيراً منذ ذلك الحين

168
00:13:18,300 --> 00:13:23,240
كنتُ مرتاباً في البداية لكن يسرّني
أنّنا فعلنا ما بوسعنا

169
00:13:24,670 --> 00:13:30,400
هل تعلمين أنّ نسبة إعادة التدوير
خلال فترة إيدو كانت 90%؟

170
00:13:30,400 --> 00:13:32,290
ذلك ما نصبو إليه

171
00:13:40,320 --> 00:13:44,410
كانت هناك حالة هلع شديدة في البداية
نظراً لوجود عدد كبير من القطط

172
00:13:44,410 --> 00:13:49,550
لكن تتغيّر الأوضاع عندما تفعلين ما بوسعكِ

173
00:13:49,920 --> 00:13:53,070
انتهينا من الشقق الخاصّة بالقطط

174
00:13:53,070 --> 00:13:54,560
يسير الأمر على ما يرام

175
00:13:54,810 --> 00:13:57,100
أليس كذلك أيّها القطّ الزعيم-تشان؟

176
00:14:01,100 --> 00:14:02,360
تطوّع؟

177
00:14:02,360 --> 00:14:03,280
أجل

178
00:14:03,280 --> 00:14:07,520
بعض راكبي الأمواج الذين أحبّوا هذا الشاطئ
أحضروا رفاقهم من ركّاب الأمواج أيضاً

179
00:14:07,520 --> 00:14:11,420
شيئاً فشيئاً، قمنا بالتغيير

180
00:14:11,420 --> 00:14:13,580
وانظري إليه الآن

181
00:14:16,160 --> 00:14:20,920
سنستمرّ في العمل لحماية هذا الشّاطئ

182
00:14:25,670 --> 00:14:29,430
روضة كاميكامي

183
00:14:26,720 --> 00:14:29,430
يبدو أنّ الرّوضة ستبقى مفتتحة

184
00:14:29,910 --> 00:14:32,920
بعد الفوضى العارمة، علِمَتْ شركة أعمال محلّية
بأنّ الرّوضة ستُغلَق

185
00:14:32,920 --> 00:14:35,770
فعرضت علينا تمويلنا

186
00:14:36,210 --> 00:14:39,190
الأطفال وأمّهاتهم العامِلات قد شعروا بالسّعادة

187
00:14:39,580 --> 00:14:42,920
هوشينا-سينسي، أودُّ أن أشكركِ من أعماق قلبي

188
00:14:43,690 --> 00:14:46,000
،لو لم ألتقِ بكِ

189
00:14:46,000 --> 00:14:49,770
لكنتُ ما أزال عضواً تقليديّاً في حزب روغاي

190
00:14:50,340 --> 00:14:55,460
لكنّني الآن مسرور حقّاً لأنّني أصبحتُ عضواً في المجلس

191
00:14:55,460 --> 00:14:59,750
تغيير التفاصيل الصّغيرة من حولكِ
تقودكِ إلى تغييرات أكبر

192
00:15:01,040 --> 00:15:02,040
شكراً

193
00:15:09,360 --> 00:15:13,270
ما رأيكِ إذاً أن تري بأمّ عينكِ؟

194
00:15:15,120 --> 00:15:18,170
شكراً يا جدّتي

195
00:15:27,030 --> 00:15:28,820
هل عثرتِ على إجابة؟

196
00:15:30,630 --> 00:15:35,300
كرهتُكِ عندما قرّرتُ مغادرة حزب ضوء الشّمس

197
00:15:36,830 --> 00:15:41,550
لكن فكّرتُ بالأمر ووجدتُ أنّ الشعور لم يكن متبادلاً

198
00:15:41,550 --> 00:15:42,730
ليس متبادلاً؟

199
00:15:43,590 --> 00:15:48,500
كنتُ فقط أفرض مشاعري على المُحيطين بي

200
00:15:49,270 --> 00:15:52,680
لم أعطِ ولم أقبل التلقّي أيضاً

201
00:15:52,680 --> 00:15:58,470
كنتُ أحبَط وأستاء بأنانيّة من النّاس الذين حولي

202
00:15:59,440 --> 00:16:02,040
لم أستطع فهم شيء في النّهاية

203
00:16:03,880 --> 00:16:06,710
لا يعيش النّاس في عزلة

204
00:16:07,110 --> 00:16:10,260
مع ذلك تظاهرتُ أنّ بمقدوري فعل كلّ شيء لنفسي

205
00:16:11,080 --> 00:16:13,320
لكنّكِ تغيّرتِ

206
00:16:13,800 --> 00:16:15,060
غير صحيح

207
00:16:15,490 --> 00:16:17,100
هناك من غيّرني

208
00:16:17,100 --> 00:16:18,090
إنّها هي

209
00:16:18,760 --> 00:16:21,720
ظننتُ الأمر سخيفاً في بادئ الأمر

210
00:16:21,720 --> 00:16:24,520
إنّها تائهة واعتباطيّة

211
00:16:24,520 --> 00:16:27,370
تتكلّم وكأنّها تحلم

212
00:16:28,230 --> 00:16:30,920
،لكنّها تعطي دوماً

213
00:16:32,160 --> 00:16:34,760
دون أن تنتظر تلقّي شيء بالمقابل

214
00:16:34,760 --> 00:16:37,860
تعطي بسمات وشجاعة

215
00:16:44,470 --> 00:16:46,820
عثرتِ على إجابتكِ أخيراً إذاً

216
00:16:47,720 --> 00:16:50,280
آمني بذلك دون خوف إذاً

217
00:16:53,080 --> 00:16:55,850
اخترتِها شريكة لكِ في نهاية المطاف

218
00:17:17,700 --> 00:17:19,600
ستخرجين؟

219
00:17:19,600 --> 00:17:20,680
سأخرج قليلاً

220
00:17:21,250 --> 00:17:23,190
هل سترين ناتسكي-تشان؟

221
00:17:23,920 --> 00:17:25,160
أرأيتِ؟

222
00:17:25,160 --> 00:17:27,190
عرفتُ أنّ الأمور ستكون على ما يُرام

223
00:17:27,190 --> 00:17:32,820
قلتُ لكِ أنّ رابطكما ليس هشّاً إلى ذاك الحدّ

224
00:17:32,820 --> 00:17:35,340
...المعذرة، لكن

225
00:17:35,340 --> 00:17:38,410
لا داعي للخجل الآن

226
00:17:38,720 --> 00:17:39,660
ناتسكي

227
00:17:40,480 --> 00:17:41,770
...المعذرة

228
00:17:41,770 --> 00:17:42,740
!هيّا

229
00:17:48,500 --> 00:17:50,710
آسفة على كلّ ما حدث

230
00:17:50,710 --> 00:17:55,460
كان الجميع يعمل ما بوسعهم بينما تهرّبتُ أنا

231
00:17:55,810 --> 00:17:58,330
أنا حقّاً آسفة

232
00:17:59,360 --> 00:18:01,530
أنا آسفةٌ أيضاً

233
00:18:02,500 --> 00:18:06,710
كنتُ مهووسة جدّاً بالفوز فأغفلتُ
ما كان مهمّاً

234
00:18:07,360 --> 00:18:11,050
علينا أن نرسمَ البسمةَ في وجه النّاس
مهما حدث

235
00:18:11,480 --> 00:18:14,090
لا ألومكِ على تهرّبكِ

236
00:18:17,010 --> 00:18:18,190
لا، لا

237
00:18:18,190 --> 00:18:22,680
لكنّكِ أيقظتِني

238
00:18:22,680 --> 00:18:25,910
أنتِ أوّل من سأجعلها تبتسم يا شيزوكا-سان

239
00:18:26,960 --> 00:18:30,510
،أدركتُ أنّه لرسم البسمة في وجه الجميع

240
00:18:30,510 --> 00:18:33,770
عليّ أوّلاً أن أدع من حولي يبتسمون

241
00:18:33,770 --> 00:18:37,290
لطالما كنتُ أعتمد عليكِ في كلّ شيء

242
00:18:37,290 --> 00:18:39,840
لم أجعلكِ تبتسمين يوماً

243
00:18:40,720 --> 00:18:43,880
لذا أولاً، سأرسم البسمةَ في وجهكِ

244
00:18:44,280 --> 00:18:47,190
أريد أن أراكِ تبتسمين

245
00:18:48,100 --> 00:18:51,650
لهذا أنا متحمّسة للتعاون معكِ في المضيّ قدماً أيضاً

246
00:18:55,270 --> 00:18:56,900
هوشينا ناتسكي

247
00:18:59,120 --> 00:19:03,220
أنتِ شريكتي بلا شكّ

248
00:19:10,620 --> 00:19:13,850
ناتسكي، لنرسم البسمة في وجه الجميع

249
00:19:14,490 --> 00:19:15,710
!أجل

250
00:19:18,610 --> 00:19:20,970
حدث مُباشَر مرّة أخرى؟

251
00:19:21,260 --> 00:19:22,000
أجل

252
00:19:22,000 --> 00:19:23,630
لا أدري بصراحة

253
00:19:23,630 --> 00:19:29,480
لا أعتقد أنّه من الآمن مواجهة قانون
حظر عضوات المجلس النّجمات في هذا المناخ

254
00:19:29,480 --> 00:19:34,600
لا أنكر أنّ قانون حظر عضوات المجلس النّجمات
تلقّى دعماً في الاستفتاء

255
00:19:34,600 --> 00:19:40,390
لكن هذا لا يعني أنّ جميع من صوّتوا
كانوا معارضين لعضوات المجلس النّجمات

256
00:19:40,390 --> 00:19:44,120
أنا متأكّدة أنّ هناك أشخاص يؤيّدوننا أيضاً

257
00:19:44,120 --> 00:19:46,380
لا أعرف ماذا أقول

258
00:19:46,380 --> 00:19:49,210
تكلّمي معهم من فضلك يا حضرة الرّئيسة

259
00:19:49,210 --> 00:19:53,080
يُعجبني هذا فيكِ يا ناتسكي-تشان

260
00:19:53,080 --> 00:19:54,540
!حضرة الرّئيسة

261
00:19:54,540 --> 00:19:57,070
ما رأيكِ يا شيزوكا؟

262
00:19:57,070 --> 00:19:58,810
يروقني هذا

263
00:19:58,810 --> 00:20:01,160
سنستمرُّ في الغناء ما دام لدينا مُعجبين

264
00:20:01,700 --> 00:20:04,010
هكذا يُفترَض أن تعمل المغنّية النّجمة

265
00:20:04,010 --> 00:20:07,510
قد تفقدن مؤهّلاتكن كعضوات مجلس

266
00:20:07,780 --> 00:20:09,200
أعلم ذلك

267
00:20:09,200 --> 00:20:11,600
نحن لا نفعل هذا لأجلنا

268
00:20:11,600 --> 00:20:14,520
نفعل هذا لأجل من يؤيّدوننا

269
00:20:14,520 --> 00:20:15,940
كما سمِعت

270
00:20:18,340 --> 00:20:19,880
حسناً

271
00:20:19,880 --> 00:20:23,160
في هذه الحالة سأحرص على إنجاح الحدث

272
00:20:25,870 --> 00:20:27,530
حُسِمَ الأمر إذاً

273
00:20:27,530 --> 00:20:31,920
سينجح الحدث حتماً بوجودكما كثنائي

274
00:20:31,920 --> 00:20:33,790
لنذهب للتحضير

275
00:20:35,490 --> 00:20:38,680
ناتسكي، كم مضى منذُ أخذتِ إجازة من دروسكِ؟

276
00:20:39,160 --> 00:20:40,540
...على ما أذكر

277
00:20:40,540 --> 00:20:42,050
سبعة أيّام؟

278
00:20:42,350 --> 00:20:46,570
سبعة أيّام كافية لتراجع مهارتكِ في الأداء

279
00:20:47,040 --> 00:20:51,810
عليكِ أن تضاعفي جهودكِ للتعويض عن الوقتِ الضائع

280
00:20:51,810 --> 00:20:54,510
سأتدرّب تدريباً صارماً

281
00:20:54,510 --> 00:20:55,850
...لكن أوّلاً

282
00:20:57,990 --> 00:21:00,240
من أين حصلتِ على هذا الوزن الزائد؟

283
00:21:00,240 --> 00:21:01,930
أكلتُ كثيراً من كرات الأرزّ

284
00:21:01,930 --> 00:21:03,900
أنا آسفة

285
00:21:05,400 --> 00:21:07,870
هكذا إذاً، بدأن بالتحرّك إذاً

286
00:21:07,870 --> 00:21:10,390
لا يتعلّمن أبداً

287
00:21:10,390 --> 00:21:13,480
ماذا نفعل يا رئيس الوزراء؟

288
00:21:13,940 --> 00:21:16,270
لا سبب يدفعنا للتراجع

289
00:21:16,270 --> 00:21:18,390
سنهزمهن بكل ما أوتينا من قوّة

290
00:21:19,080 --> 00:21:21,100
فالعدالة معي

291
00:21:34,400 --> 00:21:36,310
أنتما، حان الوقت

292
00:21:39,430 --> 00:21:40,820
!يا للهول

293
00:21:41,150 --> 00:21:43,570
ما الأمر؟ لماذا أنت مرتعد كثيراً؟

294
00:21:43,840 --> 00:21:45,610
لم يأتِ

295
00:21:48,080 --> 00:21:49,560
أي أحد

296
00:21:52,390 --> 00:21:53,610
من الجمهور

297
00:23:30,010 --> 00:23:32,920
أنا فودو ميزوكي، عضوة مجلس نجمة من طوكيو

298
00:23:30,010 --> 00:23:40,020
الرّسم: إيشي ماي

299
00:23:32,920 --> 00:23:34,670
صدرت الأقراص المضغوطة أخيراً

300
00:23:34,670 --> 00:23:36,250
الحلقة القادمة هي الأخيرة

301
00:23:36,250 --> 00:23:39,430
نحن عضوات المجلس النّجمات سنتألّق حتّى النّهاية