1
00:00:18,310 --> 00:00:20,670
.السّنة 845

2
00:00:20,670 --> 00:00:26,350
،على يديّ العملاقين الضّخم والمدرّع اللّذان ظهرا من العدم

3
00:00:26,350 --> 00:00:30,780
.تحطّمت حياتنا العاديّة كما تحطّم السّور

4
00:00:30,780 --> 00:00:33,570
!توقّف

5
00:00:36,120 --> 00:00:39,270
.هجرت البشريّة سور ماريا

6
00:00:39,810 --> 00:00:42,920
،بعد أن فقدت خُمس سكّانها وثُلث أراضيها

7
00:00:43,620 --> 00:00:48,190
.جعلت حدودها الخارجيّة في سور روز

8
00:00:49,650 --> 00:00:55,410
.لكن، ليس كلّ البشريّة استسلموا للعمالقة

9
00:00:56,370 --> 00:00:59,730
.يواصل حرس المدينة في تعزيز الأسوار

10
00:00:59,730 --> 00:01:06,020
وعديد من أبناء جيلنا الشبّان يسعون ليصبحوا
.جنودًا عبر تدريبهم على فنّ قتل العمالقة

11
00:01:06,910 --> 00:01:09,460
...وفي ذلك الوقت

12
00:01:11,950 --> 00:01:13,600
،في مقاطعة تروست

13
00:01:13,600 --> 00:01:20,770
كان نخبة فيلق الاستطلاع يتأهّبون
.لدخول منطقة العمالقة مرّة أخرى

14
00:01:25,030 --> 00:01:26,970
!تبقّت ثلاثون ثانية على فتح البوّابة

15
00:01:27,690 --> 00:01:29,690
!لتستعدّ كلّ القوّات للانطلاق

16
00:01:31,730 --> 00:01:34,790
...كم أنا متحمّسة

17
00:01:34,790 --> 00:01:35,810
.يا ليفاي

18
00:01:35,810 --> 00:01:37,160
.مستحيل

19
00:01:37,160 --> 00:01:38,810
.لم أقل أيّ شيء بعد

20
00:01:38,810 --> 00:01:42,350
.تريدين منّي أن أساعدك على الإمساك بعملاق

21
00:01:42,350 --> 00:01:44,850
.سيكون ذلك مزعجًا للغاية بالنّسبة لي

22
00:01:46,310 --> 00:01:47,220
ماذا عنك يا ميكي؟

23
00:01:47,220 --> 00:01:48,510
هل ستشارك؟

24
00:01:50,610 --> 00:01:55,240
.إجابات مملّة من رجال مملّين كما العادة

25
00:02:00,210 --> 00:02:03,330
!سنبدأ الآن مهمّتنا الاستطلاعيّة الـ49

26
00:02:04,430 --> 00:02:05,970
!انطلقوا

27
00:02:13,990 --> 00:02:15,970
!مرحى

28
00:02:16,470 --> 00:02:17,180
!هانجي

29
00:02:17,180 --> 00:02:18,970
!أيّتها العمالقة

30
00:02:18,970 --> 00:02:20,640
!أنا آتية للقائك

31
00:04:06,370 --> 00:04:08,500
!انتظر لحظة يا إروين

32
00:04:09,370 --> 00:04:13,880
،أدرك أنّ بناء قاعدة عسكريّة لوجستيّة هي أولى أولويّاتنا الآن

33
00:04:13,880 --> 00:04:19,700
لكنّ كشف طبيعة العمالقة الحقيقيّة
!هي أولى أهداف فيلق الاستطلاع

34
00:04:19,700 --> 00:04:22,390
!تدري ذلك جيّدًا بقدري

35
00:04:22,390 --> 00:04:24,680
...المعذرة يا نقيب الفرقة

36
00:04:27,680 --> 00:04:28,790
!اخرس

37
00:04:28,790 --> 00:04:32,680
!من أجل تحقيق أهدافنا، علينا قطعًا أن نقبض على عملاق

38
00:04:32,680 --> 00:04:35,170
.أعي أنّ كلامي غير معقول

39
00:04:35,170 --> 00:04:39,270
،آخر مرّة أمسكنا بإحداها كانت قبل خمس عشرة سنة

40
00:04:39,270 --> 00:04:42,780
.وفقدنا أكثر من عشرين رجلًا أثناء ذلك

41
00:04:42,780 --> 00:04:46,450
لكن إن كنّا نخاف من فكرة فقدان
!رجالنا، فلن نكسب أيّ معلومات أبدًا

42
00:04:46,800 --> 00:04:49,190
.انقل المزيد من الجنود إلى الخطوط الخلفيّة

43
00:04:49,190 --> 00:04:50,270
.حاضر

44
00:04:50,890 --> 00:04:52,210
،سبق وأخبرتك مرّات لا تحصى

45
00:04:52,830 --> 00:04:55,990
.لا نملك جنودًا متفرّغين للقبض على عملاق

46
00:04:55,990 --> 00:05:00,570
.سبق وفقدنا أكثر من عشرة رجال فقط للوصول إلى هنا

47
00:05:00,570 --> 00:05:02,480
—أدري ذلك، لكن

48
00:05:02,480 --> 00:05:03,760
.هانجي

49
00:05:04,390 --> 00:05:05,760
.إجابتي هي لا

50
00:05:07,270 --> 00:05:08,770
...مـ-مهلًا

51
00:05:09,450 --> 00:05:11,660
!انتظر يا إروين

52
00:05:12,510 --> 00:05:15,270
.ما كان ليقبل ذلك أبدًا يا هانجي

53
00:05:15,670 --> 00:05:19,270
.فقتل تلك الوحوش بحدّ ذاته صعب

54
00:05:19,270 --> 00:05:22,780
.علينا أن نكون خالدين أوّلًا إن كنّا سنحاول القبض على إحداها

55
00:05:24,390 --> 00:05:26,270
...افتراضيًّا

56
00:05:26,270 --> 00:05:29,520
.لنقل على افتراض أنّ ليفاي يحاول قتلك

57
00:05:29,520 --> 00:05:30,730
!يجهز عليك

58
00:05:30,730 --> 00:05:31,710
ماذا كنت لتفعل؟

59
00:05:31,710 --> 00:05:33,810
أيمكنك قتاله وهزيمته؟

60
00:05:33,810 --> 00:05:34,710
.مستحيل

61
00:05:34,710 --> 00:05:36,070
.سيكون ذلك مستحيلًا

62
00:05:36,070 --> 00:05:38,550
.كما أنّني لا أستطيع التنفّس

63
00:05:38,550 --> 00:05:42,430
.دعني أخبرك كيف تفوز

64
00:05:42,430 --> 00:05:44,090
.عليك بالبحث

65
00:05:44,090 --> 00:05:47,100
،أن تكتشف أين يذهب والطّعام الّذي لا يعجبه

66
00:05:47,100 --> 00:05:50,150
.والفتيات المعجب بهنّ وكم يذهب إلى الحمّام في كلّ يوم

67
00:05:50,150 --> 00:05:53,060
.عليك أن تكشف عنه كلّ صغيرة وكبيرة

68
00:05:53,060 --> 00:05:57,020
.حينها يمكنك أن تجد شيئًا تستطيع استغلاله

69
00:05:57,020 --> 00:06:02,410
...إلّم تقاتل بتلك الطّريقة، فحتمًا سوف

70
00:06:02,410 --> 00:06:04,110
.تُقتَل

71
00:06:04,110 --> 00:06:05,270
!هانجي

72
00:06:05,270 --> 00:06:07,580
!يا نقيب الفرقة، أنت تبالغين

73
00:06:11,940 --> 00:06:13,530
.يا ويحي، آسفة

74
00:06:13,530 --> 00:06:15,870
.لكن هذا هو بيت القصيد

75
00:06:15,870 --> 00:06:16,890
!يا نقيب الفرقة

76
00:06:18,590 --> 00:06:21,050
.تبًّا، كادت تقتلني

77
00:06:21,050 --> 00:06:23,980
.يا لها من ساقطة مجنونة

78
00:06:23,980 --> 00:06:25,510
.مجنونة رسميًّا

79
00:06:27,110 --> 00:06:28,190
...هل تدرك

80
00:06:28,190 --> 00:06:33,770
أنّك أحد أفراد فيلق الاستطلاع أيضًا، لذا حاول
أن تتوقّف عن الحديث بجبن على الأقلّ، اتّفقنا؟

81
00:06:33,770 --> 00:06:34,670
ماذا؟

82
00:06:34,670 --> 00:06:36,650
!من أنت لتخبريني بهذا؟

83
00:06:36,650 --> 00:06:39,590
بيترا، هل انتهيت من إعادة التّموين؟

84
00:06:39,590 --> 00:06:41,130
!إلد

85
00:06:41,130 --> 00:06:42,690
!كدتُ أنتهي

86
00:07:10,390 --> 00:07:11,210
!الغابة

87
00:07:11,210 --> 00:07:11,600
!لقد أتت

88
00:07:11,990 --> 00:07:13,810
!ابقوا متيقّظين يا رجال

89
00:07:14,970 --> 00:07:17,650
!يا نقيب الفرقة، من الخطير أن تذهبي لوحدك

90
00:07:18,310 --> 00:07:20,560
!إروين، سأذهب

91
00:07:20,560 --> 00:07:22,170
!انتظري يا هانجي

92
00:07:23,010 --> 00:07:23,480
!ليفاي

93
00:07:23,480 --> 00:07:25,270
.يا لها من غبيّة

94
00:07:33,160 --> 00:07:34,800
!وجدتُ واحدًا

95
00:07:35,710 --> 00:07:38,350
مرحبًا، الطّقس جميل اليوم، أليس كذلك؟

96
00:07:42,040 --> 00:07:43,730
.ولد مطيع

97
00:07:44,490 --> 00:07:49,390
اسمع، هل تريد الذّهاب معي في جولة داخل الأسوار؟

98
00:07:49,390 --> 00:07:50,260
ما رأيك؟

99
00:07:51,410 --> 00:07:52,350
!كان ذلك وشيكًا

100
00:07:54,410 --> 00:07:55,810
...يا إلهي

101
00:07:55,810 --> 00:07:57,230
هل أنت بخير؟

102
00:08:01,730 --> 00:08:03,630
!اتبعني

103
00:08:08,860 --> 00:08:11,740
.حسنًا، ولد مطيع

104
00:08:14,930 --> 00:08:16,750
.من هنا أيّها الأحمق

105
00:08:19,750 --> 00:08:22,250
!مـ-مهلًا، لا تتدخّلوا

106
00:08:26,950 --> 00:08:28,600
.ولد مطيع

107
00:08:28,600 --> 00:08:29,720
.تابع من هنا

108
00:08:35,320 --> 00:08:36,230
ماذا؟

109
00:08:42,830 --> 00:08:43,700
!مهلًا

110
00:08:43,700 --> 00:08:44,950
!انتظر

111
00:08:49,390 --> 00:08:50,260
!مهلًا

112
00:08:50,260 --> 00:08:51,320
إلى أين أنت ذاهب؟

113
00:08:53,820 --> 00:08:56,190
ما الّذي يفعله ذلك الغبيّ؟

114
00:08:56,190 --> 00:08:58,130
أهو عائد لدياره؟

115
00:08:58,130 --> 00:09:00,870
.إنّه يتصرّف بغرابة حتّى بالنّسبة لعملاق شاذّ

116
00:09:00,870 --> 00:09:04,390
.أجل، سلوكه يخالف أيّ ما تمّ التّبليغ عنه حتّى الآن

117
00:09:04,390 --> 00:09:08,650
.لا، مخالفة القوانين هي ما تجعل منه عملاقًا شاذًّا

118
00:09:08,650 --> 00:09:09,840
من يهتمّ؟

119
00:09:11,390 --> 00:09:12,850
.سنقتله

120
00:09:14,510 --> 00:09:16,600
!مهلًا، انتظر

121
00:09:22,930 --> 00:09:25,850
هل يملك وجهة معيّنة؟

122
00:09:25,850 --> 00:09:29,570
قد يكون عملاقًا شاذًّا، لكن هل من الممكن
حقًّا لعملاق أن يتّجه إلى وجهة معيّنة؟

123
00:09:49,460 --> 00:09:50,910
ماذا؟

124
00:09:52,590 --> 00:09:53,970
ما الخطب؟

125
00:09:56,630 --> 00:09:58,760
ماذا تفعل؟

126
00:09:59,910 --> 00:10:01,760
...أهنا حيث

127
00:10:01,760 --> 00:10:04,230
أردتَ الذّهاب؟

128
00:10:09,530 --> 00:10:10,480
!كان ذلك وشيكًا

129
00:10:15,470 --> 00:10:16,670
ماذا؟

130
00:10:16,670 --> 00:10:17,490
ما الخطب؟

131
00:10:17,490 --> 00:10:19,110
.أنا أنصت لك

132
00:10:23,610 --> 00:10:24,250
!الهدف واضح

133
00:10:24,250 --> 00:10:25,500
!أولوو، انتظر

134
00:10:25,830 --> 00:10:26,590
ماذا؟

135
00:10:43,030 --> 00:10:43,750
.سحقًا

136
00:10:46,410 --> 00:10:47,400
هل أنت حيّ؟

137
00:10:48,090 --> 00:10:49,110
...قائد الفريق

138
00:10:51,290 --> 00:10:53,360
!سأخدمك لبقيّة حياتي

139
00:10:54,930 --> 00:10:56,280
...كان ليكون

140
00:10:56,630 --> 00:10:58,710
.عيّنة قيّمة جدًّا

141
00:11:00,450 --> 00:11:05,750
.لو أنّنا استطعنا الإمساك به، لربّما أحرزت البشريّة بعض التقدّم

142
00:11:06,990 --> 00:11:08,710
!أطبقي فمك الغبيّ يا ذات العيون الأربع

143
00:11:08,710 --> 00:11:12,130
.إن كنت تريدين أن تتحوّلي إلى براز عملاق فبادري

144
00:11:12,130 --> 00:11:15,130
!لكن لا تقحمي الرّجال في ذلك

145
00:11:17,750 --> 00:11:19,930
.العمالقة لا تتغوّط

146
00:11:20,360 --> 00:11:22,650
.إذ ليس لديها جهاز هضميّ

147
00:11:32,110 --> 00:11:32,970
...عذرًا

148
00:11:33,810 --> 00:11:34,770
قائد الفريق؟

149
00:11:36,110 --> 00:11:37,550
ماذا؟

150
00:11:37,550 --> 00:11:41,870
هل فعل... العـ-العملاق ذلك؟

151
00:11:43,430 --> 00:11:45,990
...لكن... هذا غير ممكن

152
00:11:45,990 --> 00:11:47,590
عمّ تتحدّثين؟

153
00:12:04,850 --> 00:12:07,520
.شعار البعثة الـ34

154
00:12:07,910 --> 00:12:10,150
.لبثت الجثّة هنا عامًا

155
00:12:10,150 --> 00:12:11,630
...الاسم هو

156
00:12:13,360 --> 00:12:16,190
إيلزي... لانغنار؟

157
00:12:18,030 --> 00:12:19,470
.غير معقول

158
00:12:19,470 --> 00:12:21,150
...بأن يفعل عملاق هذا

159
00:12:22,780 --> 00:12:24,250
ليفاي؟

160
00:12:24,250 --> 00:12:25,250
ما ذلك؟

161
00:12:27,270 --> 00:12:28,420
...هذا

162
00:12:29,300 --> 00:12:32,370
.إرث إيلزي لانغنار

163
00:12:52,830 --> 00:12:55,270
.اسمي إيلزي لانغنار

164
00:12:55,850 --> 00:12:58,780
،شاركتُ في البعثة الاستطلاعيّة الـ34

165
00:12:59,270 --> 00:13:01,770
.كفرد من الفرقة الثّانية في أقصى الرّتبة اليسرى من التّشكيلة

166
00:13:03,710 --> 00:13:06,160
.واجهنا عمالقة في طريق عودتنا

167
00:13:08,310 --> 00:13:11,670
.وفقدتُ حصاني ورفقائي الجنود

168
00:13:11,990 --> 00:13:15,210
.كما أنّني تخلّصتُ من عدّة مناورتي المعطّلة

169
00:13:20,370 --> 00:13:22,990
.إنّي أهرب جهة الشّمال

170
00:13:28,570 --> 00:13:32,870
.فقدتُ حصاني في العالم خارج الأسوار

171
00:13:34,330 --> 00:13:36,750
.لا أستطيع الهرب من العمالقة سيرًا

172
00:13:37,410 --> 00:13:39,090
.وفقدتُ كلّ رفاقي

173
00:13:40,130 --> 00:13:41,450
...وأنا متّجهة إلى الدّيار

174
00:13:42,730 --> 00:13:44,780
.حتّى النّجاة تبدو مستحيلة

175
00:13:46,110 --> 00:13:50,870
.لكن، قد أستطيع الوصول إلى السّور

176
00:13:51,510 --> 00:13:52,620
.هذه خطّتي

177
00:13:52,620 --> 00:13:56,650
.والمفتاح هو عدم الاستسلام للخوف

178
00:13:57,730 --> 00:14:02,470
.كنتُ جاهزةً لهذا لحظة انضممت إلى فرقة الاستطلاع

179
00:14:03,750 --> 00:14:06,570
.أنا جناح البشريّة الّذي لا يهاب الموت

180
00:14:07,090 --> 00:14:09,360
.أنا جنديّ استطلاع

181
00:14:09,360 --> 00:14:13,140
.حتّى إن كانت حياتي منتهية بالفعل، سأقاتل حتّى آخر رمق

182
00:14:14,270 --> 00:14:17,170
!لا أملك أيّ أسلحة، لكن يمكنني القتال

183
00:14:17,750 --> 00:14:19,680
،سأدوّن كلّ لحظة في هذه المفكّرة

184
00:14:19,680 --> 00:14:21,950
.وسأفعل كلّ ما في حولي

185
00:14:23,650 --> 00:14:25,660
.لن أستسلم

186
00:14:25,660 --> 00:14:27,500
...سوف لن

187
00:14:27,500 --> 00:14:28,660
!أستسلم

188
00:14:57,640 --> 00:14:58,300
...سوف

189
00:14:58,790 --> 00:15:00,280
...لن

190
00:15:00,280 --> 00:15:01,490
.أستسلم

191
00:15:02,710 --> 00:15:03,780
.لقد قابلتُ عملاقًا

192
00:15:04,670 --> 00:15:08,240
.من فئة 7— لا، بل فئة 6 أمتار بالأحرى

193
00:15:08,570 --> 00:15:10,590
.لم يأكلني بعد

194
00:15:10,590 --> 00:15:11,770
أهو عملاق شاذّ؟

195
00:15:14,270 --> 00:15:16,030
.أنا أحدّق الآن في وجه الموت

196
00:15:16,990 --> 00:15:18,670
.هذه نهايتي

197
00:15:19,370 --> 00:15:21,650
.عشتُ من أجل نفسي فحسب

198
00:15:21,650 --> 00:15:24,120
.لم أفعل أيّ شيء من أجل والدَيّ بعد

199
00:15:24,120 --> 00:15:25,320
.أشعر بالاشمئزاز

200
00:15:27,190 --> 00:15:28,130
.أنا هالكة

201
00:15:29,110 --> 00:15:36,350
.شعب... يُمير

202
00:15:41,090 --> 00:15:42,360
...لقد

203
00:15:42,360 --> 00:15:43,470
نطق؟

204
00:15:45,070 --> 00:15:47,450
.نطقَ العملاق

205
00:15:48,330 --> 00:15:49,430
.مستحيل

206
00:15:50,610 --> 00:15:53,580
.يمير-ساما

207
00:15:54,870 --> 00:15:56,460
.إنّه شرف

208
00:15:59,590 --> 00:16:01,750
.كانت كلماته منطقيّة

209
00:16:02,350 --> 00:16:04,070
".شعب يمير"

210
00:16:04,070 --> 00:16:05,620
".يمير-ساما"

211
00:16:05,620 --> 00:16:06,770
".إنّه شرف"

212
00:16:07,990 --> 00:16:08,970
.أنا متيقّنة

213
00:16:09,590 --> 00:16:12,220
.لقد تغيّر تعبير هذا العملاق

214
00:16:13,210 --> 00:16:16,510
.إنّه يولي احترامه لي

215
00:16:20,170 --> 00:16:22,160
.غير معقول

216
00:16:22,160 --> 00:16:26,930
.لا بدّ أنّ هذه أوّل مرّة في التّاريخ، يتواصل إنسان مع عملاق

217
00:16:29,290 --> 00:16:33,240
مـ-ما أنت؟

218
00:16:34,310 --> 00:16:36,750
.أسأله عن سبب وجوده

219
00:16:37,750 --> 00:16:39,230
.يئنّ

220
00:16:39,230 --> 00:16:40,650
.لا يردّ

221
00:16:41,250 --> 00:16:42,850
من أين أنت؟

222
00:16:43,570 --> 00:16:44,750
.أسأل عن أصله

223
00:16:46,190 --> 00:16:47,760
.لا إجابة

224
00:16:48,090 --> 00:16:51,490
لمَ تلتهموننا؟

225
00:16:52,090 --> 00:16:53,260
.أسأل عن هدفهم

226
00:16:59,090 --> 00:17:00,770
!لمَ تأكلوننا؟

227
00:17:01,310 --> 00:17:03,730
!لستم بحاجة للأكل كي تعيشوا

228
00:17:04,200 --> 00:17:04,770
!لذا لماذا؟

229
00:17:05,360 --> 00:17:07,710
!ما أنتم سوى كومة لحم عملاقة

230
00:17:07,710 --> 00:17:09,570
!اختفوا من هذا العالم

231
00:17:17,950 --> 00:17:18,990
ماذا؟

232
00:17:30,010 --> 00:17:31,500
ماذا؟

233
00:17:31,500 --> 00:17:32,710
...ما الّذي

234
00:17:35,690 --> 00:17:38,890
!لا

235
00:17:38,890 --> 00:17:40,600
.لقد أمسك بي! انتهى أمري. فم كبير. رائحة نتنة

236
00:17:40,600 --> 00:17:41,760
.أسنان كثيرة. ليست حادّة

237
00:17:41,760 --> 00:17:43,310
—نفس دافئ. الانتظار لوحدي

238
00:18:27,270 --> 00:18:29,070
،إروين سميث-دونو

239
00:18:29,530 --> 00:18:35,390
.أكتب هذه الرّسالة لاقتراح استئناف عمليّة القبض على العمالقة

240
00:18:36,530 --> 00:18:40,890
.آمل أن تتّضح أسبابي عندما تقرأ المفكّرة الّتي أرفقتُ مع الرّسالة

241
00:18:40,890 --> 00:18:43,200
.المفكّرة تخبرنا بشيء واحد ببساطة

242
00:18:43,950 --> 00:18:49,460
.نحن نجهل كلّ شيء عن العمالقة

243
00:18:50,130 --> 00:18:54,910
...العملاق الّذي قابلته إيلزي لانغنار نطق بكلمات ذات مغزى

244
00:18:54,910 --> 00:18:56,890
.وتصرّف معها باحترام

245
00:18:57,950 --> 00:19:01,950
،علاوة على ذلك، لم يلتهم إيلزي بالكامل

246
00:19:01,950 --> 00:19:06,300
.بل خزّن جثّتها في جوف شجرة بدلًا من ذلك

247
00:19:06,300 --> 00:19:08,890
.ذلك هو الافتراض الأكثر احتمالًا

248
00:19:09,750 --> 00:19:16,680
هذه بلا أدنى شكّ المرّة الأولى الّتي تشهد
.فيها البشريّة هذه الظّاهرة عبر التّاريخ

249
00:19:18,470 --> 00:19:25,910
،استخدمت إيلزي كلّ ذرّة من حياتها لكي تحصل على هذه المعلومة

250
00:19:25,910 --> 00:19:28,740
.ومن مسؤوليّتنا أن نستفيد منها

251
00:19:39,600 --> 00:19:45,890
يجب أن نحذو حذوها ولا نكفّ أبدًا
.عن جهودنا لكشف المزيد عن العمالقة

252
00:19:47,050 --> 00:19:49,630
.علينا أن نتابع بإرادتها

253
00:19:55,420 --> 00:19:59,410
،مهما كانت المعلومات الّتي نحصل عليها ضئيلة

254
00:20:00,550 --> 00:20:02,280
.لن تكون عبثًا أبدًا

255
00:20:04,340 --> 00:20:06,500
...بل حتمًا سوف

256
00:20:07,280 --> 00:20:10,290
.تساعدنا لاحقًا في شنّ هجومنا المضادّ

257
00:20:10,870 --> 00:20:12,540
.أؤمن بذلك من صميم قلبي

258
00:20:13,610 --> 00:20:17,000
.نقيب الفرقة الثّانية، هانجي زوي

259
00:20:27,150 --> 00:20:27,890
...عذرًا

260
00:20:28,550 --> 00:20:29,550
...هانجي

261
00:20:30,810 --> 00:20:32,960
هل تتعقّبني؟

262
00:20:32,960 --> 00:20:35,070
.من الجيّد أن يملك المرء هوايةً

263
00:20:36,570 --> 00:20:38,660
...بشأن ذلك اليوم

264
00:20:38,660 --> 00:20:40,050
.أنا آسف

265
00:20:40,050 --> 00:20:43,580
.لولا أنّني أخفقتُ، كنّا أمسكنا بذلك العملاق

266
00:20:43,980 --> 00:20:47,080
.ولو أنّنا فعلنا ذلك، كنّا سنكسب معلومات قيّمة

267
00:20:47,500 --> 00:20:50,540
—في المخطّط الكبير، حياتي لا تعني

268
00:20:54,030 --> 00:20:56,920
.لا، بل أنا من عليه الاعتذار

269
00:20:57,860 --> 00:21:00,340
.كدتُ أتسبّب في مقتلك

270
00:21:01,350 --> 00:21:02,540
.أنا آسفة

271
00:21:03,330 --> 00:21:07,580
.لكن إيّاك أن تقول أبدًا أنّ حياتك لا تعني شيئًا

272
00:21:09,330 --> 00:21:10,480
مفهوم؟

273
00:21:15,320 --> 00:21:15,920
ماذا؟

274
00:21:15,920 --> 00:21:17,700
!هـ-هل أنت بخير؟

275
00:21:17,700 --> 00:21:18,790
!أولوو

276
00:21:18,790 --> 00:21:21,340
!يكفي عبثًا

277
00:21:23,160 --> 00:21:24,370
...صحيح

278
00:21:24,880 --> 00:21:26,660
.أعطى إروين موافقته

279
00:21:28,320 --> 00:21:29,190
حقًّا؟

280
00:21:33,330 --> 00:21:35,530
!أجل

281
00:21:36,690 --> 00:21:37,810
...بعد عشرين يومًا

282
00:21:38,530 --> 00:21:45,140
نجحت نقيب الفرقة هانجي زوي في أوّل
،قبض على عملاق منذ سقوط سور ماريا

283
00:21:45,800 --> 00:21:51,070
.بمساعدة من فرقة القائد ليفاي للعمليّات الخاصّة

284
00:21:52,030 --> 00:21:57,830
،استُخدم في العمليّة طريقة فخّ جديدة من اقتراح هانجي

285
00:21:57,830 --> 00:22:00,860
.ولم يتكبّدوا أيّ خسارة