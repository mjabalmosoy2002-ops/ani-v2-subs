1
00:02:01,060 --> 00:02:06,690
.من ناحية نظرية، كانت مهمّتنا بسيطة نسبيًّا

2
00:02:11,380 --> 00:02:16,010
.أن نعبر من خلال الغابة وأن يرجع الجميع بسلام

3
00:02:16,640 --> 00:02:17,940
...هكذا

4
00:02:17,940 --> 00:02:21,700
.كان يجب أن تسري

5
00:02:39,710 --> 00:02:40,880
،في هذه الغارة

6
00:02:40,880 --> 00:02:45,410
،كانت المهمّة الّتي وُكّلت لنا، سرّيّة التّلاميذ الضبّاط الـ104

7
00:02:45,410 --> 00:02:47,730
،تقضي بأن نقسم كلّ فرقة إلى مفرزتين

8
00:02:55,310 --> 00:02:58,530
.مهمّة بسيطة تغطّي مسافة 80 كلم تقريبًا في الإجمال

9
00:02:59,980 --> 00:03:03,640
.تولّى ماركو قيادة مفرزتنا

10
00:03:03,640 --> 00:03:07,290
.بينما كنتُ أنا المحرّر، المكلّف بتسجيل كلّ حدث

11
00:03:07,840 --> 00:03:14,050
.وكانت المفرزة الثّانية بقيادة توماس، وكانت ميكاسا المحرّر

12
00:03:15,030 --> 00:03:21,550
غادرت كلا المجموعتين مخيّم التّدريب في الوقت ذاته
.وأخذت كلّ منهما طريقًا مختلفًا لتطويل الغابة الهائلة

13
00:03:22,100 --> 00:03:25,350
،وبعد أن تبادلنا المعلومات في وجهتنا

14
00:03:25,350 --> 00:03:30,050
كان علينا أن نعود إلى مخيّم التّدريب
.عبر سلك طريق المجموعة الأخرى

15
00:03:31,050 --> 00:03:32,820
...كان الهدف من التّمرين

16
00:03:33,500 --> 00:03:39,570
.هو أن نرى كم نستطيع أن نظلّ فطنين في أوقات السِّلم

17
00:03:40,380 --> 00:03:42,700
!هذا التّمرين بسيط

18
00:03:43,120 --> 00:03:47,330
.لدرجة أنّ حتّى ديدان أمثالكم سيحسبونه كشرب الماء

19
00:03:47,330 --> 00:03:48,780
!لكنّكم مخطئون

20
00:03:48,780 --> 00:03:51,820
!سواء في فترة الحرب أو فترة السِّلم، يظلّ الجنديّ جنديًّا

21
00:03:51,820 --> 00:03:56,010
!حافظوا دائمًا على أهبتكم للقتال، مهما كان الوضع

22
00:03:56,010 --> 00:03:57,880
!لا تدعوا الملل يتملّككم

23
00:03:57,880 --> 00:04:00,260
!ولا تدعوا طمأنينتكم تلهيكم

24
00:04:00,260 --> 00:04:02,260
!هذا التّمرين هو حرب بذاتها

25
00:04:02,260 --> 00:04:04,460
!لا تنسوا ذلك

26
00:04:04,460 --> 00:04:05,770
!حاضر سيّدي

27
00:04:08,590 --> 00:04:09,270
...إذًا

28
00:04:09,660 --> 00:04:12,610
من الأفضل ألّا نجعل الأحصنة تركض سريعًا، صحيح؟

29
00:04:12,950 --> 00:04:14,490
...أظنّ ذلك

30
00:04:14,490 --> 00:04:17,620
.ستبدو بمظهر الغبيّ إن عجّلتَ أرهقتَ حصانك

31
00:04:17,620 --> 00:04:19,610
.لنتروَّ فحسب

32
00:04:19,970 --> 00:04:22,170
.لا أدري كيف أتروّى

33
00:04:22,170 --> 00:04:26,200
.جان، إن كنت ستجعل حصانك يركض بسرعة الحلزون، سأتقدّم

34
00:04:26,200 --> 00:04:28,390
!مهلًا يا إرين، انتظر

35
00:04:28,390 --> 00:04:31,230
...لكنّنا بحاجة لإتمام هذا كمجموعة

36
00:04:31,230 --> 00:04:32,460
ما العمل يا جان؟

37
00:04:32,460 --> 00:04:34,110
.لا أهتمّ

38
00:04:34,110 --> 00:04:37,340
ليس وكأنّني سأنضمّ إلى الشّرطة
.العسكريّة إن اتّخذتَ هذا الأمر بجدّيّة

39
00:04:37,670 --> 00:04:40,020
...لا تدري ذلك

40
00:04:40,020 --> 00:04:42,180
.على أيّ حال، لنركّز على التّمرين فحسب حاليًّا

41
00:04:42,500 --> 00:04:43,300
.لا

42
00:04:43,300 --> 00:04:45,750
.مهلًا، ما زال الوقت مبكّرًا على الاستسلام

43
00:04:45,750 --> 00:04:47,890
.كفّ عن التصرّف كالأطفال

44
00:04:47,890 --> 00:04:50,070
أليس مسموحًا لنا حتّى التذمّر الآن؟

45
00:04:50,070 --> 00:04:53,690
.لا بأس إن كان التذمّر يسرّع الوقت

46
00:04:53,690 --> 00:04:55,540
...معك حقّ

47
00:04:55,540 --> 00:04:57,440
.الطّريق أمامنا طويل

48
00:04:59,590 --> 00:05:01,700
.يا للإزعاج

49
00:05:02,980 --> 00:05:06,170
.لكن إن ذهبنا من ذلك الاتّجاه، قد لا نصل قبل المغيب

50
00:05:06,170 --> 00:05:08,950
إذًا، ما رأيكم أن نأخذ طريقًا أسهل؟

51
00:05:08,950 --> 00:05:12,140
.المشكل هو أنّ ذلك الطّريق غير محميّ من الشّمس

52
00:05:17,990 --> 00:05:19,670
ما الخطب يا ميكاسا؟

53
00:05:23,010 --> 00:05:24,430
...لا شيء

54
00:05:24,430 --> 00:05:25,990
.تنتابني الشّكوك فحسب

55
00:05:31,420 --> 00:05:35,100
...تبًّا، حتّى أنّ سحليّة أصبحت رفيقة سفرنا

56
00:05:35,580 --> 00:05:37,990
.لا نرى السّحالي كثيرًا

57
00:05:37,990 --> 00:05:39,290
.إنّها شهيّة حقًّا

58
00:05:39,290 --> 00:05:39,980
ماذا؟

59
00:05:39,980 --> 00:05:41,540
!إنّها كذلك

60
00:05:41,540 --> 00:05:44,070
.كنّا نأكلها طوال الوقت في الدّيار

61
00:05:44,070 --> 00:05:45,990
.مذاقها يشبه مذاق الدّجاج قليلًا

62
00:05:46,470 --> 00:05:48,460
أتعرفين كيف تُطبخ؟

63
00:05:48,460 --> 00:05:49,950
!أكيد

64
00:05:49,950 --> 00:05:51,540
.ذلك سهل

65
00:05:51,540 --> 00:05:53,000
!حسنًا إذًا

66
00:05:55,040 --> 00:05:56,080
!مـ-مهلًا

67
00:05:56,580 --> 00:06:00,750
إن كانوا سيرسلوننا في رحلة صيد
!مجيدة، فلا صيد يضاهي صيد السّحالي

68
00:06:01,180 --> 00:06:02,910
!توقّف

69
00:06:02,910 --> 00:06:04,170
.سألاحقه

70
00:06:13,990 --> 00:06:15,270
!نلت منك

71
00:06:22,420 --> 00:06:23,310
ما الّذي تفعله؟

72
00:06:23,310 --> 00:06:24,650
!هذه ليست لعبة

73
00:06:25,020 --> 00:06:29,180
!تمرين دون مدرّب لن يكسب لنا أيّ ثناء

74
00:06:29,180 --> 00:06:30,440
!توقّف

75
00:06:30,440 --> 00:06:32,040
.كفّ عن التصرّف كالأطفال

76
00:06:32,570 --> 00:06:34,470
!أنت آخر من يتكلّم

77
00:06:34,470 --> 00:06:36,480
.جان! تحمّل فحسب

78
00:06:36,480 --> 00:06:38,170
ولمَ عساي؟

79
00:06:38,170 --> 00:06:41,820
.إن وصلنا متأخّرين، فسنحتاج للتّبليغ عن كلّ هذا

80
00:06:41,820 --> 00:06:44,170
.أرمين، لا تسجّل أيًّا من هذا بعد رجاءً

81
00:06:44,170 --> 00:06:45,420
.أ-أكيد

82
00:06:46,110 --> 00:06:52,420
سجّل فقط أنّ جان كيرشتاين أعيق
.من قبل إرين ييغر بينما كان يصطاد

83
00:06:52,420 --> 00:06:53,180
!ماذا؟

84
00:06:53,180 --> 00:06:54,390
!إنّها لذيذة جدًّا

85
00:07:05,520 --> 00:07:06,620
.هيّا

86
00:07:07,440 --> 00:07:08,720
.حسنًا

87
00:07:12,420 --> 00:07:16,290
...كان يمكن أن نطعم المجموعة بأكملها بسحليّة بذلك الحجم

88
00:07:20,190 --> 00:07:21,400
هل أنت واثقة؟

89
00:07:21,400 --> 00:07:22,780
.لا شكّ في ذلك

90
00:07:22,780 --> 00:07:26,670
.وضعتها هنا. لكنّي لم أجدها عندما أتيت لأخذها

91
00:07:26,670 --> 00:07:29,500
...عدّة مناورتنا ثلاثيّة الأبعاد

92
00:07:30,390 --> 00:07:31,340
...مهلًا

93
00:07:37,440 --> 00:07:39,440
.أيّ من كان هنا قد رحل منذ وقت طويل

94
00:07:40,000 --> 00:07:42,300
.رأيت أحدًا آخر هناك

95
00:07:42,300 --> 00:07:44,040
.هذا يكشف لنا أعدادهم

96
00:07:44,040 --> 00:07:45,440
...وأيضًا

97
00:07:45,860 --> 00:07:46,970
.انظروا هناك

98
00:07:48,070 --> 00:07:49,510
...مسارات عربة

99
00:07:49,510 --> 00:07:51,250
.وأكثر من مجموعة

100
00:07:51,250 --> 00:07:54,630
.لم ينوّهونا عن عيش أيّ أحد هنا

101
00:07:56,000 --> 00:07:57,500
.لا بدّ أنّهم قطّاع طرق

102
00:07:58,520 --> 00:08:02,890
سمعتُ قصصَا عن عصابات يسرقون معدّات
.عسكريّة ويبيعونها في السّوق السّوداء

103
00:08:02,890 --> 00:08:05,930
.عدّات المناورة ثلاثيّة الأبعاد تدرّ بأرباح طائلة

104
00:08:05,930 --> 00:08:07,420
هل تقصد أنّهم يستهدفوننا؟

105
00:08:08,630 --> 00:08:11,480
.لو أنّهم رأونا، لربّما هاجمونا

106
00:08:12,160 --> 00:08:14,930
.يجب أن نعتبر أنفسنا محظوظين لكوننا أحياء

107
00:08:15,770 --> 00:08:19,360
هل تظنّون أنّه من الأفضل أن نلغي التّمرين ونبلّغ القاعدة؟

108
00:08:19,360 --> 00:08:22,010
.لا، نحن قريبون من هدفنا

109
00:08:22,010 --> 00:08:26,940
.ينبغي أن نذهب إلى هناك ونبلغ مجموعة ماركو قبل أن نعود

110
00:08:40,400 --> 00:08:43,060
.هذه الحصص الغذائيّة مبتذلة جدًّا

111
00:08:43,060 --> 00:08:46,140
.كان يجب أن نصطاد تلك السّحالي

112
00:08:46,140 --> 00:08:48,500
.انسي ذلك الآن. السّحالي غبيّة

113
00:08:48,500 --> 00:08:50,550
.أنت من راح يطاردها

114
00:08:54,180 --> 00:08:57,260
.ذلك أعقل من ملاحقة العمالقة

115
00:08:57,640 --> 00:08:59,390
ماذا تقصد؟

116
00:08:59,390 --> 00:09:01,960
!لمَ انضممت إلى فيلق التّدريب؟

117
00:09:01,960 --> 00:09:05,620
.دعني أخبرك على الأقل أنّني لم أوافق على إهدار حياتي

118
00:09:05,620 --> 00:09:06,690
!ماذا قلت؟

119
00:09:06,710 --> 00:09:08,610
!هناك ما لا يجوز الكلام عنه

120
00:09:08,610 --> 00:09:09,540
...عذرًا

121
00:09:09,540 --> 00:09:11,310
.ا-انس الأمر فحسب يا أرمين

122
00:09:11,310 --> 00:09:13,280
.إنّها محادثة عشاء خفيفة فحسب

123
00:09:14,520 --> 00:09:18,860
هل رؤيتك للعمالقة مباشرةً زادت من
لهفتك لخوض مثل هذه التّمارين الغبيّة؟

124
00:09:18,860 --> 00:09:19,660
—تها

125
00:09:19,660 --> 00:09:21,210
!أطبق فمك

126
00:09:21,210 --> 00:09:22,340
!توقّفا

127
00:09:22,340 --> 00:09:25,090
!لنذهب لصيد سحليّة

128
00:09:23,350 --> 00:09:25,090
!بل أطبق فمك أنت

129
00:09:25,090 --> 00:09:26,830
!لم ترق لي قطّ من البداية

130
00:09:25,090 --> 00:09:27,630
.سيحلّ ذلك كلّ شيء بالتّأكيد

131
00:09:26,830 --> 00:09:27,620
!أنا من يجب أن يقول ذلك

132
00:09:27,620 --> 00:09:28,940
!بل أنا

133
00:09:28,940 --> 00:09:30,440
!لا تجيد سوى الكلام

134
00:09:30,440 --> 00:09:30,930
!دعني

135
00:09:30,930 --> 00:09:32,750
!ليس وكأنّك تستطيع فعل أيّ شيء على أيّ حال

136
00:09:32,610 --> 00:09:34,100
!يا رفاق

137
00:09:32,750 --> 00:09:34,100
!وما الّذي تستطيع أنت فعله؟

138
00:09:34,100 --> 00:09:36,020
!أكثر ممّا تستطيع أنت فعله

139
00:09:36,020 --> 00:09:36,900
.اخرس

140
00:09:37,220 --> 00:09:38,700
.ستمزّقه أيّها الحقير

141
00:09:38,700 --> 00:09:39,850
!رفاق

142
00:09:39,850 --> 00:09:41,770
!توقّفا أنتما الاثنان

143
00:09:40,650 --> 00:09:41,770
!دعني

144
00:09:41,770 --> 00:09:44,170
!أظنّ أنّ علينا الذّهاب لاصطياد بعض السّحالي حقًّا

145
00:09:44,170 --> 00:09:46,020
!بل دعني أنت

146
00:10:35,360 --> 00:10:36,740
.لا تتحرّك

147
00:10:39,480 --> 00:10:42,140
.اجمعوا كلّ عدّات المناورة ثلاثيّة الأبعاد

148
00:10:42,850 --> 00:10:44,410
.وبسرعة

149
00:10:49,730 --> 00:10:51,670
ماذا ستفعلون بها؟

150
00:10:52,160 --> 00:10:55,920
.هناك من يريدها وسنبيعها لهم

151
00:10:56,720 --> 00:10:59,940
.ليس وكأنّكم تستطيعون هزيمة العمالقة

152
00:10:59,940 --> 00:11:02,930
لذا ما الضّير في الاستفادة من معدّات بلا نفع بصورة أفضل؟

153
00:11:09,100 --> 00:11:10,610
!الآن يا رفاق

154
00:11:11,010 --> 00:11:12,020
!إرين

155
00:11:26,010 --> 00:11:30,020
.لا تزعجوا أنفسكم بالمقاومة حتّى. استسلموا واخرسوا فحسب

156
00:11:54,440 --> 00:11:57,950
.لا نخطّط لقتلها. سنطلق سراحها في طريقنا

157
00:11:57,950 --> 00:12:01,300
.لكن إن لاحقتمونا، فلن نتردّد في قتلها

158
00:12:01,300 --> 00:12:02,300
مفهوم؟

159
00:12:14,510 --> 00:12:16,040
...لو أنّكم

160
00:12:17,930 --> 00:12:21,300
!لو أنّكم تصرّفتم جميعًا عندما نبّهتكم، لربّما استطعنا فعل شيء

161
00:12:26,120 --> 00:12:28,640
.هذا رأيك فحسب

162
00:12:28,640 --> 00:12:30,140
.لا أوافقك

163
00:12:30,580 --> 00:12:34,120
.في الواقع، أفعالك الطّائشة عرّضت الجميع إلى الخطر

164
00:12:37,570 --> 00:12:39,450
.سنلغي التّمرين

165
00:12:39,450 --> 00:12:40,970
.هذا للأفضل

166
00:12:40,970 --> 00:12:43,020
هل سنتخلّى عن كريستا ببساطة؟

167
00:12:45,850 --> 00:12:47,520
.الأمر ليس كذلك إطلاقًا

168
00:12:47,520 --> 00:12:50,300
.لا يمكننا فعل أيّ شيء لوحدنا

169
00:12:50,300 --> 00:12:52,250
.علينا انتظار أوامر المعلّم

170
00:12:52,250 --> 00:12:53,420
وإن كان الأوان قد فات حينها؟

171
00:12:55,250 --> 00:12:57,870
!لن أترك هذا الأمر

172
00:12:57,870 --> 00:12:59,670
!سأنقذها

173
00:13:00,950 --> 00:13:02,680
!وسأذهب لوحدي إن اضطررت

174
00:13:03,390 --> 00:13:04,180
...إرين

175
00:13:04,180 --> 00:13:08,300
.قالت أنّها أحبّتني من صميم قلبها

176
00:13:06,330 --> 00:13:07,040
!إرين

177
00:13:07,040 --> 00:13:08,090
!توقّف

178
00:13:10,430 --> 00:13:13,080
.وحلمنا بحياة جديدة

179
00:13:11,280 --> 00:13:14,200
ما عدنا نملك حتّى وسيلة نقلنا. فكيف ستتعقّبهم؟

180
00:13:13,080 --> 00:13:17,440
.مكان نكون فيه بسلام

181
00:13:14,200 --> 00:13:15,940
!هذا لا يهمّ

182
00:13:16,360 --> 00:13:18,690
!بالطّبع يهمّ! سأذهب معك

183
00:13:17,440 --> 00:13:21,980
،لكنّ الأحوال تغيّرت. فجأةً

184
00:13:21,890 --> 00:13:26,240
.أريد أن أردّ لهم الصّاع أيضًا

185
00:13:23,320 --> 00:13:28,820
.فقدت حلمي في هذه الفاجعة

186
00:13:30,580 --> 00:13:32,960
،أنا أبكي

187
00:13:31,830 --> 00:13:32,960
...رفاق

188
00:13:32,960 --> 00:13:36,340
.وأشتاق لمحبوبتي

189
00:13:36,340 --> 00:13:40,640
...أنا عاجز

190
00:13:40,640 --> 00:13:44,660
.في جانبي إلى الأبد

191
00:13:44,660 --> 00:13:49,640
آه أين هي محبوبتي؟

192
00:13:47,560 --> 00:13:48,970
...لكنّه محقّ

193
00:13:49,640 --> 00:13:54,580
.وأنا عاجز

194
00:13:50,160 --> 00:13:51,820
كيف سنتعقّبهم؟

195
00:13:51,820 --> 00:13:55,580
.يمكننا أن ننفصل، لكن هناك حدّ للمسافة الّتي يمكن أن نغطّيها

196
00:13:54,580 --> 00:14:02,080
،أنا أقف لوحدي، بلا سبيل

197
00:13:55,580 --> 00:13:57,360
،في مثل هذه الأوضاع

198
00:13:57,930 --> 00:14:00,280
!علينا أن نكسب منظورًا أعلى

199
00:14:01,390 --> 00:14:04,130
".إن تهت في الجبل، تسلّقه"

200
00:14:02,080 --> 00:14:08,380
.أنادي باسمك

201
00:14:04,130 --> 00:14:07,560
".إن تهت في غابة، تسلّق شجرة طويلة"

202
00:14:07,560 --> 00:14:09,890
.هذه نصائح أبي

203
00:14:10,890 --> 00:14:11,870
!انظروا

204
00:14:16,330 --> 00:14:18,380
!سنتحرّك بمجرّد أن ننتهي من الشّحن

205
00:14:19,280 --> 00:14:20,000
!بادروا

206
00:14:20,500 --> 00:14:21,390
ما العمل؟

207
00:14:21,390 --> 00:14:22,780
.يمكننا أن نباغتهم فحسب

208
00:14:22,780 --> 00:14:24,680
.لديهم مسدّسات

209
00:14:24,680 --> 00:14:26,510
.سيقضون علينا

210
00:14:26,510 --> 00:14:28,120
.لديّ خطّة

211
00:14:30,440 --> 00:14:33,130
.إنّهم بحاجة لبيع بضاعتهم المسروقة

212
00:14:33,130 --> 00:14:36,270
.وأقرب مكان لفعل ذلك هي بلدة أوديل

213
00:14:36,690 --> 00:14:39,330
.علينا أن نسبقهم إلى هناك ونباغتهم

214
00:14:39,330 --> 00:14:41,740
وهل سنهزمهم هناك دون أحصنة؟

215
00:14:41,740 --> 00:14:43,750
.أوديل؟ لا ينبغي أن تكون مشكلة

216
00:14:43,750 --> 00:14:45,780
.يمكننا أن نعبر من خلال الغابة

217
00:14:47,500 --> 00:14:49,220
!مرحى

218
00:15:01,350 --> 00:15:04,760
.في الجانب الآخر من الغابة، ينقسم الطّريق إلى طريقين

219
00:15:04,760 --> 00:15:10,760
إحداهما يؤدّي مباشرةً إلى أوديل، لذا
.إن سلكوا ذلك الطّريق، فلا نملك فرصة

220
00:15:11,340 --> 00:15:12,510
...إذًا

221
00:15:13,690 --> 00:15:14,520
.لقد أتوا

222
00:15:14,520 --> 00:15:16,440
!حسنًا

223
00:15:31,900 --> 00:15:34,350
،على افتراض أنّ كلّ شيء سار وفق الخطّة

224
00:15:34,350 --> 00:15:38,590
ما زال علينا أن نعرف في أيّ عربة
.توجد كريستا وعدّات المناورة ثلاثيّة الأبعاد

225
00:15:38,590 --> 00:15:39,950
كيف نعرف ذلك؟

226
00:15:39,950 --> 00:15:42,710
.سنعرف عندما نسمع صوت العربات

227
00:15:45,530 --> 00:15:47,590
.إن كانت عدّتنا في العربة الأولى، رنّة واحدة

228
00:15:48,220 --> 00:15:49,650
.وإن كانت في العربة الخلفيّة، رنتّان

229
00:15:50,370 --> 00:15:52,200
.وإن كانت في كلتاهما، سأرنّ ثلاث مرّات

230
00:16:17,110 --> 00:16:18,620
...وحينها سوف

231
00:16:19,030 --> 00:16:19,870
!نهاجم

232
00:16:23,110 --> 00:16:25,000
!مـ-من أنتم؟

233
00:16:29,160 --> 00:16:30,530
ما الّذي يجري؟

234
00:16:31,780 --> 00:16:32,720
!أيّها الوغد

235
00:16:36,310 --> 00:16:37,190
!ما الّذي تفعله؟

236
00:16:37,190 --> 00:16:40,280
!ما تفعلونه طوال الوقت أيّها الأوغاد

237
00:16:41,270 --> 00:16:43,020
!أيّها الأنذال

238
00:16:43,980 --> 00:16:45,320
!مـ-مهلًا

239
00:16:54,350 --> 00:16:55,280
.سحقًا

240
00:16:55,590 --> 00:16:56,950
!لن أخطئ هذه المرّة

241
00:16:56,950 --> 00:16:58,160
!لا

242
00:16:59,380 --> 00:17:00,160
!كريستا

243
00:17:00,160 --> 00:17:01,790
.أيّتها الحقيرة

244
00:17:20,370 --> 00:17:21,190
هل أنت بخير؟

245
00:17:21,190 --> 00:17:22,060
.أجل

246
00:17:22,060 --> 00:17:23,460
.بطريقة ما

247
00:17:23,460 --> 00:17:24,150
!جان

248
00:17:24,150 --> 00:17:25,360
!إرين

249
00:17:25,690 --> 00:17:26,830
.نحن بخير

250
00:17:26,830 --> 00:17:28,500
.وكذلك عدّات مناورتنا

251
00:17:28,500 --> 00:17:30,070
...لكنّ كريستا لا تزال

252
00:17:31,620 --> 00:17:32,820
!سنلاحقهم

253
00:17:35,650 --> 00:17:37,900
ساشا، هل لديك شعلة؟

254
00:17:37,900 --> 00:17:40,450
...أ-أجل، لكن

255
00:17:42,070 --> 00:17:43,460
أيمكنني إطلاقها رجاءً؟

256
00:17:47,910 --> 00:17:49,970
...ذلك الفتى الغبيّ

257
00:17:49,970 --> 00:17:51,800
!أخبرتك أن تبتعدي عنّي

258
00:17:56,580 --> 00:17:58,760
!لا تقتلها! سندرّ بعض الأرباح منها

259
00:18:01,810 --> 00:18:03,860
هكذا الأمر إذًا؟

260
00:18:04,880 --> 00:18:09,270
.بفضل أصدقائك الصّغار، أحبط هذا الأمر بأكمله

261
00:18:10,000 --> 00:18:13,280
.وستتحمّلين مسؤوليّة ذلك بنفسك

262
00:18:27,830 --> 00:18:29,170
!سحقًا

263
00:19:14,280 --> 00:19:16,720
!تراجعوا! أسقطوا أسلحتكم

264
00:19:20,330 --> 00:19:23,100
!سلّموا لنا عدّات مناورتكم دون مناقشة

265
00:19:23,100 --> 00:19:24,270
!حالًا

266
00:19:36,670 --> 00:19:38,950
.تبًّا. هذا ليس مضحكًا

267
00:19:39,750 --> 00:19:41,990
.لا أصدّق أنّني أفعل هذا

268
00:19:41,990 --> 00:19:43,700
،نجوتُ من غزو العمالقة

269
00:19:44,140 --> 00:19:47,840
.لكنّي لا أستطيع زراعة أيّ شيء في هذه القفار

270
00:19:47,840 --> 00:19:52,910
...وأنا الّذي أخبرت ابنتي ألّا تكون عبئًا أبدًا على غيرها

271
00:19:56,050 --> 00:19:57,010
!بادروا

272
00:19:59,340 --> 00:19:59,970
ماذا؟

273
00:20:01,000 --> 00:20:01,590
!ميكاسا

274
00:20:03,540 --> 00:20:04,850
!لا تقتليه

275
00:20:12,440 --> 00:20:13,360
.حسنًا

276
00:20:17,590 --> 00:20:19,550
هل أنتم بخير؟

277
00:20:38,970 --> 00:20:43,510
،ألقت الشّرطة العسكريّة القبض على قطّاع الطّرق

278
00:20:43,940 --> 00:20:48,360
.وانتهت الحادثة دون أيّ خسارة واحدة

279
00:20:51,450 --> 00:20:57,420
.تمّ إلغاء التّمرين، لكن كان يجب تسليم سجلّ للأحداث

280
00:20:57,420 --> 00:21:01,610
.احتوى التّقرير على الحقيقة دون سواها

281
00:21:02,620 --> 00:21:05,410
أيمكنني أن أسأل... سؤالًا؟

282
00:21:06,000 --> 00:21:07,130
ما الأمر؟

283
00:21:07,990 --> 00:21:14,800
أكان يجب أن نتراجع لحظة نهبوا عدّات مناوراتنا؟

284
00:21:14,800 --> 00:21:16,010
...أم

285
00:21:16,010 --> 00:21:18,800
أكانت ملاحقتنا لقطّاع الطّرق صحيحة؟

286
00:21:19,900 --> 00:21:22,140
.لا أرى سببًا للإجابة عن ذلك

287
00:21:22,140 --> 00:21:22,720
...لكن

288
00:21:24,310 --> 00:21:26,970
،كجنديّ وإنسان

289
00:21:27,870 --> 00:21:32,320
.سآخذ الخيار الأصعب

290
00:21:32,320 --> 00:21:36,150
...العودة إلى القاعدة أو مطاردة قطّاع الطّرق

291
00:21:36,150 --> 00:21:39,980
أيّهما الخيار الصّعب يا أرليرت؟

292
00:21:40,340 --> 00:21:42,430
...فـ-في الواقع

293
00:21:43,500 --> 00:21:45,430
.لم أستطع الإجابة عليه

294
00:21:46,220 --> 00:21:51,340
...ربّما كلّ ما حدث في الغابة

295
00:21:51,340 --> 00:21:55,600
.كان جزءًا من التّمرين في النّهاية

296
00:21:58,140 --> 00:22:01,130
.ما كان يجب أن أتولّى القيادة

297
00:22:01,130 --> 00:22:02,540
حقًّا؟

298
00:22:02,540 --> 00:22:04,940
.ظننت أنّك قائدًا جيّدًا

299
00:22:04,940 --> 00:22:08,390
.لا، لا أبرع في القيادة

300
00:22:09,020 --> 00:22:10,870
.جان أنسب لذلك الشّيء

301
00:22:10,870 --> 00:22:12,400
!جان؟

302
00:22:12,400 --> 00:22:14,140
.أخالفك الرّأي

303
00:22:15,810 --> 00:22:17,400
.سترى ذلك يومًا ما

304
00:22:17,400 --> 00:22:20,020
.أشكّ في ذلك

305
00:22:21,520 --> 00:22:25,330
.أتساءل أيّ جنود سنصبح جميعًا

306
00:22:32,730 --> 00:22:35,990
.كان العام 848

307
00:22:36,630 --> 00:22:41,230
.قبل سنتين من بعثتنا الأولى