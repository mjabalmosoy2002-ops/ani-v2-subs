1
00:00:03,810 --> 00:00:09,280
لأجيال، خدمت عائلتي كحُرّاس للملك

2
00:00:06,310 --> 00:00:09,820
كاناغي

3
00:00:10,440 --> 00:00:12,280
أنا، الحارس التّالي؟

4
00:00:12,900 --> 00:00:14,780
ماذا حلّ لأختي؟

5
00:00:15,450 --> 00:00:17,870
اليوم الّذي كان من المُفترض أن
،تتبوّأ أختي فيه دور الحارس

6
00:00:17,870 --> 00:00:19,620
لم تحضر إلى البرج

7
00:00:20,370 --> 00:00:22,080
لا أعرف السّبب

8
00:00:24,170 --> 00:00:26,380
،للتكفير عن خطيئة ريرا

9
00:00:26,790 --> 00:00:29,090
ستصبحين الحارس الّذي يحمي الملك

10
00:00:31,420 --> 00:00:33,970
أقبل بكلّ احترام

11
00:00:34,590 --> 00:00:36,590
حينئذ اكتشفتُ لأوّل مرّة

12
00:00:36,590 --> 00:00:41,430
بأنّ الحُرّاس يؤسَرون للأبد داخل
البرج لخدمة الملك

13
00:00:42,100 --> 00:00:44,980
،كنتُ متأكّدة بأنّ أختي نفرت من ذلك

14
00:00:44,980 --> 00:00:47,560
وكانت قد لاذت بالفرار لتتركني كبديلة لها

15
00:00:48,310 --> 00:00:52,900
كنتُ في تلك اللّحظة قد تخلّصتُ
من أيّ مشاعر تجاهها

16
00:00:54,820 --> 00:00:56,200
...ومع ذلك، الآن

17
00:00:57,030 --> 00:00:59,830
لماذا أنتِ هنا يا أختي؟

18
00:01:00,030 --> 00:01:03,080
ألم تتخلِّي عن عائلتنا... وعنّي؟

19
00:01:03,200 --> 00:01:06,620
لماذا تريدين مقاتلة هيغوما-ساما؟

20
00:01:07,370 --> 00:01:10,500
تعالي وواجهيني إذاً يا ريرا كاناغي

21
00:01:11,170 --> 00:01:13,960
ها أنا ذي. دوري

22
00:01:14,970 --> 00:01:18,470
‏‏#20 عالم مُتصدِّع

23
00:01:19,890 --> 00:01:22,930
استخدام إيفاري لمهاجمة حيواتكِ

24
00:01:29,980 --> 00:01:33,780
والآن 6 حيوات ضدّ 9، ورقعتها قد مُسِحت أيضاً

25
00:01:33,780 --> 00:01:35,950
لم أكن أعلم بأنّ هيغوما بهذه القوّة

26
00:01:36,490 --> 00:01:40,780
بتبديل الجسد، يبدو أنّه اكتسب قوّة أكبر

27
00:01:40,990 --> 00:01:42,120
أختي

28
00:01:42,540 --> 00:01:45,450
لست الوحيد الّذي اكتسب قوّة

29
00:01:45,960 --> 00:01:47,460
!انظر

30
00:01:47,830 --> 00:01:50,380
الأجنحة التي تبسطها تمتلك قوّة الحياة والموت

31
00:01:50,380 --> 00:01:52,960
كوني المنقار والمخالب الّتي تقود الهجوم

32
00:01:52,960 --> 00:01:54,210
قبول

33
00:01:54,760 --> 00:01:59,050
كاميليا، سيّدة التّنانين التّسعة

34
00:02:03,260 --> 00:02:05,560
مستوطنة. نشوء بناء

35
00:02:15,320 --> 00:02:17,400
العنقاء الأزرق، سيهو

36
00:02:18,860 --> 00:02:21,990
هذه أجنحتي الجديدة

37
00:02:22,660 --> 00:02:25,580
تفعيل قدرة كاميليا. الكشّاف ثلاثة

38
00:02:26,080 --> 00:02:27,750
نقل ورقتين إلى قمّة مجموعة أوراقي

39
00:02:28,000 --> 00:02:31,710
والآن سأريح كاميليا وأفعّل قدرتها

40
00:02:31,830 --> 00:02:35,670
سألعب ببطاقات كوماندو ب.س.آي
في يدي مهما كلّف الأمر

41
00:02:36,130 --> 00:02:38,590
كوماندو. رايهو، صاروخ التحكّم عن بُعد

42
00:02:39,630 --> 00:02:41,970
إلحاق 12.000 من الضّرر بإيفاري

43
00:02:46,520 --> 00:02:49,940
بالإضافة إلى ذلك، استخدام قدرة
،العنقاء الأزرق سيهو

44
00:02:49,940 --> 00:02:54,730
كلّ بطاقات كوماندو ب.س.آي بكلفة تزيد عن
ثلاثة ستنشئ وحدة عندما يتمّ حلّها

45
00:02:55,150 --> 00:02:57,900
اظهري أمامي يا وحدة ب.س.آي

46
00:03:00,990 --> 00:03:02,280
!حلّق

47
00:03:12,540 --> 00:03:14,170
كم هذا مُثير للشفقة

48
00:03:14,750 --> 00:03:18,550
،ليتكِ خدمتِ الملك كفتاة مُطيعة

49
00:03:18,550 --> 00:03:22,640
كان بمقدوركِ أن تكوني مفيدة لهذه المدينة

50
00:03:27,350 --> 00:03:28,310
اصمت

51
00:03:28,310 --> 00:03:30,060
هجوم بواسطة بريت

52
00:03:33,560 --> 00:03:34,900
زناد الطلقة

53
00:03:34,900 --> 00:03:36,610
جيند، مدفع التحكّم عن بُعد

54
00:03:36,650 --> 00:03:38,730
!دمّر بارفينير

55
00:03:41,450 --> 00:03:45,780
غير معقول. إنّها أقوى حتّى الآن
ممّا كانت عليه عندما قاتلتُها

56
00:03:46,200 --> 00:03:49,540
هل تخلّت عنك ريرا حقّاً؟

57
00:03:50,410 --> 00:03:51,750
...في الواقع

58
00:03:51,750 --> 00:03:53,960
لا يبدو الأمر كذلك بالنسبة لي

59
00:03:53,960 --> 00:04:00,460
لا أعرف السّبب، لكن قسَمها لهزيمة
هيغوما-ساما، لا بل هيغوما

60
00:04:00,460 --> 00:04:02,550
يجعلها أقوى

61
00:04:04,050 --> 00:04:07,050
رينبو. أنا آسفة على كلّ شيء

62
00:04:07,510 --> 00:04:08,720
أختي

63
00:04:09,100 --> 00:04:12,270
لكن ينبغي أن تكوني قد عرفتِ الآن

64
00:04:14,440 --> 00:04:19,780
كنّا حرّاساً بالاسم فقط. استعبدَ
هيغوما عائلتنا طوال هذا الوقت

65
00:04:20,400 --> 00:04:22,490
،اليوم الّذي كنتُ سأتبوّأ فيه مركزي كحارسة

66
00:04:22,490 --> 00:04:25,950
كنتُ سأهزمه وأضع حدّاً لكلّ ذلك

67
00:04:26,490 --> 00:04:27,660
...لكن

68
00:04:30,660 --> 00:04:34,250
هذه عقوبتك لتخلّيك عن مهمّتك

69
00:04:34,250 --> 00:04:36,670
...قوّتك السحريّة المُتألّقة هذه

70
00:04:36,960 --> 00:04:39,710
سوف تقدّمينها كلّها للملك

71
00:04:42,510 --> 00:04:45,300
كهديّة فُراق، سأخبركِ بشيء

72
00:04:46,720 --> 00:04:50,180
سوف أدع رينبو تحلّ مكانكِ

73
00:04:50,760 --> 00:04:52,020
!لن تجرؤ

74
00:04:52,020 --> 00:04:54,810
خذ كلّ القوّة السحريّة التي تريدها منّي

75
00:04:54,810 --> 00:04:57,610
لذا أبقِ يديك بعيدتين عن رينبو

76
00:05:03,280 --> 00:05:05,530
عُد إلى هنا

77
00:05:13,160 --> 00:05:16,920
ثمّ جاء اليوم الّذي انتهى فيه أَسري

78
00:05:17,630 --> 00:05:21,670
أقسمتُ لنفسي بأنّني سأقف أمامه من جديد

79
00:05:21,670 --> 00:05:26,130
وبأنّني سأدفعه ثمن السّخرية منّي ومن رينبو

80
00:05:29,720 --> 00:05:32,180
قبول. غينتيان، القنّاص

81
00:05:32,560 --> 00:05:33,970
تفعيل قدرة غينتيان

82
00:05:33,970 --> 00:05:36,600
تحويل بطاقتَي كوماندو إلى هالة والتسلّح بها

83
00:05:36,600 --> 00:05:38,520
إلحاق 8.000 من الضرر بنيبيل

84
00:05:41,190 --> 00:05:43,030
استخدام غينتيان لمهاجمة بريت

85
00:05:45,240 --> 00:05:48,280
والآن سأستخدم وحدة ب.س.آي
خاصّتي لمهاجمة حيواتك

86
00:05:53,450 --> 00:05:56,410
زناد الطلقة. إزالة اللّاعقلانيّة

87
00:05:56,830 --> 00:05:59,540
الختم على كاميليا أثناء هذا الدّور

88
00:05:59,830 --> 00:06:02,380
!ما زالت لديّ وحدة ب.س.آي. هيّا

89
00:06:06,220 --> 00:06:08,220
والآن هما متعادلان عند 4 حيوات لكلّ منهما

90
00:06:09,130 --> 00:06:12,050
رينبو، مهما قلت، أعلم بأنّ الأوان قد فات

91
00:06:12,510 --> 00:06:16,680
لكن أريدكِ أن تشهدي هذه المعركة

92
00:06:16,680 --> 00:06:19,560
معركة ستُنهي الأمر برمّته أخيراً

93
00:06:20,270 --> 00:06:23,020
كنتُ مخطئة جدّاً بشأنكِ

94
00:06:23,230 --> 00:06:25,730
أختي، كنتِ تقاتلين طوال هذا الوقت

95
00:06:26,110 --> 00:06:29,360
لم تتخلّي عنّي أبداً

96
00:06:29,450 --> 00:06:31,700
لنشجّعها يا رينبو

97
00:06:31,700 --> 00:06:32,580
أجل

98
00:06:33,120 --> 00:06:38,330
يا للوهن! نسل كاناغي قد تدهور حقّاً

99
00:06:38,580 --> 00:06:43,540
بهذا الجسد، سأحصل على قوّة غير محدودة

100
00:06:43,840 --> 00:06:48,920
فاشلون أمثالكم يمكن لهم أن
يغرقوا في عالم النّسيان

101
00:06:49,220 --> 00:06:52,550
نوّر الجاهل بمطرقة حديديّة

102
00:06:53,100 --> 00:06:54,470
قبول

103
00:06:56,140 --> 00:06:59,190
نيفيركسيس، الحكيم المتغطرس

104
00:07:02,610 --> 00:07:05,440
ها هو فارّاسول، مَن قاتلته هيوكو

105
00:07:05,520 --> 00:07:08,900
والآن تكاليف التّحرير بإضافة 2 طاقة

106
00:07:09,280 --> 00:07:11,070
...لا. هذه المستوطنة هي

107
00:07:11,780 --> 00:07:14,410
مستوطنة. نشوء بناء

108
00:07:14,990 --> 00:07:18,700
ساروواسول، جثّة الانتزاع المُقدّسة

109
00:07:35,390 --> 00:07:41,060
ساروواسول، بنفوذك، بسُلطتك، أرِيهم معنى اليأس

110
00:07:41,690 --> 00:07:45,650
،من يدي، تسليحها بنيكاري، الحواريّ المجيد، كهالة

111
00:07:45,650 --> 00:07:47,320
وتفعيل قدرتها

112
00:07:47,650 --> 00:07:51,150
أثناء هذا الدّور، سوف تكسب كلّ قوى نيكاري

113
00:07:51,650 --> 00:07:52,400
ماذا؟

114
00:07:52,610 --> 00:07:57,330
قوى نيكاري كهالة تمنحها تقوية
قدرها 3.000

115
00:07:57,700 --> 00:08:01,960
استخدام نيفيركسيس لإضافة قوّة أخرى
قدرها 3.000 وسحب بطاقة واحدة

116
00:08:02,290 --> 00:08:05,250
تفعيل القوى المُستحوَذ عليها من قِبل نيكاري

117
00:08:05,250 --> 00:08:08,500
أثناء الهجوم، ستعود وحدة واحدة إلى يدك

118
00:08:08,500 --> 00:08:11,010
تراجعي يا كاميليا

119
00:08:11,420 --> 00:08:14,430
ساروواسول، اقضي على غينتيان

120
00:08:17,100 --> 00:08:19,310
هيّا يا نيفيركسيس

121
00:08:24,270 --> 00:08:27,230
نقل نيفيركسيس إلى وضع الوقوف
أثناء طور النّهاية

122
00:08:27,650 --> 00:08:31,650
لا أصدّق بأنّه استخدمَ قوى وحدة
حوّلَها إلى هالة

123
00:08:31,650 --> 00:08:33,780
هذه مستوطنة جنونيّة

124
00:08:34,820 --> 00:08:38,330
هل سأخسر ثانية؟

125
00:08:40,830 --> 00:08:42,620
!يمكنكِ أن تربحي يا أختي

126
00:08:43,330 --> 00:08:45,830
!فوزي أرجوكِ، وعودي إلى الدّيار

127
00:08:45,830 --> 00:08:46,920
رينبو

128
00:08:46,920 --> 00:08:48,630
أعلم بأنّكِ تستطيعين فعلها

129
00:08:48,630 --> 00:08:52,920
أرجوكِ حقّقي أمنيتي. يجب أن
نرى بعضنا الآخر في نهاية المطاف

130
00:08:53,170 --> 00:08:57,390
وذلك كي نتمكّن من التحلّي بالأمل ثانية
ونعيش معاً من الآن فصاعداً

131
00:08:58,300 --> 00:08:59,930
أرجوكِ دعينا نراكِ تفوزين

132
00:09:01,180 --> 00:09:07,860
معكِ حقّ. هذا ليس لأجل الانتقام. هذا
كي أعود معكِ إلى الدّيار

133
00:09:08,310 --> 00:09:09,900
سوف أفوز

134
00:09:09,900 --> 00:09:11,570
تعالي يا كاميليا

135
00:09:11,570 --> 00:09:13,610
سأريح كاميليا وأفعّل قدرتها

136
00:09:13,900 --> 00:09:16,240
كوماندو. جيند، مدفع التحكّم عن بُعد

137
00:09:16,570 --> 00:09:18,570
!الهدف هو ساروواسول

138
00:09:29,540 --> 00:09:31,250
هزمَتْ ساروواسول

139
00:09:31,670 --> 00:09:33,420
تحويل جيند إلى وحدة ب.س.آي

140
00:09:33,880 --> 00:09:35,970
!وحدة ب.س.آي، حلّقي

141
00:09:36,430 --> 00:09:39,180
هذه هي أجنحة الانبعاث خاصّتي

142
00:09:44,850 --> 00:09:46,350
انفجاريّة بثلاث ضربات

143
00:09:46,640 --> 00:09:49,100
الإجهاز عليك بوحدة ب.س.آي الثّانية خاصّتي

144
00:09:50,020 --> 00:09:52,530
استخدام نيفيركسيس للتصدّي

145
00:09:54,150 --> 00:09:55,360
نهاية الدّور

146
00:09:55,690 --> 00:09:59,910
خسارة يا ريرا. لكن أحسنتِ

147
00:10:00,410 --> 00:10:02,950
من الواضح بأنّكِ تطوّرتِ

148
00:10:02,950 --> 00:10:04,080
نيفيركسيس

149
00:10:05,250 --> 00:10:09,750
سوف ألتهمكِ وذلك كي لا تُهدَر موهبتكِ على الأقلّ

150
00:10:10,580 --> 00:10:15,210
تسليح ساروواسول ببطاقة نيفيركسيس
الأخرى في يدي

151
00:10:15,760 --> 00:10:18,470
تفعيل قدرات الهالة المُستحوَذ عليها

152
00:10:19,640 --> 00:10:21,550
هيّا يا نيفيركسيس

153
00:10:26,310 --> 00:10:28,480
زناد الطلقة. ضربة جيميني الجارحة

154
00:10:28,890 --> 00:10:30,770
إلحاق 6،000 من الضّرر بساروواسول

155
00:10:31,650 --> 00:10:33,190
لن أستسلم

156
00:10:33,730 --> 00:10:36,900
استخدام ساروواسول لتنفيذ هجمة ذات
ضربتين على اللّاعب

157
00:10:39,280 --> 00:10:40,070
أختي

158
00:10:40,450 --> 00:10:41,160
ليس بعد

159
00:10:41,660 --> 00:10:44,120
زناد الطلقة. رايهو، صاروخ التحكّم عن بُعد

160
00:10:44,370 --> 00:10:47,620
الضّرر 18،000 بالمُجمل

161
00:10:47,620 --> 00:10:49,330
الآن يمكنها هزيمة ساروواسول

162
00:10:49,870 --> 00:10:53,750
منذ خسرتُ أمامك، لم أعرف سوى اليأس

163
00:10:54,250 --> 00:10:56,170
...لكن هذه المرّة أنا سوف

164
00:10:57,720 --> 00:11:01,590
التّوقيت السّريع. كوماندو. نور المساعدة الإلهيّة

165
00:11:01,970 --> 00:11:02,760
مستحيل

166
00:11:03,100 --> 00:11:08,730
تعزيز قوّة ساروواسول بقيمة 3،000. هذا
يمنحها 20،000 بالمُجمل

167
00:11:14,190 --> 00:11:16,440
النّصر لي

168
00:11:23,530 --> 00:11:24,870
!أختي

169
00:11:41,300 --> 00:11:42,430
اقتلوها

170
00:11:48,350 --> 00:11:51,100
لن أسلّمك أختي ثانية

171
00:11:55,440 --> 00:11:56,650
أختي

172
00:11:56,650 --> 00:11:57,820
أرسلوا بعض المساعدة حالاً

173
00:11:58,940 --> 00:12:00,240
رينبو

174
00:12:00,780 --> 00:12:02,200
حسناً

175
00:12:03,740 --> 00:12:05,070
لن تأخذ كيكّا

176
00:12:05,990 --> 00:12:07,870
ألم تلعبي بما يكفي؟

177
00:12:08,410 --> 00:12:09,790
هل أنتِ جاهزة؟

178
00:12:11,620 --> 00:12:16,380
أعتقد لا يصحّ أن تقولي بأنّكِ "لستِ جاهزة بعد"، صحيح؟

179
00:12:17,340 --> 00:12:18,630
إيشينومي

180
00:12:18,630 --> 00:12:21,090
لم أرك منذ وقت طويل يا هيغوماتشي

181
00:12:21,720 --> 00:12:26,050
كما ترى، تمّ إحيائي. ينبغي أن تعود الآن

182
00:12:26,390 --> 00:12:31,060
بربّك، امنحني مزيداً من الوقت. كنتُ
أستمتع بحياتي هنا كثيراً

183
00:12:31,930 --> 00:12:34,480
لا، انتهى الأمر الآن

184
00:12:40,650 --> 00:12:43,400
أردتُ حقّاً أن ألعب فترة أطول قليلاً

185
00:12:48,490 --> 00:12:53,870
لا تقلق يا إيشينومي. قريباً، سأصِل
إلى حيث تتواجدون جميعاً

186
00:12:54,290 --> 00:12:57,170
حان وقت تحقيق أمنيتي الكبرى

187
00:13:00,420 --> 00:13:04,430
كيكّا كورابي، لا يمكنكِ الهرب الآن

188
00:13:04,430 --> 00:13:09,470
قريباً، أنتِ أيضاً، ستقعين في قبضتي

189
00:13:10,810 --> 00:13:12,020
اختفى؟

190
00:13:17,230 --> 00:13:20,190
أيُّها الملك، حان وقت انبعاثك

191
00:13:50,220 --> 00:13:51,850
...ماذا؟ السّماء

192
00:13:52,680 --> 00:13:54,430
ما هذا؟

193
00:13:55,100 --> 00:14:05,320
،سكّان نيو كيوتو. بعد 47 ساعة و 59 دقيقة
ستخضع نيو كيوتو لإعادة بناء

194
00:14:06,150 --> 00:14:15,080
أكرّر. بعد 47 ساعة و 59 دقيقة، ستخضع
نيو كيوتو لإعادة بناء

195
00:14:15,080 --> 00:14:17,870
ماذا؟ إعادة بناء؟

196
00:14:26,420 --> 00:14:29,590
مستحيل. سيُعيدون بناء نيو كيوتو؟

197
00:14:29,590 --> 00:14:31,100
ماذا يقصدون بذلك؟

198
00:14:31,600 --> 00:14:35,390
سيعيدون إعمار هذه المدينة بأكملها من الصّفر

199
00:14:35,680 --> 00:14:39,600
ضرر له علاقة بخطأ برمجيّ نتيجة
...الانهيار سيتمّ إصلاحه، لكن في المقابل

200
00:14:39,730 --> 00:14:43,860
ذكرياتنا... سيُمسَح كلّ شيء من الماضي

201
00:14:44,110 --> 00:14:47,820
مستحيل. هذا أشبه بإبادتنا جميعاً

202
00:14:51,370 --> 00:14:56,450
لن يطول الأمر الآن. سيستعيد الملك شكله الأصليّ

203
00:14:56,450 --> 00:14:58,370
...وعندما يحدث ذلك

204
00:14:58,370 --> 00:15:00,080
...من جديد، إرادته

205
00:15:05,420 --> 00:15:14,470
أكرّر. بعد 47 ساعة و 59 دقيقة، ستخضع
...نيو كيوتو لإعادة بناء

206
00:15:09,720 --> 00:15:14,470
سأعود إلى مخبئي بما أنّني
أحتاج لحماية زملائي

207
00:15:14,470 --> 00:15:15,890
حسناً، فهمت

208
00:15:16,350 --> 00:15:18,180
ماذا ينبغي أن نفعل يا هيوكو؟

209
00:15:18,180 --> 00:15:20,900
ينبغي أن نعود أيضاً ونعيد تنظيم أنفسنا

210
00:15:20,900 --> 00:15:22,980
...ثمّ سننقذ المُعلّم

211
00:15:24,230 --> 00:15:26,820
قبل أن يسبقونا بإعادة بناء المدينة

212
00:15:35,280 --> 00:15:36,740
أختي

213
00:15:39,540 --> 00:15:41,250
آسفة لكلّ شيء عرّضتُكِ له

214
00:15:42,830 --> 00:15:44,710
لا تقلقي

215
00:15:44,920 --> 00:15:47,760
لأنّنا معاً الآن ثانية

216
00:15:51,130 --> 00:15:54,600
قد تكون هذه معركتنا الأخيرة

217
00:15:57,520 --> 00:16:01,020
أرجوك، مدّني بقوّتك

218
00:16:02,600 --> 00:16:03,560
كيكّا

219
00:16:05,110 --> 00:16:06,650
ألا ينبغي أن تنامي؟

220
00:16:06,940 --> 00:16:08,030
هيوكو

221
00:16:10,610 --> 00:16:13,030
سوف نخرج بعد أن نحظى ببعض الرّاحة

222
00:16:13,110 --> 00:16:14,030
حسناً

223
00:16:15,700 --> 00:16:17,950
ليتني أستطيع رؤية بعض النّجوم

224
00:16:19,700 --> 00:16:22,960
،في المرّة المقبلة الّتي ترينها فيها
سيكون المُعلّم معنا

225
00:16:25,460 --> 00:16:27,840
لنذهب ونره. سوية

226
00:16:29,800 --> 00:16:30,630
حسناً

227
00:16:35,430 --> 00:16:36,430
ها أنت ذي

228
00:16:36,510 --> 00:16:39,680
صباح الخير. لحظة، أين كيكّا؟

229
00:16:40,310 --> 00:16:43,560
...تلك هي. صباح

230
00:16:46,690 --> 00:16:47,860
صباح الخير

231
00:16:49,280 --> 00:16:51,110
مظهركِ

232
00:16:54,030 --> 00:16:56,280
ما رأيكِ؟

233
00:16:56,910 --> 00:16:59,200
أجل. يليق بكِ

234
00:17:00,870 --> 00:17:02,080
شكراً

235
00:17:09,340 --> 00:17:10,800
...كوغي

236
00:17:13,630 --> 00:17:15,050
...ماذا

237
00:17:15,300 --> 00:17:17,510
آثار إعادة البناء؟

238
00:17:17,640 --> 00:17:19,470
...إذا دخلَ قطيع كهذا

239
00:17:19,720 --> 00:17:21,430
لا نملك وقتاً لهذا

240
00:17:21,890 --> 00:17:23,350
يمكنكم الذّهاب

241
00:17:24,350 --> 00:17:25,560
...أنتم

242
00:17:25,560 --> 00:17:27,860
لديكِ أمور تفعلينها، أليس كذلك يا قائدة؟

243
00:17:27,860 --> 00:17:30,230
يمكننا البحث عن وسيلة للتعامل مع هذا

244
00:17:30,610 --> 00:17:31,570
...لكن

245
00:17:31,780 --> 00:17:34,860
كم مضى على قتالنا معاً؟

246
00:17:34,860 --> 00:17:36,740
ثِقي بنا يا هيوري

247
00:17:38,820 --> 00:17:40,910
حسناً. أعتمد عليكم

248
00:17:41,370 --> 00:17:43,160
أنتما. هيّا بنا

249
00:17:43,540 --> 00:17:45,500
انتظري لحظة

250
00:17:48,210 --> 00:17:49,710
ما الأمر يا كيكّا-ساما؟

251
00:17:50,840 --> 00:17:54,130
...لم أعد الملك، لذا

252
00:17:54,760 --> 00:17:57,010
اعتباراً من الآن، أريدكم أن تنادوني كيكّا

253
00:18:00,550 --> 00:18:02,260
حسناً يا كيكّا

254
00:18:02,260 --> 00:18:04,770
كان ينبغي أن تخبرينا مسبقاً

255
00:18:06,060 --> 00:18:08,350
سنلتقي لاحقاً، اتّفقنا يا كيكّا؟

256
00:18:08,690 --> 00:18:09,560
حسناً

257
00:18:13,280 --> 00:18:14,650
قلتُها

258
00:18:14,650 --> 00:18:15,950
مسرورة لأجلكِ

259
00:18:23,950 --> 00:18:25,960
يوجد الكثير منهم هنا أيضاً؟

260
00:18:29,120 --> 00:18:31,290
بعض الأمور ليست بسيطة

261
00:18:32,750 --> 00:18:36,760
!تألُّق بيارمي على المسرح

262
00:18:39,340 --> 00:18:41,470
بيارمي، ماذا تفعلين هنا؟

263
00:18:41,640 --> 00:18:45,520
بناء على طلب تلكما الاثنتين. تريدان أن أساعدكم

264
00:18:46,810 --> 00:18:47,940
نعتذر عن التأخّر

265
00:18:48,270 --> 00:18:49,270
رينبو

266
00:18:49,270 --> 00:18:50,230
ريرا

267
00:18:50,600 --> 00:18:53,480
اسمحوا لنا بالقتال معكم رجاء

268
00:18:53,480 --> 00:18:56,190
حتّى في حالتي، يمكنني على الأقلّ
أن ألعب دور الدّرع

269
00:18:56,360 --> 00:18:57,780
وأيضاً لدينا فريق آخر

270
00:18:58,990 --> 00:19:04,240
أيّ تلميذ يقف مكتوف الأيدي عندما يسمع
بأنّ مُعلّمه في ورطة؟

271
00:19:04,490 --> 00:19:10,370
حسناً يا 47 رونين. رافقوا مُعلّمتنا
نحو البرج مهما حدث

272
00:19:10,370 --> 00:19:11,210
!حاضر

273
00:19:11,420 --> 00:19:14,960
أيّها المُتابعون. لنجعل هذا أفضل عرض لنا

274
00:19:15,250 --> 00:19:16,760
حاضر يا ملاكي

275
00:19:17,090 --> 00:19:18,420
هيّا بنا يا رينبو

276
00:19:18,420 --> 00:19:19,840
حسناً يا أختي

277
00:19:28,060 --> 00:19:29,020
حسناً، هيّا

278
00:19:29,600 --> 00:19:30,690
شكراً

279
00:19:34,730 --> 00:19:35,940
اتلُ صلواتكم

280
00:19:36,400 --> 00:19:37,440
الجميع

281
00:19:37,860 --> 00:19:38,940
...لن ندعكم

282
00:19:39,450 --> 00:19:40,650
!تتقدّموا أكثر

283
00:19:40,990 --> 00:19:43,320
!مستوطنة! نشوء بناء

284
00:19:46,580 --> 00:19:48,200
يمكننا الوصول إلى القبو من هنا

285
00:19:49,250 --> 00:19:50,290
هنا؟

286
00:19:50,290 --> 00:19:52,880
وفقاً لخريطة ريرا، هذا هو الطريق الصّحيح

287
00:19:54,710 --> 00:19:56,000
حمّام؟

288
00:19:56,420 --> 00:19:57,710
سوف أدفعه

289
00:20:03,550 --> 00:20:04,890
فُتِح طريق جديد

290
00:20:08,020 --> 00:20:12,310
يبدو أنّنا بحاجة لسلوك هذا الطريق لصعود البرج

291
00:20:16,270 --> 00:20:18,110
يا لها من غرفة

292
00:20:20,240 --> 00:20:22,070
سبقَ وكنتُ هنا

293
00:20:22,400 --> 00:20:24,240
نحن غالباً تحت العرش

294
00:20:24,240 --> 00:20:25,740
تتذكّر إذاً؟

295
00:20:25,740 --> 00:20:29,540
بشكل مُبهم. لكن هذه الأشياء لم تكن هنا من قبل

296
00:20:31,710 --> 00:20:32,580
!انتبهي

297
00:20:35,500 --> 00:20:36,750
شكراً

298
00:20:36,750 --> 00:20:39,630
ما مشكلتهم؟

299
00:20:40,460 --> 00:20:42,340
ونحن على عجلة من أمرنا أيضاً

300
00:20:42,340 --> 00:20:44,470
يمكنكِ الذّهاب يا هيوكو

301
00:20:44,840 --> 00:20:47,760
هذه المرّة، سأمهّد طريقاً لكِ

302
00:20:47,760 --> 00:20:49,350
أنا معكِ أيّتها الآنسة الصّغيرة

303
00:20:49,680 --> 00:20:50,810
اذهبي أيّتها المُزعجة الصّغيرة

304
00:20:51,770 --> 00:20:52,480
...لكن

305
00:20:52,770 --> 00:20:53,980
لا تقلقي

306
00:20:54,310 --> 00:20:55,400
لن نخسر

307
00:21:00,820 --> 00:21:03,240
حالما نقضي على هؤلاء، سوف نلحق بكِ

308
00:21:03,240 --> 00:21:04,950
اعتني بتيروتو رجاء

309
00:21:05,360 --> 00:21:09,990
حسناً. سوف أدع هذا الأمر لكما وأسبقكما

310
00:21:12,660 --> 00:21:15,120
انظري إليها كيف تتصرّف كمُعلّمها

311
00:21:17,590 --> 00:21:19,250
احرصي على أن تفوزي أيّتها الآنسة الصّغيرة

312
00:21:19,250 --> 00:21:20,800
أنت أيضاً يا ناوميتسو

313
00:21:24,840 --> 00:21:27,470
حسناً، تعال إليّ أيّها العملاق

314
00:21:40,770 --> 00:21:41,900
أنا؟

315
00:21:48,410 --> 00:21:49,740
...أنت

316
00:21:56,920 --> 00:21:59,920
يتبع

317
00:23:30,260 --> 00:23:33,220
من أنا؟ من أكون بالضبط؟

318
00:23:33,220 --> 00:23:35,890
هذه جريمة. هذه عقوبتي

319
00:23:35,890 --> 00:23:39,520
مُعلّم. وجدتُك أخيراً

320
00:23:36,600 --> 00:23:39,940
!‏‏#21 عِش في الحاضر، الحاضر، الحاضر