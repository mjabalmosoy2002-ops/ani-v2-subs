1
00:01:53,040 --> 00:01:54,710
هل تعرفين هذه الأغنية؟

2
00:01:57,470 --> 00:02:00,590
.لقد قلتِ بأنَّ هنالك ساحرة تحمي إيفا

3
00:02:00,590 --> 00:02:02,350
هل سبق وأن التقيتِ بها؟

4
00:02:02,350 --> 00:02:05,600
نعم. كم عددهن الآن؟

5
00:02:05,600 --> 00:02:09,270
.هناك بعض الظروف التي تجعلك ساحرة تحمي إيفا

6
00:02:09,270 --> 00:02:09,940
مثل ماذا؟

7
00:02:10,730 --> 00:02:12,660
.أن تكون عذراء وبكامل البراءة

8
00:02:15,110 --> 00:02:17,150
لماذا زهرة الزنبق؟

9
00:02:17,990 --> 00:02:21,530
.لأنَّ الزنبق الأبيض يمثل العفّة

10
00:02:23,410 --> 00:02:26,690
مادونا ليلي: الزنبق العذراء

11
00:02:23,410 --> 00:02:26,690
."وتسمّى أيضًا بـ "مادونا ليلي

12
00:02:28,710 --> 00:02:35,040
.ليلي"؟ لا يهم"
أيُّ نوعٍ من الساحرات سنواجه الآن؟

13
00:02:35,670 --> 00:02:39,510
حروب الساحرات

14
00:02:42,510 --> 00:02:43,680
أتفاجأت؟

15
00:02:44,640 --> 00:02:45,720
.تفاجأت

16
00:02:46,600 --> 00:02:48,350
.مرحبًا أيُّها البروفيسور

17
00:02:48,980 --> 00:02:50,560
.يا لها من طريقة لجمع الجميع

18
00:02:51,600 --> 00:02:53,520
،لقد قالن بعد استيقاظهن

19
00:02:53,520 --> 00:02:56,190
.بأنَّهن على تواصل مع بعضهن

20
00:02:56,610 --> 00:02:59,900
.تبيّن علمهن بأنَّهن ساحرات سابقات جميعًا

21
00:03:01,110 --> 00:03:03,310
.جميعًا لدينا الأمنية ذاتها

22
00:03:03,870 --> 00:03:06,060
.نريد رؤية هاروتو-سان

23
00:03:06,780 --> 00:03:13,580
.لقد بدأنا بالبحث من حولنا على هاروتو-سان ونرى كيف هو حاله في العالم الحقيقي

24
00:03:14,130 --> 00:03:15,210
أنتِ أيضًا؟

25
00:03:15,210 --> 00:03:18,920
.سأكون ممتنة لو أنَّك لم تستهن بشبكة فالنكا الملكية للذكاء الاصطناعي

26
00:03:19,420 --> 00:03:23,800
ألم تجد أيُّ أدلّة تقودنا لهاروتو-سان؟

27
00:03:23,800 --> 00:03:24,830
.كلا

28
00:03:25,390 --> 00:03:30,910
.عندما كنا ساحرات لقد أحسسنا بشيءٍ مختلف في هاروتو-سان عن الآخرين

29
00:03:31,350 --> 00:03:32,730
مختلف عن الآخرين؟

30
00:03:32,730 --> 00:03:34,270
.بمرور الوقت

31
00:03:34,270 --> 00:03:35,210
الوقت؟

32
00:03:35,730 --> 00:03:40,280
.الوقت الذي يحوي هاروتو-سان مختلف عنّا

33
00:03:40,280 --> 00:03:42,530
.وعنك أيضًا

34
00:03:43,740 --> 00:03:46,070
.ليس وكأنّني أفهم ما يعني ذلك

35
00:03:46,450 --> 00:03:51,750
.جميعنا الآن متوزعون باحثين عن أدلّة مبنية على ما شعرنا به من قبل

36
00:03:52,040 --> 00:03:55,790
أتقولون أنَّ مشاعركم طرف خيط الدليل؟

37
00:03:56,080 --> 00:03:57,040
.أجل

38
00:03:57,040 --> 00:03:59,300
.يبدو كأنَّه شيء لا يمكن الاعتماد عليه كليًّا

39
00:04:00,510 --> 00:04:03,720
.الأشخاص الذين كانوا في عالم الأحلام لديهم هالة مختلفة

40
00:04:03,720 --> 00:04:05,970
أسمعت عن النجوم وكيف يولِّدون هالةً حولهم؟

41
00:04:05,970 --> 00:04:08,170
.يمكنك معرفتهم بمجرّد النظر لهم

42
00:04:08,500 --> 00:04:10,180
وكيف تبدو؟

43
00:04:10,180 --> 00:04:12,680
.هناك توهّجٌ بسيطٌ حولهم

44
00:04:13,560 --> 00:04:15,310
.هذه أول مرّة أسمع عن ذلك

45
00:04:15,310 --> 00:04:18,190
آثار جانبية لمتلازمة الجميلة النائمة؟

46
00:04:20,980 --> 00:04:22,990
بابٌ أحمرٌ آخر؟

47
00:04:24,360 --> 00:04:26,570
.ما يقبع خلفه عالمُ ساحرة

48
00:04:28,780 --> 00:04:29,910
ما هذا؟

49
00:04:29,910 --> 00:04:30,910
.لا أعلم

50
00:04:30,910 --> 00:04:32,490
هل له علاقة بإيفا؟

51
00:04:33,120 --> 00:04:36,310
.ربّما، لكنَّني لستُ متأكدة

52
00:04:36,870 --> 00:04:38,710
...يبدو أنَّه عملٌ يختص به

53
00:04:39,420 --> 00:04:41,710
.البروفيسور؟ لكنَّكما قد تعاركتما

54
00:04:42,760 --> 00:04:44,820
أتقولين بأنَّنا لن نتحدث مع بعضنا أبدًا؟

55
00:04:45,430 --> 00:04:47,570
.أنا لستُ من هذا النوع من الناس

56
00:04:51,260 --> 00:04:51,970
!هاروتو

57
00:04:53,350 --> 00:04:55,390
.فهمت. أنا قادم

58
00:04:55,390 --> 00:04:56,850
هل حدث شيءٌ لهاروتو-سان؟

59
00:04:56,850 --> 00:04:58,100
.عليَّ أن أذهب

60
00:04:59,400 --> 00:05:01,770
.يمكنكم التواصل مع عالم الأحلام عبر هذا

61
00:05:01,770 --> 00:05:05,610
.إن علمتم شيئًا حيال هاروتو فأخبروني. أنا أعتمد عليكم

62
00:05:09,620 --> 00:05:13,370
!الإلهة إيفا. أنا أشعرُ بقوتها

63
00:05:13,370 --> 00:05:16,910
!الشهامة العظمى والقوة الهائلة

64
00:05:16,910 --> 00:05:18,290
.يقظتك قريبة

65
00:05:18,290 --> 00:05:23,460
!عساكِ أن تستيقظين عاجلًا لإنقاذ العالم

66
00:05:23,460 --> 00:05:26,170
كيف يجري بحث الساحرات السابقات؟

67
00:05:27,550 --> 00:05:29,890
.ليس هناك تقدّم كبير حتّى الآن

68
00:05:30,300 --> 00:05:34,220
.ويجب أن نضع بنظر الاعتبار أنَّ الخيط الوحيد الذي نعتمد عليه هو مشاعرنا

69
00:05:34,520 --> 00:05:37,730
.أريد أن ألتقي بتسوكيشيرو هاروتو يومًا ما

70
00:05:37,730 --> 00:05:41,190
.هذا الأمل الوحيد الذي يجعلنا نبحث عنه

71
00:05:41,190 --> 00:05:47,250
.أن نتحدث مع هاروتو-سان الملموس ليس في عالم الأحلام، بل في العالم الواقعي

72
00:05:48,360 --> 00:05:49,730
.آسف على تأخري

73
00:05:51,240 --> 00:05:53,740
.أعتذر عمّا سبق

74
00:05:56,830 --> 00:05:58,040
ما المشكلة؟

75
00:05:58,040 --> 00:06:01,670
...هذا الصوت... بل هذه الأغنية

76
00:06:01,670 --> 00:06:03,340
هل تحنُّ لك بشيء؟

77
00:06:03,340 --> 00:06:04,340
.إنَّها أختي

78
00:06:04,340 --> 00:06:05,630
حقًّا؟

79
00:06:07,130 --> 00:06:09,220
هل هي في الجانب الآخر من هذا الباب؟

80
00:06:09,220 --> 00:06:11,020
صوت أختك؟

81
00:06:11,550 --> 00:06:12,930
ماذا تقولين يا ليلي؟

82
00:06:12,930 --> 00:06:14,330
!هل ليلي هنا؟

83
00:06:21,690 --> 00:06:22,730
!إنَّها هنا

84
00:06:23,190 --> 00:06:25,270
.لقد كنتُ هنا طوال الوقت

85
00:06:26,690 --> 00:06:29,020
.هذا تاج منظمة الشوك الصليبي

86
00:06:29,740 --> 00:06:31,740
...إنَّهم يبجّلون الإلهة إيفا

87
00:06:31,740 --> 00:06:32,950
.إيفا مجدّدًا

88
00:06:32,950 --> 00:06:34,910
أتعرف عن إيفا؟

89
00:06:34,910 --> 00:06:37,000
.أعرفها أشدّ المعرفة

90
00:06:37,000 --> 00:06:40,630
.قد تكون العلامة التي ذكرها البروفيسور هي هذه

91
00:06:41,420 --> 00:06:42,630
ما هذه؟

92
00:06:42,630 --> 00:06:45,250
.أعرفها. منظمة الشوك الصليبي

93
00:06:45,250 --> 00:06:47,880
.إنَّهم يتضرّعون حول العالم لإيقاظ إيفا

94
00:06:48,380 --> 00:06:50,510
.أنا قلقة حيال أخته

95
00:06:50,510 --> 00:06:52,550
هلّا جاء أحدٌ معي؟

96
00:06:52,550 --> 00:06:54,600
لمختبر البروفيسور؟

97
00:06:55,260 --> 00:06:59,350
،نعم. إن شعرت أخته بأي تغيّرات وهو ليس متواجدًا

98
00:06:59,350 --> 00:07:01,020
.فعلينا أن نُعلِمهُ بذلك

99
00:07:02,690 --> 00:07:04,310
.حسنًا، سأرافقك

100
00:07:06,150 --> 00:07:08,570
هلَّا راقبتما المكان من أجلي؟

101
00:07:09,360 --> 00:07:11,150
...إن كان ما تقوله ليلي صحيحًا

102
00:07:11,150 --> 00:07:15,870
.إنَّه صحيح. ما تقوله منظمة الشوك الصليبي هو العكس تمامًا

103
00:07:15,870 --> 00:07:17,350
.سوف نعرف الحقيقة حالما التقينا بإيفا

104
00:07:17,350 --> 00:07:18,580
نلتقي بها ثم ماذا؟

105
00:07:19,020 --> 00:07:20,830
.إنَّها مختلفة عن الساحرات

106
00:07:21,370 --> 00:07:23,620
.الجميع سوف يموت ما أن تستيقظ

107
00:07:24,420 --> 00:07:25,590
.سنقتلها

108
00:07:26,250 --> 00:07:27,780
.كنتُ حاسًا بأنَّ الأمر سيؤول لهذا

109
00:07:28,380 --> 00:07:29,340
كيف سنفعلها؟

110
00:07:30,260 --> 00:07:34,800
،فقط أخي قادرٌ على قتلها. وإن لم يتمكن

111
00:07:35,140 --> 00:07:36,680
.سوف نموت

112
00:07:37,930 --> 00:07:38,780
.أرجوك

113
00:07:42,270 --> 00:07:43,310
.سأقرر بعد أن ألتقي بها

114
00:08:08,460 --> 00:08:10,550
كان هذا مرعبًا. ماذا كان؟

115
00:08:10,550 --> 00:08:13,130
.لن نتقدم ونحن مجرّدين من السلاح. لنتسلّح

116
00:08:13,130 --> 00:08:14,950
أين سنجد الأسلحة؟

117
00:08:14,950 --> 00:08:16,590
.إن كان هذا حلمًا فيمكننا الإتيان بشيء

118
00:08:16,590 --> 00:08:18,050
!لن نأتي بأيّ شيء

119
00:08:23,850 --> 00:08:27,410
!هناك نوعٌ من الفعالية حيث تكمن الإلهة

120
00:08:33,070 --> 00:08:36,100
.اجثو على ركبيتكم يا دخلاء

121
00:08:36,820 --> 00:08:39,500
.سوف أسمح لكم بالنظر لي

122
00:08:40,620 --> 00:08:42,330
إنَّها الساحرة هنا؟

123
00:08:42,910 --> 00:08:46,460
.لا يمكنني رؤية أفكار الساحرة
.مجرّد هذه المدافع

124
00:08:46,460 --> 00:08:48,670
.لم تخلق من أفكار الساحرة

125
00:08:49,250 --> 00:08:50,980
.والمشكلة لا تكمن هنا

126
00:08:51,510 --> 00:08:52,840
.هذه أختي

127
00:08:53,210 --> 00:08:59,970
.أنا ساحرة الزنابق البيضاء
.أنا أحمي باب إيفا بعفّتي

128
00:09:00,260 --> 00:09:01,750
عمَّ تتحدّثين؟

129
00:09:02,890 --> 00:09:05,980
!يورينا! إنَّه أنا. أنا أخوكِ

130
00:09:24,160 --> 00:09:27,480
.الساحرة لا تتعرّف عليكَ على أنَّك أخوها

131
00:09:29,960 --> 00:09:33,380
.فهمت... تريدين التخلّص مني يا إيفا

132
00:09:33,380 --> 00:09:34,050
ماذا؟

133
00:09:34,710 --> 00:09:37,050
.إيفا تتحكّم بالساحرة

134
00:09:37,050 --> 00:09:39,590
.فلهذا لا أستطيع رؤية أفكار الساحرة

135
00:09:39,590 --> 00:09:43,810
.هذا ليس عالمًا مخلوق من قبل الساحرة، بل إنَّه عالم إيفا

136
00:09:46,350 --> 00:09:48,420
لماذا توقفتِ فجأة؟

137
00:09:51,360 --> 00:09:52,400
مستشفى؟

138
00:09:52,400 --> 00:09:55,650
.لقد أتيت إلى هنا عدّة مرّات منذ الحادثة

139
00:09:57,780 --> 00:10:00,160
لماذا؟ ماذا تريدين؟

140
00:10:00,160 --> 00:10:03,310
.لقد مرّت فترة. سألقي تحيةً على الطبيب

141
00:10:03,950 --> 00:10:06,840
!ما هذا؟ لا تنحرفين عن المسار

142
00:10:10,040 --> 00:10:11,380
...أيُّها الطبيب

143
00:10:11,380 --> 00:10:13,210
.إنَّها أنتِ

144
00:10:14,000 --> 00:10:15,340
أهذه صديقتكِ؟

145
00:10:15,340 --> 00:10:18,090
.أنا كوجيما آيري. سررت بلقائك

146
00:10:19,380 --> 00:10:21,970
!طبيبكِ لطيفٌ للغاية

147
00:10:22,800 --> 00:10:26,980
أنا مرتاحٌ لأجلكِ. أنتِ مع صديقة، أليس هذا جيدًا؟

148
00:10:27,390 --> 00:10:30,270
!هذا صحيح! أنا صديقتها

149
00:10:30,600 --> 00:10:34,800
...لقد كنا في الأرجاء وأرادت أن تلقي التحية على طبيبها

150
00:10:37,860 --> 00:10:38,840
أكان هذا..؟

151
00:10:41,160 --> 00:10:45,580
.هذا المريض؟ إنَّه في غيبوبة منذ وقتٍ طويل

152
00:10:45,580 --> 00:10:49,000
.لم يستيقظ منذ أن تم جلبه إلى هنا

153
00:10:49,710 --> 00:10:50,870
هل شعرتِ بهذا؟

154
00:10:50,870 --> 00:10:54,000
.نعم. مثل الشعور الذي أحسست به بالحلم

155
00:11:02,550 --> 00:11:04,600
!تماسكي يا ليلي

156
00:11:04,600 --> 00:11:07,850
...أنا بخير

157
00:11:07,850 --> 00:11:11,770
.هذه الساحرة الخبيثة، ليس من الأخلاق الحسنة ضرب طفلة هكذا

158
00:11:12,520 --> 00:11:15,520
.حتّى لو... إنَّها أختي

159
00:11:19,110 --> 00:11:21,530
تسوكشيرو هاروتو

160
00:11:21,950 --> 00:11:23,450
.تسوكشيرو هاروتو

161
00:11:23,450 --> 00:11:24,660
.نعم

162
00:11:24,660 --> 00:11:25,950
.لقد وجدناه

163
00:11:25,950 --> 00:11:26,870
.لحظة

164
00:11:28,080 --> 00:11:30,500
.قد يكون تشابه بالأسماء مع شخص آخر

165
00:11:30,500 --> 00:11:33,750
لكنّكِ شعرتِ بها... نفس الوضع في ذلك العالم؟

166
00:11:33,750 --> 00:11:35,040
.علينا أن نتأكد

167
00:11:35,040 --> 00:11:36,410
وكيف نفعل ذلك؟

168
00:11:49,890 --> 00:11:50,930
!يورينا

169
00:11:51,270 --> 00:11:53,330
.اعتقدتُ بأنَّني فهمتك

170
00:11:54,560 --> 00:11:57,980
لم ترغبي أن تصبحي نجمة، أليس كذلك؟

171
00:11:57,980 --> 00:11:59,480
نجمة؟

172
00:11:59,650 --> 00:12:00,650
.هذا صحيح

173
00:12:01,570 --> 00:12:06,200
.تجاوزت يورينا اختبارًا قد سجّلتها صديقتها فيه وأصبحت نجمة

174
00:12:06,620 --> 00:12:11,940
.كان لديها الكثير من المعجبين وضغطت على نفسها كثيرًا للوصول لتوقعاتهم

175
00:12:12,870 --> 00:12:17,130
.أنا لا أعتقد بأنَّكِ أردتِ الهرب بتطوير متلازمة الجميلة النائمة

176
00:12:17,750 --> 00:12:19,800
،حسّ الواجب الذي أجبركِ على إجهاد نفسك

177
00:12:19,800 --> 00:12:22,800
.هو ما قادكِ وجعلكِ تسترخين

178
00:12:24,260 --> 00:12:26,140
!يورينا! استيقظي

179
00:12:26,550 --> 00:12:27,820
!هذا يكفي

180
00:12:27,820 --> 00:12:31,720
!لا فرق بين كونكِ ميتة وتعرضكِ لمتلازمة الجميلة النائمة سوى إنَّكِ على قيد الحياة

181
00:12:31,720 --> 00:12:34,810
!طالما أنَّكِ حيّة فيمكنكِ اختيار حياة أخرى

182
00:12:38,650 --> 00:12:40,530
!أيُّها البروفيسور

183
00:12:40,650 --> 00:12:42,650
حقًّا؟
تقول مانا بأن علينا أن نتأكد
علينا أن نفعل ذلك بلا ريب
كيف نتأكد؟

184
00:12:42,780 --> 00:12:44,740
.هذا سؤالٌ وجيه

185
00:12:44,740 --> 00:12:46,950
علينا أن نخرج ونسأل، أليس كذلك؟

186
00:12:46,950 --> 00:12:48,160
.لقد فهمت

187
00:12:49,370 --> 00:12:50,280
ما المشكلة؟

188
00:12:50,280 --> 00:12:52,290
هل تريدين أن أساعدكِ؟

189
00:12:52,830 --> 00:12:54,000
من كايو؟

190
00:12:54,000 --> 00:12:56,120
.كايو كانت ساحرة الحبّ الأول

191
00:12:56,120 --> 00:12:58,130
ساحرة الحبّ الأول؟

192
00:12:58,130 --> 00:13:00,590
إنَّها التي توفّت؟

193
00:13:01,000 --> 00:13:02,590
،قد لا تتمكن من القدوم هنا

194
00:13:02,590 --> 00:13:06,880
.لكنَّها قد تكون قد تركت جزءًا من روحِها في هذا العالم بدافع الاهتمام لهاروتو-سان

195
00:13:06,880 --> 00:13:10,300
!مثل! رسالة من شخصٍ متوفي

196
00:13:10,300 --> 00:13:11,850
.سأحاول إجابتها

197
00:13:11,850 --> 00:13:14,640
كايو-سان. ساعدينا

198
00:13:14,640 --> 00:13:15,980
أعطيني دقيقة

199
00:13:14,850 --> 00:13:15,980
!مذهل

200
00:13:16,310 --> 00:13:18,690
أتمزحين؟ شخصٌ متوفي؟

201
00:13:19,860 --> 00:13:21,650
.إنَّها هنا

202
00:13:23,190 --> 00:13:24,360
.يمكننا رؤيتها

203
00:13:24,360 --> 00:13:26,020
.يمكننا رؤيتها بالطبع

204
00:13:34,660 --> 00:13:36,290
!توقفي عن هذا يا ساحرة

205
00:13:41,750 --> 00:13:43,630
.ماذا؟ أنا مشغولٌ الآن

206
00:13:43,920 --> 00:13:46,420
.لقد وجدنا مكان هاروتو-سان

207
00:13:46,420 --> 00:13:48,430
إنّه هاروتو-سان
لا شكّ في ذلك

208
00:13:52,430 --> 00:13:53,930
ما كان ذلك؟

209
00:13:54,100 --> 00:13:57,690
!لقد قلت بأنَّنا وجدنا مكان هاروتو-سان

210
00:13:59,850 --> 00:14:03,090
.ما هذا الصوت؟ إنَّه عالٍ جدًّا

211
00:14:09,030 --> 00:14:12,280
.آسف يا يوكو-كن، لا يمكنني محادثتك الآن

212
00:14:17,830 --> 00:14:19,620
.هذا العالم ينهار

213
00:14:19,620 --> 00:14:20,630
إنَّه ماذا؟

214
00:14:21,040 --> 00:14:23,380
.إنَّه يدمّر تمامًا... العالم، والساحرة

215
00:14:24,550 --> 00:14:26,760
.أنا أعرف هذا الصوت

216
00:14:26,760 --> 00:14:28,220
أتعرفين هذا الصوت؟

217
00:14:28,220 --> 00:14:31,220
!إنَّه صوت يورينا! النجمة التي يرغب أن يصبح كل النجوم مثلها

218
00:14:31,470 --> 00:14:32,720
هل يمكننا الذهاب لإنقاذها؟

219
00:14:32,720 --> 00:14:34,140
.أرغب بذلك

220
00:14:34,140 --> 00:14:37,100
.أنتِ ساحرة، كل ما عليكِ فعلهُ هو أن تحلمين

221
00:14:37,100 --> 00:14:38,980
.بما معناه، اذهبي ونامي

222
00:14:47,900 --> 00:14:48,570
!من أنت؟

223
00:14:55,200 --> 00:14:56,290
أنتِ..؟

224
00:14:56,700 --> 00:15:01,290
!هاروتو-سان، العين بالعين والنجم بالنجم

225
00:15:01,290 --> 00:15:05,000
.لا أفهم حقًّا، ولكنني لستُ متأكّدًا إن كنتُ مقتنعًا أم لا

226
00:15:06,210 --> 00:15:08,760
!يورينا-سان، لطالما أردت أن أصبح مثلها

227
00:15:08,970 --> 00:15:09,970
!تلاشي

228
00:15:16,260 --> 00:15:19,730
!هنالك الكثير من الأشياء التي يمكن لميساكي-تشان وحدها

229
00:15:19,730 --> 00:15:21,560
.ما تبحث عنه إيفا هي النقاوة

230
00:15:21,850 --> 00:15:23,810
،فإن لوثنا نقاوتها

231
00:15:23,810 --> 00:15:26,980
.فلن تحتاج إيفا للساحرة بعد الآن

232
00:15:26,980 --> 00:15:28,690
.القول أسهل من الفعل

233
00:15:28,710 --> 00:15:30,030
!أغربي عن وجهي

234
00:15:30,030 --> 00:15:32,030
!يورينا-سان عليكِ أن تستيقظي

235
00:15:32,030 --> 00:15:36,870
!لن أسمح لأيّ أحدٍ حتّى لو كانت ساحرة أن تزعج نوم الإلهة

236
00:15:40,540 --> 00:15:43,330
لقد أخبرتِني أن أقتل إيفا؟

237
00:15:43,330 --> 00:15:44,140
.نعم

238
00:15:44,790 --> 00:15:46,500
.لقد فكرت بكيفية قتلها

239
00:15:48,880 --> 00:15:51,380
...لقد فكرت بهذا الأمر كذلك

240
00:16:02,730 --> 00:16:05,270
!ليلي، اختفي

241
00:16:10,900 --> 00:16:12,610
.لقد فعلتها يا هاروتو-سان

242
00:16:13,150 --> 00:16:16,570
إنَّ إيفا تراني من خلالكِ، أليس كذلك؟

243
00:16:16,570 --> 00:16:17,370
!فكّني

244
00:16:17,370 --> 00:16:18,510
.لن يحدث

245
00:16:21,540 --> 00:16:23,960
!لحظة

246
00:16:30,300 --> 00:16:32,880
.لقد سلبتُ منكِ زنبقكِ الأبيض

247
00:16:36,470 --> 00:16:37,220
.مرحبًا

248
00:16:37,850 --> 00:16:40,100
!..هاروتو... أنت

249
00:16:40,350 --> 00:16:43,430
ما الذي فعلته؟

250
00:16:43,430 --> 00:16:45,000
.لقد غادرَتْها إيفا

251
00:16:46,270 --> 00:16:48,020
ماذا تظنين بأنَّني فعلت؟

252
00:16:48,020 --> 00:16:50,050
!لا تتجاوز حدودك

253
00:16:50,050 --> 00:16:53,360
كيف لك أن تتصرّف بهذه البذاءة أمامي؟

254
00:16:53,360 --> 00:16:55,530
!أجيبني على ما اقترفته

255
00:16:55,570 --> 00:17:00,280
!ماذا تعني بـ"أجيبك"؟

256
00:17:00,280 --> 00:17:02,200
!توقف يا أخي

257
00:17:02,200 --> 00:17:03,040
...أنتِ

258
00:17:03,040 --> 00:17:05,670
.رغم كونك قطًّا فأنَّها تعرفك

259
00:17:05,960 --> 00:17:08,510
!يورينا! لقد عدتِ لهيأتكِ القديمة؟

260
00:17:09,040 --> 00:17:10,380
.هذا أفضل الآن

261
00:17:10,380 --> 00:17:11,050
ماذا؟

262
00:17:11,500 --> 00:17:15,840
.بالنسبة لنجمة فقد تكون هذه فضيحة تدمّر حياتها

263
00:17:15,840 --> 00:17:18,090
!أيُّتها..! متى التقطتِها

264
00:17:18,090 --> 00:17:20,510
.إنَّهُ حلمٌ، كل شيء ممكن

265
00:17:20,510 --> 00:17:23,770
!لا تبيعها! لا تبيعيها لأي أحد

266
00:17:27,600 --> 00:17:30,270
.إنَّ البروفيسور حقًّا أخوكِ الكبير

267
00:17:30,770 --> 00:17:33,320
.يورينا، لنغني معًا

268
00:17:34,110 --> 00:17:35,400
.سوف ندمّر هذا

269
00:17:35,820 --> 00:17:38,490
ما الذي يحدث؟

270
00:17:38,490 --> 00:17:41,660
.إلهة شريرة في الجانب الآخر من الحصن

271
00:17:41,660 --> 00:17:43,750
.هذا صحيح، غني

272
00:17:43,750 --> 00:17:45,500
من أنتِ؟

273
00:17:46,540 --> 00:17:47,870
.أنا إحدى معجباتكِ

274
00:17:47,870 --> 00:17:49,000
معجبة؟

275
00:17:58,510 --> 00:17:59,550
!ماذا الآن؟

276
00:18:08,230 --> 00:18:10,060
!يورينا، غني

277
00:18:10,060 --> 00:18:11,360
.سنمحى إن لم تفعلي

278
00:18:11,690 --> 00:18:14,690
إذا غنيتُ، فالجميع سوف يُنقذ؟

279
00:18:14,690 --> 00:18:16,190
.حتّى أنتِ ستُنقذين

280
00:18:40,680 --> 00:18:43,040
لقد أصبحتِ أقوى يا ميساكي-تشان؟

281
00:18:58,650 --> 00:18:59,860
...مذهل

282
00:19:22,050 --> 00:19:23,720
.أنت مستمتعة جدًّا

283
00:19:23,720 --> 00:19:25,010
.حسنًا، إنَّه حلم

284
00:19:37,780 --> 00:19:42,260
ذلك الباب؟ إنَّه الباب ذاته الذي تستخدمينه دائمًا؟

285
00:19:45,490 --> 00:19:47,740
.أريدكِ أن تأخذي يورينا بعيدًا عن هنا

286
00:19:47,740 --> 00:19:48,660
.حسنًا

287
00:19:48,660 --> 00:19:51,290
.لا تجعلي إيفا تعبث معكِ مجدّدًا

288
00:19:51,290 --> 00:19:52,830
.أراك لاحقًا يا أخي

289
00:19:52,830 --> 00:19:57,340
!أراك لاحقًا؟ ألا تأبهين بأنَّه قام بتقبيلكِ قبل قليل؟

290
00:19:57,340 --> 00:20:00,550
.كم هذا عتيق. تصرفُك هذا يوحي أنَّك رجل عجوز

291
00:20:00,550 --> 00:20:02,880
!إنَّها غير مهتمة! غير مهتمة بتاتًا

292
00:20:20,070 --> 00:20:21,780
.أنتِ مستيقظة

293
00:20:21,780 --> 00:20:23,530
أنتِ؟

294
00:20:23,530 --> 00:20:27,830
.شخصٌ أُنقذَ من قِبل الشخص الذي التقيتِ به قبل قليل

295
00:20:30,450 --> 00:20:34,080
.سأجعل الجميع يرى هاروتو-سان الآن

296
00:20:47,300 --> 00:20:50,310
هل هذا هاروتو-سان؟

297
00:20:50,310 --> 00:20:52,850
ما الذي حدث لهاروتو-سان؟

298
00:20:56,810 --> 00:20:58,020
هل رأيتِ هذا؟

299
00:20:58,020 --> 00:20:58,950
.أجل

300
00:20:59,360 --> 00:21:00,690
ماذا يعني هذا؟

301
00:21:00,690 --> 00:21:02,650
منذ متى وهو نائم؟

302
00:21:06,320 --> 00:21:09,780
إيفا نائمة في الجانب الآخر من هذا الباب؟

303
00:21:09,780 --> 00:21:11,410
.إنَّها يقظة الآن

304
00:21:11,410 --> 00:21:12,500
ماذا؟

305
00:21:12,500 --> 00:21:13,960
إيفا يقظة؟

306
00:21:22,380 --> 00:21:28,640
!اصغوا يا ناس! إنَّ الإلهة إيفا قد استيقظت

307
00:21:28,640 --> 00:21:31,010
!وقت خلاصنا بين يدينا

308
00:21:38,270 --> 00:21:40,060
.إنَّها بداية النهاية

309
00:21:45,150 --> 00:21:47,490
.حان وقت لقاء الإلهة

310
00:23:29,010 --> 00:23:31,340
.الحلم... ينتهي

311
00:23:31,930 --> 00:23:33,310
.ينتهي

312
00:23:33,930 --> 00:23:37,150
."الحلقة القادمة "تنهّد إيفا

313
00:23:36,040 --> 00:23:42,410
"تنهد إيفا"