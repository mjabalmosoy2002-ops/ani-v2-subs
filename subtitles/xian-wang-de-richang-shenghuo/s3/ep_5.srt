1
00:00:14,060 --> 00:00:14,850
،كيوميا

2
00:00:15,140 --> 00:00:17,220
لا تعرفين لمَ خسرتِ

3
00:00:17,970 --> 00:00:19,310
ماذا؟

4
00:00:20,220 --> 00:00:21,270
السبب

5
00:00:21,970 --> 00:00:23,560
أنّكِ الوحيدة التي لا تتابع هذا الأنمي

6
00:00:26,020 --> 00:00:28,140
سوق تحف سونغهاي الليليّ

7
00:00:34,970 --> 00:00:36,310
كم ثمن هذا؟

8
00:00:37,890 --> 00:00:39,390
فرن تنقية بعمر ألف عام

9
00:00:39,390 --> 00:00:41,350
سعره منخفضٌ جدّاً

10
00:00:42,100 --> 00:00:44,600
مجسّمات روحيّة قديمة، أملكها كلّها

11
00:00:48,220 --> 00:00:49,680
تتحلّى ببصيرة حادة يا صديقي

12
00:00:50,310 --> 00:00:52,680
باختيارك لكنز متجري

13
00:00:53,310 --> 00:00:55,180
انظر إليه

14
00:00:55,600 --> 00:00:57,520
،انظر لزخرفة السطع

15
00:00:57,520 --> 00:00:58,560
،الصدأ البلّوري

16
00:00:58,560 --> 00:01:00,890
والنحت، تنّينان يلعبان بلؤلؤة

17
00:01:01,520 --> 00:01:05,100
هذا سيف قتل تنانين أصليّ
من سنين تشيانلونغ

18
00:01:06,890 --> 00:01:08,270
ليس سيّئاً

19
00:01:08,270 --> 00:01:10,350
لكنّه لا يبدو بذاك القدم

20
00:01:14,850 --> 00:01:16,680
،لأخبرك الحقيقة

21
00:01:16,680 --> 00:01:20,270
فقد خرج هذا السيف للتوّ
من كهف مُصطلح

22
00:01:21,640 --> 00:01:22,390
أأنت مُتأكّد؟

23
00:01:22,970 --> 00:01:25,100
طلب صديقٌ لي أن أبيعه لأجله

24
00:01:25,100 --> 00:01:27,270
كما أنّي لا أريد الاحتفاظ
بهذه القطعة الحامية

25
00:01:27,970 --> 00:01:30,600
يراودني شعورٌ أنّه كان مُقدّراً لك
لقاء السيف اليوم

26
00:01:30,600 --> 00:01:31,890
سأعطيك سعراً مُخفّضاً

27
00:01:31,890 --> 00:01:32,720
وسيكون من نصيبك

28
00:01:33,890 --> 00:01:35,350
حسناً، بكم؟

29
00:01:37,310 --> 00:01:38,020
ثمانون ألفاً

30
00:01:42,890 --> 00:01:44,020
هيّا بنا يا لينغلينغ

31
00:01:44,520 --> 00:01:45,680
بائع متجوّل طمّاع

32
00:01:46,600 --> 00:01:48,350
أسأت الفهم يا أخ

33
00:01:48,350 --> 00:01:49,350
قصدتُ ثمانية آلاف

34
00:01:49,560 --> 00:01:50,770
كلّا، ثمانون

35
00:01:50,770 --> 00:01:52,310
احتفظ بالسيف لنفسك

36
00:01:52,310 --> 00:01:53,350
لقتل تنّينك

37
00:03:29,310 --> 00:03:33,850
الحياة اليوميّة للملك الخالد      الموسم الثالث

38
00:03:33,850 --> 00:03:36,850
الحلقة الخامسة                   أنت سيفي

39
00:03:37,470 --> 00:03:39,970
،تحت البدر البارحة

40
00:03:40,640 --> 00:03:45,020
اجتمع كبار سيّافو هواشو الأربعة
في أعلى نقطة في سونغهاي

41
00:03:45,680 --> 00:03:48,770
لخوض منافسة مُسايفة
لم يسبق وأن شهدها العالم

42
00:03:49,140 --> 00:03:52,720
لتحديد من هو السيّاف
رقم واحد في العالم

43
00:03:53,810 --> 00:03:57,350
أُقيمت آخر منافسة مُسايفة
قبل ما يفوق مئة عام

44
00:03:57,350 --> 00:04:00,850
وصلت مهارات كافّة السيّافين
الأربعة للمستوى المُطلق

45
00:04:01,560 --> 00:04:03,270
...المعلّم "ي" من الجنوب هو

46
00:04:03,270 --> 00:04:04,560
حسناً، حسناً، توقّف عن الهراء

47
00:04:04,560 --> 00:04:05,180
أخبرنا كيف تنافسوا وحسب

48
00:04:08,470 --> 00:04:11,640
،قبل أن اُستلّت السيوف من أغمادها حتّى

49
00:04:12,100 --> 00:04:15,140
كانت قوّتهم محسوسةً في أرجاء المكان

50
00:04:15,640 --> 00:04:19,890
في تلك اللحظة، هبط سيّافٌ
غامض مُكتسٍ بالبياض

51
00:04:20,560 --> 00:04:23,180
،كان تعتمر قبّعة خيزران

52
00:04:23,180 --> 00:04:25,350
،معطفاً أبيضاً

53
00:04:25,350 --> 00:04:27,220
مع سيفٍ أبيض في يدها

54
00:04:27,220 --> 00:04:30,430
تألّق لمعانه في ضوء القمر

55
00:04:31,770 --> 00:04:33,560
أقوى سيوف هواشو

56
00:04:34,060 --> 00:04:35,770
مجتمعةٌ هنا

57
00:04:37,270 --> 00:04:38,640
من أنتِ

58
00:04:38,640 --> 00:04:40,220
كي تقاطعي مُنافستنا؟

59
00:04:41,140 --> 00:04:42,640
تعالوا وقاتلوني، أنتم الأربعة معاً

60
00:04:43,140 --> 00:04:44,770
،اعتراهم الغضب

61
00:04:44,770 --> 00:04:48,140
واستلّ السيّافون الأربعة سيوفهم
في الآن ذاته

62
00:04:48,270 --> 00:04:50,890
،لكن بلمح البصر

63
00:04:50,890 --> 00:04:52,970
،ومض بريقٌ أمام أعينهم

64
00:04:52,970 --> 00:04:55,470
وثُنيت كافّة السيوف الأربعة

65
00:04:55,470 --> 00:04:58,470
هُزِموا جميعاً في لحظة

66
00:05:00,430 --> 00:05:02,520
أنتم الحشرات الصغيرة

67
00:05:02,520 --> 00:05:03,850
لستم السيوف التي أبحث عنها

68
00:05:04,390 --> 00:05:07,470
ثمّ نقرت السيّافة الغامضة

69
00:05:07,470 --> 00:05:09,560
الأرض برفقٍ بأطراف أصابعها

70
00:05:09,560 --> 00:05:12,770
واختفت في ظُلمة الليل

71
00:05:12,770 --> 00:05:14,350
اختلقت هذا، أليس كذلك؟

72
00:05:14,350 --> 00:05:16,180
لا يمكن لأحدٍ هزيمة أربعة سيّافين

73
00:05:16,810 --> 00:05:18,140
كنتُ أروي الحقيقة

74
00:05:18,140 --> 00:05:19,640
شاهدتُ ذلك في بثّ حيّ

75
00:05:20,220 --> 00:05:21,640
تشين تشاو، وانغ لينغ

76
00:05:22,680 --> 00:05:23,180
موجودان

77
00:05:23,180 --> 00:05:24,430
تعالا للساحة لاختباركما

78
00:05:24,810 --> 00:05:25,470
قادمان

79
00:05:33,890 --> 00:05:35,220
،أخ وانغ

80
00:05:35,220 --> 00:05:36,600
أليس بحوزتك سيفٌ أفضل؟

81
00:05:37,470 --> 00:05:39,930
،إن حطّمتُ سيفك الخشبيّ الصغير

82
00:05:39,930 --> 00:05:41,220
لا تطلب منّي دفع ثمنه

83
00:06:09,810 --> 00:06:11,770
!لي تشاو

84
00:06:14,890 --> 00:06:16,060
قلت أنّك لن تستعمل كامل قوّتك

85
00:06:18,100 --> 00:06:19,770
!لي تشاو

86
00:06:18,390 --> 00:06:19,390
جينغكي

87
00:06:19,770 --> 00:06:20,640
قل شيئاً

88
00:06:21,770 --> 00:06:22,520
!لي تشاو

89
00:06:22,520 --> 00:06:24,100
ثُني لهذا الحدّ

90
00:06:24,720 --> 00:06:26,680
أعتقد أنّ لا بدّ
من إعادة صوغه

91
00:06:32,890 --> 00:06:33,970
ما الخطب؟

92
00:06:34,180 --> 00:06:35,560
لا تطيعني مُحيطاتي

93
00:06:39,020 --> 00:06:40,140
انتبه يا أخ وانغ

94
00:06:44,890 --> 00:06:45,970
ما الذي يجري؟

95
00:06:55,560 --> 00:06:56,770
واصل يا رئيس تشين

96
00:07:02,180 --> 00:07:05,100
كيف يمتلك سيف الأخ وانغ
قوّةً مغناطيسية هائلة كهذه؟

97
00:07:05,680 --> 00:07:08,390
أمن المُحتمل أنّ سيف وانغ لينغ
وصل مرحلة الاستفاقة

98
00:07:09,350 --> 00:07:10,680
مرحلة الاستفاقة؟

99
00:07:11,060 --> 00:07:11,600
أجل

100
00:07:12,270 --> 00:07:14,810
بعد تمرين السيف الروحي
،من قبل سيّده لفترة

101
00:07:14,810 --> 00:07:16,180
سيصل مرحلة الاستفاقة

102
00:07:16,640 --> 00:07:20,020
في هذه المرحلة، يصبح السيف
مُهتاجاً وعدائيّاً ومُتمرّداً

103
00:07:20,600 --> 00:07:23,100
لمَ تنجذب محيطاتي لجينغكي؟

104
00:07:23,560 --> 00:07:26,680
هذا لأنّ السيف في مرحلة الاستفاقة
ينتج مجالاً مغناطيسيّاً

105
00:07:27,270 --> 00:07:28,720
في المجال، تتنافر السيوف

106
00:07:28,720 --> 00:07:29,810
من الجنس نفسه

107
00:07:29,810 --> 00:07:30,640
بينما تنجذب المتضادة لبعضها

108
00:07:32,310 --> 00:07:33,600
هل ثُني سيفي لي تشاو

109
00:07:33,600 --> 00:07:34,810
بسبب ذلك؟

110
00:07:35,180 --> 00:07:36,310
ماذا سنفعل الآن؟

111
00:07:36,680 --> 00:07:38,220
ثُنيت سيوفنا الروحيّة هكذا

112
00:07:38,220 --> 00:07:39,470
لا يمكننا مواصلة الاختبار

113
00:07:40,720 --> 00:07:41,640
لديّ فكرة

114
00:07:41,640 --> 00:07:43,430
لمَ لا ترافقوني لمقبرة السيوف؟

115
00:07:43,720 --> 00:07:44,810
مقبرة السيوف؟

116
00:07:48,640 --> 00:07:50,810
،أخت لين

117
00:07:50,810 --> 00:07:51,930
لمَ اخترتِ العيش هنا؟

118
00:07:52,970 --> 00:07:54,600
وجدتُ أختي الروحيّة بالسيف

119
00:07:55,100 --> 00:07:57,390
وانتقلنا للعيش هنا

120
00:07:59,810 --> 00:08:02,180
لمَ توجد الكثير من السيوف
المحطّمة المغروسة بالأرض؟

121
00:08:02,680 --> 00:08:04,770
لأنّ هذه مقبرة السيوف الروحيّة

122
00:08:05,350 --> 00:08:08,270
السيوف التي لم تُصغ بشكلٍ جيّد
أو قد شُوهّت لحدّ لا يقبل الإصلاح

123
00:08:08,270 --> 00:08:09,350
تُرسل كلّها هنا

124
00:08:10,890 --> 00:08:12,470
أهذا المكان الذي ترعرعتِ فيه؟

125
00:08:13,350 --> 00:08:14,270
أجل

126
00:08:14,270 --> 00:08:17,180
لذا كانت لديّ الكثير من المواد
لاستعمالها لتعلّن صياغة السيوف

127
00:08:18,470 --> 00:08:19,390
لا تقلقوا

128
00:08:19,390 --> 00:08:21,310
ستتمكّن أختي من إصلاح سيوفكم

129
00:08:23,060 --> 00:08:24,640
رجعنا يا أختي

130
00:08:30,930 --> 00:08:31,720
شياويو

131
00:08:32,140 --> 00:08:33,390
رجعتِ باكراً اليوم

132
00:08:34,720 --> 00:08:36,100
لديكِ أصدقاءٌ معكِ

133
00:08:36,770 --> 00:08:37,890
أختي

134
00:08:37,890 --> 00:08:40,770
تلفت سيوفنا بشكلٍ ما أثناء تمريننا

135
00:08:40,770 --> 00:08:42,140
نريد منكِ إلقاء نظرةٍ عليها

136
00:08:44,350 --> 00:08:45,520
،أختاه

137
00:08:45,520 --> 00:08:47,470
فلتري ما إن كان بإمكانكِ
إنقاذ سيفي لي تشاو من فضلكِ

138
00:08:49,810 --> 00:08:51,560
لا تقفوا في الفناء

139
00:08:51,560 --> 00:08:52,600
ادخلوا الغرفة وتفضّلوا بالجلوس

140
00:09:01,810 --> 00:09:03,100
ليس بالخطب الكبير

141
00:09:03,100 --> 00:09:04,310
السطح مثنيّ لناحية

142
00:09:04,310 --> 00:09:05,220
سيكون بخيرٍ بمجرّد تقويمه

143
00:09:06,600 --> 00:09:07,720
،أختاه

144
00:09:07,720 --> 00:09:10,100
فلتلقي نظرةً على محيطاتي رجاءً

145
00:09:11,560 --> 00:09:13,430
ما خطب كلّ هذه السيوف؟

146
00:09:14,850 --> 00:09:17,220
يصعب القول

147
00:09:17,220 --> 00:09:18,770
تفقّديها وسترين

148
00:09:26,310 --> 00:09:28,140
أخ وانغ، ما خطب سيفك؟

149
00:09:29,890 --> 00:09:33,180
محيطاتي، لمَ أنتِ حزينة؟

150
00:09:37,060 --> 00:09:38,390
فهمتُ الآن

151
00:09:38,600 --> 00:09:51,390
(يعتنق البحر كافّة الأنهار)

152
00:09:38,810 --> 00:09:40,770
ينجذب سيفٌ روحيّ وصل مرحلة استفاقته

153
00:09:40,770 --> 00:09:42,520
إلى سيفٍ من الجنس المعاكس

154
00:09:43,270 --> 00:09:45,020
لكنّ هذه أوّل مرّة
أرى فيها سيفاً

155
00:09:45,020 --> 00:09:46,390
بمجال مغناطيسيّ قويّ كهذا

156
00:09:47,430 --> 00:09:48,220
لا أفهم

157
00:09:48,810 --> 00:09:51,140
أخ وانغ، سيفك مصنوعٌ من خشب الدراق

158
00:09:51,140 --> 00:09:52,270
كيف يمتلك قوّةً مغناطيسيّة؟

159
00:09:53,060 --> 00:09:56,220
يشعر السيف في مرحلة استفاقته
بالتوتّر والارتباك عادةً

160
00:09:56,470 --> 00:09:57,850
مما يؤدي لجعله مُتمرّداً

161
00:09:58,520 --> 00:10:00,060
الحقل المغناطيسيّ هو التعبير الخارجيّ

162
00:10:00,060 --> 00:10:01,060
لمشاكل السيف النفسيّة

163
00:10:01,770 --> 00:10:04,060
لا بدّ من التواصل والإرشاد اللائقين هنا

164
00:10:04,560 --> 00:10:07,720
أتعنين أنّ علينا إعطاء
السيف استشارةً نفسيّة؟

165
00:10:08,220 --> 00:10:09,060
أيّ أحد في المنزل؟

166
00:10:13,100 --> 00:10:13,770
...معلّمي

167
00:10:14,390 --> 00:10:15,140
،أيّها التلامذة

168
00:10:15,560 --> 00:10:16,680
ما الذي جلبكم هنا؟

169
00:10:17,310 --> 00:10:18,100
،أخ زو

170
00:10:18,600 --> 00:10:20,060
كلّهم أصدقاء شيايو

171
00:10:20,060 --> 00:10:21,220
أأتوا لإصلاح سيوفهم

172
00:10:22,520 --> 00:10:23,470
فهمت

173
00:10:24,680 --> 00:10:27,180
ما قصّة السيف الملتصق بمعدتك؟

174
00:10:29,470 --> 00:10:31,430
معلّم زو، لننسَ ذلك للوقت الراهن

175
00:10:31,430 --> 00:10:33,180
هل أتيت لإصلاح سيفك أيضاً؟

176
00:10:33,890 --> 00:10:34,680
أجل

177
00:10:36,220 --> 00:10:37,560
ما الذي حلّ به؟

178
00:10:39,220 --> 00:10:40,680
لا بدّ أنّكم سمعتم

179
00:10:40,680 --> 00:10:42,890
بالسيّافة ذات الرداء الأبيض
التي ظهرت مؤخّراً في سونغهاي

180
00:10:43,850 --> 00:10:47,060
،تحدّت كلّ سيّافٍ التقته لمُبارزةٍ هذه الأيّام

181
00:10:47,060 --> 00:10:49,140
مما أثّر بشكلٍ كبير على الأمن العام

182
00:10:49,140 --> 00:10:51,180
حُرّكت الفرقة سباعيّة النجوم للإمساك بها

183
00:10:52,640 --> 00:10:53,680
ما الذي حصل بعدها؟

184
00:10:57,020 --> 00:10:58,100
...يبدو

185
00:10:58,220 --> 00:11:00,520
أنّ طريقة تلف السيف مألوفة

186
00:11:01,140 --> 00:11:03,270
أيّ سيفٍ تستعمله السيّافة
ذات الرداء الأبيض؟

187
00:11:03,770 --> 00:11:06,020
طوله يبلغ قرابة 33.5 سم، ومصنوعٌ من خشب الدراق

188
00:11:06,020 --> 00:11:07,220
،عدائيٌّ جدّاً

189
00:11:07,220 --> 00:11:08,470
ويمتلك حقلاً مغناطيسياً قويّاً

190
00:11:09,270 --> 00:11:11,890
أثناء القتال، جذب كلّ سيوفنا إليه وثناها

191
00:11:18,060 --> 00:11:18,890
مرحباً؟

192
00:11:20,310 --> 00:11:20,930
ماذا؟

193
00:11:21,430 --> 00:11:22,720
ظهرت السيّافة ذات الرداء الأبيض مُجدّداً؟

194
00:11:23,470 --> 00:11:25,520
حضرة القائدة، كلّ سيوفنا مثنيّة

195
00:11:25,520 --> 00:11:26,770
لا يمكننا القتال بلا سيوف

196
00:11:27,560 --> 00:11:28,220
،معلّم زو

197
00:11:28,220 --> 00:11:29,020
لمَ لا ترسلنا هناك؟

198
00:11:29,310 --> 00:11:30,350
فلتبقوا هنا حتّى تُصلح سيوفكم

199
00:11:31,100 --> 00:11:32,270
...لكن

200
00:11:32,270 --> 00:11:33,680
لا تزالون طلّاب صفٍّ أعلى

201
00:11:35,060 --> 00:11:36,220
لا تنسَ

202
00:11:36,220 --> 00:11:38,180
أنّنا قاتلنا جنباً لجنب

203
00:11:38,180 --> 00:11:39,220
وهزمنا جنس الشياطين

204
00:11:48,310 --> 00:11:49,640
ضعفاء جدّاً

205
00:11:49,640 --> 00:11:52,180
ألا تملكون سيفاً واحداً
يمكنه تحمّل ضربتي؟

206
00:11:52,810 --> 00:11:53,680
!فلتنالوا منها

207
00:11:59,180 --> 00:11:59,930
آنستي الشابة

208
00:12:00,350 --> 00:12:02,770
سلوك تلك السيّافة غريب

209
00:12:02,770 --> 00:12:04,220
حاول الكثير من رجالنا قتالها

210
00:12:04,220 --> 00:12:05,720
لكن تلفت كافّة أسلحتهم

211
00:12:06,310 --> 00:12:07,520
،إن استمرّ هذا

212
00:12:07,520 --> 00:12:09,220
لن نمتلك أسلحةً كافية في مخزوننا

213
00:12:09,890 --> 00:12:10,680
بلاغ

214
00:12:12,020 --> 00:12:13,970
آنستي الشابة، الفرقة سباعيّة النجوم قادمة

215
00:12:15,430 --> 00:12:16,270
لنرحل من هنا

216
00:12:24,270 --> 00:12:25,350
،كالمُتوقّع

217
00:12:25,850 --> 00:12:28,270
أنتم لستم السيوف
التي أبحث عنها أيضاً

218
00:12:52,430 --> 00:12:53,350
!حركة جميلة يا شياويو

219
00:12:56,600 --> 00:12:58,560
أتى سيفٌ الآن لا ينثني

220
00:13:05,600 --> 00:13:07,640
يمتلك هؤلاء الرفاق المُصطلحون
الصغار من الحزب 60 إمكانيّات عظيمة

221
00:13:08,060 --> 00:13:09,520
لكنّ مهاراتهم ليست عاليةً بما يكفي

222
00:13:09,520 --> 00:13:10,520
للصمود طويلاً

223
00:13:11,390 --> 00:13:13,680
متى ستقوم بحركتك معلّمي؟

224
00:13:14,930 --> 00:13:16,560
جينغكي، توقّف عن العبث

225
00:13:17,140 --> 00:13:18,180
حان وقت القتال

226
00:13:18,350 --> 00:13:19,350
كلّا

227
00:13:24,930 --> 00:13:27,270
السيوف في مرحلة استفاقتها
تكون مُتمرّدةً في العادة

228
00:13:27,270 --> 00:13:29,140
يمكن أن يؤدي الضغط عليها لنتائج عكسيّة

229
00:13:29,970 --> 00:13:31,220
،أيّها الأخ الصغير

230
00:13:31,220 --> 00:13:33,060
لمَ تلتصق بي؟

231
00:13:33,270 --> 00:13:35,060
لأنّي أحبّك يا أختي

232
00:13:36,180 --> 00:13:38,970
أتعرف أيّ نوع من السيوف
الروحيّة أفضّلها؟

233
00:13:40,430 --> 00:13:42,810
أيّ نوع من السيوف الروحيّة
تفضّلين يا أختي؟

234
00:13:42,810 --> 00:13:44,600
أحبّ السيوف القويّة

235
00:13:44,600 --> 00:13:46,350
القادرة على حماية الآخرين

236
00:13:47,350 --> 00:13:49,470
أنا قويٌّ جدّاً يا أختي

237
00:13:59,100 --> 00:14:00,930
أخ وانغ، توخَّ الحذر

238
00:14:04,930 --> 00:14:06,720
أيّ أحد آخر؟

239
00:14:13,020 --> 00:14:15,810
!لن أسمح لكِ بإيذاء أختي

240
00:14:18,520 --> 00:14:19,600
لحظة

241
00:14:19,600 --> 00:14:20,520
...إنّها

242
00:14:21,930 --> 00:14:23,600
حسناً حسناً، لينغلينغ

243
00:14:23,600 --> 00:14:25,100
أعرف، أعرف

244
00:14:25,100 --> 00:14:26,310
حسنٌ، لقد فزت

245
00:14:26,310 --> 00:14:27,810
إنّه محض سيفٍ خشبيّ صغير

246
00:14:27,810 --> 00:14:28,640
سأشتريه لك

247
00:14:30,310 --> 00:14:32,640
يبدو أنّك غيرت رأيك يا صديقي

248
00:14:32,640 --> 00:14:34,970
احتفظتُ بسيف قتل التنانين لك

249
00:14:35,140 --> 00:14:36,140
هراء

250
00:14:36,520 --> 00:14:37,850
لا أريد ذاك السيف

251
00:14:39,770 --> 00:14:41,220
كم يكلّف سيف خشب الدراق هذا؟

252
00:14:41,220 --> 00:14:42,430
ثمنه 998

253
00:14:42,430 --> 00:14:43,720
أأنت مجنون؟

254
00:14:44,140 --> 00:14:45,930
أرى أنّ ثمن هذا الشيء الصغير 9.8 فحسب

255
00:14:45,930 --> 00:14:47,970
فلتكن جاداً يا سيّدي

256
00:14:48,520 --> 00:14:50,430
هذا مصنوعٌ من شجر فوبيزهينان أصيل

257
00:14:50,430 --> 00:14:51,470
يا عمّ

258
00:14:52,600 --> 00:14:53,720
أين غمد السيف؟

259
00:14:58,100 --> 00:14:59,930
السيف وغمده ثنائيّ

260
00:14:59,930 --> 00:15:02,060
لفقد فقدت الغمد

261
00:15:02,060 --> 00:15:03,350
وتحاول الآن بيع سيفٍ ناقص
بثمنٍ باهظ كهذا

262
00:15:06,220 --> 00:15:07,970
لنذهب للبيت يا لينغلينغ

263
00:15:07,970 --> 00:15:09,770
لا أستطيع البقاء أكثر
في كشك متجرٍ محتال

264
00:15:16,310 --> 00:15:18,060
أخيراً

265
00:15:18,060 --> 00:15:19,060
وجدتك

266
00:15:19,470 --> 00:15:20,810
أختي

267
00:15:26,220 --> 00:15:28,970
أنت سيفي

268
00:16:57,270 --> 00:16:58,430
،في ليلة التاسع والعشرين من سبتمبر

269
00:16:58,430 --> 00:17:01,060
قام المعلّم زو والفرقة سباعيّة النجوم

270
00:17:01,060 --> 00:17:02,100
باعتقال السيّاف ذو الرداء الأبيض

271
00:17:02,100 --> 00:17:03,640
الذي أجبر الناس على القتال
معه في شوارع سونغهاي

272
00:17:04,140 --> 00:17:05,390
،وفقاً لإدارة الاصطلاح

273
00:17:05,390 --> 00:17:07,600
المُشتبه به محتجزٌ الآن في السجن الأعلى

274
00:17:07,600 --> 00:17:08,970
شكراً لك معلّمي

275
00:17:08,970 --> 00:17:10,640
على حلّ قضيّة غريبة أخرى

276
00:17:10,640 --> 00:17:12,180
هل تولّيت تنظيف الأمور؟

277
00:17:12,180 --> 00:17:14,100
لا تقلق، قمتُ بكلّ الترتيبات الضروريّة

278
00:17:14,680 --> 00:17:16,600
لن يعرف أحدٌ بتدخّلك

279
00:17:17,060 --> 00:17:18,770
،بعدما وجدت غمدك الآن

280
00:17:18,770 --> 00:17:20,350
يُفترض أن يزول المجال المغناطيسيّ للسيف

281
00:17:21,520 --> 00:17:22,470
أجل

282
00:17:23,600 --> 00:17:25,430
،مهما بلغت حدّة السيف

283
00:17:25,430 --> 00:17:26,890
يحتاج غمداً لحمايته

284
00:17:29,220 --> 00:17:30,470
أجل معلّمي

285
00:17:30,470 --> 00:17:31,850
أين غمدك؟

286
00:17:32,270 --> 00:17:33,220
إنّها تُلقّن درساً

287
00:17:33,770 --> 00:17:34,680
درس؟

288
00:17:39,700 --> 00:17:43,650
كنتُ مخطئةً يا أختي، دعيني أذهب رجاءً

289
00:17:45,140 --> 00:17:46,430
مستحيل

290
00:17:46,430 --> 00:17:48,350
أتلفتِه وعليك إصلاحه بنفسكِ

291
00:17:48,350 --> 00:17:49,350
عليكِ إصلاح كلّ السيوف

292
00:17:52,310 --> 00:17:54,140
أريد لعب ألعاب الفيديو