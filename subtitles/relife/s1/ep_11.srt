1
00:00:04,690 --> 00:00:05,980
.يواكي-كن

2
00:00:06,940 --> 00:00:08,020
هل لديك بعض الوقت؟

3
00:00:11,240 --> 00:00:12,610
ماذا؟

4
00:00:12,610 --> 00:00:15,030
.أخبرتك ألاّ تتحدّث إليّ كثيرًا في المدرسة

5
00:00:15,030 --> 00:00:16,570
.أريد العقّار الّذي يجعلني طبيعيًّا مرّة أخرى

6
00:00:18,160 --> 00:00:20,910
.هذه المرّة الثّانية

7
00:00:20,910 --> 00:00:25,750
طلبته منّي مرّة قبل أن تبدأ المدرسة لكي
.تتمكّن من الاستقالة من عملك بشكلٍ رسميّ

8
00:00:26,330 --> 00:00:28,130
لِمَ تريده هذه المرّة؟

9
00:00:29,960 --> 00:00:32,010
.أريد زيارة قبر

10
00:00:33,840 --> 00:00:35,720
.أعلم أنّك بحثت في الأمر

11
00:00:36,180 --> 00:00:38,300
تعرف بشأن زميلتي السّينباي في تلك الشّركة، صحيح؟

12
00:00:38,970 --> 00:00:40,100
...هذا الإثنين

13
00:00:41,520 --> 00:00:42,770
.هو ذكرى يوم وفاتها

14
00:02:16,150 --> 00:02:18,610
ألا يمكنك الذّهاب بهذه الهيئة؟

15
00:02:18,610 --> 00:02:22,700
وأخاطر بمصادفة أحد زملاء عملنا السّابقين؟

16
00:02:22,700 --> 00:02:26,000
.ليس وكأنّ أيّ أحدٍ منهم سيأتي

17
00:02:27,330 --> 00:02:28,710
.حسنًا

18
00:02:28,710 --> 00:02:30,420
.سآتي معك إذًا

19
00:02:30,420 --> 00:02:32,040
!ماذا؟ لا

20
00:02:32,040 --> 00:02:34,920
.هيّا، لا تكن لئيمًا

21
00:02:35,250 --> 00:02:36,840
.لا، حقًّا

22
00:02:36,840 --> 00:02:40,470
،أعرف أنّه عليك أن تراقبني
.لذا افعل ذلك عن بعد كالعادة

23
00:02:40,470 --> 00:02:42,010
.لا حاجة لأن تأتي معي

24
00:02:42,010 --> 00:02:43,760
.كنّا نشاهد

25
00:02:43,760 --> 00:02:48,890
نعرف أنّك لم تحرّك ساكنًا عند
.قبر سايكي-سان السّنة الماضية

26
00:02:50,520 --> 00:02:53,020
.نحن قلقون بشأن ذلك

27
00:02:53,020 --> 00:02:56,530
.قلقون أنّك قد تتبعها بتهوّر

28
00:02:56,530 --> 00:03:00,150
.أو ألاّ تستطيع التّحكّم بنفسك إن ظهر أحد زملاء العمل

29
00:03:00,740 --> 00:03:02,950
!كـ-كان ذلك السّنة الماضية

30
00:03:02,950 --> 00:03:04,160
.أنا بخيرٍ تمامًا الآن

31
00:03:17,670 --> 00:03:19,220
ما الخطب؟

32
00:03:19,220 --> 00:03:21,130
.لا تبدو على ما يرام

33
00:03:21,130 --> 00:03:22,590
.لا تعبث معي

34
00:03:22,590 --> 00:03:25,720
.أيّ شخصٍ سيصفرّ وجهه إن حاول أحد خنقه

35
00:03:26,100 --> 00:03:28,020
.حسنًا، المعذرة

36
00:03:28,020 --> 00:03:30,690
.لكنّي لم أضغط بتلك القوّة

37
00:03:30,690 --> 00:03:34,110
.ولكنّك تبلي أفضل ممّا كنت تبلي بعد وقت استقالتك

38
00:03:34,110 --> 00:03:36,980
.لم تستطع حتّى إحكام ربطة عنق حينها

39
00:03:37,190 --> 00:03:39,690
تعرف حتّى بشأن ذلك أيضًا؟

40
00:03:39,690 --> 00:03:40,950
.بالطّبع

41
00:03:42,200 --> 00:03:46,370
،يمكنك زيارة القبر، وسأعطيك الدّواء
.ولكن فقط إن أتيت أنا معك

42
00:03:47,030 --> 00:03:48,040
مفهوم؟

43
00:03:48,580 --> 00:03:50,330
.افعل ما تشاء أيّها السّاديّ

44
00:03:50,330 --> 00:03:52,620
!أقدّر هذا المديح

45
00:03:52,620 --> 00:03:53,880
!لم أمدحك

46
00:04:09,220 --> 00:04:11,140
!يا سينباي

47
00:04:11,140 --> 00:04:13,520
ما الّذي تفعله؟

48
00:04:13,940 --> 00:04:17,320
.أكتب طلب دواء لكايزاكي-سان ولي

49
00:04:17,320 --> 00:04:19,360
!يمكنني معرفة هذا

50
00:04:19,360 --> 00:04:21,490
!أريد معرفة السّبب

51
00:04:22,030 --> 00:04:24,530
.يريد زيارة قبرها

52
00:04:25,280 --> 00:04:27,990
.إن لم تخنّي الذّاكرة، من الخطر عليه أن يذهب بمفرده

53
00:04:28,530 --> 00:04:30,040
!حسنًا، أنا سأذهب أيضًا

54
00:04:30,040 --> 00:04:31,040
.لا

55
00:04:31,790 --> 00:04:36,130
.سيوافقون على ذلك للدّاعم المُعيّن في المقام الأوّل

56
00:04:37,080 --> 00:04:40,840
!لا مشكلة بذهابي بهذه الهيئة

57
00:04:40,840 --> 00:04:43,930
رجلان بالغان وفتاةٌ في المرحلة الثّانويّة؟

58
00:04:43,930 --> 00:04:46,930
.لا شكرًا. لا أريد أن تستجوبني الشّرطة

59
00:04:48,640 --> 00:04:50,470
.ولكن آسف يا أونويا

60
00:04:50,970 --> 00:04:54,230
.أريد طلب معروفٍ منك

61
00:05:01,730 --> 00:05:04,110
ما هذه البدلة؟

62
00:05:04,110 --> 00:05:06,450
كيف عرفتِ أنّها بدلة؟

63
00:05:06,450 --> 00:05:08,280
.تبدو كواحدة

64
00:05:08,280 --> 00:05:09,780
.لحفل تأبينيّ

65
00:05:10,540 --> 00:05:13,410
.فهمت، أنا آسفة

66
00:05:13,410 --> 00:05:15,160
.لم يكن ينبغي عليّ التّطفّل

67
00:05:15,580 --> 00:05:19,040
.ليس من المعتاد أن تبدئي المحادثة

68
00:05:19,540 --> 00:05:21,050
.صحيح

69
00:05:21,050 --> 00:05:23,170
!تعترفين بذلك

70
00:05:25,420 --> 00:05:26,720
...هذا الدّواء

71
00:05:26,720 --> 00:05:31,100
.يتغيّر الجسم خلال ساعة من أخذه تقريبًا

72
00:05:31,640 --> 00:05:32,890
ماذا ستفعل؟

73
00:05:32,890 --> 00:05:36,390
هل نقضي هذه السّاعة معًا نقاتل
النّعاس من الأثر الجانبيّ؟

74
00:05:36,390 --> 00:05:37,690
.ذلك يبدو فظيعًا

75
00:05:38,270 --> 00:05:40,570
.نستطيع أخذ قيلولة

76
00:05:41,070 --> 00:05:42,320
.صحيح

77
00:05:43,190 --> 00:05:46,070
أنت تستيقظ بسهولة، أليس كذلك يا كايزاكي-سان؟

78
00:05:46,860 --> 00:05:48,110
...حسنًا

79
00:05:48,110 --> 00:05:50,530
أنت تطّلع حتّى على هذا؟

80
00:05:50,910 --> 00:05:51,830
.نعم

81
00:05:51,830 --> 00:05:54,330
،أنا من النّوع الّذي ينام ولا يسمع المنبّه

82
00:05:54,330 --> 00:05:56,960
.لذا أيقظني إن لم أستيقظ

83
00:05:58,120 --> 00:06:01,210
ماذا؟ لا تسمع المنبّه؟

84
00:06:01,210 --> 00:06:02,750
ماذا تفعل كلّ صباح؟

85
00:06:02,750 --> 00:06:07,720
.أنام جالسًا لكي لا أنام بعمق إن كانت لديّ أعمال

86
00:06:07,720 --> 00:06:08,760
!كالسّاموراي؟

87
00:06:08,760 --> 00:06:11,350
!كيف يمكن أن ترتاح هكذا؟

88
00:06:11,350 --> 00:06:15,310
.عليك تأدية وظيفتك إضافة للذّهاب إلى المدرسة

89
00:06:15,310 --> 00:06:16,980
!أنا جدّ سعيدٌ

90
00:06:16,980 --> 00:06:18,770
.أصبحنا قريبان للغاية

91
00:06:18,770 --> 00:06:21,980
!إنّك تقلق حتّى بشأني

92
00:06:22,320 --> 00:06:26,400
.عليك البحث عن حبيبةٍ توقظك

93
00:06:26,400 --> 00:06:27,240
ربّما آن؟

94
00:06:27,240 --> 00:06:29,860
!أرجوك لا

95
00:06:29,860 --> 00:06:33,450
!أشعر بالتّعب بمجرد تخيّل إيقاظها لي

96
00:06:34,120 --> 00:06:35,910
.أتفهّم ذلك

97
00:06:35,910 --> 00:06:37,910
.لا بدّ وأنّها تستيقظ وهي بغاية الحيويّة

98
00:06:39,750 --> 00:06:41,540
.لنأخذها

99
00:06:42,710 --> 00:06:44,750
.أراك بعد ساعة

100
00:07:03,520 --> 00:07:04,730
!يواكي-سان

101
00:07:06,530 --> 00:07:08,150
!حان الوقت يا يواكي-سان

102
00:07:09,400 --> 00:07:10,660
!هيّا، استيقظ

103
00:07:12,070 --> 00:07:13,700
.لا يمكنني. أشعر بالنّعاس

104
00:07:13,700 --> 00:07:15,790
!لستَ كذلك! استيقظ

105
00:07:15,790 --> 00:07:16,660
.اصمت

106
00:07:16,660 --> 00:07:19,580
!أنت من أخبرني أن أوقظك

107
00:07:21,210 --> 00:07:23,170
.إيقاظك متعبٌ جدًّا

108
00:07:23,170 --> 00:07:25,170
.أنا آسف

109
00:07:26,210 --> 00:07:30,680
.مرّت أربعة شهور منذ أن رأينا بعضنا كبالغين

110
00:07:33,640 --> 00:07:35,010
.مساء الخير

111
00:07:35,010 --> 00:07:37,680
.مسرورٌ للقائك يا كايزاكي أراتا-سان

112
00:07:38,560 --> 00:07:40,560
الوقت يمرّ بسرعة، صحيح؟

113
00:07:40,890 --> 00:07:43,350
.مرّت ثلث المدّة

114
00:07:43,350 --> 00:07:47,400
هل بدوت حزينًا للتّوّ لأنّك كنت تتخيّل
انتهاء هذه التّجربة؟

115
00:07:47,400 --> 00:07:48,360
!لا

116
00:07:48,860 --> 00:07:54,280
كما قلت، أنا مشاركٌ في هذا من أجل
.تكاليف المعيشة لسنة وتقديم الوظيفة

117
00:07:55,490 --> 00:07:57,490
.لن أكون حزينًا

118
00:08:20,060 --> 00:08:21,480
هل أنت بخير؟

119
00:08:21,480 --> 00:08:22,730
.نحن هنا لمدّة

120
00:08:22,770 --> 00:08:25,060
.أنا بخير. اصمت

121
00:08:25,310 --> 00:08:27,770
.أنا أتحدّث مع سينباي

122
00:08:30,230 --> 00:08:31,320
...المعذرة

123
00:08:31,320 --> 00:08:32,990
هل أنت حقًّا بخير؟

124
00:08:33,320 --> 00:08:36,820
!اصمت يا عديم اللّباقة

125
00:08:36,820 --> 00:08:37,660
.أنا بخير

126
00:08:38,330 --> 00:08:39,160
.يا إلهي

127
00:08:42,960 --> 00:08:44,000
.كايزاكي-كن

128
00:08:45,580 --> 00:08:47,750
من أين نأكل الغداء؟

129
00:08:48,130 --> 00:08:51,840
!كانت تلك أوّل عملية بيع كبيرةٍ لك

130
00:08:52,090 --> 00:08:54,380
.دع ميتشيرو-سينباي تدفع لك الغداء

131
00:08:55,130 --> 00:08:57,720
.كنت موظّفًا جديدًا وكانت هي مدرّبتي

132
00:08:57,720 --> 00:09:00,010
.كان سجلّ مبيعاتها أفضل من أيّ موظف

133
00:09:00,770 --> 00:09:02,100
كنت متفاجئًا في البداية

134
00:09:02,100 --> 00:09:05,390
.من العمل تحت قيادة امرأة في المبيعات

135
00:09:06,270 --> 00:09:09,520
.ولكن سايكي ميتشيرو-سينباي كانت ودودة جدًّا

136
00:09:11,730 --> 00:09:16,320
عملٌ لساعاتٍ إضافيّة كلّ يوم وعمل شاقّ
.وأجورٌ غير منصفة أبدًا

137
00:09:16,320 --> 00:09:18,910
.الجوُّ العامّ كان متوتّرًا دائمًا

138
00:09:18,910 --> 00:09:21,330
الوظيفة الّتي وجدتها بصعوبة

139
00:09:21,660 --> 00:09:24,160
.كانت إحدى تلك الشّركات السّوداء

140
00:09:26,120 --> 00:09:29,250
ماذا؟ هل فقدت حماسك؟

141
00:09:29,250 --> 00:09:31,340
.تماسك يا كايزاكي-كن

142
00:09:32,000 --> 00:09:35,420
.ومع ذلك، استمتَعت سينباي بوظيفتها بوضوح

143
00:09:35,420 --> 00:09:38,010
.كانت قويّة ولطيفة

144
00:09:38,010 --> 00:09:40,810
.احترمتها، وهي كانت تدعمني

145
00:09:45,980 --> 00:09:47,440
...سينباي، هذا

146
00:09:47,770 --> 00:09:50,310
.هذا لم يكن خطأك

147
00:09:50,310 --> 00:09:51,860
!لا بدّ وأنّ أحدًا ما فعل هذا بك

148
00:09:52,730 --> 00:09:56,820
.الكثير من الأشخاص يكرهونني فقط لأنّني امرأة

149
00:09:57,320 --> 00:09:58,870
!أنا اكتفيت

150
00:09:59,410 --> 00:10:01,990
!إن لم تقولي شيئًا، فأنا سأفعل

151
00:10:02,870 --> 00:10:07,120
.أنت مُحقّ، وأنا مسرورةٌ لأنّك تشعر بهذا الشّعور

152
00:10:07,120 --> 00:10:10,000
.ولكنّي لا أريدك أن تتدخّل

153
00:10:10,670 --> 00:10:12,630
.شكرًا لك يا كايزاكي-كن

154
00:10:12,630 --> 00:10:14,550
!سأكون بخير

155
00:10:14,550 --> 00:10:16,010
...لذا يا كايزاكي-كن

156
00:10:16,010 --> 00:10:17,760
.انضج

157
00:10:19,010 --> 00:10:21,350
.هذا ما قالته

158
00:10:21,350 --> 00:10:23,350
.ولكنّي لم أتحمّل

159
00:10:24,470 --> 00:10:26,640
لِمَ لا تستقيل؟

160
00:10:26,640 --> 00:10:29,270
.توقّفوا، الموظّف الجديد هنا

161
00:10:29,270 --> 00:10:32,900
إنّها مسؤولة عن تدريبه، صحيح؟

162
00:10:33,190 --> 00:10:35,900
.لا تشي بنا يا كايزاكي

163
00:10:37,570 --> 00:10:39,410
لِمَ لا تتوقّفون عن هذا؟

164
00:10:39,410 --> 00:10:42,160
!إنّكم رجالٌ بالغون، ألا تخجلون من أنفسكم؟

165
00:10:43,030 --> 00:10:44,580
،في النّهاية

166
00:10:44,580 --> 00:10:46,700
،تجاهلتُ ما قالته

167
00:10:46,700 --> 00:10:49,040
،وتصرّفت وفق حسّي الخاصّ بالعدالة

168
00:10:49,040 --> 00:10:51,710
.وبدّدت كل جهودها للتّحمّل

169
00:10:51,710 --> 00:10:54,380
.والنّتيجة، زادت المضايقات

170
00:10:56,420 --> 00:10:57,510
.أنا بخير

171
00:11:05,810 --> 00:11:08,350
.لطالما اعتقدت أنّها قويّة

172
00:11:11,150 --> 00:11:12,940
."ولكنّها لم تكن "بخير

173
00:11:21,990 --> 00:11:24,200
.أغلقت الشّرطة تحقيقها

174
00:11:24,200 --> 00:11:27,950
.قرّروا أنّه كان انتحارًا
.لم يكن هنالك آثار جريمة قتل

175
00:11:27,950 --> 00:11:31,210
.احرصوا على إبقاء هذا سريًّا

176
00:11:31,210 --> 00:11:32,290
.نعم

177
00:11:32,710 --> 00:11:35,170
...لو لم أفعل ذلك

178
00:11:35,170 --> 00:11:37,300
...لو لم أتدخّل

179
00:11:37,300 --> 00:11:38,300
.أخبرني

180
00:11:38,800 --> 00:11:41,590
من تعتقد أنّه سيترقّى بدلاً من سايكي؟

181
00:11:41,590 --> 00:11:44,010
لا أعلم... ربّما أنا؟

182
00:11:44,010 --> 00:11:45,720
.لا تغترّ بنفسك

183
00:11:45,720 --> 00:11:48,060
ما الّذي تقولانه في وقتٍ كهذا؟

184
00:11:48,060 --> 00:11:52,190
.كانت سايكي فخورةً جدًّا بشركتنا

185
00:11:52,190 --> 00:11:55,440
لا بدّ أنّ هذا هو سبب اختيارها
.أن يكون هذا هو مكانها الأخير

186
00:11:55,440 --> 00:11:57,570
.أحبّت هذا المكان إلى هذه الدّرجة

187
00:11:58,570 --> 00:12:02,530
.أُبقي الشّركة الّتي أحبّتها كثيرًا كمصدر فخرٍ واعتزازٍ لي

188
00:12:02,990 --> 00:12:04,950
.حسنًا، عودوا إلى العمل

189
00:12:07,080 --> 00:12:08,410
!ما هذا؟

190
00:12:09,410 --> 00:12:11,370
.توقّفوا

191
00:12:11,750 --> 00:12:13,620
!ما خطبكم جميعًا؟

192
00:12:13,620 --> 00:12:15,790
!هناك شخصٌ مات هنا

193
00:12:15,790 --> 00:12:17,300
!ألا تشعرون بأيّ شيءٍ على الإطلاق؟

194
00:12:17,670 --> 00:12:19,420
!كيف يمكنكم التّصرّف وكأنّ شيئًا لم يحدث؟

195
00:12:19,760 --> 00:12:22,680
!ألا تعتقدون أنّه ربّما كان خطأنا؟

196
00:12:24,930 --> 00:12:26,680
.اهدأ يا كايزاكي

197
00:12:26,680 --> 00:12:28,180
.لا تصبّ غضبك على الآخرين

198
00:12:29,100 --> 00:12:30,220
.اكتفيت

199
00:12:31,020 --> 00:12:32,390
!من هذه الشّركة

200
00:12:45,530 --> 00:12:47,030
.أنا أستقيل

201
00:12:50,200 --> 00:12:52,500
بعد ثلاثة شهور فقط؟

202
00:12:53,080 --> 00:12:56,040
.سيظنّ المجتمع أنّك جبان

203
00:12:56,630 --> 00:12:59,550
.ستبقى هذه الحقيقة في سيرتك الذّاتيّة إلى الأبد

204
00:13:00,000 --> 00:13:03,010
هل تعتقد أنّ هناك أحدًا آخر سيوظّفك؟

205
00:13:04,340 --> 00:13:06,800
.انضج يا كايزاكي

206
00:13:06,800 --> 00:13:08,390
.سأنسى حدوث هذا

207
00:13:10,720 --> 00:13:12,390
.انضج

208
00:13:13,980 --> 00:13:17,190
.أنا أخاف من الذّهاب للبحث عن وظيفة مرّة أخرى

209
00:13:18,230 --> 00:13:19,570
...ولكنّ ذلك أفضل من

210
00:13:20,270 --> 00:13:22,530
!البقاء في هذه الشّركة

211
00:13:26,570 --> 00:13:27,700
...كايزاكي

212
00:13:28,870 --> 00:13:32,950
.لا يسمح إلاّ للإدارة العليا بالاستقالة

213
00:13:32,950 --> 00:13:36,120
.الصّغار من أمثالك يقدّمون إخطارًا

214
00:13:36,120 --> 00:13:39,840
ذهبتَ إلى مدرسةٍ تحضيريّة ولا تعرف ذلك؟

215
00:13:39,840 --> 00:13:42,590
.لن نلاحظ حتّى غيابك

216
00:13:43,260 --> 00:13:45,380
!اخرج من هنا حالاً أيّها القمامة

217
00:13:46,130 --> 00:13:49,050
!اذهب، ولا تأتِ في الغد

218
00:13:50,810 --> 00:13:52,600
.فقدت وظيفتي

219
00:13:52,600 --> 00:13:54,640
.فقدت ثقتي

220
00:13:54,640 --> 00:13:58,520
.وأصبحت خائفًا من الارتباط بالنّاس والمجتمع

221
00:14:01,860 --> 00:14:03,780
...إن كنت أكثر نضجًا

222
00:14:04,740 --> 00:14:07,700
،إن قتلت عواطفي وحاولت التّأقلم

223
00:14:08,280 --> 00:14:10,700
هل كان من الممكن أن أظلّ عضوًا فعّالاً في المجتمع؟

224
00:14:11,660 --> 00:14:13,790
هل كان سيكون ذلك أفضل؟

225
00:14:15,450 --> 00:14:16,330
.كايزاكي-سان

226
00:14:17,790 --> 00:14:19,040
هل أنت بخير؟

227
00:14:19,540 --> 00:14:20,710
.آسف

228
00:14:20,710 --> 00:14:22,250
.لقد شردت قليلاً

229
00:14:23,250 --> 00:14:24,670
.هذا سيّئ

230
00:14:24,670 --> 00:14:27,630
.القدوم إلى هنا يملأني بالنّدم

231
00:14:29,720 --> 00:14:31,180
هلاّ ذهبنا؟

232
00:14:31,180 --> 00:14:32,260
.نعم

233
00:14:42,860 --> 00:14:45,780
هل أنت كايزاكي-سان؟

234
00:14:47,780 --> 00:14:51,120
.نحن من نفسك شركتك، عُينّا بعد سنةٍ منك

235
00:14:52,580 --> 00:14:55,080
.رأيت وجهك في ألبوم صور الشّركة

236
00:14:55,080 --> 00:14:57,830
.والموظّفون القدماء يتحدّثون عنك كثيرًا

237
00:14:57,830 --> 00:14:58,920
!كاميوكا-كن

238
00:14:58,920 --> 00:14:59,540
ماذا؟

239
00:15:00,830 --> 00:15:02,500
...آسف، لم أقصد

240
00:15:02,500 --> 00:15:07,970
.نعم، لا بدّ وأنّهم ما يزالون يسيئون إليّ

241
00:15:07,970 --> 00:15:09,550
...نعم

242
00:15:09,550 --> 00:15:14,260
ما يزال المدير يُحبّ التّطرّق إلى قصّة
.الشّابّ الّذي استقال بعد ثلاثة أشهر فقط

243
00:15:14,680 --> 00:15:18,520
.إنّه يتحدّث عن سايكي-سينباي كمحاربٍ قضى نحبه

244
00:15:18,520 --> 00:15:21,980
"!لقد أحبّت هذه الشّركة"
"!عليكم الاقتداء بها"

245
00:15:23,820 --> 00:15:25,690
.لقد تخرّجنا مؤخّرًا

246
00:15:25,690 --> 00:15:28,650
.لم تكن لدينا فكرة عن طبيعة مكان العمل

247
00:15:28,650 --> 00:15:31,280
.لم نكن نعلم حتّى أنّنا كنّا نعمل في شركة سوداء

248
00:15:31,860 --> 00:15:37,080
،نودّ الاستقالة، ولكنّنا نخشى أنّ كلّ الأماكن مشابهة

249
00:15:37,080 --> 00:15:38,790
.لذا نحن نُكمل بشكلٍ ما

250
00:15:39,910 --> 00:15:41,920
.يبدوان منهكين

251
00:15:42,580 --> 00:15:45,920
.وكأنّهما متعلّقين بيأس بخيطٍ قد ينقطع في أيّ لحظة

252
00:15:46,550 --> 00:15:48,760
.أشعر وكأنّي أرى نفسي قبل سنة

253
00:15:49,720 --> 00:15:52,680
!لذا لقائك هو شرفٌ لي

254
00:15:52,680 --> 00:15:54,550
!لأنّك بطلنا

255
00:15:55,470 --> 00:15:58,640
تقول لذلك المدير كلّ ما في بالك وتخرج؟

256
00:15:58,640 --> 00:15:59,730
!هذا مذهل

257
00:16:00,940 --> 00:16:01,810
...لا

258
00:16:02,190 --> 00:16:04,150
.لقد كنت طفلاً غبيًّا فحسب

259
00:16:04,730 --> 00:16:07,110
.تحكمني العواطف وبلا صبر

260
00:16:07,480 --> 00:16:08,230
.لا

261
00:16:08,230 --> 00:16:10,780
.لا نملك الشّجاعة للتّحرّك

262
00:16:10,780 --> 00:16:13,360
.لا يمكن للجميع أن يفعل مثل ما فعلت

263
00:16:14,030 --> 00:16:16,700
لا تعلم كم ساعدتنا معرفة أنّنا لم نكن

264
00:16:16,700 --> 00:16:20,750
.الوحيدين اللّذين نعتقد أنّ شركتنا فاسدة

265
00:16:21,960 --> 00:16:25,040
،نحن نحترمك

266
00:16:25,040 --> 00:16:26,590
.أنت وسايكي-سينباي

267
00:16:27,170 --> 00:16:30,720
.لم أتوقّع أبدًا أنّه سيكون لتمرّدي مثل هذا التّأثير

268
00:16:31,840 --> 00:16:33,130
،كايزاكي-سينباي

269
00:16:33,760 --> 00:16:35,800
...هل كان وضعك بعد الاستقالة

270
00:16:35,800 --> 00:16:37,430
صعبًا؟

271
00:16:38,720 --> 00:16:41,140
ما الّذي تفعله الآن؟

272
00:16:41,140 --> 00:16:43,980
.آسف. معرفة ذلك ستساعدنا

273
00:16:49,780 --> 00:16:54,280
.لم أستطع فعل أيّ شيء لفترة بعدما استقلت

274
00:16:54,280 --> 00:16:56,950
.ولكن يجب أن تعمل لتعيش

275
00:16:57,700 --> 00:17:00,080
.بدأت بالبحث عن وظيفةٍ أخرى

276
00:17:00,080 --> 00:17:01,830
،يوم مقابلتي الأولى

277
00:17:02,460 --> 00:17:05,540
.أدركت أنّي لم أعد أستطيع ارتداء ربطة العنق

278
00:17:05,960 --> 00:17:08,920
،عندما سألوني عن سبب استقالّتي بعد ثلاثة أشهر

279
00:17:08,920 --> 00:17:11,460
.لم أجد الكلمات المناسبة

280
00:17:12,170 --> 00:17:15,640
،مع الوقت، استعدت قدرتي بالنّجاح بالمقابلات

281
00:17:15,930 --> 00:17:17,600
.ولكنّي لم أحصل على وظيفةٍ أبدًا

282
00:17:18,430 --> 00:17:21,520
،وبعدها مللت وتعبت من كل ذلك، واستسلمت

283
00:17:21,520 --> 00:17:23,430
.وحصلت على وظيفة في متجر

284
00:17:23,430 --> 00:17:24,480
ما زلت تعمل هناك؟

285
00:17:24,480 --> 00:17:26,270
.لـ... لا

286
00:17:26,980 --> 00:17:28,400
...الآن، أنا

287
00:17:28,400 --> 00:17:31,030
.تماسك يا كايزاكي-كن

288
00:17:35,700 --> 00:17:37,110
.نعم

289
00:17:37,110 --> 00:17:38,910
.ما زلت أعمل عملاً بدوامٍ جزئيّ

290
00:17:38,910 --> 00:17:42,580
يصعب عليّ مواجهة أصدقائي
.الّذين يملكون وظائف حقيقيّة

291
00:17:43,040 --> 00:17:45,160
.آسف، ولكن هذا هو الواقع

292
00:17:45,870 --> 00:17:47,170
.لا تكن آسفًا

293
00:17:47,580 --> 00:17:48,460
...ولكن

294
00:17:49,130 --> 00:17:50,170
،مع ذلك

295
00:17:50,920 --> 00:17:54,920
أنا لست ناكرًا لذاتي لأعطي حياتي
!الوحيدة لمثل تلك الشّركة

296
00:17:57,760 --> 00:17:59,350
،أدركت هذا متأخّرًا

297
00:17:59,350 --> 00:18:01,970
.ولكن هناك أشخاصٌ قابلتهم لأنّي استقلت

298
00:18:02,430 --> 00:18:06,980
.أنا في عالمٍ لم أكن لأراه أبدًا إن بقيت

299
00:18:07,350 --> 00:18:08,230
...الآن

300
00:18:12,650 --> 00:18:15,030
.أنا مسرورٌ لأنّي استقلت

301
00:18:19,450 --> 00:18:21,030
ألست مسرورًا؟

302
00:18:21,030 --> 00:18:24,000
.وجودك يعطي قوّةً للأشخاص الّذين أتوا من بعدك

303
00:18:24,790 --> 00:18:26,120
.يواكي-سان

304
00:18:26,120 --> 00:18:27,500
كنتَ تعلم، أليس كذلك؟

305
00:18:27,500 --> 00:18:28,170
ماذا؟

306
00:18:28,830 --> 00:18:32,340
.أنّ الموظّفين الجدد يرونني هكذا

307
00:18:32,340 --> 00:18:36,420
.قمتَ بتنسيق الأمور لنلتقي ببعضنا هناك

308
00:18:36,420 --> 00:18:38,180
!على الإطلاق

309
00:18:38,180 --> 00:18:39,550
.كانت تلك مجرّد مصادفة

310
00:18:40,010 --> 00:18:44,270
ولكن لِمَ كذبت وقلت أنّك ما تزال
بوظيفة ذات دوامٍ جزئيّ؟

311
00:18:44,270 --> 00:18:46,520
!لديك وظيفة حقيقيّة

312
00:18:46,520 --> 00:18:47,560
وظيفة؟

313
00:18:48,190 --> 00:18:52,520
إنّك عيّنة تجربة، وتجني ما يكفي
.لدفع تكاليف معيشتك

314
00:18:52,520 --> 00:18:54,690
.أعتقد أنّ هذه وظيفة

315
00:18:54,690 --> 00:18:58,360
.بالطّبع، ولكنّها ليست وظيفةً وجدتها بنفسي

316
00:18:58,740 --> 00:19:01,450
.لقد عانيت حقًّا بعد أن استقلت

317
00:19:01,450 --> 00:19:05,160
.وانتهى بي المطاف هنا لأنّي لم أجد عملاً

318
00:19:05,160 --> 00:19:09,830
سأكون مستهترًا إن أخبرتهم
.أنّي وجدت وظيفةً حقيقيّة

319
00:19:11,040 --> 00:19:15,250
ستمثّل أنّ لديك عملاً أمام أصدقائك

320
00:19:15,250 --> 00:19:17,630
ولكن تخبر زملاءك الأصغر بالحقيقة؟

321
00:19:17,630 --> 00:19:19,930
.لا عجب أنّك بطلٌ بالنّسبة لهم

322
00:19:20,260 --> 00:19:22,550
.لا تُغظني. سأغضب

323
00:19:23,100 --> 00:19:25,890
!ولكنّي أعني ذلك

324
00:19:25,890 --> 00:19:26,970
.كاذب

325
00:19:33,270 --> 00:19:34,610
.آسف يا أونويا

326
00:19:34,610 --> 00:19:36,610
.أريد طلب معروفٍ منك

327
00:19:37,440 --> 00:19:40,990
،سأكون مع كايزاكي-سان طوال اليوم

328
00:19:42,370 --> 00:19:44,870
.لذا أطلعيني على ما ينوي فعله هذان الاثنان

329
00:19:45,620 --> 00:19:49,080
.إنّهما موظّفان جديدان في شركة كايزاكي-سان القديمة

330
00:19:49,370 --> 00:19:52,750
.زارا قبر سايكي-سان عدّة مراتٍ من قبل

331
00:19:53,290 --> 00:19:56,460
.كنت أفكّر أنّهما قد يذهبان في ذكرى وفاتها أيضًا

332
00:19:57,670 --> 00:20:02,930
إن علِم أنّ ما فعله يعطي الأمل
،للّذين أتوا من بعده

333
00:20:02,930 --> 00:20:06,760
.فقد يساعده ذلك بالنّظر إلى الأمام

334
00:20:06,760 --> 00:20:08,640
...مذهل

335
00:20:08,640 --> 00:20:11,980
قمت بكلّ هذا من أجل كايزاكي-سان؟

336
00:20:12,480 --> 00:20:15,020
.هذا ما يفترض أن يفعله قسم الدّعم

337
00:20:15,020 --> 00:20:18,860
ولكن ألن يقولوا أنّك تتورّط كثيرًا مرّة أخرى؟

338
00:20:19,320 --> 00:20:21,650
.إنّني أجمعهم معًا فحسب

339
00:20:21,650 --> 00:20:24,490
.الباقي يعتمد على كايزاكي-سان

340
00:20:28,080 --> 00:20:29,540
كيف كان كايزاكي-سان؟

341
00:20:30,620 --> 00:20:33,420
رأيته يتحدّث مع الموظّفين الجديدين

342
00:20:33,420 --> 00:20:35,210
.لكن لم أستطع سماع ما قالوه

343
00:20:35,750 --> 00:20:37,250
ما الّذي كانوا يتحدّثون عنه؟

344
00:20:38,130 --> 00:20:40,800
!أخبرني يا سينباي
!لا يمكنني التّوقّف عن التّفكير بالأمر

345
00:20:40,840 --> 00:20:42,550
.آسف، آسف

346
00:20:42,840 --> 00:20:44,090
.شكرًا

347
00:20:45,930 --> 00:20:47,010
.شكرًا

348
00:20:48,260 --> 00:20:50,270
.أنا مسرورٌ للحديث معهما

349
00:20:50,770 --> 00:20:55,980
معرفة أنّ صوتي وصوت سينباي بلغ أحدًا ما

350
00:20:56,360 --> 00:21:00,570
،لا يمحو الشّعور بالذّنب الّذي أشعر به لعدم إنقاذها

351
00:21:00,570 --> 00:21:02,490
.ولكنّه يساعد

352
00:21:03,320 --> 00:21:07,530
.دائمًا ما أندم على كلّ شيء عندما أذهب إلى هناك

353
00:21:07,530 --> 00:21:13,000
"!ولا بدّ أنّها كانت تشاهد وتقول "تماسك

354
00:21:14,040 --> 00:21:17,460
.تمكّنتُ من إخبارها أنّي مسرورٌ باستقالتي أخيرًا

355
00:21:18,250 --> 00:21:19,630
...إن لم يكن ريلايف موجودًا

356
00:21:20,420 --> 00:21:23,010
.إن كنت وحيدًا، لم أكن لأقدر على قول ذلك

357
00:21:24,300 --> 00:21:28,180
.كل ما فعلتُه هو الوقوف والمشاهدة

358
00:21:29,180 --> 00:21:30,430
!اصمت

359
00:21:30,430 --> 00:21:33,020
"!فقط قل "على الرّحب والسّعة

360
00:21:35,350 --> 00:21:36,940
،ومنّي أيضًا

361
00:21:36,940 --> 00:21:38,190
.شكرًا جزيلاً لك

362
00:21:39,980 --> 00:21:41,360
.ما هذا؟ مقرف

363
00:21:42,990 --> 00:21:47,070
من الّذي لن يقول "على الرّحب والسّعة" الآن؟

364
00:21:47,070 --> 00:21:48,370
.إنّك بغيض

365
00:23:24,880 --> 00:23:39,950
الحلقة القادمة

366
00:23:25,760 --> 00:23:27,880
ما زلت تعيد الاختبارات يا أراتا؟

367
00:23:27,880 --> 00:23:29,090
.اصمت. اتركني وشأني

368
00:23:29,090 --> 00:23:30,010
.كما تريد

369
00:23:30,010 --> 00:23:32,430
!لم أقصد ذلك! ساعدني يا أوغا-ساما

370
00:23:32,430 --> 00:23:34,140
!كازو-كن! تباهوغا

371
00:23:34,140 --> 00:23:36,970
—عطلة الصّيف على وشك أن
!ما هذا اللّقب؟

372
00:23:36,970 --> 00:23:39,440
!نعم، إجازة صيفيّة