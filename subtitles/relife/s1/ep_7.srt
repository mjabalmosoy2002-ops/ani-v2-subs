1
00:00:03,310 --> 00:00:08,230
.كما كتبت في الأعلى، ريلايف مليءٌ بالمشاكل

2
00:00:08,520 --> 00:00:11,440
لكن في كلّ مرّة يحاول فيها
،كايزاكي أراتا إظهار ندمه

3
00:00:11,440 --> 00:00:14,070
...ويسعى للتّحسّن

4
00:00:24,460 --> 00:00:26,790
.سمعنا إشاعاتٍ مُزعِجة

5
00:00:27,290 --> 00:00:31,510
تحديدًا، أنّك تقترّب بشكلٍ غير ضروريّ
.إلى موضوعات التّجربة

6
00:00:31,920 --> 00:00:35,800
هل نسيت أنّك داعمٌ فقط؟

7
00:00:35,970 --> 00:00:39,760
.أعلم أنّه أوّل واحدٍ لك، وتريد استعجال الأمور

8
00:00:39,890 --> 00:00:44,810
ولكنّ هذا ليس عذرًا لتوريط موضوع
.التّجربة بنصائح لا داعيَ لها

9
00:00:44,810 --> 00:00:47,310
.لا يمكنك أن تتورّط عاطفيًّا

10
00:00:47,730 --> 00:00:49,860
.ليس هناك معنى لريلايف هكذا

11
00:00:50,440 --> 00:00:51,570
...حسنًا

12
00:00:52,070 --> 00:00:56,070
.أعِد النّظر مليًّا بشأن دورك هنا

13
00:00:56,820 --> 00:01:01,410
قرّر من يجب أن يكون يواكي ريو
.بالنّسبة للموضوع رقم 001

14
00:03:01,740 --> 00:03:02,950
مرحبًا؟

15
00:03:02,950 --> 00:03:05,450
ما الأمر؟ هل هنالك مشكلة؟

16
00:03:10,370 --> 00:03:11,790
.فهمت

17
00:03:11,790 --> 00:03:15,420
.نحن مدركون لهذا بالطّبع

18
00:03:18,970 --> 00:03:22,760
.ولكنّها ليست مشكلةً يمكنني حلّها

19
00:03:23,760 --> 00:03:27,720
.هدف ريلايف هو منحك الخبرة

20
00:03:27,720 --> 00:03:30,730
.لجعلك تنمو خلال أفكارك وتصرّفاتك الخاصّة

21
00:03:31,690 --> 00:03:33,730
،إن تورّطتُّ أكثر من اللاّزم

22
00:03:34,440 --> 00:03:37,530
.ستفقد التّجربة قيمتها

23
00:03:46,120 --> 00:03:48,080
.ليس هنالك داعٍ لاستعجال الأمور

24
00:03:48,660 --> 00:03:49,660
.ابذل جهدك

25
00:03:51,410 --> 00:03:52,250
.نعم

26
00:03:53,460 --> 00:03:55,380
.حسنًا إذًا، إلى اللّقاء

27
00:03:59,840 --> 00:04:02,300
،اتّصل موضوع التّجربة

28
00:04:02,550 --> 00:04:06,430
.طلبُ النّصيحة، إن صحّ القول، هو تغيير

29
00:04:07,760 --> 00:04:11,480
ولكن لا أعلم إن كان بإمكاني
.قول أنّ هذه علامة جيّدة

30
00:04:12,140 --> 00:04:15,020
...سأستمرّ بالمراقبة عن بعد

31
00:04:14,310 --> 00:04:15,480
.وصلتك رسالة جديد
الآن

32
00:04:17,270 --> 00:04:21,070
...نعم، نعم. أنا على وشك إرسال التّقرير

33
00:04:22,860 --> 00:04:25,110
تقييم الجدارة؟

34
00:04:25,110 --> 00:04:27,280
...موضوع التّجربة... 002

35
00:04:41,300 --> 00:04:42,550
!مرحبًا

36
00:04:44,930 --> 00:04:47,760
.كايزاكي أراتا. في الثّانية والعشرين من عمره

37
00:04:48,140 --> 00:04:52,850
اجتماعيّ ومفيد، ولكنّه غير قادر
.على الحصول على وظيفةٍ مستقرّة

38
00:04:53,020 --> 00:04:54,640
.نصف منعزل

39
00:04:55,270 --> 00:04:57,650
.مرشّح رئيسيّ ليكون التّجربة رقم 002

40
00:05:01,820 --> 00:05:03,490
.إنّه جادّ

41
00:05:05,240 --> 00:05:07,660
...كئيب المظهر قليلاً، ولكن

42
00:05:12,120 --> 00:05:15,330
ولكن أعتقد أنّ ذلك ليس غير اعتياديّ
.بالنّسبة لخدمة متّجرٍ ليليّ

43
00:05:16,330 --> 00:05:17,500
.مرحبًا

44
00:05:19,840 --> 00:05:21,920
هل تريدني أن أسخّنها؟

45
00:05:21,920 --> 00:05:24,920
.لا، ستكون للفطور

46
00:05:25,300 --> 00:05:27,840
.إنّها بـ627 ينّ

47
00:05:27,840 --> 00:05:29,350
هل لديك بطاقة نقاط؟

48
00:05:29,350 --> 00:05:30,930
.لا، لا داعي

49
00:05:32,430 --> 00:05:34,140
.صِرافة مضبوطة

50
00:05:42,940 --> 00:05:44,440
!شكرًا لك

51
00:05:48,910 --> 00:05:50,240
!سيّدي

52
00:05:52,200 --> 00:05:54,330
هل أسقطت محفظتك؟

53
00:05:55,710 --> 00:05:58,210
!شكرًا لك

54
00:05:58,210 --> 00:05:59,580
!إنّك مُنقذ

55
00:05:59,580 --> 00:06:00,330
.لا داعي

56
00:06:00,880 --> 00:06:02,380
.اعتن بنفسك

57
00:06:04,670 --> 00:06:08,970
ظننت أنّي وضعتها في مكانٍ
.يصعبُ عليه إيجادها فيه

58
00:06:08,970 --> 00:06:10,840
.لقد رآها بسرعةٍ حقًّا

59
00:06:13,350 --> 00:06:15,350
.ينتبه لما يحيط به

60
00:06:15,350 --> 00:06:16,600
.ويتصرّف

61
00:06:17,890 --> 00:06:19,310
.ليس سيّئًا

62
00:06:20,230 --> 00:06:23,650
.نوعٌ مختلفٌ تمامًا عن موضوع التّجربة رقم 001

63
00:06:24,150 --> 00:06:25,320
!سينباي

64
00:06:25,940 --> 00:06:27,740
أونويا؟ أتيتِ؟

65
00:06:29,360 --> 00:06:31,030
ما الّذي تفعله هنا؟

66
00:06:32,200 --> 00:06:34,950
.أقيّم كايزاكي أراتا

67
00:06:34,950 --> 00:06:36,700
لِمَ أنت يا سينباي؟

68
00:06:37,370 --> 00:06:40,290
!أنا أريد أن أكون الدّاعمة له

69
00:06:40,290 --> 00:06:42,080
هل تريد سرقته منّي؟

70
00:06:42,080 --> 00:06:43,840
.هذا اتّهامٌ فظّ

71
00:06:44,290 --> 00:06:46,130
.كانت أوامر من الأعلى

72
00:06:46,130 --> 00:06:49,510
".تطلّع على مُرشّح زميلتك الصّغرى"

73
00:06:49,510 --> 00:06:51,800
ماذا؟ هكذا إذًا؟

74
00:06:51,800 --> 00:06:53,640
ما رأيك به؟

75
00:06:53,640 --> 00:06:55,180
يبدو كشخصٍ جيّد، أليس كذلك؟

76
00:06:56,140 --> 00:06:59,600
هل سنجعله يبدأ في السّنة الثّالثة؟

77
00:06:59,730 --> 00:07:04,070
،يبدو أنّه لا يملك أيّ مشاكل اجتماعيّة
.لذا لن تكون هناك مشكلةٌ بذلك

78
00:07:05,360 --> 00:07:08,440
وكيف هو حالك مع موضوع التّجربة رقم 001؟

79
00:07:09,110 --> 00:07:10,650
.إنّني أبلي حسنًا

80
00:07:11,070 --> 00:07:13,030
.مثل ما يريده رؤساؤنا

81
00:07:13,030 --> 00:07:14,660
!لا أقصد هذا

82
00:07:14,660 --> 00:07:18,000
...أنا أسأل ما إن كانت ستنجح التّجربة أم لا

83
00:07:19,120 --> 00:07:21,790
حسنًا، من يعلم؟

84
00:07:22,790 --> 00:07:27,000
نحن نتحدّث عن إنسان. لذا لا يمكنك
.معرفة ما سيحدث أبدًا

85
00:07:27,840 --> 00:07:30,340
ما الّذي يمكنك فعله للحصول على نتائج؟

86
00:07:30,340 --> 00:07:32,260
إلى أيّ حدٍّ يمكنك الذّهاب؟

87
00:07:33,840 --> 00:07:35,760
.من الصّعب إيجاد المسافة المناسبة

88
00:08:20,140 --> 00:08:24,350
.كانت هناك إمكانيّة كبيرة
كيف حصل هذا؟

89
00:08:25,690 --> 00:08:29,110
إنّها تجربة فرعنا الأولى، وهذه هي النّتائج؟

90
00:08:29,440 --> 00:08:32,280
.أنا خجلٌ من مواجهة الفروع الأخرى

91
00:08:32,740 --> 00:08:35,530
...سنة كاملة بلا أيّ تغيير

92
00:08:38,080 --> 00:08:41,250
ألم تفعل ما يكفي لدعم موضوع التّجربة؟

93
00:08:58,550 --> 00:08:59,850
...سينباي

94
00:09:15,570 --> 00:09:19,580
.لقد راقبتك لسنة وأعددت تقاريرًا عن ذلك

95
00:09:20,410 --> 00:09:25,370
.ولكن يبدو أنّنا لن نتمكّن من إعطائك أيّ عمل

96
00:09:27,580 --> 00:09:29,590
.أعتذر

97
00:09:29,590 --> 00:09:32,420
.دعمي لم يكن جيّدًا بما يكفي

98
00:10:16,010 --> 00:10:18,220
ما الّذي كان ينبغي عليّ فعله؟

99
00:10:20,720 --> 00:10:22,890
.قالوا لي أنّي كنت متورّطًا أكثر من اللاّزم

100
00:10:23,930 --> 00:10:25,270
.لذا أبعدت نفسي

101
00:10:25,850 --> 00:10:28,230
.ثمّ قالوا لي أنّي لم أفعل ما يكفي

102
00:10:32,270 --> 00:10:33,820
،قبل قليل

103
00:10:33,820 --> 00:10:38,320
تلقّينا خبرَ اختيار كايزاكي أراتا-سان
.كموضوع التّجربة رقم 002

104
00:10:39,200 --> 00:10:39,990
...وداعمه

105
00:10:41,660 --> 00:10:42,950
.هو يواكي ريو

106
00:10:44,200 --> 00:10:45,410
.إنّه أنت

107
00:10:48,040 --> 00:10:50,210
.قالوا ابدأ بالإعداد فورًا

108
00:10:55,460 --> 00:10:58,470
!ليس لديك وقتٌ للشّعور بالإحباط

109
00:11:18,690 --> 00:11:21,910
.موضوع التّجربة رقم 002، كايزاكي أراتا

110
00:11:33,380 --> 00:11:35,880
.لا بدّ وأنّ أونويا غاضبة منّي

111
00:11:36,380 --> 00:11:39,050
،أرادت دعم موضوع التّجربة هذا حقًّا

112
00:11:39,050 --> 00:11:42,220
.وأنا سلبته منها في نهاية المطاف على أيّ حال

113
00:11:43,340 --> 00:11:45,970
.ولكنّها وظيفتي

114
00:11:46,600 --> 00:11:48,060
.عليّ التّعامل معها

115
00:11:55,230 --> 00:11:56,900
—انتظـ

116
00:11:59,150 --> 00:12:02,860
كيف أصبحت حياتي هكذا؟

117
00:12:05,740 --> 00:12:06,960
.مساء الخير

118
00:12:06,960 --> 00:12:10,160
.مسرورٌ للقائك يا كايزاكي أراتا-سان

119
00:12:10,450 --> 00:12:14,710
.أنا يواكي ريو، من مختبر ريلايف

120
00:12:10,450 --> 00:12:15,210
مختبر ريلايف

121
00:12:10,450 --> 00:12:15,210
الدّاعم
يواكي ريو

122
00:12:18,130 --> 00:12:23,760
هل تريد أن تصبح تلميذًا لسنة وتراها
كفرصة لتغيير حياتك؟

123
00:12:24,390 --> 00:12:28,760
أم هل سترتعب، وتتراجع، وتستمر بالعيش كـ"نيت"؟

124
00:12:29,520 --> 00:12:33,100
.الخيار خيارك يا كايزاكي-سان

125
00:12:34,900 --> 00:12:37,650
لقد كان صعبًا عليك، أليس كذلك؟

126
00:12:37,650 --> 00:12:41,240
.ادّعاء أنّ لديك وظيفةً حقيقيّة أمام أصدقائك

127
00:12:42,110 --> 00:12:43,900
،إن كنت جاهزًا للقبول

128
00:12:44,240 --> 00:12:47,280
.وقّع العقد من فضلك

129
00:13:18,190 --> 00:13:20,110
.لتحظى بريلايف جيّد

130
00:13:25,200 --> 00:13:26,700
...هذا الرّجل

131
00:13:26,700 --> 00:13:27,780
...أتساءل

132
00:13:29,660 --> 00:13:32,240
أيّ ريلايف سيريني؟

133
00:13:37,960 --> 00:13:39,040
!قادمة

134
00:13:42,000 --> 00:13:45,760
إنّك جريئةٌ لجعل السّينباي الخاصّ
.بكِ يعمل هكذا يا أونويا

135
00:13:46,970 --> 00:13:48,550
!آسفة

136
00:13:48,550 --> 00:13:50,470
.كنتَ في المختبر وقادمًا إلى هنا على أيّ حال

137
00:13:50,470 --> 00:13:53,520
.لذا اعتقدتُ أنّ بإمكانك إحضارها في طريقك

138
00:13:53,770 --> 00:13:56,770
."لقد كان ثقيلاً وبعيدًا جدًّا لأن أحضره "في طريقي

139
00:13:57,230 --> 00:13:58,940
.على أيّ حال، ادخل

140
00:13:58,940 --> 00:14:01,440
.سأعدّ لك قهوة كعربون شكر

141
00:14:10,160 --> 00:14:11,910
!زيّ بحّارة

142
00:14:12,490 --> 00:14:14,540
!هذا يعيد بي بالذّكريات

143
00:14:14,540 --> 00:14:17,750
.زيّي عندما كنت في الثّانويّة كان زيّ بحّارة أيضًا

144
00:14:17,750 --> 00:14:21,290
.لم أتخيّل أنّي سأرتديه مرّة أخرى في عمري هذا

145
00:14:21,420 --> 00:14:23,670
،فعلاً

146
00:14:23,670 --> 00:14:24,670
.أيّتها العجوز

147
00:14:24,670 --> 00:14:29,090
.إن كنت أنا عجوزًا، فإنّك هرِم

148
00:14:29,090 --> 00:14:31,970
!أنا أتطلّع لهذا حقًّا

149
00:14:31,970 --> 00:14:33,760
،لم أتخيّل أنّ بدءًا من أبريل

150
00:14:33,760 --> 00:14:36,350
أنّي سأكون في نفس مدرستك

151
00:14:36,350 --> 00:14:38,270
!وفي نفس فصلك

152
00:14:38,270 --> 00:14:39,810
!هذا مضحك

153
00:14:42,440 --> 00:14:44,150
كيف كان كايزاكي-سان؟

154
00:14:44,150 --> 00:14:45,070
ماذا؟

155
00:14:45,860 --> 00:14:49,070
!موضوع التّجربة رقم 002، كايزاكي أراتا-سان

156
00:14:49,070 --> 00:14:51,820
قابلتَه اليوم، أليس كذلك؟

157
00:14:53,030 --> 00:14:55,790
.لقد وقّع العقد بلا مشاكل

158
00:14:56,500 --> 00:14:58,540
هل تعتقد أنّك ستعمل معه جيّدًا؟

159
00:14:58,830 --> 00:15:02,130
.هذه هي وظيفتنا كدعم

160
00:15:02,130 --> 00:15:03,710
!كما هو متوقّع من سينباي

161
00:15:04,130 --> 00:15:06,010
.إنّك تثيرين أعصابي حقًّا

162
00:15:06,010 --> 00:15:08,340
لماذا؟

163
00:15:09,800 --> 00:15:12,720
.حسنًا، لا ينبغي عليك أن تقلق على كايزاكي-سان

164
00:15:13,300 --> 00:15:16,850
.لقد حرصنا مسبقًا ألاّ تكون شخصيّته مشكلة

165
00:15:18,390 --> 00:15:19,770
.صحيح

166
00:15:20,480 --> 00:15:21,350
...ولكن

167
00:15:21,850 --> 00:15:26,780
.أعتقد أنّ أشخاصًا هكذا لديهم مشاكل عميقة

168
00:15:29,780 --> 00:15:32,950
الصّدمة بسبب التّفكير أنّك قد تكون السّبب

169
00:15:32,950 --> 00:15:36,040
أنّك فقدتَ شخصًا عزيزًا عليك

170
00:15:36,040 --> 00:15:38,000
.لا تذهب بسهولة

171
00:15:40,040 --> 00:15:42,880
"هل كان بإمكاني فعل شيءٍ أكثر؟"

172
00:15:43,580 --> 00:15:46,380
"ربّما لم يكن عليّ فعل أيّ شيءٍ إطلاقًا؟"

173
00:15:47,300 --> 00:15:50,090
،بما أنّ ليس لديه أيّ طريقة للتّأكّد من ذلك

174
00:15:50,880 --> 00:15:54,890
.فقدَ كايزاكي-سان ثقته بقدراته الاجتماعيّة

175
00:15:56,560 --> 00:16:00,560
في العادة، إنّه يقوم بفعل شيءٍ كذلك
...لأجل شخصٍ ما، ولكن

176
00:16:05,560 --> 00:16:08,780
ولكن أليس ذلك ما يجعله مثاليًّا لريلايف؟

177
00:16:10,320 --> 00:16:14,110
.سيساعد ريلايف على استعادة كايزاكي-سان لثقته بنفسه

178
00:16:15,950 --> 00:16:17,370
.سيكون الأمر على ما يرام

179
00:16:18,040 --> 00:16:20,080
.يمكنكما فعلها معًا

180
00:16:20,410 --> 00:16:21,960
.آمل ذلك

181
00:16:24,630 --> 00:16:28,090
.إنّك تتملّقين لي كثيرًا اليوم يا أونويا

182
00:16:28,090 --> 00:16:30,380
حقًّا؟

183
00:16:30,380 --> 00:16:31,470
.ذلك مقرف

184
00:16:31,470 --> 00:16:35,090
!ماذا؟ أنا أشجّعك فحسب

185
00:16:36,550 --> 00:16:38,850
.أرأيتِ؟ مقرف

186
00:16:38,850 --> 00:16:41,020
!إنّك فظيع

187
00:16:54,490 --> 00:16:56,620
!مرحبًا يا كايزاكي-سان

188
00:16:56,620 --> 00:16:58,830
ماذا تريد بهذا الوقت المتأخّر؟

189
00:16:58,830 --> 00:16:59,700
...آسف

190
00:16:59,700 --> 00:17:01,500
.أريد أن أحدّثك بخصوص شيءٍ ما

191
00:17:06,960 --> 00:17:09,550
دواءٌ لإعادتك...؟

192
00:17:11,880 --> 00:17:15,880
...أخبرت الجميع أنّي لن أراهم لسنة، ولكن

193
00:17:16,340 --> 00:17:20,520
ولكن لا يمكنني الاستقالة
.من وظيفتي عبر مكالمة هاتفيّة

194
00:17:23,730 --> 00:17:26,350
.اتركهم وحسب

195
00:17:27,400 --> 00:17:28,810
!هذا غير معقول

196
00:17:28,810 --> 00:17:30,360
ما خطبك؟

197
00:17:32,440 --> 00:17:33,610
.حسنًا، فهمت

198
00:17:34,030 --> 00:17:36,200
.سأطلب الدّواء

199
00:17:37,780 --> 00:17:40,870
.لكن قد يستغرق يومًا أو يومين

200
00:17:40,870 --> 00:17:42,620
.حسنًا، أعتمد عليك

201
00:17:42,620 --> 00:17:43,450
.إلى اللّقاء

202
00:17:52,050 --> 00:17:53,710
!مرحبًا

203
00:17:54,300 --> 00:17:57,220
.لديّ طلبٌ لدواء يا أماغاسي-سان

204
00:17:58,220 --> 00:17:59,970
.إنّك تأتي إلى هنا كثيرًا مؤخّرًا

205
00:18:00,220 --> 00:18:01,810
.أحسنت العمل يا يواكي

206
00:18:01,930 --> 00:18:05,980
واحدة للحاضر وواحدة للماضي
.لموضوع التّجربة رقم 002

207
00:18:07,140 --> 00:18:09,020
وواحدة من كلتاهما لك؟

208
00:18:09,270 --> 00:18:11,940
،سأقابل موضوع التّجربة لأُسلّم الدّواء

209
00:18:11,940 --> 00:18:14,190
.لذا أودّ أن أبدو بعمري

210
00:18:14,190 --> 00:18:15,990
لِمَ كل هذا العناء؟

211
00:18:15,990 --> 00:18:17,780
.اذهب كما أنت الآن

212
00:18:18,200 --> 00:18:19,450
!لا، لا

213
00:18:20,370 --> 00:18:22,700
لا أريده أن يراني هكذا

214
00:18:22,700 --> 00:18:27,540
!حتّى أفاجئه في أوّل يومٍ من المدرسة

215
00:18:27,540 --> 00:18:30,750
!لا يمكنني الانتظار لأرى تعابير وجهه

216
00:18:32,000 --> 00:18:34,420
.هذا هو السّبب الرّسميّ على أيّ حال

217
00:18:34,800 --> 00:18:38,840
أنا أعتقد فقط أنّه إذا علِم أنّ داعمه
،سيكون في نفس فصله

218
00:18:38,840 --> 00:18:42,300
.فإنّه لن يقلق حيال ذلك بشكلٍ كافٍ

219
00:18:44,010 --> 00:18:45,680
.لقد فكّرتَ بهذا بشكلٍ جيّد

220
00:18:46,020 --> 00:18:48,440
.هذه هي وظيفتي

221
00:18:48,440 --> 00:18:50,690
.سآتي في الغد لاستلامها

222
00:18:50,940 --> 00:18:52,520
!شكرًا لك

223
00:18:52,520 --> 00:18:53,190
.العفو

224
00:19:14,170 --> 00:19:15,920
.أحسنت العمل

225
00:19:15,920 --> 00:19:18,260
.نعم... كان ذلك مُربكًا

226
00:19:18,260 --> 00:19:19,260
مُربكًا؟

227
00:19:19,260 --> 00:19:21,680
.لقد كانت مجرّد وظيفةٍ بدوامٍ جزئيّ

228
00:19:22,220 --> 00:19:26,100
.ولكن المدير كان لطيفًا. ساعدَني كثيرًا

229
00:19:26,100 --> 00:19:27,520
.أشعر بالذّنب للاستقالة

230
00:19:30,020 --> 00:19:32,600
.شكرًا لك على تلبية طلبي

231
00:19:32,600 --> 00:19:35,940
.يمكنني الآن أن أكون طالب ثانويّة بلا أيّ ندم

232
00:19:37,150 --> 00:19:39,150
ستأخذها الآن؟

233
00:19:40,320 --> 00:19:43,120
يستغرق مفعولها وقتًا ليبدأ، أليس كذلك؟

234
00:19:46,120 --> 00:19:48,120
.إنّك مُتحمّسٌ لهذا

235
00:19:48,540 --> 00:19:50,670
!ما-ما بيدي حيلة

236
00:19:50,670 --> 00:19:52,170
.حتّى أنّي استقلت من وظيفتي

237
00:19:53,130 --> 00:19:56,000
!ليس لديّ خيارٌ آخر

238
00:20:03,260 --> 00:20:06,850
.سأجلس بمكاني وأدع هذه السّنة تمر

239
00:20:06,850 --> 00:20:08,180
.هذا كلّ شيء

240
00:20:08,180 --> 00:20:09,680
.لست متحمّسًا تمامًا

241
00:20:10,730 --> 00:20:11,520
.فهمت

242
00:20:13,350 --> 00:20:15,980
،إنّ ذلك مكتوبٌ في المستندات الّتي أعطيتك إيّاها

243
00:20:15,980 --> 00:20:20,610
لكن سيجعلك هذا الدّواء نعسانًا جدًّا بعد
.وقتٍ قصيرٍ من أخذه، لذا كن حذرًا

244
00:20:21,400 --> 00:20:23,740
.أنصحك ألاّ تقود السّيّارة

245
00:20:23,740 --> 00:20:25,820
!لا أملك سيّارة

246
00:20:25,820 --> 00:20:26,870
...ولكن

247
00:20:26,870 --> 00:20:28,740
...لديّ مواعيدٌ بعد الانتهاء من هنا

248
00:20:28,910 --> 00:20:31,620
.إنّك طائشٌ للغاية

249
00:20:31,620 --> 00:20:34,580
!أليس ذلك خطأك لأنّك لم تفسّره لي كما ينبغي؟

250
00:20:35,920 --> 00:20:37,670
.هذا صحيح

251
00:20:37,670 --> 00:20:39,300
!صحيح"؟"

252
00:20:39,300 --> 00:20:41,220
.يجب عليك قراءة المستندات حقًّا

253
00:20:54,400 --> 00:20:57,520
،لكن في كل مرّة يحاول فيها كايزاكي أراتا إظهار ندمه

254
00:20:57,520 --> 00:21:00,030
...ويسعى للتّحسّن

255
00:21:00,990 --> 00:21:05,740
.وطبيعة ذلك التّفكير الطّليعيّ مُعدية

256
00:21:06,910 --> 00:21:10,370
.لقد بدأ بتغيير الأشياء من حوله

257
00:21:13,500 --> 00:21:18,880
ما هو التّأثير الّذي سيتركه ذلك
على ريلايف كايزاكي أراتا؟

258
00:21:34,520 --> 00:21:38,900
يجعلني ذلك أودّ الاستمرار بالمراقبة

259
00:21:39,320 --> 00:21:41,980
.وأعيش حياة طالبٍ في الثّانويّةِ معهم

260
00:23:24,880 --> 00:23:40,000
الحلقة القادمة

261
00:23:25,840 --> 00:23:28,010
ماذا تفعل عادةً يا يواكي-سان؟

262
00:23:28,010 --> 00:23:28,800
ماذا تقصد؟

263
00:23:28,800 --> 00:23:31,680
أعني، عندما لا تكون تدعمني؟

264
00:23:31,680 --> 00:23:35,390
!أفكّر بك طوال الوقت بالطّبع

265
00:23:35,390 --> 00:23:35,850
ماذا؟

266
00:23:35,850 --> 00:23:37,520
هل هذا ما تريدني أن أقوله؟

267
00:23:37,520 --> 00:23:39,190
!طبعًا لا