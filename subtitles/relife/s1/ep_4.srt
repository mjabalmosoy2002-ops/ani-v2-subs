1
00:00:01,140 --> 00:00:02,600
،المشبك الفضّيّ

2
00:00:02,600 --> 00:00:05,860
.يُعطى لصبيٍّ وفتاةٍ أحرزا أعلى الدّرجات في كلّ فصل

3
00:00:06,360 --> 00:00:09,610
.إعفاء عن الرّسوم الدّراسيّة. بدَل تنقّل

4
00:00:09,980 --> 00:00:11,610
.غداء مجانيّ في مقصف المدرسة

5
00:00:12,110 --> 00:00:14,530
.مع ذلك لم أهتمّ بهذه الميّزات أبدًا

6
00:00:14,910 --> 00:00:17,330
.أثبتَت أنّ حامله هو الأفضل في الفصل

7
00:00:17,330 --> 00:00:18,950
.أنّه مُمثّل الفصل

8
00:00:19,290 --> 00:00:21,450
،هذه هي المكانة الّتي يمنحها المشبك لحامله

9
00:00:21,450 --> 00:00:24,420
.وقد كنتُ فخورةً بنفسي عندما كنت أرتديه

10
00:00:25,080 --> 00:00:27,250
!وقت اجتماع اللّجنة يا كاريو

11
00:00:27,250 --> 00:00:28,130
!نعم

12
00:00:28,840 --> 00:00:29,960
...و

13
00:00:30,250 --> 00:00:31,760
...بالنّسبة لي

14
00:00:35,760 --> 00:00:37,090
هل ستذهبين إلى المقصف الآن؟

15
00:00:37,090 --> 00:00:39,060
!أ-أوغا

16
00:00:39,060 --> 00:00:42,020
.نـ-نعم، ولكنّي أنتظر هونوكا

17
00:00:42,020 --> 00:00:43,390
وأنت؟

18
00:00:44,310 --> 00:00:47,020
.صحيح، عمل مُمثّل الفصل

19
00:00:47,190 --> 00:00:47,900
.نعم

20
00:00:48,190 --> 00:00:50,230
!وأنا أتضوّر جوعًا أيضًا

21
00:00:50,230 --> 00:00:53,280
!تُرهقنا سينسي بالعمل حقًّا

22
00:00:53,530 --> 00:00:54,900
أليس كذلك يا هيشيرو-سان؟

23
00:01:02,450 --> 00:01:03,620
.كازو-كن

24
00:01:14,220 --> 00:01:17,050
.دفتر ريو كان واقعًا على الأرض في الرّدهة

25
00:01:17,050 --> 00:01:17,720
ماذا؟

26
00:01:17,720 --> 00:01:19,010
من يكون ريو؟

27
00:01:20,050 --> 00:01:21,810
هل أنت بخير يا كازو-كن؟

28
00:01:22,310 --> 00:01:24,180
.آسف، أصبحت ثقيلة قليلاً

29
00:01:24,180 --> 00:01:26,390
.لهذا أخبرتك أن تدعني أحمل النّصف

30
00:01:26,390 --> 00:01:27,520
.آسف

31
00:01:31,770 --> 00:01:32,980
.أعطِني

32
00:01:32,980 --> 00:01:34,690
.سآخذ النّصف

33
00:01:34,690 --> 00:01:37,410
.ريو" هو يواكي-كن"

34
00:01:37,410 --> 00:01:38,410
هل أنتما صديقان؟

35
00:01:38,410 --> 00:01:40,870
.لقد كان في نفس فصلي السّنة الماضية فقط

36
00:01:41,080 --> 00:01:42,620
إذًا... تنادينه باسمه الأوّل؟

37
00:01:41,780 --> 00:01:45,620
ما كانت تلك الابتسامة المتكلّفة
!الّتي تشير على الانتصار؟

38
00:01:45,960 --> 00:01:48,830
.كانت تحاول الابتسام بودّيّة

39
00:01:49,080 --> 00:01:51,540
!أيّ جزءٍ من هذا كان "ودّيًّا"؟

40
00:01:52,420 --> 00:01:54,710
!إنّها تسخر منّي

41
00:03:36,190 --> 00:03:37,320
ما الخطب؟

42
00:03:37,610 --> 00:03:39,280
هل أنتِ غاضبةٌ من شيءٍ ما؟

43
00:03:41,990 --> 00:03:42,950
.لا

44
00:03:43,490 --> 00:03:45,370
!لا يمكنني تحمّل ذلك

45
00:03:45,370 --> 00:03:47,620
!لا أستطيع إخراج ذلك الوجه من بالي

46
00:03:48,370 --> 00:03:50,710
!لِمَ تُظهر ذلك الوجه المقرف أمامي؟

47
00:03:50,710 --> 00:03:52,120
!لا أفهم

48
00:03:52,120 --> 00:03:54,830
.إنّك غاضبة بالفعل يا رينا

49
00:03:54,830 --> 00:03:56,420
.أشعر بالأسى على الأرزّ المقليّ

50
00:03:56,920 --> 00:03:58,300
.إنّك تفتقرين إلى الكالسيوم

51
00:03:58,630 --> 00:04:00,090
هل تريدين الحليب؟

52
00:04:00,090 --> 00:04:01,170
.لا أريد

53
00:04:01,170 --> 00:04:03,550
كيف يمكنكِ أن تشربي حليبًا مع الأرزّ؟

54
00:04:03,550 --> 00:04:06,390
...هذا طبيعيّ! خلال المرحلة الابتدائيّة كلّها

55
00:04:06,390 --> 00:04:09,470
!لم يعطونا خيارًا في ذلك الوقت

56
00:04:09,720 --> 00:04:15,730
سأشرب الكثير من الحليب
.وأطول من أجل الكرة الطّائرة

57
00:04:16,860 --> 00:04:18,480
...كل ذلك الغذاء

58
00:04:19,030 --> 00:04:21,990
.يذهب إلى مكانٍ مختلفٍ تمامًا

59
00:04:27,580 --> 00:04:32,410
.هزَمتني هونوكا بكلّ جزءٍ من اختبار اللّياقة البدنيّة

60
00:04:32,410 --> 00:04:34,790
!كما توقّعت! إنّك سريعةٌ جدًّا

61
00:04:34,790 --> 00:04:36,170
.بالنّسبة لاسمك، أنا آسفة

62
00:04:36,170 --> 00:04:38,420
.لم أعرفه، لذا لم أستطع استخدامه

63
00:04:38,420 --> 00:04:40,630
.هونوكا... وهيشيرو

64
00:04:41,380 --> 00:04:43,550
.أنا الوحيدة الّتي ترانا كمتنافستين

65
00:04:43,840 --> 00:04:47,640
.تستمرّان بتخطيّ بسهولة، بلا اهتمامٍ حتّى

66
00:04:48,470 --> 00:04:49,600
رينا؟

67
00:04:51,220 --> 00:04:52,600
هل أنتِ بخير؟

68
00:04:53,310 --> 00:04:54,560
!آسفة

69
00:04:55,190 --> 00:04:57,360
،أكره أنّي لست ندًّا لها

70
00:04:57,360 --> 00:05:00,320
.ولكنّي أحبّ هونوكا مع ذلك

71
00:05:00,530 --> 00:05:02,280
.إنّها صديقةٌ جيّدة

72
00:05:07,740 --> 00:05:08,660
...ولكن

73
00:05:12,040 --> 00:05:14,830
...ولكن تلك الفتاة

74
00:05:16,580 --> 00:05:17,830
...كازو-كن

75
00:05:17,830 --> 00:05:20,380
!لا أعتقد أنّ بإمكاني تقبّلها أبدًا

76
00:05:20,380 --> 00:05:22,880
!لِمَ تأكل لوحدها في المقصف؟

77
00:05:22,880 --> 00:05:24,340
!تحاول إظهار نفسها وحيدة؟

78
00:05:25,090 --> 00:05:27,840
!تنتظر أن يغازلها أحد الصّبيان؟

79
00:05:29,140 --> 00:05:30,810
...رينا

80
00:05:34,850 --> 00:05:36,560
.نحن خجلان حقًّا

81
00:05:36,560 --> 00:05:38,940
إلى متى سيستمرّ هذا؟

82
00:05:38,940 --> 00:05:40,440
!إنّها محاولتنا الثّالثة فقط

83
00:05:40,440 --> 00:05:41,070
!نعم

84
00:05:41,440 --> 00:05:44,190
!بحساب الامتحانات الأولى، هذه هي الرّابعة

85
00:05:44,190 --> 00:05:46,740
!لا أعلم كيف يمكنكما أخذ الاختبارات لشهرٍ كامل

86
00:05:46,740 --> 00:05:49,490
!ألا تريدان حتّى أن تكونا حرّين؟

87
00:05:49,910 --> 00:05:50,700
!أريد ذلك

88
00:05:50,700 --> 00:05:51,530
!بشدّة

89
00:05:52,660 --> 00:05:56,250
في هذه الحالة، سيتوّجب علينا عقد جلساتٍ
...دراسيّة خلال الأسبوع الذهبيّ

90
00:05:56,250 --> 00:05:56,750
ماذا؟

91
00:05:56,750 --> 00:05:58,500
!لا تقل هذا

92
00:05:58,500 --> 00:05:59,880
!لقد سئمت من هذا

93
00:05:59,880 --> 00:06:02,340
.بدأت أفقد الثّقة بتدريسي

94
00:06:08,180 --> 00:06:10,850
هل تأكل هيشيرو-سان الغداء لوحدها؟

95
00:06:13,310 --> 00:06:15,480
.إنّه مُحق. إنّها تأكل وحيدة

96
00:06:16,560 --> 00:06:17,940
...بالتّفكير بالأمر

97
00:06:18,520 --> 00:06:23,730
أنا أحاول أخذ الخطوة الأولى لكي
.لا أكون وحيدةً بلا أصدقاء

98
00:06:24,820 --> 00:06:26,490
!صحيح

99
00:06:26,490 --> 00:06:29,780
!لندعوها هنا لتأكل معنا

100
00:06:29,780 --> 00:06:33,700
!ويمكننا أن نجعلها تساعدنا في تدريسكما

101
00:06:34,120 --> 00:06:36,040
أيّ حظٍّ هذا؟

102
00:06:36,040 --> 00:06:37,960
!يدرّسانكما مشبكان فضّيّان

103
00:06:38,460 --> 00:06:39,920
.شكرًا

104
00:06:40,210 --> 00:06:42,630
.سأذهب لمناداتها

105
00:06:43,090 --> 00:06:44,130
.نعم

106
00:06:45,380 --> 00:06:46,590
.انتظر يا أوغا

107
00:06:47,720 --> 00:06:48,670
ماذا؟

108
00:06:49,180 --> 00:06:51,140
هل تريد أن تذهب أنت؟

109
00:06:51,140 --> 00:06:54,180
.صحيح. إنّكما قريبان من بعضكما

110
00:06:54,180 --> 00:06:57,520
...لا، ليس هذا ما في الأمر

111
00:06:57,520 --> 00:06:59,690
.يُستحسن ألاّ نناديها

112
00:06:59,690 --> 00:07:01,400
لِمَ لا؟

113
00:07:01,400 --> 00:07:02,610
!الوضع مثاليّ

114
00:07:02,610 --> 00:07:05,070
!إنّها وحيدة، ويمكننا الاستفادة من المساعدة

115
00:07:05,070 --> 00:07:07,740
...نعم، أعلم ذلك، ولكن

116
00:07:07,740 --> 00:07:09,240
لِمَ لا إذًا؟

117
00:07:09,740 --> 00:07:11,110
...حسنًا

118
00:07:14,120 --> 00:07:15,330
...هكذا إذًا

119
00:07:15,330 --> 00:07:17,040
.فهمت الآن

120
00:07:17,580 --> 00:07:19,080
!فهمت

121
00:07:19,080 --> 00:07:20,290
!إنّك تشعر بالغيرة

122
00:07:21,170 --> 00:07:24,840
.لا تريد أن يتقرّب أيّ شابٍّ من هيشيرو-سان

123
00:07:24,840 --> 00:07:25,500
!ماذا؟

124
00:07:25,500 --> 00:07:28,380
.لا بأس! لا تقلق بشأني

125
00:07:28,380 --> 00:07:30,090
!هذا ليس ما في الأمر أيّها الغبيّ

126
00:07:30,090 --> 00:07:34,430
عُد إليّ بعد عشر سنوات إن كنت
.تريد التّحدّث بشأن الحبّ

127
00:07:34,850 --> 00:07:35,810
،على أيّ حال

128
00:07:36,060 --> 00:07:39,180
عليّ أنا وآن أن نبذل جهدنا وننجح فحسب، صحيح؟

129
00:07:40,560 --> 00:07:42,600
.اترك موضوع هيشيرو-سان جانبًا في الوقت الرّاهن

130
00:07:44,190 --> 00:07:47,150
.تبًّا، لم يقتنع بتاتًا

131
00:07:49,360 --> 00:07:52,070
.لا أفهم، ولكن حسنًا

132
00:07:52,070 --> 00:07:53,610
.إن كنت تصرّ

133
00:07:53,610 --> 00:07:56,080
.نعم، سنفعل ما بوسعنا للنّجاح

134
00:07:57,660 --> 00:08:00,040
،قد لا يكون من شأني

135
00:08:00,830 --> 00:08:03,750
.ولكنّي لا أريد رؤيتها هي وكاريو تتشاجران

136
00:08:04,500 --> 00:08:05,960
.أريد أن أتغيّر

137
00:08:05,960 --> 00:08:09,460
هل أنا غير ودّيّة حقًّا؟

138
00:08:09,880 --> 00:08:13,010
.ولكنّي قد أكون فعلت شيئًا سيّئًا لهيشيرو-سان

139
00:08:13,010 --> 00:08:15,390
.بعد أن أراد أوغا دعوتها

140
00:08:15,390 --> 00:08:17,220
.ستبقى وحيدةً الآن

141
00:08:17,680 --> 00:08:20,850
لحظة، لِمَ أنا مضطربٌ لذلك؟

142
00:08:21,180 --> 00:08:23,020
!إنّها مشكلة الأطفال

143
00:08:29,610 --> 00:08:34,700
أليس لديكِ أيّ صديقٍ تأكلين معه
وقت الغداء يا هيشيرو-سان؟

144
00:08:41,580 --> 00:08:42,830
.ليس لديّ

145
00:08:43,460 --> 00:08:45,040
...توقّعت ذلك

146
00:08:46,250 --> 00:08:48,420
لِمَ تسأل أصلاً؟

147
00:08:48,420 --> 00:08:51,010
ألم أخبرك أنّه ليس لديّ أصدقاء منذ البداية؟

148
00:08:51,710 --> 00:08:53,420
هل تسخر منّي؟

149
00:08:54,300 --> 00:08:55,430
.سحقًا

150
00:08:59,680 --> 00:09:01,350
...مُلصق

151
00:09:05,520 --> 00:09:07,730
!لِمَ اختارت هذا في وقتٍ كهذا؟

152
00:09:07,730 --> 00:09:09,690
!هل هي مضطربةٌ عاطفيًّا؟

153
00:09:10,820 --> 00:09:12,530
.ولكن لا تقلق

154
00:09:12,530 --> 00:09:16,160
.أشعر أنّي سأكسب صديقًا قريبًا

155
00:09:18,700 --> 00:09:21,700
.أعتقد أنّي أنسجم مع كاريو-سان مؤخّرًا

156
00:09:22,080 --> 00:09:24,000
!ما الّذي جعلكِ تظنّين هذا؟

157
00:09:24,910 --> 00:09:28,670
هل حدث شيءٌ بينهما بينما لم أكن منتبهًا؟

158
00:09:28,670 --> 00:09:31,630
.لا، لا. كاريو بدَت مستعدّة للقتل وقت الغداء

159
00:09:31,630 --> 00:09:34,420
.هذا سوء فهم من هيشيرو-سان حتمًا

160
00:09:35,470 --> 00:09:38,260
إلى أيّ درجةٍ هي سيّئة بملاحظة من حولها؟

161
00:09:38,760 --> 00:09:40,890
.دون ذكر سوئها بتذكّر الأسماء

162
00:09:40,890 --> 00:09:43,350
ربّما لا تهتمّ بالآخرين؟

163
00:09:43,850 --> 00:09:46,730
.أطفال هذه الأيّام انطوائيّون جدًّا

164
00:09:47,480 --> 00:09:51,360
.ولكن سحقًا... إنّها وحيدةٌ حقًّا

165
00:09:52,860 --> 00:09:53,900
...صحيح

166
00:09:56,070 --> 00:09:58,200
...أعرف شخصًا آخر

167
00:09:58,610 --> 00:10:00,620
.يأكل الغداء لوحده

168
00:10:03,160 --> 00:10:04,910
.لا يمكنني فعل ذلك

169
00:10:04,910 --> 00:10:06,410
لِمَ لا؟

170
00:10:06,410 --> 00:10:08,750
.إنّك وحيدٌ أيضًا على أيّ حال

171
00:10:08,750 --> 00:10:11,840
.كثنائيّ وحيد، أنتما الاثنان يجب أن تتوافقا

172
00:10:11,880 --> 00:10:15,300
،على الرّغم من أنّك تحاول أن تكون لطيفًا
.إلاّ أنّك حقًّا فظٌ بصياغتك للأمر

173
00:10:15,300 --> 00:10:17,720
ماذا تعني بأنّي وحيدٌ على أيّ حال؟

174
00:10:18,130 --> 00:10:21,300
.أنا أختار ألاّ أختلط لظروف العمل

175
00:10:21,930 --> 00:10:26,600
.لا يمكنني تعقّبك إن كنت مع هيشيرو-سان

176
00:10:27,270 --> 00:10:30,860
،كنتَ في نفس فصلها في السّنة الماضية

177
00:10:30,860 --> 00:10:34,110
—وتجلس بجانبها. يمكنك على الأقلّ أكل

178
00:10:34,110 --> 00:10:35,030
.لا يمكنني

179
00:10:36,820 --> 00:10:39,240
.يا بارد القلب السّاديّ

180
00:10:39,240 --> 00:10:43,280
،إن كان ذلك بهذه الأهميّة
لِمَ لا تدعوها بنفسك؟

181
00:10:43,870 --> 00:10:45,040
...حسنًا

182
00:10:45,580 --> 00:10:47,960
.أنا أطلب منك ذلك لأنّي لا أستطيع

183
00:10:49,540 --> 00:10:53,210
.ما خطبك؟ يبدو أنّك تهتمّ حقًّا

184
00:10:53,590 --> 00:10:57,380
ما الّذي حدث للبقاء في الخلفيّة طوال السّنة؟

185
00:10:59,550 --> 00:11:01,140
...حسنًا

186
00:11:01,760 --> 00:11:05,100
.أعتقد أنّ هذا شيءٌ جيّد

187
00:11:05,100 --> 00:11:08,180
.أنت تلقي بالك لمن حولك

188
00:11:08,180 --> 00:11:11,730
.أنت لا تلاحظ فقط... بل تُبادر للمساعدة

189
00:11:11,730 --> 00:11:14,320
.أعتقد أنّها واحدةٌ من نقاط قوّتك

190
00:11:15,070 --> 00:11:16,820
ولكن ألا تتساءل؟

191
00:11:17,940 --> 00:11:21,950
هل التّخلص من كلّ الشّوك أمام طريق شخصٍ ما

192
00:11:21,950 --> 00:11:24,660
هو حقًّا ما هو أفضل له؟

193
00:11:26,490 --> 00:11:29,330
بينما هو ما يزال صغيرًا بما يكفي لأن
،يُسمح له بالتّعثّر والسّقوط

194
00:11:29,330 --> 00:11:32,750
من المهم أن يتعلّم ألم ذلك

195
00:11:32,750 --> 00:11:35,290
.وكيف يستجمع قواه مرّة أخرى

196
00:11:37,630 --> 00:11:39,260
...مِن حينٍ والآخر

197
00:11:39,970 --> 00:11:43,090
.تقول كلامًا ذا معنىً عميق. ذلك مزعجٌ نوعًا ما

198
00:11:43,300 --> 00:11:49,100
إذًا تعتقد أنّ محاولاتي للمساعدة لن تفيد؟

199
00:11:49,100 --> 00:11:51,350
لا توصي بذلك؟

200
00:11:51,690 --> 00:11:57,070
.لا، آسف. قلت ما خطر ببالي فحسب

201
00:11:57,650 --> 00:12:03,280
يمكنك عيش الرّيلايف الخاصّ بك بأيّ
.طريقةٍ تراها مناسبة يا كايزاكي-سان

202
00:12:07,490 --> 00:12:11,080
...عند نقطةٍ ما، حياتي

203
00:12:11,080 --> 00:12:13,290
...أفكاري

204
00:12:13,290 --> 00:12:15,790
.أصبحا يدوران حولهم

205
00:12:19,710 --> 00:12:22,050
أعني، أليس ذلك تفريطًا؟

206
00:12:22,510 --> 00:12:27,390
أريد أن يستمتع جميعهم بالوقت الّذي
.يقضونه في المدرسة فحسب

207
00:12:28,060 --> 00:12:31,850
...قد أكون أفكّر كعجوزٍ يلقي المحاضرات

208
00:12:32,270 --> 00:12:35,350
...ولكن رؤية أصدقائك كلّ يوم وكأنّه أمرٌ عاديّ

209
00:12:35,730 --> 00:12:39,320
.هو شيءٌ تفقده عندما تكبر

210
00:12:43,530 --> 00:12:46,490
.قاتل بكلّ ما أوتيت من قوّة

211
00:12:46,910 --> 00:12:52,410
.مع هؤلاء الصّغار، أعطِ عقلك وقلبك تدريبًا صلبًا

212
00:12:54,040 --> 00:12:58,210
.دع قلبك الّذي كان قد جفّ وخشِن أن ينبض مرّةً أخرى

213
00:13:06,010 --> 00:13:07,640
نحن في شهر مايو إذًا؟

214
00:13:08,220 --> 00:13:11,850
.مرّ شهرٌ منذ أن بدأت بريلايف هذا

215
00:13:11,850 --> 00:13:14,640
.لست متأكدًّا إن كان قد مرّ بسرعة أم ببطءٍ شديد

216
00:13:14,640 --> 00:13:15,730
!أراتا

217
00:13:16,480 --> 00:13:19,150
.لديّ اجتماع لجنة اليوم، لذا تفضّل

218
00:13:19,440 --> 00:13:21,400
.مذكّرة لاختبارك المُعاد

219
00:13:21,780 --> 00:13:25,660
.ظننت أنّنا لن ندرس اليوم بما أنّك لست موجودًا

220
00:13:29,910 --> 00:13:31,870
ألم تقل أنّك ستبذل جهدك؟

221
00:13:31,870 --> 00:13:33,870
.نعم. آسف

222
00:13:34,540 --> 00:13:38,170
تعلم أنّ هناك غرفة دراسيّة
في نهاية الطّابق الثّاني، صحيح؟

223
00:13:38,170 --> 00:13:40,170
.احرص على حلّها قبل أن تغادر

224
00:13:40,170 --> 00:13:41,170
...حسنًا

225
00:13:41,840 --> 00:13:43,170
.كازو-كن

226
00:13:43,590 --> 00:13:45,590
.لنذهب إلى اجتماع اللّجنة

227
00:13:45,590 --> 00:13:47,590
.آسف يا هيشيرو-سان

228
00:13:47,590 --> 00:13:48,760
.أنا قادم

229
00:13:48,760 --> 00:13:49,930
.حسنًا

230
00:13:53,850 --> 00:13:55,480
.كاريو-سان

231
00:13:55,480 --> 00:13:57,100
.تقابلت أعيننا مرّةً أخرى

232
00:13:59,440 --> 00:14:00,980
!هونوكا

233
00:14:00,980 --> 00:14:02,360
.لنذهب للتّدريب

234
00:14:04,740 --> 00:14:06,740
!هيّا يا هيشيرو-سان

235
00:14:06,740 --> 00:14:08,410
.نعم

236
00:14:17,040 --> 00:14:22,130
هل تبتسم لأوغا بالطّريقة الّتي تبتسم بها لكايزاكي؟

237
00:14:33,760 --> 00:14:36,480
.نفدت منّا الكرات، علينا جمعها

238
00:14:36,480 --> 00:14:37,190
!نعم

239
00:14:39,270 --> 00:14:40,900
.ها هي

240
00:14:40,900 --> 00:14:43,610
.أرأيت؟ أخبرتك أنّها ستكون ما تزال تتدرّب

241
00:14:43,610 --> 00:14:44,940
.لنعد إلى المنزل يا تاما

242
00:14:44,940 --> 00:14:45,940
ماذا؟

243
00:14:45,940 --> 00:14:47,530
تأخّر الوقت إلى هذا الحدّ؟

244
00:14:47,820 --> 00:14:50,990
.آسفة، فقدت الإحساس بالوقت

245
00:14:51,490 --> 00:14:52,870
.اذهبي لتغيّري ملابسك

246
00:14:52,870 --> 00:14:54,370
...ولكن الكرات

247
00:14:54,370 --> 00:14:56,330
.لا بأس. لن أغادر الآن على أيّ حال

248
00:14:56,700 --> 00:14:58,410
عليكِ أن تلحقي بقطارك، أليس كذلك؟

249
00:14:59,620 --> 00:15:00,920
.شكرًا لك

250
00:15:01,920 --> 00:15:03,880
!انتظرا هنا يا أكي-تشان ونوبو-تشان

251
00:15:03,880 --> 00:15:05,880
!سأذهب لتغيير ملابسي بسرعة

252
00:15:07,720 --> 00:15:09,680
.آسف يا كاريو-سان

253
00:15:09,680 --> 00:15:12,760
.دائمًا ما تبقيك تاما-تشان إلى وقتٍ متأخّر معها

254
00:15:12,760 --> 00:15:17,430
ولكن، يبدو أنّها تستمع بالتّدريب
.أكثر ممّا كانت سابقًا بفضلك

255
00:15:17,430 --> 00:15:21,150
.لا. أنا من يجعلها تبقى

256
00:15:21,730 --> 00:15:24,150
!إنّكما تفعلان أشياء أكثر منّي لها

257
00:15:24,150 --> 00:15:26,650
.الانتظار إلى هذا الوقت للعودة إلى المنزل معها

258
00:15:27,030 --> 00:15:29,570
،إن تركنا تاما-تشان تركب القطار لوحدها

259
00:15:29,570 --> 00:15:31,450
فمن يدري أين سينتهي بها المطاف؟

260
00:15:31,860 --> 00:15:37,040
يصرّ آباؤنا على الاعتناء بها
.وإحضارها إلى منزلها بسلام

261
00:15:42,000 --> 00:15:44,170
.شـ-شكرًا

262
00:15:44,170 --> 00:15:45,340
.لا داعي

263
00:15:47,300 --> 00:15:49,010
.شكرًا لكما على الانتظار. لنذهب

264
00:15:49,010 --> 00:15:49,970
.حسنًا

265
00:15:51,550 --> 00:15:53,260
.حسنًا إذًا، آسفة يا رينا

266
00:15:53,260 --> 00:15:56,060
.أقفلي غرفة النّادي والقاعة الرّياضيّة عندما تنتهين

267
00:15:56,060 --> 00:15:57,890
.وأعيدي المفتاح إلى غرفة أعضاء هيئة التّدريس

268
00:15:57,890 --> 00:15:58,980
.فهمت

269
00:15:59,430 --> 00:16:00,480
!إلى اللّقاء

270
00:16:11,570 --> 00:16:12,740
.لا بدّ وأنّ هذا لطيف

271
00:16:15,240 --> 00:16:18,160
.قضاء كلّ يوم مع أصدقاء طفولة لطفاء

272
00:16:25,880 --> 00:16:27,420
كاريو-سان؟

273
00:16:28,750 --> 00:16:30,970
!حصلنا على نفس النّتائج

274
00:16:31,300 --> 00:16:34,470
.لنجتهد بالعمل معًا كمُمثليْ الصّفّ للفصل الأوّل

275
00:16:34,890 --> 00:16:36,470
...نـ-نعم

276
00:16:38,060 --> 00:16:41,350
.كنتُ ممثّلة الصّفّ 1 في الفصل الأوّل من سنتي الأولى

277
00:16:42,100 --> 00:16:45,020
.ولكنّي لم أكن الأولى في الفصلين التّاليين

278
00:16:45,860 --> 00:16:46,980
،كرهت ذلك

279
00:16:48,480 --> 00:16:50,690
لذا حرصت على أن أمتلك المشبك الفضّيّ
.طوال السّنة الماضية

280
00:16:51,490 --> 00:16:52,360
!كاريو

281
00:16:54,700 --> 00:16:55,950
!وقت اللّجنة

282
00:16:56,240 --> 00:16:57,160
!نعم

283
00:16:58,120 --> 00:16:59,160
،لسنةٍ كاملة

284
00:16:59,910 --> 00:17:02,000
!...لم أترك ذلك المشبك الفضّيّ أبدًا، ولكن

285
00:17:09,590 --> 00:17:10,550
لِمَ؟

286
00:17:20,180 --> 00:17:22,060
لِمَ أنا دائمًا؟

287
00:17:24,060 --> 00:17:26,440
لِمَ لا يمكنني فعل شيءٍ بشكلٍ صحيح؟

288
00:17:29,860 --> 00:17:30,900
...لا

289
00:17:31,780 --> 00:17:34,280
!لا أتحمّل كوني هكذا

290
00:17:35,780 --> 00:17:36,780
!توقّفي

291
00:17:45,460 --> 00:17:47,710
...ما زالت تؤلم أحيانًا

292
00:17:47,830 --> 00:17:49,460
هل هذا ما يعنيه أن نهرم؟

293
00:17:57,970 --> 00:18:00,300
ما يزال هناك تلاميذ في هذا الوقت؟

294
00:18:01,600 --> 00:18:03,140
.المعذرة

295
00:18:03,140 --> 00:18:05,480
.أنا هنا لإعادة مفتاح القاعة الرّياضيّة

296
00:18:13,110 --> 00:18:14,360
هيشيرو؟

297
00:18:18,030 --> 00:18:19,490
.إلى اللّقاء

298
00:18:28,750 --> 00:18:29,750
...هذه

299
00:18:30,790 --> 00:18:32,550
.حقيبة هيشيرو

300
00:18:37,680 --> 00:18:39,180
...المشبك الفضّيّ

301
00:18:40,180 --> 00:18:41,680
.دليل أنّك الأولى

302
00:18:42,600 --> 00:18:43,930
.دليل أنّك عملت بجدّ

303
00:18:45,810 --> 00:18:47,480
،ولكن بالنّسبة لي

304
00:18:47,980 --> 00:18:49,690
.لم تكن مجرّد مكانة

305
00:18:50,650 --> 00:18:51,440
...بالنّسبة لي

306
00:18:53,400 --> 00:18:54,570
...كان

307
00:18:55,530 --> 00:18:58,320
!دليلاً أنّي استحققت أن أكون رفقة أوغا

308
00:19:02,200 --> 00:19:06,330
حصلَت على كلّ شيءٍ دون أن تبدو
!أنّها اجتهدت على الإطلاق

309
00:19:06,330 --> 00:19:08,290
!إنّها تستحق بعض المتاعب

310
00:19:08,290 --> 00:19:09,290
...لا بأس

311
00:19:09,290 --> 00:19:10,500
...لن يتمّ كشفي

312
00:19:10,500 --> 00:19:13,710
،سأمشي خارج المدرسة بشكل طبيعيّ
.وأرميها في حمّام المحطّة

313
00:19:18,090 --> 00:19:19,340
ماذا؟

314
00:19:19,760 --> 00:19:21,760
ستغادرين الآن يا كاريو؟

315
00:19:22,220 --> 00:19:24,100
...كايزاكي

316
00:19:27,350 --> 00:19:30,140
لِمَ ما تزال هنا؟

317
00:19:30,140 --> 00:19:33,110
.أدرس

318
00:19:33,110 --> 00:19:35,400
.كنت أستخدم غرفة الدّراسة

319
00:19:35,400 --> 00:19:37,070
قالت لي سينسي أن أقفلها

320
00:19:37,070 --> 00:19:40,030
وأحضر المفتاح إلى غرفة أعضاء هيئة
.التّدريس عندما أنتهي

321
00:19:40,400 --> 00:19:42,280
ماذا عنكِ؟ انتهيت من التّدريب للتّوّ؟

322
00:19:43,450 --> 00:19:44,950
ما الخطب؟

323
00:19:44,950 --> 00:19:46,790
...أنا

324
00:19:46,790 --> 00:19:49,160
.أعدت مفتاح القاعة الرّياضيّة للتّوّ أيضًا

325
00:19:49,160 --> 00:19:50,540
.حسنًا

326
00:19:51,870 --> 00:19:53,000
!ابقَ بعيدًا

327
00:19:54,000 --> 00:19:55,550
...صحيح

328
00:19:55,550 --> 00:19:58,170
.لا أعلم أين أضع هذه المفاتيح

329
00:19:58,760 --> 00:20:01,430
!لا يمكنني التّوقّف للحديث هنا

330
00:20:02,050 --> 00:20:05,640
آسف، ولكن هل يمكنكِ أن تأتي معي وتدلّيني؟

331
00:20:05,930 --> 00:20:07,640
،إن أضعت الكثير من الوقت

332
00:20:07,640 --> 00:20:09,770
!فستغادر هيشيرو غرفة أعضاء هيئة التّدريس

333
00:20:10,520 --> 00:20:12,190
.آ-آسفة

334
00:20:12,190 --> 00:20:13,650
.عليّ العودة إلى المنزل

335
00:20:14,230 --> 00:20:16,520
آسفة، ولكن هل يمكنك طلب ذلك من أستاذ؟

336
00:20:16,520 --> 00:20:19,240
.حسنًا، اعتني بنفسك

337
00:20:20,700 --> 00:20:21,530
!كاريو

338
00:20:24,700 --> 00:20:27,160
لِمَ لديكِ حقيبتان؟

339
00:20:30,540 --> 00:20:31,540
ماذا؟

340
00:20:31,540 --> 00:20:32,420
.لا سبب

341
00:20:32,960 --> 00:20:35,380
...أعني، لأجل ملابس التّدريب

342
00:20:35,670 --> 00:20:36,670
.لا

343
00:20:36,670 --> 00:20:38,000
.هذا ليس ما في الأمر

344
00:20:38,500 --> 00:20:40,590
.أعرف هذه الحقيبة

345
00:20:40,590 --> 00:20:42,430
.الحقيبة الخضراء

346
00:20:42,970 --> 00:20:44,140
...أليست هذه

347
00:20:44,510 --> 00:20:46,350
لهيشيرو-سان؟

348
00:20:51,520 --> 00:20:52,480
كاريو؟

349
00:20:55,980 --> 00:20:58,320
!كاريو! انتظري

350
00:20:58,320 --> 00:20:59,320
!قلت انتظري

351
00:20:59,320 --> 00:21:00,740
!لا! اتركني

352
00:21:05,160 --> 00:21:06,030
!كاريو

353
00:21:20,050 --> 00:21:21,340
.إلى اللّقاء

354
00:21:27,470 --> 00:21:29,560
أين حقيبتي؟

355
00:21:30,520 --> 00:21:31,810
...لحظة

356
00:21:31,810 --> 00:21:34,440
ما كان ذلك الضّجيج؟

357
00:23:24,880 --> 00:23:40,000
الحلقة القادمة

358
00:23:25,840 --> 00:23:28,470
،لم أكن سيّئًا بالرّياضة

359
00:23:28,470 --> 00:23:31,840
على الرّغم من أخذي سنتين من أجل الالتحاق
.بالجامعة، لم أكن سيّئًا بالدّراسة أيضًا

360
00:23:31,970 --> 00:23:33,300
ذهبت إلى مدرسة دراسات عليا

361
00:23:33,300 --> 00:23:35,310
.وتمكّنت من تأمين وظيفة

362
00:23:35,310 --> 00:23:38,890
.ظننت أنّ لديّ حياة بالغين ناجحة بانتظاري