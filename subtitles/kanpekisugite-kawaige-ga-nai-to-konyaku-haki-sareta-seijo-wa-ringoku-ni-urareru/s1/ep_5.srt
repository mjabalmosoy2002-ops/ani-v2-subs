1
00:00:10,780 --> 00:00:14,520
شكراً لكِ على قضاء الرّحلة
الطّويلة إلى هنا

2
00:00:14,520 --> 00:00:16,720
أهلاً بكِ يا غريس

3
00:00:16,720 --> 00:00:18,030
...ا... ا

4
00:00:18,030 --> 00:00:20,660
!القدّيسة فيليا

5
00:00:20,660 --> 00:00:22,330
!القدّيسة فيليا أديناور

6
00:00:22,330 --> 00:00:23,980
!شرف لي أن ألتقي بكِ

7
00:00:23,980 --> 00:00:26,150
!اسمي غريس ماتّيلاس

8
00:00:26,150 --> 00:00:31,100
إنّ الدّراسة تحت جناح أعظم قدّيسة
!في كلّ الأوقات هو حُلم بالنّسبة لي

9
00:00:31,760 --> 00:00:34,010
حـ-حقّاً؟

10
00:02:06,570 --> 00:02:09,980
آنسة فيليا، كنتُ أرغب في طرح سُؤال عليكِ

11
00:02:10,380 --> 00:02:12,150
هل ترغبين في تجربة أن تكوني مُعلّمة؟

12
00:02:13,480 --> 00:02:15,320
مُعلّمة؟

13
00:02:15,320 --> 00:02:17,110
هل سمعتِ بعائلة ماتّيلاس من قبل؟

14
00:02:18,240 --> 00:02:22,070
عائلة ماتّيلاس؟ من مملكة بولميرن؟

15
00:02:22,070 --> 00:02:22,870
تماماً

16
00:02:23,150 --> 00:02:26,220
،خرّجتْ قدّيسات لبولميرن لأجيال

17
00:02:26,220 --> 00:02:28,690
ولديهم روابط عميقة مع العائلة الملكيّة هناك

18
00:02:29,230 --> 00:02:33,550
عائلة أيلكرانتز، والّتي خرّجتْ
،قدّيسات لبارناكورتا

19
00:02:33,550 --> 00:02:36,010
انبثقتْ كفرع عن عائلة ماتّيلاس كذلك

20
00:02:36,010 --> 00:02:38,660
،بسبب التّقارب بين بلدينا

21
00:02:38,660 --> 00:02:41,720
لدينا كثير من الاحتكاك مع عائلة ماتّيلاس

22
00:02:42,000 --> 00:02:48,640
ومُؤخّراً، أرسلوا لنا طلباً لتعلُّم
سحر التّطهير منكِ

23
00:02:49,250 --> 00:02:53,650
يرغبون في إرسال ابنتهم الرّابعة
غريس للدّراسة هنا

24
00:02:54,560 --> 00:02:56,150
هكذا إذاً

25
00:02:59,370 --> 00:03:00,560
...في هذه الحالة

26
00:03:05,290 --> 00:03:07,540
أعتذر لو أخفتُكِ

27
00:03:08,250 --> 00:03:11,580
مولاتي غريس هي من أشدّ مُعجباتكِ

28
00:03:11,580 --> 00:03:15,630
إنّها تُكرّس نفسها وتجتهد كلّ يوم
على أمل أن تُصبح قدّيسة مثلكِ

29
00:03:15,920 --> 00:03:17,900
من فضلكِ تجاهلي طيشها

30
00:03:17,900 --> 00:03:18,550
حـ-حسناً

31
00:03:18,550 --> 00:03:24,550
آرنولد! قلتُ لك بأنّني أردتُ أن أخبرها
!أنا بأنّني من أشدّ مُعجباتها

32
00:03:23,600 --> 00:03:24,550
سامحيني

33
00:03:25,210 --> 00:03:29,810
بدت القدّيسة فيليا مُتفاجئة من حماسكِ

34
00:03:32,200 --> 00:03:35,310
،القدّيسة فيليا، أعلم بأنّني عديمة الخبرة

35
00:03:35,310 --> 00:03:37,280
!لكن من فضلكِ علّميني كلّ ما يمكنكِ تعليمه

36
00:03:37,280 --> 00:03:42,990
يبدو أنّ الأمور ستكون حيويّة
في القصر في المُستقبل القريب

37
00:03:44,210 --> 00:03:44,990
القدّيسة فيليا

38
00:03:45,770 --> 00:03:48,370
هل أنتِ متأكّدة من هذا؟

39
00:03:48,370 --> 00:03:52,750
من تعليم دائرة التّطهير العظيمة لشخص
...من مملكة أُخرى

40
00:03:53,300 --> 00:03:57,080
إنّه ليس سرّاً وثيقاً

41
00:04:00,340 --> 00:04:02,970
،لكنّه يتطلّب معرفة بالطّقوس القديمة

42
00:04:02,970 --> 00:04:05,260
ولا يستطيع الجميع أداءه

43
00:04:05,850 --> 00:04:11,020
بالفعل، لا تتطلّب دائرة التّطهير
العظيمة موهبة خاصّة

44
00:04:11,430 --> 00:04:14,440
ما تتطلّبه هو المعرفة والإدراك

45
00:04:14,820 --> 00:04:18,940
مثلما فعلت السّابقات، يجب عليها
دراسة اللّغة القديمة

46
00:04:19,610 --> 00:04:22,360
ميا لا تستطيع استخدام دائرة التّطهير العظيمة

47
00:04:22,360 --> 00:04:25,160
لأنّها لا تعرف اللّغة المطلوبة

48
00:04:26,070 --> 00:04:29,880
ليتني أستطيع تعليمها اللّغة
...القديمة على الأقلّ

49
00:04:31,410 --> 00:04:36,670
يبدو أنّ عائلة ماتّيلاس تُدرج دروس
اللّغة القديمة في تدريبها

50
00:04:36,670 --> 00:04:38,850
،لذا إذا كانت غريس تعرف ما يكفي

51
00:04:38,850 --> 00:04:41,960
فقد تتمكّن من تعلُّم دائرة التّطهير
العظيمة بسرعة

52
00:04:43,390 --> 00:04:47,440
أرغب الآن في الشّروع في
دروس الطّقوس القديمة

53
00:04:47,440 --> 00:04:49,010
!لا أطيق الانتظار

54
00:04:49,410 --> 00:04:53,260
:تحتاجين شيئين لأداء الطّقوس القديمة

55
00:04:53,260 --> 00:04:55,140
المعرفة والإدراك

56
00:04:55,140 --> 00:04:56,730
،يجب أن تعرفي اللّغة القديمة

57
00:04:56,730 --> 00:04:59,400
والّتي أعتقد بأنّكِ درستِها إلى حدٍّ ما

58
00:04:59,770 --> 00:05:01,250
ثمّ هناك الإدراك

59
00:05:01,250 --> 00:05:04,030
لنتمرّن على الشُّعور بقوّة السّحر
الطّبيعيّة اللّازمة

60
00:05:04,030 --> 00:05:06,280
لاستخدام الطّقوس القديمة، والمعروفة بالمانا

61
00:05:06,280 --> 00:05:07,160
!حاضرة

62
00:05:07,160 --> 00:05:11,490
لكن ما هي هذه "المانا"؟
...لم أسمع بها من قبل

63
00:05:13,170 --> 00:05:14,370
دعيني أرى

64
00:05:14,730 --> 00:05:17,890
،عادةً، عندما نلقي تعويذات

65
00:05:17,890 --> 00:05:20,670
نستخدم قوّة السّحر الّتي بداخلنا

66
00:05:20,670 --> 00:05:22,340
يُعرَف هذا بأودو

67
00:05:22,340 --> 00:05:26,930
بالمُقابل، القوّة السّحريّة الّتي تنشأ
من العالم الطّبيعيّ تُدعى بالمانا

68
00:05:27,690 --> 00:05:32,510
العديد من الطّقوس القديمة، مثل دائرة
التّطهير العظيمة، هائلة جدّاً

69
00:05:32,510 --> 00:05:35,850
لدرجة أنّه سيكون من الصّعب أداءها
من خلال سحرنا وحده

70
00:05:35,850 --> 00:05:38,400
نستخدم المانا لسدّ الثّغرات

71
00:05:38,730 --> 00:05:44,760
لهذا أوّل تحدٍّ هو تعلُّم كيفيّة
الشّعور بالمانا

72
00:05:44,760 --> 00:05:46,150
!هكذا إذاً

73
00:05:46,150 --> 00:05:48,570
قِفي في الخارج واشعري بأشعّة الشّمس

74
00:05:49,130 --> 00:05:52,390
استمعي إلى حفيف النّباتات

75
00:05:53,330 --> 00:05:57,690
إذا أدخلتِ نفسكِ في غيبوبة أثناء الشُّعور
،بقوّة الطّبيعة من خلال جسدكِ

76
00:05:57,690 --> 00:06:00,330
فأعتقد سيكون من الأسهل الشُّعور بها حينها

77
00:06:00,330 --> 00:06:02,000
!سأُجرّب ذلك

78
00:06:20,320 --> 00:06:22,630
يُذكّرني هذا بتدريبي

79
00:06:24,110 --> 00:06:25,980
!القدّيسة فيليا

80
00:06:25,980 --> 00:06:29,160
!لا أستطيع الشُّعور بالمانا إطلاقاً

81
00:06:29,160 --> 00:06:34,490
،يمكنني أن أُميّز بأنّ هناك قوّة في الطّبيعة
لكن هذا كلّ شيء

82
00:06:34,490 --> 00:06:36,430
سيَفي هذا بالغرض حاليّاً

83
00:06:37,280 --> 00:06:42,230
هذا الإحساس البسيط يعني أنّكِ
قادرة على الشُّعور بالمانا

84
00:06:42,230 --> 00:06:46,130
،أصقلي ذلك الإحساس، ومع الوقت
ستستطيعين التّفاعل معها كذلك

85
00:06:47,200 --> 00:06:49,180
...وبالنّسبة لكيفيّة الدّفع بنفسكِ أكثر

86
00:06:49,810 --> 00:06:51,150
دعيني أُفكّر

87
00:06:53,200 --> 00:06:54,100
!تعال أيُّها النُّور

88
00:07:01,150 --> 00:07:03,520
هذا الضّوء السّاطع هو المانا

89
00:07:03,520 --> 00:07:07,970
ارتأيتُ بأنّه قد يكون من الأسهل
مُلاحظته بعنصر مرئيّ

90
00:07:07,970 --> 00:07:10,320
القدّيسة فيليا، تبدين جميلة

91
00:07:10,320 --> 00:07:12,450
أنتِ كملاك

92
00:07:12,960 --> 00:07:14,990
أنا متأكّدة بأنّكِ تُبالغين

93
00:07:16,340 --> 00:07:19,020
ما الّذي يجري هنا؟

94
00:07:19,020 --> 00:07:22,370
وكأنّها تُركّز بشكل حثيث
على كلّ كلمة أقولها

95
00:07:23,690 --> 00:07:28,800
لماذا شخص من مملكة أُخرى
...لم ألتقِ به أبداً

96
00:07:28,800 --> 00:07:30,050
...بصراحة

97
00:07:30,330 --> 00:07:33,920
...كُتُبكِ، أُطروحات القدسيّة

98
00:07:33,920 --> 00:07:35,680
!إنّها نصوصي المُقدّسة شخصيّاً

99
00:07:36,520 --> 00:07:38,220
ما رأيكِ أيّتها القدّيسة فيليا؟

100
00:07:37,460 --> 00:07:40,140
نسيتُ بأنّني نشرتُ كُتُباً

101
00:07:38,220 --> 00:07:41,630
أعتقد بأنّ النّاس أساؤوا فهم الكثير
ممّا تتطلّبه القدسيّة

102
00:07:40,140 --> 00:07:44,980
رفضتُ الفكرة بضع مرّات لأنّها
بدت بلا صِلة بواجباتي القدسيّة

103
00:07:41,630 --> 00:07:44,980
!أعتقد بأنّ نشر مُؤلّفاتكِ فكرة سديدة

104
00:07:44,980 --> 00:07:46,820
!ما رأيكِ؟ لنفعلها

105
00:07:44,980 --> 00:07:46,820
لكن قبلتُ طوعاً في النّهاية

106
00:07:47,220 --> 00:07:51,680
كانت مجموعة من الأشياء فحسب
تعلّمتُها في قضاء وقتي كقدّيسة

107
00:07:51,680 --> 00:07:54,320
وبحثي العامّ

108
00:07:54,320 --> 00:07:55,930
لا شيء يستحقّ الثّناء

109
00:07:55,930 --> 00:07:57,410
!لا، أنتِ مُخطئة

110
00:07:57,410 --> 00:08:00,950
!كتُبكِ جعلَتْني أُواظب في أحلك ساعاتي

111
00:08:01,470 --> 00:08:06,680
،أنا الابنة الرّابعة في عائلة القدّيسين
...من دون موهبة استثنائيّة

112
00:08:06,680 --> 00:08:10,260
كنتُ قادرة على الصُّمود وتحمُّل
تدريبي القاسي

113
00:08:10,260 --> 00:08:12,230
"لأنّني قرأتُ "أُطروحات القدسيّة

114
00:08:12,230 --> 00:08:13,780
!وتأثّرتُ بتعاليمها

115
00:08:13,780 --> 00:08:16,890
!أردتُ أن أصبح مثلكِ فحسب يوماً ما

116
00:08:18,030 --> 00:08:20,620
كان ذلك واضحاً بالنّسبة لي
من خلال قراءة عملكِ

117
00:08:20,620 --> 00:08:25,150
لم ألمس أي فرض رأي من الكاتب
يُفرَض عادة في الكُتُب

118
00:08:25,560 --> 00:08:31,280
لمستُ فيه قلباً غير مُتحيّز، كرّس
نفسه للحرفة

119
00:08:31,710 --> 00:08:34,910
لم أُصدّق حتّى أنّه يوجد شخصٌ مثلكِ

120
00:08:35,310 --> 00:08:39,950
...وهكذا أردتُ دوماً أن ألتقي بكِ وأقول لكِ

121
00:08:40,520 --> 00:08:42,450
!شكراً لكِ

122
00:08:44,130 --> 00:08:48,490
...لأنّكِ أصبحتِ قدّيسة، لتأليفكِ تلك الكُتُب

123
00:08:49,420 --> 00:08:50,840
شكراً جزيلاً لكِ

124
00:08:51,760 --> 00:08:55,090
أنقذتِني

125
00:08:55,870 --> 00:08:59,240
!غطرسة نشر هذا الهُراء

126
00:08:59,240 --> 00:09:01,580
!أليس لوقاحتكِ حدود؟

127
00:09:02,220 --> 00:09:04,560
!أُطروحات القدسيّة؟

128
00:09:04,560 --> 00:09:08,200
!إنّها لا تعدو كونها تبجُّحاً بإنجازاتكِ

129
00:09:08,200 --> 00:09:10,330
سنوقف نشرها حالاً

130
00:09:10,840 --> 00:09:14,740
لم تعُد كُتُبي مُتداوَلة في غيرتونيا

131
00:09:15,400 --> 00:09:18,920
...العالم الّذي عشتُ فيه رفضني من كلّ ناحية

132
00:09:19,930 --> 00:09:23,440
لذا بدأتُ أعتقد بأنّ ذلك كان طبيعيّاً

133
00:09:24,860 --> 00:09:29,250
أصبحتُ نادمة على كتابة أيّ شيء

134
00:09:30,370 --> 00:09:31,230
...لكن

135
00:09:32,150 --> 00:09:33,310
فهمتُ الآن

136
00:09:34,260 --> 00:09:39,100
العالم الّذي عشتُ فيه كان
صغيراً جدّاً، أليس كذلك؟

137
00:09:43,130 --> 00:09:45,770
لنأخذ استراحة الآن

138
00:09:45,770 --> 00:09:47,270
!حاضرة

139
00:09:47,740 --> 00:09:52,930
القدّيسة فيليا، هل درّبتِ شخصاً قبلي؟

140
00:09:52,930 --> 00:09:55,780
لا. أنتِ الأُولى

141
00:09:55,780 --> 00:09:57,350
!أنا تلميذتكِ الأُولى؟

142
00:09:57,350 --> 00:09:59,200
!يا للرّوعة

143
00:09:59,200 --> 00:10:02,260
!شرحكِ سهل الفهم

144
00:10:02,260 --> 00:10:05,580
!وعندما تمدحينني، يمنحني هذا حافزاً كبيراً

145
00:10:06,130 --> 00:10:07,490
حقّاً؟

146
00:10:07,490 --> 00:10:08,920
!أجل

147
00:10:09,420 --> 00:10:13,460
أشعر وكأنّ لينا قالت كلاماً مُشابهاً

148
00:10:14,430 --> 00:10:18,160
لكن أنا أُقلّد مُعلّمتي فحسب

149
00:10:18,160 --> 00:10:20,340
!الشّخص الّذي علّمكِ؟

150
00:10:20,340 --> 00:10:24,020
هل هي قدّيسة غيرتونيا السّابقة إذاً؟

151
00:10:24,020 --> 00:10:24,720
أجل

152
00:10:25,220 --> 00:10:27,720
اسمها هيلديغارد أديناور

153
00:10:27,720 --> 00:10:29,620
إنّها الأُخت الكبرى لأُمّي

154
00:10:29,620 --> 00:10:32,460
أي عمّتي

155
00:10:32,460 --> 00:10:34,480
كيف كانت؟

156
00:10:35,880 --> 00:10:38,480
كانت صارمة جدّاً

157
00:10:38,480 --> 00:10:40,490
!القدّيسة فيليا، عيناكِ سارحتان

158
00:10:40,830 --> 00:10:43,240
عديمة الرّحمة" هي الكلمة الّتي"
يمكنني استعمالها

159
00:10:43,570 --> 00:10:48,270
تركَتْني في جبل في الشّتاء
لتُعلّمني النّجاة بمُفردي

160
00:10:49,140 --> 00:10:51,830
دفنَتْني في الصّحراء لوحدي تماماً

161
00:10:53,160 --> 00:10:57,170
كانت تدعني أستلقي على أسرّة
من إبر لتمرين تحكُّمي بالسّحر

162
00:10:58,840 --> 00:11:00,460
كان ذلك صعباً

163
00:11:00,460 --> 00:11:03,550
!"أشعر بأنّ هذا يتجاوز كلمة "صعب

164
00:11:04,510 --> 00:11:09,820
لكن في هذه الحالة، هل كان يوجد
سبب جعلَها تقسو عليكِ؟

165
00:11:10,310 --> 00:11:14,640
،أقصد فيما إذا كان شخص قاسياً أو لطيفاً
،يحبّكِ أو يكرهكِ

166
00:11:14,640 --> 00:11:16,970
هناك سبب دوماً

167
00:11:16,970 --> 00:11:18,190
سبب؟

168
00:11:18,920 --> 00:11:20,870
أنا آسفة يا فيليا

169
00:11:20,870 --> 00:11:22,740
لم ترتكبي أيّ خطأ

170
00:11:23,130 --> 00:11:28,240
،لكن لطالما كانت علاقتي سيّئة مع والديكِ

171
00:11:28,240 --> 00:11:31,280
...وتُشبهينني كثيراً عندما كنتُ أصغر سنّاً

172
00:11:31,280 --> 00:11:33,500
ليست غلطتكِ أنّهما يكرهانكِ

173
00:11:33,840 --> 00:11:38,140
لهذا سعيتُ جاهدة لأشدّ من عزمكِ

174
00:11:38,140 --> 00:11:41,090
وذلك كي تتمكّني من تجاوز أي عقبة
ترميها الحياة في وجهكِ

175
00:11:41,720 --> 00:11:43,070
هذا صحيح

176
00:11:43,070 --> 00:11:46,910
كانت مُعلّمتي قلقة عليّ دوماً

177
00:11:48,810 --> 00:11:53,100
لا أُصدّق بأنّني لم أُدرِك شيئاً بهذه
...الأهمّية إلّا بعد مُغادرة المملكة

178
00:11:53,510 --> 00:11:55,820
!سامحيني يا مُعلّمتي

179
00:12:00,310 --> 00:12:01,610
لينا

180
00:12:01,610 --> 00:12:02,870
نعم؟

181
00:12:02,870 --> 00:12:08,120
لماذا تُوافق الشّخصيّة الرّئيسيّة على الهرب
إلى هنا رغم أنّه تصرّف خاطئ؟

182
00:12:09,400 --> 00:12:11,250
...السّبب هو

183
00:12:11,620 --> 00:12:15,980
رغبتها في القيام بذلك هي
!الّتي تنتصر في النّهاية

184
00:12:15,980 --> 00:12:17,570
أهكذا يكون الأمر؟

185
00:12:17,570 --> 00:12:19,990
!بكلّ تأكيد

186
00:12:19,990 --> 00:12:22,500
أنا آسفة لطرحي أسئلة كثيرة عليكِ

187
00:12:22,500 --> 00:12:23,840
!لا أُمانع

188
00:12:24,120 --> 00:12:27,100
يسرّني أن أكون قادرة على
مُحادثة شخص حول ذلك

189
00:12:27,100 --> 00:12:28,100
القدّيسة فيليا

190
00:12:28,560 --> 00:12:30,400
رسالة من هيماري

191
00:12:37,760 --> 00:12:40,360
...والآن، بخصوص الغد

192
00:12:40,360 --> 00:12:43,230
تمّ تجهيز العربة

193
00:12:43,720 --> 00:12:46,460
القدّيسة فيليا، هل أنتِ
ذاهبة إلى مكان ما؟

194
00:12:48,200 --> 00:12:49,130
أجل

195
00:12:50,040 --> 00:12:54,140
تريد غريس زيارة قبر إليزابيث

196
00:12:56,360 --> 00:12:58,000
...عزيزتي ليز

197
00:12:58,000 --> 00:13:01,360
تُوفّيتْ قبل أشهر قليلة، أليس كذلك؟

198
00:13:01,360 --> 00:13:04,380
أجل. منذ حوالي ثلاثة أشهر

199
00:13:06,060 --> 00:13:11,520
ليز... إليزابيث... كانت ابنة عمّي

200
00:13:12,130 --> 00:13:14,380
،وُلِدت ببُنية جسديّة ضعيفة

201
00:13:14,380 --> 00:13:17,180
لذا كان أبي قلقاً عليها دوماً

202
00:13:17,180 --> 00:13:22,820
كنتُ كثيراً ما آتي إلى بارناكورتا لرؤيتها

203
00:13:23,760 --> 00:13:25,570
هكذا إذاً

204
00:13:28,000 --> 00:13:29,600
فيليا؟

205
00:13:29,600 --> 00:13:30,580
...و

206
00:13:32,330 --> 00:13:33,750
ليز؟

207
00:13:34,430 --> 00:13:35,410
...لا

208
00:13:36,740 --> 00:13:38,640
غريس، صحيح؟

209
00:13:38,640 --> 00:13:41,750
بالفعل، أنا غريس ماتّيلاس

210
00:13:50,870 --> 00:13:54,080
تزور قبر إليزابيث أيضاً، أليس
كذلك يا سموّ الأمير رايهارد؟

211
00:13:54,080 --> 00:13:54,890
أجل

212
00:13:55,210 --> 00:13:57,810
كنتُ وهي مخطوبين

213
00:14:15,720 --> 00:14:18,580
...لطالما أحبّتْ هذه الزُّهور

214
00:14:19,240 --> 00:14:21,750
فريشيا الذّهبيّة

215
00:14:22,540 --> 00:14:26,300
،كنتُ أحبّ تقديم أجمل الهدايا لها

216
00:14:26,300 --> 00:14:30,430
لكن قالت لي أنّ رائحة هذه
الزُّهور تُذكّرها بي

217
00:14:31,180 --> 00:14:34,930
لم أكن أعرف كيف أردّ على ذلك

218
00:14:41,430 --> 00:14:44,320
لا أُجيد قراءة المشاعر، لكن
...حتّى أنا أُميّز ذلك

219
00:14:45,230 --> 00:14:50,860
لا يزال واقعاً في حُبّ إليزابيث

220
00:14:51,970 --> 00:14:53,870
كانت مُفاجأة حقيقيّة

221
00:14:54,620 --> 00:14:57,770
لم أتوقّع أن أتمكّن من اللّقاء
بالأمير رايهارد

222
00:14:58,370 --> 00:15:02,830
سمعتُ بأنّ واجباته تُبقيه مشغولاً جدّاً

223
00:15:02,830 --> 00:15:03,380
أجل

224
00:15:04,490 --> 00:15:08,300
،يستطيع النّاس أن يُحِبّوا بهذا العمق
أليس كذلك؟

225
00:15:08,830 --> 00:15:10,900
لم يحبّني أحدٌ من قبل

226
00:15:10,900 --> 00:15:13,890
ما زلتُ لا أعرف ما الّذي يعني هالحُبّ حتّى

227
00:15:14,390 --> 00:15:17,390
من الطّبيعيّ ألّا أفهم

228
00:15:18,300 --> 00:15:19,280
...لحظة

229
00:15:19,280 --> 00:15:25,010
طوال هذا الوقت، كنتُ أحاول
كسب حُبّ الآخرين

230
00:15:25,690 --> 00:15:29,670
هل سبقَ وحاولتُ أن أُحبّ أحداً؟

231
00:15:39,230 --> 00:15:42,370
القدّيسة فيليا! هل لي بلحظة؟

232
00:15:42,730 --> 00:15:43,830
حسناً

233
00:15:46,460 --> 00:15:50,720
آسفة، لكن هل يمكنكِ تسليم هذه لأجلي؟

234
00:15:51,340 --> 00:15:52,970
!الآنسة فيليا

235
00:15:54,550 --> 00:15:56,280
...الأمير أوزفالت

236
00:15:56,280 --> 00:15:57,510
!يسرّني أن ألقاكِ هنا

237
00:15:57,510 --> 00:16:00,370
ما الّذي جاء بكِ إلى هنا؟

238
00:16:01,040 --> 00:16:04,100
طلبتْ منّي لينا تسليمك هذه

239
00:16:04,480 --> 00:16:05,480
وداعاً

240
00:16:05,480 --> 00:16:06,400
!كان ذلك سريعاً

241
00:16:06,400 --> 00:16:07,730
!لحظة، لحظة، انتظري قليلاً

242
00:16:08,060 --> 00:16:10,380
يوجد ما يكفي لشخصين هنا

243
00:16:10,380 --> 00:16:11,990
ما رأيكِ بمُشاركتي؟

244
00:16:17,800 --> 00:16:19,660
!إنّها لذيذة

245
00:16:19,660 --> 00:16:21,250
يا لها من حديقة جميلة

246
00:16:21,950 --> 00:16:24,870
يعتني بها بمفرده، دون مُساعدة أحد

247
00:16:25,720 --> 00:16:27,480
لكن لماذا؟

248
00:16:27,480 --> 00:16:30,120
أتتساءلين لماذا أفعل كلَّ هذا؟

249
00:16:31,280 --> 00:16:32,820
أجل، لا ألومكِ

250
00:16:37,240 --> 00:16:40,020
لستُ مهتمّاً بالعرش

251
00:16:44,120 --> 00:16:46,190
،لكن بالرّغم ممّا أشعر به

252
00:16:46,190 --> 00:16:49,120
يُصرّ النُّبلاء حولي على تشكيل جماعات

253
00:16:49,120 --> 00:16:50,940
وحاولوا تأييد تبوُّئي للعرش

254
00:16:51,820 --> 00:16:54,070
لم أستطع تحمُّل ذلك

255
00:16:54,580 --> 00:16:58,070
أعشق هذه المملكة وعائلتي

256
00:16:58,420 --> 00:17:03,290
لذا قرّرتُ أن ألعب دور الابن الكسول
الّذي لا يستحقّ مُمارسة السّياسة

257
00:17:03,830 --> 00:17:05,540
وهذا ما في الأمر

258
00:17:06,830 --> 00:17:11,130
إنّه ليس أميراً قبل كلّ شيء

259
00:17:11,130 --> 00:17:13,550
إنّه روحٌ لطيفة تُحبّ عائلتها

260
00:17:15,540 --> 00:17:21,490
في الأمس، صادفتُ الأمير رايهارد
في المقبرة

261
00:17:22,270 --> 00:17:23,770
هكذا إذاً

262
00:17:25,020 --> 00:17:28,780
كان يُحبّ إليزابيث حُبّاً جمّاً

263
00:17:29,360 --> 00:17:33,270
...رؤية أخي المُتزمّت مُغرماً بفتاة

264
00:17:33,270 --> 00:17:34,860
كان أمراً رهيباً حقّاً

265
00:17:35,440 --> 00:17:40,180
قال بأنّ حماية القدّيسة كان
واجب ملِك مُؤهَّل

266
00:17:40,970 --> 00:17:42,290
كانت مُفاجأة

267
00:17:43,620 --> 00:17:45,370
لكن لم يستطع إنقاذها

268
00:17:45,940 --> 00:17:50,160
أي ملِك مُستقبليّ هذا لا يستطيع"
"حماية المرأة الّتي يُحبّ؟

269
00:17:50,160 --> 00:17:55,380
كوسيلة لمُعاقبة نفسه، كرّسَ نفسه
بلا ملل أو كلل لواجباته

270
00:17:57,550 --> 00:17:59,920
...لكن من المُؤكّد أنّه ليس مُبرّراً ليفعل ذلك

271
00:17:59,920 --> 00:18:02,310
أجل، إنّها أمر مُحزِن

272
00:18:02,690 --> 00:18:05,770
لكن أعلم أنّ المرء أحياناً بحاجة
لوقت للشّعور بالحزن

273
00:18:07,550 --> 00:18:12,940
من المُحبِط أن يكون كلّ ما أستطيع فعله
هو مُراقبته بينما تلتئم جروحه

274
00:18:13,820 --> 00:18:16,990
!بوسعه أن يُمارس هوايتي

275
00:18:16,990 --> 00:18:17,950
هوايتك؟

276
00:18:17,950 --> 00:18:21,120
،عندما قرّرتُ لعب دور الكسول

277
00:18:21,120 --> 00:18:23,790
قضيتُ بعض الوقت في التّفكير
بما يجدر بي فعله

278
00:18:24,240 --> 00:18:27,970
،ارتأيتُ بأنّني إذا كنتُ سأمارس هواية
...فلا ينبغي أن تكون لأجلي فقط

279
00:18:27,970 --> 00:18:31,000
أردتُ أن أدخِل البهجة في قلوب
النّاس المُحيطين بي أيضاً

280
00:18:31,000 --> 00:18:34,840
...فكرة أن أفعل شيئاً لإسعاد الآخرين

281
00:18:35,380 --> 00:18:37,700
مُبهِجة للغاية

282
00:18:38,280 --> 00:18:40,480
ماذا عنكِ يا آنسة فيليا؟

283
00:18:40,480 --> 00:18:41,500
أنا؟

284
00:18:41,970 --> 00:18:43,100
هل راودكِ هذا الإحساس من قبل؟

285
00:18:44,980 --> 00:18:46,600
...أنا لم

286
00:18:48,250 --> 00:18:49,480
...أبداً

287
00:18:50,850 --> 00:18:53,190
!شكراً لكِ يا أختي الكبرى

288
00:18:55,040 --> 00:18:56,260
!شكراً لكِ

289
00:18:56,720 --> 00:18:59,470
!القدّيسة فيليا، شكراً جزيلاً لكِ

290
00:19:06,850 --> 00:19:07,950
...أنا

291
00:19:07,950 --> 00:19:10,620
،لطالما اعتقدتُ، كقدّيسة

292
00:19:10,620 --> 00:19:14,460
بأنّني ينبغي أن أنفصل
عن رغباتي الشّخصيّة

293
00:19:14,460 --> 00:19:17,960
وأكرّس نفسي بدلاً من ذلك
لازدهار مملكتنا

294
00:19:18,930 --> 00:19:24,980
لكن في النّهاية، كنتُ أحاول إسعاد
والدَي فحسب

295
00:19:25,600 --> 00:19:31,090
ظننتُ بأنّني إذا لم أستطع إسعادهما
...ودفعهما للاعتراف بي، وحُبّي

296
00:19:31,090 --> 00:19:33,460
فلن تكون هناك أي فائدة من ذلك

297
00:19:34,080 --> 00:19:36,690
كانت تلك نظرتي الوحيدة للأمور

298
00:19:37,830 --> 00:19:42,610
لكن كان هناك الكثير من النّاس حولي
الّذين كنتُ أُسعدهم

299
00:19:43,180 --> 00:19:47,020
أنا أُدرِك ذلك للتو

300
00:19:47,600 --> 00:19:48,670
...آنسة فيليا

301
00:19:52,560 --> 00:19:54,100
!أبليتِ بلاء عظيماً

302
00:19:54,630 --> 00:19:57,040
،إذا لم يعترف بكِ والداكِ

303
00:19:57,040 --> 00:20:00,130
فسأعترف بكلّ ما فعلتِه بدلاً عنهما

304
00:20:01,650 --> 00:20:04,520
أعتقد بأنّني أتمادى، صحيح؟

305
00:20:05,890 --> 00:20:07,020
...لا

306
00:20:09,500 --> 00:20:10,460
إطلاقاً

307
00:20:11,590 --> 00:20:14,310
...لطالما... لطالما

308
00:20:14,880 --> 00:20:18,820
أردتُ سماع هذه الكلمات

309
00:20:22,480 --> 00:20:24,110
شكراً جزيلاً لك

310
00:20:37,420 --> 00:20:39,840
ولهذا هو أمر ضروريّ

311
00:20:39,840 --> 00:20:40,800
فهمت

312
00:20:41,110 --> 00:20:45,110
إذاً تحاول السيّدة إدراك هذه
المانا" الّتي وصفتِها؟"

313
00:20:45,110 --> 00:20:46,800
آرنولد

314
00:20:46,800 --> 00:20:48,970
هل أنت مُهتمّ بالطّقوس القديمة الآن؟

315
00:20:48,970 --> 00:20:49,510
لا

316
00:20:49,510 --> 00:20:56,390
لكن طلب منّي والدكِ أن أبلغ عن
التقدُّم الّتي تُحرزه ابنته العزيزة

317
00:20:56,980 --> 00:20:58,480
...أبي

318
00:20:58,480 --> 00:20:59,950
!بئساً

319
00:20:59,950 --> 00:21:03,520
!قُل له بأنّني أعمل بجدّ لمُساعدة بولميرن

320
00:21:03,520 --> 00:21:05,670
!بلغتُ الخامسة عشر بالفعل

321
00:21:05,670 --> 00:21:09,120
قُل له أن يكفّ عن مُعاملتي
!كطفلة طوال الوقت

322
00:21:07,430 --> 00:21:12,760
أرغب أيضاً في مُساعدة شعب هذه
المملكة الّذي كان لطيفاً معي

323
00:21:09,120 --> 00:21:13,750
أنا قدّيسة الآن، لذا أعمل بشكل
!حثيث حقّاً الآن

324
00:21:14,640 --> 00:21:16,620
أرغب أيضاً في مُساعدة...؟

325
00:21:17,180 --> 00:21:20,500
...لحظة. في الطّقوس القديمة

326
00:21:22,010 --> 00:21:25,340
المعذرة. سيكون هذا كلّ شيء
عن درسنا لهذا اليوم

327
00:21:30,960 --> 00:21:32,390
أخي

328
00:21:32,840 --> 00:21:36,010
لماذا استدعيتني فجأة؟

329
00:21:36,010 --> 00:21:36,890
أجل

330
00:21:37,450 --> 00:21:39,400
وصلتْ هذه الرّسالة للتو

331
00:21:41,680 --> 00:21:44,520
لحظة، أهذه مزحة؟

332
00:21:44,520 --> 00:21:49,020
...لا. لأسباب غير معروفة، مملكة غيرتونيا

333
00:21:50,900 --> 00:21:53,850
طلبتْ أن نُعيد القدّيسة فيليا

334
00:23:26,870 --> 00:23:32,390
القدّيسة المثاليّة جدّاً: رُفِضتُ
بواسطة خطيبي وتمّ بيعي لمملكة أُخرى

335
00:23:33,360 --> 00:23:35,010
:الحلقة القادمة، الحلقة 6

336
00:23:36,130 --> 00:23:37,720
"سبب وعاطفة"