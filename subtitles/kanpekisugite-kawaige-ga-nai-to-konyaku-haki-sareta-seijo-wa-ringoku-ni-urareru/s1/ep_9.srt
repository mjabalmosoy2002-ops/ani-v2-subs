1
00:00:00,470 --> 00:00:02,350
!الحُكم الفضّي

2
00:00:11,130 --> 00:00:15,450
كلّ موجة من الوحوش أهزمها
يتبعها موجة أُخرى

3
00:00:16,450 --> 00:00:21,200
تتنقّل العمّة هيلدي في أرجاء
،المملكة تُنشئ الحواجز

4
00:00:21,620 --> 00:00:23,960
لكن على هذا المُعدّل، أعمدة
النّور لن تكون كافية

5
00:00:28,040 --> 00:00:32,050
يرفض الأمير يوليوس الاعتراف
بالخطر، مهما شكّلتُ ضغطاً

6
00:00:32,420 --> 00:00:36,800
وحتّى أنّه يرفض الحصول على
مُساعدة فُرسان بارناكورتا

7
00:00:36,800 --> 00:00:38,860
الّذين حاولت أختي إرسالهم

8
00:00:43,010 --> 00:00:45,490
يمكنني الشُّعور به غريزيّاً

9
00:00:45,490 --> 00:00:48,810
...عالم الشّيطان قريب بما يكفي، ومع ذلك

10
00:00:53,470 --> 00:00:56,110
الوقت يُداهمنا

11
00:00:56,110 --> 00:00:59,870
،ما لم أخلع الأمير يوليوس
لا مُستقبل لهذه المملكة

12
00:01:00,660 --> 00:01:02,150
سوف أحميها

13
00:01:02,150 --> 00:01:04,570
!فأنا قدّيسة هذه المملكة

14
00:01:05,460 --> 00:01:07,820
سأفعل... أليس كذلك؟

15
00:01:09,080 --> 00:01:10,960
يا أختي فيليا؟

16
00:02:43,410 --> 00:02:46,560
...هذه فكرة جنونيّة توصّلتِ إليها

17
00:02:46,880 --> 00:02:49,260
استخدام تعويذة تلاقي السّحر

18
00:02:49,260 --> 00:02:52,770
لتوسيع دائرة التّطهير العظيمة
لتطويق الممالك المُحيطة

19
00:02:52,770 --> 00:02:56,570
.خطّة مُتألّقة أيّتها الآنسة العظمى
...أو هذا ما أودّ قوله، لكن

20
00:02:57,620 --> 00:02:58,570
هل ستتداركين الوقت؟

21
00:02:59,220 --> 00:03:01,200
هذا ما أعتقده، أجل

22
00:03:01,460 --> 00:03:05,560
حسناً، سيقلب هذا الأمور حتماً
إذا كان الأمر كذلك

23
00:03:06,580 --> 00:03:08,060
لكن ماذا لو فشلتِ؟

24
00:03:08,060 --> 00:03:10,750
—أختي، لا تكوني مُتشائـ

25
00:03:12,000 --> 00:03:13,500
لا تتدخّل في هذا

26
00:03:14,750 --> 00:03:18,510
بكلّ صراحة، كم يوماً بقي لغيرتونيا برأيك؟

27
00:03:19,450 --> 00:03:21,680
حوالي أربعة أيّام على ما أعتقد

28
00:03:21,930 --> 00:03:23,680
هل أنتِ جادّة حقّاً؟

29
00:03:24,000 --> 00:03:25,430
...الأمير رايهارد

30
00:03:26,040 --> 00:03:28,730
من فضلك، اسمح لي أن أُعرّفك

31
00:03:28,730 --> 00:03:29,770
—هذان

32
00:03:29,770 --> 00:03:31,900
إيرزا نوتيس، طاردة أرواح

33
00:03:31,900 --> 00:03:33,990
وهذا كائني المُرافق، مامون

34
00:03:33,990 --> 00:03:34,770
مرحباً

35
00:03:35,190 --> 00:03:39,820
أعتقد كان ينبغي للكنيسة
أن تُبلغك بوصولنا

36
00:03:39,820 --> 00:03:41,240
أجل، فعلوا ذلك

37
00:03:41,810 --> 00:03:45,920
فيليلا، تلقّينا تقريراً من الفُرسان
الّذين نشرناهم

38
00:03:46,560 --> 00:03:51,530
أخشى أنّهم رُفِضوا عند الحدود

39
00:03:51,530 --> 00:03:56,460
بل واتُّهِموا حتّى باستغلال الوضع للاجتياح

40
00:03:56,750 --> 00:04:00,060
،فُرساننا هم حجر أساس دفاعنا
بما يُوازي قدّيسة

41
00:04:00,060 --> 00:04:03,250
...إذا كان لدى غيرتونيا أربعة أيّام فعلاً

42
00:04:03,250 --> 00:04:05,550
فقد آمرهم بالعودة

43
00:04:07,010 --> 00:04:09,080
أجل، سيكون ذلك جيّداً

44
00:04:09,080 --> 00:04:10,390
!أختي

45
00:04:10,660 --> 00:04:13,080
إذا مُهِّدَ طريق إلى عالم الشّيطان
،في غيرتونيا

46
00:04:13,080 --> 00:04:16,740
فسوف يتبع ذلك صحوة كبير
الشّياطين أسموديوس قريباً

47
00:04:17,760 --> 00:04:20,230
،حتّى بوجود الدّائرة الّتي تحميكم

48
00:04:20,230 --> 00:04:23,260
حتّى بارناكورتا لن تبقى سليمة

49
00:04:23,260 --> 00:04:24,240
...ففي نهاية المطاف

50
00:04:24,240 --> 00:04:28,340
أنتِ، يا قدّيسة فيليا، من يستهدفكِ

51
00:04:33,040 --> 00:04:37,340
لذا أيّتها الآنسة العُظمى، هل
أنتِ مُدرِكة دورة إعادة الولادة؟

52
00:04:37,340 --> 00:04:38,290
بالطّبع أنا كذلك

53
00:04:38,570 --> 00:04:42,770
تُعلّمنا كنيسة كريمو أنّه حتّى عندما
،نموت وتتفسّخ جثاميننا

54
00:04:42,770 --> 00:04:48,300
تبقى أرواحنا، وتُولَد من جديد
مراراً وتكراراً للأبد

55
00:04:48,300 --> 00:04:51,960
،وأين انتهت برأيكِ روح فيانا

56
00:04:51,960 --> 00:04:54,670
القدّيسة الّتي ختمتْ على أسموديوس؟

57
00:04:54,670 --> 00:04:57,400
روح فيانا...؟

58
00:04:57,680 --> 00:04:58,940
سأخبركِ

59
00:04:59,480 --> 00:05:00,150
إنّها هناك

60
00:05:02,640 --> 00:05:07,340
روح كبيرة القدّيسين فيانا تسكن في داخلكِ

61
00:05:08,200 --> 00:05:13,090
لهذا نشهد إشارات على عودته
مع اقتراب عالم الشّيطان

62
00:05:13,090 --> 00:05:16,040
!حُبّ رائع

63
00:05:16,360 --> 00:05:17,320
حُبّ؟

64
00:05:17,790 --> 00:05:22,800
لا تسأليني كيف، لكنّه وقع في حُبّ كبيرة
القدّيسين أثناء معركتهم

65
00:05:22,800 --> 00:05:26,260
...تلقّي هزيمة على يد فاتنة جمال

66
00:05:26,850 --> 00:05:30,380
لا بُدّ أنّه أيقظ شيئاً في أسموديوس
عجوز، إن فهمتِ مقصدي

67
00:05:30,380 --> 00:05:33,500
...شيطان شهوانيّ يقع في حُبّ قدّيسة

68
00:05:33,500 --> 00:05:36,310
هذا رومانسيّ، أليس كذلك؟

69
00:05:37,000 --> 00:05:38,230
!أهذه هي ردّة فعلك؟

70
00:05:38,610 --> 00:05:41,900
على أيّ حال، إنّه يستهدفكِ

71
00:05:43,270 --> 00:05:47,750
لفُرصة أُخرى في الحُبّ الّذي
صدّه قبل أربعمئة عام

72
00:05:48,320 --> 00:05:49,340
...حُبّ

73
00:05:56,480 --> 00:05:57,450
...حُبّ

74
00:05:59,020 --> 00:06:01,510
ما رأيك بالشّاي يا آنسة قدّيسة؟

75
00:06:01,510 --> 00:06:03,830
من المُهمّ أخذ قسط من الرّاحة أيضاً

76
00:06:03,830 --> 00:06:05,550
...الأمير أوزفالت

77
00:06:05,550 --> 00:06:08,880
أنا آسفة. حاولتُ تنبيهك

78
00:06:09,170 --> 00:06:10,850
لا، أنا المُخطئة

79
00:06:11,440 --> 00:06:13,350
أعتذر، سموّك

80
00:06:13,650 --> 00:06:15,020
!لا مُشكلة لدي

81
00:06:15,020 --> 00:06:18,310
في الواقع... أعتقد بأنّ هذا غير صحيح

82
00:06:18,310 --> 00:06:21,010
حدّثني أخي عن الفُرسان

83
00:06:21,480 --> 00:06:25,850
هذا وبالإضافة إلى الوضع في غيرتونيا
...وكبير الشّياطين أسموديوس

84
00:06:25,850 --> 00:06:27,360
نُواجه المُشكلة تلو الأُخرى

85
00:06:27,920 --> 00:06:31,500
رغم ذلك، أودّ أن أطلب منكِ طلباً
واحداً... لا تتحمّلي هذا لوحدك

86
00:06:31,500 --> 00:06:34,260
—آنسة فيليا، أنا معكِ

87
00:06:34,260 --> 00:06:37,750
!أ-أقصد، الجميع في بارناكورتا جاهزون للمُساعدة

88
00:06:37,750 --> 00:06:39,120
جميعنا هنا لأجلكِ

89
00:06:39,120 --> 00:06:40,560
!أجل! أجل

90
00:06:40,560 --> 00:06:41,630
حسناً

91
00:06:42,700 --> 00:06:44,000
،لا أعرف السّبب

92
00:06:44,000 --> 00:06:50,720
لكن كلام الأمير أوزفالت يُهدّئني
مثلما تفعل رائحة هذا الشّاي

93
00:06:51,540 --> 00:06:52,650
القدّيسة فيليا

94
00:06:53,610 --> 00:06:55,700
...حالما ينتهي كلُّ هذا

95
00:06:56,760 --> 00:06:58,990
هل يمكننا الخروج معاً ثانية؟

96
00:06:58,990 --> 00:07:00,350
لتناول وجبة طعام هذه المرّة

97
00:07:01,200 --> 00:07:02,730
!دعوة إلى عشاء؟

98
00:07:02,730 --> 00:07:05,360
!هل يُعقَل أنّ هذا... مستحيل

99
00:07:05,750 --> 00:07:09,130
سيكون من دواعي سروري مُرافقتك
لتناول وجبة طعام

100
00:07:09,130 --> 00:07:11,200
!القدّيسة فيليا

101
00:07:11,200 --> 00:07:13,420
!حقّاً؟ هذا رائع

102
00:07:13,420 --> 00:07:15,080
!إنّه أمر آخر أتطلّع له

103
00:07:15,910 --> 00:07:20,010
...لماذا كلّما رأيتُ ابتسامته

104
00:07:20,010 --> 00:07:21,080
هل من مُشكلة؟

105
00:07:21,080 --> 00:07:22,700
...لـت-لا

106
00:07:28,000 --> 00:07:31,760
!يُقيم حفلة في وقت كهذا

107
00:07:32,120 --> 00:07:33,760
،أمام أزمة غير مسبوقة

108
00:07:33,760 --> 00:07:37,260
كانت الغاية من هذا جمعنا
معاً واتّحادنا في صراعنا

109
00:07:37,710 --> 00:07:39,770
لكن لا أثر لذلك هنا

110
00:07:40,210 --> 00:07:42,070
،جميعهم يتصرّفون وكأنّ شيئاً لم يكن

111
00:07:42,070 --> 00:07:46,520
حتّى مع اقتراب عالم الشّيطان
أكثر من أيّ وقت مضى

112
00:07:46,520 --> 00:07:52,280
رغم ذلك، هذا سبب آخر
يدفعني لتحذيرهم

113
00:07:53,040 --> 00:07:54,520
سأريهم الحقيقة

114
00:07:54,520 --> 00:07:58,840
وأستجمع كافّة موارد المملكة
!لمُواجهة قطيع الشّياطين القادم

115
00:07:58,840 --> 00:08:00,660
السّؤال، هل سأتمكّن من فعل ذلك في الوقت؟

116
00:08:01,190 --> 00:08:02,830
هل ترغبين في الهرب؟

117
00:08:03,650 --> 00:08:04,830
لن أهرب

118
00:08:05,510 --> 00:08:08,960
لأنّ هذا هو انتقامي

119
00:08:11,280 --> 00:08:12,930
!مرحباً يا ميا

120
00:08:13,280 --> 00:08:15,760
!تبدين أجمل من المعتاد حتّى

121
00:08:16,600 --> 00:08:19,890
ستبقين بجانبي اللّيلة، أليس كذلك؟

122
00:08:19,890 --> 00:08:22,020
!أجل، بالطّبع

123
00:08:22,020 --> 00:08:23,190
!فنحن مخطوبان

124
00:08:24,080 --> 00:08:26,790
تبدو بمعنويّات مُرتفعة

125
00:08:26,790 --> 00:08:30,280
هل تستمتع بـ"حفلتك" هذه
إلى هذا الحدّ يا يوليوس؟

126
00:08:30,280 --> 00:08:33,000
!إنّه أخي الكبير العزيز

127
00:08:33,000 --> 00:08:36,130
تسرّني رؤيتك بصحّة جيّدة

128
00:08:36,130 --> 00:08:37,990
الحفلات رائعة

129
00:08:37,990 --> 00:08:40,120
...لا سيّما هذه

130
00:08:40,120 --> 00:08:43,870
!حفلة مهمّتها جمعنا كلّنا

131
00:08:45,040 --> 00:08:46,880
إنّه الأمير فيرناند

132
00:08:46,880 --> 00:08:49,880
إذاً إشاعات عودته صحيحة؟

133
00:08:49,880 --> 00:08:52,220
أتعتقدون بأنّ صحّته ستصمد؟

134
00:08:54,050 --> 00:08:57,310
!أنا وليّ العهد فيرناند

135
00:08:57,890 --> 00:09:00,970
آسف لإثارة قلقكم جميعاً لفترة طويلة

136
00:09:01,280 --> 00:09:03,630
،بمرض أبي

137
00:09:03,630 --> 00:09:06,730
أنا متأكّد بأنّ جميعنا نشعر بالخطر
الّذي يحدّق بمملكتنا أكثر فأكثر

138
00:09:07,880 --> 00:09:09,150
!لكن لا تقلقوا

139
00:09:09,150 --> 00:09:14,480
أُقسم أن أفعل كلّ ما باستطاعتي
!لإخراجنا من هذه الأزمة

140
00:09:14,480 --> 00:09:17,610
!انضمّوا إليّ جميعكم

141
00:09:26,470 --> 00:09:28,900
يسرّني أنّني فعلتُها

142
00:09:28,900 --> 00:09:30,630
...كنتَ مُذهلاً

143
00:09:31,040 --> 00:09:31,880
!سموّك

144
00:09:34,180 --> 00:09:37,800
!كان خِطاباً رائعاً يا أخي العزيز

145
00:09:38,610 --> 00:09:39,680
حقّاً؟

146
00:09:41,850 --> 00:09:43,270
المعذرة

147
00:09:44,240 --> 00:09:47,140
سوف أتناول دوائي. أستأذن بالانصراف

148
00:09:47,880 --> 00:09:49,760
سأعود لشرب النّخب

149
00:09:51,820 --> 00:09:53,440
بالمُناسبة يا ميا

150
00:09:53,440 --> 00:09:57,990
لنُحدّد تاريخاً لحفلة استقبال المُهنّئين
!على الزّفاف ونُعلن عنه هنا أمام الجميع

151
00:09:59,280 --> 00:10:02,200
!يا لها من فكرة مُبهرة

152
00:10:02,510 --> 00:10:06,930
رغم ذلك، لا أحد يعلم إلى متى
...ستدوم هذه الحالة الطّارئة

153
00:10:06,930 --> 00:10:10,600
قد يكون من الأفضل الانتظار
حتّى نخرج من الأزمة على الأقلّ

154
00:10:11,290 --> 00:10:13,180
!أنتِ تُبالغين في القلق

155
00:10:13,180 --> 00:10:16,880
لكن لا تقلقي! سنتلقّى أنباء
جيّدة عمّا قريب

156
00:10:17,210 --> 00:10:21,530
كلّ ما سوف يحدث هو لأجل مُستقبلنا معاً

157
00:10:21,530 --> 00:10:25,890
!والآن، فلتبدأ الحفلة

158
00:10:30,880 --> 00:10:33,700
هيّا يا أخي. لنشرب النّخب

159
00:10:33,700 --> 00:10:36,230
من المُؤكّد أنّ كأساً واحداً
لن يؤثّر على تعافيك، صحيح؟

160
00:10:39,400 --> 00:10:43,450
والآن، بينما نتعهّد بولائنا للعائلة الملكيّة

161
00:10:43,450 --> 00:10:48,000
...والازدهار الأبديّ لمملكة غيرتونيا

162
00:10:48,480 --> 00:10:51,590
!بصحّتكم

163
00:11:07,110 --> 00:11:10,310
يوليوس، ما الّذي...؟

164
00:11:12,850 --> 00:11:15,820
وداعاً يا أخي

165
00:11:27,810 --> 00:11:29,180
!الأمير فيرناند

166
00:11:29,180 --> 00:11:30,660
!استدعوا طبيباً! بسرعة

167
00:11:31,010 --> 00:11:32,150
!سموّك

168
00:11:33,710 --> 00:11:36,440
إنّه... لا يتنفّس

169
00:11:36,440 --> 00:11:37,670
لا نبض أيضاً

170
00:11:37,670 --> 00:11:39,830
!لا... سموّك

171
00:11:40,910 --> 00:11:44,120
!لا، بإمكاننا... ما زال بإمكاننا إنقاذه

172
00:11:44,120 --> 00:11:46,970
!سأكرّس قلبي وروحي في تعويذة انبعاث

173
00:11:47,450 --> 00:11:51,230
إذا تصرّفتُ قبل أن تُغادر روحه
!جسدَه، يمكنني إنقاذه

174
00:11:51,230 --> 00:11:55,080
ميا، انتظري الطّبيب. لا تُقدمي
على أيّ تصرُّف طائش

175
00:11:55,080 --> 00:11:57,110
لا يسعنا فعل شيء

176
00:11:57,110 --> 00:11:59,280
—لكن إذا استطعتُ فعل هذا

177
00:12:00,030 --> 00:12:02,250
لا حاجة لذلك صدّقيني

178
00:12:02,250 --> 00:12:04,030
لماذا لا تدعني أفعلها؟

179
00:12:04,030 --> 00:12:05,870
لأنّني لا أريد ذلك

180
00:12:08,830 --> 00:12:11,750
!هل تعي ما تقوله؟

181
00:12:12,240 --> 00:12:15,210
!إنّه يعترف فعليّاً بأنّه هو من فعل ذلك

182
00:12:16,090 --> 00:12:19,710
الأمير يوليوس... ينبغي أن نسمع
قرار الملك بشأن هذا

183
00:12:19,710 --> 00:12:21,410
أجل، ينبغي لنا ذلك

184
00:12:21,410 --> 00:12:24,400
هذا إذا افترضنا أنّه ما زال حيّاً

185
00:12:25,100 --> 00:12:27,370
تعرفين الوضع الّذي هو فيه

186
00:12:27,860 --> 00:12:29,470
...وفضلاً عن ذلك

187
00:12:29,870 --> 00:12:32,900
حرَس القلعة خفيف اللّيلة

188
00:12:32,900 --> 00:12:35,870
بنقل أعداد كبير منهم إلى هنا

189
00:12:35,870 --> 00:12:40,030
،إذا حاول أحدٌ فعل شيء

190
00:12:40,620 --> 00:12:43,110
فينبغي أن نتلقّى تقريراً الآن

191
00:12:43,790 --> 00:12:44,780
ماذا تقول؟

192
00:12:45,390 --> 00:12:46,620
!لدي تقرير

193
00:12:46,620 --> 00:12:50,350
!جلالته... قد تُوفّي

194
00:12:59,560 --> 00:13:01,710
!فعلتُها! فعلتُها

195
00:13:01,710 --> 00:13:04,880
!الآن أنا الملِك! لا يستطيع أحدٌ رفضي

196
00:13:05,280 --> 00:13:07,280
!كانا يعترضان طريقي

197
00:13:07,280 --> 00:13:10,060
!أبي الّذي حرمَني من العرش

198
00:13:10,060 --> 00:13:13,640
!وأخي الّذي رفض التخلّي عنه رغم مرضه

199
00:13:13,640 --> 00:13:15,970
!كنتُ قد ضجرتُ منهما

200
00:13:16,540 --> 00:13:18,660
ليكُن هذا مثالاً كذلك

201
00:13:18,660 --> 00:13:21,560
!هذا ما يحدث لكلّ شخص يعترض طريقي

202
00:13:21,560 --> 00:13:24,320
!أشعر بالتحرُّر

203
00:13:28,410 --> 00:13:30,160
...لماذا

204
00:13:30,160 --> 00:13:33,460
لماذا تفعل المستحيل لأجل العرش؟

205
00:13:33,460 --> 00:13:36,160
لماذا؟ هذا واضح

206
00:13:36,590 --> 00:13:40,780
كما يعلم الجميع، وُلِدَ العالم لخدمتي

207
00:13:41,450 --> 00:13:43,130
!ويا ميا

208
00:13:43,400 --> 00:13:46,930
!بصفتكِ حبيبتي، أهديكِ منصب الملِكة

209
00:13:46,930 --> 00:13:48,720
ألستِ مُبتهجة؟

210
00:13:49,550 --> 00:13:52,680
!عزيزتي ميا، لنتزوّج في هذه اللّحظة

211
00:13:52,680 --> 00:13:53,430
!ميا

212
00:13:53,850 --> 00:13:55,560
!هيّا

213
00:13:58,510 --> 00:14:01,110
!أخشى أنّني لن أسمح بحدوث ذلك

214
00:14:05,110 --> 00:14:06,580
...أ-أنت

215
00:14:07,090 --> 00:14:08,800
!لماذا لا تزال على قيد الحياة؟

216
00:14:08,800 --> 00:14:11,820
لم تكن تعويذة انبعاث، أُطمئنك

217
00:14:12,320 --> 00:14:13,580
...في الواقع

218
00:14:13,580 --> 00:14:17,550
!كنتُ أعلم بأنّك تخطِّط لهذا منذ البداية

219
00:14:18,660 --> 00:14:23,940
في ليلة الحفلة، سيحاول قتل
كُل من فيرناند والملك؟

220
00:14:25,360 --> 00:14:27,220
لماذا تخبرني بهذا؟

221
00:14:28,130 --> 00:14:30,590
!لحماية مملكتنا

222
00:14:33,520 --> 00:14:38,850
لم أكن الوحيدة الخائفة على المملكة

223
00:14:38,850 --> 00:14:41,990
كنتُ قادراً على التّحضير وأنا
على علم بحدوث هذا

224
00:14:41,990 --> 00:14:46,360
تناولتُ التّرياق عندما غبتُ لفترة قصيرة

225
00:14:46,870 --> 00:14:48,610
هذا دمٌ مُزيّف

226
00:14:48,880 --> 00:14:52,730
تظاهرتُ بشرب الخمر، ثمّ
فجّرتُ الكيس الّذي جهّزتُه سلفاً

227
00:14:52,730 --> 00:14:54,160
وسقطتُ بطريقة تشويقيّة

228
00:14:54,680 --> 00:14:56,450
أداء مُقنع، صحيح؟

229
00:14:57,170 --> 00:15:01,020
كما ترى، أنا سليم تماماً

230
00:15:02,560 --> 00:15:05,000
...أ-أخي، تحبّ المُزاح حقّاً

231
00:15:05,000 --> 00:15:07,340
والدنا حيّ كذلك

232
00:15:07,340 --> 00:15:08,470
!ما-ماذا؟

233
00:15:08,470 --> 00:15:10,370
...أولئك المُغتالون الّذين أرسلتَهم

234
00:15:10,900 --> 00:15:13,720
ينبغي أن يتجرّعوا من نفس الكأس الآن

235
00:15:19,230 --> 00:15:21,340
ما المُشكلة؟

236
00:15:20,240 --> 00:15:22,240
...لا يوجد ما يُبرّر هذا

237
00:15:22,240 --> 00:15:23,760
!إنّها خيانة كُبرى

238
00:15:22,240 --> 00:15:25,230
حتّى كأمير، سيدفع ثمن هذا رأسه

239
00:15:25,230 --> 00:15:28,530
يبدو كأنّك تلقّيت حكم الإعدام

240
00:15:28,530 --> 00:15:30,500
وكأنّك ربطتَ الأنشوطة حول عنقك

241
00:15:30,500 --> 00:15:32,240
عندما حاولت قتلنا

242
00:15:32,510 --> 00:15:34,320
!ا-اصمت

243
00:15:34,650 --> 00:15:37,440
...مُنعزل عاجز مثلك

244
00:15:37,440 --> 00:15:39,910
!أنا أفضل منك من كلّ ناحية

245
00:15:40,440 --> 00:15:43,890
!هذه المملكة بحالٍ أفضل بوجودي على العرش

246
00:15:43,890 --> 00:15:46,420
أين المُشكلة في التخلُّص من الشّخص
!الّذي سيعترض طريقي؟

247
00:15:46,420 --> 00:15:49,050
!أين المُشكلة في قتلك؟

248
00:15:49,050 --> 00:15:52,430
الجميع يُفضّلونني على العرش
!أكثر ممّا يُفضّلونك

249
00:15:52,690 --> 00:15:53,940
ماذا؟

250
00:15:53,940 --> 00:15:57,510
انظر في وجوههم وكرّر ذلك ثانية

251
00:15:59,250 --> 00:16:03,170
!هل ستنقلبون عليّ أيّها الأغبياء أيضاً؟

252
00:16:05,480 --> 00:16:08,330
سيبدأ ذلك الآن

253
00:16:08,330 --> 00:16:12,070
عقوبة جماعيّة لكافّة أولئك
الّذين خانوا أختي

254
00:16:12,360 --> 00:16:13,700
!ميا

255
00:16:13,990 --> 00:16:17,330
انضممتِ له لأنّه ضغط عليكِ، صحيح؟

256
00:16:17,330 --> 00:16:20,170
!أرجوكِ، أنتِ زوجته

257
00:16:20,170 --> 00:16:21,780
!يجب أن تُساعديني

258
00:16:21,780 --> 00:16:23,710
...إذا أيّدتني القدّيسة

259
00:16:23,710 --> 00:16:24,710
عكستَ الأمر

260
00:16:29,440 --> 00:16:33,250
،سأُوصله إلى ذروة النّشوة
وأمنحه الحرّية الكاملة

261
00:16:33,250 --> 00:16:35,360
...ثمّ عندما أجد الوقت مُناسباً

262
00:16:35,970 --> 00:16:37,030
ميا؟

263
00:16:37,030 --> 00:16:41,850
لم يكن الأمير فيرناند من رسمَ هذه الخطّة

264
00:16:42,830 --> 00:16:44,060
!كنتُ أنا

265
00:16:44,640 --> 00:16:46,230
سأخونه

266
00:16:49,680 --> 00:16:51,680
،لهزيمة عضو في العائلة الملكيّة

267
00:16:51,680 --> 00:16:54,280
يجب أن تكون هناك جريمة ودليلاً واضحاً

268
00:16:54,280 --> 00:16:59,740
احتجتُ تهيئة ظروف بحيث يكون
الجميع هنا كشهود عيان

269
00:17:00,160 --> 00:17:05,440
بالإضافة إلى ذلك، أردتُ أن يجتمع مُؤيّدو
—كلّاً من الأميرين، وكذلك المُحايدين

270
00:17:05,440 --> 00:17:10,750
معاً ضمن نطاق سياسيّ وفهم
الخطر الّذي نُواجهه

271
00:17:11,270 --> 00:17:14,990
...للتّخطيط لقتل جلالته ووليّ العهد

272
00:17:14,990 --> 00:17:18,720
!الأمير يوليوس، أنت مُدان

273
00:17:18,720 --> 00:17:20,760
هذه حقيقة غير قابلة للشكّ

274
00:17:21,040 --> 00:17:24,630
مـ-ميا؟ ما الّذي تقولينه؟

275
00:17:24,630 --> 00:17:25,990
—أنتِ زوجتي

276
00:17:25,990 --> 00:17:29,110
الأمير الثّاني يوليوس غيرتونيا

277
00:17:29,110 --> 00:17:33,030
...بصفتك مُجرم، بموجب قوانين مملكتنا

278
00:17:33,030 --> 00:17:36,530
!تُفسَخ خطوبتنا رسميّاً

279
00:17:36,530 --> 00:17:38,980
!تُـ-تُفسَخ؟

280
00:17:38,980 --> 00:17:42,800
!أ-أتنقلبين عليّ يا حبيبتي العزيزة؟

281
00:17:42,800 --> 00:17:45,360
سذاجتك بلا حدود، سموّك

282
00:17:45,360 --> 00:17:49,040
أنا، أُحبّ الرّجل الّذي باع أختي العزيزة؟

283
00:17:49,430 --> 00:17:53,420
من فضلك كُفّ عن قول مثل
هذا الكلام المُثير للاشمئزاز

284
00:17:53,420 --> 00:17:55,330
!لـ-لا

285
00:17:55,330 --> 00:17:57,350
!أُحبّكِ

286
00:17:57,350 --> 00:18:00,180
!تزوّجيني وسوف أُسعدكِ

287
00:18:01,570 --> 00:18:05,630
!لا تعرف شيئاً عمّا يُمكن أن يُسعدني

288
00:18:09,750 --> 00:18:11,110
!ميا

289
00:18:11,110 --> 00:18:13,300
ما-ماذا تفعلين؟

290
00:18:13,300 --> 00:18:16,030
!تفعلين هذا بنا... بسموّه

291
00:18:16,720 --> 00:18:19,410
!لِمَ تفعلين شيئاً سخيفاً كهذا؟

292
00:18:19,410 --> 00:18:20,560
لماذا؟

293
00:18:22,100 --> 00:18:23,790
أتسأل لماذا؟

294
00:18:24,500 --> 00:18:27,540
!عاملت فيليا كقمامة

295
00:18:27,540 --> 00:18:29,500
!ولديك الجرأة على أن تسألني عن السّبب؟

296
00:18:32,750 --> 00:18:37,510
أثقلتُما عليها بطلباتكما وعاملتُماها ببرود

297
00:18:37,510 --> 00:18:41,270
ثمّ في النّهاية رميتُماها وبعتُماها
!لمملكة أُخرى

298
00:18:41,270 --> 00:18:46,710
سعتْ جاهدة لكسب حُبّ الأشخاص
...الّتي آمنت بأنّهما والداها

299
00:18:46,710 --> 00:18:49,340
ومع ذلك دستُما على كلّ ذلك بسعادة

300
00:18:49,340 --> 00:18:51,940
!لا أستطيع تقبُّل ذلك، ولو كنتُما والديها

301
00:18:52,520 --> 00:18:57,200
.كانت أُختي القدّيسة المثاليّة
فعلت الكثير لأجل مملكتنا

302
00:18:57,200 --> 00:19:00,560
لكنّها كانت أيضاً فتاة عاديّة
!لا تختلف عن بقيّتنا

303
00:19:00,560 --> 00:19:02,700
!لماذا لا تفهمون؟

304
00:19:04,300 --> 00:19:05,570
أعيدوها

305
00:19:06,070 --> 00:19:07,960
...أعيدوها

306
00:19:07,960 --> 00:19:11,080
!أعيدوا أختي

307
00:19:11,910 --> 00:19:12,950
...ميا

308
00:19:16,270 --> 00:19:17,520
هل قالت فيليا؟

309
00:19:18,640 --> 00:19:21,470
لماذا تذكرينها الآن بالتّحديد؟

310
00:19:22,300 --> 00:19:26,470
منذ طفولتي، ظننتُ نفسي أفضل

311
00:19:26,850 --> 00:19:31,230
أكاديميّاً، وفي المُبارزة... أتقنتُ كلّ شيء
دون بذل أدنى مجهود

312
00:19:31,230 --> 00:19:32,910
!مُذهل، سموّك

313
00:19:32,180 --> 00:19:33,920
!لديك موهبة

314
00:19:32,910 --> 00:19:35,480
!هذه دلالة على دماء أنقى

315
00:19:35,940 --> 00:19:40,310
سرعان ما أدركتُ بأنّني مُختلف عن الآخرين

316
00:19:40,310 --> 00:19:42,270
كنتُ شخصاً مُميّزاً

317
00:19:43,100 --> 00:19:44,740
...الوحيد الّذي رفضَ رؤية ذلك

318
00:19:45,370 --> 00:19:48,560
يوليوس، حسّن سلوكك

319
00:19:48,560 --> 00:19:50,650
كان أبي...

320
00:19:50,650 --> 00:19:52,500
لكن ما أهمّية ذلك؟

321
00:19:52,890 --> 00:19:57,250
كان أخي فيرناند مريضاً وعاجزاً
وعديم القيمة

322
00:19:57,620 --> 00:20:00,530
كنتُ أنا صاحب الدّم الأنقى
!والموهبة العبقريّ

323
00:20:00,530 --> 00:20:05,450
الأمير المثاليّ الّذي ينبغي أن
!ينحني له الجميع

324
00:20:06,080 --> 00:20:07,260
!هذا ما اعتقدته

325
00:20:07,740 --> 00:20:10,420
أجل... حتّى ذلك اليوم

326
00:20:10,420 --> 00:20:12,190
سُرِرتُ بلقائك

327
00:20:12,830 --> 00:20:14,810
اسمي فيليا أديناور

328
00:20:15,430 --> 00:20:16,970
عرفتُ ذلك من النّظرة الأُولى

329
00:20:17,520 --> 00:20:19,300
كانت تلك المرأة عدوّي

330
00:20:19,300 --> 00:20:22,210
جاء وحش لتحطيم كمالي المُطلَق

331
00:20:23,900 --> 00:20:25,820
لهذا السّبب بعتُها

332
00:20:26,720 --> 00:20:28,700
...استطعتُ أن أصبح الأمير المثاليّ ثانية

333
00:20:28,700 --> 00:20:31,240
!لا، بل الملك المثاليّ

334
00:20:31,920 --> 00:20:33,880
...ومع ذلك

335
00:20:33,880 --> 00:20:36,330
!لِمَ يجب أن أواجه عقبة، حتّى الآن؟

336
00:20:37,040 --> 00:20:38,320
لا أستطيع قبول هذا

337
00:20:38,320 --> 00:20:41,420
!لن أدع تلك المرأة تهزمني

338
00:20:41,420 --> 00:20:44,090
!أنا صاحب الدّم الأنقى

339
00:20:44,090 --> 00:20:45,920
!أنا ملكيّ

340
00:20:50,450 --> 00:20:52,850
!خدعتني حقّاً يا ميا

341
00:20:53,210 --> 00:20:54,100
...لكن

342
00:20:54,490 --> 00:20:56,630
!ستكونين أنتِ من يُزجّ في السّجن

343
00:20:56,630 --> 00:20:59,490
!لمُحاولتكِ الإيقاع بي

344
00:20:59,490 --> 00:21:03,660
الأمير يوليوس، لا تُهِن نفسك أكثر

345
00:21:03,660 --> 00:21:07,450
جميع الحاضرين شاهدون على طيشك

346
00:21:07,450 --> 00:21:09,580
!أنتِ الطّائشة هنا

347
00:21:09,580 --> 00:21:12,290
!إنّ خِداع الملك جريمة، ألا تعلمين ذلك؟

348
00:21:12,820 --> 00:21:14,110
!أنتم

349
00:21:14,110 --> 00:21:17,660
!فلتحتجزوا هذين الاثنين

350
00:21:18,250 --> 00:21:20,970
!يجب علينا إسكات شهادتها فحسب

351
00:21:20,970 --> 00:21:24,300
!من يُساعدني، فسوف أُكافئه بما يريد

352
00:21:24,300 --> 00:21:27,320
هل من أحد؟

353
00:21:29,760 --> 00:21:30,480
—هل

354
00:21:30,480 --> 00:21:34,930
ألم تخجل على نفسك بعد يا يوليوس؟

355
00:21:36,260 --> 00:21:39,270
!أيّها العجوز! حريّ بك ألّا تُكلّمني هكذا

356
00:21:39,270 --> 00:21:40,690
—هل تعرف من

357
00:21:41,290 --> 00:21:44,190
!هل تعرف من أكون؟

358
00:21:45,200 --> 00:21:48,450
!لا تقل لي بأنّك نسيت وجه أبيك؟

359
00:21:48,450 --> 00:21:50,950
!جـ-جلالته؟

360
00:23:26,850 --> 00:23:32,640
القدّيسة المثاليّة جدّاً: رُفِضتُ
بواسطة خطيبي وتمّ بيعي لمملكة أُخرى

361
00:23:33,350 --> 00:23:34,970
:الحلقة القادمة، الحلقة 10

362
00:23:36,170 --> 00:23:37,560
"ما أتمنّى حمايته"