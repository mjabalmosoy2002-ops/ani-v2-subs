1
00:00:03,530 --> 00:00:05,650
صباح الخير أيّتها القدّيسة ميا

2
00:00:05,650 --> 00:00:09,630
تمّ تعييني لقيادة حرسكِ الشّخصيّ

3
00:00:09,630 --> 00:00:10,900
اسمي بيير

4
00:00:11,460 --> 00:00:12,800
أنت هو؟

5
00:00:14,980 --> 00:00:17,640
هل نستأنف واجباتكِ؟

6
00:00:18,980 --> 00:00:19,870
...أوّلاً

7
00:00:21,310 --> 00:00:24,420
ثمّة مكان أودُّ الذّهاب إليه

8
00:00:25,120 --> 00:00:29,000
خذني إلى وليّ العهد فيرناند

9
00:00:31,230 --> 00:00:35,130
لم أتوقّع أبداً أن تكوني في صفّنا

10
00:00:35,660 --> 00:00:37,210
كذلك أنا

11
00:00:37,210 --> 00:00:41,790
لا أُصدّق بأنّ شخصاً من جماعة وليّ العهد
...تمّ تعيينه لحراستي

12
00:00:42,400 --> 00:00:46,350
،الدّعم لوليّ العهد شائع بين الجنود

13
00:00:46,350 --> 00:00:50,220
لكن يتستّرون على ولائهم وذلك
كي لا يشعر الأمير يوليوس

14
00:00:50,880 --> 00:00:53,150
مثلما أخبرتني هيماري تماماً

15
00:00:53,150 --> 00:00:56,920
كان الأمير فيرناند مريضاً منذ الولادة

16
00:00:56,920 --> 00:01:02,460
النُّبلاء الّذين سعوا لدعم الأمير
يوليوس استغلّوا ذلك

17
00:01:02,460 --> 00:01:05,540
لإفشال جماعة وليّ العهد

18
00:01:05,540 --> 00:01:10,550
الأمير يوليوس يُعامل الجنود كبيادق

19
00:01:10,550 --> 00:01:15,550
يجعلنا نعمل بلا توقُّف ويُكرّس القوّة
العاملة لتنصيب تمثاله الذّهبيّ

20
00:01:15,550 --> 00:01:19,190
أخشى ألّا يكون هناك مَن يُدافع
عن المملكة هكذا

21
00:01:19,190 --> 00:01:24,250
سمعتُ بأنّك كنتَ جزءاً من حرس
الأمير فيرناند الشّخصيّ

22
00:01:24,250 --> 00:01:26,620
كيف يبدو حاله؟

23
00:01:27,560 --> 00:01:28,560
...الآن

24
00:01:28,560 --> 00:01:31,070
يتدهور جسديّاً ونفسيّاً

25
00:01:32,150 --> 00:01:33,590
أتفهّم ذلك

26
00:01:33,590 --> 00:01:40,120
فالأمير يوليوس ورجاله نقلوه من القلعة
الرّئيسيّة إلى الإقامة الجبريّة هنا

27
00:01:40,120 --> 00:01:42,120
تحت ذريعة مُساعدته في الامتثال للشّفاء

28
00:01:44,900 --> 00:01:48,680
استسلم الأمير لقدره

29
00:01:51,160 --> 00:01:54,620
عندما أدرك ما الّذي كان يُخطّط له الأمير
يوليوس، استشاط جلالته غضباً

30
00:01:56,850 --> 00:01:59,910
لكن رفضَ الأمير فيرناند حُرّيتَه

31
00:01:59,910 --> 00:02:02,600
واختبأ هنا في عقاره إلى يومنا هذا

32
00:02:03,250 --> 00:02:05,380
وكم مضى على ذلك الآن؟

33
00:02:05,380 --> 00:02:06,520
اثنا عشر عاماً

34
00:02:06,520 --> 00:02:08,520
!اثنا عشر عاماً؟

35
00:02:08,800 --> 00:02:14,570
سيتطلّب هذا جهداً أكبر ممّا توقّعت

36
00:02:15,090 --> 00:02:16,850
الأمير فيرناند في الدّاخل

37
00:02:17,730 --> 00:02:20,660
الوقت يُداهم غيرتونيا

38
00:02:21,320 --> 00:02:24,450
!يجب أن أقنعه مهما كلّف الأمر

39
00:02:28,410 --> 00:02:29,740
المعذرة

40
00:02:38,760 --> 00:02:42,380
الأمير فيرناند. سُررتُ بلقائك

41
00:02:42,380 --> 00:02:44,890
،أنا خطيبة الأمير يوليوس

42
00:02:45,600 --> 00:02:47,600
ميا أديناور

43
00:02:48,870 --> 00:02:49,900
ميا"؟"

44
00:02:50,550 --> 00:02:54,650
ظننتُ بأنّ اسم خطيبته كان فيليا

45
00:02:54,650 --> 00:02:56,250
فيليا هي أختي الكبرى

46
00:02:56,250 --> 00:02:58,690
فُسِخت خطوبتهما وذلك

47
00:02:58,690 --> 00:03:01,780
كي تخدم كقدّيسة لجيراننا في بارناكورتا

48
00:03:03,990 --> 00:03:06,080
تركنا فيليا تذهب إذاً

49
00:03:06,750 --> 00:03:09,520
أنا مُتفاجئ من اتّخاذ أبي قرار كهذا

50
00:03:09,520 --> 00:03:11,830
يؤسفني القول بأنّ جلالته مريض

51
00:03:12,140 --> 00:03:15,440
الأمير يوليوس هو من يتولّى شؤون الدّولة

52
00:03:15,440 --> 00:03:16,960
هكذا إذاً

53
00:03:16,960 --> 00:03:20,080
يلعب على وتر الملكيّة الآن إذاً

54
00:03:20,080 --> 00:03:23,050
أنا متأكّد بأنّه سيتخلّص منّي أيضاً عمّا قريب

55
00:03:24,800 --> 00:03:26,090
لم أتوقّع هذا

56
00:03:26,090 --> 00:03:29,630
إنّه يتكلّم بوضوح وصراحة ومع ذلك
تبدو أعصابه هادئة تماماً

57
00:03:29,630 --> 00:03:31,480
حسناً، عمّاذا أردتِ أن تتكلّمي معي؟

58
00:03:32,800 --> 00:03:34,900
أريدك أن تقف في وجهه

59
00:03:34,900 --> 00:03:39,790
أن تُنقذ مملكتنا، أريدك أن تتخلّص
من الأمير يوليوس

60
00:03:41,530 --> 00:03:47,010
هناك أشخاص في المملكة يريدونك
أن تتبوّأ العرش

61
00:03:47,010 --> 00:03:50,290
،وحدهم التّقليديّون المشغولون بالمظاهر

62
00:03:50,660 --> 00:03:54,750
تترسّخ لديهم فكرة أنّ الابن الأكبر
هو مَن يجب أن يكون الخليفة

63
00:03:55,210 --> 00:03:57,500
!لا، الأمر أخطر من ذلك بكثير

64
00:03:57,810 --> 00:04:02,110
غيرتونيا على شفا حفرة من كارثة فظيعة

65
00:04:02,110 --> 00:04:04,510
،إذا بقي الأمير يوليوس في السّلطة

66
00:04:04,510 --> 00:04:06,590
!فسوف تسقط المملكة بأكملها

67
00:04:06,590 --> 00:04:11,080
أهكذا تتكلّمين عن خطيبكِ؟

68
00:04:12,160 --> 00:04:14,210
هل تكرهين أخي؟

69
00:04:14,210 --> 00:04:15,770
أجل، كرهاً شديداً

70
00:04:16,320 --> 00:04:18,880
لكن المسألة لا تتعلّق بمشاعري الشّخصيّة

71
00:04:18,880 --> 00:04:21,560
أنا أتكلّم كقدّيسة لهذه المملكة

72
00:04:21,560 --> 00:04:24,280
فهمت. أنتِ قدّيسة أيضاً، صحيح؟

73
00:04:25,980 --> 00:04:26,950
...في هذه الحالة

74
00:04:28,320 --> 00:04:29,680
فيجدر بكِ أن تُغادري

75
00:04:31,360 --> 00:04:35,130
!انتظر، سموّك! أرجوك، أحتاج مُساعدتك

76
00:04:35,130 --> 00:04:35,870
أرفُض

77
00:04:35,870 --> 00:04:37,200
—لكن الكارثة

78
00:04:37,200 --> 00:04:38,090
لا أُبالي

79
00:04:40,810 --> 00:04:42,120
!بئساً

80
00:04:42,120 --> 00:04:44,970
!لماذا أنتما الأخوان عنيدان جدّاً؟

81
00:04:47,030 --> 00:04:48,300
لا تقلقي

82
00:04:48,920 --> 00:04:51,570
الجميع في هذا الفريق هم
من جماعة وليّ العهد

83
00:04:53,600 --> 00:04:57,810
عرفتُ بأنّ الأمر لن يكون سهلاً، لكن
يبدو هذا شبه مُستحيل

84
00:04:58,320 --> 00:05:03,100
أخبرتُه في الماضي بأنّ عليه
...أن يخرج من غرفته ويرى العالم

85
00:05:03,100 --> 00:05:04,070
وبعد؟

86
00:05:04,900 --> 00:05:07,320
رفض الفكرة كلّياً

87
00:05:08,650 --> 00:05:12,380
أصابَه اليأس بعد قضاء عقد من الزّمن
في مكان مُغلق

88
00:05:12,380 --> 00:05:13,170
!وجدتُها

89
00:05:13,170 --> 00:05:16,410
!أولويّتي هي تعزيز لياقته وعِلاج مرضه

90
00:05:16,410 --> 00:05:17,580
...على ذكرِك للأمر

91
00:05:18,010 --> 00:05:23,870
تحسّنتْ حالته لفترة بعد أن تناول دواء
من تحضير القدّيسة فيليا

92
00:05:24,760 --> 00:05:28,930
هل يُعقَل... أنّ الأمير يوليوس
قد أتلف ذلك الدّواء أيضاً؟

93
00:05:28,930 --> 00:05:30,520
في الواقع، لا

94
00:05:30,990 --> 00:05:33,520
...بعد أن تحسّنت صحّة الأمير

95
00:05:41,040 --> 00:05:44,400
!أنتِ من صنع كلّ هذا يا قدّيسة فيليا؟

96
00:05:44,400 --> 00:05:45,590
أجل

97
00:05:45,590 --> 00:05:50,320
،أريد أن أقدّم هديّة للأمير أوزفالت
لذا كنتُ أتمرّن

98
00:05:50,650 --> 00:05:55,110
كان لطيفاً جدّاً منذ وصولي إلى بارناكورتا

99
00:05:55,110 --> 00:05:56,540
أريد أن أعبّر له عن شكري

100
00:05:56,540 --> 00:05:59,080
!سوف يُسعده ذلك كثيراً

101
00:05:59,420 --> 00:06:00,560
أوتعتقدين ذلك؟

102
00:06:00,560 --> 00:06:02,510
!بالتّأكيد

103
00:06:04,080 --> 00:06:07,340
أعطيتُ ميا زينة شعر من قبل

104
00:06:07,820 --> 00:06:11,350
بدتْ مسرورة جدّاً بذلك آنذاك

105
00:06:11,890 --> 00:06:14,900
كنتُ أُفكّر في إعطاء الأمير شيء
يستطيع ارتداؤه كذلك

106
00:06:14,900 --> 00:06:17,940
!تماماً، تماماً! أنا متأكّدة بأنّ ذلك سيروقه

107
00:06:17,940 --> 00:06:22,630
شخص غير مهتمّ ولا يُبالي للأزياء

108
00:06:22,630 --> 00:06:27,860
...يُقدّم لك زينة مصنوعة يدويّاً
!هل من شيء مُلهِم أكثر من ذلك؟

109
00:06:31,540 --> 00:06:32,620
لينا

110
00:06:33,690 --> 00:06:34,550
تفضّلي

111
00:06:35,840 --> 00:06:38,960
يمكنكِ الحصول على هذه إن أحببتِ

112
00:06:40,560 --> 00:06:43,920
كنتُ أُفكّر فيكِ عندما صنعتُها

113
00:06:43,920 --> 00:06:46,260
—أعتقد بأنّها نجحتْ

114
00:06:45,200 --> 00:06:47,560
!القدّيسة فيليا

115
00:06:47,560 --> 00:06:49,260
!شكراً جزيلاً لكِ

116
00:06:49,260 --> 00:06:52,010
!أحببتُها! سأحتفظ بها للأبد

117
00:06:56,260 --> 00:06:59,800
!إنّها جميلة للغاية يا قدّيسة فيليا

118
00:07:01,810 --> 00:07:03,520
المعذرة

119
00:07:05,030 --> 00:07:06,020
القدّيسة فيليا

120
00:07:06,380 --> 00:07:09,620
أرسلتْ هيماري تقريرها من غيرتونيا

121
00:07:14,160 --> 00:07:15,660
أنتِ ثانية؟

122
00:07:16,480 --> 00:07:17,570
سموّك

123
00:07:17,570 --> 00:07:21,040
لماذا توقّفت عن تناول الدّواء
الّذي صنعَتْه أُختي؟

124
00:07:25,850 --> 00:07:27,500
...ذلك الدّواء

125
00:07:28,570 --> 00:07:32,010
كان شيئاً فظيعاً صنعَتْه أختُكِ

126
00:07:33,450 --> 00:07:34,510
اسمعيني

127
00:07:34,510 --> 00:07:39,930
إنّ أي تحسُّن في صحّتي الآن
سيؤدّي إلى صِراع ليس إلّا

128
00:07:39,930 --> 00:07:42,700
سيحثّ ذلك يوليوس على مُحاولة قتلي

129
00:07:44,820 --> 00:07:50,270
عندما تناولتُ ذلك الدّواء وبدأُتُ أشعر
بتحسُّن، لم أنفك أرتجف

130
00:07:50,270 --> 00:07:55,210
إذا تعافيت، فستُستأنَف الأحاديث حول
!خلافتي. سيرغبون في قتلي

131
00:07:55,210 --> 00:07:58,120
لماذا أتناول ذلك الدّواء وأنا أعلم
!ما الّذي سيؤدّي إليه ذلك؟

132
00:07:59,060 --> 00:08:00,700
...ماذا لو

133
00:08:00,700 --> 00:08:03,480
قلتُ بأنّني سأحميك؟

134
00:08:05,920 --> 00:08:08,210
،إذا استطعتُ ضمان سلامتك

135
00:08:08,210 --> 00:08:11,730
هل ستتناول دواءك وتسترجع طاقتك؟

136
00:08:16,800 --> 00:08:17,470
...أنا

137
00:08:17,970 --> 00:08:19,400
لا أعلم

138
00:08:20,180 --> 00:08:22,560
!لا، لا أستطيع فعلها

139
00:08:25,280 --> 00:08:27,660
أنا في صفّك يا سموّك

140
00:08:29,820 --> 00:08:31,190
سوف أعود

141
00:08:37,650 --> 00:08:40,770
أرجوكِ... لا تأتي ثانية أبداً

142
00:08:42,930 --> 00:08:47,830
أنا آسفة. لكن لا أملك وقتاً للانتظار ببساطة

143
00:08:48,710 --> 00:08:52,160
لأنّني قدّيسة هذه المملكة

144
00:08:54,360 --> 00:08:56,610
...استدعاء من الملك

145
00:08:57,350 --> 00:09:00,710
هل ارتكبتُ خطأ ما؟

146
00:09:00,710 --> 00:09:06,420
هل يُعقَل أنّه غاضب لأنّ دائرة التّطهير العظيمة
تمنعني من أداء واجباتي القدّيسيّة؟

147
00:09:07,300 --> 00:09:09,360
!بالطّبع لا

148
00:09:09,360 --> 00:09:12,300
يريد أبي أن يلتقي بكِ فحسب

149
00:09:12,750 --> 00:09:14,990
،إذا تجرّأ أحدٌ على التكلُّم بسوء عنكِ

150
00:09:14,990 --> 00:09:18,200
!فسوف أقطع لسانه مثل الملك إنما

151
00:09:19,710 --> 00:09:23,540
أليست هذه عقوبة الكاذبين
في الحياة الآخرة؟

152
00:09:23,540 --> 00:09:26,230
سمعتِ بها؟

153
00:09:26,230 --> 00:09:28,330
أجل، إنّها أسطورة عالم موراسامي السّفليّ

154
00:09:28,690 --> 00:09:31,680
كنتُ أُحاول تخفيف أجواء التوتُّر بمزحة فحسب

155
00:09:32,410 --> 00:09:36,320
،لكن إذا قال أبي شيئاً لإهانتك

156
00:09:36,320 --> 00:09:37,950
فغالباً سوف أُوبّخه

157
00:09:39,160 --> 00:09:43,600
رؤيتكِ تتأذّين هو ما لا أتحمّله

158
00:09:43,600 --> 00:09:44,980
هذا يُثير انفعالي

159
00:09:46,750 --> 00:09:50,980
لا أريدك أن تفقد ماء وجهك بسببي

160
00:09:51,280 --> 00:09:53,150
آمل أن تتوقّف عن ذلك

161
00:09:53,610 --> 00:09:57,650
هل هذا طلب مبنيّ على عاطفة؟ أم منطق؟

162
00:09:58,810 --> 00:10:00,340
لستُ متأكّدة

163
00:10:01,280 --> 00:10:08,000
من النّاحية العقلانيّة، سيكون من المُعيب
،أن يُوبّخ شخصٌ الملِك

164
00:10:08,000 --> 00:10:10,080
حتّى لو كان ابنه

165
00:10:10,080 --> 00:10:11,520
لذا غالباً هذا مبنيّ على منطق

166
00:10:12,890 --> 00:10:14,550
عرفتُ بأنّكِ ستقولين شيئاً كهذا

167
00:10:19,100 --> 00:10:21,550
سامحيني على التأخُّر في اللّقاء بكِ

168
00:10:22,240 --> 00:10:26,560
،اسمي إيغيلشتاين بارناكورتا
حاكم هذا العالم

169
00:10:27,730 --> 00:10:30,220
اسمي فيليا أديناور

170
00:10:30,220 --> 00:10:33,070
حدّثني ابني بكلّ شيء عنك

171
00:10:33,070 --> 00:10:38,990
توقّعتِ خطراً كارثيّاً مُحتملاً على مملكتنا

172
00:10:38,990 --> 00:10:42,320
ونفّذتِ إجراء وقائيّاً ممتازاً

173
00:10:42,320 --> 00:10:46,160
أدّيتُ واجبي كقدّيسة فحسب

174
00:10:51,450 --> 00:10:57,460
،إن لم أكافئ إنجازك يا آنسة فيليا
فسوف أصبح مصدر سخرية

175
00:10:57,830 --> 00:11:01,440
...يُذكّرني بالأمير أوزفالت بطريقة ما

176
00:11:01,440 --> 00:11:03,890
ما هي أُمنيتكِ؟

177
00:11:04,230 --> 00:11:08,010
أخبريني وسأبذل قصارى جهدي لتحقيقها لكِ

178
00:11:08,480 --> 00:11:09,980
...ما أتمنّاه هو

179
00:11:10,630 --> 00:11:13,600
لا إمكانيّة تحسُّن هنا في غيرتونيا

180
00:11:13,600 --> 00:11:17,490
،حتّى مع مُساعدة القدّيسة السّابقة هيلديغارد

181
00:11:17,490 --> 00:11:19,590
هذا أكثر من أن تتحمّله القدّيسة ميا

182
00:11:23,330 --> 00:11:27,290
هل تريدين مُساعدة أختكِ في المملكة المُجاورة لنا؟

183
00:11:29,300 --> 00:11:31,240
!أ-أجل، أريد ذلك

184
00:11:31,240 --> 00:11:32,620
!أتمنّى ذلك

185
00:11:33,420 --> 00:11:38,410
،ما زالت أختي تُكافح لإنجاز واجباتها كقدّيسة

186
00:11:38,410 --> 00:11:40,560
لكن الأمور سيّئة جدّاً فحسب

187
00:11:40,560 --> 00:11:42,850
...عندما أفكّر في الاحتمالات

188
00:11:42,850 --> 00:11:45,580
يُصيبني اليأس

189
00:11:46,800 --> 00:11:47,950
ما الّذي يجري؟

190
00:11:47,950 --> 00:11:52,220
...لم أدرك أبداً بأنّني كنتُ خائفة جدّاً

191
00:11:52,840 --> 00:11:54,960
كنتُ خائفة طوال هذا الوقت

192
00:11:55,590 --> 00:11:58,360
ميا، لا أريد أن أخسركِ

193
00:11:58,900 --> 00:12:01,860
هل هذا ما يعنيه أن يصبح المرء... عاطفيّاً؟

194
00:12:02,990 --> 00:12:04,870
سـ-سامحني جلالتك

195
00:12:05,250 --> 00:12:06,510
—من فضلك، تجاهل ما

196
00:12:06,510 --> 00:12:07,620
لا حاجة لذلك

197
00:12:09,720 --> 00:12:13,250
سمعتُ طلبكِ للتو

198
00:12:13,670 --> 00:12:17,080
أردتُ سماعه من فمكِ مباشرة

199
00:12:17,080 --> 00:12:19,350
...لكنّني قدّيسة، لذا

200
00:12:19,350 --> 00:12:22,740
تخشين التّعبير عمّا يجول في خاطركِ إذاً؟

201
00:12:24,160 --> 00:12:27,210
لكن التّعبير عمّا يجول في خاطركِ
هو الطّريقة الوحيدة لتحقيق الأمور

202
00:12:27,210 --> 00:12:29,720
كرّسي إيمانكِ في أولئك المُحيطين بكِ
واطلبي منهم المُساعدة

203
00:12:30,150 --> 00:12:33,490
أنصحكِ بأن تصبحي أكثر أنانيّة

204
00:12:36,270 --> 00:12:37,480
أوزفال

205
00:12:37,480 --> 00:12:41,790
أوافق عى إرسال فُرسان بارناكورتا إلى غيرتونيا

206
00:12:41,790 --> 00:12:44,210
باشروا في المُفاوضات مع قادتهم حالاً

207
00:12:44,210 --> 00:12:44,990
!عُلِم

208
00:12:46,600 --> 00:12:47,990
اطمئنّي

209
00:12:47,990 --> 00:12:51,220
سأفعل أيّ ما يلزم لمُساعدتكِ يا آنسة فيليا

210
00:12:51,220 --> 00:12:55,720
أنقذتِ مملكتنا، لذا مسؤوليّتنا هي
رؤية أُمنياتكِ تتحقّق

211
00:12:56,490 --> 00:12:58,700
أنت معسول اللّسان بين الحين والآخر يا أبي

212
00:12:58,700 --> 00:13:00,380
...بالنّسبة لك يا ابني الكسول

213
00:13:00,380 --> 00:13:03,900
فكّر بطُرُق في مُساعدة الآنسة فيليا

214
00:13:03,900 --> 00:13:05,800
!أكيد. أعمل على ذلك

215
00:13:05,800 --> 00:13:07,870
احرص فقط على أن يكون ذلك
بالفعل، لا بالأقوال

216
00:13:07,870 --> 00:13:09,630
أجل، أجل. فهمتُك

217
00:13:08,580 --> 00:13:10,880
لا أُصدّق حدوث هذا

218
00:13:10,880 --> 00:13:12,810
...لكن آنسة فيليا

219
00:13:13,130 --> 00:13:18,210
سمعتُ بأنّ الوحوش يستمرّون بالظّهور
والتدفُّق خارج حدودنا

220
00:13:18,210 --> 00:13:22,350
على هذا المُعدّل، حتّى فرساننا لن يتمكّنوا
من التصدّي لهم للأبد

221
00:13:22,810 --> 00:13:27,070
أجل. لدي فكرة بخصوص ذلك

222
00:13:28,500 --> 00:13:32,620
،إذا سمحت أنت وشعب هذه المملكة بذلك

223
00:13:32,620 --> 00:13:37,500
فقد تُنقَذ غيرتونيا وجميع جيراننا

224
00:13:37,500 --> 00:13:38,910
مُبهر

225
00:13:38,910 --> 00:13:41,210
تُخفين مُعجزة أُخرى لنا؟

226
00:13:41,630 --> 00:13:45,700
لا، لستُ مفتاح هذه الخطّة

227
00:13:45,700 --> 00:13:49,110
سيعتمد الأمر كلّه على غريس

228
00:13:49,110 --> 00:13:49,890
...ماذا

229
00:13:50,160 --> 00:13:51,510
ماذا قلتِ؟

230
00:13:51,800 --> 00:13:54,970
أبسط طريقة لإنقاذ غيرتونيا

231
00:13:54,970 --> 00:13:59,010
هي وضع دائرة التّطهير العظيمة
فوق القارّة بأكملها

232
00:13:59,010 --> 00:14:01,020
!فهمت

233
00:14:01,020 --> 00:14:03,960
ستكون تلك الطّريقة الأكثر كفاءة

234
00:14:03,960 --> 00:14:07,860
لكن أما كان بمقدوركِ فعل ذلك
منذ البداية فحسب؟

235
00:14:07,860 --> 00:14:13,950
ولا حتّى القدّيسة فيليا لديها قوّة سحريّة
!كافية لنصب حاجز فوق القارّة بأكملها

236
00:14:13,950 --> 00:14:15,410
هذا صحيح

237
00:14:15,410 --> 00:14:19,000
لهذا أريد استعارة قوّة السّحر منكِ يا غريس

238
00:14:19,390 --> 00:14:21,850
قوّة السّحر... منّي؟

239
00:14:24,160 --> 00:14:28,470
هناك طقس قديم يُدعى بتعويذة تلاقي السّحر

240
00:14:28,470 --> 00:14:33,720
يسمح لعدد من الأشخاص بجمع موارد من خلال
نقل قوّة السّحر فيما بينهم

241
00:14:34,010 --> 00:14:39,680
إذاً تستطيع الآنسة غريس منحكِ بعضاً من سحرها
من أجل توسيع الدّائرة؟

242
00:14:39,680 --> 00:14:41,400
!لـ-لا أستطيع فعل ذلك

243
00:14:41,400 --> 00:14:44,610
من الواضح أنّني لا أملك سحراً كافياً
!لتحقيق ذلك

244
00:14:44,940 --> 00:14:48,210
صحيح. إنّها قارّةٌ كبيرة

245
00:14:48,210 --> 00:14:52,070
حتّى هاوياً مثلي يعلم بأنّ هذا غير منطقيّ

246
00:14:52,610 --> 00:14:56,980
قلتِ بأنّ لديكِ أخوات أكبر سنّاً
قدّيسات كذلك، صحيح؟

247
00:14:56,980 --> 00:14:59,290
أجل. ثلاثة منهن

248
00:14:59,610 --> 00:15:00,540
...مهلاً لحظة

249
00:15:01,400 --> 00:15:05,840
سأُعلّمكِ تعويذة تلاقي السّحر

250
00:15:05,840 --> 00:15:09,170
ثمّ أريدكِ أن تُعلّميها لأخواتكِ

251
00:15:09,170 --> 00:15:14,130
،بالطّبع! بدمج سحر خمسة أشخاص

252
00:15:14,130 --> 00:15:16,860
يمكن جعل دائرة التّطهير العظيمة أكبر بكثير

253
00:15:16,860 --> 00:15:21,010
أنا متأكّد بأنّ فُرساننا يستطيعون التصدّي
للكارثة لمدّة كافية كي تفعلنَ ذلك

254
00:15:21,010 --> 00:15:22,140
غريس

255
00:15:23,480 --> 00:15:28,620
تعلّمتُ الكثير منذ مجيئي إلى هذه المملكة

256
00:15:28,620 --> 00:15:32,440
،أنّه إذا لم تستطيعي فعل شيء بمفردكِ
فيمكنكِ طلب المُساعدة من شخص آخر

257
00:15:32,440 --> 00:15:34,900
،أنّه إذا كنتِ تفتقرين ما تحتاجينه
فيمكنكِ استعارته

258
00:15:35,580 --> 00:15:39,830
هذه هي الإجابة الّتي تعلّمتُها في بارناكورتا

259
00:15:42,840 --> 00:15:46,010
ساعديني... أرجوكِ

260
00:15:51,840 --> 00:15:52,510
—المعذرة

261
00:15:52,510 --> 00:15:53,720
!القدّيسة فيليا

262
00:15:54,340 --> 00:15:56,300
!سوف أفعلها

263
00:15:56,300 --> 00:16:01,520
لأنّه لا شيء أتمنّاه أكثر من أن
!أكون نافعة لكِ

264
00:16:01,970 --> 00:16:05,940
!سأؤدّي دوري كأوّل تلميذة لكِ

265
00:16:06,250 --> 00:16:09,190
!لنبدأ بالتمرُّن على الطّقس حالاً

266
00:16:10,020 --> 00:16:12,480
شكراً لكِ يا غريس

267
00:16:32,680 --> 00:16:34,090
أيسير كلّ شيء وفق الخطّة؟

268
00:16:35,320 --> 00:16:37,060
أخبرني أخي بكلّ شيء

269
00:16:37,660 --> 00:16:41,450
تتمرّن على شيء يُدعى تعويذة
تلاقي السّحر؟

270
00:16:41,910 --> 00:16:45,690
أجل. أوشكتْ على تعلُّمه

271
00:16:45,690 --> 00:16:46,600
هكذا إذاً

272
00:16:47,840 --> 00:16:53,140
هذا صحيح. ما زلتُ لا أعرف رأي
...رايهارد بكلّ هذا

273
00:16:53,990 --> 00:16:57,340
أظنّها فكرة ممتازة

274
00:16:58,820 --> 00:17:03,620
فأساساً، سيجعل هذا الممالك الأُخرى
مَدينة لنا دون تضحيات من طرفنا

275
00:17:03,620 --> 00:17:08,860
إنّها حركة منطقيّة من قدّيسة تتصرّف
في صالح بارناكورتا

276
00:17:09,610 --> 00:17:10,630
...حسناً

277
00:17:12,150 --> 00:17:13,500
هذا صحيح

278
00:17:13,500 --> 00:17:17,140
،بصفتي الآن قدّيسة بارناكورتا

279
00:17:17,140 --> 00:17:20,390
أعي بأنّني ينبغي أن أتصرّف
لخدمة مصالحها

280
00:17:21,050 --> 00:17:26,640
لكن يُسعدني أيضاً أن أكرّس نفسي لعائلتي
،وللأشخاص المُحيطين بي

281
00:17:26,980 --> 00:17:32,240
وآخرين كُثُر لم ألتقِ بهم حتّى

282
00:17:36,920 --> 00:17:38,450
تكريس أنفسنا للآخرين

283
00:17:39,060 --> 00:17:43,370
وازدهار مملكتنا هو التزام
مُقدَّس كِلانا وُلِدنا معه

284
00:17:44,060 --> 00:17:46,210
أعتقد هناك أمور مُشتركة كثيرة بيننا

285
00:17:47,060 --> 00:17:54,340
لكن لعلّي فقدتُ فُرصتي لتكريس نفسي
في التصرُّف لخدمة محبوبتي

286
00:17:54,340 --> 00:17:55,970
...الأمير رايهارد

287
00:17:56,840 --> 00:18:00,260
فيليا، احرصي على ألّا تتصرّفي
لأجل الآخرين فقط

288
00:18:00,260 --> 00:18:03,890
بل اعتني بنفسكِ كذلك

289
00:18:04,880 --> 00:18:08,270
حسناً. سأفعل

290
00:18:13,270 --> 00:18:14,270
سموّك

291
00:18:16,150 --> 00:18:17,880
لن أموت

292
00:18:18,320 --> 00:18:21,800
،إذا كان لدي التزام مُقدّس

293
00:18:21,800 --> 00:18:24,660
فأريد أن أعيش وأنجزه مع الأشخاص هنا

294
00:18:24,660 --> 00:18:28,040
لأنّني أُحبّ هذه المملكة

295
00:18:40,520 --> 00:18:41,880
تفوّقتْ عليّ

296
00:18:47,280 --> 00:18:48,640
!سموّك

297
00:18:48,640 --> 00:18:51,810
أشعّة الشّمس مُفيدة لك

298
00:18:51,810 --> 00:18:54,320
ستمنحك مزاجاً مُشرقاً أيضاً

299
00:18:55,010 --> 00:18:57,880
أعددتُ لك غداء نزهة

300
00:18:57,880 --> 00:19:01,570
سمعتُ بأنّك نادراً ما تكمل طعامك

301
00:19:05,300 --> 00:19:08,330
لماذا تفعلين كلّ هذا؟

302
00:19:10,230 --> 00:19:12,080
...أخبرني بيير

303
00:19:12,080 --> 00:19:16,010
بأنّكِ تقضين أيّامكِ في قتل الوحوش
،ولياليكِ في التملُّق ليوليوس

304
00:19:16,010 --> 00:19:18,370
وبينهما، تأتين إلى هنا

305
00:19:18,370 --> 00:19:21,200
ليس لديكِ الوقت لإعداد غداء

306
00:19:21,200 --> 00:19:23,040
أنتِ تضغطين على نفسكِ كثيراً

307
00:19:24,340 --> 00:19:27,850
!هذه فترة حسّاسة. يجب أن أضغط على نفسي

308
00:19:27,850 --> 00:19:33,270
لا أتحمّل فكرة أن يُفسد شخصٌ
سافلٌ مثله حياتي

309
00:19:33,270 --> 00:19:36,070
ألا يستفزّك أن ترى شخصاً يحاول أذيّتك

310
00:19:36,070 --> 00:19:37,730
يحصل على كلّ ما يريد؟

311
00:19:37,730 --> 00:19:42,180
يراودكِ هذا الشّعور لأنّكِ قويّة جدّاً

312
00:19:42,940 --> 00:19:44,370
لستُ قويّاً إطلاقاً

313
00:19:44,840 --> 00:19:47,800
لا تُعلّقي آمالكِ على ضعيف مثلي

314
00:19:47,800 --> 00:19:51,450
...أبي وأمّي والجميع حولي

315
00:19:51,450 --> 00:19:54,380
خذلَتْهم صحّتي جميعهم

316
00:19:54,380 --> 00:19:56,300
أكره هذا كرهاً شديداً

317
00:19:56,850 --> 00:20:01,260
مع ذلك في مرحلة ما... بدأ جزء
منّي يعتمد على ذلك

318
00:20:01,720 --> 00:20:03,550
مخلوق عديم الجدوى

319
00:20:03,550 --> 00:20:05,440
"أنا واهن، لذا لا أملك فُرصة"

320
00:20:05,440 --> 00:20:07,530
"هكذا هو أنا فحسب، لذا لا أملك خياراً"

321
00:20:07,530 --> 00:20:11,370
قرّرتُ ألّا أبذل جهداً وأعتزل المُحاولة

322
00:20:11,370 --> 00:20:12,640
!أنا خائف

323
00:20:12,640 --> 00:20:15,060
!أنا خائف من مُواجهة ما هربتُ منه لفترة طويلة

324
00:20:15,060 --> 00:20:16,850
!ليس الموت هو ما أخشاه

325
00:20:16,850 --> 00:20:20,570
أنا مُرتعد جدّاً من تقبُّل كم كنتُ
!فاشلاً طوال هذا الوقت

326
00:20:20,570 --> 00:20:21,850
...وهذا الشّعر الّذي يراودني

327
00:20:21,850 --> 00:20:24,230
هو ما تكرهه أكثر من أيّ شيء آخر؟

328
00:20:25,650 --> 00:20:28,120
أنت مثلي فحسب إذاً

329
00:20:33,840 --> 00:20:37,170
لماذا تبكين؟

330
00:20:37,170 --> 00:20:39,090
أنتِ قدّيسة، أليس كذلك؟

331
00:20:39,090 --> 00:20:42,590
!أنتِ قويّة وصادقة... لستِ مثلي

332
00:20:44,620 --> 00:20:49,400
،سموّك، إذا فشلت في النّهوض الآن
فلن تكون فاشلاً حتّى

333
00:20:50,270 --> 00:20:55,970
لأنّ الفشل هو حقّ تكسبه
!فقط عندما تُقاتل

334
00:20:55,970 --> 00:20:58,350
إذا لم تفعل شيئاً سوى الهرب
،واختلاق الأعذار

335
00:20:58,350 --> 00:21:00,690
!فلن ترتقي حتّى لمستوى الفشل

336
00:21:00,690 --> 00:21:02,490
!لا عيب في الفشل

337
00:21:05,850 --> 00:21:07,130
!إنّه أمر رائع

338
00:21:08,400 --> 00:21:09,690
يجب أن أذهب

339
00:21:14,880 --> 00:21:17,920
هل يُراودك... نفس الشّعور؟

340
00:21:18,930 --> 00:21:24,050
كنتِ خائبة الأمل بنفسكِ ومع ذلك
استمررتِ في الكفاح

341
00:21:28,430 --> 00:21:32,140
أنا واثق بأنّها سئمت منّي الآن أيضاً

342
00:21:32,560 --> 00:21:34,140
لن تعود إلى هنا ثانية أبداً

343
00:21:35,810 --> 00:21:37,150
...أكره فكرة

344
00:21:40,130 --> 00:21:42,860
لحظة، هذا صحيح

345
00:21:44,020 --> 00:21:46,440
!يمكنني الذّهاب لرؤيتها

346
00:21:50,000 --> 00:21:54,040
أرهقتِني يا ميا

347
00:23:26,880 --> 00:23:32,930
القدّيسة المثاليّة جدّاً: رُفِضتُ
بواسطة خطيبي وتمّ بيعي لمملكة أُخرى.

