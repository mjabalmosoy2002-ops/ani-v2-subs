1
00:00:02,560 --> 00:00:08,500
عالمنا مُضيف للمخلوقات الّتي تُهدّد
البشر والّتي نُطلِق عليها بالوحوش

2
00:00:09,980 --> 00:00:12,600
،لحماية النّاس من هؤلاء الوحوش

3
00:00:12,600 --> 00:00:17,950
نحتاج أولئك ذوي القوّة المُقدّسة
لصنع حواجز

4
00:00:19,630 --> 00:00:22,370
هؤلاء النّساء هُنّ قدّيسات

5
00:00:23,090 --> 00:00:26,810
يطردنَ الوحوش ويُطهّرنَ البلاد

6
00:00:26,810 --> 00:00:30,300
وجودهن نعمة للأمن القوميّ

7
00:00:30,300 --> 00:00:37,490
لدرجة أنّه من الضّروريّ لكلّ بلد
أن يمتلك قدّيسة واحدة على الأقلّ

8
00:00:38,800 --> 00:00:42,410
،وهذه البلد، مملكة غيرتونيا

9
00:00:42,410 --> 00:00:47,930
هي موطن للمرأة المعروفة بأعظم قدّيسة
في كلّ الأوقات، فيليا أديناور

10
00:00:48,650 --> 00:00:52,360
القدّيسة فيليا قد عادت؟

11
00:00:52,360 --> 00:00:55,760
أجل. ذهبَتْ لقهر الوحوش في الشّمال
الغربيّ، أليس كذلك؟

12
00:00:55,760 --> 00:00:58,240
القدّيسة فيليا المُنقِذة كالمعتاد

13
00:00:58,240 --> 00:01:00,960
أعتقد بأنّ هذا ما يجعلها الأعظم
على الإطلاق أو ما شابه

14
00:01:00,960 --> 00:01:05,720
.فيليا أديناور هي القدّيسة المثاليّة
لا شيء لا تستطيع فعله

15
00:01:05,720 --> 00:01:08,800
غير أنّ هناك صِفة واحدة تفتقر لها

16
00:01:08,800 --> 00:01:11,720
هذه هي القدّيسة! هيّا. حريّ
بك ألّا تُهينها

17
00:01:11,720 --> 00:01:14,420
طـ-طاب يومكِ يا قدّيسة فيليا

18
00:01:16,390 --> 00:01:17,560
...وهي

19
00:01:21,120 --> 00:01:22,500
ابتسامتها

20
00:01:24,990 --> 00:01:26,330
طاب يومك

21
00:01:28,830 --> 00:01:34,170
القدّيسة يعني منبع الحُبّ
الّذي يُقدّرها شعبها

22
00:01:34,640 --> 00:01:41,130
لكن فيليا هي قدّيسة لم تبتسم أبداً

23
00:01:54,840 --> 00:01:56,330
!زرنا ثانية

24
00:01:58,230 --> 00:02:00,860
المعذرة يا سيّد. من تكون هذه المرأة الجميلة؟

25
00:02:00,860 --> 00:02:03,400
أهذه زيارتك الأولى لغيرتونيا؟"

26
00:02:03,400 --> 00:02:04,120
أجل

27
00:02:04,120 --> 00:02:05,610
أظنّك لا تعلم إذاً

28
00:02:05,610 --> 00:02:07,340
إنّها قدّيستنا

29
00:02:07,340 --> 00:02:10,440
!لدى غيرتونيا قدّيستان حاليّاً في الواقع

30
00:02:10,940 --> 00:02:14,000
!والأُخرى هي القدّيسة ميا

31
00:02:14,000 --> 00:02:17,000
!إنّها لطيفة وعذبة

32
00:02:17,000 --> 00:02:23,120
الابتسامة الّتي تُبارك فيها بشعب غيرتونيا
!بشكل مُتكافئ هي كنز وطنيّ حقّاً

33
00:02:23,120 --> 00:02:27,290
القدّيسة اللّطيفة والجذّابة ميا
!محبوبة بواسطة الجميع

34
00:02:28,600 --> 00:02:30,750
...لكن تلك الّتي هناك

35
00:02:31,290 --> 00:02:37,050
إنّها القدّيسة فيليا، الأخت الكبرى للقدّيسة
ميا ويُزعم بأنّها الأكثر موهبة في التّاريخ

36
00:02:37,050 --> 00:02:38,580
!القدّيسة فيليا

37
00:02:38,580 --> 00:02:40,630
...بخصوص طلبي قبل أيّام

38
00:02:40,630 --> 00:02:44,890
تمّ تأمين طريق الشّحن. يمكنك أن تطمئنّ

39
00:02:44,890 --> 00:02:46,500
القدّيسة فيليا

40
00:02:46,500 --> 00:02:48,930
محاصيلنا تموت من الجفاف

41
00:02:48,930 --> 00:02:51,490
ألا يمكنكِ جعلها تُمطر من فضلك؟

42
00:02:51,490 --> 00:02:54,570
أجل، أدّيتُ الطّقوس مؤخّراً

43
00:02:54,570 --> 00:02:56,480
ينبغي أن تُمطر قريباً

44
00:02:56,480 --> 00:03:00,490
أعتقد يمكنني التّرتيب لهطول مطر
مُنتظَم في المستقبل كذلك

45
00:03:00,880 --> 00:03:02,360
!يمكنها فعل ذلك؟

46
00:03:02,360 --> 00:03:04,640
حسناً، حسناً، إنّها قدّيستنا الثّمينة دون سواها

47
00:03:04,640 --> 00:03:08,160
أردتُ التحقُّق بخصوص ذلك الدّواء
الّذي طلبتُ منكِ تطويره

48
00:03:08,500 --> 00:03:11,300
!كلّفتُها بمهمّة مستحيلة

49
00:03:11,300 --> 00:03:13,080
مُحال أن تكون قد فعلَتْها، صحيح؟

50
00:03:13,080 --> 00:03:16,210
!والآن اعترفي بفشلكِ واطلبي الغفران

51
00:03:16,210 --> 00:03:19,930
أعطيتُ التّركيبة لخبير الأعشاب للتو

52
00:03:19,930 --> 00:03:21,260
!فعلتِها؟

53
00:03:21,950 --> 00:03:25,010
يبدو أنّ القدّيسة غيرتونيا مُذهلة

54
00:03:25,350 --> 00:03:29,770
أجل. مُعظم أرض غيرتونيا هي إمّا
صحراء أو أرضاً قاحلة

55
00:03:30,190 --> 00:03:33,970
.ليس لدينا الكثير من الموارد الطّبيعيّة
كانت الحياة صعبة حقّاً

56
00:03:33,970 --> 00:03:36,590
إنّها هي من قلبَتْ كلّ شيء
رأساً على عقب

57
00:03:36,590 --> 00:03:39,050
،لكنّها ماهرة جدّاً لدرجة أنّها تستفزّ البعض

58
00:03:39,050 --> 00:03:41,020
لذا هناك ممّن يكرهونها أيضاً

59
00:03:45,250 --> 00:03:46,910
عدتُ إلى الدّيار

60
00:03:46,910 --> 00:03:50,960
فيليا! إلى متى ستستمرّين في هدر
وقتكِ عى مهام بسيطة كهذه؟

61
00:03:52,260 --> 00:03:54,830
سامحيني رجاء يا أمّي

62
00:03:54,830 --> 00:03:56,980
أنتِ عاجزة تماماً

63
00:03:56,980 --> 00:04:00,300
لا عجب في أنّكِ استغرقتِ وقتاً لتصبحي قدّيسة

64
00:04:00,300 --> 00:04:02,420
،يجدر بكِ أن تتعلّمي درساً من ميا

65
00:04:02,780 --> 00:04:06,920
عبقريّة حقيقيّة أتمّتْ تدريبها
!القدّيسي في غضون عام واحد

66
00:04:06,920 --> 00:04:11,640
وبخلافكِ، لديها ابتسامة تُسكّن
أرواح كلّ من يشهدونها

67
00:04:11,950 --> 00:04:15,690
ألا تعتقدين بأنّها قريبة جدّاً ممّا
يتوقّعه النّاس من قدّيسة؟

68
00:04:16,070 --> 00:04:16,890
أجل

69
00:04:16,890 --> 00:04:18,690
!ثمّ لدينا أنتِ

70
00:04:18,690 --> 00:04:21,540
...تسرقين عمل النّاس لتثبتي نفسكِ فقط

71
00:04:21,540 --> 00:04:25,040
!كم أنتِ مُتغطرسة وأنانيّة ذات نظرة فوقيّة

72
00:04:25,040 --> 00:04:27,440
،أمامكِ النّموذج الأمثل لهذا الدّور

73
00:04:27,440 --> 00:04:30,580
فلِمَ لا تتمكّنين من إظهار ولو قليل من الجاذبيّة؟

74
00:04:30,580 --> 00:04:34,040
هل تدركين بأنّكِ تُزعجين المُحيطين باستمرار؟

75
00:04:34,040 --> 00:04:36,680
!وتفعلين كلّ ذلك بتعابير وجه جافّة مُرعبة

76
00:04:36,680 --> 00:04:38,670
!أنتِ عار على لقب القدّيسة

77
00:04:39,110 --> 00:04:42,400
في حفلات الشّاي، لا نسمع سوى
!شكاوى عن سلوككِ

78
00:04:42,400 --> 00:04:45,180
!كيف يكون شعورنا عندما نسمع ذلك برأيكِ؟

79
00:04:47,000 --> 00:04:48,800
سامحيني أرجوكِ

80
00:04:49,430 --> 00:04:53,480
يجدر بكِ أن تقضي وقتكِ الّذي تقضينه في
!دراسة الطبّ على تحسين شخصيّتكِ

81
00:04:53,480 --> 00:04:57,190
المديح القليل الّذي تلقّيتِه مقابل
!مواهبكِ لا يُبرّر مثل هذه الغطرسة

82
00:04:57,810 --> 00:05:00,430
...فعلتُها من جديد

83
00:05:00,940 --> 00:05:04,070
!نظرة النّاس لكِ تؤثّر على نظرتهم لميا أيضاً

84
00:05:04,070 --> 00:05:06,990
حاولي أن تتصرّفي كأخت كبرى لها ولو لمرّة

85
00:05:08,760 --> 00:05:11,940
حاضرة يا أمّي

86
00:05:24,540 --> 00:05:27,510
كيف آلت الأمور إلى هذا؟

87
00:05:28,430 --> 00:05:32,390
واجب القدّيسة هو استخدام
قوّتها لأجل مملكتها

88
00:05:33,070 --> 00:05:36,810
...هذا ما تمّ تعليمي إيّاه. ومع ذلك

89
00:05:37,070 --> 00:05:41,400
...كلّما فعلتُها، بذلتُ جهداً أكبر

90
00:05:41,840 --> 00:05:45,330
لسبب ما، أصبح منبوذة شيئاً فشيئاً

91
00:05:46,600 --> 00:05:49,420
كوني جذّابة؟ ابتسمي؟

92
00:06:09,940 --> 00:06:12,050
لا أفهم شيئاً من هذا

93
00:06:23,560 --> 00:06:27,070
لم أعرف يوماً كيف أبتسم

94
00:06:28,070 --> 00:06:30,820
لعلّ هذا ما قلّب والدَي عليّ

95
00:06:30,820 --> 00:06:33,710
،بينما أراهما يغمران أختي بحبّهما

96
00:06:33,710 --> 00:06:35,330
...حتّى كطفلة، ميّزتُ ذلك

97
00:06:36,160 --> 00:06:40,630
سوف أضطرّ للعمل بجدّ"
"كي أكون محبوبة

98
00:06:45,340 --> 00:06:47,840
...فيليا أديناور

99
00:06:51,320 --> 00:06:54,180
غادرَتِ المنزلَ للالتحاق بالكنيسة عن عمر الخامسة

100
00:06:54,180 --> 00:06:58,100
،تعلّمتْ آدابَ السُّلوك، الماضي والحاضر
وكذلك الفنون السّحريّة والقتاليّة

101
00:07:00,400 --> 00:07:03,980
بعد أن علمتُ بأنّني مُملّة
،وأفتقر للجاذبيّة

102
00:07:04,300 --> 00:07:07,360
عرفتُ بأنّه يترتّب عليّ أن أكون
استثنائيّة بطريقة ما

103
00:07:08,320 --> 00:07:11,110
،سجّلني والدايّ في برنامج تدريب القدّيسين

104
00:07:11,520 --> 00:07:15,660
وأذاقني مُعلّمي الويلات

105
00:07:15,660 --> 00:07:19,910
أنتِ عديمة الجدوى ومُملّة. هذا
التّدريب يصبّ في صالحكِ

106
00:07:20,400 --> 00:07:24,920
،إذا استطعتِ إرضاءنا جميعاً
فسوف تعرفين معنى الحُبّ أخيراً

107
00:07:25,780 --> 00:07:29,150
.كوني القدّيسة المثاليّة"
"تستطيع فعل أيّ شيء

108
00:07:29,150 --> 00:07:34,080
،الأيّام الّتي قضيتُها في جحيم التّدريب
...في ظلّ ذلك الهدف المستحيل

109
00:07:34,080 --> 00:07:36,390
لم أكن في حالة تسمح لي بالابتسام

110
00:07:37,920 --> 00:07:43,440
تمّ الإقرار بأنّها قدّيسة في السّادسة عشر
والإعلان عن أنّها العُظمى في كلّ الأوقات

111
00:07:43,440 --> 00:07:47,140
والآن، في التّاسعة عشر، تمّ
الاعتراف بها بواسطة الملك

112
00:07:47,140 --> 00:07:52,110
...وخُطِبت لأمير غيرتونيا الثّانية، الأمير يوليوس

113
00:07:52,720 --> 00:07:53,870
أعتذر لو تأخّرت

114
00:07:53,870 --> 00:07:56,560
سآخذك إلى سموّه

115
00:07:56,560 --> 00:07:57,830
شكراً لجهودك

116
00:08:00,780 --> 00:08:03,330
،عند خطوبتي الرّسميّة من الأمير يوليوس

117
00:08:03,940 --> 00:08:06,840
ظننتُ أنّ جهودي ربّما قد أثمرت أخيراً

118
00:08:07,300 --> 00:08:09,550
ظننتُ بأنّه تمّ الاعتراف بي

119
00:08:12,570 --> 00:08:13,630
!أبي

120
00:08:16,860 --> 00:08:17,960
خرجت لتلتقي بي؟

121
00:08:17,960 --> 00:08:20,000
!أجل! أهلاً بعودتك يا أبي

122
00:08:20,000 --> 00:08:21,310
شكراً يا بُني

123
00:08:32,990 --> 00:08:35,740
!أختي الكبرى! أهلاً بعودتكِ

124
00:08:36,720 --> 00:08:38,520
شكراً لكِ يا ميا

125
00:08:38,990 --> 00:08:41,680
تقرئين في غرفتي ثانية؟

126
00:08:41,680 --> 00:08:44,770
!غرفتكِ أكثر هدوءاً بكثير

127
00:08:44,770 --> 00:08:48,750
!ثمّة رائحة فيها تبعث على السّكينة والاسترخاء

128
00:08:48,750 --> 00:08:51,960
!أشعر بأنّكِ حولي وهذا يمنحني الأمان

129
00:08:48,750 --> 00:08:52,880
لا أشعر بالرّاحة هنا، لكن ميا ودودة دوماً

130
00:08:51,960 --> 00:08:56,420
.رغم أنّني مُحال أن أعترف بذلك في أيّ مكان آخر
وإلّا قالوا بأنّني مهووسة بكِ

131
00:08:52,880 --> 00:08:55,620
هذا هو الشّيء الوحيد الّذي يجعل
العودة تبدو جديرة

132
00:08:57,230 --> 00:08:59,990
ماذا؟ أختي، ما هذه العلبة؟

133
00:09:01,680 --> 00:09:03,440
...إنّها، في الواقع

134
00:09:05,150 --> 00:09:06,190
!أ-أهو لي؟

135
00:09:06,190 --> 00:09:08,670
!هل اشتريتِه يا أختي؟

136
00:09:09,360 --> 00:09:10,240
أجل

137
00:09:10,800 --> 00:09:15,780
أنتِ، الّتي لم تهتمّي يوماً للملابس
!أو الطّعام أو الموسيقى أو الأزياء

138
00:09:16,970 --> 00:09:18,820
ومع ذلك أحضرتِ هذا لي؟

139
00:09:21,340 --> 00:09:25,020
!كم أنا سعيدة! سأحتفظ به للأبد

140
00:09:25,020 --> 00:09:26,290
ظريفة

141
00:09:26,610 --> 00:09:31,020
!وجدتُها! كعربون شكر، سأختار لباساً لكِ

142
00:09:31,020 --> 00:09:33,360
ما رأيكِ بشيء مُلائم لمُواعدة مع الأمير يوليوس؟

143
00:09:33,360 --> 00:09:34,380
!ربّما غداً

144
00:09:34,380 --> 00:09:35,260
غداً؟

145
00:09:36,740 --> 00:09:41,170
في حقيقة الأمر، يريد الأمير رؤيتي غداً

146
00:09:41,680 --> 00:09:43,820
!مُواعدة؟ هل هي مُواعدة؟

147
00:09:44,380 --> 00:09:45,350
لا أعلم

148
00:09:45,770 --> 00:09:47,720
!حسناً، لا يمكنني مُخالفة الأمير

149
00:09:47,720 --> 00:09:51,980
لكن لنذهب للتسوّق في يوم إجازتكِ
!المُقبل بكلّ تأكيد يا أختي

150
00:09:51,980 --> 00:09:55,240
أجل، لنفعل ذلك. هذا وعد

151
00:09:56,240 --> 00:09:58,740
...عملي صعب

152
00:09:59,060 --> 00:10:04,960
لكن بوجود ميا في حياتي، أعلم
بأنّني أستطيع التغلُّب على أي عاصفة

153
00:10:08,090 --> 00:10:09,360
...فيليا التّعيسة

154
00:10:09,360 --> 00:10:12,190
سلوكها لا يُطاق

155
00:10:12,190 --> 00:10:15,500
إنّ تسميتها بالعُظمى في كلّ الأوقات
،قد جعلها مُتغطرسة

156
00:10:15,500 --> 00:10:19,030
مع ذلك لم تقهر إلّا وحوش تافهة

157
00:10:19,030 --> 00:10:23,120
إنّها لا تُقارن بالقدّيسة الأسطوريّة

158
00:10:23,120 --> 00:10:27,600
الّتي أنقذت العالم من كبير
!الشّياطين أسموديوس

159
00:10:27,600 --> 00:10:29,120
صحيح

160
00:10:29,120 --> 00:10:32,230
لا تحتاج غيرتونيا لقدّيستين

161
00:10:33,360 --> 00:10:35,980
لنضع الخطّة في حيّز التّنفيذ

162
00:10:50,600 --> 00:10:52,210
!إنّها القدّيسة ميا

163
00:10:52,490 --> 00:10:55,190
القدّيسة ميا! هل لديكِ إجازة؟

164
00:10:55,190 --> 00:10:56,130
!أجل

165
00:10:56,480 --> 00:10:58,420
!لهذا خرجتُ للتمشّي

166
00:11:00,590 --> 00:11:02,340
!القدّيسة ميا! مرحباً

167
00:11:02,340 --> 00:11:03,510
!المعذرة

168
00:11:04,890 --> 00:11:07,560
!القدّيسة ميا، شكراً لكِ على كلّ ما تفعلينه لأجلنا

169
00:11:07,840 --> 00:11:09,560
!شكراً جزيلاً لكِ

170
00:11:09,560 --> 00:11:10,750
كم هذا جميل

171
00:11:10,750 --> 00:11:13,690
القدّيسة ميا، هل فعلتِ شيئاً مختلفاً بشعركِ؟

172
00:11:14,370 --> 00:11:15,320
...أجل

173
00:11:19,110 --> 00:11:23,030
أكثر شخص أنا مُعجبة به في
!العالم أعطاني هذه

174
00:11:26,450 --> 00:11:30,590
أتساءل ما إن كنتِ قد وصلتِ
!إلى القلعة بعد يا أختي الكبرى

175
00:11:33,770 --> 00:11:35,170
...الأمير يوليوس

176
00:11:35,620 --> 00:11:38,360
أتساءل لماذا استدعاني بهذه العجلة

177
00:11:40,400 --> 00:11:43,680
هذه هي عربتنا العائليّة

178
00:11:44,480 --> 00:11:46,440
هل أبي هنا كذلك؟

179
00:11:47,520 --> 00:11:49,850
!تسرّني رؤيتكِ يا فيليا

180
00:11:50,560 --> 00:11:54,810
لم أره بهذا المزاج الجيّد من قبل

181
00:11:54,810 --> 00:11:56,110
سمعتُ ما فعلتِه

182
00:11:56,110 --> 00:12:01,010
اتّخذتِ المُبادرة وقهرتِ المُستذئبين
في الشّمال الغربيّ بمفردكِ

183
00:12:01,010 --> 00:12:02,190
أجل

184
00:12:02,190 --> 00:12:06,120
الجنود يشتكون دوماً من أنّكِ تأخذين أعمالهم

185
00:12:06,120 --> 00:12:09,340
وحتّى أنّكِ وجّهتِ لهم النّصح حول التّشكيلات

186
00:12:09,340 --> 00:12:11,580
تعلمين بأنّ هذا ليس اختصاص امرأة

187
00:12:12,960 --> 00:12:14,070
...سموّك

188
00:12:14,960 --> 00:12:17,120
هل أنت مسرور حيال شيء؟

189
00:12:17,120 --> 00:12:20,510
أجل، هذا صحيح! تلقّيتُ للتو
بعض الأنباء السّارّة في الواقع

190
00:12:21,440 --> 00:12:23,100
ما هي برأيكِ؟

191
00:12:24,980 --> 00:12:26,710
...فيليا أديناور

192
00:12:38,720 --> 00:12:41,780
!تمّ فسخ خطوبتنا رسميّاً

193
00:12:48,770 --> 00:12:52,190
هلّا أسهبت أكثر، سموّك؟

194
00:12:52,760 --> 00:12:53,910
حسناً

195
00:12:53,910 --> 00:12:57,170
قرّرتُ الزّواج من ميا بدلاً من ذلك

196
00:12:59,170 --> 00:13:00,090
ماذا؟

197
00:13:00,670 --> 00:13:05,330
هناك شيء غير عاديّ ويفتقر للجاذبيّة
في كون المرء مثاليّاً جدّاً

198
00:13:05,330 --> 00:13:09,140
.يُفترض للقدّيسات أن يلتزمنَ بالصّلاة فقط
ليس عليكِ أن تكوني موهوبة جدّاً

199
00:13:10,000 --> 00:13:14,640
لكن ظننتُ بأنّ قلّة جاذبيّتي
...منعتني من أن أكون مثاليّة

200
00:13:14,640 --> 00:13:18,740
!أختكِ الصّغرى ميا أفضل بكثير من تلك النّاحية

201
00:13:18,740 --> 00:13:22,530
إنّها حسناء ولطيفة ولديها شيء مُميّز
يجعلكِ ترغبين في حمايتها

202
00:13:22,530 --> 00:13:27,390
،من يريد الزّواج من قدّيسة من عائلة أديناور
فأيّ شخص سيختار ميا

203
00:13:27,390 --> 00:13:28,820
هذا كلّ ما في الأمر

204
00:13:29,640 --> 00:13:33,290
هل أخبرت ميا بهذا؟

205
00:13:34,580 --> 00:13:36,040
لا، ليس بعد

206
00:13:36,580 --> 00:13:42,630
لكن من الواضح بأنّها كانت تسعى
!لنيل استحساني في ذلك اليوم

207
00:13:42,630 --> 00:13:43,980
...وفضلاً عن ذلك

208
00:13:44,520 --> 00:13:46,760
قال بأنّ الأمر رسميّ، أتتذكّرين؟

209
00:13:50,810 --> 00:13:53,470
...أبي، أمّي

210
00:13:53,470 --> 00:13:58,240
كان الأمير يوليوس من طرح علينا الفكرة

211
00:13:58,240 --> 00:14:00,060
!وبالطّبع، وافقنا

212
00:14:00,060 --> 00:14:04,300
انسحبي بالحسنى لأجل سعادة ميا يا فيليا

213
00:14:04,300 --> 00:14:07,650
!ستكون هي ملِكة مؤهّلة أكثر في النّهاية

214
00:14:10,220 --> 00:14:11,260
...إذا

215
00:14:13,160 --> 00:14:16,830
...إذا كان هذا ما تريده ميا فعلاً

216
00:14:18,700 --> 00:14:21,500
...إذا كان هذا سيُسعدها

217
00:14:22,530 --> 00:14:24,460
...لكن

218
00:14:25,350 --> 00:14:27,370
ثمّة مُشكلة واحدة

219
00:14:27,370 --> 00:14:31,010
من المُحتمل أن ترفض ميا من باب
مُراعاة مشاعركِ

220
00:14:31,010 --> 00:14:32,260
...لهذا السّبب

221
00:14:32,260 --> 00:14:35,270
!قرّرتُ بيعكِ لجيراننا في بارناكورتا

222
00:14:37,820 --> 00:14:40,900
ما-ماذا تقصد بذلك؟

223
00:14:41,700 --> 00:14:45,820
يبدو أنّ قدّيستهم الوحيدة تُوفّيت فجأة

224
00:14:45,820 --> 00:14:48,650
...أشفقتُ عليهم، لذا اقترحتُ عليهم

225
00:14:48,650 --> 00:14:53,780
هل تحتاجون قدّيسة تُعدّ العُظمى"
"في كلّ الأوقات؟

226
00:14:55,870 --> 00:14:57,860
!وماذا قالوا برأيكِ؟

227
00:14:57,860 --> 00:15:04,840
أتوا مُتوسّلين وعرضوا مبلغاً مُساوياً
لميزانيّتنا السّنويّة

228
00:15:05,300 --> 00:15:10,840
يا إلهي! يا لها من صفقة عظيمة للجميع

229
00:15:10,840 --> 00:15:14,580
بالإضافة إلى ذلك، عندما يكتشف العامّة بأنّني
،تخلّيتُ عن خطيبتي حزيناً لأجل بلدي

230
00:15:14,580 --> 00:15:16,180
سأحظى بدعم هائل

231
00:15:16,180 --> 00:15:22,340
سأعطي 30 بالمئة من الأرباح لعائلة
أديناور بالإضافة إلى رتبة نبيل

232
00:15:22,340 --> 00:15:26,070
وأنا متأكّد بأنّ ميا ستطير فرحاً للزّواج منّي

233
00:15:26,070 --> 00:15:30,320
!بالفعل، هذا سيُسعد الجميع

234
00:15:31,890 --> 00:15:35,970
سيُسعد... الجميع؟

235
00:15:41,330 --> 00:15:46,480
الشّيء الّذي لا أستطيع فهمه هو لماذا
يدفعون كلّ هذا المبلغ للحصول على فيليا

236
00:15:46,480 --> 00:15:50,340
.هذه أوّل مرّة يلمس أحدٌ قيمةً فيك
هذا غريب بالفعل

237
00:15:50,340 --> 00:15:53,560
!والآن ستدخل عائلتنا الطّبقة العليا من المُجتمع

238
00:15:53,560 --> 00:15:56,080
!يا لها من تضحيّة ذاتيّة نبيلة لتشريف والديكِ

239
00:15:56,080 --> 00:15:58,990
أحسنّا تربيتكِ في نهاية المطاف

240
00:15:58,990 --> 00:16:01,550
أعتقد بأنّكِ بذلتِ بعض الجهود كذلك

241
00:16:06,150 --> 00:16:07,320
...أنا لطالما

242
00:16:09,090 --> 00:16:10,610
...كلّ ما فعلتُه في حياتي

243
00:16:11,600 --> 00:16:16,460
كان العمل بجدّ على أمل كسب قبولكما

244
00:16:19,170 --> 00:16:23,710
ألستُ ابنتكما أيضاً؟

245
00:16:24,550 --> 00:16:26,500
الوداع يا فيليا

246
00:16:27,870 --> 00:16:30,460
لا أتصوّر بأنّنا سنلتقي ثانية أبداً

247
00:16:32,820 --> 00:16:39,500
لكن حينها... أين سأجد السّعادة؟

248
00:17:04,090 --> 00:17:06,770
تمّ نبذي فعلاً

249
00:17:19,150 --> 00:17:22,860
ماذا كان ينبغي أن أفعل خِلاف ذلك؟

250
00:17:27,140 --> 00:17:30,480
أظنّني لن أعرف أبداً

251
00:17:37,530 --> 00:17:40,030
لا شيء يُصلح الأمر الآن

252
00:17:45,360 --> 00:17:48,290
...والآن كلّ المال الّذي نصبنا فيه على بارناكورتا

253
00:17:48,290 --> 00:17:50,750
على ماذا يجدر بي أن أُنفقه؟

254
00:17:51,070 --> 00:17:56,290
ربّما نستطيع أن ننصب تمثالاً ذهبيّاً
!لك بصفتك ملِك غيرتونيا

255
00:17:56,290 --> 00:17:58,370
!دعنا لا نغترّ بأنفسنا

256
00:17:58,370 --> 00:18:01,180
فأبي ما زال على قيد الحياة

257
00:18:01,180 --> 00:18:05,270
...لكن جلالته كان مريضاً لفترة طويلة

258
00:18:05,540 --> 00:18:11,940
والأمير الأوّل، فيرناند، قد توارى
عن الأنظار خوفاً من سلطتك

259
00:18:12,380 --> 00:18:17,390
أعتقد بأنّ تتويجك أقرب ممّا تعتقد

260
00:18:17,390 --> 00:18:20,260
،وحالما تصبح ملِكاً

261
00:18:20,260 --> 00:18:24,870
وعظمَتك ستدفع غيرتونيا إلى مستويات
!جديدة من الازدهار

262
00:18:25,310 --> 00:18:27,020
أجل، معك حقّ

263
00:18:28,590 --> 00:18:30,660
أمتلك كافّة المُقوّمات

264
00:18:31,400 --> 00:18:34,560
عرش غيرتونيا وميا

265
00:19:38,420 --> 00:19:40,590
كم نمتُ من الوقت؟

266
00:19:41,680 --> 00:19:44,550
مضى وقت طويل منذ لم يكن لديّ ما أفعله

267
00:19:44,550 --> 00:19:46,330
لا أعرف ماذا أفعل بعد الآن

268
00:19:47,670 --> 00:19:49,500
...بارناكورتا

269
00:19:49,500 --> 00:19:51,460
أتساءل كيف هي الأجواء هناك

270
00:19:51,460 --> 00:19:54,830
...يبدو أنّهم دفعوا لأجلي الكثير

271
00:19:54,830 --> 00:19:58,730
أفترض بأنّهم يتأمّلون الحصول
على شيء يستحقّ ما دفعوه

272
00:19:59,310 --> 00:20:02,340
عليّ أن كون مستعدّة للعمل كعبد

273
00:20:06,450 --> 00:20:09,570
لن أستفيد شيئاً من العبوس بسبب ذلك

274
00:20:10,540 --> 00:20:15,700
،حتّى لو انتقلتُ إلى مكان آخر
يبقى واجبي نفسه

275
00:20:16,390 --> 00:20:20,420
عليّ أن أعمل بجدّ كقدّيسة فحسب

276
00:20:23,210 --> 00:20:27,650
أعمل بجدّ؟ لماذا أفعل ذلك؟

277
00:20:28,150 --> 00:20:32,870
لأجل مَن تؤدّي القدّيسة واجباتها وما هي؟

278
00:20:37,910 --> 00:20:40,260
هذه أبعد نقطة يمكننا إيصالكِ إليها

279
00:20:40,260 --> 00:20:43,680
يمكنكِ ركوب عربة أخرى في الطّرف
الآخر من الحدود

280
00:20:45,060 --> 00:20:46,370
...الحدود

281
00:21:06,520 --> 00:21:09,640
هناك جمهرة عند نقطة تفتيش بارناكورتا؟

282
00:21:18,790 --> 00:21:21,780
!وصلت القدّيسة فيليا

283
00:21:32,640 --> 00:21:33,640
...مرحباً بكِ

284
00:21:43,500 --> 00:21:44,970
في بارناكورتا

285
00:21:54,010 --> 00:21:54,780
ماذا؟

286
00:23:26,670 --> 00:23:32,540
القدّيسة المثاليّة جدّاً: رُفِضتُ
بواسطة خطيبي وتمّ بيعي لمملكة أُخرى

287
00:23:33,380 --> 00:23:34,970
:الحلقة القادمة، الحلقة 2

288
00:23:35,920 --> 00:23:37,920
"أهلاً بكِ في بارناكورتا"