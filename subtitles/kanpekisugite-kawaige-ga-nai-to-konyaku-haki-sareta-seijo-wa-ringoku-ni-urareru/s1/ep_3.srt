1
00:00:04,390 --> 00:00:06,150
...عندما يتعلّق الأمر بالتّطهير

2
00:00:10,480 --> 00:00:12,610
!فأنا دقيقة جدّاً

3
00:00:14,700 --> 00:00:17,410
...بالفعل، من كافّة النّواحي

4
00:00:17,740 --> 00:00:19,440
!يجب أن يكون عملنا مُتقناً

5
00:00:22,320 --> 00:00:24,640
هذا هو عمل الخادم

6
00:00:26,770 --> 00:00:30,610
بارناكورتا مشهورة بتفوّقها
في نظامها الفروسيّ

7
00:00:28,980 --> 00:00:30,130
!استعدّوا للموت

8
00:00:30,610 --> 00:00:34,680
وحتّى أنّهم يُدرّبون خدمَهم وخادماتهم
على الفنون القتاليّة

9
00:00:36,960 --> 00:00:38,390
...لكن رغم ذلك

10
00:00:39,280 --> 00:00:41,530
إنّهما قويّان زيادة عن اللّزوم

11
00:02:13,110 --> 00:02:14,620
!القدّيسة فيليا

12
00:02:14,620 --> 00:02:16,760
!تمّت عمليّة التّطهير

13
00:02:16,760 --> 00:02:20,240
أحسنتما صنعاً. إنّكما استثنائيّان

14
00:02:20,730 --> 00:02:21,820
لا، أبداً

15
00:02:21,820 --> 00:02:24,960
كان الوحوش ضعفاء بالفعل بسبب
الحرم المُقدّس

16
00:02:24,960 --> 00:02:26,200
...فضلاً عن ذلك

17
00:02:26,680 --> 00:02:33,870
الجرعة الّتي قدّمتِها لي تجعلني أشعر
!وكأنّني في ذروة عنفواني

18
00:02:33,870 --> 00:02:36,210
وأيضاً، انظري كم أصبح شعري
!داكناً وكثيفاً

19
00:02:36,540 --> 00:02:38,960
!أشعر بأنّني في قمّة عطائي أيضاً

20
00:02:38,960 --> 00:02:41,050
!أنتِ مُذهلة أيّتها القدّيسة فيليا

21
00:02:41,050 --> 00:02:44,720
...لكن كانت مُجرّد جرعة بدائيّة

22
00:02:44,720 --> 00:02:47,810
في الواقع، كنتُ أتساءل حول شيء

23
00:02:47,810 --> 00:02:50,600
ما الّذي كنتِ تُدوّنينه؟

24
00:02:50,600 --> 00:02:52,960
هذا؟

25
00:02:59,360 --> 00:03:03,360
من الواضح أنّهم كانوا في ازدياد

26
00:03:03,360 --> 00:03:07,070
حتّى عندما قضينا عليهم، سرعان ما عادوا

27
00:03:07,070 --> 00:03:09,370
ما سبب ذلك؟

28
00:03:09,370 --> 00:03:11,040
...في الواقع

29
00:03:11,340 --> 00:03:15,580
بالإضافة إلى العالم السّطحيّ
،الّذي نقطنه نحن البشر

30
00:03:15,580 --> 00:03:17,670
يوجد عالم شياطين وسماويّ

31
00:03:18,260 --> 00:03:21,360
،الوحوش يقطنون في عالم الشّياطين

32
00:03:21,360 --> 00:03:24,680
لكن أحياناً يصعد جزء منهم
إلى هنا في السّطح

33
00:03:24,680 --> 00:03:27,370
...جزء فقط؟ لكن كان عددهم كبيراً

34
00:03:27,370 --> 00:03:32,230
،أجل. كلّما زاد عدد الأوكار في عالم الشّياطين
زادت الوحوش هناك

35
00:03:32,230 --> 00:03:35,600
ما يعني بالمقابل المزيد والمزيد
من غزو السّطح المُتكرّر

36
00:03:37,080 --> 00:03:38,300
القدّيسة فيليا

37
00:03:39,100 --> 00:03:41,240
العربة جاهزة

38
00:03:41,680 --> 00:03:43,540
لنعُد إلى القصر

39
00:03:43,540 --> 00:03:44,430
!حاضرة

40
00:03:44,430 --> 00:03:48,950
بالمناسبة يا قدّيسة فيليا، انتهينا
من العمل اليوم، أليس كذلك؟

41
00:03:48,950 --> 00:03:50,160
أجل. ما الأمر؟

42
00:03:50,160 --> 00:03:51,660
...في هذه الحالة

43
00:03:52,760 --> 00:03:54,290
!الأمير أوزفالت

44
00:03:54,290 --> 00:03:56,140
!تسرّني رؤيتك

45
00:03:56,140 --> 00:03:59,240
!سموّك! خُذ بعضاً من خضرواتي

46
00:03:59,240 --> 00:04:00,840
بالتّأكيد، سأزوركِ لاحقاً

47
00:04:00,840 --> 00:04:02,450
هل خرجت للعمل الآن؟

48
00:04:02,450 --> 00:04:03,260
أجل

49
00:04:03,740 --> 00:04:05,930
لديّ مُواعدة

50
00:04:06,830 --> 00:04:09,180
!مُـ-مُواعدة؟

51
00:04:10,450 --> 00:04:11,680
!آنسة فيليا

52
00:04:11,680 --> 00:04:13,260
—حاولتُ أن آتي باكـ

53
00:04:20,520 --> 00:04:22,320
آسف. أظنّني تأخّرتُ عليكِ

54
00:04:22,880 --> 00:04:24,560
إطلاقاً

55
00:04:27,780 --> 00:04:29,240
!لنجعلها مُواعدة

56
00:04:29,240 --> 00:04:31,770
مُـ-مُواعدة؟

57
00:04:31,770 --> 00:04:35,400
سمعتُ بالكلمة من قبل، لكن
لا أعرف معناها

58
00:04:35,400 --> 00:04:40,320
بالنّسبة لليوم، ما رأيكِ بجولة في آلمبورغ؟

59
00:04:40,320 --> 00:04:44,170
!لا تقلقي! سأحرص على إحضار دليل

60
00:04:44,640 --> 00:04:45,980
دليل؟

61
00:04:46,680 --> 00:04:51,130
لماذا دليلي هو الأمير أوزفالت؟

62
00:04:51,130 --> 00:04:54,830
يُشرّفني أن أُمنَح دور مُرافقة قدّيستنا

63
00:04:55,670 --> 00:04:57,690
!اسمحي لي أن آخذكِ في جولة حول آلمبورغ

64
00:04:59,120 --> 00:05:00,690
هذا هو حيّ التُّجّار

65
00:05:01,110 --> 00:05:04,400
إذا أردتِ التسوُّق، فينبغي أن يكون
هذا محطّتكِ الأولى

66
00:05:04,970 --> 00:05:11,580
جعلَتْ هجمات الوحوش مُغادرة المدينة
صعبة في الأشهر القليلة الماضية

67
00:05:12,000 --> 00:05:15,250
لكن كلّ ذلك قد ولّى الآن بفضلكِ

68
00:05:15,250 --> 00:05:17,540
الجميع سُعداء والمدينة مُفعمة بالحيويّة مجدّداً

69
00:05:18,320 --> 00:05:19,870
أنا سعيد أيضاً

70
00:05:20,350 --> 00:05:21,830
يعزو كلّ الفضل لكِ

71
00:05:21,830 --> 00:05:22,920
شكراً جزيلاً لكِ

72
00:05:25,550 --> 00:05:27,340
شكرَني؟

73
00:05:27,840 --> 00:05:30,050
...كنتُ أؤدّي عملي فحسب

74
00:05:31,060 --> 00:05:34,270
لماذا أشعر وكأنّ نبضات قلبي تتسارع؟

75
00:05:37,610 --> 00:05:38,810
هل من مُشكلة؟

76
00:05:38,810 --> 00:05:40,070
!لا شيء

77
00:05:40,070 --> 00:05:41,900
!إنّها القدّيسة

78
00:05:42,520 --> 00:05:44,070
القدّيسة فيليا؟

79
00:05:44,530 --> 00:05:47,150
...لم أكن أعلم بوجودكِ في بارناكورتا

80
00:05:47,720 --> 00:05:49,360
أعرفك، أليس كذلك؟

81
00:05:49,360 --> 00:05:50,070
أجل

82
00:05:50,630 --> 00:05:54,640
قدّمتُ مُناشدة لكِ في غيرتونيا

83
00:05:54,640 --> 00:05:58,000
بفضلكِ، تمكّنتُ من مُتابعة تجارتي

84
00:05:58,000 --> 00:06:01,140
هذا ابني. سلّم عليها

85
00:06:01,140 --> 00:06:04,550
مرحباً

86
00:06:07,180 --> 00:06:10,140
يا للهول! سأُخيف شخصاً من جديد

87
00:06:10,140 --> 00:06:12,620
شكراً لكِ أيّتها القدّيسة فيليا

88
00:06:12,620 --> 00:06:16,020
كان أبي حزيناً لأنّه لم يستطع لفترة طويلة

89
00:06:16,020 --> 00:06:17,800
!لذا أشكركِ جزيل الشّكر

90
00:06:18,850 --> 00:06:22,250
عـ... على الرّحب

91
00:06:22,250 --> 00:06:23,090
!شكراً

92
00:06:25,010 --> 00:06:26,490
!إنّها القدّيسة

93
00:06:26,490 --> 00:06:29,630
!شكراً جزيلاً لكِ على المجيء إلى بارناكورتا

94
00:06:29,630 --> 00:06:31,570
...قطعتِ كلّ المسافة من غيرتونيا

95
00:06:31,570 --> 00:06:33,150
يُطعمونكِ جيّداً، أليس كذلك؟

96
00:06:33,150 --> 00:06:34,620
...فـ-في الواقع

97
00:06:39,940 --> 00:06:40,790
هيّا بنا

98
00:06:41,220 --> 00:06:44,920
!أيّها النّاس! سأستعيرها لهذا اليوم

99
00:06:46,070 --> 00:06:48,030
!أحسنت صنعاً سموّك

100
00:06:49,280 --> 00:06:51,300
آسف لأنّني أفزعتُكِ

101
00:06:51,300 --> 00:06:53,680
،هذه ليست طريقة اعتذار مُناسبة

102
00:06:53,680 --> 00:06:55,650
لكن اطلبي ما تشائين رجاء

103
00:06:55,650 --> 00:06:57,540
الحلوى هنا شهيّة

104
00:06:58,220 --> 00:07:00,990
ما هو نوعكِ المُفضّل؟

105
00:07:00,990 --> 00:07:02,160
نوعي المُفضّل؟

106
00:07:07,300 --> 00:07:10,560
إن كنتِ محتارة، فهل يمكنني
أن أنصحكِ ببعضها؟

107
00:07:10,560 --> 00:07:13,200
أجل. من فضلك

108
00:07:18,080 --> 00:07:20,420
هـ-هذا غريب جدّاً

109
00:07:20,420 --> 00:07:22,850
كيف يجب أن أتصرّف في هذا الوضع؟

110
00:07:22,850 --> 00:07:23,930
...آنسة فيليا

111
00:07:25,120 --> 00:07:29,500
اسمحي لي أن أشكركِ ثانية على كلّ
الجهود الّتي بذلتِها في هذا الأسبوع

112
00:07:31,390 --> 00:07:34,760
لكن تلقّيتُ أيضاً تقاريرَ تُفيد
بأنّكِ تُجهدين نفسكِ

113
00:07:34,760 --> 00:07:37,720
آنسة فيليا، الرّاحة هي جزء من العمل أيضاً

114
00:07:39,510 --> 00:07:42,440
هذا... جزء من عملي؟

115
00:07:42,880 --> 00:07:45,950
أعتقد ينبغي أن تقضي مزيداً
من الوقت في التّفكير في نفسكِ

116
00:07:46,620 --> 00:07:47,690
...من أجل ذلك

117
00:07:48,400 --> 00:07:50,110
حدّثيني أكثر عن نفسكِ

118
00:07:50,600 --> 00:07:54,580
ما تحبّينه وما تكرهينه، واهتماماتكِ... أيّ شيء

119
00:07:54,580 --> 00:07:59,290
،لا أريد أن أتعرّف على قدّيستنا فحسب
أريد أن أتعرّف على فيليا أديناور بشخصها

120
00:07:59,740 --> 00:08:00,790
!يا إلهي

121
00:08:01,870 --> 00:08:05,380
لا أعرف كيف أردّ على ذلك

122
00:08:05,990 --> 00:08:06,790
...فقبل كلّ شيء

123
00:08:07,370 --> 00:08:12,300
لم أكن أحظى بمساحة لرسم
أفكاري حول أيّ أمر

124
00:08:12,840 --> 00:08:16,220
لم يكُن يُسمَح لي بذلك أصلاً

125
00:08:20,870 --> 00:08:24,740
...يا لها من رائحة جميلة ومُهدّئة

126
00:08:25,350 --> 00:08:26,310
بالطّبع

127
00:08:28,090 --> 00:08:30,070
أحبّ الشّاي

128
00:08:33,680 --> 00:08:35,930
أعتقد لا بأس بذلك

129
00:08:38,580 --> 00:08:43,330
،لكن لا أستطيع إخبارك بالمزيد
لأنّني لا أعلم حقّاً

130
00:08:43,650 --> 00:08:46,910
إذاً لنستنبط المعلومات رويداً رويداً

131
00:08:46,910 --> 00:08:50,000
وجدتُها! هل من مكان ترغبين
في زيارته تالياً؟

132
00:08:50,000 --> 00:08:51,460
سآخذكِ إلى أيّ مكان تُريدين

133
00:08:53,690 --> 00:08:57,040
المعذرة... هلّا طلبتُ شيئاً؟

134
00:08:57,980 --> 00:08:59,930
!ها نحن أولاء

135
00:09:00,580 --> 00:09:05,000
هلّا حصلتُ على إذن بقراءة الكُتب
المحظورة في مكتبة القلعة؟

136
00:09:07,840 --> 00:09:10,490
ما الّذي تحاولين اكتشافه؟

137
00:09:10,490 --> 00:09:14,750
العدد الكبير من الوحوش الّتي تظهر
في بارناكورتا مؤخّراً

138
00:09:14,750 --> 00:09:18,320
لا يمكن تفسيره فقط جغرافيّاً وبغياب
القدّيسة السّابقة

139
00:09:19,290 --> 00:09:23,880
ثمّة ظاهرة مُشابهة في غيرتونيا
قد بدأت قُبيل مجيئي إلى هنا

140
00:09:24,650 --> 00:09:26,500
...هذا التدفُّق المُفاجئ للوحوش

141
00:09:26,500 --> 00:09:31,940
قرأتُ عن وقوع أحداث كهذه
في كُتب تاريخ غيرتونيا القديمة

142
00:09:31,940 --> 00:09:33,920
يبدو أنّكم تملكون سجلّات مُشابهة

143
00:09:36,400 --> 00:09:38,660
،إن صحّتْ فرضيّتي

144
00:09:38,660 --> 00:09:41,180
يقترب عالم الشّياطين من السّطح

145
00:09:43,120 --> 00:09:44,930
...تقصدين إذاً

146
00:09:45,960 --> 00:09:47,770
ماذا بالتّحديد؟

147
00:09:47,770 --> 00:09:51,900
!هذا صحيح. أعتقد يجب أن أشرح

148
00:09:52,260 --> 00:09:57,460
!القدّيسة فيليا... هذا أبعد ما يُمكن عن مُواعدة

149
00:09:59,160 --> 00:10:01,520
،قبل أربعمئة عام

150
00:10:01,520 --> 00:10:04,560
اقترب عالمُ الشّياطين من العالم السّطحيّ

151
00:10:04,560 --> 00:10:07,540
غزانا الوحوشُ هائجين

152
00:10:07,540 --> 00:10:10,040
استغلّ كبير الشّياطين أسموديوس الفوضى

153
00:10:10,040 --> 00:10:14,920
للنّهوض من أعماق عالم الشّياطين
وصعد إلى السّطح

154
00:10:15,880 --> 00:10:18,390
،ذُبِح البشر والحيوانات بشكل جماعيّ

155
00:10:18,390 --> 00:10:21,340
وواجهت العديد من الممالك خطر الدّمار

156
00:10:21,340 --> 00:10:22,550
...إلى أن

157
00:10:23,010 --> 00:10:27,000
جاءت قدّيسة لمُعارضة أسموديوس

158
00:10:27,820 --> 00:10:31,360
،كان اسمها فيانا أيسفيل

159
00:10:31,360 --> 00:10:35,570
واشتهرت لاحقاً بلقب كبيرة
القدّيسين فيانا

160
00:10:36,360 --> 00:10:41,070
أنشأتْ حواجزَ هائلة لتطهير الوحوش
،في طرفة عين

161
00:10:41,530 --> 00:10:46,430
ثمّ فصلتْ روحَ أسموديوس عن جسده
الّذي لا يُقهَر

162
00:10:46,430 --> 00:10:47,580
وختمَتْ عليها

163
00:10:48,960 --> 00:10:52,640
وهكذا عاد السّلامُ إلى البلاد

164
00:10:52,640 --> 00:10:54,900
واستمرّ التّاريخ إلى يومنا هذا

165
00:10:56,350 --> 00:11:00,290
تقصدين بأنّنا سنواجه أزمة أُخرى كهذه؟

166
00:11:00,290 --> 00:11:03,430
أجل. أعتقد بأنّ هذا مُرجَّح

167
00:11:04,100 --> 00:11:07,670
دعا الأمير لعقد مُؤتمر كامل
ردّاً على افتراضي

168
00:11:08,320 --> 00:11:12,940
...إنّه يستشير الآخرين كذلك

169
00:11:12,940 --> 00:11:15,690
ما الّذي يحدث بالضّبط مع اقتراب
عالم الشّياطين؟

170
00:11:15,690 --> 00:11:19,990
سيزداد ظهور الوحوش غالباً
إلى عشرة أو عشرين ضعفاً

171
00:11:19,990 --> 00:11:21,960
!عـ-عشرون ضعفاً؟

172
00:11:21,960 --> 00:11:24,850
!نحن نُعاني أصلاً من التصدّي لهم حاليّاً

173
00:11:24,850 --> 00:11:25,910
أجل

174
00:11:25,910 --> 00:11:30,040
ما يعني بأنّ أعمدة النُّور قد لا تعود كافية

175
00:11:30,040 --> 00:11:33,940
سيترتّب علينا إذاً استدعاء الجيش؟

176
00:11:33,940 --> 00:11:39,050
لكن لتعزيز ميزانيّتنا الدّفاعيّة استناداً
...إلى تخمين ضعيف كهذا

177
00:11:39,570 --> 00:11:41,270
معه حقّ

178
00:11:41,270 --> 00:11:46,220
من الطّبيعيّ ألّا يُصدّقوا فتاة
من مملكة أُخرى وصلتْ للتو

179
00:11:46,470 --> 00:11:49,480
!اعرفي حدودكِ يا امرأة! هذه وقاحة

180
00:11:50,920 --> 00:11:55,180
حسناً. لنرَ فيما إذا كان مُضاعفة ميزانيّة
الدّفاع ثلاث مرّات سيَفي بالغرض

181
00:11:56,400 --> 00:12:00,760
—لـ-لكن ميزانيّتنا في هذا العام محدودة بالفعل

182
00:11:59,830 --> 00:12:01,950
تبقى الميزانيّة ميزانيّة

183
00:12:01,950 --> 00:12:04,330
سأقنع أبي وأخي بذلك

184
00:12:04,330 --> 00:12:05,720
—لكن

185
00:12:05,720 --> 00:12:08,700
آمل ألّا يكون كلّ هذا ضروريّاً بالطّبع

186
00:12:08,700 --> 00:12:11,750
لكن أن نكون مستعدّين خير
من النّدم على ذلك لاحقاً

187
00:12:12,110 --> 00:12:14,300
سأتحمّل مسؤوليّة كلّ شيء

188
00:12:14,300 --> 00:12:17,310
سأُكرّس كامل إيماني بفيليا

189
00:12:18,880 --> 00:12:21,690
فقد فعلَتِ الكثير لأجلنا

190
00:12:21,690 --> 00:12:24,730
من التّهذيب أن نُكافئها بثقتنا

191
00:12:24,730 --> 00:12:26,330
هل من اعتراض؟

192
00:12:27,500 --> 00:12:31,270
كيف له أن يكون بهذه الثّقة؟

193
00:12:31,930 --> 00:12:34,320
ألا يخشى التّوبيخ؟

194
00:12:34,870 --> 00:12:40,070
حتّى ولو كان من الطّبقة الملكيّة، من المُؤكّد
أنّ هناك عواقب لهدر أموال الخزينة

195
00:12:40,340 --> 00:12:44,070
هل من طريقة يمكنني مساعدته بها؟

196
00:12:45,410 --> 00:12:49,490
هناك جيوش ومواقع يمكننا أن نزحف
إليها خلال فترة قصيرة

197
00:12:49,490 --> 00:12:50,830
هل سيكفي هذا؟

198
00:12:50,830 --> 00:12:52,510
هذا ليس كافياً البتّة

199
00:12:52,510 --> 00:12:53,290
!ماذا؟

200
00:12:53,290 --> 00:12:55,800
سيُؤدّي هذا إلى وقوع الكثير من الضّحايا

201
00:12:55,800 --> 00:12:57,240
...هذا صعب

202
00:12:57,240 --> 00:12:59,040
ليس لدينا ما يكفي من جنود

203
00:13:00,030 --> 00:13:02,050
هناك طريقة لحلّ هذه المُشكلة

204
00:13:02,420 --> 00:13:04,180
...لكن إذا طرحتُها

205
00:13:06,650 --> 00:13:10,030
أولويّتي الآن

206
00:13:10,030 --> 00:13:12,640
هي حماية شعب بارناكورتا

207
00:13:14,150 --> 00:13:16,630
ثمّة طريقة أُخرى يمكننا تجربتها

208
00:13:17,880 --> 00:13:21,320
يمكننا نصب دائرة تطهير عظيمة
فوق المملكة برمّتها

209
00:13:21,620 --> 00:13:23,380
!دائرة تطهير عظيمة؟

210
00:13:24,150 --> 00:13:27,930
لـ-لكن هذه طقوس قديمة

211
00:13:27,930 --> 00:13:32,120
من دون إتقان للّغات القديمة وفهم
...كامل للعديد من أنواع التّعويذات

212
00:13:32,120 --> 00:13:33,080
يمكنني فعلها

213
00:13:33,080 --> 00:13:36,900
دائرة السّحر هذه لا تمتلك خصائص
الحبس الّتي يملكها حاجز عاديّ

214
00:13:36,900 --> 00:13:39,780
إنّها تُركّز بشكل كامل على إضعاف الوحوش

215
00:13:39,780 --> 00:13:44,390
قوّتها التّطهيريّة سوف تقضي بسهولة
على أيّ شيء بداخلها

216
00:13:44,980 --> 00:13:45,800
...لكن

217
00:13:46,150 --> 00:13:48,370
هل هناك سلبيّة؟

218
00:13:48,370 --> 00:13:49,050
أجل

219
00:13:49,530 --> 00:13:51,890
،لنصب دائرة تطهير عظيمة

220
00:13:51,890 --> 00:13:54,040
،يجب أن أبقى في وسطها

221
00:13:54,040 --> 00:13:56,560
لأمثّل نُواة الطّقوس

222
00:13:57,040 --> 00:14:00,010
لجعلها فعّالة، يجب أن أبقى في العاصمة

223
00:14:00,560 --> 00:14:02,210
...بصيغة أُخرى، أنا

224
00:14:03,070 --> 00:14:07,450
لن أتمكّن من القيام بمُعظم الأعمال
الّتي كنتُ أؤدّيها حتّى الآن

225
00:14:10,480 --> 00:14:13,450
المعذرة... أهذا كلّ شيء؟

226
00:14:14,470 --> 00:14:15,410
أجل

227
00:14:16,700 --> 00:14:18,580
!حسناً، يبدو هذا ممتازاً إذاً

228
00:14:19,120 --> 00:14:21,420
!أنتِ تعملين بجدّ بهذا الوضع بالفعل

229
00:14:21,420 --> 00:14:27,110
في الواقع، هل ستكون مُتابعة الطّقوس
مُرهِقة بحدّ ذاتها؟

230
00:14:27,110 --> 00:14:31,390
لا، حالما تتفعّل بنجاح، لا ينبغي
أن تتطلّب شيئاً إضافيّاً إطلاقاً

231
00:14:32,390 --> 00:14:35,920
!إذاً يبدو لي أنّه الحلّ المثاليّ

232
00:14:42,650 --> 00:14:46,700
يبدو أنّكِ تُنقذين مملكتنا من جديد يا آنسة فيليا

233
00:14:47,970 --> 00:14:49,820
ما الأمر؟ لا تبدين سعيدة

234
00:14:49,820 --> 00:14:52,480
هل من شيء يؤرقكِ؟

235
00:14:52,480 --> 00:14:54,160
...في الحقيقة، أنا

236
00:14:54,650 --> 00:14:57,440
أفكّر في أختي في الدّيار

237
00:14:57,440 --> 00:14:59,000
الآنسة ميا؟

238
00:14:59,000 --> 00:14:59,660
أجل

239
00:15:00,320 --> 00:15:02,720
،إنّها قدّيسة ممتازة

240
00:15:02,720 --> 00:15:05,320
لكن ليس لديها معرفة بالطّقوس القديمة

241
00:15:05,320 --> 00:15:08,170
لن تتمكّن من إنشاء دائرة تطهير عظيمة

242
00:15:08,740 --> 00:15:10,720
وأنتِ قلقة عليها؟

243
00:15:12,630 --> 00:15:16,240
سـ-سامحني من فضلك، سموّك

244
00:15:16,240 --> 00:15:19,400
...أنا قدّيسة بارناكورتا. لا يجدر بي

245
00:15:19,400 --> 00:15:21,230
لا داعي للاعتذار

246
00:15:21,570 --> 00:15:24,320
من الطّبيعيّ أن تقلق الأخت
الكبرى على أختها

247
00:15:25,760 --> 00:15:27,160
لا تتردّدي

248
00:15:27,160 --> 00:15:28,400
يمكنكِ مُساعدتها

249
00:15:30,720 --> 00:15:31,810
...في هذه الحالة

250
00:15:33,060 --> 00:15:34,140
...فهل يمكنني

251
00:15:35,040 --> 00:15:37,530
إرسال رسالة لها؟

252
00:15:40,950 --> 00:15:42,920
!لا أستطيع قبول هذا ببساطة

253
00:15:43,330 --> 00:15:48,000
مُحال أن تُغادر أختي المملكة
!دون أن تقول كلمة لي

254
00:15:48,250 --> 00:15:52,820
أمّي وأبي أصرّا على أنّ هذا ما أرادته

255
00:15:52,820 --> 00:15:54,080
...ما يعني

256
00:15:55,130 --> 00:15:59,130
ينبغي أن أسأل خطيبها، الأمير
يوليوس، عن الأمر

257
00:15:59,130 --> 00:16:02,060
...قالوا بأنّه بكى وهو يراها ترحل، لذا

258
00:16:03,520 --> 00:16:04,720
الأمير يوليوس

259
00:16:04,720 --> 00:16:06,230
أعتقد أردت أن تراني؟

260
00:16:06,230 --> 00:16:07,520
—هل أنت

261
00:16:08,240 --> 00:16:09,780
!ميا أديناور

262
00:16:10,900 --> 00:16:12,780
هلّا أصبحتِ زوجتي من فضلكِ؟

263
00:16:14,050 --> 00:16:14,780
!ماذا؟

264
00:16:15,100 --> 00:16:17,170
!يا له من جمال! يا له من رقيّ

265
00:16:17,170 --> 00:16:20,330
أنتِ عروس أكثر من جديرة
!بالأمير الثّاني لغيرتونيا

266
00:16:20,720 --> 00:16:22,940
!عمّاذا يتكلّم بالضّبط؟

267
00:16:22,940 --> 00:16:27,170
في أعقاب فقدانه لخطيبته، يتقدّم
من الآن لخطبة فتاة أُخرى؟

268
00:16:27,170 --> 00:16:28,840
وأختها الصُّغرى فوق ذلك؟

269
00:16:29,800 --> 00:16:31,590
كم هذا مُثير للاشمئزاز

270
00:16:32,570 --> 00:16:33,470
...لحظة

271
00:16:33,950 --> 00:16:37,600
إذا تزوّجت فيليا من الأمير، فسوف
!نصبح على وِفاق مع البلاط

272
00:16:37,600 --> 00:16:42,060
يمكنكِ القول بأنّها تُقدّم معروفاً
!للعائلة أخيراً

273
00:16:42,060 --> 00:16:46,520
...سبب عدم مُبالاتهما بعد مُغادرتها

274
00:16:46,520 --> 00:16:48,570
هل كانا على دراية بالأمر؟

275
00:16:48,570 --> 00:16:51,070
!هيّا! أسمعيني إجابتكِ

276
00:16:51,750 --> 00:16:52,990
ولا بأحلامك

277
00:16:53,660 --> 00:16:56,280
،لكن لو أردتُ معرفة ما حدث فعلاً

278
00:16:56,280 --> 00:16:58,780
فيجب عليّ أن أدعه يُخبرني

279
00:16:59,300 --> 00:17:00,820
!يجب أن أفعل هذا

280
00:17:02,400 --> 00:17:03,940
ميا؟

281
00:17:03,940 --> 00:17:05,460
...سموّك

282
00:17:05,460 --> 00:17:08,630
من فضلك امنحني بعض الوقت
للتّفكير في الأمر

283
00:17:08,630 --> 00:17:10,670
غادرتْ أختي مؤخّراً فحسب

284
00:17:10,670 --> 00:17:12,960
مُحال أن أتمكّن من المُوافقة
على الزّواج بهذه السّرعة

285
00:17:12,960 --> 00:17:15,840
صـ-صحيح، بالطّبع

286
00:17:15,840 --> 00:17:19,220
أعتقد بأنّني استعجلتُ قليلاً، أليس كذلك؟

287
00:17:19,530 --> 00:17:22,860
في هذه الحالة، لنمنح الأمر بعض الوقت

288
00:17:19,880 --> 00:17:22,860
لا يمكنني أن أرفضه بعد

289
00:17:22,860 --> 00:17:24,730
يجب أن أكبت مشاعري الحقيقيّة

290
00:17:24,730 --> 00:17:27,520
لن يكون من الصّواب قبول خطوبته منّي بسرعة

291
00:17:27,520 --> 00:17:30,370
،سوف أُشتّته وأُضلّله

292
00:17:30,370 --> 00:17:32,480
وأستخرج منه المعلومات الّتي أُريد

293
00:17:32,480 --> 00:17:34,720
...لستُ ذات عقليّة تخطيطيّة

294
00:17:34,720 --> 00:17:37,780
!لكن لأجل أختي، سأفعل المستحيل

295
00:17:38,280 --> 00:17:41,130
!أنا مسرورة ببساطة، سموّك

296
00:17:41,130 --> 00:17:43,760
،إذا ظنَّ بأنّني مجرّد فتاة باسِمة مُشرقة

297
00:17:43,760 --> 00:17:45,290
!فسوف يتفاجأ

298
00:17:47,630 --> 00:17:52,300
كان ذلك اليوم الّذي بدأتُ فيه
بتحرّياتي بجدّية

299
00:17:52,730 --> 00:17:54,300
،في مكتب أبي

300
00:17:54,300 --> 00:17:58,300
وجدتُ مُخطّطات لقصر جديد وكومة
من وثائق وعقود

301
00:17:58,850 --> 00:18:02,930
وفي غرفة أُمّي، وجدتُ صندوقاً
جديداً من المجوهرات

302
00:18:03,490 --> 00:18:06,950
!كانت فيليا شخصاً مُضجِراً

303
00:18:06,950 --> 00:18:10,610
تكبّدتُ عناء الصّبر لفترات طويلة
،لأحظى برضا الأمير

304
00:18:10,980 --> 00:18:13,890
كلّ هذا مع المُواظبة على واجباتي القدّيسيّة

305
00:18:13,890 --> 00:18:17,720
الوحوش يزدادون عدداً مع رحيل أختي

306
00:18:17,720 --> 00:18:20,320
أستهلك كلّ ما لديّ لدحرهم

307
00:18:20,320 --> 00:18:20,990
...لكن

308
00:18:23,860 --> 00:18:25,620
سأبذل قصارى جهدي

309
00:18:26,170 --> 00:18:27,150
...أختي

310
00:18:31,540 --> 00:18:34,860
ما الّذي يؤخّر ميا كلّ هذه المدّة الطّويلة؟

311
00:18:35,370 --> 00:18:38,000
ماذا لو غيّرَ سموُّه رأيه؟

312
00:18:38,000 --> 00:18:40,660
من فضلكِ. لا داعي للقلق

313
00:18:43,300 --> 00:18:47,080
اليوم هو اليوم الّذي سأجعله
يرخي دفاعه وأدفعه للتكلّم

314
00:18:47,080 --> 00:18:50,180
الماركيز أديناور ماكر، أليس كذلك؟

315
00:18:50,690 --> 00:18:56,070
تخلّصَ من عبء كبير وكسب ربحاً
!مُعتبَراً ولقب نبيل خلال هذه العمليّة

316
00:18:56,070 --> 00:19:03,070
وألم يبدُ هو والأمير يوليوس مسرورين
بتلفيق تلك الرّواية لبيع القدّيسة فيليا؟

317
00:19:03,380 --> 00:19:05,990
...أعلم بأنّ قدّيستنا القديمة كانت بغيضة جدّاً

318
00:19:06,450 --> 00:19:10,250
لكن من المُحزن أن يكرهها خطيبُها
!ووالداها هذا الكره الشّديد

319
00:19:11,340 --> 00:19:13,670
عمّاذا يتكلّمان؟

320
00:19:13,670 --> 00:19:18,300
من المُبهر أن ينفّذا تلك الخطّة بنجاح
مستغلّين مرض الملِك في فراشه

321
00:19:18,300 --> 00:19:22,090
كوفئ الماركيز بصورة لائقة، أليس كذلك؟

322
00:19:22,090 --> 00:19:25,180
يبدو أنّه يستخدمها لتمويل عقار جديد

323
00:19:25,180 --> 00:19:26,560
!بعض الرّجال يبتسم لهم الحظّ

324
00:19:26,560 --> 00:19:28,570
توضّح كلُّ شيء

325
00:19:28,570 --> 00:19:31,430
...باعوا أُختي

326
00:19:34,860 --> 00:19:39,780
أردتُ أن أُصدّق بأنّ والدَي كانا جيّدين

327
00:19:40,510 --> 00:19:43,860
كانت لديّ شكوك حول طريقة
مُعاملتهما مع أختي

328
00:19:43,860 --> 00:19:45,270
...لكن

329
00:19:46,700 --> 00:19:50,920
،كنتُ أخشى من رؤية الحقيقة
!لكن وضعتُ غشاوة على عينَي

330
00:19:51,540 --> 00:19:52,470
!أختي

331
00:19:53,680 --> 00:19:57,490
هل عشتِ طوال حياتكِ في عالم
قاسٍ كهذا؟

332
00:19:59,600 --> 00:20:01,090
...أنا آسفة

333
00:20:01,090 --> 00:20:04,510
!أنا آسفة يا فيليا

334
00:20:06,690 --> 00:20:09,850
هل اليوم هو اليوم الّذي ستقبلين
فيه بعرضي أخيراً؟

335
00:20:10,340 --> 00:20:11,600
...سموّك

336
00:20:11,600 --> 00:20:15,810
هل ذهبَتْ أختي إلى بارناكورتا
بمحض إرادتها فعلاً؟

337
00:20:17,520 --> 00:20:19,230
هل علينا مُناقشة هذا الأمر من جديد؟

338
00:20:19,770 --> 00:20:25,490
فيليا هي من اختار فسخ خطوبتنا والمُغادرة

339
00:20:25,490 --> 00:20:28,680
هذا ما يمكن للمرء أن يتوقّعه منها، صحيح؟

340
00:20:28,680 --> 00:20:32,480
!جُلّ اهتمامها هو التّباهي بمواهبها

341
00:20:32,480 --> 00:20:36,700
كنتُ مُنهمكاً بالفعل بنهجها الفظيع
الّذي استمرّتْ في اتّباعه

342
00:20:36,700 --> 00:20:40,510
!أعني بأنّني كنتُ خطيبها
أيّ طريقة هي هذه عاملَتْني بها؟

343
00:20:40,510 --> 00:20:44,700
بينما أنتِ يا ميا تُركّزين على
واجباتكِ القدّيسيّة بدلاً عن

344
00:20:44,700 --> 00:20:47,010
التدخُّل في شؤون لا تعنيكِ

345
00:20:47,010 --> 00:20:52,520
!الجميع يحبّون جمالكِ وابتسامتكِ السّاحرة

346
00:20:53,270 --> 00:20:59,150
أؤمن بأنّكِ فعلاً القدّيسة العظمى
في كلّ الأوقات

347
00:20:59,150 --> 00:21:02,560
،سايرتُهم بمنح ذلك اللّقب لفيليا

348
00:21:02,560 --> 00:21:06,740
!لكنّها تفتقر تماماً للجاذبيّة

349
00:21:06,740 --> 00:21:11,200
!آمني بنفسكِ! فقد تفوقتِ عليها بالفعل

350
00:21:11,200 --> 00:21:12,200
صحيح

351
00:21:12,200 --> 00:21:14,830
لا تقلقي

352
00:21:14,830 --> 00:21:20,590
،فيليا هي القدّيسة في مملكة مُجاورة
!وتعيش حياتها الجديدة

353
00:21:20,590 --> 00:21:25,290
!أنا متأكّد بأنّها تتمنّى السّعادة لأختها الصّغرى

354
00:21:27,220 --> 00:21:28,370
...سموّك

355
00:21:29,840 --> 00:21:32,470
!أقبل بخطوبتك منّي

356
00:21:33,640 --> 00:21:34,580
!حقّاً؟

357
00:21:34,580 --> 00:21:35,240
!أجل

358
00:21:36,030 --> 00:21:38,530
سأُخطَب لهذا الرّجل

359
00:21:36,030 --> 00:21:38,980
!أجل، من الطّبيعيّ أن تقبلي

360
00:21:38,530 --> 00:21:41,680
،سأُوصله إلى ذروة النّشوة
وأمنحه الحرّية الكاملة

361
00:21:41,680 --> 00:21:44,280
...ثمّ عندما أجد الوقت مُناسباً

362
00:21:44,280 --> 00:21:45,860
سأخونه

363
00:21:46,700 --> 00:21:52,060
فأساساً، يجب أن يُعاقَب
على خيانته أُختي

364
00:21:53,020 --> 00:21:55,000
هذا ما يُفترض أن يحدث

365
00:23:26,880 --> 00:23:32,970
القدّيسة المثاليّة جدّاً: رُفِضتُ
بواسطة خطيبي وتمّ بيعي لمملكة أُخرى

366
00:23:33,760 --> 00:23:35,800
:الحلقة القادمة، الحلقة 4

367
00:23:36,370 --> 00:23:37,670
"مشاعر مُؤتمنة"