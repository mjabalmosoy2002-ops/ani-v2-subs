1
00:00:08,290 --> 00:00:10,690
...أيّها البشريّ اللّعين

2
00:00:10,690 --> 00:00:12,860
أتعتقد بأنّك تستطيع عرقلة مخطّطاتي؟

3
00:00:12,860 --> 00:00:16,490
!أقسمتُ ألّا أدع الآنسة فيليا تذهب ثانية

4
00:00:19,930 --> 00:00:21,830
...الأمير أوزفالت

5
00:00:22,260 --> 00:00:23,570
آسف لتأخُّري

6
00:00:24,210 --> 00:00:26,630
!لكن يسرّني أنّكِ بخير

7
00:00:31,630 --> 00:00:33,760
أنا آسفة لأنّني أثرتُ قلقك

8
00:00:37,610 --> 00:00:40,180
!أيّها الأحمق الوقح! لم تهزمني بعد

9
00:00:54,240 --> 00:00:57,900
أسموديوس... سوف نهزمك هنا

10
00:01:49,760 --> 00:01:52,040
!الحُكم الفضّي

11
00:01:52,040 --> 00:01:55,210
!فجّريه! أيّتها المادّة السّوداء

12
00:02:05,060 --> 00:02:08,190
!انحنوا أمامي أيّها البشر الوضيعون

13
00:02:11,310 --> 00:02:12,380
!سموّك

14
00:02:17,720 --> 00:02:21,450
مضى أربعمئة عام منذ شعرتُ
!بمثل هذه القوّة

15
00:02:21,930 --> 00:02:27,660
كلّ هذا لأنّ ذلك الرّجل المُثير
...للشّفقة كسر الختم

16
00:02:27,930 --> 00:02:29,460
!الدّرع المُقدّس

17
00:02:32,200 --> 00:02:33,970
...هذه القوّة

18
00:02:33,970 --> 00:02:36,630
أكبر بكثير ممّا كانت عندما
!قاتلناه على السّطح

19
00:02:37,150 --> 00:02:41,390
تمّ إحياء أسموديوس بشكل
كامل إذاً، أليس كذلك؟

20
00:02:41,390 --> 00:02:42,230
أجل

21
00:02:42,720 --> 00:02:46,430
لا يمكننا أن ندعه يعود إلى السّطح الآن

22
00:02:46,430 --> 00:02:50,990
أختي الكبرى، حريّ بكِ ألّا تفكّري في
التّضحية بحياتك للقضاء عليه

23
00:02:51,480 --> 00:02:56,150
أنا مُستعدّة لوهب حياتي بكلّ
سرور لإنقاذ العالم كلّه

24
00:02:56,150 --> 00:03:00,600
لو أستطيع إرخاء دفاع أسموديوس
...ولو للحظة واحدة

25
00:03:01,490 --> 00:03:04,420
أسموديوس، إذا تركتَ قوّتك
،تخرج عن السّيطرة

26
00:03:04,420 --> 00:03:06,660
فسوف تُضرّ بدُمية فيانا خاصّتك

27
00:03:06,660 --> 00:03:08,570
أنتِ مُختلفة

28
00:03:08,570 --> 00:03:11,150
مُختلفة عن فيانّا من كلّ ناحية

29
00:03:11,150 --> 00:03:14,770
!سلوكك الحريص هذا مُختلف كلّياً عنها

30
00:03:14,770 --> 00:03:19,420
!قد تكونين إعادة تجسيد، لكنّكِ لستِ مثلها

31
00:03:20,550 --> 00:03:24,050
لم أعُد أُبالي لما يحلّ بجسدكِ

32
00:03:24,320 --> 00:03:26,130
!الكارثة

33
00:03:29,980 --> 00:03:31,690
!الحاجز المُقدّس

34
00:03:33,070 --> 00:03:34,100
!فيليا

35
00:03:45,570 --> 00:03:47,450
...لا

36
00:03:48,350 --> 00:03:50,490
نفد السّحر، صحيح؟

37
00:03:50,490 --> 00:03:56,540
،"قد تكونين "العُظمى في كلّ الأوقات
لكن هذا يُثبت بأنّكِ لا تزالين مُجرّد بشريّة

38
00:03:59,440 --> 00:04:02,050
لا أستطيع الاستسلام بعد

39
00:04:02,940 --> 00:04:05,830
...قطعتُ وعداً للأمير أوزفالت

40
00:04:08,220 --> 00:04:13,000
في وقت كهذا، أوّل ما أُفكّر فيه
هو الوعد الّذي قطعناه؟

41
00:04:15,710 --> 00:04:16,900
هكذا إذاً

42
00:04:16,900 --> 00:04:20,320
قلبكِ على أمير بارناكورتا إذاً؟

43
00:04:20,320 --> 00:04:21,620
هذا مُثير للاهتمام

44
00:04:21,620 --> 00:04:28,760
أتساءل كيف ستستجيبين عندما أمزّقه
!إرباً أمام ناظريكِ

45
00:04:30,880 --> 00:04:33,410
وليس أمير بارناكورتا فحسب

46
00:04:33,920 --> 00:04:39,090
سأدعكِ تُراقبين بينما أضرب جميع
!مَن تهتمّين لأمرهم حتّى الموت

47
00:04:41,450 --> 00:04:42,650
،أريد حمايتهم

48
00:04:43,390 --> 00:04:47,740
...الأشخاص... الّذي أهتمّ لأمرهم

49
00:04:48,550 --> 00:04:52,020
حتّى لو كلّفني ذلك حياتي

50
00:04:54,400 --> 00:04:56,080
فيليا أديناور

51
00:04:56,610 --> 00:04:58,770
سمعتُ رجاءكِ

52
00:05:12,210 --> 00:05:16,610
،أنتِ القدّيسة الّتي أنقذت المملكة
فيانّا آيسفيل

53
00:05:17,250 --> 00:05:19,040
أطلب غفرانكِ

54
00:05:19,040 --> 00:05:24,260
،لأنّ الختم الّذي صنعتُه كان ناقصاً
سبّبتُ مُشكلة كبيرة لكِ

55
00:05:24,790 --> 00:05:30,090
فيليا أديناور، أأتمنكِ على قوّتي الآن

56
00:05:41,190 --> 00:05:42,950
...ما-ماذا

57
00:05:42,950 --> 00:05:44,050
!فيانّا

58
00:05:44,050 --> 00:05:45,650
هذه أنتِ، أليس كذلك يا فيانّا؟

59
00:05:45,650 --> 00:05:48,600
هل تعلمين كم انتظرتُ هذا طويلاً؟

60
00:05:48,600 --> 00:05:52,050
أسموديوس، أنت عسير الفهم حقّاً

61
00:05:52,050 --> 00:05:56,460
حذّرتُك ألّا تُسبّب أي ضرر إضافيّ لعالمنا

62
00:05:57,100 --> 00:05:58,830
!ختم القدّيسة

63
00:06:04,350 --> 00:06:07,010
يسرّني أنّكم بخير جميعاً

64
00:06:07,480 --> 00:06:08,720
آنسة فيليا؟

65
00:06:12,260 --> 00:06:14,980
سأتولّى أمر أسموديوس

66
00:06:14,980 --> 00:06:16,520
دعوا هذا لي

67
00:06:16,520 --> 00:06:19,710
!مُجرّد بشريّة؟ لا تُثيريني على الضّحك

68
00:06:19,710 --> 00:06:21,430
!انتظريني يا فيانّا

69
00:06:21,430 --> 00:06:24,650
!سأحرّركِ من هذا الجسد حالاً

70
00:06:24,650 --> 00:06:26,860
إنّه يطلق عنان تلك التّعويذة الضّخمة
!من جديد يا فيليا

71
00:06:26,860 --> 00:06:28,780
!الحُكم الفضّي

72
00:06:29,870 --> 00:06:31,000
لن يكون هذا كافياً

73
00:06:31,000 --> 00:06:32,570
—تعويذاتكِ الصّغيرة البائسة

74
00:06:38,210 --> 00:06:43,920
مـ-مستحيل. كنتِ أسرع منّي في إلقاء السّحر؟

75
00:06:54,180 --> 00:06:56,060
!هـ-هذا غير ممكن

76
00:07:00,130 --> 00:07:04,570
...هـ-هذا ما ختم عليّ قبل أربعمئة سنة

77
00:07:07,270 --> 00:07:08,900
إيل نورتيا

78
00:07:10,940 --> 00:07:13,420
لن تُحيا بسهولة ثانية

79
00:07:13,420 --> 00:07:16,330
سوف أحطّم روحك إلى أشلاء

80
00:07:18,000 --> 00:07:19,330
!فيانّا! انتظري

81
00:07:19,600 --> 00:07:20,710
!انتظري أرجوكِ

82
00:07:20,710 --> 00:07:23,790
كلّ ما أريده هو أنتِ! لستُ
!بحاجة شيء آخر

83
00:07:23,790 --> 00:07:25,540
!أحبّكِ

84
00:07:26,510 --> 00:07:29,630
لستُ القدّيسة فيانّا

85
00:07:29,630 --> 00:07:34,750
ربّما كانت الاستماتة للحُبّ هي
،الّتي جعلَتْك تفعل كلّ هذا

86
00:07:34,750 --> 00:07:37,890
لكن كقدّيسة، لا أستطيع مُسامحتك
على أفعالك

87
00:07:38,560 --> 00:07:39,810
!لا تفعلي هذا

88
00:07:40,480 --> 00:07:41,540
حضّر نفسك

89
00:07:53,680 --> 00:07:57,950
—فيانّا، أحبّـ

90
00:08:01,210 --> 00:08:07,080
شكراً لكِ على إنقاذ العالم
يا فيليا أديناور

91
00:08:08,450 --> 00:08:11,880
هذا ببساطة واجب قدّيسة

92
00:08:14,910 --> 00:08:16,780
هل أنتِ بخير يا آنسة فيليا؟

93
00:08:19,660 --> 00:08:20,450
أجل

94
00:08:21,200 --> 00:08:24,980
كنتُ لأموت لو لم تأتِ آنذاك

95
00:08:24,980 --> 00:08:27,810
شكراً على المجيء لإنقاذي

96
00:08:27,810 --> 00:08:29,850
!من الطّبيعيّ أن أفعل ذلك

97
00:08:29,850 --> 00:08:33,090
...فأساساً يا آنسة فيليا... أنا... في الواقع

98
00:08:33,830 --> 00:08:35,610
أنت ماذا؟

99
00:08:37,620 --> 00:08:38,990
حان وقت الذّهاب

100
00:08:40,040 --> 00:08:42,580
لا يجوز أن تقول ذلك في هذه
!الحفرة القديمة الكئيبة

101
00:08:42,580 --> 00:08:44,950
اختر مكاناً ذا أجواء أفضل، مفهوم؟

102
00:08:44,950 --> 00:08:47,990
أعتقد معكِ حقّ

103
00:08:47,990 --> 00:08:50,450
فالمزاج مُهمّ في نهاية المطاف

104
00:08:54,420 --> 00:08:55,490
أين أنا؟

105
00:08:57,030 --> 00:08:59,470
!فيليا؟ ماذا تفعلين هنا؟

106
00:08:59,470 --> 00:09:01,770
مضى بعض الوقت يا أمير يوليوس

107
00:09:01,770 --> 00:09:03,570
!أيّتها المرأة اللّئيمة

108
00:09:03,570 --> 00:09:07,040
أنا متأكّد بأنّكِ أنتِ السّبب
!الّذي جعل ميا تخونني أيضاً

109
00:09:07,040 --> 00:09:09,070
!أنتِ لا تتوقّفين عن إزعاجي

110
00:09:09,070 --> 00:09:10,480
—لولاكِ

111
00:09:10,480 --> 00:09:12,610
أنت، صُن لسانك

112
00:09:12,610 --> 00:09:13,720
لا مُشكلة

113
00:09:13,720 --> 00:09:14,820
آنسة فيليا؟

114
00:09:14,820 --> 00:09:16,390
لكن في الوقت المثاليّ

115
00:09:16,390 --> 00:09:19,100
—والآن يمكنني استخدام قوّتي الجديدة كي

116
00:09:20,040 --> 00:09:22,510
!لحظة، أين قوّتي الجديدة؟

117
00:09:22,980 --> 00:09:26,710
استسلم أيّها الأمير الصّغير الغيرتونيّ

118
00:09:26,710 --> 00:09:28,040
!من أنت؟

119
00:09:28,040 --> 00:09:29,250
!أبعد يديك القذرتين عنّي

120
00:09:29,250 --> 00:09:33,380
حسناً، أُفضّل التغذّي على احتقار
...الفتيات الحسناوات

121
00:09:34,750 --> 00:09:40,300
لكن لا أُمانع مضغ طفل صغير بكّاء
كنوع من التّغيير

122
00:09:43,020 --> 00:09:46,560
مامون، خذ هذا الفاشل إلى سجن غيرتونيا

123
00:09:47,570 --> 00:09:51,320
حسناً، حسناً. أريحي شيطاناً
ولو لمرّة يا أختي الكبرى

124
00:09:54,710 --> 00:09:56,870
...لنعُد يا آنسة فيليا

125
00:09:56,870 --> 00:09:58,030
إلى الآخرين

126
00:10:01,900 --> 00:10:02,850
حسناً

127
00:10:05,500 --> 00:10:07,160
!فيليا

128
00:10:07,520 --> 00:10:08,960
...هذا مُطمئن

129
00:10:08,960 --> 00:10:10,580
!يسرّني أنّكِ عدتِ

130
00:10:10,860 --> 00:10:14,580
ميا، آسفة لأنّني أثرتُ قلقكِ

131
00:10:14,580 --> 00:10:18,540
لا... أنا مسرورة فقط لأنّكِ بخير

132
00:10:20,080 --> 00:10:25,020
الأمير أوزفالت، شكراً لك على
إعادة أختي

133
00:10:25,890 --> 00:10:27,400
مُعلّمة؟

134
00:10:58,980 --> 00:10:59,940
فيليا؟

135
00:11:01,960 --> 00:11:06,140
سنحتْ لي فُرص عديدة لأخبركِ
بالحقيقة قبل الآن

136
00:11:06,460 --> 00:11:11,400
سامحيني على التكتُّم عنكِ لفترة طويلة

137
00:11:11,840 --> 00:11:15,060
مُعلّمة، لا تنحني لي من فضلكِ

138
00:11:15,060 --> 00:11:17,070
،أخبرتْني ميا بما حدث

139
00:11:17,360 --> 00:11:21,410
رغم أنّني متأكّدة بأنّها تكبّدتْ
عناء قبل أن تفعل ذلك

140
00:11:22,990 --> 00:11:26,740
علّمتني أشياء كثيرة

141
00:11:27,450 --> 00:11:32,040
للنّجاة، ليس كقدّيسة فقط، لكن كشخص

142
00:11:32,040 --> 00:11:36,630
أنتِ السّبب الّذي جعلني ما أنا عليه اليوم

143
00:11:37,030 --> 00:11:42,250
...لكن لم أمنحكِ حُبّ الأُمّ الّذي تستحقّينه

144
00:11:42,250 --> 00:11:43,800
بل فعلتِ

145
00:11:45,300 --> 00:11:48,720
أكثر بكثير ممّا أستطيع وصفه

146
00:11:48,720 --> 00:11:54,400
جسدي، وقوّتي، وحياتي... كلّها
ثمينة بالنّسبة لي

147
00:11:54,770 --> 00:11:57,350
...لذا شكراً لكِ يا مُعلّمة

148
00:11:57,350 --> 00:11:59,660
لا، يا أُمّي

149
00:12:02,800 --> 00:12:04,540
...أشعر نفسي عديمة الفائدة

150
00:12:05,030 --> 00:12:08,410
لم أقدّم أي عمل أموميّ لكِ

151
00:12:08,930 --> 00:12:12,100
ما زالت هناك أمور كثيرة أريد
تعلّمها منكِ

152
00:12:12,100 --> 00:12:17,170
أمور تساءلتُ عنها منذ اليوم الّذي
علمتُ فيه بأنّكِ أُمّي

153
00:12:17,170 --> 00:12:20,260
أعتقد بأنّكِ تعرفين سلفاً الأمور الأساسيّة

154
00:12:20,260 --> 00:12:23,590
لا أعرف كيف يمكنني تعليمكِ

155
00:12:23,590 --> 00:12:26,930
أريد أن أعرف أكثر عن أبي الحقيقيّ

156
00:12:28,940 --> 00:12:30,140
مُعلّمة؟

157
00:12:31,180 --> 00:12:33,910
هذا فضول طبيعيّ، أليس كذلك؟

158
00:12:33,910 --> 00:12:36,010
مع ذلك لسبب ما، لم أتوقّع هذا

159
00:12:36,010 --> 00:12:40,070
ربّما بمعرفتي لكِ، لم أكن أتوقّع
أسئلة طبيعيّة

160
00:12:40,070 --> 00:12:42,140
هل الأمر غريب إلى هذا الحدّ؟

161
00:12:42,140 --> 00:12:43,290
كم يُثير ذلك فضولي

162
00:12:43,290 --> 00:12:46,070
...تبدو مُتفاجئة بشأن ذلك

163
00:12:47,120 --> 00:12:50,660
كان والدكِ مُعالِجاً

164
00:12:50,660 --> 00:12:53,330
كانت لديه موهبة مُدهشة في علاج الجروح

165
00:12:54,310 --> 00:12:57,330
،تُوفّي أثناء انتشار وباء

166
00:12:57,330 --> 00:13:01,360
لكنّه قلق عليكِ حتّى النّهاية

167
00:13:02,840 --> 00:13:04,970
هكذا إذاً

168
00:13:05,810 --> 00:13:11,720
لعلّ موهبتي في سحر الشّفاء
مُستمدّة من أبي إذاً

169
00:13:14,830 --> 00:13:15,690
...آسفة

170
00:13:16,560 --> 00:13:18,270
لكن أهذا كلّ شيء؟

171
00:13:19,000 --> 00:13:20,560
ماذا تقصدين؟

172
00:13:20,560 --> 00:13:21,840
...في الواقع

173
00:13:21,840 --> 00:13:24,880
،أنا مهتمّة بسماع كيفيّة لقائكما وأين

174
00:13:24,880 --> 00:13:29,900
وكيف أحببتُما بعضاً، ثمّ انتهى
المطاف بزواجكما

175
00:13:31,280 --> 00:13:34,580
في جعبتكِ أسئلة كثيرة حقّاً

176
00:13:34,580 --> 00:13:36,330
تبدين مثل ميا بعض الشّيء

177
00:13:36,330 --> 00:13:38,730
أخبرتِ ميا بكلّ هذا؟

178
00:13:38,730 --> 00:13:42,340
إنّها لا تعرف معنى للحدود

179
00:13:42,850 --> 00:13:44,230
حسناً إذاً

180
00:13:44,230 --> 00:13:46,380
سأجيبكِ عمّا تُريدين

181
00:13:46,380 --> 00:13:51,480
لطالما نويتُ أن ألبّي لكِ كافّة مطالبكِ

182
00:13:53,130 --> 00:13:55,810
هل أعجبكِ هذا يا سيّدة هيلديغيارد؟

183
00:13:56,550 --> 00:14:00,080
،أبلغتْنا القدّيسة فيليا بولعكِ بالطّعام البحريّ

184
00:14:00,080 --> 00:14:03,630
لذا ألزمتُ نفسي بصُنعه

185
00:14:03,630 --> 00:14:08,860
!ليوناردو، هذا كثير جدّاً

186
00:14:08,860 --> 00:14:10,450
لا حاجة للقلق

187
00:14:10,450 --> 00:14:13,160
نعرف كم تحبّ القدّيسة فيليا الطّعام

188
00:14:13,990 --> 00:14:16,540
فيليا؟ أتأكلين إلى هذا الحدّ؟

189
00:14:16,980 --> 00:14:21,000
منذ المجيء إلى بارناكورتا... أجل، ربّما

190
00:14:21,480 --> 00:14:24,020
طعام ليوناردو لذيذ فحسب

191
00:14:25,050 --> 00:14:28,760
فيليا، أنتِ مُباركة بأصدقاء رائعين

192
00:14:29,100 --> 00:14:33,120
كنتُ قلقة في البداية عندما سمعتُ
،بأنّكِ أُرسلتِ إلى بارناكورتا

193
00:14:33,120 --> 00:14:36,770
لكن رؤيتكِ الآن تجعلني أدرك
بأنّ قلقي كان بلا أساس

194
00:14:37,200 --> 00:14:41,060
أجل. أنا مُمتنّة هم جميعاً كلّ يوم

195
00:14:46,570 --> 00:14:47,740
آنسة فيليا

196
00:14:48,420 --> 00:14:50,530
أنا آسف بشأن والديكِ

197
00:14:51,310 --> 00:14:53,580
أنا متأكّد بأنّكِ قلقة على الآنسة ميا أيضاً

198
00:14:53,880 --> 00:14:55,830
...لذا إن أردتِ

199
00:14:56,720 --> 00:14:58,120
لن أعود

200
00:14:59,280 --> 00:15:03,000
لم تعد هذه المملكة بحاجتي

201
00:15:03,000 --> 00:15:06,590
لديهم مُعلّمتي، وكذلك قدّيسة قويّة

202
00:15:08,520 --> 00:15:13,750
أختي الكبرى، ألا ينبغي أن تودّعي
فيليا وداعاً مُلائماً؟

203
00:15:13,750 --> 00:15:14,390
لا

204
00:15:14,690 --> 00:15:17,020
،ما دامت العظمى في كلّ الأوقات

205
00:15:17,020 --> 00:15:19,520
أنا متأكّدة بأنّنا سنُصادف بعضنا
الآخر من جديد في النّهاية

206
00:15:24,560 --> 00:15:30,900
لا ينفكّ النّاس يلحّون عليّ
بإعادة الآنسة فيليا بطريقة ما

207
00:15:30,900 --> 00:15:34,000
كنتُ أتساءل ما كنتِ تستطيعين إقناعها

208
00:15:34,000 --> 00:15:37,910
لا يحقّ لي القيام بذلك

209
00:15:37,910 --> 00:15:40,210
سيكون ذلك مُخجلاً حقّاً

210
00:15:41,440 --> 00:15:42,960
هذا صحيح

211
00:15:42,960 --> 00:15:48,460
علينا أن نُحقّق الازدهار في مملكتنا
بأنفسنا، بأي وسيلة مُمكنة

212
00:15:48,740 --> 00:15:52,720
فمسؤوليّة القرار الطّائش ببيع
الآنسة فيليا لبارناكورتا

213
00:15:52,720 --> 00:15:55,130
لا يقع على يوليوس وحده

214
00:15:55,130 --> 00:15:58,350
بل يقع على عاتق الجميع الّذين لم يمنعوه

215
00:15:58,780 --> 00:16:00,670
...الأمير فيرناند

216
00:16:00,670 --> 00:16:03,730
وأنا أتحمّل المسؤوليّة الكبرى بين الجميع

217
00:16:03,730 --> 00:16:08,900
قبل أن تُلهميني، كان الخوف من أخي
وضعفي يشلّ حركتي

218
00:16:09,200 --> 00:16:10,850
لن أختلق أي أعذار

219
00:16:13,140 --> 00:16:15,690
لا حاجة للانشغال بالماضي

220
00:16:16,440 --> 00:16:19,470
،تعلّمتَ ممّا فعلتَه وبدأتَ تمضي قُدماً

221
00:16:19,470 --> 00:16:23,120
لتُوجّه غيرتونيا نحو الأفضل

222
00:16:23,120 --> 00:16:25,920
نحن نُحرز تقدُّماً الآن

223
00:16:25,920 --> 00:16:28,880
ألا تعتقد بأنّ التحسُّر هو مضيعة للوقت؟

224
00:16:31,990 --> 00:16:33,670
أنتِ مُدهشة

225
00:16:34,330 --> 00:16:35,190
...أقصد

226
00:16:35,890 --> 00:16:38,010
أنتِ مُدهشة بحقّ

227
00:16:38,330 --> 00:16:42,720
هل أعتبر هذا مديحاً؟

228
00:16:42,720 --> 00:16:44,520
بالطّبع يا ميا

229
00:16:44,520 --> 00:16:48,440
الكلام الّذي تقولينه لي يمدّني بالقوّة

230
00:16:48,440 --> 00:16:50,400
أشعر وكأنّني أستطيع فعل أيّ شيء

231
00:16:51,590 --> 00:16:53,430
!سموّك! القدّيسة ميا

232
00:16:53,430 --> 00:16:55,360
هل لي بلحظة؟

233
00:16:55,990 --> 00:17:00,870
،إن كنتَ تلمس قيمة فيما أقول
فسأتكلّم معك كلّ يوم

234
00:17:06,720 --> 00:17:08,330
الأمير رايهارد

235
00:17:10,940 --> 00:17:15,890
تصرُّفاتي الأنانيّة الأخيرة لم تكن
مُلائمة لقدّيسة بارناكورتا

236
00:17:15,890 --> 00:17:18,090
سامحني من فضلك

237
00:17:18,510 --> 00:17:20,970
لا تعتذري يا فيليا

238
00:17:22,120 --> 00:17:26,750
تمنّيتِ إنقاذ أحبّائكِ، الّذين تركتِهم
في موطنكِ

239
00:17:26,750 --> 00:17:29,170
...أتفهّم مشاعركِ تماماً

240
00:17:29,170 --> 00:17:32,230
وكذلك مشاعر أوزفالت في مُساعدتكِ

241
00:17:33,510 --> 00:17:38,160
كنتُ لأفعل نفس الشّيء لإليزابيث بالتّأكيد

242
00:17:39,310 --> 00:17:44,010
،بغضّ النّظر، إذا تعرّضنا لنفس الظّروف ثانية

243
00:17:44,010 --> 00:17:46,660
سأحاول إيقافكِ مع ذلك

244
00:17:46,660 --> 00:17:50,250
،كقدّيسة، أنتِ مفتاح ازدهار مملكتنا

245
00:17:50,250 --> 00:17:52,920
والّتي يجب أن نحميها مهما كلّف الأمر

246
00:17:53,210 --> 00:17:56,770
مملكتي هل كلّ شيء في نظري

247
00:17:57,550 --> 00:18:02,650
فيليا، من فضلكِ استمرّي في الاعتناء بمملكتنا

248
00:18:02,650 --> 00:18:03,560
حسناً

249
00:18:03,560 --> 00:18:07,560
ليس كقدّيسة فقط، إنّما كمُواطنة
...في هذه المملكة الّتي أعزّها

250
00:18:08,120 --> 00:18:11,820
أنوي فعل كلّ ما باستطاعتي فعله

251
00:18:14,300 --> 00:18:15,820
!أختي

252
00:18:16,100 --> 00:18:17,820
!لم أركِ منذ وقت طويل

253
00:18:18,100 --> 00:18:21,040
،حسناً، ليس طويلاً إلى هذا الحدّ
!لكن هل تبلين حسناً؟

254
00:18:21,040 --> 00:18:22,120
أجل

255
00:18:22,120 --> 00:18:24,490
يسرّني أن أراكِ بصحّة جيّدة كذلك

256
00:18:24,490 --> 00:18:25,870
أنتِ أيضاً يا أُمّي

257
00:18:26,320 --> 00:18:29,210
ما زلتُ غير معتادة على هذا النّداء

258
00:18:31,960 --> 00:18:35,200
قمّة القدّيسات الّتي تجمع كافّة
...القدّيسات في مكان واحد

259
00:18:35,200 --> 00:18:38,970
!من هو نجم فيها سوايّ؟

260
00:18:38,970 --> 00:18:41,370
مـ-من هذه؟

261
00:18:41,370 --> 00:18:44,560
!حسناً، إنّكِ فيليا أديناور دون سِواها

262
00:18:41,370 --> 00:18:45,680
هذه إيميلي ماتّيلاس، قدّيسة بولميرن، صحيح؟

263
00:18:44,560 --> 00:18:47,080
!كنتِ خفيّة لدرجة بالكاد لاحظتُكِ

264
00:18:45,680 --> 00:18:48,560
...لم ألتقِ بها من قبل، لكن

265
00:18:47,080 --> 00:18:48,560
!تعالا يا أماندا وجين

266
00:18:48,560 --> 00:18:53,970
من بين القدّيسات الحاليّات، إنّها غالباً
الأقرب إليكِ من حيث القوّة

267
00:18:53,970 --> 00:18:56,700
...باستثناء شخصيّتها المُعاكِسة لشخصيّتكِ

268
00:18:56,700 --> 00:18:58,700
!القدّيسة فيليا

269
00:18:58,700 --> 00:19:00,660
!مضى وقت طويل

270
00:19:00,860 --> 00:19:05,240
سيسمحون للي بالبقاء والاستمرار
!في الدّراسة تحت جناحكِ

271
00:19:05,750 --> 00:19:08,620
!أنا مُتلهّفة لقضاء وقت أطول معكِ

272
00:19:08,620 --> 00:19:13,420
جيّد. أنا أستمتع بتعليمكِ لأنّكِ
تعملين بجدّ

273
00:19:14,110 --> 00:19:16,210
!يا له من كلام لطيف

274
00:19:16,210 --> 00:19:17,710
!تمهّلي

275
00:19:17,710 --> 00:19:20,570
!كفّي عن التعلُّق بها كأخت صغرى

276
00:19:20,570 --> 00:19:22,440
!إنّها أختي الكبرى

277
00:19:23,640 --> 00:19:24,800
ميا

278
00:19:24,800 --> 00:19:28,920
في الواقع، أنا التّلميذة الأولى
لدى القدّيسة فيليا

279
00:19:28,920 --> 00:19:33,120
!لا ضير بتاتاً من مُعاملتها كأخت كُبرى

280
00:19:33,120 --> 00:19:36,380
!أختي! من هذه الفتاة؟

281
00:19:38,350 --> 00:19:39,570
!هذا صحيح

282
00:19:39,570 --> 00:19:45,070
كعربون شكر على دبُّوس الشّعر الّذي
أعطيتِني إيّاه، أحضرتُ لكِ هديّة

283
00:19:45,070 --> 00:19:49,260
!يبدو مثاليّاً عليكِ يا قدّيسة فيليا

284
00:19:49,260 --> 00:19:52,080
...يبدو فاخراً قليلاً

285
00:19:52,080 --> 00:19:55,100
ذوق الآنسة ميا ممتاز كالعادة

286
00:19:55,100 --> 00:20:00,380
أنا متأكّدة بأنّ الأمير أوزفالت سيكون مشغولاً
!بالتّحديق ولن يحظى بوقت للأكل

287
00:20:00,380 --> 00:20:02,220
...من فضلكِ لا تحرجيني

288
00:20:02,220 --> 00:20:04,840
ألا تعتقدين بأنّه سيضحك عليّ؟

289
00:20:04,840 --> 00:20:07,500
!مُحال أن يفعل ذلك

290
00:20:07,500 --> 00:20:11,020
أنا متأكّدة بأنّه سيمدح شكلكِ

291
00:20:11,020 --> 00:20:13,170
أ-أتعتقدان ذلك؟

292
00:20:14,410 --> 00:20:16,480
أنتِ في ريعان شبابكِ يا قدّيسة فيليا

293
00:20:16,480 --> 00:20:18,400
آمل أن تستمتعي بوقتكِ فحسب

294
00:20:18,400 --> 00:20:21,420
ليوناردو، هذه ليست مسألة مُضحكة

295
00:20:22,080 --> 00:20:24,280
اعذريني

296
00:20:24,810 --> 00:20:30,200
من النّادر ببساطة أن أراكِ تتصرّفين بطريقة
تُلائم عمركِ لدرجة أشعرَتْني براحة

297
00:20:30,200 --> 00:20:33,210
فدائماً ما أطرح نظرة عامّة

298
00:20:33,210 --> 00:20:36,190
طريقة تُلائم عمري؟

299
00:20:46,170 --> 00:20:47,250
سموّك؟

300
00:20:48,290 --> 00:20:50,070
تبدين مُذهلة

301
00:20:50,070 --> 00:20:53,050
...أقصد بأنّكِ جميلة دوماً

302
00:20:53,050 --> 00:20:55,240
لكن لم يسعني سوى إمعان النّظر فيكِ

303
00:20:56,380 --> 00:21:00,150
ما-ماذا تعني؟

304
00:21:00,800 --> 00:21:03,900
!أقصد بأنّكِ فاتنة فحسب

305
00:21:16,560 --> 00:21:17,740
آنسة فيليا

306
00:21:18,170 --> 00:21:19,800
هل تتذكّرين؟

307
00:21:19,800 --> 00:21:24,420
،عندما وصلتِ أوّل مرّة إلى بارناكورتا
...قطعتُ لكِ وعداً

308
00:21:24,960 --> 00:21:28,930
بأن أعمل بجدّ للحرص على أن
تُحبّي بلدنا

309
00:21:30,600 --> 00:21:33,470
أجل، أتذكّر

310
00:21:33,470 --> 00:21:38,890
ومنذ ذلك الحين، صنعتُ ذكريات كثيرة

311
00:21:39,600 --> 00:21:42,440
وتعرّفتُ على الكثير من النّاس

312
00:21:42,940 --> 00:21:47,160
وكذلك أحبّ هذا البلد الآن

313
00:21:47,910 --> 00:21:54,040
كقدّيسة بارناكورتا، آمل أن
أستمرّ في حمايتها

314
00:21:55,000 --> 00:21:56,290
يسرّني ذلك

315
00:21:56,290 --> 00:22:00,460
أحبّ هذا البلد ومَن يعيش فيه

316
00:22:01,130 --> 00:22:04,300
...وأنتِ يا فيليا أديناور

317
00:22:05,620 --> 00:22:08,680
أحبّكِ أيضاً

318
00:22:14,180 --> 00:22:17,240
...آ-آسف! لم أقصد أن

319
00:22:17,240 --> 00:22:19,900
أعتقد كان ذلك مُفاجئاً أيضاً، أليس كذلك؟

320
00:22:19,900 --> 00:22:21,120
لا

321
00:22:21,880 --> 00:22:24,790
الأمير أوزفالت... الأمر يس كذلك

322
00:22:25,730 --> 00:22:29,460
أعتقد قد أبكي من السّعادة

323
00:22:30,040 --> 00:22:32,160
...على الأقلّ، أعتقد

324
00:22:32,160 --> 00:22:36,830
بأنّني قرأتُ في كتاب أنّ السّعادة
،يمكن أن تُحفّز القنوات الدّمعيّة

325
00:22:36,830 --> 00:22:38,750
لتجعل الدّموع تنهمر

326
00:22:38,750 --> 00:22:43,340
لم أرَ شخصاً يُحلّل دموع
فرحته بهذا الشّكل من قبل

327
00:22:43,340 --> 00:22:45,750
لكن هذا هو طبعك

328
00:22:46,600 --> 00:22:48,590
يُعجبني ذلك فيكِ أيضاً

329
00:22:48,590 --> 00:22:52,350
يُـ-يُعجبكِ موقفي الغريب؟

330
00:22:52,610 --> 00:22:56,280
في الواقع، أعتقد هذا ما يعنيه
الوقوع في الحُبّ

331
00:22:56,280 --> 00:22:57,620
هكذا إذاً

332
00:22:58,040 --> 00:22:59,980
فهمتُ بوضوح الآن إذاً

333
00:23:07,340 --> 00:23:12,320
حُبّ شخص هو شعور مُبهر بحقّ، أليس كذلك؟

334
00:23:24,160 --> 00:23:29,650
وهكذا، القدّيسة المثاليّة جدّاً
الّتي تخلّى عنها خطيبها

335
00:23:30,550 --> 00:23:34,480
،أصبحت الآن في مملكة أُخرى
حيث وجدت السّعادة