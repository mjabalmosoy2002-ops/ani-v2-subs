1
00:00:06,240 --> 00:00:07,820
لا حِراسة؟

2
00:00:08,070 --> 00:00:10,110
يبدو هادئاً جدّاً

3
00:00:12,120 --> 00:00:13,290
لنسرع

4
00:00:23,000 --> 00:00:24,680
!جلالتك! سموّك

5
00:00:25,500 --> 00:00:27,140
!هل أانت بخير، سموّك؟

6
00:00:27,140 --> 00:00:28,210
!جلالتك

7
00:00:28,210 --> 00:00:30,760
...ا-اهربي يا ميا

8
00:00:31,860 --> 00:00:35,050
...هو... يوليوس

9
00:00:35,050 --> 00:00:37,160
...استدعى قوّة ظلاميّة

10
00:00:40,150 --> 00:00:44,550
...مرحباً يا فيليا، يا قدري

11
00:00:45,700 --> 00:00:48,020
التقينا من جديد

12
00:02:25,410 --> 00:02:30,240
فيليا، أرى بأنّكِ لا تزالين تمتلكين
ذلك الشّعر الفضّي الجميل

13
00:02:30,240 --> 00:02:33,540
وبالطّبع، صاحبة الرّوح الأجمل

14
00:02:33,850 --> 00:02:37,670
ينبغي أن تنتمي لي حقّاً

15
00:02:38,060 --> 00:02:43,430
أسموديوس... ما السّبب الّذي يجعلك
تنتحل شخصيّة الأمير يوليوس؟

16
00:02:44,800 --> 00:02:47,020
لا يوجد سبب مُعيّن

17
00:02:47,020 --> 00:02:52,390
لكن كي يزدهر حبّنا، ارتأيتُ بأنّكِ
ستتقبّلين الأمر أكثر

18
00:02:52,390 --> 00:02:54,440
إذا كنتُ بشريّاً عوضاً عن شيطان

19
00:02:55,370 --> 00:02:58,400
آنسة فيليا، ماذا حدث للأمير يوليوس؟

20
00:02:58,690 --> 00:03:01,960
مُسّ بواسطة كبير الشّياطين أسموديوس

21
00:03:03,330 --> 00:03:07,730
لكن ذلك الأمير الأحمق، من بين
،كافّة الخيارات المُحتملة

22
00:03:07,730 --> 00:03:10,250
استحضر قوّة مُحرّمة من النّار

23
00:03:11,570 --> 00:03:13,520
لديك طارد أرواح كذلك؟

24
00:03:13,520 --> 00:03:15,960
!مضى وقت طويل

25
00:03:15,960 --> 00:03:18,370
أيّها العجوز أسموديوس

26
00:03:18,370 --> 00:03:21,090
تبدو وسيماً جدّاً اليوم

27
00:03:21,560 --> 00:03:22,900
مامون؟

28
00:03:22,900 --> 00:03:25,900
انحدرت لمستوى مُتدنٍّ وأصبحت
مُرافقاً لطارد أرواح

29
00:03:25,900 --> 00:03:27,680
أنت وصمة عار على بَني جلدتنا

30
00:03:28,020 --> 00:03:29,760
أنا آسف يا فيليا

31
00:03:29,760 --> 00:03:33,940
لا بُدّ أنّه من الصّعب الاستماع لمُقدّمتي
الرّومانسيّة وسط كلّ هذا الضّجيج

32
00:03:34,350 --> 00:03:35,900
...لذلك، أنوي

33
00:03:36,490 --> 00:03:40,220
تدمير كلّ شخص آخر هنا

34
00:03:45,620 --> 00:03:47,000
ما هذه الأشياء؟

35
00:03:47,910 --> 00:03:49,540
ظلال أسموديوس

36
00:03:49,920 --> 00:03:51,430
شياطين مُنخفضة التّرتيب

37
00:03:56,090 --> 00:03:58,750
الحُكم الفضّي

38
00:04:10,640 --> 00:04:12,100
يتوافدون بلا توقُّف

39
00:04:12,100 --> 00:04:13,140
!مامون

40
00:04:13,420 --> 00:04:15,350
!لكِ ذلك يا أختي

41
00:04:20,230 --> 00:04:22,760
!تقنيّة طرد الأرواح: الغُراب المُلتهم للشّيطان

42
00:04:31,310 --> 00:04:32,960
!مامون

43
00:04:32,960 --> 00:04:36,480
!أنت أظرف بكثير بهذا الشّكل

44
00:04:36,480 --> 00:04:40,090
!أتعتقدينني حيواناً أليفاً أم لا؟

45
00:04:40,090 --> 00:04:42,510
!لنشارك أيضاً

46
00:04:42,970 --> 00:04:46,890
حان وقت استعمال الأسلحة المُضادّة للشّياطين
لأوّل مرّة والّتي طوّرتها لنا القدّيسة فيليا

47
00:04:49,250 --> 00:04:50,310
!لنبدأ

48
00:04:50,310 --> 00:04:52,730
!تقنيّة النّينجا: فنّ هروب النّار

49
00:04:58,150 --> 00:05:00,150
...عندما يتعلّق الأمر بالتّطهير

50
00:05:00,150 --> 00:05:02,150
!أنا شاملة جدّاً

51
00:05:02,150 --> 00:05:03,030
بالفعل

52
00:05:03,030 --> 00:05:05,530
من كافّة النّواحي، يجب أن نكون مثاليّين

53
00:05:09,360 --> 00:05:11,760
فأنا خادم القدّيسة فيليا

54
00:05:13,460 --> 00:05:14,500
!مُبهر

55
00:05:15,060 --> 00:05:17,830
!هذا مِطرَد رائع صنعتِه يا آنسة فيليا

56
00:05:17,830 --> 00:05:19,770
...مـ-مذهل

57
00:05:19,770 --> 00:05:21,750
!الحُكم الفضّي

58
00:05:24,470 --> 00:05:26,200
!العمّة هيلدي

59
00:05:26,200 --> 00:05:27,090
...مُعلّمة

60
00:05:27,460 --> 00:05:29,320
فيليا. ميا

61
00:05:29,320 --> 00:05:32,080
أنا متأكّدة بأنّ لدينا الكثير من الأمور

62
00:05:32,080 --> 00:05:34,930
لكن لنركّز على العدوّ الّذي أمامنا الآن

63
00:05:34,930 --> 00:05:35,600
!عُلِم

64
00:05:35,880 --> 00:05:42,110
بئساً. أردتُ فقط تأمين مكان هادئ لنتكلّم

65
00:05:42,380 --> 00:05:43,480
كم هذا بغيض

66
00:05:45,360 --> 00:05:46,030
!ها هُم

67
00:05:46,030 --> 00:05:47,450
!فيليا! ميا

68
00:05:48,360 --> 00:05:50,060
!الدّرع المُقدّس

69
00:06:10,680 --> 00:06:12,640
!شكراً يا آنسة فيليا

70
00:06:12,640 --> 00:06:14,140
يسرّني أنّك بأمان فحسب

71
00:06:14,570 --> 00:06:16,390
...يا لها من قوّة

72
00:06:16,670 --> 00:06:23,270
لا أتوقّع أقلّ من هذا من كبير الشّياطين الّذي
كاد يُدمّر العالم قبل أربعة قرون

73
00:06:23,270 --> 00:06:27,900
لكن إذا كان يستخدم مُضيفاً بشريّاً، فإنّ
إحياءه لم يكتمل

74
00:06:28,220 --> 00:06:32,980
ما يعني بأنّ هذه ستكون فُرصتنا
الوحيدة لهزيمته

75
00:06:32,980 --> 00:06:35,910
أنت المسؤول عن كلّ هذا. سوف نسحقك

76
00:06:36,750 --> 00:06:38,360
وضعتُموني في مأزق

77
00:06:38,360 --> 00:06:42,620
...كنتُ آمل أن أصون جمالكِ بأخذكِ معي

78
00:06:44,960 --> 00:06:47,970
وجدتُها. ما رأيك بتجربة هذا؟

79
00:06:49,840 --> 00:06:51,220
!الدّرع المُقدّس

80
00:06:59,240 --> 00:07:00,940
!العمّة هيلدي

81
00:07:00,940 --> 00:07:02,130
!مُعلّمة

82
00:07:04,940 --> 00:07:09,690
...قدّيسة غيرتونيا السّابقة، هيلديغاردي أديناور

83
00:07:10,160 --> 00:07:13,070
ليست الرّهينة الّتي كنتُ أرجوها

84
00:07:16,870 --> 00:07:18,940
!فيليا

85
00:07:18,940 --> 00:07:23,040
يبدو أنّ هذه المرأة جعلتكِ تتكبّدين
الكثير من العناء

86
00:07:23,390 --> 00:07:27,750
أستطيع رؤية ذكريات كلّ بشريّ ألمسه

87
00:07:28,640 --> 00:07:30,390
هيلديغاردي

88
00:07:30,390 --> 00:07:33,970
أنتِ تكتمين سرّاً عن فيليا، أليس كذلك؟

89
00:07:33,970 --> 00:07:36,730
!إيّاك أن تجرؤ! ليست بحاجة سماع ذلك

90
00:07:37,350 --> 00:07:41,600
،فيليا، إذا أردتِ إنقاذ أمّكِ

91
00:07:41,600 --> 00:07:42,940
ستأتين معي

92
00:07:50,070 --> 00:07:52,480
أ... أمّي؟

93
00:07:54,830 --> 00:08:02,150
الأشخاص الّذين ظننتِ بأنّهما والداكِ
،خطفوكِ منها

94
00:08:02,150 --> 00:08:04,710
كلّ ذلك لحفظ سلالة عائلتهم

95
00:08:07,080 --> 00:08:11,090
ويبدو أنّ أختكِ الصّغرى كانت تعلم

96
00:08:11,590 --> 00:08:12,930
!فيليا

97
00:08:12,930 --> 00:08:14,680
!تخلّي عنّي

98
00:08:15,020 --> 00:08:17,350
!كما تخلّيتُ عنكِ

99
00:08:17,350 --> 00:08:21,390
الأمّ الّتي تتخلّى عن ابنتها لا يحقّ
!لها أن تعتبر نفسها أمّاً

100
00:08:22,850 --> 00:08:24,390
...مُعلّمة

101
00:08:25,630 --> 00:08:27,440
اسمعيني يا فيليا

102
00:08:27,860 --> 00:08:30,550
أكثر ما يهمّ بالنّسبة لقدّيسة هو مملكتها

103
00:08:30,550 --> 00:08:33,450
يجب أن تعطي الأولويّة لشعبكِ دوماً

104
00:08:34,080 --> 00:08:35,520
حاضرة يا مُعلّمة

105
00:08:36,880 --> 00:08:41,830
طوال هذا الوقت، اتّبعتُ تعاليمها كقدّيسة

106
00:08:41,830 --> 00:08:42,450
...لكن

107
00:08:42,450 --> 00:08:44,210
ماذا تريدين أن تفعلي؟

108
00:08:44,840 --> 00:08:48,210
الصّواب أو الخطأ ليس مهمّاً الآن

109
00:08:48,880 --> 00:08:52,710
ابحثي في أعماقكِ وأخبريني
!بما تريدينه فعليّاً

110
00:08:53,160 --> 00:08:56,420
!لن أتخلّى عنكِ يا مُعلّمة

111
00:08:58,100 --> 00:08:59,100
...فيليا

112
00:09:00,160 --> 00:09:01,100
...أختي

113
00:09:01,100 --> 00:09:02,600
!عودي يا فيليا

114
00:09:02,900 --> 00:09:05,190
...إذا أمسك بكِ أسموديوس

115
00:09:06,690 --> 00:09:07,780
لنفعلها يا مامون

116
00:09:07,780 --> 00:09:11,230
بئساً، تجعلينني أستعرض مهاراتي

117
00:09:15,950 --> 00:09:17,360
ها أنتِ ذي

118
00:09:17,360 --> 00:09:18,780
!انخفضي يا فيليا

119
00:09:19,440 --> 00:09:22,080
!دمّريه! المادّة الظّلاميّة

120
00:09:26,340 --> 00:09:28,300
أتعتقد بأنّك قويّ بما يكفي لمُواجهتي؟

121
00:09:28,300 --> 00:09:30,090
...في الواقع

122
00:09:30,090 --> 00:09:33,580
لم يكن الهدف من ذلك هزيمتك يا عجوز

123
00:09:38,590 --> 00:09:40,720
!هل أنتِ بخير يا مُعلّمة؟

124
00:09:41,260 --> 00:09:42,220
أجل

125
00:09:46,230 --> 00:09:47,690
،اغرب عن وجهي

126
00:09:47,690 --> 00:09:50,220
!أيّتها البشريّة الواهنة

127
00:09:53,610 --> 00:09:54,530
!إيرزا

128
00:10:07,290 --> 00:10:08,070
!أختي

129
00:10:08,070 --> 00:10:08,920
!آنسة فيليا

130
00:10:09,260 --> 00:10:10,790
...لماذا

131
00:10:13,550 --> 00:10:17,050
يبدو أنّني ألحقتُ ضرراً بجسدكِ

132
00:10:17,050 --> 00:10:22,050
لا يهمّ. حضّرتُ لكِ مُضيفاً أفضل بكثير

133
00:10:22,050 --> 00:10:26,180
أنسب لروح فيانّا

134
00:10:28,560 --> 00:10:29,790
!أختي

135
00:10:30,480 --> 00:10:32,530
حسناً إذاً، وداعاً

136
00:10:39,510 --> 00:10:41,330
هذه أسوأ نتيجة مُمكنة

137
00:10:42,610 --> 00:10:44,450
...ليتني كنتُ أقوى

138
00:10:45,190 --> 00:10:47,950
...هذا مستحيل... أختي

139
00:11:08,280 --> 00:11:09,310
أجل

140
00:11:10,020 --> 00:11:12,060
حـ-حقّاً؟

141
00:11:12,060 --> 00:11:15,520
أخبرينا! أين هي؟

142
00:11:21,260 --> 00:11:24,120
هيماري، ليس من اللّطيف تهديد الآخرين

143
00:11:25,120 --> 00:11:26,240
...لكن

144
00:11:26,240 --> 00:11:29,030
،بقدَر قلقي على مولاتي

145
00:11:29,030 --> 00:11:32,000
قد يكون من الصّعب الحِفاظ
على هدوئي الرّاقي

146
00:11:36,150 --> 00:11:42,010
الشّكل الحقيقيّ لأسموديوس يسكن في عالم
الدّهليز بين هذا العالم وعالم الشّيطان

147
00:11:42,880 --> 00:11:50,480
يخطّط لاستخدام روح فيليا لبعث
كبيرة القدّيسين الأسطوريّة فيانّا

148
00:11:54,650 --> 00:11:57,150
اصبري قليلاً يا فيليا

149
00:11:57,770 --> 00:12:02,740
حالما تتحرّر روحكِ، ستتحرّرين
من ألم جسديّ كهذا

150
00:12:06,310 --> 00:12:10,250
...لا أستطيع الانتظار أكثر

151
00:12:10,610 --> 00:12:12,160
هل ترتجفين؟

152
00:12:12,740 --> 00:12:13,750
...مسكينة

153
00:12:24,420 --> 00:12:26,610
!ما هذا؟

154
00:12:24,720 --> 00:12:26,610
!شِفاء القدّيس

155
00:12:32,800 --> 00:12:37,440
إنّ مُراقبة مامون منحَتْني الفُرصة
لدراسة الأجسام الشّيطانيّة

156
00:12:37,440 --> 00:12:39,230
بالإضافة إلى الدّماء، لديك

157
00:12:39,230 --> 00:12:42,440
جريان دائم من قوّة السّحر
في أنحاء جسدك

158
00:12:42,440 --> 00:12:45,410
،لذا عندما حقنتُ سحراً من جسدي

159
00:12:45,930 --> 00:12:51,040
تضاربَ السّحران، ممّا عرقل ذلك الجريان مُؤقّتاً

160
00:12:52,790 --> 00:12:54,040
...فيليا

161
00:12:54,040 --> 00:12:57,290
لماذا... لماذا تفعلين هذا؟

162
00:12:57,290 --> 00:13:02,690
!ألا... ألا ترين كم أحبّكِ؟

163
00:13:02,690 --> 00:13:05,550
!لهذا أتيتُ لآخذكِ

164
00:13:05,550 --> 00:13:07,340
!الحُكم الفضّي

165
00:13:22,090 --> 00:13:25,780
آنسة إيرزا، تعرفين طريقة للوصول
إلى عالم الدّهليز، أليس كذلك؟

166
00:13:25,780 --> 00:13:27,200
ماذا لو كنتُ كذلك؟

167
00:13:27,590 --> 00:13:31,600
إنّ الشّؤون الشّيطانيّة تندرج تحت
صلاحيّات طاردي أرواح مثلي

168
00:13:31,600 --> 00:13:36,210
لا أستطيع أن أدع ملكيّين أو حتّى
قدّيسين يتورّطون

169
00:13:38,080 --> 00:13:42,840
،فيما يتعلّق بسحر الانتقال الآنيّ الخاصّ بي

170
00:13:42,840 --> 00:13:47,440
فلن أستطيع حمل شخص إضافيّ
غيرك وغير فيليا

171
00:13:47,440 --> 00:13:48,330
!مامون

172
00:13:48,960 --> 00:13:52,300
أنتِ مَدينة لفيليا بحياتك، صحيح؟

173
00:13:52,300 --> 00:13:57,140
تتفهّمين سبب رغبة أحد بإنقاذها، صحيح؟

174
00:13:59,650 --> 00:14:01,580
!إذاً الجواب واضح

175
00:14:01,580 --> 00:14:03,230
!سأذهب لإنقاذ فيليا

176
00:14:03,230 --> 00:14:06,460
!يؤسفني بعدم السّماح لك بذلك، سموّك

177
00:14:06,460 --> 00:14:08,860
—كخادم للقدّيس فيليا، أنا

178
00:14:08,860 --> 00:14:11,160
!لا أستطيع البقاء هنا ببساطة

179
00:14:11,160 --> 00:14:13,420
يجب أن أكون أنا الشّخص
!الّذي ينقذ أختي

180
00:14:13,420 --> 00:14:16,420
من واجبي كخادمة إنقاذ مولاتي

181
00:14:16,420 --> 00:14:17,620
!أريد المُشاركة

182
00:14:17,620 --> 00:14:20,670
!أي خادمة هذه الّتي لا تخدم سيّدتها؟

183
00:14:20,670 --> 00:14:22,920
!خذني معك رجاء

184
00:14:23,720 --> 00:14:25,820
!هـ-هوّنوا علينا

185
00:14:25,820 --> 00:14:29,600
...ليس وكأنّني أمانع وجود فتيات جميلات أمامي

186
00:14:29,600 --> 00:14:30,680
فيليا تتكلّم

187
00:14:32,960 --> 00:14:34,100
هل تسمعونني؟

188
00:14:34,920 --> 00:14:37,890
!تتكلّم فيليا من سِواري

189
00:14:37,890 --> 00:14:44,320
أدرجتُ وظريفة للتّواصل من خلالها عبر
السّحر إذا دعت الحاجة

190
00:14:44,320 --> 00:14:46,260
أختي! هل أنتِ بخير؟

191
00:14:46,260 --> 00:14:47,070
كيف حال جرحك؟

192
00:14:47,070 --> 00:14:48,240
الأمور بخير الآن

193
00:14:48,990 --> 00:14:52,850
أنا آسفة لإثارة قلقكم جميعاً

194
00:14:52,850 --> 00:14:54,490
!يسرّنا أنّكِ بخير فحسب

195
00:14:54,490 --> 00:14:56,830
يمكنكِ العودة إلينا، صحيح؟

196
00:14:58,440 --> 00:14:59,560
آنسة فيليا؟

197
00:15:00,360 --> 00:15:01,960
...الأمير أوزفالت

198
00:15:04,720 --> 00:15:09,280
قد تكون هذه آخر مرّة نتحدّث فيها

199
00:15:09,280 --> 00:15:10,410
ما-ماذا؟

200
00:15:10,410 --> 00:15:11,970
!ما معنى ذلك؟

201
00:15:12,530 --> 00:15:15,970
...قبل أن يسترجع أسموديوس قوّته الكاملة

202
00:15:16,400 --> 00:15:17,680
يجب أن أُدمّره هنا

203
00:15:17,680 --> 00:15:19,340
!لا تفعلي يا أختي

204
00:15:19,340 --> 00:15:23,150
ولا حتّى أنتِ تستطيعين هزيمة
!ذلك الوحش الفظيع

205
00:15:23,500 --> 00:15:25,800
سأبحث عن طريقة يا ميا

206
00:15:26,470 --> 00:15:28,970
إنّه ليس مستحيلاً تماماً

207
00:15:28,970 --> 00:15:30,240
...بالإضافة إلى ذلك

208
00:15:30,940 --> 00:15:34,770
أُمنيتي هي العودة إلى بارناكورتا

209
00:15:35,540 --> 00:15:36,710
...أختي

210
00:15:37,800 --> 00:15:38,730
فيليا

211
00:15:39,490 --> 00:15:40,440
مُعلّم

212
00:15:40,970 --> 00:15:43,440
لدي أسئلة كثيرة لك

213
00:15:44,030 --> 00:15:50,010
لكن أنا مسرورة حقّاً بمعرفة الحقيقة

214
00:15:50,390 --> 00:15:51,290
هكذا إذاً

215
00:15:52,000 --> 00:15:54,260
كبرتِ وغدوتِ قويّة

216
00:15:55,040 --> 00:15:57,890
كانت الأشياء الّتي علّمتِني إيّاها
لا تُقدَّر بثمن

217
00:15:58,690 --> 00:16:00,390
لن أدع ذلك يذهب سُدى

218
00:16:01,560 --> 00:16:02,900
!آنسة فيليا

219
00:16:02,900 --> 00:16:04,270
...الأمير أوزفالت

220
00:16:04,570 --> 00:16:07,150
!أقسم... أقسم بأنّني سوف أنقذك

221
00:16:07,750 --> 00:16:10,810
هل تتذكّرين عرضي لكِ في ذلك اليوم؟

222
00:16:11,780 --> 00:16:13,850
...حالما ينتهي كلّ هذا

223
00:16:14,890 --> 00:16:17,120
هل يمكننا الخروج معاً ثانية؟

224
00:16:17,120 --> 00:16:18,740
لأجل وجبة، هذه المرّة

225
00:16:19,070 --> 00:16:22,470
...سوف ألتزم بكلمتي! لذا

226
00:16:31,210 --> 00:16:32,010
!آنسة إيرزا

227
00:16:32,920 --> 00:16:36,470
!من فضلك، خذيني إلى الآنسة فيليا

228
00:16:36,470 --> 00:16:38,320
ألم أخبرك من قبل؟

229
00:16:38,320 --> 00:16:41,140
لا أستطيع تلبية ذلك الطّلب، حتّى لك

230
00:16:42,240 --> 00:16:44,680
!أتفهّم مُبرّرك

231
00:16:44,680 --> 00:16:49,350
لكن حياة أهمّ شخص في حياتي
!على المحكّ

232
00:16:49,350 --> 00:16:51,690
!لذا لا أستطيع أن أقف مكتوف اليدين

233
00:16:52,540 --> 00:16:54,850
هل فيليا مهمّة جدّاً بالنّسبة لك؟

234
00:16:55,810 --> 00:16:58,200
لدرجة أنّك تهِب حياتك مقابل حياتها؟

235
00:16:58,200 --> 00:16:59,710
!تماماً

236
00:16:59,710 --> 00:17:02,950
!مهما كلّف الأمر، سوف أنقذها

237
00:17:05,760 --> 00:17:06,810
إيرزا

238
00:17:07,330 --> 00:17:09,520
دعيه يذهب من فضلكِ

239
00:17:10,340 --> 00:17:13,780
...أرغب في فعل ذلك بنفسي، لكن

240
00:17:15,260 --> 00:17:19,350
من فضلكِ خذي الأمير أوزفالت بدلاً عنّي

241
00:17:20,000 --> 00:17:21,260
...آنسة ميا

242
00:17:23,640 --> 00:17:26,110
!أؤيّد ذلك أيضاً

243
00:17:26,110 --> 00:17:29,120
الأمير أوزفالت، اذهب وأنقذ القدّيسة فيليا

244
00:17:29,120 --> 00:17:31,890
أعتمد عليك، سموّك

245
00:17:35,190 --> 00:17:36,700
حسناً إن كنتُم مُلحّين

246
00:17:37,080 --> 00:17:39,410
لكن لا يوجد ما يضمن عودتك بالسّلامة

247
00:17:44,480 --> 00:17:46,080
سنغادر إذاً

248
00:17:47,320 --> 00:17:48,780
الأمير أوزفالت

249
00:17:51,640 --> 00:17:54,590
من فضلك، اعتنِ بابنتي

250
00:17:55,040 --> 00:17:56,640
...آنسة هيلديغاردي

251
00:17:58,500 --> 00:18:00,180
اعتمدي عليّ

252
00:18:00,180 --> 00:18:02,470
!أُقسم بأنّني سأعيد الآنسة فيليا

253
00:18:03,350 --> 00:18:05,640
وذلك كي تتمكّن من الاستمرار
!في الابتسام معنا جميعاً

254
00:18:06,840 --> 00:18:07,730
...هكذا إذاً

255
00:18:08,140 --> 00:18:14,110
هذه هي الابتسامة الّتي أذابت
الجليد عن قلب أختي

256
00:18:19,070 --> 00:18:20,570
!الأمير أوزفالت

257
00:18:20,570 --> 00:18:22,900
!سنتعامل مع هؤلاء. بسرعة

258
00:18:22,900 --> 00:18:23,780
!حسناً

259
00:18:41,780 --> 00:18:43,390
لستُ بحاجة له بعد الآن

260
00:18:47,550 --> 00:18:52,900
لن أواصل الاستحواذ على تلك القشرة الهشّة

261
00:18:54,200 --> 00:18:56,480
هذا هو شكلك الحقيقيّ إذاً؟

262
00:18:58,860 --> 00:18:59,920
أجل

263
00:18:59,920 --> 00:19:03,910
مضى أربعة قرون منذ واجهتُك
بهذا الشّكل آخر مرّة

264
00:19:05,240 --> 00:19:06,390
...فيليا

265
00:19:06,390 --> 00:19:09,200
لا، يا روح فيانّا

266
00:19:09,200 --> 00:19:10,860
يسرّني أنّكِ هنا

267
00:19:11,360 --> 00:19:17,510
انتظرتُ أربعمئة عام لألتقي بكِ من جديد

268
00:19:17,510 --> 00:19:21,050
!والآن، دعينا نقضي الوقت معاً للأبد

269
00:19:21,420 --> 00:19:25,470
!حضّرتُ لكِ الجسد المثاليّ

270
00:19:27,540 --> 00:19:32,010
مئتا عام من العمل الحِرفيّ
...بواسطة أجود صانعي الدُّمى

271
00:19:32,010 --> 00:19:36,730
تطلّب إعادة صنع جسد فيانّا جهداً عظيماً

272
00:19:38,550 --> 00:19:41,240
والآن، لنبدأ الطّقوس

273
00:19:41,240 --> 00:19:44,940
،أوّلاً، سأنقل روحكِ إلى مُضيفها الجديد

274
00:19:44,940 --> 00:19:48,870
ثمّ سأستخرج ذكريات فيانّا الموجودة داخلها

275
00:19:52,100 --> 00:19:55,150
أكره استخدام القوّة

276
00:19:55,150 --> 00:19:59,450
كنتُ آمل أن تعرضي روحكِ طوعاً

277
00:20:01,170 --> 00:20:02,140
—ما الّذي

278
00:20:03,160 --> 00:20:07,010
والآن، هل ستنقذين هذا الرّجل أم لا؟

279
00:20:07,010 --> 00:20:09,000
يراودني فضول شديد

280
00:20:09,000 --> 00:20:15,440
شخصيّاً، كنتُ أتمنّى رؤيتكِ
تتخلّين عن خطيبكِ السّابق

281
00:20:15,990 --> 00:20:17,190
أتخلّى عنه؟

282
00:20:17,640 --> 00:20:18,610
أجل

283
00:20:18,610 --> 00:20:23,130
غيرته الجامحة قادته إلى إساءة
مُعاملتك لفترة طويلة

284
00:20:23,130 --> 00:20:26,450
!ثمّ باعكِ كالقمامة

285
00:20:26,450 --> 00:20:30,520
!لن أقبل أن يعاملكِ أحدٌ بتلك الطّريقة

286
00:20:30,520 --> 00:20:34,820
لذا إذا طلبتِ منّي قتله، فسأفعل
ذلك وبكلّ سرور

287
00:20:41,250 --> 00:20:42,820
أستسلم

288
00:20:42,820 --> 00:20:45,090
حرّر الأمير يوليوس

289
00:20:45,430 --> 00:20:48,780
قرّرتِ دون تردُّد؟

290
00:20:49,470 --> 00:20:51,710
...يا لها من قوّة روحيّة ثابتة

291
00:20:51,710 --> 00:20:54,520
هذا ما أتوقّعه منكِ فعليّاً

292
00:20:54,520 --> 00:20:56,680
لن أقاوم

293
00:20:56,680 --> 00:20:59,610
لكن أوّلاً، حرّر الأمير

294
00:20:59,990 --> 00:21:02,980
لا، يجب أن أقيّدكِ أوّلاً

295
00:21:02,980 --> 00:21:06,490
لا أريدكِ أن تنقلي السّحر إلى داخلي ثانية

296
00:21:10,440 --> 00:21:14,120
!فيانّا! أخيراً، سأراك من جديد

297
00:21:36,100 --> 00:21:37,810
!لن أدعك تأخذ الآنسة فيليا

298
00:21:40,160 --> 00:21:42,070
كنتُ قد آمنتُ بالأمير أوزفالت

299
00:21:42,070 --> 00:21:44,740
عرفتُ بأنّك ستأتي

300
00:21:45,100 --> 00:21:48,910
...وإذا كنتَ قد أتيت إلى هنا وبشكل صريح

301
00:21:50,120 --> 00:21:54,380
فالأمل موجود

302
00:23:28,800 --> 00:23:30,720
:الحلقة القادمة، الحلقة 12

303
00:23:32,220 --> 00:23:37,160
القدّيسة المثاليّة جدّاً: رُفِضتُ
بواسطة خطيبي وتمّ بيعي لمملكة أُخرى