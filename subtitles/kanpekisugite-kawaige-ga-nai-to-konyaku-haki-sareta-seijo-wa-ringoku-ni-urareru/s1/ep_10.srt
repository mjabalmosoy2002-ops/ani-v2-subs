1
00:00:00,610 --> 00:00:03,560
!جـ-جـ-جلالتك

2
00:00:03,560 --> 00:00:06,360
!ظـ-ظننتُك طريح الفراش

3
00:00:06,360 --> 00:00:10,510
ميا، دواء أختك مُبهر حقّاً

4
00:00:10,510 --> 00:00:11,820
شكراً لك

5
00:00:11,820 --> 00:00:13,860
!أ-أنت مُخطئ تماماً

6
00:00:14,310 --> 00:00:15,660
لدي تقرير

7
00:00:15,660 --> 00:00:20,370
عثرنا على سُمٍّ في بناء أديناور
مُشابه للسُمّ المُستخدَم هنا

8
00:00:20,370 --> 00:00:23,260
يبدو أنّه تمّ تزويده بواسطة الماركيز بيرز

9
00:00:23,790 --> 00:00:27,130
بيرز. هل لديك ما تقوله للدّفاع عن نفسك؟

10
00:00:27,870 --> 00:00:31,010
لـ-لا يا سيّدي

11
00:00:31,360 --> 00:00:32,370
حسناً

12
00:00:32,870 --> 00:00:36,670
اعتقلوا الماركيز والماركيز أديناور
وكذلك الماركيز بيرز

13
00:00:36,670 --> 00:00:40,390
!وأيّ شخص آخر مُتورّط في هذه المُؤامرة حالاً

14
00:00:40,690 --> 00:00:45,230
وهذا ينطبق على كلّ شخص أهمل
واجباته في غيابي

15
00:00:45,510 --> 00:00:51,980
تلقّيتُ بالفعل شهادات ووثائق تُثبت
،سوء صنيعكم

16
00:00:51,980 --> 00:00:54,360
!بما في ذلك مُحاولة اغتيالي

17
00:00:54,870 --> 00:00:57,970
هل تفهم ما يعنيه هذا يا بيرز؟

18
00:00:59,170 --> 00:00:59,910
...أنت

19
00:01:00,350 --> 00:01:05,160
توسّل ابنك إليّ أن أوقفك

20
00:01:06,070 --> 00:01:07,890
...بالنّسبة لك يا يوليوس

21
00:01:08,540 --> 00:01:09,670
!أ-أبي

22
00:01:09,670 --> 00:01:15,090
رأيتُ سلوكك الشّنيع، بما في ذلك
مُحاولتك قتل أخيك

23
00:01:15,090 --> 00:01:16,890
!أ-أبي

24
00:01:16,890 --> 00:01:18,070
خذوه

25
00:01:18,070 --> 00:01:18,720
!حاضر

26
00:01:18,720 --> 00:01:21,940
!توقّفوا! أفلتوني

27
00:01:19,160 --> 00:01:23,350
وهكذا انتهت فوضى يوليوس

28
00:01:23,350 --> 00:01:28,230
الأساس لمُواجهة الوحوش تحت
قيادة الملك قد مُهِّدَتْ أخيراً

29
00:01:30,890 --> 00:01:33,960
المعركة لأجل وجود غيرتونيا بحدّ ذاتها

30
00:01:34,840 --> 00:01:36,380
على وشك أن تبدأ

31
00:03:07,500 --> 00:03:12,710
أبلغتْ هيماري عن أنّ فُرساننا سُمّح
لهم بالدّخول إلى غيرتونيا

32
00:03:12,710 --> 00:03:15,790
أنا متأكّد بأنّهم يُقاتلون الوحوش الآن

33
00:03:15,790 --> 00:03:18,910
صحيح أنّ هذا التّأخير كان انتكاسة كبيرة

34
00:03:18,910 --> 00:03:20,510
آمل أن يفعلوها في الوقت

35
00:03:20,830 --> 00:03:21,970
فيليا

36
00:03:23,130 --> 00:03:24,890
ينبغي أن تُحضّري نفسكِ

37
00:03:24,890 --> 00:03:27,830
—أخي، ما الّذي

38
00:03:27,090 --> 00:03:29,100
!القدّيسة فيليا

39
00:03:29,100 --> 00:03:31,060
!عُدت

40
00:03:31,520 --> 00:03:34,360
غريس. أهلاً بعودتكِ

41
00:03:34,820 --> 00:03:36,940
فكرتكِ نجحتْ يا قدّيسة فيليا

42
00:03:36,940 --> 00:03:42,780
جعلتُ الأمر بحيث يمكنكِ استخدام هذه
الجوهرة لجمع مانا منّي وأخواتي الثّلاثة

43
00:03:43,240 --> 00:03:44,910
شكراً لكِ

44
00:03:45,530 --> 00:03:49,130
الطّقس القديم المعروف بأنّه
تعويذة تحويل السّحر

45
00:03:49,130 --> 00:03:53,420
يركّز القوّة السّحريّة للعديد من الأشخاص
داخل حجر سحريّ

46
00:03:53,420 --> 00:03:58,450
ويُشبع مَن يضعه بذلك السّحر

47
00:03:58,450 --> 00:04:01,800
ويسمح ذلك لهم اصطناعيّاً
بتحمُّل قوّة هائلة

48
00:04:01,800 --> 00:04:05,190
غريس، مهما شكرتُكِ لا أوفيكِ
حقّكِ على ما فعلتِه

49
00:04:05,190 --> 00:04:07,260
!لا داعي لشكري إطلاقاً

50
00:04:07,870 --> 00:04:11,390
!والآن، يا قدّيسة فيليا، اجمعي سحرنا معاً

51
00:04:11,840 --> 00:04:14,010
أجل، فلنبدأ

52
00:04:14,960 --> 00:04:17,770
سأوسّع دائرة التّطهير العظيمة لتشمل القارّة

53
00:04:21,240 --> 00:04:22,710
!هذه هي

54
00:04:22,710 --> 00:04:26,230
!أريني ما يمكنكِ فعله يا فيليا أديناور

55
00:04:31,680 --> 00:04:32,750
...هذه

56
00:04:40,270 --> 00:04:42,070
المانا تتألّق؟

57
00:04:42,070 --> 00:04:44,010
!هذا أكثر إشراقاً بكثير من المرّة السّابقة

58
00:04:44,710 --> 00:04:48,240
ببلوغ القوّة السّحريّة لخمسة أشخاص
...حدودها، هذه المرّة

59
00:04:49,050 --> 00:04:49,850
!ها أنا ذي

60
00:04:55,000 --> 00:04:57,400
!القدّيسة فيليا! هذا مُدهش

61
00:04:57,400 --> 00:04:59,150
!إنّها تتوسّع فعلاً

62
00:04:59,150 --> 00:05:01,320
حـ-حقّاً؟

63
00:05:01,320 --> 00:05:05,660
!قوّتها التّطهيريّة تقترب من بولميرن

64
00:05:05,660 --> 00:05:07,360
!أنا متأكّدة من ذلك

65
00:05:10,130 --> 00:05:13,040
!القدّيسة فيليا! تهانينا

66
00:05:13,040 --> 00:05:15,760
هل نجت غيرتونيا الآن أيضاً؟

67
00:05:17,260 --> 00:05:19,000
...لا، مع الأسف

68
00:05:19,360 --> 00:05:20,570
فشلتِ؟

69
00:05:22,340 --> 00:05:24,160
ماذا تقصدين؟

70
00:05:24,160 --> 00:05:27,510
الدّائرة لم تُغطِّ سوى النّصف الغربيّ من القارّة

71
00:05:27,900 --> 00:05:32,310
لم يُنقَل السّحر كما ينبغي نحو غيرتونيا

72
00:05:32,720 --> 00:05:33,960
...تقصدين

73
00:05:33,960 --> 00:05:36,520
قوّتنا السّحريّة لم تكن كافية؟

74
00:05:36,870 --> 00:05:39,830
لا، كانت أكثر من كافية

75
00:05:39,830 --> 00:05:44,490
لكن المانا في الشّرق مُشوّشة أكثر
بكثير ممّا توقّعت

76
00:05:44,490 --> 00:05:47,610
منعتْ توسُّعَ الدّائرة

77
00:05:48,330 --> 00:05:52,120
فشلت

78
00:05:52,840 --> 00:05:53,830
ماذا أفعل؟

79
00:05:54,360 --> 00:05:57,340
كان من المُفترض أن تكون هذه
...الطّريقة الأفضل لمُساعدتهم

80
00:05:57,340 --> 00:06:01,000
أريد إنقاذ ميا، ومع ذلك... كلّ
...ثانية محسوبة، ورغم هذا

81
00:06:01,640 --> 00:06:07,090
الطّريقة الوحيدة الآن... يجب عليّ نصب
...عمود من النّور في غيرتونيا بنفسي

82
00:06:08,480 --> 00:06:09,510
...لكن

83
00:06:09,780 --> 00:06:11,970
،إذا غادرتِ العاصمة

84
00:06:11,970 --> 00:06:15,040
فستنهار دائرة التّطهير العظيمة، صحيح؟

85
00:06:15,040 --> 00:06:17,390
هذا فظيع! أما من طريقة أُخرى؟

86
00:06:18,720 --> 00:06:19,700
!غريس

87
00:06:19,700 --> 00:06:20,850
نـ-نعم؟

88
00:06:20,850 --> 00:06:24,830
قوّتنا السّحريّة مُتّصلة الآن

89
00:06:24,830 --> 00:06:27,530
،إذا تولّيتِ الأمور في المركز لبعض الوقت

90
00:06:28,110 --> 00:06:30,950
...فسأتمكّن من المُغادرة بمفردي

91
00:06:31,830 --> 00:06:36,410
لكن لن يكون هذا تصرُّفاً
لائقاً من قدّيسة بارناكورتا

92
00:06:36,800 --> 00:06:37,960
!القدّيسة فيليا

93
00:06:37,960 --> 00:06:39,560
!يجب أن تذهبي

94
00:06:39,560 --> 00:06:41,330
!دعيني أتولّى الأمور هنا

95
00:06:41,330 --> 00:06:44,420
،أجل، إذا كنتِ تستطيعين الذّهاب
!فلا سبب يمنعكِ من ذلك

96
00:06:44,750 --> 00:06:47,630
...غريس... الأمير أوزفالت

97
00:06:47,630 --> 00:06:50,660
لا، لا أسمح لكِ بالمُغادرة

98
00:06:50,660 --> 00:06:51,760
...أخي

99
00:06:51,760 --> 00:06:54,220
أعلم بأنّك ذكيّ بما يكفي لفهم السّبب

100
00:06:54,790 --> 00:06:59,610
لا أسمح بقدّيسة من بارناكورتا بالتدخُّل
في أزمة مملكة أُخرى

101
00:06:59,610 --> 00:07:03,100
وتعريض نفسها لخطر أثناء ذلك

102
00:07:04,410 --> 00:07:08,610
،ونظراً لفشل توسُّع دائرة التّطهير العظيمة

103
00:07:08,610 --> 00:07:11,910
سيترتّب عليّ سحب فُرساننا
عندما يحين الوقت كذلك

104
00:07:11,910 --> 00:07:13,400
—لكن يا أخي

105
00:07:14,170 --> 00:07:17,120
أتعاطف مع مملكة غيرتونيا بخصوص
،الورطة الّتي وقعتْ فيها

106
00:07:17,120 --> 00:07:20,640
وأعي بأنّ فيليا تشعر بالتزام تجاه أختها

107
00:07:20,640 --> 00:07:24,120
،لكن حتّى لو كان هذا يعني امتعاضك منّي

108
00:07:24,120 --> 00:07:26,380
يجب أن أتصرّف بما يصبُّ في صالح مملكتي

109
00:07:26,380 --> 00:07:29,740
وأضع الأولويّة لسلامة ومُستقبل شعبنا

110
00:07:29,740 --> 00:07:33,890
لذل، يجب أن آمرك بالتخلّي عن الفركة

111
00:07:33,890 --> 00:07:36,400
أتّفق مع الأمير

112
00:07:36,400 --> 00:07:38,220
!مهلاً يا أختي الكبرى

113
00:07:38,220 --> 00:07:41,540
حتّى لو حاولتِ الذّهاب الآن، سيكون
الأوان قد فات

114
00:07:41,540 --> 00:07:45,650
وستُسحَق غيرتونيا بواسطة قوّة
عالم الشّيطان

115
00:07:46,000 --> 00:07:50,980
إعادة ولادة كبير الشّياطين أسموديوس
أمر حتميّ

116
00:07:50,980 --> 00:07:54,620
لا يمكننا أن ندعك تقحمين
نفسكِ في وضع كهذا

117
00:07:54,620 --> 00:08:02,000
يستهدف أسموديوس روح القدّيسة الأسطوريّة
الّتي تسكن بداخلك في النّهاية

118
00:08:02,250 --> 00:08:04,080
...يا آنسة عُظمى

119
00:08:04,080 --> 00:08:06,380
بالأحرى، فيليا أديناور

120
00:08:06,750 --> 00:08:11,110
إذا فقدناك، ستتحطّم دائرة التّطهير العظيمة

121
00:08:11,110 --> 00:08:14,680
وسيسقط العالم بأسره في قبضة
عالم الشّياطين فوراً

122
00:08:15,760 --> 00:08:17,650
كنتُ أعي ذلك

123
00:08:18,450 --> 00:08:21,330
مسار الأفعال الّتي اقترحتُها كانت ستعني

124
00:08:21,330 --> 00:08:24,690
التخلّي عن مركزي كقدّيسة بارناكورتا

125
00:08:25,240 --> 00:08:28,610
...لكن... لكن إن لم أفعلها، ميا سوف

126
00:08:28,610 --> 00:08:29,980
!آنسة فيليا

127
00:08:30,630 --> 00:08:32,060
الأمير أوزفالت؟

128
00:08:33,520 --> 00:08:37,390
.لا تتحمّلي هذا العبء بمفردكِ
ألقي نظرة حولك

129
00:08:37,390 --> 00:08:38,430
أتتذكّرين ما قلتُه؟

130
00:08:39,100 --> 00:08:40,740
وأخبركِ أبي أيضاً

131
00:08:41,200 --> 00:08:44,790
أنصحكِ بأن تصبحي أكثر أنانيّة

132
00:08:46,790 --> 00:08:48,420
ما الّذي تريدين فعله يا آنسة فيليا؟

133
00:08:49,040 --> 00:08:52,390
الصّواب أو الخطأ ليسا مُهمّين الآن

134
00:08:53,130 --> 00:08:56,510
ابحثي في أعماقكِ وأخبريني بما تريدينه حقّاً

135
00:08:57,210 --> 00:09:00,930
أعرف بالضّبط ما أُريد

136
00:09:02,100 --> 00:09:04,000
أريد إنقاذ ميا

137
00:09:04,000 --> 00:09:06,850
!أريد... أريد إنقاذ أُختي فحسب

138
00:09:09,390 --> 00:09:10,070
...ميا

139
00:09:10,650 --> 00:09:12,430
!أريد إنقاذ ميا

140
00:09:12,430 --> 00:09:14,470
!لا أُبالي لما يحدث لي

141
00:09:14,470 --> 00:09:16,450
!أريد إنقاذ أختي

142
00:09:19,170 --> 00:09:20,220
!لكِ ذلك

143
00:09:20,220 --> 00:09:21,780
!سأُوصلكِ إلى حيث تريدين الذّهاب

144
00:09:22,640 --> 00:09:27,000
انتظر لحظة! هل تدرك ما أنت
!على وشك أن تفعله؟

145
00:09:27,000 --> 00:09:29,380
!كأنّك ذاهب لِلقاء حتفك

146
00:09:30,360 --> 00:09:31,250
...أخي

147
00:09:31,250 --> 00:09:35,130
!هل يُفترض أن أخسر أخي هذه المرّة؟

148
00:09:35,130 --> 00:09:36,470
!بالطّبع لا

149
00:09:37,010 --> 00:09:38,890
!سأذهب وذلك كي لا تضطرّ لخسارة أحد

150
00:09:42,770 --> 00:09:43,810
الوقت يُداهمنا

151
00:09:43,810 --> 00:09:44,550
آنسة فيليا؟

152
00:09:44,550 --> 00:09:45,710
!حسناً

153
00:09:45,710 --> 00:09:47,220
—غريس، من فضلك

154
00:09:47,220 --> 00:09:48,600
!اعتمدي عليّ

155
00:09:50,260 --> 00:09:51,280
!أخي

156
00:09:50,260 --> 00:09:51,280
!سموّك

157
00:09:52,230 --> 00:09:54,150
!سوف نعود

158
00:09:59,080 --> 00:10:01,120
أتعتقدين بأنّنا ينبغي أن نوقفهم؟

159
00:10:01,660 --> 00:10:05,000
يبدون عاقدي العزم. لا أدري ما إن كنّا نستطيع

160
00:10:05,320 --> 00:10:07,660
،فُرصتهم شبه معدومة

161
00:10:08,240 --> 00:10:11,290
لكن لنأمل فحسب أن ينقذوا غيرتونيا

162
00:10:13,270 --> 00:10:16,500
آنسة فيليا، تمسّكي جيّداً

163
00:10:16,500 --> 00:10:17,220
حسناً

164
00:10:18,720 --> 00:10:19,960
...إلى الأمام

165
00:10:19,960 --> 00:10:21,260
!إلى غيرتونيا

166
00:10:28,510 --> 00:10:31,520
!لن أدعكم تمسّون الآنسة ميا بضرّ

167
00:10:34,570 --> 00:10:38,080
أنا لا أفعل أكثر من مُجرّد
...إكسابنا الوقت، لكن

168
00:10:39,050 --> 00:10:40,680
—جيّد. التّالي

169
00:10:48,800 --> 00:10:51,030
!إلى كافّة القوّات، هجوم

170
00:10:55,050 --> 00:10:57,300
!وصلَ فُرسان بارناكورتا

171
00:10:59,360 --> 00:11:01,050
هذا من صنيع أختي

172
00:11:01,050 --> 00:11:04,130
وثِقَتْ بأنّني سأقلب الموازين

173
00:11:04,130 --> 00:11:07,430
!وأرسلتْ هذا بالنّيابة عنّي

174
00:11:08,240 --> 00:11:10,070
—حسناً! حاجزي التّالي سوف

175
00:11:24,640 --> 00:11:25,830
هذا غير مُمكن

176
00:11:27,440 --> 00:11:32,330
أشعر بأنّ عدداً هائلاً من الوحوش
قادم من غابة الظّلام

177
00:11:32,720 --> 00:11:34,420
!ميا! لا تذهبي

178
00:11:34,880 --> 00:11:35,750
...مـ-مهلاً

179
00:11:36,580 --> 00:11:37,640
هل ينبغي أن نهرب فحسب؟

180
00:11:37,640 --> 00:11:40,010
!أحمق! لا يوجد مفرّ

181
00:11:40,740 --> 00:11:43,240
نهرب؟ إلى أين؟

182
00:11:43,240 --> 00:11:45,260
إلى بارناكورتا، حيث أختي؟

183
00:11:46,010 --> 00:11:50,350
أجل... هذه فكرة جيّدة، أليس كذلك؟

184
00:11:52,190 --> 00:11:56,820
إذا بدا أنّ مكروهاً سيُصيبها، خُذيها واهربا

185
00:11:57,830 --> 00:11:59,470
أهذه هي تلك اللّحظة؟

186
00:12:17,430 --> 00:12:19,550
...ما الّذي قد

187
00:12:21,180 --> 00:12:22,050
!آنسة ميا

188
00:12:23,090 --> 00:12:26,470
،يمكنني التخلّي عن قداستي، وعن كلّ شيء

189
00:12:26,470 --> 00:12:28,440
،وأنضمّ لأختي في المملكة المُجاورة

190
00:12:28,440 --> 00:12:31,130
!وأنسى كلّ شيء، وأبدأ من جديد

191
00:12:31,130 --> 00:12:34,050
!كم سيكون ذلك رائعاً

192
00:12:34,810 --> 00:12:39,430
أنا متأكّدة بأنّها وكافّة أصدقائها
الجدُد سوف يُرحّبون بي

193
00:12:39,430 --> 00:12:42,460
سنقضي وقتاً جميلاً معاً

194
00:12:44,170 --> 00:12:47,610
!الحُكم الفضّي

195
00:12:48,660 --> 00:12:50,600
!اتبعوا القدّيسة

196
00:12:53,430 --> 00:12:57,250
...لكن كلّ تلك السّعادة

197
00:12:57,730 --> 00:13:00,150
كيف لي أن أتحمّلها؟

198
00:13:00,830 --> 00:13:05,010
...فأساساً، الشّخص

199
00:13:05,760 --> 00:13:07,490
...الّذي لا يستحقّ تلك السّعادة

200
00:13:08,630 --> 00:13:10,640
!هي أنا

201
00:13:12,120 --> 00:13:13,150
بيير

202
00:13:13,150 --> 00:13:16,170
إن لَزِم الأمر، افعل ما يلزم لإيقاف ميا

203
00:13:16,170 --> 00:13:17,730
ماذا تقصد؟

204
00:13:18,310 --> 00:13:22,030
إنّها تكره نفسها

205
00:13:23,190 --> 00:13:27,270
،نتيجة اليأس ممّا تعرّضتْ له أختها العزيزة

206
00:13:27,270 --> 00:13:30,660
أقسمَتِ الثّأر من جميع المسؤولين

207
00:13:31,440 --> 00:13:32,950
...ما يعني

208
00:13:35,700 --> 00:13:36,710
!القدّيسة ميا

209
00:13:38,400 --> 00:13:41,420
وذلك يشملها

210
00:13:42,670 --> 00:13:45,590
أنا آسفة يا أختي

211
00:13:46,520 --> 00:13:53,560
ستستخدم تحقيق إنجازاتها القدسيّة لمُعاقبة نفسها

212
00:13:54,140 --> 00:13:57,230
!سيكون هذا اليوم الّذي أموت فيه

213
00:13:59,100 --> 00:14:02,840
إذا سلكنا هذا الطّريق، فسوف
نصل إلى هضبة

214
00:14:02,840 --> 00:14:06,690
سأبني عموداً هناك وأوسّع
دائرة التّطهير العظيمة

215
00:14:06,690 --> 00:14:07,400
عُلِم

216
00:14:07,920 --> 00:14:10,320
!ميا، آمل أن أصل في الوقت

217
00:14:10,320 --> 00:14:13,660
!الحُكم الفضّي

218
00:14:19,280 --> 00:14:21,000
نفد السّحر لديّ

219
00:14:21,520 --> 00:14:25,630
القدّيس بلا سحر هو مُجرّد عقبة

220
00:14:26,280 --> 00:14:30,200
لكن إذا نفد لديّ، فيمكنني صنع المزيد

221
00:14:30,200 --> 00:14:34,400
سأحرق طاقة الحياة خاصّتي
وأحوّلها إلى سحر

222
00:14:34,400 --> 00:14:36,020
إنّها تقنيّة مُحرّمة

223
00:14:36,520 --> 00:14:41,020
لكن سيدعني أحمي أكبر قدر
...مُمكن من النّاس

224
00:14:41,930 --> 00:14:43,650
لا أُمانع

225
00:14:44,590 --> 00:14:48,530
!سهم الحُكم

226
00:14:49,150 --> 00:14:51,340
!ارحلوا! ارحلوا! ارحلوا

227
00:14:51,340 --> 00:14:53,570
!ارحلوا، ارحلوا، ارحلوا، ارحلوا، ارحلوا

228
00:14:53,570 --> 00:14:55,020
!ارحلوا

229
00:14:55,020 --> 00:14:56,630
...ا-القدّيسة ميا

230
00:14:57,330 --> 00:14:58,760
هذا سيّئ

231
00:14:58,760 --> 00:15:01,520
!لا نتحمّل فقدانها الآن

232
00:15:01,520 --> 00:15:03,160
!احموا القدّيسة ميا

233
00:15:03,160 --> 00:15:05,650
!احموا مملكة غيرتونيا

234
00:15:08,640 --> 00:15:13,260
أنا مسرورة جدّاً... استطعتُ التصرّف
...كقدّيسة مرّة أخيرة

235
00:15:21,630 --> 00:15:23,580
هل انتهى الأمر الآن؟

236
00:15:29,520 --> 00:15:32,860
المكان مُظلم. أشعر بالبرد

237
00:15:32,860 --> 00:15:35,830
ويغلبني النّعاس

238
00:15:37,100 --> 00:15:39,060
بذلتُ جهداً كبيراً حقّاً

239
00:15:39,840 --> 00:15:42,120
أظنّني اكتسبتُ بعض الرّاحة الآن

240
00:15:47,420 --> 00:15:48,360
ميا

241
00:15:49,520 --> 00:15:52,590
أحدهم يُناديني؟

242
00:15:53,590 --> 00:15:54,590
!ميا

243
00:15:57,170 --> 00:16:00,850
!إنّها أختي

244
00:16:00,850 --> 00:16:02,860
!أتتْ لأجلي

245
00:16:02,860 --> 00:16:05,860
سنكون بأمان الآن

246
00:16:07,900 --> 00:16:11,240
!القدّيسة ميا! القدّيسة ميا

247
00:16:11,240 --> 00:16:15,320
!الحُكم الفضّي

248
00:16:23,840 --> 00:16:24,870
!ميا

249
00:16:26,160 --> 00:16:28,880
رأيت؟ كما توقّعت

250
00:16:31,990 --> 00:16:33,480
...في نهاية المطاف، أختي

251
00:16:37,340 --> 00:16:40,400
هي بطلتي

252
00:16:42,420 --> 00:16:44,420
!تمّ إضعاف الوحوش

253
00:16:44,420 --> 00:16:46,270
!انتهزوا هذه الفُرصة قتلهم جميعاً

254
00:16:49,120 --> 00:16:51,030
!القدّيسة فيليا

255
00:16:51,460 --> 00:16:53,430
!الأمير أوزفالت

256
00:16:53,430 --> 00:16:55,030
!أين أنت؟

257
00:16:55,750 --> 00:16:58,030
آنسة لينا؟ سيّد ليوناردو؟

258
00:16:58,940 --> 00:17:00,410
!شِفاء القدّيسة

259
00:17:01,730 --> 00:17:02,410
كيف يبدو الأمر؟

260
00:17:03,060 --> 00:17:05,830
!سوف أنقذها. أقسم بأنّني سأفعل

261
00:17:07,070 --> 00:17:09,040
نبضات قلبها تنحسر

262
00:17:09,330 --> 00:17:11,610
...سأعدّل دورتها الدّمويّة

263
00:17:11,610 --> 00:17:13,140
!شِفاء القدّيسة

264
00:17:15,100 --> 00:17:17,590
!استيقظي يا ميا

265
00:17:17,910 --> 00:17:19,470
شُفيت جروحها

266
00:17:19,470 --> 00:17:22,600
يعزو البقاء قويّة لها الآن

267
00:17:23,530 --> 00:17:26,270
أنا خائفة. لا أنفك أرتجف

268
00:17:26,850 --> 00:17:30,360
ماذا لو لم تستيقظ؟

269
00:17:34,210 --> 00:17:35,610
آنسة فيليا

270
00:17:39,890 --> 00:17:42,300
لا حاجة للقلق. لن أستسلم

271
00:17:43,230 --> 00:17:45,620
...سوف أنقذكِ يا ميا

272
00:17:46,170 --> 00:17:49,830
!لأنّني أختكِ الكبرى

273
00:17:50,880 --> 00:17:52,380
...شفاء

274
00:17:52,380 --> 00:17:54,330
!القدّيسة

275
00:17:59,550 --> 00:18:00,390
...أ

276
00:18:02,370 --> 00:18:03,520
ميا؟

277
00:18:03,520 --> 00:18:06,010
...أ-أختي

278
00:18:11,910 --> 00:18:13,700
...مـ-ميا

279
00:18:14,380 --> 00:18:16,620
يسرّني أنّكِ بخير

280
00:18:17,790 --> 00:18:19,410
...دافئ للغاية

281
00:18:22,970 --> 00:18:25,910
ظننتُ بأنّني لن أراكِ ثانية أبداً

282
00:18:26,470 --> 00:18:31,990
لأنّكِ عازمة جدّاً على أداء
،واجباتكِ القدّيسيّة

283
00:18:32,670 --> 00:18:34,420
لم أتوقّع أن تعودي

284
00:18:34,860 --> 00:18:36,360
معكِ حقّ

285
00:18:36,360 --> 00:18:39,400
لكنّني لا أتصرّف كقدّيسة الآن

286
00:18:39,400 --> 00:18:43,180
أتصرّف كأخت لكِ، لذا لا أستطيع التخلّي عنكِ

287
00:18:43,630 --> 00:18:48,940
،حتّى لو لم يكن القرار الصّائب
كان يترتّب علي إنقاذكِ

288
00:18:50,990 --> 00:18:52,440
...أنا

289
00:18:52,440 --> 00:18:55,400
،عندما غادرتِ إلى بارناكورتا

290
00:18:55,400 --> 00:19:00,200
كنتُ حزينة جدّاً ووحيدة، وظننتُ
بأنّني قد أفقد عقلي

291
00:19:01,050 --> 00:19:03,700
...لكن الأهمّ من كلّ ذلك، كنتُ غاضبة

292
00:19:04,180 --> 00:19:07,290
من جميع الّذين استغلّوكِ

293
00:19:07,820 --> 00:19:10,620
أردتُ الانتقام منهم

294
00:19:11,920 --> 00:19:16,300
أختي، آسفة لأنّني لم أدرِك ذلك مُسبقاً

295
00:19:21,590 --> 00:19:25,160
شكراً لكِ على الغضب بالنّيابة عنّي

296
00:19:26,900 --> 00:19:31,180
لم يكن أحد ليستطيع إنقاذ هذه المملكة غيركِ

297
00:19:31,790 --> 00:19:35,350
أنتِ قدّيسة حقيقيّة الآن يا ميا

298
00:19:39,040 --> 00:19:40,680
...فيليا

299
00:19:46,230 --> 00:19:47,620
أختي

300
00:19:47,620 --> 00:19:50,840
أعتقد كنّا مُحقّين بشأن عدم
منعها من القدوم، صحيح؟

301
00:19:50,840 --> 00:19:53,540
...حالفها الحظُّ فحسب. يا للعجب

302
00:20:02,370 --> 00:20:04,380
!الأمير يوليوس قد هرب؟

303
00:20:04,380 --> 00:20:07,040
!لا يمكن أن يكون قد ابتعد كثيراً! جِدوه

304
00:20:10,400 --> 00:20:12,670
!تـ-تـ-تبّاً

305
00:20:12,670 --> 00:20:15,510
!لن أسمح بأن تكون هذه هي النّهاية

306
00:20:15,510 --> 00:20:18,780
...إذا استطعتُ الحصول على القوّة فحسب

307
00:20:20,070 --> 00:20:21,700
أهذه هي؟

308
00:20:21,700 --> 00:20:23,970
...انتظري فحسب يا ميا

309
00:20:23,970 --> 00:20:28,830
سأريكِ ما الّذي يحدث لأولئك
!الّذين يخونونني

310
00:20:29,220 --> 00:20:33,490
!والآن مُدّني بالقوّة

311
00:20:33,490 --> 00:20:35,710
،أحسنت صنعاً

312
00:20:35,710 --> 00:20:38,670
!يا أمير غيرتونيا

313
00:20:45,430 --> 00:20:49,810
لم أتوقّع أبداً أن أعود إلى هنا ثانية

314
00:20:49,810 --> 00:20:53,690
آنسة فيليا، تمكنّا من تجنُّب أسوأ سيناريو

315
00:20:53,690 --> 00:20:56,280
أجل، بالفعل

316
00:20:56,280 --> 00:20:58,690
لكن بفضل مُساعدتك فقط يا سعادة
الأمير أوزفالت

317
00:20:58,690 --> 00:21:00,340
!إطلاقاً

318
00:21:00,340 --> 00:21:02,030
لم أفعل شيئاً

319
00:21:02,030 --> 00:21:03,710
أنتِ المُذهلة يا آنسة فيليا

320
00:21:03,710 --> 00:21:05,590
أبداً

321
00:21:05,590 --> 00:21:09,370
ما كنتُ لأصل إلى هنا لولا تشجيعك

322
00:21:10,240 --> 00:21:15,070
لم أركِ ودودة مع رجل هكذا من قبل

323
00:21:15,850 --> 00:21:19,040
!لم أتوقّع أن تجدي حبيباً هناك

324
00:21:19,360 --> 00:21:20,490
!حبيب؟

325
00:21:20,980 --> 00:21:23,790
ميا، لا تُثيري مثل هذه الأمور

326
00:21:23,790 --> 00:21:26,160
أنتِ تُزعجين الأمير أوزفالت

327
00:21:26,160 --> 00:21:29,050
...لا، لا أعتبر هذا إزعاجاً من ناحية

328
00:21:30,940 --> 00:21:33,810
مع الأسف. أحبّه أكثر من أميرنا البغيض

329
00:21:34,530 --> 00:21:37,310
!لكن يسرّني أنّكِ تبدين سعيدة فحسب

330
00:21:38,170 --> 00:21:39,080
...ميا

331
00:21:42,510 --> 00:21:43,820
!جلالتك! سموّك

332
00:21:47,400 --> 00:21:51,580
مرحباً يا فيليا، يا قدري

333
00:21:52,940 --> 00:21:54,950
التقينا من جديد

334
00:23:26,870 --> 00:23:32,630
القدّيسة المثاليّة جدّاً: رُفِضتُ
بواسطة خطيبي وتمّ بيعي لمملكة أُخرى

335
00:23:33,370 --> 00:23:35,620
:الحلقة القادمة، الحلقة 11

336
00:23:36,120 --> 00:23:37,990
"كبير الشّياطين أسموديوس"