1
00:00:23,980 --> 00:00:26,260
...إنِّي أُختَبر

2
00:00:46,540 --> 00:00:48,660
!هيَّا! ادفعا! ادفعا

3
00:00:56,080 --> 00:00:58,380
نعتذر من هذا أيُّها القائد

4
00:00:58,380 --> 00:00:59,100
نتفهَّم ذلك

5
00:00:59,200 --> 00:01:00,580
!لندفع معًا

6
00:01:11,720 --> 00:01:12,680
!هيَّا

7
00:01:31,280 --> 00:01:32,100
!جيد

8
00:01:35,860 --> 00:01:38,520
هذا القيظُ هاهنا لا يُحتمل

9
00:01:38,520 --> 00:01:42,460
أنا مستعدٌّ للتَّضحية بأصابعي
مقابل وعاءٍ من البرتقال البارد

10
00:01:42,530 --> 00:01:44,300
لا تفكر في هذا يا بطليموس

11
00:01:44,400 --> 00:01:45,100
ماذا؟

12
00:01:45,160 --> 00:01:48,160
لن تقدر على تقشير البرتقال إن فقدتَ أصابعك

13
00:01:50,410 --> 00:01:51,300
!هيَّا

14
00:01:56,080 --> 00:02:00,920
تُختبر روحي وأُختَبر ملكًا وبشرًا

15
00:02:14,440 --> 00:02:15,580
!جلالة الملك

16
00:02:17,800 --> 00:02:20,160
!نحن مستعدُّون لقيادة الجيوش الآن

17
00:02:20,330 --> 00:02:22,760
لنعبر الوادي ما دامت الشمس في كبدِ السماء

18
00:02:27,230 --> 00:02:28,030
!هيَّا

19
00:02:35,120 --> 00:02:38,560
ولو عبرنا هذا الوادي، فسنلقى واديًا آخر بعده

20
00:02:39,070 --> 00:02:40,720
هذه طبيعةُ آسيا

21
00:02:41,650 --> 00:02:44,400
اعذرني يا جلالة الملك، لكن
ألم ينل التَّعب منك بعد يا مولاي؟

22
00:02:44,430 --> 00:02:48,360
لم تذق الرَّاحة ولا طعم النَّوم
منذ ما يزيد على أسبوعَين

23
00:02:49,200 --> 00:02:52,680
ولكنِّي حظيتُ بميزة امتطاء بوسيفالوس

24
00:02:52,780 --> 00:02:56,030
لا يُقارن إرهاقي بإرهاق الآخرين
السائرين على أقدامهم

25
00:03:04,250 --> 00:03:08,980
لن نستسلم -أنا وأنت- في هذه المهمَّة
ولا في هذا المسير يا رفيقي الوفيَّ بوسيفالوس

26
00:03:10,380 --> 00:03:13,660
،لو آثرتُ الاستسلام والتخلِّي عن هؤلاء الجنود

27
00:03:13,700 --> 00:03:19,930
لما بلغ إرثي يومًا مبلغ أشجع أجدادي، أخيل

28
00:03:30,010 --> 00:03:31,290
!انتبهوا، ثمة صخورٌ متساقطة

29
00:03:36,000 --> 00:03:43,360
تربَّع الملك الشاب، أسد مقدونيا الإسكندر، على
العرش في عام 336 قبل الميلاد وقد ناهز العشرين من عمره

30
00:03:43,430 --> 00:03:49,160
،لتحرير قارَّة آسيا من حكم الفُرس الجائر
توجَّهت قوَّات الإسكندر إلى الشرق

31
00:03:49,630 --> 00:03:55,240
لكنَّ الرحلة الطويلة كانت مليئةً بالمخاطر
...والجوع والعطش وكثيرٍ من المعاناة

32
00:04:02,810 --> 00:04:03,700
ماذا؟

33
00:04:03,720 --> 00:04:05,430
!جلالة الملك

34
00:04:07,000 --> 00:04:09,310
هدِّئ من روعك، أنت مصابٌ
ولا شغل لك الآن سوى الرَّاحة

35
00:04:11,990 --> 00:04:12,760
هل تتألَّم؟

36
00:04:12,910 --> 00:04:16,760
أصبحتُ بحالٍ أفضل الآن
يا جلالة الملك، شكرًا لك

37
00:04:26,800 --> 00:04:28,280
أكان صديقك؟

38
00:04:28,400 --> 00:04:29,570
أجل، منذ نعومة أظفاري

39
00:04:29,570 --> 00:04:30,800
أكان صديقك صالحًا؟

40
00:04:30,800 --> 00:04:31,840
بكلِّ تأكيد

41
00:04:33,010 --> 00:04:34,680
أرجوك ادفنه بكلِّ احترام

42
00:04:35,400 --> 00:04:37,360
،مع أنَّ هذا الحادث نجم عن تساقط الصُّخور

43
00:04:37,740 --> 00:04:40,980
إلا أنِّي أوصيك أن تعوِّض عائلته
كما لو أنَّه مات في ساحة المعركة

44
00:04:41,850 --> 00:04:43,740
حاضر يا جلالة الملك

45
00:04:46,080 --> 00:04:46,300
ماذا؟

46
00:04:51,450 --> 00:04:53,600
يخيّم بردٌ قارسٌ على هذا المكان ليلًا

47
00:04:54,370 --> 00:04:55,200
تفضَّل

48
00:04:56,960 --> 00:04:58,060
...ذلك الشاب

49
00:04:58,290 --> 00:04:58,820
نعم؟

50
00:04:59,620 --> 00:05:01,800
ذلك الجندي الشاب، تهشَّمت ركبتاه

51
00:05:02,690 --> 00:05:05,820
ولن يمشي بعد اليوم إلا بعكَّاز

52
00:05:08,330 --> 00:05:09,620
!يا له من مُصابٍ أليم

53
00:05:10,980 --> 00:05:12,580
هذه ضريبة الحروب

54
00:05:14,180 --> 00:05:17,240
أجد في النَّظر إلى النار أُنسًا بالغًا

55
00:05:17,500 --> 00:05:20,340
فلهبها يشبه صديقًا قديمًا مألوفًا

56
00:05:21,520 --> 00:05:25,130
أتفكر في ذلك الرجلِ الفارسيِّ ذي الشعر الأسود؟

57
00:05:27,730 --> 00:05:28,860
لا يا بطليموس

58
00:05:29,580 --> 00:05:32,560
في الحقيقة، لم أكن أقصد شخصًا بعينه

59
00:05:34,160 --> 00:05:37,230
تأخَّر الوقت يا جلالة الملك، لا شكَّ أنَّك مرهق

60
00:05:37,270 --> 00:05:40,260
استرح الآن، أنا موقنٌ أنَّك
ستصبح بحالٍ أفضل في الصباح

61
00:05:41,700 --> 00:05:42,660
فليكن ذلك

62
00:06:01,440 --> 00:06:04,040
!ما أشدَّ الوحدة حين تكون ملكًا

63
00:06:05,960 --> 00:06:06,900
...أبي

64
00:06:27,660 --> 00:06:30,560
لعلَّ في السباحة بلسمًا ينعش نفسه

65
00:06:30,720 --> 00:06:33,180
يساورني القلق، إذ لم تفارقه الحمَّى منذ البارحة

66
00:06:33,180 --> 00:06:36,360
لا تقلق، فملكنا الأسد قويٌّ كالثور

67
00:06:36,580 --> 00:06:39,000
حتَّى الجراثيم لا تجرؤ على تحدِّي الملك

68
00:06:39,130 --> 00:06:40,560
أجل، صدقتَ في ذلك

69
00:06:41,220 --> 00:06:41,960
!جلالة الملك

70
00:06:42,160 --> 00:06:43,080
ماذا؟

71
00:06:48,980 --> 00:06:49,960
!جلالة الملك

72
00:06:52,530 --> 00:06:56,420
...بدأ الإرهاق يتسرَّب إليَّ يا أبي

73
00:07:11,920 --> 00:07:13,400
كنتُ أنظر إلى الخارج

74
00:07:13,940 --> 00:07:16,360
البرد لا يلائم حُمَّاك

75
00:07:16,920 --> 00:07:18,420
إنَّها حديقةٌ بديعة

76
00:07:18,660 --> 00:07:19,200
أجل

77
00:07:19,260 --> 00:07:22,100
أيذهب البشر بعد مماتهم إلى مكانٍ مثل هذا؟

78
00:07:25,440 --> 00:07:29,280
لمَ تتحدَّث بهذه الكآبة؟
إنَّها قلقةٌ عليك يا إسكندر

79
00:07:29,990 --> 00:07:31,930
ليتني لم أخاطبها بتلك الطريقة

80
00:07:32,030 --> 00:07:35,060
أظنُّ أنَّ المرض قد نال من روحي

81
00:07:36,100 --> 00:07:38,680
يُقال إنَّ مرض جلالة الملك بالغ الخطورة

82
00:07:38,680 --> 00:07:41,740
هذا ما يبدو، سمعتُ أنَّه يحتضر

83
00:07:41,740 --> 00:07:43,040
هل يخفون الأمر عنَّا؟

84
00:07:43,350 --> 00:07:46,000
،لو هاجمنا الفُرس الآن
لكانت هزيمتنا مُحقَّقة

85
00:07:46,190 --> 00:07:48,430
!أنا الرَّسول، أفسحوا الطَّريق

86
00:07:50,500 --> 00:07:51,940
!لا شكَّ أنَّ شيئًا ما قد حدث

87
00:07:55,240 --> 00:07:57,400
أنا رسولُ الجنرال بارمينيون

88
00:07:58,340 --> 00:07:59,700
أطلب مقابلة جلالة الملك

89
00:07:59,990 --> 00:08:01,980
إنَّه يستريح الآن

90
00:08:01,990 --> 00:08:03,260
الأمر لا يحتمل الإرجاء

91
00:08:12,700 --> 00:08:16,540
،المعذرة يا جلالة الملك
حان موعد دوائك

92
00:08:25,660 --> 00:08:26,920
تفضَّل دواءك

93
00:08:27,400 --> 00:08:30,260
هذا ليس دواءً، بل ماء النَّعناع

94
00:08:31,270 --> 00:08:32,980
!ليس بسمٍّ ولا بدواء

95
00:08:37,960 --> 00:08:38,960
ما الأمر؟

96
00:08:39,800 --> 00:08:41,360
ماذا لدى الجنرال من أقوال؟

97
00:08:44,950 --> 00:08:46,000
!جلالة الملك

98
00:08:46,000 --> 00:08:46,940
أنا في غاية الإرهاق

99
00:08:49,210 --> 00:08:50,680
يجب أن أنام بعض الوقت

100
00:08:53,250 --> 00:08:54,090
!جلالة الملك

101
00:08:55,260 --> 00:08:59,460
أنا مريضٌ يا بطليموس، فدعني
أدبّر أمري كما أهوى الآن من فضلك

102
00:09:11,390 --> 00:09:14,380
عليك توخِّي الحذر من جاسوس عدوِّنا

103
00:09:14,380 --> 00:09:18,580
بلغني أنَّ صديقك فيليب، قد باع ذمَّته للفُرس

104
00:09:18,580 --> 00:09:20,440
وأنَّه يسعى لاغتيالك

105
00:09:21,050 --> 00:09:24,330
أُرسل مبعوثوهم إلى حيث توجد

106
00:09:24,940 --> 00:09:29,100
،حتَّى وإن قدَّم لك فيليب الدَّواء
فأرجوك احرص على ألا تشربه

107
00:09:29,300 --> 00:09:31,230
أرجو أن تتوخَّى الحذر يا صاحب السُّمو

108
00:09:31,400 --> 00:09:33,880
خادمك المخلص إلى الأبد، بارمينيون

109
00:09:42,860 --> 00:09:44,360
...إسكندر-ساما

110
00:09:47,900 --> 00:09:49,300
...إسكندر-ساما

111
00:09:49,960 --> 00:09:51,360
أنا متعب

112
00:09:52,400 --> 00:09:53,860
لا أبغي الحراك

113
00:09:55,200 --> 00:09:56,630
...إسكندر-ساما

114
00:09:57,840 --> 00:09:59,160
إسكندر-ساما

115
00:10:00,000 --> 00:10:01,420
!اصمت

116
00:10:10,460 --> 00:10:11,680
!أبي

117
00:10:12,700 --> 00:10:14,040
...إسكندر-ساما

118
00:10:19,900 --> 00:10:21,260
هذا أنت يا فيليب؟

119
00:10:24,980 --> 00:10:26,200
منذ متى وأنت هنا؟

120
00:10:28,460 --> 00:10:30,360
لم أمكث سوى لحظاتٍ معدودة

121
00:10:30,360 --> 00:10:32,660
هل سمعتني أقول شيئًا؟

122
00:10:33,520 --> 00:10:34,400
...لا

123
00:10:35,030 --> 00:10:36,820
لكن بدا أنَّك كنتَ ترى كابوسًا

124
00:10:52,490 --> 00:10:55,640
ماذا تفعل هنا أصلًا؟

125
00:10:56,160 --> 00:10:59,100
!أمرتك ألا تظهر أمامي مُجددًا

126
00:11:00,300 --> 00:11:01,620
!مرَّت على ذلك ثلاثة أعوام

127
00:11:02,160 --> 00:11:03,230
أرجوك سامحني

128
00:11:03,700 --> 00:11:07,500
بلغني خبر مرضك، أخشى أنِّي لم أقوَ على منع نفسي

129
00:11:07,990 --> 00:11:09,940
!يا لك من نبيل

130
00:11:10,420 --> 00:11:11,860
الآن أفصح لي عن غرضك الحقيقي

131
00:11:12,430 --> 00:11:13,480
غرضي؟

132
00:11:14,420 --> 00:11:16,520
تعلم أنَّني طبيب

133
00:11:18,400 --> 00:11:22,000
استغللتُ فرصة نومك لأتفقَّد حالتك

134
00:11:22,340 --> 00:11:25,070
،أدركتُ سبب مرضك على الفور

135
00:11:25,070 --> 00:11:27,070
فهذا لا يخفى على بصيرة الأطباء

136
00:11:27,300 --> 00:11:28,760
ما بي إذًا؟

137
00:11:29,860 --> 00:11:33,800
روحك منهكةٌ وهذا ما أضعف جسدك

138
00:11:38,780 --> 00:11:43,380
طفتُ في أرجاء آسيا كافةً دارسًا
للطبِّ من أجل مثل هذه الحالات

139
00:11:44,180 --> 00:11:46,780
لي باعٌ طويلٌ في علم الأعشاب بشتَّى أصنافها

140
00:11:47,600 --> 00:11:49,130
حتَّى السامَّة منها؟

141
00:11:51,320 --> 00:11:52,230
أجل

142
00:11:58,470 --> 00:12:03,340
هذا مزيجٌ سائلٌ فريدٌ حضَّرته من أعشابٍ طبية

143
00:12:03,860 --> 00:12:05,800
قد يكون له أثرٌ سام

144
00:12:07,300 --> 00:12:11,400
،لكن متى سرى هذا في جسدك
فستُنقذ حياتك لا محالة

145
00:12:16,550 --> 00:12:18,010
إسكندر-ساما

146
00:12:21,030 --> 00:12:22,990
المشكلة ليست فيه

147
00:12:23,930 --> 00:12:28,950
هذا اختبارٌ شخصيٌّ لكشف حقيقتك يا جلالة الملك

148
00:12:41,500 --> 00:12:43,460
!أبي

149
00:12:43,830 --> 00:12:45,330
توخَّ الحذر من فضلك

150
00:13:52,920 --> 00:13:56,780
أنا الملك ولن أموت بسهولة

151
00:13:57,600 --> 00:14:01,520
حياة جنودي مُعلَّقةٌ برقبتي

152
00:14:02,860 --> 00:14:08,760
...أهذا دواءٌ أم سم؟ فيليب، أأنت عدوِّي

153
00:14:10,280 --> 00:14:12,010
أم أنَّك حليفي؟...

154
00:14:26,990 --> 00:14:30,660
كان أبي يؤمن بأهمية توفير أفضل تعليمٍ ممكنٍ لنا

155
00:14:31,710 --> 00:14:34,530
أحضر لنا أرسطو من أثينا

156
00:14:35,120 --> 00:14:37,770
...كنتُ في الثالثة عشرة من عمري آنذاك

157
00:14:37,920 --> 00:14:41,440
تلقَّيتُ العلم على يديه لمدة ثلاث أعوام
ونهلتُ من علمه الكثير في المعبد في ميزا

158
00:14:42,280 --> 00:14:46,520
أنتم في السنِّ المثاليةِ لتنهلوا من العلم قدر ما تستطيعون

159
00:14:46,520 --> 00:14:50,020
إذًا، ما الغايةُ من التعلُّم؟

160
00:14:50,260 --> 00:14:52,240
ولمَ تلزمكم الدِّراسة؟

161
00:14:53,060 --> 00:14:55,020
ما رأيك يا بطليموس؟

162
00:14:55,030 --> 00:14:57,060
... ماذا؟ أنا

163
00:14:58,000 --> 00:15:01,050
لنصير رجالًا عظماء يحترمهم الجميع

164
00:15:03,300 --> 00:15:07,160
حسنًا، أخبروني ما صفات المُستحقِّ للاحترام

165
00:15:07,720 --> 00:15:10,240
شخصٌ مثل والد أميرنا

166
00:15:11,260 --> 00:15:14,460
أتقصد المتفاني في خدمة الآخرين؟

167
00:15:14,760 --> 00:15:17,170
يومًا ما، ستتبوّؤون مكانةً تؤهِّلكم لخدمة الآخرين

168
00:15:17,480 --> 00:15:19,760
...ومتى ما حان ذلك اليوم وطُلب منكم التحرُّك

169
00:15:19,960 --> 00:15:22,680
...متى أعملتم حكمتكم لاتخاذ قرارٍ ما

170
00:15:22,680 --> 00:15:24,680
...أريدكم أن تتذكَّروا هذه الفضائل

171
00:15:25,000 --> 00:15:25,880
العدالة

172
00:15:26,540 --> 00:15:27,320
والنَّزاهة

173
00:15:28,080 --> 00:15:29,020
والشجاعة

174
00:15:29,560 --> 00:15:31,240
والصَّداقة

175
00:15:31,330 --> 00:15:35,010
هذه أهمُّ الفضائل التي ينبغي
للقلبِ البشريِّ أن يتحلَّى بها

176
00:15:35,240 --> 00:15:35,980
!حاضر

177
00:15:36,880 --> 00:15:39,300
يجب ألا نضيّع الوقت الممنوح لنا

178
00:15:39,330 --> 00:15:43,180
أنتم جميعًا شبابٌ مفعمون بالحيويَّة
وتكمن في دواخلكم إمكاناتٌ لا حدود لها

179
00:15:43,400 --> 00:15:45,860
والآن عليكم أن تتعلَّموا كيف تفجّرون تلك الإمكانات

180
00:15:55,040 --> 00:15:58,280
أنت أيُّها الفارسي! أنتَ تُزعجني

181
00:16:00,260 --> 00:16:01,800
أعتذر

182
00:16:02,370 --> 00:16:07,160
أنت ذكي، لذا تقدر على إنجاز جميع
أعمالك بسهولةٍ في وقتٍ وجيز

183
00:16:07,330 --> 00:16:10,080
!لكنَّ هذه الدروس تعصى على فهمي
!ويشقُّ عليَّ التركيز

184
00:16:10,080 --> 00:16:12,260
،في أثناء عزفك المتواصل على هذه القيثارة

185
00:16:12,580 --> 00:16:16,830
!لا يسعني سوى الشُّعور أنَّك تسخر منِّي

186
00:16:16,930 --> 00:16:19,600
دعه وشأنه يا بطليموس، إنَّه لا يضمر لك سوءًا

187
00:16:19,820 --> 00:16:21,040
!طفح الكيل بي

188
00:16:21,080 --> 00:16:23,050
!لا أفهم شيئًا على الإطلاق

189
00:16:23,140 --> 00:16:27,700
بمَ يفكر الأمير إسكندر؟ لمَ يصرُّ على إبقاء هذا الفارسيِّ ذي الشعر الأسود بجانبه؟

190
00:16:28,290 --> 00:16:30,360
!فيليب مقدوني

191
00:16:31,460 --> 00:16:33,160
ليس فارسي

192
00:16:33,430 --> 00:16:36,320
أليس صحيحًا أنَّ والدة فيليب فارسيَّة؟

193
00:16:36,420 --> 00:16:37,540
وماذا في ذلك؟

194
00:16:37,820 --> 00:16:40,400
!حسنًا! تعلم يقينًا أنَّ الفُرس لا يُوثق بهم

195
00:16:40,430 --> 00:16:42,460
إنَّك في حضرة الأمير! فتمالك نفسك

196
00:16:42,500 --> 00:16:44,630
!لا يهم، لم أفرغ من كلامي بعد

197
00:16:45,730 --> 00:16:48,510
!بلاد فارس ألدُّ أعداء مقدونيا

198
00:16:48,600 --> 00:16:50,220
‫ومع ذلك، تسمح لشخصٍ تجري في عروقه دماءٌ فارسيةٌ

199
00:16:50,220 --> 00:16:54,360
بدخول ‫بلاطنا، مجرَّد التفكير في هذا أمرٌ لم نسمع بمثله قط

200
00:16:54,510 --> 00:16:56,720
...ومع ذلك تصادق جاسوسًا وتتوقَّع

201
00:16:56,720 --> 00:16:57,800
!تراجع عمَّا قلته

202
00:16:58,980 --> 00:17:00,580
!أتدعو صديقي جاسوسًا؟

203
00:17:00,580 --> 00:17:03,440
ولماذا لا أدعو الجاسوس جاسوسًا ما دام هذا واقعَ حاله؟

204
00:17:03,470 --> 00:17:04,900
!أرجوكما، توقَّفا

205
00:17:04,910 --> 00:17:06,040
!لا تتدخَّل يا فيليب

206
00:17:06,040 --> 00:17:07,500
!لن أطاوعك

207
00:17:07,720 --> 00:17:09,030
!لا تتدخَّل

208
00:17:13,940 --> 00:17:16,650
،أعلم أنَّني سببُ هذا الشجار بينكما

209
00:17:16,820 --> 00:17:19,040
لا أطلب سوى أن تمنحاني فرصةً لأتحدَّث

210
00:17:19,230 --> 00:17:23,030
معه حق! أدنى ما يجب علينا أن
نمنح فيليب فرصةً للبوح بما في صدره

211
00:17:23,300 --> 00:17:25,530
حسنًا، نحن نستمع

212
00:17:25,560 --> 00:17:28,740
،صحيحٌ أنَّ أمِّي فارسيَّة

213
00:17:28,830 --> 00:17:31,000
لكنَّها لم تدعم قطُّ عائلة الأخمينيّي

214
00:17:31,000 --> 00:17:33,180
الحاكمة لبلاد فارس حاليًا

215
00:17:33,350 --> 00:17:34,940
!ولستُ جاسوسًا

216
00:17:34,950 --> 00:17:37,080
!حقًّا! سنرى صدق ذلك

217
00:17:37,200 --> 00:17:38,330
!هذه الحقيقة

218
00:17:38,820 --> 00:17:41,220
-عندما يحين الوقت لكي يرسل ملكنا المحبوب، -ملك مقدونيا

219
00:17:41,220 --> 00:17:44,380
قوَّاته لتحرير كلِّ الأخيار في بلاد فارس

220
00:17:44,380 --> 00:17:48,960
أنوي أن أكون هناك لأرافقه
بوصفي أحد جنوده المخلصين

221
00:17:49,640 --> 00:17:54,300
أرجو أن تثق في ولائي المطلق للملك

222
00:17:55,230 --> 00:17:58,160
سنرى، فالفُرس معروفون بزيف أقوالهم

223
00:17:58,260 --> 00:18:00,030
!كفَّ عن هذا العناد

224
00:18:02,550 --> 00:18:03,340
!أيُّها السَّادة

225
00:18:03,340 --> 00:18:03,700
ماذا؟

226
00:18:04,360 --> 00:18:05,660
،إذا كنتم تتناقشون في استراتيجيَّاتٍ عسكريَّة

227
00:18:05,660 --> 00:18:08,310
فعليكم أن تخفضوا أصواتكم

228
00:18:08,430 --> 00:18:11,920
لن يسمعكم الفُرس وحدهم، بل
سيصل صوتكم إلى الهند أيضًا

229
00:18:12,400 --> 00:18:16,060
أعتقد أنَّ دورك قد حان لتذهب
لتقطيع الحطب يا بطليموس

230
00:18:18,030 --> 00:18:19,520
،وأنت يا هيفايستيون

231
00:18:19,530 --> 00:18:24,120
أرى أنَّه من حسن التدبير أن ترافق
بطليموس وتساعده في عمله

232
00:18:24,230 --> 00:18:25,980
...ولكن يا مُعلِّمي، أنا

233
00:18:25,360 --> 00:18:26,080
!حاضر

234
00:18:29,140 --> 00:18:32,020
أعتذر لأنِّي سبَّبتُ لك المتاعب يا صاحب السُّمو

235
00:18:32,370 --> 00:18:35,320
كان بطليموس المخطئ، لا أنت

236
00:18:35,340 --> 00:18:37,960
إذ يستحيل شخصًا مختلفًا تمامًا
حين يأتي الحديث عن بلاد فارس

237
00:18:38,160 --> 00:18:39,230
ولا أعرف السَّبب

238
00:18:39,260 --> 00:18:44,520
لأنَّ والده قُتل في معركةٍ
خلال الحرب على بلاد فارس

239
00:18:44,740 --> 00:18:47,460
لكن لا داعي للقلق، فبطليموس
شابٌّ صالحٌ وصادقٌ جدًّا

240
00:18:47,600 --> 00:18:49,030
ما عليكما إلا أن تصبرا عليه

241
00:18:49,060 --> 00:18:50,460
لم أكن أعلم ذلك

242
00:18:51,280 --> 00:18:53,280
لا تشغل بالك بهذا

243
00:18:53,630 --> 00:18:57,760
لعلَّه من الأفضل ألا أبقى بجانبك بعد الآن

244
00:18:57,980 --> 00:19:01,460
لا أريد أن أسبّب لك المزيد
من المتاعب يا صاحب السُّمو

245
00:19:01,460 --> 00:19:02,940
كيف تشعر يا مولاي؟

246
00:19:03,080 --> 00:19:06,460
لم يتغيَّر شيء، بالطبع، أريد
دومًا أن يكون فيليب بجانبي

247
00:19:07,210 --> 00:19:11,200
لكنَّ رؤيته يعاني مثل هذه
المضايقات تمزِّق نفسي أسًى

248
00:19:11,360 --> 00:19:14,030
لعلَّ أمنياتي أنانيةٌ ومُجحفة

249
00:19:14,990 --> 00:19:16,140
!ما أروعَ هذا

250
00:19:17,480 --> 00:19:20,180
،هذا مثالٌ على جوهر الصَّداقة الحقيقيَّة

251
00:19:20,400 --> 00:19:23,020
إيثار مشاعر الآخرين على مشاعر النَّفس

252
00:19:23,360 --> 00:19:27,100
،حماية هذه الرَّابطة بينكما أمرٌ بالغ الأهميَّة

253
00:19:27,100 --> 00:19:29,100
مهما اعترض طريقكما من عقبات

254
00:19:29,230 --> 00:19:30,800
هذا ما أومن فيه

255
00:19:31,820 --> 00:19:33,800
رغم أنَّنا وعدنا معلِّمنا أن نكون ،صديقَين إلى الأبد

256
00:19:34,140 --> 00:19:37,580
إلا أنَّ رابطتنا سرعان ما انكسرت بعد حين

257
00:19:48,260 --> 00:19:50,200
!يحيا الملك

258
00:19:50,200 --> 00:19:52,200
!تحيا الملكة

259
00:19:55,630 --> 00:19:58,600
ملك مقدونيا الأكثر شعبيةً بين الجميع

260
00:19:58,640 --> 00:20:00,880
أجل، لكنَّ أعداءه كثيرون أيضًا

261
00:20:01,000 --> 00:20:02,340
أتشكُّ فيه؟

262
00:20:02,630 --> 00:20:04,360
إنَّما أذكِّرك بضرورة اليقظة

263
00:20:05,190 --> 00:20:07,460
سنصل إلى المسرح عمَّا قريبٍ يا أبي

264
00:20:08,010 --> 00:20:10,820
تعال يا بنيَّ إسكندر، اركب مع والدتك ومعي

265
00:20:10,890 --> 00:20:11,480
حاضر

266
00:20:13,310 --> 00:20:16,600
بنيَّ العزيز إسكندر، أنت قرَّة عيني

267
00:20:16,600 --> 00:20:18,830
وأنا مَن أنجبته

268
00:20:19,170 --> 00:20:22,220
!ما أصدقَ قولكِ يا عزيزتي
فقد منحتِ فتانا هبة الحياة

269
00:20:22,220 --> 00:20:23,670
ينبغي ألا ننسى ذلك

270
00:20:27,550 --> 00:20:32,400
انظر في أعينهم وتذكَّر وجوه
الأخيار الدَّاعمين لنا يا إسكندر

271
00:20:32,780 --> 00:20:38,900
تذكَّر أنَّ واجب الملك حكم البلاد
وضمان ألا تفارق الابتسامة وجوه شعبه

272
00:20:39,230 --> 00:20:43,700
ما دُمتَ ملتزمًا بذلك، فستنعم مقدونيا وعائلتك بالرَّخاء

273
00:20:43,960 --> 00:20:45,300
تأمَّل حال بلاد فارس

274
00:20:45,410 --> 00:20:48,480
تستغلُّ العائلة الملكيَّة الشعب من أجل مصالحها الشخصيَّة

275
00:20:48,480 --> 00:20:51,180
ولهذا لم يعد الفُرس سعداء

276
00:20:51,370 --> 00:20:55,200
إيَّاك أن تسمح لمقدونيا باتِّباع نهج بلاد فارس

277
00:20:55,330 --> 00:20:56,440
حاضر يا أبي

278
00:21:05,810 --> 00:21:08,140
،اليوم عيد ميلاد طفلي الأوَّل

279
00:21:08,140 --> 00:21:10,620
لذا أرجوك أن تبارك ابني يا جلالة الملك

280
00:21:10,980 --> 00:21:13,720
تهانيَّ لكِ

281
00:21:14,720 --> 00:21:17,560
الأطفال كنزُ أمَّتنا

282
00:21:17,560 --> 00:21:19,860
!إلى الأعلى

283
00:21:37,060 --> 00:21:38,300
!أبي

284
00:21:42,000 --> 00:21:42,880
!أبي

285
00:21:43,400 --> 00:21:45,220
!طُعن الملك

286
00:21:51,670 --> 00:21:53,260
!أبي

287
00:22:04,920 --> 00:22:06,600
،القاتل متمسِّكٌ بصمته

288
00:22:06,710 --> 00:22:09,680
يأبى الإفصاح عن مُدبّر هذه المؤامرة

289
00:22:11,300 --> 00:22:12,660
ماذا عن المرأة؟

290
00:22:12,860 --> 00:22:17,340
أسوأ من ذلك، فقد عضَّت لسانها
ثمَّ قتلت نفسها يا جلالة الملك

291
00:22:17,580 --> 00:22:18,420
!ماذا قلتَ؟

292
00:22:20,320 --> 00:22:22,100
!لا لزوم لكلامه

293
00:22:22,330 --> 00:22:25,870
اعتقلوا القاتل وعائلة المرأة
!وكلَّ مَن يمتُّ لهما بصلة

294
00:22:26,360 --> 00:22:27,960
وجّهوا إليهم أغلظ التُّهم

295
00:22:27,960 --> 00:22:29,210
قتل الملك والخيانة العظمى

296
00:22:29,300 --> 00:22:32,520
!ثمَّ اقطعوا رؤوسهم جميعًا

297
00:22:32,630 --> 00:22:33,770
،تمهَّل يا صاحب السُّمو

298
00:22:34,040 --> 00:22:37,010
فالقانون يقضي محاكمتهم
في المحكمة مهما بلغت جسامة جرمهم

299
00:22:37,900 --> 00:22:39,080
!محاكمتهم في المحكمة؟

300
00:22:39,420 --> 00:22:42,440
!قتل الملك بمرأًى منِّي

301
00:22:42,510 --> 00:22:45,980
وقد شهد بطليموس وهيفايستيون على ذلك أيضًا

302
00:22:45,980 --> 00:22:47,890
!وكذلك الآلاف من المواطنين الآخرين في هذه البلاد

303
00:22:47,890 --> 00:22:51,360
إنَّه مذنبٌ بما لا يدع مجالًا
!للشك، فلا حاجة لنا إلى محاكمة

304
00:22:51,540 --> 00:22:55,120
فهمتُ، لا أظنُّ أنَّ ثمة احتمالًا لبراءته

305
00:22:55,610 --> 00:22:56,390
...ولكن

306
00:22:56,780 --> 00:22:58,880
إعدامه لن يكشف لنا خبايا هذه المؤامرة

307
00:22:58,880 --> 00:23:01,340
ولن يساعدنا في الوصول إلى الحقيقة

308
00:23:01,710 --> 00:23:07,000
لا مناص من أن ينزل حكم القانون برؤوس
الشرّ والمحرِّكين في الخفاء وزعماء الفتنة

309
00:23:07,210 --> 00:23:10,640
وابتغاءً لاستجلاء الحقيقة، يجب عقد محاكمة نزيهة

310
00:23:11,420 --> 00:23:13,860
!مهلًا يا فيليب؟ أيَّة حقيقة؟

311
00:23:14,010 --> 00:23:15,420
!ماذا تقصد؟

312
00:23:15,440 --> 00:23:17,800
أقصد الحقيقة وراء اغتيال الملك

313
00:23:17,870 --> 00:23:21,850
هكذا إذًا، أصبحت الحقيقة واضحةً كوضوح الشمس

314
00:23:21,980 --> 00:23:22,820
ماذا؟

315
00:23:22,860 --> 00:23:26,230
مَن عدوُّ والدي؟ مَن عدوُّ مقدونيا؟

316
00:23:26,230 --> 00:23:30,300
!مَن عساه يفرح بموت ملك مقدونيا؟

317
00:23:30,930 --> 00:23:31,910
!الفُرس

318
00:23:32,330 --> 00:23:33,630
!بالطبع، إنَّهم الفُرس

319
00:23:34,200 --> 00:23:35,200
إذًا أنت توافقني! أفهمتَ الآن؟

320
00:23:35,960 --> 00:23:38,500
!أيَّة حقيقةٍ أخرى قد تكون خلاف هذه؟

321
00:23:39,090 --> 00:23:42,140
ولكن يا صاحب السُّمو، ماذا عن طيبة أو ربَّما أثينا؟

322
00:23:42,230 --> 00:23:46,880
اتَّهمت هاتان الدَّولتان الملك
الرَّاحل بأنَّه عدوٌّ للديمقراطيَّة

323
00:23:47,870 --> 00:23:49,540
كما توجد قوَّاتٌ داخل هذه البلاد

324
00:23:49,780 --> 00:23:53,960
كانت تنتقد الإصلاحات العسكريَّة للملك

325
00:23:54,280 --> 00:23:56,630
بدأتَ تبدو يائسًا يا فيليب

326
00:23:58,600 --> 00:24:01,360
،ببلاغتك المعهودة

327
00:24:01,460 --> 00:24:05,340
لا شكَّ أنَّه يسهل عليك إلقاء تبعة
هذه الجرائم على عواتق دولٍ أخرى

328
00:24:05,420 --> 00:24:06,590
ما الذي تلمِّح إليه؟

329
00:24:06,690 --> 00:24:08,570
،أجبني عن هذا فحسب يا فيليب

330
00:24:09,240 --> 00:24:11,660
!ما كان لون شعر المرأة القاتلة؟

331
00:24:12,030 --> 00:24:15,420
أسود، كان لون شعرها أسود

332
00:24:16,290 --> 00:24:20,000
شعرها أسود وبشرتها داكنة، لذا
!من المرجَّح أنَّها تنتمي إلى عرقك

333
00:24:21,490 --> 00:24:26,880
يؤيّد فيليب محاكمةً طويلة الأمد
تصبُّ في مصلحة بلاد فارس

334
00:24:27,490 --> 00:24:31,090
‫ينبغي أن نرسي سابقةً قانونيَّة، لكي يحترم الشعب القانون

335
00:24:31,360 --> 00:24:33,720
‫ لا سيَّما أنَّ سموَّه على وشك اعتلاء العرش!

336
00:24:34,270 --> 00:24:36,280
لم ينقضِ الحداد على والدي بعد

337
00:24:36,800 --> 00:24:39,830
!وتجرؤ على التحدُّث عمَّن سيخلُف العرش؟

338
00:24:40,310 --> 00:24:41,260
...كلَّا

339
00:24:41,260 --> 00:24:42,670
أليس هذا طبعه المعهود؟

340
00:24:43,250 --> 00:24:46,570
خذوا هذا الفارسيَّ القذر من
!هنا! وأبعدوه عن ناظرَيَّ

341
00:24:46,670 --> 00:24:48,340
!إسكندر-ساما

342
00:24:48,500 --> 00:24:50,400
!إيَّاك أن تريني وجهك بعد اليوم

343
00:25:01,620 --> 00:25:05,320
!ما حيلتي وهذه الدماء الفارسيَّة تجري في عروقي؟

344
00:25:05,360 --> 00:25:07,960
أهذه في حدِّ ذاتها جريمةٌ شنيعةٌ إلى هذه الدرجة؟

345
00:25:08,060 --> 00:25:11,660
!أرجوك يا إسكندر-ساما، أتوسَّل إليك، أجبني

346
00:25:18,630 --> 00:25:21,880
عدوُّي ليس الفُرس

347
00:25:22,860 --> 00:25:28,740
عدوِّي الحقيقي سلالة
الأخمينيّين الشريرة وحكومتها

348
00:25:31,080 --> 00:25:34,380
!بالطبع، أدركتُ الآن أنَّ هذه الحقيقة

349
00:25:35,750 --> 00:25:39,240
،جرفني غضبُ فقدان والدي

350
00:25:39,760 --> 00:25:42,030
فاتَّهمتُ صديقي الغالي فيليب

351
00:25:42,900 --> 00:25:46,160
وهذا أمرٌ أندم عليه حتَّى يومنا هذا

352
00:25:49,960 --> 00:25:52,720
!هيَّا

353
00:26:10,060 --> 00:26:11,700
!هجوم

354
00:26:39,100 --> 00:26:41,720
!حاصرتنا خيَّالتهم يا جلالة الملك

355
00:26:42,360 --> 00:26:43,900
!تمادينا في المطاردة أكثر من اللازم

356
00:26:44,000 --> 00:26:45,120
!أفسحوا لي الطَّريق

357
00:26:46,760 --> 00:26:49,990
!اتَّخذوا تشكيلًا دائريًّا أيُّها المشاة! وصدُّوا هجومهم

358
00:26:49,990 --> 00:26:52,080
!لا تسمحوا لخيَّالة الفُرس بالاقتراب أكثر

359
00:27:10,300 --> 00:27:11,580
!أين قوَّات بارمينيون؟

360
00:27:12,000 --> 00:27:13,720
!إنَّهم يقاتلون مشاة العدو

361
00:27:14,290 --> 00:27:16,120
!لا تعقد الآمال على مساعدتهم

362
00:27:16,340 --> 00:27:17,760
!الوقت ينفد

363
00:27:26,940 --> 00:27:28,600
!أبقِ ناظريك عليه أيُّها الجندي

364
00:27:28,930 --> 00:27:32,340
ذلك الرجل في المنتصف
!ذو الدرع الفضي والرِّيش

365
00:27:32,880 --> 00:27:35,700
،ذاك الإسكندر، قائد عدوِّنا

366
00:27:35,700 --> 00:27:37,880
!لا تضيّعوا وقتكم مع بقيَّتهم

367
00:27:37,960 --> 00:27:40,460
!صوِّبوا كلَّ سهامكم إلى الإسكندر

368
00:27:47,460 --> 00:27:48,140
!جلالة الملك

369
00:27:50,800 --> 00:27:51,860
!هيفايستيون

370
00:27:52,020 --> 00:27:53,380
لا بأس يا مولاي

371
00:27:55,660 --> 00:27:57,960
!أيُّها الوحوش، لأبيدنَّكم على بكرة أبيكم

372
00:27:58,820 --> 00:28:02,840
أرجوك يا جلالة الملك! لا
!تتهوَّر! إن تقدَّمنا فسنموت جميعًا

373
00:28:02,920 --> 00:28:04,340
!دعني يا بطليموس

374
00:28:04,880 --> 00:28:07,270
!سأُري الفُرس كيف يموت ملك مقدونيا

375
00:28:07,460 --> 00:28:09,360
ما الذي تهذي به؟

376
00:28:09,360 --> 00:28:10,220
!اعذرني

377
00:28:15,640 --> 00:28:17,820
!ماذا تفعل يا بطليموس؟

378
00:28:18,040 --> 00:28:21,580
أشكرك على سماحك لي باستعارة
!حصانك يا جلالة الملك

379
00:28:24,940 --> 00:28:28,060
!أرعوني أسماعكم يا جنود الفُرس الجبناء

380
00:28:28,580 --> 00:28:33,640
،أنا الإسكندر، ملك مقدونيا
!خذوا رأسي مكافأةً لكم

381
00:28:35,180 --> 00:28:37,300
!ذاك الإسكندر

382
00:28:37,300 --> 00:28:39,620
إنَّه هدفكم الوحيد

383
00:28:39,620 --> 00:28:41,440
!ستنالون المكافأة التي تبغونها

384
00:28:41,560 --> 00:28:43,980
!الحقوا به! لا تدعوا بطليموس يموت

385
00:28:43,980 --> 00:28:47,950
!حدث تغييرٌ في القيادة! اسحبوا جميع القوَّات فورًا

386
00:28:48,080 --> 00:28:48,940
!ماذا؟

387
00:28:49,920 --> 00:28:53,400
!كيف تجرؤ يا هيفايستيون! أتعصي أمر الملك المباشر؟

388
00:28:53,720 --> 00:28:55,880
!‫عاقبني كيفما تشاء لاحقًا

389
00:28:56,000 --> 00:28:57,740
! لكن علينا الانسحاب الآن

390
00:28:59,120 --> 00:29:01,190
!ليس من الرجولة في شيءٍ أن أضحِّي بصديقي

391
00:29:01,980 --> 00:29:04,860
!أنت ملكٌ قبل أن تكون رجلًا

392
00:29:05,740 --> 00:29:08,980
!اسحبوا القوَّات الآن! سنغادر جميعًا

393
00:29:19,900 --> 00:29:21,010
!بطليموس

394
00:29:53,720 --> 00:29:55,920
أتأذن لي بالدُّخول يا جلالة الملك؟

395
00:29:56,100 --> 00:29:56,800
...أجل

396
00:29:58,320 --> 00:30:03,000
،هرب بطليموس وهو مع حلفائنا
!أبلغونا للتوِّ أنَّه بخير

397
00:30:03,000 --> 00:30:03,920
!ماذا؟

398
00:30:04,780 --> 00:30:07,400
!سيعود إلينا غدًا سالمًا مُعافًى

399
00:30:07,880 --> 00:30:10,440
يسعدني هذا أكثر مما تتصوَّر

400
00:30:11,600 --> 00:30:14,380
إذًا لماذا... ما المشكلة الآن يا مولاي؟

401
00:30:14,820 --> 00:30:16,600
...اسمعني يا هيفايستيون

402
00:30:17,140 --> 00:30:17,740
نعم؟

403
00:30:18,200 --> 00:30:21,380
...علمنا الآن أنَّ بطليموس قد نجا ولكن

404
00:30:22,240 --> 00:30:27,980
لا أفهم لماذا قد يريد التَّضحية بحياته من أجلي بهذه الصُّورة البطوليَّة

405
00:30:29,300 --> 00:30:30,920
لأنَّ ذلك واجبه

406
00:30:31,500 --> 00:30:32,540
أهذا السَّبب؟

407
00:30:33,300 --> 00:30:37,060
بالطَّبع! يحبُّك بطليموس ويحترمك
أكثر ممَّا تصف الكلمات

408
00:30:37,420 --> 00:30:40,860
لستُ سوى رجلٍ سريع الغضب ومتهكّم وتافه

409
00:30:42,060 --> 00:30:44,600
أنت وحدك مَن يظنُّ ذلك يا جلالة الملك

410
00:30:44,620 --> 00:30:50,060
هل أستحقُّ شرف أن يبذل هذا العدد الكبير
من الشُّبان البواسل حياتهم من أجلي؟

411
00:30:51,640 --> 00:30:53,300
!لم يكن بطليموس الوحيد

412
00:30:53,840 --> 00:30:57,900
هشَّمت الصُّخور المتساقطة ركب العديد من الرِّجال

413
00:30:58,260 --> 00:31:03,300
ثمة جثثٌ لا تُحصى للعديد من الجنود
البواسل الذين ماتوا من أجلي في المعركة

414
00:31:04,480 --> 00:31:07,800
وعليه أعيد سؤالي: أأنا أستحقُّ هذه الأرواح؟

415
00:31:08,560 --> 00:31:14,880
كرَّسنا حياتنا عن طيب خاطرٍ للمُثل
والمعتقدات التي تحمل لواءها يا جلالة الملك

416
00:31:15,100 --> 00:31:17,040
أيُّ مُثُلٍ بالضبط؟

417
00:31:18,320 --> 00:31:22,240
مُثُلك في تحرير الفُرس من حكم
الخوف الذي فرضته سلالة الأخمينيّين

418
00:31:23,180 --> 00:31:26,240
مُثُلك في توحيد العالم ليصير
!أمَّةً واحدةً مسالمة

419
00:31:26,740 --> 00:31:31,040
مُثُلك في تشييد المكتبات لتكون
المعرفة متاحةً للجميع على قدم المساواة

420
00:31:31,380 --> 00:31:32,260
...وأيضًا

421
00:31:32,260 --> 00:31:33,460
فهمت

422
00:31:33,800 --> 00:31:37,720
شكرًا لك يا هيفايستيون، أعلم أنَّك محق

423
00:31:39,920 --> 00:31:42,140
شكرًا لك، أصبحتُ أفضل حالًا الآن

424
00:31:48,320 --> 00:31:51,130
...ما زلتَ تبدو غير مقتنعٍ بطريقةٍ ما

425
00:31:51,720 --> 00:31:52,930
معلِّمي أرسطو

426
00:31:53,660 --> 00:31:55,900
،هيفايستيون بالغ الحكمة

427
00:31:56,360 --> 00:31:59,400
وهو يقول الحقيقة

428
00:32:00,040 --> 00:32:04,980
ولكنَّه لا يعرف ما يدور في خلدي
لذا كان قوله عليه هينًا يا مُعلِّمي

429
00:32:05,420 --> 00:32:06,600
...‫على أنَّ هيفايستيون

430
00:32:07,720 --> 00:32:09,860
«لا يعرف «ذاتي الحقيقيَّة

431
00:32:10,340 --> 00:32:11,260
ماذا تقصد؟

432
00:32:11,520 --> 00:32:14,440
...المُثُل التي تحدَّث عنها هيفايستيون

433
00:32:14,760 --> 00:32:16,450
ما دافعي الحقيقي؟

434
00:32:16,450 --> 00:32:19,560
،فروسيةٌ زائفة، أم المجد

435
00:32:19,560 --> 00:32:22,490
إرضاء الذَّات، أم الرَّغبة في التسلُّط والامتلاك؟

436
00:32:22,700 --> 00:32:27,270
‫هذه الطُّموحات الدُّنيويَّة ليست سوى
‫ رغباتٍ مُحلَّاة، تتخفَّى خلف قناع «القضية النبيلة»

437
00:32:27,300 --> 00:32:28,960
‫ليس في هذا كلِّه ذرةٌ من «الصدق»

438
00:32:29,360 --> 00:32:33,740
أنا ممزَّقٌ بين إسكندر الحقيقي
والصُّورة الزَّائفة لنفسي

439
00:32:34,660 --> 00:32:36,170
لا أستحقُّ صداقة وولاء فيليب

440
00:32:36,170 --> 00:32:40,040
ولا صدق بطليموس وهيفايستيون

441
00:32:40,420 --> 00:32:44,900
ما أنا إلّا رجلٌ تافهٌ لا يستحقّ ذلك

442
00:32:48,240 --> 00:32:52,390
صديقك مرآةٌ لشخصيَّتك

443
00:32:53,280 --> 00:32:57,080
فحين تنظر إلى المرآة مبتسمًا، فستردُّ
لك صورتك الابتسامة بمثلها

444
00:32:57,480 --> 00:32:59,940
،إن رأيتَ صدق أصدقائك معك دومًا

445
00:32:59,940 --> 00:33:03,430
فهذا لأنَّك كنتَ صادقًا معهم دومًا أيضًا

446
00:33:03,460 --> 00:33:05,440
،حين تثق بأصدقائك

447
00:33:05,600 --> 00:33:08,980
يتشرَّفون بذلك ويدركون قيمة هذه الثقة فيبادلونك إيَّاها

448
00:33:08,980 --> 00:33:10,800
أرجوك افهم يا معلِّمي

449
00:33:10,920 --> 00:33:14,140
عندما أنظر في المرآة، لا
أبتسم ابتسامةً حقيقيَّة

450
00:33:14,800 --> 00:33:17,700
بل أتصنَّع الابتسامة كما يُتوقَّع منِّي تمامًا

451
00:33:17,960 --> 00:33:23,240
ومع ذلك، يبادلني أصدقائي في
المرآة الابتسامة بمنتهى الصدق

452
00:33:23,860 --> 00:33:26,240
!هذا ليس عادلًا، أعلم أنَّه ليس صوابًا

453
00:33:26,240 --> 00:33:29,060
!إنَّهم لا يرونني على حقيقتي

454
00:33:29,740 --> 00:33:31,900
المرآة صورةٌ لا تعرف الكذب

455
00:33:33,230 --> 00:33:36,940
تقول إنَّك لا تبتسم ابتسامةً حقيقيَّة

456
00:33:37,000 --> 00:33:42,800
وأنَّ ما نراه صورةٌ زائفةٌ لإسكندر
وهي التي تبتسم في الواقع

457
00:33:43,200 --> 00:33:46,820
لكن ربَّما ينبغي لك أن تنظر إلى الأمر من زاويةٍ أخرى

458
00:33:46,900 --> 00:33:51,500
فلعلَّ إسكندر الحقيقي بداخلك
يبتسم أيضًا دون أن تدري

459
00:33:52,000 --> 00:33:55,060
يعجز معظمنا في كثيرٍ من
الأحيان عن رؤية نقائصه

460
00:33:55,160 --> 00:33:59,460
بل إنَّ الكثيرين منَّا يفشلون
أيضًا في إدراك قيمتهم الحقيقيَّة

461
00:34:03,460 --> 00:34:07,900
نسعى لتقويم شخصيَّاتنا بينما نتقدَّم في حياتنا

462
00:34:08,060 --> 00:34:10,520
تعلَّمتُ دروسي من معلِّمي أفلاطون

463
00:34:10,520 --> 00:34:14,110
وقد تعلَّم أفلاطون دروسه من معلِّمه سقراط

464
00:34:14,560 --> 00:34:17,000
هل الدراسة والتعلُّم ما هما إلا درسٌ طويلٌ

465
00:34:17,000 --> 00:34:21,180
لاكتشاف السبيل نحو تقويم شخصية المرء؟

466
00:34:21,860 --> 00:34:25,730
،ومع ذلك، خلال حياة المرء القصيرة الفانية

467
00:34:25,960 --> 00:34:30,500
ما مدى واقعيَّة فرص تطوير شخصيةٍ كاملة؟

468
00:34:31,040 --> 00:34:33,300
أتصوَّر أنَّ الاحتمالات ضئيلة

469
00:34:33,760 --> 00:34:37,640
فالكمال قد يكون هدفًا مخيبًا
للآمال، ما العمل إذًا؟

470
00:34:38,330 --> 00:34:41,100
يجب أن نداوم السَّعي نحو هدفنا

471
00:34:41,940 --> 00:34:43,420
هذا ما يهمُّ حقًّا

472
00:34:44,030 --> 00:34:49,100
في كلِّ ساعة، من كلِّ يوم، ينبغي أن
نسعى بوعيٍ لبذل كلِّ جهدٍ مستطاع

473
00:34:49,100 --> 00:34:51,860
لنبلغ مكانةً أعلى ممَّا بلغناه أمس

474
00:34:52,880 --> 00:34:56,140
،إذا شككتَ في صديقك

475
00:34:56,360 --> 00:35:01,360
فيجب أن تواجه ذلك الظلام في قلبك

476
00:35:01,800 --> 00:35:04,990
حارب ذلك الشَّك وثق بصديقك
ثق به أكثر ممَّا يثق بك

477
00:35:05,920 --> 00:35:07,420
هذه نصيحتي لك

478
00:35:07,580 --> 00:35:09,530
كلُّ جهدٍ تبذله وكلُّ لحظةٍ تمرُّ من يومك ستساعدك

479
00:35:09,660 --> 00:35:12,160
في نهاية المطاف لتصير البطل الحقيقي الذي قُدِّر لك أن تكونه

480
00:35:12,160 --> 00:35:13,460
الإسكندر الأكبر

481
00:35:34,540 --> 00:35:38,800
لم يكن الشَّكُّ في فيليب معضلتي

482
00:35:39,620 --> 00:35:41,440
كان التحدِّي الحقيقي اختبارًا لشخصيَّتي

483
00:35:42,340 --> 00:35:44,900
كنتُ أُختبر بوصفي بشرًا

484
00:35:45,130 --> 00:35:46,740
،لكي أكون الإسكندر الأكبر

485
00:35:46,740 --> 00:35:51,580
يجب أن أقبل هذا التحدِّي وأحتضن ثقة أصدقائي

486
00:35:51,630 --> 00:35:54,040
وولاء جنودي وإيمان شعبي بي

487
00:35:59,760 --> 00:36:01,280
أنا سعيد

488
00:36:02,760 --> 00:36:06,660
فقد شربتُ الدَّواء قبل أن ينتهي
فيليب من قراءة الرسالة

489
00:36:06,830 --> 00:36:09,730
هذه طريقتي للتَّكفير عن ذنبي تجاه صديقي

490
00:36:11,180 --> 00:36:13,060
،هذا دليلٌ على هويَّتي المنشودة

491
00:36:13,060 --> 00:36:16,060
هل أصبتُ فيما فعلتُ يا معلِّمي أرسطو؟

492
00:36:31,340 --> 00:36:32,160
!جلالة الملك

493
00:36:41,440 --> 00:36:44,940
!كيف تجرؤ على تسميم الملك أيُّها الخائن الفارسي

494
00:36:44,940 --> 00:36:46,640
!أقسم أنَّه ليس سمًّا

495
00:36:46,800 --> 00:36:47,830
!هذا دواء

496
00:36:49,000 --> 00:36:53,930
إنَّها تركيبةٌ طبيةٌ شديدةُ الفعاليَّة
!ستنقذ حياة إسكندر-ساما

497
00:36:54,820 --> 00:36:56,560
الليلة نقطة التحوُّل الحاسمة

498
00:36:57,620 --> 00:36:59,900
!ثق بي واترك هذا الأمر لي

499
00:37:00,560 --> 00:37:03,680
أعلم أنَّك تحقد على جلالة الملك وعلينا جميعًا

500
00:37:03,680 --> 00:37:05,460
أنَّى لنا الوثوق بك؟

501
00:37:05,460 --> 00:37:07,030
!لا أحقد على أحدٍ منكم

502
00:37:07,580 --> 00:37:11,260
!لا أبتغي سوى إنقاذ صديقي العزيز

503
00:37:12,630 --> 00:37:13,700
...نبض سيِّدي

504
00:37:14,640 --> 00:37:16,390
!مُستقر

505
00:37:17,600 --> 00:37:19,200
لنثق بفيليب في هذا

506
00:37:19,440 --> 00:37:20,620
!هيفايستيون

507
00:37:21,320 --> 00:37:22,880
انظر في عينَيه

508
00:37:28,220 --> 00:37:33,080
عيناه جريئتان أكثر ممَّا ينبغي
لرجلٍ حاول لتوِّه تسميم الملك

509
00:37:36,180 --> 00:37:38,100
!فهمتُ الآن يا هيفايستيون

510
00:37:38,100 --> 00:37:41,040
أنت مَن سمح له بالدُّخول
...إلى غرفة جلالة الملك و

511
00:37:41,040 --> 00:37:41,620
!لا

512
00:37:42,440 --> 00:37:43,880
أنا مَن سمحتُ له

513
00:37:44,260 --> 00:37:46,840
وأنا مَن أمرها بالسماح له

514
00:37:47,240 --> 00:37:49,900
،حسنًا، إن أُصيب الملك بسوء

515
00:37:50,040 --> 00:37:54,030
فسأحرص على إعدامكما كليكما

516
00:37:55,330 --> 00:37:56,360
افعل ما تشاء

517
00:37:57,530 --> 00:38:02,100
فإذا مات جلالة الملك، فلا حياة لي بعده

518
00:38:02,200 --> 00:38:03,560
وأنا أشاطرك هذا الشُّعور

519
00:38:04,100 --> 00:38:05,800
وأنا كذلك

520
00:38:05,830 --> 00:38:07,520
!وبالطبع أنا كذلك

521
00:38:08,080 --> 00:38:12,080
إذًا اتَّفقنا يا بطليموس

522
00:38:13,000 --> 00:38:14,060
!سحقًا

523
00:38:14,600 --> 00:38:15,660
!افعلوا ما بدا لكم

524
00:38:19,160 --> 00:38:20,500
أرجوكِ اغلي ماءً

525
00:38:23,920 --> 00:38:25,800
سيكون جلالة الملك بخير

526
00:39:25,430 --> 00:39:27,480
!إسكندر-ساما

527
00:39:44,030 --> 00:39:45,460
!إسكندر-ساما

528
00:40:53,500 --> 00:40:55,600
!جلالة الملك

529
00:40:55,600 --> 00:41:02,160
!إسكندر-ساما

530
00:41:02,260 --> 00:41:04,940
أأنت متأكدٌ أنَّك لا تقدر على مرافقتي؟

531
00:41:05,420 --> 00:41:06,500
ليتني أستطيع

532
00:41:07,160 --> 00:41:10,280
ولكنِّي أخشى أنَّ ثمة مرضى كثيرين في هذه البلاد

533
00:41:10,280 --> 00:41:12,280
مِمَّن هم بحاجةٍ إلى مساعدتي يا جلالة الملك

534
00:41:12,860 --> 00:41:16,900
إذا كان هذا الطريق الذي اخترته، فما باليد حيلة

535
00:41:19,560 --> 00:41:21,580
أرجوك اكتب لي كلَّما سنحت لك الفرصة

536
00:41:22,660 --> 00:41:23,640
اعتنِ بنفسك

537
00:41:24,120 --> 00:41:25,300
‫يا صديقي العزيز...

538
00:41:32,880 --> 00:41:36,460
!وُفِّقتَ يا إسكندر-ساما

539
00:42:55,960 --> 00:43:00,130
روائعُ كتبِ الثقافةِ الغربيةِ التي جلبها الإسكندرُ

540
00:43:00,160 --> 00:43:04,340
لأوّلِ مرّةٍ إلى بلادِ الشرقِ في حوضِ نهرِ السند

541
00:43:11,870 --> 00:43:17,600
أثمرت فنونًا بوذيّةً بطابعٍ يونانيّ أصيل

542
00:43:18,310 --> 00:43:21,720
امتدّ أثرها إلى أقاصي آسيا الوسطى وأرجاء الصين

543
00:43:21,720 --> 00:43:25,360
وصولًا إلى اليابان

544
00:43:28,550 --> 00:43:35,180
ولا شكّ أنّ الإسكندر نفسه لم يتوقّع مسار هذا التاريخ