1
00:00:00,810 --> 00:00:02,620
تأكيد أمر التّشغيل

2
00:00:03,100 --> 00:00:04,540
تفقّد النظام

3
00:00:05,910 --> 00:00:07,360
كلّ شيء آمن

4
00:00:07,360 --> 00:00:08,740
...الإعدادات الأوّلية

5
00:00:09,670 --> 00:00:10,820
تأكيد

6
00:00:10,820 --> 00:00:13,750
الرمز أوميغا 77 ستيلّا

7
00:00:13,750 --> 00:00:14,520
تفعيل

8
00:00:18,280 --> 00:00:19,330
آسفة

9
00:00:19,330 --> 00:00:21,050
هل أيقظتك؟

10
00:00:21,050 --> 00:00:22,280
أيقظتني؟

11
00:00:23,540 --> 00:00:26,040
كنتِ ظريفة للغاية

12
00:00:26,240 --> 00:00:27,360
ظريفة؟

13
00:00:27,360 --> 00:00:30,270
نعم، تهتُ بعض الشيء

14
00:00:30,270 --> 00:00:32,660
ثمّ وجدتُكِ هنا

15
00:00:33,010 --> 00:00:36,010
لم تكوني تتحرّكين لهذا ظننتُكِ دمية

16
00:00:36,120 --> 00:00:37,310
ها نحن ذا

17
00:00:37,510 --> 00:00:41,290
ومن ثمّ عندما لمستُكِ فقد شغّلتُكِ على ما أعتقد

18
00:00:42,780 --> 00:00:44,080
عُلِم

19
00:00:44,080 --> 00:00:47,020
أنتِ من العالم الأبيض، أليس كذلك؟

20
00:00:47,240 --> 00:00:49,120
جاري التأكيد من قاعدة البيانات

21
00:00:49,120 --> 00:00:54,100
أنا إنسانة آليّة من العالم الأبيض، نظام إيغوما الأبيض

22
00:00:54,100 --> 00:00:56,780
الرمز أوميغا 77 ستيلّا

23
00:00:57,200 --> 00:01:00,880
أنا محرّكة ألفا من هُنا، من العالم الأزرق

24
00:01:00,880 --> 00:01:02,810
أياشيرو أماني

25
00:01:02,810 --> 00:01:04,410
جاري التأكيد من قاعدة البيانات

26
00:01:04,850 --> 00:01:08,770
هذا هو العالم الأزرق، الأرق. جزيرة سِيران

27
00:01:08,770 --> 00:01:13,040
قولي لي يا ستيلّا، هل وُلِدتِ للتو؟

28
00:01:13,270 --> 00:01:16,540
،إن كنتِ تشيرين إلى تفعيلي ما بعد التّصنيع

29
00:01:16,540 --> 00:01:17,720
فالإجابة هي نعم

30
00:01:17,870 --> 00:01:19,280
!رائع

31
00:01:19,590 --> 00:01:21,880
!يوم ميلاد سعيد إذاً

32
00:01:31,430 --> 00:01:33,140
!رائع

33
00:01:33,360 --> 00:01:35,650
هل أنتِ صانعتي؟

34
00:01:35,650 --> 00:01:41,370
لا

35
00:01:36,780 --> 00:01:37,980
مُصمّمة؟

36
00:01:39,080 --> 00:01:40,250
صائنة؟

37
00:01:41,370 --> 00:01:43,330
مستخدمة؟ معلّمة؟

38
00:01:43,330 --> 00:01:44,610
مُشرفة؟

39
00:01:44,950 --> 00:01:46,060
لا

40
00:01:46,060 --> 00:01:48,130
هل أنتِ أمّي إذاً؟

41
00:01:49,020 --> 00:01:50,570
قد يكون هذا جيّداً

42
00:01:50,570 --> 00:01:51,330
!أمّكِ

43
00:01:51,490 --> 00:01:54,850
،أظنّني إن شغّلتُكِ ووُلِدتِ بسبب ذلك

44
00:01:54,850 --> 00:01:56,710
فهذا يعني أنّني أمّكِ

45
00:01:57,020 --> 00:01:58,680
جاري التأكيد من قاعدة البيانات

46
00:01:58,990 --> 00:02:04,270
ماما، أمّاه، مامي، والدة، أمّي

47
00:02:04,890 --> 00:02:05,720
ماما

48
00:02:06,290 --> 00:02:07,690
!حاضرة

49
00:02:10,280 --> 00:02:13,640
يحتوي الكون على خمسة عوالم مختلفة

50
00:02:15,040 --> 00:02:18,180
طوق الظلام: العالم الأسود

51
00:02:19,150 --> 00:02:22,170
فلَق تيرا روبيري: العالم الأحمر

52
00:02:23,060 --> 00:02:26,490
نظام إيغوما الأبيض: العالم الأبيض

53
00:02:27,190 --> 00:02:29,990
غرونوالد سيلت: العالم الأخضر

54
00:02:30,810 --> 00:02:34,160
وأخيراً، العالم الأزرق: الأرض

55
00:02:35,210 --> 00:02:38,560
ذات يوم، تتّصل العوالم الخمسة ببعضها

56
00:02:38,560 --> 00:02:40,570
وتواجه خطر الدمار

57
00:02:44,970 --> 00:02:47,600
،لإنقاذ العوالم

58
00:02:47,600 --> 00:02:52,450
"تجتمع الفتيات ذوات القوّة الخاصّة "إكشيد
في جزيرة سيران

59
00:02:53,240 --> 00:02:56,270
يُطلِق الناس عليهنّ اسم بروغريس

60
00:02:57,500 --> 00:03:01,320
تستطيع فتيات بروغريس استخدام قدرات أكثر قوّة بواسطة تعميق

61
00:03:01,320 --> 00:03:03,840
علاقتهن مع محرّكات ألفا الخاصّة بهنّ

62
00:03:06,390 --> 00:03:10,350
،لمنع العالم من الفناء، وارد إيند

63
00:03:11,000 --> 00:03:15,960
ستستمرّ هذه الفتيات في محاربة أعداء العالم، الأوروبوروس

64
00:04:47,730 --> 00:04:50,060
هل أنتِ بخير يا رامييل-تشان؟

65
00:04:51,900 --> 00:04:54,760
أجل، أنا بخير الآن

66
00:04:55,130 --> 00:04:57,980
يمكننا تطهير آثار السقوط إلى الجانب المظلم هنا

67
00:04:58,390 --> 00:05:02,040
لديها بضعة جروح ظاهريّة، لِذا ينبغي أن تتعافى بسرعة

68
00:05:02,360 --> 00:05:03,720
هذا عظيم

69
00:05:03,930 --> 00:05:06,350
أنا آسفة يا إليل-تشان

70
00:05:06,540 --> 00:05:08,660
قلتُ كلاماً قاسياً جدّاً

71
00:05:08,660 --> 00:05:10,700
لا، أنا آسفة أيضاً

72
00:05:11,370 --> 00:05:14,700
لم أفهم مشاعركِ طوال هذا الوقت

73
00:05:15,050 --> 00:05:16,890
هذا غير صحيح

74
00:05:16,890 --> 00:05:19,830
عرفتُ كم كنتِ لطيفة معي

75
00:05:20,140 --> 00:05:24,040
كنتُ لطيفة جدّاً لدرجة أنّني اعتدتُ على لطفكِ فحسب

76
00:05:24,650 --> 00:05:25,980
رامييل-تشان

77
00:05:26,340 --> 00:05:27,500
إليل-تشان

78
00:05:28,260 --> 00:05:29,290
...سنبقى دوماً

79
00:05:30,050 --> 00:05:30,750
أجل

80
00:05:31,400 --> 00:05:32,590
صديقتين

81
00:05:34,000 --> 00:05:39,100
أبطَلْنا أوروبوروس العالم الأسود والأحمر

82
00:05:39,490 --> 00:05:43,460
ما يعني أنّ هُناك عالمَين بأمان من أصل خمسة عوالم

83
00:05:43,770 --> 00:05:46,480
مقياس إكسترا قد تعافى قليلاً كذلك

84
00:05:46,480 --> 00:05:48,990
والزمن المتبقِّي حتّى نهاية العوالم
قد توسَّع

85
00:05:49,300 --> 00:05:55,730
لكن هنالك بروغريس ظلاميّات مختبئات في العالم الأزرق أيضاً

86
00:05:56,310 --> 00:06:00,490
وما زلنا لم نكتشف كيفيّة إنقاذ محرِّكة ألفا

87
00:06:01,120 --> 00:06:02,110
أجل

88
00:06:02,290 --> 00:06:06,160
لا يمكننا أن نستخدم إمكانياتنا الكاملة من دون محرّكات ألفا

89
00:06:06,510 --> 00:06:09,560
علينا أن نجد وسيلة لإخراجهن من هُناك
في أسرع وقت مُمكن

90
00:06:10,590 --> 00:06:11,650
نعم

91
00:06:11,830 --> 00:06:13,260
لنفعل ما يمكننا فعله

92
00:06:13,700 --> 00:06:14,950
شكراً لك

93
00:06:19,520 --> 00:06:22,770
!هل أنتِ جاهزة لتدريبكِ الخاصّ أيّتها الملازم ثاني مايوكا؟

94
00:06:23,310 --> 00:06:24,520
!جاهزة سيّدتي

95
00:06:24,850 --> 00:06:27,190
...اليوم سوف

96
00:06:28,270 --> 00:06:29,490
!نستريح

97
00:06:30,720 --> 00:06:31,620
!مرحى

98
00:06:31,620 --> 00:06:32,800
!لا يوجد تدريب

99
00:06:32,800 --> 00:06:34,780
!أوني-تشان، لنذهب ونستمتع

100
00:06:34,780 --> 00:06:35,850
!صفعة

101
00:06:37,130 --> 00:06:38,990
!لم أقل أنّه بمقدوركِ أن تلعبي

102
00:06:39,210 --> 00:06:41,900
!لكن قلتِ أنّنا سنستريح

103
00:06:41,900 --> 00:06:43,140
!ليس هذا ما قصدت

104
00:06:43,140 --> 00:06:46,370
!سندرس كيف ينبغي أن ترتاحي اليوم

105
00:06:46,370 --> 00:06:47,580
كيف أرتاح؟

106
00:06:47,890 --> 00:06:50,330
يحتاج الجنود إلى الرَّاحة أيضاً

107
00:06:50,330 --> 00:06:54,050
لا يستطيعون تحقيق نتائج بجسد مُنهَك

108
00:06:54,050 --> 00:06:56,430
السؤال هو كيف ترتاحين في ساحة معركة
بأفضل فاعلية مُمكنة

109
00:06:56,430 --> 00:06:59,560
في مكانٍ لا يجوز أن تسترخي فيه ولو للحظة

110
00:06:59,560 --> 00:07:01,520
،وتسمعين فيه أصوات الرّصاص والقنابل باستمرار

111
00:07:01,520 --> 00:07:04,270
—وباستمرار حدوث ذلك سيغدو من الصّعب الحصول على

112
00:07:04,650 --> 00:07:06,660
!لا تنامي

113
00:07:06,660 --> 00:07:09,780
...قلتِ أنّنا سنتمرّن على الرّاحة، لذا

114
00:07:10,340 --> 00:07:11,320
!مئة بالمئة

115
00:07:11,320 --> 00:07:12,730
!نجحتِ

116
00:07:12,990 --> 00:07:15,280
!انتهى التّدريب

117
00:07:15,280 --> 00:07:16,640
لم يعُد في جُعبتي المزيد

118
00:07:16,640 --> 00:07:18,150
سنعود إلى مهمّتنا الاعتياديّة

119
00:07:18,150 --> 00:07:19,080
مهلاً

120
00:07:19,080 --> 00:07:21,320
دعينا نتمرّن على الرّاحة أكثر

121
00:07:21,740 --> 00:07:25,170
لا حاجة للقيام بهذا مع فتاة تستطيع
النّوم في أي مكان

122
00:07:26,600 --> 00:07:29,790
وأنا التي ظننتُ أنّني أستطيعُ أخيراً
أن أحظى بفرصة قضاء الوقت معكِ أيضاً

123
00:07:31,860 --> 00:07:34,630
حسناً، لبعض الوقت فقط

124
00:07:37,350 --> 00:07:38,910
أوني-تشان

125
00:07:38,910 --> 00:07:39,860
ما الأمر؟

126
00:07:40,070 --> 00:07:44,010
لا أستطيع النّوم من دون وسادتي

127
00:07:44,010 --> 00:07:45,590
...كنتِ نائمة للتو

128
00:07:45,960 --> 00:07:49,320
أريدُ النوم على ذراعكِ

129
00:07:49,730 --> 00:07:52,690
كم أنتِ سخيفة

130
00:07:52,810 --> 00:07:54,160
مرحى

131
00:07:55,450 --> 00:07:57,850
أتعتقدين أنّكِ تستطيعين النّوم الآن؟

132
00:07:58,350 --> 00:07:59,640
لا

133
00:08:00,780 --> 00:08:01,780
ما الخطب؟

134
00:08:02,400 --> 00:08:05,790
لا أستطيع النّوم من دون حضن حيواني المحشو

135
00:08:06,010 --> 00:08:09,660
هل أحضرتِ شيئاً كهذا إلى مرابِع نومنا؟

136
00:08:09,660 --> 00:08:13,210
هل يمكنني أن أحضنكِ بدلاً من ذلك يا أوني-تشان؟

137
00:08:14,220 --> 00:08:15,470
أرجوكِ

138
00:08:16,240 --> 00:08:18,720
قـ-قليلاً فقط

139
00:08:18,720 --> 00:08:19,810
مرحى

140
00:08:20,080 --> 00:08:23,620
لن تتمكّني من البقاء في ساحة المعركة هكذا

141
00:08:23,620 --> 00:08:26,090
عليكِ أن تكوني قادرة على البقاء تحتَ
أي ظرف من الظروف

142
00:08:26,970 --> 00:08:29,180
المُلازم الثاني مايوكا، هل تسمعينني؟

143
00:08:29,180 --> 00:08:30,450
مايوكا؟

144
00:08:47,810 --> 00:08:49,230
سايا-تشان

145
00:08:50,090 --> 00:08:51,780
فاجأتِني

146
00:08:51,780 --> 00:08:53,660
على رسلكِ يا إليل

147
00:08:54,210 --> 00:08:55,490
آسفة

148
00:08:56,150 --> 00:08:58,070
كيف كان حال رامييل-سان؟

149
00:08:58,900 --> 00:09:00,530
قالت أنّها ستتعافى بسرعة

150
00:09:00,780 --> 00:09:02,650
ساعدتِني حقّاً يا سايا-تشان

151
00:09:03,090 --> 00:09:04,980
لم أفعل شيئاً

152
00:09:05,220 --> 00:09:06,270
لا

153
00:09:06,270 --> 00:09:08,630
ساعدتِني على الإدراك

154
00:09:09,160 --> 00:09:11,640
لا ينبغي أن أستسلم فقط لكوني لم أفهمها

155
00:09:11,640 --> 00:09:14,320
المهمّ هو مُحاولة فهم الآخر

156
00:09:14,640 --> 00:09:16,590
...لأم أكن أنا

157
00:09:16,590 --> 00:09:18,000
...هيناتا-سينباي أخبرَتْني

158
00:09:18,000 --> 00:09:19,810
لكن أنتِ من ساعدني

159
00:09:20,120 --> 00:09:21,870
،لأنّكِ قلتِ ذلك الكلام لي

160
00:09:21,870 --> 00:09:24,580
استطعتُ أن أصبح صديقة مُقرّبة لرامييل-تشان

161
00:09:24,970 --> 00:09:26,890
نعم

162
00:09:30,390 --> 00:09:33,240
ضمن هامش الخطأ... لا مشكلة

163
00:09:33,510 --> 00:09:36,590
سايا-تشان، سأغسلُ ظهركِ

164
00:09:36,590 --> 00:09:37,780
شكراً لكِ

165
00:09:37,780 --> 00:09:38,830
سأفعلُ أيضاً

166
00:09:38,830 --> 00:09:40,260
لا، لن أدعك

167
00:09:41,470 --> 00:09:45,300
أنا الوحيدة التي يُسمَح لها بغسلِ ظهر سايا

168
00:09:45,490 --> 00:09:47,490
ما قصّتكِ؟

169
00:09:47,490 --> 00:09:48,600
من يأبه؟

170
00:09:48,600 --> 00:09:51,180
أنا وسايا-تشان صديقتان

171
00:09:51,180 --> 00:09:52,010
لا

172
00:09:52,280 --> 00:09:54,900
،غسيل ظهرها، غسيل شعرها

173
00:09:55,110 --> 00:09:58,030
،قصّ أظافرها، تنظيف أذنيها بينما تستلقي على حضني

174
00:09:58,200 --> 00:09:59,910
،كلّ ما نستطيع فعله

175
00:10:00,160 --> 00:10:01,160
...كلّه

176
00:10:01,280 --> 00:10:02,820
.هو عملي أنا

177
00:10:03,540 --> 00:10:06,300
...كما ترين، سايا وأنا

178
00:10:07,440 --> 00:10:10,120
أكثر من صديقتَين

179
00:10:10,640 --> 00:10:12,120
لا بأس في ذلك

180
00:10:12,120 --> 00:10:15,880
إذاً سايا وأنا أكثر من أكثر من صديقتَين

181
00:10:16,180 --> 00:10:17,710
ماذا قلتِ؟

182
00:10:17,870 --> 00:10:22,120
!إذاً أنا أكثر من أكثر من أكثر من صديقة لها

183
00:10:22,280 --> 00:10:26,810
لا، نحنُ أكثر من أكثر من أكثر
من أكثر من صديقتين

184
00:10:30,580 --> 00:10:32,980
كم هي أجواء هادئة

185
00:10:35,590 --> 00:10:38,890
بيانات المعركة والطيران، تصدير

186
00:10:39,170 --> 00:10:42,930
رمز تغيير واستمثال النظام، تشغيل

187
00:10:42,930 --> 00:10:45,360
ضبط التّحديث

188
00:10:43,450 --> 00:10:45,710
ستيلّا، ماذا تفعلين؟

189
00:10:46,060 --> 00:10:47,120
توليف

190
00:10:47,120 --> 00:10:48,340
توليف؟

191
00:10:48,340 --> 00:10:50,560
توليف الإعدادات لتعزيز سرعتي

192
00:10:51,470 --> 00:10:54,640
المهمّ أن تكوني أسرع في القتال

193
00:10:54,640 --> 00:10:55,330
لا

194
00:10:55,860 --> 00:10:56,590
ماذا؟

195
00:10:56,870 --> 00:10:58,340
أريدُ أن أكون أسرع

196
00:11:01,110 --> 00:11:03,050
هذا كُل ما في الأمر

197
00:11:08,950 --> 00:11:11,220
دعيني أرى ما لديك

198
00:11:11,730 --> 00:11:16,070
دعيني أرى مقدِرات الإنسانة الآليّة
من العالم الأبيض في القتال

199
00:11:16,070 --> 00:11:18,190
قوّة منفصلة عن سوفينا ورامييل

200
00:11:19,360 --> 00:11:21,020
...مللتُ للغاية

201
00:11:21,920 --> 00:11:25,990
أريدُ أن ألعب قبل أن أتدمّر

202
00:11:26,460 --> 00:11:32,100
