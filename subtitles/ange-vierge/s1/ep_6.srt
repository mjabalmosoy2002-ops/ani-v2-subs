1
00:00:03,560 --> 00:00:07,520
!أنا هنا في أكاديميّة سيران

2
00:00:07,520 --> 00:00:10,560
!هذا هو شكل العالم الأزرق

3
00:00:11,860 --> 00:00:13,200
ها نحن ذا

4
00:00:14,820 --> 00:00:17,600
!هنالك الكثير من النّاس القادمين من عوالم أخرى

5
00:00:19,950 --> 00:00:25,100
!سأتعرّف على كثير من الصّديقات

6
00:00:26,020 --> 00:00:27,370
لم أركِ منذ وقت طويل

7
00:00:28,690 --> 00:00:30,340
آه صحيح

8
00:00:30,340 --> 00:00:32,940
...لم أركِ منذ زمن

9
00:00:33,260 --> 00:00:35,850
نسيتُ من تكون هذه الفتاة

10
00:00:35,850 --> 00:00:36,710
كيف حالكِ؟

11
00:00:37,020 --> 00:00:39,290
نـ-نعم، أنا بخير

12
00:00:39,290 --> 00:00:41,610
أين التقيتُ بها بالضبط؟

13
00:00:39,620 --> 00:00:41,220
ماذا عنكِ؟

14
00:00:41,610 --> 00:00:42,620
أنا؟

15
00:00:42,620 --> 00:00:44,350
!في أحسن حال

16
00:00:45,540 --> 00:00:46,940
...من هي

17
00:00:47,450 --> 00:00:48,770
لا أتذكّر

18
00:00:49,240 --> 00:00:52,620
متى التقينا آخر مرّة؟

19
00:00:52,620 --> 00:00:53,410
ماذا؟

20
00:00:53,570 --> 00:00:56,400
يا للهول! ستدرك أنّني لا أتذكّرها

21
00:00:56,550 --> 00:00:58,740
هل خسرتِ وزناً؟

22
00:00:58,740 --> 00:01:00,600
لم أعرفكِ

23
00:01:02,800 --> 00:01:04,250
بل زاد وزني قليلاً

24
00:01:04,250 --> 00:01:06,340
الطعام هنا لذيذ للغاية

25
00:01:06,340 --> 00:01:07,190
هذا سيّئ

26
00:01:07,190 --> 00:01:08,120
ماذا ينبغي أن أفعل؟

27
00:01:08,320 --> 00:01:10,490
هـ-هذا الحذاء ظريف

28
00:01:10,490 --> 00:01:12,050
أين اشتريتِه؟

29
00:01:12,050 --> 00:01:15,260
هذا حذاء التّمرين الذي تطلبُ منّا المدرسة ارتداؤه

30
00:01:17,360 --> 00:01:18,170
هل قصصتِ شعركِ؟

31
00:01:18,570 --> 00:01:19,380
لا

32
00:01:19,550 --> 00:01:22,120
!ماذا أفعل؟ ماذا أفعل؟ ماذا أفعل؟

33
00:01:22,120 --> 00:01:26,400
...أردتُ أن أشكّل صديقات، لكنّني نسيتُ صديقة

34
00:01:26,400 --> 00:01:27,870
!هذا مستحيل

35
00:01:27,870 --> 00:01:30,410
حسناً، من أنتِ؟

36
00:01:30,410 --> 00:01:31,150
ماذا؟

37
00:01:31,360 --> 00:01:33,210
هل سبقَ وأن التقينا؟

38
00:01:33,210 --> 00:01:34,010
ماذا؟

39
00:01:34,010 --> 00:01:35,610
لم نلتقِ؟

40
00:01:37,280 --> 00:01:39,060
لا أتذكّر

41
00:01:39,060 --> 00:01:42,650
لحظة، لماذا قلتِ إذاً "لم أركِ منذُ وقت طويل"؟

42
00:01:43,070 --> 00:01:46,960
قلتِ أنّكِ ستتعرّفين على صديقات لهذا أردتُ
قول أي شيء

43
00:01:46,960 --> 00:01:52,660
أردتُ أن أقول مرحباً، لكن توتّرتُ وقلتُ
أنّني لم أركِ منذُ وقت طويل بدلاً من ذلك

44
00:01:53,650 --> 00:01:56,920
...ماذا... لماذا تقولين

45
00:01:58,280 --> 00:01:59,610
آسفة

46
00:02:00,360 --> 00:02:01,840
اسمي إيليل

47
00:02:01,840 --> 00:02:05,000
أنا ملاكٌ من العالم الأحمر، فلَق تيرا روبيري

48
00:02:05,780 --> 00:02:07,120
وأنا أماني

49
00:02:07,120 --> 00:02:08,460
أياشيرو أماني

50
00:02:08,670 --> 00:02:10,100
أماني-تشان، صحيح؟

51
00:02:10,100 --> 00:02:13,680
هذا يجعلنا صديقتَين

52
00:02:13,680 --> 00:02:14,680
أجل

53
00:02:17,030 --> 00:02:20,520
يحتوي الكون على خمسة عوالم مختلفة

54
00:02:21,770 --> 00:02:25,340
طوق الظلام: العالم الأسود

55
00:02:25,790 --> 00:02:29,050
فلَق تيرا روبيري: العالم الأحمر

56
00:02:29,780 --> 00:02:33,340
نظام إيغوما الأبيض: العالم الأبيض

57
00:02:33,850 --> 00:02:37,010
غرونوالد سيلت: العالم الأخضر

58
00:02:37,720 --> 00:02:41,340
وأخيراً، العالم الأزرق: الأرض

59
00:02:42,670 --> 00:02:46,520
ذات يوم، تتّصل العوالم الخمسة ببعضها

60
00:02:46,520 --> 00:02:48,660
وتواجه الدّمار

61
00:02:51,800 --> 00:02:54,550
،لإنقاذ العوالم

62
00:02:54,550 --> 00:03:00,570
"تجتمع الفتيات ذوات القوّة الخاصّة "إكشيد
في جزيرة سيران

63
00:03:01,150 --> 00:03:04,700
يُطلِق الناس عليهنّ اسم بروغريس

64
00:03:05,330 --> 00:03:09,860
تستطيع فتيات بروغريس استخدام قدرات أكثر قوّة بواسطة تعميق

65
00:03:09,860 --> 00:03:12,580
علاقتهن مع محرّكات ألفا الخاصّة بهنّ

66
00:03:13,460 --> 00:03:18,010
،لمنع العالم من الفناء، وارد إيند

67
00:03:18,010 --> 00:03:22,550
ستستمرّ هذه الفتيات في محاربة أعداء العالم، الأوروبوروس

68
00:04:57,010 --> 00:04:58,930
هذا يبعثُ على الحيوية

69
00:04:58,930 --> 00:05:00,770
سايا، هل كنتِ ميّتة؟

70
00:05:00,770 --> 00:05:02,220
إطلاقاً

71
00:05:02,450 --> 00:05:06,190
نعم، لكن كادت تلك المعركة أن تؤدّي إلى مقتلنا

72
00:05:06,190 --> 00:05:09,410
أجل، أنا مستغربة من بقائنا على قيد الحياة

73
00:05:09,660 --> 00:05:10,990
لعلّها كانت معجزة

74
00:05:11,880 --> 00:05:13,770
ما الخطب يا آلماريا؟

75
00:05:13,770 --> 00:05:15,490
لا شيء على الإطلاق

76
00:05:15,490 --> 00:05:16,120
حقّاً؟

77
00:05:16,460 --> 00:05:18,690
تتصرّفين بغرابة منذُ عودتنا

78
00:05:18,690 --> 00:05:20,380
أنتِ ملتصقة بسايا-تشان

79
00:05:20,380 --> 00:05:22,010
هذا غير صحيح

80
00:05:22,010 --> 00:05:24,390
فقد كنتُ أقف بجانب سايا-تشان دائماً

81
00:05:25,520 --> 00:05:27,800
سايا لطيفة وحكيمة

82
00:05:27,800 --> 00:05:29,880
إنّها شجاعة ورائعة ببساطة

83
00:05:30,410 --> 00:05:33,090
إنّها أكثر فتاة أحترمها

84
00:05:33,290 --> 00:05:34,840
ما الخطب يا آلماريا؟

85
00:05:34,840 --> 00:05:36,800
لم تقولي كلاماً كهذا من قبل

86
00:05:37,060 --> 00:05:38,680
لم أقله أبداً

87
00:05:38,680 --> 00:05:40,270
لكنّني كنتُ أفكّر به دوماً

88
00:05:40,560 --> 00:05:42,310
صدّقيني يا سايا

89
00:05:42,310 --> 00:05:44,400
شكراً يا آلماريا

90
00:05:44,510 --> 00:05:46,690
...لا تناديني آلماريا

91
00:05:46,690 --> 00:05:49,010
...ماذا؟ حسناً، إذاً أ-ألما

92
00:05:49,010 --> 00:05:49,520
نعم

93
00:05:49,920 --> 00:05:51,690
والآن هل يمكنني أن أمصّ دمائكِ؟

94
00:05:52,820 --> 00:05:54,220
قليلاً فقط

95
00:05:54,810 --> 00:05:56,370
سأحرص على ألّا يؤلمكِ ذلك

96
00:05:56,540 --> 00:05:58,360
!انتظري لحظة يا آلماريا

97
00:05:58,580 --> 00:06:00,120
!ناديني آلما

98
00:06:00,270 --> 00:06:02,510
!انتظري! توقّفي

99
00:06:02,510 --> 00:06:03,800
ما الأمر؟

100
00:06:03,800 --> 00:06:05,840
قلتِ أنّ بمقدوري امتصاص دمائكِ

101
00:06:06,000 --> 00:06:08,290
لم أقصد طوال الوقت

102
00:06:08,290 --> 00:06:09,910
هل أعاني من مُشكلة في نظركِ؟

103
00:06:09,910 --> 00:06:11,750
ليس هذا ما قصدت

104
00:06:11,750 --> 00:06:13,960
امتصاص دمائكِ يساعدكِ على تخفيف الوزن

105
00:06:14,150 --> 00:06:15,190
حقّاً؟

106
00:06:15,190 --> 00:06:16,780
امتصّي دمي أنا إذاً

107
00:06:16,780 --> 00:06:18,470
أفضّلُ أن يخفّ وزني أيضاً

108
00:06:18,470 --> 00:06:20,440
لا أريد أن أمتصّ سوى دماء سايا

109
00:06:20,630 --> 00:06:21,850
لماذا؟

110
00:06:21,850 --> 00:06:24,700
كنتِ تتحدّثين عن قذارته

111
00:06:24,700 --> 00:06:26,410
لا مانع إن أُقحِمَ الحبّ في الأمر

112
00:06:26,410 --> 00:06:27,420
أليس كذلك يا سايا؟

113
00:06:29,340 --> 00:06:31,050
أنا جائعة

114
00:06:31,050 --> 00:06:32,410
أريد أن آكل شيئاً

115
00:06:32,410 --> 00:06:33,920
أريدُ أم أمتصّ دماء

116
00:06:33,920 --> 00:06:35,030
مـ-مهلاً

117
00:06:35,300 --> 00:06:36,490
ما رأيكِ بكيس دم؟

118
00:06:37,000 --> 00:06:39,930
لا أستطيع وضع دم شخص مجهول في فمي

119
00:06:39,930 --> 00:06:40,570
أنتِ قريبة جدّاً

120
00:06:40,570 --> 00:06:43,990
قد أملئ معدتي لكن سيكون قلبي فارغاً

121
00:06:44,240 --> 00:06:47,730
أريدُ أن أملئ نفسي بسايا

122
00:06:47,730 --> 00:06:49,290
أنتِ غير منطقيّة

123
00:06:50,180 --> 00:06:52,690
يا لها من مزعجة

124
00:06:54,090 --> 00:06:56,920
سرعة اقتراب العوالم الخمسة تتباطأ

125
00:06:57,310 --> 00:06:59,850
كانت الإكسترا تنبعث من البروغريس

126
00:06:59,850 --> 00:07:02,900
اللّاتي عُدنَ إلى طبيعتهن الآن بعدما حرّرناهن

127
00:07:03,240 --> 00:07:06,250
قضينا على الأوروبوروس في العالم الأسود

128
00:07:06,430 --> 00:07:08,110
ستكون الأمور آمنة لبعض الوقت

129
00:07:08,520 --> 00:07:10,220
لكن لا يجوز أن نتفاءل كثيراً

130
00:07:10,220 --> 00:07:13,370
في هذه الحالة فإنّ نهاية العالم ليسَتْ سوى مسألة وقت

131
00:07:17,530 --> 00:07:19,930
!سنبدأ بتدريبنا الخاصّ

132
00:07:19,930 --> 00:07:20,950
!حاضرة سيّدتي

133
00:07:21,310 --> 00:07:23,850
سنتمرّن على الأكل لأجل البقاء

134
00:07:24,040 --> 00:07:25,700
ماذا؟ مجدّداً؟

135
00:07:25,700 --> 00:07:26,510
!صفعة

136
00:07:27,330 --> 00:07:30,390
!كيف تجرؤين على الردّ على ضابطة أعلى منكِ؟

137
00:07:30,390 --> 00:07:33,300
نعم، لكن فعلنا ذلك قبل أيّام

138
00:07:33,300 --> 00:07:35,210
وقد تحسّنت

139
00:07:36,030 --> 00:07:38,080
كُرات أرزّ الرّوليت الروسيّة

140
00:07:38,080 --> 00:07:40,240
خمسة منها تحتوي على صلصة حارّة للغاية

141
00:07:40,240 --> 00:07:43,670
لقد تمكّنتُ من اختيار الصّحيحة منها لمرّة واحدة
في كلّ ستّ مرّات

142
00:07:45,030 --> 00:07:48,600
باعتباركِ كنتِ تخطئين في كلّ مرّة فهذه نتيجة مقبولة جدّاً

143
00:07:48,780 --> 00:07:50,520
لكنّنا سنخضعُ لتدريب مختلف اليوم

144
00:07:51,060 --> 00:07:52,730
ما هو؟

145
00:07:53,140 --> 00:07:55,740
سنؤدّي شيئاً أكثر عمليّة

146
00:07:55,740 --> 00:07:59,440
سأدعكِ تأكلين الأشياء الفعليّة التي تجدينها في الطبيعة

147
00:07:59,440 --> 00:08:01,570
ماذا سآكل؟

148
00:08:01,680 --> 00:08:04,670
!أي شيء لا يأكلكِ هو طعام

149
00:08:05,130 --> 00:08:05,750
انظري إلى هذا

150
00:08:06,190 --> 00:08:08,060
هل سيأكلكِ؟

151
00:08:08,060 --> 00:08:08,960
لا

152
00:08:09,180 --> 00:08:11,210
إنّه مصدر مُمتاز للبروتين إذاً

153
00:08:11,620 --> 00:08:12,790
ماذا عن هذه؟

154
00:08:12,790 --> 00:08:17,340
مصدر مُمتاز للبروتين

155
00:08:14,790 --> 00:08:15,770
وعن هذه؟

156
00:08:17,750 --> 00:08:19,300
!لنجرّبها الآن

157
00:08:20,600 --> 00:08:22,890
...أوني-تشان، لا أستطيع أكل حشرات

158
00:08:22,890 --> 00:08:23,570
!صفعة

159
00:08:24,010 --> 00:08:26,080
قلتُ لكِ ناديني بالمُقدّم

160
00:08:26,450 --> 00:08:29,390
أظنُّنا علينا تسهيل الأمر فحسب

161
00:08:29,390 --> 00:08:32,540
إن كنتِ لا تستطيعين أكل حشرات فعلينا أن نجرّب حيوان أكبر

162
00:08:34,470 --> 00:08:36,560
!ماموث

163
00:08:36,930 --> 00:08:37,980
ما هذا؟

164
00:08:37,980 --> 00:08:40,270
مصدر مُمتاز للبروتين

165
00:08:45,670 --> 00:08:48,030
!لا! هذا غير صحيح

166
00:08:48,340 --> 00:08:51,170
!لا ينتابني هذا الإحساس تجاهك

167
00:08:51,790 --> 00:08:53,130
أعلم

168
00:08:53,130 --> 00:08:55,010
لا عليكِ يا سوفينا-سينباي

169
00:08:55,290 --> 00:08:58,250
كان الأوروبورس يتحكّمون بي

170
00:08:58,250 --> 00:08:59,880
...لهذا عندما قلتُ أنّني احتجتُكِ

171
00:09:00,150 --> 00:09:01,340
أعلم

172
00:09:01,340 --> 00:09:02,140
لا عليكِ

173
00:09:02,290 --> 00:09:03,620
!لا تعلمين

174
00:09:03,620 --> 00:09:05,210
!لا تعلمين إطلاقاً

175
00:09:05,190 --> 00:09:06,480
...المعذرة

176
00:09:07,150 --> 00:09:08,680
،عند السقوط في الجانب المُظلم

177
00:09:08,680 --> 00:09:12,690
فإنّ غريزة الأوروبورس تجعلكِ ترغبين بتدمير العالم

178
00:09:13,030 --> 00:09:17,200
لكنّكِ تفقدين العقلانيّة وتتضخّم عواطفكِ أيضاً

179
00:09:17,520 --> 00:09:19,250
تتضخّم العواطف؟

180
00:09:19,510 --> 00:09:22,340
،هذا ما قالته الدكتورة ميهايل

181
00:09:22,340 --> 00:09:23,620
لكن لستُ أدري ما يعنيه هذا بالضبط

182
00:09:24,190 --> 00:09:26,750
أنا متأكّدة أنّه يعني أنّكِ تفيضين بما تفكّرين وتشعرين به

183
00:09:27,330 --> 00:09:29,450
.كلّ الأشياء التي تشعرين فيها والتي كبتِّها

184
00:09:30,400 --> 00:09:32,420
!لكن هذا غير صحيح

185
00:09:32,730 --> 00:09:34,630
!صدّقنَني، غير صحيح

186
00:09:35,070 --> 00:09:37,590
لا عليكِ يا سوفينا-سينباي

187
00:09:37,990 --> 00:09:41,550
شعوركِ خاصّ تجاهي، صحيح؟

188
00:09:42,230 --> 00:09:43,390
...آلما

189
00:09:44,080 --> 00:09:45,810
أنا سعيدة

190
00:09:47,780 --> 00:09:48,900
أيّتها البلهاء

191
00:09:50,380 --> 00:09:51,940
!وأنتِ

192
00:09:51,940 --> 00:09:53,660
أ-أنا؟

193
00:09:53,860 --> 00:09:55,660
!إيّاك والظنّ أنّكِ ربحتِ

194
00:09:55,990 --> 00:09:57,360
...نـ-نعم

195
00:09:57,770 --> 00:10:00,360
أنا أربح دوماً

196
00:10:00,620 --> 00:10:02,920
!لا تستثني ساحرة الحقيقة السّوداء

197
00:10:03,390 --> 00:10:04,950
!هذه هي سينباي التي عهِدناها

198
00:10:04,950 --> 00:10:06,130
!أنتِ رائعة

199
00:10:08,130 --> 00:10:10,720
...استرجعنَ العالم الأسود إذاً

200
00:10:10,720 --> 00:10:11,860
لا بأس

201
00:10:11,860 --> 00:10:14,830
سقوط العوالم ليس سوى مسألة وقت

202
00:10:15,230 --> 00:10:19,880
سينجح هدفُ الأوروبوروس حتّى من دون أن نشرع بالعمل

203
00:10:20,080 --> 00:10:21,150
...لكن

204
00:10:21,150 --> 00:10:23,760
لن يكون هذا ممتعاً

205
00:10:24,840 --> 00:10:26,930
المهمّة مُدرَجة في البرنامج

206
00:10:27,230 --> 00:10:30,310
أتساءلُ ما إن كان سيحين دوري قريباً

207
00:10:36,870 --> 00:10:41,000
...أردتُ أن أكون أختكِ الكبرى، لكن

208
00:10:43,250 --> 00:10:46,390
انتهى المطاف بإنقاذها لي بدلاً من ذلك

209
00:10:46,810 --> 00:10:48,300
آلماريا

210
00:10:48,370 --> 00:10:51,160
حان دوري لإنقاذ أماني

211
00:10:51,540 --> 00:10:55,260
ليس كأختها الكبرى، إنّما كشريكتها

212
00:10:55,390 --> 00:10:56,400
هذا صحيح

213
00:10:56,400 --> 00:10:57,770
علينا أن نستعيدها

214
00:10:57,770 --> 00:10:58,670
إيليل

215
00:10:58,810 --> 00:11:02,030
أماني-تشان هي صديقتي الهامّة

216
00:11:03,880 --> 00:11:07,800
كانت أوّل صديقة أتعرّفُ عليها بعد
المجيء إلى جزيرة سيران

217
00:11:07,800 --> 00:11:09,450
سوف أنقذها

218
00:11:09,450 --> 00:11:10,480
نعم

219
00:11:11,460 --> 00:11:12,960
هيناتا-سينباي

220
00:11:13,350 --> 00:11:17,680
عليكِ أن تعيدي ذلك الرّابط الخاصّ
الذي يربطكِ بمحرّكة ألفا خاصّتكِ

221
00:11:17,930 --> 00:11:20,030
هذه هي مهمّتكِ المقبلة

222
00:11:20,290 --> 00:11:21,530
مهمّة؟

223
00:11:21,800 --> 00:11:23,830
زال الخطر عن العالم الأسود الآن

224
00:11:24,140 --> 00:11:29,130
لكن احتمال استهداف الأوروبوروس لبلُّورة عالم أخرى وارد كثيراً

225
00:11:29,300 --> 00:11:32,750
لهذا علينا التصدِّي للعدوّ قبل أن يحظى بفرصة للهجوم

226
00:11:32,960 --> 00:11:35,740
نودُّ أن نكلّفكم بمهمّة استطلاع

227
00:11:36,070 --> 00:11:38,290
نفعل هذا بعد أخذ إنجازاتكن حتّى الآن بعين الاعتبار

228
00:11:38,680 --> 00:11:40,760
والآن علينا أن نعالج المزيد من المشاكل

229
00:11:41,240 --> 00:11:43,400
أريدُ أن أتفقّد حال العوالم الأخرى

230
00:11:43,680 --> 00:11:44,980
هل يمكننا الاعتماد عليكن؟

231
00:11:46,700 --> 00:11:49,580
يبدو أنّها ستغدو مهمّة خطيرة

232
00:11:49,580 --> 00:11:52,620
هذه إصبعي

233
00:11:53,200 --> 00:11:54,970
سايا لذيذة

234
00:11:54,970 --> 00:11:55,860
حقّاً؟

235
00:11:55,860 --> 00:11:56,930
أريدُ أن أتذوّق أيضاً

236
00:11:57,420 --> 00:11:58,150
أنا أيضاً

237
00:11:58,320 --> 00:11:59,910
!لا

238
00:12:00,180 --> 00:12:01,890
ماذا؟ لماذا؟

239
00:12:02,780 --> 00:12:05,360
ما طعمها يا تُرى؟

240
00:12:05,530 --> 00:12:07,070
يا فتيات، هيّا بنا

241
00:12:09,240 --> 00:12:10,350
...سنذهب إلى

242
00:12:10,990 --> 00:12:12,270
،العالم الأحمر

243
00:12:12,270 --> 00:12:14,050
فلَق تيرا روبيري

244
00:12:14,870 --> 00:12:17,560
توخّين الحذر جميعاً

245
00:12:20,440 --> 00:12:22,620
ما شكل العالم الأحمر

246
00:12:22,870 --> 00:12:25,500
إنّه العالم التي تحميه الآلهة والصّلوات

247
00:12:25,720 --> 00:12:28,840
إنّه بعكس العالم الأسود الذي تعيشُ فيه الوحوش

248
00:12:29,580 --> 00:12:32,720
وهو بعكس العالم الأبيض وفضائه السيبراني أيضاً

249
00:12:33,000 --> 00:12:36,810
ومختلف عن الحالة العسكريّة الباردة في العالم الأخضر

250
00:12:36,980 --> 00:12:39,280
مختلف عن كلّ شيء إذاً

251
00:12:39,280 --> 00:12:40,770
العالم الأزرق مختلف

252
00:12:41,000 --> 00:12:43,250
نعم، فيه كلّ شيء

253
00:12:43,610 --> 00:12:46,990
أعتقدُ أنّ هذا هو سبب اتّصال العالم الأزرق بالعوالم الأخرى

254
00:12:47,870 --> 00:12:49,290
اقتربنا من الوصول

255
00:12:50,590 --> 00:12:51,190
ما هذا؟

256
00:12:51,670 --> 00:12:52,690
ما الذي يجري؟

257
00:12:52,900 --> 00:12:54,200
...هل هذا

258
00:12:54,200 --> 00:12:55,030
شكل العالم الأحمر؟

259
00:12:55,210 --> 00:12:56,440
لا

260
00:12:56,440 --> 00:12:57,240
...هذا ليس

261
00:12:59,170 --> 00:13:01,200
!إيليل

262
00:13:01,900 --> 00:13:04,460
!أنتُنّ

263
00:13:09,630 --> 00:13:11,060
...مؤلم

264
00:13:11,060 --> 00:13:12,260
أين نحن؟

265
00:13:12,880 --> 00:13:15,750
...لا أشعر أنّه عالم الآلهة

266
00:13:16,790 --> 00:13:19,090
إنّه أشبه بمتاهة

267
00:13:20,160 --> 00:13:22,890
لا شيء في السّونار أو الرّادار

268
00:13:23,060 --> 00:13:25,490
الاتّصالات صامتة

269
00:13:25,730 --> 00:13:27,390
فخّ؟

270
00:13:27,390 --> 00:13:28,510
ماذا عن إيليل؟

271
00:13:28,510 --> 00:13:29,660
أين إيليل؟

272
00:13:29,660 --> 00:13:32,860
قُذِفَتْ إلى مكان ما بينما كنّا في الهالة

273
00:13:33,210 --> 00:13:34,520
...هذا مستحيل

274
00:13:37,310 --> 00:13:38,800
هل استيقظتِ؟

275
00:13:43,910 --> 00:13:45,310
رامييل-تشان

276
00:13:46,190 --> 00:13:47,470
تحوّلتِ؟

277
00:13:49,240 --> 00:13:50,180
...إذاً

278
00:13:50,380 --> 00:13:52,460
ما رأيكِ بهذين الجناحين؟

279
00:13:52,460 --> 00:13:53,870
إنّهما رائعان، صحيح؟

280
00:13:53,870 --> 00:13:56,670
حصلتُ على جناحَيّ أيضاً

281
00:13:56,840 --> 00:13:59,760
لكن ماذا عن جناح النّور الخاصّ بكِ؟

282
00:13:59,760 --> 00:14:02,850
يظهرُ فقط عندما أتّصِل بمحرّكة ألفا خاصّتي

283
00:14:02,850 --> 00:14:05,400
لكن أستطيعُ الآن الرّفرفة بهما متى شئت

284
00:14:05,400 --> 00:14:07,830
أستطيعُ التّحليق بمفردي

285
00:14:07,830 --> 00:14:09,650
رائع، صحيح؟

286
00:14:11,840 --> 00:14:13,300
رائع، أليس كذلك؟

287
00:14:14,660 --> 00:14:16,110
...رامييل-تشان

288
00:14:16,620 --> 00:14:18,120
رائع، صحيح؟

289
00:14:20,170 --> 00:14:21,910
قولي أنّهما رائعان

290
00:14:22,470 --> 00:14:24,450
نعم، إنّهما رائعان

291
00:14:24,450 --> 00:14:25,540
يا رامييل-تشان

292
00:14:26,130 --> 00:14:27,960
شكراً لكِ يا إيليل-تشان

293
00:14:29,120 --> 00:14:32,100
ماذا تفعلين هنا يا رامييل-تشان؟

294
00:14:32,320 --> 00:14:33,480
أنا؟

295
00:14:33,650 --> 00:14:36,270
كنتُ أنتظرُكِ

296
00:14:36,270 --> 00:14:37,300
تنتظرينني أنا؟

297
00:14:37,300 --> 00:14:37,960
لماذا؟

298
00:14:38,370 --> 00:14:40,130
لأنّنا صديقتان

299
00:14:40,420 --> 00:14:42,770
أجل، نحنُ صديقتان

300
00:14:43,080 --> 00:14:45,230
صديقة هامّة

301
00:14:45,470 --> 00:14:46,770
تذكّرت

302
00:14:47,570 --> 00:14:48,700
أين الأخريات؟

303
00:14:48,700 --> 00:14:49,580
الأخريات؟

304
00:14:49,760 --> 00:14:52,610
كنّا متوجّهات إلى العالم الأحمر

305
00:14:52,610 --> 00:14:54,070
هل هُنَّ صديقاتكِ؟

306
00:14:54,280 --> 00:14:56,250
!نعم، هُنّ كذلك

307
00:14:56,510 --> 00:14:57,400
هكذا إذاً

308
00:14:57,400 --> 00:14:58,730
إنّهن صديقاتكِ

309
00:14:58,730 --> 00:15:00,160
رامييل-تشان؟

310
00:15:00,160 --> 00:15:03,200
أصدقاؤكِ بحوزتي

311
00:15:03,930 --> 00:15:06,180
ماذا تقصدين؟

312
00:15:06,690 --> 00:15:09,540
أستطيعُ استخدام المُعجزات

313
00:15:12,680 --> 00:15:14,540
علينا الخروج من هنا

314
00:15:14,540 --> 00:15:16,000
أنا سيّئة في المتاهات

315
00:15:16,140 --> 00:15:18,970
أظنُّ أنّ وقتي قد حان لأتألّق

316
00:15:19,360 --> 00:15:22,690
المتاهات هي مجرّد امتداد للخطوط

317
00:15:22,860 --> 00:15:26,690
،إن وضعتِ يدكِ على إحدى الجدران واستمررتِ في اتّباعها

318
00:15:26,690 --> 00:15:29,740
فستصلين في النّهاية إلى المخرج ولو استغرق ذلك وقتاً

319
00:15:29,740 --> 00:15:30,660
رائع

320
00:15:30,660 --> 00:15:32,360
أعتقدُ أنّ تدريبكِ العسكريّ قد أفادكِ

321
00:15:32,580 --> 00:15:35,050
هذه مجرّد أساسيّات

322
00:15:35,310 --> 00:15:37,070
ماذا عن هذه إذاً؟

323
00:15:37,290 --> 00:15:42,020
...فوق، تحت، يمين، يسار، أمام، خلف

324
00:15:42,020 --> 00:15:44,100
إنّها متاهة ثلاثيّة الأبعاد

325
00:15:46,380 --> 00:15:50,460
إيليل-تشان، هل تتذكّرين كيف كنتِ تلعبين طوال الوقت؟

326
00:15:50,640 --> 00:15:52,370
نعم، أتذكّر

327
00:15:52,700 --> 00:15:55,560
رامييل، كنتِ أس.آر قويّة حقّاً

328
00:15:55,560 --> 00:15:58,890
كان تمرّنكِ معي أنا، يو.سي ممتعاً

329
00:15:59,070 --> 00:16:03,240
لقد استمتعتِ إذاً يا إيليل-تشان

330
00:16:03,240 --> 00:16:03,920
ماذا؟

331
00:16:04,590 --> 00:16:06,480
لقد استمتعتُ أيضاً

332
00:16:06,480 --> 00:16:08,020
يا رامييل-تشان

333
00:16:08,780 --> 00:16:09,910
...لكن

334
00:16:10,520 --> 00:16:13,010
بينما أفكّرُ بالأمر، أشعرُ أنّ ذلك غير صحيح

335
00:16:13,380 --> 00:16:16,310
لم أكن أستمتع

336
00:16:16,310 --> 00:16:20,610
لم أكن أستمتع بجعلِ الأمور مُمتعة لكِ

337
00:16:20,610 --> 00:16:21,690
...كم هذا جميل

338
00:16:21,900 --> 00:16:24,500
لديكِ جناحان جميلان

339
00:16:24,500 --> 00:16:26,330
...بينما لديّ جناح واحد فقط

340
00:16:26,510 --> 00:16:29,910
!لكن لديكِ جناح النُّور

341
00:16:30,260 --> 00:16:33,490
قلتِ أنّهما جميلان

342
00:16:34,480 --> 00:16:35,210
!نعم

343
00:16:35,500 --> 00:16:37,000
هل هما جميلان حقّاً؟

344
00:16:37,390 --> 00:16:38,570
!أجل

345
00:16:38,570 --> 00:16:39,760
!إنّهما رائعان

346
00:16:40,080 --> 00:16:41,680
هل أنتِ جادّة؟

347
00:16:41,900 --> 00:16:43,170
!بالتأكيد

348
00:16:43,170 --> 00:16:45,660
!وأنا أغارُ لأنّهما يُشِعّان نوراً

349
00:16:45,660 --> 00:16:47,600
هل أنتِ جادّة؟

350
00:16:47,870 --> 00:16:49,310
رُغم أنّني لا أستطيع التّحليق بمُفردي؟

351
00:16:51,390 --> 00:16:53,330
كنتُ أشعرُ بالغيرة

352
00:16:53,600 --> 00:16:55,960
!بينما بمقدوركِ أنتِ التّحليق بمفردكِ

353
00:16:58,060 --> 00:17:00,280
لكن لم أقل ذلك

354
00:17:00,280 --> 00:17:05,950
فلو قلت، لخالفَ ذلك الرّابط الذي يربطُني بمحرّكة ألفا خاصّتي

355
00:17:06,340 --> 00:17:07,240
لم أستطع قول ذلك

356
00:17:08,860 --> 00:17:12,560
لكن يا إيليل-تشان، قلتِ أنّني كنتُ جميلة

357
00:17:12,560 --> 00:17:14,230
وأنّني كنتُ رائعة

358
00:17:14,230 --> 00:17:15,800
!وأنّكِ كنتِ تشعرين بالغيرة

359
00:17:16,020 --> 00:17:17,310
!لم أكن أكذب

360
00:17:17,310 --> 00:17:19,160
!هذا ما اعتقدتُه فعلاً

361
00:17:19,160 --> 00:17:21,100
!لهذا كان الأمر صعباً بالنسبة لي

362
00:17:21,760 --> 00:17:24,590
!لديكِ جناحان وقلتِ ذلك الكلام لي

363
00:17:24,590 --> 00:17:25,910
!لم أستطع تحمّل الأمر

364
00:17:25,910 --> 00:17:27,310
...رامييل-تشان

365
00:17:27,640 --> 00:17:33,850
تبيّنتُ من ذلك عندما حصلتُ على هذا الجناح
...وأصبحتُ قادرة على التّحليق بمُفردي

366
00:17:33,850 --> 00:17:35,480
أدركتُ أنّكِ كنتِ تكذبين

367
00:17:35,580 --> 00:17:37,650
!أنا لا أكذب

368
00:17:37,950 --> 00:17:41,070
نعم، أنتِ لا تكذبين

369
00:17:41,310 --> 00:17:43,660
!كان وجودكِ كذبة

370
00:17:45,940 --> 00:17:48,120
انسجمتِ مع الجميع

371
00:17:48,120 --> 00:17:50,280
تقرّبتِ من الجميع

372
00:17:50,280 --> 00:17:54,310
تضعين أي شخص في قلبكِ وتصبحين صديقة للجميع

373
00:17:54,310 --> 00:17:57,640
ولهذا السّبب أنتِ كذبة

374
00:17:57,840 --> 00:18:02,590
...لماذا أنتِ بهذه القسوة يا رامييل-تشان

375
00:18:02,730 --> 00:18:07,240
أنتِ القاسية وليس لديكِ أدنى فكرة يا إيليل

376
00:18:08,550 --> 00:18:10,060
لكن لا مُشكلة

377
00:18:10,060 --> 00:18:12,590
فقد كنتُ قادرة على اكتشاف كلّ ذلك

378
00:18:12,590 --> 00:18:15,630
لقد تحرّرتُ من أكاذيبكِ

379
00:18:15,630 --> 00:18:18,150
أشعرُ بشعور رائع الآن

380
00:18:18,340 --> 00:18:19,920
إيليل-تشان

381
00:18:20,450 --> 00:18:22,770
أما زلنا صديقتَين؟

382
00:18:22,770 --> 00:18:24,270
!بالطبع

383
00:18:24,270 --> 00:18:25,940
!أنتِ صديقتي يا رامييل-تشان

384
00:18:26,160 --> 00:18:28,110
توقّعتُ أن تقولي هذا

385
00:18:28,420 --> 00:18:30,280
سايا-تشان؟ آلماريا؟

386
00:18:30,710 --> 00:18:33,210
،سيبقين عالقات في هذا الفضاء

387
00:18:33,210 --> 00:18:35,550
هائمات إلى أن تنتهي العوالم

388
00:18:35,780 --> 00:18:37,670
لن يصِلن إلى هنا

389
00:18:37,840 --> 00:18:40,760
لماذا... لماذا تفعلين هذا؟

390
00:18:40,880 --> 00:18:43,800
أنا كافية لأكون صديقتكِ الوحيدة

391
00:18:44,100 --> 00:18:48,650
أنتِ صديقتي الوحيدة أيضاً يا إيليل-تشان

392
00:18:50,990 --> 00:18:52,360
إلى أين ينبغي أن نذهب؟

393
00:18:52,360 --> 00:18:54,460
هل يوجد مخرج أصلاً؟

394
00:18:54,460 --> 00:18:56,220
آمل ذلك

395
00:18:57,790 --> 00:18:58,690
...الطريق

396
00:18:58,690 --> 00:18:59,960
سايا، سنخرج من هنا

397
00:18:59,960 --> 00:19:01,680
!يا للإزعاج

398
00:19:03,390 --> 00:19:04,530
!احذرن

399
00:19:04,530 --> 00:19:05,240
!هذا فخّ

400
00:19:05,640 --> 00:19:07,200
هذا ليس الطريق الصّحيح

401
00:19:07,410 --> 00:19:08,450
!توقّفي

402
00:19:08,450 --> 00:19:09,830
!أنقذي سايا-تشان والأخريات

403
00:19:10,080 --> 00:19:11,170
لماذا؟

404
00:19:11,170 --> 00:19:12,790
!إنّهن صديقاتي

405
00:19:12,870 --> 00:19:14,990
ألستُ صديقتكِ؟

406
00:19:15,210 --> 00:19:16,710
!بلى

407
00:19:16,870 --> 00:19:20,660
إيليل-تشان، عليكِ أن تختاري بيني وبينهن

408
00:19:22,060 --> 00:19:24,390
قولي لي الحقيقة

409
00:19:24,390 --> 00:19:26,800
كلّ ما تفعلينه هو كذبة

410
00:19:28,160 --> 00:19:29,600
!ترس الدّماء

411
00:19:30,570 --> 00:19:31,530
يمين؟

412
00:19:31,530 --> 00:19:32,470
من أي اتّجاه؟

413
00:19:32,890 --> 00:19:33,990
قد يكون يساراً

414
00:19:33,990 --> 00:19:35,190
!لا تتفرّقن

415
00:19:35,620 --> 00:19:37,030
هذا ليس صحيحاً أيضاً

416
00:19:37,250 --> 00:19:38,400
...الجدران

417
00:19:38,400 --> 00:19:39,410
!تجنّبن ذلك

418
00:19:40,580 --> 00:19:42,650
توقّفي يا رامييل

419
00:19:42,650 --> 00:19:43,940
توقّفي فحسب

420
00:19:44,160 --> 00:19:46,100
أجيبيني إذاً

421
00:19:46,100 --> 00:19:47,860
هل تختارينني كصديقة لكِ؟

422
00:19:48,270 --> 00:19:50,130
أم تختاريهن هُنّ؟

423
00:19:50,470 --> 00:19:52,720
!كلّكن صديقاتي

424
00:19:52,720 --> 00:19:54,910
!صديقاتي المهمّات

425
00:19:55,260 --> 00:19:56,020
كذبة

426
00:19:56,020 --> 00:19:57,000
!ليست كذبة

427
00:19:57,000 --> 00:19:58,370
!بل حقيقة

428
00:19:58,510 --> 00:19:59,810
هذا صحيح

429
00:19:59,810 --> 00:20:03,550
وجودكِ بحدّ ذاته هو كذبة لأنّكِ تصدّقين ذلك

430
00:20:04,080 --> 00:20:06,030
والآن اهزميني

431
00:20:06,650 --> 00:20:10,340
إن أردتِ إنقاذهن فعلاً فافعلي ذلك

432
00:20:10,510 --> 00:20:11,670
...لا أستطيع

433
00:20:11,670 --> 00:20:14,010
ألا يمكنكِ مُقاتلة صديقتكِ؟

434
00:20:14,290 --> 00:20:15,360
...نعم

435
00:20:15,360 --> 00:20:18,310
أنتِ كذبة حقّاً

436
00:20:18,870 --> 00:20:20,530
!كفّي عن ذلك يا رامييل-تشان

437
00:20:20,530 --> 00:20:22,570
!سأفعلُ إن هزمتِني

438
00:20:22,780 --> 00:20:23,860
!أرجوكِ

439
00:20:23,860 --> 00:20:26,720
!إن هزمتِني فيمكنكِ إنقاذهن

440
00:20:26,720 --> 00:20:27,800
!أرجوكِ

441
00:20:27,800 --> 00:20:29,540
لماذا تتردّدين؟

442
00:20:29,540 --> 00:20:30,500
!رامييل-تشان

443
00:20:30,500 --> 00:20:31,870
!هيّا، بسرعة

444
00:20:32,780 --> 00:20:33,450
!افعليها

445
00:20:36,790 --> 00:20:41,040
قلتِ أنّكِ كنتِ صديقتي، لكن أعتقد
أنّ الأمر ينتهي عند هذا الحدّ

446
00:20:41,190 --> 00:20:42,410
!لا

447
00:20:42,410 --> 00:20:44,000
هذا غير صحيح يا رامييل-تشان

448
00:20:44,340 --> 00:20:45,500
أنا مسرورة

449
00:20:45,630 --> 00:20:48,720
والآن تعالي يا معجزة السّيف الاسود

450
00:20:48,720 --> 00:20:51,600
!يْل فريند: معجزة السّيف الأبيض

451
00:20:51,600 --> 00:20:53,750
...رامييل-تشان هي صديقتي

452
00:20:53,750 --> 00:20:54,260
...لهذا السّبب

453
00:20:55,080 --> 00:20:55,810
!إنّي أراه

454
00:20:56,050 --> 00:20:57,080
!إنّها إيليل

455
00:21:03,870 --> 00:21:05,190
!ترس الدّماء

456
00:21:06,440 --> 00:21:07,650
لماذا؟

457
00:21:07,650 --> 00:21:10,490
لأنّكِ لم تعودي صديقتي

458
00:21:10,870 --> 00:21:13,300
لنُنهِ هذا الأمر الآن

459
00:21:15,830 --> 00:21:16,930
!إيليل

460
00:21:16,930 --> 00:21:18,240
...الآن بعدما عثرنا على المخرج

461
00:21:18,240 --> 00:21:19,210
سننال منكِ

462
00:21:20,720 --> 00:21:21,650
!إيليل

463
00:21:24,790 --> 00:21:25,810
!خذي هذه

464
00:21:29,300 --> 00:21:31,890
أليس هذا رائعاً يا إيليل-تشان؟

465
00:21:32,150 --> 00:21:34,610
لديكِ كثير من الصّديقات

466
00:21:34,890 --> 00:21:36,720
!كم أغار منكِ

467
00:21:40,000 --> 00:21:41,500
...رامييل-تشان

468
00:21:44,090 --> 00:21:46,520
هل أنتِ بخير يا إيليل؟

469
00:21:49,660 --> 00:21:50,800
...إيليل

470
00:23:32,660 --> 00:23:34,500
!كان ذلك لذيذاً