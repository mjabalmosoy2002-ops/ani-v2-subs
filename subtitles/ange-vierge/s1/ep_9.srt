00:12:47,100 --> 00:12:48,810
...حبّي

203
00:12:49,370 --> 00:12:51,820
برنامج لُقاح، تفعيل

204
00:12:57,090 --> 00:12:59,730
!ستيلّا

205
00:12:59,730 --> 00:13:02,050
...كيف تجرؤين

206
00:13:11,020 --> 00:13:13,210
لسوء حظّكِ

207
00:13:13,210 --> 00:13:14,470
أستأذن

208
00:13:16,960 --> 00:13:19,390
جاري متابعة المهمّة

209
00:13:21,040 --> 00:13:22,860
اخترقتا التّرس

210
00:13:24,340 --> 00:13:25,480
ماذا عن برنامج اللّقاح؟

211
00:13:25,950 --> 00:13:27,190
لم ينجح

212
00:13:27,800 --> 00:13:29,490
تلقّت ستيلّا ضرراً

213
00:13:29,740 --> 00:13:30,480
هذا مستحيل

214
00:13:31,160 --> 00:13:33,290
أسرعي وركّبي برنامجاً جديداً

215
00:13:33,290 --> 00:13:34,250
لكن لا نملك ما يكفي من وقت

216
00:13:34,930 --> 00:13:37,860
علينا الاعتماد على ستيلّا-سان فحسب

217
00:13:38,280 --> 00:13:40,530
ستيلّا، يمكنكِ فعلها

218
00:13:43,820 --> 00:13:46,090
يا للحماقة

219
00:13:46,090 --> 00:13:49,080
نحن على وشك إنجاز هدفنا

220
00:13:49,390 --> 00:13:50,380
هذا غريب

221
00:13:50,520 --> 00:13:53,940
زينيا وأنا ما زلنا نمتلك شخصيّتَين منفصلتَين

222
00:13:54,210 --> 00:13:56,500
لم نندمج بشكل كامل؟

223
00:13:58,260 --> 00:14:00,080
أما زلتِ تسعين للمزيد؟

224
00:14:01,460 --> 00:14:02,270
!لن أخسر

225
00:14:02,710 --> 00:14:06,130
أتحلّى بثقة في سرعتي أيضاً

226
00:14:07,360 --> 00:14:08,690
!تشويه

227
00:14:16,290 --> 00:14:19,990
تشوّه الزمكان الذي أمامنا وتبعث جاذبيّة

228
00:14:20,220 --> 00:14:22,920
هذا أشبه بإنشاء ثقب أسود صغير

229
00:14:23,070 --> 00:14:26,560
ما يعني أنّه من الممكن أن يتسارع إلا ما لانهاية

230
00:14:30,420 --> 00:14:32,500
بلوم إكس ماكينا، تفعيل

231
00:14:37,460 --> 00:14:41,630
أستطيعُ إخفاء أكثر من أسلحة في الفضاء الثانوي

232
00:14:42,010 --> 00:14:43,930
إلى اللّقاء يا ستيلّا

233
00:14:53,860 --> 00:14:56,540
ذاكرة التصوير المجسّم... تضرّرت

234
00:15:14,410 --> 00:15:15,090
!ستيلّا

235
00:15:15,420 --> 00:15:16,930
!هل أنتِ بخير يا ستيلّا؟

236
00:15:18,510 --> 00:15:19,460
قولي لي أنّني أبليتُ حسناً

237
00:15:19,600 --> 00:15:20,390
ماذا؟

238
00:15:21,880 --> 00:15:24,060
حقّقتُ رقماً قياسياً جديداً في السرعة

239
00:15:24,450 --> 00:15:28,060
كم مرّة يجب أن أقول لكِ ألّا تتهوّري؟

240
00:15:28,460 --> 00:15:31,770
—لكن حقّقتُ رقماً قياسياً جد

241
00:15:36,050 --> 00:15:39,800
!أكرهكِ عندما لا تصغين إليّ

242
00:15:37,250 --> 00:15:39,080
أماني تبكي

243
00:15:39,600 --> 00:15:41,410
...مثل سايا

244
00:15:41,560 --> 00:15:45,340
لو كنتُ أعتبركِ أداة لما غضبتُ أو بكيت

245
00:15:45,750 --> 00:15:50,930
أعتبركِ شخصاً مهمّاً. لهذا غضبتُ وحزنت

246
00:15:52,590 --> 00:15:57,830
أماني كانت تبكي لأنّني مهمّة بالنسبة لها؟

247
00:15:58,520 --> 00:16:01,600
لكن ما هو مهمّ بالنسبة لي هو السّرعة

248
00:16:01,730 --> 00:16:03,170
أريدُ أن أكون أسرع من أي شخص آخر

249
00:16:03,170 --> 00:16:04,190
...حينها أي شخص

250
00:16:05,710 --> 00:16:09,750
...لكن لماذا السرعة

251
00:16:11,230 --> 00:16:14,520
...لماذا

252
00:16:25,220 --> 00:16:25,870
!ماما

253
00:16:26,220 --> 00:16:27,680
!ستيلّا، أنتِ سريعة جدّاً

254
00:16:27,680 --> 00:16:28,630
!مذهل

255
00:16:28,630 --> 00:16:30,200
!أنتِ غاية في الرّوعة

256
00:16:30,400 --> 00:16:31,300
...هكذا إذاً

257
00:16:31,940 --> 00:16:33,020
...ماما

258
00:16:33,110 --> 00:16:35,120
...ابتسمَتْ أماني عندما

259
00:16:36,650 --> 00:16:40,500
...ما هو مهمّ بالنسبة لي

260
00:16:50,150 --> 00:16:52,860
هذا هو دع الحماية الأخير

261
00:16:52,860 --> 00:16:55,620
إذاً كلّ ما علينا فعله هو التوجّه صوب بلُّورة العالم

262
00:16:55,850 --> 00:16:59,330
والآن هل تستطيعين إيقافنا؟

263
00:17:00,770 --> 00:17:02,240
تشويه

264
00:17:02,770 --> 00:17:06,580
لا أحد يستطيع مُجاراة تسارعي اللّامحدود

265
00:17:09,390 --> 00:17:10,290
لماذا؟

266
00:17:10,530 --> 00:17:13,540
...دخلتِ تشوُّهي الفضائي

267
00:17:13,860 --> 00:17:17,300
سأدخل موجتكِ وأسرّع نفسي

268
00:17:17,560 --> 00:17:18,660
...مستحيل

269
00:17:19,520 --> 00:17:21,680
هواء الجاذبيّة المُزاح

270
00:17:30,290 --> 00:17:31,640
...لا أستطيع الابتعاد

271
00:17:32,120 --> 00:17:33,280
!أسرع

272
00:17:33,810 --> 00:17:34,920
...في هذه الحالة

273
00:17:44,990 --> 00:17:46,480
!ابتعدي

274
00:17:46,480 --> 00:17:49,700
!القوّة المدّية ستمزّقكِ إرباً

275
00:17:49,700 --> 00:17:51,620
!هذا غير مؤلم على الإطلاق

276
00:17:51,800 --> 00:17:54,960
تحذير: يتعرّض الإطار الرئيسي لإجهاد مفرط

277
00:17:55,690 --> 00:17:57,860
...القليل فقط

278
00:17:58,030 --> 00:17:59,340
تابعي يا كارين

279
00:18:00,560 --> 00:18:01,670
!زينيا

280
00:18:02,400 --> 00:18:04,380
لا تتردّدي عن التّسارع

281
00:18:04,490 --> 00:18:08,140
لكن إن تدمّرتُ فسيُقضى عليكِ معي

282
00:18:08,450 --> 00:18:10,100
سأكون بخير

283
00:18:10,570 --> 00:18:12,270
!لا، لن تكوني كذلك

284
00:18:12,600 --> 00:18:14,710
!لن أسمح بدماركِ

285
00:18:16,200 --> 00:18:18,980
!اندماجهما غير مكتمل

286
00:18:19,270 --> 00:18:21,010
!مسرّع نيتروجيني

287
00:18:25,580 --> 00:18:26,320
!هذا سيّئ

288
00:18:26,830 --> 00:18:29,080
في هذه الحالة فسننفصل

289
00:18:29,610 --> 00:18:31,180
أنا بخير

290
00:18:31,440 --> 00:18:32,700
لا تتوقّفي

291
00:18:32,700 --> 00:18:33,490
!لا

292
00:18:34,990 --> 00:18:36,460
!عزيزتي زينيا

293
00:18:39,360 --> 00:18:40,520
!ابتعدي

294
00:18:40,790 --> 00:18:42,140
!تراجعي

295
00:18:42,610 --> 00:18:46,050
!تراجعي! تراجعي! تراجعي

296
00:18:46,840 --> 00:18:47,560
!زينيا

297
00:18:48,880 --> 00:18:52,640
حتّى هذه اللحظة، كشفَتْ أماني عن كلّ مصاعبي لأجلي

298
00:18:53,720 --> 00:18:55,290
...مقارنة بذلك

299
00:18:56,980 --> 00:18:58,380
!هذا غير مؤلم إطلاقاً

300
00:19:01,270 --> 00:19:04,650
!لا

301
00:19:07,390 --> 00:19:08,200
!ها أنا ذي

302
00:19:11,120 --> 00:19:12,120
!كارين

303
00:19:12,340 --> 00:19:13,370
!زينيا

304
00:19:18,520 --> 00:19:19,580
،لنذهب نحن الثّلاثة

305
00:19:20,440 --> 00:19:21,620
إلى الدّيار

306
00:19:38,280 --> 00:19:39,200
هل فعلَتْها؟

307
00:19:39,200 --> 00:19:39,790
نعم

308
00:19:40,230 --> 00:19:41,690
انتهى الأمر؟

309
00:19:41,690 --> 00:19:42,690
ستيلّا

310
00:19:47,120 --> 00:19:48,290
زينيا

311
00:19:49,340 --> 00:19:50,220
كارين

312
00:19:52,740 --> 00:19:56,170
الرمز أوميغا 00 إيوفيريا، هل تسمعينني؟

313
00:19:56,910 --> 00:19:59,590
سأرسلهما إليكِ الآن

314
00:19:59,850 --> 00:20:01,730
‏‏‏‏‏‏‏10-4، أسمعك

315
00:20:01,860 --> 00:20:03,660
شكراً يا ستيلّا

316
00:20:11,790 --> 00:20:13,290
تمّ الإرسال

317
00:20:14,420 --> 00:20:15,850
تمّ الاستقبال

318
00:20:17,380 --> 00:20:25,020
...ستيلّا، شكراً لكِ على كارين... وزينيا

319
00:20:26,850 --> 00:20:29,150
‏‏‏‏‏‏‏10-4، 10-99

320
00:20:29,430 --> 00:20:31,490
جاري العودة إلى القاعدة الآن

321
00:20:35,120 --> 00:20:36,100
...ماما

322
00:20:41,710 --> 00:20:45,690
،لنحلّق معاً مجدّداً

323
00:20:48,070 --> 00:20:49,160
!أماني

324
00:20:57,180 --> 00:21:03,400
سوفينا ورامييل والآن كارين وزينيا
كلّهن تلطّخن بالعار وأصبحن تائهات

325
00:21:03,590 --> 00:21:08,560
غطرسة أولئك الذين يطلقون على أنفسهم
...بمُتمرِّدات إكس.آر، إكس

326
00:21:09,300 --> 00:21:11,660
لكن انتهى الآمر الآن

327
00:21:12,060 --> 00:21:13,540
أنا جاهزة كلّياً

328
00:21:15,440 --> 00:21:17,990
لندمّر بعضنا الآخر

329
00:22:54,350 --> 00:22:56,300
!هل أنتِ جاهزة يا حضرة الملازم ثاني مايوكا؟

330
00:22:56,520 --> 00:22:58,220
!نعم سيّدتي

331
00:22:58,480 --> 00:23:00,840
لماذا تبتسمين؟

332
00:23:01,130 --> 00:23:02,310
لا شيء

333
00:23:02,310 --> 00:23:05,230
لا شيء على الإطلاق يا آغيها-أونيتشان

334
00:23:05,600 --> 00:23:10,580
قلتُ لكِ لا تناديني "أونيتشان" أثناء ارتدائنا
الملابس الرسميّة

335
00:23:10,580 --> 00:23:12,610
...هذا مخيف

336
00:23:13,250 --> 00:23:16,230
كنتِ لطيفة للغاية في اللّيلة الماضية أيضاً

337
00:23:17,660 --> 00:23:19,510
!انسي أمر البارحة

338
00:23:19,510 --> 00:23:21,440
!انسي كلّ شيء، مفهوم؟

339
00:23:21,940 --> 00:23:23,420
!بالتأكيد

340
00:23:27,370 --> 00:23:29,330
تحبّين النوم كثيراً

341
00:23:30,690 --> 00:23:32,580
صباح الخير، أوني-تشان

342
00:23:32,800 --> 00:23:35,930
!ليس مجدّداً