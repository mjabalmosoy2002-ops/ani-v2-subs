1
00:00:00,470 --> 00:00:02,020
.هذا ما حدث حتّى الآن

2
00:00:02,600 --> 00:00:06,310
أنا هوجو سايتو، تلميذ في السّنة
.الثّالثة من الثّانويّة

3
00:00:07,020 --> 00:00:07,940
!مرحبًا

4
00:00:08,190 --> 00:00:09,360
!جدّي؟

5
00:00:08,190 --> 00:00:09,360
!جدّتي؟

6
00:00:10,190 --> 00:00:12,490
لماذا أحضرتمانا إلى هنا؟

7
00:00:12,490 --> 00:00:14,360
.ستتزوّجان

8
00:00:14,570 --> 00:00:15,450
ماذا؟

9
00:00:15,780 --> 00:00:20,540
شاءت الأقدار أن أتزوّج عدوّتي
.اللّدودة في المدرسة

10
00:00:21,000 --> 00:00:22,160
...سوف

11
00:00:22,370 --> 00:00:24,000
!أتزوّج

12
00:00:24,000 --> 00:00:26,380
.اسمها ساكوراموري أكاني

13
00:00:26,380 --> 00:00:30,210
.يجب أن يظلّ هذا الوضع سرًّا

14
00:00:30,210 --> 00:00:32,210
ما الّذي كنت تُحدّثين به سايتو-كُن؟

15
00:00:33,220 --> 00:00:35,510
لقد تزوّجت، صحيح؟

16
00:00:36,390 --> 00:00:37,510
!كيف استطعتِ أن—؟

17
00:00:37,510 --> 00:00:41,180
،كان جدّي يخطّط لأمر ما
.لذلك بحثت شيسي في الأمر

18
00:00:41,180 --> 00:00:44,600
.ولكن، اكتشفت قريبتي شيسي الأمر سلفًا

19
00:00:46,400 --> 00:00:48,610
والأسوأ من ذلك، الحياة الزّوجيّة
.أشبه بمنطقة حرب

20
00:00:48,940 --> 00:00:51,980
ما الّذي سيحدث لنا يا ترى؟

21
00:00:54,990 --> 00:00:56,150
!انتظر

22
00:00:56,150 --> 00:00:57,280
!أخبرتك أن تنتظر

23
00:00:57,280 --> 00:00:58,280
!لن أفعل ذلك

24
00:00:58,280 --> 00:01:00,020
!لستُ جاهزًا للموت بعد

25
00:01:00,020 --> 00:01:01,120
!لن أقتلك

26
00:01:01,120 --> 00:01:02,450
!لكنّي سأطلق عليك النّار إن لم تتوقّف

27
00:01:02,450 --> 00:01:03,780
وبماذا ستطلقين عليّ النّار؟

28
00:01:04,830 --> 00:01:06,300
...لقد تعرّضتُ

29
00:01:06,300 --> 00:01:07,460
لطلق ناريّ؟

30
00:01:07,750 --> 00:01:10,210
لماذا لم تأخذ صندوق غدائك؟

31
00:01:10,210 --> 00:01:12,740
.صحيح. آسف، لقد نسيت

32
00:01:12,740 --> 00:01:14,170
نسيت؟

33
00:01:14,170 --> 00:01:15,380
.أشكّ في ذلك

34
00:01:15,380 --> 00:01:18,640
أراهن أنّك لم ترد أكل الطّعام
.الّذي أعددتُه فحسب

35
00:01:18,640 --> 00:01:21,220
.لا، بل أنا أحبّ أكل طعامك

36
00:01:21,220 --> 00:01:24,260
.هـ-هكذا إذًا. لا بأس في تلك الحالة

37
00:01:24,520 --> 00:01:26,810
.لقد عملت بجدّ لإعداده

38
00:01:26,810 --> 00:01:29,360
!لذلك من الأفضل أن تنهيه كلّه

39
00:01:35,780 --> 00:01:38,160
!أخي-كُن، أنا جائعة

40
00:01:38,160 --> 00:01:39,910
هل يمكنك إعطائي صندوق طعامك كلّه؟

41
00:01:40,160 --> 00:01:43,290
.هذا طلب جريء تطلبينه من العدم هكذا

42
00:01:43,290 --> 00:01:45,620
.ستموت شيسي جوعًا على هذا الحال

43
00:01:45,620 --> 00:01:49,080
على الإخوة الكبار توفير الطّعام
.للأخوات الصّغيرات

44
00:01:49,080 --> 00:01:51,670
!تتكلّمين وكأنّك لم تأكلي وليمة على الفطور

45
00:01:51,920 --> 00:01:53,750
.تناولتُ ثلاثة زبديّات أرزّ

46
00:01:53,750 --> 00:01:54,960
!أرأيت؟! أكلتِ أكثر منّي

47
00:01:54,960 --> 00:01:56,550
.ذلك ليس بيت القصيد

48
00:01:56,550 --> 00:01:57,550
!طبعًا هو كذلك

49
00:01:57,550 --> 00:02:00,510
ما ترغب فيه شيسي هو الطّعام
—الّذي أعدّته

50
00:02:00,510 --> 00:02:02,970
ظننتُ أنّنا اتّفقنا ألاّ تتحدّثي
!عن هذا الموضوع

51
00:02:04,470 --> 00:02:06,930
رجاءً يا أخي الكبير؟

52
00:02:06,930 --> 00:02:10,060
.تريد شيسي الطّعام

53
00:02:11,400 --> 00:02:13,230
!يا لك من مسكينة يا شيسي-تشان

54
00:02:13,230 --> 00:02:15,440
!بربّك، أعطها بعضه على الأقلّ

55
00:02:15,440 --> 00:02:17,150
!بل أعطه لها كلّه

56
00:02:17,150 --> 00:02:21,160
!لا أصدّق أنّك ستحتكره كلّه لنفسك
!يا لك من متوحّش شرّير

57
00:02:21,320 --> 00:02:22,780
.لا بأس

58
00:02:22,780 --> 00:02:24,620
.قضمة واحدة فقط

59
00:02:24,620 --> 00:02:27,410
...لحظة، تبدو علبة غدائك

60
00:02:27,660 --> 00:02:29,290
!مشابهة لعلبة غداء أكاني

61
00:02:31,430 --> 00:02:32,460
!هذا صحيح

62
00:02:32,460 --> 00:02:34,090
!ملاحظة جيّدة يا هيمارين

63
00:02:34,090 --> 00:02:34,880
ولكن لماذا؟

64
00:02:34,880 --> 00:02:37,380
!لا تقل لي أنّ ساكوراموري-سان أعدّت غداءك

65
00:02:37,380 --> 00:02:39,550
إذًا فأنتما تتواعدان بالفعل؟

66
00:02:39,550 --> 00:02:41,550
!نـ-نـ-نحن لا-لا نتواعد

67
00:02:41,550 --> 00:02:43,140
.صار وجهك كحبّة طماطم

68
00:02:43,140 --> 00:02:45,760
!إنّنا لا نتواعد على الإطلاق

69
00:02:45,760 --> 00:02:47,940
!صـ-صحيح! تلك هي الحقيقة

70
00:02:47,940 --> 00:02:49,680
!لكنّنا متزوّجان

71
00:02:49,940 --> 00:02:52,060
.ثمّة شيء ما ليس في محلّه هنا

72
00:02:52,060 --> 00:02:55,480
بالتّفكير في الأمر، لطالما تصرّف هوجو
.وساكوراموري كشخصين متزوّجين

73
00:02:55,480 --> 00:02:58,190
لا بدّ أنّ علب الغداء المتشابهة
!دليل على ذلك

74
00:02:58,190 --> 00:03:00,360
.د-دعوني أشرح

75
00:03:02,570 --> 00:03:04,660
!قلتُ لك قضمة واحدة

76
00:03:07,700 --> 00:03:10,460
ليس من آداب الطّعام
!أن تتكلّمي وفمك ممتلئ

77
00:03:11,170 --> 00:03:11,960
.بلع

78
00:03:11,960 --> 00:03:13,830
.أكلتُ كلّ شيء في قضمة واحدة

79
00:03:13,830 --> 00:03:14,920
أأنت وحش؟

80
00:03:14,920 --> 00:03:18,130
أنا قادرة على القيام بأشياء
.تفوق إدراك البشر

81
00:03:18,130 --> 00:03:19,460
فعلاً؟

82
00:03:19,760 --> 00:03:24,890
على الرّحب والسّعة. دمّرت
.شيسي الدّليل من أجلك

83
00:03:24,890 --> 00:03:26,100
أأنت جادّة؟

84
00:03:26,100 --> 00:03:28,770
.كذبت. كنتُ جائعة فحسب

85
00:03:29,520 --> 00:03:33,350
أخي-كُن، كيف الأمور في المنزل؟

86
00:03:42,070 --> 00:03:43,490
!سايتو-كُن

87
00:03:47,580 --> 00:03:49,790
.من الخطير النّزول قفزًا على الدّرج

88
00:03:49,790 --> 00:03:51,000
!لا داعي للقلق

89
00:03:51,000 --> 00:03:53,580
!أعلم أنّك ستمسك بي إن حدث شيء ما

90
00:03:53,580 --> 00:03:54,670
.لا تقحميني في هذا

91
00:03:54,670 --> 00:03:56,200
.سأتفاداك مهما كلّف الأمر

92
00:03:56,200 --> 00:03:59,590
يا للؤمك! لن تحصل على أيّ
!فتيات بتصرّفاتك هذه

93
00:03:59,590 --> 00:04:01,420
.لا أحتاج لذلك

94
00:04:02,170 --> 00:04:03,840
!توقّعتُ أن تقول هذا

95
00:04:06,180 --> 00:04:09,810
...بالمناسبة، بخصوص علبة غدائك

96
00:04:09,810 --> 00:04:13,100
لم تعدّه أكاني من أجلك، صحيح؟

97
00:04:13,480 --> 00:04:16,440
.على الأرجح أنّنا نستعمل نفس الطّعام المجمّد

98
00:04:16,650 --> 00:04:21,360
.إمّا ذلك أو أنّها قرّرت أن تقلّدني

99
00:04:21,360 --> 00:04:22,400
أهذه الحقيقة؟

100
00:04:22,650 --> 00:04:23,610
.إنّها الحقيقة

101
00:04:23,900 --> 00:04:26,620
أنتما لا تتواعدان، صحيح؟

102
00:04:26,620 --> 00:04:27,990
.بالطّبع لا

103
00:04:27,990 --> 00:04:30,200
!جيّد! هذا جيّد

104
00:04:30,200 --> 00:04:32,120
!بالطّبع لا

105
00:04:32,120 --> 00:04:34,370
!آسفة، كان تصرّفي غريبًا

106
00:04:34,370 --> 00:04:37,080
!سأخبر الجميع أنّه سوء فهم

107
00:04:37,080 --> 00:04:38,210
!مع السّلامة

108
00:06:27,780 --> 00:06:29,990
أيوجد شيء ما هناك؟

109
00:06:40,830 --> 00:06:41,880
!ما كان ذلك؟

110
00:06:41,880 --> 00:06:43,750
!هل نتعرّض لهجوم من نظام ألفا القنطور؟

111
00:06:43,750 --> 00:06:45,840
!شبح! لقد رأيتُ شبحًا

112
00:06:45,840 --> 00:06:48,880
كان لديه وجه شاحب
!وكان يتمتم بصوت خافت

113
00:06:49,930 --> 00:06:51,220
.لا يوجد شيء هناك

114
00:06:51,220 --> 00:06:52,220
!أقسم أنّي رأيته

115
00:06:52,220 --> 00:06:53,880
.فعلاً؟ تصبحين على خير

116
00:06:53,880 --> 00:06:58,020
!كلاّ، استيقظ! لا تتركني وحدي

117
00:06:58,020 --> 00:07:00,730
.لا تقلقي. أنت لستِ وحدك

118
00:07:00,730 --> 00:07:03,190
لديك أمّنا الطّبيعة
!والعالم بأسره إلى جانبك

119
00:07:03,190 --> 00:07:04,860
!لا تخبرني بمثل هذا الهراء

120
00:07:04,860 --> 00:07:05,400
!نامي

121
00:07:05,400 --> 00:07:08,030
!كيف لي أن أنام؟
!لن أسمح لك بالنّوم أيضًا

122
00:07:08,030 --> 00:07:11,120
!ما الّذي ستفعله إن التهمت الأشباح أرواحنا؟

123
00:07:12,280 --> 00:07:14,410
.لن يسعنا فعل شيء حينها

124
00:07:15,500 --> 00:07:17,870
!دعيني ألقي نظرة

125
00:07:17,870 --> 00:07:20,290
!كـ-كلاّ! لا أريد! ابق هنا

126
00:07:20,290 --> 00:07:22,120
عليّ التّحقّق من الأمر
.إن كنّا نريد العودة للنّوم

127
00:07:22,120 --> 00:07:23,170
!أنا أرجوك

128
00:07:30,430 --> 00:07:33,640
أكره هذا. سأنتقل من هنا
.وسأحضر طارد أرواح

129
00:07:33,640 --> 00:07:35,520
ما الّذي حدث الآن؟

130
00:07:35,520 --> 00:07:38,180
.إنّه الشّبح ثانية

131
00:07:38,560 --> 00:07:42,430
كنتُ أدرس عندما سمعتُ شيئًا
.يركض في غرفة المعيشة

132
00:07:42,430 --> 00:07:44,690
...سمعتُ أصوت خطوات

133
00:07:44,690 --> 00:07:48,190
فعلاً؟ اذهبي والتقطي صورة
.بهاتفك وأريني

134
00:07:48,190 --> 00:07:51,780
!هل تمازحني؟! سيتمّ لعني وسينفجر هاتفي

135
00:07:51,950 --> 00:07:54,460
.إنّ أشباح هذه الأيّام لها تأثير قويّ

136
00:07:55,240 --> 00:07:56,830
لماذا هنا بالضّبط؟

137
00:07:56,830 --> 00:08:00,620
!أ-أنا أحميك من التّعرّض لهجوم الأشباح

138
00:08:00,620 --> 00:08:03,420
.أعدك أنّي بخير. بإمكانك الذّهاب الآن

139
00:08:03,420 --> 00:08:04,880
!من المستحيل أن أغادر الآن

140
00:08:04,880 --> 00:08:07,090
!هذه غرفتي الآن

141
00:08:09,960 --> 00:08:11,800
!إلى أين ستذهب؟! للخارج؟

142
00:08:11,800 --> 00:08:14,220
!إلى الحمّام! ابقي هنا فحسب

143
00:08:14,220 --> 00:08:15,260
!دعه مفتوحًا

144
00:08:15,260 --> 00:08:16,850
!اترك باب الحمّام مفتوحًا

145
00:08:16,850 --> 00:08:17,850
!مستحيل

146
00:08:17,850 --> 00:08:20,100
!ولكن حتّى الكلاب تستعمل الحمّام أمام النّاس

147
00:08:20,100 --> 00:08:21,180
!أنا لستُ كلبًا

148
00:08:23,440 --> 00:08:26,110
...أعتقد أنّي سأذهب لأخذ حمّام

149
00:08:26,110 --> 00:08:26,900
.حسنًا

150
00:08:31,280 --> 00:08:32,360
...لكن

151
00:08:32,360 --> 00:08:33,320
ماذا؟

152
00:08:33,700 --> 00:08:36,570
.ليس من الآمن الذّهاب وحدي

153
00:08:36,570 --> 00:08:40,700
أ-أيمكنك مرافقتي رجاءً؟

154
00:08:40,700 --> 00:08:41,700
!ماذا؟

155
00:08:41,910 --> 00:08:44,210
ألا تريد؟

156
00:08:44,420 --> 00:08:47,170
.لا بأس. اللّيلة فحسب

157
00:08:55,430 --> 00:08:57,970
هل ما زلت هنا؟

158
00:08:58,140 --> 00:09:00,600
.أنت هنا، صحيح؟ أخبرني أنّك هنا رجاءً

159
00:09:00,600 --> 00:09:03,230
.اتّحد مع العالم. أنت هو العالم

160
00:09:03,520 --> 00:09:06,230
!لماذا لا تردّ؟! هذا يغضبني

161
00:09:06,230 --> 00:09:07,990
!غطّي نفسك

162
00:09:08,900 --> 00:09:10,940
.إنّ الأمور غريبة في الآونة الأخيرة

163
00:09:10,940 --> 00:09:12,400
أتشتكي من الزّوجة؟

164
00:09:12,400 --> 00:09:14,030
.أنا لا أشتكي

165
00:09:14,030 --> 00:09:16,410
كيف عرفتِ أنّ الأمر يتعلّق بها؟

166
00:09:16,860 --> 00:09:18,950
.ذلك واضح لي من صوتك

167
00:09:18,950 --> 00:09:24,040
،كلّما أرهقتك مشاكل زوجتك
.تأتي راكضًا إلى شيسي

168
00:09:24,040 --> 00:09:27,580
وتؤمّن لك شيسي الرّاحة
.بصفتها امرأة فاتنة

169
00:09:27,580 --> 00:09:30,090
.لا أقدّر ذلك الوصف الّذي وصفتني به

170
00:09:30,090 --> 00:09:34,060
.إنّه ليس سيّئًا. يحتاج الجميع لمهرب

171
00:09:34,270 --> 00:09:36,550
.أخي-كُن يحتاج لشيسي

172
00:09:37,470 --> 00:09:40,170
.وشيسي تحتاج إليه

173
00:09:41,930 --> 00:09:45,310
.لا تقلق. بإمكانك الاعتماد على شيسي

174
00:09:45,310 --> 00:09:50,690
.ستقبَلك شيسي بأيدٍ مفتوحة

175
00:09:50,690 --> 00:09:52,730
.انزلي إلى هنا حيث المكان أأمن

176
00:09:53,480 --> 00:09:56,200
ما خطب زوجتك إذًا؟

177
00:09:56,200 --> 00:09:59,410
.تستمرّ أكاني في الحديث عن شبح في المنزل

178
00:09:59,740 --> 00:10:04,290
إنّها خائفة من شيء يقف أمام
.سريرها ويركض في أرجاء المنزل

179
00:10:04,660 --> 00:10:07,460
حتّى أنّها كانت خائفة جدًّا
.من الاستحمام وحدها

180
00:10:07,460 --> 00:10:09,080
.أخي-كُن، أنت منحرف

181
00:10:09,080 --> 00:10:10,380
!لستُ منحرفًا

182
00:10:10,380 --> 00:10:12,750
!ليس الأمر وكأنّنا استحممنا معًا

183
00:10:12,750 --> 00:10:15,550
لكنّك أردتَ ذلك، صحيح؟

184
00:10:15,550 --> 00:10:17,220
.كفّي عن اختلاق الأمور

185
00:10:17,220 --> 00:10:20,550
.ربّما كان شبحًا بالفعل

186
00:10:20,550 --> 00:10:21,470
.مستحيل

187
00:10:23,560 --> 00:10:27,220
.ستأتي شيسي للتّحقّق من الأمر

188
00:10:28,480 --> 00:10:31,480
أكاني! أنت متزوّجة من أخي-كُن، صحيح؟

189
00:10:32,900 --> 00:10:34,070
!مستحيل

190
00:10:34,480 --> 00:10:36,400
.لا يفوت شيسي أيّ شيء

191
00:10:36,400 --> 00:10:39,610
حتّى أنّي أعرف أنّك وأخي-كُن
—تعيشان معًا

192
00:10:38,570 --> 00:10:41,070
!يا له من يوم جميل! لنخرج لنتمشّى

193
00:10:41,070 --> 00:10:43,490
!أنا بحاجة للهواء النّقيّ بالفعل

194
00:10:44,280 --> 00:10:49,000
.يا له من عمل فريق طبيعيّ
.إذًا هذه هي الرّابطة بين الزّوجين

195
00:10:49,000 --> 00:10:53,210
!سايتو. ألم أخبرك أن تبقيّ الأمر سرًّا؟

196
00:10:53,210 --> 00:10:54,750
!ما الّذي كنت تفكّر فيه؟

197
00:10:54,750 --> 00:10:56,510
!لم أخبر شيسي بأيّ شيء

198
00:10:56,510 --> 00:10:58,260
!اكتشفت الأمر بنفسها

199
00:10:58,260 --> 00:10:59,380
صحيح يا شيسي؟

200
00:10:59,380 --> 00:11:00,550
.مهلاً

201
00:11:00,550 --> 00:11:04,050
لا يمكنني تذكّر المزحة من العرض
.الكوميديّ الّذي شاهدته البارحة

202
00:11:04,050 --> 00:11:05,600
!من يهتمّ لذلك الآن؟

203
00:11:05,600 --> 00:11:07,350
!حياتي على المحكّ هنا؟

204
00:11:07,350 --> 00:11:09,890
...حياة أخي-كُن أم المزحة

205
00:11:09,890 --> 00:11:11,480
أيّهما الأكثر أهمّيّة؟

206
00:11:11,480 --> 00:11:12,400
!لا توجد أيّ مقارنة

207
00:11:12,690 --> 00:11:15,320
.يقول أخي-كُن الحقيقة

208
00:11:15,320 --> 00:11:19,030
.اكتشفت شيسي الحقيقة وحدها

209
00:11:19,280 --> 00:11:20,400
فعلاً؟

210
00:11:20,400 --> 00:11:24,410
.لا يوجد من يستطيع خداع عيون شيسي

211
00:11:24,410 --> 00:11:28,540
ربّما كانت سخافة منّي أن أفترض
.أنّ عائلة سايتو لن تعرف بالأمر

212
00:11:28,830 --> 00:11:31,790
.آسفة لأنّي لم أخبرك يا شيسي-سان

213
00:11:32,750 --> 00:11:34,040
.لا بأس

214
00:11:34,320 --> 00:11:38,550
.أخبرني أخي-كُن بالأمر
.أنت تخشين أن يكون في المنزل أشباح

215
00:11:38,550 --> 00:11:42,630
صـ-صحيح! وهو يرفض
!تصديقي بخصوص الشّبح

216
00:11:42,630 --> 00:11:44,690
!إنّ لا فكرة لديه عن جدّيّة الأمر

217
00:11:44,930 --> 00:11:46,470
.ذلك واضح لشيسي

218
00:11:46,470 --> 00:11:51,060
.إنّ منزلكما... مسكون بالأرواح الشّرّيرة

219
00:11:51,060 --> 00:11:52,050
!عرفتُ ذلك

220
00:11:52,050 --> 00:11:55,520
.ستُلعنان إن لم يتمّ طردهما قريبًا

221
00:11:55,520 --> 00:12:00,030
قد تنزل علامات أكاني للخمسين
.في كلّ الموادّ الدّراسيّة

222
00:12:00,030 --> 00:12:01,820
!يا لها من لعنة فظيعة

223
00:12:01,820 --> 00:12:03,320
!علّمينا كيف نوقفها يا شيسي-سان

224
00:12:03,570 --> 00:12:06,870
.أحتاج فقط للتّحقّق من المنزل

225
00:12:07,790 --> 00:12:10,580
.ضعا ثقتكما في شيسي

226
00:12:16,750 --> 00:12:18,340
.يا إلهي

227
00:12:18,340 --> 00:12:20,210
ما رأيك يا شيسي؟

228
00:12:20,210 --> 00:12:22,930
.الأرواح الشّرّيرة المتزاحمة مع بعضها تغزو المكان

229
00:12:23,300 --> 00:12:26,850
.سيغرق هذا المنزل للعالم السّفليّ قريبًا

230
00:12:26,850 --> 00:12:28,220
!شيسي

231
00:12:28,220 --> 00:12:30,610
الـ-العالم السّفليّ؟ هل فات الأوان؟

232
00:12:30,610 --> 00:12:32,510
هل علينا حرق المنزل بالكامل؟

233
00:12:32,510 --> 00:12:33,600
!حا-حافظي على هدوئك

234
00:12:33,800 --> 00:12:38,230
لا داعي للقلق. بإمكاني تتبّع
.مصدر التّدخّل الذّهنيّ

235
00:12:38,230 --> 00:12:40,980
.ثمّ سأدمّره لتشتيت الأرواح

236
00:12:40,980 --> 00:12:43,480
!شكرًا لك يا سينسي

237
00:12:44,070 --> 00:12:45,360
ماذا في الدّاخل؟

238
00:12:45,360 --> 00:12:47,240
.إنّها غرفة دراستي

239
00:12:47,530 --> 00:12:50,910
لكن بالإمكان اعتبارها مكتبة
.بما أنّي لا أدرس كثيرًا

240
00:12:50,910 --> 00:12:53,540
إذًا فأنت تقرأ الكتب المنحرفة هناك؟

241
00:12:53,540 --> 00:12:54,160
سايتو؟

242
00:12:54,160 --> 00:12:54,870
.كلاّ

243
00:12:54,870 --> 00:13:00,920
شيسي تعرف. توجد مشاهد
.منحرفة في كتب أخي-كُن

244
00:13:00,920 --> 00:13:05,130
،عندما تختلس شيسي النّظر إليها
.ينتابه الرّعب ويخبّئها

245
00:13:05,130 --> 00:13:08,880
لا أصدّق أنّك تقرأ كتبًا منحرفة
!في منزلي! أنت تثير قرفي

246
00:13:08,880 --> 00:13:10,260
!إنّها روايات عاديّة

247
00:13:10,260 --> 00:13:11,880
!ثمّة مشاهد غرف نوم حتّى في الأفلام

248
00:13:11,880 --> 00:13:14,560
عليّ التّحقّق من غرفة أخي-كُن
.للكتب المنحرفة

249
00:13:14,560 --> 00:13:15,890
!لا تصفيها بذلك

250
00:13:15,890 --> 00:13:17,770
!علينا مصادرة أيّ كتب قذرة

251
00:13:17,770 --> 00:13:19,610
ماذا حدث لطرد الأرواح؟

252
00:13:25,150 --> 00:13:27,870
.إنّها ملابس أخي-كُن الدّاخليّة

253
00:13:27,870 --> 00:13:29,910
!لا-لا تريني ذلك

254
00:13:32,490 --> 00:13:34,410
.شمّ، شمّ

255
00:13:34,410 --> 00:13:36,670
.لا أشمّ رائحة أخي-كُن فيها

256
00:13:36,670 --> 00:13:38,500
.بل رائحة منظّف ملابس

257
00:13:38,500 --> 00:13:39,920
.لقد تمّ غسلها

258
00:13:39,920 --> 00:13:41,920
!بالطّبع تمّ غسلها

259
00:13:43,010 --> 00:13:46,180
.سأتحقّق من غرفة دراسة أكاني تاليًا

260
00:13:46,180 --> 00:13:47,590
.مهلاً يا شيسي-سان

261
00:13:47,590 --> 00:13:51,390
.لا توجد أيّ أرواح في غرفتي. إنّها آمنة

262
00:13:51,390 --> 00:13:54,060
لا تريدين أن أعثر على ملابسك الدّاخليّة؟

263
00:13:54,060 --> 00:13:57,060
على الإطلاق! ركّزي على الأرواح
!فقط إن كنت لا تمانعين

264
00:13:57,060 --> 00:13:59,190
.لكنّ الملابس الدّاخليّة ممتعة أكثر

265
00:13:59,190 --> 00:14:00,690
!ذلك ليس صحيحًا

266
00:14:01,860 --> 00:14:05,900
.كنتُ نائمة عندما رأيتُ شبحًا هناك

267
00:14:05,900 --> 00:14:08,450
.لم يكن طويلاً جدًّا، كان بطول طفل تقريبًا

268
00:14:08,610 --> 00:14:12,910
.اختفى بمجرّد أن صرخت

269
00:14:13,450 --> 00:14:15,000
.فهمت

270
00:14:17,000 --> 00:14:18,670
ما رأيك؟

271
00:14:19,460 --> 00:14:20,830
شيسي-سان؟

272
00:14:20,830 --> 00:14:22,380
.أمهليها لحظة رجاءً

273
00:14:23,670 --> 00:14:28,680
تقوم خلايا دماغها بحساب كلّ
.سيناريو ممكن بسرعة كبيرة الآن

274
00:14:29,130 --> 00:14:32,180
.ستصل شيسي إلى مصدر هذا الأمر

275
00:14:32,180 --> 00:14:35,350
.أ-أنت محقّ. بإمكان شيسي-سان ذلك

276
00:14:38,190 --> 00:14:41,360
.اكتشفتُ ما هو الشّبح

277
00:14:41,360 --> 00:14:42,150
!فـ-فعلاً؟

278
00:14:42,150 --> 00:14:44,320
أهو قطّ؟ أو ربّما فأر؟

279
00:14:44,820 --> 00:14:47,240
...الشّبح هو

280
00:14:50,570 --> 00:14:51,660
!شيسي

281
00:14:55,910 --> 00:14:58,830
عـ-عفوًا، ماذا تقصدين بذلك؟

282
00:14:58,830 --> 00:15:03,000
،حسب الوقت والمكان اللّذين ظهر فيهما الشّبح

283
00:15:03,420 --> 00:15:06,340
...إضافة إلى أنماطه السّلوكيّة

284
00:15:06,340 --> 00:15:09,430
...فإنّ الشّبح هو شيسي. والسّبب

285
00:15:09,430 --> 00:15:13,600
هو أنّ شيسي زارت هذا المنزل
!في الأيّام الماضية

286
00:15:13,850 --> 00:15:15,850
!لماذا لم تقولي ذلك من قبل؟

287
00:15:17,350 --> 00:15:21,480
!مفهوم، كانت أنت يا شيسي-سان
!كم أراحني هذا

288
00:15:21,480 --> 00:15:22,900
!كان بإمكانك إخبارنا باكرًا

289
00:15:23,270 --> 00:15:27,150
.حصلتُ على المفاتيح من جدّي

290
00:15:27,150 --> 00:15:28,900
!سُحقًا لذلك العجوز

291
00:15:29,150 --> 00:15:32,030
دخلتُ بدون إخباركما لأنّي لم أرد

292
00:15:32,030 --> 00:15:36,290
.التّطفّل أثناء وقتكما الخاصّ كزوجين جديدين

293
00:15:36,290 --> 00:15:37,910
!لم يكن هنالك أيّ وقت خاصّ

294
00:15:38,160 --> 00:15:43,000
،بما أنّنا سوّينا كلّ شيء
.أودّ البقاء للعشاء كمكافأة لي

295
00:15:43,000 --> 00:15:44,840
لكونك المحقّقة والجانية أيضًا؟

296
00:15:44,840 --> 00:15:49,760
.تناولتُ طعامًا من إعداد أكاني
.كان لذيذًا للغاية

297
00:15:49,760 --> 00:15:51,180
فـ-فعلاً؟

298
00:15:51,180 --> 00:15:56,180
.كان لذيذًا. طبخ أكاني هو الأفضل في العالم

299
00:15:56,180 --> 00:15:59,350
!بـ-بالطّبع هو كذلك
!ذلك واضح لمن لديهم ذوق

300
00:15:59,350 --> 00:16:02,600
—بالإمكان البحث في المجرّة بأكملها
!بل في الكون المتعدّد بأكمله

301
00:16:02,600 --> 00:16:05,180
!ولن تجدا أيّ أحد يضاهيني في الطّبخ

302
00:16:05,400 --> 00:16:08,360
.تريد شيسي أكل طبخ أكاني

303
00:16:08,360 --> 00:16:10,570
.شيسي جائعة للغاية

304
00:16:10,570 --> 00:16:12,530
!يمكنك الحصول على كلّ شيء يا شيسي-سان

305
00:16:12,530 --> 00:16:14,320
!سأعدّه من أجلك فحسب

306
00:16:19,240 --> 00:16:22,870
.لذيذ! كقطعة من النّعيم

307
00:16:23,540 --> 00:16:25,750
!سرّني أنّه أعجبك

308
00:16:25,750 --> 00:16:28,590
،إن كان هنالك أيّ شيء تريدينه
!فلا تخجلي من الطّلب

309
00:16:28,840 --> 00:16:30,510
!لذيذ

310
00:16:31,340 --> 00:16:33,510
.ثمّة طعام على وجهك ثانية

311
00:16:35,590 --> 00:16:36,640
...مهلاً

312
00:16:36,640 --> 00:16:37,640
ماذا هنالك؟

313
00:16:37,640 --> 00:16:39,600
.لا شيء

314
00:16:40,060 --> 00:16:43,980
هل أتخيّل أم أنّهما مقرّبان
من بعضهما بشكل غير عاديّ؟

315
00:16:46,610 --> 00:16:49,570
.أحسنت عملاً يا أخي-كُن

316
00:16:49,570 --> 00:16:52,030
.أرأيت؟ جرّبي أنت الآن

317
00:16:52,030 --> 00:16:53,860
.بدأت تتقنين لعبها الآن

318
00:16:54,990 --> 00:17:01,290
.نعم، ولكنّي أحبّ إمساكك بيديّ

319
00:17:01,870 --> 00:17:04,250
.بربّكما أنتما الاثنان

320
00:17:04,250 --> 00:17:05,330
ما-ماذا هنالك؟

321
00:17:05,330 --> 00:17:06,500
.لا شيء

322
00:17:06,500 --> 00:17:08,090
.أعلم أنّه لا شيء

323
00:17:08,090 --> 00:17:09,590
!واضح لي أنّك غاضبة من شيء ما

324
00:17:09,590 --> 00:17:10,840
!لستُ غاضبة

325
00:17:10,840 --> 00:17:13,510
!بل أنت غاضبة بالتّأكيد
!تبدين وكأنّك تريدين قتلي

326
00:17:13,510 --> 00:17:16,010
!يا له من قول فظّ لتقوله لفتاة

327
00:17:16,010 --> 00:17:17,510
!سأنتزع أسنانك بسبب ذلك

328
00:17:17,510 --> 00:17:18,550
أرأيت؟

329
00:17:19,890 --> 00:17:23,140
.تأخّر الوقت. من الأفضل أخذ حمّام

330
00:17:23,140 --> 00:17:24,520
.ستأتي شيسي أيضًا

331
00:17:24,520 --> 00:17:28,020
مهلاً! أليست شيسي في نفس عمرنا؟

332
00:17:28,020 --> 00:17:30,730
.تستحمّ شيسي دائمًا مع أخي-كُن

333
00:17:30,730 --> 00:17:31,650
!دائمًا؟

334
00:17:31,650 --> 00:17:33,610
!لا نقوم بذلك كثيرًا مؤخّرًا

335
00:17:33,610 --> 00:17:35,780
لا تقوما بذلك كثيرًا؟ مؤخّرًا؟

336
00:17:35,780 --> 00:17:39,160
مسموح بشخص واحد فقط
!في الحوض على حدة! اذهبا الآن

337
00:17:39,160 --> 00:17:40,580
!حالاً

338
00:17:44,790 --> 00:17:46,290
أين شيسي-سان؟

339
00:17:46,620 --> 00:17:48,330
.ما زالت تلعب

340
00:17:48,750 --> 00:17:52,300
،فرشتُ لها فوتون الضّيوف
.لذلك ستخلد للنّوف في النّهاية

341
00:17:52,300 --> 00:17:54,760
.بإمكاننا الحديث نحن الاثنين فقط أخيرًا

342
00:17:54,760 --> 00:17:57,930
أردتِ الحديث معي فقط؟

343
00:17:57,930 --> 00:18:00,550
!ذ-ذلك ليس ما قصدت

344
00:18:00,550 --> 00:18:03,220
!لديّ لائحة طويلة من الشّكاوى

345
00:18:03,220 --> 00:18:05,310
!لم أستطع ذكرها أمام شيسي-سان

346
00:18:05,850 --> 00:18:07,190
شكاوى؟

347
00:18:07,650 --> 00:18:08,820
.أنا أستمع لك

348
00:18:09,610 --> 00:18:12,480
.لعبة القطط تلك كبداية

349
00:18:12,480 --> 00:18:15,900
.أتمنّى لو أنّك أخبرتني أنّك أحضرتها من أجلنا

350
00:18:16,280 --> 00:18:20,820
،كنت مشغولة جدًّا بالدّراسة
.لذلك لم أرد إزعاجك

351
00:18:20,820 --> 00:18:24,830
!ما كان ذلك ليزعجني
.أحتاج لاستراحة من وقت لآخر

352
00:18:24,830 --> 00:18:29,500
.وأتمنّى... لو أنّك سمحت لي بلعبها أوّلاً

353
00:18:29,500 --> 00:18:33,960
لكي تكون لك الأفضليّة وتهزميني؟
.هذا غير مقبول

354
00:18:33,960 --> 00:18:38,010
!ذلك ليس السّبب
.قصدت أن ألعبها قبل شيسي-سان

355
00:18:38,010 --> 00:18:41,970
!يكفي، لا أدري لماذا أردتُ لعبها أوّلاً

356
00:18:41,970 --> 00:18:43,640
وكيف لي أن أعرف ذلك؟

357
00:18:43,640 --> 00:18:46,100
يجدر بك ذلك أيّها السّيّد صاحب
!العلامات المثاليّة بدون أيّ هدف

358
00:18:46,100 --> 00:18:47,100
!ماذا تقصدين بذلك؟

359
00:18:47,100 --> 00:18:50,060
ما أقصد هو أنّه لا معنى لامتلاك كعكة
!سمكة لعقل يشبه حاسوبًا في غاية التّطوّر

360
00:18:50,060 --> 00:18:51,730
!هل أنا كعكة السّمك في هذه التّشبيه؟

361
00:18:51,730 --> 00:18:54,230
يا لك من مسكين، لا بدّ أنّ لديك
!ذاكرة مشوّشة

362
00:18:54,230 --> 00:18:56,360
يمكنني أن أؤكّد لك أنّك مجرّد
!كعكة سمك كامابوكو لا غير

363
00:18:56,360 --> 00:18:57,610
!يا لك من كاذبة

364
00:18:58,780 --> 00:19:00,610
!أشعر بتحسّن كبير الآن

365
00:19:00,610 --> 00:19:04,030
.لا يكتمل يومي إلاّ إن أسمعتك ممّا عندي

366
00:19:04,030 --> 00:19:08,790
.تقولين ذلك وكأنّك تخفين حقيقتك عنّي

367
00:19:09,250 --> 00:19:10,870
أهذا كلّ شيء في لائحة شكاواك؟

368
00:19:10,870 --> 00:19:12,840
.ثمّة أمر أخير

369
00:19:12,840 --> 00:19:13,750
ما هو؟

370
00:19:13,750 --> 00:19:18,130
.عفوًا... إنّه بخصوص شيسي-سان

371
00:19:18,380 --> 00:19:20,720
.آسف بشأن مبيتها هنا اللّيلة فجأة

372
00:19:20,720 --> 00:19:24,390
.لا بأس بذلك! إنّها شخص ظريف

373
00:19:24,680 --> 00:19:27,060
...لا أفهم كيف أقول هذا

374
00:19:27,310 --> 00:19:31,770
أعتقد أنّك ربّما تعتني
.بشيسي-سان أكثر من اللاّزم

375
00:19:31,770 --> 00:19:36,280
إن لم أفعل، فستبدأ بأكل
.الحجارة على قارعة الطّريق

376
00:19:36,280 --> 00:19:38,270
لماذا؟ هل في ذلك مشكلة؟

377
00:19:38,530 --> 00:19:41,820
.مشكلة؟ لا أعتقد ذلك

378
00:19:41,820 --> 00:19:43,620
...ليست مشكلة، ولكن

379
00:19:43,620 --> 00:19:47,410
مهلاً، ما الّذي كنتُ أشتكي منه؟

380
00:19:51,000 --> 00:19:54,630
!مـ-مهلاً! لقد ربّتّ على مؤخّرتي للتّوّ

381
00:19:54,630 --> 00:19:56,290
—ماذا؟! من المستحيل أن أقوم بـ

382
00:19:57,710 --> 00:20:00,010
!أنت من تلمسين فخدي الآن

383
00:20:00,010 --> 00:20:02,430
!لماذا قد أفعل شيئًا فظيعًا كهذا؟

384
00:20:02,430 --> 00:20:03,970
!أنت هي الفظيعة

385
00:20:03,970 --> 00:20:06,300
!أعرف تمام المعرفة ألاّ أختبر حظّي مع التّنانين

386
00:20:06,680 --> 00:20:08,770
!هل تصفني بأنّني تنّينة؟

387
00:20:08,770 --> 00:20:11,810
أتريدني أن أشويك حيًّا حتّى
!يحترق شعرك كلّه؟

388
00:20:11,810 --> 00:20:13,310
.أثبتِّ كلامي فحسب

389
00:20:13,310 --> 00:20:15,560
.أخفضا صوتيكما. لا يمكنني النّوم

390
00:20:15,560 --> 00:20:16,400
شيسي-سان؟

391
00:20:16,400 --> 00:20:17,520
متى دخلت إلى هنا؟

392
00:20:17,520 --> 00:20:20,190
.قبل بداية الحضارة البشريّة

393
00:20:20,190 --> 00:20:21,200
.هذه مبالغة كبيرة

394
00:20:21,490 --> 00:20:24,030
.ستنام شيسي مع أخي-كُن أيضًا

395
00:20:24,030 --> 00:20:27,450
عندما كنت أبيت في منزل
.أخي-كُن، كنّا ننام معًا دائمًا

396
00:20:27,450 --> 00:20:28,440
دائمًا؟

397
00:20:28,440 --> 00:20:30,000
!ليس دائمًا

398
00:20:30,000 --> 00:20:32,580
.فقط عندما تحتاج شيسي لذلك
.ما باليد حيلة

399
00:20:33,170 --> 00:20:37,630
.كانت شيسي مع أخي-كُن مذ كانت طفلة

400
00:20:37,630 --> 00:20:41,840
تكون شيسي مرتاحة كثيرًا
.وهي قرب أخي-كُن

401
00:20:42,130 --> 00:20:43,800
.تشعر بالوحدة بمفردها

402
00:20:43,800 --> 00:20:46,390
.تحتكر أكاني أخي-كُن لنفسها بالكامل
.هذا ليس عدلاً

403
00:20:46,390 --> 00:20:50,180
!الـ-الأمر لا يتعلّق بالعدل
!لم أختر أن أكون معه

404
00:20:50,180 --> 00:20:51,060
فعلاً؟

405
00:20:51,060 --> 00:20:52,060
!فعلاً

406
00:20:52,060 --> 00:20:55,650
!لقد ضغط علينا جدّانا لنتزوّج

407
00:20:55,650 --> 00:20:56,360
...لذلك السّبب

408
00:20:56,560 --> 00:21:00,730
تريدين النّوم معه وحدك لتلك الدّرجة؟

409
00:21:00,730 --> 00:21:03,490
!ذ-ذلك ليس ما قصدته بذلك

410
00:21:03,700 --> 00:21:07,000
سأنام على الأرض لكي لا أعترض
.وقتكما الحميميّ معًا

411
00:21:07,000 --> 00:21:09,790
!لـ-لم نُقم علاقة حميميّة من قبل
!لا الآن ولا مستقبلاً

412
00:21:09,790 --> 00:21:11,250
!كلّ هذا سوء فهم

413
00:21:11,250 --> 00:21:13,250
!لننم جميعًا معًا رجاءً

414
00:21:20,130 --> 00:21:22,460
تشعرين بالغيرة أيضًا يا أكاني؟

415
00:21:22,460 --> 00:21:24,260
ماذا؟ بشان ماذا؟

416
00:21:24,260 --> 00:21:25,720
.بشأن أخي-كُن

417
00:21:25,720 --> 00:21:28,760
.غضبتِ لأنّ شيسي تتصرّف بودّ معه

418
00:21:28,760 --> 00:21:30,770
!ماذا؟ لم أكن غاضبة

419
00:21:30,770 --> 00:21:33,520
.لا يمكنك خداع شيسي

420
00:21:36,260 --> 00:21:38,070
هل احمرّ وجهك خجلاً يا أكاني؟

421
00:21:38,070 --> 00:21:39,340
!كلاّ

422
00:21:39,340 --> 00:21:43,140
.أخي-كُن بليد. لن يفهم ما لم تخبريه

423
00:21:43,140 --> 00:21:44,780
أخبره بماذا؟

424
00:21:44,780 --> 00:21:46,730
.لقد ارتحتُ قليلاً

425
00:21:47,110 --> 00:21:51,650
كنتُ قلقة من ألاّ يحظى
.أخي-كُن بحياة سعيدة

426
00:21:51,650 --> 00:21:53,660
ماذا تقصدين؟

427
00:21:54,050 --> 00:21:55,860
.تصبحين على خير

428
00:21:57,180 --> 00:21:58,780
!مهلاً! أنهِ كلامك

429
00:21:58,780 --> 00:22:00,620
!كما أنّكما قريبان جدًّا من بعضكما

430
00:22:00,630 --> 00:22:02,800
!ماذا حدث للمساحة الشّخصيّة؟