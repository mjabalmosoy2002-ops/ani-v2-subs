...حا-حاضر

187
00:10:13,630 --> 00:10:15,800
.أنت تعملين بجدّ يا أكاني

188
00:10:15,800 --> 00:10:17,810
أنت تعتقد أنّي بخيلة، صحيح؟

189
00:10:17,810 --> 00:10:19,430
.لا، على الإطلاق

190
00:10:19,430 --> 00:10:21,660
.فكّرتُ للتّوّ أنّك ستكونين زوجة جيّدة يومًا ما

191
00:10:21,660 --> 00:10:23,310
!ما-ماذا؟

192
00:10:25,550 --> 00:10:28,270
.من المؤسف أنّي متزوّجة سلفًا

193
00:10:28,270 --> 00:10:30,560
.صحيح. نسيت ذلك

194
00:10:44,090 --> 00:10:46,870
!لـ-لم تكن توشك على مهاجمتي، صحيح؟

195
00:10:46,870 --> 00:10:47,580
!ماذا؟

196
00:10:47,580 --> 00:10:49,710
!أنت من حضنني فجأة

197
00:10:49,710 --> 00:10:51,630
!ما كنتُ لأفعل ذلك

198
00:10:51,630 --> 00:10:52,500
!فعلتِها للتّوّ

199
00:10:52,500 --> 00:10:54,460
!كنتُ نائمًا بلا حراك كي لا أوقظك

200
00:10:54,460 --> 00:10:55,210
!أنت تكذب

201
00:10:55,210 --> 00:10:58,090
!رأيتك تحاول إحداث ثقب في خدّي

202
00:10:58,090 --> 00:10:59,710
!لماذا قد أفعل شيء دمويًّا كهذا؟

203
00:10:59,710 --> 00:11:01,590
ما الّذي كنت تفعله إذًا؟

204
00:11:05,180 --> 00:11:08,520
.كنتُ أتأمّل كم تبدين ظريفة وأنت نائمة

205
00:11:08,520 --> 00:11:12,710
.ولم أستطع مقاومة وخز خدّك. أنا آسف

206
00:11:14,360 --> 00:11:16,610
أ-أتقصد أنّ تلك الحقيقة؟

207
00:11:16,610 --> 00:11:17,440
.نعم

208
00:11:17,440 --> 00:11:20,240
كـ-كم بدوتُ ظريفة وقتها؟

209
00:11:20,240 --> 00:11:23,700
.ظريفة لدرجة أنّي كدت أفقد عقلي

210
00:11:27,790 --> 00:11:29,750
.لوهلة فحسب

211
00:11:35,170 --> 00:11:37,000
!يمكنك النّظر وأنا نائمة

212
00:11:37,420 --> 00:11:40,590
.إن كان لوهلة فحسب

213
00:12:05,030 --> 00:12:06,780
.صـ-صباح الخير

214
00:12:06,780 --> 00:12:09,200
.صباح الخير

215
00:12:15,250 --> 00:12:16,290
!ما الخطب؟

216
00:12:16,290 --> 00:12:19,130
.حرقتُ خبزي عن طريق الخطأ

217
00:12:19,130 --> 00:12:20,800
!لم تحرقيه فحسب، بل أضرمت فيه النّار

218
00:12:21,130 --> 00:12:23,760
.ماذا يحدث؟ تتصرّفين بغرابة اليوم

219
00:12:23,760 --> 00:12:26,050
ماذا عنك؟ أين ملابسك؟

220
00:12:26,390 --> 00:12:31,060
لا تكوني سخيفة! لماذا قد أتجوّل
في المنزل عاريًا؟

221
00:12:31,180 --> 00:12:35,310
خبز قشدة
الفراولة

222
00:12:31,850 --> 00:12:35,310
!منتج جديد
خبز قشدة الفراولة

223
00:12:32,770 --> 00:12:35,310
مليء بالقشدة
!بنكهة الفراولة المرّة

224
00:12:37,320 --> 00:12:38,940
.تفضّلي

225
00:12:38,940 --> 00:12:40,940
!يا إلهي، إنّه ضخم

226
00:12:40,940 --> 00:12:41,940
.لا يمكنني أكل كلّ هذا

227
00:12:42,280 --> 00:12:43,820
.لنتقاسمه إذًا

228
00:12:44,200 --> 00:12:45,700
نتقاسمه؟

229
00:12:46,410 --> 00:12:49,160
مهلاً، أهذا سايتو-كُن مع أكاني؟

230
00:12:49,830 --> 00:12:53,410
!لم أركما معًا خارج المدرسة من قبل

231
00:12:53,410 --> 00:12:54,710
هل ستذهبان للمدرسة معًا؟

232
00:12:54,710 --> 00:12:55,830
لماذا؟

233
00:12:55,830 --> 00:12:58,470
!لا-لا نسير للمدرسة معًا

234
00:12:58,470 --> 00:12:59,840
!على الإطلاق

235
00:12:59,840 --> 00:13:03,670
!سايتو يطاردني! اتّصلي بالشّرطة

236
00:13:03,670 --> 00:13:04,800
!مهلاً لحظة

237
00:13:04,800 --> 00:13:06,760
.يبدو أنّكما مستمتعان بوقتكما

238
00:13:06,760 --> 00:13:08,220
.حتّى أنّكما تقاسمتما الطّعام

239
00:13:08,220 --> 00:13:09,180
...هذا

240
00:13:09,180 --> 00:13:13,400
!لقد التقط قطعة رميتها وبدأ يأكلها

241
00:13:13,400 --> 00:13:14,600
أحقًّا يا سايتو-كُن؟

242
00:13:14,600 --> 00:13:15,510
!لستُ كلبًا شاردًا

243
00:13:15,510 --> 00:13:17,310
.لا، لستَ كذلك

244
00:13:17,310 --> 00:13:19,150
!أنت لستَ من ذلك النّوع من الأشخاص

245
00:13:19,150 --> 00:13:22,440
!كلّما رميتُ شيئًا ما، يقوم بالتهامه

246
00:13:22,440 --> 00:13:24,280
!أستطيع أن أقاضيك بتهمة التّشهير

247
00:13:24,280 --> 00:13:24,910
!مهلاً

248
00:13:25,360 --> 00:13:27,950
!ليس من الجيّد رمي الطّعام

249
00:13:27,950 --> 00:13:28,950
.أنا آسفة

250
00:13:28,950 --> 00:13:30,290
!ماذا عنّي؟

251
00:13:31,790 --> 00:13:34,910
.ما زلت تدرسين؟ تأخّر الوقت

252
00:13:34,910 --> 00:13:37,080
.نعم، لكن لدينا امتحان وشيك

253
00:13:37,080 --> 00:13:39,210
من يدرس لأجل امتحان؟

254
00:13:39,210 --> 00:13:42,590
لقد تذكّرت، حصلتَ على علامة
.مثاليّة في آخر امتحان

255
00:13:42,590 --> 00:13:44,300
ألا تحتاج للدّراسة؟

256
00:13:44,300 --> 00:13:46,380
.أنا لا أدرس للامتحانات

257
00:13:46,380 --> 00:13:48,180
.أحفظ ما يُقال في الفصول فحسب

258
00:13:48,180 --> 00:13:49,680
.من الصّعب نسيان ذلك

259
00:13:49,680 --> 00:13:50,640
هل تسخر منّي؟

260
00:13:50,640 --> 00:13:53,270
هل أنا غبيّة لأنّي أدرس باجتهاد؟

261
00:13:53,270 --> 00:13:56,230
.ذلك ليس ما قصدت. يبدو هذا صعبًا

262
00:13:56,690 --> 00:13:58,060
!اخرج فحسب

263
00:13:58,940 --> 00:14:00,520
!دعني وشأني

264
00:14:03,690 --> 00:14:05,190
ماذا تريد؟

265
00:14:05,190 --> 00:14:07,200
.أعددتُ وجبة ليليّة خفيفة

266
00:14:07,200 --> 00:14:09,030
فكّرتُ في أنّك قد تريدين
.الأكل منها بينما تدرسين

267
00:14:09,030 --> 00:14:10,450
وجبة خفيفة؟

268
00:14:11,990 --> 00:14:13,910
!شطيرة فراولة

269
00:14:13,910 --> 00:14:14,790
.تفضّلي

270
00:14:16,500 --> 00:14:19,830
لماذا قد يعدّ هذه لي؟

271
00:14:20,130 --> 00:14:22,340
ما الّذي يخطّط له؟

272
00:14:22,960 --> 00:14:24,880
.سـ-سأتذوّقها فحسب

273
00:14:24,880 --> 00:14:27,340
.لا ضرر من أكل قضمة واحدة

274
00:14:30,010 --> 00:14:31,300
!إنّها لذيذة

275
00:14:33,060 --> 00:14:36,850
!لا تتوقّع منّي التّساهل في الامتحان لأجل هذا

276
00:14:37,180 --> 00:14:39,440
!بإمكاني الدّراسة طوال اللّيل الآن

277
00:15:01,040 --> 00:15:02,880
أكاني! هل أنت بخير؟

278
00:15:03,840 --> 00:15:05,500
.لا بدّ أنّي غفوتُ قليلاً

279
00:15:05,500 --> 00:15:07,630
!من الخطير السّير وأنت نائمة

280
00:15:07,630 --> 00:15:10,590
.إنّك تبدين دائخة دائمًا هذه الأيّام

281
00:15:10,590 --> 00:15:12,180
أواثقة أنّك بخير؟

282
00:15:12,180 --> 00:15:14,760
.أنا فقط محرومة من النّوم بسبب الدّراسة

283
00:15:14,760 --> 00:15:16,390
.لا تضغطي على نفسك كثيرًا

284
00:15:16,390 --> 00:15:18,060
!اعتني بصحّتك

285
00:15:18,600 --> 00:15:21,770
،حتّى إن اقتضى الأمر أن يستحيل جسدي رمادًا

286
00:15:21,960 --> 00:15:24,440
فكلّ ما يهمّ هو حصولي على
.العلامة الأعلى في الفصل

287
00:15:24,440 --> 00:15:27,280
!صحّتك أهمّ من العلامات الدّراسية

288
00:15:27,280 --> 00:15:30,530
إضافة لذلك، لا يمكنك التّغلّب
.على سايتو-كُن

289
00:15:31,160 --> 00:15:33,200
لا يمكنني التّغلّب على سايتو؟

290
00:15:33,910 --> 00:15:37,290
!أقسم أنّي سأهزمه، وإن تطلّب الأمر قرونًا

291
00:15:37,290 --> 00:15:41,540
سأهزمه شرّ هزيمة ولن يكون لديه
!خيار إلاّ الاعتراف بأنّي أفضل منه

292
00:15:41,540 --> 00:15:45,920
.لا أدري. ستكونان قد تخرّجتما وقتها

293
00:15:45,920 --> 00:15:48,260
.بقيت لدينا سنة واحدة فقط في الثّانويّة

294
00:15:48,260 --> 00:15:51,720
هل ستتبعينه إلى الجامعة
إن لم تتغلّبي عليه قبل ذلك؟

295
00:15:51,720 --> 00:15:53,300
!بالطّبع لا

296
00:15:53,300 --> 00:15:56,310
!سيعني ذلك أنّي معجبة به بالفعل أو ما شابه

297
00:15:58,810 --> 00:16:00,800
أتريدين وجبة ليليّة خفيفة؟

298
00:16:02,390 --> 00:16:04,060
هل نمت؟

299
00:16:04,060 --> 00:16:05,820
.هيّا، اذهبي للنّوم في الفراش

300
00:16:06,690 --> 00:16:08,030
هل أنت بخير؟

301
00:16:08,030 --> 00:16:11,070
.أنا في أحسن حال

302
00:16:11,070 --> 00:16:13,310
.أنا آخذ استراحة فحسب

303
00:16:14,240 --> 00:16:15,910
.حرارتك مرتفعة

304
00:16:16,330 --> 00:16:17,910
.يكفي هذا لليوم

305
00:16:17,910 --> 00:16:19,700
...حـ-حسنًا

306
00:16:22,920 --> 00:16:25,580
.تعرّقتُ كثيرًا. أنا مشمئزّة من نفسي

307
00:16:25,580 --> 00:16:26,960
.تماسكي

308
00:16:36,600 --> 00:16:39,010
.ليس هناك

309
00:16:39,970 --> 00:16:40,980
.أنا آسف

310
00:16:43,480 --> 00:16:46,730
.أحتاج... لأدرس

311
00:16:46,730 --> 00:16:48,980
.ذلك هو سبب مرضك

312
00:16:48,980 --> 00:16:50,570
.لا تضغطي على نفسك

313
00:16:50,570 --> 00:16:52,360
.عليّ ذلك

314
00:16:52,360 --> 00:16:54,490
.إن أردتُ تحقيق حلمي

315
00:16:54,490 --> 00:16:55,360
حلم؟

316
00:16:55,360 --> 00:16:58,990
.أريد أن أصير طبيبة يومًا ما

317
00:16:58,990 --> 00:17:03,910
أريد مساعدة النّاس المحتاجين
.بمجرّد أن يحتاجوا للمساعدة

318
00:17:03,910 --> 00:17:06,920
.لا أريد أن أكون عاجزة

319
00:17:07,370 --> 00:17:11,880
أريد من الأشخاص الّذين أحبّهم
.أن يعيشوا حياة طويلة وصحّيّة

320
00:17:12,170 --> 00:17:17,430
لكنّ والداي لا يملكان الموارد
.لإدخالي إلى كلّيّة الطّبّ

321
00:17:17,430 --> 00:17:22,640
ووعدتني جدّتي بأنّها ستتحمّل
.تكاليف دراستي إن تزوّجتك

322
00:17:22,640 --> 00:17:24,180
...لذلك السّبب

323
00:17:24,180 --> 00:17:25,350
.فهمت

324
00:17:25,810 --> 00:17:27,730
.لا بدّ أنّ من الرّائع أن أكون في محلّك

325
00:17:27,730 --> 00:17:30,400
.بإمكانك التّقدّم بسهولة بفضل علاماتك الجيّدة

326
00:17:30,820 --> 00:17:33,530
.لا يهمّ كم أجتهد في العمل، لا يمكنني هزيمتك

327
00:17:33,530 --> 00:17:35,650
.إنّه أمر محبط

328
00:17:36,030 --> 00:17:38,660
.بعض النّاس أكثر موهبة من الآخرين فحسب

329
00:17:38,660 --> 00:17:40,840
.كم أكره قولك لأشياء كهذه

330
00:17:42,160 --> 00:17:44,660
.لكنّي لطالما كنت معجبة بك

331
00:17:44,660 --> 00:17:45,720
معجبة بي...؟

332
00:17:48,710 --> 00:17:50,040
!انسَ أنّي قلت ذلك

333
00:17:50,040 --> 00:17:51,420
!لستُ معجبة بك على الإطلاق

334
00:17:51,420 --> 00:17:53,090
!في الحقيقة، أكرهك

335
00:17:57,090 --> 00:18:00,600
حاجز الزّكام إكس

336
00:17:57,090 --> 00:18:00,600
من أجل الحمّى والقشعريرة

337
00:17:57,340 --> 00:17:59,470
هل انخفضت حرارتك؟

338
00:17:59,470 --> 00:18:00,600
.لستُ متأكّدة

339
00:18:02,510 --> 00:18:04,890
.ربّما سيكون علينا الاتّصال بالإسعاف

340
00:18:04,890 --> 00:18:07,100
.توقّف. لا تكبّر الموضوع

341
00:18:07,480 --> 00:18:10,270
سيّارات الإسعاف للأشخاص
.الّذين في حالات أسوأ

342
00:18:10,270 --> 00:18:14,110
إنّ الحمّى الّتي تتجاوز 40 درجة
.قد تعني شيئًا أكثر من مجرّد زكام

343
00:18:14,110 --> 00:18:16,240
.تعرفين ذلك بما أنّك تطمحين لتصيري طبيبة

344
00:18:16,610 --> 00:18:20,200
إن مات شخص ما كان في حالة حرجة
،لأنّني استعملتُ سيّارة الإسعاف

345
00:18:20,200 --> 00:18:21,740
.ما كنتُ لأسامح نفسي أبدًا

346
00:18:22,080 --> 00:18:23,240
.بربّك

347
00:18:26,210 --> 00:18:28,760
.سُحقًا، لا يمكنني استدعاء سيّارة أجرة أيضًا

348
00:18:28,760 --> 00:18:30,830
.أنا بخير. اذهب للنّوم

349
00:18:30,830 --> 00:18:32,620
.لدينا مدرسة غدًا

350
00:18:32,620 --> 00:18:33,710
.لا يمكنني ذلك

351
00:18:36,380 --> 00:18:38,380
ما-ما الّذي تفعله؟

352
00:18:38,590 --> 00:18:41,890
.لا يمكنني أن أغضّ الطّرف بينما زوجتي تعاني

353
00:18:42,600 --> 00:18:44,140
ز-زوجتك؟

354
00:18:58,610 --> 00:19:01,030
.أنت أقوى ممّا ظننت

355
00:19:01,570 --> 00:19:04,400
.لم أكن على دراية بحلمك

356
00:19:04,400 --> 00:19:07,330
.ستسخر منّي فحسب وتقول أنّه مستحيل

357
00:19:07,330 --> 00:19:10,080
.ما كنتُ لأفعل ذلك. أنا أؤمن بك

358
00:19:10,540 --> 00:19:11,920
لماذا؟

359
00:19:12,130 --> 00:19:14,410
أعلم أنّك ستواصلين العمل
.بجدّ حتّى تحقّقينه

360
00:19:14,410 --> 00:19:17,260
.أعتقد ذلك. نعم

361
00:19:17,260 --> 00:19:20,130
.أنا لا أعرف متى أستسلم

362
00:19:28,730 --> 00:19:31,150
.تزوّجتُ فتاة أكرهها

363
00:19:31,690 --> 00:19:34,690
.واضح أنّه تغيّر مؤسف في الأحداث

364
00:19:35,570 --> 00:19:38,030
...لكن يراودني شعور

365
00:19:39,820 --> 00:19:41,910
.بأنّ هذا الزّواج سينتهي بنهاية سعيدة

366
00:19:49,200 --> 00:19:52,080
!ما زلت في الفراش؟ استيقظ

367
00:19:52,080 --> 00:19:54,920
.نعم. أعلم، أعلم

368
00:19:54,920 --> 00:19:56,710
.ستتأخّر عن المدرسة

369
00:19:57,000 --> 00:20:00,550
.لا بأس. بإمكاني التّغيّب لشهر

370
00:20:01,010 --> 00:20:06,220
استيقظ قبل أن أضع هذه
.المقلاة السّاخنة فوق وجهك

371
00:20:09,310 --> 00:20:10,480
!صباح الخير

372
00:20:11,850 --> 00:20:12,900
.كان ذلك قاسيًا

373
00:20:12,900 --> 00:20:16,070
فعلاً؟ أهكذا تشكرني لأنّي أيقظتك؟

374
00:20:16,440 --> 00:20:18,190
.عليك أن تكون ممتنًّا

375
00:20:18,190 --> 00:20:19,530
.شكرًا لك

376
00:20:19,530 --> 00:20:21,320
بدون جزيلاً؟

377
00:20:21,320 --> 00:20:23,320
!شكرًا جزيلاً لك

378
00:20:23,320 --> 00:20:24,620
.جيّد

379
00:20:25,450 --> 00:20:28,410
.اتّضح أنّ أكاني كانت تعاني من الزّكام فقط

380
00:20:28,830 --> 00:20:32,270
،مرّ أسبوع على ذلك
.وعادت الأمور إلى طبيعتها

381
00:20:32,570 --> 00:20:35,290
هل ذهبتَ إلى المدرسة دون
أن تغسل وجهك البارحة؟

382
00:20:35,290 --> 00:20:37,800
لم يشكّل ذلك أيّ فرق
.بما أنّه تبلّل بسبب المطر

383
00:20:37,800 --> 00:20:39,210
أتعيش في العصور الحجريّة؟

384
00:20:39,210 --> 00:20:41,800
!إنّ ذلك من مسلّمات الحياة

385
00:20:41,800 --> 00:20:45,210
كيف يُعقل لشخص بمثل ذكائك
!أن يكون فظيعًا في كلّ شيء آخر؟

386
00:20:45,210 --> 00:20:47,640
.لا أنصحك بالحديث معي هكذا

387
00:20:48,340 --> 00:20:50,850
لماذا تتحدّث بتعال هكذا؟

388
00:20:50,850 --> 00:20:53,980
ما الّذي قلتِه ثانية؟ أقلت أنّك معجبة بي؟

389
00:20:55,730 --> 00:20:56,810
...ذ-ذلك ليس

390
00:20:56,810 --> 00:20:58,360
!كان ذهني مشوّشًا بسبب الحمّى

391
00:20:58,360 --> 00:21:00,230
.ربّما أكون قد سجّلتُ ذلك في هاتفي

392
00:21:00,730 --> 00:21:04,110
!سأذيبك في حمم ساخنة أنت وهاتفك

393
00:21:05,160 --> 00:21:07,240
!صباح الخير يا سايتو-كُن

394
00:21:07,240 --> 00:21:08,120
.صباح الخير

395
00:21:08,120 --> 00:21:11,950
حصلتَ على علامة كاملة ثانية
!في امتحان البارحة

396
00:21:11,950 --> 00:21:13,620
!أنت ذكيّ بالفعل

397
00:21:13,620 --> 00:21:16,380
.بالطّبع. احترميني وبجّليني

398
00:21:17,130 --> 00:21:19,250
.أنت غريب نوعًا ما يا سايتو-كُن

399
00:21:19,250 --> 00:21:20,170
أنا غريب؟

400
00:21:20,170 --> 00:21:23,760
.رغم أنّك لبيب، إلاّ أنّك لا تفهم بالإشارة

401
00:21:24,800 --> 00:21:26,640
.قد أتجرّأ وأصفك بالبلادة أيضًا

402
00:21:26,640 --> 00:21:28,140
أتمانعين لو تراجعتِ قليلاً؟

403
00:21:28,140 --> 00:21:29,350
ولماذا؟

404
00:21:29,350 --> 00:21:30,800
هل أشعرك ذلك بالخجل؟

405
00:21:30,800 --> 00:21:31,510
.إطلاقًا

406
00:21:34,040 --> 00:21:35,840
.أمزح فحسب

407
00:21:35,840 --> 00:21:38,240
!أفهم كيف يفكّر الرّجال

408
00:21:38,610 --> 00:21:40,480
...تنهيدة

409
00:21:44,020 --> 00:21:45,510
ما-ماذا هنالك؟

410
00:21:46,020 --> 00:21:50,520
.لا-لا تتصرّف بودّ كثير مع بقيّة الفتيات

411
00:21:50,520 --> 00:21:52,130
أنسيت أن لديك زوجة؟

412
00:21:55,960 --> 00:22:00,250
مؤخّرًا، لا يسعني سوى الشّعور
.أنّ لديّ أظرف زوجة على الإطلاق

413
00:23:35,060 --> 00:23:40,050
الحلقة 4        هجوم اللّيل