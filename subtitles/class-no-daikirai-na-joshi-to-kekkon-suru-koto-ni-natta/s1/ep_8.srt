1
00:00:03,810 --> 00:00:05,440
!سينباي

2
00:00:11,990 --> 00:00:13,200
من هذه؟

3
00:00:18,990 --> 00:00:20,540
أفعلاً يا سينباي؟

4
00:00:20,540 --> 00:00:22,080
!هذه أنا، أنا

5
00:00:22,080 --> 00:00:23,000
!أنا ماهو

6
00:00:23,000 --> 00:00:24,120
.لا فكرة لديّ من تكونين

7
00:00:24,120 --> 00:00:26,500
ماهو من؟ وما الّذي تريدين؟

8
00:00:26,880 --> 00:00:29,460
لم تسمع أيّ شيء عنّي؟

9
00:00:29,460 --> 00:00:32,300
.حسنًا، لا بأس. لا يهمّ

10
00:00:32,300 --> 00:00:36,140
.أنت على ذوقي يا سينباي
أتريد أن تصير حبيبي؟

11
00:00:36,140 --> 00:00:39,140
!ماذا؟

12
00:00:39,140 --> 00:00:43,890
!مهلاً! لا تتصرّف بشكل مفاجئ
.إنّك تجرح مشاعري

13
00:00:43,890 --> 00:00:45,810
.بالطّبع أنا متفاجئ

14
00:00:45,810 --> 00:00:48,810
مستحيل ألاّ أتفاجأ عند ظهور غريبة
.من العدم تطلب مواعدتي

15
00:00:48,810 --> 00:00:51,610
.لكنّي أعرف كلّ شيء عنك

16
00:00:51,610 --> 00:00:52,780
فعلاً؟

17
00:00:53,190 --> 00:00:54,530
...أعرف مثلاً

18
00:00:54,530 --> 00:00:58,570
،أنّ هيماري-سينباي طلبت مواعدتك
.لكنّك رفضت طلبها

19
00:00:58,570 --> 00:01:02,240
كيف أمكنك أن ترفضها؟
!يا معذّب قلوب العذارى

20
00:01:02,240 --> 00:01:03,040
—ذلك

21
00:01:03,040 --> 00:01:04,420
.أعرف السّبب أيضًا

22
00:01:04,870 --> 00:01:08,800
هذا لأنّك تعيش مع أكاني-سينباي، صحيح؟

23
00:01:10,500 --> 00:01:13,630
كيف عرفت ذلك؟

24
00:01:19,350 --> 00:01:22,310
"سوف أتزوّج من فتاة أكرهها من فصلي"

25
00:02:45,100 --> 00:02:48,930
"الحلقة 8: سينباي"

26
00:02:49,890 --> 00:02:52,030
كيف تعرفين ذلك؟

27
00:02:52,030 --> 00:02:55,530
!أعرف كلّ شيء عنك يا عزيزي سينباي

28
00:02:55,530 --> 00:02:58,030
.لا تتفادي الإجابة. اشرحي كيف تعرفين

29
00:02:58,030 --> 00:02:59,770
!لا أظنّني أريد ذلك

30
00:02:59,770 --> 00:03:02,750
!من تكونين؟

31
00:03:02,750 --> 00:03:04,620
وإذًا، هل ستواعدني؟

32
00:03:04,620 --> 00:03:08,280
هل تعتقدين أنّي سأوافق بعد كلّ ذلك؟

33
00:03:08,280 --> 00:03:09,540
!بالطّبع

34
00:03:09,540 --> 00:03:14,040
أعرف كلّ التّفاصيل القذرة
!عنك وعن أكاني-سينباي

35
00:03:14,040 --> 00:03:19,510
تخيّل ما قد يحدث
إن لم تفعل ما أطلبه منك؟

36
00:03:19,510 --> 00:03:21,930
!ما-ما كنتِ لتجرئي على ذلك

37
00:03:23,050 --> 00:03:25,510
!اسمعوا جميعًا

38
00:03:25,510 --> 00:03:28,810
—سايتو-سينباي من السّنة الثّالثة متزوّ –
!توقّفي، مهلاً –

39
00:03:29,560 --> 00:03:31,390
!كم أنت جريء يا سينباي

40
00:03:31,390 --> 00:03:31,940
—اسمعـ

41
00:03:31,940 --> 00:03:34,190
أتريد تذوّق شفتاي؟

42
00:03:39,360 --> 00:03:40,600
.شيسي

43
00:03:40,600 --> 00:03:42,780
.ستحمي شيسي أخي-كُن

44
00:03:42,780 --> 00:03:45,320
.كائنًا من كان الّذي سيقف في الطّريق

45
00:03:45,320 --> 00:03:46,990
—ستقاتل شيسي وتقف بفـ

46
00:03:46,990 --> 00:03:48,870
!ظريفة! ظريفة جدًّا

47
00:03:48,870 --> 00:03:51,250
!يا إلهي! ما كلّ هذه الظّرافة؟

48
00:03:51,250 --> 00:03:53,170
!إنّها مثل جنّيّة أو دمية

49
00:03:53,170 --> 00:03:54,000
أيمكنني أخذها للمنزل؟

50
00:03:54,000 --> 00:03:55,210
!لا يمكنك

51
00:03:55,210 --> 00:03:57,210
!لكنّي أريد، أريد، أريد

52
00:03:57,210 --> 00:03:58,500
!سأختطفك فحسب –
.كلاّ –

53
00:03:58,500 --> 00:04:00,010
!مهلاً

54
00:04:03,590 --> 00:04:05,220
!إلى اللّقاء يا سينباي

55
00:04:05,640 --> 00:04:08,350
!أجل! انتهت الدّراسة

56
00:04:08,970 --> 00:04:12,890
.ثمّة رائحة خطر
.يجب الحذر من تلك الفتاة

57
00:04:12,890 --> 00:04:15,560
.هذا صادر من الفتاة الّتي كادت أن تُختطف

58
00:04:15,560 --> 00:04:17,560
.ليس ذلك النّوع من الخطر

59
00:04:24,200 --> 00:04:26,910
.وأخيرًا، لديّ يوم لنفسي من باب التّغيير

60
00:04:30,540 --> 00:04:32,410
سينباي؟

61
00:04:32,410 --> 00:04:37,920
.عفوًا، أنا هنا لرؤية هوجو-سينباي

62
00:04:37,920 --> 00:04:39,550
أهو هنا؟

63
00:04:39,550 --> 00:04:40,550
!ماذا؟

64
00:04:40,550 --> 00:04:42,340
!هوجو، أنت ثانية

65
00:04:42,340 --> 00:04:46,090
،إيشيكورا في البداية
والآن تلميذات السّنة الأولى؟

66
00:04:46,090 --> 00:04:49,810
!لن أقبل بهذا، حتّى إن سامحك الإله بنفسه –
كيف لهذا أن يكون خطئي؟ –

67
00:04:51,810 --> 00:04:54,730
...هنالك لعبة زومبي

68
00:04:54,730 --> 00:04:56,650
.كان ذلك وشيكًا يا سينباي

69
00:04:56,650 --> 00:04:58,310
.وكلّ ذلك بسببك أنت

70
00:04:58,310 --> 00:05:01,440
ما الّذي جعلك تقولين أنّك معجبة بي؟

71
00:05:01,440 --> 00:05:03,570
لنرَ... ربّما حبّ من النّظرة الأولى؟

72
00:05:03,860 --> 00:05:04,990
.لا تتظاهري بالغباء

73
00:05:04,990 --> 00:05:06,910
.لستُ وسيمًا لتلك الدّرجة

74
00:05:08,530 --> 00:05:10,700
.أنا أعتقد ذلك

75
00:05:11,290 --> 00:05:12,660
.إن كنّا نتحدّث عن المظاهر فحسب

76
00:05:12,950 --> 00:05:14,370
!سينباي

77
00:05:14,710 --> 00:05:17,040
!انظر إلي، انظر إليّ

78
00:05:17,580 --> 00:05:19,170
!انتبهي

79
00:05:19,170 --> 00:05:20,840
!أحسنت بإمساكي يا سينباي

80
00:05:20,840 --> 00:05:23,760
!كفّي عن هذا! ستؤذين نفسك

81
00:05:23,760 --> 00:05:27,680
!لكنّي عرفتُ أنّك ستمسك بي

82
00:05:27,680 --> 00:05:28,850
...إضافة لذلك

83
00:05:29,140 --> 00:05:33,270
.الحياة أقصر من أن نعيشها بحذر

84
00:05:33,270 --> 00:05:36,850
.لا يعرف المرء متى قد يموت

85
00:05:36,850 --> 00:05:38,860
.لديك وجهة نظرة

86
00:05:38,860 --> 00:05:43,150
لذلك السّبب اعترفتُ لك بمجرّد
!أن عرفتُ أنّي معجبة بك

87
00:05:43,150 --> 00:05:45,230
.لا أستوعب ذلك. أنا لا أحبّ أيّ أحد

88
00:05:45,230 --> 00:05:48,360
.تبدو هذه كحياة مملّة للغاية

89
00:05:48,360 --> 00:05:49,720
.يا إلهي منك

90
00:05:50,780 --> 00:05:54,870
أنت لا تحبّ أكاني-سينباي
رغم أنّكما تعيشان معًا؟

91
00:05:55,620 --> 00:05:56,830
...تلك

92
00:05:57,580 --> 00:06:00,170
.ليست مسألة حبّ أو كره في حالتها هي

93
00:06:00,170 --> 00:06:01,370
!ممتاز، ممتاز

94
00:06:02,590 --> 00:06:05,170
!إذًا عليك الوقوع في حبّي أنا

95
00:06:05,170 --> 00:06:07,260
!واثقة أنّ ذلك سيكون ممتعًا

96
00:06:08,050 --> 00:06:11,010
،بما أنّك أنقذتني قبل لحظات

97
00:06:11,010 --> 00:06:13,260
!سأدعوك لتناول بعض الحلويّات

98
00:06:13,260 --> 00:06:14,630
.لا أريد ذلك

99
00:06:14,630 --> 00:06:19,770
لقد تذكّرت، أيمكنك أن ترافقني
إلى المركز التّجاريّ؟

100
00:06:19,980 --> 00:06:23,520
.أظنّني جعلتُ بقيّة الفتيات يكرهنني سلفًا

101
00:06:23,520 --> 00:06:27,320
ربّما أستطيع مصالحتهنّ بالعثور
.على متجر حلويّات جميل

102
00:06:27,320 --> 00:06:28,240
أموافق؟

103
00:06:34,030 --> 00:06:35,740
!كم هذا لذيذ

104
00:06:35,740 --> 00:06:37,620
!لا شيء أفضل من المأكولات السّريعة

105
00:06:37,620 --> 00:06:40,420
.ظننتُ أنّك تريدين حلويّات

106
00:06:40,420 --> 00:06:45,620
صحيح، لكنّ البرغر أفضل بكثير
.من الحلويّات الصّحّيّة

107
00:06:45,620 --> 00:06:48,420
.أفضّل هذا أنا أيضًا

108
00:06:48,420 --> 00:06:53,010
أحبّ المأكولات السّريعة مثل رامن
.الأكواب، لكنّ عائلتي توبّخني

109
00:06:53,760 --> 00:06:56,680
.يضغطون عليّ دائمًا لأكل طعام صحّيّ

110
00:06:56,680 --> 00:06:59,390
.لديّ شخص يضغط عليّ أيضًا

111
00:06:59,390 --> 00:07:03,650
أتعرّض للتّوبيخ في كلّ مرّة أحضر
.فيها رامن أكواب للمنزل

112
00:07:03,650 --> 00:07:06,110
.إنّه ليس بالأمر المهمّ أساسًا

113
00:07:06,110 --> 00:07:11,400
أعرف أنّ أختي الكبرى تريد مصلحتي
.فحسب، ولكنّ ذلك لا يغيّر الأمر

114
00:07:11,400 --> 00:07:13,450
لديك أخت كبرى؟

115
00:07:13,450 --> 00:07:14,410
أمتفاجئ؟

116
00:07:14,410 --> 00:07:15,870
.ليس تمامًا

117
00:07:15,870 --> 00:07:17,660
.واضح من شخصيّتك أنّك أخت صغرى

118
00:07:17,660 --> 00:07:19,290
أتقصد لأنّي ظريفة؟

119
00:07:19,290 --> 00:07:21,290
.بل أقصد سهولة تحمّسك لكلّ شيء

120
00:07:21,290 --> 00:07:23,750
لكنّك تجدني ظريفة، صحيح يا سينباي؟

121
00:07:23,750 --> 00:07:24,670
صحيح، صحيح؟

122
00:07:24,670 --> 00:07:27,500
ناهيك عن ذكر كم تحبّين
.الضّغط على الآخرين

123
00:07:27,500 --> 00:07:29,720
أختك الصّغرى تضغط عليك أيضًا؟

124
00:07:29,720 --> 00:07:31,540
.تفعل ذلك أكثر من أيّ أحد في العالم

125
00:07:31,540 --> 00:07:34,550
.لكنّها الأظرف أيضًا. لذلك لا بأس بالأمر

126
00:07:34,550 --> 00:07:36,310
أهذه عقدة أخت؟

127
00:07:36,310 --> 00:07:39,560
!لكن إن أردت رأيي، أختي أظرف

128
00:07:39,560 --> 00:07:41,390
.إنّك لا تختلفين عنّي إذًا

129
00:07:41,390 --> 00:07:43,900
!ما باليد حيلة، فأختي مثاليّة

130
00:07:44,560 --> 00:07:47,940
.يا سينباي، ثمّة صلصة على إصبعك

131
00:07:51,690 --> 00:07:52,320
ماذا؟

132
00:07:52,320 --> 00:07:53,320
!أجل

133
00:07:53,320 --> 00:07:54,320
ماذا فعلت؟

134
00:07:54,320 --> 00:07:56,410
!ماذا تقصد؟ لقد مسحتُ إصبعه بلعقه

135
00:07:56,410 --> 00:08:01,080
!أنت الوحيد الّذي سأفعل ذلك من أجله
!عليك أن تشكرني

136
00:08:01,080 --> 00:08:03,450
!لم يطلب أحد ذلك منك
!ولماذا التقطت صورة لذلك؟

137
00:08:03,680 --> 00:08:06,840
.لتكون ذكرى حبيبة وعزيزة لنا

138
00:08:06,840 --> 00:08:07,880
!لا حبّ ولا عزّة هنا

139
00:08:07,880 --> 00:08:11,590
!احذفيها في الحال –
!كلاّ، سينباي يطاردني –

140
00:08:13,380 --> 00:08:15,510
سُحقًا، أين ذهبت؟

141
00:08:23,600 --> 00:08:25,150
.ها أنت هنا

142
00:08:25,150 --> 00:08:28,490
...جعلت أنفاسي تنقطع

143
00:08:28,490 --> 00:08:30,340
.يا لك من منحرف يا سينباي

144
00:08:30,730 --> 00:08:33,200
.أنت من هرب منّي

145
00:08:33,200 --> 00:08:34,910
.حان وقت حذف الصّورة

146
00:08:35,240 --> 00:08:36,620
"حذف الصّورة" "إلغاء"
"حُذفت"

147
00:08:36,870 --> 00:08:40,620
.حسنًا. لنعد إلى المركز التّجاريّ

148
00:08:40,620 --> 00:08:43,620
ماذا؟ لست غاضبًا منّي؟

149
00:08:43,620 --> 00:08:48,130
ليس تمامًا. لا يمكنني السّماح لك
.بالاحتفاظ بتلك الصّورة فحسب

150
00:08:49,710 --> 00:08:53,970
أخبرني الجميع أنّك وأكاني-سينباي
.تتشاجران طوال الوقت

151
00:08:53,970 --> 00:08:55,130
.لكنّك لست لئيمًا

152
00:08:55,550 --> 00:08:58,600
.لا بدّ أنّكما غير متوافقين معًا

153
00:08:58,600 --> 00:09:01,510
.نعم، إنّها عدوّتي اللّدودة

154
00:09:01,770 --> 00:09:05,140
لكن لا يسعك سوى العيش معها؟
.لا بد أنّ ذلك صعب

155
00:09:05,380 --> 00:09:06,600
ألا تريد الانفصال عنها؟

156
00:09:06,600 --> 00:09:08,730
.إنّه ليس خيارًا

157
00:09:08,730 --> 00:09:10,520
.الأمر معقّد قليلاً

158
00:09:11,520 --> 00:09:15,240
!إنّك بارع في التّجوّل مع الآخرين
!كان ذلك ممتعًا جدًّا

159
00:09:15,240 --> 00:09:16,660
.سرّني سماع ذلك

160
00:09:17,030 --> 00:09:18,530
.حسنًا، سأغادر الآن

161
00:09:18,910 --> 00:09:21,110
تعرفين الطّريق للمنزل، صحيح؟

162
00:09:21,110 --> 00:09:23,290
.ماذا؟ لن أذهب للمنزل

163
00:09:23,290 --> 00:09:25,710
!سأذهب إلى منزلك

164
00:09:25,710 --> 00:09:28,460
تنتهي المواعيد بممارسات مثيرة
.في منزل الرّجل

165
00:09:28,460 --> 00:09:29,500
!يعرف الجميع هذا

166
00:09:29,500 --> 00:09:31,010
.بالتّأكيد لم أعرف

167
00:09:31,010 --> 00:09:32,840
!سأصرخ وأقول أنّك استغللتني

168
00:09:32,840 --> 00:09:33,380
!لماذا؟

169
00:09:33,380 --> 00:09:36,130
!للخروج في موعد
!يا لك من غبيّ يا سينباي

170
00:09:36,130 --> 00:09:38,510
!غبي! أبله! مغفّل

171
00:09:36,430 --> 00:09:38,510
!تـ-توّقفي

172
00:09:38,510 --> 00:09:40,890
أواثق من هذا يا سينباي؟

173
00:09:40,890 --> 00:09:45,890
ربّما ستكون هناك زلّة لسان منّي وسيعرف
.الجميع أنّك تعيش مع أكاني-سينباي

174
00:09:45,890 --> 00:09:46,900
!هذا ابتزاز

175
00:09:46,900 --> 00:09:49,150
!على الإطلاق! لا تكن سخيفًا

176
00:09:49,150 --> 00:09:53,570
.أنا مجرّد فتاة تطلب من فتى زيارة منزله

177
00:09:53,570 --> 00:09:56,910
ما كنت لترفض طلبي، صحيح؟

178
00:09:58,110 --> 00:09:59,530
.لا بأس، لا يهمّ

179
00:09:59,530 --> 00:10:03,040
!أجل! أنت الأفضل يا سينباي

180
00:10:05,540 --> 00:10:07,580
—لقد تأخّرت. أين كنـ

181
00:10:08,250 --> 00:10:10,170
ما-ما الّذي يحدث؟

182
00:10:10,170 --> 00:10:12,960
—أكاني، اسمعيني! يمكنني تفسير

183
00:10:13,250 --> 00:10:15,770
ما الّذي تفعله مع أختي الصّغرى؟

184
00:10:15,770 --> 00:10:18,510
ماذا؟ الأخت الصّغرى لمن؟

185
00:10:18,510 --> 00:10:22,050
!أختي أنا! هذه ساكوراموري ماهو

186
00:10:22,050 --> 00:10:24,020
ألم تخبرك بذلك؟

187
00:10:24,020 --> 00:10:25,560
ساكوراموري؟

188
00:10:25,560 --> 00:10:28,390
!كلاّ، كان الأمر يسير جيّدًا! يا ويحي

189
00:10:30,600 --> 00:10:33,270
!أختي

190
00:10:34,900 --> 00:10:36,900
!لقد عدت، لقد عدت، لقد عدت

191
00:10:36,900 --> 00:10:38,740
!اشتقت إليك كثيرًا

192
00:10:38,740 --> 00:10:40,780
.اهدئي يا ماهو

193
00:10:42,450 --> 00:10:45,910
!رائحتك زكيّة يا أختي

194
00:10:45,910 --> 00:10:47,910
.يا إلهي منك يا ماهو

195
00:10:47,910 --> 00:10:49,540
.أنت مدلّلة كثيرًا

196
00:10:51,790 --> 00:10:55,960
!صدرك ناعم للغاية
!صار أكبر من ذي قبل

197
00:10:55,960 --> 00:10:57,510
!ذ-ذلك ليس صحيحًا

198
00:10:57,510 --> 00:10:58,420
!بل صحيح

199
00:10:58,420 --> 00:11:02,170
.تتذكّر يداي حجم صدرك بشكل جيّد

200
00:11:02,430 --> 00:11:03,180
!وخز

201
00:11:04,310 --> 00:11:08,810
!كم أنت ظريفة يا أختي
!لا يمكنني المقاومة

202
00:11:08,810 --> 00:11:10,730
!هذا يكفي

203
00:11:12,310 --> 00:11:15,560
!كلاّ! آلمني ذلك يا أختي

204
00:11:15,560 --> 00:11:18,150
آ-آسفة! هل أنت بخير؟

205
00:11:18,150 --> 00:11:19,780
!أمزح فحسب! لا تبالي لي

206
00:11:19,780 --> 00:11:22,740
!بالكاد دفعتني. لا يؤلم ذلك بتاتًا

207
00:11:22,740 --> 00:11:24,070
.يا إلهي منك

208
00:11:24,620 --> 00:11:28,200
ظننتُ أنّ أختك الصّغرى قد توفّيت؟

209
00:11:28,200 --> 00:11:31,460
.ماذا؟ لم أقل ذلك أبدًا

210
00:11:32,080 --> 00:11:33,960
...لكنّك قلتِ

211
00:11:34,380 --> 00:11:36,300
.لا يمكنني رؤيتها بعد الآن

212
00:11:36,300 --> 00:11:39,090
.لقد رحلت إلى مكان بعيد

213
00:11:39,720 --> 00:11:42,470
.بدوتِ حزينة جدًّا بسبب ذلك

214
00:11:42,470 --> 00:11:44,470
!ذلك لأنّي كنتُ أسافر خارج البلاد

215
00:11:44,720 --> 00:11:46,220
تسافرين خارج البلاد؟

216
00:11:46,220 --> 00:11:47,010
!نعم

217
00:11:47,010 --> 00:11:51,230
طلبتُ بعض المال من جدّتي
!ولم تستطع المقاومة

218
00:11:51,230 --> 00:11:53,730
كنتُ أسافر عبر كلّ أرجاء
.العالم منذ الإعداديّة

219
00:11:53,730 --> 00:11:55,900
مرّ وقت طويل منذ آخر مرّة
!كنتُ فيها في اليابان

220
00:11:55,900 --> 00:11:56,970
فعلاً؟

221
00:11:57,170 --> 00:12:01,000
.حسنًا! حان الوقت للبحث في حياتكما المشتركة

222
00:12:01,000 --> 00:12:02,320
البحث؟

223
00:12:02,320 --> 00:12:04,450
هل طلبت جدّتي ذلك منك؟

224
00:12:04,450 --> 00:12:06,200
.لم يطلب منّي أيّ أحد أيّ شيء

225
00:12:06,200 --> 00:12:10,450
بصفتي أختك الصّغرى، أحتاج
.لأكون على اطّلاع بحياتك الزّوجيّة

226
00:12:10,450 --> 00:12:11,910
!لا تصفيها كذلك

227
00:12:11,910 --> 00:12:14,670
!أوّلاً، سأتحقّق من غرفة نوم أختي

228
00:12:13,870 --> 00:12:15,080
!تـ-توقّفي

229
00:12:15,670 --> 00:12:16,840
!وجدتُها

230
00:12:17,170 --> 00:12:18,460
!ما هذا؟

231
00:12:18,460 --> 00:12:20,130
!ثمّة وسادتان

232
00:12:20,130 --> 00:12:22,590
...ذ-ذلك طبيعيّ، إنّه سرير مشترك

233
00:12:22,590 --> 00:12:24,050
سرير مشترك؟

234
00:12:24,050 --> 00:12:27,600
تقصدين أنّكما تنامان معًا كلّ ليلة؟

235
00:12:27,910 --> 00:12:29,220
.ذلك صحيح

236
00:12:29,220 --> 00:12:30,310
إذًا فقد قمتما بكلّ شيء؟

237
00:12:30,310 --> 00:12:31,270
!لم نقم بأيّ شيء

238
00:12:31,270 --> 00:12:31,860
!كاذبة

239
00:12:31,860 --> 00:12:33,350
!من المستحيل أن يكون ذلك صحيحًا

240
00:12:33,350 --> 00:12:36,310
!لقد كنتما تنامان معًا كلّ ليلة

241
00:12:36,310 --> 00:12:38,820
!كلاّ! أوّل تجربة لأختي

242
00:12:38,820 --> 00:12:40,190
!سأقتلك على هذا يا أخي

243
00:12:40,190 --> 00:12:42,100
!أخبرتك أنّه لم يحدث أيّ شيء

244
00:12:42,100 --> 00:12:44,610
فعلاً؟ لم تقبّلا بعضكما حتّى؟

245
00:12:44,610 --> 00:12:45,610
!بالطّبع لا

246
00:12:45,610 --> 00:12:47,500
!ما كنتُ لأفعل شيئًا مقرفًا كهذا

247
00:12:47,500 --> 00:12:49,120
هل أمسكتما بأيدي بعضكما؟

248
00:12:49,120 --> 00:12:50,450
...كـ-كلاّ

249
00:12:50,450 --> 00:12:53,750
هكذا إذًا! ولا حتّى مرّة بينما أنتما غافلين؟

250
00:12:53,750 --> 00:12:56,630
أو في وقت انغمستما فيه في اللّحظة؟

251
00:12:56,630 --> 00:12:59,500
من المستحيل أن أنغمس
!في لحظة مع سايتو

252
00:12:59,500 --> 00:13:01,130
أواثقة؟

253
00:13:01,130 --> 00:13:03,760
على الأقلّ راودتكما تخيّلات
عن بعض، صحيح؟

254
00:13:03,760 --> 00:13:04,380
!مستحيل

255
00:13:06,430 --> 00:13:11,520
في كلّ الأحوال، سيكون عليّ
!مراقبتكما لمنع حدوث أيّ شيء

256
00:13:11,520 --> 00:13:15,640
!سأبيت هنا اللّيلة وأبحث في حياتكما اللّيليّة

257
00:13:15,640 --> 00:13:20,390
أشعر بتهديد أكبر بمعرفتي أنّي
.تحت سقف واحد معك فحسب

258
00:13:20,390 --> 00:13:24,280
فعلاً؟ أتعني أنّك تخشى أن تنقضّ عليّ؟

259
00:13:24,280 --> 00:13:26,020
!يا لك من وحش يا أخي

260
00:13:26,020 --> 00:13:28,320
سايتو! إيّاك أن تجرؤ على لمس
شعرة من أختي الصّغرى

261
00:13:28,320 --> 00:13:30,780
!وإلاّ سأمزّقك لأشلاء وأنت مستيقظ

262
00:13:30,780 --> 00:13:33,160
!هذا يسمّى تعذيب

263
00:13:33,160 --> 00:13:34,580
!أرجوك يا أختي

264
00:13:34,580 --> 00:13:37,660
!مرّ وقت طويل مذ تذوّقت طبخك

265
00:13:37,660 --> 00:13:41,250
!بالطّبع يمكنك البقاء
!ابقي بالقدر الّذي تشائين

266
00:13:41,250 --> 00:13:43,960
!أجل! كم أنت لطيفة يا أختي

267
00:13:45,040 --> 00:13:46,530
...شقيّة

268
00:13:48,300 --> 00:13:50,800
!حسنًا، سأعدّ قِدرًا مليئًا بالثّريد

269
00:13:50,800 --> 00:13:51,930
للعشاء؟

270
00:13:51,930 --> 00:13:54,930
.نعم، للاحتفال بعودة ماهو

271
00:13:54,930 --> 00:13:57,800
!أيّ شيء آخر! أيّ شيء آخر غير الثّريد

272
00:13:57,800 --> 00:14:00,440
ما السّيّئ جدًّا بخصوص الثّريد؟

273
00:14:00,440 --> 00:14:03,900
عندما كنتُ صغيرة، كنتُ أتناول
.الثّريد كلّما مرضت

274
00:14:03,900 --> 00:14:05,530
.ما عدت أتحمّل

275
00:14:05,530 --> 00:14:06,320
.لا بأس

276
00:14:06,320 --> 00:14:07,070
!أختي

277
00:14:07,070 --> 00:14:09,450
سأضيف إليه البرقوق المخلّل
!لهذه المرّة فقط

278
00:14:09,450 --> 00:14:11,830
!ذلك ليس قصدي

279
00:14:13,120 --> 00:14:15,660
.أنا أحبّ ثريد أختي بالفعل

280
00:14:15,660 --> 00:14:18,960
.نعم! عليّ إقناع نفسي بذلك فحسب

281
00:14:18,960 --> 00:14:21,460
...سيسهل عليّ أكله هكذا

282
00:14:21,670 --> 00:14:24,510
.حسنًا، أحتاج لإضافة بعض البروتين

283
00:14:24,510 --> 00:14:25,960
ألدينا بيض؟

284
00:14:28,470 --> 00:14:30,050
ما-ماذا؟ شيسي-سان؟

285
00:14:30,050 --> 00:14:31,300
ما الّذي تفعلينه هنا؟

286
00:14:31,300 --> 00:14:32,640
.إنّها باردة سلفًا

287
00:14:32,640 --> 00:14:35,350
.لا بدّ أنّها ثلاّجة عالية الأداء

288
00:14:39,850 --> 00:14:43,440
.تحتاج شيسي لتنفّس اصطناعيّ من أخي-كُن

289
00:14:43,440 --> 00:14:44,730
.لا بأس، إنّها حيّة

290
00:14:44,730 --> 00:14:46,980
!شي-تشان! مرحى

291
00:14:47,280 --> 00:14:49,780
!بإمكاني القيام بالتّنفّس الاصطناعيّ

292
00:14:49,780 --> 00:14:50,490
.أرفض

293
00:14:50,490 --> 00:14:53,200
.شفتا شيسي من حقّ أخي-كُن فقط

294
00:14:53,200 --> 00:14:55,040
!أخي! أعطني شي-تشان

295
00:14:55,040 --> 00:14:56,660
!أعد أن أهتمّ بها جيّدًا

296
00:14:56,660 --> 00:14:59,290
!أنت آخر شخص قد أعطيها له

297
00:14:59,460 --> 00:15:04,920
لماذا؟ لماذا تدعوك بأخي؟

298
00:15:04,920 --> 00:15:07,550
.يفترض أن تكون شيسي أختك الوحيدة

299
00:15:07,550 --> 00:15:09,630
!إنّه زوج أختي

300
00:15:09,630 --> 00:15:11,140
!وذلك يجعله أخي

301
00:15:11,140 --> 00:15:12,550
صحيح يا أخي؟

302
00:15:14,180 --> 00:15:16,850
!ذلك مكاني أنا

303
00:15:17,220 --> 00:15:18,640
!لنتنازل

304
00:15:18,640 --> 00:15:20,060
لأيّ سبب؟

305
00:15:20,060 --> 00:15:24,900
!لنقرّر من الجديرة بأن تكون أخت أخي الصّغرى

306
00:15:25,360 --> 00:15:27,070
!نزال الأخوات الصّغيرات

307
00:15:28,610 --> 00:15:29,820
أمستعدّة؟

308
00:15:29,820 --> 00:15:31,060
!سأبدأ

309
00:15:33,570 --> 00:15:34,990
...اسمع يا أخي

310
00:15:34,990 --> 00:15:39,570
بإمكاني جعلك تشعر بشعور
.رائع بصفتي أختك الصّغيرة

311
00:15:39,570 --> 00:15:41,700
مـ-مهلاً يا ماهو! ما الّذي تفعلينه؟

312
00:15:39,580 --> 00:15:41,710
!عفوًا

313
00:15:41,930 --> 00:15:43,330
ما رأيك يا أخي؟

314
00:15:43,330 --> 00:15:45,630
أنا ممتازة كأخت صغرى، صحيح؟

315
00:15:45,630 --> 00:15:46,450
!أعطني علامة

316
00:15:46,450 --> 00:15:47,170
.صفر

317
00:15:47,170 --> 00:15:48,760
ماذا؟ لماذا؟

318
00:15:48,760 --> 00:15:50,210
.أنت وقحة كثيرًا بالنّسبة لأخت صغرى

319
00:15:50,210 --> 00:15:51,840
.استسلمي يا ماهو

320
00:15:51,840 --> 00:15:54,890
.وحدها شيسي يمكنها أن تكون أخت أخي-كُن

321
00:15:54,890 --> 00:15:58,720
!شاهدي مهارات شيسي المطلقة

322
00:15:58,720 --> 00:16:01,230
!نزال الأخوات الصّغيرات

323
00:15:59,480 --> 00:16:01,230
الجولة الثّانية

324
00:16:06,270 --> 00:16:07,650
...أخي-كُن

325
00:16:07,650 --> 00:16:09,230
احملني؟

326
00:16:12,490 --> 00:16:14,240
.احملني

327
00:16:16,230 --> 00:16:20,240
!علامة مثاليّة

328
00:16:20,580 --> 00:16:21,410
.أجل

329
00:16:21,660 --> 00:16:25,420
أكره الاعتراف بهذا، لكن من الصّعب
.هزيمة ظرافة شي-تشان

330
00:16:25,710 --> 00:16:29,090
.حتّى أنا أريدها أن تكون أختي الصّغرى

331
00:16:29,090 --> 00:16:30,590
.لا داعي للقلق يا ماهو

332
00:16:30,590 --> 00:16:33,510
أنت أفضل أخت صغرى
.في العالم بالنّسبة لي

333
00:16:33,510 --> 00:16:34,470
!أختي

334
00:16:34,470 --> 00:16:37,930
وأنت أفضل أخت كبرى
!في العالم بالنّسبة لي

335
00:16:37,930 --> 00:16:38,930
!ماهو

336
00:16:38,930 --> 00:16:40,270
!أختي

337
00:16:45,690 --> 00:16:49,070
!وأخيرًا! حصلنا على بعض الوقت وحدنا

338
00:16:49,070 --> 00:16:51,190
!كأنّني في منزلنا

339
00:16:51,190 --> 00:16:54,950
لماذا لم تخبريني أنّك عدت لليابان؟

340
00:16:54,950 --> 00:16:56,700
.كان بمقدوري رؤيتك في وقت أبكر

341
00:16:56,700 --> 00:17:00,320
أردتُ أن أفاجئك. أنجح الأمر؟

342
00:17:00,330 --> 00:17:02,120
!بالطّبع فاجأتني

343
00:17:02,120 --> 00:17:05,080
.لم أتخيّل أبدًا أن أراك ممسكة بذراع سايتو

344
00:17:05,290 --> 00:17:08,590
.في الحقيقة، لديّ عرض لك

345
00:17:09,670 --> 00:17:12,350
ماذا لو تزوّجتُه أنا؟

346
00:17:12,350 --> 00:17:13,050
ماذا؟

347
00:17:13,770 --> 00:17:17,390
بدأ كلّ هذا لأنّ جدّتنا وجدّه

348
00:17:17,390 --> 00:17:22,470
أرادا أن يعيشا حبّ المراهقة خاصّتهما
من خلال حفيديهما، صحيح؟

349
00:17:22,470 --> 00:17:25,480
.نعم، لسوء الحظّ

350
00:17:25,480 --> 00:17:28,980
.إذًا لا يوجد سبب يمنعني أنا من القيام بذلك

351
00:17:28,980 --> 00:17:32,780
بإمكاني جعل جدّتي تستسلم
!بسهولة لتمويل تعليمك

352
00:17:32,780 --> 00:17:33,980
ما رأيك؟

353
00:17:34,280 --> 00:17:39,370
أنا لا أدري إن كنت تستطيعين
.مجاراة شخص مثله

354
00:17:39,370 --> 00:17:40,360
لِمَ لا؟

355
00:17:40,360 --> 00:17:43,410
.إنّه مغرور وأنانيّ جدًّا

356
00:17:43,410 --> 00:17:46,120
.يعتقد أنّه الأفضل في كلّ شيء

357
00:17:46,120 --> 00:17:47,670
!لا بأس بذلك

358
00:17:47,670 --> 00:17:52,130
!قد يكون الأذكى، لكنّي أعلم أنّي الأظرف

359
00:17:52,130 --> 00:17:56,720
لا يمكنه الطّبخ ويحضر رامن الأكواب
.إلى المنزل خلسة طوال الوقت

360
00:17:56,720 --> 00:17:58,840
!أنا أحبّ رامن الأكواب أيضًا

361
00:17:59,850 --> 00:18:03,060
.ويلعب ألعاب الزّومبي الشّنيعة دائمًا

362
00:18:03,060 --> 00:18:05,810
!أنا أحبّها، من الممتع إطلاق النّار على الزّومبي

363
00:18:07,140 --> 00:18:08,130
ما الخطب؟

364
00:18:08,480 --> 00:18:10,690
ألا تمانعين هذا بالفعل؟

365
00:18:10,690 --> 00:18:13,390
ألا تريدين التّزوّج من شخص تحبّينه؟

366
00:18:14,030 --> 00:18:17,900
،لا أعرف الكثير عنه بعد
!لكنّه يبدو على ذوقي

367
00:18:17,900 --> 00:18:19,660
أ-أذلك صحيح؟

368
00:18:19,950 --> 00:18:21,530
!نعم! انظري لهذه

369
00:18:21,530 --> 00:18:24,540
.إنّنا مقرّبان من بعض سلفًا

370
00:18:24,770 --> 00:18:29,250
،كانت هنالك صلصة على إصبعه
.لذلك قمتُ بلعقها

371
00:18:29,250 --> 00:18:32,000
!أخبرني أنّي كنت ظريفة كجرو صغير

372
00:18:32,000 --> 00:18:34,540
.تـ-تكذبين. ما كان سايتو ليقول ذلك

373
00:18:34,540 --> 00:18:37,800
.الأمر صحيح! لعقت إصبعه جيّدًا

374
00:18:37,800 --> 00:18:39,890
ألم تلتقيا للتّوّ؟

375
00:18:39,890 --> 00:18:40,810
!نعم

376
00:18:40,810 --> 00:18:44,140
.لا بدّ أنّنا متوافقان فحسب

377
00:18:44,140 --> 00:18:46,560
.أراهن أنّنا سننسجم معًا كزوجين

378
00:18:46,560 --> 00:18:48,190
!لذلك لا شيء يدعو للقلق

379
00:18:48,440 --> 00:18:50,940
.أعتقد أنّ ذلك صحيح

380
00:18:50,940 --> 00:18:52,400
!سرّني هذا

381
00:18:52,400 --> 00:18:54,900
!يمكنك تركه لي

382
00:18:54,900 --> 00:18:56,860
!سأذهب للتّقرّب منه

383
00:18:56,860 --> 00:18:57,950
!مـ-مهلاً

384
00:19:00,780 --> 00:19:04,440
لماذا حاولت إيقافها قبل قليل؟

385
00:19:05,160 --> 00:19:07,330
.لا بدّ أنّي أعاني شيئًا ما

386
00:19:10,370 --> 00:19:11,710
!أخي

387
00:19:11,710 --> 00:19:14,960
!عزيزتك ماهو هنا لتغسل ظهرك

388
00:19:14,960 --> 00:19:17,260
!قمتُ بذلك سلفًا. غادري

389
00:19:17,260 --> 00:19:19,680
أتطلب منّي أن أغسل شيئًا
آخر في الأسفل؟

390
00:19:19,680 --> 00:19:20,720
!يا لجرأتك

391
00:19:20,720 --> 00:19:21,720
شيء آخر؟ مثل ماذا؟

392
00:19:21,720 --> 00:19:24,100
!مثل أمعائك الدّقيقة بالطّبع

393
00:19:24,350 --> 00:19:26,350
.يبدو هذا مرعبًا

394
00:19:27,100 --> 00:19:31,270
.إن حاولت الهرب، سأخبر أختي أنّك هاجمتني

395
00:19:31,270 --> 00:19:34,230
.ما كانت أكاني لتصدّق كذبة كهذه

396
00:19:34,230 --> 00:19:37,360
أواثق من ذلك؟ من ستصدّق؟

397
00:19:37,360 --> 00:19:41,230
أختها الصّغرى العزيزة؟
أو عدوّها اللّدود المكروه؟

398
00:19:41,230 --> 00:19:42,990
.أنا بالطّبع

399
00:19:42,990 --> 00:19:46,990
إذًا هل توافق على اللّعب بلطف معي؟

400
00:19:46,990 --> 00:19:48,370
.افعلي ما يحلو لك

401
00:19:50,000 --> 00:19:53,170
هل استحممت مع أختي أيضًا؟

402
00:19:53,170 --> 00:19:54,000
.لا

403
00:19:54,000 --> 00:19:56,710
ماذا عن الفتيات الأخريات؟
.من غير العائلة

404
00:19:56,710 --> 00:19:57,510
.لا

405
00:19:57,510 --> 00:19:59,970
.أي أنّي الأولى

406
00:19:59,970 --> 00:20:02,260
.أنت الأوّل بالنّسبة لي أيضًا

407
00:20:02,760 --> 00:20:05,890
ما رأيك أن نتزوّج يا أخي؟

408
00:20:05,890 --> 00:20:07,770
ماذا؟ ماذا تقصدين؟

409
00:20:07,770 --> 00:20:14,270
لا يهتمّ جدّك وجدّتي إلاّ بأن يتزوّج
حفيداهما من بعضهما، صحيح؟

410
00:20:14,270 --> 00:20:16,020
.أظنّ ذلك

411
00:20:16,020 --> 00:20:18,530
.إذًا بإمكاني أن أكون زوجتك

412
00:20:18,530 --> 00:20:24,030
أنا من النّوع الملتزم، وسأسمح
.لك بفعل أيّ شيء تريده

413
00:20:24,030 --> 00:20:25,400
أيّ شيء؟

414
00:20:25,400 --> 00:20:26,870
.نعم، أيّ شيء

415
00:20:26,870 --> 00:20:31,670
.إن كنت تريد، فجسدي بأكمله لك

416
00:20:31,670 --> 00:20:35,800
.بإمكانك القيام بما تشاء بي

417
00:20:36,750 --> 00:20:39,790
.سيكون عليّ التّفكير في الأمر

418
00:20:40,060 --> 00:20:43,790
هل تسمح لك أختي بالاستحمام معها؟

419
00:20:44,090 --> 00:20:47,750
أو الحصول على ما تريد؟

420
00:20:48,170 --> 00:20:51,310
.أعرف أنّها لا تفعل. أمّا أنا فعكسها

421
00:20:52,060 --> 00:20:56,110
.يمكنني أن أكون موضوع تحقيق كلّ رغباتك

422
00:20:59,940 --> 00:21:03,360
تبدو متعبًا جدًّا. ما الخطب؟

423
00:21:03,360 --> 00:21:06,320
.أختك الصّغرى تربكني كثيرًا

424
00:21:06,320 --> 00:21:09,370
إنّها... متحرّرة؟ مليئة بالنّشاط؟

425
00:21:09,370 --> 00:21:13,200
.أنا مسرورة لرؤيتها نشيطة هكذا

426
00:21:13,580 --> 00:21:17,460
.كانت مريضة جدًّا كطفلة

427
00:21:17,460 --> 00:21:19,710
.كنتُ قلقة عليها دائمًا

428
00:21:19,710 --> 00:21:23,970
.أنا سعيدة جدًّا ما دامت في صحّة جيّدة

429
00:21:24,220 --> 00:21:29,220
قد تكون مدلّلة قليلاً، لكنّي
.أريد منحها كلّ ما أستطيع

430
00:21:29,500 --> 00:21:33,230
.أريدها أن تعيش حياة سعيدة فحسب

431
00:21:34,870 --> 00:21:36,740
...ا-اسمع، بالمناسبة

432
00:21:36,740 --> 00:21:38,770
.ثمّة أمر أردتُ أن أسألك عنه

433
00:21:38,770 --> 00:21:39,830
ما هو؟

434
00:21:40,340 --> 00:21:43,470
سايتو، أتريد الانفصال عنّي؟

435
00:21:43,470 --> 00:21:44,240
ماذا؟

436
00:21:44,480 --> 00:21:46,550
لماذا تقولين ذلك؟

437
00:21:46,550 --> 00:21:48,750
.كنتُ أتساءل فحسب

438
00:21:48,750 --> 00:21:50,570
لماذا تتساءلين عن ذلك؟

439
00:21:50,570 --> 00:21:54,330
إن أردتُ الانفصال، فهل ستوافقين؟

440
00:21:54,760 --> 00:21:57,010
...إنّ ذلك

441
00:22:00,630 --> 00:22:04,260
ما الّذي أريده؟

442
00:23:35,010 --> 00:23:40,010
الحلقة 9        حبّ أخوات