1
00:00:00,890 --> 00:00:02,480
!وصلنا

2
00:00:02,480 --> 00:00:03,850
!أحبّ حدائق الملاهي

3
00:00:03,850 --> 00:00:05,650
!لنقدّم كلّ ما لدينا اليوم

4
00:00:05,650 --> 00:00:06,560
!أجل

5
00:00:06,560 --> 00:00:08,440
!إنّها حفلة التّرحيب بك يا ماهو-تشان

6
00:00:08,440 --> 00:00:09,940
!هيّا بنا يا أخي

7
00:00:09,940 --> 00:00:11,990
!لنبدأ بموعدنا الرّائع

8
00:00:11,990 --> 00:00:15,780
عفوًا، كنت أريد السّؤال
،عن هذا منذ فترة

9
00:00:15,780 --> 00:00:19,240
لكن ما الّذي يحدث بينكما؟

10
00:00:19,240 --> 00:00:22,000
!لنقل أنّني وهيمارين متنافستين الآن

11
00:00:22,000 --> 00:00:24,750
!سيكون أخي لي أنا بالكامل على هذا المعدّل

12
00:00:24,750 --> 00:00:26,750
!لن أسمح بهذا

13
00:00:26,750 --> 00:00:28,510
.هذا مقرف

14
00:00:28,510 --> 00:00:29,550
!هيّا بنا يا شيسي

15
00:00:29,550 --> 00:00:31,540
أجاهزة لركوب كلّ لعبة؟

16
00:00:31,540 --> 00:00:35,550
.أنا جاهزة لأكل كلّ شيء هنا

17
00:02:06,100 --> 00:02:10,480
الحلقة 9    حبّ أخوات

18
00:02:19,740 --> 00:02:21,740
!تماسكي

19
00:02:42,760 --> 00:02:44,260
!كان ذلك مذهلاً

20
00:02:44,260 --> 00:02:45,260
!أجل

21
00:02:45,260 --> 00:02:45,930
ماذا؟

22
00:02:48,100 --> 00:02:49,730
!فقدت وعيها؟

23
00:02:50,020 --> 00:02:52,350
.أرى أنّ اللّعبة لم تبدأ بعد

24
00:02:52,350 --> 00:02:54,110
.هذا لا يخيفني على الإطلاق

25
00:02:54,110 --> 00:02:56,280
.ركوب الأفعوانيّات سهل كشرب الماء

26
00:02:56,280 --> 00:02:58,820
.لا تقلقي يا أكاني، انتهى القتال

27
00:02:58,820 --> 00:03:00,990
القتال؟ ماذا تقصد؟

28
00:03:00,990 --> 00:03:03,990
.هذا لا يختلف عن ركوب درّاجة ثلاثيّة العجلات

29
00:03:03,990 --> 00:03:06,540
!أنا محترفة في هذا

30
00:03:10,580 --> 00:03:13,790
إنّ هذا يخيفك كثيرًا، صحيح؟

31
00:03:13,790 --> 00:03:15,250
!أ-أنا لستُ خائفة

32
00:03:15,250 --> 00:03:17,300
!لا أفهم لماذا يحبّ الجميع هذا فحسب

33
00:03:17,300 --> 00:03:20,130
لماذا على البشر بناء أشياء
كهذه من الأساس؟

34
00:03:20,130 --> 00:03:22,090
.إنّهم دائمًا مصدر كلّ شرّ

35
00:03:22,090 --> 00:03:24,560
.ليتهم لم يوجدوا من الأساس

36
00:03:24,560 --> 00:03:27,180
ذكّرني هذا بمرّة كانت فيها
.شيسي في السّادسة

37
00:03:27,180 --> 00:03:29,100
—وصلت الغوندولا خاصّتنا إلى القمّة عندما

38
00:03:29,100 --> 00:03:29,810
!توقّف

39
00:03:29,810 --> 00:03:30,850
!لا بأس! سأعترف

40
00:03:30,850 --> 00:03:32,850
!أكره كلّ لعبة في حدائق الملاهي

41
00:03:32,850 --> 00:03:35,310
!الألعاب المخيفة والدّولاب وكلّ شيء

42
00:03:35,310 --> 00:03:38,690
!اقتلني! اقتلني فحسب

43
00:03:38,690 --> 00:03:42,490
لماذا أتيت إن كنت تكرهينها لهذا الحدّ؟

44
00:03:42,490 --> 00:03:43,660
...لأنّي أردتُ

45
00:03:44,110 --> 00:03:45,990
.إسعاد ماهو

46
00:03:46,370 --> 00:03:51,540
لطالما أحبّت الأمور الممتعة مثل
.حدائق الملاهي والمهرجانات

47
00:03:51,540 --> 00:03:56,290
وخاصّة إن ذهبت مع مجموعة
.من الأشخاص وليس وحدها

48
00:03:56,750 --> 00:04:01,510
ربّما السّبب هو كونها طريحة
.الفراش وحيدة دائمًا بسبب مرضها

49
00:04:01,510 --> 00:04:03,680
.لذا فهي تعوّض عن الماضي

50
00:04:03,680 --> 00:04:07,760
.لقد تكبّدت الكثير من المشاقّ

51
00:04:07,930 --> 00:04:12,980
لذلك السّبب أفعل كلّ شيء
.باستطاعتي لإسعادها

52
00:04:12,980 --> 00:04:17,270
أريد التّواجد إلى جانبها بقدر
.المستطاع بينما هي في اليابان

53
00:04:18,400 --> 00:04:20,020
أتريدين الإمساك بيدي؟

54
00:04:20,020 --> 00:04:22,320
ماذا؟ لـ-لماذا تطلب منّي هذا فجأة؟

55
00:04:22,320 --> 00:04:24,780
هل تحاول التّقرّب منّي بينما نحن وحدنا؟

56
00:04:24,780 --> 00:04:29,030
فكّرتُ في أنّ ذلك سيكون
.مخيفًا بشكل أقلّ هكذا

57
00:04:29,030 --> 00:04:30,790
.ا-اهتمّ بشؤونك الخاصّة

58
00:04:37,250 --> 00:04:40,500
.إنّها ليست أختًا كبيرة سيّئة

59
00:04:46,050 --> 00:04:48,550
منزل أشباح

60
00:04:47,260 --> 00:04:48,550
.تماسكي، تماسكي

61
00:04:48,890 --> 00:04:51,470
!مذهل، إنّها تبدو متقنة للغاية

62
00:04:51,470 --> 00:04:53,020
أليس كذلك يا أخي؟

63
00:04:53,020 --> 00:04:55,810
!لم أرَ زومبي بهذه الواقعيّة من قبل

64
00:04:56,270 --> 00:04:58,190
أيمكننا التقاط صورة معك؟

65
00:04:58,800 --> 00:05:00,690
.يبدو حقيقيًّا بالفعل

66
00:05:00,690 --> 00:05:03,310
.حتّى أنّ هنالك لعابًا يسيل منه

67
00:05:07,240 --> 00:05:10,620
لستُ واثقًا أنّ منازل الأشباح هي
.حقًّا من الأشياء الّتي تفضّلينها

68
00:05:10,620 --> 00:05:12,160
ماذا؟ لماذا؟

69
00:05:12,160 --> 00:05:14,330
!أنا أحبّ منازل الأشباح

70
00:05:14,330 --> 00:05:17,340
من الممتع جدًّا رؤية الخوف
!على وجوه الآخرين

71
00:05:17,340 --> 00:05:18,460
!لا تسخري من الآخرين

72
00:05:19,460 --> 00:05:20,380
ما الخطب؟

73
00:05:22,130 --> 00:05:24,300
.لا أشعر أنّي على ما يرام

74
00:05:25,010 --> 00:05:27,970
ربّما حظيت بالكثير من المرح
.وأتعبتُ نفسي

75
00:05:28,260 --> 00:05:29,260
أأنت بخير؟

76
00:05:29,680 --> 00:05:32,100
.لا أعتقد أنّ بإمكاني المشي

77
00:05:32,100 --> 00:05:33,270
أيمكنك حملي؟

78
00:05:33,270 --> 00:05:34,480
.ما باليد حيلة

79
00:05:35,100 --> 00:05:36,190
.اصعدي

80
00:05:36,980 --> 00:05:39,480
هل تتناولين أدوية أو ما شابه؟

81
00:05:40,400 --> 00:05:42,730
—سأنادي أكاني في الحال و

82
00:05:43,650 --> 00:05:45,740
!كنتُ أمزح فحسب

83
00:05:45,740 --> 00:05:48,750
!أردتُك أن تحملني لا غير

84
00:05:48,750 --> 00:05:50,750
ماذا؟ كذبتِ؟

85
00:05:51,160 --> 00:05:53,450
.أنت ساذج للغاية

86
00:05:53,450 --> 00:05:55,750
!واضح لي أنّك لا تزال بكرًا

87
00:05:55,750 --> 00:05:57,330
!لا تتظاهري بالمرض

88
00:05:57,330 --> 00:05:59,120
!لقد قلقت عليك بالفعل

89
00:05:59,120 --> 00:06:02,000
ماذا؟ قلقت عليّ أنا؟

90
00:06:02,000 --> 00:06:03,460
!بالطّبع

91
00:06:03,460 --> 00:06:07,470
ماذا إن لم يصدّقك الآخرين
إن مرضتِ بالفعل؟

92
00:06:07,840 --> 00:06:12,020
قد تكون مسألة حياة أو موت
!إن تأخّروا في الاتّصال بالإسعاف

93
00:06:12,020 --> 00:06:14,520
.لا-لا تغضب كثيرًا

94
00:06:14,520 --> 00:06:15,390
.هذا سيّئ

95
00:06:15,390 --> 00:06:18,390
.سأواصل توبيخك حتّى تفهمين

96
00:06:19,780 --> 00:06:22,820
!انظر، انظر! أنا بخير بالكامل

97
00:06:23,770 --> 00:06:25,940
.كفّي عن هذا الهراء في كلّ الأحوال

98
00:06:25,940 --> 00:06:28,490
إنّه مخيف. أهذا مفهوم؟

99
00:06:28,490 --> 00:06:30,610
.حسنًا. آسفة

100
00:06:34,160 --> 00:06:35,790
...يا له من يوم

101
00:06:41,960 --> 00:06:43,380
—ما الّذي

102
00:06:43,380 --> 00:06:44,420
!صه

103
00:06:46,510 --> 00:06:48,670
!لا نريد أن تمسك بنا أختي

104
00:06:48,670 --> 00:06:50,470
ما الّذي تفعلينه هنا؟

105
00:06:50,470 --> 00:06:53,800
!هذا واضح! تسلّلتُ لأفاجئك

106
00:06:58,930 --> 00:07:01,150
.أريد أن أسألك عن شيء

107
00:07:01,150 --> 00:07:02,270
ماذا؟

108
00:07:02,270 --> 00:07:05,940
هل كنتِ في حفلة جدّي ذات مرّة؟

109
00:07:05,940 --> 00:07:07,190
حفلة؟ متى؟

110
00:07:07,610 --> 00:07:09,780
.عندما تخرّجتُ من المدرسة الابتدائيّة

111
00:07:09,780 --> 00:07:11,490
.كانت في منتجعه

112
00:07:11,950 --> 00:07:14,990
.كانت هنالك فتاة تشبهك كثيرًا

113
00:07:15,370 --> 00:07:17,450
.كان لديها شعر طويل جميل

114
00:07:17,910 --> 00:07:21,670
،تحدّثنا لوقت طويل
.لكنّي لم أعرف اسمها أبدًا

115
00:07:21,960 --> 00:07:24,630
أكانت حبّك الأوّل؟

116
00:07:24,630 --> 00:07:25,670
.ذلك ليس ما سألتُ عنه

117
00:07:25,670 --> 00:07:27,920
...أيعقل أن تكون

118
00:07:28,710 --> 00:07:30,220
أتريدني أن أخبرك؟

119
00:07:31,340 --> 00:07:33,970
!كانت أنا

120
00:07:34,970 --> 00:07:36,350
.أخيرًا، بعد كلّ هذا الوقت

121
00:07:36,850 --> 00:07:40,480
.لم تكن لديّ فكرة بأنّك تذكّرتني

122
00:07:40,480 --> 00:07:42,100
...مـ-مهلاً

123
00:07:42,100 --> 00:07:43,400
.لا بأس

124
00:07:43,400 --> 00:07:46,980
.ستتزوّجني على أيّ حال

125
00:07:47,190 --> 00:07:50,280
لذلك لماذا لا نقوم بهذا الآن؟

126
00:07:50,280 --> 00:07:52,990
ألا يجدر بنا أن نتعرّف على بعضنا أوّلاً؟

127
00:07:52,990 --> 00:07:55,620
!أنا أحبّك يا أخي

128
00:07:55,620 --> 00:07:57,990
.سأحرص على أن تستمتع بوقتك

129
00:07:58,580 --> 00:08:02,120
.اسمعي، واضح لي أنّك تكرهينني

130
00:08:03,120 --> 00:08:04,880
ماذا تقصد؟

131
00:08:04,880 --> 00:08:06,790
—أخبرنك أنّي أحبّ

132
00:08:06,790 --> 00:08:08,880
.بإمكانك التّظاهر بقدر ما تشائين

133
00:08:08,880 --> 00:08:10,870
.لكنّك كالكتاب المفتوح بالنّسبة لي

134
00:08:11,170 --> 00:08:15,010
،لا وزن لكلماتك على الإطلاق
.على عكس كلمات أكاني

135
00:08:15,010 --> 00:08:17,890
.لا بأس. أنا أكرهك بالفعل

136
00:08:18,970 --> 00:08:21,520
لكن من يهتمّ لذلك؟

137
00:08:22,260 --> 00:08:24,190
.ما هي إلاّ قبلة

138
00:08:24,190 --> 00:08:25,980
!وهي قبلتي الأولى

139
00:08:25,980 --> 00:08:28,230
!ذلك ما يريده كلّ فتى

140
00:08:28,230 --> 00:08:32,150
لا فكرة لديّ لماذا تريدين
!تقبيل شخص تكرهينه

141
00:08:32,150 --> 00:08:33,240
!اشرحي لي

142
00:08:33,240 --> 00:08:34,320
!اخرس

143
00:08:34,320 --> 00:08:36,450
!سأخبرك بمجرّد انتهاء كلّ شيء

144
00:08:36,450 --> 00:08:39,490
!صار واضحًا أخيرًا أنّك أخت أكاني

145
00:08:39,490 --> 00:08:40,950
!تتفوّهين بكلام مجنون فحسب

146
00:08:42,080 --> 00:08:44,710
...ما-ما-ما

147
00:08:48,250 --> 00:08:51,670
.أكلتُ أخي كتحلية

148
00:08:51,670 --> 00:08:52,880
!شكرًا على الوجبة

149
00:08:52,880 --> 00:08:55,180
!مـ-مهلاً! اهدئي يا أكاني

150
00:08:55,180 --> 00:08:57,000
!بإمكاني شرح ما حدث

151
00:08:57,000 --> 00:08:59,470
!أنا أكرهكما معًا يا سايتو وماهو

152
00:09:07,030 --> 00:09:09,080
ماذا الآن؟ هل نخيّم في الخارج؟

153
00:09:09,080 --> 00:09:11,280
.أفضّل تفادي ذلك

154
00:09:12,660 --> 00:09:15,120
.لديك منزلك الخاصّ لتعودي إليه

155
00:09:15,120 --> 00:09:16,290
.سأرافقك إلى هناك

156
00:09:17,170 --> 00:09:19,210
أتحاول الصّعود إلى سريري؟

157
00:09:19,210 --> 00:09:20,420
.لا، على الإطلاق

158
00:09:20,420 --> 00:09:21,510
أستذهب إلى منزل عائلتك؟

159
00:09:21,510 --> 00:09:23,780
!لأنّي أودّ أن أزوره. ذلك حماسيّ

160
00:09:24,170 --> 00:09:28,800
،قد تسمح لي شيسي بالبقاء في منزلها
.لكن لا أريد إزعاجها

161
00:09:29,600 --> 00:09:32,060
.ما باليد حيلة. سأبيت في فندق

162
00:09:32,060 --> 00:09:33,770
تقصد فندق حبّ من أجلنا؟

163
00:09:33,770 --> 00:09:35,270
.لا، بل فندق عاديّ

164
00:09:35,270 --> 00:09:36,190
!سأرافقك

165
00:09:36,190 --> 00:09:38,150
.لا أريدك أن تظلّ وحيدًا

166
00:09:38,150 --> 00:09:39,290
.اذهبي للمنزل

167
00:09:39,290 --> 00:09:40,440
!هيّا يا أخي

168
00:09:40,440 --> 00:09:43,240
!دعنا نغوص في الحياة اللّيليّة للمدينة

169
00:09:49,050 --> 00:09:49,780
!مع السّلامة

170
00:09:50,740 --> 00:09:52,870
!يا أخي الغبيّ

171
00:09:52,870 --> 00:09:54,580
!يا لك من بكر بلا فائدة

172
00:09:54,580 --> 00:09:55,960
!الغرفة محجوزة

173
00:09:55,960 --> 00:09:57,210
!افتح الباب

174
00:09:57,210 --> 00:09:59,040
!وإلاّ كسرتُه بنفسي

175
00:09:59,040 --> 00:10:00,460
.افعلي ما يحلو لك

176
00:10:00,460 --> 00:10:01,460
!لن أفعلها بساقي

177
00:10:01,460 --> 00:10:03,090
!سأستعمل مطفئة الحريق

178
00:10:03,090 --> 00:10:06,830
سأصرخ وأقول أنّك أحضرتني
!إلى هنا بدون إذن والداي

179
00:10:06,830 --> 00:10:09,090
!سيتمّ القبض عليك بتهمة اختطاف قاصر

180
00:10:09,090 --> 00:10:10,830
أيمكننا الحديث عن هذا؟

181
00:10:12,060 --> 00:10:13,840
!تأخّرت! سبق ودخلت

182
00:10:13,840 --> 00:10:15,560
!هذه الغرفة لي الآن

183
00:10:15,560 --> 00:10:17,690
!ضعي مطفئة الحريق أرضًا

184
00:10:19,060 --> 00:10:21,440
.حسنًا، غادري

185
00:10:21,440 --> 00:10:24,090
أستطردني أنت أيضًا؟

186
00:10:24,320 --> 00:10:26,360
!كـ-كفّي عن التّظاهر بالبكاء

187
00:10:26,360 --> 00:10:28,030
!لا أتظاهر بالبكاء

188
00:10:28,030 --> 00:10:30,610
!بإمكانك السّماح لي بالبقاء ولو لوهلة

189
00:10:30,610 --> 00:10:33,850
أم ستقول أنّك تكرهني الآن أيضًا؟

190
00:10:33,850 --> 00:10:36,690
.مهلاً، اسمعي جيّدًا

191
00:10:36,690 --> 00:10:40,310
هل جرحتك كلمات أكاني؟

192
00:10:40,310 --> 00:10:41,270
!بالطّبع

193
00:10:41,270 --> 00:10:44,360
!لم تقل لي أختي أنّها تكرهني أبدًا

194
00:10:44,360 --> 00:10:49,450
إنّها لا تغضب أبدًا حتّى
.إن أوقعتها في المقالب

195
00:10:49,450 --> 00:10:53,620
.إنّها تكرهني الآن بالفعل

196
00:10:53,620 --> 00:10:57,410
!لن تُكلّمني أبدًا ثانية

197
00:10:58,830 --> 00:11:00,790
.يا لها من فوضى

198
00:11:02,460 --> 00:11:03,630
.أنا آسفة

199
00:11:04,890 --> 00:11:06,130
ما الّذي تفعلينه؟

200
00:11:09,140 --> 00:11:10,260
ما الّذي يحدث؟

201
00:11:10,510 --> 00:11:13,970
.طُردتَ بسببي

202
00:11:13,970 --> 00:11:16,270
.أحتاج للتّعويض لك عن ذلك

203
00:11:17,140 --> 00:11:19,770
.كلّ ما لديّ لتقديمه هو جسدي

204
00:11:19,770 --> 00:11:21,020
!لا أريد

205
00:11:21,020 --> 00:11:23,270
!وكأنّي قد أفعل ذلك بطفلة تبكي

206
00:11:23,270 --> 00:11:25,030
!ما-ما عدتُ أبكي

207
00:11:25,030 --> 00:11:26,610
.وأنا لستُ طفلة! أنا راشدة

208
00:11:26,610 --> 00:11:27,800
!بإمكاني القيام بذلك

209
00:11:27,800 --> 00:11:28,530
!توقّفي

210
00:11:28,530 --> 00:11:29,530
!اخرس

211
00:11:29,530 --> 00:11:32,200
!ما أقوله هو أنّي سأعتني بك في المقابل

212
00:11:32,200 --> 00:11:33,780
!افعل ما أقوله فحسب

213
00:11:36,580 --> 00:11:39,250
.سأدعك تبيتين في هذه الغرفة

214
00:11:39,250 --> 00:11:40,790
.اخلدي للنّوم فحسب

215
00:11:41,170 --> 00:11:43,170
هل ستغطّيني؟

216
00:11:43,170 --> 00:11:44,800
.إن كان ذلك ما تريدين

217
00:11:44,800 --> 00:11:46,590
وتضع ذراعك حولي؟

218
00:11:49,680 --> 00:11:51,300
.لا بأس

219
00:11:52,680 --> 00:11:56,640
.أنتما أختان صعبتا المراس بالفعل

220
00:12:01,810 --> 00:12:03,150
مهلاً، ما الخطب؟

221
00:12:03,560 --> 00:12:04,860
ألستِ على ما يرام؟

222
00:12:04,860 --> 00:12:09,570
...لم أتناول أدويتي المعتادة اللّيلة، لذا

223
00:12:09,570 --> 00:12:12,200
تقصدين أنّك لا تزالين مريضة؟

224
00:12:12,200 --> 00:12:16,200
.أنا بخير ما دمت أتناول أدويتي

225
00:12:16,200 --> 00:12:18,160
.أنا أتعب بسهولة فحسب

226
00:12:18,160 --> 00:12:21,670
.يمكنني التّعايش مع مرضي
.لا أفقد الوعي أو ما شابه في العادة

227
00:12:21,670 --> 00:12:23,330
لماذا لم تتناوليها؟

228
00:12:23,710 --> 00:12:30,130
لم أستطع. لم يكن لديّ وقت
.لأخذها قبل أن نُطرد

229
00:12:30,130 --> 00:12:35,350
ظننتُ أنّي سأكون بخير لليلة
.واحدة، لكن أظنّني كنتُ مخطئة

230
00:12:35,350 --> 00:12:36,850
—سأتّصل بالإسعاف

231
00:12:36,850 --> 00:12:37,770
!توقّف

232
00:12:40,020 --> 00:12:43,520
.إن اتّصلتَ بالإسعاف، فسيُبلغون عائلتي

233
00:12:43,900 --> 00:12:47,440
.لا أريدهم أن يُضخّموا الأمر ويخبروا أختي

234
00:12:48,530 --> 00:12:50,820
.هذا ليس وقتًا مناسبًا للقلق حيال ذلك

235
00:12:50,820 --> 00:12:53,740
.هذا لا شيء. يحدث هذا طوال الوقت

236
00:12:53,740 --> 00:12:57,990
أخبرني طبيبي أنّ بإمكاني
.أن أعيش حياة طبيعيّة الآن

237
00:12:57,990 --> 00:12:59,120
فعلاً؟

238
00:12:59,120 --> 00:13:00,700
.بالتّأكيد

239
00:13:00,700 --> 00:13:04,830
ما زال لديّ أمور عليّ القيام بها
.في حياتي أيضًا

240
00:13:04,830 --> 00:13:07,250
.ما كنتُ لأكذب حيال ذلك الآن

241
00:13:08,710 --> 00:13:10,760
...لا بأس إذًا

242
00:13:11,390 --> 00:13:16,900
مخرج محطّة هيانداي الشّماليّ     فندق نيشيغامي

243
00:13:14,430 --> 00:13:16,890
.لم يتمّ حملي هكذا من قبل

244
00:13:17,220 --> 00:13:19,430
.يبدو أنّك معتاد على هذا

245
00:13:19,430 --> 00:13:22,020
.هذا يذكّرني بالوقت الّذي حملتُ فيه أختك

246
00:13:23,140 --> 00:13:29,150
هل أنتما متوافقان أكثر ممّا كنتُ أظنّ بالفعل؟

247
00:13:29,400 --> 00:13:31,320
.كنّا عدوّين لدودين

248
00:13:32,030 --> 00:13:34,030
.لكنّي لستُ واثقًا من ذلك الآن

249
00:13:34,660 --> 00:13:37,170
مركز هيانداي الطّبّيّ

250
00:13:36,450 --> 00:13:38,740
.أفسدت الأمر بالفعل هذه المرّة

251
00:13:39,620 --> 00:13:42,620
.سيصل والداك قريبًا

252
00:13:42,620 --> 00:13:45,710
،سيكون الوضع غريبًا بوجودي
.لذلك سأغادر

253
00:13:45,710 --> 00:13:47,040
!مـ-مهلاً

254
00:13:47,040 --> 00:13:47,670
ماذا؟

255
00:13:47,670 --> 00:13:52,090
أيمكنك أن تعدني بأنّك لن تخبر أختي بهذا؟

256
00:13:52,090 --> 00:13:54,130
بشأن دخولك للمستشفى؟

257
00:13:54,130 --> 00:13:55,690
.وانهياري أيضًا

258
00:13:55,690 --> 00:13:58,180
.واثق أنّ أكاني ستريد زيارتك

259
00:13:58,180 --> 00:13:59,430
.لا يمكنني السّماح لها بذلك

260
00:13:59,430 --> 00:14:05,190
سبق وتسبّبتُ لها بما يكفي
.من المشاكل في صغرنا

261
00:14:05,600 --> 00:14:11,440
.كان عليها الاعتناء بي دائمًا
.لذلك السّبب لم يكن لديها أيّ أصدقاء

262
00:14:11,730 --> 00:14:13,940
.شخصيّتها هي الملام الوحيد على ذلك

263
00:14:13,940 --> 00:14:18,450
.أختي لطيفة للغاية
.لا أريدها أن تقلق بعد الآن

264
00:14:18,780 --> 00:14:24,710
عليّ التّوقّف عن السّماح لها
.بالتّضحية بنفسها من أجلي

265
00:14:25,160 --> 00:14:28,210
.حسنًا. لن أخبر أكاني

266
00:14:28,460 --> 00:14:32,630
.شكرًا. آسفة لتسبّبي لك بالمشاكل

267
00:14:33,710 --> 00:14:34,670
ماذا تريد؟

268
00:14:34,670 --> 00:14:36,930
.أحتاج للبقاء في مكان آخر لبعض الوقت

269
00:14:36,930 --> 00:14:39,470
،أكره أن أطلب هذا
ولكن هل يمكنني البقاء معك؟

270
00:14:39,470 --> 00:14:41,310
هل تشاجرت مع أكاني؟

271
00:14:41,310 --> 00:14:43,980
.نعم، لا يبدو الأمر جيّدًا

272
00:14:43,980 --> 00:14:44,890
ستتطلّقان؟

273
00:14:44,890 --> 00:14:47,230
.سنرى في ذلك الأمر

274
00:14:47,690 --> 00:14:51,230
.أنا في السّيّارة الآن، سآتي لأقلّك

275
00:14:51,230 --> 00:14:53,320
—بإمكاننا الذّهاب مباشرة إلى المحكمة

276
00:14:53,320 --> 00:14:54,990
!لم نتّخذ أيّ قرار بعد

277
00:14:57,240 --> 00:15:00,240
أخبرني، أين هي أختي الصّغيرة؟

278
00:15:00,240 --> 00:15:05,750
لم تحضر للمدرسة ويقول
."والداي أنّها "تسافر

279
00:15:05,750 --> 00:15:07,620
لماذا تشكّين في كلام والديك إذًا؟

280
00:15:07,620 --> 00:15:10,500
!كانت لتأتي لرؤيتي قبل أن تغادر

281
00:15:10,790 --> 00:15:14,000
إنّها لا تجيب على هاتفها
.أو تقرأ رسائلي

282
00:15:14,000 --> 00:15:15,510
.ثمّة خطب ما

283
00:15:15,760 --> 00:15:17,630
.واثق أنّها ستعود في النّهاية

284
00:15:17,630 --> 00:15:20,930
كيف لك أن تكون واثقًا؟
!أنت تعرف شيئًا بالفعل

285
00:15:20,930 --> 00:15:23,520
!أنتما مقرّبان من بعض. لا بدّ أنّها أخبرتك

286
00:15:23,760 --> 00:15:25,150
.لسنا مقرّبين من بعض

287
00:15:25,150 --> 00:15:26,140
!كاذب

288
00:15:26,140 --> 00:15:29,600
.يوشك الفصل أن يبدأ. سأدخل الآن

289
00:15:30,060 --> 00:15:31,360
!انتظر

290
00:15:31,860 --> 00:15:35,530
متى تنوي... العودة للمنزل...؟

291
00:15:38,280 --> 00:15:39,780
!هذا ما كنت بحاجته

292
00:15:39,780 --> 00:15:43,700
لا شيء يضاهي تناول الوجبات
!السّريعة دون علم الطّبيب

293
00:15:43,700 --> 00:15:46,790
.لا يمكنني تدليلك كثيرًا وإلاّ واجهتُ المشاكل

294
00:15:47,160 --> 00:15:49,290
هل تدلّلك أكاني أيضًا؟

295
00:15:50,670 --> 00:15:54,090
.لم تحضر لي أختي أشياء كهذه من قبل

296
00:15:55,050 --> 00:15:59,300
كيف يمكنك السّفر كثيرًا هكذا
رغم حالتك الصّحّيّة؟

297
00:15:59,760 --> 00:16:02,260
.لأنّي خائفة

298
00:16:02,260 --> 00:16:03,060
ممّاذا؟

299
00:16:03,260 --> 00:16:07,640
من جهلي متى لن أكون قادرة
.على النّهوض مرّة أخرى

300
00:16:08,020 --> 00:16:10,690
.أو من جهلي متى قد أموت

301
00:16:11,150 --> 00:16:17,110
لذلك السّبب أقوم بكلّ ما أريد
.القيام به بينما ما زلتُ أستطيع ذلك

302
00:16:17,530 --> 00:16:18,650
.هذا منطقيّ

303
00:16:18,990 --> 00:16:25,370
.ناهيك عن ذكر أنّ أختي سترتاح أثناء سفري

304
00:16:26,200 --> 00:16:29,540
.ولن تضطرّ لرؤيتي عندما أمرض

305
00:16:30,370 --> 00:16:34,630
إذًا لم تخبريها أنّك لست على ما يرام بعد؟

306
00:16:35,840 --> 00:16:39,380
.أنا أُقلق أختي كثيرًا

307
00:16:39,800 --> 00:16:43,340
.إنّها تحبّني كثيرًا لدرجة نسيان نفسها

308
00:16:44,800 --> 00:16:47,970
إذًا فقد قمتِ بإغوائي من أجلها؟

309
00:16:49,480 --> 00:16:53,020
في البداية، ظننتُ أنّك تكرهينني
.لأنّي أخذتها منك

310
00:16:53,020 --> 00:16:55,230
.وأنّك كنت تحاولين استعادتها فحسب

311
00:16:55,610 --> 00:17:00,780
لكنّي أفهم الآن. أردتِ لأختك
.أن تكون سعيدة فحسب

312
00:17:00,780 --> 00:17:02,700
كيف اكتشفت ذلك؟

313
00:17:03,200 --> 00:17:06,700
.ما كشفك هو افتقارك للعدوانيّة

314
00:17:07,330 --> 00:17:10,290
.كان واضحًا لي أنّك لا تحبّينني

315
00:17:10,290 --> 00:17:14,170
لكنّها لم تكن كراهية تجاه
.شخص يتدخّل بين أختين

316
00:17:14,920 --> 00:17:18,630
ذلك واضح لي. أنا هدف
.لكراهيّة حقيقيّة كلّ يوم

317
00:17:19,170 --> 00:17:22,380
.أنا أستسلم. نِلت منّي

318
00:17:22,720 --> 00:17:27,890
.سمعتُ بأمر زميل فصل تكرهه أختي

319
00:17:28,310 --> 00:17:32,940
كانت منزعجة دائمًا لأنّه يحتلّ
.المراكز الأولى في الفصل

320
00:17:33,640 --> 00:17:37,560
من قد يودّ الزّواج من منافسه؟

321
00:17:37,560 --> 00:17:40,030
.إنّها قصّة لا تُصدّق بالفعل

322
00:17:40,030 --> 00:17:45,780
،إن كان في ذلك تعاسة أختي
.فكّرتُ في أخذ مكانها

323
00:17:46,370 --> 00:17:50,410
.لتستطيع أخيرًا أن تعيش كما تريد

324
00:17:52,040 --> 00:17:56,830
حتّى إن عنى ذلك عدم قدرتك على
الزّواج من شخص تحبّينه بالفعل؟

325
00:17:56,830 --> 00:17:59,630
.لا أدري، ربّما كنتُ مخطئة

326
00:17:59,630 --> 00:18:03,880
.كانت أختي غاضبة
.على الأرجح أنّها تكرهني الآن

327
00:18:04,300 --> 00:18:07,180
.ربّما انتهى الأمر بالكامل

328
00:18:08,310 --> 00:18:11,560
.ما زالت أكاني تحبّك

329
00:18:11,810 --> 00:18:14,640
.سأكون هنا لأجلك، لذلك يمكنك النّوم

330
00:18:15,060 --> 00:18:18,560
وتحسنّي في أقرب وقت
.لتستطيعي الذّهاب لرؤيتها

331
00:18:25,070 --> 00:18:27,620
.يدك مريحة جدًّا يا أخي

332
00:18:28,030 --> 00:18:31,120
،إنّها مختلفة عن يد أختي
.لكنّها لا تزال مريحة

333
00:18:31,120 --> 00:18:33,410
.أنا معتاد على القيام بهذا لأجل شيسي

334
00:18:33,410 --> 00:18:36,830
لماذا تعتني بي جيّدًا هكذا؟

335
00:18:37,330 --> 00:18:38,540
...ذلك لأنّي

336
00:18:39,540 --> 00:18:42,420
.أريد أن تكون أكاني سعيدة أيضًا

337
00:18:42,840 --> 00:18:46,590
.كانت لتحزن كثيرًا إن كنتِ وحيدة

338
00:18:46,970 --> 00:18:50,430
.لا أريدها أن تفقد ابتسامتها

339
00:18:50,430 --> 00:18:53,600
تملك أختي الابتسامة الأظرف، صحيح؟

340
00:18:53,600 --> 00:18:56,350
.نعم، بإمكاني الاعتراف بذلك على الأقلّ

341
00:18:59,980 --> 00:19:01,070
!أكاني

342
00:19:10,160 --> 00:19:12,990
.أريد أن تكون أكاني سعيدة أيضًا

343
00:19:14,750 --> 00:19:17,370
ما الّذي يحدث لي؟

344
00:19:19,130 --> 00:19:21,390
بعد أسبوع

345
00:19:21,380 --> 00:19:23,250
!أنا آسفة يا أختي

346
00:19:23,250 --> 00:19:27,550
!كنتُ أحاول إغواء أخي منذ عودتي

347
00:19:27,550 --> 00:19:31,520
،لم أردك أن تكوني تعيسة
!لذلك حاولتُ أخذ مكانك

348
00:19:31,760 --> 00:19:35,390
لذلك السّبب كنتما تتعانقان
في غرفة نومي؟

349
00:19:35,680 --> 00:19:40,020
!حاولتُ بجدّ، لكنّ أخي مملّ للغاية

350
00:19:40,020 --> 00:19:41,770
!رفض حتّى أن يلمسني

351
00:19:41,770 --> 00:19:44,160
!لا بدّ ذَكره لا يعمل

352
00:19:44,160 --> 00:19:47,110
.فعلاً؟ كنتُ أتساءل عن ذلك

353
00:19:47,110 --> 00:19:47,610
.مهلاً

354
00:19:47,610 --> 00:19:49,990
.أمزح فحسب! لديك واحد بالفعل

355
00:19:49,990 --> 00:19:53,030
—رأيته عندما استحممنا معـ

356
00:19:50,490 --> 00:19:52,490
!لا تتفوّهي بأمور غبيّة

357
00:19:53,030 --> 00:19:53,660
!حاضرة

358
00:19:54,030 --> 00:19:56,660
!على أيّ حال، لم يقترف أخي أيّ خطأ

359
00:19:56,660 --> 00:19:58,370
!إنّه مذهل في الحقيقة

360
00:19:58,370 --> 00:20:00,750
!حتّى أنّه زارني كثيرًا في المستشفى

361
00:20:00,750 --> 00:20:02,670
!أرجوك أن تسامحيه

362
00:20:02,670 --> 00:20:06,460
،أفترض أنّ بإمكاني التّفكير في ذلك
.إن كان هذا ما تريدينه

363
00:20:06,880 --> 00:20:11,010
.لكن كفّي عن التّضحية بنفسك لأخذ مكاني

364
00:20:11,010 --> 00:20:11,840
لماذا؟

365
00:20:11,840 --> 00:20:15,510
لأنّي أريد لأختي الصّغيرة العزيزة
.أن تكون سعيدة

366
00:20:15,510 --> 00:20:19,570
يجب على هذا الجحيم والمعاناة
.أن ينتهيا معي أنا

367
00:20:19,570 --> 00:20:20,940
!كفّي عن المبالغة

368
00:20:20,940 --> 00:20:25,480
في الحقيقة يا أختي، أعتقد فعلاً
.أنّي وقعت في حبّه

369
00:20:25,480 --> 00:20:28,580
لذلك سآخذ أخي، موافقة؟

370
00:20:29,150 --> 00:20:34,200
.سايتو؟ كيف تجرؤ على إغواء أختي

371
00:20:34,580 --> 00:20:38,200
!انتظر مكانك بينما أحضر سلاحًا

372
00:20:38,620 --> 00:20:41,670
صحيح، أتذكر الفتاة الّتي أخبرتني
أنّك قابلتها في الحفلة؟

373
00:20:41,670 --> 00:20:43,460
!اكتشفتُ من كانت

374
00:20:43,460 --> 00:20:45,590
!ماذا؟ ألم تكن أنت؟

375
00:20:45,590 --> 00:20:49,090
!سأخبرك إن قبّلتني

376
00:20:49,590 --> 00:20:51,590
!عودي لفصلك

377
00:20:55,180 --> 00:20:56,100
.أكاني

378
00:20:56,100 --> 00:20:56,930
ماذا؟

379
00:20:56,930 --> 00:20:59,350
.اسمعي، أنا آسف

380
00:20:59,350 --> 00:21:00,980
لماذا تعتذر منّي؟

381
00:21:00,980 --> 00:21:04,360
لأنّك أغويت صديقتي المفضّلة
وأختي الصّغيرة أيضًا؟

382
00:21:04,360 --> 00:21:07,110
أتريد الاعتذار على كونك زير نساء؟

383
00:21:08,400 --> 00:21:12,450
.ثمّة أمر واحد أريد أن أسألك عنه

384
00:21:12,450 --> 00:21:13,370
ما هو؟

385
00:21:13,780 --> 00:21:18,200
.ما-ما قلتَه في المستشفى عن رغبتك في إسعادي

386
00:21:18,200 --> 00:21:19,120
أكنت صادقًا؟

387
00:21:19,120 --> 00:21:21,410
...مهلاً، ذلك

388
00:21:21,410 --> 00:21:23,630
!لن أسامحك إن لم تخبرني بالحقيقة

389
00:21:26,000 --> 00:21:27,130
.إنّها الحقيقة

390
00:21:29,600 --> 00:21:30,640
.سرّني هذا

391
00:21:31,840 --> 00:21:36,020
لماذا لا تعود للمنزل؟

392
00:21:36,020 --> 00:21:37,650
.إ-إن كنت لا تمانعين

393
00:21:37,650 --> 00:21:39,050
!لستُ موافقة على الأمر

394
00:21:39,050 --> 00:21:41,890
أنا أرتعد من فكرة العيش معًا
!تحت سقف واحد

395
00:21:41,890 --> 00:21:47,320
لكنّي لا أريد أن تكتشف جدّتي
.أنك غائب عن المنزل

396
00:21:47,320 --> 00:21:49,970
.أنا من ستواجه المشاكل إن حدث ذلك

397
00:21:50,890 --> 00:21:52,830
.ذلك صحيح

398
00:21:52,830 --> 00:21:54,970
.سأعود للمنزل إذًا

399
00:21:54,970 --> 00:21:55,860
.جيّد

400
00:21:57,240 --> 00:21:58,410
...عرفتُ هذا

401
00:21:58,790 --> 00:22:03,170
.تعيش أكاني مع سايتو-كُن بالفعل

402
00:23:35,010 --> 00:23:40,010
(الحلقة 10           حبيبة (مؤقّتًا