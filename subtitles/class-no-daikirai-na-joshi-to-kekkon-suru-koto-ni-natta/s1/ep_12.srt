1
00:00:08,650 --> 00:00:10,230
!ما-ما الّذي تفعلينه؟

2
00:00:10,230 --> 00:00:13,070
.أحدّق في وجهك الأبله وأنت نائم

3
00:00:13,070 --> 00:00:14,740
!ليتك تستطيع رؤية نفسك

4
00:00:15,030 --> 00:00:17,160
.لا تشاهدي إن كانت لديك مشكلة في ذلك

5
00:00:17,160 --> 00:00:20,790
الأمر أشبه بمشاهدة الخنازير
.تنام في حدائق الحيوانات

6
00:00:20,790 --> 00:00:22,870
.أنت محظوظة لأنّي لن أقاضيك

7
00:00:22,870 --> 00:00:25,750
!كم أودّ أن أكون القاضية في تلك القضيّة

8
00:00:25,750 --> 00:00:29,000
لا يمكنك أن تكوني القاضية
!والمدّعى عليها في نفس الوقت

9
00:01:59,090 --> 00:02:03,010
الحلقة 12         سوف أتزوّج من فتى أكرهه من فصلي

10
00:02:01,350 --> 00:02:03,390
هل لديك أيّ خطط اليوم؟

11
00:02:03,390 --> 00:02:05,680
كنتُ أخطّط لقراءة بعض الكتب، لماذا؟

12
00:02:05,680 --> 00:02:08,020
!ما رأيك إذًا أن نشاهد فيلمًا؟

13
00:02:08,280 --> 00:02:12,360
،لا يمكننا الخروج بعد
.لكن بإمكاننا قضاء الوقت في المنزل

14
00:02:12,360 --> 00:02:14,890
.يمكنك اختيار أي فيلم تريد

15
00:02:16,650 --> 00:02:18,280
!أعددتُ بعض البسكويت

16
00:02:18,650 --> 00:02:20,790
!بإمكاننا أكله أثناء مشاهدة الفيلم

17
00:02:20,790 --> 00:02:23,280
لماذا هي لطيفة جدًّا اليوم؟

18
00:02:23,280 --> 00:02:25,080
هل سأُقتَل قريبًا؟

19
00:02:30,540 --> 00:02:32,790
هل تغازل هيماري ثانية؟

20
00:02:32,790 --> 00:02:34,880
.لا يمكنني تجاهلها فجأة

21
00:02:34,880 --> 00:02:37,800
لا يهمّ. رأيتكما تراسلان
.بعضكما البارحة أيضًا

22
00:02:37,800 --> 00:02:38,880
!ر-رأيت ذلك؟

23
00:02:38,880 --> 00:02:41,220
!نعم! وكأنّكما تتواعدان بالفعل

24
00:02:41,220 --> 00:02:43,340
!حـ-حتّى أنّكما تتبادلان رسائل إيحائيّة

25
00:02:43,340 --> 00:02:44,710
!لم أرسل أيّ شيء

26
00:02:44,710 --> 00:02:46,640
!لكنّك استقبلت بعضها من هيماري

27
00:02:46,640 --> 00:02:48,260
لم تقم بحفظها، صحيح؟

28
00:02:48,260 --> 00:02:49,180
!وكأنّي سأفعل ذلك

29
00:02:49,390 --> 00:02:50,100
!لا يهمّ

30
00:02:50,480 --> 00:02:53,360
هل... تشعر بالغيرة...؟

31
00:02:56,230 --> 00:02:57,780
.مرحبًا بعودتك

32
00:02:58,570 --> 00:02:59,860
...كان ذلك

33
00:03:00,530 --> 00:03:04,200
التقينا أوّل مرّة في الثّانويّة، صحيح؟

34
00:03:04,200 --> 00:03:06,160
...ماذا؟ نـ-نعم

35
00:03:06,490 --> 00:03:11,290
إذًا لماذا قلتِ "لم أرك منذ مدّة
يا هوجو-كُن" في مراسم الدّخول؟

36
00:03:11,790 --> 00:03:13,750
!ماذا؟! لا أدري ما الّذي تتكلّم عنه

37
00:03:13,750 --> 00:03:15,130
!واضح أنّك لم تسمعني جيّدًا

38
00:03:15,130 --> 00:03:18,420
.لا، أنا واثق ممّا سمعت
.لديّ ذاكرة مثاليّة

39
00:03:18,420 --> 00:03:21,680
!إ-إذًا لا بدّ أنّي ظننتُك شخصًا آخر

40
00:03:21,680 --> 00:03:26,390
ما كنتُ لأقترب منك لو علمتُ
!أنّك بلا قلب هكذا

41
00:03:26,390 --> 00:03:28,220
مـ-مهلاً، ماذا عن الفيلم؟

42
00:03:30,770 --> 00:03:33,690
ما الّذي تتذكّره؟

43
00:03:34,610 --> 00:03:37,780
.لقد نسيت الجزء الأكثر أهمّيّة

44
00:03:43,320 --> 00:03:44,700
.كم هذا مذهل

45
00:03:45,870 --> 00:03:47,160
.سررت برؤيتك

46
00:03:58,670 --> 00:04:01,720
أليست هذه حفلته؟

47
00:04:01,720 --> 00:04:03,800
.مـ-مساء الخير

48
00:04:03,800 --> 00:04:06,720
.مساء الخير. تبدين متعبة

49
00:04:06,720 --> 00:04:11,720
نـ-نعم، لستُ معتادة على حضور احتفاليّات
.كهذه، لذلك لا أشعر على طبيعتي

50
00:04:11,720 --> 00:04:15,100
.خرجتُ إلى هنا لتنشّق بعض الهواء

51
00:04:15,400 --> 00:04:17,610
—لكن بإمكاني المغادرة إن كنتُ أزعج

52
00:04:17,610 --> 00:04:18,360
!مهلاً

53
00:04:18,360 --> 00:04:20,070
ما-ماذا هنالك؟

54
00:04:20,070 --> 00:04:24,610
.أنا آسف. أنا متعب من ذلك الحضور أيضًا

55
00:04:24,610 --> 00:04:28,740
.أنا لا أهتمّ بالمجاملات والكلمات الفارغة

56
00:04:29,240 --> 00:04:31,490
أتريدين التّحدّث قليلاً إن كنت متفرّغة؟

57
00:04:32,750 --> 00:04:33,870
...إلاّ إذا

58
00:04:33,870 --> 00:04:35,250
!أ-أكيد

59
00:04:35,710 --> 00:04:39,630
.هذا جيّد. كنت بحاجة لبعض الرّفقة

60
00:04:41,300 --> 00:04:42,510
!لا بأس

61
00:05:02,610 --> 00:05:05,900
...وفي شتاء امتحانات الدّخول

62
00:05:07,570 --> 00:05:11,830
.حللتُ تلك المسائل بكلّ ما أملك

63
00:05:13,910 --> 00:05:14,870
...ولكنّك

64
00:05:18,330 --> 00:05:21,250
.لـ-لم أرك منذ مدّة يا هوجو-كُن

65
00:05:23,010 --> 00:05:24,090
من أنت؟

66
00:05:26,010 --> 00:05:28,260
.أيّها الغبيّ سايتو

67
00:05:28,260 --> 00:05:31,140
.كنتُ أتطلّع قُدمًا لرؤيتك

68
00:05:31,390 --> 00:05:33,640
.لكنّي الوحيدة الّتي تذكّرت ذلك

69
00:05:34,060 --> 00:05:37,390
.أنا أكرهك كثيرًا

70
00:05:47,030 --> 00:05:48,950
هل أنت بخير يا أكاني؟

71
00:05:49,410 --> 00:05:51,660
.عليك الذّهاب للطّبيب إن كنت متوعّكة

72
00:05:52,030 --> 00:05:56,830
...أنا آسفة، أنا بخير. أنا فقط متعبة

73
00:05:56,830 --> 00:06:00,130
هل قلتُ شيئًا ما أزعجك؟

74
00:06:00,130 --> 00:06:01,880
.سأعتذر إن كان الأمر كذلك

75
00:06:01,880 --> 00:06:03,920
.لا، الأمر ليس كذلك

76
00:06:03,920 --> 00:06:07,760
،أعد أنّي سأعدّ العشاء
لذلك أيمكنك تركي وحدي قليلاً؟

77
00:06:08,380 --> 00:06:10,050
.سأعدّ أنا العشاء اللّيلة

78
00:06:11,180 --> 00:06:13,810
.لا داعي للقلق، لن أستعمل مسحوق البروتين

79
00:06:13,810 --> 00:06:16,560
.ارتاحي قدر ما تشائين
.سأذهب لإحضار البقالة

80
00:06:20,230 --> 00:06:22,400
ألديك بعض الوقت؟

81
00:06:22,400 --> 00:06:24,820
.لنذهب إلى الشّاطئ بالسّيّارة

82
00:06:24,820 --> 00:06:27,490
.لا أريد. أنا تلميذة في الثّانويّة

83
00:06:27,490 --> 00:06:30,660
ترتدين هذا مع أنّك في الثّانويّة؟

84
00:06:30,660 --> 00:06:32,870
أيُعقل أنّك تحبّين هذا؟

85
00:06:32,870 --> 00:06:33,870
!مهلاً

86
00:06:34,540 --> 00:06:35,950
.اتركها

87
00:06:35,950 --> 00:06:37,080
ومن تكون؟

88
00:06:37,080 --> 00:06:38,290
!غادر في الحال

89
00:06:38,290 --> 00:06:39,620
.لا علاقة لك بهذا الأمر

90
00:06:40,250 --> 00:06:43,460
.بل لديّ علاقة. أنا حبيبها

91
00:06:44,630 --> 00:06:47,760
إن لم تتوقّف، فسيكون عليّ اقتلاع عينيك

92
00:06:47,760 --> 00:06:50,760
ورميهما في المحيط. أيناسبك ذلك؟

93
00:06:51,340 --> 00:06:53,140
.الخيار لك، لا أمانع في كلّ الأحوال

94
00:06:54,180 --> 00:06:55,560
ما كان ذلك؟

95
00:06:55,560 --> 00:06:56,810
.يا له من مخبول

96
00:06:56,810 --> 00:06:58,140
.لنذهب

97
00:06:58,430 --> 00:07:00,440
.شكرًا يا سايتو-كُن

98
00:07:00,440 --> 00:07:03,440
.لكنّ ذلك التّهديد كان مبالغًا فيه قليلاً

99
00:07:03,440 --> 00:07:04,770
مبالغ فيه؟

100
00:07:04,770 --> 00:07:08,610
أخبرتهم بطُرق عائلتي المعتادة
.في الإبادة فحسب

101
00:07:08,610 --> 00:07:11,320
!عائلتك خطيرة بالفعل

102
00:07:11,610 --> 00:07:15,120
ما الّذي كنت تفعلينه؟ تنتظرين أحدًا ما؟

103
00:07:15,120 --> 00:07:18,500
.لا، خرجتُ للتّجوّل وحدي فحسب

104
00:07:18,500 --> 00:07:21,120
.سيحلّ الظّلام قريبًا، عليك العودة للمنزل

105
00:07:21,120 --> 00:07:23,710
.ستقابلين رجالاً آخرين مثلهم

106
00:07:25,250 --> 00:07:26,800
.لا يمكنني العودة للمنزل

107
00:07:27,210 --> 00:07:28,800
أفقدت مفاتيحك أو ما شابه؟

108
00:07:28,800 --> 00:07:30,970
...لا، في الحقيقة

109
00:07:30,970 --> 00:07:34,090
.من الصّعب التّواجد في المنزل وهي هناك

110
00:07:34,090 --> 00:07:35,640
عمّن تتكلّمين؟

111
00:07:35,640 --> 00:07:38,060
.زوجة أبي

112
00:07:38,060 --> 00:07:40,100
زوجة والدك؟

113
00:07:40,100 --> 00:07:44,360
يكون لديّ عمل في العادة
.عندما تكون في المنزل

114
00:07:44,360 --> 00:07:47,190
لكن لا بدّ أنّها أخذت إجازة
.في آخر لحظة أو ما شابه

115
00:07:47,190 --> 00:07:50,190
.حسنًا... يمكنني فهم سبب وجودك هنا إذًا

116
00:07:50,570 --> 00:07:53,360
قد يكون قضاء الوقت في مقاهي
.الإنترنيت في كلّ مرّة مكلّفًا

117
00:07:53,360 --> 00:07:56,490
.لذلك فقضاء الوقت هنا يوفّر الوقت

118
00:07:56,490 --> 00:08:00,620
.يمكنني فهمك
.اعتدتُ الذّهاب للحدائق أيضًا

119
00:08:01,080 --> 00:08:03,170
.نعم، أذكر ذلك

120
00:08:04,120 --> 00:08:05,580
ماذا عنك يا سايتو-كُن؟

121
00:08:05,580 --> 00:08:08,460
.خرجتُ لشراء البقالة. انتهى طعامنا

122
00:08:08,460 --> 00:08:12,680
مذهل! إذًا فأنت رجل يقوم
بالأعمال المنزليّة الرّوتينيّة؟

123
00:08:12,680 --> 00:08:16,260
على المرء القيام بما يحتاج القيام به
.سواء كان رجلاً أم امرأة

124
00:08:16,260 --> 00:08:17,510
.صحيح

125
00:08:17,970 --> 00:08:20,350
.شكرًا على مساعدتي

126
00:08:20,350 --> 00:08:24,400
.أنا بخير الآن. بإمكانك العودة إلى أكاني

127
00:08:27,020 --> 00:08:29,530
.سأظلّ معك لوقت أطول

128
00:08:29,530 --> 00:08:30,690
لماذا؟

129
00:08:30,690 --> 00:08:33,780
.بدون سبب. أريد ذلك فحسب

130
00:08:39,790 --> 00:08:44,670
أتذكر تلك الخدمة الّتي تدين لي بها؟

131
00:08:44,670 --> 00:08:45,790
.نـ-نعم

132
00:08:47,920 --> 00:08:50,840
.أريدها أن تكون هذه

133
00:08:58,220 --> 00:09:00,260
!يا أخي

134
00:09:00,260 --> 00:09:02,930
أخي! أتسمعني؟

135
00:09:02,930 --> 00:09:04,020
ماذا هنالك؟

136
00:09:04,020 --> 00:09:07,730
!تمالك نفسك
ألم تسمعني وأنا أكلّمك؟

137
00:09:07,730 --> 00:09:11,110
!ظننتُ أنّك تضايقني يا أخي المنحرف

138
00:09:11,110 --> 00:09:13,280
.كنتُ شاردًا فحسب

139
00:09:13,280 --> 00:09:15,950
.كان أخي-كُن شاردًا طوال الصّباح

140
00:09:15,950 --> 00:09:17,410
هل حدث أمر ما؟

141
00:09:17,410 --> 00:09:18,200
.لا

142
00:09:18,200 --> 00:09:20,910
!ماذا؟ بل حدث أمر ما بالفعل

143
00:09:20,910 --> 00:09:22,910
...حسنًا، أظنّ أنّك

144
00:09:22,910 --> 00:09:24,910
!قبّلت أختي

145
00:09:24,910 --> 00:09:25,830
!ليس هي

146
00:09:25,830 --> 00:09:27,540
ليس هي؟ من إذًا؟

147
00:09:27,540 --> 00:09:28,500
أخبرني من؟

148
00:09:28,500 --> 00:09:30,460
!لا تقل لي أنّها كانت جدّتي

149
00:09:30,460 --> 00:09:31,580
!طبعًا لا

150
00:09:31,580 --> 00:09:32,380
من إذًا؟

151
00:09:32,380 --> 00:09:34,260
من قبّلت يا أخي؟

152
00:09:34,260 --> 00:09:35,420
.لم أقبّل أيّ أحد

153
00:09:35,420 --> 00:09:36,800
!كاذب

154
00:09:36,800 --> 00:09:38,800
!إنّ حواسّ التّحقيق لديّ تلتقط شيئًا ما

155
00:09:38,800 --> 00:09:40,720
!إنّك مُذهب بالتّأكيد

156
00:09:40,720 --> 00:09:41,850
!تقصدين مُذنب

157
00:09:42,100 --> 00:09:45,060
.بإمكان أخي-كُن قول الحقيقة

158
00:09:46,350 --> 00:09:48,440
.هيّا. هيّا

159
00:09:46,770 --> 00:09:48,440
ماذا هنالك يا رفاق؟

160
00:09:48,440 --> 00:09:50,230
!هيمارين! أتيت في وقتك

161
00:09:50,230 --> 00:09:53,360
!بإمكانك مساعدتنا في استجواب أخي

162
00:09:53,360 --> 00:09:55,530
.يبدو ذلك مخيفًا

163
00:09:55,530 --> 00:09:58,860
!لا بأس، سندغدغه لعشرين ساعة فحسب

164
00:09:58,860 --> 00:09:59,700
.سأموت

165
00:09:59,700 --> 00:10:03,240
!لكن ما من طريقة أخرى لجعلك تتكلّم

166
00:10:03,240 --> 00:10:05,370
من قبّل أخي-كُن؟

167
00:10:05,370 --> 00:10:08,660
!هكذا إذًا! هذا ما تسألان عنه

168
00:10:09,330 --> 00:10:11,380
هيمارين، أتعرفين شيئًا ما؟

169
00:10:11,380 --> 00:10:14,620
حسنًا... هلاّ منحتمانا بعض الوقت؟

170
00:10:14,620 --> 00:10:18,130
.بالتّوفيق في ذلك

171
00:10:14,890 --> 00:10:18,130
!ممتاز! اجعليه يتكلّم

172
00:10:21,140 --> 00:10:24,560
.آسفة يا سايتو-كُن. غلبتني الحماسة

173
00:10:24,560 --> 00:10:26,640
.كان ذلك صادمًا بالفعل

174
00:10:26,640 --> 00:10:31,810
،عرفتُ أنّ ذلك ليس صائبًا
.لكن لم أستطع منع نفسي

175
00:10:33,360 --> 00:10:36,940
هل قبّلت أحدًا ما من قبل؟

176
00:10:36,940 --> 00:10:37,860
.لا

177
00:10:37,860 --> 00:10:42,990
.ولا أنا. أنت أوّل شخص أقبّله

178
00:10:42,990 --> 00:10:45,410
.لم أكن أقصد أن أضيّع القبلة الأولى هكذا

179
00:10:46,160 --> 00:10:49,790
أتريد تجربة ذلك ثانية؟

180
00:10:49,790 --> 00:10:51,290
.لا أريد

181
00:10:51,290 --> 00:10:55,630
.سبق وفعلناها مرّة
ما الضّرر من تكرار ذلك؟

182
00:10:55,630 --> 00:10:57,050
...اسمعي

183
00:10:58,340 --> 00:11:01,090
.أنا أحبّك يا سايتو-كُن

184
00:11:04,100 --> 00:11:05,810
أهذا حقيقيّ؟

185
00:11:05,810 --> 00:11:07,640
!أحسنت يا هيماري

186
00:11:07,640 --> 00:11:09,440
أحسنت هيماري في ماذا؟

187
00:11:09,440 --> 00:11:10,520
ألا تعلمين؟

188
00:11:10,520 --> 00:11:12,440
!الأمر حديث مجموعة دردشة الفصل بالكامل

189
00:11:14,940 --> 00:11:16,650
!يبدوان ظريفين

190
00:11:16,650 --> 00:11:17,940
!يا لها من صورة جيّدة

191
00:11:17,940 --> 00:11:19,190
هل كانت الخطوة الأولى لهيماري؟

192
00:11:19,190 --> 00:11:20,450
أكاني؟

193
00:11:25,200 --> 00:11:29,330
أما زلت لا تفهمين بالتّلميح؟
.ستخسرينه بالفعل

194
00:11:44,050 --> 00:11:46,850
!أكاني-تشان

195
00:11:47,180 --> 00:11:51,060
ستتعرّضين للتّنمّر ثانية
.إن واصلتِ قضاء الوقت معي

196
00:11:51,060 --> 00:11:52,440
لماذا؟

197
00:11:52,440 --> 00:11:54,980
.لأنّ الجميع يكرهونني

198
00:11:54,980 --> 00:11:59,110
لا بدّ أنّ ذلك يعني أنّي الوحيدة
!الّتي بإمكانها رؤية جانبك الجيّد

199
00:11:59,110 --> 00:12:00,360
.ذلك يُسعدني

200
00:12:00,820 --> 00:12:03,530
!أنا أحبّك كثيرًا بالفعل يا أكاني-تشان

201
00:12:04,620 --> 00:12:07,660
ماذا عنك؟ أتحبّينني؟

202
00:12:08,240 --> 00:12:09,200
.نعم

203
00:12:09,200 --> 00:12:10,790
!ذلك ما ظننت

204
00:12:10,790 --> 00:12:12,250
!أنا أحبّك

205
00:12:12,580 --> 00:12:15,920
!لنظلّ أفضل صديقتين للأبد يا أكاني

206
00:12:15,920 --> 00:12:20,420
،نعم. ما دمتُ أحبّك
.فلا أهتمّ من يكرهني

207
00:12:20,420 --> 00:12:22,010
!حتّى أنّي لن أتزوّج أبدًا

208
00:12:22,010 --> 00:12:25,550
!ماذا؟ أنا أريد الزّواج يومًا ما

209
00:12:25,550 --> 00:12:30,560
،عندما أدخل الثّانويّة
!سأجد لنفسي حبيبًا رائعًا وذكيًّا

210
00:12:30,560 --> 00:12:31,640
!يا لك من خائنة

211
00:12:31,640 --> 00:12:35,480
لستُ خائنة! أفضل الأصدقاء
!والأحبّة مختلفون

212
00:12:35,480 --> 00:12:37,520
ما الّذي يُفترض أن يعنيه ذلك؟

213
00:12:39,780 --> 00:12:40,690
ما الخطب؟

214
00:12:41,240 --> 00:12:42,530
.لا شيء

215
00:12:44,150 --> 00:12:44,990
.تفضّلي

216
00:12:45,530 --> 00:12:46,530
ما هذا؟

217
00:12:46,910 --> 00:12:49,030
.هديّة من أجلك

218
00:12:49,580 --> 00:12:52,200
.بما أنّك بدوتِ محبطة نوعًا ما

219
00:12:52,200 --> 00:12:55,040
.ظننتُ أنّها قد تُشعرك بتحسّن

220
00:13:03,300 --> 00:13:05,720
ما-ما الخطب؟ ألم تعجبك؟

221
00:13:05,720 --> 00:13:08,390
ظننتُ أنّك ستحبّينها بما
.أنّها تحتوي على فراولة

222
00:13:08,390 --> 00:13:12,730
.لا أكرهها على الإطلاق. أنا أحبّها

223
00:13:12,730 --> 00:13:14,440
...لماذا إذًا

224
00:13:15,060 --> 00:13:16,810
!أنا سعيدة فحسب

225
00:13:17,440 --> 00:13:19,690
.حـ-حسنًا

226
00:13:30,530 --> 00:13:33,000
.لا يمكنني مواصلة القيام بهذا

227
00:13:39,380 --> 00:13:40,590
أكاني؟

228
00:13:40,590 --> 00:13:42,500
هل لديك وقت؟

229
00:13:44,050 --> 00:13:44,800
.أكيد

230
00:13:48,140 --> 00:13:52,470
اعتدنا اللّعب في هذه الحديقة
!طوال الوقت في المدرسة الابتدائيّة

231
00:13:52,470 --> 00:13:54,390
!يمرّ الوقت بسرعة

232
00:13:54,390 --> 00:13:58,730
أتذكرين عندما تسلّلتُ خارج
المنزل ومعي مجلّة؟

233
00:13:58,730 --> 00:14:01,400
.أوقعتها في بركة وتلطّخت بالوحل

234
00:14:01,400 --> 00:14:05,110
!لذلك حاولنا غسل الوحل وأفسدناها بالكامل

235
00:14:05,110 --> 00:14:07,780
!كان ذلك جنونيًّا

236
00:14:07,780 --> 00:14:10,240
—اسمعي يا هيماري. أردتُ أن

237
00:14:10,490 --> 00:14:11,740
.أنا أعلم

238
00:14:12,790 --> 00:14:15,750
.لسنا هنا للّعب مثل السّابق

239
00:14:17,960 --> 00:14:21,000
.أريدك أن تنفصلي عن سايتو

240
00:14:21,290 --> 00:14:23,880
.أنا لا أواعد سايتو-كُن

241
00:14:23,880 --> 00:14:27,890
.قصدتُ أن تتوقّفي عن التّظاهر أنّك حبيبته

242
00:14:27,890 --> 00:14:32,220
إذًا فأنت تتخلّصين منّي الآن
بعد أن حُلّت مشكلتك؟

243
00:14:32,220 --> 00:14:33,140
.كم هذا فظيع

244
00:14:34,430 --> 00:14:39,980
لكنّ الأمر غريب! كان يُفترض بذلك أن يكون
!مجرّد تظاهر، لكنّك ملتصقة به طوال الوقت

245
00:14:39,980 --> 00:14:43,140
إنّكما تخرجان معًا بعد المدرسة
!وحتّى أنّكما... قـ-قبّلتما بعضكما

246
00:14:43,360 --> 00:14:47,530
سمعتُ أنّ هنالك من التقط
صورة لنا. هل رأيتها أيضًا؟

247
00:14:47,530 --> 00:14:50,280
!عـ-على هذا المعدّل، ما عاد هذا تمثيلاً

248
00:14:50,280 --> 00:14:53,530
!إنّه كأنّكما تتواعدان فعلاً
!تمادى هذا كثيرًا

249
00:14:53,530 --> 00:14:56,660
.ومن يهتمّ؟ هذا ليس من شأنك

250
00:14:56,660 --> 00:14:58,410
!بـ-بل إنّه شأني

251
00:14:58,660 --> 00:15:03,040
كيف؟ زواجك أنت وسايتو-كُن
مجرّد زواج شكليّ، صحيح؟

252
00:15:04,040 --> 00:15:05,000
...لكن

253
00:15:05,000 --> 00:15:09,510
لكن ماذا؟ لن أتوقّف حتّى
.تقدّمي لي سببًا حقيقيًّا

254
00:15:09,510 --> 00:15:14,050
.سأظلّ أخرج معه وأقبّله
!حتّى أنّي سأقوم بأكثر من ذلك

255
00:15:15,140 --> 00:15:19,050
...إ-إنّ... إنّ الأمر بسبب

256
00:15:19,100 --> 00:15:21,850
...إنّ سايتو

257
00:15:22,270 --> 00:15:28,070
!أنا أحبّ سايتو

258
00:15:32,530 --> 00:15:34,580
وماذا في ذلك؟

259
00:15:34,580 --> 00:15:37,750
ماذا؟ ما-ما الّذي تقصدينه؟

260
00:15:37,750 --> 00:15:40,960
.تشاجرتِ مع سايتو-كُن باستمرار

261
00:15:40,960 --> 00:15:43,830
.قلتِ أنّك تكرهينه

262
00:15:44,250 --> 00:15:46,590
...نعم، لكن

263
00:15:46,820 --> 00:15:52,800
أنا لم أفعل ذلك. أحببتُ سايتو-كُن
.من السّنة الأولى من الثّانويّة

264
00:15:52,800 --> 00:15:56,600
.لطالما رأيتُه كذلك، حتّى وهو إلى جانبك

265
00:15:57,510 --> 00:15:59,390
من أنت لتتدخّلي الآن؟

266
00:15:59,390 --> 00:16:01,100
!ابتعدي عن طريقي

267
00:16:01,100 --> 00:16:02,850
!أنت من يقف في طريقي

268
00:16:02,850 --> 00:16:05,230
!لطالما أحببته أيضًا

269
00:16:05,230 --> 00:16:08,190
قابلتُ سايتو في حفلة عندما كنّا
!في الثّانية عشرة

270
00:16:08,190 --> 00:16:11,110
!كنتُ أتطلّع قدمًا للذّهاب إلى الثّانويّة معه

271
00:16:11,110 --> 00:16:15,160
.ماذا؟ لم تخبريني بذلك أبدًا

272
00:16:15,160 --> 00:16:18,950
أخذتني جدّتي إلى حفلة لعائلة
.هوجو في إحدى المرّات

273
00:16:18,950 --> 00:16:22,620
.لقد كانت صديقة قديمة لجدّ سايتو

274
00:16:23,920 --> 00:16:27,620
.هذا فعلاً... ليس عادلاً يا أكاني

275
00:16:27,840 --> 00:16:29,340
عادلاً؟

276
00:16:29,340 --> 00:16:32,260
استطعت لقاء سايتو في وقت
!أبكر بسبب جدّتك

277
00:16:32,260 --> 00:16:34,760
حتّى أنّه تسنّت لك فرصة الزّواج
منه لأنّهما أخبراكما بذلك؟

278
00:16:34,760 --> 00:16:35,890
!هذا ليس عادلاً

279
00:16:35,890 --> 00:16:41,310
إنّك مجرّد وحيدة لا يمكنها حتّى الحديث
!مع سايتو-كُن بدون مساعدة من الآخرين

280
00:16:42,390 --> 00:16:45,800
!وأنت مجرّد متملّقة مريبة

281
00:16:45,800 --> 00:16:49,900
مريبة؟ على الأقلّ يمكنني
!الابتسام على عكسك أنت

282
00:16:49,900 --> 00:16:53,110
أفضّل أن أعضّ لساني وأموت
!بدل تزييف ابتسامة لأجل الآخرين

283
00:16:53,110 --> 00:16:57,450
أتعتقدين أنّ سايتو لا يمكنه
ملاحظة ابتساماتك الجوفاء؟

284
00:16:57,450 --> 00:17:01,330
!أ-أنا أشكّ في ذلك! كما أنّها ليست جوفاء

285
00:17:01,330 --> 00:17:03,200
!ابتساماتي المزيّفة مثاليّة

286
00:17:03,200 --> 00:17:05,920
!في كلّ الأحوال، أنت من لا تتصرّفين بعدل

287
00:17:05,920 --> 00:17:08,000
.كمساعدتك له بخطّة الحبيبة المزيّفة

288
00:17:08,000 --> 00:17:11,920
!كان مجرّد عذر لإغواء سايتو

289
00:17:11,920 --> 00:17:13,220
.بالطّبع هو كذلك

290
00:17:13,220 --> 00:17:14,970
وأنت فخورة بهذا؟

291
00:17:14,970 --> 00:17:16,590
.إنّه خطؤك أنت لعدم ملاحظتك للأمر

292
00:17:16,930 --> 00:17:20,720
.لا عجب أنّ صديقتك سرقت منك زوجك

293
00:17:22,730 --> 00:17:24,270
!غبيّة، غبيّة، غبيّة

294
00:17:24,270 --> 00:17:27,190
لماذا كان عليك اختياره من بين الجميع؟

295
00:17:27,190 --> 00:17:30,480
!بإمكانك الحصول على أيّ رجل في العالم

296
00:17:30,480 --> 00:17:32,320
!بإمكاني قول نفس الشّيء عنك

297
00:17:32,320 --> 00:17:34,950
لا تأخذي منّي الشّيء الوحيد
!الّذي أريده أيّتها الغبيّة

298
00:17:34,950 --> 00:17:36,030
من تصفين بالغبيّة؟

299
00:17:36,030 --> 00:17:37,450
!أنت بالطّبع

300
00:17:37,450 --> 00:17:39,780
!علاماتي جيّدة، على عكسك أنت

301
00:17:39,780 --> 00:17:42,120
!أنت غبيّة لا تجيد إلاّ الدّراسة

302
00:17:46,750 --> 00:17:50,250
...في الحقيقة، أدركتُ قبل مدّة

303
00:17:50,250 --> 00:17:54,880
.أنّك تحبّين سايتو-كُن

304
00:17:55,220 --> 00:17:57,340
ماذا؟ مـ-متى؟

305
00:17:57,800 --> 00:17:59,970
.منذ السّنة الأولى من الثّانويّة

306
00:18:00,640 --> 00:18:05,230
لم تكوني تعاملين الفتيان مثلما
.تعاملين سايتو-كُن

307
00:18:05,230 --> 00:18:09,270
وكنتِ تبدين محبطة دائمًا
.كلّما تغيّب عن الدّراسة

308
00:18:09,270 --> 00:18:12,150
أ-أكان الأمر بذلك الوضوح؟

309
00:18:12,150 --> 00:18:15,650
وتمامًا كما حصلت على استحسان
،الجميع في الفصل

310
00:18:16,490 --> 00:18:20,990
فكّرت في جعل سايتو-كُن يقع
.في حبّي دون أن يلاحظ أحد

311
00:18:21,950 --> 00:18:26,790
كان واضحًا لي أيّ نوع
.من الفراغات في قلبه

312
00:18:26,790 --> 00:18:30,670
،أعرف كيف أتسلّل إليه
.وقول كلّ شيء يودّ سماعه

313
00:18:30,670 --> 00:18:33,340
لماذا لم تقومي بذلك إذًا؟

314
00:18:33,340 --> 00:18:36,590
.لأنّي ظننتُ أنّ ذلك غير صادق

315
00:18:36,970 --> 00:18:38,880
تُجاه سايتو؟

316
00:18:38,880 --> 00:18:42,680
.نعم، تُجاه سايتو-كُن، ولكن تُجاهك أيضًا

317
00:18:43,180 --> 00:18:50,810
،إن حصلتُ عليه دون أن تلاحظي
.فستندمين على ذلك طوال حياتك

318
00:18:51,480 --> 00:18:57,030
.ما كنت لتسامحيني أبدًا
.ما كنت لتحضري زفافنا

319
00:18:57,030 --> 00:19:00,070
.سيكون ذلك نهاية صداقتنا

320
00:19:01,070 --> 00:19:04,410
...لم أستطع... تحمّل الأمر

321
00:19:04,910 --> 00:19:07,790
كان كلّ ذلك من أجلي؟

322
00:19:07,790 --> 00:19:11,210
،تصرّفتِ مثل حبيبته وقبّلتِه

323
00:19:11,210 --> 00:19:14,840
لمساعدتي على إدراك أنّي أحبّه؟

324
00:19:15,170 --> 00:19:18,760
.لا، لستُ طيّبة لذلك الحدّ

325
00:19:18,760 --> 00:19:24,010
،توقّعتُ أنّك ستلاحظين أخيرًا
.لكنّني كنت مستعدّة تمامًا لذلك

326
00:19:24,760 --> 00:19:27,890
،انتظرتُ لوقت طويل
،وأنّه إن سنحت أيّ فرصة

327
00:19:27,890 --> 00:19:30,480
.فسأحصل على سايتو-كُن

328
00:19:32,400 --> 00:19:35,770
.آسفة لأنّي جعلتك تنتظرين لسنتين كاملتين

329
00:19:36,190 --> 00:19:41,370
ما كنتِ لتضطرّي لذلك
.لو لم نكن أفضل صديقتين

330
00:19:42,990 --> 00:19:48,250
من المؤسف أن نكون أفضل صديقتين
.لدرجة أن نقع في حبّ نفسه الشّخص

331
00:19:48,250 --> 00:19:49,370
.نعم

332
00:19:49,620 --> 00:19:55,210
.لا أريد التّخلّي عنك أو عن سايتو-كُن

333
00:19:55,210 --> 00:19:56,800
.ولا أنا

334
00:19:56,800 --> 00:19:59,130
.لا أريد فقدان أفضل صديقة لي

335
00:19:59,130 --> 00:20:02,260
.لكنّي لا أستطيع تسليمك سايتو

336
00:20:03,430 --> 00:20:04,720
ماذا الآن؟

337
00:20:04,720 --> 00:20:06,350
.من الصّعب هزيمتي

338
00:20:06,850 --> 00:20:08,180
.سأبذل جهدي

339
00:20:08,560 --> 00:20:10,520
.وسألحق بك

340
00:20:10,520 --> 00:20:13,270
.وسيقع سايتو في حبّي

341
00:20:14,190 --> 00:20:16,980
.إذًا، لن أتهاون بعد الآن

342
00:20:17,400 --> 00:20:21,150
.إيّاك أن تتساهلي معي
!وإلاّ فلن أسامحك

343
00:20:28,290 --> 00:20:29,780
ما-ما الخطب؟

344
00:20:30,200 --> 00:20:32,250
!لا تقتحم المكان هكذا

345
00:20:32,250 --> 00:20:34,160
!هذه غرفتي

346
00:20:34,160 --> 00:20:36,000
!هذا مكان متشارك

347
00:20:36,000 --> 00:20:37,670
لماذا أنت متفاجئة هكذا؟

348
00:20:37,670 --> 00:20:40,300
مـ-من قال أنّي متفاجئة؟

349
00:20:41,010 --> 00:20:43,260
.ذلك ما بدا لي بالضّبط

350
00:20:43,260 --> 00:20:45,090
.لا يهمّ، صباح الخير

351
00:20:45,090 --> 00:20:46,180
—صـ-صباح... الخـ

352
00:20:46,180 --> 00:20:48,680
!وكأنّي سأقول ذلك لك

353
00:20:49,940 --> 00:20:51,180
ما-ما الّذي تفعله؟

354
00:20:51,180 --> 00:20:53,940
.أتحقّق من درجة حرارتك فحسب

355
00:20:53,940 --> 00:20:55,310
.تبدو مرتفعة بالفعل

356
00:20:55,310 --> 00:20:58,070
!ذلك لأنّك تلمسني

357
00:21:00,820 --> 00:21:03,110
.إنّها قتاليّة أكثر من العادة

358
00:21:03,110 --> 00:21:06,200
هل فعلتُ شيئًا ما لإزعاجها ثانية؟

359
00:21:06,200 --> 00:21:09,580
!إنّها غاضبة لأنّك قبّلت هيمارين

360
00:21:09,580 --> 00:21:11,200
!أنا غاضبة منك أيضًا

361
00:21:11,200 --> 00:21:12,960
!قبّلني

362
00:21:12,960 --> 00:21:16,330
!قبلة، قبلة، قبلة

363
00:21:13,330 --> 00:21:16,330
.قبلة أخي-كُن الأولى لم تكن مع هيماري

364
00:21:16,330 --> 00:21:19,170
ماذا؟ ماذا تقصدين؟

365
00:21:19,170 --> 00:21:20,210
.لا شيء

366
00:21:20,210 --> 00:21:22,380
.عفوًا، أريد تفسيرًا لذلك بالفعل

367
00:21:20,210 --> 00:21:23,380
قبلة، قبلة! أتستمع لي يا أخي؟

368
00:21:22,380 --> 00:21:24,340
هلاّ شرحتِ أكثر؟

369
00:21:24,340 --> 00:21:26,890
!نعم، أريد أن أعرف أيضًا

370
00:21:26,890 --> 00:21:27,850
!وأنا أيضًا

371
00:21:28,180 --> 00:21:30,000
.شي-تشان

372
00:21:30,000 --> 00:21:31,910
.شيسي-تشان

373
00:21:31,910 --> 00:21:33,980
.تكلّمي يا شيسي

374
00:21:34,220 --> 00:21:35,520
.حسنًا

375
00:21:36,230 --> 00:21:40,350
.سأشرح الأمر من البداية إذًا
.أصل الجنس البشريّ

376
00:21:40,350 --> 00:21:42,240
!سيأخذ ذلك قرونًا

377
00:21:44,740 --> 00:21:48,100
.لا أعتقد أنّ أكاني غاضبة

378
00:21:48,100 --> 00:21:50,580
ما الّذي يجري إن لم تكن غاضبة؟

379
00:21:50,580 --> 00:21:52,680
!لا تهتمّ لذلك

380
00:21:52,680 --> 00:21:54,560
أتريد الخروج في موعد اليوم
بعد المدرسة؟

381
00:21:54,560 --> 00:21:57,420
أعتقد أنّ علينا القيام بأكثر
.من مجرّد التّقبيل

382
00:21:57,420 --> 00:21:59,830
!مثل أيّ حبيبين حقيقيّين

383
00:21:59,830 --> 00:22:02,130
!هذا ليس عدلاً يا هيمارين

384
00:22:02,400 --> 00:22:05,840
!هيماري

385
00:22:05,840 --> 00:22:08,330
مرحبًا يا أكاني. ماذا هنالك؟

386
00:22:08,330 --> 00:22:10,650
!علينا الحديث. تعالي

387
00:22:10,650 --> 00:22:12,730
!ربّما لاحقًا

388
00:22:12,730 --> 00:22:15,600
.أنا مشغولة بإغواء سايتو-كُن الآن

389
00:22:15,600 --> 00:22:19,730
كفّي عن إغواء النّاس في وضح
!النّهار في المدرسة! هذا مقرف

390
00:22:20,110 --> 00:22:22,210
.سأقوم بإغوائه ليلاً إذًا

391
00:22:23,230 --> 00:22:28,080
!ذلك مقرف أكثر
!ابتعدا عن بعض في الحال

392
00:22:26,150 --> 00:22:29,740
!لا، سايتو-كُن

393
00:22:30,040 --> 00:22:32,540
هل حدث شيء ما بينكما؟

394
00:22:33,060 --> 00:22:34,250
لماذا؟

395
00:22:34,250 --> 00:22:36,890
...لا، أشعر فقط أنّكما

396
00:22:36,890 --> 00:22:40,490
.إنّكما لا تتهاونان مع بعضكما كما السّابق

397
00:22:40,490 --> 00:22:41,910
.لم يحدث أيّ شيء

398
00:22:41,910 --> 00:22:44,250
.لا علاقة لك بالأمر

399
00:22:44,550 --> 00:22:46,260
هل أنا السّبب؟

400
00:22:46,260 --> 00:22:48,140
.سأعتذر إن كنتُ السّبب

401
00:22:48,140 --> 00:22:50,020
!لا تقترب منّي أكثر

402
00:22:50,020 --> 00:22:53,340
!إن فعلت، سأعضّ لسانك وأقتلك

403
00:22:53,340 --> 00:22:55,760
تعضّين لساني؟ ما الّذي فعلتُه؟

404
00:22:55,760 --> 00:22:58,990
.أ-أشياء كثيرة لا يمكن عدّها

405
00:22:58,990 --> 00:23:02,450
!كلّ شيء... كلّ شيء خطؤك أنت

406
00:23:02,450 --> 00:23:05,780
.أخبريني إذًا
.وإلاّ فلن أستطيع إصلاح الأمر

407
00:23:05,780 --> 00:23:08,390
أ-أخبرك؟

408
00:23:09,560 --> 00:23:11,510
ما-ماذا؟

409
00:23:11,510 --> 00:23:13,020
—ظـ-ظننتُ

410
00:23:13,020 --> 00:23:14,910
!لن أخبرك أبدًا

411
00:23:14,910 --> 00:23:18,170
!لأنّني أكرهك

412
00:23:18,170 --> 00:23:21,410
...لكنّي أعرف ذلك سلفًا

413
00:23:22,890 --> 00:23:24,290
.يا إلهي

414
00:23:27,260 --> 00:23:33,270
!هذا صحيح... أنا أكرهك بشدّة