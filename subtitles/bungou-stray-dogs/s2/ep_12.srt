1
00:00:01,060 --> 00:00:06,270
كلاب الأدب الضّالة

2
00:00:09,690 --> 00:00:10,360
!هلمّا

3
00:00:10,810 --> 00:00:13,360
!الوحش تحت ضوء القمر

4
00:00:14,320 --> 00:00:17,110
!راشومون، الدّرع الشّيطانيّ

5
00:00:38,140 --> 00:00:39,510
.بربّكما

6
00:00:39,510 --> 00:00:43,140
.لا أريد إنفاق كلّ ذلك المال هباءً

7
00:00:45,350 --> 00:00:46,940
.تبقّت ثلاث دقائق

8
00:00:49,270 --> 00:00:56,070
.كيوكا-تشان، بوسعي أن أجعل أسلوب حياتك هو القتل

9
00:01:00,080 --> 00:01:02,660
.لكنّ ألمك ليس لكِ وحدك

10
00:01:03,330 --> 00:01:07,920
ماذا يفعل المرء عندما يريد أن يُصبح
شيئًا آخرًا عدا ما هو ضليعٌ به؟

11
00:01:09,080 --> 00:01:13,050
الجميع يقاتلون، ويبحثون
.عن الأسلوب الصّائب لعيش حياتهم

12
00:01:14,970 --> 00:01:16,500
فما الّذي يبتغونه من قتالهم؟

13
00:01:19,390 --> 00:01:20,800
كيف يجب أن يعيشوا؟

14
00:01:22,350 --> 00:01:24,560
.لا أحد على يقين

15
00:01:26,560 --> 00:01:29,520
.كلّ ما نملك هو الحقّ في التّردّد

16
00:01:32,150 --> 00:01:35,570
.كالكلاب الضّالة الّتي أدركت الحضيض

17
00:01:43,830 --> 00:01:44,500
!لا

18
00:02:00,350 --> 00:02:04,600
!الفتى النّمر

19
00:02:27,580 --> 00:02:30,580
...إن كان محقًّا

20
00:02:31,000 --> 00:02:33,420
.فلا جدوى

21
00:02:34,290 --> 00:02:41,050
.كلمات ماضيك لا علاقة لها أساسًا بما أنت عليه الآن

22
00:02:41,680 --> 00:02:46,850
...إن كان لي أن أتخلّص من عبئي الآن، سوف

23
00:02:50,730 --> 00:02:53,020
!فلتمت أيّها الفتى النّمر

24
00:04:02,840 --> 00:04:04,130
.خارت قواي

25
00:04:05,300 --> 00:04:09,220
...إن نهض

26
00:04:15,560 --> 00:04:18,940
.لقد ربحت يا زيلدا

27
00:04:21,440 --> 00:04:23,200
.انتظريني

28
00:04:23,990 --> 00:04:29,870
.سأجلب لك السّعادة مرّة أخرى

29
00:04:42,760 --> 00:04:44,300
.صحيح، محطّة التّحكّم

30
00:04:47,550 --> 00:04:49,010
.أيّها الغبيّ

31
00:04:49,300 --> 00:04:53,350
.لقد أخذتها منه أثناء الهجوم الأخير

32
00:04:53,350 --> 00:04:54,100
!اللّعنة

33
00:04:54,100 --> 00:04:56,020
!يجب أن نوقفها

34
00:05:04,190 --> 00:05:09,530
كم أودّ أن أمزّقك إربًا الآن، لكنّي
.قد استنزفتُ كامل قوّتي مع الأسف

35
00:05:10,030 --> 00:05:11,870
.يجب أن تدبّر حالك بهذا

36
00:05:12,370 --> 00:05:15,250
.ستدفع ثمن هذا عندما نلتقي مجدّدًا

37
00:05:29,970 --> 00:05:31,260
هل ننزل؟

38
00:05:31,260 --> 00:05:32,260
.مستحيل

39
00:05:32,260 --> 00:05:33,890
.لم أفعل أيّ شيء

40
00:05:33,890 --> 00:05:34,850
.ناولني إيّاها

41
00:05:38,560 --> 00:05:40,520
.إنّها لا تستجيب

42
00:05:41,070 --> 00:05:42,650
.شيءٌ ما يجري

43
00:05:47,820 --> 00:05:48,660
.هذا سيّئ

44
00:05:48,660 --> 00:05:50,200
.ولا استجابة هنا أيضًا

45
00:05:50,490 --> 00:05:52,160
!ستسقط

46
00:05:52,950 --> 00:05:54,080
...ذاك الصّوت

47
00:05:54,080 --> 00:05:55,790
.الوقت يداهمنا

48
00:05:55,790 --> 00:05:58,370
.علينا أن نفعل شيئًا وإلاّ هلكَ الجميع

49
00:05:58,370 --> 00:05:59,670
.لا فائدة

50
00:06:00,960 --> 00:06:03,800
.لقد تسلّل أحدهم من الخارج

51
00:06:03,800 --> 00:06:05,750
.وقد تولّى التّحكّم

52
00:06:06,020 --> 00:06:07,510
.لا

53
00:06:08,260 --> 00:06:10,140
.ما زالت هناك طريقة

54
00:06:10,140 --> 00:06:11,300
...ذاك الصّوت

55
00:06:12,010 --> 00:06:13,260
!كيوكا-تشان؟

56
00:06:13,260 --> 00:06:14,970
.سمعتُ بشأن الوضع

57
00:06:15,470 --> 00:06:17,640
،حتّى لو لم يكن بالإمكان إيقاف الموبي ديك من السّقوط

58
00:06:17,640 --> 00:06:22,440
فيمكن تدميرها بقوّة كافية
.من الأعلى قبل أن تصطدم بالمدينة

59
00:06:23,070 --> 00:06:24,690
.سأستخدم هذه الطّائرة

60
00:06:25,190 --> 00:06:26,610
.فهمت

61
00:06:26,610 --> 00:06:28,150
.هذا رائع يا كيوكا-تشان

62
00:06:28,490 --> 00:06:30,110
.بوسعنا أن ننقذ الجميع

63
00:06:30,740 --> 00:06:32,910
.جهّزي المظلّة رجاءً

64
00:06:34,240 --> 00:06:35,790
.يجب أن تهربي أيضًا

65
00:06:36,580 --> 00:06:37,410
.لا أستطيع

66
00:06:39,540 --> 00:06:41,170
.أنا أسيرة هنا

67
00:06:41,750 --> 00:06:44,340
.قدميّ مكبّلتان

68
00:06:44,340 --> 00:06:47,550
.لا أستطيع الوصول إلى نظام الإخلاء

69
00:06:48,920 --> 00:06:50,090
...لا

70
00:06:50,970 --> 00:06:51,840
...إذًا

71
00:06:52,550 --> 00:06:54,300
.انسَ أمري

72
00:06:54,300 --> 00:06:55,260
!كلاّ

73
00:06:55,600 --> 00:06:56,810
!لن أسمح بذلك

74
00:06:56,810 --> 00:06:58,310
!غيّري المسار

75
00:06:58,810 --> 00:07:02,770
.لم أحظَ بأيّ بريقٍ من النّور حتّى الآن

76
00:07:04,320 --> 00:07:09,820
.لكنّي فهمتُ اليوم، أنّني أملك خيارات

77
00:07:10,950 --> 00:07:17,200
.سأجتاز اختبار القبول إن ضحّيتُ بنفسي لأنقذ الجميع

78
00:07:17,700 --> 00:07:20,500
.وبوسعي حينها أن أصبح عضوةً حقيقيّة بالوكالة

79
00:07:20,830 --> 00:07:22,830
.ما كان ليساورني أيّ ندم

80
00:07:22,830 --> 00:07:24,250
!توقّفي

81
00:07:26,960 --> 00:07:27,710
!فلنذهب

82
00:07:27,710 --> 00:07:28,510
!أكوتاغاوا

83
00:07:28,510 --> 00:07:30,380
!كيوكا-تشان، أنصتي إليّ

84
00:07:34,470 --> 00:07:35,640
.شكرًا لك

85
00:07:36,730 --> 00:07:38,270
.وآسفة

86
00:08:02,300 --> 00:08:07,090
!كيوكا-تشان

87
00:08:18,180 --> 00:08:19,390
لماذا؟

88
00:08:20,390 --> 00:08:22,180
لِمَ هي؟

89
00:08:25,150 --> 00:08:26,230
...كيوكا

90
00:08:27,150 --> 00:08:28,520
.يا لها من حمقاء

91
00:08:29,980 --> 00:08:35,570
،لو أنّها لم تحتضن أمل العيش في النّور
.لما كانت لتموت هباءً

92
00:08:38,830 --> 00:08:41,450
.هكذا وجب الأمر أن يكون يا أتسوشي-كُن

93
00:08:43,580 --> 00:08:44,920
.دازاي-سان

94
00:08:44,920 --> 00:08:45,920
زعيم؟

95
00:08:47,540 --> 00:08:51,090
.تغلّبت كيوكا-تشان على نفسها وأنقذت المدينة

96
00:08:51,840 --> 00:08:54,470
.بالنُّبل المتوقّع من الوكالة

97
00:08:55,050 --> 00:08:58,680
.لكن لا سبب أحال إلى موتها

98
00:08:59,300 --> 00:09:02,060
.صحيح، لقد كانت خاتمةً قاسية

99
00:09:02,850 --> 00:09:06,980
.لكن كان هناك سببٌ من فعل ذلك

100
00:09:07,770 --> 00:09:11,650
،"قدرتي، "كلّ الرّجال سواسية

101
00:09:12,030 --> 00:09:16,780
...لديها تأثير على أتباعي فقط
.وهم أعضاء الوكالة

102
00:09:17,240 --> 00:09:22,660
.تخوّل هذه القدرة التّحكّم بمردود قدرات الآخرين

103
00:09:23,410 --> 00:09:29,380
السّبب الّذي مكّنك من التّحكّم بقدرات
.نمرك الآن هو لأنّك التّحقتَ بالوكالة

104
00:09:30,170 --> 00:09:33,550
.وقد اجتازت كيوكا-تشان اختبار القبول

105
00:09:34,510 --> 00:09:36,090
.لحظة الاصطدام

106
00:09:36,880 --> 00:09:39,510
أتعي ما يعنيه ذلك؟

107
00:09:45,180 --> 00:09:49,690
.استخدمتُ كاتانا شيطان الثّلج لأقطع الأغلال وأهرب

108
00:09:51,860 --> 00:09:53,070
.لقد عدت

109
00:09:58,780 --> 00:09:59,950
.مرحبًا بعودتك

110
00:10:01,740 --> 00:10:02,790
.أنت تؤذيني

111
00:10:03,370 --> 00:10:04,870
.آسف

112
00:10:04,870 --> 00:10:07,920
.آسفٌ لعدم إخباركما

113
00:10:09,040 --> 00:10:12,710
.وإلاّ ما كنتُ لأحضّر اختبار قبولٍ لائق

114
00:10:15,130 --> 00:10:16,550
هل ننتهي في الجبال؟

115
00:10:16,550 --> 00:10:17,510
.بل البحر

116
00:10:18,550 --> 00:10:19,720
.مفهوم

117
00:10:21,050 --> 00:10:23,720
أكان كلّ هذا مخطّطًا من البداية؟

118
00:10:24,220 --> 00:10:27,980
.هُزمَ العدوّ واجتازت كيوكا-تشان الاختبار

119
00:10:28,600 --> 00:10:30,100
.أنا مسرورٌ لأنّ كلّ شيء قد نجح

120
00:10:30,100 --> 00:10:31,190
!دازاي-سان

121
00:10:31,610 --> 00:10:33,690
.لم يعد هناك أحد يعترض طريقي

122
00:10:33,690 --> 00:10:35,990
.أرجوك اشهد قوّتي الآن

123
00:10:36,440 --> 00:10:37,780
.لا أعلم

124
00:10:38,240 --> 00:10:40,200
لقد استنزفت كامل قوّتك، أليس كذلك؟

125
00:10:40,200 --> 00:10:42,570
.لقد هزمتَ زعيم النّقابة للتّوّ في النّهاية

126
00:10:42,570 --> 00:10:44,450
.لا علاقة لذلك

127
00:10:44,450 --> 00:10:45,790
...أنا

128
00:10:47,830 --> 00:10:49,290
.أصبحتَ قويًّا

129
00:10:57,550 --> 00:10:58,670
.ويحي

130
00:11:02,420 --> 00:11:04,200
منظرٌ جميل، أليس كذلك؟

131
00:11:09,600 --> 00:11:11,310
.لقد حميتها

132
00:11:14,740 --> 00:11:16,020
.إنّها مدينتك

133
00:11:22,610 --> 00:11:25,910
مدينتي؟

134
00:11:30,330 --> 00:11:33,500
حرب المواهب الكبيرة الّتي تسبّبت
.في الكثير من الأضرار الجانبيّة ليوكوهاما

135
00:11:33,500 --> 00:11:35,360
.فد انتهت أخيرًا

136
00:11:35,630 --> 00:11:39,340
.لكنّ عمل الحكومة قد بدأ للتّوّ

137
00:11:39,630 --> 00:11:42,090
...تنظيف كلّ هذه الفوضى

138
00:11:42,090 --> 00:11:44,680
.لن أنام في بيتي لبضعة أيّام

139
00:11:45,390 --> 00:11:53,480
.باعتبار ذلك، سنقدّر مساعدتك حقًّا يا سيّد هارمان

140
00:11:54,480 --> 00:11:57,190
.أريد مشاهدة البحر فقط الآن

141
00:11:58,150 --> 00:12:04,870
بمعلوماتك، لن نضطرّ للقبض على أعضاء
.النّقابة الّذين لم يشاركوا بهذا الفعل

142
00:12:05,320 --> 00:12:10,660
أتظنّ أنّ عضوًا عاديًّا مثلي قد
تكون لديه مثل هذه المعلومات؟

143
00:12:11,160 --> 00:12:12,000
.أجل

144
00:12:12,960 --> 00:12:17,130
.ففي النّهاية، لقد كنتَ زعيم النّقابة قبل جيلين

145
00:12:18,590 --> 00:12:22,870
.من المزعج أنّكم أيّها اليافعون دائمًا ما تذكرون التّاريخ

146
00:12:23,180 --> 00:12:26,300
.أرجو منك أن تساعدنا على التّغلّب على حرماننا من النّوم

147
00:12:27,100 --> 00:12:28,840
لستُ بحاجة لاستخدام هذه، صحيح؟

148
00:12:49,870 --> 00:12:53,990
.لم أكن أتصوّر أبدًا الموبي ديك تحت الماء

149
00:12:53,990 --> 00:12:55,880
.لقد كانت مكانًا جميلاً

150
00:12:55,880 --> 00:12:57,440
الموبي ديك؟

151
00:12:57,440 --> 00:12:59,000
.النّقابة

152
00:12:59,000 --> 00:13:01,170
.الزّعيم مفقود

153
00:13:01,170 --> 00:13:05,840
سمعتُ أنّ هناك حالات تمرّد
.بالنّقابة الآن بما أنّنا لا نملك زعيمًا

154
00:13:05,840 --> 00:13:10,420
.يبدو أنّه قد حان الوقت لنسدل السّتار على مغامرتنا هنا

155
00:13:10,720 --> 00:13:11,720
.أجل

156
00:13:12,470 --> 00:13:14,430
.لكنّ الحياة لم تنتهِ

157
00:13:14,430 --> 00:13:16,270
.هذا صحيح

158
00:13:16,270 --> 00:13:20,110
.سأعود إلى الدّيار وأنهي عملي على سيرتي الذّاتيّة

159
00:13:20,520 --> 00:13:22,060
ماذا عنكما؟

160
00:13:22,060 --> 00:13:24,650
.سأبحث عن السّيّد فرانسيس

161
00:13:26,320 --> 00:13:27,530
.واثقةٌ أنّه حيّ

162
00:13:29,530 --> 00:13:32,330
ستعود إلى عائلتك، أليس كذلك يا جون؟

163
00:13:32,330 --> 00:13:33,700
.كلاّ

164
00:13:35,210 --> 00:13:37,720
.يجب أن أوقف التّمرّد في النّقابة

165
00:13:37,720 --> 00:13:39,040
أنت؟

166
00:13:39,500 --> 00:13:41,210
.هذه مفاجأة

167
00:13:41,210 --> 00:13:44,090
.خلتكَ قد كرهتَ الزّعيم

168
00:13:44,090 --> 00:13:45,420
.أكرهه بالفعل

169
00:13:45,970 --> 00:13:49,550
.أكره كلّ من يتحكّم بالنّاس بالمال

170
00:13:49,550 --> 00:13:55,270
.لكنّه اعتمد على ثرائه لينقذ عائلته وهذه النّتيجة

171
00:13:55,770 --> 00:13:57,810
.لا يمكنني أن أرحل هكذا

172
00:13:58,810 --> 00:14:00,650
...العقد

173
00:14:02,230 --> 00:14:04,900
.قد تمّ إيفاؤه أخيرًا

174
00:14:04,900 --> 00:14:07,490
نجوتَ يا لافكرافت؟

175
00:14:07,490 --> 00:14:09,490
ماذا سيحلّ بك الآن؟

176
00:14:13,240 --> 00:14:14,450
.سأنام

177
00:14:20,040 --> 00:14:22,250
من ذاك الشّخص؟

178
00:14:22,960 --> 00:14:24,710
ماذا تقصد؟

179
00:14:25,210 --> 00:14:27,630
.إنّه أحد أصدقائي القلائل

180
00:14:34,410 --> 00:14:35,680
.كيوكا-تشان

181
00:14:37,360 --> 00:14:38,940
.تفضّلي

182
00:14:56,290 --> 00:14:57,830
...استعداد، و

183
00:14:57,830 --> 00:15:02,330
!تهانينا على انضمامك للنّقابة يا كيوكا-تشان

184
00:15:05,880 --> 00:15:07,840
!نخبك

185
00:15:28,070 --> 00:15:29,360
.أتسوشي

186
00:15:30,610 --> 00:15:32,200
كيف حال جراحك؟

187
00:15:32,200 --> 00:15:33,660
.إنّها بخير الآن

188
00:15:34,240 --> 00:15:38,080
.أفعالك قد أنقذت المدينة من الهلاك

189
00:15:38,500 --> 00:15:41,830
،بما أنّي أقدم منك في الوكالة
.فكّرتُ أن أقول لك شيئًا

190
00:15:46,340 --> 00:15:50,010
أوّلاً، العمليّات الفرديّة استثناء
.في منظمّات مجموعات مثلنا

191
00:15:50,010 --> 00:15:52,090
لن أخبرك بعدم تطبيق الخبرة
،الّتي اكتسبتها من هذا مستقبلاً

192
00:15:52,090 --> 00:15:53,760
.لكن إيّاك أن تهمل النّشاطات الرّئيسيّة للوكالة

193
00:15:53,760 --> 00:15:54,680
.ونفس الشّيء لكيوكا

194
00:15:54,680 --> 00:15:57,720
،ضعي في الاعتبار أنّك عضوة في وكالة التّحقيق

195
00:15:57,720 --> 00:15:59,640
.وتصرّفي بطريقة لا تجلب العار لأيّ أحد

196
00:15:58,310 --> 00:16:01,280
.جدّيًّا يا كونيكيدا

197
00:16:01,280 --> 00:16:04,230
.أنتم تقتلون المرح

198
00:16:04,520 --> 00:16:06,190
.اشرب معي

199
00:16:06,190 --> 00:16:08,280
.لا، يجب ألاّ أسرف في الشّرب

200
00:16:09,320 --> 00:16:11,950
ألم تكن تريد قول شيء ما؟

201
00:16:13,910 --> 00:16:15,570
.أبليتما حسنًا أنتما الاثنان

202
00:16:16,530 --> 00:16:19,040
!حسنًا، دعونا نشرب حتّى الصّباح

203
00:16:19,040 --> 00:16:20,370
.لا، رجاءً

204
00:16:20,370 --> 00:16:23,000
أتقصد أنّك لا تستطيع أن تشاركني الشّرب؟

205
00:16:23,000 --> 00:16:26,670
تصرّف بطريقة لا تجلب العار لأيّ أحد؟

206
00:16:28,840 --> 00:16:30,670
.هارونو-سان، ناومي-سان

207
00:16:32,810 --> 00:16:34,680
.أنا آسف

208
00:16:35,970 --> 00:16:39,680
.لقد ارتكبتُ أشياءً فظيعة بحقّكما بسبب قدرات كيو

209
00:16:40,150 --> 00:16:43,230
ما كان ليحدث ذلك أبدًا لو أنّي كنتُ
.مدركًا لمدى خطورة قدراتي

210
00:16:47,190 --> 00:16:49,780
تقصد ذلك؟

211
00:16:50,280 --> 00:16:54,150
.أنا حقًّا آسف

212
00:16:55,110 --> 00:16:58,660
.أتسوشي-كُن، لم يكن الأمر بذلك السّوء

213
00:16:58,660 --> 00:17:00,740
.لا يمكننا أن نتمسّك بمثل هذه الأمور هنا

214
00:17:01,200 --> 00:17:02,370
حقًّا؟

215
00:17:02,830 --> 00:17:03,660
.أجل

216
00:17:04,590 --> 00:17:06,460
.هذا مريح

217
00:17:06,830 --> 00:17:12,170
.لقد كان هناك خطبٌ ما بي لأنّي اقترفتُ ذلك بحقّكما

218
00:17:13,090 --> 00:17:14,220
.أتسوشي-كُن

219
00:17:15,840 --> 00:17:18,930
.لم أسمع بهذا حتّى الآن

220
00:17:18,930 --> 00:17:21,430
أتسوشي-كُن، ما القصّة؟

221
00:17:21,430 --> 00:17:23,350
.ابقَ هادئًا رجاءً

222
00:17:22,610 --> 00:17:28,650
رامبو-كُن، لقد أحضرتُ الرّائعة الجديدة
.الّتي استفسرتَ عنها عبر الهاتف

223
00:17:23,350 --> 00:17:25,140
.لا أستطيع

224
00:17:25,140 --> 00:17:27,940
!أفسدت سمعتي

225
00:17:27,940 --> 00:17:29,820
!كونيكيدا

226
00:17:28,360 --> 00:17:30,070
!نـ-ناومي-سان؟

227
00:17:29,820 --> 00:17:31,860
.يوسانو-سينسي، أظنّك أسرفت في الشّرب

228
00:17:30,070 --> 00:17:31,860
.مرحبًا

229
00:17:31,860 --> 00:17:33,820
.شكرًا على قدومك

230
00:17:33,780 --> 00:17:35,200
!أ-أتسوشي-كُن

231
00:17:33,820 --> 00:17:37,240
هل أنتمي إلى هنا حقًّا؟

232
00:17:35,860 --> 00:17:38,530
.رامبو-سان، الزّعيم يناديك

233
00:17:37,240 --> 00:17:39,240
.أنا من منظمة عدوّ

234
00:17:39,240 --> 00:17:40,450
.سأعود

235
00:17:40,030 --> 00:17:41,660
!كـ-كيوكا-تشان؟

236
00:17:40,450 --> 00:17:41,370
.ابقَ هنا

237
00:17:42,540 --> 00:17:43,910
.رامبو-كُن

238
00:17:43,910 --> 00:17:44,580
!ماذا؟

239
00:17:44,580 --> 00:17:46,460
!كونيكيدا

240
00:17:45,500 --> 00:17:47,420
.لقد كانت عمليّة مبهرة

241
00:17:46,460 --> 00:17:47,960
...ا-انتظري يا كيوكا-تشان

242
00:17:47,960 --> 00:17:50,250
!لا تختلق الأعذار، هذا جبن

243
00:17:48,290 --> 00:17:50,460
.الوكالة لا شيء من دونك

244
00:17:50,250 --> 00:17:52,000
بمَ أخبرتها يا تانيزاكي-سان؟

245
00:17:52,000 --> 00:17:54,210
.بكل الأمور الفاحشة الّتي ارتكبتها

246
00:18:07,980 --> 00:18:10,860
.إنّها رومان من سنة 64

247
00:18:10,860 --> 00:18:12,610
أتسمح لي؟

248
00:18:12,610 --> 00:18:14,020
أليست كنزك؟

249
00:18:14,410 --> 00:18:19,950
وهل هناك يومٌ أفضل من هذا لفتحها؟

250
00:18:21,830 --> 00:18:23,240
.نخب النّصر

251
00:18:27,940 --> 00:18:29,290
.إنّه لذيذ

252
00:18:30,120 --> 00:18:33,340
يا زعيم، كيف يجب أن نعاقب أكوتاغاوا؟

253
00:18:33,340 --> 00:18:34,880
نعاقبه؟

254
00:18:35,300 --> 00:18:38,550
.لقد كان له دورٌ فعّال في نجاحنا

255
00:18:38,550 --> 00:18:41,300
.لطالما كان أكوتاغاوا-كُن هكذا

256
00:18:41,760 --> 00:18:46,390
يذهب من تلقاء نفسه ويسبّب في الدّمار
.وفي النّهاية يساهم أكثر من غيره

257
00:18:46,730 --> 00:18:48,890
.لديه حاسّة شمّ قويّة

258
00:18:49,400 --> 00:18:52,020
،ما دام يستمر في النّجاح
.فلن يكون هناك عقاب

259
00:18:52,690 --> 00:18:59,200
بالمناسبة يا كويو-كُن، لماذا لم تحاولي
الهروب عندما قبضت عليك الوكالة؟

260
00:18:59,540 --> 00:19:02,020
.لا بدّ أنّ ذلك كان سهلاً عليك

261
00:19:02,830 --> 00:19:04,540
.أتساءل لماذا

262
00:19:06,000 --> 00:19:08,540
.ربّما لأن الشّاي كان لذيذًا جدًّا

263
00:19:09,160 --> 00:19:12,460
.أختاه، دعينا نعقد اتّفاقنا كوننا شخصين يافعين

264
00:19:13,090 --> 00:19:15,090
.لديّ خطّة لأنقذ كيوكا-تشان

265
00:19:15,420 --> 00:19:16,340
ماذا؟

266
00:19:17,050 --> 00:19:23,550
وإن نجحنا، فستكون الطّريقة الوحيدة
.لحماية حياتها وأحلامها

267
00:19:25,810 --> 00:19:30,060
.دازاي كان يعرف كيف ستنتهي الأمور

268
00:19:30,060 --> 00:19:32,450
.يا له من رجل مخيف

269
00:19:32,450 --> 00:19:33,150
.تبًّا

270
00:19:33,810 --> 00:19:37,150
.كويو-كُن، أنت قويّة

271
00:19:37,690 --> 00:19:44,410
،وبما أنّ حبيبتك كيوكا-كُن قد ذهبت
،فسيكون من الصّعب علي أن أبقيك

272
00:19:44,410 --> 00:19:46,740
.إن قرّرت مغادرة مافيا الميناء الآن

273
00:19:47,200 --> 00:19:48,620
.بالطّبع

274
00:19:49,540 --> 00:19:54,790
.مع الأسف، عليّ مساعدة قائدٍ أخرق في تجديد المنظّمة

275
00:19:56,670 --> 00:20:01,800
.أنا ممتنّ، لكنّي مهتمٌّ فقط بمن هنّ أصغر من 12 سنة

276
00:20:01,800 --> 00:20:03,090
.اصمت

277
00:20:03,090 --> 00:20:04,550
.وإلاّ قمت بخياطة شفتيك

278
00:20:04,550 --> 00:20:06,760
!دازاي

279
00:20:06,760 --> 00:20:08,590
!أنت هالك

280
00:20:12,100 --> 00:20:13,900
!يا لظرافته

281
00:20:20,860 --> 00:20:23,990
أين دازاي-سان؟

282
00:20:32,670 --> 00:20:34,670
.يا لها من لوحة غريبة

283
00:20:34,670 --> 00:20:37,250
.أراهن أنّني كنتُ لأرسمها

284
00:20:40,960 --> 00:20:43,930
.هيروتسو-سان، شكرًا على المساعدة

285
00:20:44,390 --> 00:20:46,760
هل فعلت ما يكفي؟

286
00:20:47,260 --> 00:20:51,180
كلّ ما فعلته هو تسريب طريق
.التّسلّل للموبي ديك لهيغوتشي-كُن

287
00:20:51,180 --> 00:20:54,480
.إن كانت تعلم، فستخبر أكوتاغاوا-كُن

288
00:20:55,020 --> 00:20:59,110
.وإن كان أكوتاغاوا-كُن يعلم، فسيأتي بنفسه

289
00:20:59,650 --> 00:21:00,990
.سار الأمر كما توقّعت

290
00:21:01,940 --> 00:21:07,150
لِمَ عانيت كل ذلك لتلاقيَ أكوتاغاوا-كُن بالفتى النّمر؟

291
00:21:07,950 --> 00:21:09,940
.أردتُ أن أتأكّد

292
00:21:10,650 --> 00:21:15,460
.من الكارثة الحقيقيّة الّتي على وشك أن تحدث

293
00:21:16,520 --> 00:21:18,970
.لقد بادر في حركته بالفعل

294
00:21:21,550 --> 00:21:24,930
.إذًا فدمار الموبي ديك كان إخفاقًا

295
00:21:25,460 --> 00:21:27,920
.مع ذلك، فكلّ شيء يسري وفق الخطّة

296
00:21:27,920 --> 00:21:33,870
.نجحنا في خلق الفتنة بين النّقابة وتجنيد المواهب

297
00:21:34,420 --> 00:21:38,300
أنا أساعد فقط لأتمّ منفعتي من الاتّفاق

298
00:21:38,300 --> 00:21:41,330
.لأجل إعادة مارغاريت إلى وعيها

299
00:21:42,770 --> 00:21:45,450
.لا بأس أيّها الكاهن

300
00:21:47,130 --> 00:21:51,760
.فلنقم بطلاء الأرض بدماء الآثمين

301
00:21:52,760 --> 00:21:55,150
.من أجل عالمٍ أفضل

302
00:21:57,270 --> 00:22:03,380
لن نتجنّب الحرب بوجود ذلك
.الشّيطان الّذي قاتلته في الماضي

303
00:22:04,480 --> 00:22:08,330
،أكوتاغاوا-كُن قويّ بما يكفي وحده

304
00:22:08,330 --> 00:22:12,360
.لكنّ قدراته أكثر قيمة في دور المساند

305
00:22:12,840 --> 00:22:15,780
،بضمّ مهاجمٍ مثل أتسوشي-كُن

306
00:22:15,780 --> 00:22:18,350
.بسرعته وشدّته، بوسعه أن يكون حليفًا قويًّا

307
00:22:20,370 --> 00:22:25,210
نحتاج أن نكون أقوياء أكثر
.من السّابق لقتال ذلك الشّيطان

308
00:22:26,280 --> 00:22:29,570
.شيء أكثر قوّة من الأسود المزدوج

309
00:22:30,350 --> 00:22:31,960
.إنّه ذلكما الاثنان

310
00:22:33,740 --> 00:22:41,240
دازاي-كُن، لؤمَ تقيّمُ يوكوهاما بهذه المعزَّة؟

311
00:22:41,930 --> 00:22:44,410
...أخبرني صديقي

312
00:22:46,370 --> 00:22:49,220
".قد تتعاون أيضًا مع من ينقذ النّاس"

313
00:22:49,910 --> 00:22:53,660
".ذلك أكثر جمالاً بقليل على الأقلّ"

314
00:22:55,290 --> 00:22:58,180
.تيني موهو

315
00:23:04,290 --> 00:23:06,370
.المدينة الّتي حميناها

316
00:23:12,540 --> 00:23:14,550
.هراء عديم القيمة

317
00:23:32,280 --> 00:23:36,180
.هذه المدينة بكلّ الأشخاص الّتي فيها، أصبحت بيتي