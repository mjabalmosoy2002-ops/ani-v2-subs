1
00:02:04,770 --> 00:02:06,890
.لا أملك الرّغبة لفعل شيء

2
00:02:06,890 --> 00:02:09,900
!كفّ عن الصّياح كبوقٍ مكسور من الصّباح الباكر

3
00:02:10,190 --> 00:02:14,570
ليست لديّ حتّى الطّاقة لمحادثة
.الآخرين يا كونيكيدا-كُن

4
00:02:14,570 --> 00:02:18,280
.لقد نجت هذه المدينة من الهلاك بفضلك وأتسوشي

5
00:02:18,280 --> 00:02:20,570
فلِماذا تتصرّف هكذا بعد مرور يومٍ فقط؟

6
00:02:20,570 --> 00:02:24,490
...لأنّ الرّئيس أوكلني المهمّة التّالية

7
00:02:24,870 --> 00:02:28,460
أتخصّ ما كان يناقشه أتسوشي مع الرّئيس البارحة؟

8
00:02:28,790 --> 00:02:29,460
.أجل

9
00:02:30,500 --> 00:02:31,830
.صباح الخير

10
00:02:31,830 --> 00:02:35,090
كيف تسير مفاوضات لقائنا
السّريّ مع مافيا الميناء يا دازاي؟

11
00:02:35,590 --> 00:02:37,340
...اتّخذتُ التّرتيبات، لكن

12
00:02:37,880 --> 00:02:40,300
أتظنّ أنّ زعيم المافيا سيحضر؟

13
00:02:40,800 --> 00:02:42,090
.بل واثق

14
00:02:42,600 --> 00:02:45,810
.بما أنّها فرصةٌ مثاليّةٌ لقتلك أيّها الرّئيس

15
00:02:48,560 --> 00:02:51,650
.هذا أفضل من إراقة دماء أعضائنا

16
00:02:52,940 --> 00:02:54,230
...دازاي

17
00:02:54,980 --> 00:02:57,360
!لقاءٌ سريّ مع مافيا الميناء؟

18
00:02:57,690 --> 00:03:01,780
.أصبحت فكرة أتسوشي أمرًا واقعًا

19
00:03:01,780 --> 00:03:04,620
...كما أنّ الّنقابة تشكّل التّهديد الأكبر الآن

20
00:03:04,620 --> 00:03:05,870
!تمهّل لحظة

21
00:03:05,870 --> 00:03:07,370
.لا أملك أدنى فكرةٍ عمّا يجري

22
00:03:07,370 --> 00:03:08,000
،أوّلًا

23
00:03:08,000 --> 00:03:11,250
!لِم أنت من يدير ذلك اللّقاء السّريّ؟

24
00:03:11,830 --> 00:03:14,590
.لأنّني كنتُ من مافيا الميناء

25
00:03:14,920 --> 00:03:15,790
!ماذا؟

26
00:03:15,790 --> 00:03:18,300
.الجميع يعلم بالأمر بستثنائك يا كونيكيدا-كُن

27
00:03:19,630 --> 00:03:20,930
!ماذا؟

28
00:03:22,550 --> 00:03:26,720
.لقد تكبّدت منظمّتنا وحدها ما لا يقلّ عن مئة قتيل

29
00:03:26,720 --> 00:03:28,430
،أكره الاعتراف بهذا

30
00:03:28,430 --> 00:03:33,940
،لكن لو لم يُبطل دازاي اللّعنة
.لتكبّدنا عشرة أضعاف هذه الخسائر

31
00:03:42,820 --> 00:03:44,030
.الآنسة كويو

32
00:03:44,490 --> 00:03:51,290
لقد طردني دازاي من وكالة التّحرّي قائلًا أنّ لا فائدة
.من الاحتفاظ بسجينةٍ لا تنفع في شيءٍ سوى زيادة النّفقات

33
00:03:51,960 --> 00:03:55,750
حتّى أنّه جعلني أقوم بدور المبعوث
.لسداد المسكن والمشرب

34
00:03:56,130 --> 00:03:58,250
.إنّها من رئيس وكالة التّحرّي

35
00:03:58,250 --> 00:04:00,260
.دعوةٌ لاحتساء الشّاي على ما أظن

36
00:04:01,420 --> 00:04:02,510
.عجبًا

37
00:04:03,630 --> 00:04:05,340
.إذًا فقد آلت الأمور إلى هذا النّحو

38
00:04:06,930 --> 00:04:10,100
كيف حالك يا زعيم؟

39
00:04:10,100 --> 00:04:11,810
...أيّها الطّبيب

40
00:04:11,810 --> 00:04:14,940
...أُؤمر الأعضاء التّنفيذيّين بأن يقوموا بالإبادة

41
00:04:14,940 --> 00:04:18,110
،سواءٌ المنظّمات المعادية أو الشّرطة العسكريّة

42
00:04:18,110 --> 00:04:21,030
.كلّ من يعارض مافيا الميناء يجب أن يُقتل قبل المغيب

43
00:04:21,030 --> 00:04:23,320
.هذا غير منطقيّ

44
00:04:23,320 --> 00:04:25,490
.لا يهمّني عدد رجالنا الّذين سيهلكون

45
00:04:25,490 --> 00:04:26,450
.اقتلوهم

46
00:04:26,450 --> 00:04:27,490
.اقتلوهم فقط

47
00:04:27,490 --> 00:04:28,990
.أبيدوهم جميعًا

48
00:04:28,990 --> 00:04:33,000
...اقتلوهم، اقتلوهم، اقتلوهم

49
00:04:31,080 --> 00:04:33,000
.سمعًا وطاعة يا زعيم

50
00:04:36,500 --> 00:04:39,090
.لقد توفّي الزّعيم جرّاء مرضٍ عضال

51
00:04:40,050 --> 00:04:43,880
.وصيّته كانت أن أخلفه كزعيم

52
00:04:45,180 --> 00:04:47,340
.وأنت الشّاهد على ذلك

53
00:04:48,140 --> 00:04:49,390
مفهوم؟

54
00:05:03,110 --> 00:05:04,700
.مرحبًا يا زعيم

55
00:05:04,700 --> 00:05:06,280
.مضت أربع سنوات

56
00:05:06,660 --> 00:05:09,950
أما زلتَ ترتدي المعطف الّذي أعطيتك إيّاه؟

57
00:05:09,950 --> 00:05:10,830
...بالطّبع

58
00:05:12,790 --> 00:05:14,250
.قد أحرقته

59
00:05:16,830 --> 00:05:20,500
.زعيم مافيا الميناء، موري أوغاي-دونو

60
00:05:21,340 --> 00:05:25,170
،رئيس وكالة التّحرّي المسلّحة
.فوكوزاوا يوكيتشي-دونو

61
00:05:33,560 --> 00:05:36,020
.إذًا فقد حلّ هذا اليوم أخيرًا

62
00:05:36,020 --> 00:05:39,060
،إذا اكتشف أصحاب المناصب العليا في الحكومة

63
00:05:39,060 --> 00:05:41,900
أنّ زعيمي أقوى منظّمتين لذوي القدرات
،في يوكوهاما يقيمان لقاءً سرّيًا

64
00:05:41,900 --> 00:05:44,570
.فسيستشيطون غضبًا

65
00:05:44,940 --> 00:05:47,030
.سأدخل في صلب الموضوع

66
00:05:47,030 --> 00:05:52,240
اقترح عضوٌ جديدٌ بالوكالة
.أن نشكّل تحالفًا مع مافيا الميناء

67
00:05:53,160 --> 00:05:55,290
.أنا أعارض ذلك

68
00:05:55,290 --> 00:05:59,670
.ففكرة التّعاون مع مجرمين تنافي سياسة الوكالة

69
00:06:00,380 --> 00:06:06,760
إلّا أنّ صاحب هذا الاقتراح تعرّض للاعتداء
.والاختطاف مرّاتٍ لا تحصى من قبل مافيا الميناء

70
00:06:07,340 --> 00:06:09,470
.كلماته لها قيمة

71
00:06:09,930 --> 00:06:14,100
،بالتّالي وبمثابتي رئيس الوكالة
.وجب عليّ أخذ مقترحه على محمل الجدّ

72
00:06:14,930 --> 00:06:18,440
.كلانا في موقفٍ صعب

73
00:06:19,230 --> 00:06:20,770
.سأدخل في المغزى

74
00:06:20,770 --> 00:06:24,900
،حتّى لو كان من المحال تشكيل هذا التّحالف
.إلّا أنّني أريد طلب هدنةٍ مؤقّتة

75
00:06:27,190 --> 00:06:29,360
أسبق وقرأت أعمال شيلينغ؟

76
00:06:31,120 --> 00:06:33,410
ماذا عن ناش وكسنجر؟

77
00:06:33,780 --> 00:06:36,910
.جميعهم باحثون في الدّراسات الاستراتيجيّة

78
00:06:36,910 --> 00:06:39,540
.أحدهم لقّنني كلّ ذلك منذ زمنٍ طويل

79
00:06:39,540 --> 00:06:41,460
.قرأتُ أعمال سون تزو

80
00:06:41,460 --> 00:06:47,380
الحرب بين الدّول والحرب بين المنظّمات
.غير القانونيّة مثلنا لا تختلف كثيرًا

81
00:06:47,760 --> 00:06:51,260
.لا أحد ليعاقبنا إن خرقنا اتّفاقًا

82
00:06:51,260 --> 00:06:55,600
ماذا لو خرقت مافيا الميناء الهدنة فجأة؟

83
00:06:55,600 --> 00:06:57,600
ماذا لو خانتنا الوكالة؟

84
00:06:57,980 --> 00:07:01,560
.الطّرف الّذي وثِق بالاتّفاق وحده سيتكبّد الخسائر

85
00:07:01,560 --> 00:07:04,820
،وفي ظلّ أوضاعٍ تكافئ من يُقدِم على الخيانة أوّلًا

86
00:07:04,820 --> 00:07:07,820
.فستكون الهدنة عديمة القيمة

87
00:07:07,820 --> 00:07:09,280
...الامكانيّة الوحيدة لنجاحها

88
00:07:09,700 --> 00:07:11,740
.هي أن يكون الطّرفان على وفاقٍ تامّ

89
00:07:12,240 --> 00:07:13,990
.هذا مستحيل أيضًا

90
00:07:13,990 --> 00:07:15,450
.بالضّبط

91
00:07:15,450 --> 00:07:19,160
.مافيا الميناء تأخذ شرفها وأحقادها على محمل الجدّ

92
00:07:19,580 --> 00:07:23,380
وقد عانى العديد من أتباعي
.الإذلال على أيدي وكالة التّحرّي

93
00:07:23,790 --> 00:07:26,840
.وأتباعي واجهوا الموت مرارًا بسببكم أيضًا

94
00:07:26,840 --> 00:07:28,920
.لكنّهم لم يموتوا

95
00:07:28,920 --> 00:07:31,930
.وذلك مصدر عارٍ كبير لمافيا الميناء

96
00:07:31,930 --> 00:07:35,300
...إذًا ما رأيك بهذا

97
00:07:36,010 --> 00:07:39,520
.فلنصفِّ حساباتنا هنا والآن

98
00:07:49,400 --> 00:07:51,610
...خلتك قد تخلّيتَ عن سيفك

99
00:07:51,610 --> 00:07:54,280
.أيّها السّياف الوحيد، "الذّئب الفضيّ" فوكوزاوا-دونو

100
00:07:55,120 --> 00:07:59,750
ولم تتغيّر عادتك في قتل النّاس
.بمِشرطٍ أيّها الطّبيب موري

101
00:07:59,750 --> 00:08:02,040
أما زال لديك ميولٌ للقاصرات؟

102
00:08:02,620 --> 00:08:06,080
أما زلتَ تُحادث القطط؟

103
00:08:18,310 --> 00:08:20,470
.قدرةٌ على خلق صورٍ مجسّمة

104
00:08:21,480 --> 00:08:23,390
.لقد كان اجتماعًا ممتعًا

105
00:08:23,390 --> 00:08:25,600
.فلنكمله في ساحة المعركة

106
00:08:25,600 --> 00:08:28,520
.ستتحرّك الوكالة لاستعادة كيو اللّيلة

107
00:08:29,110 --> 00:08:30,030
وبعد؟

108
00:08:30,480 --> 00:08:32,490
.لا تعترضوا طريقنا لهذه اللّيلة فقط

109
00:08:33,030 --> 00:08:34,910
.لمصلحة كلينا

110
00:08:34,910 --> 00:08:35,700
لماذا؟

111
00:08:36,240 --> 00:08:39,790
...لأنّ هذا هو الأمر الوحيد المشترك بيننا

112
00:08:40,660 --> 00:08:42,660
.حبّنا لهذه المدينة

113
00:08:43,790 --> 00:08:47,040
،كمواطنين ومنظّمةٍ تعمل على حماية هذه المدينة

114
00:08:47,040 --> 00:08:50,920
.فإنّنا لن نسمح لذوي قدراتٍ أجانب بتدميرها

115
00:08:51,380 --> 00:08:53,170
.النّقابة قويّة

116
00:08:53,170 --> 00:08:55,090
.لا فرصة للوكالة أمامها

117
00:08:55,800 --> 00:08:58,010
،بالمناسبة يا دازاي-كُن

118
00:08:58,010 --> 00:09:01,310
.دعوتي لك لتعود إلينا كعضوٍ تنفيذيّ ما زالت قائمة

119
00:09:01,310 --> 00:09:02,980
.محال

120
00:09:02,980 --> 00:09:07,310
ألستَ من أجبرني على مغادرة المافيا أساسًا؟

121
00:09:07,770 --> 00:09:10,570
ألم تغادر بإرادتك الخاصّة؟

122
00:09:10,980 --> 00:09:13,650
لقد كُنتَ خائفًا، أليس كذلك؟

123
00:09:14,280 --> 00:09:20,240
.من أن أنحرك يومًا ما وأستولي على منصب الزّعيم

124
00:09:20,240 --> 00:09:23,660
.كما فعلتَ بسلفِك

125
00:09:26,870 --> 00:09:30,130
.الشّرير يتوقع الشّر من الآخرين

126
00:09:30,790 --> 00:09:34,300
.لا أوافق على التّحالف معكم أيضًا

127
00:09:43,060 --> 00:09:43,970
ما أخبار قوّاتنا؟

128
00:09:43,970 --> 00:09:47,310
.اتّخذت مواقعها كما أمرت

129
00:09:47,310 --> 00:09:48,400
.زعيم

130
00:09:49,060 --> 00:09:53,070
.لقد كنتُ أخدم المافيا منذ عهد الزّعيم السّابق

131
00:09:53,730 --> 00:09:56,320
.أنت مخضرمٌ بالفعل يا هيروتسو-سان

132
00:09:56,320 --> 00:10:01,490
كان عالم الجريمة في حالة
.خرابٍ خلال سنواته الأخيرة

133
00:10:01,490 --> 00:10:05,620
،منذُ أن استفحل مرضه
.صارت أوامره ضالّةً ومتقلّبة

134
00:10:06,410 --> 00:10:09,830
.أقحم المافيا في صراعاتٍ لا طائل منها

135
00:10:09,830 --> 00:10:13,670
.كانت المدينة لتنهار عاجلًا أم آجلًا

136
00:10:14,420 --> 00:10:18,380
...وقتها، لو أنّك لم تستولِ على منصبه

137
00:10:19,550 --> 00:10:21,640
إلامَ ترمي؟

138
00:10:22,800 --> 00:10:23,890
.لا شيء

139
00:10:23,890 --> 00:10:29,850
أريد أن أنوّه فقط أنّ دازاي-كُن
.يتفهّم سبب قيامك بذلك

140
00:10:30,770 --> 00:10:33,400
.إذًا هنا يحتجزون كيو

141
00:10:39,070 --> 00:10:40,820
.مساء الخير

142
00:10:40,820 --> 00:10:45,540
مخطِّطتنا الاستراتيجيّة
.بارعةٌ في توقّع تحرّكات العدوّ

143
00:10:45,990 --> 00:10:47,620
.من الواضح أنّه فخّ

144
00:10:48,290 --> 00:10:53,380
حتّى ولو لم يكن دازاي-كُن
.ينوي الاستلاء على منصبي

145
00:10:53,880 --> 00:10:57,760
.فقد كانت كلّ قراراتي الأمثل وفقًا للمنطق

146
00:10:57,760 --> 00:10:59,380
.لستُ نادمًا على شيء

147
00:11:00,300 --> 00:11:05,390
،لكن لو أنّ دازاي ما يزال ساعدي الأيمن
.لما شكّلت النقابة أيّ تهديد لنا

148
00:11:06,430 --> 00:11:09,520
.الشّرير يتوقع الشّر من الآخرين

149
00:11:10,770 --> 00:11:12,020
.هيروتسو-سان

150
00:11:12,940 --> 00:11:15,190
.إليّ باللّاسلكيّ للاتّصال بالخطوط الأماميّة

151
00:11:15,190 --> 00:11:17,150
.ها هو ذا

152
00:11:17,610 --> 00:11:19,490
،بغضّ النّظر عمّا قلته للوكالة

153
00:11:19,950 --> 00:11:23,490
.فعقد تحالفٍ يبدو حلًا منطقيًا

154
00:11:24,450 --> 00:11:27,450
.الدّفع المقدّم هو جوهر التّحالف

155
00:11:27,870 --> 00:11:33,790
،نتكبّد خسائر في البداية نيابةً عن الطّرف الآخر
.ثمّ نجني بالمقابل أرباحًا أكثر بمئة ضعف

156
00:11:34,170 --> 00:11:37,420
فقط حينها بإمكان التّحالف
.أن يعوّض عن أحقاد الماضي

157
00:11:47,310 --> 00:11:51,440
ذانك الاثنان أبادا منظمّة ذوي
.قدراتٍ معادية في ليلةٍ واحدة

158
00:11:51,440 --> 00:11:54,690
".أُطلقَ عليهما لقب "الأسود المزدوج
.الثّنائيّ الأكثر فتكًا في عالم الجريمة

159
00:11:55,520 --> 00:11:57,980
.سيعود ذلك الثّنائيّ لليلةٍ واحدة

160
00:11:58,320 --> 00:12:00,490
.دعني أوضّح لك الأمر أوّلًا

161
00:12:03,030 --> 00:12:06,200
.حالما أتخلّص من هذه القمامة، سيحين دورك

162
00:12:06,200 --> 00:12:08,330
.توقّعتُ حدوث هذا

163
00:12:08,330 --> 00:12:11,500
لا عجب أنّي لم أملك رغبةً
.في فعل شيءٍ منذ الصّباح

164
00:12:11,500 --> 00:12:12,410
!مستحيل

165
00:12:12,410 --> 00:12:15,290
!هذا الكمين لم يكن متوقّعًا في استراتيجيّتنا

166
00:12:16,040 --> 00:12:18,130
.آسف، لكن هذا ممنوع

167
00:12:19,760 --> 00:12:21,550
قدرةٌ لإبطال القدرات؟

168
00:12:21,550 --> 00:12:23,220
.هذا مزعج

169
00:12:23,220 --> 00:12:25,930
!هذا ما أريد قوله

170
00:12:27,390 --> 00:12:30,060
.حان وقت قلب الطّاولة

171
00:12:30,060 --> 00:12:32,730
.إنّها جبهتنا المشتركة ضدّ النّقابة

172
00:12:33,230 --> 00:12:35,980
.ونفير هجومنا المضاد

173
00:12:37,440 --> 00:12:41,030
الحلقة الحادية والعشرون
الأسود المزدوج

174
00:12:46,490 --> 00:12:48,120
.يا إلهي

175
00:12:48,120 --> 00:12:50,790
.هذا أسوأ يومٍ أمرّ به منذ سنوات

176
00:12:50,790 --> 00:12:53,580
دازاي، أسبق وسمعت ببيتروس؟

177
00:12:53,580 --> 00:12:56,290
.إنّه نبيذٌ باهظٌ بشكلٍ لا يصدق

178
00:12:56,290 --> 00:12:58,840
،ليلة اختفائك من المنظّمة

179
00:12:58,840 --> 00:13:02,630
.فتحتُ زجاجةً من عام 1889 احتفالًا بذلك

180
00:13:02,630 --> 00:13:05,090
.هذا يوضّح مدى كرهي لك أيّها الوغد

181
00:13:05,090 --> 00:13:09,100
أذكر أنّي احتفلتُ أيضًا بوضع
.قنبلةٍ تحت سيّارتك تلك اللّيلة

182
00:13:09,100 --> 00:13:10,810
!أكان ذلك من صنيعك؟

183
00:13:10,810 --> 00:13:12,890
.لكم أمقتك

184
00:13:12,890 --> 00:13:15,810
.أكره كلّ شيءٍ متعلّقٍ بك أيضًا يا تشويا

185
00:13:15,810 --> 00:13:18,690
.ذوقك في الأحذية هو الوحيد الّذي يروقني

186
00:13:19,820 --> 00:13:21,190
حقًا؟

187
00:13:21,900 --> 00:13:23,030
.أمزح بالطّبع

188
00:13:23,030 --> 00:13:24,320
!...أيّها الـ

189
00:13:24,320 --> 00:13:25,610
.لا فائدة

190
00:13:28,780 --> 00:13:30,370
!كنتُ أتساهل معك

191
00:13:30,370 --> 00:13:32,620
.كنتُ لأسحق جمجمتك لو أنّي جادّ

192
00:13:32,620 --> 00:13:34,410
حقًا؟

193
00:13:34,790 --> 00:13:36,620
.كم هذا مخيف

194
00:13:40,210 --> 00:13:41,670
.ها هو ذا

195
00:13:41,670 --> 00:13:44,510
.الأمير النّائم الّذي ينتظر منقذه

196
00:13:44,880 --> 00:13:47,050
الأمير النّائم؟

197
00:13:48,010 --> 00:13:49,180
.أعرني سكّينك

198
00:13:50,550 --> 00:13:53,310
.مهلًا، سبق وأن سحبته منك من باب الاحتياط

199
00:13:53,310 --> 00:13:54,140
...أيّها الـوغد

200
00:13:58,310 --> 00:13:59,400
ألن توقفني؟

201
00:13:59,980 --> 00:14:03,610
،أمرني الزّعيم بإعادته حيًا

202
00:14:03,610 --> 00:14:09,870
لكنّ النّظر إلى وجه ذلك الفتى يذكّرني بأكياس
.جثث أتباعي الّذين لقوا مصرعهم بسبب لعنته

203
00:14:10,990 --> 00:14:12,030
.أجهز عليه

204
00:14:12,870 --> 00:14:14,120
.فهمت

205
00:14:14,740 --> 00:14:17,460
.حسنًا، اسمح لي

206
00:14:20,290 --> 00:14:21,790
.يا لك من جبان

207
00:14:22,290 --> 00:14:25,260
.نفاقك يُقرفني

208
00:14:25,710 --> 00:14:31,760
ما دام كيو حيًا بحوزتكم، فستحتاجون
قدرتي كإجراءٍ احترازيّ، أليس كذلك؟

209
00:14:31,760 --> 00:14:34,220
.لن تستطيع مافيا الميناء قتلي

210
00:14:34,600 --> 00:14:36,470
.إنّه قرارٌ منطقيّ

211
00:14:36,470 --> 00:14:38,390
.أتساءل حيال ذلك

212
00:14:39,850 --> 00:14:41,350
.أيّها الوغد دازاي

213
00:14:41,350 --> 00:14:43,570
!ناولني تلك الدّمية

214
00:14:43,570 --> 00:14:44,860
.مستحيل

215
00:14:44,860 --> 00:14:46,570
.إنّها تأميني

216
00:14:46,860 --> 00:14:49,360
—حتمًا سأقتله يومًا

217
00:14:54,870 --> 00:14:59,710
.لقد تصلّب كتفي لسببٍ ما منذ حين

218
00:14:59,710 --> 00:15:02,040
هل أجهدتُ جسدي؟

219
00:15:04,250 --> 00:15:06,170
ما كانت تلك القدرة؟

220
00:15:06,170 --> 00:15:08,590
!كما هو متوقّعٌ من مستخدم قدرةٍ ينتمي للنّقابة

221
00:15:08,590 --> 00:15:10,300
!يا له من شخصٍ عنيد

222
00:15:10,300 --> 00:15:11,590
!ابتعد عنّي

223
00:15:12,930 --> 00:15:14,100
.إنّه قادمٌ يا دزاي

224
00:15:14,100 --> 00:15:15,260
ماذا سنفعل؟

225
00:15:15,260 --> 00:15:16,770
.لا داعي لفعل شيء

226
00:15:16,770 --> 00:15:20,890
—أستطيع إبطال أيّ قدرةٍ بلمسةٍ من إصبعي

227
00:15:23,020 --> 00:15:24,310
!دازاي

228
00:15:29,950 --> 00:15:32,200
...يا لها من لكمةٍ قويّة

229
00:15:34,870 --> 00:15:35,990
!دازاي

230
00:15:37,660 --> 00:15:38,620
هل أنت بخير؟

231
00:15:40,870 --> 00:15:43,210
...لقد تأذّيت بشدّة

232
00:15:43,580 --> 00:15:46,590
.تلك المجسّات غريبةٌ بالفعل

233
00:15:46,590 --> 00:15:48,960
.قدرتي عديمة النّفع ضدّها

234
00:15:48,960 --> 00:15:49,970
.مستحيل

235
00:15:49,970 --> 00:15:51,380
أهذا ممكن حتّى؟

236
00:15:52,090 --> 00:15:54,800
.لا يوجد استثناءٌ أمام قدرة الإبطال خاصّتي

237
00:15:55,430 --> 00:15:58,390
.وهذا يعني شيئًا واحدًا لا غير

238
00:15:58,930 --> 00:16:01,310
.تلك ليست قدرة

239
00:16:02,190 --> 00:16:06,900
.يجب أن أنهي عملي وأعود

240
00:16:02,600 --> 00:16:03,900
حقًا؟

241
00:16:03,900 --> 00:16:06,230
.هذه مزحةٌ طريفة يا رجل

242
00:16:07,230 --> 00:16:10,360
إن لم تكن قدرةً فما عساها تكون؟

243
00:16:10,360 --> 00:16:13,660
.ما باليد حيلة، فلنستخدم الخطّة القديمة

244
00:16:13,660 --> 00:16:16,120
ما رأيك بخطّة "العار والضّفدع"؟

245
00:16:16,120 --> 00:16:19,580
ألا يجدر بنا استخدام خّطّة
المطر يسقط خلف إطار النّافذة"؟"

246
00:16:19,580 --> 00:16:21,410
أو "خداع الزّهور الزّائفة"؟

247
00:16:21,410 --> 00:16:22,620
.تشويا

248
00:16:23,160 --> 00:16:26,000
أسبق وفشلت خططي؟

249
00:16:28,090 --> 00:16:29,170
.سحقًا

250
00:16:29,590 --> 00:16:31,670
...أتضوّر جوعًا

251
00:16:31,670 --> 00:16:32,670
.مرحبًا

252
00:16:34,260 --> 00:16:36,340
...تخلّص من العدوّ

253
00:16:37,140 --> 00:16:38,260
.وعُد إلى الدّيار

254
00:16:40,020 --> 00:16:42,770
الرّجل الّذي في المقدّمة مجرّد تمويه؟

255
00:16:44,270 --> 00:16:46,230
.تلاعب الجاذبيّة

256
00:16:49,690 --> 00:16:53,820
.لديّ القدرة على التّلاعب بجاذبيّة كلّ ما ألمسه

257
00:16:53,820 --> 00:16:55,700
.اخلد إلى النّوم أيّها الأخطبوط

258
00:16:55,700 --> 00:16:56,990
.أحسنت

259
00:16:56,990 --> 00:16:57,950
!أيّها الوغد

260
00:16:58,580 --> 00:17:01,490
.لا تأمرني وكأنّي كلب رعي

261
00:16:58,620 --> 00:17:00,160
.أشعر بنعاسٍ شديد

262
00:17:00,160 --> 00:17:02,080
.يا له من إزعاج

263
00:17:01,490 --> 00:17:03,710
.كنتُ لأستخدم كلب رعيّ لو كان عندي

264
00:17:02,080 --> 00:17:08,040
.لكن يجب أن أتمّ عقدي مع فرانسيس

265
00:17:03,710 --> 00:17:06,750
!وبما أنّني لا أملكه، تحتّم عليّ أن أتدبّر أمري بك

266
00:17:06,750 --> 00:17:08,040
!...أيّها الـوغد

267
00:17:10,000 --> 00:17:10,750
!دازاي

268
00:17:20,100 --> 00:17:23,520
أيّ مزحةٍ هذه؟

269
00:17:24,310 --> 00:17:27,020
.هذا الشّيء ليس بشريًا

270
00:17:28,020 --> 00:17:29,650
...أنت... ذراعك

271
00:17:30,940 --> 00:17:34,610
.تشويا، ثمّة ما أودّ إخبارك به قبل أن أموت

272
00:17:34,610 --> 00:17:36,150
!ما الّذي تتحدّث عنه؟

273
00:17:36,150 --> 00:17:37,360
—لا يمكنك أن تموت في مكانٍ كهذا

274
00:17:37,450 --> 00:17:38,700
!مفاجأة

275
00:17:38,820 --> 00:17:42,950
،إن كنتُ سأقاتل وأنا مصاب
.فبالطّبع سآتي وأنا مستعدّ

276
00:17:42,950 --> 00:17:44,790
،إن كان لديك الوقت لألعاب الخفّة

277
00:17:44,790 --> 00:17:47,460
!ففكّر بما سنفعله مع ذلك الكابوس؟

278
00:17:47,460 --> 00:17:48,630
.مستحيل

279
00:17:48,630 --> 00:17:49,830
.فلنستسلم لحتفنا

280
00:17:50,420 --> 00:17:52,880
.لدينا حركةٌ واحدةٌ متبقّية فحسب

281
00:17:52,880 --> 00:17:54,130
...لا يعقل

282
00:17:54,760 --> 00:17:56,470
تريد استخدام "المدنّس"؟

283
00:17:58,010 --> 00:18:05,060
"أصبحنا نعرف بـ"الأسود المزدوج
.بعد أن أبدنا منظّمةً معادية في ليلةٍ واحدة

284
00:18:05,560 --> 00:18:09,850
.لكن إن تأخرتُ في التّدخّل فستلقى حتفك

285
00:18:10,520 --> 00:18:12,070
.سأدعك تقرّر

286
00:18:12,690 --> 00:18:15,190
تدعني أقرّر؟

287
00:18:15,990 --> 00:18:18,360
...كلّما قلت هذا

288
00:18:19,200 --> 00:18:22,620
.لا أجد لنفسي خيارًا آخر

289
00:18:25,540 --> 00:18:29,500
،يا معارفي، مانحي خزي الظّلام

290
00:18:31,880 --> 00:18:34,710
.لا توقظوني مجدّدًا من سباتي

291
00:18:46,100 --> 00:18:49,100
!ما هذا؟

292
00:18:49,100 --> 00:18:52,560
هل انتابك الفضول أيّها النّملة العاملة للنّقابة؟

293
00:18:53,900 --> 00:18:57,400
.تلك هي الهيئة النّهائية لقدرة تشويا

294
00:19:00,610 --> 00:19:04,620
في هيئة "المدنّس" يستطيع تشويا
.التّلاعب بالغرافيتونات المحيطة به

295
00:19:04,620 --> 00:19:09,120
قنابل الغرافيتون المكثّف هيّ ثقوبٌ
.سوداء تبتلع كل ما في مجالها

296
00:19:11,330 --> 00:19:13,960
،لكنّه لا يستطيع التّحكّم بقوّته

297
00:19:13,960 --> 00:19:16,960
وسيستمّر في الهيجان إلى
.أن يستهلك طاقته ويموت

298
00:19:20,260 --> 00:19:23,140
لكن ما ذلك الشّيء على أيّ حال؟

299
00:19:25,390 --> 00:19:29,560
.مهما قام تشويا بتمزيقه، إلّا وتجدّد فورًا

300
00:19:29,930 --> 00:19:34,270
ألست تعلم ماهيته بما أنّك رفيقه؟

301
00:19:34,270 --> 00:19:35,320
من يدري؟

302
00:19:35,860 --> 00:19:38,360
.حتّى لو علمت، فلا سبب يدفعني لإخبارك

303
00:19:47,580 --> 00:19:49,410
.هذا سيّئ

304
00:19:49,410 --> 00:19:51,540
.لن يصمد جسد تشويا

305
00:19:51,540 --> 00:19:53,120
،لسوء حظّكم

306
00:19:53,120 --> 00:19:58,000
يستحيل تدمير لافكرافت
.من الخارج وهو في تلك الهيئة

307
00:19:58,000 --> 00:19:59,260
من الخارج؟

308
00:19:59,760 --> 00:20:03,180
.إذًا فالقضاء عليه من الدّاخل ممكن

309
00:20:21,740 --> 00:20:22,860
أجهز عليه

310
00:20:22,860 --> 00:20:24,410
.يا تشويا

311
00:21:01,280 --> 00:21:03,530
.تمّت تصفية العدوّ

312
00:21:03,530 --> 00:21:05,110
.استرح الآن يا تشويا

313
00:21:14,870 --> 00:21:17,920
.أخبرتك أن توقفني فور انتهاء الأمر

314
00:21:17,920 --> 00:21:21,050
كنتُ أنوي فعلها، لكنّ الأمر
.كان ممتعًا وبقيتُ أشاهد

315
00:21:23,630 --> 00:21:27,140
".وثقتُ بك واستخدمتُ "المدنّس

316
00:21:28,430 --> 00:21:30,310
...احرص

317
00:21:30,930 --> 00:21:36,190
.على أن... تعيدني إلى القاعدة

318
00:21:38,600 --> 00:21:41,110
.اعتمد عليّ يا رفيقي

319
00:21:41,650 --> 00:21:43,530
.لا أصدّق هذا

320
00:21:43,530 --> 00:21:45,450
...لافكرافت قد

321
00:21:47,160 --> 00:21:49,780
من أنتما بحقّ؟

322
00:21:52,160 --> 00:21:55,500
.أعداء الأشرار على ما أظن

323
00:23:30,050 --> 00:23:37,010
سأذهب
وأترك
،تشويا
كما هو
واضح

