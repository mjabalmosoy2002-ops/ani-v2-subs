1
00:00:01,230 --> 00:00:07,940
... النّاس

2
00:00:03,270 --> 00:00:07,940
يعيشون سعيًا لخلاص

3
00:00:05,270 --> 00:00:07,940
...أنفسهم

4
00:00:09,170 --> 00:00:11,630
.طابت ليلتك يا كوسكي

5
00:00:15,050 --> 00:00:17,200
.طابت ليلتك يا كاتسومي

6
00:00:20,760 --> 00:00:22,640
.طابت ليلتك يا يو

7
00:00:26,420 --> 00:00:28,650
.طابت ليلتك يا شينجي

8
00:00:31,720 --> 00:00:33,880
.طابت ليلتكِ يا ساكورا

9
00:00:36,550 --> 00:00:38,320
.ارقدوا بسلام

10
00:00:42,140 --> 00:00:43,340
.سأغادر

11
00:00:48,400 --> 00:00:51,440
.أشكرك على حضورك اليوم إلى هنا

12
00:00:52,060 --> 00:00:55,200
.أكرّر، هذا اجتماعٌ غير رسميّ

13
00:00:55,740 --> 00:00:57,970
.أشكرك على دعوتي اليوم إلى هنا

14
00:00:58,710 --> 00:01:01,230
ما شعورك بعد عودتك إلى عملك الأصليّ؟

15
00:01:01,720 --> 00:01:05,780
،لا تبالغ الإساءة إلى موظّفي المبتدئ من فضلك

16
00:01:05,780 --> 00:01:08,250
.يا زعيم مافيا الميناء

17
00:01:08,620 --> 00:01:12,550
.عزيزتي إليس-تشان تريد البوظة

18
00:01:12,550 --> 00:01:17,090
أتوجد أيّ محلّات لبيع البوظة يوصي بها
الموظّفون الحكوميّون أيّها الرّئيس تانيدا؟

19
00:01:17,090 --> 00:01:20,460
.يا له من حديثٍ مؤثّر

20
00:01:20,460 --> 00:01:24,590
.يجب أن أجلب هدايا لموظّفيّ أيضًا

21
00:01:25,130 --> 00:01:29,600
وأراهن أنّ لا شيء سيسرّهم
.أكثر من رؤية رأسك على طبق

22
00:01:31,600 --> 00:01:34,400
.فلنباشر جدولنا إن سمحتما

23
00:01:35,030 --> 00:01:39,240
لدى قسم العمليّات الخاصّة لذوي القدرات
.طلبان إلى أوغاي-دونو من مافيا الميناء

24
00:01:39,820 --> 00:01:45,650
أوّلًا، عدم التعرّض بأيّ أذى لشخصي
.أنا ساكاغوتشي أنغو وتركي بسلام

25
00:01:45,650 --> 00:01:51,970
ثانيًا، ستتخلّص من منظّمة ميميك الإجراميّة
.لذوي القدرات الّتي دخلت إلى اليابان بشكلٍ غير قانونيّ

26
00:01:51,970 --> 00:01:55,130
.لا اعتراض لديّ على الطّلب الأوّل

27
00:01:55,610 --> 00:01:58,960
.لكنّني متردّد بشأن قبول الطّلب الثّاني

28
00:01:59,620 --> 00:02:02,360
.ففي النّهاية هم مجموعةٌ مرعبة

29
00:02:03,140 --> 00:02:05,930
.وبالطّبع ذلك يعتمد على الظّروف

30
00:02:36,110 --> 00:02:37,360
.أوداساكو

31
00:02:39,370 --> 00:02:41,800
.أعلم ما يجول في خاطرك

32
00:02:42,360 --> 00:02:43,690
.لكن إيّاك أن تفعلها

33
00:02:43,690 --> 00:02:45,210
...فحتّى لو فعلت

34
00:02:45,210 --> 00:02:49,430
.حتّى لو فعلت، لن يعيد ذلك الأطفال

35
00:02:49,940 --> 00:02:52,100
.ما زال تعدادهم كبيرًا

36
00:02:57,720 --> 00:02:59,730
.فقد حصلتُ على دعوةٍ كما ترى

37
00:02:59,730 --> 00:03:00,820
.أصغِ إليّ

38
00:03:01,210 --> 00:03:05,040
.حضر الزّعيم للتّو اجتماعًا سرّيًا على ما يبدو

39
00:03:05,040 --> 00:03:07,410
.مع قسم العمليّات الخاصّة لذوي القدرات

40
00:03:07,410 --> 00:03:10,830
.هناك أمرٌ ما يُحاك في الخفاء

41
00:03:10,830 --> 00:03:13,350
.لا شيء آخر يحدث يا دازاي

42
00:03:14,740 --> 00:03:16,650
.انتهى كلّ شيءٍ بالنّسبة لي

43
00:03:16,650 --> 00:03:17,750
.أوداساكو

44
00:03:17,750 --> 00:03:20,560
،اعذرني على صياغة الأمر بهذه الطّريقة

45
00:03:20,560 --> 00:03:22,100
.لكن استمع إليّ رجاءً

46
00:03:22,100 --> 00:03:23,850
.عليك أن تعتمد على شيءٍ ما

47
00:03:23,850 --> 00:03:25,410
.لا يهمّ ما قد يكون

48
00:03:25,410 --> 00:03:28,110
.عليك أن تتريّث وترى ما سيحدث

49
00:03:28,110 --> 00:03:30,510
.فسيحدث بلا شك

50
00:03:32,280 --> 00:03:33,630
.أخبرني يا أوداساكو

51
00:03:34,540 --> 00:03:37,710
أتدري سبب انضمامي إلى مافيا الميناء؟

52
00:03:39,410 --> 00:03:41,970
.كنتُ آمل أن أجد بها شيئًا لنفسي

53
00:03:42,740 --> 00:03:45,770
.العنف والموت، الفطرة والرّغبة

54
00:03:46,650 --> 00:03:50,130
إن وضعت نفسك بالقرب
،من تلك العواطف الخالصة

55
00:03:50,130 --> 00:03:52,570
.حينها بإمكانك أن تلمس طبيعة الإنسان الحقيقيّة

56
00:03:53,610 --> 00:03:55,220
...خِلتُ أنّني بتلك الطّريقة

57
00:03:56,760 --> 00:03:59,740
.سأجد سببًا لأعيش من أجله بطريقةٍ ما

58
00:04:01,920 --> 00:04:04,350
.أردتُ أن أغدو كاتبًا

59
00:04:05,720 --> 00:04:10,290
،ظننتُ أنّي سأفقد حقّ فعل ذلك
. إن أزهقت أرواحًا أخرى

60
00:04:10,290 --> 00:04:12,340
.لهذا توقّفتُ عن القتل

61
00:04:13,090 --> 00:04:14,310
.أوداساكو

62
00:04:14,800 --> 00:04:16,230
.لكنّ كلّ ذلك قد ولّى

63
00:04:16,620 --> 00:04:17,180
!لا تذهب

64
00:04:17,180 --> 00:04:18,240
!أوداساكو

65
00:04:23,170 --> 00:04:26,030
.لديّ رغبةٌ واحدةٌ فقط

66
00:04:28,610 --> 00:04:29,790
!أوداساكو

67
00:04:30,120 --> 00:04:35,620
كلاب الأدب الشاردة

68
00:04:49,430 --> 00:04:51,820
...هذا مؤلم

69
00:04:51,820 --> 00:04:52,490
!أنت

70
00:04:52,490 --> 00:04:53,430
ماذا تحسب نفسك فاعلًا؟

71
00:04:53,430 --> 00:04:56,310
!يجب أن تنتبه إلى طريقك

72
00:04:56,310 --> 00:04:59,700
كدتَ أن تُفسد أدوات التّحرّي
.الشّهيرة الّتي أهداني إيّها الرّئيس

73
00:04:59,700 --> 00:05:00,720
متحرّي؟

74
00:05:01,640 --> 00:05:04,210
!ليس أيّ متحرّي، بل متحرٍّي عظيم

75
00:05:04,210 --> 00:05:07,850
قريبًا، سيُعرف اسمي في
.كلّ بيتٍ وركنٍ من اليابان

76
00:05:07,850 --> 00:05:11,670
!أنا أعظم متحرٍّي شهده العالم، إيدوغاوا رانبو

77
00:05:10,530 --> 00:05:11,670
.أعتذر

78
00:05:11,670 --> 00:05:13,090
!انتظر لحظة

79
00:05:13,090 --> 00:05:17,210
،بمجرّد أن تشهد قدرتي
!لن تكون فظًا معي

80
00:05:17,660 --> 00:05:19,930
.سأريكَ إن شككتَ بي

81
00:05:20,920 --> 00:05:22,080
...دعنا نرَ

82
00:05:27,190 --> 00:05:29,470
،لا أقصد أن أكون فظًا

83
00:05:30,300 --> 00:05:32,890
.لكن لا يجب أن تذهب إلى حيث تتّجه

84
00:05:33,550 --> 00:05:35,180
.أعِد التّفكير في ذلك

85
00:05:37,110 --> 00:05:38,390
،إن ذهبت

86
00:05:39,000 --> 00:05:40,230
.فستلقى حتفك

87
00:05:42,290 --> 00:05:43,220
.أجل

88
00:05:45,230 --> 00:05:46,450
.أعلم

89
00:07:17,900 --> 00:07:19,330
أتريدني أن أخلّص عليك؟

90
00:07:20,000 --> 00:07:20,870
...أجل

91
00:07:21,870 --> 00:07:23,130
.رجاءً

92
00:07:23,130 --> 00:07:25,360
ألديك أيّ كلماتٍ أخيرة؟

93
00:07:26,090 --> 00:07:27,310
...شكرًا لك

94
00:07:27,950 --> 00:07:29,220
...على قتالنا

95
00:07:30,200 --> 00:07:32,600
...ستجد قائدنا... إلى الأمام

96
00:07:33,390 --> 00:07:35,140
...من فضلك أنقذه أيضًا

97
00:07:35,760 --> 00:07:37,310
.من هذا الجحيم

98
00:07:38,210 --> 00:07:39,120
.أجل

99
00:07:39,850 --> 00:07:41,040
.أعلم

100
00:07:49,170 --> 00:07:51,360
عجبًا، دازاي-كُن؟

101
00:07:51,780 --> 00:07:54,240
.من النّادر أن تأتي لزيارتي

102
00:07:55,010 --> 00:07:56,220
.أيّها الزّعيم

103
00:07:56,220 --> 00:08:01,570
أودّ طلب تصريحك لتشكيل فرقةٍ
.من ذوي القدرات لأجل إنقاذ أوداساكو

104
00:08:01,570 --> 00:08:03,880
.حسنًا، لك موافقتي

105
00:08:03,880 --> 00:08:06,690
لكن هل لي بمعرفة السّبب؟

106
00:08:07,090 --> 00:08:13,020
يقوم أوداساكو حاليًا باستطلاعٍ
.لقوّة العدوّ بمفرده في مقرّ ميميك

107
00:08:13,020 --> 00:08:16,970
سيموت إن لم نتحرّك
.وسنفقد عميلًا ذو قدرةٍ قيّمة

108
00:08:18,910 --> 00:08:21,320
.أتفهّم مخاوفك

109
00:08:21,320 --> 00:08:25,980
.لكن أشكّ أنّ أودا-كُن يرغب بأن ينقذه أحد

110
00:08:27,040 --> 00:08:29,200
ما رأيك بذلك؟

111
00:08:31,110 --> 00:08:38,420
دازاي-كُن، زعيم منظّمةٍ هو
.الآمر والعبد في الوقت ذاته

112
00:08:38,420 --> 00:08:44,110
يجب أن يكون الزّعيم على أتمّ الاستعداد
.لارتكاب أشنع الأفعال لضمان بقائها

113
00:08:44,860 --> 00:08:46,640
...ذلك الظّرف

114
00:08:48,230 --> 00:08:51,000
.هكذا إذًا. اتّضح الأمر الآن

115
00:08:53,340 --> 00:08:55,390
إلى أين أنت ذاهب؟

116
00:08:56,120 --> 00:08:57,480
.إلى أوداساكو

117
00:09:09,740 --> 00:09:16,520
إن لم تقع حبّة الحنطة في"
".الأرض وتمت فهي تبقى وحدها

118
00:09:17,470 --> 00:09:18,560
"...ولكن إن ماتت"

119
00:09:19,490 --> 00:09:22,610
".ولكن إن ماتت تأتي بثمرٍ كثير"

120
00:09:23,100 --> 00:09:26,360
.الإصحاح 12، الآية 24 من إنجيل يوحنّا

121
00:09:27,150 --> 00:09:30,200
أنت واسع الاطّلاع أكثر ممّا
.يبدو عليك يا ساكونوسكي

122
00:09:32,160 --> 00:09:34,860
.أعتذر عمّا حدث للأطفال

123
00:09:35,540 --> 00:09:37,960
.لكن يبدو أنّ الأمر كان يستحقّ

124
00:09:38,750 --> 00:09:40,790
.عيناك مثل عينايّ الآن

125
00:09:41,380 --> 00:09:45,820
،مثلي ومثل أتباعي
.تبدو كأحدٍ سئم من الوجود

126
00:09:46,270 --> 00:09:50,220
!مرحبًا بك في عالمنا يا ساكونوسكي

127
00:10:06,090 --> 00:10:09,370
.يبدو أنّنا لن نحرز تقدّمًا بقراءة مستقبلنا فقط

128
00:10:09,370 --> 00:10:10,130
.يبدو ذلك

129
00:10:23,890 --> 00:10:28,010
إذًا علينا أن نتواجه دون
.استخدام قدراتنا التنبّئيّة

130
00:10:28,380 --> 00:10:29,000
.بالفعل

131
00:10:29,900 --> 00:10:31,870
.معك حقٌّ يا ساكونوسكي

132
00:10:32,270 --> 00:10:34,620
.أنت حقًا الأفضل

133
00:10:36,030 --> 00:10:39,520
.لم ينتهِ نقاشنا بعد يا دازاي-كُن

134
00:10:40,990 --> 00:10:43,150
كنتُ أفكّر منذ وقتٍ طويل

135
00:10:43,650 --> 00:10:47,410
بشأن مافيا الميناء وميميك
.وفرقة العمليّات السّوداء الخاصّة

136
00:10:47,410 --> 00:10:51,660
أو بالأحرى، قسم العمليّات الخاصّة
.لذوي القدرات، في هذه القضيّة

137
00:10:51,660 --> 00:10:56,060
.ومن يحرّك خيوط الصّراع بين الأطراف الثّلاثة

138
00:10:57,050 --> 00:11:02,170
هذا التّخطيط الجريء والمعقّد
.كان من صنيعك أيّها الزّعيم

139
00:11:03,110 --> 00:11:06,130
وذاك الظّرف الأسود قيّمٌ
.إلى حدّ أن تفعل ذلك لأجله

140
00:11:07,140 --> 00:11:11,900
،مهما بلغت قوّة مافيا الميناء

141
00:11:11,900 --> 00:11:19,600
فوجودنا يشوبه الخوف الدّائم من سخط
.قسم العمليّات الخاصّة لذوي القدرات

142
00:11:20,740 --> 00:11:23,610
،لهذا السّبب ومقابل سحق ميميك

143
00:11:24,370 --> 00:11:27,830
.فقد تفاوضتَ من أجل إصدار هذا التّرخيص

144
00:11:28,350 --> 00:11:32,590
هذا التّرخيص الّذي يسمح لنا
...بإدارة منظّمةٍ لذوي القدرات

145
00:11:33,370 --> 00:11:35,400
.ترخيص عمل ذوي القدرات

146
00:12:01,490 --> 00:12:03,980
.أنت الأفضل يا ساكونوسكي

147
00:12:04,480 --> 00:12:06,750
.اليوم سأجاريك حتّى النّهاية

148
00:12:22,820 --> 00:12:23,800
ماذا؟

149
00:12:26,630 --> 00:12:28,550
أهذا ما تحدّث عنه أنغو؟

150
00:12:28,940 --> 00:12:31,020
!فرديّة القدرة؟

151
00:12:33,880 --> 00:12:36,010
.هذا هو العالم الّذي سعيتُ إليه

152
00:12:36,690 --> 00:12:38,140
لِم سعيت إليه؟

153
00:12:38,540 --> 00:12:40,920
ولماذا توقّفت عن القتل؟

154
00:12:42,760 --> 00:12:45,080
.لأنّني أردتُ أن أصبح كاتبًا

155
00:12:45,680 --> 00:12:49,020
.أخبرني أحدهم أنّ هذا ما ينبغي عليّ فعله

156
00:12:49,750 --> 00:12:51,790
.أعطاني كتابًا

157
00:12:52,340 --> 00:12:56,290
لقد كان المجلّد الأخير لروايةٍ
.بحثتُ عنها لوقتٍ طويل

158
00:13:00,580 --> 00:13:04,050
.قبل أن أقرأه، أخبرني أنّه ينتهي بمأساة

159
00:13:04,790 --> 00:13:07,490
وكيف كان؟

160
00:13:08,170 --> 00:13:09,470
...ذلك الكتاب

161
00:13:09,470 --> 00:13:12,980
الحلقة السّادسة عشرة

162
00:13:09,470 --> 00:13:12,980
كلاب الأدب الشاردة

163
00:13:10,510 --> 00:13:12,980
.كان في غاية الرّوعة

164
00:13:15,010 --> 00:13:20,530
أنت من ساعدهم على دخول
.البلاد بشكلٍ غير قانونيّ يا زعيم

165
00:13:21,300 --> 00:13:28,300
دعوتَ منظّمة العدوّ إلى يوكوهاما لتدفع قسم العمليّات
.الخاصّة لذوي القدرات لاتّخذ إجراء بشأن ذلك

166
00:13:28,980 --> 00:13:29,700
.أجل

167
00:13:30,360 --> 00:13:34,460
وبفضل ذلك، حصلنا على
.ترخيص عمل ذوي القدرات

168
00:13:34,460 --> 00:13:38,450
لقد صادقت الحكومة على
.كلّ أعمالنا اللّا مشروعة

169
00:13:38,450 --> 00:13:44,010
كما أنّ أودا-كُن سيخاطر بحياته
.من أجل أن يتكفّل بالمعتدين المزعجين

170
00:13:44,700 --> 00:13:46,170
.إنّه انتصار عظيمٌ لنا

171
00:13:46,790 --> 00:13:48,050
...ومع ذلك

172
00:13:48,640 --> 00:13:51,380
لِم أراك غاضبًا؟

173
00:13:51,380 --> 00:13:57,890
أنت من أعلمَ ميميك بشأن اليتامى
.الّذين يعتني بهم أوداساكو

174
00:13:58,420 --> 00:14:02,850
فعلت ذلك لتحرّض أوداساكو
،على مواجهة زعيم ميميك

175
00:14:03,240 --> 00:14:05,070
.العميل الوحيد القادر على مقارعته

176
00:14:08,490 --> 00:14:09,440
.دازاي-كُن

177
00:14:12,840 --> 00:14:14,630
.الزم مكانك هنا

178
00:14:15,860 --> 00:14:16,910
...أم أنّ

179
00:14:18,790 --> 00:14:22,980
لديك سببًا منطقيًا للذّهاب إليه؟

180
00:14:24,260 --> 00:14:27,100
.ثمّة أمران أريد إخبارك بهما أيّها الزّعيم

181
00:14:28,220 --> 00:14:29,040
...أوّلًا

182
00:14:30,430 --> 00:14:32,390
.لن تطلق عليّ النّار

183
00:14:32,850 --> 00:14:35,100
.كما لن تأمر أتباعك بفعل ذلك

184
00:14:36,170 --> 00:14:38,170
ما الّذي يجعلك تظنّ ذلك؟

185
00:14:38,170 --> 00:14:40,160
.لأنّك لن تكسب شيئًا من ذلك

186
00:14:41,230 --> 00:14:47,330
أعتقد أنّك لن تكسب شيئًا أيضًا
.بعصيانك لي والذّهاب إليه

187
00:14:47,330 --> 00:14:50,050
.وهذا يقودنا إلى الأمر الثّاني يا زعيم

188
00:14:50,910 --> 00:14:53,220
،قد لا أكسب شيئًا من أفعالي

189
00:14:55,150 --> 00:14:57,300
.لكن هناك سببٌ وحيدٌ يدفعني للذّهاب

190
00:15:01,600 --> 00:15:03,590
.لأنّه صديقي

191
00:15:22,990 --> 00:15:26,140
.الكتاب الأخير من تلك السّلسلة كان رائعًا

192
00:15:26,140 --> 00:15:28,220
.لكن كان به عيبٌ واحد

193
00:15:29,050 --> 00:15:32,290
لقد قطّعت وأزيلت الكثير
.من الصّفحات في نهايته

194
00:15:32,780 --> 00:15:35,280
.إذًا فلتكتبه بنفسك

195
00:15:35,790 --> 00:15:41,170
:قبل الجزء المقطوع، يوجد سطرٌ يقول

196
00:15:41,880 --> 00:15:45,320
".يعيش النّاس سعيًا لخلاص أنفسهم"

197
00:15:42,540 --> 00:15:52,220
...النّاس يعيش
سعيًا لخلاص
...أنفسهم

198
00:15:45,970 --> 00:15:48,530
".ستفهم ذلك لحظة موتك"

199
00:15:46,840 --> 00:15:52,220
ذلك ستفهم
لحظة موتك

200
00:15:51,480 --> 00:15:53,210
،وبالتّفكير في ذلك الآن

201
00:15:53,800 --> 00:15:58,480
لعلّ ذلك الرّجل أعطاني الكتاب
..علمًا منه بأنّني قاتلٌ مأجور

202
00:15:59,510 --> 00:16:04,370
.كان يعرف، وتحدّث إليّ كي أتوقّف عن القتل

203
00:16:05,500 --> 00:16:09,760
.أخبرني باسمه في أولّ لقاءٍ لنا

204
00:16:09,760 --> 00:16:12,050
،نسيتُ ذلك الاسم لوقتٍ طويل

205
00:16:12,050 --> 00:16:15,500
.لكنّي تذكّرته مؤخّرًا

206
00:16:16,160 --> 00:16:18,150
من أنت؟

207
00:16:18,630 --> 00:16:19,820
أنا؟

208
00:16:19,820 --> 00:16:23,080
.اسمي ناتسومي سوسيكي

209
00:16:23,730 --> 00:16:24,780
.هذا صحيح

210
00:16:24,780 --> 00:16:28,790
.كان يحمل نفس اسم كاتب تلك الرّواية

211
00:16:32,430 --> 00:16:34,490
.لقد كنتُ بطلًا

212
00:16:35,160 --> 00:16:40,300
.عشتُ مؤمنًا أنّ الإله قدّر لي حماية موطني

213
00:16:41,050 --> 00:16:43,090
،في الحرب العالميّة الأخيرة

214
00:16:43,090 --> 00:16:48,850
،دحر فريقي المؤلّف من أربعين رجلًا
.ستّ مئةٍ من الأعداد المتحصّنين في قلعة

215
00:16:49,520 --> 00:16:53,460
.لكنّ ذلك كان كمينًا نصبه مقرّنا الحليف

216
00:16:54,540 --> 00:16:58,600
في الوقت الّذي كانت بلادنا
.تجري محادثات سلام

217
00:16:58,600 --> 00:17:04,200
تمّ استغلالنا من قبل الهيئة العسكريّة
.للاستلاء على شبكة نقل العدوّ

218
00:17:06,680 --> 00:17:10,290
.وبالطّبع، تمّ اعتبار أفعالنا كجريمة حرب

219
00:17:11,450 --> 00:17:15,720
أصبح حلفاؤنا أعداءً لنا
.بعد أن وُصِفنا بالمتمرّدين

220
00:17:19,100 --> 00:17:21,880
.أقدم البعض من فريقي على الانتحار

221
00:17:24,640 --> 00:17:25,550
...ولكن

222
00:17:26,360 --> 00:17:28,300
.هنالك من نجى

223
00:17:30,700 --> 00:17:35,070
.خسرنا موطننا وشرفنا

224
00:17:35,640 --> 00:17:41,210
وأصبحنا أشباحًا نهوم في القفار
.باحثين عن أعداءٍ نقاتلهم

225
00:17:42,540 --> 00:17:46,260
أواثقٌ أنّك لم تستطع تغيير نمط حياتك؟

226
00:17:47,200 --> 00:17:50,970
.أقسمتُ لرجالي أنّي سأموت كجنديّ

227
00:17:50,970 --> 00:17:53,550
.لا يمكنني أن أغيّر كياني

228
00:17:56,410 --> 00:17:59,780
.لا... لعلّي كنتُ أستطيع

229
00:17:59,780 --> 00:18:05,950
لربّما كنتُ أستطيع إعادة صياغة نمط حياتي
.وأن أصبح شخصًا ليس بجنديّ

230
00:18:06,440 --> 00:18:09,280
.مثلما توقّفت أنت عن القتل

231
00:18:11,530 --> 00:18:13,850
.أنا متحسّرٌ على شيءٍ واحد

232
00:18:14,580 --> 00:18:16,900
.لم أودّع صديقي

233
00:18:18,220 --> 00:18:22,460
.الرّجل الّذي كان صديقي الوحيد في هذا العالم

234
00:18:23,240 --> 00:18:27,470
.بدا أنّه سئم من العالم وينتظر أجله

235
00:18:28,240 --> 00:18:32,450
أكان يبحث عن الموت مثلي؟

236
00:18:34,000 --> 00:18:34,820
.كلّا

237
00:18:35,660 --> 00:18:36,980
.أظنّ أنّه مختلف

238
00:18:49,820 --> 00:18:51,200
.ساكونوسكي

239
00:18:52,240 --> 00:18:56,380
.حتّى طلقتك الأخيرة كانت مثاليّة

240
00:19:07,560 --> 00:19:08,570
!أوداساكو

241
00:19:16,810 --> 00:19:18,800
.يا لك من أحمقٍ يا أوداساكو

242
00:19:18,800 --> 00:19:20,820
!أنت أحمق كلّيًا

243
00:19:20,820 --> 00:19:21,960
...أجل

244
00:19:24,150 --> 00:19:26,490
لِم سايرت مراده؟

245
00:19:26,490 --> 00:19:27,930
...دازاي

246
00:19:28,480 --> 00:19:31,680
.ثمّة ما أريد إخبارك به

247
00:19:32,380 --> 00:19:33,430
!لا

248
00:19:33,430 --> 00:19:34,680
!لا تفعل

249
00:19:34,680 --> 00:19:36,530
!ما زال بإمكاننا إنقاذ حياتك

250
00:19:36,530 --> 00:19:37,960
!لا، بل سننقذك

251
00:19:37,960 --> 00:19:39,150
—لذا لا تتحدّث وكأنّك سـ

252
00:19:39,150 --> 00:19:40,190
.أصغِ إليّ

253
00:19:42,080 --> 00:19:50,470
أخبرتني أنّك قد تجد سببًا لتحيا من أجله
.إن عشتَ في عالمٍ من العنف وإراقة الدّماء

254
00:19:50,470 --> 00:19:51,740
.أجل، قلتُ ذلك

255
00:19:51,740 --> 00:19:53,330
!لكن من يأبه لما قلته الآن؟

256
00:19:53,330 --> 00:19:55,040
.لن تجده

257
00:19:56,350 --> 00:19:58,850
.لا بدّ وأنّك أدركت ذلك بالفعل

258
00:19:59,530 --> 00:20:03,050
سواء كنتَ في الجانب الّذي
،يقتل النّاس أو الّذي ينقذهم

259
00:20:03,050 --> 00:20:06,370
.فلن تجد شيئًا يتجاوز توقّعاتك

260
00:20:09,080 --> 00:20:13,510
لا شيء في هذا العالم
.يستطيع ملأ فراغ وحدتك

261
00:20:14,390 --> 00:20:18,490
.ستهوم في الظّلام إلى الأبد

262
00:20:23,520 --> 00:20:24,990
...أوداساكو

263
00:20:25,830 --> 00:20:27,530
ماذا عساي أفعل؟

264
00:20:29,290 --> 00:20:31,660
.كُن في الجانب الّذي ينقذ النّاس

265
00:20:32,960 --> 00:20:37,040
.وإن كان الجانبان سيّان، فكن رجلاً صالحًا

266
00:20:37,770 --> 00:20:40,660
.أنقذ الضّعفاء واحمِ اليتامى

267
00:20:41,800 --> 00:20:45,680
...أعلم أنّك لا تأبه للخير أو الشّر

268
00:20:45,680 --> 00:20:49,670
لكنّ ذلك سيجعلك شخصًا
.أفضل بقليلٍ على الأقل

269
00:20:51,370 --> 00:20:52,500
أنّى لك أن تعلم ذلك؟

270
00:20:53,120 --> 00:20:54,410
.بالطّبع أنا أعلم

271
00:20:55,180 --> 00:20:57,010
.أعلم ذلك أكثر من أيّ أحدٍ آخر

272
00:20:57,740 --> 00:20:58,940
...لأنّني

273
00:21:00,300 --> 00:21:02,770
.صديقك

274
00:21:07,780 --> 00:21:08,940
.فهمت

275
00:21:08,940 --> 00:21:10,740
.سأفعل ذلك

276
00:21:11,680 --> 00:21:17,650
...يعيش النّاس سعيًا لخلاص أنفسهم

277
00:21:18,760 --> 00:21:22,760
...هذا صحيحٌ بالفعل

278
00:21:53,250 --> 00:21:58,040
... أسبوعين  بعد

279
00:22:05,510 --> 00:22:09,640
لم أتوقّع أن أجد شخصًا رفيعًا في وزارة الدّاخليّة
.يشرب وحيدًا في حانةٍ متواضعةٍ كهذه

280
00:22:09,640 --> 00:22:13,240
.لا بدّ أنّك تشعر بالوحدة أيّها الرّئيس تانيدا

281
00:22:13,240 --> 00:22:14,590
...أنت

282
00:22:14,590 --> 00:22:16,110
.دعك من ذلك

283
00:22:16,530 --> 00:22:20,380
سمعتُ شائعاتٍ تقول
.أنّك تواريت عن الأنظار لمدّة

284
00:22:22,210 --> 00:22:24,600
.أنا أبحثُ عن عملٍ جديد

285
00:22:25,210 --> 00:22:27,520
أتعرف أيّ مناصب جيّدة؟

286
00:22:27,530 --> 00:22:29,890
أتريد أن تنضمّ إلى قسم
العمليّات الخاصّة لذوي القدرات؟

287
00:22:29,890 --> 00:22:31,010
...إن كان الأمر كذلك

288
00:22:31,010 --> 00:22:33,170
.أعتذر عن رفض عرضك

289
00:22:33,170 --> 00:22:35,870
.لا أبلي جيّدًا في محيط عملٍ تسوده القوانين

290
00:22:36,640 --> 00:22:38,910
ما الّذي تبحث عنه إذًا؟

291
00:22:39,640 --> 00:22:41,620
.أن أعمل في مكانٍ حيثُ أستطيع مساعدة النّاس

292
00:22:48,070 --> 00:22:50,420
...لديّ الكثير من الأسئلة لك، لكن

293
00:22:50,780 --> 00:22:53,060
.لديك سجلٌّ أسود

294
00:22:53,640 --> 00:22:57,180
.عليك أن تتوارى لسنتين على الأقل لتنظّف سجلّك

295
00:22:57,650 --> 00:23:01,820
.لكن هذا لا يعني أنّي لا أملك أي اقتراحات

296
00:23:04,980 --> 00:23:06,530
.آتني بها

297
00:23:09,880 --> 00:23:12,860
.هناك وكالةٌ مسلّحة لذوي القدرات

298
00:23:12,860 --> 00:23:17,870
يتكفّلون بالقضايا القانونيّة والّتي
.يعجز الأفراد العاديون عن تولّي أمرها

299
00:23:18,450 --> 00:23:21,500
.رئيس تلك الوكالة رجلٌ نزيه

300
00:23:21,960 --> 00:23:24,190
.قد تجده يتماشى مع رغبتك

301
00:23:27,960 --> 00:23:30,220
أيمكنني القيام بعملٍ ينقذ النّاس؟

302
00:23:27,960 --> 00:23:31,800
الحلقة السّادسة عشرة
كلاب الأدب الشّاردة

303
00:23:31,890 --> 00:23:36,970
والقصّة تستأنف... بعد أربع سنوات

304
