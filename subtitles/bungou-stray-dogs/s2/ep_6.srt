1
00:00:03,340 --> 00:00:04,730
...بضربة واحدة

2
00:00:06,900 --> 00:00:11,940
.من الضروريّ ضرب النقطة الحيوية للعدوّ بضربةٍ واحدة

3
00:00:13,870 --> 00:00:14,960
.أنت سيئ

4
00:00:15,470 --> 00:00:16,320
.حسنًا

5
00:00:18,510 --> 00:00:20,040
انتظر! ماذا تفعل؟

6
00:00:21,530 --> 00:00:23,790
.أكتب رسالةً لصديق

7
00:01:54,940 --> 00:01:58,590
!اشحنوا كلّ بضائع بلادي إلى المقصورة رقم ثلاثة

8
00:01:58,930 --> 00:02:00,680
!ستدفعون الثّمن إن كسرتم أيّ شيء

9
00:02:01,740 --> 00:02:03,310
...حقًّا

10
00:02:03,310 --> 00:02:06,160
لمَ يجب أن أشرف على نقل البضائع؟

11
00:02:17,670 --> 00:02:18,610
.اصمتي

12
00:02:18,610 --> 00:02:19,720
ماذا؟

13
00:02:19,720 --> 00:02:22,860
،تحديقك مثيرٌ للإزعاج
.لا يمكنني سماع صوت الرّب

14
00:02:22,860 --> 00:02:27,340
.هكذا إذًا؟ يا لك من وزيرٍ متديّن

15
00:02:27,340 --> 00:02:30,000
...واثقةٌ أنّك تحب هذه الآية

16
00:02:30,530 --> 00:02:32,580
"من التّراب إلى التّراب"

17
00:02:39,870 --> 00:02:43,390
سفر التكوين 3:19

18
00:02:43,630 --> 00:02:45,810
،بينما يؤدّي الجميع واجبهم على اليابسة

19
00:02:45,810 --> 00:02:48,520
.فمن واجبنا أن نحمي السفينة

20
00:02:49,510 --> 00:02:50,730
هل نسيت ذلك؟

21
00:02:52,050 --> 00:02:54,690
أواثقةٌ أنّك لستِ من نسيت؟

22
00:02:55,410 --> 00:02:59,680
.إصدار الحُكم على الآثمين هو واجبي المقدّس

23
00:02:59,680 --> 00:03:02,070
.أرحّب بالأعداء مهما كان عددهم

24
00:03:02,380 --> 00:03:06,300
.سيُكفّرون عن ذنوبهم بحياتهم

25
00:03:07,040 --> 00:03:10,940
أم أنّك ترغبين بالتّكفير أيضًا؟

26
00:03:10,940 --> 00:03:14,630
.لستَ جديرًا حتّى بتلميع حذائي

27
00:03:15,360 --> 00:03:17,940
...معذرةً

28
00:03:19,190 --> 00:03:22,550
.و- وجدنا هذه الرسالة مع البضاعة

29
00:03:22,550 --> 00:03:23,590
رسالة؟

30
00:03:27,860 --> 00:03:29,060
...سيّدي وآنستي

31
00:03:30,400 --> 00:03:35,400
.آمل أنّ هذه الرسالة وصلتكما وأنتما في تمام الصّحة والعافية

32
00:03:35,400 --> 00:03:37,570
!رينتارو أيها النذل! غبي

33
00:03:36,060 --> 00:03:38,150
.كتبتُ هذه فيما يتعلق بالصراع العسكريّ الأخير

34
00:03:38,150 --> 00:03:39,610
،مع أنّ هذا قد يبدو متعجرفًا

35
00:03:39,610 --> 00:03:44,240
.أحيطكما علمًا بأصول النقابة التي سنبيدها قادمًا

36
00:03:42,660 --> 00:03:44,240
!أعد إليّ القلم الملّون خاصتّي

37
00:03:44,240 --> 00:03:48,080
"...هذه هي أصول النقابة التي سنبيدها قادمًا"

38
00:03:50,990 --> 00:03:54,750
.سنبدأ بسفينتكم الفاخرة، زيلدا"

39
00:03:54,940 --> 00:03:58,480
ثانيًا حياة السيّد ناثانييل"

40
00:03:58,480 --> 00:04:01,820
".ثالثًا، حياة الآنسة مارغاريت

41
00:04:01,820 --> 00:04:02,730
ماذا؟

42
00:04:02,730 --> 00:04:06,650
".مع تحيّاتي، زعيم مافيا الميناء، موري أوغاي"

43
00:04:06,650 --> 00:04:09,010
يبيدنا والسّفينة؟

44
00:04:09,330 --> 00:04:10,580
.مستحيل

45
00:04:12,290 --> 00:04:14,820
.سنغادر فور أن ننتهي من شحن البضاعة

46
00:04:15,600 --> 00:04:16,460
كم سيستغرق ذلك؟

47
00:04:16,900 --> 00:04:18,070
...ساعتان أخرتان على ما أعتقد

48
00:04:18,270 --> 00:04:19,960
.أنهوا الأمر في ثلاثين دقيقة

49
00:04:19,960 --> 00:04:21,050
!ثلاثون دقيقة؟

50
00:04:21,050 --> 00:04:22,990
،بينما الشحن العاديّ مستمرّ

51
00:04:22,990 --> 00:04:26,470
.قوموا بإفراغ مروحية الشحن في منصّة الهبوط

52
00:04:26,470 --> 00:04:29,200
.وشدّدوا الحماية حول السفينة

53
00:04:29,200 --> 00:04:30,760
هل أنت جاد؟

54
00:04:30,760 --> 00:04:33,540
.رسالة التّهديد السخيفة هذه محض خدعة

55
00:04:34,430 --> 00:04:35,370
هل أنت واثقة؟

56
00:04:36,070 --> 00:04:39,550
،بما أنّ نقابتنا لا تملك أيّ قاعدة على اليابسة

57
00:04:39,550 --> 00:04:41,750
.فهذه السفينة أساسًا قاعدتنا الأماميّة

58
00:04:41,750 --> 00:04:43,040
وماذا في ذلك؟

59
00:04:43,040 --> 00:04:47,020
نحن أكثر عرضةً للخطر في هذه
.اللحظة بينما نقوم بتجديد الإمدادات

60
00:04:47,020 --> 00:04:51,080
هذا العدوّ ومنظّمة الخوارق هذه
قد لا يشكّلون خطرًا على حياتنا

61
00:04:51,080 --> 00:04:55,390
.لكن بإمكانهم إغراق السّفينة حال أن شنّوا هجومًا مفاجئًا

62
00:04:56,020 --> 00:04:57,320
.سيّد ناثانييل

63
00:05:00,010 --> 00:05:02,030
.لقد وجدنا رجلًا مريبًا

64
00:05:06,280 --> 00:05:07,940
.وجدناه على الدِعامة

65
00:05:07,940 --> 00:05:10,120
.حاول الفرار لذا قمنا بتقييده

66
00:05:10,890 --> 00:05:12,610
.لقد كان يحمل هذه

67
00:05:13,160 --> 00:05:16,160
.إنه مجرّد قاطع طريق من بلدٍ جزريّ

68
00:05:16,160 --> 00:05:19,000
،رأيتُ صورتك في تقرير

69
00:05:19,520 --> 00:05:21,820
.يا مفتعل تفجيرات مافيا الميناء

70
00:05:21,820 --> 00:05:25,760
من أنا؟ أين أنا؟

71
00:05:26,030 --> 00:05:30,220
،سمعتُ أنّك حاولتَ تفجير قطار
.لكنّ وكالة التحقيق أوقفتك

72
00:05:30,220 --> 00:05:31,550
!لقد كانت تجربة

73
00:05:31,550 --> 00:05:33,970
!كلّ فشلٍ عيّنة قيّمة

74
00:05:34,270 --> 00:05:36,350
أيجب أن أحوّله إلى مومياء؟

75
00:05:36,590 --> 00:05:40,020
.كلّا، أملكُ فكرةً جيّدة عن خطّة العدوّ

76
00:05:40,150 --> 00:05:43,380
.لقد كان مكلّفًا بزرع قنبلةٍ دون ريب

77
00:05:44,150 --> 00:05:45,990
.يا لها من منظّمة رديئة

78
00:05:49,350 --> 00:05:50,170
...دمه

79
00:05:50,170 --> 00:05:52,660
...الرسالة القرمزية هي كلام الرّب

80
00:05:53,010 --> 00:05:57,840
قدرة الحكم التي تعاقب الفاسقين
.وتُخلّف عليهم علامةً لا تتلاشى أبدًا

81
00:05:56,330 --> 00:05:57,840
!مـ- مهلًا

82
00:05:57,840 --> 00:06:00,540
!حـ- حسنًا، فهمت! أستسلم! سأخبركم بكلّ شيء

83
00:06:00,540 --> 00:06:03,590
...في الحقيقة، أنا السّفير الذي يُمثّل القائد العام للكون

84
00:06:03,820 --> 00:06:06,670
!وستقع في ورطةٍ كبيرة إن آذيتني

85
00:06:03,970 --> 00:06:06,670
.رويدكَ عليّ

86
00:06:09,710 --> 00:06:14,980
.يبدو أنّك تأبى أن تتوب وتُكفّر عن ذنوبك

87
00:06:16,050 --> 00:06:19,690
.هذه القنابل على هيئة ليمون هي قدرتك

88
00:06:19,690 --> 00:06:21,580
.يا للغباء

89
00:06:22,070 --> 00:06:24,820
.حتّى رجل عاديّ بإمكانه أن يصنع القنابل

90
00:06:24,820 --> 00:06:29,200
أظننت أنّك ستُغرق هذه السّفينة بهكذا قدرة؟

91
00:06:29,670 --> 00:06:32,030
.من الواضحّ أنّك استخفّيتَ بالنقابة

92
00:06:37,720 --> 00:06:39,750
.فلينعمك الرّب

93
00:06:41,100 --> 00:06:44,210
.سنشحن الإمدادات إلى السفينة الآن

94
00:06:46,560 --> 00:06:49,090
الرّب... الرّب؟

95
00:06:50,430 --> 00:06:53,550
أتقصد أنّك تسمع صوت الرّب؟

96
00:06:54,140 --> 00:06:59,560
العِلم هو اللّغة الوحيدة التي تخوّل لنا
.أن نفهم هذا الكون الذي خلقه الرّب

97
00:07:00,550 --> 00:07:02,020
لم يؤثّر به الانفجار؟

98
00:07:02,200 --> 00:07:04,770
.لدي أنباء سيّئة لكما

99
00:07:04,770 --> 00:07:08,000
،واجبكم هو الإيمان يا رجال الدّين

100
00:07:08,000 --> 00:07:11,110
.لكن أساس العِلم هو التشكيك في كلّ شيء

101
00:07:11,560 --> 00:07:16,560
.كان عليك أن تُشكّك أكثر في قدرة صنع القنابل هذه

102
00:07:16,560 --> 00:07:20,830
،صحيحٌ أنّي أصنع هذه القنابل في وقت فراغي

103
00:07:20,990 --> 00:07:25,790
لكنّ قدرتي الحقيقية هي ألّا أتكبّد أيّ
!أضرار من القنابل التي على هيئة ليمون

104
00:07:26,200 --> 00:07:29,520
الليمون! ذلك الشكل الجميل
،والمغزليّ هو الهندسة المطلقة

105
00:07:29,520 --> 00:07:31,380
!كما أنّه مدمّر هذا العالم الممل

106
00:07:31,630 --> 00:07:36,350
...وبهذه المناسبة، إليكما هديّةً من القائد الأعلى للكون ومنّي

107
00:07:39,270 --> 00:07:39,980
...لا يعقل

108
00:07:42,780 --> 00:07:44,610
!فليبتعد الجميع عن السفينة

109
00:08:03,290 --> 00:08:04,420
...السفينة

110
00:08:04,790 --> 00:08:06,620
!فقط من يكون ذلك الرّجل؟

111
00:08:06,620 --> 00:08:09,450
.يبدو أنّ رسالة التّهديد لم تكن مجرّد خدعة

112
00:08:11,690 --> 00:08:14,890
.وما يزال الهدفان باقيين

113
00:08:16,330 --> 00:08:18,820
.سيداهمنا العدوّ عمّا قريب

114
00:08:18,820 --> 00:08:20,860
.سنواجههم هنا

115
00:08:20,860 --> 00:08:22,370
،إن أوقفنا هجومهم المفاجئ

116
00:08:22,370 --> 00:08:26,960
.فلا أعداء موهوبون باستطاعتهم مقارعتنا مهما كان عددهم

117
00:08:27,650 --> 00:08:30,450
.هذا هو تفكير العدوّ على الأغلب...

118
00:08:31,580 --> 00:08:34,740
.الأعضاء الموهوبون للنقابة أقوياء بالفعل

119
00:08:34,740 --> 00:08:38,620
.حتّى نخبتنا سيواجهون صعوبة في الإطاحة بهم

120
00:08:40,250 --> 00:08:42,200
...ولهذا

121
00:08:44,450 --> 00:08:49,510
.لعبتُ توًّا أكثر قطعةٍ متلهّفة ومُحفَّزة لديّ

122
00:08:57,800 --> 00:09:00,100
.نسيم البحر خانق

123
00:09:15,140 --> 00:09:16,910
.فلننتهِ من هذا بسرعة

124
00:09:18,320 --> 00:09:20,530
هل أنت قاتلٌ بمافيا الميناء؟

125
00:09:20,770 --> 00:09:23,470
كيف حالك يا أخ النقابة؟

126
00:09:23,470 --> 00:09:24,810
.حالي فظيع

127
00:09:24,810 --> 00:09:28,570
.وكأنّي قابلتُ الشيطان المذكور في الإنجيل

128
00:09:29,250 --> 00:09:30,540
هلّا أخبرتني باسمك؟

129
00:09:32,320 --> 00:09:33,550
.ديابلو

130
00:09:32,320 --> 00:09:33,550
ديابلو = شيطان

131
00:09:34,870 --> 00:09:37,100
.إذًا لا بدّ أنّ هذا جبل حرمون

132
00:09:37,650 --> 00:09:41,560
هل أنتَ بلاءٌ مُرسلٌ من عِند الرّب
لاختبار إيمان هذا الخدم المتواضع؟

133
00:09:41,560 --> 00:09:43,520
أتريد بلاءً؟

134
00:09:43,520 --> 00:09:45,730
!سأُبليكَ إذًا

135
00:09:49,120 --> 00:09:51,520
".لا تناديني بـ"الأخ

136
00:09:51,760 --> 00:09:55,710
!أنا وزيرٌ ولستُ دِمنة من روما القديمة

137
00:09:55,710 --> 00:09:58,860
،إيّاك والظنّ أنّ هذا سيكون كافيًا لاختبار إيماني

138
00:09:58,860 --> 00:10:00,170
!أيها الحثالة

139
00:10:02,880 --> 00:10:05,660
!تُبْ يا عضو مافيا الميناء الصغير

140
00:10:05,660 --> 00:10:07,120
!مثير

141
00:10:11,830 --> 00:10:14,690
،لدى العدوّ قدرة متوسّطة المدى في التلاعب بالأشياء

142
00:10:14,690 --> 00:10:17,220
هجوميًّا ودفاعيًّا؟

143
00:10:17,530 --> 00:10:19,850
.إنها شبيهة بقدرتي

144
00:10:20,320 --> 00:10:21,600
...في تلك الحالة

145
00:10:23,100 --> 00:10:26,060
!صاحب القدرة الأكثر إمكانيّة هو من سيفوز

146
00:10:26,980 --> 00:10:28,110
!راشومون

147
00:10:30,640 --> 00:10:31,850
!الرسالة القرمزية

148
00:10:37,590 --> 00:10:39,760
أهذا كلّ ما لديك أيها الأخ؟

149
00:10:42,920 --> 00:10:46,620
.لستَ بشيطانٍ أبدًا

150
00:10:46,920 --> 00:10:47,740
ماذا؟

151
00:10:49,120 --> 00:10:51,830
الدم الخارج من معطفي يتحوّل إلى كتابة؟

152
00:10:53,050 --> 00:10:57,840
.لستَ سوى وحشٍ بلا روحٍ يتعطّش جسد الضّعيف

153
00:10:58,120 --> 00:11:03,340
أنا واثقٌ أنّك قاتلتَ فقط الأعضاء
.الموهوبين الأضعف منكَ حتّى الآن

154
00:11:06,450 --> 00:11:08,520
.مافيا الميناء لا تعدّ شيئًا

155
00:11:08,920 --> 00:11:11,770
!سأستعيد شرف عائلتي

156
00:11:15,820 --> 00:11:17,190
...الشارع يتداعى

157
00:11:17,570 --> 00:11:19,150
قدرة تَجوية؟

158
00:11:19,310 --> 00:11:23,250
،لا يمكن أن أخسر أمام أمثالك

159
00:11:23,250 --> 00:11:26,540
!الذي لم يعرف أبدًا معنى الهزيمة والإذلال

160
00:11:30,590 --> 00:11:33,820
أقلتِ لم أعرف الهزيمة؟

161
00:11:39,030 --> 00:11:40,170
!مارغاريت

162
00:11:41,010 --> 00:11:44,630
.الهزيمة والإذلال يرافقاني دومًا

163
00:11:50,500 --> 00:11:54,100
.أنا ضالٌ أسير في الظلام

164
00:11:54,360 --> 00:12:00,320
!لذا، لا يمكن لهكذا يأسٍ أن يهلكني

165
00:12:10,340 --> 00:12:12,160
...ليس الآن

166
00:12:12,520 --> 00:12:14,980
.هذا ليس جرحًا خلّفته الرسالة القرمزية

167
00:12:15,560 --> 00:12:19,140
أيعقّل أنّه... كان مصابًا ببلاغة عندما أتى إلى هنا؟

168
00:12:19,140 --> 00:12:21,080
!هذا لا يعدّ شيئًا! هلمّ إليّ

169
00:12:21,630 --> 00:12:24,060
.قاتلني بكلّ ما لديك

170
00:12:24,060 --> 00:12:28,470
!وإلّا لا طائل من قدومي إلى هنا

171
00:12:29,300 --> 00:12:31,910
ولمَ تراك تتمادى إلى هذا الحد؟

172
00:12:31,910 --> 00:12:35,090
.عزائي الوحيد هو كلمة واحدة

173
00:12:35,090 --> 00:12:38,440
...كلمة بسيطة وتافهة من شخصٍ مُعيّن

174
00:12:38,950 --> 00:12:41,390
،لأجل تلقّي تلك الكلمة منه

175
00:12:41,390 --> 00:12:46,240
!قد تجرّعتُ هزائمَ مُذّلة لا تُحصى

176
00:12:47,190 --> 00:12:50,580
،هذا الرّجل قاتلٌ وحشيّ من مافيا الميناء

177
00:12:51,220 --> 00:12:54,010
.إلّا أنّه في الوقت ذاته يتوق إلى شيءٍ ما بشدّة

178
00:12:54,620 --> 00:12:57,750
...شيءٌ يمكنه أن يضحي بحياته لأجله

179
00:12:57,750 --> 00:13:01,460
.وبحماسٍ يكاد ينافس الإيمان الدينيّ

180
00:13:03,270 --> 00:13:06,140
طلبتَ منّي أن أقاتل بكلّ ما تيسّر لي، صحيح؟

181
00:13:08,550 --> 00:13:13,060
.لقد غيّرتُ رأيي وسأُلبّي طلبك

182
00:13:18,700 --> 00:13:19,110
!ماذا؟

183
00:13:47,760 --> 00:13:49,080
...راشومون

184
00:13:49,700 --> 00:13:52,430
!أنياب الأبواب اللّا متناهية

185
00:14:05,430 --> 00:14:06,780
...مارغاريت

186
00:14:23,820 --> 00:14:27,550
يجب أن يسمع المرء أنّه جديرٌ بالحياة
.من شخصٍ آخر، وإلّا لن يستطيع الاستمرار

187
00:14:27,550 --> 00:14:30,590
!لمَ لا تفهم شيئًا بسيطًا كهذا؟

188
00:14:32,850 --> 00:14:34,890
...تلك الكلمات

189
00:14:35,300 --> 00:14:38,150
.لستَ بحاجةٍ لأن تخبرني بما أعلمه سلفًا

190
00:14:40,650 --> 00:14:42,860
!أشعر بالملل

191
00:14:42,860 --> 00:14:44,480
!أريد أن أخرج

192
00:14:44,970 --> 00:14:47,050
ألا يوجد شيءٌ غير مألوف في الصور؟

193
00:14:47,490 --> 00:14:49,990
.لا شيء يذكر

194
00:14:50,310 --> 00:14:55,650
الطريقة الوحيدة لدخول هذه القاعة هي
.بعبور نفق السكّة الحديديّة أسفل الأرض

195
00:14:56,610 --> 00:14:58,950
،حتّى لو حاول العدوّ الدخول

196
00:14:58,950 --> 00:15:03,290
.فستُطلعنا كاميرات المراقبة بذلك قبل وصولهم إلى هنا

197
00:15:03,290 --> 00:15:06,410
.كما أنّ الطريق محفوفٌ بالفخاخ

198
00:15:06,410 --> 00:15:08,770
.الحرب مملّة

199
00:15:10,080 --> 00:15:12,960
.احتياطي من المكسّرات قد نفد في نصف يوم

200
00:15:14,630 --> 00:15:15,660
!صحيح

201
00:15:15,660 --> 00:15:18,120
!يوسانو-سان، دعينا نلعب هانافودا بهذا

202
00:15:18,120 --> 00:15:19,980
بمَا سنراهن؟

203
00:15:22,180 --> 00:15:26,040
.الهجوم على قواعد العدوّ دائمًا ما يملأ قلبي بالبهجة

204
00:15:26,710 --> 00:15:29,920
.حان الوقت للقيام بالخطوة القادمة
كيف تسير الإعدادات؟

205
00:15:29,920 --> 00:15:31,280
.كلّ شيء جاهز

206
00:15:31,500 --> 00:15:35,740
.لديك قوّةٌ أكثر من كافية لتسحق وكالة التّحقيق المسلّحة

207
00:15:36,110 --> 00:15:38,730
.أتطلّع لسماعِ لحنٍ بديع

208
00:15:39,400 --> 00:15:40,690
ما الأمر؟

209
00:15:40,690 --> 00:15:43,450
.أيها الرّئيس، أظنّنا يجب أن نستدعي الفريق الدفاعيّ

210
00:15:44,530 --> 00:15:45,360
أهو العدوّ؟

211
00:15:46,280 --> 00:15:48,460
ما عدد المهاجِمين؟

212
00:15:51,930 --> 00:15:53,070
.واحد

213
00:16:03,940 --> 00:16:05,320
...مي-تشان

214
00:16:05,320 --> 00:16:10,610
سآتي إليك فور انتهاء هذه الفوضى، اتّفقنا؟

215
00:16:11,350 --> 00:16:13,020
!نـ- نـ- ناومي-تشان

216
00:16:13,020 --> 00:16:13,990
...هارونو-سان

217
00:16:13,990 --> 00:16:15,680
!كـ- كـ- كنت أعمل! حقًّا

218
00:16:15,680 --> 00:16:18,080
!نحن عمّال المكاتب جزءٌ من الشركة أيضًا

219
00:16:24,040 --> 00:16:27,280
انفجارٌ بالسّفينة السياحية بميناء يوكوهاما التجاري؟

220
00:16:28,120 --> 00:16:30,490
أليست هذه سفينة النقابة؟

221
00:16:31,130 --> 00:16:32,850
ما سبب الانفجار إذًا؟

222
00:16:33,580 --> 00:16:36,680
،لقد كان العدوّ الآخر
.الذي يحبّ التفجير

223
00:16:36,970 --> 00:16:39,560
...قد تكون الوكالة الهدف القادم

224
00:16:40,280 --> 00:16:42,300
...آمل أنّ أخي بخير

225
00:16:45,610 --> 00:16:47,300
.لا تقلقي يا ناومي-تشان

226
00:16:48,710 --> 00:16:51,200
!نعلم أنّ مي-تشان بخير في النهاية

227
00:16:51,200 --> 00:16:52,860
.انسي الأمر رجاءً

228
00:16:55,790 --> 00:16:58,510
.الكاميرا 3 و4 و8 قد توقّفت عن الإرسال

229
00:16:58,820 --> 00:17:00,350
!فعّلا الأبراج الآلية

230
00:17:12,880 --> 00:17:15,920
أترسلون هذه الدمى لاستقبال مبعوثٍ خاص؟

231
00:17:15,920 --> 00:17:17,680
.أنتم تفتقرون للموظّفين حقًّا لدرجة تدفعني للبكاء

232
00:17:18,030 --> 00:17:20,040
هلّا أرسلتم شيئًا حيًّا؟

233
00:17:21,020 --> 00:17:21,940
...أيها الرئيس

234
00:17:24,390 --> 00:17:26,690
هل لديك نفس رأيي؟

235
00:17:33,140 --> 00:17:34,360
...بربّكم

236
00:17:34,620 --> 00:17:36,570
فقط اثنان؟

237
00:17:36,570 --> 00:17:40,030
،إن لم تكن راضيًا على الاستقبال
.عُد عندما تحجز موعدًا

238
00:17:40,430 --> 00:17:44,410
أوتظنّين أنّ المافيا تحتاج إلى
موعدٍ لشنّ الجحيم في قاعدة العدوّ؟

239
00:17:44,680 --> 00:17:46,600
!لا أظنّ ذلك

240
00:17:46,600 --> 00:17:49,100
.إن أردتَ شنّ الجحيم فلتبادر

241
00:17:49,820 --> 00:17:52,340
.لكن هذا ليس سبب مجيئك

242
00:17:52,680 --> 00:17:53,550
هل أنا محق؟

243
00:17:54,530 --> 00:17:55,550
أنّى لك أن تعرف؟

244
00:17:55,750 --> 00:17:57,900
.إنّنا وكالة تحقيق كما تعلم

245
00:17:57,900 --> 00:18:01,940
ما فائدتنا إن لم نستطع معرفة نوايا موكّلنا من اللّمحة الأولى؟

246
00:18:03,090 --> 00:18:04,760
أين رئيسكم؟

247
00:18:04,760 --> 00:18:06,130
.هناك

248
00:18:08,770 --> 00:18:11,030
.هذه هديّة من زعيمي

249
00:18:12,670 --> 00:18:13,590
...إنهما

250
00:18:14,460 --> 00:18:16,130
عضوان بالنقابة؟

251
00:18:16,130 --> 00:18:18,110
.لقد أغويناهما بطُعم

252
00:18:18,110 --> 00:18:21,530
.الوقت والمكان الذي سيظهران به مكتوبٌ هنا

253
00:18:21,980 --> 00:18:24,160
لا تتاح لكم فرصٌ كثيرة كهذه، أليس كذلك؟

254
00:18:24,690 --> 00:18:27,630
!بإمكانكم النيل من تلك النقابة البغيضة

255
00:18:30,560 --> 00:18:35,250
...فرصة مداهمة أعضاء النقابة الموهوبين مغرية بالفعل

256
00:18:35,960 --> 00:18:39,210
.فهمت. هذا اقتراحٌ مثير

257
00:18:39,210 --> 00:18:40,230
أليس كذلك؟

258
00:18:40,230 --> 00:18:42,890
.لكن لديّ اقتراحٌ أفضل

259
00:18:42,890 --> 00:18:48,850
ما رأيك أن أُمزّق أطرافك وأجعلك تُقرّ بخططكم؟

260
00:18:49,100 --> 00:18:51,220
.يا لها من فكرة رائعة

261
00:18:52,180 --> 00:18:53,230
.فلتجرّبي

262
00:18:53,230 --> 00:18:54,230
!كينجي

263
00:18:54,230 --> 00:18:55,270
!مفهوم

264
00:19:00,790 --> 00:19:01,870
!جميل

265
00:19:02,460 --> 00:19:04,860
!احترس الآن

266
00:19:06,300 --> 00:19:09,210
!هكذا يجب أن يكون العمل تمامًا

267
00:19:15,650 --> 00:19:16,460
!ماذا؟

268
00:19:18,220 --> 00:19:20,000
...تلك القدرة

269
00:19:20,000 --> 00:19:22,720
أنتَ متحكّمُ الجاذبية، ناكاهارا تشويا، أليس كذلك؟

270
00:19:23,760 --> 00:19:25,930
...يا لدازاي اللّعين ذاك، لا بدّ أنّه أفشى بي

271
00:19:25,930 --> 00:19:28,930
!إنّه يقف بالمقلوب، إلّا أنّ قبّعته لم تقع

272
00:19:29,280 --> 00:19:31,350
.سكّان المدينة مدهشون حقًّا

273
00:19:37,820 --> 00:19:38,860
...والآن

274
00:19:39,950 --> 00:19:42,660
من يريد أن يقاوم الجاذبية؟

275
00:19:46,550 --> 00:19:49,080
.إليكَ جوابي أيها يا مبعوث مافيا الميناء الخاص

276
00:19:49,340 --> 00:19:50,460
ماذا؟

277
00:19:50,460 --> 00:19:52,830
،صحيحٌ أنّه لو هزمت مافيا الميناء النقابة

278
00:19:53,230 --> 00:19:56,070
.فستقلّصون قوّة العدوّ دون تحريك ساكن

279
00:19:56,900 --> 00:20:01,800
وإن حالفكم الحظّ أكثر، فقد تقضي
.وكالة التّحقيق والنقابة على بعضيهما

280
00:20:02,200 --> 00:20:04,780
.لكن لا شيء تخسره أيضًا

281
00:20:05,390 --> 00:20:06,180
صحيح؟

282
00:20:06,500 --> 00:20:08,670
.إن كان ما قلته صحيحًا فأجل

283
00:20:09,760 --> 00:20:10,950
...يا إلهي

284
00:20:10,950 --> 00:20:12,660
ما الذي تخفيه؟

285
00:20:12,660 --> 00:20:13,640
.لا شيء

286
00:20:14,070 --> 00:20:17,650
ما الخطوة التي ستتّخذها مافيا الميناء؟

287
00:20:18,350 --> 00:20:20,150
.ليسوا مضطرّين لاتّخاذ أيّة خطوة

288
00:20:22,940 --> 00:20:26,630
.فهمت. هذا ما يجري إذًا

289
00:20:27,700 --> 00:20:31,680
.لا بدّ أنّ النقابة شكّت في فخ، مثلنا تمامًا

290
00:20:32,210 --> 00:20:34,630
.لكنّهم وقعوا فيه

291
00:20:35,080 --> 00:20:38,090
.لأنّ الطُعم كان شهيًّا جدًّا

292
00:20:38,620 --> 00:20:40,700
ماذا استخدمتم لإغواء النقابة؟

293
00:20:43,030 --> 00:20:47,090
،في أيّ بلاد كنت
.فإنّ الرّيف يُهدّئ الرّوح

294
00:20:47,670 --> 00:20:51,460
.إذًا، هديّة مافيا الميناء أمامنا

295
00:20:51,460 --> 00:20:56,110
.من الواضح أنّ هذا فخًّا لاستدراجنا
فلمَ علينا أن نذهب؟

296
00:20:56,530 --> 00:20:58,940
.لأنّ الطعم شهيٌّ جدًّا

297
00:20:59,330 --> 00:21:00,820
،إن أفلحنا في الخطف

298
00:21:00,820 --> 00:21:03,950
.فسنهزم وكالة التّحقيق أساسًا

299
00:21:03,950 --> 00:21:05,910
!هل استخدمتم عمّال المكاتب الخاصين بنا كطعم؟

300
00:21:05,910 --> 00:21:08,670
.ما زال لديكم الوقت لإخراجهما من هناك

301
00:21:08,670 --> 00:21:12,290
.كما أنّ النقابة لا تملك أيّ فكرة أنّكم ستبادرون

302
00:21:12,620 --> 00:21:13,910
.سيكون فوزًا سهلًا

303
00:21:14,490 --> 00:21:16,710
أيوجد كذبٌ فيما قاله؟

304
00:21:17,220 --> 00:21:19,630
.للأسف لا

305
00:21:21,280 --> 00:21:24,340
.الحقيقة أكثر تأثيرًا في مثل هذه الأوقات

306
00:21:27,500 --> 00:21:31,720
،حتّى لو علموا أنّها تهلكة"
".فسيوقعون أنفسهم بها مع ذلك"

307
00:21:32,860 --> 00:21:34,690
.هذه كلمات زعيمي

308
00:21:35,150 --> 00:21:37,890
.فلتأمر بأمر عمال المكاتب بالإخلاء الفوري

309
00:21:38,960 --> 00:21:39,880
...و

310
00:21:41,900 --> 00:21:43,470
.أوصلني بكونيكيدا

311
00:23:16,100 --> 00:23:18,080
وحدنا من نستطيع الوصول إليهما في الوقت المناسب؟

312
00:23:19,890 --> 00:23:20,670
...حسنًا

313
00:23:21,350 --> 00:23:23,540
.حاضر. سنتوجّه إلى هناك على الفور

314
00:23:28,470 --> 00:23:29,830
الرّئيس؟

315
00:23:30,290 --> 00:23:31,090
.أجل

316
00:23:32,690 --> 00:23:33,550
ماذا قال؟

317
00:23:36,800 --> 00:23:38,440
.سنواجه النقابة وجهًا لوجه