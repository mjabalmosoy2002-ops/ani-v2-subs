1
00:00:04,560 --> 00:00:06,360
...كانت تمطر

2
00:00:04,650 --> 00:00:07,940
...تمطر نتكا

3
00:00:09,690 --> 00:00:12,650
.لا تنفكّ عن قراءة ذلك الكتاب يا فتى

4
00:00:13,900 --> 00:00:15,870
أهو مشوّقٌ إلى هذا الحدّ؟

5
00:00:16,490 --> 00:00:17,660
.إنّه شيّق

6
00:00:17,660 --> 00:00:19,450
.قرأتُه عدّة مرّات

7
00:00:20,490 --> 00:00:25,210
هذا العالم يحوي قصصًا أكثر
.تشويقًا ممّا في ذلك الكتاب

8
00:00:25,920 --> 00:00:28,380
أين الجزء الثّالث من ذلك الكتاب؟

9
00:00:29,550 --> 00:00:31,090
.لا أملك الجزء الثّالث

10
00:00:31,590 --> 00:00:33,720
.بحثتُ مليًا لكنّي لم أجده

11
00:00:33,720 --> 00:00:35,930
.كلّ شيءٍ يبدو منطقيًا الآن

12
00:00:36,640 --> 00:00:40,310
.الجزء الثّالث من تلك الرّواية ينتهي بمأساة

13
00:00:40,850 --> 00:00:43,770
.فلترضَ بالجزأين الأوّلين

14
00:00:44,190 --> 00:00:46,270
.أقول هذا لمصلحتك

15
00:00:46,810 --> 00:00:48,360
.أخشى أنّي لا أستطيع فعل ذلك

16
00:00:48,360 --> 00:00:50,610
.إذًا فلتكتبه بنفسك

17
00:00:52,230 --> 00:00:53,820
أكتبه بنفسي؟

18
00:00:53,820 --> 00:00:58,820
.إنّها الطّريقة الوحيدة لإبقاء تلك الرّواية متكاملة

19
00:00:59,530 --> 00:01:03,160
،أن تكتب قصّةً يعني أن تكتب عن شخصٍ ما

20
00:01:03,160 --> 00:01:07,040
.وكيف ينبغي أن يعيش ذلك الشّخص ويموت

21
00:01:07,710 --> 00:01:11,130
.وحسب ما رأيته، فأنت تملك المؤهّلات

22
00:01:11,670 --> 00:01:14,050
من عساك تكون؟

23
00:01:14,510 --> 00:01:15,340
أنا؟

24
00:01:17,380 --> 00:01:19,050
...اسمي

25
00:01:27,600 --> 00:01:29,860
هل استيقظتَ يا أوداساكو؟

26
00:01:31,400 --> 00:01:32,650
كيف تشعر؟

27
00:01:33,230 --> 00:01:38,320
أشعر وكأنّي أختبر صداع ما كنت سأشرب من الخمر
.طيلة الخمسين سنةً القادمة في آنٍ واحد

28
00:01:39,950 --> 00:01:43,240
.وجدتُ أنغو في المكان الّذي أخبرتني عنه

29
00:01:43,700 --> 00:01:46,540
.إذًا فقد كان هناك، كما شككت

30
00:01:47,330 --> 00:01:48,080
.أجل

31
00:01:49,460 --> 00:01:53,250
.ثمّ اختفى في الظّلام رفقة جنودٍ ببذلٍ سوداء

32
00:01:54,880 --> 00:01:58,680
.لابدّ أنهم فرقة العمليّات السّوداء الخاصّة

33
00:02:00,010 --> 00:02:04,060
الأحداث الأخيرة يمكن تقسيما
.إلى فئتين على ما يبدو

34
00:02:04,060 --> 00:02:06,980
أهم منظّمةٌ منفصلةٌ عن ميميك؟

35
00:02:06,980 --> 00:02:08,230
.إنّهم مختلفون

36
00:02:08,230 --> 00:02:12,770
لكن بوسعنا أن نتجاهل جنود فرقة العمليّات
.السّوداء الخاصّة في الوقت الحاضر

37
00:02:12,770 --> 00:02:15,280
.ميميك هي العدوّ الأخطر بلا شك

38
00:02:15,280 --> 00:02:22,490
أكوتاغاوا-كُن وبقية أعضاء فرقة القتال
.يتعاملون مع بعض النّزاعات في المدينة

39
00:02:23,120 --> 00:02:27,290
.لكنّنا نجهل حتّى قدرة قائد العدوّ

40
00:02:27,290 --> 00:02:28,540
.الوضع ليس في صالحنا

41
00:02:28,910 --> 00:02:33,420
أكوتاغاوا ذاك أحد أتباعك، أليس كذلك؟

42
00:02:33,420 --> 00:02:37,010
.سمعتُ أنّ لقدرته إمكانيّاتٍ هجوميّة عالية

43
00:02:37,380 --> 00:02:39,760
.إنّه مجرّد سيفٍ مكشوفٍ لا غمد له

44
00:02:39,760 --> 00:02:43,390
واثقٌ من أنّه سيصبح عضو المافيا ذو
...القدرة الأقوى في المستقبل القريب، ولكن

45
00:02:43,760 --> 00:02:47,470
.حاليًا، يحتاج لمن يعلّمه كيف يُغمِدُ سيفه

46
00:02:48,520 --> 00:02:49,850
.خرجنا عن سياق موضوعنا

47
00:02:50,690 --> 00:02:53,270
عُقدَ هذا الصّباح مجلس
.الأعضاء التّنفيذيّين الخمسة الكبار

48
00:02:53,270 --> 00:02:58,650
وقرّروا الهجوم على ميميك
.بكلّ ما تملكه مافيا الميناء

49
00:02:58,650 --> 00:03:03,490
للتّو شُنّ هجومٌ مباغث على
.أتباعي ومن بينهم أكوتاغاو-كُن

50
00:03:03,490 --> 00:03:05,200
.ما زالوا يقاتلون في متحف الفنون

51
00:03:06,370 --> 00:03:07,410
أوداساكو؟

52
00:03:07,830 --> 00:03:09,210
أيعقل أنّك ستذهب؟

53
00:03:09,910 --> 00:03:12,460
سنهاجمهم بكلّ ما أوتينا، صحيح؟

54
00:03:12,830 --> 00:03:17,460
.لم أتوقّعك مهتمًا بالنّزاع بما أنّك تتحاشى القتل

55
00:03:17,800 --> 00:03:18,340
.لستُ مهتمًا

56
00:03:19,300 --> 00:03:20,510
وما السّبب إذًا؟

57
00:03:21,880 --> 00:03:24,180
.لأنّ حياتي مثقلةٌ بالدّيون

58
00:03:25,180 --> 00:03:28,470
،وإن كان أتباعك في موقفٍ حرج
.فهم بحاجةٍ للمساعدة

59
00:03:32,850 --> 00:03:35,270
.يجدر بك نسيان ديونك

60
00:03:35,690 --> 00:03:42,450
الحلقة الخامسة عشرة
يومًا ما في غرفة
تطل على المحيط

61
00:03:36,320 --> 00:03:41,900
.فلا أحد يذكر ما تدينه لهم

62
00:04:00,210 --> 00:04:02,260
.المسدّسات أسلحة الحمقى

63
00:04:09,680 --> 00:04:11,730
.يا لضعفكم

64
00:04:11,730 --> 00:04:12,940
...إذًا فأنت من يتحدّثون عنه

65
00:04:13,560 --> 00:04:16,150
.صاحب القدرة ذو الرّداء الأسود

66
00:04:16,150 --> 00:04:17,520
من أنت؟

67
00:04:21,400 --> 00:04:23,200
.اسمي جيد

68
00:04:23,650 --> 00:04:25,570
.قائد ميميك

69
00:04:25,910 --> 00:04:30,620
ما كان ليعترف بي مهما بلغ
.عدد الأتباع الّذين أهزمهم

70
00:04:31,330 --> 00:04:33,120
.أودّ أن أتحدّاك

71
00:04:33,120 --> 00:04:34,670
.أريد طرح سؤالٍ عليك

72
00:04:35,040 --> 00:04:41,050
هل قدرتك كفيلةٌ بتحرير
أرواحنا من الخطيئة الأصليّة؟

73
00:04:41,050 --> 00:04:42,550
!أتريد أن تتبيّن ذلك؟

74
00:04:45,590 --> 00:04:46,300
!لن تفلت منّي

75
00:04:50,350 --> 00:04:51,850
.يبدو أنّك لست الشّخص المنشود

76
00:04:57,860 --> 00:04:58,610
!محال

77
00:04:58,980 --> 00:05:00,770
!أهذه قدرة؟

78
00:05:00,770 --> 00:05:01,610
!أيّها الوغد

79
00:05:02,070 --> 00:05:04,400
!أتستطيع توقّع حركاتي؟

80
00:05:22,380 --> 00:05:24,170
،بعد بضع سنواتٍ أخرى

81
00:05:24,550 --> 00:05:29,010
ربّما كنتَ لتصبح أكثر قوّةً
.بما يكفي لتُحقّق أمنيّتنا

82
00:05:29,760 --> 00:05:31,100
.لكن لا يمكننا أن ننتظر

83
00:05:31,100 --> 00:05:32,560
!أُقتلني

84
00:05:32,560 --> 00:05:34,680
.الموت جزاء الهزيمة

85
00:05:35,350 --> 00:05:39,440
آسفٌ لأنّي لم أستطع أن
.أكون العدوّ الّذي ابتغيتَه

86
00:05:40,150 --> 00:05:41,360
.الوداع

87
00:05:53,790 --> 00:05:55,160
هل أُصبت بطلقةٍ في ساقك؟

88
00:05:55,620 --> 00:05:56,750
!مهلًا

89
00:05:56,750 --> 00:05:58,210
!ماذا تظنّ نفسك فاعلًا؟

90
00:05:59,040 --> 00:06:00,130
!أنزلني

91
00:06:00,130 --> 00:06:01,170
!أنزلني أرضًا

92
00:06:02,210 --> 00:06:03,800
.أنا أودا ساكونوسكي

93
00:06:04,210 --> 00:06:06,760
.حدّثني عنك دازاي وأتيتُ للمساعدة

94
00:06:18,890 --> 00:06:21,650
.سمعتُ عنك من دازاي-سان

95
00:06:22,400 --> 00:06:24,730
.أنت أحد الأعضاء الأدنى مرتبة

96
00:06:24,730 --> 00:06:25,980
.هذا صحيح

97
00:06:26,400 --> 00:06:29,320
.وسمعتُ أيضًا أنّك صديقٌ له

98
00:06:29,950 --> 00:06:31,120
أهذا صحيح؟

99
00:06:31,990 --> 00:06:35,990
لديّ مبدأٌ يمنعني من استخدام
.تلك الكلمة باستخفاف

100
00:06:36,830 --> 00:06:38,330
...قال دازاي-سان

101
00:06:39,250 --> 00:06:42,670
.أنّي لن أكون نِدًا لك، ولا حتّى بعد مئة عام

102
00:06:42,670 --> 00:06:44,750
هذا ليس الوقت المناسب
.لنشوب شجارٍ بين زميلين

103
00:06:45,210 --> 00:06:46,380
!لماذا؟

104
00:06:47,420 --> 00:06:49,880
...لِم هو بالذّات يا دازاي-سان

105
00:06:52,550 --> 00:06:53,220
!أنت أيضًا؟

106
00:06:55,010 --> 00:06:55,970
.آسف

107
00:06:56,520 --> 00:06:58,980
،يجب أن أعيدك بأيّ ثمن

108
00:06:59,440 --> 00:07:01,730
.لا سيّما لأجل صديقٍ يحمل آمالًا كبيرة تجاهك

109
00:07:06,110 --> 00:07:07,610
.راودني هاجس

110
00:07:08,070 --> 00:07:09,360
عمّ تتحدّث؟

111
00:07:09,990 --> 00:07:14,370
راودني هاجسٌ أنّي سأجد الشّخص صاحب
.القدرة الّذي أبحث عنه في هذه البلاد

112
00:07:14,780 --> 00:07:15,950
.أنا جيد

113
00:07:16,660 --> 00:07:20,710
أتيتُ إلى هنا باحثًا عمّن يستطيع
.تحرير أرواح أشباحٍ أمثالنا

114
00:07:20,710 --> 00:07:25,170
بوسعي أن أحصل لك على خصمٍ
.من حفّار قبور أعرفه إن رغبت بذلك

115
00:07:25,630 --> 00:07:27,050
.لا داعي لذلك

116
00:07:27,590 --> 00:07:29,550
.فقد وجدت ضالّتنا

117
00:07:41,890 --> 00:07:42,770
ماذا؟

118
00:07:44,100 --> 00:07:45,400
ما الخطب؟

119
00:07:45,770 --> 00:07:48,440
.لم أطلق أيّ رصاصة بعد

120
00:07:48,440 --> 00:07:49,860
!ما الّذي فعلته؟

121
00:07:49,860 --> 00:07:54,530
أبصرتُ للتّو مستقبلًا حيث
.تتفادى الطّلقة إلى اليمين

122
00:07:54,530 --> 00:07:57,450
.وبالتّالي، عدّلتُ على تصويبي

123
00:07:57,450 --> 00:08:01,290
.لكنّك أبصرتَ ذلك المستقبل وعدّلت مسارك أيضًا

124
00:08:01,870 --> 00:08:04,250
.والّذي رأيته بدوري

125
00:08:04,250 --> 00:08:08,170
القدرة على رؤية بضع ثوانٍ إلى
.المستقبل متى كنت في خطر

126
00:08:08,170 --> 00:08:11,800
.أنا أيضًا أستطيع فعل ما تفعله

127
00:08:12,510 --> 00:08:16,090
.قدرة التنبّأ الّتي نمتلكها لا نظير لها

128
00:08:16,090 --> 00:08:20,640
أنت الوحيد الّذي يستطيع
.قتلي وإنهاء هذه الحرب

129
00:08:21,230 --> 00:08:23,890
،إن كنتَ من رجال المافيا

130
00:08:23,890 --> 00:08:27,060
فلا بدّ أنّ قتلي أنا قائد العدوّ
.سيكون أعظم رغباتك

131
00:08:27,860 --> 00:08:29,020
.أرفض

132
00:08:29,400 --> 00:08:31,990
.أنا هنا فقط لأساعد أحد رفاقي

133
00:08:32,360 --> 00:08:32,990
ماذا؟

134
00:08:33,650 --> 00:08:35,740
ألستَ أحد رجال المافيا؟

135
00:08:36,070 --> 00:08:38,030
.ثمّة أصنافٌ مختلفةٌ في رجال المافيا

136
00:08:38,030 --> 00:08:40,700
!المسدّسات أدواتٌ لغرض القتل

137
00:08:40,700 --> 00:08:43,000
!وهذه ساحة حرب

138
00:08:43,000 --> 00:08:45,290
.لستُ مهتمًا بالقتال

139
00:08:46,420 --> 00:08:50,250
.ما أنا مهتمٌّ به... هو العيش

140
00:08:50,250 --> 00:08:53,050
!ما من شيءٍ أهمّ من الموت في هذه الحياة

141
00:09:10,520 --> 00:09:13,110
.أجل، هكذا ينبغي أن يكون الأمر

142
00:09:13,940 --> 00:09:14,610
!ماذا؟

143
00:09:17,740 --> 00:09:20,780
إذًا فلا نيّة لديك لقتالي؟

144
00:09:21,160 --> 00:09:24,000
.ثمّة سببٌ يمنعني من القتل

145
00:09:24,000 --> 00:09:25,410
.ابحث في مكانٍ آخر

146
00:09:25,410 --> 00:09:26,420
!لماذا؟

147
00:09:27,960 --> 00:09:31,460
،أنا وأتباعي كنّا نهوم في العالم كالأشباح

148
00:09:32,090 --> 00:09:34,760
.باحثين عن مكانٍ يليق بأن نرقد فيه

149
00:09:35,220 --> 00:09:37,680
.أنت أملنا الوحيد

150
00:09:38,470 --> 00:09:39,850
!واجهني

151
00:09:39,850 --> 00:09:41,010
—وإن رفضت

152
00:09:41,010 --> 00:09:43,430
السّبب الّذي يمنعني من تحقيق رغبتك

153
00:09:43,430 --> 00:09:45,180
.هو لأنّ لديّ حلمًا

154
00:09:46,100 --> 00:09:51,060
يومًا ما عندما أستطيع ترك مافيا
،الميناء وأصبح حرًا لفعل ما أشاء

155
00:09:51,820 --> 00:09:55,780
أريد أن أجلس على مكتبٍ في
...غرفةٍ حيث أستطيع تأمّل البحر

156
00:09:57,950 --> 00:10:00,160
.إذًا فلتكتبه بنفسك

157
00:10:00,160 --> 00:10:04,580
.إنّها الطّريقة الوحيدة لإبقاء تلك الرّواية متكاملة

158
00:10:06,120 --> 00:10:08,210
.أريد أن أصبح كاتبًا

159
00:10:08,920 --> 00:10:12,500
،أريد أن أضع المسدّس جانبًا
.وأن أحمل ورقةً وقلمًا فحسب

160
00:10:13,920 --> 00:10:19,050
أخبرني أحدهم أنّ كتابة قصّة
.يعني الكتابة عن شخصٍ ما

161
00:10:19,800 --> 00:10:23,350
رجلٌ يسلب حياة الآخرين
.لا يسعه أن يكتب عن الحياة

162
00:10:23,970 --> 00:10:26,220
.لهذا لا ألجأ للقتل

163
00:10:26,930 --> 00:10:30,940
ألهذا السّبب ترفض الدّخول إلى ساحة معركتنا؟

164
00:10:31,310 --> 00:10:33,360
أهذا هو جوابك؟

165
00:10:34,900 --> 00:10:35,730
.هذا صحيح

166
00:10:53,290 --> 00:10:54,130
!توقّف

167
00:10:54,130 --> 00:10:56,210
سترةٌ واقيةٌ من الرّصاص؟

168
00:10:57,050 --> 00:10:59,550
.ذلك الألم نعمةٌ يحظى بها الأحياء

169
00:11:00,220 --> 00:11:02,840
.إنّه شيءٌ فقدناه قبل وقتٍ طويل

170
00:11:03,510 --> 00:11:05,720
.نحن أمواتٌ بالفعل

171
00:11:06,310 --> 00:11:10,640
.نحن مجرّد قشورٍ عديمة الرّوح تتحكّم بها الأشباح

172
00:11:11,480 --> 00:11:13,150
!لستَ ميّتًا

173
00:11:13,650 --> 00:11:16,150
،لا أدري ما حدث لك في الماضي

174
00:11:16,150 --> 00:11:19,780
.لكن ما زال بإمكانك أن تقرّر طريقة موتك

175
00:11:19,780 --> 00:11:21,070
!لِم لا تفهم؟

176
00:11:21,490 --> 00:11:23,240
...أنت الوحيد

177
00:11:27,700 --> 00:11:30,160
.لن تقتلني

178
00:11:30,160 --> 00:11:32,920
.لأنّك لا تستوعب رغبتي

179
00:11:33,540 --> 00:11:36,710
،وأنا لن أقتلك الآن أيضًا

180
00:11:36,710 --> 00:11:41,090
لأنّك الوحيد الّذي بوسعه
.أن يرشدنا إلى ميدان التّطهير

181
00:11:41,800 --> 00:11:45,390
.سأجعلك تدرك طبيعتنا الحقيقيّة

182
00:11:46,390 --> 00:11:48,390
.وحينها ستفهم

183
00:11:48,850 --> 00:11:52,640
.أنّ واحدًا منّا سيتحتّم عليه الموت

184
00:11:54,060 --> 00:11:56,150
.فلتتطلّع لذلك

185
00:12:08,870 --> 00:12:12,080
كلاب الأدب الشاردة

186
00:13:26,740 --> 00:13:28,030
.اللّيل وقتٌ جيّد

187
00:13:28,530 --> 00:13:30,200
.إنّه وقتٌ يخصّ المافيا

188
00:13:30,950 --> 00:13:32,370
ما العمل الآن؟

189
00:13:32,910 --> 00:13:34,960
.أتساءل

190
00:13:34,960 --> 00:13:37,420
.لكنّك غير محظوظٍ بالفعل

191
00:13:37,870 --> 00:13:42,300
من كان يتوقّع أنّ قائد الأعداء الّذي
التقيتَ به سيتحوّل إلى ملتمسٍ جادّ؟

192
00:13:42,300 --> 00:13:48,010
إنّهم غريبوا أطوارٍ يبحثون عن افتعال حرب
.لِيجدوا لأنفسهم مكانًا يليق بأن يرقدوا فيه

193
00:13:48,010 --> 00:13:49,220
حقًا؟

194
00:13:49,220 --> 00:13:53,970
رغبتهم بأنْ يُبدعوا في موتهم
.ليس بالشّيء الّذي فكّرتُ به

195
00:13:55,230 --> 00:13:57,350
إلى متى سيستمرّ هذا النّزاع؟

196
00:13:57,690 --> 00:14:02,360
،بغضّ النّظر عن جنود ميميك
.فإنّ قدرة قائدهم مزعجة

197
00:14:02,360 --> 00:14:04,070
.الهجمات المفاجئة لن تنفع

198
00:14:04,650 --> 00:14:07,320
.ممّا يعني أنّنا بحاجةٍ إلى معلوماتٍ داخليّة

199
00:14:07,780 --> 00:14:09,530
ألديك أيّ طرقٍ للحصول عليها؟

200
00:14:10,990 --> 00:14:12,490
.أنغو لا سواه

201
00:14:12,910 --> 00:14:14,700
.أوافقك الرّأي

202
00:14:15,160 --> 00:14:17,790
.أتساءل ما إن كانت هناك طريقةٌ للعثور على أنغو

203
00:14:18,580 --> 00:14:19,250
.هناك طريقة

204
00:14:19,790 --> 00:14:20,750
حقًا؟

205
00:14:22,500 --> 00:14:24,630
،لأكون أكثر دقّة

206
00:14:24,630 --> 00:14:26,880
.لا داعي للبحث عنه

207
00:14:28,090 --> 00:14:29,380
هنا؟

208
00:14:30,930 --> 00:14:32,220
وأين عدا هنا؟

209
00:14:39,900 --> 00:14:40,940
.مرحبًا

210
00:14:41,400 --> 00:14:42,810
.بدأتُ الشّرب قبلكما

211
00:14:47,070 --> 00:14:49,950
ألم يكن بوسعك أن تتّصل؟

212
00:14:50,360 --> 00:14:52,820
.واجهتُ وقتًا عصيبًا لأتخلّص ممّن يلاحقني

213
00:14:53,410 --> 00:14:55,410
.لكن لا بأس اليوم

214
00:14:55,410 --> 00:14:57,040
.يمكننا الشّرب على مهلنا

215
00:14:58,040 --> 00:15:00,920
إذًا، كيف عرفتما أنّكما ستجداني هنا؟

216
00:15:01,580 --> 00:15:03,960
.مجرّد حدس، على ما أظن

217
00:15:05,630 --> 00:15:07,090
.أنا محظوظ

218
00:15:07,880 --> 00:15:10,800
.لم أتوقّع أنّي سأحظى بشرابٍ هنا مجدّدًا

219
00:15:11,130 --> 00:15:15,680
ألست عاطفيًا جدًا على كونك جاسوسًا؟

220
00:15:16,720 --> 00:15:20,770
كانت لديك هويّةٌ أخرى حتّى
.قبل أن تنضمّ إلى مافيا الميناء

221
00:15:21,350 --> 00:15:23,060
.وهي كعميلٍ في المخابرات الوطنيّة

222
00:15:23,400 --> 00:15:27,030
كنتَ عميلًا لقسم العمليّات الخاصّة
.لذوي القدرات بوزارة الشّؤون الدّاخليّة

223
00:15:27,650 --> 00:15:30,490
.كانت مهمّتك تقتضي مراقبة مافيا الميناء

224
00:15:30,820 --> 00:15:34,700
مع أنّ القسم هيئةٌ سرّية تُشرف على
،جميع أصحاب القدرات في الدّولة

225
00:15:34,700 --> 00:15:36,990
إلّا أنّه في حال اندلاع حربٍ
،شاملة مع مافيا الميناء

226
00:15:36,990 --> 00:15:38,330
.فسيتكبّد القسم خسائر كبيرة

227
00:15:38,870 --> 00:15:42,750
هدف القسم الرئيسيّ هو
،الإشراف على ذوي القدرات

228
00:15:42,750 --> 00:15:44,330
.وليس إبادتهم

229
00:15:45,000 --> 00:15:50,510
لهذا كلّفوا عميلًا للتسلّل إلى
.مافيا الميناء ومراقبة تحرّكاتهم

230
00:15:50,510 --> 00:15:52,220
...وحينها

231
00:15:52,220 --> 00:15:54,800
.طرأت مسألة ميميك

232
00:15:55,890 --> 00:15:59,810
كانت المنظّمة الإجراميّة لذوي القدرات
.تخطّط للدّخول إلى اليابان

233
00:15:59,810 --> 00:16:02,520
.لقد شكّلوا صُداعًا للقسم

234
00:16:03,100 --> 00:16:09,480
لذا فقد قرّر القسم أن يكلّفك بمراقبة
.ميميك كجسوسٍ لمافيا الميناء

235
00:16:09,940 --> 00:16:14,820
كموظّف حكومي فقد كان
.عملًا شاقًا ذو راتبٍ متواضع

236
00:16:16,030 --> 00:16:17,200
،إذًا، بعبارةٍ أخرى

237
00:16:17,200 --> 00:16:22,580
.أنغو لم يكن عاميلًا مزدوجًا بل عميلًا ثلاثيًا

238
00:16:27,920 --> 00:16:30,090
.حدّثنا عن ميميك

239
00:16:30,630 --> 00:16:34,760
تلقّيتُ معلوماتٍ تفيد بأنّ جيد
.وأوداساكو-سان قد تواجها

240
00:16:35,590 --> 00:16:37,800
هل رأيت قدرة جيد؟

241
00:16:37,800 --> 00:16:39,010
.أجل

242
00:16:39,010 --> 00:16:42,600
.جيد متملّص، ولم نتمكّن من تحديد مكانه قبلًا

243
00:16:43,310 --> 00:16:47,360
.يعتزم القسم ترك مافيا الميناء لتتكفّل بهذه القضيّة

244
00:16:47,360 --> 00:16:50,440
.سيكون ذلك مريحًا جدًا بالنّسبة لهم

245
00:16:51,070 --> 00:16:56,360
لكن حتّى مافيا الميناء سيصعب
.عليها التّعامل مع تلك القدرة

246
00:16:56,990 --> 00:16:57,910
،وبالطّبع

247
00:16:58,320 --> 00:17:02,370
هذا إن لم نأخذ بالاعتبار عضوًا
.معيّنًا ذو أدنى رتبةٍ في المنظّمة

248
00:17:02,370 --> 00:17:08,710
.قدرتانا تخوّلنا فقط رؤية بضع ثوانٍ إلى المستقبل

249
00:17:09,290 --> 00:17:14,130
إن حان وقت الحسم، فستعتمد النّتيجة
.على مهاراتنا في القتال وإطلاق النّار

250
00:17:14,550 --> 00:17:16,720
.المتغيّرات الغير معروفة ستكون ذات أهمية بالغة

251
00:17:17,430 --> 00:17:19,970
".ويجب الأخذ في الاعتبار "فَرديّة القدرة

252
00:17:20,510 --> 00:17:22,640
فرديّة القدرة؟

253
00:17:23,060 --> 00:17:28,270
ألم يحدث شيءٌ غير اعتياديّ
عندما استخدمتَ قدرتك ضدّ جيد؟

254
00:17:40,490 --> 00:17:42,040
.بلى

255
00:17:42,490 --> 00:17:45,160
،عندما تتداخل بعض القدرات مع بعضها البعض

256
00:17:45,160 --> 00:17:51,670
فقد تخرج عن السّيطرة بشكلٍ
.غير متوقّع في حالاتٍ نادرة

257
00:17:51,670 --> 00:17:54,550
.وقد تحقّقت الحكومة من هذه الظّاهرة

258
00:17:55,380 --> 00:17:59,550
.لم يكن يفترض بي أن أخبركما بهذا

259
00:18:00,600 --> 00:18:05,850
سأقع في ورطةٍ كبيرة
.إن علم القسم أنّي أقابلكما

260
00:18:06,390 --> 00:18:08,650
.يجب أن أتخفّى في الوقت الحاليّ

261
00:18:08,650 --> 00:18:09,810
...عجبًا

262
00:18:10,360 --> 00:18:14,530
.تتحدّث كما لو أنّك ستغادر هذا المكان حيًا

263
00:18:14,530 --> 00:18:16,820
أتنوي جعل هذا المكان ساحة معركة؟

264
00:18:17,990 --> 00:18:19,490
.هذه غلطتي

265
00:18:21,410 --> 00:18:22,990
.كنتُ مخطئًا

266
00:18:23,660 --> 00:18:29,500
اعتقدت بأنانيّة أنّ بإمكاني
.مقابلتكما هنا دون اعتبارٍ لموقفي

267
00:18:30,040 --> 00:18:31,000
.أنغو

268
00:18:32,210 --> 00:18:34,920
.اذهب قبل أن أغيّر رأيي

269
00:18:36,300 --> 00:18:38,340
.لستُ حزينًا

270
00:18:39,010 --> 00:18:41,010
.علمتُ هذا منذ البداية

271
00:18:41,890 --> 00:18:44,430
،سواءً أكنتَ مع قسم العمليّات الخاصّة أم لا

272
00:18:44,430 --> 00:18:47,350
.دائمًا ما أفقد ما لا أريد فقدانه

273
00:18:48,520 --> 00:18:50,690
،مقدّرٌ أنّ كلّ ما يستحقّ أن أرغب به

274
00:18:51,100 --> 00:18:54,360
.سأخسره لحظة امتلاكه

275
00:18:56,280 --> 00:19:01,240
لا شيء يستحقّ السّعي لأجله
.على حساب إطالة حياةٍ من المعاناة

276
00:19:08,200 --> 00:19:10,920
...دازاي-كُن، أوداساكو-سان

277
00:19:11,670 --> 00:19:15,710
إن كان ليحلّ زمنٌ لا وجود
للقسم فيه ولا لمافيا الميناء

278
00:19:16,460 --> 00:19:19,170
،وأصبحنا جميعًا أحرارًا

279
00:19:19,550 --> 00:19:20,220
—فلنعد إلى هنا و

280
00:19:20,220 --> 00:19:22,140
.لا تقلها يا أنغو

281
00:19:24,640 --> 00:19:26,220
.لا تتفوّه بالمزيد

282
00:20:26,910 --> 00:20:27,870
!ماذا؟

283
00:20:29,370 --> 00:20:30,620
!أيّها العمّ

284
00:20:35,040 --> 00:20:36,420
!كوسكي! كاتسومي

285
00:20:37,000 --> 00:20:38,630
!يو! شينجي

286
00:20:39,420 --> 00:20:40,420
!ساكورا

287
00:20:45,260 --> 00:20:46,300
خريطة؟

288
00:21:12,620 --> 00:21:14,330
.التهب حلقي

289
00:21:14,870 --> 00:21:16,710
.لم أستطع التنفّس

290
00:21:17,250 --> 00:21:19,630
.سمعتُ صراخ أحدهم

291
00:21:20,710 --> 00:21:23,970
.ثمّ أدركتُ بسبب ألم حلقي الشّديد

292
00:21:24,630 --> 00:21:27,510
.أنّي من كنتُ أصرخ

293
00:21:29,300 --> 00:21:31,430
.إذًا فلتكتبه بنفسك

294
00:21:32,390 --> 00:21:37,560
.إنّها الطّريقة الوحيدة لإبقاء تلك الرّواية متكاملة

295
00:21:38,650 --> 00:21:40,190
.ما عدت أستطيع الكتابة

296
00:21:43,400 --> 00:21:44,900
...أنا

297
00:21:45,950 --> 00:21:48,610
.ما عدت قادرًا على كتابة روايةٍ بعد الآن

298
