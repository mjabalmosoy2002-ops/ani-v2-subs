1
00:00:01,520 --> 00:00:04,650
من كان يتوقّع أن ترسل لي النّقابة طلب تحدّي؟

2
00:00:04,650 --> 00:00:07,570
.سيخفّف هذا مللي قليلًا

3
00:00:07,570 --> 00:00:10,070
.مع أنّي أشكّ أنّه فخ

4
00:00:11,320 --> 00:00:14,450
.يبدو أنّه يريد منك ملأ الفراغات

5
00:00:14,450 --> 00:00:17,030
.مع أنّي لا أملك أدنى فكرةٍ عن الحلّ

6
00:00:19,660 --> 00:00:22,080
.أعيريني قلمًا يا يوسانو-سان

7
00:00:28,210 --> 00:00:31,920
هل أنت هو الشّخص العظيم الّذي يريد أن يتحدّاني؟

8
00:00:31,920 --> 00:00:38,550
مهندس
بالنّقابة
————
بو
———

9
00:00:31,920 --> 00:00:38,550
:القدرة
————
القطّ الأسود
في
شارع مورغ

10
00:00:33,300 --> 00:00:35,680
.مضى وقتٌ طويل يا رانبو-كُن

11
00:00:35,680 --> 00:00:38,550
هل استطعت حلّ اللّغز المعلّق على الباب؟

12
00:00:39,510 --> 00:00:41,310
.كما هو متوقّعٌ من رانبو-كُن

13
00:00:41,310 --> 00:00:43,640
.عدوّي اللّدود الّذي يتوجّب عليّ هزيمته

14
00:00:44,520 --> 00:00:47,100
.والآن دوري في طرح الأسئلة

15
00:00:50,190 --> 00:00:51,230
من أنت؟

16
00:00:51,940 --> 00:00:54,490
ألا تتذكّرني؟

17
00:00:54,490 --> 00:01:00,280
.لقد انضممت إلى النّقابة فقط لأتحدّاك

18
00:01:00,280 --> 00:01:01,740
!أنا بو

19
00:01:01,740 --> 00:01:04,040
!متحرٍّ ومفكّرٌ عظيم

20
00:01:04,040 --> 00:01:07,290
!لقد هُزمتُ أمامك في تحدٍّ قبل ستّ سنوات

21
00:01:07,710 --> 00:01:09,380
.ثرثرتك تشعرني بالنّعاس

22
00:01:09,380 --> 00:01:10,340
.سأغادر

23
00:01:10,840 --> 00:01:12,380
!هذه لعبة تحرّي

24
00:01:12,840 --> 00:01:16,180
،اقرأ هذه الرّواية البوليسيّة الّتي ألّفتها

25
00:01:16,180 --> 00:01:19,890
.واكتشف هوية القاتل المتسلسل

26
00:01:19,890 --> 00:01:21,260
.ناقص نقطة

27
00:01:21,850 --> 00:01:25,520
،إن كنت مكتفيًا بالرّوايات
.فلا تستحقّ أن تكون متحرّيًا

28
00:01:25,520 --> 00:01:28,230
.توقّعتُ هذا الجواب

29
00:01:28,600 --> 00:01:30,860
...إن تمكّنتَ من الفوز

30
00:01:30,860 --> 00:01:34,280
فما رأيك بأن أخبرك بنقطة ضعف النّقابة؟

31
00:01:36,490 --> 00:01:41,410
النّقطة العمياء والطّريقة المثلى للهجوم
.على قاعدة النّقابة الطّائفة، الموبي ديك

32
00:01:41,410 --> 00:01:42,870
.زائد نقطة

33
00:01:42,870 --> 00:01:46,410
لكن لماذا اخترت هذا التحدّي السّخيف؟

34
00:01:46,410 --> 00:01:50,500
.عمليّات النّقابة همجيّة وتصيبني بالملل

35
00:01:50,500 --> 00:01:54,840
الشّيء الوحيد الّذي يستحقّ
...الإعجاب والتّقدير في هذا العالم

36
00:01:54,840 --> 00:01:56,340
...هي قدرتك

37
00:01:56,340 --> 00:01:58,220
.الاستنتاج الفائق

38
00:01:59,430 --> 00:02:00,850
هل أنا مخطئ؟

39
00:02:00,850 --> 00:02:02,560
!زائد خمس نقاط

40
00:02:03,140 --> 00:02:04,100
.سألعب

41
00:02:06,680 --> 00:02:09,190
:تبدأ القصّة كالآتي

42
00:02:09,650 --> 00:02:11,480
،في إحدى ليالي أحد العصور"

43
00:02:11,480 --> 00:02:15,900
حوصرت مجموعةٌ من الضّيوف
".في قصرٍ بسبب عاصفةٍ ثلجيّة

44
00:02:15,900 --> 00:02:20,610
،بطل الرّواية، المتحرّي الخاص
،اضطرّ لقضاء اللّيلة هناك

45
00:02:20,610 --> 00:02:23,490
...وعلى وقع ضجّةٍ غريبة قادمة من إحدى الغرف

46
00:02:23,910 --> 00:02:25,120
".فتح عينيه

47
00:02:30,540 --> 00:02:33,000
!هذه قدرتي

48
00:02:33,000 --> 00:02:36,090
!القدرة على نقل القرّاء إلى داخل الرّواية

49
00:02:37,510 --> 00:02:40,340
.مرحبًا بكما في قصر المآسي

50
00:02:47,470 --> 00:02:52,150
قام البطل بفتح الباب بمفتاحٍ عموميّ"
".كان يحتفظ به لوقت الحاجة

51
00:02:56,730 --> 00:02:58,780
"...وما كان يقبع أمام ناظريه"

52
00:02:59,240 --> 00:03:00,990
.ضحيّة

53
00:03:01,410 --> 00:03:04,950
النّافذتان لهما حواجز حديديّة
.ويستحيل الدّخول أو الخروج منهما

54
00:03:04,950 --> 00:03:06,950
.ثمّة بابان

55
00:03:07,450 --> 00:03:10,580
.ومفتاحٌ واحد هنا

56
00:03:17,170 --> 00:03:18,670
...اختفت نظّارتي

57
00:03:19,420 --> 00:03:20,550
هل هو ميّت؟

58
00:03:20,550 --> 00:03:22,510
!تراجعوا! أنا طبيبة

59
00:03:23,550 --> 00:03:24,760
!تماسك

60
00:03:25,430 --> 00:03:27,510
...الـ-الباب

61
00:03:31,600 --> 00:03:33,730
مرحبًا
بك
في
الغرفة
المقفلة

62
00:03:31,600 --> 00:03:33,730
———————

63
00:03:34,770 --> 00:03:38,110
.قال ذلك الشّخص أنّها قضيّة جرائم قتلٍ متسلسل

64
00:03:38,530 --> 00:03:40,820
،ممّا يعني أنّنا إن لم نجد الجاني

65
00:03:40,820 --> 00:03:43,740
.فسنُقتل نحن أيضًا عاجلًا أو آجلًا

66
00:03:48,700 --> 00:03:51,330
.يا لها من قدرةٍ مزعجة

67
00:03:51,330 --> 00:03:54,830
.الجثّة والدّم واقعيّان بشكلٍ مخيف

68
00:03:54,830 --> 00:04:00,050
.ناهيك أنّ قدرتي "لا يجب أن تموت" لا تعمل هنا

69
00:04:00,420 --> 00:04:03,180
.الضّحيّة هو مدير هذا القصر

70
00:04:03,180 --> 00:04:05,390
.سبب الوفات هو الصّدمة النّزفية

71
00:04:05,390 --> 00:04:08,390
...لا بصمات على سلاح الجريمة، بعبارةٍ أخرى

72
00:04:08,390 --> 00:04:11,020
.نموذجٌ لجريمة قتلٍ مستحيلة

73
00:04:11,020 --> 00:04:15,190
،غرفة مقفلة دون أيّ مخرج
.وضحيّةٌ واضحٌ أنّه قد قتل

74
00:04:15,190 --> 00:04:19,020
كيف استطاع الجاني الهرب من الغرفة المقفلة؟

75
00:04:19,020 --> 00:04:21,650
ألست تثرثر أكثر من المعتاد؟

76
00:04:21,650 --> 00:04:23,950
ألن تقوم بحيلتك المعتادة؟

77
00:04:24,490 --> 00:04:25,740
.لا أملك نظارتي

78
00:04:26,700 --> 00:04:29,870
.إنّها نظارةٌ خاصّة أعطاني إيّها الرّئيس

79
00:04:29,870 --> 00:04:32,580
.أحتاجها لتفعيل قدرتي

80
00:04:32,580 --> 00:04:37,580
بالإضافة إلى أنّكِ لم تستطيعي تفعيل
.قدرتكِ على ذلك الشّخص المحتضر

81
00:04:38,170 --> 00:04:42,340
"ممّا يعني أنّ "استنتاجي الفائق
.لن يعمل في هذا العالم أيضًا

82
00:04:43,010 --> 00:04:45,800
.إذًا هذا هو وضعنا

83
00:04:46,340 --> 00:04:52,980
يبدو أنّ رانبو-سان لا يدري أنّه مجرّد
.شخصٍ عاديّ دون أيّ قدراتٍ خارقة

84
00:04:54,230 --> 00:04:58,900
في هذه الحالة، لِم لا تعتمد
الطّريقة القديمة للتّحرّي؟

85
00:04:58,900 --> 00:05:00,730
!مزعج! سخيف! مملّ

86
00:05:00,730 --> 00:05:05,990
التّحرّي وطرح الأسئلة هو عمل
!المتحرّين وليس المتحرّين العظماء

87
00:05:12,950 --> 00:05:15,040
.أنا لم أقتله

88
00:05:13,250 --> 00:05:15,040
كيساكي
————
أدين
سابقًا
للابتزاز
————

89
00:05:15,040 --> 00:05:17,920
.لستُ الفاعل. إنّها الحقيقة

90
00:05:15,330 --> 00:05:17,920
أوكاي

91
00:05:15,330 --> 00:05:17,920
———————————

92
00:05:15,830 --> 00:05:17,920
صحفيّ
بمجلّة
سوقيّة

93
00:05:15,830 --> 00:05:17,920
————————

94
00:05:17,920 --> 00:05:20,040
.لم أقتله

95
00:05:18,210 --> 00:05:20,040
رييدا

96
00:05:18,210 --> 00:05:20,040
———————————

97
00:05:18,710 --> 00:05:20,040
طالب

98
00:05:18,710 --> 00:05:20,040
—————

99
00:05:18,710 --> 00:05:20,040
—————————

100
00:05:20,040 --> 00:05:23,300
لِم يُشتبه بي؟

101
00:05:20,340 --> 00:05:23,300
ميكامي

102
00:05:20,340 --> 00:05:23,300
———————————

103
00:05:20,840 --> 00:05:23,300
من
عائلة
نبيلة
.سابقًا
تسافر
لوحدها
حاليًا

104
00:05:24,130 --> 00:05:26,430
ماذا عن حجج الغياب؟

105
00:05:26,430 --> 00:05:28,550
.كنتُ نائمًا في غرفتي بمفردي

106
00:05:28,550 --> 00:05:32,350
.كنتُ أقطّع الحطب للموقد في المطبخ

107
00:05:32,350 --> 00:05:37,390
،كنتُ في المكتب، أقرأ قصّة بلوتو
.القطّ الأعور الّذي يسكن هذا القصر

108
00:05:37,390 --> 00:05:39,650
لِم عليّ أن أعطيكِ تفسيرًا؟

109
00:05:39,650 --> 00:05:43,110
أنتِ محض طبيبة. من تحسبين نفسك؟

110
00:05:47,320 --> 00:05:48,990
!تذكّرت الآن

111
00:05:48,990 --> 00:05:53,790
ذهبتُ إلى غرفة المدير لأطلب
.منه ملابس تناسبني أكثر

112
00:05:54,290 --> 00:05:58,000
ربّما هي لعنة القطّ الأعور
...المرسوم في تلك الغرفة

113
00:05:58,000 --> 00:06:00,710
.هذه خدعةٌ باستخدام خيط

114
00:06:00,710 --> 00:06:04,210
.مفتاح الغرفة المقفلة كان داخل ملابس الضّحيّة

115
00:06:04,210 --> 00:06:07,800
.بينما المفتاح العموميّ لم يستخدم قبل الحادث

116
00:06:07,800 --> 00:06:10,180
.قام الجاني بقتل المدير

117
00:06:10,680 --> 00:06:11,890
،أخذ المفتاح

118
00:06:11,890 --> 00:06:14,390
.ثمّ خرج وأقفل الباب من الخارج

119
00:06:16,350 --> 00:06:22,020
وبعدها استخدم خيطًا ليمرّر المفتاح
.من تحت الباب ويعيده لجيب الضّحيّة

120
00:06:22,020 --> 00:06:25,230
.وأخيرًا قطع الخيط وسلّه ثمّ تخلّص منه

121
00:06:25,230 --> 00:06:27,030
ما رأيك أيّها المتحرّي؟

122
00:06:27,030 --> 00:06:28,860
هل أنت غبيّ؟

123
00:06:29,950 --> 00:06:32,700
.لا، من الفظّ قولها في صيغة سؤال

124
00:06:32,700 --> 00:06:34,200
.أنت غبيّ

125
00:06:34,200 --> 00:06:37,040
.الفراغ الّذي تحت الباب أصغر من المفتاح

126
00:06:37,040 --> 00:06:41,040
والمفتاح كان في الجيب الخلفيّ للجثّة
.الّتي كانت مستلقية على ظهرها

127
00:06:41,040 --> 00:06:43,790
.كان بإمكانك أن تعرف ذلك من النّظرة الأولى

128
00:06:43,790 --> 00:06:48,760
إ-إذًا فقد قام الجاني بخلع قضبان
،النّافذة الحديديّة وغادر الغرفة

129
00:06:48,760 --> 00:06:51,890
.ثمّ استخدم أدواتٍ ليعيدها إلى مكانها ولاذ بالفرار

130
00:06:51,890 --> 00:06:55,720
رغم هبوب عاصفةٍ ثلجيّة
في الخارج والرّؤية منعدمة؟

131
00:06:56,680 --> 00:06:59,940
.كما أنّ لا وجود لرطوبةٍ قرب النّافذة

132
00:07:01,440 --> 00:07:04,310
ألست تبلي حسنًا يا رانبو-سان؟

133
00:07:04,940 --> 00:07:06,150
!لا

134
00:07:09,190 --> 00:07:09,950
...أنا

135
00:07:13,910 --> 00:07:16,450
لا بدّ أن الشّكوك قد ساورتك، أليس كذلك؟

136
00:07:16,450 --> 00:07:18,620
...قدراتك كمتحرّي

137
00:07:18,620 --> 00:07:20,500
.أنا مستخدم قدرة

138
00:07:20,500 --> 00:07:23,130
.وكما سبق وقلت، القدرات لا تعمل في هذا العالم

139
00:07:23,710 --> 00:07:26,420
!الرّئيس هو من أعطاني تلك النظّارة

140
00:07:26,420 --> 00:07:29,550
!أتقصدين أنّ الرّئيس يكذب عليّ؟

141
00:07:33,470 --> 00:07:34,600
.كلّا

142
00:07:34,600 --> 00:07:36,560
.بالطّبع ما كان ليفعل ذلك

143
00:07:43,650 --> 00:07:46,690
ولا حتّى أنت ستتمكّن من
.حلّ هذه القضيّة يا رانبو-كُن

144
00:07:46,690 --> 00:07:52,150
.إنّها رواية غموضٍ غير اعتياديّة أُعدّت لك خصّيصًا

145
00:07:52,530 --> 00:07:54,870
.وفور أن تدخل إلى الكتاب، ينتهي الأمر

146
00:07:54,870 --> 00:07:58,040
لن تكتشف أبدًا هوية الجاني
.أو طريقة ارتكاب الجريمة

147
00:07:59,120 --> 00:08:01,410
.هذا ليس تحدٍّ

148
00:08:01,410 --> 00:08:03,040
!بل انتقام

149
00:08:04,250 --> 00:08:07,710
.لعلّك قد نسيت، لكنّي أبدًا لم أنسَ

150
00:08:07,710 --> 00:08:10,760
في ذلك اليوم، عندما تجرّعت
،الهزيمة على يدك في معركة الذّكاء

151
00:08:10,760 --> 00:08:14,760
.فقدتُ أيّ سببٍ لإظهار وجهي أمام الآخرين

152
00:08:15,260 --> 00:08:18,350
.هام ذهني في غرفةٍ مظلمةٍ لا نهاية لها

153
00:08:18,350 --> 00:08:20,470
...لكنّني أدركت بعدها

154
00:08:20,470 --> 00:08:22,680
!سببًا يدفعني لمواصلة العيش

155
00:08:22,680 --> 00:08:29,320
...إن حصلتُ على مجدك وثنائك الوفير، فإنّي سوف

156
00:08:32,070 --> 00:08:33,820
.لِهذا سأسلبه منك

157
00:08:34,860 --> 00:08:38,120
!حتّى لو عنى ذلك أن أحرقك حيًا

158
00:08:41,120 --> 00:08:44,290
.هذه قضيّة قتلٍ متسلسل

159
00:08:44,290 --> 00:08:46,880
،إن تعمّدتُ البقاء في هذه الغرفة المقفلة لوحدي

160
00:08:46,880 --> 00:08:48,880
.فبالتّأكيد سيأتي الجاني لقتلي

161
00:08:48,880 --> 00:08:51,210
.والآن، هلمّ إليّ

162
00:09:04,180 --> 00:09:05,440
...يوسانو-سان

163
00:09:06,690 --> 00:09:07,810
...آسفة

164
00:09:08,400 --> 00:09:10,270
.لقد أخفقت

165
00:09:10,690 --> 00:09:13,240
.لم أستطع رؤية الجاني

166
00:09:13,240 --> 00:09:14,990
!لا بأس، لا تتحدّثي

167
00:09:14,990 --> 00:09:17,110
.لم أستطع حلّها

168
00:09:17,530 --> 00:09:25,540
.لكنّها في غاية السّهولة لأعظم متحرٍّ في العالم

169
00:09:25,540 --> 00:09:34,300
ففي النّهاية، وكالة التّحرّي المسلّحة تأسّست
.فقط لكي تستخدم قدرتك كما يجب

170
00:09:37,430 --> 00:09:44,890
.وإلى الآن ما زلت ممتنّةً لدعوتك لي إلى الوكالة

171
00:10:00,070 --> 00:10:01,410
!سقط الأوّل

172
00:10:01,830 --> 00:10:05,540
لن تعود أبدًا إلى العالم الحقيقيّ
!ما لم تكتشف الحقيقة

173
00:10:05,540 --> 00:10:08,710
!فلتعش أبد الدّهر هائمًا في عالم روايتي

174
00:10:16,670 --> 00:10:17,840
.لقد عدنا

175
00:10:17,840 --> 00:10:19,470
!مـ-مستحيل

176
00:10:19,470 --> 00:10:21,050
!محالٌ أن تحلّ تلك الأحجيّة

177
00:10:21,050 --> 00:10:23,930
.حسنٌ، لقد كانت مشوّقة

178
00:10:23,930 --> 00:10:26,060
...إلّا أنّك ارتكبتَ خطأً واحدًا

179
00:10:26,060 --> 00:10:28,270
.أقحمتني في هذا التحدّي

180
00:10:29,310 --> 00:10:31,310
هـ-هل اكتشفت هوية الجاني؟

181
00:10:31,310 --> 00:10:32,520
.بالطّبع

182
00:10:33,440 --> 00:10:34,820
...الجاني

183
00:10:37,440 --> 00:10:38,490
.هو أنا

184
00:10:39,490 --> 00:10:41,740
.لا علاقة لخدعة الغرفة المقفلة بالأمر

185
00:10:41,740 --> 00:10:47,040
،قام البطل بقتل الضّحيّة
.وأغفل الكاتب سرد ذلك الجزء متعمّدًا

186
00:10:47,580 --> 00:10:55,420
إلّا أنّ الشّيء المبتكر في هذه الخدعة
.هو اختفاء الجاني لحظة دخولي للرّواية

187
00:10:55,800 --> 00:11:00,510
.لِذا مهما بحثت، لن أستطيع العثور على الجاني

188
00:11:00,510 --> 00:11:02,930
كيف توصّلت إلى هذا؟

189
00:11:02,930 --> 00:11:06,140
.لقد بالغتَ كثيرًا بجريمة الغرفة المقفلة

190
00:11:06,140 --> 00:11:08,980
،كان الأمر ليصبح منطقيًا أكثر لو تواجد مشتبهٌ به

191
00:11:08,980 --> 00:11:12,020
لكنّ الجاني لم يكن لديه أيّ سببٍ
.لخلق سيناريو غرفةٍ مقفلة

192
00:11:12,020 --> 00:11:14,060
...ولِهذا أدركت

193
00:11:14,650 --> 00:11:17,690
.أنّ الجاني والكاتب متواطئان

194
00:11:18,530 --> 00:11:24,240
والدّليل هو القفّاز الّذي استعمل في
.الجريمة والمخفيّ تحت جدار الطّوب

195
00:11:25,490 --> 00:11:28,370
.وهو ما أشار إليه الضّحيّة قبل موته

196
00:11:28,370 --> 00:11:31,160
...لـ-لكن الجريمة الثّانية

197
00:11:31,160 --> 00:11:34,130
!ألم يختفِ القاتل وقت وصولك إلى هناك؟

198
00:11:34,130 --> 00:11:36,130
.تلك الحادثة أكثر بساطة

199
00:11:36,130 --> 00:11:39,380
.يكفي استخدام آلةٍ أوتوماتيكيّة

200
00:11:39,380 --> 00:11:44,430
تلاعبٌ بسيط بالحقل المغناطيسيّ للغرفة
.يمكنه جعل أداةٍ معدنيّة تصيب الضّحيّة

201
00:11:44,430 --> 00:11:47,010
!أتخال ذلك ممكنًا؟

202
00:11:47,010 --> 00:11:48,720
.كلّ شيءٍ ممكن

203
00:11:48,720 --> 00:11:51,270
.فذلك هو التّضليل الثّاني

204
00:11:51,810 --> 00:11:53,980
.لقد كانت هناك تلميحات في كلّ الأرجاء

205
00:11:54,810 --> 00:11:57,110
.الأدوات الطبيّة الحديثة بشكلٍ مريب

206
00:11:57,520 --> 00:12:01,860
الشّخصيات الّتي ترتدي ملابس من
.القصر عوضًا عن ملابسها الخاصّة

207
00:12:02,990 --> 00:12:06,370
.2050 تدور أحداث هذه الرّواية في عام

208
00:12:07,160 --> 00:12:14,710
بينما القصر هو في الواقع نُزل
.مسافرين ضمن مصعدٍ فضائيّ

209
00:12:14,710 --> 00:12:21,260
مهما بلغ تعقيد الرّواية، فور أن عرفتُ دوافع
.الكاتب الخفيّة، اكتشفت نصف الحلّ

210
00:12:21,260 --> 00:12:22,760
...مستحيل

211
00:12:22,760 --> 00:12:25,050
...ستّ سنوات من حياتي

212
00:12:25,050 --> 00:12:28,430
.مهاراتك في السّرد تحسّنت كثيرًا مقارنةً بالماضي

213
00:12:28,430 --> 00:12:29,930
.لكننّي ما زلتُ ألمس فيها بعض الهفوات

214
00:12:29,930 --> 00:12:31,220
ماذا؟

215
00:12:31,220 --> 00:12:34,140
أتذكر منافستك ضدّي؟

216
00:12:34,140 --> 00:12:38,610
وأنى لي أن أنسى قضيّةً حللتها؟

217
00:12:39,820 --> 00:12:41,070
.هذا يعيد الذّكريات

218
00:12:42,490 --> 00:12:45,820
.لقد كنّا هنا، نتصارع بعقلينا

219
00:12:45,820 --> 00:12:49,580
كانت المرّة الوحيدة الّتي دفعني فيها
.متحرٍّ آخر لبذل أقصى ما لديّ

220
00:12:50,240 --> 00:12:53,080
.الأولى والأخيرة

221
00:12:54,620 --> 00:12:58,340
.لِذا، أنا أتطلّع للتّحدّي القادم

222
00:12:58,840 --> 00:13:01,760
.آمل أن تبذل جهدك في التّفكير من أجلي

223
00:13:05,010 --> 00:13:08,470
.ما زال لديّ مشوارٌ طويلٌ لقطعه

224
00:13:10,720 --> 00:13:13,640
يجب أن نقيم احتفالًا
.لتخليد هذا اليوم عندما نعود

225
00:13:13,640 --> 00:13:14,730
وما المناسبة؟

226
00:13:14,730 --> 00:13:17,850
بمناسبة اليوم الّذي عرف فيه
.المتحرّي العظيم الحقيقة

227
00:13:17,850 --> 00:13:20,570
،اليوم الّذي أدركتَ فيه أنّك لست مستخدم قدرة

228
00:13:20,570 --> 00:13:22,320
...بل تستخدم موهبتك في الملاحظة والاستنتاج

229
00:13:22,320 --> 00:13:24,070
.أنا مستخدم قدرة

230
00:13:24,490 --> 00:13:28,820
.لكنّك شرحت للتّو الدّلائل الّتي بنيتَ عليها استنتاجك

231
00:13:28,820 --> 00:13:30,410
.أنا مستخدم قدرة

232
00:13:30,410 --> 00:13:32,240
.لا أقوم بالتّحرّي

233
00:13:32,240 --> 00:13:33,660
.بل حالفني الحظّ هذه المرّة

234
00:13:34,540 --> 00:13:35,500
...أقصد

235
00:13:37,420 --> 00:13:39,130
تقصد ماذا؟

236
00:13:40,290 --> 00:13:43,550
.سأبدو غبيًا لو اتّضح أنّي شخصٌ عاديٌّ الآن

237
00:13:47,760 --> 00:13:49,890
.الضّحك ممنوع

238
00:13:49,890 --> 00:13:51,180
.حسنًا، حسنًا

239
00:13:51,970 --> 00:13:54,430
!حسنًا، حسنًا" ممنوعٌ أيضًا"

240
00:13:56,520 --> 00:13:59,730
هل صحيحٌ أنّنا نملك معلوماتٍ
نستطيع بها هزيمة النّقابة؟

241
00:14:00,110 --> 00:14:02,610
.إنّهم يضعون خطّةً بالدّاخل حاليًا

242
00:14:06,650 --> 00:14:09,740
.على كلٍّ، إنّها معلوماتٌ رائعة

243
00:14:09,740 --> 00:14:11,450
.قيّمةٌ للغاية

244
00:14:11,450 --> 00:14:16,250
...إن كنّا سنستغلّها لتوجيه ضربةٍ قاتلة للنّقابة

245
00:14:16,790 --> 00:14:18,330
فهل نخترق قاعدتهم ونزرع فيها قنبلة؟

246
00:14:18,330 --> 00:14:19,500
.لن يجدي ذلك

247
00:14:19,500 --> 00:14:21,840
.سيتعقّبون الإشارة وتفشل الخطّة

248
00:14:24,300 --> 00:14:25,960
.معك حق

249
00:14:25,960 --> 00:14:28,970
ماذا عن إسناد الأمر لكينجي-كُن بعد أن
يقصف قسم العمليات الخاصّة المكان؟

250
00:14:28,970 --> 00:14:29,760
.كلّا

251
00:14:29,760 --> 00:14:32,350
إن جعلناها معركةً على الأرض
.فستطول وسنعاني جميعًا

252
00:14:33,260 --> 00:14:35,140
.هذا صحيح

253
00:14:35,140 --> 00:14:36,680
في هذه الحالة، أتسوشي-كُن؟

254
00:14:37,140 --> 00:14:40,060
".يمكن أن يفلح ذلك، إن استخدمنا "الثّلج الخفيف

255
00:14:40,480 --> 00:14:41,440
.بالفعل

256
00:14:42,020 --> 00:14:43,690
.سأشرع في الأمر حالًا

257
00:14:44,110 --> 00:14:45,480
الجبل في النّهاية؟

258
00:14:45,480 --> 00:14:46,110
.بل المحيط

259
00:14:46,990 --> 00:14:48,110
.عُلم

260
00:14:58,330 --> 00:14:59,250
!أفلتني

261
00:15:00,710 --> 00:15:03,460
.لديكِ حقًا الجرأة لخيانة النّقابة

262
00:15:03,960 --> 00:15:06,170
.أتمنّى لو أنّي أملك جرأتك

263
00:15:06,590 --> 00:15:11,930
لكن هل ظننتِ حقًا أنّ النّقابة
لا تملك تدابر مضادّة لقدرتكِ القويّة؟

264
00:15:11,930 --> 00:15:13,800
.كنتُ أعلم

265
00:15:14,300 --> 00:15:16,930
،لكن لو لم أقل أنّي سأكون بخير

266
00:15:17,600 --> 00:15:19,940
!لما كان ذلك الشّخص ليهرب

267
00:15:20,600 --> 00:15:21,690
.يا إلهي

268
00:15:21,690 --> 00:15:23,770
.ليس من السّهل أن تكون شرّيرًا

269
00:15:24,480 --> 00:15:28,400
إذًا، ما الخطّة التّالية أيّتها المخطّطة الاستراتيجيّة؟

270
00:15:29,650 --> 00:15:31,570
مرحبًا يا أنغو، كيف حالك؟

271
00:15:31,950 --> 00:15:34,070
.جلبتُ لك أخبارًا سارّةً اليوم

272
00:15:34,450 --> 00:15:37,490
.سنعتني بجراحك في الوكالة

273
00:15:37,950 --> 00:15:42,210
ستعود إلى عافيّتك بجرعةٍ من
.قدرة العلاج الخاصّة بيوسانو-سان

274
00:15:42,210 --> 00:15:44,460
إذًا، ماذا تريد بالمقابل؟

275
00:15:44,460 --> 00:15:48,670
في الواقع، إحدى أعضاء الوكالة قُبض
.عليها من قبل الشّرطة العسكريّة

276
00:15:48,670 --> 00:15:52,090
.نريد إنقاذها قبل معركتنا الحاسمة ضدّ النّقابة

277
00:15:52,590 --> 00:15:53,720
.فهمت

278
00:15:54,090 --> 00:15:56,050
تقصد قاتلة الخمسة والثّلاثين شخصًا؟

279
00:15:56,930 --> 00:16:01,310
سمعتُ أنّها محتجزةٌ في طائرةٍ بدون طيّار
.تُستخدم لعزل مستخدمي القدرات الخطيرين

280
00:16:02,100 --> 00:16:07,230
صحيحٌ أنّ بإمكان قسم العمليّات الخاصّة
.أن يلتمس طلبًا غير قانونيّ لمنحها الحصانة

281
00:16:08,320 --> 00:16:11,780
...لكن فقط لو كانت الفتاة حقًا

282
00:16:11,780 --> 00:16:14,200
.عضوًا بالوكالة

283
00:16:14,610 --> 00:16:15,780
صحيح؟

284
00:16:16,620 --> 00:16:19,120
كيوكا-تشان ليست عضوًا بالوكالة؟

285
00:16:20,750 --> 00:16:23,540
.ليست كذلك بعد لأكون دقيقًا

286
00:16:24,120 --> 00:16:27,460
ثمّة دائمًا اختبار قبولٍ يجب
.أن تجتازه للانضمام للوكالة

287
00:16:28,340 --> 00:16:32,510
ما لم تجتز الاختبار، لن يتمّ
.الاعتراف بك كموظّفٍ رسميّ

288
00:16:33,300 --> 00:16:35,140
تذكُر أنّك خضعت لذلك الاختبار، صحيح؟

289
00:16:39,810 --> 00:16:41,220
،دازاي-كُن

290
00:16:41,220 --> 00:16:45,850
.أقبل بعرضك لعلاجي مقابل تعاوني

291
00:16:46,560 --> 00:16:48,770
.لِذا أخبرني بأمرٍ واحد

292
00:16:50,280 --> 00:16:53,280
،عندما اصطدمت بنا تلك السّيارة المجهولة

293
00:16:53,280 --> 00:16:56,820
لماذا وسادتي الهوائيّة وحدها الّتي لم تعمل؟

294
00:16:57,530 --> 00:16:59,870
هل تعلم السّبب؟

295
00:17:03,250 --> 00:17:04,540
،اختبار القبول

296
00:17:04,540 --> 00:17:08,500
يشمل مراقبة سلوكيّات المتقدّم لتحديد
.ما إن كان مؤهّلًا للعمل في الوكالة

297
00:17:08,500 --> 00:17:10,380
.بعبارةٍ أخرى، إنّه اختبارٌ سرّي

298
00:17:10,380 --> 00:17:13,420
،كلّما كانت كيوكا-تشان في خطر

299
00:17:13,420 --> 00:17:17,300
فإنّها تسعى للهرب عن طريق
.إيذاء أحدهم أو التخلّص منه

300
00:17:17,300 --> 00:17:19,720
.قد تكون تلك طبيعتها الحقيقيّة

301
00:17:20,510 --> 00:17:23,890
...في هذه الحالة، إن كانت ستجتاز اختبار القبول

302
00:17:25,810 --> 00:17:27,270
.حسنًا، لقد وصلنا

303
00:17:28,980 --> 00:17:31,110
المكتبة؟

304
00:17:33,940 --> 00:17:37,070
.أنا تانيزاكي من وكالة التّحرّي المسلّحة

305
00:17:37,070 --> 00:17:38,950
.كنّا في انتظاركما

306
00:17:47,540 --> 00:17:48,460
.تفضّلا

307
00:17:55,970 --> 00:17:59,680
إنّها المروحيّة المقاتلة التّابعة لقسم
".العمليّات الخاصّة، "غراب اللّيل

308
00:17:59,680 --> 00:18:03,010
.سأقودها وأوصلك إلى الموبي ديك

309
00:18:04,970 --> 00:18:06,980
تسلّلٌ فرديّ؟

310
00:18:07,440 --> 00:18:11,020
.يبدو أنّ النّقابة تخطّط لهجومٍ بريّ شامل

311
00:18:11,020 --> 00:18:15,740
سنستغلّ الفرصة للتّسلّل إلى الموبي ديك
.بينما دفاعها ضعيف ونسيطر عليها

312
00:18:15,740 --> 00:18:18,950
هل سأتولّى هذه العمليّة المعقّدة وحدي؟

313
00:18:18,950 --> 00:18:20,700
،بما أنّه تسلّل فرديّ

314
00:18:20,700 --> 00:18:26,370
فمن الأفضل الاعتماد على مستخدم
.قدراتٍ قتاليّة يمكنه العمل تحت الضّغط

315
00:18:26,910 --> 00:18:31,500
كما أنّك كنت أسيرًا على متن
.الموبي ديك وعلى علمٍ بهيكلها

316
00:18:31,500 --> 00:18:33,550
،وحتّى إن فشلت في أسوأ الأحوال

317
00:18:33,550 --> 00:18:37,340
،فهناك إمكانيّة كبيرة بأنّهم لن يقتلوك
.وسيأسرونك فحسب

318
00:18:37,340 --> 00:18:39,930
.لا أحد مناسبٌ لهذا العمل أكثر منك

319
00:18:40,340 --> 00:18:41,640
هل ستقوم به؟

320
00:18:43,760 --> 00:18:45,010
.ارفض

321
00:18:45,520 --> 00:18:46,980
.لا تستطيع فعلها

322
00:18:47,480 --> 00:18:50,270
.ستظلّ حثالة الميتم حتّى مماتك

323
00:18:51,440 --> 00:18:56,690
".ندمتُ فقط على الأشياء الّتي لم أفعلها"

324
00:19:00,070 --> 00:19:01,410
.سأفعلها

325
00:19:03,490 --> 00:19:06,410
.توشيكان على دخول حقل رؤية الموبي ديك

326
00:19:06,410 --> 00:19:07,450
.عُلم

327
00:19:07,450 --> 00:19:09,250
.استعدّ يا أتسوشي-كُن

328
00:19:09,250 --> 00:19:10,000
.حاضر

329
00:19:12,170 --> 00:19:13,330
:القدرة

330
00:19:13,460 --> 00:19:16,380
الثلج
الخفيف

331
00:19:13,840 --> 00:19:15,090
!الثّلج الخفيف

332
00:19:20,970 --> 00:19:26,850
لاقطات الموبي ديك تتوقف لـ130 ثانية
.فقط بينما تهبط مروحيّة المؤن

333
00:19:27,850 --> 00:19:30,560
.سننتهز تلك الفرصة للتّواري والاقتراب

334
00:19:35,320 --> 00:19:38,320
ماذا؟ الطيّار لا يجيب؟

335
00:19:38,320 --> 00:19:41,400
.أجل، ربّما هناك مشكلةٌ في أجهزة الاتّصال

336
00:19:45,660 --> 00:19:46,620
ماذا؟

337
00:20:07,260 --> 00:20:09,600
.دازاي-سان، لقد دخلت

338
00:20:11,140 --> 00:20:12,940
كيف الوضع بالدّاخل؟

339
00:20:12,940 --> 00:20:14,310
.لا أحد هنا

340
00:20:14,310 --> 00:20:15,520
.هذا غريب

341
00:20:21,530 --> 00:20:22,990
أين الجميع؟

342
00:20:24,490 --> 00:20:26,620
.تمّ إخلاء الجميع تقريبًا

343
00:20:27,490 --> 00:20:30,290
أتعرف السّبب أيّها الفتى؟

344
00:20:30,290 --> 00:20:32,370
.لأنّها النّهاية

345
00:20:32,370 --> 00:20:34,420
.نهاية هذه الحرب

346
00:20:34,420 --> 00:20:39,130
إن لم أكن مخطئًا، فهذا هو مستخدم
.القدرة الّذي استدعى الموبي ديك

347
00:20:39,710 --> 00:20:44,180
.الهجوم التّالي سيحوّل كلّ أعداء النّقابة إلى رماد

348
00:20:44,180 --> 00:20:46,510
.إلى جانب الموبي ديك

349
00:20:48,180 --> 00:20:49,560
!ما قصدك؟

350
00:20:49,560 --> 00:20:53,390
لا بدّ أنّك فكّرت بالتّسلّل بينما
.لا يوجد العديد من الأشخاص هنا

351
00:20:53,980 --> 00:21:01,400
لكن ألم تفكّر أنّ من الغريب أن تتخلّى قوّات
النّقابة عن الموبي ديك في مثل هذا الوقت؟

352
00:21:02,280 --> 00:21:05,110
.سيكون من السيّئ لو أُقحمنا في الأمر أيضًا

353
00:21:05,110 --> 00:21:09,580
المرحلة الثّانية من عمليّة حرق
".يوكوهاما، "سقوط الموبي ديك

354
00:21:09,580 --> 00:21:13,370
إن أفلح هذا، فإنّ هذه المدينة في
،وضعها الحاليّ الّذي أضعفته اللّعنة

355
00:21:13,370 --> 00:21:15,580
.ستُمحى بالكامل

356
00:21:16,870 --> 00:21:19,630
...ومنطقة الاصطدام

357
00:21:20,090 --> 00:21:22,880
تشمل وكالة التّحرّي ومقرّ المافيا؟

358
00:21:23,800 --> 00:21:27,590
.سنصطدم بالأرض في أقلّ من ساعة

359
00:21:27,590 --> 00:21:32,220
،إن كانت الموبي ديك قدرتك الخاصّة
!فيفترض أن تكون قادرًا على إيقافها

360
00:21:32,220 --> 00:21:36,100
.صحيحٌ أنّ الموبي ديك هي قدرتي الخاصّة

361
00:21:36,770 --> 00:21:40,820
.لكنّ 70% من هيكلها تمّ تسليحه

362
00:21:40,820 --> 00:21:43,860
.لم أعد أملك السّيطرة عليها

363
00:21:43,860 --> 00:21:45,950
أسمعتَ ذلك يا دازاي-سان؟

364
00:21:45,950 --> 00:21:48,990
!يجب أن نلغي العمليّة ونشرع في الإخلاء

365
00:21:48,990 --> 00:21:50,950
.ستستمرّ العمليّة كما هو مخطّط

366
00:21:50,950 --> 00:21:51,870
!عفوًا؟

367
00:21:52,540 --> 00:21:57,000
.تولَّ السيطرة على الموبي ديك بنفسك وأوقف هبوطها

368
00:21:57,540 --> 00:22:01,380
.أنت الوحيد على متن الموبي ديك الّذي يستطيع فعلها

369
00:22:02,170 --> 00:22:04,760
لقد تنبّأتَ حدوث هذا الوضع، أليس كذلك؟

370
00:22:04,760 --> 00:22:06,970
.أخذتها كاحتماليّة

371
00:22:06,970 --> 00:22:10,430
.وذلك جزءٌ من سبب اختيارنا لك

372
00:22:10,430 --> 00:22:11,390
هل تستطيع فعلها؟

373
00:22:14,770 --> 00:22:17,640
كيف لي أن أوقف هبوطها؟

374
00:22:17,640 --> 00:22:20,560
.سيتوجّب عليك استخدام جهاز التّحكّم

375
00:22:20,560 --> 00:22:23,020
.إنّه في المكتب الّذي بالطّابق العلويّ

376
00:22:23,480 --> 00:22:26,280
.وبالطّبع حراسته مشدّدة

377
00:22:28,360 --> 00:22:29,490
.شكرًا لك

378
00:22:32,530 --> 00:22:36,700
إن تمّ إخلاء الجميع، فلم ما زلت هنا؟

379
00:22:36,700 --> 00:22:42,130
إن كانت الموبي ديك ستسقط على
،أرضٍ أجنبيّة، وتبيد النّاس هناك

380
00:22:42,130 --> 00:22:45,250
.فأعتقد أنّ سقوطي معها هو أقلّ ما يمكنني فعله

381
00:22:47,920 --> 00:22:52,970
كانت الموبي ديك مخلوقًا جميلًا
.قبل أن يتمّ تحويلها إلى آلة

382
00:22:52,970 --> 00:22:57,140
.كما كانت النّقابة في الماضي

383
00:23:02,560 --> 00:23:03,650
نعم؟

384
00:23:03,650 --> 00:23:06,030
كيف حالك يا دازاي-كُن؟

385
00:23:08,530 --> 00:23:10,410
ماذا هناك يا موري-سان؟

386
00:23:10,410 --> 00:23:15,830
أولم نعقد اتّفاقًا مع المافيا على ألّا يعرقلوا عمليّات الوكالة؟

387
00:23:16,200 --> 00:23:21,290
.بشأن ذلك الاتّفاق، وردني اتصالٌ للتّو من أحد أتباعي

388
00:23:21,290 --> 00:23:23,840
.لا يبدو أنّه سيبقى ساريًا

389
00:23:28,590 --> 00:23:29,670
...أنت

390
00:23:30,760 --> 00:23:32,430
!عثرت عليك أيّها الرّجل النّمر

391
00:23:33,970 --> 00:23:36,510
!أكوتاغاوا

392
00:23:39,600 --> 00:23:39,770
