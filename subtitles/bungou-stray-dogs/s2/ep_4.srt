1
00:00:09,150 --> 00:00:11,610
.ليلة سعيدة يا كوسكي

2
00:00:15,030 --> 00:00:17,200
.ليلة سعيدة يا كاتسومي

3
00:00:20,740 --> 00:00:22,620
.ليلة سعيدة يا يو

4
00:00:26,420 --> 00:00:28,630
.ليلة سعيدة يا شينجي

5
00:00:31,710 --> 00:00:33,880
.ليلة سعيدة يا ساكورا

6
00:00:36,550 --> 00:00:38,300
.أرقدوا بسلام

7
00:00:42,140 --> 00:00:43,350
.سأغادر

8
00:00:48,400 --> 00:00:51,440
.شكرًا على حضورك اليوم

9
00:00:52,070 --> 00:00:55,200
.أكرّر، هذا اجتماعٌ غير رسميّ

10
00:00:55,860 --> 00:00:57,950
.أشكرك على دعوتي إلى هنا اليوم

11
00:00:58,700 --> 00:01:01,240
ما هو شعورك بعد عودتك إلى عملك الرّئيسيّ؟

12
00:01:01,700 --> 00:01:05,660
،لا تعذّب موظّفيّ الصّغار

13
00:01:05,830 --> 00:01:08,250
.يا زعيم مافيا الميناء

14
00:01:08,540 --> 00:01:12,340
.عزيزتي إليس-تشان تريد البوظة

15
00:01:12,550 --> 00:01:15,720
أتوجد أيّ محلاّت لبيع البوظة
ينصح بها الموظّفون الحكوميّون

16
00:01:15,720 --> 00:01:17,090
يا حظرة الرّئيس تانيدا؟

17
00:01:17,300 --> 00:01:20,300
.إنّه موضوع عاطفيّ

18
00:01:20,470 --> 00:01:24,600
.يجب أن أجلب هدايا لموظّفيّ أيضًا

19
00:01:25,020 --> 00:01:29,610
وأراهن أنّ لا شيء سيسرّهم
.أكثر من أن يروا رأسك على طبق

20
00:01:31,520 --> 00:01:34,400
.إن أمكن، فلنشرع في برنامجنا

21
00:01:35,030 --> 00:01:39,240
لدى قسم الموهوبين للعمليّات الخاصّة
.طلبان من أوغاي-دونو من مافيا الميناء

22
00:01:39,820 --> 00:01:43,700
أوّلاً، ستعفي مافيا الميناء نفسها من
،أيّ اهتمامٍ بي أنا ساكاغوتشي أنغو

23
00:01:43,700 --> 00:01:45,450
.ولن تضرّ بي شخصيًّا

24
00:01:45,790 --> 00:01:48,170
،ثانيًا، ستتخلّص مافيا الميناء من ميميك

25
00:01:48,170 --> 00:01:51,750
منظمّة الموهوبين الإجراميّة الّتي دخلت
.اليابان بشكلٍ غير قانونيّ

26
00:01:52,040 --> 00:01:55,130
.لا تعتريني أيّ شكوك بخصوص الطّلب الأوّل

27
00:01:55,510 --> 00:01:58,970
.لكنّي متردّدٌ في قبول الطّلب الثّاني

28
00:01:59,640 --> 00:02:02,470
...فهُم في النّهاية مجموعة مخيفة

29
00:02:03,100 --> 00:02:05,930
.حسنٌ، سيعتمد الأمر على الظّروف

30
00:02:36,090 --> 00:02:37,340
.أوداساكو

31
00:02:39,380 --> 00:02:41,890
.أعلم فيمَ تفكّر

32
00:02:42,300 --> 00:02:43,550
.لكن لا تفعل ذلك

33
00:02:43,800 --> 00:02:45,220
...حتّى لو فعلت

34
00:02:45,220 --> 00:02:49,430
.حتّى لو فعلت، لن يعيد ذلك الأطفال

35
00:02:49,850 --> 00:02:52,190
.ما زالوا يملكون أرقامًا

36
00:02:52,770 --> 00:02:54,360
...وقد وصلوا إلى

37
00:02:54,360 --> 00:02:57,030
.أعلم أين وصلوا

38
00:02:57,730 --> 00:02:59,530
.لقد حصلتُ على دعوة كما ترى

39
00:02:59,740 --> 00:03:00,820
.أصغِ إليّ

40
00:03:01,110 --> 00:03:04,740
.لقد ذهب الزّعيم توًّا لحظور اجتماعٍ سرّيّ

41
00:03:05,200 --> 00:03:07,200
.مع قسم الموهوبين للعمليّات الخاصّة

42
00:03:07,620 --> 00:03:10,660
.هناك ما هو أكثر من هذا يجري

43
00:03:10,830 --> 00:03:13,330
.لا شيء أكثر يجري يا دازاي

44
00:03:14,710 --> 00:03:16,630
.كلّ شيء انتهى بالنّسبة لي

45
00:03:16,630 --> 00:03:17,750
.أوداساكو

46
00:03:17,750 --> 00:03:22,090
،اعذرني على صياغة الأمر بهذه الطّريقة
.لكن اسمعني رجاءً

47
00:03:22,090 --> 00:03:23,760
.عليك أن تعتمد على شيءٍ ما

48
00:03:24,010 --> 00:03:25,180
.قد يكون أيّ شيء

49
00:03:25,390 --> 00:03:28,100
!عليك أن تنتظر وترى ما سيحدث، مهما كان

50
00:03:28,310 --> 00:03:30,520
.سيحدث

51
00:03:32,270 --> 00:03:33,600
.يا أوداساكو

52
00:03:34,440 --> 00:03:37,690
أتدري لِمَ انضممتُ إلى مافيا الميناء؟

53
00:03:39,400 --> 00:03:42,150
.كنتُ آمل أن أجد بها شيئًا لنفسي

54
00:03:42,910 --> 00:03:45,780
،عندما تُقرّب نفسك من العواطف المحضة

55
00:03:46,660 --> 00:03:49,950
،حيث تكشف نفسك أمام العنف والموت والفطرة والرّغبة

56
00:03:49,950 --> 00:03:52,750
.حينها بإمكانك أن تلمس طبيعة الإنسان الحقيقيّة

57
00:03:53,620 --> 00:03:55,210
...فكّرتُ أنّه بوسعي بتلك الطّريقة أن

58
00:03:56,750 --> 00:03:59,760
.أجد سببًا لأعيش من أجله بطريقةٍ ما

59
00:04:01,920 --> 00:04:04,340
.أردتُ أن أصبح كاتبًا

60
00:04:05,970 --> 00:04:10,060
ظننتُ أنّي سأفقد الحقّ في فعل ذلك
.إن أزهقتُ روحًا أخرى

61
00:04:10,470 --> 00:04:12,350
.لهذا توقّفتُ عن القتل

62
00:04:13,100 --> 00:04:14,310
.أوداساكو

63
00:04:14,690 --> 00:04:16,230
.لكنّ كلّ شيء قد آل إلى نهايته

64
00:04:16,440 --> 00:04:17,190
!لا تذهب

65
00:04:17,190 --> 00:04:18,230
!أوداساكو

66
00:04:23,150 --> 00:04:26,030
.أريد شيئًا واحدًا فقط

67
00:04:28,620 --> 00:04:29,790
!أوداساكو

68
00:04:49,470 --> 00:04:51,810
...هذا مؤلم

69
00:04:51,810 --> 00:04:52,470
!أنت

70
00:04:52,470 --> 00:04:53,430
ماذا تحسب نفسك فاعلاً؟

71
00:04:53,560 --> 00:04:56,140
!يجب أن تنتبه إلى طريقك

72
00:04:56,310 --> 00:04:59,560
كدتَ أن تفسد أدوات التّحرّي الشّهيرة
.الّتي منحها لي الرّئيس

73
00:04:59,820 --> 00:05:00,730
تحرّي؟

74
00:05:01,650 --> 00:05:02,690
!ليس أيّ تحرٍّ

75
00:05:02,690 --> 00:05:04,070
!أنا محقّق عظيم

76
00:05:04,360 --> 00:05:07,660
.قريبًا، سيُعرف اسمي في كلّ بيت وكلّ ركن في اليابان

77
00:05:07,990 --> 00:05:11,660
.أنا أفضل محقّق شهده العالم، إيدوغاوا رامبو

78
00:05:10,530 --> 00:05:11,870
.آسفٌ لأنّي سألت

79
00:05:11,660 --> 00:05:13,080
!انتظر

80
00:05:13,370 --> 00:05:14,830
،بمجرّد أن ترى قدرتي

81
00:05:14,830 --> 00:05:17,290
!لن تكون فظًّا معي

82
00:05:17,670 --> 00:05:19,920
.سأريكَ إن شككتَ بي

83
00:05:20,840 --> 00:05:22,090
...فلنرَ

84
00:05:27,180 --> 00:05:29,470
،لا أقصد أن أكون فظًّا

85
00:05:30,300 --> 00:05:33,060
.لكن لا يجب أن تذهب إلى وجهتك

86
00:05:33,560 --> 00:05:35,180
.يجب أن تعيد التّفكير بذلك

87
00:05:37,100 --> 00:05:38,400
،إن ذهبت

88
00:05:38,980 --> 00:05:40,230
.فستموت

89
00:05:42,270 --> 00:05:43,230
.أجل

90
00:05:45,240 --> 00:05:46,450
.أعلم

91
00:07:17,910 --> 00:07:19,330
أتريدني أن أنهي حياتك؟

92
00:07:20,000 --> 00:07:20,870
...أجل

93
00:07:21,870 --> 00:07:22,960
.رجاءً

94
00:07:23,250 --> 00:07:25,340
ألديك كلمات أخيرة؟

95
00:07:26,090 --> 00:07:27,250
...شكرًا لك

96
00:07:27,800 --> 00:07:29,340
...لقتالنا

97
00:07:30,090 --> 00:07:32,590
...زعيمنا... في الأعلى

98
00:07:33,390 --> 00:07:35,260
...أنقذه أيضًا أرجوك

99
00:07:35,760 --> 00:07:37,310
.من جحيمه

100
00:07:38,220 --> 00:07:39,100
.أجل

101
00:07:39,850 --> 00:07:41,020
.أعلم

102
00:07:49,150 --> 00:07:51,360
.ماذا؟ دازاي-كُن

103
00:07:51,650 --> 00:07:54,240
.نادرًا ما تأتي لزيارتي

104
00:07:54,990 --> 00:07:56,030
.حضرة الزّعيم

105
00:07:56,410 --> 00:08:01,370
أريد أن أطلب تصريحك لإعداد قسم
.موهوبين من أجل إنقاذ أوداساكو

106
00:08:01,580 --> 00:08:02,500
.حسنًا

107
00:08:02,500 --> 00:08:03,620
.أعطيك تصريحي

108
00:08:04,000 --> 00:08:06,670
لكن أوّلاً، لماذا؟

109
00:08:07,290 --> 00:08:12,920
أوداساكو حاليًّا يقوم باستطلاعٍ
.لقوّة العدوّ لوحده في مقرّ ميميك

110
00:08:13,180 --> 00:08:16,970
.سيموت إن لم نفعل شيئًا، وسنفقد وكيلاً موهوبًا وقيّمًا

111
00:08:18,890 --> 00:08:21,220
.أفهم تفكيرك

112
00:08:21,390 --> 00:08:25,980
.لكن أشكّ أنّ أودا-كُن يريد أن ينقذه أحد

113
00:08:27,020 --> 00:08:29,190
ما رأيك؟

114
00:08:31,110 --> 00:08:38,200
دازاي-كُن، زعيم منظّمةٍ هو
.قِمّتها وعبدها في الوقت ذاته

115
00:08:38,410 --> 00:08:44,120
يجب أن يكون الزّعيم على أتمّ الاستعداد
.لارتكاب أيّ شناعةٍ للحرص على بقاء المنظّمة

116
00:08:44,870 --> 00:08:46,630
...ذلك الظّرف

117
00:08:48,210 --> 00:08:51,000
.فهمتُ الآن

118
00:08:53,550 --> 00:08:55,380
إلى أين أنت ذاهب؟

119
00:08:55,970 --> 00:08:57,470
.إلى أوداساكو

120
00:09:09,730 --> 00:09:11,610
“.تبقى وحدها”

121
00:09:11,860 --> 00:09:14,440
“،إن لم تقع حبة الحنطة في الأرض وتمت”

122
00:09:14,570 --> 00:09:16,530
“.فهي تبقى وحدها”

123
00:09:17,450 --> 00:09:18,570
“...لكن إن ماتت”

124
00:09:19,490 --> 00:09:22,620
“.ولكن إن ماتت تأتي بثمر كثير”

125
00:09:22,990 --> 00:09:26,370
.الإصحاح 12، الآية 24 من إنجيل يوحنّا

126
00:09:27,170 --> 00:09:30,210
.أنت واسع الاطّلاع أكثر ممّا يبدو عليك يا ساكونوسكي

127
00:09:31,960 --> 00:09:34,840
.أعتذر عمّا حدث للأطفال

128
00:09:35,420 --> 00:09:37,970
.لكن يبدو أنّ الأمر كان يستحقّ

129
00:09:38,760 --> 00:09:40,800
.عيناك مثل عينيّ الآن

130
00:09:41,300 --> 00:09:42,930
،شأني شأن أتباعي

131
00:09:43,100 --> 00:09:45,810
.تبدو كأحدٍ ترك سُلّم الاستمرار في الوجود

132
00:09:46,430 --> 00:09:50,230
!مرحبًا بك في عالمنا يا ساكونوسكي

133
00:10:06,080 --> 00:10:09,170
.يبدو أنّنا لا نحرز أيّ تقدّم فقط بقراءة مستقبلنا

134
00:10:09,370 --> 00:10:10,130
.يبدو الأمر كذلك

135
00:10:24,010 --> 00:10:28,020
.إذًا علينا أن نُقاتل دون استخدام قدرتنا التّنبّؤيّة

136
00:10:28,310 --> 00:10:29,140
.بالفعل

137
00:10:29,890 --> 00:10:31,860
.معك حقّ يا ساكونوسكي

138
00:10:32,270 --> 00:10:34,610
.أنت الأفضل

139
00:10:36,030 --> 00:10:39,530
.لم ننتهِ من النّقاش يا دازاي-كُن

140
00:10:47,540 --> 00:10:51,370
،أو بالأحرى، في هذه القضيّة
...فريق الموهوبين للعمليّات الخاصّة

141
00:10:51,830 --> 00:10:56,050
.ومن يدير الصّراع بين الأطراف الثّلاثة

142
00:10:57,050 --> 00:11:02,180
.هذا التّخطيط الجريء والمعقّد كان من صنيعك أيّها الزّعيم

143
00:11:03,090 --> 00:11:06,140
.وذلك الظّرف الأسود قيّمٌ إلى ذلك الحدّ

144
00:11:07,390 --> 00:11:11,730
،مهما أصبحت مافيا الميناء قويّة

145
00:11:11,980 --> 00:11:19,610
فنحن نتعرّض للاضطهاد ونعيش في خوفٍ دائمٍ
.من إزعاج قسم الموهوبين للعمليّات الخاصّة

146
00:11:20,740 --> 00:11:23,620
،لهذا السّبب ومقابل سحق ميميك

147
00:11:24,370 --> 00:11:27,580
.فقد تفاوضتَ من أجل إصدار هذا التّرخيص

148
00:11:28,330 --> 00:11:32,580
...هذا التّرخيص الّذي يسمح لنا بإدارة منظّمة للموهوبين

149
00:11:33,380 --> 00:11:35,380
.ترخيص أعمال الموهوبين

150
00:12:01,610 --> 00:12:03,990
.أنت الأفضل يا ساكونوسكي

151
00:12:04,320 --> 00:12:06,740
.اليوم، أنا معك حتّى النّهاية

152
00:12:22,800 --> 00:12:23,800
ماذا؟

153
00:12:26,640 --> 00:12:28,560
أهذا ما كان يتحدّث عنه أنغو؟

154
00:12:28,810 --> 00:12:30,810
!فرديّة القدرة؟

155
00:12:33,810 --> 00:12:36,020
.هذا هو العالم الّذي سعيتُ إليه

156
00:12:36,690 --> 00:12:38,150
لِمَ أردتَه؟

157
00:12:38,520 --> 00:12:40,900
لِمَ توقّفت عن القتل؟

158
00:12:42,740 --> 00:12:45,070
.أردتُ أن أصبح كاتبًا

159
00:12:45,570 --> 00:12:49,030
.أخبرني أحدهم أنّ هذا ما يجب أن أفعله

160
00:12:49,740 --> 00:12:51,790
.أعطاني كتابًا

161
00:12:52,330 --> 00:12:56,120
.لقد كان المجلّد الأخير لرواية بحثتُ عنها لوقتٍ طويل

162
00:13:00,590 --> 00:13:04,170
.قبل أن أقرأه، أخبرني أنّه كتابٌ فظيع

163
00:13:04,800 --> 00:13:07,470
وكيف وجدته؟

164
00:13:08,180 --> 00:13:12,720
.لقد كان كتابًا رائعًا

165
00:13:15,020 --> 00:13:20,520
.أنت من ساعدتهم على دخول البلاد بصورة غير مشروعة

166
00:13:21,270 --> 00:13:28,410
دعوتَ منظّمة العدوّ ليوكوهاما لتُحرّض فريق
.الموهوبين للعمليّات الخاصّة على المبادرة أخيرًا

167
00:13:28,870 --> 00:13:29,780
.أجل

168
00:13:30,370 --> 00:13:34,290
.وبفضل ذلك، بتنا نملك ترخيص أعمال الموهوبين

169
00:13:34,700 --> 00:13:38,460
لقد صادقت الحكومة على كلّ أعمالنا
.غير القانونيّة بكلّ الدّوافع العمليّة

170
00:13:38,580 --> 00:13:44,090
كما سيفرّط أودا-كُن بحياته من أجل
.أن يتكفّل بالمعتدين المزعجين

171
00:13:44,630 --> 00:13:46,340
.إنّه انتصار مجيد لصالحنا

172
00:13:46,800 --> 00:13:51,100
ومع ذلك... لِمَ أنت غاضبٌ إلى هذا الحدّ؟

173
00:13:51,600 --> 00:13:57,890
أنت من أعلمَ ميميك بشأن اليتامى
.الّذين يعتني بهم أوداساكو

174
00:13:58,390 --> 00:14:02,860
،فعلت ذلك لتواجه زعيم ميميك بأوداساكو

175
00:14:03,230 --> 00:14:05,070
.الوكيل الموهوب الوحيد القادر على مقارعته

176
00:14:08,320 --> 00:14:09,450
.دازاي-كُن

177
00:14:12,660 --> 00:14:14,620
.يجب أن تبقى هنا

178
00:14:15,870 --> 00:14:22,960
أم لديك سببٌ منطقيّ للذّهاب إليه؟

179
00:14:24,250 --> 00:14:27,090
.هناك أمران أريد إخبارك بهما أيّها الزّعيم

180
00:14:28,130 --> 00:14:32,220
.أوّلاً، لن تطلق عليّ النّار

181
00:14:32,850 --> 00:14:34,890
.كما لن تأمر أتباعك بفعل ذلك

182
00:14:36,180 --> 00:14:37,930
ما الّذي يجعلك تفكّر هكذا؟

183
00:14:38,390 --> 00:14:40,140
.لأنّك لن تكسب أيّ شيء من هذا

184
00:14:41,230 --> 00:14:47,190
أعتقد أنّك لن تكسب أيّ شيءٍ
.أيضًا بعصيانك لي والذّهاب إليه

185
00:14:47,320 --> 00:14:50,030
.أمّا بشأن الأمر الثّاني يا زعيم

186
00:14:51,070 --> 00:14:53,200
،قد لا أكسب أيّ شيء من أفعالي

187
00:14:55,160 --> 00:14:57,290
.لكن ومع ذلك هناك سببٌ وحيد لرغبتي بالذّهاب

188
00:15:01,580 --> 00:15:03,590
.لأنّه صديقي

189
00:15:22,980 --> 00:15:26,020
،كان الكتاب الأخير بالسّلسلة رائعًا

190
00:15:26,150 --> 00:15:28,230
.لكن كان هناك عيبٌ واحد

191
00:15:28,990 --> 00:15:32,410
.لقد حُذفت الكثير من الصفحات من نهايته

192
00:15:32,910 --> 00:15:35,280
.فلتكتبه أنت إذًا

193
00:15:35,780 --> 00:15:39,000
:قبل الجزء المحذوف، يوجد سطرٌ يقول

194
00:15:39,120 --> 00:15:40,960
“.يعيش النّاس لينقذوا أنفسهم”

195
00:15:41,870 --> 00:15:48,500
“.ستفهم ذلك لحظة موتك”

196
00:15:51,470 --> 00:15:58,470
والآن، أظنّ أنّ ذلك الرّجل الّذي أعطاني
.الكتاب كان يعلم أنّي قاتلٌ مأجور

197
00:15:59,520 --> 00:16:04,350
.كان يعرف، وقد تحدّث إليّ لكي أتوقّف عن القتل

198
00:16:05,400 --> 00:16:09,480
.أخبرَني باسمه عندما تقابلنا أوّل مرّة

199
00:16:09,980 --> 00:16:11,780
،نسيتُ ذلك الاسم منذ وقتٍ طويل

200
00:16:12,320 --> 00:16:15,490
.لكنّي تذّكرته حديثًا

201
00:16:16,320 --> 00:16:18,160
من أنت؟

202
00:16:18,620 --> 00:16:19,660
أنا؟

203
00:16:19,990 --> 00:16:23,080
.اسمي ناتسومي سوسيكي

204
00:16:23,710 --> 00:16:24,580
.هذا صحيح

205
00:16:24,960 --> 00:16:28,800
.كان يحمل نفس اسم كاتب تلك القصّة

206
00:16:32,420 --> 00:16:34,630
.لقد كنتُ بطلاً

207
00:16:35,130 --> 00:16:40,310
.عشتُ مؤمنًا أنّ الرّب قدّر لي حماية موطني

208
00:16:41,060 --> 00:16:43,020
،وفي الحرب العالميّة الأخيرة

209
00:16:43,020 --> 00:16:48,860
هزم فريقي المتكوّن من أربعين رجلاً ستّمائة
.من الأعداء المختبئين في قلعة

210
00:16:49,520 --> 00:16:53,440
.لكنّ ذلك كان كمينًا نصبه مقرّنا الحليف

211
00:16:54,530 --> 00:16:58,450
.في الوقت الّذي كانت بلادنا تخوض محادثات سلام

212
00:16:58,570 --> 00:17:01,370
اعتدنا أن نقدم على أفعال غير عادلة
،من أجل الهيئة العسكريّة

213
00:17:01,370 --> 00:17:04,210
.عن طريق احتلال شبكة نقل العدوّ بعد إدراك السّلام

214
00:17:06,500 --> 00:17:10,290
.وبالطّبع، تمّ اعتبار أفعالنا كجريمة حرب

215
00:17:11,460 --> 00:17:15,470
بالتّالي، فقد أصبح حلفاؤنا أعداءً
.لنا بعد أن وُصِفنا بالمتمرّدين

216
00:17:19,100 --> 00:17:21,970
.أقدم البعض من فريقي على الانتحار

217
00:17:24,640 --> 00:17:28,310
.لكن هنالك من نجى

218
00:17:30,690 --> 00:17:34,820
.خسرنا موطننا وشرفنا

219
00:17:35,650 --> 00:17:41,200
.وأصبحنا أشباحًا يجولون القفار باحثين عن أعداءٍ نقاتلهم

220
00:17:42,830 --> 00:17:46,250
أواثقٌ أنّك لم تستطع تغيير أسلوب حياتك؟

221
00:17:47,210 --> 00:17:50,840
.أقسمتُ لرجالي أنّي سأموت كجنديّ

222
00:17:51,170 --> 00:17:53,550
.لا يمكنني أن أصبح أيّ أحد آخر

223
00:17:56,420 --> 00:17:59,680
.لا... لعلّي كنتُ أستطيع

224
00:18:00,050 --> 00:18:05,930
لربّما كنتُ أستطيع إعادة صياغة أسلوب
.حياتي وأصبح شخصًا ليس بجنديّ

225
00:18:06,560 --> 00:18:09,270
.كما توقّفت أنت عن القتل

226
00:18:11,520 --> 00:18:13,860
.أندم على شيءٍ واحد

227
00:18:14,440 --> 00:18:16,900
.لم أودّع صديقي

228
00:18:18,070 --> 00:18:22,450
الرّجل الّذي كان صديقي الوحيد
.بهذا العالم الّذي أعيش فيه

229
00:18:23,120 --> 00:18:27,460
.بدا أنّه سئم من العالم وينتظر موته

230
00:18:28,250 --> 00:18:32,460
أكان يبحث عن الموت مثلي؟

231
00:18:34,000 --> 00:18:34,960
.كلاّ

232
00:18:35,510 --> 00:18:37,170
.أظنّ أن ذلك مختلف

233
00:18:49,810 --> 00:18:51,310
.ساكونوسكي

234
00:18:52,150 --> 00:18:56,360
.حتّى طلقتك الأخيرة كانت مثاليّة

235
00:19:07,540 --> 00:19:08,580
!أوداساكو

236
00:19:16,800 --> 00:19:18,590
.أنت غبيّ يا أوداساكو

237
00:19:19,170 --> 00:19:20,800
...أنت غبيّ بالكامل

238
00:19:20,800 --> 00:19:21,970
...أجل

239
00:19:24,140 --> 00:19:26,180
لِمَ سايرته في ما يريده؟

240
00:19:26,680 --> 00:19:27,930
...دازاي

241
00:19:28,720 --> 00:19:31,690
.هناك ما أريد أن أخبرك به

242
00:19:32,400 --> 00:19:33,440
!لا

243
00:19:33,440 --> 00:19:34,480
!لا تفعل

244
00:19:34,690 --> 00:19:36,520
!قد تنجو

245
00:19:36,520 --> 00:19:37,940
!لا، بل ستنجو

246
00:19:37,940 --> 00:19:39,150
—لذا لا تتحدّث وكأنّك سـ

247
00:19:39,150 --> 00:19:40,190
.أصغِ إليّ

248
00:19:42,070 --> 00:19:50,250
أخبرتني أنّك قد تجد سببًا لتعيش إن عشتَ
.في عالمٍ من العنف وإراقة الدّماء

249
00:19:50,450 --> 00:19:51,750
.أجل، قلتُ ذلك

250
00:19:51,750 --> 00:19:53,330
لكن من يهتم لِما قلته الآن؟

251
00:19:53,460 --> 00:19:55,040
.لن تجده

252
00:19:56,340 --> 00:19:58,920
.يجب أن تدرك ذلك بالفعل

253
00:19:59,510 --> 00:20:02,930
،سواء كنتَ في الجانب الّذي يقتل النّاس أو الّذي ينقذهم

254
00:20:03,180 --> 00:20:06,350
.فلا شيء ممّا تتوقّعه سيأتيك

255
00:20:09,060 --> 00:20:13,520
.لا شيء في هذا العالم يستطيع أن يملأ فراغ وحدتك

256
00:20:14,400 --> 00:20:18,480
.ستجوب الظّلام للأبد

257
00:20:23,530 --> 00:20:24,820
...أوداساكو

258
00:20:25,820 --> 00:20:27,530
ماذا يجب أن أفعل؟

259
00:20:29,290 --> 00:20:31,660
.كن في الجانب الّذي ينقذ النّاس

260
00:20:33,210 --> 00:20:35,210
،وإن كان الجانبان سيّان

261
00:20:35,370 --> 00:20:37,040
.كن رجلاً صالحًا

262
00:20:37,750 --> 00:20:40,670
.أنقذ الضّعفاء واحمِ اليتامى

263
00:20:41,800 --> 00:20:45,550
...لا الخير ولا الشرّ يعنيك بشيء، أعلم

264
00:20:45,840 --> 00:20:49,680
.لكنّ ذلك سيجعلك شخصًا أفضل بقليل على الأقلّ

265
00:20:51,350 --> 00:20:52,680
أنّى لك أن تكون متأكّدًا من ذلك؟

266
00:20:53,100 --> 00:20:54,560
.بالطّبع أنا متأكّد

267
00:20:55,060 --> 00:20:57,020
.أعلم ذلك أكثر من الجميع

268
00:20:57,730 --> 00:21:02,780
.لأنّني... صديقك

269
00:21:07,700 --> 00:21:08,740
.فهمت

270
00:21:09,200 --> 00:21:10,490
.سأفعل ذلك

271
00:21:11,660 --> 00:21:17,630
...يعيش النّاس لينقذوا أنفسهم

272
00:21:18,750 --> 00:21:22,760
...كم هذا صحيح

273
00:22:05,590 --> 00:22:07,680
لم أتوقّع أن أجد شخصًا مهمًّا في وزارة الدّاخليّة

274
00:22:07,680 --> 00:22:09,640
.يشرب وحيدًا في حانةٍ متواضعة كهذه

275
00:22:09,800 --> 00:22:13,060
.يا للوحدة أيّها الرّئيس تانيدا

276
00:22:13,390 --> 00:22:14,600
...أنت

277
00:22:14,600 --> 00:22:16,100
...دعك من ذلك

278
00:22:16,430 --> 00:22:20,350
.سمعتُ شائعات أنّك كنتَ متخفيًّا لوقتٍ طويل

279
00:22:22,110 --> 00:22:24,610
.أبحثُ عن عملٍ جديد

280
00:22:25,110 --> 00:22:27,530
أتعرف أيّ مناصب جيّدة؟

281
00:22:27,740 --> 00:22:30,870
هل تريد أن تنضمّ إلى قسم الموهوبين
...للعمليّات الخاصّة؟ إن كان الأمر كذلك

282
00:22:30,870 --> 00:22:33,160
.أرفض العرض مع الأسف

283
00:22:33,160 --> 00:22:35,870
لا أبلي جيّدًا في مقرّ عملٍ يملك
.الكثير من التّنظيمات

284
00:22:36,620 --> 00:22:38,910
ما الّذي تبحث عنه إذًا؟

285
00:22:39,620 --> 00:22:41,630
.أن أعمل على مساعدة النّاس

286
00:22:48,050 --> 00:22:50,430
...لديّ الكثير من الأسئلة لك، لكن

287
00:22:50,760 --> 00:22:53,050
.ماضيك قذرٌ جدًّا

288
00:22:53,510 --> 00:22:57,180
.عليك أن تختفي لسنتين على الأقلّ لتنظّف سجلّك

289
00:22:57,640 --> 00:23:01,810
...لكن أفترض أنّني قد أملك دليلاً

290
00:23:04,980 --> 00:23:06,530
.أخبرني به

291
00:23:09,860 --> 00:23:12,660
.هناك منظّمة مسلحة للأفراد الموهوبين

292
00:23:12,990 --> 00:23:17,540
يتكفّلون بالقضايا غير المؤكّدة قانونيًّا
.ولا يمكن مسّها من قبل العمّال المدنيّين

293
00:23:18,450 --> 00:23:21,500
.رئيس المنظّمة رجلٌ نزيه

294
00:23:21,830 --> 00:23:24,170
.قد تجده يتماشى مع ما تريده

295
00:23:27,960 --> 00:23:30,220
أيمكنني القيام بعملٍ ينقذ النّاس؟