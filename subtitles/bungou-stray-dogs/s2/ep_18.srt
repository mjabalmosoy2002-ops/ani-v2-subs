1
00:00:03,350 --> 00:00:04,730
...بضربةٍ واحدة

2
00:00:07,060 --> 00:00:11,940
من الضروريّ إصابة نقطة
.العدوّ الحيويّة بضربةٍ واحدة

3
00:00:13,860 --> 00:00:14,860
.إنّك فظيع

4
00:00:15,450 --> 00:00:16,320
.حسنًا

5
00:00:18,490 --> 00:00:20,040
مهلًا! ما الّذي تفعله؟

6
00:00:21,540 --> 00:00:23,790
.أكتب رسالةً لصديق

7
00:01:54,920 --> 00:01:58,130
اشحنوا كلّ البضائع المستوردة
!من بلادي إلى المقصورة رقم ثلاثة

8
00:01:58,930 --> 00:02:00,680
!إن كسرتم شيئًا فستدفعون ثمنه

9
00:02:01,720 --> 00:02:03,310
...يا إلهي

10
00:02:03,310 --> 00:02:06,140
لِم عليّ الإشراف على عمليّة الشّحن؟

11
00:02:17,650 --> 00:02:18,610
.اصمتي

12
00:02:18,610 --> 00:02:19,700
ماذا؟

13
00:02:19,700 --> 00:02:22,870
.نظراتكِ مزعجة وتعيق سماعي لصوت الرّب

14
00:02:22,870 --> 00:02:24,160
أهذا صحيح؟

15
00:02:24,160 --> 00:02:27,330
.يا لك من قسٍّ متديّن

16
00:02:27,330 --> 00:02:30,000
...إذًا ستروقك هذه الآية

17
00:02:30,540 --> 00:02:32,590
".إنّك تراب، وإلى التّراب تعود"

18
00:02:39,880 --> 00:02:43,390
.سفر التكوين 3 الآية 19

19
00:02:43,390 --> 00:02:45,810
،بينما يؤدّي الجميع واجبهم على اليابسة

20
00:02:45,810 --> 00:02:48,520
.فمسؤوليّة حماية هذه السّفينة تقع على عاتقنا

21
00:02:49,520 --> 00:02:50,730
أنسيت ذلك؟

22
00:02:52,060 --> 00:02:54,690
أواثقةٌ أنّكِ لستِ من نسيتِ يا آنستي؟

23
00:02:55,400 --> 00:02:59,650
.إنزال العقاب على الآثمين هو واجبي المقدّس

24
00:02:59,650 --> 00:03:02,070
.أرحّب بالأعداء مهما كان عددهم

25
00:03:02,070 --> 00:03:08,200
:القدرة
————
الحرف
القرمزيّ

26
00:03:02,240 --> 00:03:08,200
عامل
بالنّقابة
————
ناثانيال. هـ

27
00:03:02,450 --> 00:03:06,290
.سيُكفّرون عن ذنوبهم بأرواحهم

28
00:03:07,040 --> 00:03:08,200
...أم أنّكِ

29
00:03:08,200 --> 00:03:10,920
ترغبين بالتّكفير أيضًا؟

30
00:03:08,200 --> 00:03:14,630
:القدرة
————
ذهب مع
الرّيح

31
00:03:08,410 --> 00:03:14,630
متدرّبة
بالنّقابة
————
مارغاريت. م

32
00:03:10,920 --> 00:03:14,630
.أنت لستَ جديرًا حتّى بتلميع حذائي

33
00:03:15,340 --> 00:03:17,920
...المعذرة

34
00:03:19,170 --> 00:03:22,550
.عـ-عثرنا على هذه الرّسالة ضمن الحمولة

35
00:03:22,550 --> 00:03:23,430
رسالة؟

36
00:03:27,850 --> 00:03:29,060
...آنساتي سادتي

37
00:03:30,390 --> 00:03:35,400
آمل أنّكم توصّلتم بهذه الرّسالة
.وأنتم في تمام العافية

38
00:03:35,400 --> 00:03:37,780
!رينتارو أيها النّذل الغبيّ

39
00:03:36,070 --> 00:03:38,150
.أكتب لكم بخصوص الصّدام الأخير

40
00:03:38,150 --> 00:03:39,530
،مع أنّ هذا قد يبدو متعجرفًا

41
00:03:39,530 --> 00:03:44,240
.إلّا أنّي أريد أن أحيطكم علمًا بأصول النّقابة الّتي سنبيدها قادمًا

42
00:03:42,660 --> 00:03:44,240
!أعد إليّ قلمي الملوّن

43
00:03:44,240 --> 00:03:48,080
...هذه هي أصول النّقابة الّتي سنبيدها"

44
00:03:51,000 --> 00:03:54,750
.أوًلًا، سفينتكم الفاخرة، زيلدا

45
00:03:54,750 --> 00:03:58,460
ثانيًا حياة السّيد ناثانيال"

46
00:03:58,460 --> 00:04:01,800
".ثالثًا، حياة السّيدة مارغاريت

47
00:04:01,800 --> 00:04:02,720
ماذا؟

48
00:04:02,720 --> 00:04:06,640
".مع تحيّاتي، زعيم مافيا الميناء، موري أوغاي"

49
00:04:06,640 --> 00:04:09,010
يريد إبادتنا مع السّفينة؟

50
00:04:09,390 --> 00:04:10,560
.وكأنّ ذلك ممكن

51
00:04:12,270 --> 00:04:14,810
.سنبحر فور الانتهاء من شحن الحمولة

52
00:04:15,520 --> 00:04:16,360
كم سيستغرق ذلك؟

53
00:04:16,900 --> 00:04:18,070
.ساعتان إضافيّتان تقريبًا

54
00:04:18,070 --> 00:04:19,940
.أنهوا الأمر في ثلاثين دقيقة

55
00:04:19,940 --> 00:04:21,030
!ثلاثون دقيقة؟

56
00:04:21,030 --> 00:04:22,990
،بينما تستمرّ عمليّة الشّحن الاعتياديّة

57
00:04:22,990 --> 00:04:26,450
.قوموا بإفراغ حمولة المروحيّة في منصّة الهبوط

58
00:04:26,450 --> 00:04:29,200
.وشدّدوا الحماية حول السّفينة

59
00:04:29,200 --> 00:04:30,740
هل أنت جاد؟

60
00:04:30,740 --> 00:04:33,540
.رسالة التّهديد السّخيفة هذه مجرّد خدعة

61
00:04:34,420 --> 00:04:35,370
هل أنتِ واثقة؟

62
00:04:36,080 --> 00:04:39,550
،بما أنّ نقابتنا لا تملك أيّ قاعدةٍ على اليابسة

63
00:04:39,550 --> 00:04:41,760
.فهذه السّفينة تعتبر قاعدتنا الأماميّة

64
00:04:41,760 --> 00:04:43,050
وماذا في ذلك؟

65
00:04:43,050 --> 00:04:47,010
.دفاعنا مكشوفٌ حاليًا بينما نقوم بالتّزوّد بالإمدادات

66
00:04:47,010 --> 00:04:51,060
،منظّمات مستخدمي القدرات المعادية لنا
.قد لا تشكّل تهديدًا على حياتنا

67
00:04:51,060 --> 00:04:55,140
.لكنّهم قد يتمكّنون من إغراق السّفينة بهجومٍ مفاجئ

68
00:04:56,020 --> 00:04:57,310
.سيّد ناثانيال

69
00:05:00,020 --> 00:05:02,030
.لقد وجدنا رجلًا مثيرًا للرّيبة

70
00:05:06,320 --> 00:05:07,950
.وجدناه على الرّصيف

71
00:05:07,950 --> 00:05:10,120
.حاول الفرار لِذا قمنا بالقبض عليه

72
00:05:10,870 --> 00:05:12,620
.لقد كان يحمل هذه

73
00:05:13,160 --> 00:05:16,170
إنه مجرّد قاطع طريقٍ
.من هذا البلد الشّبيه بالجزيرة

74
00:05:16,170 --> 00:05:19,000
.رأيتُ صورتك في تقرير

75
00:05:19,460 --> 00:05:21,800
.أيّها السّيد مفتعل التّفجيرات من مافيا الميناء

76
00:05:21,800 --> 00:05:24,260
من أنا؟

77
00:05:24,260 --> 00:05:25,760
أين أنا؟

78
00:05:26,090 --> 00:05:30,220
.حاولتَ تفجير قطار، لكنّ وكالة التّحري أوقفتك

79
00:05:30,220 --> 00:05:31,560
!تلك كانت تجربة

80
00:05:31,560 --> 00:05:33,970
!حتّى الفشل يعتبر عيّنةً قيّمة

81
00:05:34,310 --> 00:05:36,350
أتريدني أن أحوّله إلى ممياء؟

82
00:05:36,350 --> 00:05:40,020
.كلّا، فلديّ فكرةٌ عامّة عن خطّة العدوّ

83
00:05:40,020 --> 00:05:43,360
.لقد كان مكلّفًا بزرع القنابل على سفينتنا

84
00:05:44,150 --> 00:05:45,990
.يا لها من منظّمةٍ ساذجة

85
00:05:49,370 --> 00:05:50,160
...دمه

86
00:05:50,160 --> 00:05:52,660
.الحرف القرمزيّ كلمة الرّب

87
00:05:52,990 --> 00:05:57,830
قدرة الحكم الّتي تُنزِل العقاب على الآثمين
.وتخلّف عليهم علامةً لا تزول أبدًا

88
00:05:56,330 --> 00:05:57,830
!مـ-مهلًا

89
00:05:57,830 --> 00:06:00,540
!حـ- حسنًا، فهمت! أستسلم! سأخبركم بكلّ شيء

90
00:06:00,540 --> 00:06:03,590
!في الحقيقة، أنا السّفير الّذي يُمثّل القائد العام للكون

91
00:06:03,590 --> 00:06:06,670
!وستقع في ورطةٍ كبيرة إن مسستني بسوء

92
00:06:04,050 --> 00:06:06,670
.يا إلهي، ارحمني

93
00:06:09,720 --> 00:06:11,600
...يبدو أنّك

94
00:06:11,930 --> 00:06:14,970
.تأبى التّوبة وتطلب التّكفير عن ذنوبك

95
00:06:16,060 --> 00:06:19,690
.إذًا فهذه القنابل على هيئة ليمون هي قدرتك

96
00:06:19,690 --> 00:06:21,560
.كم هذا سخيف

97
00:06:22,060 --> 00:06:24,820
.حتّى الشّخص العاديّ يمكنه صنع القنابل

98
00:06:24,820 --> 00:06:29,200
إن كانوا يظنّون أنّ بإمكانهم إغراق
،هذه السّفينة بقدرة شخصٍ من طينتك

99
00:06:29,660 --> 00:06:32,030
.فلقد تمّ الاستخفاف بالنّقابة

100
00:06:37,700 --> 00:06:39,750
.أدعو الرّب أن يغفر لك

101
00:06:41,080 --> 00:06:43,710
.سننزل الحمولة على السّفينة الآن

102
00:06:46,550 --> 00:06:47,460
الرّب؟

103
00:06:48,090 --> 00:06:49,090
أقلت الرّب؟

104
00:06:50,430 --> 00:06:53,180
أتقصد أنّك تسمع صوت الرّب؟

105
00:06:54,140 --> 00:06:59,560
العِلم هو اللّغة الوحيدة الّتي تخوّلنا
.فهم هذا الكون الّذي خلقه الرّب

106
00:07:00,560 --> 00:07:02,020
لم يتأثّر بالانفجار؟

107
00:07:02,350 --> 00:07:04,770
.لديّ أنباءٌ سيّئةٌ لكما

108
00:07:04,770 --> 00:07:07,990
.واجبكم هو الإيمان فحسب يا رجال الدّين

109
00:07:07,990 --> 00:07:11,110
.لكن جوهر العِلم هو التّشكيك في كلّ شيء

110
00:07:11,570 --> 00:07:16,290
كان عليك أن تُشكّك أكثر
.في قدرة صنع القنابل هذه

111
00:07:16,290 --> 00:07:20,830
،صحيحٌ أنّي أصنع هذه القنابل لتمضية الوقت

112
00:07:20,830 --> 00:07:25,790
لكنّ قدرتي الحقيقيّة هي عدم تكبّد
!أضرارٍ من القنابل الّتي على هيئة ليمون

113
00:07:26,210 --> 00:07:26,840
!اللّيمون

114
00:07:26,840 --> 00:07:31,380
،ذلك الشّكل المغزليّ الجميل هو الهندسة المطلقة
!كما أنّه مدمّر هذا العالم الممل

115
00:07:31,380 --> 00:07:36,350
ولإيضاح الأمر، إليكما هديّة
.منّي ومن القائد الأعلى للكون

116
00:07:39,270 --> 00:07:39,980
...لا يعقل

117
00:07:42,770 --> 00:07:44,610
!فلتخلوا السّفينة جميعكم

118
00:08:03,290 --> 00:08:04,420
...السّفينة

119
00:08:04,790 --> 00:08:06,630
!من يكون ذلك الرّجل بحقّ؟

120
00:08:06,630 --> 00:08:09,460
.يبدو أنّ رسالة التّهديد لم تكن مجرّد خدعة

121
00:08:11,670 --> 00:08:14,890
.وما يزال هناك هدفان متبقّيان

122
00:08:16,140 --> 00:08:18,810
.سيداهمنا العدوّ في أيّ لحظة

123
00:08:18,810 --> 00:08:20,850
.سنواجههم هنا

124
00:08:20,850 --> 00:08:24,770
،إن أوقفنا هجومهم المفاجئ
،فمهما كانت قدراتهم وتِعدادهم

125
00:08:24,770 --> 00:08:26,940
.لا سبيل لهم لمقارعتي

126
00:08:27,650 --> 00:08:30,440
.هذا هو تفكير العدوّ على الأغلب

127
00:08:31,570 --> 00:08:34,740
.لا جدال في قوّة مستخدمي القدرات المنتمين للنّقابة

128
00:08:34,740 --> 00:08:38,620
.حتّى نخبة رجالنا سيواجهون صعوبةً في الإطاحة بهم

129
00:08:40,240 --> 00:08:41,700
...ولهذا

130
00:08:44,540 --> 00:08:49,250
.الآن هو الوقت المثاليّ لإرسال قطعتي المتلهّفة

131
00:08:57,800 --> 00:09:00,100
.عليل البحر خانقٌ حقًا

132
00:09:15,150 --> 00:09:16,910
.فلننتهِ من هذا بسرعة

133
00:09:18,320 --> 00:09:20,530
هل أنت قاتلٌ من مافيا الميناء؟

134
00:09:20,530 --> 00:09:23,450
كيف حالك أيّها الأخ من النّقابة؟

135
00:09:23,450 --> 00:09:24,790
.في أسوء حالاتي

136
00:09:24,790 --> 00:09:28,580
.وكأنّي قابلتُ الشّيطان المذكور في الإنجيل

137
00:09:29,250 --> 00:09:30,540
هلّا أخبرتني باسمك؟

138
00:09:32,300 --> 00:09:33,550
.ديابلو

139
00:09:34,880 --> 00:09:37,090
.إذًا فنحن على جبل حرمون

140
00:09:37,630 --> 00:09:41,560
هل أنتَ بلاءٌ بعثه الرّب لاختبار
إيمان هذا العبد المتواضع؟

141
00:09:41,560 --> 00:09:43,520
أتريد بلاءً؟

142
00:09:43,520 --> 00:09:45,140
!سألبّي رغبتك إذًا

143
00:09:49,100 --> 00:09:51,520
".لا تناديني بـ"الأخ

144
00:09:51,520 --> 00:09:55,570
!أنا قسّ ولستُ آثارًا من روما القديمة

145
00:09:55,570 --> 00:09:58,860
،إيّاك والظنّ أنّ هذا سيكون كافيًا لاختبار إيماني

146
00:09:58,860 --> 00:09:59,870
!أيها الحثالة

147
00:10:02,870 --> 00:10:05,660
!تُبْ يا عضو مافيا الميناء الصّغير

148
00:10:05,660 --> 00:10:07,120
!مثير

149
00:10:11,840 --> 00:10:17,300
لدى العدوّ قدرةٌ متوسّطة المدى في
.التّلاعب بالأشياء، مناسبة للدّفاع والهجوم

150
00:10:17,630 --> 00:10:19,840
.إنّها شبيهةٌ بقدرتي

151
00:10:20,300 --> 00:10:21,600
...في هذه الحالة

152
00:10:23,100 --> 00:10:26,060
!صاحب القدرة الأقوى سينتصر

153
00:10:26,640 --> 00:10:28,190
راشومون

154
00:10:26,980 --> 00:10:28,100
!راشومون

155
00:10:30,650 --> 00:10:31,860
!الحرف القرمزيّ

156
00:10:30,730 --> 00:10:32,270
الحرف القرمزيّ

157
00:10:37,400 --> 00:10:39,740
أهذا كلّ ما لديك أيها الأخ؟

158
00:10:42,910 --> 00:10:46,620
.إذًا أنت لست بشيطان

159
00:10:46,620 --> 00:10:47,750
ماذا؟

160
00:10:49,120 --> 00:10:51,830
الدّم المُسال على معطفي يتحوّل إلى كتابة؟

161
00:10:53,090 --> 00:10:57,840
.أنت محض وحشٍ بلا روح يلتهم الضّعفاء

162
00:10:58,130 --> 00:11:03,350
واثقٌ أنّك لم تقاتل من قبل سوى
ذوي القدرات الأضعف منك، صحيح؟

163
00:11:06,430 --> 00:11:08,520
.مافيا الميناء مجرّد نكرة

164
00:11:08,930 --> 00:11:11,770
!سأستعيد سمعة عائلتي

165
00:11:15,820 --> 00:11:17,190
...معطفي يتفتّت

166
00:11:17,570 --> 00:11:19,150
قدرة تَجوية؟

167
00:11:19,150 --> 00:11:23,030
الخسارة أمام أمثالك الّذين لم
...يذوقوا من قبل طعم الهزيمة والإذلال

168
00:11:23,030 --> 00:11:25,030
...أمرٌ قطعًا لن أستطيع

169
00:11:25,450 --> 00:11:26,540
!تحمّله

170
00:11:30,580 --> 00:11:33,830
أقلتِ لم أذق طعم الهزيمة؟

171
00:11:39,010 --> 00:11:40,170
!مارغاريت

172
00:11:41,010 --> 00:11:44,640
.الهزيمة والإذلال يلازمانني دومًا

173
00:11:50,480 --> 00:11:54,100
.لطالما كنتُ مهزومًا أهوم في الظّلام

174
00:11:54,100 --> 00:11:59,190
...كما لو أنّ بؤسًا كهذا

175
00:11:59,190 --> 00:12:00,320
!سيأثّر عليّ

176
00:12:10,330 --> 00:12:12,160
...ليس الآن

177
00:12:12,500 --> 00:12:14,960
.هذا ليس جرحًا سبّبته بالحرف القرمزيّ

178
00:12:15,540 --> 00:12:19,130
أيعقل أنّه جاء إلى هنا مع تلك الإصابة البليغة؟

179
00:12:19,130 --> 00:12:20,920
!هذا لا يعدّ شيئًا! هلمّ إليّ

180
00:12:21,630 --> 00:12:24,050
.قاتلني بكلّ ما أوتيت

181
00:12:24,050 --> 00:12:27,220
...وإلّا كان قدومي إلى هنا

182
00:12:27,220 --> 00:12:28,470
!بلا معنى

183
00:12:29,180 --> 00:12:31,890
ولِم عساك تتمادى إلى هذا الحدّ؟

184
00:12:31,890 --> 00:12:35,100
.عزائي الوحيد كلمةٌ واحدة

185
00:12:35,100 --> 00:12:38,440
.كلمةٌ بسيطةٌ وتافهة من شخصٍ مُعيّن

186
00:12:39,020 --> 00:12:41,400
،لأجل سماع تلك الكلمة منه فقط

187
00:12:41,400 --> 00:12:46,240
نهضت مرارًا وتكرارًا رغم كلّ
!الهزائم المذلّة الّتي تجرّعتها

188
00:12:47,200 --> 00:12:50,580
.هذا الرّجل قاتلٌ وحشيّ من مافيا الميناء

189
00:12:51,200 --> 00:12:54,000
.إلّا أنّه في الوقت ذاته يتوق إلى شيءٍ ما بشدّة

190
00:12:54,620 --> 00:12:57,750
.شيءٌ يمكنه أن يضحّي بحياته لأجله

191
00:12:57,750 --> 00:13:01,460
.وبحماسٍ يكاد ينافس الإيمان الدّينيّ

192
00:13:03,260 --> 00:13:06,130
طلبتَ منّي أن أقاتل بكلّ ما أوتيت، صحيح؟

193
00:13:08,550 --> 00:13:13,060
.لقد غيّرتُ رأيي وسأُلبّي طلبك

194
00:13:18,690 --> 00:13:19,110
!ماذا؟

195
00:13:47,760 --> 00:13:49,090
...راشومون

196
00:13:49,680 --> 00:13:52,430
!فكّ البوّابات اللّا متناهية

197
00:14:05,440 --> 00:14:06,780
...مارغاريت

198
00:14:23,670 --> 00:14:27,550
يجب أن يعلم المرء أنّه يستحقّ الحياة
!من الآخرين وإلّا فلن يستطيع المضيّ قدمًا

199
00:14:27,550 --> 00:14:30,590
!كيف لك ألا تفهم أمرًا بهذه البساطة؟

200
00:14:32,850 --> 00:14:38,140
.لستُ بحاجةٍ لأن تخبرني بشيءٍ أعلمه سلفًا

201
00:14:40,650 --> 00:14:42,860
!أشعر بالملل

202
00:14:42,860 --> 00:14:44,480
!أريد الخروج

203
00:14:44,980 --> 00:14:46,900
أمن شيءٍ غير مألوفٍ في كاميرات المراقبة؟

204
00:14:47,490 --> 00:14:49,990
.لا شيء غير الملل

205
00:14:50,360 --> 00:14:52,620
الطّريقة الوحيدة للعصف بهذا المكان

206
00:14:53,370 --> 00:14:55,660
.هي عبر نفق السّكة الحديديّة التّحت أرضيّ

207
00:14:56,370 --> 00:14:58,830
،وحتّى إن حاول العدوّ الدّخول

208
00:14:58,830 --> 00:15:03,290
.فسترصدهم كاميرات المراقبة قبل وصولهم إلى هنا

209
00:15:03,290 --> 00:15:06,420
.دون ذكر الفخاخ المنصوبة على طول السّكة

210
00:15:06,420 --> 00:15:08,760
.الحرب مملّة للغاية

211
00:15:10,090 --> 00:15:12,970
.استهلكت مخزوني من الحلويّات في أقلّ من يوم

212
00:15:14,640 --> 00:15:15,640
!صحيح

213
00:15:15,640 --> 00:15:18,100
!فلنلعب لعبة هانافودا بهذا يا يوسانو-سان

214
00:15:18,100 --> 00:15:19,980
بمَ سنراهن؟

215
00:15:21,980 --> 00:15:26,020
الهجوم على قواعد العدوّ
.دائمًا ما يغمر قلبي بالبهجة

216
00:15:26,690 --> 00:15:28,440
.حان وقت القيام بالخطوة التّالية

217
00:15:28,440 --> 00:15:29,900
كيف تجري التّحضيرات؟

218
00:15:29,900 --> 00:15:31,280
.كلّ شيءٍ في أتمّه

219
00:15:31,280 --> 00:15:35,740
لديك قوّةٌ أكثر من كافية
.لسحق وكالة التّحرّي المسلّحة

220
00:15:36,120 --> 00:15:38,750
.أتطلّع لسماعِ لحنٍ بديع

221
00:15:39,120 --> 00:15:40,660
ما الخطب؟

222
00:15:40,660 --> 00:15:43,460
أيها الرّئيس، أظنّ أنّه من الأفضل
.أن نستدعي الفريق الهجوميّ

223
00:15:44,630 --> 00:15:45,340
أهو العدوّ؟

224
00:15:46,290 --> 00:15:48,460
كم عدد المهاجمين؟

225
00:15:51,930 --> 00:15:53,050
.واحد

226
00:15:56,930 --> 00:15:59,930
الحلقة الثّامنة عشرة

227
00:15:56,930 --> 00:15:59,930
كلاب الأدب الشاردة

228
00:16:03,940 --> 00:16:04,810
...مي-تشان

229
00:16:05,310 --> 00:16:10,610
سآتي إليك فور انتهاء هذه الفوضى، اتّفقنا؟

230
00:16:11,360 --> 00:16:13,030
!نـ-نـ-ناومي-تشان

231
00:16:13,030 --> 00:16:13,990
...هارونو-سان

232
00:16:13,990 --> 00:16:15,780
!كـ-كـ-كنت أعمل! أُقسم

233
00:16:15,780 --> 00:16:18,080
!فنحن السّكرتيرات جزءٌ من الوكالة أيضًا

234
00:16:24,040 --> 00:16:27,290
انفجار سفينةٍ سيّاحيّة في ميناء يوكوهاما التّجاري؟

235
00:16:28,130 --> 00:16:30,460
أيعقل أنّها سفينة النّقابة؟

236
00:16:31,130 --> 00:16:32,840
ما سبب الانفجار إذًا؟

237
00:16:33,590 --> 00:16:36,680
.لا بدّ أنّه العدوّ الآخر المولوع بالتّفجير

238
00:16:36,680 --> 00:16:39,560
...قد تكون الوكالة هدفهم التّالي

239
00:16:40,270 --> 00:16:42,310
.أتساءل إن كان أخي بخير

240
00:16:45,520 --> 00:16:47,310
.لا تقلقي يا ناومي-تشان

241
00:16:48,690 --> 00:16:51,230
!فنحن نعلم أنّ مي-تشان بخير

242
00:16:51,230 --> 00:16:52,860
.انسي الأمر رجاءً

243
00:16:55,570 --> 00:16:58,660
.توقّفت الكاميرات 3 و4 و8 عن الإرسال

244
00:16:58,660 --> 00:17:00,330
!فعّلا الأسلحة الآليّة

245
00:17:12,880 --> 00:17:16,010
أتستقبلون مبعوثًا خاصًا بهذه الألعاب؟

246
00:17:16,010 --> 00:17:17,680
.إنّكم تفتقرون للموظّفين لدرجةٍ تدفعني للبكاء

247
00:17:18,010 --> 00:17:20,060
.إن كان أحدكم حيّا هناك، فليخرج

248
00:17:21,010 --> 00:17:21,930
...أيها الرّئيس

249
00:17:24,390 --> 00:17:26,690
أتوافقونني الرّأي؟

250
00:17:33,150 --> 00:17:34,360
...بربّكم

251
00:17:34,740 --> 00:17:36,570
اثنان فقط؟

252
00:17:36,570 --> 00:17:40,030
،إن لم يرضيك الاستقبال
.فعُد عندما تحجز موعدًا

253
00:17:40,410 --> 00:17:44,410
أوتظنّين أنّ المافيا في حاجةٍ
إلى موعدٍ لتسحق قاعدتكم؟

254
00:17:44,410 --> 00:17:46,580
!بالفعل، لا أظنّ ذلك

255
00:17:46,580 --> 00:17:48,880
.إن أردتَ سحقها فافعل

256
00:17:49,830 --> 00:17:52,340
.لكن هذا ليس سبب مجيئك

257
00:17:52,670 --> 00:17:53,550
أليس كذلك؟

258
00:17:54,510 --> 00:17:55,550
وما أدراكِ؟

259
00:17:55,550 --> 00:17:57,880
.نحن متحرّون كما تعلم

260
00:17:57,880 --> 00:18:01,930
ما فائدتنا إن لم نستطع معرفة
نوايا عميلنا من اللّمحة الأولى؟

261
00:18:03,100 --> 00:18:04,770
أين رئيسكم؟

262
00:18:04,770 --> 00:18:06,140
.هناك

263
00:18:08,770 --> 00:18:11,020
.هذه هديّةٌ من زعيمي

264
00:18:12,650 --> 00:18:13,570
...إنّهما

265
00:18:14,440 --> 00:18:16,110
عضوان في النّقابة؟

266
00:18:16,110 --> 00:18:18,110
.لقد أغويناهما بطُعم

267
00:18:18,110 --> 00:18:21,160
.الوقت والمكان الّذي سيظهران به مدوّنٌ هنا

268
00:18:21,990 --> 00:18:24,160
هذه فرصةٌ لا تعوّض، أليس كذلك؟

269
00:18:24,700 --> 00:18:27,620
بإمكانكم النّيل من عضوي
!تلك النّقابة اللّعينة دفعةً واحدة

270
00:18:30,330 --> 00:18:35,260
بالفعل هذه فرصةٌ مثاليّة لمداهمة
.مستخدمي قدراتٍ من النّقابة

271
00:18:35,670 --> 00:18:39,220
.فهمت. هذا عرضٌ مغري

272
00:18:39,220 --> 00:18:40,220
أليس كذلك؟

273
00:18:40,220 --> 00:18:42,890
.لكن لديّ عرضٌ أفضل

274
00:18:42,890 --> 00:18:48,850
ما رأيك بأن أبتر أطرافك وأجعلك تُقرّ بمخطّطاتكم؟

275
00:18:48,850 --> 00:18:51,230
.يا لها من فكرةٍ رائعة

276
00:18:52,190 --> 00:18:53,230
.فلتحاولي

277
00:18:53,230 --> 00:18:54,230
!كينجي

278
00:18:54,230 --> 00:18:55,280
!حاضر

279
00:18:58,490 --> 00:19:00,200
!ها نحن

280
00:19:00,570 --> 00:19:01,870
!رائع

281
00:19:02,450 --> 00:19:04,870
!احترس رجاءً

282
00:19:06,370 --> 00:19:09,210
!هذا ما أسمّيه عملًا حقيقيًا

283
00:19:15,630 --> 00:19:16,460
!ماذا؟

284
00:19:18,210 --> 00:19:20,010
...تلك القدرة

285
00:19:20,010 --> 00:19:22,510
أنت هو المتلاعب بالجاذبيّة
ناكاهارا تشويا، أليس كذلك؟

286
00:19:23,640 --> 00:19:25,930
...لا بدّ أنّ ذلك اللّعين دازاي قد فتح فمه

287
00:19:25,930 --> 00:19:28,930
!لم تقع قبّعته رغم أنّه يقف رأسًا على عقب

288
00:19:29,270 --> 00:19:31,350
.سكّان المدينة مدهشون حقًا

289
00:19:37,820 --> 00:19:38,860
...والآن

290
00:19:39,940 --> 00:19:42,660
من منكما يريد مواجهة الجاذبيّة؟

291
00:19:46,530 --> 00:19:49,080
.إليكَ جوابي يا مبعوث مافيا الميناء

292
00:19:49,410 --> 00:19:49,950
ماذا؟

293
00:19:50,500 --> 00:19:53,250
،صحيحٌ أنّه لو هزمت وكالة التّحرّي قوّات النّقابة

294
00:19:53,250 --> 00:19:56,040
.فستقلّصون قوّة العدوّ دون تحريك ساكن

295
00:19:56,880 --> 00:20:01,800
وإن حالفكم الحظّ أكثر، فقد تقضي
.وكالة التّحرّي والنّقابة على بعضهما

296
00:20:02,180 --> 00:20:04,760
.لكن لا شيء تخسره أيضًا

297
00:20:05,390 --> 00:20:06,180
صحيح؟

298
00:20:06,180 --> 00:20:08,680
.هذا إن كان ما قلته صحيحًا

299
00:20:09,770 --> 00:20:10,930
...بربّك

300
00:20:10,930 --> 00:20:12,640
ما الّذي تخفيه؟

301
00:20:12,640 --> 00:20:13,520
.لا شيء

302
00:20:14,060 --> 00:20:17,650
ما الخطوة الّتي ستتّخذها مافيا الميناء؟

303
00:20:18,360 --> 00:20:20,150
.ما من خطوات

304
00:20:22,950 --> 00:20:24,070
.فهمت

305
00:20:25,070 --> 00:20:26,620
.هذا ما يجري إذًا

306
00:20:27,780 --> 00:20:31,660
.لا بدّ أنّ النّقابة شكّت مثلنا أنّه فخّ

307
00:20:32,210 --> 00:20:34,620
.لكنّهم قرّروا التّماشي معه

308
00:20:35,080 --> 00:20:38,090
.لأنّه كان طُعمًا تصعب مقاومته

309
00:20:38,630 --> 00:20:40,710
ماذا استخدمتم لإغواء النّقابة؟

310
00:20:43,010 --> 00:20:46,930
،مهما كان البلد الّذي أنت فيه
.فإن الرّيف يهدّئ الرّوح

311
00:20:47,680 --> 00:20:51,470
.حسنًا، هديّة مافيا الميناء ينبغي أن تكون أمامنا

312
00:20:51,470 --> 00:20:56,100
من الواضح أنّه فخٌّ لاستدراجنا. فلم نحن ذاهبون؟

313
00:20:56,520 --> 00:20:58,400
.لأنّ الطُّعم تصعب مقاومته

314
00:20:59,320 --> 00:21:03,950
،إن نجحنا في عمليّة الخطف
.فهزيمة وكالة التّحرّي ستكون محتومة

315
00:21:03,950 --> 00:21:05,910
!استخدمتهم موظّفتينا كطعم؟

316
00:21:05,910 --> 00:21:08,660
.ما زال لديكم الوقت لإنقاذهما

317
00:21:08,660 --> 00:21:12,290
.كما أنّ النّقابة لا تعلم بأنّكم ستتحرّكون

318
00:21:12,620 --> 00:21:13,910
.سيكون فوزًا سهلًا

319
00:21:14,500 --> 00:21:16,580
هل من أكاذيب في كلماته؟

320
00:21:17,210 --> 00:21:19,630
.للأسف لا

321
00:21:21,250 --> 00:21:24,340
.الحقيقة أكثر تأثيرًا في مثل هذه الأوقات

322
00:21:27,510 --> 00:21:31,720
".حتّى لو علمت وكالة التّحرّي بأنّه فخّ، فسيقعون فيه"

323
00:21:32,850 --> 00:21:34,680
.تلك كلمات الزّعيم

324
00:21:35,140 --> 00:21:37,900
!فلتأمر موظّفتينا بالإخلاء فورًا

325
00:21:38,940 --> 00:21:39,860
...وكذلك

326
00:21:41,900 --> 00:21:43,480
.أوصلني بكونيكيدا

327
00:23:16,080 --> 00:23:18,080
وحدنا من نستطيع الوصول
إليهما في الوقت المناسب؟

328
00:23:19,870 --> 00:23:20,460
.مفهوم

329
00:23:21,330 --> 00:23:23,540
.حاضر. سنتوجّه إلى هناك فورًا

330
00:23:28,300 --> 00:23:29,840
الرّئيس؟

331
00:23:30,300 --> 00:23:30,930
.أجل

332
00:23:32,680 --> 00:23:33,550
ماذا قال؟

333
