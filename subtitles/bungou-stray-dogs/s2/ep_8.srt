1
00:00:01,220 --> 00:00:06,400
والآن، لِمَ لا تأتي معي أيّها الولد النّمر؟

2
00:00:07,100 --> 00:00:09,100
.هذا يحدث مجدّدًا

3
00:00:10,040 --> 00:00:12,670
...إلاّ أنّي

4
00:00:13,860 --> 00:00:14,740
.انتظر

5
00:00:17,660 --> 00:00:20,200
ألستِ مع مافيا الميناء؟

6
00:00:20,550 --> 00:00:21,440
.كلاّ

7
00:00:21,650 --> 00:00:23,420
.اسمي كيوكا

8
00:00:23,780 --> 00:00:24,870
.وأنا مع الوكالة

9
00:00:27,290 --> 00:00:28,920
.يا لها من بلاد همجيّة

10
00:00:29,220 --> 00:00:31,290
...لا أصدّق أن تكون فتاةٌ صغيرة مثلكِ

11
00:00:32,000 --> 00:00:33,160
!انتظري

12
00:00:36,790 --> 00:00:38,200
.يا إلهي

13
00:00:41,110 --> 00:00:42,980
.كنتُ أبحث عنك

14
00:00:43,420 --> 00:00:44,880
أين كنتِ طوال هذا الوقت؟

15
00:00:45,450 --> 00:00:47,390
.في الأزقّة والأحياء الفقيرة

16
00:00:47,800 --> 00:00:49,670
.حيث كنتُ من البداية

17
00:00:50,490 --> 00:00:54,020
.لكنّي لم أعد أنتمي إلى هناك

18
00:00:55,080 --> 00:00:57,630
.اتّصلتُ بشرطة المدينة من هاتف المتجر

19
00:00:59,120 --> 00:01:02,960
لن يكون الوضع سهلاً على
.النّقابة مع وجود الشّرطة بالجوار

20
00:01:03,460 --> 00:01:04,580
...كيوكا-تشان

21
00:01:05,850 --> 00:01:10,490
.كان بإمكانك أن تتجنّبي الحرب إن بقيتِ مختفية

22
00:01:11,140 --> 00:01:14,270
.الوكالة هي بيتي الوحيد

23
00:01:15,820 --> 00:01:18,320
.ستقتل كيوكا العديد من النّاس قريبًا

24
00:01:19,490 --> 00:01:23,350
،ما دامت قدراتها متشابكة بشكلٍ مظلم داخل روحها

25
00:01:23,670 --> 00:01:26,090
.فلن تهرب من الظّلام أبدًا

26
00:01:27,820 --> 00:01:30,600
.أكمح لأن أكون شيئًا لأوّل مرّةٍ في حياتي

27
00:01:31,480 --> 00:01:32,830
.لذا سأقاتل

28
00:01:33,260 --> 00:01:36,620
.حتّى لو عنى ذلك أن أستخدم كلّ ما يكمن بداخلي

29
00:01:40,020 --> 00:01:40,850
.لقد أتوا

30
00:03:12,620 --> 00:03:13,830
.المعذرة

31
00:03:14,970 --> 00:03:16,440
ماذا حدث؟

32
00:03:16,670 --> 00:03:18,960
.لقد تعرّضنا لهجومٍ مسلّح

33
00:03:19,190 --> 00:03:20,220
ماذا؟

34
00:03:20,380 --> 00:03:21,260
!أيّها القائد

35
00:03:22,720 --> 00:03:24,950
.الوحدة 07 تتّصل بالمقرّ

36
00:03:25,870 --> 00:03:27,010
.المقرّ

37
00:03:29,170 --> 00:03:30,560
.المرفأ الثّالث

38
00:03:30,950 --> 00:03:35,190
لدينا معلومات عن وجود قاتلة
.متسلسلة طليقة في تلك المنطقة

39
00:03:35,440 --> 00:03:37,340
.فتاة في الرّابعة عشر من عمرها ترتدي ثيابًا يابانيّة

40
00:03:37,340 --> 00:03:38,110
.أكرّر

41
00:03:38,330 --> 00:03:41,940
لدينا معلومات عن وجود قاتلة
.متسلسلة طليقة في تلك المنطقة

42
00:03:42,080 --> 00:03:43,990
.فتاة في الرّابعة عشر من عمرها ترتدي ثيابًا يابانيّة

43
00:03:45,060 --> 00:03:47,790
كم عمرك يا آنسة؟

44
00:03:49,150 --> 00:03:50,810
—إلى المقرّ، لقد

45
00:03:53,830 --> 00:03:54,570
!القائد

46
00:03:59,960 --> 00:04:01,250
كيف فعلتِ هذا؟

47
00:04:01,500 --> 00:04:02,340
!القائد

48
00:04:02,340 --> 00:04:04,080
!تماسك أيّها القائد

49
00:04:04,250 --> 00:04:05,790
!نطلب الدّعم

50
00:04:08,870 --> 00:04:10,010
.مثاليّ

51
00:04:11,670 --> 00:04:14,600
.حتّى إجراءات الهروب للهدف قد تمّ اعتبارها

52
00:04:15,480 --> 00:04:18,930
.استراتيجيّة لويسا المقترحة مثاليّة كما العادة

53
00:04:27,150 --> 00:04:28,720
.تمّ إصابة الهدف

54
00:04:29,070 --> 00:04:33,800
،لن تقتلك بما أنّها رصاصة مطّاطية
.لكنّها مؤلمة جدًّا

55
00:04:33,800 --> 00:04:35,890
.أحسنتَ عملاً يا مارك

56
00:04:37,710 --> 00:04:42,840
.والآن يا أميرتي الصّغيرة، سآخذ حبيبك

57
00:04:43,200 --> 00:04:44,010
!لا

58
00:04:44,010 --> 00:04:44,680
!إلاّ هذا

59
00:04:45,330 --> 00:04:46,550
.سيّد هارمان

60
00:04:47,090 --> 00:04:48,480
.مفهوم

61
00:05:02,460 --> 00:05:06,150
.مضى وقتٌ طويل يا صديقي

62
00:05:06,570 --> 00:05:08,950
،لقد التقينا توًّا

63
00:05:09,160 --> 00:05:12,540
لكن اسمحي لي أن أسديك
.نصيحةً في الحياة يا أميرتي الصّغيرة

64
00:05:13,950 --> 00:05:16,680
.لستِ مناسبةً لمساعدة النّاس

65
00:05:17,370 --> 00:05:20,570
.أفترض أنّك تفهمين ما أنتِ مناسبةٌ له

66
00:05:28,530 --> 00:05:30,150
لماذا؟

67
00:05:30,790 --> 00:05:32,890
لِمَ أريتني النّور؟

68
00:05:34,760 --> 00:05:37,240
لِمَ أعطيتني الأمل؟

69
00:05:43,600 --> 00:05:46,060
.أنت رهن الاعتقال بتهمة القتل المتسلسل

70
00:05:47,380 --> 00:05:48,680
.وداعًا

71
00:05:50,270 --> 00:05:54,090
.أرجوك لا تمنحني المزيد من النّور

72
00:06:00,500 --> 00:06:01,500
.فلنلعب

73
00:06:01,500 --> 00:06:02,950
ماذا يجب أن نفعل؟

74
00:06:03,310 --> 00:06:05,460
.الذّهاب إلى الخارج ممتعٌ حقًّا

75
00:06:05,900 --> 00:06:07,930
!هنالك أحدهم

76
00:06:08,350 --> 00:06:12,130
.دعنا نلعب يا سيّدي

77
00:06:12,520 --> 00:06:14,740
أنت من النّقابة، أليس كذلك؟

78
00:06:15,730 --> 00:06:17,340
أستمتع؟

79
00:06:17,580 --> 00:06:18,900
مع طفل؟

80
00:06:26,380 --> 00:06:29,450
.انظر، كلب داشهند

81
00:06:29,540 --> 00:06:30,580
.لا شكرًا

82
00:06:31,030 --> 00:06:32,980
.حسنًا، دوري الآن

83
00:06:35,370 --> 00:06:37,080
.مفاجأة

84
00:06:37,080 --> 00:06:41,090
.انظر، تحصل على بصمة اليد هذه عندما تؤذيني

85
00:06:41,940 --> 00:06:44,700
...والآن، أرني يا سيّدي

86
00:06:45,380 --> 00:06:47,520
.أرني الجنون المطلق

87
00:06:48,560 --> 00:06:51,750
.لم أفهم

88
00:06:52,490 --> 00:06:55,790
أهذا ما تقصده بالجنون؟

89
00:07:05,160 --> 00:07:07,970
.لقد نِمتَ جيّدًا أيّها الكاهن

90
00:07:10,180 --> 00:07:11,780
.سيّد فرانسيس

91
00:07:12,480 --> 00:07:13,920
كيف حالك؟

92
00:07:14,590 --> 00:07:16,030
أين مارغاريت؟

93
00:07:19,050 --> 00:07:20,620
.في حالة حرجة

94
00:07:20,860 --> 00:07:23,050
.قد لا تستيقظ أبدًا

95
00:07:26,380 --> 00:07:28,420
.يا لها من امرأةٍ متهوّرة

96
00:07:29,880 --> 00:07:32,820
.لقد حمتني في النّهاية

97
00:07:32,960 --> 00:07:35,410
.هكذا نجوت

98
00:07:36,580 --> 00:07:40,460
.قالت مارغاريت أنّها ستستعيد شرف عائلتها

99
00:07:41,100 --> 00:07:42,760
...فلماذا

100
00:07:43,270 --> 00:07:50,240
لقد انضمّت إلى العمليّة لأجل تسديد
.دين عائلتها الكبير ولكي تُجدّد سمعتهم

101
00:07:50,480 --> 00:07:54,080
.للأسف، ما هي إلاّ أحلامٌ زائلة

102
00:07:54,510 --> 00:07:56,030
.لم تكن زائلة

103
00:07:56,220 --> 00:07:59,490
.إلى أن جعلتها كذلك يا سيّد فرانسيس

104
00:07:59,660 --> 00:08:00,670
ماذا؟

105
00:08:00,860 --> 00:08:03,290
.لن أعتمد عليك بعد الآن

106
00:08:03,700 --> 00:08:08,740
.بل سأستعيد شرفها بنفسي

107
00:08:09,940 --> 00:08:11,140
.آنسة لويسا

108
00:08:11,790 --> 00:08:13,330
.أريني خطّة الطّوارئ

109
00:08:14,030 --> 00:08:18,110
.لكنّ هذه الخطّة ستسبّب الكثير من الأضرار الجانبيّة

110
00:08:18,260 --> 00:08:20,590
.ستُحوّل يوكوهاما إلى بحرٍ من النّيران

111
00:08:20,890 --> 00:08:23,520
.كلّ شيء هنا ينتمي إليّ

112
00:08:23,670 --> 00:08:27,380
...السّفينة والمكتب والأقلام والتّزيين

113
00:08:28,100 --> 00:08:31,050
.وأنت وأتباعي الآخرون بالطّبع

114
00:08:31,940 --> 00:08:35,280
.بالتّالي، لن أسمح بإيذاء أتباعي بعد الآن

115
00:08:35,740 --> 00:08:39,870
.بما أنّكم ضمن ممتلكاتي، فلديّ الحقّ بحمايتكم

116
00:08:41,500 --> 00:08:44,340
.أبلغي الجميع أن خطّة الطّوارئ سارية المفعول

117
00:08:44,340 --> 00:08:45,130
.حـ-حاضرة

118
00:08:45,860 --> 00:08:48,050
.سأنهي هذا في طرفة عين

119
00:08:52,640 --> 00:08:54,560
.داشهند

120
00:08:57,620 --> 00:08:59,670
مرحبًا، كيف حالك؟

121
00:09:00,010 --> 00:09:01,140
...جسدي

122
00:09:01,140 --> 00:09:02,890
.هذا مؤلم

123
00:09:03,270 --> 00:09:08,060
،إن كنتَ تريد إلقاء اللّوم على أحدهم
،فألقِه على عضوة المكتب الّتي أتت بخطّة الطّوارئ

124
00:09:08,060 --> 00:09:13,530
أو ألقِه على نفسك بسبب فكرتك
.الطّائشة بالعبث بعقل لافكرافت

125
00:09:13,830 --> 00:09:15,160
.سأقتلك

126
00:09:15,320 --> 00:09:16,730
!سأقتلك

127
00:09:17,680 --> 00:09:20,680
!هذا مؤلم

128
00:09:23,610 --> 00:09:27,210
هل تستمتع بجولتك على الموبي ديك؟

129
00:09:30,100 --> 00:09:31,470
.المعذرة

130
00:09:37,780 --> 00:09:38,980
لِمَ هي هنا؟

131
00:09:38,980 --> 00:09:41,210
تقصد الآنسة لوسي؟

132
00:09:41,770 --> 00:09:48,340
ليس لها أيّ قيمة استراتيجيّة بما أنّ حيلتها
.قد كُشفت، لكنّها أصرّت على البقاء

133
00:09:50,510 --> 00:09:52,710
أين كنّا؟

134
00:09:53,500 --> 00:09:56,000
.إنّنا نبحث عن كتاب

135
00:09:56,370 --> 00:09:57,250
كتاب؟

136
00:09:57,590 --> 00:10:00,870
.هناك نسخة واحدة منه فقط في العالم

137
00:10:00,870 --> 00:10:04,700
.كما يقال أنّه منيعٌ ضدّ أيّ قوّة ناريّة أو قدرات خاصّة

138
00:10:05,240 --> 00:10:11,250
.تنبّأ أحد الموهوبين بوجوده مختومًا هنا في يوكوهاما

139
00:10:11,250 --> 00:10:13,710
وما علاقتي بذلك الكتاب؟

140
00:10:13,940 --> 00:10:19,990
.أنتَ حرفيًّا خنفساؤنا النّمريّة... أي مرشدنا

141
00:10:20,340 --> 00:10:25,770
في الواقع، أحضرتك هنا لأنّي لم أشأك
.أن تتحوّل إلى رماد إلى جانب المدينة

142
00:10:25,770 --> 00:10:26,340
ماذا؟

143
00:10:26,520 --> 00:10:29,070
.قسم الموهوبين للعمليّات الخاصّة قد أصبح باطلاً

144
00:10:29,590 --> 00:10:32,690
.كلّ ما تبقّى هو وكالة التّحقيق المسلّحة ومافيا الميناء

145
00:10:32,690 --> 00:10:35,770
.هتان المنظّمتان مزعجتان حقًّا

146
00:10:35,940 --> 00:10:38,250
.لقد قرّرنا أن نحرق المدينة عن بكرة أبيها

147
00:10:38,580 --> 00:10:41,400
.ممّا سيسهّل بحثنا أيضًا

148
00:10:41,710 --> 00:10:43,780
!لا أحد يملك موهبةً بهذه القوّة

149
00:10:44,190 --> 00:10:46,310
ألا يبدو هذا مألوفًا؟

150
00:10:48,560 --> 00:10:55,010
.أساسًا، فخطّة الطّوارئ هي مزج قدراتنا نحن الاثنين

151
00:10:55,420 --> 00:10:59,170
.تخوّل لي موهبتي أن أشارك حواسي بين مضيفٍ وأشجارٍ أخرى

152
00:10:59,170 --> 00:11:01,140
.عبر كرماتي

153
00:11:01,420 --> 00:11:05,310
.وقد أوصلتك بكلّ شجرةٍ بيوكوهاما

154
00:11:05,390 --> 00:11:12,480
،وكما العادة، فالجاهلون بالأمر يسيرون على جذوعها
.ويضربون عليها ويقطعون فروعها

155
00:11:12,960 --> 00:11:17,700
.وذلك الألم يُبعث إليك بينما نتكلّم

156
00:11:18,070 --> 00:11:20,070
.والآن، حان وقت مسابقة

157
00:11:20,600 --> 00:11:25,110
ماذا سيحدث للمدينة بظنّك إن فعّلتَ لعنتك الآن؟

158
00:11:25,460 --> 00:11:31,820
،فور أن أمزّق رأس هذه الدمية
.فحوالي 20% من المدينة ستتعرّض للعنة

159
00:11:33,510 --> 00:11:35,170
.هذه هي خطّة الطّوارئ

160
00:11:35,350 --> 00:11:38,540
.كما تُعرف بعمليّة حرق يوكوهاما

161
00:11:39,020 --> 00:11:42,690
.ستهلك مدينتك بسببك

162
00:11:44,770 --> 00:11:46,090
لماذا؟

163
00:11:46,800 --> 00:11:50,910
.لم أطلب يومًا امتلاك هذه القدرة

164
00:11:51,070 --> 00:11:55,420
لذا لِمَ تحدث كلّ هذه الأمور الفظيعة بسببي؟

165
00:11:55,420 --> 00:11:58,240
أليس الجميع سواسية في عين الرّب؟

166
00:11:58,520 --> 00:11:59,860
.أنت محقّ

167
00:12:00,410 --> 00:12:02,820
.لكنّ هذا هو العالم الّذي نعيش فيه

168
00:12:03,250 --> 00:12:06,580
،لذا دعني أخبرك بالحقيقة

169
00:12:06,580 --> 00:12:07,980
.الرّبّ موجود

170
00:12:08,510 --> 00:12:11,910
.لكنّه لا يحبّك

171
00:12:11,910 --> 00:12:12,630
!لا

172
00:12:12,820 --> 00:12:14,120
!لا! لا

173
00:12:14,120 --> 00:12:16,300
!سأحرق هذا العالم حتّى يستحيل رمادًا

174
00:12:16,300 --> 00:12:21,140
!سألعنه

175
00:12:27,350 --> 00:12:29,050
.عزيزي

176
00:12:29,050 --> 00:12:30,000
نعم؟

177
00:12:30,220 --> 00:12:32,160
أكانت لديك هذه النّدبة دومًا؟

178
00:12:37,990 --> 00:12:39,490
.يبدو أنّه قد بدأ

179
00:12:39,490 --> 00:12:44,500
كلّ ما أنا بحاجةٍ لفعله الآن هو
.تدمير هذه الدمية وتفعيل القدرة

180
00:12:44,600 --> 00:12:45,670
!حسنًا

181
00:12:46,070 --> 00:12:47,310
!أستسلم

182
00:12:47,470 --> 00:12:50,830
.أنا والوكالة سنساعدك دون قيدٍ أو شرط

183
00:12:51,200 --> 00:12:53,580
!لذا لا تدمّر الدّمية رجاءً

184
00:12:54,430 --> 00:12:55,950
.فهمت

185
00:12:56,230 --> 00:12:58,470
.يا له من عرضٍ مثير

186
00:12:58,470 --> 00:13:01,000
.حسنًا. فلنشكّل إطارًا تعاونيًّا

187
00:13:02,720 --> 00:13:06,630
.لكن مع النّاجين فقط

188
00:13:12,550 --> 00:13:14,470
.اللّعنة، ازدحام المرور

189
00:13:14,800 --> 00:13:16,490
.إنّه مسالمٌ حقًّا

190
00:13:16,730 --> 00:13:17,970
كيف ذلك؟

191
00:13:19,440 --> 00:13:20,670
!ماذا؟

192
00:13:20,970 --> 00:13:22,200
!مينورا-سان

193
00:13:26,560 --> 00:13:27,230
!أخرجوني

194
00:13:27,760 --> 00:13:28,460
.سحقًا

195
00:13:31,290 --> 00:13:32,980
.المدينة... يجب أن أفعل شيئًا

196
00:13:32,980 --> 00:13:36,540
يا إلهي، أتيتُ لألقي نظرة
.عليك في طريقي لرمي القمامة

197
00:13:36,540 --> 00:13:38,260
.يا له من منظرٍ جميل

198
00:13:38,260 --> 00:13:39,040
...أنت

199
00:13:39,520 --> 00:13:40,360
.أرجوك

200
00:13:40,360 --> 00:13:41,680
.أخرجيني من هنا

201
00:13:41,680 --> 00:13:43,190
.محال

202
00:13:43,190 --> 00:13:46,220
.أكره المتميّزين أمثالك

203
00:13:46,220 --> 00:13:54,730
ربّما ستعي شعوري عندما تحترق المدينة
.ويتمّ التّخلّص منك كهذه الدّمية عديمة النّفع

204
00:13:56,850 --> 00:14:00,460
.أدري ألمك جيّدًا

205
00:14:00,460 --> 00:14:02,150
!لا تتحدّث وكأنك تعرف

206
00:14:02,800 --> 00:14:06,390
أسبق وأن غسلت الأطباق طوال اليوم وأصابعك تنزف؟

207
00:14:06,750 --> 00:14:09,400
أسبق وأن عُذِّبتَ بمسعرٍ حديديّ ساخن؟

208
00:14:09,940 --> 00:14:14,150
ألديك أدنى فكرة عن مدى الألم والعذاب
الّذي تسبّبت لي به هذه النّدبات؟

209
00:14:16,510 --> 00:14:18,840
.في اليوم الأوّل، تؤلمك عظامك

210
00:14:20,080 --> 00:14:22,550
.لكنّ الألم يبلغ ذروته في اليوم الثّالث

211
00:14:25,150 --> 00:14:26,860
.يحتكّ الحرق كلّما تحرّكت

212
00:14:26,860 --> 00:14:28,100
.ويؤلم بدرجةٍ لا توصف

213
00:14:29,170 --> 00:14:30,980
.عانيتُ من ذلك أيضًا

214
00:14:32,160 --> 00:14:35,040
.أنا مدركٌ لخوفك ووحدتك

215
00:14:35,780 --> 00:14:40,680
.لكنّ الوِحدة لا تحكم علينا أبد الدّهر

216
00:14:41,570 --> 00:14:45,790
.ما الوحدة إلاّ سحابة ليّنة ومنتفخة تتشكّل وتزول

217
00:14:46,780 --> 00:14:50,620
.يحمل العديد من النّاس على اليابسة نفس جراحنا

218
00:14:51,090 --> 00:14:58,560
.تخلّي عنها وستتخلّين عن نفسك الماضية

219
00:15:00,010 --> 00:15:01,650
أهذا ما تريدين؟

220
00:15:05,590 --> 00:15:06,580
أين أنا؟

221
00:15:06,780 --> 00:15:07,970
.فات الأوان

222
00:15:08,230 --> 00:15:09,710
.يوكوهاما هالكة

223
00:15:09,920 --> 00:15:12,030
.لا، ما تزال هناك طريقة

224
00:15:13,110 --> 00:15:17,400
.يحتاج دازاي-سان فقط للمس الدّمية لإنهاء اللّعنة

225
00:15:17,680 --> 00:15:19,440
هل أنت غبيّ؟

226
00:15:19,440 --> 00:15:21,410
.إنّنا في السّماء

227
00:15:21,410 --> 00:15:23,230
كيف تظنّ أنّك تستطيع إعطاءه الدّمية؟

228
00:15:28,680 --> 00:15:29,690
.فهمت

229
00:15:30,410 --> 00:15:31,560
.ستفعل ذلك

230
00:15:32,340 --> 00:15:34,360
.ستُردى قتيلاً بالمسدّسات المضادّة للطّائرات

231
00:15:34,530 --> 00:15:36,770
.أو ستسقط على الأرض وتموت

232
00:15:37,110 --> 00:15:40,040
.أو سيُمزّقك المجانين على اليابسة

233
00:15:40,220 --> 00:15:43,630
،تعلم أنّ هذه هي خياراتك الوحيدة
.إلاّ أنّك ما تزال عازمًا على فعل ذلك

234
00:15:44,800 --> 00:15:47,420
.كان هناك كتابٌ قديم في الميتم

235
00:15:48,920 --> 00:15:53,960
".مقطعٌ منه يقول، "لم أندم على أيّ شيء فعلته

236
00:15:54,430 --> 00:15:59,040
".بل ندمتُ فقط على ما لم أفعله"

237
00:16:00,420 --> 00:16:03,970
ما كان اسم المؤلّف؟

238
00:16:10,290 --> 00:16:11,640
.إنّها مظلّة

239
00:16:12,180 --> 00:16:15,250
.خبّأتُ واحدة في حالة ما إن احتجتُ للهروب

240
00:16:15,960 --> 00:16:19,110
.أوصلتُ الباب الأبيض بالحائط الخارجيّ للموبي ديك

241
00:16:19,300 --> 00:16:20,230
حقًّا؟

242
00:16:20,590 --> 00:16:23,240
.لن تسامحك النّقابة على إطلاق سراحي

243
00:16:25,020 --> 00:16:27,280
.لطالما كنتُ وحيدة

244
00:16:27,690 --> 00:16:31,050
.كما أنّي في مأمن ما دمتُ في هذه الغرفة

245
00:16:41,700 --> 00:16:45,490
هل ستكونين بخيرٍ حقًّا؟

246
00:16:46,650 --> 00:16:49,490
.أعلم أنّك حصينة في هذه الغرفة

247
00:16:49,980 --> 00:16:54,950
لكن ألا يعني ذلك أنّك لا تستطيعين مغادرتها أبدًا؟

248
00:16:56,780 --> 00:16:58,730
.أنت أحمق حقًّا

249
00:16:59,130 --> 00:17:00,580
.هذا مجرّد عذر

250
00:17:02,070 --> 00:17:03,000
.عِش

251
00:17:04,470 --> 00:17:09,080
.وأنقذني من هذا المكان يومًا ما

252
00:17:10,260 --> 00:17:11,470
.سأكون بانتظارك

253
00:17:13,130 --> 00:17:13,960
.حسنًا

254
00:17:18,900 --> 00:17:19,930
.لقد هرب النّمر

255
00:17:20,310 --> 00:17:21,680
!اتّخذوا مواقعكم

256
00:17:22,060 --> 00:17:22,940
.أكرّر

257
00:17:22,940 --> 00:17:23,690
.لقد هرب النّمر

258
00:17:24,180 --> 00:17:26,180
.جهّزوا المدافع المضادّة للطّائرات

259
00:17:30,320 --> 00:17:31,430
...هذا

260
00:17:36,780 --> 00:17:38,700
!تحكّموا بإشارة المرور

261
00:17:38,780 --> 00:17:42,120
.لن يبقى لنا مكانٌ نعمل فيه

262
00:17:42,370 --> 00:17:43,880
!احموه بحياتكم

263
00:17:44,520 --> 00:17:45,800
.فهمت

264
00:17:46,440 --> 00:17:48,020
.هذا ما يجري إذًا

265
00:17:51,800 --> 00:17:53,010
...والآن

266
00:17:53,230 --> 00:17:57,770
.يستطيع مارك أن يصيب هدفًا ساقطًا دون أيّ مشكل

267
00:18:01,080 --> 00:18:02,720
.أمسكتك

268
00:18:03,720 --> 00:18:04,380
...ماذا

269
00:18:07,890 --> 00:18:09,760
.أمسك توم بالهدف

270
00:18:09,760 --> 00:18:11,520
!أحسنت يا توم

271
00:18:11,520 --> 00:18:14,070
.حسنًا، هاك، قم بتحميل القذيفة الثّانية

272
00:18:14,070 --> 00:18:14,930
.حاضر

273
00:18:15,110 --> 00:18:16,900
.المسافة وسرعة الإطلاق، تمّ التّحقّق

274
00:18:17,080 --> 00:18:19,220
.تعويض السّرعة النّسبيّة مع جسد الهدف، تمّ

275
00:18:24,570 --> 00:18:27,840
.طلقة هاك قد اخترقت المظلّة

276
00:18:27,840 --> 00:18:29,180
!أجل

277
00:18:29,530 --> 00:18:31,540
إذًا، كيف حال الفتى النّمر؟

278
00:18:31,540 --> 00:18:33,250
.أغمي عليه بسبب الانفجار

279
00:18:33,250 --> 00:18:36,020
.يبدو أنّه سيرتطم بالأرض ويصبح أشلاءً

280
00:18:36,020 --> 00:18:38,090
ماذا عن أمرك بعدم قتله؟

281
00:18:38,680 --> 00:18:42,890
واثقٌ أنّ موهوبي بلاده سيجدون
.له حلاًّ ما دام جسمه موجودًا

282
00:18:47,750 --> 00:18:49,560
.إذًا فلا فائدة ترجى منّي بالفعل

283
00:18:50,420 --> 00:18:52,500
.لا شيء أستطيع فعله

284
00:18:57,680 --> 00:18:58,820
.هذا أنت

285
00:18:59,550 --> 00:19:00,860
.بالطّبع

286
00:19:04,340 --> 00:19:06,590
أنت تمقتني، أليس كذلك؟

287
00:19:13,060 --> 00:19:15,160
.أكره نفسي أيضًا

288
00:19:24,170 --> 00:19:26,670
.شكرًا على كلّ شيء

289
00:19:47,110 --> 00:19:48,150
.أنا حيّ

290
00:19:51,490 --> 00:19:52,930
!عليّ أن أقوم بتسليمه

291
00:20:10,210 --> 00:20:12,640
.عليّ أن أوقف هذا فورًا

292
00:20:16,110 --> 00:20:17,480
.مذهل

293
00:20:17,980 --> 00:20:22,030
،لقد نجى من سقوطٍ مرتفع
.كما أنّ طلقاتي الكثيفة ما كانت لتؤذيه

294
00:20:22,420 --> 00:20:25,530
.أظنّه يائسًا لتسليم تلك الدّمية القبيحة

295
00:20:25,780 --> 00:20:27,910
.هذا ليس صيدًا إذًا

296
00:20:28,980 --> 00:20:31,120
.بل نزالاً بين رجلين

297
00:20:32,020 --> 00:20:33,130
ماذا؟

298
00:20:33,690 --> 00:20:35,760
أكان ذلك الشّيء هنا من البداية؟

299
00:20:36,600 --> 00:20:39,380
.لا أنصحك بفقدان تركيزك أيّها الفتى النّمر

300
00:20:40,310 --> 00:20:43,220
.لن تعرف من أين تأتيك المتاعب

301
00:20:43,620 --> 00:20:44,970
!شاحنة نفط

302
00:20:57,400 --> 00:20:58,720
.انتهى الأمر

303
00:21:07,840 --> 00:21:09,830
.كفّ عن المقاومة

304
00:21:10,060 --> 00:21:12,070
.لقد بلغت حدود طاقتك

305
00:21:13,010 --> 00:21:14,280
.اخرس

306
00:21:37,080 --> 00:21:39,440
.لقد فزت يا أتسوشي-كُن

307
00:21:40,730 --> 00:21:42,070
...دازاي-سان

308
00:21:43,170 --> 00:21:44,600
.المكان خطيرٌ هنا

309
00:21:44,600 --> 00:21:46,350
.سيطلقون عليك النّار من الأعلى

310
00:21:46,530 --> 00:21:48,200
.أتساءل حيال ذلك

311
00:21:54,510 --> 00:21:55,320
دخان؟

312
00:21:55,490 --> 00:21:56,980
.هذا ليس كل شيء

313
00:21:56,980 --> 00:21:59,160
.أجهزة استشعار الحرارة والرّادارات قد تعطّلت

314
00:21:59,160 --> 00:22:00,700
.إنّه جهاز تشويش

315
00:22:01,390 --> 00:22:06,530
أكان يُعدّها في المدينة بأكملها
معتقدًا أنّه سيحصل على الدّمية؟

316
00:22:11,670 --> 00:22:13,170
.نلت منّي

317
00:22:14,870 --> 00:22:16,640
.أحسنت يا أتسوشي-كُن

318
00:22:16,920 --> 00:22:19,590
.يوكوهاما قد أُنقِذت

319
00:22:20,240 --> 00:22:22,350
.أو هذا ما آمله

320
00:22:23,030 --> 00:22:25,110
،لكن ما دام العدوّ يملك كيو

321
00:22:25,110 --> 00:22:28,660
.فسيكرّرون هذه المذبحة وقتما أرادوا

322
00:22:29,290 --> 00:22:32,000
ما العمل الآن؟

323
00:22:33,000 --> 00:22:40,310
دازاي-سان، لقد تذكّرتُ جملةً
.من كتابٍ قرأته قبل وقتٍ طويل

324
00:22:41,940 --> 00:22:46,080
".قد يخطئ العقل، لكنّ الدّم لا يخطئ أبدًا"

325
00:22:48,040 --> 00:22:50,410
.لديّ فكرة

326
00:22:52,080 --> 00:22:55,150
.قد تبدو غير واردة للجميع

327
00:22:55,960 --> 00:23:02,100
،لكن بالنّسبة لي ولدمي وروحي
.يبدو أنّها الجواب الصّحيح الوحيد

328
00:23:02,410 --> 00:23:03,990
ما هي؟

329
00:23:04,560 --> 00:23:05,980
.اتّحاد

330
00:23:07,030 --> 00:23:12,720
إنّهم الأقوى بيوكوهاما وهم
.يحاولون الآن حماية هذه المدينة

331
00:23:13,920 --> 00:23:19,080
.لا توجد منظّمة أفضل لتساعدنا على قتال النّقابة

332
00:23:19,930 --> 00:23:21,410
وأيّ منظمة تقصد؟

333
00:23:29,550 --> 00:23:31,020
.مافيا الميناء

334
00:23:34,720 --> 00:23:39,020
".قد يخطئ العقل، لكنّ الدّم لا يخطئ أبدًا"