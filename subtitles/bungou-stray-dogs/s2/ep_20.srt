74
00:05:06,410 --> 00:05:08,990
،رغم أنّنا التقينا للتّو

75
00:05:08,990 --> 00:05:12,540
لكن اسمحي لي أن أسديَكِ نصيحة
،من واقع خبرتي يا أميرتي الصّغيرة

76
00:05:13,950 --> 00:05:16,670
.مساعدة النّاس لا تلائمكِ

77
00:05:17,370 --> 00:05:18,670
...ما يلائمكِ

78
00:05:19,170 --> 00:05:20,790
.أفترض أنّكِ تعرفينه

79
00:05:28,510 --> 00:05:29,970
إذًا لماذا؟

80
00:05:30,800 --> 00:05:32,890
لِم أريتني النّور؟

81
00:05:34,770 --> 00:05:37,230
لِم منحتني الأمل؟

82
00:05:43,320 --> 00:05:46,070
أنتِ رهن الاعتقال بتهمة
!ارتكاب جرائم قتلٍ متسلسل

83
00:05:47,360 --> 00:05:48,660
.وداعًا

84
00:05:50,030 --> 00:05:54,080
.أرجوك لا ترني المزيد من النّور

85
00:05:50,030 --> 00:05:54,540
الحلقة العشرون
قد يخطئ العقل

86
00:06:00,500 --> 00:06:02,960
!فلنلعب! ماذا سألعب؟

87
00:06:03,340 --> 00:06:05,460
.العالم الخارجيّ ممتعٌ حقًا

88
00:06:05,960 --> 00:06:07,930
!وجدتُ أحدهم

89
00:06:08,340 --> 00:06:10,180
!أيّها العمّ

90
00:06:10,180 --> 00:06:12,140
!أمتعني

91
00:06:12,600 --> 00:06:14,720
أنت من النّقابة، أليس كذلك؟

92
00:06:15,600 --> 00:06:18,890
أُلاعب... طفلًا؟

93
00:06:26,280 --> 00:06:28,150
.كلبٌ من سلالة داشهند

94
00:06:28,280 --> 00:06:29,490
.سأعطيه لك

95
00:06:29,490 --> 00:06:30,570
.لا أريده

96
00:06:31,120 --> 00:06:32,990
!حسنًا، دوري الآن

97
00:06:35,370 --> 00:06:37,080
!انتهيت

98
00:06:37,080 --> 00:06:41,330
تظهر بصمة اليد تلك على
.أيّ شخصٍ قام بأذيّتي

99
00:06:41,920 --> 00:06:44,710
...والآن، أرني أيّها العمّ

100
00:06:45,380 --> 00:06:47,510
!أرني ما مدى جنونك

101
00:06:48,550 --> 00:06:51,760
...لم أفهمك جيّدًا

102
00:06:52,470 --> 00:06:55,760
أهذا ما تقصده بالجنون؟

103
00:07:05,150 --> 00:07:07,990
.لقد نِمتَ جيّدًا أيّها القسّ

104
00:07:10,150 --> 00:07:11,780
...سيّد فرانسيس

105
00:07:12,490 --> 00:07:13,910
كيف حالك؟

106
00:07:14,580 --> 00:07:16,030
ماذا عن مارغاريت؟

107
00:07:18,750 --> 00:07:20,620
.في حالةٍ حرجة

108
00:07:20,620 --> 00:07:23,210
.قد لا تستيقظ أبدًا

109
00:07:26,380 --> 00:07:28,420
.يا لها من امرأةٍ متهوّرة

110
00:07:29,800 --> 00:07:32,970
.لقد حمتني في اللّحظة الأخيرة

111
00:07:32,970 --> 00:07:35,390
.لِهذا نجوت

112
00:07:36,720 --> 00:07:40,390
.قالت مارغاريت أنّها ستستعيد سمعة عائلتها

113
00:07:41,140 --> 00:07:43,020
...فلماذا

114
00:07:43,020 --> 00:07:46,520
لقد شاركت في هذه العمليّة فقط
.لأجل تسديد دين عائلتها الضّخم

115
00:07:46,520 --> 00:07:50,320
.ولكي تعيد سمعة عائلتها إلى سابق عهدها

116
00:07:50,320 --> 00:07:54,280
.لكنّ حلمها ذاك تبخّر في الهواء

117
00:07:54,280 --> 00:07:56,030
.لم يتبخّر

118
00:07:56,030 --> 00:07:59,500
.أنت من جعله يتبخّر يا سيّد فرانسيس

119
00:07:59,500 --> 00:08:00,750
ماذا قلت؟

120
00:08:00,750 --> 00:08:03,620
.لن أعتمد عليك بعد الآن

121
00:08:03,620 --> 00:08:05,330
...شرفها

122
00:08:06,340 --> 00:08:08,750
.لسوف أستعيده بنفسي

123
00:08:10,010 --> 00:08:11,130
!آنسة لويزا

124
00:08:11,880 --> 00:08:13,340
.إليّ بخطّة الطّوارئ

125
00:08:13,340 --> 00:08:14,010
ماذا؟

126
00:08:14,010 --> 00:08:18,100
!لكنّ هذه الخطّة ستلحق الدّمار الأكبر بالمدنيّين

127
00:08:18,100 --> 00:08:20,810
!ستُحوّل يوكوهاما إلى بحرٍ من النّيران

128
00:08:20,810 --> 00:08:23,520
!كلّ شيءٍ هنا ينتمي إليّ

129
00:08:23,520 --> 00:08:27,360
!السّفينة والمكتب والأقلام وحتّى ستائر النّوافذ

130
00:08:28,110 --> 00:08:28,770
...وبالطّبع

131
00:08:29,150 --> 00:08:31,280
.هذا يشملكِ وأتباعي الآخرون أيضًا

132
00:08:31,940 --> 00:08:35,280
!ولِهذا لن أسمح بإيذاء أتباعي بعد الآن

133
00:08:35,820 --> 00:08:39,870
.أنا أمتلككم ولديّ الحقّ في حمايتكم

134
00:08:41,200 --> 00:08:44,330
أبلغي جميع أعضائنا أن خطّة
.الطّوارئ سارية المفعول

135
00:08:44,330 --> 00:08:45,120
!حـ-حاضر

136
00:08:45,870 --> 00:08:48,040
.سأنهي الأمر في طرفة عين

137
00:08:52,630 --> 00:08:54,550
...داشهند

138
00:08:57,590 --> 00:08:59,680
مرحبًا، كيف حالك؟

139
00:08:59,680 --> 00:09:02,890
...مؤلم... جسدي

140
00:09:03,270 --> 00:09:08,060
،على كلٍّ، إن كنتَ ستلوم أحدهم
،فلُم المخطّطة الّتي أتت بخطّة الطّورئ

141
00:09:08,060 --> 00:09:13,530
أو لُم نفسك لتفكيرك الطّائش
.بالعبث بعقل لافكرافت

142
00:09:13,530 --> 00:09:15,150
!سأقتلك

143
00:09:15,150 --> 00:09:16,740
!لسوف أقتلك

144
00:09:17,450 --> 00:09:20,990
!هذا مؤلم

145
00:09:23,620 --> 00:09:27,460
هل تستمتع بجولتك على الموبي ديك؟

146
00:09:29,920 --> 00:09:31,460
.المعذرة

147
00:09:37,880 --> 00:09:38,970
...إنّها

148
00:09:38,970 --> 00:09:41,600
تقصد الآنسة لوسي؟

149
00:09:41,600 --> 00:09:45,350
،أولئك الّذين كُشفت قدراتهم
.لم تعد لهم أيّ قيمةٍ استراتيجيّة

150
00:09:45,850 --> 00:09:48,350
.لكنّها توسّلت للبقاء هنا

151
00:09:50,520 --> 00:09:52,690
.والآن، فلنعد إلى موضوعنا

152
00:09:53,400 --> 00:09:55,990
.إنّنا نبحث عن كتابٍ معيّن

153
00:09:56,360 --> 00:09:57,400
كتاب؟

154
00:09:57,400 --> 00:10:00,870
.ثمّة نسخةٌ واحدةٌ منه فقط في العالم

155
00:10:00,870 --> 00:10:04,700
يُقال أنّ لا نيران أو قدرات
.خارقة ستلحق به الضّرر

156
00:10:05,330 --> 00:10:11,250
تنبّأ صاحب قدرةٍ خارقة بوجوده
.مختومًا هنا في يوكوهاما

157
00:10:11,250 --> 00:10:13,710
!وما علاقتي بذلك الكتاب؟

158
00:10:13,710 --> 00:10:17,340
.أنتَ حرفيًا خنفساؤنا النّمريّة

159
00:10:17,340 --> 00:10:20,140
.مرشدنا بعبارةٍ أخرى

160
00:10:20,140 --> 00:10:25,770
أحضرتك إلى هنا لأنّها ستكون مشكلةً
.إن تحوّلت إلى رماد مع هذه المدينة أسفلنا

161
00:10:25,770 --> 00:10:26,350
!ماذا؟

162
00:10:26,350 --> 00:10:29,440
.تمّ تجريد قسم العمليّات الخاصّة لذوي القدرات من قوّته

163
00:10:29,440 --> 00:10:32,690
.كلّ ما تبقّى هو وكالة التّحرّي المسلّحة ومافيا الميناء

164
00:10:32,690 --> 00:10:35,820
.تانك المنظّمتان مزعجتان حقًا

165
00:10:35,820 --> 00:10:38,360
.لذا قرّرنا أن نحرق المدينة عن بكرة أبيها

166
00:10:38,360 --> 00:10:41,410
.ممّا سيسهّل بحثنا أيضًا

167
00:10:41,410 --> 00:10:43,780
!لا أحد يملك قدرةً كافية لفعل ذلك

168
00:10:44,200 --> 00:10:46,290
ألا يبدو لك هذا مألوفًا؟

169
00:10:48,540 --> 00:10:51,120
،خطّة الطّوارئ

170
00:10:51,120 --> 00:10:55,300
.ترتكز أساسًا على مزج قدرتينا معًا

171
00:10:55,300 --> 00:11:01,300
عنبي قدرةٌ تخوّلني إنشاء ربطٍ
.حسّيّ بين مضيفٍ وأشجارٍ أخرى

172
00:11:01,300 --> 00:11:05,310
.وقد أوصلتك بكلّ شجرةٍ في يوكوهاما

173
00:11:05,310 --> 00:11:10,520
وكما العادة، فالجاهلون بالأمر يدوسون
،على جذورها ويضربون جذوعها

174
00:11:10,520 --> 00:11:12,770
.ويقطعون أغصانها

175
00:11:12,770 --> 00:11:14,980
،وألم تلك الأشجار

176
00:11:14,980 --> 00:11:17,940
.يُنقل إليك الآن

177
00:11:17,940 --> 00:11:20,070
،والآن، إليك هذا السّؤال

178
00:11:20,610 --> 00:11:25,120
ماذا سيحدث للمدينة بظنّك إن فُعّلتْ لعنتك الآن؟

179
00:11:25,530 --> 00:11:27,700
،فور أن أمزّق رأس هذه الدّمية

180
00:11:27,700 --> 00:11:31,830
.فحوالي خُمس سكّان هذه المدينة سيتعرّضون للّعن

181
00:11:33,500 --> 00:11:35,170
.هذه هي خطّة الطّوارئ

182
00:11:35,170 --> 00:11:38,800
.المسمّاة أيضًا بعمليّة حرق يوكوهاما

183
00:11:38,800 --> 00:11:40,920
...ستهلك مدينتك

184
00:11:41,340 --> 00:11:42,680
.بسببك

185
00:11:44,760 --> 00:11:46,100
لماذا؟

186
00:11:46,850 --> 00:11:50,980
!لم أطلب يومًا امتلاك هذه القدرة

187
00:11:50,980 --> 00:11:55,400
فلماذا تحدث لي كلّ هذه الأمور الفضيعة دائمًا؟

188
00:11:55,400 --> 00:11:58,360
!أليس الجميع سواسية في عين الإله؟

189
00:11:58,360 --> 00:11:59,860
.أنت محقّ

190
00:12:00,490 --> 00:12:03,030
.لكن هذه طبيعة هذا العالم الّذي نعيش فيه

191
00:12:03,030 --> 00:12:06,370
،لِذا دعني أخبرك بالحقيقة

192
00:12:06,370 --> 00:12:07,990
.الإله موجود

193
00:12:08,620 --> 00:12:11,910
.لكنّه لا يحبّك

194
00:12:11,910 --> 00:12:12,620
!لا

195
00:12:12,960 --> 00:12:14,120
!لا! لا

196
00:12:14,120 --> 00:12:16,290
!سأحرق هذا العالم إلى رماد

197
00:12:16,290 --> 00:12:18,670
!سألعنه! سألعنه

198
00:12:18,670 --> 00:12:21,130
!سألعنه

199
00:12:27,350 --> 00:12:29,060
.عزيزي

200
00:12:30,020 --> 00:12:32,140
أكانت لديك هذه النّدبة دومًا؟

201
00:12:37,810 --> 00:12:39,480
.يبدو أنّ الأمر قد بدأ

202
00:12:39,480 --> 00:12:44,530
كلّ ما تبقى الآن هو تمزيق
.هذه الدّمية لتفعيل القدرة

203
00:12:44,530 --> 00:12:45,660
!فهمت

204
00:12:46,070 --> 00:12:47,370
!أستسلم

205
00:12:47,370 --> 00:12:50,830
!أنا والوكالة سندعمك بالكامل في عمليّة بحثك

206
00:12:51,330 --> 00:12:53,580
!لِذا أيّ شيءٍ عدا تمزيق تلك الدّمية

207
00:12:54,410 --> 00:12:56,040
.فهمت

208
00:12:56,040 --> 00:12:58,460
.يا له من عرضٍ مثير

209
00:12:58,460 --> 00:13:01,000
.حسنًا. فلنعقد شراكة

210
00:13:02,710 --> 00:13:06,640
.لكن مع النّاجين فقط

211
00:13:06,970 --> 00:13:09,970
الحلقة العشرون

212
00:13:06,970 --> 00:13:09,970
كلاب الأدب الشاردة

213
00:13:13,230 --> 00:13:14,430
.اللّعنة، ازدحام المرور

214
00:13:14,430 --> 00:13:16,560
.يا له من يومٍ مسالم

215
00:13:16,560 --> 00:13:18,100
كيف ذلك؟

216
00:13:19,270 --> 00:13:20,730
!ما خطبه؟

217
00:13:19,270 --> 00:13:23,030
...أُقتل... أُقتل... أُقتل

218
00:13:20,730 --> 00:13:22,070
!مينورا-سان

219
00:13:26,320 --> 00:13:27,200
!أخرجوني

220
00:13:27,700 --> 00:13:28,410
!سحقًا

221
00:13:31,240 --> 00:13:32,950
...على هذا المعدّل، المدينة سوف

222
00:13:32,950 --> 00:13:33,750
.عجبًا

223
00:13:34,080 --> 00:13:36,500
.أتيتُ لألقي نظرةً عليك في طريقي لرمي القمامة

224
00:13:36,500 --> 00:13:38,210
.تستحقّ هذا

225
00:13:38,210 --> 00:13:39,000
...أنتِ

226
00:13:39,460 --> 00:13:41,630
!أرجوكِ! أخرجيني من هنا

227
00:13:41,630 --> 00:13:43,130
.محال

228
00:13:43,130 --> 00:13:46,170
.أكره المتميّزين أمثالك

229
00:13:46,170 --> 00:13:48,130
عندما تحترق هذه المدينة

230
00:13:48,590 --> 00:13:52,260
،ويتمّ التّخلّص منك كهذه الدّمية عديمة النّفع

231
00:13:52,260 --> 00:13:54,680
.فربّما ستعي شعوري حينها

232
00:13:56,810 --> 00:13:59,400
...أفهم شعوركِ جيّدًا

233
00:13:59,400 --> 00:14:00,230
...فأنا أيضًا

234
00:14:00,230 --> 00:14:02,110
!لا تتحدّث وكأنّك تعرف

235
00:14:02,690 --> 00:14:06,360
أسبق وأن غسلت الأطباق طوال اليوم بأصابع دامية؟

236
00:14:06,780 --> 00:14:09,360
أسبق وأن عُذِّبتَ بقضيبٍ حديديّ مستعر؟

237
00:14:09,950 --> 00:14:14,120
ألديك أدنى فكرة عن مدى الألم
والعذاب الّذي سبّبته لي هذه النّدوب؟

238
00:14:16,450 --> 00:14:18,790
.ينخر الألم العظام في اليوم الأوّل

239
00:14:20,040 --> 00:14:22,500
.لكنّه يصل إلى ذروته في اليوم الثّالث

240
00:14:25,090 --> 00:14:28,050
إن تحرّكت، تحتّك ملابسك بالحرق
.مسبّبةً ألمًا شديدًا لدرجةٍ تتمنّين الموت

241
00:14:29,130 --> 00:14:30,930
.عِشتُ في نفس المكان أيضًا

242
00:14:32,100 --> 00:14:34,930
.لِذا أنا أدرك مخاوفكِ ووحدتك

243
00:14:35,720 --> 00:14:40,520
.لكنّ الوِحدة لا تطغى علينا أبد الدّهر

244
00:14:41,520 --> 00:14:45,980
.ما الوحدة إلّا سحابةٌ تظهر فينةً وتختفي فينةً أخرى

245
00:14:46,740 --> 00:14:50,570
.يحمل العديد من النّاس على اليابسة نفس جراحنا

246
00:14:51,030 --> 00:14:54,120
...التّخلّي عنهم يعني أنّكِ

247
00:14:55,540 --> 00:14:58,500
.يعني أنّكِ تتخلّين عن نفسكِ الماضية

248
00:15:00,040 --> 00:15:01,580
أهذا ما تريدين؟

249
00:15:05,550 --> 00:15:06,630
أين أنا؟

250
00:15:06,630 --> 00:15:08,010
.فات الأوان

251
00:15:08,010 --> 00:15:09,670
.يوكوهاما هالكة

252
00:15:09,670 --> 00:15:11,970
.لا، ما تزال هناك طريقة

253
00:15:13,050 --> 00:15:15,760
،إن قام دازاي-سان بلمس الدّمية وتفعيل قدرته

254
00:15:15,760 --> 00:15:17,350
!فستزول اللّعنة

255
00:15:17,350 --> 00:15:19,390
هل أنت أحمق؟

256
00:15:19,390 --> 00:15:21,350
.نحن نحلّق في السّماء الآن

257
00:15:21,350 --> 00:15:23,190
كيف لك أن توصل إليه الدّمية؟

258
00:15:28,650 --> 00:15:29,650
.فهمت

259
00:15:30,490 --> 00:15:31,530
.أنت عازمٌ على فعلها

260
00:15:32,280 --> 00:15:34,370
.قد تُردى بالمدفعيّة المضادّة للطّائرات

261
00:15:34,370 --> 00:15:36,870
.أو تسقط على الأرض وتلقى حتفك

262
00:15:36,870 --> 00:15:40,080
.أو سيُمزّقك المجانين على اليابسة

263
00:15:40,080 --> 00:15:43,580
،تدرك أنّ هذه هي خياراتك الوحيدة
.إلّا أنّك عازمٌ عل فعلها

264
00:15:44,750 --> 00:15:47,210
.كان هناك كتابٌ قديم في الميتم

265
00:15:49,010 --> 00:15:53,800
".مقطعٌ منه يقول، "لم أندم قطّ على شيءٍ فعلته

266
00:15:54,430 --> 00:15:59,310
".بل ندمتُ فقط على ما لم أفعله"

267
00:16:00,430 --> 00:16:03,940
أتساءل ما كان اسم المؤلّف؟

268
00:16:10,240 --> 00:16:11,610
.إنّها مظلّة

269
00:16:12,240 --> 00:16:15,200
.خبّأتها في حالة ما احتجتُ للهروب

270
00:16:15,910 --> 00:16:19,080
.أوصلتُ الباب الأبيض بالحائط الخارجيّ للموبي ديك

271
00:16:19,080 --> 00:16:20,450
حقًا؟

272
00:16:20,450 --> 00:16:23,210
...إن سمحتِ لي بالهرب فإنّ النّقابة سوف

273
00:16:24,790 --> 00:16:27,130
.لطالما كنتُ وحيدة

274
00:16:27,750 --> 00:16:31,010
.كما أنّي بمأمنٍ ما دمتُ في هذه الغرفة

275
00:16:41,640 --> 00:16:45,440
أخبريني، هل ستكونين بخيرٍ حقًا؟

276
00:16:46,600 --> 00:16:49,320
.قد تكونين بمأمنٍ في هذه الغرفة

277
00:16:49,940 --> 00:16:51,280
...لكن ألا يعني ذلك

278
00:16:52,280 --> 00:16:54,900
أنّكِ لا تستطيعين مغادرتها أبدًا؟

279
00:16:56,740 --> 00:16:58,910
.يا لك من أحمق

280
00:16:58,910 --> 00:17:00,540
.هذا مجرّد عذر

281
00:17:02,040 --> 00:17:02,870
.عِش

282
00:17:04,410 --> 00:17:05,710
...ويومًا ما

283
00:17:06,460 --> 00:17:09,040
.أنقذني من هذا المكان

284
00:17:10,210 --> 00:17:11,420
.سأكون بانتظارك

285
00:17:13,090 --> 00:17:13,800
!فهمت

286
00:17:18,850 --> 00:17:19,890
!لقد هرب النّمر

287
00:17:20,260 --> 00:17:21,640
!اتّخذوا مواقعكم

288
00:17:22,020 --> 00:17:23,640
!أكرّر، لقد هرب النّمر

289
00:17:24,140 --> 00:17:26,140
!جهّزوا المدافع المضادّة للطّائرات

290
00:17:30,270 --> 00:17:31,270
...هذا

291
00:17:36,740 --> 00:17:38,660
!احموا شبكة نظام المرور بأرواحكم

292
00:17:38,660 --> 00:17:42,330
!إن استمرّ هذا الوضع، فلن يبقى لنا مكانٌ نعمل فيه

293
00:17:42,330 --> 00:17:43,830
!احموها بحياتكم

294
00:17:44,450 --> 00:17:45,750
.فهمت

295
00:17:46,370 --> 00:17:47,960
.هذا ما يجري إذًا

296
00:17:51,750 --> 00:17:52,960
...والآن

297
00:17:53,340 --> 00:17:57,720
،إذا اعتمدت على مارك العظيم
.فستكون إصابة هدفٍ ساقط أمرًا يسيرًا

298
00:18:01,010 --> 00:18:02,680
.وجدتك

299
00:18:03,680 --> 00:18:04,350
!ما كان ذلك؟

300
00:18:07,730 --> 00:18:09,730
.حدّد توم احداثيّات الهدف

301
00:18:09,730 --> 00:18:11,480
!أحسنت يا توم

302
00:18:11,480 --> 00:18:14,030
.حسنًا يا هاك، قُم بتحميل القذيفة الثّانية

303
00:18:14,030 --> 00:18:14,900
.حاضر

304
00:18:14,900 --> 00:18:16,900
.تمّ التّحقّق من السّرعة والمسافة

305
00:18:16,900 --> 00:18:19,160
.مزامنة السّرعة النّسبيّة مع جسد الهدف، تمّ

306
00:18:24,540 --> 00:18:27,790
.لقد اخترقت طلقة هاك المظلّة

307
00:18:27,790 --> 00:18:29,290
!مرحى

308
00:18:29,290 --> 00:18:31,500
إذًا، كيف حال الفتى النّمر؟

309
00:18:31,500 --> 00:18:33,210
.أغميّ عليه بسبب الانفجار

310
00:18:33,210 --> 00:18:35,960
.يبدو أنّه سيرتطم بالأرض ويتحوّل إلى أشلاء

311
00:18:35,960 --> 00:18:38,590
ماذا عن أمرك بعدم قتله؟

312
00:18:38,590 --> 00:18:42,850
.ما دام جسده موجودًا فسيجدون له حلًا بقدرة أحدهم

313
00:18:47,680 --> 00:18:49,520
.إذًا فالأمر مستحيل

314
00:18:50,350 --> 00:18:52,440
.لا شيء أستطيع فعله

315
00:18:57,650 --> 00:18:58,780
أهذا أنت؟

316
00:18:59,490 --> 00:19:00,820
.هذا صحيح

317
00:19:04,280 --> 00:19:06,540
أنت تمقتني، أليس كذلك؟

318
00:19:13,000 --> 00:19:15,130
.أنا أكره نفسي أيضًا

319
00:19:24,140 --> 00:19:26,640
.شكرًا على كلّ شيء

320
00:19:47,080 --> 00:19:48,120
.أنا حيّ

321
00:19:51,460 --> 00:19:52,870
!يجب أن أوصلها بسرعة

322
00:20:10,180 --> 00:20:12,600
!عليّ أن أضع نهايةً لهذا فورًا

323
00:20:15,980 --> 00:20:17,440
.مذهل

324
00:20:17,980 --> 00:20:22,150
.لقد نجى من سقوطٍ شاهق ولم يتأذَّ من وابل طلقاتي

325
00:20:22,150 --> 00:20:25,490
هذا يفسّر مدى رغبته في إيصال
تلك الدّمية القبيحة، صحيح؟

326
00:20:25,490 --> 00:20:27,870
.إذًا فهذا لم يعد قنصًا

327
00:20:28,950 --> 00:20:31,080
.بل نزالًا بين رجلين

328
00:20:31,960 --> 00:20:33,080
ماذا؟

329
00:20:33,620 --> 00:20:35,960
أكان ذلك الشّيء هنا سابقًا؟

330
00:20:36,540 --> 00:20:39,340
.لا أنصحك بأن تشيح بنظرك بعيدًا أيّها الفتى النّمر

331
00:20:40,260 --> 00:20:43,090
.فلن تعلم أبدًا أين تأتيك المصائب

332
00:20:43,590 --> 00:20:44,930
!شاحنة نفط؟

333
00:20:57,360 --> 00:20:58,690
.قضيّ الأمر

334
00:21:07,700 --> 00:21:09,870
.كفّ عن المقاومة

335
00:21:09,870 --> 00:21:12,040
.لقد بلغت حدودك

336
00:21:12,950 --> 00:21:14,250
.اخرس

337
00:21:37,020 --> 00:21:39,400
.النّصر حليفك يا أتسوشي-كُن

338
00:21:40,730 --> 00:21:41,900
...دازاي-سان

339
00:21:43,190 --> 00:21:44,570
.المكان خطير

340
00:21:44,570 --> 00:21:46,360
.سيطلقون عليك النّار من الأعلى

341
00:21:46,360 --> 00:21:48,160
.أتساءل حيال ذلك

342
00:21:54,450 --> 00:21:55,290
!دخّان؟

343
00:21:55,290 --> 00:21:56,910
!هذا ليس كلّ شيء

344
00:21:56,910 --> 00:21:59,130
.لقد تعطّلت أجهزة استشعار الحرارة والرّدارات

345
00:21:59,130 --> 00:22:00,670
!إنّها أجهزة تشويش

346
00:22:01,250 --> 00:22:06,470
هل نشرها في أنحاء المدينة وهو واثقٌ
أنّ ذلك الفتى سيقفز ويسلّمه الدّمية؟

347
00:22:11,640 --> 00:22:13,140
.نِلت منّي

348
00:22:14,810 --> 00:22:16,680
.أحسنت يا أتسوشي-كُن

349
00:22:16,680 --> 00:22:19,560
.بهذا أُنقذت المدينة

350
00:22:20,190 --> 00:22:22,320
.أو هذا ما آمله

351
00:22:22,980 --> 00:22:28,610
،لكن ما دام كيو في قبضة العدوّ
.فسيكرّرون هذه المذبحة وقتما شاؤوا

352
00:22:29,320 --> 00:22:31,950
والآن، ما العمل يا ترى؟

353
00:22:32,950 --> 00:22:34,160
...دازاي-سان

354
00:22:35,500 --> 00:22:40,250
.تذكّرتُ جملةً من كتابٍ قرأته قبل وقتٍ طويل

355
00:22:41,880 --> 00:22:46,050
".قد يخطئ العقل، لكنّ الدّم لا يخطئ أبدًا"

356
00:22:48,010 --> 00:22:50,340
.لديّ فكرة

357
00:22:52,050 --> 00:22:55,100
.قد تبدو غير واردة في نظر الجميع

358
00:22:55,930 --> 00:23:02,190
.لكن بالنّسبة لي ولدمي وروحي، فهي الحلّ الوحيد

359
00:23:02,190 --> 00:23:03,940
أيّ فكرةٍ هذه؟

360
00:23:04,610 --> 00:23:05,940
.تعاون

361
00:23:06,980 --> 00:23:12,660
إنّهم الأقوى في يوكوهاما
.ولن يدّخروا جهدًا لحماية هذه المدينة

362
00:23:13,870 --> 00:23:19,040
لا توجد منظّمةٌ أفضل لنتعاون
.معها على مواجهة النّقابة

363
00:23:19,870 --> 00:23:21,370
وما اسم تلك المنظّمة؟

364
00:23:29,380 --> 00:23:30,970
.مافيا الميناء

365
00:23:29,380 --> 00:23:32,890
---------------------------------------------------------------------------

