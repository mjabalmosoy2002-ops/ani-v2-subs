1
00:00:00,640 --> 00:00:06,270
كلاب الأدب الشاردة

2
00:00:09,690 --> 00:00:10,360
!هلمّا إليّ

3
00:00:10,820 --> 00:00:13,360
!وحشٌ تحت ضوء القمر، هجين الرّجل النّمر

4
00:00:14,320 --> 00:00:17,030
!راشومون، الدّرع الشّيطاني

5
00:00:38,140 --> 00:00:39,510
.بربّكما

6
00:00:39,510 --> 00:00:43,140
.يبدو أنّكما لا تستحقّان ما أنفقته من مال

7
00:00:45,350 --> 00:00:46,940
.تبقّت ثلاث دقائق

8
00:00:49,270 --> 00:00:50,400
،كيوكا-تشان

9
00:00:51,030 --> 00:00:52,610
،إن كان ذلك ما تريدين

10
00:00:53,190 --> 00:00:56,070
.فيمكنني تمهيد الطّريق لكِ لجعل القتل أسلوبًا لحياتك

11
00:00:58,780 --> 00:00:59,740
...ولكن

12
00:01:00,080 --> 00:01:02,660
.لستِ وحدكِ من يعيش في بؤس

13
00:01:03,330 --> 00:01:07,920
"ماذا على المرأ أن يفعل عندما تُناقض مثله الواقع؟"

14
00:01:09,090 --> 00:01:13,050
.جميعنا نقاتل باحثين عن السّبيل الصّائب للعيش

15
00:01:14,970 --> 00:01:16,510
لأجل ماذا نقاتل؟

16
00:01:19,390 --> 00:01:20,810
كيف ينبغي أن نعيش؟

17
00:01:22,350 --> 00:01:24,560
.لا أحد سيعطيكِ إجابةً لهذه الأسئلة

18
00:01:26,560 --> 00:01:29,520
.الحقّ في الشّعور بالضّياع هو كلّ ما نملك

19
00:01:32,150 --> 00:01:35,570
.للاندفاع نحو الحضيض مثل الكلاب الشّاردة

20
00:01:43,830 --> 00:01:44,500
!محال

21
00:02:00,340 --> 00:02:04,600
!أيّها الرّجل النّمر

22
00:02:27,580 --> 00:02:30,580
...إن كان الأمر كما يقول

23
00:02:31,000 --> 00:02:33,420
.أجل، ذلك سخيف

24
00:02:34,300 --> 00:02:41,050
،فتلك الكلمات الّتي أذتك في ماضيك
.لم يعد لها علاقةٌ بما أنت عليه الآن

25
00:02:41,680 --> 00:02:46,850
...إن كان بوسعي أن أتخلّص من عبئي اليوم، فأنا

26
00:02:50,730 --> 00:02:53,020
!اقضِ عليه أيّها الرّجل النّمر

27
00:04:02,840 --> 00:04:04,130
...خارت قواي

28
00:04:05,300 --> 00:04:09,220
...إن بقيّ واقفًا بعد ذلك الهجوم

29
00:04:15,400 --> 00:04:18,940
.انتصرت يا زيلدا

30
00:04:21,440 --> 00:04:23,200
.انتظريني

31
00:04:23,990 --> 00:04:29,870
...سأجعلكِ سعيدةً مجدّدًا

32
00:04:42,760 --> 00:04:44,300
!تذكّرت، جهاز التحكّم

33
00:04:47,550 --> 00:04:49,010
.أيّها الأبله

34
00:04:49,010 --> 00:04:53,350
.لقد سحبته منه أثناء الهجوم الأخير

35
00:04:53,350 --> 00:04:54,100
!أنت

36
00:04:54,100 --> 00:04:55,600
!يجب أن نوقفها بسرعة

37
00:05:04,190 --> 00:05:09,530
،لكم أودّ أن أمزّقك إربًا الآن
.لكنّني استنزفت طاقتي للأسف

38
00:05:10,030 --> 00:05:11,870
.اقبل بهذا حاليًا

39
00:05:12,450 --> 00:05:15,250
.ستدفع ثمن هذا عندما نلتقي مجدّدًا

40
00:05:29,970 --> 00:05:31,260
هبوط؟

41
00:05:31,260 --> 00:05:32,260
!محال

42
00:05:32,260 --> 00:05:33,890
!لم أفعل أيّ شيء

43
00:05:33,890 --> 00:05:34,850
!ناولني إيّاه

44
00:05:38,310 --> 00:05:40,520
.إنّه لا يستجيب

45
00:05:41,070 --> 00:05:42,650
.ثمة خطبٌ ما

46
00:05:47,820 --> 00:05:50,200
!لا فائدة، لا استجابة هنا أيضًا

47
00:05:50,200 --> 00:05:52,160
!سنسقط على هذا المعدّل

48
00:05:52,950 --> 00:05:54,080
...ذاك الصّوت

49
00:05:54,080 --> 00:05:55,790
.الوقت يداهمنا

50
00:05:55,790 --> 00:05:58,370
...إن لم نفعل شيئًا فإنّ الجميع

51
00:05:58,370 --> 00:05:59,670
.لا فائدة

52
00:06:00,960 --> 00:06:05,760
.لقد اخترق أحدهم النّظام، وسيطر على السّفينة

53
00:06:05,760 --> 00:06:07,510
.محال

54
00:06:08,260 --> 00:06:10,140
.ما زالت هناك طريقة

55
00:06:10,140 --> 00:06:11,300
...هذا الصّوت

56
00:06:12,010 --> 00:06:13,260
!كيوكا-تشان؟

57
00:06:13,260 --> 00:06:14,970
.سمعتُ بشأن وضعكم

58
00:06:15,390 --> 00:06:17,640
،قد يكون من المستحيل جعل الموبي ديك ترتفع مجدّدًا

59
00:06:17,640 --> 00:06:19,810
...لكن إن صدمناها بجسمٍ ضخم

60
00:06:19,810 --> 00:06:22,440
.فبإمكاننا اسقاطها قبل أن تصل إلى المدينة

61
00:06:23,070 --> 00:06:25,070
.سأستخدم هذه الطّائرة بدون طيّار

62
00:06:25,070 --> 00:06:26,610
.فهمت

63
00:06:26,610 --> 00:06:28,150
!أنتِ رائعةٌ يا كيوكا-تشان

64
00:06:28,150 --> 00:06:29,910
.وبهذا سننقذ الجميع

65
00:06:30,610 --> 00:06:32,740
.جهّز المظلّات من فضلك

66
00:06:34,240 --> 00:06:35,790
.يجب أن تغادري بسرعةٍ أيضًا

67
00:06:36,580 --> 00:06:37,410
.لا أستطيع

68
00:06:37,750 --> 00:06:38,370
!ماذا؟

69
00:06:39,540 --> 00:06:41,170
.أنا أسيرة

70
00:06:41,750 --> 00:06:44,340
.قدمي مكبّلة

71
00:06:44,340 --> 00:06:47,550
.ولا أستطيع الوصول إلى الغرفة حيث المظلات

72
00:06:48,920 --> 00:06:50,090
...محال

73
00:06:50,970 --> 00:06:51,840
...إذًا

74
00:06:52,550 --> 00:06:54,300
.انسَ أمري

75
00:06:54,300 --> 00:06:55,260
!كلّا

76
00:06:55,640 --> 00:06:56,810
!لا تفعلي ذلك

77
00:06:56,810 --> 00:06:58,310
!غيّري المسار

78
00:06:58,930 --> 00:07:02,770
.لم أحظَ بأيّ بصيص نورٍ حتّى الآن

79
00:07:04,360 --> 00:07:09,820
.لكنّي أدركتُ اليوم أخيرًا، أنّ بيدي اتّخاذ القرار

80
00:07:10,950 --> 00:07:17,080
،إن ضحّيتُ بنفسي لإنقاذ الجميع
.فسأستطيع اجتياز اختبار القبول

81
00:07:17,700 --> 00:07:20,120
.وأُصبح عضوًا حقيقيًا بالوكالة

82
00:07:20,830 --> 00:07:22,830
.لذلك، لا سبب للتّردّد

83
00:07:22,830 --> 00:07:24,250
!توقّفي

84
00:07:26,960 --> 00:07:28,510
!أتركني يا أكوتاغاوا

85
00:07:28,510 --> 00:07:30,380
!كيوكا-تشان، أنصتي إليّ

86
00:07:34,470 --> 00:07:35,640
.شكرًا لك

87
00:07:36,720 --> 00:07:38,270
.آسفة

88
00:08:02,290 --> 00:08:07,090
!كيوكا-تشان

89
00:08:18,180 --> 00:08:19,390
لماذا؟

90
00:08:20,390 --> 00:08:22,180
...لِم قامت

91
00:08:25,150 --> 00:08:26,270
...كيوكا

92
00:08:27,190 --> 00:08:28,440
.يا لها من حمقاء

93
00:08:29,980 --> 00:08:35,570
،لو أنّها لم تعقد الأمل للعيش في النّور
.لما ضحّت بحياتها هباءً

94
00:08:38,830 --> 00:08:41,450
.هكذا وجب الأمر أن يكون يا أتسوشي-كُن

95
00:08:43,580 --> 00:08:44,920
!دازاي-سان

96
00:08:44,920 --> 00:08:45,920
الرّئيس؟

97
00:08:47,540 --> 00:08:51,090
.تغلّبت كيوكا-تشان على نفسها وأنقذت المدينة

98
00:08:51,840 --> 00:08:54,470
.بالفخر والنّبل الّذي يليق بعضوٍ في الوكالة

99
00:08:55,050 --> 00:08:58,680
...لكن لا أفهم السّبب الّذي حتّم عليها الموت

100
00:08:59,300 --> 00:09:02,060
.بالفعل، لقد كانت خاتمةً قاسية

101
00:09:02,850 --> 00:09:06,850
.لكن هناك سببٌ وجيهٌ لفعلها ذلك

102
00:09:07,770 --> 00:09:11,730
"،قدرتي، "كلّ الرّجال سواسية

103
00:09:11,730 --> 00:09:16,780
،لديها تأثيرٌ على أتباعي فقط
.بعبارةٍ أخرى، على أعضاء الوكالة

104
00:09:17,240 --> 00:09:22,660
.إنّها قدرةٌ تمنح الآخرين السّيطرة على قدراتهم

105
00:09:23,410 --> 00:09:29,380
السّبب الّذي مكّنك من التّحكّم بجزءٍ
.من قدرة النّمر هو لأنّك انضممتٙ للوكالة

106
00:09:30,170 --> 00:09:33,550
،وقد اجتازت كيوكا-تشان اختبار القبول

107
00:09:34,420 --> 00:09:36,090
.قُبَيل الاصطدام

108
00:09:36,800 --> 00:09:39,510
أتدرك ما يعنيه ذلك؟

109
00:09:45,180 --> 00:09:49,690
.استخدمتُ سيف شيطانة الثّلج لأقطع الأغلال وأهرب

110
00:09:51,860 --> 00:09:52,980
.لقد عدت

111
00:09:58,860 --> 00:09:59,950
.مرحبًا بعودتكِ

112
00:10:01,740 --> 00:10:02,780
.هذا مؤلم

113
00:10:03,370 --> 00:10:04,870
.آ-آسف

114
00:10:04,870 --> 00:10:07,910
.أعتذر لإبقاء الأمر سرًا عنكما

115
00:10:08,920 --> 00:10:12,710
.ما كان ليُعتبر اختبار قبول لولا ذلك

116
00:10:14,880 --> 00:10:16,550
الجبل في النّهاية؟

117
00:10:16,550 --> 00:10:17,510
.بل المحيط

118
00:10:18,550 --> 00:10:19,720
.عُلم

119
00:10:21,050 --> 00:10:23,720
أيعقل أنّك علمتٙ كلّ هذا منذ البداية؟

120
00:10:24,220 --> 00:10:27,980
.هُزم العدوّ واجتازت كيوكا-تشان الاختبار

121
00:10:28,640 --> 00:10:30,100
.مسررٌ لأنّ كلّ شيءٍ سار على خير

122
00:10:30,100 --> 00:10:31,190
!دازاي-سان

123
00:10:31,610 --> 00:10:33,690
.لم يعد هناك أحد ليعترض طريقنا

124
00:10:33,690 --> 00:10:35,820
...سأثبت لك قوّتي الآن

125
00:10:36,440 --> 00:10:38,200
.أشكّ في ذلك

126
00:10:38,200 --> 00:10:40,200
لقد استنزفت كامل قوّتك، أليس كذلك؟

127
00:10:40,200 --> 00:10:42,570
.كما أنّك هزمتٙ زعيم النّقابة

128
00:10:42,570 --> 00:10:44,450
...لا علاقة لذلك

129
00:10:44,450 --> 00:10:45,790
...أنا

130
00:10:47,750 --> 00:10:49,290
.غدوتٙ قويًا

131
00:10:57,550 --> 00:10:58,590
.عجبًا

132
00:11:02,430 --> 00:11:04,180
منظرٌ جميل، أليس كذلك؟

133
00:11:09,600 --> 00:11:11,310
.لقد حميتها

134
00:11:14,730 --> 00:11:15,980
.إنّها مدينتك

135
00:11:21,990 --> 00:11:26,990
الحلقة الرّابعة والعشرون
إن كان بوسعي أن
أتخلّص من عبئي اليوم

136
00:11:22,610 --> 00:11:25,910
مدينتي؟

137
00:11:30,370 --> 00:11:33,490
،حرب القدرات الكبرى الّتي عصفت بمدينة يوكوهاما

138
00:11:33,490 --> 00:11:35,420
.آلت إلى نهايتها أخيرًا

139
00:11:35,420 --> 00:11:39,380
.لكنّ عمل الحكومة يبدأ من هنا

140
00:11:39,380 --> 00:11:42,080
...تنظيف كلّ هذه الفوضى

141
00:11:42,080 --> 00:11:44,550
.من يعلم كم يومًا لن أعود إلى المنزل لأنام

142
00:11:45,430 --> 00:11:51,230
...ولهذا فإنّ تعاونك سيكون عونًا كبيرًا لنا

143
00:11:52,230 --> 00:11:53,520
.سيّد هيرمان

144
00:11:54,520 --> 00:11:57,230
.كلّ ما أريده الآن هو تأمّل المحيط

145
00:11:58,190 --> 00:12:05,160
إن زوّدتنا بمعلوماتك، فلن نضطرّ للقبض على
.أعضاء النّقابة الّذين لم يتورّطوا في هذه الحادثة

146
00:12:05,160 --> 00:12:10,700
أتظنّ أنّ عضوًا عاديًا مثلي سيمتلك مثل تلك المعلومات؟

147
00:12:11,330 --> 00:12:12,040
.أجل

148
00:12:13,000 --> 00:12:17,170
.ففي النّهاية، كنتَ زعيم النّقابة قبل جيلين

149
00:12:18,500 --> 00:12:22,930
.لا أريد سماع غرٍّ يسرد عليّ الماضي

150
00:12:23,300 --> 00:12:26,350
.أرجو منك أن تساعدنا على تخفيف حرماننا من النّوم

151
00:12:27,140 --> 00:12:28,890
لا حاجة لاستخدام هذه، صحيح؟

152
00:12:49,910 --> 00:12:54,040
.لم أتصوّر يومًا أنّي سأشهد غرق الموبي ديك

153
00:12:54,040 --> 00:12:55,920
.لقد كانت مكانًا جميلًا

154
00:12:55,920 --> 00:12:57,460
الموبي ديك؟

155
00:12:57,460 --> 00:12:59,040
.أقصد النّقابة

156
00:12:59,040 --> 00:13:01,210
.الزّعيم مفقود

157
00:13:01,210 --> 00:13:05,340
،بدون قائد فإنّ النّقابة ستتداعى
.وقد سمعتُ عن نشوب صراعاتٍ داخليّة

158
00:13:05,880 --> 00:13:10,470
،بما أنّ كلّ الأحداث قد انتهت
.فأعتقد أنّ الوقت حان لإسدال السّتار

159
00:13:10,470 --> 00:13:11,600
.أجل

160
00:13:12,520 --> 00:13:14,480
.لكنّ الحياة لم تنتهِ

161
00:13:14,480 --> 00:13:16,310
.هذا صحيح

162
00:13:16,310 --> 00:13:20,320
.سأعود إلى الدّيار لأكمل عملي على سيرتي الذّاتيّة

163
00:13:20,320 --> 00:13:22,110
ماذا عنكما؟

164
00:13:22,110 --> 00:13:24,700
.سأبحث عن السّيّد فرانسيس

165
00:13:26,360 --> 00:13:27,570
.واثقةٌ أنّه حيّ

166
00:13:29,580 --> 00:13:32,370
ستعود إلى عائلتك، أليس كذلك يا جون؟

167
00:13:32,370 --> 00:13:33,750
.كلّا

168
00:13:35,250 --> 00:13:37,750
.يجب أن أُخمد صراعات النّقابة الدّاخليّة

169
00:13:37,750 --> 00:13:39,210
أنت؟

170
00:13:39,210 --> 00:13:41,250
.هذا غير متوقّع

171
00:13:41,250 --> 00:13:44,130
.ظننت أنّك تكره الزّعيم

172
00:13:44,130 --> 00:13:45,470
.أكرهه

173
00:13:45,800 --> 00:13:49,600
.أمقتُ كلّ من يستخدم المال للتّحكّم بالنّاس

174
00:13:49,600 --> 00:13:55,100
لكن إن فكرّت أنّ هذه نتيجة شخصٍ
،اعتمد على المال لإنقاذ عائلته

175
00:13:55,890 --> 00:13:57,850
.لا يمكنني أن أعود هكذا

176
00:13:58,850 --> 00:14:00,690
...العقد

177
00:14:01,980 --> 00:14:04,940
.تمّ إيفاؤه أخيرًا

178
00:14:04,940 --> 00:14:07,530
نجوتَ يا لافكرافت؟

179
00:14:07,530 --> 00:14:09,530
ما الّذي ستفعله الآن؟

180
00:14:13,290 --> 00:14:14,500
.سأنام

181
00:14:20,080 --> 00:14:22,290
من يكون بحقّ؟

182
00:14:23,000 --> 00:14:24,760
.لا يهمّ من يكون

183
00:14:25,260 --> 00:14:27,670
.إنّه أحد أصدقائي القلائل

184
00:14:34,560 --> 00:14:35,720
.كيوكا-تشان

185
00:14:37,390 --> 00:14:38,980
.تفضّلي

186
00:14:56,330 --> 00:14:57,870
...استعداد

187
00:14:57,870 --> 00:15:02,380
!تهانينا على انضمامكِ للوكالة يا كيوكا-تشان

188
00:15:05,920 --> 00:15:07,880
!نخبك

189
00:15:28,110 --> 00:15:29,240
.أتسوشي

190
00:15:30,650 --> 00:15:32,240
كيف حال جراحك؟

191
00:15:32,240 --> 00:15:33,700
.أنا بخيرٍ الآن

192
00:15:34,280 --> 00:15:38,120
.بفضل أفعالكما، تمّ إنقاذ المدينة من الهلاك

193
00:15:38,540 --> 00:15:41,870
فكّرتُ أن أقول لك شيئًا
،باعتباري أقدم منك في الوكالة

194
00:15:46,380 --> 00:15:50,050
أوّلًا، العمليّات الفرديّة تعدّ استثناءً
!لمنظّمةٍ جماعيّة مثل الوكالة

195
00:15:50,050 --> 00:15:52,190
،لن أقول لك أن تهمل الخبرة الّتي اكتسبتها من هذا

196
00:15:52,190 --> 00:15:53,890
!لكن إيّاك أن تتجاهل آليّات عمل الوكالة

197
00:15:53,890 --> 00:15:54,760
!ونفس الشّيء لكيوكا

198
00:15:54,760 --> 00:15:58,010
،ضعي في الحسبان أنّكِ عضوٌ في وكالة التّحرّي

199
00:15:58,010 --> 00:15:59,730
.ولا تقدمي على شيءٍ ستندمين عليه

200
00:15:58,810 --> 00:16:01,140
!بربّك يا كونيكيدا

201
00:16:01,140 --> 00:16:04,270
.لا أحد يتحمّل الكحول وهذا مملّ

202
00:16:04,270 --> 00:16:06,230
.تعال واشرب معي

203
00:16:06,230 --> 00:16:08,320
.لا، أنا أيضًا لا أتحمّل كثيرًا

204
00:16:09,360 --> 00:16:11,990
أليس لديك ما تودّ قوله لهما؟

205
00:16:13,950 --> 00:16:15,620
.أبليتما حسنًا أنتما الاثنان

206
00:16:16,580 --> 00:16:19,160
!حسنًا، دعونا نشرب حتّى الصّباح

207
00:16:19,160 --> 00:16:20,410
...هـ-هذا كثير

208
00:16:20,950 --> 00:16:22,920
أتقصد أنّك لا تريد أن تشاركني الشّرب؟

209
00:16:22,920 --> 00:16:26,710
لا تقدم على شيءٍ ستندم عليه؟

210
00:16:28,880 --> 00:16:30,710
.هارونو-سان، ناومي-سان

211
00:16:32,840 --> 00:16:34,720
!أنا آسفٌ جدًا

212
00:16:35,720 --> 00:16:39,720
!لقد ارتكبتُ شيئًا فظيعًا بحقّكما تحت تأثير قدرة كيو

213
00:16:40,180 --> 00:16:43,270
!ما كان ليحدث ذلك لو أنّي كنتُ مدركًا لهلوستي

214
00:16:48,610 --> 00:16:49,820
تقصد ما حدث آنذاك؟

215
00:16:50,320 --> 00:16:54,200
.أنا حقًا آسف

216
00:16:55,110 --> 00:16:56,280
،أتسوشي-كُن

217
00:16:56,280 --> 00:16:58,700
.لم يكن الأمر بذلك السّوء

218
00:16:58,700 --> 00:17:00,790
.لا يمكننا أن نتمسّك بمثل تلك الأمور هنا

219
00:17:01,250 --> 00:17:02,580
حقًا؟

220
00:17:02,580 --> 00:17:03,620
.أجل

221
00:17:04,620 --> 00:17:06,500
.هذا مطمئن

222
00:17:06,880 --> 00:17:12,210
لقد كان هناك حقًا خطبٌ ما بي
.لاقتراف ذلك الفعل الفظيع بحقّكما

223
00:17:13,130 --> 00:17:14,260
.أتسوشي-كُن

224
00:17:15,880 --> 00:17:18,970
.هذه أوّل مرّةٍ أسمع هذا

225
00:17:18,970 --> 00:17:21,470
أخبرني يا أتسوشي-كُن، ما القصّة؟

226
00:17:21,470 --> 00:17:23,390
.ا-اهدأ رجاءً يا تانيزاكي-سان

227
00:17:22,640 --> 00:17:24,430
!رانبو-كُن

228
00:17:23,390 --> 00:17:25,140
.لا أستطيع أن أهدأ

229
00:17:25,140 --> 00:17:27,980
!والآن لن أستطيع الزّواج

230
00:17:25,140 --> 00:17:28,480
لقد أحضرتُ الرّواية الجديدة
.الّتي استفسرت عنها عبر الهاتف

231
00:17:28,480 --> 00:17:29,860
!كونيكيدا

232
00:17:29,110 --> 00:17:30,110
!نـ-ناومي-سان؟

233
00:17:29,860 --> 00:17:31,400
.يوسانو-سينسي، أظنّكِ أسرفتِ في الشّرب

234
00:17:30,110 --> 00:17:31,900
!هذا أنت

235
00:17:31,900 --> 00:17:33,860
.يسعدني قدومك

236
00:17:32,780 --> 00:17:36,070
!ناومي-سان، اشرحي الموقف رجاءً

237
00:17:33,860 --> 00:17:37,200
ألا بأس بوجودي هنا حقًا؟

238
00:17:36,070 --> 00:17:38,570
.رامبو-سان، الرّئيس يناديك

239
00:17:37,280 --> 00:17:39,280
...أنا من منظّمةٍ معادية

240
00:17:39,280 --> 00:17:41,410
.سأعود حالًا، ابق هنا

241
00:17:40,700 --> 00:17:41,700
!كـ-كيوكا-تشان

242
00:17:41,790 --> 00:17:42,540
...أتسوشي لديه

243
00:17:42,580 --> 00:17:43,950
!رانبو-كُن

244
00:17:43,950 --> 00:17:44,620
!ماذا؟

245
00:17:44,620 --> 00:17:46,500
!اشرب يا كونيكيدا

246
00:17:45,500 --> 00:17:47,460
.لقد كانت عمليّةً مبهرة

247
00:17:46,500 --> 00:17:48,000
...ا-انتظري يا كيوكا-تشان

248
00:17:47,460 --> 00:17:48,330
.بالطّبع

249
00:17:48,000 --> 00:17:50,290
!اختلاق الأعذار ليس من شيَم الرّجال

250
00:17:48,330 --> 00:17:50,960
.الوكالة لا شيء من دونك يا رنبو

251
00:17:50,290 --> 00:17:52,050
!بمَ أخبرتها يا تانيزاكي-سان؟

252
00:17:50,960 --> 00:17:52,050
.بالطّبع. بالطّبع

253
00:17:52,050 --> 00:17:54,260
!بكلّ الأمور الفاحشة الّتي ارتكبتها

254
00:17:54,760 --> 00:17:55,800
!ناومي-سان

255
00:17:54,760 --> 00:17:58,390
.يبدو أنّ الجميع يستمتعون بوقتهم يا كارل

256
00:17:55,800 --> 00:17:57,380
.يجب أن تتحمّل المسؤوليّة

257
00:17:57,380 --> 00:17:57,840
!كيوكا-تشان

258
00:17:57,840 --> 00:17:58,390
!يا لك من حقير

259
00:18:07,810 --> 00:18:10,900
.1964 إنّها روماني من العام

260
00:18:10,900 --> 00:18:12,190
ألا بأس بهذا؟

261
00:18:12,650 --> 00:18:14,070
أليست كنزك؟

262
00:18:14,530 --> 00:18:19,990
وهل هناك يومٌ أفضل من هذا لفتحها يا أختاه؟

263
00:18:21,870 --> 00:18:23,290
.نخب النّصر

264
00:18:27,960 --> 00:18:29,330
.إنّه لذيذ

265
00:18:30,170 --> 00:18:33,380
ماذا سنفعل بشأن عقاب أكوتاغاوا يا زعيم؟

266
00:18:33,380 --> 00:18:34,920
عقاب؟

267
00:18:35,340 --> 00:18:38,590
.لقد كان له دورٌ فعّال في نجاحنا

268
00:18:38,590 --> 00:18:41,350
.لطالما كان أكوتاغاوا-كُن هكذا

269
00:18:41,800 --> 00:18:46,430
يذهب من تلقاء نفسه ويسبّب الدّمار
.وفي النّهاية تكون له المساهمة الأكبر

270
00:18:46,430 --> 00:18:49,190
.لديه حاسّة شمّ قويّة على ما يبدو

271
00:18:49,190 --> 00:18:52,060
.ما دام يواصل النّجاح، فلن يكون هناك عقاب

272
00:18:52,730 --> 00:18:58,990
بالمناسبة يا كويو-كُن، لماذا لم تهربي
عندما كنتِ أسيرةً في وكالة التّحرّي؟

273
00:18:59,700 --> 00:19:02,200
.كان ذلك ليكون سهلًا عليكِ

274
00:19:02,870 --> 00:19:04,580
.أتساءل لماذا

275
00:19:06,040 --> 00:19:08,580
.ربّما لأن الشّاي كان لذيذًا جدًا

276
00:19:09,210 --> 00:19:12,500
.أختاه، دعينا نعقد اتّفاقًا بين راشدين

277
00:19:13,130 --> 00:19:15,130
.لديّ خطّةٌ لإنقاذ كيوكا-تشان

278
00:19:15,550 --> 00:19:16,380
ماذا؟

279
00:19:17,090 --> 00:19:23,600
وإن أفلح الأمر، فستكون الطّريقة
.الوحيدة لحماية حياتها وأحلامها

280
00:19:25,850 --> 00:19:30,100
.توقّع دازاي كلّ ما سيحدث منذ البداية

281
00:19:30,100 --> 00:19:32,400
.يا له من رجلٍ مخيف

282
00:19:32,400 --> 00:19:33,190
.سحقًا

283
00:19:33,860 --> 00:19:35,060
،كويو-كُن

284
00:19:35,640 --> 00:19:37,190
.أنتِ قويّة

285
00:19:37,820 --> 00:19:41,480
،وبما أنّ محبوبتكِ كيوكا-كُن قد غادرت الآن

286
00:19:41,480 --> 00:19:46,790
فسيكون من الصّعب أن أمنعكِ
.إن قرّرتِ مغادرة مافيا الميناء

287
00:19:47,290 --> 00:19:48,660
.بالطّبع

288
00:19:49,580 --> 00:19:54,840
.لكن للأسف، عليّ مساعدة زعيمٍ أخرق لتجديد المنظّمة

289
00:19:56,710 --> 00:19:58,550
،مسرورٌ لسماع هذا

290
00:19:59,050 --> 00:20:01,840
.لكنّي مهتمٌّ فقط بمن هنّ أصغر من اثنا عشرة سنة

291
00:20:01,840 --> 00:20:03,140
.اصمت

292
00:20:03,140 --> 00:20:04,590
.وإلّا قمت بخيّاطة شفتيك

293
00:20:04,590 --> 00:20:06,810
!دازاي

294
00:20:06,810 --> 00:20:08,520
!سأقتلك في المرّة القادمة

295
00:20:10,890 --> 00:20:13,940
...ا-المعذرة

296
00:20:12,140 --> 00:20:13,940
!يا لظرافته

297
00:20:17,020 --> 00:20:18,400
!يا لظرافته

298
00:20:20,900 --> 00:20:21,530
ماذا؟

299
00:20:22,450 --> 00:20:24,200
بالمناسبة، أين دازاي-سان؟

300
00:20:32,710 --> 00:20:34,710
.يا لها من لوحةٍ غريبة

301
00:20:34,710 --> 00:20:37,290
.أراهن أنّني أستطيع رسمها أيضًا

302
00:20:41,010 --> 00:20:43,840
.هيروتسو-سان، كنتَ عونًا كبيرًا في هذه القضيّة

303
00:20:44,430 --> 00:20:46,720
أكان ذلك كافيًا؟

304
00:20:47,300 --> 00:20:51,220
كلّ ما فعلته هو تسريب طريقة التسلّل
.إلى الموبي ديك لهيغوتشي-كُن

305
00:20:51,220 --> 00:20:54,520
.عندما علمت بذلك، قامت بإخبار أكوتاغاوا-كُن

306
00:20:55,060 --> 00:20:59,150
.وإن علِم أكوتاغاوا-كُن، فبالتّأكيد سيتصرّف من تلقاء نفسه

307
00:20:59,690 --> 00:21:01,030
.سار الأمر كما توقّعت تمامًا

308
00:21:01,900 --> 00:21:07,200
لِم تكبّدت كلّ ذلك لتلاقي أكوتاغاوا-كُن بالفتى النّمر؟

309
00:21:07,990 --> 00:21:09,990
.أردتُ أن أتأكّد من شيء

310
00:21:10,700 --> 00:21:15,500
.من أجل التّحضير للكارثة الّتي تلوح في الأفق

311
00:21:16,540 --> 00:21:19,000
.لقد بادر في التّحرّك بالفعل

312
00:21:21,590 --> 00:21:24,970
.إذًا فسقوط الموبي ديك قد أخفق

313
00:21:25,510 --> 00:21:27,970
.مع ذلك، فكلّ شيءٍ يسري وفق الخطّة

314
00:21:27,970 --> 00:21:33,890
نجحنا في خلق الصّراع داخل النّقابة
.وتجنيد ذوي قدراتٍ مؤهّلين

315
00:21:34,480 --> 00:21:41,360
أنا أساعد مؤقّتًا فقط شريطة أن
.تعالج مارغاريت لتستعيد وعيها

316
00:21:42,820 --> 00:21:45,490
.وهذا يكفي أيّها القّس

