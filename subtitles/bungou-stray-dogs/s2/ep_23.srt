1
00:00:05,690 --> 00:00:07,230
!عثرت عليك أيّها الرّجل النّمر

2
00:00:08,730 --> 00:00:12,070
!أكوتاغاوا

3
00:00:20,290 --> 00:00:23,580
.يبدو أنّك صقلت حركاتك البهلوانيّة أيّها الرّجل النّمر

4
00:00:23,580 --> 00:00:26,080
ما الّذي جاء بك إلى هنا يا أكوتاغاوا؟

5
00:00:27,000 --> 00:00:28,840
!لأقتلك

6
00:00:29,420 --> 00:00:32,260
!ينبغي عليك أن تعي وضعنا الحاليّ

7
00:00:32,260 --> 00:00:35,300
!قد لا نملك مكانًا نعيش فيه بعد الآن

8
00:00:36,260 --> 00:00:39,100
.لا أستطيع فهمك إطلاقًا

9
00:00:39,510 --> 00:00:41,810
.لا أذكر أنّي طلبتُ منك أن تفهمني

10
00:00:42,220 --> 00:00:43,730
.يا إلهي

11
00:00:44,810 --> 00:00:48,020
.عادة أكوتاغاوا-كُن في التّصرّف كذئبٍ وحيد لا تتغيّر أبدًا

12
00:00:49,150 --> 00:00:50,270
.لا حلّ آخر

13
00:00:50,860 --> 00:00:51,780
،أتسوشي-كُن

14
00:00:51,780 --> 00:00:54,400
.لا نملك الوقت للتّعامل معه

15
00:00:54,400 --> 00:00:55,910
.فلتمضِ

16
00:00:55,910 --> 00:00:56,990
...لكن

17
00:00:56,990 --> 00:01:01,200
.لا تقلق، اتّبع تعليماتي وستتمكّن من الإفلات منه

18
00:01:04,040 --> 00:01:05,410
.مفهوم

19
00:01:06,790 --> 00:01:07,960
...أكوتاغاوا

20
00:01:08,380 --> 00:01:11,130
.أنا حاليًا على اتّصال مع دازاي-سان عبر هذا الجهاز

21
00:01:12,550 --> 00:01:14,130
.يبدو أنّه يريد التحدّث إليك

22
00:01:15,970 --> 00:01:17,800
!دازاي-سان

23
00:01:27,100 --> 00:01:28,150
!دازاي-سان

24
00:03:02,450 --> 00:03:04,160
.مرحبًا يا زيلدا

25
00:03:04,160 --> 00:03:05,620
كيف حالكِ؟

26
00:03:06,330 --> 00:03:08,750
.أعتذر عن اتّصالي المتأخّر

27
00:03:09,710 --> 00:03:11,040
.سمعتُ الخبر

28
00:03:11,040 --> 00:03:12,920
طردتِ طبّاخًا آخر؟

29
00:03:12,920 --> 00:03:16,750
...مع أنّه قادمٌ من أرقى المطاعم في أوروبا

30
00:03:17,340 --> 00:03:21,300
.كلّا، لا ألومك، إنّها الحقيقة

31
00:03:21,800 --> 00:03:25,260
،أيّ طبّاخٍ لا يعلم أنّكِ تكرهين جبن القشدة

32
00:03:25,260 --> 00:03:27,470
.يجب أن يختفي من هذا العالم

33
00:03:28,720 --> 00:03:32,350
.أجل، ما زالت تدرس في لندن

34
00:03:32,850 --> 00:03:36,860
.بالطّبع ما كنتُ لأنسى ابنتنا ولو للحظة

35
00:03:38,320 --> 00:03:40,650
.آسف، يبدو أنّ لديّ ضيف

36
00:03:40,650 --> 00:03:42,030
.سأعاود الاتّصال بك

37
00:03:42,740 --> 00:03:44,870
.أحبّكِ يا زيلدا

38
00:03:47,200 --> 00:03:50,330
.لم يمضِ وقتٌ طويل يا فتى

39
00:03:50,960 --> 00:03:54,330
أتبحث عن هذا؟

40
00:03:54,790 --> 00:03:57,800
هل أنت من يحرس جهاز التّحكّم؟

41
00:03:57,800 --> 00:04:02,470
،إليك السّرّ الأوّل لبلوغي هذا المستوى

42
00:04:03,260 --> 00:04:08,390
".لا تعهد لأهمّ جزءٍ من العمل لأحدٍ غيرك"

43
00:04:09,220 --> 00:04:13,270
بالمناسبة، هل تعلم كم يبلغ وزن الموبي ديك؟

44
00:04:14,020 --> 00:04:16,690
.ما مجموعه تسعةٌ وعشرون ألف طنّ

45
00:04:16,690 --> 00:04:19,230
،إن سقطت من ارتفاع كيلومترين

46
00:04:19,230 --> 00:04:22,950
،فقوّتها ستعادل انفجار 140 طنًا من المتفجّرات

47
00:04:23,820 --> 00:04:26,780
.الّتي ستنفجر في قلب المدينة

48
00:04:27,570 --> 00:04:28,830
...هذا الأمر المريع

49
00:04:29,290 --> 00:04:31,290
.لن أدعك تفلت بذلك

50
00:04:31,290 --> 00:04:32,750
...السّرّ الثّاني

51
00:04:33,120 --> 00:04:35,960
".لا تدع قيَم الآخرين تؤثّر بك"

52
00:04:36,920 --> 00:04:40,210
.على أيّ حال، كلانا مشغولان

53
00:04:40,210 --> 00:04:42,920
.إن كنتَ هنا لأجل أخذ جهاز التّحكّم

54
00:04:42,920 --> 00:04:44,470
.فدعنا نبسّط الأمر

55
00:04:45,260 --> 00:04:50,560
،سنركض نحوه بعد العدّ لثلاثة
.وأوّل من يصل إليه يفوز

56
00:04:50,560 --> 00:04:53,980
.إن فزتَ فبإمكانك فعل ما تشاء بالموبي ديك

57
00:04:54,890 --> 00:05:01,110
.لكن إن فزتُ أنا فستطيعني وتساعدني في بحثي

58
00:05:01,690 --> 00:05:02,820
...واحد

59
00:05:03,240 --> 00:05:06,530
أيجب أن أقبل بتحدّيه وأركض معه؟

60
00:05:07,110 --> 00:05:07,990
...اثنان

61
00:05:07,990 --> 00:05:11,990
.كلّا، لا أستطيع أن أثق بوعدٍ لفضيّ يصدر من النّقابة

62
00:05:11,990 --> 00:05:14,000
.من الأفضل أن أخدعه وآخذه قبل انتهائه من العدّ

63
00:05:14,000 --> 00:05:15,750
!ثم أهرب

64
00:05:17,330 --> 00:05:18,630
.ثلاثة

65
00:05:20,920 --> 00:05:22,710
...السّرّ الثّالث

66
00:05:23,960 --> 00:05:28,090
من السّهل توقّع سلوك النّاس حينما"
".تمنحهم فرصةً لا يمكن تفويتها

67
00:05:30,010 --> 00:05:31,010
...عجبًا

68
00:05:31,560 --> 00:05:33,310
ألم تكن تلك الرّكلة كفيلةً بالإطاحة بك؟

69
00:05:33,310 --> 00:05:35,310
.مثيرٌ للإعجاب

70
00:05:35,310 --> 00:05:39,060
.حسنًا، ربّما عشرة آلاف كانت إهانةً بحقّك

71
00:05:39,520 --> 00:05:43,400
.هذا قسطٌ من أصولي الماليّة

72
00:05:43,400 --> 00:05:44,690
.إنّها تقدّر بمئة ألف دولار

73
00:05:45,240 --> 00:05:48,360
لم أعرّفك بقدرتي بعد، أليس كذلك؟

74
00:05:49,070 --> 00:05:50,410
...القدرة

75
00:05:51,080 --> 00:05:53,330
!فيتزغيرالد العظيم

76
00:06:02,880 --> 00:06:04,510
...قدرتي الخارقة

77
00:06:05,340 --> 00:06:10,470
!تسمح لي بزيادة قوّتي البدنيّة بقدر ما أصرفه من مال

78
00:06:14,310 --> 00:06:16,430
.كُن فخورًا يا فتى

79
00:06:16,430 --> 00:06:19,190
.فأنا لم أصرف مئة ألفٍ منذ مدّةٍ طويلة

80
00:06:19,190 --> 00:06:23,570
.على الرّغم من أنّ زيلدا كانت لتنفقه في أقلّ من شهر

81
00:06:24,020 --> 00:06:26,190
.والآن، كلّ شيءٍ يسير وفق الخطّة

82
00:06:26,190 --> 00:06:29,820
.ستسقط الموبي ديك، وقد أمسكت بك

83
00:06:31,660 --> 00:06:32,620
أنا أيضًا؟

84
00:06:33,030 --> 00:06:34,870
،مخطّطتنا الاستراتيجيّة

85
00:06:34,870 --> 00:06:39,920
تمتلك قدرةً على خلق تنبّؤاتٍ
.استنادًا على المعلومات الّتي تملكها

86
00:06:41,040 --> 00:06:46,000
،والآن بعد أن أمسكت بك
.سيكون من المزعج إن هربت مجدّدًا

87
00:06:46,000 --> 00:06:49,050
ربّما من الأفضل أن أخلع ذراعيك
.وساقيك كتدبيرٍ احترازيّ

88
00:06:56,220 --> 00:06:58,850
.عجبًا، يا له من ضيفٍ غير متوقّع

89
00:06:59,350 --> 00:07:04,650
سيّد... أغورا... أغوراغار؟

90
00:07:05,070 --> 00:07:06,150
.أكوتاغاوا

91
00:07:08,110 --> 00:07:09,740
.صحيح

92
00:07:08,110 --> 00:07:11,110
الحلقة الثّالثة والعشرون
راشومون والنّمر
والمليونير الأخير

93
00:07:18,330 --> 00:07:20,910
مرحبًا يا كيوكا-تشان، أتستطيعين سماعي؟

94
00:07:20,910 --> 00:07:22,040
.معكِ دازاي

95
00:07:22,460 --> 00:07:24,330
.لقد تفاوضنا مع قسم العمليّات الخاصّة

96
00:07:24,330 --> 00:07:27,500
.بوسعنا أن نعيدكِ إلى اليابسة في الوقت الرّاهن

97
00:07:27,880 --> 00:07:30,510
.سأعلّمكِ كيفيّة قيادة تلك الطّائرة

98
00:07:32,180 --> 00:07:33,390
.لا حاجة لذلك

99
00:07:37,510 --> 00:07:39,020
،سأكون صريحًا معكِ

100
00:07:39,680 --> 00:07:43,480
.لا تملك وكالة التّحرّي أيّ سببٍ لإنقاذكِ

101
00:07:44,610 --> 00:07:48,190
.لأنّكِ لستِ عضوًا رسميًا بعد

102
00:07:48,820 --> 00:07:53,160
.ثمّة اختبار قبول للالتحاق بالوكالة، وأنتِ لم تجتازيه بعد

103
00:07:53,820 --> 00:07:59,830
الغرض من الاختبار هو معرفة إن كان لديكِ
.القلب والشّجاعة لمساعدة أيّ غريبٍ كعضوٍ بالوكالة

104
00:08:02,000 --> 00:08:04,460
.واثقةٌ أنّي سأفشل في تجاوزه

105
00:08:07,540 --> 00:08:08,880
.لا يروقني هذا

106
00:08:10,800 --> 00:08:14,470
".قتلةٌ سابقون ليس لديهم الحقّ ليصبحوا صالحين"

107
00:08:16,010 --> 00:08:18,430
أتصدّقين ذلك حقًا؟

108
00:08:23,690 --> 00:08:26,020
،في الواقع يا سيّد أكوتاغاوا

109
00:08:26,400 --> 00:08:28,150
...كنتُ لأرحّب بك بشكلٍ لائق، ولكن

110
00:08:29,780 --> 00:08:32,320
من سمح لك بأن تستلقي على الأرض؟

111
00:08:32,320 --> 00:08:34,150
.لن أدعك تهرب هذه المرّة

112
00:08:34,150 --> 00:08:35,780
.انهض وقاتل

113
00:08:36,530 --> 00:08:38,490
.لا يمكن أن تسوء الأمور أكثر من هذا

114
00:08:39,540 --> 00:08:41,870
...لم تكن لديّ أدنى فرصة منذ البداية

115
00:08:42,370 --> 00:08:46,630
.قلتَ قبل قليل أنّك لا تستطيع فهمي

116
00:08:47,170 --> 00:08:50,710
!من وجهة نظري، أنا من لا يفهمك إطلاقًا

117
00:08:51,090 --> 00:08:55,840
.تلك النّظرة الجبانة لا أثر فيها للثّقة بقوّتك وقدرتك

118
00:08:56,260 --> 00:08:59,100
.إلّا أنّك تضع دائمًا حياتك على المحك

119
00:08:59,100 --> 00:09:02,060
!من أين لك بحسّ الفخر المتناقض هذا؟

120
00:09:02,060 --> 00:09:04,390
.هلّا أوقفت ذلك أيّها الصّغير

121
00:09:04,390 --> 00:09:07,600
—لا أحبّ أن يتمّ تجاهلي

122
00:09:08,110 --> 00:09:09,400
.اخرس

123
00:09:09,400 --> 00:09:11,530
.طبقي الرّئيسيّ هو الرّجل النّمر

124
00:09:12,070 --> 00:09:14,530
.يجب أن تنتظر التّحلية إلى أن أنتهي

125
00:09:18,740 --> 00:09:21,080
.أكره أن أكون في المرتبة الثّانية

126
00:09:21,080 --> 00:09:23,700
.أطلب تغيير ترتيبنا

127
00:09:24,870 --> 00:09:26,160
!لك ذلك

128
00:09:28,500 --> 00:09:30,420
!هل أوقف الوحش الأسود بيديه العاريّتين؟

129
00:09:35,130 --> 00:09:39,640
.تقديرًا لجهودك، سأكشف لك السّرّ الرّابع للنّجاح

130
00:09:39,640 --> 00:09:40,850
.لستُ بحاجته

131
00:09:40,850 --> 00:09:42,100
!راشومون

132
00:09:42,640 --> 00:09:43,810
!المدّ الأسود

133
00:09:43,060 --> 00:09:43,810
المد الأسود

134
00:09:46,690 --> 00:09:48,150
.خمس مئة ألف دولار

135
00:09:58,990 --> 00:10:01,490
...السّرّ الرّابع للنّجاح

136
00:10:02,910 --> 00:10:04,620
".كُن قويًا"

137
00:10:04,950 --> 00:10:11,250
،القوّة تأتي بأشكالٍ متعدّدة، الثّراء، النّفوذ
.القدرات الخارقة والمكانة الاجتماعيّة

138
00:10:11,670 --> 00:10:15,210
.ولا ضرر من امتلاكها جميعًا في حالتي

139
00:10:16,510 --> 00:10:17,670
اختفى النّمر؟

140
00:10:18,220 --> 00:10:20,010
!بِئس القوّة

141
00:10:20,010 --> 00:10:24,310
!الأموال والقدرات ليست لتفجير المدن

142
00:10:24,310 --> 00:10:29,190
الغرض من امتلاك الإنسان للقوّة
!هو لمدّ يد العون لأولئك الغارقين في اليأس

143
00:10:29,600 --> 00:10:31,730
.يا له من سوء فهمٍ بليغ

144
00:10:32,610 --> 00:10:35,780
.القوّة ليست لمساعدة الضّعفاء

145
00:10:35,780 --> 00:10:40,570
.فجني الأموال يعتمد أساسًا على استغلال الضّعفاء

146
00:10:40,950 --> 00:10:44,490
وصرف المال الّذي جنيته على
ظهرهم من أجل مساعدتهم

147
00:10:44,490 --> 00:10:48,410
.لهو أمرٌ لا طائل منه، مثل فتح بابٍ لإغلاقه مجدّدًا

148
00:10:48,410 --> 00:10:51,750
.يجب أن تُسخّر القوّة لأمورٍ أكثر قيمة

149
00:10:52,670 --> 00:10:57,590
ألهذا كنت تتجاهل أرواح الضّعفاء
الّذين دُهِسوا تحت قدميك؟

150
00:10:57,590 --> 00:11:00,090
...بقولك الضّعفاء الّذين دُهِسوا

151
00:11:00,840 --> 00:11:03,180
أتقصد على سبيل المثال، نفسك في الماضي؟

152
00:11:06,010 --> 00:11:07,850
.تقصّيت عن ماضيك

153
00:11:08,480 --> 00:11:11,940
.كِدتَ تُقتل مرّتين في طفولتك

154
00:11:11,940 --> 00:11:14,440
.من قبل مدير ميتمك

155
00:11:15,480 --> 00:11:18,150
،عندما ركلك إلى أن تكسّرت أضلعك

156
00:11:18,150 --> 00:11:20,610
...قال لك

157
00:11:20,610 --> 00:11:25,080
،مقارنةً بما فعله بك أبواك عندما كنت رضيعًا

158
00:11:25,080 --> 00:11:28,540
!فهذا لا يُعدّ عنفًا حتّى

159
00:11:36,090 --> 00:11:39,760
.نحن نبطئ. إذًا فقد دخلنا في مسار التّصادم

160
00:11:39,760 --> 00:11:42,680
.تبقّت حوالي عشر دقائق للارتطام

161
00:11:45,220 --> 00:11:46,510
.فهمت

162
00:11:46,850 --> 00:11:47,600
ماذا؟

163
00:11:51,230 --> 00:11:51,850
!انتظرا

164
00:11:54,690 --> 00:11:56,650
هربا؟

165
00:11:57,980 --> 00:12:00,990
الحلقة الثّالثة والعشرون

166
00:11:57,980 --> 00:12:00,990
كلاب الأدب الشاردة

167
00:12:10,160 --> 00:12:15,380
.أسحب كلامي السّابق في عدم مقدرتي على فهمك

168
00:12:15,880 --> 00:12:17,130
.أفهمك الآن

169
00:12:18,300 --> 00:12:23,930
أيّها الرّجل النّمر، كنتَ تقاتل دائمًا
.لأجل أن يمنحك أحدهم الإذن لتعيش

170
00:12:24,720 --> 00:12:27,640
.ولو عنى ذلك التّضحية بحياتك

171
00:12:29,470 --> 00:12:31,560
.يا له من أمرٍ مقيت

172
00:12:34,770 --> 00:12:36,980
أتؤمن بذلك حقًا أيّها الرّجل النّمر؟

173
00:12:37,730 --> 00:12:39,900
أتؤمن بأنّ أحدهم سيمنحك ذلك الإذن؟

174
00:12:40,690 --> 00:12:43,280
هل ظننت أنّك بالقتال وحده
ونزف بعض الدّم لأجل الآخرين

175
00:12:43,280 --> 00:12:47,490
سيأتي أحدهم ليضع ختمًا على
!جبينك يقول "يستحقّ العيش"؟

176
00:12:48,070 --> 00:12:50,620
وما الخطأ في تصديق ذلك؟

177
00:12:50,990 --> 00:12:53,040
!يا لك من خيبة أمل

178
00:12:53,460 --> 00:12:56,250
.لم أتوقّع أن تكون بهذه الدّرجة من الغباء

179
00:12:56,250 --> 00:13:00,670
،حتّى لو قتلت أحمق مثلك مئات المرّات
.فلن يمنحني ذلك أيّ فخرٍ أو إنجاز

180
00:13:02,260 --> 00:13:03,550
أقلتَ إنجاز؟

181
00:13:03,550 --> 00:13:04,670
.بالفعل

182
00:13:05,220 --> 00:13:07,590
.ذلك هو القيمة الوحيدة الّتي تحتسب

183
00:13:07,590 --> 00:13:11,600
.دون أيّ إنجاز، لن يعترف بي ذلك الرّجل أبدًا

184
00:13:13,020 --> 00:13:15,060
...دازاي-سان أبدًا لن

185
00:13:16,390 --> 00:13:17,770
دازاي-سان؟

186
00:13:18,230 --> 00:13:21,110
وما علاقته بهذا؟

187
00:13:26,450 --> 00:13:29,660
.وجدتكما أيّها الكلبان المشرّدان

188
00:13:31,700 --> 00:13:33,040
،كيوكا-تشان

189
00:13:33,500 --> 00:13:35,540
.كلّ شخصٍ يملك نقاط قوّةٍ وضعف

190
00:13:35,960 --> 00:13:39,000
.ومن الواضح أنّكِ تملكين موهبةً في القتل

191
00:13:39,540 --> 00:13:44,050
وهذا يجعلكِ تعتقدين أنّكِ لستِ
.مناسبةً للانضمام إلى وكالة التّحرّي

192
00:13:44,510 --> 00:13:46,130
.ذلك محض هراء

193
00:13:46,630 --> 00:13:51,220
.سأثبتُ لكِ في ثانية كم أنّ هذا الاعتقاد واهٍ

194
00:13:52,220 --> 00:13:55,890
كيوكا-تشان، كم شخصًا قتلتهِ بيديكِ؟

195
00:13:56,980 --> 00:13:58,310
.خمسةٌ وثلاثون

196
00:13:58,900 --> 00:14:01,020
قتلتِ خمسةً وثلاثين شخصًا. وماذا بعد؟

197
00:14:03,940 --> 00:14:05,280
.أصغي يا كيوكا-تشان

198
00:14:06,360 --> 00:14:08,950
.لا تعلمين كلّ شيءٍ عن وكالة التّحرّي

199
00:14:09,490 --> 00:14:11,870
.ولا تعلمين كلّ شيءٍ عن نفسكِ أيضًا

200
00:14:12,660 --> 00:14:15,200
.لا أحد يستطيع الإحاطة بكلّ شيء

201
00:14:15,620 --> 00:14:18,160
".وهذا ما ندعوه بـ"الإمكانيّة

202
00:14:19,290 --> 00:14:22,170
،حتّى أتسوشي-كُن الّذي منحكِ فرصةً أخرى

203
00:14:22,170 --> 00:14:24,170
.كان يُعتبر وحشًا فتّكًا

204
00:14:24,880 --> 00:14:29,130
.لكنّه الآن يخاطر بحياته ليقوم بما يستطيع وحده فعله

205
00:14:29,760 --> 00:14:31,510
.لأجل حماية هذه المدينة

206
00:14:37,520 --> 00:14:38,520
.هذا هو

207
00:14:38,520 --> 00:14:39,980
.مصعد البضائع

208
00:14:48,950 --> 00:14:51,740
.لا أملك أدنى فرصةٍ للفوز أمام قدرته تلك

209
00:14:52,370 --> 00:14:55,490
.يجب أن أفكّر في طريقةٍ لسلبه جهاز التّحكّم

210
00:14:56,910 --> 00:14:59,160
.أحمق كالعادة

211
00:14:59,160 --> 00:15:00,460
!ماذا؟

212
00:15:00,460 --> 00:15:04,540
.هذا المصعد سيقلّنا إلى السّطح حيث لا مهرب

213
00:15:05,170 --> 00:15:08,590
.نحن من حوصر في الزّاوية

214
00:15:09,090 --> 00:15:10,340
.محال

215
00:15:11,590 --> 00:15:16,680
التّفكير في أنّي هُزمتُ من قبل
.حثالةٍ مثلك، لهو أمرٌ مخزي

216
00:15:16,680 --> 00:15:21,270
لا سيّما وأنا أعلم أنّك شخصٌ عديم القيمة
.لدرجة أن يطلب حقّه في العيش من الآخرين

217
00:15:21,270 --> 00:15:23,230
.بالفعل، قد أكون عديم القيمة

218
00:15:23,940 --> 00:15:28,650
لكنّني أفضل مئة مرّةٍ من قاتلٍ
!هدفه الوحيد في الحياة هو التّباهي بقوّته

219
00:15:29,110 --> 00:15:30,400
ماذا قلت؟

220
00:15:30,400 --> 00:15:32,660
.تملك القوّة والمكانة الوفيرة

221
00:15:33,160 --> 00:15:35,660
.ولكنّك تقاتل فقط لتجعل النّاس تهابك

222
00:15:35,660 --> 00:15:37,700
!هذا عديم القيمة أكثر بكثير

223
00:15:39,790 --> 00:15:41,250
!اسحب كلامك

224
00:15:42,870 --> 00:15:46,000
أملك القوّة والمكانة؟

225
00:15:48,800 --> 00:15:51,840
.سأخبرك لِم نعتّك بالمقيت

226
00:15:51,840 --> 00:15:56,430
!هذا لأنّك تملك كلّ شيء، لكنّك لا تبصر ما لديك

227
00:15:56,430 --> 00:16:00,140
!وبدل ذلك تستمرّ في الاكتئاب بسبب جراح الماضي

228
00:16:00,810 --> 00:16:01,560
ماذا؟

229
00:16:02,230 --> 00:16:03,770
ماذا قلت عنّي؟

230
00:16:03,770 --> 00:16:05,610
.أنت ميمونٌ بقدرتك

231
00:16:05,610 --> 00:16:07,230
.وميمونٌ بأصدقائك

232
00:16:07,230 --> 00:16:11,110
كما أنّك تحظى بثناء واعتراف دازاي-سان
!بدون بذل أيّ جهد وبالحظّ فقط

233
00:16:11,110 --> 00:16:13,490
!ومع ذلك لا تبصر تلك النّعم

234
00:16:13,490 --> 00:16:15,240
!وتستمرّ في التمرّغ بمآسيك

235
00:16:15,240 --> 00:16:16,570
!أنت أحمق ومقيت

236
00:16:18,950 --> 00:16:22,960
.دون أيّ إنجاز، لن يعترف بي ذلك الرّجل أبدًا

237
00:16:24,370 --> 00:16:26,420
...دازاي-سان أبدًا لن

238
00:16:28,290 --> 00:16:29,920
دازاي-سان؟

239
00:16:30,670 --> 00:16:33,550
...لا يعقل أنّك لطالما كنتَ

240
00:16:46,150 --> 00:16:48,940
.يكفينا من لعبة الملاحقة

241
00:16:49,360 --> 00:16:54,070
في أقلّ من عشر دقائق، ستصل
.الموبي ديك إلى نقطة اللّاعودة

242
00:16:54,070 --> 00:16:55,950
...وحينها

243
00:16:55,950 --> 00:16:59,700
.حتّى هذا الجهاز لن يستطيع إيقاف سقوطها

244
00:16:59,700 --> 00:17:04,790
.وأنا الوحيد الّذي سينجو بفضل تعزيز جسدي بقدرتي

245
00:17:04,790 --> 00:17:06,880
،أنت يا حديث الثّراء

246
00:17:06,880 --> 00:17:11,710
إن هزمتُ قويًا مثلك، فلن أكون ضعيفًا بعدها، صحيح؟

247
00:17:15,090 --> 00:17:16,680
.أضمن لك ذلك

248
00:17:16,680 --> 00:17:20,510
.إذًا فلن أتراجع حتّى وإن تحوّل جسدي إلى غبار

249
00:17:21,010 --> 00:17:21,180
را

250
00:17:21,600 --> 00:17:22,850
!راشومون

251
00:17:22,060 --> 00:17:22,850
راشومون

252
00:17:25,730 --> 00:17:27,020
الدرع

253
00:17:25,810 --> 00:17:27,020
...الدّرع

254
00:17:29,730 --> 00:17:30,980
الشيطاني

255
00:17:29,940 --> 00:17:30,980
!الشّيطاني

256
00:17:47,290 --> 00:17:50,130
!هل يحرّك جسده قسرًا بقدرته؟

257
00:17:54,920 --> 00:17:57,130
...رغم امتلاك أكوتاغاوا لهذه القوّة

258
00:17:57,510 --> 00:18:00,100
.إلّا أنّه يظنّ نفسه ضعيفًا

259
00:18:00,550 --> 00:18:02,970
!إن كان الأمر كذلك، فأنت سخيف

260
00:18:02,970 --> 00:18:05,890
كم من شخصٍ بظنّك قد مات بسبب أنانيّتك؟

261
00:18:08,140 --> 00:18:09,060
...أيّها النّمر

262
00:18:10,360 --> 00:18:12,400
.امنحني القوّة مجدّدًا

263
00:18:12,900 --> 00:18:14,820
.كما المرّة السّابقة

264
00:18:26,910 --> 00:18:28,580
!تنحّ عن طريقي أيّها الرّجل النّمر

265
00:18:28,580 --> 00:18:30,750
!بل تنحّ أنت عن طريقي

266
00:18:32,040 --> 00:18:33,920
!ماذا بشأن دازاي-سان؟

267
00:18:33,920 --> 00:18:35,630
!أنت عديم القيمة أكثر منّي

268
00:18:35,630 --> 00:18:36,670
!هراء

269
00:18:36,670 --> 00:18:38,800
!بل أنت عديم القيمة أكثر مني

270
00:18:38,800 --> 00:18:40,090
.مثير

271
00:18:41,140 --> 00:18:44,640
.أنتما متشابهان جدًا

272
00:18:46,220 --> 00:18:46,930
!ماذا؟

273
00:18:47,270 --> 00:18:48,640
...لا تجرؤ

274
00:18:48,640 --> 00:18:50,100
...على مقارني

275
00:18:50,270 --> 00:18:52,770
!بشخصٍ مثله

276
00:19:04,910 --> 00:19:09,330
هذه التّقنيّة تمكّنني من تحويل
...النّسيج الأسود إلى درعٍ خارجيّ

277
00:19:10,040 --> 00:19:12,130
.لكنّ جسدي الضّعيف لن يصمد طويلًا بداخله

278
00:19:12,500 --> 00:19:15,040
هل تستريح يا أكوتاغاوا؟

279
00:19:15,040 --> 00:19:15,800
!اخرس

280
00:19:15,800 --> 00:19:17,010
!أنت التّالي

281
00:19:17,010 --> 00:19:19,550
.جهاز التّحكّم له الأولويّة

282
00:19:19,550 --> 00:19:23,640
،إن اصطدمت هذه السّفينة بالمدينة
فحتّى دازي-سان سيهلك، صحيح؟

283
00:19:24,550 --> 00:19:27,350
.وكأنّ ذلك الشّخص سيموت بسهولة

284
00:19:33,060 --> 00:19:35,860
...أخبرني أيّها الخنفساء النّمريّة

285
00:19:36,650 --> 00:19:43,910
أهناك شيءٌ بهذا العالم يستحقّ
التّضحيّة بكلّ شيءٍ من أجله عدا العائلة؟

286
00:19:44,490 --> 00:19:50,210
.سأحصل على الكتاب وأعيد ابنتي إلى الحياة

287
00:19:50,210 --> 00:19:51,160
ابنتك؟

288
00:19:58,630 --> 00:20:04,260
لم تتقبّل زوجتي زيلدا حقيقة
.وفاة ابنتنا وأصبحت مختلّة

289
00:20:04,260 --> 00:20:09,600
ما زالت إلى يومنا هذا تلجأ لخيالها
.وتُوهم نفسها بأنّ ابنتنا تدرس بلندن

290
00:20:10,430 --> 00:20:14,810
.سأجعل من ذلك الخيال واقعًا وأعيد شمل عائلتي

291
00:20:15,560 --> 00:20:17,860
.مهما كلّف الثّمن

292
00:20:19,280 --> 00:20:21,490
.ثروتي غير لازمة

293
00:20:26,160 --> 00:20:28,410
!سأنفقها كلّها

294
00:20:36,670 --> 00:20:38,290
.إنّه بعيدٌ كلّ البعد عن مستوانا

295
00:20:38,880 --> 00:20:42,050
.وكأنّنا نقف أمام إعصارٍ هائل

296
00:20:42,920 --> 00:20:46,590
أهذه إرادة زعيم النّقابة؟

297
00:21:06,910 --> 00:21:07,910
...أكوتاغاوا

298
00:21:07,910 --> 00:21:09,120
ماذا؟

299
00:21:10,910 --> 00:21:13,830
هل أنا أحمق؟

300
00:21:14,460 --> 00:21:17,500
أمن السّخافة أنّي أريد الهرب من تلك الذّكريات؟

301
00:21:18,130 --> 00:21:20,340
.أجل، ذلك سخيف

302
00:21:20,920 --> 00:21:26,800
،فتلك الكلمات الّتي أذتك في ماضيك
.لم يعد لها علاقةٌ بما أنت عليه الآن

303
00:21:33,560 --> 00:21:34,390
.فهمت

304
00:21:37,230 --> 00:21:40,730
.أظنّ أنّ دازاي-سان قد اعترف بك قبل وقتٍ طويل

305
00:21:49,700 --> 00:21:50,530
!هلمّا إليّ

306
00:21:51,910 --> 00:21:54,580
!وحشٌ تحت ضوء القمر، هجين الرّجل النّمر

307
00:21:56,830 --> 00:21:59,540
!راشومون، الدّرع الشّيطاني

