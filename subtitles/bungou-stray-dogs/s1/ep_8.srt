.شيطانة الثّلج

171
00:10:58,970 --> 00:11:01,970
الحلقة الثّامنة

172
00:10:58,970 --> 00:11:01,970
كلاب الأدب الشاردة

173
00:11:03,010 --> 00:11:07,730
،مزّيقي أعدائكِ
يا شيطانة الثّلج

174
00:11:03,050 --> 00:11:07,350
.مزّقي أعداءك يا شيطانة الثّلج

175
00:11:22,030 --> 00:11:24,200
!إنّها... إنّها قويّة جدًا

176
00:11:28,160 --> 00:11:29,870
لـ-لماذا؟

177
00:11:30,790 --> 00:11:32,880
...لِم فتاةٌ مثلكِ

178
00:11:35,340 --> 00:11:37,380
،اسمي كيوكا

179
00:11:37,380 --> 00:11:39,130
.أنا يتيمةٌ مثلك

180
00:11:39,760 --> 00:11:41,970
.أحبّ الأرانب والتّوفو

181
00:11:42,720 --> 00:11:44,850
.وأكره الكلاب والبرق

182
00:11:45,510 --> 00:11:47,060
،بعد أن تمّ أخذي من قبل مافيا الميناء

183
00:11:47,510 --> 00:11:49,560
.قتلت 35 شخصًا في ستّة أشهر

184
00:11:50,430 --> 00:11:52,230
،احمي القنبلة

185
00:11:52,230 --> 00:11:54,440
.واقتلي كلّ من يتدخّل

186
00:12:00,860 --> 00:12:04,320
.أعضاء وكالة التّحرّي ليسوا أقوياء كما يُشاع عنهم

187
00:12:04,870 --> 00:12:05,740
.لا يهم

188
00:12:06,330 --> 00:12:10,370
:أنتِ على شفا الموت، لكن أخبريني بهذا أوّلًا

189
00:12:10,790 --> 00:12:12,000
ما الّذي يعنيه الموت؟

190
00:12:13,750 --> 00:12:15,380
ماذا قلت؟

191
00:12:15,380 --> 00:12:18,090
.إنّه مجرّد اهتمامٍ أكاديميّ

192
00:12:18,380 --> 00:12:20,840
.أنا باحثٌ فذّ كما ترين

193
00:12:20,840 --> 00:12:22,260
،كلّ أسباب موت الإنسان

194
00:12:22,260 --> 00:12:25,590
،بما في ذلك اختناق الخلايا العصبيّة وتآكل القطعة النّهائيّة

195
00:12:25,590 --> 00:12:29,640
.هي عمليّات بسيطة ويُمكن عكسها في المختبر

196
00:12:29,640 --> 00:12:32,560
لكن لِم الموت لا رجعة فيه؟

197
00:12:32,560 --> 00:12:34,810
ولِم يتحتّم على البشر الموت؟

198
00:12:37,310 --> 00:12:39,150
ألا تدري أمرًا بسيطًا كهذا؟

199
00:12:39,610 --> 00:12:43,110
.إذًا فالمافيا ليسوا حاذقين في النّهاية

200
00:12:43,110 --> 00:12:46,820
أتدّعين أنّ محقّقة سرّيّة متطفّلة

201
00:12:46,820 --> 00:12:50,370
قد تعرف شيئًا لا أعرفه أنا طالب العلم؟

202
00:12:50,370 --> 00:12:52,040
.بالطّبع

203
00:12:52,040 --> 00:12:54,120
.السّبب بسيط

204
00:12:54,540 --> 00:12:56,830
.لأنّك مجرّد أبله

205
00:13:00,840 --> 00:13:03,420
.شكرًا على رأيك القيّم

206
00:13:03,970 --> 00:13:07,140
...أظنّكِ تعرفين هذا بما أنّكِ واسعة الاطّلاع

207
00:13:08,930 --> 00:13:11,390
،لكن حتّى بعد الموت جرّاء فقدان الدّمّ

208
00:13:11,390 --> 00:13:13,980
.يمكن للدّماغ الحفاظ على الوعي لثمان ساعاتٍ أخرى

209
00:13:14,350 --> 00:13:16,850
:سأعود لاحقًا، لأسأل جثّتكِ هذا

210
00:13:19,150 --> 00:13:22,110
"كيف تشعرين الآن وأنتِ ميّتة؟"

211
00:13:22,530 --> 00:13:25,400
.حسنٌ، خذي وقتكِ

212
00:13:35,750 --> 00:13:36,620
.هذا مستحيل

213
00:13:36,620 --> 00:13:37,920
.لا يمكنني الفوز

214
00:13:38,580 --> 00:13:40,590
هل سأموت هنا؟

215
00:13:45,420 --> 00:13:48,050
هل سيموت أشخاصٌ آخرون بسببي؟

216
00:13:48,510 --> 00:13:50,470
فقط لأنّهم استقلوا نفس القطار الّذي ركبته؟

217
00:13:50,890 --> 00:13:53,430
...سيموتون فقط لذلك السّبب البسيط

218
00:13:54,520 --> 00:13:56,890
.هذا هو قدرك أيّها الرّجل النّمر

219
00:13:54,810 --> 00:13:56,940
هذا هو
.قدرك

220
00:13:55,390 --> 00:13:56,940
النّمر أيها الرّجل

221
00:13:57,690 --> 00:14:00,900
.أنت تجلب البؤس لمن حولك لمجّرد كونك على قيد الحياة

222
00:14:21,130 --> 00:14:22,880
...في تلك اللّحظة

223
00:14:22,880 --> 00:14:25,300
.خطرت على بالي فكرة

224
00:14:26,010 --> 00:14:27,590
.لقد كانت فكرةً غبيّة

225
00:14:28,510 --> 00:14:30,430
.لكن لم أستطع تجاهلها

226
00:14:32,510 --> 00:14:33,890
...في حالة ما

227
00:14:34,220 --> 00:14:35,810
...إن تمكّنت من انقاذ الرّكاب

228
00:14:36,180 --> 00:14:37,520
......إن تمكّنت من إنقاذ حياتهم

229
00:14:37,520 --> 00:14:39,230
...إن استطعتُ أن أعيدهم بسلام إلى بيوتهم

230
00:14:40,060 --> 00:14:41,110
...حينها

231
00:14:44,730 --> 00:14:45,690
...أنا

232
00:14:51,370 --> 00:14:54,450
ألن يعني أنّه لا بأس لي بأن أعيش؟

233
00:14:54,450 --> 00:14:55,790
.لا تقترب

234
00:14:57,330 --> 00:14:58,250
.آسف

235
00:14:58,790 --> 00:14:59,960
!فات الأوان

236
00:15:08,170 --> 00:15:09,590
.إنّها سريعة جدًا

237
00:15:09,970 --> 00:15:11,470
.أظنّني لا أستطيع فعلها

238
00:15:11,890 --> 00:15:14,930
...ليتني كنتُ أملك تلك القوّة الآن

239
00:15:22,600 --> 00:15:24,270
.حسنًا

240
00:15:25,320 --> 00:15:28,690
.أتساءل ما إن تمّ طهيها جيّدًا

241
00:15:34,120 --> 00:15:35,030
.فلنرَ

242
00:15:42,620 --> 00:15:44,380
.كان ذلك مخيّبًا

243
00:15:44,380 --> 00:15:46,380
.كنتُ آمل أنّك ستطير لمسافةٍ أبعد من ذلك

244
00:15:46,380 --> 00:15:48,130
كـ-كيف؟

245
00:15:48,130 --> 00:15:50,630
.ما كانت تلك المفرقعات الصّغيرة لتقتلني

246
00:15:51,050 --> 00:15:53,140
في أيّ جانب لكمتك للتّو؟

247
00:15:53,430 --> 00:15:56,810
.إ-إ-إن أمكنني الاختيار، ربّما هذا الجانب

248
00:16:03,940 --> 00:16:05,230
!مستحيل

249
00:16:05,230 --> 00:16:07,020
.لقد كنتِ على شفا الموت قبل قليل

250
00:16:07,020 --> 00:16:09,820
.قد لا يبدو هذا عليّ، لكنّي طبيبة

251
00:16:09,820 --> 00:16:12,030
.لقد رأيت أمواتًا أكثر منك بكثير

252
00:16:14,660 --> 00:16:16,450
هل سألت ما هو الموت؟

253
00:16:16,450 --> 00:16:17,870
...دعني أخبرك

254
00:16:18,370 --> 00:16:20,830
.الموت هو فقدان الحياة

255
00:16:21,210 --> 00:16:24,250
،مهما حاولنا نحن الأطبّاء

256
00:16:24,250 --> 00:16:27,290
...إلّا أنّ حياة مرضانا تنزلق من بين أصابعنا

257
00:16:27,880 --> 00:16:30,420
أقلت أنّ الموت هو ذِروة العلم؟

258
00:16:30,420 --> 00:16:31,510
!هراء

259
00:16:32,090 --> 00:16:34,760
!وغدٌ مثلك لا يقدّر الحياة يستحقّ الموت على يدي

260
00:16:35,180 --> 00:16:36,890
...تـ-تذكّرت الآن

261
00:16:37,350 --> 00:16:39,180
...طبيبة وكالة التّحرّي المسلّحة

262
00:16:39,600 --> 00:16:41,560
أأنتِ يوسانو أكيكو؟

263
00:16:41,980 --> 00:16:45,190
"،قدرتي المسمّاة "لا يجب أن تموت

264
00:16:45,190 --> 00:16:47,480
.يمكنها أن تعالج أيّ جرح

265
00:16:47,900 --> 00:16:50,610
.وحتّى جراحي كما ترى

266
00:16:51,070 --> 00:16:53,950
.لكنّ الشّروط اللّازمة صارمة

267
00:16:54,490 --> 00:16:57,280
.يمكنها أن تعالج فقط الإصابات المميتة

268
00:16:58,080 --> 00:16:59,990
.يا لها من قدرة غير مريحة

269
00:17:00,790 --> 00:17:06,630
،لو أردتُ أن أعالج الإصابات المتوسّطة
.فعليّ أن أجعل مريضي في حالةٍ حرجة أوّلًا

270
00:17:07,420 --> 00:17:08,500
...عجبًا

271
00:17:08,840 --> 00:17:11,670
أنت مصاب، أليس كذلك يا فتى؟

272
00:17:11,670 --> 00:17:13,470
أتريدني أن أعالجك؟

273
00:17:25,600 --> 00:17:26,810
...هذا

274
00:17:40,370 --> 00:17:41,620
.انتهى الأمر

275
00:17:45,250 --> 00:17:47,210
.اسمي كيوكا

276
00:17:48,500 --> 00:17:50,790
.لقد قتلت 35 شخصًا

277
00:17:53,260 --> 00:17:54,510
أين هي القنبلة؟

278
00:17:55,050 --> 00:17:58,220
،ضحيّتي الأخيرة كانت أسرة من ثلاثة أفراد

279
00:17:58,720 --> 00:18:01,220
.أبٌ وأمّ وابن

280
00:18:01,680 --> 00:18:03,810
.ذبحتهم شيطانة الثّلج

281
00:18:07,230 --> 00:18:08,560
ما هذا الّذي اقترفته؟

282
00:18:08,940 --> 00:18:11,230
من أنتِ بحقّ؟

283
00:18:11,230 --> 00:18:15,280
.لا يمكنني أن أحسّ بأيّ مشاعر في كلماتك ولا حتّى بكِ

284
00:18:15,900 --> 00:18:17,700
.أنتِ أشبه بآلة قتل

285
00:18:18,490 --> 00:18:20,910
.إن كنتِ تشعرين بأيّ شيء فيجب أن تتكلّمي

286
00:18:21,450 --> 00:18:24,040
.وإلّا غبيّ مثلي لن يفهم

287
00:18:24,540 --> 00:18:27,500
!أهذا حقًا ما تودّين فعله؟

288
00:18:29,670 --> 00:18:31,290
.معكم غرفة القيادة

289
00:18:31,630 --> 00:18:32,670
!أتسوشي

290
00:18:32,670 --> 00:18:34,050
أما زلتَ تتنفّس؟

291
00:18:34,050 --> 00:18:35,130
يوسانو-سينسي؟

292
00:18:35,630 --> 00:18:37,970
،وفقًا لما قاله مفتعل التّفجيرات الضّعيف هذا

293
00:18:37,970 --> 00:18:41,050
.فالقنبلة الّتي في ناحيّتك لديها جهاز تفجير عن بعد

294
00:18:41,050 --> 00:18:43,220
،إن أخطأت ولو مرّةً في محاولة إبطالها

295
00:18:43,220 --> 00:18:44,770
.فستنفجر على الفور

296
00:18:45,220 --> 00:18:48,190
عليك أن تستخدم زرّ الإيقاف
.الّذي بجهاز التّفجير عن بعد لإبطالها

297
00:18:48,190 --> 00:18:50,400
.يفترض أنّه بحوزة عضوة المافيا الّتي هناك

298
00:18:50,940 --> 00:18:52,360
هل هو بحوزتك؟

299
00:18:53,190 --> 00:18:54,190
.سلّميني إيّاه

300
00:19:12,880 --> 00:19:13,540
!ماذا؟

301
00:19:13,710 --> 00:19:16,550
ضغطتِ هل
...الزّر على
كيوكا؟يا

302
00:19:13,710 --> 00:19:16,550
ضغطتِ هل
...الزّرعلى
كيوكا؟يا

303
00:19:13,880 --> 00:19:16,550
هل ضغطتِ على الزّرّ يا كيوكا؟

304
00:19:17,050 --> 00:19:18,720
.لا تنزعي القنبلة

305
00:19:18,720 --> 00:19:23,260
موتي مع الرّكاب وأظهري للجموع
.أنّ عليهم الخوف من مافيا الميناء

306
00:19:23,600 --> 00:19:24,720
!انزعي القنبلة

307
00:19:25,100 --> 00:19:27,060
!كم تبقّى لدينا من وقت؟

308
00:19:27,350 --> 00:19:28,230
!لا يوجد وقت

309
00:19:28,230 --> 00:19:28,980
ماذا؟

310
00:19:33,230 --> 00:19:35,400
.يبدو أنّي مجرّد غبي

311
00:19:35,940 --> 00:19:40,150
...عندما تمّ دفعي بهاتين الذراعين النّحيلتين أدركت أخيرًا

312
00:19:40,990 --> 00:19:45,160
أنّ قدرتها دائمًا ما كانت تُفعّل بعد الاستماع
.إلى الصّوت عبر هاتفها المحمول

313
00:19:45,830 --> 00:19:49,450
.لم تكن قادرةً على التّحكّم بقدرتها بنفسها

314
00:19:50,080 --> 00:19:51,710
.اسمي كيوكا

315
00:19:52,460 --> 00:19:54,380
.قتلت 35 شخصًا

316
00:19:56,340 --> 00:19:59,550
!لا أريد أن أقتل أحدًا بعد الآن

317
00:20:16,270 --> 00:20:17,480
!أتسوشي

318
00:20:59,360 --> 00:21:00,230
...المعذرة

319
00:21:24,470 --> 00:21:27,430
.يبقى البيدق بيدقًا مهما كان قويًا

320
00:21:28,390 --> 00:21:29,720
ماذا عنك؟

321
00:21:30,810 --> 00:21:32,770
هل أنت البيدق أم الشّاه؟

322
00:21:33,180 --> 00:21:37,060
أمّ أنّك بيدقٌ ينتظر أن يُسحق؟

323
00:23:11,450 --> 00:23:13,280
.لم تقم بقتل النّاس بإرادتها

324
00:23:14,030 --> 00:23:16,950
.ليس من الضّروريّ أن تجلب القدرات السّعادة لأصحابها

325
00:23:16,950 --> 00:23:19,040
!أعلم ذلك أكثر من أيّ أحد

326
00:23:19,500 --> 00:23:24,170
،لكن إن سلّمتها للشّرطة
!فسيُحكم عليها بالموت بالتّأكيد

327
00:23:24,170 --> 00:23:26,000
إلى أين تأخذني؟

328
00:23:26,000 --> 00:23:27,380
...هذا... حسنٌ

329
00:23:27,880 --> 00:23:29,880
.فلنخرج في موعدٍ أوّلًا

330
00:23:29,880 --> 00:23:30,300
ماذا؟

331
00:23:30,760 --> 00:23:31,890
موعدٌ معك؟

332
00:23:32,220 --> 00:23:35,060
:في الحلقة القادمة من كلاب الأدب الشّاردة، الحلقة التّاسعة

333
00:23:35,060 --> 00:23:37,430
----------------------------------------------------------------------------------------

334
00:23:35,060 --> 00:23:37,430
-------------

335
00:23:35,060 --> 00:23:37,430
الحلقة التّاسعة

336
00:23:35,060 --> 00:23:37,430
مثل تمثالٍ حجري صامتٌ الجمال

337
00:23:35,060 --> 00:23:38,020
.الجمال صامت مثل تمثالٍ حجريّ

338
00:23:38,020 --> 00:23:39,640
.التّوفو المغليّ لذيذ