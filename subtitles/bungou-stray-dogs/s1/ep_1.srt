67
00:03:25,720 --> 00:03:30,480
أتلقّى
ـــــــــــــــــــ
الموعظة؟

68
00:03:25,890 --> 00:03:29,100
ماذا؟ أيوبّخني الآن؟

69
00:03:29,390 --> 00:03:30,480
،على أيّ حال

70
00:03:30,480 --> 00:03:34,610
.أؤمن بانتحارٍ "نظيف" لا يخلق المتاعب للآخرين

71
00:03:35,110 --> 00:03:39,740
.إلّا أنّي قد أزعجتك، لِذا فالخطأ يقع عليّ

72
00:03:39,740 --> 00:03:41,200
...يجب أن أعتذر منك بطريقةٍ ما

73
00:03:42,280 --> 00:03:44,780
هل أنتَ جائعٌ يا فتى؟

74
00:03:44,950 --> 00:03:46,030
...في الحقيقة

75
00:03:46,370 --> 00:03:49,040
.لم أذق زادًا منذ أيام

76
00:03:51,160 --> 00:03:52,250
.كم هذا غريب

77
00:03:52,620 --> 00:03:54,240
.أنا جائعٌ أيضًا

78
00:03:54,240 --> 00:03:55,330
...إذًا

79
00:03:55,330 --> 00:03:57,750
.بالمناسبة، يبدو أنّ النّهر قد جرف محفظتي

80
00:03:59,340 --> 00:04:00,970
...لا بدّ أنّكَ تمزح

81
00:04:00,970 --> 00:04:03,510
!إذًا فقد كنتٙ هنا طوال الوقت أيّها الأبله

82
00:04:06,180 --> 00:04:09,060
.أحسنت عملًا يا كونيكيدا-كُن

83
00:04:09,600 --> 00:04:11,560
أحسنتُ عملًا في ماذا؟

84
00:04:11,560 --> 00:04:13,940
.أنت سبب كلّ هذا العمل المجهد

85
00:04:13,940 --> 00:04:15,060
!أيّها المهووس بالانتحار

86
00:04:15,060 --> 00:04:18,230
!إلى متى تنوي تعطيل جدول أعمالي؟

87
00:04:17,400 --> 00:04:18,230
.صحيح

88
00:04:18,610 --> 00:04:20,530
.خطرت ببالي فكرةٌ رائعة

89
00:04:20,530 --> 00:04:22,440
.إنّه زميلي في العمل

90
00:04:22,440 --> 00:04:24,150
.فلندعه يدعوك على وجبة طعام

91
00:04:24,150 --> 00:04:25,950
أتنصت إلى ما أقول؟

92
00:04:26,990 --> 00:04:28,700
ما هو اسمك؟

93
00:04:29,080 --> 00:04:29,870
ماذا؟

94
00:04:30,450 --> 00:04:32,830
.ناكاجيما... أتسوشي

95
00:04:32,830 --> 00:04:36,000
!حسنًا، فلتأتِ معي يا أتسوشي-كُن

96
00:04:36,000 --> 00:04:37,380
ماذا تريد أن تأكل؟

97
00:04:38,170 --> 00:04:39,210
...حسنٌ

98
00:04:40,210 --> 00:04:41,670
...إن لم يكن في الأمر إزعاج

99
00:04:41,670 --> 00:04:43,260
!لا داعي للخجل

100
00:04:44,970 --> 00:04:46,840
...أودّ أكل التشازوكي

101
00:04:52,850 --> 00:04:55,980
صبيٌّ على شفا الموت جوعًا يريد أكل التشازوكي؟

102
00:04:55,980 --> 00:04:59,650
!جيّد، فلنجعل كونيكيدا-كُن يدعوك على ثلاثين طبقًا منه

103
00:05:00,270 --> 00:05:02,320
!لا تستفد من مالي كما يحلو لك يا دازاي

104
00:05:03,900 --> 00:05:04,860
دازاي؟

105
00:05:05,280 --> 00:05:08,070
.أجل، هذا هو اسمي

106
00:05:15,330 --> 00:05:17,290
.اسمي دازاي

107
00:05:18,170 --> 00:05:19,750
.دازاي أوسامو

108
00:05:29,930 --> 00:05:32,720
.أنتَ حقًا مخبول

109
00:05:32,720 --> 00:05:37,390
"من هذا الّذي سيقول "يا له من نهرٍ رائع
!ومن ثمّ يلقي نفسه فيه أثناء العمل؟

110
00:05:38,020 --> 00:05:39,230
!انظر إلى حالنا

111
00:05:39,230 --> 00:05:41,360
!لقد تأخّرنا عن جدول أعمالنا بفضلك

112
00:05:41,650 --> 00:05:44,610
.أنت حقًا تحبّ مفكّرتك يا كونيكيدا-كُن

113
00:05:46,200 --> 00:05:48,160
!هذه ليست مفكّرة

114
00:05:48,110 --> 00:05:49,570
المثل العليا

115
00:05:48,740 --> 00:05:49,570
!بل مُثل

116
00:05:49,570 --> 00:05:52,080
!مرشدي في الحياة

117
00:05:52,080 --> 00:05:56,120
!ولن تجد في طيّاته أنّ زميلي في العمل مهووس انتحار

118
00:05:58,960 --> 00:05:59,960
!اخرس

119
00:06:00,540 --> 00:06:02,630
كما لن تجد في صفحة مصاريفي المتوقّعة

120
00:06:02,630 --> 00:06:06,090
!أن شقيًا صغيرًا سيأكل جبلًا من التشازوكي على حسابي

121
00:06:08,090 --> 00:06:09,800
!كما قلت، هذا عمل

122
00:06:11,850 --> 00:06:13,560
عملنا اليوم؟

123
00:06:13,560 --> 00:06:15,390
.إنّه يتعلّق بالقوّات المسلّحة

124
00:06:16,020 --> 00:06:18,480
كيف تتواصلان مع بعض؟

125
00:06:20,270 --> 00:06:23,110
.لقد شبعت

126
00:06:23,360 --> 00:06:25,900
.لا أريد أن أرى طبقًا آخر من التشازوكي لعقدٍ من الزّمن

127
00:06:25,900 --> 00:06:27,030
...أيها

128
00:06:27,030 --> 00:06:31,280
كيف تجرؤ على أن تكون وقحًا هكذا بعد أن أكلت على حسابي؟

129
00:06:31,870 --> 00:06:33,700
.لقد أنقذتماني حقًا

130
00:06:34,990 --> 00:06:37,700
،بعد أن تركتُ الميتم وأتيتُ إلى يوكوهاما

131
00:06:37,700 --> 00:06:40,170
.لم أجد زادًا ولا مكانًا آوي إليه

132
00:06:40,170 --> 00:06:41,880
.خلتُ أنّي سأموت جوعًا

133
00:06:41,880 --> 00:06:44,590
إذًا فقد غادرت المؤسّسة؟

134
00:06:44,880 --> 00:06:46,340
...يمكنك القول

135
00:06:46,840 --> 00:06:48,470
.أنّني طُردت

136
00:06:48,800 --> 00:06:51,340
.هذا أمرٌ عديم الرّحمة

137
00:06:51,340 --> 00:06:52,470
!دازاي

138
00:06:52,470 --> 00:06:56,100
.لسنا مُحسنين نساعد بعض الأشقياء الّذين يواجهون حظًا بائسًا

139
00:06:56,350 --> 00:06:57,930
.فلنعد إلى عملنا

140
00:06:56,600 --> 00:06:57,930
المثل العليا

141
00:06:57,930 --> 00:07:02,190
.تذكّرت، قلت سابقًا أن عملكما يتعلّق بالقوّات المسلّحة

142
00:07:02,350 --> 00:07:03,520
ما هي طبيعة عملكما بالتّحديد؟

143
00:07:03,900 --> 00:07:06,730
.نحن مجرّد متحرّيين

144
00:07:07,280 --> 00:07:08,610
متحرّيان؟

145
00:07:08,860 --> 00:07:12,450
هذا لا يعني أنّنا نتعامل مع قضايا
.الحيوانات الضّالة والخيانات الزّوجيّة المزعومة

146
00:07:12,450 --> 00:07:17,660
أسبق وسمعت عن وكالة التّحرّي المسلّحة
المشكّلة من أفرادٍ ذوي قدراتٍ خارقة؟

147
00:07:17,660 --> 00:07:18,290
ماذا؟

148
00:07:20,960 --> 00:07:25,590
...أتذكّر أنّي سمعتُ شائعاتٍ حول وكالة التّحرّي المسلّحة هذه

149
00:07:26,130 --> 00:07:31,840
قيل أنّها متخصّصةٌ في القضايا الّتي
.يصعب على الشّرطة والجيش التّعامل معها

150
00:07:31,840 --> 00:07:38,310
...مجموعةٌ مسلّحةٌ تتواجد في الشّفق بين عالم النّور والظّلام

151
00:07:40,390 --> 00:07:45,900
...سمعتُ كثيرًا عن الوكالة المسلّحة الّتي يمتلك أفرادها قدراتٍ خارقة

152
00:07:46,400 --> 00:07:48,690
لكن أينطبق ذلك على هذين أيضًا؟

153
00:07:51,990 --> 00:07:54,490
.انظر إلى تلك الدّعامة الرّائعة

154
00:07:55,910 --> 00:07:58,950
.لا تفكّر ما إن كان بإمكانك شنق نفسك في كلّ مطعمٍ ندخله

155
00:07:58,950 --> 00:08:00,000
.لا تسئ فهمي

156
00:08:00,000 --> 00:08:01,620
.إنّي أتحدّث عن الطّريقة الصّحيّة للشّنق

157
00:08:01,620 --> 00:08:03,170
وما معنى هذا؟

158
00:08:03,170 --> 00:08:05,500
!ماذا؟ ألا تدري؟

159
00:08:05,500 --> 00:08:07,500
!إنّها مفيدةٌ جدًا لتشنّجات الكتف

160
00:08:07,500 --> 00:08:08,050
!ماذا؟

161
00:08:08,050 --> 00:08:09,460
!أيوجد هكذا شيء؟

162
00:08:09,460 --> 00:08:12,010
!هيّا دوّن ذلك. أسرع

163
00:08:12,420 --> 00:08:16,760
...طرق... الشّنق... الصّحيّة

164
00:08:16,760 --> 00:08:17,470
.أنا أمزح فقط

165
00:08:18,560 --> 00:08:22,060
أ-أحقًا هذان الاثنان ضمن وكالة التّحرّي المسلّحة؟

166
00:08:22,060 --> 00:08:23,690
،زميلي ينجرف مع النّهر

167
00:08:23,690 --> 00:08:26,270
.وشقيّ على شفا الموت يملأ بطنه على حسابي بلا استحياء

168
00:08:26,270 --> 00:08:29,110
،والآن جدول أعمالي المثاليّ ذهب أدراج الرّياح

169
00:08:29,110 --> 00:08:33,820
!يجب أن أبدأ من الصّفر، وسأحرص على أن يُنجز العمل في الموعد المحدّد

170
00:08:31,070 --> 00:08:33,610
...إذًا، بشأن عملكما اليوم

171
00:08:33,820 --> 00:08:34,490
!ماذا؟

172
00:08:34,950 --> 00:08:37,120
!آسف، ما كان يجب أن أسأل

173
00:08:37,120 --> 00:08:41,790
!بـ-بالطّبع، عمل المتحرّين يستلزم السّرية

174
00:08:42,450 --> 00:08:46,040
.عمل اليوم لا ينطوي على السّرية تمامًا

175
00:08:46,290 --> 00:08:49,500
.إنّنا نبحث عن نمرٍ معيّن بطلبٍ من القوّات المسلّحة

176
00:08:50,500 --> 00:08:51,510
نمر؟

177
00:08:51,670 --> 00:08:55,130
.النّمر آكلُ البشر الّذي ظهر مؤخرًا في هذه الأنحاء

178
00:08:55,130 --> 00:08:57,430
،لسنا متأكّدان من أنّه التهم شخصًا ما

179
00:08:57,430 --> 00:09:01,930
.لكنّه خرّب مستودعاتٍ وحقولًا زراعيّة، ويفعل ما يحلو له

180
00:09:02,480 --> 00:09:05,890
.لقد تمّ رصده في الجوار مؤخّرًا

181
00:09:07,980 --> 00:09:09,690
ما الخطب يا أتسوشي-كُن؟

182
00:09:09,690 --> 00:09:12,610
.سـ-سـ-سأنصرف الآن

183
00:09:12,610 --> 00:09:13,740
.و-وداعًا

184
00:09:13,940 --> 00:09:15,360
!انتظر أيّها الشّقيّ

185
00:09:16,780 --> 00:09:19,580
أتعلم شيئًا ما عن ذلك؟

186
00:09:22,870 --> 00:09:24,000
.محال

187
00:09:24,000 --> 00:09:26,370
!لا يمكن لأحدٍ مواجهته

188
00:09:26,370 --> 00:09:29,000
أهناك ما تعرفه عن النّمر آكل البشر؟

189
00:09:29,540 --> 00:09:31,460
.إنّه يسعى خلفي

190
00:09:31,460 --> 00:09:33,260
!وكاد أن يسلب حياتي

191
00:09:33,260 --> 00:09:34,760
،إن تمّ رصده بالجوار

192
00:09:34,760 --> 00:09:35,970
!فعليّ الهرب في الحال

193
00:09:40,180 --> 00:09:40,890
!أيّها الشّقيّ

194
00:09:41,310 --> 00:09:44,060
.إمّا أن تدفع ذراعك ثمنًا للتشازوكي أو أن تخبرنا بكلّ ما تعرفه

195
00:09:44,390 --> 00:09:46,390
.تمهّل يا كونيكيدا-كُن

196
00:09:46,810 --> 00:09:50,110
.في كلّ مرّة تطرح فيها الأسئلة، يتحوّل الأمر إلى استجواب

197
00:09:50,480 --> 00:09:52,860
ألم يخبرك الرّئيس مرارًا بأن تكفّ عن ذلك؟

198
00:09:54,480 --> 00:09:55,570
...إذًا

199
00:09:56,190 --> 00:09:58,610
ما الّذي تعرفه عن ذلك النّمر؟

200
00:10:00,450 --> 00:10:04,200
.لقد قام بتدمير ميتمي

201
00:10:04,790 --> 00:10:06,290
.أتلف حقولنا

202
00:10:06,750 --> 00:10:08,250
،وخرّب قنّ الدّجاج

203
00:10:08,540 --> 00:10:10,040
...وحتّى مستودعنا

204
00:10:10,460 --> 00:10:12,460
،لم يكن هناك أيّ ضحايا

205
00:10:15,010 --> 00:10:17,970
.لكنّ ميتمنا كان ذا ميزانية محدودة بالفعل

206
00:10:18,260 --> 00:10:20,430
.وتمّ طردي لإنقاص عدد الأفواه اللّازم إطعامها

207
00:10:20,430 --> 00:10:21,930
!انقلع يا عديم الفائدة

208
00:10:21,930 --> 00:10:25,390
!سيكون العالم أفضل حالًا إن متّ في حفرةٍ ما

209
00:10:25,640 --> 00:10:27,890
...لِم أنا؟ لم أقترف شيئًا

210
00:10:27,890 --> 00:10:30,520
!لسنا بحاجةٍ لعديمي النّفع أمثالك هنا

211
00:10:30,520 --> 00:10:34,400
!لا، بل لا مكان لك في هذا العالم بأسره

212
00:10:34,820 --> 00:10:36,150
!اذهب حيثما تريد

213
00:10:36,150 --> 00:10:37,530
!انقلع من هنا فحسب

214
00:10:39,610 --> 00:10:42,280
.حسنٌ، هذا مأساويّ حقًا

215
00:10:42,780 --> 00:10:45,870
إذًا أيّها الشّقيّ، ما قصدك بقولك أنّ النّمر كاد يسلب حياتك؟

216
00:10:46,160 --> 00:10:47,500
...ذلك النّمر آكل البشر

217
00:10:47,830 --> 00:10:52,420
.يظهر أينما حللت كما لو أنّه يلاحقني

218
00:10:53,380 --> 00:10:56,510
...ومؤخرًا فقط، عندما كنت أتجوّل حول نهر تسورومي

219
00:11:11,020 --> 00:11:12,020
!إنّه نمر

220
00:11:12,020 --> 00:11:13,190
!هناك نمر

221
00:11:15,570 --> 00:11:18,320
،منذ أن تمّ طردي من الميتم قبل أسبوعين

222
00:11:18,320 --> 00:11:20,650
.لمحته في العديد من المرّات

223
00:11:20,650 --> 00:11:23,620
.واثقٌ أنّه جاء إلى هذه المدينة بحثًا عنّي

224
00:11:23,870 --> 00:11:26,790
متى كانت آخر مرّة رأيت فيها ذلك النّمر؟

225
00:11:28,750 --> 00:11:32,540
.أظنّني رأيته بالقرب من نهر تسورومي قبل أربعة أيام

226
00:11:32,870 --> 00:11:37,090
.بالفعل، أعماله التّخريبيّة تركّزت في هذه المنطقة قبل أسبوعين

227
00:11:37,090 --> 00:11:41,590
.بالإضافة إلى أنّه شوهد بالقرب من نهر تسورومي قبل أربعة أيام

228
00:11:44,180 --> 00:11:46,260
هل أنت متفرّغٌ الآن يا أتسوشي-كُن؟

229
00:11:47,680 --> 00:11:50,560
...ينتابني شعورٌ سيّئ حيال هذا

230
00:11:50,930 --> 00:11:54,480
.كونك هدفًا للنّمر آكل البشر يُشكّل فرصةً ممتازة

231
00:11:54,480 --> 00:11:55,230
ماذا؟

232
00:11:55,650 --> 00:11:57,440
.ساعدنا في العثور عليه

233
00:11:57,440 --> 00:11:58,740
!مستحيل

234
00:11:59,030 --> 00:12:01,650
.عُد إلى الوكالة يا كونيكيدا-كُن وسلّم هذه الملاحظة للرّئيس رجاءً

235
00:12:01,650 --> 00:12:04,030
مهلًا، أتنوي القبض عليه وحدك مع هذا الفتى؟

236
00:12:04,030 --> 00:12:06,160
.علينا أن نتأكّد أوّلًا من صحّة تلك المعلومات

237
00:12:06,830 --> 00:12:07,620
.لا تقلق

238
00:12:10,160 --> 00:12:12,410
!أنا لن أفعل ذلك

239
00:12:12,410 --> 00:12:15,040
أنت تطلب منّي أنّ أكون طعمًا، صحيح؟

240
00:12:15,040 --> 00:12:15,880
—أي عاقلٍ هذا الّذي قد يوافق

241
