1
00:00:04,480 --> 00:00:09,940
اجتماعات غرفة
،المسلّحة التّحرّري وكالة
الأول التّحقيق اجتماع

2
00:00:04,480 --> 00:00:09,940
تهديد حادثة"
قنبلة
"الأزرق الرّسول

3
00:00:04,980 --> 00:00:07,820
حاليًا، لدينا منظّمة إجراميّة مجهولة

4
00:00:07,820 --> 00:00:09,940
.تهدّد بتفجير قنبلةٍ كبيرة في منطقة حضريّة كبرى

5
00:00:10,280 --> 00:00:13,660
.إضافةً إلى إطلاقهم حملةً لتشويه سمعة الوكالة

6
00:00:13,660 --> 00:00:16,780
...نحن نعلم أنّ الوكالة في وضع لا تُحسد عليه

7
00:00:16,780 --> 00:00:19,410
.أخبرنا المزيد عن القنبلة

8
00:00:19,870 --> 00:00:23,580
.هذه هي الرّسالة الّتي خلّفها الجاني

9
00:00:23,580 --> 00:00:24,290
.سأقرأها الآن

10
00:00:24,830 --> 00:00:29,380
.تحيّاتي، آمل أن تكون وكالتكم في أحسن حال"

11
00:00:29,920 --> 00:00:33,090
اعذروا وقاحتي، لكنّي زرعتُ قنبلة
في منطقةٍ معيّنة من مدينة يوكوهاما

12
00:00:33,090 --> 00:00:36,970
.قادرة على التّسبّب بدمار هائل

13
00:00:36,970 --> 00:00:40,310
،ولضمان سلامة المواطنين

14
00:00:40,310 --> 00:00:45,690
.أطلبُ منكم العثور على القنبلة وإبطالها في أسرع وقتٍ ممكن

15
00:00:45,690 --> 00:00:47,400
.أمامكم مهلة حتّى غروب الشّمس

16
00:00:47,400 --> 00:00:49,610
.أتمنّى لكم كلّ التّوفيق

17
00:00:49,610 --> 00:00:51,530
".مع احترامي، الرّسول الأزرق

18
00:00:51,990 --> 00:00:54,900
من قد يكون ذلك الرّسول الأزرق؟

19
00:00:54,900 --> 00:00:56,490
.ما زلنا نجهل ذلك

20
00:00:56,860 --> 00:01:03,910
،إذًا فكلّ هذا مخططّ له بحيث إذا انفجرت القنبلة
.فستنتشر أخبار فشل الوكالة كالنّار في الهشيم

21
00:01:03,910 --> 00:01:07,920
،يُمكن للوكالة أن تتحمّل الرّماح وقذائف المدافع

22
00:01:07,920 --> 00:01:11,000
.لكنّ هذا النّوع من الهجمات سيضرّ بنا كثيرًا

23
00:01:11,420 --> 00:01:15,340
،منذ البارحة وموظّفو المكتب يبحثون عن مواقع محتملة

24
00:01:15,340 --> 00:01:17,220
.لكن هنالك احتمالات لا تحصى

25
00:01:17,220 --> 00:01:18,260
.عفوًا

26
00:01:18,640 --> 00:01:21,720
أما زلنا غير قادرين على الاتّصال برانبو-سان؟

27
00:01:21,720 --> 00:01:24,350
.يبدو أنّ أحداث قضيّة كيوشو قد تطوّرت

28
00:01:24,350 --> 00:01:28,690
...طلبتُ منه أن يتّصل بنا حالما يتمّ القبض على المجرم، لكن

29
00:01:28,690 --> 00:01:31,020
هل من معلوماتٍ أخرى أفاد بها سائق سيّارة الأجرة؟

30
00:01:31,440 --> 00:01:33,940
.إنّه ينكر معرفته بأيّ شيءٍ عن القنبلة

31
00:01:34,440 --> 00:01:38,240
.ولا يملك الشّجاعة لتفجير يوكوهاما بعينها

32
00:01:38,870 --> 00:01:39,990
!أنصتوا جميعًا

33
00:01:40,490 --> 00:01:45,200
هذه القضيّة تصرّفٌ جبان يستغلّ المعلومات
.للهجوم على وكالة التّحرّي المسلّحة

34
00:01:45,660 --> 00:01:47,080
:لدينا هدفان

35
00:01:47,710 --> 00:01:49,670
،الكشف عن هويّة المدبّر الملقّب بالرّسول الأزرق

36
00:01:50,130 --> 00:01:51,750
.وإبطال القنبلة

37
00:01:52,250 --> 00:01:55,340
.الأولوية للقنبلة نظرًا لطبيعتها الحسّاسة للوقت

38
00:01:55,720 --> 00:01:58,840
،إن لم نعثر على القنبلة وفُقدت أرواحٌ جرّاء ذلك

39
00:01:59,430 --> 00:02:02,010
.فلن نملك الحقّ لاعتبار أنفسنا وكالة تحرّي

40
00:02:03,260 --> 00:02:08,020
.اعتبروا هذه المهمّة كقتالٍ لأجل وجود الوكالة وفخرها

41
00:02:15,820 --> 00:02:18,610
!كم السّاعة برأيك يا ذا الأربع أعين الأحمق؟

42
00:02:18,610 --> 00:02:20,990
.أنت الوحيد الّذي ما يزال نائمًا السّاعة التّاسعة صباحًا

43
00:02:21,910 --> 00:02:25,080
أتظنّ أنّك تستطيع العثور على الرّسول
الأزرق الّذي بعث لنا تلك الرّسالة؟

44
00:02:25,540 --> 00:02:30,750
ألست تتّصل بي لأنّ لديك شيئًا آخر لتطلبه منّي؟

45
00:02:30,750 --> 00:02:32,790
.إذًا فأنت مطّلعٌ على كلّ شيء

46
00:02:32,790 --> 00:02:35,630
.أنا أعرف ما أعرفه فحسب

47
00:02:35,630 --> 00:02:38,470
.أريد منك تعقّب معدّات صنع قنبلة

48
00:02:38,470 --> 00:02:40,220
.سأرسل لك بيان الشّحن

49
00:02:40,220 --> 00:02:41,550
قنبلة؟

50
00:02:41,550 --> 00:02:43,220
.أنتم في وضعٍ لا تحسدون عليه

51
00:02:43,220 --> 00:02:45,890
.كفّ عن الثّرثرة وابدأ التّعقّب

52
00:02:45,890 --> 00:02:46,560
ماذا؟

53
00:02:47,020 --> 00:02:49,440
.هذا عملٌ لأجل إنقاذ أرواح النّاس

54
00:02:49,440 --> 00:02:52,730
،قد تكون عادةً مُنغمسًا في نشاطاتٍ ممنوعة

55
00:02:52,730 --> 00:02:54,570
.لكن عليك أن تكون مفيدًا للمجتمع من حين لآخر

56
00:02:54,570 --> 00:02:55,900
.كفاك تبجّحًا

57
00:02:56,570 --> 00:02:58,530
.أنت لستَ والدي

58
00:03:03,030 --> 00:03:04,120
...كلّا

59
00:03:04,450 --> 00:03:08,200
الحلقة السّابعة
حبّ المرض المسمّى
المُثل العليا

60
00:03:05,240 --> 00:03:07,410
.لا يمكنني أبدًا أن أكون والدك

61
00:03:09,960 --> 00:03:11,500
هل أنت واثق من هذا؟

62
00:03:11,500 --> 00:03:14,750
.تبدو الوكالة مشغولة بمسألة تهديد القنبلة

63
00:03:15,210 --> 00:03:18,010
.بدا كونيكيدا-ساما مشغولًا جدًا أيضًا

64
00:03:18,510 --> 00:03:21,340
.لأن كونيكيدا-كُن مخلصٌ جدًا لعمله

65
00:03:21,340 --> 00:03:28,060
فهو يقضي ساعتين كلّ يوم قبل النّوم
.وهو يراجع ويدقّق ملاحظاته

66
00:03:28,060 --> 00:03:30,890
—ربّما يحتوي دماغه على نملٍ عامل يعمل لصالحه

67
00:03:30,890 --> 00:03:33,560
.لم أكن أعلم أنّك هنا يا كونيكيدا-كُن

68
00:03:33,560 --> 00:03:35,610
كيف أمكنك التّغيّب عن الاجتماع خلال هذا الوضع الطارء

69
00:03:35,610 --> 00:03:38,690
للخروج في موعدٍ فاخر بعد الظّهيرة؟

70
00:03:38,690 --> 00:03:41,150
هل تشعر بالغيرة من الموعد الفاخر؟

71
00:03:41,150 --> 00:03:41,780
!لستُ كذلك

72
00:03:41,780 --> 00:03:43,070
.إنّه يشعر بالغيرة بالفعل

73
00:03:43,570 --> 00:03:46,990
.إنّها ضحيّة كادت أن تُقتل من قِبل الجاني

74
00:03:46,990 --> 00:03:50,290
ضمان سلامتها الجسديّة والنفسيّة

75
00:03:50,290 --> 00:03:54,080
هو واجبٌ مهمّ وعاجل للوكالة، أليس كذلك؟

76
00:03:54,500 --> 00:03:59,300
ولماذا يكون طفل مدلّل وكسول وعديم
المسؤوليّة مثلك أهلًا لهذه المهمّة؟

77
00:03:59,300 --> 00:04:03,630
،كما أنّه بالنّظر إلى جمالها
.فسأفترض أنّها تملك حبيبًا على الأقل

78
00:04:04,050 --> 00:04:08,010
.يبدو أنّهما قد انفصلا مؤخّرًا

79
00:04:08,010 --> 00:04:09,350
،لهذا السّبب يا كونيكيدا-كُن

80
00:04:09,970 --> 00:04:10,680
!أنت لها

81
00:04:10,680 --> 00:04:12,060
!اسمع يا دازاي

82
00:04:12,060 --> 00:04:18,270
أتيتُ إلى هنا لأنّك تغيّبت عن اجتماع
.الصّباح وعليّ أن أطلعك بما يحدث

83
00:04:18,270 --> 00:04:20,490
.أنا أعرف ما يحدث

84
00:04:21,240 --> 00:04:23,990
...هدف الرّسول الأزرق من زرع القنبلة

85
00:04:24,450 --> 00:04:26,070
.هو سحق الوكالة

86
00:04:26,070 --> 00:04:27,280
...عفوًا

87
00:04:27,870 --> 00:04:32,620
هل أنتما واثقان أنّ من الصّواب سماع دخيلةٍ مثلي لهذا؟

88
00:04:32,620 --> 00:04:33,920
...بالطّبع لا

89
00:04:33,920 --> 00:04:35,710
.ساساكي-سان لديها علاقة بهذه القضيّة

90
00:04:35,710 --> 00:04:36,960
.لذلك لا مشكلة

91
00:04:36,960 --> 00:04:37,710
ماذا؟

92
00:04:37,710 --> 00:04:41,380
...ساساكي-سان، المادّة الّتي تدرّسينها كانت

93
00:04:41,380 --> 00:04:43,010
.علم النّفس الاجتماعيّ

94
00:04:43,010 --> 00:04:44,470
.هذا رائع

95
00:04:44,470 --> 00:04:47,800
.أودّ أن أسمع رأيك في هذه القضيّة

96
00:04:48,720 --> 00:04:52,930
...حسب ما سمعته سابقًا بشأن الرّسول الأزرق

97
00:04:52,930 --> 00:04:58,650
أيمكن أن تكون له علاقة بالملك الأزرق
من حادثة العلم الأزرق الشّهيرة؟

98
00:04:58,650 --> 00:05:00,400
.إذًا هذا ما تظنّينه أيضًا

99
00:05:00,860 --> 00:05:03,950
.من المحتمل حتّى أن يكون الملك الأزرق بعينه

100
00:05:03,950 --> 00:05:07,320
قيل أنّه قد فجّر نفسه بعد أن تمّت
...محاصرته من طرف الشّرطة، لكن

101
00:05:07,740 --> 00:05:11,330
ألا يُحتمل أنّه زيّف موته وأنّه ما يزال على قيد الحياة؟

102
00:05:12,040 --> 00:05:14,210
.هذا العالم ليس كاملًا

103
00:05:14,210 --> 00:05:16,040
،مهما حزنت وتضرّعت

104
00:05:16,040 --> 00:05:20,750
،فالنّاس ما زالوا يموتون جرّاء ظروفٍ عرضيّة
.ويفلت الشّرّ بلا عقاب ويزدهر بحرّية في هذا العالم

105
00:05:21,300 --> 00:05:27,260
قال شرطيّ سابق أنّ الملك الأزرق زرع
.قنبلةً في منشأة ٍحكوميّة وأطلق تصريحًا

106
00:05:27,800 --> 00:05:31,350
تضمّنت أهدافه القتلة الّذين تمّ إسقاط
،تهمم بسبب مدّعين عامّين غير أكفاء

107
00:05:31,760 --> 00:05:34,890
إضافة إلى برلمانيّين كانوا متورّطين في
...قضايا فساد سياسيّ على مستوى عالميّ

108
00:05:34,890 --> 00:05:38,020
.جميعهم مجرمون خطيرون لا يمكن للقانون المساس بهم

109
00:05:38,520 --> 00:05:41,820
.لذلك سأسعى لعالمٍ مثاليّ

110
00:05:42,400 --> 00:05:43,730
،لن يكون مبنيًا بأيدي الإله المقدّسة

111
00:05:44,440 --> 00:05:46,820
.بل بأصابعنا الدّامية

112
00:05:49,870 --> 00:05:52,290
...لكن إن كان الملك الأزرق على قيد الحياة

113
00:05:52,660 --> 00:05:55,290
لِم قد يهاجم الوكالة هكذا؟

114
00:05:55,290 --> 00:05:56,960
.لا أملك أدنى فكرة

115
00:05:56,960 --> 00:06:02,500
حسنًا، الشّخص الّذي حاصر الملك الأزرق
.هو كونيكيدا-كُن الّذي عثر على مخبئه

116
00:06:02,500 --> 00:06:03,840
.فهمت

117
00:06:04,340 --> 00:06:06,670
.كونيكيدا-كُن هو هدفه للانتقام

118
00:06:06,670 --> 00:06:12,100
تمّ تأكيد موت ذلك الإرهابيّ من طرف
.الشّرطة العسكريّة بعد التحليل الجنائيّ

119
00:06:12,100 --> 00:06:13,350
.ولا شكّ في ذلك

120
00:06:13,350 --> 00:06:14,430
،في كلّ الأحوال

121
00:06:14,890 --> 00:06:17,850
.عليك أن تكون حذرًا إلى أن نكتشف من يكون

122
00:06:18,310 --> 00:06:20,810
.وعلينا أن نخبّئ ساساكي-سان في مكانٍ آمنٍ أيضًا

123
00:06:20,810 --> 00:06:22,440
!لن أسمح بذلك يا دازاي

124
00:06:22,440 --> 00:06:23,570
ما الّذي تعنيه؟

125
00:06:24,440 --> 00:06:28,530
أتعتقد أنّ بإمكانك الاحتفاظ بآنسة
،في غرفتك بذريعة سلامتها الشّخصيّة

126
00:06:28,530 --> 00:06:32,200
!وتقومان ليلًا ونهارًا بكلّ تلك الأمور الّتي لا يسعني التّفكير بها؟

127
00:06:30,660 --> 00:06:33,700
.لا شيء ممّا تتخيّله حدث

128
00:06:32,200 --> 00:06:33,700
!عار عليك

129
00:06:33,700 --> 00:06:34,290
ماذا؟

130
00:06:34,290 --> 00:06:38,120
،عندما تركتُها تبقى معي سابقًا نِمتُ في الغرفة المجاورة

131
00:06:38,120 --> 00:06:40,290
.ولم أضع إصبعًا عليها

132
00:06:40,920 --> 00:06:44,050
،عرفتُ أنّك ستسيء الفهم يا كونيكيدا-كُن

133
00:06:44,050 --> 00:06:46,510
.لكنّي ظننت أنّ الأمر مضحك لذلك لم أصحّح كلامك

134
00:06:46,880 --> 00:06:49,970
.أنا حقًا أتساءل لماذا هذان شريكان

135
00:06:52,930 --> 00:06:56,680
.يبدو أنّ كونيكيدا-كُن مُعجبٌ بساساكي-سان كثيرًا

136
00:06:56,680 --> 00:06:58,980
لكن أيّ نوعٍ من الرّجال تفضّلين يا ساساكي-سان؟

137
00:06:59,350 --> 00:07:00,730
نـ-نوع؟

138
00:07:01,350 --> 00:07:07,440
.سيكون من الوقاحة أن تكون لي تفضيلات بخصوص الرّجال

139
00:07:08,110 --> 00:07:14,450
لكن... أظنّ بالفعل أنّه من الرّائع أن يؤمن
.الرّجل بقوّة بالمُثل ويكرّس لها روحه وقلبه

140
00:07:15,240 --> 00:07:18,040
!وكأنّكِ تصفين كونيكيدا-كُن بكلامك

141
00:07:18,040 --> 00:07:20,870
.حسنًا، يمكنكما المواصلة بمفردكما

142
00:07:20,870 --> 00:07:21,710
!مهلًا يا دازاي

143
00:07:21,710 --> 00:07:23,670
!كـ-كفّ عن اختلاق الافتراضات

144
00:07:23,670 --> 00:07:26,500
.إنّك كتابٌ مفتوح يا كونيكيدا-كُن

145
00:07:26,500 --> 00:07:27,670
.بلا ريب

146
00:07:27,670 --> 00:07:30,630
،قد لا يكون رجلًا طبيعيًا

147
00:07:30,630 --> 00:07:34,140
.لكن كما ترين، إنّه شخصٌ بمبادئ سامية يكرّس حياته لأجل مُثله العليا

148
00:07:34,140 --> 00:07:37,770
.رغم أنّ إيجاد امرأته المثاليّة قد يشكّل تحدّيًا بسبب ذلك

149
00:07:38,140 --> 00:07:40,390
المُثل العليا

150
00:07:38,350 --> 00:07:39,480
هل تودّين إلقاء نظرة؟

151
00:07:41,100 --> 00:07:42,560
—ليس مجدّدًا أيّها الوغد! متى

152
00:07:43,900 --> 00:07:44,860
!أعيديه

153
00:07:46,900 --> 00:07:48,070
...كونيكيدا-ساما

154
00:07:48,070 --> 00:07:48,690
نعم؟

155
00:07:49,610 --> 00:07:51,070
.لقد تماديتَ كثيرًا

156
00:07:51,820 --> 00:07:54,120
.لقد سُحق كونيكيدا-سان

157
00:07:59,330 --> 00:08:00,710
هارونو كيراكو  :من

158
00:07:59,330 --> 00:08:00,710
أخبار من رانبو  :الموضوع

159
00:07:59,330 --> 00:08:00,710
،أتسوشي-كُن
!وصلنا ردّ من رانبو-سان
.لقد حلّ قضيّته لذلك لديه الوقت لمساعدتنا
.هارونو كيراكو

160
00:08:00,710 --> 00:08:02,960
.وصلتنا أخيرًا أخبارٌ من رانبو-سان

161
00:08:04,960 --> 00:08:07,960
الحلقة السّابعة

162
00:08:04,960 --> 00:08:07,960
كلاب الأدب الشاردة

163
00:08:14,970 --> 00:08:16,890
إذًا فنحن نعرف مكان القنبلة، أليس كذلك؟

164
00:08:16,970 --> 00:08:24,650
إيدوغاوا رانبو

165
00:08:17,510 --> 00:08:22,810
كنتُ آمل أن أقوم بجولةٍ سياحيّة في كيوشو
.وأتناول بيضًا في ينبوع ساخن بما أنّي حللتُ القضيّة

166
00:08:23,440 --> 00:08:24,650
.خيّبتم أملي جميعًا

167
00:08:25,230 --> 00:08:28,480
.لا يمكنكم إجراء تحقيقٍ واحد بنجاح من دوني

168
00:08:28,480 --> 00:08:30,400
.لدينا مهلةٌ حتّى غروب الشّمس فقط

169
00:08:31,990 --> 00:08:33,400
متجر؟

170
00:08:33,400 --> 00:08:34,240
مدرسة؟

171
00:08:34,240 --> 00:08:35,450
أم محطّة قطار؟

172
00:08:36,030 --> 00:08:38,780
.قد ينجم عن أيّ من هذه المواقع المئات من الضّحايا

173
00:08:38,780 --> 00:08:40,790
أين زرعها؟

174
00:08:41,200 --> 00:08:42,000
.متجر معدّات صيد الأسماك

175
00:08:42,000 --> 00:08:42,910
ماذا؟

176
00:08:43,410 --> 00:08:46,040
القنبلة في متجر معدّات صيد الأسماك في نيغيشي

177
00:08:46,580 --> 00:08:48,540
.هكذا إذًا

178
00:08:49,170 --> 00:08:50,880
.أنت مدهش يا رانبو-سان

179
00:08:51,630 --> 00:08:54,510
لكن لماذا متجر معدّات صيد الأسماك؟

180
00:08:54,510 --> 00:08:55,760
هل لدينا خريطة؟

181
00:08:55,760 --> 00:08:57,140
.خلف المقعد

182
00:08:57,640 --> 00:08:59,260
.الصّفحة 97

183
00:08:59,260 --> 00:09:02,180
...الصّفحة 97، حسنٌ

184
00:09:03,810 --> 00:09:06,730
.هدف الإرهابيّ هو مجمّع البتروكيماويات

185
00:09:06,730 --> 00:09:07,690
.فهمت

186
00:09:07,690 --> 00:09:09,520
.لماذا لم أدرك هذا

187
00:09:09,520 --> 00:09:12,860
.يوكوهاما هي واحدةٌ من أكبر المدن السّاحليّة في اليابان

188
00:09:13,360 --> 00:09:17,620
.وهنالك العديد من المنشآت الّتي تخزّن الوقود والغاز هنا

189
00:09:17,620 --> 00:09:22,790
...إن حدث انفجار على مقربة بما يكفي لإشعال حاويات التّخزين

190
00:09:23,500 --> 00:09:26,830
.سيغرق الميناء بأكمله في ألسنةٍ من اللّهب

191
00:09:27,830 --> 00:09:34,260
ولكن بالطّبع التّسلّل إلى مثل هذه المنشآت
.سيتطلّب تخطّي أنظمة أمان قويّة

192
00:09:34,260 --> 00:09:40,890
الطّريقة الأسهل ستكون بوضع القنبلة في سيّارة
.وتركها على مقربةٍ من إحدى تلك المنشآت

193
00:09:40,890 --> 00:09:44,100
باختصار، بالنّظر إلى مدى الانفجار
...لقنبةٍ يمكن وضعها في سيّارة

194
00:09:44,520 --> 00:09:48,770
فمستودع معدّات صيد الأسماك ذاك
.هو المكان الوحيد الّذي تنطبق عليه كلّ الشّروط

195
00:09:50,270 --> 00:09:51,320
.أصبت

196
00:10:02,740 --> 00:10:06,250
،عثرت فرقة تفكيك القنابل التّابعة للشّرطة العسكريّة على القنبلة

197
00:10:06,250 --> 00:10:08,580
.لكن لا يمكن تحريك القنبلة بسبب جهاز التّوقيت

198
00:10:08,580 --> 00:10:11,340
.يقولون أنّه سيكون من الصّعب تفكيكها قبل غروب الشّمس

199
00:10:12,500 --> 00:10:16,420
،وهم يقومون بإخلاء المقيمين في المنطقة المحيطة
.لكنّهم ليسوا واثقين إن كان الوقت كافيًا

200
00:10:16,420 --> 00:10:17,590
...لا يعقل

201
00:10:17,590 --> 00:10:22,810
ومع ذلك، بالإمكان إبطال القنبلة
.إن أمكننا إرسال إشارة إبطال

202
00:10:23,260 --> 00:10:24,680
.علينا القيام بشيءٍ ما

203
00:10:28,310 --> 00:10:29,650
!ما-ما الّذي يجري؟

204
00:10:30,150 --> 00:10:30,770
.مكالمة هاتفيّة

205
00:10:30,770 --> 00:10:31,610
ماذا؟

206
00:10:31,610 --> 00:10:32,480
مرحبًا؟

207
00:10:32,480 --> 00:10:34,480
مرحبًا يا ذا الأربع أعين، أهذا وقت مناسب؟

208
00:10:34,480 --> 00:10:35,480
روكوزو؟

209
00:10:35,480 --> 00:10:36,070
...عفوًا

210
00:10:36,070 --> 00:10:36,610
ما الخطب؟

211
00:10:36,610 --> 00:10:39,610
...أظنّ أنّنا نعرقل حركة السّير

212
00:10:41,620 --> 00:10:42,200
مرحبًا؟

213
00:10:42,200 --> 00:10:43,660
.مرحبًا يا أتسوشي-كُن

214
00:10:43,660 --> 00:10:44,660
رانبو-سان؟

215
00:10:45,290 --> 00:10:45,580
.نعم

216
00:10:45,580 --> 00:10:46,160
مرحبًا؟

217
00:10:46,160 --> 00:10:47,040
دازاي؟

218
00:10:47,040 --> 00:10:48,000
الرّئيس؟

219
00:10:48,000 --> 00:10:48,960
.أجل

220
00:10:48,960 --> 00:10:50,880
الشّرطة العسكريّة؟

221
00:10:50,880 --> 00:10:52,080
.فهمت

222
00:10:52,080 --> 00:10:53,670
.إمساك لصّ يتطلّب لصًا آخر

223
00:10:53,670 --> 00:10:54,920
.هكذا إذن

224
00:10:54,920 --> 00:10:56,510
...هذه معضلة

225
00:10:56,510 --> 00:10:57,010
.حسنًا

226
00:10:57,010 --> 00:10:57,460
.فهمت

227
00:10:57,460 --> 00:10:57,880
.حاضر

228
00:10:57,880 --> 00:10:58,510
.نعم

229
00:10:58,510 --> 00:10:59,760
.لا، هذا سيساعدنا

230
00:10:59,760 --> 00:11:01,140
.مفهوم

231
00:11:01,140 --> 00:11:02,510
!فهمت أيّها الرّئيس

232
00:11:04,850 --> 00:11:06,520
.تلقّيتُ مكالمةً من روكوزو

233
00:11:06,520 --> 00:11:11,480
طلب أحدهم مؤخّرًا جهاز إرسال
.ومعدّات أخرى إلى منشأة قوّات دفاع سابقة

234
00:11:11,940 --> 00:11:13,520
.وصل رانبو-سان إلى نفس النّتيجة

235
00:11:13,940 --> 00:11:15,020
.تأكّد الأمر إذًا

236
00:11:15,020 --> 00:11:17,480
.وقد وردتني مكالمةٌ من الرّئيس

237
00:11:17,480 --> 00:11:20,650
.أعلمته الشّرطة العسكريّة أنّ السّائق قد مات

238
00:11:20,650 --> 00:11:21,490
مات؟

239
00:11:21,490 --> 00:11:25,990
لكن ألم يكن في زنزانة العزل عند
الشّرطة العسكريّة بغرض حمايته؟

240
00:11:26,450 --> 00:11:29,330
.مات في زنزانته بعد أن انهار فجأة من شدّة الألم

241
00:11:29,790 --> 00:11:35,670
سبب الوفاة مجهول، لكن كان
.الرّقمان "00" مكتوبان على راحة يده

242
00:11:35,670 --> 00:11:37,630
أرقام على راحة يده؟

243
00:11:38,130 --> 00:11:39,050
لماذا؟

244
00:11:39,470 --> 00:11:41,180
ما الّذي يحصل؟

245
00:11:46,060 --> 00:11:49,310
منشأة قوات
دفاع سابقة
______
عشرون دقيقة
.قبل الانفجار

246
00:11:52,190 --> 00:11:53,060
!كونيكيدا-كُن

247
00:11:57,820 --> 00:11:59,400
!شعر دوبو

248
00:11:59,400 --> 00:12:00,320
!انفجار ضوئيّ

249
00:12:04,110 --> 00:12:05,910
!لا شكّ أن هذا هو المكان الصّحيح

250
00:12:05,910 --> 00:12:07,120
!اذهبا أنتما إلى الأعلى

251
00:12:07,490 --> 00:12:10,080
!اعثرا على جهاز الإرسال وأرسلا إشارة الإبطال

252
00:12:16,790 --> 00:12:17,710
ماذا؟

253
00:12:20,460 --> 00:12:22,840
.أعطني رقمك

254
00:12:24,890 --> 00:12:25,890
كيف حالك؟

255
00:12:26,390 --> 00:12:28,310
.تبدو في صحّة جيّدة

256
00:12:28,310 --> 00:12:31,350
.أنا واثق أنّ لديك رقمًا ممتازًا

257
00:12:34,230 --> 00:12:35,560
...هذا

258
00:12:36,020 --> 00:12:39,150
.لقد عثرتم على هذا المكان كما هو متوقّع منكم

259
00:12:39,150 --> 00:12:41,530
.وكالة التّحقيق المسلّحة مثيرة للإعجاب

260
00:12:41,530 --> 00:12:43,820
.مثيرة جدًا للإعجاب

261
00:12:46,780 --> 00:12:48,330
...الشّمس تغرب

262
00:12:49,790 --> 00:12:51,250
هل تعرف طريقة إبطالها؟

263
00:12:51,250 --> 00:12:52,160
!إنّها سهلة

264
00:12:52,620 --> 00:12:54,120
.لكنّي لا أستطيع فعلها

265
00:12:54,120 --> 00:12:54,710
ماذا؟

266
00:12:54,710 --> 00:12:58,170
،يجب إدخال مفتاح التّحرير هنا وإدارته

267
00:12:58,750 --> 00:13:00,550
.لكنّه ليس بحوزتي

268
00:13:00,550 --> 00:13:02,050
!ما العمل إذًا؟

269
00:13:02,050 --> 00:13:03,510
ما الّذي تفعلانه هنا؟

270
00:13:05,220 --> 00:13:07,680
!لدينا شخصٌ من الوزن الثّقيل هنا

271
00:13:12,430 --> 00:13:15,390
!هل تمكّنه قدرته من القيام بهجماتٍ عن بعد؟

272
00:13:15,390 --> 00:13:18,020
ما هو رقمك الآن؟

273
00:13:18,020 --> 00:13:19,400
رقم؟

274
00:13:22,230 --> 00:13:25,820
.لا يمكن التّهرّب من قدرتي كما ترى

275
00:13:26,410 --> 00:13:30,410
.بإمكاني إرسال الأشخاص الّذين
.وضعت عليم الأرقام إلى أيّ اتّجاه أشاء

276
00:13:30,410 --> 00:13:33,200
.حتّى لو كانوا على الجانب الآخر من الأرض

277
00:13:33,200 --> 00:13:36,170
،وبمجرّد أن تصل الأرقام إلى الصّفر

278
00:13:36,170 --> 00:13:38,630
.سيموتون جرّاء الألم

279
00:13:38,630 --> 00:13:41,550
.لا أحد يستطيع الإفلات من ذلك المصير

280
00:13:41,550 --> 00:13:43,010
...لا أحد

281
00:13:43,010 --> 00:13:44,210
...أيًا كان

282
00:13:44,210 --> 00:13:45,130
.مهمًا كان

283
00:13:46,800 --> 00:13:48,930
هل أنت هو الزّعيم؟

284
00:13:48,930 --> 00:13:51,600
.أنتم بالفعل تشكّلون عائقًا أكبر من المافيا

285
00:13:51,600 --> 00:13:54,640
.لكنّ أوان وكالة التّحرّي المسلّحة انتهى الآن

286
00:13:55,560 --> 00:13:57,060
.ها هو المفتاح

287
00:13:57,060 --> 00:13:59,560
.إنّه مفتاح التّحرير لإبطال القنبلة

288
00:13:59,560 --> 00:14:02,480
.بدونه، لا يمكنكم إيقاف القنبلة

289
00:14:02,480 --> 00:14:03,530
أتريده؟

290
00:14:04,030 --> 00:14:05,860
.بالطّبع تريده

291
00:14:05,860 --> 00:14:08,740
.إن كنت تريده... فها هو

292
00:14:10,410 --> 00:14:11,950
.وهكذا يتلاشى أملكم

293
00:14:12,660 --> 00:14:14,240
.انتهى الأمر

294
00:14:14,240 --> 00:14:15,410
انتهى الأمر، صحيح؟

295
00:14:15,410 --> 00:14:17,120
!أيّها الغبيّ

296
00:14:23,130 --> 00:14:24,550
!أتسوشي-كُن

297
00:14:28,050 --> 00:14:30,720
.أنت تملك ذراعين قويّتين بالفعل

298
00:14:31,260 --> 00:14:33,680
.كان عليك أن تعمل كحمّال

299
00:14:46,650 --> 00:14:47,610
!كونيكيدا-كُن

300
00:14:47,610 --> 00:14:49,320
!أعلم

301
00:14:47,860 --> 00:14:48,570
مسدّس
السّلك

302
00:14:54,330 --> 00:14:56,200
!لن تنفعك نفس الحيلة

303
00:14:57,410 --> 00:14:58,750
!دازاي

304
00:14:58,750 --> 00:14:59,790
!قادم

305
00:15:05,090 --> 00:15:07,840
هل ستكون الشّخص التّالي الّذي سيعطيني رقمًا؟

306
00:15:10,970 --> 00:15:12,140
!مستحيل

307
00:15:12,140 --> 00:15:13,850
لماذا لا يتواجد رقمٌ عليك؟

308
00:15:14,220 --> 00:15:17,390
.للأسف، لن يكون لقدرتك أيّ تأثيرٍ بعد الآن

309
00:15:17,930 --> 00:15:21,850
!كما أنّ عليك أن تجعل شريكك يغيّر عمله ويصبح حمّالًا

310
00:15:26,690 --> 00:15:29,070
.لا يبدو أنّ الفارق في الوزن يزعجه على الإطلاق

311
00:15:30,650 --> 00:15:32,030
.دازاي-سان

312
00:15:32,780 --> 00:15:34,660
...شراكتهما مدهشة

313
00:15:35,660 --> 00:15:36,740
!تذكّرت

314
00:15:36,740 --> 00:15:38,330
أين المفتاح يا كونيكيدا-سان؟

315
00:15:38,750 --> 00:15:40,040
.لقد كسره

316
00:15:40,040 --> 00:15:40,580
!ماذا؟

317
00:15:40,580 --> 00:15:42,830
وما العمل بشأن القنبلة؟

318
00:15:42,830 --> 00:15:43,580
—الوقت يداهمنا

319
00:15:43,580 --> 00:15:44,500
!اهدأ أيّها الشّقيّ

320
00:15:45,420 --> 00:15:47,170
.شعر دوبو

321
00:15:46,800 --> 00:15:47,170
الإبطال مفتاح

322
00:15:47,170 --> 00:15:48,090
مفتاح الإبطال

323
00:15:47,170 --> 00:15:48,090
.مفتاح الإبطال

324
00:15:50,550 --> 00:15:53,590
تمكّنني قدرتي من إعادة إنشاء أيّ شيءٍ سبق ورأيتُه

325
00:15:54,010 --> 00:15:56,890
.وعرفت شكله ووظيفته

326
00:16:06,690 --> 00:16:10,780
.ولكنّ حجم الشّيء محدودٌ بحجم مذكّرة الجيب

327
00:16:07,690 --> 00:16:10,780
المُثل العليا

328
00:16:11,240 --> 00:16:16,620
.إذًا فمذكّرتك هي بالفعل أداة تجعل مُثلك واقعًا

329
00:16:25,580 --> 00:16:28,550
هل أنت هنا لزيارة قبور من فقدوا أرواحهم؟

330
00:16:29,630 --> 00:16:30,420
.أجل

331
00:16:32,930 --> 00:16:35,550
،عندما تسبّبتُ في وقوع ضحايا أثناء عملي لأوّل مرّة

332
00:16:35,550 --> 00:16:38,930
،بكيت كثيرًا لدرجة أنّي لم أقوى على الوقوف
.وأخذتُ إجازة من العمل دون تصريح

333
00:16:39,390 --> 00:16:41,270
.لكنّي الآن لم أذرف دمعةً واحدة

334
00:16:41,890 --> 00:16:46,900
.أختار أن أزور قبورهم في المقابل أو هذا ما أظنّه

335
00:16:48,480 --> 00:16:52,400
هل ستفيد دموعنا الأموات بشيء؟

336
00:16:52,400 --> 00:16:55,490
.أشكّ أنّ الدّموع ستشعرهم بالرّاحة أو بأيّ تعويض

337
00:16:55,490 --> 00:16:59,330
.فقد توقّفت حياتهم لحظة مماتهم

338
00:17:00,580 --> 00:17:04,620
.أعترف أنّي كذبتُ سابقًا

339
00:17:05,210 --> 00:17:08,250
.الموت هو ما فصلني عن حبيبي

340
00:17:08,960 --> 00:17:09,630
.فهمت

341
00:17:10,210 --> 00:17:11,800
.كلامك صحيح

342
00:17:12,380 --> 00:17:15,090
.لم يعد للوقت معنى بالنّسبة للموتى

343
00:17:15,550 --> 00:17:17,390
،لا يهمّ ما قد أفعله من أجله

344
00:17:17,390 --> 00:17:18,970
،فلن يبتهج به

345
00:17:18,970 --> 00:17:20,430
.أو يبتسم بسببه

346
00:17:24,140 --> 00:17:25,980
.فقدتُ رباطة جأشي عن غير قصد

347
00:17:26,770 --> 00:17:28,440
.لديّ موعدٌ يجب أن أحضره

348
00:17:28,980 --> 00:17:29,520
.بالإذن

349
00:17:32,610 --> 00:17:33,490
.وداعًا

350
00:17:38,740 --> 00:17:39,660
.مرحبًا

351
00:17:40,660 --> 00:17:41,700
كونيكيدا-كُن؟

352
00:17:41,700 --> 00:17:43,700
.أحتاجك لأمرٍ ما

353
00:17:44,960 --> 00:17:47,040
لِم هذا المكان بالذّات؟

354
00:17:47,040 --> 00:17:48,960
ما هذا برأيك؟

355
00:17:49,460 --> 00:17:53,710
.إنّها دراسةٌ ليوكوهاما وجدناها في حاسوبٍ داخل مخبئهم

356
00:17:53,710 --> 00:17:57,090
جاء فيها أنّه ولبسط السّيطرة على يوكوهاما

357
00:17:57,090 --> 00:18:00,300
.فالقضاء على الوكالة له الأولويّة

358
00:18:00,300 --> 00:18:03,560
أوليست مافيا الميناء من تسيطر على عالم الجريمة؟

359
00:18:03,560 --> 00:18:07,850
.كان يتمّ التّلاعب بهم عن طريق معلوماتٍ مزيّفة

360
00:18:07,850 --> 00:18:09,610
إذًا هنالك عقل مدبّر آخر؟

361
00:18:09,610 --> 00:18:14,030
في الواقع، لقد بعثتُ رسالةً
.للشّخص الّذي أعتقد أنّه وراء كلّ هذا

362
00:18:14,780 --> 00:18:17,110
أخبرتك أنّي أملك دليلًا يثبت أنّ ذلك
.الشّخص هو المسؤول الحقيقيّ

363
00:18:17,950 --> 00:18:20,120
.وذلك الشّخص سيصل إلى هنا في أيّ لحظة

364
00:18:30,250 --> 00:18:31,380
!لا يعقل أن يكون أنت

365
00:18:32,250 --> 00:18:34,050
!أأنت هو ذلك الشّخص يا روكوزو؟

366
00:18:34,050 --> 00:18:36,050
عمّ تتحدّث؟

367
00:18:36,050 --> 00:18:37,880
ألم يبدأ الأمر بعد؟

368
00:18:38,300 --> 00:18:39,090
.فهمت

369
00:18:39,640 --> 00:18:42,800
لقد اخترقت بريدي واختلست النّظر إلى رسائلي، صحيح؟

370
00:18:42,800 --> 00:18:44,470
!أحقًا ليس أنت؟

371
00:18:44,470 --> 00:18:47,980
.أردتُ فقط رؤية الشّخص المسؤول عن هذا

372
00:18:47,980 --> 00:18:50,480
—أقسم، أحقًا أنت لست

373
00:18:49,900 --> 00:18:50,980
!احذر يا ذا الأربع أعين

374
00:18:57,860 --> 00:19:00,200
.إذًا فأتِ هي الرّسول الأزرق

375
00:19:00,700 --> 00:19:02,070
.يا ساساكي نوبوكو-سان

376
00:19:02,570 --> 00:19:03,910
...لا يُعقل

377
00:19:03,910 --> 00:19:09,250
أشكّ أنّ هذه هي المرّة الأولى الّتي
.استعملتِ فيها ذكاءكِ لارتكاب جريمة

378
00:19:09,250 --> 00:19:11,880
.كان رجلًا عاش لأجل مثله العليا

379
00:19:12,580 --> 00:19:15,300
،كانت نواياه صافية سعيًا لعالمٍ خالٍ من الجريمة

380
00:19:15,300 --> 00:19:18,220
.ولذلك السّبب لطّخ يداه بالدّماء

381
00:19:18,970 --> 00:19:22,180
.أردتُ فقط أن أحقّق رغبته وأجعل مُثله العليا واقعًا

382
00:19:22,180 --> 00:19:24,430
،حبيبك، الملك الأزرق

383
00:19:24,970 --> 00:19:30,270
كان يسعى للمثاليّة وأراد محاكمة
.المجرمين الّذين ما كان القانون ليعاقبهم

384
00:19:29,980 --> 00:19:32,060
انعكاس
معزّز

385
00:19:30,810 --> 00:19:32,900
...والغرض من هذه الحادثة هو إكمال ما بدأه

386
00:19:32,900 --> 00:19:34,440
!أخفضي سلاحك

387
00:19:34,440 --> 00:19:36,070
!ما الّذي ستجنينه من هذا؟

388
00:19:36,070 --> 00:19:38,030
ألا تفهم؟

389
00:19:39,030 --> 00:19:41,860
...أنت تشبهه بطريقةٍ ما

390
00:19:42,280 --> 00:19:44,740
.كانت خطّتكِ معقّدة جدًا

391
00:19:45,450 --> 00:19:47,700
،فبدون أن تلوّثي يديكِ

392
00:19:47,700 --> 00:19:49,410
،نصبتِ فخًا لتلفيق التّهمة للوكالة

393
00:19:49,410 --> 00:19:52,370
.ودمّرتِ الخاطف والمنظّمة الإجراميّة الّتي تقف خلفه

394
00:19:53,040 --> 00:19:56,800
.لكنّكِ لا تملكين أيّ قناعاتٍ أو مُثلًا عليا

395
00:19:56,800 --> 00:19:58,800
.أنتِ تسبحين مع التّيّار لا غير

396
00:20:01,380 --> 00:20:02,880
.أنا متعبة فحسب

397
00:20:03,470 --> 00:20:05,600
.أريد أن أتحرّر من كلّ هذا

398
00:20:07,140 --> 00:20:10,100
هل ستطلق النّار عليّ يا دازاي-سان؟

399
00:20:11,600 --> 00:20:14,310
.لكنّي أخفضت سلاحي

400
00:20:14,860 --> 00:20:17,150
،إن أطلقتَ النّار عليّ الآن

401
00:20:17,150 --> 00:20:19,030
.فسيكون ذلك استغلالًا مفرطًا للقوّة

402
00:20:19,480 --> 00:20:21,490
.كونيكيدا-سان يراقبنا

403
00:20:22,740 --> 00:20:23,700
.معكِ حقّ

404
00:20:23,700 --> 00:20:25,070
.لا أستطيع إطلاق النّار

405
00:20:26,530 --> 00:20:27,410
...ولكن

406
00:20:41,130 --> 00:20:44,010
.قتل الملك الأزرق والدي

407
00:20:44,970 --> 00:20:46,640
.اذهبي من غير رجعة

408
00:20:51,060 --> 00:20:52,310
!لماذا؟

409
00:20:52,850 --> 00:20:55,060
!لماذا يجب أن ينتهي الأمر هكذا؟

410
00:20:55,060 --> 00:20:56,980
!ما الخطأ الّذي ارتكبناه؟

411
00:20:56,980 --> 00:20:58,520
!من كان المخطئ؟

412
00:20:58,520 --> 00:20:59,690
.لم يُخطئ أحد

413
00:20:59,690 --> 00:21:01,820
.كانت هذه النّتيجة الوحيدة الممكنة

414
00:21:02,690 --> 00:21:03,280
!اخرس

415
00:21:03,820 --> 00:21:05,740
!كان بإمكانك إنقاذها

416
00:21:05,740 --> 00:21:08,240
!هل تقصد أنّ هذه هي العدالة؟

417
00:21:08,240 --> 00:21:10,200
.العدالة مجرّد سلاح

418
00:21:10,200 --> 00:21:12,830
،قد تُستمعل لإلحاق الأذى

419
00:21:12,830 --> 00:21:15,210
.لكنّها لا تستطيع حماية أو إنقاذ الآخرين

420
00:21:15,210 --> 00:21:19,420
.عدالة الملك الأزرق هي ما قتل ساساكي-سان في نهاية المطاف

421
00:21:19,420 --> 00:21:21,420
.وعدالتك أنت

422
00:21:24,380 --> 00:21:25,760
،كونيكيدا-كُن

423
00:21:26,300 --> 00:21:28,680
،ما دمت تسعى خلف مُثلك العليا

424
00:21:28,680 --> 00:21:31,970
...فإنّ ألسنة الّهب الّتي أحرقت الملك الأزرق ستتأصّل داخلك يومًا ما

425
00:21:32,560 --> 00:21:34,390
.وستبيد كلّ ما يحيط بك

426
00:21:34,390 --> 00:21:35,480
!وإن يكن

427
00:21:35,940 --> 00:21:37,980
!سأستمرّ في المضيّ قدمًا إلى أن أتخطّاها

428
00:21:38,690 --> 00:21:40,570
!لا تستخفّ بمُثلي العليا

429
00:23:11,660 --> 00:23:14,030
هل تأذّيت في مكانٍ ما يا أتسوشي؟

430
00:23:14,030 --> 00:23:15,620
.كلّا، على الإطلاق

431
00:23:15,620 --> 00:23:16,870
.أنا في أتمّ العافية

432
00:23:16,870 --> 00:23:19,040
.كم هذا مملّ

433
00:23:19,040 --> 00:23:23,540
المعذرة، في ما يخصّ قدرة "العلاج" خاصّتك أيّتها الطّبيبة يوسانو، كيف تعمل بالتّحديد؟

434
00:23:23,540 --> 00:23:24,790
أتودّ معرفة ذلك؟

435
00:23:24,790 --> 00:23:27,710
لِم لا تسأل تانيزاكي بما أنّي عالجته من قبل؟

436
00:23:27,710 --> 00:23:32,430
.لكنّ تانيزاكي-سان يرتعد من الخوف ولا يريد إخباري بشيء

437
00:23:32,790 --> 00:23:35,850
:في الحلقة القادمة من كلاب الأدب الشّاردة، الحلقة الثّامنة

438
00:23:35,850 --> 00:23:37,640
.لأجل القتل ثم الموت

439
00:23:36,640 --> 00:23:37,640
--------------------------------------------------------------

440
00:23:36,640 --> 00:23:37,640
-------------

441
00:23:36,640 --> 00:23:37,640
الحلقة الثّامنة

442
00:23:36,640 --> 00:23:37,640
الموت ثم لأجل القتل

443
00:23:37,640 --> 00:23:40,940
".القدرة: "لا يجب أن تموت