1
00:00:01,810 --> 00:00:03,690
.تمكّنا من العودة بسلام

2
00:00:02,020 --> 00:00:03,690
.بسلام  لقد عدنا

3
00:00:03,690 --> 00:00:05,400
وكالة التّحري المسلحة

4
00:00:06,480 --> 00:00:07,480
...لكن

5
00:00:09,110 --> 00:00:13,200
هل ستتغاضى الوكالة عن قتلها لـ35 شخصًا؟

6
00:00:17,450 --> 00:00:21,750
ماذا سأفعل إن كانت الوكالة على خلافٍ معها؟

7
00:00:24,790 --> 00:00:26,420
.صباح الخير

8
00:00:30,090 --> 00:00:32,170
هلّا التففتِ مرةً أخرى لأجلي؟

9
00:00:33,470 --> 00:00:35,300
!يا لظرافتها

10
00:00:35,300 --> 00:00:37,430
ما الّذي يجري؟

11
00:00:38,100 --> 00:00:42,270
.هذا لأنّها تبدو رائعةً في كلّ ما ترتديه

12
00:00:42,270 --> 00:00:44,270
.لا، ذلك ليس ما قصدته

13
00:00:44,270 --> 00:00:45,770
...كونيكيدا-سان

14
00:00:45,770 --> 00:00:47,110
.لا تنظر إليّ هكذا

15
00:00:47,110 --> 00:00:48,440
.لقد حاولت إيقافهم أيضًا

16
00:00:48,440 --> 00:00:50,440
ألا بأس بهذا؟

17
00:00:50,440 --> 00:00:51,900
.ربّما ليست فكرةً سديدة

18
00:00:52,400 --> 00:00:53,820
،حتّى لو قبل الجميع هذا

19
00:00:53,820 --> 00:00:56,530
لكن ألن ينزعج شخصٌ يلتزم بالقواعد مثل رانبو-سان؟

20
00:00:56,530 --> 00:00:59,030
.لا تقلق بشأن ذلك

21
00:00:59,030 --> 00:01:00,160
!لقد عدت

22
00:01:00,490 --> 00:01:01,700
!اشتريتُ بعضها

23
00:01:01,700 --> 00:01:03,660
.لأنّ رانبو-سان الأكثر اهتمامًا بها

24
00:01:04,080 --> 00:01:06,620
إنّها الحلوى الّتي أخبرتكِ عنها سابقًا
.والّتي تغيّر لونها عندما تخلطينها

25
00:01:07,040 --> 00:01:08,380
.اخلطيها وسترين

26
00:01:09,590 --> 00:01:13,760
أوّلًا افتحيها ثم ضعي المسحوقين
.في الوعاء وأضيفي له بعض الماء

27
00:01:12,880 --> 00:01:15,680
...إنّهما كشقيقان في الابتدائية

28
00:01:13,760 --> 00:01:16,010
!والآن، اخلطيها جيّدًا

29
00:01:16,010 --> 00:01:18,430
.من المهمّ أن تضعي بها أحاسيسكِ

30
00:01:18,430 --> 00:01:21,180
.حسنًا! اخلطي، اخلطي، اخلطي، اخلطي، اخلطي

31
00:01:21,180 --> 00:01:23,560
!والآن انظري، كم هذا عجيب

32
00:01:25,390 --> 00:01:27,190
.لكن أنا من سيأكلها

33
00:01:28,610 --> 00:01:30,060
.كم هو طفوليّ

34
00:01:28,900 --> 00:01:32,190
.أنت فضيعٌ يا رانبو-سان

35
00:01:30,060 --> 00:01:32,690
.حسنٌ، هذا من طباعه

36
00:01:32,230 --> 00:01:36,110
ألا تعلم أنّ هذا ليس رجوليًا منك؟

37
00:01:32,690 --> 00:01:36,360
لكن من دعاها إلى الوكالة؟

38
00:01:36,360 --> 00:01:37,240
.أنا

39
00:01:38,530 --> 00:01:39,660
!الرّئيس

40
00:01:41,700 --> 00:01:43,290
هل من تحرّكات من جانب الشّرطة؟

41
00:01:43,700 --> 00:01:46,120
،بفضل محاولات مافيا الميناء لمحو هوّيتها

42
00:01:46,120 --> 00:01:48,040
.هويّاتنا لم تكتشف بعد

43
00:01:48,040 --> 00:01:50,750
.لكن ما هي إلّا مسألة وقت وستصبح هاربةً مطلوبة

44
00:01:54,920 --> 00:01:56,670
.اسمح لي بالبقاء هنا رجاءً

45
00:01:56,670 --> 00:01:57,340
ماذا؟

46
00:01:58,220 --> 00:01:59,640
.سأفعل أيّ شيء

47
00:01:59,640 --> 00:02:01,010
.لا تفكّري في ذلك

48
00:02:01,680 --> 00:02:04,180
،ليس لأنّكِ كنتِ مع مافيا الميناء

49
00:02:04,180 --> 00:02:05,890
.وليس لأنّنا لا نملك عملًا لكِ

50
00:02:06,350 --> 00:02:07,770
.لِذا استسلمي فحسب

51
00:02:07,770 --> 00:02:09,480
.هذا العالم ليس رحيمًا

52
00:02:09,480 --> 00:02:11,020
،وحتّى إن بقيتِ هنا

53
00:02:11,020 --> 00:02:12,860
.فستجدك مافيا الميناء في النّهاية

54
00:02:12,860 --> 00:02:14,780
ألا يجدر بكِ أن تهربي إلى مكانٍ بعيد؟

55
00:02:15,360 --> 00:02:16,320
...لقد قال لي

56
00:02:16,940 --> 00:02:20,070
.أنّي لا أجيد شيئًا عدا القتل

57
00:02:20,870 --> 00:02:23,700
.أريد أن أثبتَ لنفسي أنّه مخطئ

58
00:02:29,580 --> 00:02:30,460
.أيّها الرّئيس

59
00:02:32,340 --> 00:02:34,090
.أترجّاك أيضًا بالنّيابة عنها

60
00:02:36,550 --> 00:02:37,840
.أرجوك

61
00:02:40,220 --> 00:02:42,010
...أرجوك

62
00:02:44,760 --> 00:02:46,970
...أرجوك

63
00:02:53,730 --> 00:02:54,480
.حسنًا

64
00:02:54,480 --> 00:02:55,480
!ماذا؟

65
00:02:56,150 --> 00:02:57,900
.سأقبل انضمامها

66
00:04:34,000 --> 00:04:36,000
.كسرٌ قلعيّ في الفكّ السّفلي

67
00:04:36,000 --> 00:04:38,290
،انقلاعٌ في العظم الجبهيّ والفقرة الصّدريّة

68
00:04:38,290 --> 00:04:40,250
،تضرّرٌ في الرّباط الوِدَاجِيّ

69
00:04:40,250 --> 00:04:42,590
،تمزّقٌ في العضلتين العضديّة والفخذيّة

70
00:04:42,590 --> 00:04:44,840
،وحروقٌ من الدّرجة الأولى في سائر الجسد

71
00:04:44,840 --> 00:04:46,300
.وحاليًا في غيبوبة

72
00:04:47,300 --> 00:04:49,680
.لقد تكبّد ضررًا جسيمًا

73
00:04:49,680 --> 00:04:52,270
.هذا ثمن فشله في المهمّة

74
00:04:52,730 --> 00:04:54,270
.أنا آسفةٌ حقًا

75
00:04:54,890 --> 00:04:57,980
.قد لا يستردّ وعيه

76
00:04:58,520 --> 00:04:59,650
...محال

77
00:04:59,650 --> 00:05:01,480
.لا تُحبطي

78
00:05:01,480 --> 00:05:03,820
.لقد بذلتما قصارى جهدكما

79
00:05:04,360 --> 00:05:10,160
صحيحٌ أنّكما فشلتما في الهجوم على الوكالة
.والقبض على الرّجل النّمر وأغرقتما السّفينة بحمولتها

80
00:05:10,160 --> 00:05:12,290
ولكنّكما بذلتما قصارى جهدكما، أليس كذلك؟

81
00:05:12,660 --> 00:05:14,500
.الجهد المبذول هو المهم

82
00:05:14,500 --> 00:05:16,330
.أمّا النّتائج فتأتي بعده

83
00:05:16,330 --> 00:05:17,500
أليس كذلك؟

84
00:05:19,210 --> 00:05:20,670
.تذكّرت

85
00:05:20,670 --> 00:05:26,510
شركة كارما للنّقل الّتي سحقها أكوتاغاوا-كُن
.أثناء المهمّة يبدو أنّهم أعادوا لمّ شملهم

86
00:05:26,510 --> 00:05:28,760
.على الأرجح أنّهم يخطّطون للانتقام من أكوتاغاوا-كُن

87
00:05:29,680 --> 00:05:31,390
.اسمعي يا هيغوتشي-كُن

88
00:05:31,810 --> 00:05:35,690
.المافيا في النّهاية هي عملٌ تجاريّ يتعامل بالعنف

89
00:05:35,690 --> 00:05:38,690
.مسموحٌ لها أن ترغب بأيّ شيء وتقتل أيّ أحد

90
00:05:39,310 --> 00:05:43,860
.لكن إن تمّ ردّ العنف علينا فكلّ نفقاتنا ستصبح خسائر

91
00:05:43,860 --> 00:05:46,150
أتقول... خسارة؟

92
00:05:46,700 --> 00:05:49,820
.لقد أنجز أكوتاغاوا-سينباي الكثير في مهامه حتّى الآن

93
00:05:49,820 --> 00:05:52,290
.بالفعل، أكوتاغاوا-كُن كفُؤ

94
00:05:52,290 --> 00:05:55,370
.ونزعته للعنف شديدةٌ جدًا حتّى بالنّسبة لمنظّمتنا

95
00:05:55,790 --> 00:05:57,290
لكن ماذا عنكِ؟

96
00:05:58,620 --> 00:05:59,960
،هيغوتشي-كُن

97
00:06:00,750 --> 00:06:05,090
هل سبق وتساءلتي ما إن كنتِ ملائمةً لهذا العمل؟

98
00:06:00,750 --> 00:06:05,510
الحلقة الحاديّة عشرة
:الجزء الأوّل
مهنةٌ لا تلائمها

99
00:06:15,310 --> 00:06:16,600
.أبدو فظيعة المظهر

100
00:06:19,150 --> 00:06:21,940
.يكفي لهوًا يا غين

101
00:06:25,440 --> 00:06:26,650
.السّحلية السّوداء

102
00:06:26,650 --> 00:06:31,530
عادةً ما يقوم هذا اللّعين غين
.بمهام التّسلّل كالاختراق والاغتيال

103
00:06:32,070 --> 00:06:35,290
.ليس غريبًا عليه أن ينحر أحدًا منّا بأمرٍ من الرّؤساء

104
00:06:35,750 --> 00:06:37,830
.وعندما يكون ذلك حقيقيًا، لن تكون لديك الفرصة للدّهشة

105
00:06:38,460 --> 00:06:41,580
أتقصد أنّ الزّعيم سيأمر باغتيالي؟

106
00:06:41,580 --> 00:06:43,340
.ليس بعد

107
00:06:43,340 --> 00:06:45,710
.لكن من يدري ما قد يحدث غدًا

108
00:06:46,130 --> 00:06:48,550
هل أنتم هنا لتسخروا منّي؟

109
00:06:48,550 --> 00:06:55,140
لو كنتُ مكانك لأعدتُ التّفكير بوضعي
.الحاليّ قبل أن يأتي قاتِلٌ لعتبة منزلي

110
00:06:55,680 --> 00:06:59,270
أنتِ وأكوتاغاوا-كُن قوّة ضاربة
.تحت الإشراف المباشر للزّعيم

111
00:06:59,270 --> 00:07:02,610
.ولهذا، فأنتِ تملكين الصّلاحية لتأمرينا نحن فريق القتال

112
00:07:02,610 --> 00:07:04,610
.ما يعني أنّكِ قائدتنا

113
00:07:04,610 --> 00:07:08,400
،لكن ما يدفعنا للانصياع ليس السّلطة

114
00:07:08,820 --> 00:07:09,820
راشومون

115
00:07:09,240 --> 00:07:12,870
.بل خشية وتقدير القدرة الّتي يحملها أكوتاغاوا-كُن

116
00:07:15,870 --> 00:07:17,330
...هيغوتشي-كُن

117
00:07:18,080 --> 00:07:20,460
،الآن وبعد أن أصبح أكوتاغاوا-كُن عاجزًا

118
00:07:20,460 --> 00:07:24,630
هل لديكِ شيءٌ يُحفّزنا للانصياع؟

119
00:07:28,710 --> 00:07:30,680
!لا أحتاج عونكِ

120
00:07:35,180 --> 00:07:36,430
!أكوتاغاوا-سينباي

121
00:07:36,430 --> 00:07:38,770
!حتّى بالنّسبة لك، فهذا بمثابة انتحار

122
00:07:38,770 --> 00:07:41,980
!أنت في طريقك إلى بنايةٍ تعجّ بحرّاس الأمن

123
00:07:41,980 --> 00:07:44,360
...ولم تصدر لتابعيك أيّ أوامر لنساندك

124
00:07:44,360 --> 00:07:45,110
!اصمتي

125
00:07:45,520 --> 00:07:47,230
وما أدراكِ بأيٍّ من هذا؟

126
00:07:52,450 --> 00:07:53,700
.إنّها إشارةٌ دخانيّة

127
00:07:54,160 --> 00:07:56,830
.إشارةٌ دخانيّة واضحةٌ لكلّ ركنٍ من أركان المدينة

128
00:07:57,410 --> 00:08:01,410
...ذلك الشّخص الّذي غادر دون الاعتراف بقدرتي

129
00:08:01,410 --> 00:08:04,920
.هذا الدّخان السّميك سيجذب انتباهه بالتّأكيد

130
00:08:04,920 --> 00:08:07,880
!لكن من واجبي أن أساعدك

131
00:08:08,170 --> 00:08:09,550
!لستُ في حاجةٍ لمساعدتكِ

132
00:08:11,220 --> 00:08:12,550
!لا أحتاج مساعدةً من أحد

133
00:08:23,230 --> 00:08:24,350
.لقد عدت

134
00:08:24,730 --> 00:08:29,440
هل سبق وتساءلتي ما إن كنتِ ملائمةً لهذا العمل؟

135
00:08:32,070 --> 00:08:34,860
...بالطّبع لستُ كذلك

136
00:08:57,390 --> 00:08:58,680
.نعم؟ أنا هيغوتشي

137
00:08:59,390 --> 00:09:00,510
!ماذا قلت؟

138
00:09:05,730 --> 00:09:07,860
.يجدر بكِ التّفكير مليًا

139
00:09:07,860 --> 00:09:09,770
.أنتِ تعصين الرّؤساء

140
00:09:09,770 --> 00:09:11,820
هل أنتِ في كامل وعيك؟

141
00:09:11,820 --> 00:09:13,240
!هذا انتحار

142
00:09:13,240 --> 00:09:18,660
لقد اختُطف أكوتاغاوا من قِبل مرتزقة أجانب
!عيّنهم ناجون من شركة كارما للنّقل

143
00:09:18,660 --> 00:09:22,950
،إنّهم لا يفوقونكِ عددًا فحسب
!بل هم مدجّجون بالسّلاح أيضًا

144
00:09:22,950 --> 00:09:26,170
.سيُصدر الزّعيم أوامر لشنّ عملية استرجاع

145
00:09:26,170 --> 00:09:27,500
!تحلّي بالصّبر إلى حينها

146
00:09:27,500 --> 00:09:29,130
!لن يصدر ذلك الأمر قطّ

147
00:09:29,880 --> 00:09:34,090
إن قامت المنظّمة بردّ هجوم شركة
،التّهريب تلك بسبب أحقادٍ شخصيّة

148
00:09:34,090 --> 00:09:36,880
.فسيؤدي ذلك إلى نشوب حربٍ كبيرة المدى مع منظمةٍ أخرى

149
00:09:37,260 --> 00:09:42,350
ولتجنّب ذلك، فسيتعامل الرؤساء مع
.الأمر بكونه نزاعًا شخصيًا بين أفراد

150
00:09:42,970 --> 00:09:45,310
.لقد تمّ التّخلي عن أكوتاغاوا-سينباي

151
00:09:45,770 --> 00:09:48,850
لكن ماذا تأملين أن تحقّقي بمفردكِ؟

152
00:09:49,940 --> 00:09:51,480
.لا شيء

153
00:09:52,480 --> 00:09:53,070
!مع ذلك

154
00:09:53,070 --> 00:09:55,990
!لا يمكنني أن أقف مكتوفة اليدين

155
00:09:58,820 --> 00:10:00,160
...كنتُ أعلم

156
00:10:00,160 --> 00:10:02,870
.كنتُ أعلم أنّي لستُ مناسبةً لهذا العمل

157
00:10:02,870 --> 00:10:05,620
.كنتُ أعلم أنّي لا أحظى بتقدير أتباعي

158
00:10:06,250 --> 00:10:12,880
لو كنتُ مكانك لأعدتُ التّفكير بوضعي
.الحاليّ قبل أن يأتي قاتِلٌ لعتبة منزلي

159
00:10:14,090 --> 00:10:17,760
،ليس من السّهل مغادرة مافيا الميناء
.لكنّه ليس أمرًا مستحيلًا

160
00:10:17,760 --> 00:10:19,760
.فكّرتُ في ذلك كثيرًا

161
00:10:20,430 --> 00:10:22,930
...لكنّ السّبب الّذي منعني من ذلك

162
00:10:56,550 --> 00:10:57,920
...تبًا

163
00:10:58,380 --> 00:11:00,890
...لا يمكنني أن أنقذ السينباي بهذه الإصابة

164
00:11:31,420 --> 00:11:35,460
...لكنّ السّبب الّذي منعني من ذلك

165
00:11:46,970 --> 00:11:49,930
!اقتلوا كلّ من لا تعرفونه

166
00:11:57,150 --> 00:11:59,820
السّحليّة السّوداء هنا؟ لماذا؟

167
00:12:00,190 --> 00:12:02,610
.أنتِ قائدتنا

168
00:12:03,280 --> 00:12:07,370
.إن كان قائدنا في خطر، فيجب أن نتصرّف

169
00:12:10,040 --> 00:12:11,910
.أظنّ أنّنا كدنا ننتهي

170
00:12:19,630 --> 00:12:22,260
...أكوتاغاوا-سينباي

171
00:12:24,550 --> 00:12:25,720
...سينباي

172
00:12:25,720 --> 00:12:26,890
!سينباي

173
00:12:33,020 --> 00:12:35,060
هيغوتشي؟

174
00:12:36,560 --> 00:12:38,570
.سينباي، أنت تنزف

175
00:12:43,110 --> 00:12:44,610
.آسف

176
00:12:49,700 --> 00:12:54,420
،ليس من السّهل مغادرة مافيا الميناء
.لكنّه ليس أمرًا مستحيلًا

177
00:12:55,580 --> 00:12:58,170
...لكنّ السّبب الّذي منعني من ذلك

178
00:13:01,670 --> 00:13:03,090
.لأنّه عملي

179
00:13:03,970 --> 00:13:06,970
الحلقة الحادية عشرة

180
00:13:03,970 --> 00:13:06,970
كلاب الأدب الشاردة

181
00:13:07,890 --> 00:13:10,430
.أنت من سيعتني بهذه الفتاة

182
00:13:10,430 --> 00:13:12,060
ماذا؟ أنا؟

183
00:13:12,390 --> 00:13:13,600
.بالطّبع

184
00:13:13,600 --> 00:13:15,390
.فأنت من أنقذها

185
00:13:15,390 --> 00:13:16,520
.حسنًا

186
00:13:17,480 --> 00:13:18,360
.المعذرة

187
00:13:19,320 --> 00:13:20,820
.نحن من شرطة المدينة

188
00:13:20,820 --> 00:13:22,570
.بوركت جهودكم

189
00:13:22,570 --> 00:13:23,610
ماذا؟

190
00:13:23,610 --> 00:13:26,530
ألست مينورا-كُن الّذي قُبض على أحد رجالك قبل فترة؟

191
00:13:27,320 --> 00:13:29,450
.نحن هنا اليوم لأجل مسألة أخرى أيّها المتحرّي الشّهير

192
00:13:31,120 --> 00:13:32,580
.لدينا قضيّة لكم

193
00:13:33,080 --> 00:13:37,080
الحلقة الحاديّة عشرة
:الجزء الثاني
وكالة تحرّي منتشيّة

194
00:13:37,620 --> 00:13:41,170
لقد غادرا فور الانتهاء من الحديث عن
.العمل دون أن يحتسيا الشّاي حتّى

195
00:13:41,590 --> 00:13:43,800
.أظنّ أنّ شرطة المدن الكبرى مشغولون جدًا

196
00:13:44,130 --> 00:13:46,930
وهل تملك الشّرطة وقت فراغ في قريتك؟

197
00:13:46,930 --> 00:13:49,600
.الجميع يعرفون بعضهم البعض في قريتي

198
00:13:49,600 --> 00:13:53,140
،غالبًا ما يكون عمل الشّرطة إصلاح مضخّة البئر

199
00:13:53,140 --> 00:13:55,480
،أو إنقاذ القطط العالقة في المداخن

200
00:13:55,480 --> 00:13:58,190
.وكذلك تذوّق الحصاد الأوّل للبطّيخ

201
00:13:58,190 --> 00:13:59,360
ما هذا؟

202
00:13:59,690 --> 00:14:01,480
وماذا سيحدث إن ارتكب أحدهم جريمة؟

203
00:14:01,480 --> 00:14:03,570
.حينها يُربط الجاني ويُرمى به من أعلى الجرف

204
00:14:05,070 --> 00:14:07,740
...المعذرة يا كينجي-سان

205
00:14:07,740 --> 00:14:09,490
.يمكنك مناداتي بكينجي-كُن

206
00:14:09,990 --> 00:14:12,450
،قبل شهرين كنتُ أعيش في قريةٍ تدعى إيهاتوفو

207
00:14:12,450 --> 00:14:15,580
.حيث لا توجد لا كهرباء ولا هواتف

208
00:14:16,040 --> 00:14:18,960
.لقد جُنِّدتُ من قِبل الرّئيس وأتيت إلى المدينة

209
00:14:19,500 --> 00:14:22,380
.المدينة مليئة بالمفاهيم الجديدة، وأنا أستمتع كثيرًا

210
00:14:22,380 --> 00:14:24,760
جديدة؟ مثل ماذا؟

211
00:14:24,760 --> 00:14:27,970
.أوّلًا، لا أفهم جيّدًا مفهوم المال

212
00:14:24,760 --> 00:14:30,260
المقايضة
———
ليست
كافية؟

213
00:14:28,510 --> 00:14:30,260
بدأتَ من هذا؟

214
00:14:30,680 --> 00:14:31,800
،كونيكيدا-سان

215
00:14:31,800 --> 00:14:34,390
ماذا سنفعل حيال طلب الشّرطة الّذي تلقّيناه سابقًا؟

216
00:14:36,180 --> 00:14:40,730
الّذي يخصّ تلك السّيارة المتحرّكة
الّتي انفجرت لسببٍ مجهول؟

217
00:14:40,730 --> 00:14:42,560
.سيكون تحدّيًا لنا فقد حيّر الشّرطة

218
00:14:43,020 --> 00:14:44,650
أتسوشي، أتريد المحاولة؟

219
00:14:45,730 --> 00:14:48,570
.رافق وكيلًا آخر وتعلّم طبيعة العمل بسرعة

220
00:14:49,110 --> 00:14:50,280
.يمكنك فعلها

221
00:14:51,660 --> 00:14:52,450
.حاضر

222
00:14:53,990 --> 00:14:55,080
ما الّذي يجري؟

223
00:14:55,080 --> 00:14:56,080
ما هذا؟

224
00:14:56,080 --> 00:14:59,750
سمعتُ أنّ السّيارة كانت تسير
.بشكلٍ عاديّ وقفزت إلى هناك فجأةً

225
00:14:56,790 --> 00:14:58,910
قنبلةٌ أخرى؟

226
00:15:00,170 --> 00:15:02,130
...لستُ واثقًا إن كنتُ مستعدًا لهذا

227
00:15:02,130 --> 00:15:05,000
.لقد مات السّائق جرّاء الحادث ولم يتم التعرّف عليه

228
00:15:05,340 --> 00:15:06,760
لم يتم التعرّف عليه؟

229
00:15:06,760 --> 00:15:10,680
ألا يمكننا التعرّف على النّاس
إن كانت بصماتهم وأسنانهم سليمة؟

230
00:15:10,680 --> 00:15:11,260
.بلى

231
00:15:11,260 --> 00:15:12,390
.إن كانت سليمة

232
00:15:12,390 --> 00:15:13,180
!ماذا؟

233
00:15:13,180 --> 00:15:16,770
...إذًا كلّ شيء متفحّم داخل تلك السّيارة

234
00:15:17,140 --> 00:15:20,850
،حسنًا، لو كان رانبو-سان هنا لحلّ القضيّة فورًا

235
00:15:20,850 --> 00:15:26,110
يوكوهاماباشي

236
00:15:21,270 --> 00:15:24,770
.لكن مهمّتنا الآن هي البدء في جمع المعلومات

237
00:15:24,770 --> 00:15:26,110
.كين-تشان

238
00:15:26,530 --> 00:15:28,280
.مرحبًا يا آنسة مايدا

239
00:15:28,280 --> 00:15:31,030
.شكرًا على لحم الخنزير الّذي قدّمته لي ذلك اليوم

240
00:15:31,030 --> 00:15:32,320
.لقد كان لذيذًا

241
00:15:32,320 --> 00:15:34,620
.لقد أرسلت لي عائلتي الكثير منه

242
00:15:34,620 --> 00:15:36,120
.لا داعي للشّكر

243
00:15:36,120 --> 00:15:37,660
آنسة"؟"

244
00:15:37,660 --> 00:15:40,210
.إنّها تُعتبر من بين اليافعات في قريتي

245
00:15:40,210 --> 00:15:41,460
.يا فتى

246
00:15:41,830 --> 00:15:46,300
حديقة الخضار الّتي أخبرتك عنها
.لا أستطيع إصلاح مجرى تصريف الميّاه الخاص بها

247
00:15:46,300 --> 00:15:48,420
.لا بدّ أنّ ذلك بفعل التّربة العالقة

248
00:15:48,420 --> 00:15:49,510
.سآتي لألقي نظرة غدًا

249
00:15:49,510 --> 00:15:50,670
.شكرًا

250
00:15:50,670 --> 00:15:52,260
.أنت ذو شعبيّة حقًا

251
00:15:52,760 --> 00:15:54,430
.مرحبًا يا كين-تشان

252
00:15:55,600 --> 00:15:56,970
هل أنت في مهمّة؟

253
00:15:58,020 --> 00:16:02,060
إنّنا نحقّق بشأن حادثة انفجار
.السّيارة الّتي حدثت في الشّارع

254
00:16:02,060 --> 00:16:04,020
أتعلم شيئًا بخصوص ذلك؟

255
00:16:04,480 --> 00:16:07,110
...هذا

256
00:16:07,110 --> 00:16:10,070
...هناك... شائعات

257
00:16:18,540 --> 00:16:22,410
،لا يتوجّب عليّ الحديث عن هذا
.لكنّي سمعت الشّباب يتحدّثون عن ذلك

258
00:16:22,410 --> 00:16:27,750
قبل الحادث، اشترى أشخاصٌ مشبوهون
.كمًا كبيرًا من السّماد وخزّنوه في المصنع

259
00:16:27,750 --> 00:16:28,670
...سماد

260
00:16:29,090 --> 00:16:31,720
.أتساءل ما إن أدركوا جمال الزّراعة

261
00:16:31,720 --> 00:16:35,260
.كلّا، يبدو أنّهم كانوا يتحدّثون عن تصنيع شيء

262
00:16:35,260 --> 00:16:37,550
.إذًا فهيّ على الأغلب أسمدة نتروجينيّة

263
00:16:37,890 --> 00:16:39,180
أسمدة نتروجينيّة؟

264
00:16:39,180 --> 00:16:40,850
.إنّها مادةٌ خام لصنع القنابل

265
00:16:40,850 --> 00:16:41,810
!ماذا؟

266
00:16:41,810 --> 00:16:43,560
.شكرًا جزيلًا لك كالعادة

267
00:16:43,560 --> 00:16:44,650
.كان هذا ذا عونًا كبيرًا

268
00:16:44,650 --> 00:16:46,810
.سأفعل أي شيء لأجلك يا كين-تشان

269
00:16:45,310 --> 00:16:47,520
...لقد وجد طرف خيطٍ بالفعل

270
00:16:46,810 --> 00:16:48,150
.فلنبقَ على وِفاق

271
00:16:47,520 --> 00:16:49,270
.إنّ كينجي-كُن مدهش

272
00:16:48,150 --> 00:16:50,360
.وأنا أيضًا سأعتمد عليك

273
00:16:51,610 --> 00:16:53,860
،بالحديث عن أزقّة المنطقة الصّناعية

274
00:16:53,860 --> 00:16:56,870
.تتواجد هناك قاعة اجتماع لجمعية شباب غوجو

275
00:16:56,870 --> 00:16:58,080
جمعية شبابية؟

276
00:16:58,490 --> 00:17:01,120
بمفاهيم المدينة... عصابة؟

277
00:17:01,120 --> 00:17:02,330
!عـ-عصابة؟

278
00:17:02,750 --> 00:17:05,750
.أتساءل ما إن كانوا المسؤولين عن ذلك الانفجار

279
00:17:06,500 --> 00:17:09,130
.حسنٌ، فلنذهب ونسألهم مباشرةً

280
00:17:09,130 --> 00:17:10,210
!تمهّل لحظة

281
00:17:10,670 --> 00:17:13,220
.حتّى لو كانوا الفاعلين، أشكّ أنّهم سيعترفون بذلك

282
00:17:13,220 --> 00:17:14,380
!إنّ ذلك خطير

283
00:17:14,930 --> 00:17:17,720
.إن سألناهم بصدقٍ فسيجيبون

284
00:17:17,720 --> 00:17:18,970
.هكذا تسير الأمور

285
00:17:18,970 --> 00:17:20,680
هـ-هكذا تسري الأمور؟

286
00:17:21,180 --> 00:17:22,770
هكذا تسري؟

287
00:17:24,350 --> 00:17:25,890
...هذا

288
00:17:28,110 --> 00:17:29,900
!أظنّ أنّ هكذا تسير الأمور بالفعل

289
00:17:31,480 --> 00:17:32,860
.أخبرني يا تانيزاكي

290
00:17:33,280 --> 00:17:35,150
ألستَ مع أتسوشي؟

291
00:17:35,150 --> 00:17:38,120
.لقد ذهب رفقة كينجي-كُن

292
00:17:35,150 --> 00:17:48,170
خرج لشراء
البيض
————
بمناسبة
تخفيض
محدود
.عليها

293
00:17:38,120 --> 00:17:39,910
!ماذا؟ مع كينجي؟

294
00:17:39,910 --> 00:17:42,160
.أجل، لقد ذهبا إلى مسرح الجريمة سويًا

295
00:17:42,160 --> 00:17:46,330
.كينجي-كُن كفؤ جدًا فقد حلّ العديد من القضايا الصّعبة

296
00:17:46,330 --> 00:17:47,500
...لذا ما من مشكلة

297
00:17:46,620 --> 00:17:48,170
!إنّها مشكلة كبيرة

298
00:17:48,540 --> 00:17:51,300
!أساليب كينجي فريدةٌ جِدًا وليس قدوةً جيّدة

299
00:17:51,630 --> 00:17:54,260
،لكن نظرًا لبساطة وسذاجة أتسوشي

300
00:17:54,260 --> 00:17:57,930
قد يتّبع بسهولة أساليب كينجي
!ويعتقد أنّها المعايير الأفضل

301
00:17:56,930 --> 00:17:58,550
أفضل
وأسوأ
ثنائي

302
00:17:58,550 --> 00:18:00,300
...هذا سيّئ

303
00:18:00,850 --> 00:18:02,310
!ماذا؟

304
00:18:02,720 --> 00:18:06,810
هل أنتم من صناع القنبلة الّتي قذفت السّيارة؟

305
00:18:06,810 --> 00:18:08,400
!أنت مضحك

306
00:18:08,400 --> 00:18:09,560
هل أنتما من الشّرطة؟

307
00:18:09,860 --> 00:18:12,820
.على الإطلاق، إنّنا مع وكالة التحرّي المسلّحة

308
00:18:15,150 --> 00:18:16,820
!يا لها من سلسلة جميلة

309
00:18:17,200 --> 00:18:20,570
لا بدّ أنّك تبقيها معك في حالة
احتجت نقل الأبقار، صحيح؟

310
00:18:20,570 --> 00:18:21,580
!لا تلمسها

311
00:18:21,580 --> 00:18:22,700
!إلامَ تخطّط؟

312
00:18:22,700 --> 00:18:26,710
.أردتُ فقط أن تخبروني ما إن كنتم مسؤولين عمّا حدث

313
00:18:26,710 --> 00:18:28,250
ماذا؟

314
00:18:30,420 --> 00:18:32,920
.لا فكرة لدينا عمّا تتحدّث

315
00:18:32,920 --> 00:18:34,170
صحيح؟

316
00:18:35,420 --> 00:18:36,760
!هكذا إذًا

317
00:18:36,760 --> 00:18:38,130
.آسفٌ على إزعاجكم

318
00:18:38,130 --> 00:18:39,050
!ماذا؟

319
00:18:39,430 --> 00:18:41,640
.شكرًا جزيلًا على تعاونكم

320
00:18:41,640 --> 00:18:42,890
ماذا؟

321
00:18:44,350 --> 00:18:46,310
!مـ-مهلًا يا كينجي-كُن

322
00:18:46,730 --> 00:18:48,690
!من الواضح أنّهم يكذبون

323
00:18:48,690 --> 00:18:50,650
!إنّهم الجُناة

324
00:18:50,650 --> 00:18:54,900
!لعلّهم استخدموا القنابل ليقتلوا أحدًا من عصابةٍ أو ما شابه

325
00:18:54,900 --> 00:18:57,150
.لكنّهم قالوا أنّهم لا يعرفون شيئًا

326
00:18:57,150 --> 00:18:59,150
...بالفعل، ولكن

327
00:18:59,950 --> 00:19:01,570
...سواءٌ أكنتَ مع بقرة أو شخص

328
00:19:01,570 --> 00:19:03,370
،سواءٌ أكنتَ في القرية أو المدينة

329
00:19:03,370 --> 00:19:06,200
.طالما كنتَ صادقًا فيمكنك أن تتواصل مع الآخرين

330
00:19:06,950 --> 00:19:10,330
.لم أخفق أبدًا باستخدام هذا الأسلوب

331
00:19:10,790 --> 00:19:12,710
حـ-حقًا؟

332
00:19:12,710 --> 00:19:13,880
.أجل

333
00:19:17,760 --> 00:19:19,340
.أظنّ أنّ لديك وجهة نظر

334
00:19:19,760 --> 00:19:21,090
هلّا عدنا الآن؟

335
00:19:21,090 --> 00:19:22,050
.أجل

336
00:19:30,060 --> 00:19:32,230
.فلنذهب لتناول حساء لحم البقر في طريق عودتنا

337
00:19:32,230 --> 00:19:33,610
.أنا أتضوّر جوعًا

338
00:19:33,610 --> 00:19:37,070
كينجي-كُن، أيمكنك أن تأكل لحم البقر مع أنّك تملك بقرًا؟

339
00:19:37,070 --> 00:19:38,940
!أحبّ الأبقار

340
00:19:38,940 --> 00:19:41,240
.أحبّ امتلاك البقر والتّواصل معها وأكلها

341
00:19:44,780 --> 00:19:48,200
.كانت القنبلة بغرض قتل فردٍ من عصابةٍ عدوّة

342
00:19:48,200 --> 00:19:51,870
.من كان يتوقّع أنّ بعض المتحرّين سيكشفون أمرنا

343
00:19:52,250 --> 00:19:54,880
،بما أنّكما غادرتما دون استجوابنا بدقّة

344
00:19:54,880 --> 00:19:57,670
ربّما وجدتما دليلًا قاطعًا؟

345
00:19:57,670 --> 00:19:59,510
!ستخبران الشّرطة، أليس كذلك؟

346
00:19:59,510 --> 00:20:00,510
.لن نسمح لكما

347
00:20:00,510 --> 00:20:01,970
.فهمت

348
00:20:01,970 --> 00:20:06,140
.أنا مسرورٌ لتكبّدكم عناء القدوم والاعتراف بالحقيقة

349
00:20:06,510 --> 00:20:07,140
ماذا؟

350
00:20:07,510 --> 00:20:10,390
.عرفتُ أنّ بإمكاننا فهم بعضنا البعض طالما نتعامل بصدقٍ

351
00:20:10,390 --> 00:20:15,770
،في كلّ القضايا الّتي أُسندت لي
.الجميع يعترفون بهذا الشّكل

352
00:20:17,110 --> 00:20:18,820
!فهمت، هكذا إذًا

353
00:20:27,330 --> 00:20:29,080
.سقط واحد

354
00:20:29,450 --> 00:20:30,080
!معضلة

355
00:20:30,410 --> 00:20:31,830
...إنّنا محاصران

356
00:20:31,830 --> 00:20:33,580
!ما الّذي كنتُ أفعله؟

357
00:20:33,580 --> 00:20:35,790
!اقضوا عليه

358
00:20:37,250 --> 00:20:38,380
...هذا مؤلم

359
00:20:38,380 --> 00:20:39,590
ماذا؟

360
00:20:41,380 --> 00:20:43,340
.بئسًا

361
00:20:43,720 --> 00:20:44,970
...مؤلم

362
00:20:44,970 --> 00:20:47,050
.لا تجعل هذا يزعجك

363
00:20:47,050 --> 00:20:48,850
.فهذا يحدث أحيانًا

364
00:20:48,850 --> 00:20:53,520
.في الرّيف، غالبًا ما تهتاج الأبقار وترفض الإصغاء

365
00:20:53,850 --> 00:20:55,350
...وحينما يحدث ذلك

366
00:21:00,320 --> 00:21:01,860
.لا تدع المطر يهزمك

367
00:21:02,280 --> 00:21:03,820
.لا تدع الرّياح تهزمك

368
00:21:04,280 --> 00:21:05,570
.ولا الأنبوب الحديديّ

369
00:21:05,860 --> 00:21:07,200
.ولا السّكين

370
00:21:07,200 --> 00:21:09,700
.ولا المضرب المعدني

371
00:21:09,830 --> 00:21:11,830
.تحلّ بالجسم السّليم

372
00:21:13,370 --> 00:21:15,080
.تخلّ عن الطّمع

373
00:21:15,080 --> 00:21:16,790
.ولا تغضب أبدًا

374
00:21:17,170 --> 00:21:19,540
.حافظ دائمًا على الابتسامة الهادئة

375
00:21:20,050 --> 00:21:27,010
شعار عائلة
ميزاوا
