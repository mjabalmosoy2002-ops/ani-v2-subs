1
00:00:07,120 --> 00:00:11,240
،أول شخص أعجز عن تصديق وجوده

2
00:00:11,240 --> 00:00:12,710
.كانت أختي

3
00:00:13,560 --> 00:00:15,960
،لم تكن ساحرة من الرتبة الأولى فحسب

4
00:00:15,960 --> 00:00:18,160
.كما أنها كانت آلة فنون قتالية

5
00:00:18,750 --> 00:00:21,960
.لهذا كنتُ دائمًا أنهزم أمامها

6
00:00:22,440 --> 00:00:24,610
،كانت تكبرني بعامين

7
00:00:24,610 --> 00:00:27,800
لكن كلّما سُئلت عمّا إن كنت سأبلغ
،مستواها بعد عامين

8
00:00:27,800 --> 00:00:28,780
.ساورني الشكّ

9
00:00:33,640 --> 00:00:38,000
.حتى صرتُ أعتقد أنّي لن ألحق بها أبدًا

10
00:00:39,570 --> 00:00:41,340
.أنت عبقرية يا يوكيني

11
00:00:41,780 --> 00:00:43,570
.أضمن لك هذا

12
00:00:45,530 --> 00:00:48,900
لكنّي أدركتُ في عمر مبكر

13
00:00:49,660 --> 00:00:54,220
أن ذلك بسبب بذل أبي وأميّ
.أقصى جهودهما لمساندتها

14
00:00:54,880 --> 00:00:58,960
.أعتقد أنهما قد أحبّا مبارزتها

15
00:00:59,650 --> 00:01:02,700
لكن سبب عدم انتباههما لي
.كان واضحًا بشكل مؤلم

16
00:01:03,410 --> 00:01:08,380
...في النهاية، أنا التي كنتُ مسحورة بمبارزتها

17
00:01:09,220 --> 00:01:10,640
.أختي عبقرية

18
00:01:12,100 --> 00:01:13,900
،ربما لديّ فرصة في السحر

19
00:01:14,210 --> 00:01:18,070
.لكنّي لن أتفوّق عليها أبدًا في المبارزة

20
00:01:20,570 --> 00:01:23,650
،ليس كأنّي اعتقدتُ أنّي بلا موهبة

21
00:01:24,190 --> 00:01:27,840
.لكنّ ذلك ما جعلني أختار الناغيناتا

22
00:01:28,490 --> 00:01:31,890
،لأنّي كنتُ أملك بعض الموهبة في استخدام الكاتانا

23
00:01:31,890 --> 00:01:35,100
.زادني ذلك إدراكًا بمدى براعتها في استخدامه

24
00:01:36,460 --> 00:01:39,720
...كانت تلك أول مرة أهرب

25
00:01:40,170 --> 00:01:43,630
بعد ستة أشهر

26
00:01:54,850 --> 00:01:57,010
.لستُ عبقرية

27
00:01:57,550 --> 00:01:59,750
،إن أردتني أن أكون عبقرية بشدّة

28
00:01:59,750 --> 00:02:01,330
.عليك أن تعترفي بذلك يا يوكيني

29
00:02:02,260 --> 00:02:05,530
.أنت عبقرية أيضًا، لذا اسعي لذلك

30
00:02:07,460 --> 00:02:10,160
...بدلًا منّي

31
00:03:42,490 --> 00:03:45,620
إذًا هكذا يؤدى تقييم القدرات
في أكاديمية تسوكويومي للسحر

32
00:03:44,490 --> 00:03:47,450
تقييم القدرات

33
00:03:44,490 --> 00:03:47,450
من 12 إلى 16 مايو

34
00:03:44,490 --> 00:03:47,450
كتابيّ

35
00:03:44,490 --> 00:03:47,450
تطبيقيّ

36
00:03:44,490 --> 00:03:47,450
السرداب

37
00:03:45,620 --> 00:03:47,450
.على مرّ عدّة أيام

38
00:03:47,450 --> 00:03:50,870
تُستمدّ النتيجة الإجمالية
،من الاختبارين الكتابي والتطبيقيّ

39
00:03:50,870 --> 00:03:52,460
.بالإضافة إلى التغلّب على السرداب

40
00:03:52,460 --> 00:03:56,340
،بما أنها أول مرة لكم
.فقد تشعرون ببعض القلق

41
00:03:56,340 --> 00:03:58,460
،بما أن ترتيب المدارس سيُعلن

42
00:03:58,460 --> 00:04:00,880
.احرصوا على مواصلة استعداداتكم

43
00:04:04,390 --> 00:04:05,680
.أخبرني يا تاكيوتو

44
00:04:05,680 --> 00:04:07,680
.لديّ سؤال لك

45
00:04:08,260 --> 00:04:11,430
ماذا تفعل بالتحديد عند التغيّب عن الدراسة؟

46
00:04:11,430 --> 00:04:12,890
ماذا تقصدين؟

47
00:04:12,890 --> 00:04:14,850
.أذهب إلى السراديب

48
00:04:14,850 --> 00:04:17,230
.لا، ذلك ليس كل شيء

49
00:04:17,230 --> 00:04:18,690
.هناك بعض الشائعات

50
00:04:18,690 --> 00:04:20,690
يبدو أن هناك أشخاصًا يملكون
.وقت فراغ كبير

51
00:04:20,690 --> 00:04:22,950
سيدي، لا شكّ أنهم كائنات متدنية

52
00:04:22,950 --> 00:04:24,950
.مهارتها الوحيدة هي الإساءة للآخرين

53
00:04:24,950 --> 00:04:27,700
.لا تقولي لبقية الطلاب

54
00:04:27,700 --> 00:04:29,080
أيّ شائعات؟

55
00:04:29,080 --> 00:04:33,120
استخدام جهاز غريب في طقوس
،لعبادة الشيطان

56
00:04:33,120 --> 00:04:35,920
،علاقته بمكتب مريب

57
00:04:35,920 --> 00:04:39,670
...أو بيع مستحضر يحمل علامة سمكة

58
00:04:39,670 --> 00:04:41,420
.أعتقد أنها ليست مختلقة كليًا

59
00:04:41,420 --> 00:04:42,880
ماذا؟ أهذا صحيح؟

60
00:04:42,880 --> 00:04:44,590
.يبدو أننا حققنا مبيعة للتو

61
00:04:44,590 --> 00:04:46,890
.أخذت امرأة ذات شعر وردي قرضًا

62
00:04:46,890 --> 00:04:48,760
!إنها المعلمة رويجا

63
00:04:48,760 --> 00:04:51,180
!كما توقعت، كان عليّ أن أخصص لها مصروفًا

64
00:04:51,180 --> 00:04:52,020
!تذكرت

65
00:04:52,020 --> 00:04:53,600
!لنذهب إلى السرداب بعد الدراسة

66
00:04:53,980 --> 00:04:55,640
لِم سأرافقك؟

67
00:04:56,400 --> 00:04:57,400
.عليك مرافقتنا أيضًا يا يوري

68
00:04:58,770 --> 00:04:59,770
يمكنني مرافقتكم؟

69
00:05:00,020 --> 00:05:02,400
.كنتُ أرغب في الذهاب معك

70
00:05:03,030 --> 00:05:07,450
لا يُسمح لطلاب السنة الأولى
.بدخول السراديب بمفردهم

71
00:05:07,450 --> 00:05:08,910
.لن يمنحك أيّ معلم الإذن

72
00:05:08,910 --> 00:05:10,870
.لكنّي حصلتُ على الإذن مسبقًا

73
00:05:10,870 --> 00:05:12,660
!هذا ترخيض من المعلمة رويجا

74
00:05:12,660 --> 00:05:14,580
.إنها معلمتنا

75
00:05:14,580 --> 00:05:16,420
.سيكون ذلك آمنًا

76
00:05:16,420 --> 00:05:18,920
أنوي أن أطلب من أحد أعضاء
.لجنة الأخلاق مرافقتنا أيضًا

77
00:05:18,920 --> 00:05:20,170
لجنة الأخلاق؟

78
00:05:20,170 --> 00:05:21,630
ستنضمين إلينا يا لودي، صحيح؟

79
00:05:21,960 --> 00:05:24,170
سمعتُ أنكِ تركضين يوميًا؟

80
00:05:24,970 --> 00:05:26,380
.هذا مذهل

81
00:05:26,380 --> 00:05:28,640
.يبدو أن الأميرات يعملن بجدّ أيضًا

82
00:05:28,640 --> 00:05:30,510
لكن كيف عرف تاكيوتو ذلك؟

83
00:05:30,510 --> 00:05:31,310
...هذا

84
00:05:32,560 --> 00:05:34,890
.إن كنّا نملك الإذن فلا مانع لديّ

85
00:05:34,890 --> 00:05:37,020
!أنا أيضًا. شكرًا لك يا كوسكي-كن

86
00:05:37,230 --> 00:05:39,150
!حُسم الأمر إذًا

87
00:05:42,480 --> 00:05:45,490
.آمل أن يكون سردابًا عاديًا هذه المرة

88
00:05:45,490 --> 00:05:46,860
.لا داعي للقلق حيال ذلك

89
00:05:46,860 --> 00:05:48,950
سنكون بحاجة لقوة قتالية

90
00:05:48,950 --> 00:05:51,330
.للمشاركة في فعالية اللعبة

91
00:05:51,740 --> 00:05:56,040
.استعدادًا لذلك، يجب أن يصبح الجميع أقوى

92
00:05:52,240 --> 00:05:53,830
.يسرّني لقاءك

93
00:05:53,830 --> 00:05:56,040
.يسرني لقاءك أيضًا

94
00:05:56,040 --> 00:05:58,790
[سرداب المبتدئين - الطابق الأول]

95
00:05:59,920 --> 00:06:00,790
!فريسة سهلة

96
00:06:00,790 --> 00:06:01,590
!وفريسة لي

97
00:06:05,050 --> 00:06:06,800
.إنهما بارعان

98
00:06:06,800 --> 00:06:09,510
.أجل، وسيصيران أقوى على الأرجح

99
00:06:09,840 --> 00:06:13,010
يمكنكما تجاهل الوحوش التي هنا
.يا يوري وكاتورينا

100
00:06:13,260 --> 00:06:15,020
لماذا؟

101
00:06:15,020 --> 00:06:16,520
.لأن علينا أن نسرع

102
00:06:17,980 --> 00:06:20,350
[الطابق الخامس]

103
00:06:31,030 --> 00:06:34,160
!كل ما نقوم به هو الركض

104
00:06:34,160 --> 00:06:36,410
ما المغزى من هذا؟

105
00:06:36,410 --> 00:06:38,370
.لودي، تبدين على ما يرام

106
00:06:38,370 --> 00:06:42,130
تعلمتُ مؤخرًا أن بناء
.قوة تحمّلي هو الأساس

107
00:06:43,340 --> 00:06:44,880
...أنتم أقوياء

108
00:06:44,880 --> 00:06:47,300
.لكنك تجارينا بشكل جيد

109
00:06:47,300 --> 00:06:49,090
!أجل! شكرًا لك

110
00:06:49,090 --> 00:06:51,590
[الطابق التاسع]

111
00:06:51,430 --> 00:06:52,550
.وصلنا في الوقت المحدد

112
00:06:55,100 --> 00:06:55,930
ماذا؟

113
00:06:55,930 --> 00:06:57,520
ألم ننته بعد؟

114
00:06:57,850 --> 00:07:01,690
،إن صادفنا تقاطعًا رباعيًا
.سنتجه شمالًا، غربًا، غربًا، جنوبًا

115
00:07:01,690 --> 00:07:05,770
،وإن كان تقاطعًا ثلاثيًا
.سنتجه جنوبًا، جنوبًا، شرقًا، جنوبًا شرقًا، جنوبًا

116
00:07:05,770 --> 00:07:06,730
!حسنًا

117
00:07:07,440 --> 00:07:09,240
كوسكي؟

118
00:07:19,200 --> 00:07:22,170
.ساعة و58 دقيقة يا سيدي

119
00:07:22,170 --> 00:07:24,460
.تبقّت دقيقتان. كان ذلك وشيكًا

120
00:07:24,750 --> 00:07:26,210
حقًا؟

121
00:07:26,210 --> 00:07:27,340
ضربة واحدة؟

122
00:07:30,550 --> 00:07:35,640
أبليتم حسنًا بتغلّبكم على الشر
.ووقوفكم أمامي

123
00:07:36,140 --> 00:07:39,520
.سأمنحكم مهارة لأكافئكم على إنجازكم

124
00:07:41,600 --> 00:07:43,690
ما كان ذلك؟

125
00:07:43,690 --> 00:07:44,860
!اشرح لنا

126
00:07:45,190 --> 00:07:48,070
هل يُسمح لنا بالحصول
على المهارات بهذه السهولة؟

127
00:07:48,070 --> 00:07:48,980
كوسكي-كن؟

128
00:07:49,230 --> 00:07:53,950
هذا جدول يلخص مخططات المتاهات الثمانية

129
00:07:54,280 --> 00:07:57,910
والمهارات الخمس التي يُمكن الحصول عليها
.من تمثال الإلهة

130
00:07:58,290 --> 00:07:59,620
.أحسنوا استخدامه رجاءً

131
00:08:00,330 --> 00:08:02,410
.هذا مبالغ فيه، لا أستطيع قبوله

132
00:08:02,710 --> 00:08:05,630
!أجل، هذا ليس شيئًا تعطيه للآخرين

133
00:08:05,630 --> 00:08:08,090
.كنتُ آمل أن نزداد قوة جميعًا

134
00:08:08,090 --> 00:08:09,000
ماذا؟

135
00:08:09,510 --> 00:08:10,260
.تفضلوا

136
00:08:13,130 --> 00:08:15,640
،حتى لو كان يريد أن نصبح أقوى جميعًا

137
00:08:15,640 --> 00:08:17,720
كوسكي غريب حقًا، صحيح؟

138
00:08:18,390 --> 00:08:19,810
يوكيني-سان؟

139
00:08:24,690 --> 00:08:27,560
،أول شخص أعجز عن تصديق وجوده

140
00:08:27,560 --> 00:08:28,320
.كانت أختي

141
00:08:28,940 --> 00:08:31,400
.حدث ذلك مجددًا بعد التحاقي بالأكاديمية

142
00:08:31,400 --> 00:08:34,150
،التقيتُ هناك الرئيسة مونيكا
،الملقّبة بإلهة الحرب

143
00:08:34,150 --> 00:08:36,570
...والمديرة التي تبدو قواها كأن لا حدود لها

144
00:08:37,410 --> 00:08:41,700
اعتقدتُ أنه لا يوجد شخص آخر
.قادر على أن يفاجئني

145
00:08:42,160 --> 00:08:44,790
.سأستطيع اللحاق بهم يومًا ما

146
00:08:44,790 --> 00:08:46,670
.بذلتُ جهدي مؤمنة بهذا

147
00:08:47,790 --> 00:08:48,290
...لكن

148
00:08:49,340 --> 00:08:53,090
.ثم ظهر تاكيوتو كوسكي وهو أصغر سنًا منّي

149
00:08:55,130 --> 00:08:56,680
،إنه ليس عاديًا

150
00:08:57,510 --> 00:08:59,350
.جسديًا وذهنيًا

151
00:08:59,350 --> 00:09:01,640
لن يكون من الخاطئ مقارنة المانا لديه

152
00:09:02,060 --> 00:09:06,190
التي ترتفع باستمرار بمصدر المانا
."عِرق التنين"

153
00:09:06,650 --> 00:09:11,780
وعندما اكتشفتُ أنه لا يستطيع استخدام
...السحر المنبعث، شعرتُ بالارتياح

154
00:09:13,240 --> 00:09:15,610
.ما زلت أتذكر ذلك اليوم جيدًا

155
00:09:16,530 --> 00:09:18,280
،عندما أتى للحديث عن الأسلحة

156
00:09:18,280 --> 00:09:20,700
.أعطيته كاتانا وراقبته يلوّح به

157
00:09:21,370 --> 00:09:25,660
ربما كانت معاييري مرتفعة
،لأنّي رأيتُ أختي

158
00:09:26,000 --> 00:09:29,000
.لكنّي قلتُ لنفسي أنه لا يملك أيّ موهبة

159
00:09:30,380 --> 00:09:33,960
.لكنه صدمني بعد بضعة أيام

160
00:09:34,720 --> 00:09:39,340
بدى تلويحه بالسيف كأنه كان يتدرب
...منذ سنين

161
00:09:42,510 --> 00:09:46,890
قد يستطيع تعلم إحدى تقنيات
.كيوهاشي-ريو السرية

162
00:09:47,440 --> 00:09:50,770
تلك التقنية التي كانت غريبة جدًا

163
00:09:50,770 --> 00:09:53,110
.ويُقال أن حتى أختي لم تستطع تعلمها

164
00:10:05,370 --> 00:10:06,660
سينباي؟

165
00:10:08,540 --> 00:10:11,210
هل حدث أمر ما؟

166
00:10:12,420 --> 00:10:14,000
لماذا تعتقد هذا؟

167
00:10:14,000 --> 00:10:19,380
.لم تبدُ الناغيناتا خاصتك جميلة كالعادة

168
00:10:20,550 --> 00:10:22,600
...ليست جميلة

169
00:10:22,600 --> 00:10:24,350
أيشغل أمر ما بالك؟

170
00:10:24,350 --> 00:10:26,810
.كنتُ أفكر بأمر ما

171
00:10:27,180 --> 00:10:28,600
.الأمر غريب

172
00:10:28,600 --> 00:10:32,060
،لا يفترض بي أن أخبرك بهذا في العادة

173
00:10:32,060 --> 00:10:34,270
...لكن جزءًا منّي يرغب في فعل ذلك

174
00:10:34,650 --> 00:10:38,650
وأشعر أنّي سأستطيع التوصل
.إلى الإجابة التي كنتُ أبحث عنها

175
00:10:39,030 --> 00:10:41,740
...الإجابة عن مدى القوة التي أستطيع بلوغها

176
00:10:42,370 --> 00:10:46,290
،هناك شخص أعتبره هدفي
.شخص اعتقدتُ أنّي لن أستطيع التغلّب عليه أبدًا

177
00:10:46,950 --> 00:10:49,710
.إنها أختي

178
00:10:50,170 --> 00:10:51,380
،لكنها قالت

179
00:10:51,380 --> 00:10:53,710
.يوكيني، يمكنك أن تصبحي الأفضل في العالم"

180
00:10:54,090 --> 00:10:56,550
".لذا اسعي لتحقيق ذلك بدلًا منّي

181
00:10:56,920 --> 00:10:58,670
...ووعدتها بفعل ذلك

182
00:10:59,130 --> 00:11:02,510
.أعتقد أن بوسعك أن تصبحي الأفضل في العالم

183
00:11:02,510 --> 00:11:04,430
.لكنّي سأعيق طريقك

184
00:11:05,560 --> 00:11:07,680
.أنصت حتى النهاية

185
00:11:07,680 --> 00:11:11,440
،عمومًا، حتى مع مضيّ السنين ونضجي

186
00:11:11,440 --> 00:11:13,610
.بقيت أختي متقدمة عليّ

187
00:11:14,440 --> 00:11:17,150
...مع أنها لم تعد موجودة في هذا العالم

188
00:11:19,070 --> 00:11:20,740
،بما أنهم لم يستطيعوا التحدث عن ذلك في اللعبة

189
00:11:20,740 --> 00:11:22,110
،فأنا لا أعرف التفاصيل

190
00:11:22,110 --> 00:11:24,490
.لكن أختها قد توفيت في مرحلة ما

191
00:11:24,740 --> 00:11:27,990
مع ذلك، واصلتُ التدريب
.وأتيتُ إلى هذه الأكاديمية

192
00:11:27,990 --> 00:11:30,870
،عندما رأيتُ الرئيسة مونيكا والمديرة
.أدركتُ أمرًا ما

193
00:11:32,120 --> 00:11:35,880
.فهمتُ أن الناس يعتمدون عليّ

194
00:11:35,880 --> 00:11:38,760
.وأخبرني بعضهم، مثلك، بذلك مباشرة

195
00:11:39,590 --> 00:11:45,050
لكنّي أتساءل دائمًا إن كنتُ أستطيع
.أن أرقى إلى تلك التطلعات

196
00:11:45,760 --> 00:11:50,890
ظللتُ أسعى إلى أن أصبح أقوى
...مستحضرة كلمات أختي، لكن

197
00:11:51,350 --> 00:11:53,400
...سينباي، إن سمحتِ لي

198
00:11:54,150 --> 00:11:56,360
،ربما هذا الكلام ناتج عن كبريائي

199
00:11:56,820 --> 00:11:59,110
.لذا أودّ أن أسمع ذلك منك مجددًا

200
00:11:59,570 --> 00:12:01,490
هل تريدين أن تصبحي أقوى؟

201
00:12:03,860 --> 00:12:04,990
هل أستطيع فعل ذلك؟

202
00:12:07,330 --> 00:12:09,580
.لنذهب إلى السرداب معًا

203
00:12:13,750 --> 00:12:22,420
[متاهة مطلع النهار]

204
00:12:14,420 --> 00:12:19,420
،تُدعى متاهة مطلع النهار
.لكنها لا تبدو كمتاهة

205
00:12:19,420 --> 00:12:22,420
.إنها متاهة بكل تأكيد

206
00:12:22,800 --> 00:12:25,930
.عليك التغلّب هنا على متاهتك الخاصة

207
00:12:26,430 --> 00:12:28,310
متاهتي الخاصة؟

208
00:12:28,600 --> 00:12:32,350
.وحسب الشخص، يُمكن أن تكون صعبة أو سهلة

209
00:12:33,230 --> 00:12:35,730
.من ناحية ما، يمكنك مواجهة الشخص الأقوى

210
00:12:37,230 --> 00:12:38,860
أليس هذا غريبًا؟

211
00:12:38,860 --> 00:12:43,150
،يمكن دخولها كفريق
.لكن على كل شخص القتال بمفرده

212
00:12:43,530 --> 00:12:45,780
،تقصد أنه يُمكن البدء كفريق

213
00:12:45,780 --> 00:12:49,280
لكن يقاتل كل شخص وحشًا مختلفًا؟

214
00:12:50,580 --> 00:12:52,950
،أجل. إن تغلّبت على الزعيم

215
00:12:52,950 --> 00:12:58,210
.فيمكنك الانضمام إلى أصدقائك ومساعدتهم

216
00:12:58,210 --> 00:13:01,670
.يبدو أن علينا الانفصال هنا

217
00:13:02,050 --> 00:13:03,260
.حسنًا

218
00:13:03,260 --> 00:13:05,930
.سينباي، أريدك أن تتذكري أمرًا ما

219
00:13:05,930 --> 00:13:06,680
ما هو؟

220
00:13:07,010 --> 00:13:09,140
...العدو الذي ستواجهينه هنا

221
00:13:09,140 --> 00:13:11,060
.ليس خصمًا لا يُقهر

222
00:13:11,310 --> 00:13:13,270
.أعلم أن بوسعك الانتصار

223
00:13:13,270 --> 00:13:14,180
أستطيع الانتصار؟

224
00:13:14,640 --> 00:13:18,230
.أجل، لكن قد تفتقرين للثقة بنفسك

225
00:13:18,230 --> 00:13:19,610
.لكنكِ قادرة على الانتصار

226
00:13:20,320 --> 00:13:21,940
!ثقي بي رجاءً

227
00:13:22,150 --> 00:13:23,990
،إن لم تستطيعي وأصابك مكروه ما

228
00:13:23,990 --> 00:13:26,450
.سأعتني بك لبقية حياتي

229
00:13:26,740 --> 00:13:29,830
.لذا لا أمانع أن تتعمّدي الهزيمة

230
00:13:30,910 --> 00:13:33,200
.سأدخل أولًا

231
00:13:48,090 --> 00:13:49,010
من هناك؟

232
00:13:50,220 --> 00:13:51,220
أنا؟

233
00:13:51,850 --> 00:13:52,850
أحمل كاتانا؟

234
00:13:57,060 --> 00:13:58,600
...كيف يُعقل

235
00:13:59,310 --> 00:14:01,900
سوزوني-نيسان؟

236
00:14:03,530 --> 00:14:06,900
،إذًا هذا السرداب مختلف عن البقية

237
00:14:06,900 --> 00:14:09,910
.وهناك وحش لكل شخص

238
00:14:09,910 --> 00:14:12,950
ينتهي بك المطاف بمواجهة الشخص
،الذي تعتقد أنه الأقوى

239
00:14:12,950 --> 00:14:15,540
.أو الشخص الذي سبب لك أكبر صدمة

240
00:14:16,200 --> 00:14:19,960
.ستواجه سينباي أختها على الأرجح

241
00:14:19,960 --> 00:14:21,420
.هذا منطقي

242
00:14:22,500 --> 00:14:25,300
...بالنسبة لي، سيكون هو بالتأكيد

243
00:14:26,510 --> 00:14:27,880
أليس كذلك؟

244
00:14:28,510 --> 00:14:29,550
!يوري

245
00:14:34,600 --> 00:14:36,680
!ها أنا ذا يا يوري

246
00:14:40,440 --> 00:14:42,730
تستخدم السحر أيضًا؟

247
00:14:43,270 --> 00:14:44,610
.أعتقد أن هذا متوقع

248
00:14:44,610 --> 00:14:46,530
،إنه تجسيد للإمكانات

249
00:14:46,530 --> 00:14:48,990
!بطل ماجيكس، هيجيري يوري

250
00:14:49,530 --> 00:14:50,660
ما رأيك بهذا إذًا؟

251
00:14:54,450 --> 00:14:55,330
!رائع

252
00:14:59,620 --> 00:15:02,170
.يملك هيجيري يوري إمكانات لا حدود لها

253
00:15:02,710 --> 00:15:07,420
يستطيع التخصص في الخصائص الجسدية
،ليصبح خبيرًا في القتال القريب

254
00:15:07,420 --> 00:15:11,090
أو التخصص في السحر ليصبح
.خبيرًا في القتال من المدى البعيد

255
00:15:11,720 --> 00:15:13,930
...صحيح أنه قوي، لكن

256
00:15:14,300 --> 00:15:17,560
!هيجيري يوري الذي أعرف ليس بهذا الضعف

257
00:15:17,970 --> 00:15:21,230
هذا صحيح. لا يُعقل أن يكون ضعيفًا
.إلى هذا الحد

258
00:15:21,560 --> 00:15:23,360
،إن أخذنا الإمكانات فقط بعين الاعتبار

259
00:15:23,360 --> 00:15:28,490
الشخص الوحيد القادر على مضاهاته
.في الحصول على التعاويذ هي نانامي

260
00:15:28,740 --> 00:15:29,780
...لكن

261
00:15:29,780 --> 00:15:32,070
!لديّ قوة لا يملكها

262
00:15:32,320 --> 00:15:34,410
.يوري الحقيقيّ أقوى بكثير

263
00:15:34,910 --> 00:15:37,490
!يزداد قوة ثم يقف أمامي

264
00:15:39,160 --> 00:15:42,750
إذًا... هل يمكنني تقبّل الهزيمة ضد هذا؟

265
00:15:42,750 --> 00:15:45,960
،إن أردتُ مواجهة شخص يتفوّق عليه

266
00:15:45,960 --> 00:15:48,050
هل هذا كافٍ؟

267
00:15:48,710 --> 00:15:50,260
!بالطبع لا

268
00:15:54,470 --> 00:15:57,510
!قوة طاغية
!يجب أن يكون نصرًا ساحقًا

269
00:15:57,810 --> 00:15:59,890
!هذا ظل يوري

270
00:15:59,890 --> 00:16:01,350
.هذا ليس يوري

271
00:16:01,350 --> 00:16:04,940
!يوري الذي أستهدفه هو يوري الأقوى

272
00:16:12,240 --> 00:16:13,490
!إنه بطيء حاليًا

273
00:16:13,490 --> 00:16:15,280
!لكنه ثابت

274
00:16:15,280 --> 00:16:17,620
!ذلك هو تطور يوري الحالي

275
00:16:19,580 --> 00:16:22,290
.متأكد أنّي أقوى حاليًا

276
00:16:22,290 --> 00:16:24,540
.أجل، سأكون أقوى لفترة

277
00:16:24,540 --> 00:16:27,710
لكن يوري سيتفوّق عليّ قريبًا
.بوتيرة مذهلة

278
00:16:27,710 --> 00:16:30,260
.سأقع في ورطة إن لم يقم بذلك

279
00:16:30,260 --> 00:16:33,800
ذلك ضروريّ لقيادة جميع البطلات
.إلى النهاية السعيدة

280
00:16:33,800 --> 00:16:36,550
!وأنا بحاجة إلى أن أصبح أقوى كذلك

281
00:16:38,100 --> 00:16:39,220
!الوميض

282
00:16:49,270 --> 00:16:50,980
.لستَ يوري

283
00:16:51,400 --> 00:16:52,990
.سأذهب للقاء سينباي

284
00:16:58,530 --> 00:17:04,000
إحدى أولى أفكاري كانت أنّي
.لا أستطيع الانتصار على أختي سوزوني

285
00:17:04,500 --> 00:17:07,790
،أيًا كان ما فعلناه
.أو مهما كرّرناه، لم أستطع الانتصار

286
00:17:08,210 --> 00:17:11,500
،كنتُ منبهرة بأختي حتى في طفولتي

287
00:17:11,500 --> 00:17:14,720
.وربما كان الفارق العمري أحد الأسباب

288
00:17:15,430 --> 00:17:19,220
لكن اكتشافي أن السبب هي موهبتها
.لم يستغرقني وقتًا طويلًا

289
00:17:19,220 --> 00:17:23,770
عند إذٍ اعتقدتُ أنّي لن أستطيع
.التفوّق عليها أبدًا

290
00:17:24,560 --> 00:17:27,940
،وكما لو كان ذلك لإثبات صحة اعتقادي

291
00:17:27,940 --> 00:17:31,020
.لم أتمكن قطّ من الانتصار عليها

292
00:17:33,610 --> 00:17:35,780
!تبدو هذه كطريقة مبارزتها حقًا

293
00:17:36,530 --> 00:17:37,490
...إذًا... هذا يعني

294
00:17:41,490 --> 00:17:43,620
...كأنها تقرأ أفكاري

295
00:17:46,960 --> 00:17:47,790
ماذا؟

296
00:17:48,250 --> 00:17:51,540
،بزيادة سرعتها فجأة
.صعّبت عليّ القيام بردّ فعل

297
00:17:54,420 --> 00:17:55,760
لم يُصب ذلك؟

298
00:17:56,090 --> 00:17:58,680
.اهدئي. أصيبيها مجددًا

299
00:17:59,050 --> 00:18:03,060
!أجل، هجماتها مشابهة لهجمات أختي

300
00:18:03,600 --> 00:18:05,730
!أعيدي توجيهها... ثم أصيبي

301
00:18:05,930 --> 00:18:06,890
!مجددًا

302
00:18:07,390 --> 00:18:09,600
.أجل، ينتهي الأمر هكذا دائمًا

303
00:18:10,480 --> 00:18:13,570
،مهما بذلتُ من جهد
.تتفوّق عليّ أختي

304
00:18:13,570 --> 00:18:18,490
،ثم هناك الرئيسة مونيكا
.ثم الأكثر تفوّقًا، المديرة

305
00:18:22,200 --> 00:18:24,450
،هناك شيون وفران بجواري

306
00:18:24,910 --> 00:18:27,870
.بينما يطاردني تاكيوتو ولودي

307
00:18:28,710 --> 00:18:32,920
.لكل منهم مواهبه الفريدة

308
00:18:33,960 --> 00:18:37,300
لماذا أخبرتني أختي أن بوسعي
أن أكون الأفضل؟

309
00:18:37,720 --> 00:18:39,260
.لا أفهم ذلك

310
00:18:39,590 --> 00:18:43,220
...لم أدرك أن ناغيناتا بهذا الثقل

311
00:18:43,890 --> 00:18:46,640
...وأن الظلّ يُمكن أن يكون ضخمًا

312
00:18:50,230 --> 00:18:53,440
لم تعد تعتبرني خصمًا يستحقّ المواجهة؟

313
00:18:54,320 --> 00:18:56,690
...هذا صحيح، لا أستحق حاليًا أيّ

314
00:18:56,690 --> 00:18:57,440
!سينباي

315
00:18:59,780 --> 00:19:00,910
!تاكيوتو

316
00:19:02,910 --> 00:19:04,660
!ثقي بي رجاءً

317
00:19:04,660 --> 00:19:06,290
،إن لم تستطيعي وأصابك مكروه

318
00:19:06,290 --> 00:19:08,580
.سأعتني بك لبقية حياتي

319
00:19:09,160 --> 00:19:12,000
.لذا لا أمانع أن تتعمّدي الهزيمة

320
00:19:14,670 --> 00:19:18,760
.كأنه سطر مبتذل من قصة حب

321
00:19:19,420 --> 00:19:20,970
...لكن لماذا

322
00:19:20,970 --> 00:19:23,470
تتدفّق إليّ كل هذه القوة؟

323
00:19:24,680 --> 00:19:29,890
،يوكيني، يناديني الجميع بالعبقرية
.لكنّي بشرية

324
00:19:30,560 --> 00:19:31,730
.وأنت كذلك

325
00:19:32,440 --> 00:19:33,310
...بالفعل

326
00:19:33,770 --> 00:19:34,900
.هذا صحيح

327
00:19:35,320 --> 00:19:37,690
.كانت أختي عبقرية وبشرية

328
00:19:38,400 --> 00:19:41,910
!لكنّي بشرية أيضًا

329
00:19:42,660 --> 00:19:44,280
.نحن بشريتان

330
00:19:44,280 --> 00:19:46,280
.ليس هناك ما يمنعني من التفوّق عليها

331
00:19:46,280 --> 00:19:47,950
.سأريك قوتي الكاملة

332
00:19:48,580 --> 00:19:51,120
.إن فشلت، أطلب من تاكيوتو الاعتناء بي فحسب

333
00:19:51,870 --> 00:19:53,830
.يبدو ذلك في حدّ ذاته ممتعًا

334
00:19:55,000 --> 00:19:56,710
!يا سوزوني-نيسان

335
00:19:56,710 --> 00:20:00,510
.واصلتُ التدريب منذ وفاتك

336
00:20:00,510 --> 00:20:02,300
.صقلتُ قدراتي

337
00:20:02,800 --> 00:20:04,470
.سأريها

338
00:20:04,470 --> 00:20:06,430
.سأري تاكيوتو

339
00:20:06,430 --> 00:20:08,770
.هذا هو الدرب الذي سرتُ عليه

340
00:20:08,770 --> 00:20:10,560
.هذه هي قدراتي

341
00:20:11,390 --> 00:20:15,190
،شاهدي ذاتي الحالية رجاءً
!ميزوموري يوكيني الحالية

342
00:20:19,820 --> 00:20:21,110
تجددت؟

343
00:20:21,610 --> 00:20:23,910
...هذا الظلّ أكثر عنادًا

344
00:20:30,750 --> 00:20:32,250
.جميل جدًا

345
00:20:34,540 --> 00:20:37,250
.تتشارك السيوف والكاتانا والناغيناتا في هذا

346
00:20:37,710 --> 00:20:40,210
.يحمل وميض النصال روحًا

347
00:20:42,720 --> 00:20:43,800
!تنين

348
00:20:43,800 --> 00:20:46,140
!حملت تلك الضربات تنينًا

349
00:20:46,140 --> 00:20:47,260
!تاكيوتو

350
00:20:53,810 --> 00:20:54,770
!هذا هو

351
00:20:54,770 --> 00:20:56,850
!هذا ما أحببته

352
00:20:56,850 --> 00:21:01,150
،إحدى الثلاثة الكبار، أميرة تنين الماء
!ميزوموري يوكيني الماهرة

353
00:21:01,150 --> 00:21:05,240
التقنية السرية التي جعلتها
...بين الثلاثة الكبار في ماجيكس

354
00:21:08,780 --> 00:21:10,240
!التنين ذو التسعة رؤوس

355
00:21:23,800 --> 00:21:26,470
تاكيوتو، هل أطرح عليك هذا السؤال مجددًا؟

356
00:21:26,470 --> 00:21:27,470
أيّ سؤال؟

357
00:21:27,470 --> 00:21:29,510
ماذا تعرف؟

358
00:21:31,510 --> 00:21:33,430
.لا، أعتذر

359
00:21:33,430 --> 00:21:36,480
.لا داعي للاعتذار

360
00:21:37,600 --> 00:21:40,820
.أدرك أن تصرّفاتي مثيرة للشكوك

361
00:21:40,820 --> 00:21:42,150
...هذه المرة أيضًا

362
00:21:42,150 --> 00:21:44,070
.لهذا أريد أن أخبرك

363
00:21:44,650 --> 00:21:46,570
...لكن هلا

364
00:21:46,570 --> 00:21:48,910
هلا تنتظري قليلًا بعد؟

365
00:21:48,910 --> 00:21:50,280
.بالطبع

366
00:21:50,280 --> 00:21:53,080
.أدرك أن هذا ليس أمرًا يسهل الحديث عنه

367
00:21:53,370 --> 00:21:54,080
...لكن

368
00:21:54,080 --> 00:21:57,870
،إن حدث أمر ما
.أريدك أن تأتي إليّ في أيّ وقت

369
00:21:58,290 --> 00:22:00,790
.أريد مساندتك

370
00:22:00,790 --> 00:22:01,840
...سينباي

371
00:22:02,920 --> 00:22:04,960
!لنعد إلى البيت ونتدرب

372
00:22:04,960 --> 00:22:09,970
"الثلاثة الكبار"

373
00:22:04,960 --> 00:22:09,970
ميزوموري يوكيني

374
00:22:05,210 --> 00:22:06,050
!حسنًا