1
00:00:13,280 --> 00:00:16,010
phant0om.wordpress

2
00:00:52,750 --> 00:00:53,690
!أنيت

3
00:00:54,060 --> 00:00:56,720
!أنيت! إن لم تُسرعي سوف تتأخرين

4
00:00:56,810 --> 00:00:57,770
!حاضر

5
00:00:58,860 --> 00:01:00,950
.عمتي! أنا أشعر بالملل

6
00:01:01,080 --> 00:01:02,250
ولماذا هذا؟

7
00:01:02,590 --> 00:01:04,680
.أنا أيضاً أُريد الذهاب للمدرسة

8
00:01:04,930 --> 00:01:07,140
!أُريد أن أذهب لألعب مع الآخرين كذلك

9
00:01:07,400 --> 00:01:10,000
.المدرسة ليست للعب فقط

10
00:01:10,150 --> 00:01:16,830
.بل عليك أن تدرس في المدرسة لتُصبح طفلاً جيداً وذكياً

11
00:01:17,360 --> 00:01:18,080
!وصلت

12
00:01:18,570 --> 00:01:19,520
!أنيت

13
00:01:20,240 --> 00:01:21,520
ما الأمر، عمتي؟

14
00:01:21,910 --> 00:01:23,910
!ما الأمر، عمتي؟" ليس هو الرد المُلائم"

15
00:01:24,120 --> 00:01:25,860
ألا يُمكنُكِ أن تتصرفي كسيدة؟

16
00:01:26,180 --> 00:01:27,570
.آه، نسيت

17
00:01:27,720 --> 00:01:29,010
.سأحاول هذا في المرة القادمة

18
00:01:29,250 --> 00:01:31,330
!لقد تأخرت، أرجو المعذرة

19
00:01:31,590 --> 00:01:33,960
...انتظري، أنيت! لم أنتهِ من الحديث معكِ

20
00:01:33,980 --> 00:01:35,500
!أنا خارجة

21
00:01:36,440 --> 00:01:39,180
عمتي، لماذا أُختي مُستعجلة؟

22
00:01:39,590 --> 00:01:41,510
.لا أعلم. ليست لديَّ أدنى فكرة

23
00:02:00,980 --> 00:02:01,810
...أُستاذ

24
00:02:02,080 --> 00:02:06,610
لِمَ لا نقدم جائزة المعرض للوسيان؟

25
00:02:07,210 --> 00:02:10,200
.كلا، هذا غير مُمكن... فلا يوجد المزيد من الجوائز

26
00:02:10,840 --> 00:02:12,420
.كلا، ليس هذا ما قصدتُهُ

27
00:02:12,900 --> 00:02:17,330
.أُريدُكَ أنتَ أن تُعطي لوسيان جائزة المعرض التي استلمتُها

28
00:02:18,120 --> 00:02:21,000
إذن، تقولين أنَّـكِ ستُعيدين الجائزة؟

29
00:02:21,240 --> 00:02:21,770
.أجل

30
00:02:22,080 --> 00:02:24,890
.فمن يجب أن يحصل عليها، هو لوسيان

31
00:02:25,320 --> 00:02:27,560
!لهذا، أرجوك قُم بهذا

32
00:02:35,160 --> 00:02:36,520
.فهمت، أنيت

33
00:02:37,720 --> 00:02:41,920
.أحضريها لي قبل بدء الدراسة غداً

34
00:02:42,470 --> 00:02:45,210
.وسأُعطيها للوسيان أمام جميع من في الفصل

35
00:02:45,590 --> 00:02:48,780
.و أيضاً سأجعل الجميع يُشاهد المنحوتات التي صنعها لوسيان

36
00:02:49,610 --> 00:02:50,780
!أُستاذ

37
00:02:52,430 --> 00:02:55,530
.هذا رائع، أنيت... فقد صممتِ على فعل هذا

38
00:02:55,770 --> 00:02:58,460
!أُستاذُكِ سعيدٌ لأنكِ تشعرين بهذا الشكل

39
00:03:13,420 --> 00:03:14,040
!آآه

40
00:03:21,010 --> 00:03:23,160
...قبل أن نبدأ الفصل الدراسي الجديد

41
00:03:23,480 --> 00:03:25,780
.لديَّ شيء أُريد عرضه عليكم

42
00:03:26,360 --> 00:03:28,760
هآه؟ ماذا يوجد هناك؟

43
00:03:32,040 --> 00:03:32,660
.هذه

44
00:03:32,740 --> 00:03:33,570
!مُدهش

45
00:03:36,170 --> 00:03:37,080
!هآه

46
00:03:37,290 --> 00:03:38,760
!إنَّها منحوتة خشبية رائعة

47
00:03:38,840 --> 00:03:40,840
أُستاذ؟ لماذا هذه معكَ؟

48
00:03:41,220 --> 00:03:42,720
!اهدؤوا! اهدؤوا

49
00:03:44,100 --> 00:03:48,790
أنتم جميعاً تعلمون قصة سفينة نوح كما في التوراة، أليس كذلك؟

50
00:03:49,090 --> 00:03:52,530
.هذه المنحوتة هي لسفينة نوح

51
00:03:53,570 --> 00:03:56,800
.والحيوانات التي كانت على سفينة نوح نُحتت أيضاً

52
00:03:58,820 --> 00:04:00,670
!هيه! هذا مُدهش

53
00:04:00,850 --> 00:04:03,260
أُستاذ، أتعلم من صنعها؟

54
00:04:03,730 --> 00:04:04,300
هممم؟

55
00:04:05,610 --> 00:04:07,850
.لوسيان هو من نحتها

56
00:04:08,170 --> 00:04:08,880
حقَّـاً؟

57
00:04:08,950 --> 00:04:10,290
!هذا رائعٌ جداً،  لوسيان

58
00:04:10,450 --> 00:04:12,200
لماذا تُخفي هذا عنَّـا؟

59
00:04:12,920 --> 00:04:15,540
...أ-أنا لم أقصد فعلاً أن أُخفيها عنكم

60
00:04:15,640 --> 00:04:17,200
!هدوء! هدوء

61
00:04:18,020 --> 00:04:22,640
.خلال الإجازة، ولحسن حظي فقد رأيتُ هذه

62
00:04:22,930 --> 00:04:24,050
.وقد أُعجبتُ بها

63
00:04:24,820 --> 00:04:27,510
!لهذا، سأمنح جائزةً للوسيان

64
00:04:27,590 --> 00:04:28,360
ماذا؟

65
00:04:29,080 --> 00:04:29,690
!لوسيان

66
00:04:30,960 --> 00:04:31,720
.تعالَ هنا، رجاءً

67
00:04:32,570 --> 00:04:33,100
.حاضر

68
00:04:39,960 --> 00:04:40,650
...والآن، لوسيان

69
00:04:41,030 --> 00:04:41,780
.تفضل هذه

70
00:04:42,090 --> 00:04:42,920
!حـ-حاضر

71
00:05:18,080 --> 00:05:20,320
!أحسنت

72
00:05:24,870 --> 00:05:25,880
...أُستاذ

73
00:05:25,980 --> 00:05:26,500
هممم؟

74
00:05:29,920 --> 00:05:31,400
ماذا هُناك، أنيت؟

75
00:05:31,970 --> 00:05:35,000
.شكراً جزيلاً لما فعلتَهُ مع لوسيان

76
00:05:35,650 --> 00:05:36,470
...كذلك

77
00:05:36,630 --> 00:05:38,160
كذلك؟ ماذا هناك؟

78
00:05:38,690 --> 00:05:44,880
أُستاذ، لماذا لم تخبر الجميع أنِّـي أنا من كسر حصان لوسيان الخشبي؟

79
00:05:45,430 --> 00:05:50,270
.فلن يعلم أحدٌ الآن لماذا حصل لوسيان على الجائزة

80
00:05:51,870 --> 00:05:54,780
.لا حاجة للحديث عن هذا

81
00:05:55,560 --> 00:06:01,750
.بالنسبة لي، فمعرفة أنكِ أنتِ ولوسيان عُدتُما صديقين ثانيةً هي أكثر من كافية

82
00:06:02,830 --> 00:06:05,720
...منحوتات لوسيان الخشبية مُتقنة الصنع بصورةٍ مُذهلة

83
00:06:06,060 --> 00:06:08,890
.بالطبع ستكون سبباً لحصولهِ على جائزة

84
00:06:09,830 --> 00:06:12,070
.والآن، لا تُكثري التفكير في هذا الأمر

85
00:06:12,450 --> 00:06:13,490
.هيَّـا عودي للفصل

86
00:06:14,180 --> 00:06:14,650
.حاضر

87
00:06:19,290 --> 00:06:21,370
.أسرع وافتحها، لوسيان

88
00:06:21,370 --> 00:06:21,910
.حسناً

89
00:06:22,260 --> 00:06:23,750
ماذا يكون في الداخل؟

90
00:06:23,850 --> 00:06:25,330
!هيَّـا، أسرِع

91
00:06:27,930 --> 00:06:28,690
!وااه

92
00:06:29,030 --> 00:06:31,480
!رائع! إنَّهُ مجموعة صور طبيعية للجبال

93
00:06:32,490 --> 00:06:35,730
ماذا؟ أليس هذا كالكتاب الذي حصلت عليه أنيت؟

94
00:06:35,990 --> 00:06:38,380
حقَّـاً؟ أهما مُتشابهان؟

95
00:06:42,380 --> 00:06:43,430
!حقَّـاً

96
00:06:43,650 --> 00:06:45,620
!إن كان نفس كتاب أنيت، فأنا سعيد

97
00:06:47,880 --> 00:06:49,350
!دعني أرى... سأُلقي نظرة

98
00:06:49,640 --> 00:06:51,650
!يا إلهي! أنتَ لئيم! أنا أولاً

99
00:06:52,090 --> 00:06:53,930
!حسناً، وماذا لو! سأُلقي عليه نظرةً قبلكِ

100
00:06:54,010 --> 00:06:55,460
!دعني أرى أيضاً

101
00:06:55,460 --> 00:06:57,330
!هذا يكفي بالنسبة لكَ، أنتون

102
00:07:02,100 --> 00:07:03,650
أنيت، أكُنتِ أنتِ؟

103
00:07:03,920 --> 00:07:05,910
الذي عرض سفينة نوح على الأستاذ؟

104
00:07:06,390 --> 00:07:07,490
.أنا آسفة لوسيان

105
00:07:07,800 --> 00:07:09,960
.لكن، كان عليَّ فعلُها مهما كلف الأمر

106
00:07:10,470 --> 00:07:11,720
.شكراً لكِ، أنيت

107
00:07:12,330 --> 00:07:13,720
.أنا سعيدٌ حقَّـاً

108
00:07:13,930 --> 00:07:15,080
حقَّـاً، لوسيان؟

109
00:07:15,570 --> 00:07:16,090
.أجل

110
00:07:16,480 --> 00:07:17,470
.هذا رائع

111
00:07:17,730 --> 00:07:23,720
.لقد كُنتُ قلقةً أن ينتهي الأمر بكَ غاضباً مني لأي سبب

112
00:07:35,220 --> 00:07:36,350
.أنيت، خُذي

113
00:07:36,650 --> 00:07:37,170
هآ؟

114
00:07:38,580 --> 00:07:40,770
.أنا سعيدٌ لاستلامي تلك الجائزة

115
00:07:41,190 --> 00:07:42,760
.مع ذلك، لا أستطيع أخذ الكتاب

116
00:07:42,880 --> 00:07:43,570
!لوسيان

117
00:07:43,600 --> 00:07:45,300
.حقَّـاً لا أُريد أخذه

118
00:07:45,870 --> 00:07:49,330
.مهما كان السبب، لا أُريد أخذ كتابِكِ

119
00:07:52,290 --> 00:07:54,100
.أفهم مشاعركِ، أنيت

120
00:07:54,430 --> 00:07:55,880
.لكن من الأفضل أن أُعيد الكتاب

121
00:07:56,280 --> 00:07:57,330
.كلا، لوسيان

122
00:07:57,500 --> 00:08:00,120
.يجب عليكَ أن تأخذ الكتاب

123
00:08:00,340 --> 00:08:02,120
.هذا ما قالهُ الأستاذ

124
00:08:02,400 --> 00:08:05,140
.قال أنَّ الكتاب لكَ

125
00:08:05,280 --> 00:08:07,050
.كلا، بل هو كتابُكِ، أنيت

126
00:08:07,340 --> 00:08:09,050
.كلا. بل كتابُكَ، لوسيان

127
00:08:09,290 --> 00:08:10,520
.كلا، بل كتابُكِ

128
00:08:10,930 --> 00:08:12,420
.كلا، بل هو لكَ

129
00:08:12,670 --> 00:08:13,690
إنَّـهُ كتابُكِ

130
00:08:13,850 --> 00:08:14,940
...بل هو

131
00:08:15,450 --> 00:08:16,380
!مزعجة

132
00:08:16,600 --> 00:08:17,730
!عنيد

133
00:08:19,230 --> 00:08:19,730
!همممف

134
00:08:22,950 --> 00:08:23,780
!هممف

135
00:08:35,790 --> 00:08:38,020
.إذن، لِمَ لا نحصل عليه نحنُ الاثنان

136
00:08:38,640 --> 00:08:39,330
الاثنان؟

137
00:08:39,810 --> 00:08:40,330
.أجل

138
00:08:40,680 --> 00:08:43,750
.خُذيه هذا الشهر، وسآخذهُ الشهر القادم

139
00:08:44,000 --> 00:08:46,370
.ثم سيكون دورَكِ، وبعدها دوري

140
00:08:46,570 --> 00:08:47,490
.ونستمر بتكرار هذا

141
00:08:47,850 --> 00:08:48,870
أليست هذه فكرةً جيدة؟

142
00:08:49,320 --> 00:08:52,370
.فكرةٌ جيدة. مادمُت موافقٌ على هذا فلنفعلها

143
00:08:52,610 --> 00:08:55,110
لِمَ لا نسلمهُ  لبعضنا يداً بيد في بداية كل شهر؟

144
00:08:55,650 --> 00:08:56,600
!حسنٌ! لقد تقرر الأمر

145
00:08:57,080 --> 00:08:58,890
.إذن، فهو لكِ هذا الشهر

146
00:09:17,620 --> 00:09:21,260
.آنسة أنيت بورنير، أرجوكِ تفضلي خُذي هذا

147
00:09:21,740 --> 00:09:24,760
.شكراً جزيلاً لكَ، سيد لوسيان موريل

148
00:09:31,850 --> 00:09:36,980
...من الآن فصاعداً، سيتبادلان الكتاب في اليوم

149
00:09:37,330 --> 00:09:40,880
.الأول من كُل شهر في الساعة الخامسة بعد الظهر

150
00:09:41,690 --> 00:09:44,080
...وعندما يتبادلان ذاك الكتاب، فإنَّـهما

151
00:09:44,450 --> 00:09:47,820
.يتشاركانه ويتساعدان ويسامحان بعضهما

152
00:09:48,070 --> 00:09:52,780
.فيشعران بالسعادة بفعلهما هذا

153
00:09:56,690 --> 00:09:59,380
هكذا. شهر في كل مرة، هاه؟

154
00:09:59,990 --> 00:10:01,750
.هذه فكرةٌ جيدة

155
00:10:02,900 --> 00:10:04,870
هل لوسيان من اقترحها؟

156
00:10:04,980 --> 00:10:07,210
.أجل، رغب بذلك بشدة

157
00:10:07,620 --> 00:10:11,570
.أنا سعيدةٌ بكِ، أنيت. فقد صممتِ على فعل كل هذا

158
00:10:12,490 --> 00:10:14,890
.هذه حتماً نعمةٌ أخرى من نِعم الرب علينا

159
00:10:15,320 --> 00:10:21,190
.لابُد أن يسوع المسيح حلَّ في قلبِكِ وقلب لوسيان أيضاً

160
00:10:21,690 --> 00:10:23,400
!أنا حقَّـاً مُمتنةٌ لهذا

161
00:10:25,020 --> 00:10:27,880
...مع ذلك، أنيت... فأهم شيء هو

162
00:10:28,900 --> 00:10:35,080
.عليكِ التفكير بصورة إيجابية والاعتزاز بالمشاعر المتبادلة بينكما

163
00:10:35,910 --> 00:10:39,990
.بهذه الطريقة، يُمكنُكما أنتما الاثنان البقاء كأصدقاء

164
00:10:40,450 --> 00:10:48,680
.لذلك في هذه المرحلة، عليكما أنتما الاثنان ألا تُفكرا بالكراهية، أو الغضب، أو الأنانية

165
00:10:49,030 --> 00:10:55,240
.ولا تنسيا أن تجعلا قلبيكما مملوئين بالصدق والنقاء

166
00:10:55,750 --> 00:10:59,940
.عليكما أن تحميا الحب الأبدي الذي أسبغه يسوع المسيح عليكما

167
00:11:00,680 --> 00:11:03,710
!في المقابل عليكما أن تُبادلاهُ هذا الحب بحبٍ لامحدود

168
00:11:04,280 --> 00:11:06,190
!يجب ألا تنسي هذا

169
00:11:06,620 --> 00:11:07,150
!أجل

170
00:11:25,270 --> 00:11:27,690
.أعتقد أن أحدهم قال لي شيئاً عن هذا

171
00:11:27,850 --> 00:11:30,910
.لا تتفوه بالحماقات. سباق الزلاجات يُقام كُل عام

172
00:11:31,090 --> 00:11:34,130
!لكن، من المفاجئ ألا تجد أحداً يتحدث عنه

173
00:11:34,920 --> 00:11:39,620
!اسمع، لوسيان
.أنتون يقول أنَّ هناك من يحاول جاهداً ليُلغى سباق الزلاجات هذه السنة

174
00:11:39,860 --> 00:11:41,320
ما رأيُكَ؟

175
00:11:41,490 --> 00:11:43,160
.أظنُه سيُقام

176
00:11:43,520 --> 00:11:44,520
!أليس كذلك

177
00:11:44,820 --> 00:11:46,820
وأنتِ، أنيت. ما رأيُكِ؟

178
00:11:47,230 --> 00:11:48,820
.أنا أيضاً، أظنهم سيقيمونه

179
00:11:49,190 --> 00:11:51,660
!فعليّ الفوز هذه السنة

180
00:11:52,140 --> 00:11:55,730
!ما الذي تقولينه؟ أنا هو الذي سيفوز بكل تأكيد

181
00:11:56,000 --> 00:11:58,560
!ماذا؟ چان، أنتَ لا يُمكنُكَ الفوز

182
00:11:58,960 --> 00:11:59,850
ولماذا هذا؟

183
00:12:00,440 --> 00:12:03,730
!لأنَّكَ بدينٌ جداً، لهذا سوف تغوص في الثلج

184
00:12:06,050 --> 00:12:07,800
!تقولين هذا، ماريان

185
00:12:07,820 --> 00:12:09,880
ما المُضحك، لوسيان؟

186
00:12:10,100 --> 00:12:11,380
.آه، أنا آسف

187
00:12:11,480 --> 00:12:12,600
...أيُّها الـ

188
00:12:12,730 --> 00:12:14,810
!اهدؤوا، ليهدأ الجميع

189
00:12:20,210 --> 00:12:21,080
!أُستاذ

190
00:12:21,260 --> 00:12:22,470
هممم؟ ماذا هُناك، چان؟

191
00:12:23,080 --> 00:12:25,550
هل سيقومون بإلغاء سباق الزلاجات هذه السنة؟

192
00:12:25,940 --> 00:12:27,160
.هذا مُستحيل

193
00:12:27,400 --> 00:12:29,860
.إدارة المدرسة لم تسمح لها الفرصة حتى الآن للتخطيط للسباق

194
00:12:30,090 --> 00:12:31,560
.سوف نقرر موعده قريباً

195
00:12:31,870 --> 00:12:34,330
!وعليكم جميعاً التدرب جيداً لصقل مهاراتكم

196
00:12:34,620 --> 00:12:36,160
!رائع

197
00:12:36,980 --> 00:12:38,370
!اهدؤوا! اهدؤوا

198
00:12:39,980 --> 00:12:42,680
.انتهى النقاش حول سباق الزلاجات

199
00:12:43,010 --> 00:12:43,990
.لنبدأ درسنا

200
00:12:44,130 --> 00:12:45,680
حاضر

201
00:12:54,060 --> 00:12:55,240
!هيه، كلاوس

202
00:12:55,450 --> 00:12:57,240
لماذا أسقطت الدلو؟

203
00:12:57,860 --> 00:13:01,730
!بيبر! كلاوس يُزعجني! وبخهُ

204
00:13:17,890 --> 00:13:19,140
!من هنا، أنيت

205
00:13:19,220 --> 00:13:19,860
!حسناً

206
00:13:19,990 --> 00:13:20,890
!من هنا

207
00:13:26,990 --> 00:13:27,560
!انظري

208
00:13:27,870 --> 00:13:29,000
!هذا هو، أنيت

209
00:13:29,300 --> 00:13:31,000
.هذا منزل السيد بيچن

210
00:13:31,390 --> 00:13:33,970
.أرجو ألا نُزعجهُ بزيارتنا المُفاجئة

211
00:13:34,490 --> 00:13:36,190
.لا بأس مادمُتِ أنتِ

212
00:13:36,640 --> 00:13:37,300
.لنذهب

213
00:13:37,600 --> 00:13:38,150
.أجل

214
00:13:43,790 --> 00:13:44,930
!اسمع، كلاوس

215
00:13:45,330 --> 00:13:47,740
!لا تقف في طريق عمل والدي

216
00:13:48,350 --> 00:13:50,710
أبي، متى ستنتهي من عملِكَ؟

217
00:13:50,800 --> 00:13:52,780
.آآه، سيستغرقُ وقتاً طويلاً، داني

218
00:13:53,360 --> 00:13:56,190
.بعد أن أنتهي من هذا، فعليّ أن أُدخل الأبقار للحظيرة

219
00:13:56,470 --> 00:13:58,410
.بعد ذلك، عليَّ أن أنقل الحطب

220
00:13:59,350 --> 00:14:01,370
.هكذا. لديكَ الكثير من العمل

221
00:14:03,190 --> 00:14:04,120
ماذا هناك، داني؟

222
00:14:04,850 --> 00:14:06,920
!أُريد أن أصنع رجل ثلج

223
00:14:07,330 --> 00:14:08,170
رجل ثلج؟

224
00:14:08,540 --> 00:14:09,140
!أجل

225
00:14:09,730 --> 00:14:11,140
!رجلُ ثلج كبيرٌ جداً

226
00:14:11,420 --> 00:14:13,550
!بل حتى أكبر مني

227
00:14:14,210 --> 00:14:16,290
.لكن، لا أستطيع صُنع واحد بنفسي

228
00:14:16,850 --> 00:14:19,750
.فلا أستطيع صنعهُ لأني أستخدم العُكازات

229
00:14:20,210 --> 00:14:23,690
.فكرتُ أن تُساعدني في صُنع واحد ما إن تنتهي من عملِكَ

230
00:14:24,940 --> 00:14:25,830
!حسنأً، داني

231
00:14:26,650 --> 00:14:30,720
.سأنتهي من كل هذه الأعمال بأسرع ما أستطيع قبل أن تعود أنيت للبيت

232
00:14:31,450 --> 00:14:32,650
.وسنقوم جميعاً بصُنعِهِ

233
00:14:33,100 --> 00:14:33,780
حقَّـاً؟

234
00:14:34,120 --> 00:14:34,670
.أجل

235
00:14:35,100 --> 00:14:35,770
!رائع

236
00:14:45,870 --> 00:14:48,070
!أختي أسرعي بالعودة للمنزل

237
00:15:06,060 --> 00:15:06,590
!رائع

238
00:15:08,110 --> 00:15:08,660
!رائع

239
00:15:08,940 --> 00:15:10,250
!أنتما الاثنان رائعان

240
00:15:10,970 --> 00:15:14,780
!فليس بالأمر العادي أن تمتلك العزم على فعل هذا

241
00:15:15,540 --> 00:15:19,630
.فامتلاكُ القوة لتصبر على هذا العمل الشاق فهذا يُثبت مقدار قوتيكما

242
00:15:23,040 --> 00:15:23,630
!لوسيان

243
00:15:24,370 --> 00:15:30,670
أتذكر ماذا قُلت لكَ عن أهم شيء بينما كُنتَ تقوم بالنحت؟

244
00:15:31,030 --> 00:15:31,530
.أجل

245
00:15:31,920 --> 00:15:34,310
".الأشياء التي تراها هي أيضاً إنعكاسٌ لما في قلبِكَ"

246
00:15:34,890 --> 00:15:36,100
.أجل، بالضبط

247
00:15:36,590 --> 00:15:41,860
.ما تراه بعينيك ينعكس أيضاً على قلبِكَ

248
00:15:42,620 --> 00:15:45,450
.عندما تُدرك هذا، فلن يكون هناك حدود لما يُمكنُكَ نحتُهُ

249
00:15:46,010 --> 00:15:48,690
.العلاقة بين الأصدقاء جميلةٌ جداً

250
00:15:49,940 --> 00:15:54,640
.هذه المرة الأولى التي أرى قلبين يتشاركان مشاعرهما ويصفحان عن بعضهما

251
00:15:54,830 --> 00:15:57,930
.فهذا اثبات أن البشر يُمكن أن يكونوا مُخلصين جداً

252
00:15:58,490 --> 00:16:00,740
.أنتما تعيان هذا الأمر تماماً

253
00:16:23,330 --> 00:16:26,570
لقد تأخرتِ. أختي، ما الذي تفعلينه؟

254
00:16:27,190 --> 00:16:29,770
لِمَ لا نذهب لاستقبالها، كلاوس؟

255
00:16:44,730 --> 00:16:47,120
أيُمكنُني القدوم هنا مُجدداً، سيد بيچن؟

256
00:16:47,340 --> 00:16:48,880
.أجل. لا تترددي بالقدوم في أي وقت

257
00:16:49,060 --> 00:16:50,870
.سأنتظرُكِ بشوق

258
00:16:51,260 --> 00:16:51,840
!حاضر

259
00:16:52,070 --> 00:16:53,410
!مع السلامة، سيد بيچن

260
00:16:53,950 --> 00:16:55,410
!مع السلامة، سيدي

261
00:16:56,960 --> 00:16:59,260
!مع السلامة، لوسيان، وأنيت

262
00:17:00,850 --> 00:17:02,640
!إلى اللقاء

263
00:17:03,170 --> 00:17:03,990
!هيَّـا بنا

264
00:17:03,990 --> 00:17:04,510
.أجل

265
00:17:36,830 --> 00:17:39,330
.كان داني مُتعبٌ تماماً

266
00:17:40,030 --> 00:17:50,230
.مع ذلك، فقد كان داني عند كل منعطف يظنُ أنَّهُ سيرى أنيت قادمةً باتجاهِه

267
00:17:55,260 --> 00:17:56,000
!حقَّـاً

268
00:18:03,620 --> 00:18:04,670
.أراكِ لاحقاً، أنيت

269
00:18:04,980 --> 00:18:06,280
.سأذهب للمنزل

270
00:18:06,390 --> 00:18:08,180
.أجل. إلى اللقاء، لوسيان

271
00:18:08,530 --> 00:18:10,330
.لقد كان اليوم مُمتعاً حقَّـاً

272
00:18:10,710 --> 00:18:12,640
.أجل. إلى اللقاء، أنيت

273
00:18:13,410 --> 00:18:14,020
ماذا؟

274
00:18:14,110 --> 00:18:14,580
إيه؟

275
00:18:18,180 --> 00:18:22,090
!داني

276
00:18:23,200 --> 00:18:24,590
!آه! أختي

277
00:18:27,050 --> 00:18:27,720
!داني

278
00:18:28,450 --> 00:18:31,390
!ما الأمر، داني؟ أتيت إلى هنا بنفسِكَ

279
00:18:31,580 --> 00:18:33,750
.أتيت هنا لأحُضركِ للمنزل

280
00:18:34,270 --> 00:18:36,980
.لكن، لم أجدكِ، وأشعر بالتعب

281
00:18:37,850 --> 00:18:39,980
.وأيضاً، فرجلي تؤلمني

282
00:18:40,290 --> 00:18:40,960
ماذا؟

283
00:18:41,140 --> 00:18:43,100
أتؤلمُكَ كثيراً؟ أيَّ واحدة؟

284
00:18:43,630 --> 00:18:45,080
.لا تؤلمُني كثيراً

285
00:18:45,380 --> 00:18:47,490
.إنَّها القدم التي لا أستطيع ثنيها

286
00:18:47,760 --> 00:18:48,590
!يا إلهي

287
00:19:24,480 --> 00:19:28,250
.بقيا صامتين ولم يتحدثا بينما كانا يسيران

288
00:19:28,920 --> 00:19:33,830
.كان الصمت قد ألقى بظلاله على أنيت ولوسيان

289
00:19:34,760 --> 00:19:40,170
.كانا يُفكران أن صداقتهما لن تعالج قدم داني

290
00:19:41,130 --> 00:19:43,820
.كان هذا واقعاً مُحزناً

291
00:19:49,410 --> 00:19:50,220
...لوسيان

292
00:19:50,820 --> 00:19:52,000
ماذا هناك، أنيت؟

293
00:19:52,600 --> 00:19:53,720
لِمَ لا تتحدث؟

294
00:19:54,300 --> 00:19:55,050
.لا شيء

295
00:20:11,200 --> 00:20:12,250
...مع ذلك، أنيت

296
00:20:12,960 --> 00:20:19,510
.عليكما ألا تفكرا أبداً بالكراهية، أو الغضب، أو الأنانية

297
00:20:20,050 --> 00:20:25,870
.ولا تنسيا أن تملآ قلبيكما بالصدق والنقاء

298
00:20:26,560 --> 00:20:31,040
.عليكما أن تحميا الحب الأبدي الذي أسبغه يسوع المسيح عليكما

299
00:20:31,390 --> 00:20:34,510
!في المقابل عليكما أن تُبادلاهُ هذا الحب بحبٍ لامحدود

300
00:20:35,090 --> 00:20:36,930
!عليكما ألا تنسيا هذا

301
00:20:42,530 --> 00:20:44,810
!عليكما أن تُبادلاهُ هذا الحب اللامحدود

302
00:20:45,030 --> 00:20:47,300
!لا تنسيا هذا

303
00:20:48,690 --> 00:20:52,080
!لن أنسى! حتماً لن أنسى

304
00:21:21,160 --> 00:21:23,270
.لوسيان، شكراً لمرافقتنا في العودة للمنزل

305
00:21:23,640 --> 00:21:24,890
.شكراً لكَ، لوسيان

306
00:21:25,140 --> 00:21:28,320
.شعرتُ بالراحة وأنتُ تحملني على ظهرِكَ

307
00:21:28,620 --> 00:21:29,360
.لا بأس

308
00:21:29,700 --> 00:21:32,200
.داني، يُمكننُي حملُكَ على ظهري متى ما أردت

309
00:21:32,930 --> 00:21:33,430
.أجل

310
00:21:35,430 --> 00:21:36,870
!حسنٌ، أنيت! إلى اللقاء

311
00:21:37,400 --> 00:21:38,560
.إلى اللقاء، لوسيان

312
00:21:38,980 --> 00:21:39,620
!إلى اللقاء

313
00:21:49,060 --> 00:21:54,470
".إذا لم تُشفَ قدم داني أبداً، سأقضي بقية حياتي أُكفر عن هذا"

314
00:21:55,210 --> 00:21:57,290
".سأفعلُ أيَّ شيء لأجل داني"

315
00:21:58,030 --> 00:21:59,610
".هذا واجبي"

316
00:22:00,850 --> 00:22:05,750
.هذا ما تعهد به لوسيان لنفسِهِ في أعماق قلبه

317
00:22:41,620 --> 00:22:44,550
!داني كان في سباق الزلاجات

318
00:22:44,780 --> 00:22:50,460
!الجمهور كانوا يشجعون داني عندما صعد على الزلاجة التي صنعها لوسيان

319
00:22:51,130 --> 00:22:52,830
..."الحلقة القادمة من "عزيزتي أنيت

320
00:22:54,510 --> 00:22:55,380
تابعونا