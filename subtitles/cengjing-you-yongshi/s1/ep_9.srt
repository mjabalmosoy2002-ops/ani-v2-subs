1
00:00:22,850 --> 00:00:25,300
حفلة عيد ميلاد دينو الأولى

2
00:00:25,470 --> 00:00:28,870
كلّ شيء جاهز. كلّ شيء مثاليّ

3
00:00:29,040 --> 00:00:31,350
...لافي، ثمّة شيء واحد مفقود

4
00:00:32,330 --> 00:00:35,270
يبدو أنّه لم يأتِ أيّ ضيف

5
00:00:37,440 --> 00:00:39,120
سيأتون، صحيح؟

6
00:00:39,290 --> 00:00:41,430
وعدَ الجميع بأن يأتوا

7
00:00:41,830 --> 00:00:43,040
...لكن

8
00:00:43,210 --> 00:00:44,770
...طقس اليوم

9
00:00:50,580 --> 00:00:52,890
أليس من الخطير صعود الجبل؟

10
00:00:53,060 --> 00:00:54,660
،تماماً. في ظلّ هذه الأمطار الغزيرة

11
00:00:54,830 --> 00:00:56,490
لا يمكن استخدام سحر الانتقال الآنيّ

12
00:00:56,660 --> 00:00:59,430
ولا بُدّ أنّ الطّريق الجبليّ قد غُسِل
بواسطة الانهيارات الوحليّة

13
00:01:02,560 --> 00:01:04,240
...لماذا

14
00:01:04,410 --> 00:01:06,980
لماذا يجب أن يكون ذلك اليوم؟

15
00:01:08,300 --> 00:01:11,080
،ما دمنا نقضي وقتاً مُمتعاً مع دينو

16
00:01:11,250 --> 00:01:13,810
فلا يهمّ حتّى لو لم يأتِ الضّيوف

17
00:01:14,590 --> 00:01:17,220
،هذه حفلة عيد ميلاد دينو الأولى
كيف يقولون أنّه غير مُهمّ؟

18
00:01:17,760 --> 00:01:20,240
يجب أن نمنح دينو حفلة عيد
ميلاد أُولى مثاليّة

19
00:01:22,370 --> 00:01:24,310
حفلة عيد ميلاد أولى مثاليّة

20
00:01:27,330 --> 00:01:29,410
حفلة عيد ميلاد أولى مثاليّة

21
00:02:55,350 --> 00:02:57,680
الحلقة 9: حفلة عيد ميلاد أولى مثاليّة

22
00:03:06,120 --> 00:03:07,120
،يا إلهي

23
00:03:07,660 --> 00:03:09,520
فَسُدَتْ حفلة عيد ميلاد دينو الأولى

24
00:03:12,620 --> 00:03:13,990
آي، فير

25
00:03:14,160 --> 00:03:15,330
ضعا كلّ شيء جانباً

26
00:03:15,500 --> 00:03:16,620
نضع جانباً؟

27
00:03:16,790 --> 00:03:17,950
لم تبدأ الحفلة بعد

28
00:03:18,120 --> 00:03:19,120
لِمَ نضع كلّ شيء جانباً؟

29
00:03:20,210 --> 00:03:21,370
ألا ترى؟

30
00:03:21,540 --> 00:03:22,870
ليس لدينا أيّ ضيف

31
00:03:23,040 --> 00:03:24,350
ما الفائدة من كلّ هذا؟

32
00:03:25,200 --> 00:03:26,530
وهل الضّيوف مُهمّون إلى هذا الحدّ؟

33
00:03:26,700 --> 00:03:27,780
،بالطّبع. أنت تعتقد ذلك

34
00:03:27,950 --> 00:03:30,390
لأنّك لم تفكّر في مُستقبل دينو إطلاقاً

35
00:03:30,560 --> 00:03:31,720
عمّاذا تتكلّمين؟

36
00:03:32,590 --> 00:03:33,590
...دينو

37
00:03:35,140 --> 00:03:36,160
مهلاً، مهلاً

38
00:03:36,330 --> 00:03:37,740
لا تبكِ يا دينو الصّغير

39
00:03:37,910 --> 00:03:40,780
أبوك وأمّك كانا يناقشان شيئاً

40
00:03:40,950 --> 00:03:43,220
لا مزيد من الدّموع الآن

41
00:03:51,620 --> 00:03:52,640
،المعذرة

42
00:03:53,450 --> 00:03:56,500
هل تُقام حفلة عيد ميلاد دينو
الأولى في هذا المكان؟

43
00:03:58,100 --> 00:03:59,180
رئيس النّقابة؟

44
00:03:59,350 --> 00:04:01,700
أنا مُتفاجئ من مجيء شخص
في هذا الطّقس

45
00:04:02,720 --> 00:04:05,530
وحتّى أنّه أتى بسحر الانتقال الآنيّ

46
00:04:05,700 --> 00:04:06,890
هذا محفوف بالمخاطر

47
00:04:08,100 --> 00:04:09,570
سهل للغاية

48
00:04:09,740 --> 00:04:13,140
في نهاية المطاف، أنا السّاحر الأفضل في نقابتنا

49
00:04:15,370 --> 00:04:16,780
،وسط هذه الأمطار الغزيرة

50
00:04:16,950 --> 00:04:20,330
الانتقال بسحر الانتقال الآنيّ
سيكون خطيراً

51
00:04:22,820 --> 00:04:24,360
ربّما لا ينبغي أن أذهب

52
00:04:33,330 --> 00:04:34,330
ما الّذي يجري؟

53
00:04:35,180 --> 00:04:36,220
!إصابة خاطئة

54
00:04:47,750 --> 00:04:49,390
...هذه

55
00:04:51,990 --> 00:04:53,000
ما الأمر؟

56
00:04:55,730 --> 00:04:57,080
،مهما كان الأمر خطيراً

57
00:04:57,250 --> 00:04:59,120
يجب عليّ قطعاً حضور دعوة

58
00:04:59,290 --> 00:05:01,470
إلى حفلة عيد ميلاد أولى هامّة كهذه

59
00:05:01,970 --> 00:05:03,960
لحسن الحظّ، استخدمتُ سحر الإصلاح

60
00:05:04,130 --> 00:05:06,490
لمُعالجة لفيفة الانتقال الآنيّ تلك

61
00:05:06,660 --> 00:05:08,770
المعذرة يا رئيس النّقابة، اجلس هنا

62
00:05:11,310 --> 00:05:12,780
ينبغي أن ترتاح قليلاً

63
00:05:12,950 --> 00:05:15,120
لا نعلم ما إن كان سيأتي ضيوف آخرون

64
00:05:15,290 --> 00:05:17,580
لافي، يبدو أنّكِ على وشك أن
تصبحي مشغولة

65
00:05:18,430 --> 00:05:20,940
لافي، وصلنا

66
00:05:24,310 --> 00:05:25,830
هذا دينو إذاً؟

67
00:05:26,000 --> 00:05:27,870
إنّه صغير جدّاً

68
00:05:28,040 --> 00:05:29,800
هل يمكنني مُعانقته؟

69
00:05:29,970 --> 00:05:31,730
هذه وقاحة منك

70
00:05:31,900 --> 00:05:33,240
،في الواقع، نحن الوقحون

71
00:05:33,410 --> 00:05:35,710
لأنّنا جعلناكم تُسافرون كلّ هذه المسافة
عبر طُرُق جبليّة خطيرة

72
00:05:35,880 --> 00:05:36,990
خطيرة؟

73
00:05:37,160 --> 00:05:39,080
الطّريق الإسمنتيّ على طول الطّريق
الجبليّ راسخ تماماً

74
00:05:39,280 --> 00:05:40,370
...طـ

75
00:05:40,540 --> 00:05:41,910
طريق إسمنتي؟

76
00:05:44,560 --> 00:05:46,350
هذا طريق شُيّد حديثاً

77
00:05:46,520 --> 00:05:47,910
يبدو أنّ مملكتنا، مملكة يوديلاند

78
00:05:48,080 --> 00:05:50,970
تبذل قصارى جهدها للحفاظ
على سلامة شعبنا

79
00:05:56,560 --> 00:06:00,500
يبدو هذا الشّخص مُدهشاً حقّاً

80
00:06:02,410 --> 00:06:06,450
،في وقت لاحق، لا أدري كيف فعلوا ذلك

81
00:06:06,620 --> 00:06:09,490
لكن لا يبدو أنّ الضّيوف مستائين
من العاصفة إطلاقاً

82
00:06:09,660 --> 00:06:10,930
جميعهم وصلوا إلى هنا

83
00:06:11,100 --> 00:06:14,270
!بصحّتكم

84
00:06:15,110 --> 00:06:16,950
!وحتّى أنّهم أعدّوا أسياخَ لحم

85
00:06:17,120 --> 00:06:19,060
لافي، هل لديك مزيد من البيرة؟

86
00:06:20,000 --> 00:06:21,890
تبدو هذه كحفلة عيد ميلاد أولى مثاليّة

87
00:06:22,060 --> 00:06:25,180
فير، آي، اذهبا وكرّما الضّيوف

88
00:06:25,350 --> 00:06:27,350
عُلِم يا سيّدة لافي

89
00:06:38,400 --> 00:06:40,430
من كان يتوقّع أن نُقدّم كلّ هذه
!الكمّية من البيرة

90
00:06:42,260 --> 00:06:45,200
هذا الرّجل الطّويل المهيب الّذي
،تحوم حوله هالة من النّزاهة

91
00:06:45,370 --> 00:06:47,530
لا بُدّ أنّه زوج لافي، صحيح؟

92
00:06:47,700 --> 00:06:48,970
لا

93
00:06:49,370 --> 00:06:50,430
ليس كذلك؟

94
00:06:50,600 --> 00:06:55,580
...إذاً هذا الرّجل المُثقّف الوسيم جدّاً هو

95
00:06:55,750 --> 00:06:57,640
رئيس النّقابة، ليس هو أيضاً

96
00:06:58,160 --> 00:06:59,370
ولا هو أيضاً؟

97
00:07:00,550 --> 00:07:01,720
...هل يُعقَل أنّه

98
00:07:02,840 --> 00:07:04,660
ربّما ينبغي أن أعرّف عنهم

99
00:07:04,830 --> 00:07:05,870
،هذا آي

100
00:07:06,040 --> 00:07:08,490
كان يُساعدني منذ ولادة دينو

101
00:07:08,660 --> 00:07:09,890
إنّه مُربِّي دينو

102
00:07:10,760 --> 00:07:11,910
،وهذا فير

103
00:07:12,080 --> 00:07:13,280
كان ساحراً

104
00:07:13,450 --> 00:07:15,030
،والآن هو خارج الخدمة

105
00:07:15,200 --> 00:07:17,640
إنّه يُقيم معي لبعض الوقت
ويُساعدني في التّنظيف

106
00:07:18,530 --> 00:07:20,540
هكذا إذاً

107
00:07:22,220 --> 00:07:23,240
اقتربت فترة الظّهر

108
00:07:23,410 --> 00:07:24,770
لنبدأ بمراسم زوازو

109
00:07:29,480 --> 00:07:31,730
آي، ماذا تريد من دينو أن يُمسك؟

110
00:07:31,900 --> 00:07:33,410
السّيف المُقدّس بالطّبع

111
00:07:33,580 --> 00:07:34,960
لكن لا مانع من أشياء أُخرى

112
00:07:35,130 --> 00:07:37,370
إنّها مُجرّد خدع حفلات أطفال

113
00:07:37,540 --> 00:07:39,060
هذا لا يُقرّر شيئاً

114
00:07:45,920 --> 00:07:49,080
لافي، ألا تشعر بأنّ هناك ما هو مفقود؟

115
00:07:49,250 --> 00:07:50,250
أجل

116
00:07:51,280 --> 00:07:52,580
هل من شيء مفقود؟

117
00:07:52,750 --> 00:07:54,840
بهذا، ستكون الأمور بخير

118
00:07:55,870 --> 00:07:57,970
...هذه

119
00:07:59,910 --> 00:08:02,030
هذا العالم مليء بالمخاطر الكامنة

120
00:08:02,200 --> 00:08:05,850
يجب أن تتمتّع بقوّة كبيرة
وتمرّ بأوقات عصيبة

121
00:08:06,020 --> 00:08:08,990
لافي، ألا تريدين من دينو أن يصبح
رجلاً قويّاً مفتول العضلات

122
00:08:09,160 --> 00:08:11,660
يحترمه الجميع؟

123
00:08:12,940 --> 00:08:15,010
رجل مفتول العضلات

124
00:08:17,330 --> 00:08:18,390
سخيف

125
00:08:18,560 --> 00:08:21,430
ينبغي أن يصبح دينو رجلاً ثريّاً

126
00:08:21,750 --> 00:08:22,830
،إذا كان لديك المال

127
00:08:23,000 --> 00:08:25,910
فستجد الكثير من النّاس المُؤهّلين لمُساعدتك

128
00:08:26,080 --> 00:08:27,720
،بوسعك الحصول على سكن فاخر

129
00:08:27,890 --> 00:08:29,120
،وأشهى المأكولات بلا حدود

130
00:08:29,290 --> 00:08:31,300
وخدم مُتيقّظين تحت أمرك

131
00:08:33,720 --> 00:08:35,910
الأمر ليس كذلك. هذا مُبالغ به

132
00:08:36,080 --> 00:08:38,210
،لافي، ينبغي أن يصبح دينو مُنجّماً

133
00:08:38,380 --> 00:08:39,410
،يتنبّأ بالمُستقبل

134
00:08:39,580 --> 00:08:41,880
ويصبح سيّد حياته بسهولة

135
00:08:42,050 --> 00:08:43,080
،في هذه الحالة

136
00:08:43,250 --> 00:08:44,950
،فليست الثّروة والشّهرة فقط

137
00:08:45,120 --> 00:08:47,240
لكن أيضاً العمر المديد والسّلامة

138
00:08:48,160 --> 00:08:50,520
العمر المديد والسّلامة

139
00:08:54,660 --> 00:08:56,430
هل لافي بخير؟

140
00:08:56,600 --> 00:08:58,510
حان وقت مراسم زوازو

141
00:09:01,370 --> 00:09:03,320
جميعها تبدو رائعة، ماذا سيختار؟

142
00:09:03,490 --> 00:09:04,490
القطعة النّقديّة النّحاسيّة

143
00:09:04,660 --> 00:09:05,740
الدّمبل

144
00:09:05,910 --> 00:09:06,920
البوصلة

145
00:09:07,090 --> 00:09:10,380
اختر الآن

146
00:09:11,550 --> 00:09:13,140
الطّفل يبكي

147
00:09:13,590 --> 00:09:15,520
دينو، أنا آسفة جدّاً

148
00:09:15,690 --> 00:09:17,490
مهلاً، مهلاً يا دينو، لا تبكِ

149
00:09:17,660 --> 00:09:19,830
قُم بزوازو أوّلاً. فالأمر مُتعلّق بمُستقبلك

150
00:09:20,000 --> 00:09:21,500
لنكتفِ بهذا القدر اليوم

151
00:09:37,210 --> 00:09:38,500
دينو

152
00:09:48,930 --> 00:09:51,870
من المُرهِق حقّاً الحفاظ على
الهيئة البشريّة

153
00:09:52,040 --> 00:09:53,430
أثناء استخدام الشّبكة الواقية من المطر

154
00:09:55,120 --> 00:09:57,430
لِمَ يحاول البشر دوماً

155
00:09:57,600 --> 00:09:59,220
فرض إرادتهم على الآخرين؟

156
00:09:59,680 --> 00:10:01,080
لا تتّخذ الأمر من ناحية شخصيّة

157
00:10:01,250 --> 00:10:02,810
هكذا هو طبع البشر

158
00:10:03,220 --> 00:10:06,770
لكن طريقتهم في التّعامل مع دينو أزعجتني

159
00:10:09,120 --> 00:10:11,120
ينبغي أن تتقبّل الحقيقة

160
00:10:11,610 --> 00:10:14,390
للوهلة الأولى، حفلة عيد الميلاد الأولى
تحتفي بولادة طفل

161
00:10:15,750 --> 00:10:18,580
لكن عمليّاً، غالباً ما تصبح حفلة للبالغين

162
00:10:20,400 --> 00:10:22,980
مثلما هي الجنازة بالنّسبة للأحياء

163
00:10:24,150 --> 00:10:25,220
...حـ

164
00:10:25,390 --> 00:10:26,640
حقّاً؟

165
00:10:32,380 --> 00:10:33,760
،لكن مهما حدث

166
00:10:33,930 --> 00:10:35,830
يبقى عيد ميلاد الطّفل

167
00:10:36,000 --> 00:10:38,220
كيف لك أن تقول بأنّه مُخصّص للبالغين؟

168
00:10:39,680 --> 00:10:42,150
قد يكون من الصّعب أن تفهم
مخلوقات مثلك هذا

169
00:10:42,420 --> 00:10:43,490
سنُغادر الآن

170
00:10:43,660 --> 00:10:44,720
!بالتّوفيق

171
00:10:44,890 --> 00:10:47,430
يعتمد البشر على الدّعم المُتبادل
للحفاظ على أرواحهم

172
00:10:47,600 --> 00:10:50,580
إذا أردت حقّاً تدريب دينو
،على أن يصبح مُحارباً

173
00:10:51,910 --> 00:10:55,930
فيجب عليك أن تتعلّم فهم البشر أوّلاً

174
00:10:56,100 --> 00:10:57,490
حفلة عيد ميلاد دينو الأولى

175
00:11:00,540 --> 00:11:02,660
نحن آسفون. هذه غلطتنا

176
00:11:02,830 --> 00:11:04,030
بدا دينو خائفاً جدّاً

177
00:11:04,200 --> 00:11:05,830
لا، أبداً

178
00:11:06,000 --> 00:11:07,090
أنا من ينبغي أن أشكركم

179
00:11:07,260 --> 00:11:09,510
قطعتُم كلّ هذه المسافة لحضور
حفلة عيد الميلاد الأولى لدينو

180
00:11:10,240 --> 00:11:11,700
أنا مُطمئنّة إذاً

181
00:11:11,870 --> 00:11:13,060
سوف نغادر الآن

182
00:11:13,230 --> 00:11:14,530
شكراً على ضيافتكم

183
00:11:14,700 --> 00:11:16,310
...إذاً ينبغي لي أيضاً

184
00:11:20,120 --> 00:11:21,830
على أيّ حال، شكراً على استضافتنا

185
00:11:22,000 --> 00:11:23,360
لافي، سأغادر أوّلاً

186
00:11:23,660 --> 00:11:24,740
ألقاكِ لاحقاً

187
00:11:24,910 --> 00:11:26,660
وداعاً

188
00:11:43,370 --> 00:11:45,720
شكراً لكِ على جمعهم كلّهم هنا

189
00:11:47,660 --> 00:11:49,300
لكن مع ذلك أخطأت

190
00:11:50,750 --> 00:11:52,680
لستُ أُمّاً جيّدة

191
00:12:01,580 --> 00:12:03,440
أحياناً، نرتكب أخطاء

192
00:12:03,610 --> 00:12:05,660
لأنّنا نحاول جاهدين تصحيح الأمور

193
00:12:05,830 --> 00:12:07,560
لدرجة أنّنا لا نعود نرى ما هو مُهمّ

194
00:12:08,830 --> 00:12:12,080
غالباً ما نمنح ما نعتقد بأنّه الأفضل

195
00:12:12,250 --> 00:12:14,240
،للأشخاص الّذين نُحبّهم

196
00:12:14,720 --> 00:12:17,340
لكن كثيراً ما نغفل عن أمانيهم الحقيقيّة

197
00:12:17,510 --> 00:12:19,930
من الطّبيعيّ جدّاً عدم فعل الأمر
بشكل صحيح في المرّة الأولى

198
00:12:20,100 --> 00:12:22,200
،هكذا هو الأمر بالنّسبة للأطفال

199
00:12:22,370 --> 00:12:25,300
وبالنّسبة للآباء أيضاً

200
00:12:27,020 --> 00:12:31,270
الأمّ الّتي تُحبّ طفلها يجب أن
تكون أُمّاً جيّدة

201
00:12:32,200 --> 00:12:35,680
أعتقد بأنّ ضيوف اليوم راودهم نفس الشّعور

202
00:12:36,000 --> 00:12:41,100
لهذا السّبب خصّصوا وقتاً للمجيء
إلى هنا بالرّغم من العاصفة

203
00:12:42,200 --> 00:12:43,350
حقّاً؟

204
00:12:43,520 --> 00:12:44,880
أجل

205
00:12:46,160 --> 00:12:48,420
أنتِ تبلين بلاء حسناً

206
00:12:55,400 --> 00:12:56,970
ما زلتُ لا أفهم

207
00:12:57,140 --> 00:13:00,080
البشر مُعقَّدون

208
00:13:00,250 --> 00:13:03,920
...لكن يا آي، أعتقد بأنّك بالفعل

209
00:13:06,680 --> 00:13:07,680
آي

210
00:13:08,340 --> 00:13:09,540
لنتكلّم

211
00:13:18,000 --> 00:13:19,120
...ا-المعذرة

212
00:13:19,290 --> 00:13:22,200
...لافي، بخصوص اليوم، أنا

213
00:13:22,370 --> 00:13:23,800
كانت غلطتي

214
00:13:24,270 --> 00:13:25,740
أنت مُحقّ

215
00:13:27,750 --> 00:13:29,240
لقد أعماني الجشع هناك

216
00:13:29,410 --> 00:13:31,100
لم أفكّر في مشاعر دينو

217
00:13:32,570 --> 00:13:35,850
ولم يسعني سوى مُقارنة نفسي بك
عندما كان الأمر يتعلّق بدينو

218
00:13:36,460 --> 00:13:37,990
كنتُ عديمة الصّبر

219
00:13:38,160 --> 00:13:39,430
أنا آسفة

220
00:13:40,400 --> 00:13:41,870
أنا مُحقّ؟ مُحقّ، صحيح؟

221
00:13:42,040 --> 00:13:43,970
فهمتِ الأمر أخيراً

222
00:13:46,000 --> 00:13:48,010
لا، الأمر ليس كذلك

223
00:13:50,120 --> 00:13:54,520
لا، لم أفكّر أبداً بما يعنيه
عيد الميلاد الأوّل للبشر

224
00:13:54,910 --> 00:13:56,480
،وفي يوم حافل كهذا

225
00:13:56,650 --> 00:13:58,130
عكّرتُ الأجواء

226
00:13:59,200 --> 00:14:00,370
أنا آسف

227
00:14:00,540 --> 00:14:01,710
هذه غلطتي

228
00:14:02,800 --> 00:14:04,330
لا، هذه غلطتي

229
00:14:04,500 --> 00:14:06,470
لا تعتذر لي أيّها المُغفَل

230
00:14:07,250 --> 00:14:08,490
قلتُ بالفعل بأنّها كانت غلطتي

231
00:14:08,660 --> 00:14:09,730
من تعتقدين نفسكِ؟

232
00:14:09,900 --> 00:14:11,100
ما الّذي يمنحكِ الحقّ للتسلّط عليّ؟

233
00:14:11,270 --> 00:14:13,570
كفاك عِناداً أيّها التنّين ذو الرّأس القاسي

234
00:14:13,740 --> 00:14:14,750
ماذا؟

235
00:14:14,920 --> 00:14:16,530
أيّتها السّاحرة البشريّة الوضيعة

236
00:14:16,700 --> 00:14:18,070
ماذا قلت؟

237
00:14:18,240 --> 00:14:20,470
أيّها السّحليّة المُصابة بفرط نموّ

238
00:14:31,950 --> 00:14:33,400
أنا آسفة يا دينو

239
00:14:33,570 --> 00:14:34,980
هذه غلطتي

240
00:14:35,430 --> 00:14:38,000
لم ألحظ بأنّك خائف حتّى

241
00:14:39,790 --> 00:14:41,760
أصبح دينو ثقيلاً جدّاً الفعل

242
00:14:42,910 --> 00:14:44,040
...ما

243
00:14:44,570 --> 00:14:45,740
دينو، ماذا قلت؟

244
00:14:45,910 --> 00:14:46,910
هل يمكنك قولها ثانية؟

245
00:14:47,150 --> 00:14:48,180
...ما

246
00:14:48,350 --> 00:14:49,700
ماما

247
00:14:54,500 --> 00:14:56,620
آي، هل سمعت ذلك؟

248
00:14:56,790 --> 00:14:58,700
"قال دينو للتو "ماما

249
00:14:58,870 --> 00:15:00,370
!"ليس "بابا"، لكن "ماما

250
00:15:00,540 --> 00:15:01,860
ربحت

251
00:15:02,410 --> 00:15:04,870
الرّوابط العائلية أمتن بالفعل

252
00:15:05,040 --> 00:15:06,160
أنت فتى طيّب يا دينو

253
00:15:06,330 --> 00:15:08,370
تُفضّلني، أليس كذلك؟

254
00:15:08,540 --> 00:15:09,720
ماما

255
00:15:10,770 --> 00:15:12,950
،دينو، بعد كلّ هذا الوقت معي

256
00:15:13,120 --> 00:15:15,260
ما زلت تُفضّل ماما؟

257
00:15:15,870 --> 00:15:17,590
بابا خائب تماماً

258
00:15:17,760 --> 00:15:19,970
ينبغي أن تبقى مع أمّك إذاً

259
00:15:28,540 --> 00:15:32,520
يبدو أنّ آي يعرف بالفعل كيف
يتعامل مع النّاس

260
00:15:34,840 --> 00:15:35,850
هيّا يا دينو

261
00:15:36,020 --> 00:15:37,020
،ركّز معي

262
00:15:37,290 --> 00:15:38,920
بابا

263
00:15:40,270 --> 00:15:42,230
...بوبو

264
00:15:42,400 --> 00:15:44,200
لا، حاول معي ثانية

265
00:15:44,370 --> 00:15:45,370
...با

266
00:15:47,250 --> 00:15:48,760
لنبدأ بهذا

267
00:15:49,580 --> 00:15:53,630
ماما

268
00:15:54,450 --> 00:15:57,710
لكن يتعلّم عن البشر بسرعة

269
00:15:58,960 --> 00:16:02,820
أخبريني، هل هذا جيّد أم سيّئ لمهمّتنا؟

270
00:16:03,410 --> 00:16:05,390
،أيّها الهيكل العظميّ

271
00:16:05,560 --> 00:16:07,670
لنُنظّف هذه الموائد

272
00:16:07,840 --> 00:16:09,390
قادم

273
00:16:10,020 --> 00:16:11,450
،بالمناسبة يا جدّة هيلغا

274
00:16:11,620 --> 00:16:12,840
هل أنتِ متأكّدة بأنّكِ لا تريدين أن تكوني مُحاربة؟

275
00:16:13,010 --> 00:16:14,100
لا

276
00:16:14,270 --> 00:16:15,910
،سأغسل هذه الصّحون

277
00:16:16,080 --> 00:16:17,750
فكّري في الأمر رجاء