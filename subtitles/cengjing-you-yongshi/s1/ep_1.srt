!لا تنسَ بصمة الأصابع

212
00:11:25,010 --> 00:11:26,480
أيّ بلادة هذه؟

213
00:11:26,600 --> 00:11:28,810
لا يملك ذرّة خبرة

214
00:11:29,060 --> 00:11:31,600
الفارق بيننا شاسع

215
00:11:31,980 --> 00:11:32,810
ماذا؟

216
00:11:32,810 --> 00:11:35,100
ما هذا؟

217
00:11:35,480 --> 00:11:38,310
آسفة، هذا عقد وحش مُستدعى

218
00:11:38,940 --> 00:11:39,730
وحش مُستدعى؟

219
00:11:40,560 --> 00:11:42,310
!خدعتِني

220
00:11:42,320 --> 00:11:43,560
كيف أمكنك القول بأنّني خدعتك؟

221
00:11:43,700 --> 00:11:45,190
،العقد هو مُجرّد إجراء وقائيّ

222
00:11:45,670 --> 00:11:47,300
ويوضّح تماماً

223
00:11:47,300 --> 00:11:48,810
بأنّه يُسمَح لك بتربية الطّفل

224
00:11:49,810 --> 00:11:51,480
تربية الطّفل

225
00:11:51,810 --> 00:11:52,810
...لكن

226
00:11:52,810 --> 00:11:53,980
،لن يكون عليك فعلها بمفردك

227
00:11:54,400 --> 00:11:55,440
سأكون معك

228
00:11:56,480 --> 00:11:58,980
،حسناً، ما دمتُ أستطيع تربية الطّفل
فلا مانع

229
00:11:59,600 --> 00:12:00,600
المُحارب الصّغير

230
00:12:00,600 --> 00:12:02,310
سيزداد قوّة

231
00:12:02,690 --> 00:12:03,810
ويصبح مُحارباً عظيماً

232
00:12:04,440 --> 00:12:06,440
تحت توجيهي المُناسب

233
00:12:07,190 --> 00:12:08,310
...ثمّ

234
00:12:09,440 --> 00:12:10,440
حسناً

235
00:12:10,440 --> 00:12:11,810
المهمّ أنّني أستطيع تربية الطّفل

236
00:12:12,570 --> 00:12:14,600
سأدع هذا الطّفل حتماً

237
00:12:15,060 --> 00:12:15,940
...يصبح

238
00:12:15,940 --> 00:12:17,270
!آي

239
00:12:16,020 --> 00:12:18,820
...بعد عام

240
00:12:21,650 --> 00:12:23,940
ما زال صغيراً حقّاً في الشّهر الحادي عشر

241
00:12:24,030 --> 00:12:25,270
،أسنانه ليست حادّة بعد

242
00:12:25,270 --> 00:12:26,650
ولم تظهر له مخالب أيضاً

243
00:12:27,210 --> 00:12:28,770
هل أُطعمه بما يكفي؟

244
00:12:28,940 --> 00:12:30,310
غيّر حفّاضة دينو الآن

245
00:12:31,150 --> 00:12:32,060
،بصراحة

246
00:12:32,060 --> 00:12:34,270
ينبغي أن أعلّمه كيف يقتلني

247
00:12:34,270 --> 00:12:36,520
تُصرّ هذه المرأة على أن أبدّل
الحفّاض بدلاً من ذلك

248
00:12:36,770 --> 00:12:37,400
حسناً

249
00:12:37,770 --> 00:12:39,810
أعتقد بأنّ هذا جزء من تربية مُحارب

250
00:12:40,810 --> 00:12:41,850
،دينو الصّغير

251
00:12:42,100 --> 00:12:43,770
لنبدأ

252
00:12:46,480 --> 00:12:47,400
،أوّلاً

253
00:12:47,400 --> 00:12:49,400
،كُن رقيقاً عند تغيير الحفّاضة

254
00:12:50,100 --> 00:12:51,400
لأنّ الرّضيع لا يزال ضئيلاً

255
00:12:51,480 --> 00:12:52,650
لا تستخدم كثيراً من القوّة

256
00:12:54,900 --> 00:12:55,980
،ثانياً

257
00:12:55,980 --> 00:12:57,350
،قبل وضع حفّاضة جديدة

258
00:12:57,480 --> 00:12:59,770
من الأفضل تنظيف أسفل الرّضيع
،بماء دافئ

259
00:13:00,770 --> 00:13:02,980
ما يُساهم في منع ظهور طفح وإكزيما

260
00:13:04,770 --> 00:13:05,900
،ثالثاً

261
00:13:05,900 --> 00:13:07,650
لا تشدّ الحفّاضة بشكل مُحكَم

262
00:13:09,400 --> 00:13:12,350
وإلّا، سيُعرقل ذلك حركة الرّضيع

263
00:13:15,350 --> 00:13:17,770
أحسنت! أنت مُحترف حقّاً

264
00:13:17,900 --> 00:13:19,230
أنت الآن الوحيد

265
00:13:19,230 --> 00:13:21,150
الّذي يعمل حامياً وخبيراً في تغيير الحفّاضة

266
00:13:22,980 --> 00:13:24,900
أنا أتّخذ تدريب المُحارب بجدّية

267
00:13:28,270 --> 00:13:29,060
...لكن

268
00:13:29,350 --> 00:13:33,020
تربية مُحارب ليست أمراً يسيراً

269
00:13:33,850 --> 00:13:36,850
أوّلاً، البشر أضعف ممّا توقّعت

270
00:13:37,600 --> 00:13:40,230
هذه المخالب القويّة الّتي ترمز
،إلى كبرياء التنّين

271
00:13:40,600 --> 00:13:42,730
خطيرة جدّاً بالنّسبة له

272
00:13:47,230 --> 00:13:50,100
أفكّر في قصّ مخلب آخر

273
00:13:51,850 --> 00:13:54,900
ثانياً، الرّضيع البشريّ حسّاس للغاية

274
00:13:55,100 --> 00:13:58,100
أخيراً أستطيع النّوم قليلاً

275
00:14:01,900 --> 00:14:04,770
ما إن يستاء حتّى يبدأ بالبُكاء

276
00:14:06,600 --> 00:14:07,400
...و

277
00:14:14,850 --> 00:14:16,730
،هذه الحركة مُوجّهة نحو العنق

278
00:14:16,850 --> 00:14:17,850
هل ترى ذلك بوضوح؟

279
00:14:23,900 --> 00:14:27,100
إنّهم بطيئون في التعلُّم

280
00:14:28,600 --> 00:14:30,100
ادرس بجدّ يا دينو

281
00:14:30,400 --> 00:14:32,100
حينئذ فقط يمكنك أن تقتلني بشكل أسرع

282
00:14:33,600 --> 00:14:34,900
لماذا تُعلّمه هذا؟

283
00:14:35,400 --> 00:14:37,100
إنّه لا يستطيع حتّى المشي الآن

284
00:14:37,100 --> 00:14:38,770
لا تُعلّمه هذه الأشياء الغريبة

285
00:14:38,900 --> 00:14:41,600
،وبمُرافقة ساحرة مُزعجة لي

286
00:14:43,150 --> 00:14:46,730
تدريب المُحاربين أصعب ممّا توقّعت

287
00:14:49,000 --> 00:14:50,530
،لكن في لحظات كهذه

288
00:14:50,720 --> 00:14:52,050
أعتقد الأمر جدير

289
00:14:54,350 --> 00:14:56,600
حياتي التّقاعديّة الرّائعة

290
00:14:57,100 --> 00:14:59,230
تقاعد؟ أيّ تقاعد؟

291
00:14:59,270 --> 00:15:00,730
علينا أن نجني بعض المال

292
00:15:02,000 --> 00:15:03,980
ألم تقولي بأنّ الوضع المادّي ممتاز؟

293
00:15:04,480 --> 00:15:06,480
قلتُ ذلك

294
00:15:06,730 --> 00:15:07,850
لكن حسبتُ بشكل خاطئ

295
00:15:08,600 --> 00:15:09,230
المُشكلة الرّئيسيّة هي

296
00:15:09,230 --> 00:15:11,730
أنّ تكاليف الطّعام كانت أكبر ممّا توقّعت

297
00:15:12,730 --> 00:15:13,820
لا ألومكِ

298
00:15:14,350 --> 00:15:16,600
الغذاء البديل للرّضيع دينو مُكلف جدّاً

299
00:15:17,600 --> 00:15:19,850
لكن هذه نفقات ضروريّة لا يمكننا تجنّبها

300
00:15:22,600 --> 00:15:25,480
نفقاتي أنا وطفلي لا تُساوي
،حتّى نصف نفقاتك

301
00:15:25,980 --> 00:15:27,480
وتنتقدنا؟

302
00:15:30,980 --> 00:15:31,770
،لذا

303
00:15:32,100 --> 00:15:34,600
أحدنا بحاجة للعمل

304
00:15:35,850 --> 00:15:36,730
عمل؟

305
00:15:36,980 --> 00:15:38,600
،أنا الأوّل من بين الحُماة الأربعة

306
00:15:38,600 --> 00:15:39,480
،ومُعلّم الرّمح

307
00:15:39,480 --> 00:15:40,730
الحامي الّذي لا يُقهَر

308
00:15:40,980 --> 00:15:43,600
كيف لي أن أنحدر للقيام بأعمال بشريّة وضيعة؟

309
00:15:43,850 --> 00:15:46,720
قبل استيقاظ ملك الشّياطين 11 عام 9 أشهر 27 يوم

310
00:15:44,100 --> 00:15:45,480
،مستحيل

311
00:15:45,480 --> 00:15:46,730
برنامج التّدريب متأخّر بالفعل

312
00:15:46,730 --> 00:15:49,100
لن أقلق بشأن هذه التّفاصيل الصّغيرة

313
00:15:49,480 --> 00:15:51,480
على أيّ حال، أنا هنا لتدريب المُحارب

314
00:15:51,600 --> 00:15:53,730
لم يرِد في العقد بأنّني هنا لجني المال

315
00:15:53,980 --> 00:15:55,230
هذا ابتزاز

316
00:15:55,350 --> 00:15:56,880
إنّه خرق للعقد

317
00:15:57,230 --> 00:15:57,980
!خرق! خرق

318
00:15:57,980 --> 00:15:59,970
...خرق العقد

319
00:16:00,350 --> 00:16:01,480
هل انتهيت من الكلام؟

320
00:16:04,600 --> 00:16:05,480
انخفض

321
00:16:06,230 --> 00:16:08,600
أنا من عليه العمل، لا أنت

322
00:16:09,850 --> 00:16:10,980
لستُ أنا، صحيح؟

323
00:16:11,980 --> 00:16:13,480
،لديك رأس تنّين كبير كهذا

324
00:16:13,600 --> 00:16:14,730
لن يستأجرك أحد

325
00:16:14,980 --> 00:16:16,980
لم أتوقّع منك أن تجني مالاً على أيّ حال

326
00:16:17,850 --> 00:16:20,480
أنا فقط لا أريد القيام بتلك
الأعمال البشريّة الوضيعة

327
00:16:20,600 --> 00:16:21,730
كيف تجرؤ على قول ذلك؟

328
00:16:22,100 --> 00:16:23,230
كلّ ما تأكله وتلبسه وتستعمله

329
00:16:23,230 --> 00:16:24,730
يجب أن يُكتسَب، صحيح؟

330
00:16:25,100 --> 00:16:26,480
ماذا تقصد بأعمال بشريّة وضيعة؟

331
00:16:26,480 --> 00:16:28,350
كيف تجرؤ على التّقليل من احترام
أعمال البشر؟

332
00:16:29,850 --> 00:16:33,350
فضلاً عن ذلك، غسيل الملابس ومسح الأرض
...والطّبخ وتبديل الحفّاضة في المنزل

333
00:16:33,730 --> 00:16:35,480
أليست جزءاً من الأعمال؟

334
00:16:35,770 --> 00:16:37,480
ظننتُ بأنّك تُبلي حسناً

335
00:16:38,730 --> 00:16:40,980
،على أيّ حال، إذا ذهبتُ إلى العمل

336
00:16:41,270 --> 00:16:43,230
فستعتني بدينو في المنزل بمفردك

337
00:16:44,480 --> 00:16:48,100
...الاعتناء بدينو بمفردي

338
00:16:48,600 --> 00:16:50,980
،إن كنت تُفكّر في القيام بأيّ حركات مُريبة

339
00:16:50,980 --> 00:16:52,980
فلن أرحمك

340
00:16:53,730 --> 00:16:54,850
لستُ كذلك

341
00:16:54,850 --> 00:16:55,850
أنتِ تُبالغين في التّفكير

342
00:16:55,980 --> 00:16:56,850
لا تقلقي

343
00:16:56,980 --> 00:16:59,730
سأعتني بدينو

344
00:17:06,850 --> 00:17:07,650
،حسناً

345
00:17:08,440 --> 00:17:09,980
سأغادر

346
00:17:11,350 --> 00:17:14,100
شكراً على عملك الدّؤوب. لا تقلقي

347
00:17:18,150 --> 00:17:19,650
،أخيراً

348
00:17:20,230 --> 00:17:23,320
أستطيع البدء أخيراً

349
00:17:30,000 --> 00:17:31,910
الآن

350
00:17:32,540 --> 00:17:34,250
هل ما زلت تكترث؟