1
00:00:53,620 --> 00:00:55,660
هل أتوهّم؟

2
00:01:03,000 --> 00:01:05,890
كنتُ أشعر ببعض الحساسيّة مؤخّراً

3
00:02:42,620 --> 00:02:45,160
آي، افتح الباب

4
00:02:45,160 --> 00:02:46,680
أنا مشغول قليلاً

5
00:02:47,250 --> 00:02:49,620
كنتَ تُحدث جلبة على أمر
تافه طوال الصّباح

6
00:02:49,620 --> 00:02:52,220
بجدّية، يجب عليّ الذّهاب إلى العمل

7
00:02:53,310 --> 00:02:56,660
رتق الملابس صعب للغاية

8
00:02:56,660 --> 00:02:58,790
ما هذا؟

9
00:03:00,910 --> 00:03:02,180
ماذا الآن؟

10
00:03:04,610 --> 00:03:05,660
...هل هذا

11
00:03:06,910 --> 00:03:08,520
أرنب ميّت؟

12
00:03:11,950 --> 00:03:13,640
إنّه غزال هذه المرّة

13
00:03:18,280 --> 00:03:19,890
والآن خنزير برّي

14
00:03:28,040 --> 00:03:31,500
لا نعلم من أين أتى، لكن مذاقه لذيذ

15
00:03:32,000 --> 00:03:35,980
الخنزير البرّيّ الخاصّ بملك الشّياطين لذيذ

16
00:03:37,870 --> 00:03:40,700
في العادة نكون مُقتصدين، لكن
طعام اليوم مُترف جدّاً

17
00:03:40,700 --> 00:03:43,000
بصراحة، يبدو هذا غريباً بعض الشّيء

18
00:03:43,000 --> 00:03:45,910
لكن مُحال أن نتمكّن من إنهاء
كلّ هذا اللّحم

19
00:03:45,910 --> 00:03:47,310
ماذا تقصدين؟

20
00:03:48,250 --> 00:03:50,580
لا أعتقد بأنّ هذا يكفي

21
00:03:57,260 --> 00:04:00,010
حسناً، ربّما هذا كثير زيادة عن اللّزوم

22
00:04:04,000 --> 00:04:06,750
انتهيتُ أخيراً

23
00:04:06,750 --> 00:04:08,250
هل يمكنني أخذ استراحة

24
00:04:08,250 --> 00:04:09,180
لافي

25
00:04:09,920 --> 00:04:12,500
الثلّاجة مُمتلئة، ماذا يجدر بنا أن نفعل؟

26
00:04:12,500 --> 00:04:16,280
حسناً. لننقل هذه إلى المدخل أوّلاً

27
00:04:16,280 --> 00:04:17,600
حسناً

28
00:04:19,750 --> 00:04:22,060
!هذا دبّ نمر ضخم

29
00:04:25,910 --> 00:04:27,310
!وهذا واحد آخر

30
00:04:28,870 --> 00:04:30,400
من يفعل هذا يا  ترى؟

31
00:04:35,000 --> 00:04:36,780
إنّها هي؟

32
00:04:37,490 --> 00:04:40,050
لذا يجدر بنا أن نُعدّ

33
00:04:41,200 --> 00:04:43,850
الوقت ليس مناسباً الآن لمُناقشة
!كيفيّة أكله

34
00:04:44,250 --> 00:04:46,910
أنا سعيدة جدّاً لحصولنا على
،كلّ هذا الطّعام

35
00:04:46,910 --> 00:04:48,770
،وقد خفّف ذلك عبئنا الماليّ

36
00:04:49,080 --> 00:04:53,880
لكن الكثير من الطّعام قد عرقل
حياتي اليوميّة

37
00:04:55,220 --> 00:04:58,940
!لذا لقد سئمت ولم أعد أحتمل

38
00:05:00,250 --> 00:05:01,790
لافي، اهدئي

39
00:05:01,790 --> 00:05:03,270
إنّها مُجرّد عجوز

40
00:05:03,270 --> 00:05:05,510
هل يمكنك التّعامل مع دُبّ النّمر أوّلاً؟

41
00:05:05,510 --> 00:05:08,150
أريد أن أتكلّم معها بجدّية

42
00:05:15,950 --> 00:05:18,200
،مرحباً، أنا لافي

43
00:05:18,200 --> 00:05:19,950
جارتكِ

44
00:05:22,450 --> 00:05:24,060
هل من مُشكلة؟

45
00:05:25,450 --> 00:05:28,640
...أنا هنا للحديث عن

46
00:05:35,850 --> 00:05:39,140
كيف ينبغي أن أشرح الأمر
بحيث يبدو منطقيّاً؟

47
00:05:41,500 --> 00:05:42,940
تفضّلي بالدّخول

48
00:05:43,870 --> 00:05:45,090
حسناً

49
00:05:56,620 --> 00:05:59,110
طلبتْ منّي التّعامل مع صيد
،كبير كهذا بمُفردي

50
00:06:00,000 --> 00:06:01,740
وأخذَتِ السّاطور معها

51
00:06:02,660 --> 00:06:04,560
ينبغي أن أصلح هذه الملابس أوّلاً

52
00:06:16,450 --> 00:06:18,800
هذا المكان مُخيف

53
00:06:20,050 --> 00:06:22,000
لماذا دخلتُ إلى هنا أصلاً؟

54
00:06:22,000 --> 00:06:25,020
كان بوسعنا حسم هذا الأمر عند المدخل

55
00:06:25,020 --> 00:06:27,100
ماذا أردتِ أن تقولي؟

56
00:06:27,910 --> 00:06:29,520
تفضّلي

57
00:06:30,540 --> 00:06:33,130
...أتيتُ إلى هنا للحديث عن

58
00:06:33,560 --> 00:06:35,910
...ماذا كان يا ترى

59
00:06:37,700 --> 00:06:40,700
لا، خانتني الكلمات

60
00:06:40,700 --> 00:06:43,090
لا، هذا سيّئ، يجب أن أتمالك نفسي

61
00:06:43,700 --> 00:06:45,850
حسناً، لديّ هذه

62
00:06:46,140 --> 00:06:48,140
،أعلم بأنّ الأمر مُفاجئ قليلاً

63
00:06:48,140 --> 00:06:51,520
لكن سامحيني رجاء على الزّيارة
دون إشعار مُسبق

64
00:06:51,520 --> 00:06:55,410
أردتُ فقط أن أشكركِ على الاعتناء
،بدينو في المرّة الماضية

65
00:06:55,410 --> 00:06:59,020
وعلى الاهتمام بعائلتي

66
00:06:59,020 --> 00:07:02,200
لكن يؤسفني أنّكِ أرسلتِ الكثير من الطّعام

67
00:07:02,200 --> 00:07:03,470
بشكل مُبالغ به

68
00:07:03,470 --> 00:07:05,700
،ليس لدينا أيّ شيء لردّ الجميل

69
00:07:05,700 --> 00:07:07,770
لذا أردتُ فقط أن أشكركِ من القلب

70
00:07:07,770 --> 00:07:09,410
حسناً، سأغادر إذاً

71
00:07:09,410 --> 00:07:10,020
انتظري

72
00:07:18,450 --> 00:07:20,850
يا إلهي، عرفتُ بأنّني كنتُ وقحة قليلاً

73
00:07:21,780 --> 00:07:23,130
،المعذرة

74
00:07:24,540 --> 00:07:28,520
هل يمكنني رؤية الطّفل؟

75
00:07:34,470 --> 00:07:39,680
دينو، دينو الصّغير، أنت تحبّني
فعلاً، أليس كذلك؟

76
00:07:42,330 --> 00:07:47,270
أرادتْ رؤية دينو فحسب

77
00:08:14,770 --> 00:08:15,820
!يا للهول

78
00:08:17,000 --> 00:08:19,580
آي، ثمّة أرنب على الباب

79
00:08:22,640 --> 00:08:25,520
!دينو الصّغير، أنت على وشك الوقوف

80
00:08:26,620 --> 00:08:28,940
تجاوزَتِ الحدودَ حقّاً

81
00:08:32,750 --> 00:08:36,000
مُريح للغاية

82
00:08:39,620 --> 00:08:42,580
كنتُ مُرهقة جدّاً مؤخّراً

83
00:08:43,850 --> 00:08:46,120
،أنا مشغولة في العمل طوال اليوم

84
00:08:46,120 --> 00:08:48,720
ثمّ أتعامل مع الصّيد عندما
أعود إلى المنزل

85
00:08:49,250 --> 00:08:52,350
...أخيراً، حصلتُ على يوم إجازة

86
00:08:56,000 --> 00:08:59,040
هذه المرّة، بلّلتُ نهايات الخيط أوّلاً

87
00:08:59,040 --> 00:09:01,390
كان ينبغي أن أتمكّن من فعلها، صحيح؟

88
00:09:01,390 --> 00:09:02,940
!فعلتُها

89
00:09:06,400 --> 00:09:08,540
تأخّر الوقت إلى هذا الحدّ؟

90
00:09:08,540 --> 00:09:10,770
لماذا لم تعُد لافي؟

91
00:09:13,910 --> 00:09:15,890
لماذا غلبني النُّعاس؟

92
00:09:17,480 --> 00:09:19,580
كم نمتُ من وقت؟

93
00:09:21,120 --> 00:09:24,570
هل غطّتني الجدّة بهذه البطّانيّة؟

94
00:09:26,790 --> 00:09:27,930
...هذا

95
00:09:39,870 --> 00:09:41,020
،اشربيه

96
00:09:41,940 --> 00:09:44,810
أو سيفقد الشّاي نكهته عندما يبرد

97
00:09:53,620 --> 00:09:56,220
سيفقد الشّاي نكهته عندما يبرد

98
00:10:02,180 --> 00:10:03,960
حسناً

99
00:10:05,040 --> 00:10:06,430
،بعد إمعان النّظر فيها

100
00:10:07,610 --> 00:10:10,060
إنّها جدّة طبيعيّة جدّاً

101
00:10:11,040 --> 00:10:15,180
،هذا المنزل هو مُجرّد منزل جدّة عاديّة

102
00:10:15,810 --> 00:10:18,920
وتعيش هنا بمفردها تماماً

103
00:10:24,750 --> 00:10:27,970
تبدو هذه الصّورة التُقطت منذ زمن بعيد

104
00:10:29,410 --> 00:10:31,820
هل الفتاة الصّغيرة الّتي بجانبها هي ابنتها؟

105
00:10:32,750 --> 00:10:34,310
وماذا عن زوجها؟

106
00:10:35,620 --> 00:10:36,700
...أيُعقل أنّ -
دينو الصّغير -

107
00:10:36,700 --> 00:10:39,850
...سبب عيشها هنا لوحدها هو

108
00:10:41,550 --> 00:10:42,640
،لا يهمّ

109
00:10:43,660 --> 00:10:45,220
حريّ بي ألّا أسأل

110
00:10:48,540 --> 00:10:50,810
قد يكون موضوعاً حسّاساً بعض الشّيء

111
00:10:52,750 --> 00:10:55,770
اسم هذه الطّفلة هو غريس

112
00:10:56,380 --> 00:10:57,990
ابنتي

113
00:10:58,880 --> 00:11:03,050
،كنّا قد قضينا وقتاً رائعاً معاً

114
00:11:03,500 --> 00:11:05,620
أنا مُمتنّة على كلّ شيء حقّاً

115
00:11:06,220 --> 00:11:08,530
،لكن رغم ذلك

116
00:11:08,530 --> 00:11:10,870
لا بُدّ أنّه من الصّعب جدّاً

117
00:11:10,870 --> 00:11:15,100
مُحاولة المُوازنة بين العمل ورعاية الأطفال

118
00:11:25,090 --> 00:11:26,100
،لا

119
00:11:26,370 --> 00:11:30,020
في الواقع، أنا راضية تماماً

120
00:11:33,220 --> 00:11:36,070
كانت تلك الطّفلة في مثل سنّك

121
00:11:36,070 --> 00:11:38,310
...لو سار كلّ شيء على ما يُرام

122
00:11:40,250 --> 00:11:42,000
...هل غريس

123
00:11:42,000 --> 00:11:43,450
قد تُوفّيت؟

124
00:11:45,290 --> 00:11:46,520
أتساءل

125
00:11:47,290 --> 00:11:49,970
إذا كانت تعتبرني كابنتها؟

126
00:11:51,000 --> 00:11:55,970
إذاً لم يكن كلّ ما فعلَتْه بسبب
...دينو، كان بسبب

127
00:11:57,580 --> 00:11:58,880
بسببي

128
00:12:05,180 --> 00:12:07,600
...بجدّية

129
00:12:07,910 --> 00:12:09,600
لماذا هو بعيد جدّاً

130
00:12:10,400 --> 00:12:15,290
من يفرض أجراً مُرتفع على منزل
كائن في أعماق الجبال؟

131
00:12:15,290 --> 00:12:19,620
،لو كنتُ أتحمّل نفقات وجبات طعام أفضل
لما شعرتُ بهذا الإرهاق

132
00:12:19,620 --> 00:12:23,180
كيف يُفترض بي أن أكمل حياتي
حتّى يحين وقت الرّاتب؟

133
00:12:27,180 --> 00:12:29,410
إذاً هذه هي الحقيقة بكاملها

134
00:12:29,410 --> 00:12:32,270
...فعلتْ كلّ هذا لأجلي

135
00:12:34,620 --> 00:12:37,390
يا للهول! استيقظ دينو ويريد أمّه

136
00:12:39,610 --> 00:12:42,040
اهدأ يا بُني. لا تبكِ

137
00:12:42,040 --> 00:12:43,890
جاءت أمّك

138
00:12:45,370 --> 00:12:47,500
لافي، إنّها 8 مساء بالفعل

139
00:12:47,500 --> 00:12:49,720
تجاوزت السّاعةُ وقت نوم المُحارب

140
00:12:50,410 --> 00:12:54,360
ماذا لو كبرَ دينو يُعاني من ضعف
مناعة وفقدان الشّعر؟

141
00:12:56,440 --> 00:12:58,620
لماذا خبطت على الباب بقوّة هكذا؟

142
00:12:58,620 --> 00:13:00,250
لم أقصد فعل ذلك

143
00:13:00,250 --> 00:13:04,270
ومُحال أن يحدث لداينو ما ذكرتَه

144
00:13:07,160 --> 00:13:08,690
نحن آسفان حقّاً

145
00:13:08,690 --> 00:13:11,020
تحمّسَ زيادة عن اللّزوم وكسر بابكِ

146
00:13:11,410 --> 00:13:15,220
لكن لا تقلقي، تعلّم آي الكثير
من المهارات الجديدة مؤخّراً

147
00:13:15,220 --> 00:13:17,120
سيُصلح بابكِ كما ينبغي

148
00:13:17,120 --> 00:13:18,010
لا اعتراض، صحيح؟

149
00:13:18,500 --> 00:13:20,390
لا... لا مُشكلة

150
00:13:22,250 --> 00:13:24,250
كان من الرّائع قضاء الوقت معك اليوم

151
00:13:24,250 --> 00:13:26,570
وحتّى أنّني نسيتُ الوقت

152
00:13:27,120 --> 00:13:28,680
وحتّى أنّكِ نسيتِ إطعام دينو
،حليبه المسائيّ

153
00:13:30,500 --> 00:13:33,160
بئساً... نسيتِ أيضاً تغيير حفّاضته النّتنة

154
00:13:33,160 --> 00:13:35,160
أنتِ مُستهترة حقّاً

155
00:13:35,160 --> 00:13:38,550
ليس لديّ أنف كبير كأنف
الكلب الّذي لديك هذا

156
00:13:38,550 --> 00:13:40,160
،الأمر لا يتعلّق بالأنف

157
00:13:40,160 --> 00:13:41,770
!ينبغي أن تتفقّدي بوتيرة مُنتظمة

158
00:13:41,770 --> 00:13:44,250
أنتما مُنسجمان حقّاً

159
00:13:49,920 --> 00:13:51,870
،أنا هيلغا

160
00:13:51,870 --> 00:13:54,470
يمكنكما أن تُنادياني بالجدّة هيلغا

161
00:13:55,620 --> 00:13:59,350
عندما تكونان مُتفرّغين، لِمَ لا تُحضران
دينو لنلعب أكثر؟

162
00:14:00,030 --> 00:14:02,080
حسناً، شكراً لكِ

163
00:14:02,620 --> 00:14:04,660
سنعود الآن

164
00:14:04,660 --> 00:14:05,810
تفضّلا

165
00:14:13,410 --> 00:14:14,460
وأيضاً

166
00:14:16,530 --> 00:14:19,180
،بخصوص ابنتك غريس

167
00:14:25,000 --> 00:14:26,370
أنا آسفة حقّاً لخسارتكِ

168
00:14:26,370 --> 00:14:27,950
لا تقلقي بشأن ذلك

169
00:14:27,950 --> 00:14:30,970
إنّها تُبلي بلاء حسناً مع والدها

170
00:14:30,970 --> 00:14:32,870
ماذا؟

171
00:14:32,870 --> 00:14:35,310
غريس خجولة دوماً

172
00:14:35,310 --> 00:14:38,120
ارتأيتُ بأنّها ستكون فكرة جيّدة
،أن أعلّمها بعض الدّفاع الذّاتيّ

173
00:14:38,120 --> 00:14:40,500
وذلك كي تتمكّن من حماية نفسها

174
00:14:40,500 --> 00:14:44,620
مُراقبتها تزداد قوّة رويداً رويداً
تمنحني البهجة العظمى

175
00:14:44,620 --> 00:14:46,250
،لكن لسبب ما

176
00:14:46,250 --> 00:14:48,570
غادرتْ مع أبيها لاحقاً

177
00:14:48,570 --> 00:14:50,800
أنا متأكّدة بأنّها تُبلي حسناً

178
00:14:50,800 --> 00:14:53,910
،هل تُعلّمينها لحماية نفسها
أم لإنقاذ العالم؟

179
00:14:53,910 --> 00:14:55,930
أنا متأكّدة بأنّ أيّ شخص
كان ليُغادر لو كان مكانها

180
00:14:56,370 --> 00:14:59,870
إذاً ما زالت حيّة تُرزَق؟

181
00:14:59,870 --> 00:15:02,500
ماذا؟ هل قلتُ بأنّها ماتت؟

182
00:15:02,500 --> 00:15:04,540
لا، لم تفعلي

183
00:15:06,520 --> 00:15:10,270
خُدِعتُ بتعبير وجهها

184
00:15:11,370 --> 00:15:14,120
الجدّة هيلغا، لا يمكننا إزعاجكِ بعد الآن

185
00:15:14,120 --> 00:15:16,600
،ثمّة أمر آخر

186
00:15:17,250 --> 00:15:19,790
،تحسّن الصّيد حقّاً مؤخّراً

187
00:15:19,790 --> 00:15:22,330
الكمّية كبيرة جدّاً على إهدارها

188
00:15:22,330 --> 00:15:24,770
يمكنكما أخذ ما تشاءان

189
00:15:26,910 --> 00:15:29,040
اصطدتِ كلّ هذه الطّرائد

190
00:15:29,040 --> 00:15:34,130
إذاً كنتُ أبالغ في التّفكير طوال اليوم

191
00:15:35,120 --> 00:15:37,250
،لا داعي للصّيد حاليّاً

192
00:15:37,250 --> 00:15:41,050
ينبغي لهذه الطّرائد أن تُعيلهم لبعض الوقت

193
00:15:45,310 --> 00:15:46,910
شكراً جزيلاً لكِ على اليوم

194
00:15:46,910 --> 00:15:49,100
كان شايكِ لذيذاً حقّاً. وداعاً

195
00:15:49,890 --> 00:15:51,080
مهلاً

196
00:15:52,370 --> 00:15:53,640
ما الخطب؟

197
00:15:53,640 --> 00:15:56,200
كسرَ بابي

198
00:15:56,200 --> 00:15:57,970
هل ستُغادر بهذه البساطة فحسب؟

199
00:15:59,810 --> 00:16:02,780
لافي، أعتقد بأنّكِ مُلازمة جزئيّاً كذلك

200
00:16:03,870 --> 00:16:05,870
آي، حريّ بك مُعالجة الأمر. وداعاً

201
00:16:05,870 --> 00:16:07,990
!بالتّوفيق لك

202
00:16:09,540 --> 00:16:11,140
تبّاً

203
00:16:12,950 --> 00:16:15,160
،لا أعرف من يكون

204
00:16:15,160 --> 00:16:17,790
لكنّك لفتّ أنظاره بالفعل

205
00:16:17,790 --> 00:16:21,390
غالباً أتى لأجله، يا أوّل الحُماة الأربعة

206
00:16:22,880 --> 00:16:24,850
كيف عرفتِ بأنّ هذا أنا؟

207
00:16:25,450 --> 00:16:27,180
...لأنّ

208
00:16:29,040 --> 00:16:30,410
نشرة

209
00:16:30,410 --> 00:16:31,850
حسناً، فهمت

210
00:16:36,540 --> 00:16:38,840
احذروا جميعاً

211
00:16:38,840 --> 00:16:40,930
يراودني شعور سيّئ حيال ذلك الّخص

212
00:16:41,450 --> 00:16:44,300
لا يبدو شخصاً عاديّاً

213
00:16:45,350 --> 00:16:49,280
،لا تنسَ أقفال الباب عندما تعود

214
00:16:49,280 --> 00:16:51,330
وأبقِ السّتائر مُغلقة

215
00:16:51,330 --> 00:16:52,220
حسناً

216
00:17:03,920 --> 00:17:06,750
إذا حدث شيء، تواصل معي فوراً

217
00:17:07,200 --> 00:17:09,140
أجل، أعلم

218
00:17:10,410 --> 00:17:11,400
ما الخطب؟

219
00:17:11,400 --> 00:17:13,310
إنّها تُبالغ في الحرص

220
00:17:15,080 --> 00:17:17,970
،كن حذراً ريثما تعلم ما يجري

221
00:17:18,700 --> 00:17:21,280
لا سيّما لأجل لافي ودينو

222
00:17:29,770 --> 00:17:31,360
عدنا إلى المنزل الآن

223
00:17:38,290 --> 00:17:42,650
أهلاً بعودتك