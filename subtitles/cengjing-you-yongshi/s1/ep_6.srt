1
00:00:29,250 --> 00:00:31,390
بأمرك يا ملك الشّياطين

2
00:00:39,410 --> 00:00:42,220
هل وجدت المُحارب؟

3
00:00:42,950 --> 00:00:44,120
تقريباً

4
00:00:44,120 --> 00:00:46,980
خليقة فيريبرو قد اكتملت تقريباً

5
00:00:46,980 --> 00:00:49,430
سأجد المُحارب في غضون شهر

6
00:00:52,540 --> 00:00:54,040
أحسنت صنعاً

7
00:00:54,040 --> 00:00:55,700
،حالما يتمّ ذلك

8
00:00:55,700 --> 00:01:00,020
ستستعيد ذاكرتك الّتي تعود إلى ما قبل
أن تصبح ليتش

9
00:01:00,830 --> 00:01:02,830
شكراً لك يا ملك الشّياطين

10
00:01:02,830 --> 00:01:05,820
شرف لي أن أزيل عقباتك

11
00:01:06,310 --> 00:01:08,040
عظيم

12
00:01:08,040 --> 00:01:09,790
يمكنك الانصراف الآن

13
00:01:09,790 --> 00:01:12,470
ابذل قصارى جهدك لإعادة المُحارب
في أسرع وقت مُمكن

14
00:01:12,470 --> 00:01:13,410
حاضر، مولايّ

15
00:02:42,180 --> 00:02:44,430
الحلقة 6

16
00:02:42,180 --> 00:02:44,430
مُرشَّح المُحارب

17
00:02:45,400 --> 00:02:48,500
أنا الحامي الّذي عقد صفقة
مع ملك الشّياطين

18
00:02:48,500 --> 00:02:51,500
مهمّتي هي إيجاد المُحارب الجدير لمولايّ

19
00:02:51,500 --> 00:02:54,280
فير، سآخذ دينو إلى البلدة لاحقاً

20
00:02:54,280 --> 00:02:55,700
هل يمكنك غسيل هذه الملابس؟

21
00:02:55,700 --> 00:02:57,720
لا عليكِ يا سيّدة لافي

22
00:02:57,720 --> 00:03:00,960
سأكويها بعد أن أغسلها

23
00:03:00,960 --> 00:03:02,830
شكراً على مساعدتك

24
00:03:02,830 --> 00:03:04,250
لا شكر على واجب

25
00:03:04,750 --> 00:03:05,640
تبّاً

26
00:03:07,250 --> 00:03:09,830
ألم نتّفق على تقاسُم الأعمال
المنزليّة بالتّساوي؟

27
00:03:10,830 --> 00:03:14,150
لا يهمّ. كلّ هذا للبحث عن المُحارب

28
00:03:15,140 --> 00:03:16,270
،رغم ذلك

29
00:03:16,870 --> 00:03:18,410
مثل هذا الطّفل الوديع

30
00:03:18,410 --> 00:03:21,640
لا يبدو شخصاً يستطيع مُقاتلة ملك الشّياطين

31
00:03:23,330 --> 00:03:27,390
هل قدري هو أن أبقى ليتش
بارد الدّم بلا ذاكرة للأبد؟

32
00:03:27,810 --> 00:03:30,620
،أيّها المُحارب الّذي يستطيع هزيمة ملك الشّياطين

33
00:03:30,620 --> 00:03:32,640
أين أنت؟

34
00:03:35,450 --> 00:03:36,100
قادم

35
00:03:40,130 --> 00:03:42,020
إنّها الجدّة هيلغا

36
00:03:42,620 --> 00:03:44,870
أعددتُ للتو بعض الجبن الطّازج

37
00:03:44,870 --> 00:03:46,090
إليكِ بعضاً منه

38
00:03:46,880 --> 00:03:48,470
شكراً لكِ أيّتها الجدّة هيلغا

39
00:03:49,370 --> 00:03:50,870
...تلك المرأة العجوز هي

40
00:03:56,250 --> 00:03:57,750
إنّها هي

41
00:03:58,480 --> 00:04:00,620
،لحسن الحظّ أنّها أخفقت بفارق بسيط

42
00:04:00,620 --> 00:04:02,140
وإلّا كنتُ في عداد الموتى

43
00:04:03,700 --> 00:04:06,180
لماذا يوجد ليتش في منزلك؟

44
00:04:06,500 --> 00:04:08,870
هذا فير

45
00:04:10,050 --> 00:04:13,120
ماذا؟ كان هنا للتو

46
00:04:13,120 --> 00:04:14,910
كان ذلك خطيراً للغاية

47
00:04:14,910 --> 00:04:16,790
يبدو أنّه ليس من الآمن البقاء
في هذا المكان أيضاً

48
00:04:16,790 --> 00:04:19,620
يجب عليّ البحث عن مُرشّحين مُحاربين فوراً

49
00:04:19,620 --> 00:04:21,610
والخروج من هنا

50
00:04:28,140 --> 00:04:29,530
من الجيّد أنّني هربت

51
00:04:29,530 --> 00:04:31,260
كاد يُكشَف أمري

52
00:04:31,870 --> 00:04:33,410
هناك حتّى المزيد من النّاس في البلدة

53
00:04:33,410 --> 00:04:34,810
يجب أن أتوخّى الحذر

54
00:04:43,040 --> 00:04:44,880
لم يكشفني أحد

55
00:04:44,880 --> 00:04:47,430
والآن عليّ البحث عن مُحاربين

56
00:04:47,430 --> 00:04:49,600
نقابة المُغامرين

57
00:04:55,290 --> 00:04:56,730
عليّ إيجاد شخص

58
00:04:57,290 --> 00:05:00,310
هلّا سألتُك عمّن تبحث؟

59
00:05:01,230 --> 00:05:06,220
أبحث عن مُحارب قويّ بما يكفي
لهزيمة ملك الشّياطين

60
00:05:07,950 --> 00:05:09,370
مُحارب؟

61
00:05:11,680 --> 00:05:14,000
لكنّنا نعيش في زمن سلميّ الآن

62
00:05:14,000 --> 00:05:17,160
لم يعُد للمُحاربين فائدة

63
00:05:17,160 --> 00:05:19,200
لا بُدّ أنّك تمزح يا سيّدي

64
00:05:19,700 --> 00:05:22,410
قد لا تكون نقابتنا ضليعة في ذلك، لكن
لدينا الكثير من المُحاربين

65
00:05:22,410 --> 00:05:23,930
مُتاح لدينا مُختلف الأنواع

66
00:05:23,930 --> 00:05:26,060
ألقِ نظرة واختر ما تشاء

67
00:05:24,380 --> 00:05:25,270
موسوعة المُحاربين

68
00:05:28,140 --> 00:05:31,140
بصراحة، فضّلتُ سلوكك المُتمرّد السّابق

69
00:05:31,660 --> 00:05:32,770
فهمت

70
00:05:33,660 --> 00:05:35,500
لنبدأ إذاً

71
00:05:36,040 --> 00:05:38,160
الأوّل، بلينك

72
00:05:38,160 --> 00:05:40,410
سيّاف خبير بعضلات مفتولة

73
00:05:40,410 --> 00:05:42,880
لم يُهزَم حتّى يومنا هذا، والمعروف

74
00:05:42,350 --> 00:05:45,000
السّيّاف الّذي لا يُقهَر

75
00:05:42,880 --> 00:05:44,690
بالسّيّاف الّذي لا يُقهر

76
00:05:45,290 --> 00:05:48,480
الثّاني، ثنائي من ساحرتين توأمتين

77
00:05:48,480 --> 00:05:52,040
سحرهما النّاري قويّ بشكل مُدمّر، وتُعرَفان

78
00:05:51,600 --> 00:05:54,230
توأما اللّهب القرمزيّ

79
00:05:52,040 --> 00:05:54,230
بتوأمتي اللّهب القرمزيّ

80
00:05:54,410 --> 00:05:58,330
الثّالث، توازن مثاليّ بين البنية
الجسديّة والمهارة، السّيّد مايتي

81
00:05:58,330 --> 00:06:00,700
،المعيار الذّهبيّ لنقابة المُغامرين

82
00:06:00,700 --> 00:06:03,120
،والّذي يُعرَف بملك الشّجعان

83
00:06:02,560 --> 00:06:04,600
ملك الأدغال

84
00:06:04,600 --> 00:06:07,370
إن أمكن، أودّ لقاء هؤلاء حالاً

85
00:06:08,750 --> 00:06:10,660
لحسن الحظّ أنّه أثناء انهيار القلعة قبل مدّة

86
00:06:10,660 --> 00:06:12,320
خاطرتُ بحياتي للحصول على هذه الثّروة

87
00:06:12,320 --> 00:06:14,520
...لكن كلّ هذا لإيجاد مُحارب

88
00:06:18,160 --> 00:06:19,890
إنّه ثقيل جدّاً

89
00:06:19,890 --> 00:06:21,560
دعني ألقي نظرة أوّلاً

90
00:06:26,090 --> 00:06:29,600
لعلّ هذا المال قد خُزِّن لفترة طويلة جدّاً

91
00:06:30,010 --> 00:06:31,020
اخرج

92
00:06:33,000 --> 00:06:35,220
لحسن الحظّ، دوّنتُ أسماءهم

93
00:06:35,220 --> 00:06:37,310
الاسم: بلينك

94
00:06:35,220 --> 00:06:37,310
الجنس: ذكر

95
00:06:35,220 --> 00:06:37,310
الطّول: 185 سم

96
00:06:35,220 --> 00:06:37,310
المهنة: سيّاف

97
00:06:35,220 --> 00:06:37,310
الرّاتب: عاديّ

98
00:06:35,690 --> 00:06:37,310
سأبحث عن هذا أوّلاً

99
00:06:38,760 --> 00:06:40,790
سيّاف لا يُقهَر؟

100
00:06:40,790 --> 00:06:42,770
أنت لا تفوز إلّا بمُقاتلة خصوم أضعف

101
00:06:43,790 --> 00:06:46,160
،إذا خسرت أمامي اليوم

102
00:06:46,160 --> 00:06:48,520
"فسيُطلَق عليك اسم "السّيّاف الخجول

103
00:06:48,520 --> 00:06:50,000
!افعلها

104
00:06:50,000 --> 00:06:53,030
لقّن هذا الطّفل المغرور درساً

105
00:06:53,910 --> 00:06:56,060
أنا لا أشهر سيفي لسبب تافه

106
00:06:56,450 --> 00:06:57,700
تبّاً

107
00:06:57,700 --> 00:06:59,180
!كيف تجرؤ على الاستخفاف بي؟

108
00:07:09,200 --> 00:07:11,450
،رغم أنّ هجمتك تفتقر للقوّة

109
00:07:11,450 --> 00:07:12,970
إلّا أنّها تحمل روحاً مُدهشة

110
00:07:18,030 --> 00:07:20,320
تستحقّ لقبك حقّاً كسيّاف لا يُقهَر

111
00:07:20,320 --> 00:07:22,100
!رائع جدّاً يا بلينك

112
00:07:22,100 --> 00:07:26,020
بلينك، بلينك، بلينك

113
00:07:27,040 --> 00:07:29,200
،لا يمكنك أن تجرحني بعد

114
00:07:29,200 --> 00:07:31,040
،لكن بالتّمرين المُتواصل

115
00:07:31,040 --> 00:07:33,790
ستصبح يوماً ما قويّاً مثلي

116
00:07:33,790 --> 00:07:38,080
ربّما يمكنك أن تكون السّيّاف
الّذي لا يُقهَر التّالي

117
00:07:40,480 --> 00:07:43,100
هل هو المُحارب الّذي كنتُ أبحث عنه؟

118
00:07:43,790 --> 00:07:46,890
رجل حقيقيّ طويل القامة. إنّه مَن أُريد

119
00:07:48,620 --> 00:07:51,720
بلينك، هل يمكنني التقاط بعض
الصّور الظّريفة معك؟

120
00:07:51,720 --> 00:07:54,450
رجل حقيقيّ مثله مُحال أن يقبل بذلك

121
00:07:54,450 --> 00:07:55,450
لا مُشكلة

122
00:08:01,040 --> 00:08:05,820
والآن سأُريكن عضلات صدري
،تُطبِق على سيف كبير

123
00:08:05,820 --> 00:08:07,660
هل تُرِدن رؤية ذلك؟

124
00:08:07,660 --> 00:08:09,580
!أجل

125
00:08:09,580 --> 00:08:12,680
لا أصدّق بأنّني خسرتُ أمام شخص كهذا -
لا أصدّق بأنّ المطاف انتهى بي مع شخص كهذا -

126
00:08:13,160 --> 00:08:15,390
انسَ الأمر، التّالي

127
00:08:21,140 --> 00:08:23,970
الاسم: توأمتا اللّهب القرمزيّ

128
00:08:21,140 --> 00:08:23,970
الجنس: أنثى

129
00:08:21,140 --> 00:08:23,970
الطّول: 160 سم

130
00:08:21,140 --> 00:08:23,970
المهنة: ساحرة

131
00:08:21,140 --> 00:08:23,970
الرّاتب: مُرتفع

132
00:08:21,470 --> 00:08:24,840
التّالي توأمتا اللّهب القرمزيّ

133
00:08:30,540 --> 00:08:34,770
من كان يتوقّع أن يستطيع مُجرّد بشريّ
استحضار سحر نار بهذا الحجم الهائل

134
00:08:48,250 --> 00:08:50,680
لماذا القوّة التّدميريّة ضعيفة جدّاً؟

135
00:08:51,290 --> 00:08:52,330
!فهمت

136
00:08:52,330 --> 00:08:55,430
الضّوء هنا برّاق للغاية. إنّه
يؤثّر على أدائنا

137
00:08:55,430 --> 00:08:57,770
أجل. لنجرّب هناك بدلاً من ذلك

138
00:09:05,560 --> 00:09:07,270
!أجل! نجحنا

139
00:09:07,270 --> 00:09:11,080
نحن أقوى توأمتين سحريّتين

140
00:09:11,080 --> 00:09:12,520
ماذا تفعلان؟

141
00:09:12,520 --> 00:09:15,890
من أنتما؟ لماذا تُدمّران بستاني؟

142
00:09:15,890 --> 00:09:18,540
هل تعلمان كم بذلتُ من جهد
لزرع أشجار الفواكه هذه؟

143
00:09:18,540 --> 00:09:20,930
!يجب أن تُعوّضاني

144
00:09:21,790 --> 00:09:23,240
نُعوّضك؟

145
00:09:23,240 --> 00:09:24,660
نحن ساحرتان

146
00:09:24,660 --> 00:09:28,130
نُمارس السّحر لحمايتك بشكل أفضل

147
00:09:28,760 --> 00:09:32,400
،تماماً! إذا شنّ الشّياطين هجوماً
،لولا حمايتنا

148
00:09:32,400 --> 00:09:34,640
سيُدمَّر بستانك على أيّ حال

149
00:09:34,640 --> 00:09:36,060
ساحرتان؟

150
00:09:36,510 --> 00:09:41,250
إنّ فقدان بضعة أشجار يضمن
سلامة البستان بأكمله

151
00:09:41,990 --> 00:09:44,860
فضلاً عن ذلك، الفراولة رائجة في هذا العام

152
00:09:44,860 --> 00:09:46,680
يجدر بك أن تزرعها بدلاً من ذلك

153
00:09:46,680 --> 00:09:48,850
حـ-حقّاً؟

154
00:09:49,870 --> 00:09:53,520
يبدو سحرهما النّاري أضعف من سحر لافي

155
00:09:54,540 --> 00:09:56,620
شخصيّتهما مشكوك بها أيضاً

156
00:09:56,620 --> 00:09:58,890
أيّاً يكن. المُرشّح التّالي

157
00:09:58,890 --> 00:10:00,430
الاسم: ملك الأدغال

158
00:09:58,890 --> 00:10:00,430
الجنس: ذكر

159
00:09:58,890 --> 00:10:00,430
الطّول: 175 سم

160
00:09:58,890 --> 00:10:00,430
المهنة: مغتال

161
00:09:58,890 --> 00:10:00,430
الرّاتب: مُرتفع

162
00:10:09,790 --> 00:10:12,410
كان هكذا لمدّة ساعة

163
00:10:12,410 --> 00:10:15,290
،سواء كانت قوّة أو توازناً

164
00:10:15,290 --> 00:10:16,810
لا ترى مثله إلّا واحد في كلّ عشرة آلاف

165
00:10:18,250 --> 00:10:19,870
،لكن من باب الحيطة

166
00:10:19,870 --> 00:10:21,640
سأُراقبه فترة أطول

167
00:10:46,900 --> 00:10:50,600
،سواء كان تحمُّلاً وتوازناً، أو قوّة ومهارة

168
00:10:50,600 --> 00:10:52,890
أدّاها بشكل مثاليّ

169
00:10:52,890 --> 00:10:56,200
هذا هو المُرشّح المُحارب الّذي أُريد

170
00:10:59,560 --> 00:11:02,950
،كنتَ تختبئ هناك لفترة طويلة
حان وقت الكشف عن نفسك

171
00:11:05,100 --> 00:11:07,680
لم أتوقّع أن يمتلك بصيرة حادّة كهذه أيضاً

172
00:11:07,680 --> 00:11:12,310
اخرج الآن، وإلّا فالسكّينة التّالية
لن تُخطئ هدفها

173
00:11:13,840 --> 00:11:15,620
كشفَني منذ زمن بعيد

174
00:11:15,620 --> 00:11:18,720
بل وتجنّب أذيّتي عمداً

175
00:11:19,940 --> 00:11:22,910
هذا هو المُحارب المثاليّ الّذي كنتُ أبحث عنه

176
00:11:23,450 --> 00:11:25,120
اهدأ يا فير

177
00:11:25,120 --> 00:11:26,890
أحتاج اختباراً إضافيّاً فقط

178
00:11:30,080 --> 00:11:34,120
أنا من أشدّ المُعجبات بك

179
00:11:34,120 --> 00:11:38,620
قطعتُ كلّ هذا الطّريق فقط
لألتقط صورة معك

180
00:11:38,620 --> 00:11:41,910
عودي إلى المنزل. لا أحتاج مُعجبين

181
00:11:41,910 --> 00:11:43,680
أريد خصوماً جديرين

182
00:11:45,120 --> 00:11:48,080
أجل، ها أنت ذا

183
00:11:48,640 --> 00:11:51,770
أنت الشّخص الّذي أبحث عنه

184
00:11:52,870 --> 00:11:55,640
قلتُ لكِ. لا أريد مُعجبين

185
00:11:57,520 --> 00:12:01,390
تعال معي

186
00:12:09,180 --> 00:12:13,020
لم أستخدم إلّا تعديل الصّوت
ونسيتُ سحر الجمال

187
00:12:17,790 --> 00:12:20,160
ملك الأدغال" خجول إلى هذا الحدّ؟"

188
00:12:20,160 --> 00:12:22,370
مُحال أن يكون مُحارباً

189
00:12:24,180 --> 00:12:29,000
أين أستطيع إيجاد شخص شُجاع
بما يكفي ولديه المهارة

190
00:12:29,000 --> 00:12:32,000
ولا يكترث إن كان مشهوراً أو ثريّاً؟

191
00:12:33,370 --> 00:12:35,970
!لحظة... نسيتُها

192
00:12:49,720 --> 00:12:52,850
تمّت استعادة هذه المناطق

193
00:13:08,640 --> 00:13:11,250
يا لها من صدفة. كنتُ آخذ
،نوار في نزهة فحسب

194
00:13:11,250 --> 00:13:13,170
ولم أتوقّع أن أصادفكِ هنا

195
00:13:14,630 --> 00:13:16,200
مشي؟

196
00:13:19,750 --> 00:13:21,750
لم أتوقّع أن نقطع هذه المسافة البعيدة

197
00:13:22,650 --> 00:13:24,810
حسناً، ما الّذي جاء بك إلى هنا؟

198
00:13:24,810 --> 00:13:27,870
.المنظر الطّبيعيّ هنا مُبهر
أنا هنا للرّسم

199
00:13:27,870 --> 00:13:29,470
ر-رسم؟

200
00:13:33,030 --> 00:13:35,250
الطّبيعة هنا فريدة من نوعها

201
00:13:35,250 --> 00:13:36,330
لديكِ ذوق حسن

202
00:13:36,330 --> 00:13:37,480
!لا تتحرّك

203
00:13:37,480 --> 00:13:39,000
...هذا

204
00:13:40,160 --> 00:13:45,070
قد ينسى النّاس بقايا الشّياطين

205
00:13:51,440 --> 00:13:53,370
،كبشريّة

206
00:13:53,370 --> 00:13:56,200
إنّها تدفن هؤلاء الشّياطين الّذين
ماتوا منذ زمن بعيد

207
00:13:56,200 --> 00:13:59,200
،لم أتوقّع، خلف قساوتها الخارجيّة

208
00:13:59,200 --> 00:14:01,820
أن أجد قلباً رقيقاً كقلبها

209
00:14:03,080 --> 00:14:04,350
اسمحي لي بمُساعدتكِ

210
00:14:09,700 --> 00:14:12,120
غالباً لم يتوقّع هؤلاء الشّياطين

211
00:14:12,120 --> 00:14:15,020
أنّ من يجمع بقاياهم سيكون بشريّاً

212
00:14:17,370 --> 00:14:21,220
كان هذا مكاناً مُشترك للشّياطين والبشر

213
00:14:21,950 --> 00:14:25,680
،كانوا يتعايشون معاً بسلام لعصور

214
00:14:26,330 --> 00:14:30,270
إلى أن سبّبَ مُخطّطٌ شرّيرٌ انهيار كلّ شيء

215
00:14:31,040 --> 00:14:33,200
كان البشر والشّياطين يعيشون معاً؟

216
00:14:33,200 --> 00:14:34,750
كيف لهذا أن يكون مُمكناً؟

217
00:14:34,750 --> 00:14:37,870
السّلام بين البشر والشّياطين هو محض وهم

218
00:14:38,710 --> 00:14:40,140
ماذا عنك؟

219
00:14:42,200 --> 00:14:46,220
هل تعتقد بأنّ العلاقات مع آي ولافي
ودينو هي أوهام أيضاً؟

220
00:14:55,750 --> 00:14:57,750
هل تلك أوهام؟

221
00:14:58,600 --> 00:15:00,360
ليس تماماً

222
00:15:02,390 --> 00:15:04,580
من يتوقّع أنّ خلف ذلك الوجه المُخيف

223
00:15:04,580 --> 00:15:07,330
لديها فهم وبصيرة عميقان هكذا؟

224
00:15:07,330 --> 00:15:12,680
قويّة

225
00:15:08,540 --> 00:15:12,680
شُجاعة

226
00:15:09,750 --> 00:15:12,680
حكيمة

227
00:15:10,750 --> 00:15:12,680
شغوفة

228
00:15:12,680 --> 00:15:16,850
هذه هي الصّفات الّتي أبحث
عنها في مُحارب مثاليّ

229
00:15:17,200 --> 00:15:19,960
تأخّر الوقت. ينبغي أن أعود الآن

230
00:15:20,770 --> 00:15:22,990
لحظة، أنتِ المُرشّحة المثاليّة

231
00:15:22,990 --> 00:15:25,810
الّتي كنتُ أبحث عنها لهزيمة ملك الشّياطين

232
00:15:26,110 --> 00:15:28,600
أتوسّل إليكِ أن تصبحي المُحاربة

233
00:15:28,910 --> 00:15:30,580
لستُ مُؤهّلة لأكون مُحاربة

234
00:15:30,580 --> 00:15:32,230
ينبغي أن تبحث عن شخص آخر

235
00:15:34,670 --> 00:15:36,750
إنّها مُتواضعة للغاية

236
00:15:36,750 --> 00:15:38,680
نوار، لنلحق بها

237
00:15:40,240 --> 00:15:42,580
.تبدو حقيبة الظّهر هذه ثقيلة
دعيني أساعدكِ في حملها

238
00:15:42,580 --> 00:15:43,810
لا، شكراً

239
00:15:43,810 --> 00:15:46,450
هلّا أعدتِ النّظر في ذلك العرض؟

240
00:15:46,450 --> 00:15:47,680
لا

241
00:15:47,680 --> 00:15:50,370
لا ترفضي بهذه السّرعة

242
00:15:50,370 --> 00:15:52,330
هناك كثير من المزايا الّتي
تترافق مع العمل كبطل

243
00:15:52,330 --> 00:15:53,440
اسمحي لي بشرح الأمر لكِ

244
00:15:53,440 --> 00:15:54,370
لا داعي

245
00:15:54,370 --> 00:15:59,520
أجل، أنتِ نبيلة جدّاً، لذا أنا متأكّد
بأنّكِ تهتمّين كثيراً للآخرين

246
00:15:59,520 --> 00:16:01,900
لِمَ تركّزين على منافع صغيرة؟

247
00:16:01,900 --> 00:16:06,000
لإنقاذ البشريّة جمعاء، يجب أن
تصبحي مُحاربة أيضاً

248
00:16:06,000 --> 00:16:07,470
سنتكلّم لاحقاً

249
00:16:13,580 --> 00:16:18,180
تبّاً، ألم نتّفق على تقاسُم
الأعمال المنزليّة بالتّساوي؟