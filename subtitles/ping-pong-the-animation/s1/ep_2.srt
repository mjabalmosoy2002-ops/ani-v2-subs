198
00:11:58,220 --> 00:11:59,650
.إنه حلمي

199
00:12:00,090 --> 00:12:02,140
.أنا لستُ مثلك

200
00:12:02,140 --> 00:12:02,870
.نعم

201
00:12:03,420 --> 00:12:05,530
.الأمر سهل، بالنسبة لي

202
00:12:05,990 --> 00:12:09,810
