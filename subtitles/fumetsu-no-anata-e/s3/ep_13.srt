1
00:00:00,940 --> 00:00:05,270
أُرسِلت رسالة إلى يوكي من
خلال صلصال طينيّ

2
00:00:05,550 --> 00:00:08,150
الكائن الّذي أنشأ "القانون" الّذي هو فوشي

3
00:00:08,150 --> 00:00:12,400
دمّره واللّغز خلف حياة فوشي قد يُحَلّ

4
00:00:20,640 --> 00:00:22,200
سأفعلها

5
00:00:22,200 --> 00:00:23,670
!انظروا إليّ وأنا أفعلها

6
00:00:24,380 --> 00:00:28,650
يطلب فوشي المُساعدة من بشريّ مُعيّن

7
00:02:04,640 --> 00:02:08,180
أين مقعدي ثانية؟

8
00:02:08,180 --> 00:02:11,470
ماذا؟ إنّه هناك

9
00:02:11,470 --> 00:02:12,760
شكراً

10
00:02:17,950 --> 00:02:22,280
ميزوها، هل هناك شيء يُضايقكِ؟

11
00:02:22,280 --> 00:02:24,500
سأساعدكِ بأيّ طريقة تحتاجينها

12
00:02:25,420 --> 00:02:27,210
أخبرتُك

13
00:02:27,210 --> 00:02:28,260
إنّها قادمة

14
00:02:29,040 --> 00:02:33,250
هل من الغريب حقّاً رؤيتي أنسجم مع ميزوها؟

15
00:02:33,250 --> 00:02:35,110
ليس تماماً. أيضاً، ماذا؟

16
00:02:35,110 --> 00:02:36,460
لم نقل شيئاً أبداً

17
00:02:39,670 --> 00:02:40,870
!وجدتُها

18
00:02:40,870 --> 00:02:43,020
لنخرج جميعنا معاً في مُواعدة

19
00:02:43,020 --> 00:02:44,760
أنتما وأنا وميزوها

20
00:02:44,760 --> 00:02:47,520
يمكننا أن نكون أصدقاء أفضل
حتّى بهذا الشّكل

21
00:02:47,520 --> 00:02:48,820
هيّا بنا

22
00:02:48,820 --> 00:02:50,350
!فكّروا في الأمر

23
00:02:50,350 --> 00:02:51,350
فونا

24
00:02:52,390 --> 00:02:54,360
لماذا لم تكوني في التّمرين الصّباحيّ؟

25
00:02:54,360 --> 00:02:55,610
لقد أثرتِ قلقي

26
00:02:56,270 --> 00:02:58,740
ماذا تقصدين بـ"هاه؟" هل أنتِ بخير؟

27
00:02:58,740 --> 00:03:00,850
تغيّرتِ في هذه الأيّام

28
00:03:00,850 --> 00:03:02,620
لا أراكِ مع ساكي والآخرين

29
00:03:02,620 --> 00:03:04,010
هل حدث شيء؟

30
00:03:04,010 --> 00:03:06,210
أعتقد بأنّني أبدو غريبة أطوار؟

31
00:03:06,210 --> 00:03:08,890
أجل. هل تشاجرتِ مع أحد أو ما شابه؟

32
00:03:08,890 --> 00:03:11,720
لا أعرف كيف أتقرّب منهم

33
00:03:11,720 --> 00:03:13,830
يهربون باستمرار قبل أن نتمكّن
من التكلّم حقّاً

34
00:03:13,830 --> 00:03:15,200
هكذا إذاً

35
00:03:15,200 --> 00:03:19,550
أولئك الثّلاثة معاً دوماً لأنّ هذا
يجعلهم يشعرون أنّهم أقوى

36
00:03:19,550 --> 00:03:22,550
تكلّمي مع كلّ واحد منهم على حِدة
وسترينهم مُختلفين

37
00:03:22,550 --> 00:03:24,050
هذا منطقيّ

38
00:03:24,050 --> 00:03:25,180
!شكراً

39
00:03:25,180 --> 00:03:27,050
!وتعالي إلى النّادي

40
00:03:27,050 --> 00:03:29,060
الجميع يفتقدونكِ

41
00:03:29,060 --> 00:03:34,590
تذكّري بأنّ النّاس قلقون عليكِ حتّى
لو لم يقولوا شيئاً

42
00:03:40,440 --> 00:03:43,030
المعذرة، ساكي... سان؟

43
00:03:43,030 --> 00:03:45,350
هل فكّرتِ في تلك المُواعدة؟

44
00:03:45,350 --> 00:03:48,160
ماذا؟ ولِمَ أفعل ذلك؟

45
00:03:48,160 --> 00:03:49,070
لِمَ لا؟

46
00:03:49,070 --> 00:03:50,620
هل تكرهينني؟

47
00:03:50,880 --> 00:03:52,690
أم لأنّكِ تكرهين ميزوها؟

48
00:03:52,690 --> 00:03:53,970
كلاهما

49
00:03:53,970 --> 00:03:54,740
لماذا؟

50
00:03:56,330 --> 00:03:58,730
ليس لديكِ حدود

51
00:03:58,730 --> 00:04:00,160
وميزوها لديها الكثير جدّاً من الحدود

52
00:04:00,160 --> 00:04:01,610
لهذا لا أحبّكما

53
00:04:01,610 --> 00:04:02,390
وداعاً

54
00:04:02,390 --> 00:04:04,570
...المعذرة

55
00:04:05,250 --> 00:04:06,390
!مهلاً

56
00:04:07,520 --> 00:04:08,710
خذي هذه

57
00:04:09,170 --> 00:04:09,930
ماذا؟

58
00:04:09,930 --> 00:04:12,670
هل سيجعلنا هذا صديقتين؟

59
00:04:12,670 --> 00:04:14,470
!بالطّبع لا

60
00:04:15,590 --> 00:04:16,540
مهلاً

61
00:04:17,180 --> 00:04:18,260
يمكنكِ الحصول على هذه

62
00:04:18,260 --> 00:04:19,110
لماذا؟

63
00:04:19,390 --> 00:04:21,480
ظننتُ أنّ ذلك قد يدعنا نتصالح

64
00:04:22,360 --> 00:04:25,700
لماذا تفكّرين بذلك حتّى؟

65
00:04:25,700 --> 00:04:28,230
أليس من الأفضل أن نكون صديقتين
بدلاً من ألّا نكون؟

66
00:04:28,230 --> 00:04:29,580
صديقتان؟

67
00:04:29,920 --> 00:04:31,820
اسلكي طريقكِ الخاصّ

68
00:04:31,820 --> 00:04:33,630
بينما سأبقى هنا

69
00:04:33,630 --> 00:04:34,870
هذا كلّ ما في الأمر

70
00:04:34,870 --> 00:04:37,100
صديقتان؟ عمّاذا تتكلّمين؟

71
00:04:37,100 --> 00:04:39,020
المسألة تتعلّق بحيث تتواجدين

72
00:04:39,020 --> 00:04:40,970
وأنا سأسلك هذا الطّريق

73
00:04:40,360 --> 00:04:42,000
!ا-ا-انتظري

74
00:04:42,000 --> 00:04:46,070
ميزوها صنعتْ زينة الشّعر هذه لأجلكِ

75
00:04:46,070 --> 00:04:47,130
لأجلي؟

76
00:04:47,130 --> 00:04:48,710
...في الواقع

77
00:04:48,710 --> 00:04:51,090
لأجلكِ يا ناغيسا-سان

78
00:04:51,460 --> 00:04:54,260
هذا مُريب

79
00:05:01,200 --> 00:05:02,230
كاسابي-سان

80
00:05:02,650 --> 00:05:04,360
يمكنكِ أخذ هذه

81
00:05:04,360 --> 00:05:06,360
أليس هذا الشّيء الّذي كانت
ميزوها ترتديه؟

82
00:05:06,360 --> 00:05:08,390
أجل. قالت بأنّها ستعطيه لك

83
00:05:08,390 --> 00:05:10,080
لماذا تخبرينني بهذا؟

84
00:05:10,080 --> 00:05:12,500
كنتِ تغدرين بميزوها أكثر من أيّ شخص

85
00:05:12,500 --> 00:05:14,790
والآن تتظاهرين بأنّكِ صديقتها الحميمة؟

86
00:05:14,790 --> 00:05:15,950
لا أدري

87
00:05:15,950 --> 00:05:19,620
لكنك تتظاهرين بأنّكِ تكرهين ميزوها أيضاً

88
00:05:20,110 --> 00:05:22,630
!كـ-كفى كلاماً فارغاً

89
00:05:23,790 --> 00:05:25,230
يمكنكِ الحصول على هذه

90
00:05:25,230 --> 00:05:26,340
إنّها من ميزوها

91
00:05:29,820 --> 00:05:31,230
توناري-سينباي

92
00:05:31,680 --> 00:05:34,170
لديك واحدة من هذه أيضاً، صحيح؟

93
00:05:34,170 --> 00:05:36,260
ماذا؟ أجل

94
00:05:36,260 --> 00:05:39,520
لم تُرِد ذلك في البداية، لكنّها
فعلَتْها لأجلي

95
00:05:39,520 --> 00:05:40,260
أليس كذلك؟

96
00:05:42,370 --> 00:05:44,480
كلّ واحدة منّا حصلتْ على واحدة أيضاً

97
00:05:44,480 --> 00:05:46,990
أنتِ من صنع هذه، أليس كذلك
يا ميزوها-سينباي؟

98
00:05:46,990 --> 00:05:48,530
شكراً جزيلاً لكِ

99
00:05:48,530 --> 00:05:51,070
ماذا؟ من أعطاكما إيّاها؟

100
00:05:51,070 --> 00:05:53,290
فونا-سينباي

101
00:05:53,290 --> 00:05:57,580
تفضّل

102
00:05:57,850 --> 00:05:58,580
تعال

103
00:05:58,930 --> 00:06:00,290
!ميزوها

104
00:06:00,290 --> 00:06:02,220
—طلّاب السّنة الأولى يحبّون هذه الزّينة

105
00:06:02,220 --> 00:06:03,610
تعال إلى هنا فحسب

106
00:06:04,900 --> 00:06:06,890
أنت تستمتع، أليس كذلك يا فوشي؟

107
00:06:07,210 --> 00:06:09,510
ماذا تفعل بهذا الشّكل؟

108
00:06:09,510 --> 00:06:14,850
لم أستطع إعادة عائلتك، لكن ارتأيتُ
...ربّما إذا كنتُ في المدرسة

109
00:06:15,160 --> 00:06:17,070
لا أعرف ما الّذي تتحدّث عنه

110
00:06:17,450 --> 00:06:21,340
أردتُ صنع مكان حيث يمكنك
أن تكوني سعيدة

111
00:06:21,340 --> 00:06:24,160
وذلك كي لا تُفكّري في الموت

112
00:06:24,410 --> 00:06:27,490
مكان حيث يمكنني أن أكون سعيدة؟

113
00:06:30,660 --> 00:06:34,480
وكانت فكرتك هو توزيع هذه الأشياء؟

114
00:06:34,480 --> 00:06:37,170
مُكذِّباً بأنّني أنا من صنعها؟

115
00:06:38,500 --> 00:06:40,640
كان ينبغي أن أفعلها بطريقة أُخرى

116
00:06:40,640 --> 00:06:45,140
أعتقد بأنّ الكذِب بشأن ذلك كان مُهيناً
لكِ ولكلّ شخص أعطيتُه إيّاها

117
00:06:45,630 --> 00:06:48,770
اهتممتَ لأمري

118
00:06:49,070 --> 00:06:51,640
لدرجة أنّك استحوذتَ على جسد فونا لأجلي

119
00:06:51,990 --> 00:06:53,930
أصبحتَ هي، كلّ ذلك لأجلي

120
00:06:54,570 --> 00:06:56,120
أنا مُمتنّة لذلك

121
00:06:56,120 --> 00:07:00,220
هذا يعني أنّك قبلتَني وقبلتَ
القارعين وكلّ شيء

122
00:07:00,640 --> 00:07:05,340
لم أتوقّع أبداً أن أسمعك تتحدّثين
عن القارعين بهذا الشّكل

123
00:07:05,340 --> 00:07:07,010
هل أنتِ ميزوها؟

124
00:07:07,010 --> 00:07:09,290
أم أنّكِ القارع الّذي يتظاهر بأنّه ميزوها؟

125
00:07:09,290 --> 00:07:10,820
أليس هذا واضحاً؟

126
00:07:10,820 --> 00:07:12,440
أنا ميزوها

127
00:07:13,370 --> 00:07:18,580
ذلك اليوم الّذي رفضتني به، حدّثني
...القارع الخاص بفونا-سان

128
00:07:18,830 --> 00:07:22,630
عنّا وعن القارعين

129
00:07:23,000 --> 00:07:26,230
عندما عدتُ إلى المنزل، بدأت
يدي اليسرى تتحرّك من تلقاء نفسها

130
00:07:26,230 --> 00:07:29,970
بدت أمّي وأبي سعيدين عندما رأيا ذلك

131
00:07:30,430 --> 00:07:34,180
جعلَني ذلك أُدرك بأنّني مُميّزة
في نهاية المطاف

132
00:07:35,830 --> 00:07:39,130
يبدو أنّك عقلك قد فَسُد كذلك

133
00:07:39,490 --> 00:07:42,090
أنا آسف لأنّني لم أستطع إنقاذك

134
00:07:42,600 --> 00:07:45,690
لكن سأستمرّ في المُحاولة

135
00:07:45,690 --> 00:07:50,570
لا أريد أن يكون القارعون هم من ينقذونك
من مُعاناتكِ، إنّما أن تكوني أنتِ

136
00:07:51,060 --> 00:07:55,280
أكره القارعين، لكن هذا ليس كلّ شيء

137
00:07:55,280 --> 00:07:57,030
...أنا فقط... في الواقع

138
00:07:57,550 --> 00:08:01,610
لا أعتقد أنّه من الصّواب جعل القارعين
يتحمّلون ألمكِ بالنّيابة عنكِ

139
00:08:01,610 --> 00:08:04,660
ما زلتِ لم تقبلي نفسكِ

140
00:08:04,660 --> 00:08:09,040
وكأنّ الجرح تحت ضمادتك لم يُشفَ أبداً

141
00:08:09,560 --> 00:08:13,000
يبدو أنّكِ لم تتعافي تماماً من جروحكِ

142
00:08:13,860 --> 00:08:15,740
هذا ليس بالأمر الجلل يا فوشي

143
00:08:15,740 --> 00:08:18,180
القارعون أشبه بدواء أنفلونزا

144
00:08:18,510 --> 00:08:20,530
عندما تتألّم فإنّه يُخفّف ألمك

145
00:08:20,530 --> 00:08:21,690
هذا كلّ شيء

146
00:08:21,690 --> 00:08:22,750
ليس بالأمر الجلل؟

147
00:08:22,750 --> 00:08:25,810
ألا يمكننا التخلّص من ذلك القارع إذاً؟

148
00:08:26,950 --> 00:08:28,780
...لا أعلم

149
00:08:29,220 --> 00:08:33,490
إذا كنتَ ستُخفّف ألمي بدلاً
من ذلك، فلا مانع

150
00:08:33,490 --> 00:08:34,880
بالطّبع

151
00:08:34,880 --> 00:08:36,420
سأبذل قصارى جهدي لفعل ذلك

152
00:08:36,420 --> 00:08:37,500
افعلها الآن

153
00:08:37,910 --> 00:08:42,830
لا أكره أن يتمّ التحكُّم بي بواسطتك هكذا

154
00:08:43,610 --> 00:08:47,200
ميزوها، لم أكن أعلم بأنّكِ شهوانيّة هكذا

155
00:08:47,200 --> 00:08:50,720
لطالما ظننتُ بأنّكِ مُتزمّتة. عجباً

156
00:08:50,720 --> 00:08:54,750
ماذا؟ ما الّذي كنتُ... لا أعلم

157
00:08:54,750 --> 00:08:55,930
اعتذري

158
00:08:56,290 --> 00:08:58,880
اعتذري على قتلي

159
00:08:59,330 --> 00:09:02,170
بالتّأكيد، شعرتُ بأنّني أموت

160
00:09:02,170 --> 00:09:04,860
وكنتُ أتكلّم بسوء عنك

161
00:09:04,860 --> 00:09:07,730
لم تكن هناك أيّ مُشكلة بموتي

162
00:09:07,730 --> 00:09:10,310
لكن هذا لا يعني أنّه ينبغي لكِ قتلي، صحيح؟

163
00:09:10,310 --> 00:09:13,910
آسفة، لكن لم أكن أنا من قتلكِ

164
00:09:13,910 --> 00:09:16,030
تقصدين ذلك القارع؟

165
00:09:16,030 --> 00:09:17,750
أتقصدين بأنّ لديكِ واحد منهم في داخلكِ؟

166
00:09:17,750 --> 00:09:21,090
بدا وكأنّكِ كنتِ تستمتعين بذلك

167
00:09:21,090 --> 00:09:22,430
هذا مُبهج، أليس كذلك؟

168
00:09:22,430 --> 00:09:24,080
كنتُ أُراقب طوال الوقت

169
00:09:24,080 --> 00:09:25,580
تُراقبين؟

170
00:09:25,580 --> 00:09:27,490
أجل، كنتُ شبحاً

171
00:09:27,740 --> 00:09:29,800
استطعتُ رؤية غرفتكِ

172
00:09:30,520 --> 00:09:34,510
بعض الكلام الّذي كنتِ تقولينه
كان مُخزياً جدّاً أيضاً

173
00:09:34,940 --> 00:09:37,390
لكن لم أُمانع ذلك

174
00:09:38,760 --> 00:09:40,350
الكثير من المُفاجآت

175
00:09:41,920 --> 00:09:43,640
وبعض الأشياء الّتي أسعدَتْني

176
00:09:43,640 --> 00:09:48,020
تذكّري أنّ النّاس قلقون عليكِ
حتّى لو لم يقولوا شيئاً

177
00:09:48,860 --> 00:09:53,660
تبيّن بأنّ حياتي لم تكن سيّئة جدّاً
لدرجة أنّني أردتُ شخصاً أن يقتلني

178
00:09:53,660 --> 00:09:55,780
يسرّني أنّني متُّ وذلك كي
أتمكّن من اكتشاف ذلك

179
00:09:55,780 --> 00:10:00,050
لكن ليس وكأنّني مُمتنّة لكِ على قتلي

180
00:10:01,030 --> 00:10:03,130
كيف ذلك إذا كنتِ لا تريدين الاعتذار؟

181
00:10:03,130 --> 00:10:04,850
كلتانا نعرف سرّ بعضنا الآخر

182
00:10:04,850 --> 00:10:07,660
أعتقد سيكون لدينا الكثير
من الأشياء للحديث عنها

183
00:10:07,660 --> 00:10:09,670
ليس كصديقتين

184
00:10:09,670 --> 00:10:11,920
لكن، ليس عليكِ فعل ذلك
إذا لم تُريدي

185
00:10:12,230 --> 00:10:13,400
هل نتعاهد؟

186
00:10:27,060 --> 00:10:28,170
ميزوها

187
00:10:28,890 --> 00:10:31,420
ما رأيك؟ نلتُ منها، صحيح؟

188
00:10:31,420 --> 00:10:32,670
نلتِ منها؟

189
00:10:32,670 --> 00:10:35,310
ظننتُ بأنّك أعدتني إلى الحياة
لأنّك أردت مُساعدتي

190
00:10:35,610 --> 00:10:38,870
لا، فعلتُ ذلك كي لا تُؤخَذي

191
00:10:38,870 --> 00:10:39,860
ماذا تقول؟

192
00:10:39,860 --> 00:10:42,250
لستُ أفهم حقّاً، لكن هذا يجعلني
!أشعر بدفء في الدّاخل

193
00:10:42,250 --> 00:10:45,770
آسف. أشعر وكأنّني أقحمتُك في كلّ هذا

194
00:10:45,770 --> 00:10:47,790
لا، لا عليك

195
00:10:48,130 --> 00:10:50,620
أخطأتُ ثانية

196
00:10:50,620 --> 00:10:53,270
لم يفلح الأمر إطلاقاً بعد كلّ تلك الجهود

197
00:10:53,830 --> 00:10:55,030
...المعذرة

198
00:10:56,100 --> 00:11:00,130
هل يمكنني الحصول على زينة
الشّعر تلك يا فونا؟

199
00:11:00,470 --> 00:11:02,550
...فـ-في الواقع

200
00:11:04,600 --> 00:11:05,280
ماذا؟

201
00:11:05,250 --> 00:11:06,570
توجد واحدة هنا

202
00:11:08,130 --> 00:11:09,890
آسفة، هل ستَفي هذه بالغرض؟

203
00:11:10,300 --> 00:11:11,560
شكراً

204
00:11:12,990 --> 00:11:15,730
آسفة لصُراخي قبل فترة

205
00:11:16,220 --> 00:11:19,360
لا أُمانع

206
00:11:19,360 --> 00:11:22,660
بالمناسبة، هل يمكنني المجيء
في المرّة المُقبلة؟

207
00:11:22,330 --> 00:11:23,310
...مهلاً

208
00:11:22,660 --> 00:11:25,270
لنتحدّث عن الشّباب وما شابه ثانية

209
00:11:25,270 --> 00:11:26,360
حسناً

210
00:11:34,090 --> 00:11:37,940
وكانت فكرتك هو توزيع هذه الأشياء؟

211
00:11:53,890 --> 00:11:55,650
ها أنتِ ذي

212
00:11:55,990 --> 00:11:57,280
هل أنتِ بخير؟

213
00:11:58,260 --> 00:11:59,700
...بخصوص ما حدث

214
00:12:01,900 --> 00:12:05,490
هل ما زلنا نستطيع أن نكون صديقتين؟

215
00:12:06,080 --> 00:12:10,580
إن كنّا نستطيع، فهل يمكنكِ أن تخبريني
بما لم تخبريني به بعد؟

216
00:12:16,440 --> 00:12:19,000
!لـ-لا تفعلي ذلك

217
00:12:19,000 --> 00:12:21,260
أنتِ واقعة في حُبّ شخص بالفعل

218
00:12:21,260 --> 00:12:23,250
...أعلم بأنّ كلتينا فتاتان، لكن

219
00:12:23,530 --> 00:12:25,960
أحبّك يا هانّا

220
00:12:25,960 --> 00:12:29,260
هل تحبّينني يا هانّا؟

221
00:12:29,260 --> 00:12:31,680
...أ... أجل، لكن

222
00:12:31,970 --> 00:12:33,330
لا مُشكلة إذاً

223
00:12:33,330 --> 00:12:36,360
...لا... أعلم بشأن ذلك

224
00:12:36,360 --> 00:12:38,540
أنتِ لا تقصدين من تلك النّاحية، صحيح؟

225
00:12:40,000 --> 00:12:42,980
لا أدري ما الّذي أعنيه

226
00:12:43,520 --> 00:12:45,080
أتريدين فعلها ثانية؟

227
00:12:46,640 --> 00:12:48,650
أنتِ غريبة أطوار يا ميزوها

228
00:12:48,650 --> 00:12:50,580
ظننتُكِ تحبّين فوشي-كن

229
00:12:50,580 --> 00:12:52,430
ما الّذي يجعلكِ تعتقدين ذلك؟

230
00:12:52,430 --> 00:12:54,280
هذا واضح وضوح الشّمس

231
00:12:54,280 --> 00:12:56,450
آسفة لجعلكِ تغارين

232
00:12:56,450 --> 00:12:57,620
لكنّني لستُ كذلك

233
00:12:57,960 --> 00:13:00,120
الأمر فقط هو أنّه يحبّني

234
00:13:00,120 --> 00:13:01,780
هو؟

235
00:13:01,780 --> 00:13:04,940
...لاحظتُ بأنّه مهتمّ بكِ، لكن

236
00:13:06,170 --> 00:13:08,010
ما الّذي يجعلكِ تعتقدين ذلك؟

237
00:13:08,010 --> 00:13:09,530
رأيتُ ما كان يفعله

238
00:13:09,530 --> 00:13:11,230
هذا غير مُقنع جدّاً

239
00:13:11,540 --> 00:13:14,590
رأيتُ ما فعله قبل مدّة

240
00:13:14,840 --> 00:13:17,230
أو... كنتُ أتنصّت على ما أعتقد

241
00:13:17,230 --> 00:13:19,650
كان أوكي-كن ليحبّ سماع ما سمعتُه

242
00:13:19,650 --> 00:13:21,610
يوكي-كن يعلم

243
00:13:21,610 --> 00:13:23,620
ماذا؟ يـ-يعلم؟

244
00:13:24,030 --> 00:13:27,940
الجميع قلقون عليّ لأنّهم يحبّونني

245
00:13:29,600 --> 00:13:32,020
هل أنتِ متأكّدة من أنّكِ بخير؟

246
00:13:32,020 --> 00:13:37,180
إن كان هناك ما يمكنني فعله للمُساعدة
في إسعادكِ، فأتمنّى ذلك

247
00:13:38,790 --> 00:13:42,550
هل يمكنني أن أكون الرّقم واحد
في نظرك إذاً؟

248
00:13:42,550 --> 00:13:43,870
لحظة، ماذا؟

249
00:13:43,870 --> 00:13:45,200
الرّقم واحد في نظري؟

250
00:13:46,060 --> 00:13:47,420
كجائزة؟

251
00:13:47,420 --> 00:13:48,450
لا

252
00:13:48,450 --> 00:13:51,360
آسفة، لم أفهم

253
00:13:52,450 --> 00:13:56,180
أنتِ مُملّة جدّاً وسطحيّة. أتعلمين ذلك؟

254
00:13:56,180 --> 00:14:00,020
لهذا أسّستِ نادي المصنوعات الحِرفيّة
غريب الأطوار ذاك بنفسكِ

255
00:14:00,430 --> 00:14:04,690
ألن يفرح شخصٌ مثلكِ بوجود فتاة
خالية من أيّ عيوب مثلي كصديقة؟

256
00:14:05,090 --> 00:14:06,950
هذا هو الشّعور الّذي راودكِ؟

257
00:14:07,290 --> 00:14:09,650
أجل. ألم تشعري بذلك؟

258
00:14:11,730 --> 00:14:14,460
أنتِ ماهرة جدّاً في ذلك. مُذهل

259
00:14:14,720 --> 00:14:16,180
شكراً

260
00:14:16,180 --> 00:14:18,570
يمكنكِ الحصول على هذه إن أردتِ

261
00:14:18,570 --> 00:14:20,680
أريد هذه

262
00:14:21,790 --> 00:14:23,840
إنّه عيد ميلادي اليوم

263
00:14:23,840 --> 00:14:25,110
حقّاً؟

264
00:14:25,110 --> 00:14:28,030
هيّا، دعيني أحصل على تلك. من فضلكِ

265
00:14:28,030 --> 00:14:30,030
يا لكِ من بائسة

266
00:14:30,030 --> 00:14:30,840
مُوافقة

267
00:14:30,840 --> 00:14:32,250
حسناً

268
00:14:32,250 --> 00:14:34,260
إنّها هديّة عيد ميلادكِ إذاً

269
00:14:34,770 --> 00:14:36,260
!شكراً

270
00:14:36,260 --> 00:14:37,660
!مرحى

271
00:14:37,660 --> 00:14:41,610
،إنّها مُبهرَجة زيادة عن اللّزوم بالنّسبة لي
...لكن بالنّسبة لكِ

272
00:14:41,910 --> 00:14:48,790
الفتاة الأجمل والأمهر في سنَتي
الدّراسيّة تكلّمت معي بلطف

273
00:14:48,790 --> 00:14:49,680
ما رأيكِ؟

274
00:14:49,680 --> 00:14:50,820
يبدو جميلاً

275
00:14:51,100 --> 00:14:53,920
أنا سعيدة للغاية

276
00:14:55,450 --> 00:14:56,590
بئساً لهذا

277
00:15:01,460 --> 00:15:03,500
!انتظري يا هانّا! لا

278
00:15:06,630 --> 00:15:08,090
...فوشي

279
00:15:17,570 --> 00:15:19,950
هذه هي نهاية يوم آخر

280
00:15:19,950 --> 00:15:22,180
يجب عليّ القيام بالمزيد ابتداء من الغد

281
00:15:22,180 --> 00:15:24,280
لإسقاط القارعين

282
00:15:24,280 --> 00:15:25,440
لكن كيف؟

283
00:15:32,480 --> 00:15:33,690
ميموري

284
00:15:33,690 --> 00:15:35,090
لم أرك منذ وقت

285
00:15:35,090 --> 00:15:36,550
فوشي-سان

286
00:15:36,550 --> 00:15:38,280
كيف حال هيروتوشي؟

287
00:15:38,620 --> 00:15:43,800
إنّه بخير الآن بعد أن ملأتْه المُؤسّسة بالإبر

288
00:15:43,800 --> 00:15:45,740
حقّاً؟ هذا رائع

289
00:15:45,740 --> 00:15:47,640
ما هذا؟

290
00:15:47,640 --> 00:15:50,620
المهارة السّرّية: لفت انتباه-نو-جوتسو

291
00:15:51,000 --> 00:15:55,340
تصنع واحدة وتتباهى بها، فيحترمك
النّاسُ وتصبح مشهوراً

292
00:15:55,340 --> 00:15:58,370
علّمَني هيروتوشي-سان

293
00:15:59,300 --> 00:16:01,610
!علّميني كيفيّة صنع واحدة

294
00:16:01,610 --> 00:16:02,470
حسناً

295
00:16:03,340 --> 00:16:06,790
هل تنسجمين مع الأطفال في المدرسة؟

296
00:16:06,790 --> 00:16:09,180
عادت الأمور إلى طبيعتها الآن

297
00:16:09,180 --> 00:16:10,370
طبيعتها؟

298
00:16:10,370 --> 00:16:11,270
أجل

299
00:16:11,960 --> 00:16:13,950
ميموري، لنلعب لعبة مُراوغة الكُرة

300
00:16:16,900 --> 00:16:19,100
ما الخطب؟ أنتِ غريبة أطوار

301
00:16:19,100 --> 00:16:21,440
ميموري تغيّرت ثانية

302
00:16:21,440 --> 00:16:24,440
كانت أفضل ممّا كانت من قبل

303
00:16:25,390 --> 00:16:31,740
،الآن بعد أن عدتُ إلى حيث كنتُ
لم يعُد أحد يتكلّم معي

304
00:16:31,740 --> 00:16:33,480
كيف حال أمّك؟

305
00:16:33,480 --> 00:16:35,820
لا فرق حقيقيّ

306
00:16:35,820 --> 00:16:36,970
حقّاً؟

307
00:16:37,370 --> 00:16:39,590
لكن لا مُشكلة

308
00:16:39,590 --> 00:16:42,880
أعتقد بأنّني أستطيع الصّمود هذه المرّة

309
00:16:43,260 --> 00:16:46,240
ما الّذي يمكنني فعله لأكون قويّاً مثلكِ؟

310
00:16:46,240 --> 00:16:47,580
قويّاً؟

311
00:16:48,550 --> 00:16:50,830
لا أظنّني قويّة

312
00:16:50,830 --> 00:16:53,610
لكن يبدو أنّك تبلي بلاء أفضل

313
00:16:53,610 --> 00:16:55,180
على الأقلّ، هكذا يبدو الأمر بالنّسبة لي

314
00:16:55,180 --> 00:16:57,110
...أنا مسرورة إذاً

315
00:16:57,410 --> 00:16:59,890
لأنّ القارع أخذ جسدي

316
00:17:00,590 --> 00:17:01,930
أنتِ مسرورة؟

317
00:17:01,930 --> 00:17:02,930
أجل

318
00:17:02,930 --> 00:17:06,470
،لو لم يأخذ القارع جسدي

319
00:17:06,470 --> 00:17:09,830
لما عدتُ بعد أن متُّ في المدرسة

320
00:17:10,320 --> 00:17:12,300
...هذا ما أعتقده، لكن

321
00:17:12,300 --> 00:17:14,150
لنبدأ من الصّفر

322
00:17:14,150 --> 00:17:17,560
لكن حاول القارع استخدام جسدكِ

323
00:17:17,560 --> 00:17:18,830
هذا غير صحيح

324
00:17:18,830 --> 00:17:20,840
أنا من كنتُ يستخدمه

325
00:17:21,230 --> 00:17:23,270
وربحتُ

326
00:17:24,750 --> 00:17:26,570
إنّها جاهزة

327
00:17:26,570 --> 00:17:28,850
!إنّها لامعة جدّاً

328
00:17:28,850 --> 00:17:31,280
ستنبهر ماتشي

329
00:17:32,270 --> 00:17:34,650
أتساءل ما الّذي تُخطّط له الآن

330
00:17:35,040 --> 00:17:38,580
وتقولين بأنّكِ لن تعودي إلى المنزل
ما لم تقضي عليهم

331
00:17:38,580 --> 00:17:40,580
هل سيكون ذلك بعد مئتي عام؟

332
00:17:40,580 --> 00:17:42,000
أربعمئة عام؟

333
00:17:43,200 --> 00:17:44,630
ماتشي؟

334
00:17:44,630 --> 00:17:47,110
إنّها... فرد من عائلتي

335
00:17:47,110 --> 00:17:48,920
أختك؟

336
00:17:48,920 --> 00:17:50,740
...لا، أقرب إلى

337
00:17:50,740 --> 00:17:52,550
أمّي؟

338
00:17:52,550 --> 00:17:55,670
أتنادي أمّك بالاسم؟

339
00:17:56,020 --> 00:17:58,570
عائلتي غريبة أطوار قليلاً

340
00:17:58,570 --> 00:18:00,940
مثل غوغو، الّذي يرتدي قناعاً دوماً

341
00:18:00,940 --> 00:18:02,170
غوغو؟

342
00:18:02,170 --> 00:18:04,440
أخي الأكبر

343
00:18:04,440 --> 00:18:06,010
ستُصدَمين إذا رأيتِه

344
00:18:06,010 --> 00:18:07,940
يعيش أصدقائي معي أيضاً

345
00:18:07,940 --> 00:18:11,060
و... يمكن تسميتهم بزملائي في العمل؟

346
00:18:11,060 --> 00:18:12,980
الكثير من الحيوانات أيضاً

347
00:18:12,980 --> 00:18:14,620
يبدو هذا مُمتعاً

348
00:18:15,670 --> 00:18:18,490
آمل أن يكون الجميع بخير الآن

349
00:18:19,410 --> 00:18:22,300
ميموري، لنعُد إلى المنزل

350
00:18:22,300 --> 00:18:23,640
عليّ الذّهاب

351
00:18:23,640 --> 00:18:24,390
حسناً

352
00:18:25,840 --> 00:18:28,290
ماذا عنكِ؟ هل تستمتعين بحياتكِ
في المنزل؟

353
00:18:28,290 --> 00:18:31,020
سوف أبدأ بالاستمتاع بها

354
00:18:32,480 --> 00:18:34,220
انظري يا أمّي

355
00:18:34,220 --> 00:18:36,160
ما هذه؟ هل التقطتِها في مكان ما؟

356
00:18:36,160 --> 00:18:38,160
أنا من صنعها. إنّها كُرة وحليّة

357
00:18:38,160 --> 00:18:40,170
لا تدخلي بها، اتّفقنا؟ إنّها قذرة

358
00:18:42,380 --> 00:18:43,990
!فوشي

359
00:18:44,980 --> 00:18:46,220
ميزوها

360
00:18:46,850 --> 00:18:49,080
أعتقد بأنّ هانّا تكرهني

361
00:18:49,080 --> 00:18:52,060
هل ارتكبتُ خطأ؟

362
00:18:52,060 --> 00:18:53,310
ماذا حدث؟

363
00:18:54,060 --> 00:18:55,390
لا أعلم

364
00:18:55,390 --> 00:18:56,860
لا أستطيع قولها

365
00:18:58,200 --> 00:19:01,290
لكن لا تلومي نفسكِ من فضلكِ

366
00:19:01,290 --> 00:19:02,230
...فوشي

367
00:19:02,820 --> 00:19:04,800
أنت لطيف حقّاً

368
00:19:05,480 --> 00:19:07,620
أجل. ستكونين بخير

369
00:19:07,620 --> 00:19:09,830
أنا متأكّد بأنّ الأمور ستكون على ما يُرام

370
00:19:09,830 --> 00:19:11,230
على ذكر الأمر

371
00:19:11,230 --> 00:19:12,540
مُدّي يدكِ

372
00:19:13,910 --> 00:19:15,320
يمكنكِ أخذ هذه

373
00:19:15,320 --> 00:19:16,830
صنعتُها للتو

374
00:19:17,110 --> 00:19:18,900
لكنّها ليست جيّدة جدّاً

375
00:19:18,900 --> 00:19:20,290
ما هذه؟

376
00:19:20,290 --> 00:19:22,460
المهارة السّرّية: لفت انتباه-نو-جوتسو

377
00:19:22,460 --> 00:19:26,230
قد تتمكّنين من مُصالحة هانّا
إذا تعلّمتِ صنع واحدة

378
00:19:26,530 --> 00:19:29,820
تأخّر الوقت اليوم، لذا سأعلّمكِ
كيفيّة صنع واحدة في يوم آخر

379
00:19:29,820 --> 00:19:30,780
وداعاً

380
00:19:31,160 --> 00:19:33,120
انتظر يا فوشي

381
00:19:33,120 --> 00:19:34,850
ليست هذه

382
00:19:38,000 --> 00:19:39,700
!فوشي، انتظر

383
00:19:39,700 --> 00:19:41,710
!لم تحلّ أيّ شيء

384
00:19:44,790 --> 00:19:48,000
ما زلتُ أبكي، ألا ترى؟

385
00:19:48,000 --> 00:19:49,130
بلى

386
00:19:49,130 --> 00:19:51,910
ماذا تقصد بـ"بلى"؟ لماذا تغادر؟

387
00:19:51,910 --> 00:19:54,040
آسف، ماذا يجدر بي أن أفعل؟

388
00:20:04,100 --> 00:20:05,460
!ماتشي، عُدت

389
00:20:05,460 --> 00:20:06,430
!انظري إلى هذه

390
00:20:06,430 --> 00:20:08,830
!ما هذه؟ إنّها لامعة جدّاً

391
00:20:08,830 --> 00:20:10,000
إنّها كُرة وحليّة

392
00:20:10,000 --> 00:20:12,230
مُذهل! أنت من صنع هذه يا فو-تشان؟

393
00:20:12,230 --> 00:20:14,240
هذا صحيح يا ماتشي

394
00:20:14,520 --> 00:20:16,420
سأعلّمكِ كيفيّة صنع واحدة

395
00:20:16,420 --> 00:20:18,340
سيجعل هذا الجميع يحبّونكِ

396
00:20:18,340 --> 00:20:19,910
!حقّاً؟

397
00:20:22,770 --> 00:20:24,320
!شكراً لك يا فو-تشان

398
00:20:24,320 --> 00:20:25,950
!أنا سعيدة للغاية

399
00:20:28,310 --> 00:20:31,930
لا تكرهني أرجوك

400
00:20:32,550 --> 00:20:33,410
حسناً

401
00:20:33,410 --> 00:20:35,500
أراكِ غداً

402
00:20:36,730 --> 00:20:38,260
إلى أين أنت ذاهب؟

403
00:20:38,260 --> 00:20:40,460
إلى المنزل بالطّبع

404
00:20:43,080 --> 00:20:46,720
القارعون يسكنون داخل أولئك
المُتلهّفين للموت

405
00:20:46,720 --> 00:20:48,340
هذا ما قاله القارع

406
00:20:48,790 --> 00:20:51,120
هناك الكثير من الطّعام اللّذيذ لأكله

407
00:20:51,120 --> 00:20:52,840
الكثير من المنازل المتينة

408
00:20:52,840 --> 00:20:54,810
والكثير من الأشياء المُمتعة

409
00:20:54,810 --> 00:20:57,320
لا يوجد حتّى وقت للحزن

410
00:20:57,720 --> 00:21:00,600
فلماذا تريدين الموت؟

411
00:21:01,250 --> 00:21:05,910
بصراحة لا أفهم سبب رغبة أحد
في الموت في عالم كهذا

412
00:21:06,300 --> 00:21:09,240
أنا متأكّد بأنّ ماتشي وغوغو والجميع
يراودهم نفس التّفكير

413
00:21:09,850 --> 00:21:14,840
بأنّ هذا العالم أسعد بكثير من الزّمن
الّذي كانوا فيه مُنهكين من القتال

414
00:21:15,690 --> 00:21:17,380
!عدتُ يا رِفاق

415
00:21:17,380 --> 00:21:19,660
!أهلاً بعودتك يا فو-تشان

416
00:21:21,670 --> 00:21:23,810
الهدوء فظيع

417
00:21:27,130 --> 00:21:29,270
بنى ورشة

418
00:21:29,270 --> 00:21:30,970
أنا سعيد لأجلك يا كاي

419
00:21:32,130 --> 00:21:34,480
وهناك أغراض بناء الأجسام الخاصّة بغوغو

420
00:21:36,010 --> 00:21:37,060
...أليس هذا

421
00:21:43,940 --> 00:21:45,050
من أنت؟

422
00:21:45,050 --> 00:21:46,070
!هل أنت بخير؟

423
00:21:46,070 --> 00:21:46,910
!تماسك

424
00:21:50,150 --> 00:21:51,370
إيكو؟

425
00:21:52,690 --> 00:21:53,870
!ماتشي

426
00:21:54,340 --> 00:21:55,530
!ماذا حدث؟

427
00:21:57,820 --> 00:22:00,260
دام؟

428
00:22:00,780 --> 00:22:02,170
!انتظري

429
00:22:02,170 --> 00:22:03,260
!ماذا يعني "دام"؟

430
00:22:03,690 --> 00:22:05,190
!غوغو! بون

431
00:22:05,190 --> 00:22:06,260
!هل أنتما هنا؟

432
00:22:06,260 --> 00:22:07,170
!توناري

433
00:22:07,430 --> 00:22:09,330
أخفض صوتك

434
00:22:09,330 --> 00:22:11,440
عدتَ إلى المنزل للتو. لِمَ كلّ هذا الصّراخ؟

435
00:22:11,440 --> 00:22:12,830
هل حدث شيء؟

436
00:22:12,830 --> 00:22:14,290
...ماتشي وإيكو

437
00:22:14,290 --> 00:22:15,410
استرخِ

438
00:22:15,410 --> 00:22:19,190
علّمهما مُدرّبٌ كيفيّة الإمساك بعيدان
الطّعام وكيفيّة الكتابة وما شابه

439
00:22:20,890 --> 00:22:23,360
حاولتْ أن تكتب "دونت"؟

440
00:22:23,360 --> 00:22:26,000
أنا مشغولة بالدّراسة. أخفض صوتك

441
00:22:26,000 --> 00:22:27,140
دراسة؟

442
00:22:27,140 --> 00:22:29,020
لدينا امتحانات نهائيّة في الأسبوع المُقبل

443
00:22:29,020 --> 00:22:30,830
امتحانات نهائيّة؟

444
00:22:32,290 --> 00:22:35,740
لا مزيد من صنع سيوف دون رخصة. مفهوم؟

445
00:22:35,740 --> 00:22:37,070
...كاي

446
00:22:37,070 --> 00:22:39,090
لا ترتكب نفس الخطأ مرّتين

447
00:22:39,800 --> 00:22:42,010
!غوغو! هايرو

448
00:22:42,510 --> 00:22:44,490
ماذا حدث لكما؟

449
00:22:50,220 --> 00:22:56,440
لا أعتقد بأنّهم سُعداء

450
00:24:31,880 --> 00:24:37,660
هل يمكن أن يكون عالم مُسالم
بلا قتال عالماً مثاليّاً؟

451
00:24:38,590 --> 00:24:44,650
حنين الوطن الخاصّ بغوغو
...ومشاعر هايرو الحقيقيّة

452
00:24:45,700 --> 00:24:51,270
يُصاب فوشي بالهمّ خلال
اكتشافه لأماني أصدقائه