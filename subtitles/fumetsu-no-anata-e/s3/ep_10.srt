1
00:00:01,030 --> 00:00:05,930
أخو ميموري، هيروتوشي، يتحدّى قارعاً في معركة

2
00:00:06,580 --> 00:00:08,070
...يا للأسف

3
00:00:09,820 --> 00:00:12,280
أريد أن أعيش

4
00:00:12,280 --> 00:00:15,030
!أريد أن أعيش أيضاً

5
00:00:16,570 --> 00:00:19,030
هذه هي نهاية قضيّتك

6
00:00:19,820 --> 00:00:22,880
يكشف قارع آخر عن نفسه

7
00:00:24,000 --> 00:00:26,670
هل أنتِ عدوّ؟ أم حليف؟

8
00:00:27,210 --> 00:00:28,990
حاليّاً، عدوّ

9
00:02:05,270 --> 00:02:08,040
أنا سعيد جدّاً لأجل ميموري-تشان

10
00:02:08,040 --> 00:02:08,760
أجل

11
00:02:09,490 --> 00:02:12,130
،بفضل قرارها في عدم الذّهاب إلى الجنّة

12
00:02:12,130 --> 00:02:13,990
استطعنا إعادتها إلى الحياة

13
00:02:13,990 --> 00:02:16,730
عَلِقَتْ في هذا العالم بعد أن ماتت

14
00:02:16,730 --> 00:02:18,820
ربّما أرادتْ فعلاً أن تعيش

15
00:02:18,820 --> 00:02:25,530
قال ذلك القارع بأنّه أراد الاستحواذ تحديداً
على جسد شخص أراد الموت

16
00:02:25,810 --> 00:02:28,750
ماذا عن القارعين الآخرين إذاً؟

17
00:02:28,750 --> 00:02:30,900
ماذا عن الفتاة حاملة الناغيناتا؟

18
00:02:31,900 --> 00:02:34,490
هل أخبرتك إيزومي-سان بشيء؟

19
00:02:34,490 --> 00:02:36,920
لم تظهر مؤخّراً

20
00:02:36,920 --> 00:02:39,000
فين ونيكسون مفقودان أيضاً

21
00:02:39,000 --> 00:02:40,510
ما الّذي يجري؟

22
00:02:41,870 --> 00:02:44,810
،أعلم بأنّ لدينا الكثير لنتعامل معه

23
00:02:44,810 --> 00:02:47,470
لكن لنكتفِ بهذا القدر اليوم ونحصل
على بعض الرّاحة في المنزل

24
00:02:47,470 --> 00:02:50,020
لا، لن أذهب إلى المنزل بعد

25
00:02:51,000 --> 00:02:53,350
يجب أن أهزم القارعين

26
00:02:53,590 --> 00:02:55,760
لا أستطيع تركهم فحسب

27
00:02:55,760 --> 00:02:58,040
فضلاً عن ذلك، إنّهم يستهدفونني

28
00:02:58,040 --> 00:03:00,820
.إنّهم يُراقبونني ويستهدفونني
غالباً حتّى في هذه اللّحظات

29
00:03:00,820 --> 00:03:02,780
!ماذا؟! يُراقبوننا؟

30
00:03:02,780 --> 00:03:04,490
!هل يستمعون إلى مُحادثتنا الآن؟

31
00:03:04,900 --> 00:03:06,110
!لست بأمان بمفردك

32
00:03:06,110 --> 00:03:07,270
!يجب أن نرسم خطّة

33
00:03:07,270 --> 00:03:08,510
!هيّا بنا نعود

34
00:03:09,240 --> 00:03:12,170
لن أعود إلى المنزل قبل أن
أقضي على كافّة القارعين

35
00:03:21,160 --> 00:03:22,080
ميزوها

36
00:03:23,850 --> 00:03:26,060
ما مُشكلة فوشي برأيك؟

37
00:03:26,060 --> 00:03:27,850
لم يأتِ إلى المدرسة منذ فترة طويلة

38
00:03:27,850 --> 00:03:30,060
إنّه يُلفِت الأنظار بصورة سلبيّة

39
00:03:30,300 --> 00:03:31,750
هذه ليست غلطته

40
00:03:31,750 --> 00:03:33,030
يقول بأنّه مشغول

41
00:03:33,030 --> 00:03:38,020
سمعتُ بأنّكما خرجتُما معاً
في الأحد الماضي

42
00:03:38,020 --> 00:03:39,670
أجل

43
00:03:40,030 --> 00:03:43,980
،المعذرة، لا أُحبّ التكلّم بهذه الطّريقة

44
00:03:44,270 --> 00:03:48,470
لكن سمعتُ بأنّه كان يخدع
الكثير من الفتيات

45
00:03:48,470 --> 00:03:49,880
—لا أعتقد بأنّه ينبغي لكِ

46
00:03:48,770 --> 00:03:51,200
أهذا ما أردت أن تحدّثني عنه
يا ريكويا-كن؟

47
00:03:51,490 --> 00:03:52,910
أتريدين أن نمشي معاً؟

48
00:03:53,200 --> 00:03:54,910
أنا عائدة إلى المنزل مع فوشي اليوم

49
00:03:54,910 --> 00:03:56,540
يراودني شعور بأنّه قريب

50
00:03:56,540 --> 00:03:57,380
ما مُشكلتكِ؟

51
00:03:57,680 --> 00:03:59,170
هل أنتِ جادّة؟

52
00:04:11,850 --> 00:04:15,140
من أخبركِ أن تفعلي
ما فعلتِه في الأمس؟

53
00:04:16,820 --> 00:04:18,200
فوشي-كن؟

54
00:04:18,200 --> 00:04:19,320
هل كان الحُماة؟

55
00:04:19,650 --> 00:04:21,560
هل هم من أمروكِ؟

56
00:04:21,560 --> 00:04:22,670
الحُماة؟

57
00:04:22,670 --> 00:04:24,310
...سمعتُ عنهم، لكن

58
00:04:24,310 --> 00:04:27,540
النّاغيناتا خاصّتكِ هو نفسه
الّذي كان مع هاياسي

59
00:04:27,540 --> 00:04:28,840
هاياسي؟

60
00:04:28,840 --> 00:04:31,000
لحظة، التقينا ببعضنا الآخر البارحة؟

61
00:04:31,000 --> 00:04:32,380
لستِ أنتِ

62
00:04:32,380 --> 00:04:34,880
أسأل القارعة الّتي بداخلكِ

63
00:04:34,880 --> 00:04:36,720
عمّاذا تتكلّم بالضّبط؟

64
00:04:37,130 --> 00:04:39,000
سأسألكِ إذاً

65
00:04:39,390 --> 00:04:41,200
هل تريدين أن تموتي أيضاً؟

66
00:04:44,920 --> 00:04:47,050
من أخبرك بذلك؟

67
00:04:47,050 --> 00:04:48,780
ساكي؟ ناغيسا؟

68
00:04:48,780 --> 00:04:50,090
...ماذا؟ لا

69
00:04:50,940 --> 00:04:52,260
هذا مُقرف جدّاً

70
00:04:52,260 --> 00:04:54,620
!انتظري، ما زال لديّ أسئلة

71
00:04:56,690 --> 00:04:58,860
...مهلاً

72
00:05:06,660 --> 00:05:08,230
!لا شيء

73
00:05:11,540 --> 00:05:14,760
!أنت

74
00:05:14,760 --> 00:05:16,880
!ألم تكن على علاقة حُبّ مع ميزوها؟

75
00:05:16,880 --> 00:05:18,590
على... ماذا؟

76
00:05:22,030 --> 00:05:23,680
ريكويا-كن، توقّف

77
00:05:24,020 --> 00:05:27,130
!هل لديك فكرة عن مشاعر ميزوها تجاهك؟

78
00:05:27,610 --> 00:05:29,800
—ميزوها تستحقّ أفضل منـ

79
00:05:39,020 --> 00:05:42,020
أنتِ فتاة حقّاً في نهاية المطاف

80
00:05:43,390 --> 00:05:44,950
...ميزوها

81
00:05:44,950 --> 00:05:46,820
هل تحاولين الدّخول

82
00:05:46,820 --> 00:05:50,040
في علاقة بائسة حيث لا يمكن
للحقيقة أن ترتقي لآمالكِ؟

83
00:05:50,600 --> 00:05:55,460
أنتِ فتاة مثاليّة، باستثناء
من تلك النّاحية

84
00:05:55,950 --> 00:05:59,050
رغم أنّني أحبُّ ذلك فيكِ

85
00:05:57,190 --> 00:05:58,610
أتريد المزيد؟

86
00:05:58,610 --> 00:05:59,570
أجل

87
00:06:13,380 --> 00:06:15,220
ريكويا، ما الأمر؟

88
00:06:15,220 --> 00:06:16,560
حان وقت النّهوض

89
00:06:25,840 --> 00:06:29,980
هل سمعتِ؟ تكسّرتْ كافّة عِظام ريكويا-كن

90
00:06:29,980 --> 00:06:31,570
ماذا؟ مستحيل

91
00:06:37,070 --> 00:06:39,490
أجل. أثناء نومه

92
00:06:39,490 --> 00:06:41,790
الشّرطة في منزله

93
00:06:41,790 --> 00:06:43,100
مُخيف للغاية

94
00:06:43,100 --> 00:06:43,900
...أجل

95
00:06:44,670 --> 00:06:45,620
...يا رئيسة

96
00:06:46,610 --> 00:06:48,250
ألقاكِ لاحقاً يا ساياكا

97
00:06:48,250 --> 00:06:49,580
أجل، ألقاكِ غداً

98
00:06:50,090 --> 00:06:52,750
سمعتُ عن ريكويا-سينباي

99
00:06:52,750 --> 00:06:54,310
يبدو الأمر خطيراً

100
00:06:54,310 --> 00:06:56,170
جريمة حقيقيّة

101
00:06:56,170 --> 00:06:58,340
إذاً لم يُقبَض على أحد بعد

102
00:06:58,340 --> 00:06:59,770
!كيف يُعقَل ذلك؟

103
00:07:00,090 --> 00:07:04,090
هذا اختطافٌ بواسطة كائن حيّ
!من خارج الأرض

104
00:07:04,090 --> 00:07:08,220
خطفتْه مخلوقات فضائيّة
!وعبثوا بأحشائه

105
00:07:08,220 --> 00:07:10,990
!أريد أن أُخطَف يوماً ما

106
00:07:12,190 --> 00:07:13,190
ميزوها

107
00:07:13,190 --> 00:07:14,420
!هانّا

108
00:07:14,420 --> 00:07:15,540
...ريكويا-كن، إنّه

109
00:07:16,920 --> 00:07:20,030
لم أركِ بهذا الانفعال من قبل

110
00:07:20,030 --> 00:07:23,000
كنتُ جافّة جدّاً معه في الأمس

111
00:07:23,000 --> 00:07:25,750
كان ينبغي أن أكون ألطف

112
00:07:25,750 --> 00:07:27,770
لا تلومي نفسكِ رجاء

113
00:07:27,770 --> 00:07:29,620
أنتِ بخير كما أنتِ

114
00:07:33,570 --> 00:07:36,160
أنا سعيدة لأنّكِ عانقتِني

115
00:07:36,160 --> 00:07:38,660
سأكون معكِ هنا إذا سمحتِ لي

116
00:07:48,230 --> 00:07:49,800
...قبل خمسمئة سنة

117
00:07:49,800 --> 00:07:54,040
شعرتُ حتماً بكاهاكو وزوال
القارع عن ذراعه اليسرى

118
00:07:54,460 --> 00:07:58,310
ظننتُ بأنّها كانت نهاية تدخُّل
الحُماة مع القارعين

119
00:07:58,310 --> 00:08:03,420
لكن إذا كانت حادثة ميموري من صنيع
الحُماة، فيجب أن أتعامل معهم

120
00:08:03,950 --> 00:08:06,390
أريد أن أسألهم بشكل مُباشر
،عمّا يُخطّطون له

121
00:08:06,390 --> 00:08:09,010
لكن القارعة الخاصّة بفونا لا تظهر

122
00:08:09,010 --> 00:08:10,380
هل ينبغي أن أتجسّس عليها؟

123
00:08:10,950 --> 00:08:14,270
لكن من المُؤكّد أنّهم يُراقبون ما أفعله

124
00:08:14,630 --> 00:08:17,070
ما الّذي يجري بالضّبط؟

125
00:08:17,070 --> 00:08:18,100
لستُ أفهم

126
00:08:18,670 --> 00:08:22,440
وجدتُها! يمكنني الانكماش
إلى حجم القارعين

127
00:08:25,180 --> 00:08:26,390
سأجرّب ذلك

128
00:08:26,850 --> 00:08:30,060
يجب أن أؤمن بأنّ القارعين
سوف يفقدون أثري

129
00:08:30,060 --> 00:08:31,110
!تحرّك بشكل أسرع

130
00:08:31,660 --> 00:08:34,380
كُن أصغر حتّى وتوارَ عن الأنظار

131
00:08:34,790 --> 00:08:37,990
قيّم العدوّ بشموليّة أكبر

132
00:08:42,080 --> 00:08:44,070
!لذيذ، لذيذ

133
00:08:47,810 --> 00:08:50,160
ماذا تريدين؟

134
00:08:50,760 --> 00:08:53,590
أقدّمكِ لكِ التّطهير والارتقاء

135
00:08:53,590 --> 00:08:55,190
—ما الّذي

136
00:09:00,340 --> 00:09:02,800
لـ-لماذا؟

137
00:09:10,490 --> 00:09:12,120
لا تقلقي

138
00:09:12,120 --> 00:09:13,950
سأكون معكِ

139
00:09:15,480 --> 00:09:16,530
!توقّفي

140
00:09:23,360 --> 00:09:24,800
...ميزوها

141
00:09:30,450 --> 00:09:32,120
ما هذا؟

142
00:09:32,120 --> 00:09:32,830
لماذا؟

143
00:09:33,260 --> 00:09:34,200
!فوشي

144
00:09:36,530 --> 00:09:38,340
!هذا هو سؤالي

145
00:09:38,340 --> 00:09:39,430
!لماذا تفعلين هذا؟

146
00:09:47,280 --> 00:09:48,470
!ميزوها

147
00:09:50,190 --> 00:09:52,040
لا أتذكّر

148
00:10:02,810 --> 00:10:04,100
حسناً

149
00:10:04,860 --> 00:10:09,370
إن كنتِ تتألّمين لدرجة
،تريدين الموت

150
00:10:09,670 --> 00:10:11,440
فأريد أن أُساعدكِ

151
00:10:11,980 --> 00:10:13,350
...فوشي

152
00:10:16,300 --> 00:10:19,830
أعرف كيف يمكنك فعل ذلك

153
00:10:21,340 --> 00:10:23,560
يجب أن تحبّني

154
00:10:33,200 --> 00:10:34,440
...فوشي

155
00:10:38,690 --> 00:10:40,090
...المعذرة

156
00:10:41,070 --> 00:10:43,680
آسف، لستُ أفهمكِ

157
00:10:43,680 --> 00:10:47,280
لكن سأفعل أيّ شيء
لتشعري بتحسُّن

158
00:10:54,420 --> 00:10:58,540
قد أشعر بتحسُّن إذا عانقتني هكذا

159
00:11:08,640 --> 00:11:10,930
تهانينا

160
00:11:31,510 --> 00:11:33,840
مضى وقتٌ طويل يا فوشي

161
00:11:33,840 --> 00:11:35,200
هذا أنا

162
00:11:35,200 --> 00:11:37,630
الّذي كان بداخل الحُماة لأجيال

163
00:11:38,300 --> 00:11:39,940
القارع

164
00:11:44,120 --> 00:11:47,630
يسرّني أنّنا التقينا من جديد

165
00:11:47,630 --> 00:11:50,850
!لم أنسَ ما حدث قبل 500 عام

166
00:11:50,850 --> 00:11:53,500
بالفعل. لم أنسَ أيضاً

167
00:11:53,500 --> 00:11:56,260
آنذاك، كنتُ قلقاً بشأن ما إن كنتُ
أستطيع أن أُخلَق من جديد

168
00:11:56,260 --> 00:12:00,060
بكلّ المعرفة والذّكريات الّتي
جمعتُها في الأرض

169
00:12:00,330 --> 00:12:03,900
،وبموت مُضيفي، كاهاكو

170
00:12:03,900 --> 00:12:06,160
حان الوقت لي لأرتقي إلى الجنّة

171
00:12:06,160 --> 00:12:08,040
...لكن بعد 500 عام

172
00:12:08,500 --> 00:12:09,960
أريد أن أموت

173
00:12:10,320 --> 00:12:16,530
كنتُ مُجبَراً على إعادة تجسيد
نفسي بنداء استغاثة من ميزوها

174
00:12:16,530 --> 00:12:19,950
،بتشجيع من نظرائي

175
00:12:16,530 --> 00:12:21,540
!يمكنك فعلها! هيّا، هيّا! أجل

176
00:12:19,950 --> 00:12:23,000
استجمعتُ الشّجاعة لمُغادرة الجنّة

177
00:12:23,250 --> 00:12:27,150
ركّزتُ وعيي وأسّستُ كياني

178
00:12:27,150 --> 00:12:29,200
وُولِدتُ من جديد

179
00:12:29,590 --> 00:12:31,780
أنا، بصفة نفسي

180
00:12:31,780 --> 00:12:34,280
منحَني ذلك بهجةً تفوق الإيمان

181
00:12:34,680 --> 00:12:38,200
،كالعادة، دخلتُ من خلال الذّراع اليسرى

182
00:12:38,200 --> 00:12:41,840
،ووصلتُ إلى الرّأس، وتجذّرتُ من هناك

183
00:12:41,840 --> 00:12:46,870
وطوّرتُها إلى جسد يسمح لي
بحمايتها في وقت الحاجة

184
00:12:46,870 --> 00:12:49,190
!أيّ تطوُّر؟ هُراء

185
00:12:49,190 --> 00:12:50,430
،تقول بأنّك تحميها

186
00:12:50,430 --> 00:12:52,820
لكنّك تفعل مثلما فعلتَ
!قبل 500 عام

187
00:12:53,100 --> 00:12:55,670
!تتصرّف وكأنّك في صفِّنا وتُهاجمنا

188
00:12:55,670 --> 00:12:56,880
!جعلتَنا نُهاجم أنفسنا

189
00:12:56,880 --> 00:12:59,970
!أنت السّبب في قتل كاهاكو لنفسه

190
00:13:00,460 --> 00:13:02,920
أجل، وقد تأمّلنا ذلك

191
00:13:02,920 --> 00:13:06,250
ارتأينا الآن بأنّنا لا نستطيع
تحقيق السّعادة بهذه الطّريقة

192
00:13:06,250 --> 00:13:09,920
لم نعُد نزهق الأرواح

193
00:13:09,920 --> 00:13:10,930
!ماذا؟

194
00:13:10,930 --> 00:13:11,920
!فعلت للتو

195
00:13:11,920 --> 00:13:13,140
!زهقت روحها

196
00:13:13,440 --> 00:13:15,770
كانت هذه الفتاة عازمة
على قتل نفسها

197
00:13:15,770 --> 00:13:18,050
لم تكن صداقاتها ناجحة

198
00:13:18,940 --> 00:13:22,260
تمنّي الموت هو نفسه عدم الحياة

199
00:13:23,810 --> 00:13:28,180
اللّحم الّذي تدعوه فونا طوّر
مشاعر عاطفيّة تجاهك

200
00:13:28,180 --> 00:13:31,540
سبّبَ ذلك توتُّراً هائلاً لميزوها

201
00:13:31,540 --> 00:13:34,540
لذلك، جعَلْنا الفاي الخاصّ
،بفونا ينتقل إلى الجنّة

202
00:13:34,540 --> 00:13:40,290
وسلّمنا جسدها بالكامل لذلك
القارع المُوالي بالتّحديد

203
00:13:40,290 --> 00:13:42,740
!لم يكن عليك قتلها

204
00:13:42,740 --> 00:13:45,780
ألا تعتقد بأنّ الحلّ الأكثر سلميّة ومنطقيّة؟

205
00:13:45,780 --> 00:13:50,890
،تحرّرتْ ميزوها من توتّرها
وانتقلتْ فونا إلى مكان أفضل

206
00:13:50,890 --> 00:13:52,720
نفس الأمر ينطبق على أمّ ميزوها

207
00:13:53,130 --> 00:13:57,270
كانت أمّ ميزوها مصدراً لألمها

208
00:13:57,270 --> 00:14:01,660
كانت تحاول اكتساب احترام ذاتها
من خلال ابنتها

209
00:14:01,660 --> 00:14:05,770
كانت ميزوها دوماً حريصة على
رسم الابتسامة في وجه أمّها

210
00:14:05,770 --> 00:14:11,160
لكن تحقّقتْ تلك السّعادة
على حساب حياة ميزوها

211
00:14:11,760 --> 00:14:14,820
كانت قِوى ميزوها قد خارت تماماً أيضاً

212
00:14:14,820 --> 00:14:18,720
،تناغمتْ روح ميزوها مع روحي

213
00:14:18,720 --> 00:14:21,920
وقرّرنا التخلُّص من التوتُّر

214
00:14:23,470 --> 00:14:28,110
إذاً، القارع الّذي بداخل إيزومي-سان
هو واحد منكم الآن؟

215
00:14:28,110 --> 00:14:29,650
ماذا تفعلون أصلاً؟

216
00:14:29,650 --> 00:14:32,880
هل تنتهجون مُختلف أشكال الأساليب

217
00:14:32,880 --> 00:14:35,140
للتحكُّم بالحُماة وكسب
المزيد من المُؤمنين؟

218
00:14:35,140 --> 00:14:37,610
ألا تستغلّون الأطفال مثل ميموري؟

219
00:14:39,050 --> 00:14:42,800
.كان القارع الخاصّ بميموري مُتطرّفاً
نعتذر على هذه المتاعب

220
00:14:42,800 --> 00:14:44,730
كان هناك هدفاً خلف ذلك

221
00:14:44,730 --> 00:14:45,990
هدف؟

222
00:14:45,990 --> 00:14:48,000
لا شيء مُهمّ

223
00:14:48,000 --> 00:14:49,700
مُجرّد بحث

224
00:14:54,760 --> 00:14:57,870
ماذا؟ هل ما زلتُم تحاولون قتلي؟

225
00:14:59,160 --> 00:15:00,510
لا

226
00:15:00,510 --> 00:15:04,200
نريد ببساطة العيش معك

227
00:15:10,880 --> 00:15:12,660
...إذاً

228
00:15:12,660 --> 00:15:15,710
لِمَ أنتِ مستاءة يا توناري؟

229
00:15:15,710 --> 00:15:18,190
هل أنتِ مستاءة لأنّها تصبح
جزءاً من مجموعتنا؟

230
00:15:18,190 --> 00:15:20,860
أمّ لأنّ فوشي ينجذب إليها؟

231
00:15:21,250 --> 00:15:23,660
لا يمكن أن يكون الأمر كذلك

232
00:15:23,660 --> 00:15:25,000
...كلّ ما في الأمر

233
00:15:25,310 --> 00:15:27,910
أردتُ حماية أحد من جماعتي

234
00:15:27,910 --> 00:15:29,560
لا يوجد سبب مُحدَّد

235
00:15:29,560 --> 00:15:30,780
كنتُ مُتعلِّقة فحسب

236
00:15:34,730 --> 00:15:35,840
!لا

237
00:15:35,840 --> 00:15:39,130
!لماذا أتذكّر ذلك الهراء ثانية؟

238
00:15:39,130 --> 00:15:43,170
لا بُدّ أنّ شيئاً قد أصاب رأسي
!منذ تحوّلتُ إلى طفلة

239
00:15:43,560 --> 00:15:48,420
أريد فقط أن أؤمن بأنّ هذا
العالم مُسالم

240
00:15:48,900 --> 00:15:52,830
سنعيش في هذا العالم ونموت فيه

241
00:15:54,620 --> 00:15:58,590
هل خطّط فوشي للبقاء معنا للأبد؟

242
00:15:59,180 --> 00:16:01,490
...للولادة من جديد بعد مماتنا

243
00:16:01,490 --> 00:16:03,060
كأصدقاء خالدين

244
00:16:05,500 --> 00:16:07,720
أن أعيش معكم؟

245
00:16:07,720 --> 00:16:09,510
معكم أنتم القارعين؟

246
00:16:09,510 --> 00:16:12,190
هذه أنانيّة مُطلَقة. لا أقبل بذلك

247
00:16:12,190 --> 00:16:13,300
لماذا؟

248
00:16:13,300 --> 00:16:18,160
أعدنا صياغة أساليبنا، وكشفنا
عن مُخطّطنا ونفعل ما تتمنّاه

249
00:16:18,440 --> 00:16:21,510
سنقف بجانب مُضيفيك ونتحمّل ألمك

250
00:16:21,510 --> 00:16:24,160
فأنت تكره الألم

251
00:16:24,580 --> 00:16:27,760
،حتّى الفتاة الّتي تعزّها، ماتشي

252
00:16:27,760 --> 00:16:30,790
قالت بأنّ الحياة يجب ألّا تُزهَق

253
00:16:31,170 --> 00:16:34,550
كانت هي من حمّسَنا

254
00:16:34,550 --> 00:16:37,610
يبدو أنّ جنسكم يريد التّعامل
،معنا بطريقة ما

255
00:16:37,610 --> 00:16:39,650
لكن كنتم مُخطئين تماماً في نيّتكم

256
00:16:39,650 --> 00:16:42,460
يتشارك القارعون نفس الرّؤية
مع الحُماة

257
00:16:42,460 --> 00:16:45,090
نسعى للخلاص للرّوح البشريّة

258
00:16:45,090 --> 00:16:50,020
،من خلال القيام بذلك، نحن لا ننتهك الجسد
إنّما نجعله في الواقع أكثر مرونة

259
00:16:50,020 --> 00:16:51,720
حسناً، هذا عظيم

260
00:16:51,720 --> 00:16:55,820
وما علاقة ذلك بالبحث عن روحي؟

261
00:17:00,940 --> 00:17:02,780
ماذا سنفعل؟

262
00:17:07,940 --> 00:17:11,020
ماذا؟ ماذا كنتُ أفعل؟

263
00:17:13,350 --> 00:17:15,020
...فوشي

264
00:17:15,020 --> 00:17:17,460
هل فعلتُ شيئاً سيّئاً ثانية؟

265
00:17:17,460 --> 00:17:18,550
!لا تلمسيني

266
00:17:18,890 --> 00:17:20,510
...فوشي

267
00:17:20,510 --> 00:17:22,020
أيُّهما أنتِ؟

268
00:17:22,020 --> 00:17:25,540
لا... أرجوك، لا تنظر إليّ هكذا

269
00:17:25,860 --> 00:17:29,350
—تعلم بأنّني إيـ

270
00:17:33,090 --> 00:17:36,590
!عليك أن تُحبّني، أرجوك

271
00:17:38,220 --> 00:17:41,120
!توقّفي عن التحكُّم بي

272
00:17:45,730 --> 00:17:47,860
...فوشي

273
00:17:49,760 --> 00:17:52,080
أنت... بخير؟

274
00:17:59,060 --> 00:18:01,480
اختار القارعون التّعايش

275
00:18:01,860 --> 00:18:04,340
وأصبح العالم مُسالماً

276
00:18:04,800 --> 00:18:07,430
خسرنا بالفعل

277
00:18:07,430 --> 00:18:08,940
!ما الّذي يجري؟

278
00:18:08,940 --> 00:18:11,320
هل كان الأسود مُحقّاً منذ البداية؟

279
00:18:11,320 --> 00:18:13,090
ماذا عنّي إذاً؟

280
00:18:13,090 --> 00:18:16,690
هل عليّ قبول بأنّ هذا
عالم حُرّ ومُسالم؟

281
00:18:16,690 --> 00:18:17,410
...أحدٌ ما

282
00:18:17,890 --> 00:18:18,940
...غوغو

283
00:18:18,940 --> 00:18:21,780
ماذا سيكون رأيه في ظرف كهذا؟

284
00:18:21,780 --> 00:18:26,170
هل أعود إلى المنزل وأخبر
الجميع بما حدث؟

285
00:18:26,950 --> 00:18:28,540
!لا، لا

286
00:18:28,540 --> 00:18:31,030
!سأفسد سلامهم

287
00:18:31,030 --> 00:18:32,900
!أنا من أعدتُهم إلى الحياة

288
00:18:32,900 --> 00:18:35,040
!أريدهم أن يعيشوا حياة مُسالمة

289
00:18:35,040 --> 00:18:38,890
يجب أن أتحمّل المسؤوليّة وأستمرّ
!في جعل هذا العالم مُسالماً

290
00:18:38,890 --> 00:18:40,060
!أستطيع فعلها

291
00:18:40,060 --> 00:18:41,500
!لستُ ضعيفاً

292
00:18:41,500 --> 00:18:43,000
!ساحرص على ذلك

293
00:18:45,470 --> 00:18:47,310
...مؤلم

294
00:18:48,030 --> 00:18:48,890
توناري؟

295
00:18:48,890 --> 00:18:50,050
فوشي؟

296
00:18:50,050 --> 00:18:52,350
!لـ-لم يكن ذلك مُتعمَّداً، مفهوم؟

297
00:18:52,350 --> 00:18:54,560
ماذا أصابك؟ لم تأتِ إلى المنزل

298
00:18:54,560 --> 00:18:56,020
...وهذا اللّباس

299
00:18:56,020 --> 00:18:58,320
تبدو مُريباً تماماً في هذا العالم

300
00:18:58,650 --> 00:19:02,530
لم أشعر برغبة في ارتداء الملابس
الّتي اشترتها لي ميزوها

301
00:19:03,580 --> 00:19:05,240
حقّاً؟

302
00:19:05,630 --> 00:19:07,320
آسف بشأن ذلك اليوم

303
00:19:07,320 --> 00:19:10,950
كان من الخطأ أن أستخدم أجساد
أصدقائكِ دون استئذان

304
00:19:11,810 --> 00:19:12,890
وداعاً

305
00:19:12,890 --> 00:19:14,090
!ا-انتظر لحظة

306
00:19:14,430 --> 00:19:17,300
ينبغي أن يكون أنا من يعتذر

307
00:19:17,300 --> 00:19:21,650
...سمحتُ لنفسي بأن أؤمن بحياتهم
...أوبا، ميا، أوروي

308
00:19:21,650 --> 00:19:24,000
بأنّهم ينتمون لي

309
00:19:24,590 --> 00:19:28,500
الوقت الّذي قضوه معك كان
مُميّزاً بالنّسبة لهم أيضاً

310
00:19:28,500 --> 00:19:32,990
كان ينبغي أن أُدرك بأنّهم
كانوا جزءاً من حياتك

311
00:19:33,230 --> 00:19:38,990
أنا... كنتُ من يتصرّف كما
لو أنّهم ينتمون لي

312
00:19:39,700 --> 00:19:43,800
أنا مُمتنّة حقّاً لما فعلتَه لأجلهم

313
00:19:43,800 --> 00:19:46,020
أُمنياتك تخصُّك أنت

314
00:19:46,020 --> 00:19:49,000
من الخطأ أن أتحكّم بها

315
00:19:49,290 --> 00:19:51,050
لذا ينبغي أن تفعل ما تراه صحيحاً

316
00:19:51,050 --> 00:19:52,460
مع ميزوها أيضاً

317
00:19:52,910 --> 00:19:54,220
شيء من هذا القبيل

318
00:19:54,220 --> 00:19:56,580
على أيّ حال، أنا آسفة يا فوشي

319
00:19:56,580 --> 00:19:58,570
لن أستاء وأبكي أمامك ثانية

320
00:19:58,570 --> 00:20:02,060
أقصد بأنّ عقلي كعقل جدّة عجوز مُتحجّر

321
00:20:04,880 --> 00:20:06,140
ما الخطب؟

322
00:20:06,140 --> 00:20:07,660
هل حدث شيء؟

323
00:20:07,660 --> 00:20:09,600
لا، لا شيء

324
00:20:09,600 --> 00:20:10,610
وداعاً

325
00:20:10,610 --> 00:20:12,060
انتظر

326
00:20:12,340 --> 00:20:14,770
هل للأمر علاقة بسبب غيابك عن المنزل؟

327
00:20:15,380 --> 00:20:16,390
لا

328
00:20:16,740 --> 00:20:18,060
!أخبرني

329
00:20:18,380 --> 00:20:22,110
أنت جزء من حياتي أيضاً

330
00:20:22,110 --> 00:20:24,980
!أنت تهمّني كثيراً

331
00:20:25,250 --> 00:20:27,170
شكراً يا توناري

332
00:20:28,520 --> 00:20:29,930
...فوشي

333
00:20:33,810 --> 00:20:35,040
فوشي

334
00:20:35,550 --> 00:20:36,710
بون

335
00:20:36,710 --> 00:20:39,460
هل أنت بخير؟ تبدو شاحباً

336
00:20:41,800 --> 00:20:43,460
سأصغي إليك

337
00:20:43,460 --> 00:20:45,390
لا، لا شيء

338
00:20:46,360 --> 00:20:49,050
القارعون سيّئون، صحيح؟

339
00:20:49,640 --> 00:20:50,360
ماذا؟

340
00:20:50,360 --> 00:20:51,890
أخبرني رجاء بأنّهم كذلك

341
00:20:52,340 --> 00:20:54,450
أجل، بالطّبع

342
00:20:54,450 --> 00:20:58,620
،حتّى لو كانت حياة المرء مُؤلمة
تنتمي تلك الحياة لذلك الشّخص وحده

343
00:20:58,620 --> 00:21:01,080
لا يحقّ لأحد بأن يستحوذ عليها

344
00:21:01,080 --> 00:21:05,640
وجود المرء ينبغي أن يُمثّله
كافّة تجارب صاحبه

345
00:21:21,900 --> 00:21:23,980
بدأت الأمطار تهطل

346
00:21:23,980 --> 00:21:25,840
ينبغي أن أذهب لإحضارها

347
00:21:25,840 --> 00:21:27,560
لم تأخذ مظّلتها

348
00:21:27,560 --> 00:21:29,140
أنا مُتفاجئ من تذكّركِ لذلك

349
00:21:29,540 --> 00:21:32,020
أنا أمّها. من الطّبيعيّ أن أتذكّر

350
00:21:36,870 --> 00:21:38,360
ألن تأخذي هاتفكِ؟

351
00:21:40,020 --> 00:21:42,190
بلى، شكراً

352
00:21:42,190 --> 00:21:43,700
سأُعدّ اليخنة اللّيلة

353
00:21:43,700 --> 00:21:45,200
ستحبّها كثيراً

354
00:21:45,200 --> 00:21:47,300
حسناً. كوني بخير

355
00:21:59,230 --> 00:22:03,280
ميزوها، ستمرضين هنا

356
00:22:03,280 --> 00:22:06,010
لنعُد إلى المنزل ونتناول يخنة دافئة

357
00:22:09,660 --> 00:22:10,750
أمّي

358
00:22:11,550 --> 00:22:13,690
كيف عرفتِ بأنّني هنا؟

359
00:22:13,690 --> 00:22:15,980
لأنّني أمّكِ

360
00:22:16,610 --> 00:22:17,800
...أمّي

361
00:22:18,440 --> 00:22:20,600
تبدين مُكتئبة

362
00:22:20,600 --> 00:22:23,770
دعيني أُخمّن، فتى تُحبّينه قد صدّكِ عنه

363
00:22:24,080 --> 00:22:25,180
أصبتِ

364
00:22:25,180 --> 00:22:26,600
ويحكِ

365
00:22:26,600 --> 00:22:28,740
أنتِ فتاة مثاليّة يا ميزوها

366
00:22:29,000 --> 00:22:32,210
كلّ ما يهمّ هو أنّكِ تُحبّينه

367
00:22:32,210 --> 00:22:33,940
لا تحتاجين شيئاً آخر

368
00:22:35,150 --> 00:22:37,400
صبّي كلّ حزنكِ عليّ

369
00:22:37,400 --> 00:22:39,760
يجب أن عودي إلى كونكِ
سعيدة ابتداء من الغد

370
00:22:39,760 --> 00:22:40,700
صحيح؟

371
00:22:40,700 --> 00:22:43,600
هذا ليس وجهاً يجب أن
تُبرزه فتاة ظريفة

372
00:22:43,600 --> 00:22:45,200
!أمّي

373
00:22:48,050 --> 00:22:49,660
اهدئي، اهدئي

374
00:22:56,260 --> 00:22:58,830
لا مزيد من التصرُّف كبشريّة

375
00:24:30,980 --> 00:24:35,240
يواجه فوشي أمَّ ميزوها المُزيّفة

376
00:24:36,450 --> 00:24:43,420
لكن التماس ميزوها المُستميت
يُضعف عزيمته

377
00:24:44,550 --> 00:24:47,090
سلالة الحُماة

378
00:24:47,790 --> 00:24:52,710
هي قيد الدّم الّذي لا مهرب منه