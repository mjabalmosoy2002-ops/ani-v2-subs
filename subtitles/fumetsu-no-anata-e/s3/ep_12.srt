1
00:00:01,650 --> 00:00:07,660
يحاول فوشي هزيمة القارع
الّذي يتحكّم بإيزومي

2
00:00:08,940 --> 00:00:13,590
إن كنتَ قلقاً عليّ فعلاً، فمن فضلك
!لا تؤذِ الأشخاص الّذين أهتمّ لأمرهم

3
00:00:23,830 --> 00:00:26,160
ليس عليك إنقاذ ميزوها بعد الآن

4
00:00:26,160 --> 00:00:27,580
فات الأوان بالنّسبة لها

5
00:02:07,710 --> 00:02:11,260
مضى حوالي نصف عام
منذ أتيتُ إلى هنا

6
00:02:13,980 --> 00:02:19,790
،ظننتُ أنّه بعد مئات السّنين
قد بنيتُ عالماً خالياً من القارعين

7
00:02:20,240 --> 00:02:22,220
لكن كنتُ مُخطئاً

8
00:02:22,640 --> 00:02:24,630
ما زال القارعون مُتربّصين

9
00:02:24,630 --> 00:02:28,980
خلقوا شكلاً ظاهريّاً من السّلام
بعدم زهق الأرواح بشكل مُباشر

10
00:02:31,840 --> 00:02:36,630
مُعظم النّاس يعيشون حياتهم دون
أن يعلموا حتّى بوجود القارعين

11
00:02:38,440 --> 00:02:42,530
لكن بعض النّاس احتضنوا القارعين

12
00:02:42,930 --> 00:02:47,800
،وبعضهم اختاروا حياتهم الأصليّة
رغم صعوبتها

13
00:02:48,230 --> 00:02:49,680
سأراك

14
00:02:49,680 --> 00:02:52,480
أتساءل ما إن كانت إيزومي-سان قد تقبّلَتْه

15
00:02:52,480 --> 00:02:56,350
قالت بأنّنا لسنا علينا إنقاذ
...ميزوها بعد الآن، لكن

16
00:02:57,930 --> 00:03:00,050
مُحال أن يكون هذا مُلائماً

17
00:03:12,800 --> 00:03:15,260
ربّما إذا منحنا سينباي
...سبباً للعيش

18
00:03:15,260 --> 00:03:18,450
...لا أصدّق بأنّني كنتُ أريد الموت

19
00:03:19,040 --> 00:03:21,840
لا بُدّ من وجود شيء أستطيع فعله أيضاً

20
00:03:23,780 --> 00:03:25,670
...القارع الخاصّ بفونا

21
00:03:26,110 --> 00:03:28,900
هل يحاول إدخال المزيد
من القارعين خلسة؟

22
00:03:29,200 --> 00:03:31,440
ثمّ ماذا؟ ما الّذي يخطّط له؟

23
00:03:32,590 --> 00:03:34,460
سأغسل الفناجين

24
00:03:34,460 --> 00:03:35,270
هاتها

25
00:03:35,270 --> 00:03:37,100
حسناً. شكراً

26
00:03:43,400 --> 00:03:45,880
ميزوها-سان، هل أنتِ بخير؟

27
00:03:46,460 --> 00:03:47,940
سأعينها قليلاً

28
00:03:49,090 --> 00:03:50,300
شكراً

29
00:03:50,300 --> 00:03:51,460
ها أنتِ ذي

30
00:03:52,600 --> 00:03:54,020
بعيدة جدّاً

31
00:03:54,020 --> 00:03:55,240
...لـ-لا، أنا

32
00:04:04,630 --> 00:04:07,630
يسرّني أنّني في لجنة الصحّة

33
00:04:10,370 --> 00:04:13,950
يبدو أنّها تستطيع علاج نفسها بنفسها
عندما يكون القارع في الواجهة

34
00:04:13,950 --> 00:04:18,430
هل أنا أتوهّم أم أنّ ميزوها وفونا
مُقرّبتان مؤخّراً بشكل مُريب؟

35
00:04:19,700 --> 00:04:21,930
أيّاً يكن. من يأبه؟

36
00:04:21,930 --> 00:04:23,270
لا، هذا غريب

37
00:04:23,270 --> 00:04:26,290
تلكما الفاشلتان تستحقّان بعضهما الآخر

38
00:04:28,040 --> 00:04:30,960
ستُحسَب غائباً إذا ظللت مُجرّد طائر

39
00:04:31,850 --> 00:04:33,010
!كشفَني

40
00:04:33,010 --> 00:04:34,810
لِمَ لا تأتي إلى المدرسة بصورة طبيعيّة؟

41
00:04:34,810 --> 00:04:36,450
الجميع قلقون عليك

42
00:04:36,760 --> 00:04:40,060
،من الأفضل أن تأتي إلى المدرسة
،وإلّا وضعتُك في الكاري

43
00:04:40,060 --> 00:04:41,300
لا، أمزح

44
00:04:42,040 --> 00:04:44,360
!أ-أتقولين كاري؟

45
00:04:44,360 --> 00:04:46,130
!إيّاكِ والمُحاولة

46
00:04:46,130 --> 00:04:47,050
!أنتما

47
00:04:47,340 --> 00:04:51,260
هل تعتقدان بأنّ المُتحوّلين والبشر
يستطيعون التّعايش بسعادة؟

48
00:04:51,260 --> 00:04:52,420
يوكي؟

49
00:04:52,420 --> 00:04:53,650
مُتحوّلون؟

50
00:04:54,730 --> 00:04:55,850
أجل

51
00:04:56,620 --> 00:04:57,940
!صحيح؟

52
00:04:57,940 --> 00:04:59,560
!هذا ما أعتقده أيضاً

53
00:04:59,560 --> 00:05:01,520
!لنتعاهد على ذلك

54
00:05:04,610 --> 00:05:06,460
عمّاذا تتكلّم؟

55
00:05:07,050 --> 00:05:09,020
أصدقاء

56
00:05:10,120 --> 00:05:11,450
!مرحى

57
00:05:11,450 --> 00:05:14,330
!لطالما أردتُ أصدقاء ليسوا ببشر

58
00:05:14,770 --> 00:05:17,870
!حسناً، لنتحدّث لاحقاً

59
00:05:18,740 --> 00:05:19,930
...هل يُعقَل أنّه

60
00:05:19,930 --> 00:05:21,960
هذا ما كان يتحدّث عنه؟

61
00:05:22,360 --> 00:05:24,430
!سنبرم اتّفاق سلام

62
00:05:25,130 --> 00:05:27,280
!هذا كلّ ما يتطلّبه الأمر؟

63
00:05:28,670 --> 00:05:30,180
كيف حال جرحكِ؟

64
00:05:31,880 --> 00:05:32,900
ماذا؟

65
00:05:32,900 --> 00:05:34,290
...إنّه مُضمَّد

66
00:05:34,290 --> 00:05:35,900
إنّه لا يؤلمني

67
00:05:36,120 --> 00:05:39,170
حسناً، لنذهب إلى الصّفّ
ونتناول بعض الكاري

68
00:05:42,940 --> 00:05:44,090
وداعاً

69
00:05:49,620 --> 00:05:56,070
سليل الجيل السّادس كاهاكو"
"...استخدم الكلام المكتوب

70
00:05:56,070 --> 00:05:59,080
حسناً، لا يمكننا حتّى إرسال
رسائل إذاً

71
00:05:59,080 --> 00:06:02,430
هل من طريقة للتكلُّم مع فوشي
دون أن يكتشف القارعون؟

72
00:06:02,430 --> 00:06:06,170
...كيفيّة التّواصل من دون استخدام لغة

73
00:06:16,120 --> 00:06:17,410
إيكو-تشان

74
00:06:17,410 --> 00:06:19,670
هل يمكنني استعارة قِدركِ؟

75
00:06:20,590 --> 00:06:22,150
هذا، هذا

76
00:06:29,610 --> 00:06:34,930
...طعامي المُفضّل... طعامي المُفضّل

77
00:06:36,690 --> 00:06:38,260
تفضّلي يا إيكو-تشان

78
00:06:39,470 --> 00:06:41,920
هذا طعامي المُفضّل

79
00:06:50,110 --> 00:06:51,740
!إيكو-تشان

80
00:06:56,490 --> 00:07:00,370
!غوغو-نيسان، أعشق هذه الأشياء

81
00:07:00,370 --> 00:07:03,640
أجل، أرَتْني إيكو-تشان صورة

82
00:07:03,640 --> 00:07:07,250
،بدا أنّها تريدني أن أعدّ بعضاً منه
لذا أجريتُ تغييراً سريعاً

83
00:07:12,530 --> 00:07:14,070
!هذه هي

84
00:07:16,790 --> 00:07:18,920
!بسرعة يا أمّي

85
00:07:20,180 --> 00:07:22,400
تحمّستُ وأعددتُ الكثير

86
00:07:22,400 --> 00:07:23,930
أنا مُمتنّ لكِ دوماً

87
00:07:23,930 --> 00:07:26,220
هذا لأجل عزيزتي ميزوها وإتسكي-سان

88
00:07:26,220 --> 00:07:27,380
أنا مُستمتعة

89
00:07:31,340 --> 00:07:34,020
نزهة عطلة أسبوع مُمتعة

90
00:07:34,020 --> 00:07:36,300
ما زلتُ أتظاهر بأنّهم عائلة
سعيدة حسبما أرى

91
00:07:36,720 --> 00:07:38,310
صحيح

92
00:07:41,150 --> 00:07:44,940
يجب عليّ التخلُّص من الصُّور
في حاسوب إيزومي-سان

93
00:07:57,200 --> 00:07:59,470
كيف يُفتح هذا الشّيء أصلاً؟

94
00:08:00,530 --> 00:08:02,560
عليّ التخلُّص منه فحسب

95
00:08:09,560 --> 00:08:12,070
!رمي نفايات غير شرعيّ
!تدمير بيئيّ

96
00:08:12,070 --> 00:08:13,210
!قمامة الأرض

97
00:08:13,660 --> 00:08:15,730
آيكو. لماذا أنت هنا؟

98
00:08:15,730 --> 00:08:18,550
!أتطوّع للتّنظيف مرّة في الشّهر

99
00:08:18,940 --> 00:08:20,750
لا يجوز أن تفعل ذلك يا فوشي-سان

100
00:08:20,750 --> 00:08:24,610
عليك الاتّصال بمجلس المدينة والطّلب
من موظّفيهم المجيء وأخذ الحاسوب

101
00:08:26,060 --> 00:08:27,790
رائع، شكراً على الاهتمام بالأمر

102
00:08:27,790 --> 00:08:28,910
!انتظر

103
00:08:28,910 --> 00:08:30,980
!عليك فعل ذلك بنفسك

104
00:08:31,540 --> 00:08:33,890
من الصّعب إزالتها

105
00:08:33,890 --> 00:08:36,300
لا بُدّ أنّها كانت غاية في الأهمّية

106
00:08:37,310 --> 00:08:40,490
لماذا أرادت إيزومي-سان التخلًّص منهم؟

107
00:08:45,220 --> 00:08:47,780
...مؤلم

108
00:08:47,780 --> 00:08:49,590
ما الأمر يا يوكي؟ ماذا حدث؟

109
00:08:50,300 --> 00:08:52,040
!مرحى! نجح ذلك

110
00:08:53,500 --> 00:08:55,570
...لحظة، أنت لم

111
00:08:55,570 --> 00:08:57,180
لتُناديني فقط؟

112
00:08:58,690 --> 00:09:01,600
ماذا كنتَ تفعل قبل أيّام؟

113
00:09:01,600 --> 00:09:05,760
،إذا كان كلّ ما تطلّبه الأمر مُصافحة
لكنّا قد أُنعِمنا بالسّلام في العالم الآن

114
00:09:05,760 --> 00:09:08,350
المُصافحة هي الخطوة الأولى للتّواصل

115
00:09:08,690 --> 00:09:10,520
وتمكنّا من فعل ذلك

116
00:09:10,520 --> 00:09:12,430
نحن محظوظون جدّاً

117
00:09:12,430 --> 00:09:17,040
أنا مُؤمن بأنّنا سنعقد اتّفاق
سلام يصل القلوب ببعضها

118
00:09:17,040 --> 00:09:18,530
حسناً، هل احتجت شيئاً؟

119
00:09:18,860 --> 00:09:20,640
أتيتُ وبحوزتي رسالة

120
00:09:20,640 --> 00:09:22,090
في هذا القِدر الصّلصاليّ

121
00:09:22,090 --> 00:09:24,370
رسالة؟ من إيكو؟

122
00:09:24,370 --> 00:09:26,370
لا، منّي

123
00:09:26,830 --> 00:09:28,730
هل كنت تعلم يا فوشي؟

124
00:09:28,730 --> 00:09:31,340
ليس عليك أن تكون من جماعة القِدر
الصّلصاليّ لصنع قِدر صلصاليّ

125
00:09:32,490 --> 00:09:34,810
جرّب الأمر فحسب

126
00:09:42,940 --> 00:09:48,590
إن كنت ترى هذا، فلا بُدّ أنّني
صنعتُ قِدراً صلصاليّاً جيّداً

127
00:09:52,100 --> 00:09:55,280
هذا القِدر أشبه بشفرة شريطيّة

128
00:09:55,280 --> 00:09:59,530
قد لا نتمكّن من تفكيكها، لكن
مع ذلك يمكننا صنعها

129
00:10:01,210 --> 00:10:04,480
وبتلك القوّة، يمكنني إرسال
معلومات إليك بشكل مُباشر

130
00:10:04,480 --> 00:10:06,730
عندما تكون بهيئة أخيها لإيكو-تشان

131
00:10:06,730 --> 00:10:10,160
والقارعون في الجنّة لا يستطيعون
فهم مُحادثاتنا

132
00:10:10,160 --> 00:10:11,870
القارعون في الجنّة؟

133
00:10:12,250 --> 00:10:14,950
القارعون خارج الأرض

134
00:10:14,950 --> 00:10:16,810
فكّرتُ في الأمر مليّاً

135
00:10:16,810 --> 00:10:21,230
كيف يجدك القارعون وهم لا يملكون
عيوناً ولا آذاناً ولا أنفاً؟

136
00:10:21,230 --> 00:10:24,300
كان القارع الخاصّ بميزوها-سينباي
يتلقّى الرّسائل

137
00:10:24,300 --> 00:10:27,280
من القارعين الآخرين بينما
كان داخل كاهاكو، صحيح؟

138
00:10:28,430 --> 00:10:30,010
من أين؟

139
00:10:30,010 --> 00:10:31,340
وكيف؟

140
00:10:32,220 --> 00:10:35,640
راودني الفضول، لذا جرّبتُ ذلك
على سينباي وصديقتها

141
00:10:36,000 --> 00:10:37,990
كيف تتواصلان الاثنتان؟

142
00:10:37,990 --> 00:10:42,330
كيف تستجيبان إذا طرحتُ سؤالاً
غريباً أثناء وجود تلاميذ آخرين؟

143
00:10:42,660 --> 00:10:43,810
...و

144
00:10:44,860 --> 00:10:48,750
كان ذلك دليلاً على أنّهما تستخدمان
عيونهما للتّواصل

145
00:10:49,200 --> 00:10:53,460
،لو كان القارعون يملكون التّخاطر
لما احتاجوا للقيام بذلك

146
00:10:54,410 --> 00:10:59,890
طلبتُ أيضاً من بون-سان أن يسأل
فين ونيكسون ما إن كانا تخاطريّين

147
00:11:00,490 --> 00:11:03,760
"يسألان، "ما هو هذا حتّى؟

148
00:11:04,100 --> 00:11:07,720
إذاً من أين ترِد الرّسائل؟

149
00:11:07,720 --> 00:11:12,230
لا بُدّ أنّها ترِد من قارعين من خارج
الأرض، دون قيود من هذه الأرض

150
00:11:12,230 --> 00:11:13,990
...حسناً

151
00:11:13,990 --> 00:11:18,430
،لا أعرف الكثير عن التّخاطر
لكن فهمتُ ما تقصده

152
00:11:18,430 --> 00:11:19,190
وبعد؟

153
00:11:19,190 --> 00:11:21,650
أجل. الآن، إليك السّؤال

154
00:11:25,510 --> 00:11:29,730
لا أريد من القارعين أن يسمعوا
الفرضيّة الّتي سأخبرك بها

155
00:11:29,730 --> 00:11:33,990
فالمعلومات هي السّلاح الأقوى

156
00:11:33,990 --> 00:11:37,510
،بصفتي نائب رئيسة نادي الغوامض
...كنتُ أسأل

157
00:11:37,510 --> 00:11:40,160
،إذا كان هذا الوضع يُمثّل هزيمة لك

158
00:11:40,160 --> 00:11:42,780
فسوف تُهزَم أكثر حتّى في الفترة المُقبلة

159
00:11:42,780 --> 00:11:46,420
كافّة القارعين في العالم
لا يعيشون هنا فحسب

160
00:11:46,420 --> 00:11:52,860
يحاولون تحقيق هدفهم الأصليّ
بتوجيه الفاي خاصّتنا إلى الجنّة

161
00:11:52,860 --> 00:11:55,790
،إذا فكّرتَ في هدفهم العظيم

162
00:11:55,790 --> 00:12:00,540
نحن البشر ضحايا اللّحم الّذي
،نحن حبيسون بداخله

163
00:12:00,540 --> 00:12:01,980
وأنت العدوّ

164
00:12:02,840 --> 00:12:07,990
بحسب مُعتقداتهم، ما كانوا ليُحاولوا
الحصول على أجساد يسكنونها

165
00:12:08,450 --> 00:12:14,210
مع ذلك يدخلون تلك الأجساد الشّنيعة
ويلعبون بناء على القواعد الأرضيّة

166
00:12:14,210 --> 00:12:17,530
والسّبب بالتّأكيد هو لأنّهم
لم يُنجزوا خطّتهم بعد

167
00:12:17,930 --> 00:12:22,830
ما دمتَ حيّاً، خطّتهم لن تكتمل أبداً

168
00:12:22,830 --> 00:12:25,680
لهذا يستهدفون حياتك

169
00:12:26,050 --> 00:12:28,300
لكن لا يستطيعون قتلك بسهولة

170
00:12:28,630 --> 00:12:32,930
،حاولوا إيجادك باستخدام ميموري المُزيّفة
لكن لم يستطيعوا إيجاد حياتك

171
00:12:33,260 --> 00:12:35,150
ما هو فوشي؟

172
00:12:35,150 --> 00:12:38,070
هذا سيكون سؤالي لو كنتُ قارعاً أيضاً

173
00:12:38,070 --> 00:12:42,170
الشّخص الّذي يعرف كلّ شيء
هو الشّخص الّذي صنعك

174
00:12:43,680 --> 00:12:46,290
الكائن الّذي صنع "القانون" الّذي هو فوشي

175
00:12:46,290 --> 00:12:50,600
دمّر هذا، واللّغز خلف حياة
فوشي قد ينكشف

176
00:12:50,600 --> 00:12:53,490
ذلك الكائن هو السّيّد أسود

177
00:12:53,850 --> 00:12:56,450
بالأحرى، الفتى ساتورو

178
00:12:56,450 --> 00:12:58,330
!ساتورو

179
00:12:59,670 --> 00:13:01,750
لنمشِ إلى المنزل معاً

180
00:13:02,460 --> 00:13:03,880
ماذا؟ لقد ومضتْ

181
00:13:03,880 --> 00:13:07,750
عجيب، لا يحدث هذا عادةً
في هذه الفترة من العام

182
00:13:09,180 --> 00:13:10,540
!جبانة

183
00:13:10,540 --> 00:13:11,670
أنتِ أيضاً

184
00:13:11,670 --> 00:13:14,590
لكن لم أصرخ

185
00:13:14,590 --> 00:13:17,140
مهلاً يا توموري. ممنوع
التنمُّر على ميتشي

186
00:13:20,410 --> 00:13:21,510
أنا خائفة

187
00:13:21,510 --> 00:13:22,760
مهلاً، مهلاً

188
00:13:22,760 --> 00:13:24,820
أختك الكبرى هنا

189
00:13:24,820 --> 00:13:26,500
لا بُدّ أنّك خائف أيضاً يا ساتورو

190
00:13:26,500 --> 00:13:28,190
تعال إلى هنا

191
00:13:28,190 --> 00:13:29,580
لستُ خائفاً

192
00:13:29,580 --> 00:13:32,120
عجباً، ليس عليك التّظاهر بالقوّة

193
00:13:32,120 --> 00:13:34,410
يمكنك الاعتماد عليّ

194
00:13:35,240 --> 00:13:37,110
!صاعقة كبيرة قادمة

195
00:13:41,780 --> 00:13:43,290
!مُخيف

196
00:13:45,750 --> 00:13:47,830
آسفة يا ساتورو

197
00:13:47,830 --> 00:13:50,420
تبيّن بأنّني حتّى أنا جبانة

198
00:13:58,100 --> 00:14:00,940
هل ستخرجين يا فونا؟

199
00:14:00,940 --> 00:14:03,130
إلى المتجر. هل تريدين شيئاً؟

200
00:14:03,130 --> 00:14:05,190
ني-تشان، هل يمكنك أن تشتري
لي مشروب طاقة؟

201
00:14:05,190 --> 00:14:07,420
ألم تسمعي الرّعد؟

202
00:14:07,880 --> 00:14:09,530
سأعود في الحال

203
00:14:10,640 --> 00:14:12,290
شكراً لك

204
00:14:20,940 --> 00:14:23,480
إنّه جيّد جدّاً لخلوّه من السّعرات الحراريّة

205
00:14:23,920 --> 00:14:25,470
ينبغي أن أشتريه ثانية

206
00:14:28,970 --> 00:14:30,560
...والآن

207
00:14:55,260 --> 00:14:59,250
لقد... خيّم اللّيل

208
00:15:03,630 --> 00:15:05,510
دعيها

209
00:15:05,510 --> 00:15:08,410
...إذا اقتربت أكثر

210
00:15:09,560 --> 00:15:12,000
...إنّ أخذ رهينة فقط لتأخير ما هو محتوم

211
00:15:12,000 --> 00:15:14,260
أنت لا تختلف عن القارع الخاصّ بميموري

212
00:15:35,160 --> 00:15:36,630
هل أنت بخير؟

213
00:15:39,710 --> 00:15:41,620
كيف حال جرحك؟ دعني أرى حنجرتك

214
00:16:21,090 --> 00:16:24,120
لم يخبرني أحدٌ بأنّك تستطيع فعل ذلك

215
00:16:25,010 --> 00:16:26,820
عودي إلى المنزل

216
00:16:45,120 --> 00:16:48,080
ساتورو، ما الّذي يجري؟

217
00:16:48,080 --> 00:16:49,650
ما هذه الضجّة؟

218
00:16:50,550 --> 00:16:51,610
لا شيء

219
00:16:51,610 --> 00:16:53,340
من أين حصلت على هذه الزّهرة؟

220
00:16:53,340 --> 00:16:55,940
!لحظة، هل هي لي؟

221
00:16:56,940 --> 00:16:57,910
بالتّأكيد

222
00:17:02,790 --> 00:17:03,670
!أيّها الأسود

223
00:17:03,670 --> 00:17:06,040
يا للهول! هل أنت بخير؟

224
00:17:06,800 --> 00:17:08,180
وأنت؟

225
00:17:08,510 --> 00:17:11,130
كنتَ تعلم بأنّني هنا؟

226
00:17:11,130 --> 00:17:13,510
الضّوضاء الّذي تصدره يتردّد صداه

227
00:17:14,780 --> 00:17:16,900
تعرّضتُ لهجوم

228
00:17:16,900 --> 00:17:18,460
لا بُدّ أنّني أيقظتُك

229
00:17:19,010 --> 00:17:21,050
كيف حال جرحك؟ دعني أرى حنجرتك

230
00:17:24,260 --> 00:17:26,490
مضى وقت منذ أُصِبُ بإبرة سامّة

231
00:17:26,870 --> 00:17:29,800
لكن تمكّنتُ من استنساخ نفسي
قبل أن أغيب عن الوعي

232
00:17:32,580 --> 00:17:35,180
لا أصدّق بأنّه كان يوجد
قارع آخر هنا

233
00:17:35,790 --> 00:17:37,610
!القارع الخاص بفونا هنا أيضاً

234
00:17:37,610 --> 00:17:39,080
!يجب علينا القبض عليه

235
00:17:39,080 --> 00:17:41,880
استخرجتُ ما كان بداخله بالفعل وحرقتُه

236
00:17:40,770 --> 00:17:42,180
!استرخِ

237
00:17:42,180 --> 00:17:43,910
—سأحمي

238
00:17:44,790 --> 00:17:47,420
ماذا؟ حرقته؟ حرقت ماذا؟

239
00:17:48,010 --> 00:17:49,570
القارع

240
00:17:49,570 --> 00:17:52,330
حوّلتُها إلى زهرة، ثمّ قطفتُها وأحرقتُها

241
00:17:52,960 --> 00:17:55,930
لحظة، يمكنك فعل ذلك؟

242
00:17:55,930 --> 00:17:56,910
أجل

243
00:17:56,910 --> 00:17:58,870
قطفتها وحرقتها؟

244
00:17:58,870 --> 00:18:00,180
هذا ما قلتُه

245
00:18:02,270 --> 00:18:04,300
!كذبت عليّ

246
00:18:05,860 --> 00:18:08,370
!يمكنك هزيمة القارعين

247
00:18:08,370 --> 00:18:12,410
في آخر مرّة سألتُك فيها، قلتَ
!بأنّك لا تعرف كيفيّة هزيمتهم

248
00:18:12,410 --> 00:18:13,640
حقّاً؟

249
00:18:14,470 --> 00:18:16,840
!سوف تُساعدني

250
00:18:16,840 --> 00:18:20,070
!لن أدعهم يأخذون أرواح البشر

251
00:18:20,070 --> 00:18:21,680
!سنقضي عليهم جميعاً

252
00:18:21,680 --> 00:18:23,740
!أنت

253
00:18:23,740 --> 00:18:26,250
!ماذا تفعل لساتورو؟

254
00:18:26,550 --> 00:18:29,710
تبّاً، هذه الفتاة مُزعجة

255
00:18:29,710 --> 00:18:32,210
!ماذا؟! ماذا قلت؟

256
00:18:32,210 --> 00:18:34,220
!أنت تتنمّر على ساتورو ثانية

257
00:18:34,220 --> 00:18:35,730
أيضاً، كيف تمكّنت من الدّخول أصلاً؟

258
00:18:35,730 --> 00:18:36,910
!سأستدعي الشّرطة

259
00:18:36,910 --> 00:18:39,170
!سوميكا-ني! ميتشي بحاجة مُساعدة

260
00:18:44,720 --> 00:18:46,460
ما الأمر يا ميتشي؟

261
00:18:50,000 --> 00:18:51,310
كنتُ نائماً

262
00:18:51,800 --> 00:18:53,570
!هذا مُطمئن

263
00:18:53,570 --> 00:18:56,530
ظننتُ بأنّ مرضك قد عاد

264
00:18:59,830 --> 00:19:01,440
ينبغي أن يكون هذا بعيداً بما يكفي

265
00:19:02,180 --> 00:19:03,920
لنتابع ما توقّفنا عنده

266
00:19:03,920 --> 00:19:07,070
الطّفلة الّتي هاجمتني كان
يوجد قارع بداخلها

267
00:19:07,070 --> 00:19:08,080
أعلم

268
00:19:08,820 --> 00:19:11,360
!كيف لك أن تكون غير مُبالٍ لذلك؟

269
00:19:11,360 --> 00:19:13,580
!لماذا لم تقضِ عليه بما أنّك تعلم؟

270
00:19:13,960 --> 00:19:16,140
إنّه مُندمج بشكل كامل

271
00:19:16,140 --> 00:19:19,670
حتّى لو فرّغنا المُضيف، لا شيء
لنضعه بالدّاخل

272
00:19:20,160 --> 00:19:22,210
...لكن يجب علينا أن

273
00:19:22,680 --> 00:19:24,030
يجب عليّ هزيمته

274
00:19:24,600 --> 00:19:25,900
!القضاء عليه

275
00:19:26,390 --> 00:19:29,980
أُصيبت تلك الفتاة بمرض خطير

276
00:19:29,980 --> 00:19:34,230
يبدو أنّها تمنّت الموت كلّ يوم

277
00:19:35,230 --> 00:19:38,520
وقلبها قد توقّف

278
00:19:41,150 --> 00:19:43,700
لكن كان اليأس قصيراً

279
00:19:44,460 --> 00:19:48,540
،نشطَ قلبُ ميتشي ثانية
وامتثلت للشّفاء

280
00:19:49,540 --> 00:19:52,690
أختاها قبِلتا المُعجزة وابتهجتا

281
00:19:54,310 --> 00:19:58,130
لا أنوي حرمانهم من تلك السّعادة

282
00:20:02,230 --> 00:20:04,670
حتّى لو كان يوجد قارع بالدّاخل؟

283
00:20:05,110 --> 00:20:08,140
الإيمان بهم خيار صحيح، لأجلهم

284
00:20:08,710 --> 00:20:11,610
فضلاً عن ذلك، حتّى لو

285
00:20:12,290 --> 00:20:15,610
،تعاونتُ في القضاء على القارعين

286
00:20:15,610 --> 00:20:18,970
أشكّ في أنّه سيأتي يوم
ستكون فيه راضياً

287
00:20:20,290 --> 00:20:22,850
لكلّ فاي قصّة

288
00:20:22,850 --> 00:20:24,770
بعضهم لا يتمنّون الموت

289
00:20:25,090 --> 00:20:29,480
يستغرق قرار ما إن كان قارع
يجب قتله أم لا وقتاً طويلاً

290
00:20:29,480 --> 00:20:31,430
...وقت

291
00:20:31,430 --> 00:20:34,390
هل ستقضي قرناً في مُحاولة
القضاء عليهم؟

292
00:20:34,390 --> 00:20:36,710
سيتضاعفون عدداً في هذه الأثناء

293
00:20:37,080 --> 00:20:40,670
وتقول بأنّك لن تعود إلى الدّيار
ما لم تقضِ عليهم

294
00:20:40,670 --> 00:20:42,590
هل سيكون هذا بعد مئتي عام؟

295
00:20:42,590 --> 00:20:44,030
أربعمئة عام؟

296
00:20:44,590 --> 00:20:47,400
الأصدقاء الّذين اجتمعتَ ثانية معهم
أخيراً سيموتون حينها

297
00:20:49,670 --> 00:20:53,720
أثني على طموحك، لكنّه غير واقعيّ

298
00:20:54,160 --> 00:20:57,270
لا أستطيع مُجاراة عمرك الطّويل

299
00:20:57,930 --> 00:21:00,690
!قـ-قـ-قل ما تشاء

300
00:21:00,690 --> 00:21:03,000
لا أكترث للأسباب الّتي يملكها القارعون

301
00:21:03,000 --> 00:21:06,100
مُحاولة عيش حياة شخص
!آخر هو ضرب من الغرور

302
00:21:06,100 --> 00:21:08,200
!لن أسمح بذلك! هذا يُثير اشمئزازي

303
00:21:09,170 --> 00:21:11,160
هل يحقُّ لك التكلُّم؟

304
00:21:11,160 --> 00:21:12,930
!لـ-لا

305
00:21:12,930 --> 00:21:14,870
!لستُ مثل القارعين

306
00:21:14,870 --> 00:21:16,690
بما تختلف عنهم؟

307
00:21:16,690 --> 00:21:18,740
!لا أُبالي

308
00:21:18,740 --> 00:21:22,350
،استخدام أجساد الآخرين دون إذن
،دون حتّى مُحادثة

309
00:21:22,350 --> 00:21:24,190
!هو أشبه بالسّرقة

310
00:21:24,190 --> 00:21:26,080
ماذا؟ ماذا عنك إذاً؟

311
00:21:26,450 --> 00:21:29,090
تكلّمتَ مع الفتى الّذي تملّكت جسده؟

312
00:21:34,890 --> 00:21:39,770
...هذا لأنّه طلب منّي أن أتذكّر

313
00:21:40,220 --> 00:21:42,140
...لم أُرِد النّسيان، لذا

314
00:21:43,350 --> 00:21:46,830
!لـ-لا تحاول أن تجعلني أستسلم

315
00:21:46,830 --> 00:21:48,770
!يجب عليّ فعل هذا

316
00:21:48,770 --> 00:21:52,120
!يجب عليّ نشر السّلام لأجل الجميع

317
00:21:52,350 --> 00:21:53,500
افعل ذلك

318
00:21:54,370 --> 00:21:56,080
لن أمنعك بعد الآن

319
00:22:03,790 --> 00:22:04,990
!تبّاً

320
00:22:05,950 --> 00:22:07,720
!ما خطبه؟

321
00:22:08,320 --> 00:22:09,930
سأفعلها

322
00:22:09,930 --> 00:22:11,670
!راقبني وأنا أفعل ذلك

323
00:22:12,240 --> 00:22:13,170
بون

324
00:22:13,170 --> 00:22:14,790
فوشي

325
00:22:14,790 --> 00:22:17,050
هل قضيت على كافّة القارعين؟

326
00:22:17,700 --> 00:22:18,810
ليس بعد

327
00:22:19,620 --> 00:22:22,280
أعلم. أنت تُعاني ثانية

328
00:22:22,640 --> 00:22:24,730
هل من شيء أستطيع فعله؟

329
00:22:25,030 --> 00:22:27,710
لا أملك الشّجاعة للتّلويح بسيف بعد

330
00:22:27,710 --> 00:22:30,700
لكن سأجرّب شيئاً آخر بدلاً من ذلك

331
00:22:31,020 --> 00:22:33,010
ثمّة شيء أريد منك أن تُساعدني فيه

332
00:22:36,690 --> 00:22:38,840
فونا، ماذا عن الفطور؟

333
00:22:38,840 --> 00:22:40,810
لا أريد

334
00:22:41,860 --> 00:22:45,310
ني-تشان، هل يمكنك أن تشتري
لي مشروب طاقة هذه المرّة؟

335
00:22:45,310 --> 00:22:47,300
مشروب طاقة؟ ماذا؟

336
00:22:48,920 --> 00:22:51,350
صباح الخير

337
00:22:51,670 --> 00:22:53,150
صباح الخير جميعاً

338
00:22:53,150 --> 00:22:54,170
صباح الخير

339
00:24:32,000 --> 00:24:37,250
يكافح فوشي لضمان انسجام ميزوها

340
00:24:38,270 --> 00:24:43,910
في هذه الأثناء، يتشكّل شرخ
بين ميزوها وهانّا

341
00:24:45,250 --> 00:24:47,750
ما الدّور المُتوقَّع لصديقة مُقرَّبة؟

342
00:24:48,700 --> 00:24:50,930
وما هي كلفة ذلك؟