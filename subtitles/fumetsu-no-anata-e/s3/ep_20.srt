1
00:00:01,760 --> 00:00:04,840
ميزوها-سينباي يُمنى

2
00:00:08,050 --> 00:00:12,940
يتحدّى قارع ميزوها فوشي في معركة

3
00:00:14,100 --> 00:00:17,200
معركتنا في العصر الحالي قد انتهت

4
00:00:18,540 --> 00:00:20,300
تعالي معي

5
00:00:22,950 --> 00:00:25,450
أبليتم حسناً

6
00:00:25,850 --> 00:00:29,290
فوشي أعاد ميزوها

7
00:02:09,630 --> 00:02:12,230
!هذا القِدر السّاخن لذيذ جدّاً

8
00:02:12,230 --> 00:02:14,190
كيف نكّهوه على أيّ حال؟

9
00:02:14,190 --> 00:02:15,040
هلّا علّمتِني؟

10
00:02:15,040 --> 00:02:16,660
سأسأل جدّي

11
00:02:22,130 --> 00:02:23,530
ميزوها... سان

12
00:02:24,340 --> 00:02:25,650
تفضّلي

13
00:02:25,650 --> 00:02:27,000
لنأكل

14
00:02:27,000 --> 00:02:28,710
أنا واثقة بأنّكِ تتضوّرين جوعاً

15
00:02:28,710 --> 00:02:29,880
شكراً

16
00:02:32,800 --> 00:02:37,720
سأتكلّم مع المدرسة للحرص على عودة
ميزوها-كن ابتداء من الغد

17
00:02:38,230 --> 00:02:39,740
أشكرك على ذلك

18
00:02:41,420 --> 00:02:45,160
لم يتردّد عن شرب الماء الّذي
يحتوي على قارعين

19
00:02:46,670 --> 00:02:47,960
تعال معي يا يوكي

20
00:02:47,960 --> 00:02:49,470
فوشي، ما الأمر؟

21
00:02:49,470 --> 00:02:51,100
ساتورو، أنت أيضاً

22
00:02:55,150 --> 00:02:57,200
يوكي ابتلع قارعاً

23
00:02:57,200 --> 00:02:59,320
!اخرج منه. بسرعة

24
00:03:00,310 --> 00:03:01,830
!أرفُض

25
00:03:01,830 --> 00:03:02,750
لماذا؟

26
00:03:02,750 --> 00:03:04,310
لأنّني قلتُ ذلك

27
00:03:04,310 --> 00:03:06,750
!لكن... هذا خطير

28
00:03:06,750 --> 00:03:09,400
قد يتحكّم بك إذا أراد ذلك

29
00:03:09,400 --> 00:03:12,190
!وقد يقتلك حتّى! إنّه خطر على حياتك

30
00:03:12,190 --> 00:03:13,080
أعلم ذلك

31
00:03:13,080 --> 00:03:14,040
لماذا إذاً؟

32
00:03:14,540 --> 00:03:15,800
سوف نتعايش

33
00:03:16,650 --> 00:03:20,230
ألا يمكنك التّعايش معه بعد أن
تُخرجه من جسدك؟

34
00:03:20,230 --> 00:03:23,340
رأيتَ ما حدث لميزوها عندما
تحكّم بها القارعون

35
00:03:23,740 --> 00:03:25,980
لا أحد يعلم متى سينتهي المطاف بك هكذا

36
00:03:25,980 --> 00:03:27,400
لن أفعل

37
00:03:27,620 --> 00:03:29,470
لذا أنا بخير كما أنا

38
00:03:29,470 --> 00:03:30,470
...لكن

39
00:03:30,470 --> 00:03:34,870
علينا ألّا نتدخّل إذا كانت هذه هي رغبته

40
00:03:35,470 --> 00:03:37,070
!كما سمعت. إلى اللّقاء

41
00:03:37,070 --> 00:03:38,150
!يوكي

42
00:03:38,150 --> 00:03:39,400
سأُغادر كذلك

43
00:03:39,400 --> 00:03:40,310
!مهلاً

44
00:03:41,010 --> 00:03:42,840
أنا قلق بشأن يوكي

45
00:03:42,840 --> 00:03:44,300
سأعود غداً

46
00:03:50,170 --> 00:03:56,240
لذا أجل، أعطيتُ ميزوها-سينباي هديّة الألبوم
تلك ثانية في اللّيلة الماضيّة كما ينبغي هذه المرّة

47
00:03:56,240 --> 00:03:57,460
...ثمّ

48
00:03:57,460 --> 00:04:00,420
"ابتسمتْ وقالتْ، "شكراً لك

49
00:04:00,420 --> 00:04:02,580
وحينئذ تلامست أيديكما؟

50
00:04:02,580 --> 00:04:03,500
!هذا صحيح

51
00:04:03,500 --> 00:04:05,710
وحينها اعترفت؟

52
00:04:06,840 --> 00:04:08,810
!لم أستطع فعلها

53
00:04:08,810 --> 00:04:11,060
لا عليك. ستسنح لك فُرص أُخرى

54
00:04:11,060 --> 00:04:12,260
ما الأمر؟

55
00:04:13,400 --> 00:04:15,010
فُرص ماذا؟

56
00:04:15,010 --> 00:04:17,470
...فـ-في الواقع

57
00:04:18,700 --> 00:04:23,690
فُرصة لتقديم هديّة عيد ميلاد لكِ كنتُ
أنوي إعطاءكِ إيّاها في اللّيلة الماضية

58
00:04:24,390 --> 00:04:26,200
لي أنا؟

59
00:04:26,610 --> 00:04:28,010
!مهلاً يا رئيسة

60
00:04:28,010 --> 00:04:29,540
!كان من المُفترض أن يكون دوري

61
00:04:32,640 --> 00:04:34,000
!نادي أبحاث الغوامض

62
00:04:34,000 --> 00:04:36,110
علينا أن نتكلّم؟

63
00:04:36,360 --> 00:04:38,240
هل تتمّ مُغازلتي؟ كم هذا مُبهج

64
00:04:38,240 --> 00:04:40,230
لا يا أحمق، نحن في ورطة الآن

65
00:04:40,230 --> 00:04:41,460
هل من مُشكلة؟

66
00:04:41,460 --> 00:04:45,060
يشتبهون بأنّنا نقف وراء ما حدث في الأمس

67
00:04:45,500 --> 00:04:49,540
مقطع كاميرا المُراقبة حُذِف لسبب ما

68
00:04:49,540 --> 00:04:53,510
تريد الشّرطة أن تنسب الأمر
لكم بأنّه مقلَب منكم

69
00:04:53,510 --> 00:04:56,690
غالباً سيجرون مُقابلة معكم عمّا قريب

70
00:04:56,690 --> 00:04:58,370
،ستحتاجون لمُبرّر مُقنع

71
00:04:58,370 --> 00:05:01,310
وإلّا قد لا تتمكّنون من العودة إلى المدرسة

72
00:05:01,310 --> 00:05:03,280
ماذا؟ سيتمّ اعتقالكم؟

73
00:05:03,280 --> 00:05:05,580
،لهذا نُقيم اجتماعاً في المطعم العائليّ

74
00:05:05,580 --> 00:05:06,820
وذلك كي لا نُعتقَل

75
00:05:06,820 --> 00:05:09,050
لم تأتوا إلى المدرسة منذ مدّة

76
00:05:09,050 --> 00:05:10,940
تعاونوا معنا وذلك كي نُوضّح روايتنا

77
00:05:10,940 --> 00:05:12,320
!أنتِ أيضاً يا ميزوها

78
00:05:12,320 --> 00:05:14,990
أنتِ مُتورّطة في شؤون القارعين، أليس كذلك؟

79
00:05:14,990 --> 00:05:16,840
لكن هناك حظر تجوال

80
00:05:16,840 --> 00:05:18,940
لا تكترثين إذا اعتُقِل فوشي-كن؟

81
00:05:18,940 --> 00:05:20,260
لا أتمنّى ذلك

82
00:05:20,770 --> 00:05:22,790
...المطعم العائليّ؟ في هذه الحالة

83
00:05:22,790 --> 00:05:24,370
!بارفية المانغو الموسميّة

84
00:05:24,370 --> 00:05:25,450
!شرائح لحم كومبو

85
00:05:25,450 --> 00:05:27,060
هل اتّفقنا؟

86
00:05:27,060 --> 00:05:27,640
!يا للأنانيّة

87
00:05:27,640 --> 00:05:28,460
حسناً

88
00:05:28,460 --> 00:05:30,400
بيتزا لي إذاً

89
00:05:30,400 --> 00:05:31,350
أنا أيضاً

90
00:05:31,970 --> 00:05:34,130
يبدو أنّنا ينبغي أن نحضر بون معنا

91
00:05:34,130 --> 00:05:35,410
وساتورو كذلك

92
00:05:35,830 --> 00:05:39,410
لدينا تحديث بشأن الحريق وحادث
التّنويم المغناطيسيّ الجماعيّ

93
00:05:39,410 --> 00:05:41,530
في مدرسة ميناموتو الإعداديّة البارحة

94
00:05:41,850 --> 00:05:44,970
بلغَنا بأنّ مقطع الكاميرا

95
00:05:44,970 --> 00:05:49,230
أثناء وقت الحادث قد تمّ حذفه

96
00:05:49,230 --> 00:05:54,120
تشتبه الشّرطة بأنّ هذا كان
نتيجة جريمة مُتعمَّدة

97
00:05:54,120 --> 00:05:56,440
!يا للهول! هذا مُرعب

98
00:05:56,440 --> 00:05:58,470
من فعل شيئاً كهذا يا ترى؟

99
00:05:59,080 --> 00:06:00,060
هل كان أنت؟

100
00:06:00,060 --> 00:06:00,920
أجل

101
00:06:00,920 --> 00:06:03,070
لا يوجد تسجيل للأجزاء الهامّة

102
00:06:03,070 --> 00:06:05,270
هذا سيمنع الأمر من التّفاقم
إلى حادث ضخم

103
00:06:05,270 --> 00:06:08,470
لا أدري ما إن كان مُجرّد حذف الفيديو كافٍ

104
00:06:08,730 --> 00:06:11,890
يبدو أنّ الشّرطة ستبحث وتقبض
على مُفتعلي الحريق

105
00:06:12,170 --> 00:06:16,720
لعلّك أيضاً تحذف ذكريات الجميع
في المدرسة أيضاً

106
00:06:16,720 --> 00:06:18,720
هل يستطيع فعل ذلك حتّى؟

107
00:06:18,720 --> 00:06:21,890
أجل، أتتذكّر عندما جمّدَ أجسادنا في مكانها؟

108
00:06:21,890 --> 00:06:22,970
بهذه الطّريقة

109
00:06:22,970 --> 00:06:24,430
أستطيع ذلك، لكن لن أفعل

110
00:06:24,850 --> 00:06:28,730
إنّ العبث بذكريات شخص يضرّ بالفاي خاصّته

111
00:06:28,730 --> 00:06:30,660
هذا مُكافئ للقتل

112
00:06:32,610 --> 00:06:35,790
لكن لعلّي فعلتُ ذلك مُسبقاً

113
00:06:36,200 --> 00:06:39,000
هل هذا الفتى هو ذلك الشّيء الأسود فعلاً؟

114
00:06:39,000 --> 00:06:40,130
أجل

115
00:06:40,130 --> 00:06:41,510
ساتورو

116
00:06:42,090 --> 00:06:43,620
لنعُد إلى المنزل

117
00:06:47,620 --> 00:06:50,060
!ها أنت ذا يا ساتورو-كن

118
00:06:50,060 --> 00:06:53,630
.لديّ بعض الأسئلة بشأن الأمس
هل لي ببعض الوقت؟

119
00:06:50,060 --> 00:06:53,630
عليّ الذّهاب معهم يا جدّي

120
00:06:53,630 --> 00:06:54,830
هل هي صديقتك؟

121
00:06:54,830 --> 00:06:55,440
أجل

122
00:06:55,440 --> 00:06:58,480
لذا آسفة. علينا العودة إلى المنزل

123
00:06:58,480 --> 00:07:01,860
علينا عقد اجتماع بشأن القارعين

124
00:07:01,860 --> 00:07:04,130
القارعون؟ ما هو هذا؟

125
00:07:04,130 --> 00:07:06,700
لا داعي للقلق. لا توجد مُشكلة

126
00:07:06,700 --> 00:07:07,610
ماذا؟

127
00:07:07,610 --> 00:07:09,650
حسناً، كما خطّطنا تماماً فحسب

128
00:07:10,930 --> 00:07:13,620
أتينا لنقلكم بتعليمات من بون-ساما

129
00:07:13,620 --> 00:07:14,240
من فضلكم

130
00:07:14,520 --> 00:07:16,710
!حسناً، هيّا بنا

131
00:07:16,710 --> 00:07:18,860
نحن مُتوجّهون إلى المطعم العائليّ يا جدّي

132
00:07:18,860 --> 00:07:21,910
لا تقلق بشأن عشائنا، اتّفقنا؟

133
00:07:25,470 --> 00:07:27,540
ما مُشكلتهم؟

134
00:07:29,440 --> 00:07:33,050
العمليّة: مُحال أن يتمّ اعتقالنا

135
00:07:33,050 --> 00:07:34,280
بسيطة جدّاً

136
00:07:34,280 --> 00:07:36,060
!لنبدأ الاجتماع

137
00:07:40,760 --> 00:07:44,580
أوّلاً، أعتقد بأنّنا علينا الحرص
على أن تكون شهادتنا ثابتة

138
00:07:44,580 --> 00:07:46,690
لذا نظّمتُ نصّاً

139
00:07:46,690 --> 00:07:48,690
ماذا؟ متى تمكّنت من ذلك؟

140
00:07:48,690 --> 00:07:50,340
أرى بأنّكم قد بدأتم

141
00:07:50,340 --> 00:07:51,450
تأخّرت يا فوشي-كن

142
00:07:51,800 --> 00:07:53,080
مرحباً يا بون-سان

143
00:07:53,080 --> 00:07:55,030
بدأنا بالعشاء

144
00:08:10,050 --> 00:08:11,620
عُدت

145
00:08:12,000 --> 00:08:13,340
أهلاً بعودتكِ يا أمّي

146
00:08:13,660 --> 00:08:15,270
كيف كانت المدرسة؟

147
00:08:15,270 --> 00:08:17,390
تكلّمتُ كثيراً مع أصدقائي

148
00:08:17,760 --> 00:08:19,320
كيف حال جدّي؟

149
00:08:19,320 --> 00:08:20,980
ذهبتِ إلى المشفى، صحيح؟

150
00:08:20,980 --> 00:08:21,970
أجل

151
00:08:21,970 --> 00:08:24,400
يبدو أنّ الجرح لم يكن خطيراً

152
00:08:24,400 --> 00:08:26,930
.لم يستغرق علاجه وقتاً طويلاً
قالوا بأنّه ينبغي أن يكون بخير

153
00:08:26,930 --> 00:08:28,920
حسناً، هذا مُطمئن

154
00:08:29,300 --> 00:08:30,910
هل سامحتِه؟

155
00:08:31,230 --> 00:08:32,620
لا

156
00:08:32,620 --> 00:08:37,110
،لكن سأبذل قصارى جهدي لمُسامحته
ولو استغرق ذلك بضع سنوات

157
00:08:37,470 --> 00:08:39,850
أتُعلّقين تلك الصّور؟

158
00:08:39,850 --> 00:08:41,750
أجل. أريد صنع زينة منهم

159
00:08:42,160 --> 00:08:43,690
هذا دليل على حُبّنا

160
00:08:44,330 --> 00:08:46,840
!انظرا يا أمّي وأبي

161
00:08:47,290 --> 00:08:49,750
القمر ضخم اليوم، أليس كذلك؟

162
00:08:50,160 --> 00:08:52,090
أجل، صحيح

163
00:08:54,240 --> 00:08:57,110
حسناً يا ميزوها، كيف هو شعوركِ الآن؟

164
00:08:57,110 --> 00:08:59,310
أنا بخير على ما أعتقد

165
00:08:59,310 --> 00:09:00,540
طبيعيّة

166
00:09:00,540 --> 00:09:01,570
حقّاً؟

167
00:09:01,840 --> 00:09:03,380
هذا نجاح كبير إذاً

168
00:09:03,380 --> 00:09:04,330
أجل

169
00:09:10,510 --> 00:09:11,310
جيّد

170
00:09:11,310 --> 00:09:13,290
يوم آخر، دون وجود خلل

171
00:09:13,290 --> 00:09:14,290
!نائب الرّئيس

172
00:09:14,540 --> 00:09:17,740
أنجزنا مُسودّة نادي أبحاث الغوامض الشّهريّة

173
00:09:17,740 --> 00:09:19,250
أحسنتُما صنعاً. كان ذلك سريعاً

174
00:09:19,600 --> 00:09:22,110
هل أنت متأكّد بأنّنا ينبغي أن نكتب هذا؟

175
00:09:22,110 --> 00:09:22,710
أجل

176
00:09:23,040 --> 00:09:25,770
...قبل كلّ شيء، بخصوص مُفتعل الحرائق

177
00:09:25,770 --> 00:09:28,350
كان أحد مُعجبي فوشي-كن المُتعصّبين

178
00:09:28,350 --> 00:09:31,590
،أتتْ إلى المدرسة مُتنكّرة بالكوزبلاي
،لكن لم يكن فوشي-كن موجوداً

179
00:09:34,130 --> 00:09:35,530
كيف عرفت؟

180
00:09:35,530 --> 00:09:37,050
،هي من قالت ذلك بنفسها

181
00:09:37,050 --> 00:09:38,760
بعد أن غطّ الجميع في النّوم

182
00:09:38,760 --> 00:09:39,950
هذا هو الدّافع الوحيد؟

183
00:09:39,950 --> 00:09:41,900
وكانت غاضبة في المدرسة

184
00:09:41,900 --> 00:09:43,610
لذا أطلقتْ عليها توناري-سان بالسِّهام؟

185
00:09:43,610 --> 00:09:45,070
هذا عنيف، أليس كذلك؟

186
00:09:45,070 --> 00:09:47,590
نجتْ لأنّها كانت ترتدي سترة واقية من الرّصاص

187
00:09:47,590 --> 00:09:51,770
لذا أشعلناها بالنّار وفجّرناها وقمنا
بمجموعة أشياء حتّى ماتت

188
00:09:51,770 --> 00:09:52,860
بلا حسرة أو ندم

189
00:09:52,860 --> 00:09:54,010
!مهلاً لحظة

190
00:09:54,010 --> 00:09:55,830
!لماذا كنتُم عازمين على قتلها؟

191
00:09:55,830 --> 00:09:56,860
...لأنّني

192
00:09:56,860 --> 00:09:58,730
!ظننتُ بأنّ الجميع قد ماتوا

193
00:09:58,730 --> 00:09:59,710
!كان انتقاماً

194
00:09:59,710 --> 00:10:00,740
اصمدي

195
00:10:00,740 --> 00:10:01,810
...لحظة أُفكّر

196
00:10:01,810 --> 00:10:03,050
،حسبما أذكر

197
00:10:03,050 --> 00:10:07,170
كانت توناري-سان قد أخذت القوس
معها قبل غياب الجميع عن الوعي

198
00:10:07,170 --> 00:10:08,800
كان المُهاجم قد وجّه تحذيراً

199
00:10:08,800 --> 00:10:11,780
كانت مشهورة حتّى بين مُعجبي فوشي
بأنّها سريعة الانفعال

200
00:10:11,780 --> 00:10:16,500
لهذا كنتُ أنا وأوكي-كن في منزلي
نحمي فوشي معاً

201
00:10:16,500 --> 00:10:17,700
...هكذا إذاً

202
00:10:17,700 --> 00:10:19,460
ومن أين حصلتِ على القوس؟

203
00:10:19,460 --> 00:10:20,930
استعرتُه من نادي الرّماية

204
00:10:20,930 --> 00:10:23,510
لم يكن يُشبه الأقواس الّتي
يستخدمونها في النّادي

205
00:10:23,510 --> 00:10:25,440
إنّه من مُقتنيات عضو في النّادي

206
00:10:25,440 --> 00:10:27,450
أحضري ذلك التّلميذ إلى هنا

207
00:10:27,450 --> 00:10:28,930
تخرّج بالفعل

208
00:10:28,930 --> 00:10:30,520
أحضريه إلى هنا

209
00:10:30,940 --> 00:10:32,600
أنا هو ذلك الخرّيج

210
00:10:32,600 --> 00:10:34,440
!أنت تعمل هنا

211
00:10:34,440 --> 00:10:36,400
!وأيضاً ظهرتَ في التّلفزيون البارحة

212
00:10:36,400 --> 00:10:39,270
تكلّمتَ كما لو أنّه لا علاقة لك
!بالأمر، لكنّك غارق في التورُّط

213
00:10:39,270 --> 00:10:40,430
!أنا كذلك

214
00:10:40,430 --> 00:10:43,370
أنا بونتشين نيكولي لا تاستي بيتش أوراليس

215
00:10:43,750 --> 00:10:45,950
!إليك توقيعي

216
00:10:47,320 --> 00:10:48,550
...ألست

217
00:10:49,170 --> 00:10:51,300
!خجلاً من نفسك؟! أنت رجل بالغ

218
00:10:51,300 --> 00:10:53,590
!ماذا تفعل بغسل أدمغة هؤلاء الأطفال؟

219
00:10:54,110 --> 00:10:55,790
!أُذناي الثّمينتان

220
00:10:55,790 --> 00:10:57,420
!أنتِ مُخطئة يا سيّدتي

221
00:10:56,830 --> 00:10:58,290
!هذا يكفي يا سينسي

222
00:10:58,290 --> 00:10:59,590
!أوكي-كن

223
00:10:59,590 --> 00:11:00,930
سأخبركِ بالحقيقة

224
00:11:00,930 --> 00:11:03,090
بخصوص ما حدث في ذلك اليوم

225
00:11:03,090 --> 00:11:04,540
!دوّنتُ كلّ شيء هنا

226
00:11:04,540 --> 00:11:05,810
...يوكي-كن

227
00:11:06,140 --> 00:11:07,560
...لنرَ

228
00:11:07,560 --> 00:11:11,410
كان المُهاجمون عدداً لا يُحصى من الكائنات"
الفضائيّة الّتي تُدعى بالقارعين"؟

229
00:11:11,410 --> 00:11:13,350
أوكي-كن، أتعلم؟

230
00:11:13,660 --> 00:11:16,990
!لا أملك وقتاً لمُداراة هواياتك السّخيفة

231
00:11:16,990 --> 00:11:22,360
الطّريقة الوحيدة الّتي نُعرّف فيها ما ليس
مُعرّفاً هي أن نقبله

232
00:11:22,600 --> 00:11:25,890
لذا من فضلك دعي نادي أبحاث
!الغوامض يتعاملون مع هذا الأمر

233
00:11:25,890 --> 00:11:29,210
يجب علينا اتّخاذ الخطوة الأولى في إيجاد
!أرضيّة مع الكائنات الفضائيّة

234
00:11:29,210 --> 00:11:32,010
!مُؤلم! أفلتيني يا سينسي

235
00:11:30,240 --> 00:11:31,430
...يوكي

236
00:11:36,010 --> 00:11:38,260
مضى أسبوع منذ عودة ميزوها

237
00:11:38,260 --> 00:11:40,280
استخدم بون والمُؤسّسة نفوذهما

238
00:11:40,280 --> 00:11:41,830
لمنعنا جميعاً من التعرُّض لاعتقال

239
00:11:41,830 --> 00:11:42,810
...لكن

240
00:11:43,230 --> 00:11:48,240
حتّى من دون قائدهم، لا يزال
القارعون في السّطح

241
00:11:48,240 --> 00:11:52,690
،بحسب المارّة الّذين يعبرون
لم ينقصوا عدديّاً على الإطلاق

242
00:11:52,690 --> 00:11:55,380
،طلبنا منهم إيقاف غزوهم

243
00:11:55,380 --> 00:11:59,060
لكن أعتقد سيكون هناك المزيد
من القارعين الّذين يُسبّبون مُشكلة

244
00:11:56,530 --> 00:11:58,050
!أنا آسفة

245
00:11:59,060 --> 00:11:59,950
هل أنتِ بخير؟

246
00:11:59,950 --> 00:12:01,980
لا يختلف البشر عن ذلك

247
00:12:02,300 --> 00:12:04,470
وبعضنا يرتكب جريمة قتل حتّى

248
00:12:04,470 --> 00:12:06,650
لكن مُعظمنا لا نفعل

249
00:12:06,650 --> 00:12:08,870
هذا ما علينا التّركيز عليه

250
00:12:08,870 --> 00:12:11,730
لا جدوى من القلق على السّيّئين طوال الوقت

251
00:12:11,730 --> 00:12:13,340
معك حقّ يا يوكي

252
00:12:13,340 --> 00:12:15,680
أنا لا أكره آراءك حقّاً

253
00:12:18,130 --> 00:12:20,720
سواء عن طريق مجلّات أو تلفزيون
،أو أيّ شيء آخر

254
00:12:20,720 --> 00:12:22,730
أريد من النّاس أن يعلموا أكثر عن القارعين

255
00:12:22,730 --> 00:12:25,420
يجب علينا استعراض كافّة
الأشياء الحسنة بشأنهم

256
00:12:25,660 --> 00:12:29,900
إذا قَبِلناها نحن البشر، فسينفتح
القارعون علينا أيضاً. أنا متأكّد

257
00:12:30,220 --> 00:12:34,850
إذاً أنت تميل للتحكُّم بأجساد النّاس
كما يفعل القارعون

258
00:12:36,070 --> 00:12:40,120
.أعتقد بأنّه من المُبكّر جدّاً الجزم
أوّلاً، نحن بحاجة لفهمهم

259
00:12:40,120 --> 00:12:42,980
!أنت! حوّل

260
00:12:42,980 --> 00:12:44,030
هيروتوشي؟

261
00:12:44,860 --> 00:12:46,520
انتقلتُ مؤخّراً

262
00:12:46,520 --> 00:12:49,170
أستطيع أخيراً العيش بمُفردي

263
00:12:49,170 --> 00:12:51,990
من الصّعب التحدُّث مع القارعين في الخارج

264
00:12:51,990 --> 00:12:54,180
لذلك نستعير غرفة هيروتوشي

265
00:12:54,180 --> 00:12:55,640
مرحباً يا ميموري-كن

266
00:12:57,560 --> 00:12:58,460
...ألستِ

267
00:12:58,460 --> 00:13:00,370
أخت سوميكا؟

268
00:13:00,670 --> 00:13:03,390
ميتشي. إنّها مُندمجة تماماً. دعيتُها أنا

269
00:13:04,480 --> 00:13:06,950
لا أريد أن نكون أعداء

270
00:13:06,950 --> 00:13:08,420
لذا أريد أن نفهم بعضنا الآخر

271
00:13:08,420 --> 00:13:10,140
هلّا أخبرتِني بكلّ شيء من البداية؟

272
00:13:10,530 --> 00:13:11,790
تفضّل

273
00:13:19,240 --> 00:13:20,920
لنُوقف هذا

274
00:13:20,920 --> 00:13:23,530
تحاول ميتشي العيش ككائن بشريّ

275
00:13:23,530 --> 00:13:24,110
لا مُشكلة

276
00:13:24,720 --> 00:13:25,940
سأتكلّم

277
00:13:27,580 --> 00:13:33,360
في البداية، أخبروني بأنّه كان هناك
أشراراً علينا التخلّص منهم

278
00:13:33,360 --> 00:13:36,510
،لم أعرف السّبب في البداية
لكن لم يستغرق ذلك وقتاً

279
00:13:37,000 --> 00:13:41,190
يأخذون بعضاً من بَني جلدتنا ويحبسونهم في دُمى

280
00:13:41,530 --> 00:13:46,570
هناك، يتعلّمون أحاسيس الألم
والمُعاناة قبل عودتهم

281
00:13:46,570 --> 00:13:48,670
لذا ترتّب علينا إنقاذهم

282
00:13:48,970 --> 00:13:50,780
لذا نزلتُ أيضاً

283
00:13:51,180 --> 00:13:52,820
إلى مكان يُدعى رينريل

284
00:13:53,970 --> 00:13:56,290
رغم أنّني قُتِلتُ فوراً

285
00:13:57,190 --> 00:13:58,730
،عندما عدتُ للأعلى

286
00:13:58,730 --> 00:14:02,860
علّموني بأنّني لن أُقتَل في المرّة
المُقبِلة إذا أصبحتُ صغيراً

287
00:14:02,860 --> 00:14:03,770
...لذا

288
00:14:03,770 --> 00:14:05,800
مَن "هُم" الّذين تتكلّمين عنهم؟

289
00:14:05,800 --> 00:14:07,070
هُم نحن

290
00:14:07,070 --> 00:14:08,410
الّذين يشبهونني

291
00:14:08,670 --> 00:14:12,680
لكن صادفَ أنّ أحدنا يعرف
الكثير عن البشر

292
00:14:12,680 --> 00:14:14,780
لذا استمعنا إليهم جميعاً

293
00:14:14,780 --> 00:14:17,670
أحد القارعين الّذي كان في الحُماة؟

294
00:14:17,670 --> 00:14:18,990
هذا ما توقّعتُه

295
00:14:18,990 --> 00:14:20,380
...وكانوا يقولون

296
00:14:20,380 --> 00:14:22,250
"السّعي للتّعايُش"

297
00:14:22,250 --> 00:14:25,920
الكِفاح للارتقاء للعدالة كما"
"تُطبَّق بواسطة البشر

298
00:14:25,920 --> 00:14:26,570
!مهلاً

299
00:14:26,570 --> 00:14:28,970
لم يخبروك عمّا يحدث بعد تعايشكم؟

300
00:14:29,250 --> 00:14:31,160
!أقنعوكم بأنّ ذلك لن يكون ضارّاً

301
00:14:31,160 --> 00:14:33,350
مهلاً، مهلاً. اهدأ يا فوشي

302
00:14:33,350 --> 00:14:36,520
كنّا لنعيش داخل البشر للأبد

303
00:14:36,520 --> 00:14:41,720
لم أسمع شيئاً عمّا يمكن أن يحدث تالياً

304
00:14:41,970 --> 00:14:46,060
هل ستستبدلون كلّ كائنات العالم بقارعين؟

305
00:14:46,060 --> 00:14:48,230
هل هذا هو الهدف النّهائيّ لطموحكم؟

306
00:14:48,600 --> 00:14:50,110
لا أعلم

307
00:14:50,110 --> 00:14:51,970
لكن فوشي استيقظ

308
00:14:51,970 --> 00:14:53,880
فوشي يُعيد الموتى

309
00:14:53,880 --> 00:14:58,230
القارع داخل ميموري-تشان حاول
مسح فوشي، لكن لم يفلح ذلك

310
00:14:59,000 --> 00:15:01,200
ثمّ جاء الفتى الأسود

311
00:15:01,800 --> 00:15:03,420
لكن ذلك لم يفلح أيضاً

312
00:15:04,090 --> 00:15:07,230
القائد، قارع ميزوها، قد رحل

313
00:15:07,230 --> 00:15:11,990
لكن قارع والد ميزوها قال
بأنّ الأمر لم ينتهِ بعد

314
00:15:12,500 --> 00:15:15,510
من الواضح بأنّهم ينوون فعل المزيد

315
00:15:15,510 --> 00:15:17,430
لذا علينا أن نرسم خطّة الآن

316
00:15:17,790 --> 00:15:20,540
علينا أن نُقرّر ما يجب فعله

317
00:15:20,540 --> 00:15:24,310
كلّ ما يمكننا فعله هو البحث عن سُبُل
لقضاء الوقت المُتبقّي لدينا

318
00:15:24,860 --> 00:15:28,350
أريد أن أصبح ميتشي، لأجل
سوميكا وتوموري

319
00:15:28,650 --> 00:15:30,740
تريدين إذاً عيش حياة مُسالمة

320
00:15:30,740 --> 00:15:31,520
أجل

321
00:15:31,520 --> 00:15:34,160
ألستِ مهتمّة بهدفكِ الأصليّ بعد الآن؟

322
00:15:34,160 --> 00:15:37,110
...عندما دخلتُ جسد ميتشي، تفاجأت

323
00:15:37,110 --> 00:15:43,650
بالإحساس الجديد الّذي نشأ بداخلي
عندما ابتسمت تلكما الاثنتان في وجهي

324
00:15:43,650 --> 00:15:46,370
أريد الاحتفاظ بهذا الإحساس حاليّاً

325
00:15:46,920 --> 00:15:49,440
حتّى لو صاحبَه الألم

326
00:15:49,870 --> 00:15:52,080
أريد مُساعدتك في فعل ذلك

327
00:15:53,110 --> 00:15:57,340
أريدك أن تُساعديني في جعل حياتكم
أكثر بساطة ويسر

328
00:15:57,340 --> 00:15:58,470
ميتشي-تشان

329
00:16:04,440 --> 00:16:06,260
أحسد يوكي

330
00:16:06,550 --> 00:16:09,940
يعرف ما الّذي عليه فعله
وماذا يريد أن يفعل

331
00:16:10,730 --> 00:16:12,740
أتفهّم ما يحاول يوكي إنجازه

332
00:16:12,740 --> 00:16:13,790
...كلّ ما في الأمر

333
00:16:13,790 --> 00:16:17,100
لا أعرف ما الّذي أستطيع فعله
لأجله إذا لم تفلح الأمور

334
00:16:17,100 --> 00:16:17,960
خوف لا أساس له

335
00:16:18,380 --> 00:16:23,560
ما دام لديهم لحم، القارعون، وكلّ شيء
آخر، هُم تحت حمايتنا

336
00:16:23,560 --> 00:16:25,460
ماذا؟ ماذا تقول؟

337
00:16:25,460 --> 00:16:28,210
اكتسبني يا فوشي

338
00:16:28,210 --> 00:16:30,840
أ... كتسبك؟

339
00:16:30,840 --> 00:16:32,670
ما الّذي تتحدّث عنه؟

340
00:16:32,670 --> 00:16:33,970
أنا لا أمزح

341
00:16:34,770 --> 00:16:37,530
هذا ما درّبتُك لأجله

342
00:16:37,530 --> 00:16:41,010
كأقوى كائن يقطن هذا العالم

343
00:16:41,010 --> 00:16:43,050
لحظة، عمّاذا تتكلّم؟

344
00:16:43,050 --> 00:16:44,350
ماذا تقصد بـ"الاكتساب"؟

345
00:16:44,750 --> 00:16:48,230
سأنقل كلّ قدراتي إليك

346
00:16:48,230 --> 00:16:52,490
،ثمّ كلّ العالم، بما في ذلك القارعين
سيصبحون مُلكك

347
00:16:58,490 --> 00:17:01,280
أوّلاً، القدرة على خلق شيء من العدم

348
00:17:01,810 --> 00:17:03,500
يمكنك صنع أيّ شيء

349
00:17:03,500 --> 00:17:06,200
يمكنك تصميم أيّ شيء والتحكّم به كما تشاء

350
00:17:06,200 --> 00:17:08,640
حتّى الكائنات الحيّة

351
00:17:09,540 --> 00:17:12,670
كلّ ما هو موجود كان جزءاً منّي

352
00:17:12,670 --> 00:17:16,420
صنعتُ ومنحتُ الاستقلاليّة وسمحتُ بالتطوُّر

353
00:17:16,420 --> 00:17:19,960
أنا أمتلك كلّ شيء، وأستطيع
التّأثير على أيّ شيء

354
00:17:20,660 --> 00:17:23,640
،في هذا العالم، المادّة أقوى من الفاي

355
00:17:23,640 --> 00:17:26,600
حتّى لو حاول الفاي بهيئة القارعين

356
00:17:27,410 --> 00:17:31,160
السّيطرة عليها، ما داموا لا يصبحون
لحماً، ليسوا ندّاً لي

357
00:17:31,160 --> 00:17:33,360
سأمنحك ذلك الحقّ

358
00:17:33,360 --> 00:17:34,950
...لحظة

359
00:17:35,320 --> 00:17:36,670
،حسبما فهمت

360
00:17:36,670 --> 00:17:39,640
كلّما كان القارعون أصغر، زادت صعوبة كشفهم

361
00:17:39,640 --> 00:17:40,130
أجل

362
00:17:40,130 --> 00:17:42,870
وقلتَ بأنّ علينا الاقتراب لرؤيتهم

363
00:17:42,870 --> 00:17:44,920
هذا لأنّني اتّخذتُ هذا الجسد

364
00:17:44,920 --> 00:17:47,750
!لكن قلتَ بأنّنا خسرنا

365
00:17:48,120 --> 00:17:50,470
أين المتعة لو قلتُ خِلاف ذلك؟

366
00:17:50,470 --> 00:17:51,890
ماذا؟

367
00:17:52,230 --> 00:17:53,510
هل يُسلّيك هذا؟

368
00:17:54,360 --> 00:17:58,970
ليت أولئك المُتعلّقين بهذا العالم
يستطيعون العيش فيه

369
00:17:59,850 --> 00:18:02,250
،لو منحتُهم القوّة من البداية

370
00:18:02,250 --> 00:18:04,220
،لما قدّمَ أحدٌ المُساعدة

371
00:18:04,220 --> 00:18:07,160
وما كنتَ أنت لتكترث لأحد

372
00:18:07,760 --> 00:18:11,860
من أجل منحك هذه القوّة، أردتُك
أن تصبح مُتعلّقاً

373
00:18:13,910 --> 00:18:15,190
استرخِ

374
00:18:15,550 --> 00:18:18,210
،إن كنت لا تُريد رؤية أصدقائك يموتون

375
00:18:18,210 --> 00:18:20,380
فيمكنك منع أجسامهم من التّدهور

376
00:18:20,820 --> 00:18:24,490
،لم أجرّب ذلك على البشر أبداً
لكن يمكنك التّجربة

377
00:18:24,980 --> 00:18:26,490
أنت قديرٌ حرفيّاً

378
00:18:26,780 --> 00:18:31,960
هل ستدعني تلك القوّة أُعيد الأشخاص
الّذين رحلوا؟

379
00:18:32,320 --> 00:18:34,750
تريد إعادة النّاس من الجنّة؟

380
00:18:35,430 --> 00:18:37,800
لا توجد مادّة في ذلك العالم

381
00:18:37,800 --> 00:18:40,970
من المستحيل استعادة الفاي
رغماً عن إرادتهم

382
00:18:40,970 --> 00:18:41,670
...لكن

383
00:18:42,070 --> 00:18:44,380
إذا كان هذا ما تُريده، فيمكنك التّجربة

384
00:18:51,950 --> 00:18:55,600
لعلّه كان من المُبكّر جدّاً منحه
المعرفة بكلّ المواد

385
00:18:55,890 --> 00:18:58,580
لا، هذا ضمن التوقُّعات

386
00:18:58,580 --> 00:19:01,070
ينبغي لهذا أن يُطوّر تحمّله وصبره

387
00:19:01,070 --> 00:19:04,390
فوشي، يمكنني الانتظار لثلاث سنوات أُخرى

388
00:19:04,390 --> 00:19:06,920
عُد عندما تتّخذ قرارك

389
00:19:06,920 --> 00:19:10,030
سوف تصبح أنا

390
00:19:11,660 --> 00:19:12,470
!فوشي

391
00:19:12,470 --> 00:19:14,080
!آسف! وصلتُ أخيراً

392
00:19:14,080 --> 00:19:15,130
!أين القارعون؟

393
00:19:15,130 --> 00:19:16,360
غوغو

394
00:19:16,360 --> 00:19:18,680
تمّ ذلك بالفعل

395
00:19:19,380 --> 00:19:20,450
!لا

396
00:19:20,450 --> 00:19:21,520
!تبّاً يا فوشي

397
00:19:21,520 --> 00:19:23,260
لا تمُت! لم تمُت بعد، أليس كذلك؟

398
00:19:23,260 --> 00:19:24,570
—أرجوك! استيقـ

399
00:19:24,970 --> 00:19:27,220
كان مغميّاً عليه منذ اللّيلة الماضية

400
00:19:27,220 --> 00:19:28,530
ماذا حدث؟

401
00:19:28,530 --> 00:19:30,140
غوغو؟

402
00:19:30,140 --> 00:19:32,470
!هذا مُطمئن! أنت بخير

403
00:19:32,470 --> 00:19:33,960
أستطيع التّنظيف أخيراً

404
00:19:33,960 --> 00:19:36,150
هذا الفتى مغميّ عليه دوماً

405
00:19:36,150 --> 00:19:38,140
لا تقلقي يا توناري-نيسان

406
00:19:38,140 --> 00:19:41,020
ستصبح أنا

407
00:19:41,020 --> 00:19:43,360
سأصبح الأسود؟

408
00:19:45,910 --> 00:19:48,550
ساعدني يا غوغو

409
00:19:48,550 --> 00:19:49,630
فوشي؟

410
00:19:50,540 --> 00:19:51,970
هكذا إذاً

411
00:19:51,970 --> 00:19:54,010
فهمتُ الصّورة إجمالاً

412
00:19:54,010 --> 00:19:56,990
وكأنّه يدعوك لتصبح إلَهاً

413
00:19:56,990 --> 00:19:58,120
أو شيطاناً

414
00:19:58,120 --> 00:20:00,380
لكن لم يُحدَّد هذا بعد، أليس كذلك؟

415
00:20:00,380 --> 00:20:05,130
إن كنت تستطيع فعل أيّ شيء، فهذا يعني
أنّ لديك مسؤوليّة فعل كلّ شيء

416
00:20:05,520 --> 00:20:07,600
،لكن حتّى لو لم تصل إلى هذا الحدّ

417
00:20:07,600 --> 00:20:11,140
يبدو وكأنّك ستضطرّ لمُراقبة القارعين للأبد

418
00:20:11,140 --> 00:20:14,250
لا شيء جديد في ذلك

419
00:20:14,250 --> 00:20:18,090
لِمَ لا تحبس القارعين فحسب
إذا كان هذا شيئاً تستطيع فعله؟

420
00:20:18,090 --> 00:20:20,480
!أتقول "ساعدوني" أيّها الجبان؟

421
00:20:20,480 --> 00:20:22,400
!فوشي حُرّ فيما يفعل

422
00:20:22,400 --> 00:20:24,120
!هذا أفضل من مُحاولته التكتّم على الأمر

423
00:20:24,120 --> 00:20:28,010
لا أعرف السّبب، لكن ثمّة شيء
يُثير قلقي حول الأمر

424
00:20:28,010 --> 00:20:31,740
أردتُ سماع آرائكم بشأن ذلك

425
00:20:31,740 --> 00:20:33,120
حسناً، سأذهب

426
00:20:33,120 --> 00:20:34,240
أنا مُعارض لذلك

427
00:20:34,240 --> 00:20:37,960
لست بحاجة لتسمح للأسود بأن
يُخيفك بالهُراء الّذي يقوله

428
00:20:38,330 --> 00:20:39,650
أتّفق

429
00:20:39,650 --> 00:20:42,930
ألا يمكننا التنزُّه مع فوشي إذا أصبح إلَهاً؟

430
00:20:42,930 --> 00:20:44,710
أنا مُعارض لذلك أيضاً

431
00:20:44,710 --> 00:20:48,060
كلّما استطعت الشّعور، زادت مُعاناة جسدك

432
00:20:48,620 --> 00:20:52,550
لن يكون ذلك إيجابيّاً إذا كان يعني
أن تنام كما كنتَ في السّابق

433
00:20:52,780 --> 00:20:54,430
أؤيّد ذلك

434
00:20:54,430 --> 00:20:56,710
إذا كان شيئاً أنت الوحيد القادر
على فعله، فيجدر بك ذلك

435
00:20:56,710 --> 00:20:58,770
لا سيّما إن كنت لا تعرف ما قد يحدث

436
00:20:58,770 --> 00:20:59,680
...بون

437
00:20:59,680 --> 00:21:00,900
!هل أنت جادّ؟

438
00:21:00,900 --> 00:21:03,150
هل يمكنك تحمُّل المسؤوليّة
إذا أصاب مكروهٌ فوشي؟

439
00:21:03,150 --> 00:21:05,770
إن حدث ذلك، فسوف ندعمه بكلّ
ما أوتينا من قوّة

440
00:21:05,770 --> 00:21:07,160
إذا كان مُستعدّاً لذلك

441
00:21:07,160 --> 00:21:09,370
سأدع فوشي يُقرّر

442
00:21:09,370 --> 00:21:14,910
لا أكترث على أيّ حال، لكن
اجعلوا حياتي أبسط فحسب

443
00:21:15,790 --> 00:21:16,630
أيكو

444
00:21:23,030 --> 00:21:24,830
معكِ حقّ يا أيكو

445
00:21:25,250 --> 00:21:27,880
أريد أن أعيش هكذا أيضاً

446
00:21:28,320 --> 00:21:29,260
فو-تشان

447
00:21:29,540 --> 00:21:31,790
يمكنك فعل ما تريد

448
00:21:31,790 --> 00:21:34,600
سأراقبك دوماً أينما كنتُ

449
00:21:34,880 --> 00:21:36,000
...ماتشي

450
00:21:37,810 --> 00:21:40,690
حسناً، لديك ثلاث سنوات أُخرى، صحيح؟

451
00:21:40,690 --> 00:21:42,530
ليس عليك أن تُقرّر الآن

452
00:21:42,530 --> 00:21:44,050
أسحب كلامي

453
00:21:44,050 --> 00:21:45,460
أتّفق مع ماتشي

454
00:21:45,460 --> 00:21:47,350
أتّفق مع ماتشي-سان أيضاً

455
00:21:47,350 --> 00:21:49,500
جميعكم لُطفاء جدّاً

456
00:21:49,500 --> 00:21:51,070
أتّفق مع نفسي

457
00:21:51,070 --> 00:21:53,440
!أوني-تشان، لديك واجب التسوُّق اليوم

458
00:21:53,440 --> 00:21:55,120
لقد نسيت

459
00:21:55,120 --> 00:21:56,320
سأُرافقك

460
00:21:57,320 --> 00:22:00,500
لو كنتُ مكانك، لأخذتُ تلك القوّة

461
00:22:00,500 --> 00:22:01,620
لماذا؟

462
00:22:01,620 --> 00:22:04,340
دائماً ما أرغب في فعل الأشياء المُمتعة

463
00:22:04,340 --> 00:22:06,510
رغم عدم وجود ضمان بأنّ ذلك سيكون مُمتعاً؟

464
00:22:06,510 --> 00:22:10,000
حتّى لو لم يكن مُمتعاً، عليك
أن تستمتع بعدم الاستمتاع فحسب

465
00:22:10,000 --> 00:22:11,210
ماذا تقول؟

466
00:22:11,500 --> 00:22:15,940
لكن أتعلم يا فوشي؟ أعتقد بانّ
ما لدينا هو أكثر من كافٍ

467
00:22:16,370 --> 00:22:21,150
أنا مُجرّد كائن بشريّ، لذا سأموت
عن عمر كبير بعد ستّين عاماً

468
00:22:21,420 --> 00:22:26,990
لكن إذا فعل القارع بداخلي أيّ أمر
سيّئ، فقد أموت قبل ذلك

469
00:22:28,070 --> 00:22:29,990
لكن لن أسمح بذلك

470
00:22:29,990 --> 00:22:35,290
أريد أن أُثبت للقارع بأنّني لستُ بائساً
جدّاً لدرجة أمنحه جسدي

471
00:22:35,840 --> 00:22:40,090
إذا عشتُ حياتي بأكملها، فسيترتّب
عليك القبول بأنّ

472
00:22:40,090 --> 00:22:44,040
هذا العالم مُسالم بالفعل ومُرضٍ بوضعه الرّاهن

473
00:22:44,370 --> 00:22:47,790
لذا يجب أن تكون حاضراً في
لحظاتي الأخيرة، مفهوم؟

474
00:22:52,060 --> 00:22:54,020
عليّ الانتظار لستّين عام آخر؟

475
00:22:54,020 --> 00:22:55,440
سيكون الأوان قد فات حينها

476
00:22:56,570 --> 00:22:57,820
صحيح

477
00:24:31,760 --> 00:24:37,380
لم يبقَ أحد سوى فوشي لتبنّي العالم

478
00:24:38,190 --> 00:24:42,120
لكن العبء الّذي يخلفه كبير جدّاً

479
00:24:43,440 --> 00:24:45,790
جاء الرّبيع

480
00:24:46,100 --> 00:24:50,000
ووقت اتّخاذ فوشي القرار قد اقترب