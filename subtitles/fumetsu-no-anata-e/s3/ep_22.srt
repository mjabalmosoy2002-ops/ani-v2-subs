1
00:00:03,230 --> 00:00:06,530
لم يفلح شيء

2
00:00:08,860 --> 00:00:11,340
يُقرّر فوشي كيف سيقضي حياته

3
00:00:13,410 --> 00:00:16,540
مرحباً، أنا نونو

4
00:00:18,310 --> 00:00:21,500
سيستمرّ في هذا العالم كما كان يفعل

5
00:00:27,080 --> 00:00:29,520
هذا هو قراره

6
00:02:04,600 --> 00:02:06,230
!عيد ميلاد سعيد

7
00:02:06,980 --> 00:02:09,180
وبعد؟ كيف كانت الحياة معكِ؟

8
00:02:09,180 --> 00:02:10,690
هل تسير الأمور على ما يُرام؟

9
00:02:10,820 --> 00:02:13,650
بدأتُ للتو. هذا هو الفصل الأوّل فحسب

10
00:02:13,650 --> 00:02:17,540
أحرزت ميزوها-سان العلامة العُليا
في الرّياضيّات والفيزياء في عامنا

11
00:02:17,540 --> 00:02:20,330
أنا فخورة جدّاً بالالتحاق بنفس المدرسة الإعداديّة

12
00:02:20,570 --> 00:02:23,230
كاسابي-سان، هل أنتِ في صفّها أيضاً؟

13
00:02:23,230 --> 00:02:24,790
أجل... بشقّ الأنفس

14
00:02:24,990 --> 00:02:28,190
إذاً سوف تدرسين العلوم في الجامعة أيضاً؟

15
00:02:29,000 --> 00:02:30,590
على ما أعتقد. ماذا عنكِ؟

16
00:02:30,790 --> 00:02:33,820
أفكّر في رعاية الأطفال

17
00:02:33,820 --> 00:02:36,080
لكن سمعتُ بأنّه يجب أن نتعلّم العزف على البيانو

18
00:02:36,080 --> 00:02:38,350
ولم ألمس واحداً في حياتي، لذا لا أدري

19
00:02:38,350 --> 00:02:40,440
وأصابعي قصيرة جدّاً

20
00:02:41,700 --> 00:02:42,860
...بيانو

21
00:02:42,860 --> 00:02:44,510
كنتِ تعزفين البيانو، أليس كذلك يا ميزوها-سان؟

22
00:02:44,510 --> 00:02:46,470
!حقّاً؟ علّميني

23
00:02:46,470 --> 00:02:48,270
ربّما يوماً ما

24
00:02:50,590 --> 00:02:51,940
آسف لتأخُّري

25
00:02:51,940 --> 00:02:53,440
!أخفتني

26
00:02:53,440 --> 00:02:55,410
عيد ميلاد سعيد يا ميزوها

27
00:02:55,410 --> 00:02:57,410
ماذا تريدين؟ سأصنع لكِ أيّ شيء

28
00:02:57,410 --> 00:03:00,870
تجعل الأمر يبدو رخيصاً جدّاً

29
00:03:00,870 --> 00:03:03,470
أنت مُذهل حقّاً يا فوشي-كن

30
00:03:03,470 --> 00:03:06,440
سمعتُ إشاعات، لكنّك لم تتغيّر إطلاقاً حقّاً

31
00:03:06,440 --> 00:03:08,210
بالفعل. هذا ليس عدلاً، صحيح؟

32
00:03:08,210 --> 00:03:10,750
لِمَ علينا أن نبلغ الثّامنة عشر؟

33
00:03:11,020 --> 00:03:13,430
بالمناسبة، ألن يأتي يوكي-كن؟

34
00:03:13,430 --> 00:03:14,920
!آسف

35
00:03:15,190 --> 00:03:17,270
ترتّب عليّ الاهتمام ببعض الأمور

36
00:03:17,270 --> 00:03:19,260
!عيد ميلاد سعيد

37
00:03:19,620 --> 00:03:23,350
أنتِ حسناء في الثّامنة عشر أيضاً

38
00:03:23,350 --> 00:03:24,850
!شكراً

39
00:03:24,850 --> 00:03:26,480
لم أرك منذ وقت يا يوكي-كن

40
00:03:26,480 --> 00:03:28,440
و... من هذه الّتي بجانبك؟

41
00:03:28,440 --> 00:03:31,130
أجل، هذه أنا. توناري

42
00:03:32,660 --> 00:03:35,140
إذاً، هل عثرت على حبيبة يا يوكي-كن؟

43
00:03:35,140 --> 00:03:37,530
لا، أنا بائس تماماً

44
00:03:37,530 --> 00:03:39,140
أنا مشغول في تصوير فيديوهات

45
00:03:39,140 --> 00:03:40,950
!كنتُ أُشاهد قناتك

46
00:03:40,950 --> 00:03:42,110
عن القارعين

47
00:03:43,190 --> 00:03:45,200
أجل، الأمر ليس سهلاً إطلاقاً

48
00:03:45,200 --> 00:03:47,830
اصمد. فقد بدأتَ للتو، أليس كذلك؟

49
00:03:47,830 --> 00:03:49,380
!هـ-هـ-هذا صحيح

50
00:03:49,380 --> 00:03:51,530
!سأبقى قويّاً

51
00:03:49,670 --> 00:03:52,560
بئساً يا يوكي-كن، اهدأ قليلاً

52
00:03:52,560 --> 00:03:54,460
!لديهم بيرة هنا

53
00:03:54,460 --> 00:03:56,580
هل تفكّرين في الشّرب؟

54
00:03:57,170 --> 00:03:59,430
سآتي لأخذ الدرّاجة غداً

55
00:03:57,680 --> 00:03:59,430
ميسّارو. ما الأمر؟

56
00:03:59,430 --> 00:04:01,240
لا أعتقد بأنّ هذه هي المُشكلة الوحيدة

57
00:04:00,410 --> 00:04:02,820
بون؟ إنّه في الأستوديو التّلفزيونيّ

58
00:04:01,240 --> 00:04:02,550
!المعذرة

59
00:04:02,550 --> 00:04:03,790
!مهلاً يا توناري-سان

60
00:04:03,790 --> 00:04:05,640
لا! لا ينبغي لكِ أن تشربي حقّاً

61
00:04:05,640 --> 00:04:06,710
!أنتِ قاصرة

62
00:04:06,710 --> 00:04:07,620
!هنا! هنا

63
00:04:07,620 --> 00:04:09,630
!هانّا، أوقفيها

64
00:04:08,200 --> 00:04:10,190
!ماذا؟! أنتِ مُفلسة من جديد؟

65
00:04:11,530 --> 00:04:13,470
أنا لا أجني مالاً

66
00:04:13,470 --> 00:04:15,320
لا أريد أن تُوبّخني أيكو من جديد

67
00:04:15,320 --> 00:04:16,280
وداعاً

68
00:04:18,720 --> 00:04:19,770
مرحباً؟

69
00:04:20,600 --> 00:04:22,570
ماذا؟ اللّون المُفضّل لساتورو؟

70
00:04:22,570 --> 00:04:23,580
إنّه الأسود. الأسود

71
00:04:24,250 --> 00:04:26,280
ماذا تقصدين بأنّ هذا ليس ظريفاً؟

72
00:04:26,280 --> 00:04:28,770
لِمَ لا تُقرّرين أنتِ إذاً يا سوميكا؟

73
00:04:28,770 --> 00:04:29,670
وداعاً

74
00:04:33,020 --> 00:04:36,010
!ميسّارو! قلتُ لك بأنّني لن أصنع لك شيئاً

75
00:04:36,920 --> 00:04:38,280
تدليك للأكتاف؟

76
00:04:38,280 --> 00:04:40,120
لا. أنا بخير. إلى اللّقاء

77
00:04:40,120 --> 00:04:41,870
تبدو مشغولاً

78
00:04:41,870 --> 00:04:43,530
أشعر نفسي كأداة

79
00:04:43,530 --> 00:04:44,310
ما الأمر؟

80
00:04:44,570 --> 00:04:48,310
أتيتُ لأخبرك بما قرّرتُ بأنّني أريده
بالنّسبة ليوم ميلادي

81
00:04:48,310 --> 00:04:49,770
ماذا قرّرتِ؟

82
00:04:50,350 --> 00:04:51,280
كلامك

83
00:04:51,480 --> 00:04:52,480
كلامي؟

84
00:04:53,340 --> 00:04:55,270
"كلمة "فهمت

85
00:04:55,550 --> 00:04:56,890
ماذا تقصدين؟

86
00:04:57,160 --> 00:05:00,110
"أريدك فقط أن تقول "فهمت

87
00:05:00,110 --> 00:05:02,000
لا تقل أيّ شيء آخر

88
00:05:02,000 --> 00:05:04,890
أشعر بأنّه يتمّ خداعي للمُوافقة
على شيء لا ينبغي لي المُوافقة عليه

89
00:05:04,890 --> 00:05:06,730
فقط للعشر دقائق التّالية

90
00:05:06,730 --> 00:05:08,050
مفهوم؟

91
00:05:08,050 --> 00:05:09,200
مفهوم

92
00:05:10,060 --> 00:05:13,920
سأغادر للأبد بعد اليوم

93
00:05:15,560 --> 00:05:16,930
سأسافر إلى خارج البلاد

94
00:05:17,240 --> 00:05:19,950
،الآن بعد أن علم النّاسُ بالقارعين

95
00:05:19,950 --> 00:05:22,630
ازداد الاهتمام بالحُماة

96
00:05:22,630 --> 00:05:24,460
لذا سنفتتح فرعاً خارج البلاد

97
00:05:24,800 --> 00:05:26,650
لكن هذا ليس كلّ شيء

98
00:05:26,650 --> 00:05:28,690
لدينا كثير من الأعضاء

99
00:05:28,990 --> 00:05:30,720
وأريد العمل معهم للبحث

100
00:05:30,720 --> 00:05:34,630
عن حلّ لمُشكلة القارعين الّتي
تُلفت كثيراً من الانتباه مُؤخّراً

101
00:05:35,230 --> 00:05:39,160
أشعر وكأنّ هذا واجبي

102
00:05:40,000 --> 00:05:42,190
،كشخص يعرف القارعين

103
00:05:43,640 --> 00:05:47,310
أريد بناء عالم ستكون سعيداً فيه

104
00:05:48,880 --> 00:05:51,040
أنوي المُغادرة دون قول شيء

105
00:05:51,500 --> 00:05:53,340
رحلتي في الطّائرة غداً

106
00:05:53,340 --> 00:05:55,470
على أيّ حال، هلّا صنعت لي معروفاً؟

107
00:05:56,130 --> 00:05:59,330
هلّا امتنعت عن إخبار أصدقائنا لبعض الوقت؟

108
00:05:59,330 --> 00:06:02,970
ستعرف أين أنا، صحيح؟

109
00:06:02,970 --> 00:06:06,470
لا أريد أن أراهم حزينين بعد الآن

110
00:06:06,760 --> 00:06:08,770
...يمكننا دوماً الذّهاب

111
00:06:09,140 --> 00:06:10,580
مفهوم؟

112
00:06:11,130 --> 00:06:12,200
مفهوم

113
00:06:12,200 --> 00:06:14,170
لن أطلب منك المجيء لرؤيتي

114
00:06:14,170 --> 00:06:16,230
أريدك فقط أن تشعر

115
00:06:16,630 --> 00:06:19,510
أن تشعر بأنّني موجودة هناك في مكان ما

116
00:06:20,030 --> 00:06:23,610
وبأنّه كانت هناك فتاة تُدعى
ميزوها شكلها هكذا

117
00:06:24,970 --> 00:06:26,120
فهمت

118
00:06:26,550 --> 00:06:29,000
وطلب واحد أخير

119
00:06:29,000 --> 00:06:32,320
هلّا أغمضت عينيك لثلاثين ثانية؟

120
00:07:16,340 --> 00:07:17,930
تأخّرت كثيراً يا فوشي

121
00:07:17,930 --> 00:07:19,350
بِمَن كنت تتّصل؟

122
00:07:19,350 --> 00:07:21,610
ماذا؟ أين ميزوها؟

123
00:07:25,420 --> 00:07:28,680
ميزوها-سينباي، إلى أين ذهبتِ؟

124
00:07:28,680 --> 00:07:30,710
تشجّع يا يوكي

125
00:07:30,710 --> 00:07:32,380
انتهيتُ من تحرير الفيديو

126
00:07:32,380 --> 00:07:33,890
تفقّده من فضلك

127
00:07:34,180 --> 00:07:35,850
هل هو مُمتع إلى هذا الحدّ؟

128
00:07:35,850 --> 00:07:37,140
أتقصد بناء النّماذج؟

129
00:07:37,510 --> 00:07:41,710
حصلتُ على المواد من زميلي عبر
،الإنترنت الّذي غادرَ المشهد

130
00:07:41,710 --> 00:07:44,740
!وتركَني مُدمناً تماماً

131
00:07:44,750 --> 00:07:48,790
سألتقط صوراً مع كايجو حالما
!أفرغ من بناء المدينة

132
00:07:48,790 --> 00:07:50,780
أتريد الانضمام يا ساتورو-دونو؟

133
00:07:51,170 --> 00:07:54,040
لا. كبرتُ على مثل هذه الأمور

134
00:07:54,040 --> 00:07:57,660
ماذا؟ لديك خبرة في المجال، صحيح؟
دائماً مُرحّب بك في مُمارسة الهواية

135
00:07:58,170 --> 00:07:58,970
حسناً

136
00:07:59,380 --> 00:08:01,290
فوشي، ينبغي أن نتحرّك

137
00:08:01,290 --> 00:08:04,270
حسناً، سنتولّى زمام الأمر من هنا

138
00:08:04,270 --> 00:08:05,760
أجل، شكراً

139
00:08:05,760 --> 00:08:07,250
ألقاك لاحقاً أيّها الأسود

140
00:08:07,250 --> 00:08:08,200
حسناً

141
00:08:09,270 --> 00:08:11,830
حسناً إذاً يا نونو، اعذرني على الإزعاج

142
00:08:12,200 --> 00:08:13,680
أبداً، لا مُشكلة

143
00:08:13,810 --> 00:08:15,270
هل يحدث أمرٌ ما؟

144
00:08:15,270 --> 00:08:17,550
أتيتُ اليوم لأقول وداعاً للمرّة الأخيرة

145
00:08:17,910 --> 00:08:19,390
سأدع فوشي تحت رعايتكم

146
00:08:19,630 --> 00:08:21,810
وداعاً؟ لِمَ هذه المرّة الأخيرة؟

147
00:08:22,030 --> 00:08:24,480
هذه آخر مرّة أستطيع فيها أن أكون نفسي

148
00:08:33,030 --> 00:08:34,080
غداً

149
00:08:34,560 --> 00:08:36,720
مضى أربع سنوات منذ حصلتُ
على هذا الجسد

150
00:08:37,160 --> 00:08:39,120
أربع سنوات منذ أتيتُ إلى هنا

151
00:08:39,370 --> 00:08:43,150
غداً، سأخسر كلّ شيء يُكوّنني

152
00:08:43,600 --> 00:08:47,130
أوّلاً، كلّ القوى الغير مُلائمة لجسد بشريّ

153
00:08:47,390 --> 00:08:50,590
ثانياً، ذكرياتي عن الفترة الّتي
كنتُ أستخدم فيها تلك القوى

154
00:08:50,990 --> 00:08:53,050
،سأنساكم جميعاً

155
00:08:53,050 --> 00:08:54,620
وأواصل حياتي فقط مع الذّكريات

156
00:08:54,620 --> 00:08:56,350
الّتي جمعتُها كبشريّ يُدعى ساتورو

157
00:08:56,800 --> 00:08:59,450
حتّى لو أخبرتموني مَن أكون
،فعلاً يوم غد

158
00:08:59,450 --> 00:09:02,090
فلن أفهم شيئاً ممّا تقصدون

159
00:09:02,650 --> 00:09:04,480
سيُغادر الرّبّان السّفينة

160
00:09:04,800 --> 00:09:07,440
يعزو الأمر لكم جميعاً في تحديد
ما  تريدونه في المُستقبل

161
00:09:07,440 --> 00:09:11,650
إذاً هذه هي تلك "الحرّية" الّتي
تتكلّم عنها في مرحلة ما

162
00:09:13,220 --> 00:09:16,990
ليس عليك الإصغاء للشّيطان
بعد الآن يا فوشي

163
00:09:16,990 --> 00:09:21,500
أرغب أن أرعب مَن تكون بالضّبط
قبل أن تفقد ذاكرتك

164
00:09:21,830 --> 00:09:26,610
إذاً هدفك طوال هذا الوقت هو التحوُّل
إلى فتى غريب ما؟

165
00:09:26,610 --> 00:09:28,510
لديك ذوق فظيع إن كان هذا ما هو عليه الأمر

166
00:09:28,790 --> 00:09:31,520
إذاً تستطيع مسح ذاكرتك بسهولة بالغة

167
00:09:31,520 --> 00:09:35,480
هل العالم مُسالمٌ جدّاً الآن بما أنّك ستمسح
ذاكرتك دون أن تتحسّر على شيء؟

168
00:09:36,720 --> 00:09:39,270
ماذا سنفعل بعد أن تتركنا وترحل؟

169
00:09:39,270 --> 00:09:41,310
ماذا لو خرج القارعون عن السّيطرة ثانية

170
00:09:41,310 --> 00:09:43,350
ولم يعُد فوشي يقوى عليهم؟

171
00:09:43,690 --> 00:09:46,790
ماذا لو كان لا يزال يوجد قارعون في أجسادنا؟

172
00:09:46,790 --> 00:09:49,480
حتّى فوشي لا يستطيع معرفة ذلك، صحيح؟

173
00:09:49,710 --> 00:09:51,810
ماذا لو قرّروا قتلنا؟

174
00:09:52,240 --> 00:09:54,950
كان فوشي يعلم بالمخاطر عندما
قرّرَ الوثوق بالقارعين

175
00:09:55,550 --> 00:09:58,660
لهذا قرّر ألّا يرِث قِوايّ

176
00:09:58,660 --> 00:09:59,630
أليس كذلك؟

177
00:09:59,630 --> 00:10:02,090
...أجل. معك حقّ، لكن

178
00:10:02,090 --> 00:10:04,000
أتفهّم بأنّك قلق

179
00:10:04,350 --> 00:10:08,120
هل هدفكم النّهائيّ هو عيش عمر مديد؟

180
00:10:08,340 --> 00:10:11,760
أم إبادة القارعين؟

181
00:10:12,250 --> 00:10:13,650
لا أدري

182
00:10:13,650 --> 00:10:15,780
في كلتا الحالتين، سعادتكم لن تكون مضمونة

183
00:10:16,560 --> 00:10:18,390
يوكي، أحضر لي الشّيء

184
00:10:18,390 --> 00:10:19,440
حسناً

185
00:10:20,060 --> 00:10:24,850
على أيّ حال، تنازلتُ عن القوّة الّتي
سمحتْ لي بالتحكُّم بالقارعين

186
00:10:25,430 --> 00:10:27,230
أعتقد بأنّكم سترضون أكثر

187
00:10:27,640 --> 00:10:31,760
بالقلق بشأن مُخطّطاتكم ليوم غد أكثر
من القلق بشأن مسألة قد حُسِمت بالفعل

188
00:10:33,510 --> 00:10:34,740
فخّار صلصال؟

189
00:10:34,930 --> 00:10:37,620
سأترك هذا معك. هذه هي ذكرياتي

190
00:10:38,430 --> 00:10:40,900
ألقِ نظرة إليه عندما تضجر كثيراً

191
00:10:41,410 --> 00:10:42,660
ذكرياتك؟

192
00:10:42,660 --> 00:10:44,640
لحظة، إلى أين أنت ذاهب؟

193
00:10:44,640 --> 00:10:45,680
إلى المنزل

194
00:10:45,680 --> 00:10:48,130
تمّ إبلاغي بواسطة طاقم المُؤسّسة
بأن أعود باكراً

195
00:10:48,130 --> 00:10:50,150
ماذا؟ هذا غير منطقيّ إطلاقاً

196
00:10:50,150 --> 00:10:52,340
كفى هُراء يا فتى! أهذا كلّ ما لديك لأجلنا؟

197
00:10:52,700 --> 00:10:53,840
هذا صحيح

198
00:10:53,840 --> 00:10:55,970
أتيتُ لأقول وداعاً فحسب

199
00:10:55,970 --> 00:10:58,150
!دعني أضربك بينما لا تزال تحتفظ بذاكرتك

200
00:10:58,150 --> 00:10:59,050
!انتظر يا ميسّارو

201
00:10:59,380 --> 00:11:00,950
،أخيراً يا فوشي

202
00:11:00,950 --> 00:11:04,640
من أجل المُناسبة الّتي تُصاب فيها بنوبة
،غضب أو تصبح سُلطعاناً أو فاكهة ثانية

203
00:11:05,100 --> 00:11:07,600
احرص على أن يكون أصدقاؤك
قريبين منك طوال الوقت

204
00:11:08,830 --> 00:11:09,820
!انتظر

205
00:11:10,790 --> 00:11:14,950
!أنت... أنت من أحضر فو-تشان إلى هنا

206
00:11:14,950 --> 00:11:17,200
!حريّ بك أن تعتني به حتّى النّهاية

207
00:11:17,460 --> 00:11:18,620
أتعلم ماذا؟

208
00:11:18,620 --> 00:11:21,700
عندما كنتُ صغيرة، علّمتُه كيفيّة الأكل

209
00:11:22,090 --> 00:11:26,200
!علّمتُه كيفيّة التبوُّل وكيف يشكر

210
00:11:26,440 --> 00:11:29,800
!ماذا فعلتَ أنت لـ فو-تشان؟

211
00:11:30,840 --> 00:11:32,320
...ماتشي

212
00:11:34,170 --> 00:11:35,230
لا شيء

213
00:11:35,630 --> 00:11:36,910
لم أفعل شيئاً

214
00:11:42,130 --> 00:11:43,270
...ماتشي

215
00:11:44,100 --> 00:11:46,260
أستطيع أن أخبركِ بما فعله لأجلي

216
00:11:47,130 --> 00:11:49,510
جمعَني مع أصدقاء عُظماء

217
00:11:54,620 --> 00:11:56,650
تقرير سَير العمل

218
00:11:57,220 --> 00:12:00,110
ستكون هذه آخر رسالة لي

219
00:12:00,730 --> 00:12:05,220
هذه مُجرّد وصيّة ستُترك لجزء من نفسي

220
00:12:05,830 --> 00:12:09,390
في البداية، كنتُ عدماً

221
00:12:10,190 --> 00:12:13,840
،كان كلّ ما لديّ هو إحساس بالكيان

222
00:12:14,080 --> 00:12:17,830
والشّعور بأنّني مُحاط بواسطة الكثيرين

223
00:12:18,310 --> 00:12:22,330
عبثْنا بأحاسيسنا المُتبدِّلة

224
00:12:23,370 --> 00:12:29,020
امتداد وتدوير وانتشار وتطبيق المعنى

225
00:12:29,210 --> 00:12:33,480
كنّا ننقل هذا إلى الآخرين، وبين
المُستقبِلين هو أنا

226
00:12:34,330 --> 00:12:37,120
كنّا نستطيع الخَلق بحرّية مُطلَقة

227
00:12:37,120 --> 00:12:40,550
كرّرنا ذلك مِراراً

228
00:12:40,550 --> 00:12:43,320
"لم تكن هناك فكرة "مستحيل

229
00:12:43,320 --> 00:12:46,290
ومضى ما يبدو أنّه الخلود

230
00:12:49,640 --> 00:12:52,780
وشعرتُ بالضّجر

231
00:12:53,630 --> 00:13:00,290
لم أكن أعرف من أين جاء هذا الإحساس
أو ما إن كنتُ الوحيد الّذي شعر به

232
00:13:00,290 --> 00:13:04,300
باستذكار الماضي، كنتُ طمّاعاً

233
00:13:04,830 --> 00:13:07,930
سرعان ما بدأتُ بالعمل على خليقة جديدة

234
00:13:08,440 --> 00:13:13,000
قرّرتُ بناء جنّتي الخاصّة

235
00:13:13,770 --> 00:13:17,030
عالم يتغيّر من تلقاء نفسه ويتكرّر بنفسه

236
00:13:17,210 --> 00:13:20,530
جعلتُ الثّلوج تتساقط واستدعيتُ العواصف

237
00:13:20,530 --> 00:13:23,390
سلّيتُ نفسي وأنا أراهم يلوذون بالفرار

238
00:13:24,200 --> 00:13:27,050
فرضتُ قيوداً عليهم

239
00:13:27,050 --> 00:13:29,660
كان لديهم لُغات وأعمارهم محدودة

240
00:13:30,100 --> 00:13:33,880
هدفتُ لبناء عالم مُعاكس لعالمي

241
00:13:34,140 --> 00:13:37,210
والبدن هشّ جدّاً لدرجة أنّه سُرعان
ما يتوقّف عن الحركة

242
00:13:37,210 --> 00:13:40,920
واللّحم الميّت يبعث رائحة كريهة ويصبح مُقرفاً

243
00:13:41,290 --> 00:13:43,680
ولسبب ما، يجتمع الآخرون حولهم

244
00:13:44,710 --> 00:13:45,590
...وشعرتُ

245
00:13:46,290 --> 00:13:48,410
أنّ ذلك كان جميلاً جدّاً

246
00:13:52,890 --> 00:13:58,170
كانت لديّ رغبة شديدة في أن أكون
،وسط جُزيئات الغُبار هذه

247
00:13:58,560 --> 00:14:03,710
لإنهاء وجودي بعد تجربة الأحاسيس هنا

248
00:14:04,160 --> 00:14:09,330
—لتحقيق تلك الغاية، أحتاج شيئاً يُدير هذا المكان

249
00:14:09,330 --> 00:14:12,590
أو لحفظه

250
00:14:13,080 --> 00:14:15,540
صنعتُ شعب الفخّار الصّلصال

251
00:14:15,540 --> 00:14:18,860
وطبّقتُ تجاربَ بتخزين معلومات داخل فخّاراتهم

252
00:14:19,150 --> 00:14:23,980
لكن أولئك الّذين من هذا العالم
لم يكن ليعيشوا حياة مديدة

253
00:14:23,980 --> 00:14:28,640
،شعب الفخّار الصّلصال، كما الآخرين
كان وقتهم محدوداً

254
00:14:28,930 --> 00:14:32,180
ثمّ صنعتُ شيئاً خاصّاً

255
00:14:32,910 --> 00:14:35,440
شيئاً يتمتّع بالبدن الأقوى

256
00:14:35,960 --> 00:14:37,310
فوشي

257
00:14:37,650 --> 00:14:40,810
،ستختفي أبديّتي في العدم

258
00:14:40,810 --> 00:14:44,670
لكن يسرّني تحقيق أُمنيتي الأخيرة

259
00:14:47,180 --> 00:14:55,170
عيد ميلاد سعيد

260
00:14:58,330 --> 00:15:00,250
أنت هناك، أليس كذلك أيّها الأسود؟

261
00:15:16,720 --> 00:15:21,780
...عيد ميلاد سعيد يا ساتورو-تشان

262
00:15:22,130 --> 00:15:23,530
أنت هناك، أليس كذلك؟

263
00:15:27,470 --> 00:15:32,330
!عيد ميلاد سعيد لك

264
00:15:36,390 --> 00:15:38,420
شكراً لكم

265
00:15:43,190 --> 00:15:47,020
تركَنا الأسود ورحل

266
00:15:49,410 --> 00:15:53,810
!لا! لا! لم أصبح أسمن

267
00:15:54,110 --> 00:15:55,140
رأيت؟

268
00:15:57,360 --> 00:15:58,870
ما الأمر يا ماتشي؟

269
00:15:58,870 --> 00:16:01,480
،حاولتُ أن أجعل شعري مُتموّجاً بشكل مُبهر

270
00:16:01,480 --> 00:16:03,940
فتحوّل إلى عشّ طائر بدلاً من ذلك

271
00:16:04,610 --> 00:16:06,160
أهذا كلّ ما في الأمر؟

272
00:16:06,160 --> 00:16:07,640
!كيف تجرؤ؟

273
00:16:07,640 --> 00:16:10,290
!سخرت منّي للتو يا فو-تشان

274
00:16:08,430 --> 00:16:09,660
آسف، آسف

275
00:16:10,570 --> 00:16:14,280
لم أفهم حتّى نصف ما قاله الأسود

276
00:16:14,280 --> 00:16:17,100
لكن أعتقد بأنّه علّمني بأنّ أيّ وضع
سوف يصبح في النّهاية مُملّاً

277
00:16:17,100 --> 00:16:19,960
وبأنّك لن تشعر بالرّضا أبداً

278
00:16:20,660 --> 00:16:22,250
آسف لتأخُّري

279
00:16:22,250 --> 00:16:24,510
!ينقصني شيء ما حتماً

280
00:16:24,080 --> 00:16:25,210
ماذا؟ ينقصك ماذا؟

281
00:16:25,210 --> 00:16:27,010
!عضلاتي

282
00:16:27,010 --> 00:16:28,930
ما مجموعة العضلات الّتي تعتقد
بأنّها تنقصني؟

283
00:16:30,150 --> 00:16:31,890
ليس وكأنّني لا أُبالي بعد الآن

284
00:16:32,520 --> 00:16:35,960
لكن لحسن الحظّ، لا يوجد قارعون سيّئون الآن

285
00:16:35,960 --> 00:16:37,830
يعزو الأمر لنا الآن

286
00:16:38,210 --> 00:16:42,150
يجب علينا أن نُثبت لأنفسنا بأنّ
أجسادنا ليست رخيصة جدّاً

287
00:16:42,150 --> 00:16:44,320
لدرجة نسمح للقارعين بالسّيطرة عليها

288
00:16:44,560 --> 00:16:48,360
في كلتا الحالتين، سعادتكم لن تكون مضمونة

289
00:16:48,600 --> 00:16:51,290
ما هي السّعادة بالنّسبة لنا؟

290
00:16:51,290 --> 00:16:53,030
أمسى ذلك سؤالي

291
00:16:53,490 --> 00:16:55,690
لطالما بدا ميسّارو مُستمتعاً بوقته

292
00:16:55,690 --> 00:16:57,880
هذا هو الشّيء الوحيد الّذي
استطعتُ تعلّمه منه

293
00:16:57,880 --> 00:17:00,290
ينبغي لهذا أن يمنحني لمحة حول
كفيّة عَيش حياتي

294
00:17:00,680 --> 00:17:02,420
ما الأمر يا فوشي؟

295
00:17:02,420 --> 00:17:04,830
هل أبدو حقّاً عديم المُبالاة إلى هذا الحدّ؟

296
00:17:04,830 --> 00:17:06,990
أجل. لا تبدو تعيساً على الأقلّ

297
00:17:06,990 --> 00:17:09,550
تركتُ بؤسي خلفي في رينريل

298
00:17:10,190 --> 00:17:11,890
تقصد الأميرة آلمي؟

299
00:17:13,660 --> 00:17:16,770
لا بؤس يفوق ذلك البؤس مهما حدث

300
00:17:16,770 --> 00:17:18,490
هذا ما أنا مُتيقّن منه

301
00:17:18,490 --> 00:17:20,520
كلّ شيء شاقّ الآن

302
00:17:20,520 --> 00:17:22,690
!ممتاز

303
00:17:22,690 --> 00:17:26,640
ربّما ليست فكرة سيّئة أن نعيش
اللّحظة ولو لمرّة

304
00:17:27,690 --> 00:17:33,200
لا، ميسّارو يُرضي دماغه بالخمر والمُقامرة

305
00:17:33,200 --> 00:17:36,240
هذا مُجرّد وهم. لا يمكن أن نعتبر هذه سعادة

306
00:17:36,240 --> 00:17:38,660
هل تعرف ما هي السّعادة يا هايرو؟

307
00:17:39,030 --> 00:17:40,150
!هذه هي

308
00:17:40,150 --> 00:17:41,410
ما هذه الورقة؟

309
00:17:41,410 --> 00:17:44,170
!شهادة فنّي مصنع خبز

310
00:17:44,890 --> 00:17:47,920
!لا أعرف ما يكون هذا، لكن مُذهل. مُبارك

311
00:17:48,110 --> 00:17:52,930
قال هايرو بأنّ السّعادة هي شيء
يمكن اكتسابه بجهودنا الشّخصيّة

312
00:17:54,030 --> 00:17:57,390
تعلّمتْ أيكو استخدام بعض الكلمات الأساسيّة

313
00:17:57,590 --> 00:18:00,130
...مُعلّمها، ووالدا يوكي

314
00:18:00,130 --> 00:18:02,600
لديها مُختلَف أنواع النّاس لتدريسها

315
00:18:02,990 --> 00:18:06,310
قد تأتي السّعادة على شكل تلقّي
تعليم بواسطة شخص حسبما أدركت

316
00:18:06,920 --> 00:18:10,020
حسناً، ماذا عنك يا فوشي-سان؟

317
00:18:10,020 --> 00:18:13,220
انتهى عملك مع الأسود الآن

318
00:18:13,220 --> 00:18:15,930
أليس لديك مُخطّطات للبدء بحياة جديدة؟

319
00:18:15,930 --> 00:18:17,530
لا، لا أعلم بعد

320
00:18:17,830 --> 00:18:21,160
لا شيء سِوى المُواصلة

321
00:18:21,160 --> 00:18:22,420
هكذا إذاً

322
00:18:22,930 --> 00:18:25,110
...أرغب في انتهاز هذه الفُرصة للسّؤال

323
00:18:25,110 --> 00:18:28,500
من فضلك، عندما أموت، أعدني
إلى الحياة ثانية

324
00:18:28,500 --> 00:18:31,600
كنتُ أنانيّاً فحسب آنذاك

325
00:18:31,600 --> 00:18:33,070
لا عليك يا كاي

326
00:18:33,070 --> 00:18:34,760
لا، ليس هذا ما أعنيه

327
00:18:35,540 --> 00:18:40,150
فأنا لا أريد ببساطة أن تكون
نهايتي هي عندما أموت

328
00:18:40,150 --> 00:18:41,770
حسناً. فهمت

329
00:18:42,110 --> 00:18:43,980
يتمّ إرشادي وتعليمي أيضاً

330
00:18:44,380 --> 00:18:49,440
لنذهب جميعاً ونتناول شرائح اللّحم
!احتفالاً بنجاح هايرو في امتحانه

331
00:18:49,790 --> 00:18:51,270
أتقود أنت يا بون؟

332
00:18:51,270 --> 00:18:53,280
بالفعل! مُثير، أليس كذلك؟

333
00:18:53,280 --> 00:18:55,410
برخصة القيادة الجديدة كلّياً خاصّتي

334
00:18:55,410 --> 00:18:56,430
هل أنت متأكّد من هذا؟

335
00:18:56,430 --> 00:18:57,760
هل تُجيد القيادة فعلاً؟

336
00:18:57,760 --> 00:19:00,540
لطالما تدبّرنا أمورنا، أليس كذلك؟

337
00:19:00,540 --> 00:19:02,700
!لن نتوقّف الآن

338
00:19:02,700 --> 00:19:05,210
فوشي-سان، تذكّر، أنا أعتمد عليك

339
00:19:06,560 --> 00:19:07,610
هذا صحيح

340
00:19:08,000 --> 00:19:13,210
،حتّى لو لم نشعر بالرّضا الآن
ما زال هناك المزيد ينتظرنا

341
00:19:14,740 --> 00:19:19,430
لذا أريد على الأقلّ أن أُقدّر المرح
الّذي أمامي الآن

342
00:19:22,030 --> 00:19:24,930
حسناً. لكن سيترتّب علينا شراء مؤونات

343
00:19:24,930 --> 00:19:26,810
سقطت منك هذه

344
00:19:26,810 --> 00:19:28,500
شكراً

345
00:19:28,500 --> 00:19:31,150
ماذا؟ هل انكسرت؟

346
00:19:31,420 --> 00:19:34,110
إنّها عتيقة. لم تكن تعمل أصلاً

347
00:19:34,460 --> 00:19:37,270
حصلتُ عليها كهديّة عيد ميلاد

348
00:19:37,270 --> 00:19:39,410
بحثوا عنها واشتروها لأجلي

349
00:19:42,490 --> 00:19:43,720
!إنّها تعمل

350
00:19:44,120 --> 00:19:45,960
!شكراً لك

351
00:19:46,820 --> 00:19:48,870
هل أنت بخير؟

352
00:19:48,870 --> 00:19:50,180
!بسرعة

353
00:19:50,180 --> 00:19:51,640
!انتظرا

354
00:19:53,470 --> 00:19:55,580
!ساعة اليد تعمل الآن

355
00:19:55,580 --> 00:19:55,970
حقّاً؟

356
00:19:55,970 --> 00:19:56,840
هذا رائع

357
00:19:57,930 --> 00:20:01,660
قضينا ستّين عاماً هنا

358
00:20:07,720 --> 00:20:10,660
ماذا؟ قطعت كلّ هذه المسافة؟

359
00:20:10,660 --> 00:20:15,400
أنا متأكّدة بأنّ بعض العجائز
لن يعرفوا من تكون حقّاً

360
00:20:16,290 --> 00:20:17,400
أجل

361
00:20:17,400 --> 00:20:20,100
يمكنك أن تأتي من أجل البخّور وأداء صلاة فحسب

362
00:20:20,100 --> 00:20:21,960
أتى كثير من النّاس

363
00:20:21,960 --> 00:20:25,410
من الأفضل غالباً أن تأتي كأحد الحضور العوام

364
00:20:25,870 --> 00:20:28,740
أنا آسفة لأنّ هذا الأمر مُعقّد جدّاً بالنّسبة لك

365
00:20:28,740 --> 00:20:32,380
فقط تعال بملابسك العاديّة في زيارة سريعة

366
00:20:32,660 --> 00:20:33,940
...أيكو

367
00:20:33,940 --> 00:20:36,450
كانت عائلتكِ لطيفة جدّاً معي

368
00:20:36,450 --> 00:20:37,530
شكراً

369
00:20:37,910 --> 00:20:41,880
أنا مُمتنّ له لبقائه معنا هذه المدّة الطّويلة

370
00:20:42,220 --> 00:20:46,220
أنا متأكّدة بأنّ أخي مُمتنّ لقولك ذلك

371
00:20:46,970 --> 00:20:49,360
أقيمت خدمة الجنازة

372
00:20:49,360 --> 00:20:52,070
لباحث القارعين البارز الأستاذ
الفخريّ أوكي يوكي

373
00:20:52,070 --> 00:20:54,310
في دار عزاء ميناموتو

374
00:20:54,310 --> 00:20:57,620
حضرَ الكثير من الشّخصيّات الهامّة
إلى جلسة عزائه

375
00:20:58,380 --> 00:21:02,120
كريم الجسم الّذي صمّمَه وطوّرَه
في سنوات شبابه

376
00:21:02,120 --> 00:21:07,770
جذبت الأنظار إلى قدرة هذا الكريم
على منع اختراق القارعين

377
00:21:08,540 --> 00:21:14,050
رقاقة كايبارا السّيبرانيّة هي السّبيل
،الرّئيسيّ للتحكُّم بالقارعين

378
00:21:14,050 --> 00:21:16,780
لكن كان محبوباً جدّاً باعتباره كان أوّل

379
00:21:16,780 --> 00:21:21,470
من سلّط الضّوء على الإمكانيّات
بين القارعين والبشريّة

380
00:21:21,980 --> 00:21:26,540
عشتُ حياة مُمتعة جدّاً بفضل ذلك الرّجل

381
00:21:26,540 --> 00:21:28,680
أريد أن أشكره فحسب

382
00:21:29,590 --> 00:21:32,380
الوقت يمضي بسرعة، أليس كذلك؟

383
00:21:32,380 --> 00:21:33,900
بالفعل

384
00:21:34,160 --> 00:21:36,710
أصبح هذا المكان مُوحشاً حقّاً

385
00:21:37,110 --> 00:21:39,780
،تقول آيكو بأنّني أستطيع العيش هنا للأبد

386
00:21:39,780 --> 00:21:43,070
لكن رسميّاً، يُفترَض أن أكون ميّتاً

387
00:21:43,220 --> 00:21:45,530
أعتقد يجدر بي أن أجد مكاني التّالي

388
00:21:45,820 --> 00:21:47,840
أين تريدين أن تعيشي تالياً؟

389
00:21:47,840 --> 00:21:49,430
سآخذكِ إلى أيّ مكان تُريدين

390
00:21:49,430 --> 00:21:51,690
ليس بعد يا فو-تشان

391
00:21:51,690 --> 00:21:53,460
بالطّبع. آسف

392
00:21:53,660 --> 00:21:57,420
تعلم بأنّني ظريفة ومُفعمة بالحياة

393
00:21:57,420 --> 00:22:01,520
سأذهب إلى أيّ مكان ما دمتُ
أستطيع البقاء هكذا

394
00:22:01,520 --> 00:22:03,590
أنتِ ماتشي مهما تغيّرتِ

395
00:22:03,590 --> 00:22:07,130
معك حقّ. شكراً لك يا فو-تشان

396
00:22:08,200 --> 00:22:10,470
كيف كانت الحياة هنا؟

397
00:22:10,470 --> 00:22:12,590
هل تمكّنتِ من تحقيق حلمكِ؟

398
00:22:13,810 --> 00:22:16,980
كان حلمي هو أن أصبح أُمّاً، أليس كذلك؟

399
00:22:17,900 --> 00:22:19,590
لم يُحبّكِ أحد، صحيح؟

400
00:22:23,070 --> 00:22:26,200
!أنت فظيع يا فو-تشان! كيف تجرؤ؟

401
00:22:25,220 --> 00:22:26,200
!آ-آسف

402
00:22:26,200 --> 00:22:27,880
!كنتُ مغناطيساً حقيقيّاً للرّجال

403
00:22:27,880 --> 00:22:31,000
!لم يُوافِقوا معاييري فحسب

404
00:22:30,570 --> 00:22:32,170
معكِ حقّ، بالطّبع

405
00:22:32,920 --> 00:22:36,210
لكن أحبّكِ لعدم نسيانكِ الحلم يا ماتشي

406
00:22:37,470 --> 00:22:41,750
لا تتأمّل منّي أن أُسامحك فقط
!لأنّك قلت ذلك

407
00:22:40,750 --> 00:22:42,510
!مُؤلم

408
00:22:42,510 --> 00:22:43,260
!أنتما

409
00:22:44,320 --> 00:22:46,570
هيّا. حان وقت الذّهاب

410
00:22:47,460 --> 00:22:49,720
حسناً. هل نفعل؟