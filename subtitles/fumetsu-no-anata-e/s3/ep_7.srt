1
00:00:01,220 --> 00:00:03,010
ما هو الإنسان؟

2
00:00:03,360 --> 00:00:04,960
ما هو الحُبّ؟

3
00:00:05,130 --> 00:00:07,220
يعاني فوشي بحثاً عن إجابة

4
00:00:07,600 --> 00:00:10,870
أريدكِ أن تُعلّميني المزيد عن الحُبّ

5
00:00:15,830 --> 00:00:17,400
بكلّ سرور

6
00:00:17,900 --> 00:00:21,080
ها قد فعلتَها

7
00:00:21,360 --> 00:00:25,830
الفتاة ميموري قد سُرِق جسدها
بواسطة القارعين

8
00:00:26,910 --> 00:00:29,660
لقد خسرنا بالفعل

9
00:02:00,010 --> 00:02:04,010
الهجوم

10
00:02:11,040 --> 00:02:13,190
ماذا حدث للتو؟

11
00:02:14,190 --> 00:02:16,740
،حميتُ ميموري من مُتلصّص

12
00:02:16,910 --> 00:02:20,700
...ثمّ كادت تدهسني سيّارة

13
00:02:21,490 --> 00:02:22,760
!ميموري

14
00:02:24,670 --> 00:02:27,860
هذا مُطمئن! إنّها بخير

15
00:02:29,080 --> 00:02:30,750
،على ذكر الأمر

16
00:02:30,920 --> 00:02:36,160
حدث شيء ما بالفعل بينما
ريثما وصلتْ ميموري إلى هنا

17
00:02:36,680 --> 00:02:40,480
...قبل عام، عندما كنتُ لا أزال بطلاً

18
00:02:40,650 --> 00:02:42,030
!شفاء

19
00:02:42,670 --> 00:02:46,610
!أيّها الغبيّ، أخبرتُك! مُبتدئ لعين

20
00:02:46,780 --> 00:02:50,320
مرحباً! شركة فرقة النّظافة
!النّاصعة قد جاءت

21
00:02:50,490 --> 00:02:51,490
ماذا؟

22
00:02:51,660 --> 00:02:54,320
!أتينا لجمع قمامتك

23
00:02:54,580 --> 00:02:55,680
!من أنتما؟

24
00:02:55,850 --> 00:02:57,830
!لا أسمح لكما بالدّخول

25
00:02:58,590 --> 00:03:01,300
!أتنويان التخلّص من كتُبي الأدبيّة؟

26
00:03:01,660 --> 00:03:03,040
!إلّا هذا

27
00:03:04,570 --> 00:03:06,010
!توقّفي

28
00:03:06,180 --> 00:03:08,160
!هذه تنتمي لأختي

29
00:03:08,570 --> 00:03:13,510
أفعالكما الشّيطانيّة هي انتهاك
!لحياتي الّتي دامت ثلاثين سنة

30
00:03:13,680 --> 00:03:15,360
تخلّص منها جميعها وابدأ حياة جديدة

31
00:03:15,530 --> 00:03:18,120
إن رفضت، فسأعمل على جمعك كذلك

32
00:03:18,410 --> 00:03:20,750
!اللّعنة يا أبي

33
00:03:21,100 --> 00:03:22,650
!ارحل أيّها الشّرّ
!أرحل أيّها الشّرّ

34
00:03:22,820 --> 00:03:25,570
تخلّص من كافّة موادك الفاحشة مع حلول الغد

35
00:03:25,740 --> 00:03:27,880
ثمّة شخص أريدك أن تلتقيه

36
00:03:30,870 --> 00:03:34,410
هذه زوجتي الجديدة، ميابي-سان

37
00:03:34,580 --> 00:03:36,080
!لا، ليست هي

38
00:03:36,250 --> 00:03:38,430
سُررتُ بلقائك يا هيروتوشي-كن

39
00:03:38,600 --> 00:03:40,390
عمري اثنا وثلاثون

40
00:03:40,560 --> 00:03:42,400
أكبر منك بعامين

41
00:03:42,570 --> 00:03:43,570
حسناً

42
00:03:44,010 --> 00:03:46,400
هيّا يا ميموري، ألقي السّلام

43
00:03:47,650 --> 00:03:51,050
سأكون... تحت رعايتك

44
00:03:51,220 --> 00:03:53,920
آسفة. إنّها خجولة جدّاً

45
00:03:54,090 --> 00:03:59,490
أحببتُ هذه الفتاة أكثر
من أيّ لعبة أو مانغا

46
00:03:59,970 --> 00:04:02,160
كما لو أنّها كانت حُبّي الأوّل

47
00:04:06,930 --> 00:04:09,430
سأفديها بحياتي

48
00:04:09,600 --> 00:04:13,140
...حلمي بالحصول على أخت طفلة

49
00:04:13,540 --> 00:04:17,220
لا أصدِّق أنّ أبي البائس
!قد حقّقَ لي أُمنيتي

50
00:04:17,540 --> 00:04:18,620
!أوني-تشان

51
00:04:18,790 --> 00:04:19,880
!أوني

52
00:04:20,050 --> 00:04:21,080
!أوني-ساما

53
00:04:22,100 --> 00:04:23,280
!أخي

54
00:04:25,190 --> 00:04:28,580
!ماذا سأدعها تُناديني؟

55
00:04:30,760 --> 00:04:33,220
...هيرتوتوشي-سان

56
00:04:33,730 --> 00:04:35,560
سنتناول العشاء

57
00:04:35,730 --> 00:04:36,830
هلّا نزلت للطّابق السّفليّ؟

58
00:04:38,220 --> 00:04:39,840
!إنّها تُناديني باسمي

59
00:04:40,320 --> 00:04:42,890
كُلي فليفلتك الخضراء يا ميموري

60
00:04:44,080 --> 00:04:45,080
حسناً

61
00:04:46,620 --> 00:04:50,410
ماذا تعمل يا هيروتوشي-كن؟

62
00:04:50,580 --> 00:04:52,220
...في الواقع

63
00:04:52,390 --> 00:04:53,460
أنا عاطل عن العمل

64
00:04:53,630 --> 00:04:54,640
لا، لا

65
00:04:54,810 --> 00:04:55,880
لعبة

66
00:04:56,050 --> 00:04:57,340
ألعب ضدّ مُحترفين وما شابه

67
00:04:57,510 --> 00:04:59,890
!مُبهر، أنت مُهندس ألعاب فيديو مُحترف

68
00:05:00,060 --> 00:05:03,230
ألا تعتقد بأنّ الوقت قد حان
لمُغادرة الوكر يا هيروتوشي؟

69
00:05:03,400 --> 00:05:05,960
فأنت تجني مالاً جيّداً في عملك
في ألعاب الفيديو، صحيح؟

70
00:05:06,130 --> 00:05:07,520
لا تقل ذلك يا نون-تشان

71
00:05:07,690 --> 00:05:09,320
لا نريد أن نضغط عليه

72
00:05:09,860 --> 00:05:12,320
أقصد، نحتاج شخصاً للعناية بميموري

73
00:05:12,490 --> 00:05:15,320
سنحظى بوقت أطول لوحدنا
بوجوده في المنزل

74
00:05:15,490 --> 00:05:16,740
مـ-معكِ حقّ

75
00:05:18,610 --> 00:05:23,090
في البداية، راقبتُها عن بُعد فقط

76
00:05:25,520 --> 00:05:26,710
وداعاً

77
00:05:27,200 --> 00:05:28,400
!إلى اللّقاء

78
00:05:28,570 --> 00:05:30,840
راقبتُها تُغادر إلى المدرسة صباحاً

79
00:05:31,500 --> 00:05:32,530
!أهلاً بعودتكِ

80
00:05:32,700 --> 00:05:34,690
راقبتُها تعود إلى المنزل بعد الظّهر

81
00:05:35,570 --> 00:05:38,390
...بعد أيّام عديدة من مُلاحقتها، أدركت

82
00:05:39,080 --> 00:05:42,680
أنّ ميموري-تشان لا تبتسم أبداً

83
00:05:54,240 --> 00:05:56,870
!ميموري

84
00:05:57,620 --> 00:06:00,060
هل أنتِ بخير؟! هل تأذّيتِ؟

85
00:06:00,580 --> 00:06:02,710
أنا... بخير

86
00:06:03,250 --> 00:06:04,830
!هذا مُطمئن

87
00:06:05,310 --> 00:06:07,420
أربطة حذائكِ مفكوكة

88
00:06:07,590 --> 00:06:09,340
لا بُدّ أنّكِ تعثّرتِ بها، صحيح؟

89
00:06:09,600 --> 00:06:11,840
...دعيني أربطها لكِ

90
00:06:12,590 --> 00:06:14,700
...واحد، اثنان

91
00:06:18,130 --> 00:06:19,440
!انتهيت

92
00:06:20,000 --> 00:06:21,600
!بئساً، أنا سيّئ

93
00:06:21,770 --> 00:06:23,090
ربطتُها بشكل عموديّ

94
00:06:23,860 --> 00:06:28,360
شكراً... لك... يا هيروتوشي-سان

95
00:06:28,690 --> 00:06:33,170
ميموري! يمكنكِ مُناداتي
بـ ني-تشان فقط

96
00:06:33,340 --> 00:06:34,830
ليس وكأنّني أُجبركِ

97
00:06:38,660 --> 00:06:40,570
حسناً يا ميموري-تشان؟

98
00:06:40,740 --> 00:06:43,040
هل تُواجهين صعوبة في الاعتياد
على حياتكِ الجديدة؟

99
00:06:43,620 --> 00:06:45,590
لا مُشكلة

100
00:06:46,850 --> 00:06:49,660
ماذا تفعل الفتيات في هذه
الأيّام للاستمتاع؟

101
00:06:51,870 --> 00:06:52,950
!وجدتُها

102
00:06:53,120 --> 00:06:55,210
!سأُعلّمكِ مهارة مُذهلة

103
00:07:09,020 --> 00:07:10,040
!مُفاجأة

104
00:07:10,210 --> 00:07:12,900
!كُرة طينيّة لامعة

105
00:07:14,880 --> 00:07:15,940
أحم

106
00:07:16,110 --> 00:07:18,560
:فلتشهدي مهارتي السّرّية
إمساك-نو-جوتسو لفت الانتباه

107
00:07:18,730 --> 00:07:22,820
،اصنعي واحدة من هذه أمام أصدقائكِ
!وستحظين باحترامهم

108
00:07:23,330 --> 00:07:27,870
ليس لديّ أصدقاء لأُريهم إيّاها

109
00:07:29,710 --> 00:07:31,800
!مستحيل

110
00:07:32,040 --> 00:07:35,320
لـ-لديّ أب جديد

111
00:07:35,490 --> 00:07:38,560
ومدرسة جديدة

112
00:07:38,730 --> 00:07:45,730
زيّي الرّسميّ وملابسي الرّياضيّة
مُختلفة عن ملابس الجميع

113
00:07:46,130 --> 00:07:51,230
أنا الوحيدة الّتي ترتدي
الملابس الخطأ دوماً

114
00:07:55,190 --> 00:07:56,200
فهمت

115
00:07:56,370 --> 00:07:57,370
حسناً

116
00:07:58,860 --> 00:08:02,030
!من الآن فصاعداً، سأجعلكِ تلميذتي

117
00:08:03,030 --> 00:08:04,980
!ناديني بالمُعلّم

118
00:08:05,150 --> 00:08:06,150
—مُعـ

119
00:08:07,720 --> 00:08:09,780
تنجح إمساك-نو-جوتسو لفت
!الانتباه على الجميع

120
00:08:09,950 --> 00:08:11,990
،أتقني فنّ صنع كُرات الطّين

121
00:08:12,160 --> 00:08:15,680
،وستصبحين ملكة أكاديميّتكِ
!أقصد مدرستكِ

122
00:08:17,670 --> 00:08:19,770
حاضرة... يا مُعلّم

123
00:08:20,650 --> 00:08:24,430
لم يسعني سوى مُلاحظة
ما بدا أنّه ابتسامة

124
00:08:24,990 --> 00:08:26,910
شعرتُ بنشوة

125
00:08:28,370 --> 00:08:32,570
!سنقضي شهر عسلنا في الأسبوع المُقبل

126
00:08:32,740 --> 00:08:34,240
هل يمكنك تولّي زمام الأمور؟

127
00:08:34,410 --> 00:08:36,490
هذا جديد بالنّسبة لي

128
00:08:36,660 --> 00:08:39,940
هل يمكنني أن أطلب منك ومن ميموري
تولّي الأعمال المنزليّة؟

129
00:08:40,110 --> 00:08:43,830
ماذا؟ نحن الاثنان فقط؟

130
00:08:44,150 --> 00:08:48,960
أعلم بأنّك مهووس بالفتيات الصّغيرات، لكن
أثق بأنّ لديك حسّ أخلاقيّ نزيه

131
00:08:49,130 --> 00:08:51,350
إيّاك أن تمسّ فتاة تصغرك بعشرين عاماً

132
00:08:51,520 --> 00:08:54,620
لِمَ لا تأخذها معك إن
كنتَ قلقاً إلى هذا الحدّ؟

133
00:08:54,790 --> 00:08:57,130
فضلاً عن ذلك، الفارق
!بينكما عشرون عاماً أيضاً

134
00:08:57,300 --> 00:08:58,830
إيّاك وهذه الأفكار الغريبة

135
00:08:59,000 --> 00:09:02,270
انتهت حياتنا البسيطة بشكل مُفاجئ

136
00:09:02,780 --> 00:09:04,980
كلّ ذلك بدأ في ذلك اليوم

137
00:09:07,900 --> 00:09:09,640
!الطّلب جاهز

138
00:09:12,920 --> 00:09:14,550
ما رأيكِ؟ لذيذ، أليس كذلك؟

139
00:09:14,720 --> 00:09:17,340
أعدّ أرزّاً مقليّاً طوال الوقت

140
00:09:18,120 --> 00:09:20,620
إنّه لذيذ يا سيّدي

141
00:09:21,120 --> 00:09:23,100
سأُعلّمكِ كيفيّة إعداده إن أردتِ

142
00:09:23,270 --> 00:09:26,390
ونحن أخوان الآن، لذا لا داعي
لتكوني مُهذّبة معي

143
00:09:26,560 --> 00:09:28,890
،ليس وكأنّني أُجبركِ على ذلك
لكن هكذا تسير الأمور، صحيح؟

144
00:09:29,060 --> 00:09:31,680
،ليس وكأنّني أعلم أيضاً
...باعتباري ابن وحيد بحدِّ ذاتي

145
00:09:33,630 --> 00:09:35,040
سأغادر

146
00:09:35,210 --> 00:09:36,880
صحيح، المدرسة

147
00:09:39,240 --> 00:09:42,550
مهلاً. أربطة حذائكِ مفكوكة

148
00:09:42,720 --> 00:09:44,420
ستتعثّرين ثانية

149
00:09:47,300 --> 00:09:49,640
أتساءل ما إن كانت لا تستطيع
فكّ أربطتها بنفسها

150
00:09:50,540 --> 00:09:52,600
كلّ شيء على ما يُرام
يا سموّ الأميرة ميموري

151
00:09:52,770 --> 00:09:54,930
سأربطها لأجلكِ

152
00:09:55,230 --> 00:09:57,940
شكراً جزيلاً لك

153
00:09:58,110 --> 00:09:59,450
لا عليكِ

154
00:09:59,840 --> 00:10:01,160
!انتهيت

155
00:10:01,330 --> 00:10:02,920
الرّبطة الفراشيّة العموديّة الرّديئة خاصّتي

156
00:10:06,450 --> 00:10:09,380
أتساءل ما إن كانت قد بدأت
تنسجم معي قليلاً

157
00:10:09,930 --> 00:10:11,090
!وجدتُها

158
00:10:12,580 --> 00:10:14,040
انظري إلى ما اشتريت

159
00:10:14,400 --> 00:10:15,950
الثّمن 798 ين

160
00:10:16,120 --> 00:10:18,260
والآن لن تقلق بشأن التعثُّر

161
00:10:18,580 --> 00:10:22,210
ربّما سأُخبئه كمُفاجأة صغيرة

162
00:10:25,850 --> 00:10:27,680
...إشعار بيوم أولياء الأمور

163
00:10:28,030 --> 00:10:29,390
!إنّه اليوم

164
00:10:29,560 --> 00:10:31,620
!رحلتْ أمُّها في شهر عسلها

165
00:10:31,790 --> 00:10:33,450
هل كانت ميموري تُخفيها عنها؟

166
00:10:33,620 --> 00:10:35,830
أم أنّ تلك العجوز قد نسيت؟

167
00:10:36,000 --> 00:10:37,760
!ماذا يُفترض بي أن أفعل؟

168
00:10:37,930 --> 00:10:39,750
ألا ينبغي أن أفعل شيئاً؟

169
00:10:40,190 --> 00:10:41,620
...أوني-تشان

170
00:10:42,180 --> 00:10:44,150
!قلبي يُؤلمني

171
00:10:44,320 --> 00:10:45,920
!إنّها أختي الطّفلة

172
00:10:46,090 --> 00:10:48,030
!لن أتخلّى عنها

173
00:10:48,200 --> 00:10:49,510
!ثلاثون دقيقة ريثما يبدأ الدّرس

174
00:10:49,680 --> 00:10:50,920
!استعجل يا هيروتوشي

175
00:10:51,090 --> 00:10:53,460
!أسرع من سِهام لاعب رفيع الرّتبة

176
00:10:54,280 --> 00:10:56,300
!ميموري

177
00:10:56,590 --> 00:11:00,260
،قد لا تكون أمّكِ وأبوكِ هنا
!لكن ما زال لديكِ أنا

178
00:11:02,410 --> 00:11:03,620
...لأنرَ

179
00:11:03,790 --> 00:11:06,740
...صفّ ميموري

180
00:11:08,100 --> 00:11:10,680
...بدلة العمل الخاصّة بأبي

181
00:11:10,850 --> 00:11:13,330
إنّها ضيِّقة جدّاً

182
00:11:13,720 --> 00:11:17,270
كان عليّ الترقِّي لمُستوى أعلى
قبل التسلُّح بدرع شحيح كهذا

183
00:11:21,310 --> 00:11:24,660
المعذرة. سوف أدخل

184
00:11:28,330 --> 00:11:31,590
سينسي، ميموري-سان ليست هنا

185
00:11:32,240 --> 00:11:34,870
هذا غريب. كنتُ متأكّدة بأنّها
سُجِّلَتْ مع الحضور

186
00:11:35,040 --> 00:11:36,790
أتساءل ما إن ذهبتْ إلى مكان ما

187
00:11:36,960 --> 00:11:38,390
هل يعرف أحدكم؟

188
00:11:38,560 --> 00:11:42,080
المعذرة، أنا... و-والد ميموري

189
00:11:42,250 --> 00:11:45,300
سأذهب للبحث عنها. يمكنكم البدء

190
00:11:47,150 --> 00:11:48,690
ميموري؟

191
00:11:48,860 --> 00:11:51,090
ميموري-تشان؟

192
00:11:52,110 --> 00:11:54,030
هل آلمتكِ معدتكِ؟

193
00:11:54,200 --> 00:11:56,570
هل أسرفتِ في أكل أرزّي المقليّ؟

194
00:11:58,820 --> 00:12:00,770
لا يبدو أنّها هنا

195
00:12:00,940 --> 00:12:02,040
إنّها ليست هنا؟

196
00:12:02,210 --> 00:12:03,990
حسناً، شكراً لكِ

197
00:12:06,200 --> 00:12:07,870
ماذا حدث لها؟

198
00:12:10,240 --> 00:12:14,710
ليس لديّ أصدقاء لأُريهم إيّاها

199
00:12:14,880 --> 00:12:18,230
أنا آسفة. إنّها خجولة جدّاً

200
00:12:23,230 --> 00:12:28,710
ميموري، لا عيب في الهرب
من ساحة المعركة

201
00:12:28,880 --> 00:12:31,460
أحياناً لا يتحقّق النّصر
إلّا في انسحاب تكتيكيّ

202
00:12:31,630 --> 00:12:34,210
لنذهب إلى المنزل إن لم
يُعجبكِ المكان هنا

203
00:12:34,380 --> 00:12:36,110
اخرجي من فضلكِ

204
00:12:36,460 --> 00:12:37,840
ميموري

205
00:12:50,910 --> 00:12:51,910
!ميموري

206
00:13:18,250 --> 00:13:19,530
...ميموري

207
00:13:19,980 --> 00:13:21,110
!أوني-تشان

208
00:13:21,280 --> 00:13:22,900
!مستحيل! أتيتِ

209
00:13:23,990 --> 00:13:25,250
ميموري؟

210
00:13:25,900 --> 00:13:27,430
...أنتِ فقط

211
00:13:27,600 --> 00:13:28,960
!أنا بخير

212
00:13:29,420 --> 00:13:30,940
تعثّرتُ فحسب

213
00:13:35,030 --> 00:13:36,890
!دماء! دماء

214
00:13:38,320 --> 00:13:40,430
...سأربط أربطة حذائكِ

215
00:13:43,320 --> 00:13:45,030
ما الأمر

216
00:13:45,860 --> 00:13:47,500
يا أوني-تشان؟

217
00:13:47,960 --> 00:13:51,430
ومنذ ذلك اليوم، تغيّرتْ ميموري

218
00:13:52,880 --> 00:13:54,670
أصبحت تتكلّم بحيويّة

219
00:13:56,260 --> 00:13:57,810
أكلَتْ جيّداً

220
00:13:57,980 --> 00:13:59,050
!هذا شهيّ يا أوني-تشان

221
00:13:59,220 --> 00:14:02,160
وبدأتْ تُناديني بـ أوني-تشان

222
00:14:02,330 --> 00:14:03,700
إلى اللّقاء

223
00:14:08,480 --> 00:14:10,610
!عدتُ يا أوني-تشان

224
00:14:10,950 --> 00:14:13,060
أ-أهلاً بعودتكِ

225
00:14:13,230 --> 00:14:15,670
كنتُ ألعب مع أصدقائي في المدرسة

226
00:14:16,080 --> 00:14:19,840
بدتْ تستمتع بالحياة أكثر

227
00:14:20,510 --> 00:14:23,880
هل هي ميموري حقّاً؟

228
00:14:24,050 --> 00:14:25,650
!عدنا يا ميموري

229
00:14:25,820 --> 00:14:27,080
هل انسجمتُما معاً؟

230
00:14:27,250 --> 00:14:28,340
!أجل

231
00:14:28,510 --> 00:14:30,530
!اشترى لي أوني-تشان ملابسَ جديدة

232
00:14:30,700 --> 00:14:31,850
!هذا رائع

233
00:14:32,020 --> 00:14:35,470
!لم تلحظ تغيُّر ابنتها؟

234
00:14:36,260 --> 00:14:41,390
أردتُ تفسيراً لكلّ تغيُّرات ميموري

235
00:14:41,870 --> 00:14:44,690
لأجل ميموري الّتي أحببتُها

236
00:14:45,380 --> 00:14:50,960
،لكن حتّى بعد عام من مُراقبتها
لم أحصل على إجابات

237
00:14:52,030 --> 00:14:56,380
وفي الأمس، فقدتُ أثرها
بينما كنتُ أشتري شراباً

238
00:14:56,550 --> 00:14:58,930
بحثتُ باستماتة

239
00:14:59,610 --> 00:15:03,910
هناك، رأيتُها تُطعَن بواسطة شخص

240
00:15:05,410 --> 00:15:06,780
،مهما تغيّرت

241
00:15:06,950 --> 00:15:09,420
كانت لا تزال الأخت الصّغرى
الّتي أُحبّها حُبّاً جمّاً

242
00:15:09,590 --> 00:15:12,370
حملتُها وهربت

243
00:15:13,260 --> 00:15:14,310
...ثمّ

244
00:15:15,660 --> 00:15:17,470
ظننتُ نفسي ميّتاً

245
00:15:18,630 --> 00:15:20,300
كلّ هذا حلم

246
00:15:21,360 --> 00:15:24,000
أيقظَني صوتٌ غريب

247
00:15:24,170 --> 00:15:25,930
وفي غرفتي فوق ذلك

248
00:15:26,100 --> 00:15:27,940
ماذا أصابني؟

249
00:15:28,610 --> 00:15:29,840
!ميموري

250
00:15:33,640 --> 00:15:34,940
!جرحكِ

251
00:15:35,540 --> 00:15:39,000
صباح الخير يا أوني-تشان

252
00:15:43,490 --> 00:15:46,840
هل أنتِ ميموري حقّاً؟

253
00:15:47,810 --> 00:15:51,110
،سقطتِ من بناء المدرسة قبل عام
والآن، طُعِنتِ

254
00:15:51,280 --> 00:15:52,340
...مع ذلك

255
00:15:52,510 --> 00:15:53,510
!مع ذلك

256
00:15:54,020 --> 00:15:56,090
هل أصابَكِ شيء؟

257
00:15:57,810 --> 00:16:00,460
بالتّأكيد، أصابَني شيء

258
00:16:00,980 --> 00:16:02,690
وماذا في ذلك؟

259
00:16:02,860 --> 00:16:04,530
هل ستقتلني؟

260
00:16:05,650 --> 00:16:07,010
!مُفاجأة

261
00:16:07,180 --> 00:16:10,070
!أنا أختك الصّغرى الحبيبة، ميموري

262
00:16:10,490 --> 00:16:13,060
!أمّي، اشتري لي ملابسَ جديدة

263
00:16:13,820 --> 00:16:16,180
مهلاً! ما هذا الشّيء الشّبيه بالدّم؟

264
00:16:16,350 --> 00:16:18,770
كنتُ ألعب لعب القاتل مع أصدقائي

265
00:16:18,940 --> 00:16:20,670
هذا سيّئ

266
00:16:20,840 --> 00:16:23,050
لا أملك كثيراً من المال

267
00:16:23,900 --> 00:16:25,450
بكلّ تأكيد يا ميموري-تشان

268
00:16:25,620 --> 00:16:28,030
سيشتري أبوكِ لكِ بعض
الملابس الجديدة

269
00:16:28,230 --> 00:16:30,380
سأُعيد ميموري

270
00:16:31,280 --> 00:16:33,420
ميموري الحقيقيّة

271
00:16:34,880 --> 00:16:36,060
راقبيني

272
00:16:42,510 --> 00:16:46,080
يمكنني تعليمك الحُبّ

273
00:16:51,290 --> 00:16:52,290
...فوشي

274
00:16:54,060 --> 00:16:56,520
أنا أُحبّك

275
00:16:57,880 --> 00:17:04,780
أستطيع... تعليمك... الحُبّ

276
00:17:08,240 --> 00:17:10,910
...سليلة المرأة الّتي قتلتك

277
00:17:11,930 --> 00:17:14,700
إنّها قادمة إليّ، باسمة

278
00:17:16,830 --> 00:17:17,910
...بارونا

279
00:17:18,400 --> 00:17:20,480
ما سيكون رأيكِ؟

280
00:17:22,150 --> 00:17:27,050
أريد فقط أن أبقى صديقاً
لميزوها من دون مُفاجآت

281
00:17:27,760 --> 00:17:29,080
أختي؟

282
00:17:30,540 --> 00:17:33,090
لـ-لا ينبغي أن تكوني هنا يا ماتشي

283
00:17:33,260 --> 00:17:34,740
يُفترض أن تكوني نائمة

284
00:17:35,080 --> 00:17:36,520
سيغدو الجوّ بارداً اللّيلة

285
00:17:36,690 --> 00:17:37,940
...]نبغي لكِ

286
00:17:51,390 --> 00:17:52,680
...أختي

287
00:17:53,910 --> 00:17:57,340
أختي

288
00:17:59,550 --> 00:18:00,650
...بارونا

289
00:18:01,250 --> 00:18:03,250
أتمنّى لو كنتِ هنا

290
00:18:10,320 --> 00:18:12,280
أنا آسفة يا فو-تشان

291
00:18:12,830 --> 00:18:15,590
يجب أن تكون الأُمّ قويّة

292
00:18:15,760 --> 00:18:19,500
أنا من يجب أن يكون قويّاً يا ماتشي

293
00:18:20,450 --> 00:18:24,090
سنعيش في هذا العالم ونموت فيه

294
00:18:25,130 --> 00:18:27,280
لن أدع أحداً يُقتَل

295
00:18:27,450 --> 00:18:29,350
سوف أحمي الجميع

296
00:18:29,520 --> 00:18:32,320
سأحرص على أن يجدوا السّعادة

297
00:18:34,910 --> 00:18:40,010
كلّ ما يمكنني فعله الآن هو
تعلّم كيفيّة مُقاتلة القارعين

298
00:18:40,350 --> 00:18:44,150
يجب أن أذهب مع يوكي بعد
دوام المدرسة بحثاً عن ميموري

299
00:18:44,600 --> 00:18:45,660
ماذا الآن؟

300
00:18:45,830 --> 00:18:47,800
!لم تُدوّن اسمك حتّى

301
00:18:47,970 --> 00:18:49,850
أجِب عن هذه المسائل! فهمت؟

302
00:18:50,020 --> 00:18:51,640
!ستحصل على علامة الصّفر إن لم تفعل

303
00:18:59,010 --> 00:19:00,530
مسائل؟

304
00:19:00,700 --> 00:19:03,560
القارعون هم المسألة الّتي
!عليّ حلّها الآن

305
00:19:04,750 --> 00:19:05,900
...ميموري

306
00:19:06,070 --> 00:19:07,270
أين أنتِ؟

307
00:19:09,310 --> 00:19:12,070
ربّما ينبغي أن أتقفّى
أثرها من تلك الحديقة

308
00:19:14,360 --> 00:19:15,810
هل هي تقترب؟

309
00:19:15,980 --> 00:19:17,050
من هنا؟

310
00:19:19,680 --> 00:19:21,010
!أنت هنا

311
00:19:21,420 --> 00:19:23,810
افتقدتني، أليس كذلك؟

312
00:19:30,170 --> 00:19:31,560
!مرحى

313
00:19:31,730 --> 00:19:35,090
هل هذا يعني بأنّني أحرزتُ نقطة؟

314
00:19:37,310 --> 00:19:38,350
!بئساً

315
00:19:38,520 --> 00:19:39,800
!تعالي إليّ

316
00:19:39,970 --> 00:19:41,420
سألعب معكِ

317
00:19:44,960 --> 00:19:46,140
ما الأمر؟

318
00:19:46,310 --> 00:19:47,770
تعالي إلى هنا

319
00:19:58,840 --> 00:20:00,460
...الآن

320
00:20:01,000 --> 00:20:02,550
!حان دوري

321
00:20:06,590 --> 00:20:09,140
أنا متفاجئ من قدرتك على حمل
!شيء ثقيل كهذا

322
00:20:09,310 --> 00:20:12,450
صحيح، القارعون أقوياء جدّاً

323
00:20:12,620 --> 00:20:14,090
ماذا يُدعى هذا السّلاح؟

324
00:20:14,260 --> 00:20:15,660
لم أره من قبل

325
00:20:17,770 --> 00:20:19,660
أتساءل ما إن كان يستطيع
قطع الفولاذ وما شابه

326
00:20:26,840 --> 00:20:28,430
!ما-ما هذا يا فوشي؟

327
00:20:28,600 --> 00:20:29,740
!جريمة قتل؟

328
00:20:31,120 --> 00:20:32,470
!هذا مؤلم

329
00:20:32,640 --> 00:20:33,640
!يا للهول

330
00:20:33,810 --> 00:20:35,420
!لنذهب إلى عيادة المُمرّضة
هل يمكنكِ النّهوض؟

331
00:20:35,590 --> 00:20:37,790
!توقّف! هذا قارع

332
00:20:39,760 --> 00:20:40,810
ماذا؟

333
00:20:41,440 --> 00:20:42,460
!يوكي

334
00:20:45,810 --> 00:20:47,590
!فوشي! أهذه هي ماهيّة تلك الفتاة؟

335
00:20:47,760 --> 00:20:49,200
أجل، ميموري هي كذلك

336
00:20:49,370 --> 00:20:51,600
لماذا تقاتل؟ ليس هذا
!ما اتّفقنا عليه

337
00:20:51,770 --> 00:20:53,700
هاجمَني أوّلاً

338
00:20:53,870 --> 00:20:56,240
!آمن بقوّة الحُبّ يا فوشي

339
00:20:56,700 --> 00:20:59,040
!مرحباً! سُررتُ بلقائكِ

340
00:20:59,210 --> 00:21:01,080
هل أنت قارع جيّد؟

341
00:21:01,250 --> 00:21:03,520
أنا سنة أولى في إعداديّة ميناموتو

342
00:21:03,690 --> 00:21:07,640
أوكي يوكي، نائب رئيس
!نادي الغوامض

343
00:21:07,810 --> 00:21:11,620
لا نريد قتالك

344
00:21:15,040 --> 00:21:17,240
!لا يهمّ! فوشي، حطّمه

345
00:21:17,580 --> 00:21:18,670
حسناً

346
00:21:18,840 --> 00:21:20,580
أنا أقوى منه

347
00:21:27,590 --> 00:21:29,470
!أخرجني

348
00:21:29,640 --> 00:21:31,970
!أخرجني أيّها الحقير

349
00:21:32,310 --> 00:21:34,150
فقط إن أجبت عن سؤالي

350
00:21:34,320 --> 00:21:35,750
ما هدفك؟

351
00:21:35,920 --> 00:21:37,900
!سلام العالم بالطّبع

352
00:21:38,180 --> 00:21:39,190
سلام؟

353
00:21:39,360 --> 00:21:40,610
معك حقّ. إنّه مُعرّض للخطر

354
00:21:40,780 --> 00:21:42,260
بسببك

355
00:21:42,430 --> 00:21:44,330
أنت لا تُهاجم لأجل المتعة، أليس كذلك؟

356
00:21:44,500 --> 00:21:45,690
تريد شيئاً منّي

357
00:21:45,860 --> 00:21:48,990
!كنت أنت من تنمّر عليّ أوّلاً

358
00:21:49,160 --> 00:21:51,660
!شوّهتني بهذا السّيف

359
00:21:51,830 --> 00:21:53,920
سخيف. أهذا فقط؟

360
00:21:54,090 --> 00:21:55,100
أيّاً يكن

361
00:21:55,270 --> 00:21:57,610
سأُعيد هذا الجسد لمالكه. اخرج

362
00:21:57,780 --> 00:22:00,550
لِمَ عليّ المُغادرة أيُّها الأحمق؟

363
00:22:01,390 --> 00:22:04,090
هل أجرّب سُمّاً عليك؟

364
00:22:04,260 --> 00:22:06,970
!لا! لا أُحبّ الألم

365
00:22:09,660 --> 00:22:11,370
هل يمكنني العودة إلى المنزل؟

366
00:22:11,540 --> 00:22:14,200
،يجب أن أعود مع حلول وقت العشاء
وإلّا ستغضب أمّي

367
00:22:14,370 --> 00:22:15,520
هل تعتقد بأنّني ألعب؟

368
00:22:15,690 --> 00:22:17,390
!لن أدعك تذهب حتّى تُجيبني

369
00:22:17,740 --> 00:22:20,170
!إنّه لا يتنفّس

370
00:22:20,340 --> 00:22:22,060
كان قد أُغمي عليه عندما لاحظت

371
00:22:22,230 --> 00:22:24,150
!تماسك يا فوشي-كن

372
00:22:24,320 --> 00:22:25,550
!لا تستسلم

373
00:22:25,720 --> 00:22:27,000
يجب أن أعود

374
00:22:27,170 --> 00:22:28,530
!مرحى! أنا حُرّة

375
00:22:30,400 --> 00:22:32,140
هل يمكنني العودة؟

376
00:22:32,310 --> 00:22:33,580
!أُحبّ الاستمتاع

377
00:22:33,750 --> 00:22:35,650
!سيُقدّر ذلك الشّخص هذا أيضاً

378
00:22:35,820 --> 00:22:36,820
ذلك الشّخص"؟"

379
00:22:37,470 --> 00:22:38,990
!سآخذ هذا

380
00:22:39,160 --> 00:22:40,160
!تبّاً

381
00:22:44,490 --> 00:22:45,530
!فوشي-كن

382
00:22:45,700 --> 00:22:46,880
!هذا مُطمئن

383
00:22:47,050 --> 00:22:49,620
!عدتَ إلى الحياة

384
00:22:50,800 --> 00:22:53,220
سنعود إلى المنزل يا أوني-تشان

385
00:22:57,130 --> 00:22:58,590
...ميموري

386
00:24:30,860 --> 00:24:33,640
القارعون يتطفّلون على البشر

387
00:24:34,110 --> 00:24:37,690
لا حلّ مُرتقَب

388
00:24:38,410 --> 00:24:45,040
،فوشي، بعد دخوله البلدة مع ميزوها
يتذكّر الماضي السّحيق

389
00:24:45,630 --> 00:24:48,330
...الأصدقاء الّذين فقدَهم

390
00:24:49,470 --> 00:24:51,840
ما الجسد المُضيف الّذي سيكتسبه؟

391
00:24:52,010 --> 00:24:53,400
ورطة
- ما الجسد المُضيف الّذي سيكتسبه؟

392
00:24:53,570 --> 00:24:55,010
ورطة