1
00:00:01,780 --> 00:00:08,830
كشفَ القارع عن نفسه أمام
فوشي وتحدّاه في معركة

2
00:00:11,350 --> 00:00:12,790
تعال إليّ

3
00:00:12,790 --> 00:00:13,920
سألعب معك

4
00:00:18,060 --> 00:00:19,180
يجب عليّ العودة

5
00:00:19,180 --> 00:00:20,530
!مرحى! أنا حُرّة

6
00:00:22,390 --> 00:00:24,300
هل يمكنني العودة؟

7
00:00:24,300 --> 00:00:25,630
!أحبّ الاستمتاع

8
00:00:25,630 --> 00:00:27,810
!سيُقدّر ذلك الشّخص هذا أيضاً

9
00:00:27,810 --> 00:00:28,980
ذلك الشّخص"؟"

10
00:02:04,510 --> 00:02:10,150
ظننتُ بأنّني قد أُصادف فوشي
إذا تجوّلتُ في الأرجاء

11
00:02:10,710 --> 00:02:12,300
...ماذا أفعل

12
00:02:12,300 --> 00:02:14,990
ربّما سأزور يوكي-كن

13
00:02:15,750 --> 00:02:19,870
لكن لا أجد مُبرّراً

14
00:02:21,000 --> 00:02:23,750
فوشي، أتيتُ لمُساعدتك
في واجبك المدرسيّ

15
00:02:23,960 --> 00:02:25,660
هل أزعجك؟

16
00:02:25,660 --> 00:02:28,360
توناري تلك سوف تغضب منّي

17
00:02:28,800 --> 00:02:31,780
نكثتَ بوعدك باللّقاء بعد دوام
!المدرسة كلّ يوم

18
00:02:31,780 --> 00:02:32,830
!أنت سيّئ

19
00:02:32,830 --> 00:02:33,900
مستحيل

20
00:02:33,900 --> 00:02:36,160
لا أحد يحبّ المرأة الانفعاليّة

21
00:02:36,800 --> 00:02:39,630
يوكي-كن، وجدتُ حجراً لامعاً

22
00:02:39,630 --> 00:02:40,990
!هل هو حجر قوّة؟

23
00:02:40,990 --> 00:02:42,350
!أحسنت يا سينباي

24
00:02:42,350 --> 00:02:43,760
!هذه هي

25
00:02:46,940 --> 00:02:50,230
لكن قد لا يكون في المنزل

26
00:02:50,670 --> 00:02:52,560
هل ينبغي أن أذهب وألقي نظرة؟

27
00:02:52,560 --> 00:02:54,290
!سيجعلني هذا أبدو مُتلصّصة

28
00:02:55,310 --> 00:03:00,280
وأيضاً، أليس قلقاً عليّ؟
تركَني مُعلّقة فحسب

29
00:03:01,020 --> 00:03:03,250
ربّما لم يعُد يكترث

30
00:03:04,150 --> 00:03:07,400
ماذا يجدر بي أن أخبره عندما أراه؟

31
00:03:10,920 --> 00:03:13,790
لا أنفك أفكّر في فوشي

32
00:03:13,790 --> 00:03:15,370
أشعر نفسي غبيّة

33
00:03:15,930 --> 00:03:17,960
وكأنّني مُغرَمة

34
00:03:18,780 --> 00:03:22,780
لديّ أمّ لطيفة وصديقة جيّدة

35
00:03:22,780 --> 00:03:25,660
...أنا سعيدة، ومع ذلك

36
00:03:27,450 --> 00:03:32,760
ستكون الأمور مثاليّة أكثر لو يقول
لي فوشي بأنّه يحبّني

37
00:03:34,560 --> 00:03:35,900
...سُلحفاة بحر

38
00:03:37,260 --> 00:03:38,230
!فوشي؟

39
00:03:38,570 --> 00:03:41,570
أريدك أن تُعلّميني الحُبّ

40
00:03:43,320 --> 00:03:45,520
لا أصدّق بأنّني صادفتُه فعلاً

41
00:03:47,780 --> 00:03:49,100
هل هو القدر؟

42
00:03:49,100 --> 00:03:51,770
لا بُدّ أنّه كذلك، صحيح؟

43
00:03:53,000 --> 00:03:54,290
!فوشي؟

44
00:03:54,290 --> 00:03:56,370
!ما الأمر؟! أرجو أن تكون بخير

45
00:03:57,440 --> 00:03:58,820
!عدتَ إلى الحياة

46
00:04:01,410 --> 00:04:03,600
أخفتني

47
00:04:03,880 --> 00:04:05,770
هل أنت بخير يا فوشي؟

48
00:04:05,770 --> 00:04:07,080
هل تحسّنت الآن؟

49
00:04:07,080 --> 00:04:09,590
أجل، آسف لإخافتك يا سينباي

50
00:04:09,590 --> 00:04:11,540
هذا مُطمئن

51
00:04:11,540 --> 00:04:16,650
إذاً على أيّ حال، المعذرة... أتريد
أن تأخذني إلى مكان ما الأحد المُقبل؟

52
00:04:16,650 --> 00:04:18,180
إلى أين مثلاً؟

53
00:04:18,180 --> 00:04:19,450
أيّ مكان

54
00:04:20,690 --> 00:04:24,200
لم تكُن تلتزم بوعدك بشأن اللّقاء
بعد دوام المدرسة مُؤخّراً

55
00:04:24,530 --> 00:04:27,400
سأسامحك إذا خرجت معي في موعد

56
00:04:27,400 --> 00:04:29,140
!مـ-مـ-موعد؟

57
00:04:29,140 --> 00:04:31,790
ماذا يعني مـ-موعد؟

58
00:04:30,500 --> 00:04:32,650
...تعال يا فوشي

59
00:04:32,650 --> 00:04:34,700
!لا تنسَ موعدك معي

60
00:04:34,700 --> 00:04:37,470
!خطّتنا لهزيمة القارعين وإنقاذ الكوكب

61
00:04:37,470 --> 00:04:38,730
بالطّبع

62
00:04:38,730 --> 00:04:40,620
كنتُ على وشك فعل ذلك

63
00:04:41,040 --> 00:04:42,540
حسناً يا ميزوها

64
00:04:42,540 --> 00:04:44,340
"لنقُم بذلك "الموعد

65
00:04:44,710 --> 00:04:48,500
ستدعينني وشأني بعد ذلك، صحيح؟

66
00:04:49,440 --> 00:04:51,670
لا تروقني طريقتك في قول ذلك

67
00:04:52,510 --> 00:04:54,700
حسناً إذاً. العاشرة صباحاً من يوم الأحد

68
00:04:54,700 --> 00:04:56,190
التقِ بي في المحطّة

69
00:04:58,540 --> 00:05:00,140
إنّها مُبتهجة حقّاً

70
00:05:00,390 --> 00:05:03,100
هل تعتقدين بأنّهما سيخرجان
معاً بشكل مُستمرّ؟

71
00:05:03,710 --> 00:05:05,620
!كذبت عليّ

72
00:05:05,940 --> 00:05:07,350
!أيّ سلام هذا؟

73
00:05:07,350 --> 00:05:09,320
!أخذ القارع جسدي

74
00:05:09,320 --> 00:05:12,220
!كانت هائجة بقطّاعة العشب

75
00:05:12,220 --> 00:05:13,780
هل هناك مُشكلة في ذلك؟

76
00:05:13,780 --> 00:05:16,080
ألستِ قلقة عليّ إطلاقاً؟

77
00:05:16,080 --> 00:05:17,670
!كنتُ سأموت لو أصابت رأسي

78
00:05:17,670 --> 00:05:18,910
!تماماً

79
00:05:19,140 --> 00:05:21,150
لحظة يا فوشي، أيمكن أن تموت؟

80
00:05:21,150 --> 00:05:25,070
لا، بدقيق العبارة، كنتُ لأفقد قدرتي
على التحوُّل إلى هذا الجسد

81
00:05:25,070 --> 00:05:27,180
!يجب علينا إبادة القارعين

82
00:05:27,860 --> 00:05:29,380
!يجب علينا فعلها

83
00:05:29,830 --> 00:05:34,400
،إذا كنت تشعر بخطر من تلك الفتاة
فسيترتّب عليك التّعامل معها بنفسك

84
00:05:34,400 --> 00:05:36,850
لا يسعني فعل شيء لك

85
00:05:37,150 --> 00:05:39,220
لا، يمكنك فعل شيء

86
00:05:39,220 --> 00:05:41,210
أوّلاً، عليك التّراجع عن كذبتك

87
00:05:41,210 --> 00:05:43,100
الكذبة الّتي تُفيد بأنّ العالم مُسالم

88
00:05:43,100 --> 00:05:44,510
وتعاون معي

89
00:05:44,510 --> 00:05:47,080
لديك قدرات أكبر لكشف
القارعين، أليس كذلك؟

90
00:05:47,580 --> 00:05:50,380
لم يتبقّ أيّ شيء من قدرتي

91
00:05:50,380 --> 00:05:53,120
حتّى الآن، أستطيع جعل الجزء
السّطحيّ من جسدي

92
00:05:53,120 --> 00:05:55,530
إيجاد المُلوّثات الغريبة
الّتي هي القارعون

93
00:05:55,530 --> 00:05:57,060
ليس بعد الآن

94
00:05:57,060 --> 00:06:00,140
ليس منذ منحتُك قدرتي على إعادة الاتّصال

95
00:06:00,800 --> 00:06:06,340
كلّ ما يمكنني فعله هو التّفاعل مع البشر
القريبين للشّعور بوجود مُشكلة ما

96
00:06:06,680 --> 00:06:09,260
هكذا وجدت ميموري-تشان إذاً

97
00:06:09,260 --> 00:06:11,310
تلك القدرة ستتدهور تدريجيّاً كذلك

98
00:06:11,760 --> 00:06:14,110
وأنا لا أكذب عندما أقول بأنّ

99
00:06:14,110 --> 00:06:17,770
الوضع الحاليّ للعالم هو بأفضل حالاته

100
00:06:17,770 --> 00:06:21,470
إذاً ماذا كانت الفائدة من
معركة فوشي اليوم؟

101
00:06:21,470 --> 00:06:22,510
!ساتورو

102
00:06:22,860 --> 00:06:25,070
هـ-هـ-هل هذان صديقاك؟

103
00:06:25,070 --> 00:06:25,570
أجل

104
00:06:27,610 --> 00:06:29,960
أين التقيت بهما؟

105
00:06:29,960 --> 00:06:30,870
في الحديقة

106
00:06:31,560 --> 00:06:34,540
اسمي سوميكا. أعيش في هذه المُنشأة

107
00:06:34,540 --> 00:06:36,040
أنا الأخت الكبرى للجميع

108
00:06:36,040 --> 00:06:38,060
وأنا وليّة أمر هذا الفتى

109
00:06:38,060 --> 00:06:41,080
بالمناسبة، أنا الشّخص الأقوى هنا

110
00:06:41,080 --> 00:06:43,550
أبكيتُ شخصاً في المدرسة ذات مرّة

111
00:06:43,550 --> 00:06:44,510
سُررتُ بلقائك

112
00:06:44,510 --> 00:06:45,870
!سُررت بلقائك

113
00:06:45,870 --> 00:06:47,110
أنا يوكي

114
00:06:47,110 --> 00:06:49,990
أحبّ أماكن القوّة والحِرفيّات
الّتي في غير زمانها

115
00:06:49,310 --> 00:06:51,230
ها أنت ذا

116
00:06:51,230 --> 00:06:53,350
تعال يا فوشي. لنتكلّم في الخارج

117
00:06:53,350 --> 00:06:54,570
مرحباً

118
00:06:54,570 --> 00:06:55,500
من هو؟

119
00:06:55,500 --> 00:06:56,630
أحد المعارف

120
00:06:56,910 --> 00:06:58,460
ستذهب معهم حقّاً؟

121
00:06:58,460 --> 00:06:59,520
متأكّد؟

122
00:06:59,520 --> 00:07:00,990
لا تقلقي بشأني

123
00:07:01,560 --> 00:07:04,280
!يا للصّدمة

124
00:07:04,280 --> 00:07:07,740
أن تُهاجَم بواسطة ميموري
...مُزيّفة في المدرسة

125
00:07:07,950 --> 00:07:12,750
على أيّ حال، كانت ميموري-كن
قد قدّمت طلباً منّا

126
00:07:12,750 --> 00:07:15,830
لا تريدنا أن نُقاتل القارع بعد الآن

127
00:07:15,830 --> 00:07:18,080
لكن لماذا؟ ما السّبب؟

128
00:07:18,080 --> 00:07:20,290
لم تُخبرني أبداً

129
00:07:20,290 --> 00:07:23,000
لا مانع لديها أن يكون جسدها ممسوساً؟

130
00:07:23,960 --> 00:07:25,960
هذا ما قالته

131
00:07:26,840 --> 00:07:28,420
ماذا أفعل الآن؟

132
00:07:28,420 --> 00:07:30,200
هل أبقى مكتوف اليدين؟

133
00:07:30,200 --> 00:07:32,760
قالت بأنّها ستعود

134
00:07:34,400 --> 00:07:38,020
وقالت بأنّ "ذلك الشّخص" سيكون سعيداً

135
00:07:38,020 --> 00:07:39,690
ذلك الشّخص"؟"

136
00:07:39,690 --> 00:07:41,410
ماذا تقصد؟

137
00:07:41,410 --> 00:07:43,510
هل تعلم أيّها الفتى أسود؟

138
00:07:45,500 --> 00:07:47,340
إنّه غارقٌ في التّركيز

139
00:07:47,340 --> 00:07:50,870
لِمَ لا نطلب من نيكسون وفين
يلحقان بميموري المُزيّفة؟

140
00:07:50,870 --> 00:07:52,860
"قد نكتشف من يكون "ذلك الشّخص

141
00:07:52,860 --> 00:07:54,950
ماذا؟ تريدنا أن نذهب؟

142
00:07:54,950 --> 00:07:56,570
هذه فكرة سديدة

143
00:07:56,570 --> 00:07:57,790
لنفعلها

144
00:07:57,790 --> 00:07:58,780
مهلاً لحظة

145
00:07:59,390 --> 00:08:02,630
القارع الّذي يعيش بداخل ميموري هجوميّ

146
00:08:02,630 --> 00:08:06,120
لن يتردّد عن مُقاتلتك أينما وجدك

147
00:08:06,120 --> 00:08:09,170
يجب علينا القضاء على الضّعفاء
أوّلاً ومعرفة نقاط ضعفهم

148
00:08:09,170 --> 00:08:10,350
...لكن

149
00:08:10,350 --> 00:08:10,950
بون؟

150
00:08:10,950 --> 00:08:14,260
يستطيع ذلك الفتى معرفة ما إن
كان قارع جواره، أليس كذلك؟

151
00:08:14,260 --> 00:08:16,120
هذه إحدى الأفكار

152
00:08:16,120 --> 00:08:20,060
،لكن ميموري المُزيّفة ستُهاجم
مهما حاولنا أن نفعل

153
00:08:20,060 --> 00:08:21,860
هل تقول إيزومي-سان شيئاً؟

154
00:08:21,860 --> 00:08:24,450
فوشي، أريدك أن تستعدّ لكمائن

155
00:08:24,450 --> 00:08:29,430
بينما تبحث عن بشر مُصابين بالقارعين
مع الفتى أسود، سنبحث نحن عن ميموري

156
00:08:29,720 --> 00:08:31,200
وإذا وجدناها؟

157
00:08:31,200 --> 00:08:32,610
هل نهزمها؟

158
00:08:32,610 --> 00:08:33,770
كانت خالدة

159
00:08:34,080 --> 00:08:36,390
،إذا فصلنا جسدها عن وعيها

160
00:08:36,390 --> 00:08:38,250
فقد لا يملك القارع مكاناً يذهب إليه

161
00:08:39,050 --> 00:08:40,380
جذع الدّماغ

162
00:08:40,380 --> 00:08:41,560
صوّب هنا

163
00:08:41,560 --> 00:08:42,740
اجعله يموت فوراً

164
00:08:43,010 --> 00:08:46,620
تقول إيزومي-سان بأنّك تستطيع
قتله إذا صوّبت نحو الرّأس

165
00:08:46,620 --> 00:08:48,490
...أطعنه، اجرحه

166
00:08:48,490 --> 00:08:50,300
أيّ شيء يفي بالغرض

167
00:08:51,180 --> 00:08:52,000
فوشي؟

168
00:08:53,070 --> 00:08:53,990
أجل

169
00:08:53,990 --> 00:08:55,150
يمكنني فعلها

170
00:08:55,150 --> 00:08:56,180
أستطيع قتله

171
00:08:56,180 --> 00:08:57,580
ما الأمر؟

172
00:08:57,580 --> 00:09:00,180
كنتَ تقتلهم طوال هذا الوقت

173
00:09:00,500 --> 00:09:03,350
إنّه يتألّم

174
00:09:04,070 --> 00:09:06,150
لم يكن الأمر كما في السّابق

175
00:09:06,150 --> 00:09:08,190
شعرَ بذلك فعلاً

176
00:09:08,190 --> 00:09:11,060
نفس نوع الألم الّذي نشعر به

177
00:09:11,060 --> 00:09:14,060
الألم الّذي ينتج عن طعنة نصل
مُبرح بالفعل

178
00:09:14,060 --> 00:09:16,710
لِمَ لا نُجرّب مُتفجّرات أو سُمّ؟

179
00:09:16,710 --> 00:09:19,700
أنا متأكّد بأنّ هذا فظيع، لكنّه
لا يدوم إلّا لحظات يا فوشي

180
00:09:19,700 --> 00:09:21,370
الألم الّذي تشعر به لن يدوم طويلاً

181
00:09:21,690 --> 00:09:23,100
...لا

182
00:09:23,100 --> 00:09:25,190
أجل، معك حقّ

183
00:09:25,730 --> 00:09:27,210
لن تكون مُشكلة

184
00:09:27,650 --> 00:09:31,300
آسف، لكن سوف أعطي
الأولويّة لحياتي

185
00:09:31,300 --> 00:09:34,340
لا تتأمّل منّي القدرة على مُساعدتك

186
00:09:34,630 --> 00:09:36,420
!سئمتُ من هذا

187
00:09:36,420 --> 00:09:38,120
لا أعرف ماذا أصابك

188
00:09:38,120 --> 00:09:40,670
!لكن من وجهة نظري، كلّ هذا من صنيعك

189
00:09:41,250 --> 00:09:42,420
!فوشي

190
00:09:42,420 --> 00:09:44,140
!توقّف! اهدأ

191
00:09:45,140 --> 00:09:45,970
هل أنت بخير؟

192
00:09:47,140 --> 00:09:48,970
اعتذر يا فوشي

193
00:09:53,090 --> 00:09:53,850
سأغادر

194
00:09:53,850 --> 00:09:55,030
سأوصلك

195
00:09:55,030 --> 00:09:55,510
لا

196
00:09:55,510 --> 00:09:56,870
لا تكن هكذا

197
00:09:56,870 --> 00:09:58,350
أتريد أن أُمسك يدك؟

198
00:09:58,830 --> 00:10:01,940
نسي ورقة تمارين الرّياضيّات خاصّته

199
00:10:03,100 --> 00:10:04,600
ارتكبَ أخطاء

200
00:10:04,600 --> 00:10:06,480
بدا ذكيّاً جدّاً

201
00:10:06,480 --> 00:10:07,890
هذا غريب

202
00:10:07,890 --> 00:10:10,750
الأسود جيّد في الحساب

203
00:10:10,750 --> 00:10:12,140
هل هو كذلك؟

204
00:10:12,140 --> 00:10:15,200
أعتقد مع مُضيف جديد، يتغيّر عقله أيضاً

205
00:10:15,200 --> 00:10:17,090
هذا ما قاله من قبل

206
00:10:17,470 --> 00:10:20,830
،جوهريّاً، الآن بعد أن صار صغيراً
عقله أصغر أيضاً

207
00:10:21,880 --> 00:10:25,220
قد يعني هذا أنّ القارعين قد يتّخذون

208
00:10:25,220 --> 00:10:28,090
طبعاً ألطف بجسده الجديد أيضاً، صحيح؟

209
00:10:28,500 --> 00:10:30,570
سيكون ذلك رائعاً

210
00:10:30,570 --> 00:10:34,430
!هيّا أيّها الخنزير، اصرخ

211
00:10:34,840 --> 00:10:37,420
أعلم بأنّك كنتَ تتقصّى

212
00:10:37,420 --> 00:10:42,200
حاول أن تخبر أحداً بما رأيتُه
وسأجعلك تُعاني أكثر

213
00:10:42,860 --> 00:10:43,500
!ردّ عليّ

214
00:10:43,500 --> 00:10:44,170
!حـ-حاضر

215
00:10:44,170 --> 00:10:45,060
!تعلم ما أريد سماعه

216
00:10:52,380 --> 00:10:54,280
!آسفة يا فوشي

217
00:10:54,940 --> 00:10:56,770
!استغرقتُ في النّوم

218
00:10:58,190 --> 00:10:59,400
جعلتُك تنتظر طويلاً، أليس كذلك؟

219
00:10:59,400 --> 00:11:01,900
...آسفة! وفي موعدنا الأوّل أيضاً

220
00:11:02,810 --> 00:11:04,690
حسناً، لنذهب

221
00:11:04,690 --> 00:11:05,860
إلى أين ينبغي أن نذهب؟

222
00:11:05,860 --> 00:11:07,420
...لنرَ

223
00:11:07,660 --> 00:11:09,090
هل يؤدّي الكوزبلاي؟

224
00:11:09,090 --> 00:11:10,430
يبدو غريب أطوار

225
00:11:11,120 --> 00:11:13,800
أريد تفقُّد بعض الملابس

226
00:11:16,300 --> 00:11:18,800
لم تذهب إلى المدرسة مُؤخّراً

227
00:11:18,800 --> 00:11:20,690
لا يمكنك أن تُقنعني بأنّه لا توجد مُشكلة

228
00:11:20,690 --> 00:11:24,150
أخبرتني توناري-سان بأنّك لم تعُد
تذهب إلى المنزل مؤخّراً أيضاً

229
00:11:26,170 --> 00:11:29,290
لم أرِد أن يراني النّاس عندما
لا أُبلي بلاء حسناً فحسب

230
00:11:29,850 --> 00:11:32,420
،منذ هوجِمتُ بواسطة قارع ميموري

231
00:11:32,420 --> 00:11:35,340
وأنا أنام في الخارج تحضيراً للهجوم التّالي

232
00:11:36,090 --> 00:11:37,210
...ومع ذلك

233
00:11:37,210 --> 00:11:42,380
تقول ميموري الحقيقيّة بأنّه لا داعي
لأُقاتل، والأسود لا يتعاون

234
00:11:42,710 --> 00:11:44,120
ما المُشكلة؟

235
00:11:44,990 --> 00:11:48,740
سنكون أفضل حالاً حتماً بلا قارعين

236
00:11:50,680 --> 00:11:52,760
إذاً حدث شيء ما فعلاً

237
00:11:53,150 --> 00:11:54,990
ينبغي أن تُخبرني

238
00:11:54,990 --> 00:11:56,430
...في الواقع

239
00:11:56,430 --> 00:11:57,990
هل هناك ما أعجبكِ من ملابس؟

240
00:11:57,990 --> 00:12:00,350
ارتدِ هذه يا فوشي

241
00:12:01,230 --> 00:12:03,530
كنتِ تبحثين عن ملابس لأجلي؟

242
00:12:03,530 --> 00:12:05,980
لا تُمانعين شراء هذه لي؟

243
00:12:05,980 --> 00:12:07,360
لا عليك

244
00:12:10,330 --> 00:12:13,140
كيف حال أمّكِ؟ ما زالت نفسها؟

245
00:12:13,140 --> 00:12:16,120
أجل. إنّها لطيفة جدّاً

246
00:12:16,120 --> 00:12:17,840
الأجواء مُسالمة جدّاً لدرجة لا تُصدَّق

247
00:12:18,650 --> 00:12:19,830
هكذا إذاً

248
00:12:20,310 --> 00:12:21,500
يسرّني سماع ذلك

249
00:12:24,020 --> 00:12:25,150
...تبّاً

250
00:12:25,690 --> 00:12:28,200
يجب عليّ أن أحرص على ألّا أنسى

251
00:12:28,660 --> 00:12:31,600
ليس هذا المكان

252
00:12:32,020 --> 00:12:37,020
لا بُدّ من وجود سبب يجعل القارعين
لا يزالون يتحكّمون بأجساد البشر

253
00:12:39,320 --> 00:12:40,850
ألاحظت يا فوشي؟

254
00:12:40,850 --> 00:12:42,310
لاحظتُ ماذا؟

255
00:12:43,110 --> 00:12:45,320
كلّ الفتيات ينظرنَ إليك

256
00:12:45,780 --> 00:12:47,770
يعتقدنَ بأنّك جذّاب

257
00:12:48,210 --> 00:12:49,460
جذّاب؟

258
00:12:49,460 --> 00:12:51,450
أنت مُلفِت في البلدة

259
00:12:51,450 --> 00:12:53,750
ينبغي أن تلبس هكذا دوماً

260
00:12:55,160 --> 00:12:57,410
!أنت هنا إذاً

261
00:12:57,920 --> 00:13:00,180
هل يمكننا مُساعدتكِ يا آنسة؟

262
00:13:00,180 --> 00:13:02,980
أنت في موعد وكأنّ كلّ شيء
على ما يُرام

263
00:13:02,980 --> 00:13:05,370
!إيّاك والهرب ممّا تحدّثنا عنه من قبل

264
00:13:05,670 --> 00:13:06,680
من قبل؟

265
00:13:06,680 --> 00:13:07,840
هل تعرفها؟

266
00:13:07,840 --> 00:13:10,180
!جرحتَ ساتورو

267
00:13:10,520 --> 00:13:12,630
!لا تتصرّف وكأنّك لا تتذكّر

268
00:13:12,920 --> 00:13:14,420
ساتورو؟

269
00:13:15,590 --> 00:13:18,890
المعذرة... سوميكو-سان، صحيح؟

270
00:13:19,290 --> 00:13:21,280
لم يكن ذلك مُتعمَّداً

271
00:13:21,280 --> 00:13:23,980
لحظة، هل جُرِح؟ حقّاً؟

272
00:13:23,980 --> 00:13:26,180
!لا تتغابَ أيّها الوغد

273
00:13:26,180 --> 00:13:28,360
!لديه جرح وكدمة

274
00:13:28,730 --> 00:13:30,410
ساتورو هادئ جدّاً

275
00:13:30,410 --> 00:13:32,950
كنتُ سعيدة للغاية. ظننتُ بأنّه
تعرّف على صديق أخيراً

276
00:13:33,310 --> 00:13:36,170
!وتبيّن بأنّ "صديقه" وغد حقيقيّ

277
00:13:37,920 --> 00:13:42,460
مُحال لذلك الفتى الكئيب
أن يصنع أصدقاء

278
00:13:44,430 --> 00:13:47,580
!سأُذيقك ممّا فعلتَه به

279
00:13:47,580 --> 00:13:48,370
!مُؤلم

280
00:13:49,270 --> 00:13:50,950
!لا للعنف! أنتِ فظيعة

281
00:13:50,300 --> 00:13:53,230
أنتِ لا تعلمين ما الّذي كان يمرّ به

282
00:13:54,510 --> 00:13:58,850
كان وحيداً تماماً تحت المطر
عندما تمّ تبنّيه

283
00:13:59,330 --> 00:14:01,570
لم يستطع حتّى لفظ اسمه

284
00:14:02,450 --> 00:14:07,700
دفّأتُ جسده البارد، وقال
...بوجه مصدوم

285
00:14:08,070 --> 00:14:09,790
هذا دافئ

286
00:14:09,790 --> 00:14:12,410
وكأنّها المرّة الأولى الّتي يستحمّ فيها

287
00:14:13,440 --> 00:14:18,330
...لذا طبختُ له، فقالَ بوجه مُتفاجئ ثانية

288
00:14:18,760 --> 00:14:20,460
لم آكل من قبل

289
00:14:21,330 --> 00:14:26,380
لم يبدُ أنّه يستطيع الإجابة عمّا كان
يفعله حتّى الآن أو مَن يكون والديه

290
00:14:26,380 --> 00:14:29,590
هذا ما يحدث عندما لا يملك
الطّفل أحداً يُحبّه

291
00:14:29,590 --> 00:14:34,420
لهذا سمّيتُه ساتورو، وذلك
كي يبدأ حياة جديدة

292
00:14:34,730 --> 00:14:37,390
وأردتُ ملء حياته بالحُبّ

293
00:14:38,400 --> 00:14:43,300
آسف، لكنّه ليس كما تعتقدينه

294
00:14:43,300 --> 00:14:44,660
أنتِ تهدرين وقتكِ عليه

295
00:14:45,690 --> 00:14:49,680
يبدو أنّك تريدني فعلاً أن أُلقّنك درساً

296
00:14:49,680 --> 00:14:50,660
!مهلاً

297
00:14:50,660 --> 00:14:52,110
لن أسمح بذلك

298
00:14:52,480 --> 00:14:56,460
الكاراتيه، الجودو، الآيكيدو... مارستُها
!كلّها. سوف أُواجهكِ

299
00:14:58,010 --> 00:15:00,240
أتعتقدين بأنّكِ تستطيعين هزيمتي؟

300
00:15:00,730 --> 00:15:03,010
شخص تافه مثلكِ؟

301
00:15:05,270 --> 00:15:06,670
!انتظر

302
00:15:06,670 --> 00:15:08,800
!سأدعك تعتذر

303
00:15:10,490 --> 00:15:11,830
!من هنا

304
00:15:12,130 --> 00:15:14,200
!فوشي، تحوّل

305
00:15:14,200 --> 00:15:15,770
!إلى أيّ شيء! مهما كان

306
00:15:17,800 --> 00:15:20,630
ماذا؟ إلى أين ذهب؟

307
00:15:20,630 --> 00:15:22,730
هربَ من تلقاء نفسه

308
00:15:23,700 --> 00:15:26,560
حقّاً؟ لا تقولي لي أنّكِ تُخفينه

309
00:15:26,560 --> 00:15:28,500
اختفى أثره تماماً

310
00:15:28,500 --> 00:15:29,270
صحيح؟

311
00:15:29,270 --> 00:15:30,320
صحيح

312
00:15:30,670 --> 00:15:31,740
!أيّها الوغد

313
00:15:31,740 --> 00:15:34,100
!عُد إلى هنا

314
00:15:32,210 --> 00:15:35,350
يدع تلك الفتاة تحميه حقّاً

315
00:15:35,350 --> 00:15:38,910
أصبح بشريّاً تماماً

316
00:15:39,220 --> 00:15:40,930
فعلتُها

317
00:15:40,930 --> 00:15:42,480
حميتُ فوشي

318
00:15:43,530 --> 00:15:47,910
لا أعلم ما حدث، لكن لا ينبغي
أن تُغضب الفتيات

319
00:15:48,230 --> 00:15:50,490
فلا أحد يعلم ما يُسبّبه
ذلك من ألم لاحقاً

320
00:15:50,490 --> 00:15:52,060
أجل

321
00:15:52,060 --> 00:15:53,300
مرحباً

322
00:15:53,300 --> 00:15:57,600
نحن من نادي تصوير مدرسة
ميناموتو الابتدائيّة

323
00:15:57,840 --> 00:16:01,620
هل أنتما مُتاحان لبضعة صور
كعارضتي أزياء؟

324
00:16:01,620 --> 00:16:02,890
عرض أزياء؟

325
00:16:08,320 --> 00:16:10,230
!شكراً لكما

326
00:16:10,520 --> 00:16:12,760
يمكنكما الحصول على هذه

327
00:16:12,760 --> 00:16:15,390
أبلغاني إذا كنتُما ستستخدمان
هذه الصّور في مكان ما

328
00:16:15,390 --> 00:16:16,400
حسناً

329
00:16:16,680 --> 00:16:19,310
ما الأمر يا فوشي؟ تبدو سعيداً

330
00:16:19,310 --> 00:16:20,910
هل تُحبّ أن تُلتقَط لك صور؟

331
00:16:20,910 --> 00:16:24,110
كنتُ أتذكّر مالكة هذا الجسد

332
00:16:25,280 --> 00:16:27,210
كان اسمها ميا

333
00:16:27,210 --> 00:16:29,260
كانت تحلم بأن تكون عارضة رسم

334
00:16:29,260 --> 00:16:31,490
تُوفّيَتْ قبل أن يتحقّق لها ذلك

335
00:16:32,200 --> 00:16:37,170
إنّها صورة. لكنّك حقّقتَ لها أُمنيتها، صحيح؟

336
00:16:37,170 --> 00:16:38,670
هذا ما كنتُ أقوله لنفسي

337
00:16:39,010 --> 00:16:41,960
صحيح! أوبا وأوروي أيضاً

338
00:16:41,960 --> 00:16:44,400
ماذا؟ هناك المزيد؟

339
00:16:44,400 --> 00:16:47,560
بالتّأكيد، سأقدّم المُساعدة

340
00:16:50,930 --> 00:16:54,890
كان حلم أوروي الاحتفاظ بكثير من الحيوانات

341
00:16:55,670 --> 00:16:58,370
!كلّ هذه الحيوانات لم أرَها من قبل

342
00:16:58,370 --> 00:17:01,430
!سوف يحبّها

343
00:17:03,040 --> 00:17:03,960
انظر

344
00:17:04,290 --> 00:17:06,160
تلك كوكبة أونيغوما

345
00:17:06,160 --> 00:17:09,380
كانت أوبّا مُهتمّة بالشّمس

346
00:17:09,850 --> 00:17:13,840
ستُصدَم إذا اكتشفتْ بأنّ هناك
نجوماً أكثر بُعداً

347
00:17:13,840 --> 00:17:15,550
وأكبر من الشّمس

348
00:17:17,010 --> 00:17:19,590
آسف لتأخُّري

349
00:17:19,940 --> 00:17:22,590
شكراً على الخروج معي اليوم

350
00:17:22,590 --> 00:17:25,120
أنا مسرورة حقّاً لأنّني
التقيتُ بك يا فوشي

351
00:17:25,120 --> 00:17:28,150
...لا أُصدّق بأنّني كنتُ أُريد الموت

352
00:17:31,770 --> 00:17:32,900
إلى اللّقاء يا فوشي

353
00:17:33,230 --> 00:17:35,490
يجدر بك المجيء إلى المدرسة
بين الحين والآخر

354
00:17:35,490 --> 00:17:36,290
حسناً

355
00:17:41,120 --> 00:17:43,930
كوكبة أونيغوما إذاً؟

356
00:17:43,930 --> 00:17:45,970
ينبغي أن أُخبر ماتشي

357
00:17:46,920 --> 00:17:49,470
لكن لا أستطيع العودة إلى المنزل بعد

358
00:17:49,470 --> 00:17:51,680
ليس قبل أن أتعامل مع القارع ميموري

359
00:17:52,080 --> 00:17:53,250
!فوشي

360
00:17:53,250 --> 00:17:55,370
!أراك هنا

361
00:17:55,370 --> 00:17:56,420
توناري

362
00:17:56,720 --> 00:17:59,580
غبتَ لفترة طويلة. الجميع قلقون

363
00:17:59,580 --> 00:18:02,360
ماذا تفعل بهيئة أوبّا على أيّ حال؟

364
00:18:02,360 --> 00:18:03,890
كنتُ أتأمّل النّجوم

365
00:18:04,350 --> 00:18:05,770
أونيغوما

366
00:18:06,540 --> 00:18:07,770
أيّ واحدة؟

367
00:18:08,070 --> 00:18:09,100
...المعذرة

368
00:18:09,100 --> 00:18:12,250
ذلك الأحمر والّذي بجانبه

369
00:18:11,560 --> 00:18:13,120
لا أراها

370
00:18:13,120 --> 00:18:15,510
أعتقد كانت تلك الزّرقاء

371
00:18:15,510 --> 00:18:17,590
هذه الرّائحة تُرجعني للذّكريات

372
00:18:17,590 --> 00:18:20,310
خليط من التّراب والعطر

373
00:18:20,860 --> 00:18:23,860
...ليت أوبّا كانت هنا

374
00:18:24,620 --> 00:18:26,680
أردتُ تأمُّل النُّجوم معها

375
00:18:26,680 --> 00:18:28,660
لا أستطيع الاعتياد على امتلاك
عين واحدة فقط

376
00:18:33,820 --> 00:18:35,620
!فوشي

377
00:18:36,470 --> 00:18:38,890
!تُصبح على خير يا فوشي

378
00:18:38,890 --> 00:18:40,750
أجل، تصبحين على خير

379
00:18:40,750 --> 00:18:43,750
بالطّبع! كنتَ مع ميزوها اليوم

380
00:18:43,750 --> 00:18:45,310
أجل. في موعد

381
00:18:46,350 --> 00:18:48,260
بهيئة أوبّا؟

382
00:18:48,260 --> 00:18:49,330
!أجل

383
00:18:49,330 --> 00:18:52,160
أخذَتْني إلى هذا المكان
الّذي يُدعى قبّة فلكيّة

384
00:18:52,160 --> 00:18:53,980
رأينا مُختلف أنواع النُّجوم

385
00:18:53,980 --> 00:18:56,430
أتتذكّرين كيف كانت أوبّا
مُهتمّة بالشّمس؟

386
00:18:56,430 --> 00:18:57,740
أردتُ رؤيتها

387
00:18:58,040 --> 00:18:59,600
وحديقة الحيوانات

388
00:18:59,600 --> 00:19:02,750
جعلتُ أوروي يراها بأمّ عينه

389
00:19:02,750 --> 00:19:06,420
وجعلتُ ميا تكون عارضة أزياء

390
00:19:06,420 --> 00:19:09,080
انظري. تبدو رائعة بهذه الصّورة أيضاً

391
00:19:08,130 --> 00:19:09,080
!توقّف عن ذلك

392
00:19:09,930 --> 00:19:11,920
ها أنت هنا

393
00:19:11,920 --> 00:19:14,380
فوشي! تكلّمتْ توناري معك، صحيح؟

394
00:19:14,380 --> 00:19:16,150
لنعُد إلى المنزل

395
00:19:17,530 --> 00:19:19,660
ألم تسمع؟

396
00:19:19,660 --> 00:19:22,090
يريد بون أن يتكلّم معك

397
00:19:22,090 --> 00:19:26,320
أخذتْ ليغارد للبحث عنك
بما أنّك كنت مفقوداً

398
00:19:27,670 --> 00:19:29,460
هل من مُشكلة؟

399
00:19:29,930 --> 00:19:34,430
استغلّتْ أصدقائي لأهداف عاطفيّة

400
00:19:34,660 --> 00:19:35,530
ماذا؟

401
00:19:35,530 --> 00:19:37,230
ماذا تقصدين؟

402
00:19:37,230 --> 00:19:38,940
ميزوها لطيفة فحسب

403
00:19:38,940 --> 00:19:39,860
!لا أريد سماع ذلك

404
00:19:39,860 --> 00:19:40,900
...مـ-مهلاً

405
00:19:40,900 --> 00:19:42,320
...اسمع

406
00:19:42,320 --> 00:19:45,200
ليس أنت أو هذه الفتاة الّتي تُدعى ميزوها

407
00:19:45,200 --> 00:19:51,240
أحبّ أوبّا وأوروي وميا أكثر
!أن يحبّهم أيّ شخص آخر

408
00:19:51,730 --> 00:19:53,440
!أحبّهم حُبّاً جمّاً

409
00:19:54,090 --> 00:19:57,220
،ماتوا بسيطرة القارعين عليهم

410
00:19:57,650 --> 00:20:01,150
كانت تلك نهاية حياتهم، ولم يكن
هناك ما نستطيع فعله

411
00:20:02,250 --> 00:20:07,200
...إذا كنتَ تعتقد بأنّك تعيش حياتهم

412
00:20:07,710 --> 00:20:10,980
!فلا تُدنّس أصدقائي بأفكارك القذرة

413
00:20:11,290 --> 00:20:12,140
!توناري

414
00:20:13,170 --> 00:20:14,670
!توناري-سان؟

415
00:20:17,800 --> 00:20:20,280
...فوشي، أنا أُخمّن فحسب، لكن

416
00:20:20,680 --> 00:20:22,980
هل كانت توناري-سان غاضبة؟

417
00:20:22,980 --> 00:20:23,890
هل تشاجرتما؟

418
00:20:24,920 --> 00:20:27,280
أنت، هل أنت بخير؟

419
00:20:27,630 --> 00:20:29,840
ينبغي أن نعود إلى المنزل

420
00:20:29,840 --> 00:20:31,990
سأواسي توناري

421
00:20:31,990 --> 00:20:32,700
!لا

422
00:20:32,700 --> 00:20:33,670
!ابتعد

423
00:20:33,670 --> 00:20:35,070
لِمَ لا؟

424
00:20:35,070 --> 00:20:37,270
أيكو تُعدّ قِدراً ساخناً

425
00:20:37,270 --> 00:20:39,380
ماذا تفعل في هذه الأيّام حتّى يا فوشي؟

426
00:20:39,380 --> 00:20:41,040
كنتَ تتسكّع من مكانٍ لآخر بمُفردك

427
00:20:41,040 --> 00:20:42,090
هل تُخفي شيئاً؟

428
00:20:42,090 --> 00:20:46,080
غوغو-نيسان، تعلم ما في الأمر

429
00:20:46,080 --> 00:20:46,970
ماذا؟

430
00:20:46,970 --> 00:20:48,810
إنّه شابّ

431
00:20:48,810 --> 00:20:51,620
إنّه مثل القطّ الّذي كنتُ أملكه

432
00:20:51,620 --> 00:20:54,590
غادر المنزل عندما كان
في نزوة ولم يعُد أبداً

433
00:20:55,140 --> 00:20:57,900
أتعني بأنّه في نزوة؟ فوشي؟

434
00:20:57,900 --> 00:20:59,340
!صحيح

435
00:20:59,340 --> 00:21:02,150
كان يُغازل تلك الفتاة ميزوها

436
00:21:02,150 --> 00:21:04,130
،لذا الآن أصبحت الأمور مُضطربة مع توناري

437
00:21:04,130 --> 00:21:06,520
ولا تشعر براحة في المنزل

438
00:21:05,760 --> 00:21:07,790
!لقد هجرتها

439
00:21:06,520 --> 00:21:08,610
،لا أعتقد بأنّ ميزوها مُناسبة لك

440
00:21:08,610 --> 00:21:10,570
لكن أدعمك إذا كانت من تُحبها

441
00:21:10,570 --> 00:21:12,870
سأتكلّم مع توناري. أعدك بذلك

442
00:21:13,290 --> 00:21:16,200
سأخبر بون-سان بأن يلتقي بك في المدرسة

443
00:21:16,960 --> 00:21:19,900
حسناً يا أخي، هل نعود؟

444
00:21:21,910 --> 00:21:23,070
لا أُريد

445
00:21:28,380 --> 00:21:30,720
أحبطتُ توناري

446
00:21:31,620 --> 00:21:35,470
لم أستطع إنقاذ أوبّا والآخرين في ذلك اليوم

447
00:21:35,900 --> 00:21:40,680
استخدمتُ أجسادهم لمُحاولة
مُعالجة بؤسي وتعاستي

448
00:21:41,920 --> 00:21:46,690
ليس وكأنّ أوبّا وأوروي يستطيعان
رؤية ما رأيتُه

449
00:21:47,900 --> 00:21:50,020
الحياة صعبة

450
00:21:54,000 --> 00:21:57,290
أتساءل ما إن كان الشّرب
لنسيان الحزن ينجح فعلاً

451
00:22:00,970 --> 00:22:03,840
أستطيع الشّرب عندما أكون
بجسد رجل الخمر

452
00:22:03,840 --> 00:22:05,300
هذا لطيف بعض الشّيء

453
00:22:10,530 --> 00:22:11,840
...انظر

454
00:22:11,840 --> 00:22:13,220
!انظر إلى هذا

455
00:22:15,530 --> 00:22:17,360
فوشي! هل أنت بخير؟

456
00:22:17,360 --> 00:22:18,630
!من أنت؟

457
00:22:18,630 --> 00:22:19,720
ماذا فعلت لفوشي؟

458
00:22:20,390 --> 00:22:21,740
!أريدك ببساطة

459
00:22:22,290 --> 00:22:24,240
!أن تشاهد هذا

460
00:22:24,920 --> 00:22:26,440
!درب السّعادة هذا

461
00:22:26,440 --> 00:22:29,350
يلمع كطريق حريريّ أسود
!فوق رمال بيضاء

462
00:22:29,350 --> 00:22:31,180
...والأربطة الّتي تُقيّده

463
00:22:31,180 --> 00:22:32,210
!العاقبة الأخلاقيّة للإنسان

464
00:22:32,210 --> 00:22:36,110
!النّقيض تماماً لكلّ مَن يُدنّس الحياة

465
00:22:36,110 --> 00:22:38,100
!من أنت؟

466
00:22:38,100 --> 00:22:40,050
هيروتوشي

467
00:22:40,380 --> 00:22:42,750
إنّه الشّخص الّذي استدعيتُه

468
00:22:43,410 --> 00:22:46,670
كان يقف عند بوّابة المدرسة مُؤخّراً

469
00:22:46,670 --> 00:22:50,610
،قال بأنّه كان يبحث عن فوشي
لذا تبادلنا عناوين اتّصالنا

470
00:22:50,610 --> 00:22:51,880
!أيُّها المُنحرف

471
00:22:51,880 --> 00:22:53,090
ماذا تريد منّي؟

472
00:22:53,870 --> 00:22:56,560
أريدك أن تُساعد أختي

473
00:22:57,430 --> 00:22:59,010
أُساعدها؟

474
00:24:32,430 --> 00:24:36,530
روح مبتورة وجسد مفقود

475
00:24:37,560 --> 00:24:43,710
هل ستُلبّي ميموري صيحات ألم هيروتوشي؟

476
00:24:45,250 --> 00:24:50,590
من سيخرج مُنتصراً في معركة
مُنتصف اللّيل؟