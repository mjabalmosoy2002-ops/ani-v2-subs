1
00:00:02,000 --> 00:00:06,770
انتهت المعركة مع الطّارقين في جاناندا

2
00:00:08,560 --> 00:00:12,500
،بعد أن تعلّم العديد من الأشياء في الجزيرة
،شدّ فوشي الرّحال

3
00:00:12,880 --> 00:00:16,360
...بعد وداعه توناري

4
00:00:19,770 --> 00:00:23,360
...وهاياسي من يانومي

5
00:02:09,790 --> 00:02:13,560
متى سيأتي صديقكِ أيّتها السيّدة العجوز؟

6
00:02:14,030 --> 00:02:16,080
لا أدري

7
00:02:29,230 --> 00:02:30,410
...بيوران

8
00:02:31,400 --> 00:02:33,670
جعلتُها تنتظر طويلاً

9
00:02:36,900 --> 00:02:40,730
كانت بيوران لطيفة معي لفترة طويلة

10
00:02:41,520 --> 00:02:45,800
لكن لا أنفك أجذب أسوأ الأشياء

11
00:02:46,960 --> 00:02:49,260
أشياء تريد أن تفعل ما يحلو لها معي

12
00:03:05,780 --> 00:03:09,010
...كنتُ أفكّر طوال الوقت وأنا في طريقي إلى هنا

13
00:03:09,890 --> 00:03:12,520
لا أستطيع تحقيق السّعادة لأحد

14
00:03:30,740 --> 00:03:32,380
أظنّني سأنام هنا اللّيلة

15
00:03:33,390 --> 00:03:38,400
وغداً، سأغادر بسفينة

16
00:03:47,930 --> 00:03:52,000
لحظة، كم تملك بيوران من المال؟

17
00:03:52,500 --> 00:03:54,820
كانت تأكل البازلّاء في المحلّ

18
00:03:54,820 --> 00:03:56,490
لا يمكن أن تتمكّن من النجاة

19
00:03:56,790 --> 00:04:00,750
هل أنت متأكّد أنّك لا تريدني أن أدفع؟

20
00:04:00,750 --> 00:04:04,420
أعطيتني خبزاً حتّى

21
00:04:04,420 --> 00:04:07,190
لا داعي. فأنتِ لا تملكين مالاً، أليس كذلك؟

22
00:04:07,590 --> 00:04:09,970
نظّفتُ السّقيفة

23
00:04:09,970 --> 00:04:12,530
تركت صابوناً هناك أيضاً. يمكنكِ استعماله

24
00:04:12,530 --> 00:04:14,370
شكراً لك

25
00:04:20,320 --> 00:04:22,670
!وجبة رائعة! شكراً جزيلاً

26
00:04:23,920 --> 00:04:25,950
لقد أسرفتَ في الشّرب

27
00:04:24,270 --> 00:04:28,360
ستكون بخير من دوني

28
00:04:29,640 --> 00:04:31,980
وداعاً يا بيوران

29
00:04:50,350 --> 00:04:51,250
حسناً، هيّا بنا

30
00:04:51,250 --> 00:04:52,960
...بثبات، بثبات

31
00:04:56,260 --> 00:05:00,640
لكن رغم ذلك، إذا غادرتُ الآن، ستنتظرني للأبد

32
00:05:01,940 --> 00:05:03,090
!ما هذا؟

33
00:05:02,230 --> 00:05:03,850
لا أستطيع فعل ذلك لها

34
00:05:03,090 --> 00:05:04,700
!جرذ؟

35
00:05:04,700 --> 00:05:08,140
سأكتب لها رسالة وأذكر فيها أنّها
ليست بحاجة لانتظاري بعد الآن

36
00:05:08,850 --> 00:05:10,370
...سأصنع قلماً وورقة، و

37
00:05:10,770 --> 00:05:12,610
ماذا؟ ليس لديّ

38
00:05:13,130 --> 00:05:15,740
المعذرة، هل يمكنني استعارة هذا؟

39
00:05:16,100 --> 00:05:17,070
لا

40
00:05:17,870 --> 00:05:18,710
!لحظة فقط

41
00:05:19,660 --> 00:05:22,170
!ما مشكلتك؟

42
00:05:22,730 --> 00:05:23,830
آسف

43
00:05:23,830 --> 00:05:24,720
شكراً

44
00:05:28,530 --> 00:05:32,580
"أنا بخير الآن. وداعاً"

45
00:05:32,580 --> 00:05:36,370
ماذا؟! هل كان هذا هو الحرف الصّحيح
لـ"ب" في "بيوران"؟

46
00:05:36,370 --> 00:05:38,290
أيّاً يكن، سيفي هذا بالغرض

47
00:05:45,990 --> 00:05:48,240
إنّه الوداع فعليّاً هذه المرّة

48
00:05:58,650 --> 00:06:02,000
!مهلاً! تبرد بيوران في اللّيل دوماً

49
00:06:02,000 --> 00:06:04,140
دائماً ما تقول أنّها تريد معطفاً

50
00:06:04,340 --> 00:06:06,750
ستتجمّد وتموت بهذه الملابس

51
00:06:07,910 --> 00:06:09,170
يبدو هذا مناسباً

52
00:06:19,730 --> 00:06:20,830
...بيوران

53
00:06:20,830 --> 00:06:21,730
أين أنتِ؟

54
00:06:25,980 --> 00:06:29,230
!إلى أين تأخذني بالضبط؟

55
00:06:29,440 --> 00:06:31,920
أتيتِ من جاناندا، أليس كذلك؟

56
00:06:31,920 --> 00:06:34,050
هذا المكان ليس مكانكِ

57
00:06:34,050 --> 00:06:35,250
!عودي إلى الجزيرة

58
00:06:35,250 --> 00:06:36,290
!دعني وشأني

59
00:06:36,290 --> 00:06:40,020
!تحرّرتُ رسميّاً من الجزيرة بواسطة قائدة الجزيرة

60
00:06:40,020 --> 00:06:41,860
!هذا ليس شأننا

61
00:06:42,080 --> 00:06:43,120
عليّ مساعدتها

62
00:06:45,100 --> 00:06:46,960
!مؤلم

63
00:06:49,940 --> 00:06:51,150
أحمق

64
00:06:52,070 --> 00:06:53,440
...بيوران

65
00:07:00,770 --> 00:07:05,680
قد تكون بيوران بخير من دوني

66
00:07:06,550 --> 00:07:07,520
...لكن

67
00:07:11,860 --> 00:07:13,630
لم أرها تبتسم من قبل

68
00:07:14,790 --> 00:07:16,260
ما الأمر؟

69
00:07:16,260 --> 00:07:18,390
تقضي وقتك ذهاباً وإيّاباً

70
00:07:20,350 --> 00:07:22,410
...قالت توناري منذ مدّة

71
00:07:23,040 --> 00:07:24,830
أنّك قد تكون شيطاناً

72
00:07:24,830 --> 00:07:27,270
وأنّك قد تكون شيئاً سيّئاً

73
00:07:28,200 --> 00:07:29,650
هل هي مُحقّة؟

74
00:07:32,720 --> 00:07:35,680
هذا نقاش بعيد كلّ البُعد عن موضوعنا

75
00:07:37,870 --> 00:07:41,000
تريد أن تكون مع بيوران تلك، صحيح؟

76
00:07:42,550 --> 00:07:43,600
لا

77
00:07:44,380 --> 00:07:49,190
هناك احتمال أن تُقتَل بواسطة
الطّارقين إذا بقيت معك

78
00:07:49,190 --> 00:07:53,250
وحتّى لو لم تكن معك، تلك المرأة العجوز
سوف تموت في نهاية المطاف

79
00:07:53,620 --> 00:07:55,910
لم يبقَ أمامها الكثير لتعيش

80
00:07:56,110 --> 00:07:57,380
!توقّف

81
00:07:57,380 --> 00:07:59,040
!لن تموت بيوران

82
00:08:00,140 --> 00:08:02,790
كلّ الناس مصيرهم الموت

83
00:08:03,120 --> 00:08:08,040
يخضع جسم الإنسان لعمليّة تغيير في لحظة ولادته

84
00:08:08,040 --> 00:08:11,470
،بعد فترة نشطة ومليئة بالشّباب

85
00:08:11,470 --> 00:08:16,590
يتباطأ سلوكه تدريجيّاً ويتوقّف في النّهاية

86
00:08:17,530 --> 00:08:22,050
هل أنت قلق بشأن طريقة موت تلك المرأة العجوز؟

87
00:08:22,840 --> 00:08:25,580
الأمر لا يستحقّ التّفكير

88
00:08:25,580 --> 00:08:27,880
لا أحد يعلم ما سيحدث

89
00:08:28,700 --> 00:08:32,740
ما لم يختاروا بأنفسهم

90
00:08:33,450 --> 00:08:36,040
طريقة موتهم

91
00:08:39,070 --> 00:08:42,490
ماذا يجدر بي أن أفعل برأيك؟

92
00:08:43,690 --> 00:08:45,090
ماذا تريد أن تفعل؟

93
00:08:46,070 --> 00:08:47,410
لا أدري

94
00:08:47,900 --> 00:08:50,480
لا أدري، ولهذا أنا قلق

95
00:08:51,910 --> 00:08:53,090
...و

96
00:08:56,050 --> 00:08:57,460
تشعر بالوحدة؟

97
00:09:03,140 --> 00:09:04,300
...صحيح

98
00:09:04,780 --> 00:09:05,980
أجل

99
00:09:06,880 --> 00:09:09,700
أشعر بالوحدة على ما أعتقد

100
00:09:13,250 --> 00:09:14,380
...أوروي

101
00:09:16,790 --> 00:09:17,960
...أوبّا

102
00:09:20,450 --> 00:09:21,360
...ميا

103
00:09:23,310 --> 00:09:24,660
أعترف

104
00:09:25,380 --> 00:09:27,930
قتلتُهم جميعاً

105
00:09:28,900 --> 00:09:30,700
...سكّان الجزيرة

106
00:09:31,010 --> 00:09:32,290
...غوغو

107
00:09:32,900 --> 00:09:33,880
...بارونا

108
00:09:34,790 --> 00:09:35,790
...ماتشي

109
00:09:44,600 --> 00:09:46,000
لا داعي للقلق

110
00:09:46,610 --> 00:09:48,200
لا داعي للقلق الآن

111
00:09:49,930 --> 00:09:51,600
هذا هو

112
00:10:04,750 --> 00:10:06,090
من هناك؟

113
00:10:08,030 --> 00:10:08,990
!مهلاً

114
00:10:08,990 --> 00:10:10,690
!مكانك

115
00:10:19,830 --> 00:10:21,170
!فوشي

116
00:10:21,440 --> 00:10:23,890
!لـ-لا، لستُ كذلك

117
00:10:23,890 --> 00:10:25,140
أمعني النّظر

118
00:10:25,140 --> 00:10:26,170
!أنا فتاة

119
00:10:37,570 --> 00:10:45,260
أظنّني أهملتُ الكثير من الأمور التي
لم أفهمها أو أقبلها حتّى الآن

120
00:10:47,340 --> 00:10:49,030
!انظر

121
00:10:49,030 --> 00:10:52,090
هذه هي غابة سارلناين

122
00:10:54,020 --> 00:10:56,310
لا يوجد أحد هنا حقّاً

123
00:10:57,480 --> 00:10:59,890
هل تعتقد أنّه توجد بطاطا في الأرض؟

124
00:10:59,890 --> 00:11:02,460
توجد بطاطا في كلّ مكان في الأرض

125
00:11:03,420 --> 00:11:10,530
قد يأتي يوم يتوجّب عليّ فيه مواجهة
الأشياء التي أهملتُها

126
00:11:27,760 --> 00:11:30,560
أما زال جرحك يؤلمك؟

127
00:11:32,030 --> 00:11:33,460
يمكنك تناول هذا إن أحببت

128
00:11:44,050 --> 00:11:45,670
تقرير بالمُجريات

129
00:11:46,410 --> 00:11:48,730
،خلال الشهر الماضي

130
00:11:48,730 --> 00:11:51,980
راقبتُ رحلة الفتى والمرأة العجوز والحمار

131
00:11:54,330 --> 00:11:57,490
المرأة العجوز، بيوران، قاربت التّسعين عاماً

132
00:11:57,840 --> 00:12:00,500
إنّها ماهرة في اصطياد أسماك النّهر

133
00:12:01,350 --> 00:12:03,190
!أوقد ناراً يا فوشي

134
00:12:03,720 --> 00:12:05,210
عقليّة الفتى فوشي

135
00:12:05,800 --> 00:12:14,580
استمرّت في التغيّر منذ كان يتصرّف كحيوان

136
00:12:15,210 --> 00:12:18,730
ربّما يكون عمره أربعة عشر من المنظور البشريّ

137
00:12:19,330 --> 00:12:22,570
يبدو أنّه أصبح يتمتّع بإدراك كامل للذات

138
00:12:24,170 --> 00:12:27,000
إنّهم على بُعد 500 متر جنوباً

139
00:12:28,340 --> 00:12:30,070
إنّهم هنا يا بيوران

140
00:12:30,070 --> 00:12:31,150
!ماذا؟

141
00:12:31,660 --> 00:12:35,260
هناك بعض القواعد التي نلتزم بها
من أجل البقاء آمنين معاً

142
00:12:35,870 --> 00:12:36,840
!لنهرب

143
00:12:36,090 --> 00:12:41,770
أوّلاً، إذا أتى الطّارقون، نهرب مهما كلّف الأمر

144
00:12:36,840 --> 00:12:37,570
!حسناً

145
00:12:41,770 --> 00:12:43,850
من الخطير محاولة المقاومة

146
00:12:44,710 --> 00:12:49,430
ثانياً، نتجنّب التحوّل إلى حيوانات عشوائيّة

147
00:12:50,010 --> 00:12:51,650
ما هذا؟

148
00:12:50,010 --> 00:12:54,160
لأنّني إذا لم أستطع الحفاظ على إدراكي
،بذاتي وأنا ذلك الحيوان

149
00:12:51,650 --> 00:12:53,570
هل عضّتك علَقة؟

150
00:12:54,160 --> 00:12:56,630
لا أستطيع الاستجابة عندما يصل الطّارقون

151
00:12:57,720 --> 00:12:59,800
تصبح على خير يا فوشي

152
00:12:57,720 --> 00:13:01,460
،ثالثاً، أخلد إلى النّوم بعد بيوران

153
00:12:59,800 --> 00:13:00,620
نعم

154
00:13:01,810 --> 00:13:03,850
وأستيقظ قبل بيوران

155
00:13:04,730 --> 00:13:08,000
ينبغي أن أدوّن كلّ ما هو مهمّ وذلك كي لا أنسى

156
00:13:12,190 --> 00:13:14,850
قضيت كلّ ذلك الوقت وأنت تكتب، والآن تحرقها؟

157
00:13:15,170 --> 00:13:16,340
لا مشكلة

158
00:13:16,340 --> 00:13:18,110
أستطيع استرجاعها متى احتجت ذلك

159
00:13:19,550 --> 00:13:23,820
هل من شيء تريدين فعله أو أكله يا بيوران؟

160
00:13:23,820 --> 00:13:25,610
هل لديك أي أمنيات؟

161
00:13:25,840 --> 00:13:27,360
أمنيات؟

162
00:13:27,780 --> 00:13:29,560
...في الواقع

163
00:13:29,560 --> 00:13:32,700
إذا كان عليّ الاختيار، أودّ أن أصبح أصغر

164
00:13:33,500 --> 00:13:38,230
لو كنتُ أصغر، لاستطعتُ التحرّك بشكل
أفضل، ولاستطعتُ أكل طعام قاسٍ

165
00:13:38,230 --> 00:13:40,670
ولاشتهرتُ بين الرّجال

166
00:13:40,670 --> 00:13:42,210
اشتهرتِ؟

167
00:13:42,210 --> 00:13:46,170
كنتُ حسناء منذ فترة طويلة جداً، مثل رين

168
00:13:48,110 --> 00:13:50,270
هذه أمنية صعبة التّحقيق

169
00:13:50,670 --> 00:13:55,890
فعلتُ كلّ ما أردتُ فعله

170
00:13:55,890 --> 00:14:00,800
كانت حياة مليئة بالكدح والكفاح

171
00:14:01,420 --> 00:14:06,280
لكن رُزقت بحفيد، والآن أتنعّم بالحرّية

172
00:14:07,450 --> 00:14:10,380
كانت حياة مُرضية جدّاً

173
00:14:10,710 --> 00:14:15,860
يبدو أنّ فوشي شعر بشيء نبيل
حيال هذه المرأة العجوز

174
00:14:18,860 --> 00:14:20,300
...مُرضية

175
00:14:20,740 --> 00:14:24,160
أتساءل ما إن كان سينتابني هذا الإحساس يوماً ما

176
00:14:25,840 --> 00:14:31,260
لكن كانت المرأة العجوز في طريقها
لخسارة ذلك الشيء النّبيل

177
00:14:34,860 --> 00:14:35,800
!بيوران

178
00:14:38,090 --> 00:14:41,110
عليكِ أن تتماسكي

179
00:14:41,110 --> 00:14:42,590
!اصمت

180
00:14:42,590 --> 00:14:44,740
!قلتُ لك أنّ ظهري يؤلمني

181
00:14:44,740 --> 00:14:46,440
!أحمق! قمامة

182
00:14:51,690 --> 00:14:54,250
هل خبزتَ بطاطا الفطور؟

183
00:14:54,250 --> 00:14:56,420
أكلناها قبل قليل

184
00:14:56,420 --> 00:15:02,470
!لم آكل

185
00:14:58,560 --> 00:14:59,750
!بلى، أكلتِ

186
00:15:04,270 --> 00:15:07,920
بدأ ذلك التغيّر يطرأ رويداً رويداً

187
00:15:08,160 --> 00:15:10,180
!لماذا تحملني؟

188
00:15:10,180 --> 00:15:12,990
!أتظنّني عديمة النّفع؟

189
00:15:12,990 --> 00:15:13,860
!أنزلني

190
00:15:13,860 --> 00:15:15,230
ماذا عسايّ أن أفعل؟

191
00:15:15,230 --> 00:15:17,100
تسقطين باستمرار عن ظهر الحمار

192
00:15:17,100 --> 00:15:19,610
فهمت! أنا عبء ثقيل، أليس كذلك؟

193
00:15:19,610 --> 00:15:22,830
!أنا عجوز وخرِفة! اتركني واذهب

194
00:15:22,830 --> 00:15:24,980
مُحال أن أفعل ذلك

195
00:15:25,250 --> 00:15:28,450
انتظري! إلى أين أنتِ ذاهبة يا بيوران؟

196
00:15:28,450 --> 00:15:29,320
!إنّه منتصف اللّيل

197
00:15:29,320 --> 00:15:32,540
!سيستهدفنا اليانومي إذا نمنا هنا

198
00:15:32,540 --> 00:15:34,710
لن يأتي اليانومي

199
00:15:35,250 --> 00:15:40,950
لا يبدو أنّ فوشي قد فهمَ سبب حدوث هذا

200
00:15:41,540 --> 00:15:47,440
رغم أنّني أخبرتُه عن طبيعة الأمور، لكنّه لم يقبلها

201
00:15:47,440 --> 00:15:50,810
استمرّ في رعاية المرأة العجوز بصمت

202
00:15:51,460 --> 00:15:53,900
!اقتلني فحسب

203
00:15:53,900 --> 00:15:57,830
!أستحقّ الموت! اقتلني

204
00:15:57,200 --> 00:16:06,780
،شعرَ فوشي وكأنّ هذه المرأة العجوز، بيوران
قد بدأت تختفي شيئاً فشيئاً

205
00:15:57,830 --> 00:15:59,840
!اقتلني

206
00:16:07,190 --> 00:16:12,200
وفوشي بحدّ ذاته تغيّر تدريجيّاً

207
00:16:12,860 --> 00:16:16,570
أصبح يبتسم كثيراً

208
00:16:17,200 --> 00:16:21,810
لعلّ تعابير وجهه المليئة بالنشاط والحيويّة

209
00:16:22,220 --> 00:16:27,570
،نابعة من بهجة اكتساب خبرة جديدة

210
00:16:28,160 --> 00:16:33,630
أو جهد مُستميت لإعالة الضّعفاء الواهنين

211
00:16:35,280 --> 00:16:42,410
فوشي، أنا سعيدة لأنّني التقيتُ بك

212
00:16:50,190 --> 00:16:52,190
سوف تُمطر

213
00:16:53,040 --> 00:16:56,910
هل يمكنك إحضار البطاطا والسّمك
الّذي تركتَه يجفّ؟

214
00:16:57,520 --> 00:16:58,400
حسناً

215
00:17:03,740 --> 00:17:05,270
سأعود في الحال

216
00:17:06,010 --> 00:17:08,270
ابقي في السّرير كي لا تبردي

217
00:17:37,790 --> 00:17:42,730
أنت. يا من يلحق بفوشي

218
00:17:42,730 --> 00:17:44,050
ذو الرّداء الأسود

219
00:17:45,260 --> 00:17:48,830
خذني حالاً

220
00:17:49,570 --> 00:17:53,130
،وإذا استطعت

221
00:17:53,130 --> 00:18:00,580
دعني أولَد من جديد كشيء يمكن له
أن يكون نافعاً لفوشي

222
00:18:01,710 --> 00:18:08,090
إن كان أمره يهمّك، فافعل ما أقوله

223
00:18:17,100 --> 00:18:23,580
خُلِقت روحكِ بحيث لا تكتمل إلّا عندما تكون مع جسدكِ

224
00:18:24,490 --> 00:18:30,540
إذا تغيّر جسدكِ، فما يشكّل هويّتكِ سوف يتغيّر أيضاً

225
00:18:31,560 --> 00:18:33,250
أما زلتِ تتمنّين ذلك؟

226
00:18:35,800 --> 00:18:36,980
أجل

227
00:18:38,640 --> 00:18:39,780
حسنٌ إذاً

228
00:18:41,510 --> 00:18:45,800
أغمضي عينيكِ وتخيّلي ما تريدين أن تصيري إليه

229
00:18:46,310 --> 00:18:51,510
سآتي إليكِ قبل أن تأخذكِ الجنّة

230
00:21:26,180 --> 00:21:30,020
ماذا يُفترض بي أن أفعل الآن؟

231
00:21:32,220 --> 00:21:33,520
عرفت

232
00:21:34,650 --> 00:21:37,880
يجب أن أحرص على ألّا أنسى ما حدث اليوم

233
00:21:38,830 --> 00:21:41,030
فيما يخصّ بيوران

234
00:21:47,160 --> 00:21:50,660
ما حلمك يا فوشي؟

235
00:21:51,390 --> 00:21:55,090
افعل ما تريد فعله مثلما فعلت أنا

236
00:22:02,630 --> 00:22:05,210
شكراً يا بيوران

237
00:22:34,510 --> 00:22:37,970
كنتُ سعيداً أيضاً

238
00:22:44,880 --> 00:22:51,820
لمدّة من الزمن، لم يعد هناك ما أقوله بشأن فوشي

239
00:22:53,170 --> 00:22:57,570
ثمّ مضَتْ عدّة عقود

240
00:23:10,130 --> 00:23:12,040
...هذا مؤلم