1
00:00:02,500 --> 00:00:06,770
شعرت جيل أنّ الفانتازيا
،تختفي من الغابة

2
00:00:07,340 --> 00:00:11,030
...لذلك جمعت كلّ ما لديها من فانتازيا

3
00:00:11,510 --> 00:00:13,580
.لإبقائهم سالمين

4
00:00:15,160 --> 00:00:18,660
ما زالوا صغارًا، لذلك علينا
.أن نحافظ على سلامتهم

5
00:00:19,910 --> 00:00:20,950
ما الأمر؟

6
00:00:20,950 --> 00:00:23,610
.يجدر بي أن أشكرك

7
00:00:23,610 --> 00:00:26,930
ما-ما الّذي تقوله؟
.أنت تحرجني

8
00:00:26,930 --> 00:00:31,260
.كنتُ أوشك على قتل أطفالي

9
00:00:33,250 --> 00:00:38,930
.لكنّ الفانتازيا هنا توشك أن تختفي أيضًا

10
00:00:38,930 --> 00:00:42,220
ألا تستطيع صنع شرنقة جديدة لهم؟

11
00:00:42,220 --> 00:00:47,690
.يتطلّب صنع شرنقة واحدة قرونًا عدّة

12
00:00:47,690 --> 00:00:51,180
لكنّ الوقت لا يعني شيئًا
في هذه الغابة، صحيح؟

13
00:00:51,180 --> 00:00:56,020
.أصبحت هذه الغابة الآن مجاورة لأرض البشر

14
00:00:56,020 --> 00:00:58,700
،لكان ذلك ممكنًا إن كانت جيل موجودة

15
00:00:58,700 --> 00:01:00,710
.لكن لا أستطيع فعل ذلك وحدي

16
00:01:00,710 --> 00:01:02,130
لِمَ لا؟

17
00:01:02,130 --> 00:01:05,210
.تتصرّف بانهزاميّة. هذا ليس من عادتك

18
00:01:05,530 --> 00:01:09,960
.أنا... نصف بشريّ

19
00:02:41,650 --> 00:02:43,670
".المستقبل معك"

20
00:02:47,410 --> 00:02:50,270
نصف... بشريّ؟

21
00:02:51,520 --> 00:02:55,520
.كان والدي مخادعًا حقيقيًّا

22
00:02:55,520 --> 00:03:00,280
.حوّل نفسه وتودّد لنساء بشريّات

23
00:03:00,280 --> 00:03:04,780
.وقد اندهش عندما حبلت إحداهنّ

24
00:03:04,780 --> 00:03:08,230
،سأترككم تتخيّلون التّفاصيل وحدكم

25
00:03:08,230 --> 00:03:11,570
.لكنّ هذا هو سبب تواجدي هنا

26
00:03:11,570 --> 00:03:14,290
،عندما ذاب اليافعون الآخرون

27
00:03:14,290 --> 00:03:18,210
....لم أستطع أن أتبعهم

28
00:03:18,210 --> 00:03:21,050
.لأنّني كنتُ نصف بشريّ

29
00:03:21,050 --> 00:03:25,870
.قضيت وقتًا طويلاً للغاية وحدي

30
00:03:26,290 --> 00:03:30,310
،حاولت الانضمام لإخوتي
.لكن بدون فائدة

31
00:03:30,650 --> 00:03:35,890
،وكلّما ظهر بشريّ
،كانوا يهاجمون بدون تردّد

32
00:03:35,890 --> 00:03:38,070
.ولم يكفّوا عن المجيء

33
00:03:38,070 --> 00:03:41,730
.وحينها قابلت جيل

34
00:03:41,730 --> 00:03:44,830
،نصحتني بالعدول عمّا كنتُ أفعله، وبفضلها

35
00:03:44,830 --> 00:03:49,290
.فقدتُ اهتمامي في مهاجمة البشر

36
00:03:49,290 --> 00:03:56,090
بل وقرّرتُ أني أردت الحصول
.على أطفال جدد

37
00:03:56,090 --> 00:04:02,220
.ولإرضاء جيل، بدأت أقوم بزيارات للقلعة

38
00:04:02,650 --> 00:04:06,650
ثمّ بدأ البشر ينشرون تفسيراتهم الخاصّة

39
00:04:06,650 --> 00:04:09,980
.والمستهترة عن سبب وجودي

40
00:04:09,980 --> 00:04:12,980
...إذًا فأسطورة مرلين العظيم

41
00:04:14,350 --> 00:04:20,130
،كان هنالك وقت، منذ زمن بعيد
.قابلت فيه بعض البشر المولعين بالقتال

42
00:04:20,130 --> 00:04:22,990
،طاردتهم بعيدًا عن هنا

43
00:04:22,990 --> 00:04:29,990
لكنّ البشر الّذين أنقذتهم ظنّوا
.أنّني قمتُ بذلك بغرض حمايتهم

44
00:04:30,410 --> 00:04:33,660
،وبعد فترة من ذلك
حاول بعضهم التّقرّب منّي

45
00:04:33,660 --> 00:04:36,910
.وقالوا أنّهم يريدون الغابة مقابل المال

46
00:04:36,910 --> 00:04:40,660
لكنّ هذه الأرض لم تكن ملكًا
!لأيّ أحد من الأساس

47
00:04:41,100 --> 00:04:45,130
...فقط انظروا كيف تمّ تداول تلك القصّة

48
00:04:45,490 --> 00:04:47,940
،رجل عجوز يمتطي ظبيًا

49
00:04:47,940 --> 00:04:53,470
ويقول كلامًا نبيلاً مثل
،"لن أقسّم هذه الأرض"

50
00:04:53,470 --> 00:04:55,890
!وكأنّه كان يحميها

51
00:04:56,980 --> 00:05:00,480
تقصد أنّ كلّ القصص الّتي توارثوها
كانت سوء فهم فحسب؟

52
00:05:00,480 --> 00:05:03,170
.بالتّحديد

53
00:05:03,170 --> 00:05:07,990
.كبداية، اسمي ليس مرلين
!بل هو ميردين

54
00:05:07,990 --> 00:05:10,930
!حتّى اسمه قد تمّ تذكّره بشكل خاطئ

55
00:05:10,930 --> 00:05:14,500
لا نستطيع الآن أن نقسم
!باسم مرلين

56
00:05:14,500 --> 00:05:19,330
،أنا بارع في جعل الحجارة والأشجار تكبر

57
00:05:19,330 --> 00:05:24,260
لكن لا أستطيع خلق شيء به حياة
.قادرة على الاعتناء بأطفالي

58
00:05:26,090 --> 00:05:30,440
حملتني جيل سابقًا وكأنّني
.كنتُ واحدًا من أطفالها

59
00:05:30,440 --> 00:05:33,250
اسمع يا مير، هل تعتقد
أنّ العكس قد ينجح أيضًا؟

60
00:05:34,520 --> 00:05:38,390
العكس؟ تقصد أن تجعل
بشريّة تحملهم؟

61
00:05:38,390 --> 00:05:40,490
نعم. أيبدو هذا غريبًا؟

62
00:05:40,490 --> 00:05:42,370
!ليس غريبًا

63
00:05:42,370 --> 00:05:47,650
،إن كان مير نصف بشريّ
!فذلك يعني أنّ أطفاله رُبع بشر

64
00:05:48,050 --> 00:05:49,310
—لا يعقل أنّ

65
00:05:49,990 --> 00:05:52,910
.في الحقيقة، قد تكونون على حقّ

66
00:05:53,370 --> 00:05:58,420
لكن على تلك البشريّة أن تتحمّل
.كمّيّات هائلة من الفانتازيا

67
00:05:58,890 --> 00:06:03,420
تقصد أنّه إن كانت تلك البشريّة ساحرة
قويّة جدًّا، فذلك سينفع؟

68
00:06:03,420 --> 00:06:07,170
تلك البشريّة عليها أن تحتوي
.هذه الشّرنقة داخل جسدها

69
00:06:07,170 --> 00:06:12,180
ولن يكون من السّهل العثور
.على ساحرة ببطن بهذا الكبر

70
00:06:12,180 --> 00:06:15,430
!لا تقلق! أنا أعرف واحدة

71
00:06:17,300 --> 00:06:17,940
...نعم

72
00:06:18,940 --> 00:06:23,440
.وستعتبر تلك السّاحرة هذا شرفًا لها

73
00:06:33,450 --> 00:06:34,830
!أنت موهوب

74
00:06:34,830 --> 00:06:37,080
كنّا لنصبح أفضل صديقين
!إن تغيّرت الأزمان

75
00:06:37,080 --> 00:06:40,220
!أنت ساذج! سيكون ذلك مستحيلاً

76
00:06:40,220 --> 00:06:43,170
.سأؤجّل هذه المعركة. أحسنت القتال

77
00:06:43,170 --> 00:06:44,420
!انتظر

78
00:06:44,420 --> 00:06:46,400
!لن أنتظر

79
00:06:46,400 --> 00:06:48,870
!في الحقيقة، لا أستطيع الانتظار

80
00:06:48,870 --> 00:06:51,420
!أنا أوشك... أن أبلّل نفسي

81
00:06:51,950 --> 00:06:53,410
لماذا أتى إلى هنا من الأساس؟

82
00:06:53,410 --> 00:06:55,180
!أيّها السّيّد غوليس، أنت بخير

83
00:06:55,180 --> 00:06:58,040
.تمّ اعتبارك مشتبهًا به

84
00:06:58,040 --> 00:06:59,770
هلاّ أتيت معنا؟

85
00:07:00,430 --> 00:07:03,720
،يا مرلين العظيم
ما الّذي سيحلّ بهذه البلاد؟

86
00:07:03,720 --> 00:07:06,190
هل تملك مستقبلاً؟

87
00:07:07,300 --> 00:07:11,800
.كِلا الجانبين ينسحبان
.يبدو أنّ الأمور قد هدأت

88
00:07:11,800 --> 00:07:15,450
هل كنتَ تعرف أنّ هذا سيحدث
أيّها القائد دراغونوف؟

89
00:07:15,450 --> 00:07:19,660
لا. عندما كان الجميع يواجه
...ذلك الوحش

90
00:07:19,660 --> 00:07:22,460
.ظننتُ أنّ أمرنا قد انتهى

91
00:07:23,460 --> 00:07:28,960
،لكن إن كنّا قد أدرنا ظهورنا
.لكان موتنا أكثر مأساويّة

92
00:07:28,960 --> 00:07:30,990
...أيّها القائد

93
00:07:30,990 --> 00:07:32,800
.لنغيّر مسارنا

94
00:07:32,800 --> 00:07:36,470
سنستغلّ هذه الفرصة
.لإبعاد سفينتنا عن هنا

95
00:07:36,470 --> 00:07:38,890
حا-حاضر. إلى أين سنتّجه؟

96
00:07:38,890 --> 00:07:40,540
.إلى بوم بالطّبع

97
00:07:40,540 --> 00:07:43,080
هل بإمكاننا العودة فعلاً؟

98
00:07:43,080 --> 00:07:45,590
.لقد خالفنا الأوامر مرّات عدّة

99
00:07:45,590 --> 00:07:48,730
.وأكيد أنّه لن يوجد أيّ مبرّر لأفعالها

100
00:07:48,730 --> 00:07:51,490
.سأهتمّ بذلك الأمر

101
00:07:51,490 --> 00:07:56,400
في تلك الحالة، ستكون فرقتنا
.مشغولة لبعض الوقت

102
00:07:56,400 --> 00:07:58,990
.لا تقسو علينا كثيرًا رجاءً

103
00:07:58,990 --> 00:08:01,850
،إن أراد أيّ أحد الانسحاب
.فالآن هو الوقت المناسب

104
00:08:01,850 --> 00:08:03,010
!طبعًا لا

105
00:08:03,010 --> 00:08:06,630
سـ-سأكون دائمًا أحد رجالك
!أيّها القائد دراغونوف

106
00:08:09,140 --> 00:08:11,250
،مهما بلغ مستوى نفوذ سلطتنا

107
00:08:11,250 --> 00:08:14,740
فإنّ محاولة استعباد المصابين
.مسألة لا يمكنني غضّ النّظر عنها

108
00:08:15,230 --> 00:08:18,760
عليّ أن أعرف ما هي نوايا
.الجنرال تورك الحقيقيّة

109
00:08:23,020 --> 00:08:29,020
...القلعة التّحارضيّة] ما رآه سِث عندما كان ذاهبًا للقاء ديابال]
بدا كبقايا معركة حامية. أين هو ديابال...؟

110
00:08:35,210 --> 00:08:38,080
صانعة معجزات؟

111
00:08:38,080 --> 00:08:41,410
.علينا أن نتولّى أمرك بحذر شديد

112
00:08:42,650 --> 00:08:43,850
.هذا مهين

113
00:08:44,340 --> 00:08:47,930
.لكنّ تفكير الجنرال تورك عميق

114
00:08:47,930 --> 00:08:50,380
.لم يسمح لشيء كهذا أن يزعزعه

115
00:08:56,050 --> 00:09:01,630
مرّت ثلاثة أيّام مذ أن قاطعت
وحدة التّفتيش مراسمنا

116
00:09:01,630 --> 00:09:05,630
.وجلبت الكوارث لهذه البلاد

117
00:09:06,590 --> 00:09:11,180
،فقدنا العديد من شعبنا
.وجزءًا كبيرًا من بلادنا بحدّ ذاتها

118
00:09:11,180 --> 00:09:15,750
.ولكن، كاسلين مرلين ستتعافى

119
00:09:15,750 --> 00:09:18,170
.فدعونا نرثي أمواتنا

120
00:09:18,820 --> 00:09:21,580
.ولنضمّد جراحنا

121
00:09:21,580 --> 00:09:26,350
.ونحتفل بهذا اليوم إلى الأبد

122
00:09:27,080 --> 00:09:30,710
اليوم الّذي تكبّدت فيه
سيفاندير ضربة مؤلمة

123
00:09:30,710 --> 00:09:35,340
!لأولئك المفتّشين المتغطرسين

124
00:09:36,350 --> 00:09:40,130
!تحيا الملكة

125
00:09:41,350 --> 00:09:46,710
.ومع ذلك، لم نكن مستعدّين لخوض المعارك

126
00:09:47,350 --> 00:09:50,610
لولا مساعدة أولئك الّذين
،أتوا من خارج المملكة

127
00:09:50,610 --> 00:09:53,860
،وتدخّل مرلين بحدّ ذاته

128
00:09:53,860 --> 00:09:58,610
.لكانت سيفاندير الآن جاثية على ركبتيها

129
00:09:58,610 --> 00:10:03,120
زرعت مخطّطات العدوّ بذور
الشّكّ في قلوب شعبنا

130
00:10:03,600 --> 00:10:07,120
ومنحوا عدوّنا السّيطرة
.على مواطنينا وفرساننا

131
00:10:07,120 --> 00:10:09,540
.كان ذلك عملاً ماكرًا وذكيًّا

132
00:10:10,780 --> 00:10:14,970
...لو لم أدر ظهري لعاداتنا لهذا الحدّ

133
00:10:14,970 --> 00:10:20,140
لو أصغيتُ لكم جميعًا وتنازلت
...لنتشارك آراءنا

134
00:10:20,260 --> 00:10:23,640
لما كان لهذا المؤامرة
.أن تحدث من الأساس

135
00:10:23,640 --> 00:10:28,640
،وفوق كلّ ذلك، لو لم نُخفِ لعناتنا

136
00:10:28,640 --> 00:10:34,150
ربّما ما كان ليأتي أولئك الّذين
.تآمروا للتّضحية بمملكتنا

137
00:10:34,150 --> 00:10:40,160
،يا شعب سيفاندير
!الآن هو الوقت المناسب لننزع أقنعتنا

138
00:10:47,910 --> 00:10:49,230
ما الّذي يحدث؟

139
00:10:49,230 --> 00:10:50,900
!إنّها تلك المتدرّبة أوكوهو

140
00:10:56,020 --> 00:10:57,110
...أنا

141
00:10:57,810 --> 00:11:00,430
.أملك علامة خلف أذني

142
00:11:01,630 --> 00:11:05,930
،إن لمسها شخص ما
،فلا يعود لي خيار سوى إطاعته

143
00:11:05,930 --> 00:11:08,690
ولا أتذكّر أيّ شيء يحدث
.في تلك الحالة

144
00:11:16,660 --> 00:11:19,110
.لديّ سِتُّ حلمات

145
00:11:19,550 --> 00:11:22,450
...اثنتان في مكانهما المعتاد

146
00:11:22,450 --> 00:11:25,420
مـ-مهلاً، هل يجدر بك الإفصاح
عن ذلك فعلاً؟

147
00:11:25,420 --> 00:11:28,700
!برانغوار! أين الأربعة الأخرى؟

148
00:11:28,700 --> 00:11:30,610
!يراودنا الفضول الآن

149
00:11:30,610 --> 00:11:32,830
!لا-لا يمكنني إخباركم بذلك

150
00:11:32,830 --> 00:11:34,120
تحت لحيتك؟

151
00:11:34,120 --> 00:11:35,090
!لن أقول

152
00:11:35,090 --> 00:11:37,840
.شعري أزرق في الحقيقة

153
00:11:37,840 --> 00:11:42,090
.عفوًا يا ملكتي، أعتقد أنّك اختلقتِ ذلك توًّا

154
00:11:43,590 --> 00:11:46,350
!أخبرينا ما هي لعنتك أيّتها الملكة

155
00:11:46,350 --> 00:11:48,310
.ستعرفون في وقت قريب

156
00:11:48,310 --> 00:11:50,610
!نريد سماعها منك مباشرة

157
00:11:50,610 --> 00:11:53,910
...يا إلهي... إنّ لعنتي في الحقيقة

158
00:11:54,380 --> 00:11:58,600
!هي أنّني أزداد جمالاً كلّ يوم

159
00:11:58,600 --> 00:12:00,210
!نعم، أصدّق ذلك

160
00:12:00,210 --> 00:12:01,740
!كاذبة

161
00:12:01,740 --> 00:12:05,070
!أتقول أنّ الملكة لا تزداد جمالاً كلّ يوم؟

162
00:12:05,070 --> 00:12:07,140
!لكنّ تلك ليست لعنتها

163
00:12:07,140 --> 00:12:08,620
!وإن يكن

164
00:12:08,620 --> 00:12:12,250
!شعري... أقسى من الفولاذ

165
00:12:12,250 --> 00:12:15,810
!لديّ مخالب عوض الأسنان

166
00:12:15,810 --> 00:12:19,830
!لديّ عُنقان، ولكن رأس واحد فقط

167
00:12:19,830 --> 00:12:22,260
!لديّ منخاران، ولكن أنف واحد

168
00:12:22,260 --> 00:12:24,130
!ذلك عاديّ

169
00:12:24,130 --> 00:12:26,220
!حسنًا، حسنًا

170
00:12:26,220 --> 00:12:28,390
!لنؤجّل الاعترافات لوقت لاحق

171
00:12:28,390 --> 00:12:32,040
عـ-عفوًا يا صاحبة الجلالة... هلّي أن أسألك؟

172
00:12:32,040 --> 00:12:34,390
أيعقل أنّك... ستنجبين قريبًا؟

173
00:12:34,390 --> 00:12:38,650
.يا إلهي. لا أستطيع إخفاء أيّ شيء عنكم

174
00:12:38,650 --> 00:12:40,650
لكن أليس الأمر مفاجئًا؟

175
00:12:40,650 --> 00:12:42,150
من الأب؟

176
00:12:42,150 --> 00:12:45,190
.يريد الأب أن يظلّ مجهولاً

177
00:12:45,740 --> 00:12:48,180
،إنّه رجل قصير وملتحٍ

178
00:12:48,180 --> 00:12:51,340
.وحارس فخور لسيفاندير

179
00:12:51,830 --> 00:12:54,580
.إنّه يعيش في قلوبكم جميعًا

180
00:12:56,570 --> 00:12:59,420
هل لديه حلمات تحت لحيته؟

181
00:12:59,420 --> 00:13:03,300
!أبله! هل تقترح أنّي قد أتطاول على الملكة؟

182
00:13:03,790 --> 00:13:05,430
أما كنتَ لتفعل؟

183
00:13:05,430 --> 00:13:08,140
...أعني طبعًا، إن تسنّت لي الفرصة

184
00:13:08,140 --> 00:13:09,510
...مهلاً

185
00:13:09,510 --> 00:13:12,560
...ما-ما أقصده هو أنّني

186
00:13:12,560 --> 00:13:15,720
!يحمرّ برانغوار خجلاً أكثر فأكثر

187
00:13:15,720 --> 00:13:16,790
!اخرس

188
00:13:16,790 --> 00:13:20,550
أوّلاً، كفّوا عن التّحدّث مع الملكة
!بقلّة احترام هكذا

189
00:13:20,550 --> 00:13:21,710
...وثانيًا

190
00:13:21,710 --> 00:13:23,820
...تعلمون

191
00:13:23,820 --> 00:13:26,070
!ماذا؟ لا نستطيع سماعك

192
00:13:26,070 --> 00:13:27,700
...ثانيًا

193
00:13:28,190 --> 00:13:30,580
.يا جلالتك، لديّ طلب أطلبه منك

194
00:13:30,580 --> 00:13:32,120
ما هو؟

195
00:13:32,120 --> 00:13:36,030
أودّ أن أسحب تحفّظي الّذي أعلنتُ
.عنه خلال مراسم التّرسيم

196
00:13:37,330 --> 00:13:40,780
.إنّه يتعلق بتوصية المتدرّبة أوكوهو

197
00:13:42,690 --> 00:13:47,740
.للأسف، اختار كلّ الفرسان وريثهم

198
00:13:47,740 --> 00:13:49,470
.لكنّني لم أختر بعد

199
00:13:49,470 --> 00:13:53,970
ماذا؟ سـ-ستجعلني... وريثتك؟

200
00:13:53,970 --> 00:13:57,910
.يا لها من مفاجأة يا برانغوار

201
00:13:57,910 --> 00:13:59,230
.لكن لا يمكنك ذلك

202
00:14:00,480 --> 00:14:05,360
كانت هي من كشفت السّتار
!عن مؤامرة الطّيف

203
00:14:05,360 --> 00:14:09,740
!كانت هي من واجهت التّجار البارونات وحدها

204
00:14:09,740 --> 00:14:14,120
كانت هي من طردتهم خارج البلاد
!غير مبالية للعنتها

205
00:14:14,120 --> 00:14:19,880
جيزوني أوكوهو أقوى بكثير
!من أيّ جيزوني سبق ورأيت

206
00:14:19,880 --> 00:14:25,510
لكنّ أوكوهو عارضت أوامرك
خلال المعركة، صحيح؟

207
00:14:25,510 --> 00:14:27,970
!فعلت ذلك بغرض حماية المزارعين

208
00:14:27,970 --> 00:14:30,390
.وصفعت ملكتها على وجهها

209
00:14:30,390 --> 00:14:33,010
!فعلت ذلك لترجعك إلى رشدك

210
00:14:33,010 --> 00:14:37,780
،وخلال مراسم التّرسيم
.حاولت دفعك لتتمرّد ضدّي

211
00:14:37,780 --> 00:14:39,770
!قامت بذلك من أجل الشّعب

212
00:14:40,080 --> 00:14:43,150
.سبق واتّخذت قراري

213
00:14:43,150 --> 00:14:47,150
إنّها تملك موهبة لا تظهر
!إلاّ مرّة كلّ عدّة قرون

214
00:14:47,150 --> 00:14:49,190
!برانغوار

215
00:14:49,190 --> 00:14:53,990
عار عليك لمحاولتك جعل أوكوهو
!واحدة من فرسان مرلين

216
00:14:53,990 --> 00:14:56,910
!هذا عار لشعب سيفاندير

217
00:14:59,920 --> 00:15:02,730
.جلالتها على حقّ

218
00:15:02,730 --> 00:15:06,800
.أخطأت كثيرًا ولا أستحقّ الغفران

219
00:15:06,800 --> 00:15:08,270
...سيّد برانغوار

220
00:15:08,920 --> 00:15:12,310
.آسفة لأنّني لن أستطيع ردّ جميلك

221
00:15:12,310 --> 00:15:14,430
ما هذا الهراء؟

222
00:15:14,780 --> 00:15:19,180
.كنتُ أراقب تصرّفاتك منذ وقت طويل

223
00:15:19,180 --> 00:15:23,860
.لم تكوني يومًا مؤهّلة لتصبحي فارسة

224
00:15:25,520 --> 00:15:26,670
...أنت

225
00:15:27,870 --> 00:15:30,950
.شخص يستحقّ أن يكون ملكة

226
00:15:32,200 --> 00:15:35,370
!ماذا؟

227
00:15:38,590 --> 00:15:42,540
.ليس فقط للإنجازات الّتي ذكرها برانغوار

228
00:15:42,540 --> 00:15:44,420
،ففي مراسم التّرسيم

229
00:15:44,420 --> 00:15:48,880
.وقفتِ في وجهي من أجل صالح الشّعب

230
00:15:48,880 --> 00:15:52,630
.لكن... بدوتِ غاضبة جدًّا

231
00:15:53,020 --> 00:15:54,970
.كنت أمزح فحسب

232
00:15:54,970 --> 00:15:57,390
!أحببتُك جدًّا لدرجة أنّني أردت أكلك

233
00:15:57,860 --> 00:16:01,940
إن لم أجعل شخصًا مؤهّلاً
،مثلك وريثًا لي

234
00:16:01,940 --> 00:16:04,930
.لكنتُ قد خسرت ماء وجهي بالكامل

235
00:16:04,930 --> 00:16:08,400
حتّى المرايا كانت لترفض
.أن تظهر انعكاسي عليها

236
00:16:10,900 --> 00:16:15,430
يا شعب سيفاندير، أقدّم لكم
...ملكتكم المستقبليّة

237
00:16:15,430 --> 00:16:17,530
!ووريثتي

238
00:16:17,530 --> 00:16:19,210
!الأميرة أوكوهو

239
00:16:29,800 --> 00:16:31,550
!مرحى لأوكوهو

240
00:16:31,930 --> 00:16:34,050
!تحيا الأميرة

241
00:16:34,050 --> 00:16:36,410
!إنّها خجلة! كم هذا ظريف

242
00:16:36,410 --> 00:16:38,730
!مرحى للأميرة أوكوهو الظّريفة

243
00:16:38,730 --> 00:16:40,640
!تحيا الفتاة الجميلة

244
00:16:40,640 --> 00:16:43,770
!كفى! لا تكونوا فظّين مع أميرتي

245
00:16:43,770 --> 00:16:46,820
!يحيا برانغوار ذو الحلمات السّتّة

246
00:16:46,820 --> 00:16:48,820
!كفّوا عن ذلك

247
00:16:48,820 --> 00:16:51,330
.ما عدت أعرف ما الّذي يحدث

248
00:16:51,330 --> 00:16:53,450
،لا أدري ما الّذي حدث

249
00:16:53,860 --> 00:16:57,890
لكنّك نضجتِ بشكل جميل
.في هذه الأسابيع الأخيرة

250
00:16:57,890 --> 00:17:00,880
،توقّفتِ عن القلق بشأن آراء مرؤوسيك

251
00:17:00,880 --> 00:17:03,330
وتخلّيتِ عن الاعتراف الّذي
،كنتِ تسعين خلفه

252
00:17:03,330 --> 00:17:06,580
.وتغلّبتِ على نفسك

253
00:17:08,700 --> 00:17:11,090
—كلّ ذلك بفضل

254
00:17:11,090 --> 00:17:12,340
!قلتُ تراجعوا

255
00:17:11,090 --> 00:17:12,340
!مهلاً، مهلاً، مهلاً

256
00:17:12,340 --> 00:17:14,840
مهلاً، أين سِث؟

257
00:17:30,930 --> 00:17:33,110
الملكة المستقبليّة؟

258
00:17:33,110 --> 00:17:36,060
.ذلك قرار مذهل

259
00:17:36,060 --> 00:17:38,420
،ربّما لا تتذكّر أوكوهو هذا

260
00:17:38,420 --> 00:17:41,370
.ولكنّها كانت تأتي للغابة كثيرًا كطفلة

261
00:17:41,370 --> 00:17:44,950
،إن كان جميع البشر مثلها

262
00:17:44,950 --> 00:17:49,880
.أنا واثق أنّهم كانوا ليحاولوا حماية الغابة

263
00:17:49,880 --> 00:17:52,630
.لكنّ الأوان قد فات الآن

264
00:17:52,630 --> 00:17:55,200
.قد لا يكون كذلك

265
00:17:55,200 --> 00:17:57,490
،عندما سيولد أطفالك في النّهاية

266
00:17:57,490 --> 00:18:02,390
ربّما سيكونون قادرين على استعمال
.قواهم لإعادة بناء غابة كايلت

267
00:18:03,990 --> 00:18:05,890
.لكنّ جيل قد رحلت

268
00:18:05,890 --> 00:18:08,170
،لو لم آتِ إلى هنا

269
00:18:08,790 --> 00:18:12,020
ربّما ما كانت وحدة التّفتيش
.لتأتي إلى هنا أيضًا

270
00:18:12,860 --> 00:18:13,810
.أنا آسف

271
00:18:13,810 --> 00:18:15,900
.لا تلم نفسك

272
00:18:15,900 --> 00:18:17,830
.كان ليحدث هذا في كلّ الأحوال

273
00:18:17,830 --> 00:18:20,990
،إضافة لذلك، لو لم توقفني

274
00:18:20,990 --> 00:18:23,660
.لكنتُ قد دمّرتُ كلّ شيء

275
00:18:24,860 --> 00:18:29,290
.ولفقدتُ حينها أطفالي أيضًا

276
00:18:30,920 --> 00:18:32,950
!لا تكن عبوسًا هكذا

277
00:18:32,950 --> 00:18:37,450
حسنًا!سأعزف لك أغنية
!ألّفتها من أجل جيل

278
00:18:37,450 --> 00:18:40,550
!"سمّيتُه "ألف مرّة على الأقلّ

279
00:18:40,550 --> 00:18:43,810
—مهلاً يا مير! لم أقل أنّني أريد سماع

280
00:18:43,810 --> 00:18:47,350
!يا جيل

281
00:18:47,350 --> 00:18:50,490
،عندما أتّكئ على صدرك

282
00:18:50,490 --> 00:18:55,820
!تمرّ القرون وكأنّها ساعات

283
00:18:56,530 --> 00:19:04,940
إن كان هذا الوقت الّذي مرّ
،هو أبديّة للبشر

284
00:19:04,940 --> 00:19:11,510
أتمنّى لو أنّ علاقتي بك
.قد دامت للأبد أيضًا

285
00:19:11,510 --> 00:19:16,450
...ألف مرّة على الأقلّ

286
00:19:24,710 --> 00:19:29,210
سِث، هذا حجر الماغوزيا
.الّذي كنتَ تبحث عنه

287
00:19:29,210 --> 00:19:31,350
أهذا فعلاً كلّ ما كنتَ تريده؟

288
00:19:31,350 --> 00:19:33,380
!نعم! شكرًا لك

289
00:19:33,380 --> 00:19:35,460
.سيكون غريم سعيدًا بها

290
00:19:35,460 --> 00:19:36,860
.وهذه من أجلك يا ميلي

291
00:19:37,710 --> 00:19:42,360
.عمل عليها أفضل حرفيّي المملكة بكلّ جدّ

292
00:19:42,360 --> 00:19:45,110
.شكرًا لك يا جلالة الملكة

293
00:19:45,110 --> 00:19:46,120
.لا داعي لذلك

294
00:19:46,600 --> 00:19:49,120
.إنّك تجعلين الأجواء كئيبة جدًّا

295
00:19:49,500 --> 00:19:52,620
.لا داعي لهذه الرّسميّات فيما بيننا

296
00:19:52,620 --> 00:19:54,880
وماذا عنّي؟ هل سأحصل على أيّ شيء؟

297
00:19:54,880 --> 00:19:57,120
.بالطّبع يا دوك

298
00:19:57,120 --> 00:20:01,280
.هذا عربون شكر لإنقاذك بلادنا من أزمتها

299
00:20:01,280 --> 00:20:04,350
أنا أمنحك اللّقب الشّرفيّ
.كفارس لهذه المملكة

300
00:20:04,350 --> 00:20:08,640
،والآن، أينما رحلت وارتحلت
.فستكون فارسًا ساحرًا

301
00:20:08,640 --> 00:20:12,140
...عفوًا... ربّما شيء آخر

302
00:20:12,140 --> 00:20:14,650
!لكنّ هذا رائع يا دوك! أصبحتَ فارسًا

303
00:20:14,650 --> 00:20:17,500
...نعم... ولكن

304
00:20:17,500 --> 00:20:20,980
ربّما بعض الذّهب ليساعدني
...على سدّ ديوني

305
00:20:20,980 --> 00:20:22,150
أممكن؟

306
00:20:22,150 --> 00:20:24,060
.لا يمكنني فعل ذلك

307
00:20:24,540 --> 00:20:28,150
.علينا إعادة بناء هذه المدينة

308
00:20:28,670 --> 00:20:32,160
.لكنّ برانغوار لديه هديّة صغيرة لك أيضًا

309
00:20:35,220 --> 00:20:37,170
ما هذه؟ حصاة؟

310
00:20:37,580 --> 00:20:39,670
.إنّه درع بِن دريغ

311
00:20:42,230 --> 00:20:44,290
...إن وجب عليك القتال في وقت ما

312
00:20:44,290 --> 00:20:46,500
!فستحتاج للقتال بهذا الدّرع

313
00:20:46,500 --> 00:20:48,430
!أسمع أصواتًا غريبة صادرة من دوك

314
00:20:48,430 --> 00:20:50,890
!أهي الحجارة الّتي بلعتُها؟

315
00:20:50,890 --> 00:20:54,420
.أنت الوحيد القادر على استعماله

316
00:20:54,420 --> 00:20:55,610
.خذه

317
00:20:55,610 --> 00:20:59,400
.أريدك أن تحمي الأميرة من الآن فصاعدًا

318
00:20:59,400 --> 00:21:01,830
.لقد جهّزنا تنّينك

319
00:21:03,150 --> 00:21:05,660
ماذا؟ ما الّذي يحدث؟

320
00:21:05,660 --> 00:21:09,260
،شعبي هو كلّ ما أفكّر فيه دائمًا

321
00:21:09,260 --> 00:21:14,030
لكنّني كنت عاجزة عن إدراك
.أنّ هنالك مؤامرة تُحاك

322
00:21:14,540 --> 00:21:18,670
لم يكن إدراكي واسعًا بما يكفي
.لرؤية كلّ ما كان يحدث

323
00:21:18,670 --> 00:21:21,670
.أوكوهو، اذهبي معهم

324
00:21:22,150 --> 00:21:25,360
،اذهبي وشاهدي هذا العالم الواسع بالكامل

325
00:21:25,360 --> 00:21:27,670
.وذلك لكي لا تقترفي نفس أخطائي

326
00:21:31,270 --> 00:21:33,330
!حسنًا، سنغادر الآن

327
00:21:33,330 --> 00:21:35,180
!شكرًا على كلّ شيء

328
00:21:35,180 --> 00:21:37,440
!اعتني بنفسك يا جلالة الملكة

329
00:21:37,440 --> 00:21:40,750
.بالطّبع. وأنت أيضًا يا صاحبة السّموّ

330
00:21:42,130 --> 00:21:43,690
...فلتحظى سيفاندير

331
00:21:43,690 --> 00:21:45,190
!بمستقبل مشرق

332
00:21:46,200 --> 00:21:47,830
!اسمعوا

333
00:21:47,830 --> 00:21:51,380
،إن لمس أيّ أحد ولو شعرة من الأميرة

334
00:21:51,380 --> 00:21:53,930
!فسيكون الإعدام هو عقابهم

335
00:21:53,930 --> 00:21:55,960
!وهذا ينطبق عليكم أيضًا

336
00:21:55,960 --> 00:21:59,780
ومن الأفضل لك أن تعتني
!بما في بطن الملكة

337
00:21:59,780 --> 00:22:02,680
!أولئك الصّغار أشبه بأشقّاء لي

338
00:22:02,680 --> 00:22:04,210
!كن حذرًا معهم

339
00:22:04,210 --> 00:22:07,670
لماذا لا يستطيع أيّ منهما أن يقول
أنّه يعتمد على الآخر ببساطة؟

340
00:22:08,470 --> 00:22:11,720
،قد يكونون مثل أشقّاء لك

341
00:22:12,100 --> 00:22:15,730
.لكن لا تنسَ أنّهم أطفالي

342
00:22:15,730 --> 00:22:18,270
.واصل مسيرك، ولا تقلق حيال أيّ شيء

343
00:22:18,270 --> 00:22:20,480
.سأقوم برعايتهم

344
00:22:37,330 --> 00:22:40,180
!هذه أوّل مرّة أغادر فيها سيفاندير

345
00:22:44,030 --> 00:22:45,930
إنّها مثلك تمامًا عندما
!تقابلنا أوّل مرّ يا سِث

346
00:22:45,930 --> 00:22:46,840
ماذا؟

347
00:22:46,840 --> 00:22:49,090
أهكذا كنت أنا؟

348
00:22:49,090 --> 00:22:52,720
.نعم، لكنّك تغيّرت كثيرًا

349
00:22:53,040 --> 00:22:54,230
.وأنت أيضًا

350
00:22:54,970 --> 00:22:56,830
،الجميع ينضجون

351
00:22:56,830 --> 00:22:59,100
.وذلك عن طريق تخطّي صعاب عدّة

352
00:22:59,810 --> 00:23:02,060
.أنا سعيد لقدومك لمساعدتي

353
00:23:02,060 --> 00:23:05,240
،لو كنتُ بمفردي
.لفقدت السّيطرة على نفسي

354
00:23:05,240 --> 00:23:08,610
.لم آتِ لأساعدك فقط

355
00:23:08,610 --> 00:23:10,170
.أعلم ذلك

356
00:23:10,740 --> 00:23:12,120
.لكن شكرًا لك

357
00:23:12,430 --> 00:23:13,850
.شكرًا لك أيضًا

358
00:23:13,850 --> 00:23:16,120
سأواصل الاعتماد عليك
!من الآن فصاعدًا يا سِث

359
00:23:16,540 --> 00:23:18,090
.تحيّاتي

360
00:23:18,620 --> 00:23:21,420
!يا إلهي، لا تظهر فجأة هكذا

361
00:23:21,420 --> 00:23:23,520
.صحيح. خذ

362
00:23:23,520 --> 00:23:27,430
.حجر ماغوزيا. شكرًا لك

363
00:23:27,430 --> 00:23:30,130
.كان من الصّعب الحصول عليه

364
00:23:30,910 --> 00:23:33,510
.لذلك أخبرني بشيء ما عن نفسك

365
00:23:33,830 --> 00:23:35,640
.سيفكّر غريم في الأمر

366
00:23:35,640 --> 00:23:39,990
ومع ذلك، حتّى أرشيف القلعة
.لم يضمّ معلومات عن راديان

367
00:23:39,990 --> 00:23:42,090
.كلّ ذلك كان مضيعة للوقت

368
00:23:42,090 --> 00:23:43,730
عمّ تتحدّث؟

369
00:23:43,730 --> 00:23:46,750
!لقد اكتسبتَ صديقة مذهلة أثناء ذلك

370
00:23:46,750 --> 00:23:47,400
!صحيح

371
00:23:47,400 --> 00:23:51,220
!والآن، فلنبدأ مغامرتنا يا رفاق

372
00:23:51,790 --> 00:23:53,410
.أنت متحمّسة جدًّا

373
00:23:53,410 --> 00:23:54,700
!بالطّبع

374
00:23:54,700 --> 00:23:58,210
!حتّى أنّني سأجد راديان من أجلكم

375
00:23:58,210 --> 00:24:00,750
!فلنذهب ونرى أماكن مختلفة

376
00:24:02,060 --> 00:24:04,250
!طلباتك أوامر أيّتها الأميرة

377
00:24:04,560 --> 00:24:05,750
!أجل

378
00:24:08,250 --> 00:24:10,730
هل أستطيع الذّهاب للمنزل فحسب؟

379
00:24:10,730 --> 00:24:11,920
!كلاّ

380
00:24:11,920 --> 00:24:13,260
لماذا؟

381
00:24:14,970 --> 00:24:17,010
!حسنًا! فلننطلق يا رفاق

382
00:24:17,370 --> 00:24:20,030
!انتظري فحسب يا راديان

383
00:24:25,020 --> 00:24:30,250
النّهاية