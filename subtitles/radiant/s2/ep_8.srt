1
00:00:01,450 --> 00:00:05,870
يعيش رجل غامض عميقًا
.داخل قلعة كاسلين مرلين

2
00:00:06,570 --> 00:00:09,980
يتحكّم هو وظلّاه المريبين
.في النّمسيس الطّيفيّ

3
00:00:09,980 --> 00:00:12,490
ما الّذي يخطّطون له يا ترى؟

4
00:00:13,540 --> 00:00:17,830
لا يدرك سِث أيّ شيء عن الوضع
.الخطير الّذي هو فيه الآن

5
00:01:51,050 --> 00:01:52,810
".سِث في غابة الزّمن"

6
00:02:00,010 --> 00:02:01,150
هرب؟

7
00:02:01,150 --> 00:02:05,260
مستحيل! بعد ما تكبّده من ديابال؟

8
00:02:05,260 --> 00:02:07,620
.علينا إغلاق هذه الثّغرة بوهم ما

9
00:02:09,010 --> 00:02:10,520
.انظر للأسفل

10
00:02:11,820 --> 00:02:13,100
أهو مير؟

11
00:02:13,100 --> 00:02:17,560
.إنّه مجرّد عجوز خرف يلعب بالأزهار

12
00:02:17,560 --> 00:02:19,990
،حتّى إن عاد مرلين العظيم

13
00:02:19,990 --> 00:02:23,530
،وكان هو من عثر عليه
.فلن يصدّقه أحد

14
00:02:24,090 --> 00:02:26,050
هل وجدتما جثّته؟

15
00:02:26,050 --> 00:02:26,910
.لا

16
00:02:26,910 --> 00:02:29,740
!افعلا كلّ ما يمكن لإيجاده وقتله

17
00:02:29,740 --> 00:02:32,050
!وهذا قبل أن يُكتشف مخبئي

18
00:02:32,050 --> 00:02:34,920
من يكون ذلك الفتى؟

19
00:02:35,360 --> 00:02:38,790
إنّ له علاقة ما بالرّجل
.الّذي تسبّب لي بهذه النّدوب

20
00:02:46,730 --> 00:02:48,930
.حسنًا، كلّ شيء واضح الآن

21
00:02:51,940 --> 00:02:54,730
.شكرًا لإخفائك له من أجلي

22
00:02:54,730 --> 00:02:57,810
.سآتي لزيارتك ثانية قريبًا

23
00:03:00,310 --> 00:03:06,980
،لا أظنّني قادرًا على أن أشفي هذا
.لكنّ زوجتي تستطيع لحسن حظّه

24
00:03:09,830 --> 00:03:12,100
ما الّذي شعرتُ به للتّوّ؟

25
00:03:12,710 --> 00:03:13,700
!دوك

26
00:03:14,210 --> 00:03:15,290
ميلي؟

27
00:03:17,030 --> 00:03:19,090
!أعتقد أنّ سِث في ورطة

28
00:03:19,090 --> 00:03:21,220
!ما-ماذا؟

29
00:03:24,220 --> 00:03:27,160
أليس هذا غريبًا؟

30
00:03:27,160 --> 00:03:29,480
،هنالك أجزاء متساقطة من الجدار

31
00:03:29,480 --> 00:03:32,290
.لكنّني لا أرى أيّ ضرر به

32
00:03:33,730 --> 00:03:35,860
هل كان هجومًا من الخارج؟

33
00:03:35,860 --> 00:03:38,590
ومن أين قد يأتي الهجوم؟

34
00:03:38,590 --> 00:03:41,110
إضافة لذلك، لم يتمكّنوا
.من تجاوز جدار القلعة

35
00:03:42,050 --> 00:03:43,340
...معك حقّ

36
00:03:46,180 --> 00:03:47,220
.أوكوهو

37
00:03:47,740 --> 00:03:49,020
.ميلي

38
00:03:50,230 --> 00:03:51,900
من هذا الولد الصّغير؟

39
00:03:51,900 --> 00:03:53,990
!أنا أكبر منك سنًّا

40
00:03:55,130 --> 00:03:57,750
يا إلهي! من هذه؟

41
00:03:58,270 --> 00:04:00,470
.إنّها الفارسة المتدرّبة أوكوهو

42
00:04:00,470 --> 00:04:03,380
قالت أنّها كانت برفقة سِث
.منذ وصوله إلى القلعة

43
00:04:03,380 --> 00:04:05,260
!صحيح! سِث

44
00:04:05,260 --> 00:04:08,040
هل رأيتما سِث؟

45
00:04:08,040 --> 00:04:11,130
أتيتُ إلى هنا لأنّني سمعت
.بوجود انفجار

46
00:04:11,130 --> 00:04:13,390
.آمل أنّ سِث لا علاقة له بذلك

47
00:04:13,390 --> 00:04:14,890
!بالطّبع له علاقة

48
00:04:14,890 --> 00:04:18,310
،عند حدوث أمر غريب ما
!دائمًا ما يكون متورّطًا فيه

49
00:04:18,310 --> 00:04:19,660
.هذا صحيح

50
00:04:20,070 --> 00:04:21,950
،إنّه شعور خافت

51
00:04:21,950 --> 00:04:25,410
.لكن بإمكاني الإحساس بآثار فانتازيا سِث

52
00:04:25,410 --> 00:04:26,650
!مذهل

53
00:04:27,510 --> 00:04:30,590
.ميلي صيّادة كمائن ممتازة

54
00:04:39,800 --> 00:04:42,610
!فيتسيغيا إنفينيري

55
00:04:43,910 --> 00:04:45,020
!من هناك

56
00:05:06,270 --> 00:05:07,910
اختفى الأثر؟

57
00:05:07,910 --> 00:05:09,830
!هذا لأنّه غادر القلعة

58
00:05:09,830 --> 00:05:14,460
!يختفي كلّ السّحر عندما يعبر هذه البوّابة

59
00:05:14,790 --> 00:05:16,210
...في تلك الحالة

60
00:05:18,380 --> 00:05:22,090
!فيتسيغيا إنفينيري

61
00:05:28,550 --> 00:05:29,830
اتّجه إلى الغابة؟

62
00:05:33,610 --> 00:05:38,350
من الصّعب جدًّا الرّكض
.بهاتين السّاقين القصيرتين

63
00:05:38,350 --> 00:05:40,990
!سأرتاح قليلاً هنا

64
00:05:41,460 --> 00:05:44,230
!هذا مؤلم! سأذهب! سأذهب

65
00:05:44,230 --> 00:05:45,600
.لنسرع

66
00:05:45,600 --> 00:05:46,890
!مهلاً

67
00:05:47,950 --> 00:05:52,240
.غابة كايلت محميّة بسحر قديم قويّ

68
00:05:52,240 --> 00:05:56,770
،بمجرّد أن ندخلها
!سنضيع فيها ولن نخرج أبدًا

69
00:05:56,770 --> 00:05:58,500
!ماذا؟

70
00:05:58,500 --> 00:06:02,790
إنّها خطيرة جدًّا لدرجة أنّ حتّى
!الفرسان السّحرة لا يدخلونها

71
00:06:04,340 --> 00:06:05,820
.فهمت

72
00:06:05,820 --> 00:06:08,010
.لنلتفّ حول الغابة

73
00:06:08,500 --> 00:06:10,100
.سأذهب وحدي

74
00:06:11,390 --> 00:06:12,390
!مـ-مهلاً

75
00:06:26,900 --> 00:06:29,930
ما هذا المكان؟

76
00:06:47,740 --> 00:06:50,210
!غبيّة

77
00:06:50,210 --> 00:06:53,810
!لماذا لا تصغيان أنت وسِث أبدًا؟

78
00:06:50,750 --> 00:06:54,710
!أوكوهو! أوكوهو! أوكوهو

79
00:06:53,810 --> 00:06:56,030
!كيف تتوقّعين أن نخرج الآن؟

80
00:06:56,030 --> 00:07:00,580
...هذا سهل. إن عدنا من حيث أتينا

81
00:07:02,810 --> 00:07:06,730
.ماذا؟ ظننتُ أنّه كانت هنالك أجمّة ما

82
00:07:40,590 --> 00:07:43,830
هل شعرتِ بذلك؟
.كان حضوره طاغيًا

83
00:07:43,830 --> 00:07:47,420
!لا أريد أن يتمّ أكلي

84
00:07:47,420 --> 00:07:50,050
.أنا آسفة. هذه غلطتي

85
00:07:47,420 --> 00:07:50,050
!لا أريد، لا أريد، لا أريد

86
00:07:50,050 --> 00:07:52,240
!لا وقت للاعتذار الآن

87
00:07:52,560 --> 00:07:55,020
.لن يوصلنا الحدث هكذا لأيّ مكان

88
00:07:55,020 --> 00:07:58,870
،إن عملنا جميعًا معًا
.فسنجد طريقنا خارج هذه الغابة

89
00:07:58,870 --> 00:08:01,620
.إمّا هذا أو سنموت أبشع ميتة

90
00:08:01,620 --> 00:08:03,250
!هنالك أمران علينا فعلهما

91
00:08:03,250 --> 00:08:07,000
!سننقذ سِث، ثمّ سنخرج جميعًا من هنا

92
00:08:07,000 --> 00:08:08,220
!نعم

93
00:08:12,660 --> 00:08:15,760
!اهدأ! سيجدنا ذلك الوحش

94
00:08:15,760 --> 00:08:17,020
ما الخطب؟

95
00:08:19,810 --> 00:08:21,100
اختفى؟

96
00:08:21,100 --> 00:08:23,520
أين ذهب؟

97
00:08:23,520 --> 00:08:27,430
أداة الاستفهام الصّحيحة
."ليست "أين" بل "متى

98
00:08:27,430 --> 00:08:31,800
.مهلاً يا مير. ليس لدينا وقت لألغازك

99
00:08:31,800 --> 00:08:33,530
!مهلاً! مير؟

100
00:08:33,530 --> 00:08:35,210
يا لها من صدفة، صحيح؟

101
00:08:35,210 --> 00:08:40,160
كنتُ استمتع بنزهة قصيرة
.للحفاظ على صحّتي

102
00:08:40,160 --> 00:08:43,230
!في هذا المكان المليء بالوحوش؟

103
00:08:43,230 --> 00:08:46,000
!يا لها من مفاجأة

104
00:08:46,000 --> 00:08:48,630
بإمكانكم رؤيتي؟

105
00:08:48,630 --> 00:08:49,880
!بالطّبع

106
00:08:50,250 --> 00:08:54,080
إنّ حقيقة كونكم لم تضيعوا
.بعد مثيرة للاهتمام

107
00:08:54,080 --> 00:08:56,220
.نحن ضائعون منذ وقت طويل

108
00:08:56,220 --> 00:08:57,640
...في تلك الحالة

109
00:08:58,140 --> 00:09:01,890
هل ترغبون في مقابلة زوجتي أيضًا؟

110
00:09:01,890 --> 00:09:05,330
.أنا آسفة يا مير، لكنّنا مشغولون

111
00:09:05,330 --> 00:09:06,330
—نحن نبحث عن سِث

112
00:09:06,330 --> 00:09:07,780
تقصدون هذا؟

113
00:09:08,520 --> 00:09:10,520
!سِث

114
00:09:10,990 --> 00:09:13,150
!ماذا حدث لسِث؟

115
00:09:13,150 --> 00:09:16,150
.هذه ليست جروحًا عاديّة

116
00:09:16,150 --> 00:09:18,900
.ستحتاج مهارات شفاء خاصّة

117
00:09:29,920 --> 00:09:32,420
.هذه تبدو مثل تورتيبري

118
00:09:35,370 --> 00:09:36,800
...وتلك النّبتة

119
00:09:36,800 --> 00:09:40,570
.سبق ورأيتها في دليل "سكستوس أبوليوس" الميدانيّ

120
00:09:42,220 --> 00:09:45,330
.كلّ هذه الأصناف اعتُقد أنّها قد انقرضت

121
00:09:45,740 --> 00:09:48,560
.إن كانت حقيقيّة، فهذا اكتشاف عظيم

122
00:09:48,560 --> 00:09:51,780
لماذا لا يؤثّر سحر الغابة عليك يا مير؟

123
00:09:51,780 --> 00:09:53,070
سحر؟

124
00:09:53,070 --> 00:09:54,570
أنت تعرفه، صحيح؟

125
00:09:54,570 --> 00:09:57,450
إنّ كلّ من يدخل هذه الغاية يضيع

126
00:09:57,450 --> 00:09:59,980
.وينتهي به المطاف محاصرًا هنا لعقود

127
00:09:59,980 --> 00:10:01,020
ماذا؟

128
00:10:01,020 --> 00:10:07,370
تقول الأساطير أنّها تعويذة قويّة ألقاها
.العظيم مرلين لحماية القلعة من الأعداء

129
00:10:09,110 --> 00:10:11,930
!لا أصدّقكم أيّها النّاس

130
00:10:12,460 --> 00:10:14,230
،عندما لا تفهمون شيئًا

131
00:10:14,230 --> 00:10:19,140
.تختلقون أمرًا عشوائيًّا لتبرير جهلكم

132
00:10:19,790 --> 00:10:23,040
.صحيح أنّ هذه الغابة تثير حيرة النّاس

133
00:10:23,040 --> 00:10:26,640
.لكن لم يُلقى عليها أيّ سحر

134
00:10:27,570 --> 00:10:28,890
.وصلنا

135
00:10:28,890 --> 00:10:32,980
!تبدين أكثر جمالاً من العادة اليوم

136
00:10:41,160 --> 00:10:43,410
!مرحبًا بعودتك يا مير

137
00:10:43,410 --> 00:10:45,370
!ها قد عدت

138
00:10:45,370 --> 00:10:47,540
.أحضرت معي بعض الزّوّار

139
00:10:47,540 --> 00:10:49,940
ماذا؟! باقة من البشر؟

140
00:10:49,940 --> 00:10:51,170
!كم هذا رائع

141
00:10:51,170 --> 00:10:53,170
!ضعهم في هذه المزهريّة

142
00:10:55,470 --> 00:10:58,680
.أمزح فحسب. ليتكم ترون وجوهكم المضحكة

143
00:10:58,680 --> 00:11:01,170
.لا أضع البشر في مزهريّات

144
00:11:01,170 --> 00:11:04,180
!لدينا أخلاق كما تعلمون

145
00:11:04,180 --> 00:11:10,440
،إنّنا ننتظر حتّى مماتهم
.ثمّ نأخذهم ونزيّن بهم الجوار

146
00:11:10,440 --> 00:11:13,540
!لـ-لن أقطف زهرة حيّة ثانية في حياتي

147
00:11:13,540 --> 00:11:15,120
!ولا أنا

148
00:11:15,120 --> 00:11:17,940
!سأزيّن منزلي بالصّخور بدءًا من الآن

149
00:11:17,940 --> 00:11:19,730
.إنّها تمزح فحسب

150
00:11:19,730 --> 00:11:23,750
.زوجتي لطيفة كطحلب الرّبيع

151
00:11:25,650 --> 00:11:28,160
مهلا، ما هذه الرّائحة؟

152
00:11:29,070 --> 00:11:33,060
هل كنت تتسكّع بين نباتات المدينة ثانية؟

153
00:11:33,060 --> 00:11:35,710
!لا، لا، بالطّبع لا

154
00:11:35,710 --> 00:11:38,170
.لا فائدة من الكذب عليّ

155
00:11:38,170 --> 00:11:40,630
.هنالك ورقة على لحيتك

156
00:11:41,220 --> 00:11:44,610
!هذه... لأنّني اتّكأت على شجرة

157
00:11:44,610 --> 00:11:48,100
!كنت أكتب أغنية من أجلك

158
00:11:49,310 --> 00:11:52,460
استمعي لهذه الأغنية
!الّتي كتبتها لك بدافع الحبّ

159
00:11:52,460 --> 00:11:53,620
!المعذرة

160
00:11:54,950 --> 00:11:58,600
.سمعنا أنّ بإمكانك شفاء سِث

161
00:11:58,600 --> 00:12:01,500
.يا إلهي. يبدو ذلك البشريّ ذابلاً

162
00:12:01,500 --> 00:12:02,990
!أرجوك

163
00:12:02,990 --> 00:12:05,490
!أنقذي سِث رجاءً

164
00:12:08,950 --> 00:12:14,960
.غابة كايلت] غابة غامضة ضاعت فيها ميلي ورفاقها]
...تعيش فيها حيوانات ونباتات منقرضة

165
00:12:26,210 --> 00:12:28,720
أيمكنك رؤيتها؟

166
00:12:30,090 --> 00:12:35,620
.ثمة كرة غريبة حوله وكأنّها جدار

167
00:12:35,620 --> 00:12:38,730
.لم أستطع اختراقها

168
00:12:38,730 --> 00:12:41,400
ما الّذي بداخلها؟

169
00:12:41,400 --> 00:12:45,420
.أنبتُّ شجرة داخلها

170
00:12:45,420 --> 00:12:47,740
.فعلاً؟ تصرّف ذكيّ

171
00:12:48,080 --> 00:12:51,120
!ما-ما أنتما؟

172
00:12:51,120 --> 00:12:53,770
!يا ويحي، آسف

173
00:12:59,630 --> 00:13:01,000
!مير؟

174
00:13:01,000 --> 00:13:02,710
.هذا صحيح

175
00:13:02,710 --> 00:13:05,690
.وهذه زوجتي جيل

176
00:13:05,690 --> 00:13:06,620
!زوجتك؟

177
00:13:06,620 --> 00:13:08,370
أليست فاتنة؟

178
00:13:08,370 --> 00:13:10,020
!مهلاً يا مير

179
00:13:10,020 --> 00:13:13,240
لكن ما الّذي تفعلانه داخل رأسي؟

180
00:13:13,240 --> 00:13:15,200
داخل رأسك؟

181
00:13:15,200 --> 00:13:18,630
!أنت مخطئ! لا تحتكره لنفسك

182
00:13:18,630 --> 00:13:19,270
ماذا؟

183
00:13:19,270 --> 00:13:23,260
.هذا بُعد روحيّ يُدعى سيد

184
00:13:23,260 --> 00:13:24,780
سيد"؟"

185
00:13:24,780 --> 00:13:26,860
.نعم، سيد

186
00:13:26,860 --> 00:13:28,930
،إنّه موجود داخل الجميع

187
00:13:28,930 --> 00:13:32,740
.لكن لا يستطيع الجميع دخوله

188
00:13:32,740 --> 00:13:37,020
بمجرّد أن تعتاد عليه، يصبح بإمكان
المرء اكتشاف وعي الآخرين

189
00:13:37,020 --> 00:13:40,670
.والتّواصل معهم عبر سيد نفسه

190
00:13:42,430 --> 00:13:44,260
...إنّ سيد

191
00:13:45,550 --> 00:13:49,180
ما ذلك الشّيء داخلك؟

192
00:13:49,180 --> 00:13:51,330
.لستُ... واثقًا

193
00:13:52,030 --> 00:13:54,500
.لكن لسبب ما، أشعر بوجود بيودون

194
00:13:55,540 --> 00:13:58,440
.إنّه شخص يدّعي أنّه أخي

195
00:14:07,340 --> 00:14:10,200
ما الّذي يفعلانه؟

196
00:14:10,200 --> 00:14:13,830
.يبدو أّنهما... نائمان

197
00:14:13,830 --> 00:14:15,610
...لا يمكن

198
00:14:18,590 --> 00:14:20,210
...لحظة

199
00:14:21,340 --> 00:14:23,090
!هل هما نائمان فعلاً؟

200
00:14:23,090 --> 00:14:26,500
كلاّ! ألا تشعران بالأمر؟

201
00:14:26,940 --> 00:14:29,830
!مير وجيل يتواصلان مع سِث

202
00:14:29,830 --> 00:14:31,340
يتواصلان؟

203
00:14:31,340 --> 00:14:32,700
ماذا تقصدين؟

204
00:14:32,700 --> 00:14:37,620
يراودني بالفعل شعور بأنّ بينهم
...صلة بطريقة ما، لكن

205
00:14:37,620 --> 00:14:40,040
.ربّما لقوة هذه الغابة علاقة بالأمر

206
00:14:40,040 --> 00:14:42,610
،لا تكون حواسي يقظة هكذا في العادة

207
00:14:42,610 --> 00:14:45,330
!لكن بإمكاني الشّعور بالأمور بوضوح هنا

208
00:14:45,330 --> 00:14:46,860
!صحيح

209
00:14:47,330 --> 00:14:48,220
.حسنًا

210
00:14:48,220 --> 00:14:49,850
ما-ماذا تفعلين؟

211
00:14:49,850 --> 00:14:51,820
...عـ-عفوًا

212
00:14:58,330 --> 00:15:03,730
،فقدت وعيك بعد أن سُمّمت
ثم ظهرت هذه الكرة؟

213
00:15:03,730 --> 00:15:04,670
.نعم

214
00:15:05,220 --> 00:15:09,010
.لقد ابتلعتني، ولم أعد أدرك ماذا يحدث

215
00:15:09,750 --> 00:15:11,260
.فقدت السّيطرة

216
00:15:12,250 --> 00:15:14,010
.دمّرت كلّ شيء

217
00:15:15,260 --> 00:15:18,020
هل سيستمرّ حدوث هذا
من الآن فصاعدًا؟

218
00:15:18,990 --> 00:15:21,020
.على الأرجح

219
00:15:23,520 --> 00:15:26,520
ماذا يكون هذا يا ترى؟

220
00:15:26,520 --> 00:15:29,180
،إمّا أنّ لها إرادة خاصّة

221
00:15:29,180 --> 00:15:32,340
.أو أنّها تابعة لإرادتك أنت

222
00:15:32,340 --> 00:15:37,540
أو ربّما هي تابعة لهذا المدعوّ
.بيودون الّذي ذكرتَه

223
00:15:38,040 --> 00:15:41,610
،تمكّنتُ من كبحها مؤقّتًا

224
00:15:41,610 --> 00:15:45,920
،لكن بسبب ذلك الشّيء
.أنت على شفير الموت والحياة

225
00:15:46,590 --> 00:15:48,930
!ماذا؟! هل أوشك على الموت؟

226
00:15:48,930 --> 00:15:51,170
.بإمكاني شفاء جراحك

227
00:15:51,170 --> 00:15:56,430
.لكن إن أيقظتك، فسيختفي سحر مير

228
00:15:56,750 --> 00:16:01,090
ثمّ سأفقد السّيطرة ثانية؟

229
00:16:01,090 --> 00:16:05,150
.نعم، إن لم تتمكّن من التّحكّم بذلك الشّيء

230
00:16:11,130 --> 00:16:12,100
.لا يمكنني

231
00:16:14,430 --> 00:16:17,950
.من الأفضل إن بقيتُ هكذا

232
00:16:17,950 --> 00:16:19,370
!كفّ عن ذلك

233
00:16:22,810 --> 00:16:24,120
!ميلي؟

234
00:16:29,100 --> 00:16:30,930
أحضرتِهما إلى هنا؟

235
00:16:30,930 --> 00:16:31,880
.نعم

236
00:16:32,310 --> 00:16:33,630
.أحسنتِ

237
00:16:35,540 --> 00:16:37,820
!هذا ليس وقتًا مناسبًا لتفخري بنفسك

238
00:16:38,650 --> 00:16:42,600
!اُنظري لحالي
!واضح أنّك أخطأت في أمر ما

239
00:16:42,600 --> 00:16:46,650
هـ-هذا غريب. ما-ما الّذي حدث؟

240
00:16:54,780 --> 00:16:55,940
!علينا المغادرة

241
00:16:55,940 --> 00:16:58,320
...ماذا؟ لكنّهما

242
00:16:58,320 --> 00:17:01,590
!لا يمكنني البقاء هكذا
!هذا أسوأ من كوني رضيعًا

243
00:17:01,590 --> 00:17:03,670
!لنخرج من هنا في الحال

244
00:17:03,670 --> 00:17:04,980
...حسنًا

245
00:17:04,980 --> 00:17:07,240
!أريد الخروج

246
00:17:07,240 --> 00:17:08,520
!هيّا، هيّا

247
00:17:08,520 --> 00:17:11,550
!حـ-حسنًا، حسنًا

248
00:17:26,140 --> 00:17:28,560
لماذا تتصرّف بهذا الضّعف؟

249
00:17:29,060 --> 00:17:31,070
.هذا ليس من شيمك

250
00:17:35,140 --> 00:17:36,570
.أنا خائف

251
00:17:38,710 --> 00:17:42,310
إنّها تحاول التهامي في كلّ مرّة
.أرخي فيها دفاعاتي

252
00:17:43,150 --> 00:17:46,210
.لا فائدة من قتالها ولا من الصّراخ

253
00:17:46,890 --> 00:17:51,670
في الحقيقة، أشعر أنّها تزداد
.قوّة كلّما قاتلتها

254
00:17:52,190 --> 00:17:54,960
ماذا يُفترض أن أفعل؟

255
00:17:55,980 --> 00:17:59,820
إذًا ستجلس هناك محاطًا
بكآبتك للأبد؟

256
00:18:00,650 --> 00:18:02,460
.رجاءً افهمي

257
00:18:02,460 --> 00:18:04,970
أفهم ماذا؟

258
00:18:05,380 --> 00:18:08,710
.هذا الشّعور بالعجز الكامل

259
00:18:09,510 --> 00:18:13,530
.إن وُجد من قد يفهمه، فهو أنت

260
00:18:15,990 --> 00:18:20,830
.لسنا الوحيدان اللّذان يفهمان ذلك

261
00:18:21,330 --> 00:18:25,040
.دوك يفهمه، وكذلك الجميع

262
00:18:25,040 --> 00:18:27,820
.للجميع أمور لا تسير على هواهم

263
00:18:28,330 --> 00:18:30,340
.لكنّنا نواصل العيش

264
00:18:30,970 --> 00:18:32,500
...تمامًا كما عليك أنت أيضًا

265
00:18:32,850 --> 00:18:34,250
...صحيح، لكن

266
00:18:34,860 --> 00:18:40,260
ماذا إن انتهى بك الأمر مدمّرة
كلّ ما تلمسينه؟

267
00:18:41,900 --> 00:18:46,350
منزلك وبوبري ودوك... أو أنا؟

268
00:18:47,530 --> 00:18:50,460
هل ستواصلين السّماح
للآخرين بالتّقرّب إليك؟

269
00:18:50,460 --> 00:18:52,270
!أما زلت ستلمسينهم؟

270
00:18:56,970 --> 00:18:59,530
.لا يمكنني ذلك

271
00:19:04,050 --> 00:19:05,650
...تعلمين يا ميلي

272
00:19:06,890 --> 00:19:09,740
هذا الشّيء الّذي بداخلي ولعنتك
.يتصرّفان من تلقاء نفسيهما

273
00:19:10,260 --> 00:19:12,550
.إنّهما يأبيان فعل ما نمليه عليهما

274
00:19:14,740 --> 00:19:19,550
هل باعتقادك أنّ هذا شيء
بإمكانك التّحكّم به وحدة؟

275
00:19:24,530 --> 00:19:25,470
.لا

276
00:19:27,740 --> 00:19:29,510
.لا يمكنني ذلك

277
00:19:32,950 --> 00:19:34,750
...لكن يا سِث

278
00:19:36,580 --> 00:19:40,460
.لم تكن خائفًا من لعنتي

279
00:19:40,870 --> 00:19:44,320
.وثقتَ بي رغم جهلي للسّبب

280
00:19:44,950 --> 00:19:46,890
.أنقذتني

281
00:19:49,080 --> 00:19:52,910
.جعلتني أشعر وكأنّ لعنتي لم تكن لعنة

282
00:19:53,540 --> 00:19:58,380
.عاملتها وكأنّها جزء آخر من شخصيّتي

283
00:19:59,090 --> 00:20:04,150
.بدأتُ حقًّا أعتقد أنّها كذلك بالفعل

284
00:20:12,590 --> 00:20:16,460
.أنا وأنت... لسنا متشابهيْن

285
00:20:18,060 --> 00:20:22,140
لهذا السّبب أعرف أنّك قادر
.على فعل شيء حيالها

286
00:20:25,470 --> 00:20:27,060
.بل لا أستطيع

287
00:20:30,750 --> 00:20:33,650
.ليس بمفردي

288
00:20:36,210 --> 00:20:39,230
.ميلي، أنا سعيد لأنّك بجانبي

289
00:20:39,900 --> 00:20:41,260
...سِث

290
00:20:41,580 --> 00:20:44,090
.لا فكرة لديّ ما هذا الشّيء

291
00:20:45,110 --> 00:20:47,910
،لكن كلّما تحدّثت إليك

292
00:20:47,910 --> 00:20:50,060
.قلّ شعوري بأنّها ستقوم بشيء سيّئ

293
00:20:51,860 --> 00:20:54,990
،ظننتُ أنّ عليّ الاهتمام بأمرها وحدي

294
00:20:55,420 --> 00:20:56,570
.لكنّني كنتُ مخطئًا

295
00:20:57,820 --> 00:21:02,090
،لا أريد أن أدير ظهري لك بعد الآن

296
00:21:02,620 --> 00:21:05,110
.لكن لا يمكنني وضعك في خطر أيضًا

297
00:21:06,530 --> 00:21:08,410
.لذلك لا خيار آخر أمامي

298
00:21:09,590 --> 00:21:11,690
.سأتحكّم بهذا الشّيء

299
00:21:11,690 --> 00:21:12,660
.هذا وعد

300
00:21:13,790 --> 00:21:14,990
...سِث

301
00:21:17,990 --> 00:21:19,870
لماذا تضحك؟

302
00:21:20,750 --> 00:21:22,180
ألم تلاحظي؟

303
00:21:22,180 --> 00:21:23,420
ألاحظ ماذا؟

304
00:21:23,830 --> 00:21:25,800
.طريقة كلامك

305
00:21:25,800 --> 00:21:27,890
—أنا أتكلّم بشكل طبيعيّ

306
00:21:29,800 --> 00:21:32,580
.تغيّرتِ يا ميلي

307
00:21:32,580 --> 00:21:34,390
أتعتقد ذلك؟

308
00:21:34,390 --> 00:21:37,440
.هذه علامة على أنّك تثقين بي

309
00:21:37,860 --> 00:21:40,420
!توقّف! الأمر ليس كذلك

310
00:21:40,420 --> 00:21:43,420
!كلاّ! لا أستطيع العودة الآن

311
00:21:45,590 --> 00:21:47,450
!يكفي يا سِث

312
00:21:49,150 --> 00:21:50,100
...ميلي

313
00:21:52,050 --> 00:21:53,180
.شكرًا لك

314
00:22:02,730 --> 00:22:04,960
.ماذا؟ ها قد استيقظت

315
00:22:04,960 --> 00:22:08,180
.وهذا يبدو في حال أفضل أيضًا

316
00:22:08,180 --> 00:22:09,840
كيف هو سِث؟

317
00:22:09,840 --> 00:22:11,660
أهو بخير؟

318
00:22:11,660 --> 00:22:14,650
.يبدو أنّه جاهز لمغادرة سيد الآن

319
00:22:14,650 --> 00:22:16,340
.هذا جيّد

320
00:22:16,340 --> 00:22:19,850
لكنّه قال أنّه سيظلّ في هذه الغابة

321
00:22:19,850 --> 00:22:22,480
.والتّدرّب مع مير لبعض الوقت

322
00:22:22,480 --> 00:22:24,100
!ماذا؟

323
00:22:25,990 --> 00:22:29,990
يُتبع

324
00:24:00,000 --> 00:24:20,740
في الحلقة القادمة

325
00:24:00,950 --> 00:24:06,570
بهدف تعلّم كيف يتحكّم
،بالقوّة الهائجة بداخله

326
00:24:06,570 --> 00:24:10,300
يبدأ سِث تدريبًا جديدًا تحت
.إشراف مير وجيل

327
00:24:10,860 --> 00:24:13,860
،وخلال تدريبه مع مير
،يتعلّم كيف يشعر بالطّبيعة

328
00:24:13,860 --> 00:24:16,660
.وجوهر الفانتازيا الحقيقيّ

329
00:24:16,660 --> 00:24:20,480
ثمّ يواجه أخيرًا القوّة المظلمة
.الّتي وضعها بيودون داخله

330
00:24:20,940 --> 00:24:24,190
:"في الحلقة القادمة من "راديان
."قصر المكائد"

331
00:24:25,020 --> 00:24:30,250
النّهاية