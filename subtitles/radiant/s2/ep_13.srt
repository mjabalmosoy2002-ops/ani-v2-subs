1
00:00:01,270 --> 00:00:07,760
بعد تسلّل دراغونوف وليزيلوت
،إلى سيفاندير متعقّبين سِث ورفاقه

2
00:00:07,760 --> 00:00:10,870
تلقّيا أمرًا سرّيًّا جديدًا من الجنرال تورك

3
00:00:10,870 --> 00:00:13,510
.وذهبا للقاء رجل غريب

4
00:00:14,530 --> 00:00:18,850
،كان ذلك الرّجل هو دوسان
.أحد التّجّار البارونات

5
00:00:19,550 --> 00:00:24,140
توشك الحقيقة خلف هذه المؤامرة
.الّتي حلّت بهذه الأرض أن تُكشف

6
00:00:28,260 --> 00:00:30,450
ماذا ستكون يا ترى؟

7
00:00:30,950 --> 00:00:34,620
.كما أنّهم اختاروا مكانًا غريبًا لنذهب إليه

8
00:00:41,470 --> 00:00:44,980
في كلّ الأحوال، هذا أمر
.مباشر من الجنرال تورك

9
00:00:45,430 --> 00:00:47,230
...أخبرني يا دراغونوف

10
00:00:47,580 --> 00:00:51,650
عندما قال الجنرال تورك أنّك ستصبح
،من صانعي المعجزات

11
00:00:51,650 --> 00:00:54,990
.لم تبدُ لي متحمّسًا كثيرًا

12
00:00:55,300 --> 00:00:57,520
.ذلك ليس صحيحًا تمامًا

13
00:00:57,520 --> 00:00:59,990
لكلّ امرئ طريقته الخاصّة
.في التّعبير عن الفرح

14
00:01:04,460 --> 00:01:07,810
.مرحبًا، نحن سعداء بوصولكما

15
00:01:07,810 --> 00:01:10,000
.آسف لأنّ مكان اللّقاء غير لائق

16
00:01:10,630 --> 00:01:16,130
أنتما القائدان ليزيلوت ودراغونوف
من صانعي المعجزات، صحيح؟

17
00:02:51,870 --> 00:02:53,410
".قرارك"

18
00:02:56,030 --> 00:02:58,660
!أيّها القائد دراغونوف

19
00:02:58,660 --> 00:03:04,160
لم أحلم أبدًا بأن يزورنا رجل
بشهرتك كمبعوث سرّيّ

20
00:03:04,670 --> 00:03:07,410
برفقة القائد ليزيلوت أيضًا

21
00:03:07,410 --> 00:03:11,040
كفاك إطراءً ما الّذي تريده منّا؟

22
00:03:12,540 --> 00:03:15,350
قد أزعجتَ صانعَيْ معجزات بتصرّفك هذا

23
00:03:15,350 --> 00:03:17,940
،إن اتّضح أنّها مسألة تافهة
ستدفع الثّمن

24
00:03:20,190 --> 00:03:25,160
."أُسمّيه "هارمونيزيون

25
00:03:25,160 --> 00:03:26,790
عمّ تتحدّث؟

26
00:03:26,790 --> 00:03:31,190
.الجهاز المبتكَر الّذي يبطل الفانتازيا

27
00:03:32,460 --> 00:03:35,300
،إن أمسى السّحرة بلا قوّة

28
00:03:35,300 --> 00:03:41,070
فسيصبح من السّهل جدًّا عليكم
.يا وحدة التّفتيش أن تتدخّلوا

29
00:03:41,430 --> 00:03:43,070
ما الّذي ترمي إليه؟

30
00:03:43,070 --> 00:03:46,080
.أنا أتحدّث عن تدخّل مسلّح

31
00:03:46,470 --> 00:03:48,990
تقترح أنّ علينا شنّ حرب؟

32
00:03:48,990 --> 00:03:51,610
،هذه بلاد يملؤها المصابون

33
00:03:51,610 --> 00:03:56,810
أرض من المتوحّشين تعترض حكم
وحدة التّفتيش. هل أنا مخطئ؟

34
00:03:56,810 --> 00:04:02,520
واثق أنّ الجنرال تورك لا يريد
.أن يتمتّعوا بالحرّيّة للأبد

35
00:04:02,520 --> 00:04:04,010
.معك حقّ

36
00:04:04,010 --> 00:04:08,820
،إن استطعنا التّدخّل في هذه البلاد
.فستستعيد كرامتنا بكلّ تأكيد

37
00:04:08,820 --> 00:04:10,290
.بالفعل

38
00:04:10,290 --> 00:04:14,560
ما حدث في بلدة رامبل كان
.ضربة قاضية لوحدة التّفتيش

39
00:04:16,940 --> 00:04:19,910
كأنّ بارونًا تاجرًا مثلك قد يفهم ذلك

40
00:04:20,570 --> 00:04:24,320
.رجاءً، أبلغوا كلامي هذا للجنرال تورك

41
00:04:24,320 --> 00:04:26,820
سيضمن الفوز ثروة من الموارد لنا

42
00:04:27,250 --> 00:04:32,510
.وعودة الكرامة وحسن النّيّة لكم

43
00:04:32,510 --> 00:04:34,830
.فلنعمل معًا

44
00:04:34,830 --> 00:04:37,960
.سننتظر ردّكم آملين أنّه لصالحنا

45
00:04:40,960 --> 00:04:44,220
.لديك لسان من ذهب بالفعل

46
00:04:44,220 --> 00:04:47,970
هل قلتُ شيئًا أزعجك؟

47
00:04:47,970 --> 00:04:50,540
.ذكرتَ الموارد

48
00:04:50,540 --> 00:04:52,340
.أخبرني ما الّذي تعنيه

49
00:04:54,670 --> 00:04:58,860
واضح لي الآن كيف حصلتَ
.على ثقة الجنرال تورك

50
00:04:58,860 --> 00:05:01,450
،احترامًا منّا لشدّة بصيرتك

51
00:05:01,450 --> 00:05:03,360
.فسأخبرك

52
00:05:03,870 --> 00:05:07,610
...هدفنا الحقيقيّ هو

53
00:05:07,610 --> 00:05:12,320
جعل كلّ المصابين في هذه البلاد
بلا حول ولا قوّة بذلك الجهاز

54
00:05:12,320 --> 00:05:16,120
.وجعلهم عبيدًا لنا

55
00:05:23,030 --> 00:05:25,280
في تلك الأثناء، بدأت أوكوهو تشكّ

56
00:05:25,280 --> 00:05:31,890
أنّ من استغلّ لعنتها لإظهار
،النّمسيس الطّيفيّ هو موردرد

57
00:05:32,310 --> 00:05:36,630
.لذلك زارته في غرفته لمعرفة الحقيقة

58
00:05:39,270 --> 00:05:41,020
...بالتّفكير في الأمر

59
00:05:41,500 --> 00:05:45,010
.رأيتك معه في الإسطبل قبل مدّة

60
00:05:46,130 --> 00:05:51,030
،لكن أصبحت عيناك فارغتان بعدها
.كما كانتا قبل قليل

61
00:05:53,060 --> 00:05:53,910
.أنا قادم

62
00:05:56,970 --> 00:05:59,830
أوكوهو؟ ما الّذي أتى بك
في هذه السّاعة المتأخّرة؟

63
00:06:00,260 --> 00:06:02,260
.هذا مضجع الرّجال كما تعلمين

64
00:06:04,550 --> 00:06:06,110
.علينا أن نتحدّث

65
00:06:08,260 --> 00:06:09,930
.تفضّلي

66
00:06:20,610 --> 00:06:26,290
!لقد وهبتُ حياتي لسيفاندير وشعبها

67
00:06:27,280 --> 00:06:30,780
!موردرد، اعتقدتُ أنّ الأمر كذلك بالنّسبة لك

68
00:06:31,860 --> 00:06:35,410
!ا-اهدئي! الأمر نفسه بالنّسبة لي

69
00:06:35,410 --> 00:06:36,530
!اخرس

70
00:06:38,540 --> 00:06:40,630
أتقول أنّ الطّريقة
الّتي تخدم بها هذه البلاد

71
00:06:40,630 --> 00:06:42,540
!هي استدعاء النّمسيس الطّيفيّة؟

72
00:06:42,540 --> 00:06:45,420
...لـ-لحماية هذه البلاد

73
00:06:45,420 --> 00:06:46,800
!كفاك هراءً

74
00:06:46,800 --> 00:06:50,910
الأطياف هي الّتي تؤذي النّاس
!الّذين يفترض بنا حمايتهم

75
00:06:50,910 --> 00:06:53,970
...ومع ذلك... أنا

76
00:06:53,970 --> 00:06:55,310
!تقي بي رجاءً

77
00:06:55,310 --> 00:06:58,330
!وثقتُ بك بالفعل! أكثر من غيرك

78
00:06:58,910 --> 00:07:01,250
...لهذا... يا موردرد

79
00:07:01,890 --> 00:07:05,320
!أخبرتك وحدك عن سرّ لعنتي

80
00:07:05,780 --> 00:07:08,380
لذلك... لماذا؟

81
00:07:08,380 --> 00:07:11,020
!لماذا قمتَ باستغلالي؟

82
00:07:12,380 --> 00:07:15,090
.لـ-لحمايتك

83
00:07:15,090 --> 00:07:16,310
!اخرس

84
00:07:16,780 --> 00:07:18,740
!كفاك كذبًا

85
00:07:18,740 --> 00:07:20,620
!إ-إنّها الحقيقة

86
00:07:21,460 --> 00:07:26,230
.أ-أراد مخلصو النّاسك استعمالك كقاتلة

87
00:07:26,230 --> 00:07:27,510
ماذا تعني؟

88
00:07:27,940 --> 00:07:29,090
!تكلّم

89
00:07:31,340 --> 00:07:33,470
...أراد مخلصو النّاسك

90
00:07:33,810 --> 00:07:36,220
استعمال لعنتك للقضاء

91
00:07:36,630 --> 00:07:40,060
على الفرسان السّحرة
الّذين خانوا مرلين العظيم

92
00:07:40,450 --> 00:07:43,600
.والمزارعون الّذين تاجروا مع الأجانب

93
00:07:44,300 --> 00:07:48,490
،ولكن بسبب أهميّتك لديّ
.لم أستطع السّماح لهم بذلك

94
00:07:48,490 --> 00:07:50,990
!لذلك استدعيتُ الأطياف. إنّها الحقيقة

95
00:07:50,990 --> 00:07:52,220
.لن يفيدك هذا

96
00:07:52,810 --> 00:07:57,380
!لا يمكنني تصديق أيّ شيء تقوله الآن

97
00:08:00,570 --> 00:08:02,600
.عليّ إخبار الملكة

98
00:08:02,600 --> 00:08:06,650
.أعلم أنّ الملكة ستستمع لي

99
00:08:06,650 --> 00:08:08,640
.لا أنصحك بذلك

100
00:08:09,510 --> 00:08:14,260
ليصبح الشّخص من مخلصي النّاسك
،وتلميذًا لمرلين العظيم

101
00:08:14,790 --> 00:08:18,550
.فعليه أن يقسم بالولاء للملكة

102
00:08:18,550 --> 00:08:20,790
تعرفين ما يعنيه ذلك، صحيح؟

103
00:08:32,940 --> 00:08:34,660
،مرلين العظيم

104
00:08:35,550 --> 00:08:40,500
...مؤسّس كسلين مرلين وحارسنا العظيم

105
00:08:41,050 --> 00:08:43,310
.أرشدني للطّريق الصّحيح رجاءً

106
00:08:43,970 --> 00:08:46,540
.أعرني قوّتك رجاءً

107
00:08:47,660 --> 00:08:51,800
أيّ نوع من القوّة تعتقدين
أنّ صخرة كهذه تملكها؟

108
00:08:54,260 --> 00:08:57,820
مير! لـ-لماذا أنت هنا فجأة؟

109
00:08:57,820 --> 00:09:00,810
.أنا أطلب المساعدة من مرلين العظيم

110
00:09:02,450 --> 00:09:06,780
إذًا فـ"مرلين" هذا هو صخرة عملاقة؟

111
00:09:06,780 --> 00:09:08,210
!كلاّ

112
00:09:08,210 --> 00:09:11,820
!واضح أنّ هذا تمثال صُنع ليمثّله

113
00:09:12,180 --> 00:09:15,270
،إذًا، لا يهمّ كم ستتضرّعين لهذا الشّيء

114
00:09:15,270 --> 00:09:17,850
.فلن يساعدك بأيّ شيء

115
00:09:18,740 --> 00:09:21,830
ألا توافقني؟

116
00:09:23,550 --> 00:09:26,080
سِث؟! لماذا أنت هنا؟

117
00:09:26,080 --> 00:09:28,570
،بعد قضائي كلّ ذلك الوقت في الغاية

118
00:09:28,570 --> 00:09:30,580
.لم أستطع النّوم على ذلك السّرير

119
00:09:32,340 --> 00:09:34,310
ما الّذي حدث لمارموت؟

120
00:09:37,460 --> 00:09:38,970
.فهمت

121
00:09:40,940 --> 00:09:42,590
...عندما كنتُ طفلة

122
00:09:43,730 --> 00:09:49,150
رأينا أنا وأصدقائي الفرسان السّحرة
.يطيرون فوقنا على تنانينهم

123
00:09:49,770 --> 00:09:51,490
.بدوا رائعين جدًّا

124
00:09:51,490 --> 00:09:53,870
،قرّرنا أنّنا عندما نكبر

125
00:09:53,870 --> 00:09:57,020
.فسنصبح فرسانًا أقوياء يحمون هذه البلاد

126
00:09:57,710 --> 00:10:01,450
...لذلك عملنا بجدّ معًا طول تلك السّنوات

127
00:10:02,190 --> 00:10:05,020
لكنّ الصّديق الّذي كنتُ أسعى
لتحقيق ذلك الحلم معه

128
00:10:05,470 --> 00:10:07,790
.قام باستدعاء نمسيس طيفيّة

129
00:10:08,900 --> 00:10:12,430
والملكة الّتي احترمتها كانت
.من تصدر أوامرهم

130
00:10:15,230 --> 00:10:17,500
.نحن قريبون من مراسم التّرسيم أيضًا

131
00:10:17,500 --> 00:10:19,210
ما الّذي يفترض بي أن أصدّقه؟

132
00:10:19,910 --> 00:10:24,560
،عندما فكّرتُ في ذلك
.جاءت بي قدماي إلى هنا

133
00:10:25,060 --> 00:10:27,930
.تساءلت ما الّذي كان ليفعله العظيم مرلين

134
00:10:28,560 --> 00:10:30,520
تريدين أن تعرفي؟

135
00:10:30,520 --> 00:10:34,680
.ما كان مرلين ليطلب المساعدة من صخرة

136
00:10:34,680 --> 00:10:35,740
...مير

137
00:10:37,380 --> 00:10:38,540
.معك حقّ

138
00:10:39,100 --> 00:10:44,250
لا أدري إن كنت أستطيع حماية
.سيفاندير بعد الآن

139
00:10:44,250 --> 00:10:45,950
.بإمكانك حماية أيّ شيء

140
00:10:46,890 --> 00:10:51,460
وقفتِ في وجه جيش كامل
.من النّمسيس وحدك

141
00:10:51,870 --> 00:10:54,170
.كان أيّ أحد غيرك ليجبن ويهرب

142
00:10:54,170 --> 00:10:55,940
،حتّى إن لم يُثني أيّ أحد عليك لذلك

143
00:10:55,940 --> 00:10:57,840
،حتّى إن لم يعترف أيّ أحد بقدراتك

144
00:10:57,840 --> 00:11:00,740
.قمتِ بذلك لحماية الجميع

145
00:11:02,970 --> 00:11:04,700
!لذلك كوني فخورة

146
00:11:04,700 --> 00:11:07,200
،حتّى إن لم تحملي لقب الفارس

147
00:11:07,200 --> 00:11:08,780
ما زلتِ أنتِ، صحيح؟

148
00:11:10,430 --> 00:11:15,980
،لذلك قومي فقط بما تعتقدينه صوابًا
.بناءً على ما ترينه وما تشعرين به

149
00:11:21,750 --> 00:11:25,060
...ما أراه صوابًا

150
00:11:33,000 --> 00:11:39,010
.مراسم التّرسيم] في هذه المراسم، يرحّب الفرسان السّحرة بالمتدرّبين كأنّهم أبناؤهم]
.في السّنوات الأخيرة، أصبح عدد الفرسان المتدرّبين أقلّ، لذلك تمّ التّرحيب بهم جميعًا في عائلات

151
00:11:40,900 --> 00:11:45,550
يوم مراسم التّرسيم

152
00:11:44,150 --> 00:11:45,550
...يا إلهي

153
00:11:45,550 --> 00:11:48,060
.هذه فكرة غبيّة

154
00:11:48,060 --> 00:11:49,810
ماذا تقصدين؟

155
00:11:49,810 --> 00:11:51,950
!هذه الملابس

156
00:11:51,950 --> 00:11:54,660
أعلينا أن نرتدي ملابس سحرة دون غيرها؟

157
00:11:55,150 --> 00:11:57,370
.كلّ شيء من أجل صالح المهمّة

158
00:11:58,530 --> 00:12:01,970
.كان بإمكاننا التّسلّل بسهولة دون الأزياء

159
00:12:01,970 --> 00:12:06,070
.إنّهم لا يقومون بتفتيش أيّ أحد
.لا يوجد حرس في الجوار حتّى

160
00:12:06,780 --> 00:12:08,670
ومع ذلك، حان الوقت، صحيح؟

161
00:12:09,410 --> 00:12:13,080
تسير هذه الخطّة على قدم
.وساق بشكل مفاجئ

162
00:12:13,080 --> 00:12:16,690
،التّجّار البارونات مجموعة مشبوهة

163
00:12:16,690 --> 00:12:19,590
.لكن يبدو أنّهم قد خطّطوا لكلّ شيء

164
00:12:19,590 --> 00:12:20,850
.نعم

165
00:12:20,850 --> 00:12:25,480
وكلّ هذا نتيجة للتّسوية
.الّتي وصلتَ بها معهم

166
00:12:25,480 --> 00:12:28,720
أفعالك في هذه الأسابيع القليلة
.الماضية مثيرة للإعجاب

167
00:12:28,720 --> 00:12:30,970
.حتّى الجنرال تورك أثنى عليك

168
00:12:46,330 --> 00:12:47,590
...هل ذلك

169
00:12:51,620 --> 00:12:52,750
!إنّها أوكوهو

170
00:12:53,070 --> 00:12:54,060
!صحيح

171
00:12:57,750 --> 00:13:00,420
!تبدو أوكوهو شجاعة جدًّا

172
00:13:01,220 --> 00:13:04,260
.لكنّها تبدو متوتّرة قليلاً أيضًا

173
00:13:05,450 --> 00:13:06,380
.أوكوهو

174
00:13:06,380 --> 00:13:08,490
أوكوهو، هل أنت بخير؟

175
00:13:09,820 --> 00:13:10,780
سِث؟

176
00:13:13,070 --> 00:13:16,020
أعرف أنّك على الأرجح قلقة
...بشأن هذا التّرسيم، لكن

177
00:13:16,020 --> 00:13:18,400
.لستُ قلقة بشأن ذلك

178
00:13:19,650 --> 00:13:22,450
،قد لا أصبح فارسة ساحرة

179
00:13:23,010 --> 00:13:25,900
.لكنّني أعرف ما عليّ فعله

180
00:13:26,250 --> 00:13:27,610
.فهمت

181
00:13:27,610 --> 00:13:29,090
.سأذهب الآن

182
00:13:29,090 --> 00:13:30,180
.حظًّا سعيدًا

183
00:13:30,180 --> 00:13:31,390
.ولك أيضًا

184
00:13:51,180 --> 00:13:54,180
،أيّها الفرسان المتدرّبون الظّرفاء

185
00:13:54,180 --> 00:13:57,260
...يا حماة سيفاندير

186
00:13:57,810 --> 00:14:03,940
سيتمّ التّرحيب بكم اليوم
.ضمن عائلاتكم الجديدة

187
00:14:03,940 --> 00:14:05,340
!يا جلالتك

188
00:14:08,950 --> 00:14:11,900
يبدو أنّ بعضًا من أكثر المواهب الواعدة

189
00:14:11,900 --> 00:14:16,950
في تاريخ كاسلين مرلين
.بين متدرّبي هذه السّنة

190
00:14:17,860 --> 00:14:19,940
.أنا فخورة بكم

191
00:14:21,180 --> 00:14:25,600
.تذكّروا دائمًا تعاليم العظيم مرلين

192
00:14:25,600 --> 00:14:29,750
قفوا معًا أمام الشّجرة المقدّسة
،الّتي نجت من نيران الحرب

193
00:14:29,750 --> 00:14:33,850
ودعونا نفكّر في أحداث
.الماضي بينما نحتفل

194
00:14:33,850 --> 00:14:38,350
!والآن يا فرسان سيفاندير السّحرة

195
00:14:38,350 --> 00:14:42,110
!اختاروا من سيرث إرث مرلين العظيم

196
00:14:42,110 --> 00:14:44,380
ما هي أسماء المتدرّبين؟

197
00:14:46,010 --> 00:14:48,330
في تلك الأثناء، كان سِث ودوك

198
00:14:48,330 --> 00:14:50,830
.قد تسلّلا إلى قبو المكتبة

199
00:14:52,060 --> 00:14:55,870
ليس هنالك الكثير من الحرّاس خلال
.التّرسيم، كما قالت أوكوهو تمامًا

200
00:14:55,870 --> 00:14:58,650
لماذا كان عليّ المجيء أيضًا؟

201
00:14:59,100 --> 00:15:01,570
قلتَ أنّك أردتَ رؤية الكتب
في الأرشيف، صحيح؟

202
00:15:01,570 --> 00:15:04,940
!أنا أقدّر حياتي أكثر من بحثي الآن

203
00:15:04,940 --> 00:15:07,530
إن أمسكوا بنا، ستكون
!التّهم ضدّنا خطيرة

204
00:15:07,530 --> 00:15:10,450
!لا أريد أن أتورّط في المزيد من المخاطر

205
00:15:10,450 --> 00:15:12,330
!في الحقيقة، أنا مغادر الآن

206
00:15:12,330 --> 00:15:13,110
!دوك

207
00:15:14,350 --> 00:15:16,210
.نحن بخير ما داموا لن يمسكوا بنا

208
00:15:16,210 --> 00:15:19,530
تولّى أمر ما طلبه غريم، موافق؟

209
00:15:20,890 --> 00:15:24,170
إلى اللّقاء. يمكنك فعل
.ما تشاء بعد أن تجده

210
00:15:24,170 --> 00:15:25,550
!مهلاً يا سِث

211
00:15:26,350 --> 00:15:28,340
هـ-هل ستكون بخير؟

212
00:15:28,340 --> 00:15:32,160
...أعني، إن استدعى ديابال ذلك طيفًا

213
00:15:32,160 --> 00:15:35,940
،أعتقد أنّني إن تحدّثت معه
.قد أعرف شيئًا ما

214
00:15:36,510 --> 00:15:39,160
.مثل سبب امتلاكي لهذه القوّة

215
00:15:40,470 --> 00:15:41,170
.إلى اللّقاء

216
00:15:41,170 --> 00:15:42,170
!مـ-مهلاً

217
00:15:43,330 --> 00:15:44,690
...يا إلهي

218
00:15:48,570 --> 00:15:54,010
.هؤلاء هم فرساننا السّحرة الجدد

219
00:16:00,740 --> 00:16:02,130
...أوكوهو

220
00:16:03,440 --> 00:16:05,690
.كم هذا مزعج

221
00:16:05,690 --> 00:16:10,320
ألا يوجد من يرغب في جعل
هذه الفتاة خليفة له؟

222
00:16:10,320 --> 00:16:12,830
،مع كلّ احترامي يا جلالتك

223
00:16:12,830 --> 00:16:18,140
إنّ مخالفة هذه الفتاة للكثير
.من الأوامر هو تصرّف لا يغتفر

224
00:16:18,140 --> 00:16:20,950
هل أنا مخطئ يا سيّد برانغوار؟

225
00:16:23,080 --> 00:16:27,210
.نحن مسؤولون عن حماية هذه البلاد

226
00:16:27,210 --> 00:16:33,470
قبول خليفة خارج السّيطرة مثلها
.سيفسد كلّ شيء لنا

227
00:16:36,900 --> 00:16:40,470
.أفهم كيف تشعرون

228
00:16:40,470 --> 00:16:44,570
ومع ذلك، هل يمكنني أن أطلب
منكم إعادة النّظر في الأمر؟

229
00:16:46,090 --> 00:16:48,820
.لا بأس يا جلالتك

230
00:16:50,050 --> 00:16:52,240
ماذا تعنين؟

231
00:16:52,820 --> 00:16:56,670
.لا أحتاج لقب فارسة ساحرة

232
00:17:00,250 --> 00:17:02,870
.أفهم سبب إحباطك

233
00:17:02,870 --> 00:17:07,610
ولكن، لا يجب عليك إهانة
.لقب شرفيّ كهذا

234
00:17:07,610 --> 00:17:10,250
الشّخص الوحيد الّذي أهان
هذا اللّقب الشّرفيّ

235
00:17:10,790 --> 00:17:14,130
!هو أنت يا جلالتك

236
00:17:14,570 --> 00:17:17,010
!أنت من أطلقت الأطياف على شعبك

237
00:17:17,770 --> 00:17:19,510
ماذا قلتِ؟

238
00:17:19,510 --> 00:17:22,000
عمّ تتحدّث؟

239
00:17:22,000 --> 00:17:24,530
الملكة هي من تستدعي الأطياف؟

240
00:17:24,530 --> 00:17:25,890
!مستحيل

241
00:17:26,790 --> 00:17:29,400
أنا من جلبتُ الأطياف؟

242
00:17:30,070 --> 00:17:32,890
.هذه تهمة لم أتوقّعها بكلّ تأكيد

243
00:17:32,890 --> 00:17:36,650
—لكن ليس لديّ وقت لنكات كهذه الآن

244
00:17:36,650 --> 00:17:37,690
!كلاّ

245
00:17:37,690 --> 00:17:42,910
هذا بالضّبط هو الوقت المناسب
!لطلب تفسير منك

246
00:17:42,910 --> 00:17:45,070
!وهذا لحماية رفاقي

247
00:17:47,130 --> 00:17:49,790
!استمعوا لي يا شعب سيفاندير

248
00:17:49,790 --> 00:17:53,200
!إنّ الأطياف لا تظهر بشكل طبيعيّ

249
00:17:52,340 --> 00:17:53,200
ماذا؟

250
00:17:53,200 --> 00:17:55,130
عمّ تتحدّث؟

251
00:17:53,660 --> 00:17:59,130
هناك جماعة تُدعى مخلصو النّاسك هي
!المسؤولة عن ظهور النّمسيس الطّيفيّة

252
00:18:02,390 --> 00:18:04,410
حاول مخلصو النّاسك

253
00:18:04,410 --> 00:18:10,080
فرض سيطرتهم عن طريق الخوف
،بأذيّة النّاس بالنّمسيس الطّيفيّة

254
00:18:10,080 --> 00:18:12,400
وكلّ ذلك لحماية هذه البلاد
.من التّهديدات الخارجيّة

255
00:18:13,090 --> 00:18:16,780
!لكن لا أعتقد أنّ ذلك صحيح

256
00:18:16,780 --> 00:18:19,990
!لذلك أنا أقدّم هذه التهمة الآن

257
00:18:20,660 --> 00:18:23,550
،قاعدة مخلصي النّاسك موجودة هنا

258
00:18:23,550 --> 00:18:26,050
!في قلب كاسلين مرلين

259
00:18:26,910 --> 00:18:29,920
!هذا يكفي أيّتها الصّغيرة

260
00:18:29,920 --> 00:18:33,670
!ما الّذي تفعلينه؟
!أمسكوا بها أيّها الحرس

261
00:18:38,060 --> 00:18:39,180
!جيزوني

262
00:18:41,300 --> 00:18:42,640
...هذه

263
00:18:42,640 --> 00:18:45,390
...يا لها من جيزوني قويّة

264
00:18:45,390 --> 00:18:49,760
الوحيدون الّذين لم يتأثّروا بها هم
.الفرسان السّحرة ذوي الخبرة

265
00:18:49,760 --> 00:18:52,820
حتّى أنا كنت لأقع تحت تأثيرها
!لو لم أكن حذرًا

266
00:18:58,530 --> 00:19:01,600
.يا لها من قوّة مذهلة

267
00:19:01,600 --> 00:19:04,780
.كلّ ما قلتِه قد فاجأني

268
00:19:04,780 --> 00:19:08,160
!يا جلالتك، أعطيني جوابًا صريحًا رجاءً

269
00:19:08,160 --> 00:19:11,420
لم تخفي أبدًا أيّ شيء عن شعبك، صحيح؟

270
00:19:11,830 --> 00:19:15,130
المواطنون الّذين نحتاج لحمايتهم
!موجودون هنا الآن

271
00:19:15,130 --> 00:19:19,140
!لذلك، لا تخفي الحقيقة
!أخبرينا بكلّ شيء

272
00:19:20,430 --> 00:19:23,430
!لا-لا تقلقوا

273
00:19:23,820 --> 00:19:26,860
!يا شعب سيفاندير الطّيّب

274
00:19:26,860 --> 00:19:31,440
!لا حاجة للاستماع لهذه الفتاة الحمقاء

275
00:19:31,440 --> 00:19:37,940
إنّها تحاول فقط خداعنا انتقامًا
!لعدم اختيارها

276
00:19:37,940 --> 00:19:42,370
أقسم لكلّ النّاس الّذين هنا
!أنّني أقول الحقيقة

277
00:19:42,370 --> 00:19:45,330
ماذا عنك أيّها السّيّد غوليس؟

278
00:19:45,330 --> 00:19:48,300
هل يمكنك أن تقسم أنّك تقول الحقيقة؟

279
00:19:48,580 --> 00:19:50,250
!اخرسي

280
00:19:50,610 --> 00:19:55,430
!يجب معاقبة الأطفال الأشقياء مثلك

281
00:20:01,090 --> 00:20:03,320
!سيّد برانغوار

282
00:20:03,320 --> 00:20:05,580
!ما معنى هذا؟

283
00:20:05,580 --> 00:20:08,350
.أنت تتصرّف بتسرّع أيّها السّيّد غوليس

284
00:20:08,350 --> 00:20:13,270
إنّ تصرّفاتك هذه تخبرني
!أنّ لك يدًا في هذه المؤامرة

285
00:20:14,100 --> 00:20:16,680
!والسّيّد غوليس ليس الوحيد في ذلك

286
00:20:16,680 --> 00:20:21,860
!أيّها الفرسان السّحرة
!مَن مِن بينكم كان يخدع الشّعب؟

287
00:20:27,370 --> 00:20:30,120
.يبدو أنّ رُبعكم تقريبًا كان كذلك

288
00:20:30,470 --> 00:20:31,620
!أيّها المواطنون

289
00:20:31,940 --> 00:20:36,250
!ما قالته هذه الفتاة مؤسف، ولكنّه الحقيقة

290
00:20:36,250 --> 00:20:38,500
!أنا أضمنها

291
00:20:42,010 --> 00:20:47,730
برانغوار، هذه ليست مسألة
.عليك الحديث عنها علنًا

292
00:20:48,290 --> 00:20:51,820
هل تحاول إزعاج شعبي
بغرض المتعة فقط؟

293
00:20:51,820 --> 00:20:54,090
،مع كلّ احترامي يا جلالتك

294
00:20:54,090 --> 00:20:58,400
.لا أستطيع الامتثال لأوامرك بعد الآن

295
00:20:58,400 --> 00:21:02,610
،كنتَ مخلصًا لي كلّ هذا الوقت

296
00:21:02,610 --> 00:21:07,910
ومع ذلك ها أنت تتحدّاني وتأخذ
جانب متدرّبة عديمة الخبرة؟

297
00:21:08,420 --> 00:21:10,690
!أنا فارس ساحر

298
00:21:10,690 --> 00:21:12,540
...وهذا يعني

299
00:21:12,540 --> 00:21:15,710
أنّني سأحمل سيفي ضدّ كلّ
!من يهدّد الشّعب أيّا كان

300
00:21:16,370 --> 00:21:17,920
...سيّد برانغوار

301
00:21:38,180 --> 00:21:40,690
!يا-يا جلالتك

302
00:21:40,690 --> 00:21:42,570
...إصاباتك

303
00:21:42,570 --> 00:21:44,940
!إ-إنّه العدوّ

304
00:21:45,820 --> 00:21:49,320
!وحدة التّفتيش تهاجمنا

305
00:22:01,550 --> 00:22:05,470
،عبر حرب جميلة ضدّ الفرسان السّحرة

306
00:22:05,470 --> 00:22:07,970
.سنعيد بناء علاقاتنا

307
00:22:07,970 --> 00:22:12,640
أقسم بلحيتي أنّني لم
!أكن أسعد من هذا قطّ

308
00:22:12,640 --> 00:22:17,470
هذا أشبه بلمّ شمل
!مع عائلة لم أرها منذ زمن

309
00:22:21,990 --> 00:22:23,870
.معك حقّ

310
00:22:23,870 --> 00:22:28,090
إنّه وقت لقاء عائلتي
.الّتي لم أرها منذ زمن

311
00:22:25,990 --> 00:22:29,990
يُتبع

312
00:24:00,000 --> 00:24:20,700
في الحلقة القادمة

313
00:24:00,750 --> 00:24:03,760
.بدأت وحدة التّفتيش غزوها

314
00:24:03,760 --> 00:24:07,230
أقسمت الملكة بوديكا أن تقاومهم
.حتّى الرّمق الأخير

315
00:24:07,230 --> 00:24:10,010
في تلك الأثناء، تسلّل سِث إلى القلعة

316
00:24:10,010 --> 00:24:12,370
.والتقى بديابال ثانية

317
00:24:12,370 --> 00:24:15,350
.وعرف بعدها سرّ بيودون

318
00:24:15,810 --> 00:24:18,150
من هذان الرّجلان يا ترى؟

319
00:24:18,150 --> 00:24:20,020
ومن هو سِث؟

320
00:24:20,580 --> 00:24:24,030
:"في الحلقة القادمة من "راديان
."ساحة المعركة الأخيرة"

321
00:24:25,020 --> 00:24:30,250
النّهاية