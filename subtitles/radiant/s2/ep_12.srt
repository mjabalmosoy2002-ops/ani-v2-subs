1
00:00:01,420 --> 00:00:05,690
،بينما كان سِث يزور كاسلين مرلين
،معقل الفرسان السّحرة

2
00:00:05,690 --> 00:00:10,340
تورّط في معركة ضدّ نمسيس
.طيفيّ غامض

3
00:00:11,220 --> 00:00:13,570
،وبعد فقدانه السّيطرة وتعرّضه للأذى

4
00:00:13,570 --> 00:00:18,020
،بدأ تدريبه مع جنّيّ الغابة مير

5
00:00:18,020 --> 00:00:19,990
.ليتعلّم كيف يتحكّم بقواه

6
00:00:19,990 --> 00:00:25,000
وعن طريق الإحساس بالفانتازيا
والتّواصل مع العالم، اكتسب سِث

7
00:00:25,000 --> 00:00:28,490
القدرة على التّحكّم بقوّته
.واستعمال سحر البناء

8
00:00:29,620 --> 00:00:31,200
،في تلك الأثناء في العاصمة

9
00:00:31,200 --> 00:00:34,260
،تمّ إيقاف ظهور النّمسيس الطّيفيّ

10
00:00:34,260 --> 00:00:38,150
.وعاد السّلام لأوّل مرّة منذ مدّة

11
00:00:40,380 --> 00:00:43,610
،ولكن، ما زالت المؤامرة قائمة في العاصمة

12
00:00:43,610 --> 00:00:47,830
.دون علم النّاس، ولكن في تقدّم منتظم

13
00:00:49,110 --> 00:00:52,830
.لحظة المصير وشيكة

14
00:02:26,410 --> 00:02:28,650
".الحقيقة أشبه بلعنة"

15
00:02:42,110 --> 00:02:43,530
هل ثمّة مهرجان؟

16
00:02:43,530 --> 00:02:47,260
توشك مراسم ترسيم الفرسان
.السّحرة أن تبدأ

17
00:02:47,260 --> 00:02:49,270
.ستملأ الحيويّة الشّوارع هنا

18
00:02:49,270 --> 00:02:51,460
!فعلاً؟ مرحى

19
00:02:51,460 --> 00:02:54,150
كم مرّت سنوات؟

20
00:02:54,150 --> 00:02:56,670
،بوجود كلّ هؤلاء الزّوّار

21
00:02:56,670 --> 00:02:59,400
!فهذه فرصتنا لجني ثروة

22
00:02:59,400 --> 00:03:02,900
!إنّها بركة مرلين العظيم

23
00:03:09,500 --> 00:03:13,500
.مهلاً، عليك ألاّ تتحرّك يا دراكون

24
00:03:14,250 --> 00:03:15,940
!جيّد، جيّد

25
00:03:16,460 --> 00:03:19,150
.مرّة أسبوع كامل بالفعل

26
00:03:19,150 --> 00:03:20,710
هل تقصدين سِث؟

27
00:03:20,710 --> 00:03:21,750
.نعم

28
00:03:23,310 --> 00:03:26,010
هل تعتقدين أنّه يتدرّب بالفعل؟

29
00:03:26,010 --> 00:03:27,890
.لا تقلقي بشأنه

30
00:03:27,890 --> 00:03:32,250
،إذا قال سِث أنّه سيقوم بشيء ما
.فسيبذل كلّ جهده فيه

31
00:03:32,250 --> 00:03:34,020
.هكذا إذًا

32
00:03:34,020 --> 00:03:37,810
.لكن لا يمكنني الجزم كيف يسير التّدريب

33
00:03:38,780 --> 00:03:39,650
.هكذا إذًا

34
00:03:39,650 --> 00:03:41,440
!معك حقّ

35
00:03:41,440 --> 00:03:44,910
،عندما يتحمّس بشأن أمر ما
!يقودنا ذلك للمشاكل فقط

36
00:03:45,270 --> 00:03:48,210
ميلي، انتهى تدريبك، صحيح؟

37
00:03:48,210 --> 00:03:50,070
—لذلك دعينا

38
00:03:50,070 --> 00:03:52,520
.أنا باقية حتّى المهرجان

39
00:03:53,420 --> 00:03:55,610
.اذهب وحدك إن كنت تريد الذّهاب

40
00:03:55,610 --> 00:04:00,550
كيف لطفل صغير مثلي أن يسافر
!كلّ تلك المسافة وحده؟

41
00:04:00,550 --> 00:04:03,130
لماذا أتيتَ إلى هنا من الأساس؟

42
00:04:03,130 --> 00:04:06,910
.هذا صحيح. لم أطلب منك أن تأتي معي

43
00:04:06,910 --> 00:04:10,180
!أتيتُ لأنّني كنتُ قلقًا عليكما

44
00:04:10,180 --> 00:04:13,610
!كنتِ تتصرّفين وكأنّ لا شيء حدث

45
00:04:13,610 --> 00:04:15,870
.أنت تقلق كثيرًا يا دوك

46
00:04:15,870 --> 00:04:17,440
!يا إلهي

47
00:04:17,440 --> 00:04:21,570
،إن كنتُ أعرف أنّ هذا المكان خطير
!ما كنتُ لآتي من الأساس

48
00:04:21,900 --> 00:04:26,540
.لكنّ النّمسيس الطّيفيّة لم تعد تظهر

49
00:04:27,370 --> 00:04:29,110
.لم نجد بعد من يقف خلف كلّ ذلك

50
00:04:29,700 --> 00:04:32,600
.لا بدّ أنّه ما زال مختبئًا في مكان ما

51
00:04:32,600 --> 00:04:35,460
!ما الّذي يفعله الرّجال في القلعة؟

52
00:04:35,870 --> 00:04:38,140
،بما أنّنا لا نعرف من المسؤول

53
00:04:38,140 --> 00:04:40,340
.فلا بدّ أنّه جزء من منظّمة ما

54
00:04:40,650 --> 00:04:43,250
هل تقصدين أنّ هنالك أعداءً في الدّاخل؟

55
00:04:43,250 --> 00:04:45,340
...إنّه انقلاب إذًا

56
00:04:48,370 --> 00:04:50,100
!آسفة

57
00:04:50,100 --> 00:04:52,290
!سأغادر غدًا

58
00:04:52,290 --> 00:04:53,750
!نلت كفايتي من هذا المكان

59
00:04:54,280 --> 00:04:58,530
!توقّف

60
00:04:56,460 --> 00:04:57,790
!مهلاً

61
00:05:02,230 --> 00:05:04,130
...سيّد برانغوار

62
00:05:04,790 --> 00:05:05,740
ثانية؟

63
00:05:08,370 --> 00:05:10,620
كم مرّة حدث ذلك حتّى الآن؟

64
00:05:11,870 --> 00:05:14,930
!لستُ خادمتك

65
00:05:15,620 --> 00:05:20,450
لماذا عليّ تنظيف دميتك
المحشوّة العملاقة الغبيّة؟

66
00:05:20,450 --> 00:05:22,310
!تعالي إلى هنا! سأهتمّ بك جيّدًا

67
00:05:22,310 --> 00:05:23,770
!مصيبة

68
00:05:23,770 --> 00:05:27,260
...كانت هادئة لفترة طويلة
!لكنّها عادت الآن

69
00:05:29,430 --> 00:05:31,870
!هذه هي ميلي الّتي أحبّ

70
00:05:33,220 --> 00:05:35,750
!حسنًا! حان وقت بعض التّدريب

71
00:05:36,180 --> 00:05:37,470
!لنبدأ

72
00:05:49,230 --> 00:05:50,580
.لستِ سيّئة

73
00:05:50,580 --> 00:05:52,120
.وكذلك أنت

74
00:05:52,530 --> 00:05:54,870
.سأوسعك ضربًا أكثر غدًا

75
00:05:55,330 --> 00:05:58,120
!غدًا؟ لا أطيق الانتظار

76
00:05:59,540 --> 00:06:01,930
ما خطبكما أنتما الاثنتان؟

77
00:06:02,420 --> 00:06:04,380
.حسنًا، لنذهب

78
00:06:04,380 --> 00:06:06,540
!مهلاً يا ميلي

79
00:06:06,540 --> 00:06:08,010
.أراكما غدًا إذًا

80
00:06:10,390 --> 00:06:11,490
.مرحبًا

81
00:06:12,640 --> 00:06:15,390
أوكوهو، هل لديك بعض الوقت؟

82
00:06:17,520 --> 00:06:19,900
!مهلاً! اتركيني

83
00:06:19,900 --> 00:06:23,020
.كلاّ. ستتمّ ملاحظتنا

84
00:06:23,020 --> 00:06:25,900
ماذا؟ ما الّذي تقصدينه؟

85
00:06:26,230 --> 00:06:28,660
.هنالك أمور خفيّة تجري في الخفاء

86
00:06:28,660 --> 00:06:29,410
ماذا؟

87
00:06:33,390 --> 00:06:34,990
...هل تقصدين

88
00:06:34,990 --> 00:06:36,650
.واصل الشّكوى

89
00:06:36,650 --> 00:06:39,820
،إن لاحظ أنّني اكتشفت أمره
.فسنكون في مشكلة

90
00:06:41,050 --> 00:06:45,300
!هذا مؤلم! توقّفي! النّجدة

91
00:06:46,350 --> 00:06:48,300
.يبدو أنّه يراقب الباب

92
00:06:48,680 --> 00:06:50,820
.إنّه يسعى خلف أوكوهو

93
00:06:50,820 --> 00:06:52,800
كنتِ تعلمين؟

94
00:06:52,800 --> 00:06:56,310
.كان يراقبنا طوال اليوم

95
00:06:56,310 --> 00:06:59,060
هل تعتقدين أنّه مع المجموعة
الّتي خلف المؤامرة؟

96
00:06:59,060 --> 00:07:00,270
.على الأرجح

97
00:07:00,270 --> 00:07:04,320
لكن... لا حاجة لنقحم أنوفنا
في المشاكل، صحيح؟

98
00:07:04,320 --> 00:07:05,440
!صه

99
00:07:07,650 --> 00:07:10,460
خرج شخص ما. أهي أوكوهو؟

100
00:07:32,340 --> 00:07:36,410
دعيني وشأني! لا أستطيع
!المواصلة على هذا الحال

101
00:07:36,410 --> 00:07:40,230
!لا تكن غبيًّا! ربّما يسعون خلفنا أيضًا

102
00:07:41,620 --> 00:07:43,970
!لا تدعيني رجاءً

103
00:07:43,970 --> 00:07:46,340
—توقّف! سوف

104
00:07:47,810 --> 00:07:50,570
!أنظروا من التقينا، محبوبتي

105
00:07:50,570 --> 00:07:54,620
!لا أصدّق أنّن التقينا هنا صدفة
!لا بدّ أنّه القدر

106
00:07:54,620 --> 00:07:56,370
!يا لغموض القدر الّذي لا مفرّ منه

107
00:07:56,370 --> 00:08:00,460
أيعقل أنّك أتيتِ إلى هنا فقط لرؤيتي؟

108
00:08:00,460 --> 00:08:01,450
ماذا؟

109
00:08:01,450 --> 00:08:03,170
!انظروا! إنّه السّيّد غوليس

110
00:08:03,170 --> 00:08:04,580
.نعم، مرحبًا. مرحبًا

111
00:08:03,380 --> 00:08:04,580
!الفارس الذّهبيّ

112
00:08:05,700 --> 00:08:09,020
،سمعتُ أنّك أتيتِ للعاصفة مؤخّرًا فقط

113
00:08:09,020 --> 00:08:11,130
.ولا تعرفين الكثير عن هذا المكان

114
00:08:11,130 --> 00:08:14,800
حسنًا، لماذا أخذك في نزهة
...في كلّ ركن من

115
00:08:15,790 --> 00:08:17,910
!أنا مستعجلة! ابتعد عن طريقي

116
00:08:16,190 --> 00:08:18,370
...خدّي... خدّي

117
00:08:18,370 --> 00:08:21,990
هذا مؤلم! لكنّ يد محبوبتي
!لمست خدّي

118
00:08:21,990 --> 00:08:25,900
!أهذا هو الحبّ؟ يا لها من نعمة
!لكنّ هذا مؤلم جدًّا

119
00:08:25,900 --> 00:08:27,810
...أيّها السّيّد غوليس

120
00:08:27,810 --> 00:08:30,020
.إنّه رجل طريف فعلاً

121
00:08:30,620 --> 00:08:32,400
.هنالك الكثير من النّاس

122
00:08:32,400 --> 00:08:35,320
.دوك، اسبقاني أنت وبوبري

123
00:08:35,320 --> 00:08:37,220
،أنت صغير الحجم
.لذلك لن تواجه مشكلة

124
00:08:37,220 --> 00:08:39,410
!ماذا؟! مستحيل

125
00:08:39,410 --> 00:08:40,670
.بوبري

126
00:08:41,950 --> 00:08:43,730
.استمع لي

127
00:08:44,140 --> 00:08:46,430
...إن استطعتَ اقتفاء أثره

128
00:08:46,430 --> 00:08:48,790
.فسأضربك كما لم تُضرب في حياتك

129
00:08:54,800 --> 00:08:57,150
!بوبري! سوف توقعني

130
00:08:57,150 --> 00:08:59,050
!ارتفع! ارتفع

131
00:08:59,390 --> 00:09:03,060
!سوف أصدم رأسي في الأرض

132
00:09:13,620 --> 00:09:15,320
!أنت

133
00:09:15,700 --> 00:09:18,320
!ستندمين على ما فعلته

134
00:09:22,700 --> 00:09:24,900
...هذا مؤلم

135
00:09:24,900 --> 00:09:26,590
من أنت؟

136
00:09:27,610 --> 00:09:29,210
هل تحاول اعتراض طريقي؟

137
00:09:30,220 --> 00:09:31,940
!لا على الإطلاق

138
00:09:33,010 --> 00:09:36,970
تـ-توقّف! ليس لديّ وقت
!لكما أيّها الضّعيفان

139
00:09:37,970 --> 00:09:40,220
!خائنة

140
00:09:42,270 --> 00:09:44,220
!تمّ الإمساك بي؟

141
00:09:46,390 --> 00:09:47,980
.ممتاز

142
00:09:48,420 --> 00:09:52,260
برانغوار، هل كنت تحاول قتل أوكوهو؟

143
00:09:52,260 --> 00:09:54,110
!لا تعرفين كم أنت مخطئة

144
00:09:55,210 --> 00:09:56,360
عمّ تتحدّث؟

145
00:09:56,360 --> 00:09:59,120
!غبيّة! افتحي عينيك

146
00:09:59,120 --> 00:10:03,240
!إنّها هي من تقف خلف ظهور الأطياف

147
00:10:06,890 --> 00:10:08,250
سِث؟

148
00:10:13,000 --> 00:10:19,010
.الحجر المنقوش الغامض] يُعثر على هذه الحجارة حيث تظهر النّمسيس الطّيفيّة]
...قيل أنّها كانت في حوزة أوكوهو

149
00:10:22,790 --> 00:10:25,530
!سِث! من أين أتيت؟

150
00:10:25,980 --> 00:10:29,270
هذه أوّل مـ-مرّة أكون فيها
!سعيدًا لرؤيتك

151
00:10:29,710 --> 00:10:31,820
!هذا ليس وقتًا مناسبًا للدّردشة

152
00:10:31,820 --> 00:10:32,740
!انهضا

153
00:10:33,700 --> 00:10:35,820
ما الّذي يحدث؟

154
00:10:36,530 --> 00:10:39,110
!إنّها جادّة

155
00:10:46,370 --> 00:10:47,660
!أوكوهو

156
00:10:47,660 --> 00:10:49,580
!ما خطبك؟

157
00:10:53,790 --> 00:10:56,040
!إ-إنّها تريد قتله بالفعل

158
00:10:56,040 --> 00:10:58,370
!د-دعني أدخل! بسرعة! بسرعة

159
00:10:58,370 --> 00:11:00,180
!أخرجيني من هنا في الحال

160
00:11:17,940 --> 00:11:19,340
!هذا يكفي

161
00:11:19,930 --> 00:11:22,110
!أوكوهو، توقّفي

162
00:11:22,110 --> 00:11:24,410
ما الّذي جعلكِ هكذا؟

163
00:11:27,430 --> 00:11:30,830
.هاتين العينين... رأيتُهما من قبل

164
00:11:30,830 --> 00:11:33,540
...يكفي! إن لم تستسلمي، فسوف

165
00:11:33,540 --> 00:11:36,210
!مهلاً! علينا أن نسمع ما لديها أوّلاً

166
00:11:36,210 --> 00:11:41,220
ابتعد يا فتى! كانت تحاول
!جعل نمسيس يظهر للتّوّ

167
00:11:46,350 --> 00:11:49,590
،أمسكتُ بها متلبّسة أخيرًا
!وأنتم أفسدتم الأمر

168
00:11:50,870 --> 00:11:54,480
أقسم باسم مرلين العظيم
!أنّني لن أدعك تهربين

169
00:11:56,480 --> 00:11:59,150
أوكوهو... تستدعي النّمسيس؟

170
00:12:00,990 --> 00:12:05,980
إذًا لم تكن أوكوهو ما كانت
...تدّعيه؟غير ممكن

171
00:12:05,980 --> 00:12:09,490
!ميلي! علينا الإمساك بها قبل برانغوار

172
00:12:10,570 --> 00:12:13,000
!لم تكن على طبيعتها

173
00:12:13,370 --> 00:12:16,750
هل تقول أنّ هنالك من يتحكّم بها؟

174
00:12:16,750 --> 00:12:18,240
.لا أدري

175
00:12:19,980 --> 00:12:22,450
!في كلّ الأحوال! علينا الوصول لها أوّلاً

176
00:12:22,450 --> 00:12:23,940
!دعي الأمر لي

177
00:12:23,940 --> 00:12:27,140
كيف تنوي أن تسبقه؟

178
00:12:27,140 --> 00:12:28,680
!كفّ عن التّصرّف بغباء واركب معي

179
00:12:28,680 --> 00:12:30,810
!أعرف طريقًا مختصرة

180
00:12:30,810 --> 00:12:32,560
!يا سِث

181
00:12:36,050 --> 00:12:39,590
مهلاً... هل نسيتما أمري؟

182
00:12:44,140 --> 00:12:47,200
.حسنًا، هذا كلّ شيء لهذا اليوم

183
00:12:48,530 --> 00:12:50,580
ما الأمر أيّها الزّعيم؟

184
00:12:50,890 --> 00:12:54,680
.انظر هناك، إلى الطّريق نحو القلعة

185
00:12:54,680 --> 00:12:55,830
...يبدو مثل

186
00:12:58,340 --> 00:13:00,490
!د-دولاهان

187
00:13:00,490 --> 00:13:02,860
!لا يجد رأس على كتفيه

188
00:13:02,860 --> 00:13:05,590
!دولاهان على أرضي؟

189
00:13:05,590 --> 00:13:06,830
!علينا الهرب

190
00:13:06,830 --> 00:13:07,790
...مهلاً

191
00:13:07,790 --> 00:13:09,730
!إنّه جالب الانتقام

192
00:13:09,730 --> 00:13:11,690
!سيظهر طيف لا محالة

193
00:13:11,690 --> 00:13:12,460
!مهلاً

194
00:13:12,460 --> 00:13:16,170
!حدث هذا لأنّها قبلنا بعرض التّجّار البارونات

195
00:13:16,170 --> 00:13:20,610
!لا بدّ أنّ مرلين العظيم قد أرسله ليعاقبنا

196
00:13:33,050 --> 00:13:35,510
.نعم. إنّها غابة كايلت

197
00:13:45,880 --> 00:13:48,690
أوكوهو! ماذا تفعلين؟

198
00:13:48,690 --> 00:13:51,940
!لماذا يحدث هذا لك؟

199
00:13:53,500 --> 00:13:56,150
!سُحقًا! كفّي عن مقاومتي

200
00:13:56,150 --> 00:13:58,140
!اهدئي فحسب

201
00:13:59,650 --> 00:14:02,370
.ماذا؟ هذا أسهل ممّا ظننت

202
00:14:03,060 --> 00:14:06,650
!أحسنت! لا تتركها

203
00:14:07,270 --> 00:14:09,260
!خائنة

204
00:14:09,260 --> 00:14:12,660
!لديّ دليل الآن! لن أسمع أيّة أعذار

205
00:14:12,660 --> 00:14:16,330
ماذا؟ السّيّد برانغوار؟

206
00:14:16,330 --> 00:14:18,370
وميلي أيضًا؟

207
00:14:19,040 --> 00:14:23,700
سِث؟ لماذا تمسكني من عنقي؟

208
00:14:23,700 --> 00:14:25,170
ماذا يحدث؟

209
00:14:26,300 --> 00:14:28,970
!مهلاً... أنتم تخيفونني

210
00:14:28,970 --> 00:14:32,300
!ما الّذي تحاولون فعله؟ أخبروني

211
00:14:36,100 --> 00:14:38,600
أنا الخائنة؟

212
00:14:38,600 --> 00:14:42,730
!لا أعرف عمّ تتحدّث
!لا علاقة لي بالأمر

213
00:14:42,730 --> 00:14:44,450
!كاذبة

214
00:14:44,450 --> 00:14:48,110
!حاولتِ للتّوّ جعل نمسيس طيفيّ يظهر

215
00:14:48,110 --> 00:14:51,190
!ماذا تقول؟! ذلك مستحيل

216
00:14:51,190 --> 00:14:52,890
ما الّذي يحدث؟

217
00:14:52,890 --> 00:14:54,380
.لا فكرة لديّ

218
00:14:54,380 --> 00:14:57,610
.لكن أعتقد أنّ أوكوهو لا تكذب

219
00:14:59,190 --> 00:15:01,080
!لن أُخدع بسهولة

220
00:15:01,080 --> 00:15:03,770
!كنتُ أراقبها طوال هذا الوقت

221
00:15:04,500 --> 00:15:07,120
كنتَ تشكّ في أمرها طوال الوقت؟

222
00:15:07,120 --> 00:15:10,140
.بدت أنّها تخفي سرًّا ما

223
00:15:10,770 --> 00:15:14,010
كلّ ما فعلته هو تجاهل أوامري
.والتّصرّف على هواها

224
00:15:14,010 --> 00:15:18,290
وعندما بدأت الملكة بالحديث
،عن النّمسيس الطّيفيّة

225
00:15:18,290 --> 00:15:20,560
.توتّرت ملامح وجهها

226
00:15:20,560 --> 00:15:22,850
.والآن، ناوليني يديك

227
00:15:23,610 --> 00:15:25,190
!لستُ أكذب

228
00:15:25,190 --> 00:15:27,700
.إنّه تخبرك أنّك مخطئ

229
00:15:27,700 --> 00:15:29,400
.علينا سماع ما لديها لتقوله

230
00:15:29,400 --> 00:15:32,320
كلاكما رأيتماها! لماذا تنكران الأمر؟

231
00:15:32,320 --> 00:15:36,180
،إن كنتَ تقول أنّها مثيرة للشّبهات
.فأنت مثير للشّبهات أيضًا

232
00:15:36,180 --> 00:15:37,450
!ماذا؟

233
00:15:37,450 --> 00:15:39,280
،عندما عدتُ من الغابة اليوم

234
00:15:39,280 --> 00:15:43,050
،رأيتُك تلاحق أوكوهو وتراقبها عن كثب

235
00:15:43,050 --> 00:15:44,420
.لذلك بدأت أراقبك

236
00:15:45,100 --> 00:15:46,980
.كان مجرّد إحساس

237
00:15:46,980 --> 00:15:51,270
،ماذا؟ إن كنتَ قد عدت
!فكان عليك إخبارنا باكرًا

238
00:15:51,270 --> 00:15:53,050
.أنا آسف على ذلك

239
00:15:53,050 --> 00:15:57,200
كان الحجر معي بالفعل، صحيح؟

240
00:15:57,200 --> 00:15:59,540
.أعتقد أنّكم على حقّ

241
00:15:59,540 --> 00:16:01,310
...نـ-نعم

242
00:16:01,310 --> 00:16:05,410
.ومع ذلك... لا أعرف أيّ شيء

243
00:16:08,220 --> 00:16:09,820
...هذه العلامة

244
00:16:09,820 --> 00:16:15,320
،عندما يضغط عليها أحد ما
.أبدأ بفعل أيّ شيء يملونه عليّ

245
00:16:15,320 --> 00:16:19,110
.وأقد كلّ ذكرياتي عمّا يحدث خلال ذلك

246
00:16:19,900 --> 00:16:22,740
تلك هي لعنتك إذًا؟

247
00:16:22,740 --> 00:16:24,080
.نعم

248
00:16:24,080 --> 00:16:25,750
ما الّذي تقولينه؟

249
00:16:25,750 --> 00:16:30,090
.إنّها تقول أنّ هنالك من استغلّها
!سحقًا لهذا

250
00:16:36,010 --> 00:16:38,470
.ضعي حدًّا لحياتك

251
00:16:39,970 --> 00:16:40,850
!إيّاك

252
00:16:41,210 --> 00:16:42,100
.توقّفي

253
00:16:46,930 --> 00:16:49,500
...ما الّذي

254
00:16:49,500 --> 00:16:51,610
.فهمت الأمر الآن

255
00:16:51,610 --> 00:16:55,990
أوكوهو، هل يعرف أيّ شخص
آخر بأمر تلك العلامة؟

256
00:16:55,990 --> 00:16:57,530
.كلاّ

257
00:16:57,530 --> 00:17:00,400
.هذا هو قانون هذه البلاد

258
00:17:00,400 --> 00:17:03,470
.علينا إبقاء لعناتنا سرًّا

259
00:17:04,190 --> 00:17:09,110
،إذًا أيًّا كان من يعرف بأمر تلك العلامة
.فهو من يقف خلف هذه الحوادث

260
00:17:09,110 --> 00:17:12,800
!أرأيت؟ لم تكن أوكوهو المسؤولة

261
00:17:14,790 --> 00:17:18,010
أوكوهو، عليك العودة للقلعة

262
00:17:18,010 --> 00:17:22,810
وواصلي حياتك كالمعتاد
.إلى أن نكتشف من خلف هذا

263
00:17:22,810 --> 00:17:24,560
ستتركني أذهب؟

264
00:17:24,560 --> 00:17:28,370
ما باليد حيلة. لا نريد للعدوّ
.أن يشكّ في أيّ شيء

265
00:17:28,370 --> 00:17:30,570
أنت تتركها تذهب عمدًا إذًا؟

266
00:17:30,570 --> 00:17:33,070
.سأمسك قطعًا بمن يقف وراء هذا

267
00:17:33,070 --> 00:17:36,620
لن أسمح بأيّ شخص آخر
.باكتشاف أمر لعنتك

268
00:17:36,620 --> 00:17:37,910
.لا تقلقي

269
00:17:40,010 --> 00:17:41,020
...ولكن

270
00:17:41,490 --> 00:17:45,500
لا أستطيع السّماح لشخص يمكن التّلاعب
به بسهولة هكذا من طرف العدوّ

271
00:17:45,500 --> 00:17:48,080
.أن يصبح فارسًا ساحرًا

272
00:17:48,690 --> 00:17:51,090
.سأعارض ترسيمك

273
00:17:59,630 --> 00:18:01,050
.أنا آسف

274
00:18:01,050 --> 00:18:03,970
...إن كان هنالك ما نساعدك به

275
00:18:03,970 --> 00:18:06,980
!صحيح، مثل أن نوسعه ضربًا

276
00:18:07,460 --> 00:18:09,900
أوكوهو، ماذا نفعل؟

277
00:18:12,390 --> 00:18:13,900
.عليّ رؤية موردرد

278
00:18:14,610 --> 00:18:17,860
.لطالما أنقذني

279
00:18:18,540 --> 00:18:20,620
.هنالك أمر أريد اكتشافه

280
00:18:20,620 --> 00:18:23,830
ماذا؟ ما الغاية من هذا الآن؟

281
00:18:23,830 --> 00:18:25,500
...بالتّفكير في الأمر

282
00:18:25,850 --> 00:18:29,530
.رأيتك معه في الإسطبل قبل مدّة

283
00:18:30,750 --> 00:18:33,910
.ظننتُ أنّه كان يقبّلك

284
00:18:35,310 --> 00:18:40,260
،لكن أصبحت عيناك صفراوتان بعدها
.كما كانتا قبل قليل

285
00:18:45,650 --> 00:18:49,610
!كيف لك أن تتركي طفلاً في مكان كهذا؟

286
00:18:49,610 --> 00:18:51,500
.آسفة يا دوك

287
00:18:53,530 --> 00:18:56,900
تسبّبت في الكثير من المشاكل لكم، صحيح؟

288
00:18:56,900 --> 00:19:00,130
.لا تقلقي بشأن ذلك
.هكذا الوضع دائمًا بالنّسبة لنا

289
00:19:00,130 --> 00:19:02,790
.لا أتحمّل كلّ هذا

290
00:19:03,210 --> 00:19:07,290
ثمّة الكثير من الفانتازيا مخزّنة
.في هذا الحجر

291
00:19:07,290 --> 00:19:12,290
كنتِ ستستعملين ذلك لتفعيل
سحر الإسقاط؟

292
00:19:12,290 --> 00:19:14,530
...لكنّ هذا غريب

293
00:19:14,530 --> 00:19:17,870
.أشعر أنّ هذه الفانتازيا مشابهة لخاصّتي

294
00:19:17,870 --> 00:19:18,800
ماذا؟

295
00:19:19,420 --> 00:19:20,730
...ديابال

296
00:19:20,730 --> 00:19:22,180
من يكون؟

297
00:19:22,890 --> 00:19:24,970
.الشّخص الّذي قابلته تحت القلعة

298
00:19:25,710 --> 00:19:28,560
!أنا واثق أنّه يعرف أمرًا ما

299
00:19:29,830 --> 00:19:32,190
لكن لا نستطيع تجاوز الحرّاس، صحيح؟

300
00:19:32,190 --> 00:19:34,260
.لا، مهلاً

301
00:19:34,260 --> 00:19:37,940
قد يكون من السّهل الدّخول
.في يوم مراسم التّرسيم

302
00:19:38,750 --> 00:19:42,390
ستكون الحماية أخفّ حلو القلعة
.بوجود كلّ الاحتفالات

303
00:19:42,390 --> 00:19:43,950
.هذا ممتاز

304
00:19:43,950 --> 00:19:48,450
اعتدت التّسلّل إلى القلعة
.هكذا عندما كنتُ صغيرة

305
00:19:48,870 --> 00:19:50,580
...مع أعزّ أصدقائي

306
00:19:51,890 --> 00:19:54,340
.عليّ رؤية موردرد

307
00:19:55,330 --> 00:19:57,090
...أخبريني يا أوكوهو

308
00:19:57,700 --> 00:20:02,220
إن حاول أيّ شخص لمس تلك العلامة
.في عنقك، فأوسعيه ضربًا

309
00:20:02,710 --> 00:20:04,580
،لا يهمّ ما يقوله أيّ أحد

310
00:20:04,580 --> 00:20:08,650
.فإنّ لعنتك لا تقرّر مصيرك

311
00:20:08,650 --> 00:20:11,010
.لا تدعي أيّ أحد يتدخّل في ذلك

312
00:20:11,730 --> 00:20:15,230
.وإن احتجتِ للمساعدة، فسنكون إلى جانبك

313
00:20:16,490 --> 00:20:17,730
.نعم

314
00:20:18,290 --> 00:20:19,310
.شكرًا

315
00:20:28,790 --> 00:20:33,560
نجح كلّ من دراغونوف وليزيلوت
،في التّسلّل إلى سيفاندير

316
00:20:33,560 --> 00:20:37,750
لكنّهما الآن قد تلقّيا أوامر سرّيّة
،جديد من الجنرال تورك

317
00:20:37,750 --> 00:20:40,070
.وهما في طريقهما إلى مكان معيّنة

318
00:20:44,000 --> 00:20:46,140
ماذا ستكون يا ترى؟

319
00:20:46,690 --> 00:20:50,350
.كما أنّهم اختاروا مكانًا غريبًا لنذهب إليه

320
00:20:51,990 --> 00:20:56,750
.إمّا أنّهم حذرون للغاية أو يشعرون بالذّنب

321
00:20:57,180 --> 00:21:00,650
في كلّ الأحوال، هذا أمر
.مباشر من الجنرال تورك

322
00:21:01,190 --> 00:21:02,900
...أخبرني يا دراغونوف

323
00:21:03,300 --> 00:21:07,350
عندما قال الجنرال تورك أنّك ستصبح
،من صانعي المعجزات

324
00:21:07,350 --> 00:21:10,660
.لم تبدُ لي متحمّسًا كثيرًا

325
00:21:11,010 --> 00:21:13,220
.ذلك ليس صحيحًا تمامًا

326
00:21:13,220 --> 00:21:15,670
لكلّ امرئ طريقته الخاصّة
.في التّعبير عن الفرح

327
00:21:15,670 --> 00:21:19,390
لكن عندما أُمرتَ أن تطارد
،السّاحر ذو القرنين

328
00:21:19,390 --> 00:21:21,860
.لم تحاول إخفاء مدى سرورك

329
00:21:22,920 --> 00:21:26,990
دراغونوف، إن حاولتَ التّصرّف
،وفقًا لحكمك الخاصّ

330
00:21:26,990 --> 00:21:29,930
.فلن يكون لي خيار سوى معاقبتك

331
00:21:32,180 --> 00:21:35,560
.لا بأس. سأعترف

332
00:21:35,560 --> 00:21:38,460
لكن احتفظي بهذا سرًّا بيننا، موافقة؟

333
00:21:40,180 --> 00:21:42,940
...سبب سعادتي حينها

334
00:21:43,370 --> 00:21:46,960
هو أنّني رأيتها كفرصة
...للتّقرّب من شخص ما

335
00:21:46,960 --> 00:21:48,320
.أيّتها القائد ليزيلوت

336
00:21:49,430 --> 00:21:50,540
...مهلاً

337
00:21:58,850 --> 00:22:01,050
.يبدو أنّنا وصلنا

338
00:22:10,460 --> 00:22:13,840
.مرحبًا، نحن سعداء بوصولكما

339
00:22:13,840 --> 00:22:16,600
.آسف لأنّ مكان اللّقاء غير لائق

340
00:22:16,600 --> 00:22:22,110
أنتما القائدان ليزيلوت ودراغونوف
من صانعي المعجزات، صحيح؟

341
00:22:25,990 --> 00:22:29,990
يُتبع

342
00:24:00,000 --> 00:24:20,700
في الحلقة القادمة

343
00:24:00,650 --> 00:24:04,010
.تحقّق أوكوهو مع صديقها المقرّب موردرد

344
00:24:04,010 --> 00:24:06,410
لماذا حاول استغلالها؟

345
00:24:06,410 --> 00:24:10,010
"من هم "المخلصون للنّاسك
الّذين يكيدون خلف كواليس البلاد؟

346
00:24:10,010 --> 00:24:12,060
بمن يمكنها أن تثق؟

347
00:24:12,060 --> 00:24:13,900
ما هو طموح الفرسان الحقيقيّ؟

348
00:24:13,900 --> 00:24:16,110
،وأيضًا، في يوم مراسم التّرسيم

349
00:24:16,110 --> 00:24:20,860
تمنح أوكوهو الملكة نصيحة
.آملة في إظهار الحقيقة

350
00:24:20,860 --> 00:24:23,870
:"في الحلقة القادمة من "راديان
."إنّه قرارك"

351
00:24:25,020 --> 00:24:30,250
النّهاية