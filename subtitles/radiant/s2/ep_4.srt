1
00:00:01,340 --> 00:00:04,020
،بعد لقائه برجل عجوز غريب يُدعى مير

2
00:00:04,020 --> 00:00:07,150
يلتقي سِث بمتقدّمة لتصبح
.فارسة ساحرة تُدعى أوكوهو

3
00:00:07,700 --> 00:00:10,900
،لكن بينما كانا يقاتلان نمسيس طيفيّ

4
00:00:10,900 --> 00:00:15,990
وقع سِث عن ظهر التّنّين الّذي كانا
.يركبانه عندما كان يحمي أوكوهو

5
00:00:15,990 --> 00:00:17,120
سِث؟

6
00:00:17,120 --> 00:00:18,870
!سِث

7
00:00:19,190 --> 00:00:20,980
!قُطع الاتّصال

8
00:00:20,980 --> 00:00:23,370
!توجّهوا إلى أقرب نقطة استعداد للتّنانين

9
00:00:23,370 --> 00:00:25,320
!ابتعدي عن الطّريق يا أوكوهو

10
00:00:25,320 --> 00:00:28,330
.الـ-المعذرة، لقد سقط مساعدي

11
00:00:28,330 --> 00:00:31,260
!لقد انفصلتِ عن تعويذة جيزوني
!أنت تؤخّرين عملنا

12
00:00:33,820 --> 00:00:35,010
...سِث

13
00:02:12,050 --> 00:02:13,850
".جالب الكوارث"

14
00:02:18,830 --> 00:02:20,110
.هذا مريع

15
00:02:20,110 --> 00:02:22,420
.هيّا، علينا أن نبتعد من هنا

16
00:02:22,420 --> 00:02:24,930
.لكن لا يمكننا ترك لحقل ببساطة هكذا

17
00:02:24,930 --> 00:02:26,410
!أبي، انظر

18
00:02:39,980 --> 00:02:42,270
.كا-كان ذلك مخيفًا

19
00:02:42,950 --> 00:02:46,350
ما زلت لا أستطيع استجماع
.الفانتازيا بيدي اليسرى

20
00:02:46,970 --> 00:02:49,000
هل السّبب هو إصابتها بسيف تورك؟

21
00:02:50,750 --> 00:02:53,980
.يدي اليمنى... تبدو بخير

22
00:02:53,980 --> 00:02:56,610
!مذهل! فارس ساحر بقرنين

23
00:02:56,610 --> 00:03:00,090
.لا يوجد فرسان بقرون

24
00:03:00,090 --> 00:03:03,170
أنتم هناك! ما الّذي تفعلونه؟

25
00:03:03,170 --> 00:03:05,010
!ثمّة نمسيس في الجوار

26
00:03:05,010 --> 00:03:06,620
!نعرف ذلك

27
00:03:06,620 --> 00:03:09,870
!رأيناه يظهر من العدم

28
00:03:09,870 --> 00:03:11,430
من العدم؟

29
00:03:12,180 --> 00:03:15,380
ألم تسقط بيضة من السّماء أوّلاً؟

30
00:03:15,380 --> 00:03:17,850
.لا، لا

31
00:03:17,850 --> 00:03:22,640
!كنّا نعمل في الحقل عندما ظهر فجأة

32
00:03:23,060 --> 00:03:24,730
...ما الّذي

33
00:03:25,390 --> 00:03:27,330
!في كلّ الأحوال، التّواجد هنا خطير

34
00:03:27,330 --> 00:03:28,870
!سِث

35
00:03:32,250 --> 00:03:34,020
!أوكوهو

36
00:03:34,020 --> 00:03:36,770
!أنا سعيدة لأنّك بخير

37
00:03:36,770 --> 00:03:37,780
—أكيد

38
00:03:39,900 --> 00:03:43,030
!أوكوهو! أستسلم! أستسلم! أستسلم

39
00:03:43,030 --> 00:03:46,530
لماذا حاولت أن تتصدّى لذلك
!الهجوم بيد عارية؟

40
00:03:46,530 --> 00:03:50,230
.حسنًا... لم أستطع استعمال سحري جيّدًا

41
00:03:50,730 --> 00:03:52,820
!كان عليك تفاديه إذًا

42
00:03:52,820 --> 00:03:54,870
!لذلك السّبب سلّمتُ القيادة

43
00:03:54,870 --> 00:03:57,090
!هذا مؤلم، مؤلم

44
00:03:59,050 --> 00:04:02,280
ما كان ذلك؟ هجوم نمسيس؟

45
00:04:02,280 --> 00:04:04,350
.كلاّ. انظر للأعلى

46
00:04:11,980 --> 00:04:14,290
!يعبر سحرهم من خلاله

47
00:04:14,290 --> 00:04:18,060
.إنّهم يضعفونه قبل أن يطلقوا الهجوم الأخير

48
00:04:22,700 --> 00:04:25,760
...كلاّ... كان ذلك جاهزًا لنحصده

49
00:04:25,760 --> 00:04:26,880
...نعم

50
00:04:26,880 --> 00:04:31,340
هذا عقابنا لأنّك قرّرت التّعامل
!مع ذلك الأجنبيّ

51
00:04:31,340 --> 00:04:33,370
!ما-ماذا؟

52
00:04:33,370 --> 00:04:34,690
.هذا ليس عقابًا

53
00:04:34,690 --> 00:04:36,790
رأيت الدّولاهان، صحيح يا أبي؟

54
00:04:36,790 --> 00:04:38,290
.إنّها اللّعنة

55
00:04:38,290 --> 00:04:39,590
!نعم

56
00:04:39,950 --> 00:04:41,300
الدّولاهان"؟"

57
00:04:41,840 --> 00:04:44,750
.سِث، علينا الابتعاد من هنا

58
00:04:44,750 --> 00:04:46,390
.الهجوم التّالي قادم

59
00:04:53,730 --> 00:04:54,810
!سِث؟

60
00:04:58,450 --> 00:04:59,840
!من الصّعب التّحرّك بهذا الدّرع

61
00:05:02,310 --> 00:05:04,070
!صدّ

62
00:05:12,330 --> 00:05:15,330
!كان ذلك رائعًا! ما ذلك الدّرع؟

63
00:05:15,930 --> 00:05:17,220
ما الّذي تفعله؟

64
00:05:17,220 --> 00:05:19,850
ألا يمكنك حتّى استعمال "قبّة الحماية"؟

65
00:05:20,570 --> 00:05:22,420
،ما دمتِ تملكين ذلك

66
00:05:22,420 --> 00:05:24,590
!لن تصيبنا الهجمات من الأعلى

67
00:05:26,100 --> 00:05:28,720
.لم أتلقَّ أيّة أوامر بذلك

68
00:05:29,130 --> 00:05:32,180
أوامر؟ أيّة أوامر؟

69
00:05:32,180 --> 00:05:34,750
هل تلقّيتم أوامر بالهجوم
وتدمير هذه المزرعة؟

70
00:05:34,750 --> 00:05:36,540
!بالطّبع لا

71
00:05:36,540 --> 00:05:39,730
!مهمّتنا هي هزيمة النّمسيس

72
00:05:39,730 --> 00:05:42,840
إذًا فأنتم لا تهتمّون لما عليكم
فعله لإنجاز ذلك؟

73
00:05:42,840 --> 00:05:45,240
حتّى إن عنى ذلك تدمير مزارع
أشخاص بحاجة إليها؟

74
00:05:45,240 --> 00:05:48,290
!إنّكم بذلك لا تختلفون عن النّمسيس

75
00:05:56,000 --> 00:05:58,730
.يتعلّق الأمر بأكثر من مجرّد إنقاذ الأرواح

76
00:05:59,340 --> 00:06:02,580
.سيتضوّر النّاس جوعًا بدون هذه المزرعة

77
00:06:03,630 --> 00:06:04,880
.سأذهب للقتال

78
00:06:05,580 --> 00:06:07,010
ماذا عنك أنت؟

79
00:06:09,270 --> 00:06:10,300
.مفهوم

80
00:06:13,140 --> 00:06:17,460
.سأستعمل كرومن. ساعدني

81
00:06:17,870 --> 00:06:19,580
كرومن"؟"

82
00:06:19,580 --> 00:06:22,290
.إنّها تعويذة لحماية منطقة كبيرة

83
00:06:22,290 --> 00:06:28,200
،كلّما زاد عدد السّحرة الّذين يستعملونها
.فسيزداد تأثيرها ولو بساحر واحد فقط

84
00:06:28,200 --> 00:06:29,530
.مفهوم

85
00:06:31,030 --> 00:06:32,270
.سنبدأ

86
00:06:32,700 --> 00:06:34,450
!كرومن

87
00:06:39,540 --> 00:06:41,580
!ما الّذي حدث؟

88
00:06:41,580 --> 00:06:44,550
.إنّ قوّتنا تُستنزف منّا

89
00:06:48,660 --> 00:06:52,050
.ما هذا؟ وكأنّني داخل بحر من الفانتازيا

90
00:06:52,580 --> 00:06:55,560
هل هو قادر على تجميع فانتازيا
بهذا الكمّ الهائل؟

91
00:06:55,910 --> 00:06:57,650
!من يكون هذا الفتى؟

92
00:06:58,990 --> 00:07:02,100
!سيّد برانغوار، سوف تُكسر تعويذة جيزوني

93
00:07:06,590 --> 00:07:09,590
.يبدو أنّ تلك القبّة تبتلع كلّ الفانتازيا

94
00:07:09,590 --> 00:07:12,490
!موردرد! بدأ النّمسيس بالاختفاء

95
00:07:13,320 --> 00:07:15,070
.لنهاجمه بسرعة

96
00:07:15,070 --> 00:07:15,580
.نعم

97
00:07:30,460 --> 00:07:32,340
.أعتقد أنّنا نجحنا

98
00:07:34,740 --> 00:07:37,600
.لكنّه كان نمسيس غريبًا

99
00:07:43,740 --> 00:07:45,620
...يا للفوضى

100
00:07:45,620 --> 00:07:48,680
.وكان المحصول جاهزًا للحصاد تقريبًا

101
00:07:48,680 --> 00:07:51,610
.لا يمكننا بيع أيّ من هذا

102
00:07:55,950 --> 00:07:58,430
،بفضل جهودكم جميعًا

103
00:07:58,430 --> 00:08:01,910
.نجحنا في هزيمة النّمسيس الطّيفيّ

104
00:08:03,540 --> 00:08:05,100
!أحسنتم

105
00:08:05,100 --> 00:08:09,170
.من المؤكّد أنّكم ستصبحون فرسانًا سحرة

106
00:08:09,670 --> 00:08:10,670
...ولكن

107
00:08:11,050 --> 00:08:13,300
أولئك الّذين سيكونون عظماء عن حقّ

108
00:08:13,660 --> 00:08:17,930
.هما موردرد وساغرامور

109
00:08:18,250 --> 00:08:21,020
!أمّا بقيّتكم فمجرّد حثالة

110
00:08:21,020 --> 00:08:24,670
!لماذا كسرتم التّشكيلة وتوقّفتم عن الهجوم؟

111
00:08:24,670 --> 00:08:27,940
هل تعتقدون أنّ بإمكانكم أن تصبحوا
!فرسانًا سحرة هكذا؟

112
00:08:27,940 --> 00:08:31,070
...مـ-مع كلّ احترامي يا سيّد برانغوار

113
00:08:31,710 --> 00:08:36,030
.لم يكن لدينا فانتازيا كافية حينها

114
00:08:36,030 --> 00:08:37,410
!ماذا؟

115
00:08:37,410 --> 00:08:41,930
أعتقد أنّ ذلك كان بسبب السّحر
.الّذي استعملته أوكوهو على الأرض

116
00:08:41,930 --> 00:08:43,660
!أوافقه الرّأي أيضًا

117
00:08:43,660 --> 00:08:45,280
!أيّها الوغد

118
00:08:45,280 --> 00:08:47,420
!استعملتم سحرًا على الأرض؟

119
00:08:47,420 --> 00:08:50,270
!كيف تفعلون شيئًا كهذا دون إذني؟

120
00:08:50,270 --> 00:08:51,990
!أجبني يا أوكوهو

121
00:08:51,990 --> 00:08:54,690
.أ... أنا هي أوكوهو

122
00:08:57,550 --> 00:08:59,120
!سُحقًا لك

123
00:08:59,120 --> 00:09:01,250
!كم مرّة عليّ تكرار كلامي؟

124
00:09:01,250 --> 00:09:04,310
!أنتم لا شيء وحدكم

125
00:09:04,830 --> 00:09:08,980
أفكاركم وقدراتكم الفرديّة
!لا فائدة منها في المعركة

126
00:09:08,980 --> 00:09:09,730
—ولكن

127
00:09:09,730 --> 00:09:11,320
!لا أقبل أيّة أعذار

128
00:09:11,770 --> 00:09:15,500
هل أردت جلب الأنظار إليك فحسب؟

129
00:09:15,500 --> 00:09:19,700
في تلك الحالة، لماذا لا تصبحين
!مغنّية أو بهلوانيّة بدل فارسة؟

130
00:09:19,700 --> 00:09:23,330
اذهبي للانضمام إلى المهرّجين
!في أرتميس أو ما شابه

131
00:09:23,910 --> 00:09:26,650
!هل نسيتِ تعاليم العظيم مرلين؟

132
00:09:26,650 --> 00:09:30,000
،الفرد ليس الجزء المهمّ
!بل العمل الجماعيّ المتناغم

133
00:09:30,000 --> 00:09:31,590
!إنّه جيزوني

134
00:09:31,590 --> 00:09:35,470
.أرى أنّك لم تتغيّر يا برانغوار

135
00:09:35,470 --> 00:09:37,340
...ذلك الصّوت

136
00:09:37,340 --> 00:09:40,410
!صا-صاحبة الجلالة

137
00:09:41,970 --> 00:09:47,980
.جيزوني] سحر يُزامن الحواسّ مع الآخرين]
.يسمح التّناغم بإظهار قوّة تتجاوز القدرات الفرديّة

138
00:09:52,630 --> 00:09:56,350
!وصلت صاحبة الجلالة الملكة بوديكا

139
00:09:56,860 --> 00:09:59,310
!أيّها الفرسان! انحنوا لملكتكم

140
00:10:01,370 --> 00:10:02,870
ماذا؟ ماذا؟

141
00:10:03,420 --> 00:10:07,750
لماذا تركعون بركبة واحدة فقط؟

142
00:10:08,790 --> 00:10:11,100
!الـ-المعذرة يا جلالتك

143
00:10:11,100 --> 00:10:14,880
إنّها ضخمة! هل تلك لعنة أيضًا؟

144
00:10:15,290 --> 00:10:20,060
يا صاحبة الجلالة، لم أتوقّع ظهورك
!في مكان كهذا

145
00:10:20,060 --> 00:10:22,090
!أتوسّل مغفرتك

146
00:10:22,090 --> 00:10:23,760
.لا بأس

147
00:10:23,760 --> 00:10:26,630
.أنا هنا لزيارة وجيزة فحسب

148
00:10:26,630 --> 00:10:29,610
لكن لماذا تنظر للأعلى؟

149
00:10:29,610 --> 00:10:30,650
ماذا؟

150
00:10:30,650 --> 00:10:34,650
.ستتمكّن من رؤية ما تحت تنّورتي هكذا

151
00:10:35,730 --> 00:10:38,150
!أ-أنا آسف

152
00:10:40,450 --> 00:10:43,660
.أردت رؤية النّمسيس الطّيفيّ

153
00:10:44,270 --> 00:10:47,200
تسبّب بالكثير من المعاناة لشعبي، صحيح؟

154
00:10:47,200 --> 00:10:48,160
!نعم

155
00:10:48,160 --> 00:10:51,940
.معاناة شعبي هي معاناتي أنا

156
00:10:52,410 --> 00:10:56,420
.يا له من أمر محزن جعلتكم تتكبّدونه

157
00:10:56,420 --> 00:11:00,100
.لـ-لطفك قد أغرقنا يا جلالتك

158
00:11:00,100 --> 00:11:02,680
.أشكرك على قلقك علينا

159
00:11:02,680 --> 00:11:06,080
،صحيح أنّ حقولنا قد تأذّت

160
00:11:06,080 --> 00:11:10,060
.لكنّها لم تُدمّر بالكامل بفضل الفرسان

161
00:11:10,060 --> 00:11:12,290
.سعيدة لسماعي لذلك

162
00:11:12,290 --> 00:11:15,500
.لكن عليك أن تخفض رأسك قليلاً

163
00:11:18,420 --> 00:11:23,320
.يا-يا جلالتك... نحن خائفون

164
00:11:23,320 --> 00:11:26,330
!أنت! كيف تجرؤ على الكلام مباشرة للملكة؟

165
00:11:26,330 --> 00:11:28,050
.سأستمع لك

166
00:11:28,050 --> 00:11:29,290
!يا جلالتك؟

167
00:11:29,290 --> 00:11:32,340
.برانغوار، أخفض رأسك

168
00:11:33,890 --> 00:11:37,210
.ألم شعبي هو ألمي

169
00:11:37,710 --> 00:11:41,460
ما الّذي كان سبب خوفكم؟

170
00:11:41,460 --> 00:11:44,900
،إنّه... عند حلول اللّيل

171
00:11:44,900 --> 00:11:47,490
!يظهر الدّولاهان دائمًا

172
00:11:47,490 --> 00:11:48,870
الدّولاهان"؟"

173
00:11:48,870 --> 00:11:52,850
.إنّه روح مرعبة تحمل رأسها بين يديها

174
00:11:52,850 --> 00:11:56,210
بدأ يظهر في هذه المنطقة

175
00:11:56,210 --> 00:11:58,920
في نفس الوقت الّذي بدأ النّمسيس
.الطّيفيّ بالظّهور

176
00:11:58,920 --> 00:12:00,260
ماذا؟

177
00:12:01,030 --> 00:12:05,070
هل تعرف المزيد عن هذا الدّولاهان؟

178
00:12:05,620 --> 00:12:10,330
.حسنًا، إنّه يُسمّى أيضًا بجالب الكوارث

179
00:12:10,700 --> 00:12:13,500
أقلت الكوارث؟

180
00:12:14,660 --> 00:12:15,850
...يا جلالتك

181
00:12:16,950 --> 00:12:19,410
،عانينا من الأطياف في البداية
...والآن هنالك الدّولاهان

182
00:12:19,410 --> 00:12:23,590
لماذا علينا تحمّل كلّ هذه المصائب؟

183
00:12:28,740 --> 00:12:31,650
.أصغوا إليّ يا شعبي

184
00:12:32,220 --> 00:12:36,290
،بسبب جهود زوجي لرّاحل براستاغ

185
00:12:36,290 --> 00:12:40,570
فإنّ سنوات الحروب العديدة التي
.دمّرت هذه الأرض قد انتهت

186
00:12:40,940 --> 00:12:44,900
.حقّقنا السّلام أخيرًا، وإن كان بشكل عابر

187
00:12:45,350 --> 00:12:51,580
ولكن، ابتُليت هذه الأرض
.بالحرب مرّة أخرى للأسف

188
00:12:51,890 --> 00:12:54,330
...الأطياف والدّولاهان

189
00:12:54,900 --> 00:12:59,590
.لا أعرف بعد ما معنى هذه الأشياء لنا

190
00:13:00,140 --> 00:13:04,620
ولكن، عليّ الإصغاء لكلّ
.مخلوقات هذا العالم

191
00:13:05,270 --> 00:13:09,600
أنا واثقة أنّ روح العظيم مرلين
.لا ترقد بسلام الآن

192
00:13:10,180 --> 00:13:11,530
ولماذا ذلك؟

193
00:13:12,100 --> 00:13:16,810
هذا أمر على كلّ واحد منكم
.أن يسأله لنفسه

194
00:13:17,620 --> 00:13:21,730
هل نحن جديرون باتّباع خطوات العظيم مرلين؟

195
00:13:21,730 --> 00:13:24,940
هل ندرك الأمور الّتي قالها؟

196
00:13:24,940 --> 00:13:30,990
هل يمكننا حماية أرض سيفاندير
كما حماها هو؟

197
00:13:30,990 --> 00:13:33,910
.لا، ليس الأرض فحسب

198
00:13:33,910 --> 00:13:38,250
.علينا حماية كلّ الأرواح الّتي عليها

199
00:13:40,770 --> 00:13:41,900
.أوكوهو

200
00:13:43,380 --> 00:13:45,660
،كما قال برانغوار

201
00:13:45,660 --> 00:13:50,150
.ما فعلتِه كان ليضعنا في وضع خطير

202
00:13:50,650 --> 00:13:55,890
ولكن، كانت أفعالك تليق
.بإرادة العظيم مرلين

203
00:13:55,890 --> 00:13:57,270
...يا جلالتك

204
00:13:58,330 --> 00:14:01,930
هذه الأرض الّتي حميتِها بكلّ شجاعة

205
00:14:01,930 --> 00:14:04,420
.ستوضع الآن في عهدة هؤلاء المزارعين

206
00:14:05,170 --> 00:14:09,340
واثقة أنّ هذه الأرض ستغدو
.مثمرة ثانية يومًا ما

207
00:14:09,950 --> 00:14:11,010
أليس كذلك؟

208
00:14:11,010 --> 00:14:13,410
!نعم! بكلّ تأكيد

209
00:14:15,410 --> 00:14:19,540
والآن، عليّ العودة للقيام
.بواجباتي الرّسميّة

210
00:14:19,990 --> 00:14:23,180
.برانغوار، اعذر تدخّلي

211
00:14:23,180 --> 00:14:28,300
.قاتلتم أنت وجنودك ببسالة

212
00:14:29,260 --> 00:14:31,320
!شكرًا لك يا جلالتك

213
00:14:31,320 --> 00:14:33,090
...برانغوار

214
00:14:37,370 --> 00:14:39,840
!عفوًا! لم يكن ذلك قصدي

215
00:14:39,840 --> 00:14:41,980
!سامحيني رجاءً

216
00:14:44,010 --> 00:14:45,620
.رافقتكم السّلامة جميعًا

217
00:14:46,110 --> 00:14:49,630
.سأدعو ليحميكم العظيم مرلين

218
00:14:49,630 --> 00:14:53,580
!ستغادر الملكة صاحبة الجلالة الآن

219
00:14:59,080 --> 00:15:02,040
!تبدو الملكة جميلة دائمًا

220
00:15:02,040 --> 00:15:03,380
.رائحتها أخّاذة

221
00:15:03,380 --> 00:15:05,180
.أتمنّى أن تربّت على رأسي أيضًا

222
00:15:05,180 --> 00:15:07,380
.لن أغسل وجهي ثانية

223
00:15:07,380 --> 00:15:10,670
!أ-أنتم! كفّوا عن التّحديق بالملكة

224
00:15:10,670 --> 00:15:12,770
!سنعود للقلعة

225
00:15:12,770 --> 00:15:14,470
!حا-حاضر

226
00:15:14,890 --> 00:15:17,100
.سنعود أخيرًا

227
00:15:17,100 --> 00:15:18,630
!سِث

228
00:15:18,630 --> 00:15:21,220
!هل رأيت ذلك؟ هل كنتَ تشاهد؟

229
00:15:22,210 --> 00:15:25,620
!تعرف الملكة اسمي

230
00:15:25,620 --> 00:15:28,860
!أ-أعلم! أعلم! أفلتيني

231
00:15:29,460 --> 00:15:33,550
!يا إلهي! أراهن أنّي كسبت بعض النّقاط

232
00:15:34,410 --> 00:15:37,340
.لكنّ السّيّد برانغوار كان غاضبًا

233
00:15:37,340 --> 00:15:39,570
!لكنّ ذلك حاله دائمًا

234
00:15:39,570 --> 00:15:41,780
!لقد أثنت الملكة عليّ

235
00:15:41,780 --> 00:15:44,130
!سيتمّ ترسيمي الآن بكلّ تأكيد

236
00:15:44,130 --> 00:15:45,560
!دراكون

237
00:15:45,560 --> 00:15:48,110
!سنحتفل بوجبتَيْ فواكه اليوم

238
00:15:49,130 --> 00:15:51,620
!كلاّ، بل ثلاثة

239
00:15:53,110 --> 00:15:54,510
!لديه صرخة غريبة

240
00:15:54,510 --> 00:15:56,280
حسنًا، أجاهز للعودة؟

241
00:15:56,280 --> 00:15:59,290
،ثمّة أمور عدّة أريد أن أسألك إيّاها

242
00:15:59,290 --> 00:16:01,270
!لكن سنحتفل أوّلاً

243
00:16:01,270 --> 00:16:02,390
...أكيد

244
00:16:04,520 --> 00:16:05,660
سِث؟

245
00:16:05,660 --> 00:16:09,400
!تذكّرتُ شيئًا عليّ فعله فحسب

246
00:16:09,400 --> 00:16:11,270
.آسف. اذهبي بدوني

247
00:16:11,270 --> 00:16:12,420
فعلاً؟

248
00:16:12,420 --> 00:16:14,110
.أراك لاحقًا إذًا

249
00:16:14,110 --> 00:16:15,530
!أ-أكيد

250
00:16:22,540 --> 00:16:26,540
يا غريم، ما الّذي تفعله هنا؟

251
00:16:27,790 --> 00:16:29,670
اكتشفت الأمر إذًا؟

252
00:16:29,670 --> 00:16:33,010
.كلاّ، سيكون من الصّعب ألاّ ألاحظ

253
00:16:33,350 --> 00:16:39,080
ما الّذي لا يبدو غريبًا لك في رجل
ملفوف بالضّمادات ويقف هكذا؟

254
00:16:39,080 --> 00:16:40,990
تشعر بالفضول حيال غريم؟

255
00:16:40,990 --> 00:16:42,190
.نوعًا ما

256
00:16:42,190 --> 00:16:45,770
سيكون هذا مفيدًا فعلاً
.إن تمكّنت من حجب حضوري مثلك

257
00:16:46,470 --> 00:16:49,600
،يتظاهر غريم بأنّه فزّاعة في الحقول

258
00:16:49,600 --> 00:16:51,890
،أو قد يتظاهر أنّه شبح في المقابر

259
00:16:51,890 --> 00:16:55,780
أو قد يتظاهر حتّى أنّه رحّالة
.مريض ومتعب على قارعة الطّريق

260
00:16:56,340 --> 00:16:59,280
.ربّما قد يبدو هذا غريبًا من وجهة نظرك

261
00:16:59,280 --> 00:17:00,540
.نعم

262
00:17:01,220 --> 00:17:05,540
إنّ النّاس غير مدركين للأشياء
.الّتي لا ترتقي لاهتمامهم

263
00:17:06,110 --> 00:17:09,050
،حتّى إن رأوها بأمّ أعينهم

264
00:17:09,050 --> 00:17:11,410
فإنّهم ينسون الأمور
.الّتي لا قيمة لها عندهم

265
00:17:12,020 --> 00:17:14,050
.كحال غريم الآن

266
00:17:14,460 --> 00:17:19,070
هذا شيء يستطيع غريم تحقيقه
.عن طريق ابتعاده عن العالم

267
00:17:19,750 --> 00:17:23,310
هل ذلك ما ترغب في امتلاكه؟

268
00:17:26,180 --> 00:17:28,920
.كما أنّك لا تحتاج لتصبح مثل غريم

269
00:17:28,920 --> 00:17:31,070
،نجحت في التّسلّل للقلعة

270
00:17:31,070 --> 00:17:33,350
.ووضعتَ نفسك في موضع مواتٍ

271
00:17:33,770 --> 00:17:36,580
.ليس من السّهل الدّخول لتلك القلعة

272
00:17:36,580 --> 00:17:38,980
.لكنّ الأهمّ هو ما يأتي بعد ذلك

273
00:17:38,980 --> 00:17:42,570
قد تكون هنالك معلومات
،عن راديان في المكتبة

274
00:17:42,570 --> 00:17:45,490
لكن لا أستطيع الدّخول
.إلاّ إن انضممت لأولئك الفرسان

275
00:17:46,580 --> 00:17:48,710
أقلت المكتبة؟

276
00:17:48,710 --> 00:17:50,100
ماذا في ذلك؟

277
00:17:50,530 --> 00:17:53,080
.لدى غريم خدمة ليسألها منك

278
00:17:53,080 --> 00:17:54,610
ما هي؟

279
00:17:54,610 --> 00:17:56,590
.ساعدتني مرّات عدّة

280
00:17:56,590 --> 00:17:59,050
،إن كنتُ أستطيع مساعدتك أيضًا
.فأخبرني بما تريده

281
00:17:59,050 --> 00:18:03,430
.هنالك شيء في تلك القلعة يريده غريم

282
00:18:04,530 --> 00:18:06,180
!تريدني أن أسرق؟

283
00:18:06,180 --> 00:18:08,650
!لا يمكنني فعل ذلك

284
00:18:08,650 --> 00:18:11,820
.كلاّ. يريد غريم استعارته لبعض الوقت فقط

285
00:18:13,460 --> 00:18:14,650
.انظر لهذا

286
00:18:15,110 --> 00:18:16,440
ما هذا؟

287
00:18:16,910 --> 00:18:19,090
.هذا حجر ذاكرة

288
00:18:19,090 --> 00:18:23,550
يرتدي سحرة معيّنون أحجارًا
.كهذه طوال الوقت

289
00:18:24,100 --> 00:18:28,900
إنّها تملك قدرة خاصّة على تسجيل
.تجارب مالكها

290
00:18:30,330 --> 00:18:31,460
.إنّه حجر جميل

291
00:18:31,810 --> 00:18:36,080
ثمّة شيء في مكتبة القلعة
.يُدعى أنماثيك

292
00:18:36,080 --> 00:18:37,760
أ-أنما...؟

293
00:18:37,760 --> 00:18:42,770
إنّها مجموعة أحجار ذاكرة استعملها
.السّحرة العظماء في الماضي

294
00:18:42,770 --> 00:18:46,930
ومن بينها حجر استعملته
.ساحرة تُدعى ماغوزيا

295
00:18:46,930 --> 00:18:49,270
هل تعتقد أنّ بإمكانك العثور
عليه وتسريبه للخارج؟

296
00:18:49,270 --> 00:18:51,740
.لستُ واثقًا من ذلك

297
00:18:51,740 --> 00:18:55,570
ألا يمكنك الدّخول بنفسك يا غريم؟

298
00:18:55,570 --> 00:18:58,940
.لا يستطيع غريم دخول أسوار القلعة

299
00:18:58,940 --> 00:19:01,150
ماذا؟ لماذا؟

300
00:19:01,150 --> 00:19:03,970
.لأنّ غريم غريم

301
00:19:03,970 --> 00:19:06,080
.لا أفهم ذلك

302
00:19:06,080 --> 00:19:09,390
فيما ستستعمل ذلك الحجر على أيّ حال؟

303
00:19:09,390 --> 00:19:10,620
.لغرض ما

304
00:19:10,620 --> 00:19:11,950
ما هذا الغرض؟

305
00:19:11,950 --> 00:19:14,250
.الغرض هو الغرض

306
00:19:15,460 --> 00:19:17,850
!لا بأس! فهمت

307
00:19:18,270 --> 00:19:20,240
.أنا مدين لك

308
00:19:20,240 --> 00:19:23,970
.لكن لا فكرة لديّ كيف سأتسلّل للمكتبة

309
00:19:24,890 --> 00:19:26,010
.هذا صحيح

310
00:19:26,010 --> 00:19:27,060
!مهلاً

311
00:19:27,780 --> 00:19:30,430
.ربّما أنت غير مناسب للتّجسّس

312
00:19:30,870 --> 00:19:33,720
تلك الفتاة الّتي تسافر معك دائمًا

313
00:19:33,720 --> 00:19:38,320
أو ذلك الفتى بروح الرّجل
.قد يكونان أفضل منك في هذا

314
00:19:38,980 --> 00:19:41,320
...ميلي ودوك

315
00:19:41,320 --> 00:19:46,230
بالمناسبة، لماذا لا تسافر معهما الآن؟

316
00:19:46,990 --> 00:19:51,330
لقد وصلا سلفًا إلى كاسلين مرلين، صحيح؟

317
00:19:51,860 --> 00:19:54,060
تعرف كلّ شيء، صحيح؟

318
00:19:54,730 --> 00:19:58,810
.لقد رأيتهما، لكنّهما تصرّفا بغرابة

319
00:19:59,370 --> 00:20:03,180
بشكل شخصيّ، يعتقد غريم
.أنّ كلّ هذا غريب، بما في ذلك أنت

320
00:20:03,180 --> 00:20:05,390
!لا أقصد ذلك النّوع من الغرابة

321
00:20:05,830 --> 00:20:07,870
...كلّ ما هنالك

322
00:20:07,870 --> 00:20:10,420
.وكأنّه كانت هنالك فجوة بيننا

323
00:20:11,780 --> 00:20:16,980
ربّما هما غاضبان لأنّني تركت
.أرتميس بدون إخبارهما

324
00:20:16,980 --> 00:20:21,360
سِث، غادرت دون إخبارهما؟

325
00:20:21,360 --> 00:20:25,070
.نعم... لكنّني تركت لهما رسالة

326
00:20:25,070 --> 00:20:30,910
إنّ تصرّفًا كهذا محتّم عليه
.أن يُسبّب سوء فهم وخلافات

327
00:20:31,740 --> 00:20:33,630
ماذا عليّ أن أفعل في رأيك؟

328
00:20:34,130 --> 00:20:36,460
.لسوء الحظّ، لا فكرة لدى غريم عن ذلك

329
00:20:37,140 --> 00:20:38,800
،لسبب ما

330
00:20:38,800 --> 00:20:42,120
يبدو غريم خبيرًا في التّسبّب في حالات
.سوء الفهم غير المرغوب بها

331
00:20:42,120 --> 00:20:44,550
.أعتقد أنّني أعرف السّبب

332
00:20:44,550 --> 00:20:50,010
ولكن، هل هذا فعلاً سؤال على
شخص دخيل أن يجيب عليه؟

333
00:20:50,010 --> 00:20:55,220
لا... عليّ حلّ هذا الأمر بنفسي، صحيح؟

334
00:20:55,650 --> 00:20:59,290
في تلك الحالة، إن كان هنالك مكان شاغر
،في النّزل الرّخيص المسمّى ليبريكون

335
00:20:59,290 --> 00:21:00,610
.فعليك النّزول فيه

336
00:21:01,250 --> 00:21:03,320
.جميع الأماكن الأخرى غالية جدًّا

337
00:21:03,320 --> 00:21:06,090
.حسنًا. شكرًا لك

338
00:21:06,090 --> 00:21:07,550
.سأمرّ عليه لاحقًا

339
00:21:08,970 --> 00:21:10,230
...اسمع يا غريم

340
00:21:10,980 --> 00:21:14,690
.يبدو أنّك تعرف الكثير عن كاسلين مرلين

341
00:21:14,690 --> 00:21:18,080
.عرفتَ بأمر مكتبة القلعة وهذا النّزل أيضًا

342
00:21:18,630 --> 00:21:19,930
فعلاً؟

343
00:21:19,930 --> 00:21:23,090
هل كنتَ فارسًا ساحرًا
في الماضي أو ما شابه؟

344
00:21:23,440 --> 00:21:24,630
.كلاّ

345
00:21:24,630 --> 00:21:26,620
أهذا كلّ ما لديك لتقوله؟

346
00:21:26,620 --> 00:21:29,100
.أنت غامض كعادتك

347
00:21:29,500 --> 00:21:31,600
.غريم هو غريم

348
00:21:32,010 --> 00:21:36,030
لكن يساورني الفضول فعلاً
.بشأن ما خلف تلك الضّمادات

349
00:21:37,090 --> 00:21:38,600
...يا غريم

350
00:21:40,610 --> 00:21:42,070
!فعلها ثانية

351
00:21:43,230 --> 00:21:47,020
يا إلهي... إنّه لا يخبرني
.أيّ شيء عن نفسه أبدًا

352
00:21:51,100 --> 00:21:52,870
ليبريكون إذًا؟

353
00:21:54,630 --> 00:21:56,100
.أعتقد أنّني سأمرّ عليه

354
00:22:05,550 --> 00:22:08,630
.يا رجل، أنا ثمل للغاية

355
00:22:10,410 --> 00:22:11,710
ما الخطب؟

356
00:22:13,110 --> 00:22:13,940
...انظر

357
00:22:19,490 --> 00:22:22,110
!الـ-الدّولاهان

358
00:22:25,630 --> 00:22:29,990
يُتبع

359
00:24:00,000 --> 00:24:20,740
في الحلقة القادمة

360
00:24:00,590 --> 00:24:02,330
،بعد أخذه بنصيحة غريم

361
00:24:02,330 --> 00:24:06,610
.قرّر سِث التّحدّث مع ميلي ودوك ثانية

362
00:24:07,020 --> 00:24:10,010
،لكن عندما ذهب للنّزل

363
00:24:10,010 --> 00:24:12,910
.تعامله ميلي بقسوة لسبب ما

364
00:24:13,470 --> 00:24:16,950
تشعر ميلي أنّ سِث الّذي لا يفهم
،ما يحدث، قد جرحها

365
00:24:16,950 --> 00:24:18,930
.وتقول وداعًا له

366
00:24:19,540 --> 00:24:24,170
:"في الحلقة القادمة من "راديان
."مطر صامت وقلوب متباعدة"

367
00:24:25,020 --> 00:24:30,250
النّهاية