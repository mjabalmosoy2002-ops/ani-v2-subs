1
00:00:15,490 --> 00:00:18,990
...ذلك نمسيس طيفيّ

2
00:00:19,540 --> 00:00:22,080
!حافظوا على التّشكيلة جميعكم

3
00:00:22,080 --> 00:00:24,290
!ولا تقتربوا من القلعة

4
00:00:24,290 --> 00:00:25,420
!حاضر

5
00:00:25,420 --> 00:00:28,750
!والآن، جميعًا! جيزوني

6
00:00:28,750 --> 00:00:30,130
!جيزوني

7
00:00:39,980 --> 00:00:42,300
،مدينة الفرسان السّحرة

8
00:00:42,300 --> 00:00:43,820
.كاسلين مرلين

9
00:00:44,470 --> 00:00:47,020
تتعرّض المدينة حاليًّا لتهديد وحوش غامضة

10
00:00:47,020 --> 00:00:50,140
.ظهرت دفعة واحدة، دون أن تبدأ كبيضة

11
00:00:50,140 --> 00:00:53,370
.إنّها تُعرف بالنّمسيس الطّيفيّة

12
00:00:54,030 --> 00:00:55,300
،وفي هذه المدينة

13
00:00:55,300 --> 00:00:58,380
حيث قيل أنّ أسرار السّحر
،قد رقدت هنا منذ قديم الزّمان

14
00:00:58,790 --> 00:01:02,060
.ستبدأ مغامرة سِث الجديدة

15
00:02:35,430 --> 00:02:37,430
".نحو مغامرة جديدة"

16
00:02:42,210 --> 00:02:45,740
،في المعركة السّابقة في بلدة رامبل

17
00:02:45,740 --> 00:02:49,690
أنقذ سِث المدنيّين من حكم
.وحدة التّفتيش الظّالم

18
00:02:50,390 --> 00:02:54,570
ولكن بالطّبع، لم تكن تلك هي
.نهاية كلّ القتال في العالم

19
00:02:55,350 --> 00:03:00,360
،ولهدف حلّ لغز راديان الغامض
،سبب كلّ القتال

20
00:03:00,360 --> 00:03:01,990
.غادر سِث في رحلة

21
00:03:02,950 --> 00:03:09,040
ستكون هذه أيضًا بداية رحلته
.لاكتشاف الأسرار الّتي يحملها بداخله

22
00:03:21,450 --> 00:03:23,500
كاسلين مرلين إذًا؟

23
00:03:23,930 --> 00:03:27,750
،إن ذهبتُ إلى هذه المدينة القديمة
فسأجد معلومات عن راديان؟

24
00:03:28,860 --> 00:03:32,140
إذًا كلّ ما عليّ هو الذّهاب
!إلى هناك واكتشافها ثمّ العودة

25
00:03:35,030 --> 00:03:37,660
.لم أعد للمنزل منذ وقت طويل

26
00:03:40,030 --> 00:03:41,510
.أرى أنّك قد عدت

27
00:03:41,510 --> 00:03:42,940
.نعم

28
00:03:45,910 --> 00:03:50,410
أجل، الاختباء هناك لمدّة
!طويلة كاد يخنقني

29
00:03:50,410 --> 00:03:52,020
أليس كذلك يا جيجي؟

30
00:03:52,460 --> 00:03:55,420
!أ-أ-أنتما؟

31
00:03:55,420 --> 00:03:58,550
!مرحبًا! لم نرك منذ مدّة يا فتى

32
00:03:58,550 --> 00:04:00,910
!وغدان

33
00:04:01,800 --> 00:04:04,650
!كفّ عن ضرب خادماي

34
00:04:04,650 --> 00:04:06,300
!ماذا؟

35
00:04:06,300 --> 00:04:09,310
!جيجي! هذا بدون أيّ سبب

36
00:04:12,340 --> 00:04:15,600
أخبرتنا السّيّدة ألما
،بألاّ نسمح للقرويّين برؤيتنا

37
00:04:15,600 --> 00:04:17,810
!لذلك كنّا نختبئ هناك بصمت فحسب

38
00:04:17,810 --> 00:04:20,820
!كان ذلك تصرّفًا لئيمًا منك

39
00:04:20,820 --> 00:04:22,940
.يا لك من مسكين

40
00:04:22,940 --> 00:04:26,420
!هـ-هلاّ أخبرني أحدكم ما الّذي يجري هنا؟

41
00:04:29,170 --> 00:04:31,820
.آسف لأنّنا فاجأناك هكذا يا فتى

42
00:04:31,820 --> 00:04:34,390
كلاّ، أنا جادّ. لماذا أنتما هنا؟

43
00:04:34,390 --> 00:04:37,580
...مهلاً! قبل إخبارك بذلك

44
00:04:37,580 --> 00:04:41,140
!جيجي! الوضعيّة رقم 12

45
00:04:43,090 --> 00:04:45,990
!ثنائيّ الشّجاعة

46
00:04:45,990 --> 00:04:50,350
!جيجي! قلتُ الرّقم 12، وليس 21

47
00:04:50,350 --> 00:04:52,340
!أخفقت في ذلك ثانية

48
00:04:52,340 --> 00:04:55,380
!نحن موضع سخرية بسببك

49
00:04:55,380 --> 00:04:59,230
ثنائيّ؟ ماذا حدث للآخرَيْن؟

50
00:04:59,570 --> 00:05:04,930
صحيح... انفصلنا عندما كنّا
.نهرب من أرتميس

51
00:05:06,660 --> 00:05:09,240
...أتساءل ما الّذي يفعلانه الآن

52
00:05:10,330 --> 00:05:12,980
أنت بطيء الفهم كعادتك، صحيح؟

53
00:05:12,980 --> 00:05:15,490
.هذان الاثنان يعملان لديّ الآن

54
00:05:15,490 --> 00:05:19,380
ماذا؟! لكنّهما من الأشرار
!الّذين هاجموا القرية

55
00:05:19,380 --> 00:05:22,860
!ثمّ حاولوا سرقة كنز من أرتميس

56
00:05:22,860 --> 00:05:23,890
.أعلم ذلك

57
00:05:23,890 --> 00:05:25,380
!لماذا إذًا؟

58
00:05:27,710 --> 00:05:29,390
.يمكنني الإجابة على ذلك

59
00:05:29,940 --> 00:05:32,750
،بعد أن هربنا أنا وجيجي من أرتميس

60
00:05:32,750 --> 00:05:35,410
اختبأنا في جزيرة مهجورة

61
00:05:35,410 --> 00:05:38,190
...لنمنح جروحنا وقتًا لتُشفى

62
00:05:38,930 --> 00:05:41,490
!لكن كان ثمّة نمسيس هناك

63
00:05:41,490 --> 00:05:42,780
...مهلاً، مهلاً

64
00:05:42,780 --> 00:05:45,590
كنّا قد فقدنا أسلحتنا ومكانسنا
.وحتّى سراويلنا

65
00:05:45,590 --> 00:05:48,110
...كنّا متأكّدين أنّها كانت نهايتنا

66
00:05:48,110 --> 00:05:53,870
!لكنّ السّيّدة قامت بدخول شجاع وأنقذتنا

67
00:05:53,870 --> 00:05:56,550
أنت من أنقذهما يا ألما؟

68
00:05:56,550 --> 00:05:59,020
.كنت مارّة من هناك في مهمّة

69
00:05:59,020 --> 00:06:02,140
ألم يكن يجدر بك تسليمهما لأرتميس؟

70
00:06:02,140 --> 00:06:05,470
.حاولت القيام بذلك في البداية

71
00:06:05,470 --> 00:06:07,720
بعثتُ رسالة، لكن لم يأتِ
.أيّ أحد لاستلامهما

72
00:06:07,720 --> 00:06:09,810
...لذلك ظننتُ

73
00:06:10,220 --> 00:06:13,870
،أنّهما إن أحسنا التّصرّف
.فقد أطلق سراحهما

74
00:06:15,260 --> 00:06:19,930
كان من غير الصّواب سلبهما حياتهما
.فقط لأنّهما ارتكبا بضعة جرائم

75
00:06:23,100 --> 00:06:26,280
.فهمت. لذلك السّبب قرّرتما مساعدة ألما

76
00:06:26,280 --> 00:06:29,850
!مستحيل! هربنا كأنّنا أرانب خائفة

77
00:06:31,970 --> 00:06:35,290
.لكنّها أطلقت علينا سحرها بكلّ قوّته

78
00:06:35,700 --> 00:06:39,830
لا أظهر أيّ رحمة لأوغاد يعضّون
.اليد الّتي امتدّت إليهم

79
00:06:41,580 --> 00:06:46,590
.لكنّ ذلك ليس كلّ شيء
!ظهر نمسيس أصليّ

80
00:06:47,130 --> 00:06:50,010
،كنّا بلا حول ولا قوّة
.وقامت السّيّدة ألما بحمايتنا

81
00:06:50,010 --> 00:06:53,850
!واجهت ذلك النّمسيس وحدها وفازت

82
00:06:54,190 --> 00:06:57,850
.وفي تلك اللّحظة، راودتني لحظة إلهام

83
00:06:58,480 --> 00:07:02,860
ما رأيتُه أمامي كان الرّوح
!الّتي كنتُ أبحث عنها

84
00:07:03,390 --> 00:07:06,640
تجسيد للشّجاعة والتّضحية
...بالذّات والتّواضع

85
00:07:06,640 --> 00:07:09,370
!كلّ ذلك كان أمام ناظريّ مباشرة

86
00:07:09,370 --> 00:07:12,870
!السّيّدة ألما... كلاّ، بل الإلهة ألما

87
00:07:14,580 --> 00:07:18,310
!لـ-لذلك السّبب بالضّبط تخلّيت عن كلّ شيء

88
00:07:18,310 --> 00:07:21,210
ربّما حدثت أمور عدّة بيني
...وبين السّيّدة ألما، لكن

89
00:07:26,050 --> 00:07:28,750
!ماذا؟! لم أفهم كلمة ممّا قلته

90
00:07:30,030 --> 00:07:33,160
.بوسمان، اذهب لتجهيز العشاء

91
00:07:33,160 --> 00:07:34,500
!في الحال

92
00:07:37,290 --> 00:07:38,580
...يا إلهي

93
00:07:39,970 --> 00:07:43,290
.لقد روّضتهما بالفعل

94
00:07:43,290 --> 00:07:46,480
.يفعلان ما آمرهما به فحسب مهما كان

95
00:07:46,480 --> 00:07:51,700
،إن قرّرت بيع أعضائي
.فقد يساعدانني على ذلك أيضًا

96
00:07:53,060 --> 00:07:56,370
لكن أعتقد إذًا أنّه من الأفضل
.أن يكونا في السّجن

97
00:07:56,370 --> 00:07:58,310
.ربّما

98
00:07:58,310 --> 00:08:01,250
،على كلّ حال، لقد أقسما بالولاء لي

99
00:08:01,250 --> 00:08:03,850
.ويقومون بعمل عشرة رجال

100
00:08:04,970 --> 00:08:07,090
.لا داعي للقلق

101
00:08:07,090 --> 00:08:12,510
من الظّريف كم أنّهما يظنّانني
.عائلتهما الجديدة

102
00:08:12,510 --> 00:08:14,500
...بالحديث عن العائلة

103
00:08:15,490 --> 00:08:18,510
.قابلتُ شخصًا غريبًا في بلدة رامبل

104
00:08:18,980 --> 00:08:20,390
شخصًا غريبًا؟

105
00:08:20,750 --> 00:08:24,900
.قال... أنّه أخي الأكبر

106
00:08:25,700 --> 00:08:27,460
.يبدو لي ذلك مريبًا

107
00:08:27,460 --> 00:08:31,180
ظهر من العدم وأخبرك أنّه أخوك الأكبر؟

108
00:08:31,180 --> 00:08:33,070
.كان لديه قرنان أيضًا

109
00:08:33,070 --> 00:08:37,310
.لعنة ظهور قرون ليست نادرة كما تظنّ

110
00:08:37,310 --> 00:08:40,040
!لكنّه كان يشبهني كثيرًا

111
00:08:40,040 --> 00:08:43,110
...راودني حينها... شعور غريب

112
00:08:43,110 --> 00:08:45,480
.وكأنّ لديّ صلة به

113
00:08:45,480 --> 00:08:47,250
صلة؟

114
00:08:47,250 --> 00:08:51,490
...في داخل روحي... أو ربّما ذكرياتي

115
00:08:51,490 --> 00:08:55,260
.شعرتُ وكأنّني أعرفه

116
00:08:57,790 --> 00:08:58,830
.سِث

117
00:08:59,390 --> 00:09:02,510
،عندما كنت تقاتل في بلدة رامبل

118
00:09:02,510 --> 00:09:04,340
،ورغم غرابة الأمر

119
00:09:04,340 --> 00:09:08,470
شعرتُ بنفس الشّيء
.رغم أنّني كنت بعيدة جدًّا

120
00:09:08,470 --> 00:09:09,690
.شعرتُ بالخبث

121
00:09:10,730 --> 00:09:13,900
.لم يكن شعورًا سارًّا

122
00:09:14,870 --> 00:09:19,160
كما تعلم، لا أملك أيّة ذكريات
.عن ماضِيّ أيضًا

123
00:09:19,160 --> 00:09:24,160
ربّما أصبتَ بذلك الجرح على خدّك
.عندما كنتُ أحاول حمايتك منه

124
00:09:26,090 --> 00:09:28,400
ما الّذي جعلك تقولين ذلك؟

125
00:09:28,400 --> 00:09:33,050
هل تعتقد أنّني سأثق بشخص
لم يظهر نفسه ثانية بعد ذلك؟

126
00:09:33,390 --> 00:09:38,290
.إضافة لذلك، يراودني شعور سيّئ

127
00:09:38,290 --> 00:09:42,180
.وعلى الأقلّ، أعرف أنّ لا شيء آمن حياله

128
00:09:43,990 --> 00:09:44,680
!ضربة

129
00:09:44,680 --> 00:09:45,930
!هذا مؤلم

130
00:09:45,930 --> 00:09:48,150
!تمالك نفسك يا فتى

131
00:09:48,150 --> 00:09:51,290
!لا تدع ادّعاءات غريب أطوار تؤثّر بك

132
00:09:51,290 --> 00:09:54,740
—لم يكن الأمر كذلك! شعرتُ فقط

133
00:09:54,740 --> 00:09:57,800
!هذا هو ما يسمّى بالخيال مفرط النّشاط

134
00:09:57,800 --> 00:10:00,340
في المرّة القادمة الّتي تريد إخباري
.فيها بقصّة كهذه، دوّن ملاحظات أوّلاً

135
00:10:00,340 --> 00:10:01,830
...لـ-لكن

136
00:10:01,830 --> 00:10:03,670
!بدون لكن

137
00:10:03,670 --> 00:10:07,330
استمع لي. ستحدث أمور
.عدّة بدءًا من الآن

138
00:10:07,970 --> 00:10:13,570
لا تدعها تربكك. صدّق فقط
.ما تراه وتعرفه وتعلّمته

139
00:10:13,570 --> 00:10:16,530
إن تهوّرت، فستموت. مفهوم؟

140
00:10:16,530 --> 00:10:18,340
...نـ-نعم

141
00:10:18,820 --> 00:10:21,630
!سيّدة ألما! العشاء جاهز

142
00:10:21,630 --> 00:10:25,390
.يا إلهي... أتضوٍّر جوعًا. لنأكل يا سِث

143
00:10:25,390 --> 00:10:27,350
!أكيد! أنا قادم في الحال

144
00:10:29,180 --> 00:10:31,100
ما رأيك يا فتى؟ طعمه لذيذ، صحيح؟

145
00:10:32,390 --> 00:10:36,580
.أخوه؟ يراودني شعور سيّئ حيال هذا

146
00:10:38,950 --> 00:10:44,950
،ثنائيّ الشّجاعة] عثر رجل على شجاعته الّتي كان قد فقدها]
.عندما رأى الإلهة تقاتل. لكنّه فقد سرواله

147
00:10:47,680 --> 00:10:51,670
جبال أركاديان

148
00:11:07,830 --> 00:11:10,300
.مضت ثلاثة أيّام مذ دخلت هذه الجبال

149
00:11:10,780 --> 00:11:13,420
لماذا تمّ استدعائي إلى هنا؟

150
00:11:14,690 --> 00:11:18,790
،إن كانوا يعاقبونني على ترك كونراد

151
00:11:18,790 --> 00:11:21,950
.لكانوا قد أعادوني إلى بلادي

152
00:11:22,700 --> 00:11:23,990
...كونراد

153
00:11:24,570 --> 00:11:28,930
.كانت لديه أفكار خطيرة منذ البداية

154
00:11:29,620 --> 00:11:31,860
،لو أنّني أوقفته حينها

155
00:11:32,390 --> 00:11:35,130
فهل كان ممكنًا تفادي تلك
المأساة الفظيعة؟

156
00:11:39,320 --> 00:11:41,550
قبل 15 سنة

157
00:11:41,820 --> 00:11:44,050
بلدة رامبل

158
00:11:46,560 --> 00:11:50,180
!لا ترخوا دفاعاتكم
!ربّما ما تزال مختبئة

159
00:11:50,180 --> 00:11:54,980
خدعتنا تلك النّمسيس
!وهاجمت أشخاصًا أبرياء

160
00:11:54,980 --> 00:11:56,000
!تقرير يا سيّدي

161
00:11:56,000 --> 00:11:58,900
!هربت النّمسيس إلى الحيّ 13

162
00:11:58,900 --> 00:12:00,930
!هذا مثاليّ

163
00:12:00,930 --> 00:12:02,870
!سنحاصرها دفعة واحدة

164
00:12:02,870 --> 00:12:05,740
!أيّها القائد! شيء ما يتحرّك هناك

165
00:12:05,740 --> 00:12:06,800
ماذا؟

166
00:12:06,800 --> 00:12:10,520
يا نائب القائد، ألق نظرة
!بعين الجدي خاصّتك

167
00:12:10,520 --> 00:12:13,920
.إنّها ليست "عين الجدي" أيّها القائد

168
00:12:13,920 --> 00:12:17,590
آسف على ذلك. عين الفأر، صحيح؟

169
00:12:17,590 --> 00:12:19,180
.أخطأت ثانية

170
00:12:19,180 --> 00:12:20,710
!عين الفطر

171
00:12:20,710 --> 00:12:23,210
.ابتعدت كثيرًا الآن

172
00:12:23,210 --> 00:12:27,300
من يهتمّ لذلك؟! ما الّذي تراه
!بعينك اللّعينة تلك؟

173
00:12:27,300 --> 00:12:29,820
.إنّها "عين الوشق" أيّها القائد

174
00:12:33,110 --> 00:12:35,140
.أرى جنديًّا

175
00:12:35,140 --> 00:12:39,320
وحسب زيّه، يمكنني القول
.أنّه مفتّش مسؤول عن السّجن

176
00:12:39,320 --> 00:12:40,730
!أطلقوا

177
00:12:40,730 --> 00:12:41,720
ماذا؟

178
00:12:41,720 --> 00:12:44,360
!واضح أنّه نمسيس متنكّر

179
00:12:44,360 --> 00:12:47,590
.عفوًا... لنعطه فرصة للتّكلّم أوّلاً

180
00:12:47,590 --> 00:12:49,450
أنت! ما الخطب؟

181
00:12:49,830 --> 00:12:53,040
!هـ-هنالك تمرّد في الحيّ 13

182
00:12:54,310 --> 00:12:58,400
!يحتجز الإرهابيّون مواطنين كرهائن

183
00:12:58,400 --> 00:13:01,250
!إنّهم ينوون إعدامهم الواحد تلو الآخر

184
00:13:01,250 --> 00:13:05,370
!تمرّد في وقت كهذا؟ لماذا؟

185
00:13:05,370 --> 00:13:08,460
!هنالك ساخطون مختبئون في كلّ مكان

186
00:13:08,970 --> 00:13:10,560
...حتّى الرّائد

187
00:13:11,050 --> 00:13:14,310
!حتّى الرّائد أوكسماري كان بينهم

188
00:13:14,570 --> 00:13:16,940
...الرّائد أوكسماري

189
00:13:16,940 --> 00:13:18,090
...مستحيل

190
00:13:18,090 --> 00:13:20,320
.كلاّ... هذا منطقيّ

191
00:13:20,320 --> 00:13:25,320
سمعتُ تقارير أنّه كان ودودًا
.جدًّا مع المهاجرين

192
00:13:25,320 --> 00:13:30,200
!نعم! كان على صلة بأطفال سحرة

193
00:13:31,830 --> 00:13:35,530
.أيّها القائد، دع فرقتي تهتمّ بهذا

194
00:13:35,530 --> 00:13:38,210
—سنحرّر الرّهائن ونكتشف ما الّذي

195
00:13:38,210 --> 00:13:40,460
!لا يمكنكم ذلك

196
00:13:41,710 --> 00:13:44,120
لم لا أيّها الجنديّ؟

197
00:13:44,120 --> 00:13:47,220
!ذ-ذلك خطير جدًّا

198
00:13:47,700 --> 00:13:52,230
!هذا لأنّ النّمسيس تقف في صفّهم

199
00:13:52,230 --> 00:13:56,410
!يـ-يستعمل الإرهابيّون النّمسيس للقتال؟

200
00:13:56,410 --> 00:13:57,750
!نعم

201
00:13:57,750 --> 00:14:02,730
إنّ أوكسماري والأطفال السّحرة
!هم سبب كلّ هذا

202
00:14:02,730 --> 00:14:04,450
!ماذا؟

203
00:14:04,450 --> 00:14:07,370
!أرسلوا رجالنا إلى الحيّ 13 في الحال

204
00:14:07,370 --> 00:14:08,490
!انتظر أيّها القائد

205
00:14:08,970 --> 00:14:12,990
لا أصدّق أنّ الإرهابيّين باستطاعتهم
—التّواصل مع النّمسيس

206
00:14:17,180 --> 00:14:18,500
!السّلاسل

207
00:14:18,500 --> 00:14:21,000
!سوف تميل الجزيرة

208
00:14:21,000 --> 00:14:22,660
!سيّدي القائد

209
00:14:22,660 --> 00:14:25,410
علينا تدمير المرساة الأخيرة
في الشّارع الشّمال شرقيّ

210
00:14:25,410 --> 00:14:28,430
!ونغرق الحيّ 13 بأكمله

211
00:14:28,430 --> 00:14:29,930
...أنت

212
00:14:30,530 --> 00:14:35,930
بإمكاننا إنقاذ بلدة رامبل عن طريق
!التّضحيّة بجزء منها

213
00:14:35,930 --> 00:14:38,940
!علينا إذًا إخلاء المدنيّين أوّلاً

214
00:14:38,940 --> 00:14:41,700
!لا وقت لذلك

215
00:14:41,700 --> 00:14:43,170
!بالضّبط يا سيّدي

216
00:14:43,170 --> 00:14:47,940
إن لم نتصرّف الآن، فسنطلق عنان
!النّمسيس على الجزيرة بأكملها

217
00:14:47,940 --> 00:14:49,730
—أيّها القائد، لكن

218
00:14:49,730 --> 00:14:50,890
!يكفي

219
00:14:50,890 --> 00:14:55,110
يا نائب القائد، إن أضعت الوقت
!بالاستماع لك، سيكون الأوان قد فات

220
00:14:55,110 --> 00:14:57,950
!أسقطوا تلك السّلسلة في الحال

221
00:14:57,950 --> 00:15:00,420
!خلّصونا من الحيّ 13

222
00:15:27,790 --> 00:15:30,310
.كان الأوان قد فات من كلّ ناحية

223
00:15:31,730 --> 00:15:33,600
كيف سينفع النّدم الآن؟

224
00:15:33,600 --> 00:15:37,200
.المذنب والبغيض هنا... هو أنا

225
00:15:42,060 --> 00:15:43,730
...نهاية مسدودة

226
00:15:45,610 --> 00:15:48,020
في أيّ مرحلة أخطأت الطّريق؟

227
00:15:48,020 --> 00:15:49,140
!دراغونوف

228
00:16:10,370 --> 00:16:12,330
سمعتُ من قبل

229
00:16:12,330 --> 00:16:16,740
أنّ الأرض المقدّسة لوحدة التّفتيش
.مخفيّة في مكان ما

230
00:16:18,740 --> 00:16:22,110
هل سيتمّ إعدامي هنا؟

231
00:16:22,590 --> 00:16:24,020
.يا له من شرف

232
00:16:40,030 --> 00:16:43,430
هل ذلك... والد المفتّشين؟

233
00:16:43,910 --> 00:16:45,520
.بالضّبط

234
00:16:46,290 --> 00:16:51,950
.هذا أقدم وأكثر التّماثيل صحّة عن هيئته

235
00:16:53,250 --> 00:16:57,780
مرحبًا بك في أرضنا المقدّسة
.أيّها القائد دراغونوف

236
00:16:58,190 --> 00:16:59,540
!الجنرال

237
00:17:00,460 --> 00:17:03,650
.لم أكن أعرف أنّ هذا المكان موجود فعلاً

238
00:17:04,070 --> 00:17:05,730
.ذلك أفضل

239
00:17:06,250 --> 00:17:10,300
لا يجب أن نسمح للمزدرين
.بمعرفة هذا المكان

240
00:17:10,810 --> 00:17:13,090
،منذ فضيحة بلدة رامبل

241
00:17:13,090 --> 00:17:17,300
.انهارت سلطة وحدة التّفتيش

242
00:17:17,830 --> 00:17:21,240
خاطرتُ بكشف أفعال كونراد الشّرّيرة

243
00:17:21,240 --> 00:17:24,570
لأنّي لم أستطع السّماح لنفسي
.باقتراف نفس الخطأ مرّتين

244
00:17:24,570 --> 00:17:27,520
لم تكن لي أيّة رغبة بتدنيس
.شرف وحدة التّفتيش

245
00:17:27,970 --> 00:17:29,150
.هذا يكفي

246
00:17:30,990 --> 00:17:33,340
،إن كنتُ أريد لومك

247
00:17:33,340 --> 00:17:37,660
،ما كنتُ لأفعل ذلك هنا
.لكن في قاعدتنا الأساسيّة في بوم

248
00:17:39,250 --> 00:17:40,280
.قف

249
00:17:40,280 --> 00:17:42,230
.لا أنوي معاقبتك

250
00:17:44,860 --> 00:17:48,450
نحن نواجه بداية عصر
.من الصّعوبة غير المسبوقة

251
00:17:49,050 --> 00:17:50,970
،المروّضون الماكرون

252
00:17:51,380 --> 00:17:54,630
،فرسان كاسلين مرلين السّحرة

253
00:17:54,630 --> 00:17:58,180
...عصابة التّاجر بارون في بلدان بونانتان

254
00:17:58,180 --> 00:18:04,180
لكن، لا يوجد أحد سوى وحدة
.التّفتيش قلقة بشأن مستقبل البشريّة

255
00:18:04,850 --> 00:18:06,550
،نحن صانعو المعجزات

256
00:18:06,550 --> 00:18:09,560
.سنقوم ببذل كلّ جهدنا لتقويم هذا العالم

257
00:18:10,350 --> 00:18:14,820
في بعض الأحيان، يتطلّب الحفاظ
.على توازن حسّاس إجراءات صارمة

258
00:18:15,570 --> 00:18:18,070
.وتلك مسؤوليّتي أنا

259
00:18:18,070 --> 00:18:24,580
بالتّالي، فإنّ القائد دراغونوف
...المسؤول عن بومبو هيلز

260
00:18:24,900 --> 00:18:26,020
.قد مات

261
00:18:26,770 --> 00:18:30,220
ومن الآن فصاعدًا، ستُعرف بالقائد
.دراغونوف صانع المعجزات

262
00:18:32,300 --> 00:18:36,810
كانت عينك البصيرة سيفًا
.ذو حدّين في هذه الحادثة

263
00:18:37,770 --> 00:18:42,790
لكن بدونها، ما كنّا لنكشف
.حقيقة هذه المسألة

264
00:18:42,790 --> 00:18:45,350
.أ-أنا غير جدير بثنائك هذا

265
00:18:45,830 --> 00:18:50,480
.كنتُ هناك كمشاهد بمحض الصّدفة فحسب

266
00:18:50,480 --> 00:18:53,250
.يستحقّ تواضعك الثّناء

267
00:18:53,250 --> 00:18:55,610
.لم يكن فون تيبيس مثلك

268
00:18:55,610 --> 00:19:00,740
بالغ في تقدير قوّته وهُزم قبل
.حتّى أن يستعمل معجزته

269
00:19:01,150 --> 00:19:04,210
.لقد أوصيتُ بك

270
00:19:05,380 --> 00:19:07,830
.لقد خدمتُ تحت إمرتك سابقًا

271
00:19:08,380 --> 00:19:11,830
.أنا على دراية تامّة بعينك الثّاقبة وتفانيك

272
00:19:12,490 --> 00:19:17,630
سيمنحنا وجود رجل برأيك بين
.صانعي المعجزات قوّة مائة رجل

273
00:19:18,310 --> 00:19:21,090
.كنتُ مستعدًّا تمامًا لأُعدم

274
00:19:21,090 --> 00:19:24,640
.لم أتخيّل أبدًا أن أصبح صانع معجزات

275
00:19:25,270 --> 00:19:26,410
.تعال

276
00:19:28,990 --> 00:19:32,810
السّحرة الّذين نواجههم نحن
.صانعو المعجزات أقوياء

277
00:19:35,540 --> 00:19:37,450
،في عصور مضت

278
00:19:37,450 --> 00:19:41,730
.حكمَ النّاسُ سحرةٌ هائلو القوّة

279
00:19:42,260 --> 00:19:43,770
،لكن في يوم ما

280
00:19:48,430 --> 00:19:51,700
،قيل أنّ ذلك الرّجل كان ابن مزارع بسيط

281
00:19:51,700 --> 00:19:56,700
وقد واجه السّحرة بإرادته
.الخاصّة كسلاحه الوحيد

282
00:19:57,230 --> 00:20:00,630
،واليوم، أمست هذه مجرّد قصّة خرافيّة

283
00:20:01,210 --> 00:20:03,760
.لكنّها قصّة حقيقيّة

284
00:20:03,760 --> 00:20:07,010
هل هذا... هو رمح الأب المشعّب؟

285
00:20:07,010 --> 00:20:10,590
.نعم. إنّه واحد من آثارنا المقدّسة

286
00:20:12,350 --> 00:20:16,090
،ليس أداة مزوّدة بالسّحر
.بل مجرّد أداة زراعة بسيطة

287
00:20:16,090 --> 00:20:21,400
كيف استطاع والدنا مواجهة قوّة خارقة
للطّبيعة كتلك بأداة زراعة بسيطة كهذه؟

288
00:20:21,400 --> 00:20:24,060
.تلك معجزة بالفعل

289
00:20:24,580 --> 00:20:25,950
.بالضّبط

290
00:20:26,390 --> 00:20:29,570
.لقد أدّى معجزة بقوّة إرادته الخاصّة فقط

291
00:20:30,410 --> 00:20:31,540
ما معنى ذلك؟

292
00:20:32,430 --> 00:20:34,460
.سأخبرك عندما يحين الوقت المناسب

293
00:20:35,130 --> 00:20:38,870
لا بدّ أنّك متعب بعد عناء الرّحلة
.الطّويلة. عليك أن ترتاح

294
00:20:39,490 --> 00:20:43,800
سنقيم مراسيم إعلانك واحدًا
.من صانعي المعجزات لاحقًا

295
00:20:43,800 --> 00:20:44,810
.حاضر

296
00:20:45,430 --> 00:20:48,810
.في فجر الغد، ستنطلق مع ليزيلوت

297
00:20:49,370 --> 00:20:52,310
.ستكون هذه أولى مهمّاتك كصانع معجزات

298
00:20:52,930 --> 00:20:56,700
سيكون عليك العثور على السّاحر
.ذي القرنين ورفاقه

299
00:20:58,390 --> 00:21:03,490
الفتى الّذي تحدّى المروّضة
...وحلّ الحادثة

300
00:21:03,490 --> 00:21:07,290
لا أصدّق أنّ وحدة التّفتيش
...ستكون مستميتة للعثور عليه

301
00:21:07,290 --> 00:21:09,780
إذًا ثمّة أكثر ممّا تراه العين
في هذه المسألة بالفعل؟

302
00:21:14,820 --> 00:21:18,460
.أنت الوحيد الّذي رأى كلّ وجوههم

303
00:21:18,460 --> 00:21:20,130
.يمكنك الاعتماد عليّ

304
00:21:20,470 --> 00:21:24,130
.لن أنسى وجوههم أبدًا

305
00:21:28,450 --> 00:21:30,970
...كاسلين مرلين

306
00:21:30,970 --> 00:21:34,830
أليست هذه المدينة القديمة
الّتي يقال أنّها مصدر السّحر؟

307
00:21:34,830 --> 00:21:39,750
.إن سألتني، إنّه يتعلّق بقشّة فحسب

308
00:21:39,750 --> 00:21:45,250
لكنّ هنالك أشخاصا يسمّون الفرسان
.السّحرة هم المسؤولون هناك

309
00:21:45,250 --> 00:21:48,160
،بالنّسبة لشخص مثلي
.إنه مكان غريب جدًّا لأتواجد فيه

310
00:21:50,450 --> 00:21:53,980
مهلاً، هل أنت واثقة أنّك
لن تذهبي معه يا سيّدة ألما؟

311
00:21:53,980 --> 00:21:58,620
.لن أذهب. لديّ عملي الخاصّ لأقوم به

312
00:21:58,620 --> 00:21:59,640
!أكيد

313
00:21:59,640 --> 00:22:04,130
سبق وأخذ قراره في الخروج
.في هذه الرّحلة

314
00:22:04,130 --> 00:22:06,420
!أهذا هو ما يسمّى حبّ الوالدين؟

315
00:22:06,420 --> 00:22:07,510
!طبعًا لا

316
00:22:23,730 --> 00:22:27,020
!تلك هي...قارّة سيفاندير إذًا

317
00:22:25,990 --> 00:22:29,990
يُتبع

318
00:24:00,000 --> 00:24:25,020
في الحلقة القادمة

319
00:24:01,020 --> 00:24:04,550
.وضع سِث أخيرًا قدمه على سيفاندير وحيدًا

320
00:24:05,050 --> 00:24:08,470
،وهناك، قابل في الحال البارون التّاجر

321
00:24:08,470 --> 00:24:11,830
.الّذي يريد موارد البلاد لنفسه ولعصابته

322
00:24:12,350 --> 00:24:15,510
بعد أن طارده البارون التّاجر
،عديم الضّمير وعصابته

323
00:24:15,510 --> 00:24:18,770
.يقابل سِث شخصًا لم يتوقّع رؤيته ثانية

324
00:24:19,290 --> 00:24:22,900
:"في الحلقة القادمة من "راديان
."لقاء تحت المطر"

325
00:24:25,020 --> 00:24:30,250
النّهاية