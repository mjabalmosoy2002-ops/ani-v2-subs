1
00:00:06,320 --> 00:00:07,580
.سيفي هذا بالغرض

2
00:00:08,730 --> 00:00:10,740
،وضعتُ حاجزًا حول المنزل

3
00:00:10,740 --> 00:00:13,330
.لذلك سنعلم في الحال إن اقترب أيّ شيطان

4
00:00:13,330 --> 00:00:15,070
.كم هذا مطمئن

5
00:00:15,070 --> 00:00:17,940
،إن أتت تلك القطّة المزعجة إلى هنا ثانية

6
00:00:17,940 --> 00:00:20,290
.فسأرسلها من حيث أتت بنفسي هذه المرّة

7
00:00:21,010 --> 00:00:23,120
!سأنال منكم

8
00:00:23,120 --> 00:00:25,870
!مياو

9
00:00:25,870 --> 00:00:29,190
!كلاّ! مجرّد تذكّرها يثير غضبي

10
00:00:29,190 --> 00:00:30,530
.على رسلك يا ريس

11
00:00:30,530 --> 00:00:35,550
إنّك تتصرّف بلطف كبير تجاهها
.رغم أنّها هاجمتنا

12
00:00:36,450 --> 00:00:39,470
.لا أتصرّف بلطف أو أيّ من ذلك

13
00:00:40,560 --> 00:00:42,140
...أنا فقط

14
00:00:42,140 --> 00:00:45,160
فينريس! واثقة أنّك مدركة تمامًا

15
00:00:45,160 --> 00:00:51,230
أنّ هذا الرّجل هو من قضى
!على أخيك فينغاريل وقوّاته

16
00:00:54,080 --> 00:00:56,250
ما الخطب؟

17
00:00:56,250 --> 00:00:58,240
.لا شيء

18
00:00:58,240 --> 00:00:59,120
.هكذا إذًا

19
00:01:02,120 --> 00:01:03,790
!لنعد للمنزل

20
00:01:04,400 --> 00:01:05,960
.أ-أكيد

21
00:02:41,590 --> 00:02:44,560
تنظرين إلى شاشة إحصائيّاتك ثانية؟

22
00:02:44,560 --> 00:02:46,690
.يبدو هذا جنونيًّا

23
00:02:51,200 --> 00:02:57,480
أعني أنّي ما زلت لا أصدّق
.أنّي أملك لقب قاتل تنانين الآن

24
00:02:59,360 --> 00:03:03,410
هذه هي المجرفة الأسطوريّة
.الّتي قطعت رأس التّنّين

25
00:03:03,410 --> 00:03:05,660
!يـ-يكفي

26
00:03:05,660 --> 00:03:07,990
.يجعل ذلك الأمرَ يبدو أقلّ روعة

27
00:03:09,120 --> 00:03:11,110
إلى أين تذهبين يا باليروسا؟

28
00:03:11,930 --> 00:03:14,260
.لصيد حصّة اليوم من الوحوش السّحريّة

29
00:03:20,010 --> 00:03:24,080
،باليروسا منضبطة جدًّا
.إنّها تخرج كلّ يوم للتّدرّب هكذا

30
00:03:24,080 --> 00:03:27,720
.لقد حصلتُ على هذا اللّقب بفضله فقط

31
00:03:27,720 --> 00:03:31,200
عليّ أن أصير أقوى أيضًا لأستطيع قتل وحوش

32
00:03:31,200 --> 00:03:33,530
.من الرّتبة ج على الأقلّ مثلما تفعل هي

33
00:03:34,020 --> 00:03:36,440
.سأعمل بجدّ أيضًا

34
00:03:39,790 --> 00:03:40,770
...أنا

35
00:03:41,200 --> 00:03:43,780
!أردتُ ذلك اللّقب أيضًا

36
00:03:44,090 --> 00:03:46,100
"إنّ لقب "قاتل التّنانين

37
00:03:46,100 --> 00:03:51,200
استثنائيّ جدًّا لدرجة أنّه يعادل حصول
.متجوّل عشوائيّ على رتبة نبيل

38
00:03:51,200 --> 00:03:55,130
!إنّه حلم أيّ مغامر جديد

39
00:03:55,640 --> 00:03:57,540
!وها قد تراجعتُ أكثر

40
00:03:57,540 --> 00:04:01,280
...ليتني حصلتُ على ذلك اللّقب

41
00:04:01,900 --> 00:04:04,790
كنتُ لأستعيد مكانة النّبلاء
،الّتي فقدتها عائلتي

42
00:04:04,790 --> 00:04:06,970
ولتمّت دعوة عائلتي

43
00:04:06,970 --> 00:04:11,150
للعيش في العاصمة ثانية مثل
...الوقت الّذي كان فيه أبي فارسًا

44
00:04:14,320 --> 00:04:15,220
.المعذرة

45
00:04:17,380 --> 00:04:21,620
أتيتُ إلى هنا لأنّي سمعتُ
.أنّ صديقًا قديمًا لي يعيش في الجوار

46
00:04:21,620 --> 00:04:22,620
هل تعرفين هذه المنطقة؟

47
00:04:22,620 --> 00:04:23,810
من يكون؟

48
00:04:23,810 --> 00:04:27,360
إنّ عدّته خفيفة جدًّا ليكون في غابة
...مليئة بالوحوش السّحريّة كهذه

49
00:04:27,360 --> 00:04:29,370
.نعم، أعرفها جيّدًا

50
00:04:29,700 --> 00:04:32,580
هل صديقك القديم هذا هو السّيّد فليو؟

51
00:04:33,240 --> 00:04:35,780
أم أنّك تقصد زوجته؟

52
00:04:36,160 --> 00:04:37,790
.إنّها زوجته

53
00:04:38,100 --> 00:04:40,340
هكذا إذًا؟

54
00:04:41,040 --> 00:04:42,210
...لا بدّ أنّ ذلك يعني

55
00:04:42,650 --> 00:04:43,920
.أنّك من جيش ملك الشّياطين

56
00:04:47,180 --> 00:04:50,340
ما الّذي تريده من امرأة قطعت
كلّ علاقاتها بجيش ملك الشّياطين؟

57
00:04:50,820 --> 00:04:54,290
.قد تواجهني في معركة اعتمادًا على ردّك

58
00:04:55,570 --> 00:04:58,530
،أنا بالفعل من جيش ملك الشّياطين

59
00:04:58,530 --> 00:05:01,480
.لكنّي هنا فقط للاطمئنان عليها
.لا أحمل أيّ نيّة سيّئة

60
00:05:03,980 --> 00:05:05,200
.سأغادر الآن

61
00:05:10,400 --> 00:05:11,080
...في تلك الحالة

62
00:05:11,740 --> 00:05:13,650
.سأعود أدراجي أيضًا

63
00:05:14,130 --> 00:05:16,070
.أبلغي رسالتي إلى فينريس رجاءً

64
00:05:16,770 --> 00:05:20,310
سليها إن كانت تريد الحديث
.عن الماضي أثناء شرب الشّاي معًا

65
00:05:20,310 --> 00:05:21,670
.مفهوم

66
00:05:22,600 --> 00:05:25,360
اسمي باليروسا. ما اسمك أنت؟

67
00:05:27,890 --> 00:05:29,020
.غوزال

68
00:05:31,340 --> 00:05:34,430
.غوزال؟ يا له من اسم غريب

69
00:05:35,360 --> 00:05:37,190
!يا باليروسا

70
00:05:38,180 --> 00:05:40,480
هل أنت بخير؟ لم تصابي بأيّ أذى، صحيح؟

71
00:05:40,480 --> 00:05:44,150
أ-أنا بخير. أتى شخص من جيش
.ملك الشّياطين قبل قليل إلى هنا

72
00:05:44,150 --> 00:05:45,380
.اسمه غوزال

73
00:05:45,380 --> 00:05:46,670
غوزال؟

74
00:05:49,310 --> 00:05:54,530
يا إلهي... أما كان بإمكانه اختيار اسم أفضل
إن كان عليه استعمال واحد مزيّف؟

75
00:05:54,530 --> 00:05:55,730
مزيّف؟

76
00:05:55,730 --> 00:05:59,450
أتينا لأنّ الحاجز اكتشف وجود
.شيطان، وما رأيناه صدمنا كثيرًا

77
00:05:59,450 --> 00:06:00,460
...كنتِ

78
00:06:04,240 --> 00:06:07,980
كنتِ تتحدّثين مع شخص أظهرت
!"شاشة عرضه لقب "ملك الشّياطين

79
00:06:07,980 --> 00:06:08,590
ماذا؟

80
00:06:11,300 --> 00:06:13,310
أ-أنتما تمازحانني، صحيح؟

81
00:06:13,310 --> 00:06:16,060
لماذا قد نكذب بشأن ذلك؟

82
00:06:16,060 --> 00:06:18,490
.كان ذلك ملك الشّياطين بكلّ تأكيد

83
00:06:18,490 --> 00:06:20,160
.اسمه الحقيقيّ هو غول

84
00:06:25,070 --> 00:06:29,130
!مصيبة... سأُقتل

85
00:06:28,400 --> 00:06:31,280
في اليوم التّالي

86
00:06:31,280 --> 00:06:33,280
أتيت إلى هنا بالفعل؟

87
00:06:33,810 --> 00:06:36,080
.لم أرك منذ مدّة يا فينريس

88
00:06:36,080 --> 00:06:37,750
.اسمي فليو

89
00:06:38,560 --> 00:06:40,610
أنت هو... غوزال، صحيح؟

90
00:06:41,040 --> 00:06:41,790
.نعم

91
00:06:41,790 --> 00:06:44,030
.تفضّل بالدّخول رجاءً

92
00:06:44,660 --> 00:06:48,670
كيف يكون بهذا الهدوء في حضرتي؟

93
00:06:49,430 --> 00:06:52,620
—سيّدة ريس، سأقوم بنشر الغسيـ

94
00:06:58,760 --> 00:06:59,810
...سمعتُ

95
00:07:01,040 --> 00:07:03,230
.أنّك استقبلتِ مساعدِتي مؤخّرًا

96
00:07:04,890 --> 00:07:06,110
!لماذا أنا حاضرة أيضًا؟

97
00:07:06,330 --> 00:07:08,110
!ولماذا أجلس قربه؟

98
00:07:09,440 --> 00:07:11,610
ما الّذي أحضرك إلى هنا؟

99
00:07:12,210 --> 00:07:14,390
أتسعى للانتقام؟

100
00:07:14,390 --> 00:07:15,490
...ريس

101
00:07:16,960 --> 00:07:19,460
!تخلّى عنّي ظهري! لا أستطيع الوقوف

102
00:07:19,710 --> 00:07:22,040
.أكرّه اللّفّ والدّوران

103
00:07:22,480 --> 00:07:25,030
فليو، هل تريد الانضمام لجيش ملك الشّياطين؟

104
00:07:25,030 --> 00:07:27,050
ماذا؟ أنا؟

105
00:07:30,090 --> 00:07:31,680
.أخشى أنّي سأرفض طلبك

106
00:07:31,920 --> 00:07:34,920
حتّى بعد أن دعوتك شخصيًّا؟

107
00:07:34,920 --> 00:07:39,600
لكن لا بدّ أنّ الملك كلايرود يرغب
.في قوّتك أكثر من أيّ شيء آخر

108
00:07:40,000 --> 00:07:43,690
لماذا تعيش مختبئًا هنا بدل خدمته؟

109
00:07:43,690 --> 00:07:48,940
لا أظنّ أنّ من المنطقيّ لي أن أقف
.إلى جانب البشريّة فقط لأنّي بشريّ

110
00:07:49,330 --> 00:07:52,720
،كما أنّي لستُ من هذا العالم

111
00:07:52,720 --> 00:07:56,410
لذلك أجهل ما سبب قتالكم مع
.بعضكم من الأساس

112
00:07:57,190 --> 00:07:59,420
لم يشرح لك أيّ أحد الوضع؟

113
00:07:59,950 --> 00:08:02,570
.لا يرغب زوجي في القتال

114
00:08:02,570 --> 00:08:05,380
لذلك ما السّبب الّذي قد يدفعنا
للحديث عن ذلك؟

115
00:08:05,380 --> 00:08:08,430
فهمت. سبب للقتال في حرب؟

116
00:08:09,420 --> 00:08:14,560
من المرجّح أنّه لا يوجد شخص يعرف
.ما السّبب الحقيقيّ وراء قتالنا

117
00:08:15,370 --> 00:08:19,350
استمرّت الحرب بين البشر
،والشّياطين لـ500 سنة

118
00:08:19,900 --> 00:08:22,980
.منذ تولّي ملك الشّياطين الأوّل السّلطة

119
00:08:23,310 --> 00:08:24,720
لـ500 سنة؟

120
00:08:25,130 --> 00:08:26,340
.نعم

121
00:08:26,340 --> 00:08:31,370
أتى ملك الشّياطين الأوّل إلى هنا من عالم
.آخر محاولاً السّيطرة على هذا العالم

122
00:08:31,370 --> 00:08:32,570
من عالم آخر؟

123
00:08:33,200 --> 00:08:39,570
قبِل به الشّياطين الّذين كانوا
.يتعرّضون لاضطهاد البشر وقتها

124
00:08:39,570 --> 00:08:41,930
بالتّالي، نشبت الحرب بين الشّياطين
الّذي قبلوا بحاكم أجنبيّ

125
00:08:41,930 --> 00:08:45,530
.والبشر الّذين رفضوه، أو هذا ما يُقال

126
00:08:45,530 --> 00:08:48,170
هل كنتَ تستمع لأيّ شيء قلتُه؟

127
00:08:48,170 --> 00:08:50,790
لماذا شرحتَ كلّ ذلك وكأنّه أمر طبيعيّ؟

128
00:08:50,790 --> 00:08:54,470
،كلّما استمرّت الحرب
.تراكمت النّوايا السّيّئة أكثر

129
00:08:56,030 --> 00:08:58,570
.لن يكون من السّهل إيقافها الآن

130
00:08:59,830 --> 00:09:03,730
هل ترغب في إيقاف الحرب يا غوزال؟

131
00:09:06,000 --> 00:09:10,480
بعد اثني عشر جيلاً من ملوك
.الشّياطين، فإنّ الأيديولوجيّات تتغيّر

132
00:09:10,480 --> 00:09:14,780
،لا أملك أنا، ملك الشّياطين الحاليّ
.أيّ رغبة في حكم هذا العالم

133
00:09:15,280 --> 00:09:16,530
...لكن

134
00:09:20,160 --> 00:09:22,080
.أنا ملك الشّياطين

135
00:09:22,610 --> 00:09:25,350
لا أستطيع السّماح لشخص
يشكّل مثل هذا التّهديد للشّياطين

136
00:09:25,350 --> 00:09:28,370
!بالوقوع في أيدي البشر

137
00:09:31,830 --> 00:09:35,040
.فليو، خذ بنصيحتي

138
00:09:35,040 --> 00:09:36,380
.انضمّ إليّ

139
00:09:36,700 --> 00:09:38,930
.إنّك تبالغ في تقديري

140
00:09:38,930 --> 00:09:44,230
بالإضافة إلى ذلك، ليس لديّ أيّ نيّة
.للوقوف مع البشر أو الشّياطين حصرًا

141
00:09:56,650 --> 00:09:58,080
!كم أنت عنيد

142
00:09:58,080 --> 00:10:01,430
وهذا العناد هو الّذي دفعك
إلى رفض عرض الملك، أليس كذلك؟

143
00:10:03,380 --> 00:10:06,750
.أنا سعيد لأنّك سريع الفهم

144
00:10:07,910 --> 00:10:10,000
.هذا لا يعني أنّني استسلمت

145
00:10:10,870 --> 00:10:11,960
.سأعود

146
00:10:12,760 --> 00:10:14,340
،إضافة إلى فليو

147
00:10:14,340 --> 00:10:19,350
لا أصدّق أنّ هنالك بشريًّا آخر غير منزعج
.أبدًا من حضوري أنا ملك الشّياطين

148
00:10:20,090 --> 00:10:21,680
.يا لها من امرأة مثيرة للاهتمام

149
00:10:28,100 --> 00:10:30,540
باليروسا؟ هل أنت بخير؟

150
00:10:31,490 --> 00:10:34,650
لماذا يحدث هذا لي؟

151
00:10:39,780 --> 00:10:41,130
...صحيح

152
00:10:41,130 --> 00:10:43,620
،ذهبتُ للفراش بعد ذلك البارحة
.وبقيت هناك

153
00:10:45,230 --> 00:10:47,790
.لم يكن ذلك عادلاً في حقّهنّ

154
00:10:48,020 --> 00:10:50,640
.أعتذر عن اللّيلة الماضية يا رفيقات

155
00:10:50,640 --> 00:10:52,540
...با-باليروسا

156
00:10:53,630 --> 00:10:54,410
.صباح الخير

157
00:10:55,460 --> 00:10:56,380
!مرحبًا

158
00:10:56,700 --> 00:10:57,960
!إنّها باليروسا إذًا

159
00:10:59,010 --> 00:11:01,680
.كنتُ أستمتع بالفطور فحسب

160
00:11:02,220 --> 00:11:04,860
!طبخ فينريس مذهل جدًّا

161
00:11:05,280 --> 00:11:08,770
غادر رجاءً بمجرّد لانتهاء منه، مفهوم؟

162
00:11:09,230 --> 00:11:11,630
،لن يغيّر زوجي رأيه

163
00:11:11,630 --> 00:11:16,780
كما أنّ على المرء تفادي أوقات
!الأكل عندما يريد زيارة أحد ما

164
00:11:16,780 --> 00:11:18,560
.على رسلك يا ريس

165
00:11:18,560 --> 00:11:20,110
.ماذا هنالك؟ تعالي

166
00:11:20,110 --> 00:11:22,880
!لـ-ليس وأنا أرتدي هذه الملابس

167
00:11:22,880 --> 00:11:24,830
!ا-المعذرة

168
00:11:25,580 --> 00:11:29,180
.ماذا؟ إنّ لها جانبًا محتشمًا أيضًا

169
00:11:42,610 --> 00:11:44,180
.ها أنت ذي يا باليروسا

170
00:11:45,230 --> 00:11:47,290
.أرغب في الحديث معك

171
00:11:47,290 --> 00:11:48,430
...أ-أ-أنا

172
00:11:48,430 --> 00:11:50,890
!لديّ تداريب سيف لأقوم بها

173
00:11:54,270 --> 00:11:57,120
.ها أنت ثانية يا باليروسا

174
00:11:57,790 --> 00:12:00,520
!عليّ الذّهاب لغسل ملابسي في النّهر

175
00:12:13,290 --> 00:12:15,990
!عليّ جمع الحطب

176
00:12:15,990 --> 00:12:18,890
.ماذا؟ إنّها عاملة مجتهدة

177
00:12:21,750 --> 00:12:25,780
هناك شيطان يزور منزل ذلك
المغامر باستمرار؟

178
00:12:25,780 --> 00:12:26,760
.نعم

179
00:12:26,760 --> 00:12:29,220
،حسب تقارير جاسوسنا

180
00:12:29,220 --> 00:12:32,470
شوهد رجل مشبوه يزور منزل
المغامر فليو بشكل متكرّر

181
00:12:32,470 --> 00:12:36,480
ويختفي بعدها في منطقة
.الشّياطين عدّة مرّات

182
00:12:37,280 --> 00:12:42,820
كيف يجرؤ على تجاهل
،استدعاءاتي مرارًا وتكرارًا

183
00:12:42,820 --> 00:12:46,180
ويفضّل الوقوف إلى جانب
!جيش ملك الشّياطين بدل ذلك؟

184
00:12:46,180 --> 00:12:48,660
—حسنًا، سأرسل جنودًا إلى

185
00:12:48,660 --> 00:12:50,460
.انتظر رجاءً يا والدي

186
00:12:51,910 --> 00:12:55,190
لسنا واثقين بعد من أنّه انضمّ
.لجيش ملك الشّياطين

187
00:12:55,190 --> 00:12:56,880
،إن أرسلتَ جنودًا الآن

188
00:12:57,450 --> 00:13:02,270
فقد يُزعج ذلك السّيّدَ فليو ويدفعه
.للانضمام لجيش ملك الشّياطين بالفعل

189
00:13:02,270 --> 00:13:04,780
أعتقد أنّه سيكون من الأفضل
.أن تُحاوره أنت بنفسك

190
00:13:04,780 --> 00:13:06,010
أحاوره؟

191
00:13:06,010 --> 00:13:07,300
.نعم

192
00:13:07,300 --> 00:13:09,340
،بدل استدعاء السّيّد فليو ببساطة

193
00:13:09,340 --> 00:13:12,180
.فعليك الاستماع لما لديه ليقوله أيضًا

194
00:13:12,790 --> 00:13:16,010
.المهمّ هنا هو التّنازل والوصول إلى تفاهم بينكما

195
00:13:16,010 --> 00:13:18,890
!اصمتي أيّتها الأميرة الأولى

196
00:13:19,650 --> 00:13:21,970
هل تعتقدين أنّ مُثُلك هذه

197
00:13:21,970 --> 00:13:24,400
!كافية لاستمرار هذه الأمّة؟

198
00:13:24,400 --> 00:13:25,490
...لكن

199
00:13:25,760 --> 00:13:28,130
ما كلّ هذه الجلبة؟

200
00:13:28,130 --> 00:13:29,530
...البطل

201
00:13:29,530 --> 00:13:33,630
!عجبًا! غادرتَ حصنك في الجنوب لزيارتنا؟

202
00:13:33,630 --> 00:13:36,170
.أعطني جنودًا

203
00:13:36,170 --> 00:13:39,970
،إن كان لن ينصاع لأوامرك طواعية
!فسأجعله ينصاع لها بالقوّة

204
00:13:44,510 --> 00:13:47,930
إلى أين تذهب يا ملك الشّياطين؟

205
00:13:47,930 --> 00:13:49,690
.إلى منزل ذلك الرّجل

206
00:13:49,690 --> 00:13:52,680
لكنّك تعرف أنّ من الخطير
.مواصلة الذّهاب إلى هناك وحدك

207
00:13:52,960 --> 00:13:53,970
من الخطير؟

208
00:13:54,510 --> 00:14:00,060
لقد كان أكثر تفهّمًا بكثير من
.ملكٍ معيّن يرفض حتّى الاستماع

209
00:14:00,500 --> 00:14:04,350
عليّ الفوز به لصفّنا إن كانت لديّ
فرصة لذلك. ألا توافقينني الرّأي؟

210
00:14:04,350 --> 00:14:07,440
،صـ-صحيح، أنا أوافقك الرّأي

211
00:14:07,440 --> 00:14:10,030
.لكنّ الجميع هنا ينتظرون أوامرك

212
00:14:10,560 --> 00:14:13,140
إنّني أفكّر بالفعل في أفضل
.وقت لتتحرّك فيه قوّاتنا

213
00:14:15,770 --> 00:14:19,620
هناك الآن أفراد بين صفوفنا ممّن
يتحدّثون بالسّوء عن السّيّد غول

214
00:14:19,620 --> 00:14:21,750
.لأنّه يواصل زيارة ذلك الرّجل

215
00:14:22,190 --> 00:14:24,500
...كلّ هذا لاستدراجه إلى صفّنا

216
00:14:24,500 --> 00:14:28,380
أهذا بالفعل هو كلّ ما تسعى إليه
يا سيّدي غول؟

217
00:14:32,900 --> 00:14:36,140
ما الّذي تفكّر به يا عزيزي؟

218
00:14:36,140 --> 00:14:40,570
في الحقيقة، كنتُ أفكّر في بيع عدّة مصنوعة
،من حراشف التّنانين في البلدة

219
00:14:40,570 --> 00:14:42,470
.وأنا أعمل الآن على نموذج

220
00:14:42,470 --> 00:14:45,600
!يبدو أنّ النّتيجة مذهلة

221
00:14:45,600 --> 00:14:49,060
أحتاج لاختباره أكثر لصناعة
.واحد يكون جديرًا بالبيع

222
00:14:49,650 --> 00:14:53,580
.أريد إنجاح هذا العمل لنستطيع دعم أنفسنا

223
00:14:58,720 --> 00:15:02,280
عزيزي، أأنت واثق أنّ ذلك كان صائبًا؟

224
00:15:02,280 --> 00:15:03,420
ماذا تقصدين؟

225
00:15:03,420 --> 00:15:06,980
،إن عملتَ مع البطل كما أمرك الملك

226
00:15:06,980 --> 00:15:11,150
فستكتسب مكافآت أعظم بكثير
.ممّا تكتسبه الآن

227
00:15:12,720 --> 00:15:17,260
.وكان بإمكانك استعمال قدراتك بالكامل أيضًا

228
00:15:18,930 --> 00:15:24,570
هل يُعقل أنّك اخترت ألاّ تقاتل
جيش ملك الشّياطين بسببي؟

229
00:15:24,570 --> 00:15:26,510
.الأمر ليس كذلك

230
00:15:26,510 --> 00:15:28,080
فعلاً؟

231
00:15:28,080 --> 00:15:32,530
بما أنّك لطيف جدًّا، ظننتُ أنّك
.ربّما تكون قلقًا حيال ذلك

232
00:15:32,530 --> 00:15:37,010
.أنا لستُ لطيفًا بالقدر الّذي تعتقدينه

233
00:15:37,010 --> 00:15:37,820
...أنا فقط

234
00:15:39,480 --> 00:15:42,620
،بما أنّي أملك هذه القوّة المذهلة الآن

235
00:15:43,280 --> 00:15:46,430
.أفضّل ألاّ أقاتل أيّ أحد إن لم أضطرّ لذلك

236
00:15:48,380 --> 00:15:50,710
.هذا هو ما يُوصف باللّطف

237
00:15:51,530 --> 00:15:55,870
أنا معجبة بهذا الجانب فيك
.بقدر أيّ جانب آخر

238
00:15:58,600 --> 00:15:59,610
...ريس

239
00:16:02,440 --> 00:16:04,710
.أراهن أنّه غوزال ثانية

240
00:16:04,710 --> 00:16:06,940
...لكنّ الحاجز لم يكتشف أيّ شيطان

241
00:16:07,160 --> 00:16:10,400
!سـ-سيّد فليو

242
00:16:12,610 --> 00:16:15,240
أنت هو المغامر فليو إذًا؟

243
00:16:15,240 --> 00:16:16,070
...نعم

244
00:16:16,070 --> 00:16:19,410
.أعرف تمامًا ما الّذي تسعى إليه

245
00:16:20,580 --> 00:16:23,350
عزيزي، هل تريد منّي أن أرفض طلبهم؟

246
00:16:23,350 --> 00:16:25,080
.لا، لا بأس

247
00:16:25,430 --> 00:16:28,010
سمعتُ أنّك كنتَ على اتّصال
.بجيش ملك الشّياطين

248
00:16:28,620 --> 00:16:30,050
.سأمنحك خيارًا

249
00:16:30,310 --> 00:16:34,680
صِر تابعًا لي وانطلق معي لهزيمة
...ملك الشّياطين

250
00:16:35,050 --> 00:16:36,680
...أو

251
00:16:40,470 --> 00:16:44,980
سأعتبرك مُخبرًا لجيش ملك الشّياطين
!وسأطيح بك حيث تقف الآن

252
00:16:49,240 --> 00:16:50,540
!يا لبراعتي

253
00:16:50,540 --> 00:16:55,990
سيكون هذا واحدًا من أفضل
!ثلاثة مشاهد ملحميّة في حياتي

254
00:16:56,480 --> 00:16:59,950
إنّ هالتي قد سحقته بالكامل
.لدرجة أنّه عاجز عن الكلام

255
00:17:00,340 --> 00:17:02,820
.ما باليد حيلة

256
00:17:02,820 --> 00:17:05,490
،سأصير قريبًا بطلاً حقيقيًّا

257
00:17:05,490 --> 00:17:08,020
!إضافة لأسطورةٍ لهذا العالم

258
00:17:08,020 --> 00:17:12,680
كلّ ما أحتاج فعله هو هزيمة
!ملك الشّياطين بوجوده كتابع لي

259
00:17:13,170 --> 00:17:16,760
.هذه مشكلة
.لا أريد اختيار أيّ من الخيارين

260
00:17:16,760 --> 00:17:17,550
ماذا؟

261
00:17:17,550 --> 00:17:22,180
آسف لقولي هذا بعد تكبّدك
،لعناء إحضار كلّ هؤلاء إلى هنا

262
00:17:22,490 --> 00:17:26,640
لكن لا نيّة لديّ في الانضمام لكم
.أو لجيش ملك الشّياطين

263
00:17:26,990 --> 00:17:27,960
.هكذا إذًا

264
00:17:30,100 --> 00:17:34,270
إذًا فأنت تختار الموت كخائن خان مملكته؟

265
00:17:34,270 --> 00:17:35,780
...لا، ما قلتُه هو

266
00:17:35,780 --> 00:17:37,710
!هذا طغيان أيّها البطل

267
00:17:37,710 --> 00:17:41,540
!هذا صحيح! استمع لما لدينا لنقوله أيضًا

268
00:17:41,540 --> 00:17:45,310
!السّيّد فليو ليس خائنًا

269
00:17:46,530 --> 00:17:49,850
سمعت أنّ هنالك بعض الأشخاص
.يعملون مع هذا الرّجل

270
00:17:49,850 --> 00:17:51,840
.لا بدّ أنّكنّ هؤلاء الأشخاص

271
00:17:53,580 --> 00:17:57,120
،بإمكاني اعتقالكنّ جميعًا بتهمة الخيانة أيضًا

272
00:17:57,120 --> 00:17:59,880
.لكنّي سأغضّ النّظر عن هذا
...ولكن في المقابل

273
00:17:59,880 --> 00:18:02,950
.عليكنّ مساعدتي في إقناع هذا الرّجل

274
00:18:07,710 --> 00:18:09,190
.ما باليد حيلة

275
00:18:09,600 --> 00:18:13,780
لا أستطيع التّسبّب بالمشاكل
.لباليروسا وبقيّة الفرسان

276
00:18:13,780 --> 00:18:16,580
ما الّذي ستفعله يا عزيزي؟

277
00:18:19,840 --> 00:18:23,520
،لا يمكننا اختيار أيٍّ من الخيارين
،ولا أريد القتال هنا

278
00:18:23,520 --> 00:18:25,540
.لذلك سنذهب إلى مكان آخر

279
00:18:25,770 --> 00:18:27,700
أيناسبك هذا يا ريس؟

280
00:18:27,700 --> 00:18:31,130
!نعم! سأرافقك أيضًا يا عزيزي

281
00:18:31,130 --> 00:18:32,210
!ماذا؟

282
00:18:32,630 --> 00:18:36,060
.سيّد فليو، اسمح لنا بمرافقتك أيضًا

283
00:18:36,060 --> 00:18:38,220
...ماذا؟ لكنّكنّ

284
00:18:38,220 --> 00:18:40,220
علّمونا مذ كنّا أطفالاً

285
00:18:40,220 --> 00:18:43,330
.أنّ الشّياطين أعداء لنا يجب هزيمتهم

286
00:18:43,730 --> 00:18:47,670
،لكن بعد أن عشنا معك ومع السّيّدة ريس

287
00:18:47,670 --> 00:18:49,980
.بدأنا نشكّ في ذلك

288
00:18:50,490 --> 00:18:54,400
هل قتالهم هو الخيار الصّائب فعلاً؟

289
00:18:56,270 --> 00:18:56,860
،والأسوأ من ذلك

290
00:18:57,560 --> 00:19:00,770
إذا اتّبعتُ بلا خجل شخصًا يهدّد
،المواطنين الأبرياء

291
00:19:00,770 --> 00:19:03,830
فلن أتمكّن أبدًا من مواجهة والدي
!الّذي كان فارسًا مذهلاً في الماضي

292
00:19:04,210 --> 00:19:06,040
!باليروسا على حقّ

293
00:19:06,340 --> 00:19:08,500
!خذنا معك رجاءً

294
00:19:08,500 --> 00:19:10,000
.رجاءً

295
00:19:10,000 --> 00:19:14,270
ما الّذي تقلنه؟! أتعتقدن أنّ بإمكانكنّ
!الهرب من هذا الحصار؟

296
00:19:14,270 --> 00:19:15,110
.مفهوم

297
00:19:15,110 --> 00:19:16,020
!ماذا؟

298
00:19:16,020 --> 00:19:18,550
!ا-الزم حدودك

299
00:19:18,940 --> 00:19:20,310
!سحر الانتقال

300
00:19:24,220 --> 00:19:25,930
!كفاك عبثًا معي

301
00:19:26,250 --> 00:19:32,810
كيف لدودة مثلك أن يستطيع استعمال
!سحر أعجز حتّى أنا عن استعماله؟

302
00:19:40,300 --> 00:19:42,000
ا-اختفوا؟

303
00:19:42,000 --> 00:19:43,460
...اختفى المنزل والحقول أيضًا

304
00:19:43,460 --> 00:19:47,040
ذلك لا يُعقل! كيف بإمكانه استعمال
!سحر الانتقال بهذه الدّقّة؟

305
00:19:48,550 --> 00:19:49,750
!سيّدي البطل

306
00:19:50,120 --> 00:19:51,220
!ماذا هنالك؟

307
00:19:51,220 --> 00:19:54,990
ذلك الرّجل هناك هو الشّيطان الّذي
!كان على اتّصال بالمغامر فليو

308
00:19:55,680 --> 00:19:58,670
!ماذا؟! نا-نالوا منه

309
00:19:58,670 --> 00:20:00,090
...المنزل

310
00:20:01,050 --> 00:20:05,390
.فهمت. لا بدّ أنّ هذا من صنيعكم

311
00:20:16,110 --> 00:20:19,690
!يبدو أنّني سألقّنكم درسًا

312
00:20:21,650 --> 00:20:23,650
!إلى كلّ القوّات، اسمعوني

313
00:20:23,650 --> 00:20:28,160
اجتمعوا وأطلقوا هجومًا شاملاً
!على مملكة كلايرود السّحريّة

314
00:20:28,890 --> 00:20:32,590
!أروهم ما نستطيع نحن الشّياطين فعله

315
00:20:34,210 --> 00:20:37,040
!يبدو أنّكم جميعًا سمعتم صوت ملك الشّياطين

316
00:20:37,440 --> 00:20:39,460
!لدينا أوامر جديدة بالتّحرّك

317
00:20:39,460 --> 00:20:42,190
!إيّاكم والتّهاون

318
00:20:43,640 --> 00:20:45,000
...هـ-هذا

319
00:20:45,000 --> 00:20:47,010
!هـ-هذا لا يُعقل

320
00:20:47,010 --> 00:20:49,400
!تراجعوا! تراجعوا

321
00:20:49,400 --> 00:20:51,360
!ا-انتظرنا

322
00:21:02,020 --> 00:21:03,110
!هذا مذهل

323
00:21:07,500 --> 00:21:09,780
!المنزل والحقول كما كانت تمامًا

324
00:21:10,080 --> 00:21:11,440
أين نحن؟

325
00:21:11,440 --> 00:21:14,540
.قرب بلدة تُدعى هوغتاو غرب العاصمة الملكيّة

326
00:21:15,210 --> 00:21:18,660
أتيتُ إلى هنا لبيع بعض موادّ
.التّنانين قبل مدّة

327
00:21:18,660 --> 00:21:23,020
مذهل... إنّنا بعيدون جدًّا عن العاصمة، صحيح؟

328
00:21:23,840 --> 00:21:28,260
لن يتمكّن الآن أيّ من البطل أو ملك
!الشّياطين من العثور علينا هكذا

329
00:21:30,090 --> 00:21:32,550
.كـ-كم أراحني هذا

330
00:21:32,550 --> 00:21:36,230
أنت محظوظة، صحيح؟
.بدا أنّه كان مركّزًا عليك

331
00:21:36,720 --> 00:21:39,950
.آسف لأنّك مررت بكلّ ذلك يا ريس

332
00:21:40,780 --> 00:21:43,200
.إنّها ليست غلطتك يا عزيزي

333
00:21:43,200 --> 00:21:47,030
،كما أنّني ما دمت إلى جانبك

334
00:21:47,030 --> 00:21:50,360
.فسأكون سعيدة أينما ذهبنا

335
00:21:50,360 --> 00:21:51,260
.شكرًا لك

336
00:21:51,900 --> 00:21:54,160
أنا زوجتك. فلماذا قد لا أسعد؟

337
00:21:54,430 --> 00:21:56,500
!حسنًا، لنتناول العشاء

338
00:21:56,850 --> 00:22:00,080
!سأحضّر وليمة احتفالاً بانتقالنا

339
00:22:00,370 --> 00:22:02,700
!مذهل، لا أطيق الانتظار

340
00:22:02,700 --> 00:22:04,160
!سأساعد أيضًا

341
00:22:04,160 --> 00:22:06,510
!كم أنا جائعة

342
00:22:06,510 --> 00:22:07,790
.أنا أيضًا

343
00:23:40,800 --> 00:23:43,120
!أردت ذلك اللّقب أيضًا

344
00:23:43,120 --> 00:23:44,390
ما زلت لا تستطيعين نسيان ذلك؟

345
00:23:44,390 --> 00:23:46,660
.يجدر بك أن تكوني قادرة على الحصول على لقب

346
00:23:46,660 --> 00:23:47,440
ماذا؟

347
00:23:47,440 --> 00:23:50,070
."قاتلة ملك الشّياطين" مثل "قاتلة المسنّين"

348
00:23:50,070 --> 00:23:52,320
،بمجرّد أن تفتني ملك الشّياطين
!"ستصيرين "قاتلة ملك الشّياطين

349
00:23:52,320 --> 00:23:53,950
!أنت الأقوى يا باليروسا

350
00:23:53,950 --> 00:23:55,280
!توقّفوا

351
00:23:55,280 --> 00:23:57,400
."في الحلقة القادمة: "حتّى نهاية حياتي

352
00:23:57,400 --> 00:23:58,540
!تطلّعوا لها