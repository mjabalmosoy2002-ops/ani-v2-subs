1
00:00:04,060 --> 00:00:05,900
!يبدو كلّ هذا شهيًّا

2
00:00:06,160 --> 00:00:07,730
!يبدو شهيًّا بالفعل

3
00:00:08,130 --> 00:00:11,070
.تفضّلن بالأكل أيضًا لو سمحتنّ

4
00:00:11,070 --> 00:00:12,530
!لنبدأ الأكل

5
00:00:14,260 --> 00:00:17,520
!إنّ شريحة هالمبرغ هذه طريّة ولذيذة

6
00:00:17,520 --> 00:00:20,370
.نعم. أفضل ممّا يُقدّم في مطاعم البلدة

7
00:00:20,370 --> 00:00:22,960
.إنّك تصيرين أفضل يومًا بعد يوم يا سيّدة ريس

8
00:00:23,240 --> 00:00:26,570
!شكرًا، إنّ ذلك يُسعدني كثيرًا

9
00:00:26,570 --> 00:00:28,920
.كلّ هذا بفضل المعلّمة ميلينو

10
00:00:29,340 --> 00:00:31,620
ما زلت تذهبين لدروس الطّبخ؟

11
00:00:31,620 --> 00:00:35,780
،المعلّمة الّتي كنت أتعلّم عندها في هوتاو الآن

12
00:00:35,780 --> 00:00:38,370
.لذلك ذهبتُ لإلقاء التّحيّة عليها

13
00:00:38,370 --> 00:00:39,640
...ثمّ

14
00:00:40,830 --> 00:00:42,480
!معلّمة ميلينو

15
00:00:42,730 --> 00:00:43,960
!عجبًا

16
00:00:43,960 --> 00:00:45,730
.لم أرك منذ مدّة يا ريس

17
00:00:45,730 --> 00:00:49,710
.أردت رؤيتك وشكرك

18
00:00:49,710 --> 00:00:50,690
على ماذا؟

19
00:00:51,050 --> 00:00:52,400
!على هذا

20
00:00:52,690 --> 00:00:55,640
،بفضل دروس الطّبخ خاصّتك

21
00:00:55,640 --> 00:00:59,490
!استطعتُ أخيرًا الفوز بقلب زوجي

22
00:00:59,840 --> 00:01:02,830
!ممتاز! تهانيّ لك يا ريس

23
00:01:02,830 --> 00:01:07,900
،بما أنّك متزوّجة الآن
.سأعلّمك طبقًا مثاليًّا للعائلات

24
00:01:09,280 --> 00:01:12,920
...كما أنّ المعلّمة ميلينو بالغت كثيرًا

25
00:01:12,920 --> 00:01:17,320
.وعلّمتني كيف أعدّ طبقًا يحبّه الأطفال

26
00:01:17,320 --> 00:01:18,890
الأطفال؟

27
00:01:18,890 --> 00:01:22,140
.إنّهما متزوّجان، لذلك هناك دائمًا فرصة لذلك

28
00:01:22,140 --> 00:01:24,010
!هذا صحيح

29
00:01:29,210 --> 00:01:29,940
نعم؟

30
00:01:32,660 --> 00:01:33,840
...أنت

31
00:01:33,840 --> 00:01:37,400
الأميرة الأولى إليزابيث؟ ما الّذي أتى بك؟

32
00:01:37,920 --> 00:01:40,720
.سبق ورفضت عرضك لأكون البطل

33
00:01:41,230 --> 00:01:44,200
.اعذروني رجاءً على الزّيارة بدون إذن

34
00:01:44,200 --> 00:01:48,000
.أتيتُ للاعتذار لك يا سيّد فليو

35
00:01:48,390 --> 00:01:49,110
...كلاّ

36
00:01:49,780 --> 00:01:52,630
.أيّها البطل المرشّح المُستدعى بانازا

37
00:03:29,160 --> 00:03:32,940
،لا أدري إن كان هذا يليق بتقديمه لأميرة

38
00:03:33,440 --> 00:03:35,550
.ولكن تفضّلي بالهناء والشّفاء

39
00:03:35,550 --> 00:03:37,900
.شكرًا لك. سيسرّني أن أشربه

40
00:03:39,640 --> 00:03:44,720
أنا أعتذر بالفعل، لكن لديّ أمور
.مهمّة لأناقشها مع السّيّد فليو

41
00:03:44,720 --> 00:03:46,950
هل يمكنكنّ السّماح لنا بالحديث على انفراد؟

42
00:03:47,220 --> 00:03:48,440
.بالطّبع

43
00:03:48,440 --> 00:03:50,410
.أنا أرفض الرّحيل

44
00:03:50,870 --> 00:03:54,880
.رأيتُ كيف عاملت المملكة زوجي من قبل

45
00:03:54,880 --> 00:03:57,810
!لا يمكنني تركه معك ببال مرتاح

46
00:03:57,810 --> 00:03:58,960
...ريس

47
00:04:01,890 --> 00:04:04,610
.حسنًا. سنفعل ما تطلبين

48
00:04:04,610 --> 00:04:05,550
...عزيزي

49
00:04:06,060 --> 00:04:09,940
.لكنّ زوجتي ريس ستظلّ هنا

50
00:04:10,350 --> 00:04:13,690
إن كان هذا أمرًا لا يمكنك
،الحديث فيه بحضور زوجتي

51
00:04:13,990 --> 00:04:15,220
.فسأطلب منك المغادرة

52
00:04:21,680 --> 00:04:23,280
.مفهوم

53
00:04:25,720 --> 00:04:27,020
.حسنًا، هيّا بنا

54
00:04:35,940 --> 00:04:38,690
اسمح لي ثانية يا سيّد بانازا

55
00:04:38,690 --> 00:04:42,120
أن أعتذر لك من أعماق قلبي
على الظّلم الّذي تعرّضت إليه

56
00:04:42,980 --> 00:04:44,720
.من طرف هذه المملكة

57
00:04:45,140 --> 00:04:46,170
،وفوق كلّ شيء

58
00:04:46,170 --> 00:04:50,680
على التّعاويذ الّتي أُلقيت على الحقيبة
،السّحريّة الّتي أهدوها لك كعربون امتنان

59
00:04:50,680 --> 00:04:53,000
.والنّفي إلى غابة ديلافيزا

60
00:04:53,000 --> 00:04:54,870
.لا أملك كلمات كافية للاعتذار لك

61
00:04:59,860 --> 00:05:02,730
.كما أنّي ما عدتُ بانازا الآن. نادني فليو

62
00:05:03,230 --> 00:05:05,160
.ما أنا الآن إلا تاجر متواضع لا غير

63
00:05:05,900 --> 00:05:09,410
أظنّ أنّ الكثير قد حدث لتقبل اعتذاري؟

64
00:05:10,360 --> 00:05:14,410
،لا يهمّ كم مرّة ستعتذرين
.فليس بوسعي فعل شيء

65
00:05:14,410 --> 00:05:16,960
على أيّ حال، هلاّ دخلنا في صلب الموضوع؟

66
00:05:17,390 --> 00:05:22,680
من المستحيل أنّ أميرة مثلك أتت
.كلّ هذه المسافة للاعتذار لي فقط

67
00:05:24,720 --> 00:05:26,590
.أرى أنّ لا شيء يفوتك

68
00:05:30,320 --> 00:05:31,180
.هذه لأجلك

69
00:05:31,850 --> 00:05:32,650
ما هذه؟

70
00:05:33,340 --> 00:05:36,310
.إنّها أداة سحريّة تُظهر أين يتموضع جيش كلايرود

71
00:05:38,080 --> 00:05:39,840
الأضواء الّتي تراها على الخريطة

72
00:05:39,840 --> 00:05:43,650
تمثّل مواقع الأحجار السّحريّة
.الّتي يحملها كلّ قائدِ وحدة

73
00:05:44,120 --> 00:05:46,200
!هذه معلومات بالغة السّرّيّة

74
00:05:46,200 --> 00:05:47,400
لماذا تطلعينني عليها؟

75
00:05:48,210 --> 00:05:54,380
إنّ تأثير سحر التّطهير الّذي تمّ إلقاؤه
.حول بلدة القلعة سيختفي قريبًا

76
00:05:54,380 --> 00:05:59,670
وبمجرّد حدوث ذلك، سيستأنف
.جيش ملك الشّياطين تحرّكاته

77
00:06:00,780 --> 00:06:04,020
لكنّ سَحرتنا استنزفوا كلّ سحرهم
،لإلقاء تلك التّعويذة

78
00:06:04,020 --> 00:06:06,170
.ولم يستعيدوا كلّ عافيتهم بعد

79
00:06:06,620 --> 00:06:08,170
رغم أنّنا استعملنا جيّدًا

80
00:06:08,170 --> 00:06:11,670
ميزتنا الجغرافيّة لوضع قوّاتنا
،المتوفّرة في أماكن استراتيجيّة

81
00:06:12,250 --> 00:06:14,800
.هناك بعضة بلدات علينا تركها بلا حماية

82
00:06:15,470 --> 00:06:16,440
...لذلك

83
00:06:16,970 --> 00:06:21,480
.نودّ أن نطلب مساعدتك في حماية تلك البلدات

84
00:06:22,480 --> 00:06:28,520
لن أطلب منك القتال كبطل من
—أجل البشريّة. ولكن

85
00:06:28,520 --> 00:06:29,570
!مهلاً لحظة

86
00:06:29,570 --> 00:06:31,860
!هذا سخيف فحسب

87
00:06:31,860 --> 00:06:34,470
،بعد كلّ ما جعلتموه يمرّ به

88
00:06:34,470 --> 00:06:38,080
تريدون الآن توريط زوجي
!الّذي يكره القتال، في حرب؟

89
00:06:39,410 --> 00:06:43,520
سيستيقظ الملك الّذي صار طريح الفراش
.منذ إلقاء سحر التّطهير قريبًا

90
00:06:44,260 --> 00:06:48,790
،ولأنّ السّيّد فليو لديه علاقات بالشّياطين

91
00:06:48,790 --> 00:06:51,180
.أظنّ أنّ الملك سيرسل قوّات خلفه

92
00:06:52,330 --> 00:06:55,140
هل يفترض أن يكون هذا تهديدًا؟

93
00:06:55,140 --> 00:06:56,080
.لا

94
00:06:56,720 --> 00:07:01,280
هنالك أمور أستطيع فعلها الآن فقط بينما
.أملك السّلطة للتّصرف نيابة عن الملك

95
00:07:01,280 --> 00:07:02,230
مثل ماذا؟

96
00:07:02,860 --> 00:07:06,130
،لمحاسبته على تشويهه للبطل الحقيقيّ

97
00:07:06,130 --> 00:07:09,100
...وتعيينه للبطل المزيّف

98
00:07:09,940 --> 00:07:13,740
.سأجعل ملك كلايرود الحاليّ يتنازل عن العرش

99
00:07:16,010 --> 00:07:19,960
وسأكون ممتنّة لو ساعدتني
.في القيام بذلك يا سيّد فليو

100
00:07:20,300 --> 00:07:24,040
،حمى ملكنا هذه المملكة من عدّة مخاطر

101
00:07:24,520 --> 00:07:29,490
لكنّه فشل في توفير المساعدة
.للضّعفاء وتخلّى عنهم

102
00:07:30,710 --> 00:07:34,700
.أريد أن أخلفه في العرش وإنقاذ كلّ مواطنينا

103
00:07:35,570 --> 00:07:41,850
ولفعل ذلك، عليّ إظهار نفس مستوى
.السّلطة الّتي أظهرها الملك

104
00:07:41,850 --> 00:07:46,120
إنّك تريدين فقط استعمال زوجي
!لتصيري أنت الملكة

105
00:07:46,120 --> 00:07:47,740
.اهدئي يا ريس

106
00:07:49,440 --> 00:07:53,950
تريدين ضمانة فقط بأنّني لن أنضم
لقوّات ملك الشّياطين، صحيح؟

107
00:07:54,920 --> 00:07:57,660
.كشفت أمري بكلّ سهولة ثانية

108
00:07:57,660 --> 00:07:59,840
ما معنى ذلك؟

109
00:07:59,840 --> 00:08:01,900
،لماذا قد تتشارك معلومات حسّاسة كهذه معي

110
00:08:01,900 --> 00:08:03,840
،بصفتي شخصًا لديه علاقات بالشّياطين

111
00:08:03,840 --> 00:08:06,880
فقط لتدفعني إلى حماية منطقة
ليست لها علاقة بالحرب؟

112
00:08:07,710 --> 00:08:12,340
عفوًا... لتضمن أن تظلّ هناك بعيدًا عن الأحداث؟

113
00:08:12,840 --> 00:08:13,900
.بالضّبط

114
00:08:14,560 --> 00:08:19,180
لم تعتبرني الأميرة أبدًا كجزء من قوّات
.المملكة القتاليّة في هذه الحرب

115
00:08:20,040 --> 00:08:21,310
أليس كذلك؟

116
00:08:22,100 --> 00:08:26,770
.أنا فعلاً لا أتمنّى التّخلّي عن أيّ منطقة

117
00:08:27,360 --> 00:08:33,070
لم يخطر ببالك أبدًا أنّي قد أتشارك
هذه المعلومات مع الشّياطين؟

118
00:08:33,070 --> 00:08:38,240
يُرجى اعتبار هذا كأكبر دليل ممكن
.على الثّقة الّتي أضعها فيك

119
00:08:38,800 --> 00:08:44,210
سيّد فليو، أتوسّل إليك أن تعرنا
.قوّتك هذه المرّة

120
00:08:46,980 --> 00:08:48,670
!سُحقًا! فقدناهما

121
00:08:48,980 --> 00:08:51,000
كانا بالتّأكيد الثّنائيّ من ملصقات
المطلوبين، أليس كذلك؟

122
00:08:51,330 --> 00:08:53,720
!إلى أين ذهبا؟ أبعدنا نظرنا عنهما للحظة فقط

123
00:08:58,060 --> 00:08:59,350
.لقد ذهبا

124
00:09:00,800 --> 00:09:02,990
،خرجنا من تلك الحفرة أخيرًا

125
00:09:02,990 --> 00:09:05,830
.لكن علينا مواصلة الهرب في الأرجاء

126
00:09:05,830 --> 00:09:08,140
.أنا متعبة

127
00:09:08,140 --> 00:09:13,100
!كفّي عن البكاء
!لن أسمح لهم بالإمساك بي هنا

128
00:09:13,100 --> 00:09:15,260
،بهدف العودة كبطل

129
00:09:15,260 --> 00:09:17,320
!فعليّ التّخلّص ممّن يطاردونني

130
00:09:19,840 --> 00:09:22,040
.أنا جائعة أيضًا

131
00:09:22,040 --> 00:09:24,110
!أخبرتك أن تكفّي عن البكاء

132
00:09:24,110 --> 00:09:26,420
...تبًّا... لديّ شيء ما

133
00:09:27,100 --> 00:09:27,870
.خذي

134
00:09:28,320 --> 00:09:30,000
أأنت واثق؟

135
00:09:30,410 --> 00:09:33,590
.لكن لم يتبقّى لنا الكثير من الطّعام

136
00:09:33,590 --> 00:09:35,370
.كليها فحسب

137
00:09:35,370 --> 00:09:37,180
!شكرًا لك

138
00:09:37,650 --> 00:09:43,830
على أيّ حال، أنا متفاجئ لأنّك قرّرت
.أن تتبعيني يا تسويا

139
00:09:44,260 --> 00:09:47,520
.يمكنني قول نفس الشّيء لك أيّها البطل

140
00:09:48,480 --> 00:09:53,860
ألن يكون من السّهل عليك الهرب بدوني؟

141
00:09:54,890 --> 00:09:57,240
...نـ-نعم، ذلك ممكن

142
00:09:57,240 --> 00:10:01,830
.لا أريد أن أعيش كسجينة للأبد أيضًا

143
00:10:01,830 --> 00:10:02,950
...لذلك

144
00:10:03,490 --> 00:10:07,630
...في اللّحظة الّتي فتحتَ فيها الباب لزنزانتنا

145
00:10:08,390 --> 00:10:11,170
.بدوت جذّابًا جدًّا

146
00:10:13,300 --> 00:10:17,270
مع أنّي أعتقد بالفعل أنّك أخطأت
...بالتّصرّف في بعض الأمور

147
00:10:17,270 --> 00:10:18,700
!اصمتي

148
00:10:18,700 --> 00:10:22,220
،مهما حاولت مناداتي بالبطل
!سينتهي أمرنا إن متّ

149
00:10:22,220 --> 00:10:23,680
!لم يكن لديّ خيار

150
00:10:24,290 --> 00:10:25,390
.حسنًا، هيّا بنا

151
00:10:28,700 --> 00:10:30,520
!أ-أيّها البطل

152
00:10:30,750 --> 00:10:31,600
!تسويا

153
00:10:33,910 --> 00:10:36,110
!ما-ما هذا؟

154
00:10:39,300 --> 00:10:44,150
.خرجتُ للبحث عن قربان، لكنّي وجدتُ رجلاً وسيمًا

155
00:10:52,880 --> 00:10:55,420
هل يمكنني أن أنضمّ لك يا عزيزي؟

156
00:10:55,670 --> 00:10:58,170
.ماذا؟ نعم، لا بأس

157
00:11:02,120 --> 00:11:05,210
هل كنت تفكّر فيما طلبته منك الأميرة؟

158
00:11:05,800 --> 00:11:06,600
.نعم

159
00:11:07,000 --> 00:11:10,730
...أنا أكره فعلاً فكرة القتال، لكن

160
00:11:11,420 --> 00:11:17,070
لا أستطيع الجلوس دون فعل أيّ شيء
.بينما أعرف أنّ هناك بلدات قد تعاني

161
00:11:17,620 --> 00:11:19,070
...عزيزي

162
00:11:19,350 --> 00:11:22,280
كما أنّي كنتُ أفكّر كثيرًا

163
00:11:22,280 --> 00:11:24,740
،بشأن ما عليّ القيام به في هذا العالم

164
00:11:25,490 --> 00:11:26,870
.وما أريد فعله

165
00:11:27,750 --> 00:11:31,430
،إن أنجبنا طفلاً معًا يومًا ما

166
00:11:31,430 --> 00:11:37,130
أريد لذلك الطّفل أن يعيش بسعادة
.مع أطفال البشر وأطفال الشّياطين معًا

167
00:11:37,440 --> 00:11:39,590
.عليّ إنشاء ذلك العالم من أجله

168
00:11:40,400 --> 00:11:42,630
.أعلم أنّ الأمر لن يكون سهلاً

169
00:11:42,880 --> 00:11:48,100
لكن إن كان هنالك أيّ شيء يمكنني
.فعله لتحقيق ذلك، فسأفعله

170
00:11:48,830 --> 00:11:53,310
أعلم أنّك قادر على القيام بأشياء
.قد يعتبرها الآخرون مستحيلة

171
00:11:53,850 --> 00:11:58,020
قد لا يكون هناك الكثير ممّا يمكنني
.فعله، لكنّي سأساعد بأيّ طريقة ممكنة

172
00:11:59,240 --> 00:12:01,550
.شكرًا يا ريس

173
00:12:09,780 --> 00:12:12,140
!إلى الشّمال الشّرقيّ! قرب مدخل الغابة

174
00:12:12,140 --> 00:12:14,500
!يتّجه جيش ضخم إلى هنا

175
00:12:14,500 --> 00:12:16,060
!جيش ملك الشّياطين يقترب

176
00:12:16,060 --> 00:12:17,840
!ابتعدوا قدر الإمكان عن المنطقة

177
00:12:18,080 --> 00:12:19,420
!هيّا، بسرعة

178
00:12:42,010 --> 00:12:43,900
!اهربي بينما بإمكانك ذلك! هيّا

179
00:12:47,000 --> 00:12:49,700
،قلتُ بالفعل أنّي سأساعدك

180
00:12:49,700 --> 00:12:53,040
لكن لم أتخيّل أن تقبل بعمل شاقّ
.مثل هذا دون أيّ مكافأة

181
00:12:53,040 --> 00:12:55,120
.إنّك طيّب كثيرًا يا عزيزي

182
00:12:55,680 --> 00:12:57,220
،إن قبلتُ بمكافأة

183
00:12:57,220 --> 00:13:00,490
فسيعني ذلك أنّي أخذت جانب
.البشر مقابل المال

184
00:13:01,250 --> 00:13:05,220
سأكون بذلك قد خسرت في اللّحظة
.الّتي أصغيت فيها لطلبها

185
00:13:05,930 --> 00:13:10,060
خـ-خسرت؟ هل يعني ذلك
!أنّك ستتزوّج الأميرة؟

186
00:13:10,060 --> 00:13:11,480
!بالطّبع لا

187
00:13:11,480 --> 00:13:16,160
هناك أجناس عديدة من الشّياطين
...يتّخذ أفرادها أكثر من زوجة

188
00:13:16,160 --> 00:13:18,720
ما-ما الّذي سأفعله؟

189
00:13:18,720 --> 00:13:20,650
!أخبرتك أنّي لن أتزوّجها

190
00:13:20,930 --> 00:13:23,840
!ذات أنياب تعمل مع بشريّ؟

191
00:13:23,840 --> 00:13:25,620
!من تكونين يا هذه؟

192
00:13:25,620 --> 00:13:27,240
.نحن حرّاس هذه البلدة

193
00:13:27,780 --> 00:13:31,110
.إن وافقتم على الانسحاب، فسندعكم وشأنكم

194
00:13:31,110 --> 00:13:35,160
،لكن إن كنتم تنوون إلحاق الأذى بالنّاس هنا

195
00:13:35,160 --> 00:13:35,960
.فلن نظهر لكم أيّ رحمة

196
00:13:35,960 --> 00:13:39,410
!أقلت لا رحمة؟! لا تستخفّ بنا

197
00:13:39,410 --> 00:13:41,440
!أنت مجرّد بشريّ ضعيف

198
00:13:41,440 --> 00:13:43,360
.أنا لا أستخفّ بكم

199
00:13:43,360 --> 00:13:46,480
.ما أقوله هو أنّها ستكون إضاعة للجهد لكلينا

200
00:13:46,480 --> 00:13:50,780
لا يمكنكم كسر سحر الحاجز هذا
في كلّ الأحوال، صحيح؟

201
00:13:54,380 --> 00:13:55,360
.ابتعدوا

202
00:13:58,200 --> 00:14:00,270
.أنا سأكسره

203
00:14:00,920 --> 00:14:02,980
.إنّه صقلوب

204
00:14:02,980 --> 00:14:06,080
لا يوجد جنس آخر في جيش ملك
.الشّياطين يملك قوّة جسديّة مثلهم

205
00:14:06,080 --> 00:14:09,110
.وهذا يخدم يويغارد، أخو غوزال الأصغر

206
00:14:09,390 --> 00:14:10,710
ذات أنياب؟

207
00:14:11,330 --> 00:14:14,090
،جنس جبان بقائد أحمق تسبّبَ في مقتله

208
00:14:14,090 --> 00:14:18,120
رغم أنّه يصف نفسه بأحد ملوك السّماء
.الأربعة في جيش ملك الشّياطين

209
00:14:19,220 --> 00:14:21,290
.أنت لستِ ندًّا لي

210
00:14:21,290 --> 00:14:26,250
يا عزيزي، هلاّ سمحت لي بتولّي أمر هذا بنفسي؟

211
00:14:26,250 --> 00:14:27,130
...ريس

212
00:14:27,460 --> 00:14:31,220
.صحيح أنّ أخي فينغاريل قد هُزم

213
00:14:31,220 --> 00:14:33,510
لكن بصفتنا أحد أعلى الضّبّاط
،في جيش ملك الشّياطين

214
00:14:33,510 --> 00:14:36,310
.فربّما من الصّواب أن نتحمّل المسؤوليّة

215
00:14:36,310 --> 00:14:37,230
...ولكن

216
00:14:37,490 --> 00:14:40,680
إن كانت هزيمة أخي قد قادتك
،للاستخفاف بذوي الأنياب

217
00:14:40,680 --> 00:14:44,550
الّذين يُعتبرون جنسًا يقدّر القوّة
،العسكريّة أكثر من غيرها

218
00:14:44,550 --> 00:14:47,940
وكأخته الصّغيرة، لا يمكنني الجلوس
.مكتوفة الأيدي والتّغاضي عن إهانتك له

219
00:14:48,300 --> 00:14:53,910
سأري هذا المتعجرف الأحمق
.مدى الاختلاف بين قوّتينا

220
00:14:54,570 --> 00:14:56,570
،لا يمكنني القول أنّي لا أمانع هذا

221
00:14:57,170 --> 00:14:59,620
،لكن إن كان الأمر مهمًّا لك

222
00:15:00,090 --> 00:15:02,380
.فأظنّ أنّه لا يحقّ لي التّدخّل

223
00:15:02,950 --> 00:15:04,880
.لكن لا تقتليه

224
00:15:04,880 --> 00:15:06,880
.مفهوم

225
00:15:09,000 --> 00:15:11,950
!كلّ ما تجيدينه هو النّباح أيّتها الجروة

226
00:15:11,950 --> 00:15:15,560
!اخرسي ودعي ذلك الجدار السّحريّ يحميك

227
00:15:15,950 --> 00:15:19,890
!لن تصيبني أبدًا بتلويحاتك الواسعة تلك

228
00:15:19,890 --> 00:15:21,350
...أيّتها

229
00:15:28,840 --> 00:15:33,370
وهل تعتقدين فعلاً أنّ بإمكانك
هزيمتي بهجمات ضعيفة كهذه؟

230
00:15:33,370 --> 00:15:36,490
،صحيح أنّ لديك جلدًا صلبًا كأنّه درع

231
00:15:36,490 --> 00:15:40,770
لكن يتطلّب الأمر جهدًا منّي
.لكبح نفسي عن قتلك

232
00:15:40,770 --> 00:15:44,580
،قبل مدّة، كنتُ لأحاول القضاء عليك بسرعة

233
00:15:45,010 --> 00:15:48,210
.لكنّي تعلّمتُ شيئًا يدعى ضبط النّفس الآن

234
00:15:48,210 --> 00:15:49,300
ماذا؟

235
00:15:49,300 --> 00:15:51,580
!عليك أن تكون ممتنًّا لزوجي

236
00:15:52,960 --> 00:15:54,640
!القفزة العالية

237
00:15:58,450 --> 00:16:00,020
!تبادل الأماكن

238
00:16:01,980 --> 00:16:05,300
!تبادلت مكانك معي؟

239
00:16:05,300 --> 00:16:08,980
!إيّاك أن تعتقدي أنّ ذلك كافٍ لإيقافي

240
00:16:11,320 --> 00:16:12,820
!تبادل الأماكن

241
00:16:16,950 --> 00:16:20,400
لا يهمّ ما مدى قوّة تلك العضلات
،الّتي تفتخر بها

242
00:16:20,400 --> 00:16:23,290
.تصير هدفًا سهلاً بمجرّد تكبّدك لإصابة

243
00:16:23,920 --> 00:16:25,250
!سحر الجاذبيّة

244
00:16:28,690 --> 00:16:30,500
.صرتَ الآن مثبّتًا في الأرض

245
00:16:30,500 --> 00:16:33,470
هل ما زلت تريد المواصلة؟
.مع أنّي أرى أنّ ذلك مستحيل

246
00:16:34,590 --> 00:16:38,240
إنّك تقاتلين بمثل الطّرق الوقحة
!الّتي يستعملها البشر

247
00:16:38,240 --> 00:16:42,770
تلك الوقاحة هي السّبب الوحيد
.في بقائك حيًّا حتّى الآن

248
00:16:42,770 --> 00:16:44,290
!سُحقًا لك

249
00:16:44,290 --> 00:16:46,980
!أنتم! لماذا تشاهدون فحسب؟

250
00:16:46,980 --> 00:16:49,980
اسحقوها! لا ترحموا من خانت
!جيش ملك الشّياطين

251
00:16:52,440 --> 00:16:53,820
.هذا يكفي

252
00:16:55,110 --> 00:16:56,950
!لا يمكنني الحركة

253
00:16:59,910 --> 00:17:03,900
.أنا أكثر من قادرة على قتالهم جميعًا يا عزيزي

254
00:17:04,320 --> 00:17:05,990
.تحدّد الفائز سلفًا

255
00:17:06,450 --> 00:17:08,840
.لا داعي للمزيد من القتال

256
00:17:08,840 --> 00:17:11,930
.أعلم مسبقًا كم أنت قويّة

257
00:17:11,930 --> 00:17:14,410
!آهٍ يا عزيزي

258
00:17:14,410 --> 00:17:15,620
.سحر الشّفاء

259
00:17:19,990 --> 00:17:21,600
!ما الّذي تخطّط له؟

260
00:17:21,970 --> 00:17:24,810
.سبق وأخبرتك. كلّ ما أريده هو أن تنسحبوا

261
00:17:25,470 --> 00:17:29,690
أستطيع استعمال سحر الانتقال
،لإرسالكم جميعًا إلى غابة ديلافيزا

262
00:17:29,690 --> 00:17:31,670
لكنّكم ستعودون ثانية فحسب، صحيح؟

263
00:17:32,220 --> 00:17:34,820
.لذلك أريدكم أن تغادروا من تلقاء أنفسكم

264
00:17:35,080 --> 00:17:39,530
!كـ-كلامك غير منطقيّ
!من تكون على أيّ حال؟

265
00:17:40,380 --> 00:17:45,250
.أنا مجرّد بشريّ صار صديقًا لهذه الشّيطانة هنا

266
00:17:47,420 --> 00:17:50,290
،وأودّ فعلاً لو أصير صديقًا لكم جميعًا أيضًا

267
00:17:50,880 --> 00:17:53,440
...لكن إن رفضتم ذلك

268
00:17:54,720 --> 00:17:56,830
.فسأواجهكم بقدر ما تشاؤون

269
00:17:58,160 --> 00:18:00,020
.حتّى تتراجعوا جميعًا

270
00:18:07,410 --> 00:18:09,360
.نجحنا أخيرًا في جعلهم يغادرون

271
00:18:09,360 --> 00:18:12,570
!كنتَ مذهلاً بالفعل يا عزيزي

272
00:18:12,910 --> 00:18:16,630
كلّ ذلك الوقت الّذي أمضيته في التّدرّب
!على وضعيتك في المنزل قد أتى بثماره

273
00:18:17,940 --> 00:18:21,570
.الشّيء الأكثر أهمّيّة في المعركة هو التّخويف

274
00:18:21,570 --> 00:18:23,520
.عليك إخافة خصمك

275
00:18:23,520 --> 00:18:24,520
!ماذا؟

276
00:18:27,540 --> 00:18:30,380
!واجعلهم يهربون بنظرة واحدة منك

277
00:18:31,980 --> 00:18:35,040
جعلني ذلك متوتّرًا أكثر من أيّ
.حديث تجارة سبق وخُضته

278
00:18:35,040 --> 00:18:38,210
ومع ذلك، هل أنت واثق أنّ ذلك
كان الخيار الأصحّ؟

279
00:18:39,310 --> 00:18:44,030
.سيهاجمون ثانية بمجرّد أن يُؤمروا بذلك

280
00:18:44,030 --> 00:18:46,690
ألا يفترض بنا أن نعذّبهم بوحشيّة أكثر

281
00:18:46,690 --> 00:18:50,150
والتّقليل من إرادتهم في ردّ القتال؟

282
00:18:50,150 --> 00:18:51,500
...ريس

283
00:18:52,250 --> 00:18:56,750
،قد تكون تلك طريقة أفضل لضمان عدم عودتهم

284
00:18:57,440 --> 00:19:02,990
لكن ألن يؤدّي ذلك إلى زيادة الكراهية
بين البشر والشّياطين فحسب؟

285
00:19:02,990 --> 00:19:05,580
الكراهية؟

286
00:19:06,240 --> 00:19:08,220
.مرحبًا أيّها الرّجل الطّيّب

287
00:19:09,440 --> 00:19:13,840
.شكرًا جزيلاً على إنقاذك لبلدتنا

288
00:19:14,100 --> 00:19:18,090
لـ-لكن... لماذا هذا الذّئب هنا؟

289
00:19:18,660 --> 00:19:20,540
.لا داعي للقلق

290
00:19:21,220 --> 00:19:23,550
.إنّها شريكتي

291
00:19:26,410 --> 00:19:27,640
...عـ-عفوًا

292
00:19:28,120 --> 00:19:32,350
.شكرًا... على إنقاذي قبل قليل

293
00:19:33,530 --> 00:19:35,800
.سرّني أنّك لم تتأذّي

294
00:19:36,350 --> 00:19:40,130
.أتينا إلى هنا بأوامر من الأميرة الأولى

295
00:19:40,740 --> 00:19:42,490
.هي من عليكم شكرها

296
00:19:42,720 --> 00:19:44,080
!الأميرة الأولى؟

297
00:19:44,080 --> 00:19:46,760
!كم أنا ممتنّ لها

298
00:19:52,760 --> 00:19:54,250
.لديّ بعض أخبار

299
00:19:54,990 --> 00:19:57,250
وصلتنا عدّة تقارير عن مغامر مجهول

300
00:19:57,250 --> 00:20:01,090
يظهر في عدّة مناطق ويطرد
.قوّات جيش ملك الشّياطين

301
00:20:01,400 --> 00:20:04,180
مغامر مجهول؟ من يكون؟

302
00:20:04,690 --> 00:20:07,560
،نعلم أنّه يظهر برفقة ذئب فضّيّ

303
00:20:07,560 --> 00:20:10,390
.وهو بنفسه يرتدي قناعًا ذئب على وجهه

304
00:20:10,880 --> 00:20:13,850
تقول التّقارير أنّه يطرد قوّات جيش ملك
،الشّياطين ويغادر ببساطة بعدها

305
00:20:13,850 --> 00:20:15,650
.دون الإدلاء باسمه

306
00:20:15,650 --> 00:20:19,010
يغادر ببساطة؟ دون المطالبة حتّى بالمال؟

307
00:20:19,010 --> 00:20:20,090
.صحيح

308
00:20:20,090 --> 00:20:24,070
.ولكن، يقول أنّ الأميرة الأولى هي الّتي أرسلته

309
00:20:24,430 --> 00:20:28,030
.إنّ رسائل الشّكر تتوافد باستمرار من كلّ مكان

310
00:20:29,680 --> 00:20:32,540
...لا يعقل أنّ هذا المغامر

311
00:20:32,780 --> 00:20:36,170
.نعم. لا شكّ أنّه هو

312
00:20:36,940 --> 00:20:40,410
.لقد قبل السّيّد فليو بطلبي

313
00:20:41,320 --> 00:20:44,240
.أبلغوا كلّ قوّات كلايرود في أرجاء المملكة

314
00:20:44,240 --> 00:20:47,160
أخبروهم أنّهم إن رأوا هذا
،المغامر مع الذّئب الفضّيّ

315
00:20:47,160 --> 00:20:49,460
.فعليهم التّعاون معه بكلّ ما باستطاعتهم

316
00:20:49,460 --> 00:20:50,100
.حاضر

317
00:20:50,610 --> 00:20:53,340
.فعل السّيّد فليو كلّ هذا لأجلي

318
00:20:54,080 --> 00:20:57,180
.عليّ ردّ الجميل في وقت لاحق

319
00:21:02,110 --> 00:21:03,610
...يويغارد

320
00:21:04,000 --> 00:21:06,700
كيف يجرؤ على التّصرّف بدون أوامر منّي؟

321
00:21:07,290 --> 00:21:08,340
.سيّدي غول

322
00:21:09,290 --> 00:21:10,880
.اعذر تطفّلي

323
00:21:10,880 --> 00:21:13,620
.أبلغتْ السّيّدة أوليميناس عن حالة طارئة

324
00:21:14,040 --> 00:21:14,980
ما هي؟

325
00:21:14,980 --> 00:21:17,830
.يخطّط السّيّد يويغارد للتّمرّد

326
00:21:17,830 --> 00:21:20,960
.قالت أنّه احتلّ غرفة العرش رفقة أقرب مساعديه

327
00:21:23,970 --> 00:21:26,550
كلّ شيء جاهز، صحيح يا فوفون؟

328
00:21:26,550 --> 00:21:27,420
.نعم

329
00:21:27,420 --> 00:21:32,160
ومن حسن الحظّ أنّنا اخترنا بعض البشر
.من ذوي الإحصائيّات العالية إلى حدّ ما

330
00:21:32,160 --> 00:21:36,140
عندما تواجه السّيّد غول، فعلينا تنفيذ
الفنّ السّرّيّ المستعار من الإله الشّرير

331
00:21:36,710 --> 00:21:40,880
عن طريق نشر دائرة سحريّة
.من أجل طقس التّهجين الفائق

332
00:21:40,880 --> 00:21:44,610
.بإمكانهما أن يكونا القربانين من أجل إله الشّرّ

333
00:21:44,610 --> 00:21:46,380
!النّجدة

334
00:21:46,380 --> 00:21:49,370
!أنتم! ستدفعون ثمن هذا

335
00:21:49,370 --> 00:21:52,070
،حتّى في مواجهة السّيّد غول

336
00:21:52,070 --> 00:21:57,000
.أعتقد أنّ هذا الطّقس سيضمن انتصارك

337
00:21:57,960 --> 00:21:59,060
...حسنًا

338
00:21:59,530 --> 00:22:02,130
!عد إلى هنا بسرعة يا غول

339
00:22:02,870 --> 00:22:07,010
!سأهزمك، وسيصير هذا العرش لي

340
00:23:40,940 --> 00:23:42,150
.هذه هي الأميرة الأولى

341
00:23:42,150 --> 00:23:44,590
،إعلانات الحلقة القادمة تكون حافلة دائمًا

342
00:23:44,590 --> 00:23:46,690
ومع ذلك سأقوم بذلك وحدي. لماذا؟

343
00:23:47,000 --> 00:23:49,780
وما زال الاسم الّذي يُشار لي به
...هو "أميرة"، مع أنّ لديّ اسمًا

344
00:23:49,780 --> 00:23:51,510
!أفهم معاناتك أيّتها الأميرة

345
00:23:51,510 --> 00:23:52,450
!أيّها البطل الأشقر

346
00:23:52,450 --> 00:23:55,410
!مررت بنفس ما مررت به أيضًا

347
00:23:55,410 --> 00:23:56,910
يتمّ معاملتي مثلك أنت؟

348
00:23:56,910 --> 00:23:59,260
!أ-أنا؟