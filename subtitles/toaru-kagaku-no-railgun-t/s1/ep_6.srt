1
00:00:01,350 --> 00:00:02,180
...وأيضًا

2
00:00:05,560 --> 00:00:07,310
...لستِ الوحيدة

3
00:00:07,860 --> 00:00:10,320
...الّتي تواجه مشاكل في كبح غضبها

4
00:00:10,990 --> 00:00:13,200
.بسبب رؤية إحدى أصدقائها تُهان

5
00:00:16,530 --> 00:00:19,160
غاضبة لأنّ صديقتك أُهينت؟

6
00:00:19,160 --> 00:00:22,160
هل الاعتماد النّفسيّ على الآخرين
أصبح موجة رائجة أو ما شابه؟

7
00:00:30,380 --> 00:00:32,970
تحاولين أن تبدي كبطلة بقيامك
،بشيء من أجل شخص آخر

8
00:00:32,970 --> 00:00:36,090
ولكن تجدين نفسك عالقة
،في وضع لا يمكنك الهرب منه

9
00:00:36,090 --> 00:00:39,010
.لوميهنّ على الأمر وتمنّي لو لم يحدث

10
00:00:40,560 --> 00:00:43,680
يبدو أنّ الأشخاص الّذين
لا يملكون حسًّا بالخيال

11
00:00:43,680 --> 00:00:46,810
.لا يمكنهم إدراك ذلك إلاّ إن جرّبوه بأنفسهم

12
00:00:51,570 --> 00:00:52,820
ماء؟

13
00:01:00,160 --> 00:01:03,330
لطالما سمعت أنّ الأشخاص فاقدي
...الوعي ثقيلو الوزن، لكن

14
00:01:04,910 --> 00:01:06,330
أصبحت أخفّ وزنًا...؟

15
00:01:06,830 --> 00:01:09,790
هل هذه قدرتك يا أواتسوكي-سان؟

16
00:01:09,790 --> 00:01:11,340
.لن تدوم لوقت طويل

17
00:01:11,880 --> 00:01:13,420
.غادري بسرعة بينما الفرصة سانحة

18
00:01:16,050 --> 00:01:16,840
!انتظري

19
00:01:17,180 --> 00:01:19,970
هل تعتقدين أنّني سأجعلك
تذهبين بهذه البساطة؟

20
00:01:26,060 --> 00:01:30,270
إن كان هذا كلّ ما لديك، فإنّ آليّي الكلب
!الدّنماركي الضّخم بإمكانهم القفز فوقه

21
00:01:41,660 --> 00:01:43,370
!...الدّليل الوحيد الّذي لديّ

22
00:01:44,750 --> 00:01:46,160
.كنتُ أمزح

23
00:01:46,870 --> 00:01:49,710
،حتّى بعد حقنها للأجهزة الدّقيقة

24
00:01:49,710 --> 00:01:52,800
يظلّ آليّو البعوض مفيدين
.كأجهزة لتحديد المواقع

25
00:01:52,800 --> 00:01:56,170
ما دمت أستطيع تقفّي أثرها، بإمكاني
.القيام بكلّ ما أريد بمجرّد أن أنتهي هنا

26
00:01:56,760 --> 00:01:58,090
...لكن الآن

27
00:01:59,430 --> 00:02:01,890
.عليّ الاهتمام بأمر هاتين

28
00:03:38,070 --> 00:03:40,650
."عليّ الاتّصال بالإسعاف وبـ"مضادّي المهارات

29
00:03:41,570 --> 00:03:44,700
.آمل أن تكون وانّاي-سان وأواتسوكي-سان بخير

30
00:03:51,040 --> 00:03:51,910
نعم؟

31
00:03:51,910 --> 00:03:54,750
ما الوضع يا بابا-تشان؟
هل يسير كلّ شيء على ما يرام؟

32
00:03:54,750 --> 00:03:56,540
.نعم، دون مشاكل

33
00:03:59,300 --> 00:04:02,220
،يا آليّي الكلب الدّنماركي الضّخم
!عليكم الاقتراب أكثر

34
00:04:02,220 --> 00:04:03,010
ما الخطب؟

35
00:04:03,260 --> 00:04:05,090
هل تقاتل الآن يا بابا-تشان؟

36
00:04:05,090 --> 00:04:08,720
.حدث ذلك رغمًا عنّي
.لذلك قد يأخذ الأمر بعض الوقت

37
00:04:09,470 --> 00:04:12,520
هل أنت بخير؟
هل أرسل لك تعزيزات؟

38
00:04:12,520 --> 00:04:14,650
.لا، لا داعي لذلك

39
00:04:14,650 --> 00:04:15,940
أأنت واثق؟

40
00:04:15,940 --> 00:04:19,480
،أنا قلقة جدًّا عليك
.لا يمكنني فعل أيّ شيء آخر

41
00:04:19,480 --> 00:04:20,940
.يا لها من كاذبة

42
00:04:20,940 --> 00:04:23,610
حسنًا، ما رأيك أن أستعيد دليلك؟

43
00:04:24,450 --> 00:04:27,570
لسوء الحظّ، ما زلت لا أملك
.أيّة معلومات مفيدة

44
00:04:28,080 --> 00:04:32,290
لذلك عدّلي البيانات لتأخير وصول
.مضادّي المهارات" إن أمكنك"

45
00:04:32,870 --> 00:04:36,830
غبيّة. أتعتقدين أنّني سأدعك
تستفيدين من كلّ مجهوداتي؟

46
00:04:36,830 --> 00:04:40,550
والآن، لم تتنافس هاتان الاثنتان
،في منافسة صائد البالونات

47
00:04:40,550 --> 00:04:43,050
...لذلك لم أتحقّق من قدراتهما

48
00:04:43,050 --> 00:04:45,680
لكنّ قدرة صاحبة الشّعر
.الكستنائيّ هي اليد المائيّة

49
00:04:45,680 --> 00:04:49,760
،إن غرقت كلابي الآليّة في الماء
،فستكون في خطر

50
00:04:49,760 --> 00:04:53,850
لكنّها ليست قويّة كفاية لتستطيع
.تنفيذ ضربات قاضية وهي تقاتل برًّا

51
00:04:55,730 --> 00:04:59,690
وقدرة صاحبة الضّفيرة
هي التّحريك الذّهنيّ، صحيح؟

52
00:04:59,690 --> 00:05:03,860
لكن بعد رؤيتي أنّها لا تستطيع
،الإطاحة بكلابي الآليّة

53
00:05:03,860 --> 00:05:05,400
.فهي لا تملك قوّة كبيرة

54
00:05:07,110 --> 00:05:09,780
.قدراتهما من المستوى 3 تقريبًا

55
00:05:09,780 --> 00:05:12,160
،أشكّ أنّهما تملكان أيّ خبرة قتاليّة

56
00:05:12,160 --> 00:05:15,410
لكن تبدوان ماهرتين في الهجوم
.بشكل متناسق معًا

57
00:05:15,910 --> 00:05:18,750
لديّ عدد محدود من البيادق
.لأستعمله أنا أيضًا

58
00:05:21,420 --> 00:05:23,130
.لستما سيّئتين على الإطلاق

59
00:05:24,880 --> 00:05:29,890
...أبحث عن أخت ميساكا ميكوتو
.إنّها توأمها

60
00:05:31,390 --> 00:05:33,560
...أنت يا صاحبة الشّعر الكستنائيّ

61
00:05:33,930 --> 00:05:36,140
ناديتِ تلك الفتاة قبل قليل
بكونغو ميتسوكو، صحيح؟

62
00:05:36,140 --> 00:05:39,860
كنتما تناقشان شيئًا عن دليل
يقود للأخت، صحيح؟

63
00:05:39,860 --> 00:05:42,860
هلاّ أخبرتني ما هو ذلك الدّليل؟

64
00:05:43,280 --> 00:05:45,780
.لا أطلب منك إخباري به مجّانًا بالطّبع

65
00:05:46,650 --> 00:05:49,160
.هنالك جهاز دقيق داخل هذه

66
00:05:49,160 --> 00:05:52,160
،إنّه نموذج من الطّراز الرّفيع
.بإمكانه شلّ حركة أيًّا كان هدفه

67
00:05:53,160 --> 00:05:55,790
حقنت أحدها في كونغو
.ميتسوكو قبل قليل

68
00:05:56,750 --> 00:06:01,000
أقول الحقيقة. باستعمال آليّ بحجم
.البعوضة، بإبرة في غاية الصّغر

69
00:06:01,250 --> 00:06:04,630
،عندما لمستُ كونغو-سان
.كانت حرارتها مرتفعة جدًّا

70
00:06:05,010 --> 00:06:07,880
.أعتقد أنّ كلامه ربّما يكون صحيحًا

71
00:06:08,510 --> 00:06:12,720
إزالة الجهاز الدّقيق بعد
.حقنه عمليّة معقّدة

72
00:06:12,720 --> 00:06:16,600
لكن إن كان معكما هذا، قد تكونان
.قادرتين على إبطال الأمر

73
00:06:17,230 --> 00:06:19,520
هل تودّان مبادلة معلومتكما به؟

74
00:06:20,060 --> 00:06:22,440
تريدان مساعدة صديقتكما، صحيح؟

75
00:06:25,230 --> 00:06:28,200
.ليس إمكاننا إخبار شخص مثلك بالأمر

76
00:06:29,110 --> 00:06:31,820
.ولكن، سنأخذ ذلك الجهاز الدّقيق منك

77
00:06:32,830 --> 00:06:35,080
!حتّى إن كان علينا أخذه بالقوّة

78
00:06:36,700 --> 00:06:41,000
.يا إلهي، فشلت المفاوضات
...ما باليد حيلة

79
00:06:41,460 --> 00:06:45,090
.إحداهما قد تمّ استعمالها سلفًا وهي فارغة

80
00:06:45,090 --> 00:06:47,710
.والأخرى تحتوي على الجهاز الدّقيق بداخلها

81
00:06:50,550 --> 00:06:52,510
أيّهما هي الّتي تريدان؟

82
00:06:52,890 --> 00:06:53,640
!أواتسوكي-سان

83
00:06:53,640 --> 00:06:54,140
!في الحال

84
00:06:59,270 --> 00:07:01,940
.تعلمان أنّه فخّ، ومع ذلك انفصلتا

85
00:07:01,940 --> 00:07:03,690
.كم من السّهل التّلاعب بهما

86
00:07:05,690 --> 00:07:07,070
—مكانك! إلى أين أنت

87
00:07:09,530 --> 00:07:13,200
،هيّا، هيّا! عليك البدء بملاحقتي
!وإلاّ هربتُ منك

88
00:07:18,750 --> 00:07:19,830
،في منافسة شطيرة البالونات

89
00:07:20,330 --> 00:07:23,540
يبدو أنّ كونغو-سان وميساكا-سان
.قد تنافستا معًا

90
00:07:23,790 --> 00:07:27,130
.أتساءل إن كانتا صديقتين مقرّبتين

91
00:07:27,800 --> 00:07:28,800
..."المسدّس الكهرومغناطيسيّ"

92
00:07:31,180 --> 00:07:33,300
،كلّما فكّرتُ في تلك الفتاة

93
00:07:33,300 --> 00:07:36,510
!أشعر بضيق في صدري بأكمله

94
00:07:36,510 --> 00:07:42,020
لا أريد حتّى التّفكير في تلك الفتاة المتغطرسة
!الّتي لا شيء يميّزها سوى جمالها

95
00:07:42,440 --> 00:07:48,360
،إن كنتِ مهتمّة بها لتلك الدّرجة
.فلا بدّ أنّه كان لقاء مقدّرًا

96
00:07:48,360 --> 00:07:51,530
.قد تصبحان ثنائيًّا جيّدًا بشكل مفاجئ

97
00:07:52,450 --> 00:07:57,450
!أ-أنا وتلك الفتاة؟
!هذا ضرب من المستحيل

98
00:08:00,330 --> 00:08:01,910
!انتظري رجاءً

99
00:08:01,910 --> 00:08:04,290
!سأكون بخير وحدي الآن

100
00:08:04,290 --> 00:08:07,040
!لنفترق ونبدأ بالدّوريّات منفصلتين

101
00:08:10,710 --> 00:08:13,720
.انتظرنا كثيرًا للحصول على سيّارة أجرة

102
00:08:13,720 --> 00:08:16,350
.يعجّ المكان بالمشاهدين أينما ذهبنا

103
00:08:16,350 --> 00:08:17,800
.لننتظر الحافلة التّالية فحسب

104
00:08:18,260 --> 00:08:22,390
.لا أستطيع ترك الأمر بأكمله لكونغو-سان
...على الهروب من هنا

105
00:08:23,480 --> 00:08:25,270
.ماذا؟ أتساءل ماذا يحدث

106
00:08:25,560 --> 00:08:29,020
سمعتُ أنّ هنالك تزايدًا
.في حالات ضربات الشّمس

107
00:08:29,480 --> 00:08:31,490
.علينا أن نكون حذرات أيضًا

108
00:08:31,940 --> 00:08:34,450
.إنّ شرب الماء والسّوائل مهمّ

109
00:08:34,950 --> 00:08:35,780
هل تلك...؟

110
00:08:36,200 --> 00:08:37,070
!ساتن-سان

111
00:08:37,070 --> 00:08:39,240
!ميساكا-سان، انتظري

112
00:08:37,740 --> 00:08:40,620
هـ-هذه أنت يا ميساكا-سان؟

113
00:08:41,200 --> 00:08:41,910
ماذا حدث؟

114
00:08:42,500 --> 00:08:43,910
—لماذا أنت في سيّارة إسعـ

115
00:08:49,290 --> 00:08:50,710
!مكانك

116
00:08:57,840 --> 00:09:01,600
حتّى إن ابتعدنا عن البحيرة، ما زال
.بإمكانها التّحكّم بقدر كافٍ من الماء

117
00:09:03,230 --> 00:09:06,230
كلبي الآليّ الّذي امتصّ الماء الّذي
تتحكّم به ذات الشّعر الكستنائيّ

118
00:09:06,230 --> 00:09:08,020
.قد دُمّر من الدّاخل

119
00:09:08,520 --> 00:09:11,230
أعتقد أنّ بمجرّد أن تصبح
،المياه تحت سيطرتها

120
00:09:11,230 --> 00:09:13,530
.بإمكانها التّحكّم بها حتّى دون رؤيتها

121
00:09:13,530 --> 00:09:15,490
.لقد حلّلتُ كلّ جزء من قدرتها

122
00:09:16,150 --> 00:09:19,370
أوّلاً، هنالك حقّ أقصى للوزن والنّطاق الفعّال

123
00:09:19,370 --> 00:09:22,870
لمن لديهم القدرة على التّحكّم بالأشياء
.مثلها، حسب مستوى قدراتهم

124
00:09:23,750 --> 00:09:25,790
،إن أبعدتُها ما يكفي عن البحيرة

125
00:09:25,790 --> 00:09:28,040
.لن يعود بإمكانها تحديد مخزونها من الماء

126
00:09:28,040 --> 00:09:32,170
وحينها، بمجرّد أن أتظاهر بأنّني
...هدف سهل داخل نطاقها الفعّال

127
00:09:38,260 --> 00:09:39,390
.يا للأسف

128
00:09:40,050 --> 00:09:43,310
واضح أنّها تفقد التّحكّم
.بالماء الّتي تشتّت كثيرًا

129
00:09:44,020 --> 00:09:47,350
حدّ آخر من حدود قوى
ذوي قدرات اليد المائيّة

130
00:09:47,350 --> 00:09:50,440
هي كمّيّة الماء الّتي يمكنهم
!التّحكّم به دفعة واحدة

131
00:09:59,240 --> 00:10:02,780
قد تبدو الهجمات الجسديّة
،ضدّ الماء بلا فائدة في البداية

132
00:10:02,780 --> 00:10:06,040
،لكن في كلّ مرّة تصدّ فيها هجومًا
.تقلّ كمّيّة المياه في درعها المائيّ

133
00:10:07,710 --> 00:10:10,040
أعتقد أنّني سأشاهد هذه الفتاة وأستمتع

134
00:10:10,040 --> 00:10:15,760
بما أنّي الوحيد الّذي يعرف كيف يخطّط
!للهجوم مقدّمًا، بينما تستسلم ليأسها

135
00:10:19,220 --> 00:10:22,550
،عندما وصلتُ للحديقة
،كانت كونغو-سان على الأرض

136
00:10:22,550 --> 00:10:27,810
وقد واجهت وانّاي-سان ورفيقتها الشّخص
.المريب الّذي يتحكّم بالكلاب الآليّة

137
00:10:29,390 --> 00:10:30,810
.هذه غلطتي

138
00:10:31,480 --> 00:10:32,310
.كنتُ ساذجة

139
00:10:33,070 --> 00:10:36,280
ظننتُ أنّه امتداد للتّنافس
.المعتاد بين شِلل الأصدقاء

140
00:10:37,190 --> 00:10:40,450
اعتقدتُ أنّها تعبث معي
.فقط لأنّني لا أروق لها

141
00:10:41,490 --> 00:10:46,500
ظننتُ أنّه حتّى هي لن تستطيع إيذاء
.شخص يرتاد نفس المدرسة معها

142
00:10:50,750 --> 00:10:54,840
نحن جاهزون. فلتنتظرن أنت
.وبقيّة أصدقائها هنا رجاءً

143
00:10:54,840 --> 00:10:56,210
.أكيد

144
00:10:56,210 --> 00:10:57,340
ماذا؟

145
00:11:00,970 --> 00:11:03,100
مهلاً يا ميساكا-سان؟

146
00:11:03,100 --> 00:11:05,220
—يبدو أنّ شيئًا ما حدث هنا

147
00:11:05,220 --> 00:11:05,760
.ابتعدا

148
00:11:06,180 --> 00:11:09,430
علينا انتظار بقيّة عضوات
—الشّلّة حتّى يصلن

149
00:11:09,430 --> 00:11:10,480
.ابتعدا

150
00:11:12,020 --> 00:11:16,440
إن لم تكونا جاهزتين على
.قتلي لإيقافي، فابتعدا

151
00:11:28,500 --> 00:11:30,210
...ميساكا-سان

152
00:11:43,590 --> 00:11:45,180
،وفقًا لحساباتي

153
00:11:45,180 --> 00:11:48,430
كان يجدر بالمياه أن تنفذ منك
.مع بقاء كلبين آليّين إلى جانبي

154
00:11:49,020 --> 00:11:52,560
أنا مندهش لتمكّنك من هزيمتهم
.جميعًا، حتّى وإن استنفدت مياهك

155
00:11:52,560 --> 00:11:56,440
لكن لم يعد لديك مياه لحماية
نفسك، فماذا ستفعلين؟

156
00:11:56,940 --> 00:11:59,150
،إنّ جزءًا من دراساتي كتلميذة في توكيواداي

157
00:11:59,150 --> 00:12:01,570
.هو تعلّم تقنيات الدّفاع عن النّفس

158
00:12:02,360 --> 00:12:06,240
إن كنتَ بدون سلاح، فأستطيع
!الإطاحة بك بدون قدراتي أيضًا

159
00:12:07,080 --> 00:12:09,330
.كم أنت شجاعة

160
00:12:09,330 --> 00:12:13,000
.لكنّني أكره وحشيّة القتال بالأيدي

161
00:12:16,630 --> 00:12:20,340
.وبدل ذلك، سأستعمل هذه القوّات الاحتياطيّة

162
00:12:22,380 --> 00:12:26,220
تجهيز حركة ما لاستعمالها في وضع
.كهذا هي استراتيجيّة أساسيّة

163
00:12:29,720 --> 00:12:31,390
،إنّه لا يحاول الهرب منّي

164
00:12:31,390 --> 00:12:33,640
لكنّه يُبقي مسافة معيّنة
.بيني وبينه وهو يركض

165
00:12:34,270 --> 00:12:38,110
إنّه يحاول توفير الوقت عن طريق
.إبقائي بعيدة عن وانّاي-سان

166
00:12:38,690 --> 00:12:39,730
.عليّ أن أسرع

167
00:12:42,190 --> 00:12:43,400
.سيجدي هذا نفعًا

168
00:13:04,590 --> 00:13:06,470
.كان ذلك طريقًا مختصرًا ناجحًا

169
00:13:07,760 --> 00:13:08,390
...هذه

170
00:13:08,760 --> 00:13:11,260
مخلّفات المعركة حيث استعملت
.كونغو-سان قدراتها

171
00:13:11,560 --> 00:13:14,230
.قمتُ بدورة كاملة دون أن أدرك ذلك

172
00:13:19,610 --> 00:13:20,770
أتدري ماذا؟

173
00:13:21,020 --> 00:13:25,650
.أنا قويّة بشكل مفاجئ

174
00:13:25,650 --> 00:13:27,030
هل أنا كذلك فعلاً؟

175
00:13:28,990 --> 00:13:30,990
،إن كانت معك أيّة مياه

176
00:13:30,990 --> 00:13:35,120
فأنا أعتقد أنّ هذا الخطّ سيكون
.حدّ مدى قدراتك

177
00:13:36,370 --> 00:13:39,460
إذا كنتِ شخصًا حادّ الإدراك
،بشكل مبهر مثلي

178
00:13:39,460 --> 00:13:43,590
فليس من الصّعب اكتشاف أنّ مدى
.قدراتك هو 18 مترًا

179
00:13:44,420 --> 00:13:46,010
.ذلك ليس كلّ شيء

180
00:13:46,010 --> 00:13:49,140
أستطيع القول أيضًا أنّ كمّيّة المياه القصوى
،الّتي يمكنك التّحكّم بها هي 300 لتر

181
00:13:49,850 --> 00:13:54,180
وأنّ العدد الأقصى لتيّارات الماء الّتي
.يمكنك التّحكّم به دفعة واحدة هو ثلاثة

182
00:13:55,020 --> 00:13:58,940
ماذا ستفعلين الآن؟
ستقاتلينني بيديك وتسقطين كبطلة؟

183
00:13:58,940 --> 00:14:00,440
أم ستنحنين متوسّلة لحياتك؟

184
00:14:00,860 --> 00:14:06,650
أم ستتضرّعين للرّبّ ليرسل عاصفة
مطريّة هنا والسّماء صافية هكذا؟

185
00:14:07,240 --> 00:14:10,570
لا فائدة. الخيار الوحيد الّذي لديك
هو أن تلعني نفسك

186
00:14:10,570 --> 00:14:14,120
لأنّك حشرت أنفك في مسألة
.لا تهمّك على الإطلاق

187
00:14:14,120 --> 00:14:17,120
.ستلقين نفس المصير كصديقتك

188
00:14:18,210 --> 00:14:18,870
...المطر

189
00:14:20,380 --> 00:14:21,460
هل لاحظت؟

190
00:14:22,250 --> 00:14:26,380
تملك هذه الحديقة شبكة
،تصفية مياه تحت الأرض

191
00:14:26,380 --> 00:14:29,680
،لذلك إن أمطرت بغزارة
.فستتدفّق المياه إلى البحيرة

192
00:14:30,930 --> 00:14:34,560
،إنّ براعتك في تحليل قدرتي كانت ممتازة

193
00:14:35,680 --> 00:14:38,690
لكن كان عليك أن تعير اهتمامًا
!أكبر للأشياء الّتي لا تراها أيضًا

194
00:14:45,070 --> 00:14:47,190
!ما-ماء؟! من أين أتى؟

195
00:14:48,860 --> 00:14:50,820
!أتلك مصفاة مياه؟

196
00:14:51,160 --> 00:14:54,740
لا أصدّق أنّها أخفت تلك المياه هناك
!كلّ هذه المسافة من البحيرة

197
00:14:55,120 --> 00:14:58,620
حدود تحكّمي بتيّارات المياه
.دفعة واحدة هي أربعة

198
00:14:59,870 --> 00:15:03,290
امتلاك حركة جاهزة للاستخدام
...في أيّ وضع

199
00:15:03,290 --> 00:15:06,590
.حتّى أنا ماكرة بما يكفي لمعرفة ذلك

200
00:15:06,800 --> 00:15:09,340
!أصابعي! إنّها لا تفيدني
! أنا أختنق بالماء

201
00:15:09,340 --> 00:15:11,640
!إن استمرّ هذا، فسأختنق حتّى الموت

202
00:15:11,640 --> 00:15:17,180
!يا كلابي الآليّة، امتصّي الماء
!امتصّي كلّ هذه المياه

203
00:15:28,150 --> 00:15:30,530
!كـ-كدت أموت

204
00:15:30,900 --> 00:15:32,780
أهذه هي كلّ كلابك الآليّة إذًا؟

205
00:15:34,240 --> 00:15:36,620
!هذا سيّئ! هذا سيّئ! هذا سيّئ
!هذا سيّئ

206
00:15:36,620 --> 00:15:38,830
!لم تعد لي أيّ كلاب آليّة

207
00:15:38,830 --> 00:15:40,000
!لا خيار آخر

208
00:15:40,000 --> 00:15:43,670
هذا يعني أنّني سأستعمل آخر واحدة من
...هذه حصلتُ عليها من الدّكتور، لكن

209
00:15:44,130 --> 00:15:45,920
هل استسلمت؟

210
00:15:47,460 --> 00:15:50,220
،قلتُ أنّني لا أحبّ القتال بالأيدي

211
00:15:50,220 --> 00:15:53,300
لكنّ ذلك لا يعني أنّني لستُ
.بارعًا في ذلك أيضًا

212
00:15:53,300 --> 00:15:56,680
لقد تدرّبت في فنون الاغتيال
.المتخصّص مذ كنتُ طفلاً

213
00:15:56,680 --> 00:15:58,890
.إنّه وضع عائليّ

214
00:15:58,890 --> 00:16:01,690
،هذه حركات محرّمة استعمالها ممنوع

215
00:16:01,690 --> 00:16:04,690
لكنّني لا أرى أيّ خيار آخر إلاّ استعمالها
.ضدّ شخص قويّ مثلك

216
00:16:05,310 --> 00:16:07,770
،سأواصل خداعها حتّى أستدرج انتباهها

217
00:16:07,770 --> 00:16:10,650
ثمّ سأستعمل البعوضة الآليّة
!لحقن الجهاز الدّقيق بداخلها

218
00:16:11,700 --> 00:16:14,450
!...أنا وشيك... أنا وشيك

219
00:16:14,780 --> 00:16:15,820
!سقطت؟

220
00:16:15,820 --> 00:16:19,490
!نفدت بطّاريّتها؟ مستحيل
!قمتُ بتفعيلها للتّوّ

221
00:16:19,490 --> 00:16:21,620
...لا، مهلاً، إنّ طريقة تحرّكها

222
00:16:21,620 --> 00:16:23,420
.يبدو أنّك بخير

223
00:16:23,870 --> 00:16:25,170
!أواتسوكي-سان

224
00:16:25,460 --> 00:16:28,090
،إنّ العلبة الّتي ذهبتُ خلفها كانت فارغة

225
00:16:28,090 --> 00:16:30,210
،وفكّرتُ أنّه إن تغلّبتِ عليه

226
00:16:30,210 --> 00:16:33,130
،فسيستعمل الجهاز الدّقيق عليك

227
00:16:33,130 --> 00:16:35,680
.لذلك قلّلت قوّة الطّفو حولك إلى الصّفر

228
00:16:36,340 --> 00:16:37,800
.يبدو أنّ ذلك كان القرار الأصحّ

229
00:16:37,800 --> 00:16:41,980
الطّفو؟ قدرة ذات الضّفيرة
ليست التّحريك الذّهنيّ؟

230
00:16:41,980 --> 00:16:43,270
!بل التّلاعب بقوّة الطّفو؟

231
00:16:44,640 --> 00:16:46,650
!مـ-مهلاً لحظة

232
00:16:46,650 --> 00:16:49,860
هل تنويان أذيّة رجل أعزل
!وأنتما من مستعملي القدرات؟

233
00:16:49,860 --> 00:16:51,990
!تـ-تمّ تكليفي بهذه المهمّة فحسب

234
00:16:51,990 --> 00:16:56,160
البعوضة الآليّة ذات الجهاز
!الدّقيق موجودة هناك

235
00:16:56,160 --> 00:16:58,830
،صحيح أنّني كنتُ قاسيًا قليلاً مع صديقتكما

236
00:16:58,830 --> 00:17:00,240
—لكن هل يمكننا أن نوقف كلّ هذا و

237
00:17:03,870 --> 00:17:06,250
،إن كان عليّ قول شيء ما وإن بدا متغطرسًا

238
00:17:06,790 --> 00:17:10,050
فإنّ سبب ازدرائك لثقة
وعلاقات النّاس بين بعضهم

239
00:17:10,050 --> 00:17:12,380
.هو لأنّك لا تملك أيّ أحد يستحقّ ثقتك

240
00:17:13,090 --> 00:17:16,180
لكنّ ذلك فقط نتيجةٌ لنظرتك
المتعالية للآخرين

241
00:17:16,180 --> 00:17:17,840
.وعدم تقبّل تقرّب أيّ أحد منك

242
00:17:19,760 --> 00:17:21,640
ما دمتَ لن تعترف بالأشخاص من حولك

243
00:17:21,640 --> 00:17:24,020
،وتظهر أنّك عازم على لقائهم في منتصف الطريق

244
00:17:24,390 --> 00:17:26,480
.فلن يساعدك أيّ أحد أبدًا

245
00:17:34,110 --> 00:17:37,360
ها أنا ذي أبدو وكأنّني أعرف ما
.أقوله رغم أنّني لا أملك أيّ تجربة

246
00:17:37,780 --> 00:17:43,240
كلاّ، أعتقد أنّه كلام كان يجب
.أن يُقال، ولصالحه أيضًا

247
00:17:44,200 --> 00:17:47,540
أتمنّى أن يستفيد من هذه الفرصة
.ويعيد التّفكير في أساليبه

248
00:17:53,550 --> 00:17:54,630
!سحقًا لهما

249
00:17:55,590 --> 00:18:01,550
!سحقًا لتلكما الفتاتين
!لقد نظرتا بتعالٍ لي

250
00:18:03,720 --> 00:18:05,520
.الأمر متعلّق بالمعلومات فقط

251
00:18:05,520 --> 00:18:08,810
،إن كنتُ أعرف ما هي قدراتهما من البداية

252
00:18:08,810 --> 00:18:11,310
!كان من المستحيل أن أُهزم على يدهما

253
00:18:12,980 --> 00:18:14,280
!آليّ السّرعوف

254
00:18:14,690 --> 00:18:16,950
كنتُ متردّدًا في استعماله
،بما أنّه يجلب الأنظار

255
00:18:16,950 --> 00:18:21,120
لكنّ قوّتك في مستوى مختلف تمامًا عن
!الكلاب الآليّة الّتي مهمّتها هي البحث

256
00:18:21,870 --> 00:18:26,370
،بما أنّني أعرف تفاصيل قدراتهما الآن
!من المستحيل أن أخسر

257
00:18:26,370 --> 00:18:28,620
!هيّا يا آليّ السّرعوف

258
00:18:33,000 --> 00:18:36,590
إنّ قتلهما فحسب لن يكون كافيًا
!بسبب كلّ تلك المذلّة الّتي أذاقتاها لي

259
00:18:37,010 --> 00:18:39,300
!سأمزّقهما لأشلاء ثمّ سأمسك بهما

260
00:18:39,300 --> 00:18:42,640
!سأجعلهما تتأسّفان لأنّهما ولدتا كفتاتين

261
00:18:42,640 --> 00:18:45,470
وسأعرض مهانتهما على الإنترنيت
،ليشاهدها العالم بأكمله

262
00:18:45,470 --> 00:18:48,020
،ولن أحطّمهما جسديًّا ونفسيًّا فحسب

263
00:18:48,020 --> 00:18:50,480
!سأحطّمهما اجتماعيًّا أيضًا

264
00:18:50,480 --> 00:18:52,940
—"ستتوسّلان لي باكيتين وتقولا "اقتلنا

265
00:18:55,020 --> 00:18:59,780
إشارة تحديد المواقع من البعوضة الآليّة
الّتي وضعتها على كونغو ميتسوكو؟

266
00:18:59,780 --> 00:19:04,280
ما الّذي تفعله هنا؟ إن واصلت
...الاقتراب من هناك، فقريبًا سوف

267
00:19:08,370 --> 00:19:10,250
!لِـ-لماذا؟

268
00:19:12,460 --> 00:19:16,880
!لماذا ميساكا ميكوتو هنا؟

269
00:19:18,590 --> 00:19:19,720
!مستحيل

270
00:19:19,720 --> 00:19:22,720
ما كان عليها أن تستطيع التّحرّك
!بسبب الجهاز الدّقيق الذي حقنتها به

271
00:19:23,390 --> 00:19:26,810
!أجل! إنّها تبدو مثل ميساكا ميكوتو فحسب

272
00:19:26,810 --> 00:19:28,560
!هذه إحدى الأخوات

273
00:19:29,810 --> 00:19:33,610
،يا لحظّي! ما دمتُ سأمسك بها
!فبإمكاني أن أصحّح فشلي

274
00:19:33,610 --> 00:19:36,570
!أستطيع تولّي أمر تلكما الفتاتين لاحقًا

275
00:19:36,570 --> 00:19:40,280
!أيّها السّرعوف الآليّ، أمسك بتلك الفتاة

276
00:19:55,210 --> 00:19:56,130
...إنّها

277
00:19:57,250 --> 00:19:58,340
إنّها هي بالفعل...؟

278
00:20:00,050 --> 00:20:02,050
!تـ-تراجعي

279
00:20:24,820 --> 00:20:26,120
بإمكانك سماعي، صحيح؟

280
00:20:26,120 --> 00:20:28,450
تجنّبتُ نظام التّواصل عندما
.حطّمتُ هذا الشّيء

281
00:20:36,040 --> 00:20:40,880
إ-إنّه لا يُفتح! مستحيل أن تكون
!قد سيطرت على كلّ الأنظمة

282
00:20:42,630 --> 00:20:46,260
سأوافيك بعد قليل لأفعل نفس
.ما فعلتُه لهذا الشّيء لك أيضًا

283
00:20:48,010 --> 00:20:50,180
،ذلك ما أريده على الأقلّ

284
00:20:50,180 --> 00:20:52,890
لكن إذا أخذتُ في الاعتبار أنّك قد
،تكون تحت سيطرة تلك الفتاة

285
00:20:53,690 --> 00:20:56,900
.فسأدعك تذهب هذه المرّة
...ولكن

286
00:20:57,940 --> 00:21:01,070
إن رأيتُ إحدى هذه الأشياء
،من الآن فصاعدًا

287
00:21:01,070 --> 00:21:03,240
،أو اقترب أيّ منها من أصدقائي

288
00:21:04,150 --> 00:21:06,740
،ولو كان ذلك للحظة وجيزة

289
00:21:07,530 --> 00:21:11,790
،فلا يهمّ أين قد تكون
...أقسم أنّني سأجدك

290
00:21:13,620 --> 00:21:15,000
.وسأسحقك

291
00:21:20,090 --> 00:21:21,460
...كلاّ

292
00:21:21,880 --> 00:21:22,880
ما الخطب؟

293
00:21:22,880 --> 00:21:26,220
.يا إلهي. بابا-تشان خارج الصّورة

294
00:21:26,510 --> 00:21:27,640
خارج الصّورة؟

295
00:21:27,640 --> 00:21:29,720
.كلّ بيادقه الآليّة قد دُمّرت

296
00:21:29,720 --> 00:21:31,930
.قال أنّه يبحث عن ملجأ للاختباء فيه

297
00:21:31,930 --> 00:21:36,890
هذا مبهم. قال أنّه فشل
.في الإمساك بميساكا ميكوتو

298
00:21:37,440 --> 00:21:40,150
.أعتقد أنّ هذا يعني أنّ عليّ التّدخّل بنفسي

299
00:21:40,150 --> 00:21:41,020
.إنّها خصم مرعب

300
00:21:41,480 --> 00:21:43,400
ماذا قلت؟ أتعرفينها؟

301
00:21:44,280 --> 00:21:47,450
التقيتها من قبل، وتمكّنت
.من رؤية قتالها عن قرب

302
00:21:47,450 --> 00:21:50,490
حسنًا، الأمر ليس وكأنّ عليّ
.أن أوسعها ضربًا حتّى الموت

303
00:21:51,700 --> 00:21:54,620
بإمكاننا تدبّر الأمر ما دام هذا
.سينتهي مع نهاية اليوم

304
00:23:24,920 --> 00:23:39,930
في
الحلقة
القادمة

305
00:23:25,840 --> 00:23:29,380
مفتاح حلّ هذا اللّغز هو
."أوريبوس أوكولي فيدليوريس سونت"

306
00:23:29,380 --> 00:23:37,270
".أوريبوس أوكولي فيدليوريس سونت"

307
00:23:33,640 --> 00:23:35,140
!حسنًا، لنقلها جميعًا الآن

308
00:23:35,140 --> 00:23:37,680
".أوريبوس أوكولي فيدليوريس كونتو"

309
00:23:37,680 --> 00:23:39,930
هل قالت إحدانا شيئًا مختلفًا؟