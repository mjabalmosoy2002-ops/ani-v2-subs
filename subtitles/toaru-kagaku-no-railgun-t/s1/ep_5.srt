1
00:00:01,930 --> 00:00:04,190
،كـ-كوروكو

2
00:00:04,190 --> 00:00:07,690
أنتنّ لا تحاولن خداعي، صحيح؟

3
00:00:07,690 --> 00:00:08,980
عمّ تتحدّثين؟

4
00:00:09,650 --> 00:00:12,450
...أويهارو-سان... ساتن-سان

5
00:00:12,450 --> 00:00:14,450
كيف تعرف اسمينا؟

6
00:00:15,030 --> 00:00:17,240
هل أخبرتها عنّا يا شيراي-سان؟

7
00:00:17,240 --> 00:00:20,080
.كلاّ. لسنا مقرّبتين من بعض حتّى

8
00:00:20,700 --> 00:00:25,000
،لا أعرف من أين سمعتِ عنّا

9
00:00:25,000 --> 00:00:27,380
،لكن إن كنتِ في مشكلة ما
،فبإمكاني الاستماع لك

10
00:00:28,130 --> 00:00:29,840
."فأنا من لجنة "الحُكم

11
00:00:30,500 --> 00:00:31,340
...لا

12
00:00:32,340 --> 00:00:33,010
.لا بأس

13
00:00:36,430 --> 00:00:37,800
...تماديتِ كثيرًا الآن

14
00:00:38,850 --> 00:00:40,010
!يا شوكوهو

15
00:00:40,640 --> 00:00:45,730
ها أنت تعبثين مع صديقاتي
...أيضًا. إنّ هذا

16
00:00:46,940 --> 00:00:49,440
!قد تخطّى الحدود ولم يعد مجرّد مزاح

17
00:00:52,280 --> 00:00:56,160
إن أريتُ لكوروكو والأخريات غرفتنا
،في المسكن أو بعض الصّور

18
00:00:56,160 --> 00:00:59,660
فسأكون قادرة على شرح
.أنّ ذكرياتهنّ قد مُحيت

19
00:01:00,830 --> 00:01:01,290
...لكن

20
00:01:02,410 --> 00:01:08,000
هل سيتعاونّ معي بما
أنّهنّ يرينني كغريبة عنهنّ؟

21
00:01:10,340 --> 00:01:12,800
.لا أريد إقحامهنّ في الأمر هكذا

22
00:01:14,550 --> 00:01:15,550
ميساكا-سان؟

23
00:01:16,550 --> 00:01:19,390
.علينا أن نستعدّ للمنافسة التّالية

24
00:01:20,100 --> 00:01:22,390
ما هدفها إن كانت
قد تمادت لهذا الحدّ؟

25
00:01:23,140 --> 00:01:24,640
،بما أنّها قد حدّت من حركاتي الآن

26
00:01:25,520 --> 00:01:27,390
ما الّذي أستطيع فعله؟

27
00:02:59,240 --> 00:03:01,530
.أنت في أفضل حال يا كونغو-سان

28
00:03:01,820 --> 00:03:05,490
.نعم. حتّى المعلّق قد أثنى عليك

29
00:03:06,830 --> 00:03:10,080
.يبدو أنّ المعلّق لديه نظر ثاقب

30
00:03:10,080 --> 00:03:12,000
ما كان الغرض من ذلك؟

31
00:03:12,210 --> 00:03:14,960
.أردتُ الحديث معها لوقت أطول

32
00:03:15,420 --> 00:03:19,170
كنتِ مفتونة بلقائك لشخص
.مشهور فحسب

33
00:03:19,170 --> 00:03:23,300
ومع ذلك، بدت لي
.وكأنّها أرادت قول شيء ما

34
00:03:23,300 --> 00:03:25,970
شيراي-سان؟ ساتن-سان
...وأويهارو-سان معك أيضًا

35
00:03:26,430 --> 00:03:29,140
.إنّها كونغو-سان، مرحبًا

36
00:03:29,140 --> 00:03:31,810
شيراي-سان، كيف تشعرين؟

37
00:03:31,810 --> 00:03:34,310
بصفتي من أخذت
،مكانك في المنافسات

38
00:03:34,310 --> 00:03:36,770
.حرصت كلّ الحرص أن أكون الأولى

39
00:03:39,900 --> 00:03:42,240
ماذا؟ لماذا هذا التّجهّم؟

40
00:03:42,240 --> 00:03:45,570
هنالك فتاة يدعونها "المسدّس
الكهرومغناطيسي" في مدرستنا، صحيح؟

41
00:03:46,080 --> 00:03:50,330
.جاءت وتحدّثت معنا فجأة قبل لحظات

42
00:03:50,330 --> 00:03:54,420
أتت إلينا نحن وسألت
إن كنّا نحاول خداعها؟

43
00:03:55,460 --> 00:03:59,630
نعم، هلاّ واصلتِ أخذ مكاني
في المنافسات؟

44
00:03:59,630 --> 00:04:01,220
...أ-أكيد

45
00:04:01,220 --> 00:04:02,170
!أويهارو

46
00:04:02,170 --> 00:04:03,380
.مع السّلامة

47
00:04:03,380 --> 00:04:04,590
...نعم

48
00:04:04,590 --> 00:04:05,890
.رافقتكنّ السّلامة

49
00:04:07,850 --> 00:04:12,560
هل شيراي-سان وميساكا-ساما
قد تشاجرتا أو ما شابه؟

50
00:04:13,270 --> 00:04:15,900
.إنّهما على وفاق تامّ معًا دائمًا

51
00:04:18,940 --> 00:04:23,150
شيراي-سان، لقد تقدّمتِ للمشاركة
.في الكثير من المنافسات

52
00:04:23,150 --> 00:04:27,410
.ماذا؟ نعم، أنت على حقّ
.وهي منافسات ثنائيّة أيضًا

53
00:04:27,410 --> 00:04:29,330
ماذا؟ ثنائيّة؟

54
00:04:29,910 --> 00:04:33,370
!منافستنا الثّنائيّة التّالية هي شطيرة البالونات

55
00:04:33,370 --> 00:04:36,130
على كلّ ثنائيّ حمل بالون بينهما
،دون استعمال أيديهم

56
00:04:36,130 --> 00:04:38,840
!والتّسابق نحو خطّ النّهاية حاملين إيّاه

57
00:04:38,840 --> 00:04:42,550
!سيُستبعد الثنّائيّ بمجرّد أن ينفجر البالون

58
00:04:40,960 --> 00:04:43,670
.هذا ليس الوقت المناسب للقيام بهذا

59
00:04:43,670 --> 00:04:46,590
عليّ التّملّص من هذا بأيّ
.طريقة والذّهاب للبحث عنها

60
00:04:46,590 --> 00:04:47,470
ميساكا-سان؟

61
00:04:49,100 --> 00:04:52,430
لا تمانعين إن نفختُ بالوننا، صحيح؟

62
00:04:52,430 --> 00:04:53,850
.نعم، لا أمانع

63
00:04:56,150 --> 00:04:58,020
!هيّا يا أختي

64
00:04:58,400 --> 00:05:01,400
!احضنيني رجاءً

65
00:05:01,400 --> 00:05:04,900
!مهلاً، سنُستبعد إن انفجر البالون

66
00:05:05,240 --> 00:05:08,870
،لا تستطيع كوروكو كبح نفسها
.ولم نتدرّب على الإطلاق

67
00:05:09,660 --> 00:05:12,330
هل يمكنك ألاّ تناديني
باسمي بأريحيّة هكذا؟

68
00:05:15,910 --> 00:05:19,630
،بالمناسبة يا ميساكا-سان
.لم أكن أعلم أنّ لديك أختًا توأم

69
00:05:20,670 --> 00:05:22,710
،البارحة خلال منافسة صائد البالونات

70
00:05:22,710 --> 00:05:25,130
كانت أختك من شاركت، صحيح؟

71
00:05:25,670 --> 00:05:29,470
كونغو-سان، استطعتِ التّمييز
أنّها ليست أنا؟

72
00:05:29,470 --> 00:05:33,470
ماذا؟ لديّ نظر ثاقب عندما
.يتعلّق الأمر بتقييم النّاس

73
00:05:33,470 --> 00:05:37,100
.دعينا نقول أنّ هنالك فرقًا بسيطًا حيالها

74
00:05:38,810 --> 00:05:42,440
،اسمعي يا كونغو-سان
.أحتاج لأن تسديني خدمة

75
00:05:43,440 --> 00:05:46,240
توكيواداي مذهلات، صحيح؟

76
00:05:43,440 --> 00:05:46,240
.إنّهن من الأصابع الخمسة

77
00:05:46,240 --> 00:05:47,400
.تهانينا

78
00:05:47,700 --> 00:05:48,910
.نعم، شكرًا

79
00:05:49,410 --> 00:05:50,870
...لقد

80
00:05:51,200 --> 00:05:54,620
لقد أخذت مفهوم القسوة الماكرة إلى
.مستوى جديد تمامًا يا شوكوهو ميساكي

81
00:05:54,910 --> 00:05:57,290
!كونغو-سان، اهدئي، اهدئي

82
00:05:58,620 --> 00:06:00,790
،اختطفت أختك

83
00:06:00,790 --> 00:06:04,250
ناهيك عن ذكر تلاعبها بذكريات
شيراي-سان والأخريات؟

84
00:06:04,250 --> 00:06:07,050
إنّها غير مناسبة لتكون
.تلميذة في توكيواداي

85
00:06:09,130 --> 00:06:10,930
.أفهم ما تخبرينني به

86
00:06:11,350 --> 00:06:14,310
،سأبحث في أمر ما حدث لأختك

87
00:06:14,890 --> 00:06:18,560
لذلك احرصي على إبعاد اهتمام
.شلّة شوكوهو عنّي يا ميساكا-سان

88
00:06:18,560 --> 00:06:21,860
.أنا آسفة لإقحامك في أموري الشّخصيّة

89
00:06:22,520 --> 00:06:25,230
،لكن مهما كان ما ستفعلينه
.فلا تورّطي نفسك كثيرًا

90
00:06:25,230 --> 00:06:29,200
إنّ المخيف بشأنها
.هو جهلنا لما تفكّر به

91
00:06:29,200 --> 00:06:32,490
لو كان لديّ دليل ما، لأمكنني
.فعل شيء حيال الأمر بنفسي

92
00:06:35,160 --> 00:06:35,540
...لا

93
00:06:36,910 --> 00:06:41,290
ليس عليك أن تثقي بأيّ معلومة
.أخبرك إيّاها يا ميساكا-سان

94
00:06:41,290 --> 00:06:42,500
ماذا؟ لماذا؟

95
00:06:44,170 --> 00:06:48,970
لأنّه قد أكون تحت سيطرة
.شوكوهو ميساكي سلفًا

96
00:06:49,970 --> 00:06:53,550
،وأنّ أيّ وكلّ معلومة قد أقولها لك
.يمكن أن تكون زائفة

97
00:06:54,220 --> 00:06:57,140
.عليك التّفكير في ذلك الاحتمال أيضًا

98
00:06:57,430 --> 00:06:58,930
...مستحيل

99
00:06:58,930 --> 00:07:03,230
نعم. ما كان أيّ أحد ليثق بي
بعد أن قلتُ شيئًا كهذا، صحيح؟

100
00:07:03,860 --> 00:07:08,740
،لذلك لن أحضر لك أيّة معلومات
.بل سأحضر لك أختك بحدّ ذاتها

101
00:07:09,490 --> 00:07:12,320
أكره القيام بهذا بعد
،أن أخبرتك ألاّ تثقي بي

102
00:07:12,700 --> 00:07:15,450
.لكن ثقي بي وانتظري عودتي

103
00:07:16,030 --> 00:07:17,330
...كونغو-سان

104
00:07:17,910 --> 00:07:19,410
.طريقة ممتازة للفوز بالمركز الأوّل

105
00:07:19,870 --> 00:07:21,330
.مذهلة كعادتك

106
00:07:21,330 --> 00:07:22,880
.شـ-شكرًا لك

107
00:07:26,880 --> 00:07:30,970
إنّ سبب عدم جعلها لشيراي-سان
والأخريات يعادين ميساكا-سان

108
00:07:30,970 --> 00:07:33,340
ربّما هو ظنّها أنّه ليس من
.الضّروريّ التّمادي لذلك الحدّ

109
00:07:34,470 --> 00:07:36,310
،إن كان هدفها هو الأخت

110
00:07:36,310 --> 00:07:39,060
إذًا فالهدف من كلّ هذا كان
.المماطلة في الوقت

111
00:07:39,770 --> 00:07:44,020
وفي أفضل الأحوال، كلّ ما احتاجته
.هو حلّ مؤقّت لا غير

112
00:07:44,020 --> 00:07:46,110
.أظنّ أنّ عليّ الإسراع

113
00:08:04,790 --> 00:08:07,000
.لا تفعلي أيّ شيء جنونيّ يا كونغو-سان

114
00:08:07,540 --> 00:08:11,550
،إن عرّضتِ نفسك للخطر
...حتّى وإن كان لمساعدتها

115
00:08:11,550 --> 00:08:12,380
ميساكا-سان؟

116
00:08:14,010 --> 00:08:15,220
...إنّ هاتفك

117
00:08:15,470 --> 00:08:17,430
كلاّ، هل تشكّ في أمري؟

118
00:08:17,970 --> 00:08:20,810
هو طراز غيكوتا القفاز الجميل، صحيح؟

119
00:08:20,810 --> 00:08:23,020
.ماذا؟ نعم، صحيح

120
00:08:24,140 --> 00:08:25,940
.لديّ واحد مثله أيضًا في الحقيقة

121
00:08:25,940 --> 00:08:26,650
!بيونكو؟

122
00:08:27,360 --> 00:08:32,240
رأيت طوق غيكوتا على حقيبة ظهرك
.وتساءلت إن كنت تحبّينها

123
00:08:33,200 --> 00:08:34,360
...لهذا السّبب

124
00:08:34,360 --> 00:08:39,490
ميساكا-سان، أردتُ دائمًا
.أن أتحدّث معك مطوّلاً

125
00:08:39,490 --> 00:08:44,120
أنا أتمنّى فعلاً لو لم يُروّج
.لها على أنّها للأطفال

126
00:08:44,120 --> 00:08:47,250
تنظر لي الأمّهات اللّواتي تكنّ مع
.أطفالهنّ بنظرات غريبة دائمًا

127
00:08:47,250 --> 00:08:48,710
.نعم، أعرف ما تعنينه

128
00:08:48,710 --> 00:08:53,300
قواعد المسكن تمنعني من الذّهاب باكرًا
.للوقوف في الصّف عند صدور نسخ جديدة

129
00:08:53,300 --> 00:08:57,260
بالحديث عن ذلك، هل تعرفين
السّلسلة الجهويّة الّتي صدرت حديثًا؟

130
00:08:57,260 --> 00:08:59,930
ألا تعتقدين أنّهم يقلّلون
من احترامنا نحن محبّو غيكوتا؟

131
00:08:59,930 --> 00:09:02,520
!إنّهم لا يحترمون القصّة الأصليّة بما يكفي

132
00:09:02,520 --> 00:09:05,140
.إنّهما منغمستان في الأمر بالكامل

133
00:09:02,520 --> 00:09:06,350
أتمنّى أن يتعلّموا من مهرجان إم للنّسخ
.المحدودة المطلوبة بالبريد لهذه السّنة

134
00:09:06,350 --> 00:09:09,610
.نعم، ما زلت لم أحصل على واحدة بعد

135
00:09:09,610 --> 00:09:11,980
إنّها غير متوفّرة في المزادات
.على الإنترنت أيضًا

136
00:09:11,980 --> 00:09:17,740
،في تلك الحالة، لديّ اثنتان منها
.واحدة لأستمتع بها، وأخرى لأحتفظ بها

137
00:09:17,740 --> 00:09:18,570
!لديك اثنتان؟

138
00:09:18,910 --> 00:09:23,000
اسمعي. إن أبليتِ حسنًا
،في منافسات اليوم

139
00:09:23,000 --> 00:09:25,000
.سأعطيك التّي أحتفظ بها

140
00:09:25,000 --> 00:09:26,210
—ماذا؟ فعلاً

141
00:09:28,000 --> 00:09:30,790
!يا له من فخّ راقٍ

142
00:09:33,710 --> 00:09:38,300
سبق وأخبرتك، تمّ الاهتمام بأمر
.ميساكا ميكوتو بكلّ تأكيد

143
00:09:38,890 --> 00:09:42,680
حقنتها بأجهزتي الدّقيقة، لذا من
.المستحيل أن تتمكّن من الحركة

144
00:09:43,180 --> 00:09:45,680
إضافة إلى أنّ تأمينها
هو عملك أنت، صحيح؟

145
00:09:46,230 --> 00:09:49,560
هل من المؤكّد أنّها لم تُؤخذ
إلى مشفى في مكان ما؟

146
00:09:50,060 --> 00:09:52,360
.حسنًا، أعتقد أنّ ذلك جيّد حاليًّا

147
00:09:53,070 --> 00:09:56,400
.بابا-تشان، لديّ مهمّة أخرى من أجلك

148
00:09:56,400 --> 00:09:57,490
مهمّة أخرى؟

149
00:09:58,110 --> 00:09:59,490
...هدفك

150
00:09:59,490 --> 00:10:01,450
...هي نسخ ميساكا ميكوتو

151
00:10:02,370 --> 00:10:03,540
.الأخوات

152
00:10:06,040 --> 00:10:08,120
،حسب كلام ميساكا-سان

153
00:10:08,120 --> 00:10:11,250
هذا هو المكان الّتي رأت
.فيه أختها آخر مرّة

154
00:10:11,790 --> 00:10:16,340
ممّا يعني، من المرجّح أيضًا أنّ تكون
.قد التقت شوكوهو ميساكي هنا

155
00:10:17,260 --> 00:10:19,380
.هنالك أمر ليس في مكانه هنا

156
00:10:19,840 --> 00:10:25,390
هل أخت ميساكا-سان ليست في مستوى
مرتفع بما يكفي لتفادي التّحكّم الذّهنيّ؟

157
00:10:25,970 --> 00:10:31,270
بإمكانها استعمال قدرتها ببساطة لتأمرها
.بالذّهاب لمكان لن يراها فيه أحد

158
00:10:31,270 --> 00:10:34,820
لماذا قد تقوم بكلّ هذا للإمساك
بها وتغيير مكانه؟

159
00:10:36,030 --> 00:10:39,910
ماذا إن كانت قدرتها ليست
،ما استُعمل للإمساك بها

160
00:10:39,910 --> 00:10:43,240
بل ظروف أخرى غير متوقّعة
لشوكوهو ميساكي أيضًا؟

161
00:10:45,740 --> 00:10:46,830
،إن كان ذلك صحيحًا

162
00:10:47,370 --> 00:10:49,210
.فقد يكون هنالك دليل ما هنا

163
00:10:51,420 --> 00:10:52,580
...أهذه هي

164
00:10:53,250 --> 00:10:57,170
الشّخصيّة التي تحبّها ميساكا-سان
كثيرًا... هل اسمها كيروزو؟

165
00:10:59,340 --> 00:11:00,470
أليس هذا...؟

166
00:11:02,390 --> 00:11:04,140
!ا-ابتعد

167
00:11:04,140 --> 00:11:06,680
لا يجب أن تتعدّى على
!من هم أضعف منك

168
00:11:08,680 --> 00:11:10,440
.أنت بخير الآن

169
00:11:13,940 --> 00:11:17,650
أعلم أنّك قد تكون لا تزال
...خائفًا، لكنّي الآن

170
00:11:17,650 --> 00:11:20,280
.لا أملك الوقت الكافي لذلك

171
00:11:25,580 --> 00:11:28,620
.ليس لديّ وقت لهذا بالفعل

172
00:11:28,620 --> 00:11:30,580
."سآخذك لأحد ما في لجنة "الحكم

173
00:11:31,120 --> 00:11:33,210
!مهلاً يا كونغو-سان

174
00:11:33,210 --> 00:11:34,750
—تبدين على عجلة. ما الّذي حدث

175
00:11:37,670 --> 00:11:39,340
—لكن هل تستطيعين أن

176
00:11:38,670 --> 00:11:39,340
ماذا؟

177
00:11:40,090 --> 00:11:43,010
هل هذا هو قطّ ميساكا-ساما؟

178
00:11:43,930 --> 00:11:45,300
فعلاً؟

179
00:11:45,300 --> 00:11:48,180
،لستُ واثقة تمامًا أيضًا

180
00:11:49,020 --> 00:11:53,230
لكنّه يبدو مثل القطّ الّتي اهتممتُ
.به خلال منافسة صائد البالونات

181
00:11:53,690 --> 00:11:58,230
صائد البالونات؟ إنّها المنافسة الّتي
...شاركت فيها أخت ميساكا-سان

182
00:11:58,610 --> 00:12:01,650
أخت ميساكا-ساما؟

183
00:12:01,650 --> 00:12:06,620
عفوًا، ليس لديّ الوقت
،لأتطرّق للتّفاصيل الآن

184
00:12:06,620 --> 00:12:12,120
لكنّ ميساكا-سان طلبت منّي أن أساعدها
.في البحث عن أختها الضّائعة

185
00:12:12,120 --> 00:12:13,210
ضائعة؟

186
00:12:13,870 --> 00:12:18,920
كان هذا القطّ حيث أعتقد
.أنّ أختها واجهت مشكلة ما

187
00:12:18,920 --> 00:12:22,550
،حسنًا، لا أعرف كلّ الظّروف

188
00:12:22,550 --> 00:12:26,760
لكنّني أعرف متخاطرة ذهنيّة في فريق
.السّباحة يمكنها التّواصل مع الحيوانات

189
00:12:26,760 --> 00:12:30,560
حسب معرفتي لها، أظنّها تستطيع
.التّواصل مع هذا القطّ

190
00:12:31,730 --> 00:12:32,980
!مذهل

191
00:12:35,940 --> 00:12:38,610
!انظري يا أمّي! إنّه كلب آليّ

192
00:12:38,610 --> 00:12:39,650
.أنت على حقّ

193
00:12:40,110 --> 00:12:42,030
.هذه هي المدينة الأكاديميّة

194
00:12:40,940 --> 00:12:43,320
.أكاديميّة ناغاتنجوكي أفلتت بهذا

195
00:12:42,440 --> 00:12:44,910
!مذهل، انظروا لكلّ هؤلاء النّاس

196
00:12:43,320 --> 00:12:45,990
من سيأكل ياكيسوبا الفراولة هذه؟

197
00:12:44,950 --> 00:12:46,620
هل سيقومون بالموكب اللّيليّ اللّيلة أيضًا؟

198
00:12:46,320 --> 00:12:49,330
!تلك الفتاة بالملابس الورديّة ظريفة

199
00:12:47,120 --> 00:12:51,290
قد يعطينا ذلك دليلاً ما عن كيفية
!العثور على أخت ميساكا-سان

200
00:12:52,200 --> 00:12:56,210
تلميذة من توكيواداي... أخت... ميساكا؟

201
00:12:56,920 --> 00:13:01,210
.سأذهب للاتّصال بها
.انتظري هنا لحظة رجاءً

202
00:13:01,800 --> 00:13:03,300
.حسنًا إذًا

203
00:13:05,680 --> 00:13:08,350
.لا أصدّق أنّ هذا القطّ هو الدّليل

204
00:13:08,890 --> 00:13:12,390
فتاة تملك قدرة تخاطر ذهنيّ
،بعيدة كلّ البعد عن ميساكا-سان

205
00:13:12,390 --> 00:13:15,230
وما كانت يد شوكوهو ميساكي
.لتطالها أبدًا

206
00:13:15,770 --> 00:13:19,360
!أحضرتُ أختك لك كما وعدتك

207
00:13:19,360 --> 00:13:22,280
!شكرًا لك يا كونغو-سان! أحسنت عملاً

208
00:13:22,280 --> 00:13:24,570
!أجل! أجل

209
00:13:23,610 --> 00:13:24,570
...المعذرة

210
00:13:25,450 --> 00:13:26,200
نعم؟

211
00:13:26,200 --> 00:13:27,700
بماذا ساعدك؟

212
00:13:27,700 --> 00:13:30,160
.كنتُ آمل أن أتحدّث معك

213
00:13:30,160 --> 00:13:32,240
في الحقيقة، ليس لديّ الكثير
—من الوقت حاليًّا

214
00:13:32,240 --> 00:13:35,540
.إنّه يتعلّق بأخت ميساكا ميكوتو

215
00:13:37,920 --> 00:13:39,710
.هنالك أشخاص كثر حولنا

216
00:13:40,090 --> 00:13:41,670
لماذا لا نذهب لمكان آخر؟

217
00:13:44,710 --> 00:13:50,470
.نسخة محدودة لمهرجان دايهاسي
،أنا واثقة أنّه تمّ شراؤها سلفًا

218
00:13:50,470 --> 00:13:52,600
،لكن من الأفضل أن أسأل
.من باب الحيطة

219
00:13:54,060 --> 00:13:55,060
أسأل لمن...؟

220
00:13:59,860 --> 00:14:02,020
...كونغو-سان؟ ومعها

221
00:14:02,820 --> 00:14:03,820
من يكون؟

222
00:14:06,570 --> 00:14:11,580
عندما قلتِ "أخت"، فهل لذلك
علاقة بلقب "الأخوات"؟

223
00:14:12,370 --> 00:14:16,290
أم أنّك تعرّفتِ إليها على أنّها أختها الحقيقيّة؟

224
00:14:17,160 --> 00:14:19,250
.حسنًا، أعتقد أنّ الأمر لا يهمّ

225
00:14:19,250 --> 00:14:24,630
لمعلوماتك، طُلب منّي
.حماية هذه "الأخت" أيضًا

226
00:14:26,340 --> 00:14:30,260
إن لم تمانعي، هلاّ قارنّا
ملاحظاتنا عمّا يعرفه كلّ منّا؟

227
00:14:30,970 --> 00:14:32,800
،رغم أنّني أقدّر عرضك هذا

228
00:14:32,800 --> 00:14:39,390
إلاّ أنّني أخشى أنّ عليك أن تشرح
،لي من تكون في البداية

229
00:14:39,390 --> 00:14:41,940
.وما سبب بحثك عن أختها

230
00:14:43,060 --> 00:14:46,570
...نعم، أفترض أنّ ذلك منطقيّ. ولكن

231
00:14:46,820 --> 00:14:51,450
من الأفضل أن تخبريني
.ما هو "دليلك" دون طرح أسئلة

232
00:14:51,820 --> 00:14:52,950
...لأنّه إن لم تخبريني

233
00:14:55,990 --> 00:14:56,950
!آليّ؟

234
00:14:58,120 --> 00:15:01,630
سينتهي بي الأمر مستعملاً
.عقاقير لإجبارك على ذلك

235
00:15:02,040 --> 00:15:03,750
!لا تقترب منّي رجاءً

236
00:15:04,710 --> 00:15:06,760
،اتّضحت شكوكي من البداية

237
00:15:07,510 --> 00:15:10,300
،لذلك توقّعتُ أنّه يعمل مع شوكوهو ميساكي

238
00:15:10,930 --> 00:15:14,430
،لكن إن كان يبحث عن أختها بالفعل
فهل لديه دافع مختلف؟

239
00:15:15,060 --> 00:15:18,020
رافقتُ معتقدة أنّني قد أحصل
،على معلومات منه

240
00:15:18,850 --> 00:15:21,980
،لكن في كلّ الأحوال
...هذا لا يغيّر حقيقة

241
00:15:23,360 --> 00:15:25,070
.أنّه عدوّ لميساكا-سان

242
00:15:28,320 --> 00:15:29,690
!انظري! انظري

243
00:15:29,690 --> 00:15:32,610
.عليّ العثور على طريقة للهرب من هنا

244
00:15:29,690 --> 00:15:33,740
حسنًا، بينما ننتظر أن تبدأ المنافسة
—التّالية، علينا أن

245
00:15:35,200 --> 00:15:36,790
!بالوني

246
00:15:37,160 --> 00:15:38,200
!هذه هي

247
00:15:47,300 --> 00:15:49,050
!شكرًا لك يا آنستي

248
00:15:47,300 --> 00:15:49,760
!ميساكا-سان، انتبهي

249
00:15:51,720 --> 00:15:55,300
.كلاّ. قفزت فوق القطار بالخطأ

250
00:15:55,300 --> 00:15:57,430
.لا أستطيع النّزول الآن

251
00:15:57,430 --> 00:16:00,980
نجحت، كانت تلك مجرّد حادثة
مؤسفة، لذلك ليست غلطتي، صحيح؟

252
00:16:00,980 --> 00:16:04,190
ميساكا-سان... عليك انتظارنا
...في المحطّة التّالية

253
00:16:04,690 --> 00:16:07,940
أنا خارج مداها التّخاطريّ
...الفعليّ. والآن

254
00:16:08,610 --> 00:16:11,110
هل تأذّيتِ يا ميساكا-سان؟

255
00:16:11,110 --> 00:16:15,410
.نعم، لقد لحقنا بها. إنّها في أمان
.سننزل في المحطّة التّالية

256
00:16:15,410 --> 00:16:19,080
،وإن لم نلحق بالقطار العائد
.فسنستقلّ سيّارة أجرة

257
00:16:15,820 --> 00:16:20,950
بإمكانكما اللّحاق بقطار يسير
بعيدًا عنكما بسهولة إذًا؟

258
00:16:19,080 --> 00:16:20,250
.نعم، سنفعل

259
00:16:20,950 --> 00:16:23,290
...آسفة بشأن هذا

260
00:16:28,960 --> 00:16:34,180
لن تهربي. بحث في أمر قدرتك
.بعد سباقك

261
00:16:34,180 --> 00:16:38,220
تتضمّن قدرتك إنشاء نفّاثات هوائيّة
.على الأشياء وإطلاقها

262
00:16:38,890 --> 00:16:42,850
ولكن، لا يوجد هنا أيّ شيء
.لتستعملي قدرتك عليه

263
00:16:42,850 --> 00:16:45,560
.لهذا السّبب أحضرتك إلى هنا

264
00:16:46,190 --> 00:16:50,400
،لو أنّك استسلمت وتحدّثتِ معي
.ما كان عليك أن تتأذّي

265
00:16:50,900 --> 00:16:52,150
!...وإن لم تفعلي

266
00:16:54,110 --> 00:16:56,490
!ما-ماذا؟

267
00:16:59,120 --> 00:17:05,370
اقترفتَ خطأين بشأن قدرة
!اليد الهوائيّة خاصّتي

268
00:17:05,370 --> 00:17:10,000
أوّلاً، لا توجد أيّة قيود بشأن ما
.يمكنني وضع نفّاثاتي عليه

269
00:17:10,920 --> 00:17:12,710
أنشأت نفّاثات على الأرض؟

270
00:17:13,260 --> 00:17:15,260
...والخطأ الثّاني

271
00:17:20,810 --> 00:17:23,310
!ا-اللاّقط الهوائيّ؟

272
00:17:23,770 --> 00:17:25,270
،إن جمعتُ نفّاثاتي معًا

273
00:17:25,600 --> 00:17:29,400
أستطيع إطلاق قوّة كافية لإطلاق
!حتّى المعدّات الثّقيلة نحو الغلاف الجوّي

274
00:17:30,020 --> 00:17:33,190
!لا يوجد ما لا أستطيع جعله يحلّق

275
00:17:37,240 --> 00:17:40,370
!بإمكاني دفع ثمن أيّ شيء أدمّره فحسب

276
00:17:40,370 --> 00:17:44,120
!يبدو أنّك أنت من سيستسلم

277
00:17:44,950 --> 00:17:48,040
!لم أكن أعلم أنّها تملك كلّ هذه القوّة

278
00:17:49,290 --> 00:17:51,670
آليّو الكلب الدّنماركي الضّخم
.لا يملكون قوّة كافية

279
00:17:52,420 --> 00:17:54,550
...لو تمكّنت من خلق ثغرة ما

280
00:18:03,260 --> 00:18:05,480
كونغو-سان ليست هنا، صحيح؟

281
00:18:05,890 --> 00:18:08,140
أواثقة أنّ هذا هو المكان الصّحيح؟

282
00:18:08,140 --> 00:18:13,150
.نـ-نعم. أخبرتها أن تنتظرنا هنا

283
00:18:13,530 --> 00:18:16,860
آسفة لجعلك تأتين كلّ هذه
.المسافة إلى هنا

284
00:18:16,860 --> 00:18:20,910
لا بأس. لا تتردّدي في الاتّصال
.بي عندما تعثران عليها

285
00:18:21,450 --> 00:18:22,330
.إلى اللّقاء

286
00:18:24,040 --> 00:18:26,370
إلى أين ذهبت يا ترى؟

287
00:18:26,370 --> 00:18:27,120
ماذا؟

288
00:18:27,830 --> 00:18:28,960
ساتن-سان؟

289
00:18:28,960 --> 00:18:30,960
.إنّنا نقابل بعضنا باستمرار

290
00:18:31,420 --> 00:18:33,840
هل رأيتِ كونغو-سان في الجوار؟

291
00:18:41,390 --> 00:18:44,260
...فجأة... أشعر بالوهن

292
00:18:46,560 --> 00:18:47,230
.تفاجأت

293
00:18:47,850 --> 00:18:50,980
استهدفتُ القطّ، وأنت لزمتِ
.مكانك للدّفاع عنه

294
00:18:54,400 --> 00:19:00,280
لا فائدة. حقنتك للتّوّ بجهازي الدّقيق
.الّذي يمنعك من التّحكّم في جسدك

295
00:19:00,820 --> 00:19:03,990
إنّها قيّمة للغاية، لذلك كنتُ
.آمل ألاّ أضطرّ لاستعمالها

296
00:19:04,740 --> 00:19:08,620
...على الأقلّ... أتمنّى من القطّ

297
00:19:09,580 --> 00:19:12,080
...أن يعثر على... ميساكا-سان

298
00:19:13,540 --> 00:19:17,090
بالمناسبة، هل تفعلين هذا لأنّ
ميساكا-سان طلبت منك ذلك؟

299
00:19:17,630 --> 00:19:20,550
دون مقابل؟ كلّ هذا من أجل شخص آخر؟

300
00:19:21,050 --> 00:19:24,760
من المضحك أن ينتهي بك
.الأمر بهذه النّتيجة

301
00:19:25,720 --> 00:19:28,220
.يا لها من فتاة فظيعة

302
00:19:28,770 --> 00:19:32,350
،لقد خدعتك للقيام بهذا
.رغم أنّ لا علاقة لك بالأمر

303
00:19:32,850 --> 00:19:36,440
أصحاب المستوى 5 هؤلاء
...متشابهون جميعًا

304
00:19:42,740 --> 00:19:43,820
...تراجع

305
00:19:45,070 --> 00:19:46,330
...عمّا قلتَه

306
00:19:47,120 --> 00:19:53,880
إنّها ليست... ميساكا-سان ليست
...شخصًا قد تستغلّ الآخرين

307
00:19:54,330 --> 00:19:55,080
...هذا

308
00:19:56,130 --> 00:19:59,420
شيء قرّرتُ أنا القيام به
...بمحض إرادتي

309
00:19:59,420 --> 00:20:03,930
...وشخص مثلك... قد لا يفهم ذلك

310
00:20:07,470 --> 00:20:08,720
!اخرسي

311
00:20:09,350 --> 00:20:12,850
!لا تتحدّثي بتعالٍ معي
...انتهى بك المطاف

312
00:20:12,850 --> 00:20:13,940
...غير قادرة

313
00:20:13,940 --> 00:20:17,610
!على فعل شيء، صحيح؟

314
00:20:17,610 --> 00:20:20,690
!لا فائدة منك أبدًا، أليس كذلك؟

315
00:20:21,110 --> 00:20:25,780
إنّ حقيقة أنّ ميساكا ميكوتو تستطيع
...استعمال حثالة مثلك فقط

316
00:20:25,780 --> 00:20:27,580
—تثبت أنّها كارثة

317
00:20:28,910 --> 00:20:31,160
.مهلاً، كان ذلك وشيكًا

318
00:20:31,700 --> 00:20:34,250
سينتهي أمري إن ماتت قبل
.أن أستخرج أيّ معلومات منها

319
00:20:35,040 --> 00:20:39,920
كم هذا مزعج. كلّما كانت أشكال الحياة
.متدنّية، كان إغضابها للآخرين سهلاً

320
00:20:40,760 --> 00:20:43,380
،يا آليّي الكلب الدّانماركيّ الضّخم
—احملوا هذه الفتاة

321
00:20:43,380 --> 00:20:44,430
!كونغو-سان؟

322
00:20:48,810 --> 00:20:51,270
هذا فظيع. كيف...؟

323
00:20:54,100 --> 00:20:55,940
أنت من فعل هذا بها؟

324
00:20:55,940 --> 00:21:01,360
وماذا في ذلك؟ لا يهمّ كيف ينتهي
المطاف بالقمامة البشريّة، صحيح؟

325
00:21:01,360 --> 00:21:02,530
!ما...؟

326
00:21:02,530 --> 00:21:06,320
.قالت الفتاة أنّها هنا لمساعدة ميساكا ميكوتو

327
00:21:06,570 --> 00:21:10,030
إنّ حقيقة أنّها سلّمت إرادتها لشخص
.آخر يجعلها من الدّرجة الثّانية

328
00:21:10,490 --> 00:21:13,160
وبما أنّها عجزت عن إكمال المهمّة
،الّتي كُلّفت بها

329
00:21:13,160 --> 00:21:15,000
!فهذا يجعلها أسوأ من الدّرجة الثّالثة

330
00:21:15,540 --> 00:21:16,920
.قمامة بشريّة حقيقيّة

331
00:21:16,920 --> 00:21:18,130
...أنت

332
00:21:21,920 --> 00:21:22,840
،ساتن-سان

333
00:21:23,420 --> 00:21:26,550
،أكره أن أطلب منك هذا
...لكن هلاّ أخذت كونغو-سان والقطّ

334
00:21:27,390 --> 00:21:29,930
وانتقلتما لمكان أكثر أمنًا؟

335
00:21:31,680 --> 00:21:33,100
...لكن

336
00:21:34,060 --> 00:21:36,310
،إن لم نحافظ على سلامة ذلك القطّ

337
00:21:37,150 --> 00:21:41,020
فإنّ كلّ جهود كونغو-سان
.ستذهب سدى

338
00:21:42,150 --> 00:21:42,980
...وأيضًا

339
00:21:46,610 --> 00:21:48,320
...لستِ الوحيدة

340
00:21:49,160 --> 00:21:51,830
...الّتي تواجه مشاكل في كبح غضبها

341
00:21:52,620 --> 00:21:55,040
.بسبب رؤية إحدى أصدقائها تُهان

342
00:23:25,040 --> 00:23:40,060
في
الحلقة
القادمة

343
00:23:25,920 --> 00:23:29,970
أواتسوكي-سان، لم أشعر
.باندفاع قويّ كهذا من قبل

344
00:23:29,970 --> 00:23:33,590
،ولا أنا يا وانّاي-سان
يجب أن نتولّى أمر الشّخص

345
00:23:33,590 --> 00:23:34,930
!الّذي أهان كونغو-سان هكذا

346
00:23:34,930 --> 00:23:35,850
!نعم

347
00:23:35,850 --> 00:23:39,770
رغم أنّك تلميذ ثانويّة، إلاّ أنّ لديك
!مهارات لفظيّة لفتى في الإعداديّة