1
00:00:00,350 --> 00:00:01,750
كان

2
00:00:01,750 --> 00:00:03,890
...ستكون هذه رينشان الثالثة

3
00:00:05,210 --> 00:00:07,730
لا حاجة لأخذ ذلك القرميد من السُّور الميِّت

4
00:00:13,640 --> 00:00:15,100
لعلّكِ لم تسمعيني؟

5
00:00:16,170 --> 00:00:19,620
"عندما ناديتِ بـ"كان"، أظنُّني قلتُ "رون

6
00:00:30,740 --> 00:00:31,670
تشانكان

7
00:00:32,440 --> 00:00:34,660
"لن تتحقّق تِلك الـ"كان

8
00:02:07,950 --> 00:02:09,750
صرنا في الجولة الشرقية الثالثة الآن

9
00:02:09,850 --> 00:02:13,350
حتّى الآن، ربِحَتْ كيوسومي مرّتَين
على التوالي برينشان كايهو

10
00:02:13,450 --> 00:02:15,080
وها هي تسوروغا تربحُ بـ تشانكان الآن

11
00:02:15,180 --> 00:02:17,900
إنّه لتحوُّل غير مسبوق للأحداث

12
00:02:20,350 --> 00:02:21,450
وجدتُها

13
00:02:21,560 --> 00:02:25,520
ربّما تكونُ قد ربِحَتْ بواسطة تشانكان في المرة السابقة
ولكن إن أعلنتُ عن "كان" مُغلَقة، فلا ينبغي أن تكون مشكلة، صحيح؟

14
00:02:31,860 --> 00:02:34,870
يمكنُ أيضاً أن تربح من شخص
قد أعلنَ عن "كان" مُغلَقة أيضاً

15
00:02:36,510 --> 00:02:37,950
...كوكوشي موسو

16
00:02:38,050 --> 00:02:40,630
...إن ربِحَتْ بذلك فعلياً، فستكون 48.000 نقطة

17
00:02:42,470 --> 00:02:46,390
لكنني لا أواجه أختي هنا، ينبغي أن تكون الأمور على ما يُرام

18
00:03:00,350 --> 00:03:03,110
لقد علِقتُ في حالة "إيشانتين" منذُ يد البداية

19
00:03:03,460 --> 00:03:06,330
رائع، رائع بحقّ يا سينباي

20
00:03:06,430 --> 00:03:11,020
تشانكان يومي-تشين السابِقة قد شكّلَتْ
ضغطاً على كيوسومي

21
00:03:11,120 --> 00:03:12,830
مياناغا-سان تتردّد

22
00:03:13,190 --> 00:03:14,940
هذا ليس من عادة ساكي-تشان

23
00:03:15,040 --> 00:03:18,750
لا يستطيع أحدٌ فعلياً أن يخطِّطَ لتشانكان

24
00:03:19,190 --> 00:03:23,900
...ولكن إن خطَّطَتْ للفوز بتلك الطريقة

25
00:03:24,000 --> 00:03:26,140
كابتن تسوروغا سهلة الانقياد

26
00:03:27,610 --> 00:03:30,040
الجولة الشرقيّة الثالثة هي عبارة عن سَحب

27
00:03:30,140 --> 00:03:31,270
تينباي

28
00:03:32,910 --> 00:03:34,420
"أنا في "نو تين

29
00:03:34,520 --> 00:03:35,980
كوكوشي كما توقّعت

30
00:03:36,080 --> 00:03:38,470
بمقدوري استقراء القراميد المطروحة أيضاً

31
00:03:38,570 --> 00:03:40,770
يا له من ملَل مُضجِر

32
00:03:40,870 --> 00:03:45,260
كنتُ متحمِّسة بعدَ أن سمِعت بأن كابتن كيوسومي
ستُسبّبُ لي بعضاً من المتاعب

33
00:03:45,360 --> 00:03:47,970
لكن ينقصكِ الكثير

34
00:03:49,290 --> 00:03:51,580
لعلَّ الوقت قد حان لفتح أبواب الموقِع الداخلي المُقدَّس؟

35
00:03:52,580 --> 00:03:53,710
!هذا الإحساس

36
00:03:55,140 --> 00:03:57,400
كانَتْ هي إذاً

37
00:04:00,370 --> 00:04:02,840
...ليتَني ذهبتُ إلى دورة المياه

38
00:04:04,330 --> 00:04:05,840
أماي كورومو

39
00:04:06,310 --> 00:04:08,050
أتنوين أن تربحي في هذا العام مجدداً؟

40
00:04:08,480 --> 00:04:10,840
هل حسبتِ أنكِ كنتِ تلعبين
ضدّ كورومو العام الماضي؟

41
00:04:10,940 --> 00:04:12,090
انسي ذلك فحسب

42
00:04:12,190 --> 00:04:13,930
لم أكن في أحسن حالاتي في العام الماضي

43
00:04:14,950 --> 00:04:19,180
آنذاك، كنتُ فقط بمثل مُستوى بقيّتكم

44
00:04:19,280 --> 00:04:21,070
إن لم تكوني بشرية فمن تكوني إذاً؟

45
00:04:23,320 --> 00:04:25,490
ستكتشفين ذلك لاحقاً

46
00:04:30,060 --> 00:04:33,030
يدي لا تتجاوزُ إيشانتين

47
00:04:33,130 --> 00:04:36,250
...يحدثُ ذلك لسبعة أو ثمانية أدوار عادةً

48
00:04:37,270 --> 00:04:40,370
لقد كنتُ في حالة إيشانتين منذُ يد البداية

49
00:04:40,470 --> 00:04:41,710
أستطيعُ بالكاد تحمّلها

50
00:04:42,450 --> 00:04:44,550
ثمّة خطأ ما
متعلِّق بهذه السّحوبات

51
00:04:51,810 --> 00:04:53,790
وقد بدأتْ

52
00:04:53,890 --> 00:04:58,920
حتّى لو كنتُ أنا من يلعبُ ضدّ كورومو
ستنخفضُ نسبةَ التينباي خاصّتي بشكل كبير

53
00:04:59,360 --> 00:05:01,380
ذلك صَعب بحقّ

54
00:05:01,480 --> 00:05:05,460
يذكّرُني بالفترة التي لاعبتُ فيها كورومو للمرّة الأولى

55
00:05:05,560 --> 00:05:07,970
حدثَ ذلك في اللّيل، وفي يوم بدر

56
00:05:08,070 --> 00:05:10,090
أسوأ وضع ممكن

57
00:05:10,190 --> 00:05:11,970
كانَتْ مُباراة ماجونغ مرعبة

58
00:05:12,070 --> 00:05:15,830
آنذاك، وضعتُ لاصِق وشم قمر

59
00:05:15,930 --> 00:05:19,780
ولكن كلّما أرى انعكاسه في مرآة يذكّرُني
بتِلكم الذكريات المُخيفة، لهذا توقّفت

60
00:05:21,090 --> 00:05:23,560
لماذا جعَلْنا كورومو قائدتنا؟

61
00:05:23,660 --> 00:05:27,370
نحنُ مُقبِلون على وقتِ الانقلاب الشمسي الصيفي
والهانتشان الثاني من الجولة الأخيرة يبدأ ليلاً

62
00:05:27,470 --> 00:05:29,900
وناهيكن عن أنّ الليلة بدر

63
00:05:30,440 --> 00:05:32,860
أُقيمَتْ تصفيات العام الماضي عندما كان القمر تربيعاً، صحيح؟

64
00:05:32,960 --> 00:05:33,770
بالفعل

65
00:05:33,870 --> 00:05:39,850
لا يمكن مُقارنة شراسة أدائها بالماجونغ
أو تقلُّب شخصيتها بمثلهما في العام الماضي

66
00:05:41,060 --> 00:05:43,360
لا أستطيع الوصول إلى تينباي مهما فعَلْت

67
00:05:43,950 --> 00:05:45,580
ما معنى هذا؟

68
00:05:45,680 --> 00:05:46,930
...وكأنّني

69
00:05:48,860 --> 00:05:52,460
أنجذِبُ نحو قاع البحر

70
00:05:57,340 --> 00:05:58,350
تشي

71
00:05:58,770 --> 00:05:59,620
فعلتُها

72
00:06:00,540 --> 00:06:02,130
ماذا فعلَتْ؟

73
00:06:08,300 --> 00:06:08,800
رييتشي

74
00:06:12,230 --> 00:06:15,220
تُعلِنُ عن رييتشي طارِحة القرميد
!الذي التقطَتْه للتو في الدور الأخيرة؟

75
00:06:19,070 --> 00:06:20,890
لا أستطيع النداء

76
00:06:34,270 --> 00:06:35,440
انتهى

77
00:06:35,540 --> 00:06:37,950
الفوزُ في السحب الأخير يعني ياكو أخرى

78
00:06:38,050 --> 00:06:40,500
تِلك هي أماي كورومو

79
00:06:41,100 --> 00:06:43,660
:معنى اسم هذه الياكو هو

80
00:06:45,460 --> 00:06:47,880
"غَرْف انعكاس القمر من البحر"

81
00:07:03,040 --> 00:07:05,220
هايتي راويوي

82
00:07:06,270 --> 00:07:07,850
فوز بواسطة هايتي؟

83
00:07:07,950 --> 00:07:09,550
ما القصّة بالضبط؟

84
00:07:09,650 --> 00:07:11,260
كانت اليد جيّدة بما يكفي حتّى دون رييتشي

85
00:07:11,360 --> 00:07:13,530
ولكن أن تُعلِنَ رييتشي في الدور الأخير
...وتطرح القرميدَ الذي التقطَتْه

86
00:07:13,630 --> 00:07:18,700
يعني وكأنها كانَتْ واثِقة
أنها ستربحُ بالقرميد الأخير

87
00:07:19,050 --> 00:07:22,880
،وبحسبِ ما أتذكّره من سجلَّات مباريات كورومو للعام الماضي

88
00:07:22,980 --> 00:07:25,290
،رغمَ أنها ربِحَتْ بـ هايتي في التصفيات

89
00:07:25,390 --> 00:07:27,820
لم تربح بتِلك الطريقة في البطولة الوطنيّة

90
00:07:27,920 --> 00:07:31,630
بحسَبِ سجلَّات البطولتَين، ينبغي أن تكون من النوع
الذي يطمحُ دوماً للحصول على أيدٍ ذات قيمة عالية

91
00:07:32,580 --> 00:07:34,430
...ينتابُني إحساسٌ سيئ حيال هذا

92
00:07:37,490 --> 00:07:39,200
ما هذا؟

93
00:07:39,300 --> 00:07:41,910
باليد الابتدائيّة هذه، كنتُ متأكِّدة
من قدرتي على نِداء تون

94
00:07:42,010 --> 00:07:43,110
لكنني لم أحصل على أي واحدة

95
00:07:43,210 --> 00:07:44,350
أنا عالِقة تماماً

96
00:07:44,450 --> 00:07:50,230
وفي هذه الحالة، ستربحُ أماي كورومو
بـ هايتي تسومو مجدّداً

97
00:07:50,730 --> 00:07:54,240
...بإجمالي هذه النقاط، وبتبقِّي بضعة جولات

98
00:07:54,780 --> 00:07:57,660
سأفعلُها بلا شكّ

99
00:07:57,760 --> 00:07:58,240
كان

100
00:08:03,540 --> 00:08:05,050
يدي تتشكَّل

101
00:08:05,150 --> 00:08:09,120
لستُ واثِقة ما إن كانَ هذا القرميد
الذي كانَتْ كيوسومي تنوي الفوز به

102
00:08:09,220 --> 00:08:13,050
ولكن بـ"كان" هذه، بدّلتُ
الذي كان ينبغي أن يكون القرميد الأخير بآخر

103
00:08:13,150 --> 00:08:18,350
وبنقلة واحدة، ينبغي أن أُفسِدَ فوزَهن
بواسطة كايهو وهايتي

104
00:08:18,450 --> 00:08:21,830
لقد حرفتُ أماي كورومو عن طريقها نحو هايتي

105
00:08:21,930 --> 00:08:24,140
كلّ ما عليّ فعله الآن هو الفوز بهذه اليد

106
00:08:27,770 --> 00:08:29,480
لا أستفيد مهما سحَبت

107
00:08:31,080 --> 00:08:31,860
بون

108
00:08:32,550 --> 00:08:34,280
بي بون، بي بون

109
00:08:34,680 --> 00:08:36,450
عادَتْ إلى مسارِها المؤدّي إلى هايتي؟

110
00:08:37,780 --> 00:08:43,530
هل هي خائفة؟ هل هي خائفة من فوز
ريومونبوتشي بـ هايتي؟

111
00:08:44,390 --> 00:08:45,910
...في تِلك الحالة

112
00:08:46,500 --> 00:08:47,880
هلّا ناديتِ لهذه؟

113
00:08:48,180 --> 00:08:49,470
كان ذلك وشيكاً

114
00:08:53,740 --> 00:08:59,260
مُقارنة بالحصول على رينشان كايهو مرّتَين
على التوالي، هايتي فرديّة ليسَتْ بالأمر الغريب

115
00:08:59,360 --> 00:09:01,640
...ومن ذلك المنطلق... إذا

116
00:09:05,740 --> 00:09:07,730
...إذا فعلَتْ ذلك مرّتَين على التوالي

117
00:09:08,900 --> 00:09:09,990
تسومو

118
00:09:10,880 --> 00:09:12,360
هايتي راويوي

119
00:09:14,960 --> 00:09:16,710
!اثنتان هايتي على التوالي؟

120
00:09:16,810 --> 00:09:18,110
!وتِلك هي الياكو الوحيدة لها؟

121
00:09:19,150 --> 00:09:21,370
لحظة، تحصلُ على 3 دورا
من "مؤشِّر كان دورا" أيضاً

122
00:09:21,470 --> 00:09:24,640
هل يعني أنني لو لم أستدعِ تِلك "الكان" لأوقفتُها؟

123
00:09:24,740 --> 00:09:28,090
هل كان يجدرُ بي أن أتجاهل كيوسومي
وأُنادي "بون" بدلاً من ذلك؟

124
00:09:28,640 --> 00:09:29,250
...المعذرة

125
00:09:31,440 --> 00:09:33,510
كان ينبغي أن أنادي بون

126
00:09:33,610 --> 00:09:35,910
اثنتا هايتي على التوالي

127
00:09:36,010 --> 00:09:42,740
بفضلِ هذين الفوزين اللّذين حقّقتْهما أماي كورومو
تقفزُ ريومونبوتشي عائدة للقمّة

128
00:09:42,840 --> 00:09:47,330
حتّى الآن كانَتْ رينشان، رينشان، تشانكان
...هايتي، هايتي

129
00:09:47,430 --> 00:09:49,490
هذا أكثر من مجرّد صدفة بكثير

130
00:09:49,590 --> 00:09:51,890
لِغز حقيقي

131
00:09:52,290 --> 00:09:57,240
أزهار رينشان المتفتّحة، وقمر هايتي المُضيء

132
00:10:01,050 --> 00:10:02,410
...هذا أشبه بـ

133
00:10:05,160 --> 00:10:06,880
...حديقة أزهار متفتّحة تحت البدر

134
00:10:13,600 --> 00:10:17,030
لاعبة كازيكوشي تُدعى إيكيدا إن لم تخنّي الذاكرة

135
00:10:17,130 --> 00:10:20,570
تبدو وكأنها كانَتْ تتوخّى الحذر
من اليد الأخيرة لآماي هايتي

136
00:10:20,670 --> 00:10:27,840
عند الجلوس مع الخصم في الطاولة، يمكنك الإحساس بالأشياء
دون قول أي كلمة أو القيام بإيماءات خاصّة

137
00:10:27,940 --> 00:10:31,970
مع أنّ شخصاً كرّسَ نفسه لأسلوب اللعب
،عبر الإنترنت قد يتجاهل ذلك

138
00:10:32,070 --> 00:10:38,190
ولكن هل هذا يعني أنَّها شعرَتْ بأنّ في العام
الماضي، حالتا الـ هايتي تِلكما لم تكونا مجرّد صدفة؟

139
00:10:38,290 --> 00:10:42,320
في هذه الحالة أكونُ قد وقعتُ في فخّ هايتي
الذي نصبَتْه آماي كورومو أثناء لعِبي بأسلوب تحفُّظي

140
00:10:42,420 --> 00:10:45,170
لحماية تينباي الموزِّع لليد الأخيرة خاصّتي

141
00:10:45,590 --> 00:10:46,990
هل أفسدتُها؟

142
00:10:48,730 --> 00:10:53,150
ستُصَعقين كثيراً إن ظننتِ بأنَّ الهايتي هي الخدع
الوحيدة التي تُخفيها كورومو في جعبتها

143
00:10:53,250 --> 00:10:55,410
لدغَتْني تِلك أيضاً

144
00:10:55,510 --> 00:10:59,070
إنّها ليسَتْ هجمة خاصّة لها أو ما شابه
...إنّها أقرب إلى

145
00:10:59,170 --> 00:10:59,840
سيطرة كاملة

146
00:10:59,940 --> 00:11:01,010
نعم

147
00:11:01,110 --> 00:11:05,590
الفتاة التي كنتُ ألعبُ معها آنذاك
...لم تكن فتاة بمثل سنّي

148
00:11:05,690 --> 00:11:07,890
كان قدَراً محتوماً لا مفرّ منه

149
00:11:10,380 --> 00:11:12,640
...أنا بعيدة جداً

150
00:11:12,740 --> 00:11:18,980
هل يجدرُ بي مُحاولة إيقاف الـ هايتي خاصّتها
أم ينبغي أن أشكّل يداً عائدة بقوّة؟

151
00:11:19,360 --> 00:11:22,150
لحظة، فكّرتُ بذات الشيء في العام الماضي

152
00:11:22,790 --> 00:11:25,980
في العام الماضي، أطلقتُ نداءً لمنعها من سحبِها الأخير

153
00:11:26,080 --> 00:11:30,720
ولكن عندما دخلتُ أخيراً في حالة "تينباي" بيد جيّدة
طَرحي للقرميد نفعَها في تحقيقِ بايمان

154
00:11:31,680 --> 00:11:35,720
أيّ الطريقَين تسلكين، لا ينتظرك في نهايتهما إلّا الموت

155
00:11:35,820 --> 00:11:40,420
عندما تكونُ أماي موزِّعة، نطمحُ لتحقيق هايتي
...إلَّا إنْ أطلقَ أحدهم نِداء

156
00:11:44,260 --> 00:11:45,180
تشي

157
00:11:45,280 --> 00:11:48,260
أستطيع النداء هذه المرّة أخيراً

158
00:11:50,870 --> 00:11:54,070
،يسرُّني أنني أستطيع النّداء لإيقاف هايتي خاصّتها

159
00:11:54,170 --> 00:11:55,400
لكنني سأحقّقُ هذه البايمان أيضاً

160
00:11:58,250 --> 00:12:00,370
ذلك هو القرميد الحَرفي الثالث الذي أسحبُه على التوالي

161
00:12:00,470 --> 00:12:02,530
حسناً، تبدو الأمور سليمة

162
00:12:10,420 --> 00:12:10,990
بون

163
00:12:16,090 --> 00:12:17,020
...هذا

164
00:12:17,120 --> 00:12:21,620
لو لعِبَتْ إيكيدا-سينباي كما تلعبُ عادةً
لطرحَت القرميد الحرفي 8 حتّى بعد النداء، صحيح؟

165
00:12:21,720 --> 00:12:25,210
لا توجدُ كثير من القراميد المُفيدة
إن طرحتِ ذلك القرميد الحرفي 2

166
00:12:25,310 --> 00:12:25,950
...كانا

167
00:12:26,050 --> 00:12:29,460
إن كانَتْ يدكِ لا تتشكَّل وأطلقتِ نداء
...لطرحِ ذلك القرميد فهذا

168
00:12:29,560 --> 00:12:30,600
خطأ هُواة

169
00:12:32,190 --> 00:12:37,080
بعدما فعلتُ ذلك، لم أطلِق أي نداء
ولم أسحب أي شيء مُفيد

170
00:12:37,180 --> 00:12:38,940
هل يُعقَلُ أن يكون مجرّد حظّ سيئ؟

171
00:12:40,440 --> 00:12:42,640
وهذه هي التوفو الأخيرة

172
00:12:44,300 --> 00:12:48,930
بعدما بلغَتْ أماي حالة تينباي بـ بينفو في الدور 10
ظلَّتْ تُخفي ذلك طوال الوقت

173
00:12:48,930 --> 00:12:51,510
هل تمتنع عن إعلان رييتشي لأنها موزِّعة ومتقدِّمة؟

174
00:12:51,510 --> 00:12:52,970
إطلاقاً

175
00:12:55,900 --> 00:12:57,010
بون

176
00:12:57,110 --> 00:12:58,450
المسار مسدود

177
00:12:58,550 --> 00:12:59,730
لقد بدأتْ

178
00:12:59,830 --> 00:13:03,260
التخلُّص من بينفو موزِّع عندما تكون
،في المقدِّمة وتمضي بِلا أي ياكو

179
00:13:03,360 --> 00:13:07,870
هو أسلوب لا أفكِّر به أنا وهارامورا نودوكا
طيلة حياتنا

180
00:13:07,970 --> 00:13:10,390
بهذا الشكل، ستكونُ كورومو هي الفتاة
التي تسحبُ القرميدَ الأخير، صحيح؟

181
00:13:10,830 --> 00:13:12,100
...غيّرَت السحب

182
00:13:12,480 --> 00:13:14,900
...والآن الشخص الذي سيسحبُ القرميدَ الأخير

183
00:13:15,000 --> 00:13:16,060
سيكون أنا...

184
00:13:24,090 --> 00:13:27,470
في هذه الحالة، ستربح بـ هايتي مجدداً

185
00:13:27,570 --> 00:13:29,910
عليّ أن أفوز أو أحرفها عن المسار قبل ذلك الحين

186
00:13:31,130 --> 00:13:33,970
لم أتمكّن من بلوغ حالة تينباي إطلاقاً منذُ تِلك اللحظة

187
00:13:34,070 --> 00:13:38,410
...ولكن إن كان سحباً عادياً لا ينفع فأستطيعُ دوماً

188
00:13:39,190 --> 00:13:39,670
كان

189
00:13:43,040 --> 00:13:44,150
بلغتُها

190
00:13:44,250 --> 00:13:47,670
هذه هي المرّة الأولى التي أبلغُ فيها تينباي
منذُ أن أصبحَتْ مُخيفة

191
00:13:49,270 --> 00:13:51,850
أمَا من رينشان كايهو هذه المرّة إذاً؟

192
00:13:53,100 --> 00:13:56,650
ولكن دورا الجديدة هي القرميد الحَرفي 6
الذي استدعَتْه أماي

193
00:13:56,750 --> 00:14:00,210
ولكن بسببِ تِلك الـ كان
الهايتي الخاصّة بأماي قد حُرِفَتْ

194
00:14:03,280 --> 00:14:06,280
ربّما، لكنني لا أحصل على أي شيء نافع

195
00:14:08,600 --> 00:14:09,110
تشي

196
00:14:10,220 --> 00:14:12,280
وها هي أماي كورومو

197
00:14:13,310 --> 00:14:15,330
عادَتْ إلى المسار لتسحب القرميد الأخير

198
00:14:15,430 --> 00:14:18,580
إذا ربِحَتْ بتِلك، ستحصلُ على ما لا يقلّ عن 12.000 نقطة

199
00:14:23,380 --> 00:14:26,660
أتمنّى على الأقل لاعبة ترمي
...قرميداً أستطيعُ استدعائه

200
00:14:27,850 --> 00:14:34,500
حتّى لو كان لأجل نفس عدد النقاط، أفضِّل أن أُنفِعَ يد
كازيكوشي أكثر من الحصول على تسومو بواسطة أماي

201
00:14:34,600 --> 00:14:40,140
لكن حتّى لو استطعتُ احتساب إجمالي النقاط
لكل منهن، لا أملك أي قرميد حَرفي أساساً

202
00:14:43,050 --> 00:14:44,230
هذا ليس جيّداً

203
00:14:47,390 --> 00:14:50,020
...لا أستطيع الفوز، لا يمكنني حرفها عن المسار

204
00:14:51,980 --> 00:14:53,610
هذا سيئ

205
00:14:55,850 --> 00:14:57,620
إنِّي أرى قاعَ البحر

206
00:14:59,470 --> 00:15:04,360
خلالَ الأيدي السابقة، من العجيب حقّاً أن نرى أيدي الجميع
متجمِّدة فيما عدا أماي

207
00:15:04,360 --> 00:15:06,970
...لم يحدث هذا في العام الماضي، أجل

208
00:15:07,070 --> 00:15:08,340
هنالِك كثيرٌ من الناس يشتكون من حالات

209
00:15:08,350 --> 00:15:11,760
مثل القبوع في "جحيم إيشانتين" أو
عندما لا تتشكّل أيديهم

210
00:15:11,770 --> 00:15:15,900
لا عجب في عدمِ تحرُّك يد
أي لاعب لثمانية أدوار

211
00:15:16,000 --> 00:15:17,260
ليته كان مجرّد اشتكاء

212
00:15:17,660 --> 00:15:20,040
ولكن ما الذي يجري هنا؟

213
00:15:20,140 --> 00:15:23,510
ثلاثة لاعِبات لم تستطِعن بلوغ تينباي
...حتّى السحب الأخير

214
00:15:23,610 --> 00:15:26,400
ويتكرّر ذلك ثلاث مرّات على التوالي

215
00:15:27,610 --> 00:15:29,420
...الدور الأخير

216
00:15:30,140 --> 00:15:32,500
لو فعلتُ هذه في وقتٍ أبكر لاستطعت الفوز

217
00:15:33,010 --> 00:15:34,620
...فلتمنحني

218
00:15:35,110 --> 00:15:37,160
فلتمنحني إحداكن الفوز عمداً

219
00:15:38,410 --> 00:15:39,750
السّحب الأخير

220
00:15:39,850 --> 00:15:42,040
إذا طرحتُ قرميدَ الخيزران 9، فأنا في حالة تينباي

221
00:15:42,140 --> 00:15:45,120
ولكن إن فعلتُ ذلك، فهل ستحصلُ أماي على هايتي أخرى؟

222
00:15:49,140 --> 00:15:50,130
هذه؟

223
00:15:52,500 --> 00:15:55,280
رون، 2000 نقطة

224
00:15:56,530 --> 00:15:59,360
تخلَّتْ عن التينباي خاصّتها ونفعَتْها عمداً؟

225
00:15:59,460 --> 00:16:03,890
أحسَّتْ بمشاعري ومنحَتْني الفوز، مذهل

226
00:16:04,390 --> 00:16:06,910
زالَ موقِعُ الموزِّعة عن كورومو الآن

227
00:16:07,010 --> 00:16:10,660
تكرهُ كورومو أن تلعبُ كطفلة

228
00:16:10,760 --> 00:16:12,840
وكنتُ سأربحُ بتِلك أيضاً

229
00:16:16,090 --> 00:16:17,470
...مُنافِستان تجدان نفسيهما في نفس الوكر

230
00:16:17,570 --> 00:16:20,370
انسجام كبير بين أشخاص يُقارِعون كائناً رفيعاً؟

231
00:16:21,190 --> 00:16:24,000
!أتعتقدن أنني سأدعكن تفلتن بمثل هذه المؤامرة؟

232
00:16:24,270 --> 00:16:26,140
...هذا التجمهُرُ عليّ

233
00:16:26,240 --> 00:16:27,540
يا لها من وقاحة

234
00:16:28,960 --> 00:16:33,210
رئيسة نادي تسوروغا أحسنَتْ في نفعِها بتِلك الطريقة

235
00:16:33,310 --> 00:16:35,970
رئيسة نادي تسوروغا ليسَتْ كاجيكي، إنها كانبارا

236
00:16:36,720 --> 00:16:38,300
كانبارا؟ هل أنت جادّ؟

237
00:16:38,400 --> 00:16:40,410
...نعم، صحيح

238
00:16:41,940 --> 00:16:46,290
هذا لأنَّ كيوسومي استخدمَتْ "كان" لبِناء يدها
وتسوروغا قد فهِمَتْ ذلك

239
00:16:46,390 --> 00:16:49,520
بصراحة، إنها مُقاومة عقيمة

240
00:16:53,590 --> 00:16:55,990
بدأ سِتار اللّيل يخيّم

241
00:17:00,080 --> 00:17:02,040
...هذه اليد الابتدائيّة

242
00:17:02,140 --> 00:17:06,960
لنفترِض أنّ أماي هي فعلاً كائن
...جديد ما لديه قدرة السيطرة

243
00:17:07,060 --> 00:17:11,200
إن أمضيتُ بشكل طبيعي، فسأصبحُ إيشانتين مجدداً

244
00:17:11,300 --> 00:17:13,510
...ولكن إن فعلتُ ذلك بشكل التفافي

245
00:17:13,610 --> 00:17:16,020
...فالقدر حينها أو أيّاً يكن

246
00:17:17,880 --> 00:17:19,740
انحرفَتْ عن النظريّة فجأة

247
00:17:20,560 --> 00:17:23,320
حتّى يومي-تشين قد تفكِّر بتلك الطريقة أيضاً

248
00:17:23,420 --> 00:17:24,930
اتركن الأمرَ لها

249
00:17:24,930 --> 00:17:27,390
...هذا صحيح، فإن كانَتْ سينباي، إذاً

250
00:17:27,490 --> 00:17:34,300
يعزو الفضلُ بحصولِنا عليكِ هنا يا مومو وبلوغنا
النّهائي بقيادة يومي-تشين

251
00:17:34,400 --> 00:17:39,490
جلّ ما علينا انتظاره هو أن ندع يومي-تشين
تحظى بالمرح وننتظر عودتها

252
00:17:39,590 --> 00:17:40,130
نعم

253
00:17:40,230 --> 00:17:41,320
صحيح

254
00:17:41,420 --> 00:17:43,450
أنا واثِقة بأنها ستربح

255
00:17:45,280 --> 00:17:46,580
تينباي

256
00:17:48,100 --> 00:17:49,750
يمكنُ تحقيق ذلك

257
00:17:49,850 --> 00:17:51,830
فسيطرتها ليسَتْ مثاليّة

258
00:17:52,230 --> 00:17:53,320
رييتشي

259
00:17:53,450 --> 00:17:57,170
رييتشي؟ رائع، بمقدورها بلوغ تينباي بشكل طبيعي

260
00:18:01,840 --> 00:18:04,250
!يا لِنقلات الطرح العجيبة هذه

261
00:18:04,890 --> 00:18:09,720
هل أملُك الوقت الكافي للقلقِ بشأنِ هذه اليد
!التي في حالة إيشانتين وأنا متأخِّرة إلى هذا الحد؟

262
00:18:09,820 --> 00:18:10,790
هيّا

263
00:18:10,890 --> 00:18:12,000
رون

264
00:18:13,490 --> 00:18:17,900
رييتشي، إيبّاتسو، تشيتويتسو، 2 أورا دورا، 12.000

265
00:18:19,660 --> 00:18:22,370
...تمَّ جرِّي نحو إيبّاتسو

266
00:18:23,530 --> 00:18:28,570
آسِفة بشأن هذا، خططتُ لأخذ هذه النقاط من أماي

267
00:18:28,670 --> 00:18:31,580
ولكن لستُ مُترفة لدرجة أهمِلُ فيها
...شيئاً كهذا أيضاً

268
00:18:32,700 --> 00:18:35,420
هنالِك 14.400 نقطة بيني وبين الأولى

269
00:18:37,490 --> 00:18:40,350
يجبُ أن أستغلَّ منصبَ الموزِّع حالاً

270
00:18:54,410 --> 00:18:57,590
ما هذا الإحساس الطاغي؟

271
00:18:57,690 --> 00:19:01,010
...هنالِك آخرون يشعرون به عندما يسوءُ إلى هذا الحدّ

272
00:19:02,640 --> 00:19:05,830
بل أشدّ سوءاً من الذي كنتُ أحسُّ به
...أثناء اللّعب مع أختي الكبيرة

273
00:19:07,260 --> 00:19:09,230
من المُحال أن أتمكّن من الفوز

274
00:19:12,750 --> 00:19:19,580
هل تمكّنتُ من الفوز في المرة السابقة
حقّاً لأنني واجهتُ سيطرةَ أماي؟

275
00:19:20,240 --> 00:19:20,630
بون

276
00:19:22,360 --> 00:19:24,470
أم أنّها مجرّد بداية فقط؟

277
00:19:24,860 --> 00:19:28,490
تماماً كموجة البحر الهائلة التي تدفعُ
...راكبَ الأمواج للخلف

278
00:19:28,590 --> 00:19:31,980
هل يُعقَلُ أن أماي كانَتْ تتحفّظ
في اليد السابقة فقط؟

279
00:19:32,760 --> 00:19:33,400
بون

280
00:19:35,920 --> 00:19:38,350
نداءان، من البداية

281
00:19:38,450 --> 00:19:40,440
...في هذه الحالة، بالنسبة لهذه اليد

282
00:19:51,730 --> 00:19:53,790
هل تسمَعن قرعَ جرس الليل؟

283
00:19:55,360 --> 00:19:56,290
رون

284
00:19:57,180 --> 00:19:59,250
12.000

285
00:19:59,350 --> 00:20:01,020
إنها لا تصبو لـ هايتي فقط

286
00:20:01,220 --> 00:20:03,500
تسعى أيضاً أن تحصدَ شيئاً من الأخريات إذاً

287
00:20:04,470 --> 00:20:07,380
...مع تطويق الظلام للعالم

288
00:20:07,970 --> 00:20:11,520
ستُخمَدُ شمعة حياتكم أيضاً

289
00:20:12,420 --> 00:20:15,470
جُرِرتُ نحو هانيمان مرّتَين على التوالي

290
00:20:15,570 --> 00:20:17,620
ما الذي يجري؟

291
00:20:17,720 --> 00:20:20,050
هُنالِك خطبٌ ما؟

292
00:20:21,800 --> 00:20:24,100
استمتعي يا كانا

293
00:20:24,200 --> 00:20:25,440
كابتن؟

294
00:20:25,540 --> 00:20:28,820
تحدثُ أحياناً بعض الأمور السيّئة
التي لا تُصدَّق، صحيح؟

295
00:20:28,920 --> 00:20:32,410
ولكن إن غضبتِ وحزنتِ في كلّ حين
فلن ينتهي الأمر، أليس كذلك؟

296
00:20:33,230 --> 00:20:35,870
عليكِ أن تؤمني بأنّ أموراً جيّدة
سوف تحدث في النهاية

297
00:20:35,970 --> 00:20:37,670
...وامضي دوماً للأمام

298
00:20:37,770 --> 00:20:41,000
أحبُّ أن أعيش حياةً كهذه
أستمتعُ فيها مهما حدث

299
00:20:42,030 --> 00:20:45,140
مستحيل، هذا مستحيلٌ يا كابتن

300
00:20:45,240 --> 00:20:47,800
من المُحال أن أستمتع في وضع كهذا

301
00:20:48,190 --> 00:20:50,740
هذه هي نهائيات التصفيات الإقليمية

302
00:20:50,840 --> 00:20:52,180
الجولة الأخيرة

303
00:20:52,280 --> 00:20:55,760
سأكون أنا السبب في ضياع أحلام
...الجميع بالتأهّلِ إلى البطولة الوطنيّة

304
00:21:01,910 --> 00:21:04,980
...ها هي اليد الأخيرة من الهانتشان الأوّل

305
00:21:05,080 --> 00:21:05,940
بون

306
00:21:08,460 --> 00:21:09,770
بون من نان

307
00:21:09,870 --> 00:21:12,580
كنتُ آملُ أن أحصل على ما لا يقلّ
عن يدين كموزِّعة

308
00:21:19,040 --> 00:21:22,650
...كيوسومي وتسوروغا كانتا خائفتَين منذُ قليل

309
00:21:22,750 --> 00:21:25,510
رغمَ أنني كنتُ أنا من تلقّى لدغة

310
00:21:34,580 --> 00:21:35,950
تسومو

311
00:21:36,050 --> 00:21:37,990
3000/6000

312
00:21:41,750 --> 00:21:44,410
وبهذا يكون هانتشان الأوّل قد انتهى

313
00:21:44,510 --> 00:21:48,230
،وحدها أماي كورومو من ثانوية ريومونبوتشي

314
00:21:48,330 --> 00:21:50,480
من تفوّقَتْ كلّياً على بقية المدارس

315
00:21:50,580 --> 00:21:52,450
هل ستستمرُّ المباراةُ هكذا؟

316
00:21:52,490 --> 00:21:54,690
أم أن المدارس الأخرى ستتعافى؟

317
00:21:55,500 --> 00:21:59,510
كلّ ما بقي هو النصف الثاني، هانتشان فردي واحد فقط

318
00:22:02,050 --> 00:22:02,830
...إنها

319
00:22:04,310 --> 00:22:05,890
قويّة للغاية