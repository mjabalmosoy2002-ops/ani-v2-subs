1
00:00:01,570 --> 00:00:04,590
،ريومونبوتشي وكازيكوشي كانتا متوقّعتَين

2
00:00:04,690 --> 00:00:08,870
ولكن المدرستين الأُخرَتَين اللّتَين تأهّلتا
للنهائي مجهولتان تماماً

3
00:00:08,970 --> 00:00:11,910
تصعّد الخِلاف بين أوساط كيوسومي، أليس كذلك؟

4
00:00:12,010 --> 00:00:15,930
أظنُّ أن هذا يعني بأن هارامورا
نودوكا ليسَتْ فريقاً من امرأة واحدة

5
00:00:16,030 --> 00:00:17,640
ماذا تقصدين؟

6
00:00:17,740 --> 00:00:21,740
هذا ما كانَتْ تقوله لي إذاً آنذاك

7
00:02:15,460 --> 00:02:17,440
تفضّلي، رامِن باللحم المشويّ

8
00:02:17,540 --> 00:02:19,530
هذا ما أتحدّث عنه

9
00:02:19,630 --> 00:02:22,370
،حسناً يا جماعة، لا داعي للتردّد
باشِروا بالطعام

10
00:02:22,470 --> 00:02:24,000
لنأكل

11
00:02:24,100 --> 00:02:28,200
،الطعام على حِسابي اليوم
لِذا يمكنُكم تناوُل طبق ثانٍ

12
00:02:28,300 --> 00:02:30,960
كلوا حتّى الشبع استعداداً لنهائيات الغدّ

13
00:02:31,060 --> 00:02:33,790
يبدو لذيذاً للغاية

14
00:02:41,020 --> 00:02:43,870
أهذه هي المرّة الأولى التي تأكلين
فيها رامِن يا نودو-تشان؟

15
00:02:43,970 --> 00:02:45,870
سمِعتُ بالرامن على الأقلّ

16
00:02:45,970 --> 00:02:46,930
حسناً إذاً

17
00:02:56,190 --> 00:02:57,800
إنه شهيّ

18
00:02:57,900 --> 00:02:58,780
هل أعجبَكِ؟

19
00:02:58,880 --> 00:02:59,890
نعم

20
00:03:01,160 --> 00:03:02,970
سيّدي، اسكب لي مجدّداً

21
00:03:03,070 --> 00:03:04,330
!حالاً

22
00:03:04,430 --> 00:03:06,690
تفضّلي بيض مسلوق ولحم مشوي مع البصل

23
00:03:06,790 --> 00:03:08,880
!لا أطيق الانتظار

24
00:03:11,820 --> 00:03:13,350
مذاقه رائع

25
00:03:13,450 --> 00:03:15,290
يسرُّني أنه أعجبكِ

26
00:03:15,390 --> 00:03:20,200
فهذا هو المكان الوحيد المتوفِّر في البلدة
في هذا الوقت المتأخِّر

27
00:03:20,300 --> 00:03:21,880
لأننا في منطِقة نائية

28
00:03:21,980 --> 00:03:24,870
سيّدي، حضِّر لي رامن مع التاكو

29
00:03:24,970 --> 00:03:27,350
ليسَ عندي أي أخطبوط

30
00:03:29,180 --> 00:03:31,200
شبِعت

31
00:03:31,300 --> 00:03:33,470
...لقد ابتلعتِ ثلاثة أطباق

32
00:03:33,570 --> 00:03:35,950
معِدتي بِلا قاع

33
00:03:36,050 --> 00:03:37,750
أحسدكِ على ذلك

34
00:03:42,170 --> 00:03:44,330
ذاك هو القطار الأخير

35
00:03:44,430 --> 00:03:46,740
هل تأخّرَ الوقت إلى هذا الحد؟

36
00:03:46,840 --> 00:03:48,140
آسِفة بشأن ذلك

37
00:03:48,240 --> 00:03:50,600
السبب هو أنّ قاعة البطولة بعيدة جداً

38
00:03:50,700 --> 00:03:53,140
...ويتوجَّبُ علينا الالتقاء غداً مبكّراً كذلك

39
00:03:53,440 --> 00:03:56,060
لا عليكِ، هذه ليسَتْ بمُشكلة

40
00:03:56,160 --> 00:03:59,130
...المسألة ليسَتْ سهلة بالنسبة لي

41
00:03:59,230 --> 00:04:05,470
كلّما فكّرتُ كيف سأستيقظُ غداً في وقت باكِر
تتهدَّلُ كتِفايّ أكثر فأكثر

42
00:04:05,570 --> 00:04:07,370
هذا صحيح

43
00:04:07,470 --> 00:04:11,620
إذا ربِحنا في التصفياتِ الإقليميّة لهذا العام
وتأهَّلنا إلى البطولة الوطنيّة

44
00:04:11,720 --> 00:04:15,020
فقد نتمكّن من الحصول على ما يكفي
من مال للمكوث طِوال الليل

45
00:04:15,120 --> 00:04:19,200
حسناً، سنقيمُ في العام الماضي إذاً
في فندق فاخر

46
00:04:19,770 --> 00:04:22,040
هذا مُطمئن

47
00:04:22,720 --> 00:04:24,720
أعتمدُ عليكِ في العام المقبل

48
00:04:27,530 --> 00:04:29,650
!أتعتقدين أنه يجوز لكِ أن تحمّليني المسؤولية؟

49
00:04:32,010 --> 00:04:33,160
أنا مُنهَكة

50
00:04:33,260 --> 00:04:36,680
سارَ اجتماع اليوم على ما يُرام

51
00:04:36,780 --> 00:04:39,850
والمدرِّبة كوبو كانَتْ بمزاج سيئ

52
00:04:40,250 --> 00:04:43,260
هل تِلك الإشاعة صحيحة يا تُرى؟

53
00:04:43,360 --> 00:04:44,230
إشاعة؟

54
00:04:44,590 --> 00:04:51,640
أن المدرِّبة ترى بأنه كان ينبغي على فريق العام الماضي
أن يربح حقاً، ولا تهتمّ بهذا العام

55
00:04:51,740 --> 00:04:58,110
لا أدري ما إن كان ذلك صعباً على الكابتن
والتي بقيَتْ منذُ العام الماضي

56
00:04:58,210 --> 00:05:03,520
إن ربِحنا غداً فستكفّ المدرِّبة
عن الاشتكاء من أي شيء

57
00:05:03,620 --> 00:05:04,340
تفضّلي

58
00:05:04,440 --> 00:05:06,330
شكراً لكِ

59
00:05:09,920 --> 00:05:11,620
كابتن

60
00:05:11,720 --> 00:05:14,390
أبليتنّ حسناً في الاجتماع

61
00:05:15,180 --> 00:05:19,140
الحمّامُ جاهز فهل ندخل جميعاً؟

62
00:05:20,560 --> 00:05:24,050
كابتن... أستطيعُ أن أغسل نفسي

63
00:05:24,150 --> 00:05:26,150
مهلاً، لا تتحرّكي

64
00:05:27,000 --> 00:05:28,680
ولكن أستطيعُ أن أغسل نفسي

65
00:05:28,780 --> 00:05:30,680
...هذا رائع

66
00:05:32,140 --> 00:05:34,050
حسناً، انتهيت

67
00:05:34,150 --> 00:05:36,440
...شكراً جزيلاً لكِ

68
00:05:36,540 --> 00:05:37,850
سأشطفكِ قليلاً، حسناً؟

69
00:05:45,920 --> 00:05:47,460
حسناً، انتهيت

70
00:05:51,640 --> 00:05:53,680
منعش للغاية

71
00:05:55,670 --> 00:05:57,850
لنفعل ما بوسعنا غداً، اتفقنا؟

72
00:06:00,430 --> 00:06:02,020
نعم

73
00:06:04,530 --> 00:06:06,900
حسناً، سنفترقُ من هُنا

74
00:06:07,370 --> 00:06:11,010
اللِّقاء غداً أمام المحطّة بنفس الموعد السابق، اتفقنا؟

75
00:06:11,110 --> 00:06:11,970
حاضر

76
00:06:12,070 --> 00:06:14,020
واخلدوا إلى النوم باكراً الليلة

77
00:06:14,120 --> 00:06:15,040
حاضر

78
00:06:15,140 --> 00:06:17,080
وفرِّشوا أسنانكم

79
00:06:18,010 --> 00:06:20,730
سينباي، تِلك النكتة قديمة

80
00:06:20,830 --> 00:06:22,570
حسناً، توخّوا الحذر في طريق عودتكم

81
00:06:22,670 --> 00:06:25,080
بورِك عملك اليوم

82
00:06:26,840 --> 00:06:29,340
انتهى اليوم الأوّل أخيراً

83
00:06:29,440 --> 00:06:31,260
ما زال الطريقُ أمامنا طويلاً

84
00:06:31,360 --> 00:06:36,680
لكنني مسرورة، لم يتوتّر أحدٌ
كما توقّعتُ أن يحدث

85
00:06:36,780 --> 00:06:41,850
تعلمين بأنني سأتقوقع في زاوية غرفتي
بالوضعيّة الجنينيّة

86
00:06:41,950 --> 00:06:43,380
عاجِزة عن النّوم طوال اللّيل

87
00:06:43,480 --> 00:06:46,890
هذا ليسَ ما سمِعتُه منكِ في هذا الصباح

88
00:06:46,990 --> 00:06:52,660
لا يجوز أن تُبرِز الرئيسة ضعفَها
قبل بِداية المعركة كما تعلمين

89
00:06:53,470 --> 00:06:56,230
يسرُّني سماع ذلك منكِ حقاً

90
00:06:56,330 --> 00:06:59,090
بما أنّ ذلك يعني أن بمقدوركِ
أن تكوني صادِقة مع نفسكِ عندَ الحديث معي

91
00:06:59,190 --> 00:07:01,700
...ماذا تقولين؟ تبّاً

92
00:07:01,800 --> 00:07:03,000
أمزح فقط

93
00:07:04,060 --> 00:07:08,110
بصِفتي في السنة الثالثة، فهذه فُرصتي الأولى
والوحيدة للمُشاركة في البطولة الوطنيّة

94
00:07:08,640 --> 00:07:11,630
لِمَ لا ينبغي أن أكون أقل توتُّراً
قبل النِّهائيات؟

95
00:07:14,190 --> 00:07:15,110
ماذا؟

96
00:07:15,210 --> 00:07:19,600
لماذا لم تشتركي في أي بطولة
قبلَ أن تصبحي في سنتكِ الثالثة؟

97
00:07:19,700 --> 00:07:21,800
حتّى لو لم يكن لديكِ ما يكفي من أشخاص
للمُشاركة في بطولة الفريق

98
00:07:21,900 --> 00:07:23,770
بمقدوركِ المُشاركة في الشقّ الفردي

99
00:07:23,870 --> 00:07:27,450
أنا متأكِّدة أن بمقدوركِ السَّعي للحصول على
البطولة الوطنيّة بمفردكِ

100
00:07:28,720 --> 00:07:30,920
...أظنُّه حلماً

101
00:07:31,020 --> 00:07:32,310
حلم؟

102
00:07:32,410 --> 00:07:38,130
،عندما كنتُ في السنة الأولى
لم يكن في نادي الماجونغ سوايّ

103
00:07:39,680 --> 00:07:46,040
وعندما أمسكتُ بالقراميد بمُفردي
شعرتُ نفسي وكأنني أحلم

104
00:07:46,780 --> 00:07:49,800
،بانضمامِ عشرات الأعضاء للنادي يوماً ما

105
00:07:49,900 --> 00:07:51,780
،وأن تملأ أصوات ضحكهم الغرفة

106
00:07:51,880 --> 00:07:56,000
وأن نُشارِك في بطولة فرق بين المدارس
الثانويّة المحلّية

107
00:07:56,100 --> 00:07:59,550
ثمّ بعدَ عام، انضمَّتْ عضوة واحدة للنادي

108
00:08:00,740 --> 00:08:06,750
لم تكن غاضبة من عدم مُمارسة النادي
لأي نشاطات، ولم تستسلم أو تعتزل

109
00:08:06,850 --> 00:08:10,590
...ثمّ قلتُ لنفسي لعلَّ وعسى

110
00:08:12,020 --> 00:08:18,500
إذا انضمّت مزيدٌ من الفتياتِ مثلها في العام المقبل
فلعلَّ وعسى نستطيع جميعاً المُشاركة حينئذ

111
00:08:22,550 --> 00:08:23,980
ماكو؟

112
00:08:24,080 --> 00:08:25,260
ما الأمر؟

113
00:08:25,800 --> 00:08:27,080
...كان

114
00:08:27,780 --> 00:08:29,150
كان بسببي؟

115
00:08:29,250 --> 00:08:33,240
هذا صحيح، تحقّقَ حلمي بفضلكِ

116
00:08:33,340 --> 00:08:35,790
ألم يكن رهاناً سيّئاً جداً

117
00:08:35,890 --> 00:08:42,210
أعني بأنّ احتمالات الحصول على ثلاثة
عضوات جديدات للنادي لهذا العام كانتْ شبه معدومة

118
00:08:42,310 --> 00:08:43,760
معكِ حق

119
00:08:44,460 --> 00:08:51,840
ولكن تعلمين بأنني أكون في أفضل حالاتي
عندما أختار الانتظار باحتمالات فظيعة

120
00:08:52,850 --> 00:08:54,410
!عجباً

121
00:08:54,510 --> 00:08:56,730
لا أعلم حقاً ماذا أفعل معكِ

122
00:08:56,830 --> 00:08:59,450
أظنني سأستمرُّ في مُرافقتكِ لمدّة قصيرة فحسب

123
00:08:59,990 --> 00:09:04,120
ما زالَ الطريقُ أمامنا طويلاً حتّى
نربح البطولة الوطنية

124
00:09:04,870 --> 00:09:06,180
هل أنتِ جادّة؟

125
00:09:06,280 --> 00:09:07,740
بالطبع

126
00:09:07,840 --> 00:09:10,010
...سنظلُّ نمضي للأمام

127
00:09:11,730 --> 00:09:13,710
...سويةً

128
00:09:14,880 --> 00:09:17,070
برفقة الجميع

129
00:09:30,000 --> 00:09:32,320
هل أنتَ بخير يا كيو-تشان؟

130
00:09:32,420 --> 00:09:34,630
ما الأمر؟

131
00:09:36,610 --> 00:09:38,230
هل تسمعين شيئاً؟

132
00:09:38,330 --> 00:09:39,180
هدوء

133
00:09:42,470 --> 00:09:46,630
ضفادع، إنها قابلة للأكل أيضاً

134
00:09:47,140 --> 00:09:49,090
ستأكلينها؟

135
00:09:52,910 --> 00:09:54,460
!يا لجمالها

136
00:09:58,250 --> 00:09:59,990
...بالفعل

137
00:10:01,110 --> 00:10:03,210
،هذا نجمُ النسر الواقع
جزء من كوكبة القيثارة

138
00:10:03,310 --> 00:10:10,050
والنّجم المُشعّ في الناحية الأخرى من درب التبّانة
هو النسر الطائر من كوكبة العقاب

139
00:10:10,410 --> 00:10:13,300
والنجم المتألِّق بينهما وفوقهما بقليل

140
00:10:13,400 --> 00:10:17,510
في وسط درب التبّانة، هو ذنب الدجاجة من كوكبة الإوزّ

141
00:10:17,810 --> 00:10:21,840
،بربطِ هذه النجوم الثلاثة
يُصبِح لدينا ما يُدعى بمُثلّث الصيف

142
00:10:21,940 --> 00:10:24,550
إنِّي أراه، إنِّي أراه

143
00:10:25,470 --> 00:10:29,180
الإوزّ يُدعى أيضاً بالصليب الشمالي

144
00:10:30,430 --> 00:10:31,990
قرأتُ عن ذلك

145
00:10:32,090 --> 00:10:35,170
هل كان في "ليلة في السكّة المجرّية"؟

146
00:10:35,270 --> 00:10:36,180
أجل

147
00:10:36,280 --> 00:10:37,810
قرأتُ ذلك أيضاً

148
00:10:37,910 --> 00:10:40,350
...لقد قرأتِه أيضاً إذاً يا هارامورا-سان

149
00:10:43,260 --> 00:10:48,720
النّسر الواقِع والنسر الطائر هُما أيضاً
أوريهيمي وهيكوبوشي

150
00:10:48,820 --> 00:10:50,770
أوريهيمي وهيكوبوشي

151
00:10:50,870 --> 00:10:53,920
هاتان هُما إذاً

152
00:10:57,860 --> 00:10:59,300
...إذاً نودوكا هي أوريهيمي

153
00:11:00,330 --> 00:11:02,400
...جميلة

154
00:11:02,500 --> 00:11:04,500
وأنا هيكوبوشي

155
00:11:06,050 --> 00:11:07,310
فهمت

156
00:11:07,410 --> 00:11:11,170
أنا أوريهيمي وكيوتارو هو هيكوبوشي، صحيح؟

157
00:11:11,650 --> 00:11:13,280
مخطئة

158
00:11:15,390 --> 00:11:17,960
حسناً إذاً يا جماعة، إلى اللقاء

159
00:11:18,060 --> 00:11:20,920
كيو-تشان، احرصي على إيصالِ يوكي-تشان
إلى المنزل بأمان، حسناً؟

160
00:11:21,020 --> 00:11:22,520
نعم، أكيد

161
00:11:22,620 --> 00:11:24,140
أستستفيدُ منِّي على الطريق؟

162
00:11:24,240 --> 00:11:26,520
!ما الفائدة التي قد أجنيها منكِ بالضبط؟

163
00:11:26,620 --> 00:11:28,920
لا داعي للخجل يا كيوتارو

164
00:11:29,020 --> 00:11:30,720
كلّ ما يمكنني فعله هو ردعكِ

165
00:11:34,330 --> 00:11:38,120
إذاً أنتِ ويوكي-تشان كنتُما في المدرسة
الإعدادية معاً، أليس كذلك يا هارامورا-سان؟

166
00:11:38,220 --> 00:11:38,790
نعم

167
00:11:39,120 --> 00:11:42,230
ثمّ ذهبتُما إلى البطولة الوطنيّة سوية؟

168
00:11:42,330 --> 00:11:43,260
لا

169
00:11:43,360 --> 00:11:46,850
خسِرنا في مُباراتنا الأولى في بطولة الفرق
،وذلك في التصفيات الإقليميّة

170
00:11:46,950 --> 00:11:50,650
وكنتُ الوحيدة القادرة على التأهُّل للبطولة
الوطنيّة للأفراد

171
00:11:52,570 --> 00:12:01,690
إلى أن نُقِلتُ إلى المدرسةِ الإعداديّة التي هُنا
في عامي الثاني، لم أكن بارِعة إلَّا في لعِب الماجونغ عبرَ الإنترنت

172
00:12:03,240 --> 00:12:06,340
لطالما أحببتُ الماجونغ مُذ كنتُ صغيرة

173
00:12:06,440 --> 00:12:09,970
ولكن تحتاجين لأربعة أشخاص للعبِ الماجونغ

174
00:12:10,070 --> 00:12:16,510
وتحتاجين أيضاً لأشخاص يعرفون القواعد
التي تُبقيهم في ذات المكان في نفس الوقت

175
00:12:16,610 --> 00:12:20,860
،لستِ بحاجة للقلقِ حول هذه الأمور في الإنترنت

176
00:12:20,960 --> 00:12:25,820
لهذا كانت الماجونغ دائماً
لعبة ألعبُها بمُفردي عبر الإنترنت

177
00:12:28,830 --> 00:12:34,640
...ولكن في ربيع عامي الثاني وبعد أن التقيتُ بيوكي

178
00:12:39,900 --> 00:12:41,370
آسفة

179
00:12:45,470 --> 00:12:47,130
لا عليكِ

180
00:12:47,760 --> 00:12:52,020
سُرعان ما تعرّفتُ على عدد قليل من الأصدقاء

181
00:12:52,120 --> 00:12:58,280
وبدأتُ ألعبُ الماجونغ مع الآخرين
أكثر مما لعِبت عبرَ الإنترنت

182
00:12:59,660 --> 00:13:04,840
وعندما ترفّعنا للسنة الثالثة، شاركنا نحنُ الخمسة
في البطولة للمرّة الأولى

183
00:13:04,840 --> 00:13:12,090
ربِحتُ الشقَّ الفردي من التصفيات الإقليميّة
وتأهّلتُ للمُشاركة في البطولة الوطنيّة

184
00:13:12,190 --> 00:13:18,300
ولكن ما أردتُه حقاً آنذاك هو أن يتمكّن
الجميع من المُشاركة

185
00:13:18,400 --> 00:13:20,090
...أن أكون مع أصدقائي

186
00:13:26,660 --> 00:13:28,030
هارامورا-سان

187
00:13:33,220 --> 00:13:34,700
لنفعلها

188
00:13:35,360 --> 00:13:37,080
لنفعلها غداً، اتفقنا؟

189
00:13:37,410 --> 00:13:41,960
سنربحُ غداً ومن ثمّ سنتأهّلُ جميعاً إلى البطولة الوطنيّة

190
00:13:44,950 --> 00:13:46,530
!بالطبع

191
00:13:46,630 --> 00:13:49,400
قطَعنا وعداً سابقاً، أتذكرين؟

192
00:13:49,860 --> 00:13:51,660
أجل، قطَعنا وعداً، أليس كذلك؟

193
00:13:51,760 --> 00:13:54,040
"لنذهب إلى البطولة الوطنيّة سوية"

194
00:13:54,140 --> 00:13:55,020
نعم

195
00:13:59,080 --> 00:14:00,480
إلى البطولة الوطنيّة

196
00:14:09,460 --> 00:14:11,150
إلى البطولة الوطنيّة

197
00:14:16,940 --> 00:14:20,570
هذه... يراعات؟

198
00:14:23,670 --> 00:14:27,670
رائع، هنالِك الكثير منها

199
00:14:31,530 --> 00:14:35,430
تحيطُ بنا اليراعات من كُل صوب

200
00:14:39,730 --> 00:14:41,430
كان حمّاماً لطيفاً

201
00:14:41,780 --> 00:14:44,810
الاستحمام في حمّاماتٍ كبيرة منعش للغاية

202
00:14:44,910 --> 00:14:46,960
ماذا؟ إلى أين ذهبَت الكابتن؟

203
00:14:47,060 --> 00:14:49,380
عادَتْ إلى الغرفة فوراً

204
00:14:49,480 --> 00:14:52,490
قالَتْ بأنها تريدُ التحضير لمباراةِ الغد

205
00:14:52,790 --> 00:14:56,490
كنتُ أتمنّى لو أنها تلقي علينا خِطاباً
لشحذ الهمم أو ما شابه

206
00:14:56,790 --> 00:15:02,010
كلّ ما ينبغي عليكِ إدراكه هو أنّ الكابتن
ليسَتْ من الأشخاص الذين يفعلون شيئاً كهذا الآن

207
00:15:02,710 --> 00:15:05,340
إنها رقيقة جداً مع الناس

208
00:15:05,440 --> 00:15:12,240
حتّى العام الماضي، كانتْ لاعِبات السنة الأولى الأدنى رتبة
تؤدِّين كافّة الأعمال الحرّة والرتيبة لنادي الماجونغ

209
00:15:12,340 --> 00:15:16,300
ولكن هل تذكرُنَ من كان ينظِّف غرفة النادي دوماً؟

210
00:15:17,640 --> 00:15:19,310
الكابتن

211
00:15:19,700 --> 00:15:22,930
ومن كان يخرج لإحضار الطعام ويطبخ في معسكر التدريب؟

212
00:15:23,240 --> 00:15:24,520
الكابتن

213
00:15:24,620 --> 00:15:27,910
من كان يغسلُ ملابسَ وشراشِف الجميع؟

214
00:15:28,010 --> 00:15:29,750
الكابتن

215
00:15:29,850 --> 00:15:33,820
...سمعتُ هذا من الكابتن ذات يوم

216
00:15:34,290 --> 00:15:37,450
من فضلك، اسمحي لي بتولِّي مثل هذه الأعمال

217
00:15:37,790 --> 00:15:39,860
هذه أنتِ

218
00:15:39,960 --> 00:15:44,040
...قد لا تعلمين من أكون يا كابتن، لكن ترتيبي

219
00:15:44,140 --> 00:15:45,730
78

220
00:15:45,830 --> 00:15:50,650
الترتيب 78 في المدرسة
سنة أولى، بوندو-سان، صحيح؟

221
00:15:51,840 --> 00:15:55,680
كانتْ نقلة "توي توي سانانكو" خاصّتكِ
في الأسبوع الماضي مُذهلة

222
00:15:56,520 --> 00:16:02,110
بما أنّكِ تعلمين ذلك فيجدرُ بكِ أن تعلمي أيضاً بأنه من الغريب
أن تؤدِّي كابتن بأفضل رتبة أعمالاً كهذه

223
00:16:02,210 --> 00:16:05,020
أنا طالبة سنة ثالثة

224
00:16:06,290 --> 00:16:10,690
لهذا ستكونُ بطولة المدارس الثانويّة
المحلِّية هذه الأخيرة لي

225
00:16:10,790 --> 00:16:14,290
إذا خسِرنا خلالَ تصفيات الإقليم في يونيو، ستكونُ النهاية

226
00:16:14,390 --> 00:16:17,260
...إذاً لمُساعدتكِ في الفوز في تصفيات الإقليم، ينبغي عليّ

227
00:16:17,360 --> 00:16:19,100
يمكنُكِ مساعدتي

228
00:16:19,200 --> 00:16:23,040
جُلّ ما عليكِ هو أن تتحسّني فحسب يا بوندو-سان

229
00:16:23,410 --> 00:16:25,860
حتّى لو كان ترتيبي 78؟

230
00:16:25,960 --> 00:16:26,880
بالطبع

231
00:16:27,180 --> 00:16:32,210
ألا تعتقدين بأن وقت قيادتكِ لكازيكوشي
سيحين يوماً ما؟

232
00:16:33,780 --> 00:16:38,040
أريدُ أن يلمسَ الجميعُ القراميد

233
00:16:38,140 --> 00:16:44,610
كونكِ عضواً في نادي الماجونغ لمدرسة كازيكوشي
أريدُكِ أن تستمتعي أكثر فأكثر في لعِبِ الماجونغ

234
00:16:46,690 --> 00:16:48,870
هذا هو طبعُها

235
00:16:48,970 --> 00:16:53,210
وهي تحمينا من المدرِّبة عندما نرتكبُ أخطاء

236
00:16:53,310 --> 00:16:58,950
تمنحُنا وقتاً للعب حتّى لو على حسابِها

237
00:16:59,290 --> 00:17:01,850
بالرّغمِ من عشقِها للماجونغ

238
00:17:02,900 --> 00:17:06,370
كلّ السبب هو لأننا جبانات

239
00:17:07,210 --> 00:17:13,960
إن خسِرنا المباراة غداً، فستكونُ المُباراة الأخيرة
لقائدتنا كونها ستتخرّج بعد ذلك

240
00:17:16,450 --> 00:17:17,920
علينا أن نفوز

241
00:17:18,590 --> 00:17:21,340
سنفوز ونتأهّل للبطولة الوطنيّة

242
00:17:21,340 --> 00:17:24,640
سنفوز ونجعل بطولة المدارس الثانويّة المحلّية
شيئاً تتمتّع به الكابتن

243
00:17:30,990 --> 00:17:35,150
كابتن

244
00:17:39,070 --> 00:17:40,560
كابتن

245
00:17:40,560 --> 00:17:42,740
لا

246
00:17:43,520 --> 00:17:45,250
هاجَتِ الحواسيب

247
00:17:46,050 --> 00:17:50,400
...كيف حدثَ هذا يا فتيات، أنا

248
00:17:51,960 --> 00:17:54,540
كابتن، ألمستِ حاسوباً؟

249
00:17:54,640 --> 00:17:58,170
في الواقع، كنتُ أحاول الاطّلاع على سجلّات
...خصومنا غداً، و

250
00:17:58,270 --> 00:18:01,530
كيف عبثتِ بالحواسيب إلى هذا الحدّ
من مجرّد مُحاولة الاطّلاع على السجلّات؟

251
00:18:01,630 --> 00:18:02,970
ماذا فعلتِ بهم؟

252
00:18:03,070 --> 00:18:05,210
أظنُّنا علينا قطع الكهرباء

253
00:18:05,820 --> 00:18:07,780
...حتّى الكمبيوترات الأخرى الموصولة عبر الشبكة

254
00:18:07,880 --> 00:18:09,270
هنا أيضاً

255
00:18:09,370 --> 00:18:10,300
خُرِّبَتْ كلّها

256
00:18:10,400 --> 00:18:11,960
لا جدوى، لا أستطيع إيقافها

257
00:18:12,060 --> 00:18:14,710
أنا آسفة

258
00:18:20,970 --> 00:18:22,220
تأخّرَتْ

259
00:18:22,320 --> 00:18:25,040
اهدئي يا توكا

260
00:18:25,140 --> 00:18:26,800
المعذرة

261
00:18:27,290 --> 00:18:29,210
تأخرتِ

262
00:18:29,310 --> 00:18:31,500
أعتذرُ يا أوجو-ساما

263
00:18:31,600 --> 00:18:33,840
حسناً، أبلغينا

264
00:18:33,940 --> 00:18:36,160
...يبدو

265
00:18:36,260 --> 00:18:41,640
بأنّ كورومو-ساما قد قضَتْ كلّ يومها
نائمة في غرفتها

266
00:18:42,340 --> 00:18:44,250
!بِئساً

267
00:18:44,350 --> 00:18:45,720
كما توقعنا تماماً

268
00:18:45,820 --> 00:18:48,960
ساعات المنبِّه التي عيّرناها أثبتَتْ فشلها

269
00:18:51,610 --> 00:18:53,780
أظنُّني لا أملك خياراً إذاً

270
00:18:54,500 --> 00:18:55,780
هاغيوشي

271
00:18:56,630 --> 00:18:58,650
هل استدعيتِني، توكا-أوجوساما؟

272
00:18:58,960 --> 00:19:01,590
ستُرافِق كورومو غداً

273
00:19:01,690 --> 00:19:05,140
احرص على إحضارها قبلَ أن يحين
دورُها في النّهائي

274
00:19:05,730 --> 00:19:07,390
أمركِ

275
00:19:09,920 --> 00:19:14,830
يا إلهي، ألم تكن كورومو التي وعدتُها
بأن آخذها إلى طوكيو مجدداً في هذا العام؟

276
00:19:15,130 --> 00:19:17,350
!يا لها من كثيرة النسيان

277
00:19:17,450 --> 00:19:19,940
تُعاني كورومو من خلل في ذاكرتها

278
00:19:20,040 --> 00:19:21,330
لأنها مجرّد طفلة

279
00:19:21,430 --> 00:19:24,370
كورومو في مثل سنّنا كما تعلمين

280
00:19:25,300 --> 00:19:32,120
أيومو، إن لم تأتِ كورومو غداً، فأنتِ مضطرّة
لِلّعب مكانها

281
00:19:33,770 --> 00:19:36,980
اعفيني أرجوكِ

282
00:19:42,930 --> 00:19:45,200
خصوم الغد أقوياء

283
00:19:45,930 --> 00:19:48,830
قد تكون معركة صعبة بالنسبةِ لنا نحن
أكاديميّة تسوروغا

284
00:19:50,100 --> 00:19:54,060
لا داعي للقلق، لن أستسلم

285
00:19:54,160 --> 00:19:58,920
إن تمكنّا من الصمود خلال المعركة الشرِسة
...في النصف الأول، وبلغنا النصف الثاني

286
00:20:01,060 --> 00:20:04,920
ثمّ ستُحسَمُ مُباراة الغد بواسطة
لاعِبة الفوكوشو ولاعِبة التايشو

287
00:20:15,990 --> 00:20:18,420
المعركة غداً

288
00:20:21,870 --> 00:20:25,520
المعركة غداً

289
00:20:31,720 --> 00:20:34,870
...سواء بدموع فرح أو حزن، غداً

290
00:20:37,920 --> 00:20:39,130
غداً النّهائي

291
00:20:40,420 --> 00:20:42,130
اربحي وتأهّلي للبطولة الوطنيّة

292
00:20:43,480 --> 00:20:45,170
...اخسري و

293
00:21:03,820 --> 00:21:05,710
أنا مُنهَكة

294
00:21:07,110 --> 00:21:08,070
...لكن

295
00:21:12,800 --> 00:21:14,880
...كان ذلك ممتعاً بحقّ

296
00:21:33,950 --> 00:21:35,740
هارامورا-سان

297
00:21:40,250 --> 00:21:42,160
صباح الخير يا هارامورا-سان

298
00:21:42,260 --> 00:21:43,880
صباح النّور

299
00:21:43,980 --> 00:21:44,900
هيّا بنا

300
00:21:45,000 --> 00:21:45,530
بالتأكيد

301
00:21:52,130 --> 00:21:53,400
يبدو بأنَّ الجميع حاضِرات

302
00:21:53,500 --> 00:21:54,660
نعم

303
00:21:54,760 --> 00:21:59,040
والآن سنشقُّ طريقنا إلى البطولة الوطنيّة

304
00:21:59,140 --> 00:22:00,400
نعم