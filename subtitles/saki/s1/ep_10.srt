1
00:00:03,080 --> 00:00:04,230
!لحظة

2
00:00:12,160 --> 00:00:14,060
تمكّنا من اللّحاقِ بالقطار بصعوبة

3
00:00:14,160 --> 00:00:17,280
سنستطيع مشاهدة مباراة نودوكا-سينباي

4
00:00:19,910 --> 00:00:21,790
...انتظري يا ماهو

5
00:00:22,340 --> 00:00:23,900
ما الأمر؟

6
00:00:24,000 --> 00:00:26,320
أليسَتْ هذه الجهة المُعاكِسة لجهتِنا؟

7
00:00:28,280 --> 00:00:29,130
!ماذا؟

8
00:00:31,760 --> 00:00:34,970
انتظروا، توقّفوا

9
00:02:08,900 --> 00:02:10,510
كابتن

10
00:02:10,610 --> 00:02:12,720
أحسنتِ صنعاً

11
00:02:12,820 --> 00:02:15,400
دمّرتِ ريومونبوتشي كلّياً

12
00:02:15,500 --> 00:02:16,810
شكراً لكُن

13
00:02:16,910 --> 00:02:19,970
عمل جيّد، عمل جيّد

14
00:02:20,070 --> 00:02:21,660
شكراً جزيلاً لكِ

15
00:02:22,360 --> 00:02:25,530
يا فتيات... بقيَتْ ثمانية هانتشان

16
00:02:25,630 --> 00:02:28,220
تمتَّعن باللعب كالمُعتاد فحسب
وسنكون بخير

17
00:02:28,320 --> 00:02:33,240
حتّى لو واجَهنا مثلاً الشيطانة
آماي كورومو من ريومونبوتشي

18
00:02:33,340 --> 00:02:36,340
سنربحُ في النهاية

19
00:02:36,440 --> 00:02:38,830
كابتن، خذي هذه

20
00:02:38,930 --> 00:02:40,240
ما هذه؟

21
00:02:40,340 --> 00:02:43,570
إنّها سجلّات مُباريات كيوسومي وتسوروغا البارحة

22
00:02:43,670 --> 00:02:48,800
لم أجد إلّا سجلّات هارامورا نودوكا فقط
عندما بحثتُ عبر الإنترنت

23
00:02:48,900 --> 00:02:54,140
ولكن بمُساعدة بعض الأعضاء غير النظاميين
نسخناها من شريط الفيديو

24
00:02:54,240 --> 00:02:56,510
...عرَفت، إن كان بمقدورنا تقديم بعض المساعدة فإذاً

25
00:02:57,310 --> 00:02:59,410
هل سهرتُنّ الليل كلّه على ذلك؟

26
00:02:59,920 --> 00:03:00,910
...شكراً لكُن

27
00:03:01,620 --> 00:03:04,370
كثيرة البُكاء كعادتها

28
00:03:01,770 --> 00:03:05,040
أنا آسفة، كان ينبغي أن أفعل شيئاً كهذا بنفسي

29
00:03:04,470 --> 00:03:07,320
كلّنا نعلمُ مدى جهلكِ في التعامل
مع الأجهزة يا كابتن

30
00:03:05,140 --> 00:03:10,320
كنتُ أنوي القيام بهذا في الليلة الماضية
أنا آسفة... حقاً

31
00:03:07,420 --> 00:03:10,320
...أفضِّلُ حتماً ألّا تلمسيها، لِذا

32
00:03:13,370 --> 00:03:18,850
كنتُ أسحقهن في النصف الأوّل
ولكن تِلك المرأة تستفزُّني حقاً

33
00:03:18,850 --> 00:03:23,660
اهدئي... تِلك الفتاة من كازيكوشي كانَتْ
قويّة جداً في العام الماضي أيضاً

34
00:03:23,660 --> 00:03:27,840
استغلّت اللاعبتَين الأُخرتَين لإبقاء توكا
تحت السيطرة حتّى بحظِّها الشيطاني

35
00:03:27,940 --> 00:03:30,660
كوني رجلاً واعترفي بالهزيمة

36
00:03:30,760 --> 00:03:32,610
أنا امرأة

37
00:03:34,190 --> 00:03:36,510
ولكن استمتعتُ بها حقاً

38
00:03:37,620 --> 00:03:40,050
أريدُ أن ألعب ضدّها مجدداً

39
00:03:45,120 --> 00:03:46,880
نعسانة؟

40
00:03:48,020 --> 00:03:52,000
لم نستيقظ باكراً في هذا الصباح فحسب
بل لم أنم جيّداً في الليلة الماضية أيضاً

41
00:03:53,100 --> 00:03:55,090
هذه مُشكلة إذاً

42
00:03:55,190 --> 00:04:00,440
بقي أكثر من سبع ساعات على بدء ساكي باللّعب
...وخمس ساعاتٍ حتّى يحين دوركِ يا نودوكا

43
00:04:00,540 --> 00:04:03,040
ما رأيكما أن تناما في غرفة القيلولة؟

44
00:04:04,110 --> 00:04:09,410
ولكن لن نرضى بالنّومِ بديلاً
لتشجيعكِ والهتاف لكِ

45
00:04:09,510 --> 00:04:14,080
سيكونُ نُعاسكما وتقديم أداء ضعيف أسوأ
من عدم تشجيعكما لي

46
00:04:14,180 --> 00:04:15,730
نعم، أوافقكِ الرأي

47
00:04:20,120 --> 00:04:22,330
ها أنا ذي

48
00:04:22,430 --> 00:04:24,370
لقد عدتُ الآن

49
00:04:25,240 --> 00:04:26,330
أهلاً بعودتكِ

50
00:04:26,430 --> 00:04:27,620
بذلتِ قصارى جهدكِ

51
00:04:34,840 --> 00:04:37,460
مياناغا-سان، لنذهب إلى غرفة القيلولة

52
00:04:45,500 --> 00:04:48,260
اللاعبة المستهلّة لريومونبوتشي والورقة
...الرابحة لكازيكوشي

53
00:04:48,360 --> 00:04:51,180
قدّمتِ أداءً جيّداً أمامهن بحلولكِ في المركز الثاني

54
00:04:51,280 --> 00:04:54,440
أدّيتِ أفضل مما توقّعتُ أن تؤدّي

55
00:04:59,310 --> 00:05:01,290
سننتقمُ منهن

56
00:05:02,700 --> 00:05:06,650
هارامورا-سان، ظننتُ أنكِ لا تُريدين الذهاب
إلى غرفة القيلولة؟

57
00:05:06,750 --> 00:05:13,370
يوكي فتاة قويّة، لذا لا أظنُّها سترضى بالبُكاء
أمام فتيات في سنّها مثيلاتنا

58
00:05:14,250 --> 00:05:19,150
إن غادرنا الغرفة، لن يُغادِر
إلّا الزملاء في السنة الأخيرة

59
00:05:19,250 --> 00:05:21,510
فهمت، معكِ حقّ

60
00:05:23,000 --> 00:05:24,300
...لكن

61
00:05:27,360 --> 00:05:30,310
ينتابُني إحساسٌ بأننا نسينا شيئاً

62
00:05:30,880 --> 00:05:34,990
نعم، أنا ساعي النّادي فحسب

63
00:05:37,230 --> 00:05:40,170
الجولة الثانية من النّهائيات
ستبدأ عمّا قريب

64
00:05:40,270 --> 00:05:41,640
ستبدأ

65
00:05:41,740 --> 00:05:43,960
حسناً، هل بمقدورها تولّي زمام القيادة؟

66
00:05:44,060 --> 00:05:46,510
من كازيكوشي للإناث سنة ثانية، يوشيتومي ميهارو

67
00:05:46,610 --> 00:05:48,500
بالتوفيق يا ميهارون

68
00:05:48,600 --> 00:05:49,930
هل بمقدورها أن تنهض بقوّة؟

69
00:05:50,030 --> 00:05:52,630
من أكاديميّة تسوروغا سنة ثانية، سينو كاوري

70
00:05:52,730 --> 00:05:54,290
لا تدفعيني

71
00:05:55,080 --> 00:05:56,600
...من أبطال السنة الماضية

72
00:05:56,700 --> 00:05:59,970
ثانويّة ريومونبوتشي سنة ثانية، ساوامورا توموكي

73
00:06:01,970 --> 00:06:05,150
ثانويّة كيوسومي سنة ثانية، سوميا ماكو

74
00:06:05,250 --> 00:06:07,610
أظنُّني عليّ أن أتحرّك

75
00:06:07,710 --> 00:06:10,380
ستبدأ المباراة عما قريب

76
00:06:11,360 --> 00:06:14,590
الشراشف نظيفة، والفراش منفوش وناعم

77
00:06:15,370 --> 00:06:16,550
!بالفعل

78
00:06:19,870 --> 00:06:21,490
أما من أحد هنا؟

79
00:06:21,760 --> 00:06:25,270
نعم، هنالِك مساحة كبيرة، ولكن لا يوجدُ سوانا

80
00:06:25,370 --> 00:06:27,580
...نـ..نعم

81
00:06:28,180 --> 00:06:31,330
هذه هي المرة الأولى التي ننامُ فيها سويةً
بعدَ مُعسكر التدريب

82
00:06:31,530 --> 00:06:36,750
لم أتوقَّع أن ننسجمَ جيّداً معاً
بهذا الشكل آنذاك

83
00:06:36,850 --> 00:06:38,060
آنذاك؟

84
00:06:38,160 --> 00:06:42,060
أتذكرين عندما انضممتُ لنادي
الماجونغ أول مرّة؟

85
00:06:42,160 --> 00:06:46,450
طلبتِ منِّي ترك النادي يا هارامورا-سان

86
00:06:46,870 --> 00:06:49,560
أرجوكِ، انسي ذلك فحسب

87
00:06:56,830 --> 00:06:59,610
عندما نستيقظ، سيحينُ دورنا

88
00:07:00,980 --> 00:07:02,070
نعم

89
00:07:02,540 --> 00:07:04,300
سنربح حتماً

90
00:07:04,400 --> 00:07:07,820
نعم، سنربح ونذهب
إلى البطولة الوطنيّة

91
00:07:10,440 --> 00:07:13,040
والآن اجتمعت اللّاعبات الأربعة على الطاولة

92
00:07:13,040 --> 00:07:16,340
الجولة الثانية من النّهائي
على وشك أن تبدأ

93
00:07:17,040 --> 00:07:19,530
كلّهن يرتدين النظّارة

94
00:07:19,630 --> 00:07:22,660
بالطبع، فهي بطولة لنادٍ يميلُ
أكثر للجانب الثقافي

95
00:07:22,760 --> 00:07:26,510
ولكن إحداهنّ ستخسرُ نظّارتها قريباً

96
00:07:27,220 --> 00:07:29,640
والآن، تبدأ اللعبة

97
00:07:42,620 --> 00:07:46,030
لماذا خلعَتْ سوميا-سينباي نظّارتها؟

98
00:07:46,130 --> 00:07:48,490
لن تتمكّن من رؤية القراميد

99
00:07:48,590 --> 00:07:53,460
إذا غمزَتْ تستطيعُ رُؤية ما يطرحه خصومها

100
00:07:53,560 --> 00:07:56,420
هل تعرفين شيئاً عن مكان إقامة ماكو؟

101
00:07:56,520 --> 00:08:00,400
بلى، تقيمُ في مقهى خادمات يحتوي
على طاولة ماجونغ

102
00:08:00,500 --> 00:08:05,200
إنه كذلك في الوقت الحاضر، لكنّه كان
صالة ماجونغ قبلَ أن يتحوّل إلى مقهى

103
00:08:05,680 --> 00:08:10,050
كان جدّ ماكو يدير صالة ماجونغ

104
00:08:10,650 --> 00:08:15,640
كانَتْ ماكو حفيدته ولِهذا كانَتْ مُحاطة
بالماجونغ مُذ كانَتْ صغيرة

105
00:08:16,700 --> 00:08:22,020
ويعلقُ في ذهن ماكو صورة مُعظم
المُباريات التي شاهدَتْها

106
00:08:22,540 --> 00:08:25,190
إذا خلعَتْ نظّارتها وتشوّشَ العالمُ حولها

107
00:08:25,290 --> 00:08:30,610
بمقدورها أن تستذكر مشاهداً من الماضي
شبيهة بالمشهد الرّاهن على الطاولة

108
00:08:31,280 --> 00:08:34,440
لا أصدِّق أنها تستطيع فعل شيء كهذا

109
00:08:34,540 --> 00:08:38,250
نعم... نودوكا تنكرُ ذلك تماماً

110
00:08:40,460 --> 00:08:41,590
رييتشي

111
00:08:42,640 --> 00:08:45,030
كازيكوشي للإناث، تُنادي برييتشي الأولى

112
00:08:45,130 --> 00:08:48,410
هل سيستمرُّ نجاحُهم المُفاجئ من الجولة الأولى؟

113
00:08:48,510 --> 00:08:49,970
قرميد خيزران 2

114
00:08:53,760 --> 00:08:55,610
كأنّها لُعبة بين أصابعها، أليس كذلك؟

115
00:08:55,710 --> 00:08:57,540
"لو كنتُ مكانها لـ"تخلّيت

116
00:08:57,640 --> 00:08:59,410
ولكن ما الذي ستفعلُه هي يا تُرى؟

117
00:09:00,520 --> 00:09:02,950
لقد شهدتُ أوضاعاً كهذه من قبل

118
00:09:08,280 --> 00:09:09,710
لقد "تخلّتْ" إذاً

119
00:09:09,810 --> 00:09:14,580
هذا الابتعادُ عن حالة "التينباي" وحصر يدكِ
لا مكان له في النّهائيات

120
00:09:19,500 --> 00:09:21,170
لستُ بحاجةٍ إلى هذه

121
00:09:23,460 --> 00:09:25,960
!ما هذا؟

122
00:09:26,340 --> 00:09:27,340
رون

123
00:09:28,430 --> 00:09:32,820
من دون دورا، رييتشي، إيبّاتسو، تنّين أحمر "تشون"، 5200

124
00:09:32,920 --> 00:09:36,330
طرح قرميد التنّين الأحمر الأوّل بيد 2 شان تين
...أثناء الدور الذي أعلنَ فيه شخصٌ عن رييتشي

125
00:09:36,430 --> 00:09:38,640
في ذلك مُجازفة كبيرة

126
00:09:38,740 --> 00:09:40,790
إنها مُبتدئة تماماً

127
00:09:40,890 --> 00:09:42,310
اقضي عليها يا ميهارون

128
00:09:49,300 --> 00:09:52,020
اللاعبة التي تستهدفُني مبتدئة إذاً؟

129
00:09:52,120 --> 00:09:56,230
لهذا لم تسرِ الأمورُ
كما في الألعاب الماضية التي أتذكّرها

130
00:09:56,330 --> 00:09:58,820
وهذه اليد لا أتذكّر أنني شهدتُ مثلها من قبل

131
00:09:58,920 --> 00:10:01,190
لا ترتسِم أي صورة لشيء مُقارِب
لذلك في ذكرياتي

132
00:10:02,510 --> 00:10:05,710
...ليتَ زارَ مقهانا عددٌ أكبر من المبتدئين

133
00:10:07,150 --> 00:10:09,710
كاوري سيّئة كثيراً في هذا كالعادة

134
00:10:09,940 --> 00:10:15,090
ولكن تأهّلنا لبطولةِ الفرق
بفضلِ انضمامها لنادينا

135
00:10:15,190 --> 00:10:19,070
مع أنني لم أصدِّق أننا سنتأهّلُ للنهائي

136
00:10:19,170 --> 00:10:21,360
أبدَعنا بمجرّد وصولنا إلى هنا

137
00:10:21,460 --> 00:10:25,410
ولكن من طبيعة البشر أن يطمعوا
بالمزيد حالما يبلغون هذه المرحلة

138
00:10:25,510 --> 00:10:27,920
نريدُ أن نربح ونتأهّل للبطولةِ الوطنيّة

139
00:10:28,020 --> 00:10:28,860
نعم

140
00:10:29,880 --> 00:10:31,980
أيّتها الحقيرات الجشِعات

141
00:10:32,080 --> 00:10:34,670
تُقامُ البطولة الوطنيّة في أغسطس

142
00:10:34,770 --> 00:10:38,540
إن ربِحنا اليوم فسيكونُ أمام سينو
مُتّسعاً من الوقت للتحسُّن

143
00:10:39,040 --> 00:10:41,240
...إذا تجاوزنا هذا اليوم فحسب

144
00:10:41,340 --> 00:10:44,070
...ثلاثة قراميد لكل منها، ثلاثة قراميد لكل منها

145
00:10:47,490 --> 00:10:50,230
فـ...فهمت

146
00:10:50,330 --> 00:10:51,880
سأستخدم رييتشي

147
00:10:55,960 --> 00:10:57,500
وشريحة الرييتشي خاصّتكِ...؟

148
00:11:11,780 --> 00:11:14,990
تباً، لا أستوعب ما تطرحه على الإطلاق

149
00:11:15,980 --> 00:11:18,990
لا جدوى، لم أرَ شيئاً كهذا
في الماضي على الإطلاق

150
00:11:24,060 --> 00:11:25,460
تسومو

151
00:11:25,850 --> 00:11:27,460
...دورا العكسيّة هي

152
00:11:30,460 --> 00:11:32,030
لا أملك واحدة

153
00:11:32,130 --> 00:11:33,850
ويدكِ؟

154
00:11:35,720 --> 00:11:38,750
رييتشي، تسومو، تويتوي على ما أظن؟

155
00:11:38,850 --> 00:11:40,100
...هذه

156
00:11:43,180 --> 00:11:45,190
!سووانكو؟

157
00:11:46,610 --> 00:11:48,270
ما هو هذا

158
00:11:48,370 --> 00:11:50,620
إنّه أسهل ياكومان يمكنُ الحصول عليه

159
00:11:50,720 --> 00:11:53,190
أنتِ لا تجلسين في الشرق، لِذا تُساوي 32.000 نقطة

160
00:11:53,630 --> 00:11:55,490
حظّ المبتدئات

161
00:12:00,000 --> 00:12:03,470
بما أنني كنتُ موزِّعة، خسرتُ 16.000 نقطة

162
00:12:03,570 --> 00:12:08,010
لو طرحتُ الـ 8 أحرُف بدلاً من ذلك
لنجوتُ بناقص 8000 فقط

163
00:12:08,770 --> 00:12:11,140
هذه أسوأ بداية على الإطلاق

164
00:12:13,010 --> 00:12:16,600
أتى أحدٌ إلى هنا فوراً

165
00:12:18,070 --> 00:12:21,020
أليسَت النائمة هناك هي هارامورا نودوكا؟

166
00:12:21,120 --> 00:12:25,240
بالفعل! وهنالِك ذلك البطريق الحقير أيضاً

167
00:12:25,940 --> 00:12:28,480
لنُقِم مقلباً عليها

168
00:12:34,430 --> 00:12:36,950
الطقس جميل اليوم

169
00:12:37,250 --> 00:12:39,660
...وأوراق الشجر اليافعة خضراء وبرّاقة

170
00:12:42,050 --> 00:12:45,760
إنه يوم جميل ومُناسِب لمداعبةِ
...بعضنا البعض أنا ونودوكا

171
00:12:48,030 --> 00:12:49,850
كيوتارو-كون

172
00:12:48,990 --> 00:12:49,850
نعم؟

173
00:12:51,660 --> 00:12:54,280
!تاكو، تاكو، أين التاكو خاصّتي؟

174
00:12:55,080 --> 00:12:58,810
...لا، لا يجوز أن أفكّر بذلك
فالجولة الثانية على وشك أن تنتهي

175
00:12:58,910 --> 00:13:02,600
إن لم أصِل على وقت الغداء
سأتعرّضُ لتوبيخٍ مُماثِل

176
00:13:02,920 --> 00:13:06,580
وعلى أي حال، كم قطعة تاكو
قد اشتريتُ منذُ هذا الصباح؟

177
00:13:15,640 --> 00:13:19,300
أنحنُ في المركز الأخير؟! ماذا حدث؟

178
00:13:20,850 --> 00:13:22,110
لقد عُدت

179
00:13:22,210 --> 00:13:26,220
أهلاً بعودتك. أحسنتَ صنعاً بإحضارِ الطعام

180
00:13:26,320 --> 00:13:31,310
المعذرة، قد لا أرغب بمعرفة ذلك
ولكن ماذا حدثَ في الجولة الثانية؟

181
00:13:31,410 --> 00:13:35,180
خلال ثلاثة جولات من جولات الموزِّع الأربعة لماكو
ربِحَتْ إحداهن بـ تسومو

182
00:13:35,280 --> 00:13:37,040
وكانَتْ إحداها ياكومان

183
00:13:37,140 --> 00:13:39,650
آسِفة لأنني أحبطتُ الجميع

184
00:13:40,080 --> 00:13:43,800
والفتاة التي ربِحَتْ كانت لاعبة من تسوروغا
والتي تبيّنَ بأنها مبتدئة أكثر من كيوتارو

185
00:13:43,900 --> 00:13:45,120
حقاً؟

186
00:13:46,250 --> 00:13:47,670
اشتريتُ لكِ التاكو

187
00:13:47,770 --> 00:13:49,770
حسناً، كلب جيّد

188
00:13:49,870 --> 00:13:50,630
كفّي عن نَعتي بكلب

189
00:13:50,730 --> 00:13:54,600
لا أصدِّق أنني أسلّمكِ العصا
ونحنُ في المركز الأخير

190
00:13:54,700 --> 00:13:58,620
حسناً، سيحينُ دوري بعدَ استراحة الغداء

191
00:13:58,720 --> 00:14:01,540
لذا سأحاولُ العودة والتّعويض قدرَ ما أستطيع

192
00:14:01,850 --> 00:14:03,440
توموكي

193
00:14:03,540 --> 00:14:06,220
ما هذا الضعف الشديد؟

194
00:14:06,320 --> 00:14:13,310
مهلاً مهلاً... كانَتْ توموكي تواجه لاعبة
غير مُلائمة إطلاقاً، مُبتدئة كلّياً

195
00:14:13,410 --> 00:14:14,080
...نعم

196
00:14:14,180 --> 00:14:15,790
!غير ملائمة؟

197
00:14:15,890 --> 00:14:17,020
كائناً من كان خصمنا

198
00:14:17,120 --> 00:14:20,850
لا يُقبَل أن تحتلّ ريومونبوتشي المركز الثالث

199
00:14:20,950 --> 00:14:22,390
...نعم سيّدتي

200
00:14:22,660 --> 00:14:26,190
حسناً، سأجدُ حلّاً للمسألة، لِذا لا تقلقي

201
00:14:26,500 --> 00:14:28,780
أنتِ تتحلّين بثِقة كبيرة

202
00:14:28,880 --> 00:14:32,390
،ولكن عودتنا نحنُ الاثنتان إلى المركز الأوّل بقوّة

203
00:14:32,490 --> 00:14:35,050
ومن ثمّ إقصاء المدارس الأخرى ستكونُ إنجازاً عظيماً

204
00:14:35,150 --> 00:14:39,080
سنقعُ في ورطة حقيقيّة إن لم تظهر
لاعبتنا الخامسة اليوم

205
00:14:42,230 --> 00:14:47,180
انتظري، هذا ليسَ مكاناً للأطفال
لا يُسمَح بالدخول إلّا للمُشتركات

206
00:14:48,320 --> 00:14:49,460
هويّة طالبة؟

207
00:14:50,650 --> 00:14:51,880
إنها مشهورة

208
00:14:51,980 --> 00:14:53,900
...سامحيني رجاءً

209
00:14:54,780 --> 00:14:57,450
...إنها أفضل لاعبة في العام الماضي إذاً

210
00:14:57,550 --> 00:14:59,850
إحدى وحوش أساتذة الماجونغ
...في البطولة الوطنيّة

211
00:14:59,950 --> 00:15:01,900
أتِلك هي آماي كورومو إذاً؟

212
00:15:05,790 --> 00:15:07,440
تصِلين في وقت متأخّر ومَهيب حسبما أرى

213
00:15:09,550 --> 00:15:12,440
...رائحة صالة اللعب هذه

214
00:15:15,630 --> 00:15:18,490
أشتمُّ رائحةَ طبق لذيذ

215
00:15:19,260 --> 00:15:20,990
آماي كورومو

216
00:15:23,430 --> 00:15:26,490
إنها استراحةُ الغداء، لِذا لعلّكِ تشتمِّين رائحة كاري؟

217
00:15:26,590 --> 00:15:30,560
لا، ما أشتمّه هو أُضحيات لكورومو

218
00:15:32,290 --> 00:15:34,870
أنتِ ظريفةٌ جداً

219
00:15:34,970 --> 00:15:36,410
أريدُ طفلةً مثلكِ

220
00:15:35,660 --> 00:15:38,660
أنا لستُ طفلة، أنا كورومو

221
00:15:38,680 --> 00:15:39,830
لا تحضنيني

222
00:15:39,930 --> 00:15:41,740
...اهدئي أيتها الفتاة المهذّبة

223
00:15:44,750 --> 00:15:46,810
...لا تروّضيني

224
00:15:47,830 --> 00:15:52,310
وأنتِ مجرّد محترِفة تافِهة
...هزمتُها في بطولة المحترفين والهواة

225
00:15:52,610 --> 00:15:53,720
ماذا قلتِ؟

226
00:15:53,820 --> 00:15:57,520
كانَت القواعد في تِلك البطولة غريبة
ولم نتنافس بشكل مُباشر

227
00:15:57,620 --> 00:15:59,950
أتقصدين بأنّكِ تهزمينني في مواجهة مباشرة؟

228
00:16:00,050 --> 00:16:02,640
ألن يكون ذلك لطيفاً لعقل
نخب ثالث كعقلكِ؟

229
00:16:02,740 --> 00:16:04,820
هذا مثيرٌ جداً للضحك

230
00:16:04,920 --> 00:16:08,900
لم يُشارِك في تِلك البطولة أيّ لاعب قويّ
لا من المُحترِفين ولا من الهُواة

231
00:16:09,000 --> 00:16:10,590
لا تغترِّي كثيراً بنفسكِ

232
00:16:10,690 --> 00:16:14,840
أهذا اعترافٌ منكِ بأنكِ ضعيفة أيضاً؟

233
00:16:18,160 --> 00:16:19,630
!أنتُما

234
00:16:19,730 --> 00:16:22,580
لا يُسمَح سِوى لِلاعبات النّهائي بالدخول إلى هُنا

235
00:16:22,680 --> 00:16:23,840
إنها المحترفة فوجيتا

236
00:16:23,940 --> 00:16:25,350
تباً

237
00:16:25,580 --> 00:16:26,710
البطريق

238
00:16:26,810 --> 00:16:27,820
اتركيه فحسب

239
00:16:28,600 --> 00:16:30,190
ما هذا؟

240
00:16:31,340 --> 00:16:32,480
بطريق؟

241
00:16:32,580 --> 00:16:36,590
يبدو بأنّه البطريق الذي كانَتْ تحضنُه
هارامورا نودوكا من ثانويّة كيوسومي

242
00:16:36,690 --> 00:16:40,100
حسناً إذاً، سآخذُه إليها

243
00:16:40,200 --> 00:16:43,150
هل ستتمكّنين من فعل ذلك بمفردكِ؟

244
00:16:43,250 --> 00:16:45,220
أنا كورومو، لستُ طفلة

245
00:16:45,850 --> 00:16:49,090
لا ضير من أن تختلط قليلاً
مع لاعبات الثانوية الأخريات

246
00:16:49,650 --> 00:16:51,440
حسناً، أتركُ الأمرَ لكِ إذاً

247
00:16:51,540 --> 00:16:54,020
بالتأكيد، دعيه لي

248
00:17:07,500 --> 00:17:09,690
كانَت المُحترِفة فوجيتا، أليس كذلك؟

249
00:17:09,790 --> 00:17:11,720
هل رأتْ وجهينا؟

250
00:17:11,820 --> 00:17:14,850
لكنّنا نرتدي زيّنا المدرسي

251
00:17:14,950 --> 00:17:16,160
...هذا صحيح

252
00:17:17,260 --> 00:17:19,850
كيف حدثَ شيء كهذا؟

253
00:17:19,950 --> 00:17:23,490
كنّا جميعاً غاضِبات في الليلة الماضية
بعدَ الخسارة أمام كيوسومي

254
00:17:23,590 --> 00:17:26,450
لهذا فجَّرنا كلّ طاقاتنا في الغناء في حجرة الكاريوكي
قُرب الصالة حتّى الصباح

255
00:17:26,770 --> 00:17:28,030
نعم

256
00:17:28,130 --> 00:17:32,900
وكنتُ نعسانة، فقلتِ أن بمقدورنا النوم
...في غرفة القيلولة في صالة البطولة

257
00:17:33,000 --> 00:17:37,100
فكانَتْ تِلك الحقيرة هارامورا نودوكا
نائمة هُناك

258
00:17:43,660 --> 00:17:45,360
ماذا نفعل؟

259
00:17:45,950 --> 00:17:48,670
أرى بأنّ علينا إعادة البطريق

260
00:17:48,770 --> 00:17:51,260
لكنّه سقطَ مني للتو

261
00:17:51,360 --> 00:17:52,720
أتريدين العودة إلى هناك؟

262
00:17:52,820 --> 00:17:55,440
أظنُّنا قمنا بعملٍ سيئ حقاً

263
00:17:55,540 --> 00:17:58,270
لنبحث عن البطريق ونُعيده

264
00:17:59,550 --> 00:18:01,410
معكِ حقّ

265
00:18:01,510 --> 00:18:03,490
لنعد ونتفقّد

266
00:18:09,730 --> 00:18:11,500
سيَفي هذا بالغرض

267
00:18:13,310 --> 00:18:15,400
لا يروقني هذا

268
00:18:15,500 --> 00:18:18,160
،إن لم نكبّلكِ إلى هذا الحدّ

269
00:18:18,260 --> 00:18:21,510
فلن يكون هُناك ما يردعكِ عن استخدام خفّة يدكِ

270
00:18:21,610 --> 00:18:26,920
هنالِك العشرات من كاميرات المُراقبة
لِذا إن انكشفَ أمري سيتمّ إقصاؤنا

271
00:18:27,020 --> 00:18:28,340
من المُحال أن أستخدمها

272
00:18:28,440 --> 00:18:30,920
إنّ توكا كثيرة القلق

273
00:18:31,020 --> 00:18:34,400
هنالِك احتمال طَفيف لقيامكِ بذلك
من دون أن تشعري

274
00:18:35,170 --> 00:18:39,940
...خطيئة واحِدة في الماضي كلّفَتْني قيداً كهذا

275
00:18:40,340 --> 00:18:43,540
إنّه لَمِنَ الصّعب حقاً استعادة ثِقة الناس

276
00:18:44,150 --> 00:18:47,400
رائع، أنا مسرورةٌ لأجلكِ يا كاوري

277
00:18:47,500 --> 00:18:48,700
أبليتِ حسناً

278
00:18:49,430 --> 00:18:51,400
أكان أدائي جيّداً؟

279
00:18:51,500 --> 00:18:52,600
كان مذهلاً جداً

280
00:18:52,700 --> 00:18:55,780
كانَتْ النتائج مُرضية تماماً

281
00:18:55,880 --> 00:18:58,190
...الماجونغ ليسَتْ حظّاً فحسب، لكن

282
00:18:58,290 --> 00:19:03,140
إن كان عددُ الهانتشان قليلاً
قد يتمكّن هاوٍ من هزيمة محترِف

283
00:19:03,860 --> 00:19:04,930
كانبارا

284
00:19:05,030 --> 00:19:05,970
نعم؟

285
00:19:06,070 --> 00:19:08,580
لا تدعي الهدفَ يخرجُ عن نِطاق الرّمي

286
00:19:08,680 --> 00:19:12,510
كلّ ما عليّ هو إقصائها؟ صحيح؟
...ثانويّة كازيكوشي

287
00:19:20,340 --> 00:19:22,730
تبدو الكابتن وكأنّها تتحسّن

288
00:19:22,830 --> 00:19:23,820
نعم

289
00:19:23,920 --> 00:19:27,090
ومدحَتْكِ لصمودكِ يا ميهارون

290
00:19:29,010 --> 00:19:31,460
أريدُ أن أتلقّى مديحاً أيضاً

291
00:19:31,930 --> 00:19:34,640
سيحينُ دوري الآن، صحيح؟

292
00:19:34,740 --> 00:19:37,550
هل أنتِ متوتّرة على نحو غير معهود؟

293
00:19:37,650 --> 00:19:42,020
...أخشى من أن أوقِف هذا الزخم الذي أحدثناه

294
00:19:42,440 --> 00:19:45,070
وهذه هي المرحلة الأهمّ التي أعيشُها في حياتي

295
00:19:45,170 --> 00:19:50,530
إذاً الصاعِدة التي أصبحَتْ نظاميّة
منذُ شهرين فقط هي فتاة جبانة؟

296
00:19:50,950 --> 00:19:52,100
...السجلّات

297
00:19:53,870 --> 00:19:57,600
ألا تشعرن بأنّ سجلّات لاعِبتَيّ التشوكين والتايشو
من كيوسومي كانَتْ غريبة؟

298
00:19:58,460 --> 00:19:59,840
كانَتْ مجرد صدفة، صحيح؟

299
00:19:59,940 --> 00:20:01,000
...كانَتْ

300
00:20:01,250 --> 00:20:04,480
سأدعو ألّا تتكرّر "صدفة" كهذه

301
00:20:05,170 --> 00:20:08,040
الجولة الوُسطى من النّهائيات ستبدأ عمّا قريب

302
00:20:08,140 --> 00:20:11,780
هلّا تقدّمنَ اللّاعبات المُشاركات
بسُرعة إلى صالة اللّعب رجاء؟

303
00:20:14,100 --> 00:20:16,420
حسناً، سأعتمدُ عليكن لاحقاً

304
00:20:16,520 --> 00:20:17,960
حظّاً سعيداً

305
00:20:18,060 --> 00:20:19,200
!من فضلك

306
00:20:19,300 --> 00:20:20,970
نعتمدُ عليكِ

307
00:20:22,610 --> 00:20:24,220
دعوا الأمر لي

308
00:20:28,490 --> 00:20:30,630
إنّهما متشجِّعتان

309
00:20:31,070 --> 00:20:33,090
...ولكن عيونهما

310
00:20:36,330 --> 00:20:39,740
لم تنظرا إليّ بهذه النظرات من قبل

311
00:20:41,420 --> 00:20:42,990
!هذا ليسَ بسيئ

312
00:20:44,710 --> 00:20:47,830
الجولة الوُسطى من نهائيات التصفيات الإقليميّة

313
00:20:47,930 --> 00:20:51,630
أيّ من هذه المدارس الثانويّة
ستكسبُ اليد الطولى يا تُرى؟

314
00:20:55,220 --> 00:20:57,290
تبدأ المُباراة

315
00:20:58,850 --> 00:21:00,880
تاكي هيسا؟

316
00:21:00,980 --> 00:21:03,290
أليسَتْ تِلك هي أوينو-سان؟

317
00:21:05,230 --> 00:21:07,430
،اسم عائلتها مختلِف

318
00:21:07,530 --> 00:21:09,930
ولكن أنا واثِقةٌ بأنها هي

319
00:21:10,030 --> 00:21:12,650
تِلك الفتاة هي أوينو هيسا

320
00:21:13,910 --> 00:21:20,660
الفتاة الوحيدة التي تسبّبَتْ بمُعاناتي طوال
بطولة المدارس الإعدادية الوطنيّة منذُ ثلاث سنوات

321
00:21:22,460 --> 00:21:24,220
،كانَتْ موهوبة جداً

322
00:21:24,320 --> 00:21:27,240
ولكن اختفَتْ فجأة من صالة البطولة
دون أن تُشارك في المباراة الثالثة

323
00:21:27,340 --> 00:21:31,450
وفي العام التالي، لم تُشرِك كازيكوشي أيضاً

324
00:21:32,050 --> 00:21:34,030
ظننتُها قد انتقلَتْ

325
00:21:35,260 --> 00:21:39,210
ولم تُشارِك في أي بطولة
خلال المرحلة الثانويّة

326
00:21:39,310 --> 00:21:43,110
لطالما ظننتُ بأنها قد انتقلَتْ
إلى محافظة أخرى

327
00:21:43,210 --> 00:21:46,060
كابتن، ما الأمر؟

328
00:21:46,480 --> 00:21:47,970
...لا شيء

329
00:21:49,490 --> 00:21:52,670
أرجوكِ يا بوندو-سان، كوني حذِرة

330
00:22:01,250 --> 00:22:02,180
أرجوكِ

331
00:22:02,880 --> 00:22:05,580
لا تُواجهيها بشكل مُباشَر