203
00:11:56,930 --> 00:11:59,820
غفَتْ عينايّ عنها لبُرهةٍ فاختفَتْ

204
00:12:00,510 --> 00:12:03,640
أنا متأكّدة أنّ الأمّ قد وجدتها واسترجعتها

205
00:12:03,640 --> 00:12:06,030
آمل أن يكون هذا ما حدث

206
00:12:07,280 --> 00:12:09,770
هل مرّ شيء ما للتو؟

207
00:12:16,570 --> 00:12:18,600
في البدايةِ رضيعة والآن طفلة تائهة؟

208
00:12:18,600 --> 00:12:20,210
انتظري يا ساتسكي-تشان

209
00:12:21,080 --> 00:12:21,830
...هذا الكيمونو

210
00:12:22,760 --> 00:12:25,000
اسمها هو شينو-تشان

211
00:12:25,000 --> 00:12:28,180
تكلّمتُ مع جدّتها للتو

212
00:12:28,560 --> 00:12:30,510
طمأنتِني

213
00:12:31,020 --> 00:12:32,580
...لنأخذها

214
00:12:35,800 --> 00:12:38,080
تبّاً! اليوم ملعون

215
00:12:38,070 --> 00:12:39,400
أمّي

216
00:12:39,420 --> 00:12:42,150
لا أتذكّر أنّني أنجبتكِ

217
00:12:43,760 --> 00:12:46,660
لا تُبكيها يا ساتسكي-تشان

218
00:12:46,660 --> 00:12:48,140
!لـ-لم أفعل

219
00:12:48,140 --> 00:12:49,950
تعالي يا شينو-تشان

220
00:12:55,380 --> 00:12:57,700
من الجيّد أنّها تضحك

221
00:13:09,890 --> 00:13:12,720
يمكنكِ ارتداء هذه اليوكاتا حتّى تجفّ
الكيمونو خاصّتك

222
00:13:16,010 --> 00:13:16,890
!شينو-تشان

223
00:13:17,330 --> 00:13:18,390
!وداعاً

224
00:13:19,090 --> 00:13:20,730
ماذا تقصدين بـ"وداعاً"؟

225
00:13:20,730 --> 00:13:22,720
تبّاً! إنّها تُتعبني كثيراً

226
00:13:24,430 --> 00:13:29,230
ابتسامة ساتسكي-تشان جميلة جدّاً

227
00:13:30,100 --> 00:13:32,060
لمَ هذه الابتسامة العريضة؟

228
00:13:32,060 --> 00:13:33,710
!لا شيء

229
00:13:35,040 --> 00:13:37,240
شينو

230
00:13:37,240 --> 00:13:39,640
أين تركتِ عباءة الكيمونو خاصّتكِ؟

231
00:13:40,870 --> 00:13:43,470
عجباً لكِ

232
00:13:44,800 --> 00:13:47,020
الطقس رائع

233
00:13:49,690 --> 00:13:51,400
ما الذي تفعلينه؟

234
00:13:52,530 --> 00:13:55,550
كرتكِ عالقة في الشّجرة

235
00:14:00,310 --> 00:14:02,640
لا يجوز أن تكوني صاخبة كثيراً

236
00:14:08,960 --> 00:14:11,870
ستوسّخين عباءتكِ الكيمونو الجميلة

237
00:14:13,650 --> 00:14:14,860
...المعذرة

238
00:14:17,140 --> 00:14:20,240
شكراً لكِ، أوني-تشان

239
00:14:23,420 --> 00:14:25,910
لكن أنا أونيه-تشان

240
00:14:28,050 --> 00:14:31,760
يا إلهي! ما الأمر يا شينو؟

241
00:14:32,300 --> 00:14:35,090
هل تريدين أن تكبري بشكلٍ أسرع؟

242
00:14:36,000 --> 00:14:37,570
بالتأكيد

243
00:14:37,560 --> 00:14:41,310
،سأطرّز لكِ عباءةَ فوريسوده تالياً

244
00:14:41,610 --> 00:14:45,110
وذلك كي تكبري لتصبحي سيّدة حلوة قريباً

245
00:14:48,760 --> 00:14:51,200
لماذا تبكين يا عزيزتي؟

246
00:14:52,900 --> 00:14:56,160
طرّزتْ لي أمّي عباءةَ فوريسوده

247
00:14:56,160 --> 00:14:58,280
هذا رائع

248
00:14:58,280 --> 00:15:01,620
!لكن ذوق أمّي في الأزياء قديم

249
00:15:01,960 --> 00:15:04,040
!لا أريد أن أرتدي هذا

250
00:15:08,190 --> 00:15:09,260
أترين؟

251
00:15:09,260 --> 00:15:11,070
لا يجوز أن تكوني كثيرة الأنين

252
00:15:11,070 --> 00:15:14,420
أنتِ فتاة. عليكِ أن تبحثي عن طريقتكِ
الخاصّة لتتجمّلي

253
00:15:14,420 --> 00:15:18,640
أتعتقدين أنّني أستطيع أن أصبح جميلة
مثلكِ يا أونيه-تشان؟

254
00:15:18,640 --> 00:15:20,430
عـ-عمّاذا تتحدّثين؟

255
00:15:20,430 --> 00:15:22,660
أ-أظنّكِ تستطيعين

256
00:15:22,660 --> 00:15:24,100
ربّما ليس بمثلِ جمالي

257
00:15:24,490 --> 00:15:27,310
رين، هل رأيتِ بيجامتي؟

258
00:15:27,610 --> 00:15:30,210
تِلك التي رميتِها على الأرض؟

259
00:15:30,210 --> 00:15:32,890
غسلتُها لكِ بما أنّكِ لن تغسليها أبداً

260
00:15:33,450 --> 00:15:34,560
هذه رين التي أعرفها

261
00:15:34,560 --> 00:15:36,220
أنتِ لطيفةٌ للغاية

262
00:15:36,640 --> 00:15:38,420
!ناتسومي الغبيّة

263
00:15:38,420 --> 00:15:40,470
!الناس يُشاهدوننا

264
00:15:41,760 --> 00:15:43,410
اختفَتْ

265
00:15:43,410 --> 00:15:44,980
من كانَتْ تلك الفتاة؟

266
00:15:44,980 --> 00:15:46,270
لا أدري

267
00:15:46,270 --> 00:15:47,880
ربّما طفلة نزيل ما

268
00:15:48,280 --> 00:15:50,700
أتساءل ما إن كانَتْ أختها الكبرى

269
00:15:56,780 --> 00:15:59,000
المعذرة يا سيّدتي

270
00:15:59,540 --> 00:16:01,970
أحضرتُ خيطاً وقماشاً

271
00:16:02,240 --> 00:16:04,490
تفضّلي، أونيه-سان

272
00:16:05,710 --> 00:16:08,190
أعتذر عن الفوضى هنا

273
00:16:08,190 --> 00:16:10,380
سأذهب لإعداد الشّاي

274
00:16:09,630 --> 00:16:11,600
...المعذرة، أنا

275
00:16:12,030 --> 00:16:14,560
عباءة كيمونو جديدة أخرى؟

276
00:16:14,560 --> 00:16:17,800
هذا صحيحٌ يا أمّي

277
00:16:18,310 --> 00:16:23,080
تنمو شينو بسرعة لدرجة لا أستطيع تمييزها

278
00:16:24,030 --> 00:16:26,460
إنّها تمرُّ بهبّةِ نموّها

279
00:16:26,690 --> 00:16:30,290
يبدو أنّها وقعَتْ في الحبّ أيضاً

280
00:16:30,650 --> 00:16:35,210
لا تخبرا جيرو-سان بهذا

281
00:16:35,780 --> 00:16:38,950
فذلك الرّجل متعلّق جدّاً بأطفاله

282
00:16:39,290 --> 00:16:42,100
سيغار كثيراً، أنا واثقة

283
00:16:42,430 --> 00:16:44,510
أليس كذلك يا شينو؟

284
00:16:46,570 --> 00:16:50,200
هذا هو سرّنا، صحيح؟

285
00:16:54,990 --> 00:16:56,440
المعذرة

286
00:16:58,620 --> 00:17:02,670
يوزو، ترعرعتِ على يدِ بشر، أليس كذلك؟

287
00:17:03,740 --> 00:17:04,560
أجل

288
00:17:05,790 --> 00:17:08,030
إذاً هل سمعتِ بهذا التقليد؟

289
00:17:08,400 --> 00:17:11,270
الأمّ التي تفقدُ ابنتَها وهي صغيرة

290
00:17:11,270 --> 00:17:14,810
،فإنّها تُلبِسُ دميةً لباس زفاف بدلاً منها

291
00:17:15,350 --> 00:17:18,230
وذلك كي تتزوّج الابنة في الحياة الآخرة

292
00:17:18,510 --> 00:17:21,130
ما رأيكِ يا يوزو؟

293
00:17:22,820 --> 00:17:28,440
أتشعرين بالشفقةِ على تلك السيّدة وهي تقضي
وقتاً مع أشخاص غير موجودين هنا؟

294
00:17:30,700 --> 00:17:38,030
إن كان هذا ما تريده النزيلة، فالعالم
الذي تراه هو العالم الحقيقي إذاً

295
00:17:38,840 --> 00:17:42,350
الضيوف هم آلهة في نهايةِ المطاف

296
00:17:50,790 --> 00:17:52,640
ما الأمر؟

297
00:17:52,640 --> 00:17:54,450
تبدين حزينة

298
00:17:54,450 --> 00:17:56,080
ها أنتِ ذي أيّتها التانوكية

299
00:17:57,500 --> 00:17:59,380
لستُ تانوكية

300
00:17:59,380 --> 00:18:00,420
أنا ثعلبة

301
00:18:00,420 --> 00:18:02,330
لا يهمّني في الحالتين

302
00:18:02,330 --> 00:18:04,380
كفّي عن خداع أمّي من فضلكِ

303
00:18:04,840 --> 00:18:07,340
أنتِ في سنِّ التمرّد

304
00:18:07,340 --> 00:18:10,600
لم تتمكّني من اختيار سنٍّ أعقد
من هذا لبشريّ

305
00:18:10,810 --> 00:18:14,200
متى ستحرّرينها من هذا المكان؟

306
00:18:15,260 --> 00:18:17,130
كونوهاناتي

307
00:18:17,490 --> 00:18:22,800
دخلَتْ نزيلتُنا من مدخلنا بمحضِ رغبتها

308
00:18:23,240 --> 00:18:25,460
لا يمكنني طردها

309
00:18:26,210 --> 00:18:30,390
لمَ لا تستمتعين بوقتكِ هنا أيضاً؟

310
00:18:30,390 --> 00:18:31,680
وكيف لي ذلك؟

311
00:18:32,000 --> 00:18:34,210
هذا كلّه حلم

312
00:18:34,210 --> 00:18:37,100
ستزيدينها تعاسة أكثر حتّى عندما تستيقظ

313
00:18:37,100 --> 00:18:38,730
،لكن يا سيّدة

314
00:18:40,310 --> 00:18:42,900
الأحلام العابرة التي رأيتِها هنا
في كونوهاناتي

315
00:18:43,460 --> 00:18:46,010
...مجموع ما عشتِه من حياة بشريّة

316
00:18:46,330 --> 00:18:49,690
بالنسبةِ لنا نحن الثّعالب، لا تختلف كثيراً

317
00:18:50,600 --> 00:18:53,040
"كم كان حلماً جميلاً"

318
00:18:53,040 --> 00:18:54,680
أليس هذا جيّداً بما يكفي؟

319
00:18:55,310 --> 00:18:59,610
على الأقلّ، نزيلتنا لا تُمانع أن يكون حلماً

320
00:19:03,990 --> 00:19:07,200
لا تخبري أحداً بما قلتُه للتو

321
00:19:08,980 --> 00:19:13,870
أظلُّ أحرج نفسي أمام الناس هنا

322
00:19:14,620 --> 00:19:18,970
هذا ما يعنيه أن ينضج الشّخص

323
00:19:19,800 --> 00:19:23,450
أحرجي نفسكِ كثيراً وتحسّري على الأمور

324
00:19:23,900 --> 00:19:28,580
وكوني امرأة جميلة من فضلكِ

325
00:19:30,200 --> 00:19:32,450
يا لها من عروس حسناء

326
00:19:32,700 --> 00:19:34,600
في أي غرفة ستُقيم؟

327
00:19:34,900 --> 00:19:37,060
غرفة كاسومي

328
00:19:41,150 --> 00:19:44,030
هل أنتِ بخير أيّتها الخادمة الصّغيرة؟

329
00:19:48,080 --> 00:19:49,370
شكراً لكِ

330
00:19:52,870 --> 00:19:57,260
آخر عباءة كيمونو خاصّة بها انتهت هذا الصّباح

331
00:19:58,360 --> 00:20:00,970
يا له من يوم جميل

332
00:20:01,710 --> 00:20:04,810
سماء ربيع صافية مثاليّة

333
00:20:05,450 --> 00:20:08,650
كاليوم الذي وُلِدتِ فيه

334
00:20:09,740 --> 00:20:13,610
تبدين جميلة يا شينو

335
00:20:14,830 --> 00:20:18,260
قلتِ أنّني كنتُ ابنة إله

336
00:20:19,140 --> 00:20:22,300
لكن لطالما كنتُ ابنتكِ

337
00:20:23,250 --> 00:20:27,730
عشتُ حياةً مُجزيةً حقّاً كما في الأحلام

338
00:20:29,360 --> 00:20:30,660
،شكراً لكِ

339
00:20:32,950 --> 00:20:34,140
يا أمّي

340
00:20:45,320 --> 00:20:48,060
شكراً لكِ يا آنسة

341
00:20:48,330 --> 00:20:53,800
ساعدَتْني الخادمات على قضاءِ
كلّ لحظة بسعادة هنا

342
00:20:53,800 --> 00:20:56,820
كان حقّاً أشبه بحلم

343
00:20:56,820 --> 00:20:58,740
لم يكن حلماً

344
00:21:00,200 --> 00:21:04,370
ستبقين دوماً مع ابنتكِ من الآن فصاعداً

345
00:21:04,690 --> 00:21:09,280
لفترةٍ أطول من العقودِ القليلة
التي افترقتُما فيها عن بعضكما

346
00:21:14,470 --> 00:21:20,300
هذا اليوم هو حقّاً يوم رائع

347
00:21:23,420 --> 00:21:26,870
أحضرتُ الغداء يا سيّدتي

348
00:21:32,630 --> 00:21:35,430
نزيلتُنا قد غادرَتْ للتو

349
00:21:35,700 --> 00:21:37,810
إلى حيث تنتظرها ابنتُها

350
00:21:37,810 --> 00:21:39,320
حقّاً؟

351
00:21:39,640 --> 00:21:42,120
لا بدَّ وأنّها كانت على عجلةٍ من أمرها

352
00:21:42,120 --> 00:21:45,530
خاب أملي قليلاً لأنّني لم أستطع توديعها

353
00:21:45,930 --> 00:21:48,740
بالمناسبة، أرادَتْ أن تشكرنا

354
00:21:49,340 --> 00:21:53,610
قالَتْ أنّ الأيّام القليلة الماضية
كانَتْ أشبه بحلم بفضلِنا

355
00:21:57,790 --> 00:22:00,160
حسناً إذاً، سنقيم مأدبةً اللّيلة

356
00:22:00,160 --> 00:22:01,620
سيكون عملاً شاقّاً يا يوزو

357
00:22:01,620 --> 00:22:02,600
!استعدّي

358
00:22:02,600 --> 00:22:03,360
!حاضرة