1
00:02:03,750 --> 00:02:04,720
...المعذرة

2
00:02:11,130 --> 00:02:12,080
...المعذرة

3
00:02:12,610 --> 00:02:15,020
هل أنتِ بخير؟

4
00:02:31,250 --> 00:02:32,510
...المعذرة

5
00:02:33,200 --> 00:02:36,100
هل أنتِ مريضة أو ما شابه؟

6
00:02:37,250 --> 00:02:38,600
نوعاً ما

7
00:02:39,140 --> 00:02:41,120
غرِقَتْ سفينتي

8
00:02:41,120 --> 00:02:42,280
غرِقَتْ سفينتك؟

9
00:02:43,220 --> 00:02:46,850
انقلبت السّفينة التي كنتُ فيها إثر عاصفة

10
00:02:47,450 --> 00:02:51,090
تمسّكتُ بقطعةٍ من الخشبِ وانحملتُ لأيّام

11
00:02:52,190 --> 00:02:56,140
عندما استفقت، وجدتُ نفسي منجرفة
إلى هذا الشّاطئ

12
00:02:58,250 --> 00:03:03,890
لا أملك سوى مانجو، لكن كليها من فضلكِ

13
00:03:07,330 --> 00:03:08,490
لا داعي

14
00:03:08,490 --> 00:03:10,240
أمزح بشأن غرق السّفينة

15
00:03:10,240 --> 00:03:11,900
!حقّاً؟

16
00:03:12,310 --> 00:03:13,910
حمداً لله

17
00:03:15,750 --> 00:03:16,600
نعم

18
00:03:16,600 --> 00:03:18,280
لا أمانع العواصف

19
00:03:18,280 --> 00:03:19,800
فأنا حوريّة بحر

20
00:03:20,490 --> 00:03:22,540
أنتِ حوريّة بحر؟

21
00:03:22,540 --> 00:03:23,770
أجل

22
00:03:23,770 --> 00:03:26,060
انفصلتُ عن صديقاتي

23
00:03:26,060 --> 00:03:27,850
أبحث عنهن الآن

24
00:03:28,230 --> 00:03:31,780
أنا متأكّدة أنّ صديقاتكِ قلقات

25
00:03:32,790 --> 00:03:36,700
إن لم تكوني تمانعين، هل أساعدكِ
في البحث عنهن؟

26
00:03:40,420 --> 00:03:44,450
!حوريّات البحر

27
00:03:44,710 --> 00:03:46,900
هل أنتن هنا؟

28
00:03:50,110 --> 00:03:51,980
ما خطب هذا؟

29
00:03:52,350 --> 00:03:55,250
هـ-هذا ذيلي. لماذا؟

30
00:03:56,040 --> 00:03:58,070
لماذا تمتلكين هذا؟

31
00:04:00,710 --> 00:04:06,250
في الواقع، لا أدري ما هي فائدته أيضاً

32
00:04:08,980 --> 00:04:11,760
آسفة. كان سؤالاً غريباً منّي

33
00:04:14,100 --> 00:04:16,910
أنتِ لا تكذبين حتّى

34
00:04:19,160 --> 00:04:20,080
ماذا؟

35
00:04:20,710 --> 00:04:23,230
لا شيء يا فتاة القطّة

36
00:04:23,650 --> 00:04:25,860
لستُ قطّة

37
00:04:25,860 --> 00:04:27,070
أنا ثعلبة

38
00:04:28,220 --> 00:04:29,880
!يا حوريّات البحر

39
00:04:29,880 --> 00:04:31,620
كذبتُ بشأن حوريّة البحر أيضاً

40
00:04:31,620 --> 00:04:33,450
حقّاً؟

41
00:04:33,450 --> 00:04:36,040
ولا أبحث عن صديقاتي أيضاً

42
00:04:36,410 --> 00:04:38,450
لا أملك أي صديقة

43
00:04:39,780 --> 00:04:43,250
فالجميع يكرهني لأنّني كاذبة

44
00:04:45,340 --> 00:04:47,910
يا لها من أكاذيب سخيفة

45
00:04:47,910 --> 00:04:50,300
تحاولين لفت انتباه الناس فحسب، أليس كذلك؟

46
00:04:50,790 --> 00:04:53,130
الأمور تسير على ما يُرام
مع أمّي أيضاً

47
00:04:53,470 --> 00:04:57,100
وأبي مخلص في عملِه وعنيد

48
00:04:57,780 --> 00:05:01,260
لا أحد يصغي إليّ في المدرسة هذه الأيّام أيضاً

49
00:05:01,260 --> 00:05:03,910
هذا لأنّني أكذب بشأن كلّ شيء

50
00:05:04,730 --> 00:05:08,560
لم يعد أحدٌ يصغي لأكاذيبي

51
00:05:09,200 --> 00:05:12,450
،لكن عندما أتوقّف عن الكذب

52
00:05:13,910 --> 00:05:18,290
تكون الحقيقة مملّة لدرجة مُؤلمة

53
00:05:19,370 --> 00:05:20,870
حقّاً؟

54
00:05:21,820 --> 00:05:25,900
أعمل كخادمة في فندق

55
00:05:25,900 --> 00:05:28,180
ألتقي بمختلف أنواع النّزلاء طوال الوقت

56
00:05:28,180 --> 00:05:30,070
كلّ يوم هو يوم ممتع

57
00:05:31,580 --> 00:05:35,390
هذا لأنّكِ تعملين عملاً تحبّينه

58
00:05:35,680 --> 00:05:38,680
لا أملك أحلاماً لمستقبلي أو ما شابه

59
00:05:38,680 --> 00:05:41,550
أحلام لمستقبلكِ؟

60
00:05:42,580 --> 00:05:44,650
هل من شيء تحبّينه؟

61
00:05:48,370 --> 00:05:51,470
كنتُ أحبّ الكتب المصوّرة في صغري

62
00:05:53,880 --> 00:05:57,310
وأحببتُ الرسم

63
00:05:59,920 --> 00:06:01,960
هذا مذهل

64
00:06:01,960 --> 00:06:06,760
لكن لم أكن بارعة جداً لدرجة أردتُ
أن أصبح رسّامة أو ما شابه

65
00:06:13,760 --> 00:06:16,390
،كنتُ أذهب إلى المدرسةِ كلّ يوم

66
00:06:17,100 --> 00:06:19,560
وعندما كبِرت، صرتُ أذهب إلى العمل

67
00:06:20,310 --> 00:06:24,160
نفس الأمر يتكرّر كلّ يوم

68
00:06:27,920 --> 00:06:29,180
لا يهمّ

69
00:06:30,300 --> 00:06:33,070
آسفة لخداعكِ أيّتها الفتاة الثّعلب

70
00:06:44,260 --> 00:06:46,590
لم تخدعيني

71
00:06:47,710 --> 00:06:51,350
أعدتِ إليّ المانجو

72
00:06:52,020 --> 00:06:53,420
المانجو؟

73
00:06:53,770 --> 00:06:59,760
إنّ خداعَ شخصٍ هو أخذ شيء منه
أو أذيّته بالكذب

74
00:07:00,450 --> 00:07:03,730
رواياتكِ ممتعة

75
00:07:03,730 --> 00:07:12,830
في يوم واحد فقط، تمكّنتُ من اللّقاء بهائمة
غرِقَتْ سفينتها، بحوريّة ضائعة، وبكِ

76
00:07:14,010 --> 00:07:15,560
ممتعة؟

77
00:07:15,560 --> 00:07:16,440
أجل

78
00:07:18,770 --> 00:07:20,720
!يا ناس! يا ناس

79
00:07:20,720 --> 00:07:23,360
!رأيتُ مخلوقاً فضائياً هناك للتو

80
00:07:23,790 --> 00:07:25,710
!انظروا! طبق طائر

81
00:07:26,480 --> 00:07:27,730
!رأيتُه

82
00:07:27,730 --> 00:07:29,660
ماذا؟ لم أستطع رؤيته

83
00:07:29,660 --> 00:07:31,790
آمل أن يعود

84
00:07:32,410 --> 00:07:37,890
نعم، عندما كنتُ صغيرة، كان ذلك ممتعاً
ولو كان كذباً

85
00:07:39,370 --> 00:07:43,480
حقيقة مُملّة حيثُ تحصلين على جواب
كلّ سؤال

86
00:07:44,190 --> 00:07:48,300
لكن الخيال وأحلام اليقظة كلّها جزء
من الحقيقةِ أيضاً

87
00:07:52,510 --> 00:07:56,650
ليتكِ كنتِ بجانبي

88
00:07:57,060 --> 00:07:58,790
لديكِ

89
00:08:00,560 --> 00:08:04,080
لديكِ شخص يستمتع برواياتكِ

90
00:08:04,860 --> 00:08:07,570
شخص يحتاج إليكِ

91
00:08:07,570 --> 00:08:08,770
أعدكِ

92
00:08:12,020 --> 00:08:17,480
مثلما لم أعرف شكلَ الصّداقة إلّا
بعد أن التقيتُ بالناس الذين أهتمّ لهم

93
00:08:19,410 --> 00:08:25,320
شاركي قصصكِ الممتعة مع مزيد
من الناس من فضلكِ

94
00:08:43,370 --> 00:08:48,910
!ماتسوموتو-سان

95
00:08:48,910 --> 00:08:50,290
هل أنتِ بخير؟

96
00:08:52,120 --> 00:08:54,220
هل تأذّيتِ؟

97
00:08:56,860 --> 00:08:57,580
من أنتِ؟

98
00:08:57,580 --> 00:08:59,740
هذه أنا، زميلتكِ في الصفّ، تانابي

99
00:08:59,740 --> 00:09:02,360
أجلس أمامكِ مباشرة

100
00:09:03,290 --> 00:09:05,640
تذكّرت. هذا صحيح

101
00:09:05,640 --> 00:09:07,890
أخفتِني

102
00:09:07,890 --> 00:09:10,960
بتِّ تتغيّبين عن المدرسةِ وتمكثين
في المنزلِ كثيراً مؤخراً

103
00:09:10,960 --> 00:09:12,980
...أتيتُ لأعطيكِ المواد التدريبيّة عندما

104
00:09:19,490 --> 00:09:22,520
ظننتُ أنّ قلبي كان سيتوقّف

105
00:09:24,630 --> 00:09:25,850
آسفة

106
00:09:25,850 --> 00:09:27,360
كان هناك سمك طائر

107
00:09:28,610 --> 00:09:33,050
أردتُ أن أرى ما إن كان بإمكاني الإمساك به

108
00:09:33,050 --> 00:09:34,290
فسقطت

109
00:09:34,660 --> 00:09:36,940
وعدتُ سابِحة إلى هنا

110
00:09:41,510 --> 00:09:42,750
ماذا تقولين؟

111
00:09:42,750 --> 00:09:43,890
هذا مضحكٌ للغاية

112
00:09:45,030 --> 00:09:46,200
مضحك للغاية؟

113
00:09:47,190 --> 00:09:48,900
أجل

114
00:09:48,900 --> 00:09:51,730
لم تلتقي بهم بعد على الأرجح

115
00:09:52,070 --> 00:09:54,900
لكن يسرّني أنّكِ على قيدِ الحياة

116
00:10:03,840 --> 00:10:06,900
ربّما سحبَتْني الثّعالب

117
00:10:07,160 --> 00:10:08,560
ماذا تقولين؟

118
00:10:08,560 --> 00:10:10,630
استمعي إلى هذا

119
00:10:10,630 --> 00:10:13,150
...هذا الحلم الذي شاهدتُه للتو

120
00:10:27,830 --> 00:10:29,740
ذلك الطفل ليس من هذه البلدة

121
00:10:30,280 --> 00:10:33,840
يهيم الناس إلى هذا الطرف أحياناً

122
00:10:34,240 --> 00:10:35,150
ماذا؟

123
00:10:35,900 --> 00:10:38,060
إذاً هي كذلك أيضاً؟

124
00:10:38,660 --> 00:10:42,600
يهيمون إلى الداخل والخارج
دون أن يشعروا بذلك حتّى

125
00:10:42,930 --> 00:10:45,020
سيجد ضالّته للخارج في نهايةِ المطاف

126
00:10:52,110 --> 00:10:53,370
ما هذه؟ فئران؟

127
00:10:55,000 --> 00:10:56,280
!أمسكتُ بها

128
00:10:57,670 --> 00:10:58,660
!أنت

129
00:10:58,660 --> 00:11:00,630
لا تضايق الفتيات

130
00:11:00,850 --> 00:11:03,190
!دعيني

131
00:11:01,670 --> 00:11:03,710
ما الذي يفعله هذا النزيل القزم هنا؟

132
00:11:03,710 --> 00:11:05,910
لقد نالَ ما يكفي

133
00:11:03,980 --> 00:11:07,100
لو كان نزيلاً لأوقفتكِ قبل أن تضربيه

134
00:11:08,990 --> 00:11:12,270
ما المشكلة؟ أردتُ أن ألعب معها

135
00:11:12,540 --> 00:11:14,970
هذا عمل ساكورا

136
00:11:15,540 --> 00:11:19,010
إنّها ليست مثلكم أنتم الأطفال الأثرياء
الذين لا يحتاجون للعمل

137
00:11:20,430 --> 00:11:24,010
سأمارس عملاً عظيماً عندما أكبر أيضاً

138
00:11:24,010 --> 00:11:25,660
هذا ما يقوله لي الجميع

139
00:11:26,060 --> 00:11:26,990
الجميع؟

140
00:11:27,210 --> 00:11:29,700
...أبي وأمّي وتاكاهاشي-سان

141
00:11:29,700 --> 00:11:32,160
من هو تاكاهاشي-سان؟

142
00:11:32,160 --> 00:11:34,590
أنا الطفل المُختار

143
00:11:35,050 --> 00:11:41,050
أنت موهوب يا كايتو. قد تصبح"
"أعظم حتّى من أبيك يوماً ما

144
00:11:41,050 --> 00:11:44,780
سأصبح أكثر نفعاً للناس ممّا سينفعها
ذلك العمل

145
00:11:45,740 --> 00:11:47,070
...كايتو-سان

146
00:11:49,810 --> 00:11:53,900
ألا تعتقد أنّه من المحزن أن يستخفّ شخصٌ

147
00:11:53,900 --> 00:11:58,780
سيؤدّي عملاً عظيماً في المستقبل
من عمل الآخرين؟

148
00:11:59,720 --> 00:12:01,180
رائع

149
00:12:01,180 --> 00:12:02,760
لم يسبق أن رأيتُ يوزو غاضبة

150
00:12:03,270 --> 00:12:04,620
هي غاضبة؟

151
00:12:04,620 --> 00:12:05,730
لا أراها كذلك

152
00:12:08,470 --> 00:12:09,780
أنا آسف

153
00:12:10,590 --> 00:12:11,960
كايتو

154
00:12:12,670 --> 00:12:14,080
أمّك تناديك

155
00:12:14,080 --> 00:12:15,070
أراكن لاحقاً

156
00:12:15,960 --> 00:12:17,330
لاحقاً"؟"

157
00:12:17,330 --> 00:12:19,100
أينوي العودة؟

158
00:12:33,190 --> 00:12:34,600
اختفى

159
00:12:36,320 --> 00:12:40,770
لا بدّ وأنني فقدتُ صوابي أخيراً

160
00:12:44,810 --> 00:12:47,000
كايتو، هل استيقظت؟

161
00:12:47,400 --> 00:12:49,990
أتريد أن تتمشّى مع أمّك وأبيك؟

162
00:12:55,250 --> 00:12:57,460
مرحى! ربِحت

163
00:12:58,420 --> 00:13:01,290
أصبحتَ سريعاً جداً يا كايتو

164
00:13:01,290 --> 00:13:04,520
لقد كبرت ونضجت جيّداً

165
00:13:05,880 --> 00:13:07,830
كان ذلك سريعاً للغاية

166
00:13:10,700 --> 00:13:13,230
لماذا تبكي يا أبي؟

167
00:13:18,020 --> 00:13:19,240
تاكاهاشي-سان

168
00:13:19,240 --> 00:13:20,270
مرحباً

169
00:13:21,090 --> 00:13:22,870
لنلعب

170
00:13:23,430 --> 00:13:25,430
كايتو، كيف حالك؟

171
00:13:25,430 --> 00:13:28,200
...أمّي وأبي قالا

172
00:13:28,200 --> 00:13:31,110
ألم تودّع أباك وأمّك بعد؟

173
00:13:34,250 --> 00:13:38,200
كايتو، ادرس جيّداً وكن رجلاً عظيماً

174
00:13:38,490 --> 00:13:41,720
جِد السّعادة مع عائلتك الجديدة

175
00:13:50,430 --> 00:13:52,340
هل وجدت شيئاً؟

176
00:13:53,080 --> 00:13:54,410
كايتو-سان

177
00:13:54,920 --> 00:13:56,650
ما الأمر؟

178
00:13:57,640 --> 00:14:00,190
هربتُ من المنزل

179
00:14:00,500 --> 00:14:01,590
هربت؟

180
00:14:02,910 --> 00:14:04,420
أكره هذا المكان

181
00:14:04,420 --> 00:14:06,170
أريد الذهاب إلى الدّيار

182
00:14:06,170 --> 00:14:07,910
لا يمكنك

183
00:14:07,910 --> 00:14:11,400
لم يكونا والديك الحقيقيّين

184
00:14:12,460 --> 00:14:16,120
لم أكن طفلاً حقيقيّاً

185
00:14:16,120 --> 00:14:18,440
لا يمكنني الذهاب إلى المنزلِ حيث أمّي

186
00:14:19,970 --> 00:14:25,870
جميعنا ندرس كي نمارس عملاً عظيماً
نساعد الناس به

187
00:14:26,360 --> 00:14:29,340
كلّنا أطفال مُختارون

188
00:14:29,880 --> 00:14:34,050
لا أملك حقَّ الاختيار

189
00:14:35,730 --> 00:14:37,150
...كايتو-سان

190
00:14:37,780 --> 00:14:40,680
أونيـه-تشان، لنهرب معاً

191
00:14:41,640 --> 00:14:42,980
سمعتُك أيّها الطفل الشقي

192
00:14:42,980 --> 00:14:44,950
أنت تحاول المناورة الآن

193
00:14:44,950 --> 00:14:45,880
!اذهب إلى المنزل

194
00:14:45,880 --> 00:14:46,860
!لا، لا

195
00:14:46,860 --> 00:14:48,570
!لن أعود أبداً

196
00:14:48,030 --> 00:14:50,220
!لن أذهب إلى المنزل أبداً

197
00:14:50,990 --> 00:14:52,030
ماذا؟

198
00:14:52,470 --> 00:14:55,210
تجاوزتَ تاريخَ إقامتك

199
00:14:55,210 --> 00:14:56,370
كفى يعني كفى

200
00:14:56,370 --> 00:14:58,210
أملك مالاً

201
00:14:58,210 --> 00:15:02,430
كم تريدين من مال يا صاحبة أذنيّ الجبين؟

202
00:15:02,430 --> 00:15:04,120
!أذنا الجبين؟

203
00:15:04,120 --> 00:15:06,260
!من جديد، ليس هنا بيت القصيد

204
00:15:06,260 --> 00:15:08,140
رين، سأتولّى هذا

205
00:15:09,660 --> 00:15:10,750
حسناً

206
00:15:11,720 --> 00:15:16,170
"مع فائق الاحترام، ما تدعوه بـ"المال

207
00:15:16,170 --> 00:15:20,050
هو ليس سوى مجرّد ورق مهدور في هذا العالم

208
00:15:23,010 --> 00:15:24,480
هكذا إذاً

209
00:15:24,480 --> 00:15:30,160
استيقظتُ بعد الحادثةِ ولم أفهم
لماذا أنا هنا

210
00:15:31,100 --> 00:15:34,280
فهمت... هذه الحياة الآخرة

211
00:15:34,280 --> 00:15:36,990
لا. ما زلتَ على قيدِ الحياة

212
00:15:36,990 --> 00:15:39,240
لذا اذهب إلى المنزلِ حالاً

213
00:15:39,240 --> 00:15:41,580
!كنتُ على وشك الموت

214
00:15:41,580 --> 00:15:43,800
كوني أكثر حناناً

215
00:15:44,060 --> 00:15:47,590
يبدو أنّ الجحيم لا يريدك بعد

216
00:15:47,590 --> 00:15:48,950
حاول مرّة أخرى

217
00:15:48,950 --> 00:15:51,440
تقولين هذا وكأنّني فشلتُ في مقابلةِ عمل

218
00:15:51,440 --> 00:15:53,200
وحقّاً؟ "جحيم"؟

219
00:15:54,270 --> 00:15:59,400
لا يمكنني العودة إلى حياتي القديمة
حتّى لو رجعتُ الآن

220
00:16:03,910 --> 00:16:06,230
لا تريد العودة إلى المنزلِ أيضاً يا عمّ؟

221
00:16:06,230 --> 00:16:08,030
أنت مثلي تماماً

222
00:16:08,590 --> 00:16:10,850
!أنا فوق، أنا فوق

223
00:16:11,440 --> 00:16:13,150
هكذا إذاً

224
00:16:13,370 --> 00:16:15,710
لهذا غادرتَ المنزل إذاً

225
00:16:16,260 --> 00:16:20,150
ظننتُ أنني قد أستطيع فعل اي شيء
عندما أكبر

226
00:16:20,670 --> 00:16:24,620
كان مستقبلي يسير وفق مسار
قد رسمَه لي شخصٌ آخر

227
00:16:25,130 --> 00:16:27,940
هذا وصفٌ راقٍ ودقيق للأمر

228
00:16:30,090 --> 00:16:31,590
اسمع يا فتى

229
00:16:32,720 --> 00:16:38,930
بدأتُ كسائق شاحنات وانتهى المطافُ بي
رئيساً لشركة نقليّات صغيرة

230
00:16:39,830 --> 00:16:42,320
كانت لديّ زوجة وطفل رائعان

231
00:16:42,320 --> 00:16:46,210
لم تكن تسير الحياة بسلاسةٍ مثاليّة، لكن
لم أكن أشتكي أيضاً

232
00:16:47,460 --> 00:16:53,590
إنّما حادثة صغيرة واحدة انقلبَتْ حياتي
على إثرها رأساً على عقب

233
00:16:57,220 --> 00:17:00,760
في النّهاية، كلّنا تحت قضاء اللّه وقدره

234
00:17:01,520 --> 00:17:04,680
أنت سليم الصحّة وصحيح البنية يا فتى

235
00:17:04,980 --> 00:17:06,770
لديك أملٌ ومستقبل

236
00:17:07,660 --> 00:17:09,710
لديك كلّ شيء لا أملكه أنا

237
00:17:11,250 --> 00:17:15,030
لكن لديك عائلة

238
00:17:16,280 --> 00:17:20,750
لم أكن طفلاً حقيقيّاً لأمٍّ وأب

239
00:17:22,260 --> 00:17:24,200
لم نكن عائلة حقيقيّة

240
00:17:23,610 --> 00:17:25,670
أنت مثلي تماماً إذاً

241
00:17:27,170 --> 00:17:31,030
ابنتي الوحيدة هي طفلة زوجتي

242
00:17:31,380 --> 00:17:35,580
كانت جافّة جدّاً وبعيدة عنّي في بادئ الأمر

243
00:17:35,580 --> 00:17:39,630
عجباً، لماذا الفتيات الصغيرات هكذا؟

244
00:17:39,630 --> 00:17:41,790
هل تسألني حقّاً؟

245
00:17:42,020 --> 00:17:46,270
استغرقَتْ وقتاً حتّى قبِلَتْني كعائلة لها

246
00:17:46,640 --> 00:17:48,290
ألهذا لا تريد العودة إلى المنزل؟

247
00:17:48,290 --> 00:17:49,460
!لا تكن غبيّاً

248
00:17:49,460 --> 00:17:52,450
لستُ تافهاً إلى هذا الحدّ

249
00:17:52,450 --> 00:17:54,500
ربّيتُها كما لو أنّها ابنتي

250
00:17:54,500 --> 00:17:58,190
دفعتُ الكثير لتعليمها كي تتمكّن من ارتياد
مدرسة فنون أو ما شابه

251
00:17:58,190 --> 00:18:00,550
انتقلَتْ إلى مكانٍ آخر الآن وتستمتع
بما تقوم به

252
00:18:01,230 --> 00:18:04,120
لمَ لا تريد الذهاب إلى المنزلِ إذاً؟

253
00:18:04,120 --> 00:18:06,260
إنّها تنتظرك على الأرجح يا عمّ

254
00:18:08,080 --> 00:18:09,380
ماذا تريدين؟

255
00:18:10,280 --> 00:18:12,860
كيف تتوقّع منّي أن أذهب إلى المنزل؟

256
00:18:13,200 --> 00:18:16,970
أصبحنا عائلة بناءً على وعدٍ بأنّني
سوف أسعدهما

257
00:18:17,970 --> 00:18:21,330
سأكون عبئاً عليهما من الآن فصاعداً

258
00:18:21,660 --> 00:18:24,140
بأي وجه أنظر إليهما؟

259
00:18:26,190 --> 00:18:30,350
هيّا يا عزيزي. حان وقتُ الاستيقاظ، أرجوك

260
00:18:30,970 --> 00:18:36,220
خدمتهما جيّداً كرجل، كأب

261
00:18:36,650 --> 00:18:41,030
يمكنني إنهاء الأمر الآن لتبقى حياة جميلة

262
00:18:41,030 --> 00:18:43,000
ألا تعتقدين هذا يا آنسة ثعلب؟

263
00:18:43,510 --> 00:18:46,790
في النّهاية، كلّنا تحت قضاء اللّه وقدره

264
00:18:46,790 --> 00:18:49,030
أليس هذا ما قلته؟

265
00:18:49,410 --> 00:18:51,860
أنت تحاول جاهداً جدّاً لتبدو رائعاً

266
00:18:52,950 --> 00:18:55,450
تبدين مثل زوجتي

267
00:18:55,450 --> 00:18:59,270
بالفعل، كأنّني أسمع تذمُّرَ زوجتك

268
00:19:00,270 --> 00:19:04,490
تزوّجَتْك وهي تعلم طبيعتك كرجُل

269
00:19:04,800 --> 00:19:08,010
أنت الشخص الوحيد الذي يعتقد أنّهما
لم يفهما طبعك

270
00:19:08,350 --> 00:19:11,570
استسلم فحسب وعُد إلى قضائك
وقدرك بالتواجد مع زوجتك

271
00:19:13,580 --> 00:19:16,990
!اللّعنة! لن أعود إلى هنا أبداً

272
00:19:16,990 --> 00:19:17,650
بالطبع

273
00:19:17,650 --> 00:19:19,500
شكراً لزيارتك

274
00:19:20,620 --> 00:19:22,410
أتمنّى لك السلامة أيّها الشقيّ

275
00:19:23,090 --> 00:19:25,630
نحن نتشارك رابطاً غريباً

276
00:19:26,860 --> 00:19:28,910
أراك في الأرجاء

277
00:19:35,220 --> 00:19:36,820
أنا ذاهب إلى المنزل

278
00:19:36,820 --> 00:19:39,500
هل تشعر بارتياحٍ أكبر حيال وضعك الآن؟

279
00:19:45,090 --> 00:19:53,490
لا أعلم بشأنِ مستقبلي أو ما شابه، لكن أريد
أن أدرس بجدٍّ وأصبح قادراً على المساعدة

280
00:19:59,010 --> 00:20:03,520
!قلتُ لك. شعري لم ينمُ بعد

281
00:20:03,520 --> 00:20:05,340
!عودي إلى هنا

282
00:20:06,310 --> 00:20:07,110
!يا أطفال

283
00:20:07,110 --> 00:20:09,600
لا مانع أن تمرحوا وتلعبوا، لكن
لا تهيموا إلى غرفةِ نزيل

284
00:20:10,230 --> 00:20:14,940
على ذكرِ ذلك، أتذكران ذلك الفتى؟

285
00:20:14,940 --> 00:20:16,570
لا أتذكّر

286
00:20:18,680 --> 00:20:19,740
يوزو-تشان

287
00:20:21,200 --> 00:20:23,510
كايتو-سان، أهذا أنت؟

288
00:20:23,790 --> 00:20:24,600
لم أركِ منذ وقت طويل

289
00:20:24,600 --> 00:20:27,410
أصبحتِ صغيرة جدّاً يا يوزو-تشان

290
00:20:27,410 --> 00:20:30,460
أنت من نما يا كايتو-سان

291
00:20:30,460 --> 00:20:32,250
هي أحوالك بخير؟

292
00:20:32,250 --> 00:20:35,200
أجل، حصلتُ على عائلةٍ جديدة

293
00:20:37,690 --> 00:20:39,740
سيغادر أبي الآن

294
00:20:39,740 --> 00:20:40,740
عليّ العودة

295
00:20:43,240 --> 00:20:45,110
وداعاً يا يوزو-تشان

296
00:20:47,770 --> 00:20:49,890
وداعاً؟

297
00:20:49,890 --> 00:20:51,870
ليس "أراك ثانية"؟

298
00:20:52,230 --> 00:20:53,640
أنتِ تتذكّرينه إذاً

299
00:20:54,120 --> 00:20:58,580
لا بدَّ وأنّه عثر على ما كان يبحث عنه

300
00:21:01,060 --> 00:21:02,120
كايتو

301
00:21:04,740 --> 00:21:05,700
كايتو

302
00:21:06,090 --> 00:21:08,040
هل استيقظت يا كايتو؟

303
00:21:08,040 --> 00:21:09,880
لنذهب ونتسوّق

304
00:21:11,650 --> 00:21:12,740
جذّاب للغاية

305
00:21:13,110 --> 00:21:16,180
هل هذه صورٌ لكايتو عندما كان جرواً؟

306
00:21:16,180 --> 00:21:19,560
التقط المتطوّعون صوراً كثيرة لنا

307
00:21:20,310 --> 00:21:22,520
لم يستطع التأقلم مع أجواء مركز
التّدريب في بادئ الأمر

308
00:21:22,520 --> 00:21:25,160
لم نكن متأكّدين ممّا إذا كان يستوفي الشروط

309
00:21:25,540 --> 00:21:27,550
نما بشكلٍ رائع

310
00:21:28,140 --> 00:21:35,110
بات زوجي منعزلاً تماماً منذ فقدَ بصره
على إثر الحادثة

311
00:21:35,520 --> 00:21:39,600
يبدو أنّ السّعادة تغمره منذ جاء
كايتو إلى هنا

312
00:21:40,480 --> 00:21:43,440
البحر على شاطئ الثّعلب

313
00:21:40,910 --> 00:21:45,540
،باتت الحياة موحشة منذ رحلت ابنتنا

314
00:21:43,440 --> 00:21:45,530
بواسطة: ماتسوموتو ري

315
00:21:46,210 --> 00:21:49,310
لكن لدينا فتى صغير جميل الآن

316
00:21:50,590 --> 00:21:53,810
حسناً يا رفيقي. أعتمد عليك

317
00:21:57,580 --> 00:21:58,350
!انطلق