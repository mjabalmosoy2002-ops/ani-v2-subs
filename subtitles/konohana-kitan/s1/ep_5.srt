1
00:00:09,000 --> 00:00:14,310
،من خلال رواق مُظلِم كان ينبغي أن يكون فارغاً

2
00:00:15,440 --> 00:00:22,720
تمشي طفلةٌ مُصدِرةً صوت جرّ وتنقيط مُزعج

3
00:00:25,290 --> 00:00:27,940
بشرتها شاحِبة تماماً

4
00:00:31,560 --> 00:00:36,500
وتحدّق بعينيها الزجاجيّتين الباردتين

5
00:00:41,330 --> 00:00:42,930
أو هذا ما ظننتُه

6
00:00:48,700 --> 00:00:51,080
كيف حدث هذا؟

7
00:02:27,040 --> 00:02:31,540
كونوهاناتي

8
00:02:28,830 --> 00:02:31,530
أيّها الكاهن، ما هذه الدّمية؟

9
00:02:31,790 --> 00:02:34,220
قيل لي أنّها ملعونة

10
00:02:34,220 --> 00:02:36,550
فطُلِبَ منّي تطهيرها

11
00:02:36,550 --> 00:02:43,290
رغم أنّ كلّ ما تفعله هو التكلّم والتحرّك
وشعرها ينمو

12
00:02:43,290 --> 00:02:46,400
هل يمكنكِ أن تقلبي الطاولات
أو ترمي الصّحون أو ما شابه؟

13
00:02:46,400 --> 00:02:50,340
لا يقوم بعملٍ شرّير غير راقٍ كهذا سوى
دُمية همجيّة

14
00:02:50,720 --> 00:02:53,180
هذا مملّ

15
00:02:53,180 --> 00:02:55,310
هذه وقاحةٌ يا ناتسومي-تشان

16
00:02:55,520 --> 00:02:57,570
لا داعي أن تكوني قادرة على فعل أشياء شرّيرة

17
00:02:57,570 --> 00:03:00,400
تبقين عظيمة بوضعكِ الرّاهن

18
00:03:04,320 --> 00:03:07,260
قد يكون لطفكِ قاسياً أحياناً

19
00:03:07,740 --> 00:03:10,290
هل أخطأتُ بكلامي؟

20
00:03:11,030 --> 00:03:13,190
هل ينخلع ذراعاكِ أو ساقاكِ

21
00:03:13,190 --> 00:03:15,590
بينما تفعلين هذا وتتحوّلين؟

22
00:03:14,630 --> 00:03:15,750
!مُحال

23
00:03:16,060 --> 00:03:18,640
ما خطب هؤلاء؟

24
00:03:18,640 --> 00:03:22,460
عادة ما أبكي النّاس بمجرّد مروري
في الرّواق ليلاً

25
00:03:22,460 --> 00:03:23,720
!هذا مُهين

26
00:03:23,970 --> 00:03:26,570
أصبح شعركِ طويلاً جدّاً يا أوكيكو-تشان

27
00:03:26,570 --> 00:03:28,520
اسمكِ هو أوكيكو-سان؟

28
00:03:28,520 --> 00:03:30,180
!لا تلفّقي اسماً لي

29
00:03:30,410 --> 00:03:32,980
ساكورا، لديكِ مقصّ، صحيح؟

30
00:03:32,980 --> 00:03:34,390
ينبغي أن تقصّيه لها

31
00:03:40,670 --> 00:03:44,190
!ا-انتظري! لا ينبغي أن يلعب الأطفال بسكاكين

32
00:03:46,420 --> 00:03:48,110
لا تقلقي

33
00:03:48,280 --> 00:03:49,450
...عيناها

34
00:03:50,440 --> 00:03:52,290
إنّهما تخيفانني

35
00:03:52,290 --> 00:03:55,020
هذه أوّل مرّة أرى فيها ساكورا-تشان تبتسم

36
00:03:55,020 --> 00:03:56,740
لا تقاومي وإلّا تأذّيتِ

37
00:03:58,670 --> 00:04:04,710
دعوا شخصاً آخر يفعلها على الأقلّ

38
00:04:12,450 --> 00:04:15,510
ألم تكن دُمية ابنة أخيك تشبه هذه؟

39
00:04:15,510 --> 00:04:17,710
كانت أنيقة جدّاً في الواقع

40
00:04:17,710 --> 00:04:18,990
مُستحدثة للغاية

41
00:04:18,990 --> 00:04:20,920
...فـ-في الحقيقة

42
00:04:21,310 --> 00:04:22,170
سينمو من جديد

43
00:04:22,170 --> 00:04:26,210
لا تقولي كلاماً كما لو أنّني طفلة قصّت غرّتها
كثيراً ولا تستطيع الذهاب إلى المدرسة

44
00:04:28,310 --> 00:04:29,330
ما الذي يجري؟

45
00:04:29,330 --> 00:04:30,440
ثمّة ضوضاء هناك

46
00:04:30,440 --> 00:04:32,910
!أنا دُمية رفيعة الجودة

47
00:04:32,910 --> 00:04:35,570
!صُنِعتُ بواسطة حِرفيّ معلّم

48
00:04:35,570 --> 00:04:39,680
ما غايتي كدُمية إذا كنتُ قبيحة للغاية؟

49
00:04:42,210 --> 00:04:45,670
هذه الطريقة الانهزاميّة في التفكير
هي ما تجعلكِ قبيحة

50
00:04:45,970 --> 00:04:50,680
اسمعي، إذا كان مجرّد ولادتكِ كفتاةٍ تجعلكِ
جميلة تلقائيّاً لغدَتِ الحياةُ سهلة

51
00:04:50,680 --> 00:04:53,520
تصبح النّساء نساءً من خلال
الأدب والعمل الدّؤوب

52
00:04:53,520 --> 00:04:55,820
ساكورا-تشان، أعطيني المقصّ

53
00:05:01,960 --> 00:05:03,990
يا لها من مهارةٍ مدهشة

54
00:05:06,330 --> 00:05:08,400
حتّى أنّها تقوم بتجميلها

55
00:05:16,680 --> 00:05:19,050
أهذه أنا؟

56
00:05:19,490 --> 00:05:22,470
!أصبحتُ دمية مختلفة تماماً

57
00:05:22,470 --> 00:05:23,970
تحتاج الآن لعباءةِ كيمونو

58
00:05:23,970 --> 00:05:24,910
أجل

59
00:05:24,910 --> 00:05:25,710
!اسمعنني

60
00:05:26,850 --> 00:05:29,670
أعجبني هذا الحِزام العريض، لكن لنستخدم هذا

61
00:05:32,950 --> 00:05:35,280
لا داعي لتفعلي هذا لأجلي

62
00:05:35,280 --> 00:05:38,210
ناتشان، هل يمكنكِ إحضار عدّة الحياكة خاصّتي؟

63
00:05:38,210 --> 00:05:39,240
حسناً

64
00:05:41,430 --> 00:05:43,330
استخدمي ملابسي القديمة أيضاً

65
00:05:43,940 --> 00:05:45,510
شكراً لكِ

66
00:05:45,510 --> 00:05:47,810
أعتقد لديّ بعض البقايا أيضاً

67
00:05:49,030 --> 00:05:50,700
ساكورا، أنتِ أيضاً؟

68
00:05:52,650 --> 00:05:53,830
!أنا أيضاً

69
00:05:53,830 --> 00:05:55,580
لا تمتلكين عباءة كيمونو

70
00:05:55,580 --> 00:05:57,490
لا تقلقي حيال الأمر

71
00:05:57,490 --> 00:05:59,790
هل يمكنني المُساعدة في الحياكة إذاً؟

72
00:05:59,790 --> 00:06:01,290
أيمكنكِ؟

73
00:06:01,290 --> 00:06:04,240
أجل، علّمتني بيكوني-ساما ذلك

74
00:06:04,240 --> 00:06:06,530
هل يمكنكِ عمل هذه الكشكشة إذاً؟

75
00:06:06,530 --> 00:06:08,040
كـ-كشكشة؟

76
00:06:14,780 --> 00:06:17,610
أنتِ خرقاء جدّاً يا يوزو-تشان

77
00:06:17,610 --> 00:06:18,390
دعيها لي

78
00:06:18,390 --> 00:06:21,180
آسفة. لم أعمل على الكشكشة من قبل

79
00:06:21,180 --> 00:06:23,330
كان ينبغي أن تقولي ذلك إذاً

80
00:06:23,330 --> 00:06:26,410
لكن تجيدين الخياطة بشكلٍ عام

81
00:06:27,990 --> 00:06:30,200
لديكِ عينان جميلتان

82
00:06:31,380 --> 00:06:36,520
غشاء عينكِ الخارجي لامِع، وبشرتكِ
ناصعة البياض وصافية

83
00:06:39,830 --> 00:06:45,010
لا بدّ وأنّكِ صُنِعتِ بعنايةٍ كبيرةٍ
لتكوني فتاة مميّزة

84
00:06:45,970 --> 00:06:49,130
مقرف! الدُّمى اليابانيّة مخيفة جدّاً

85
00:06:49,570 --> 00:06:53,040
أعطتنا إيّاها أمّنا بمناسبةِ حفيدتها الأولى

86
00:06:53,040 --> 00:06:54,350
ماذا عسانا أن نفعل؟

87
00:06:55,000 --> 00:06:57,390
إنّها مُعقَّدة جدّاً

88
00:06:57,390 --> 00:06:59,130
خاصّة العينين

89
00:06:59,130 --> 00:07:01,330
وكأنّها تحدِّق بنا

90
00:07:01,990 --> 00:07:04,320
ضعها في الخزانة أو أي مكان

91
00:07:04,680 --> 00:07:06,040
آسف يا صغيرة

92
00:07:22,860 --> 00:07:23,920
!أمّي

93
00:07:24,250 --> 00:07:26,590
!أرجوكِ يا أمّي

94
00:07:26,590 --> 00:07:28,640
اشتري لي دميةً أنيقة

95
00:07:28,640 --> 00:07:30,470
على أن تكون ذات شعبيّة

96
00:07:30,470 --> 00:07:32,410
اشتري لي واحدة أيضاً

97
00:07:32,410 --> 00:07:34,650
حسناً، سأفعل

98
00:07:35,000 --> 00:07:36,290
!مرحى

99
00:07:41,870 --> 00:07:44,750
...أتريدين

100
00:07:47,470 --> 00:07:49,110
أن تلعبي معي؟

101
00:07:55,950 --> 00:07:59,050
نامَتْ

102
00:07:59,050 --> 00:08:00,980
الدّمى تنام أيضاً؟

103
00:08:00,980 --> 00:08:04,330
لا توقظها يا أورينوسكي

104
00:08:06,620 --> 00:08:07,830
...فليلعب

105
00:08:10,640 --> 00:08:12,090
معي أحد

106
00:08:32,560 --> 00:08:34,980
آسفة لأنّنا لم نخدمك كثيراً

107
00:08:34,980 --> 00:08:35,940
على الإطلاق

108
00:08:36,190 --> 00:08:38,170
شكراً لمُساعدتكن

109
00:08:38,590 --> 00:08:39,780
...المعذرة

110
00:08:39,780 --> 00:08:41,910
ماذا عن التّطهير؟

111
00:08:41,910 --> 00:08:45,120
تقصدين تطهير تلك الدّمية؟

112
00:08:45,450 --> 00:08:47,770
لمَ عليّ ارتداء زيّ نادلة؟

113
00:08:48,160 --> 00:08:49,950
أنتِ تشتكين كثيراً

114
00:08:49,950 --> 00:08:51,850
إنّه يليق بكِ

115
00:08:53,910 --> 00:08:56,730
!لا

116
00:08:56,730 --> 00:08:59,840
لقد تمّ تطهيرها أكثر ممّا يكفي

117
00:09:10,410 --> 00:09:11,750
هكذا إذاً

118
00:09:12,780 --> 00:09:15,860
لا يمكنني رفض طلب من الكاهن

119
00:09:16,360 --> 00:09:18,190
ما اسمك؟

120
00:09:18,190 --> 00:09:21,070
أنا... لا أملك اسماً في الواقع

121
00:09:21,410 --> 00:09:22,860
اسمها أوكيكو

122
00:09:23,700 --> 00:09:24,610
أوكيكو

123
00:09:24,610 --> 00:09:25,300
!نعم

124
00:09:25,300 --> 00:09:28,270
عليكِ أن تعملي بجدٍّ كخادمة

125
00:09:30,480 --> 00:09:33,370
منذ متى تقرّر أنّ عليّ أن أعمل؟

126
00:09:33,590 --> 00:09:36,840
لا يمكننا أن ندعكِ تبقين عبثاً

127
00:09:36,840 --> 00:09:41,050
أنا دُمية يابانيّة عالية الجودة صُنِعتُ
!بواسطةِ حِرفيّ معلّم

128
00:09:41,050 --> 00:09:44,490
لا تبدين دُمية يابانيّة

129
00:09:44,490 --> 00:09:47,260
وهل أنا خادمة بالتحديد؟

130
00:09:47,260 --> 00:09:48,570
!هذا مُهين

131
00:09:48,570 --> 00:09:50,340
هل تريدين الذهاب إلى المعبد لتطهيركِ؟

132
00:09:50,340 --> 00:09:51,160
لا أريد

133
00:09:51,160 --> 00:09:52,750
حسناً، حُسِمَ الأمر إذاً

134
00:09:52,750 --> 00:09:55,190
مهلاً! لمَ تحسمين الأمر؟

135
00:09:55,190 --> 00:09:57,700
!هذا غير منطقي بالنسبة لي

136
00:09:55,420 --> 00:09:57,360
...لمَ لا تبدئين

137
00:09:57,700 --> 00:09:58,910
يوزو

138
00:09:58,910 --> 00:10:00,800
نعم؟ هل يمكنني خدمتك؟

139
00:10:00,800 --> 00:10:02,860
علّمي أوكيكو كيف تقوم بعملها من فضلِك

140
00:10:02,860 --> 00:10:04,980
حسناً، عُلِم

141
00:10:05,580 --> 00:10:08,040
كونوهاناتي

142
00:10:08,640 --> 00:10:11,420
يوزو-تشان، أيمكنكِ أن تحضري لي منشفة وجه؟

143
00:10:11,420 --> 00:10:13,510
إنّها تُمطِر بغزارة أكبر حتّى

144
00:10:13,510 --> 00:10:14,870
هذا سيّئ

145
00:10:15,130 --> 00:10:17,220
أنتظر انتهاء موسم الأمطار بفارغ الصّبر

146
00:10:17,220 --> 00:10:19,180
انتهى في أماكن أخرى بالفعل

147
00:10:19,180 --> 00:10:21,170
لماذا ما تزال تُمطر هنا؟

148
00:10:21,170 --> 00:10:24,630
ذهبَتْ يوزو إلى الكوخ مع أوكيكو

149
00:10:25,050 --> 00:10:26,350
الكوخ؟

150
00:10:26,350 --> 00:10:29,650
لأجلِ ذلك النزيل

151
00:10:31,560 --> 00:10:36,580
تسليم الوجبات هو جزءٌ مهمٌّ في عملنا
مفهوم يا أوكيكو-تشان؟

152
00:10:36,580 --> 00:10:39,200
التصقَ بي هذا الاسم الآن

153
00:10:39,400 --> 00:10:41,790
لكن لماذا يقيم النزيل في كوخ؟

154
00:10:41,790 --> 00:10:43,910
بدا وكأنّ كان لدينا كثير من الغرف الشاغرة

155
00:10:43,910 --> 00:10:45,030
...في الواقع

156
00:10:48,400 --> 00:10:52,320
لأنّ هذا كوخ نسج

157
00:11:04,660 --> 00:11:06,170
المعذرة

158
00:11:20,810 --> 00:11:22,640
أحضرتُ غداءك

159
00:11:22,640 --> 00:11:23,780
اتركيه هناك من فضلك

160
00:11:25,150 --> 00:11:29,080
أليس هذا فطوراً؟

161
00:11:29,420 --> 00:11:31,680
لا تتعبي نفسكِ بترتيبِ الغرفة
كثيراً أيضاً

162
00:11:32,030 --> 00:11:33,500
لا تعترضي سبيلي

163
00:11:33,500 --> 00:11:35,890
—انتظري! هل عليكِ أن تتكلّمي بهذه الطـ

164
00:11:36,270 --> 00:11:38,040
المعذرة

165
00:11:55,760 --> 00:11:57,900
ما هذا السّلوك؟

166
00:11:58,230 --> 00:12:03,360
لا بدّ وأنّها كانت تركّز على عملِها
كثيراً لدرجة أنّها لا تلاحظ شيئاً آخر

167
00:12:03,360 --> 00:12:04,960
أهي كذلك حقّاً؟

168
00:12:04,960 --> 00:12:08,610
لكن لم تلمس طعامها إطلاقاً أيضاً

169
00:12:18,910 --> 00:12:22,600
في الحقيقة، بالكاد قد أكلت شيئاً البارحة كذلك

170
00:12:22,600 --> 00:12:25,770
ستنهار تماماً إذا ظلّت هكذا

171
00:12:25,770 --> 00:12:27,160
ماذا نفعل؟

172
00:12:27,160 --> 00:12:29,800
إنّها نزيلة خاصّة

173
00:12:29,800 --> 00:12:31,300
خاصّة؟

174
00:12:31,300 --> 00:12:34,170
سأفكّر في الأمر

175
00:12:34,170 --> 00:12:35,460
شكراً لك

176
00:12:45,020 --> 00:12:46,650
ما الأمر يا يوزو؟

177
00:12:46,650 --> 00:12:47,980
لا شيء

178
00:12:49,870 --> 00:12:51,690
هذا كلحنٍ مُصاحِب

179
00:12:51,690 --> 00:12:52,860
مُصاحِب؟

180
00:12:54,950 --> 00:12:56,480
ذلك الصّوت

181
00:12:57,160 --> 00:12:59,760
لم أكن من تمّ اختيارها لتُصبِح كاهنة

182
00:13:00,540 --> 00:13:02,870
لا تخالي أنّني استسلمت

183
00:13:03,210 --> 00:13:06,420
،حالما تسنح لي فُرصةٌ للاستقالة
سأسعى لأصبح كاهنة مجدّداً

184
00:13:09,010 --> 00:13:10,470
معكِ حقّ

185
00:13:15,130 --> 00:13:16,680
هذا لإيوري؟

186
00:13:16,680 --> 00:13:20,230
سيكون أكله سهلاً حتّى لو كانت مشغولة

187
00:13:20,230 --> 00:13:21,440
بواسطتي؟

188
00:13:21,440 --> 00:13:25,730
يا للهول! لا يمكنكِ حتّى أداء هذا العمل السّهل بنفسكِ؟

189
00:13:25,980 --> 00:13:28,990
تحتاجين لكثير من الخبرة حقّاً

190
00:13:28,990 --> 00:13:31,070
أستطيع! هذا ليسَ صعباً إلى هذا الحدّ

191
00:13:31,070 --> 00:13:32,510
لا تعامليني كغبيّة

192
00:13:34,220 --> 00:13:36,750
،لا أمانع تقديمه

193
00:13:38,500 --> 00:13:40,660
لكن لا أشعر برغبةٍ في ذلك

194
00:13:58,100 --> 00:13:59,460
أوكيكو-تشان؟

195
00:13:59,460 --> 00:14:02,060
!خذي هذا إلى النزيلةِ في الكوخ من فضلك

196
00:14:02,470 --> 00:14:03,700
حـ-حسناً

197
00:14:04,940 --> 00:14:09,290
!لا أريد أن يُقصّ شعري بعد الآن

198
00:14:29,080 --> 00:14:30,300
المعذرة

199
00:14:37,740 --> 00:14:40,510
أحضرتُ كرات أرزّ

200
00:14:40,510 --> 00:14:42,040
لم أطلبه

201
00:14:42,040 --> 00:14:45,790
تأمل رئيسة الخدم أن يكون أكلها أسهل

202
00:14:46,350 --> 00:14:47,670
سآكلها لاحقاً

203
00:14:47,670 --> 00:14:48,700
ضعيه هناك

204
00:15:43,420 --> 00:15:45,240
!هذا رائعٌ للغاية

205
00:15:45,240 --> 00:15:47,100
لم يُنجَز هذا بعد

206
00:15:47,100 --> 00:15:49,380
سيكون أكثر جمالاً عندما يُنجَز

207
00:15:49,380 --> 00:15:54,720
لا، أعني النّسيج جميل، لكن طريقة استخدامكِ
يديكِ مذهلة أيضاً

208
00:15:54,720 --> 00:15:56,170
هذا فاتِن

209
00:16:17,180 --> 00:16:19,490
كان كما قالت ساتسكي-تشان بالضبط

210
00:16:36,590 --> 00:16:38,090
...ا-المعذرة

211
00:16:38,490 --> 00:16:43,860
كان صوت الحِياكة أشبه بموسيقا، لهذا
وجدتُ نفسي أغنّي معه تلقائياً

212
00:16:44,500 --> 00:16:46,090
أ-أنا آسفة

213
00:16:46,090 --> 00:16:47,600
اعذريني على تدخّلي

214
00:16:46,700 --> 00:16:47,600
لا عليكِ

215
00:16:49,590 --> 00:16:52,810
لقد سئمتُ من سماعِ صوت المطر

216
00:16:52,810 --> 00:16:54,850
هل يمكنكِ البقاء والغناء لبعضِ الوقت؟

217
00:16:56,150 --> 00:16:56,950
أحم

218
00:18:16,880 --> 00:18:19,150
!إنّه يتشكّل أمام عينيّ

219
00:18:19,150 --> 00:18:20,380
!مُذهل

220
00:18:20,380 --> 00:18:23,040
لا، هذا ليس جيّداً بما يكفي

221
00:18:23,910 --> 00:18:27,240
أختي الكبرى تعمل أسرع منّي

222
00:18:27,240 --> 00:18:29,470
أنهَتْه قبل أن أنهيه

223
00:18:29,940 --> 00:18:32,910
وأختي الصّغرى أبرع في استخدام يديها

224
00:18:32,910 --> 00:18:34,430
يمكنها أن تنسج بجودةٍ أعلى

225
00:18:35,240 --> 00:18:43,030
أنا لا هذا ولا ذاك، لذا أريد أن أصبح قادرة
على النسجِ بشكلٍ أفضل وأسرع منهما

226
00:18:46,670 --> 00:18:52,830
لكن كلّ أخت من أختيكِ لا تتمتّع بالجودةِ
والسّرعة معاً في آن واحد، أليس كذلك؟

227
00:18:54,470 --> 00:18:59,530
لا أعرف أختيكِ، لهذا لا أعرف كيف أقارن بينكن

228
00:18:59,860 --> 00:19:05,240
لكن من المُثير حقّاً رؤية السّترة المطريّة
تتشكّل بواسطةِ يديكِ

229
00:19:06,230 --> 00:19:11,050
لا بدّ وأنّ نسج خيوط السّترة المطريّة
يستغرق وقتاً طويلاً جداً

230
00:19:11,390 --> 00:19:14,080
إنّه ليس شيئاً بمقدوري تعلّمه، صحيح؟

231
00:19:14,080 --> 00:19:20,100
هذا شيء وحدنا نحن الأخوات نستطيع نسجه
لأنّنا نخدم الآلهة السّماويين

232
00:19:20,100 --> 00:19:22,180
لا يمكن أن يكون أي شخص آخر

233
00:19:22,180 --> 00:19:25,890
إذاً هذه هِبة لآلهة السّماء؟

234
00:19:27,090 --> 00:19:29,570
ألهذا أنتِ على عجلةٍ من أمركِ لإنجازها؟

235
00:19:30,010 --> 00:19:32,150
إنّها جميلةٌ للغاية

236
00:19:32,150 --> 00:19:35,520
أتمنّى رؤيتها عمّا قريب

237
00:19:39,210 --> 00:19:40,480
معكِ حقّ

238
00:19:41,020 --> 00:19:44,440
آمل أن تنال على إعجابهم

239
00:19:45,230 --> 00:19:48,070
لكن لم تنُجَز بعد

240
00:19:48,070 --> 00:19:49,920
ستنتهي عمّا قريب

241
00:19:50,420 --> 00:19:52,880
سأدعكِ تكونين أوّل من يراها. هذا سرّ بيننا

242
00:19:52,880 --> 00:19:53,760
حسناً

243
00:20:30,440 --> 00:20:33,080
لا تُجهدي نفسكِ كثيراً من فضلك

244
00:20:33,470 --> 00:20:37,600
احرصي على الأكلِ عندما تجوعين
واستريحي عندما تتعبين

245
00:20:40,650 --> 00:20:41,870
بونيتو مجفّف

246
00:20:45,540 --> 00:20:50,390
كلي عندما تجوعين واستريحي عندما تتعبين

247
00:20:51,930 --> 00:20:54,540
بهذا الشّكل، يمكنكِ المتابعة

248
00:21:02,730 --> 00:21:04,770
حسناً. سأعمل بجدّ

249
00:21:15,830 --> 00:21:17,530
أُنجِزَتْ؟

250
00:21:17,870 --> 00:21:19,540
!تهانينا

251
00:21:20,050 --> 00:21:21,830
خذي. أمسكي بهذا الطرف

252
00:21:23,330 --> 00:21:25,080
لا تفلتيه

253
00:21:26,090 --> 00:21:27,260
ها نحن ذا

254
00:21:29,970 --> 00:21:31,750
...استعداد

255
00:21:53,440 --> 00:21:54,320
انظرن

256
00:21:54,810 --> 00:21:56,490
أصبح الجوّ صحواً أخيراً

257
00:21:56,950 --> 00:21:59,730
حان الصّيف أخيراً