1
00:00:04,350 --> 00:00:05,680
!ما معنى هذا؟

2
00:00:05,680 --> 00:00:08,680
يوزو بارعة جدّاً في عملها

3
00:00:08,680 --> 00:00:10,890
أقول لكِ خذي استراحة

4
00:00:10,890 --> 00:00:13,590
أنتِ مخلصةٌ للعملِ بما يكفي الآن

5
00:00:13,590 --> 00:00:15,500
أنا من يقرّر ذلك

6
00:00:15,500 --> 00:00:16,610
أنا بأتمّ صحّة

7
00:00:16,610 --> 00:00:17,600
أنا بخير

8
00:00:17,600 --> 00:00:19,860
من سيحلّ مكاني على أي حال؟

9
00:00:19,860 --> 00:00:22,320
هذا ليس ما تقرّرينه أنتِ

10
00:00:23,020 --> 00:00:25,640
اسمعي، ستأخذين إجازةً غداً

11
00:00:26,950 --> 00:00:29,490
،أقدّر مشاعركِ يا ساتسكي

12
00:00:30,020 --> 00:00:35,070
لكن لن تخرجي من كونوهاناتي فقط
لأنّكِ تعملين بجدّ

13
00:00:44,980 --> 00:00:46,470
...المعذرة

14
00:00:48,000 --> 00:00:54,490
هل تعاني ساتسكي-تشان من مُشكلة؟

15
00:02:32,550 --> 00:02:37,250
لكن لن تخرجي من كونوهاناتي فقط
لأنّكِ تعملين بجدّ

16
00:02:45,260 --> 00:02:47,170
أعلم ذلك

17
00:02:48,410 --> 00:02:54,840
لكن كلّما أهدرتُ وقتاً، تخلّفتُ
عنها أكثر

18
00:02:59,840 --> 00:03:01,580
!ما هذا؟

19
00:03:02,040 --> 00:03:03,550
إنّه حمّام بأزهار الكرز

20
00:03:04,880 --> 00:03:08,530
سمعتُ أنّنا سنفرّغ هذا الماء غداً

21
00:03:08,530 --> 00:03:09,960
آمل أن تستمتعي به

22
00:03:17,250 --> 00:03:19,940
لم أشرب السّاكي في حمّام في الهواء
الطلق من قبل

23
00:03:19,940 --> 00:03:22,060
مع أنّ كيري تفعل ذلك طوال الوقت

24
00:03:22,060 --> 00:03:23,970
ألا تحبّين السّاكي؟

25
00:03:24,470 --> 00:03:25,940
لا أشرب ليلاً

26
00:03:25,940 --> 00:03:28,850
عادة ما أعمل على التّخطيط والتّحضير
لليوم التالي

27
00:03:28,850 --> 00:03:31,190
يمكنكِ الحصول على نومٍ هانئ
اللّيلة إذاً

28
00:03:33,600 --> 00:03:34,740
صحيح

29
00:03:35,130 --> 00:03:38,660
لستُ بحاجةٍ للتفكير في أي شيء اليوم

30
00:03:42,330 --> 00:03:44,750
سيطلعُ البدرُ قريباً

31
00:03:47,100 --> 00:03:49,750
متى توقّفتُ عن تأمُّل السّماء؟

32
00:03:49,750 --> 00:03:55,460
يمضي العالم للأمام مهما فعلنا

33
00:03:58,790 --> 00:04:03,480
إذا شحتِ بنظركِ بشكلٍ خاطفٍ للأسفل
سُرعان ما سيختلف المشهد

34
00:04:04,420 --> 00:04:08,680
من المُخجِل عدم إدراك ذلك

35
00:04:11,250 --> 00:04:13,880
مُخجِل؟

36
00:04:15,280 --> 00:04:21,770
هذه أيضاً من بقايا الرّبيع الذي مضى
بينما كنتُ أنظر للأسفل

37
00:04:25,990 --> 00:04:28,630
أتريدين أن تقومي بكلّ هذا العمل؟

38
00:04:28,630 --> 00:04:30,190
أنا متأكّدةٌ أنّكِ مُتعبة أيضاً

39
00:04:30,190 --> 00:04:31,410
أنا بخير

40
00:04:31,410 --> 00:04:34,160
لديّ إجازةٌ غداً أيضاً

41
00:04:42,820 --> 00:04:44,640
!زهور

42
00:04:45,160 --> 00:04:47,570
!انسي ذلك. انضمّي إليّ

43
00:04:47,570 --> 00:04:48,940
حـ-حسناً

44
00:04:49,820 --> 00:04:51,340
هل هي ثملة؟

45
00:04:52,000 --> 00:04:54,550
قلتِ أنّ لديكِ إجازة غداً، صحيح؟

46
00:04:55,360 --> 00:04:56,380
ممتاز

47
00:04:56,380 --> 00:04:57,600
اقضي بعضاً من الوقتِ معي

48
00:04:57,600 --> 00:04:59,060
أين؟

49
00:05:00,090 --> 00:05:02,510
لم تتنزّهي معي في البلدةِ بعد، أليس كذلك؟

50
00:05:02,510 --> 00:05:04,020
سآخذكِ في جولة

51
00:05:04,580 --> 00:05:07,770
سأدعوكِ إلى تناول شيء لذيذ مُقابِل
أزهار الكرز والسّاكي

52
00:05:08,250 --> 00:05:10,100
لستِ بحاجةٍ لذلك

53
00:05:10,100 --> 00:05:13,050
إضافةً إلى أنّني لا أملك أي لِباس

54
00:05:13,050 --> 00:05:14,940
سأعيركِ كيمونو

55
00:05:14,940 --> 00:05:16,170
أراكِ هناك

56
00:05:18,570 --> 00:05:20,910
هذه أوّل مرّة أخرج فيها

57
00:05:22,800 --> 00:05:25,080
!لا أصدِّق

58
00:05:25,080 --> 00:05:28,570
هل ستخرجين بهذا الشّعر
المنكوش حقّاً يا ساتسكي-نيساما؟

59
00:05:28,570 --> 00:05:30,700
ليس لديّ عمل اليوم أصلاً

60
00:05:30,700 --> 00:05:31,690
قطعاً لا

61
00:05:31,690 --> 00:05:33,190
اذهبي وسرّحيه فوراً

62
00:05:33,190 --> 00:05:35,050
!ولون حزامكِ غير مناسِب يا يوزو-تشان

63
00:05:35,240 --> 00:05:36,930
سأعيركِ حزاماً. تعالي معي

64
00:05:37,840 --> 00:05:42,110
أكره أن تكون الفتيات غير مكترِثات للأزياء

65
00:05:44,450 --> 00:05:45,620
ماذا؟

66
00:05:54,470 --> 00:05:59,030
اعذريني، يجب أن تكون السيّدة أنيقة
حتّى لو كان منزلها يحترق

67
00:05:59,030 --> 00:06:01,290
!إنّها ظريفةٌ ومُمتعة

68
00:06:01,290 --> 00:06:04,070
ماذا؟ ساتسكي، يوجد ثقبٌ في جوربكِ

69
00:06:04,070 --> 00:06:05,550
—لا بأ

70
00:06:05,550 --> 00:06:06,440
!أبداً

71
00:06:06,440 --> 00:06:07,820
!غيّريه

72
00:06:08,610 --> 00:06:11,860
لم أرَ ساتسكي-تشان تتوبَّخ من قبل

73
00:06:11,860 --> 00:06:14,770
رين، في أي وقت سيأتي الضيوف اليوم؟

74
00:06:12,380 --> 00:06:16,090
تعبِّر بمختلفِ أشكال التّعابير
التي لم يسبق أن رأيتُها

75
00:06:14,770 --> 00:06:16,730
مجموعتان في السّادسة

76
00:06:16,730 --> 00:06:17,630
حسناً

77
00:06:17,630 --> 00:06:19,590
ساتسكي-نيساما جذّابة

78
00:06:19,590 --> 00:06:21,220
آمل أن تكون أكثر تنبُّهاً

79
00:06:21,490 --> 00:06:25,420
عليها أن تهتمّ أكثر بمظهرها
إن كانت ستُصبِح كاهنة

80
00:06:26,650 --> 00:06:27,400
ماذا؟

81
00:06:27,400 --> 00:06:30,300
ماذا؟ لم تسمعي؟

82
00:06:30,530 --> 00:06:35,030
ساتسكي-نيساما ستغادر كونوهاناتي
لتصبح كاهنة

83
00:06:35,370 --> 00:06:36,940
ساتسكي-تشان؟

84
00:06:37,320 --> 00:06:39,470
ستغادر كونوهاناتي؟

85
00:06:40,640 --> 00:06:44,760
يا له من يوم رائع لنزهة

86
00:06:45,580 --> 00:06:47,710
ماذا؟ أنتِ غريبة الأطوار

87
00:06:47,710 --> 00:06:51,610
لم أتوقّع أبداً أن تقومي بمواعدةِ يوزو

88
00:06:51,590 --> 00:06:54,220
أنا آخذها في جولةٍ فقط لأنّني لم أجد
ما أفعله فجأة

89
00:06:54,220 --> 00:06:55,930
بسببِ شخص في بالي

90
00:06:55,930 --> 00:06:57,630
!كيري

91
00:06:57,630 --> 00:06:59,010
نعم، أوكامي؟

92
00:06:59,010 --> 00:07:01,860
سنستضيفُ نزيلَي مأدبة آخرين

93
00:07:01,860 --> 00:07:04,570
حسناً، سأبلغ المطبخ

94
00:07:04,840 --> 00:07:05,850
شكراً

95
00:07:06,490 --> 00:07:08,280
...هل أنتِ متأكّدة

96
00:07:08,280 --> 00:07:09,250
!لا بأس

97
00:07:09,250 --> 00:07:11,330
لن يقيم كثيرٌ من النّاس عندنا اللّيلة

98
00:07:11,330 --> 00:07:12,520
!اذهبي فحسب

99
00:07:18,670 --> 00:07:21,650
غادرنا متأخّرين لأنّ رين أخّرتنا

100
00:07:21,650 --> 00:07:24,040
أنتِ جميلةٌ جدّاً يا ساتسكي-تشان

101
00:07:24,850 --> 00:07:27,670
ها هي ذي بتعليقاتِها المِخجِلة مجدّداً

102
00:07:27,670 --> 00:07:29,930
ساتسكي-تشان، انظري إلى هذه

103
00:07:29,930 --> 00:07:30,960
!ما أظرفها

104
00:07:32,170 --> 00:07:33,640
مانيكي-نيكوس

105
00:07:33,640 --> 00:07:34,940
أعدادها كثيرة

106
00:07:34,940 --> 00:07:37,050
لدينا مختلف أنواع الوجوه

107
00:07:37,050 --> 00:07:39,140
تعاليا وألقيا نظرة

108
00:07:40,740 --> 00:07:42,840
أتحبّين القطط؟

109
00:07:42,840 --> 00:07:43,600
!نعم

110
00:07:43,600 --> 00:07:44,580
حقّاً؟

111
00:07:44,580 --> 00:07:46,330
لكن القطط ليست شهيّة إلى هذا الحدّ

112
00:07:46,610 --> 00:07:52,070
علبة ملح

113
00:07:46,810 --> 00:07:52,060
!هشّ! هشّ

114
00:07:47,510 --> 00:07:49,240
يوجد المزيد من المحلّات هناك

115
00:07:49,240 --> 00:07:50,520
أتريدين تفقّدها؟

116
00:07:50,520 --> 00:07:51,340
حسناً

117
00:07:55,920 --> 00:07:58,510
تأكلين ميتاراشي دانغو، أليس كذلك يا ساتسكي-تشان؟

118
00:07:58,510 --> 00:07:59,620
تبدو لذيذة

119
00:07:59,620 --> 00:08:01,750
هل يمكنني أكل قضمة؟

120
00:08:02,130 --> 00:08:03,280
حسناً

121
00:08:06,520 --> 00:08:09,370
تحبُّ الفتيات أشياء كهذه حقّاً

122
00:08:09,370 --> 00:08:10,940
يمكنكِ أكل قضمة أيضاً

123
00:08:11,490 --> 00:08:13,210
حسناً

124
00:08:13,810 --> 00:08:15,170
تفضّلي

125
00:08:16,080 --> 00:08:16,890
هيّا

126
00:08:20,640 --> 00:08:21,440
أرأيتِ؟

127
00:08:21,440 --> 00:08:24,600
شيراتاما دانغو مُهتَزٌ ولذيذ

128
00:08:25,650 --> 00:08:28,480
لـ-لا يرانا أحد، أليس كذلك؟

129
00:08:31,400 --> 00:08:33,270
يا لها من مدينة كبيرة

130
00:08:33,490 --> 00:08:38,000
كنتُ أعيش في معبدٍ في الجبال
لذا انصدمتُ في البداية

131
00:08:38,570 --> 00:08:41,420
لكن تبدين مرتاحة أمام النّاس

132
00:08:41,420 --> 00:08:43,760
كان يزور المعبدَ كثيرٌ من الزوّار

133
00:08:44,110 --> 00:08:47,250
جاءنا كثيرٌ من الزوّار البشر أيضاً

134
00:08:47,490 --> 00:08:48,670
هكذا إذاً

135
00:08:48,980 --> 00:08:52,770
لهذا لديها معرِفة بشريّة واسعة

136
00:08:53,760 --> 00:08:56,460
ترين بشراً في هذه البلدةِ أحياناً أيضاً

137
00:08:57,240 --> 00:08:58,680
حقّاً؟

138
00:08:59,460 --> 00:09:01,640
إنّها بلدة بريديّة للسيّاح

139
00:09:01,950 --> 00:09:04,600
لكِ أن تتوقّعي أن تري أي شخص هنا

140
00:09:06,030 --> 00:09:07,560
إنّها جميلة

141
00:09:08,980 --> 00:09:14,800
من المُثير أن ننظر للأمرِ على أنّ
كلّ شخص عابر له أسراره

142
00:09:14,800 --> 00:09:15,990
حقّاً؟

143
00:09:16,320 --> 00:09:20,210
شكراً جزيلاً لكِ على دعوتي
للخروجِ اليوم

144
00:09:23,160 --> 00:09:26,280
المهمّ أنّكِ مستمتعة

145
00:09:26,280 --> 00:09:27,020
أجل

146
00:09:27,700 --> 00:09:29,870
كلّ ما في الأمر أنّني حصلتُ على إجازة

147
00:09:29,870 --> 00:09:32,540
لم أفعل شيئاً أستحقّ الشّكر عليه

148
00:09:33,020 --> 00:09:35,180
هذا كلامٌ يسهل قوله

149
00:09:36,650 --> 00:09:39,130
لذا لمَ لا أستطيع قول ذلك لها؟

150
00:09:39,670 --> 00:09:41,520
!لا تدعي أفكاراً غريبة تراودكِ

151
00:09:40,550 --> 00:09:43,040
سأخبر كيري حتماً

152
00:09:41,520 --> 00:09:44,020
لا تليق بكِ شخصيّة تسونديري

153
00:09:44,210 --> 00:09:46,800
هذه الفتاة تشوّشني بطريقةٍ ما

154
00:09:46,800 --> 00:09:48,490
لم أرك منذ وقت يا تومي-سان

155
00:09:48,490 --> 00:09:51,070
ألم تتفتّح أزهار الكرز في المزارِ بعد؟

156
00:09:51,070 --> 00:09:52,430
...بخصوصِ ذلك

157
00:09:52,600 --> 00:09:56,940
انتهى موسم أزهار الكرز، ولم أرَ
برعمةً واحدة

158
00:09:56,940 --> 00:09:59,170
أظنّها تكبُر

159
00:09:59,390 --> 00:10:01,090
هذا محزنٌ للغاية

160
00:10:01,090 --> 00:10:04,950
لن نجد شجرةً مقدّسةً مذهلة
مثلها في أي مكانٍ آخر

161
00:10:05,290 --> 00:10:07,570
والآن إلى أين ينبغي أن نذهب؟

162
00:10:07,850 --> 00:10:09,530
أريد رؤية المزار

163
00:10:10,750 --> 00:10:11,760
المزار؟

164
00:10:14,360 --> 00:10:17,070
لا شيء مُثير لرؤيتِه هناك

165
00:10:17,850 --> 00:10:21,340
أريد فقط إلقاء التحيّة على الإله

166
00:10:21,340 --> 00:10:23,310
ولديّ فضول تجاه أزهار الكرز أيضاً

167
00:10:23,310 --> 00:10:24,510
...و

168
00:10:25,130 --> 00:10:29,150
أريد أن أرى أين ستعملين

169
00:10:31,130 --> 00:10:34,070
أين ماذا؟

170
00:10:35,020 --> 00:10:36,860
!أخبرتكِ رين، أليس كذلك؟

171
00:10:36,860 --> 00:10:38,190
!هذه زلّة لسان

172
00:10:38,190 --> 00:10:40,230
هذه ليست غلطتها

173
00:10:41,190 --> 00:10:43,710
ربّما ارتكبتُ خطأ

174
00:10:43,710 --> 00:10:48,840
إضافة إلى أنّني أظنّكِ ستكونين كاهنة عظيمة

175
00:10:48,840 --> 00:10:50,290
كفّي عن تخيُّل الأمور

176
00:10:51,680 --> 00:10:53,160
إلى أين ستذهبين؟

177
00:10:53,160 --> 00:10:54,010
إلى المغسل

178
00:10:55,250 --> 00:10:56,660
آسفة

179
00:10:56,960 --> 00:10:59,520
أتساءل ما الذي استفزّها

180
00:10:59,520 --> 00:11:00,700
عليّ أن أكون حذرة

181
00:11:00,700 --> 00:11:03,730
اسمعي. ابقي مكانكِ كي لا تتوهي

182
00:11:06,410 --> 00:11:09,300
ما زالت قلِقة عليّ حتّى الآن

183
00:11:10,720 --> 00:11:12,240
إنّها لطيفةٌ جدّاً

184
00:11:20,810 --> 00:11:22,110
هل أنتِ بخير؟

185
00:11:23,170 --> 00:11:24,500
شكراً لكِ

186
00:11:24,500 --> 00:11:26,820
انفصلتُ عن أختي

187
00:11:27,800 --> 00:11:30,740
بتُّ أبحث عنها لخمسةِ أيّام حتّى الآن

188
00:11:30,740 --> 00:11:31,800
خمسة أيّام؟

189
00:11:32,800 --> 00:11:35,640
ما زال أمامي عمل أقوم به

190
00:11:35,640 --> 00:11:37,390
...يا لها من مُشكلة

191
00:11:42,360 --> 00:11:43,100
...المعذرة

192
00:11:43,560 --> 00:11:47,060
إن لم يكن لديكِ مانع، سأساعدكِ
على البحثِ عنها

193
00:11:47,930 --> 00:11:49,580
سأكون مُمتنّة

194
00:11:49,830 --> 00:11:53,480
...أنا آسفة يا ساتسكي-تشان. سأعود في الحال

195
00:12:01,420 --> 00:12:03,190
ينبغي أن أعود الآن

196
00:12:03,190 --> 00:12:04,900
!يا فتاة

197
00:12:04,900 --> 00:12:06,570
كان ذلك سيّئاً

198
00:12:06,580 --> 00:12:08,990
،ولو أنّي كنتُ مغتاظة

199
00:12:08,250 --> 00:12:09,760
أتكلّم معكِ

200
00:12:09,450 --> 00:12:12,870
كان من السّخفِ منّي أن أتصرّف بذلك
الشّكل مع مُستجدّة أصغر منّي

201
00:12:12,870 --> 00:12:13,980
أنا تائهة

202
00:12:13,980 --> 00:12:14,900
دُلّيني

203
00:12:14,900 --> 00:12:18,300
أعرف يوزو. أنا متأكّدة أنّها
ستتظاهر بنسيانِ ذلك

204
00:12:16,640 --> 00:12:19,150
لا تدّعي وكأنّكِ لا تسمعينني

205
00:12:19,150 --> 00:12:20,890
تبّاً، لم أستطع التملُّص

206
00:12:21,470 --> 00:12:24,040
لا داعي لتناديني "فتاة" يا طفلة

207
00:12:24,040 --> 00:12:25,120
انصرفي

208
00:12:25,120 --> 00:12:25,850
!كيف تجرؤين؟

209
00:12:25,850 --> 00:12:28,360
إذا أسأتِ التعاملَ معي فسأبكي

210
00:12:28,360 --> 00:12:30,080
سأتدحرج وأنوح

211
00:12:30,080 --> 00:12:31,170
أتريدين ذلك؟

212
00:12:31,170 --> 00:12:34,750
ستغدين مصدراً للسخرية إذا لحقتُ بكِ
وأنا أتدحرج

213
00:12:34,750 --> 00:12:35,930
أي تهديد هو هذا؟

214
00:12:37,930 --> 00:12:39,500
تبّاً

215
00:12:39,500 --> 00:12:40,770
فهمت، فهمت

216
00:12:43,180 --> 00:12:44,610
يسرّني أنّكِ فهمت

217
00:12:44,610 --> 00:12:47,900
آسفة يا يوزو، سأشتري لكِ
مانيكي-نيكو لاحقاً

218
00:12:47,900 --> 00:12:50,770
حسناً، إلى أين تريدين أن آخذكِ؟

219
00:12:50,770 --> 00:12:52,590
جِدي لي أختي

220
00:12:52,590 --> 00:12:53,750
أنتِ تائهةٌ فحسب إذاً

221
00:12:53,750 --> 00:12:54,880
!لستُ تائهة

222
00:12:54,880 --> 00:12:58,810
ابتعدتُ لأستمتع في غفلةٍ من أختي
والآن لا أستطيع العودة إلى المنزل

223
00:12:58,810 --> 00:13:00,020
هذا يزيد الطين بلّة

224
00:13:00,020 --> 00:13:02,600
ابتعدي وعيشي بمفردكِ فحسب

225
00:13:03,610 --> 00:13:05,310
يا للوقاحة

226
00:13:05,700 --> 00:13:11,750
سئمتُ من سخريةِ أختي فقط لأنّني
أصغر منها

227
00:13:11,750 --> 00:13:14,780
لم أعُد طفلة

228
00:13:17,720 --> 00:13:20,950
حسناً، الأخوات الأكبر أنانيّات جدّاً

229
00:13:20,950 --> 00:13:23,260
ماذا؟ لديكِ أخت أكبر أيضاً؟

230
00:13:23,260 --> 00:13:24,040
!تبّاً

231
00:13:24,040 --> 00:13:25,220
سننسجم معاً

232
00:13:25,220 --> 00:13:26,660
لسنا بحاجةٍ لذلك

233
00:13:27,320 --> 00:13:29,910
لم أرَ فتاةً كهذه

234
00:13:29,910 --> 00:13:30,880
هكذا إذاً

235
00:13:30,880 --> 00:13:32,730
شكراً لكِ

236
00:13:33,090 --> 00:13:36,000
آسفة، لا أعرف المنطِقة جيّداً

237
00:13:36,000 --> 00:13:37,080
لا عليكِ

238
00:13:37,080 --> 00:13:38,970
آسفة لإزعاجكِ

239
00:13:40,500 --> 00:13:42,840
إلى أين ستسافرين؟

240
00:13:43,900 --> 00:13:44,980
إلى الشّمال

241
00:13:45,910 --> 00:13:50,900
نسافر من أبعد نقطة جنوباً، وباتّجاه
الشّمال شيئاً فشيئاً

242
00:13:50,900 --> 00:13:53,800
كلّ الأخريات قد سبقننا

243
00:13:53,800 --> 00:13:56,280
بينما أنا وأختي قد تخلّفنا عنهن

244
00:13:57,510 --> 00:13:59,930
يجب أن تجديها بسرعة إذاً

245
00:14:00,240 --> 00:14:01,730
لا تقلقي

246
00:14:02,500 --> 00:14:06,340
هذه رحلةٌ كانَتْ تُقامُ كثيراً على مرّ السِّنين

247
00:14:07,530 --> 00:14:12,510
بقدرِ ما أنا مرتعدة، لا أستطيع أبداً
أن أفلت من عبور الزمن

248
00:14:14,040 --> 00:14:16,420
هذه فكرةٌ جميلة

249
00:14:16,420 --> 00:14:19,180
ستُصبِح ساتسكي-نيساما كاهنة

250
00:14:19,870 --> 00:14:21,740
كنتُ حزينة فعلاً

251
00:14:22,010 --> 00:14:24,350
لكن لن نفترق للأبد

252
00:14:24,760 --> 00:14:30,000
ما زال هناك الكثير لا أعرفه
عن هذه المدينة، وعن كونوهاناتي

253
00:14:30,000 --> 00:14:32,700
وعن صديقاتي

254
00:14:33,530 --> 00:14:38,060
لكن أريد قضاء المزيد من الوقت
وأنجذب إليهن أكثر فأكثر

255
00:14:39,410 --> 00:14:42,130
سنكون صديقتين حميمتين، ألا تعتقدين ذلك؟

256
00:14:42,130 --> 00:14:44,000
!تبّاً. اصمتي

257
00:14:44,000 --> 00:14:46,210
ما هو شكل أختكِ الكبيرة؟

258
00:14:46,210 --> 00:14:47,740
هل هي أنانيّة؟

259
00:14:47,740 --> 00:14:48,830
أنانيّة جدّاً

260
00:14:48,830 --> 00:14:50,880
...لا تفكّر سوى بنفسها وغير لبِقة

261
00:14:51,350 --> 00:14:53,270
عظيمة في كلّ شيء

262
00:14:55,450 --> 00:14:58,090
لستُ مهتمّة في أن أصبح كاهنة

263
00:14:58,090 --> 00:14:59,940
لندع ساتسكي تؤدّي العمل

264
00:14:59,940 --> 00:15:02,600
حلمها هو أن تخدم الآلهة

265
00:15:03,810 --> 00:15:06,580
إنّها حقّاً فظيعة

266
00:15:07,600 --> 00:15:10,990
أختي لا تفكّر بالآخرين، لكنّها فظيعة

267
00:15:10,990 --> 00:15:13,340
تبّاً! أشعر برغبةٍ في صفعِها

268
00:15:13,340 --> 00:15:15,300
أحبّكِ

269
00:15:15,300 --> 00:15:16,930
ما رأيكِ أن تنضمّي إليّ؟

270
00:15:16,930 --> 00:15:17,750
لا شكراً لكِ

271
00:15:17,750 --> 00:15:18,750
ماذا؟

272
00:15:18,750 --> 00:15:21,020
إنّه عملٌ نبيل، خدمة الآلهة

273
00:15:24,220 --> 00:15:27,160
وليس مجرّد إله حامٍ لبلدةٍ صغيرة كهذه

274
00:15:27,160 --> 00:15:29,860
نحن نخدمُ آلهة تاكاماغاهارا

275
00:15:29,860 --> 00:15:33,450
إنّها مهمّةٌ نبيلة، تضمنُ سلامةَ ناكاتسوكوني

276
00:15:33,710 --> 00:15:37,400
يمكنكِ أن تنافسي أختكِ منافسة شديدة

277
00:15:38,440 --> 00:15:41,120
سنرسل هيراغي للخدمةِ في كونوهاناتي

278
00:15:41,550 --> 00:15:47,210
لكن يا عزيزي، يتأمّلُ الجميع من هيراغي
أن تصبح كاهنة

279
00:15:47,600 --> 00:15:48,740
بالفعل

280
00:15:49,020 --> 00:15:51,860
لنرسل ساتسكي بدلاً من ذلك إذاً

281
00:15:55,800 --> 00:15:56,970
حسناً

282
00:16:05,480 --> 00:16:06,270
!ماذا؟

283
00:16:06,270 --> 00:16:08,330
من أين هبّتْ هذه النفحة؟

284
00:16:08,330 --> 00:16:09,480
زوبعة؟

285
00:16:12,480 --> 00:16:13,650
وجدتُها

286
00:16:14,130 --> 00:16:15,790
إنّها بالقربِ من شجرة أزهار الكرز

287
00:16:16,780 --> 00:16:21,070
إن استطعتُ جعل أزهار الكرز تتفتّح
فسوف تنظر إليّ أختي نظرة مختلِفة

288
00:16:21,070 --> 00:16:24,870
لا أستطيع فعلها بمُفردي، لكن
!برفقتي صديقة الآن

289
00:16:24,870 --> 00:16:26,920
انتظري. صديقة؟

290
00:16:26,920 --> 00:16:29,960
لن تستخدميني لتخصيبِ الشّجرة، أليس كذلك؟

291
00:16:37,780 --> 00:16:39,800
...ا-النجدة

292
00:16:42,600 --> 00:16:45,910
!لنُزهِر الشّجرة الميّتة

293
00:17:46,690 --> 00:17:48,130
...أزهار الكرز

294
00:17:48,130 --> 00:17:50,080
!شجرة أزهار الكرز قد أزهرت

295
00:17:50,080 --> 00:17:51,970
!حان وقتُ مأدبة

296
00:17:51,970 --> 00:17:53,340
!حان وقتُ مهرجان

297
00:18:41,070 --> 00:18:43,510
وجدتُكِ يا ساتسكي-تشان

298
00:18:44,820 --> 00:18:48,090
كنتُ قلقة من أن تكوني عالِقة في دورةِ المياه

299
00:18:49,110 --> 00:18:51,180
أرأيتِ؟ ها أنتِ ذي

300
00:18:52,260 --> 00:18:55,840
تتصرّفين وكأنّ شيئاً لم يكن

301
00:18:57,830 --> 00:18:59,110
هل أنتِ بخير؟

302
00:18:59,110 --> 00:19:00,560
أجل

303
00:19:00,830 --> 00:19:02,720
ما كان ينبغي أن تشدّيني بلا سابِق إنذار

304
00:19:02,720 --> 00:19:03,410
عجباً

305
00:19:05,490 --> 00:19:06,700
كاهنة؟

306
00:19:06,700 --> 00:19:07,650
أيامي

307
00:19:07,650 --> 00:19:09,380
ساتسكي-سان

308
00:19:09,380 --> 00:19:12,250
نادراً ما أراكِ تأتين إلى هنا

309
00:19:12,250 --> 00:19:14,670
...لا، أنا

310
00:19:14,670 --> 00:19:16,800
تعالي، سأبحث لكِ عن مقعد

311
00:19:16,800 --> 00:19:18,080
!انتظري يا أيامي

312
00:19:18,080 --> 00:19:21,430
لا تقلقي، لديّ مكانٌ لرفيقتكِ أيضاً

313
00:19:35,350 --> 00:19:36,270
ما الأمر؟

314
00:19:36,270 --> 00:19:39,540
فتاة كانت تبحث عن أختِها

315
00:19:39,540 --> 00:19:40,470
أختها؟

316
00:19:40,470 --> 00:19:44,200
بدَتْ أنّها بحاجةٍ لمساعدة حقّاً

317
00:19:44,200 --> 00:19:46,200
...أعلم أنّكِ طلبتِ منّي عدم الابتعاد، لكن

318
00:19:46,520 --> 00:19:47,830
آسفة

319
00:19:48,090 --> 00:19:51,540
لا، في الواقع، لا يحقُّ لي أن أشتكي

320
00:19:52,960 --> 00:19:54,170
لا تقلقي

321
00:19:54,870 --> 00:19:56,450
لقد عثرَتْ عليها

322
00:20:00,340 --> 00:20:01,850
الفتاة التي في الوسط

323
00:20:03,500 --> 00:20:05,620
هل ترين الكاهنة ذات الشّعر الفضّي؟

324
00:20:07,010 --> 00:20:09,050
تِلك هي أختي الكبرى

325
00:20:10,280 --> 00:20:13,960
أتيتُ إلى كونوهاناتي عوضاً عنها

326
00:20:14,730 --> 00:20:17,370
لم أكن من تمّ اختيارها لتُصبِح كاهنة

327
00:20:21,350 --> 00:20:23,690
لا تخالي أنّني استسلمت

328
00:20:24,100 --> 00:20:27,310
،حالما تسنح لي فُرصةٌ للاستقالة
سأسعى لأصبح كاهنة مجدّداً

329
00:20:31,780 --> 00:20:34,360
أنا خجولةٌ حيال هذا الأمر، لذا لا تخبري أحداً

330
00:20:38,120 --> 00:20:39,840
إنّها لطيفةٌ للغاية

331
00:20:40,840 --> 00:20:46,380
إنّها لطيفةٌ وخرقاء ولا تريد
أن تتكلّم مع النّاس عن نفسِها

332
00:20:46,380 --> 00:20:48,820
ومع ذلك كشفَتْ سرّها لي

333
00:20:58,520 --> 00:21:03,710
لم أكن أعلم أبداً أنَّ لمس قلب
شخص قد يُسعدني إلى هذا الحدّ

334
00:21:05,690 --> 00:21:07,270
ما-ماذا؟

335
00:21:07,270 --> 00:21:08,570
ماذا حدث للتو؟

336
00:21:09,800 --> 00:21:20,120
أنا مسرورةٌ فحسب لأنّني أتيتُ إلى كونوهاناتي
والتقيتُ بالجميعِ ولا سيّما أنتِ

337
00:21:25,730 --> 00:21:26,630
هيّا بنا

338
00:21:30,090 --> 00:21:32,670
تُقامُ مأدبةٌ في الصّالةِ الرئيسيّة

339
00:21:33,180 --> 00:21:34,930
لنعُد إلى العمل

340
00:21:40,770 --> 00:21:41,400
حسناً

341
00:21:47,990 --> 00:21:53,170
تسافِران تجاه الشّمال للأبد، تاركتان
وقع أقدام الزهرة المُتفتّحة

342
00:21:54,340 --> 00:21:55,730
لنذهب إلى المنزل

343
00:21:56,230 --> 00:21:59,410
لنعد إلى كونوهاناتي خاصّتنا