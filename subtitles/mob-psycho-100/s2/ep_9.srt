1
00:00:07,230 --> 00:00:10,190
!شيغيو، انتظر! اِبقَ هادئاً

2
00:00:10,190 --> 00:00:12,150
!انظر في عينَيّ

3
00:00:13,840 --> 00:00:17,400
!من الواضِح بأنّ هذه ليست جثثاً حقيقيّة

4
00:00:17,400 --> 00:00:19,080
!إنّها مُزيّفة

5
00:00:19,390 --> 00:00:22,290
لعلّها كانت تكتيكات تضليليّة
استخدمَها المُدرِك فوق الحسّي

6
00:00:23,330 --> 00:00:27,590
إيكوبو... هل توجد قوّة روحانيّة كهذه؟

7
00:00:27,590 --> 00:00:30,880
!فكّر في الأمر فحسب! هذا مُمكنٌ جدّاً

8
00:00:30,880 --> 00:00:32,880
!لا، بل أنا متأكّد من أنّه كذلك

9
00:00:40,370 --> 00:00:41,310
وجدتُهم

10
00:00:41,310 --> 00:00:43,600
هل تعلّمَ كيفيّة القيام بهذا للتو؟

11
00:00:44,140 --> 00:00:45,560
!لا بدّ وأنّه هو إذاً

12
00:00:45,860 --> 00:00:46,810
...إيكوبو

13
00:00:48,660 --> 00:00:51,280
شكراً لك... على إيقافي

14
00:00:52,140 --> 00:00:55,490
لا يمكننا الاسترخاء بعد. سوف نلاحقهم، أليس كذلك؟

15
00:00:55,750 --> 00:00:59,450
بالطبع. سوف أسترجعهم جميعاً الآن

16
00:01:00,050 --> 00:01:02,100
ولن أسامح من فعلَ هذا

17
00:01:02,100 --> 00:01:04,540
مهما ابتعد من مسافة، لن أسامحه ما حييت

18
00:01:08,290 --> 00:01:10,750
هل من فائدة من إحراق المكان؟

19
00:01:11,010 --> 00:01:14,010
لكن تمَّ إنجاز العمل بشكلٍ فوريّ
بهذه الطريقة على الأقلّ

20
00:01:16,470 --> 00:01:17,130
ماذا كان ذلك؟

21
00:01:17,130 --> 00:01:17,860
!نيزك؟

22
00:01:17,860 --> 00:01:19,760
مَن هذا بالضبط؟

23
00:03:07,070 --> 00:03:10,120
أنت هانازاوا تيروكي... أليس كذلك؟

24
00:03:10,390 --> 00:03:13,380
—هانازاوا؟ الشّخص الذي يعيش في الطابق السّفـ

25
00:03:13,380 --> 00:03:14,590
!الانفجار العقليّ

26
00:03:20,640 --> 00:03:25,280
أعرفك. أنت هدفُنا

27
00:03:25,280 --> 00:03:28,310
كيف كشفتَ أمرنا بالضبط؟

28
00:03:28,510 --> 00:03:31,230
حسناً، أيّاً يكن. يمكنك أن تموت هنا

29
00:03:34,840 --> 00:03:37,780
مُذهِل، يبدو أنّك مرِنٌ بعض الشيء

30
00:03:41,530 --> 00:03:43,530
إلى أين أخذت عائلتي؟

31
00:03:43,530 --> 00:03:45,190
هذا رائع

32
00:03:45,190 --> 00:03:49,500
لنرَ إن كنتَ ستموت بالصّعقِ الكهربائيّ
أوّلاً أم أسقط أنا

33
00:03:49,690 --> 00:03:53,120
لستُ مهتمّاً. استخدم شيئاً غير الكهرباء

34
00:03:55,530 --> 00:03:57,750
أهذا كلّ ما يمكنك فعله حقّاً؟

35
00:03:57,750 --> 00:03:59,130
...حسناً، في هذه الحالة

36
00:04:03,090 --> 00:04:06,390
ربّما أنت هو إذاً

37
00:04:06,390 --> 00:04:08,140
!أرِني قواك

38
00:04:09,270 --> 00:04:11,170
سلوكك حقير يا فتى

39
00:04:11,170 --> 00:04:16,110
إذا كنتَ مُلِحّاً على رؤيةِ قوايّ فسوف
!أريك إيّاها

40
00:04:19,680 --> 00:04:22,030
إنّهما يتقاتلان! شخص كهل وتلميذ مدرسة إعداديّة

41
00:04:22,030 --> 00:04:25,310
أحظى بدرعٍ حصينٍ مصنوع من الطاقة

42
00:04:25,750 --> 00:04:29,580
ومن ثمّ أسحق خَصمي. هذا هو أسلوبي

43
00:04:30,460 --> 00:04:31,660
...بربِّك

44
00:04:32,190 --> 00:04:34,540
هلّا كففتُم عن إضاعةِ وقتي؟

45
00:04:34,540 --> 00:04:37,100
يبدو أنّك تمتلك حاجزاً متيناً

46
00:04:37,100 --> 00:04:39,250
!أهذه هي قوّتك؟

47
00:04:40,750 --> 00:04:42,290
!كفّ عن العبثِ معي

48
00:04:45,390 --> 00:04:49,120
أريد رؤية هذه القوّة القادرة على إنشاء
!أجسام مُزيّفة

49
00:04:49,120 --> 00:04:51,100
!لماذا هاجمتم منزلي؟

50
00:04:51,100 --> 00:04:52,810
!فليستدعِ أحدٌ الإسعاف والشّرطة

51
00:04:52,810 --> 00:04:55,660
...أسأتَ الفهم

52
00:04:55,660 --> 00:05:00,610
...كنّا في طريقِنا لمهاجمةِ منزلك فحسب

53
00:05:01,230 --> 00:05:02,030
ماذا؟

54
00:05:02,490 --> 00:05:05,270
!أنت! من سمحَ لك أن يُغمى عليك؟

55
00:05:05,270 --> 00:05:05,990
!استفِق

56
00:05:06,360 --> 00:05:07,200
...اللّعنة

57
00:05:09,200 --> 00:05:11,630
لقد اتّصلتُ بالنّخبة العُليا

58
00:05:11,630 --> 00:05:16,630
والآن أصبحتَ في عِداد... الموتى

59
00:05:17,230 --> 00:05:21,430
هذه مُشكلة يا شيغيو. يبدو أنّ هناك المزيد
‏من الرّوحانيّين في الطريق

60
00:05:21,430 --> 00:05:22,300
—علينا أن

61
00:05:22,300 --> 00:05:25,010
لكن لم أحصل على أي معلومة بعد

62
00:05:25,530 --> 00:05:28,840
إذا كان سيأتي مزيدٌ من أصدقائهم فسيتوجّب
عليّ سؤالهم فحسب

63
00:05:31,700 --> 00:05:32,770
مظلّة؟

64
00:05:38,160 --> 00:05:40,830
أيُّها الوغد الصّغير. هل تواجه مُشكلة؟

65
00:05:43,140 --> 00:05:44,820
أوقِف نيّة القتلِ الشّديدة هذه

66
00:05:45,130 --> 00:05:47,970
نحن لا نحاول أن نفتعِل أي مُشكلة معك

67
00:05:48,540 --> 00:05:49,280
صحيح؟

68
00:05:49,580 --> 00:05:52,580
إذا كان لديك أي سؤال، فسأجيبك يا فتى

69
00:05:52,830 --> 00:05:56,040
تأخذانني إلى المكان الذي تتواجد فيه
عائلتي، أليس كذلك؟

70
00:05:56,190 --> 00:05:58,620
عائلتك؟ كلّا، ليسوا هناك

71
00:06:00,460 --> 00:06:03,000
إذاً لا سبب يدفعني للذهاب إلى هناك. أخرجاني

72
00:06:03,180 --> 00:06:06,510
!انتظر لحظة! أصدقاؤك ومعلّمك ينتظرون هناك

73
00:06:06,510 --> 00:06:07,880
ريغن هناك؟

74
00:06:07,880 --> 00:06:10,540
!في هذه الحالة، يجب أن نسرع

75
00:06:10,540 --> 00:06:11,800
!مهلاً

76
00:06:11,800 --> 00:06:13,510
!لا تقم بأي عملٍ طائش

77
00:06:20,530 --> 00:06:22,160
...أشعر وكأنّني سأتقيّأ

78
00:06:22,710 --> 00:06:24,900
لكن تمكّنّا من التملُّص من أي شخص كان يتعقّبنا

79
00:06:25,800 --> 00:06:27,700
أحضرناه

80
00:06:27,700 --> 00:06:29,260
هذا هو كاغياما شيغيو

81
00:06:29,660 --> 00:06:31,810
لم أرك منذ وقتٍ طويل يا فتى

82
00:06:32,300 --> 00:06:34,620
لم تتهوّر أو تتصرّف بطيش، أليس كذلك؟

83
00:06:34,620 --> 00:06:38,500
—أعلم بأنّنا كنّا مُنافسين، لكن أتطلّع قدماً للتعاون

84
00:06:38,940 --> 00:06:41,330
أي نوع من الاجتماعات هو هذا؟

85
00:06:42,410 --> 00:06:44,090
موب، هل أنت بخير؟

86
00:06:44,500 --> 00:06:45,580
...معلّم

87
00:06:46,110 --> 00:06:49,050
...منزلي... عائلتي

88
00:06:49,310 --> 00:06:51,010
هيّا، اجلس

89
00:06:51,480 --> 00:06:54,720
سأشرح كلّ شيء بالنيابة عن شيغيو

90
00:06:57,690 --> 00:06:58,860
هكذا إذاً

91
00:06:59,420 --> 00:07:01,560
إيكوبو، عليّ أن أتكلّم معك على انفراد

92
00:07:01,740 --> 00:07:02,490
حسناً

93
00:07:04,260 --> 00:07:07,100
هل ارتعدت وكذبت بشأن الجثث المزيّفة فحسب؟

94
00:07:07,100 --> 00:07:09,850
لا أقول أنّ احتمال أنّها مزيّفة مُستبعَد

95
00:07:09,850 --> 00:07:12,380
لا بدّ وأنّك كنت مرتعداً حقّاً إذاً

96
00:07:12,380 --> 00:07:15,270
إذا عَلِمَ موب بأنّك تكذب، فسوف يكرهك للأبد

97
00:07:17,100 --> 00:07:18,950
موب، يجب أن أتكلّم معك

98
00:07:19,630 --> 00:07:21,820
!هل ستخبره؟ تمهّل قليلاً

99
00:07:21,820 --> 00:07:23,500
—إذا كشفَ الحقيقة

100
00:07:24,220 --> 00:07:26,680
...موب، عائلتك

101
00:07:28,510 --> 00:07:30,670
أظنُّ أنّهم بخير كذلك

102
00:07:32,360 --> 00:07:35,410
أولئك كانوا في الطريقِ إلى منزلِك، صحيح؟

103
00:07:35,410 --> 00:07:38,970
لا بدَّ وأنّ شخصاً ما قد علمَ ما سيجري فأنقذهم

104
00:07:39,540 --> 00:07:41,400
لا بدّ وأنّه أحرقَ المكان كتكتيك تضليليّ

105
00:07:41,400 --> 00:07:43,500
ليحرص على ألّا تصبح عائلتك هدفاً مُحتمَلاً

106
00:07:44,170 --> 00:07:45,140
أليس هذا رائعاً؟

107
00:07:53,960 --> 00:07:56,460
استرخى كثيراً لدرجة أنّه نام

108
00:07:57,230 --> 00:07:59,410
والآن لنستمع إلى ما حدث لكم

109
00:08:00,130 --> 00:08:02,830
ما الذي جمعكم معاً بالضبط؟

110
00:08:02,830 --> 00:08:04,380
!هؤلاء من منظّمة مِخلب

111
00:08:04,600 --> 00:08:08,500
نحن، أعضاء الفرع السّابع، تركنا مِخلَب

112
00:08:08,980 --> 00:08:11,720
تمّتْ إبادتنا كلّياً بواسطة مجموعة
من تلاميذ المدرسة الإعداديّة

113
00:08:11,720 --> 00:08:14,090
جعلونا ندرك كم نحن سخيفين

114
00:08:14,310 --> 00:08:18,700
جميعنا نحاول أن نبدأ حياةً جديدة

115
00:08:19,210 --> 00:08:22,640
نحاول أن نبحث عن وسيلةٍ لنستخدم قِوانا
،لصالح المُجتمع

116
00:08:22,640 --> 00:08:24,440
مثلما قلتَ تماماً يا معلّم ريغن

117
00:08:24,880 --> 00:08:27,860
لكن المنظّمة لا تغفر للخوَنة

118
00:08:28,060 --> 00:08:30,980
،توقّعنا أن تهاجمنا عاجلاً وليس آجلاً

119
00:08:30,980 --> 00:08:33,070
لكن كان هذا أسرع بكثير ممّا توقّعنا

120
00:08:33,320 --> 00:08:36,780
وقد شنّوا هجمات عديدة علينا جميعاً

121
00:08:37,220 --> 00:08:38,660
أنا مندهش من أنّكم ما زلتُم أحياء

122
00:08:38,830 --> 00:08:42,570
لا تقلّل من شأننا. نحن أعضاء ندبة سابقون

123
00:08:42,570 --> 00:08:44,030
أليس كذلك يا تسوتشي؟

124
00:08:44,030 --> 00:08:48,380
أجل. لكن ستحتدّ الأمور حالما تأتي
جماعة المقرّ

125
00:08:48,550 --> 00:08:51,970
وحينئذ أدركنا بأنّنا سنكون بحاجةٍ لقائد

126
00:08:51,970 --> 00:08:54,590
إذا أردنا أن نقِفَ في وجهِ المقرّ

127
00:08:58,550 --> 00:09:00,310
يجدر بك أن تصمت قليلاً

128
00:09:00,760 --> 00:09:03,940
رأينا المعلّم ريغن يوقف محطّات الإذاعة
والتّلفزيون عند حدّهم

129
00:09:03,940 --> 00:09:05,890
وارتأينا أنّه شخص عبقريّ

130
00:09:06,090 --> 00:09:10,610
إنّه قادر على فهم الصّورة برمّتها
وتحقيق ما لا يمكن تحقيقه

131
00:09:11,020 --> 00:09:14,070
...عجيب أمر هؤلاء حقّاً

132
00:09:14,640 --> 00:09:16,780
ألم تتعرّض لهجوم؟

133
00:09:17,170 --> 00:09:18,870
دُمِّرَ مكتبي

134
00:09:19,470 --> 00:09:21,630
وحقيقة غيابي عندما حدثَ ذلك

135
00:09:21,630 --> 00:09:23,250
هي الجانب الإيجابي الوحيد في كلّ هذا

136
00:09:24,200 --> 00:09:26,380
كنتُ أفكّر في إجراء بعض أعمال التّرميم

137
00:09:26,380 --> 00:09:28,160
باعتباري اكتسبتُ شعبيّة من ظهوري
في التّلفزيون

138
00:09:28,920 --> 00:09:30,920
هذا هو مكتبي

139
00:09:34,900 --> 00:09:37,630
لكن يمكن تأجيل ذلك

140
00:09:37,950 --> 00:09:41,260
عقب هذا، أتى هؤلاء وأوصلوني إلى هنا

141
00:09:41,260 --> 00:09:43,530
كنتُ مُنهكاً سلَفاً من الماراثون

142
00:09:43,530 --> 00:09:45,390
يا له من يوم بغيض

143
00:09:46,110 --> 00:09:48,600
أتساءل ما إن كان تيرو-سان بخير

144
00:09:48,600 --> 00:09:52,110
تلقّيتُ رسالة منه قبل قليل. قال أنّه بخير

145
00:09:52,290 --> 00:09:53,560
متى حدث ذلك؟

146
00:09:53,560 --> 00:09:55,070
...هذا سيّئ

147
00:09:55,580 --> 00:09:57,280
وأنتم ماذا تفعلون هنا؟

148
00:09:57,480 --> 00:10:01,270
نحاول أن نتخفّى قدر الإمكان بعدما
حدث للفرع السّابع

149
00:10:01,270 --> 00:10:04,200
ميتسورا-سان هو من حضّر هذا المخبأ لنا

150
00:10:09,420 --> 00:10:10,300
هو إذاً

151
00:10:12,540 --> 00:10:13,840
!تيرو-سان

152
00:10:14,550 --> 00:10:17,290
مرحباً. يبدو أنّ العصابة كلّها هنا

153
00:10:19,190 --> 00:10:19,970
!أيّها الحمقى

154
00:10:20,330 --> 00:10:24,130
!لن تنتزعوا أي كلمة منّي

155
00:10:24,380 --> 00:10:25,560
—أنا عضو في مِخـ

156
00:10:27,610 --> 00:10:31,900
لا جدوى من المُقاومة. لم يسبق أن تمكّن
أحد من تحمُّل هذا التعذيب

157
00:10:35,740 --> 00:10:39,440
كان الزعيم يجوب العالمَ لاستكشاف
،مُدركين فوق حسّيين أقوياء

158
00:10:39,440 --> 00:10:42,410
لكن قال أنّه حصل أخيراً على كلّ
!الجنود الذين احتاجهم

159
00:10:42,890 --> 00:10:47,160
هكذا إذاً... مُدرِكون فوق حسّيين
من أنحاء العالم

160
00:10:47,590 --> 00:10:52,470
لا تقولوا أيّها الحمقى أنّكم ما زلتم
...تنوون مُواجهتنا بعد سماع هـ

161
00:10:53,690 --> 00:10:56,340
ماذا نفعل يا معلّم ريغن؟

162
00:10:57,950 --> 00:11:00,200
حسناً، لا يمكننا أن نتجاهل هذا الأمر

163
00:11:00,800 --> 00:11:02,960
لنبلغ الشرطة عنهم؟

164
00:11:12,830 --> 00:11:14,270
أليس هذا مذهلاً؟

165
00:11:15,080 --> 00:11:18,490
البشر قد صنعوا كلّ هذا

166
00:11:18,640 --> 00:11:22,170
أشعر بحماسٍ شديد. لا أطيق الانتظار لتدميرهم

167
00:11:22,170 --> 00:11:24,830
لهذا أتينا إلى هذا البلد، صحيح؟

168
00:11:24,830 --> 00:11:26,130
حقّاً؟

169
00:11:26,660 --> 00:11:28,230
أتيتُ إلى هنا لأجل المال

170
00:11:38,510 --> 00:11:39,500
،سيّداتي سادتي

171
00:11:40,520 --> 00:11:43,680
أشكركم جميعاً على الاجتماع هنا
في هذا اليوم المشهود

172
00:11:44,120 --> 00:11:47,820
أنا مُدير مِخلَب، سوزوكي تويتشيرو

173
00:11:48,530 --> 00:11:53,350
دعونا ألّا نهدر لحظةً واحدة. نحن على وشك
أن نعلن الحرب على العالم

174
00:11:53,950 --> 00:11:58,450
بعد عشرين عاماً، حصلتُ أخيراً على التّمويل
والأيدي العاملة التي أحتاجها

175
00:11:58,780 --> 00:12:01,420
سنبدأ الآن هذه الثّورة بالدّمار

176
00:12:01,810 --> 00:12:05,320
سندمّر كلّ شيء عزيز على النّاس

177
00:12:05,870 --> 00:12:10,280
!لنُرِ الضّعفاء أنّنا موجودون

178
00:12:10,280 --> 00:12:12,000
!أجل

179
00:12:12,000 --> 00:12:15,540
الهيمنة على العالم؟ أليس هذا
طموحاً مُبالغاً به؟

180
00:12:16,000 --> 00:12:17,560
هل كلّ التّحضيرات جاهزة؟

181
00:12:17,560 --> 00:12:19,760
لسنا بحاجةٍ للتّحضير حتّى

182
00:12:22,660 --> 00:12:23,790
ماذا يفعلون؟

183
00:12:23,790 --> 00:12:24,720
أهذا التّلفزيون؟

184
00:12:29,520 --> 00:12:31,890
والآن أنت على الهواء في كلّ القنوات

185
00:12:32,490 --> 00:12:35,390
القدرة على الاختراق والتحكّم
بأي نوع من الأنظمة

186
00:12:35,390 --> 00:12:38,460
والتّعامل مع الأجهزة الالكترونيّة أو الموجات

187
00:12:38,460 --> 00:12:41,400
هو بحدِّ ذاته لا يفهم كيف هي آليّة
عمل ذلك أيضاًأ

188
00:12:41,640 --> 00:12:43,990
...إنّه بارع

189
00:12:43,990 --> 00:12:48,000
نحن منظّمة المُدركين فوق حسّيين، المِخلَب

190
00:12:48,410 --> 00:12:51,420
نحن نتحكّم بالموجات الإذاعيّة بالقوى الروحانيّة

191
00:12:51,420 --> 00:12:55,330
هذا مجرّد جزء بسيط من قوّتِنا الحقيقيّة

192
00:12:55,800 --> 00:12:59,170
في متناول أيدينا أسلحة لا تُعَدُّ ولا تُحصَى

193
00:12:59,460 --> 00:13:02,670
اسمحوا لي أن أحذّركم أنّه لا يُنصَح أبداً بمُعاداتنا

194
00:13:03,090 --> 00:13:05,930
سنسيطر على العالم بالقوى الروحانيّة

195
00:13:05,930 --> 00:13:09,640
ونحكم جميع الضعفاء

196
00:13:09,890 --> 00:13:13,980
الخطوة الأولى في مهمّتِنا هي إزالة هذا البلد

197
00:13:14,400 --> 00:13:16,730
عالم جديد على وشك أن يُولَد

198
00:13:17,090 --> 00:13:19,210
تطلّعوا قُدماً لذلك

199
00:13:23,240 --> 00:13:26,530
!فعلتَ فِعلتك أيّها الأب الحثالة

200
00:13:27,090 --> 00:13:29,700
!كيف تجرؤ على إحراجي بهذا الشّكل ثانية؟

201
00:13:30,510 --> 00:13:32,550
!أنا من سيهزم أبي

202
00:13:32,550 --> 00:13:33,790
!هل فهمتَ ذلك يا ريتسو؟

203
00:13:34,010 --> 00:13:34,670
نعم

204
00:13:34,670 --> 00:13:36,420
!اللّعنة! هيّا بنا

205
00:13:36,420 --> 00:13:37,500
انتظر لحظة

206
00:13:37,500 --> 00:13:40,250
ماذا؟ ألم تصبح مع الفريق بعد؟

207
00:13:40,640 --> 00:13:42,500
ماذا عن سلامةِ عائلتي؟

208
00:13:43,740 --> 00:13:48,050
نحن نراقب عائلتك عن بُعد

209
00:13:48,470 --> 00:13:49,660
انظر

210
00:13:50,990 --> 00:13:54,640
لقد صدّقا الكذبة والتي هي أنّكما أمّنتما
تذكرة إقامة في فندق لهما

211
00:13:54,970 --> 00:13:59,350
لأنّكما أردتُما أن تفعلا شيئاً
لطيفاً لأجلهما

212
00:13:59,350 --> 00:14:01,900
لقد بالغتُم كثيراً حقّاً بهذا الارتجال

213
00:14:02,840 --> 00:14:06,360
لا توجد منظّمة خطيرة ما ذات صِلة
بتلك الينابيع السّاخنة، صحيح؟

214
00:14:06,360 --> 00:14:10,070
لا تقلق. يمكنهما الاختيار ما بين الطعام
البحريّ واللّحم في وجبتهما

215
00:14:10,290 --> 00:14:12,990
وإن كانا يعانيان من حساسيّة تجاه أطعمة
معيّنة فيمكن للفندق مُراعاة ذلك الأمر أيضاً

216
00:14:12,990 --> 00:14:15,130
!ليس هذا ما أتحدّث عنه

217
00:14:15,900 --> 00:14:19,440
الأهمّ من هذا، أخي لا يجيب على الهاتف

218
00:14:20,070 --> 00:14:22,460
أخوك لن يُقاتل

219
00:14:23,020 --> 00:14:24,250
أعرف من نظرة عينيه

220
00:14:24,540 --> 00:14:27,450
إنه من النّوع الذي لا يفجّر طاقاته ما لم
يحدث أمر حسّاس جدّاً

221
00:14:28,580 --> 00:14:30,910
أنا متأكّدٌ أنّ ذلك كان حسّاساً بما يكفي

222
00:14:30,910 --> 00:14:34,220
ماذا؟ هل فعلتَ شيئاً بعدما غادرنا المنزل؟

223
00:14:34,930 --> 00:14:38,380
...إذا استفززتَ أخي في شيء

224
00:14:38,380 --> 00:14:39,770
لا تقل أنّني لم أحذّرك

225
00:14:41,130 --> 00:14:43,720
أظنّك عشت حياةً قاسية أيضاً

226
00:14:45,360 --> 00:14:47,860
سأشرح الآن الخطّة التي كان الزعيم
‏يتحدّث عنها

227
00:14:48,920 --> 00:14:52,910
في اليابان، هناك قرابة 600.000 شرطيّ

228
00:14:52,910 --> 00:14:54,990
وعسكريّ مُسلّحون

229
00:14:55,790 --> 00:15:00,210
ومع ذلك قوّاتنا مُكوّنة من 600 تقريباً

230
00:15:00,850 --> 00:15:05,340
على كلّ شخص أن يواجه حوالي ألف
في المعركة

231
00:15:05,890 --> 00:15:07,430
لا ينبغي أن يكون هذا صعباً، صحيح؟

232
00:15:08,400 --> 00:15:09,350
!هذا مُذهِل

233
00:15:09,350 --> 00:15:10,420
!هذا زعيمنا الذي عهِدناه

234
00:15:10,420 --> 00:15:12,010
من كان يتوقّع أن يكون بهذه السّهولة؟

235
00:15:12,010 --> 00:15:14,540
يبدو هذا مُمكِناً بشكلٍ مفاجئ

236
00:15:15,870 --> 00:15:18,410
أهذا ما يطلقون عليه بالخطّة؟

237
00:15:18,410 --> 00:15:20,520
لا يبدو لي أنّ خطّتهم ستفلح

238
00:15:20,690 --> 00:15:22,980
هذه المجموعة بائسة

239
00:15:23,750 --> 00:15:25,940
ما رأيك يا جوزيف؟

240
00:15:26,300 --> 00:15:28,280
ربّما مثل رأيكم

241
00:15:28,580 --> 00:15:33,500
وفقاً لمنطقِه، إذا هزم كلّ واحد
،منّا 120 شخصاً

242
00:15:33,500 --> 00:15:35,200
يمكننا تدمير المِخلَب

243
00:15:35,570 --> 00:15:38,330
سنبدأ بتمرُّد؟ يبدو هذا ممتعاً

244
00:15:38,330 --> 00:15:41,790
أجل! لا يعنيني ما نفعله ما دمنا
!نحظى بفرصة للتحطيم والتّكسير

245
00:15:42,120 --> 00:15:45,750
أولاً، يجب علينا أن نجعل النّخبة العليا
عِبرة لمن يعتبر

246
00:15:47,240 --> 00:15:48,210
ماذا؟

247
00:15:48,680 --> 00:15:50,860
ستدمّرون هذه المنظّمة؟

248
00:15:51,140 --> 00:15:54,220
ستتخلّون عن شرفكم لأجل المال؟

249
00:15:54,220 --> 00:15:58,680
أيّتها المخلوقات الخسيسة. سأتولّى
أمركم بنفسي

250
00:15:58,680 --> 00:16:00,350
هاجموني جميعكم في آن واحد

251
00:16:07,820 --> 00:16:11,700
سألكمك الآن، لذا آمل أن تنشئ حاجزاً

252
00:16:12,350 --> 00:16:15,210
منظّمة المُدركين فوق حسّيين الخطيرة، المِخلَب

253
00:16:15,580 --> 00:16:18,860
كشيء خطّطتم له عشرين عاماً، إنّه
مليء بالثّغرات

254
00:16:19,620 --> 00:16:23,110
وهل يحتاج فيلٌ على وشك أن يسحق
ألف نملة

255
00:16:23,110 --> 00:16:25,170
للتفكير كثيراً؟

256
00:16:26,370 --> 00:16:28,690
بدأتُ أشعر بالشفقةِ عليك حقّاً

257
00:16:28,690 --> 00:16:31,580
أنت لا تملك أدنى فكرة عن أنّ
الحكومة اليابانيّة

258
00:16:31,580 --> 00:16:34,430
قد وضعتْكم نصب عينيها ولا تعلم
من يكون الشّخص الذي أمامك

259
00:16:35,140 --> 00:16:39,180
تمّ إرسالك بواسطة الحكومة إذاً؟

260
00:16:39,180 --> 00:16:40,680
أنا فقط، أجل

261
00:16:40,680 --> 00:16:43,860
لكن تمكّنتُ من ضمّ الآخرين إلى موكبي

262
00:16:43,860 --> 00:16:46,310
قبل أن نوقف هذا المخطَّط الإرهابي، سنعمل
على تفكيك هذه المنظّمة من الدّاخل

263
00:16:46,750 --> 00:16:48,240
قُضي على المِخلَب

264
00:16:48,770 --> 00:16:49,730
أنت

265
00:16:50,110 --> 00:16:53,650
كنتَ تكذب على الرّئيس سوزوكي؟

266
00:16:53,650 --> 00:16:55,910
!كيف أمكنَك فعل شيء فظيع كهذا؟

267
00:16:56,560 --> 00:16:57,750
!الضجيج الأبيض

268
00:17:06,250 --> 00:17:09,420
يبدو وكأنّه سيكون من الصّعب التحرّك هكذا

269
00:17:10,700 --> 00:17:13,100
حالما يقسو، يصبح بصلابة الفولاذ

270
00:17:13,100 --> 00:17:14,890
أي شخص يعلق في هذا يأتي أجله

271
00:17:16,410 --> 00:17:17,260
!ميغيل

272
00:17:18,030 --> 00:17:21,720
كنتَ تشفق عليّ قبل قليل، أليس كذلك؟

273
00:17:22,210 --> 00:17:25,460
حان دوري الآن لأشفق عليك

274
00:17:28,050 --> 00:17:31,900
هلّا توقّفت عن إتعابي بمزيد من الأعمال؟

275
00:17:34,300 --> 00:17:35,910
حسناً، هذا مثيرٌ للشفقة

276
00:17:35,910 --> 00:17:38,160
يُفترض لهؤلاء أن يكونوا في نخبتنا العُليا

277
00:17:38,610 --> 00:17:40,620
!انظروا إليهم

278
00:17:41,840 --> 00:17:43,290
!اللّعنة

279
00:17:45,900 --> 00:17:48,800
أرى بأنّني وأنت من نفس النّوع

280
00:17:51,020 --> 00:17:55,130
خسارة قادة الفروع لن تكون كافية
لتفكيك المِخلَب

281
00:17:55,420 --> 00:17:58,340
لقد أطلقتُ على القوّة الرئيسيّة للمِخلَب
"‏اسم "الخارقون الخمسة

282
00:17:58,340 --> 00:18:00,350
،ما دمتُ أنا والخارقون الخمسة موجودون

283
00:18:00,350 --> 00:18:02,310
يبقى المِخلَب منيعاً

284
00:18:02,600 --> 00:18:03,900
!لم أنتهِ بعد

285
00:18:03,900 --> 00:18:05,570
—ما زال بمقدوري القضاء عليكم هنا

286
00:18:07,780 --> 00:18:08,770
!ماذا؟

287
00:18:13,960 --> 00:18:15,460
أحسنت صنعاً

288
00:18:15,460 --> 00:18:19,370
عرفتُ أنّه من الإسرافِ أن أدعك
شخصاً منطوياً

289
00:18:19,630 --> 00:18:23,950
حاضر! يعزو كلّ الفضل لك وراء تمكّني
من العودة والانخراط في المجتمع

290
00:18:23,950 --> 00:18:27,410
بالمُناسبة، أين شيمازاكي؟ لم أره

291
00:18:28,080 --> 00:18:31,110
طلبتُ منه تولّي أمر آخر لأجلي

292
00:18:35,590 --> 00:18:36,840
...اللّعنة عليهم

293
00:18:37,180 --> 00:18:38,840
يشكّلون خطراً أكبر ممّا توقّعت

294
00:18:39,800 --> 00:18:42,260
!طلبتُ من أمهر الطبّاخين تحضير هذه الوجبة

295
00:18:42,420 --> 00:18:43,810
!كلوا ما تشاؤون

296
00:18:44,420 --> 00:18:47,370
أنا متفاجئ من أنّ المقرّ لم يهاجم بعد

297
00:18:47,370 --> 00:18:50,520
أعني، بمقدورنا أن نبادر بالهجوم
...لكن نظراً لعددنا

298
00:18:51,020 --> 00:18:54,290
حسناً، أنا وكاغياما-كن نساوي ألف
شخص على الأقلّ

299
00:18:54,290 --> 00:18:57,190
على أي حال، لن نبدأ قبل أن يستيقظ الفتى

300
00:18:57,520 --> 00:19:00,480
!كفّ عن أكل كلّ اللّحم المشوي يا شعر الموهوك

301
00:19:00,480 --> 00:19:01,910
!لكلّ شخص ثلاث قطع فقط

302
00:19:01,910 --> 00:19:02,540
ماذا؟

303
00:19:02,540 --> 00:19:04,850
!اعتذِر من المعلّم ريغن يا كوياما

304
00:19:04,850 --> 00:19:06,160
!أغلِق فمك

305
00:19:06,510 --> 00:19:09,420
لم يكونوا يشاهدون التلفزيون

306
00:19:11,500 --> 00:19:16,070
وبالتالي، بمنح المرأة فرصة للعمل
وتوسعة المجال

307
00:19:16,070 --> 00:19:19,300
...بحيث تتلقّى معونة لإعالة الطفل

308
00:19:19,300 --> 00:19:23,850
يمكننا العمل على توفير حلول للتحرّش
...الجنسيّ واستغلال السّلطة

309
00:19:26,180 --> 00:19:28,110
سُررتُ بلقائك يا رئيس الوزراء

310
00:19:28,320 --> 00:19:32,990
أنا عضو في المِخلَب، المنظّمة التي أعلنت
في اللّيلة الماضية أنّها ستسيطر على العالم

311
00:19:32,990 --> 00:19:36,690
أتيتُ لاختطافِك اليوم

312
00:19:40,770 --> 00:19:42,240
!رئيس الوزراء، تعال من هنا لو سمحت

313
00:19:42,240 --> 00:19:43,550
من تظنّ نفسك بالضبط؟

314
00:19:43,550 --> 00:19:46,640
بالمناسبة، هل تبثّون هذا على التّلفزيون؟

315
00:19:43,580 --> 00:19:44,200
!اللّعنة

316
00:19:44,200 --> 00:19:45,200
!اصمت

317
00:19:45,580 --> 00:19:46,640
!ولا حركة

318
00:19:46,640 --> 00:19:49,740
آمل أن ينتهي المطاف بظهورنا
!في فقرة الأخبار العاجلة

319
00:19:49,740 --> 00:19:52,280
!توقّف! لا تتحرّك

320
00:19:52,600 --> 00:19:53,330
هل يحمل مسدّساً؟

321
00:19:53,330 --> 00:19:54,290
!مكانك

322
00:19:56,240 --> 00:19:57,000
أخفقت الإصابة

323
00:20:02,630 --> 00:20:05,420
كما ترون... رغم أنّني لا أستطيع الرّؤية

324
00:20:05,420 --> 00:20:07,900
إلّا أنّني أستطيع توقُّع حركات الناس

325
00:20:08,620 --> 00:20:11,350
لكن حتّى لو أُصِبت، لا يوجد ما يدفعني للقلق

326
00:20:13,490 --> 00:20:14,610
أرأيتم؟

327
00:20:17,280 --> 00:20:22,880
يا رئيس الوزراء، اسمح لي أن أطلِعَك على ماهيّة
قوّتي الخاصّة الأخرى

328
00:20:22,880 --> 00:20:24,110
...في الحقيقة

329
00:20:25,660 --> 00:20:27,110
يمكنني الانتقال آنيّاً

330
00:20:28,870 --> 00:20:30,640
لماذا تختطفونني؟

331
00:20:30,640 --> 00:20:33,210
ماذا تنوون أن تفعلوا بي؟

332
00:20:33,380 --> 00:20:35,540
لا شيء معقّد. مجرّد رهينة

333
00:20:35,700 --> 00:20:39,320
هل أنتم جادّون حيال هذا؟ الهيمنة
على العالم؟

334
00:20:39,320 --> 00:20:41,870
أجل. جادّين تماماً

335
00:20:47,380 --> 00:20:49,430
ومَن تكون أنت؟

336
00:20:49,680 --> 00:20:53,850
بالصدفة كنتُ أشاهد البثّ فشعرتُ
بحضورِك هنا

337
00:20:54,340 --> 00:20:57,470
إن كنت تعتقد بأنّ كلّ شيء في الحياة
،يجري كما هو مُخطَّط

338
00:20:58,300 --> 00:21:00,820
فيمكنك أن تتلقّن درساً بعد أن أهزمك

339
00:21:00,820 --> 00:21:05,030
يا له من كلام فُكاهي تقوله. يمكنك المُحاولة إذاً

340
00:21:06,400 --> 00:21:07,570
!الانفجار العقليّ

341
00:21:09,080 --> 00:21:10,170
!سِياط الهواء

342
00:21:13,310 --> 00:21:14,290
اختفى؟

343
00:21:15,450 --> 00:21:17,890
ماذا؟ انتقل آنيّاً؟

344
00:21:18,210 --> 00:21:19,940
!التحكّم في النّار

345
00:21:26,520 --> 00:21:28,050
فقدتُ أثرَه ثانية

346
00:21:28,520 --> 00:21:30,220
...هل قوى هذا الرّجل

347
00:21:30,810 --> 00:21:32,330
هنا

348
00:21:41,510 --> 00:21:43,210
حركة بسرعة فائقة؟

349
00:21:43,210 --> 00:21:44,740
...في هذه الحالة

350
00:21:45,120 --> 00:21:46,660
!الحاجز متعدّد الطبقات

351
00:21:48,450 --> 00:21:51,330
تقنيّتي الجديدة التي أجعل فيها
...حواجز عديدة تتشابك

352
00:21:52,030 --> 00:21:54,000
،بينما يحاول العدوّ المُقاومة

353
