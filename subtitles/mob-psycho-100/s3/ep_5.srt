1
00:00:05,630 --> 00:00:09,860
الجميع يعترفون بأنّك المؤسّس الأوّل وينظرون إليك

2
00:00:10,600 --> 00:00:14,120
من أنت؟ النّاسك الرّوحاني-سان؟

3
00:00:14,660 --> 00:00:18,360
ما رأيك بكلّ هذا التّصفيق والهتاف
الّذي لم تحظَ به من قبل؟

4
00:00:19,250 --> 00:00:21,940
ما رأيك؟ أليس الشّعور رائعاً؟

5
00:00:22,840 --> 00:00:24,710
لا، إطلاقاً

6
00:00:26,310 --> 00:00:31,330
لنتكلّم وجهاً لوجه. أنا أسفل القرنبيط

7
00:00:31,330 --> 00:00:34,920
اللّعنة، لم يعُد قرنبيطاً

8
00:00:35,420 --> 00:00:39,590
لأنّ هذا الشيء قد امتصَّ كلّ تلك
،العواطف من أولئك النّاس

9
00:00:39,590 --> 00:00:42,070
تحوّل إلى شيء مختلف كلّياً

10
00:00:42,680 --> 00:00:46,500
هل سبقَ وآمنتَ إيماناً شديداً بشيء؟

11
00:00:47,840 --> 00:00:54,740
تكدُّس الإيمان الشّديد يمكن
أن يُجلِّي الحقيقة أحياناً

12
00:00:55,310 --> 00:00:58,650
تغيُّر جذريّ على وشك أن يشهده هذا العالم

13
00:00:59,060 --> 00:01:03,430
إله جديد يُدعى النّاسك الرّوحاني

14
00:01:03,430 --> 00:01:06,760
سيتّخذ الشّكل الجسديّ ويرتقي

15
00:01:07,840 --> 00:01:08,910
إله؟

16
00:01:09,720 --> 00:01:12,010
أنت مُجرّد مُنسِّق لهذه المجموعة

17
00:01:12,370 --> 00:01:18,470
سوف أدّعي بأنّ النّاسك الرّوحاني هو
إعادة تجسيد لمُؤسّسهم العظيم

18
00:01:19,880 --> 00:01:25,230
سأهدي النّاس إلى الطريق القويم
وأمنح قلوبهم السّلام

19
00:01:25,680 --> 00:01:27,550
الطريق القويم؟

20
00:01:27,980 --> 00:01:32,020
هل منح النّاس السّلام الذهنيّ فعّال أصلاً؟

21
00:01:32,020 --> 00:01:34,530
من يدري؟ أنا أختلق تُرّهات فحسب

22
00:01:35,880 --> 00:01:40,620
فقط صلِّ لخمس دقائق للشّجرة الإلهيّة

23
00:01:41,110 --> 00:01:43,950
هذا يُمثِّل ديمومتي

24
00:01:46,700 --> 00:01:51,890
وسيعرف أتباعي البقيّةَ لأجلي بالطريقة
التي يرونها مناسبة لتفسير هذا

25
00:01:56,230 --> 00:01:58,800
يبدو أنّ لديك ما تريد قوله

26
00:01:58,800 --> 00:02:02,560
لكن انظر، المُؤمنون يستمتعون بوقتهم أيضاً

27
00:02:03,560 --> 00:02:05,970
...بمن فيهم ريتسو وريغن

28
00:02:07,590 --> 00:02:10,400
لكن مع الأسف، باستثناء هذا

29
00:02:10,690 --> 00:02:14,730
كشفَ أمري قبل أيّ شخص آخر وحاول
إحباط كلّ هذا أوّلاً

30
00:02:15,610 --> 00:02:19,320
في النّهاية، أكثر شخص يستمتع هو الفائز

31
00:02:20,520 --> 00:02:25,590
...إذاً أنت من جعلَ المُعلّم ريغن يقول ذلك

32
00:02:26,550 --> 00:02:27,720
يا إيكوبو

33
00:04:04,560 --> 00:04:07,530
مهلاً، لا تغضب

34
00:04:07,530 --> 00:04:09,010
هانازاوا بخير

35
00:04:10,100 --> 00:04:13,930
الأهمّ من ذلك، انضمّ لدين النّاسك الرّوحاني

36
00:04:13,930 --> 00:04:18,200
يمكنني وأنت أن نعتلي القمّة ونقضي وقتاً ممتعاً معاً

37
00:04:18,750 --> 00:04:19,910
لماذا؟

38
00:04:19,910 --> 00:04:24,600
حسبما يبدو، أنت قويّ بما يكفي بالفعل

39
00:04:24,950 --> 00:04:27,990
ما زلت قادراً على تنمية نفسك

40
00:04:27,990 --> 00:04:33,540
بالنظر إلى المستقبل، ارتأيتُ أنّه
من الهدر عدم استغلال تلك القوّة

41
00:04:33,540 --> 00:04:34,660
أرفُض

42
00:04:36,900 --> 00:04:39,620
حسناً، توقعتُ أن تكون هذه إجابتك حاليّاً

43
00:04:39,910 --> 00:04:44,610
...لكن عائلتك وأصدقاؤك والجميع

44
00:04:45,280 --> 00:04:49,230
يعيشون بالفعل في عالم يذوقون فيه السّعادة

45
00:04:49,230 --> 00:04:52,150
من خلال إيمانهم بالنّاسك الرّوحاني-ساما

46
00:04:52,970 --> 00:04:58,300
أنت المُتبقّي الوحيد في هذه المدينة يا شيغيو

47
00:04:58,990 --> 00:05:01,960
لن يعود أحد أبداً

48
00:05:01,960 --> 00:05:04,350
إلى متى ستكون عنيداً؟

49
00:05:04,780 --> 00:05:10,260
غُسِلَ دماغ الجميع بواسطتك. أنت
من عليه أن يتوقّف عن ذلك

50
00:05:10,260 --> 00:05:11,650
هل أنت غاضب؟

51
00:05:11,900 --> 00:05:13,140
أجل

52
00:05:13,790 --> 00:05:15,110
بالطبع أنا غاضب

53
00:05:15,790 --> 00:05:18,290
أعِد الجميع إلى رُشدهم حالاً

54
00:05:18,290 --> 00:05:20,560
...وحتّى أنّك نلتَ من ريتسو والمُعلّم ريغن

55
00:05:20,560 --> 00:05:22,320
كيف تمكّنت من ذلك؟

56
00:05:23,000 --> 00:05:26,600
كانت المرحلة الأولى دفعهم لِلمس الشّجرة الإلهيّة

57
00:05:26,600 --> 00:05:29,760
أو جعلهم يهضمون قليلاً منها بطريقة ما

58
00:05:30,080 --> 00:05:33,850
دخلتُ إلى عقولهم من خلال التّلامس الجسديّ

59
00:05:34,430 --> 00:05:40,380
والمرحلة الثّانية كانت إظهار الشّغف
الجماعي للقلّة المُتبقّيين

60
00:05:41,130 --> 00:05:43,060
هكذا تمكّنتُ من ريغن أيضاً

61
00:05:43,570 --> 00:05:46,530
تمّ قهره بواسطة المُحيطين به

62
00:05:47,870 --> 00:05:51,310
والآن دخلنا المرحلة الثّالثة

63
00:05:51,690 --> 00:05:58,120
ذلك الشّعور العميق بالإيمان ينتقل
من شخص لآخر

64
00:05:58,120 --> 00:06:03,500
ليست إلّا مسألة وقت قبل أن يؤمن
الجميع في البلد بدين النّاسك الرّوحاني

65
00:06:04,070 --> 00:06:06,230
ثمّ سيكون رهيباً

66
00:06:06,630 --> 00:06:10,170
حينئذ سأصبح إلهاً جديداً بحقّ

67
00:06:10,610 --> 00:06:15,140
لا أفهم شيئاً من كلامك، لكن أن
تصبح إلهاً لَهو أمر عقيم أيضاً

68
00:06:15,730 --> 00:06:18,560
ألا تعي حقّاً ما تفعله؟

69
00:06:18,560 --> 00:06:19,360
ماذا؟

70
00:06:19,770 --> 00:06:22,100
المدينة برمّتها في فوضى

71
00:06:22,100 --> 00:06:23,470
المدينة؟

72
00:06:23,470 --> 00:06:28,600
لم أكن أعلم ذلك، لكن يمكننا أن نعيد إعمارها لاحقاً فحسب

73
00:06:28,850 --> 00:06:31,700
هذا يكفي. أبطِل غسيل أدمغتهم فحسب

74
00:06:31,960 --> 00:06:36,400
هذا ليس من طباعك. أنت عاطفيّ
جدّاً وضيّق التّفكير

75
00:06:36,880 --> 00:06:40,490
تظلّ تقول عنه غسيل أدمغة، لكنّه
ليس بذلك السّوء صدّقني

76
00:06:40,890 --> 00:06:43,720
،فأنا لم أغيّر طبائعهم

77
00:06:43,720 --> 00:06:47,100
ولا هواياتهم أو الأشياء الّتي يحبّونها

78
00:06:47,620 --> 00:06:48,800
الشّعور الّذي يراود ريتسو وريغن

79
00:06:49,450 --> 00:06:54,010
والجميع في نادي التّطوير الجسماني
تجاهك لن يتغيّر أيضاً

80
00:06:54,280 --> 00:06:58,100
جميعكم ستصبحون أتباعاً لدين النّاسك
الرّوحاني فقط لا غير

81
00:06:58,890 --> 00:07:00,190
...و

82
00:07:00,450 --> 00:07:06,150
ستشعرون بالسّعادة بذلك وستتمكّنون من مشاركة
تلك السّعادة مع مؤمنين آخرين

83
00:07:06,610 --> 00:07:10,650
أنا لا أحاول عزلكم عن المرح هنا

84
00:07:11,640 --> 00:07:12,610
...لذا

85
00:07:12,610 --> 00:07:14,910
ما مشكلتك بالضبط؟

86
00:07:16,290 --> 00:07:18,290
ما الخطأ الّذي أرتكبه؟

87
00:07:21,800 --> 00:07:23,720
ما الخطأ الّذي ترتكبه؟

88
00:07:24,160 --> 00:07:26,890
إيكوبو، أنت تتحايل

89
00:07:27,510 --> 00:07:30,530
تتحكّم بقلوب النّاس بقوّتك

90
00:07:30,530 --> 00:07:33,850
هذا يعني بأنّهم لا يستطيعون عصيانك
ويمكنك جعلهم يفعلون ما تشاء

91
00:07:34,670 --> 00:07:38,920
نعيش في عالم محكوم بقوانين وعادات اجتماعيّة

92
00:07:38,920 --> 00:07:41,140
والتي لا يمكننا عصيانها من الأساس

93
00:07:41,410 --> 00:07:45,240
إن كنت تغفلها، فليست لديك أيّ مشكلة

94
00:07:45,500 --> 00:07:48,360
،فضلاً عن ذلك، إذا لم أصغِ إليكِ

95
00:07:48,360 --> 00:07:51,750
ألن تلجأ للقوّة فحسب في نهاية المطاف؟

96
00:07:51,950 --> 00:07:54,120
...بالتأكيد، لكن لا أملك خياراً

97
00:07:54,120 --> 00:07:57,480
لأنّ عائلتي وأصدقائي تُغسَل أدمغتهم

98
00:07:58,680 --> 00:08:02,500
صدّق أو لا تصدّق، أنا متحفّظ جدّاً الآن

99
00:08:03,230 --> 00:08:04,880
انتظر يا كاغياما-كن

100
00:08:05,220 --> 00:08:09,500
ما يفعله إيكوبو-كن ليس شرّاً بكل معنى الكلمة

101
00:08:09,500 --> 00:08:10,200
ماذا؟

102
00:08:10,450 --> 00:08:12,120
فكّر في الأمر عقلانيّاً

103
00:08:12,120 --> 00:08:16,030
إذا اخترت العنف فقط لأنّك لا تتّفق
معه، فالأمر انتهى

104
00:08:16,460 --> 00:08:19,480
لا، ما زال هناك وقت

105
00:08:19,480 --> 00:08:22,850
لم يبدأ دين النّاسك الرّوحاني رسميّاً بعد

106
00:08:23,470 --> 00:08:26,380
لا. إذا وضعت يديك عليه، ينتهي الأمر

107
00:08:26,790 --> 00:08:29,080
...علاقتك مع إيكوبو-كن

108
00:08:29,790 --> 00:08:32,360
صداقتنا سوف تنتهي

109
00:08:33,440 --> 00:08:37,960
،إذا كنت ستُدمّر دين النّاسك الرّوحاني بالقوّة

110
00:08:38,510 --> 00:08:40,480
سوف أوقفك

111
00:08:41,160 --> 00:08:43,500
،حتّى لو هزمتني

112
00:08:43,500 --> 00:08:47,080
أخوك الصّغير وريغن-سان لن يدعاك تفلت بفعلتِك

113
00:08:47,490 --> 00:08:50,910
في نهاية الأمر، سيقف الجميع في طريقك

114
00:08:51,410 --> 00:08:53,720
...إيكوبو، أنت

115
00:08:54,680 --> 00:08:57,460
لا يضمر هانازاوا أيّ نوايا سيّئة أيضاً

116
00:08:57,460 --> 00:09:01,230
يحاول فقط أن يقنعك بتغيير رأيك
لأنّه يهتمّ لأمرك فعلاً

117
00:09:01,460 --> 00:09:04,600
،أخبرتُك، حتّى إن لم تفعل شيئاً
—حياة الجميع اليوميّة

118
00:09:07,380 --> 00:09:11,610
إيكوبو، اخرج. أريد أن أتكلّم معك وجهاً لوجه

119
00:09:11,610 --> 00:09:13,440
!كُفّ عن هذا يا كاغياما-كن

120
00:09:14,010 --> 00:09:17,070
كنّا نتكلّم طوال هذا الوقت

121
00:09:19,730 --> 00:09:23,450
إذا أذيتَ دين النّاسك الرّوحاني
...أو الشّجرة الإلهيّة

122
00:09:23,450 --> 00:09:24,950
!فسيترتّب عليك مُواجهتي إذاً

123
00:09:38,130 --> 00:09:40,960
!هانازاوا-كن! استفِق

124
00:09:41,190 --> 00:09:43,880
لسوء حظّك، أنا لا أتحكّم به

125
00:09:44,100 --> 00:09:46,800
اكتسبتُ للتو شيئاً مهمّاً آخر في حياتي

126
00:09:46,800 --> 00:09:50,660
سوف أستمرّ في القتال حتّى تستسلم
وتغادر يا كاغياما-كن

127
00:09:52,950 --> 00:09:54,050
أنا آسف

128
00:10:05,730 --> 00:10:07,340
!إيكوبو، اكشف عن نفسك

129
00:10:16,420 --> 00:10:19,840
أولئك المُؤمنون مُنعَمون بالألوهيّة

130
00:10:19,840 --> 00:10:22,660
يمتلك هانازاوا قوى إلهيّة الآن

131
00:10:23,700 --> 00:10:26,640
...أنا أفيض بالقوّة

132
00:10:33,720 --> 00:10:37,180
...هانا... زاوا-كن

133
00:10:38,710 --> 00:10:39,520
أنا آسف

134
00:10:53,010 --> 00:10:57,170
يا للهول! انتهى المطاف بي بأذيّة
الشّجرة الإلهيّة ثانية

135
00:10:57,360 --> 00:10:59,560
أحسنت صنعاً يا هانازاوا

136
00:10:59,560 --> 00:11:04,080
شيغيو، إذا تركتَ الشّجرة الإلهيّة
،تعتنقك وهدّأت من روعك

137
00:11:04,080 --> 00:11:06,310
ستغيّر رأيك أيضاً

138
00:11:08,670 --> 00:11:10,350
...يا لها من قوّة هائلة

139
00:11:12,150 --> 00:11:14,100
جذور القرنبيط؟

140
00:11:21,460 --> 00:11:23,660
...هذه الجذور خطيرة

141
00:11:24,150 --> 00:11:26,760
!ابتعد من هنا يا هانازاوا-كن

142
00:11:30,500 --> 00:11:32,480
!مهلاً يا كاغياما-كن

143
00:11:32,480 --> 00:11:34,830
!النّاسك الرّوحاني-ساما، قِف خلفي

144
00:11:42,980 --> 00:11:47,460
!مـ-مذهل... أنت مذهل حقّاً

145
00:11:54,130 --> 00:11:58,880
اللّعنة. ها قد شكّلتَ فجوة في الشّجرة الإلهيّة

146
00:11:59,330 --> 00:12:01,630
...لكن سُرعان ما ستُسَدّ على أيّ حال

147
00:12:04,400 --> 00:12:10,490
أعتقد ليس من السّهل أن يصبح المرء
إلهاً في نهاية المطاف يا شيغيو

148
00:12:11,140 --> 00:12:12,040
لا جدوى

149
00:12:29,530 --> 00:12:32,450
إيكوبو، لماذا؟

150
00:12:33,280 --> 00:12:35,730
لماذا لا تكشف عن نفسك؟

151
00:12:46,660 --> 00:12:47,850
...أيُعقَل

152
00:12:51,400 --> 00:12:53,490
أنّك خائف منّي؟

153
00:13:18,020 --> 00:13:19,590
هل سوف نستمرّ؟

154
00:13:22,000 --> 00:13:25,080
يكفي. هذا يكفي

155
00:13:26,090 --> 00:13:28,250
لا تجبرني على الشّعور هكذا

156
00:13:29,000 --> 00:13:31,760
ألا تفهم يا إيكوبو؟

157
00:13:33,650 --> 00:13:35,230
اخرج أرجوك

158
00:13:37,190 --> 00:13:38,520
...وإلّا

159
00:14:11,650 --> 00:14:15,370
قوايّ... تُمتَصّ

160
00:14:16,710 --> 00:14:18,160
صحيح

161
00:14:18,970 --> 00:14:22,200
كان ينبغي لك أن تلاحظ ذلك قبل مدّة قصيرة

162
00:14:25,620 --> 00:14:32,050
كان من الخطأ أن تسمح لنفسك أن تُستدرَج
إلى داخل الشّجرة الإلهيّة

163
00:14:39,010 --> 00:14:41,620
...لكن خطأك الأكبر

164
00:14:43,940 --> 00:14:46,900
كان عندما تحدّيتني

165
00:14:47,780 --> 00:14:51,160
!إيكوبو... ما معنى هذا؟

166
00:14:51,400 --> 00:14:53,770
هدّئ من روعك قليلاً

167
00:14:53,770 --> 00:14:56,110
،إن لم تصغِ إليّ

168
00:14:56,110 --> 00:14:57,860
فقد أدعها تخبرك

169
00:14:58,770 --> 00:15:02,080
...إذا تركتُ تسوبومي-تشان تُقنعك

170
00:15:02,080 --> 00:15:04,590
رُبّما سوف تهدأ أخيراً

171
00:15:04,930 --> 00:15:09,600
موب-كن! لا يجوز أن تسبّب المتاعب للجميع
!في دين النّاسك الرّوحاني

172
00:15:10,040 --> 00:15:12,290
!عليك أن تفهم ذلك

173
00:15:12,290 --> 00:15:13,630
فهمت؟

174
00:15:19,260 --> 00:15:20,470
...مهلاً، مهلاً

175
00:15:21,120 --> 00:15:26,300
تصبح جادّاً متى كان للأمر علاقة بتسوبومي-تشان

176
00:15:27,340 --> 00:15:30,150
وفي ذات الوقت، أظنّني سوف أفسد
الأمر لك أخيراً

177
00:15:30,150 --> 00:15:34,120
شيغيو، لا فُرصة لك معها

178
00:15:38,430 --> 00:15:43,550
تاكاني تسوبومي هي من النّوع الّذي يقول
صراحةً عن شيء لا تريده بأنّها لا تريده

179
00:15:44,230 --> 00:15:48,760
،حاولتُ بالقوّة أن أعطيها إحدى السّكاكر
لكنّها دفعت يده بعيداً

180
00:15:49,990 --> 00:15:52,380
،حتّى عندما استخدمتُ صديقاتها للتقرّب منها

181
00:15:52,380 --> 00:15:54,250
لم تكن مهتمّة

182
00:15:56,210 --> 00:16:00,530
إنّها امرأة قويّة لا تمتثل للآخرين

183
00:16:00,530 --> 00:16:02,340
وتعيش على مبادئها الخاصّة

184
00:16:02,910 --> 00:16:04,800
،لا عجب في أنّها لم تلحظك حتّى

185
00:16:04,800 --> 00:16:07,130
عندما استخدمتَ قواك الرّوحانيّة أمامها

186
00:16:07,670 --> 00:16:13,150
ولو تقطّعتْ أوصالك، أنا متأكّد بأنّها لا تحتاجك أبداً

187
00:16:14,450 --> 00:16:20,190
لكنّها الآن... جزء من دين
النّاسك الرّوحاني

188
00:16:21,850 --> 00:16:27,870
ما يعني بأنّك قد تتمكّن من كسب قلبها
بصفة المؤسّس العظيم شيغيو

189
00:16:30,250 --> 00:16:31,710
هذا كلام فارغ

190
00:16:34,790 --> 00:16:37,930
...ظننتُ بأنّنا امتصصنا معظم قواك

191
00:16:37,930 --> 00:16:40,740
لكن أعتقد ما زال لديك البعض

192
00:16:42,330 --> 00:16:46,640
ربّما ما كان ينبغي أن أكشف عن نفسي بعد

193
00:16:47,520 --> 00:16:52,100
—حسناً، أيّاً يكن. ليس وكأنّني سأخسر أمامك فور

194
00:16:53,810 --> 00:16:55,070
...ا-انتظر

195
00:16:55,600 --> 00:16:57,410
...مـ-مهلاً، انتظر لحظة

196
00:17:05,590 --> 00:17:07,750
!لا تغترّ بنفسك، اللّعنة

197
00:17:07,750 --> 00:17:10,330
!أهكذا تردّ جميلي؟

198
00:17:10,640 --> 00:17:15,210
أظنّني سوف أصبح جادّاً أيضاً

199
00:17:23,010 --> 00:17:24,880
راقب عن كثب

200
00:17:25,400 --> 00:17:30,310
...هذا إيكوبو الإله العظيم

201
00:17:30,960 --> 00:17:33,170
!المولود حديثاً

202
00:17:33,910 --> 00:17:36,150
وماذا يعني؟

203
00:17:37,570 --> 00:17:38,330
!ها أنا ذا

204
00:17:41,360 --> 00:17:42,830
!اللّكمة الإلهيّة

205
00:17:46,670 --> 00:17:48,360
!الاندفاعة الإلهيّة

206
00:17:50,380 --> 00:17:51,920
...ثمّ

207
00:17:52,410 --> 00:17:55,100
!الضّربة الإلهيّة المُحطِّمة

208
00:17:59,140 --> 00:18:01,670
حسناً؟ ما رأيك بقوّة الإله؟

209
00:18:01,960 --> 00:18:03,230
ألم تستسلم بعد؟

210
00:18:07,860 --> 00:18:10,060
!الرّمية الإلهيّة

211
00:18:13,240 --> 00:18:15,400
...كيس الرّمل

212
00:18:15,910 --> 00:18:17,920
!الإلهي

213
00:18:20,260 --> 00:18:22,460
!القوّة الإلهيّة

214
00:18:29,700 --> 00:18:31,740
...أنا مُدركٌ تماماً يا شيغيو

215
00:18:32,600 --> 00:18:36,580
بأنّ هذا لا يكفي لهزيمتك

216
00:18:39,620 --> 00:18:41,660
...لكن ينبغي أن تكون مُستنزَفاً تماماً عمّا قريب

217
00:18:41,960 --> 00:18:44,360
القوّة الهائلة التي امتصصناها منه

218
00:18:44,360 --> 00:18:46,650
تدفّق إلى داخلي عبر الشّجرة الإلهيّة

219
00:18:47,650 --> 00:18:51,140
رأيتُ حدودَ قوّته عندما قاتلَ زعيم المِخلَب

220
00:18:51,440 --> 00:18:54,210
قوّته ليست غير مُتناهية. إنّها محدودة

221
00:18:55,330 --> 00:18:59,020
كادَ يخسر أمام قوى موغامي كيجي الذهنيّة أيضاً

222
00:18:59,350 --> 00:19:01,370
!إنّه ليس شخصاً لا يُقهَر

223
00:19:02,750 --> 00:19:07,090
أعرف كيفيّة هزيمة كاغياما شيغيو
...أكثر من أيّ

224
00:19:07,090 --> 00:19:08,890
أهذه هيئتك الحقيقيّة؟

225
00:19:10,880 --> 00:19:15,970
!أهذه هويّتك الحقيقيّة؟ أيّ هُراء هذا؟

226
00:19:15,970 --> 00:19:19,460
!لا تقلق. سأُسكِتُك بلمحة بصر

227
00:19:19,980 --> 00:19:23,640
!سأدعك تندم على المجيء إلى هنا

228
00:19:23,640 --> 00:19:25,950
أهذا ما تعتقده حقّاً؟

229
00:19:27,130 --> 00:19:30,660
إذاً لا ينبغي أن تتحفّظ

230
00:19:31,160 --> 00:19:35,860
...قِواك وتصرّفاتك وكلماتك

231
00:19:35,860 --> 00:19:37,780
كُلّها مُزيّفة

232
00:19:38,410 --> 00:19:41,370
لا تحاول أن تُقنعني بأنّ هذا هو إيكوبو الحقيقيّ

233
00:19:42,160 --> 00:19:43,240
...هذا فقط

234
00:19:43,770 --> 00:19:47,950
.لا يليق بك. لن أسمح بذلك. لن أقبل بذلك

235
00:19:52,010 --> 00:19:54,890
!من تعتقِد نفسك بالتّحديد؟

236
00:19:55,290 --> 00:19:57,450
!لن تقبل بذلك؟

237
00:19:57,450 --> 00:20:04,140
لا تنكر الشّيء الّذي كنتُ أنتظره
!بلهفة بهذه العفويّة

238
00:20:04,800 --> 00:20:08,250
!الشُّعاع الإلهيّ

239
00:20:18,960 --> 00:20:21,930
!تـ-تبّاً! استهلكتُ كثيراً من الطاقة

240
00:20:22,550 --> 00:20:23,100
—شيغيو

241
00:20:25,270 --> 00:20:28,610
أ-أستطيع الشُّعور بغضبه

242
00:20:31,970 --> 00:20:33,450
...لـ-لحظة، لحظة

243
00:20:34,060 --> 00:20:39,590
ما زال هذا الحقير... ما زال يمتلك
كلّ هذه القوّة؟

244
00:20:44,100 --> 00:20:46,380
يجب أن أُجهِز عليه قبل أن يصِل إليّ

245
00:20:49,370 --> 00:20:51,550
كانت هجمة مُفاجئة بالفعل

246
00:20:52,010 --> 00:20:53,980
كدتُ أموت

247
00:20:54,550 --> 00:20:57,950
مزيدٌ من ذلك قد يفضي إلى فقداني
كلّ إيماني بك

248
00:21:00,380 --> 00:21:04,480
هذا مُرعِب... إنّه يحملِق بي بتلكما العينين

249
00:21:04,850 --> 00:21:10,220
.جُلّ ما أريده هو معرفة شعورك فعليّاً
قُل شيئاً يا إيكوبو

250
00:21:10,760 --> 00:21:13,090
لا تخبرني بذلك

251
00:21:13,690 --> 00:21:18,960
!كنتُ أحاول استغلالك من البداية

252
00:21:19,820 --> 00:21:22,800
...أنا حزين. لذا

253
00:21:23,300 --> 00:21:25,160
هل هذه لحظة الوداع يا إيكوبو؟

254
00:21:25,420 --> 00:21:26,440
!سيُهاجمني؟

255
00:21:30,690 --> 00:21:32,260
!فلتشهد قوّتي الرّوحانيّة الكاملة

256
00:21:32,260 --> 00:21:35,790
!سوف أنهي هذا الأمر

257
00:21:47,780 --> 00:21:49,500
!هذا القميص سخيف

258
00:23:26,180 --> 00:23:29,900
لم أنسجم معك يوماً يا شيغيو

259
00:23:29,900 --> 00:23:33,010
كان ينبغي أن أكون قادراً على استخدام
قوانا الرّوحانيّة وننعم بحياة أفضل

260
00:23:33,010 --> 00:23:35,640
تُجيد استفزازي حقّاً

261
00:23:35,640 --> 00:23:37,830
:الحلقة القادمة من موب سايكو 100 الموسم 3، الحلقة 6

262
00:23:37,830 --> 00:23:39,670
"~الشّجرة الإلهيّة 3 ~حقيقة إيكوبو"