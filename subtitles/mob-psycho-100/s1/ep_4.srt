1
00:00:05,190 --> 00:00:08,210
!جماعة مدرسة ملح الإعداديّة أقوياء

2
00:00:08,210 --> 00:00:11,760
اللّعنة... إنّه تينغا الشّيطان من مدرسة
ملح الإعداديّة إذاً

3
00:00:11,760 --> 00:00:15,820
أهذا كُل ما لديكم؟ لم نقم بالإحماء حتّى

4
00:00:16,210 --> 00:00:17,280
!اللّعنة

5
00:00:17,280 --> 00:00:18,070
!القائد السرّي

6
00:00:18,070 --> 00:00:19,870
!فليُحضر أحدكم تيرو-سان

7
00:00:22,070 --> 00:00:23,890
...تـ-تبّاً

8
00:00:23,890 --> 00:00:25,660
لا أتوقّع أقلّ من هذا من تيرو-سان

9
00:00:25,660 --> 00:00:28,060
لكن أليس هذا مبالغاً به قليلاً؟

10
00:00:28,060 --> 00:00:31,460
ليس باليدِ حيلة، فقد تحلّوا بالجرأةِ لمواجهتنا

11
00:00:31,470 --> 00:00:35,090
،إن أثبتَّ لهؤلاء الأغبياء أنّك أعلى منهم بكثير

12
00:00:35,090 --> 00:00:38,110
فسوف يُصبِحون متواضعين جدّاً فجأة
وكأنّهم أشخاص مختلِفين كلّياً

13
00:00:38,110 --> 00:00:40,130
مثلكم تماماً

14
00:00:40,480 --> 00:00:45,590
ناهيكم عن أنّه لا ضير من جعل
هؤلاء الشّباب مدينين لي

15
00:00:47,170 --> 00:00:49,070
...القوّة والنّاس

16
00:00:49,070 --> 00:00:52,280
سأستفيدُ من كلّ شيء قدر المُستطاع

17
00:00:52,560 --> 00:00:56,010
لأنّني بطل العالم

18
00:02:31,960 --> 00:02:34,120
!شيغي، استيقظ

19
00:02:34,120 --> 00:02:35,740
ستتأخّر

20
00:02:38,480 --> 00:02:41,720
صباح الخير، أليس صباحاً جميلاً يا شريك؟

21
00:02:42,160 --> 00:02:43,260
تفاجأت؟

22
00:02:43,260 --> 00:02:46,950
حسناً، يقولون أنّ عدوّ البارحة
قد يُصبح صديق اليوم

23
00:02:47,740 --> 00:02:49,560
أتريدُ مُصافحتي؟

24
00:02:50,680 --> 00:02:53,020
!ما خطبك؟! توقّف! انتظر، انتظر

25
00:02:54,270 --> 00:02:56,780
!لقد أخفتَني! ماذا تفعل؟

26
00:02:57,060 --> 00:02:58,690
ظننتُه حلماً

27
00:02:59,060 --> 00:03:02,200
!وعندما تعتقدُ ذلك يُفترَضُ أن تقرص خدّك

28
00:03:03,450 --> 00:03:04,120
من أنت؟

29
00:03:04,120 --> 00:03:06,700
!أنا إيكوبو، رئيس الطّائفة الدينيّة

30
00:03:07,450 --> 00:03:10,370
!لقد تصارعنا حتّى الموت البارحة

31
00:03:10,740 --> 00:03:12,620
لم تختفِ كلّياً إذاً

32
00:03:12,620 --> 00:03:14,130
!اسمعني

33
00:03:14,590 --> 00:03:18,380
!لا أنوي العيش بقيّة حياتي كمُجرَّد روح

34
00:03:18,380 --> 00:03:20,060
لكن ألستَ ميّتاً أصلاً؟

35
00:03:20,060 --> 00:03:22,680
من الفظاظة أن تقول هذا الكلام يا شيغي-تشان

36
00:03:23,040 --> 00:03:26,430
مغنّية مشهورة! لاعب كرة قاعدة محترف
!نجم أفلام

37
00:03:26,430 --> 00:03:28,930
!لكلّ شخص حلم

38
00:03:29,240 --> 00:03:31,470
وأنا لديّ طموحات أيضاً

39
00:03:31,470 --> 00:03:34,120
...أن أعتلي قمّة الخلائق

40
00:03:34,120 --> 00:03:36,780
!جوهريّاً، أن أصبح إلهاً

41
00:03:36,780 --> 00:03:39,280
أحلمُ باليوم الذي أصبحُ فيه إلهاً

42
00:03:39,660 --> 00:03:43,260
لهذا أسّستَ تِلك المنظّمة الدينيّة إذاً

43
00:03:43,260 --> 00:03:44,870
مع أنّها سُحِقَتْ

44
00:03:45,300 --> 00:03:47,690
...ولكن الآن عرفت

45
00:03:47,690 --> 00:03:49,870
،أنّه كي أفتن قلوب النّاس

46
00:03:49,870 --> 00:03:53,330
عليّ أن أبرز بعضاً من القوى الروحانيّة المتينة

47
00:03:53,580 --> 00:03:55,940
!شيغي-تشان تعاون معي

48
00:03:55,940 --> 00:03:58,170
!ليكن هدفنا أن نعتلي قمّة العالم معاً

49
00:03:58,400 --> 00:04:00,050
هل من كلمات أخيرة أخرى؟

50
00:04:01,420 --> 00:04:05,220
!هل أنتَ جادّ؟! لا أريدُ أن أختفي بعد

51
00:04:05,770 --> 00:04:07,770
!لن أرتكب أي عمل شرّير بعد الآن

52
00:04:08,310 --> 00:04:09,560
هل أنتَ متأكّد؟

53
00:04:09,790 --> 00:04:11,550
!أقولُ الحقيقة

54
00:04:12,420 --> 00:04:13,500
حسناً

55
00:04:14,160 --> 00:04:16,480
سأناقشُ المسألة مع معلّمي إذاً

56
00:04:16,480 --> 00:04:18,960
لا تقم بأي عمل غريب في منزلي أو مدرستي

57
00:04:20,710 --> 00:04:22,690
يا لك من رقيق

58
00:04:22,690 --> 00:04:25,530
سأنتهزُ فُرصتي للاستحواذِ عليه فحسب

59
00:04:27,140 --> 00:04:30,510
ني-سان، تقولُ أمّي أسرع وتناول فطورك

60
00:04:30,510 --> 00:04:31,950
حسناً، أنا قادمٌ في الحال

61
00:04:32,400 --> 00:04:34,540
هل كنتَ تتكلّمُ مع أحدٍ للتو؟

62
00:04:34,790 --> 00:04:36,100
لا

63
00:04:36,100 --> 00:04:38,600
هكذا إذاً، ينبغي أن تسرع إذاً

64
00:04:38,600 --> 00:04:39,550
حسناً

65
00:04:40,830 --> 00:04:44,450
يبدو أخوك ذكيّاً جدّاً ولطيفاً يا شيغي-تشان

66
00:04:44,450 --> 00:04:46,260
اسمي شيغيو

67
00:04:46,660 --> 00:04:49,160
إذا ناديتَني "ِشيغي-تشان" في المرّة المُقبلة
فسوف أرسلُك إلى العالم الآخر

68
00:04:49,160 --> 00:04:52,770
حـ-حسناً. آسف يا شـ-شيغيو

69
00:04:53,920 --> 00:04:59,020
كما تبيّنتُ البارحة، من الصّعب
استقراء أفكار شيغيو

70
00:04:59,020 --> 00:05:03,780
عليّ أن أجري بحثاً حول حياته الشخصيّة وعلاقاته
وأحاول اكتشافه

71
00:05:04,170 --> 00:05:08,780
إن سارت الأمور على ما يُرام، قد أصبح
نظيراً فريداً من نوعه لشيغيو

72
00:05:09,110 --> 00:05:12,740
...وإذا بدأ بالاعتمادِ عليّ في نهاية المطاف

73
00:05:15,620 --> 00:05:17,120
كاغياما-كُن

74
00:05:17,410 --> 00:05:20,040
أنتَ كاغياما ريتسو-كُن من الصفّ 1-3، صحيح؟

75
00:05:20,700 --> 00:05:21,380
أجل

76
00:05:21,950 --> 00:05:24,910
أنا ميزاتو من الصفّ 2-1 ومن الصّحيفة المدرسيّة

77
00:05:24,910 --> 00:05:26,300
هلّي بلحظة؟

78
00:05:26,300 --> 00:05:28,540
أنتِ في نفس صفّ أخي إذاً

79
00:05:28,540 --> 00:05:31,140
إن أردتِ معرفة قواه النفسيّة
فينبغي أن تقابليه شخصيّاً

80
00:05:31,510 --> 00:05:35,810
على رسلِك، لديّ كلام مُثيرٌ أقوله لك أيضاً

81
00:05:36,290 --> 00:05:38,470
هل حلّ مكروهٌ ما بأخي؟

82
00:05:39,800 --> 00:05:42,400
لقد تلقّيتُها بالتأكيد

83
00:05:42,780 --> 00:05:47,670
،سأطهّرُ صورة الرُّوح الشرّيرة هذه

84
00:05:47,670 --> 00:05:50,160
لِذا عُد بعد حوالي ساعتين من فضلك

85
00:05:52,760 --> 00:05:54,660
!طرد الأرواح الرّسوميّ

86
00:05:56,640 --> 00:06:01,220
باستخدام برنامج رسوم حاسوبيّة، يعدِّل
الصُّور ويحرّرها من الشّوائب باحترافيّة

87
00:06:02,240 --> 00:06:04,800
هذه إحدى حركات ريغن الخاصّة

88
00:06:05,640 --> 00:06:06,540
!تبّاً

89
00:06:06,540 --> 00:06:09,060
!مسحتُ حاجب العميل بالخطأ أيضاً

90
00:06:10,180 --> 00:06:11,110
معلّم

91
00:06:11,110 --> 00:06:13,680
أهذا أنتَ يا موب؟ أنا مشغولٌ قليلاً
الآن، لِذا أمهلني دقيقة

92
00:06:13,800 --> 00:06:16,020
لحظة... أهذا معلّمُك؟

93
00:06:16,330 --> 00:06:19,530
نعم، إنّه الرّوحانيّ، المعلّم ريغن

94
00:06:19,530 --> 00:06:21,640
هذا غير معقول

95
00:06:21,640 --> 00:06:22,360
ماذا تعني؟

96
00:06:22,750 --> 00:06:25,670
لا أشعر بأي قوّة روحيّة تنبعثُ منه على الإطلاق

97
00:06:25,670 --> 00:06:29,200
ذاك الغبيّ شيغيو يتمُّ استغلاله بوضوح

98
00:06:29,690 --> 00:06:32,450
...بمقدوري أن أنبّهه

99
00:06:32,610 --> 00:06:35,370
لكن لا، هذا جيّد

100
00:06:35,370 --> 00:06:37,710
سأستغلُّه استغلالاً كاملاً أيضاً

101
00:06:39,290 --> 00:06:41,080
حسناً، إنّها جاهزة

102
00:06:41,280 --> 00:06:44,750
معلّم، لقد علِقَتْ بي روحٌ منذُ هذا الصّباح

103
00:06:44,750 --> 00:06:46,480
ماذا ينبغي أن أفعل برأيك؟

104
00:06:46,480 --> 00:06:48,250
هل أخفيها؟

105
00:06:51,980 --> 00:06:54,850
لن تتمكّن من رؤيتي أيّها المزيّف

106
00:06:55,010 --> 00:06:56,850
إنّها ضعيفة جدّاً لدرجةٍ لا أراها

107
00:06:58,290 --> 00:07:02,090
بالنسبة لك، إنّها بمثل حجم دعسوقة
حطّتْ على كتفِك

108
00:07:02,090 --> 00:07:03,560
افعل ما تشاء

109
00:07:04,090 --> 00:07:07,590
أنا مسرورٌ لأجلك، إن لم تسبّب
أي ضرر، فلن أخفيك

110
00:07:09,970 --> 00:07:11,650
ليس هُناك ما فعّلَها

111
00:07:11,980 --> 00:07:15,200
وُلِدَ ني-سان بقواه النفسيّة

112
00:07:15,770 --> 00:07:17,760
أذكرُ أنّني مُذ كنتُ صغيراً

113
00:07:17,760 --> 00:07:20,650
كان ني-سان يستعرضُ ظواهر
غريبة أمامي

114
00:07:21,620 --> 00:07:25,560
بالنسبة لي، ني-سان هو معيار هذا العالم

115
00:07:25,960 --> 00:07:27,220
معيار؟

116
00:07:27,820 --> 00:07:32,510
لكن مضَتْ فترة منذُ أن استعرض
ني-سان قواه أمام الآخرين

117
00:07:33,260 --> 00:07:35,040
ماذا حلَّ بأخي؟

118
00:07:36,090 --> 00:07:38,870
أحدثَ موب-كُن جلبة كبيرة

119
00:07:40,180 --> 00:07:42,270
ألا يُشبهك يا شيغيو؟

120
00:07:42,810 --> 00:07:43,730
لا

121
00:07:43,930 --> 00:07:47,570
رقم هذا الهاتف... هكذا إذاً

122
00:07:48,170 --> 00:07:51,740
يسعون للحصول على دعمٍ من شيغيو إذاً

123
00:07:52,880 --> 00:07:56,030
تبّاً، يسهلُ فهمهم كثيراً

124
00:07:56,960 --> 00:07:59,190
جاذبيّة موب-كُن الخفيّة

125
00:07:59,190 --> 00:08:02,290
تمكّنَتْ من نَيل إعجاب الكثير
من النّاس في آن واحد

126
00:08:02,670 --> 00:08:05,080
وبالتّالي تأسّسَ دينٌ جديد

127
00:08:05,600 --> 00:08:09,770
أظنُّه يستحقُّ تقديراً أكبر

128
00:08:09,770 --> 00:08:12,340
—لهذا فكّرتُ في إجراء لقاء حصري من وجهة نظر

129
00:08:12,340 --> 00:08:14,660
أنا مضطرٌّ للرفض يا ميزاتو-سينباي

130
00:08:15,150 --> 00:08:17,350
قوى ني-سان ليسَتْ مجرّد عرض جانبيّ

131
00:08:17,830 --> 00:08:20,190
...لا، هذا ليس ما قصدت

132
00:08:20,190 --> 00:08:22,010
حسناً، ربّما قصدت

133
00:08:22,010 --> 00:08:23,440
—لكنّه قريب جدّاً من نيل الشّهرة

134
00:08:23,440 --> 00:08:25,480
حسناً، سأذهبُ الآن

135
00:08:29,020 --> 00:08:30,610
كاغياما ريتسو-كُن

136
00:08:31,150 --> 00:08:33,310
،درجاته هي الأعلى في صفّه

137
00:08:33,310 --> 00:08:37,290
وهو شابٌ وسيمٌ يجيدُ لعب الرّياضة ومشهور بين الفتيات

138
00:08:37,870 --> 00:08:41,150
يمتلكُ كلّ ما لا يمتلكه موب-كُن

139
00:08:42,000 --> 00:08:43,230
...تبّاً

140
00:08:43,620 --> 00:08:48,430
...يُولَدُ النّاس بشكل غير متكافئ

141
00:08:51,950 --> 00:08:54,470
ني-سان كان معيار عالمي

142
00:08:55,190 --> 00:08:59,150
كانت القوى الروحانيّة شيئاً عاديّاً بالنسبة لي

143
00:08:59,600 --> 00:09:01,050
،لأنّني أخوه الصّغير

144
00:09:01,050 --> 00:09:04,510
ظننتُ أنّني سأكونُ قادراً على استخدامها
ذات يوم أيضاً

145
00:09:05,060 --> 00:09:06,590
...هذا ما رجوتُه

146
00:09:07,790 --> 00:09:09,610
ماذا تقصدين بالجاذبيّة

147
00:09:09,610 --> 00:09:12,720
والشّهرة؟ هوّني عليكِ

148
00:09:13,110 --> 00:09:16,870
!القوى الروحانيّة ليسَتْ رخيصة إلى هذا الحدّ

149
00:09:22,250 --> 00:09:23,920
سأغادرُ الآن

150
00:09:23,920 --> 00:09:26,610
ني-سان، سأذهبُ معك

151
00:09:26,610 --> 00:09:29,660
نادراً ما تفعل، عادةً ما تذهب باكراً

152
00:09:29,660 --> 00:09:32,540
لا يوجد اجتماع مجلِس طلبة في هذا الصّباح

153
00:09:32,540 --> 00:09:34,640
الأهمّ من هذا، أردتُ أن أتكلّم معك حول موضوع

154
00:09:36,060 --> 00:09:38,000
يبدو مُقرّباً جدّاً منك

155
00:09:39,280 --> 00:09:44,270
لِمَ لا تستخدم قواك الروحانيّة باستمرار أكثر، ني-سان؟

156
00:09:44,450 --> 00:09:46,140
لأنّني لا أملك الفُرصة لاستخدامها

157
00:09:46,140 --> 00:09:49,520
!وأنا أقولُ لك أنّ هُناك الكثير من الفُرص

158
00:09:50,010 --> 00:09:52,070
أظنُّك لا تتمتّع بأي رغبة لفعل ذلك، ني-سان

159
00:09:52,320 --> 00:09:56,190
بلى، لكن لا جدوى من استخدام قوايّ

160
00:09:57,380 --> 00:10:01,530
فالقوى الروحانيّة غير مطلوبة للبقاءِ أصلاً

161
00:10:01,530 --> 00:10:04,160
!أنتَ الشخصُ الوحيدُ الذي يعتقدُ ذلك

162
00:10:04,450 --> 00:10:07,920
المسألة ليست أنّها غير مطلوبة، بل أنتَ
لا تُدرِك مدى فائدتها

163
00:10:08,370 --> 00:10:11,790
هل هنالك أشياء لا تستطيعُ امتلاكها
حتّى وأنتَ قادر على استخدام قواك؟

164
00:10:11,790 --> 00:10:15,210
إطلاقاً! يمكنُك حتّى أن تصبح إلهاً

165
00:10:15,580 --> 00:10:16,670
العضلات

166
00:10:17,750 --> 00:10:19,500
عمّاذا يتكلّم؟

167
00:10:20,520 --> 00:10:24,760
أو القدرة على فهمِ الفتيات أو استقراء ما يحيطُ بي

168
00:10:24,760 --> 00:10:28,220
وأظنُّ أنّ هُناك ما هو أهمّ، كالمعرفة

169
00:10:28,940 --> 00:10:31,020
أحسدُك يا ريتسو

170
00:10:37,190 --> 00:10:39,420
توقّعت

171
00:10:39,420 --> 00:10:42,700
أعني أنّك لا تستطيعُ حلّ
مسألة رياضيات بقوى روحانيّة

172
00:10:44,970 --> 00:10:47,120
،لو كانت تِلك القوى تنتمي لشخصٍ آخر

173
00:10:47,130 --> 00:10:50,380
...لرأينا عالماً مختلِفاً تماماً

174
00:10:52,320 --> 00:10:54,940
ماذا أردتُم من نادي التّطوير الجسمانيّ؟

175
00:10:54,940 --> 00:10:58,630
هذا ليسَ مكاناً لأمثالكم

176
00:10:59,080 --> 00:11:02,590
،بخلافِكم يا من تهدرون أوقاتكم في الدُّنيا

177
00:11:02,590 --> 00:11:04,890
نحنُ نعيشُ حاضرنا يا أونيغاوارا

178
00:11:05,370 --> 00:11:07,060
ماذا عنهم؟

179
00:11:11,100 --> 00:11:13,170
إن كان لديك ما تقوله، فلنخرج

180
00:11:13,170 --> 00:11:15,110
!تجنّبتَ السّؤال

181
00:11:16,090 --> 00:11:20,010
سأبسّط الأمر، أنتُم أعضاء نادي التّطوير الجسمانيّ

182
00:11:20,010 --> 00:11:23,370
تتمتّعون بأقوى جسد في إعداديّة ملح

183
00:11:23,550 --> 00:11:27,910
أودُّ أن أطلب مُساعدتكم يا شباب لسحق
مدرسة خلّ أسود الإعداديّة

184
00:11:27,910 --> 00:11:31,860
مع الأسف، هذا شهرُ تعزيز الجزء السفليّ من الجسد

185
00:11:31,860 --> 00:11:33,630
لهذا نحنُ مشغولون بتمارين القرفصاء

186
00:11:34,170 --> 00:11:35,960
...قرفصاء؟! ما الذي

187
00:11:35,960 --> 00:11:38,010
!القِتال غباء

188
00:11:38,010 --> 00:11:42,220
عضلاتنا لم تُخلَق لشيء تافه كهذا

189
00:11:43,630 --> 00:11:46,210
!ماذا تقول؟

190
00:11:49,860 --> 00:11:51,390
!أنا ضدّ العنف

191
00:11:51,700 --> 00:11:54,020
...أ-أوقف يامازاكي بيدٍ واحدة

192
00:11:54,020 --> 00:11:57,820
سنتمكّنُ من الفوز مهما حدث
!برفقة هذه الوحوش ذات العضلات المفتولة

193
00:11:59,210 --> 00:12:00,320
ماذا؟

194
00:12:00,520 --> 00:12:03,090
...هنالك شخصٌ من الواضح أنّه لم يحسّن جسده

195
00:12:05,460 --> 00:12:09,240
شيغيو، أنتَ لا تطمح لهذا في الواقع، أليس كذلك؟

196
00:12:19,920 --> 00:12:22,260
فيما يلي، أخبار الطّقس لهذا اليوم

197
00:12:22,470 --> 00:12:25,210
،رُغم أنّ الشّمس مُشرِقة في مناطق كثيرة

198
00:12:25,210 --> 00:12:27,050
إلّا أنّ الجوّ مضطرّب بعض الشيء

199
00:12:27,550 --> 00:12:31,310
تاركاً احتمال هبوب عواصف رعديّة
ورياح شديدة قائماً

200
00:12:31,600 --> 00:12:35,880
إن أردتَ الخروج اليوم فيُنصَح بإخراج
...مظلّة قابلة للطيّ معك

201
00:12:33,380 --> 00:12:36,310
حارب السمّ بالسمّ

202
00:12:36,500 --> 00:12:39,350
سأرسلُ مخلوقات إعداديّة ملح العلويّة، نادي
التّطوير الجسمانيّ

203
00:12:39,350 --> 00:12:43,070
للاشتباكِ مع القائد السرِّي لمدرسة
خلّ أسود الإعداديّة، هانازاوا تيروكي

204
00:12:43,070 --> 00:12:46,590
لقد أخطأتَ في ذكر تِلك الحكمة

205
00:12:46,590 --> 00:12:49,150
...ونادي التّطوير الجسماني ليس سمّاً في الحقيقة

206
00:12:49,150 --> 00:12:51,750
وأليس الفارق البسيط في "العلويّة" غريباً بعض الشيء أيضاً؟

207
00:12:51,750 --> 00:12:53,940
أظنُّه أراد قول ذلك فحسب

208
00:12:53,940 --> 00:12:56,720
كلاهما ظهرا في الصفِّ مؤخّراً

209
00:12:56,720 --> 00:12:59,210
يبدو أنّ تينغا-سان يركّزُ جيّداً

210
00:12:59,380 --> 00:13:00,050
—مع أنّه غبيّ

211
00:13:05,040 --> 00:13:06,140
!ها-ها هي ذي

212
00:13:06,140 --> 00:13:09,540
،اندفاع الشّيطان! حركة تينغا-سان الخاصّة
اللّكمات المتكرِّرة

213
00:13:09,800 --> 00:13:12,350
إنّها حركةٌ أسطوريّةٌ نادراً ما تراها

214
00:13:12,490 --> 00:13:15,320
يُفترَضُ أن تكون نادرة، لكنّه يستخدمها هُنا على ما يبدو

215
00:13:16,350 --> 00:13:19,100
أنت مذهلٌ جدّاً يا تينغا-سان

216
00:13:27,880 --> 00:13:29,580
...هـ-هذا

217
00:13:31,190 --> 00:13:34,160
ما هذا؟ أعرقِلُك؟

218
00:13:34,380 --> 00:13:36,160
أتساءلُ ما إن كنتُ مكلّفاً بواجبِ تنظيف أو ما شابه

219
00:13:36,160 --> 00:13:38,050
أظنُّها يُفترَضُ أن تكون رسالة حبّ

220
00:13:38,050 --> 00:13:39,210
كتبتْ "حبّ" بشكل خاطئ

221
00:13:39,430 --> 00:13:41,680
!حبّ؟ ماذا؟

222
00:13:42,240 --> 00:13:44,130
من الواضح أنّها كذبة

223
00:13:45,910 --> 00:13:47,070
هذه كذبة؟

224
00:13:47,070 --> 00:13:50,930
هذا خطُّ يدِ شابّ، لِذا فهي رسالة
حبّ مزيّفة، كيفما نظرتَ إليها

225
00:13:51,310 --> 00:13:53,490
لم يسبق لك أن أصبحتَ مشهوراً على ما أعتقد
لهذا لن تُدرِك الأمر

226
00:13:53,930 --> 00:13:55,830
إذاً، هذه كذبة؟

227
00:13:55,830 --> 00:13:59,100
دعها يا شيغيو، دعها

228
00:13:59,330 --> 00:13:59,940
—إنّها كذبـ

229
00:14:01,230 --> 00:14:02,930
تلقّينا تحدّياً

230
00:14:03,260 --> 00:14:05,450
صاحب الخطّ السيّئ هذا لا بدّ أن يكون

231
00:14:05,450 --> 00:14:08,520
أونيغاوارا من إعداديّة ملح دون سِواه

232
00:14:08,520 --> 00:14:10,160
إنّه لا يستسلم، أليس كذلك؟

233
00:14:10,680 --> 00:14:12,910
ماذا تعني "أوغاد الأرزّ" هُنا بالضبط؟

234
00:14:13,120 --> 00:14:15,320
"أنا واثقٌ أنّه أرادَ كتابة "أيُّها المتسكِّعون

235
00:14:15,680 --> 00:14:17,710
أنتَ ذكيٌ جدّاً يا إيدانو-سان

236
00:14:17,710 --> 00:14:19,790
لا، إنّ أونيغاوارا هو الغبيّ فحسب

237
00:14:23,050 --> 00:14:26,970
خطّتي مثاليّة جدّاً لدرجة أنّني أخفتُ نفسي

238
00:14:27,750 --> 00:14:31,190
كلّ ما علينا فعله الآن هو أن نبدأ بتحرّكنا
حالما نعلمُ أنّهم تلقّوا الطّعم

239
00:14:32,470 --> 00:14:35,440
أنا واثقٌ أنّ جماعة مدرسة خلّ أسود
الإعداديّة سيكونوا هُنا

240
00:14:35,440 --> 00:14:38,320
لكن هل سيظهرُ الرّجلُ من نادي
التّطوير الجسمانيّ؟

241
00:14:38,320 --> 00:14:39,680
قد يظنُّه مقلباً

242
00:14:39,680 --> 00:14:42,060
لا، سيقعُ في الفخّ لا محال

243
00:14:42,400 --> 00:14:45,320
كتبتُ فيها "أنا فتاة" تحسُّباً لذلك فقط

244
00:14:46,230 --> 00:14:47,570
!وأضفتُ قلباً

245
00:14:48,110 --> 00:14:50,850
"لا يُمكن لفتاة أن تكتب "أنا فتاة

246
00:14:50,850 --> 00:14:53,790
صدّقني، لن يقع أحدٌ ضحيّة لهذه الخدعة

247
00:14:54,580 --> 00:14:56,270
لكنّه وقع

248
00:14:56,270 --> 00:14:58,190
...أنتَ غير معقول

249
00:14:58,190 --> 00:15:01,880
حسناً، أخشى أن تكون فتاة فعلاً
فأجعلها تنتظر

250
00:15:01,880 --> 00:15:04,170
!قلتُ لك أنّ هذه أوهام

251
00:15:04,620 --> 00:15:06,150
هل أنتَ متأكّدٌ من هذا؟

252
00:15:06,150 --> 00:15:08,440
لم تُبلِغ حتّى نادي التّطوير الجسمانيّ بهذا

253
00:15:08,440 --> 00:15:10,420
يُفترَضُ أن نتدرّب بمفردنا اليوم

254
00:15:11,000 --> 00:15:12,180
أنت

255
00:15:12,370 --> 00:15:14,450
أنتَ من مدرسة ملح الإعداديّة، أليس كذلك؟

256
00:15:19,250 --> 00:15:21,140
!القائد موساشي، ثمّة مُشكلة

257
00:15:21,860 --> 00:15:23,520
وجدتُ هذه تحت إحدى الأثقال

258
00:15:24,220 --> 00:15:26,030
!لقد اختُطِفَ كاغياما-كُن

259
00:15:30,560 --> 00:15:32,290
!سنذهبُ إلى مدرسة خلّ أسود الإعداديّة

260
00:15:32,290 --> 00:15:34,360
!سنُعيدُ كاغياما

261
00:15:35,070 --> 00:15:37,540
ماذا تريدُ أن تفعل اليوم؟

262
00:15:37,770 --> 00:15:39,190
ماذا تريدين أنتِ أن تفعلي؟

263
00:15:39,190 --> 00:15:42,260
...أوّلاً، أن أذهب إلى مقهى

264
00:15:47,460 --> 00:15:50,130
شيغيو، هل تعرف هؤلاء؟

265
00:15:50,130 --> 00:15:51,550
لا، إطلاقاً

266
00:15:51,550 --> 00:15:53,810
هل تعي ما يجري؟

267
00:15:54,160 --> 00:15:55,760
لا، إطلاقاً

268
00:15:56,010 --> 00:15:59,270
أنتَ لا تتخلّص من استكانتِك هذه، أليس كذلك؟

269
00:15:59,460 --> 00:16:03,510
إنّه هادئ جدّاً رُغم أنّه الشّخص
الذي طلبَ أونيغاوارا مُساعدته

270
00:16:03,510 --> 00:16:05,070
كاغياما، صحيح؟

271
00:16:05,070 --> 00:16:08,670
آسف، لكن نحنُ مُضطرُّون للحفاظِ على سمعتِنا

272
00:16:08,670 --> 00:16:11,280
لهذا سنأخذك كرهينة

273
00:16:11,280 --> 00:16:12,930
...هكذا إذاً

274
00:16:12,930 --> 00:16:16,530
يبدو أنّك خُدِعتَ بواسطة المُسمّى
أونيغاوارا يا شيغيو

275
00:16:16,530 --> 00:16:19,110
لقد أخبرنا أونيغاوارا

276
00:16:19,800 --> 00:16:23,420
أنّه إذا أراد عودة صديقه، عليه أن يأتي ويأخذك

277
00:16:23,720 --> 00:16:26,880
مع أنّك هالك في كلتا الحالتَين

278
00:16:27,900 --> 00:16:28,800
شيغيو

279
00:16:29,180 --> 00:16:33,810
العصابات والسياسيّون لا يستطيعون النّجاة
دون الحِفاظ على صورتِهم

280
00:16:33,810 --> 00:16:37,050
احرص على الجاهزيّةِ لتحرير قِواك في أي وقت

281
00:16:37,750 --> 00:16:40,680
لا يُفترَض استخدام القوى الروحانيّة
ضدّ النّاس الآخرين

282
00:16:40,810 --> 00:16:45,440
تبّاً! يتقبّلُ كلّ شيء دوماً، لكنّه يكونُ
صامِد عنيد عندما يتعلّقُ الأمرُ بذلك

283
00:16:45,440 --> 00:16:48,050
!استخدم قِواك اللّعينة في وقتٍ كهذا فحسب

284
00:16:50,050 --> 00:16:52,440
!جاء فتيان مدرسة ملح الإعداديّة إلى هُنا للقتال

285
00:16:52,990 --> 00:16:55,450
حان الوقتُ يا أونيغاوارا

286
00:16:55,990 --> 00:16:59,450
لا ينبغي أن يكونوا قد تعافوا من جراحهم بعد

287
00:16:59,720 --> 00:17:02,050
!لنقضِ عليهم

288
00:17:02,050 --> 00:17:03,780
في الواقع، هنالك خطأ

289
00:17:03,780 --> 00:17:05,300
،ليسَ أونيغاوارا

290
00:17:05,300 --> 00:17:09,130
إنّهم شباب ذوو أكمام قصيرة
وسراويل لم أر مثيلاً لهم من قبل

291
00:17:09,130 --> 00:17:10,380
...بالإضافةِ إلى أنّهم

292
00:17:11,740 --> 00:17:13,380
!أقوياء للغاية

293
00:17:14,390 --> 00:17:16,760
من هؤلاء بالضبط؟

294
00:17:21,250 --> 00:17:23,060
مـ-من أنت؟

295
00:17:23,880 --> 00:17:28,600
أنا قائدُ نادي التّطوير الجسمانيّ
في مدرسة ملح الإعداديّة، غودا موساشي

296
00:17:29,150 --> 00:17:30,860
أخرِجوا كاغياما إلى هنا

297
00:17:31,390 --> 00:17:32,980
كاغياما...؟

298
00:17:32,980 --> 00:17:33,780
من هو هذا؟

299
00:17:33,780 --> 00:17:38,160
القائد موساشي؟ ماذا تفعلون هُنا؟

300
00:17:38,530 --> 00:17:40,390
!إنّه هو؟

301
00:17:39,100 --> 00:17:41,660
جئتُ إلى هُنا للقيام بشيء

302
00:17:41,660 --> 00:17:43,920
...هذا الفتى ليس مُعيناً لنا

303
00:17:42,430 --> 00:17:44,290
أعدُك أنّني لن أتكاسل

304
00:17:43,920 --> 00:17:45,660
!إنّما كان لغماً

305
00:17:45,660 --> 00:17:49,380
!اللّعنة! خدعَنا أونيغاوارا

306
00:17:50,140 --> 00:17:51,990
يبدو أنّك سليم

307
00:17:51,990 --> 00:17:53,760
حسناً، لنذهب يا كاغياما-كُن

308
00:17:53,760 --> 00:17:54,560
حسناً

309
00:17:54,560 --> 00:17:56,700
علينا أن نعود ونمارس التّمارين الرياضيّة

310
00:17:58,680 --> 00:18:01,200
!كفاكم هُراء

311
00:18:01,200 --> 00:18:04,040
!مُحال أن نسمح لكم بالمُغادرة

312
00:18:04,040 --> 00:18:06,520
!ستتلطّخ أجسامكم بالدّماء

313
00:18:06,720 --> 00:18:08,290
!عليهم يا فتيان

314
00:18:34,090 --> 00:18:36,690
...أسرع... وأحضر تيرو-سان

315
00:18:36,690 --> 00:18:38,330
اتّصلتُ به منذُ فترة طويلة

316
00:18:38,330 --> 00:18:40,310
...لكنّه تأخّر

317
00:18:40,310 --> 00:18:43,390
أيُغازلُ ذلك الحقير فتاةً ما مجدّداً؟

318
00:18:46,050 --> 00:18:48,020
هل ضلَّتْ بعض حيوانات الغوريلّا عن طريقها؟

319
00:18:48,800 --> 00:18:50,310
يبدو أنّكم بحاجة لِمَن يضبطكم

320
00:18:50,310 --> 00:18:51,360
!تيرو-سان

321
00:18:52,510 --> 00:18:55,070
هل أنتُم مُدرِكون لمُصطلَح "عنف مُنظَّم"؟

322
00:18:55,750 --> 00:18:58,100
قطع القُمامة الملقيّة أرضاً هُنا

323
00:18:58,100 --> 00:19:01,820
هي رموزُ سلطتي ضمن حياتي المدرسيّة

324
00:19:02,380 --> 00:19:04,340
،والآن بعدما حطّمتموها

325
00:19:04,340 --> 00:19:07,810
.كأنّكم رميتُم وحلاً على وجهي

326
00:19:08,480 --> 00:19:10,450
وهل أنتَ جانحٌ أيضاً؟

327
00:19:11,580 --> 00:19:15,350
إنّه قائدُنا السرّي، هانازاوا تيروكي-سان

328
00:19:15,350 --> 00:19:18,840
تيرو-سان، يعتقدُ هؤلاء النّاس أنّهم أقوياء
لِذا أرجو أن تلقنّهم درساً

329
00:19:19,340 --> 00:19:22,830
إيدانو، اعتباراً من اليوم، عليك
أن تتنحّى عن القيادة

330
00:19:22,830 --> 00:19:24,350
فأنتَ ضعيفٌ للغاية

331
00:19:24,350 --> 00:19:26,350
...انتظر أرجوك

332
00:19:30,220 --> 00:19:32,230
كرامتي على المحكّ

333
00:19:32,850 --> 00:19:35,400
يبدو أنّه تحرّكَ بلمحِ البصر للتو

334
00:19:35,400 --> 00:19:37,370
أظنُّك تتوهّم فحسب

335
00:19:37,370 --> 00:19:39,460
لقد حصَلْنا على ما أتينا لأجله

336
00:19:39,460 --> 00:19:41,200
سننصرفُ الآن

337
00:19:41,200 --> 00:19:46,120
أنا من يقرِّر فيما إن كان عليكم
الانصراف أم لا

338
00:19:47,180 --> 00:19:48,940
...حسناً

339
00:19:48,940 --> 00:19:52,120
لا أشعرُ أنّه من الصّواب مُواجهة
...شخص بهذا الجسد الهزيل، لكن

340
00:19:53,580 --> 00:19:56,380
...دائماً ما يستخفُّ المُجتمعُ بي

341
00:19:56,920 --> 00:20:00,180
...الحمقى الّذين لا يُحاولون رؤية إلّا ما هو ظاهر

342
00:20:00,840 --> 00:20:02,970
لهذا يسهلُ التحكُّم بكم كثيراً

343
00:20:03,260 --> 00:20:05,840
،ليسَ النّجم من يكون تحت الأضواء

344
00:20:05,840 --> 00:20:08,390
الشّخص الذي يضعُ نفسه
تحت الأضواء هو من يُصبِح نجماً

345
00:20:08,750 --> 00:20:11,210
،إن كنتَ تتمتّعُ بنورِك الخاصّ

346
00:20:11,210 --> 00:20:13,920
تتجمّع الحشرات ذوات نسبة الذّكاء
المنخفِضة دوماً معاً

347
00:20:15,150 --> 00:20:16,270
عمّاذا تتكلّم؟

348
00:20:16,430 --> 00:20:20,030
أيّها الحشرة الضارّة، كفّ عن الاختباء واخرج

349
00:20:22,050 --> 00:20:23,030
!أونيغاوارا

350
00:20:23,940 --> 00:20:25,280
هذا أنت إذاً

351
00:20:25,540 --> 00:20:27,280
!اسحقوه بسُرعة

352
00:20:33,620 --> 00:20:36,210
!اللّعنة! خذ هذه

353
00:20:42,470 --> 00:20:43,300
...إنّها ثقيلة

354
00:20:43,870 --> 00:20:46,850
!إنّها صفعة لكنّها ثقيلة جدّاً

355
00:20:46,850 --> 00:20:49,460
إنّه ضئيل لكنّه يلوّحُ كتلويحةِ الدبّ

356
00:20:50,300 --> 00:20:53,440
!هل أنتَ بشريّ حتّى؟ أنتَ وحش

357
00:20:54,530 --> 00:20:56,180
أدهشتَني حقّاً

358
00:20:58,130 --> 00:21:01,150
تمكّنتَ من قذفِنا بعيداً بالرُّغم
من فارقِ الوزن

359
00:21:01,490 --> 00:21:04,410
لا بدّ وأنّك تمتلكُ عضلاتٍ مُمتازة فريدة

360
00:21:04,410 --> 00:21:05,770
عضلات؟

361
00:21:21,130 --> 00:21:22,760
!أيُّها الحقير

362
00:21:23,580 --> 00:21:25,020
!سترى الجحيم

363
00:21:25,020 --> 00:21:27,180
!اندفاع الشّيطان

364
00:21:27,180 --> 00:21:28,260
!ماذا؟

365
00:21:28,260 --> 00:21:30,350
!لكماتي لا تُؤلمه البتّة

366
00:21:30,690 --> 00:21:34,940
عضلات وتقنيّات قتاليّة... لهذا النّاس
العاديّون مُثيرون للشفقة

367
00:21:35,840 --> 00:21:37,740
سأريك شيئاً

368
00:21:39,820 --> 00:21:41,320
!كان ذلك وشيكاً

369
00:21:47,480 --> 00:21:49,310
القائد؟

370
00:21:54,460 --> 00:21:57,040
يبدو أنّ أحدكم قويّ جدّاً في نهاية المطاف

371
00:21:59,920 --> 00:22:01,340
ما خطبُ هذا الفتى؟

372
00:22:01,340 --> 00:22:04,410
حضوره خفيف جدّاً، لِذا لم أنتبه له حتّى

373
00:22:04,410 --> 00:22:06,190
أو بالأحرى، لماذا هو مُقيَّد؟

374
00:22:07,040 --> 00:22:08,720
لا ينبغي أن تستخدم ذلك على النّاس

375
00:22:09,610 --> 00:22:11,020
عمّاذا تتكلَّم؟

376
00:22:11,520 --> 00:22:13,600
...أتكلّمُ عن قواك الروحانيّة

377
00:22:14,650 --> 00:22:16,600
التي كنتَ تضربُهم بها

378
00:22:18,740 --> 00:22:20,800
...ناهيك عن استخدامِها للقتال

379
00:23:56,570 --> 00:23:58,640
تيرو، المُدرِك فوق الحسّي الوسيم الذي يُهاجمُ موب

380
00:23:58,640 --> 00:24:01,900
عندما يفرُّ النّاس أثناء احتدام
القوى الروحانيّة وتطايُر السّكاكين في أرجاء ساحة المعركة العاصِفة

381
00:24:01,900 --> 00:24:04,870
!تظهرُ شخصيّة غامضةٌ وتحدثُ مُعجزة

382
00:24:04,870 --> 00:24:06,680
:الحلقة القادمة من موب سايكو 100

383
00:24:06,680 --> 00:24:08,460
"~أوتشيموشا ~قوى روحانيّة وأنا"

384
00:24:08,460 --> 00:24:10,970
بلوراي؟ قرار مُمتاز آخر