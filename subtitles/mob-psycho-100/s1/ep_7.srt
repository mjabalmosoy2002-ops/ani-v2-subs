1
00:00:03,600 --> 00:00:04,680
ما هذا؟

2
00:00:06,640 --> 00:00:11,400
،وبينما كان ريتسو يظنُّ إيكوبو بالوناً مُريب الشّكل

3
00:00:12,380 --> 00:00:15,980
الإشاعات المُحيطة بموب وهزيمته

4
00:00:15,980 --> 00:00:18,020
لقائد مدرسة خلّ أسود الإعداديّة الظلّي، هانازاوا

5
00:00:18,020 --> 00:00:20,540
بدأت تنتشر على أنّها حقيقة واقِعة

6
00:00:20,540 --> 00:00:22,680
...سمّ تي الأبيض

7
00:00:22,680 --> 00:00:27,250
كان هذا اللّقب الذي مُنِحَ لموب
والذي لم تنكشف هويّته بعد

8
00:00:29,420 --> 00:00:31,050
...سمّ تي الأبيض

9
00:00:31,910 --> 00:00:34,050
!سأكون أنا من يهزمه

10
00:00:36,360 --> 00:00:39,680
سأهزمه وأجعله يعترف أنّني الأفضل

11
00:00:40,450 --> 00:00:42,730
...إذاً الهدف التّالي هو مدرسة ملح الإعداديّة

12
00:00:43,580 --> 00:00:45,940
سمّ تي الأبيض هو فريستي

13
00:00:46,590 --> 00:00:48,400
هذه فُرصتي لأتألّق

14
00:00:48,720 --> 00:00:57,290
وهكذا، المعركة الشّرِسة لمُقاتلة سمّ
تي الأبيض على وشك أن تبدأ

15
00:02:32,750 --> 00:02:34,750
شكراً على مُساعدتي يا رجل

16
00:02:35,010 --> 00:02:39,430
،تمكّنتُ من العودة من المُستوى الجُزيئي بقوّتي

17
00:02:40,040 --> 00:02:43,260
،لكن طاقتي الروحيّة أقلّ بكثير ممّا كانت عليه

18
00:02:43,260 --> 00:02:45,640
لهذا لم أعُد أستطع دخول البيت حينها

19
00:02:45,940 --> 00:02:48,000
يبدو أنّ الأرواح ذات المُستوى المنخفض

20
00:02:48,000 --> 00:02:51,650
لا تستطيع حتّى الاقتراب من هذا المكان
نظراً لإقامة شيغيو هنا

21
00:02:52,770 --> 00:02:53,900
...ما هذا

22
00:02:54,150 --> 00:02:57,190
الشّكل الهُلامي القبيح الذي يتكلّم؟

23
00:02:58,420 --> 00:03:00,640
...لكن أوّل شيء عليّ فعله هنا هو

24
00:03:02,630 --> 00:03:03,660
ماذا؟ أتريدُ مُصافحتي؟

25
00:03:03,900 --> 00:03:05,080
عليّ طرده

26
00:03:05,650 --> 00:03:06,660
!انتظر

27
00:03:07,010 --> 00:03:10,660
!كفَّ عن ضرب وجهي بركبتك! أنا صديقُ شيغيو

28
00:03:10,850 --> 00:03:11,440
صديق ني-سان؟

29
00:03:11,440 --> 00:03:13,460
!يمكنُك حتّى أن تعتبرني مُستشاره

30
00:03:13,460 --> 00:03:15,170
حسناً، سأتجاهل ما فعلتَه هذه المرّة

31
00:03:15,170 --> 00:03:18,170
...لأنّه من الواضح أنّك مرتعد، والأهمّ من هذا

32
00:03:18,560 --> 00:03:20,170
ما رأيك يا ريتسو-تشان؟

33
00:03:20,350 --> 00:03:22,040
أتريدُ أن تشكّل ثنائياً معي؟

34
00:03:22,040 --> 00:03:22,820
لا

35
00:03:22,820 --> 00:03:25,800
إجابتك سريعة، انتظر لحظة، أصغِ إليّ

36
00:03:26,360 --> 00:03:29,180
أيقظتَ للتو قواك الروحانيّة، أليس كذلك؟

37
00:03:30,030 --> 00:03:32,690
ماذا؟ لديّ قوى روحانيّة؟

38
00:03:33,120 --> 00:03:36,070
حقيقة قدرتك على رؤيتي هي دليلٌ على ذلك

39
00:03:36,860 --> 00:03:39,800
اسمي إيكوبو، وأنا ما يُطلِقون عليه شبحاً من النّاحية الجوهريّة

40
00:03:39,800 --> 00:03:43,650
هل بلغَتْ قوايّ الروحانيّة إذاً المُستوى الذي أستطيعُ
رُؤيتك به فقط؟

41
00:03:43,650 --> 00:03:47,360
أرى أنّك لم تُدرِك قِواك ناهيك عن قدرتِك على استخدامها

42
00:03:48,410 --> 00:03:52,230
تابِع، ينبغي أن تكون قادراً على فعل ذلك الآن

43
00:03:52,990 --> 00:03:54,520
لا ينبغي أن أتفاءل كثيراً

44
00:03:58,370 --> 00:03:59,000
ما الأمر؟

45
00:03:59,890 --> 00:04:03,010
...إنّه عالم بعيد عن منالي

46
00:04:04,260 --> 00:04:08,070
ما خطبه؟ هل يُواجه عقدة أو ما شابه؟

47
00:04:08,070 --> 00:04:10,600
حسناً، لا ألومه نظراً لهويّة أخيه الأكبر

48
00:04:11,100 --> 00:04:15,240
...إنّها

49
00:04:16,350 --> 00:04:17,860
!لا تنثني

50
00:04:19,210 --> 00:04:22,990
!إ-إيكوبو! إنّها لا تنثني

51
00:04:22,990 --> 00:04:24,590
اهدأ

52
00:04:25,840 --> 00:04:26,990
...هذا

53
00:04:27,400 --> 00:04:28,850
أنا فعلتُ هذا؟

54
00:04:31,330 --> 00:04:33,250
انضمّ إليّ يا ريتشان

55
00:04:33,710 --> 00:04:36,130
إذا أردت أن تتفوّق على أخيك

56
00:04:38,330 --> 00:04:40,670
أتفوّق على ني-سان؟

57
00:04:41,660 --> 00:04:44,130
هل هذا مُمكن؟

58
00:04:45,770 --> 00:04:49,390
أستطيعُ أن أكون مثل أخي؟

59
00:04:50,120 --> 00:04:52,780
.إن تركتَني أستخدم جسدك

60
00:04:54,200 --> 00:04:54,810
ماذا؟

61
00:04:55,010 --> 00:04:56,450
ريتسو لا يأكل؟

62
00:04:56,450 --> 00:04:58,310
يبدو أنّه لا يشتهي

63
00:04:58,510 --> 00:05:00,730
ما خطبه يا تُرى؟

64
00:05:01,300 --> 00:05:03,050
هل ريتسو مكتئب؟

65
00:05:03,050 --> 00:05:03,820
...لا

66
00:05:04,150 --> 00:05:06,450
يبدو سعيداً على نحو غريب

67
00:05:07,800 --> 00:05:11,080
كيف أصل للمرحلة التي أستطيعُ فيها
استخدام قوايّ بحرّية؟

68
00:05:11,320 --> 00:05:14,540
من الأفضل تجربتها فعليّاً عِوضاً عن الشّرح يا ريتشان

69
00:05:14,540 --> 00:05:15,610
لا تُنادِني بهذا الاسم

70
00:05:15,610 --> 00:05:18,210
حسناً، سأناديك ريتسو فحسب إذاً

71
00:05:18,450 --> 00:05:21,460
أغمِض عينيك ودع جسدك يسترخي بالكامل

72
00:05:24,970 --> 00:05:30,580
!استحواذ! أيّها الأحمق! أصبح جسدك ملكي الآن

73
00:05:33,750 --> 00:05:34,480
!ماذا؟

74
00:05:34,480 --> 00:05:36,480
!لا أستطيع التحكُّم بجسده

75
00:05:37,900 --> 00:05:40,580
إلى أين أنت ذاهب يا إيكوبو؟

76
00:05:40,580 --> 00:05:44,860
هذا لأنّ قوايّ الروحيّة أصبحت ضعيفة جدّاً... اللّعنة

77
00:05:49,770 --> 00:05:52,580
سمعتُ أنّ مجلس الطلبة قد حلّ المُشكلة

78
00:05:52,580 --> 00:05:54,460
أتعني مُشكلة قائد عصابة المُنحرفين؟

79
00:05:54,460 --> 00:05:55,840
إنّهم كما الأبطال

80
00:05:55,840 --> 00:05:57,620
إنّهم أبطال المدرسة

81
00:05:58,850 --> 00:06:01,400
يامازاكي-كُن من الصفّ 4-2

82
00:06:01,400 --> 00:06:02,910
أودُّ أن أتكلّم معك

83
00:06:03,480 --> 00:06:04,760
ماذا تُريد؟

84
00:06:04,760 --> 00:06:06,690
لديك زرٌّ مفقود

85
00:06:06,690 --> 00:06:08,810
وماذا يعني؟ اغرب عن وجهي

86
00:06:10,040 --> 00:06:11,180
...أستطيعُ استخدامها

87
00:06:11,920 --> 00:06:14,310
أستطيعُ استخدام قوى روحانيّة يا إيكوبو

88
00:06:18,000 --> 00:06:22,420
لكنّك تمتلِك الإمكانيّة لاستخدام القوى الروحانيّة يا ريتسو

89
00:06:22,420 --> 00:06:24,600
وأستنتج أنّ سبب

90
00:06:24,600 --> 00:06:28,070
ظهورها الآن هو عواطفك

91
00:06:29,140 --> 00:06:32,640
هل من شيء يُوتّرك كثيراً مؤخّراً؟

92
00:06:32,640 --> 00:06:35,200
،كالتبوُّل على سروالك أمام كثير من النّاس

93
00:06:35,200 --> 00:06:37,330
أو هل قُبِضَ عليك وأنت تسترق النّظر
إلى غرف تغيير ملابس الفتيات؟

94
00:06:38,030 --> 00:06:40,600
بالطبع لا، هل تسخر منّي؟

95
00:06:40,600 --> 00:06:43,970
أنا أمزح فحسب، أنت جادّ كثيراً يا ريتسو

96
00:06:44,960 --> 00:06:47,960
هذا صحيح، فأنتَ تلميذ صادق

97
00:06:48,420 --> 00:06:50,880
ماذا إذاً؟ هل فعلتَ شيئاً سيّئاً؟

98
00:06:51,940 --> 00:06:55,430
سمعتُ إشاعات أنّك كنتَ تسرقُ ملابس
الفتيات الرياضيّة

99
00:06:56,320 --> 00:06:57,690
عمّاذا تتكلّم؟

100
00:06:57,690 --> 00:07:00,530
...وبالتالي أجرى مجلس الطّلبة تحقيقاً بسيطاً

101
00:07:00,530 --> 00:07:02,190
على ماذا عثرنا يا كاغياما-كُن؟

102
00:07:02,400 --> 00:07:06,150
عثرنا على بعض من ملابس الفتيات الرياضيّة
في حقيبتِك يا يامازاكي-سينباي

103
00:07:06,380 --> 00:07:08,540
!ماذا؟

104
00:07:08,540 --> 00:07:09,940
!كفَّا عن الكذب

105
00:07:09,940 --> 00:07:14,200
يمكنُك أن تحاول القول أنّك لم تفعل ذلك
لكن سيكون إثباتك لذلك صعباً

106
00:07:14,200 --> 00:07:17,700
المدرسة صارمة جدّاً في التّعامل
مع المُنحرفين مؤخّراً

107
00:07:19,060 --> 00:07:21,720
سأمنحُك مخرجاً واحداً من هذا

108
00:07:22,500 --> 00:07:25,840
طلب منك أونيغاوارا فعل هذا، أليس كذلك؟

109
00:07:26,550 --> 00:07:29,600
إن اعترفتَ بذلك فأنتَ مجرّد ضحيّة أخرى

110
00:07:30,840 --> 00:07:33,040
زرُّك مفقود

111
00:07:34,360 --> 00:07:37,100
،تطهّرَت المدرسة بأكملها

112
00:07:37,310 --> 00:07:41,100
وتحوّلَتْ إلى بيئة مثاليّة للدراسة

113
00:07:41,620 --> 00:07:45,760
لكن بسببِ الاستراتيجيّة غير الأخلاقيّة بتاتاً

114
00:07:45,760 --> 00:07:48,520
،والتي استُخدِمَتْ على أولئك الطلّاب

115
00:07:48,520 --> 00:07:52,110
.خُلِّفَتْ ندبة سوداء عميقة في تاريخهم

116
00:07:52,690 --> 00:07:57,750
والشّخصان اللّذان تسبّبا بهذا عليهما
...أن يتحمّلا هذا العبء

117
00:07:57,750 --> 00:07:58,620
،لذلك

118
00:07:58,620 --> 00:08:00,390
إمّا أن يكونا قد أصبحا مُنتشيين بالقوّة وشعرا

119
00:08:00,390 --> 00:08:02,370
...بإحساس الإنجاز الوهمي، أو

120
00:08:02,370 --> 00:08:04,970
.عانيا كثيراً

121
00:08:06,650 --> 00:08:07,670
!رائع

122
00:08:07,670 --> 00:08:10,810
!ازدادت قوّتك أكثر فأكثر يا ريتسو

123
00:08:10,810 --> 00:08:12,800
...فساد وشعور بالذنب

124
00:08:13,220 --> 00:08:16,480
ذلكما الشّيئان أصبحا وقوداً لقوايّ

125
00:08:16,800 --> 00:08:19,090
!أيّاً يكُن، المهمّ أنّه ينجح

126
00:08:19,090 --> 00:08:20,810
هنالك شيء ما يأكلك من الدّاخل؟

127
00:08:21,780 --> 00:08:24,560
إيكوبو، أنتَ لا تكفّ عن الكلام

128
00:08:25,420 --> 00:08:28,820
،إذا استطعتُ التحكُّم بقوايّ من تلقاء نفسي

129
00:08:29,570 --> 00:08:31,440
فهل سأستطيع إخفائك؟

130
00:08:32,140 --> 00:08:34,490
هل تتغيّر شخصيّته أيضاً؟

131
00:08:39,830 --> 00:08:41,970
مـ-معقول؟

132
00:08:41,970 --> 00:08:42,790
...مذهل

133
00:08:43,110 --> 00:08:45,180
!هذا مذهل يا كاغياما-كُن

134
00:08:45,180 --> 00:08:46,790
هل تريدني أن أستمرّ؟

135
00:08:46,790 --> 00:08:49,760
هل تريدُني أن أثني سيّارتك يا ميتسورا-سان؟

136
00:08:49,760 --> 00:08:50,550
!ماذا؟

137
00:08:51,540 --> 00:08:54,050
ماذا حدث بالضبط؟

138
00:08:59,420 --> 00:09:02,300
هل يمكنُني مُساعدتكم يا سادة؟

139
00:09:02,300 --> 00:09:06,560
وفقاً لكامورو، لقد جعلَك ترمي الدّليل كلّه علينا

140
00:09:06,810 --> 00:09:08,940
هل أنتَ من ألبسنا التّهمة؟

141
00:09:09,180 --> 00:09:11,910
...لا أدري عمّاذا تتكلّم

142
00:09:11,910 --> 00:09:12,620
إيكوبو

143
00:09:12,620 --> 00:09:13,580
اترك الأمر لي

144
00:09:13,580 --> 00:09:15,070
،حتّى لو فعلت

145
00:09:16,950 --> 00:09:17,990
.الأوان قد فات

146
00:09:18,770 --> 00:09:19,660
...أيُّها

147
00:09:20,030 --> 00:09:22,450
!ماذا تظنُّنا بالضبط؟

148
00:09:30,130 --> 00:09:31,590
!أيّها الخسيس

149
00:09:31,980 --> 00:09:33,260
!هذا يكفي! اقضوا عليه

150
00:09:41,200 --> 00:09:42,120
وقعَ شِجار

151
00:09:42,120 --> 00:09:43,460
!مخيف

152
00:09:43,460 --> 00:09:46,230
لكن أليس شعر ذلك الشابّ أكثر رَوعة؟

153
00:09:46,230 --> 00:09:47,030
!معكِ حقّ

154
00:09:47,030 --> 00:09:47,850
حقّاً؟

155
00:09:49,860 --> 00:09:51,460
أنت

156
00:09:53,570 --> 00:09:54,530
نعم؟

157
00:09:54,530 --> 00:09:55,990
...هذا

158
00:09:56,270 --> 00:09:57,860
هذا يكفي على ما أعتقد

159
00:10:00,110 --> 00:10:02,620
إذا اعتمدتَ على ذلك أكثر فسوف تتأذّى

160
00:10:02,620 --> 00:10:04,290
ما هذا؟

161
00:10:02,850 --> 00:10:05,120
لقد أسأتَ الفهم

162
00:10:04,290 --> 00:10:05,120
إنّه طويل جدّاً

163
00:10:05,120 --> 00:10:08,290
تظنُّ نفسك شخصاً مميّزاً حقّاً

164
00:10:08,290 --> 00:10:11,130
من الصّعب أن أنظر إلى شخص يذكّرني بنفسي سابقاً

165
00:10:11,850 --> 00:10:13,630
هذا تحذير

166
00:10:13,900 --> 00:10:16,630
لا تحاول أن تعيش اعتماداً على قوى روحانيّة

167
00:10:18,140 --> 00:10:20,370
هل أنت مُدرِك فوق حسّي؟

168
00:10:20,370 --> 00:10:22,040
،لا أعرف من تكون

169
00:10:22,850 --> 00:10:25,270
لكن لستُ بحاجة لأتلقّى تحذيرات منك

170
00:10:25,710 --> 00:10:27,140
!لا تُحاول أن تستفزّه

171
00:10:27,140 --> 00:10:29,120
!إنّه ليس شخصاً يمكنُك هزيمته

172
00:10:29,120 --> 00:10:32,270
أنا واثقٌ أنّه ليس مختلفاً كثيراً
عن الأشخاص المتواجدين في مُختبر الصّحوة

173
00:10:32,420 --> 00:10:34,780
أريدُ مُقارنة قوايّ بقِواه

174
00:10:35,150 --> 00:10:37,400
!ريتسو؟! أيّها الغبيّ! توقّف

175
00:10:39,250 --> 00:10:41,470
شكراً لك على المُصافحة

176
00:10:41,470 --> 00:10:43,830
اسمي هانازاوا تيروكي، سُرِرتُ بلقائك

177
00:10:45,190 --> 00:10:47,370
!لا تُحاول مُقاتلته يا ريتسو! أفلِت يده

178
00:10:47,370 --> 00:10:49,340
أتواجه مُشكلة من الوقوف على قدميك؟

179
00:10:49,340 --> 00:10:51,000
أنت يافع جدّاً

180
00:10:58,220 --> 00:11:00,220
!اهرب حالاً

181
00:11:04,680 --> 00:11:06,680
...تفاجأتُ من حجم قوّته

182
00:11:06,680 --> 00:11:07,850
...و

183
00:11:08,040 --> 00:11:10,490
كان دِماغه ناميّاً جدّاً

184
00:11:10,490 --> 00:11:12,450
أهذا هو سبب قوّته الكبيرة؟

185
00:11:12,450 --> 00:11:15,310
لا... السّبب هو لأنّ باروكته لم تُلائمه جيّداً

186
00:11:15,310 --> 00:11:17,230
مع أنّني لا أدري لماذا يرتديها

187
00:11:17,810 --> 00:11:21,640
أنا مُحبَطٌ للغاية، لا أصدِّق أنّني خسرتُ
أمام شخص غير ني-سان

188
00:11:22,570 --> 00:11:23,480
إيكوبو

189
00:11:24,450 --> 00:11:26,790
أريدُ أن أصبح أقوى

190
00:11:26,790 --> 00:11:29,580
لدرجة لا أخسر فيها أمام أحد

191
00:11:31,420 --> 00:11:32,550
أيّها الصغير

192
00:11:33,590 --> 00:11:35,250
هلّي بلحظة؟

193
00:11:45,420 --> 00:11:48,090
هذه مزهريّة السّعادة

194
00:11:48,090 --> 00:11:50,260
فاخوريّ مشهور جدّاً كرّسَ قلبه وروحه

195
00:11:50,260 --> 00:11:52,340
في صناعتِها وهي مزهريّة قيّمة للغاية

196
00:11:52,340 --> 00:11:55,980
سينالُ مالكُها بركة بمُجرَّد وضعها في منزله

197
00:11:56,390 --> 00:11:58,540
،قيمتها حوالي 2.5 مليون ين تقريباً

198
00:11:58,540 --> 00:12:01,650
لكن سأبيعُها لك بـ800.000 ين فقط

199
00:12:01,990 --> 00:12:03,440
لا أملك هذا المال

200
00:12:03,440 --> 00:12:05,720
سأخفّض السّعر إلى 500،000 ين إذاً

201
00:12:05,720 --> 00:12:08,470
ولا أملك 500،000 ين أيضاً

202
00:12:08,470 --> 00:12:11,410
لو كنتَ تمتلك ستشتريها إذاً، صحيح؟
ما رأيك أن تتّصِل بأمّك لأجلي إذاً؟

203
00:12:12,550 --> 00:12:15,290
لا أظنُّ أنّ أمّي ستشتريها

204
00:12:15,900 --> 00:12:17,290
...هذا الفتى طعم سهل

205
00:12:17,530 --> 00:12:19,180
ما رأيك أن تلمسها؟

206
00:12:19,180 --> 00:12:21,800
ملمسُها حُبَيبيّ بعض الشّيء ويُشعرك بشعور جميل

207
00:12:21,980 --> 00:12:24,340
لا أستطيع التّمييز

208
00:12:26,970 --> 00:12:27,970
كان ذلك وشيكاً

209
00:12:27,970 --> 00:12:29,350
ماذا كان هذا؟

210
00:12:30,790 --> 00:12:31,850
ينبغي أن تكون حذراً

211
00:12:34,770 --> 00:12:35,940
كسرتَها

212
00:12:37,300 --> 00:12:38,700
...كـ-كان هذا

213
00:12:38,700 --> 00:12:40,930
ماذا؟ هل ستلوم شخصاً آخر؟

214
00:12:40,930 --> 00:12:42,250
...لا

215
00:12:42,250 --> 00:12:43,530
...يا فتى

216
00:12:43,870 --> 00:12:47,780
حلّ المشاكل بالمال أفضل، أتفهم؟

217
00:12:47,780 --> 00:12:51,660
يا إلهي... هل كسرتَها يا سيّد؟

218
00:12:52,330 --> 00:12:54,420
هل لديك هاتف؟

219
00:12:54,420 --> 00:12:56,040
...لـ-ليس لديّ

220
00:12:57,150 --> 00:13:00,210
رنَّ الهاتف في الوقت المناسب، لِمَ لا تُجيب عليه؟

221
00:13:01,780 --> 00:13:03,850
ماذا تفعل يا موب؟

222
00:13:03,850 --> 00:13:06,840
أتتّصِل بي في الوقت الذي قد يزورني
...فيه زبون في أي لحظة

223
00:13:08,450 --> 00:13:11,100
هل أنت حارس هذا الصبيّ يا سيّد؟

224
00:13:11,100 --> 00:13:12,450
...هكذا إذاً

225
00:13:12,450 --> 00:13:14,750
يكلِّف استبدال هذه 5 مليون ين

226
00:13:14,750 --> 00:13:18,860
أتقول لي أنّ موب هذا هو من كسر
هذه المزهريّة التي تبدو رخيصة؟

227
00:13:18,860 --> 00:13:20,920
ماذا تقول؟

228
00:13:20,920 --> 00:13:23,610
يبدو أنّك لا تعرف كيف يعمل عالمنا

229
00:13:23,610 --> 00:13:25,240
أتريدني أن أحرص على ألّا تعمل مجدّداً؟

230
00:13:25,240 --> 00:13:28,940
كسرتَ عظمة ترقوتي

231
00:13:28,940 --> 00:13:30,740
سيكلّفك هذا

232
00:13:31,500 --> 00:13:32,390
ماذا؟

233
00:13:32,750 --> 00:13:35,500
فاتورة المشفى مع التّعويضات ستكون مليون ين

234
00:13:36,680 --> 00:13:39,750
!كـ-كفاك هُراء أيّها الأحمق

235
00:13:39,750 --> 00:13:42,450
وها هو الضرر النفسيّ

236
00:13:42,450 --> 00:13:44,170
والذي سيكلّف مليوناً أخرى

237
00:13:44,170 --> 00:13:45,240
أنت

238
00:13:45,240 --> 00:13:47,840
رائحة أنفاسك نتِنة، مليون أخرى

239
00:13:47,840 --> 00:13:48,920
!ماذا؟

240
00:13:48,920 --> 00:13:51,970
صوتك عالٍ، ستُضاف مليون أخرى

241
00:13:51,970 --> 00:13:54,420
أتلفتَ قميصي

242
00:13:55,010 --> 00:13:57,230
مليون أخرى ثمن إصلاح الأضرار

243
00:13:57,990 --> 00:14:00,480
وهذا مُكافئ لما هو مَدين لك على المزهريّة

244
00:14:00,880 --> 00:14:03,840
هذه هي طبيعة العمل الذي تديرونه

245
00:14:03,840 --> 00:14:05,240
هيّا بنا يا موب

246
00:14:05,240 --> 00:14:06,610
!مُحال أن ندعك تُغادر بهذا الشّكل

247
00:14:06,610 --> 00:14:08,060
!استسلم

248
00:14:08,060 --> 00:14:11,920
تقرَّرَ حظُّه العاثر عندما كسرَ مزهريّة السّعادة

249
00:14:11,920 --> 00:14:14,240
وربّما ستحلُّ عليه كارثة ما

250
00:14:14,570 --> 00:14:16,710
حظّ عاثِر؟ كارثة؟

251
00:14:17,440 --> 00:14:22,040
كنتُ أتكلّم للتو مع شخص قد سكنَتْه روح شرّيرة

252
00:14:22,220 --> 00:14:26,220
ويبدو أنّ الرّوح قد قرّرتْ أن تسكنني

253
00:14:26,380 --> 00:14:29,570
وعندما يحدث ذلك، لا تتوانى عن سماع أصوات
غريبة في اللّيل

254
00:14:29,570 --> 00:14:33,350
وتظهر أشياء غريبة باستمرار في الصّور ليُصبح
الأمر لا يُحتمَل

255
00:14:33,350 --> 00:14:37,100
مع أنّ الرُّوح قد تكون قد انتقلت إليكما الآن

256
00:14:37,100 --> 00:14:38,980
توخّيا الحذر ليلاً

257
00:14:39,260 --> 00:14:40,260
ماذا؟

258
00:14:40,260 --> 00:14:41,110
شبح؟

259
00:14:41,110 --> 00:14:45,480
لا يبدو هذا رائعاً، أليس كذلك؟
هذا ما تفعلانه بالضبط

260
00:14:48,160 --> 00:14:51,490
!شبح؟ ما خطبك يا فتى؟ هذا مُخيف للغاية

261
00:15:02,540 --> 00:15:05,050
أسكتَهما ذلك بسُرعة

262
00:15:05,200 --> 00:15:08,170
الجزء الأخير كان رائعاً يا موب

263
00:15:08,610 --> 00:15:09,620
ماذا؟

264
00:15:09,620 --> 00:15:12,170
هززتَ البِناء لإخافتهم، صحيح؟

265
00:15:12,170 --> 00:15:16,180
لا، ظننتُك أنت من أرسل
...الرُّوح الشرّيرة خلفهما

266
00:15:16,440 --> 00:15:18,200
—هل يُعقَلُ أنّك لم تستطع رؤية

267
00:15:18,200 --> 00:15:19,180
...بالطبع

268
00:15:19,930 --> 00:15:21,380
استطعتُ رؤيتها

269
00:15:22,550 --> 00:15:23,830
...أتعلم

270
00:15:23,830 --> 00:15:26,980
المُحتالون أشخاص سيّئون للغاية

271
00:15:27,770 --> 00:15:29,210
...نعم

272
00:15:29,210 --> 00:15:34,700
...من يُحاولون استغلال الضعيف هُم أدنأ النّاس

273
00:15:34,700 --> 00:15:36,950
ماذا؟ أنتِ كذلك؟

274
00:15:36,950 --> 00:15:39,710
"أجل، قال "إذاً أنتِ حثالة أيضاً؟

275
00:15:39,710 --> 00:15:42,330
كلّ ما كنتُ أفعله هو عَلك علكة أثناء الدّرس

276
00:15:42,940 --> 00:15:46,590
كامورو، هذه المدرسة ليست ملكاً لك

277
00:15:47,510 --> 00:15:50,090
ما زال أمامنا المزيد من القمامة الأصغر حجماً

278
00:15:50,090 --> 00:15:51,500
لنتابع طريقنا

279
00:15:51,500 --> 00:15:53,220
أما زلت تريد الاستمرار في هذا؟

280
00:15:53,220 --> 00:15:54,590
...هوّن عليك

281
00:15:55,430 --> 00:15:57,710
أتلمّح إلى إيقاف عملنا؟

282
00:15:57,710 --> 00:16:01,150
لا، شعرتُ للتو برغبة في التقيُّؤ

283
00:16:01,440 --> 00:16:03,190
أنا متأكّد أنّك تحاول التّخفيف من إجهادِك فحسب

284
00:16:05,330 --> 00:16:08,300
كنتُ مُحقّاً في اختيارك كمُتواطئ

285
00:16:08,300 --> 00:16:11,070
بما أنّك تعلم ذلك فلماذا قرّرتَ مُساعدتي؟

286
00:16:13,070 --> 00:16:14,360
لأنّني كنتُ مُتعباً

287
00:16:15,010 --> 00:16:18,060
أظنُّني قد سئمتُ من نفسي

288
00:16:18,060 --> 00:16:21,460
أردتُ فقط أن أعرف كيف يكون شعور الأحمق

289
00:16:22,270 --> 00:16:24,530
أحمق؟

290
00:16:24,530 --> 00:16:26,960
لكنّنا في النّهاية أصبحنا مشهورين

291
00:16:26,960 --> 00:16:29,880
أصبحنا أبطال المدرسة

292
00:16:30,560 --> 00:16:33,950
ذلك الرّجل الذي يُوحي بأنّه كبير في السنّ
أراد أن يكون مشهوراً إذاً؟

293
00:16:35,630 --> 00:16:38,940
اكتسبتُ عالماً أوسع بكثير

294
00:16:39,710 --> 00:16:43,230
بالمناسبة يا حضرة الرّئيس، هل وجدتِ أي مُتخاطِر؟

295
00:16:43,230 --> 00:16:45,520
لو وجدت لما رأيتَني هنا

296
00:16:45,520 --> 00:16:48,360
!إينوكاوا! من الغشّ أن تضع قنبلتك هنا

297
00:16:48,640 --> 00:16:51,880
كوراتا، هلّا هدأتِ قليلاً؟

298
00:16:51,880 --> 00:16:54,360
لم ينتهِ من الكلام بعد

299
00:16:54,360 --> 00:16:55,970
آسفة

300
00:16:55,970 --> 00:16:57,970
موساشي، هذا يكفي

301
00:17:00,300 --> 00:17:02,120
!اذهب إلى الصفّ يا أونيغاوارا

302
00:17:02,120 --> 00:17:04,300
لا يوجد أي مأوى لي

303
00:17:04,300 --> 00:17:07,500
لن يتكلّم معي أصدقائي بعد الآن

304
00:17:08,220 --> 00:17:09,170
...زائر

305
00:17:09,750 --> 00:17:11,180
!رئيس مجلس الطّلبة

306
00:17:11,180 --> 00:17:14,940
أرى هذا المكان متعفّناً كما يقولون

307
00:17:14,940 --> 00:17:16,260
...المهمّ

308
00:17:16,260 --> 00:17:19,510
ماذا تفعل هُنا يا أونيغاوارا-كُن؟

309
00:17:19,720 --> 00:17:22,160
...تتسلّلُ إلى داخل المدرسة ولا تحضر إلى الصفّ

310
00:17:22,160 --> 00:17:22,890
!لا

311
00:17:23,140 --> 00:17:25,640
—لكن إن بقيتُ في المنزل فستسألني أمّي عن السّبب

312
00:17:25,640 --> 00:17:27,400
اسمع أيّها الرّئيس

313
00:17:27,590 --> 00:17:29,770
أونيغاوارا لم يفعل شيئاً

314
00:17:29,770 --> 00:17:34,850
هل أتعاملُ معكم جميعاً على أنّكم مُتواطئين مع أونيغاوارا؟

315
00:17:34,850 --> 00:17:35,350
—ماذا

316
00:17:35,350 --> 00:17:39,960
حضرة الرّئيس، أتى شخص غريب إلى بوّابة المدرسة

317
00:17:40,230 --> 00:17:43,790
يا إلهي، لا يأتون إلّا في أسوأ الأوقات

318
00:17:44,560 --> 00:17:48,920
من أنت؟ قلتُ لك أحضر لي سمّ تي الأبيض

319
00:17:49,200 --> 00:17:51,610
سمّ تي الأبيض؟ ما هذا بالضبط؟

320
00:17:51,610 --> 00:17:55,070
كفاك عبثاً! إنّه حديث العصابات اليوم

321
00:17:55,070 --> 00:17:58,220
سأتولّى أمره، ينبغي أن يفي هذا بالغرض

322
00:17:59,890 --> 00:18:02,220
...كـ-كان ذلك مفاجئاً

323
00:18:02,440 --> 00:18:04,570
اعتبره دفاعاً عن النّفس

324
00:18:05,120 --> 00:18:08,530
ناهيك عن أنّهم تلاميذ من مدرسة أخرى، لِذا لا داعي للقلق

325
00:18:09,740 --> 00:18:11,980
...لا أصدّق أنّه هو من قاتل

326
00:18:12,500 --> 00:18:14,960
وأن يكون بتلك القوّة علاوة على ذلك

327
00:18:14,960 --> 00:18:18,120
هل أنت من نال من كينزاكي-سان؟

328
00:18:18,740 --> 00:18:21,120
هل أنت سمّ تي الأبيض؟

329
00:18:21,120 --> 00:18:24,870
!ما-ما الذي... كنتُ أتفرّج فحسب

330
00:18:24,870 --> 00:18:27,150
من هو سمّ تي الأبيض بالضبط إذاً؟

331
00:18:27,150 --> 00:18:28,000
—أنا لا

332
00:18:32,000 --> 00:18:34,380
!هذا يكفي! حان وقتُ التوقُّف

333
00:18:34,780 --> 00:18:36,500
تبدو بحالة مزرية

334
00:18:36,500 --> 00:18:38,450
أصبحتُ ضحيّة

335
00:18:38,450 --> 00:18:42,140
لأنّك لقّنتَ قائد عصابة من مدرسة أخرى درساً

336
00:18:42,140 --> 00:18:43,390
!ألا تفهم ذلك؟

337
00:18:43,740 --> 00:18:47,390
أنا راضٍ عن هذا، ما حلَّ بك تستحقُّه

338
00:18:51,340 --> 00:18:52,770
!مـ-مجدّداً؟

339
00:18:53,020 --> 00:18:55,280
هل أنت سمّ تي الأبيض؟

340
00:19:01,590 --> 00:19:03,080
هذا أنت يا توكوغاوا-كُن

341
00:19:03,560 --> 00:19:06,380
شينجي لا يريد أن يرى أحداً الآن

342
00:19:07,050 --> 00:19:08,580
...هكذا إذاً

343
00:19:09,640 --> 00:19:11,530
يا لها من غرفة فظيعة مليئة بالقمامة

344
00:19:12,010 --> 00:19:15,090
أعتقدُ أنّه ما كان ينبغي عليك تنظيفه هو هذه الغرفة

345
00:19:16,460 --> 00:19:18,930
كـ-كيف دخلت إلى هنا؟

346
00:19:18,930 --> 00:19:22,390
هنالك كثير من قطع القمامة الصّغيرة متروكة في المدرسة

347
00:19:22,390 --> 00:19:25,950
!سـ-سئمتُ من كلّ هذا! اخرج

348
00:19:25,950 --> 00:19:27,330
فات الأوان

349
00:19:27,330 --> 00:19:30,090
كلانا قمنا بعملٍ لا يُغتفَر

350
00:19:30,090 --> 00:19:32,290
لن ينقذنا أحد

351
00:19:38,180 --> 00:19:42,340
تحطّمت الدُّمية، أصبحت المدرسة نظيفة الآن

352
00:19:42,340 --> 00:19:43,900
ماذا ستفعل الآن؟

353
00:19:43,900 --> 00:19:46,740
ستظهر المدارس الاخرى مجدّداً

354
00:19:47,020 --> 00:19:49,800
أستطيعُ فعل ما أشاء ما دمتُ أمتلك هذه القوى

355
00:19:49,800 --> 00:19:52,120
!نعم! يمكنُك أن تصبح نجماً لامعاً

356
00:19:52,810 --> 00:19:56,150
إيكوبو، أنت تحاولُ استغلالي أيضاً، أليس كذلك؟

357
00:19:56,150 --> 00:19:56,750
!ماذا؟

358
00:19:57,020 --> 00:19:58,880
عمّاذا تتكلّم يا ريتشان؟

359
00:19:58,880 --> 00:20:00,720
!نحن شريكان

360
00:20:10,760 --> 00:20:12,430
وها هم قادمون

361
00:20:12,430 --> 00:20:14,340
هنالك عدد كبير منهم اليوم

362
00:20:16,510 --> 00:20:19,150
...أتيتُ لأرى ما الذي كان يجري وبالطبع

363
00:20:19,620 --> 00:20:23,530
هل أنت سمّ تي الأبيض الذي هزم هانازاوا وكينزاكي؟

364
00:20:25,010 --> 00:20:27,030
ماذا؟! هل يدّعي أنّه كاغياما؟

365
00:20:27,960 --> 00:20:31,460
أعتقد أنّ الأمور ستُحسَم حالما أتولّى أمركم

366
00:20:31,460 --> 00:20:33,540
لِذا لنقل أنّني هو فحسب

367
00:20:33,540 --> 00:20:37,040
...يبدو أنّني سأسأل كاغياما عن هذا الأمر

368
00:20:38,750 --> 00:20:41,690
يبدو أنّني عثرتُ على شيء مُثير جدّاً للاهتمام

369
00:20:41,690 --> 00:20:44,300
وجدتُه، سأعتقله وأعود

370
00:20:45,170 --> 00:20:48,970
لكن قبل ذلك، ينبغي أن أراقب قليلاً

371
00:20:48,970 --> 00:20:49,720
استحواذ

372
00:20:56,620 --> 00:20:58,480
حسناً، تابع

373
00:20:58,480 --> 00:21:00,270
أتستفزّنا؟

374
00:21:00,270 --> 00:21:02,470
!يبدو مناسباً بالنسبة لنا

375
00:21:04,240 --> 00:21:06,820
!لا تخافوا الآن

376
00:21:07,220 --> 00:21:08,080
...المسألة ليست كذلك

377
00:21:08,080 --> 00:21:09,830
...لا يمكننا الحركة

378
00:21:09,830 --> 00:21:12,170
إيكوبو، سنستخدم قوّة أكبر قليلاً هذه المرّة

379
00:21:15,540 --> 00:21:16,750
!فرصة

380
00:21:23,340 --> 00:21:27,760
—خدعك السحريّة لن تنفع معي أنا يا سمّ تي الأبيـ

381
00:21:29,310 --> 00:21:31,430
ما الذي يجري بالضبط؟

382
00:21:31,430 --> 00:21:33,450
هل سمّ تي الأبيض يفعل هذا؟

383
00:21:33,450 --> 00:21:36,800
!لا تتردّدوا! لنهاجمه كلّنا معاً في آن واحد

384
00:21:39,150 --> 00:21:42,030
لن أحكم عليكم أيّها الناس

385
00:21:42,030 --> 00:21:43,840
لأنّني بِتُّ أعلم الآن

386
00:21:43,840 --> 00:21:46,660
،عندما يضلُّ النّاس عن الطريق

387
00:21:46,660 --> 00:21:48,810
فلا يكون هناك سبباً فعليّاً عادة

388
00:21:48,810 --> 00:21:50,490
الأمر كذلك حتّى الآن

389
00:21:50,490 --> 00:21:52,700
وعندما أواجه أعداء قد فقدوا إرادة القتال

390
00:21:53,160 --> 00:21:55,330
.فإنّني أمضي لأجل العنف

391
00:21:55,330 --> 00:21:57,180
لا يوجد سبب هنا

392
00:21:58,420 --> 00:22:00,630
هذا النّوع من الحرّية متين

393
00:22:00,630 --> 00:22:04,000
أنا أكثر حرّية منكم جميعاً

394
00:22:04,000 --> 00:22:05,070
لماذا؟

395
00:22:05,460 --> 00:22:07,970
لأنّني خسرتُ حدودي

396
00:22:07,970 --> 00:22:10,480
اكتسبتُ الخسارة

397
00:22:22,190 --> 00:22:23,040
...ريتسو

398
00:22:24,020 --> 00:22:25,270
ماذا تفعل؟

399
00:23:56,720 --> 00:23:58,880
يتجابه الأخَوان أخيراً في زقاق بعد الدّوام المدرسي

400
00:23:58,880 --> 00:24:02,230
ومن ثمّ يظهر مُدرِك فوق حسّي بالِغ
شوهِدَ سابقاً فجأة

401
00:24:02,230 --> 00:24:04,350
موب، هذا الرّجل لا يحمد عقباه

402
00:24:04,350 --> 00:24:06,230
:الحلقة القادمة من موب سايكو

403
00:24:06,230 --> 00:24:07,770
الأخ الاكبر ينحني"
"~نيّة الدّمار~

404
00:24:07,770 --> 00:24:08,870
بماذا أوصي؟

405
00:24:08,870 --> 00:24:10,920
!الخيار المناسب أ مع مجموعة أقراص بلوراي