1
00:00:01,560 --> 00:00:03,230
!التّطوير الجسماني

2
00:00:03,560 --> 00:00:06,730
!كفاح! كفاح! كفاح! كفاح

3
00:00:07,460 --> 00:00:08,990
...جاذبيّة الرّجل

4
00:00:08,990 --> 00:00:11,030
...لا تجدها في القوى الروحيّة

5
00:00:11,700 --> 00:00:13,950
،لتغيير نفسي

6
00:00:13,950 --> 00:00:16,160
.انضممتُ لنادي التّطوير الجسماني

7
00:00:16,410 --> 00:00:18,030
!التّطوير الجسمانيّ

8
00:00:18,030 --> 00:00:21,210
!كفاح! كفاح! كفاح! كفاح! كفاح

9
00:00:22,260 --> 00:00:23,710
!التّطوير الجسمانيّ

10
00:00:23,710 --> 00:00:27,170
...كـ... ـفاح... كـ... ـفاح

11
00:00:30,510 --> 00:00:32,010
هذا سيّئ

12
00:00:32,870 --> 00:00:34,330
لا بدّ وأنّه مصاب بفقر الدمّ

13
00:00:34,840 --> 00:00:36,150
...آ... آسف

14
00:02:11,740 --> 00:02:13,980
من الواضح أنّه يُعاني من مُشكلة ما

15
00:02:14,240 --> 00:02:17,400
من ذا الّذي يختارُ نادي التّطوير الجسمانيّ
في تِلك اللّحظة؟

16
00:02:17,830 --> 00:02:20,660
حسناً، دعينا ألّا نفكّر بالماضي

17
00:02:21,060 --> 00:02:23,660
هيّا، حان دوركِ أيّتها الرئيسة كوراتا

18
00:02:24,530 --> 00:02:25,080
مرحباً

19
00:02:25,080 --> 00:02:26,500
!موساشي-سان

20
00:02:26,790 --> 00:02:30,390
شكراً جزيلاً لك على السّماح لنا
!باستخدام هذه الغرفة

21
00:02:30,390 --> 00:02:32,250
...لا داعي للانبطاحِ هكذا

22
00:02:32,520 --> 00:02:36,320
ما دمنا نستطيعُ استخدام الغرفة لتجهيزاتنا
فهذا كُل ما نحتاجه

23
00:02:36,800 --> 00:02:37,760
ما هذا؟

24
00:02:38,030 --> 00:02:40,870
أغمي على كاغياما

25
00:02:40,870 --> 00:02:43,260
آسف، لكن هلّا اعتنيتُم به؟

26
00:02:45,280 --> 00:02:47,310
،السّؤال الأهمّ

27
00:02:47,610 --> 00:02:50,060
لماذا انضممت لنادي التّطوير الجسماني؟

28
00:02:51,390 --> 00:02:56,690
لطالما كنتُ سيّئاً في التّمرينات
وعدّاء بطيئاً

29
00:02:57,080 --> 00:02:59,700
أعتمدُ دوماً على قوايّ الرّوحيّة

30
00:02:59,700 --> 00:03:02,820
ماذا؟ أي نوع من الأعذار هذا؟

31
00:03:03,400 --> 00:03:07,330
إن كان لديك قوى روحيّة فعلاً، فأتمنّى رؤيتها! تبّاً

32
00:03:17,170 --> 00:03:19,680
هل هذا كافٍ لتُصدّقيني؟

33
00:03:20,920 --> 00:03:21,930
!إنّها ثقيلة

34
00:03:21,930 --> 00:03:25,430
معقول؟ لم تتمكّن سوى من ثني
الملاعق سابقاً

35
00:03:26,440 --> 00:03:29,430
!أرجوك! ساعدني على تحقيقِ حلمي

36
00:03:30,680 --> 00:03:32,530
لا سبب يدفعُني لإخفاء ذلك

37
00:03:33,110 --> 00:03:37,860
حلمي هو التّواصُل والتّفاعُل مع الكائنات
الحيّة الموجودة في الفضاءِ الخارجيّ

38
00:03:38,350 --> 00:03:40,890
في البداية، قرأتُ عن كيفيّة القيام بذلك
في كتابٍ وجرّبتُها

39
00:03:40,890 --> 00:03:45,030
لكن لا أثَر يُذكَر، لِذا سُرعان ما وجدتُ
...نفسي مُتكاسِلة عن المتابعة

40
00:03:46,050 --> 00:03:47,480
!لكن الآن

41
00:03:47,480 --> 00:03:50,550
!أرى تقدّماً مُفاجئاً

42
00:03:50,550 --> 00:03:54,070
،موب-كُن، دعنا نجري معاً بحثاً عن التّخاطُر

43
00:03:54,070 --> 00:03:57,040
وننطلق بشجاعة إلى أقصى الحدود
لأجلِ لِقاء مُحتمَل

44
00:03:59,370 --> 00:04:03,220
لحظة، لماذا؟ أنتَ باردٌ جدّاً في تلبيةِ شغَفي

45
00:04:03,220 --> 00:04:06,540
لقد عثرتُ أخيراً على شيء أرغبُ بالقيام به

46
00:04:06,540 --> 00:04:09,060
وتقولُ أنّ عملك ليس له علاقة سوى
ببناء العضلات؟

47
00:04:09,060 --> 00:04:10,900
رُغمَ أنّك تمتلك قوى روحيّة؟

48
00:04:12,310 --> 00:04:17,060
في الحقيقة، أستطيعُ القول أنّني أردتُ أزداد
جاذبيّة كرجُل

49
00:04:17,380 --> 00:04:19,570
أتريدُ أن تصبح مشهوراً يا موب-كُن؟

50
00:04:20,990 --> 00:04:22,640
...لا، ليس تماماً

51
00:04:22,640 --> 00:04:23,740
لن تكون

52
00:04:23,740 --> 00:04:24,490
ماذا؟

53
00:04:24,930 --> 00:04:27,640
حتّى لو بنيتَ عضلاتك، لن تصبح مشهوراً

54
00:04:27,640 --> 00:04:29,240
لن تصبح مشهوراً أبداً

55
00:04:29,240 --> 00:04:31,350
...إ-إذاً ماذا ينبغي عليّ

56
00:04:31,350 --> 00:04:34,950
!عليك أن تقرأ أفكار الفتيات بالتّخاطُر

57
00:04:34,950 --> 00:04:36,940
حينها ستُصبح مشهوراً جدّاً

58
00:04:37,600 --> 00:04:40,050
ماذا؟ تخاطُر؟

59
00:04:40,740 --> 00:04:42,750
نعم، لا أستطيع فعل ذلك حقّاً

60
00:04:42,750 --> 00:04:45,300
...مع أنّني أستطيعُ سماع أصوات الأرواح

61
00:04:46,000 --> 00:04:47,340
ما الّذي جعلَك تتطرّق إلى ذلك؟

62
00:04:47,890 --> 00:04:49,300
...كنتُ أتساءلُ فقط

63
00:04:50,250 --> 00:04:52,680
هل تريدُ أن تقرأ قلبَ شخص معيّن؟

64
00:04:55,100 --> 00:04:56,060
هل هي فتاة؟

65
00:04:57,330 --> 00:05:01,070
في الحقيقةِ يا موب-كُن... من السّهل قِراءة أفكارك

66
00:05:01,850 --> 00:05:05,890
،بالطبع، كلّ تلميذ في الإعداديّة يودُّ أن يكون مشهوراً

67
00:05:05,890 --> 00:05:07,660
لِذا لا شيء يدعو للإحراج هنا

68
00:05:07,660 --> 00:05:11,080
فحتّى أنا أريدُ أن أصبح مشهوراً

69
00:05:12,740 --> 00:05:15,830
...لا أقول أنّني أريدُ أن أصبح مشهوراً

70
00:05:16,230 --> 00:05:18,260
...ما دمتُ أستطيعُ التقرُّب من تسوبومي-تشان

71
00:05:18,760 --> 00:05:21,590
المعذرة أيُّها الصّغير

72
00:05:21,870 --> 00:05:23,320
لا بدّ أنّ هناك ما يُضايقك

73
00:05:23,320 --> 00:05:25,330
لا أراكَ تبتسم

74
00:05:26,710 --> 00:05:27,340
...لا

75
00:05:27,340 --> 00:05:29,080
هذا واضح

76
00:05:29,080 --> 00:05:30,850
أنتَ منزعجٌ بشأن دراستك، أليس كذلك؟

77
00:05:31,620 --> 00:05:32,680
لستُ كذلك

78
00:05:32,680 --> 00:05:36,090
...بالطبع لا، ليسَتْ دراستك

79
00:05:36,090 --> 00:05:39,120
نعم، لا بدّ وأنّك تُعاني من مشاكل في المنزل

80
00:05:39,120 --> 00:05:40,360
في الواقع، أنا بخير

81
00:05:40,360 --> 00:05:45,360
...بالطبع أنتَ بخير، لا بدّ وأنّها صحّتك... لا

82
00:05:46,240 --> 00:05:47,490
الأمر له علاقةٌ بالحبّ

83
00:05:47,730 --> 00:05:49,280
!كيفَ عرفتِ؟

84
00:05:51,540 --> 00:05:55,590
إن أردتَ حلّ مشاكلك فتعالَ معي

85
00:05:55,590 --> 00:05:57,290
في الواقع، عليّ العودة إلى المنزل

86
00:05:57,290 --> 00:05:58,460
ستُصبح مشهوراً

87
00:05:58,460 --> 00:05:59,860
!سأذهب

88
00:06:05,320 --> 00:06:10,800
أنتمي لدينٍ جديدٍ كلّياً قد تأسّسَ في الشهر الماضي

89
00:06:11,190 --> 00:06:12,600
دين؟

90
00:06:12,600 --> 00:06:14,810
(اسم مجموعتنا هو (كاكّواراي

91
00:06:15,350 --> 00:06:21,560
إنّه أسعد تجمُّع عصري يؤسّسُه قائدُنا، إيكوبو-ساما

92
00:06:21,560 --> 00:06:26,820
يمتلكُ إيكوبو-ساما قوّة غامضة تجعلُ
أي شخص يضحكُ فوراً

93
00:06:26,990 --> 00:06:29,700
وكيف أصبح مشهوراً؟

94
00:06:31,500 --> 00:06:33,600
اهدأ، لا تستعجل

95
00:06:35,230 --> 00:06:39,310
كاكّواراي ليسَتْ مجموعة مشبوهة

96
00:06:40,790 --> 00:06:43,710
مذهل، هنالك عددٌ كبير من النّاس

97
00:06:44,710 --> 00:06:47,460
أتساءلُ ما إن كانوا جميعاً يبحثون عن شهرة أيضاً

98
00:06:47,790 --> 00:06:50,260
هل أنتَ جديدٌ أيضاً؟

99
00:06:50,870 --> 00:06:53,210
اصعد إلى خشبة المسرح إذاً

100
00:06:53,210 --> 00:06:54,370
لماذا؟

101
00:06:54,370 --> 00:06:55,120
هيّا هيّا

102
00:06:55,120 --> 00:06:56,640
بسرعة

103
00:06:56,640 --> 00:06:58,640
احملوه، احملوه

104
00:07:00,870 --> 00:07:02,970
ما الذي يجري هنا يا ترى؟

105
00:07:02,970 --> 00:07:04,980
موب-كُن؟

106
00:07:05,400 --> 00:07:08,720
هل عرفتَني؟ أنا زميلتُك في الصفّ ميزاتو

107
00:07:09,070 --> 00:07:11,680
لم أتكلّم معها من قبل

108
00:07:12,090 --> 00:07:13,390
هل قاموا بإغوائك؟

109
00:07:13,390 --> 00:07:14,580
...أنا

110
00:07:13,770 --> 00:07:16,580
!لقد أتى! إنّه إيكوبو-ساما

111
00:07:23,070 --> 00:07:24,180
...يا جماعة

112
00:07:24,840 --> 00:07:26,710
!هل تضحكون؟

113
00:07:32,970 --> 00:07:35,100
هل تقومون بالإحماء؟

114
00:07:35,100 --> 00:07:37,390
ما رأيكم بخلع هذه الأقنعة الآن؟

115
00:07:39,350 --> 00:07:40,660
!بريق

116
00:07:42,240 --> 00:07:44,810
تبتسمون وكلّكم بريق

117
00:07:49,990 --> 00:07:51,650
...مخيفون للغاية

118
00:07:54,470 --> 00:07:55,910
!توقّفوا

119
00:07:57,910 --> 00:08:02,180
ينضمُّ إلينا اليوم ثلاثة زُملاء باسِمون جدُد

120
00:08:02,180 --> 00:08:03,170
!صفّقوا

121
00:08:03,170 --> 00:08:04,800
ماذا؟

122
00:08:04,800 --> 00:08:06,770
...انتظر، لا

123
00:08:07,940 --> 00:08:12,380
لقبولِ السّعادة، يجبُ عليكم تحرير قلوبكم

124
00:08:12,380 --> 00:08:16,470
لكن قلوبكم مُقفَلة

125
00:08:16,830 --> 00:08:19,720
هل ترون؟ من الواضح تماماً أنّكم غير سعداء

126
00:08:19,720 --> 00:08:21,410
فأنتُم لا تبتسمون

127
00:08:22,730 --> 00:08:25,560
اضحكوا، اضحكوا حتّى لو كنتُم تتألّمون

128
00:08:25,560 --> 00:08:27,690
ليُفتَح القفل

129
00:08:31,090 --> 00:08:33,830
،حالما تتحرّرُ قلوبكم

130
00:08:33,830 --> 00:08:37,550
ستحظون بفُرصة لقبولِ السّعادة بصدق

131
00:08:37,550 --> 00:08:41,700
رسم البسمة في شفاهكم هي الطّريق
لرسمِ السّعادة

132
00:08:41,700 --> 00:08:45,210
هذه هي تعاليم كاكّواراي

133
00:08:45,510 --> 00:08:49,340
إن كان بمقدورنا أن نصبح سُعداء بمجرّد الضّحك
لوجدنا الأمرَ غاية في السّهولة

134
00:08:49,340 --> 00:08:50,680
من قد يكون هذا؟

135
00:08:50,680 --> 00:08:53,660
عثرنا عليه في مقعدِ إحدى الحدائق

136
00:08:53,660 --> 00:08:56,470
!يا للأسف! ضحيّة للانتكاس

137
00:08:56,990 --> 00:08:59,370
لا عجب في عجزِك عن الابتسام

138
00:08:59,370 --> 00:09:01,220
!لكن لا تقلق

139
00:09:01,700 --> 00:09:04,480
لنُلبسك قِناع الابتسامة ونصحّح ذلك

140
00:09:04,480 --> 00:09:06,000
...ما الذي

141
00:09:06,000 --> 00:09:07,480
...مهلاً

142
00:09:07,480 --> 00:09:09,820
هذه طريقتُنا لإنقاذك

143
00:09:09,820 --> 00:09:13,690
نريدُك أن تبتسم فحسب

144
00:09:17,340 --> 00:09:18,630
لا تُقاوم

145
00:09:19,010 --> 00:09:20,660
أخيراً، الفتاة

146
00:09:20,660 --> 00:09:23,480
يبدو أنّكِ تريدين أن تقولي كلاماً ما

147
00:09:24,950 --> 00:09:29,170
المنظّمة الدينيّة كاكّواراي. تمّ تأسيسها في الشّهر الماضي؟

148
00:09:29,730 --> 00:09:33,520
هل تمكّنتَ من جذبِ هذا العدد الكبير
من الأتباع في غضون شهر؟

149
00:09:33,520 --> 00:09:34,660
هذا مشبوه جدّاً

150
00:09:34,660 --> 00:09:36,680
وأنتِ...؟

151
00:09:36,680 --> 00:09:38,770
!أعملُ في صحيفة مدرسة الملح الإعداديّة

152
00:09:38,770 --> 00:09:40,680
!اسمي ميزاتو من الصفّ 2-1

153
00:09:41,000 --> 00:09:44,660
أكتبُ تقريراً حول الإشاعة السيّئة التي تحيطُ بكم

154
00:09:44,660 --> 00:09:46,060
إشاعة سيّئة؟

155
00:09:46,510 --> 00:09:48,660
سمعتُ أنّك تستخدمُ التّنويم المغناطيسيّ الجماعيّ

156
00:09:48,660 --> 00:09:50,310
لغسلِ الأدمِغة وإجبار النّاس على دخول منظّمتك

157
00:09:50,840 --> 00:09:53,510
لديها الجرأة على قول ذلك بعدما تسلّلَتْ
إلى الدّاخل بمفردها

158
00:09:53,510 --> 00:09:54,700
بديع

159
00:09:55,510 --> 00:09:57,310
اسمحي لي أن أشرح شيئاً

160
00:09:57,310 --> 00:09:59,990
من فضلكِ ألقي نظرة إلى ذلك السيّد

161
00:09:59,990 --> 00:10:03,330
منذُ بضعة دقائق، كان رجلاً حزيناً جدّاً

162
00:10:03,570 --> 00:10:04,920
!بريق

163
00:10:06,330 --> 00:10:08,080
!يا لها من ابتسامة رائعة

164
00:10:08,260 --> 00:10:09,730
...كم هذا مضحك

165
00:10:08,810 --> 00:10:11,590
إنّه يضحك؟ لماذا؟

166
00:10:11,810 --> 00:10:15,190
لقد أصبحت السّعادة في متناول يده الآن

167
00:10:15,190 --> 00:10:17,090
ما رأيكِ أيّتها السيّدة الصّغيرة؟

168
00:10:18,490 --> 00:10:21,350
...صحيح، لم يرتكبوا أي خطأ

169
00:10:22,130 --> 00:10:24,350
أنا متأكّدٌ أنّك ستجدُ عملاً

170
00:10:24,890 --> 00:10:27,900
لكن ما زلتُ أشعرُ بوجود مشكلة ما

171
00:10:27,900 --> 00:10:29,850
...هذه الأجواء غير طبيعيّة

172
00:10:30,860 --> 00:10:34,660
،أجدُ صعوبة في استيعابِ هذه القصّة

173
00:10:34,660 --> 00:10:36,170
...أستأذن إذاً

174
00:10:36,170 --> 00:10:37,110
لن تذهبي

175
00:10:37,550 --> 00:10:43,120
اخترقتِ كاكّواراي بسُخريّة مُرتابةً بابتساماتِنا

176
00:10:43,370 --> 00:10:45,610
أنا آسِفة حقّاً

177
00:10:45,610 --> 00:10:48,120
لن أكتب عنكم في الصّحيفة المدرسيّة

178
00:10:48,120 --> 00:10:51,880
هذا لا يكفي! في هذه الحالة، ستفسد
الأمور في نهاية المطاف

179
00:10:52,500 --> 00:10:55,380
لن ندعكِ تغادرين ما لم تضحكي

180
00:10:55,950 --> 00:10:58,510
لـ-لا أشعر برغبةٍ للضحكِ الآن

181
00:10:58,510 --> 00:11:02,390
إضافة إلى أنّني إن ضحِكتُ الآن
فستكونُ ضحكة غير صادقة

182
00:11:02,390 --> 00:11:04,390
يبدأ الأمرُ بابتسامة

183
00:11:06,000 --> 00:11:09,140
لا، لا أريدُ أن أكذبَ على نفسي

184
00:11:09,380 --> 00:11:10,390
!مهلاً

185
00:11:12,700 --> 00:11:13,990
!ما هذا؟

186
00:11:14,600 --> 00:11:17,760
...ما-ماذا؟ أنا

187
00:11:17,760 --> 00:11:20,040
!لا! لا تفعلي

188
00:11:20,040 --> 00:11:21,740
!لا

189
00:11:21,950 --> 00:11:23,450
!بريق

190
00:11:23,640 --> 00:11:26,200
!انظروا إلى تلك الابتسامة العظيمة

191
00:11:26,200 --> 00:11:27,720
!مبروك

192
00:11:26,450 --> 00:11:27,870
تبدين مختلِفة كلّياً الآن

193
00:11:27,570 --> 00:11:29,520
...لا، أنا

194
00:11:28,260 --> 00:11:29,670
يا لها من ابتسامة لامِعة

195
00:11:29,520 --> 00:11:30,210
...لا

196
00:11:30,860 --> 00:11:32,710
ما هذا الإحساس؟

197
00:11:32,710 --> 00:11:37,270
...كلّنا نبتسمُ ونشعر بشعور جميل حقّاً

198
00:11:37,460 --> 00:11:41,470
!لكن، لا! لا أريدُ أن أبتسم البتّة

199
00:11:41,470 --> 00:11:44,050
!فليُنقذني أحدكم

200
00:11:44,050 --> 00:11:45,970
المعذرة

201
00:11:46,250 --> 00:11:47,430
!موب-كُن

202
00:11:48,110 --> 00:11:51,070
إذاً الموضوع هنا هو الابتسام والسّعادة

203
00:11:51,070 --> 00:11:53,190
ولا علاقة له بالشّهرة إطلاقاً، صحيح؟

204
00:11:53,630 --> 00:11:54,950
هل يمكنني المُغادرة الآن؟

205
00:11:55,490 --> 00:11:56,520
من هذا؟

206
00:11:56,520 --> 00:12:00,510
بدا مضطّرباً في طريقه من المدرسة
إلى المنزل، لهذا أحضرتُه إلى هنا

207
00:12:00,510 --> 00:12:02,530
يبدو أنّه يعاني من مُشكلة عاطفيّة

208
00:12:03,720 --> 00:12:06,330
...مع أنّني لستُ متضايقاً حقّاً

209
00:12:06,830 --> 00:12:08,440
!إنّه لا يبتسم

210
00:12:08,440 --> 00:12:11,010
هل يُعقَلُ أنّ قناع الابتسامة لم يؤثّر عليه؟

211
00:12:11,620 --> 00:12:13,470
ماذا؟ لا يبتسم؟

212
00:12:13,470 --> 00:12:14,630
وداعاً

213
00:12:14,630 --> 00:12:16,380
!ا-انتظر

214
00:12:16,380 --> 00:12:18,960
هل تنوي أن تعيش بقيّة حياتك بهذا الوجه؟

215
00:12:19,200 --> 00:12:21,310
!الحياةُ تفلتُ من بين يديك

216
00:12:23,870 --> 00:12:26,520
قال أبي "النّاس الذين لم يدخّنوا من قبل

217
00:12:26,520 --> 00:12:29,220
"تفلتُ نصف حياتهم من بين أيديهم

218
00:12:29,610 --> 00:12:33,230
جعلَني هذا أدركُ أنّ الجميع لديهم رأي مختلف
عن ما قد يفوتهم وما لا يفوتهم

219
00:12:33,820 --> 00:12:36,230
ليسَ هذا ما أتحدّثُ عنه

220
00:12:36,550 --> 00:12:41,390
كاكّواراي هي نقطةُ الانطلاق لأصبح شخصيّة
!دينيّة للبشريّة جمعاء

221
00:12:41,390 --> 00:12:43,740
!لن أدع هذا يعرقلني

222
00:12:44,570 --> 00:12:49,240
أريدُك أن تدرك مدى روعة الابتسام فحسب

223
00:12:49,400 --> 00:12:50,740
لا داعي

224
00:12:50,740 --> 00:12:54,000
إ-إذاً هل تودُّ أن تلعب لعبةً قبل مُغادرتك؟

225
00:12:54,300 --> 00:12:58,500
مُسابَقة التّحديق، ستُنافسُ ثلاثة من قادة
الابتسامة في مُسابَقة التّحديق

226
00:12:58,670 --> 00:13:02,850
ستشربون الحليب جميعاً وأوّل من يضحك، يخسر

227
00:13:02,850 --> 00:13:04,010
ما رأيك؟

228
00:13:04,260 --> 00:13:06,700
!موب-كُن، هذا فخّ

229
00:13:07,970 --> 00:13:09,970
%‏58

230
00:13:07,970 --> 00:13:09,970
:المسار تجاه انفجار موب

231
00:13:16,410 --> 00:13:19,480
هل أنتَ جاهز؟ إن ضحِكت، تخسر

232
00:13:19,810 --> 00:13:21,780
!لماذا تقبلُ بهذا التحدّي؟

233
00:13:22,050 --> 00:13:24,550
موب يعشقُ الحليب

234
00:13:25,260 --> 00:13:28,450
!استعداد، هيّا

235
00:13:35,340 --> 00:13:36,790
!لماذا؟

236
00:13:36,910 --> 00:13:38,130
!هيّا

237
00:13:41,930 --> 00:13:42,880
...مستحيل

238
00:13:43,170 --> 00:13:45,630
ذلكما الاثنان مثيران للشفقة

239
00:13:45,630 --> 00:13:49,890
سأدعُ هذا الصبيّ يُبرِزُ ابتسامةً
...عريضةً بقوايّ الابتساميّة

240
00:13:51,680 --> 00:13:53,140
...فـ-فهمت

241
00:13:53,140 --> 00:13:56,860
...لهذا ارتدَّتْ مُحاولة تصحيح ابتسامته عكسيّاً

242
00:13:58,280 --> 00:14:00,020
ربِحت، لِذا سأذهب إلى المنزلِ الآن

243
00:14:00,020 --> 00:14:01,030
!انتظر

244
00:14:02,400 --> 00:14:04,440
!عليك أن تواجهني الآن

245
00:14:05,240 --> 00:14:05,860
ماذا؟

246
00:14:05,860 --> 00:14:07,450
إيكوبو-ساما سيُواجهه شخصياً؟

247
00:14:07,870 --> 00:14:10,450
لن أدعك تفوز

248
00:14:10,450 --> 00:14:13,450
!سأدعُك تبصقُ ذلك الحليب

249
00:14:13,450 --> 00:14:16,200
!استعداد، هيّا

250
00:14:21,270 --> 00:14:23,050
...ذاك الحليب

251
00:14:24,450 --> 00:14:27,490
خُلِطَ مع شيء حتماً

252
00:14:28,780 --> 00:14:31,580
!ضحِك

253
00:14:30,820 --> 00:14:31,730
!بصقَه

254
00:14:31,580 --> 00:14:32,970
!لا نتوقّع أقلّ من ذلك منك يا إيكوبو-ساما

255
00:14:32,970 --> 00:14:34,310
!أنقذَ شخصاً آخر

256
00:14:34,500 --> 00:14:37,310
...الآن بدأتُ أستمتع أيضاً

257
00:14:37,670 --> 00:14:38,930
!مضحك للغاية

258
00:14:40,730 --> 00:14:44,580
لم... أضحك

259
00:14:49,830 --> 00:14:52,200
...ابتسامتي

260
00:14:52,610 --> 00:14:55,540
لحظة، ذكّروني لماذا أنا هنا؟

261
00:14:58,650 --> 00:15:01,500
!لأنّ هذا مضحك للغاية

262
00:15:01,790 --> 00:15:03,460
...أنتُم فقط

263
00:15:04,070 --> 00:15:08,010
لا، يستحيلُ عليه إلغاء تنويمي المغناطيسي

264
00:15:08,180 --> 00:15:10,670
لكن لماذا أعجزُ عن إضحاكه؟

265
00:15:11,090 --> 00:15:14,090
لا أملك خياراً آخر، عليّ أن أفجّر كلّ طاقاتي

266
00:15:14,870 --> 00:15:19,390
!يا جماعة! لنُنقِذ الضّاحِك الحبيس في داخله

267
00:15:19,390 --> 00:15:21,650
في هذه الحالة، فهو ذو حظّ سيّئ للغاية

268
00:15:21,860 --> 00:15:23,400
!ما أروع هذا

269
00:15:22,430 --> 00:15:23,400
!إيكوبو-ساما

270
00:15:24,220 --> 00:15:25,720
!دعنا نضحك

271
00:15:25,500 --> 00:15:28,110
...انتظروا، أنا

272
00:15:25,720 --> 00:15:27,770
!ابتسم وعِش حياةً جميلة

273
00:15:28,110 --> 00:15:32,110
،أرأيت؟ ليس لديك أعداء هنا

274
00:15:32,110 --> 00:15:34,880
لأجلِ من تُقاتل إذاً؟

275
00:15:37,030 --> 00:15:39,000
افهم الفكرة

276
00:15:40,710 --> 00:15:41,830
موب

277
00:15:42,640 --> 00:15:44,710
لماذا تبدو ضجِراً دوماً؟

278
00:15:45,770 --> 00:15:48,220
إن كنتَ ضجِراً فاذهب إلى المنزل

279
00:15:48,220 --> 00:15:49,970
لكن لستُ كذلك

280
00:15:50,220 --> 00:15:51,720
!اهتزاز

281
00:15:52,890 --> 00:15:55,200
أنتَ الشّخصُ الوحيدُ الذي لا يضحك

282
00:15:56,100 --> 00:15:57,120
موب-كُن

283
00:15:58,310 --> 00:15:59,490
تسوبومي-تشان

284
00:15:59,910 --> 00:16:01,560
افهم الفكرة

285
00:16:06,080 --> 00:16:09,820
سأريك قوّتي الحقيقيّة

286
00:16:10,400 --> 00:16:12,700
!اضحك الآن

287
00:16:14,220 --> 00:16:15,490
!ها هي ذي

288
00:16:17,150 --> 00:16:19,610
!إنّها قوّة إيكوبو-ساما القدسيّة

289
00:16:22,300 --> 00:16:23,370
!ماذا؟

290
00:16:25,270 --> 00:16:26,250
!لماذا؟

291
00:16:26,250 --> 00:16:27,920
!لماذا لا تضحك؟

292
00:16:27,920 --> 00:16:30,760
هل يُعقَلُ أنّ قوايّ لا تؤثّر بك؟

293
00:16:31,090 --> 00:16:34,760
!اضحك! هيّا، اضحك أيّها الطفل! اضحك

294
00:16:34,960 --> 00:16:38,140
هكذا إذاً... يمتلكُ قوى روحيّة أيضاً

295
00:16:38,140 --> 00:16:40,520
!هل أنتَ جثّة؟

296
00:16:41,240 --> 00:16:44,960
لا أستطيع الضّحك بقواك

297
00:16:44,960 --> 00:16:49,900
أنا لا أكرهك، لا أستطيعُ فحسب
حتّى لو رغبتُ بذلك

298
00:16:50,680 --> 00:16:54,370
لا أقصدُ الإساءة بذلك أبداً

299
00:16:54,950 --> 00:16:57,660
...هكذا إذاً... إنّه

300
00:16:58,860 --> 00:17:02,120
لا بدّ وأنّك خالٍ من العواطف أيّها الطفل

301
00:17:02,380 --> 00:17:05,240
ذكروا أنّك كنتَ تُعاني من مشاكل عاطفيّة

302
00:17:05,720 --> 00:17:10,310
لن تتمكّن من الضّحِك مع الفتاة التي تحبُّها
بشخصيّةٍ كهذه

303
00:17:10,310 --> 00:17:14,380
عواطفك هي الّتي تقرّبُ الآخرين منك

304
00:17:15,570 --> 00:17:18,140
لكنّك عاجز عن القيامِ بذلك

305
00:17:18,380 --> 00:17:22,390
لا يمكنكما البُكاء معاً، ولا التأثُّر معاً

306
00:17:22,390 --> 00:17:25,450
ستبقى وحيداً للأبد

307
00:17:28,150 --> 00:17:32,900
...سأمنحُك فُرصة أخيرة

308
00:17:31,860 --> 00:17:32,900
!اضحك

309
00:17:35,840 --> 00:17:39,160
أضحكني بقواك الروحيّة

310
00:17:42,080 --> 00:17:44,200
أنت... هكذا إذاً

311
00:17:45,000 --> 00:17:46,960
...لديك قوى مُشابهة إذاً

312
00:17:47,660 --> 00:17:50,570
حاولتُ اختيار أكثر منظّمة دينيّة مُسالمة

313
00:17:50,570 --> 00:17:52,670
،تحرص على منعِ إراقة الدّماء

314
00:17:53,330 --> 00:17:54,990
لكنّك تعترضُ طريقي أيّها الطفل

315
00:17:54,990 --> 00:17:58,430
عليّ القضاء على الغريب الذي يُجلِب
الفوضى إلى هذه البيئة

316
00:17:58,890 --> 00:18:01,660
يسرُّني أنّك لستَ بشخص

317
00:18:02,710 --> 00:18:06,310
يسرُّني أنّ الشخص الذي قالَ لي كلاماً
"مروّعاً مثل"افهم الفكرة

318
00:18:06,310 --> 00:18:07,830
كان روحاً شرّيرة

319
00:18:10,160 --> 00:18:11,940
!يا أتباعي

320
00:18:12,480 --> 00:18:14,970
!لا تدعوه يُغادر حيّاً

321
00:18:14,970 --> 00:18:16,700
...إشارة آمِرة قويّة

322
00:18:24,850 --> 00:18:25,890
موب-كُن

323
00:18:27,930 --> 00:18:29,750
افهم الفكرة

324
00:18:31,030 --> 00:18:33,820
يوجدُ مُدرِك فوق حسّي هنا

325
00:18:34,200 --> 00:18:37,230
تلميذ في الابتدائيّة يدعونه المُحيطون
"به باسم "موب

326
00:18:37,810 --> 00:18:40,860
،بالرّغمِ من أنّه يمتلكُ قوّةً هائلة

327
00:18:40,860 --> 00:18:45,840
يتجنّبُ دوماً مُحاولة إبراز تِلك القوى
لا شعورياً

328
00:18:46,480 --> 00:18:48,380
،كلّما كبر

329
00:18:48,380 --> 00:18:53,390
يُدرِك أكثر فأكثر مدى خطورة قواه

330
00:18:54,280 --> 00:18:58,940
عندما يكونُ عاجزاً عن الحركة
أو عن القيامِ بما يشاء

331
00:18:58,940 --> 00:19:02,210
تتجمّد عواطفُه تماماً

332
00:19:02,640 --> 00:19:09,510
موب لم يُدرك أنّه يُعاني من عقدةٍ لتجنُّبِ قواه

333
00:19:10,510 --> 00:19:13,560
العواطف التي كانَتْ حبيسة في أعماق قلب موب

334
00:19:13,560 --> 00:19:16,080
تتوسّعُ رويداً رويداً

335
00:19:16,430 --> 00:19:19,560
لكن هنالك حدّ لقدرة عواطفه على التحمُّل

336
00:19:19,560 --> 00:19:21,660
.قبل أن تتسرّب وتهيج

337
00:19:22,470 --> 00:19:28,520
والآن ثمّة عاطِفة تدورُ كدوّامةٍ في سيل
جارِف مُحاولةً تخطِّي الحدّ

338
00:19:34,940 --> 00:19:35,940
...كانَتْ تِلك

339
00:19:36,850 --> 00:19:38,230
الغضب

340
00:19:39,640 --> 00:19:42,720
...عجيب أن أرى مُدرِكاً فوق حسِّي قويّاً مثلك

341
00:19:42,720 --> 00:19:45,200
لهذا لم يؤثّر قناع الابتسامة عليك

342
00:19:45,400 --> 00:19:48,710
قناع؟ كان وراء ذلك خدعة إذاً أيضاً؟

343
00:19:48,710 --> 00:19:51,570
لم أدرِك ذلك حتّى لأنّه كان ضعيفاً جدّاً

344
00:19:52,270 --> 00:19:53,210
على أي حال

345
00:19:53,950 --> 00:19:58,460
،إذا كانت الغاية من دينِك هي قتل الغرباء

346
00:19:59,190 --> 00:20:00,820
فهاجمني بكامل قوّتك

347
00:20:00,820 --> 00:20:03,470
فقد يكون هذا أسهل من حثّي على الضّحك

348
00:20:03,930 --> 00:20:06,150
هاجمني بكامل قوّتك"؟"

349
00:20:10,550 --> 00:20:14,230
!ثانيّتان أكثر من كافيّتَين لإخفائك أيُّها الطفل

350
00:20:17,010 --> 00:20:18,780
!أنتَ مجرّد بهيمة بِلا عواطف

351
00:20:18,780 --> 00:20:21,650
!لا تدّعِ أنّك غاضب فعلاً

352
00:20:25,200 --> 00:20:27,160
ما رأيك أن تبكي الآن؟

353
00:20:30,840 --> 00:20:33,170
هذا خياليّ

354
00:20:38,430 --> 00:20:39,510
ما هذا؟

355
00:20:42,300 --> 00:20:44,380
يا لها من مُفاجأة

356
00:20:46,270 --> 00:20:50,270
...لا أصدّق أنّني سأضطرُّ للقتال بكامل قوّتي

357
00:20:50,890 --> 00:20:55,190
!هذا الطّفل قويّ حقّاً، لكن حانَتْ لحظة موتك

358
00:20:57,540 --> 00:20:58,230
...ما

359
00:20:58,710 --> 00:20:59,980
!ماذا؟

360
00:21:09,240 --> 00:21:11,520
...أ-أنت

361
00:21:11,520 --> 00:21:14,210
لبّيتُ طلبك وخرجت

362
00:21:14,690 --> 00:21:17,360
هذه هي عواطفي

363
00:21:17,360 --> 00:21:19,590
هذا ما يحدثُ إذا كشفتُ عنها

364
00:21:19,970 --> 00:21:22,090
!هـ-هل أنتَ وحشٌ من نوع ما؟

365
00:21:22,840 --> 00:21:23,970
...بغضّ النّظر

366
00:21:23,970 --> 00:21:26,800
!شُعاع ريزر

367
00:21:29,960 --> 00:21:32,200
!نعم! إصابة مباشرة

368
00:21:33,160 --> 00:21:34,950
عدد المعارك التي خضتُها

369
00:21:34,950 --> 00:21:37,920
!هو ما يحدّد الفائز والخاسر هنا

370
00:21:44,760 --> 00:21:48,450
أنا... فظيع

371
00:22:00,340 --> 00:22:02,710
تريدُ أن تكون قادراً على قراءة ما يحيطُ بك أكثر؟

372
00:22:02,710 --> 00:22:06,220
لن تكون قادراً على بلوغ حكمة دنيويّة
عالية المستوى بهذا الشّكل

373
00:22:06,480 --> 00:22:10,010
الأشخاصُ الوحيدون القادرون على فعلِ ذلك
يتمتّعون بحسّ المنطق والخبرة

374
00:22:10,010 --> 00:22:12,520
...ونظراً لافتقارِك للمنطق

375
00:22:13,580 --> 00:22:17,300
لماذا يحزنُك أمرٌ كهذا الآن؟

376
00:22:17,300 --> 00:22:22,170
لأنّني كئيب، أفسدتُ مرحَ مجموعة من النّاس

377
00:22:22,870 --> 00:22:27,180
ولِمَ عليك أن تكون مثلهم؟

378
00:22:27,800 --> 00:22:30,490
أنتَ البطلُ في حياتك

379
00:22:32,600 --> 00:22:36,370
زالَتْ تِلك المجموعة بأكملها بسببي

380
00:22:36,970 --> 00:22:39,030
...كلّ ما كانوا يفعلونه هو الضّحك

381
00:22:39,880 --> 00:22:43,630
إنّ عجزك عن قراءة الجوّ المحيط بك
فتّاك جدّاً

382
00:22:45,630 --> 00:22:48,900
ماذا حدث؟ يمكنُك أن تخبرني بكلّ شيء

383
00:22:50,460 --> 00:22:53,390
...ماذا؟ ما الذي نفعله

384
00:22:53,390 --> 00:22:55,290
إيكوبو-ساما قد أغمي عليه

385
00:22:55,290 --> 00:22:57,410
هل كان شكله هكذا؟

386
00:22:58,320 --> 00:23:02,650
ألم يكن يحاولُ رسم البسمة في وجه فتى
ثمّ عجِزَ عن ذلك؟

387
00:23:03,080 --> 00:23:04,770
من كان ذلك الصبيّ؟

388
00:23:04,770 --> 00:23:05,890
لنبحث عنه

389
00:23:05,890 --> 00:23:08,500
قد يكون المبعوث الحقيقيّ للإله

390
00:23:10,550 --> 00:23:14,410
هكذا إذاً... تحكُّم نمطيّ بالعقل

391
00:23:14,820 --> 00:23:17,910
هذا ليس إنقاذاً، بل كان يجعلهم يعتمِدون عليه فحسب

392
00:23:18,550 --> 00:23:21,840
هذه حيلةٌ مشهورةٌ تُستخدَم على الحالة
النفسيّة لجمهور

393
00:23:21,840 --> 00:23:25,760
لكن بما أنّك أحمق جدّاً، لم تتأثّر بها

394
00:23:27,060 --> 00:23:29,550
معنى هذا يا موب

395
00:23:29,550 --> 00:23:34,860
أنّك صدفَ وأنقذتَ اليوم بعضاً من النّاس
لا يستطيع إنقاذهم سِواك

396
00:23:39,730 --> 00:23:42,270
!شيغي، استيقظ

397
00:23:42,270 --> 00:23:44,100
ستتأخّر

398
00:23:49,050 --> 00:23:52,170
صباح الخير، أليس صباحاً جميلاً يا شريكي؟

399
00:23:56,700 --> 00:24:00,060
يُقحَمُ موب في حدثٍ سخيفٍ يديرُه
أغبياء لأجلِ أغبياء

400
00:24:00,060 --> 00:24:02,890
والشّخص الذي يظهرُ أمامه لاحقاً هو رجلٌ
عنيفٌ ولكن وسيم

401
00:24:02,890 --> 00:24:04,270
!ماذا ستفعلُ يا موب؟

402
00:24:04,270 --> 00:24:06,270
:الحلقة القادمة من موب سايكو 100

403
00:24:06,270 --> 00:24:08,190
"~حدَث للأغبياء فقط ~كين"

404
00:24:08,190 --> 00:24:10,920
!قرص دي في دي؟ هذا قرارٌ ممتاز