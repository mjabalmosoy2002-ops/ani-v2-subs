1
00:00:12,160 --> 00:00:14,490
‫تداعت أركانُ حِمى آلِ تولوي

2
00:00:39,600 --> 00:00:41,300
‫تبخَّرَ أثرُه

3
00:00:43,620 --> 00:00:46,690
‫أخيرًا عثرتُ عليكِ يا بوراكتشين

4
00:00:47,570 --> 00:00:50,200
‫إنهم يعرضون هنالِكَ نفائسَ شتى منَ اليواقيتِ والأحجار

5
00:00:50,500 --> 00:00:51,670
‫فهلمِّ بنا لِـنعاينَ صنيعَها

6
00:00:51,670 --> 00:00:52,720
‫نفائسُ ويواقيتٌ؟

7
00:00:52,720 --> 00:00:56,860
‫أجل، تناهى إليَّ أنَّها حافلةُ تجارٍ قَفَلت راجعةً منَ الغرب

8
00:00:56,860 --> 00:00:57,910
‫هيا بنا

9
00:00:58,260 --> 00:01:03,330
‫أرجو المعذرةَ، فـتلك الحِليُ النفيسةُ لا تليقُ بـمِثلي

10
00:01:05,990 --> 00:01:06,800
‫ها هيَ ذي

11
00:01:07,840 --> 00:01:10,010
‫حسبُنا مُتعةً أن نَتصفَّحَ الديارَ وننظر

12
00:01:16,780 --> 00:01:18,220
‫أسرِعي في خُطاكِ

13
00:01:37,830 --> 00:01:38,660
‫أبصري هاهنا

14
00:01:38,660 --> 00:01:42,000
‫أَتظنينَ هذينِ اللؤلؤتينِ تَصلُحانِ قِرطَين؟

15
00:01:42,390 --> 00:01:44,000
‫إنَّ مِثلَهُما لَـيَليقُ بـبَهاءِ ثغركِ غايةَ اللَّياقة

16
00:01:44,000 --> 00:01:47,000
‫يتعينُ عليكِ أن تنتقي لنفسكِ حِليةً كذلك يا بوراكتشين

17
00:01:47,000 --> 00:01:49,810
‫كلا، مِثلَما صُغتُ قَولاً... لستُ...

18
00:02:01,770 --> 00:02:04,730
‫لو عاينتُ الأمرَ بـبصيرتكِ، لَـمَا أعرتُ هذا الحجرَ بالاً

19
00:02:05,480 --> 00:02:09,780
‫تَسلَّلَ هذا الـحَجرُ الرَّثُّ بينَ نفائسِ اليواقيتِ التي غَنِمناها

20
00:02:09,780 --> 00:02:13,990
‫فهُوَ حَجرٌ جافٍ يَتفتَّتُ ويَتلاشى إذا لامَسَهُ الضَّوء

21
00:02:14,290 --> 00:02:16,260
‫أَيَتفتَّتُ بـملامسةِ الضَّوء؟

22
00:02:18,410 --> 00:02:24,130
‫وَقَعت نَواظري على هذا الـحَجرِ الرَّثِّ بينَ النفائسِ البَرَّاقة

23
00:02:24,130 --> 00:02:26,480
‫فـداخَلَ جَناني افتتانٌ غريبٌ بأسرارِه

24
00:02:27,280 --> 00:02:30,810
‫ومِن هنا... خُطَّت مَلامِحُ البِداية

25
00:04:16,760 --> 00:04:18,620
‫كَساهُ غبارٌ من مَسحوق

26
00:04:22,870 --> 00:04:28,200
‫بَعدَ أيامٍ وجيزةٍ من ملامسةِ شعاعِ الشمس، هذا الحجرُ الصلبُ يُحيلُ لَونَهُ...

27
00:04:29,140 --> 00:04:30,600
‫مَا أغربَ هذا التَّبدّل

28
00:04:34,170 --> 00:04:37,710
‫وحالَ قراءتي في أسرارِهِ، تيقَّنتُ أنَّ هذا الحجرَ يُدعى رَهجَ الغار

29
00:04:37,710 --> 00:04:41,140
‫وأنَّ كَهنةَ الشرقِ يَعُدُّونَهُ ترياقًا نافِعًا

30
00:04:41,980 --> 00:04:46,830
‫فإذا جُرِّعَ بـمِقدارِهِ السَّديد، أبرأَ الخُرّاجَ ورَدَّ لِلفرسانِ نَشاطَ البَدَن

31
00:04:46,830 --> 00:04:47,770
‫بيدَ أَنَّهُ...

32
00:04:48,120 --> 00:04:52,970
‫إذا صُهِرَ بـلهيبِ النار، يَستحيلُ مادَّةً بَيضاءَ تُدعى الزِّرنيخ

33
00:04:54,060 --> 00:04:58,350
‫هو سُمٌّ قاتلٌ يَذوبُ في رُضابِ الماء، بلا طَعمٍ يُدركُهُ لِسانٌ ولا رائِحة

34
00:04:59,440 --> 00:05:02,780
‫هذا الحجرُ الهَشُّ الذي لا يَرقى لِـمنزلةِ الجواهرِ واليواقيت...

35
00:05:03,040 --> 00:05:03,990
‫مَـ...

36
00:05:04,400 --> 00:05:06,190
‫ما أعجَبَهُ من سرٍّ دَفين

37
00:05:07,210 --> 00:05:11,580
‫وفي قابلِ السنين، قَضى "جنكيز خان" نَحبَهُ وفارقَ الديار

38
00:05:12,160 --> 00:05:19,510
‫وأفضينا أنا وموكا، بـصفَتِنا من حَظاياه، لِـقِرانِ رَبيبِنا أوقطاي

39
00:05:20,010 --> 00:05:25,010
‫حتَّى تَبَوَّأتُ مَنزلةَ الخاتونِ الكبرى لأوقطاي

40
00:05:26,870 --> 00:05:28,890
‫أفَلِمَ اصطفاني الخاقانُ صَوبَ جِوارهِ دُونَ غيري؟

41
00:05:29,350 --> 00:05:33,040
‫وخِلتُ أنَّ استخلاصَهُ لِي لا يَعدُو مَقامَ عُمرِي الـمُتقدّم

42
00:05:33,580 --> 00:05:34,560
‫بيدَ أَنَّهُ...

43
00:05:34,560 --> 00:05:38,150
‫حجرُ يَتداعى ويَتلاشى بـملامسةِ النُّور؟

44
00:05:38,150 --> 00:05:39,860
‫لا تُعِرهُ اهتمامًا

45
00:05:39,860 --> 00:05:41,550
‫فمَا هُوَ إلا فُضولٌ عابرٌ ومَسعى لَـهوٍ منِّي

46
00:05:42,740 --> 00:05:45,820
‫يَظهرُ بـأنَّ فُضولَكِ هذا يَفوقُ حُدودَ تَقديري

47
00:05:46,170 --> 00:05:50,080
‫غيرَ أنِّي أَنَستُ بـمَعرفةِ مَرامِ شَغفِكِ الرَّقيق

48
00:05:50,940 --> 00:05:53,540
‫فأَفصِحي لي إن تاقت نَفسُكِ لِـحَوزِ أحجارٍ أخرى

49
00:05:53,540 --> 00:05:54,980
‫وسأَذودُ بـِهِ قُربانًا بينَ يَديكِ صَوبَ سُرادِقِكِ

50
00:05:54,980 --> 00:05:59,210
‫سأفعلُ بلا ريب، غيرَ أنِّي أَتساءلُ... أَلِمَ كُلُّ هذا الـتَّبجيلِ لي؟

51
00:06:02,090 --> 00:06:03,970
‫الشَّغفُ والوَلَهُ بـحَوزِ الأشياء

52
00:06:04,790 --> 00:06:07,600
‫إنَّ هذا الشَّوقَ لَـهُوَ الـمُحرِّكُ الأكبرُ لـمَسارِ الوجود

53
00:06:11,830 --> 00:06:17,690
‫يُراوِدُني طَيفُ حلمٍ بـأن تتبدَّى هذهِ السُّهوبُ حَاضِرةً تِجاريةً تصلُ المشرقَ بالـمغرب

54
00:06:18,160 --> 00:06:23,200
‫يَسيرُ في مَسالِكِها عُمَّارُ المشرقِ والمغربِ قاطبةً لِـطلبِ التِّجارة

55
00:06:24,150 --> 00:06:27,640
‫فلا نَعودُ نلوذُ بـامتِطاءِ السِّرجِ طَمَعًا في قِراعِ الحروبِ والنَّهب

56
00:06:27,640 --> 00:06:30,300
‫وتَجتَمِعُ في رِحابِنا الرِّعايا وتتراكمُ البَضائعُ طَوعًا وعَفوًا

57
00:06:34,350 --> 00:06:37,380
‫يَسُرُّني حَوزُ مَزيدٍ منَ الأحجار، غيرَ أنَّ مَسعايَ يَتوقُ للـكُتُبِ والأسفارِ الساعة

58
00:06:37,910 --> 00:06:41,090
‫فـأنبضُ بـشَغفٍ كبِيرٍ في سَبرِ أغوارِ طبائعِ هذهِ الأحجارِ العلميّة

59
00:06:41,510 --> 00:06:42,800
‫لِيَكن كذلِك

60
00:06:43,760 --> 00:06:47,690
‫يَسُرُّ جَناني أنَّ الأيامَ حَكَمَت بـأن تَصيري خاتوني الكبرى

61
00:06:48,800 --> 00:06:53,150
‫فلا ريبَ أنَّ تولوي وسائرَ رِفاقِهِ يَعجزُون تَمامًا عن فَهمِ مَرَامي

62
00:06:53,520 --> 00:06:58,040
‫ولأجلِ هذا... أَتوقُ لِـوجودِ عقلٍ فطنٍ مِثلكِ يَقِفُ بجواري لِـيَفقهَ هذا

63
00:07:04,700 --> 00:07:08,700
‫إنَّ مَنعةَ آلِ تولوي ستَشلُّ بـقوّتِها حرِّيةَ تَصرُّفِ الخاقانِ الأعظم

64
00:07:09,120 --> 00:07:11,610
‫أَفلا يَقبعُ في هذا الوجودِ مَخرجٌ لِـتقويمِ هذا المآل؟

65
00:07:13,110 --> 00:07:16,810
‫الخاتونُ الكبرى بوراكتشين، حَكيمُكِ الجَديدُ بالبابِ لِلقائِكِ

66
00:07:17,540 --> 00:07:18,840
‫وحَلَّتِ الخاتونُ موكا بـالديارِ كذلِك

67
00:07:18,840 --> 00:07:20,290
‫مَرحبًا

68
00:07:21,260 --> 00:07:23,060
‫يا لَلعَجَب

69
00:07:23,060 --> 00:07:27,710
‫يَروقُ لي حَوزُ الأحجارِ التي تَتحدَّرُ صِفاتُها وأشكالُها تحتَ وَهجِ الحرارةِ والنُّور

70
00:07:28,220 --> 00:07:33,140
‫ولا ريبَ أنَّ نطاسيينَ مِثلكَ منَ المشرقِ ذوو دِرايةٍ بأسرارِها، أأصبتُ القول؟

71
00:07:33,140 --> 00:07:34,540
‫أجل

72
00:07:43,320 --> 00:07:47,880
‫في سالفِ العصور، شاعَ مَعتقدٌ طاويٌّ يُسمى "الوايدان"

73
00:07:47,880 --> 00:07:49,280
‫الوايدان؟

74
00:07:49,280 --> 00:07:53,500
‫إذ يَعمدونَ لِـصهرِ أحجارٍ مِثلَ تلكَ التي بحَوزتكِ بالحرارةِ أو المَاء

75
00:07:53,500 --> 00:07:56,210
‫رغبةً في صياغةِ إكسيرِ الخلودِ والبقاء

76
00:07:56,210 --> 00:08:00,890
‫غيرَ أنَّ أدنى خَطأٍ في الصَّنعةِ والتركيبِ يُحيلُهُ سُمًّا قاتِلًا

77
00:08:01,210 --> 00:08:06,030
‫وآونةَ إذٍ... بَدأَت خيوطُ مَكيدةٍ تُحاكُ في أعماقِ جَناني

78
00:08:14,150 --> 00:08:17,790
‫أفضى إليَّ ذلكَ الحكيمُ بـأنِّي إن عَمَدتُ لِـصَهرِ هذا المَسحوق

79
00:08:17,790 --> 00:08:20,750
‫لَـتَولَّدَ منهُ الزِّرنيخ، وهوَ سُمٌّ قاتلٌ بمقاديرَ مَحدودة

80
00:08:23,900 --> 00:08:27,870
‫أما بـِصورتِهِ البِكرِ كرَهجِ الغار، فـما كانَ لَـهُ أن يَقضيَ على روحِ بَشر

81
00:08:28,560 --> 00:08:32,060
‫خِلافًا لِـلزرنيخ، فـرَهجُ الغارِ يَعجزُ عنِ الذَّوبانِ في رُضابِ الماء

82
00:08:32,620 --> 00:08:35,040
‫حَجرٌ دَميمٌ جافٍ في كُلِّ شأن

83
00:08:36,300 --> 00:08:38,850
‫لَعَلَّهُ يحاكي تَمامًا طينتي ورَسمي

84
00:08:53,720 --> 00:08:57,700
‫إذن... فـهذا هُوَ المِقدارُ الكافي لِـبلوغِ الفَناء

85
00:08:57,700 --> 00:08:59,850
‫والآن... فمَا تَبقَّى هوَ...

86
00:09:00,230 --> 00:09:02,170
‫طريقةُ إبراءِ هذا البَلاء

87
00:09:02,990 --> 00:09:07,660
‫يَتلاشى سُمُّ رَهجِ الغارِ منَ البَدَن بعدَ ثلاثةِ أشهُرٍ منَ النَّقاهة

88
00:09:08,020 --> 00:09:12,360
‫أَفلا يَقبعُ في الوجودِ ترياقٌ أسرعُ وأَبعدُ أثرًا؟

89
00:09:12,360 --> 00:09:14,700
‫مَسعى علاجٍ يُحاكي المعجزاتِ في أعينِ المَلأ

90
00:09:15,790 --> 00:09:20,130
‫وآونةَ إذٍ... وَقَعت عينايَ على تلكَ الفتاة

91
00:09:32,800 --> 00:09:34,200
‫ما الصَّنيع؟

92
00:09:34,620 --> 00:09:39,570
‫فأيُّ زَلَّةِ قَدَمٍ واحدة، ستَعصفُ بـحَياةِ الخاقانِ الأعظمِ حتمًا

93
00:09:50,460 --> 00:09:54,990
‫أَفلا نَستخيرُ "تنغري" في عاقبةِ مصيرِنا جَميعًا؟

94
00:09:58,080 --> 00:10:01,200
‫سأعقدُ طقوسَ كَهانة، فـلتُرافق خُطايَ إحداكنّ

95
00:10:10,790 --> 00:10:12,300
‫هذا الموضعُ يفي بـالغَرَض

96
00:10:18,840 --> 00:10:20,520
‫أَكُلُّ أمرٍ جاهزٌ الساعة؟

97
00:10:20,520 --> 00:10:21,870
‫الأمرُ هو أنَّ...

98
00:10:21,870 --> 00:10:25,060
‫طقوسُ الكَهانةِ تفرِضُ حَشرَ عظامِ الغَنَم، ويَعوزُنا المَقاديرُ منها الساعة

99
00:10:25,060 --> 00:10:27,520
‫ما عُقدَ لهيبُ هذه النارِ لِـصهرِ العظام

100
00:10:30,540 --> 00:10:31,780
‫أرعِينَني أسماعَكنَّ جيّدًا

101
00:10:31,780 --> 00:10:33,950
‫غَطِّينَ أنوفَكُنَّ وأفواهَكُنَّ بِقُماش

102
00:10:33,950 --> 00:10:35,980
‫ولا تَقِفنَ في مَهَبِّ الرّيحِ مِنَ النّار

103
00:10:38,820 --> 00:10:41,700
‫ماذا تصنعين؟ دَثِّري وجهَكِ فورًا

104
00:10:41,700 --> 00:10:42,950
‫حَـ-حسنًا يا سيدتي

105
00:10:51,780 --> 00:10:55,090
‫أَيَستحيلُ المَسحوقُ الأحمرُ بياضًا في اللهيب؟

106
00:10:57,020 --> 00:10:58,050
‫تلك تباشيرُ خَيرٍ وبَرَكة

107
00:11:00,660 --> 00:11:04,960
‫وبالفعل... جرى الأمرُ كُلُّهُ وِفقَ ما نَسجتُ من خُطط

108
00:11:18,100 --> 00:11:20,320
‫تمامًا مِثلَما خَطَّطت

109
00:11:20,910 --> 00:11:22,160
‫بوراكتشين

110
00:11:23,320 --> 00:11:25,250
‫حلَّ الخاقانُ الأعظمُ الساعةَ بالديار

111
00:11:27,280 --> 00:11:29,380
‫أرعيني سمعكِ يا بوراكتشين

112
00:11:29,380 --> 00:11:32,000
‫أَتَذكرينَ مَقَالَكِ الذي أفضيتِ بهِ إليَّ؟

113
00:11:32,390 --> 00:11:37,880
‫حمايةً لِـجَمعِ المغولِ منَ التشتت، ولِإبقاءِ عُرى الائتلافِ بينَ القلوب...

114
00:11:37,880 --> 00:11:40,000
‫أفضيتِ بـأنَّهُ يتعينُ عليَّ السعيُ في ركابِ هذا الأمرِ نيابةً عنكِ

115
00:11:41,190 --> 00:11:44,220
‫أفَخَابَ سَعيي في حِفظِ هذا العهد؟

116
00:11:46,500 --> 00:11:49,620
‫يا موكا... كَتَبَت السَّماءُ طينتكِ على عهدِ النقاءِ كَما أنتِ

117
00:11:49,620 --> 00:11:51,970
‫نقِيَّةُ السريرةِ وحَبيبةُ الرعيةِ كعَهدِكِ دَومًا

118
00:11:52,460 --> 00:11:53,940
‫ماذا تَعنين بـهذا؟

119
00:11:54,800 --> 00:11:56,920
‫لا يَشغَلَنَّ بالَكِ قلقُ الغَد

120
00:11:59,350 --> 00:12:02,450
‫طالما كانَ هذا مَثوى صِياغةِ قَولكِ يا بوراكتشين

121
00:12:06,330 --> 00:12:07,500
‫موكا...

122
00:12:07,930 --> 00:12:10,770
‫فمَا لَكِ شأنٌ يُذكرُ بـِغياهبِ هذهِ المَكيدة

123
00:12:11,120 --> 00:12:15,540
‫لَـهوَ رِهانٌ خُضتُهُ بمفردي، وسأتحمَّلُ عاقبتَهُ دُونَ سِواي

124
00:12:20,750 --> 00:12:23,450
‫أعتذرُ عن إطالةِ انتظارِك يا مَولاي الخاقان

125
00:12:24,060 --> 00:12:26,100
‫مَا الخَطبُ الذي تَرغَبينَ بـبَسطِهِ أمامي؟

126
00:12:26,100 --> 00:12:28,730
‫أجل، ففي جُعبتي طرحٌ أَعرضُهُ علَيكَ الساعة

127
00:12:29,000 --> 00:12:33,480
‫يَتعلّقُ الأمرُ بـأرملةِ الأميرِ تولوي، الخاتونِ سورغاغتاني بيكي

128
00:12:34,600 --> 00:12:35,830
‫انصرفي عنَّا الساعة

129
00:12:35,830 --> 00:12:36,690
‫أرفضُ هذا

130
00:12:36,690 --> 00:12:38,450
‫كُفِّي عنِ العِنادِ وتَوارَي عَنِ الأَعين

131
00:12:38,450 --> 00:12:40,800
‫أرفضُ هذا... وأستأذنُكِ بالبقاء

132
00:12:41,530 --> 00:12:46,100
‫أُدركُ رغبتكِ لِإنقاذِ الخاتونِ توراكينا، غيرَ أنَّ مَسعاكِ اليومَ يَعتريهِ العجز

133
00:12:46,100 --> 00:12:47,480
‫كلا...

134
00:12:49,740 --> 00:12:50,790
‫مهلًا

135
00:12:50,790 --> 00:12:52,180
‫الأميرُ كيوك

136
00:12:52,180 --> 00:12:56,170
‫إنَّ والِدتَكَ الخاتونَ لَـهيَ رَبَّةُ نِعمتي الـمُعَزَّزةُ كذلِك

137
00:12:56,170 --> 00:12:58,510
‫أَسألكَ بـسَماحةِ نَفسِكَ، إن تناهى لـعِلمِكَ خَبَرٌ أن تُنبئني بهِ...

138
00:12:59,530 --> 00:13:00,430
‫أصغي إليّ

139
00:13:02,220 --> 00:13:03,260
‫ثمةَ حَشرجةُ قَدَمٍ تَقتربُ هاهنا

140
00:13:05,670 --> 00:13:06,720
‫اسمَعي

141
00:13:07,720 --> 00:13:11,260
‫تلكَ المرأةُ هيَ جاريةُ الخاتونِ الكبرى بوراكتشين

142
00:13:11,260 --> 00:13:14,190
‫يَتوجبُ ألا تَلحظَ وجودَنا هاهنا بـأيِّ سَبيل

143
00:13:14,190 --> 00:13:15,270
‫فمَا العملُ إذن؟

144
00:13:15,530 --> 00:13:17,090
‫هذا هو مَوطنُ الحَيرَة

145
00:13:18,900 --> 00:13:20,900
‫حلَّتِ الرِّكاب، حلَّتِ الرِّكاب

146
00:13:41,500 --> 00:13:43,740
‫طابَ يَومُكَ أيُّها الأميرُ كيوك

147
00:13:44,190 --> 00:13:45,430
‫وطابَ يَومُكَ يا سَيِّدَ قاداق

148
00:13:45,790 --> 00:13:48,700
‫أَتَعلو الصحةُ والعافيةُ الخاتونَ توراكينا في مَحبسِها؟

149
00:13:48,700 --> 00:13:49,860
‫أجل، لا ريبَ في ذلِك

150
00:13:49,860 --> 00:13:53,140
‫بَل قَفلتُ إليكم لِأُبشِّرَكم بـصدورِ العفوِ وقُربِ إطلاقِ سَراحِها

151
00:13:58,510 --> 00:14:00,360
‫مَعذِرةً، تَفَضَّلي

152
00:14:01,000 --> 00:14:01,820
‫أجل

153
00:14:01,820 --> 00:14:04,700
‫بيدَ أنَّ لِـهذا الصَّفحِ شُروطًا يَتوجبُ رِعايتُها

154
00:14:05,050 --> 00:14:05,990
‫شُروطٌ؟

155
00:14:05,990 --> 00:14:09,080
‫بَدءًا... يَتبيَّنُ أنَّ الخاتونَ توراكينا يَرسفُ جسدُها في عظيمِ النَّصَبِ والإعياء

156
00:14:09,390 --> 00:14:13,330
‫وعليها المكوثُ بـسكينةٍ في دِيارِ الأميرِ كيوك صَوبَ السهوبِ منذُ الساعة

157
00:14:13,330 --> 00:14:15,790
‫أَفلا يَبغونَ عَودةَ رِكابِها صَوبَ ديوانِ الخاقانِ الأعظم إذن؟

158
00:14:16,140 --> 00:14:18,010
‫وعلاوةً على ذلك... ثمةَ شَرطٌ أخير

159
00:14:18,010 --> 00:14:24,180
‫يَتوجبُ قِرانُ الأميرِ كيوك بـأرملةِ الأميرِ تولوي، الخاتونِ سورغاغتاني

160
00:14:29,780 --> 00:14:32,070
‫أَحطنا بـشروطِكم عِلمًا

161
00:14:32,070 --> 00:14:34,350
‫فأَمهِلونا فُسحةً لِـتدبُّرِ الأمرِ بكُلِّ مآلَاتِه

162
00:14:35,500 --> 00:14:40,170
‫تَدَبَّروا الموقفَ بـفِطنة، لِـما فيهِ صَلاحُ مَستقبلِ جَمعِ المغول

163
00:14:41,320 --> 00:14:43,090
‫والآن، أستأذنُ مَقامَكم في الانصراف

164
00:14:48,740 --> 00:14:50,240
‫جُزيت خيرًا على جَمالِ صَبرك المتين

165
00:14:51,130 --> 00:14:51,830
‫المعذرة...

166
00:14:52,970 --> 00:14:54,660
‫بِـخصوصِ ما جادَ بهِ لِسانُ الجاريةِ قُبيلَ قليل...

167
00:14:59,740 --> 00:15:04,090
‫صَفوةُ القول... أنَّ هذا المآلَ كُلَّهُ مَنسوجٌ من مَكيدةِ الخاتونِ الكبرى

168
00:15:04,350 --> 00:15:07,280
‫ومَرمَاها هوَ دَحرُ مَنعةِ آلِ تولوي وكَبحُ نُفوذِهم

169
00:15:07,280 --> 00:15:10,220
‫لِـيَنفردَ الخاقانُ الأعظمُ بـمَقاليدِ السُّلطةِ وحدَه

170
00:15:11,190 --> 00:15:14,940
‫ولبُلوغِ هذا المَرَم، لَم تَكتفِ بـمَصرعِ الأميرِ تولوي فحسب

171
00:15:14,940 --> 00:15:18,850
‫بل صَاغَتِ الموقفَ كأنَّهُ جادَ بـروحِهِ فِداءً لِـحياةِ الخاقانِ الأعظم

172
00:15:20,360 --> 00:15:23,070
‫أَيَعني هذا أنَّ كربَ سَقَمِ الخاقانِ الأعظم...

173
00:15:23,070 --> 00:15:24,100
‫أجل

174
00:15:24,100 --> 00:15:27,260
‫تَوسَّلت بالـخاتونِ توراكينا في مَكيدتِها لِـتُجرِّعَهُ السُّمَّ بـخفاء

175
00:15:27,260 --> 00:15:28,780
‫بـسُمٍّ لا يُهلكُ الروحَ بل يُعجزُ البدن

176
00:15:28,780 --> 00:15:30,440
‫رَهجُ الغار

177
00:15:30,820 --> 00:15:34,160
‫إذن... فـلهذا تَجرَّعت السُّمَّ بـمَحضِ إرادَتِها لِـرَسمِ مَكيدتِها

178
00:15:36,120 --> 00:15:39,220
‫تَسوسُ عِلمَ الخيمياءِ لتتحكَّمَ بـأقدارِ البَشرِ بينَ الموتِ والحياة...

179
00:15:40,550 --> 00:15:42,020
‫وكأنَّها "ساحرةٌ" عاتية...

180
00:15:43,720 --> 00:15:47,050
‫بل زَجَّت بالأميرِ كيوك صَوبَ أطرافِ هذهِ المَكيدة

181
00:15:47,050 --> 00:15:48,970
‫لتَقضِيَ بـإرغامهِ على القِرانِ منَ الخاتونِ سورغاغتاني

182
00:15:48,970 --> 00:15:50,680
‫أَمِن مَوضعٍ لِـسخطٍ أو اعتراضٍ بعدَ هذا؟

183
00:15:50,680 --> 00:15:53,640
‫فبـهذا السَّبيلِ يُمكِنُ نَجاةُ الخاتونِ توراكينا وفكُّ مَحبسِها

184
00:15:56,870 --> 00:15:59,390
‫أصبتَ... ففي هذا تَسييرٌ لِـمصالِحِنا المكتومة

185
00:16:00,200 --> 00:16:01,560
‫بِـ-بيدَ أنَّ...

186
00:16:02,100 --> 00:16:03,320
‫الأميرُ كيوك

187
00:16:03,660 --> 00:16:06,600
‫أصنع مَعروفًا يا أمير، وساهِم في نَجاةِ الخاتونِ توراكينا

188
00:16:06,600 --> 00:16:07,450
‫أتَوَسَّلُ إلَيك

189
00:16:15,080 --> 00:16:16,400
‫سأفعلُ ذلِك

190
00:16:21,000 --> 00:16:24,520
‫رافقتكمُ السلامة، سأقفلُ راجعًا صَوبَ ديارِ الخاتونِ سورغاغتاني

191
00:16:24,520 --> 00:16:25,710
‫تريّث يا شيرا

192
00:16:26,000 --> 00:16:28,560
‫اكتُم كلَّ خَبَرٍ تناهى لـسَمعِكَ هاهنا واجعلهُ دَفينًا

193
00:16:29,680 --> 00:16:31,000
‫سأصونُ عهدَ هذا الكتمان

194
00:16:31,990 --> 00:16:33,560
‫آمُلُ ذلِكَ حَقًّا

195
00:16:33,560 --> 00:16:35,210
‫أَولستِ الساعةَ هادئةَ الجنانِ والبالِ يا فاطمة؟

196
00:16:36,600 --> 00:16:39,020
‫أَرى أنَّ سبيلَ النَّصرِ شُرِّعَ أمامكِ لِـإنقاذِ مَن أرَدتِ إنقاذَها
‫

197
00:16:39,830 --> 00:16:40,610
‫أجل

198
00:16:43,340 --> 00:16:44,820
‫لكَ منِّي خالصُ الودِّ والشكرِ يا شيرا

199
00:16:44,820 --> 00:16:46,940
‫فقد لَـمحتُ في مَعيتِكَ غايةَ الأنسِ والطمأنينة

200
00:16:47,330 --> 00:16:49,650
‫أَ-أجل، سُررتُ بـسماعِ قَولكِ هذا

201
00:16:51,700 --> 00:16:54,240
‫حَفِظَكَ الله

202
00:16:54,560 --> 00:16:56,150
‫واحرِص على صَونِ هذا العهدِ دَومًا

203
00:16:56,150 --> 00:16:57,560
‫أجل، سأصونُه

204
00:17:02,630 --> 00:17:04,090
‫مَاذا تَقصدين؟

205
00:17:04,090 --> 00:17:06,210
‫أُ-أُمَّاه؟ تتزوّجُ كيوك؟

206
00:17:06,210 --> 00:17:07,300
‫لا يَقبلُ عَقلي مِثلَ هذا الهَذيان

207
00:17:07,550 --> 00:17:10,980
‫أجل، هذا الخَبَرُ تناهى لـسَمعي من جاريةِ الخاتونِ الكبرى بوراكتشين

208
00:17:10,980 --> 00:17:14,020
‫يَرتسمُ للعيانِ أنَّ آلَ أوقطاي طَرَحوا كُلَّ مَواربَةٍ وتستُّر

209
00:17:14,020 --> 00:17:17,820
‫وعلاوةً على ذلِك، فـمَا لِـنجلِ الخاتونِ السادسةِ الوضيعِ شرفٌ يُقرّبُهُ لِقِرانِها البتَّة

210
00:17:17,820 --> 00:17:20,850
‫بيدَ أنَّ الخاتونَ الكبرى بوراكتشين قَضت بـهذهِ المَشيئة

211
00:17:24,180 --> 00:17:25,320
‫فَهِمت

212
00:17:25,320 --> 00:17:28,030
‫يا أُمَّاه... لستِ بـمُجيبَةٍ مَسعى الخاتونِ الكبرى لِـهذا العهدِ الشنيع؟

213
00:17:28,500 --> 00:17:31,570
‫إني لَأَعجزُ عن نِداءِ كيوك بـأُبوّتِه

214
00:17:33,510 --> 00:17:35,960
‫أُمَّاه... يا أُمَّاه...

215
00:17:35,960 --> 00:17:38,510
‫أُ-أُ-أُمَّاه

216
00:17:38,510 --> 00:17:40,500
‫يَظهرُ بـأنَّ الخاتونَ سَلِمَت لِلأسى بالكامل

217
00:17:41,210 --> 00:17:44,820
‫لعلَّ الصوابَ يَقضي بـأن أُفشيَ لها بـهويةِ الفاعلِ الذي فتكَ بالأميرِ تولوي

218
00:17:46,500 --> 00:17:49,670
‫ما خَلصتُ يومًا بـأنَّ الخاتونَ سورغاغتاني تَقبلُ بـأُعروةِ قِرانٍ مِثلِ هذهِ ثانيةً

219
00:17:50,720 --> 00:17:54,510
‫سَيتوطَّدُ الحِلفُ والائتلافُ بينَ الخاقانِ الأعظمِ وآلِ تولوي بـبهاءٍ في قابلِ الأيام

220
00:17:55,050 --> 00:17:58,350
‫أوشكتُ على إيفادِ جاريةٍ رَسولةٍ صَوبَ ديارِ سورغاغتاني

221
00:17:59,520 --> 00:18:02,810
‫فاجعَلي هذا الشَّرَفَ مَوئلاً لِـجاريتِكِ إذن يا خاتون

222
00:18:03,370 --> 00:18:04,780
‫أَنتِ؟

223
00:18:04,780 --> 00:18:05,520
‫أجل

224
00:18:06,070 --> 00:18:11,770
‫فقد جُدتِ عليَّ بـسِفرِ الأصولِ الذي تاقَت إليهِ نفسي دَومًا كـسليلةِ حُكماء

225
00:18:12,250 --> 00:18:14,610
‫وأنا أَتوقُ لِـرَدِّ صنيعِ جُودِكِ إحسانًا

226
00:18:14,610 --> 00:18:15,680
‫أحقًّا ما تَنوين؟

227
00:18:15,680 --> 00:18:18,400
‫فبي مَعرفةٌ بليغةٌ بـطِباعِ الخاتونِ سورغاغتاني

228
00:18:18,400 --> 00:18:20,760
‫إني لَأرى سبيلاً لِإقناعِها وحَوزِ رِضاها لا مَحالة

229
00:18:21,400 --> 00:18:24,080
‫فهمتُ المَقصد، لَـهذا حَديثٌ يَسترعي الاهتمامَ والفضول

230
00:18:30,940 --> 00:18:33,720
‫طَوَتِ الأيامُ ثلاثَ حِجَجٍ منذُ آخِرِ لِقاءٍ بينَنا

231
00:18:33,720 --> 00:18:37,260
‫هذا هو دَوري بوَصفِ القِرانِ الذي ستَصيرُ مَعهُ خاتونًا ذاتَ يوم

232
00:18:38,240 --> 00:18:40,880
‫الخاتونُ سورغاغتاني جَليلةُ الشأن، يَعصفُ بها الأَسَى لِتؤولَ لـِمثلِ هذا الحال

233
00:18:41,360 --> 00:18:44,250
‫أَوكيفَ تَنظرُ لِـوجهي وِصَالاً حينَ يَقَعُ لِقاءُ عينيها بـمحيَّاي؟

234
00:18:44,580 --> 00:18:47,490
‫أَسَيَعصفُ بها الغضبُ لِـذنبٍ تَعلمُه؟ أَم تَنهَرُني وتَزجُرُ إيفادَ جَسدي؟

235
00:18:48,700 --> 00:18:50,380
‫لا بأسَ بـذاكِ عندي على كُلِّ حال

236
00:18:51,050 --> 00:18:56,020
‫فإنَّ السَّخَطَ والغضبَ المعتملِ في صدري تِجاهَها لأشدُّ اضطِرامًا وعُتوًّا

237
00:18:57,990 --> 00:18:59,400
‫أستأذنُ مَقامَكِ للولوج...

238
00:19:00,520 --> 00:19:04,000
‫فاطمة؟ تُرى... كم طَوَتِ الأيامُ من حِجَجٍ منذُ تداولِنا الأخير؟

239
00:19:04,000 --> 00:19:07,730
‫أجل، مِثلَما أفضيتِ قولاً... يا الخاتون سورغاغتاني

240
00:19:07,730 --> 00:19:10,710
‫أرجو المعذرةَ على قساوةِ هَجرِي وانقطاعِ رِكابي...

241
00:19:15,440 --> 00:19:18,810
‫أفضى إليَّ شيرا بـأنَّ الخاتونَ سَلِمَت لِلأسى المُرِّ واليأس

242
00:19:22,240 --> 00:19:24,980
‫إني أوفدتُ اليومَ رَسولةً عنِ الخاتونِ الكبرى بوراكتشين صَوبَ ديارِكِ

243
00:19:26,080 --> 00:19:30,440
‫وأبسطُ عُذري لعجزي عن صَونِ حِمى الأميرِ تولوي ويَجيرِه منَ الحَتف

244
00:19:30,440 --> 00:19:31,980
‫لا تُعيري الأمرَ بالاً بعدَ الآن

245
00:19:37,230 --> 00:19:39,080
‫فهلّا كحّلتِ ناظريكِ بـرؤيةِ هذا مِعوانًا؟

246
00:19:39,740 --> 00:19:41,780
‫إنَّها هِبةٌ ملوكيةٌ من عزمِ الخاتونِ الكبرى بوراكتشين

247
00:19:43,200 --> 00:19:48,060
‫وإبَّانَ كَلِمي هذا، يتوجبُ مكاتبَتُكِ في شأنٍ بالِغِ الأهَميَّة والجسامة

248
00:19:48,540 --> 00:19:50,580
‫وتِلكَ النازِلةُ التي أبتغي تداولَ خَبَرِها معِكِ...

249
00:19:51,090 --> 00:19:53,050
‫أرجو ألاّ يَتسربَ الفَزَعُ والذُّعرُ لـجَنانِكِ عِندَ سَمَاعِها

250
00:19:53,370 --> 00:19:56,580
‫تَقضي مَشيئةُ الخاتونِ الكبرى بـإتمامِ قِرانِكِ منَ الأميرِ كيوك...

251
00:19:56,580 --> 00:19:58,540
‫سأبذلُ لَـها السَّمعَ والطَّاعةَ في مَشيئتِها

252
00:20:00,430 --> 00:20:03,640
‫إن تَبَدَّى في هذا الصنيعِ صَلاحُ شأنِ مَعشرِ المغول

253
00:20:04,030 --> 00:20:07,100
‫فاحكموا في مَصيري بـما تشاؤون

254
00:20:07,980 --> 00:20:10,480
‫أَيُعقلُ أنَّكِ جادَّةٌ في مَسعاكِ هكذا؟

255
00:20:13,530 --> 00:20:15,240
‫أنتِ...

256
00:20:15,240 --> 00:20:18,410
‫أنتِ... يا مَن سَلَبَتِ الأيامُ بـسَببِكِ منِّي كُلَّ مَتاعٍ دُنيوي

257
00:20:28,140 --> 00:20:30,420
‫أنتِ جليلةُ الكبرياءِ والمَنعة...

258
00:20:31,080 --> 00:20:34,720
‫أَخَمَدَ سَعيرُ الأملِ المشتعلِ في جَنَانكِ بـمَصرعِ مَن تعلَّقَ بهِ قلبُكِ؟

259
00:20:42,190 --> 00:20:43,480
‫أَمِن مَكروهٍ يُقلقكِ؟

260
00:20:44,630 --> 00:20:45,890
‫إني لَأُعجَبُ بـرَجاحِ عَقلِكِ وصَوابِ فِطنتِكِ

261
00:20:48,850 --> 00:20:50,940
‫فمَا حَسبي إلا الارتسامُ بـالبسمةِ كما أَعهَدُ نَفسي دَومًا

262
00:20:50,940 --> 00:20:52,830
‫مثلَما أصنعُ في عيشي دَومًا

263
00:20:56,440 --> 00:20:58,570
‫ما عادَ هاهنا أحدٌ يَعوزُهُ الـعَزمُ لِـذَودِ السُّوءِ عَنكِ

264
00:21:03,690 --> 00:21:07,790
‫إِ-إن أردتِ كَبحَ مَطامِحِ عقلِكِ والاستسلامَ الـخاضعَ لِـمَشيئتِها، فالأمرُ لَكِ

265
00:21:11,620 --> 00:21:15,490
‫غيرَ أنِّي... وإن فارقني جَميعُ من تَعَلَّقَ بـهم الفؤادُ مَحبة...

266
00:21:16,320 --> 00:21:17,960
‫فلن تَعصفُ الأقدارُ بـشَغفِ الأملِ في صدري أبدًا

267
00:21:20,150 --> 00:21:21,760
‫فكُفِّي عَنِ النَّحيبِ والـحَسرةِ يا خاتون

268
00:21:22,200 --> 00:21:24,860
‫إذ سأَبقى أُعمِلُ عَقلي وبَصيرتي دونَ خُنوع

269
00:21:33,900 --> 00:21:36,300
‫والآن... فـلنخُض في مَكنونِ تداولِنا لهذا اليوم

270
00:21:36,300 --> 00:21:39,940
‫قِرانُ الخاتونِ سورغاغتاني ثانيةً منَ الأميرِ كيوك

271
00:21:40,250 --> 00:21:43,640
‫أفضت الخاتونُ سورغاغتاني بيكي بـكاملِ رِضاها عِندَئذ

272
00:21:44,070 --> 00:21:46,660
‫أعِندَكَ اعتراضٌ أو سَخَطٌ على ذلِك يا أميرُ كيوك؟

273
00:21:53,560 --> 00:21:58,800
‫أَرجو أَن يَصوغَ هذا القِرانُ عُروَةً وثيقةً تَصلُ بينَ آلِ أوقطاي وآلِ تولوي

274
00:21:59,510 --> 00:22:01,130
‫إنَّ هذا لَـصنيعٌ يَبعثُ الأنسَ والسرورَ في جَناني

275
00:22:09,070 --> 00:22:13,480
‫أدركتُ جَهلَ مَسعايَ وسفاهتي يومَ تجاسرتُ بـمِثلِ هذا الحديثِ أمامَ الخاتونِ سورغاغتاني

276
00:22:14,160 --> 00:22:17,480
‫وعلى كُلٍّ... فالحقيقةُ أنَّ رِكابَ كِلتينا لن يَجتَمِعَ مجددًا بـأيِّ سَبيل

277
00:22:36,580 --> 00:22:39,910
‫وأخيرًا... يَتحددُ مَوعدُ قِرانِ الخاتونِ بالـموضعِ—

278
00:22:39,910 --> 00:22:41,290
‫تريَّثوا جَميعًا

279
00:22:45,690 --> 00:22:49,060
‫ما عادَ بـنا حاجةٌ لِـمثلِ هذهِ التحضيرات

280
00:22:49,060 --> 00:22:51,100
‫الـ-الخاتونُ سورغاغتاني؟

281
00:22:51,100 --> 00:22:52,100
‫أَلا حاجةَ لَها؟

282
00:22:52,100 --> 00:22:54,100
‫مَا مَغزى قَولِها الغريبِ هذا؟

283
00:22:59,100 --> 00:23:00,530
‫تولوي...

284
00:23:01,200 --> 00:23:04,990
‫عاينتُ الساعةَ ولأولِ مرّة مرارةَ الفراقِ لـمَن يتشبَّثُ بهِ جَناني

285
00:23:09,980 --> 00:23:11,890
‫ومَعنى أَن يَبيدَ سَعيرُ الأملِ بـصَدري بالكامل

286
00:23:15,440 --> 00:23:17,410
‫تولوي...

287
00:23:19,240 --> 00:23:21,450
‫أَتُراها جَرَّعتِ السُّمَّ الحزينَ ذاتَهُ كَمَدًا؟

288
00:23:23,690 --> 00:23:28,220
‫أَبسطُ معذرَتي بينَ يدي الخاقانِ الأعظم، والخاتونِ الكبرى

289
00:23:28,800 --> 00:23:33,060
‫فإنَّ جَناني يَقضي بـرَفضِ أُعروةِ هذا القِرانِ في خاتمةِ المآل

290
00:23:38,460 --> 00:23:42,120
‫في الحَلقةِ القادِمة: «السهوبُ على عهدِها لا تَحول»