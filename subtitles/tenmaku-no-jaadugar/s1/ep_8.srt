1
00:00:08,480 --> 00:00:13,330
بفضل قرطَي أُذنيكِ، تحقّقت من أنّ
كُلّ شيء يسير كما ينبغي

2
00:00:20,230 --> 00:00:26,840
هل سيُوافقني الجميع الرّأي بعد
أن نهزم الجين؟

3
00:00:33,400 --> 00:00:37,470
أنا حقّاً لا أملك فكرة عمّا يُفكِّر فيه

4
00:00:40,140 --> 00:00:41,730
!الأمَة قد اختفت

5
00:00:41,730 --> 00:00:44,520
ماذا؟ ماذا؟ ماذا؟

6
00:00:45,110 --> 00:00:47,690
هل تاهتْ ثانية؟

7
00:00:47,690 --> 00:00:50,180
!مولاتي موغي

8
00:01:00,930 --> 00:01:03,630
جادوغار

9
00:02:28,620 --> 00:02:30,110
فاطمة

10
00:02:30,110 --> 00:02:31,210
بئساً

11
00:02:31,210 --> 00:02:33,340
كنتِ هنا إذاً

12
00:02:33,880 --> 00:02:35,960
!كيف تجرئين على الهرب منّي؟

13
00:02:36,270 --> 00:02:37,920
!قاداق

14
00:02:37,920 --> 00:02:39,350
!ساعدني أرجوك

15
00:02:39,350 --> 00:02:40,890
سيّد تشينقاي؟

16
00:02:39,350 --> 00:02:40,890
تشينقاي؟

17
00:02:40,890 --> 00:02:43,520
تُجيد الكِتابة بالأويغوريّة، صحيح؟

18
00:02:49,360 --> 00:02:51,360
الرّجاء الاهتمام بهذه كذلك

19
00:02:51,360 --> 00:02:53,110
أما من نهاية لها؟

20
00:02:53,690 --> 00:02:55,030
أنا آسف بشأن ذلك

21
00:02:55,430 --> 00:02:59,980
كُلّ شيء يشتريه الخاقان العظيم
يجب تدوينه في سجلّاتنا

22
00:03:00,960 --> 00:03:05,420
إذاً لماذا أنا هنا؟ أليس
هذا من واجب الرّجال؟

23
00:03:05,420 --> 00:03:07,170
اصمتي واشرعي في العمل

24
00:03:07,170 --> 00:03:11,630
الكثير من المغول لا يحبّون القراءة والكتابة

25
00:03:11,630 --> 00:03:13,900
لذا، لدينا نقص في عدد الكُتّاب

26
00:03:14,380 --> 00:03:15,330
!كُتُب

27
00:03:16,490 --> 00:03:18,020
من سيقرأ هذه أصلاً؟

28
00:03:18,940 --> 00:03:21,300
هذا من تأليف جابر ابن حيّان

29
00:03:21,300 --> 00:03:22,000
ماذا؟

30
00:03:23,200 --> 00:03:24,280
لا شيء

31
00:03:31,120 --> 00:03:34,650
لماذا هذا الكتاب مخفيّ يا مولاتي؟

32
00:03:35,400 --> 00:03:37,790
هذا الكِتاب بواسطة جابر؟

33
00:03:38,170 --> 00:03:41,910
كان جابر رجلاً عاش في طوس
منذ مدّة طويلة

34
00:03:42,760 --> 00:03:45,960
لكن لا يُعدّ من أفضل المُجلّدات سُمعة{?}

35
00:03:46,870 --> 00:03:48,460
ما موضوع كتابه؟

36
00:03:51,830 --> 00:03:53,380
الخيمياء

37
00:03:57,060 --> 00:03:58,470
عمّاذا يحكي هذا الكتاب؟

38
00:03:58,750 --> 00:04:04,180
يشرح كيفيّة تسخين وخلط مواد
مُتنوّعة مثل المعادن

39
00:04:05,240 --> 00:04:06,930
لتحضير الإكسير

40
00:04:06,930 --> 00:04:08,520
الإكسير"؟"

41
00:04:08,520 --> 00:04:09,780
ماذا يعني؟

42
00:04:09,780 --> 00:04:13,150
إنّه كدواء شامل؟
أو هذا ما أعتقده

43
00:04:13,150 --> 00:04:14,900
لستُ مُلِمّة به كثيراً

44
00:04:14,900 --> 00:04:16,460
دواء شامل؟

45
00:04:17,660 --> 00:04:18,820
مولاتي موغي

46
00:04:18,820 --> 00:04:21,780
هل تقصدين دواء يستطيع
عِلاج أيّ مرض؟

47
00:04:27,220 --> 00:04:30,830
هذه فاطمة، خادمتي

48
00:04:31,190 --> 00:04:32,580
بُراقجين خاتون

49
00:04:34,170 --> 00:04:37,260
إذاً هذه هي عقيلة إمبراطور المغول

50
00:04:38,420 --> 00:04:39,680
خاتون العظيمة

51
00:04:40,470 --> 00:04:43,970
لماذا أُتي بي إلى هنا لِلقائها؟

52
00:04:44,190 --> 00:04:45,700
اسمعي يا بُراقجين

53
00:04:45,700 --> 00:04:48,180
تقول هذه الفتاة بأنّها تستطيع
صنع عِلاج شامل

54
00:04:48,960 --> 00:04:50,100
تقصدين دانياو؟

55
00:04:50,100 --> 00:04:50,970
ماذا؟

56
00:04:51,430 --> 00:04:55,980
ا-المعذرة. لستُ أدري ما يكون هذا بالضّبط

57
00:04:56,300 --> 00:05:00,570
كُلّ ما قلتُه هو أنّني أستطيع قراءة
كُتُب مكتوبة بالعربيّة

58
00:05:00,970 --> 00:05:02,000
ماذا؟

59
00:05:02,000 --> 00:05:02,990
موغي

60
00:05:02,990 --> 00:05:04,540
...لكن

61
00:05:04,540 --> 00:05:06,690
هذا كُل ما في الأمر. انصرفي

62
00:05:07,530 --> 00:05:09,460
آسفة لأنّني جعلتُكِ تقطعين
كلّ هذه المسافة إلى هنا

63
00:05:13,160 --> 00:05:15,220
ماذا كان ذلك؟

64
00:05:15,220 --> 00:05:16,250
لا أدري

65
00:05:17,210 --> 00:05:18,920
!انتظري

66
00:05:18,920 --> 00:05:20,130
مولاتي موغي؟

67
00:05:20,130 --> 00:05:23,090
ثمّة أمر أريد مُناقشته معكِ

68
00:05:23,460 --> 00:05:25,650
...سبب طلبَي منكِ المجيء إلى هنا

69
00:05:27,850 --> 00:05:28,850
دعنا بمُفردنا

70
00:05:32,630 --> 00:05:35,480
كان أحدٌ يدسُّ سُمّاً لبُراقجين

71
00:05:36,340 --> 00:05:40,070
رأيتِ كم هي هزيلة وبشرتها شاحبة

72
00:05:40,070 --> 00:05:43,280
سُمّ؟ من هو المسؤول؟ ولماذا؟

73
00:05:43,680 --> 00:05:45,010
لستُ مُتيقّنة

74
00:05:45,370 --> 00:05:49,520
لكنّني أشكُّ بطبيب بُراقجين

75
00:05:50,180 --> 00:05:55,210
منذ مدّة طويلة، كانت هناك عقيدة
طاوية تُعرَف بـ وايدان

76
00:05:55,640 --> 00:05:56,920
وايدان؟

77
00:05:56,920 --> 00:06:03,130
سندَروس

78
00:05:56,920 --> 00:06:03,130
كبريت

79
00:05:56,920 --> 00:06:03,130
زِئبق

80
00:05:57,310 --> 00:06:00,580
،بمزج الكبريت والزّئبق والسّندَروس

81
00:06:00,580 --> 00:06:03,570
"يمكن صنع إكسير يُدعى "دانياو

82
00:06:03,950 --> 00:06:10,890
قيل بأنّ تناول دانياو يجعل الجسدَ
خالداً كما الذّهب

83
00:06:10,890 --> 00:06:12,170
أحقّاً ذلك؟

84
00:06:12,170 --> 00:06:13,490
لا

85
00:06:13,490 --> 00:06:18,150
كلّ ما تجرّعه تعرّضَ لسُمّ، ما أدّى
إلى تقصير عمره

86
00:06:18,530 --> 00:06:22,730
ذلك كان سبب التخلِّي عن هذه
المُمارسة منذ زمن بعيد

87
00:06:23,450 --> 00:06:26,530
"أنا متأكّدة بأنّني سمعتُه يلفظ كلمة "سُمّ

88
00:06:26,530 --> 00:06:29,270
يؤسفني أنّ هذا ليس أساساً
يمكن الاعتماد عليه

89
00:06:29,270 --> 00:06:32,250
إن كان الأمر يُؤرقكِ، فحاولي
إبعاد الطّبيب ببساطة

90
00:06:32,250 --> 00:06:36,440
كخاتون عظيمة، من المُؤكَّد أنّ
استبداله سيكون عملاً تافهاً

91
00:06:36,440 --> 00:06:37,540
توريكاني

92
00:06:37,540 --> 00:06:39,290
هيّا بنا نعود يا فاطمة

93
00:06:39,290 --> 00:06:40,680
حـ-حسناً

94
00:06:47,550 --> 00:06:50,640
لا يجدر بنا أن نتورّط مع تلك المرأة المُخيفة

95
00:06:51,690 --> 00:06:52,980
كان ذلك مُريعاً

96
00:06:53,780 --> 00:06:56,170
كان اليوم أوّل مرّة أرى فيها خاتون العظيمة

97
00:06:56,170 --> 00:07:00,430
إنّها أكبر سنّاً بكثير من الإمبراطور
أوقطاي، أليس كذلك؟

98
00:07:00,430 --> 00:07:03,280
أجل. كانت زوجة أبيه

99
00:07:03,280 --> 00:07:03,940
ماذا؟

100
00:07:04,190 --> 00:07:07,920
بُراقجين وموغي كانتا مُتزوّجتين
من جنكيز خان

101
00:07:08,280 --> 00:07:10,810
ورثَهما أوقطاي في النّهاية كزوجتين

102
00:07:10,810 --> 00:07:11,870
ماذا؟

103
00:07:12,310 --> 00:07:15,750
إذاً إنّهما تعرفان بعضهما الآخر
منذ مدّة طويلة

104
00:07:15,750 --> 00:07:20,580
عندما يموت الأب، فإنّ زوجاته يُورّثنَ
لابنه، باستثناء أمّه الّتي أنجبَتْه

105
00:07:21,310 --> 00:07:23,210
إنّه ترتيب شائع هنا

106
00:07:26,470 --> 00:07:27,720
بُراقجين

107
00:07:30,390 --> 00:07:34,350
ليس لديها أبناء، وهي لا تنحدر
من عائلة كبيرة

108
00:07:35,320 --> 00:07:40,010
للأمانة، لا أعلم كيف أصبحتْ خاتون العظيمة

109
00:07:43,190 --> 00:07:49,570
قيل بأنّ تناول دانياو يجعل الجسدَ
خالداً كما الذّهب

110
00:07:50,060 --> 00:07:52,280
هذا يُشبه الخيمياء

111
00:07:52,750 --> 00:07:55,290
من يتوقّع أنّ لديهم شيء
مُشابه في الشّرق؟

112
00:07:56,170 --> 00:07:58,250
جسد خالد

113
00:07:59,040 --> 00:08:00,210
تقصدين دانياو؟

114
00:08:04,120 --> 00:08:05,420
أيُعقَل ذلك؟

115
00:08:05,930 --> 00:08:07,610
...الإكسير

116
00:08:08,330 --> 00:08:11,420
...المُكوّنات هي الزّئبق والكبريت

117
00:08:12,170 --> 00:08:14,880
وماذا كان أيضاً؟

118
00:08:18,680 --> 00:08:20,270
مولاتي توريكاني

119
00:08:20,830 --> 00:08:23,690
دعينا نذهب ونلتقي بخاتون
العظيمة مرّة أُخرى

120
00:08:23,690 --> 00:08:26,400
ماذا؟ لماذا؟

121
00:08:30,420 --> 00:08:32,530
يدور شيء ما في ذهنكِ، أليس كذلك؟

122
00:08:35,000 --> 00:08:38,360
أريدكِ أن تمدّيني بقوّتكِ يا مولاتي توريكاني

123
00:08:42,560 --> 00:08:47,220
الإكسير. عِلاج مُدهش يجعل
جسدَ المرء خالداً

124
00:08:47,220 --> 00:08:51,550
إنّه يكمن في قلب الخيمياء الفارسيّة

125
00:08:51,780 --> 00:08:55,760
ممّا لا شكّ فيه هو أنّني لا أستطيع
تحضيره بنفسي

126
00:08:56,200 --> 00:09:01,020
،غير أنّ بمُساعدتكِ يا خاتون العظيمة
...لعلّي أستطيع

127
00:09:01,780 --> 00:09:03,650
لِمَ الحديث عن هذا ثانية؟

128
00:09:04,010 --> 00:09:07,110
لأنّكِ أنتِ من كان يبحث عنه

129
00:09:08,100 --> 00:09:09,440
هل أنا مُخطئة؟

130
00:09:10,960 --> 00:09:12,280
لحظة، أحقّاً ذلك؟

131
00:09:12,820 --> 00:09:16,240
خطرَ ذلك على ذهني حالما رأيتُكِ

132
00:09:16,460 --> 00:09:19,330
...إن كان عليّ الاستنتاج اعتماداً على مظهركِ

133
00:09:20,480 --> 00:09:23,830
هل كنتِ تتناولين رَهج الغار؟

134
00:09:23,830 --> 00:09:25,760
رَهج الغار؟

135
00:09:27,420 --> 00:09:29,710
إنّه حجرٌ أحمر يمكن العثور
،عليه في البراكين

136
00:09:29,710 --> 00:09:33,930
وفي الشّرق، سمعتُ بأنّهم
يُطلقون عليه سندَروس

137
00:09:35,180 --> 00:09:36,530
لذا كنتُ مُحقّة

138
00:09:37,230 --> 00:09:42,850
رَهج الغار هو مُكوّن أساسيّ للإكسير
ودانياو في نهاية المطاف

139
00:09:43,580 --> 00:09:46,710
،وفقاً للطّبيب القديم، أبقراط

140
00:09:46,710 --> 00:09:50,490
رَهج الغار لديه تأثيرات طبّية بجرعات صغيرة

141
00:09:50,960 --> 00:09:51,780
...لكنّه

142
00:09:52,220 --> 00:09:54,490
يؤدّي وظيفة سُمّ إذا استمررتِ في تناوله

143
00:09:55,040 --> 00:09:59,370
ممّا يُسبّب فقداناً للشّهية وآفات
جلديّة وأوراماً

144
00:09:59,920 --> 00:10:02,170
وهذا ما يبدو أنّكِ تُعانين منه

145
00:10:03,150 --> 00:10:08,710
إذاً لم تُسمَّمي بواسطة أحد؟
اخترتِ تجرُّع هذا بنفسكِ؟

146
00:10:08,970 --> 00:10:12,530
موغي. أهذا ما اعتقدتِه أنتِ؟

147
00:10:13,270 --> 00:10:14,930
فاطمة، صحيح؟

148
00:10:14,930 --> 00:10:17,570
انظري إلى داخل الدّروج في ذلك الرّفّ

149
00:10:21,140 --> 00:10:22,810
رَهج الغار

150
00:10:23,060 --> 00:10:25,520
لماذا كنتِ تتناولين هذا؟

151
00:10:29,680 --> 00:10:32,240
هل كان لتُصبحي خالدة؟

152
00:10:36,780 --> 00:10:38,160
أجل، هذا صحيح

153
00:10:38,160 --> 00:10:39,870
أنا أكبر في السنّ

154
00:10:40,380 --> 00:10:42,240
أرغب في عيش حياة مديدة

155
00:10:42,240 --> 00:10:43,580
بُراقجين

156
00:10:43,980 --> 00:10:47,040
من فضلكِ تناولي بعضاً من هذا
يا جلالة الإمبراطورة بُراقجين

157
00:10:47,610 --> 00:10:49,530
إنّه دواء سيُعالج سُمّكِ

158
00:11:01,560 --> 00:11:03,720
وما هو هذا؟

159
00:11:03,720 --> 00:11:04,970
إنّه حجر جادا

160
00:11:04,970 --> 00:11:06,340
حجر جادا؟

161
00:11:06,340 --> 00:11:08,980
لا يجوز تناول أحجار جادا

162
00:11:08,980 --> 00:11:10,360
أنتِ مُخطئة

163
00:11:10,360 --> 00:11:14,700
،تُدعى بحصاة البازهر في فارس
حيث يُعترَف بها كترياق

164
00:11:15,240 --> 00:11:17,660
لم تلقي لعنةً على هذه، صحيح؟

165
00:11:17,660 --> 00:11:20,070
وهل هذا وجه شخص يتمنّى لكِ المرض؟

166
00:11:32,860 --> 00:11:36,530
من فضلكِ استدعينا ثانية إلى هنا
حالما تتعافين

167
00:11:37,440 --> 00:11:40,890
يمكنني أن أحدّثكِ أكثر عن الإكسير حينها

168
00:11:43,860 --> 00:11:45,890
شكراً جزيلاً لكِ

169
00:11:45,890 --> 00:11:47,860
لم أفعل شيئاً

170
00:11:47,860 --> 00:11:48,900
أتمزحين؟

171
00:11:49,620 --> 00:11:53,400
لأنّكِ تمكّنتِ من إيجاد أولئك
الأطبّاء الفارسيّين لأجلي

172
00:11:53,400 --> 00:11:56,860
تمكّنتُ من المعرفة بشأن رَهج الغار

173
00:11:57,620 --> 00:11:59,430
ماذا ستفعلين بشأن جغتاي؟

174
00:11:59,430 --> 00:12:04,160
كنّا عجولتين كثيراً بمُحاولة التقرُّب
فجأة من الأمير جغتاي

175
00:12:04,590 --> 00:12:08,920
،بدلاً من ذلك، بكسب ثِقة خاتون العظيمة

176
00:12:08,920 --> 00:12:10,930
سيُمهَّد طريقٌ أمامنا بلا شكّ

177
00:12:11,990 --> 00:12:14,300
طريق لكِلتينا

178
00:12:15,100 --> 00:12:16,300
أجل

179
00:12:17,050 --> 00:12:18,380
كما تقولين تماماً

180
00:12:20,260 --> 00:12:23,030
الصّيف، 1230 ميلادي

181
00:12:27,780 --> 00:12:29,350
،بعد فترة ليست بطويلة

182
00:12:30,700 --> 00:12:35,210
انطلقَ إمبراطور المغول في حملة
ضدّ سُلالة جين

183
00:12:40,490 --> 00:12:43,720
منطقة شانشي
مُعسكر جبهة عائلة أوقطاي

184
00:12:46,430 --> 00:12:49,130
يمكنك وضع هذه هناك

185
00:12:49,130 --> 00:12:50,180
موغي

186
00:12:51,510 --> 00:12:52,880
بُراقجين

187
00:12:53,390 --> 00:12:55,700
أنتِ بخير بما يكفي للمشي في الخارج؟

188
00:12:56,460 --> 00:12:58,420
أجل، كما ترين

189
00:12:58,420 --> 00:13:00,200
يعزو كُلّ الفضل لفاطمة

190
00:13:00,200 --> 00:13:00,970
أليس كذلك؟

191
00:13:01,930 --> 00:13:03,080
بالفعل

192
00:13:04,880 --> 00:13:07,490
أحمل رسالة من الإمبراطورة بُراقجين

193
00:13:07,930 --> 00:13:11,890
تريد أن تتكلّم مع الآنسة فاطمة ثانية

194
00:13:15,230 --> 00:13:20,820
في العام المُقبل، من أجل مُحاصرة
،عاصِمة جين، كايفينغ

195
00:13:16,400 --> 00:13:26,830
المغول

196
00:13:16,400 --> 00:13:26,830
سونغ
الجنوبيّة

197
00:13:16,400 --> 00:13:26,830
كايفينغ

198
00:13:16,400 --> 00:13:26,830
سُلالة جين

199
00:13:20,820 --> 00:13:24,520
طلبَ جيشُ تولي إذناً بعبور
أراضي سونغ الجنوبيّة

200
00:13:25,540 --> 00:13:26,830
...لكن

201
00:13:27,790 --> 00:13:29,500
قتلوا مبعوثنا؟

202
00:13:29,970 --> 00:13:32,290
هذا هو ردّ سونغ الجنوبيّة إذاً؟

203
00:13:32,880 --> 00:13:34,250
هل نعود أدراجنا؟

204
00:13:35,830 --> 00:13:36,880
لا

205
00:13:37,220 --> 00:13:39,510
سوف نُتابع جنوباً كما هو مُخطَّط

206
00:13:39,510 --> 00:13:42,990
تلقّينا الردّ رغم أنّه غير مرغوب فيه

207
00:13:42,990 --> 00:13:47,050
لن تصمت سونغ الجنوبيّة عن هذا

208
00:13:49,380 --> 00:13:50,180
...حسناً

209
00:13:51,060 --> 00:13:53,380
سنهزم سونغ الجنوبيّة ببساطة كذلك

210
00:14:11,720 --> 00:14:13,670
،اخترقَ جيشُ تولي المعبرَ المُحصّن

211
00:14:14,140 --> 00:14:16,590
ثمّ استمرّ في عبور الطّرُقات الجبليّة الوعِرة

212
00:14:19,130 --> 00:14:22,760
تبيّن أن تلك الجبال ليست ندّاً لنا

213
00:14:24,140 --> 00:14:26,730
سيُسِرُّ هذا خاقان العظيم

214
00:14:29,240 --> 00:14:30,860
معك حقّ

215
00:14:31,680 --> 00:14:34,820
أنا متأكّد بأنّ أخي سيبتهج كثيراً

216
00:14:44,100 --> 00:14:45,530
يا رب

217
00:14:46,000 --> 00:14:48,370
احمِ تولي أرجوك

218
00:14:49,230 --> 00:14:50,490
مهلكِ

219
00:14:51,110 --> 00:14:55,460
،تعلمين بأنّ أبي لن يخسر أبداً
فلِمَ تتكبّدين عناء الصّلاة؟

220
00:14:51,380 --> 00:14:55,460
ابن تولي
هولاكو

221
00:14:55,460 --> 00:14:58,630
ويحك! كيف تقول كلاماً كهذا أمام الرّبّ؟

222
00:14:59,280 --> 00:15:02,910
لا أعتقد بأنّ تولي سيخسر في معركة يوماً

223
00:15:03,390 --> 00:15:04,300
...لكن

224
00:15:04,840 --> 00:15:07,780
قد تقع مُصيبة خارج ساحة المعركة

225
00:15:08,470 --> 00:15:13,090
أولئك الّذين يمتلكون نفوذاً كبيراً
يُنظَر إليهم بخوف واستياء

226
00:15:13,090 --> 00:15:15,480
إذاً يجب أن تتوخّي الحذر أيضاً يا أمّي

227
00:15:15,850 --> 00:15:17,170
أنا؟

228
00:15:18,230 --> 00:15:21,320
لا أحد يُفكِّر فيّي

229
00:15:24,480 --> 00:15:26,400
آمل ذلك فحسب

230
00:15:38,090 --> 00:15:39,570
ها أنا ذي

231
00:15:45,180 --> 00:15:46,740
تفضّلي

232
00:15:46,740 --> 00:15:48,760
شكراً لكِ. اتركيه عندكِ

233
00:16:07,000 --> 00:16:09,220
تفضّلي. إنّه طازج

234
00:16:09,220 --> 00:16:10,840
شكراً جزيلاً لكِ

235
00:16:11,690 --> 00:16:14,510
أحضرتُ لكِ بعض الأوروم يا مولاتي توريكاني

236
00:16:16,400 --> 00:16:19,260
،أحبّه كثيراً في هذه الفترة من العام
عندما يكون في ذروة نضجه

237
00:16:22,840 --> 00:16:24,130
إنّه شهيّ

238
00:16:24,130 --> 00:16:28,490
سيُقبِل الخريف علينا قريباً، وسيُستخدَم
الأوروم لصنع الزّبدة

239
00:16:28,830 --> 00:16:31,010
ستكون هذه هي الدُّفعة الأخيرة في الموسم

240
00:16:31,500 --> 00:16:33,010
لِمَ لا تتناولين بعضاً أيضاً؟

241
00:16:33,010 --> 00:16:37,520
لا أستطيع. استدعَتْني الإمبراطورة
بُراقجين للتو في الواقع

242
00:16:37,520 --> 00:16:39,340
من جديد؟

243
00:16:39,340 --> 00:16:42,240
المعذرة. أستأذن الآن

244
00:16:54,230 --> 00:16:56,280
لا مانع لديّ

245
00:17:00,260 --> 00:17:04,960
في العالم الطّبيعيّ، هناك تداخُل
بين المادّة والصِّفات

246
00:17:05,190 --> 00:17:10,680
يمكن تحويل مادّة إلى أُخرى
بالتّلاعب بصِفاتها

247
00:17:11,210 --> 00:17:15,760
ببسيط العبارة، هذا ما يتحدّث عنه
هذا البحث الّذي كتبَه جابر

248
00:17:16,510 --> 00:17:17,720
ماذا يعني هذا؟

249
00:17:17,950 --> 00:17:19,930
،بفهم صِفات شيء

250
00:17:20,200 --> 00:17:24,090
يستطيع المرء إنتاج ما يرغبه، سواء
كان سلاحاً أو علاجاً

251
00:17:24,090 --> 00:17:25,650
هذا مُذهل

252
00:17:25,970 --> 00:17:27,720
خذي السّندَروس على سبيل المثال

253
00:17:27,720 --> 00:17:32,450
تسخين رَهج الغار يجعله أبيض
ويُعزّز سُمّيته

254
00:17:32,990 --> 00:17:35,610
تقرّبوا من حقيقة هذا العالم على ما يبدو

255
00:17:35,610 --> 00:17:39,660
عُلماء موطنكِ وطاويّو المملكة الوسطى

256
00:17:42,540 --> 00:17:45,200
خاقان العظيم والإمبراطورة بُراقجين

257
00:17:45,200 --> 00:17:48,680
يُفكِّران بما سيحدث بعد غزوهم لجين

258
00:17:49,470 --> 00:17:52,180
لديهم نظرة أوسع للعالم

259
00:17:56,420 --> 00:17:58,310
ما الأمر يا فاطمة؟

260
00:17:58,610 --> 00:18:04,270
حسناً، ذكرَ السّيّد تشينقاي
عن نقص في الكُتَّاب

261
00:18:04,990 --> 00:18:06,340
ما السّبب يا ترى؟

262
00:18:06,340 --> 00:18:11,030
ألم يكتسب المغول أُناساً ومعرفة
من كُلّ أنحاء العالم؟

263
00:18:12,980 --> 00:18:17,030
هذا لأنّ مُعظم المُفكِّرين الّذين
...اكتسبَهم المغول

264
00:18:17,310 --> 00:18:20,080
يندرجون الآن نحن حُكم عائلة تولي

265
00:18:20,080 --> 00:18:21,240
ماذا؟

266
00:18:21,240 --> 00:18:25,280
كما الجيش تماماً، لدى عائلة تولي حقّ
التصرُّف معهم بصفة الأوتشيغين

267
00:18:25,280 --> 00:18:29,490
ألا يستطيع الخاقان العظيم
استخدام نفوذه فحسب؟

268
00:18:29,490 --> 00:18:32,720
أتريدين من الخاقان العظيم
أن يختلس مُلكيّة أخيه؟

269
00:18:33,700 --> 00:18:34,990
أعتذر

270
00:18:35,820 --> 00:18:38,640
هذا اختلال توازُن فكريّ كذلك؟

271
00:18:39,600 --> 00:18:42,600
لكن هذا يصبُّ في صالحنا

272
00:18:43,840 --> 00:18:46,860
أهذا هو الأفضل حقّاً؟

273
00:18:48,570 --> 00:18:50,490
لا يسعني سوى الشُّعور بالخوف

274
00:18:50,950 --> 00:18:54,650
تتحكّم عائلة تولي بغالبيّة القوّة
العسكريّة والفكريّة

275
00:18:55,370 --> 00:18:57,090
...هذا لا يعني إلّا

276
00:18:57,090 --> 00:19:00,370
أنّ الأهمّ هو العمل جنباً إلى جنب
مع عائلة تولي

277
00:19:01,990 --> 00:19:04,540
لكن هل يُراود الأمير تولي نفس الشُّعور؟

278
00:19:06,480 --> 00:19:09,700
موغي. آسفة، لكن هلّا تركتِنا؟

279
00:19:18,100 --> 00:19:23,350
قبل أن تحضركِ موغي إلى هنا، لا أتذكّر
بأنّني رأيتُكِ يوماً

280
00:19:24,000 --> 00:19:26,140
من تكونين بالضّبط؟

281
00:19:27,200 --> 00:19:29,400
من الطّبيعيّ ألّا تألفينني

282
00:19:32,490 --> 00:19:36,030
فقد كنتُ أخدم الأميرة سرقويتي

283
00:19:36,950 --> 00:19:38,630
أحثّكِ على توخّي الحذر

284
00:19:38,630 --> 00:19:40,990
فهي لم تتخلّ عن طموحاتها

285
00:19:41,240 --> 00:19:44,030
،برؤية الأمير تولي يُصبح الخاقان العظيم

286
00:19:44,540 --> 00:19:47,000
وهي الخاتون العظيمة

287
00:19:50,700 --> 00:19:52,590
أتقولين سرقويتي؟

288
00:19:54,620 --> 00:19:58,300
هكذا إذاً. سأضع ذلك في الحسبان

289
00:19:59,320 --> 00:20:03,770
لكن لماذا أفشيتِ لي هذا الأمر يا فاطمة؟

290
00:20:04,180 --> 00:20:07,230
اختاري جوابكِ بحكمة. قد تدفعين
ثمناً غالياً لِقاءه

291
00:20:07,670 --> 00:20:10,080
لا داعي للقلق. أستطيع فعلها

292
00:20:10,500 --> 00:20:14,650
لديّ فكرة جيّدة عمّا يدور في ذهنها

293
00:20:15,610 --> 00:20:20,240
بصراحة، لا أعلم كيف أصبحتْ خاتون العظيمة

294
00:20:21,150 --> 00:20:23,630
،مهما كانت خاتون العظيمة حكيمة

295
00:20:23,630 --> 00:20:28,090
من المُؤكّد أنّ هناك الكثيرين يتساءلون
حول نفس الأمر مثل مولاتي توريكاني

296
00:20:28,630 --> 00:20:33,130
لهذا السّبب هي تتمسّك بفطنتها

297
00:20:34,150 --> 00:20:39,050
لمستُ أملاً في الإمبراطور أوقطاي وفي نفسكِ

298
00:20:40,380 --> 00:20:46,520
الحكمة الّتي تمتلكانها تجعلكما
مُلائمين لحُكم هذا العالم

299
00:20:52,010 --> 00:20:54,690
أوتظنّين ذلك حقّاً؟

300
00:20:58,280 --> 00:20:59,990
بكلّ تأكيد

301
00:21:01,860 --> 00:21:06,730
توقّعتُها أن تكون ماكرة، لكنّها
سهلة الانقياد بغرابة

302
00:21:07,040 --> 00:21:09,270
يجب أن أُبلغ مولاتي توريكاني عن هذا حالاً

303
00:21:09,270 --> 00:21:10,980
!المعذرة

304
00:21:11,690 --> 00:21:15,230
ا-المعذرة، كنتُ أعدّ الزّبدة

305
00:21:15,230 --> 00:21:17,590
لكن ما زلتُ لم أعتد على ذلك

306
00:21:17,590 --> 00:21:21,050
ما زال الحليب الّذي جمعناه اليوم موجوداً

307
00:21:21,500 --> 00:21:23,510
لا تقلقي. أستطيع المُساعدة

308
00:21:24,580 --> 00:21:26,420
شكراً جزيلاً لكِ

309
00:21:29,360 --> 00:21:30,980
مولاتي توريكاني

310
00:21:32,550 --> 00:21:33,940
يمكن تأجيل ذلك لوقت لاحق

311
00:21:46,000 --> 00:21:47,450
مولاتي توريكاني؟

312
00:21:52,300 --> 00:21:54,980
لا حاجة للتوتُّر يا توريكاني

313
00:21:56,460 --> 00:21:59,290
ثمّة أمر أودُّ مُناقشته معكِ

314
00:22:04,030 --> 00:22:08,060
خاتون العظيمة بُراقجين

315
00:23:38,020 --> 00:23:43,250
تنكري

316
00:23:39,000 --> 00:23:41,150
"الحلقة القادمة: "تنكري