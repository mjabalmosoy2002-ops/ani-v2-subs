1
00:00:08,480 --> 00:00:13,330
‫بفضلِ زينتكِ يا موكا، تيقنتُ أنَّ مسارَ ديارنا يسيرُ على ما يُرام

2
00:00:20,230 --> 00:00:26,840
‫أفَيتّبعُ القومُ مرامي وعزمي بعد دحرنا لسلالةِ جين؟

3
00:00:33,400 --> 00:00:37,470
‫ما زلتُ أجهلُ تمامًا ما يَجولُ في خاطرِ الخاقان

4
00:00:40,140 --> 00:00:41,730
‫تلاشت تلك الجارية

5
00:00:41,730 --> 00:00:44,520
‫ما الخطب؟ أين هي؟

6
00:00:45,110 --> 00:00:47,690
‫أضلَّت سبيلَها تارةً أخرى؟

7
00:00:47,690 --> 00:00:50,180
‫يا خاتون موكا

8
00:02:28,620 --> 00:02:30,110
‫يا فاطمة

9
00:02:31,210 --> 00:02:33,340
‫أهنا تَختبئين إذن؟

10
00:02:33,880 --> 00:02:35,960
‫أَتجسرينَ على النفرِ منِّي والهرب؟

11
00:02:36,270 --> 00:02:37,920
‫قاداق

12
00:02:37,920 --> 00:02:39,350
‫أعِني في هذا الأمر

13
00:02:39,350 --> 00:02:40,890
‫المولى شينقاي؟

14
00:02:40,890 --> 00:02:43,520
‫أَتُحسِنُ الكتابةَ بالرَّسمِ الأُويغوري؟

15
00:02:49,360 --> 00:02:51,360
‫خُذي... قَيّدي مَحامِيلَ هذه السجلاتِ كذلِك

16
00:02:51,360 --> 00:02:53,110
‫أَما لهذهِ السجلاتِ الـمُضنيةِ من نَهاية؟

17
00:02:53,690 --> 00:02:55,030
‫أرجو المَعذرةَ منكِ على هذا الإضناء

18
00:02:55,430 --> 00:02:59,980
‫فمُشترياتُ الخاقانِ الأعظمِ قاطبةً يُفرَضُ تدوينُها في دَفاترِ البلاط

19
00:03:00,960 --> 00:03:05,420
‫فلمَ أُقحِمتُ أنا هاهنا؟ أَوليسَ تدوينُ السجلاتِ من شأنِ الرجال؟

20
00:03:05,420 --> 00:03:07,170
‫كُفِّي عن الهَذرِ والزمي عَمَلكِ

21
00:03:07,170 --> 00:03:11,630
‫جُلُّ فرسانِ المغولِ لا يَأبهونَ بـخَطِّ الحروفِ والقرطاس

22
00:03:11,630 --> 00:03:13,900
‫لِـذا نَشهدُ قِلَّةً في حَفَظَةِ الدواوينِ والكَتَبَة

23
00:03:14,380 --> 00:03:15,330
‫يا لَـعَظمةِ هذهِ الأسفار

24
00:03:16,490 --> 00:03:18,020
‫تُرى مَن يَكترثُ لـتَصفّحِ هذهِ الأوراقِ المتروكة؟

25
00:03:18,940 --> 00:03:21,300
‫هذا سِفرٌ خَطَّهُ جابرُ بنُ حَيَّان

26
00:03:21,300 --> 00:03:22,000
‫ماذا؟

27
00:03:23,200 --> 00:03:24,280
‫أبصرتُ غَرضًا عابرًا... لا غَير

28
00:03:31,120 --> 00:03:34,650
‫لِمَ يُوارى هذا السِّفرُ عن الأعينِ يا مولاتي؟

29
00:03:35,400 --> 00:03:37,790
‫أَتَعنينَ سِفرَ جابرٍ هذا؟

30
00:03:38,170 --> 00:03:41,910
‫كان جابرٌ حكيمًا استوطنَ طوسَ في سالفِ الأزمان

31
00:03:42,760 --> 00:03:45,960
‫بيدَ أنَّ مَسائلَهُ ليست مِـمَّا يُبسطُ علنًا بينَ أيدي العُلماء

32
00:03:46,870 --> 00:03:48,460
‫عَمَّ يَتحدّثُ سِفرُهُ إذن؟

33
00:03:51,830 --> 00:03:53,380
‫صناعةُ الخيمياء

34
00:03:57,060 --> 00:03:58,470
‫عَمَّ يَتحدّثُ هذا السِّفر؟

35
00:03:58,750 --> 00:04:04,180
‫يَفصّلُ طرائقَ صَهرِ النفائسِ والمَعادنِ ومزجِ خواصِّها

36
00:04:05,240 --> 00:04:06,930
‫لِـصناعةِ الإكسيرِ العجيب

37
00:04:06,930 --> 00:04:08,520
‫الـإكسير؟

38
00:04:08,520 --> 00:04:09,780
‫فمَا يكونُ هذا؟

39
00:04:09,780 --> 00:04:13,150
‫أشبهُ بـترياقٍ شافٍ لكلِّ سَقَم، على ما تناهى لعلمي

40
00:04:13,150 --> 00:04:14,900
‫فليسَ لي إحاطةٌ كاملةٌ بأسرارِه

41
00:04:14,900 --> 00:04:16,460
‫ترياقٌ يشفي كلَّ سَقَم؟

42
00:04:17,660 --> 00:04:18,820
‫خاتون موكا

43
00:04:18,820 --> 00:04:21,780
‫أَعنيتِ ترياقًا يَبلو كُلَّ عِلّةٍ وسَقَم؟

44
00:04:27,220 --> 00:04:30,830
‫هذهِ هيَ جاريَتي فاطمة

45
00:04:31,190 --> 00:04:32,580
‫الخاتون بوراكتشين

46
00:04:34,170 --> 00:04:37,260
‫أهذهِ إذن هيَ الخاتونُ الكبرى للإمبراطوريةِ المغولية؟

47
00:04:38,420 --> 00:04:39,680
‫الخاتونُ الكبرى...

48
00:04:40,470 --> 00:04:43,970
‫لِـمَ جِيءَ بِي إلى مَثواها إذن؟

49
00:04:44,190 --> 00:04:45,700
‫أرعِني سَمعكِ يا بوراكتشين

50
00:04:45,700 --> 00:04:48,180
‫تَدَّعي هذه الجاريةُ قُدرتَها على صياغةِ ترياقٍ يَبلو كُلَّ سَقَم

51
00:04:48,960 --> 00:04:50,100
‫أَتَعنينَ حُبوبَ "الدانياو" الخالدة؟

52
00:04:50,100 --> 00:04:50,970
‫ماذا تَعنين؟

53
00:04:51,430 --> 00:04:55,980
‫مَعذرةً يا خاتون، فليسَ لي عِلمٌ بما تَتحدثانِ عَنه

54
00:04:56,300 --> 00:05:00,570
‫فمَا بَسَطتُهُ من حديثٍ ليسَ إلا قُدرتي على فكِّ رُسامِ الأسفارِ العربية

55
00:05:00,970 --> 00:05:02,000
‫ماذا؟

56
00:05:02,000 --> 00:05:02,990
‫موكا

57
00:05:02,990 --> 00:05:04,540
‫بيد أن...

58
00:05:04,540 --> 00:05:06,690
‫قضي الأمر، انصرفي الآن

59
00:05:07,530 --> 00:05:09,460
‫أعتذر عن إضنائك بطلب الحضور

60
00:05:13,160 --> 00:05:15,220
‫ترى ما مغزى هذا الذي جرى؟

61
00:05:15,220 --> 00:05:16,250
‫من يدري؟

62
00:05:17,210 --> 00:05:18,920
‫تريثي

63
00:05:18,920 --> 00:05:20,130
‫الخاتون موكا؟

64
00:05:20,130 --> 00:05:23,090
‫أرعيني سمعك، ثمة حديث أود مشاركتك إياه

65
00:05:23,460 --> 00:05:25,650
‫فغاية استدعائي لكِ هاهنا...

66
00:05:27,850 --> 00:05:28,850
‫انصرفوا جميعًا ودعونا بمفردنا

67
00:05:32,630 --> 00:05:35,480
‫هناك يد خفية تجرع بوراكتشين السُّمَّ بـخفاء

68
00:05:36,340 --> 00:05:40,070
‫أرأيتِ كيف ذوى جسدها وتقرّحت بشرتها عيانًا؟

69
00:05:40,070 --> 00:05:43,280
‫سُمّ؟ مَن يجسر على هذا، ولأي غاية؟

70
00:05:43,680 --> 00:05:45,010
‫لم يثبت لي عِلم بذاك

71
00:05:45,370 --> 00:05:49,520
‫غير أنني أرتاب في نوايا طبيب بوراكتشين

72
00:05:50,180 --> 00:05:55,210
‫في سالف العصور، شاع معتقد طاوي يسمى "الوايدان"

73
00:05:55,640 --> 00:05:56,920
‫الوايدان؟

74
00:05:57,310 --> 00:06:00,580
‫عبر توليف خَلائطِ الكبريتِ والزِّئبقِ والسَّندَروس

75
00:06:00,580 --> 00:06:03,570
‫يُصاغُ إكسير يلقّب بحبوب "الدانياو"

76
00:06:03,950 --> 00:06:10,890
‫ويُزعم أن تجرّع "الدانياو" يُحيلُ الجسد صرحًا خالدًا لا يَبيد كالذهب

77
00:06:10,890 --> 00:06:12,170
‫أصدقٌ هذا الخبر؟

78
00:06:12,170 --> 00:06:13,490
‫كلا البتة

79
00:06:13,490 --> 00:06:18,150
‫فكلُّ مَن تَجرَّعَهُ استسلمَ لِـهلاكِ السُّمِّ، وقصُرَ بهِ العمر

80
00:06:18,530 --> 00:06:22,730
‫ومِن ثَمَّ هُجِرت تِلكَ الطقوسُ الخاطئةُ منذُ أزمانٍ سحيقة

81
00:06:23,450 --> 00:06:26,530
‫إني لموقنةٌ بـأنَّ مسامعي التقطت منهُ نُطقَ كلمةِ السُّمّ

82
00:06:26,530 --> 00:06:29,270
‫أخشى أنَّ هذا القولَ وحدَهُ لا يُشكّلُ دليلاً سديدًا

83
00:06:29,270 --> 00:06:32,250
‫إن كانَ هذا يُقلقكِ، فـاقصي الطبيبَ عَنها فحسب

84
00:06:32,250 --> 00:06:36,440
‫فمَا مَسألةُ عزلِهِ واستبدالِهِ بغيرهِ إلا أمرٌ يسيرٌ لِـخاتونٍ كبرى مثلِها

85
00:06:36,440 --> 00:06:37,540
‫توراكينا

86
00:06:37,540 --> 00:06:39,290
‫لنَعُد أدراجَنا يا فاطمة

87
00:06:39,290 --> 00:06:40,680
‫حـ-حسنًا

88
00:06:47,550 --> 00:06:50,640
‫لا تليقُ بـنا مُجاراةُ تلكَ المرأةِ المُرِيبة

89
00:06:51,690 --> 00:06:52,980
‫يا لَـهُ من لقاءٍ مَشحونٍ بالهول

90
00:06:53,780 --> 00:06:56,170
‫هذهِ هيَ المرةُ الأولى التي تَقَعُ فيها عينايَ على الخاتونِ الكبرى

91
00:06:56,170 --> 00:07:00,430
‫تبدو الخاتونُ الكبرى متقدّمةً في السنِّ بكثيرٍ عن الخاقانِ أوقطاي، أليس كذلك؟

92
00:07:00,430 --> 00:07:03,280
‫أجل، فقد كانَت مَحسوبةً على أُمَّهاتِهِ من حظايا أبيه

93
00:07:03,280 --> 00:07:03,940
‫ماذا؟

94
00:07:04,190 --> 00:07:07,920
‫كانت بوراكتشين وموكا طَوعَ قِرانِ "جنكيز خان" في الأمس

95
00:07:08,280 --> 00:07:10,810
‫فآلَت زَوجيَّتُهما إرثًا إلى الخاقانِ أوقطاي من بَعدِ والِدهِ

96
00:07:10,810 --> 00:07:11,870
‫أحَقٌّ هذا؟

97
00:07:12,310 --> 00:07:15,750
‫تِلكَ رابِطةٌ ممتدَّةٌ بينَهُما منذُ قديمِ الزَّمنِ إذن

98
00:07:15,750 --> 00:07:20,580
‫إذا قُبِضَ الأبُ، تؤولُ حرائرُهُ إرثًا للابن، ما خلا والِدَتَهُ التي أنجَبَته

99
00:07:21,310 --> 00:07:23,210
‫ذاك عُرفٌ جارٍ ومَألوفٌ في البادِية

100
00:07:26,470 --> 00:07:27,720
‫بوراكتشين...

101
00:07:30,390 --> 00:07:34,350
‫لم تُرزَق بالبنين، ولا تَنتمي لِـحَسَبِ قَبيلةٍ يُهابُ جَمعُها

102
00:07:35,320 --> 00:07:40,010
‫ويَعجزُ إدراكي في حقيقةِ صُعودِها لِـتَعتليَ عَرشَ الخاتونِ الكبرى

103
00:07:43,190 --> 00:07:49,570
‫ويُزعم أن تجرّع "الدانياو" يُحيلُ الجسد صرحًا خالدًا لا يَبيد كالذهب

104
00:07:50,060 --> 00:07:52,280
‫أرى هذا محاكِيًا تمامًا لـصناعةِ الخيمياء

105
00:07:52,750 --> 00:07:55,290
‫تُرى من حَسَبَ أنَّ للشرقِ نصيبًا من مِثلِ هذا العِلم؟

106
00:07:56,170 --> 00:07:58,250
‫جسد لا يَبيد

107
00:07:59,040 --> 00:08:00,210
‫أَتَعنينَ حُبوبَ "الدانياو"؟

108
00:08:04,120 --> 00:08:05,420
‫أَيُعقَلُ صنيعُ هذا؟

109
00:08:05,930 --> 00:08:07,610
‫الإكسير...

110
00:08:08,330 --> 00:08:11,420
‫تتكونُ خَلائطُهُ من الزِّئبقِ والكِبريت...

111
00:08:12,170 --> 00:08:14,880
‫فمَا العُنصرُ المتبقي إذن؟

112
00:08:18,680 --> 00:08:20,270
‫الخاتون توراكينا

113
00:08:20,830 --> 00:08:23,690
‫لنَعُد لمجلسِ الخاتونِ الكبرى تارةً أخرى

114
00:08:23,690 --> 00:08:26,400
‫أَمِن سببٍ يَدعونا لِلعودة؟

115
00:08:30,420 --> 00:08:32,530
‫أَيَدورُ في جَنَانكِ مَسعى مَكتومٌ إذن؟

116
00:08:35,000 --> 00:08:38,360
‫فجُودي عليَّ بـقوّتكِ ومَنعتكِ يا خاتون توراكينا

117
00:08:42,560 --> 00:08:47,220
‫الإكسير... هُوَ الترياقُ العجيبُ الذي يَهبُ الجسدَ الخلودَ الباقي

118
00:08:47,220 --> 00:08:51,550
‫وتِلكَ هيَ شَريعَةُ الخيمياءِ الفارسيةِ وجَوهرُها

119
00:08:51,780 --> 00:08:55,760
‫ومِنَ البَديهيِّ أنِّي أَعجزُ عن صياغتِهِ منفَرِدة

120
00:08:56,200 --> 00:09:01,020
‫بيدَ أنَّ مَعونةَ الخاتونِ الكبرى قَد تُمهِّدُ لنا سَبيلَ صياغتِهِ

121
00:09:01,780 --> 00:09:03,650
‫لِمَ نَفتحُ صَفحةَ هذا الحديثِ تارةً أخرى؟

122
00:09:04,010 --> 00:09:07,110
‫لأنَّ مَرامَ الخاتونِ يكمنُ في عُثورِها عليه

123
00:09:08,100 --> 00:09:09,440
‫أَفِي قولي هذا خطأٌ يا خاتون؟

124
00:09:10,960 --> 00:09:12,280
‫أحَقًّا ما تَقول؟

125
00:09:12,820 --> 00:09:16,240
‫تيقَّنتُ من هذا الأمرِ منذُ وقعت عينايَ على مَحياكِ في اللقاءِ الأول

126
00:09:16,460 --> 00:09:19,330
‫وإذا أَذِنتِ لي أن أستشفَّ من هَيبتِكِ السقيمة...

127
00:09:20,480 --> 00:09:23,830
‫أَكنتِ تَتجرَّعينَ رَهجَ الغار؟

128
00:09:23,830 --> 00:09:25,760
‫رَهجَ الغار؟

129
00:09:27,420 --> 00:09:29,710
‫هو حَجَرٌ قرمزِيٌّ يتولدُ من أفواهِ البراكين

130
00:09:29,710 --> 00:09:33,930
‫تناهى إليَّ أنَّ كَهنةَ الشرقِ يَدعونَهُ السَّندَروس

131
00:09:35,180 --> 00:09:36,530
‫إذن... صَدقَت فِراستي

132
00:09:37,230 --> 00:09:42,850
‫فرَهجُ الغارِ عُنصرٌ جَوهريٌّ لِـتركيبِ الإكسيرِ وحُبوبِ الدانياو على كُلِّ حال

133
00:09:43,580 --> 00:09:46,710
‫ووفقَ تَعاليمِ حكيمِ الطبِّ القديمِ "أبقراط"

134
00:09:46,710 --> 00:09:50,490
‫فإنَّ لِـرَهجِ الغارِ خَواصَّ عِلاجيةً نافعة، إن جُرِّعَ بـمَقاديرَ مَحدودة

135
00:09:50,960 --> 00:09:51,780
‫بيدَ أَنَّهُ...

136
00:09:52,220 --> 00:09:54,490
‫يَستحيلُ سُمًّا قاتِلًا إذا اعتادَ الجسمُ على تَجرُّعِهِ دَومًا

137
00:09:55,040 --> 00:09:59,370
‫فيَحبسُ الشَّهيةَ عنِ الطعام، وتتقرَّحُ بهِ البشرة، وتَنبتُ في الجسدِ الأورام

138
00:09:59,920 --> 00:10:02,170
‫وتِلكَ هيَ الشَّواهدُ الباديةُ على جَسدِكِ اليوم

139
00:10:03,150 --> 00:10:08,710
‫فلم يَجرعكِ أحدٌ السُّمَّ إذن؟ بل تَجرّعتِهِ بطَوعِ إرادَتِكِ؟

140
00:10:08,970 --> 00:10:12,530
‫موكا، إلى هذا الحَدِّ ذَهبَ ظَنُّكِ؟

141
00:10:13,270 --> 00:10:14,930
‫أأنتِ المَدعُوَّةُ فاطمة؟

142
00:10:14,930 --> 00:10:17,570
‫افتحي أدراجَ ذلكَ الرفِّ المعلقِ وأبصري

143
00:10:21,140 --> 00:10:22,810
‫رَهجُ الغار...

144
00:10:23,060 --> 00:10:25,520
‫لِمَ كُنتِ تتجرّعينَ مِثلَ هذا السُّمِّ يا بوراكتشين؟

145
00:10:29,680 --> 00:10:32,240
‫أَلِـرغبةٍ في الخلودِ والبقاءِ دَومًا؟

146
00:10:36,780 --> 00:10:38,160
‫أجل، هذا هو مَسعاي

147
00:10:38,160 --> 00:10:39,870
‫فَقَد دَنا منِّي مَشيبُ العمرِ وأُفولُه

148
00:10:40,380 --> 00:10:42,240
‫وأنا أَتوقُ لِـطولِ البقاءِ في الوجود

149
00:10:42,240 --> 00:10:43,580
‫بوراكتشين

150
00:10:43,980 --> 00:10:47,040
‫تجرَّعي شيئًا من هذا المقدارِ يا الخاتون بوراكتشين

151
00:10:47,610 --> 00:10:49,530
‫فهو ترياقٌ ناجعٌ لإبطالِ أثرِ السُّمِّ في جسدِكِ

152
00:11:01,560 --> 00:11:03,720
‫فمَا كُنهُ هذا الحَجرِ إذن؟

153
00:11:03,720 --> 00:11:04,970
‫هذا هو حجرُ اليادا

154
00:11:04,970 --> 00:11:06,340
‫حجرُ اليادا؟

155
00:11:06,340 --> 00:11:08,980
‫وهل لحجرِ اليادا أن يُتجرَّعَ مِثلَ العِلاج؟

156
00:11:08,980 --> 00:11:10,360
‫كلا البتة، لستِ مصيبةً في قولِكِ

157
00:11:10,360 --> 00:11:14,700
‫يُعرفُ في بلادِ فارس بـحجرِ "البازهر"، وهو ترياقٌ مَشهورٌ في إبطالِ السُّموم

158
00:11:15,240 --> 00:11:17,660
‫أَوَلَم تُحِلّي عليهِ لَعنَةً؟

159
00:11:17,660 --> 00:11:20,070
‫أَيَرسمُ ثغري ونواظري مَلامحَ خُبثٍ يا خاتون؟

160
00:11:32,860 --> 00:11:36,530
‫فمَا أرجوهُ هو طَلَبُ استدعائِنا ثانيةً متى رُدَّت إليكِ العافية

161
00:11:37,440 --> 00:11:40,890
‫وعندها... سأنقشُ بينَ يديكِ من أسرارِ الإكسيرِ ما يَسرّكِ

162
00:11:43,860 --> 00:11:45,890
‫لكِ منِّي عظيمُ الشُّكرِ والامتنان

163
00:11:45,890 --> 00:11:47,860
‫ما صنعتُ شيئًا يُذكرُ اليوم

164
00:11:47,860 --> 00:11:48,900
‫أَتستخفينَ بـصنيعِكِ إذن؟

165
00:11:49,620 --> 00:11:53,400
‫فلولا سَعيُكِ الدؤوبُ في حشدِ أطباءِ الفرسِ حولي

166
00:11:53,400 --> 00:11:56,860
‫ما تبيّنتُ مِثقالَ ذرةٍ من حقيقةِ رَهجِ الغار

167
00:11:57,620 --> 00:11:59,430
‫فمَا خُطَّتُكِ المقبلةُ تِجاهَ جغتاي؟

168
00:11:59,430 --> 00:12:04,160
‫أدركتُ تعجُّلَ مَسعانا يومَ رُمنا التقربَ فجأةً من الأميرِ جغتاي

169
00:12:04,590 --> 00:12:08,920
‫لكن... بـحَوزِنا لِـثقةِ الخاتونِ الكبرى بوراكتشين

170
00:12:08,920 --> 00:12:10,930
‫سَيتبيَّنُ لنا سَبيلُ النَّصرِ والرَّشادِ لا مَحالة

171
00:12:11,990 --> 00:12:14,300
‫سَبيلٌ يَجمعُ مَصيرَ كِلتينا إذن

172
00:12:15,100 --> 00:12:16,300
‫أجل

173
00:12:17,050 --> 00:12:18,380
‫الأمرُ مِثلَما صُغتِ قولاً

174
00:12:27,780 --> 00:12:29,350
‫ولم يَنقضِ غيرُ وقتٍ يسير

175
00:12:30,700 --> 00:12:35,210
‫حتى أَعلنَ الخاقانُ المغوليُّ بَدءَ زَحفِ جَحافِلِهِ لِـدَحرِ سُلالةِ جِين

176
00:12:46,430 --> 00:12:49,130
‫ضعي تلك السلال في الجانب الآخر

177
00:12:49,130 --> 00:12:50,180
‫يا موكا

178
00:12:51,510 --> 00:12:52,880
‫بوراكتشين

179
00:12:53,390 --> 00:12:55,700
‫أأسترددتِ كاملَ عافيتكِ لتخرجي هاهنا؟

180
00:12:56,460 --> 00:12:58,420
‫أجل، مثلما تبصر عيناكِ

181
00:12:58,420 --> 00:13:00,200
‫يعود الفضل في هذا كله لفاطمة

182
00:13:00,200 --> 00:13:00,970
‫أليس كذلك؟

183
00:13:01,930 --> 00:13:03,080
‫أصبتِ تمامًا

184
00:13:04,880 --> 00:13:07,490
‫إني مرسلة بعهد من الخاتون الكبرى بوراكتشين

185
00:13:07,930 --> 00:13:11,890
‫فهي ترغب في مكاتبةِ فاطمة والحديثِ إليها تارةً أخرى

186
00:13:15,230 --> 00:13:20,820
‫وفي العام التالي، ورغبةً في حصارِ "كايفنغ"، عاصمةِ جين

187
00:13:20,820 --> 00:13:24,520
‫التمست جحافلُ تولوي الإذنَ بعبورِ ثغورِ سلالةِ سونغ الجنوبية

188
00:13:25,540 --> 00:13:26,830
‫بيدَ أَنَّهُ...

189
00:13:27,790 --> 00:13:29,500
‫أَجَذُّوا عنقَ رسولِنا؟

190
00:13:29,970 --> 00:13:32,290
‫أأرادَت سلالةُ سونغ الجنوبيةِ بهذا الصنيعِ جَوابًا لنا؟

191
00:13:32,880 --> 00:13:34,250
‫أَنطوي المسيرَ ونقفلُ راجعين؟

192
00:13:35,830 --> 00:13:36,880
‫هيهات

193
00:13:37,220 --> 00:13:39,510
‫سنمضي صَوبَ الجنوبِ مِثلَما أجمعنا أمرًا

194
00:13:39,510 --> 00:13:42,990
‫تلقّينا ردَّهم، وإن عادَ علينا بالرفض

195
00:13:42,990 --> 00:13:47,050
‫بيدَ أنَّ سلالةَ سونغ الجنوبيةِ لن تُوارى خلفَ جدرانِ الصمتِ عِندئذ

196
00:13:49,380 --> 00:13:50,180
‫ليكن...

197
00:13:51,060 --> 00:13:53,380
‫فـحينئذٍ... سنجلبُ الفناءَ لسلالةِ سونغ الجنوبيةِ كذلِك

198
00:14:11,720 --> 00:14:13,670
‫قهرت جحافلُ تولوي مَعاقلَ الممرِّ الـحَصين

199
00:14:14,140 --> 00:14:16,590
‫ثمَّ طَوَتِ الشِّعابَ الوعرةَ والمَسالكِ الجبليةَ الـمُهلكة

200
00:14:19,130 --> 00:14:22,760
‫عجزت هذهِ الشِّعابُ الموحشةُ أن تَقِفَ ندًّا لِـعَزمنا الطاغي

201
00:14:24,140 --> 00:14:26,730
‫لا ريبَ أنَّ صنيعَنا هذا سيُبهجُ جَنَانَ الخاقانِ الأعظم

202
00:14:29,240 --> 00:14:30,860
‫أصبتَ القول

203
00:14:31,680 --> 00:14:34,820
‫إني لأوقنُ بـأنَّ شقيقي سيُسَرُّ بـهذا النبأ كبِيرَ سُرور

204
00:14:44,100 --> 00:14:45,530
‫يا ربَّ السماء...

205
00:14:46,000 --> 00:14:48,370
‫احفَظ تولوي بـجميلِ عِنايتِك

206
00:14:49,230 --> 00:14:50,490
‫مَا الداعي لِـهذا الرَّجاء؟

207
00:14:51,110 --> 00:14:55,460
‫أنتِ تَعلمينَ أنَّ والدي لا يُقهرُ في القِتال، فـلِمَ الرَّجاءُ والدُّعاءُ إذن؟

208
00:14:55,460 --> 00:14:58,630
‫وَيحَك، كيفَ تَنطقُ بـمِثلِ هذا التَّجاسرِ في مَقامِ الصَّلاة؟

209
00:14:59,280 --> 00:15:02,910
‫أنا كذلِك لا يَتطرقُ الشَّكُّ لـقلبي حَولَ هَزيمةِ تولوي في غَزوة

210
00:15:03,390 --> 00:15:04,300
‫بيدَ أَنَّ...

211
00:15:04,840 --> 00:15:07,780
‫النازِلةَ قَد تُصيبُ المَرءَ في مَواطنَ غيرِ ساحاتِ القِتال

212
00:15:08,470 --> 00:15:13,090
‫فكُلُّ ذي منعةٍ باذخةٍ مآلُهُ أن يُقابَلَ بـالفزعِ والضَّغينةِ في نفوسِ الآخرين

213
00:15:13,090 --> 00:15:15,480
‫يتعينُ عليكِ إذن الحَذرُ والحيطةُ يا أُمَّاه

214
00:15:15,850 --> 00:15:17,170
‫أنا؟

215
00:15:18,230 --> 00:15:21,320
‫فمَا لَـدى أحدٍ شأنٌ يُذكرُ بـحالي

216
00:15:24,480 --> 00:15:26,400
‫عساهُ يكونُ كذلِك إذن

217
00:15:45,180 --> 00:15:46,740
‫دُونَكِ ما طَلَبتِ

218
00:15:46,740 --> 00:15:48,760
‫بوركتِ... فلتَضَعيها عندَ ذلك الموضع

219
00:16:07,000 --> 00:16:09,220
‫أبصري، لَم تَبرد بعدُ من أثرِ المَوقد

220
00:16:09,220 --> 00:16:10,840
‫لكِ منِّي عظيمُ الشُّكرِ والثناء

221
00:16:11,690 --> 00:16:14,510
‫جئتُ لَكِ بـمَقاديرَ من "الأورومِ" الطازج يا خاتون توراكينا

222
00:16:16,400 --> 00:16:19,260
‫إنه يروقُ لي في هذا الفصلِ منَ السنة، حينَ يبلغُ أوجَ نُضجِهِ وطِيبِه

223
00:16:22,840 --> 00:16:24,130
‫مَذاقُهُ طيبٌ بحق

224
00:16:24,130 --> 00:16:28,490
‫فمعَ دُنوِّ أوانِ الخريف، سيُستغَلُّ الأورومُ لِمَخضِ الزُّبد

225
00:16:28,830 --> 00:16:31,010
‫لهذا... فَهِيَ آخِرُ مَثوبةٍ لنا من هذا المَوسم

226
00:16:31,500 --> 00:16:33,010
‫ألِمَ لا تشاركينني قَضمَهُ إذن؟

227
00:16:33,010 --> 00:16:37,520
‫أَعجزُ عن هذا، فقد وجّهتِ الخاتونُ الكبرى بوراكتشين بـطَلَبِ استدعائي الساعة

228
00:16:37,520 --> 00:16:39,340
‫أتارةً أخرى؟

229
00:16:39,340 --> 00:16:42,240
‫أستأذنُ سموكِ بالانصرافِ الساعة

230
00:16:54,230 --> 00:16:56,280
‫لا مَذمَّةَ عندي بذاك

231
00:17:00,260 --> 00:17:04,960
‫في أرجاءِ الوجود، تتشابكُ جَواهرُ المادةِ وخَواصُّها الحِسّيّة

232
00:17:05,190 --> 00:17:10,680
‫وفي الصِّياغة، يسهلُ رَدُّ المادةِ إلى جوهرٍ آخَرَ بـتبديلِ صِفاتها

233
00:17:11,210 --> 00:17:15,760
‫وخلاصةُ القول، هذا هو المغزى الكامنُ في سِفرِ جابرٍ هذا

234
00:17:16,510 --> 00:17:17,720
‫ماذا يعني ذلك؟

235
00:17:17,950 --> 00:17:19,930
‫إن أدركنا طبائعَ المَادَّةِ وخَواصَّها

236
00:17:20,200 --> 00:17:24,090
‫فـحينئذٍ يصاغُ مِنهُ كُلُّ مَبتغى، سواءٌ أكانَ سلاحًا فَتَّاكًا أم ترياقًا

237
00:17:24,090 --> 00:17:25,650
‫مَا أعجبَ ذلك صنيعًا

238
00:17:25,970 --> 00:17:27,720
‫دَعينا نأخذُ السَّندَروسَ شواهدَ مثلاً

239
00:17:27,720 --> 00:17:32,450
‫فصَهرُ رَهجِ الغارِ بالحرارةِ يُحيلُ لَونَهُ بياضًا ويزيدُ من سُمِّيَّتِهِ الـمُهلكة

240
00:17:32,990 --> 00:17:35,610
‫يَظهرُ بـأنَّ عُلماءَ الأمسِ قد دَنوا بـفَراسَتِهم من حقيقةِ الوجود

241
00:17:35,610 --> 00:17:39,660
‫سواءٌ أكانوا حُكماءَ مَوطِنكِ أم كَهَنةَ الطاويةِ في مَملكةِ الوسط

242
00:17:42,540 --> 00:17:45,200
‫الخاقانُ الأعظمُ والخاتونُ الكبرى بوراكتشين

243
00:17:45,200 --> 00:17:48,680
‫أراهما يتأمّلانِ المَسيرَ لما يَعقبُ دَحرَ سُلالةِ جِين

244
00:17:49,470 --> 00:17:52,180
‫فَقَد بَدَت رِحابُ العالمِ أوسعَ في مَطامِحِ نواظرِهما

245
00:17:56,420 --> 00:17:58,310
‫ما خطبكِ يا فاطمة؟

246
00:17:58,610 --> 00:18:04,270
‫تناهى إليَّ قولُ المولى شينقاي عن قِلَّةِ الكَتَبَة

247
00:18:04,990 --> 00:18:06,340
‫فلمَ يؤولُ الحالُ إلى ذلك؟

248
00:18:06,340 --> 00:18:11,030
‫أَولَم يَحُزِ المغولُ حُكماءَ العلمِ والمعرفةِ من أصقاعِ الأرضِ قاطبةً؟

249
00:18:12,980 --> 00:18:17,030
‫لأنَّ غالبَ أربابِ العلمِ الذين غَنِمَهمُ المغول...

250
00:18:17,310 --> 00:18:20,080
‫آلت مَنافعُهم لسيادةِ آلِ تولوي

251
00:18:20,080 --> 00:18:21,240
‫أَحَقًّا؟

252
00:18:21,240 --> 00:18:25,280
‫فمِثلَ مَواريثِ الجند، لآلِ تولوي الاستئثارُ بِهم لـكونِ عميدِهم هُوَ "الأوتشيغين"

253
00:18:25,280 --> 00:18:29,490
‫أَولَم يملكِ الخاقانُ الأعظمُ من السُّلطةِ ما يُمكِّنهُ من فَرضِ إرادته؟

254
00:18:29,490 --> 00:18:32,720
‫أَتَبغينَ من الخاقانِ الأعظمِ أن يَجتاحَ حِمى أخيهِ ويَغصبَهُ مَتاعَه؟

255
00:18:33,700 --> 00:18:34,990
‫مَعذرةً يا خاتون

256
00:18:35,820 --> 00:18:38,640
‫تفاوتٌ مَريرٌ في كِفَّةِ المَعرفةِ والعِلمِ كذلِك؟

257
00:18:39,600 --> 00:18:42,600
‫بيدَ أنَّ هذا مَسعى يَصُبُّ في مصلحةِ غايَتنا

258
00:18:43,840 --> 00:18:46,860
‫أَيَكونُ الخيرُ مَحفوفًا بـهذا المآلِ الموحش؟

259
00:18:48,570 --> 00:18:50,490
‫مَا لِي لا أرى سَبيلًا لِدَفعِ الفزعِ عن جَناني؟

260
00:18:50,950 --> 00:18:54,650
‫أن تَحوزَ حَظوةَ الجندِ والمعرفةِ جَميعًا طائفةُ آلِ تولوي وحدهم

261
00:18:55,370 --> 00:18:57,090
‫ولأجلِ هذا الحَكم...

262
00:18:57,090 --> 00:19:00,370
‫يَغدو تلاحُمُنا مع آلِ تولوي أشدَّ لُزومًا من أيِّ وقتٍ مضى

263
00:19:01,990 --> 00:19:04,540
‫بيدَ أنَّ السؤالَ يَبقى... أَيَشاطِرُنا الأميرُ تولوي مِثلَ هذا العزم؟

264
00:19:06,480 --> 00:19:09,700
‫موكا... أستأذنُكِ في الانصرافِ الساعة وتَركِنا بـمُفردِنا

265
00:19:18,100 --> 00:19:23,350
‫قبلَ أن تقودكِ موكا لحضرتي، لم تَقَع عينايَ على وَجهِكِ قَطّ

266
00:19:24,000 --> 00:19:26,140
‫فمَن تكونينَ في مَستورِ حقيقتِكِ؟

267
00:19:27,200 --> 00:19:29,400
‫لَـعَمري إنَّ جهلكِ بـحالي لَـهُوَ صَوابٌ لا شَكَّ فيه

268
00:19:32,490 --> 00:19:36,030
‫فقد قضيتُ أزماني جاريةً في مَعقِلِ الخاتونِ سورغاغتاني

269
00:19:36,950 --> 00:19:38,630
‫لِـذا... يتعينُ على الخاتونِ الحَذرُ والحيطة

270
00:19:38,630 --> 00:19:40,990
‫فإنَّ جَنَانها لم يَتخلَّ عن كبِيرِ مَطامِحِهِ بَعد

271
00:19:41,240 --> 00:19:44,030
‫في أَن تَرى الأميرَ تولوي يَعتلي عَرشَ الخاقانِ الأعظم

272
00:19:44,540 --> 00:19:47,000
‫وأن تَصيرَ هيَ ذاتُها الخاتونَ الكبرى لِـهذهِ الإمبراطورية

273
00:19:50,700 --> 00:19:52,590
‫الخاتون سورغاغتاني... أهذا صِدقٌ ما تَروين؟

274
00:19:54,620 --> 00:19:58,300
‫أدركتُ الخَبَر، وسأَحفظُ هذا التَّحذيرَ في مَكنونِ جَناني

275
00:19:59,320 --> 00:20:03,770
‫بيدَ أنَّ السؤالَ يَبقى... لِمَ بُحتِ لَنا بـأسرارِ عَميدتِكِ يا فاطمة؟

276
00:20:04,180 --> 00:20:07,230
‫فلتنتقي جَوابكِ بـحِكمةٍ ملوكية، وإلا آلت عاقِبةُ أمرِكِ للزَّوال

277
00:20:07,670 --> 00:20:10,080
‫لا ضَير... فـبِمَقدورِ عزمي كَسبُ ثِقتِها

278
00:20:10,500 --> 00:20:14,650
‫فـمَكنوناتُ نَفسِها وهَواجسُها تلوحُ جليّةً أمامَ بَصيرتي

279
00:20:15,610 --> 00:20:20,240
‫ويَعجزُ إدراكي في حقيقةِ صُعودِها لِـتَعتليَ عَرشَ الخاتونِ الكبرى

280
00:20:21,150 --> 00:20:23,630
‫فمَهما بَلغت فِطنةُ الخاتونِ الكبرى بوراكتشين وحِكمَتُها

281
00:20:23,630 --> 00:20:28,090
‫فلا ريبَ أنَّ صُفوفًا من حَسدةِ البلاطِ يتساءلونَ كـتساؤلِ الخاتونِ توراكينا

282
00:20:28,630 --> 00:20:33,130
‫ولأجلِ هذا بالذات... ستَتشبّثُ بـحِكمَتِها مَلاذًا يعززُ بَقاءَها

283
00:20:34,150 --> 00:20:39,050
‫إني لمَحتُ مَعالمَ الأملِ والرجاءِ في شَخصِ الخاقانِ أوقطاي وحَضرتِكِ أنتِ

284
00:20:40,380 --> 00:20:46,520
‫فـتِلكَ الحِكمةُ والفِطنةُ التي تَتصفانِ بها تَجعلكما الأحقَّ بـسيادةِ هذا الوجودِ وحُكمِه

285
00:20:52,010 --> 00:20:54,690
‫أبـهذا السَّدادِ تَرينَ عزمَنا يا فاطمة؟

286
00:20:58,280 --> 00:20:59,990
‫دُونَ أدنَى رَيبٍ

287
00:21:01,860 --> 00:21:06,730
‫خِلتُهَا امرأةً داهيةً لا يُؤمَنُ مَكرُهَا، فإِذَا بِهَا سَلِسَةُ القِيَاد

288
00:21:07,040 --> 00:21:09,270
‫يَتوجبُ عليَّ حَملُ هذا النبأِ للخاتونِ توراكينا دونَ إبطاء

289
00:21:09,270 --> 00:21:10,980
‫معذرةً منك...

290
00:21:11,690 --> 00:21:15,230
‫كـ-كنتُ أحاولُ صناعةَ الزُّبد...

291
00:21:15,230 --> 00:21:17,590
‫غيرَ أنِّي أفتقدُ الخبرةَ بـهذا الصنيع

292
00:21:17,590 --> 00:21:21,050
‫فمَقاديرُ الحليبِ التي حَلبناها اليومَ لم تُستغلَّ بَعد

293
00:21:21,500 --> 00:21:23,510
‫هوني عليكِ، فـسأهبُ لكِ من كَفِّي مَعونة

294
00:21:24,580 --> 00:21:26,420
‫لكِ منِّي عظيمُ الشُّكرِ والثناء

295
00:21:29,360 --> 00:21:30,980
‫الخاتون توراكينا

296
00:21:32,550 --> 00:21:33,940
‫سأَدعُهُ لحينِ انقضاءِ المَهمَّة

297
00:21:46,000 --> 00:21:47,450
‫الخاتون توراكينا؟

298
00:21:52,300 --> 00:21:54,980
‫لا داعيَ لِـهذا الارتعادِ في جَنانكِ يا توراكينا

299
00:21:56,460 --> 00:21:59,290
‫ثمةَ حديثٌ هامٌّ أودُّ مُشاطرتهُ معكِ دونَ سِواكِ

300
00:23:39,000 --> 00:23:41,150
‫في الحلقةِ القادمة: «تنغري»