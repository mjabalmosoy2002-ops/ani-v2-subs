1
00:00:06,480 --> 00:00:07,700
!اسمعي

2
00:00:08,300 --> 00:00:10,660
ألا تريدين استعادة ذلك الكتاب؟

3
00:00:18,040 --> 00:00:19,000
ماذا؟

4
00:00:28,900 --> 00:00:31,590
جادوغار

5
00:01:51,400 --> 00:01:56,400
لهب لا ينخمد

6
00:01:51,820 --> 00:01:56,850
شَهِدَ القرنُ الثّالث عشر انتفاضة إمبراطوريّة
واسعة في كلّ أرجاء أوراسيا

7
00:01:57,390 --> 00:02:00,020
"جنكيز خان، "الحاكم الشّامل

8
00:02:01,000 --> 00:02:06,440
والمعروف بخان العظيم، أسّسَ هو
وسُلالته الإمبراطوريّة المغوليّة

9
00:02:07,380 --> 00:02:10,670
رغم أنّ المغول لم يعدوا كونهم قبيلة
،صغيرة في الأصل

10
00:02:10,670 --> 00:02:17,400
في عام 1206 ميلادي، غزوا قبائلَ البادية
الأُخرى وأصبحوا قوّة كُبرى

11
00:02:17,400 --> 00:02:24,250
بعد بفترة قصيرة، اقتحموا دُولاً
مُختلفة تحدُّ البادية

12
00:02:22,640 --> 00:02:26,310
الرّبيع، 1221 ميلادي
طالقان

13
00:02:28,170 --> 00:02:30,460
الأمير الرّابع
تولي

14
00:02:28,650 --> 00:02:30,460
تحية لكم يا أخوتي

15
00:02:30,460 --> 00:02:31,710
تولي

16
00:02:32,920 --> 00:02:34,980
الأمير الثّالث
أوقطاي

17
00:02:35,400 --> 00:02:37,400
الأمير الثّاني
جغتاي

18
00:02:35,600 --> 00:02:37,050
ألم تشرب بما يكفي؟

19
00:02:38,010 --> 00:02:39,260
أهلاً بعودتك

20
00:02:38,190 --> 00:02:40,150
الأمير الأوّل
جوتشي

21
00:02:43,460 --> 00:02:45,350
كيف سارت الحملة في خوارزميا؟

22
00:02:46,830 --> 00:02:48,810
...بسلاسة، إلّا أنّنا

23
00:02:49,120 --> 00:02:51,180
خسرنا كثيراً من الجنود

24
00:02:51,440 --> 00:02:52,340
الخطأ خطئي

25
00:02:52,340 --> 00:02:54,220
تردُّد هو السّبب يا جوتشي

26
00:02:54,220 --> 00:02:56,710
كان كُلّ ما عليك فعله هو تنفيذ أوامر أبي

27
00:02:56,710 --> 00:02:58,370
!حسبكما

28
00:02:59,060 --> 00:03:02,080
ماذا عنك يا تولي؟ كنتَ في فارس؟

29
00:03:03,100 --> 00:03:03,700
أجل

30
00:03:03,700 --> 00:03:06,840
رفعتُ اسمَ جنكيز خان عالياً في المعركة

31
00:03:07,440 --> 00:03:10,970
هذا يُلائم الأوتشيغين، إمبراطورنا المُستقبليّ

32
00:03:18,330 --> 00:03:21,260
ناهيكم عن أنّني اكتسبتُ شيئاً قيّماً

33
00:03:24,170 --> 00:03:25,530
كِتاب بلسان أجنبيّ؟

34
00:03:25,530 --> 00:03:27,730
"سمعتُ بأنّه يُدعى "العناصر

35
00:03:28,730 --> 00:03:33,690
طلبتْ منّي زوجتي هذا الكِتاب
كحصّة من غنائمي

36
00:03:33,690 --> 00:03:36,460
!يا لها من امرأة مُتواضعة

37
00:03:36,460 --> 00:03:39,230
كان بمقدورها أن تطلب ذهباً
أو مُجوهرات بدلاً من ذلك

38
00:03:40,750 --> 00:03:44,500
أنا مُستعدّ لفعل المستحيل لإسعادها

39
00:03:46,120 --> 00:03:47,750
وماذا دُوِّنَ في هذا الكتاب؟

40
00:03:51,240 --> 00:03:52,340
لا أدري

41
00:03:53,690 --> 00:03:57,120
إذاً لديك عالِم يستطيع تفسير مُحتوياته؟

42
00:03:57,120 --> 00:03:58,250
لا

43
00:03:58,250 --> 00:04:01,300
هل تستطيع زوجتك قراءة اللّغات الأجنبيّة؟

44
00:04:01,300 --> 00:04:02,920
لا أعتقد ذلك

45
00:04:04,040 --> 00:04:05,220
!عجبتُ لأمرك

46
00:04:08,090 --> 00:04:12,400
وهكذا، كنتُ آمل أن أعرّف الأمير
تولي عليكِ

47
00:04:12,950 --> 00:04:14,940
أنتِ ابنة عالِم، صحيح؟

48
00:04:15,280 --> 00:04:17,700
،كنتُ لأُفضّل أن أتطوّع بنفسي بدلاً من ذلك

49
00:04:17,700 --> 00:04:20,240
لكن مع الأسف، لا أستطيع سوى
قراءة وكتابة أشياء بسيطة

50
00:04:20,950 --> 00:04:23,480
لكنّني أتعلّم اللّغات الجديدة بسرعة

51
00:04:24,820 --> 00:04:27,830
لماذا أرادَتِ الكِتاب؟

52
00:04:27,830 --> 00:04:30,140
ماذا؟ لا أملك فكرة

53
00:04:30,140 --> 00:04:31,790
إنّها لا تستطيع حتّى قِراءة ما فيه

54
00:04:31,790 --> 00:04:34,590
وطلبَتْه بدلاً من ذهب أو فضّة

55
00:04:34,590 --> 00:04:36,260
طلب غريب بصراحة

56
00:04:36,720 --> 00:04:40,000
رغم ذلك، هذه هي فُرصتك
لخدمة العائلة الإمبراطوريّة

57
00:04:40,000 --> 00:04:42,430
ولاسترجاع ذلك الكِتاب ثانية

58
00:04:42,740 --> 00:04:45,200
ليست صفقة سيّئة، أليس كذلك؟

59
00:04:47,160 --> 00:04:51,520
إمبراطور المغول؟ أخدم عائلته؟

60
00:04:51,910 --> 00:04:54,900
...لا، قبل ذلك... قبل كُلّ ذلك

61
00:04:55,340 --> 00:04:58,610
طلبَتْ منّي زوجتي هذا الكتاب

62
00:05:01,780 --> 00:05:04,920
!ماتت مولاتي بسبب ذلك؟

63
00:05:06,940 --> 00:05:11,420
المعذرة، ما حدث لعائلتكِ كان... مُؤسفاً

64
00:05:11,420 --> 00:05:13,580
لذا اسمحي لي أن أعتذر

65
00:05:13,580 --> 00:05:16,090
لكن لم يكن بيدي حيلة

66
00:05:16,340 --> 00:05:19,810
أفعل كُلّ ما باستطاعتي لكسب ودّهم

67
00:05:19,810 --> 00:05:21,970
لا أريد أن يزجّوا بي في خطوط الجبهة

68
00:05:22,510 --> 00:05:26,850
الفتيان في مثل سنّي ينتهي المطاف بهم
في الخطوط الأماميّة لحملاتهم العسكريّة

69
00:05:27,230 --> 00:05:28,720
كي نعمل كدروع بشريّة

70
00:05:31,440 --> 00:05:36,180
.لم تكبر بما يكفي لتنمو لحيةٌ في وجهك
فأخذوك أسيراً؟

71
00:05:36,180 --> 00:05:37,220
هذا صحيح

72
00:05:37,700 --> 00:05:40,030
لا، كفى كلاماً عن الماضي

73
00:05:40,030 --> 00:05:42,240
هذه هي فُرصتي لأصبح ثريّاً

74
00:05:42,240 --> 00:05:43,720
،بهذا النّظام الاجتماعيّ الجديد

75
00:05:43,720 --> 00:05:46,990
مُهِّدَ أمامنا طريقٌ نحو النّجاح يعتمد
على الجدارة والاستحقاق

76
00:05:46,990 --> 00:05:49,620
سأفعل المستحيل للصّمود والتألُّق

77
00:05:49,620 --> 00:05:52,710
الآن هي فرصتكِ للاستفادة من تعليمكِ

78
00:05:52,710 --> 00:05:54,920
ووجهكِ الفاتن هذا

79
00:05:55,260 --> 00:05:59,880
إن شاءت الأقدار، فقد تُصبحين خادمة
لشخصيّة مرموقة

80
00:06:01,560 --> 00:06:04,370
كما ترين، ابتسامتها جذّابة جدّاً

81
00:06:05,780 --> 00:06:08,540
لهذا السّبب يجدر بكِ أن تفعلي شيئاً

82
00:06:08,540 --> 00:06:10,220
لكن ماذا أفعل بالضّبط؟

83
00:06:10,830 --> 00:06:15,070
كيف لي أن أعرف المسار الّذي
يجب أن أتّخذه هنا؟

84
00:06:16,510 --> 00:06:18,110
ماذا عساني أفعل؟

85
00:06:22,100 --> 00:06:23,900
،لكن إذا درستِ وأصبحتِ حكيمة

86
00:06:23,900 --> 00:06:29,010
ستُدركين أفضل مسار من السُّلوك الّذي يجب
اتّخاذه، مهما كانت الورطة الّتي تقعين فيها

87
00:06:42,860 --> 00:06:47,340
أنا ضليعة في حكمة القُدماء
والتّعاليم الحديثة على حدٍّ سواء

88
00:06:47,760 --> 00:06:49,210
...من دون أدنى شكّ

89
00:06:49,680 --> 00:06:51,970
،أستطيع قراءة ذلك الكِتاب
عناصر إقليدس

90
00:06:54,000 --> 00:06:55,210
معك حقّ

91
00:06:57,370 --> 00:07:01,040
أريد أن أعيش حياة مُريحة وآكل
الطّعامَ كُلّ يوم

92
00:07:04,700 --> 00:07:06,840
!قد تكون هذه فُرصتي الكُبرى

93
00:07:06,840 --> 00:07:09,850
أنا متأكّدة بأنّنا نستطيع تحقيق
!ذلك إذا تعاونّا معاً

94
00:07:09,850 --> 00:07:11,620
أ-أجل

95
00:07:12,160 --> 00:07:15,840
ا-اسمي شيرا. أنحدر من سمرقند

96
00:07:17,160 --> 00:07:18,890
اسمي سيتارا

97
00:07:18,890 --> 00:07:19,980
سيتارا؟

98
00:07:20,410 --> 00:07:21,560
تمهّلي

99
00:07:21,560 --> 00:07:23,270
...اسم مُبهرَج كهذا

100
00:07:23,270 --> 00:07:26,240
أجل، أنا أمَة. هل هناك مُشكلة؟

101
00:07:28,580 --> 00:07:30,440
،قد يكون نِظاماً اجتماعيّاً جديداً

102
00:07:30,440 --> 00:07:33,100
لكن أصالة النّسب قد تجعلكِ
تقطعين شوطاً طويلاً

103
00:07:33,480 --> 00:07:36,260
لا سيّما عند التّعامل مع العائلة الإمبراطوريّة

104
00:07:37,100 --> 00:07:39,060
حسناً، بمقدوركِ أن تكذبي فحسب

105
00:07:39,480 --> 00:07:41,440
لنختر اسماً أكثر وقاراً

106
00:07:43,300 --> 00:07:44,530
...في هذه الحالة

107
00:07:46,170 --> 00:07:47,170
القائد تومين

108
00:07:47,420 --> 00:07:50,920
هذه هي الفتاة الصّغيرة الّتي تحدّثتُ عنها

109
00:07:51,510 --> 00:07:53,260
أنا مُترجمها، شيرا

110
00:07:53,630 --> 00:07:56,140
سررتُ بلقائك

111
00:07:58,240 --> 00:07:59,170
اسمعي

112
00:07:59,170 --> 00:08:04,490
أيّ شخص يُمنَح إذن بمُقابلة المغول
يجب عليه العبور بين نارين

113
00:08:04,490 --> 00:08:07,480
يعتقدون بأنّ النّار لديها قوّة تطهير الشّرّ

114
00:08:08,300 --> 00:08:10,180
طقوس وثنيّة؟

115
00:08:17,350 --> 00:08:20,810
وأيضاً، لا تدوسي قطعاً عتبةَ المدخل

116
00:08:21,290 --> 00:08:23,190
إن فعلتِ، فستموتين

117
00:08:37,430 --> 00:08:39,140
!أهلاً بكِ يا ابنة العالِم

118
00:08:40,100 --> 00:08:42,520
يسرّني أن أراكِ لا تزالين حيّة

119
00:08:42,850 --> 00:08:47,970
يقول سموّه "أهلاً بكِ يا ابنة العالِم! يسرّني
"أن أراكِ لا تزالين حيّة

120
00:08:48,520 --> 00:08:52,060
أهلاً بكِ يا ابنة العالِم! يسرّني"
"أن أراكِ لا تزالين حيّة

121
00:08:52,060 --> 00:08:53,930
"يقول بأنّ "سموّه قد قال ذلك

122
00:08:54,150 --> 00:08:56,570
أجل، تبدين أكثر طاعة بكثير الآن

123
00:08:57,070 --> 00:08:57,700
أُثني عليكِ

124
00:08:59,870 --> 00:09:01,580
هل أُبلغتِ بالتّفاصيل؟

125
00:09:02,120 --> 00:09:04,410
أريدكِ أن تخدمي زوجتي وتُفسّري
لها ذلك الكتاب

126
00:09:04,750 --> 00:09:06,210
سيُسعدها ذلك كثيراً

127
00:09:07,170 --> 00:09:08,500
بالمُناسبة. ما اسمكِ؟

128
00:09:10,270 --> 00:09:11,990
...اسمي

129
00:09:15,120 --> 00:09:18,080
فاطمة

130
00:09:25,060 --> 00:09:27,690
لن تكون هذه النّيران كافية لمحوها

131
00:09:30,430 --> 00:09:34,220
لا تلك الأيّام الرّقيقة الّتي
لم تعُد تُغادر ذاكرتي

132
00:09:35,040 --> 00:09:37,500
ولا روابطي بمولاتي والآخرين

133
00:09:39,750 --> 00:09:44,560
،إن كان هناك ما أستطيع فعله
فهو استرجاع ذلك الكِتاب

134
00:09:45,610 --> 00:09:49,570
سأبقى أمَة لمولاتي حتّى يحين ذلك اليوم

135
00:10:06,480 --> 00:10:11,210
تجنّبتُ الزجّ بي في خطوط الجبهة
بفضل توسُّط القائد

136
00:10:11,600 --> 00:10:13,270
هل هي زوجة تولي؟

137
00:10:13,270 --> 00:10:18,680
لا، ينبغي أن تكون الأميرة سرقويتي
في مُعسكر المغول الرّئيسيّ شرقاً

138
00:10:19,670 --> 00:10:22,980
ومن تكون؟ إحدى زوجات القادة العسكريّين؟

139
00:10:22,980 --> 00:10:23,890
ماذا؟

140
00:10:23,890 --> 00:10:28,560
دائماً ما يُحضر المغول عدداً من النّساء
معهم، حتّى في الحملات العسكريّة

141
00:10:28,560 --> 00:10:30,690
نساء في حملة عسكريّة؟

142
00:10:30,690 --> 00:10:33,000
لا يمكنني حتّى تصوُّر ذلك

143
00:10:35,030 --> 00:10:37,420
أوّلاً، يجب أن أعرف عنهم أكثر

144
00:10:38,590 --> 00:10:41,850
شيرا، علّمني بعض الكلمات المغوليّة البسيطة

145
00:10:41,850 --> 00:10:43,520
أريد إحراز تقدُّم بسرعة

146
00:10:43,520 --> 00:10:46,710
إذاً، بالمُقابل، أطلب منكِ أن
تُعينيني في أوقات الحاجة

147
00:10:47,290 --> 00:10:48,560
بكلّ تأكيد

148
00:10:48,560 --> 00:10:50,600
فنحن في خندق واحد، أليس كذلك؟

149
00:10:51,590 --> 00:10:55,630
الجميع هنا أعدائي

150
00:10:57,260 --> 00:11:01,810
سأقاتل حتّى الرّمق الأخير، مهما كنتُ وحيدة

151
00:11:13,910 --> 00:11:16,360
توراكينا، بحثتُ عنكِ في كلّ مكان

152
00:11:16,780 --> 00:11:18,030
سموّ الأمير أوقطاي

153
00:11:20,780 --> 00:11:25,500
عجبتُ لأمرك. ولا كلمة امتنان واحدة حتّى
لزوجكِ العائد من المعركة؟

154
00:11:26,590 --> 00:11:30,040
لستُ زوجتك

155
00:11:30,520 --> 00:11:32,220
أنا عدوّتك

156
00:11:41,580 --> 00:11:43,920
في عام 1221

157
00:11:44,230 --> 00:11:48,220
،بعد فترة وجيزة من الرّاحة في طالقان
...شدّ الجيشُ المغولي الرّحال

158
00:11:49,290 --> 00:11:52,430
مرّة أُخرى في الخريف

159
00:11:53,430 --> 00:11:56,950
:إحدى القوى العظيمة في آسيا الوسطى
الإمبراطوريّة الخوارزميّة

160
00:11:57,620 --> 00:12:01,870
توجّه المغول جنوباً لقهر حاكمها الأخير

161
00:12:02,680 --> 00:12:08,280
وسُجِّلَ هذا الصِّراع في التّاريخ
تحت مُسمّى معركة السّند

162
00:12:10,510 --> 00:12:12,840
،في هذه الأثناء، بعيداً عن أضواء التّاريخ

163
00:12:12,840 --> 00:12:18,620
أولئك الّذين أُسِروا في فارس استمرّوا في زحفهم
الطّويل نحو المُعسكر الرّئيسيّ للمغول

164
00:12:19,230 --> 00:12:20,890
مضى نصف عام

165
00:12:20,890 --> 00:12:22,800
كم سيستغرق ذلك من وقت؟

166
00:12:22,800 --> 00:12:24,220
!توقّفوا

167
00:12:27,110 --> 00:12:29,370
!ابدؤوا بتنصيب الخِيَم حالاً

168
00:12:29,370 --> 00:12:34,160
ثمّة ضيف مُوقَّر لجنكيز خان قادم
إلى هنا من جهة الشّرق

169
00:12:34,160 --> 00:12:37,320
علينا أن ننصب مُخيّماً ونُوفِّر له مبيتاً لهذه اللّيلة

170
00:12:44,880 --> 00:12:46,700
أستطيع مُساعدتك

171
00:12:47,630 --> 00:12:50,290
لا، هذا عملٌ للرّجال

172
00:12:55,800 --> 00:12:57,370
حسناً

173
00:12:59,400 --> 00:13:03,930
ما زلتُ أجهل الكثير من نهج حياة المغول

174
00:13:04,440 --> 00:13:07,100
لكن رويداً رويداً، بدأتُ أفهمه

175
00:13:09,430 --> 00:13:12,150
جميعهم بائسون من دوني

176
00:13:12,150 --> 00:13:16,840
على سبيل المثال، جهة مداخل خِيَمهم
جنوباً دوماً

177
00:13:16,840 --> 00:13:19,320
!أنتما! حان وقت تقديم الماء للماشية

178
00:13:19,320 --> 00:13:23,530
بالإضافة إلى ذلك، يتّبعون جدولاً
زمنيّاً صارماً

179
00:13:26,790 --> 00:13:30,840
أتساءل كيف يُواكبون الوقت يا تُرى؟

180
00:13:37,980 --> 00:13:40,460
فهمت. إنّها مِزوَلة

181
00:13:40,830 --> 00:13:44,220
حيث الضّوء الّذي يدخل إلى المنزل
يُحدّد لهم السّاعة

182
00:13:46,120 --> 00:13:49,290
هذا ذكيٌّ جدّاً. يستخدمون المنزل بأكمله كساعة

183
00:13:50,840 --> 00:13:54,720
لكن الأسطرلاب كان ليُحدّد
السّاعة بدقّة أكبر

184
00:13:54,720 --> 00:13:56,750
هذه ليست إلّا حكمة الهمج

185
00:14:06,280 --> 00:14:07,430
هل سمعتِ؟

186
00:14:07,430 --> 00:14:11,960
ضيف اللّيلة هو حكيم شرقيّ يعلم
بسرّ الخلود حسبما قالوا

187
00:14:11,960 --> 00:14:13,240
الخلود؟

188
00:14:13,240 --> 00:14:14,880
المعذرة

189
00:14:14,880 --> 00:14:18,860
نحن أويغوريّون من المدينة المُجاورة

190
00:14:18,860 --> 00:14:21,700
أتينا لتقديم هِبة للمُعلّم الحكيم

191
00:14:21,700 --> 00:14:23,430
هلّا دللتمونا إليه؟

192
00:14:23,430 --> 00:14:24,140
ماذا؟

193
00:14:24,140 --> 00:14:25,760
لا، أنا خائفة جدّاً

194
00:14:25,760 --> 00:14:26,800
...لكن

195
00:14:27,040 --> 00:14:31,380
أعترف بأنّ فكرة الخلود مُخيفة
...جدّاً. رغم ذلك

196
00:14:34,230 --> 00:14:35,940
تفضّلوا من هنا

197
00:14:36,820 --> 00:14:38,400
أهذا أنت يا زعيم القبيلة؟

198
00:14:38,400 --> 00:14:40,080
!تشينقاي

199
00:14:40,080 --> 00:14:42,700
كنتَ تُرافق الحكيم؟

200
00:14:42,700 --> 00:14:46,450
اعذرني. قصدتُ أن أُناديك بفخامتك تشينقاي

201
00:14:46,450 --> 00:14:50,200
لا حاجة لذلك. أعنتني كثيراً عندما
كنتُ مُجرّد بائع مُتجوّل

202
00:14:50,740 --> 00:14:52,430
لأحل المُعلّم الحكيم

203
00:14:52,430 --> 00:14:56,420
خمر وخبز وبطّيخ من مدينتنا جانباليق

204
00:14:56,420 --> 00:14:58,130
!بـ-بطّيخ

205
00:14:58,600 --> 00:15:01,340
يبدو شهيّاً. تفضّل بالدّخول لو سمحت

206
00:15:02,170 --> 00:15:04,040
خذي. أحضري هذا

207
00:15:04,040 --> 00:15:04,800
ماذا؟

208
00:15:05,390 --> 00:15:07,760
...ا-المعذرة، أنا لستُ

209
00:15:08,630 --> 00:15:10,600
ما الأمر؟ اتبعيهن

210
00:15:10,600 --> 00:15:11,720
...لكن

211
00:15:14,360 --> 00:15:16,190
خالد؟

212
00:15:16,870 --> 00:15:18,910
لا يمكن أن يوجد شخصٌ كهذا

213
00:15:18,910 --> 00:15:21,150
سأذهب وأتبيّن الحقيقة بنفسي

214
00:15:26,700 --> 00:15:28,200
اسمحوا لي أن أقدّمه لكم

215
00:15:28,200 --> 00:15:34,960
استُدعي بواسطة خان العظيم، ويشقّ
:طريقه حاليّاً نحو الغرب

216
00:15:34,960 --> 00:15:38,830
الحكيم، المُعلّم تشانغتشون

217
00:15:38,830 --> 00:15:41,090
عاش لمئتي عام؟

218
00:15:41,090 --> 00:15:43,200
!أنا خائفة

219
00:15:43,200 --> 00:15:44,930
الهِبة لو سمحتِ

220
00:15:55,430 --> 00:15:57,890
يطلب المُعلّم تشانغتشون التّالي

221
00:15:58,410 --> 00:16:02,360
هل رأى أحدٌ هنا الكسوفَ الّمسيّ"
"في اليوم الأوّل من الشّهر الخامس؟

222
00:16:03,590 --> 00:16:05,370
الكسوف الشّمسيّ؟

223
00:16:05,370 --> 00:16:07,070
أجل، شاهدتُ واحداً بالفعل

224
00:16:07,380 --> 00:16:09,030
أثناء ساعة الأفعى

225
00:16:09,380 --> 00:16:12,740
حوالي 7 من 10 من حجم الشّمس قد حُجِب

226
00:16:12,960 --> 00:16:14,830
أ-أنا أيضاً

227
00:16:15,370 --> 00:16:17,180
رأيتُ ذلك كذلك

228
00:16:17,930 --> 00:16:23,500
ف يذلك اليوم، بينما أمرُّ بالقرب من سمرقند

229
00:16:23,960 --> 00:16:30,470
.أصبحت السّماء مُظلِمة قليلاً
وحُجِبَ حوالي 6 من 10 من حجم الشّمس

230
00:16:33,230 --> 00:16:35,100
وتشكّلتْ ظِلال هلاليّة خلف الشّجر

231
00:16:36,260 --> 00:16:37,680
كسوف شمسيّ

232
00:16:38,810 --> 00:16:42,060
لعلّ السّيّد مُحمّد قد دوّنَ هذا

233
00:16:42,060 --> 00:16:44,750
لكن لا أعرف السّاعة بالضّبط الآن

234
00:16:48,470 --> 00:16:51,320
في ذلك الوقت. ضوء من الشّمس

235
00:16:52,220 --> 00:16:56,750
أشرقَ على حافّة أعمدة السّقف. في الخيمة

236
00:16:57,990 --> 00:17:00,340
تشير حافّةُ أعمدة السّقف إلى ساعة التنّين

237
00:17:00,340 --> 00:17:04,210
بصيغة أُخرى، بدأ الكسوفُ في وقت
لاحق في هذه الأرجاء؟

238
00:17:04,210 --> 00:17:09,280
شَهِدَ فخامته تشانغتشون الكسوفَ
في نهر خيرلن شرقاً

239
00:17:09,280 --> 00:17:10,440
كان الوقت في مُنتصف النّهار

240
00:17:10,440 --> 00:17:11,930
أي في وقت لاحق أكثر

241
00:17:13,640 --> 00:17:16,270
كان قادراً على رؤية النُّجوم في السّماء

242
00:17:17,610 --> 00:17:20,310
هناك درجات مُختلفة من الكسوف كذلك؟

243
00:17:22,920 --> 00:17:27,290
أثناء كسوف شمسيّ، يطلق القمر"
"ظلّه على الشّمس

244
00:17:27,290 --> 00:17:32,070
يمكن للمرء أن يُشبّه ذكل بحجم"
"هذه النّار بمروحة

245
00:17:32,710 --> 00:17:35,060
،حيث أجلس، النّار غير مرئيّة"

246
00:17:35,060 --> 00:17:37,490
"لكن بقيّتكم ترون مشهداً مُختلفاً

247
00:17:39,390 --> 00:17:42,590
العالم مكانٌ واسع بالفعل

248
00:17:44,920 --> 00:17:48,920
أنا آسف لأنّني لم أُدرك
بأنّكِ لم تكوني معهم

249
00:17:49,670 --> 00:17:52,790
أنا تشينقاي، أويغوريّ

250
00:17:52,790 --> 00:17:56,140
تعلّمتُ قليلاً من الفارسيّة في أيّامي
كبائع مُتجوّل

251
00:17:57,120 --> 00:18:00,150
ا-اسمي فاطمة

252
00:18:00,150 --> 00:18:04,270
أسافر شرقاً كي أخدم عقيلة الأمير تولي

253
00:18:04,270 --> 00:18:06,940
زوجة تولي، الأميرة سرقويتي ؟

254
00:18:08,020 --> 00:18:10,290
أنتِ خادمتها إذاً؟

255
00:18:10,290 --> 00:18:12,990
الذّكاء الّذي أظهرتِه ليس مُستغرَباً

256
00:18:13,440 --> 00:18:15,160
هذا لطفٌ منك

257
00:18:15,790 --> 00:18:17,620
...إذاً، المعذرة

258
00:18:18,000 --> 00:18:22,210
،هل لي أن أسأل... عذراً
كم عمر المُعلّم الحكيم؟

259
00:18:24,550 --> 00:18:27,130
تريدين معرفة المزيد عن الخلود؟

260
00:18:27,610 --> 00:18:33,040
مع الأسف، لا أستطيع أن أكشف
سرّه لكِ قبل خان العظيم

261
00:18:34,670 --> 00:18:38,300
لا، لستُ مُهتمّة بأن أُصبح خالدة

262
00:18:38,680 --> 00:18:41,820
كان هناك قصّة في كِتاب قرأتُه ذات مرّة

263
00:18:42,510 --> 00:18:46,520
كان عن رجل سافرَ إلى الهند
بحثاً عن العمر المديد

264
00:18:46,520 --> 00:18:48,280
لكن الرّجال الّذين عثرَ عليهم هناك

265
00:18:48,280 --> 00:18:52,280
كانوا يهتمّون بآبائهم وأجدادهم الطّاعنين
في السنّ لدرجة لا يستطيعون حتّى الوقوف

266
00:18:52,750 --> 00:18:54,170
...بالإضافة إلى ذلك

267
00:18:54,170 --> 00:18:55,700
والد جدّي

268
00:18:55,700 --> 00:18:59,160
يجب أن أُغطّيه بهذا الشّرشف
لألّا تقرضه الجرذان

269
00:18:59,560 --> 00:19:02,660
رغم ذلك، إنّه حيّ ومُبارَك بطول العمر

270
00:19:03,370 --> 00:19:07,210
بعد أن سمع هذا، لم يعُد الرّجلُ
يبتغي حياةً مديدة

271
00:19:08,680 --> 00:19:11,850
،بدلاً من اكتساب الخلود بعصيان اللّه

272
00:19:11,850 --> 00:19:15,180
من الأفضل تقبُّل موت سليم وطبيعيّ
بصدرٍ رحب

273
00:19:15,180 --> 00:19:17,220
كانت تلك العبرة الأخلاقيّة من الحكاية

274
00:19:18,830 --> 00:19:22,430
في الواقع، أفشى المُعلّمُ تشانغتشون السّرَّ لي

275
00:19:22,820 --> 00:19:24,890
سرّ الخلود

276
00:19:27,210 --> 00:19:31,770
أنتِ فتاة لامعة الذّكاء، لذا سأخبركِ
بالسّرّ كحالة استثنائيّة

277
00:19:32,000 --> 00:19:35,110
...سرّ الخلود هو

278
00:19:37,770 --> 00:19:38,970
غير موجود...

279
00:19:38,970 --> 00:19:41,650
يجب علينا جميعاً أن نتقبّل الموت
السّليم والطّبيعيّ بصدرٍ رحب

280
00:19:45,340 --> 00:19:47,900
الحُكماء مُنتشرون شرقاً وغرباً

281
00:19:48,970 --> 00:19:52,970
قد تكون إمبراطوريّتنا عظيمة، لكن
لا تزال فتيّة أيضاً

282
00:19:52,970 --> 00:19:55,420
هناك أشياء كثيرة يجب علينا تعلّمها

283
00:19:55,660 --> 00:20:00,280
فاطمة، حكمتكِ هي شيء نحن
بأمسّ الحاجة له

284
00:20:11,650 --> 00:20:15,400
مُهِّدَ أمامنا طريقٌ نحو النّجاح يعتمد
على الجدارة والاستحقاق

285
00:20:16,500 --> 00:20:19,860
ماذا عساني أفعل؟

286
00:20:20,710 --> 00:20:23,790
أنوي... خوض رحلة

287
00:20:25,130 --> 00:20:27,040
...آنذاك

288
00:20:28,940 --> 00:20:31,730
لماذا شعرتُ بإحباط كهذا؟

289
00:20:36,440 --> 00:20:39,800
بعد أشهر عديدة

290
00:20:39,800 --> 00:20:41,720
!استمرّوا في السّير! اقتربنا من الوصول

291
00:20:48,000 --> 00:20:49,600
لقد عدنا

292
00:20:58,940 --> 00:21:02,730
وفقاً لخريطة العالم للبيروني
...الّتي رأيتُها

293
00:21:03,840 --> 00:21:06,720
أجد نفسي الآن في أطرافها

294
00:21:14,090 --> 00:21:15,040
!البرد قارس

295
00:21:15,340 --> 00:21:17,110
!لـ-لا أصدِّق برودة الطّقس هنا

296
00:21:17,110 --> 00:21:18,810
!أنا أتجمّد

297
00:21:18,810 --> 00:21:20,160
ارتدي هذه

298
00:21:20,680 --> 00:21:23,260
أهلاً بكم في أوردا الأميرة سرقويتي

299
00:21:23,260 --> 00:21:27,560
حضّرتْ سموّها معاطفَ وخِيَم دافئة لكم

300
00:21:35,750 --> 00:21:37,730
هل ثمّة فتاة تُدعى فاطمة هنا؟

301
00:21:43,490 --> 00:21:46,450
سموّ الأميرة سرقويتي، لقد أحضرتُها

302
00:21:53,160 --> 00:21:57,340
زوجة تولي الأولى
سرقويتي بيجي

303
00:21:53,160 --> 00:21:57,340
شكراً على خوض كلّ هذه الرّحلة
الطّويلة إلى هنا وسط البرد

304
00:22:00,970 --> 00:22:04,590
أنتِ من سيُعلّمني هذا الكتاب، صحيح؟

305
00:23:38,060 --> 00:23:43,250
أوتشيغين

306
00:23:38,630 --> 00:23:41,040
"الحلقة القادمة: "أوتشيغين