1
00:00:12,480 --> 00:00:13,450
‫ماذا تَقُول؟

2
00:00:14,160 --> 00:00:16,990
‫أَرفَضَتِ الخاتونُ سورغاغتاني هذا القِران؟

3
00:00:16,990 --> 00:00:18,560
‫أجل، داخلَتني الدهشةُ أنا كذلِك...

4
00:00:18,560 --> 00:00:20,160
‫ما مآلُ الخاتونِ توراكينا إذن؟

5
00:00:20,160 --> 00:00:23,900
‫فـدُونَ إتمامِ هذا القِران، هيهاتَ أن تَستردَّ حُريَّتَها

6
00:00:23,900 --> 00:00:25,440
‫فمَا مَوقفُ الخاتونِ الكبرى بوراكتشين؟

7
00:00:25,440 --> 00:00:26,580
‫هَوِّني عليكِ

8
00:00:26,580 --> 00:00:28,450
‫سأَبسطُ لكِ جليّةَ الأمرِ برُمّتِه

9
00:00:31,420 --> 00:00:33,170
‫يا سورغاغتاني بيكي

10
00:00:33,780 --> 00:00:36,040
‫إنَّ هذا القِرانَ لَـيَصُبُّ في خَيرِ مَعشرِ المغول

11
00:00:36,040 --> 00:00:38,370
‫ويَعودُ بالنَّفعِ الجَمِّ على شأنِكِ كذلِك

12
00:00:39,220 --> 00:00:42,210
‫فـاقبلي طائعةً هذهِ اليَدَ التي نَبسطُها إليكِ

13
00:00:44,570 --> 00:00:46,770
‫لكِ منِّي وافرُ الامتنانِ على هذا العَطفِ والنَّظَر

14
00:00:47,450 --> 00:00:48,840
‫بيدَ أنَّ...

15
00:00:48,840 --> 00:00:54,350
‫أُمَّنا الكبرى ألان قوا، أفضت يومًا لِـبَنيها الخمسةِ بـمَوعظة

16
00:00:54,350 --> 00:00:56,800
‫السهمُ الواحدُ يَنكسرُ بـأهونِ سَبيل

17
00:00:56,800 --> 00:00:59,660
‫أما حِزمةُ السِّهامِ المجتمعة، فـهيهاتَ لـيَدٍ أن تَكسِرَها

18
00:01:00,380 --> 00:01:04,810
‫أيها الخاقانُ الأعظم، لَـطالما مَثَّلَ تولوي أحدَ تِلكَ السِّهامِ المَنِيعةِ في كِنانتِكم

19
00:01:05,160 --> 00:01:11,340
‫ويَقعُ على عاتقي اليومَ رِعايةُ بَنيهِ الصِّغار، لِيَغدوا سِهامًا صُلبةً تَذودُ عن حِماكم

20
00:01:13,400 --> 00:01:15,380
‫إذن... أَيَرومُ حِمى آلِ تولوي الاستقلالَ بـأمرِه؟

21
00:01:15,700 --> 00:01:18,700
‫تأبينَ أن يَندمجَ مَعقلُكم في حِياضِ آلِ أوقطاي؟

22
00:01:19,880 --> 00:01:23,140
‫وإني لَـعلى يَقينٍ من أنَّ كُبَراءَ أتباعِكم يُشاطرونَنا هذا التَّدبير

23
00:01:23,140 --> 00:01:24,970
‫أَوَلا تُشاطِرُنا هذا الرَّأيَ أيُّها القائدُ إيلوجاي؟

24
00:01:24,970 --> 00:01:26,590
‫بَـ-بلى...

25
00:01:26,590 --> 00:01:29,480
‫فأنتَ كَبيرُ الأتباعِ وخَيرُ مَن يَخدمُ آلَ أوقطاي

26
00:01:29,480 --> 00:01:32,940
‫وحتى أَنفسَ ذَخائره، وَضَعَها الخاقانُ بـيمينِكَ أمانةً

27
00:01:32,940 --> 00:01:35,600
‫بُرهانًا جَليًّا على عِظَمِ ثِقَتِهِ بـصِدقِ وَلائك

28
00:01:37,480 --> 00:01:39,160
‫أَكَنزًا تَقصدُ...؟

29
00:01:39,160 --> 00:01:41,480
‫أَتَقبعُ الخاتونُ توراكينا في حَوزَتِه...؟

30
00:01:41,480 --> 00:01:42,410
‫أجل

31
00:01:42,680 --> 00:01:44,800
‫إنّها في حِمى القائدِ إيلوجاي

32
00:03:19,130 --> 00:03:21,210
‫أَرى سِيماءَ العَتبِ والضَّيقِ باديةً على مُحيَّاكِ

33
00:03:23,320 --> 00:03:26,990
‫وَفَدَ إلينا رَسولٌ من قِبلِ الخاتونِ سورغاغتاني غَداةَ هذا اليوم

34
00:03:27,620 --> 00:03:34,060
‫تُعلنُ فيها النُّزولَ عن أربعةِ آلافِ سُرادقٍ من رَعايا آلِ تولوي لِـصالحِ الخاقان

35
00:03:34,550 --> 00:03:39,010
‫وهذا عَينُ الإقليمِ والـحِمى الذي رُمتُ انتزاعَهُ من يَدِها منذُ البَدء

36
00:03:40,700 --> 00:03:42,570
‫إنها تَسبقُ مَكائدي بـدَهائِها الخَبيء

37
00:03:44,680 --> 00:03:47,730
‫أَأَثَارَ صَنيعي هذا لَواعِجَ غَضَبِك؟

38
00:03:48,340 --> 00:03:50,760
‫أَوكيفَ لِـمِثلي أن يُلقيَ اللَّومَ عليكِ؟

39
00:03:50,760 --> 00:03:54,700
‫باتَ بـوُسعي الساعةَ إمضاءُ خُططي وتشييدُ حاضِرتي

40
00:03:54,700 --> 00:03:56,380
‫ويَرجعُ الفضلُ في هذا كُلِّهِ لِـحُسنِ تَدبيرِكِ

41
00:03:58,300 --> 00:03:59,930
‫غيرَ أنِّي أَقصِرُ عليكِ رَجاءً واحدًا لا غَير

42
00:04:00,760 --> 00:04:04,400
‫دَعي توراكينا بـمَعزِلٍ عن مَكائدِ هذا الصِّراعِ منَ الآنَ فصاعدًا

43
00:04:05,130 --> 00:04:08,100
‫فـإنَّ لَـها في مَكنونِ جَناني مَنزلةً لا يَدنو منها أحَد

44
00:04:10,520 --> 00:04:12,130
‫أَعي قَولَكَ هذا

45
00:04:13,510 --> 00:04:16,650
‫يَمضي الأميرُ كيوك والمولى قاداق صَوبَ دِيارِ إيلوجاي الساعة

46
00:04:17,290 --> 00:04:21,160
‫فالقائدُ إيلوجاي هُوَ مُؤدِّبُ الخاقانِ ومُعلِّمُهُ منذُ سالِفِ السنين

47
00:04:21,160 --> 00:04:24,320
‫وتُقارعُ مَهابتُهُ مَنازلَ سُلالةِ الأُمراءِ أنفُسِهم

48
00:04:24,320 --> 00:04:28,990
‫فلا يَقوى حتى أميرٌ كـكيوك على اجتياحِ ثُغورِهِ بـغيرِ حُجَّةٍ بالغة

49
00:04:28,990 --> 00:04:31,200
‫أسرِع في مَسيرِكَ يا شيرا

50
00:04:31,200 --> 00:04:33,330
‫تَشبَّثي بـالرِّكابِ جَيِّدًا

51
00:04:33,620 --> 00:04:34,790
‫لكَ منِّي جَزيلُ الشُّكر

52
00:04:36,470 --> 00:04:38,620
‫إنَّ دَربَنا المقبلَ لَـشاقٌّ وَعِر

53
00:04:50,660 --> 00:04:52,180
‫مَعذرةً يا خاتون توراكينا، أنا...

54
00:04:55,100 --> 00:04:57,660
‫أَخلطتِ بيني وبينَ تلكَ الضيفةِ تارةً أخرى؟

55
00:04:57,660 --> 00:05:00,160
‫أرجو المَعذرة، لم أقصدِ الإزعاج

56
00:05:01,770 --> 00:05:06,440
‫أَعجزُ عن تمييزِ السُّرادقِ المنشودِ بينَ كثرةِ السُّرادقات

57
00:05:08,920 --> 00:05:11,240
‫يا لَـشرفِ هذهِ الزيارة، أيُّها الأميرُ كيوك

58
00:05:11,240 --> 00:05:13,660
‫فمَا الذي قادَ رِكابَ سُموِّكم إلى حِمى دياري؟

59
00:05:15,610 --> 00:05:18,220
‫الخاتونُ توراكينا تَمكثُ في ديارِكم هاهنا

60
00:05:18,220 --> 00:05:19,790
‫ونَرغبُ في لقائِها ومُحادثتِها

61
00:05:19,790 --> 00:05:22,380
‫لا عِلمَ لـجَناني بـمَا تُشيرانِ إليه

62
00:05:23,340 --> 00:05:28,080
‫ما شَدَدنا الرِّحالَ إليكم رَجمًا بـالظُّنون

63
00:05:28,080 --> 00:05:31,350
‫ويَطولُ شرحُ هذا الخطب، فأَرعِنا سَمعَكَ جَلِيًّا

64
00:05:36,550 --> 00:05:42,170
‫قاداق يَصرفُ أنظارَهم، وعلينا استطلاعُ أَمرِ الخاتونِ توراكينا والتَّيقّنُ من سلامتِها

65
00:05:42,620 --> 00:05:44,090
‫لكن كيفَ يَهتدي خَطوُنا لـمَوضعِها؟

66
00:05:44,090 --> 00:05:47,320
‫فإن عُثِرَ علينا، فلن يَكونَ جزاؤُنا سوى قطعِ الرِّقاب...

67
00:05:47,320 --> 00:05:48,780
‫مَـ-مهلًا يا فاطمة

68
00:05:51,540 --> 00:05:52,540
‫اسلكي هذا المسار

69
00:05:53,580 --> 00:05:55,540
‫أَمامَنا مُعضِلةٌ لا يُستَهانُ بها

70
00:05:55,540 --> 00:06:00,030
‫يُفرَضُ علينا كتمانُ مَقامِ الخاتونِ توراكينا هاهنا عنِ العُيون

71
00:06:06,770 --> 00:06:08,780
‫ما خطبُك؟ أسرِع بالمسير

72
00:06:08,780 --> 00:06:09,630
‫طَوعَ أمرِك

73
00:06:10,330 --> 00:06:12,330
‫فمَا شأنُ الخاتونِ توراكينا الساعة؟

74
00:06:12,330 --> 00:06:15,040
‫عاينتُها قُبيلَ لحظات، وهيَ على ذاتِ الحال

75
00:06:18,320 --> 00:06:19,870
‫أَتناهى القولُ لِـمَسامعِكِ؟

76
00:06:19,870 --> 00:06:21,980
‫ثَبَتَ أنَّها سالمةٌ معافاة

77
00:06:21,980 --> 00:06:23,360
‫فـلنقفل راجعينَ الساعة...

78
00:06:23,360 --> 00:06:24,750
‫مَـ-مهلًا

79
00:06:33,430 --> 00:06:35,840
‫أرجو المَعذرةَ يا خاتون لتأخُّري

80
00:06:35,840 --> 00:06:37,250
‫أحضرتُ إليكِ طَعامكِ

81
00:06:38,360 --> 00:06:39,540
‫تأخّرتِ

82
00:06:39,540 --> 00:06:42,880
‫المعذرة، ضَللتُ سبيلي تارةً أخرى بينَ السُّرادق

83
00:06:49,580 --> 00:06:50,930
‫أَلا يَحملُ إناؤُكِ شيئًا منَ "الأوروم"؟

84
00:06:51,920 --> 00:06:55,240
‫انقضى مَوسمُ "الأورومِ" الطازجِ منذُ أزمان

85
00:06:55,240 --> 00:06:57,260
‫ما كانَ قولي إلا استفهامًا عابرًا

86
00:06:57,260 --> 00:06:58,330
‫تَنحَّي عن ناظري

87
00:06:58,330 --> 00:07:00,220
‫حـ-حسنًا

88
00:07:13,460 --> 00:07:14,970
‫فاطمة...

89
00:07:15,930 --> 00:07:21,440
‫الخاتون توراكينا

90
00:07:21,440 --> 00:07:23,770
‫تريّثي... لِـنَقفل راجعين

91
00:07:25,250 --> 00:07:28,210
‫ما أعسرَ إرضاءَ الخاتونِ توراكينا

92
00:07:51,500 --> 00:07:52,530
‫الخاتون توراكينا

93
00:07:52,530 --> 00:07:54,200
‫فاطمة...؟

94
00:07:54,680 --> 00:07:56,220
‫مَا الذي قادَ خُطاكِ صَوبَ هذا الموضع؟

95
00:07:56,220 --> 00:07:58,570
‫أنتِ سالِمة... طالَ بـيَ البحثُ عن سموِّكِ

96
00:07:58,570 --> 00:08:00,370
‫أخيرًا... جادَتِ الأقدارُ بـلقائِنا تارةً أخرى

97
00:08:03,980 --> 00:08:05,050
‫إني...

98
00:08:05,530 --> 00:08:07,710
‫غَدَرتُ بـكِ

99
00:08:11,050 --> 00:08:13,500
‫الخاتون توراكينا... أبصري

100
00:08:15,350 --> 00:08:17,710
‫حَفِظتِ عَهدَنا...

101
00:08:18,100 --> 00:08:19,630
‫أنفسَ مَطالبي...

102
00:08:20,650 --> 00:08:22,910
‫وأعظمَها شأنًا...

103
00:08:23,780 --> 00:08:24,780
‫بل...

104
00:08:26,020 --> 00:08:28,240
‫مَطلَبَنا المشترك

105
00:08:32,370 --> 00:08:34,730
‫أَفضَت إليَّ الخاتون الكبرى بـحديث...

106
00:08:36,250 --> 00:08:40,200
‫قضيتُ أزمانًا في خِدمةِ الخاتون خولان

107
00:08:41,450 --> 00:08:42,480
‫خولان؟

108
00:08:43,140 --> 00:08:46,240
‫تلك التي أَنارت بصيرتي بـبهجةِ الحياة

109
00:08:46,240 --> 00:08:51,120
‫وجادَت بـنفسِها للمغول فِداءً لِـحقنِ دماءِ مَن تبقّى من معشرِ الميركيت

110
00:08:51,120 --> 00:08:52,190
‫خولان...

111
00:08:54,200 --> 00:08:57,850
‫طالما استشعرتُ لواعجَ الكمدِ والغيظِ في جَنَانِها

112
00:08:57,850 --> 00:09:02,390
‫ولا ريبَ في أنَّ جَمرَ الضغينةِ ضدَّ المغولِ لم يَخمد في صَدرِها حتى الساعة

113
00:09:02,900 --> 00:09:04,410
‫أَحَقٌّ ما تقولين؟

114
00:09:05,590 --> 00:09:08,490
‫فدَعيني أبسط لكِ يَدَ العون

115
00:09:10,600 --> 00:09:14,140
‫لِـتُنفِذي مَرامَها وتَثأري لِـعَهدِها

116
00:09:15,400 --> 00:09:18,270
‫خِلتُ أنَّ سانحةَ الفتكِ بـأوقطاي دَنَت أخيرًا

117
00:09:19,030 --> 00:09:23,160
‫وحذَّرتني الخاتون الكبرى كذلك من الركونِ إلى ثِقتِكِ

118
00:09:26,180 --> 00:09:27,370
‫يا لَـحماقةِ بصيرتي

119
00:09:28,090 --> 00:09:30,060
‫انقدتُ لـزَيفِ مَكائدِها طائعة

120
00:09:30,060 --> 00:09:33,210
‫فغَدَرتُ بـعهدِ خولان وبـثِقتكِ معًا

121
00:09:36,380 --> 00:09:37,760
‫يا خاتون توراكينا...

122
00:09:39,050 --> 00:09:42,240
‫داخَلتني أنا كذلِك وساوسُ ضَعفٍ مُرِيبة

123
00:09:43,640 --> 00:09:48,130
‫يومَ رُمتُ طَيَّ الماضي ونِسيانَه لِـأمضيَ في دربي

124
00:09:50,250 --> 00:09:53,230
‫وما ذاك إلا نَكثٌ لِـعهدي معكِ

125
00:09:54,780 --> 00:09:58,110
‫أراها أطالتِ المكوثَ والحديث

126
00:09:58,110 --> 00:10:00,700
‫علينا الارتحالُ قبلَ أن يَفتضحَ أمرُنا

127
00:10:01,910 --> 00:10:04,440
‫أَيَكونُ هذا الخاقان؟ لا يُعقل...

128
00:10:04,440 --> 00:10:07,520
‫اعذريني يا فاطمة، فعليكِ ملاقاةُ هذا المأزقِ بمفردكِ

129
00:10:15,610 --> 00:10:16,830
‫سألِجُ السُّرادق

130
00:10:19,510 --> 00:10:21,200
‫الخاقانُ الأعظم...

131
00:10:24,630 --> 00:10:26,510
‫ما مَرامُكَ منِّي؟

132
00:10:26,510 --> 00:10:30,020
‫إن كانَ في حُكمِكَ إزهاقُ روحي، فإني لأرتضي القَضاء

133
00:10:30,020 --> 00:10:31,560
‫أخطأتِ الظَّنّ

134
00:10:31,560 --> 00:10:33,150
‫إنما أحملُ رَجاءً أسوقُهُ إليكِ

135
00:10:34,780 --> 00:10:36,050
‫ادخُل يا بني

136
00:10:38,200 --> 00:10:40,280
‫أ-أُمّاه

137
00:10:40,780 --> 00:10:42,080
‫كيوك... يا قُرّةَ عيني

138
00:10:42,080 --> 00:10:43,330
‫«قُرّةُ عَينيها»...؟

139
00:10:43,330 --> 00:10:46,650
‫راعني مجيئُك... ما الذي سَاقَ رِكابكَ إلى هذا الموضع؟

140
00:10:46,650 --> 00:10:48,110
‫أَأَنتَ سالِمٌ يا ولدي؟

141
00:10:48,110 --> 00:10:51,040
‫يا فلذةَ كبدي، أَلَم يَمسَسكَ سُوءٌ في مَسيرك؟

142
00:10:49,400 --> 00:10:52,560
‫هَـ-هَدِّئي من رَوعكِ يا أُمَّاه

143
00:10:54,550 --> 00:10:55,790
‫يا أُمَّاه...

144
00:10:56,310 --> 00:10:58,530
‫ارتحلي معي صَوبَ دياري

145
00:10:59,110 --> 00:11:00,200
‫مَاذا؟

146
00:11:00,200 --> 00:11:05,850
‫إنها تَقبعُ غربًا، في رِحَابِ سَهبٍ ينبسطُ بينَ جبالِ ألتاي وتيان شان

147
00:11:05,850 --> 00:11:07,240
‫يَشتدُّ فيها قَرُّ الشتاء

148
00:11:07,240 --> 00:11:10,880
‫غيرَ أنَّ مَعينَ مائِها زُلالٌ ومَراعيها خَصيبةٌ وافِرة

149
00:11:10,880 --> 00:11:12,560
‫وفوقَ هذا كُلِّه...

150
00:11:13,210 --> 00:11:14,940
‫فهيَ بقعةٌ قاصيةٌ عن صِراعاتِ هذا المَوضِع

151
00:11:19,300 --> 00:11:21,860
‫وتِلكَ رَغبتي ومَطلبي منكِ أنا أيضًا يا توراكينا

152
00:11:22,230 --> 00:11:26,580
‫إنَّ البلاطَ لَـيَموجُ بـالصِّراعاتِ بأكثرَ مما تَحتملانِ أنتِ وكيوك

153
00:11:27,530 --> 00:11:31,170
‫فإن قَبلتِ هذا المَسعى، فلن أثقلَ عليكِ بـطَلَبٍ بعدَه أبدًا

154
00:11:33,260 --> 00:11:36,510
‫فمَا أَرومُ لَكِ إلا أَن تَنعَمي بـرَغَدِ العَيشِ وطِيبِ المَقام

155
00:11:38,780 --> 00:11:42,940
‫أجل... بـهذا تَنحسرُ العُقَدُ وتَنجلي المَكائدُ دُفعةً واحدة

156
00:11:43,590 --> 00:11:48,350
‫شَرطُ الخاتونِ الكبرى بوراكتشين لِـفَكِّ قَيدِ الخاتونِ توراكينا

157
00:11:48,350 --> 00:11:50,910
‫هو قِرانُ الخاتونِ سورغاغتاني بـكيوك

158
00:11:51,530 --> 00:11:55,180
‫ومَرامُها من ذلكَ إقصاءُ هؤلاءِ الثلاثةِ قاطبةً عن مَيدانِ البلاط

159
00:11:56,420 --> 00:11:59,450
‫صحيحٌ أنَّ تِلكَ الحيلةَ لم تُؤتِ أُكُلَها

160
00:12:00,570 --> 00:12:05,700
‫بيدَ أنَّ مآلَ الثلاثةِ اليومَ هوَ الانسحابُ من مَعتركِ الحُكمِ والسياسة

161
00:12:06,680 --> 00:12:10,330
‫وهذا مَسعى يَنطوي على نَفعٍ حَقيقيٍّ لـلخاتونِ توراكينا كذلِك

162
00:12:18,100 --> 00:12:19,710
‫إذن يا أُمَّاه...

163
00:12:20,440 --> 00:12:23,230
‫سأَرِدُ ديارَكِ غَدًا لـنَشدَّ الرِّحالَ معًا

164
00:12:25,910 --> 00:12:28,090
‫أرجو المَعذرةَ على ما أَحدثناهُ من جَلَبة

165
00:12:28,090 --> 00:12:29,470
‫أَتَقفلونَ راجعينَ الساعة؟

166
00:12:29,470 --> 00:12:30,480
‫أجل

167
00:12:31,460 --> 00:12:32,760
‫غيرَ أنَّهُ قبلَ الارتحال...

168
00:12:34,660 --> 00:12:35,900
‫توراكينا

169
00:12:36,440 --> 00:12:39,900
‫أَتأذنينَ لي بـمُخاطبةِ جاريتِكِ تلك؟

170
00:12:45,670 --> 00:12:47,360
‫ولِمَ يَقَعُ الاختيارُ عليَّ أنا؟

171
00:12:47,940 --> 00:12:49,920
‫أأَنتِ المَدعوَّةُ فاطمة؟

172
00:12:49,920 --> 00:12:51,360
‫تناهى إليَّ حديثُ الخاتونِ موكا عنكِ

173
00:12:51,360 --> 00:12:53,040
‫بَلغني أنَّكِ كَثيرًا ما تَضلّينَ السُّبُلَ بينَ السُّرادقات

174
00:12:55,850 --> 00:12:58,880
‫وفوقَ هذا... يُشاعُ في الرِّكابِ أنَّكِ كريمةُ حَكيمٍ من أهلِ العلم

175
00:12:58,880 --> 00:13:00,590
‫أَفَلكيَّةٌ حَاذِقةٌ أنتِ؟

176
00:13:00,590 --> 00:13:01,960
‫عِلمُ الفَلَك؟

177
00:13:01,960 --> 00:13:03,740
‫مَعذرةً، أيُّها الخاقانُ الأعظم

178
00:13:03,740 --> 00:13:07,200
‫لا يَلِيقُ بـجَلالِ مَقامِكم مخاطبةُ جاريةٍ وَضيعةِ النَّسبِ مُباشرةً

179
00:13:08,410 --> 00:13:10,680
‫فليَقُم نجلي بـنَقلِ خِطابِكُم إليها

180
00:13:10,680 --> 00:13:11,130
‫تَقدَّم

181
00:13:11,130 --> 00:13:12,850
‫حـ-حاضر

182
00:13:13,750 --> 00:13:17,050
‫يَستَفسِرُ الخاقانُ الأعظم إن كنتِ تَفقَهينَ مَباحثَ عِلمِ الفَلَك

183
00:13:17,050 --> 00:13:19,840
‫أجل، حُزتُ من مَباحثِهِ قَدرًا وافِرًا

184
00:13:21,640 --> 00:13:24,640
‫تَقولُ الجاريةُ إنَّ لَـها دِرايةً واسعةً بـهذا العِلم

185
00:13:24,640 --> 00:13:29,200
‫أَفَتَعلَمُ الجاريةُ إذن لِمَ تَسري النجومُ في عِنانِ السماء؟

186
00:13:30,650 --> 00:13:35,530
‫يَسألُ الخاقانُ الأعظم إن كنتِ تُدركينَ عِلَّةَ سَرَيانِ النجومِ في السماء

187
00:13:36,060 --> 00:13:37,660
‫أجل...

188
00:13:37,660 --> 00:13:39,880
‫إني لأَحملُ جَوابَ هذا التَّساؤل

189
00:13:40,580 --> 00:13:43,550
‫فَقَد طالعتُ هذا في سِفرٍ عتيقٍ للعالِمِ البيروني

190
00:13:45,860 --> 00:13:50,810
‫﴿  وَالشَّمسَ وَالقَمَرَ وَالنُّجُومَ مُسَخَّرَاتٍ بِأَمرِهِ  ﴾

191
00:13:50,810 --> 00:13:53,470
‫هكذا نَصَّت آياتُ القرآنِ الكريم

192
00:13:53,470 --> 00:13:59,130
‫وعلى هذا، فإنَّ مَسارَ النجومِ آيةٌ ونِعمةٌ ساقَها الله لِـهدايةِ البَشر

193
00:13:59,130 --> 00:14:04,560
‫والسَّماءُ كُرةٌ دوَّارةٌ تَتألفُ من ثَمانيةِ أَفلاكٍ مُحكَمة

194
00:14:04,560 --> 00:14:07,920
‫وتَقبعُ أرضُنا ثابِتةً في كَبِدِ مَركزِها

195
00:14:09,460 --> 00:14:10,880
‫إذن...

196
00:14:11,580 --> 00:14:13,290
‫طَريفٌ هذا المَقال

197
00:14:14,600 --> 00:14:15,850
‫طَريف؟

198
00:14:15,850 --> 00:14:16,870
‫الزمي الصمت

199
00:14:17,290 --> 00:14:20,590
‫أجل، فـهذا يُناقضُ مَوروثَ ما استقرَّ في خَلَدي

200
00:14:20,590 --> 00:14:26,780
‫فقد تناهى لـسَمعي في سالِفِ الأيام أنَّ النجومَ قَطيعُ ماشيةٍ رُبِطَت بـوَتَدٍ في عِنانِ السَّماء

201
00:14:27,300 --> 00:14:30,590
‫وأنَّ نَجمَ الشَّمالِ الرَّاسخَ هُوَ ذلِكَ الوَتَدُ المَضروب

202
00:14:31,470 --> 00:14:34,970
‫مَعذرةً أيها الخاقانُ الأعظم، غيرَ أنَّ هذا وَهمٌ وخُرافة

203
00:14:34,970 --> 00:14:36,220
‫أَعلى يَقينٍ أنتِ من هذا؟

204
00:14:36,790 --> 00:14:42,110
‫ولَعلَّ هذا الوجودَ فرسٌ جَموحٌ رُبِطَت بـحَبلٍ يَعدُو في دَائرةٍ لا تَنتهي

205
00:14:42,480 --> 00:14:45,960
‫وعلى ظَهرِها يَمتطي أوقطاي وبوراكتشين

206
00:14:45,960 --> 00:14:47,720
‫وسورغاغتاني وتولوي

207
00:14:47,720 --> 00:14:49,560
‫وتوراكينا وأنتِ كذلِك

208
00:14:49,560 --> 00:14:54,450
‫نَدورُ في فَلَكِها جَميعًا لِـتَقودَ خُطانا صَوبَ مَصيرٍ واحد

209
00:14:54,450 --> 00:14:55,880
‫مُحالٌ هذا الزَّعم

210
00:14:55,880 --> 00:14:57,870
‫فلا يَمُتُّ هذا القولُ لِـمَناهجِ العِلمِ بـصِلَة

211
00:14:59,110 --> 00:15:00,080
‫العِلم؟

212
00:15:01,920 --> 00:15:05,290
‫أَعني السُّنَنَ الثَّابتةَ التي تَحكُمُ هذا الوجود

213
00:15:05,880 --> 00:15:09,390
‫وهيَ صُنعُ اللهِ الذي بَرَأَ هذا الكونِ وأَودَعَهُ لَـنا

214
00:15:10,060 --> 00:15:13,170
‫والعِلمُ هُوَ السَّبيلُ الأوحَدُ لِـسَبرِ أَغوارِها

215
00:15:15,050 --> 00:15:21,940
‫وتِلكَ السُّننُ عينُها تُجليها الأرواحُ التي تُناجيها الكاماتُ في طقوسِها

216
00:15:21,940 --> 00:15:22,850
‫كلا البتة

217
00:15:22,850 --> 00:15:28,510
‫فقد أَنزلَ الله في مُحكمِ كتابهِ أنَّ النجومَ سُخِّرَت لـنَهتديَ بـمَسراها

218
00:15:28,680 --> 00:15:32,780
‫وتُحسَبُ مَداراتُها بـدِقَّةِ الحِسابِ الفَلَكيِّ القائمِ على ثَباتِ الأرضِ في المَركز

219
00:15:32,780 --> 00:15:34,910
‫وجاءتِ النتائجُ مَنزَّهةً عنِ التَّناقض

220
00:15:34,910 --> 00:15:36,830
‫وهذا لَـهُوَ البُرهانُ الأَسطعُ على صِدقِها

221
00:15:36,830 --> 00:15:37,950
‫تِلكَ هيَ الحقيقةُ الجَليّة

222
00:15:37,950 --> 00:15:40,370
‫وما سِواها إلا وَهمٌ باطلٌ لا أَصلَ له

223
00:15:48,230 --> 00:15:49,420
‫تبيّنتُ مَقصَدكِ الآن

224
00:15:49,420 --> 00:15:52,060
‫لأَرى أنَّ طَبعكِ وطَبعَ توراكينا صِيغا من مَعدِنٍ واحد

225
00:15:53,300 --> 00:15:55,450
‫فمَا قولُكِ في رِهانٍ نَعقدُهُ بيننا؟

226
00:15:56,280 --> 00:15:57,980
‫رِهان؟

227
00:15:57,980 --> 00:15:59,260
‫بالضبط

228
00:15:59,260 --> 00:16:02,140
‫على ألا يُطلبَ منكِ سوى التَّرَقُّبِ والنَّظَر

229
00:16:03,210 --> 00:16:07,610
‫سأَقودُ إمبراطوريتَنا المغوليةَ نحو ذُرى المَجدِ والرَّخاء

230
00:16:07,610 --> 00:16:10,220
‫بـسُبُلٍ تُجافِي سَطوةَ السَّيفِ التي سَلَكَها أبي وتولوي

231
00:16:11,490 --> 00:16:15,370
‫لِـتَظفَرا أنتِ وتوراكينا بـرَغَدِ العَيشِ والسَّكِينة

232
00:16:15,370 --> 00:16:16,990
‫أَتَتحدّثُ عنِ السَّكِينةِ والسَّعادة؟

233
00:16:17,530 --> 00:16:18,560
‫أجل، هوَ ذاك

234
00:16:19,380 --> 00:16:24,170
‫تبيّنتُ غايةَ قَدَري يومَ وَقَعَت عينايَ على توراكينا أولَ مرّة

235
00:16:24,500 --> 00:16:26,880
‫بأن أُعيدَ صِياغةَ بُنيانِ هذهِ الإمبراطوريةِ من جَديد

236
00:16:27,990 --> 00:16:31,330
‫وما حَرَّكني لـهذا إلا لِـوَهجِ الانكسارِ الكامِنِ في عينيها

237
00:16:32,390 --> 00:16:35,290
‫وأنتِ كذلِك سُلِبَت منكِ الدِّيارُ وتَبَدَّدَ شَملُ الأهل

238
00:16:36,760 --> 00:16:38,050
‫نَظرةُ عينَيكِ قُبيلَ لحظات...

239
00:16:38,430 --> 00:16:41,470
‫حَاكَت تمامًا نَظرةَ توراكينا في ذلكَ اليومِ الخالي

240
00:16:44,440 --> 00:16:47,600
‫فتَرصَّدي صَنيعي بـتِلكَ النَّواظِرِ ذاتِها

241
00:16:48,650 --> 00:16:51,390
‫فإن ظَفِرتُما بـالسَّكِينةِ في ظِلالِ حُكمي هاهنا...

242
00:16:52,600 --> 00:16:54,030
‫فـحينئذٍ... يَكونُ الظَّفَرُ حَليفي وَحدي

243
00:18:07,060 --> 00:18:08,190
‫فاطمة؟

244
00:18:09,580 --> 00:18:10,900
‫يا فاطمة

245
00:18:10,900 --> 00:18:12,510
‫الخاتون توراكينا

246
00:18:12,510 --> 00:18:14,480
‫أَسالمةٌ أنتِ من كُلِّ أذًى يا فاطمة؟

247
00:18:14,480 --> 00:18:16,440
‫أَ-أجل...

248
00:18:16,440 --> 00:18:18,110
‫وما شأنُ سموِّكِ يا خاتون؟

249
00:18:19,700 --> 00:18:21,680
‫أَرعِيني سَمعَكِ يا فاطمة

250
00:18:22,480 --> 00:18:24,560
‫أَمعَنتُ التَّفكيرَ وتَفرّستُ في المآل

251
00:18:32,620 --> 00:18:36,170
‫لن أَرتحلَ معَ قُرّةِ عيني كيوك

252
00:18:36,170 --> 00:18:37,180
‫مَاذا؟

253
00:18:37,180 --> 00:18:41,100
‫فـفي هذا رُضوخٌ يُحيلُني دُميةً طَيّعةً تَأتمرُ بـأمرِ الخاقانِ الأعظم

254
00:18:42,340 --> 00:18:45,140
‫وهَيهاتَ لِـعِزّةِ نفسي أن تَرتضيَ مِثلَ هذا الخُنوع

255
00:18:47,380 --> 00:18:48,430
‫يا فاطمة...

256
00:18:49,210 --> 00:18:50,730
‫أَتَرضينَ بـأن...

257
00:18:51,670 --> 00:18:54,980
‫تَخوضي غِمارَ هذهِ المَعركةِ بـجانبي تارةً أخرى؟

258
00:18:58,520 --> 00:18:59,980
‫رَغمَ أنِّي...

259
00:19:01,670 --> 00:19:04,880
‫لَستُ صاحبةَ حِكمةٍ بالغةٍ تليقُ بـهذا الصِّراع؟

260
00:19:19,060 --> 00:19:22,570
‫معًا... بـوُسعِنا استحضارُ عاصفةٍ تَقلِبُ مَوازينَ البلاط

261
00:19:23,590 --> 00:19:24,970
‫أجل...

262
00:19:25,420 --> 00:19:30,190
‫فـلستُ أَقِفُ بمفردي في قِراعِ الخاقانِ الأعظم

263
00:19:31,370 --> 00:19:36,730
‫تِلكَ الإمبراطورية... وأولئك المغول، الذين سَلَبونا ديارَنا ونَفائسَ حَياتِنا

264
00:19:37,300 --> 00:19:40,160
‫لن نَدعَ عاقِبةَ طُغيانِهم تَمضي دونَ قِصاص

265
00:19:42,620 --> 00:19:45,070
‫وحَانَ دَورُنا الساعة...

266
00:19:48,890 --> 00:19:50,650
‫لِـنَغدوَ نحنُ السَّاحِرتَين

267
00:21:26,410 --> 00:21:30,650
‫وفي ذلكَ العامِ كذلِك، طَوى قَرُّ الشِّتاءِ أيَّامَهُ...

268
00:21:31,180 --> 00:21:34,270
‫وأَقبلَ الصَّيفُ يَختالُ في الرِّحاب

269
00:21:35,260 --> 00:21:38,860
‫فاكتسى السَّهبُ حُلَّةَ الخُضرةِ تارةً أخرى

270
00:21:38,860 --> 00:21:42,750
‫وانتَشرتِ الأغنامُ تَرعى غَضَّ المَراعي

271
00:22:08,660 --> 00:22:11,420
‫لم يَتغيّر من طَبعِ الدارِ شيء

272
00:22:12,870 --> 00:22:14,940
‫فوقَ أَدِيمِ هذا السَّهبِ الأَبَديِّ الرَّاسِخ

273
00:22:20,680 --> 00:22:22,210
‫أحَقًّا يَسكنُ السَّهبُ على مِثلِ هذا الثَّبات؟

274
00:22:23,160 --> 00:22:25,450
‫طَابَت أَيَّامُكِ يا الخاتون الكبرى

275
00:22:25,820 --> 00:22:28,030
‫إنَّ نَسائمَ هذا اليومِ لَـبَديعةُ الأثر

276
00:22:28,530 --> 00:22:32,740
‫كأنَّ بهاءَها يُحاكي رَخاءَ الإمبراطوريةِ وازدهارَها المتنامي

277
00:22:34,060 --> 00:22:36,450
‫أجل، صَدَقتِ فيما رَأيتِ

278
00:22:36,980 --> 00:22:39,550
‫خاتونُ الخاقانِ الثانية، توراكينا

279
00:22:40,730 --> 00:22:42,300
‫وجاريتُكِ...

280
00:22:43,110 --> 00:22:44,690
‫فاطمة

281
00:22:51,590 --> 00:22:54,760
‫وفي ذلكَ العام، قَلَّدَ الخاقانُ أوقطاي...

282
00:22:55,060 --> 00:22:58,060
‫الحاكمَ العامَّ لِـديارِ فارس

283
00:22:58,060 --> 00:23:04,850
‫فـأَضحَت مَساقطُ رأسِ ستارا رَهينةَ السِّيادةِ المغوليةِ الدائمة

284
00:23:06,140 --> 00:23:07,210
‫بيدَ أنَّ...

285
