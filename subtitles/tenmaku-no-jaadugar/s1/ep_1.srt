1
00:00:11,320 --> 00:00:15,660
منذ زمن بعيد، استخدم العُلماء علمَ
الهندسة لقياس حجم ومدى

2
00:00:16,000 --> 00:00:18,560
الأرض للمرّة الأولى

3
00:00:20,220 --> 00:00:24,030
في هذه الحالة، هل من المُمكن أيضاً
استخدام علم الهندسة لتحديد

4
00:00:24,030 --> 00:00:26,700
حجم ومدى القدَر الّذي نملكه بين أيدينا؟

5
00:00:28,600 --> 00:00:35,130
هذه قصّة ساحرة جعلَتْ قارّةً واسعةً ألعوبتها

6
00:01:37,720 --> 00:01:43,740
جادوغار

7
00:01:48,590 --> 00:01:52,120
وإلى أين تحاولين التّحليق بالضّبط
يا عصفورتي الصّغيرة؟

8
00:01:54,280 --> 00:01:56,260
كم أنتِ طفلة شقيّة

9
00:01:59,010 --> 00:02:02,410
‏1213 ميلادي
طوس
إيران الشّرقيّة

10
00:02:01,160 --> 00:02:04,660
طوس

11
00:02:05,240 --> 00:02:10,710
له ما في السّماوات وما في الأرض

12
00:02:31,510 --> 00:02:34,950
أُحبّ البازارات لنبضها بالحياة

13
00:02:35,300 --> 00:02:36,640
يا سيّدة

14
00:02:36,640 --> 00:02:39,800
عندما تنتهي فترة إحداد عدّتك على
مولايّ الرّاحل، لنتسوّق

15
00:02:39,800 --> 00:02:40,950
فكرة سديدة

16
00:02:41,480 --> 00:02:46,390
لكن بالنّسبة لليوم، آمل أن يرزقنا
الرّبُّ بأمَة جيّدة

17
00:02:46,390 --> 00:02:48,020
لن تكون جيّدة مثلكِ بالطّبع

18
00:02:56,130 --> 00:02:58,320
جميعهن كادحات في العمل

19
00:02:59,530 --> 00:03:03,290
هذه المرأة، على سبيل المثال، بارعة في الطّبخ

20
00:03:03,290 --> 00:03:05,010
وهذه خيَّاطة ماهرة

21
00:03:05,010 --> 00:03:06,480
،وهذه ثرثارة

22
00:03:06,480 --> 00:03:10,120
لذا قد تكون شريكة مُناسبة لكِ
في المُحادثات يا سيّدة فاطمة

23
00:03:10,120 --> 00:03:11,650
رُبّما

24
00:03:11,650 --> 00:03:13,880
...لكن أكثر ما نحتاجه الآن هو

25
00:03:13,880 --> 00:03:17,590
التّنظيف. ذلك القصر الضّخم كبير
جدّاً على أن أنظّفه بمفردي

26
00:03:17,950 --> 00:03:22,100
أجل، وما زلتُ لم أنتهِ من فرز
مُمتلكات زوجي الرّاحل

27
00:03:22,100 --> 00:03:23,430
ليس عليكِ القلق

28
00:03:23,430 --> 00:03:25,700
إذاً ما رأيكِ بهذه المرأة؟

29
00:03:25,700 --> 00:03:27,920
لديها موهبة حقيقيّة في التّنظيف

30
00:03:28,500 --> 00:03:30,320
اسمي أنيس

31
00:03:30,320 --> 00:03:32,800
التّنظيف لا يتمحور فقط حول ما تُريدين
،التخلُّص منه

32
00:03:32,800 --> 00:03:34,060
بل حول ما ترغبين في الاحتفاظ به

33
00:03:34,650 --> 00:03:37,630
ستكون أيّامكِ أنيقة ومُرتّبة. أعدكِ بذلك

34
00:03:37,630 --> 00:03:39,210
سيكون هذا رائعاً

35
00:03:39,210 --> 00:03:40,110
كم ثمنها؟

36
00:03:41,190 --> 00:03:43,640
سأدعكِ تحصلين عليها مُقابل 800 درهم

37
00:03:44,320 --> 00:03:46,740
،أعلم بأنّ العبيد ليسوا رخيصين
...لكن هذا كثير

38
00:03:46,980 --> 00:03:50,330
سيّد أحمد، من فضلك. ألا يمكنك
أن تُخفض السّعر قليلاً؟

39
00:03:52,180 --> 00:03:54,820
،ما كنتُ لأرفض في العادة

40
00:03:55,330 --> 00:03:59,210
لكن يمكنني أن أدعكِ تحصلين عليها
بنصف السّعر كحالة استثنائيّة

41
00:03:59,210 --> 00:04:00,140
ماذا؟

42
00:03:59,210 --> 00:04:00,140
ماذا؟

43
00:04:00,140 --> 00:04:01,650
...لكن في المُقابل

44
00:04:02,190 --> 00:04:03,070
تعالي

45
00:04:12,520 --> 00:04:14,350
هيّا. افعلي كما علّمتُكِ

46
00:04:16,060 --> 00:04:17,570
كم هي ظريفة

47
00:04:17,570 --> 00:04:18,520
من هذه؟

48
00:04:18,520 --> 00:04:21,490
حصلتُ عليها قبل أيّام. اسمها سيتارا

49
00:04:21,490 --> 00:04:24,860
اسمكِ يعني "نجم". كم هذا جميل

50
00:04:28,870 --> 00:04:33,930
،إنّها خجولةٌ قليلاً، لكن كما ترين
ابتسامتها جذّابة جدّاً

51
00:04:33,930 --> 00:04:39,250
إذا رُبّيَتْ كما ينبغي، فأؤكّد لكِ بأنّها
ستكون خادمة ذات مكانة رفيعة

52
00:04:39,590 --> 00:04:41,340
لذا إليكِ عرضي

53
00:04:41,340 --> 00:04:42,800
سيّدة فاطمة

54
00:04:42,800 --> 00:04:45,450
،عائلتكِ مُثقّفة

55
00:04:45,450 --> 00:04:50,060
وعقل مولايّ الصّغير مُحمّد لامع
حتّى هنا في طوس

56
00:04:50,060 --> 00:04:52,570
الدّراسة في منزلكِ سيمنحها تميُّزاً حقيقيّاً

57
00:04:52,570 --> 00:04:55,770
هل تُمانعين إذا تبنّيتِها لبعض الوقت؟

58
00:05:03,710 --> 00:05:05,780
وافقتِ على عرضه؟

59
00:05:06,460 --> 00:05:11,130
من فضلك. أنت المُؤهَّل الوحيد لتكون
مُدرّسها الآن يا أخي

60
00:05:11,130 --> 00:05:14,750
ما زلتُ في فترة عدّتي، ولا أعرف
أي مُدرّس خارج عائلتنا

61
00:05:15,200 --> 00:05:21,050
فضلاً عن ذلك، عبداً كان أو لا، السّعي
خلف العلم هو واجب كُلّ مُسلم

62
00:05:22,010 --> 00:05:23,630
هذا ما أعتقده

63
00:05:25,500 --> 00:05:28,090
القراءة هي حجر زاوية التعلُّم

64
00:05:28,090 --> 00:05:31,430
الخطوة الأولى في تلك الرّحلة هي
تِلاوة القرآن بشكل صحيح

65
00:05:31,660 --> 00:05:33,910
والآن كرّري خلفي

66
00:05:34,990 --> 00:05:39,860
"بسم اللّه الرّحمن الرّحيم"

67
00:05:43,300 --> 00:05:44,280
والآن دوركِ

68
00:05:46,320 --> 00:05:48,280
هيّا. حاولي قولها

69
00:05:52,130 --> 00:05:55,100
لا جدوى. هذه الفتاة لا تمتلك موهبةً قطعاً

70
00:05:55,100 --> 00:05:58,770
مهما حاولت، تكتفي بالابتسام ولا تُبدي
أيّ اهتمام بالتعلُّم

71
00:05:58,770 --> 00:06:01,000
لكن وعدتُ أن أتبنّاها

72
00:06:02,530 --> 00:06:05,630
سأسدّد الحسم الّذي حصلتِ عليه
عن الأمَة الأُخرى

73
00:06:05,630 --> 00:06:07,590
أنا آسفة يا أخي

74
00:06:10,740 --> 00:06:14,140
سأطلب منه المجيء ليأخذكِ. انتظري
هنا لبعض الوقت، اتّفقنا؟

75
00:06:14,640 --> 00:06:17,560
مُؤسّسة السّيّد أحمد، صحيح؟ سوف أذهب أنا

76
00:06:17,560 --> 00:06:19,600
أجل. آسفة لإزعاجك

77
00:06:24,950 --> 00:06:25,920
عليّ الهرب

78
00:06:27,870 --> 00:06:32,020
لا أريد أن يتمّ بيعي لأحد. سأعود إلى المنزل

79
00:07:05,560 --> 00:07:06,920
أنا تائهة

80
00:07:06,920 --> 00:07:08,530
أين المخرج؟

81
00:07:15,330 --> 00:07:16,760
فتى؟

82
00:07:25,510 --> 00:07:30,720
وعقل مولايّ الصّغير مُحمّد لامع
حتّى هنا في طوس

83
00:07:33,930 --> 00:07:35,470
المعذرة

84
00:07:35,770 --> 00:07:36,720
أين الباب؟

85
00:07:37,260 --> 00:07:39,020
هـ-هذه عديم الحشمة

86
00:07:39,500 --> 00:07:42,670
يجب ألّا تكشف المرأة عن نفسها أمام
رجل وشعرها ظاهر

87
00:07:43,570 --> 00:07:46,010
لا عليك. ما زلتُ صغيرة

88
00:07:46,010 --> 00:07:47,260
أنتِ قريبةٌ زيادة عن اللُّزوم

89
00:07:47,260 --> 00:07:49,940
فضلاً عن ذلك، يبدو أنّك لا تزال
،طفلاً بالنّسبة لي

90
00:07:49,940 --> 00:07:51,560
مولايّ الصّغير مُحمّد

91
00:07:51,560 --> 00:07:53,660
من أنتِ على أيّ حال؟

92
00:07:54,550 --> 00:07:55,250
—اسمي هو

93
00:07:55,250 --> 00:07:56,790
!أنتِ هنا

94
00:07:56,790 --> 00:07:59,120
بحثتُ عنكِ في كلّ مكان بعد أن هربتِ

95
00:08:00,260 --> 00:08:02,400
كانت الورود جميلة جدّاً، فأتيتُ لتأمّلها

96
00:08:02,400 --> 00:08:04,370
كانت تبحث عن المخرج

97
00:08:07,340 --> 00:08:10,320
هذا لا يُصدَّق. كيف تجرئين على مُحاولة الهرب؟

98
00:08:10,320 --> 00:08:15,370
مهلاً، مهلاً. سيعود أخي رفقة أحمد
في أيّ لحظة الآن

99
00:08:15,370 --> 00:08:16,300
أنا آسفة جدّاً

100
00:08:16,300 --> 00:08:17,950
أردتِ العودة، أليس كذلك؟

101
00:08:20,010 --> 00:08:22,270
ليس إلى منزل ذلك الرّجل

102
00:08:22,860 --> 00:08:25,240
بل إلى المنزل الّذي عشتُ فيه مع أمّي

103
00:08:26,030 --> 00:08:29,980
أُمّي تُوفّيت، وباعني سيّدها

104
00:08:29,980 --> 00:08:32,610
إنّه ليس منزلكِ إذاً

105
00:08:32,610 --> 00:08:34,320
أنتِ أمَة

106
00:08:34,320 --> 00:08:36,030
،إذا أردتِ منزلاً حقيقيّاً تعودين إليه

107
00:08:36,030 --> 00:08:38,880
فادرسي بجدّ وذلك كي يشتريكِ سيّدٌ صالح

108
00:08:38,880 --> 00:08:40,950
!إذاً، لن أدرس أبداً

109
00:08:41,220 --> 00:08:44,340
لا أريد أن أدرس! لن أُظهِر تعابير
!ظريفة في وجهي بعد الآن أيضاً

110
00:08:44,340 --> 00:08:45,960
!فهذا لن يُزيدني إلّا قيمة

111
00:08:45,960 --> 00:08:50,250
إذا درست، سأُباع ثانية إلى مكانٍ
!أبعد حتّى من هذا المكان

112
00:08:50,600 --> 00:08:53,560
سئمتُ من زيارة الأماكن الّتي
!لا أعرف عنها شيئاً

113
00:08:56,330 --> 00:08:58,870
أيّتها الصّغيرة. اسمكِ سيتارة؟

114
00:08:58,870 --> 00:09:01,440
هذا هو إذاً سبب مجيئكِ إلى هنا للدّراسة؟

115
00:09:02,530 --> 00:09:05,280
...قد يكون نصيبنا في الحياة مُختلفاً، ومع ذلك

116
00:09:05,920 --> 00:09:06,900
زُمرُّد

117
00:09:07,520 --> 00:09:10,200
هلّا أحضرتِ لي دلواً من الماء من المطبخ؟

118
00:09:10,610 --> 00:09:12,050
كُلّما كان أكبر، كان أفضل

119
00:09:12,050 --> 00:09:13,340
بالطّبع

120
00:09:14,130 --> 00:09:15,080
تعالي معي

121
00:09:18,040 --> 00:09:19,700
إلى أين سنذهب؟

122
00:09:24,100 --> 00:09:25,300
إلى السّطح؟

123
00:09:32,590 --> 00:09:34,420
هل سيَفي هذا بالغرض؟

124
00:09:34,420 --> 00:09:36,160
أجل، شكراً لكِ

125
00:09:38,550 --> 00:09:40,930
سأُسقط هذا في الفناء، اتّفقنا؟

126
00:09:47,450 --> 00:09:48,440
مولايّ الصّغير؟

127
00:09:48,440 --> 00:09:50,890
هل تلك الفتاة ميؤوس منها؟

128
00:09:52,760 --> 00:09:55,550
ما-ماذا كان ذلك؟ ما الّذي يجري؟

129
00:10:01,920 --> 00:10:04,670
ماذا كان ذلك الضّجيج للتو؟
هل الجميع بخير؟

130
00:10:04,670 --> 00:10:06,660
هل ضربَ برقٌ المنزل؟

131
00:10:06,660 --> 00:10:09,000
هـ-هل أنت متأكّد بأنّنا لا نتعرّض
لهجوم من العدوّ؟

132
00:10:09,000 --> 00:10:10,870
هل هُم أولئك الرّحّالة الهمجيّون؟

133
00:10:14,530 --> 00:10:15,900
دلو ماء؟

134
00:10:16,270 --> 00:10:17,720
جميعهم في حالة هلع

135
00:10:17,720 --> 00:10:20,180
مولايّ الصّغير، مقلبُك الصّغير مُبالغ به

136
00:10:20,180 --> 00:10:23,890
هل لي أن أسأل؟ لماذا بقيتُما
هادئتين وتمالكتُما نفسيكما؟

137
00:10:24,170 --> 00:10:25,600
ولِمَ لا نكون كذلك؟

138
00:10:26,120 --> 00:10:29,520
،عرفنا بأنّه كان سيسقط في الأرض
لذا سددنا آذاننا

139
00:10:32,380 --> 00:10:37,010
لذا يمكن للمرء أن يقول بأنّكما توقّعتُما مُستقبلاً
سيصدر فيه صوتٌ ضجيج

140
00:10:37,010 --> 00:10:39,780
.واتّخذتُما إجراءات احترازيّة مُناسبة
أليس كذلك؟

141
00:10:39,780 --> 00:10:42,410
في الواقع... أجل، هذا ما أعتقده

142
00:10:43,290 --> 00:10:47,040
لعلّ هذا ما يدور حوله التعلُّم

143
00:10:48,390 --> 00:10:51,450
في هذه اللّحظة من الزّمن، لا تعرفين
،المكان الّذي أنتِ فيه

144
00:10:51,450 --> 00:10:53,100
ولا تعرفين ما يجري

145
00:10:53,100 --> 00:10:55,290
أو ماذا سيحلُّ بكِ

146
00:10:55,290 --> 00:10:56,880
حياتكِ مليئة بالمجهول

147
00:10:57,340 --> 00:11:00,400
من ناحية، عمّي والآخرون في الأسفل
هُناك ينطبق عليهم ذلك

148
00:11:01,050 --> 00:11:03,270
،لكن إذا درستِ وأصبحتِ حكيمة

149
00:11:03,270 --> 00:11:08,140
ستُدركين أفضل مسار من السُّلوك الّذي يجب
اتّخاذه، مهما كانت الورطة الّتي تقعين فيها

150
00:11:08,520 --> 00:11:10,730
لا يمكن لهذا أن يكون أمراً سيّئاً

151
00:11:11,350 --> 00:11:13,650
أهذه هي الدّراسة؟

152
00:11:16,690 --> 00:11:17,810
!عمّي

153
00:11:17,810 --> 00:11:20,170
!آسف لإخافتك! كان ذلك أنا

154
00:11:21,900 --> 00:11:25,160
دلو الماء هذا مُنبعج ولم يعُد
قادراً على احتواء شيء

155
00:11:25,390 --> 00:11:26,800
صار بلا قيمة

156
00:11:26,800 --> 00:11:28,640
خذيه وأصلحيه

157
00:11:28,640 --> 00:11:31,150
سأشرف على الطّبخ

158
00:11:31,150 --> 00:11:33,170
مرحباً بكِ يا سيتارة

159
00:11:35,290 --> 00:11:37,920
،إن كان لديكِ أي استفسار حول شيء
فلا تتردّدي

160
00:11:37,920 --> 00:11:39,050
حـ... حسناً

161
00:11:39,860 --> 00:11:44,470
وهكذا وجدتْ سيتارة نفسها تخدم
،في عائلة مُثقّفة

162
00:11:44,470 --> 00:11:46,230
بينما تدرس بجدّ

163
00:12:54,960 --> 00:12:56,710
!تبدين جميلة جدّاً يا مولاتي

164
00:12:57,020 --> 00:13:00,330
،شكراً لكِ. لكن لا بُدّ أن أعترف
أشعر بخجلٍ شديد

165
00:13:00,330 --> 00:13:01,760
!ما هذا الّذي تقولينه؟

166
00:13:02,340 --> 00:13:05,370
هذا أوّل يوم تعودين فيه إلى الحمّامات بعد عدّتكِ

167
00:13:05,370 --> 00:13:09,620
لذا اغتسلي وتبرّجي واصبغي
،شعركِ ويديكِ بالحنّة

168
00:13:09,620 --> 00:13:12,600
وتحادثي مع الزّوجات الأُخريات

169
00:13:12,870 --> 00:13:14,180
حسنٌ إن كنتِ مُصرّة

170
00:13:15,150 --> 00:13:17,060
،سآخذكِ معي يوماً ما

171
00:13:17,740 --> 00:13:18,610
يا سيتارة

172
00:13:19,840 --> 00:13:20,610
حسناً

173
00:13:23,190 --> 00:13:26,130
،وللّه كُلّ ما في السّماوات"

174
00:13:26,130 --> 00:13:28,940
"وما في الأرض

175
00:13:30,290 --> 00:13:33,560
تِلاوتي ما زالت مُختلفة عن تِلاوة عمّي

176
00:13:33,560 --> 00:13:36,040
سأطلب منه تعليمي ثانية

177
00:13:36,040 --> 00:13:37,750
أمّي، هل يمكننا التكلُّم؟

178
00:13:38,530 --> 00:13:40,000
المعذرة، أين أُمّي؟

179
00:13:40,000 --> 00:13:43,120
ذهبت السّيّدةُ فاطمة إلى الحمّام

180
00:13:43,610 --> 00:13:44,880
ألم تُخبرك؟

181
00:13:44,880 --> 00:13:47,550
ماذا؟ هل كان ذلك اليوم؟

182
00:13:47,550 --> 00:13:50,490
أما من غرفة في الأعلى هناك
ليست مُخصّصة لدراستك؟

183
00:13:51,020 --> 00:13:54,980
كما أخبرتُكِ، من فضلكِ لا تُغادري
غرفتكِ وشعركِ مكشوف

184
00:13:54,980 --> 00:13:58,130
وكما أخبرتُك، ما زلتُ صغيرة

185
00:13:58,490 --> 00:14:01,360
،فضلاً عن ذلك، لا يزال عمرك 12
يا مولايّ الصّغير مُحمّد

186
00:14:01,670 --> 00:14:04,740
ما الضّير من دخول شخص لم تنمُ لحيته بعد

187
00:14:04,740 --> 00:14:06,320
إلى غرفة امرأة؟

188
00:14:06,510 --> 00:14:08,260
!لستُ طفلاً

189
00:14:09,140 --> 00:14:11,650
هل أنا غير ناضج في نظركِ أيضاً؟

190
00:14:17,640 --> 00:14:21,420
أخبرني مُدرّسي بأنّني كنتُ جاهلاً
جدّاً في شؤون الحياة

191
00:14:21,420 --> 00:14:23,590
مُدرّس القانون؟

192
00:14:23,590 --> 00:14:28,380
أجل، الأستاذ كمال الدّين. عرّفني
أبيه عليه قبل وفاته

193
00:14:29,060 --> 00:14:32,880
لكن مؤخّراً، هناك أوقات أشعر فيها
بأنّنا ننظر للأمور من منظور مُختلف

194
00:14:33,450 --> 00:14:37,020
وحتّى أنّه لا يعطي أجوبة واضحة
على الأسئلة الّتي أطرحها عليه

195
00:14:37,020 --> 00:14:42,070
لستَ خبيراً بما يكفي لفهم مثل هذه الأمور

196
00:14:43,710 --> 00:14:44,690
...أنوي

197
00:14:45,360 --> 00:14:46,860
خوض رحلة

198
00:14:48,010 --> 00:14:51,740
أتمنّى السّفر إلى نيشابور وزيارة
أساتذتها المشهورين

199
00:14:51,740 --> 00:14:55,580
ولن أتوقّف عند ذلك الحدّ. سأزور
في نهاية المطاف مُدُناً أُخرى

200
00:14:55,580 --> 00:14:57,550
وأحتكّ بحكمة

201
00:14:57,550 --> 00:14:59,750
،مع كافّة المصادر، ليس الإسلام فحسب

202
00:15:00,090 --> 00:15:01,730
بحثاً عن الحقيقة

203
00:15:06,340 --> 00:15:10,810
أعتقد بأنّ هذا هو الطّريق الّذي أراده
لي أبي، العالِم بحدّ ذاته

204
00:15:15,320 --> 00:15:16,960
هذا مُثيرٌ حقّاً للإعجاب

205
00:15:16,960 --> 00:15:20,060
حسناً، عليّ غسل الصّحون، لذا
أستأذن بالانصراف

206
00:15:20,060 --> 00:15:20,940
حسناً

207
00:15:24,060 --> 00:15:28,660
"وللّه كُلّ ما في السّماوات وما في الأرض"

208
00:15:32,420 --> 00:15:35,010
،مهما درستُ بجدّ

209
00:15:35,010 --> 00:15:37,830
لن أُضاهي مولايّ مُحمّد أبداً، أليس كذلك؟

210
00:15:53,280 --> 00:15:55,260
حسناً يا أمّي، سأغادر

211
00:15:55,260 --> 00:15:59,610
كرّس نفسك لدراستك هناك حرصاً
على ألّا تُلطّخ سمعة أبيك

212
00:15:59,610 --> 00:16:00,310
حسناً

213
00:16:00,830 --> 00:16:03,020
اعتنِ جيّداً بنفسك

214
00:16:06,380 --> 00:16:07,870
حسناً، إلى اللّقاء

215
00:16:09,010 --> 00:16:10,510
سأوصلك إلى مُنتصف الطّريق

216
00:16:10,510 --> 00:16:12,030
شكراً لك يا عمّي

217
00:16:14,280 --> 00:16:15,620
انتظري لحظة

218
00:16:15,620 --> 00:16:16,410
يا فتاة

219
00:16:17,870 --> 00:16:19,910
قيل لي بأنّكِ ما زلتِ لا تعرفين القراءة

220
00:16:20,140 --> 00:16:21,240
أجل

221
00:16:21,240 --> 00:16:22,140
هكذا إذاً

222
00:16:22,580 --> 00:16:24,180
سأكتب رسائلَ لكِ

223
00:16:24,670 --> 00:16:26,870
،عندما أُصبح مُدرّساً في المُستقبل

224
00:16:26,870 --> 00:16:29,500
أريد أن أعلّم الأطفال أمثالكِ دروساً

225
00:16:29,500 --> 00:16:31,610
لذا سأكتب بأسلوب بسيط قدر المُستطاع

226
00:16:31,610 --> 00:16:33,260
هل أنا وسيلتك للتمرُّن؟

227
00:16:33,260 --> 00:16:36,930
أطلب منكِ الدّراسة بجدّ وذلك كي تتمكّني
من قرائتها لأُمّي

228
00:16:36,930 --> 00:16:38,650
مفهوم يا سيتارا؟

229
00:16:40,020 --> 00:16:42,360
لا تتوقّفي عن التعلُّم، مفهوم؟

230
00:16:42,360 --> 00:16:43,920
عُلِم

231
00:16:44,980 --> 00:16:46,190
سأغادر الآن

232
00:16:52,470 --> 00:16:57,740
مُحمّد، فتى من طوس يشرع في رحلة
،ليصبح عالِماً شهيراً

233
00:16:57,740 --> 00:17:00,490
وسيتارة، فتاة أمَة

234
00:17:01,140 --> 00:17:05,450
ستكون هذه آخر مرّة يريان فيها بعضهما
الآخر وجهاً لوجه

235
00:17:07,440 --> 00:17:10,380
بعد 8 سنوات

236
00:17:10,380 --> 00:17:14,010
"بسم اللّه الرّحمن الرّحيم"

237
00:17:14,310 --> 00:17:14,920
ماذا؟

238
00:17:18,380 --> 00:17:20,140
إنّها ميليشيا طوس

239
00:17:20,140 --> 00:17:21,610
سيّدة زُمرُّد؟

240
00:17:21,610 --> 00:17:24,350
لا بُدّ أنّهم غادروا لإجراء جولة
استكشافيّة خارج المدينة

241
00:17:24,710 --> 00:17:28,940
يبدو أنّه رُصِدَ رحّالة مُسلّحون في المنطقة

242
00:17:29,980 --> 00:17:33,180
أخي الصّغير من بينهم في مكانٍ ما

243
00:17:33,180 --> 00:17:34,980
لكن لم أرَه منذ زمن بعيد

244
00:17:34,980 --> 00:17:36,190
ماذا؟

245
00:17:36,190 --> 00:17:39,810
وُلِدتُ أنا وميخائيل في بلاد بعيدة غرباً

246
00:17:39,810 --> 00:17:41,340
مُطلّة على البحر

247
00:17:41,340 --> 00:17:45,250
عند غروب الشّمس، يتحوّل كُلُّ شيء
إلى لون أرجوانيّ جميل

248
00:17:45,250 --> 00:17:46,520
البحر؟

249
00:17:46,520 --> 00:17:48,210
،كنّا فقيرين

250
00:17:48,210 --> 00:17:50,570
لكن كم كنتُ أعشق تأمُّل البحر

251
00:17:51,060 --> 00:17:52,090
سيتارا؟

252
00:17:52,900 --> 00:17:54,800
هل تُمانعين أن تقرئي هذه الرّسالة؟

253
00:17:54,800 --> 00:17:56,560
!أجل! حالاً

254
00:17:57,030 --> 00:17:58,720
في الغرفة المعتادة، صحيح؟

255
00:17:58,720 --> 00:18:00,970
يا للعجب! انظري كم هي سعيدة

256
00:18:03,290 --> 00:18:03,970
ها أنا ذي

257
00:18:04,810 --> 00:18:06,580
"أمّي. عمّي"

258
00:18:06,580 --> 00:18:10,430
منذ مُغادرتي قبل ثمان سنوات، درستُ"
،العديد من مجالات العلم

259
00:18:10,430 --> 00:18:13,690
"مثل الفلسفة والرّياضيّات والطبّ وعلم الفلك

260
00:18:13,690 --> 00:18:18,050
نيشابور هي مدينة كبيرة وتجمُّع"
"لعُلماء بارزين

261
00:18:18,050 --> 00:18:20,880
على سبيل المثال، تتلمذتُ على يد"
فضل الدّين داماد

262
00:18:20,880 --> 00:18:24,560
"في الفنون الطبّيّة الّتي أسّسها ابن سينا

263
00:18:25,020 --> 00:18:28,760
بخلاف علم اللّاهوت، والّذي نُكرّر فيه"
،ببساطة ما يتمّ تلقيننا إيّاه

264
00:18:28,760 --> 00:18:32,580
العلم هو معرفة مبنيّة على الخبرة الحقيقيّة
"في الحياة والمُكتسَبة بواسطة العُلماء

265
00:18:33,060 --> 00:18:36,530
وجدتُ بأنّ أسلوب التعلُّم هذا"
"هو أكثر قبولاً

266
00:18:36,530 --> 00:18:37,570
"...وأيضاً"

267
00:18:38,880 --> 00:18:42,290
،إذا كلّفت نجمتُنا الصّغيرة سيتارا نفسها وأصغتْ

268
00:18:42,290 --> 00:18:47,060
"فأخبريها رجاء عن إقليدس وبطليموس

269
00:18:49,890 --> 00:18:51,250
تعالي معي

270
00:18:58,740 --> 00:19:01,800
شكراً لكِ على إطلاعي على كلّ
هذه الكُتُب الثّمينة

271
00:19:01,800 --> 00:19:06,840
لا داعي للشّكر. فالبحث عن المعرفة
هو واجب كُلّ مُسلم

272
00:19:07,210 --> 00:19:09,920
هذا ما أخبرني به زوجي المُثقّف الرّاحل

273
00:19:10,240 --> 00:19:12,830
عناصر إقليدس موجود هناك

274
00:19:13,150 --> 00:19:13,970
حسناً

275
00:19:22,460 --> 00:19:24,900
"النّقطة لا تملك أبعاد"

276
00:19:24,900 --> 00:19:27,120
"الخطّ هو طول بلا عرض"

277
00:19:27,120 --> 00:19:29,870
"نهايات الخطّ هي عبارة عن نقاط"

278
00:19:29,870 --> 00:19:33,750
وكأنّه يعبّر عمّا هو واضح بطريقة مُبالغ بها

279
00:19:33,750 --> 00:19:36,490
لكن ما الّذي يجعل "الأشياء الواضحة" واضحة؟

280
00:19:36,490 --> 00:19:41,050
بجمع الأمثلة واحداً تِلو الآخر نُثبت
المبادئ الكونيّة

281
00:19:41,870 --> 00:19:42,950
هل كان ذلك صعباً جدّاً؟

282
00:19:42,950 --> 00:19:47,290
أجل، آسفة. أنا فقط لا أعرف كيفيّة
تطبيق هذه المعرفة

283
00:19:47,560 --> 00:19:50,250
في هذه الحالة، لنبحث عن كِتاب
أكثر إثارة للاهتمام لكِ

284
00:19:50,770 --> 00:19:54,290
كِتاب البيرونيّ في تعليم عناصر فنّ علم الفلك

285
00:19:54,290 --> 00:19:55,790
كِتاب حول علم الفلك؟

286
00:19:56,020 --> 00:19:57,390
هذا واقعيّ أكثر، صحيح؟

287
00:19:57,750 --> 00:19:59,620
اقرئي هذا

288
00:20:00,810 --> 00:20:06,270
،قُطر الأرض هو 2،163 و 1\3 فرسخ"

289
00:20:06,270 --> 00:20:09,270
"ومُحيط دائرتها 6800 فرسخ

290
00:20:09,760 --> 00:20:12,630
سافر هذا الشّخص إلى أطراف الأرض؟

291
00:20:12,630 --> 00:20:15,150
بالطّبع لا. هذا مُستحيل

292
00:20:16,210 --> 00:20:18,750
،بتشكيل مُثلّث باستخدام بقعة في الأرض

293
00:20:18,750 --> 00:20:22,130
،على قمّة جبل، وفي مركز الأرض

294
00:20:22,130 --> 00:20:24,850
من المُمكن تحديد نصف قطر الأرض

295
00:20:24,850 --> 00:20:26,410
قمّة جبل؟

296
00:20:27,980 --> 00:20:33,240
يمكنكِ أيضاً حِساب مُحيط الأرض
باستخدام زاوية الظِّلال

297
00:20:33,240 --> 00:20:34,570
باستخدام الظِّلال؟

298
00:20:39,350 --> 00:20:43,550
كُلّ هذا استُمِدّ من المعرفة الكونيّة
"الّتي وجدتُها في كِتاب "العناصر

299
00:20:43,980 --> 00:20:46,010
ما رأيكِ؟ هل أثار اهتمامكِ؟

300
00:20:47,710 --> 00:20:48,820
!إنّه يحترق

301
00:20:48,820 --> 00:20:49,220
ماذا؟

302
00:20:54,850 --> 00:20:57,670
أنتِ تخفقين كثيراً في الآونة الأخيرة

303
00:20:58,630 --> 00:21:00,650
أنا آسفة يا آنسة أنيس

304
00:21:01,720 --> 00:21:03,320
اسمعي يا سيتارا

305
00:21:03,320 --> 00:21:05,360
يؤدّي العبيد مُختلف أنواع الأعمال

306
00:21:05,620 --> 00:21:10,150
بعض العبيد يُوفَّر لهم التّعليم من أجل
ترفيه أسيادهم

307
00:21:10,970 --> 00:21:14,830
وأحياناً نتلقّى حتّى وعداً بالعتق

308
00:21:15,200 --> 00:21:18,930
لكن لا ينبغي أن ترفعي سقف آمالكِ كثيراً

309
00:21:18,930 --> 00:21:21,780
لسنا نحن من يُقرّر مثل هذه الأشياء

310
00:21:22,260 --> 00:21:24,380
لسنا أُناساً. نحن مُمتلكات

311
00:21:24,380 --> 00:21:25,930
...يا فتاتان، رجاء

312
00:21:25,930 --> 00:21:27,340
اجتماع مُهمّ

313
00:21:27,900 --> 00:21:29,640
هل يمكنكِ إحضار زُمرُّد أيضاً؟

314
00:21:29,880 --> 00:21:31,260
ما الأمر؟

315
00:21:31,710 --> 00:21:35,020
هُزِمَتْ ميليشيا طوس على يد الرّحّالة

316
00:21:38,980 --> 00:21:43,280
،لم تستجب السّماءُ لصلواتنا بالرّحمة
بل بالنّار

317
00:21:43,810 --> 00:21:48,000
بدلاً من الأمطار، انهمرتْ جمرات النّار
،في كُلّ أرجاء الأرض، متبوعة بصمت

318
00:21:49,170 --> 00:21:51,410
الصّمت الّذي حلَّ مكان اللّهب

319
00:21:55,100 --> 00:21:57,790
سموّك، كما ترى، أسقطنا

320
00:21:58,060 --> 00:22:00,060
الحمقى الّذين أشهروا أسلحتهم في وجهنا

321
00:22:00,400 --> 00:22:02,020
سندخل إلى مدينتهم في غضون أيّام

322
00:22:04,230 --> 00:22:07,070
على ذِكر الأمر، هل هناك عُلماء في طوس؟

323
00:22:07,400 --> 00:22:08,070
سموّك؟

324
00:22:08,740 --> 00:22:10,700
فأنا أبحث عن شيء

325
00:23:43,100 --> 00:23:48,250
الورود الّتي تتفتّح في صَفَر

326
00:23:43,590 --> 00:23:46,280
"الحلقة القادمة: "الورود الّتي تتفتّح في صفَر