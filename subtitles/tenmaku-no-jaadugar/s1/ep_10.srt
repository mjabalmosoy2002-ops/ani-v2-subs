1
00:00:06,470 --> 00:00:09,000
‫جرع أحدهم الخاقانَ الأعظم السُّمّ

2
00:00:09,000 --> 00:00:11,740
‫بيدَ أنَّهُ إن بَرِئَت كفَّاكِ من سَبكِ هذا السُّمِّ...

3
00:00:11,740 --> 00:00:13,620
‫فـمآلُ الاتهامِ مَوجّهٌ حتمًا صَوبَ توراكينا

4
00:00:15,580 --> 00:00:17,690
‫نَطقَت هَواجسُ الأرواحِ الحارِسةِ بِـالمَقَال

5
00:00:17,690 --> 00:00:21,590
‫صونُ سلامةِ الخاقانِ الأعظم تقتضي تقديمَ قُربانٍ يَفديه

6
00:00:21,590 --> 00:00:24,880
‫فليتَجَرَّع أحدُكم مَحاميلَ هذا الـمِخضَبِ حتى الرمقِ الأخير

7
00:00:26,910 --> 00:00:28,340
‫طالما كانَ ذلِك... فـلتَكُن رُوحي فِداءَهُ

8
00:02:23,740 --> 00:02:25,620
‫ألمٌ يعتصرُ جسدي

9
00:02:26,740 --> 00:02:28,830
‫وجسدي عاجزٌ عَنِ الحِراك

10
00:02:31,830 --> 00:02:35,770
‫أهكذا أهوي في غَياهبِ العالمِ السُّفليّ؟

11
00:02:36,740 --> 00:02:38,470
‫ملكوت الخلود

12
00:02:39,210 --> 00:02:41,810
‫حيثُ تَستوطنُ مَعشرَ الأرواح

13
00:02:42,350 --> 00:02:47,470
‫غورٌ سحيقٌ تَعجزُ الكاماتُ عن هُبوطِهِ لِـرَدِّ الأرواح

14
00:02:48,230 --> 00:02:52,340
‫أَيُكتبُ عليَّ الأسرُ هاهنا أبدَ الآبدين؟

15
00:02:52,340 --> 00:02:53,450
‫شقيقي

16
00:02:56,090 --> 00:02:58,560
‫أهنا يَقبعُ جَسدكَ إذن يا شقيقي؟

17
00:02:58,560 --> 00:03:01,060
‫تولوي؟ مَـما الذي حَدَا بِكَ لِـحُلولِ هذا الغَور؟

18
00:03:02,190 --> 00:03:04,710
‫أَضناني رَصدُ خُطَاكَ بينَ العَوالِمِ يا شقيقي

19
00:03:04,920 --> 00:03:09,290
‫فقد طَوَيتُ آفاقَ السَّماءِ وغَياهبَ الثَّرى حتى بَلغتُكَ الساعة

20
00:03:09,540 --> 00:03:11,290
‫فـهَلُمَّ بنا نَقفلُ راجعين

21
00:03:13,300 --> 00:03:14,480
‫تولوي...

22
00:03:15,100 --> 00:03:17,550
‫هيهاتَ لَنا سَبيلٌ لِـلخروج

23
00:03:18,890 --> 00:03:22,110
‫إذ لَو فُقِدَت روحٌ واحِدةٌ من هذا السُّرادق

24
00:03:22,110 --> 00:03:24,290
‫فسترصدُ غيابَها الأرواحُ الخبيثةُ لا مَحالة

25
00:03:24,680 --> 00:03:27,960
‫وتَصُبُّ غَضبَها نازِلةً تُزلزلُ جَسدَ البَسيطة

26
00:03:40,520 --> 00:03:43,680
‫فدَع جَسدي ورُوحي يَقومانِ مَقامَ فِدائِكَ إذن

27
00:03:44,030 --> 00:03:44,870
‫ماذا؟

28
00:03:46,580 --> 00:03:48,800
‫ويحكَ يا تولوي... كفَّ عنِ الجُنون

29
00:03:49,590 --> 00:03:55,320
‫فمَا أَحسنتُ طَوالَ عُمري غيرَ قِراعِ الحروب، وها نحنُ نَدحرُ غريمَنا العتيقَ جِين

30
00:04:10,310 --> 00:04:14,780
‫وأنتَ المُنفَرِدُ بـحِكمَتِكَ لِـصياغةِ مَعالمِ العهدِ المقبل

31
00:04:14,780 --> 00:04:16,240
‫كُفَّ عن هذا التَّجاوزِ يا تولوي

32
00:04:18,200 --> 00:04:20,320
‫رافقتكَ السلامةُ يا شقيقي

33
00:04:23,040 --> 00:04:24,960
‫تولوي

34
00:04:25,530 --> 00:04:28,460
‫فالتزمِ الحَيطةَ حينَ تعودُ أَوبةً إلى ظاهرِ الأرض

35
00:04:29,220 --> 00:04:33,260
‫وصُن بـحِمَاكَ زوجتي سورغاغتاني نيابةً عنِّي

36
00:04:46,970 --> 00:04:48,050
‫أيها الخاقان الأعظم

37
00:04:50,110 --> 00:04:51,230
‫أَأَفقتَ من سَكرةِ غَشيتِك؟

38
00:04:52,950 --> 00:04:54,450
‫بوراكتشين؟

39
00:04:55,760 --> 00:04:58,970
‫أين تولوي؟ أين يَقبعُ أثرُهُ الساعة؟

40
00:05:11,620 --> 00:05:12,930
‫أَمِن مَلأٍ يَقِفُ بالباب؟

41
00:05:12,930 --> 00:05:15,180
‫أبشِروا، عادَ الخاقانُ الأعظمُ لِـوَعيِهِ وصَحوِهِ

42
00:05:19,350 --> 00:05:20,550
‫تولوي...

43
00:05:31,630 --> 00:05:34,940
‫قُوِّضَ سُرادقُ قاداق ورُحِلَ بهِ عن الموضع

44
00:05:36,220 --> 00:05:37,550
‫أفَلِمَ جرى الرحيلُ على عجل؟

45
00:05:37,910 --> 00:05:41,290
‫وأَمَّلتُ أن أَستطلعَ منهُ ما حَلَّ بالـخاتونِ توراكينا من نوائب

46
00:05:46,300 --> 00:05:47,740
‫أَيَكونُ هذا...

47
00:05:47,740 --> 00:05:49,330
‫فاطمة

48
00:05:50,780 --> 00:05:51,920
‫شيرا؟

49
00:05:53,860 --> 00:05:55,380
‫مـ-ما الخطب؟

50
00:05:57,220 --> 00:05:58,300
‫الأميرُ تولوي...

51
00:06:02,470 --> 00:06:03,260
‫ماذا؟

52
00:06:07,600 --> 00:06:09,710
‫تلا ذلك الفاجعُ انقضاءَ طقوسِ التَّعويذِ مباشرةً

53
00:06:16,820 --> 00:06:21,070
‫أَلَمَّت بالأميرِ تولوي نَوبةُ كربٍ في طريقِ أَوبَتِهِ للديار

54
00:06:36,730 --> 00:06:39,670
‫وبلغَ بـعَناءٍ جِوارَ الخاتونِ سورغاغتاني مَعقِلَهُ

55
00:06:42,600 --> 00:06:45,200
‫بيدَ أنَّهُ فارقَ الحياةَ قاضيًا نحبَهُ بُعيدَ ذلِك

56
00:06:58,150 --> 00:07:02,220
‫يَرتسمُ للعيانِ أنَّهُ جادَ بـروحِهِ فِداءً للخاقانِ الأعظم

57
00:07:02,650 --> 00:07:06,140
‫هيهاتَ أن يكون... فـتصديقُ فِكرةِ الفِداءِ تلكَ ضَربٌ منَ الهَذيان

58
00:07:08,420 --> 00:07:10,180
‫أفَيؤولُ مآلُ غيبتِهِ إذن...

59
00:07:13,180 --> 00:07:14,640
‫قُتِلَ غِيلةً؟

60
00:07:16,190 --> 00:07:19,860
‫تريّث... فكلُّ ما عاينتُهُ منذُ الأمسِ يذهبُ بـعقلي ذُعرًا

61
00:07:19,860 --> 00:07:21,550
‫فمَا لَـنا لا نَفقهُ حقيقةَ الخطبِ الـمُلِمِّ بـنا؟

62
00:07:21,550 --> 00:07:23,070
‫يا فاطمة

63
00:07:23,070 --> 00:07:26,570
‫أرى لَكِ ألا تعودي أدراجَكِ صَوبَ ديارِ آلِ تولوي

64
00:07:26,570 --> 00:07:27,210
‫ماذا؟

65
00:07:27,210 --> 00:07:31,180
‫أَوفَدتكِ الخاتونُ سورغاغتاني لِتَذودي عَنها شَرَّ النازلات

66
00:07:31,500 --> 00:07:34,060
‫بيدَ أنَّ النازلةَ الكبرى بَرَزتِ الساعة

67
00:07:34,060 --> 00:07:36,350
‫وضَرَبتِ بـكاملِ ثِقَتِها عرضَ الحائط

68
00:07:38,150 --> 00:07:39,250
‫وعلاوةً على ذلك...

69
00:07:40,160 --> 00:07:43,850
‫فبـزَوالِ الأميرِ تولوي، يَقتربُ أُفولُ حِمى آلِ تولوي

70
00:07:45,360 --> 00:07:48,650
‫ولَعَلَّ مَقاليدَ السيادةِ ستَنحصرُ الساعةَ في قَبضةِ الخاقانِ الأعظمِ وحدَه

71
00:07:49,470 --> 00:07:54,110
‫فإن آلَتِ الأمورُ لِـهذا، فمَا تمنيتُ إلا خدمةَ ديوانِ آلِ أوقطاي

72
00:07:55,800 --> 00:07:59,500
‫ما رأيُكِ يا فاطمة؟ أَتَشفعينَ لي عِندَ كُبَرائِهم بـجميلِ القول؟

73
00:08:00,970 --> 00:08:02,060
‫أَتُصغينَ لِـمَقالي يا فاطمة؟

74
00:08:11,950 --> 00:08:16,000
‫فَدى تولوي الخاقانَ الأعظمَ بـروحِه

75
00:08:17,530 --> 00:08:22,650
‫عَساهُ يُمثلُ وجهَ الحقيقة... وعَساهُ يَتوارى عَنها

76
00:08:23,700 --> 00:08:30,250
‫بيدَ أنَّ الثابِتَ الموقَنَ، أنَّ مَوازينَ القوّةِ المختلّةَ التي عَهَدتها الإمبراطورية

77
00:08:30,670 --> 00:08:35,200
‫ستَشهدُ تَبَدُّلاً كبِيرًا وزَلزلةً عاصِفةً في أعقابِ مَصرعِ تولوي

78
00:08:38,580 --> 00:08:44,560
‫والآن... يَتلو شيغي قوتوقو اليارغوجي مَحاضرَ تَقسيمِ غَنائمِ الغَزو

79
00:08:46,510 --> 00:08:49,760
‫أبصِروا هؤلاءِ الرجالَ الذين أَوفَدناهم من عاصمةِ جِين

80
00:08:50,800 --> 00:08:53,880
‫بينَ حُكماءِ علمٍ، ونطاسيينَ في الطب، وصنّاعِ هَندسة

81
00:08:53,880 --> 00:08:56,900
‫ولا ريبَ أنَّ صنيعَ مَهاراتِهم سيُقوّمُ مَتاعَ الإمبراطوريةِ ويَزيدُها مَنعَة

82
00:08:58,680 --> 00:09:00,560
‫أفَهذهِ هيَ الهِبةُ التي وَعَدتَ بها يا خاقاني؟

83
00:09:07,840 --> 00:09:09,600
‫أَاستدعيتِني؟

84
00:09:11,320 --> 00:09:13,200
‫تنامت إليَّ الأنباءُ من كَلِمِ اليارغوجي

85
00:09:13,670 --> 00:09:18,040
‫أَتَسعينَ خِلافًا لـ "الياسا" في استصلاحِ مَزيدٍ منَ الأراضي والرعايا لِـنجلِكِ؟

86
00:09:21,120 --> 00:09:24,630
‫إنَّ نجلي كَتَبَ مَلاحِمَ مَشهودةً في غزوِ سلالةِ جِين

87
00:09:24,860 --> 00:09:27,250
‫أوَلستُم تَعلمونَ جدارَتَهُ هذهِ عيانًا؟

88
00:09:27,250 --> 00:09:28,460
‫يا أماه

89
00:09:28,460 --> 00:09:29,620
‫كودان...

90
00:09:29,620 --> 00:09:31,630
‫اغفروا لنا جُرأتَنا، ولا تَعقدوا بالاً لِـقولِ أُمِّي

91
00:09:31,630 --> 00:09:33,430
‫كودان، أَنزِلني في الحال

92
00:09:33,430 --> 00:09:35,630
‫إنَّما أسعى بكلِّ هذا لـصالحِ عزمِك

93
00:09:33,430 --> 00:09:36,490
‫أُمَّاه، تَمالكي نفسَكِ

94
00:09:38,630 --> 00:09:41,490
‫الـ-الأمرُ هوَ أنَّ...

95
00:09:41,490 --> 00:09:43,020
‫تِلكَ الغايةُ العظيمةُ التي تَتوقُ إليها نفسُكِ...

96
00:09:43,460 --> 00:09:45,580
‫يُوشكُ أن تُستجابَ لَكِ عما قريب

97
00:09:47,600 --> 00:09:48,350
‫ماذا؟

98
00:10:03,750 --> 00:10:05,010
‫ها هوَ ذا

99
00:10:12,710 --> 00:10:13,860
‫فاطمة

100
00:10:15,430 --> 00:10:16,890
‫الخاتونُ الكبرى بوراكتشين

101
00:10:19,780 --> 00:10:21,350
‫مَا الذي قادَ رِكابكِ لحلولِ مَوضعي هذا يا خاتون؟

102
00:10:21,350 --> 00:10:26,070
‫بفضلِ بَراعةِ عِلمِكِ وصنيعِكِ، رُدَّت مَعالمُ العافيةِ إلى جسدِ الخاقانِ الأعظم

103
00:10:26,070 --> 00:10:28,260
‫فَحَللتُ بـديارِكِ الساعةَ لأبسطَ بينَ يَديكِ عُربونَ امتناني

104
00:10:29,900 --> 00:10:31,960
‫جُودي بـقَبولِ هذا السِّفر

105
00:10:32,960 --> 00:10:33,780
‫ماذا؟

106
00:10:35,860 --> 00:10:37,480
‫سِفرُ "الأصولِ" لِـإقليدس؟

107
00:10:37,950 --> 00:10:41,580
‫أفشيتُ لـلخاتونِ سورغاغتاني بـرغبتِكِ الصادقةِ في حَوزِ هذا السِّفر

108
00:10:41,580 --> 00:10:43,960
‫فجادَت بهِ طائعةً ونائيةً بنفسِها عنِ الشُّح

109
00:10:44,840 --> 00:10:47,080
‫أني كنتُ أَنشُدُه...

110
00:10:49,250 --> 00:10:50,620
‫أمن أيِّ رِكابٍ تناهى إلى مَسامعِكِ خَبَرُ مَطلبي؟

111
00:10:52,250 --> 00:10:54,420
‫أأَفضت الخاتونُ توراكينا بـالحديثِ إليكِ؟

112
00:10:54,420 --> 00:10:55,630
‫فاطمة

113
00:10:56,990 --> 00:10:59,650
‫اطوِي صفحاتِ ذِكرِ تلكَ الخاتونِ من خَلَدكِ

114
00:11:01,300 --> 00:11:04,620
‫أجمعتُ أمري على تقويضِ سُرادِقِها قَبلَ غروبِ شمسِ اليوم

115
00:11:04,980 --> 00:11:07,820
‫وحَسبي أن تضَعي حِلوَ رحالِكِ عِندَ حدودِ سُرادقي

116
00:11:09,270 --> 00:11:10,860
‫الخاتونُ بوراكتشين...

117
00:11:10,860 --> 00:11:14,100
‫سيري في رِكابِ خُطاي، فثمةَ ما أبتغي بَسطَهُ أمامَ عينيكِ

118
00:11:26,240 --> 00:11:30,990
‫أَتَنازلت الخاتونُ سورغاغتاني لِـسموِّكِ عن هذهِ الأسفارِ قاطِبةً؟

119
00:11:30,990 --> 00:11:33,840
‫أجل، بـجميلِ صَفحٍ وسَماحةِ نَفس

120
00:11:34,680 --> 00:11:37,430
‫بِـ-بيدَ أنَّ الخاتونَ قالَت مِراصًا...

121
00:11:37,760 --> 00:11:39,260
‫أنا كذلِك أَتوقُ لِـمعرفةِ مَزيدٍ منَ الأسرار

122
00:11:39,800 --> 00:11:44,310
‫عن سائرِ الأقطارِ التي تَطؤُها حَوافِرُ خيلِ المغول

123
00:11:45,440 --> 00:11:48,610
‫إنَّ مَنفذَ مَصرعِ تولوي لَـخطبٌ فاجعٌ أليم

124
00:11:49,060 --> 00:11:50,360
‫بيدَ أنَّهُ...

125
00:11:51,350 --> 00:11:54,070
‫يَسكنُ لِـعقلي أنَّ في مَوتِهِ قضاءً وتَنزيلًا منَ السَّماء

126
00:11:55,440 --> 00:12:01,280
‫فالخاقانُ الأعظمُ يَنفردُ بـحِكمةٍ حقيقيةٍ يقودُ بها مَسارَ الإمبراطوريةِ نحو مَطلعِ فَجرٍ جَديد

127
00:12:01,600 --> 00:12:06,120
‫بينما يَعني بقاءُ تولوي عقبةً كأوداء تحجبُ طمأنينةَ هذا السَّداد

128
00:12:07,140 --> 00:12:09,310
‫وأنتِ ذاتُكِ أفضيتِ لَنا بـمِثلِ هذا القول

129
00:12:09,760 --> 00:12:14,340
‫إذ عاينتِ بـعينِ فِطنتِكِ خطرَ استئثارِ آلِ تولوي بالمَنعةِ والمعرفةِ معًا

130
00:12:16,800 --> 00:12:21,470
‫وعزمتُ الساعةَ على اغتنامِ هذا الموعدِ لِتقويمِ ذلكَ التفاوتِ المريب

131
00:12:22,710 --> 00:12:23,840
‫فاطمة

132
00:12:24,200 --> 00:12:28,800
‫ليستِ الـمَنعةُ العسكريةُ مَن يقبضُ على مَقاليدِ الغَدِ للإمبراطورية، بلِ الحِكمة

133
00:12:29,230 --> 00:12:33,570
‫أَوَلا تَتوقُ نَفسكِ لِـبَسطِ حِكمَتِكِ ونَفائسِ مَعرفَتِكِ على أتمِّ وجه؟

134
00:12:34,020 --> 00:12:37,030
‫وهل في رِحابِ الوجودِ ما يفوقُ هذا مَتعةً ولَذَّة؟

135
00:13:04,620 --> 00:13:09,890
‫لو لَبِثتُ في طوس ما طَمِحت نواظري لِـشهودِ مَشهدٍ يفيضُ بـهذه المهابة

136
00:13:09,890 --> 00:13:13,190
‫عزمتُ... على الارتحال

137
00:13:13,460 --> 00:13:17,600
‫لأنهل من شتى ينابيع الحكمة بحثًا عن الحقيقة

138
00:13:22,220 --> 00:13:23,950
‫سيدي محمد

139
00:13:24,470 --> 00:13:28,160
‫لتَعلمَ أنَّ لواعجَ الغيظِ عَصَفت بـجَناني يومَذاك

140
00:13:29,370 --> 00:13:31,080
‫وتملَّكَني الضَّغَنُ والـحَسد

141
00:13:31,600 --> 00:13:35,340
‫إذ رَأيتُكَ حُرًّا طَليقًا تَرتحلُ حيثُ يَقودُكَ هواك

142
00:13:37,200 --> 00:13:43,220
‫بيدَ أنِّي حُزتُ منَ المَعرفةِ ما يَفوقُ بكثيرٍ رَحابةَ عُمرِكَ القصير

143
00:13:44,390 --> 00:13:46,640
‫لَعَلَّهُ آنَ أوان...

144
00:13:47,880 --> 00:13:51,120
‫أن أمضي بـصَرحِ حياتي قُدُمًا دونَ التفات

145
00:14:05,630 --> 00:14:07,380
‫ما هذا الصَّوتُ العاصف؟

146
00:14:07,380 --> 00:14:08,910
‫أأَنتَ سالِمٌ مِـمَّا جَرى؟

147
00:14:08,910 --> 00:14:11,500
‫أرجو المَعذرة، انهارَ هذا العمودُ المعلقُ بـغتة

148
00:14:12,380 --> 00:14:14,960
‫خلتُ صاعقةً تَهوي من أطباقِ السماء

149
00:14:20,550 --> 00:14:22,120
‫انظري كيف أصابهم الهلع

150
00:14:25,700 --> 00:14:28,780
‫أنتِ لا تدرين الآن أين تضعين قدميكِ

151
00:14:28,780 --> 00:14:30,470
‫ولا ما يدور حولكِ من خطوب

152
00:14:30,470 --> 00:14:32,630
‫ولا ما تؤول إليه أقداركِ

153
00:14:32,630 --> 00:14:34,360
‫إن مسيرة حياتكِ حافلةٌ بالمجهول

154
00:14:38,140 --> 00:14:42,240
‫أَوكيفَ خِلتُ لـوهلةٍ أنِّي أَرشَدُ عَقلاً من سيدي محمد؟

155
00:14:43,060 --> 00:14:45,450
‫فأينَ يَستقرُّ مَقامي في رِحابِ هذا الوجود؟

156
00:14:47,480 --> 00:14:49,640
‫أصولُ إقليدس...

157
00:14:50,750 --> 00:14:53,490
‫ذاتُ الأسفارِ التي ذادت عَنها سيدتي فاطمةُ لِـتصونَهما

158
00:14:54,570 --> 00:14:58,890
‫وتِلكَ المباحثُ التي حَكَمَت عاقبتُها بـإزهاقِ رُوحِ سيدتي

159
00:14:59,960 --> 00:15:03,490
‫بل إنَّ الغريمَ الأثيمَ الذي فتكَ بـسيدتي، بادَ وفَنيَ عَنِ الأعين

160
00:15:04,660 --> 00:15:10,970
‫تلخَّصَ قِبلةُ مَسعايَ في استردادِ هذا السِّفرِ، بـصفتي جاريةً لـسيدتي

161
00:15:12,710 --> 00:15:14,380
‫سيدتي فاطمة...

162
00:15:14,700 --> 00:15:17,810
‫ها أنا ذي... بَلغتُ كُلَّ مَرامي وعَزمي

163
00:15:20,350 --> 00:15:21,450
‫جَاريةٌ؟

164
00:15:25,660 --> 00:15:26,990
‫الخاتونُ بوراكتشين

165
00:15:28,320 --> 00:15:32,620
‫أأَفصحت الخاتونُ توراكينا لسموّكِ عن حقيقةِ نَشداني لهذا السِّفر؟

166
00:15:34,510 --> 00:15:38,060
‫أَوَليسَ هذا السِّفرُ مَبحثًا في عِلمِ الهندسَةِ والأشكال؟

167
00:15:38,060 --> 00:15:41,800
‫فَقَد تناهى إليَّ أنَّ نَفسكِ تَتوقُ لِـقراءَتِهِ منذُ أمدٍ بعيد

168
00:15:42,070 --> 00:15:46,000
‫أَسوةً بـأبيكِ الحكيمِ الذي قَضى في مَيدانِ العلم، فيما أحسَب؟

169
00:15:52,940 --> 00:15:55,760
‫أجل، صَدقَ فصيحُ القولِ عِندَكِ يا خاتون

170
00:16:07,820 --> 00:16:09,280
‫تَبينتُ الساعةَ مَعلمًا واحدًا منَ الحقيقة

171
00:16:10,580 --> 00:16:14,840
‫أنَّ الخاتونَ الكبرى بوراكتشين نَالَت عِلمَ هذا السِّفرِ من لسانِ الخاتونِ توراكينا

172
00:16:15,380 --> 00:16:18,040
‫ومَهما تَعذّرَ على عَقلي تخمينُ ما عَصَفَ بينَهُما من حِيَل...

173
00:16:18,720 --> 00:16:20,420
‫بيدَ أنَّ الثابِتَ الموقَنَ لَـديَّ...

174
00:16:21,860 --> 00:16:24,840
‫أُدعى ستارا... جاريةٌ مستضعفة

175
00:16:25,590 --> 00:16:30,910
‫ولأجل هذا، آثرتُ كتمانَ ماضيَّ الميركيتي وجعلتُهُ سِرًّا دَفينًا عن الأعين

176
00:16:31,620 --> 00:16:33,560
‫فمَا أرجوهُ من جَنانِكِ هو كتمانُ هذا السِّرِّ يا فاطمة

177
00:16:33,560 --> 00:16:36,640
‫أنَّ الخاتونَ توراكينا لم تُفشِ الغِطاءَ عَن...

178
00:16:37,300 --> 00:16:39,270
‫تِلكَ الأسرارِ التي تَقاسمنا كَتمَها

179
00:16:39,480 --> 00:16:41,300
‫ولا سَعيرِ السَّخَطِ والغضبِ المعتملِ في صُدورِنا

180
00:16:59,120 --> 00:17:00,600
‫أرى أنَّ مَجهودَ كفّيكِ اليومَ يستوجبُ الشُّكر

181
00:17:34,250 --> 00:17:35,140
‫شيرا

182
00:17:36,030 --> 00:17:37,490
‫فاطمة؟

183
00:17:37,490 --> 00:17:40,020
‫أَوَلَم أُحذِّركِ منَ العودةِ صَوبَ ديارِنا؟

184
00:17:40,020 --> 00:17:41,610
‫جئتُ أطلبُ منكِ أمرًا

185
00:17:42,040 --> 00:17:46,510
‫أَعِنّي، وسأبسطُ لكَ سبيلاً تعتلي فيه مجلسَ الخاقانِ الأعظمِ أو الخاتونِ الكبرى

186
00:17:46,950 --> 00:17:48,610
‫سَلي عمَّا بدا لَكِ من شؤون

187
00:17:49,240 --> 00:17:52,670
‫ذكرتَ آنفًا أن زعامة حمى آل تولوي لن تطول

188
00:17:53,000 --> 00:17:54,020
‫فَلِمَ ذاك؟

189
00:17:54,020 --> 00:17:56,860
‫الأمرُ بيّن، فـبـمَصرعِ الأميرِ تولوي وزوالِهِ...

190
00:17:56,860 --> 00:18:01,680
‫عجزت مخيلتي عن إدراكِ مَقدرةِ الخاتونِ سورغاغتاني وسائرِ بقيتِهِ على صَونِ حِمى نفوذِهم

191
00:18:02,360 --> 00:18:04,820
‫بل إنِّي عاينتُ منذُ أيام...

192
00:18:06,330 --> 00:18:09,680
‫سلبوا خَلقًا كثيرًا من أسفارِكِ الـمُباركةِ يا أُمَّاه

193
00:18:10,840 --> 00:18:13,740
‫أَتَرتضينَ الصمتَ على هذا الصنيعِ خُنوعًا؟

194
00:18:14,450 --> 00:18:16,770
‫أقصدُ سِفرَ "الأصولِ" الثمين...

195
00:18:17,150 --> 00:18:21,200
‫أَوَلَم يَحملهُ أبي خِصيصًا لِـسموِّكِ من دِيارِ فارسَ القاصية؟

196
00:18:22,180 --> 00:18:23,870
‫لا بأس

197
00:18:25,150 --> 00:18:28,020
‫فمَا عادَ لـجَناني حاجةٌ في مَباحثِه

198
00:18:28,700 --> 00:18:31,870
‫فلتَحُز الخاتونُ الكبرى بوراكتشين كلَّ ما تبتغيهِ رِضًا

199
00:18:32,380 --> 00:18:37,210
‫تبًا... ما عاد في جَناني رغبةٌ للمسيرِ في رِكابِ مَن خَمَدَت مَطامِحُها

200
00:18:38,910 --> 00:18:39,770
‫ماذا؟

201
00:18:39,770 --> 00:18:42,140
‫أهِيَ إذن مَن كَبَّلَ خُطانا بـمكرِها منذُ البدءِ؟

202
00:18:42,490 --> 00:18:45,760
‫ما كُنتُ إلا دُميةً تُحرِّكُها مَكائدُ الخاتونِ الكبرى بوراكتشين

203
00:18:46,660 --> 00:18:47,980
‫فمَا أشدَّ مَرارةَ الخِذلان

204
00:18:49,990 --> 00:18:52,710
‫خلتُني أَرشدَ عَقلاً وحِكمةً منَ الخلائقِ قاطِبةً حولي

205
00:18:52,710 --> 00:18:55,160
‫ونازلتُ مَكرَها العارم وأنا رَافلةٌ في غفلةٍ مَكتومة

206
00:19:02,090 --> 00:19:05,920
‫بيدَ أنَّ السَّاعةَ تجتنبُ غُصَصَ الغيظِ والحَسرة

207
00:19:09,090 --> 00:19:11,050
‫أَرجو مَعونتكَ عاجِلاً يا شيرا

208
00:19:11,350 --> 00:19:12,620
‫أَعِنّي

209
00:19:12,960 --> 00:19:15,110
‫ثمةَ خاتونٌ يتعينُ عليَّ صونُ سلامتِها وإنقاذُها الساعة

210
00:19:15,110 --> 00:19:15,920
‫هيا

211
00:19:16,280 --> 00:19:19,640
‫مَـ-مهلًا، لا تَتركيني خلفَكِ

212
00:19:21,520 --> 00:19:22,360
‫هيا

213
00:20:15,860 --> 00:20:17,000
‫قاداق

214
00:20:18,090 --> 00:20:19,450
‫فاطمة

215
00:20:19,450 --> 00:20:20,480
‫أوكيفَ استدلَّت خُطاكِ على مَوضعي؟

216
00:20:20,480 --> 00:20:21,660
‫أبصِر بـيمينِك

217
00:20:21,660 --> 00:20:23,690
‫أَوَليسَت هذهِ صياغةَ مِيسمِك؟

218
00:20:27,080 --> 00:20:28,350
‫يا قاداق

219
00:20:28,350 --> 00:20:31,740
‫أينَ تَقبعُ الخاتونُ توراكينا؟ أَنبِئني بـسلامتِها عاجلاً

220
00:20:35,030 --> 00:20:39,770
‫إني لَأَحشدُ الساعةَ كُلَّ مَكرٍ وحيلةٍ لِإنقاذِ الخاتونِ توراكينا

221
00:20:39,770 --> 00:20:41,910
‫وإنَّ عَمَلي هذا يجري إنفاذًا لِـمَشيئةِ سَيّدي على كُلِّ حال

222
00:20:41,910 --> 00:20:43,120
‫سَيّدُكَ؟

223
00:20:43,120 --> 00:20:44,780
‫أَوَليستِ الخاتونُ توراكينا رَبَّةَ نِعمتِكَ وسيدتَكَ؟

224
00:20:44,780 --> 00:20:46,890
‫أفصحتُ لَكِ كرّاتٍ ومرّاتٍ أنَّها ليست هيَ المَعنية

225
00:20:49,840 --> 00:20:52,620
‫يَطولُ الخوضُ في تفاصيلِ هذا... اتبعاني

226
00:20:59,020 --> 00:21:01,490
‫أَتأذنُ لِـخادمِكَ قاداقَ بالولوج، أيُّها الأميرُ كيوك؟

227
00:21:02,910 --> 00:21:03,790
‫فمَا الخطب؟

228
00:21:04,440 --> 00:21:05,900
‫السرادقُ خالٍ تَمامًا

229
00:21:06,460 --> 00:21:09,830
‫إني قاداق... خادمُكَ الوفي يا أميرُ كيوك

230
00:21:14,870 --> 00:21:16,090
‫قاداق؟

231
00:21:17,210 --> 00:21:19,880
‫أَأَنتَ بمفردِكَ هاهنا؟

232
00:21:19,880 --> 00:21:21,680
‫دَاهَمني الخوفُ من حلولِ شخصٍ مجهول

233
00:21:23,070 --> 00:21:24,220
‫طَـ-طابَ يومُـ...

234
00:21:27,450 --> 00:21:29,050
‫قاداق... يا قاداق

235
00:21:29,050 --> 00:21:31,490
‫مَن تكونُ هذه؟ أقصِها عَنِّي الساعة

236
00:21:31,490 --> 00:21:34,820
‫إنَّ الأميرَ كيوك سريعُ التَّقلبِ وضَيقُ الصَّدر

237
00:21:34,820 --> 00:21:36,490
‫ولا أحسَبُ أنَّ الأقدارَ تَقِفُ في صَفِّكما اليوم

238
00:21:36,950 --> 00:21:37,670
‫انصرفا

239
00:21:37,670 --> 00:21:38,620
‫مَاذا؟

240
00:21:38,620 --> 00:21:40,530
‫تريّث... أَتَحسَبُ أنَّنا نَهذي هاهنا؟

241
00:21:40,820 --> 00:21:43,260
‫أجل، فمَا تَدبيرُكَ الـمُبهمُ في هذا؟

242
00:21:43,260 --> 00:21:44,890
‫الأمرُ مِثلَما صُغتُ...

243
00:21:44,040 --> 00:21:46,640
‫يا قاداق...

244
00:21:46,640 --> 00:21:47,940
‫أَرجو معونتكَ بـجودِ مَنك

245
00:21:47,940 --> 00:21:51,500
‫لستُ أدري مَن يكون، غيرَ أنَّ الخاتونَ توراكينا تَستجيرُ بـعَونِه...

246
00:21:51,500 --> 00:21:53,540
‫هذا هُوَ نجلُ الخاتونِ توراكينا البِكر

247
00:21:59,210 --> 00:22:00,650
‫الأميرُ كيوك...

248
00:22:01,280 --> 00:22:04,650
‫هو نجلُ الخاتونِ توراكينا البِكرُ الذي رُزِقَ بهِ الخاقانُ الأعظم

249
00:22:06,510 --> 00:22:07,470
‫مَاذا؟

250
00:23:38,420 --> 00:23:41,140
‫في الحلقةِ القادمة: «حَجرٌ دَميم»