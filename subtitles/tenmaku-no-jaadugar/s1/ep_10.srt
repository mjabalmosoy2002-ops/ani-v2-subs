1
00:00:06,470 --> 00:00:09,000
الخاقان العظيم قد سُمِّم

2
00:00:09,000 --> 00:00:11,740
...لكن إن لم تكوني أنتِ

3
00:00:11,740 --> 00:00:13,620
فهذا يعني بأنّها كانت توريكاني

4
00:00:15,580 --> 00:00:17,690
الأرواح الحامية قد نطقتْ

5
00:00:17,690 --> 00:00:21,590
يتطلّب إنقاذ المريض قُرباناً بدلاً منه

6
00:00:21,590 --> 00:00:24,880
ينبغي لأحدكم أن يشرب كُلّ
قطرة من هذا الماء

7
00:00:26,910 --> 00:00:28,340
إذاً ينبغي أن أكون أنا

8
00:00:50,920 --> 00:00:53,620
جادوغار

9
00:02:11,920 --> 00:02:16,410
حكمة

10
00:02:23,740 --> 00:02:25,620
هذا مُؤلم

11
00:02:26,740 --> 00:02:28,830
لا أستطيع الحركة

12
00:02:31,830 --> 00:02:35,770
لا بُدّ أنّني في أعماق العالم السُّفليّ

13
00:02:36,740 --> 00:02:38,470
عالم الخلود

14
00:02:39,210 --> 00:02:41,810
حيث تقطن الأرواح

15
00:02:42,350 --> 00:02:47,470
ولا حتّى الكامات كانت لتُغامر
في هذه الأعماق بحثاً عن روح

16
00:02:48,230 --> 00:02:52,340
هل سيتمّ أسري هنا للأبد؟

17
00:02:52,340 --> 00:02:53,450
!أخي

18
00:02:56,090 --> 00:02:58,560
كنتَ هنا إذاً يا أخي

19
00:02:58,560 --> 00:03:01,060
تولي؟ لماذا أنت هنا؟

20
00:03:02,190 --> 00:03:04,710
كنتُ أبحث عنك يا أخي

21
00:03:04,920 --> 00:03:09,290
،بحثتُ في العالمَين العلويّ والسّفليّ
فوجدتُك أخيراً

22
00:03:09,540 --> 00:03:11,290
تعال. هيّا بنا نعود

23
00:03:13,300 --> 00:03:14,480
تولي

24
00:03:15,100 --> 00:03:17,550
أخشى بأنّ هذا ليس مُمكناً

25
00:03:18,890 --> 00:03:22,110
،إذا فُقِدَتْ روحٌ واحدة من هذه الخيمة

26
00:03:22,110 --> 00:03:24,290
فسوف تُلاحظ الأرواح ذلك

27
00:03:24,680 --> 00:03:27,960
ونتيجة غضبها، قد تُسبّب كارثة على السّطح

28
00:03:40,520 --> 00:03:43,680
إذاً دعني أحلُّ مكانك

29
00:03:44,030 --> 00:03:44,870
ماذا؟

30
00:03:46,580 --> 00:03:48,800
تولي، لا تفعل ذلك

31
00:03:49,590 --> 00:03:55,320
كُلّ ما أعرفه هو الحرب، وقد قهرنا
خصومنا اللّدودين بالفعل، الجين

32
00:04:10,310 --> 00:04:14,780
أنت من سيصنع العصر المُقبل بذكائك

33
00:04:14,780 --> 00:04:16,240
!لا تفعل يا تولي

34
00:04:18,200 --> 00:04:20,320
وداعاً يا أخي

35
00:04:23,040 --> 00:04:24,960
!تولي

36
00:04:25,530 --> 00:04:28,460
!كُن حذراً أثناء عودتك إلى السّطح

37
00:04:29,220 --> 00:04:33,260
!من فضلك اعتنِ بسرقويتي بدلاً عنّي

38
00:04:46,970 --> 00:04:48,050
الخاقان العظيم

39
00:04:50,110 --> 00:04:51,230
استيقظت؟

40
00:04:52,950 --> 00:04:54,450
بُراقجين؟

41
00:04:55,760 --> 00:04:58,970
أين تولي؟ أين هو الآن؟

42
00:05:11,620 --> 00:05:12,930
هل من أحد هناك؟

43
00:05:12,930 --> 00:05:15,180
!الخاقان العظيم قد استيقظ

44
00:05:19,350 --> 00:05:20,550
تولي

45
00:05:31,630 --> 00:05:34,940
خيمة السّيّد قاداق اختفت

46
00:05:36,220 --> 00:05:37,550
لكن لماذا؟

47
00:05:37,910 --> 00:05:41,290
كنتُ آمل أن يخبرني عمّا حدث
لمولاتي توريكاني

48
00:05:46,300 --> 00:05:47,740
...لا بُدّ أنّ هذه

49
00:05:47,740 --> 00:05:49,330
!فاطمة

50
00:05:50,780 --> 00:05:51,920
شيرا؟

51
00:05:53,860 --> 00:05:55,380
ما-ما الأمر؟

52
00:05:57,220 --> 00:05:58,300
...الأمير تولي قد

53
00:06:02,470 --> 00:06:03,260
ماذا؟

54
00:06:07,600 --> 00:06:10,090
حدث ذلك بعد فترة قصيرة
من طقس الأرواح

55
00:06:16,820 --> 00:06:21,070
أُصيبَ الأمير تولي بنوبة في طريق عودته

56
00:06:36,730 --> 00:06:39,670
تمكّن من العودة إلى جانب الأميرة سرقويتي

57
00:06:42,600 --> 00:06:45,200
لكن تُوفّي بعدها بفترة قصيرة

58
00:06:58,150 --> 00:07:02,220
يبدو أنّه ضحّى بنفسه فعلاً لأجل الخاقان العظيم

59
00:07:02,650 --> 00:07:06,140
هذا غير مُمكن. الفكرة بحدّ ذاتها غير منطقيّة

60
00:07:08,420 --> 00:07:10,180
...ما يعني بأنّه قد

61
00:07:13,180 --> 00:07:14,640
اغتيل؟

62
00:07:16,190 --> 00:07:19,860
،لحظة. بحدوث كُلّ شيء منذ الأمس
أنا مُشوّشة تماماً

63
00:07:19,860 --> 00:07:21,550
ما الّذي يجري بالضّبط؟

64
00:07:21,550 --> 00:07:23,070
فاطمة

65
00:07:23,070 --> 00:07:26,570
أرى أنّه من الأفضل ألّا تعودي
إلى عائلة تولي

66
00:07:26,570 --> 00:07:27,210
ماذا؟

67
00:07:27,210 --> 00:07:31,180
الأميرة سرقويتي أرسلَتكِ لمنع
حدوث أسوأ الاحتمالات

68
00:07:31,500 --> 00:07:34,060
ومع ذلك، هذا ما حدث بالضّبط

69
00:07:34,060 --> 00:07:36,350
خنتِ ثِقتَها

70
00:07:38,150 --> 00:07:39,250
...فضلاً عن ذلك

71
00:07:40,160 --> 00:07:43,850
بعد رحيل الأمير تولي، لن تصمد عائلته طويلاً

72
00:07:45,360 --> 00:07:48,650
من الآن فصاعداً، قد تتركّز القوّة
في قبضة الخاقان العظيم

73
00:07:49,470 --> 00:07:54,110
إن كان كذلك، فأرغب في خدمة عائلة أوقطاي

74
00:07:55,800 --> 00:07:59,500
أخبريني يا فاطمة. هلّا تحدّثتِ عنّي بكلام طيّب؟

75
00:08:00,970 --> 00:08:02,060
أتسمعينني؟

76
00:08:11,950 --> 00:08:16,000
ضحّى تولي بحياته لأجل الخاقان العظيم

77
00:08:17,530 --> 00:08:22,650
.قد تكون هذه هي الحقيقة
أو قد لا تكون

78
00:08:23,700 --> 00:08:30,250
الأكيد هو أنّ اختلال توازُن القوى الّذي
كان قائماً في الإمبراطوريّة

79
00:08:30,670 --> 00:08:35,200
سيتغيّر بشكل بليغ عقب وفاة تولي

80
00:08:38,580 --> 00:08:44,560
،والآن، سيُعلن الجارغوتشي، شيغي قوتوقو
عن غنائم الحرب

81
00:08:46,510 --> 00:08:49,760
هؤلاء هم الرّجال الّذين أحضرناهم
من عاصمة جين

82
00:08:50,800 --> 00:08:53,880
عُلماء وأطبّاء ومُهندسون

83
00:08:53,880 --> 00:08:56,900
سيُساهمون حتماً في تطوير دولتنا

84
00:08:58,680 --> 00:09:00,560
إذاً هذه هي الهديّة الّتي تكلّمت عنها؟

85
00:09:07,840 --> 00:09:09,600
هل استدعيتِني؟

86
00:09:11,320 --> 00:09:13,200
سمعتُ ذلك من الجارغوتشي

87
00:09:13,670 --> 00:09:18,040
مُخالفة القانون بالجِدال للحصول على أراضٍ
أكثر وخدَم أكثر لابنك

88
00:09:21,120 --> 00:09:24,630
حقّقَ ابني إنجازات عظيمة أثناء
!حملة جين العسكريّة

89
00:09:24,860 --> 00:09:27,250
أنت تعي ذلك، صحيح؟

90
00:09:27,250 --> 00:09:28,460
!أمّي

91
00:09:28,460 --> 00:09:29,620
!غودن

92
00:09:29,620 --> 00:09:31,630
المعذرة. لا تولِ اهتماماً لأمّي

93
00:09:31,630 --> 00:09:33,430
!غودن! اتركني حالاً

94
00:09:33,430 --> 00:09:35,630
!هذا يصبّ في صالحك

95
00:09:33,430 --> 00:09:36,490
!أمّي! هدِّئي من روعك

96
00:09:38,630 --> 00:09:41,490
...فـ-في الواقع

97
00:09:41,490 --> 00:09:43,020
...أمنيتكِ تلك

98
00:09:43,460 --> 00:09:45,580
ستُحقَّق عمّا قريب

99
00:10:03,750 --> 00:10:05,010
انطلقي

100
00:10:12,710 --> 00:10:13,860
فاطمة

101
00:10:15,430 --> 00:10:16,890
الإمبراطورة بُراقجين

102
00:10:19,780 --> 00:10:21,350
لماذا أتيتِ إلى هنا؟

103
00:10:21,350 --> 00:10:26,070
جهودكِ قد أسهمتْ في تعافي الخاقان العظيم

104
00:10:26,070 --> 00:10:28,260
أتيتُ لأعبّر عن امتناني لكِ

105
00:10:29,900 --> 00:10:31,960
هذا لكِ

106
00:10:32,960 --> 00:10:33,780
ماذا؟

107
00:10:35,860 --> 00:10:37,480
العناصر؟

108
00:10:37,950 --> 00:10:41,580
ذكرتُ لسرقويتي بأنّكِ كنتِ
،بحثين عن هذا الكتاب

109
00:10:41,580 --> 00:10:43,960
ووافقتْ بكلّ سرور على التخلِّي عنه

110
00:10:44,840 --> 00:10:47,080
...كنتُ أبحث عنه

111
00:10:49,250 --> 00:10:50,620
من أين علمتِ ذلك؟

112
00:10:52,250 --> 00:10:54,420
هل أخبرتكِ مولاتي توريكاني؟

113
00:10:54,420 --> 00:10:55,630
فاطمة

114
00:10:56,990 --> 00:10:59,650
انسي أمر تلك المرأة

115
00:11:01,300 --> 00:11:04,620
سأفكِّك خيمتها مع نهاية اليوم

116
00:11:04,980 --> 00:11:07,820
يمكنكِ الانتقال إلى جوار خيمتي

117
00:11:09,270 --> 00:11:10,860
الإمبراطورة بُراقجين

118
00:11:10,860 --> 00:11:14,100
تعالي معي. ثمّة شيء أريد أن أُريكِ إيّاه

119
00:11:26,240 --> 00:11:30,990
هل تنازلت الأميرةُ سرقويتي عن كُلّ هذا لكِ؟

120
00:11:30,990 --> 00:11:33,840
بالفعل. بجودِها وكرمها

121
00:11:34,680 --> 00:11:37,430
...لـ-لكنّها قالت

122
00:11:37,760 --> 00:11:39,260
أريد معرفة المزيد

123
00:11:39,800 --> 00:11:44,310
عن الأراضي الّتي تقع ضمن
نِطاق سيطرة المغول

124
00:11:45,440 --> 00:11:48,610
كان ما حدث لتولي مأساويّاً

125
00:11:49,060 --> 00:11:50,360
...لكن

126
00:11:51,350 --> 00:11:54,070
أعتقد بأنّها كانت إشارة من السّماوات

127
00:11:55,440 --> 00:12:01,280
يمتلك الخاقان العظيم الحكمة لقيادة
إمبراطوريّتنا نحو عصر جديد

128
00:12:01,600 --> 00:12:06,120
رغم أنّ تولي كان ليُشكّل عقبة
في طريق تحقيق ذلك

129
00:12:07,140 --> 00:12:09,310
أنتِ من قال ذلك بنفسكِ

130
00:12:09,760 --> 00:12:14,340
كنتِ تخشين أن تُهيمن عائلةُ تولي
على الأمور من حيث النّفوذ والذّكاء

131
00:12:16,800 --> 00:12:21,470
سأنتهز هذه الفُرصة لتصحيح
اختلال التّوازن هذا

132
00:12:22,710 --> 00:12:23,840
فاطمة

133
00:12:24,200 --> 00:12:28,800
لن تكون القوّة هي ما يرسم مُستقبل هذه
الإمبراطوريّة. بل إنّها الحكمة

134
00:12:29,230 --> 00:12:33,570
ألا ترغبين في صقل حكمتكِ لأقصى حدّ؟

135
00:12:34,020 --> 00:12:37,030
هل هناك ما هو أكثر متعة من ذلك؟

136
00:13:04,620 --> 00:13:09,890
لو بقيتُ في طوس، لما رأيتُ
مثل هذا المشهد المهيب

137
00:13:09,890 --> 00:13:13,190
أنا... أنوي خوض رحلة

138
00:13:13,460 --> 00:13:17,600
وأحتكّ بحكمة مع كافّة المصادر
بحثاً عن الحقيقة

139
00:13:22,220 --> 00:13:23,950
مولايّ مُحمّد

140
00:13:24,470 --> 00:13:28,160
أودّ أن أخبرك بأنّني كنتُ مُحبَطة
جدّاً في ذلك الوقت

141
00:13:29,370 --> 00:13:31,080
كانت تأكلني الغيرة

142
00:13:31,600 --> 00:13:35,340
تستطيع الرّحيل بحرّية إلى أيّ
مكان يقودك قلبُك إليه

143
00:13:37,200 --> 00:13:43,220
علمتُ أكثر بكثير ممّا علمتَه خلال
الفترة القصيرة الّتي كنتَ حيّاً فيها

144
00:13:44,390 --> 00:13:46,640
...ربّما حان الوقت

145
00:13:47,880 --> 00:13:51,120
لأمضي قُدماً بحياتي

146
00:14:05,630 --> 00:14:07,380
ماذا؟ ماذا كان ذلك؟

147
00:14:07,380 --> 00:14:08,910
هل كلّ شيء على ما يُرام؟

148
00:14:08,910 --> 00:14:11,500
أنا آسف جدّاً. انقلبَ هذا العمود

149
00:14:12,380 --> 00:14:14,960
ظننتُ بأنّه صوت البرق

150
00:14:20,550 --> 00:14:22,120
جميعهم مُرتعِدون

151
00:14:25,700 --> 00:14:28,780
في هذه اللّحظة من الزّمن، لا يعلم
،المرء أين هو

152
00:14:28,780 --> 00:14:30,470
،وما الّذي يجري

153
00:14:30,470 --> 00:14:32,630
أو ما الّذي سيحلّ به

154
00:14:32,630 --> 00:14:34,360
حياتنا مليئة بالمجهول

155
00:14:38,140 --> 00:14:42,240
كيف أجرؤ على اعتبار نفسي أذكى
من مولايّ مُحمّد؟

156
00:14:43,060 --> 00:14:45,450
أين مكاني في هذا العالم؟

157
00:14:47,480 --> 00:14:49,640
عنصر إقليدس

158
00:14:50,750 --> 00:14:53,490
العناصر"، وا الّذي حاولتْ مولاتي حمايته"

159
00:14:54,570 --> 00:14:58,890
العناصر"، والّذي كان سبب فقدان"
مولاتي لحياتها

160
00:14:59,960 --> 00:15:03,490
الرّجل الّذي قتلَ مولاتي قد رحل

161
00:15:04,660 --> 00:15:10,970
كان هدفي في الحياة هو استعادة
هذا الكِتاب كأمَة لمولاتي

162
00:15:12,710 --> 00:15:14,380
مولاتي فاطمة

163
00:15:14,700 --> 00:15:17,810
نجحتُ في فعل ما خرجتُ لأجله

164
00:15:20,350 --> 00:15:21,450
أمَة؟

165
00:15:25,660 --> 00:15:26,990
الإمبراطورة بُراقجين

166
00:15:28,320 --> 00:15:32,620
هل أخبروكِ بسبب بحثي عن هذا الكِتاب؟

167
00:15:34,510 --> 00:15:38,060
هذا الكتاب هو بحثٌ حول
علم الهندسة، صحيح؟

168
00:15:38,060 --> 00:15:41,800
سمعتُ بأنّكِ كنتِ مهتمّة بالموضوع
لفترة طويلة

169
00:15:42,070 --> 00:15:46,000
مُتشبِّهة بأبيكِ الّذي كان عالِماً
على ما أعتقد؟

170
00:15:52,940 --> 00:15:55,760
أجل. كما تقولين فحسب

171
00:16:07,820 --> 00:16:09,280
والآن أعرف شيئاً واحداً

172
00:16:10,580 --> 00:16:14,840
سمعت الإمبراطورةُ بُراقجين عن هذا
الكِتاب من مولاتي توريكاني

173
00:16:15,380 --> 00:16:18,040
،لا أستطيع تخمين ما قد حدث

174
00:16:18,720 --> 00:16:20,420
...لكن ما يمكنني قوله بيقين هو

175
00:16:21,860 --> 00:16:24,840
اسمي سيتارا. أنا أمَة

176
00:16:25,590 --> 00:16:30,910
لهذا اخترتُ الحِفاظ على ماضيّي كميركت
سرّاً عن الجميع

177
00:16:31,620 --> 00:16:33,560
من فضلكِ احتفظي بذلك سرّاً أيضاً

178
00:16:33,560 --> 00:16:36,640
...مولاتي توريكاني لم تفشِ

179
00:16:37,300 --> 00:16:39,270
،الأسرار الّتي تشاركناها

180
00:16:39,480 --> 00:16:41,300
ولا الغضب الّذي ضمرناه

181
00:16:59,120 --> 00:17:00,600
عملت بجدّ اليوم

182
00:17:34,250 --> 00:17:35,140
شيرا

183
00:17:36,030 --> 00:17:37,490
فاطمة؟

184
00:17:37,490 --> 00:17:40,020
قلتُ لكِ ألّا تعودي

185
00:17:40,020 --> 00:17:41,610
أتيتُ لأسألك أمراً

186
00:17:42,040 --> 00:17:46,510
ساعدني، وسأعرّفك على الخاقان
العظيم أو الخاتون العظيمة

187
00:17:46,950 --> 00:17:48,610
اسأليني أيّ شيء

188
00:17:49,240 --> 00:17:52,670
قلتَ بأنّ عائلة تولي لن تصمد طويلاً

189
00:17:53,000 --> 00:17:54,020
ما السّبب؟

190
00:17:54,020 --> 00:17:56,860
،فكّري في الأمر. برحيل الأمير تولي

191
00:17:56,860 --> 00:17:59,830
لا أعتقد بأنّ الأميرة سرقويتي والآخرين
الّذين نجوا من بعده

192
00:17:59,830 --> 00:18:01,680
سيُحافظون على نفوذهم

193
00:18:02,360 --> 00:18:04,820
...في الواقع، قبل مدّة

194
00:18:06,330 --> 00:18:09,680
أخذوا كثيراً من كُتبكِ يا أمّي

195
00:18:10,840 --> 00:18:13,740
أخبريني، هل أنتِ راضية عن عدم
قول شيء حقّاً؟

196
00:18:14,450 --> 00:18:16,770
...ذلك الكتاب، العناصر

197
00:18:17,150 --> 00:18:21,200
ألم يحضر أبي ذلك الكِتاب قاطعاً
كُلّ المسافة من بلاد فارس لأجلكِ؟

198
00:18:22,180 --> 00:18:23,870
لا مُشكلة

199
00:18:25,150 --> 00:18:28,020
لم أعُد بحاجته بعد الآن

200
00:18:28,700 --> 00:18:31,870
تستطيع الخاتون العظيمة أخذ ما تشاء

201
00:18:32,380 --> 00:18:37,210
لستُ مُهتمّاً باتّباع شخص فقد الأمل كُلّه

202
00:18:38,910 --> 00:18:39,770
ماذا؟

203
00:18:39,770 --> 00:18:42,140
كانت هي منذ البداية

204
00:18:42,490 --> 00:18:45,760
كنتُ تحت رحمة مكائد الإمبراطورة بُراقجين

205
00:18:46,660 --> 00:18:47,980
!يا للإحباط

206
00:18:48,990 --> 00:18:52,710
،ظننتُ نفسي أذكى من الجميع حولي

207
00:18:52,710 --> 00:18:55,160
وتحدّيتُها دون أن أعي ذلك إطلاقاً

208
00:19:02,090 --> 00:19:05,920
لكن الآن ليس وقت الإحباط

209
00:19:09,090 --> 00:19:11,050
أتوسّل إليك يا شيرا

210
00:19:11,350 --> 00:19:12,620
ساعدني

211
00:19:12,960 --> 00:19:15,110
ثمّة شخص أريد إنقاذه الآن

212
00:19:15,110 --> 00:19:15,920
!تشو

213
00:19:16,280 --> 00:19:19,640
!مـ-مـ-مهلاً! لا تتركيني وترحلي

214
00:19:21,520 --> 00:19:22,360
!تشو

215
00:20:15,860 --> 00:20:17,000
سيّد قاداق

216
00:20:18,090 --> 00:20:19,450
!فاطمة

217
00:20:19,450 --> 00:20:20,480
كيف وجدتِني؟

218
00:20:20,480 --> 00:20:21,660
تفضّل

219
00:20:21,660 --> 00:20:23,690
أليس هذا مِرصَنك؟

220
00:20:27,080 --> 00:20:28,350
!سيّد قاداق

221
00:20:28,350 --> 00:20:31,740
أين مولاتي توريكاني؟ أخبرني
!بأنّها بأمان أرجوك

222
00:20:35,030 --> 00:20:39,770
أنا أفعل المُستحيل حاليّاً لإنقاذ
مولاتي توريكاني

223
00:20:39,770 --> 00:20:41,910
بأوامر من سيّدي

224
00:20:41,910 --> 00:20:43,120
سيّدك؟

225
00:20:43,120 --> 00:20:44,780
أليست هي مولاتي توريكاني؟

226
00:20:44,780 --> 00:20:46,890
أخبرتُكِ مراراً بأنّها ليست كذلك

227
00:20:49,840 --> 00:20:52,620
إنّها قصّة طويلة. تعالا معي

228
00:20:59,020 --> 00:21:01,490
سموّ الأمير غويوك. سأدخل

229
00:21:02,910 --> 00:21:03,790
ماذا؟

230
00:21:04,440 --> 00:21:05,900
لا يوجد أحدٌ في الدّاخل

231
00:21:06,460 --> 00:21:09,830
هذا أنا يا سموّ الأمير غويوك. قاداق

232
00:21:14,870 --> 00:21:16,090
قاداق؟

233
00:21:17,210 --> 00:21:19,880
هذا أنت فقط؟

234
00:21:19,880 --> 00:21:21,680
—ظننتُ بأنّ غريباً قد

235
00:21:23,070 --> 00:21:24,220
—مـ-مرحباً

236
00:21:27,450 --> 00:21:29,050
!قاداق! قاداق

237
00:21:29,050 --> 00:21:31,490
!من هي؟ اطردها

238
00:21:31,490 --> 00:21:34,820
الأمير غويوك مُعرّض لتقلُّبات في مزاجه

239
00:21:34,820 --> 00:21:36,490
يبدو أنّ اليوم ليس يومكما

240
00:21:36,950 --> 00:21:37,670
اخرجا

241
00:21:37,670 --> 00:21:38,620
ماذا؟

242
00:21:38,620 --> 00:21:40,530
مهلاً، هذا غير مقبول

243
00:21:40,820 --> 00:21:43,260
بالفعل. ما معنى هذا؟

244
00:21:43,260 --> 00:21:44,890
—كما قلتُ

245
00:21:44,040 --> 00:21:46,640
!قاداق

246
00:21:46,640 --> 00:21:47,940
!أتوسّل إليك

247
00:21:47,940 --> 00:21:51,500
لا أعرف من يكون، لكن تحتاج
—مولاتي توريكاني مُساعدته

248
00:21:51,500 --> 00:21:53,540
!هذا هو الابن الأوّل للسيّدة توريكاني

249
00:21:59,210 --> 00:22:00,650
...سموّ الأمير غويوك

250
00:22:01,280 --> 00:22:04,650
هو الابن الأوّل لخاقان العظيم والسّيّدة توريكاني

251
00:22:06,510 --> 00:22:07,470
ماذا؟

252
00:23:37,980 --> 00:23:43,250
حجر رديء

253
00:23:38,420 --> 00:23:41,140
"الحلقة القادمة: "حجر رديء