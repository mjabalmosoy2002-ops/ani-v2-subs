1
00:00:09,070 --> 00:00:12,530
أنتِ من سيُعلّمني هذا الكتاب، أليس كذلك؟

2
00:00:25,890 --> 00:00:28,590
جادوغار

3
00:01:47,220 --> 00:01:48,800
مُبهر

4
00:01:48,800 --> 00:01:54,130
"عثرَ تولي على نسخة من "العناصر
لأجلي فحسب بالفعل

5
00:01:49,310 --> 00:01:53,770
أوتشيغين

6
00:01:55,780 --> 00:01:57,280
ما اسمكِ؟

7
00:01:59,540 --> 00:02:02,000
فاطمة هو اسمي

8
00:02:02,000 --> 00:02:05,140
سأساعدكِ في الدّراسة، سموّكِ

9
00:02:05,660 --> 00:02:07,100
أتطلّع إلى ذلك

10
00:02:07,100 --> 00:02:08,190
...لكن

11
00:02:09,200 --> 00:02:12,930
ما الّذي تريده سموّكِ من الكتاب؟

12
00:02:12,930 --> 00:02:15,240
إنّه لا يمتلك قيمةً كبيرة

13
00:02:15,240 --> 00:02:16,090
ماذا؟

14
00:02:16,090 --> 00:02:18,280
"النّقطة لا تملك أبعاد"

15
00:02:18,500 --> 00:02:21,230
"الخطّ هو طول بلا عرض"

16
00:02:21,630 --> 00:02:23,600
يُعبّر عمّا هو واضح فقط

17
00:02:23,600 --> 00:02:25,540
ليس ذا فائدة كبيرة

18
00:02:27,470 --> 00:02:28,450
حقّاً؟

19
00:02:29,440 --> 00:02:32,960
لا أستطيع الجزم حول سبب رغبتها
،في هذا الكتاب من الأساس

20
00:02:32,970 --> 00:02:38,720
لكن لم يبدُ ذلك الأمير تولي أنّه يعي قيمتَه

21
00:02:39,280 --> 00:02:42,890
قد تتخلّى عن الكِتاب إذا فقدت الاهتمام به

22
00:02:43,220 --> 00:02:44,870
التّعبير عمّا هو واضح

23
00:02:45,430 --> 00:02:47,350
أجل، هذا صحيح

24
00:02:47,650 --> 00:02:49,620
بالنّسبة لكم على الأقلّ

25
00:02:49,620 --> 00:02:50,350
ماذا؟

26
00:02:50,350 --> 00:02:54,980
لكن بالنّسبة لنا، هذا الكتاب يُمثّل البداية

27
00:02:54,980 --> 00:02:59,320
بداية رحلتنا لاكتساب المعرفة
الغربيّة غير الموجودة في البادية

28
00:02:59,540 --> 00:03:00,490
ماذا؟

29
00:03:01,160 --> 00:03:04,330
تولي، زوجي، هو الأوتشيغين

30
00:03:05,080 --> 00:03:08,260
إنّه أمين وحافِظ الدّيار، والمُكلّف
بمُراقبة نارها{?}

31
00:03:08,750 --> 00:03:12,920
حتّى بعد مُغادرة أخوته الأكبر
،وحصولهم على مرعاهم

32
00:03:13,240 --> 00:03:15,880
بقي الابن الأصغر في المنزل

33
00:03:15,880 --> 00:03:19,130
لحماية ثروة العائلة وخِلافتها في نهاية المطاف

34
00:03:19,630 --> 00:03:23,340
بصفته الأوتشيغين، سيُصبح تولي
الإمبراطور يوماً ما

35
00:03:23,980 --> 00:03:25,050
...لكن في الواقع

36
00:03:25,520 --> 00:03:28,270
لا يكون ذكاؤه لامعاً أحياناً، أليس كذلك؟

37
00:03:28,780 --> 00:03:32,480
وليس تولي فقط. نفس الكلام يمكن
أن ينطبق على الكثير من شعبنا

38
00:03:32,480 --> 00:03:35,270
لا يفقهون شيئاً سوى الحياة هنا في البادية

39
00:03:36,760 --> 00:03:39,360
مهما كانت واسعة، يبقى العالم أوسع

40
00:03:40,090 --> 00:03:41,570
أتمنّى أن أتعلّم أكثر

41
00:03:42,140 --> 00:03:46,210
عن الأراضي الكثيرة الّتي تقع
ضمن قبضة المغول

42
00:03:46,960 --> 00:03:52,200
شعبكم تنبّأ بحركةِ النُّجوم منذ القِدَم، صحيح؟

43
00:03:52,600 --> 00:03:56,170
كم من الغريب أن تتمكّنوا من معرفة
حجم الأرض

44
00:03:57,630 --> 00:04:00,930
سافر هذا الشّخص إلى أطراف الأرض؟

45
00:04:00,930 --> 00:04:04,050
بالطّبع لا. استخدمَ الهندسة

46
00:04:04,050 --> 00:04:06,680
ما الّذي يجعل "الأشياء الواضحة" واضحة؟

47
00:04:06,960 --> 00:04:11,740
بجمع الأمثلة واحداً تِلو الآخر نُثبت
المبادئ الكونيّة

48
00:04:13,010 --> 00:04:16,610
كسب المعرفة لنقلها إلى أجيال مُستقبليّة

49
00:04:17,420 --> 00:04:21,860
هذا هو دوري بصِفتي الّتي
ستُصبح إمبراطورة يوماً ما

50
00:04:27,360 --> 00:04:32,250
...لماذا هي

51
00:04:33,730 --> 00:04:36,460
لماذا تُثير غضبي؟

52
00:04:37,060 --> 00:04:41,660
أنتِ لا تعرفين شيئاً عن كيفيّة وصول
هذا الكتاب إلى حيازتك؟

53
00:04:42,010 --> 00:04:45,100
لا يمكنكِ تخيُّل البؤس الّذي يجب علينا تحمّله

54
00:04:45,100 --> 00:04:50,140
عندما نشكر أولئك الّذين جرّدونا من كلّ شيء
مُقابل الأعمال الخيريّة الّتي تُقدّمونها الآن؟

55
00:04:50,570 --> 00:04:55,060
تقصدين القول بأنّكِ لا تعرفين شيئاً
عن كيفيّة شعوري بينما أجلس هنا؟

56
00:04:55,700 --> 00:04:58,520
ما الخطب؟ هل أنتِ مُصابة بوعكة؟

57
00:05:00,190 --> 00:05:02,990
لا. أنا بخير

58
00:05:04,610 --> 00:05:09,300
من دواعي سروري أن أخدم
سموّكِ. سأبذل قصارى جهدي

59
00:05:10,040 --> 00:05:13,000
.أنا محظوظة لحصولي على مُساعدتك
شكراً لكِ سلفاً

60
00:05:13,340 --> 00:05:16,000
لا بُدّ أنّكِ مُرهَقة. يمكنكِ الانصراف حاليّاً

61
00:05:17,270 --> 00:05:18,960
أستأذن

62
00:05:25,820 --> 00:05:29,280
،حكمتكِ هي شيء نحن بأمسّ الحاجة له

63
00:05:29,600 --> 00:05:34,360
،أشعر بالعار لأنّني تردّدتُ آنذاك
ولو لوهلة

64
00:05:36,350 --> 00:05:37,520
...يجب

65
00:05:41,110 --> 00:05:44,940
أنا وحدي يجب ألّا أنسى هذا الغضب

66
00:05:45,500 --> 00:05:46,910
...لن أرضخ أبداً

67
00:05:47,530 --> 00:05:48,740
!لتلك المرأة

68
00:06:10,900 --> 00:06:12,520
أهلاً بعودتك يا فاطمة

69
00:06:12,520 --> 00:06:16,150
مهما شكرتُك لا أوفيك حقّكِ بخروجكِ
بكلّ جرأة لمُواجهة هذه العاصفة الرّمليّة

70
00:06:16,840 --> 00:06:18,270
لا شكر على واجب

71
00:06:18,720 --> 00:06:23,210
هنا في منغوليا، يأتي الرّبيع
حالما تتوقّف العواصفُ الرّمليّة

72
00:06:23,210 --> 00:06:25,800
كم أشتاق للرّبيع الفارسيّ

73
00:06:26,540 --> 00:06:29,820
لم تتأقلم أُمّي مع الحياة هنا بعد

74
00:06:33,340 --> 00:06:34,320
فاطمة

75
00:06:35,300 --> 00:06:37,810
تطلب منكِ الأميرة سرقويتي الحضور إلى خيمتها

76
00:06:37,810 --> 00:06:40,100
"تريدكِ أن تبدئي في تعليمها "العناصر

77
00:06:41,850 --> 00:06:43,590
على الرّحب

78
00:07:01,230 --> 00:07:03,610
فاطمة! ماذا حلّ بوجهكِ؟

79
00:07:04,290 --> 00:07:07,120
هناك كثير من الحيوانات في منغوليا

80
00:07:07,500 --> 00:07:09,900
إنّهم مُزعجون

81
00:07:09,900 --> 00:07:11,600
معكِ حقّ

82
00:07:12,030 --> 00:07:14,990
لكنّهم يُصبحون جذّابين جدّاً
حالما تتعرّفين عليهم أكثر

83
00:07:16,420 --> 00:07:17,950
أحقّاً ذلك؟

84
00:07:41,070 --> 00:07:43,250
لحظة فقط

85
00:07:43,250 --> 00:07:45,860
جاء شتاؤنا الثّاني بالفعل

86
00:07:46,260 --> 00:07:48,970
تحسّنتْ صحّتُكِ مؤخّراً يا أمّي

87
00:07:48,970 --> 00:07:52,060
تأقلمتُ أخيراً مع الحياة هنا في منغوليا

88
00:07:52,680 --> 00:07:55,530
هذا الطّقس البارد هو الشّيء الوحيد
الّذي لا أتأقلم معه

89
00:08:04,620 --> 00:08:05,750
!تشو، تشو

90
00:08:09,230 --> 00:08:15,200
الصّيف، 1224 ميلادي

91
00:08:11,840 --> 00:08:16,320
بعد ثلاث سنوات من تدريس
...سيتارا لسرقويتي

92
00:08:18,170 --> 00:08:23,630
هزمَ جيشُ المغول شاه خوارزم، قوّة
كُبرى في آسيا الوسطى

93
00:08:23,630 --> 00:08:26,960
وعاد مُنتصراً إلى مُعسكره الرّئيسيّ في البادية

94
00:08:28,390 --> 00:08:31,900
للتّرحيب بجيش المغول، سرقويتي وحاشيتها

95
00:08:31,900 --> 00:08:36,740
طوس

96
00:08:32,180 --> 00:08:36,740
سافروا نحو جنوب غرب جبال آلتاي
حيث يقع حوض نهر إميل

97
00:08:36,740 --> 00:08:40,240
فأقاموا حفلة صيد وولائم بمُناسبة نصرهم

98
00:08:41,570 --> 00:08:43,290
!أبي

99
00:08:43,970 --> 00:08:45,740
!هولاكو! قوبلاي

100
00:08:45,740 --> 00:08:47,860
قتلتُ غزالاً

101
00:08:47,860 --> 00:08:49,750
وأنا قتلتُ أرنباً برّياً

102
00:08:50,040 --> 00:08:52,140
تُشبهان أباكما حقّاً

103
00:08:52,140 --> 00:08:53,850
!أبي

104
00:08:53,850 --> 00:08:56,000
كانت أوّل تجربة لي في الصّيد

105
00:08:56,000 --> 00:08:57,620
ما رأيك؟ ألستُ مُذهلاً؟

106
00:08:57,620 --> 00:08:59,100
أجل، هذا مُذهل

107
00:09:01,200 --> 00:09:03,410
سموّ الأمير هولاكو. سموّ الأمير قوبلاي

108
00:09:04,270 --> 00:09:07,690
استعدّا رجاء. سيحضر خان
العظيم إلى هنا قريباً

109
00:09:07,690 --> 00:09:10,060
!فاطمة! انظري إلى هذا

110
00:09:10,060 --> 00:09:13,280
يا له من غزال مُدهش

111
00:09:13,280 --> 00:09:17,410
واصطياد أرنب برّي فطِن ليس إنجازاً
هيّناً أيضاً يا سموّ الأمير قوبلاي

112
00:09:19,030 --> 00:09:21,540
كُلّ تمريني بالقوس قد أتى أُكُلَه

113
00:09:21,820 --> 00:09:23,510
من هي الفتاة؟

114
00:09:23,510 --> 00:09:27,690
"إنّها المُدرِّسة الّتي تقرأ "العناصر
الّذي أحضرتَه لي

115
00:09:27,690 --> 00:09:30,000
ابنة العالِمة؟

116
00:09:30,570 --> 00:09:32,670
كيف حالها؟ هل تؤدّي واجباتها جيّداً؟

117
00:09:32,670 --> 00:09:36,720
إنّها مُجتهدة في عملها. ناهيك
عن أنّها ذكيّة ولطيفة

118
00:09:37,340 --> 00:09:41,630
لا يبرز شبابها إلّا عندما تبتسم
بصورة أخّاذة فاتنة

119
00:09:42,360 --> 00:09:45,890
لم تحضر لي "العناصر" فحسب، بل
أحضرت مُعلّمةً ماهرة أيضاً

120
00:09:45,890 --> 00:09:47,060
بكلّ تأكيد

121
00:09:47,320 --> 00:09:48,960
ألا أبدو رائعاً؟

122
00:09:49,990 --> 00:09:51,150
قوّة لا يُستهان بها

123
00:09:51,150 --> 00:09:57,080
من العرف أن يمسح المرءُ دهنَ الحيوان
بأصابعه بعد أوّل صيد لطفل

124
00:09:57,080 --> 00:09:59,570
سيؤدّي خان العظيم بنفسه هذا الواجب

125
00:09:59,570 --> 00:10:01,600
وصلَ خان العظيم

126
00:10:01,600 --> 00:10:03,210
أخي قوبلاي، هيّا بنا

127
00:10:03,210 --> 00:10:04,040
!حسناً

128
00:10:14,510 --> 00:10:17,340
إمبراطور المغول، جنكيز خان

129
00:10:18,800 --> 00:10:22,260
كان هو من شيّدَ هذه الإمبراطوريّة الواسعة

130
00:10:22,600 --> 00:10:27,180
خلال فترة ثلاث سنوات، الأقدار المكتوبة
...في نجوم الحاضرين هنا

131
00:10:27,910 --> 00:10:33,690
ستسير عجلاتها سريعاً بعد سقوط
النّجم المجيد، جنكيز خان

132
00:10:52,400 --> 00:10:56,460
الصّيف، 1227 ميلادي

133
00:11:00,880 --> 00:11:03,320
اطمئنّ يا خان العظيم

134
00:11:04,190 --> 00:11:07,910
سيكون مُستقبل المغول كما أردتَه تماماً

135
00:11:10,350 --> 00:11:11,440
أبي

136
00:11:35,290 --> 00:11:39,400
،الأمير الرّابع، تولي، بصفته الأخ الأصغر والأوتشيغين

137
00:11:39,400 --> 00:11:42,050
بموجب التّقليد المغولي وهو مبدأ
،وراثة الأصغر

138
00:11:42,050 --> 00:11:46,780
ورثَ مُعظم ثروة والده جنكيز خان الضّخمة

139
00:11:47,290 --> 00:11:48,930
،بالإضافة إلى الأراضي والثّروات

140
00:11:49,530 --> 00:11:55,830
تمكّنتْ عائلة تولي من السّيطرة على كامل
الجيش المغولي تقريباً

141
00:12:05,930 --> 00:12:07,080
!إنّه الأمير تولي

142
00:12:07,080 --> 00:12:07,830
!الأمير تولي

143
00:12:07,830 --> 00:12:08,820
!الأمير تولي

144
00:12:11,220 --> 00:12:17,420
عقب وفاة جنكيز خان، ترتّب على الإمبراطوريّة
اختيار حاكم جديد

145
00:12:18,290 --> 00:12:21,910
،لكن المجلس القبائليّ والمعروف بـ كورولتاي
حيث تجتمع العشيرة الإمبراطوريّة

146
00:12:21,910 --> 00:12:24,590
،والأُمراء المُنافسين لانتخاب إمبراطور جديد

147
00:12:24,950 --> 00:12:28,580
لم يُدعَ للانعقاد لعامين آخرين

148
00:12:29,480 --> 00:12:32,420
أثناء هذه الفترة الفاصلة، لم يقُد
،تولي الجيشَ فحسب

149
00:12:32,420 --> 00:12:35,410
إنّما أدار كافّة شؤون البلاد كوصيّ

150
00:12:36,960 --> 00:12:43,860
الخريف، 1229 ميلادي

151
00:12:41,970 --> 00:12:44,600
لا يبدو أنّه بصحّة جيّدة

152
00:12:44,960 --> 00:12:47,680
مع ذلك، ينبغي أن يكون أكله آمناً

153
00:12:47,680 --> 00:12:48,830
لنذبحه

154
00:13:03,550 --> 00:13:05,400
سيَفي هذا بالغرض

155
00:13:06,020 --> 00:13:08,430
استمرّوا في الذّبح الآن

156
00:13:08,430 --> 00:13:11,260
وليمة ضخمة كهذه هي مُناسبة نادرة

157
00:13:12,810 --> 00:13:13,890
خُذي هذه

158
00:13:14,240 --> 00:13:16,130
نظّفي هذه الأمعاء لأجلي

159
00:13:18,050 --> 00:13:21,190
بسم اللّه، واللّه أكبر

160
00:13:22,650 --> 00:13:23,610
فاطمة

161
00:13:25,960 --> 00:13:29,240
ألا ترتاحين للذّبح عن طريق تقطيع البطن؟

162
00:13:29,240 --> 00:13:31,620
أنا آسفة. إنّها عادةٌ لي

163
00:13:31,980 --> 00:13:36,540
سمعتُ بأنّ المُسلمين لا يأكلون سوى الحيوانات
الّتي تُذبَح من الحلق

164
00:13:36,540 --> 00:13:37,530
هذا صحيح

165
00:13:37,530 --> 00:13:40,960
لكن يُراق الدّم في كلّ مكان بهذه الطّريقة

166
00:13:40,960 --> 00:13:43,930
وأسوأ ما في ذلك هو أنّ استنزاف الدّم
يجعل اللّحم يفقد نكهته

167
00:13:43,930 --> 00:13:46,590
يا للهدر. الدّم هو ما يمنحه النّكهة

168
00:13:47,180 --> 00:13:50,800
،على أيّ حال، نحن نفعل الأمور بشكل مُختلف هنا
لذا جرّبي وتحمّلي الأمر فحسب

169
00:13:51,100 --> 00:13:54,020
لا تقلقي. أنا معتادة على هذا بالفعل

170
00:13:54,510 --> 00:13:57,110
عشتُ في منغوليا لثمان سنوات حتّى الآن

171
00:13:57,110 --> 00:13:59,670
وحتّى أنّني صرتُ أستمتع بأكل
لحم غير منزوع الدّماء

172
00:13:59,670 --> 00:14:00,480
حقّاً؟

173
00:14:01,310 --> 00:14:04,310
النّاس الّذين يُفضّلون مذاقَ اللّحم
منزوع الدّماء

174
00:14:04,310 --> 00:14:07,990
هم مثل أولئك الّذين يُفضّلون الحلويّات
الّتي ليست حُلوة جدّاً

175
00:14:07,990 --> 00:14:09,430
!تماماً

176
00:14:09,430 --> 00:14:11,660
حسناً، سأترك لكِ تلك الأمعاء

177
00:14:11,660 --> 00:14:13,470
شكراً يا فاطمة

178
00:14:13,470 --> 00:14:14,990
هذا من دواعي سروري

179
00:14:19,460 --> 00:14:24,130
هناك سببٌ وجيه وراء ذبح حيوان
،بقطع حلقه

180
00:14:24,770 --> 00:14:28,340
بسم اللّه، واللّه أكبر

181
00:14:31,280 --> 00:14:34,850
إنّها أقلّ طريقة إيلاماً بالنّسبة للحيوان

182
00:14:35,190 --> 00:14:40,740
اللّحم الّذي نُزِعَ دمُه يتمتّع بلون
أزهى ولا يفسد بسهولة

183
00:14:44,850 --> 00:14:49,400
رغم ذلك، ليس غريباً أن أعتاد على اللّحم
الدّاكن الّذي لم يُنزَع دمُه

184
00:14:50,620 --> 00:14:51,970
ثمان سنوات

185
00:14:51,970 --> 00:14:58,290
قضيتُ هنا في منغوليا الآن نفس عدد
السّنوات الّتي قضيتُها في طوس

186
00:14:59,390 --> 00:15:03,290
ومع ذلك لم أنجز شيئاً خلال
فترة إقامتي هنا

187
00:15:04,100 --> 00:15:05,250
...ذلك الكِتاب

188
00:15:06,120 --> 00:15:11,130
،كان ضمن مُتناول يدي طوال هذه السّنين
ومع ذلك لم أتمكّن من استعادته

189
00:15:12,110 --> 00:15:15,190
لا يسعني القول بأنّني استرجعتُ الكتاب

190
00:15:20,060 --> 00:15:22,260
يوجد شيء قاسٍ في هذا

191
00:15:27,960 --> 00:15:29,300
...هل يُعقل أنّه

192
00:15:30,260 --> 00:15:32,960
هيّا، خذ هذه كذلك

193
00:15:32,960 --> 00:15:33,650
حسناً

194
00:15:35,620 --> 00:15:38,700
ما زلتُ لا أُصدّق بأنّه هو

195
00:15:38,700 --> 00:15:39,710
أليس كذلك؟

196
00:15:39,710 --> 00:15:42,830
يكفي. اليوم هو يوم الاحتفال

197
00:15:44,610 --> 00:15:47,550
إنّه اليوم الّذي يتبوّأ فيه إمبراطورنا
الجديد العرش

198
00:16:18,850 --> 00:16:22,460
سمعتُ بأنّ الإمبراطور الجديد سيدعو
"نفسه "خاقان" بدلاً من "خان

199
00:16:22,800 --> 00:16:27,050
يعود بلقب قديم حتّى جنكيز خان لم يتّخذه؟

200
00:16:27,910 --> 00:16:29,880
ارتقى المغول للعظَمة

201
00:16:29,880 --> 00:16:33,880
نحن على وشك دخول عصر يكون فيه
المغول مركز العالم

202
00:16:52,910 --> 00:16:56,120
دخلَ الكورولتاي يومه الـ 41 الآن

203
00:16:56,120 --> 00:16:58,510
لا بُدّ أنّهم على خِلاف

204
00:16:58,510 --> 00:17:01,660
ما يحمل معنى هنا هو الرّقم 41

205
00:17:02,220 --> 00:17:06,080
بحسب نبوءة الكام، سيكون اليوم 41 مُناسباً

206
00:17:06,690 --> 00:17:11,920
أي أنّ الأمير سيُرشَّح بواسطة
...العشيرة ويتبوّأ العرش

207
00:17:12,960 --> 00:17:14,070
اليوم

208
00:17:16,820 --> 00:17:18,600
إلى الأمام، يا خاقان العظيم

209
00:17:18,660 --> 00:17:23,620
الأخ الأصغر
لجنكيز خان
تيموجي

210
00:17:18,660 --> 00:17:23,620
الأمير الثّاني
جغتاي

211
00:17:19,380 --> 00:17:20,310
نحو العرش

212
00:17:20,650 --> 00:17:23,810
أمسك بأيدينا، كي نُرشدك

213
00:17:50,360 --> 00:17:52,220
!يحيا الإمبراطور الجديد

214
00:17:52,680 --> 00:17:54,550
!يحيا الإمبراطور الجديد

215
00:17:55,550 --> 00:17:58,330
!يحيا الخاقان أوقطاي

216
00:17:59,310 --> 00:18:01,390
!مرحى

217
00:18:01,390 --> 00:18:03,720
!مرحى

218
00:18:04,210 --> 00:18:09,670
!مرحى! مرحى

219
00:18:11,230 --> 00:18:12,270
!خاقان العظيم

220
00:18:12,700 --> 00:18:15,930
اسمح لي أن أهنّئك من القلب
بتولّيك العرش

221
00:18:16,690 --> 00:18:18,990
ممتاز يا أخي أوقطاي

222
00:18:19,560 --> 00:18:21,200
شكراً يا تولي

223
00:18:43,220 --> 00:18:45,770
يوماً ما، قد يُولَد من نسلي أولئك

224
00:18:46,080 --> 00:18:48,650
الّذين إذا خلطتُهم مع العشب
،فلن يؤكَلوا بواسطة بقرة

225
00:18:49,220 --> 00:18:52,270
وإذا خلطتُهم مع الدّهون
فلن يُؤكَلوا بواسطة كلب

226
00:18:56,870 --> 00:19:01,670
،إذا ظهرَ أيلٌ من جانبهم وفأر من أمامهم

227
00:19:02,250 --> 00:19:03,770
سيدعونهما كليهما يهربان بلا شكّ

228
00:19:07,760 --> 00:19:10,730
والآن هذا هو سبب الاحتفال

229
00:19:10,730 --> 00:19:15,230
ستُنفّذ وصيّة أبي، وأنا حُرّ من واجبات الحُكم

230
00:19:17,640 --> 00:19:19,890
أحسنت صنعاً في ملء الفراغ طوال هذا الوقت

231
00:19:20,520 --> 00:19:21,800
سرقويتي

232
00:19:22,490 --> 00:19:26,260
أسفي الوحيد بأنّني لم أستطع
جعلك الإمبراطورة

233
00:19:26,520 --> 00:19:28,040
لا تقل ذلك

234
00:19:28,040 --> 00:19:32,230
،أقصد بأنّه عندما شاركنا أبي وصيّتَه
خطرت الفكرةُ على ذهني

235
00:19:32,850 --> 00:19:35,360
"لماذا؟ ألم ينبغي أن أكون أنا؟"

236
00:19:35,880 --> 00:19:37,690
لكن هكذا كان ردّه

237
00:19:38,490 --> 00:19:43,380
عندما تحاول أفعى مُتعدّدة الرّؤوس دخول"
،جحر لمُقاومة البرد

238
00:19:43,380 --> 00:19:47,120
تتنازع الرّؤوس فيما بينها، وتموت
"حتّى من دون أن تتمكّن من الدّخول

239
00:19:47,410 --> 00:19:52,370
بالمقابل، الثّعبان ذو الرّأس الواحد"
"يدخل الجحر وينجو

240
00:19:52,650 --> 00:19:56,340
أوقطاي، استخدم عقلك لتصبح"
"رأسنا جميعاً

241
00:19:59,240 --> 00:20:03,890
بالنّسبة للأوتشيغين، ظننتُ
بأنّني أكثر مَن فضّله

242
00:20:04,440 --> 00:20:07,560
لكن هذا ليس ما كان يُفكّر فيه أبي

243
00:20:08,250 --> 00:20:12,310
القوّة الّتي كان قد منحني إيّاها
لا تنحصر بي وحدي فقط

244
00:20:13,070 --> 00:20:17,320
روابطنا كأخوة هي الّتي ستجعل
المغول أقوياء فعلاً

245
00:20:18,110 --> 00:20:22,700
،هذا ما تمنّاه أبي، جنكيز خان

246
00:20:23,150 --> 00:20:25,240
وهي أُمنيتي العظمى كذلك

247
00:20:28,810 --> 00:20:30,740
...روابطكم الأخويّة

248
00:20:41,250 --> 00:20:45,800
،لا يهمّني مَن منهم يصبح الإمبراطور

249
00:20:46,480 --> 00:20:49,640
لكن تكسر التّقليد فقط لتدعه يخلفك؟

250
00:20:49,640 --> 00:20:53,270
هل الأمير أوقطاي أكثر كفاءة بكثير؟

251
00:20:56,530 --> 00:20:58,480
يبدو أنّ شيرا دعمَ الجواد الخطأ

252
00:21:01,270 --> 00:21:05,090
على أيّ حال، يمكن للكورولتاي
أن ينتهي الآن أخيراً

253
00:21:12,150 --> 00:21:14,810
هل هذا الحجر هو ما أعتقده أن يكون؟

254
00:21:15,130 --> 00:21:17,400
قرأتُ عنه في إحدى كُتُب السّيّدة

255
00:21:17,400 --> 00:21:19,340
إنّه قيّمٌ جدّاً

256
00:21:19,340 --> 00:21:20,300
فاطمة

257
00:21:22,720 --> 00:21:24,490
الأميرة سرقويتي

258
00:21:27,650 --> 00:21:29,450
ما-ما الأمر؟

259
00:21:31,300 --> 00:21:33,570
ثمّة أمر مُهمّ أودّ مُناقشته معك

260
00:21:33,570 --> 00:21:34,600
معي؟

261
00:21:34,880 --> 00:21:39,060
بعد اليوم، أريدكِ أن ترحلي عنّي

262
00:21:40,060 --> 00:21:40,640
ماذا؟

263
00:21:41,190 --> 00:21:42,960
ماذا؟ هل تُسرّحينني؟

264
00:21:42,960 --> 00:21:44,780
هل ارتكبتُ خطأ ما؟

265
00:21:44,780 --> 00:21:46,720
هذا ليس هو السّبب

266
00:21:46,720 --> 00:21:48,340
إ-إذاً، ما قد يكون؟

267
00:21:55,020 --> 00:21:58,000
...فاطمة. أريدكِ

268
00:22:00,230 --> 00:22:02,670
أن تعملي كجاسوسة لصالحي

269
00:23:38,060 --> 00:23:43,250
،تكشف الأفعى عن طبعها
ويُخفي الإنسان طبعه

270
00:23:38,070 --> 00:23:43,020
،الحلقة القادمة: "تكشف الأفعى عن طبعها
"ويُخفي الإنسان طبعه