1
00:00:06,390 --> 00:00:10,690
‫إني لمَحتُ مَعالمَ الأملِ والرجاءِ في شَخصِ الخاقانِ أوقطاي وحَضرتِكِ أنتِ

2
00:00:11,850 --> 00:00:17,450
‫فـتِلكَ الحِكمةُ والفِطنةُ التي تَتصفانِ بها تَجعلكما الأحقَّ بـسيادةِ هذا الوجودِ وحُكمِه

3
00:00:17,450 --> 00:00:19,830
‫أبـهذا السَّدادِ تَرينَ عزمَنا يا فاطمة؟

4
00:00:20,650 --> 00:00:21,950
‫دُونَ أدنَى رَيبٍ

5
00:00:22,540 --> 00:00:25,260
‫لا داعيَ لِـهذا الارتعادِ في جَنانكِ يا توراكينا

6
00:00:26,890 --> 00:00:29,640
‫ثمةَ حديثٌ هامٌّ أودُّ مُشاطرتهُ معكِ دونَ سِواكِ

7
00:00:43,730 --> 00:00:45,520
‫أزُفُّ إليكَ نبأً يَسرُّ الخاطرَ، أيُّها الخاقانُ الأعظم

8
00:00:45,850 --> 00:00:47,980
‫عبرَ الأميرُ تولوي نهرَ هان

9
00:00:48,250 --> 00:00:50,940
‫وفرَّت جحافلُ العدوِّ هاربينَ صَوبَ الجنوب

10
00:00:52,410 --> 00:00:54,570
‫لأنتَ مَفخرةُ فرسانِ السهوبِ يا تولوي

11
00:00:55,630 --> 00:01:00,090
‫إذن... فـلنَمضِ نحنُ كذلِك لِنعبرَ هذا النهرَ الممتدَّ أمامَنا

12
00:02:31,600 --> 00:02:33,750
‫أَعَبَرَ شقيقي الخاقانُ الأعظمُ النهرَ الأصفر إذن؟

13
00:02:33,750 --> 00:02:37,360
‫أجل، وجحافلُ مَددِ الخاقانِ الأعظمِ صَوبَ ديارِنا الساعة

14
00:02:37,360 --> 00:02:38,760
‫يتعينُ علينا التجمعُ والاتحادُ في جَمعٍ واحد

15
00:02:38,760 --> 00:02:40,420
‫أَتَعني الاتحادَ إذن؟

16
00:02:41,000 --> 00:02:42,180
‫أَفي خَلَدك بقعةٌ تفي بـهذا المأرَب؟

17
00:02:42,480 --> 00:02:44,660
‫أرى أن جبل سانفينغ بقعةٌ خليقةٌ بـسدِّ المَقام

18
00:02:52,570 --> 00:02:56,900
‫على مَسيرةِ مئةٍ وثلاثينَ كيلومترًا من "كايفنغ"، عاصمةِ سلالةِ جِين

19
00:02:57,390 --> 00:03:02,080
‫أَقامت جحافلُ تولوي مَعسكَرها عند سَفحِ جبلِ سانفينغ

20
00:03:02,450 --> 00:03:04,890
‫ترقُّبًا لِورودِ جحافلِ المَدد

21
00:03:08,540 --> 00:03:13,080
‫وتأهبت جحافلُ جِين المقابلةِ لِمناجزتِهم والاشتباك

22
00:03:15,790 --> 00:03:18,010
‫أأُبلغتُ بـأمرٍ يَقضي بـبدءِ الهجومِ دونَ تريّث؟

23
00:03:18,410 --> 00:03:20,510
‫إنَّ فرساني قد بَلغَ منهمُ النَّصَبُ مَبلغًا سحيقًا

24
00:03:20,510 --> 00:03:22,840
‫والعدوّ لَـيسَ بـأفضلِ حالاً من نَصَبِ جندِك

25
00:03:22,840 --> 00:03:26,030
‫فجحافلُهم الكبرى تمضي صَوبَ العاصمةِ "كايفنغ"

26
00:03:28,970 --> 00:03:30,940
‫فـدُكّوا معسكرَهم دونَ إبطاء

27
00:03:33,480 --> 00:03:35,150
‫مَا تَدبيرُكَ لهذا الموقف؟

28
00:03:35,150 --> 00:03:38,850
‫لا فِرارَ من إنفاذِ العَهد، ومن حُسنِ الطالِع أنَّ جحافِلَنا تفوقُ جَمعَهم كثرةً

29
00:03:39,300 --> 00:03:40,910
‫سنُحيطُ بهم إحاطةَ السِّوارِ بـالعِصام

30
00:03:45,700 --> 00:03:47,870
‫طوَّقوا مَعسكرَنا بالكامل، ولا مَنفذ

31
00:03:47,870 --> 00:03:51,250
‫تفوقُ جحافلُ غريمِنا مئةً وخمسينَ ألفَ فُرسان

32
00:03:51,250 --> 00:03:53,230
‫أحَقًّا؟ فمَا تَعدادُ فرسانِنا إذن؟

33
00:03:54,090 --> 00:03:55,690
‫يقصُرُ عن أربعينَ ألفًا بقليل

34
00:03:57,500 --> 00:03:58,380
‫هذا جُنون

35
00:03:58,380 --> 00:04:01,970
‫إن لم تَرِد جحافلُ مَددِ الخاقانِ الأعظمِ في الحين، فـمآلُنا الفناءُ لا محالة

36
00:04:02,290 --> 00:04:04,410
‫ستَرِدُ الجحافل، فلا مَجالَ لِدخولِ الفَزَعِ لِـجَنانِكم

37
00:04:08,690 --> 00:04:10,310
‫إذن... فـمَا تَدبيرُكَ لهذا الموقف؟

38
00:04:10,920 --> 00:04:13,700
‫أفلا نَستخيرُ "تنغري" في عاقبةِ مصيرِنا؟

39
00:04:15,620 --> 00:04:16,460
‫عفوًا؟

40
00:04:18,270 --> 00:04:21,190
‫حُشُّوا صفوفَ جندِنا، وابحثوا لي عن فُرسانٍ يُجيدون طقوسَ "الجادامِشي"

41
00:04:31,550 --> 00:04:34,870
‫أَوليسَت طقوسُ "الجادامِشي" تُستغلُّ لاستجلابِ العواصف؟

42
00:04:34,870 --> 00:04:37,620
‫فمَا مَرامُ الأميرِ تولوي بـاستدعاءِ نازلةٍ مِثلِها؟

43
00:05:27,660 --> 00:05:28,860
‫أبصِروا... إنَّهُ...

44
00:05:28,860 --> 00:05:29,950
‫انهمارُ الثَّلج

45
00:05:29,950 --> 00:05:31,260
‫وعَواصفُ الريحِ تشتدُّ عتوًّا

46
00:05:35,040 --> 00:05:39,110
‫يا "تَنغري"... أَمَنَحتَ جَمعَنا مَعونةَ السَّماءِ ورِضاها؟

47
00:05:41,450 --> 00:05:43,100
‫أَعِيروني أسماعَكم جميعًا

48
00:05:44,650 --> 00:05:46,600
‫شُقُّوا مَضايقَ الخنادقِ دونَ إبطاء

49
00:05:48,310 --> 00:05:51,620
‫وارتادوا لِلفرسانِ والخيولِ مَعاقلَ تحجبُهم قَبلَ أن تَحلَّ الكارثة

50
00:05:53,080 --> 00:05:53,550
‫أسرِعوا

51
00:05:53,550 --> 00:05:55,370
‫دَثِّروا جَسدَ الخيلِ بـالدُّثورِ الدافئة

52
00:05:55,370 --> 00:05:57,570
‫وليَلتحفِ الفرسانُ بكلِّ ما وَسِعَ جُهدَهم من غِطاء

53
00:06:00,880 --> 00:06:03,170
‫استعرتِ العاصفةُ ثلاثةَ أيامٍ بـلياليها دونَ هَوادة

54
00:06:05,830 --> 00:06:09,480
‫لتَقضِيَ بـأمرِ القدرِ على مَصيرِ الجَيشين

55
00:06:13,280 --> 00:06:15,120
‫وإبَّانَ إشراقِ اليومِ الرَّابع

56
00:06:15,590 --> 00:06:22,190
‫رَسفت جحافلُ جِين المئةِ والخمسينَ ألفًا في قَرِّ الشتاءِ ونَصَبِ المسيرِ تعجُّلاً لـلظَّفَر

57
00:06:34,180 --> 00:06:37,870
‫فَبَدوا عاجزينَ لا حِيلةَ لهم أمامَ زَحفِ جَحافِلِ المغول

58
00:06:40,960 --> 00:06:42,330
‫ارموا

59
00:06:51,620 --> 00:06:53,120
‫فأُبيدوا عن بكرة أبيهم

60
00:07:02,300 --> 00:07:05,770
‫ما من خيار أمامنا سوى الارتداد نحو الحاضرة

61
00:07:14,280 --> 00:07:16,290
‫بلغنا ديار المعركة في الوقتِ المناسب

62
00:07:24,210 --> 00:07:25,670
‫شقيقي

63
00:07:26,130 --> 00:07:26,970
‫تولوي

64
00:07:27,590 --> 00:07:29,090
‫أتيت بالظفر حقًا يا تولوي

65
00:07:29,090 --> 00:07:30,350
‫ما صنعت شيئًا يستحق الثناء

66
00:07:33,980 --> 00:07:37,180
‫بل إن "تنغري" هو من حَفَّ رايتك بالنصر يا شقيقي الخاقان

67
00:07:38,310 --> 00:07:41,680
‫لأنا الأوفر طالعًا بين الرجال إذ رُزقت شقيقًا وفيًا مثلك

68
00:07:47,860 --> 00:07:49,570
‫أأمرٌ يسترعي قلق جنانك أيها القائد؟

69
00:07:50,780 --> 00:07:52,910
‫لا شيء، إنما أسترجعُ غبارَ معاركِ الأمسِ في مخيلتي

70
00:07:53,250 --> 00:07:56,830
‫إبان قراعِ "جنكيز خان" لزعمِاء سائرِ القبائلِ في السهوب

71
00:07:56,830 --> 00:07:59,530
‫عمدَ الخصومُ يومَذاك إلى استحضارِ طقوسِ "الجادامِشي"

72
00:08:01,540 --> 00:08:06,800
‫بيدَ أنَّ النازِلةَ لم تَعصف بـحِمى "جنكيز خان"،
‫بل صَبّت بأسَها على معسكرِ الخصوم

73
00:08:13,120 --> 00:08:16,830
‫وحالَ تفرّسي في سِيماءِ الأميرِ تولوي، يَختلجُ في نفسي...

74
00:08:17,200 --> 00:08:20,720
‫أيها القائد... فـلنطوِ الحديثَ عند هذا الموضع

75
00:08:22,910 --> 00:08:24,190
‫اعذِر لغوي، واطوِ ما سَمِعت

76
00:08:25,610 --> 00:08:28,610
‫وما إن انقضى قَرُّ الشتاء، وأَذِنَ ربيعُ الفصولِ بالزوال...

77
00:08:29,860 --> 00:08:34,160
‫حتى قَفَلَ أوقطاي وتولوي راجعينِ صَوبَ مَعاقلِ السهوب

78
00:08:34,160 --> 00:08:39,760
‫تارِكَينِ أمرَ حصارِ "كايفنغ" ودَحرِها لِـقادةِ جُندِهمُ الـمُحنَّكين

79
00:08:40,160 --> 00:08:42,370
‫وهُم أهلٌ لِـبُلوغِ هذا الظَّفَر

80
00:08:45,500 --> 00:08:50,860
‫وعَقبَ مُرورِ عامين، انطوت مَلاحِمُ سلالةِ جِين لِـتبيدَ إلى الأبد

81
00:09:01,540 --> 00:09:04,560
‫يَرتسمُ أمامَنا نجاحٌ باهرٌ لِـطقوسِ الصيدِ الدائري

82
00:09:04,940 --> 00:09:06,390
‫أَتُشاطِرُني الرأيَ يا بورولداي؟

83
00:09:06,390 --> 00:09:07,980
‫بل أنا أوطَاي... يا أبتي

84
00:09:10,380 --> 00:09:14,740
‫وعلى كُلٍّ... إن نَجوتُ منَ الخسارة، فـما حُزتُ منَ الغنائمِ إلا اليسير

85
00:09:15,400 --> 00:09:17,760
‫تُرى... أيُّ آلٍ منهم حازَ الغنيمةَ الأوفر؟

86
00:09:33,760 --> 00:09:36,220
‫أزُفُّ إليكَ التهانيَ بـنصرِكَ المؤزَّرِ

87
00:09:37,720 --> 00:09:40,180
‫يَسُرُّ جَناني أن أرى العافيةَ تَعلو مُحيَّاكِ يا بوراكتشين

88
00:09:40,180 --> 00:09:42,120
‫حملتُ لكِ معي هِبةً تليقُ بـمَقامِكِ

89
00:09:42,120 --> 00:09:44,930
‫ستَرِدُ الديارَ عما قريب، فـتَطلّعي لـشهودِها

90
00:09:46,420 --> 00:09:49,630
‫تَتهيَّأُ صروحُ المأدُبةِ لاستقبالِك، فـتَفضَّل بالجوار

91
00:09:50,750 --> 00:09:54,370
‫أفصِح لي أيُّها الخاقانُ الأعظم، عَمَّ كُنهِ هذهِ الهبة؟ أَلِي حَظوةٌ منها كذلِك؟

92
00:09:55,040 --> 00:09:56,010
‫لا ريبَ في ذلِك

93
00:09:56,010 --> 00:09:58,570
‫تُرى... ما مَكنونُ تلكَ الهِبةِ إذن؟

94
00:10:06,370 --> 00:10:07,440
‫شيرا

95
00:10:11,880 --> 00:10:13,260
‫أهلاً بكِ... طالَ عهدُ فِراقِنا

96
00:10:13,260 --> 00:10:14,720
‫مَا الذي قادَ رِكابكِ صَوبَ مَعسكرِنا؟

97
00:10:14,720 --> 00:10:18,610
‫وجّهتني الخاتونُ سورغاغتاني بـمُلازمةِ رِكابِ الأميرِ تولوي لِأجلٍ مؤقت

98
00:10:30,320 --> 00:10:32,940
‫يا شقيقي... مَا وِجهتُنا المقبلةُ لـزحفِ جحافِلِنا؟

99
00:10:34,070 --> 00:10:36,670
‫بَدءًا... أَرى أن نَشرعَ في بناءِ حاضرةٍ مَشيدة

100
00:10:38,890 --> 00:10:39,770
‫فاطمة

101
00:10:39,770 --> 00:10:41,370
‫طَوعَ بنانِكِ يا الخاتون توراكينا

102
00:10:41,370 --> 00:10:43,170
‫لكِ رُخصةُ الانصرافِ والمُكوثِ بـعِيدًا اليوم

103
00:10:44,010 --> 00:10:47,080
‫وحاذِري أن يَلجَ قَدَمُكِ سُرادِقي اليوم

104
00:10:47,080 --> 00:10:47,690
‫ماذا؟

105
00:10:57,950 --> 00:11:02,430
‫انقطعَ عهدُ حديثِ الخاتونِ توراكينا معي منذُ أيام

106
00:11:03,360 --> 00:11:05,810
‫ويَختلجُ في جَناني أنَّها تتعمّدُ صَدِّي وتَجنُّبي

107
00:11:08,340 --> 00:11:09,990
‫أوَتأمرُني ألا يَلجَ قدَمي سُرادِقَها؟

108
00:11:14,730 --> 00:11:16,100
‫الخاقانُ الأعظم؟

109
00:11:20,170 --> 00:11:25,420
‫وفي مُنتصفِ طَريقِ أَوبةِ أوقطاي وتولوي صَوبَ أراضِيهما

110
00:11:28,650 --> 00:11:29,460
‫خاقاننا الأعظم؟

111
00:11:30,650 --> 00:11:31,560
‫أيها الخاقان الأعظم

112
00:11:32,220 --> 00:11:33,220
‫قِفوا جَميعًا

113
00:11:33,570 --> 00:11:35,000
‫أَيُصيبكَ سُوءٌ أيها الخاقان الأعظم؟

114
00:11:35,760 --> 00:11:38,460
‫أيها الخاقان، فليُحضِر أحدُكم طبيبًا

115
00:11:38,460 --> 00:11:42,430
‫حَلَّ بـالخاقانِ أوقطاي سَقَمٌ وبَلاءٌ مُفاجِئ

116
00:11:49,950 --> 00:11:51,710
‫يا خاقانَنا الأعظم...

117
00:11:51,710 --> 00:11:54,120
‫لا ريبَ أنَّ النَّصَبَ بَلغَ منهُ لِـطولِ مسارِ الرحلة

118
00:11:54,120 --> 00:11:56,020
‫يا لَـهُ من خَطبٍ يُرثى له

119
00:11:54,460 --> 00:11:56,020
‫ستَردُّ العافيةُ جَسدَهُ لا مَحالة

120
00:11:57,840 --> 00:12:00,480
‫مَا لِي لا أَقدرُ على كَبتِ هذا الشعورِ الـمُشؤوم؟

121
00:12:01,050 --> 00:12:02,760
‫ثمةَ خطبٌ مريبٌ يُوارى هاهنا

122
00:12:03,180 --> 00:12:04,230
‫أيّتها الجارية

123
00:12:05,310 --> 00:12:06,580
‫اتبعي خطاي

124
00:12:08,790 --> 00:12:10,790
‫جرع أحدهم الخاقانَ الأعظم السُّمّ

125
00:12:10,790 --> 00:12:11,830
‫سُمّ؟

126
00:12:12,210 --> 00:12:14,610
‫ما عاد هذا هواجس ظنون كاذبة من جانبي هذه المرة

127
00:12:14,610 --> 00:12:16,330
‫فقد أفضت بوراكتشين بهذا القول عيانًا

128
00:12:17,130 --> 00:12:21,140
‫أيّتها الجارية... أنتِ من وهب الحياةَ لبوراكتشين تارة أخرى

129
00:12:21,580 --> 00:12:24,300
‫ولأجل هذا... ينأى جَناني عن توجيهِ أصابع الاتهام إليكِ

130
00:12:24,300 --> 00:12:25,650
‫مَا مَغزى قَولِكِ هذا يا خاتون؟

131
00:12:27,370 --> 00:12:31,140
‫تلوحُ على جسدِ الخاقانِ الأعظم ذاتُ الشواهدِ السقيمة التي بدت على بوراكتشين

132
00:12:31,560 --> 00:12:33,310
‫جُرِّعَ السُّمَّ من رَهجِ الغار

133
00:12:34,160 --> 00:12:38,590
‫وما يَبعثُ على الفزع، أنَّ رَهجَ الغارِ الـمَحفوظَ في ديارِ بوراكتشين تَبخَّرَ أثرُه

134
00:12:39,380 --> 00:12:42,440
‫إذ ما تناهى لـعِلمِ أحدٍ مَوضعُهُ وقبضتُهُ إلا لِـثُلَّةٍ وجيزة

135
00:12:42,690 --> 00:12:43,740
‫يا خاتون موكا

136
00:12:43,740 --> 00:12:46,530
‫لَـعَمري إني لَـجاهلةٌ بـحقيقةِ كلِّ ما جرى هاهنا

137
00:12:46,530 --> 00:12:49,490
‫وما كُنتُ لأَرومَ إزهاقَ روحِ الخاقانِ الأعظم قط...

138
00:12:48,330 --> 00:12:51,070
‫أَفلَم تكوني أنتِ الفاعلة؟ يا لَـبَهجةِ خاطري إذن

139
00:12:51,070 --> 00:12:53,060
‫مَاذا؟ لَم أبسط بَينَ يديكِ بَياني بَعد

140
00:12:53,060 --> 00:12:55,750
‫لا ضير، فمَا كُنتُ لأَفقهَ من فصيحِ مَنطقكِ شَيئًا على كلِّ حال

141
00:12:56,240 --> 00:12:58,960
‫بيدَ أنِّي، وإن جَفاني رَجاحُ العقلِ بَينَكم...

142
00:12:58,960 --> 00:13:02,090
‫أَستطيعُ تبيّنَ نقاءِ السريرةِ منَ المكرِ بـسُهولة

143
00:13:04,180 --> 00:13:05,810
‫لا ريبَ أنَّكِ ضَللتِ طَريقكِ

144
00:13:07,980 --> 00:13:10,810
‫أبصِرُ رَيبَ الظنونِ يلوحُ على سِيماءِ مَلامِحِكِ

145
00:13:11,410 --> 00:13:13,980
‫بيدَ أنَّهُ إن بَرِئَت كفَّاكِ من سَبكِ هذا السُّمِّ...

146
00:13:14,260 --> 00:13:16,220
‫فـمآلُ الاتهامِ مَوجّهٌ حتمًا صَوبَ توراكينا

147
00:13:45,000 --> 00:13:46,080
‫أيّتها الجارية

148
00:13:50,590 --> 00:13:53,060
‫ثَبَتَ أنَّ رَهجَ الغارِ مَحفوظٌ بـخفاءٍ داخلَ سُرادقِ توراكينا

149
00:13:54,350 --> 00:13:57,370
‫وقد قُيِّدَت حُريَّتُها الساعةَ لِـمُحاسبَتِها واستنطاقِ مآربِها

150
00:13:58,150 --> 00:13:59,400
‫الخاتون توراكينا...

151
00:14:00,190 --> 00:14:03,860
‫مُحالٌ هذا... كيفَ يؤولُ المآلُ هكذا؟ أَتكونُ حيلةً مَحبوكةً ضدَّها؟

152
00:14:04,270 --> 00:14:07,820
‫بيدَ أنَّي يا جارية... أحملُ في صدري رَجاءً أطلبهُ منكِ

153
00:14:17,610 --> 00:14:19,960
‫سُرادقُ الخاتونِ الكبرى بوراكتشين؟

154
00:14:19,960 --> 00:14:20,860
‫الجِي الموضع

155
00:14:22,880 --> 00:14:24,210
‫أَتأذنُ لي الخاتونُ بالدخول؟

156
00:14:26,100 --> 00:14:26,970
‫فاطمة

157
00:14:27,870 --> 00:14:29,330
‫سرَّني مَسعاكِ بالوصولِ إلينا

158
00:14:33,700 --> 00:14:36,190
‫ما غايةُ استدعائي لكِ اليومَ إلا لأمرٍ عظيم

159
00:14:36,810 --> 00:14:39,260
‫أرجو من عِلمِكِ صونُ سلامةِ الخاقانِ الأعظمِ وإنقاذُه

160
00:14:39,260 --> 00:14:41,270
‫فمَا مَشورةُ أطباءِ البلاطِ عِندئذ؟

161
00:14:41,270 --> 00:14:45,750
‫يُساورُنا الشَّكُّ في تواطؤِ توراكينا بـعهدِ مكرٍ خفيٍّ مع أحدِ هؤلاءِ الأطباء

162
00:14:45,750 --> 00:14:49,620
‫فمَا عادَ لَـنا في البلاطِ موضعُ ثقةٍ نأوي إليه

163
00:14:51,150 --> 00:14:53,280
‫فارأفي بـحالِ الخاقان... وجودي عليهِ بـصنيعِ علمِكِ

164
00:15:02,740 --> 00:15:07,790
‫تبدو على جَسدِهِ ذاتُ الشواهدِ السقيمة التي عانَيتِ منها سابقًا يا خاتون

165
00:15:07,790 --> 00:15:10,420
‫ويَقينُ القولِ أنَّ جسدَهُ يَرَسفُ في مَهلَكةِ سُّمِّ رَهجِ الغار

166
00:15:12,700 --> 00:15:15,220
‫أفنيتُ أكثرَ من نِصفِ حجرِ اليادا في مَهمتي السابقة...

167
00:15:16,470 --> 00:15:19,650
‫دعيني أكون لسموك بمثابة حجر اليادا الجديد

168
00:15:20,860 --> 00:15:24,480
‫الخاتون بوراكتشين... أَتأذنينَ لي بـسؤال؟

169
00:15:24,480 --> 00:15:25,620
‫فمَا مَرامُ سؤالِكِ؟

170
00:15:25,620 --> 00:15:28,900
‫لِمَ تَجرعُ الخاتونُ توراكينا الخاقانَ الأعظمَ السُّمَّ إذن؟

171
00:15:29,280 --> 00:15:32,930
‫أجل، فقد كانَت توراكينا رَبَّةَ نِعمتِكِ وسيدتَكِ

172
00:15:32,930 --> 00:15:35,410
‫ولا ريبَ أنَّ الفزعَ يَتملَّككِ لِـهذا النبأ

173
00:15:35,840 --> 00:15:39,040
‫بيدَ أنَّكِ تلكَ الخاتونَ يَغلبُ عليها الطَّيشُ والحَماقة

174
00:15:39,910 --> 00:15:44,460
‫فمَا بَرِئ لسانُها من إفشاءِ الأحقادِ ضدَّ الخاقانِ الأعظم جهارًا كرّاتٍ ومرّات

175
00:15:44,820 --> 00:15:49,440
‫وحالَ نَيلِها من فِطنتِكِ وعِلمِكِ، انساقت صَوبَ ارتكابِ هذهِ المقتلةِ الشنيعة

176
00:15:49,850 --> 00:15:55,140
‫ولا ريبَ في مَسعاها لِإلقاءِ وِزرِ الجنايةِ على عاتقِكِ لتَفلتَ وحّدَها منَ العِقاب

177
00:15:55,490 --> 00:15:56,410
‫مُحالٌ هذا...

178
00:15:58,330 --> 00:15:59,470
‫لا يَقبلُ عَقلي هذا القول

179
00:15:59,470 --> 00:16:01,070
‫أَفِي مَكنونِ صَدرِكِ يقينٌ يَدفعُكِ لِإنكارِ هذا؟

180
00:16:01,690 --> 00:16:02,490
‫إذ...

181
00:16:03,450 --> 00:16:07,570
‫صَدري يَعلمُ بـأنَّها لَم تُوارِ عنِّي حَديثًا من أسرارِها قَطّ

182
00:16:08,510 --> 00:16:12,320
‫كل ما طَوَتهُ دفينًا في أعماقِ قلبها

183
00:16:12,790 --> 00:16:15,090
‫حتى عن الذين تعلَّقَ بـهم الفؤادُ ذاتَ يوم

184
00:16:15,680 --> 00:16:17,490
‫وعاصفة السخط والغضب المكتوم في جنانها

185
00:16:17,950 --> 00:16:19,700
‫أحقًا ما تدّعين؟

186
00:16:20,850 --> 00:16:21,420
‫ماذا تَعنين؟

187
00:16:21,800 --> 00:16:22,810
‫يا فاطمة

188
00:16:23,240 --> 00:16:26,560
‫قضيتِ أزمانًا جاريةً لدى الخاتونِ سورغاغتاني قبل وفودكِ إلينا

189
00:16:26,560 --> 00:16:32,510
‫وتوراكينا تفوقُ الفِطنةَ دهاءً لِـتمنحَكِ ثِقتَها بيُسرٍ وهيَ تَعلمُ مَحتَد نسبِكِ

190
00:16:32,820 --> 00:16:34,370
‫فتفرّسي في الماضي جليًّا

191
00:16:34,370 --> 00:16:38,100
‫أحَقًّا لم تصنع توراكينا صنيعًا يسترعي قلقَ جَنانكِ وتشكّككِ؟

192
00:16:41,640 --> 00:16:44,120
‫أَيُعقلُ أن تكونَ الخاتونُ توراكينا هيَ من سَبكَت كيدَ السُّمِّ؟

193
00:16:47,380 --> 00:16:48,650
‫الخاتون بوراكتشين

194
00:16:49,750 --> 00:16:53,530
‫اسحقي هذا الحجرَ الزُّلال، وجرّعي الخاقانَ الأعظمَ منهُ غَداةَ كُلِّ يوم

195
00:16:54,480 --> 00:16:58,020
‫وإن فَنِيَ مِقدارُه، فالتمسي حجرَ يادا آخرَ غيرَه

196
00:16:58,020 --> 00:17:00,620
‫على أن يَمتازَ بـذاتِ اللونِ الرائقِ لهذا الحجرِ قَدرَ الـمُستطاع

197
00:17:02,500 --> 00:17:04,090
‫لكِ منِّي وافرُ الشُّكرِ والتَّقدير

198
00:17:12,150 --> 00:17:13,630
‫أأصيبَ شقيقي بسَقَم؟

199
00:17:13,630 --> 00:17:16,470
‫كيفَ غدت عِلّتُه؟ أَيُمكنُ إبراؤُهُ من هذا البلاء؟

200
00:17:16,470 --> 00:17:18,950
‫ما عادَ عِلمُ الداءِ المُلِمِّ بهِ بيّنًا للأطبّاء

201
00:17:18,950 --> 00:17:21,720
‫بيدَ أنَّ مَهَرَةَ الطبِّ منَ المشرقِ والمغربِ حَشدوا عزمَهم لِـعِلاجِه

202
00:17:21,720 --> 00:17:24,490
‫وتناهى إليَّ أنَّ جَسدَهُ يَبدي تباشيرَ العافيةِ والشفاء

203
00:17:24,490 --> 00:17:25,690
‫أَحَقًّا هذا؟

204
00:17:25,980 --> 00:17:29,610
‫وَجّهتِ الخاتونُ الكبرى بوراكتشين بـحَشدِ "الكاماتِ" لإقامةِ طقوسِ التَّعويذ

205
00:17:29,610 --> 00:17:31,900
‫وهيَ ترجو شهودَ سموّكَ لـِتلكَ الطقوسِ يا صاحبَ السموّ

206
00:17:31,900 --> 00:17:33,570
‫أدركتُ المغزى، وسأَمضي لحضرتِهمُ الساعة

207
00:17:33,570 --> 00:17:34,860
‫تريّث يا تولوي

208
00:17:37,020 --> 00:17:38,490
‫سورغاغتاني...

209
00:17:38,490 --> 00:17:41,600
‫أَمَرِضَ فجأةً؟ ثمةَ خطبٌ مريبٌ يُساورُ عقلي

210
00:17:43,040 --> 00:17:45,040
‫يا شيرا... ما عهدُ خبرِ فاطمة المبلَّغِ إليكِ؟

211
00:17:45,470 --> 00:17:46,540
‫الأمرُ أنَّ...

212
00:17:47,250 --> 00:17:51,500
‫إنَّ جُلَّ حاشيةِ البلاطِ لن تُثمنَ مَسألةَ الاعتمادِ الكليِّ على حُكماءِ الطبِّ الأجانب

213
00:17:51,860 --> 00:17:55,980
‫ولأجلِ هذا، يَعمدُ فرسانُ المغولِ إلى إقامةِ طقوسِ التَّعويذِ تماشيًا مع موروثِهم القَبلي

214
00:17:56,350 --> 00:17:57,950
‫ذاك جُلُّ ما تناهى لـعلمي الساعة

215
00:17:58,450 --> 00:17:59,970
‫صَدَقَ فصيحُ القَولِ إذن

216
00:17:59,970 --> 00:18:01,890
‫أَفتنقل إلى الخاتونِ سورغاغتاني عهدي هذا؟

217
00:18:03,530 --> 00:18:05,050
‫أرجو ألاّ يَتسرَّبَ القلقُ لـجَنَانها

218
00:18:05,600 --> 00:18:09,700
‫فـإنَّ الخاتونَ الكبرى بوراكتشين لَـفَطِنَةٌ وحَقيقةٌ بـكاملِ ثِقَتِنا

219
00:18:12,410 --> 00:18:16,580
‫تناهت إلَيَّ أنباءٌ عن وَافرِ حِكمةِ وفِطنةِ الخاتونِ الكبرى بوراكتشين

220
00:18:17,100 --> 00:18:19,690
‫إنكِ لَـتُسرفينَ في جَلبِ الفَزَعِ لـنفسِكِ يا سورغاغتاني

221
00:18:20,180 --> 00:18:23,490
‫مَا هِيَ إلا طقوسُ تَعويذٍ عابرة، فـلِمَ نُلبسُها ثوبَ المَكرِ والريبةِ منذُ المَطلَع؟

222
00:18:24,010 --> 00:18:27,160
‫إنَّ "تنغري" هُوَ من نَصَرَ لواءَ شقيقي في ملاحِمِ الغزوِ السابقة

223
00:18:27,680 --> 00:18:31,250
‫وإني لَـعلى يَقينٍ من أنَّ مَعونةَ "تنغري" ستَحفظُ جَسدَهُ هاهنا كذلِك

224
00:18:31,870 --> 00:18:32,630
‫أجل

225
00:18:41,160 --> 00:18:43,590
‫«فـلِمَ نُلبسُها ثوبَ المَكرِ والريبةِ منذُ المَطلَع؟»

226
00:18:44,010 --> 00:18:45,370
‫لَعَلَّ هذا هُوَ الرَّشاد

227
00:18:45,800 --> 00:18:47,980
‫سَأسكنُ لِـقولِ جاريَتِنا فاطمةَ وأثقُ بـها

228
00:18:57,330 --> 00:18:59,070
‫أأَصابَ الوعكُ جَسدَ الخاقانِ الأعظم؟

229
00:18:59,470 --> 00:19:01,880
‫تَنامت إليَّ هَواجسُ بـأنَّ يدًا أثيمةً رَمَتهُ بـلَعنةِ السِّحر

230
00:19:01,880 --> 00:19:04,870
‫اخرس... إياكَ والتهاونَ بالحديثِ عن طقوسِ اللَّعنة

231
00:19:05,370 --> 00:19:06,850
‫الخاتون توراكينا...

232
00:19:06,850 --> 00:19:08,810
‫أودُّ لِـقاءَ حضرتِها على صعيدٍ صامتٍ لنتبادل الحديث

233
00:19:09,370 --> 00:19:12,540
‫ولَعَلَّ مَشاهدَ هذا الاضطرابِ تَمنحُ مَسعايَ مَخرجًا مُلائمًا

234
00:19:58,380 --> 00:20:02,420
‫أَحكمنا وثاقَ الأرواحِ الخبيثةِ في جَوفِ ماءِ هذا المِخضَب

235
00:20:02,420 --> 00:20:04,650
‫نَطقَت هَواجسُ الأرواحِ الحارِسةِ بِـالمَقَال

236
00:20:04,650 --> 00:20:08,310
‫صونُ سلامةِ الخاقانِ الأعظم تقتضي تقديمَ قُربانٍ يَفديه

237
00:20:08,760 --> 00:20:12,020
‫فليتَجَرَّع أحدُكم مَحاميلَ هذا الـمِخضَبِ حتى الرمقِ الأخير

238
00:20:16,960 --> 00:20:18,690
‫أنا مَن سيتجرَّعُ هذا المصل

239
00:20:20,190 --> 00:20:22,700
‫فمَا أنا اليومَ إلا شَجَرةٌ يابِسةٌ دَنا خَريفُها

240
00:20:24,210 --> 00:20:25,900
‫تريَّثي

241
00:20:27,030 --> 00:20:30,090
‫فـفِداءُ الأرواحِ يستوجبُ سَليلًا يَتصلُ نَسَبُهُ بـصُلبِ الخاقانِ الأعظم

242
00:20:31,260 --> 00:20:32,260
‫أَتَعني هذا؟

243
00:20:32,260 --> 00:20:36,200
‫أَقصدُ بـذلِك... نجلَ الخاقانِ الأعظمِ أو حَفيدَهُ السَّليل

244
00:20:36,200 --> 00:20:39,100
‫أو شَقيقَهُ من صُلبِ والِدِه

245
00:20:44,990 --> 00:20:46,930
‫طالما كانَ ذلِك... فـلتَكُن رُوحي فِداءَهُ

246
00:20:47,870 --> 00:20:48,990
‫يا عماه...

247
00:21:08,850 --> 00:21:09,990
‫يا "تنغري"...

248
00:21:10,710 --> 00:21:14,300
‫إن حَجَبتَ روحَهُ عِقابًا على خَطايا شقيقي الخاقانِ...

249
00:21:14,690 --> 00:21:17,940
‫فـأنتَ تَعلمُ يَقينًا أنَّ هاهنا روحًا أثقلَ خَطايا وأَعظمَ جُرمًا من روحِهِ

250
00:21:18,530 --> 00:21:23,300
‫فـأنا مَن أزهقَ أرواحَ الخصومِ كثرةً، وانتهبَ منَ النفائسِ بأكثرَ ممَّا فَعَلَ الخاقان

251
00:21:28,250 --> 00:21:29,530
‫تريَّث... بَل هَل...

252
00:21:29,530 --> 00:21:33,780
‫أعَساهُ استُدعِيَ لِـفَضلِ مَواهِبِهِ، لِيَخدمَ في رِكابِ جِوارِ "تنغري"؟

253
00:21:34,760 --> 00:21:37,190
‫وحتى في مِثلِ هذا المآل، لَـأنا الخيارُ الأرجحُ مَثوبة

254
00:23:39,010 --> 00:23:41,050
‫في الحلقةِ القادمة: «الحِكمة»