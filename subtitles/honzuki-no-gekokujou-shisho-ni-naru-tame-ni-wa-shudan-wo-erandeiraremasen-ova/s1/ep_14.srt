1
00:00:01,480 --> 00:00:05,220
!أنا الآن كاهنة متدرِّبة في الكاتدرائيّة

2
00:00:05,650 --> 00:00:09,730
!مرحى! أستطيع أخيراً قراءة كتُبي

3
00:00:10,560 --> 00:00:12,500
،بعد أن تقرّر انضمامها للكاتدرائيّة بشكل نهائي

4
00:00:12,500 --> 00:00:14,820
تحتفِل ماين بمدخلِها إلى الكتُب
والمُكتشَف حديثاً

5
00:00:15,570 --> 00:00:17,210
...في هذه الأثناء

6
00:00:17,500 --> 00:00:20,490
إيكّارد، إيوستاكيوس

7
00:00:20,880 --> 00:00:25,380
.أريد معلومات عن فتاةٍ تُدعى ماين
إنّها تعيش في مركزِ المدينة ومُصابة بالمُلتهِم

8
00:00:25,380 --> 00:00:29,240
ستنضمّ للكاتدرائيّة ككاهنة مُتدرِّبة
برداءٍ أزرق

9
00:00:29,490 --> 00:00:32,510
لمَ تمنح فتاةً كهذه رداءً أزرق؟

10
00:00:32,870 --> 00:00:35,790
،إنّها تدير مشغلاً يُنتِج ورقاً مستمدّاً من نبات

11
00:00:35,790 --> 00:00:37,410
،ولديها شغف لمُطالعة الكتُب

12
00:00:37,410 --> 00:00:41,120
وعرضَتْ أن تدفع قطعةً ذهبيّةً كبيرةً إذا سمحنا
لها بالانضمامِ والقراءة هنا

13
00:00:41,120 --> 00:00:42,880
لا شكّ في أنّها فتاة غريبة

14
00:00:43,150 --> 00:00:45,010
غريبة؟

15
00:00:45,010 --> 00:00:49,510
أجل. أحتاج منكما لأي معلومة عنها
تستطيعان التوصّل إليها

16
00:00:49,790 --> 00:00:50,620
!حاضر

17
00:02:34,560 --> 00:02:36,630
اسمي إيوستاكيوس

18
00:02:37,170 --> 00:02:39,140
،نحن، معاونا رئيس الكهنة

19
00:02:39,140 --> 00:02:41,630
تسلّلنا إلى منطقةِ مركز المدينة بأمر منه

20
00:02:41,630 --> 00:02:43,630
كان ذلك في بداية الصّيف تقريباً

21
00:02:44,170 --> 00:02:46,140
...هذا هو مركز المدينة إذاً

22
00:02:50,990 --> 00:02:53,370
أنت تتعامل مع هذا بصورةٍ جيّدة عجيبة
يا إيوستاكيوس

23
00:02:53,370 --> 00:02:55,520
كيف يمكنك التنفُّس هنا؟

24
00:02:55,520 --> 00:02:57,410
علينا فقط أن نتأقلم مع الأمر

25
00:02:57,410 --> 00:03:01,460
بغضّ النظر عن ذلك، يجدر بنا أن نبحث على الأرجح
عن متجرٍ يبيع ملابسَ قديمة

26
00:03:01,780 --> 00:03:03,290
من هما؟ نبيلان؟

27
00:03:02,020 --> 00:03:05,390
يبدو أننا اخترنا النوع الخاطئ من اللّباس

28
00:03:03,290 --> 00:03:04,270
تاجران على الأرجح

29
00:03:04,270 --> 00:03:05,590
متعجرفان جداً

30
00:03:07,860 --> 00:03:09,470
شكراً جزيلاً لكما

31
00:03:09,840 --> 00:03:13,950
بالمناسبة، هل تعرفان مكان مشغل ماين؟
يصنعون فيه ورقاً مستمدّاً من النبات

32
00:03:13,950 --> 00:03:15,710
مشغل ماين"؟"

33
00:03:16,820 --> 00:03:19,460
يؤسفني القول أنّنا لا نعرف، أعتذر

34
00:03:20,040 --> 00:03:21,200
حقّاً؟

35
00:03:26,770 --> 00:03:28,390
!رائحة هذه الملابس كريهة

36
00:03:28,390 --> 00:03:31,590
ما كنتُ لأرتدي هذه لو لم أكن أستخدم
!تعويذة تطهير على نفسي

37
00:03:31,590 --> 00:03:32,940
كفَّ عن الأنين

38
00:03:33,200 --> 00:03:35,110
علينا أن نستعجل في تحرّياتنا

39
00:03:35,110 --> 00:03:36,860
رأيتَ كيف تصرّفت تلكما المرأتين

40
00:03:36,860 --> 00:03:39,750
كانتا حذرتين منّا لأنّ وجهينا غير مألوفين

41
00:03:39,750 --> 00:03:43,440
سكّان مركز المدينة محتاطون ولديهم روابط
جيّدة مع بعضهم الآخر

42
00:03:43,440 --> 00:03:45,850
بدأت الرّائحة الكريهة تُؤلم رأسي

43
00:03:45,850 --> 00:03:49,450
هذه المهمّة أسوأ من التّخييم في الهواء
الطلق لجمع المواد

44
00:03:55,160 --> 00:03:58,410
لن أنجز أي شيء بوجودي معك

45
00:03:58,700 --> 00:04:02,420
اصطحبتُ زميلي المريض إلى فندق

46
00:04:02,800 --> 00:04:05,940
وتوجّهتُ بمفردي للتحرِّي حول
شركة غيلبيرتا

47
00:04:05,940 --> 00:04:08,430
مارك، أوصِل ماين إلى المنزل

48
00:04:08,430 --> 00:04:09,870
لا حاجة لذلك

49
00:04:09,870 --> 00:04:12,790
سألتقي بأمّي في الساحةِ المركزيّة

50
00:04:12,790 --> 00:04:14,690
ستأخذني إلى المنزلِ بعد التسوُّق

51
00:04:21,230 --> 00:04:23,110
أهذا هو المكان؟

52
00:04:23,620 --> 00:04:26,680
سمعتُ أنَّ مشغلَ ماين يؤدِّي مُعظم
أعماله معهم

53
00:04:26,680 --> 00:04:28,900
يبدو كمتجر ملابس أنيق

54
00:04:29,250 --> 00:04:31,960
لمَ يتشارك مع ورشة ورق؟

55
00:04:33,290 --> 00:04:36,740
هذه دبابيس شعر غير عاديّة

56
00:04:40,120 --> 00:04:43,840
هل يمكننا خدمتك في شيء؟

57
00:04:45,960 --> 00:04:49,840
لا، كلّ ما في الأمر أنّ بعض دبابيس
الشّعر لفتت انتباهي

58
00:04:50,590 --> 00:04:52,320
لستُ بحاجةٍ لأي شيء، شكراً

59
00:04:56,170 --> 00:04:59,690
عدتَ خالي الوفاض إذاً؟

60
00:04:59,690 --> 00:05:00,730
أجل

61
00:05:00,730 --> 00:05:04,660
لا يمكنني ااقتراب من ذلك المكان بعد الآن
بعد إثارة الشّكوك هكذا

62
00:05:05,160 --> 00:05:06,440
لكن لديّ فكرة أفضل

63
00:05:07,900 --> 00:05:11,990
ورد في الملفِّ أنّ ماين تعيش بالقرب
من البوّابةِ الجنوبيّة

64
00:05:11,990 --> 00:05:15,530
أظنُّني سأجدها في المنزلِ وأجمع
بعض المعلومات في تِلك الأوساط

65
00:05:15,530 --> 00:05:18,290
تنكّرك لا ينفك يذهلني

66
00:05:18,290 --> 00:05:20,840
تبدو دوماً كمُزارع

67
00:05:21,510 --> 00:05:23,540
آسف لقلّةِ حيلتي

68
00:05:23,770 --> 00:05:25,760
سأغادر إذاً

69
00:05:25,760 --> 00:05:29,550
آمل أن تعتاد على هذا مع حلول اللّيل

70
00:05:35,370 --> 00:05:40,020
راقبتُ النّاس من حولي وفعلتُ ما بوسعي
للاختلاطِ بينهم كشخصٍ ريفيّ

71
00:05:44,100 --> 00:05:44,990
!مهلاً

72
00:05:44,990 --> 00:05:47,500
آسف! هل أنتِ بخير؟

73
00:05:47,500 --> 00:05:49,290
أ-أجل

74
00:05:51,990 --> 00:05:55,840
لكن ما الذي جاء بمزارِع إلى هذه المنطقة؟

75
00:05:55,840 --> 00:05:57,580
لن تجد سوقاً هنا

76
00:05:57,580 --> 00:06:02,010
لا ترتابي. لديّ عمل أقوم به هنا فحسب

77
00:06:02,010 --> 00:06:03,920
هل تعرفين فتاةً تُدعى ماين؟

78
00:06:04,290 --> 00:06:05,380
!ماين؟

79
00:06:05,380 --> 00:06:08,800
أجل، سبقَ وأعانتْني بسخاء

80
00:06:08,800 --> 00:06:11,650
أبحث عنها لردّ الجميل

81
00:06:11,650 --> 00:06:13,130
لم أسمع بها

82
00:06:13,130 --> 00:06:17,630
سمعتُ أنّها تصنع ورقاً مستمدّاً من الورق
في مشغلِ ماين

83
00:06:18,250 --> 00:06:20,260
!أقول لك لا أعرف

84
00:06:20,260 --> 00:06:21,900
،إذا بقيتَ في الأرجاء طويلاً

85
00:06:21,900 --> 00:06:24,280
!فمن الأفضل أن تهيّئ نفسك ليخالك النّاس لصّاً

86
00:06:24,520 --> 00:06:26,680
!انقلع من هنا

87
00:06:27,150 --> 00:06:29,570
!إذا رأيتُك ثانياً فستدفع الثمن غالياً

88
00:06:31,930 --> 00:06:34,140
يا إلهي

89
00:06:34,140 --> 00:06:36,570
أظنُّني سأسأل هنا

90
00:06:45,830 --> 00:06:47,850
حصلنا على الكثير اليوم

91
00:06:48,190 --> 00:06:50,810
أطفال في نفس سنّ ماين

92
00:06:50,810 --> 00:06:52,030
!هذا مثاليّ

93
00:06:53,340 --> 00:06:55,490
يا أطفال

94
00:06:54,090 --> 00:06:55,330
...لكن

95
00:06:56,350 --> 00:06:58,600
هل تعرفون فتاةً تُدعى ماين؟

96
00:06:58,600 --> 00:07:00,010
!ماين؟

97
00:07:00,010 --> 00:07:02,340
!لـ-لا علاقة لي بها

98
00:07:04,310 --> 00:07:07,330
فاي، أما زلت خائفاً من ماين؟

99
00:07:07,650 --> 00:07:08,640
خائف"؟"

100
00:07:08,910 --> 00:07:13,510
أجل. استشاطَتْ غضباً عندما كسرَ
شيئاً لها ذات مرّة

101
00:07:13,510 --> 00:07:14,350
صحيح؟

102
00:07:15,220 --> 00:07:19,760
حقّاً؟ لكن كانَتْ لطيفة جدّاً معي

103
00:07:19,760 --> 00:07:23,180
لا بدَّ وأنّك تقصد توري، لا ماين

104
00:07:23,180 --> 00:07:26,510
أجل. مُحال أن تكون ماين لطيفة مع أحد

105
00:07:26,510 --> 00:07:27,500
توري؟

106
00:07:27,500 --> 00:07:29,620
أخت ماين الكبرى؟

107
00:07:29,620 --> 00:07:31,880
!توري

108
00:07:32,200 --> 00:07:33,380
ماذا؟

109
00:07:33,760 --> 00:07:36,830
هذا الرّجل يبحث عن ماين

110
00:07:36,830 --> 00:07:38,020
عن ماين؟

111
00:07:38,020 --> 00:07:41,910
أجل. أريد أن أردّ لها الجميل
على مساعدتِها لي

112
00:07:41,910 --> 00:07:44,520
أحضرتُ خضراوت من مزرعتي

113
00:07:44,520 --> 00:07:47,510
ماين ساعدتك؟ هل أنت متأكّدٌ من ذلك؟

114
00:07:47,510 --> 00:07:50,530
أنا متأكّدٌ أنَّها عرّفَتْ عن نفسها
باسمِ ماين

115
00:07:50,530 --> 00:07:52,980
هل كان هناك أحد رفقتها؟

116
00:07:52,980 --> 00:07:56,250
لا، لم يكن يوجد سواها

117
00:07:56,250 --> 00:07:58,610
إذاً من المؤكَّد أنَّك تخلط بينها وبين شخص آخر

118
00:07:58,610 --> 00:08:00,730
لا تستطيع ماين أن تخرج بمفردِها هكذا

119
00:08:00,730 --> 00:08:02,750
ماذا تقصدين بـ"لا تستطيع أن تخرج بمفردها"؟

120
00:08:02,750 --> 00:08:03,710
أجل

121
00:08:03,710 --> 00:08:07,120
إنّها تغيب عن الوعي طوالَ الوقت، لذا
لا بدَّ أن يرافقها أحد ما

122
00:08:07,120 --> 00:08:10,140
هكذا إذاً؟ هل أخطأتُ الشخص؟

123
00:08:10,140 --> 00:08:13,430
هل سمعتُم جميعاً عن مشغلِ ماين إذاً؟

124
00:08:13,860 --> 00:08:15,650
لا

125
00:08:14,990 --> 00:08:16,500
لا أدري

126
00:08:16,980 --> 00:08:19,130
لـ-لا يهمّ إذاً

127
00:08:19,380 --> 00:08:21,670
آسف لإزعاجكم

128
00:08:21,670 --> 00:08:23,950
سامحوني بهذا

129
00:08:25,430 --> 00:08:26,780
!إلى اللِّقاء

130
00:08:30,480 --> 00:08:34,110
تبّاً. لا شيء يسير على ما يُرام هذه المرّة

131
00:08:43,430 --> 00:08:46,320
إنّها واهنة جداً لدرجة أنّها بحاجةٍ لمُرافق

132
00:08:46,320 --> 00:08:50,840
لم أتوقّع ألّا أعرف شيئاً عنها في حيّها

133
00:08:51,190 --> 00:08:52,800
ماذا الآن؟

134
00:08:52,800 --> 00:08:56,160
سأتسلّل إلى داخل نقابة التجّار ليلاً

135
00:08:56,160 --> 00:08:59,180
لن نتوصّل لنتيجةٍ من مجرّد السُّؤال

136
00:08:59,180 --> 00:09:01,790
وأيضاً والد ماين هو جنديّ يعمل
في البوّابةِ الجنوبيّة

137
00:09:01,790 --> 00:09:03,080
سوف نتعقّبه

138
00:09:05,040 --> 00:09:07,560
!امتناننا لوانتول

139
00:09:12,200 --> 00:09:15,160
هكذا إذاً، ستصبح أباً

140
00:09:15,470 --> 00:09:18,730
كيف سمّيتُما طفلتيكما؟

141
00:09:18,730 --> 00:09:20,250
لماذا؟

142
00:09:20,250 --> 00:09:23,670
،كنتُ أنا وكورينا نناقش الأمر في كلّ ليلة

143
00:09:23,670 --> 00:09:25,250
لكن لم نتوصّل لاسم مناسب

144
00:09:25,250 --> 00:09:29,000
على رسلِك! الطفل قادم في الشّتاء، صحيح؟

145
00:09:29,000 --> 00:09:30,250
أنت عجولٌ جدّاً

146
00:09:36,500 --> 00:09:38,520
هل خفَّ غثيانك؟

147
00:09:41,000 --> 00:09:43,760
أفضِّل التواجد في الخارج على البقاء
في هذا الوكر

148
00:09:43,760 --> 00:09:46,020
هل يمكننا أن ننتقل لخطوتِنا التالية؟

149
00:09:46,380 --> 00:09:48,460
حسناً. لنغادر

150
00:10:02,520 --> 00:10:04,380
،في اليوم الموالي

151
00:10:04,380 --> 00:10:08,660
ذهبنا للتكلُّم مع النّاس الذين عملتْ
معهم شركة غيلبيرتا

152
00:10:08,660 --> 00:10:09,750
ماين؟

153
00:10:10,050 --> 00:10:12,040
تِلك الفتاة؟

154
00:10:12,040 --> 00:10:15,760
إنّها مميّزة بلا شكّ. يمكنها أن تكتب
نماذج طلبات بمفردِها

155
00:10:16,100 --> 00:10:17,760
أجل، أعرفها

156
00:10:17,760 --> 00:10:20,530
رجاحة عقلها في التسوُّق تُخجِل البالغين

157
00:10:20,530 --> 00:10:22,380
إنّها سريعة في الدفع أيضاً

158
00:10:22,690 --> 00:10:25,680
"لا يتوانى الناس عن مناداتها بـ"الفتاة الغريبة

159
00:10:25,680 --> 00:10:29,650
لكن حسبما سمِعت، أميل أكثر تجاه
"بوصفها بـ"البارعة في كلّ شيء

160
00:10:30,270 --> 00:10:33,570
في كلِّ الأحوال، يبدو أنّها تتحمّل
،مسؤولياتها بصورةٍ جيّدة

161
00:10:33,570 --> 00:10:36,520
لذا لا ينبغي أن يكون انضمامها ككاهنة متدرّبة
برداءٍ أزرق مشكلة

162
00:10:37,250 --> 00:10:40,020
سنوافيك بتقريرٍ مفصَّل حالما نعود"

163
00:10:40,340 --> 00:10:41,400
"هذا كلّ شيء

164
00:10:43,830 --> 00:10:47,150
بما أنَّنا هنا، لمَ لا نتفقّد السُّوق؟

165
00:10:47,150 --> 00:10:49,790
...انتهى عملنا هنا. ألا يمكننا المغادرة

166
00:10:50,230 --> 00:10:51,900
نظرة خاطفة فقط

167
00:11:01,920 --> 00:11:04,880
يا عمّ، من أين حصلت على هذا الكِتاب؟

168
00:11:04,880 --> 00:11:07,880
هذا ضمانٌ من نبيل

169
00:11:08,270 --> 00:11:09,400
نبيل؟

170
00:11:09,940 --> 00:11:11,720
هل يمكنني أن ألقي نظرة؟

171
00:11:12,830 --> 00:11:15,500
!لا أمانع بالطبع! يمكنك أن تتفحّصه كما تشاء

172
00:11:15,500 --> 00:11:16,500
...في الواقع

173
00:11:16,500 --> 00:11:18,530
لم يهتمّ أحدٌ بهذا الكتاب من قبل

174
00:11:18,530 --> 00:11:21,670
فقط أنت وتلك الطفلة الغريبة

175
00:11:22,110 --> 00:11:23,620
الطفلة الغريبة"؟"

176
00:11:23,620 --> 00:11:24,610
أجل

177
00:11:24,610 --> 00:11:27,790
...رمَتْ بنفسِها أرضاً فجأة وقالت

178
00:11:27,790 --> 00:11:31,420
،أعلم أنّني لا أستطيع شراءه
!لكن سأتدبّر أمري بإمساكه فقط

179
00:11:31,420 --> 00:11:33,760
أودُّ أن أستمتع برائحة الحبر
!الحلوة على الأقلّ

180
00:11:33,760 --> 00:11:35,440
!أتوسّل إليك

181
00:11:36,600 --> 00:11:38,130
هكذا إذاً

182
00:11:39,830 --> 00:11:42,480
اسمح لي أن أشتريه منك

183
00:11:46,750 --> 00:11:50,990
أبدَتْ اهتماماً بهذا الكتاب بل وأرادتْ
حتّى أن تشمّ حبره؟

184
00:11:50,990 --> 00:11:52,230
وصفها بـ"الفتاة الغريبة" دقيق

185
00:11:53,030 --> 00:11:58,180
بدأتُ أرى بنفسي طبيعتها حقّاً

186
00:12:05,500 --> 00:12:06,910
فيرديناند-ساما

187
00:12:06,910 --> 00:12:09,890
كذا وكذا. وهذا كلّ شيء

188
00:12:09,890 --> 00:12:10,870
هكذا إذاً

189
00:12:10,870 --> 00:12:13,250
يذكّرني هذا بأوّل لقاء بيني وبينها

190
00:12:13,250 --> 00:12:15,750
كانت تستنشق حبر الكتاب المُقدّس آنذاك أيضاً

191
00:12:15,750 --> 00:12:18,120
فعلَتْ ذلك أمامك؟

192
00:12:18,120 --> 00:12:21,450
!إنها بِحقّ أكثر طفلة مثيرة للاهتمام

193
00:12:21,450 --> 00:12:23,930
ما أوصافها يا ترى؟

194
00:12:23,930 --> 00:12:25,620
!إنّها تسرِّع نبضات قلبي

195
00:12:25,620 --> 00:12:27,570
!أريد أن ألتقي بها وأتكلّم معها

196
00:12:28,330 --> 00:12:30,850
ستسجمان معاً جيداً نظراً لغرابةِ أطواركما

197
00:12:31,140 --> 00:12:35,110
بصرفِ النظر عن ذلك، ماذا أفعل معها؟