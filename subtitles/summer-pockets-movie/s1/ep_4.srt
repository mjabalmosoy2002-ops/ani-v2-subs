!آ-آسف

205
00:19:23,960 --> 00:19:25,820
.كان ذلك خطئي بالكامل

206
00:19:26,470 --> 00:19:29,050
...ر-ريغين إياتشيكو ناري

207
00:19:29,050 --> 00:19:29,680
ماذا؟

208
00:19:30,660 --> 00:19:32,630
.ريغين إياتشيكو ناري

209
00:19:33,160 --> 00:19:34,230
ما-ما ذلك؟

210
00:19:34,230 --> 00:19:36,160
!ريغين إياتشيكو ناري

211
00:19:36,160 --> 00:19:37,640
ر-ري...؟

212
00:19:37,640 --> 00:19:40,390
!إ-إنّها لعنة توارثناها في عائلتي

213
00:19:40,390 --> 00:19:44,150
إنّه شيء طبيعيّ نقوله في عائلتنا
.وفي كلّ أنحاء الجزيرة

214
00:19:44,150 --> 00:19:48,600
.كنتُ أردّد تحيّة لسيّد النّهر

215
00:19:48,600 --> 00:19:51,340
!يقوم الجميع في الجزيرة بذلك

216
00:19:51,340 --> 00:19:53,220
!ذلك ليس غريبًا أو محرجًا على الإطلاق

217
00:19:53,220 --> 00:19:57,010
ربّما فاجأك ذلك لأنّك غريب
...عن الجزيرة، لكن

218
00:19:57,010 --> 00:20:01,260
—هذا طبيعيّ تمامًا في عائلتي
!أقصد، في الجزيرة

219
00:20:01,260 --> 00:20:02,570
.حـ-حسنًا

220
00:20:02,570 --> 00:20:04,490
!ريغين إياتشيكو ناري

221
00:20:10,700 --> 00:20:12,720
—ر-ريغين إياتشيكوما

222
00:20:12,720 --> 00:20:13,990
!لا

223
00:20:13,990 --> 00:20:28,470
!ريغين إياتشيكو ناري

224
00:20:32,940 --> 00:20:33,840
...حسنًا

225
00:20:34,230 --> 00:20:36,620
هل تحبّين المانغا؟

226
00:20:40,500 --> 00:20:43,460
!أحبّ المانغا، لكنّي أكرك أنت

227
00:20:46,850 --> 00:20:47,740
...مهلاً

228
00:20:48,210 --> 00:20:50,470
.لم أسألها أبدًا كيف تشعر حيالي

229
00:20:59,270 --> 00:21:00,360
.شيروها

230
00:21:02,350 --> 00:21:04,570
.آ-آسف على إخافتك

231
00:21:04,570 --> 00:21:07,400
ما-ما-ما... ما-ما-ماذا؟

232
00:21:07,400 --> 00:21:10,360
.أردتُ أن أعتذر لما حدث في الخزّان

233
00:21:11,820 --> 00:21:13,360
...عفوًا

234
00:21:14,590 --> 00:21:17,110
هل أتيتِ إلى هنا للحصول على شيء؟

235
00:21:18,270 --> 00:21:19,570
...إنّه

236
00:21:20,140 --> 00:21:21,620
أتريدين منّي الذّهاب لشرائه؟

237
00:21:25,020 --> 00:21:26,010
فعلاً؟

238
00:21:26,010 --> 00:21:27,800
.أنا مدين لك

239
00:21:27,800 --> 00:21:29,380
ماذا تريدين؟

240
00:21:30,880 --> 00:21:33,880
.مثلّجات بطّيخ

241
00:21:34,500 --> 00:21:36,300
.مفهوم. انتظري لحظة

242
00:21:40,830 --> 00:21:41,910
.تفضّلي

243
00:21:41,020 --> 00:21:41,910
مثلّجات شمّام

244
00:21:42,850 --> 00:21:44,060
ما هذا؟

245
00:21:44,060 --> 00:21:45,250
.مثلّجات شمّام

246
00:21:45,250 --> 00:21:47,190
.نفدت منهم مثلّجات البطّيخ

247
00:21:49,090 --> 00:21:50,030
.يمكنك أكلها

248
00:21:50,030 --> 00:21:51,940
...ماذا؟ لكنّك دفعتِ ثمنها

249
00:21:51,940 --> 00:21:53,030
.إنّها على حسابي

250
00:21:53,030 --> 00:21:54,510
.هـ-هكذا إذًا

251
00:21:55,540 --> 00:21:57,520
.أحتاج لتغيير في الوتيرة

252
00:21:58,740 --> 00:22:01,460
.يبتلع البحر كلّ شيء

253
00:22:02,270 --> 00:22:05,320
،قضاء الصّيف في أرض غير مألوفة

254
00:22:05,320 --> 00:22:06,730
...وكلّ ما يُقلقني

255
00:22:12,750 --> 00:22:16,470
.الصّيف قاسٍ للغاية

256
00:22:17,110 --> 00:22:19,500
.يعيش اللّحظة بكلّ كيانه

257
00:22:20,270 --> 00:22:21,360
.جدّي

258
00:22:22,530 --> 00:22:24,830
.سأخرج لبعض الوقت

259
00:22:24,830 --> 00:22:26,160
ستخرجين الآن؟

260
00:22:26,550 --> 00:22:31,160
...وعدتُ أصدقائي

261
00:22:33,090 --> 00:22:34,140
.حسنًا

262
00:22:34,690 --> 00:22:35,920
.مع السّلامة

263
00:22:45,300 --> 00:22:48,290
مطعم مارين

264
00:22:45,550 --> 00:22:48,290
!مرحبًا بك في توريشيروجيما

265
00:22:50,040 --> 00:22:52,840
!مرحبًا بك في جزيرة توريشيروجيما

266
00:22:53,390 --> 00:22:54,860
.شـ-شكرًا

267
00:22:54,860 --> 00:22:55,970
.أقدّر لكم هذا

268
00:23:10,660 --> 00:23:11,550
.بئسًا

269
00:23:11,550 --> 00:23:14,220
أوّل تعليق لك هو "بئسًا"؟
.هذا كثير

270
00:23:14,220 --> 00:23:23,230
مطعم مارين

271
00:23:16,330 --> 00:23:17,210
.أحم

272
00:23:18,960 --> 00:23:21,150
.إذًا فقد أتيت

273
00:23:21,150 --> 00:23:22,290
.لحفلة التّرحيب

274
00:23:25,250 --> 00:23:26,370
.شكرًا

275
00:23:27,500 --> 00:23:32,150
،جرّبتُ نصيحتك البارحة
.واستطعتُ السّباحة بشكل أفضل

276
00:23:32,150 --> 00:23:34,260
فـ-فعلاً؟

277
00:23:35,210 --> 00:23:36,580
.هذا كلّ شيء

278
00:23:37,420 --> 00:23:39,000
.أقدّر ما فعلت

279
00:23:39,000 --> 00:23:41,160
.أتمنّى أن تعود للمنزل من الجزيرة بسلام

280
00:23:41,160 --> 00:23:42,900
!وصلتُ حديثًا فحسب

281
00:23:42,900 --> 00:23:45,170
!أقاموا لي حفلة ترحيب للتّوّ

282
00:23:45,170 --> 00:23:46,750
.لم أرحّب بك أبدًا

283
00:23:52,590 --> 00:23:54,790
!مـ-مهلاً

284
00:24:01,930 --> 00:24:02,590
...عفوًا

285
00:24:03,540 --> 00:24:04,880
لماذا أنت هنا؟

286
00:24:04,880 --> 00:24:07,960
.حسنًا، كان عليّ أن أسأل بعد ما قلتِه

287
00:24:07,960 --> 00:24:10,100
ما كان ذلك قبل قليل؟

288
00:24:10,640 --> 00:24:11,680
...ذلك

289
00:24:12,120 --> 00:24:13,180
شيروها؟

290
00:24:13,450 --> 00:24:15,530
!هـ-هذا ليس من شأنك

291
00:24:15,530 --> 00:24:17,850
ماذا عنك؟

292
00:24:17,850 --> 00:24:20,160
لماذا أتيت إلى هذه الجزيرة الفارغة؟

293
00:24:20,160 --> 00:24:22,480
.لتنظيف مقتنيات جدّتي

294
00:24:23,250 --> 00:24:26,320
.لا يمكنني تذكّر كيفية قضاء العطلة الصّيفيّة

295
00:24:28,170 --> 00:24:31,660
.كان الأمر أشبه بالنّظر لطفل ضائع

296
00:24:32,090 --> 00:24:34,910
...تذكّرتُ بعد سماع كلماته

297
00:24:35,620 --> 00:24:41,110
،منذ زمن بعيد، حين كنت صغيرة
.ركضتُ عبر صيفٍ بدا وكأنّه لا ينتهي

298
00:24:41,110 --> 00:24:43,090
.مع عائلتي. مع أصدقائي

299
00:24:43,800 --> 00:24:46,660
.كان هناك دائمًا ما يمكنني فعله

300
00:24:46,660 --> 00:24:51,220
،كانت الشّمس تلمع فوق رؤوسنا
.ترعانا كلّ يوم

301
00:24:51,220 --> 00:24:53,990
.تلك هي الذّكرى الّتي جعلني أتذكّرها

302
00:24:54,750 --> 00:24:59,300
كنت أفكّر في طفولتي منذ
.أن أتيتُ للجزيرة

303
00:24:59,300 --> 00:25:00,700
.لا أعرف السّبب

304
00:25:00,700 --> 00:25:02,730
.يُثير هذا حماستي نوعًا ما

305
00:25:03,100 --> 00:25:04,960
.ربّما ذلك هو السّبب

306
00:25:04,960 --> 00:25:07,940
...علت وجهه ابتسامة خجولة عندما أخبرته

307
00:25:08,820 --> 00:25:13,490
على الأرجح أنّك تظنّ ذلك
.لأنّ الجزيرة مناسبة لك

308
00:25:14,030 --> 00:25:15,270
.هكذا إذًا

309
00:25:15,850 --> 00:25:17,120
.آمل أن تكوني محقّة

310
00:25:20,410 --> 00:25:21,270
...عفوًا

311
00:25:22,230 --> 00:25:23,960
أيمكنني أن أطرح عليك سؤالاً؟

312
00:25:25,000 --> 00:25:27,380
...مهلاً، أخبرني

313
00:25:31,390 --> 00:25:33,840
ما الّذي تعنيه بأنّ قبضتك مكسورة؟

314
00:25:35,050 --> 00:25:39,100
سمعتُ أنّك بطل أتى إلى هنا
.للعناية بقبضته المكسورة

315
00:25:39,100 --> 00:25:41,350
.إ-إنّه مجرّد تعبير مجازيّ

316
00:25:41,350 --> 00:25:45,550
...عانيتُ الكثير ولذلك... أنا

317
00:25:45,550 --> 00:25:47,140
.لا أستطيع القتال

318
00:25:47,940 --> 00:25:50,400
.هذا شعور مؤلم

319
00:25:58,450 --> 00:25:59,750
.ديجا فو

320
00:26:00,030 --> 00:26:01,220
ديجا فو؟

321
00:26:03,030 --> 00:26:04,220
.لا تهتمّي

322
00:26:04,220 --> 00:26:05,400
ديجا فو؟

323
00:26:06,380 --> 00:26:07,340
.هذا غريب

324
00:26:15,210 --> 00:26:17,050
أوي-تشان، ما هذا؟

325
00:26:17,360 --> 00:26:20,810
أرزّ مقليّ بالسّلطعون، أعددته
.من مكوّنات طازجة من الميناء

326
00:26:20,810 --> 00:26:23,520
.ما أقصده هو أنّ هذا طازج أكثر من اللاّزم

327
00:26:23,520 --> 00:26:25,770
.قطّعيه على الأقلّ

328
00:26:27,110 --> 00:26:28,770
.إنّ تجهيزه صعب جدًّا

329
00:26:34,070 --> 00:26:36,270
!آه يا أمّي

330
00:26:50,310 --> 00:26:52,960
ماذا؟ سلطعون على الفطور؟
ما هذا البذخ؟

331
00:26:52,960 --> 00:26:55,510
.بل إنّه جحيم في الحقيقة

332
00:26:55,510 --> 00:26:57,720
.القوّة النّاريّة هي أساس الأرزّ المقليّ

333
00:26:57,720 --> 00:26:59,310
...بالمناسبة يا كيوكو-سان

334
00:26:59,310 --> 00:27:00,700
ماذا عن الكوخ؟

335
00:27:01,750 --> 00:27:03,560
.لا تقلق حياله بعد

336
00:27:03,560 --> 00:27:06,180
.اذهب للاستمتاع بالجزيرة أكثر

337
00:27:06,180 --> 00:27:08,310
أستمتع بالجزيرة؟

338
00:27:14,190 --> 00:27:17,360
سبق والتقيتُ ببعض الأشخاص
.المثيرين للاهتمام بالفعل

339
00:27:19,500 --> 00:27:21,330
شيروها؟

340
00:27:31,620 --> 00:27:32,780
.شيروها

341
00:27:34,420 --> 00:27:35,370
هل صدتِ أيّ شيء؟

342
00:27:35,860 --> 00:27:37,200
.أُبلي نُصّ-نُصّ

343
00:27:37,880 --> 00:27:39,510
لِمَ أنت هنا؟

344
00:27:39,510 --> 00:27:40,930
سألتِ لِمَ؟

345
00:27:40,930 --> 00:27:45,390
،رأيتُ صديقة... شخصًا أعرفه
.وفكّرت في إلقاء التّحيّة

346
00:27:48,800 --> 00:27:50,300
.أحم

347
00:27:50,300 --> 00:27:51,810
ما الّذي تصيدينه؟

348
00:27:52,390 --> 00:27:53,440
.أيّ شيء

349
00:28:01,310 --> 00:28:03,630
أيمكنني استعارة الصّنّارة؟

350
00:28:09,040 --> 00:28:12,130
.لكن لا يوجد الكثير من السّمك هنا

351
00:28:12,750 --> 00:28:14,160
!صدتُ واحدة

352
00:28:15,830 --> 00:28:16,670
هل أنت محترف؟

353
00:28:16,670 --> 00:28:19,360
.لا، لكن ربّما لديّ الموهبة

354
00:28:19,360 --> 00:28:21,840
.كنتُ بارعًا في الإمساك بجراد المياه العذبة

355
00:28:22,200 --> 00:28:23,330
...يا لك من

356
00:28:26,170 --> 00:28:27,850
.لم أنتبه أنّ الوقت قد تجاوز الظّهيرة

357
00:28:32,990 --> 00:28:34,620
أيُعقل أنّ هذه...؟

358
00:28:36,170 --> 00:28:37,060
.حسنًا

359
00:28:42,520 --> 00:28:44,740
...يبدو هذا مثل طعام حانات، لكن

360
00:28:45,060 --> 00:28:46,870
.أنا مندهش في كلّ الأحوال

361
00:28:47,500 --> 00:28:48,880
إذًا فأنت طبّاخة بارعة؟

362
00:28:48,880 --> 00:28:51,460
.ذلك هو عملي في المنزل

363
00:28:55,630 --> 00:28:57,700
!هذا لذيذ جدًّا

364
00:28:57,700 --> 00:28:59,510
فـ-فعلاً؟

365
00:29:00,000 --> 00:29:01,190
!فعلاً

366
00:29:01,190 --> 00:29:03,020
.حـ-حسنًا

367
00:29:09,830 --> 00:29:11,100
.شكرًا لك

368
00:29:11,380 --> 00:29:13,190
.كان ذلك لذيذًا بالفعل

369
00:29:13,190 --> 00:29:16,010
.لا أحد في منزلي يطبخ بهذه البراعة

370
00:29:16,010 --> 00:29:19,790
.بما أنّك انتهيت من الأكل، اتركني وشأني

371
00:29:20,610 --> 00:29:23,280
.لن نجني أيّ شيء جيّد من هذا

372
00:29:26,780 --> 00:29:32,170
،يا إلهي، والآن بعد أن شبعت
.أشتهي شيئًا حلوًا

373
00:29:33,270 --> 00:29:35,590
أتريدين تناول مثلّجات أو ما شابه؟

374
00:29:35,590 --> 00:29:37,290
.إنّها على حسابي

375
00:29:39,370 --> 00:29:42,220
.أ-أودّ مثلّجات بطّيخ إذًا

376
00:29:42,220 --> 00:29:44,150
.حسنًا، اتّفقنا

377
00:29:47,640 --> 00:29:49,890
.من الجيّد أنّها لم تنفد منهم اليوم

378
00:29:51,610 --> 00:29:53,560
.مهلاً، إنّهما هايري وشيروها

379
00:29:53,560 --> 00:29:54,930
أحبّ أي-تشان

380
00:30:00,380 --> 00:30:01,740
!ماذا؟

381
00:30:04,180 --> 00:30:05,700
...كان ذلك باردًا

382
00:30:05,700 --> 00:30:10,060
مهلاً يا صاحبي، ستطلق عليك
.نوميكي إن بدأت تخلع ملابسك هنا

383
00:30:10,060 --> 00:30:12,540
وماذا عنكما أنتما؟

384
00:30:12,540 --> 00:30:13,750
!لا تقلق علينا

385
00:30:13,750 --> 00:30:18,540
مع أنّ الوشم كان ليكون أفضل
.حتّى لا يزول تحت المطر أو في الماء

386
00:30:18,540 --> 00:30:20,320
.ستُحزن والديك إن فعلت ذلك

387
00:30:27,050 --> 00:30:28,680
ما الأمر يا شيروها؟

388
00:30:28,680 --> 00:30:29,920
أهي ضربة شمس؟

389
00:30:29,920 --> 00:30:32,480
.سمعتُ أنّ اليوم هو أكثر أيّام السّنة سخونة

390
00:30:32,480 --> 00:30:35,910
.لا، واضح أنّها منزعجة بسبب مثلّجات البطّيخ

391
00:30:35,910 --> 00:30:37,750
.لا تقلقي يا شيروها

392
00:30:37,750 --> 00:30:38,890
.يمكننا شراء المزيد غدًا

393
00:30:39,400 --> 00:30:43,190
ما-ما الّذي يفعله لك هؤلاء
!الثّلاثة العارون؟

394
00:30:43,190 --> 00:30:45,200
!يا لها من وقاحة سافرة في وضح النّهار

395
00:30:45,200 --> 00:30:48,530
،لم تتعرّوا فحسب
!بل انحدرتم للحضيض أيضًا

396
00:30:51,200 --> 00:30:52,120
!هذا سوء فهم

397
00:30:53,740 --> 00:30:54,790
...شيروها

398
00:30:54,790 --> 00:30:56,170
.لا بدّ أنّ ذلك كان مخيفًا

399
00:30:56,170 --> 00:30:57,470
.أنت بخير الآن

400
00:30:59,180 --> 00:31:01,690
...أعزّ ما أملك

401
00:31:02,170 --> 00:31:03,590
.لقد فقدته

402
00:31:05,820 --> 00:31:07,380
!شيروها! انتبهي لكلماتك

403
00:31:07,380 --> 00:31:09,010
...مهلاً أيّها الفتية

404
00:31:09,010 --> 00:31:10,870
!كـ-كلاّ، لا تنظري إلينا هكذا

405
00:31:10,870 --> 00:31:13,030
...فتيات لجنة المدرسة

406
00:31:13,030 --> 00:31:14,180
...إعدام دون محاكمة

407
00:31:17,900 --> 00:31:18,850
.خذا هذه

408
00:31:21,390 --> 00:31:22,430
!إنّها باردة

409
00:31:22,430 --> 00:31:25,280
.أحتفظ بها باردة من باب الحيطة

410
00:31:25,630 --> 00:31:26,610
.شيروها

411
00:31:27,150 --> 00:31:30,450
.استعيدي كرامتك المسلوبة بيديك

412
00:31:32,830 --> 00:31:33,740
...والآن

413
00:31:34,450 --> 00:31:36,620
.حان الوقت لنبدأ صيد الرّجال

414
00:31:36,620 --> 00:31:38,680
!العدالة لأعداء المرأة

415
00:31:38,680 --> 00:31:40,330
.سنحصل عليها الآن

416
00:31:43,590 --> 00:31:45,670
!هذا مؤلم! وبارد

417
00:31:45,670 --> 00:31:46,920
!لا، توقّفن

418
00:31:46,920 --> 00:31:50,720
صقلتُ رؤيتي الحركيّة إلى حدّ
!الكمال من خلال لعبة كرة الطّاولة

419
00:31:52,860 --> 00:31:55,240
!كلاّ! ليس في وجهي يا شيروها

420
00:31:55,240 --> 00:31:56,940
!لا يمكنني التّنفّس! لا يمكنني التّنفّس

421
00:31:56,940 --> 00:31:57,560
!اقضيا عليه

422
00:32:02,270 --> 00:32:04,650
.انتقمت لك

423
00:32:09,370 --> 00:32:10,350
.شيروها

424
00:32:12,330 --> 00:32:13,420
.لقد نجحنا

425
00:32:13,420 --> 00:32:14,770
.حقّقنا الفوز

426
00:32:14,770 --> 00:32:15,620
!انتصرنا

427
00:32:19,370 --> 00:32:23,960
،من اللّطيف أن نجتمع معًا
.بما في ذلك الأغبياء

428
00:32:23,960 --> 00:32:25,060
.نعم

429
00:32:25,060 --> 00:32:27,500
.مرّ وقت طويل مذ قضينا الوقت مع شيروها

430
00:32:27,500 --> 00:32:28,300
.كان هذا ممتعًا

431
00:32:32,140 --> 00:32:34,680
.لـ-لم يكن ممتعًا أو ما شابه

432
00:32:38,560 --> 00:32:39,640
شيروها؟

433
00:32:54,840 --> 00:32:57,410
.صحيح، لقد نلتِ منّي جيّدًا البارحة

434
00:32:59,660 --> 00:33:01,830
لكن استمتعنا بوقتنا، صحيح؟

435
00:33:05,590 --> 00:33:09,250
هل أنتِ بخير تحت الشّمس؟
.كنتِ هنا البارحة أيضًا

436
00:33:10,810 --> 00:33:13,010
...بخصوص مثلّجات البطّيخ البارحة

437
00:33:14,320 --> 00:33:15,140
!شيروها

438
00:33:21,110 --> 00:33:23,940
لماذا بقيتِ في الخارج حتّى
وصلتِ إلى هذه الحالة؟

439
00:33:24,630 --> 00:33:26,080
.كنتُ أُجري تجربة

440
00:33:26,080 --> 00:33:27,770
تجربة؟ من أيّ نوع؟

441
00:33:28,300 --> 00:33:29,510
.رأيت ذلك

442
00:33:29,960 --> 00:33:31,650
.كنت أعلم أنّني سأكون بخير

443
00:33:31,650 --> 00:33:35,030
.كنتُ أعلم أنّ أحدًا ما سيأتي لمساعدتي

444
00:33:35,030 --> 00:33:37,430
رأيتِ ماذا؟ وكيف عرفتِ؟

445
00:33:37,970 --> 00:33:39,550
.أنا بخير الآن

446
00:33:40,070 --> 00:33:41,130
.أنزلني

447
00:33:46,250 --> 00:33:48,330
مهلاً، هل تسمعني؟

448
00:33:48,330 --> 00:33:50,420
.لا. ابقي كما أنتِ

449
00:33:50,790 --> 00:33:51,880
.أنا حقًّا بخير

450
00:33:51,880 --> 00:33:53,530
.لقد أقلقتِني

451
00:33:58,180 --> 00:33:59,290
.آسفة

452
00:34:00,580 --> 00:34:02,710
.شكرًا يا هايري

453
00:34:03,130 --> 00:34:03,840
.العفو

454
00:34:05,810 --> 00:34:07,310
ناروسي

455
00:34:13,090 --> 00:34:13,710
.مرحبًا

456
00:34:14,360 --> 00:34:15,930
هل لديك بعض الوقت؟

457
00:34:17,270 --> 00:34:22,120
لطالما احتفظت شيروها بمسافة
.بينها وبيننا منذ أن كنا صغارًا

458
00:34:22,120 --> 00:34:25,710
.ومع ذلك، كنّا نتسكّع سويًّا

459
00:34:25,710 --> 00:34:27,750
.مثلما فعلنا البارحة

460
00:34:27,970 --> 00:34:31,720
.ثمّ حدث شيء ما قبل أربع سنوات

461
00:34:31,720 --> 00:34:33,880
...بدأ أحد زملائنا في الصّفّ يقول

462
00:34:33,880 --> 00:34:37,640
.أنّ شيروها ستلعننا وتقتلنا

463
00:34:37,640 --> 00:34:40,290
تلعن؟ وتقتل؟

464
00:34:40,290 --> 00:34:43,270
.في الواقع، سقط ذلك الفتى من على جرف

465
00:34:43,270 --> 00:34:45,810
...نجا بأعجوبة، لكن

466
00:34:48,820 --> 00:34:52,280
.كانت شيروها هناك حين حصل ذلك

467
00:34:52,280 --> 00:34:54,710
.لا بدّ أن ذلك كان مجرّد صدفة وحادث

468
00:34:54,710 --> 00:34:56,990
.نعمّ، هذا ما قد تظنّه عادةً

469
00:34:56,990 --> 00:35:01,160
...لكن في الحقيقة، إنّ عائلة شيروها

470
00:35:02,470 --> 00:35:05,690
.يُدعى هذا المكان ضريح ناروسي

471
00:35:05,690 --> 00:35:06,960
...ناروسي

472
00:35:06,960 --> 00:35:08,080
!ناروسي؟

473
00:35:08,080 --> 00:35:11,710
،إنّها الآن فتاة عاديّة في الجزيرة
،لكن في السّابق

474
00:35:08,080 --> 00:35:19,360
ضريح ناروسي

475
00:35:11,710 --> 00:35:15,670
كانت عائلتها مسؤولة عن كلّ
.الطّقوس والمهرجانات في الجزيرة

476
00:35:15,670 --> 00:35:19,340
ما زال النّاس الّذين يؤمنون بالخرافات
.يعاملونها بشكل مختلف

477
00:35:19,340 --> 00:35:23,170
إذًا لديهم نسب خاصّ؟
هل كنّ كاهنات في الضّريح؟

478
00:35:23,170 --> 00:35:24,600
.يمكن قول ذلك

479
00:35:24,600 --> 00:35:27,320
.جلبوا معهم الخير والشّرّ معًا

480
00:35:27,320 --> 00:35:31,690
لذلك كان هناك تفاهم ضمنيّ
.بعدم التّورّط معهم كثيرًا

481
00:35:32,310 --> 00:35:34,420
ألهذا السّبب طلبت منّي الابتعاد؟

482
00:35:36,610 --> 00:35:37,650
.لا

483
00:35:38,660 --> 00:35:43,370
،قد لا نكون قريبين لبعض بما يكفي
.لكنّنا جميعًا أصدقاءُ طفولة

484
00:35:43,370 --> 00:35:47,120
،ورغم أنّنا التقينا بك حديثًا فحسب
.نعتبرك صديقًا أيضًا

485
00:35:47,430 --> 00:35:49,950
.ربّما أنت تربكها فحسب

486
00:35:49,950 --> 00:35:52,760
.تبدو كسابق عهدها قليلاً وهي معك

487
00:35:52,760 --> 00:35:55,090
...ليس من حقّنا قول هذا، لكن

488
00:35:55,090 --> 00:35:56,890
هل يمكنك أن تعتني بشيروها؟

489
00:35:56,890 --> 00:35:58,800
بقدر المستطاع بالطّبع؟

490
00:35:59,730 --> 00:36:02,110
...ريويتشي، تنزن

491
00:36:04,530 --> 00:36:06,470
.نعم، بالطّبع

492
00:36:12,140 --> 00:36:14,270
!لنأكل

493
00:36:24,160 --> 00:36:25,800
!هذا لذيذ

494
00:36:31,730 --> 00:36:33,210
!المزيد رجاءً

495
00:36:33,720 --> 00:36:36,500
.سـ-سأغلي المزيد. انتظرا لحظة

496
00:36:46,510 --> 00:36:48,190
.لقد غطّت في النّوم

497
00:36:48,190 --> 00:36:50,120
.وبمعدة ممتلئة سعيدة أيضًا

498
00:36:55,120 --> 00:36:57,700
هـ-هل أنتما شقيقان؟

499
00:36:57,700 --> 00:37:00,000
.لا، الأمر ليس كذلك

500
00:37:00,000 --> 00:37:01,270
.هكذا إذًا

501
00:37:01,270 --> 00:37:04,040
.تبدوان متشابهين نوعًا ما

502
00:37:04,040 --> 00:37:06,800
.نعم، نحن أقرباء في النّهاية

503
00:37:07,310 --> 00:37:09,170
.على أيّ حال، كان هذا مفاجئًا بالفعل

504
00:37:10,750 --> 00:37:12,610
هل أنت حبيبته؟

505
00:37:12,610 --> 00:37:14,470
.ليست حبيبتي

506
00:37:12,610 --> 00:37:14,470
.لستُ حبيبته

507
00:37:15,180 --> 00:37:17,720
.لم أتوقّع أبدًا أن تمرّي علينا

508
00:37:17,720 --> 00:37:21,900
أتيتُ فقط لشكرك لإيصالي
.إلى المنزل البارحة

509
00:37:21,900 --> 00:37:24,590
.لم أعتقد أنّ الأمر سينتهي بي بإعداد الغداء

510
00:37:24,590 --> 00:37:28,980
آسف، أردتُ أن تجرّب
.أومي-تشان طبخك فحسب

511
00:37:28,980 --> 00:37:30,270
.أعتذر عن ذلك

512
00:37:30,270 --> 00:37:32,490
.لا بأس. كان هذا ممتعًا

513
00:37:33,160 --> 00:37:36,080
لم أزر مكانًا يعجّ بالحياة هكذا
.منذ وقت طويل

514
00:37:39,890 --> 00:37:40,330
...أخبريني

515
00:37:40,330 --> 00:37:41,960
.حسنًا، سأغادر الآن

516
00:37:42,470 --> 00:37:46,500
.بقاؤك بقربي سيجلب لك المتاعب

517
00:37:47,390 --> 00:37:53,100
لأنّك كاهنة مقدّسة في هذه
الجزيرة أو ما شابه؟

518
00:37:53,100 --> 00:37:57,080
ألهذا السّبب تحاولين إبعاد الجميع عنك؟

519
00:37:57,080 --> 00:37:58,650
.حسنًا، وداعًا

520
00:38:00,330 --> 00:38:01,270
.مهلاً

521
00:38:02,910 --> 00:38:04,030
...اسمعي

522
00:38:04,910 --> 00:38:07,410
أتريدين قضاء الوقت معًا غدًا؟

523
00:38:15,070 --> 00:38:18,700
!الحركة الخاصّة: بوكيشوهاتو

524
00:38:24,500 --> 00:38:28,440
كانت ضربتي الخاصّة أقوى ممّا
.يمكن للطّاولة تحمّله

525
00:38:33,630 --> 00:38:35,070
ما الّذي يهذي به هذا الأحمق؟

526
00:38:35,070 --> 00:38:37,230
على أيّ حال، ماذا سنفعل الآن بشأن هذا؟

527
00:38:37,230 --> 00:38:40,280
.حسنًا، لدينا خيارات كثيرة غير كرة الطّاولة

528
00:38:40,280 --> 00:38:41,480
صحيح يا شيروها؟

529
00:38:42,360 --> 00:38:44,440
...حسنًا، سأستأذن

530
00:38:44,440 --> 00:38:45,890
!مهلاً لحظة

531
00:38:45,890 --> 00:38:47,650
!سبق وأتيتِ إلى هنا

532
00:38:47,950 --> 00:38:49,710
.لا مشكلة

533
00:38:49,710 --> 00:38:54,610
سبق وتوسّلتُ توكودا ورتّبتُ
.معه لإحضار طاولة جديدة

534
00:38:55,090 --> 00:38:56,340
توكودا؟

535
00:38:56,340 --> 00:38:58,580
ابن صاحب متجر الأدوات
.الرّياضيّة في الجزيرة

536
00:38:58,580 --> 00:39:01,610
.ولكن هنالك مشكلة واحدة

537
00:39:01,610 --> 00:39:02,620
وما هي؟

538
00:39:03,760 --> 00:39:05,120
.لا أملك مالاً

539
00:39:07,770 --> 00:39:12,010
لذلك السّبب علينا جني بعض
.المال في أسرع وقت

540
00:39:12,010 --> 00:39:14,340
ما الأجر الّذي تتقاضينه يا أوُ؟

541
00:39:14,340 --> 00:39:16,050
.مخلّل جدّتي

542
00:39:16,370 --> 00:39:18,190
.إنّه يُخلّل منذ مائتَيْ سنة

543
00:39:18,190 --> 00:39:20,350
!إنّه الأفضل على الإطلاق

544
00:39:20,350 --> 00:39:22,280
أسلوب المقايضة؟

545
00:39:22,280 --> 00:39:25,730
نوميكي، مسدّساتك المائيّة
من تصميم خاصّ، صحيح؟

546
00:39:26,080 --> 00:39:28,230
مؤكّد أنّ لها قيمة لا بأس بها، أليس كذلك؟

547
00:39:29,870 --> 00:39:33,230
إنّها خطيرة للغاية. كيف لي أن أبيعها؟

548
00:39:34,090 --> 00:39:36,510
ومع ذلك كنتِ تطلقين علينا بها
طوال هذا الوقت؟

549
00:39:36,510 --> 00:39:37,530
...عفوًا

550
00:39:38,570 --> 00:39:39,480
!كلاّ

551
00:39:40,410 --> 00:39:41,480
...عفوًا

552
00:39:41,480 --> 00:39:43,760
.توجد أكشاك طعام في الميناء

553
00:39:43,760 --> 00:39:46,060
.تبيع الياكيسوبا وما شابه

554
00:39:46,060 --> 00:39:51,490
.فكّرتُ في أنّه يمكننا القيام بذلك أيضًا

555
00:39:53,630 --> 00:39:54,950
!تبدو فكرة جيّدة

556
00:39:56,250 --> 00:39:58,470
.سيُباع طبخ شيروها بسرعة كبيرة

557
00:39:59,390 --> 00:40:00,710
!يبدو هذا ممتعًا

558
00:40:00,710 --> 00:40:02,220
.اعتبروا الأمر أشبه بمهرجان مدرسيّ

559
00:40:02,220 --> 00:40:05,920
!لكن ستكون هنالك منافسة أقلّ في المقابل

560
00:40:05,920 --> 00:40:08,030
.بإمكاننا استعارة عربة من البلديّة

561
00:40:08,030 --> 00:40:10,600
ثمّة العديد من المكوّنات
.في أرجاء الجزيرة أيضًا

562
00:40:10,600 --> 00:40:11,230
...لكن

563
00:40:11,230 --> 00:40:14,150
.سنعتمد عليك كطبّاختنا يا شيروها

564
00:40:14,150 --> 00:40:15,130
لا تمانعين، صحيح؟

565
00:40:18,250 --> 00:40:20,740
.سـ-سأبذل جهدي

566
00:40:49,830 --> 00:40:53,400
باييّا

567
00:40:54,760 --> 00:40:56,490
!باييّا على أسلوب توريشيروجيما

568
00:40:56,490 --> 00:40:58,170
!إنّه يوم افتتاحنا الكبير

569
00:40:57,860 --> 00:41:01,510
اصطفّوا هنا

570
00:40:58,170 --> 00:41:01,280
!من الصّعب تناول الباييّا على الجزيرة

571
00:41:01,280 --> 00:41:03,660
!يبدأ صفّ الانتظار هنا

572
00:41:06,380 --> 00:41:07,710
.تفضّلوا طلبكم

573
00:41:07,710 --> 00:41:08,870
.حسنًا، شكرًا

574
00:41:09,440 --> 00:41:11,010
.شكرًا جزيلاً لك

575
00:41:11,490 --> 00:41:12,850
.مرحبًا

576
00:41:12,850 --> 00:41:14,170
.أريد ثلاثة رجاءً

577
00:41:14,170 --> 00:41:15,800
.المجموع هو 1500 ينّ

578
00:41:16,130 --> 00:41:18,110
.سينتهي منّا الأرزّ قريبًا

579
00:41:18,110 --> 00:41:19,300
.مفهوم

580
00:41:26,120 --> 00:41:27,680
ما معنى هذا؟

581
00:41:27,680 --> 00:41:29,670
ماذا تريدون منّي أن أقوله؟

582
00:41:29,670 --> 00:41:31,060
.سأعطيكم الطّاولة

583
00:41:31,510 --> 00:41:33,070
.لكن لا أريد مالكم

584
00:41:33,070 --> 00:41:35,190
.ليس إن كانت شيروها متورّطة في الأمر

585
00:41:35,190 --> 00:41:36,650
...توكودا

586
00:41:37,140 --> 00:41:39,400
هل أنت مغرم بشيروها؟

587
00:41:40,670 --> 00:41:41,950
.الأمر ليس كذلك

588
00:41:41,950 --> 00:41:45,850
عائلة ناروسي هي السّبب في أنّنا
.قادرون على العمل في هذه الجزيرة

589
00:41:45,850 --> 00:41:48,080
.ولهذا نرفض أخذ المال منهم

590
00:41:48,410 --> 00:41:50,210
.هذه هي قاعدتنا

591
00:41:52,480 --> 00:41:56,010
!مرحبًا في قاعدتنا السّرّيّة

592
00:42:00,540 --> 00:42:03,860
بالمناسبة، بخصوص المال الّذي
...لم نستخدمه في النّهاية

593
00:42:03,860 --> 00:42:06,290
.أعتقد أنّ شيروها تستحقّه

594
00:42:06,290 --> 00:42:07,940
!موافقون

595
00:42:08,940 --> 00:42:13,730
في الحقيقة، شيروها هي من جنت
.المال ووفّرت لنا الطّاولة

596
00:42:14,120 --> 00:42:16,770
.لا أحتاج إليه. لن أستعمله أبدًا

597
00:42:17,210 --> 00:42:19,960
.صحيح. ليس على هذه الجزيرة على أيّ حال

598
00:42:19,960 --> 00:42:22,460
ما رأيك أن تذهبين للجزيرة الرّئيسيّة إذًا؟

599
00:42:22,460 --> 00:42:26,780
.نعم! قد تعثرين على شيء ما تريدينه هناك

600
00:42:26,780 --> 00:42:28,820
...الجزيرة الرّئيسيّة

601
