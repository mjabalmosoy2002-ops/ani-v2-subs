1
00:00:30,920 --> 00:00:33,640
.أستفيق فجأة

2
00:00:34,510 --> 00:00:36,870
.يمتدّ أمامي حقل واسع على مدّ البصر

3
00:00:37,660 --> 00:00:43,580
.إلى جانب ظلّي، يهتزّ خيال ليس بظلّي

4
00:00:44,640 --> 00:00:45,960
...هذا صحيح

5
00:00:45,960 --> 00:00:47,770
.جئت إلى هنا لألعب

6
00:00:48,880 --> 00:00:52,280
.يمسك ظلّي بيد ذلك الخيال

7
00:00:53,570 --> 00:00:57,350
.نخطو معًا إلى قلب الحقل الفسيح

8
00:01:03,890 --> 00:01:05,230
...مرّة أخرى

9
00:01:27,730 --> 00:01:32,780
جيوب صيف

10
00:02:58,900 --> 00:03:00,550
مرحبًا؟

11
00:03:01,480 --> 00:03:03,550
!استيقظ

12
00:03:03,550 --> 00:03:04,940
!هيّا

13
00:03:05,410 --> 00:03:07,260
!مرحبًا

14
00:03:12,020 --> 00:03:13,520
.استيقظت أخيرًا

15
00:03:13,780 --> 00:03:17,280
عليك أن تبدأ بالاستيقاظ
.وحدك يا هايري-سان

16
00:03:17,280 --> 00:03:19,070
.صباح الخير أومي-تشان

17
00:03:19,070 --> 00:03:21,880
.أسرع. سيبرد الطّعام

18
00:03:24,410 --> 00:03:27,330
هل كانت أومي-تشان تتكلّم هكذا دائمًا؟

19
00:03:27,330 --> 00:03:31,830
.لحظة... قابلتها البارحة فقط
ما الّذي أقوله؟

20
00:03:37,650 --> 00:03:39,070
.لنأكل

21
00:03:44,860 --> 00:03:46,330
...ليس لذيذًا

22
00:03:46,330 --> 00:03:48,620
.بإمكانك أخذ استراحة إن أردت

23
00:03:51,550 --> 00:03:54,630
.سأطلب مساعدتك في الكوخ لاحقًا

24
00:03:55,200 --> 00:03:57,470
لماذا لا تستمتع بالجزيرة؟

25
00:03:57,470 --> 00:03:59,970
.قد تقابل شخصًا مميّزًا

26
00:04:03,240 --> 00:04:06,360
شخصًا مميّزًا؟

27
00:04:13,940 --> 00:04:16,850
إنّها نائمة فقط، صحيح؟

28
00:04:20,460 --> 00:04:21,760
...لا

29
00:04:21,760 --> 00:04:23,810
لماذا المكان آمن جدًّا هنا؟

30
00:04:28,130 --> 00:04:29,110
كلب؟

31
00:04:34,670 --> 00:04:35,460
!كوني حذرة

32
00:04:48,410 --> 00:04:49,610
...عفوًا

33
00:04:51,210 --> 00:04:52,270
.صباح الخير

34
00:04:53,250 --> 00:04:55,040
!مـ-مـ-من أنت؟

35
00:04:55,040 --> 00:04:57,280
!لماذا تمسك بي؟

36
00:04:58,260 --> 00:05:01,050
هـ-هل تحاول أن تشبع رغبتك بي؟

37
00:05:01,050 --> 00:05:03,610
!أرجوك أن تبدأ ببطء

38
00:05:03,610 --> 00:05:06,230
إذًا فبإمكاني التّصرّف بعنف في النّهاية؟

39
00:05:06,230 --> 00:05:08,240
!بالطّبع لا

40
00:05:12,950 --> 00:05:14,930
تاكاهارا هايري؟

41
00:05:14,930 --> 00:05:16,210
.اسم غريب

42
00:05:16,210 --> 00:05:18,460
.لومي والداي على ذلك

43
00:05:18,460 --> 00:05:20,570
هل تقوم بترتيب أغراض جدّتك؟

44
00:05:20,570 --> 00:05:22,780
ستكون هنا لوقت طويل إذًا؟

45
00:05:22,780 --> 00:05:23,910
.لبعض الوقت

46
00:05:24,890 --> 00:05:27,650
أمن الضّروريّ أن تُظهري
كلّ هذا النّفور منّي؟

47
00:05:27,650 --> 00:05:29,720
.لا أتمتّع بقدر كبير من الأمان العاطفيّ

48
00:05:29,720 --> 00:05:31,760
كيف لا أُظهر نفورًا منك؟

49
00:05:31,760 --> 00:05:34,150
.هاجمتني أثناء نومي

50
00:05:34,150 --> 00:05:35,300
.لم أهاجمك أبدًا

51
00:05:35,300 --> 00:05:39,170
.على أيّ حال، دعني وشأني إن رأيتني نائمة

52
00:05:39,940 --> 00:05:41,290
!سُحقًا

53
00:05:41,290 --> 00:05:42,330
!إنّها الثّانية

54
00:05:42,330 --> 00:05:43,980
!تأخّرتُ عن العمل

55
00:05:44,560 --> 00:05:46,250
!إيناري! هيّا بنا

56
00:05:46,250 --> 00:05:47,020
!بون

57
00:05:52,130 --> 00:05:53,370
إنّها الثّانية؟

58
00:05:56,450 --> 00:05:58,230
كيف عرفت ذلك؟

59
00:06:03,050 --> 00:06:05,070
.لا أتعرّف عليه

60
00:06:06,920 --> 00:06:11,300
،"إذًا فلا بدّ أنّه "تاكا الصّادم
!المضيف الّذي فقد سحره

61
00:06:11,300 --> 00:06:12,200
!ماذا؟

62
00:06:12,200 --> 00:06:14,630
.سمعت أنّ هذا اسمك المهنيّ

63
00:06:14,630 --> 00:06:15,330
!ممّن سمعتِ؟

64
00:06:15,690 --> 00:06:17,210
!من الجدّة كيدو

65
00:06:19,530 --> 00:06:22,590
من المضيف الّذي فقد سحره؟

66
00:06:23,050 --> 00:06:24,190
!العجوز من العبّارة

67
00:06:26,120 --> 00:06:28,010
.تاكاهارا هايري-كُن

68
00:06:28,500 --> 00:06:32,710
تاكاهارا هايري-كُن الّذي وصل
،إلى الجزيرة منذ أوّل البارحة

69
00:06:32,710 --> 00:06:34,350
.تفضّل بالحضور إلى المكتب

70
00:06:34,350 --> 00:06:35,950
ماذا؟ أنا؟

71
00:06:35,950 --> 00:06:38,550
.إنّها تناديك يا تاكا الصّادم

72
00:06:38,550 --> 00:06:40,690
ما الّذي تورّطت فيه يا تاكا الصّادم؟

73
00:06:40,690 --> 00:06:43,290
.لا ينبغي أن تُبقيها تنتظر يا تاكا الصّادم

74
00:06:43,290 --> 00:06:45,700
هلاّ توقّفتنّ عن مناداتي بهذا الاسم؟

75
00:06:47,750 --> 00:06:50,220
حفلة ترحيب؟

76
00:06:50,220 --> 00:06:50,910
من أجلي؟

77
00:06:50,910 --> 00:06:56,170
نطلق على الزّائرين الدّائمين
.للجزيرة اسم المهاجرين

78
00:06:56,170 --> 00:06:58,120
.من عاداتنا التّرحيب بأشخاص مثلك

79
00:06:58,120 --> 00:07:00,490
.لذلك دعنا نقوم بهذا من أجلك فحسب

80
00:07:00,490 --> 00:07:03,020
.تُكرم جزيرتنا توريشيروجيما ضيوفها

81
00:07:03,400 --> 00:07:05,730
.اخرس وارتدِ ملابسك

82
00:07:09,630 --> 00:07:14,350
عفوًا، هل يمكنني أن أحضر شخصًا
آخر معي إلى هذه الحفلة؟

83
00:07:14,740 --> 00:07:16,010
.لا بأس في ذلك

84
00:07:16,010 --> 00:07:19,830
.يُعدّ كلّ من في الجزيرة عائلة

85
00:07:19,830 --> 00:07:21,270
عذرًا؟

86
00:07:21,270 --> 00:07:25,090
.ولماذا قد أذهب؟ اذهب وحدك

87
00:07:25,090 --> 00:07:26,540
.لا تقولي هذا

88
00:07:26,540 --> 00:07:29,110
.هيّا لنتعرّف أكثر على أهل الجزيرة

89
00:07:35,760 --> 00:07:39,500
محجوز

90
00:07:37,390 --> 00:07:39,500
.مرحبًا بكما في جزيرة توريشيروجيما

91
00:07:39,500 --> 00:07:42,660
!مرحبًا بكما في جزيرة توريشيروجيما

92
00:07:42,660 --> 00:07:43,670
.أهلاً بكما

93
00:07:46,920 --> 00:07:48,280
.سررت بلقائكما

94
00:07:48,280 --> 00:07:49,980
.أنا سوراكادو أوُ

95
00:07:49,980 --> 00:07:51,340
!مهلاً، هذا أنت

96
00:07:51,340 --> 00:07:53,790
ماذا؟ هل تعرفان بعضكما؟

97
00:07:53,790 --> 00:07:56,250
!كان يحاول التّقرّب منّي وأنا نائمة

98
00:07:56,250 --> 00:07:56,930
فعلاً؟

99
00:07:56,930 --> 00:07:57,740
.رائع

100
00:07:59,050 --> 00:08:00,560
.لا، لم أفعل

101
00:08:00,560 --> 00:08:03,060
!لكنّك أمسكت بي

102
00:08:03,060 --> 00:08:04,140
فعلاً؟

103
00:08:04,140 --> 00:08:05,150
!رائع

104
00:08:06,020 --> 00:08:09,060
...ربّما تصرّفت بخشونة في النّهاية

105
00:08:09,060 --> 00:08:10,880
!كان عليك أن تكون أكثر لطفًا

106
00:08:10,880 --> 00:08:11,850
فعلاً؟

107
00:08:11,850 --> 00:08:12,990
.رائع

108
00:08:15,760 --> 00:08:18,160
!لم يكن رائعًا

109
00:08:18,160 --> 00:08:19,980
.أنتما منسجمان تمامًا

110
00:08:19,980 --> 00:08:24,000
كما لو كنتما ثنائيًّا في مباراة زوجٍ
.مختلطٍ تلعبان سويًّا منذ سنوات

111
00:08:24,000 --> 00:08:25,110
ومن هذه؟

112
00:08:25,110 --> 00:08:26,740
.إنّها قريبتي

113
00:08:26,740 --> 00:08:28,440
.نقيم في نفس المنزل

114
00:08:33,490 --> 00:08:34,780
.أنا كاتو أومي

115
00:08:34,780 --> 00:08:36,160
.أتيتُ بهذا للجميع

116
00:08:36,160 --> 00:08:37,700
أرزّ مقليّ؟

117
00:08:37,700 --> 00:08:38,880
.كم أنت مهذّبة

118
00:08:38,880 --> 00:08:40,650
لا يسعني الانتظار لرؤية
.ما ستغدين عليه حين تكبرين

119
00:08:42,110 --> 00:08:42,980
ما الأمر؟

120
00:08:43,610 --> 00:08:44,660
.لا شيء

121
00:08:44,660 --> 00:08:46,080
.لا شيء إطلاقًا

122
00:09:08,480 --> 00:09:09,890
.شبعتُ تمامًا

123
00:09:09,890 --> 00:09:11,810
.هاك، بعض الماء

124
00:09:11,810 --> 00:09:13,500
.شكرًا يا سوراكادو

125
00:09:13,980 --> 00:09:15,350
.نادني أوُ

126
00:09:16,430 --> 00:09:18,470
.إنّهم جماعة مليئة بالحيويّة والمرح

127
00:09:19,090 --> 00:09:21,600
.نعرف بعضنا منذ الطّفولة

128
00:09:21,600 --> 00:09:23,910
ونحن أيضًا نكوّن ما يُشبه
.رابطة شباب في الجزيرة

129
00:09:23,910 --> 00:09:26,280
.لم يكن هناك شيء كهذا في مدينتي

130
00:09:26,280 --> 00:09:27,800
.أشعر بشيء من الغيرة

131
00:09:27,800 --> 00:09:31,280
يمكنك الانضمام إلى رابطة
.الشّباب ما دمت هنا

132
00:09:31,280 --> 00:09:34,720
.يكفي أنّك من أقرباء الجدّة كاتو لتكون مؤهّلاً

133
00:09:36,410 --> 00:09:37,780
فعلاً؟

134
00:09:37,780 --> 00:09:39,260
.يبدو ذلك لطيفًا

135
00:09:47,940 --> 00:09:50,530
.لم تكوني بحاجة لمرافقتنا للمنزل

136
00:09:50,530 --> 00:09:54,850
ما الّذي تقوله؟ ماذا إن ضعتما؟

137
00:09:54,850 --> 00:09:56,400
.ما أحنّك

138
00:09:56,400 --> 00:09:58,860
.لا أريد أن يحدث هذا لأومي-تشان

139
00:09:58,860 --> 00:10:01,390
.نعم... معك حقّ

140
00:10:01,390 --> 00:10:04,870
،حين أضع أومي-تشان في سريرها
.سأرافقك أنا إلى بيتك

141
00:10:04,870 --> 00:10:06,870
.لا حاجة لذلك إطلاقًا

142
00:10:06,870 --> 00:10:10,650
.نشأتُ في هذه الجزيرة
.لا يمكن أن أضيع

143
00:10:10,650 --> 00:10:14,070
أعني أنّك فتاة، ولا يصحّ
.أن تتجوّلي ليلاً وحدك

144
00:10:15,110 --> 00:10:16,960
.شكرًا لك

145
00:10:16,960 --> 00:10:19,760
.لكن لا مكان أكثر أمانًا من هذه الجزيرة

146
00:10:20,180 --> 00:10:21,300
إنّها آمنة إذًا؟

147
00:10:21,920 --> 00:10:23,470
.بكلّ تأكيد

148
00:10:37,570 --> 00:10:38,720
...طعمه حلو

149
00:10:38,720 --> 00:10:41,400
.لا شكّ أنّها أخطأت بين السّكّر والملح

150
00:10:41,400 --> 00:10:44,000
.مهلاً لحظة، لعلّه أعظم ما صنعت

151
00:10:44,000 --> 00:10:47,420
.قد يكون ثورة في عالم الأرزّ المقليّ

152
00:10:49,250 --> 00:10:50,560
!أو لا

153
00:10:51,350 --> 00:10:53,650
هلاّ ناولتني صلصة الصّويا يا أبي؟

154
00:10:53,650 --> 00:10:54,430
ماذا؟

155
00:10:55,880 --> 00:10:57,760
.لم أقصد أن أناديك بذلك

156
00:10:58,040 --> 00:10:59,090
.لا بأس

157
00:10:59,410 --> 00:11:01,990
الأمر أشبه بمناداة المعلّمة
.بـ"أمّي" عن طريق الخطأ

158
00:11:01,990 --> 00:11:04,270
صـ-صحيح. يحدث ذلك كثيرًا، صحيح؟

159
00:11:22,490 --> 00:11:23,840
كلّ هذا بمائة ينّ فقط؟

160
00:11:23,840 --> 00:11:27,490
نكهات الفراولة والبطّيخ واللّيمون
...وهاواي الأزرق

161
00:11:27,490 --> 00:11:29,630
.كلّها بنفس الطّعم في النّهاية

162
00:11:29,630 --> 00:11:30,440
!حقًّا؟

163
00:11:30,440 --> 00:11:33,210
.تعال وتناوله في غرفة الجلوس هناك

164
00:11:33,210 --> 00:11:36,310
.لديّ مروحة. المكان بارد في الدّاخل

165
00:11:36,570 --> 00:11:39,070
.حسنًا، شكرًا. أقدّر لك ذلك

166
00:11:58,300 --> 00:12:01,710
.اسمعي... أنا أرتاد مدرسة للأولاد فقط

167
00:12:01,710 --> 00:12:05,390
لستُ معتادًا على رؤية فتيات
.يرتدين ملابس قليلة

168
00:12:05,390 --> 00:12:07,490
.لكن قد يكون هذا إشارة

169
00:12:07,490 --> 00:12:11,300
ربّما يمكن أن تساعديني لأتأقلم؟

170
00:12:12,080 --> 00:12:13,530
!ما-ما الّذي تعنيه بذلك؟

171
00:12:13,530 --> 00:12:15,170
هل تطلب منّي أن أخلع ملابسي؟

172
00:12:15,170 --> 00:12:20,070
!تريدني شبه عارية فقط لتثير رغباتك؟

173
00:12:21,940 --> 00:12:25,310
،تبلّل ملابسي عن قصد، ثم تلعقه بشهوة

174
00:12:25,310 --> 00:12:27,780
...وتسقطني أرضًا ثمّ تعتلي جسدي

175
00:12:27,780 --> 00:12:31,540
صحيح أنّني لستُ غير مهتمّة
...بالأولاد تمامًا، لكن

176
00:12:31,540 --> 00:12:33,820
.يا إلهي، لدينا مشكلة

177
00:12:33,820 --> 00:12:36,570
.يبدو أنهّا ليست معارضة تمامًا للفكرة

178
00:12:37,110 --> 00:12:37,950
...بالمناسبة

179
00:12:37,950 --> 00:12:38,420
!ماذا؟

180
00:12:38,700 --> 00:12:40,670
هل يمكنني الحصول على بعض الثّلج المبشور؟

181
00:12:40,670 --> 00:12:43,420
.سكبتُ خاصّتي وما زلت عطشانًا

182
00:12:52,970 --> 00:12:54,700
!لماذا رميتَه عليّ هناك؟

183
00:12:54,700 --> 00:12:55,850
!لا، لا تصوّبي هناك

184
00:12:55,850 --> 00:12:57,430
...أيّها الـ

185
00:12:57,430 --> 00:12:58,480
!مهلاً

186
00:12:59,750 --> 00:13:00,890
...هذا مخيف

187
00:13:11,530 --> 00:13:14,140
.لم أتناول أيّ ثلج مبشور

188
00:13:14,750 --> 00:13:16,650
.لكن كان ذلك ممتعًا نوعًا ما

189
00:13:16,650 --> 00:13:19,430
.أشعر وكأنّني تخلّيت عن وقاري قليلاً وانطلقت

190
00:13:23,130 --> 00:13:26,190
.يبدو هذا مثل الحبّ الأوّل

191
00:13:31,800 --> 00:13:33,600
.الثّلج المبشور هنا لذيذ جدًّا

192
00:13:33,600 --> 00:13:34,740
!بون

193
00:13:38,000 --> 00:13:40,070
ألا تملك ما هو أفضل لتفعله؟

194
00:13:40,070 --> 00:13:43,610
.لا تسمح لي كيوكو-سان بالمساعدة في الكوخ

195
00:13:43,610 --> 00:13:46,240
.كما أنّه ليس لديّ مكان آخر أذهب إليه

196
00:13:46,240 --> 00:13:47,740
!يا معلّمة

197
00:13:47,740 --> 00:13:49,670
!أعطينا تقييمًا

198
00:13:50,820 --> 00:13:53,950
جعلتِ الأطفال ينادونك "معلّمة"؟

199
00:13:53,950 --> 00:13:54,490
ماذا؟

200
00:13:54,810 --> 00:13:57,700
.حسنًا، ذلك لأنّ لديّ معرفة واسعة

201
00:13:57,700 --> 00:14:00,580
بدؤوا ينادونني هكذا
.لأنّني أعلّمهم بعض الأشياء

202
00:14:00,580 --> 00:14:04,860
!مهلاً... لماذا تنظر إليّ بهذه النّظرة الحزينة؟

203
00:14:04,860 --> 00:14:06,510
.لا بأس

204
00:14:06,510 --> 00:14:11,000
يحتاج الجميع لأن يشعروا
.بالتّفوّق بين الحين والآخر

205
00:14:11,000 --> 00:14:12,760
!تاكا الصّادم

206
00:14:12,760 --> 00:14:14,940
هل استعدت سحرك؟

207
00:14:14,940 --> 00:14:18,060
ليس عليك أن تظلّ مضيفًا طوال
.حياتك يا تاكا الصّادم

208
00:14:18,060 --> 00:14:20,190
.أنت لها يا تاكا الصّادم

209
00:14:20,190 --> 00:14:23,410
!إلى أيّ حدّ انتشر هذا اللّقب؟

210
00:14:23,410 --> 00:14:24,480
.لا بأس

211
00:14:25,200 --> 00:14:29,320
يتمنّى الجميع لو كانوا شخصًا آخر
.بين الحين والآخر

212
00:14:29,320 --> 00:14:30,900
!الأمر ليس كذلك

213
00:14:30,900 --> 00:14:33,980
!يا تاكا الصّادم! أتحدّاك في مباراة تقييم

214
00:14:33,980 --> 00:14:36,140
هل يمكنكم على الأقلّ
أن تتوقّفوا عن مناداتي بذلك؟

215
00:14:36,140 --> 00:14:38,250
!ستضطرّ لهزيمتنا أوّلاً

216
00:14:39,310 --> 00:14:43,880
بما أنّني الأكبر سنًّا، فيقع عليّ
.عبء تعليمكم قسوة هذا العالم

217
00:14:43,880 --> 00:14:46,920
!سأتأكّد من أن تكون التّقييمات عادلة

218
00:14:46,920 --> 00:14:49,320
لكن لا أريد أن يبدأ أيّ منكم بالبكاء، مفهوم؟

219
00:14:50,700 --> 00:14:53,590
تاكا الصّادم

220
00:14:50,700 --> 00:14:53,590
روميو

221
00:14:50,700 --> 00:14:53,590
شيغيو

222
00:14:50,700 --> 00:14:53,590
تاكومي

223
00:14:54,540 --> 00:14:57,310
!إلى اللّقاء يا معلّمة

224
00:14:57,310 --> 00:15:00,730
!عليك أن تستعيد سحرك يا تاكا الصّادم

225
00:15:00,730 --> 00:15:03,340
!عُدوا إلى منازلكم سالمين

226
00:15:03,340 --> 00:15:04,610
!حاضر

227
00:15:17,290 --> 00:15:18,800
ماذا؟

228
00:15:18,800 --> 00:15:21,560
.أدركتُ للتّوّ أنّك شخص لطيف

229
00:15:21,560 --> 00:15:25,110
...جلبتَ لي أشياءً غريبة عن قصد لتخسر

230
00:15:25,110 --> 00:15:28,000
.كان ذلك تصرّفًا رائعًا منك

231
00:15:29,610 --> 00:15:30,610
...ربّما معك حقّ

232
00:15:30,610 --> 00:15:33,340
انتظر، هل كنتَ تحاول بجدّ؟

233
00:15:33,790 --> 00:15:36,960
!سـ-سحقًا

234
00:15:56,750 --> 00:15:58,330
هل يمكنني الحصول على واحدة؟

235
00:15:58,330 --> 00:15:59,870
.نعم، تفضّل بذلك

236
00:15:59,870 --> 00:16:01,380
.مهلاً، إنّه هايري

237
00:16:01,380 --> 00:16:01,990
.هذه

238
00:16:01,990 --> 00:16:03,410
.ثمنها 200 ألف ينّ

239
00:16:04,970 --> 00:16:05,550
.تفضّلي

240
00:16:05,990 --> 00:16:09,300
.ما زال ينقصك 199,980 ينّ

241
00:16:09,300 --> 00:16:10,590
.أضيفيها إلى حسابي

242
00:16:13,670 --> 00:16:15,820
لماذا الجميع هنا؟ هل تخطّطون لشيء؟

243
00:16:15,820 --> 00:16:20,470
.نعم، كنّا نتحدّث عن المهرجان القادم

244
00:16:20,470 --> 00:16:22,890
يوجد مهرجان إذًا؟

245
00:16:22,890 --> 00:16:26,900
،لهذه الجزيرة مهرجانان
.مهرجان البحر ومهرجان الجبل

246
00:16:27,180 --> 00:16:29,560
.يجذب مهرجان البحر السّيّاح

247
00:16:29,560 --> 00:16:33,380
.ينبغي أن تحضره ما دمتَ ستبقى للصّيف

248
00:16:33,860 --> 00:16:35,150
وماذا عن مهرجان الجبل؟

249
00:16:35,150 --> 00:16:38,530
.هو أقرب إلى طقس تقليديّ منه إلى مهرجان

250
00:16:38,830 --> 00:16:42,540
،على أيّ حال يا هايري
هل سبق لك زيارة "ستارباكس"؟

251
00:16:42,540 --> 00:16:43,980
.نعم، مرّات قليلة

252
00:16:43,980 --> 00:16:47,120
.يبيعون الآن مزيج فرابوتشينو بمذاق المانغو

253
00:16:48,550 --> 00:16:50,650
!نـ-نحن نعمل هنا

254
00:16:50,650 --> 00:16:52,630
!خذ أحاديثك المثيرة إلى مكان آخر

255
00:16:52,920 --> 00:16:55,460
...كان لديّ شعور منذ البداية، لكن

256
00:16:55,460 --> 00:16:57,090
هل أوُ منحرفة؟

257
00:16:57,090 --> 00:16:59,300
.نعم، إنّها منحرفة

258
00:17:00,150 --> 00:17:02,770
!أ... أ... أنا لستُ منحرفة

259
00:17:03,170 --> 00:17:04,490
.إنّها فقط منحرفة في الخفاء

260
00:17:04,490 --> 00:17:06,180
!لست كذلك

261
00:17:10,920 --> 00:17:12,460
!بون

262
00:17:15,610 --> 00:17:17,900
!تبًّا! لماذا لا أستطيع الفوز؟

263
00:17:17,900 --> 00:17:20,990
!أهذا أقصى ما تقدر عليه يا تنزن؟

264
00:17:22,700 --> 00:17:24,980
.يبدو أن اللّعبة انتهت

265
00:17:24,980 --> 00:17:26,370
.أعتقد أنّني سأعود إلى المنزل

266
00:17:26,850 --> 00:17:28,190
.وأنا أيضًا

267
00:17:28,190 --> 00:17:30,000
.يجب أن أخرج في جولة تفقّديّة على الجزيرة

268
00:17:30,300 --> 00:17:33,550
.يبدو أنّك بدأت تشعر وكأنّك في بيتك مؤخّرًا

269
00:17:33,550 --> 00:17:37,110
.ماذا؟ نعم... المكان مريح نوعًا ما

270
00:17:37,110 --> 00:17:38,010
.فهمت

271
00:17:39,560 --> 00:17:41,930
.إذًا، نعتمد عليك للاعتناء بأوُ

272
00:17:44,030 --> 00:17:46,230
الاعتناء بها؟ كيف؟

273
00:17:53,510 --> 00:17:55,600
.انتهى عملي

274
00:17:55,600 --> 00:17:57,950
.إناري، لنعد إلى المنزل

275
00:17:57,950 --> 00:18:00,650
تبدين مرهقة تمامًا. هل أنت بخير؟

276
00:18:01,630 --> 00:18:02,620
.هايري

277
00:18:05,380 --> 00:18:07,090
.أنا بخير

278
00:18:07,090 --> 00:18:08,970
.إلى اللّقاء

279
00:18:13,910 --> 00:18:16,380
."إذًا هذا ما كانت تعنيه بـ"الاعتناء بها

280
00:18:20,930 --> 00:18:23,070
أوُ، هل أنتِ مستيقظة؟

281
00:18:23,070 --> 00:18:25,570
...اخرس

282
00:18:25,570 --> 00:18:27,060
.كلامك غير واضح تمامًا

283
00:18:28,530 --> 00:18:29,440
!احذري

284
00:18:31,900 --> 00:18:34,570
!ليس هناك أيّ شيء مريب هنا، مفهوم؟

285
00:18:38,930 --> 00:18:39,950
.كم هي جميلة

286
00:18:42,170 --> 00:18:43,030
ماذا؟

287
00:18:43,830 --> 00:18:45,240
."قلتُ "كم هي جميلة

288
00:18:46,660 --> 00:18:48,340
أتمانعين إن لمستها؟

289
00:18:48,340 --> 00:18:50,330
...لـ-لم أفعل هذا من قبل

290
00:18:50,800 --> 00:18:53,450
.كن لطيفًا فحسب

291
00:18:55,480 --> 00:18:57,250
.حسنًا، سأبدأ

292
00:19:00,840 --> 00:19:02,300
.مذهل

293
00:19:02,300 --> 00:19:04,030
.إنّها جميلة بالفعل

294
00:19:04,030 --> 00:19:05,360
.هذه الخرزة الزّجاجيّة

295
00:19:05,950 --> 00:19:07,630
!ليست خرزة زجاجيّة عاديّة

296
00:19:07,630 --> 00:19:09,930
.تُسمّى تونبوداما

297
00:19:09,930 --> 00:19:12,660
!مهلاً، هذا ما كنت تتحدّث عنه؟

298
00:19:13,190 --> 00:19:14,990
!أبعد يديك

299
00:19:14,990 --> 00:19:16,730
.لكنّك قلتِ إنّ بإمكاني لمسها

300
00:19:18,160 --> 00:19:19,450
!ا-اخرس

301
00:19:19,450 --> 00:19:21,530
!فقط لا تلمسها مرّة أخرى

302
00:19:22,210 --> 00:19:23,360
.مفهوم

303
00:19:23,790 --> 00:19:25,660
.على أيّ حال، سأوصلك للمنزل. هيّا بنا

304
00:19:34,470 --> 00:19:36,510
.تبدين مرهقة فعلاً

305
00:19:36,510 --> 00:19:38,080
هل تسهرين ليلاً؟

306
00:19:39,460 --> 00:19:41,760
.بدأت واجباتي

307
00:19:43,680 --> 00:19:45,340
!واجباتك؟

308
00:19:45,340 --> 00:19:46,750
!هل يمكنك إخباري عنها؟

309
00:19:46,750 --> 00:19:49,510
.ليست سرًّا أو ما إلى ذلك

310
00:19:49,510 --> 00:19:54,170
عائلتي مسؤولة عن الطّقوس الجبليّة
.الّتي حدّثتك عنها سابقًا

311
00:19:54,170 --> 00:19:58,940
أيعني ذلك أنّكِ من عائلة كاهنات
!تحمي الجزيرة؟

312
00:19:59,500 --> 00:20:00,940
!ما الّذي تفعلينه تحديدًا؟

313
00:20:00,940 --> 00:20:03,700
،لست أدري ما الّذي تتوقّعه

314
00:20:03,700 --> 00:20:08,320
لكنّي لا أملك قوى خارقة كما
.في المانغا أو شيء من هذا القبيل

315
00:20:09,010 --> 00:20:12,290
كلّ ما في الأمر أنّي أتجوّل في الجبل
.ليلاً وأحمل فانوسًا

316
00:20:13,480 --> 00:20:15,170
.هذا مخيّب للآمال

317
00:20:15,170 --> 00:20:17,100
.يا له من أمر مخيّب

318
00:20:17,100 --> 00:20:20,110
!أنت من أسرف في التّوقّعات
!لا يحقّ لك أن تشعر بخيبة أمل

319
00:20:22,630 --> 00:20:25,840
هل تقوم عائلتك كلّها بهذه الأمور؟

320
00:20:25,840 --> 00:20:27,380
.أنا فقط

321
00:20:27,380 --> 00:20:32,020
لا يُسمح لأحدٍ غيري بالصّعود
.إلى الجبل أثناء الطّقوس

322
00:20:32,020 --> 00:20:33,550
وهل هذا آمن؟

323
00:20:33,550 --> 00:20:36,230
.لن يعلم أحد إن حدث لك شيء

324
00:20:36,530 --> 00:20:37,950
.لا بأس

325
00:20:37,950 --> 00:20:41,730
كما قلتُ لك، لا يوجد مكان
.أكثر أمانًا من هذه الجزيرة

326
00:20:42,030 --> 00:20:46,490
.حسنًا، أظنّ أنّ لا بأس بذلك إن كان هذا رأيك

327
00:20:46,490 --> 00:20:47,870
...هايري

328
00:20:49,800 --> 00:20:52,490
هل وقعتَ في حبّي أو شيء من هذا القبيل؟

329
00:20:52,810 --> 00:20:53,700
.لا، ولا بذرّة واحدة

330
00:20:53,700 --> 00:20:56,350
!قل أنّك أحببتني، حتّى وإن لم تكن تقصد

331
00:20:56,350 --> 00:20:57,610
.حسنًا، أحببتك

332
00:20:58,760 --> 00:21:00,450
فـ-فعلاً؟

333
00:21:00,450 --> 00:21:04,010
لا. أنت من طلبت منّي أن أقولها
.حتّى إن لم أقصدها، فقُلتُها

334
00:21:06,510 --> 00:21:10,130
!أنت تسخر منّي تمامًا

335
00:21:11,260 --> 00:21:13,270
هل يمكنني الحصول على واحدة؟

336
00:21:13,750 --> 00:21:14,880
.تفضّل

337
00:21:14,880 --> 00:21:16,900
.طاب يومك

338
00:21:16,900 --> 00:21:18,810
ألا تعمل أوُ اليوم؟

339
00:21:20,040 --> 00:21:24,610
.لا بدّ أنّها مع أي-تشان اليوم من أجل الفحص

340
00:21:24,970 --> 00:21:26,190
أي-تشان؟

341
00:21:31,100 --> 00:21:33,150
.لم تعد أوُ بعد

342
00:21:41,600 --> 00:21:42,670
!أمسكتك

343
00:21:49,870 --> 00:21:51,330
.هربت منّي

344
00:21:56,460 --> 00:21:57,590
ما هذا؟

345
00:22:00,270 --> 00:22:01,520
...أيُعقل

346
00:22:15,850 --> 00:22:18,480
.أظنّني رأيتُها هنا في مكانٍ ما

347
00:22:24,760 --> 00:22:25,600
!ها هي

348
00:22:47,510 --> 00:22:48,660
فراشة؟

349
00:22:49,350 --> 00:22:50,680
.إنّها تتوهّج

350
00:22:52,670 --> 00:22:53,560
.تعالي

351
00:23:08,250 --> 00:23:08,910
!من هناك؟

352
00:23:11,210 --> 00:23:12,020
.أنا

353
00:23:12,850 --> 00:23:14,120
هايري؟

354
00:23:14,120 --> 00:23:16,080
لماذا أنت هنا؟

355
00:23:17,010 --> 00:23:20,050
ما قصّة تلك الفراشة؟

356
00:23:22,500 --> 00:23:25,670
يمكنك رؤية الشّيتشييتشو؟

357
00:23:32,470 --> 00:23:35,400
.لم تخبرني ما الّذي حدث بالفعل

358
00:23:35,400 --> 00:23:37,110
ما كانت تلك الفراشة؟

359
00:23:38,140 --> 00:23:39,110
ما رأيك؟

360
00:23:39,110 --> 00:23:40,110
.ليس لذيذًا

361
00:23:40,110 --> 00:23:41,030
!كيف تجرؤ؟

362
00:23:41,030 --> 00:23:43,390
.آسف، لم أقصد قول ذلك علنًا

363
00:23:43,390 --> 00:23:46,160
!ذلك لا يُشعرني بتحسّن

364
00:23:46,450 --> 00:23:49,160
.ستأتي أوُ-تشان إلى هنا في الظّهر

365
00:23:49,440 --> 00:23:52,150
.تناول شيئًا باردًا بينما تنتظرها

366
00:23:52,150 --> 00:23:53,540
.شكرًا لك

367
00:24:02,540 --> 00:24:04,010
.كانت تلك آخر واحدة

368
00:24:08,200 --> 00:24:09,270
!مهلاً لحظة

369
00:24:11,310 --> 00:24:13,060
هل يراودك الفضول حيال أوُ؟

370
00:24:13,060 --> 00:24:14,970
ماذا؟ لِـ-لِم تسألين؟

371
00:24:14,970 --> 00:24:17,680
.يبدو أنّك تقضي الكثير من الوقت هنا مؤخّرًا

372
00:24:19,140 --> 00:24:21,680
ما هي واجبات عائلة سوراكادو؟

373
00:24:21,680 --> 00:24:23,070
.لا أدري

374
00:24:23,070 --> 00:24:24,910
.لكنّه أمر يخصّ الجزيرة

375
00:24:24,910 --> 00:24:29,240
.لا يفترض بنا الصّعود للجبل خلال الطّقوس

376
00:24:29,240 --> 00:24:31,420
.ذكرت أوُ ذلك

377
00:24:34,580 --> 00:24:39,090
قبل مدّة، كانت توجد ثلاث عائلات
.هنا يُدعون العائلات الثّلاث

378
00:24:39,800 --> 00:24:44,760
عائلة سوراكادو وعائلة ناروسي
.وعائلة ثالثة لا أذكرها

379
00:24:44,760 --> 00:24:48,220
لكنّ عائلة سوراكادو حافظت
.على واجباتها حتّى الآن

380
00:24:48,220 --> 00:24:49,320
.مهلاً

381
00:24:49,320 --> 00:24:53,100
هل قلت عائلة ناروسي؟ أليست هذه عائلتك؟

382
00:24:53,410 --> 00:24:55,010
.كان هذا منذ وقت بعيد

383
00:24:55,010 --> 00:24:56,850
.ما عدنا نقوم بأيّ شيء الآن

384
00:24:59,700 --> 00:25:02,860
سوراكادو السّماء وناروسي البحر

385
00:25:02,860 --> 00:25:04,900
...واسم آخر مرتبط بالجبال

386
00:25:07,110 --> 00:25:11,370
ليس من العادة أن أراك برفقة
.أيّ أحد آخر يا شيروها

387
00:25:24,780 --> 00:25:27,130
...بشأن ليلة البارحة

388
00:25:27,130 --> 00:25:28,150
ما الّذي تقصده؟

389
00:25:28,150 --> 00:25:30,560
.خلدتُ للنّوم باكرًا ليلة البارحة

390
00:25:30,560 --> 00:25:31,970
.لا بدّ أنّك كنت تهلوس

391
00:25:32,280 --> 00:25:33,710
أهلوس؟

392
00:25:33,710 --> 00:25:38,900
صحيح، لقد بدوت ساحرة الجمال
.ومهيبة كالحُلم ليلة البارحة

393
00:25:38,900 --> 00:25:41,850
سا-ساحرة الجمال ومهيبة؟

394
00:25:41,850 --> 00:25:46,430
إ-إن كنتَ تعتقد أنّ المجاملات
.ستنفع معي، فـ-فأنت مخطئ

395
00:25:46,430 --> 00:25:47,940
.كنتِ أنت إذًا

396
00:25:47,940 --> 00:25:51,870
!أقصد أنّ ذلك ما كنتُ لأقوله إن كنتُ أنا

397
00:25:51,870 --> 00:25:54,370
هلاّ بذلت جهدًا أفضل في الكذب على الأقلّ؟

398
00:25:54,370 --> 00:25:56,270
.لا يمكنني التّظاهر حتّى بأنّي خُدعت

399
00:25:56,270 --> 00:26:00,390
!أ-أ-أنا لا أكذب! إنّها الحقيقة

400
00:26:00,390 --> 00:26:02,250
!إنّها الحقيقة حقًّا

401
00:26:02,250 --> 00:26:06,850
عـ-على أيّ حال، لا تصعد الجبل
.في اللّيل بعد الآن

402
00:26:06,850 --> 00:26:09,330
احترم تقاليد الجزيرة، مفهوم؟

403
00:26:12,520 --> 00:26:15,250
.أوضحَ ذلك التّثاؤب كلّ شيء

404
00:26:15,250 --> 00:26:19,020
على الأقلّ عرفت الآن سبب
.إرهاقك وقلّة نومك

405
00:26:19,020 --> 00:26:21,980
.تبًّا، توشك بطّاريّتي أن تنفد الآن

406
00:26:21,980 --> 00:26:23,770
أتودّين الاستلقاء على ساقي؟

407
00:26:24,670 --> 00:26:27,030
.شكرًا، فقط لبعض الوقت إذًا

408
00:26:36,750 --> 00:26:37,770
حقًّا؟

409
00:26:39,210 --> 00:26:41,090
—مرحـ

410
00:26:48,130 --> 00:26:49,810
.لنغادر يا تنزن

411
00:26:49,810 --> 00:26:51,090
ألم تكن تريد أونمايبو؟

412
00:26:51,090 --> 00:26:55,450
.يعرف الأصدقاء متى يفسحون المجال لبعضهم

413
00:26:55,450 --> 00:26:57,550
!نراك لاحقًا يا صاحبي، استمتع بوقتك

414
00:26:57,550 --> 00:26:59,500
!تنزن، انطلق

415
00:26:59,500 --> 00:27:01,100
!حاضر

416
00:27:03,230 --> 00:27:05,110
.شكرًا على دعوتي

417
00:27:07,150 --> 00:27:08,240
ماذا؟

418
00:27:08,240 --> 00:27:09,200
ما-ماذا هنالك؟

419
00:27:09,430 --> 00:27:12,680
.لا ينبغي لك أن تقترب من الجبل ليلاً

420
00:27:12,680 --> 00:27:16,330
.من الأفضل أن تستمع لما تقوله أوُ

421
00:27:28,100 --> 00:27:30,670
.إنّها تغفو في أيّ مكان بالفعل

422
00:27:46,270 --> 00:27:47,650
...هذا قد ينقلب إلى كارثة

423
00:28:01,790 --> 00:28:03,020
!ما الّذي يحدث؟

424
00:28:03,020 --> 00:28:04,290
!وجهها قريب جدًّا

425
00:28:04,290 --> 00:28:06,030
!كلّ شيء ناعم جدًّا

426
00:28:06,030 --> 00:28:08,090
!وهناك رائحة جميلة أيضًا

427
00:28:14,050 --> 00:28:15,870
...عفوًا، هذا ليس

428
00:28:15,870 --> 00:28:18,010
.استمتعا بوقتكما

429
00:28:26,350 --> 00:28:27,300
.صباح الخير

430
00:28:29,590 --> 00:28:31,200
!ما-ما-ما-ما هذا؟

431
00:28:31,200 --> 00:28:32,030
!ما الّذي يحدث؟

432
00:28:32,030 --> 00:28:35,520
!أ-أردتُ أن تكون تجربتي الأولى مع فتاة

433
00:28:35,520 --> 00:28:36,510
.اهدئي

434
00:28:36,510 --> 00:28:40,350
،لا-لا بأس ببعض الخشونة
!لكنّنا في الخارج الآن

435
00:28:40,350 --> 00:28:42,270
!قلت لك اهدئي

436
00:28:42,270 --> 00:28:45,290
...أنتِ من تعانقينني بقوّة الآن

437
00:28:48,760 --> 00:28:49,630
!دعني أذهب

438
00:28:49,630 --> 00:28:52,210
!بل أنت من يجب أن تدعيني

439
00:28:54,870 --> 00:28:57,140
.أ-أعتذر على ما حدث

440
00:28:57,140 --> 00:28:59,140
.لا بأس، لا عليك

441
00:28:59,140 --> 00:29:02,080
هل تأخّرت في النّوم ثانية من أجل واجباتك؟

442
00:29:02,080 --> 00:29:03,740
.شيء من هذا القبيل

443
00:29:03,740 --> 00:29:04,770
واللّيلة أيضًا؟

444
00:29:05,930 --> 00:29:09,890
.سأكرّر كلامي. لا يمكنك الصّعود للجبل ليلاً

445
00:29:09,890 --> 00:29:12,780
أنا أقول هذا لمصلحتك، أتفهم؟

446
00:29:14,800 --> 00:29:17,420
.ذلك ما قالته، لكنّي صعدت في كلّ الأحوال

447
00:29:22,490 --> 00:29:23,530
أوُ؟

448
00:29:30,250 --> 00:29:33,090
.صحيح، كانت أوُ تلمس هذه الفراشة

449
00:29:35,990 --> 00:29:38,390
كيف حدث هذا؟

450
00:29:38,390 --> 00:29:39,960
...عودي إليّ

451
00:29:39,960 --> 00:29:41,210
!عودي إليّ يا زوجتي

452
00:29:41,210 --> 00:29:42,640
!ابنتي

453
00:29:43,080 --> 00:29:45,230
لماذا نجوت أنا؟

454
00:29:46,450 --> 00:29:49,310
...أنقذوني من هذا العذاب

455
00:29:50,910 --> 00:29:51,990
.أنا قادم

456
00:29:52,430 --> 00:29:55,700
.سأكون معك قريبًا

457
00:29:54,840 --> 00:29:57,490
.يتحرّك جسدي من تلقاء نفسه

458
00:29:57,490 --> 00:29:59,440
ما الّذي يحدث؟

459
00:29:59,440 --> 00:30:01,700
.لكن لا بأس بهذا

460
00:30:02,600 --> 00:30:04,120
.يمكنني أن أتحررّ أخيرًا

461
00:30:04,690 --> 00:30:05,660
!هايري

462
00:30:07,230 --> 00:30:08,120
!أيّها الغبيّ

463
00:30:18,370 --> 00:30:21,200
!قلت لك ألاّ تصعد إلى الجبل ليلاً

464
00:30:21,910 --> 00:30:23,070
أوُ؟

465
00:30:23,070 --> 00:30:23,900
...أكنتُ

466
00:30:23,900 --> 00:30:28,020
تسرّبت ذكريات شخص آخر
.إلى ذهنك لأنّك لمستَ الشّيتشييتشو

467
00:30:29,810 --> 00:30:32,980
ما هذه الشّيتشييتشو من الأساس؟

468
00:30:32,980 --> 00:30:37,790
إنّها بقايا من ذكريات أشخاص
.رحلوا وتركوا وراءهم أمورًا لم تُنجز

469
00:30:38,500 --> 00:30:42,240
إذا لمستَ واحدة منها، تختبر
.ذكريات صاحبها كأنّك تعيشها

470
00:30:42,640 --> 00:30:47,530
عادة، لا يرى هذه الفراشات إلاّ الحيوانات
.أو من يملكون حساسيّة عاطفيّة عالية

471
00:30:47,790 --> 00:30:48,700
...أوُ

472
00:30:48,700 --> 00:30:51,850
ما هي واجباتك بالضّبط؟

473
00:30:53,760 --> 00:30:57,960
أقوم بجمع الشّيتشييتشو التّائهة
.وأعيدها إلى مكانها الصّحيح

474
00:30:58,460 --> 00:31:00,800
.هذا هو عمل عائلة سوراكادو

475
00:31:01,510 --> 00:31:04,540
.يمكنك أن تعود من هنا بنفسك

476
00:31:04,540 --> 00:31:06,220
ألن تغادري أنت أيضًا؟

477
00:31:06,670 --> 00:31:09,180
.عليّ أن أتابع عملي

478
00:31:09,180 --> 00:31:12,290
.أنت تعرف الآن كم يكون الجبل غادرًا ليلاً

479
00:31:12,290 --> 00:31:13,760
.لا تقترب منه مرّة أخرى

480
00:31:13,760 --> 00:31:15,120
!مهلاً لحظة

481
00:31:15,730 --> 00:31:16,690
ماذا؟

482
00:31:17,000 --> 00:31:19,240
...هذه الشّيتشي أو مهما كان اسمها

483
00:31:19,240 --> 00:31:20,690
.لقد لمستِها أيضًا

484
00:31:21,040 --> 00:31:22,640
ألا تؤثّر عليك؟

485
00:31:23,200 --> 00:31:25,530
.أنا أتعامل معها منذ وقت طويل

486
00:31:25,530 --> 00:31:27,700
.لقد كوّنت مناعة ضدّها

487
00:31:28,010 --> 00:31:29,750
وهل هذا جزء من واجباتك؟

488
00:31:31,500 --> 00:31:35,490
.هناك ذكرى... عليّ أن أجدها

489
00:31:35,490 --> 00:31:38,130
وهل تستحقّ أن تخاطري بنفسك لأجلها؟

490
00:31:48,590 --> 00:31:51,890
اسمع... هل لديك وقت غدًا؟

491
00:31:54,390 --> 00:31:57,790
سوراكادو أي

492
00:31:56,770 --> 00:31:57,770
.هذه هي

493
00:31:58,670 --> 00:31:59,520
.أنا أوُ

494
00:31:59,970 --> 00:32:01,230
.سأدخل الآن

495
00:32:04,770 --> 00:32:06,460
.عذرًا على الإزعاج

496
00:32:08,610 --> 00:32:10,510
.لقد وصلتُ يا أي

497
00:32:10,510 --> 00:32:11,300
أي؟

498
00:32:11,300 --> 00:32:11,980
.نعم

499
00:32:11,980 --> 00:32:13,320
.سوراكادو أي

500
00:32:13,320 --> 00:32:15,360
.إنّها أختي الكبرى التّوأم

501
00:32:22,120 --> 00:32:25,290
.أحضرتُ صديقًا معي اليوم

502
00:32:25,290 --> 00:32:27,290
أخبرتك عنه قبل أيّام، أتذكرين؟

503
00:32:27,290 --> 00:32:30,510
.إنّه من أقارب الجدّة كاتو المتوفّاة

504
00:32:32,280 --> 00:32:35,800
،تعرّضت أي لحادث

505
00:32:35,800 --> 00:32:38,230
.ومنذ ذلك الحين وهي نائمة

506
00:32:38,230 --> 00:32:39,060
...عفوًا

507
00:32:39,360 --> 00:32:44,640
.أخبرتك بالأمس أنّني أبحث عن ذكرى ما

508
00:32:45,260 --> 00:32:47,820
.إنّها ذكرى لأي

509
00:32:49,040 --> 00:32:54,350
روت لي الجدّة كاتو حكاية قديمة
عن فراشة غريبة

510
00:32:54,350 --> 00:32:59,830
.أيقظت شخصًا ظلّ نائمًا لفترة طويلة

511
00:32:59,830 --> 00:33:01,540
جدّتي روت لك تلك القصّة؟

512
00:33:01,540 --> 00:33:05,180
...ربّما كانت قد ألّفتها فقط لتواسيَني

513
00:33:05,680 --> 00:33:11,140
لكن حين أفكّر في واجبات عائلة
،سوراكادو بشأن الشّيتشييتشو

514
00:33:11,140 --> 00:33:13,130
.أجد صعوبة في تجاهل الأمر

515
00:33:13,680 --> 00:33:18,170
.ولهذا السّبب ألمس هذه الشّيتشييتشو أثناء عملي

516
00:33:18,170 --> 00:33:20,170
.أنا أبحث عن ذكريات أي

517
00:33:21,990 --> 00:33:23,010
هل تشعرين بالنّعاس؟

518
00:33:23,010 --> 00:33:27,190
عذرًا... هل يمكنني أن آخذ قيلولة؟

519
00:33:27,190 --> 00:33:28,640
.نعم، بالتّأكيد

520
00:33:28,640 --> 00:33:32,530
.أيقظني بعد نصف ساعة تقريبًا

521
00:33:53,390 --> 00:33:54,890
.مرحبًا. مساء الخير

522
00:33:56,640 --> 00:33:58,130
.مرحبًا يا إيناري

523
00:33:58,130 --> 00:33:59,520
!بون

524
00:33:59,520 --> 00:34:03,020
!ألم أقل لك ألاّ تقترب من الجبل؟

525
00:34:03,020 --> 00:34:04,370
.بلى، قلتِ ذلك

526
00:34:04,370 --> 00:34:06,010
.لكنّني لم أعدك أنّني لن أفعل

527
00:34:06,010 --> 00:34:08,400
!لماذا لا تفهم؟

528
00:34:08,400 --> 00:34:11,800
البحث عن الشّيتشييتشو خطير للغاية

529
00:34:11,800 --> 00:34:12,850
.وهذا هو السّبب بالتّحديد

530
00:34:13,700 --> 00:34:16,230
،ما دمت تعرّضين نفسك للخطر

531
00:34:16,230 --> 00:34:18,660
.أريد أن أكون بقربك على الأقلّ

532
00:34:19,530 --> 00:34:20,830
...أنا

533
00:34:21,810 --> 00:34:24,510
.حسنًا، فهمت الآن

534
00:34:24,510 --> 00:34:26,500
هل وقعتَ في حبّي؟

535
00:34:26,500 --> 00:34:28,190
.أظنّ ذلك

536
00:34:28,190 --> 00:34:30,050
.بل أكثر من مجرّد ظنّ في الحقيقة

537
00:34:31,250 --> 00:34:33,880
ماذا... هـ-هل أنت بخير؟

538
00:34:33,880 --> 00:34:34,870
هل يزعجك ذلك؟

539
00:34:34,870 --> 00:34:37,300
.أ-أكثر ممّا تتصور

540
00:34:37,650 --> 00:34:39,810
.بصراحة، أنا مصدوم قليلاً

541
00:34:39,810 --> 00:34:44,590
أعني... لا أملك القدرة على التّفكير
.في هذه الأمور الآن

542
00:34:44,590 --> 00:34:47,980
أنا منشغلة تمامًا بالبحث
.عن الشّيتشييتشو الخاصّة بأي

543
00:34:48,220 --> 00:34:48,950
.نعم

544
00:34:48,950 --> 00:34:51,740
لكن أليس هذا سبب إضافيّ
ليقف أحد إلى جانبك؟

545
00:34:53,440 --> 00:34:57,550
لا يقترب سكّان الجزيرة من الجبل
،بسبب العادات والتّقاليد

546
00:34:57,550 --> 00:34:59,710
.لكنّني لستُ من أهل الجزيرة

547
00:34:59,710 --> 00:35:01,830
.ولهذا، يمكنني مساعدتك

548
00:35:06,210 --> 00:35:08,090
.حـ-حسنًا، مفهوم

549
00:35:08,390 --> 00:35:12,910
.لا أظنّ أنّني سأتمكّن من إيقافك حتّى لو حاولت

550
00:35:12,910 --> 00:35:17,340
.لكن عليك أن تعدني أن تبقى بجانبي دائمًا

551
00:35:17,340 --> 00:35:18,560
.اتّفقنا

552
00:35:23,020 --> 00:35:25,690
.لن أتركك أبدًا

553
00:35:30,810 --> 00:35:36,960
وهكذا، بدأتُ أنا وأوُ وإيناري
.في البحث عن الشّيتشييتشو الخاصّة بأي

554
00:36:56,340 --> 00:36:59,820
مايوي تاتشيبانا هي الشّجرة
.المقدّسة لعائلة سوراكادو

555
00:37:00,290 --> 00:37:04,330
تُزهر أشجار تاتشيبانا قبل فصل
،الصّيف في العادة

556
00:37:04,330 --> 00:37:06,690
.لكن هذه دائمًا ما تتأخّر قليلاً

557
00:37:06,690 --> 00:37:09,010
،فهي منحرفة قليلاً عن العالم الحقيقيّ

558
00:37:09,010 --> 00:37:11,050
.خارج التّزامن المعتاد

559
00:37:11,050 --> 00:37:14,790
لذلك اعتُبرت مقدّسة، لأنّها قائمة على
.الحدّ الفاصل بين هذا العالم والعالم الآخر

560
00:37:28,030 --> 00:37:33,540
لا يمكنني أن أرشد الشّيتشييتشو بالفانوس
.إلاّ حين تكون الشّجرة في أوج تفتّحها

561
00:37:33,540 --> 00:37:36,860
.إذًا هذا هو الإطار الزّمنيّ الّذي تعملين فيه

562
00:37:39,890 --> 00:37:40,640
.نعم

563
00:37:44,490 --> 00:37:48,620
ثمّ بعدها، احمرّ وجه نوميكي
.خجلاً وسكتت تمامًا

564
00:37:48,620 --> 00:37:53,970
بالمناسبة، ما الهدف من الحديث
معها وهي نائمة؟

565
00:37:55,180 --> 00:37:58,060
،إنّه نوعًا ما... كالتّعلّم أثناء النّوم
على ما أظنّ؟

566
00:37:58,060 --> 00:38:02,210
،أعتقد أنّها ربّما إن تذكّرت ما قلته حين تستيقظ

567
00:38:02,210 --> 00:38:04,510
.فكأنّنا قضينا الوقت سويًّا طوال تلك الفترة

568
00:38:04,510 --> 00:38:06,060
!خطرت لي فكرة

569
00:38:06,060 --> 00:38:08,850
ما رأيك أن تتحدّث إليها أنت أيضًا؟

570
00:38:09,860 --> 00:38:12,520
.فكرة جيّدة، سأعرّفها بنفسي

571
00:38:13,990 --> 00:38:14,980
...أنا هو

572
00:38:14,980 --> 00:38:17,520
!حـ-حبيب أوُ، تاكاهارا هايري

573
00:38:17,520 --> 00:38:19,400
!مـ-متى صرتَ حبيبي؟

574
00:38:19,400 --> 00:38:20,590
!تمهّل قليلاً

575
00:38:20,590 --> 00:38:24,280
.أردت فقط أن تتقبّلني عندما تستيقظ

576
00:38:25,300 --> 00:38:30,690
...أعني... أنّي أقدّر قولك هذا

577
00:38:30,690 --> 00:38:34,500
.وأنا أيضًا... وقعت في حبّك فعلاً

578
00:38:34,750 --> 00:38:35,730
...أوُ

579
00:38:36,700 --> 00:38:38,490
.لكنّي آسفة

580
00:38:39,480 --> 00:38:43,840
لا يمكنني أن أسمح لنفسي أن أسعد
.ما دامت أي لا تزال نائمة

581
00:38:44,340 --> 00:38:49,440
...أعلم أن هذا أنانيّ، لكن
.أتمنى أن تنتظر حتّى تستيقظ أي

582
00:38:50,710 --> 00:38:52,020
.هذا محرج

583
00:38:52,610 --> 00:38:53,500
.آسفة

584
00:38:53,500 --> 00:38:57,290
.البحث عن ذكرى أي لم يعد مجرّد معروف أؤدّيه

585
00:38:57,290 --> 00:38:58,540
ماذا؟

586
00:38:58,540 --> 00:39:02,800
بإمكاننا أن نتواعد حين تستيقظ، أليس كذلك؟

587
00:39:02,800 --> 00:39:05,530
.لذلك هذا هو هدفي الآن

588
00:39:05,530 --> 00:39:08,870
أ-أهكذا تسير الأمور؟

589
00:39:09,210 --> 00:39:10,220
.نعم

590
00:39:10,220 --> 00:39:11,880
!والآن، أنا متحمّس بالفعل

591
00:39:19,030 --> 00:39:22,380
،عفوًا يا كيوكو-سان
هل يمكنني أن أطرح عليك سؤالاً؟

592
00:39:22,380 --> 00:39:23,810
وما هو يا ترى؟

593
00:39:23,810 --> 00:39:30,530
سمعت أنّ هناك حكاية قديمة في الجزيرة عن
.فراشة يمكنها إيقاظ النّاس من نومهم الطّويل

594
00:39:30,530 --> 00:39:32,390
الشّيتشييتشو؟

595
00:39:32,390 --> 00:39:34,390
!أنت تمزح! هنالك كتاب عنها؟

596
00:39:34,390 --> 00:39:36,050
.ذلك ما يبدو

597
00:39:36,050 --> 00:39:39,390
طلبت من كيوكو-سان
.أن تبحث عنه في الكوخ

598
00:39:39,390 --> 00:39:40,650
!هكذا إذًا

599
00:39:40,650 --> 00:39:43,300
.تقصد كوخ الجدّة كاتو. ذلك منطقيّ

600
00:39:43,300 --> 00:39:44,590
هل تودّين القدوم غدًا؟

601
00:39:44,590 --> 00:39:46,420
!نعم، سأكون هناك

602
00:39:46,420 --> 00:39:49,600
!حسنًا، أشعر بالحماسة لهذه اللّيلة

603
00:39:49,600 --> 00:39:51,260
!حسنًا! لنبذل جهدنا

604
00:39:51,260 --> 00:39:52,160
!بون

605
00:39:55,160 --> 00:39:56,160
...أشعر بالنّعاس

606
00:39:56,160 --> 00:39:58,240
.يبدو أنّك استنفدتِ طاقتك تمامًا اللّيلة

607
00:39:58,240 --> 00:40:00,200
.لكنّني لم أنتهِ بعد

608
00:40:00,200 --> 00:40:02,170
.إلى الأمام يا إيناري

609
00:40:04,900 --> 00:40:06,850
أتريدين الإمساك بيدي أثناء نزولنا؟

610
00:40:07,570 --> 00:40:10,130
.لا تبدو فكرة سيّئة

611
00:40:10,130 --> 00:40:11,770
ماذا؟ حقًّا؟

612
00:40:12,850 --> 00:40:15,380
ماذا؟ هل قلتُ شيئًا؟

613
00:40:15,380 --> 00:40:17,020
.أعتقد أنّك عبّرت عمّا في قلبك حقًّا فحسب

614
00:40:17,020 --> 00:40:18,850
!مـ-مـ-مستحيل

615
00:40:18,850 --> 00:40:19,610
!نحن في الخارج

616
00:40:19,610 --> 00:40:21,110
!هذا تجاوز للحدود

617
00:40:21,550 --> 00:40:24,530
أريد أن تكون تجربتنا الأولى
.في مكان فيه وسادة

618
00:40:24,530 --> 00:40:27,740
أظنّ أنّ هذا التّصريح خرج
.عن السّيطرة قليلاً

619
00:40:27,740 --> 00:40:30,290
.لكن واضح أنّك بلغت أقصى حدودك

620
00:40:30,290 --> 00:40:31,130
.لنعد إلى المنزل

621
00:40:33,530 --> 00:40:35,370
.حـ-حسنًا

622
00:40:49,180 --> 00:40:52,290
!موجة التّنّين الشّعاعيّة الانتقاميّة لسيّد الشّياطين

623
00:40:52,290 --> 00:40:56,220
ماذا؟ موجة التّنّين... سيّد الشّياطين؟

624
00:40:56,220 --> 00:40:57,810
ما الّذي تفعله؟

625
00:40:57,810 --> 00:40:59,040
.أومي-تشان

626
00:40:59,040 --> 00:41:00,690
.ظللتُ أحاول إيقاظك

627
00:41:00,690 --> 00:41:02,690
.لم يعد هنالك فطور بعد

628
00:41:03,180 --> 00:41:04,470
.آسف

629
00:41:04,470 --> 00:41:06,110
.لا أعرف لماذا لم أستطع الاستيقاظ

630
00:41:06,110 --> 00:41:08,810
.لأنّك تخرج في اللّيل كثيرًا

631
00:41:12,850 --> 00:41:14,380
الشّيتشييتشو؟

632
00:41:18,650 --> 00:41:19,900
.هايري-كُن

633
00:41:19,900 --> 00:41:20,670
نعم؟

634
00:41:20,670 --> 00:41:22,120
.لديك زائرة

635
00:41:23,100 --> 00:41:24,920
...عـ-عفوًا

636
00:41:25,800 --> 00:41:27,570
.شكرًا على استضافتي

637
00:41:29,630 --> 00:41:31,090
ما بالك متوتّرة هكذا؟

638
00:41:31,520 --> 00:41:34,870
...لم أدخل غرفة فتى من قبل

639
00:41:34,870 --> 00:41:38,310
...وفوق ذلك، كان الفوتون مفروشًا

640
00:41:38,310 --> 00:41:39,520
.تمهّلي

641
00:41:39,520 --> 00:41:41,240
.كيوكو-سان وأومي-تشان هنا أيضًا

642
00:41:41,240 --> 00:41:42,760
ما الّذي كنتُ أفعله في ظنّك؟

643
00:41:42,760 --> 00:41:45,240
!ماذا؟ صـ-صحيح، بالطّبع

644
00:41:47,620 --> 00:41:50,980
القصص الاثنتا عشرة للجبل المقدّس

645
00:41:47,760 --> 00:41:48,980
.على أيّ حال، ها هو

646
00:41:48,980 --> 00:41:50,990
.وجدت كيوكو-سان الكتاب

647
00:41:51,470 --> 00:41:55,210
.كان قديمًا جدًّا ولم أفهم شيئًا منه

648
00:42:00,490 --> 00:42:02,370
.إنّه من فترة تنبو

649
00:42:02,370 --> 00:42:03,920
هل يمكنك قراءته؟

650
00:42:03,920 --> 00:42:08,550
أتدري كم مرّة أعيش ذكريات النّاس
بعد لمس الشّيتشييتشو خاصّتهم؟

651
00:42:08,550 --> 00:42:11,190
.يمكنك أن تتعلّم أشياء كثيرة بهذه الطّريقة

652
00:42:11,190 --> 00:42:12,770
.هذا مذهل نوعًا ما

653
00:42:12,770 --> 00:42:13,890
ألم أقل لك؟

654
00:42:14,180 --> 00:42:16,420
.لديّ معرفة واسعة

655
00:42:21,110 --> 00:42:21,770
!مستحيل

656
00:42:21,770 --> 00:42:25,900
يشرح الكتاب كيف نعيد الشّيتشييتشو
!إلى جسد شخص نائم

657
00:42:26,320 --> 00:42:27,020
فعلاً؟

658
00:42:27,970 --> 00:42:30,530
هذا هو بالضّبط ما كنت
!أبحث عنه طوال هذا الوقت

659
00:42:30,530 --> 00:42:32,050
!نعم

660
00:42:33,080 --> 00:42:36,030
أ-أوُ! إنّك تلمسينني بمختلف
...أعضاء جسدك

661
00:42:37,030 --> 00:42:38,830
...آ-آسفة

662
00:42:39,370 --> 00:42:41,670
.تحمّست أكثر من اللاّزم

663
00:42:41,670 --> 00:42:44,750
.لا بأس، أنا متحمّس أيضًا، فلا بأس بذلك

664
00:42:45,290 --> 00:42:46,540
إذًا كيف يتمّ الأمر؟

665
00:42:47,700 --> 00:42:49,000
...حسنًا

666
00:42:49,000 --> 00:42:53,680
علينا أن نجد الشّيتشييتشو الخاصّة
...بأي، ثمّ عند الرّو

667
00:42:53,940 --> 00:42:54,880
الرّو؟

668
00:42:54,880 --> 00:42:58,600
على أيّ حال، علينا أن نجد
.الشّيتشييتشو الخاصّة بأي

669
00:42:58,600 --> 00:43:00,270
.هذا سيحلّ كلّ شيء

670
00:43:00,650 --> 00:43:01,790
.يكفيني هذا

671
00:43:02,680 --> 00:43:04,920
.شكرًا لك يا هايري

672
00:43:15,940 --> 00:43:17,520
...أحرقه

673
00:43:17,820 --> 00:43:21,360
أحرق ذاك الكتاب الّذي غُيّر
...غلافه ليبدو كمرجع دراسيّ

674
00:43:21,700 --> 00:43:24,730
مجمّع الزّوجات والأخوات الصّغيرات"
".المقيّدات بحبال خشنة وزلقة

675
00:43:27,580 --> 00:43:29,410
...يا للنّدم الشّديد

676
00:43:29,410 --> 00:43:32,730
،لو عثر عليه والداك
.لكان ذلك أشبه بموت مضاعف

677
00:43:33,950 --> 00:43:35,660
!لم تكن تلك من ذكريات أي

678
00:43:35,660 --> 00:43:38,210
.هكذا إذًا صرتِ متعالمة بهذا القدر في النّهاية

679
00:43:38,210 --> 00:43:40,370
!لا-لا تصفني بالمتعالمة

680
00:43:40,700 --> 00:43:43,310
!هيّا نبحث عن الشّيتشييتشو التّالية يا إيناري

681
00:43:43,310 --> 00:43:43,880
!بون

682
00:43:45,880 --> 00:43:46,710
بون؟

683
00:43:47,880 --> 00:43:50,470
.حسنًا، هذا يعفينا من عناء البحث

684
00:43:52,490 --> 00:43:53,220
أوُ؟

685
00:43:53,220 --> 00:43:53,830
!بون

686
00:43:54,590 --> 00:43:55,720
...كلاّ

687
00:43:55,720 --> 00:43:57,220
...هذه الذّكرى

688
00:43:57,550 --> 00:43:58,980
!إنّها ذكرى موت

689
00:44:06,990 --> 00:44:10,040
،أعلم أنّها تريد العثور على ذكريات أي

690
00:44:10,040 --> 00:44:11,560
.لكنّها تبالغ كثيرًا في الأمر

691
00:44:11,560 --> 00:44:12,360
!بون

692
00:44:16,640 --> 00:44:21,200
ما زلت أظنّ أنّنا سنجد أي بشكل
.أسرع إن بحثنا معًا

693
00:44:21,200 --> 00:44:22,550
...بون

694
00:44:25,580 --> 00:44:27,030
...هذه الذّكرى

695
00:44:27,030 --> 00:44:29,450
...أشعر بضيق في صدري

696
00:44:29,900 --> 00:44:31,130
أهو الحزن؟

697
00:44:31,790 --> 00:44:34,440
كنت أعلم أنّ لا حقّ لي
،في أن أشعر كما شعرت

698
00:44:34,440 --> 00:44:37,330
.لكنّني لم أستطع كبح مشاعري

699
00:44:37,330 --> 00:44:41,240
.لذلك اتّخذنا قرارًا بالهرب معًا

700
00:44:42,230 --> 00:44:45,290
...لكنّها لم تأتِ

701
00:44:46,370 --> 00:44:48,020
.لم يكن الأمر أنّها لم تأتِ فحسب

702
00:44:48,020 --> 00:44:49,330
.بل لم تستطع أن تأتي

703
00:44:49,890 --> 00:44:51,340
.كنتُ واثقًا من ذلك

704
00:44:51,990 --> 00:44:56,840
.فرحلتُ إلى الحرب وأنا ما زلت أؤمن بذلك

705
00:44:57,500 --> 00:44:58,300
.أنا آسف

706
00:44:58,300 --> 00:45:00,840
.لم أستطع مواصلة الانتظار

707
00:45:00,840 --> 00:45:02,990
.كان لا بدّ لي أن أموت قبلك

708
00:45:03,800 --> 00:45:05,100
.أفتقدك

709
00:45:05,550 --> 00:45:08,520
.كنت أود رؤيتك لمرّةٍ أخيرة

710
00:45:10,700 --> 00:45:11,990
...أفتقدك

711
00:45:16,300 --> 00:45:18,150
هايري؟

712
00:45:19,180 --> 00:45:20,200
...آسف

713
00:45:21,500 --> 00:45:22,390
...الفراشة

714
00:45:22,390 --> 00:45:23,540
.غبيّ

715
00:45:23,540 --> 00:45:25,830
.أخبرتك ألاّ تلمسها

716
00:45:28,900 --> 00:45:30,220
.شكرًا لك

717
00:45:31,370 --> 00:45:33,840
...لنُعدها

718
00:45:34,220 --> 00:45:35,810
.إلى حيث تنتمي

719
00:45:36,340 --> 00:45:38,340
.بأيدينا

720
00:45:39,740 --> 00:45:40,340
!بون

721
00:45:49,830 --> 00:45:50,890
ما الأمر؟

722
00:45:50,890 --> 00:45:52,100
.لا شيء

723
00:45:52,100 --> 00:45:57,290
أتمنّى فقط أن يلتقي صاحب
.تلك الذّكرى بمن كان ينتظره

724
00:45:57,290 --> 00:45:58,440
.نعم

725
00:45:59,670 --> 00:46:00,620
...الزّهور

726
00:46:01,620 --> 00:46:03,200
.بدأت الزّهور تتساقط

727
00:46:06,620 --> 00:46:08,980
.وهذا يعني أنّ الوقت بدأ ينفد منّا

728
00:46:08,980 --> 00:46:14,420
سأضطرّ إلى الانتظار سنةً أخرى حتّى أتمكّن
...من جمع المزيد من الشّيتشييتشو ثانية

729
00:46:14,980 --> 00:46:18,520
!سأجدها هذا الصّيف، سترى ذلك

730
00:46:20,420 --> 00:46:21,960
...لا تقلقي

731
00:46:21,960 --> 00:46:23,510
.أنا معك هذا السّنة

732
00:46:24,950 --> 00:46:25,650
.نعم

733
00:46:28,660 --> 00:46:29,480
!بون

734
00:46:36,210 --> 00:46:38,570
.لقد تأخّر الوقت. بدأتُ أشعر بالنّعاس حقًّا

735
00:46:39,970 --> 00:46:42,400
.ذلك النّعاس سببه الشّيتشييتشو

736
00:46:44,060 --> 00:46:47,980
حين تلمس شيتشييتشو
،وتشهد ذكريات شخص آخر

737
00:46:47,980 --> 00:46:51,900
.تصبح تلك الذّكريات جزءًا منك بالفعل

738
00:46:51,900 --> 00:46:54,890
،إنّنا ننظّم ذكرياتنا أثناء النّوم

739
00:46:54,890 --> 00:46:56,790
.ولذلك نحتاج إلى الكثير منه

740
00:46:57,220 --> 00:47:01,320
أهذا هو سبب نومك طوال الوقت؟

741
00:47:02,260 --> 00:47:03,460
.أظنّ ذلك

742
00:47:03,460 --> 00:47:05,870
.إذًا لا بدّ أنّك في حالٍ سيّئة أيضًا

743
00:47:05,870 --> 00:47:07,760
!لقد اعتدتُ على هذا

744
00:47:07,760 --> 00:47:09,740
.أقوم بهذا منذ وقت طويل

745
00:47:10,370 --> 00:47:13,600
.صرتُ ماهرة في ترتيب الذّكريات

746
00:47:13,600 --> 00:47:17,610
،أعلم أنّك تفعلين هذا من أجل أي
لكن ألا تظنّين أنّك تفرطين في الأمر قليلاً؟

747
00:47:18,190 --> 00:47:19,620
...حسنًا

748
00:47:19,620 --> 00:47:23,650
.ما آلت إليه أي من حال هو بسببي أنا

749
00:47:25,360 --> 00:47:26,950
.كانت أي ذكيّة

750
00:47:27,510 --> 00:47:29,720
.وكانت رياضيّة أيضًا

751
00:47:29,720 --> 00:47:33,230
.كلّما تنافسنا، كنت أتخلّف عنها

752
00:47:33,780 --> 00:47:35,860
.وكانت ماهرةً بيديها كذلك

753
00:47:35,860 --> 00:47:37,980
.علّمتنا أمّنا كيف نصنع هذه التّمائم

754
00:47:37,980 --> 00:47:40,710
!قالت أنّها تطرد الأرواح الشّرّيرة

755
00:47:41,470 --> 00:47:45,690
كانت ترغب أن نرتديها عندما نكبر
.ونتولّى واجبات سوراكادو

756
00:47:46,400 --> 00:47:48,470
،صنعناها معًا

757
00:47:48,470 --> 00:47:51,440
.لكنّ ما كنت أصنعه لم يكن جميلاً أبدًا

758
00:47:51,440 --> 00:47:53,440
.وذلك كان يزعجني كثيرًا

759
00:47:53,440 --> 00:47:55,870
.غِرتُ منها وبكيت

760
00:47:57,190 --> 00:47:59,280
،وحين أعطتني أي هذه

761
00:47:59,980 --> 00:48:03,040
.طلبتْ أن تأخذ التّميمة الّتي صنعتُها أنا

762
00:48:03,040 --> 00:48:05,570
...إذًا تلك الّتي في معصمها

763
00:48:05,570 --> 00:48:06,740
.نعم

764
00:48:06,740 --> 00:48:08,490
شكلها غير منتظم قليلاً، صحيح؟

765
00:48:08,490 --> 00:48:10,810
،قالت أنّها تقدّرها على أيّ حال

766
00:48:10,810 --> 00:48:13,290
.لأنّني أنا من صنعتها

767
00:48:13,290 --> 00:48:16,090
.كانت أي مذهلة فعلاً

768
00:48:16,090 --> 00:48:20,240
.وأردتُ منها أن تقول أنّني كذلك

769
00:48:20,240 --> 00:48:23,710
.ذات يوم، رأيت فراشة غريبة

770
00:48:23,710 --> 00:48:26,150
.جميلة... وكانت تشعّ ضوءًا خافتًا

771
00:48:26,150 --> 00:48:28,470
.كان ذلك أوّل لقاء لي مع شيتشييتشو

772
00:48:29,490 --> 00:48:31,350
...مذهلة

773
00:48:35,850 --> 00:48:38,400
!إنّها الحقيقة
!رأيتُ واحدة! أقسم بذلك

774
00:48:38,400 --> 00:48:40,650
فراشة متوهّجة؟

775
00:48:40,650 --> 00:48:42,610
أمتأكّدة أنّها لم تكن مجرّد
أشعة الشّمس عليها؟

776
00:48:42,610 --> 00:48:45,280
!أنا لا أكذب! رأيت واحدة بالفعل

777
00:48:46,890 --> 00:48:48,610
أنت تصدّقني، أليس كذلك يا أي؟

778
00:48:50,740 --> 00:48:53,790
.لم يصدّقني أحد

779
00:48:53,790 --> 00:48:59,460
لذا كنتُ مستميتة للعثور على
.فراشة متوهّجة وإبهار الجميع

780
00:49:00,000 --> 00:49:04,000
.ظننتُ أنّني سأراها بشكل أسهل في اللّيل

781
00:49:21,340 --> 00:49:22,520
أوُ-تشان؟

782
00:49:22,820 --> 00:49:23,770
أي؟

783
00:49:23,770 --> 00:49:24,960
!أوُ-تشان

784
00:49:26,060 --> 00:49:27,070
.لنعد إلى المنزل

785
00:49:28,370 --> 00:49:31,060
.لكنّني لم أعثر على الفراشة المتوهّجة بعد

786
00:49:31,060 --> 00:49:32,820
.لكنّ الجبل خطير في اللّيل

787
00:49:33,180 --> 00:49:34,770
!لا، ليس خطيرًا

788
00:49:34,770 --> 00:49:37,470
.صعدتِ إلى هنا وحدك أيضًا

789
00:49:37,470 --> 00:49:38,940
.سأكون بخير

790
00:49:38,940 --> 00:49:39,710
—إذًا فلنذهب معًا

791
00:49:39,710 --> 00:49:40,450
!لا

792
00:49:40,450 --> 00:49:42,130
!لن يكون للأمر أيّ معنى إن كنتِ معي

793
00:49:42,520 --> 00:49:46,760
!لا تصدّقين حتّى بوجود الفراشة
!تظنّين أنّني أكذب

794
00:49:47,300 --> 00:49:48,300
...أوُ-تشان

795
00:49:52,470 --> 00:49:53,570
!أوُ-تشان

796
00:49:57,800 --> 00:49:59,450
.ما كان ينبغي أن أقول ذلك

797
00:49:59,450 --> 00:50:02,190
.لم أرَ تلك الملامح على وجه أي من قبل

798
00:50:26,610 --> 00:50:27,640
...أي

799
00:50:31,350 --> 00:50:33,440
.آسفة يا أي

800
00:50:33,880 --> 00:50:34,680
.سامحيني

801
00:50:35,940 --> 00:50:37,430
.أنا آسفة

802
00:50:44,980 --> 00:50:48,340
!أوُ

803
00:50:48,340 --> 00:50:50,190
!حمدًا على هذا

804
00:50:51,620 --> 00:50:53,050
أبي؟

805
00:50:53,050 --> 00:50:54,700
أمّي؟

806
00:50:56,140 --> 00:50:58,540
لكن ماذا عن أي؟

807
00:50:58,540 --> 00:50:59,930
أين هي؟

808
00:51:02,080 --> 00:51:06,880
.وجدوها في أسفل الجرف في تلك اللّيلة

809
00:51:07,780 --> 00:51:11,850
،نُقلت مباشرةً إلى العيادة للعلاج

810
00:51:11,850 --> 00:51:15,420
،لكنّ إصاباتها كانت خطيرة جدًّا
.ولم تستفق أبدًا

811
00:51:17,510 --> 00:51:21,800
.يبدو أنّها كانت تقبض على هذه في يدها

812
00:51:23,810 --> 00:51:27,230
.قلت لها كلامًا فظيعًا تلك اللّيلة

813
00:51:27,230 --> 00:51:28,800
.جرحتُ مشاعرها

814
00:51:30,100 --> 00:51:33,440
.ولم تُتح لي الفرصة لأعتذر لها

815
00:51:36,800 --> 00:51:40,460
.يجب أن أوقظ أي مهما كان الثّمن

816
00:51:40,460 --> 00:51:44,340
.أوُ، ما زلت أريد أن أكون عونًا لك

817
00:51:46,280 --> 00:51:47,290
أوقعت في غرامي؟

818
00:51:47,290 --> 00:51:50,130
.نعم، أنا أحبّك. أنت تعرفين ذلك

819
00:51:56,170 --> 00:52:00,350
.لم أعد أخاف من النّوم هذه الأيّام

820
00:52:00,350 --> 00:52:05,940
.يمكنني أن أكون على طبيعتي بوجودك قربي

821
00:52:06,520 --> 00:52:11,570
.وما أشعر به نحوك هو ما يبقيني على طبيعتي

822
00:52:11,880 --> 00:52:12,810
...أوُ

823
00:52:28,080 --> 00:52:30,770
حسنًا... هل ستكونين بخير؟

824
00:52:31,300 --> 00:52:33,590
.نـ... نعم، أنا بخير

825
00:52:33,980 --> 00:52:37,090
.خصوصًا لأنّك كنت لطيفًا جدًّا

826
00:52:37,550 --> 00:52:39,590
.لا، أعني مع عائلتك

827
00:52:39,590 --> 00:52:41,450
.قضيتِ اللّيلة كلّها بالخارج

828
00:52:43,340 --> 00:52:46,750
!لا-لا تهتمّ! كلّ شيء على ما يرام
!هذا واجبي

829
00:52:46,750 --> 00:52:49,070
!نعم، نعم! لا بأس

830
00:52:49,070 --> 00:52:51,610
.أنت منحرفة فعلاً يا أوُ

831
00:52:51,920 --> 00:52:54,170
!أ-أ-أنا فتاة سليمة تمامًا

832
00:52:54,170 --> 00:52:56,610
!ولكن لديّ أفكار منحرفة أحيانًا

833
00:52:56,610 --> 00:53:00,580
...لـ-لكنّ تلك القبلة كانت قويّة بالفعل

834
00:53:00,580 --> 00:53:03,430
...أ-أعني، كانت رو

835
00:53:03,430 --> 00:53:06,230
.كنتُ بحاجة لأن تكون تجربتي الأولى

836
00:53:06,230 --> 00:53:09,640
..."إذًا، حين قلتِ "الرّو
.كنت تقصدين قبلة مليئة بالرّومانسيّة

837
00:53:11,450 --> 00:53:12,630
.شيروها

838
00:53:17,530 --> 00:53:19,740
.أفترض أن ليلتكما كانت ممتعة

839
00:53:19,740 --> 00:53:22,130
!لـ-لـ-ليست كما تظنّين

840
00:53:22,130 --> 00:53:22,760
.أوُ

841
00:53:22,760 --> 00:53:24,260
نـ-نعم؟

842
00:53:25,430 --> 00:53:26,430
.أنا سعيدة لأجلك

843
00:53:29,480 --> 00:53:31,560
.أعتذر على هذا الإعلان المبكّر

844
00:53:31,560 --> 00:53:35,320
،سوراكادو أوُ-سان
.يُرجى التّواصل مع العيادة فورًا

845
00:53:35,320 --> 00:53:39,070
!أكرّر، تواصلي مع العيادة يا أوُ

846
00:53:52,200 --> 00:53:53,900
كيف هي أي أيّها الطّبيب؟

847
00:53:53,900 --> 00:53:55,910
.تجاوزت مرحلة الخطر الآن

848
00:53:56,450 --> 00:53:59,600
أودّ التّحدّث بشأن ما حدث
.وخياراتنا المستقبليّة

849
00:53:59,600 --> 00:54:01,780
.مع العائلة، إن لم تمانعوا

850
00:54:05,220 --> 00:54:06,650
.لقد عدت

851
00:54:07,920 --> 00:54:09,930
.يبدو أنّك قضيتَ يومًا صعبًا

852
00:54:09,930 --> 00:54:10,860
.لا

853
00:54:10,860 --> 00:54:13,030
.لا شيء مقارنة بما تمرّ به أوُ

854
00:54:13,980 --> 00:54:16,040
هايري-سان، هل أنت بخير؟

855
00:54:16,040 --> 00:54:16,880
ماذا؟

856
00:54:19,040 --> 00:54:19,900
ما الّذي...؟

857
00:54:19,900 --> 00:54:20,860
...يا إلهي

858
00:54:21,180 --> 00:54:23,970
...أشعر بالنّعاس فجأة

859
00:54:28,780 --> 00:54:31,130
أين أنا؟

860
00:54:33,300 --> 00:54:36,560
!تاكاهارا-سان، أنت فاشل

861
00:54:37,380 --> 00:54:40,430
.أريحيني من هذا العذاب

862
00:54:41,310 --> 00:54:42,580
.أنا آسف

863
00:54:42,580 --> 00:54:45,380
.لم أستطع الاستمرار في انتظارك

864
00:54:46,920 --> 00:54:48,440
.صباح الخير

865
00:54:48,440 --> 00:54:51,030
!أعيدوا لي زوجتي! ابنتي

866
00:54:51,030 --> 00:54:52,320
.فقدت حياتي

867
00:54:52,320 --> 00:54:54,430
!لا أريد أن أكبر

868
00:54:54,430 --> 00:54:56,370
.يمكنني أن أكون حرًّا أخيرًا

869
00:54:56,370 --> 00:54:59,000
.كنت أودّ رؤيتك لمرّة أخيرة

870
00:55:03,780 --> 00:55:05,530
ما كان هذا الحلم الغريب؟

871
00:55:06,340 --> 00:55:07,430
مهلاً... الوقت ليل؟

872
00:55:09,220 --> 00:55:11,320
كم من الوقت كنتُ نائمًا؟

873
00:55:11,320 --> 00:55:11,880
ماذا؟

874
00:55:13,380 --> 00:55:14,640
...إنّها ليست

875
00:55:17,090 --> 00:55:18,330
!أوُ

876
00:55:19,160 --> 00:55:21,180
!أين أنت؟! أوُ

877
00:55:21,390 --> 00:55:22,930
!بون

878
00:55:23,390 --> 00:55:23,940
!إيناري

879
00:55:29,550 --> 00:55:30,230
!بون

880
00:55:33,210 --> 00:55:33,950
!أوُ

881
00:55:34,230 --> 00:55:34,970
!مهلاً

882
00:55:35,840 --> 00:55:36,920
هل أنت بخير؟

883
00:55:41,580 --> 00:55:44,080
كم رأيتِ من ذكرى يا ترى؟

884
00:55:46,330 --> 00:55:48,070
أوُ، هل أنت بخير؟

885
00:55:50,290 --> 00:55:51,830
...أمّي

886
00:55:51,830 --> 00:55:53,270
...أنا أفتقدك

887
00:55:53,530 --> 00:55:57,010
...أفتقدك

888
00:55:55,170 --> 00:55:56,200
أوُ؟

889
00:55:57,010 --> 00:55:58,330
...المكان مظلم

890
00:55:58,330 --> 00:56:00,060
...المكان مظلم هنا

891
00:56:00,060 --> 00:56:01,080
.أنا خائفة

892
00:56:01,080 --> 00:56:03,540
...برد... أشعر بالبرد

893
00:56:03,540 --> 00:56:08,290
...أفضّل أن أقتلك بدل أن تكوني لأحد آخر

894
00:56:08,290 --> 00:56:10,640
.أتمنى أن تصلها رسالتي

895
00:56:11,700 --> 00:56:14,030
.أنا متشوّق لردّها

896
00:56:14,860 --> 00:56:15,730
!أوُ

897
00:56:16,750 --> 00:56:18,850
...خدّي

898
00:56:18,850 --> 00:56:20,160
.آلمني ذلك

899
00:56:20,590 --> 00:56:22,150
...عفوًا

900
00:56:22,150 --> 00:56:23,580
...كيف

901
00:56:23,580 --> 00:56:24,830
...صحيح

902
00:56:24,830 --> 00:56:28,020
.يجب أن أسرع وأجد ذكرى أي

903
00:56:28,020 --> 00:56:29,040
!مهلاً

904
00:56:29,510 --> 00:56:31,710
اجلسي! لا يمكنك حتّى الوقوف
!بشكل مستقيم

905
00:56:32,130 --> 00:56:33,710
!لا وقت لديّ

906
00:56:34,150 --> 00:56:36,220
!سأفقد أي

907
00:56:37,250 --> 00:56:40,720
.قال الطّبيب أنّ علينا الاستعداد للأسوأ

908
00:56:41,080 --> 00:56:44,660
!لا أملك سنة أخرى

909
00:56:44,660 --> 00:56:46,230
!في هذا مخاطرة كبيرة

910
00:56:46,750 --> 00:56:49,030
!إن لم أخاطر الآن، فمتى؟

911
00:56:49,030 --> 00:56:53,110
لن يتبقّى لي شيء أخاطر به
!إن فقدت أي

912
00:56:53,110 --> 00:56:55,640
...أنا أفهم، لكن

913
00:56:56,950 --> 00:56:58,990
.على الأقلّ خذي قسطًا من الرّاحة. أرجوك

914
00:56:59,590 --> 00:57:01,120
.سأوقظك بنفسي

915
00:57:03,400 --> 00:57:06,600
تعدني بأنّك ستوقظني؟

916
00:57:06,600 --> 00:57:08,390
.نعم. أعدك

917
00:57:09,390 --> 00:57:10,380
.حسنًا

918
00:57:10,380 --> 00:57:12,570
...لبعض الوقت فحسب

919
00:57:13,250 --> 00:57:15,070
...شكرًا

920
00:57:29,100 --> 00:57:30,630
...يا أي

921
00:57:30,630 --> 00:57:32,800
.انظري كم تبذل أوُ من جهد

922
00:57:33,400 --> 00:57:35,800
تهتمّين لأمرها، أليس كذلك؟

923
00:57:35,800 --> 00:57:37,280
.اظهري رجاءً

924
00:57:39,750 --> 00:57:41,450
إيناري؟ ما الخطب؟

925
00:57:46,070 --> 00:57:46,950
.مستحيل

926
00:57:47,630 --> 00:57:49,790
.لا يمكنها لمس الشّيتشييتشو الآن

927
00:57:49,790 --> 00:57:50,810
!بون

928
00:57:52,290 --> 00:57:54,500
!سُحقًا! ابتعدي

929
00:57:57,400 --> 00:57:58,090
!بون

930
00:58:08,870 --> 00:58:09,790
!بون

931
00:58:14,360 --> 00:58:15,230
ما هذا؟

932
00:58:19,270 --> 00:58:21,610
هل... قمت بحمايتها؟

933
00:58:39,090 --> 00:58:40,470
أحلّ الصّباح؟

934
00:58:41,860 --> 00:58:43,140
!لـ-لماذا؟

935
00:58:43,140 --> 00:58:45,270
!قلتَ أنّك ستوقظني

936
00:58:45,270 --> 00:58:46,280
.لا بأس

937
00:58:46,280 --> 00:58:47,790
!بل هناك بأس كبير

938
00:58:47,790 --> 00:58:49,850
!ماذا لو حدث شيء لأي؟

939
00:58:50,330 --> 00:58:52,350
.أي هنا

940
00:58:53,700 --> 00:58:55,360
.انظري. هنا

941
00:58:55,850 --> 00:58:57,110
أين؟

942
00:58:58,670 --> 00:59:00,170
.لا أراها

943
00:59:02,000 --> 00:59:03,570
...هكذا إذًا

944
00:59:04,150 --> 00:59:06,120
.أعتقد أنّني لا أستطيع رؤيتها

945
00:59:06,780 --> 00:59:08,930
.لا عجب أنّني لم أجدها

946
00:59:08,930 --> 00:59:11,990
.كنت مغمضة العينين عنها

947
00:59:11,990 --> 00:59:14,460
،رغم أنّني أخبر نفسي أنّني أريد مساعدتها

948
00:59:14,460 --> 00:59:17,310
.لكنّني خائفة ممّا قد تفكّر فيه حقًّا

949
00:59:17,310 --> 00:59:20,500
.كلّ ما كنتُ أفكّر فيه هو نفسي

950
00:59:21,020 --> 00:59:22,680
.كم أنا دنيئة

951
00:59:22,680 --> 00:59:24,270
!هذا غير صحيح

952
00:59:25,620 --> 00:59:29,890
،لقد أرهقت نفسك دون تفكير
.وضحّيت بالكثير في سبيلها

953
00:59:29,890 --> 00:59:31,210
!لقد فعلتِ الكثير

954
00:59:31,210 --> 00:59:34,270
.لا تقولي أنّك دنيئة. بل أبليتِ بلاءً حسنًا

955
00:59:34,590 --> 00:59:35,850
...هايري

956
00:59:36,610 --> 00:59:39,440
!لكنّي لا أستطيع رؤية أي

957
00:59:40,340 --> 00:59:42,890
.سأساعدك على رؤيتها إذًا

958
00:59:43,360 --> 00:59:46,750
ستساعدني؟ كيف؟

959
00:59:59,030 --> 01:00:01,760
!تظنّين أنّني أكذب

960
01:00:02,570 --> 01:00:03,860
!أوُ-تشان

961
01:00:03,860 --> 01:00:05,510
.إنّها غلطتي

962
01:00:06,030 --> 01:00:10,140
كان عليّ تصديق أمر الفراشة المتوهّجة
.الّتي قالت أوُ-تشان أنّها رأتها

963
01:00:10,140 --> 01:00:12,700
.ما كانت أوُ-تشان لتكذب

964
01:00:13,330 --> 01:00:16,240
.إنّها تكره الكذب من الأساس

965
01:00:17,580 --> 01:00:20,340
.يجب أن أجد فراشة متوهّجة

966
01:00:20,340 --> 01:00:22,470
.أستطيع أن أجد واحدة لأجلها

967
01:00:22,470 --> 01:00:25,920
.وهكذا، لن يظنّ أحد أنّها تكذب بعد الآن

968
01:00:26,740 --> 01:00:31,040
لا أستطيع أن أكون سعيدة
.إن لم تكن أوُ-تشان سعيدة

969
01:00:31,560 --> 01:00:35,520
لا يمكنني أن أبتسم إن لم
.تستطع هي الابتسام

970
01:00:35,990 --> 01:00:39,370
.أنا أخت أوُ-تشان الكبرى

971
01:00:40,050 --> 01:00:44,670
وأواصل المضيّ قدمًا لأنّ
.أوُ-تشان تقول أنّني مدهشة

972
01:00:54,310 --> 01:00:57,490
.ما زال عليّ أن أجد فراشة

973
01:00:57,490 --> 01:00:59,860
.وما زال عليّ أن أتصالح مع أوُ-تشان

974
01:01:00,480 --> 01:01:03,760
...أوُ-تشان

975
01:01:06,100 --> 01:01:07,200
...أي

976
01:01:07,710 --> 01:01:13,200
...كانت أي تفكّر بي دائمًا

977
01:01:13,200 --> 01:01:16,540
.كانت أختك مذهلة حقًّا

978
01:01:17,540 --> 01:01:18,460
.نعم

979
01:01:19,020 --> 01:01:22,140
.أنا فخورة بها كثيرًا

980
01:01:25,340 --> 01:01:26,240
ما الأمر؟

981
01:01:27,650 --> 01:01:29,040
.يمكنني رؤيتها

982
01:01:31,050 --> 01:01:32,140
...أي

983
01:01:32,140 --> 01:01:33,440
أهذه أنت؟

984
01:01:36,720 --> 01:01:39,260
.لنعد إلى المنزل يا أي

985
01:01:47,510 --> 01:01:48,450
...والآن

986
01:01:49,170 --> 01:01:50,230
هل ستفعلينها؟

987
01:01:50,230 --> 01:01:52,030
.بطبيعة الحالة

988
01:01:55,490 --> 01:01:58,500
.استيقظي يا أي

989
01:02:12,840 --> 01:02:14,930
هل ستستيقظ أي الآن؟

990
01:02:15,510 --> 01:02:18,600
.أظنّ أنّ ذكرياتها قد عادت على الأقلّ

991
01:02:19,310 --> 01:02:20,560
...والآن

992
01:02:23,290 --> 01:02:25,090
.سأراقب أي

993
01:02:25,090 --> 01:02:25,940
.خذي قسطًا من الرّاحة

994
01:02:26,820 --> 01:02:28,400
.حسنًا

995
01:02:29,190 --> 01:02:31,260
.وأعدك أنّني سأوقظك هذه المرّة

996
01:02:34,660 --> 01:02:35,930
...أي

997
01:02:37,220 --> 01:02:38,990
.تصبحين على خير

998
01:02:50,490 --> 01:02:52,840
...هذا يُدغدغ

999
01:02:54,080 --> 01:02:55,230
.أوُ-تشان

1000
01:03:01,940 --> 01:03:02,590
!أي؟

1001
01:03:13,470 --> 01:03:14,910
...أوُ-تشان

1002
01:03:14,910 --> 01:03:16,970
.إنّك تؤلمينني بشدّة

1003
01:03:16,970 --> 01:03:17,980
!أي

1004
01:03:19,540 --> 01:03:21,600
.لا يمكنني التّنفّس يا أوُ-تشان

1005
01:03:21,600 --> 01:03:23,360
!أي! أي

1006
01:03:23,920 --> 01:03:26,540
.هناك الكثير ممّا أريد إخبارك به

1007
01:03:26,540 --> 01:03:29,290
.أردتُ أن أعتذر لك طوال هذا الوقت

1008
01:03:29,290 --> 01:03:29,990
...لكن

1009
01:03:30,290 --> 01:03:34,270
.شكرًا لك... لأنّك صدّقتني

1010
01:03:34,270 --> 01:03:37,640
.صدّقتني طوال هذا الوقت

1011
01:03:37,640 --> 01:03:38,790
.شكرًا لك

1012
01:03:38,790 --> 01:03:39,910
.لا

1013
01:03:40,510 --> 01:03:44,550
.أنت من قمت بالكثير من أجلي

1014
01:03:44,550 --> 01:03:46,840
.كنتُ أسمع صوتك طوال هذا الوقت

1015
01:03:47,260 --> 01:03:50,130
.كنتِ سندًا لي

1016
01:03:50,640 --> 01:03:54,640
.لقد عدتُ بفضلك

1017
01:03:55,080 --> 01:03:57,910
.شكرًا لك يا أوُ-تشان

1018
01:04:01,250 --> 01:04:04,510
أنت تاكاهارا هايري-سان، أليس كذلك؟

1019
01:04:04,510 --> 01:04:05,530
أتعرفينني؟

1020
01:04:05,920 --> 01:04:09,020
.كانت تحدّثني أوُ-تشان عنك باستمرار

1021
01:04:09,020 --> 01:04:12,320
.شكرًا لدعمك لها

1022
01:04:12,320 --> 01:04:13,790
.لم أفعل سوى ما كان ينبغي فعله

1023
01:04:13,790 --> 01:04:15,500
.لكنّني لا أوافق على علاقتكما

1024
01:04:16,420 --> 01:04:20,190
.أوُ-تشان أختي الحبيبة العزيزة على قلبي

1025
01:04:20,190 --> 01:04:22,570
لا بدّ أن يكون من يرتبط بها
.شخصًا يليق بها فعلاً

1026
01:04:22,570 --> 01:04:25,380
.يبدو أنّه لا يمكنني مخالفة ما تقوله أي

1027
01:04:27,070 --> 01:04:30,470
.لكن يا أي... هايري شخص طيّب حقًّا

1028
01:04:30,800 --> 01:04:33,180
.حتّى أنا وقعت في حبّه

1029
01:04:33,180 --> 01:04:36,690
.نعم، أعلم. ولذلك لن أمنعك

1030
01:04:38,290 --> 01:04:41,470
.الآن وقد ارتحت، بدأت أشعر بالنّعاس

1031
01:04:41,940 --> 01:04:46,700
...آسفة يا هايري، سأغفو قليلاً بعد

1032
01:04:46,700 --> 01:04:48,510
.حسنًا، لا بأس

1033
01:04:48,510 --> 01:04:50,670
.وأنا كذلك

1034
01:04:52,220 --> 01:04:57,040
.أي، لنتحدّث كثيرًا حين نستيقظ

1035
01:04:57,540 --> 01:05:00,460
.نعم... كثيرًا

1036
01:05:00,900 --> 01:05:03,380
.تصبحين على خير يا أي

1037
01:05:03,730 --> 01:05:06,380
.تصبحين على خير يا أوُ-تشان

1038
01:05:06,730 --> 01:05:10,740
.هايري، أيقظني ثانية

1039
01:05:11,910 --> 01:05:15,970
.كان استيقاظ أي خبرًا كبيرًا في الجزيرة

1040
01:05:16,800 --> 01:05:19,370
.ذُهل الأطبّاء بما حدث، ووصفوا الأمر بالمعجزة

1041
01:05:19,370 --> 01:05:22,590
.لكنّني كنت أعلم أنّه أكثر من ذلك

1042
01:05:24,490 --> 01:05:28,320
.أي... لقد استيقظتِ فعلاً

1043
01:05:28,320 --> 01:05:29,610
هل تتعرّفين إليّ؟

1044
01:05:29,610 --> 01:05:30,490
.نعم

1045
01:05:31,160 --> 01:05:32,910
ميكي-تشان، صحيح؟

1046
01:05:32,910 --> 01:05:35,410
وماذا عنّي يا أي؟

1047
01:05:35,410 --> 01:05:38,040
.أكيد. لم أرك منذ مدّة يا تنزن-تشان

1048
01:05:38,040 --> 01:05:40,660
!تخمين غير موفّق

1049
01:05:40,660 --> 01:05:43,750
.تركتُ أثرًا أقوى لديها فحسب

1050
01:05:43,750 --> 01:05:48,260
بصراحة، كلّ ما أتذكّره
.هو أنّه كان هنالك صبيَّين

1051
01:05:48,260 --> 01:05:50,050
.ولم أهتمّ أبدًا للتّمييز بينكما

1052
01:05:51,530 --> 01:05:54,450
كنا أصدقاء في الطّفولة، أليس كذلك؟

1053
01:05:54,450 --> 01:05:55,180
أليس كذلك؟

1054
01:05:55,180 --> 01:05:57,260
.أنتما فقط تابعا أوُ-تشان المضحكين

1055
01:05:57,260 --> 01:05:58,560
!لسنا حتّى صديقيها؟

1056
01:06:00,110 --> 01:06:01,400
.إنّها مستيقظة فعلاً

1057
01:06:01,400 --> 01:06:03,230
...شيروها-تشان

1058
01:06:03,230 --> 01:06:04,860
.مرّ وقت طويل

1059
01:06:05,170 --> 01:06:06,490
.بالفعل

1060
01:06:06,950 --> 01:06:07,880
.أراكِ لاحقًا

1061
01:06:07,880 --> 01:06:09,390
أهذا كلّ شيء؟

1062
01:06:09,390 --> 01:06:12,780
.كما ترى... يوجد الكثير من النّاس هنا

1063
01:06:12,780 --> 01:06:16,360
تظاهري بأنّ الرّجال مجرّد
.تماثيل ضفادع للزّينة

1064
01:06:16,360 --> 01:06:17,410
!هذا فظيع

1065
01:06:19,040 --> 01:06:20,660
.يبدو أنّ أوُ نائمة

1066
01:06:20,660 --> 01:06:21,790
.نعم

1067
01:06:21,790 --> 01:06:24,670
.لا أصدّق أنّها نائمة في وقت كهذا

1068
01:06:24,940 --> 01:06:25,960
.نعم

1069
01:06:25,960 --> 01:06:27,920
.لا يسعني الانتظار حتّى تستيقظ

1070
01:06:28,510 --> 01:06:34,260
وهكذا، واصلنا نتبادل الحديث في غرفة
.المستشفى الّتي جمعت الأختين

1071
01:06:35,220 --> 01:06:37,510
...كنّا ننتظر أن تستيقظ أوُ

1072
01:06:38,920 --> 01:06:43,520
.لكنّها لم تستيقظ ذلك اليوم

1073
01:06:48,900 --> 01:06:51,410
.كان عليك الانتظار أكثر بعد أن طرقت الباب

1074
01:06:51,410 --> 01:06:52,410
.هذا تصرّف غير لائق

1075
01:06:52,410 --> 01:06:54,020
.عفوًا، أنا آسف

1076
01:06:54,020 --> 01:06:56,290
هل كنت تأمل أن تختلس
نظرة أو شيئًا كهذا؟

1077
01:07:00,580 --> 01:07:04,900
لست متأكّدة من السّبب، لكنّني لا أستطيع
.إلاّ أن أشعر ببعض الضّيق تجاهك

1078
01:07:04,900 --> 01:07:06,450
.واثق أنّ ذلك مجرّد شعور

1079
01:07:06,450 --> 01:07:07,960
على أيّ حال، كيف حال أوُ؟

1080
01:07:07,960 --> 01:07:09,670
.ما زالت ظريفة كعادتها

1081
01:07:09,970 --> 01:07:11,450
.أعرف ذلك

1082
01:07:11,450 --> 01:07:12,470
...أعني

1083
01:07:14,970 --> 01:07:16,390
.فهمت

1084
01:07:16,390 --> 01:07:18,120
.مرّ يومان كاملان

1085
01:07:18,120 --> 01:07:20,770
لا أصدّق أنّها ما زالت نائمة
...كلّ هذا الوقت

1086
01:07:20,770 --> 01:07:23,730
.لم يحدث هذا أبدًا منذ أن التقيتُها على الأقلّ

1087
01:07:24,080 --> 01:07:28,520
قال الطّبيب أنّ السّبب غير
.معروف، كما كان الحال معي

1088
01:07:28,980 --> 01:07:32,740
لكن لا بدّ أنّها الشّيتشييتشو، أليس كذلك؟

1089
01:07:32,740 --> 01:07:34,240
هل أخبرتك أوُ؟

1090
01:07:34,560 --> 01:07:37,450
.نعم. بينما أنا نائمة

1091
01:07:37,450 --> 01:07:40,960
.يبدو أنّ النّوم ضروريّ لترتيب الذّكريات

1092
01:07:40,960 --> 01:07:45,460
.ربّما لم تتمكّن بعد من تنظيم كلّ الذّكريات

1093
01:07:47,600 --> 01:07:49,050
.إنّه خطئي

1094
01:07:49,340 --> 01:07:51,100
.لا تقولي ذلك

1095
01:07:51,100 --> 01:07:53,340
.هذا يعني إنكار كلّ ما بذلتْه من جهد

1096
01:07:53,840 --> 01:07:55,300
.آسفة

1097
01:07:55,300 --> 01:07:57,570
.ستستيقظ أوُ

1098
01:07:57,570 --> 01:08:00,580
.وما عليك سوى شكرها عندما تستيقظ

1099
01:08:00,580 --> 01:08:02,720
.سيكون ذلك كافيًا لتعويضها

1100
01:08:02,720 --> 01:08:04,060
...هايري-سان

1101
01:08:04,420 --> 01:08:06,360
.عودي إلينا قريبًا، من فضلك

1102
01:08:06,360 --> 01:08:10,610
قطعنا وعدًا بأن نواعد بعضنا حقًّا
حين نجد ذكريات أي، أليس كذلك؟

1103
01:08:10,610 --> 01:08:11,260
ماذا؟

1104
01:08:11,260 --> 01:08:13,680
.إنّنا نعيش لحظة مؤثّرة هنا، اصمتي قليلاً

1105
01:08:13,680 --> 01:08:15,020
.أعتذر

1106
01:08:15,020 --> 01:08:17,570
.لكنّني سمعت للتّوّ شيئًا يصعب عليّ تقبّله

1107
01:08:17,860 --> 01:08:21,100
بما أنّ أوُ-تشان هي نوعك المفضّل
،من الفتيات وأنا أختها التّوأم

1108
01:08:21,100 --> 01:08:23,490
فهل هذا يعني أنّك واقع في حبّي أيضًا؟

1109
01:08:23,490 --> 01:08:24,740
ما الّذي يجعلك تظنّين ذلك؟

1110
01:08:24,740 --> 01:08:26,300
...معك حقّ

1111
01:08:26,300 --> 01:08:29,090
.لن أمانع، طالما أنّ أوُ-تشان معنا

1112
01:08:29,090 --> 01:08:30,710
.سيتسنّى لك أن تكون مع فتاتين جميلتين

1113
01:08:30,710 --> 01:08:32,260
.هذه ليست مزحة جيّدة

1114
01:08:32,260 --> 01:08:33,260
.لا أمزح إطلاقًا

1115
01:08:35,920 --> 01:08:38,720
،أفضّل أن أبقى وفيًّا لأوُ-تشان
.على الأقلّ في الوقت الحاليّ

1116
01:08:38,720 --> 01:08:41,850
.وأنا كذلك، أرغب أن أكون وفيّة لها أيضًا

1117
01:08:43,190 --> 01:08:47,430
،على كلّ حال
.نحتاج لأن تستيقظ قبل أيّ شيء

1118
01:08:47,430 --> 01:08:48,860
.معك حقّ

1119
01:08:52,610 --> 01:08:53,300
!بون

1120
01:08:54,590 --> 01:08:55,530
تانوكي؟

1121
01:08:55,880 --> 01:08:57,120
.لا، بل ثعلب

1122
01:08:57,120 --> 01:09:00,390
كان يساعدنا في البحث عن
.الشّيتشييتشو طوال هذا الوقت

1123
01:09:00,390 --> 01:09:01,500
.اسمه إيناري

1124
01:09:01,500 --> 01:09:03,760
.سمعت بهذا الاسم من قبل

1125
01:09:03,760 --> 01:09:06,180
.ظننتُ أنّه قد يكون مشتاقًا لأوُ

1126
01:09:06,180 --> 01:09:08,630
.لكن لا تخبري الأطبّاء

1127
01:09:11,020 --> 01:09:12,760
لا يمكنك إيقاظها أيضًا، صحيح؟

1128
01:09:16,910 --> 01:09:20,600
لكن بدأت أوُ-تشان تتحدّث
.في نومها كثيرًا مؤخّرًا

1129
01:09:20,930 --> 01:09:22,270
فعلاً؟

1130
01:09:22,270 --> 01:09:24,900
.كانت تتمتم باسمك

1131
01:09:25,470 --> 01:09:26,350
اسمي؟

1132
01:09:26,350 --> 01:09:30,310
يا إلهي، تراني حتّى في أحلامها؟

1133
01:09:31,400 --> 01:09:33,900
لكن ما الّذي كانت تعنيه
بقولها "لا يمكننا في الخارج"؟

1134
01:09:34,450 --> 01:09:35,640
.إنّها تحلم فقط

1135
01:09:35,640 --> 01:09:38,450
وما الشّيء الّذي هي "متحمّسة" لأجله؟

1136
01:09:38,450 --> 01:09:39,680
.إنّه حلم

1137
01:09:39,680 --> 01:09:42,070
وما الّذي تريد "فعله مجدّدًا"؟

1138
01:09:42,070 --> 01:09:43,950
!إنّها تحلم

1139
01:09:45,200 --> 01:09:46,790
!أصبحت أوُ-تشان ملوّثة

1140
01:09:46,790 --> 01:09:49,790
تمهّلي! إن كان هنالك من
...بادر بأيّ شيء

1141
01:09:50,540 --> 01:09:51,500
.يا ويحي

1142
01:09:54,980 --> 01:10:00,350
،هايري-سان، إن لم يكن لديك مانع
هل يمكنك التّحدّث إليها قليلاً؟

1143
01:10:00,350 --> 01:10:03,510
التّحدّث إليها؟ لا أدري... عمّاذا مثلاً؟

1144
01:10:03,510 --> 01:10:08,390
عن أيّ شيء يقنعها بأنّ العالم
.أكثر متعة من أحلامها

1145
01:10:08,830 --> 01:10:10,050
.مفهوم

1146
01:10:10,050 --> 01:10:12,770
...لا أدري بشأن كونه أكثر متعة

1147
01:10:13,700 --> 01:10:16,530
.لكنّي اعتدتُ ممارسة السّباحة

1148
01:10:16,530 --> 01:10:22,050
بمجرّد أن دخلتُ الثّانويّة، اختاروني
.للمشاركة في سباق التّتابع

1149
01:10:22,800 --> 01:10:24,270
هذا ليس سيئًا، صحيح؟

1150
01:10:24,270 --> 01:10:27,590
...لكن في إحدى المنافسات الصّيفيّة

1151
01:10:28,870 --> 01:10:32,860
.شكرًا لأنّك تحدّثت مع أوُ

1152
01:10:32,860 --> 01:10:36,230
.لا بأس، كانت فرصة جميلة بالنّسبة لي أيضًا

1153
01:10:36,230 --> 01:10:38,300
.لكن لا أعلم إن كان لذلك أيّ أثر حقيقيّ

1154
01:10:38,580 --> 01:10:42,930
.أنا متأكّدة من أنّها سعيدة بمعرفة المزيد عنك

1155
01:10:43,290 --> 01:10:48,160
.لطالما تأثّرت بإصرار أوُ الصّادق

1156
01:10:48,160 --> 01:10:50,350
.لديها قوّة لا أملكها أنا

1157
01:10:50,790 --> 01:10:53,200
.وأعتقد أنّ تلك القوّة هي ما شدّني إليها

1158
01:10:53,200 --> 01:10:54,070
.نعم

1159
01:10:54,070 --> 01:10:55,790
.أنا فخورة بها

1160
01:11:00,170 --> 01:11:01,740
...هايري

1161
01:11:02,310 --> 01:11:03,400
أوُ؟

1162
01:11:03,400 --> 01:11:07,440
...معًا إلى الأبد

1163
01:11:07,440 --> 01:11:09,000
إنّها تحلم، أليس كذلك؟

1164
01:11:09,280 --> 01:11:13,580
...قهوة عند الشّروق

1165
01:11:14,960 --> 01:11:16,460
.نعم، فلنجرّب ذلك

1166
01:11:16,460 --> 01:11:17,380
المعذرة؟

1167
01:11:17,750 --> 01:11:20,880
.لذلك تجاوزي كلّ الأمور الجيّدة

1168
01:11:21,820 --> 01:11:23,390
.لقد جرّبت المراسم بنفسي

1169
01:11:24,030 --> 01:11:26,640
.أظنّ أنّه حتّى أنا أستطيع القيام بها

1170
01:11:26,640 --> 01:11:27,720
.بون

1171
01:11:30,410 --> 01:11:32,890
.واحدة أخرى

1172
01:11:33,230 --> 01:11:36,780
.لا أحتاج حتّى للمسها مثل أوُ

1173
01:11:36,780 --> 01:11:37,900
!بون

1174
01:11:47,060 --> 01:11:50,870
.أوشكت الزّهور أن تتساقط كلّها

1175
01:11:51,520 --> 01:11:55,380
أظنّ أنّ هذا يعني أنّ طقوس
.الجبل اقتربت من نهايتها

1176
01:11:55,380 --> 01:11:56,660
...لا

1177
01:11:56,660 --> 01:11:58,620
.إنّها ليست نهاية المهرجان فحسب

1178
01:11:59,510 --> 01:12:02,340
.توشك العطلة الصّيفيّة أن تنتهي أيضًا

1179
01:12:03,440 --> 01:12:07,510
.وبانتهائها، سأضطرّ إلى العودة إلى منزلي

1180
01:12:08,810 --> 01:12:11,930
ستستيقظين قبل ذلك، أليس كذلك يا أوُ؟

1181
01:12:18,430 --> 01:12:19,190
.تفضّل

1182
01:12:20,750 --> 01:12:21,480
!أوُ

1183
01:12:24,160 --> 01:12:25,570
هل أفرطتُ في النّوم؟

1184
01:12:27,190 --> 01:12:28,360
أوُ-تشان؟

1185
01:12:28,830 --> 01:12:30,510
.آسفة يا أي

1186
01:12:30,510 --> 01:12:34,700
استيقظتِ أخيرًا، ولكنّي خلدتُ
.في نوم طويل بعدها مباشرة

1187
01:12:34,990 --> 01:12:36,080
.لا بأس

1188
01:12:36,910 --> 01:12:40,050
.تسنّى لي سماع صوتك

1189
01:12:40,720 --> 01:12:42,000
.أنا بخير الآن

1190
01:12:43,010 --> 01:12:44,460
.سأذهب لأُحضر الطّبيب

1191
01:12:44,460 --> 01:12:45,610
.انتظر

1192
01:12:46,430 --> 01:12:50,070
.أريد أن أتنفّس هواءً نقيًّا أوّلاً

1193
01:12:50,070 --> 01:12:51,070
...حسنًا

1194
01:12:51,070 --> 01:12:52,430
هل أفتح النّافذة؟

1195
01:12:52,690 --> 01:12:56,180
.لا، أقصد أنّني أريد الخروج في نزهة قصيرة

1196
01:12:57,870 --> 01:12:59,050
...لذلك

1197
01:13:00,720 --> 01:13:02,150
.احملني

1198
01:13:04,650 --> 01:13:08,790
.أتذكّر كلّ ما فعلته من أجلي

1199
01:13:08,790 --> 01:13:10,400
لم تقولين ذلك الآن؟

1200
01:13:11,200 --> 01:13:14,410
،لا أستطيع الحركة بسهولة بعد
.لكنّني سأبذل جهدي

1201
01:13:16,270 --> 01:13:18,370
.سأفعل ما تفعلينه أنت تمامًا

1202
01:13:19,530 --> 01:13:20,780
.حسنًا

1203
01:13:22,270 --> 01:13:23,930
.هذا أمر يستحقّ التّرقّب

1204
01:13:25,030 --> 01:13:28,180
،لا أمانع الخروج قليلاً
.لكن ليس لوقت طويل

1205
01:13:28,180 --> 01:13:29,680
.كنت نائمة لفترة طويلة

1206
01:13:29,680 --> 01:13:30,760
.فلا ترهقي نفسك

1207
01:13:30,760 --> 01:13:33,890
.أرجوك، افعل هذا من أجلها، ولو للحظات

1208
01:13:34,270 --> 01:13:37,310
.ما دامت لا تزال قادرة على البقاء مستيقظة

1209
01:13:37,310 --> 01:13:40,330
ماذا؟ عمّ تتحدّثان؟

1210
01:13:42,070 --> 01:13:43,770
ما الّذي تفعله هنا؟

1211
01:13:43,770 --> 01:13:45,820
...مهلاً، أوُ

1212
01:13:45,820 --> 01:13:46,940
...أهذه

1213
01:13:47,520 --> 01:13:50,240
.لمستُ الكثير من الذّكريات

1214
01:13:50,240 --> 01:13:52,700
.يعجّ رأسي بالفوضى

1215
01:13:53,120 --> 01:13:55,950
.أسمع أصوات النّاس باستمرار

1216
01:13:55,950 --> 01:13:58,200
.من الصّعب أن أتمسّك بذاتي

1217
01:13:58,500 --> 01:13:59,520
...أوُ

1218
01:13:59,520 --> 01:14:00,580
...لا

1219
01:14:01,050 --> 01:14:06,580
يجب أن أعيد هذه إلى ملاذها
.بينما لا أزال مستيقظة

1220
01:14:07,470 --> 01:14:09,340
.أنت الوحيد الّذي يمكنني الاعتماد عليه

1221
01:14:09,340 --> 01:14:10,670
...لا

1222
01:14:10,670 --> 01:14:12,380
.انسي ذلك الآن

1223
01:14:12,380 --> 01:14:13,720
!علينا أن نفعل شيئًا لأجلك أنتِ

1224
01:14:13,720 --> 01:14:14,630
.هايري-سان

1225
01:14:15,920 --> 01:14:17,580
.أرجوك

1226
01:14:17,580 --> 01:14:20,850
.حقّق لها هذه الأمنيّة لو سمحت

1227
01:14:23,240 --> 01:14:25,680
علينا الذّهاب إلى مايوي تاتشيبانا فحسب، صحيح؟

1228
01:14:27,190 --> 01:14:30,270
ربّما يمكننا أن نسلك بعض الطرق
.الجانبيّة ونحن بصدد هذا

1229
01:14:30,270 --> 01:14:31,650
طرق جانبيّة؟

1230
01:15:23,160 --> 01:15:24,570
...حسنًا

1231
01:15:25,120 --> 01:15:25,660
أوُ؟

1232
01:15:29,960 --> 01:15:31,670
.أ-أنا بخير

1233
01:15:32,910 --> 01:15:36,760
.لكن قد أحتاجك أن تُسرع قليلاً

1234
01:15:42,430 --> 01:15:43,600
!بون

1235
01:15:43,600 --> 01:15:45,880
.أوُ، إنّه إيناري

1236
01:15:46,890 --> 01:15:47,880
!بون

1237
01:15:49,200 --> 01:15:50,650
.إيناري

1238
01:15:52,740 --> 01:15:56,190
أقلقتك عليّ أيضًا، صحيح؟

1239
01:15:57,830 --> 01:16:01,150
.شكرًا لأنّك ساعدتني كثيرًا

1240
01:16:02,780 --> 01:16:05,840
إيناري، هل يمكنك أن تأخذنا
إلى مايوي تاتشيبانا؟

1241
01:16:05,840 --> 01:16:07,840
!بون

1242
01:16:20,180 --> 01:16:25,850
أعتقد أنّ هذا هو المكان الّذي
.رأيتك فيه تؤدّين الطّقس لأوّل مرّة

1243
01:16:25,850 --> 01:16:30,940
...قلت لك ألاّ تأتي إلى هنا، لكنّك

1244
01:16:32,510 --> 01:16:36,640
.لا تستمع إليّ إطلاقًا

1245
01:16:36,640 --> 01:16:39,820
.لكنّني قضيت صيفًا جميلاً

1246
01:16:39,820 --> 01:16:46,730
قضينا الوقت معًا كلّ يوم
...وفعلنا أشياء غبيّة ومتهوّرة

1247
01:16:46,730 --> 01:16:50,960
.وكنتَ دائمًا بجانبي حين أغفو

1248
01:16:51,630 --> 01:16:52,830
.شكرًا لك

1249
01:16:53,120 --> 01:16:57,200
كما تعلمين، عليّ العودة إلى منزلي
.بعد العطلة الصّيفيّة

1250
01:16:59,100 --> 01:17:02,480
،لكنّي سأسعى للحصول على عمل
.وسأعود في نهايات الأسبوع

1251
01:17:03,890 --> 01:17:08,880
...في الخريف، في الشّتاء، في الرّبيع
.سأقضيها معك كلّها في الجزيرة

1252
01:17:08,880 --> 01:17:12,350
.وسنقضي صيفًا آخر معًا، كما فعلنا هذا العام

1253
01:17:13,780 --> 01:17:16,040
.هذا يُسعدني كثيرًا

1254
01:17:16,040 --> 01:17:18,230
...لكنّني سأكون

1255
01:17:18,230 --> 01:17:24,120
حتّى وإن بقيت نائمة، فسأكون
.هنا على هذه الجزيرة

1256
01:17:24,120 --> 01:17:25,370
.هايري

1257
01:17:25,860 --> 01:17:29,040
.سيكون من واجبي أن أوقظك

1258
01:17:29,310 --> 01:17:32,250
.ابدأ بلُطف

1259
01:17:32,500 --> 01:17:34,350
.سأكون دائمًا لطيفًا

1260
01:17:34,350 --> 01:17:38,050
.لكنّ ذلك قد يصبح مملاًّ مع الوقت

1261
01:17:54,450 --> 01:17:56,030
.ها قد وصلنا يا أوُ

1262
01:17:56,730 --> 01:17:58,230
.مايوي تاتشيبانا

1263
01:18:01,830 --> 01:18:02,490
أوُ؟

1264
01:18:05,570 --> 01:18:07,070
...عددها كثير

1265
01:18:07,070 --> 01:18:08,160
منذ متى كانت هكذا؟

1266
01:18:10,160 --> 01:18:11,310
!هـ-هيّا

1267
01:18:11,310 --> 01:18:12,560
—ما الّذي تـ

1268
01:18:16,990 --> 01:18:18,210
...ما الّذي

1269
01:18:20,120 --> 01:18:24,720
أهذه كلّ الذّكريات الّتي لم تستطع
تجاوزها في نومها، تتدفّق الآن خارجها؟

1270
01:18:24,720 --> 01:18:29,960
في هذه الحالة، ربّما إن غادرت كلّ
.الشّيتشييتشو جسد أوُ، فستستفيق

1271
01:18:33,720 --> 01:18:34,440
إيناري؟

1272
01:18:37,910 --> 01:18:38,840
!أوُ

1273
01:18:38,840 --> 01:18:39,800
!استيقظي

1274
01:18:39,800 --> 01:18:42,530
لا تزال ذكرياتك بداخلك، أليس كذلك؟

1275
01:18:43,040 --> 01:18:43,910
!أوُ

1276
01:18:47,130 --> 01:18:48,250
...كلاّ

1277
01:18:48,250 --> 01:18:49,520
أهي بينها؟

1278
01:18:50,450 --> 01:18:51,450
!هذا لا يمكن

1279
01:18:51,760 --> 01:18:52,830
!انتظري

1280
01:18:52,830 --> 01:18:55,000
!أوُ

1281
01:18:57,790 --> 01:19:00,600
.هاجمني وأنا نائمة

1282
01:19:00,600 --> 01:19:04,050
لكنّه أيضًا كان قلقًا عليّ؟

1283
01:19:04,330 --> 01:19:05,970
.يا له من غريب

1284
01:19:05,970 --> 01:19:09,690
،رآني أخلع ملابسي
.ثمّ رشقني بالثّلج المبشور

1285
01:19:09,690 --> 01:19:10,860
!ماذا؟

1286
01:19:11,840 --> 01:19:14,180
...مع ذلك، استمتعت بوقتي نوعًا ما

1287
01:19:14,180 --> 01:19:17,060
ها هو ذا يتحمّس كثيرًا من أجل
.مجموعة أطفال. يا له من طفل

1288
01:19:17,060 --> 01:19:20,940
لكنّك كنت تنوي الخسارة بالفعل، أليس كذلك؟

1289
01:19:20,940 --> 01:19:23,520
.على الأقلّ، أعلم الآن أنّك لستَ شخصًا سيّئًا

1290
01:19:24,110 --> 01:19:26,280
!قـ-قال أنّني جميلة

1291
01:19:26,280 --> 01:19:28,570
...وسأل إن كان يستطيع لمسي

1292
01:19:28,570 --> 01:19:30,280
!كان يقصد التّونبوداما؟

1293
01:19:30,280 --> 01:19:32,120
!خفق قلبي بقوّة

1294
01:19:32,120 --> 01:19:34,790
!لا أصدّق أنّني سمعت ذلك

1295
01:19:34,790 --> 01:19:36,260
ماذا عليّ أن أفعل؟

1296
01:19:36,260 --> 01:19:38,090
!قال أنّه يحبّني

1297
01:19:38,090 --> 01:19:39,620
كيف أشعر أنا؟

1298
01:19:39,620 --> 01:19:41,320
...أنا

1299
01:19:41,320 --> 01:19:43,670
.لا أعلم بعد

1300
01:19:43,670 --> 01:19:45,320
!نحن نعانق بعضنا

1301
01:19:45,320 --> 01:19:46,170
!إنّه دافئ جدًّا

1302
01:19:46,170 --> 01:19:47,220
!وقويّ

1303
01:19:47,480 --> 01:19:49,390
!يخفق قلبي بشدّة

1304
01:19:49,390 --> 01:19:50,830
!حمدًا على هذا

1305
01:19:50,830 --> 01:19:52,140
.هايري بخير

1306
01:19:52,140 --> 01:19:54,680
...أشعر براحة تامّة

1307
01:19:54,680 --> 01:19:55,770
.هذا ليس عدلاً

1308
01:19:55,770 --> 01:19:58,600
كيف لي أن أقول "لا" لذلك؟

1309
01:19:59,710 --> 01:20:01,770
.كلاّ، هذا سيّئ

1310
01:20:01,770 --> 01:20:04,010
.أنا أرتعش بسبب هذا

1311
01:20:04,650 --> 01:20:06,360
.أنا سعيدة للغاية

1312
01:20:06,770 --> 01:20:08,580
.هذه نعمة حقيقيّة

1313
01:20:08,580 --> 01:20:11,720
.أشعر بالأمان ما دام هايري بجانبي

1314
01:20:12,120 --> 01:20:13,620
.أنا أحبّه

1315
01:20:14,270 --> 01:20:16,200
.تبادلنا قبلة للتّوّ

1316
01:20:16,920 --> 01:20:19,080
.أريد أن أكون مع هايري

1317
01:20:19,630 --> 01:20:20,790
.حتّى بعد انتهاء الصّيف

1318
01:20:20,790 --> 01:20:22,590
.أريد أن أكون معه إلى الأبد

1319
01:20:22,590 --> 01:20:25,640
...هايري... هايري

1320
01:20:26,670 --> 01:20:28,300
.أنا آسفة

1321
01:20:28,300 --> 01:20:31,140
.سأحبّك دائمًا

1322
01:20:37,470 --> 01:20:38,700
...أوُ

1323
01:20:38,700 --> 01:20:41,080
أكانت تلك ذكرياتك؟

1324
01:20:41,820 --> 01:20:43,650
هل كنت تفكرين بي إلى هذا الحدّ؟

1325
01:20:48,300 --> 01:20:50,440
.هذا ليس وداعًا

1326
01:20:50,440 --> 01:20:51,530
.لا تعتذري

1327
01:20:52,990 --> 01:20:55,050
ستخلدين للنّوم فحسب، صحيح؟

1328
01:20:57,160 --> 01:20:59,380
.هيّا نعد إلى المنزل يا أوُ

1329
01:21:05,630 --> 01:21:06,750
...أوُ-تشان

1330
01:21:07,580 --> 01:21:09,300
.امنحيني عامًا واحدًا

1331
01:21:09,300 --> 01:21:12,140
.ستُزهر مايوي تاتشيبانا ثانية

1332
01:21:12,140 --> 01:21:15,300
.وعندها، سأجد أوُ خلال طقس الجبل

1333
01:21:16,660 --> 01:21:19,270
تفكرين في الشّيء نفسه، أليس كذلك؟

1334
01:21:19,270 --> 01:21:22,110
.سأقوم بما فعلته أوُ-تشان من أجلي فحسب

1335
01:21:22,110 --> 01:21:24,190
.سأردّ المعروف فحسب

1336
01:21:24,480 --> 01:21:27,190
حسنًا، سيتعيّن عليك الاجتهاد
.في علاجك الطّبيعيّ

1337
01:21:30,180 --> 01:21:32,950
.هايري-سان، أودّ أن أطلب منك معروفًا

1338
01:21:34,250 --> 01:21:37,740
.واصل زيارة أوُ-تشان من فضلك

1339
01:21:38,180 --> 01:21:42,510
.أخبرها بما تراه وتسمعه وتعيشه

1340
01:21:42,510 --> 01:21:46,880
.املأ الفراغات من أجلها بينما هي نائمة

1341
01:21:47,600 --> 01:21:53,400
أُفضّل لو استطعتُ أن أُعيد
.لها الوقت الّذي منحَتني إيّاه

1342
01:21:54,030 --> 01:21:56,760
.لكنّني لا أستطيع المشي جيّدًا بعد

1343
01:21:57,470 --> 01:21:58,880
.لا داعي للقلق

1344
01:21:58,880 --> 01:22:00,480
.كنت أتحدّث معها عن هذا الأمر

1345
01:22:01,160 --> 01:22:04,130
،سأعود إلى منزلي بعد انتهاء عطلة الصّيف

1346
01:22:04,130 --> 01:22:07,900
لكنّني سأبحث عن عمل بدوام جزئي لتوفير
.المال لقضاء عطلات نهاية الأسبوع هنا

1347
01:22:07,900 --> 01:22:12,280
سأقضي الخريف والشّتاء والرّبيع
.على هذه الجزيرة معها

1348
01:22:12,280 --> 01:22:15,910
.ثمّ سنقضي الصّيف القادم معًا مرّة أخرى

1349
01:22:15,910 --> 01:22:17,530
...هايري-سان

1350
01:22:17,910 --> 01:22:21,540
.كما أنّ هنالك أمرًا وعدتُها به قبل ذلك

1351
01:22:22,030 --> 01:22:25,530
.إنّ إيقاظها هو واجبي دائمًا

1352
01:22:30,920 --> 01:22:32,370
.لا داعي للقلق

1353
01:22:32,370 --> 01:22:34,430
.واثقة أنّه سيجدك

1354
01:22:38,820 --> 01:22:40,120
...سأكون

1355
01:22:40,660 --> 01:22:41,370
.نعم

1356
01:22:41,880 --> 01:22:43,370
.ما زلتُ بخير

1357
01:27:38,890 --> 01:27:41,030
حسنًا، أتريدين أن نبدأ؟

1358
01:27:50,580 --> 01:27:52,990
.كنتُ أسمع صوتًا طوال الوقت

1359
01:27:54,150 --> 01:27:56,860
.صوتًا يبعث في نفسي الطّمأنينة

1360
01:27:56,860 --> 01:27:58,820
.صوتًا أحببته

1361
01:27:58,820 --> 01:28:01,570
.صوتًا كان يرسم الابتسامة على وجهي

1362
01:28:01,570 --> 01:28:05,000
.نورًا لطيفًا يهزّ قلبي برفق

1363
01:28:05,510 --> 01:28:08,260
...كان يخنقني بقدر قليل جدًّا

1364
01:28:09,830 --> 01:28:12,780
.لكنّ الدّفء كان يسري في جسدي

1365
01:28:13,390 --> 01:28:16,470
.أعلم تمامًا ما سأقوله أوّلاً

1366
01:28:16,470 --> 01:28:18,800
.ما كنتُ أقوله طوال هذا الوقت

