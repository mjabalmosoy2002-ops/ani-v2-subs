.أريد تذكّر صوتك

1207
01:10:03,890 --> 01:10:07,010
.أريد تذكّر صوتك أيضًا

1208
01:10:08,710 --> 01:10:10,890
.أحبّك يا تسوموغي

1209
01:10:11,150 --> 01:10:13,770
.أحبّك كثيرًا يا هايري-سان

1210
01:10:30,880 --> 01:10:32,680
.يبدو أنّ الوقت قد حان

1211
01:10:32,680 --> 01:10:34,940
هل سيحدث أمر ما؟

1212
01:10:34,940 --> 01:10:36,440
من يدري؟

1213
01:10:36,440 --> 01:10:37,460
.لا أطيق الانتظار

1214
01:10:37,750 --> 01:10:39,150
.موغيو

1215
01:10:39,150 --> 01:10:41,710
.إنّك تتصرّف بلؤم يا هايري-سان

1216
01:11:07,820 --> 01:11:09,910
.هذا مذهل

1217
01:11:09,910 --> 01:11:12,100
.اليوم هو عيد ميلادك

1218
01:11:13,130 --> 01:11:14,880
.لذلك علينا الاحتفال

1219
01:11:15,270 --> 01:11:18,860
بكعكة عيد ميلاد تحمل شموعًا
.بعدد سنوات العمر كلّها

1220
01:11:18,860 --> 01:11:21,920
عيد ميلادي؟

1221
01:11:22,740 --> 01:11:26,370
كيف عثرت على كلّ هذه الشّموع من الأساس؟

1222
01:11:26,370 --> 01:11:28,300
.بمساعدة رابطة الشّباب

1223
01:11:28,300 --> 01:11:29,750
ساعدوك على ذلك؟

1224
01:11:29,750 --> 01:11:34,260
كانوا موافقين جميعًا على فكرة
.شيزوكو لإسعادك

1225
01:11:35,000 --> 01:11:37,600
.لقد صنعوا هذه باستعمال علب بارينغلز الفارغة

1226
01:11:38,990 --> 01:11:42,310
!بارينغلز الأفضل بالفعل

1227
01:12:06,630 --> 01:12:10,180
.جميعهم أشخاص طيّبون

1228
01:12:10,180 --> 01:12:10,950
.نعم

1229
01:12:11,570 --> 01:12:13,490
.لا يوجد أصدقاء أفضل منهم

1230
01:12:15,900 --> 01:12:21,160
هايري-سان، هل يمكنني الحديث عن الماضي؟

1231
01:12:21,160 --> 01:12:21,810
.أكيد

1232
01:12:22,530 --> 01:12:25,320
.تسوموغي-تشان صديقتي

1233
01:12:25,980 --> 01:12:27,440
تلك الأغنية الّتي كنتُ أدندنها

1234
01:12:28,070 --> 01:12:33,450
هي أغنية اعتادت أن تغنّيها
.عندما كانت في منزلها وراء البحر

1235
01:12:34,010 --> 01:12:39,450
،لم يكن لديها أصدقاء كُثر هنا
.لذلك لم تغنّيها كثيرًا

1236
01:12:40,360 --> 01:12:43,460
.لم يكن لها من الأصدقاء سوى دُماها المحشوّة

1237
01:12:43,910 --> 01:12:48,660
.ولكن ذات يوم، صادقت فتاة تُدعى كاتو-سان

1238
01:12:48,660 --> 01:12:50,970
.كانت سعيدة جدًّا بإخباري عنها

1239
01:12:51,840 --> 01:12:56,970
،ثمّ وقعت في حبّ رجل
.وقرّرت مغادرة الجزيرة معه

1240
01:12:57,610 --> 01:12:58,550
...لكن

1241
01:13:00,070 --> 01:13:03,690
.اختفت تسوموغي-تشان

1242
01:13:07,440 --> 01:13:10,320
.أنا آسفة يا أبي وأمّي
.وشكرًا للجميع في الجزيرة
.أحبّكم جميعًا

1243
01:13:10,870 --> 01:13:14,320
.ومع ذلك، أنا واثقة أنّها ستعود

1244
01:13:14,920 --> 01:13:20,660
.لذلك قرّرتُ أخذ مكانها حتّى ذلك الحين

1245
01:13:21,980 --> 01:13:24,790
.آملة ألاّ ينساها أحد

1246
01:13:32,110 --> 01:13:34,800
،حاولتُ البحث عن تسوموغي-تشان

1247
01:13:35,060 --> 01:13:37,800
.وأسأل إن كان أيّ أحد يعرفني

1248
01:13:39,510 --> 01:13:45,340
لكنّ عدد الّذين يتذكّرونها
.أخذ يتناقص شيئًا فشيئًا

1249
01:13:46,510 --> 01:13:50,190
.وذات يوم، أتت كاتو-سان

1250
01:13:54,060 --> 01:13:55,220
.تسوموغي

1251
01:13:57,200 --> 01:14:02,460
.أخبرتني أن أقوم بما أريد القيام به

1252
01:14:02,830 --> 01:14:04,550
ما تريدين القيام به؟

1253
01:14:05,970 --> 01:14:10,910
.في الحقيقة، لم أعلم ما الّذي أريد القيام به

1254
01:14:11,550 --> 01:14:20,930
ولهذا قرّرت أن أصنع أصدقاء ليكونوا
.في انتظار تسوموغي-تشان عندما تعود

1255
01:14:21,640 --> 01:14:24,270
.قبل أن أغادر هذا المكان

1256
01:14:24,780 --> 01:14:27,150
.وذات يوم، التقيتُ أحدًا

1257
01:14:27,760 --> 01:14:30,830
.لقد أثنت على الدّمى المحشوّة

1258
01:14:31,510 --> 01:14:33,900
قادني ذلك الحدث البسيط

1259
01:14:34,790 --> 01:14:37,830
.إلى صديقة جديدة تُدعى شيزوكو

1260
01:14:38,950 --> 01:14:42,360
.ثمّ قابلتُك أنت

1261
01:14:42,360 --> 01:14:44,440
.ووقعتُ في الحبّ

1262
01:14:44,440 --> 01:14:46,650
.ليس من أجل تسوموغي-تشان

1263
01:14:47,060 --> 01:14:50,630
.وقعتُ في الحبّ من أجلي أنا

1264
01:14:51,400 --> 01:14:53,860
.كوّنتُ الكثير من الصّداقات

1265
01:14:54,250 --> 01:14:56,700
.عرفتُ ما معنى السّعادة

1266
01:14:57,620 --> 01:15:00,640
!والآن هناك أشياء كثيرة أودّ فعلها

1267
01:15:02,950 --> 01:15:06,500
.لا أستطيع الانتظار لرؤية ما سيحدث لاحقًا

1268
01:15:07,270 --> 01:15:10,380
.ربما ستتساقط الثّلوج حين يحلّ الشّتاء

1269
01:15:10,380 --> 01:15:12,400
!وسيكون الأمر شاقًّا بحقّ

1270
01:15:13,130 --> 01:15:15,150
،ستغلق الثّلوج الباب

1271
01:15:15,820 --> 01:15:19,370
وسأستطيع الخروج بمعجزة
.بفضلك أنت وشيزوكو

1272
01:15:19,370 --> 01:15:21,480
!ستنقذان حياتي

1273
01:15:21,480 --> 01:15:23,080
.كلّ هذا افتراضيّ

1274
01:15:23,430 --> 01:15:25,940
.في الصّيف، سنسبح في البحر

1275
01:15:25,940 --> 01:15:28,630
.سنرتدي اليوكاتا ونذهب إلى المهرجان

1276
01:15:29,080 --> 01:15:31,380
،سنتشاجر أحيانًا

1277
01:15:31,380 --> 01:15:34,120
.لكنّنا سنتصالح على الفور

1278
01:15:34,120 --> 01:15:38,620
.سأخبرك كم أنا سعيدة لأنّنا معًا نحن الثّلاثة

1279
01:15:38,620 --> 01:15:39,340
.نعم

1280
01:15:39,800 --> 01:15:41,460
.لا أستطيع الانتظار

1281
01:15:41,790 --> 01:15:42,580
.نعم

1282
01:15:43,520 --> 01:15:45,360
.كان اليوم ممتعًا أيضًا

1283
01:15:45,760 --> 01:15:46,450
.نعم

1284
01:15:47,230 --> 01:15:52,210
.وغدًا وبعده وكلّ يوم بعد ذلك سيكون كذلك

1285
01:15:52,680 --> 01:15:53,500
.نعم

1286
01:15:55,740 --> 01:15:59,230
.لديّ شيزوكو وشيروها-سان أيضًا

1287
01:15:59,230 --> 01:16:04,280
ثمّ هناك أوُ-سان ونومورا-سان
.وميتاني-سان وكانو-سان

1288
01:16:04,280 --> 01:16:06,620
.سيكون كلّ يوم مليئًا بالمرح

1289
01:16:08,740 --> 01:16:09,870
...لذا

1290
01:16:12,800 --> 01:16:14,110
.لا تبكِ رجاءً

1291
01:16:14,610 --> 01:16:15,720
.آسف

1292
01:16:16,140 --> 01:16:17,060
...أنا فقط

1293
01:16:17,440 --> 01:16:19,380
.لن تكوني هناك

1294
01:16:25,540 --> 01:16:29,820
.هايري-سان، أنا سعيدة

1295
01:16:29,820 --> 01:16:31,560
.تعرّفتُ على الجميع

1296
01:16:31,940 --> 01:16:33,440
.تعرّفتُ على شيزوكو

1297
01:16:34,250 --> 01:16:36,180
.وتعرّفتُ عليك

1298
01:16:37,560 --> 01:16:38,350
.نعم

1299
01:16:39,770 --> 01:16:41,440
.أنا سعيد أيضًا

1300
01:16:41,440 --> 01:16:44,950
لذا يجب أن نستمتع بوقتنا، صحيح؟

1301
01:16:47,980 --> 01:16:48,810
.نعم

1302
01:16:55,350 --> 01:16:58,950
.كانت إجازة صيفيّة جميلة جدًّا

1303
01:17:00,870 --> 01:17:07,470
أغنّي بحثًا عنّي

1304
01:17:13,600 --> 01:17:20,360
أغنّي عند المنارة ليُعثر عليّ

1305
01:17:26,450 --> 01:17:33,170
أبحث عن الموادّ، كما يفعل الطّائر القويّ

1306
01:17:39,300 --> 01:17:45,720
ألعب مع الطّائر والبقرة في الماء

1307
01:17:52,060 --> 01:17:58,560
الطّائر والبقرة وأنا معًا هذا الصّيف

1308
01:18:04,950 --> 01:18:11,610
الطّائر وأنا نمسك بأيدي بعضنا؛ نحن عاشقان

1309
01:18:24,200 --> 01:18:30,640
يا طائري الحبيب، ويا بقرَتي الحبيبة

1310
01:18:36,810 --> 01:18:43,480
الشّريط الأزرق السّماويّ هو كنزي

1311
01:18:49,450 --> 01:18:56,290
لن أنسى هذا الصّيف وهذه المنارة وهذا الطّائر

1312
01:19:34,310 --> 01:19:35,410
.تسوموغي

1313
01:19:42,680 --> 01:19:45,640
.عيد ميلاد سعيد

1314
01:19:54,830 --> 01:19:56,520
.لقد كانت عطلة صيفيّة رائعة

1315
01:20:00,240 --> 01:20:01,830
...كنت أفكرّ

1316
01:20:02,470 --> 01:20:06,110
.كانت تسوموغي هي العطلة الصّيفيّة نفسها

1317
01:20:06,550 --> 01:20:07,280
.نعم

1318
01:20:07,570 --> 01:20:10,770
عندما تلتقي بشخص للمرّة الأولى
في مكان غريب

1319
01:20:10,770 --> 01:20:12,260
،وتصبحان أصدقاء

1320
01:20:12,950 --> 01:20:16,050
.تشعر وكأنّ لديك كلّ وقت العالم

1321
01:20:16,830 --> 01:20:19,750
،لكن في النّهاية
،تحزن لأنّ وقتك قد انتهى

1322
01:20:19,750 --> 01:20:22,290
.وتندم على الاضطرار لقول الوداع

1323
01:20:22,590 --> 01:20:25,320
.كانت هي صيفي

1324
01:20:25,320 --> 01:20:26,150
.نعم

1325
01:20:26,630 --> 01:20:28,070
.صيفي أيضًا

1326
01:20:28,400 --> 01:20:29,900
...على أيّ حال

1327
01:20:34,000 --> 01:20:35,300
!تلك الأغنية

1328
01:20:35,920 --> 01:20:37,630
ماذا تغنّين؟

1329
01:20:38,370 --> 01:20:43,160
كانت السّيّدة القطّة الّتي تقدّم
.تمارين الرّاديو تغنّيها أحيانًا

1330
01:20:43,160 --> 01:20:45,630
!أصبحنا أصدقاء

1331
01:20:45,630 --> 01:20:46,570
فعلاً؟

1332
01:20:46,760 --> 01:20:49,180
.نأمل أن تلتقين بها العام القادم أيضًا

1333
01:20:49,180 --> 01:20:49,940
!نعم

1334
01:20:50,450 --> 01:20:52,510
العام القادم؟

1335
01:20:54,340 --> 01:20:55,840
.نعم

1336
01:20:56,280 --> 01:20:57,940
.هذا صحيح

1337
01:20:57,940 --> 01:20:58,830
.نعم

1338
01:20:59,320 --> 01:21:02,640
.ستعود العطلة الصّيفيّة مرّة أخرى

1339
01:21:15,940 --> 01:21:17,470
.الحلوى القطنيّة-سان

1340
01:21:18,730 --> 01:21:21,230
.إلى اللّقاء يا تسوموغي

1341
01:21:46,960 --> 01:21:48,390
.الوداع

1342
01:21:48,750 --> 01:21:50,430
.أراك في المرّة القادمة

1343
01:26:17,050 --> 01:26:18,350
.لقد عدنا

1344
01:26:21,400 --> 01:26:22,980
.مرحبًا بعودتكم