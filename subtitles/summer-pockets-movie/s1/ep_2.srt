605
00:33:06,410 --> 00:33:09,040
.يمكنك إيجاد كتبه المنحرفة وما شابه هناك أيضًا

606
00:33:09,270 --> 00:33:10,050
صحيح؟

607
00:33:12,990 --> 00:33:17,310
حـ-حسنًا، لا أدري ما قد تقوله كيوكو-سان
...إن اقتحمنا جميعنا منزلها فجأة

608
00:33:17,310 --> 00:33:18,410
!يا إلهي

609
00:33:18,410 --> 00:33:20,140
.تفضّلا بالدّخول

610
00:33:20,140 --> 00:33:22,560
.شكرًا على اعتنائكما بهايري-سان

611
00:33:22,820 --> 00:33:24,860
.شكرًا على استضافتنا

612
00:33:24,860 --> 00:33:26,690
.فعل الكثير من أجلنا أيضًا

613
00:33:27,930 --> 00:33:29,070
...لحظة، لحظة

614
00:33:30,090 --> 00:33:33,970
من منهما الّتي دعتك لحفل المبيت قبل أيّام؟

615
00:33:34,400 --> 00:33:36,150
.الفتاة الشّقراء

616
00:33:36,150 --> 00:33:38,240
.لكنّنا كنّا معًا نحن الثّلاثة وقتها

617
00:33:39,420 --> 00:33:40,840
!تخرج مع كلتيهما؟

618
00:33:40,840 --> 00:33:41,740
...كلاّ

619
00:33:41,740 --> 00:33:43,820
.عليّ إخبار أختي

620
00:33:43,820 --> 00:33:45,750
!لا! لا تفعلي رجاءً

621
00:33:48,650 --> 00:33:51,540
هذه هي غرفتك إذًا؟

622
00:33:51,540 --> 00:33:52,980
...موغيو

623
00:33:52,980 --> 00:33:54,850
.أشعر بالقليل من التّوتّر

624
00:33:54,850 --> 00:33:59,230
،إنّها ليست غرفتي بالتّحديد
.لنقل أنّي أستعيرها لهذا الصّيف

625
00:33:59,230 --> 00:34:00,200
!يا إلهي

626
00:33:59,230 --> 00:34:02,310
نويتشيغو

627
00:34:00,200 --> 00:34:02,310
أنت تفهم الأمر إذًا يا بايري-كُن؟

628
00:34:06,230 --> 00:34:07,520
موغيو؟

629
00:34:07,930 --> 00:34:10,730
!لا، أجبرني صديق على قراءتها

630
00:34:11,880 --> 00:34:14,610
بايري-كُن، هلاّ خرجت من هنا لبعض الوقت؟

631
00:34:19,890 --> 00:34:21,410
!نحن جاهزتان

632
00:34:23,530 --> 00:34:24,080
ماذا؟

633
00:34:26,210 --> 00:34:27,880
...موغيو

634
00:34:27,880 --> 00:34:29,560
.هذا غير مريح على الإطلاق

635
00:34:29,560 --> 00:34:31,390
ما رأيك يا هايري-سان؟

636
00:34:31,390 --> 00:34:32,960
ما-ما الّذي تقصدينه؟

637
00:34:34,140 --> 00:34:35,340
حشوتِ ملابسك بشيء ما؟

638
00:34:35,970 --> 00:34:39,190
!موغيو

639
00:34:41,190 --> 00:34:42,740
...موغيو

640
00:34:44,690 --> 00:34:45,610
.يا إلهي

641
00:34:45,610 --> 00:34:47,330
هل لديكم وقت؟

642
00:34:50,180 --> 00:34:52,280
.عليّ الاتّصال بأختي بالفعل

643
00:34:52,280 --> 00:34:54,190
!لا تفعلي رجاءً

644
00:34:57,880 --> 00:34:59,340
.ها هي

645
00:34:59,340 --> 00:35:00,210
.خذ

646
00:35:02,280 --> 00:35:05,040
كلاين إرمخن

647
00:35:04,160 --> 00:35:05,600
.إنّها مجموعة تهويدات

648
00:35:05,600 --> 00:35:08,940
سمعتُ أنّ تسوموغي-تشان
.كانت تحاول إيجاد أغنية قديمة

649
00:35:08,940 --> 00:35:11,470
.فكّرتُ في أنّ ذلك قد يساعد

650
00:35:11,470 --> 00:35:13,730
!شكرًا لك يا كيوكو-سان

651
00:35:14,160 --> 00:35:16,390
!قد تكون أغنيتك هنا

652
00:35:16,390 --> 00:35:17,900
أتعتقد ذلك؟

653
00:35:20,290 --> 00:35:21,560
...لا يمكنني قراءتها

654
00:35:21,560 --> 00:35:23,480
.يبدو أنّها بالألمانيّة

655
00:35:23,480 --> 00:35:26,040
...لا يمكنني تمييزها حتّى

656
00:35:26,040 --> 00:35:27,700
هلّي بإلقاء نظرة؟

657
00:35:38,100 --> 00:35:39,040
...أليست هذه

658
00:35:39,040 --> 00:35:42,080
!نعم، إنّها الأغنية الّتي أحبّ

659
00:35:42,080 --> 00:35:44,470
!وجدناها أخيرًا يا تسوموغي

660
00:35:47,400 --> 00:35:48,780
...موغيو

661
00:35:48,780 --> 00:35:51,870
.لا فكرة لديّ ما كلماتها

662
00:35:52,630 --> 00:35:55,700
لماذا إذًا لا تفكّرين في كلماتك الخاصّة لها؟

663
00:35:55,700 --> 00:35:56,690
أنا؟

664
00:35:56,690 --> 00:35:57,960
!يبدو ذلك ممتعًا

665
00:35:57,960 --> 00:35:58,920
!لنجرّب ذلك

666
00:35:58,920 --> 00:35:59,680
!حسنًا

667
00:35:59,680 --> 00:36:02,440
.لكنّ ذلك لن يكون سهلاً

668
00:36:02,440 --> 00:36:05,760
ما رأيك بوضع قائمة للأشياء الّتي تحبّينها؟

669
00:36:05,760 --> 00:36:07,890
.ستكون أغنية خاصّة بك هكذا

670
00:36:07,890 --> 00:36:10,270
الأشياء الّتي أحبّها؟

671
00:36:13,670 --> 00:36:15,270
...موغيو-غيو

672
00:36:18,730 --> 00:36:21,210
.شكرًا، شكرًا جزيلاً

673
00:36:21,210 --> 00:36:22,240
.لا شكر على واجب

674
00:36:22,240 --> 00:36:24,070
.أنا مسرورة لأنّي تمكّنت من المساعدة

675
00:36:24,070 --> 00:36:25,480
.زورانا ثانية رجاءً

676
00:36:25,480 --> 00:36:26,120
.أكيد

677
00:36:26,120 --> 00:36:28,620
!انظرا، إنّها فتاة الأغنية

678
00:36:30,350 --> 00:36:31,540
...يا أولاد

679
00:36:33,270 --> 00:36:34,250
!تفضّلي

680
00:36:38,500 --> 00:36:41,660
.أتمنّى لو استطاعت شيزوكو المجيء أيضًا

681
00:36:41,660 --> 00:36:43,200
.صـ-صحيح

682
00:36:43,200 --> 00:36:45,590
.عليّ العودة للمنزل باكرًا اليوم

683
00:36:45,590 --> 00:36:47,180
.استمتعا بوقتكما معًا

684
00:36:47,540 --> 00:36:50,060
لماذا ظنّت أنّ عليها منحنا وقتًا وحدنا؟

685
00:36:51,780 --> 00:36:52,520
...عفوًا

686
00:36:55,150 --> 00:36:57,510
أتريد الدّخول؟

687
00:36:58,720 --> 00:37:00,200
.هذا مذهل

688
00:37:00,200 --> 00:37:03,150
هذا هو المشهد الّذي تتحدّثين عنه دائمًا؟

689
00:37:03,530 --> 00:37:04,700
.نعم

690
00:37:04,700 --> 00:37:07,200
.إنّه مشهدي المفضّل

691
00:37:19,430 --> 00:37:20,800
...عفوًا

692
00:37:21,230 --> 00:37:23,560
.أنا جاهزة أخيرًا

693
00:37:23,560 --> 00:37:25,190
.عاطفيًّا

694
00:37:25,750 --> 00:37:27,620
جاهزة عاطفيًّا؟

695
00:37:27,620 --> 00:37:33,310
.إنّني في الحقيقة أحبّك أيضًا يا هايري-سان

696
00:37:33,950 --> 00:37:36,190
.ظننتُ أنّي أخبرتك أنّي أحبّك

697
00:37:36,190 --> 00:37:38,220
.وأنّه ليس من الصّعب ألاّ تُحبَّ أيضًا

698
00:37:38,220 --> 00:37:40,400
.ظننتُ أنّك قصدت كصديقين

699
00:37:40,730 --> 00:37:43,090
.ذلك ما قصدتُ وقتها

700
00:37:43,580 --> 00:37:44,520
...لكن

701
00:37:46,090 --> 00:37:48,410
.أنا أيضًا قصدتُ شيئًا آخر

702
00:37:49,120 --> 00:37:53,080
.منذ أن أخبرتني أنّك ستمنحني صيفك

703
00:37:53,080 --> 00:37:57,280
كيف يمكنني مقاومة حبّك بعد ذلك؟

704
00:37:57,280 --> 00:38:00,650
.لذلك كنتُ أحاول ألاّ أتحمّس كثيرًا

705
00:38:00,650 --> 00:38:04,910
.أردتُ التّصرّف بشكل طبيعيّ أمامك

706
00:38:05,290 --> 00:38:07,720
.لكنّي لم أستطع

707
00:38:07,720 --> 00:38:10,300
.ما زال قلبي يخفق حتّى الآن

708
00:38:10,480 --> 00:38:11,790
...تسوموغي

709
00:38:12,230 --> 00:38:15,930
.لكنّي سأغادر قريبًا

710
00:38:16,530 --> 00:38:21,100
.لذلك فلا معنى أبدًا من قول أنّي أحبّك

711
00:38:26,260 --> 00:38:30,810
.سأبكي كثيرًا عندما سنودّع بعضنا

712
00:38:31,460 --> 00:38:35,160
.لا أريد أن يكون وداعنا هكذا

713
00:38:35,160 --> 00:38:36,900
لماذا تفعل هذا؟

714
00:38:36,900 --> 00:38:37,930
لماذا؟

715
00:38:38,590 --> 00:38:41,840
لماذا تقول ذلك؟

716
00:38:47,470 --> 00:38:52,560
أسيكون وداعنا بلا معنى بالفعل؟

717
00:38:52,560 --> 00:38:53,680
موغيو؟

718
00:38:53,990 --> 00:38:55,700
...حتّى إن انفصلنا

719
00:38:56,330 --> 00:38:58,840
...حتّى إن لم نرَ بعضنا بعد الآن

720
00:38:59,300 --> 00:39:03,940
لا أعتقد أنّ ذلك يعني
.أنّ مشاعرنا فقدت معناها

721
00:39:04,570 --> 00:39:06,720
،لا يهمّ كم سيكون ذلك مؤلمًا

722
00:39:06,720 --> 00:39:08,950
.فلن يغيّر ذلك حقيقة أنّي أحبّك

723
00:39:09,620 --> 00:39:12,450
.أنت من ذكّرني بذلك

724
00:39:13,040 --> 00:39:14,620
أنا؟

725
00:39:14,940 --> 00:39:15,810
.نعم

726
00:39:16,530 --> 00:39:19,750
.لذلك سأقولها بشكل لائق

727
00:39:20,240 --> 00:39:22,790
.أنا أحبّك يا تسوموغي

728
00:39:24,100 --> 00:39:25,910
...هايري-سان

729
00:39:25,910 --> 00:39:27,550
.أنا أيضًا

730
00:39:31,430 --> 00:39:34,760
.أحبّك يا هايري-سان

731
00:39:43,320 --> 00:39:44,610
.لقد عدت يا كيوكو-سان

732
00:39:44,910 --> 00:39:46,410
.مرحبًا بعودتك

733
00:39:48,470 --> 00:39:50,630
.تبدو سعيدًا يا هايري-كُن

734
00:39:50,630 --> 00:39:52,740
فـ-فعلاً؟

735
00:39:59,310 --> 00:40:00,870
.دعيني أساعدك

736
00:40:01,410 --> 00:40:02,670
.أنا آسف

737
00:40:08,470 --> 00:40:09,760
تسوموغي؟

738
00:40:24,220 --> 00:40:25,680
ما خطبها؟

739
00:40:25,680 --> 00:40:26,980
.هذا غير عاديّ

740
00:40:27,320 --> 00:40:30,490
.لا تختفي تسوموغي طويلاً في العادة

741
00:40:31,050 --> 00:40:33,070
هل تعتقدين أنّ شيئًا ما قد حدث؟

742
00:40:33,070 --> 00:40:34,450
هل تواجه مشكلة ما؟

743
00:40:34,450 --> 00:40:36,370
.لا، لا. ذلك غير ممكن

744
00:40:36,800 --> 00:40:40,940
ربّما تشعر بالإحراج

745
00:40:40,940 --> 00:40:43,710
.بما أنّكما تتواعدان رسميًّا الآن

746
00:40:43,950 --> 00:40:45,360
!ماذا؟

747
00:40:45,360 --> 00:40:47,950
.أحبّك يا هايري-سان

748
00:40:47,950 --> 00:40:48,630
!لكنّي أخبرتها أنّي أحبّها أيضًا

749
00:40:49,510 --> 00:40:50,420
.عرفتُ هذا

750
00:40:51,410 --> 00:40:52,880
.آسف

751
00:40:52,880 --> 00:40:56,870
.كنتُ سأخبرك عندما نكون هنا جميعًا

752
00:40:56,870 --> 00:40:59,760
.أنا سعيدة جدًّا من أجلكما

753
00:41:00,050 --> 00:41:02,810
من الأفضل أن تسعدها، مفهوم؟

754
00:41:03,720 --> 00:41:04,710
.بالطّبع

755
00:41:04,710 --> 00:41:06,990
.لكنّ هذا مؤسف نوعًا ما

756
00:41:06,990 --> 00:41:12,170
سيكون عليّ الآن تشارك صدرها
.معك عندما يكبر

757
00:41:12,170 --> 00:41:13,250
ماذا؟

758
00:41:13,250 --> 00:41:16,920
.أ-أعني أنّ صدر تسوموغي ينتمي لها

759
00:41:16,920 --> 00:41:18,680
.وليس لأيّ أحد آخر

760
00:41:18,680 --> 00:41:22,180
.ر-ربّما تأخّرت تسوموغي في النّوم

761
00:41:22,180 --> 00:41:25,460
.لا بأس بذلك. قالت أنّها تعيش في المنارة

762
00:41:26,660 --> 00:41:30,230
لكن أين تعيش بالفعل؟

763
00:41:30,230 --> 00:41:31,120
ماذا؟

764
00:41:31,480 --> 00:41:33,050
.لا فكرة لديّ

765
00:41:34,130 --> 00:41:38,760
.لطالما التقيت بها وودّعتها هنا

766
00:41:39,330 --> 00:41:42,290
.كما أنّها تودّعني هنا دائمًا أيضًا

767
00:41:49,070 --> 00:41:50,450
ما الخطب يا هايري-كُن؟

768
00:41:50,940 --> 00:41:53,500
.لا-لا شيء

769
00:41:55,400 --> 00:41:57,070
!عن إذنكم

770
00:41:57,320 --> 00:41:58,710
!نعم، نعم

771
00:41:58,710 --> 00:42:00,080
.أريد أن أسألك عن شيء

772
00:42:00,080 --> 00:42:02,290
.حسنًا، أتيت في وقتك

773
00:42:04,090 --> 00:42:06,120
.تفضّل. هذا ما طلبتَه

774
00:42:07,180 --> 00:42:10,170
.لقد وصل بسرعة مفاجئة

775
00:42:10,500 --> 00:42:12,500
!لا بدّ أنّها قوّة الحبّ

776
00:42:16,050 --> 00:42:18,580
.ربّما اختطفتها الآلهة

777
00:42:18,580 --> 00:42:21,050
اختطفتها الآلهة؟

778
00:42:21,410 --> 00:42:23,700
...حدث الأمر قبل عقود مضت

779
00:42:23,700 --> 00:42:25,810
.حدثت جلبة كبيرة حياله

780
00:42:26,150 --> 00:42:29,290
.اختفت فتاة شقراء فجأة

781
00:42:30,010 --> 00:42:31,310
فتاة شقراء؟

782
00:42:31,720 --> 00:42:35,940
،ساعدت الجزيرة بأكملها والديها للبحث عنها

783
00:42:35,940 --> 00:42:38,200
.لكن لم يعثر عليها أيّ أحد

784
00:42:38,520 --> 00:42:44,570
لكن استمرّ فتى في البحث عنها
.باستماتة كما تفعل أنت الآن

785
00:42:44,570 --> 00:42:47,070
.أعتقد أنّه كان حارس المنارة

786
00:42:47,070 --> 00:42:48,740
...حارس المنارة

787
00:42:48,740 --> 00:42:52,630
هل هنالك أيّ شخص آخر كان
يعرف الفتاة الّتي اختطفتها الآلهة؟

788
00:42:52,630 --> 00:42:53,860
.لا

789
00:42:53,860 --> 00:42:55,330
.ما عاد هنالك

790
00:42:55,330 --> 00:43:01,330
،كانت كاتو-سان هي آخر شخص عرفها
.لكنّها توفّت مؤخّرًا

791
00:43:02,220 --> 00:43:04,970
.صُدمتُ لسماع ذلك بالفعل

792
00:43:05,290 --> 00:43:07,090
.أقصد قصّة اختطاف الآلهة لها

793
00:43:10,990 --> 00:43:12,550
بايري-كُن؟

794
00:43:12,550 --> 00:43:14,880
هلاّ ألقيت نظرة على هذه؟

795
00:43:16,760 --> 00:43:18,050
تسوموغي؟

796
00:43:18,450 --> 00:43:19,700
...لكنّ هذه

797
00:43:20,000 --> 00:43:21,660
.مهلاً لحظة

798
00:43:21,660 --> 00:43:23,050
أيُعقل هذا؟

799
00:43:23,540 --> 00:43:25,330
.إنّها صورة قديمة جدًّا

800
00:43:25,600 --> 00:43:27,460
!قل شيئًا يا هايري-كُن

801
00:43:27,880 --> 00:43:29,350
.لا أدري

802
00:43:29,350 --> 00:43:32,840
.لكنّي لا أستطيع التّوقّف عن التّفكير بالأمر

803
00:43:37,810 --> 00:43:40,340
.رأيتُ هذا من قبل

804
00:43:42,720 --> 00:43:44,260
هذا. أرأيته؟

805
00:43:44,630 --> 00:43:46,310
.رأيته من قبل

806
00:43:47,810 --> 00:43:50,640
..اعتاد أن يعيش هنا شخص قويّ جدًّا

807
00:43:50,640 --> 00:43:53,050
.لا يعيش أحد هنا الآن

808
00:43:53,050 --> 00:43:55,820
أهو منزل تسوموغي؟

809
00:43:59,080 --> 00:44:00,990
!المعذرة

810
00:44:05,400 --> 00:44:07,510
.ربّما لا يوجد أحد هنا

811
00:44:07,510 --> 00:44:10,200
!يا تسوموغي

812
00:44:16,380 --> 00:44:18,670
.تبدو مثل غرفة فتاة

813
00:44:28,960 --> 00:44:31,060
!هايري-كُن! انظر

814
00:44:33,190 --> 00:44:34,940
تسوموغي فندرز

815
00:44:33,190 --> 00:44:34,940
...تسوموغي

816
00:44:35,680 --> 00:44:39,070
.بدأت الدّراسة على الجزيرة اليوم

817
00:44:39,470 --> 00:44:44,060
.يهمس الجميع بشأن لون شعري وعينيّ

818
00:44:44,060 --> 00:44:48,080
لذلك فأصدقائي الوحيدين
.هم دماي المحشوّة

819
00:44:48,360 --> 00:44:49,740
دماها المحشوّة؟

820
00:44:51,450 --> 00:44:52,910
...أكانت

821
00:44:53,220 --> 00:44:56,820
.لم يتحدّث معي أيّ أحد اليوم

822
00:44:56,820 --> 00:44:58,920
.أعتقد أنّهم خائفون منّي

823
00:44:59,280 --> 00:45:02,050
.لا بدّ أنّهم يظنّونني نوعًا من النّاماهاغي

824
00:45:02,340 --> 00:45:05,970
.لذلك سأستجمع شجاعتي للحديث معهم

825
00:45:07,550 --> 00:45:09,140
!كأنّي ناماهاغي

826
00:45:09,140 --> 00:45:11,480
!أحضروا لي الأطفال البكّائين

827
00:45:11,480 --> 00:45:13,520
!أحضروا لي الأطفال المشاكسين

828
00:45:13,520 --> 00:45:17,390
!أحضروا لي الأطفال العاصين

829
00:45:24,560 --> 00:45:26,280
.فشلتُ فشلاً ذريعًا

830
00:45:42,810 --> 00:45:44,810
.لكنّي حصلتُ على صديقة

831
00:45:44,810 --> 00:45:46,250
.كان اسمها كاتو-سان

832
00:45:46,250 --> 00:45:48,530
.إنّها تحبّ الدّمى الحشوّة

833
00:45:48,530 --> 00:45:50,260
!أسعدني ذلك كثيرًا

834
00:45:50,690 --> 00:45:52,640
.سررت لأجلك يا تسوموغي

835
00:45:52,960 --> 00:45:58,500
يبدو أنّها حصلت على العديد من الأصدقاء
.واعتادت على الجزيرة وعاشت هنا بسعادة

836
00:45:59,540 --> 00:46:02,780
كان يفترض بتسوموغي أن تهرب
...مع حارس المنارة

837
00:46:02,780 --> 00:46:03,780
!ماذا؟

838
00:46:14,280 --> 00:46:18,410
.قرّرتُ مغادرة الجزيرة معه

839
00:46:18,410 --> 00:46:20,290
.سنتقابل في المنارة

840
00:46:20,970 --> 00:46:24,020
.أنا آسفة يا أبي وأمّي

841
00:46:24,020 --> 00:46:26,930
.وشكرًا للجميع في الجزيرة

842
00:46:27,520 --> 00:46:29,050
.أحبّكم جميعًا

843
00:46:30,400 --> 00:46:32,140
أيعقل أنّك تشعر بالغيرة؟

844
00:46:32,140 --> 00:46:33,170
.نعم

845
00:46:33,170 --> 00:46:34,660
.أنت صريح مع نفسك

846
00:46:34,660 --> 00:46:39,270
.و-ولكنّ هذه أمور حدثت قبل عقود

847
00:46:39,960 --> 00:46:41,230
...لكنّ مسألة الهرب

848
00:46:42,530 --> 00:46:45,940
.أتساءل إن كان ذلك ما حدث لها بالفعل

849
00:46:45,940 --> 00:46:47,780
.لا، لم يكن ذلك

850
00:46:47,780 --> 00:46:50,530
أتذكرين ما قالته الجدّة في متجر الحلوى؟

851
00:46:50,530 --> 00:46:54,370
كان حارس المنارة يبحث
.عن الفتاة المفقودة أيضًا

852
00:46:54,370 --> 00:46:57,100
إذًا فقد اختطفتها الآلهة بالفعل؟

853
00:46:58,390 --> 00:46:59,830
...مستحيل

854
00:47:00,290 --> 00:47:02,050
هل نحن كذلك أيضًا؟

855
00:47:06,060 --> 00:47:08,800
.ثمّة المزيد في هذه اليوميّات

856
00:47:08,800 --> 00:47:13,790
.تسوموغي-تشان مفقودة
.لن تعود تسوموغي-تشان
.ذهب الجميع للبحث عنها
.لكنّهم لم يعثروا عليها

857
00:47:13,790 --> 00:47:15,810
ما هذا؟

858
00:47:17,310 --> 00:47:22,940
.أشعر بالحزن على تسوموغي-تشان
.لا تنسوا تسوموغي-تشان رجاءً
.هذا ما آمله
.لذلك سأحرص على ألاّ ينساها أحد
.عليّ الحرص على ذلك

859
00:47:23,350 --> 00:47:24,480
...هذا

860
00:47:31,740 --> 00:47:33,740
.أنا خائفة

861
00:47:34,400 --> 00:47:35,740
...شيزوكو

862
00:47:36,030 --> 00:47:38,180
،كلّما تعمّقنا في البحث عنها

863
00:47:38,180 --> 00:47:40,250
...كلّما تعمّقنا في هذا

864
00:47:40,470 --> 00:47:44,050
.أشعر أكثر أنّنا لن نراها ثانية

865
00:47:45,620 --> 00:47:47,260
آسف، أيمكنني تركك هنا؟

866
00:47:47,550 --> 00:47:48,590
هايري-كُن؟

867
00:47:48,590 --> 00:47:51,300
.ثمّة مكان عليّ الذّهاب إليه

868
00:48:07,160 --> 00:48:09,150
تنتظرون في المنزل أيضًا؟

869
00:48:09,940 --> 00:48:11,150
.وأنا كذلك

870
00:48:11,150 --> 00:48:17,060
كلّ ما بإمكاني فعله هو الجلوس
.وانتظار عودة تسوموغي

871
00:48:17,060 --> 00:48:19,200
...لذلك

872
00:48:19,960 --> 00:48:21,240
...تسوموغي

873
00:48:23,290 --> 00:48:24,720
!ماذا؟ ما-ماذا؟

874
00:48:35,010 --> 00:48:36,150
أين أنا؟

875
00:48:37,560 --> 00:48:40,530
...هذه ليست غرفة تسوموغي

876
00:48:47,240 --> 00:48:49,190
ما هذا؟

877
00:48:50,190 --> 00:48:52,280
ما-ما هذا المكان؟

878
00:48:56,530 --> 00:48:57,750
.إنّه لا يُفتح

879
00:48:57,750 --> 00:48:58,820
!سُحقًا

880
00:49:10,180 --> 00:49:11,210
!كيف؟

881
00:49:11,640 --> 00:49:13,590
كنتُ سأصعد، أليس كذلك؟

882
00:49:23,010 --> 00:49:24,590
ما الّذي يحدث؟

883
00:49:24,590 --> 00:49:25,670
من هناك؟

884
00:49:30,480 --> 00:49:31,570
...عفوًا

885
00:49:32,610 --> 00:49:33,850
!تسوموغي

886
00:49:33,850 --> 00:49:35,030
أين كنتِ؟

887
00:49:35,030 --> 00:49:36,720
!كنّا قلقين عليك

888
00:49:36,720 --> 00:49:39,270
.كنتُ هنا طوال الوقت

889
00:49:39,270 --> 00:49:40,660
هنا؟

890
00:49:40,660 --> 00:49:44,160
.لكنّي كنتُ أبحث عنك طوال هذا الوقت

891
00:49:45,920 --> 00:49:48,190
أنت... تسوموغي، صحيح؟

892
00:49:48,190 --> 00:49:52,440
.نعم. أنا هي تسوموغي فندرز بكلّ تأكيد

893
00:49:59,470 --> 00:50:01,710
!أحضروا لي الأطفال البكّائين

894
00:50:02,310 --> 00:50:04,420
!أحضروا لي الأطفال المشاكسين

895
00:50:04,420 --> 00:50:07,590
!أحضروا لي الأطفال العاصين

896
00:50:07,590 --> 00:50:11,230
كـ-كيف تعرف بشأن تعريفي المحرج؟

897
00:50:11,770 --> 00:50:13,090
...غير ممكن

898
00:50:13,890 --> 00:50:16,480
هل خطفتني الآلهة أيضًا؟

899
00:50:18,360 --> 00:50:22,640
!أريد العودة بكلّ جدّيّة

900
00:50:22,640 --> 00:50:24,670
هل سيعيدني هذا من حيث أتيت بالفعل؟

901
00:50:24,670 --> 00:50:27,660
.بدا أنّه ينفع مع البقيّة

902
00:50:27,660 --> 00:50:32,160
أنا لم أعد أبدًا، لذلك لا أعرف
.إن كان هذا ينجح أم لا بنفسي

903
00:50:33,410 --> 00:50:39,470
لسوء الحظّ، كلّ من لديه شيء
.يبقيه هنا، يظلّ عالقًا هنا

904
00:50:39,950 --> 00:50:46,340
وطال الأمر بنا حتّى لم نعد نعرف
.ما الّذي يبقينا هنا

905
00:50:46,340 --> 00:50:47,940
ما الّذي يبقيكم هنا؟

906
00:50:48,390 --> 00:50:49,970
أي أنّك عالقة أيضًا؟

907
00:50:52,070 --> 00:50:54,600
هل أبدو مثلها كثيرًا؟

908
00:50:54,600 --> 00:50:56,880
...الفتاة الّتي تعرفها

909
00:50:56,880 --> 00:50:57,950
تسوموغي-سان؟

910
00:50:58,770 --> 00:51:02,740
.نعم، إنّكما صورة طبق الأصل

911
00:51:02,740 --> 00:51:05,380
.لكنّ شخصيّتها مختلفة تمامًا

912
00:51:05,380 --> 00:51:08,920
،إن عقدَتْ العزم على أمرٍ
.أصبحت أكثرَ حيويّةً وتفانيًا فيه

913
00:51:08,920 --> 00:51:11,060
.لذلك لا بدّ من مراقبتها ومتابعتها عن كثب

914
00:51:11,060 --> 00:51:12,460
هكذا إذًا؟

915
00:51:12,460 --> 00:51:14,380
.آمل أن تعود إليها سريعًا

916
00:51:17,060 --> 00:51:20,040
.أفهم تمامًا ما تشعر به يا تاكاهارا-سان

917
00:51:20,770 --> 00:51:27,080
.طال الفراق بيني وبين حبيبي وصديقتي المفضّلة

918
00:51:27,080 --> 00:51:29,410
تقصدين الرّجل الّذي أردت الهرب معه؟

919
00:51:31,410 --> 00:51:34,940
.لم أستطع الاختيار في ذلك اليوم

920
00:51:36,230 --> 00:51:39,380
.استبدّ بي الخوف

921
00:51:40,940 --> 00:51:45,870
كنتُ قد قرّرتُ أن أترك والديّ
،وأهالي الجزيرة

922
00:51:45,870 --> 00:51:49,460
.كي أيعش مع الرّجل الّذي أحبّه

923
00:51:49,870 --> 00:51:51,960
،تردّدتُ في النّهاية

924
00:51:52,360 --> 00:51:53,890
.وعجزتُ عن حسم أمري

925
00:51:58,710 --> 00:52:02,810
.ثمّ وجدتُ نفسي هنا، من غير أن أدري كيف

926
00:52:02,810 --> 00:52:06,740
.لا بدّ أنّي ما زلت متردّدة

927
00:52:06,740 --> 00:52:07,810
...تسوموغي-سان

928
00:52:08,070 --> 00:52:12,840
لكنّك جئتَ إلى هنا تبحثُ
عن شخصٍ تشتاق إليه، أليس كذلك؟

929
00:52:12,840 --> 00:52:16,040
،أنا واثقة من أنّه إذا ركّزتَ في ذهنك عليها بقوّة

930
00:52:16,040 --> 00:52:18,910
.ستتمكّن من العودة إلى عالمك

931
00:52:19,340 --> 00:52:21,690
...أركّز بقوّة

932
00:52:21,690 --> 00:52:23,600
.فلتؤمن بها إيمانًا قويًّا

933
00:52:23,600 --> 00:52:25,210
.بحبيبتك

934
00:52:26,730 --> 00:52:27,870
.ذلك صحيح

935
00:52:28,230 --> 00:52:30,290
،لا يهمّ من تكون

936
00:52:30,540 --> 00:52:32,290
...ومهما كان ماضيها

937
00:52:32,580 --> 00:52:34,370
.فأنا لا أهتمّ

938
00:52:34,830 --> 00:52:37,300
.في هذه اللّحظة، أشتاق إليها فحسب

939
00:52:37,980 --> 00:52:39,630
.أريد رؤيتها تبتسم

940
00:52:40,150 --> 00:52:42,220
.أريد سماع أغنيتها

941
00:52:47,220 --> 00:52:48,880
...تلك الأغنية

942
00:52:49,730 --> 00:52:50,770
.ذلك يعيدني إلى الماضي

943
00:52:56,560 --> 00:52:57,860
...نسيم

944
00:52:59,350 --> 00:53:01,400
!قد يكون هنالك مخرج يا تسوموغي-سان

945
00:53:03,030 --> 00:53:05,500
.ما زلتُ متردّدة

946
00:53:05,500 --> 00:53:07,870
.إن ذهبت، فسيختفي المخرج بالتّأكيد

947
00:53:08,250 --> 00:53:10,510
سيكون عليك الذّهاب وحدك
.يا تاكاهارا-سان

948
00:53:10,510 --> 00:53:11,290
...لكن

949
00:53:15,750 --> 00:53:19,380
.اعتنِ بتسوموغي-سان رجاءً

950
00:53:21,810 --> 00:53:22,490
.نعم

951
00:53:22,960 --> 00:53:24,130
.شكرًا لك

952
00:53:26,370 --> 00:53:28,890
ما الّذي تفعلينه هناك؟

953
00:53:29,230 --> 00:53:31,710
!أبحث عن شيء ما

954
00:53:31,710 --> 00:53:33,640
عمّ تبحثين؟

955
00:53:33,980 --> 00:53:36,020
!عن نفسي

956
00:53:36,020 --> 00:53:37,280
...تسوموغي

957
00:53:37,780 --> 00:53:41,790
عندما قلتِ أنّك كنت تبحثين
...عن نفسك، هل قصدتِ

958
00:53:51,290 --> 00:53:52,560
...هذه

959
00:54:09,850 --> 00:54:12,270
،علب بارينغلز قويّة بالفعل

960
00:54:12,270 --> 00:54:13,560
...صحيح

961
00:54:14,380 --> 00:54:15,780
يا تسوموغي؟

962
00:54:18,790 --> 00:54:22,820
!هايري-كُن! هايري-كُن! هايري-كُن

963
00:54:25,850 --> 00:54:27,530
!هايري-كُن

964
00:54:30,890 --> 00:54:31,880
!يا إلهي

965
00:54:31,880 --> 00:54:33,600
!أين كنت؟

966
00:54:33,600 --> 00:54:34,790
...شيزوكو

967
00:54:35,390 --> 00:54:37,490
...اختفت تسوموغي أوّلاً

968
00:54:37,490 --> 00:54:39,630
ماذا إن اختفيت أنت أيضًا؟

969
00:54:39,630 --> 00:54:42,250
!ماذا قد أفعل؟

970
00:54:43,320 --> 00:54:44,570
.آسف

971
00:54:46,090 --> 00:54:47,120
!أين تسوموغي؟

972
00:54:49,130 --> 00:54:50,380
!هايري

973
00:54:51,970 --> 00:54:53,400
!حمدًا على هذا

974
00:54:53,400 --> 00:54:56,730
!حمدًا على هذا يا هايري-سان

975
00:54:56,730 --> 00:54:57,950
...تسوموغي

976
00:54:59,140 --> 00:55:01,770
...في يوم افتراقنا

977
00:55:02,050 --> 00:55:06,940
.كنتُ أنتظر عند المنارة في حال عودة تسوموغي

978
00:55:10,700 --> 00:55:13,700
...شيزوكو، أنا

979
00:55:14,560 --> 00:55:18,120
!تسوموغي! تسوموغي! تسوموغي

980
00:55:18,960 --> 00:55:24,690
.لكن عند عودة تسوموغي، اختفيت أنت

981
00:55:24,690 --> 00:55:26,760
.كنت قلقة جدًّا

982
00:55:26,760 --> 00:55:27,720
.آسف

983
00:55:28,880 --> 00:55:31,470
!حمدًا على هذا

984
00:55:31,920 --> 00:55:33,470
...تسوموغي

985
00:55:36,120 --> 00:55:37,390
.تسوموغي

986
00:55:37,390 --> 00:55:39,360
.إ-إيّاك

987
00:55:39,360 --> 00:55:43,400
ستتّسخ ملابسك بدموعي
.وأنفي الّذي يسيل

988
00:55:43,620 --> 00:55:44,690
.لا أهتمّ

989
00:55:47,940 --> 00:55:51,990
.أريد البقاء هكذا لوقت أطول إذًا

990
00:55:53,270 --> 00:55:56,050
اختفيت ليوم كامل؟

991
00:55:56,050 --> 00:55:57,290
.نعم

992
00:55:57,290 --> 00:55:59,230
أين كنت بالضّبط؟

993
00:55:59,230 --> 00:56:00,390
أين؟

994
00:56:00,390 --> 00:56:01,500
...حسنًا

995
00:56:04,510 --> 00:56:06,640
.لا أذكر

996
00:56:06,640 --> 00:56:07,550
موغيو؟

997
00:56:07,550 --> 00:56:08,560
ماذا تقصد؟

998
00:56:08,560 --> 00:56:10,000
.إنّها الحقيقة

999
00:56:10,580 --> 00:56:11,970
.لا أذكر أيّ شيء

1000
00:56:15,420 --> 00:56:16,560
موغيو؟

1001
00:56:21,680 --> 00:56:24,150
لا يمكننا فعل أيّ شيء
.إن لم تكن تتذكّر

1002
00:56:26,680 --> 00:56:27,910
.مرحبًا بعودتك

1003
00:56:27,910 --> 00:56:29,080
...عفوًا

1004
00:56:29,680 --> 00:56:31,870
.أنا جدّ آسف

1005
00:56:31,870 --> 00:56:33,410
.أنا آسفة

1006
00:56:34,030 --> 00:56:36,620
،لقد أقلقتني عليك كثيرًا

1007
00:56:36,620 --> 00:56:38,520
.لكنّي مسرورة لأنّك بخير

1008
00:56:39,450 --> 00:56:42,180
.الوقت متأخّر الآن يا تسوموغي-تشان

1009
00:56:42,180 --> 00:56:43,850
لماذا لا تقضين اللّيلة هنا؟

1010
00:56:44,780 --> 00:56:46,260
...موغيو

1011
00:56:56,650 --> 00:56:57,900
.هايري-سان

1012
