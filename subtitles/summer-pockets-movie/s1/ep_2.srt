1
00:00:26,370 --> 00:00:29,380
،منذ زمن بعيد، حين كنت صغيرة

2
00:00:29,380 --> 00:00:32,340
.ركضتُ عبر صيفٍ بدا وكأنّه لا ينتهي

3
00:00:32,750 --> 00:00:35,260
.مع عائلتي. مع أصدقائي

4
00:00:35,510 --> 00:00:38,750
كنت ألهو بلا نهاية، وكان هناك
.دائمًا ما يمكنني فعله

5
00:00:38,750 --> 00:00:43,120
،كانت الشّمس تلمع فوق رؤوسنا
.ترعانا كلّ يوم

6
00:00:43,810 --> 00:00:48,050
.وبمرور الوقت، صار ذلك مجرّد ذكرى بعيدة

7
00:00:48,840 --> 00:00:53,100
ومع ذلك، ما زلت أذكر ذلك الضّوء
.السّاطع على جفوني

8
00:00:53,660 --> 00:00:57,380
.حلّقنا بحثًا عن ذلك النّور

9
00:00:58,280 --> 00:00:59,370
...قليلاً فحسب

10
00:00:59,820 --> 00:01:01,850
.قليلاً بعد، وسنصل إلى هناك

11
00:01:02,440 --> 00:01:03,790
.إلى ذلك الصّيف

12
00:01:19,680 --> 00:01:24,680
سنصل الآن إلى ميناء الصّيد
.توريشيروجيما، جزيرة توريشيروجيما

13
00:01:24,680 --> 00:01:29,520
.قد نختبر اصطدامًا قويًّا عند الرّسو

14
00:01:28,170 --> 00:01:30,690
توريشيروجيما؟

15
00:01:29,520 --> 00:01:32,900
.يُرجى البقاء في مقاعدكم حتّى إشعار آخر

16
00:01:34,050 --> 00:01:37,990
.يبدو أنّ هذا يجعلني طائر كناري لا يغرّد

17
00:01:38,380 --> 00:01:39,670
ماذا قلت؟

18
00:02:25,570 --> 00:02:31,130
جيوب صيف

19
00:03:44,360 --> 00:03:47,620
ما الّذي أفعله من الأساس؟

20
00:03:47,980 --> 00:03:51,420
وما هذا المكان؟

21
00:03:53,390 --> 00:03:54,820
.مرحبًا

22
00:03:54,820 --> 00:03:56,650
مرحبًا؟

23
00:03:56,650 --> 00:03:58,560
!مرحبًا

24
00:03:59,200 --> 00:04:03,380
!انهض من فضلك يا هايري-سان؟

25
00:04:07,050 --> 00:04:08,310
.يا إلهي

26
00:04:08,310 --> 00:04:09,640
.إنّها الثّامنة سلفًا

27
00:04:11,860 --> 00:04:13,490
.صباح الخير يا أومي-تشان

28
00:04:14,570 --> 00:04:16,170
.سأبدأ الأكل

29
00:04:16,170 --> 00:04:17,100
ما رأيك؟

30
00:04:17,100 --> 00:04:19,570
.أعددت ذلك الأرزّ المقليّ بنفسي

31
00:04:19,860 --> 00:04:21,570
مذهل، أذلك صحيح؟

32
00:04:25,310 --> 00:04:27,010
.أعتقد أنّه لذيذ

33
00:04:28,200 --> 00:04:29,390
.بوو

34
00:04:30,900 --> 00:04:32,120
.لا داعي للقلق

35
00:04:32,370 --> 00:04:34,710
.سأطلب مساعدتك لاحقًا

36
00:04:37,390 --> 00:04:40,960
اعتبر المنزل منزلك، مفهوم يا هايري-كُن؟

37
00:04:41,250 --> 00:04:42,500
...حسنًا

38
00:04:46,120 --> 00:04:49,680
مرّت بضعة أيّام منذ وصولي
.إلى توريشيروجيما

39
00:04:50,200 --> 00:04:52,980
أتيتُ للمساعدة على ترتيب
.أغراض جدّتي المتوفّاة

40
00:04:52,980 --> 00:04:56,560
أو ذلك ما ظننت، لكنّي ما زلت
.لم أقم بأيّ شيء من ذلك

41
00:04:57,770 --> 00:05:02,940
في هذه الأثناء، بدأت أتعرّف على من
.هم في مثل سنّي من السّكان هنا

42
00:05:03,650 --> 00:05:05,570
.يبدون جميعًا لطفاء

43
00:05:06,460 --> 00:05:10,330
...وإن كانوا غريبي الأطوار إلى حدٍّ ما

44
00:05:11,090 --> 00:05:12,610
.وخاصة هي

45
00:05:13,150 --> 00:05:14,710
.ناروسي شيروها

46
00:05:15,330 --> 00:05:16,600
"!دوسكوي"

47
00:05:16,600 --> 00:05:20,720
يبدو أنّ ذلك يعني "أنت مزعج
.للغاية" في اللّهجة المحلّيّة

48
00:05:20,720 --> 00:05:23,970
.إنّه ليس تعبيرًا لطيفًا لقوله للآخرين

49
00:05:24,390 --> 00:05:26,590
ما الّذي فعلته لأستحقّ ذلك؟

50
00:05:28,190 --> 00:05:30,810
ما الّذي أفعله هنا؟

51
00:05:30,810 --> 00:05:33,190
.هذا هو! الفتى الّذي ذكرته الجدّة كيدو

52
00:05:33,190 --> 00:05:35,620
.الكناري الّذي نسي كيف يغرّد

53
00:05:35,620 --> 00:05:37,570
.الكناري الّذي يغنّي الرّوك

54
00:05:37,570 --> 00:05:39,480
!مغنّي روك الكناريّ

55
00:05:39,480 --> 00:05:41,730
!لم أصف نفسي كذلك على الإطلاق

56
00:05:55,790 --> 00:05:58,210
.كان هذا أبعد ممّا توقّعت

57
00:06:24,420 --> 00:06:26,030
!مرحبًا

58
00:06:27,430 --> 00:06:28,360
موغيو؟

59
00:06:28,600 --> 00:06:29,740
موغيو"؟"

60
00:06:30,180 --> 00:06:32,990
ما الّذي تفعلينه هناك؟

61
00:06:33,480 --> 00:06:35,920
!أبحث عن شيء ما

62
00:06:35,920 --> 00:06:37,950
عمّ تبحثين؟

63
00:06:38,370 --> 00:06:40,170
!عن نفسي

64
00:06:41,630 --> 00:06:46,770
!أحاول أيضًا العثور على هدفي

65
00:06:50,760 --> 00:06:54,180
!لا أظنّ أنّ تواجدك هناك آمن

66
00:06:54,420 --> 00:06:55,520
موغيو؟

67
00:06:56,100 --> 00:06:58,540
!هذا ليس خطيرًا

68
00:06:58,540 --> 00:07:01,910
!قد تموتين إن وقعتِ

69
00:07:01,910 --> 00:07:04,110
!لن أموت

70
00:07:04,110 --> 00:07:06,320
هل أنت منيعة أو ما شابه؟

71
00:07:06,690 --> 00:07:08,990
!أنا منيعة بالفعل

72
00:07:12,170 --> 00:07:13,950
.كم أحسدها

73
00:07:24,210 --> 00:07:25,440
الحمّام؟

74
00:07:25,440 --> 00:07:26,910
.لسوء الحظّ

75
00:07:26,910 --> 00:07:29,150
.انقطعت المياه فجأة

76
00:07:29,150 --> 00:07:31,440
.بإمكاني قضاء ليلة بدون حمّام

77
00:07:31,440 --> 00:07:32,380
!مستحيل

78
00:07:32,640 --> 00:07:36,010
ستفوّت الاستحمام في الصّيف؟
!مستحيل أن تكون جادًّا

79
00:07:46,720 --> 00:07:48,730
!يا له من شعور رائع

80
00:07:48,730 --> 00:07:52,750
سأحصل على رخصتي عندما
!أبلغ السّادسة عشرة

81
00:07:52,750 --> 00:07:53,760
ماذا؟

82
00:07:53,760 --> 00:07:56,740
.إنّه اللّيل، لكنّ الأضواء مطفأة

83
00:07:57,020 --> 00:07:59,270
تقصد المنارة؟

84
00:07:59,270 --> 00:08:03,830
حسب ما سمعت، لا يوجد أحد
.يديرها، لذلك فهي خارج الخدمة

85
00:08:04,090 --> 00:08:05,560
أهكذا الأمر؟

86
00:08:14,760 --> 00:08:16,970
!أبحث عن شيء ما

87
00:08:17,320 --> 00:08:19,490
تبحث عن شيء ما؟

88
00:08:23,450 --> 00:08:24,990
.يا إلهي

89
00:08:27,210 --> 00:08:28,550
.تفضّلي

90
00:08:29,620 --> 00:08:31,700
.عفوًا، شكرًا لك

91
00:08:35,900 --> 00:08:38,780
هل تبحث عن شيء ما أيضًا؟

92
00:08:38,780 --> 00:08:40,370
.لا بدّ أنّك كذلك بالفعل

93
00:08:40,370 --> 00:08:42,890
...تسعى وراء ما لم يُرَ من قبل

94
00:08:42,890 --> 00:08:43,710
.من الأثداء

95
00:08:46,150 --> 00:08:47,470
ماذا؟

96
00:08:47,470 --> 00:08:49,020
هل قالت أثداء للتّوّ؟

97
00:08:49,020 --> 00:08:51,820
على أيّ حال، ما اسمك؟

98
00:08:53,930 --> 00:08:55,550
.أنا تاكاهارا هايري

99
00:08:55,550 --> 00:08:56,680
.هكذا إذًا

100
00:08:56,680 --> 00:08:58,430
.تاكاهارا بايري-كُن

101
00:08:59,490 --> 00:09:01,660
.مهلاً، قلتُ أنّ اسمي هايري

102
00:09:01,660 --> 00:09:02,990
.فهمت ذلك

103
00:09:02,990 --> 00:09:05,670
.بايري-كُن هو بايري-كُن ببساطة

104
00:09:05,670 --> 00:09:07,900
أليس كذلك يا بايري-كُن؟

105
00:09:09,420 --> 00:09:11,850
.أنا ميزووُري شيزوكو

106
00:09:11,850 --> 00:09:13,640
.يمكنك مناداتي شيزوكو

107
00:09:13,640 --> 00:09:15,610
.أو أثداء-سان إن أحببت

108
00:09:17,360 --> 00:09:18,460
.سأناديك شيزوكو

109
00:09:18,460 --> 00:09:21,200
.كم هذا مؤسف

110
00:09:21,200 --> 00:09:23,390
!شيزوكو

111
00:09:23,390 --> 00:09:24,670
...موغيو-غيو-غيو

112
00:09:24,670 --> 00:09:26,680
!سا-ساعديني رجاءً

113
00:09:27,370 --> 00:09:27,970
موغيو؟

114
00:09:27,970 --> 00:09:29,280
هـ-هل أنت بخير؟

115
00:09:29,280 --> 00:09:31,320
.نعم، آسفة

116
00:09:31,320 --> 00:09:33,090
.مهلاً، التقينا البارحة

117
00:09:34,780 --> 00:09:36,200
...أنت

118
00:09:36,200 --> 00:09:37,970
من أنت ثانية؟

119
00:09:39,450 --> 00:09:41,910
.شكرًا على مساعدتي

120
00:09:41,910 --> 00:09:44,350
.العفو. كان لديّ الوقت لذلك

121
00:09:44,350 --> 00:09:48,170
...شكرًا جزيلاً لك بالفعل يا

122
00:09:48,170 --> 00:09:52,730
!تاكاهارا هايري-سان

123
00:09:52,730 --> 00:09:55,110
نسيت اسمي، صحيح؟

124
00:09:55,110 --> 00:09:55,650
.نعم

125
00:09:55,650 --> 00:09:58,660
!لكنّي تذكّرته الآن يا تاكاهارا-سان

126
00:10:00,000 --> 00:10:03,850
على أيّ حال، أنا متفاجئ لأنّكما
.استطعتما القيام بكلّ هذا وحدكما

127
00:10:03,850 --> 00:10:08,920
أصرّت تسوموغي على جمع القمامة
.من الشّاطئ لأنّ ذلك قد يكون ممتعًا

128
00:10:09,650 --> 00:10:13,250
أعني أنّه يجب علينا دعم أصدقائنا
في مساعيهم، أليس كذلك؟

129
00:10:13,250 --> 00:10:14,420
أصدقاء؟

130
00:10:14,820 --> 00:10:17,100
حسنًا، هل كان ذلك ممتعًا؟

131
00:10:17,100 --> 00:10:18,800
.لم يكن ممتعًا على الإطلاق

132
00:10:19,800 --> 00:10:23,180
لماذا قرّرتُ القيام بهذا من الأساس؟

133
00:10:23,180 --> 00:10:24,720
.أنا نادمة للغاية

134
00:10:25,070 --> 00:10:26,420
أكان بهذا السّوء؟

135
00:10:26,420 --> 00:10:28,980
!لكن لديّ أصدقاء جدد الآن

136
00:10:29,960 --> 00:10:32,680
.قبل كلّ شيء، يجب فرز كلّ هذا

137
00:10:32,680 --> 00:10:34,730
مهلاً، ماذا عن هذه؟

138
00:10:34,730 --> 00:10:37,490
بارينغلر
نكهة لذيذة

139
00:10:35,350 --> 00:10:37,490
علبة بارينغلز فارغة؟

140
00:10:37,760 --> 00:10:39,000
...موغيو-غيو

141
00:10:39,000 --> 00:10:42,210
الهيكل مصنوع من الورق، لذلك
.سنضعها مع النّفايات القابلة للاشتعال

142
00:10:42,210 --> 00:10:45,150
.لكنّ القاع مصنوع من المعدن

143
00:10:45,150 --> 00:10:47,520
.لذلك لا يمكننا التّخلّص منها ببساطة

144
00:10:47,520 --> 00:10:48,640
.أعتقد ذلك

145
00:10:48,640 --> 00:10:50,960
.سيكون من الجيّد لو أعدنا تدويرها

146
00:10:51,260 --> 00:10:52,480
...موغيو

147
00:10:52,480 --> 00:10:55,130
إعادة تدوير؟

148
00:10:55,560 --> 00:10:59,510
شكرًا على مساعدتك لنا اليوم
.يا تاكاهارا-سان

149
00:11:00,010 --> 00:11:03,520
،والآن، وكعربون امتنان

150
00:11:03,520 --> 00:11:06,290
سنأخذك في جولة لرؤية المعالم
.السّياحيّة في الجزيرة

151
00:11:06,290 --> 00:11:07,680
.انظر هناك

152
00:11:07,940 --> 00:11:09,890
.جلاميد الأثداء المشهورة

153
00:11:09,890 --> 00:11:11,350
!أنا من سمّيتها كذلك

154
00:11:11,610 --> 00:11:13,600
.يا له من اسم فظيع

155
00:11:13,600 --> 00:11:15,450
.لديّ سؤال يا شيزوكو

156
00:11:15,450 --> 00:11:17,270
.ثمّة ثلاثة جلاميد

157
00:11:17,270 --> 00:11:19,610
ألا يملك النّاس ثديين في العادة؟

158
00:11:19,610 --> 00:11:20,970
!تسوموغي

159
00:11:20,970 --> 00:11:23,140
من قال أنّه لا يمكن امتلاك ثلاثة؟

160
00:11:23,140 --> 00:11:25,650
إذًا فسيكون كمكافأة؟

161
00:11:27,080 --> 00:11:28,960
وهل هذه أيضًا من معالم الجذب السّياحيّ؟

162
00:11:28,960 --> 00:11:29,980
.نعم

163
00:11:29,980 --> 00:11:31,870
.اعتاد أن يعيش هنا شخص قويّ جدًّا

164
00:11:31,870 --> 00:11:33,500
شخص قويّ؟

165
00:11:33,500 --> 00:11:34,600
.نعم

166
00:11:34,600 --> 00:11:37,830
.لكنّه هلك منذ وقت بعيد

167
00:11:37,830 --> 00:11:39,800
.لا يعيش أحد هنا الآن

168
00:11:48,880 --> 00:11:50,270
ما رأيك؟

169
00:11:50,270 --> 00:11:52,050
كيف يفترض بي الرّدّ على ذلك؟

170
00:11:52,050 --> 00:11:53,690
.تبدين رائعة يا شيزوكو

171
00:11:53,690 --> 00:11:55,690
!أنت أثداء خالصة

172
00:11:55,690 --> 00:11:56,670
!يا إلهي

173
00:11:56,670 --> 00:11:59,750
!يا لها من مجاملة يا تسوموغي

174
00:12:00,670 --> 00:12:02,650
!حسنًا، إلى اللّقاء

175
00:12:04,390 --> 00:12:07,430
أتيت معكما لأنّكما قلتما
.أنّ هنالك شيئًا أردتما القيام به

176
00:12:07,430 --> 00:12:08,650
قصدتما السّباحة إذًا؟

177
00:12:08,650 --> 00:12:11,660
.لا أهتمّ ما دامت شيزوكو تستمتع بوقتها

178
00:12:12,050 --> 00:12:14,250
هل ستسبحين بملابسك تلك يا تسوموغي؟

179
00:12:14,250 --> 00:12:15,450
.أظنّ ذلك

180
00:12:15,450 --> 00:12:17,650
،لم أحضر بذلة سباحة

181
00:12:17,650 --> 00:12:19,760
.لذا أظنّ أنّني سأكتفي بغمس قدميّ

182
00:12:20,880 --> 00:12:23,260
!لننضمّ إليها يا تاكاهارا-سان

183
00:12:27,260 --> 00:12:28,390
...أنا

184
00:12:28,970 --> 00:12:29,890
.سأعتذر عن ذلك

185
00:12:29,890 --> 00:12:30,760
موغيو؟

186
00:12:30,760 --> 00:12:33,550
ألا تحبّ أن تتبلّل؟

187
00:12:33,550 --> 00:12:35,590
.نعم، يمكنك قول ذلك

188
00:12:37,110 --> 00:12:39,730
.لكلّ شخص أسبابه على ما أظنّ

189
00:12:40,430 --> 00:12:41,800
...صحيح

190
00:12:41,800 --> 00:12:43,290
.لديّ أسبابي

191
00:12:43,840 --> 00:12:47,010
لكن لماذا لا تجرّب فعل ذلك اليوم؟

192
00:12:47,620 --> 00:12:51,870
أظنّ أنّ غمس أنفسنا معًا في الماء
.سيُنمّي صداقتنا

193
00:12:51,870 --> 00:12:53,950
.ولنقم برشّ بعضنا بالماء وما شابه

194
00:12:53,950 --> 00:12:56,460
!لننمّي صداقتنا بكلّ ما لدينا

195
00:12:56,460 --> 00:12:59,450
!أراهن أنّ ذلك سيكون ممتعًا

196
00:13:04,400 --> 00:13:08,970
!دعني أريك معدني الحقيقيّ
!هيّا بنا

197
00:13:10,190 --> 00:13:11,510
!مهلاً

198
00:13:12,970 --> 00:13:14,230
!لا-لا بأس

199
00:13:14,230 --> 00:13:15,840
!سأقوم بغمس قدميّ

200
00:13:16,560 --> 00:13:17,810
!موغيو

201
00:13:18,770 --> 00:13:20,400
!تسوموغي

202
00:13:20,400 --> 00:13:21,700
هل أنت بخير؟

203
00:13:23,190 --> 00:13:26,040
.يا إلهي... أنت مبلّلة بالكامل

204
00:13:26,040 --> 00:13:29,350
.هذا محرج بالفعل

205
00:13:30,990 --> 00:13:32,430
.إنّك في الماء

206
00:13:35,830 --> 00:13:38,730
!أنت في الماء يا تاكاهارا-سان

207
00:13:44,970 --> 00:13:49,090
.أضعتُ ما أردتُ القيام به هذا الصّيف

208
00:13:49,710 --> 00:13:51,530
...لذلك كنت أفكّر

209
00:13:51,530 --> 00:13:55,960
.ربّما أتيتُ إلى هنا لإيجاد ما أضعتُه

210
00:13:55,960 --> 00:13:57,540
.يا لها من مصادفة

211
00:13:57,540 --> 00:13:59,880
.كنتُ أبحث عن شيء ما أيضًا

212
00:13:59,880 --> 00:14:01,960
.شيء أريد القيام به

213
00:14:01,960 --> 00:14:05,040
.ولماذا أنا هنا أيضًا

214
00:14:05,040 --> 00:14:06,360
تبحثين عن لماذا أنت هنا؟

215
00:14:07,060 --> 00:14:10,170
.لطالما بدا لي ذلك كثيرًا عليّ

216
00:14:10,950 --> 00:14:15,830
لكن مع وجودكما هنا، أظنّ
.أنّني قادرة على إيجاد شيء

217
00:14:16,400 --> 00:14:17,510
.حسنًا

218
00:14:17,510 --> 00:14:21,750
لا أدري إن كنّا سنجد ما نبحث عنه
بالفعل، لكن أتريدين البحث معًا؟

219
00:14:21,750 --> 00:14:23,130
.لنعثر على ما تريدين فعله

220
00:14:23,130 --> 00:14:24,070
!موغيو

221
00:14:24,070 --> 00:14:26,220
!شكرًا جزيلاً لك

222
00:14:26,220 --> 00:14:29,820
حسنًا، ما هو هذا الشّيء الّذي أريد القيام به؟

223
00:14:29,820 --> 00:14:32,010
دخلنا صلب الموضوع مباشرة إذًا؟

224
00:14:32,010 --> 00:14:36,940
دعونا نفعل أيّ شيء تهتمّ به
.تسوموغي حتّى ولو قليلاً

225
00:14:36,940 --> 00:14:38,020
هل من أفكار؟

226
00:14:38,540 --> 00:14:40,230
...دعاني أفكّر

227
00:14:40,230 --> 00:14:42,020
!لديّ فكرة

228
00:14:42,020 --> 00:14:43,400
.كان ذلك سريعًا جدًّا

229
00:14:44,430 --> 00:14:48,360
!أريد قضاء الوقت معكما هكذا للأبد

230
00:14:48,360 --> 00:14:55,400
بإمكاننا الأكل معًا ومشاهدة
!النّجوم ليلاً والتّحدّث مطوّلاً

231
00:14:55,400 --> 00:14:58,240
تقصدين مثل حفل مبيت؟

232
00:14:58,240 --> 00:15:00,190
!هذا هو المتوقّع من شيزوكو

233
00:15:00,190 --> 00:15:01,900
!كنت أعرف ذلك

234
00:15:01,900 --> 00:15:03,250
حفل مبيت؟

235
00:15:03,530 --> 00:15:05,020
لكن هل أنت واثقة؟

236
00:15:05,020 --> 00:15:07,210
لا تمانعان المبيت معكما
رغم أنّنا التقينا للتّوّ؟

237
00:15:07,210 --> 00:15:08,990
.أنا لا أمانع

238
00:15:08,990 --> 00:15:10,520
.ولا أنا

239
00:15:10,520 --> 00:15:13,110
.أنا أحبّك يا تاكاهارا-سان

240
00:15:13,720 --> 00:15:14,620
تحبّينني؟

241
00:15:14,620 --> 00:15:17,100
.نعم! أنت شخص يسهل حبّه

242
00:15:18,130 --> 00:15:20,770
أنا كذلك إذًا؟

243
00:15:22,650 --> 00:15:25,430
!مرحبًا يا تاكاهارا-سان

244
00:15:25,960 --> 00:15:26,940
ما هذا؟

245
00:15:28,870 --> 00:15:29,950
.أنا قطّة

246
00:15:30,300 --> 00:15:31,450
.بالطّبع أنت قطّة

247
00:15:31,450 --> 00:15:33,890
.لدينا بقرة أيضًا

248
00:15:33,890 --> 00:15:35,530
.موو

249
00:15:37,820 --> 00:15:40,540
إنّك تعيشين في المنارة بالفعل يا تسوموغي؟

250
00:15:40,990 --> 00:15:43,540
.المكان هنا ظريف أيضًا

251
00:15:43,540 --> 00:15:45,030
فعلاً؟

252
00:15:45,030 --> 00:15:46,810
.إنّك تحرجني

253
00:15:46,810 --> 00:15:49,000
لماذا لا نتناول العشاء؟

254
00:15:49,000 --> 00:15:49,920
!حسنًا

255
00:15:49,920 --> 00:15:51,220
!موغيو

256
00:15:51,500 --> 00:15:56,660
،أنا معتادة على السّكن وحدي
.لذا أعددت ما يكفي لشخص واحد

257
00:15:56,660 --> 00:15:59,740
!سنموت جوعًا فحسب

258
00:15:59,740 --> 00:16:01,020
.لا داعي للقلق

259
00:16:01,020 --> 00:16:02,980
.لن نموت من الجوع ليوم واحد

260
00:16:04,810 --> 00:16:06,400
...ربّما سوف

261
00:16:07,270 --> 00:16:09,550
.أحضرتُ وجبات خفيفة

262
00:16:10,040 --> 00:16:11,280
!بارينغلز

263
00:16:11,280 --> 00:16:12,040
!موغيو

264
00:16:12,040 --> 00:16:14,160
!أحسنت يا تاكاهارا-سان

265
00:16:15,350 --> 00:16:16,660
...موغيو

266
00:16:16,660 --> 00:16:18,810
...موغيو-غيو

267
00:16:18,810 --> 00:16:21,700
.أظنّ أنّ لديّ فكرة

268
00:16:21,700 --> 00:16:22,500
.تاكاهارا-سان

269
00:16:22,900 --> 00:16:23,720
نعم؟

270
00:16:26,940 --> 00:16:29,460
!أطعمني رجاءً

271
00:16:29,460 --> 00:16:30,800
!وأنا أيضًا

272
00:16:32,090 --> 00:16:34,840
أ-أعتقد أنّي سأقوم بهذا؟

273
00:16:34,840 --> 00:16:37,430
!لذيذة

274
00:16:37,430 --> 00:16:40,350
!لا شيء يضاهي بارينغلز

275
00:16:43,500 --> 00:16:45,460
ألن أحصل على أيّ منها؟

276
00:16:51,520 --> 00:16:55,540
.لم أكن أعرف أنّ هنالك العديد من النّجوم

277
00:16:55,540 --> 00:17:00,230
.هذه إحدى الأشياء الجميلة في الجزيرة

278
00:17:01,070 --> 00:17:02,330
ما اسمها؟

279
00:17:02,330 --> 00:17:03,430
موغيو؟

280
00:17:04,710 --> 00:17:06,530
.لا أدري

281
00:17:06,530 --> 00:17:08,420
لا تعرفين اسم الأغنية الّتي تغنّينها؟

282
00:17:08,420 --> 00:17:09,060
.ذلك صحيح

283
00:17:09,060 --> 00:17:11,460
.لا أدري ما اسمها أو حتّى ما كلماتها

284
00:17:11,970 --> 00:17:16,940
.لكنّي أحببتها منذ وقت طويل

285
00:17:17,530 --> 00:17:22,740
إنّ غناء هذه الأغنية يجعلني
.أشعر وكأنّ بإمكاني إيجاد نفسي

286
00:17:22,740 --> 00:17:25,560
.كأنّني سأجد هدفي

287
00:17:26,070 --> 00:17:28,310
.إنّها تمنحني الأمل

288
00:17:28,310 --> 00:17:32,250
لماذا لا نحقّق في أمر الأغنية؟

289
00:17:32,250 --> 00:17:34,280
موغيو؟ الأغنية؟

290
00:17:34,280 --> 00:17:35,650
.يبدو ذلك جيّدًا

291
00:17:35,650 --> 00:17:38,370
.سنسأل سكّان الجزيرة عن الأغنية

292
00:17:38,740 --> 00:17:40,780
.ربّما سنعثر على شيء ما

293
00:17:40,780 --> 00:17:43,660
تريد من سكّان الجزيرة أن يسمعوا الأغنية؟

294
00:17:43,660 --> 00:17:46,620
تقصد أنّك ستقيم حفلاً من أجلي؟

295
00:17:47,660 --> 00:17:49,520
.قد يتجاوز ذلك قدراتي

296
00:17:49,520 --> 00:17:52,880
.أنا مسرورة لأنّه تسنّى لي قضاء الوقت معك

297
00:17:52,880 --> 00:17:57,380
.أنا متحمّسة جدًّا، ولا أريد الخلود للنّوم

298
00:17:58,480 --> 00:18:03,520
إذًا ربّما حفل المبيت هذا
.هو ما كنت ترغبين في القيام به

299
00:18:03,520 --> 00:18:04,270
ماذا؟

300
00:18:08,450 --> 00:18:11,320
.لستُ واثقة أنّ ذلك هو بالضّبط

301
00:18:11,930 --> 00:18:14,190
!لكنّي أريد القيام بهذا ثانية بالفعل

302
00:18:14,190 --> 00:18:18,060
عفوًا، أيمكنني دعوة شخص ما
في المرّة القادمة؟

303
00:18:18,060 --> 00:18:20,110
.صديق عزيز عليّ

304
00:18:20,110 --> 00:18:21,960
.بالطّبع

305
00:18:21,960 --> 00:18:23,080
كيف هو هذا الصّديق؟

306
00:18:23,080 --> 00:18:27,620
.إنّه لا يجيد إقامة الصّداقات

307
00:18:28,000 --> 00:18:31,530
...لكنّه لطيف جدًّا

308
00:18:32,630 --> 00:18:33,840
.يا إلهي

309
00:18:33,840 --> 00:18:35,290
.لقد غلبها النّعاس

310
00:18:35,290 --> 00:18:37,510
.بعد أن قالت أنّها لا تريد النّوم مباشرة

311
00:18:38,160 --> 00:18:40,010
.لا بأس

312
00:18:40,780 --> 00:18:44,550
.ما زال الصّيف طويلاً أمامنا

313
00:18:47,340 --> 00:18:48,890
أستذهبان للمنزل؟

314
00:18:49,190 --> 00:18:52,000
.من الطّبيعيّ العودة للمنزل

315
00:18:52,000 --> 00:18:54,270
.ستقلق عليه عائلته

316
00:18:54,670 --> 00:18:55,740
...لكن

317
00:18:55,740 --> 00:18:57,750
.لا تشعري بالإحباط

318
00:18:57,750 --> 00:19:02,260
علينا أن نرتاح جيّدًا اليوم كي
.نستمتع كثيرًا ابتداءً من الغد

319
00:19:02,260 --> 00:19:03,560
.معك حقّ

320
00:19:03,560 --> 00:19:05,620
.أراكما غدًا إذًا

321
00:19:07,030 --> 00:19:08,660
قالت "أراكما غدًا"؟

322
00:19:09,550 --> 00:19:16,110
أتساءل إن كنّا سنقوم أنا وتسوموغي
.وشيزوكو بهذا طوال الصّيف

323
00:19:23,190 --> 00:19:25,130
!استيقظت أخيرًا

324
00:19:25,130 --> 00:19:26,990
!الشّمس تغرب سلفًا

325
00:19:27,640 --> 00:19:28,650
معقول؟

326
00:19:28,650 --> 00:19:31,390
.اترك غسيلك في الخارج رجاءً

327
00:19:34,390 --> 00:19:35,400
ماذا؟

328
00:19:36,300 --> 00:19:39,940
...آسف يا تسوموغي. لقد نسيت

329
00:19:42,350 --> 00:19:43,400
تسوموغي؟

330
00:19:43,400 --> 00:19:44,400
موغيو؟

331
00:19:44,810 --> 00:19:46,480
.تاكاهارا-سان

332
00:19:46,480 --> 00:19:47,340
لماذا أنت هنا؟

333
00:19:47,340 --> 00:19:48,770
...الأهمّ من ذلك

334
00:19:48,770 --> 00:19:49,840
هو هل هنالك خطبًا ما؟

335
00:19:49,840 --> 00:19:53,330
.كـ-كلاّ، ما من خطب

336
00:19:53,330 --> 00:19:53,830
...لكن

337
00:19:54,860 --> 00:19:57,140
...اسمع يا تاكاهارا-سان

338
00:19:57,140 --> 00:19:59,490
أتودّ قضاء اللّيلة هنا ثانية؟

339
00:20:01,840 --> 00:20:03,430
...إ-إنّ ذلك

340
00:20:03,430 --> 00:20:07,460
،لكان الأمر مختلفًا لو كانت شيزوكو معنا
.لكن لا أدري بشأن بقائنا نحن الاثنين فقط

341
00:20:07,460 --> 00:20:08,800
لا يمكنك إذًا؟

342
00:20:08,800 --> 00:20:11,480
.اسمعي، ما زال الصّيف في أوّله

343
00:20:11,480 --> 00:20:13,270
.ما زالت أمامنا عدّة فرص

344
00:20:13,790 --> 00:20:15,120
.أنا لا

345
00:20:16,110 --> 00:20:18,980
.ليس لديّ الكثير من الوقت

346
00:20:19,370 --> 00:20:24,240
.عليّ العودة للمنزل قريبًا

347
00:20:26,130 --> 00:20:27,130
ماذا؟

348
00:20:27,130 --> 00:20:28,650
ماذا قلت للتّوّ؟

349
00:20:28,650 --> 00:20:32,130
لـ-لكن بإمكاننا أن نلتقي ثانية، صحيح؟

350
00:20:32,130 --> 00:20:34,670
...بإمكاننا الاتّصال وكتابة رسائل وما شابه

351
00:20:34,670 --> 00:20:35,650
.لا يمكننا

352
00:20:37,540 --> 00:20:40,090
.إنّه مكان بعيد جدًّا

353
00:20:40,820 --> 00:20:43,840
بمجرّد أن أغادر، فعلى الأرجح
.أنّنا لن نلتقي ثانية

354
00:20:44,060 --> 00:20:46,900
...تقصدين عندما ينتهي الصّيف

355
00:20:46,900 --> 00:20:48,900
أليس كذلك؟

356
00:20:48,900 --> 00:20:51,220
.كنت أنوي إخبارك

357
00:20:51,710 --> 00:20:56,600
ظننتُ أنّك ستتوقّف عن اللّعب
.معي إن أخبرتك

358
00:20:57,560 --> 00:21:05,780
لكن قبل مغادرتي، أريد اللّعب
.معك ومع شيزوكو أكثر

359
00:21:06,180 --> 00:21:09,160
...لذلك

360
00:21:10,930 --> 00:21:11,950
.آسف

361
00:21:12,360 --> 00:21:14,080
.لا يمكنني البقاء اللّيلة

362
00:21:14,910 --> 00:21:15,870
...لكن

363
00:21:17,670 --> 00:21:22,810
.سأقضي ما تبقّى من وقت معك

364
00:21:24,340 --> 00:21:26,510
...ما بقي من عطلتي الصّيفيّة

365
00:21:26,510 --> 00:21:28,850
.كلّه لك يا تسوموغي

366
00:21:30,670 --> 00:21:32,120
...هايري-سان

367
00:21:36,350 --> 00:21:38,520
ستقدّم عطلتك الصّيفيّة لتسوموغي؟

368
00:21:38,800 --> 00:21:41,780
،اتّخذتُ ذلك القرار من تلقاء نفسي

369
00:21:41,780 --> 00:21:43,920
لكن سيكون من اللّطيف
.إن انضممتِ لنا يا شيزوكو

370
00:21:45,180 --> 00:21:46,670
ألا... تريدين؟

371
00:21:46,670 --> 00:21:47,980
شيزوكو؟

372
00:21:48,480 --> 00:21:49,540
...لماذا

373
00:21:51,210 --> 00:21:54,090
بالطّبع. لماذا قد أرفض؟

374
00:21:54,090 --> 00:21:58,000
يمكنك الحصول على كلّ ما تبقّى
.من هذا الصّيف

375
00:21:58,270 --> 00:22:00,730
!أحبّك يا شيزوكو

376
00:22:00,730 --> 00:22:02,340
!أحبّك أيضًا يا تسوموغي

377
00:22:02,340 --> 00:22:03,830
!غيو

378
00:22:03,830 --> 00:22:05,220
.شكرًا يا شيزوكو

379
00:22:05,220 --> 00:22:09,300
.بل الشّكر لك أنت على هذا العرض الرّائع

380
00:22:09,300 --> 00:22:11,600
.لنستغلّ عطلة الصّيف إلى أقصى حدّ

381
00:22:11,600 --> 00:22:12,860
صحيح يا تسوموغي؟

382
00:22:13,100 --> 00:22:13,810
.عجبًا

383
00:22:13,810 --> 00:22:14,720
تسوموغي؟

384
00:22:14,720 --> 00:22:17,890
...موغيو

385
00:22:18,180 --> 00:22:19,730
...بارينغلز

386
00:22:20,020 --> 00:22:22,130
!وشرفة أيضًا

387
00:22:22,130 --> 00:22:24,640
.لا أفهم مقصدك من هذا

388
00:22:24,640 --> 00:22:26,480
بارينغلز؟

389
00:22:26,480 --> 00:22:29,040
تقصدين العلب الّتي وجدتها
أثناء جمع القمامة؟

390
00:22:29,040 --> 00:22:29,570
.نعم

391
00:22:29,570 --> 00:22:32,980
احتفظت بها لأنّني لم أستطع
.أن أقرّر أيّ نوع من القمامة هي

392
00:22:32,980 --> 00:22:34,950
.لذلك فكّرتُ في هذا ليلة الأمس

393
00:22:36,180 --> 00:22:38,250
!سنبني شرفة

394
00:22:38,570 --> 00:22:39,920
!من خلال إعادة التّدوير

395
00:22:39,920 --> 00:22:43,750
.ستتحوّل عُلب بارينغلز الفارغة إلى شرفة

396
00:22:45,610 --> 00:22:47,270
لماذا شرفة بالتّحديد؟

397
00:22:47,270 --> 00:22:48,970
.لأنّي أريد شرفة

398
00:22:49,580 --> 00:22:53,620
.لكنّها قد تنكسر وتسقط إن صعدت عليها

399
00:22:53,620 --> 00:22:55,360
!سيكون كلّ شيء بخير

400
00:22:55,360 --> 00:22:57,400
.بارينغلز منيعة

401
00:22:57,400 --> 00:23:02,150
.لكنّني لا أدري إن كنّا نملك ما يكفي لبناء شرفة

402
00:23:04,660 --> 00:23:06,800
.حسنًا، سأذهب لجمعها

403
