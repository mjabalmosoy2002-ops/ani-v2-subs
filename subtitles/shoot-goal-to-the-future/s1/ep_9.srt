1
00:00:09,650 --> 00:00:11,780
!أنت قذر

2
00:00:13,810 --> 00:00:17,450
!وكذلك الشيء الذي تحب كثيرًا

3
00:00:19,660 --> 00:00:21,050
!فتى الوحل

4
00:00:21,050 --> 00:00:22,740
.ولد مسكين

5
00:00:22,740 --> 00:00:26,040
.هذا ما يناله من تودده إلى الأستاذ ومحاولته أن يلفت الانتباه

6
00:00:26,040 --> 00:00:27,630
.أ-أنا آسف

7
00:00:27,630 --> 00:00:30,760
هل تظن أننا سنسامحك إن قلت شيئًا مضحكًا؟

8
00:00:31,390 --> 00:00:33,370
.هذا لن يغير أي شيء

9
00:00:35,800 --> 00:00:37,570
.ابق مستلقيًا هناك إلى الأبد

10
00:00:37,570 --> 00:00:39,190
.يا فتى الوحل

11
00:00:41,060 --> 00:00:43,720
،لن يأتي أي أحد لإنقاذك

12
00:00:44,690 --> 00:00:47,010
.لذا لا تستطيع سوى أن تعتذر وتتوسّل من أجل الغفران

13
00:00:49,190 --> 00:00:53,340
.كانت هذه حياتي آنذاك

14
00:00:54,470 --> 00:00:58,030
!أنت! أنت

15
00:00:58,030 --> 00:00:59,790
!سيد كرة

16
00:01:00,660 --> 00:01:02,750
...أنا واثق أنها سقطت هنا

17
00:01:03,170 --> 00:01:08,050
!سيد كرة! اخرجي

18
00:01:09,540 --> 00:01:12,590
.أعلم أنني ركلتك بقسوة

19
00:01:13,150 --> 00:01:15,560
!لكن ليس عليك أن تغضبي هكذا

20
00:01:22,550 --> 00:01:25,870
.هذا ما يناله من تودده للأستاذ ومحاولته أن يلفت الانتباه

21
00:01:31,880 --> 00:01:34,030
.حتى إن اعتذرت، لن يسامحك أي أحد

22
00:01:34,620 --> 00:01:38,240
.وإن كان هناك شيء لا يعجبهم فيك، سيدفنوك

23
00:01:38,870 --> 00:01:42,330
.لن يقبلني أي أحد أبدًا

24
00:01:58,090 --> 00:01:58,590
.اسمع

25
00:02:01,420 --> 00:02:02,390
!انتظر

26
00:02:03,640 --> 00:02:04,600
.شكرًا

27
00:02:06,010 --> 00:02:07,890
وجدت كرتي من أجلي، صحيح؟

28
00:02:08,340 --> 00:02:09,570
.أنا جو

29
00:02:10,950 --> 00:02:12,330
!اسمي

30
00:02:12,330 --> 00:02:13,170
ما اسمك؟

31
00:02:13,610 --> 00:02:16,150
.كوروكاوا سوبارو

32
00:02:16,670 --> 00:02:17,990
سوبارو إذًا؟

33
00:02:18,760 --> 00:02:20,320
!شكرًا على إنقاذي

34
00:02:27,610 --> 00:02:31,490
!بدت كمعجزة

35
00:02:32,520 --> 00:02:35,250
!بعدها، كنا معًا دائمًا

36
00:02:35,610 --> 00:02:37,500
،مع أن الذكريات الأليمة لم تزل أبدًا

37
00:02:37,500 --> 00:02:41,430
.كان جو من أبعد عني الخوف دائمًا

38
00:02:45,160 --> 00:02:49,100
.اسمع... انضمّ إليّ

39
00:02:50,660 --> 00:02:51,560
...لكن

40
00:02:52,090 --> 00:02:56,360
إن تمرّنّا نحن الاثنان، يمكننا لعب كرة القدم إلى الأبد، صحيح؟

41
00:02:57,590 --> 00:02:58,530
إلى الأبد؟

42
00:02:58,530 --> 00:03:01,240
!أجل. إلى الأبد

43
00:03:02,780 --> 00:03:05,410
!أردت أن نكون مع بعضنا إلى الأبد

44
00:03:06,170 --> 00:03:08,310
،كرّستُ نفسي لكرة القدم

45
00:03:08,650 --> 00:03:10,790
!لكي أبقى مع جو إلى الأبد

46
00:03:14,950 --> 00:03:18,390
.تغير الكثير منذ ذلك الحين

47
00:03:19,160 --> 00:03:21,310
.ولم يتغير الكثير

48
00:03:21,810 --> 00:03:23,350
.أهلًا يا سوبارو

49
00:03:26,270 --> 00:03:26,980
.مرحبًا

50
00:03:28,940 --> 00:03:30,580
!صباح الخير يا جو

51
00:03:38,710 --> 00:03:40,690
!تسوجي

52
00:03:40,690 --> 00:03:43,600
!اسمعني على الأقل

53
00:03:43,600 --> 00:03:44,820
!أرفض ذلك

54
00:03:44,820 --> 00:03:48,410
!نسى الجميع ذلك بالفعل

55
00:03:48,410 --> 00:03:50,000
!لا أهتم

56
00:03:52,590 --> 00:03:59,340
كنا نحن الاثنان دائمًا، لكننا الآن
.نحن الاثنين بالإضافة إلى تسوجي

57
00:04:00,070 --> 00:04:01,350
.إنه مشكلتك الآن

58
00:04:01,350 --> 00:04:02,030
ماذا؟

59
00:04:02,030 --> 00:04:05,060
تسوجي، إلى أين ذهبت؟

60
00:04:05,830 --> 00:04:07,180
.إلى المدرسة

61
00:04:07,180 --> 00:04:08,720
.لقد لمس جو أولًا

62
00:04:09,070 --> 00:04:11,680
جو؟ كازاما جو؟

63
00:04:11,900 --> 00:04:13,170
...أ-أجل

64
00:04:13,170 --> 00:04:14,890
!دعني أجري معك مقابلة

65
00:04:14,890 --> 00:04:16,220
تجري معي مقابلة؟

66
00:04:16,550 --> 00:04:17,500
.هذا صحيح

67
00:04:17,500 --> 00:04:19,810
.اسمي كيشيا. أنا مع نادي الصحيفة

68
00:04:19,810 --> 00:04:21,800
.أريد أن أكتب مقالة عنك

69
00:04:21,800 --> 00:04:23,230
عـ-عني؟

70
00:04:23,230 --> 00:04:24,580
!أنت مذهل

71
00:04:25,490 --> 00:04:28,890
!سيحدث الأمر أخيرًا إذًا؟ مقابلة معي

72
00:04:28,890 --> 00:04:32,350
.أريد أن أتحدث عن كونك جزءًا من ثنائي كاكيغاوا مع تسوجي

73
00:04:32,940 --> 00:04:36,380
!وعن فوزكم الكبير في التصفيات

74
00:04:36,380 --> 00:04:39,340
،وفوزكم في الجولة الأولى من مسابقة النهائيات

75
00:04:39,340 --> 00:04:42,300
!مع تلك التمريرة المذهلة في الوقت بدل الضائع

76
00:04:42,300 --> 00:04:45,630
!كان ذلك رائعًا

77
00:04:47,320 --> 00:04:47,970
أليس كذلك؟

78
00:04:47,970 --> 00:04:51,000
.كنتم ستخسرون دون تلك الأهداف

79
00:04:51,000 --> 00:04:56,690
!أنتما الثنائي الذي يفخر به فريق كاكيغاوا حقًا

80
00:04:56,690 --> 00:05:01,120
.أجل. لكنه ما زال يهدر الكثير من الفرص

81
00:05:01,120 --> 00:05:02,430
!أجل، هذه هي

82
00:05:02,430 --> 00:05:05,310
!أريد أن أسمع الأشياء التي يمكن لشريكه فقط قولها

83
00:05:05,670 --> 00:05:08,570
!أريد تشجيعه

84
00:05:08,570 --> 00:05:11,660
.أكيد، لكن القليل فقط

85
00:05:11,660 --> 00:05:13,080
!ممتاز

86
00:05:14,270 --> 00:05:17,620
.أعتبر تسوجي صديقًا بالطبع

87
00:05:18,760 --> 00:05:22,140
...لكن في كرة مرة يتحدث جو عنه

88
00:05:23,180 --> 00:05:26,550
،لسبب ما، أشعر بشدّ عميقًا في أنفي

89
00:05:27,250 --> 00:05:29,150
.وأشعر أن صدري ثقيل

90
00:05:32,370 --> 00:05:33,600
.لي الآن

91
00:05:34,850 --> 00:05:35,520
!أنت

92
00:05:35,520 --> 00:05:36,990
.أنت مدين لي لهذا الصباح

93
00:05:36,990 --> 00:05:38,100
مدين لك؟

94
00:05:38,410 --> 00:05:40,620
تريدني أن أتولى تلك المقابلة، صحيح؟

95
00:05:40,620 --> 00:05:42,980
تحمست كثيرًا لإجرائها، صحيح؟

96
00:05:43,380 --> 00:05:44,490
.أظن ذلك

97
00:05:44,840 --> 00:05:47,080
.قال أننا ثنائي كاكيغاوا المشهور

98
00:05:47,080 --> 00:05:48,490
.وأحببت كل دقيقة فيها

99
00:05:49,670 --> 00:05:53,730
لماذا لم تقبل المقابلة؟

100
00:05:53,730 --> 00:05:54,910
ألا تريد الانتباه؟

101
00:05:55,160 --> 00:06:01,380
...لا، ليس الاهتمام. بل هو

102
00:06:01,380 --> 00:06:02,540
كيشيا؟

103
00:06:02,910 --> 00:06:04,570
.كان شخصًا طيبًا

104
00:06:04,570 --> 00:06:07,330
...أجل، لكن

105
00:06:07,330 --> 00:06:08,300
...لنرَ

106
00:06:09,090 --> 00:06:10,300
.ارتدنا نفس المدرسة الإعدادية

107
00:06:11,410 --> 00:06:14,850
لكنكما الثنائي، صحيح؟

108
00:06:15,970 --> 00:06:17,480
أنا وسوبارو؟

109
00:06:17,480 --> 00:06:18,880
.أظن ذلك، أجل

110
00:06:18,880 --> 00:06:21,310
.نعرف بعضنا منذ الابتدائية

111
00:06:22,010 --> 00:06:23,520
هل تقابلتما عبر كرة القدم؟

112
00:06:23,920 --> 00:06:27,490
.لا. سوبارو أنقذني

113
00:06:27,750 --> 00:06:30,950
.جو، إنك تبالغ

114
00:06:31,740 --> 00:06:34,240
.وجدت كرتك فحسب

115
00:06:34,710 --> 00:06:36,570
.لا، لست أبالغ

116
00:06:37,080 --> 00:06:40,920
!أحببت تلك الكرة! جلبها أبي لي

117
00:06:41,330 --> 00:06:45,380
.كنت سعيدًا لإيجادها، وما زلت ممتنًا لأنك أنقذتني

118
00:06:45,850 --> 00:06:50,420
!في الواقع، أنقذتني في كثير من المرات أيضًا

119
00:06:50,890 --> 00:06:52,790
نحن ندعم بعضنا، صحيح؟

120
00:06:52,790 --> 00:06:54,340
.أجل، معك حق

121
00:06:57,170 --> 00:06:59,690
.جو علمني كرة القدم

122
00:07:02,210 --> 00:07:03,610
.هذا جميل

123
00:07:04,170 --> 00:07:07,190
.يجب أن يكتبوا مقالة عنكما

124
00:07:07,790 --> 00:07:10,810
.لا، بل نحن الاثنان من نسجل الأهداف الآن

125
00:07:10,810 --> 00:07:14,180
.إن كان هناك ثنائي كاكيغاوا، فهو أنا وأنت

126
00:07:15,230 --> 00:07:16,490
أهكذا يسري الأمر؟

127
00:07:16,490 --> 00:07:17,940
.أجل

128
00:07:18,300 --> 00:07:24,410
بينما نحن بصدد ذلك، فلنفز بمباريات كافية
!حتى نحصل على مقابلة في صحيفة حقيقية

129
00:07:24,410 --> 00:07:25,590
أليس كذلك يا شريكي؟

130
00:07:25,590 --> 00:07:28,330
أنت، من تنادي بالشريك؟

131
00:07:28,330 --> 00:07:29,610
ماذا نفعل بشأن الصورة؟

132
00:07:29,610 --> 00:07:31,010
هذه الزاوية ربما؟

133
00:07:31,010 --> 00:07:31,930
!أصغ إليّ

134
00:07:31,930 --> 00:07:33,090
.لنتمرن

135
00:07:33,370 --> 00:07:36,260
.يا سوبارو. التقط صورة

136
00:07:36,520 --> 00:07:38,040
!هيا

137
00:07:38,040 --> 00:07:41,390
!ابتعد عني! توقف

138
00:07:38,750 --> 00:07:41,030
!أسرع

139
00:07:41,390 --> 00:07:42,720
!فهمت

140
00:07:42,720 --> 00:07:43,940
.ابتسما

141
00:07:48,150 --> 00:07:50,030
...حسنًا يا كوروكاوا

142
00:07:50,030 --> 00:07:52,370
.ركز أنت على دعم تسوجي

143
00:07:52,910 --> 00:07:57,200
.الفرق الأخرى تركز أكثر على صدّ خطّ تسوجي وكوزاما

144
00:07:58,030 --> 00:08:00,990
.من الآن فصاعدًا، أنتما الاثنان ثنائيّ

145
00:08:00,990 --> 00:08:02,750
ماذا عن جو؟

146
00:08:02,750 --> 00:08:04,360
.تحدثت إليه بالفعل

147
00:08:04,710 --> 00:08:06,420
.إنه يقوم بنظام تدريبي مختلف

148
00:08:06,720 --> 00:08:07,850
لماذا؟

149
00:08:08,450 --> 00:08:10,710
...من الأفضل أن نتدرب نحن الثلاثة سويًا

150
00:08:11,180 --> 00:08:16,010
.سأجعل كازاما يتعلم أن يكون قوّةً في الملعب بنفسه

151
00:08:17,480 --> 00:08:21,460
.أصبح تسوجي مركز فريق كاكيغاوا

152
00:08:21,990 --> 00:08:25,270
.لم أمانع ذلك ما دام جو يجذب الانتباه

153
00:08:26,490 --> 00:08:32,490
لكن هل انزعج جو عند علمه أنني سأشكل ثنائيًا مع تسوجي؟

154
00:08:36,200 --> 00:08:38,030
!كوروكاوا، هنا

155
00:08:39,370 --> 00:08:40,330
!قطع جميل

156
00:08:40,330 --> 00:08:41,200
!أحسنت عملًا يا هاياشي

157
00:08:41,470 --> 00:08:43,700
!كوروكاوا، مرة أخرى

158
00:08:44,270 --> 00:08:45,170
كوروكاوا؟

159
00:08:46,420 --> 00:08:47,850
!لنفعل ذلك ثانيةً

160
00:08:47,850 --> 00:08:49,550
ما خطبه؟

161
00:08:50,030 --> 00:08:50,940
!كازاما

162
00:08:51,910 --> 00:08:53,270
هل انتهيت من تدريبك؟

163
00:08:53,270 --> 00:08:54,270
!نعم

164
00:08:54,270 --> 00:08:56,520
.حسنًا، سونودا، انضم إلى مجموعة ساهارا

165
00:08:56,520 --> 00:08:57,950
.كازاما، ابق هنا

166
00:08:57,950 --> 00:08:59,300
.كوروكاوا، تسوجي

167
00:08:59,300 --> 00:09:00,640
!نعم

168
00:09:01,130 --> 00:09:06,130
.أنتما تركزان كثيرًا على العمل كثنائي وذلك يجعلكما متيبّسين

169
00:09:06,130 --> 00:09:09,170
.كوروكاوا، ابدأ التحرك بشكل أسرع

170
00:09:09,170 --> 00:09:11,010
!حسنًا، مفهوم

171
00:09:11,010 --> 00:09:12,850
!لا تقلق

172
00:09:12,850 --> 00:09:15,010
!يستطيع سوبارو النجاح

173
00:09:16,390 --> 00:09:21,690
.كازاما، واصل العمل على التقدم فحسب

174
00:09:21,690 --> 00:09:25,040
!حسنًا! هيا بنا يا سوبارو

175
00:09:25,330 --> 00:09:26,980
!لنبذل جهدنا

176
00:09:27,400 --> 00:09:29,970
!سأسجل بعض الأهداف أيضًا

177
00:09:29,970 --> 00:09:33,380
!لذا ساعد تسوجي

178
00:09:34,310 --> 00:09:37,890
.إن كنا سنفوز، فنحن بحاجة لتسديداته

179
00:09:41,810 --> 00:09:46,550
.آسف. لم أستطع القيام بالأمر في المرة الأولى، لكن سأحاول بجد

180
00:09:46,550 --> 00:09:47,370
.أجل

181
00:09:54,110 --> 00:09:57,530
لماذا؟ لماذا يا جو؟

182
00:09:58,250 --> 00:09:59,390
...ألم تعد

183
00:10:01,090 --> 00:10:02,900
بحاجتي؟

184
00:10:04,290 --> 00:10:08,610
إن تمرنا نحن الاثنان، يمكننا لعب كرة القدم إلى الأبد، صحيح؟

185
00:10:09,890 --> 00:10:10,790
إلى الأبد؟

186
00:10:10,790 --> 00:10:13,270
!أجل. إلى الأبد

187
00:10:21,370 --> 00:10:26,120
جو... أما عدت تهتمّ؟

188
00:10:29,290 --> 00:10:31,730
.لا، هذا مستحيل

189
00:10:32,680 --> 00:10:36,390
.ما كان جو ليكذب عليّ أبدًا

190
00:10:40,810 --> 00:10:44,130
.هذه هي. إنها غلطته

191
00:10:45,130 --> 00:10:46,170
.غلطة تسوجي

192
00:10:54,100 --> 00:10:57,460
...آسف، سأعود إلى البيت

193
00:10:59,230 --> 00:11:05,570
كيشيا، قلت أنك تريد مساعدة تسوجي، صحيح؟

194
00:11:07,770 --> 00:11:10,940
.أردت أن أتحدث إليك

195
00:11:21,570 --> 00:11:23,450
!تمرين جيد

196
00:11:23,980 --> 00:11:25,280
أين كوروكاوا؟

197
00:11:25,280 --> 00:11:26,870
.إنه مصاب بمغص على ما يبدو

198
00:11:26,870 --> 00:11:28,170
.أخبرنا الأساتذة

199
00:11:28,170 --> 00:11:32,380
.قلقت من أنه تغيّب لأنه لا يريد أن يشكّل ثنائيًّا معي

200
00:11:32,380 --> 00:11:35,540
.لا، هذا لا يزال احتمالًا

201
00:11:36,190 --> 00:11:40,010
.دائمًا ما أصيبَ بمغص عندما حدث شيء سيئ

202
00:11:40,010 --> 00:11:42,750
.توقف عن هذا. هذا فأل سيئ

203
00:11:47,940 --> 00:11:49,140
يحدّقون بنا؟

204
00:11:50,250 --> 00:11:51,770
.هذا بسبب المقابلة على الأغلب

205
00:11:52,090 --> 00:11:53,530
...لكن نظراتهم نوعًا ما

206
00:11:55,810 --> 00:11:57,350
ما هذا؟

207
00:11:57,350 --> 00:11:59,650
متى وافقت على إجراء مقابلة؟

208
00:12:01,750 --> 00:12:04,970
"...العبقري الوحيد الذي فقد شريكه"

209
00:12:04,970 --> 00:12:06,930
"...عودة إعجازية"

210
00:12:06,930 --> 00:12:08,600
".توديع كوكوبو"

211
00:12:08,600 --> 00:12:11,250
"...لم يثق به فريقه لأنه لا يستطيع التسجيل"

212
00:12:11,630 --> 00:12:13,770
"...قابل فريق كاكيغاوا لكرة القدم"

213
00:12:13,770 --> 00:12:14,750
...و

214
00:12:15,340 --> 00:12:17,630
"...أصبح مهاجمًا متفوقًا حقًا"

215
00:12:17,970 --> 00:12:22,340
"...هذه قصة كاكيغاوا، وكيف ساندوا عبقريًا واحدًا"

216
00:12:25,000 --> 00:12:25,800
تسوجي؟

217
00:12:25,800 --> 00:12:28,390
!عجبًا! عبقريّ حقيقيّ

218
00:12:28,650 --> 00:12:30,680
!لم أكن أعلم

219
00:12:30,680 --> 00:12:35,300
لكن إن كان عبقريًا حقًا، لماذا لم يسجّل الأهداف؟

220
00:12:35,300 --> 00:12:40,150
لأنه كره فريقه ولم يرد منهم أن يفوزوا؟

221
00:12:40,150 --> 00:12:43,140
صدقًا؟ كان يفعل ذلك عمدًا إذًا؟

222
00:12:43,140 --> 00:12:44,740
!يا له من نذل

223
00:12:45,510 --> 00:12:46,780
!انتظر

224
00:12:47,460 --> 00:12:48,990
هل قرأت المقالة؟

225
00:12:49,540 --> 00:12:51,260
في صحيفة المدرسة؟

226
00:12:51,260 --> 00:12:52,850
أهذا صحيح؟

227
00:12:52,850 --> 00:12:53,960
.بدا ذلك ملفّقًا

228
00:12:54,350 --> 00:12:55,920
.بل هي صحيحة على ما أظن

229
00:12:57,650 --> 00:13:01,840
.كتبها أحد ارتاد نفس المدرسة مع تسوجي

230
00:13:02,100 --> 00:13:06,550
.قال كوكوبو أنه عبقري

231
00:13:06,800 --> 00:13:09,730
تشعرون بالأسف عليه، صحيح؟

232
00:13:09,730 --> 00:13:12,270
لأنه استسلم عندما لم يستطع تسجيل الأهداف؟

233
00:13:14,190 --> 00:13:17,230
.لكن لم يكن ذلك كل شيء

234
00:13:17,230 --> 00:13:18,810
ماذا تقصد؟

235
00:13:18,810 --> 00:13:22,120
أقصد أن مهاجمهم المتفوق كان يمرّ بفترة ركود، صحيح؟

236
00:13:22,500 --> 00:13:27,570
أليس على الفريق بأكمله أن يجتمع
ويحاول إيجاد طريقة لمساعدته عادةً؟

237
00:13:28,100 --> 00:13:29,160
.كما فعلنا

238
00:13:29,540 --> 00:13:34,300
،لكن إن ترك الفريق بدلًا من ذلك، ربما كان هناك سبب آخر

239
00:13:34,300 --> 00:13:37,390
.وكان مضطرًا ليترك الفريق

240
00:13:39,170 --> 00:13:40,380
.أتساءل ماذا حدث

241
00:13:40,920 --> 00:13:45,360
.لا بد أن شيئًا جللًا حدث وكان مضطرًا لترك الفريق

242
00:13:45,360 --> 00:13:49,090
لكن يمكننا أن نحزر على الأغلب،صحيح؟

243
00:13:50,300 --> 00:13:51,180
ماذا؟

244
00:13:51,580 --> 00:13:56,820
.يمكن أن يكون تسوجي متسلطًا ومتعجرفًا حقًا عندما يمنح الأوامر

245
00:13:58,100 --> 00:13:59,620
،افتراضيًا فحسب

246
00:13:59,620 --> 00:14:05,280
.ماذا إن كان يحتقر الفريق، وعرفوا ذلك وطردوه

247
00:14:06,590 --> 00:14:08,500
.أنت، إنك تبالغ كثيرًا

248
00:14:09,590 --> 00:14:10,770
.أنا آسف

249
00:14:10,770 --> 00:14:14,450
.اسمع، لا بأس ما دمت لا تكرر ذلك

250
00:14:14,850 --> 00:14:16,180
أليس كذلك يا تاتسونامي؟

251
00:14:16,180 --> 00:14:17,540
.أ-أجل

252
00:14:17,540 --> 00:14:19,950
.هيا، لنتدرب

253
00:14:20,380 --> 00:14:23,060
لم يأت تسوجي إلى هنا اليوم، أليس كذلك؟

254
00:14:27,450 --> 00:14:28,680
.فهمت

255
00:14:29,050 --> 00:14:31,560
...سيخبرك بعض الناس أن هذه ضريبة الشهرة فحسب

256
00:14:32,360 --> 00:14:33,640
.لكني آسف لأن هذا حدث لك

257
00:14:35,310 --> 00:14:36,850
.أنا آسف

258
00:14:37,340 --> 00:14:38,570
لماذا تعتذر؟

259
00:14:39,230 --> 00:14:42,310
.لأنني لم أخبرك عن هذا

260
00:14:42,670 --> 00:14:50,130
.اسمع. الجميع يعلمون أنك أكثر لاعب يعمل بجد في الفريق

261
00:14:51,750 --> 00:14:54,450
.يمكن للناس أن يتغيروا

262
00:14:55,220 --> 00:14:57,530
،كيفما كنت في الماضي

263
00:14:58,070 --> 00:15:00,700
.لم تعد كذلك في الملعب

264
00:15:01,450 --> 00:15:03,120
.آمن بفريقك

265
00:15:03,120 --> 00:15:08,950
معذرةً، ألن تقول أي شيء للجميع؟

266
00:15:09,800 --> 00:15:14,100
.حتى إن حدث شيء، هذه مشكلتي

267
00:15:16,990 --> 00:15:20,980
تسوجي، هل حدث شيء بينك وكوروكاوا؟

268
00:15:20,980 --> 00:15:22,940
.لا، ليس تمامًا

269
00:15:23,530 --> 00:15:25,040
...آمل ذلك

270
00:15:25,040 --> 00:15:27,400
ماذا تقصد؟

271
00:15:27,400 --> 00:15:29,780
.كان يقول بعض الأشياء الغريبة

272
00:15:30,120 --> 00:15:34,370
.بشأن كونك متسلطًا وتحتقر الفريق

273
00:15:35,330 --> 00:15:38,220
.لا نظن أن ذلك صحيح

274
00:15:38,220 --> 00:15:40,590
.نحن قلقون بعض الشيء فحسب

275
00:15:40,590 --> 00:15:43,230
.لستما منسجمين جيدًا كثنائي

276
00:15:43,800 --> 00:15:48,580
.بدأنا التدريب مؤخرًا فقط

277
00:15:48,580 --> 00:15:50,730
.أجل، هذا صحيح

278
00:15:50,730 --> 00:15:53,550
.لكن إن حدث شيء، تعلم أنك تستطيع أن تأتي إلينا

279
00:15:53,990 --> 00:15:56,140
.ولست بحاجة للقلق بشأن تلك المقالة أيضًا

280
00:15:56,140 --> 00:15:57,000
.أراك لاحقًا

281
00:15:57,000 --> 00:15:59,240
.انضم لنا في التدريب قريبًا

282
00:15:59,240 --> 00:16:00,250
.حسنًا

283
00:16:02,380 --> 00:16:04,190
...كوروكاوا

284
00:16:11,570 --> 00:16:13,140
.هناك ثغرة في الأمام

285
00:16:13,140 --> 00:16:14,660
!كوروكاوا! جو

286
00:16:18,230 --> 00:16:19,540
!أجل

287
00:16:20,830 --> 00:16:24,330
!سجل التالية يا معجزة كاكيغاوا

288
00:16:39,990 --> 00:16:41,310
هل حدث شيء؟

289
00:16:41,310 --> 00:16:43,180
.بدوت في حالة يرثى لها أثناء المباراة

290
00:16:47,100 --> 00:16:52,370
اسمع، هل كان كوروكاوا يتحدث عني مؤخرًا؟

291
00:16:53,080 --> 00:16:54,170
سوبارو؟

292
00:16:54,870 --> 00:16:55,890
.ليس تمامًا

293
00:16:56,410 --> 00:16:58,780
هل بسبب تلك المقالة؟

294
00:16:58,780 --> 00:17:01,740
.أحدثت فوضى عارمة

295
00:17:01,740 --> 00:17:05,680
لمَ قد يكتب كيشيا شيئًا كذلك بالضبط؟

296
00:17:05,680 --> 00:17:08,200
!كان يتحدث عن "ثنائي كاكيغاوا" وما إلى ذلك

297
00:17:09,110 --> 00:17:11,550
لأننا لسنا ثنائيًا بعد الآن، صحيح؟

298
00:17:15,770 --> 00:17:17,390
كيف عرف؟

299
00:17:17,390 --> 00:17:18,500
!هيا بنا

300
00:17:19,860 --> 00:17:22,270
لمَ أنت غاضب؟

301
00:17:22,270 --> 00:17:28,400
!كتبت تلك المقالة لأنني أردت من الجميع أن يشجعك

302
00:17:29,220 --> 00:17:33,050
هل أنتما غاضبان لأنني لم أشمل المقابلة فيها؟

303
00:17:33,430 --> 00:17:36,240
.آسف! سأشملها في نسخة الأسبوع القادم

304
00:17:37,690 --> 00:17:39,070
!إنها هنا

305
00:17:39,520 --> 00:17:44,080
مهلًا، ألم تكتب تلك المقالة لأن المقابلة لم تنجح؟

306
00:17:44,080 --> 00:17:46,040
ولماذا قد لا تنجح؟

307
00:17:46,040 --> 00:17:49,440
تعلم أننا ما عدنا ثنائيًا، صحيح؟

308
00:17:50,420 --> 00:17:52,340
—لم يخبروني ذلك

309
00:17:52,880 --> 00:17:54,440
...لم

310
00:17:54,440 --> 00:17:56,110
يخبروك ذلك؟

311
00:17:56,930 --> 00:17:59,340
إن كنت لا تعلم، لماذا قمت بتغيير المقالة؟

312
00:17:59,340 --> 00:18:02,010
...في الواقع

313
00:18:02,010 --> 00:18:02,990
!لا تهزأ بي

314
00:18:03,580 --> 00:18:07,190
!عـ-عليّ إجراء مقابلة أخرى

315
00:18:05,600 --> 00:18:06,580
!انتظر

316
00:18:18,990 --> 00:18:22,700
أين كنتما؟

317
00:18:23,180 --> 00:18:24,460
.نادي الصحيفة

318
00:18:24,460 --> 00:18:26,520
من أجل تلك المقالة عن تسوجي؟

319
00:18:26,520 --> 00:18:29,170
.قال أن نيته كانت طيبة عندما كتبها

320
00:18:29,530 --> 00:18:31,150
.هذا يجعل الأمر أسوأ

321
00:18:31,150 --> 00:18:32,250
حقًا؟

322
00:18:32,250 --> 00:18:34,800
.أحببت تلك المقالة

323
00:18:34,800 --> 00:18:38,050
أحببت حماقة الصحافة تلك؟

324
00:18:38,500 --> 00:18:41,370
.عرفت الكثير عن تسوجي من خلالها

325
00:18:42,040 --> 00:18:44,890
لا تسحبوني إلى كرة القدم ثانيةً." صحيح؟"

326
00:18:44,890 --> 00:18:50,770
إن كنت تركت كرة القدم لأن زملاءك
.كانوا يتجاهلونك، فهذا يفسّر لمَ قلتَ ذلك

327
00:18:52,060 --> 00:18:54,350
—كيف عرفت

328
00:18:54,350 --> 00:18:56,230
.أتطلع لمقالة جو أيضًا

329
00:18:56,470 --> 00:19:01,690
كيف... كيف عرفت أن المقابلة لم تلغ؟

330
00:19:02,660 --> 00:19:04,190
و"تجاهل"؟

331
00:19:04,190 --> 00:19:06,780
.لم يُذكر ذلك في المقالة

332
00:19:06,780 --> 00:19:11,960
أقصد، إلّم يذكر ذلك في المقالة، فسيُذكر
في نسخة الأسبوع القادم، صحيح؟

333
00:19:11,960 --> 00:19:13,220
أهذا كل شيء؟

334
00:19:13,580 --> 00:19:15,020
تعلم شيئًا، أليس كذلك؟

335
00:19:16,250 --> 00:19:17,410
!أجبني

336
00:19:17,410 --> 00:19:21,680
!هذا وقت مهمّ حقًا، والناس يتحدثون خلف ظهر تسوجي

337
00:19:22,000 --> 00:19:24,660
هل فكّرت في كيف سيشعر؟

338
00:19:24,980 --> 00:19:27,890
سوبارو! لن تكذب عليّ، صحيح؟

339
00:19:28,540 --> 00:19:29,850
ماذا عن كيف أشعر؟

340
00:19:32,280 --> 00:19:35,670
جو، لماذا تأخذ جانبه؟

341
00:19:38,520 --> 00:19:39,950
أما زلت لا تفهم؟ذ

342
00:19:39,950 --> 00:19:42,840
!تسوجي يستغلّنا

343
00:19:43,640 --> 00:19:45,830
!يريد جذب الانتباه لنفسه فحسب

344
00:19:46,100 --> 00:19:49,040
!ليس جديرًا بصداقتك

345
00:19:49,320 --> 00:19:50,770
...كوروكاوا

346
00:19:50,770 --> 00:19:54,930
.قال كيشيا أنه كتب تلك المقالة لجعل الناس تشجعك

347
00:19:55,240 --> 00:19:57,340
لكنه غبي، أليس كذلك؟

348
00:19:57,990 --> 00:20:00,920
!لم يفعل شيئًا سوى أنه أرى الناس من هذا الشخص حقًا

349
00:20:02,370 --> 00:20:04,500
...عندما سمعت تلك القصة، أدركتُ شيئًا

350
00:20:05,190 --> 00:20:09,890
!تسوجي، نحن مجرد بديل لكوكوبو بالنسبة لك

351
00:20:11,430 --> 00:20:16,390
!أنت فقط بحاجة لأحد يُمرّر لك غيره. مهمًا كان

352
00:20:16,390 --> 00:20:18,900
.وإلم تسجل، تلقي اللوم علينا

353
00:20:19,650 --> 00:20:23,100
!هذا يجعل حياتك سهلة، صحيح؟ لأنك لا تتعرض للأذى

354
00:20:24,840 --> 00:20:26,200
...لكن

355
00:20:26,200 --> 00:20:27,420
!لا تستخدمنا

356
00:20:29,240 --> 00:20:31,000
!لا تستخدم جو

357
00:20:32,990 --> 00:20:34,290
...كوروكاوا

358
00:20:34,850 --> 00:20:38,090
!لا بأس يا جو

359
00:20:38,360 --> 00:20:40,810
!سأحميك

360
00:20:43,220 --> 00:20:47,190
ألست صديق تسوجي؟

361
00:20:47,190 --> 00:20:49,710
ألست رفيقه؟

362
00:20:49,710 --> 00:20:55,130
ماذا؟! كيف له أن يكون صديقي وهو
!يحاول أن يسرق منّي ما أهتمّ له؟

363
00:20:56,940 --> 00:21:00,860
.هذه نهاية ما بيني وبينك إذًا

364
00:21:01,610 --> 00:21:03,070
ألا تفهم؟

365
00:21:03,380 --> 00:21:04,680
!لا أفهم

366
00:21:05,570 --> 00:21:07,920
!أردتُ حمايتك

367
00:21:07,920 --> 00:21:10,330
!لم أطلب منك ذلك

368
00:21:10,330 --> 00:21:11,790
!هذا خطؤك

369
00:21:12,210 --> 00:21:16,210
!تواصل تجاهلي وقضاء الوقت معه

370
00:21:17,530 --> 00:21:19,380
!انظر إليّ أكثر

371
00:21:20,330 --> 00:21:22,370
.أنا من يقرّر ذلك

372
00:21:22,370 --> 00:21:23,340
...أنا

373
00:21:23,780 --> 00:21:26,090
.لا أفهمك على الإطلاق

374
00:21:26,390 --> 00:21:29,240
لماذا؟ لماذا لا تفهم؟

375
00:21:29,910 --> 00:21:32,640
!أنا من كان إلى جانبك دائمًا

376
00:21:32,990 --> 00:21:35,290
...لكن فعل هذا

377
00:21:36,700 --> 00:21:38,650
!لا تملك الحق للعب كرة القدم

378
00:21:39,620 --> 00:21:40,750
ماذا تقول؟

379
00:21:41,710 --> 00:21:43,740
!أنا أكثر فائدة منك للجميع

380
00:21:44,300 --> 00:21:45,700
لماذا إذًا؟

381
00:21:45,700 --> 00:21:47,090
.يكفي

382
00:21:47,610 --> 00:21:49,660
.يمكنك لعب كرة القدم لوحدك

383
00:21:52,460 --> 00:21:53,330
...توقف

384
00:21:54,590 --> 00:21:55,690
.هذا يكفي

385
00:21:56,690 --> 00:21:57,540
.حسنًا

386
00:21:58,280 --> 00:21:59,290
.سأترك الفريق

387
00:22:02,760 --> 00:22:03,960
!تسوجي

388
00:23:34,930 --> 00:23:36,430
عرض مسبق

389
00:23:35,480 --> 00:23:36,430
!في الحلقة القادمة

390
00:23:37,180 --> 00:23:38,320
...بالطبع

391
00:23:38,320 --> 00:23:39,890
.أحبك كثيرًا