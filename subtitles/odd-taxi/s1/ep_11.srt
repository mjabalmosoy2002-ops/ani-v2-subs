1
00:01:00,450 --> 00:01:03,850
.كرهت الخسارة أكثر من غيري مذ كنتُ صغيرة

2
00:01:04,390 --> 00:01:09,170
يصفني تقييمي المدرسيّ بأنّني
.طفلة طموحة وتتدفّق بالحيويّة

3
00:01:09,170 --> 00:01:12,840
.ولكن، لا يمكننا تفادي الخسارة في الحياة

4
00:01:12,840 --> 00:01:14,980
.سواء في الدّراسة أو الرّياضة أو الفنون

5
00:01:14,980 --> 00:01:17,520
،ثمّة حدود لكلّ قدراتنا

6
00:01:17,520 --> 00:01:20,120
.وكان هنالك دائمًا أحد ما أفضل منّي

7
00:01:20,120 --> 00:01:21,310
.فيما عدى المظهر

8
00:01:23,880 --> 00:01:26,850
قمت بتجربة أداء لأصير فنّانة
.في السّادسة عشر من عمري

9
00:01:27,160 --> 00:01:30,010
كانت الطّريقة الوحيدة
.الّتي ستُستغلّ فيها موهبتي

10
00:01:31,130 --> 00:01:33,260
.سمّت نفسها ميتسويا يوكي

11
00:01:33,260 --> 00:01:36,450
.واثقة أنّك ستُقبلين
.إنّك ظريفة للغاية في النّهاية

12
00:01:36,450 --> 00:01:39,740
كانت تمارس الباليه الكلاسيكيّ
.والرّياضة مذ كانت طفلة

13
00:01:39,740 --> 00:01:42,700
.ويبدو أنّها كانت ضمن فريق جري في نفس الوقت

14
00:01:43,240 --> 00:01:45,740
.كان والدها بارزًا في فنّ الأداء التّقليديّ

15
00:01:45,740 --> 00:01:50,060
وتعرّضها للذّوق الرّفيع أدّى
.إلى امتلاكها عينًا ثاقبة

16
00:01:50,060 --> 00:01:51,920
.لم تكن تشبهني في أيّ شيء

17
00:01:51,920 --> 00:01:54,070
.كانت معتادة على تواجدها أمام الجمهور

18
00:01:54,070 --> 00:01:55,410
.كانت ذات خبرة

19
00:01:56,050 --> 00:01:57,800
.كانت في نفس سنّي، وعملت بجدّ

20
00:01:57,800 --> 00:02:01,100
.جرّبت الخسارة، لكنّها لم تخشاها

21
00:02:03,150 --> 00:02:05,430
.سمعتُ أنّني قُبلت

22
00:02:05,430 --> 00:02:07,500
.أنا مدير أعمالكنّ ياماموتو

23
00:02:05,430 --> 00:02:09,020
.كان هذا الرّجل ضخم البنية مدير أعمالي. اسمه ياماموتو

24
00:02:07,500 --> 00:02:10,500
.أؤمن أنّ دفعكنّ إلى القمّة هي مهمّتي يا فتيات

25
00:02:09,440 --> 00:02:12,060
.قُبلت ثلاث فتيات بمن فيهنّ أنا

26
00:02:11,000 --> 00:02:12,060
.سنبذل جهدنا معًا

27
00:02:12,060 --> 00:02:15,240
قُبلت ميتسويا يوكي كما هو متوقّع
.إضافة إلى إيتشيمورا شيهو

28
00:02:16,180 --> 00:02:19,270
.أعلن ياماموتو أنّني سأكون في الوسط

29
00:02:20,850 --> 00:02:25,120
يومًا بعد يوم، حضرنا دروسًا
.بينما نرتاد المدرسة

30
00:02:25,120 --> 00:02:27,160
.كان عليّ العمل بجدّ لأوّل مرّة في حياتي

31
00:02:27,660 --> 00:02:31,800
وفوق ذلك، ظلّت ميتسويا يوكي
.في فريق الجري خاصّتها

32
00:02:31,800 --> 00:02:33,390
.أغضبني ذلك

33
00:02:34,470 --> 00:02:37,880
.أحيينا أوّل حفل لنا بعد ذلك بسنة ونصف

34
00:02:37,880 --> 00:02:41,260
.كنتُ في الثّامنة عشر حينها ومتلهّفة

35
00:02:41,890 --> 00:02:44,330
.شاركتُ في عدّة احتفاليّات من أجل العمل

36
00:02:44,330 --> 00:02:47,600
.سخر منّي ثنائيّ كوميديّ لم أسمع عنهما من قبل

37
00:02:48,160 --> 00:02:49,740
.كان ذلك مهينًا

38
00:02:49,740 --> 00:02:52,310
.اعتقدتُ أنّهما كانا فاشلين معتادين على الخسارة

39
00:02:52,710 --> 00:02:56,070
،وفي طريقي للمنزل من احتفاليّة
.قابلت بابا في القطار

40
00:02:57,530 --> 00:03:01,460
صرت منزعجة بشكل متزايد
.من هذا الكوميديّ الفاشل

41
00:03:01,460 --> 00:03:04,240
،ظننتُ أنّني لن أراه ثانية أبدًا
...لذلك قلتُ له

42
00:03:04,240 --> 00:03:06,230
ألا تشعر بالإحباط؟

43
00:03:06,230 --> 00:03:09,750
إنّك تعمل في احتفاليّات تافهة
.مع فنّانات مجهولات

44
00:03:09,750 --> 00:03:13,810
كيف تشعر وأنت ترى أقرانك وحتّى
من أصغر منك وقد حقّقوا النّجاح قبلك؟

45
00:03:13,810 --> 00:03:16,630
.يا لها من مفاجأة. قال شريكي نفس الشّيء

46
00:03:16,630 --> 00:03:19,170
ألا يفكّر الجميع هكذا؟

47
00:03:19,470 --> 00:03:23,460
.شعرتُ بالإحباط في البداية، لكنّني استسلمت

48
00:03:23,460 --> 00:03:25,030
.حياتي أسهل بكثير الآن

49
00:03:25,030 --> 00:03:27,430
.أنا سعيد لنجاح أقراني وزملائي الأصغر

50
00:03:28,680 --> 00:03:32,380
ظننتُ أنّ تلك العقليّة تعني
،نهاية الطّريق لصاحبها

51
00:03:32,380 --> 00:03:34,870
لكنّني ظننتُ أيضًا أنّه سيكون من
.السّهل أن أكون على هذا النّحو أيضًا

52
00:03:40,330 --> 00:03:42,960
.لسبب ما، تبادلنا معلومات الاتّصال

53
00:03:44,170 --> 00:03:47,370
.وحينها اتُّخذ قرار أنّنا سنقدّم ظهورنا الرّئيسيّ

54
00:03:47,370 --> 00:03:49,660
.وأخيرًا، سنقدّم ظهورنا الرّئيسيّ

55
00:03:49,660 --> 00:03:51,770
.نعم. وكأنّه حلم

56
00:03:52,690 --> 00:03:56,040
لماذا أردتما أن تصيرا فنّانتين؟

57
00:03:56,040 --> 00:03:57,880
.عائلتي فقيرة

58
00:03:57,880 --> 00:04:01,350
لا أملك غرفتي الخاصّة، لذا فالحمام هو
.المكان الوحيد حيث أتمتّع بخصوصيّتي

59
00:04:01,350 --> 00:04:05,650
أريد أن أصير غنيّة لأتمكّن
.من الانتقال لمكان بحمّام كبير

60
00:04:05,650 --> 00:04:08,660
.فهمت. من الأفضل أن تعملي بجدّ إذًا

61
00:04:08,660 --> 00:04:09,680
.صحيح

62
00:04:09,680 --> 00:04:11,030
ماذا عنك يا ميتسويا-سان؟

63
00:04:11,430 --> 00:04:15,730
بصراحة، انضممت لأحصل
.على بعض الذكريات

64
00:04:16,360 --> 00:04:21,660
لكنّني ظننتُ أنّ باستطاعتنا
تحقيق شيء رائع

65
00:04:21,660 --> 00:04:23,450
.بمجرّد أن قابلتك يا نيكايدو-سان

66
00:04:23,450 --> 00:04:27,860
أوافقك الرّأي. نحن محظوظتان
.لتواجدنا في نفس المجموعة معك

67
00:04:27,860 --> 00:04:32,050
سيكون علينا العمل بجدّ
.لنحرص على ألاّ نعطّلك

68
00:04:33,030 --> 00:04:34,840
.سنرتقي نحن الثّلاثة معًا

69
00:04:34,840 --> 00:04:36,690
.سنفوز معًا

70
00:04:36,690 --> 00:04:38,740
.ظننتُ أنّ ذلك بدا حسنًا

71
00:04:39,510 --> 00:04:41,420
.كانت لدينا حصّة تسجيل وشيكة

72
00:04:41,420 --> 00:04:43,220
.كانت معنويّاتنا عالية

73
00:04:43,660 --> 00:04:46,230
.وحينها قال منتج أتى لمشاهدة درسنا ذلك

74
00:04:47,390 --> 00:04:49,810
.لنجعل هذه الفتاة في الوسط

75
00:04:53,720 --> 00:04:54,740
.المعذرة

76
00:04:59,320 --> 00:05:02,490
،في الرّابع من أكتوبر
.طلبتُ من ميتسويا يوكي مقابلتي

77
00:05:03,710 --> 00:05:07,240
.تعالي لمكتب الوكالة
.لديّ أمر مهمّ لأطلعك عليه

78
00:05:07,240 --> 00:05:10,110
.ماذا؟ لكنّ القطارات قد توقّفت

79
00:05:10,810 --> 00:05:13,570
.خذي سيّارة أجرة. أنا سأدفع

80
00:05:14,000 --> 00:05:16,550
.أنا في نيريما. ستكون الأجرة باهظة

81
00:05:16,960 --> 00:05:19,640
.كنتُ أوشك على القيام بطلب سخيف

82
00:05:19,640 --> 00:05:21,850
.لم أكن أريد أن يرانا أيّ أحد

83
00:05:21,850 --> 00:05:23,970
،يمكنني محاولة خلق الأعذار لنفسي

84
00:05:23,970 --> 00:05:26,770
لكن أعتقد أنّ رغبتي في قتلها
.كانت في تزايد في تلك المرحلة

85
00:05:30,350 --> 00:05:32,330
ميتسويا-سان، أأنت هنا؟

86
00:05:35,900 --> 00:05:37,230
ميتسويا-سان؟

87
00:05:45,340 --> 00:05:48,080
.كانت ميتسويا يوكي ميتة بالفعل

88
00:05:50,230 --> 00:05:51,680
ما الّذي تفعلينه؟

89
00:05:53,660 --> 00:05:55,040
.يا نيكايدو

90
00:05:58,540 --> 00:06:00,290
هل قتلتِها؟

91
00:06:02,520 --> 00:06:04,000
.أخبرته بكلّ شيء

92
00:06:04,000 --> 00:06:06,520
أنّني كنتُ سأطلب منها ألاّ تأخذ
.المكان الأوسط في المجموعة

93
00:06:06,520 --> 00:06:09,640
.وأنّني كنتُ أنوي قتلها إن لم توافق على ذلك

94
00:06:09,640 --> 00:06:11,640
.أريته الرّسائل الّتي تبادلناها

95
00:06:11,640 --> 00:06:14,520
.أخبرته الحقيقة عن كلّ ما حدث ذلك اليوم

96
00:06:14,520 --> 00:06:17,540
من قتلها إذًا؟

97
00:06:18,370 --> 00:06:20,550
.راودني نفس الشّعور

98
00:06:20,550 --> 00:06:22,860
.يبدو أنّ ياماموتو صدّقني

99
00:06:23,960 --> 00:06:25,460
.لا خيار أمامنا

100
00:06:26,280 --> 00:06:31,320
بعد حوالي ساعة، اتّجه ياماموتو
.للأسفل وأدخل رجلين

101
00:06:31,320 --> 00:06:36,080
رجل عصابات ضخم ورجل
.يتحدّث بكلام غريب مقفّى

102
00:06:36,360 --> 00:06:38,230
.يبدو أنّهما كانا يعرفان رئيس الوكالة

103
00:06:38,230 --> 00:06:41,080
.كم هذا مقرف، لا يروقني إطلاقًا

104
00:06:41,080 --> 00:06:44,370
ربّما أكون فتى شوارع لكنّ
.الجثث تجعلني أتصبّب عرقًا

105
00:06:44,370 --> 00:06:47,090
.يبدو أنّها خُنقت بعد أن تمّ ضربها سابقًا

106
00:06:47,090 --> 00:06:50,050
بصفتي رجلاً يرتدي بذلات
،مفصّلة خصّيصًا من دون كيخوتي

107
00:06:50,050 --> 00:06:52,640
.فهكذا ماتت حسب فرضيّتي

108
00:06:53,380 --> 00:06:55,720
.لم يكن هنالك الكثير من المارّة في تلك المنطقة

109
00:06:55,720 --> 00:06:59,350
،لكن بما أنّ الوقت كان متأخّرًا ليلاً
.كنّا لنلفت الأنظار إن رآنا أحد ما

110
00:06:59,350 --> 00:07:01,480
.كنتُ حذرة للغاية

111
00:07:02,150 --> 00:07:05,170
.لم تكن هنالك حتّى كاميرات مراقبة

112
00:07:05,170 --> 00:07:09,650
تحقّقتُ من ذلك مرّات عدّة قبل
.أن أطلب من ميتسويا يوكي مقابلتي

113
00:07:12,380 --> 00:07:14,700
.كانت مشهدًا من الكوابيس

114
00:07:15,270 --> 00:07:20,120
بعد ذلك، كان على ياماموتو العودة
.للمكتب وتنظيف المكان

115
00:07:20,120 --> 00:07:22,500
،ولمنع العثور عليها بواسطة محدّد المواقع

116
00:07:22,500 --> 00:07:27,120
وجب عليه أخذ هاتف ميتسويا يوكي لمكان
.بعيد والتخلّص منه

117
00:07:27,120 --> 00:07:28,290
.كان ذلك متعبًا

118
00:07:28,780 --> 00:07:31,930
.شرح لنا مؤدّي الرّاب ما سيحدث تاليًا

119
00:07:31,930 --> 00:07:34,970
،وكالعادة، لم أستطع فهم ما كان يقوله

120
00:07:34,970 --> 00:07:40,060
لكن بشكل أساسيّ، أراد معرفة
.ما فعلته ميتسويا يوكي يومها

121
00:07:40,060 --> 00:07:45,400
وإن أخبرت أحدًا أين ذهبت أو إن التقطتها
.كاميرات مراقبة، فسيجب علينا التّعامل مع ذلك

122
00:07:45,400 --> 00:07:50,410
كنّا لنبحث في هاتفها، لكن سيكون
.من الأسرع استعمال الشّرطة

123
00:07:50,900 --> 00:07:53,530
طلبنا من عائلتها تقديم بلاغ باختفائها

124
00:07:53,530 --> 00:07:57,700
ووجدنا طريقة لجعلهم يسحبون
.الطّلب بعد جمعنا للمعلومات

125
00:07:58,230 --> 00:08:00,520
يبدو أنّ ثمن التّخلّص من جثّة

126
00:08:00,520 --> 00:08:04,000
كان نصف أرباح ميستري كيس المستقبليّة

127
00:08:04,000 --> 00:08:06,920
والسّماح لهم باستعمال أعضائنا
.كيفما يشاؤون للعمل

128
00:08:06,920 --> 00:08:08,460
.كان ذلك هو الاتّفاق

129
00:08:14,360 --> 00:08:17,800
.واصلتُ التّحديق في الماء حتّى بعد غرقها

130
00:08:19,040 --> 00:08:21,080
.كانت الشّمس قد بدأت تشرق

131
00:08:23,940 --> 00:08:27,230
هل سنكون بخير؟
هل سيسير كلّ شيء على ما يرام؟

132
00:08:27,230 --> 00:08:31,190
.كنّا متعبين جدًّا على القلق

133
00:08:31,860 --> 00:08:36,160
بعد ذلك بعدّة أيّام، عرّفنا
.ياماموتو على فتاة جديدة

134
00:08:36,160 --> 00:08:37,490
.أنا من كيوشو

135
00:08:37,490 --> 00:08:40,400
.اسمي واداغاكي ساكورا. سررت بلقائكما

136
00:08:40,400 --> 00:08:42,650
.شرحت الوضع لها مسبقًا

137
00:08:42,650 --> 00:08:45,720
.ستواصل العمل باسم ميتسويا يوكي

138
00:08:45,720 --> 00:08:48,870
ماذا؟ ماذا عن ميتسويا-سان الحقيقيّة؟

139
00:08:49,480 --> 00:08:51,100
.إنّها مفقودة

140
00:08:51,100 --> 00:08:52,130
ماذا؟

141
00:08:52,130 --> 00:08:53,730
.لا يمكنني التّواصل معها

142
00:08:54,150 --> 00:08:57,890
لكن ألا تعتقد أنّه من الباكر
إضافة عضوة جديدة؟

143
00:08:57,890 --> 00:09:01,180
.انطلاقتنا الرّئيسيّة وشيكة. الوقت يداهمنا

144
00:09:01,180 --> 00:09:03,990
.خلاف نيكايدو، سيكون عليكما ارتداء هذه

145
00:09:04,540 --> 00:09:07,560
أقنعنا عائلة ميتسويا يوكي
بالسّماح لنا باستعمال اسمها

146
00:09:07,560 --> 00:09:10,320
.وذلك لتتمكّن من مواصلة العمل بعد عودتها

147
00:09:10,930 --> 00:09:14,490
وإلى عودة ميتسويا يوكي، سيكون
.عليهما ارتداء الأقنعة أمام النّاس

148
00:09:14,490 --> 00:09:17,690
.قبلت إيتشيمورا بذلك الشّرح

149
00:09:17,690 --> 00:09:20,030
.شعرت بالسّوء حيالها، لكن ما باليد حيلة

150
00:09:20,030 --> 00:09:26,660
!هيّا، هيّا! هيّا، هيّا

151
00:09:23,540 --> 00:09:27,210
...لا بدّ أنّ الجميع ظنّ التّالي
."ليت ميتسويا يوكي هنا"

152
00:09:27,210 --> 00:09:29,720
.كنتُ لأسحق تلك الظّنون

153
00:09:30,170 --> 00:09:31,520
.أقسمت أن أفعل

154
00:09:33,760 --> 00:09:37,350
علينا أن نعتاد على ذلك، لذلك
.سأناديك ميتسويا-سان. آسفة

155
00:09:37,350 --> 00:09:40,760
.لا بأس. أنا هنا لأكون ميتسويا يوكي

156
00:09:40,760 --> 00:09:44,010
ميتسويا-سان، لا تمانعين عدم
استعمال اسمك ووجهك؟

157
00:09:44,010 --> 00:09:45,240
.على الإطلاق

158
00:09:45,240 --> 00:09:49,300
،عندما فشلت في تجربة الأداء هذه
.رفضت تقبّل الأمر

159
00:09:49,300 --> 00:09:51,970
.ذهبتُ للحديث مباشرة مع ياماموتو-سان

160
00:09:51,970 --> 00:09:54,400
"!قلتُ "أشركني، أشركني، أشركني

161
00:09:54,400 --> 00:09:56,080
.هذا مثير للإعجاب

162
00:09:56,080 --> 00:10:01,210
.فعندما فشلت، أخبروني أنّي كنتُ رابع خيار

163
00:10:01,210 --> 00:10:05,000
أليس ذلك محبطًا؟
.كدت أُقبل. كنت وشيكة

164
00:10:05,000 --> 00:10:07,310
لم تفكّري في القيام بتجارب
أداء في مكان آخر؟

165
00:10:07,310 --> 00:10:10,570
.نعم. فقد سمعتُ أنّك قُبلتِ

166
00:10:10,570 --> 00:10:12,950
.عرفتُ أنّك ستكونين مشهورة

167
00:10:12,950 --> 00:10:14,360
تريدين الشّهرة؟

168
00:10:14,360 --> 00:10:15,460
.أريدها

169
00:10:15,460 --> 00:10:17,680
.كبرتُ في منزل أمّ عزباء

170
00:10:17,680 --> 00:10:20,730
أردت أن أصير مشهورة لتستطيع
.أمّي في كيوشو العيش بهناء

171
00:10:20,730 --> 00:10:24,790
رغم أنّها تعمل، تستيقظ باكرًا
.لتجهيز الغداء لي

172
00:10:24,790 --> 00:10:26,090
.هكذا إذًا

173
00:10:26,090 --> 00:10:28,890
.أشعر أنّني لا أتسبّب سوى بالمشاكل لأمّي

174
00:10:28,890 --> 00:10:31,400
.فلا مَواطن قوّة لي

175
00:10:31,400 --> 00:10:34,090
،أتمنّى أحيانًا أن أختفي فحسب

176
00:10:34,090 --> 00:10:37,370
.لكنّ رؤية الفنّانات على التّلفاز أبهجتني

177
00:10:38,450 --> 00:10:41,330
.انتظرنا اللّحظة المناسبة للقيام بحفل مباشر

178
00:10:41,330 --> 00:10:45,370
قال ياماموتو أنّنا حصلنا على علامات
.قبول، لكن لم أكن راضية

179
00:10:45,370 --> 00:10:49,170
.تذوّقتُ مرارة الهزيمة
.كان بإمكاننا تقديم ما هو أفضل

180
00:10:49,170 --> 00:10:53,560
".ليت ميتسويا يوكي كانت هنا"

181
00:10:53,560 --> 00:10:56,300
.لم أستطع التملّص من تلك الفكرة أيضًا

182
00:10:57,230 --> 00:10:59,340
.وحينها انتشر الخبر

183
00:10:59,340 --> 00:11:01,700
".اختفاء فتاة ثانويّة من نيريما"

184
00:11:02,010 --> 00:11:04,770
،تحدّث ياماموتو مع عائلة ميتسويا يوكي

185
00:11:04,770 --> 00:11:06,460
.وقد قدّموا بلاغ شخص مفقود للشّرطة

186
00:11:06,970 --> 00:11:09,870
،بما أنّ والدها كان مشهورًا
حرصوا على ألاّ يسمحوا لاسمها

187
00:11:09,870 --> 00:11:13,360
.وحقيقة أنّها كانت فنّانة بأن تنشر في البلاغ

188
00:11:13,360 --> 00:11:14,970
.أتت الشّرطة للوكالة

189
00:11:14,970 --> 00:11:17,610
.ساعدتُ في تحقيقهم مرّات عدّة

190
00:11:18,150 --> 00:11:22,910
يومها، استقلّت ميتسويا يوكي
.سيّارة أجرة في نيريما، ثمّ اختفت

191
00:11:22,910 --> 00:11:27,000
كانوا بحاجة فقط لتتبّع أثر تحركات
.ميتسويا يوكي إلى أن وصلت للوكالة

192
00:11:27,000 --> 00:11:30,370
لكن كانت المشكلة في سيّارة الأجرة
.الّتي استقلّتها حينها

193
00:11:30,370 --> 00:11:32,830
.كنتُ خائفة ممّا قد يقوله السّائق

194
00:11:32,830 --> 00:11:35,790
.ربّما قامت كاميرا السّيّارة الدّاخليّة بتسجيلها

195
00:11:35,790 --> 00:11:38,340
كان من المبهر أنّنا تمكّنّا
،من العثور على سيّارة الأجرة

196
00:11:38,340 --> 00:11:41,260
.لكن كانت تلك مهمّة مؤدّي الرّاب وياماموتو

197
00:11:41,800 --> 00:11:46,120
كلّ ما كان بوسعنا هو مواصلة
.العمل بثبات كفنّانات

198
00:11:46,460 --> 00:11:50,380
بما أنّنا جمعنا بعض المعلومات
،من الشّرطة وبلاغات الأخبار

199
00:11:50,380 --> 00:11:53,020
كانت الخطوة التّالية هي سحب
.بلاغ الأشخاص المفقودين

200
00:11:53,020 --> 00:11:57,560
،وبينما كنّا نتحرّى أمر ميتسويا يوكي
.اكتشف مؤدّي الرّاب شيئًا

201
00:11:58,070 --> 00:12:02,350
.علاقة بين والد ميتسويا يوكي ومجرم

202
00:12:02,900 --> 00:12:05,620
.كان حلم ميتسويا يوكي أن تصير فنّانة

203
00:12:05,620 --> 00:12:10,590
ولكن، بسبب قلقها حيال علاقة
،والدها بمنظّمة إجراميّة

204
00:12:10,590 --> 00:12:13,350
،اعتقدت أنّها على تلك الحال
لم تستطع أن تصبح فنّانة

205
00:12:13,350 --> 00:12:14,760
.وقرّرت الهرب من المنزل

206
00:12:14,760 --> 00:12:18,550
.هذا ما أخبرنا به عائلة ميتسويا يوكي

207
00:12:18,550 --> 00:12:22,240
وفي النّهاية، تمّ سحب بلاغ
.الأشخاص المفقودين بهدوء

208
00:12:23,680 --> 00:12:25,720
.عدتُ لحياتي العاديّة

209
00:12:25,720 --> 00:12:27,610
هل رآنا أحد ما؟

210
00:12:27,610 --> 00:12:29,320
ماذا إن علم أحدهم بالأمر مسبقًا؟

211
00:12:29,320 --> 00:12:32,590
ماذا إن ربّت أحدهم على كتفي
من الخلف بينما أتجوّل في الأرجاء؟

212
00:12:32,590 --> 00:12:35,870
.ساءت وتيرة خفقان قلبي
.صرت أتنفّس بصعوبة

213
00:12:36,310 --> 00:12:40,610
.لم أستطع الكفّ عن التّعرّق
.ارتعشت يداي. أردتُ الصّراخ

214
00:12:41,030 --> 00:12:43,820
.تمنّيت بشدّة العودة للماضي

215
00:12:43,820 --> 00:12:46,660
.ثمّ عدت لحياتي اليوميّة ثانية

216
00:12:46,660 --> 00:12:50,540
.ربّما سأدور في هذه الحلقة لبقيّة حياتي

217
00:12:51,040 --> 00:12:52,620
.ظننتُ أنّني سأفقد عقلي

218
00:12:52,620 --> 00:12:55,160
.تمهّل، لا تقل شيئًا بعد. ثمّة قوانين

219
00:12:55,160 --> 00:12:56,080
.حسنًا، لنبدأ

220
00:12:56,080 --> 00:12:57,560
مرحبًا، ماذا على الغداء؟

221
00:12:56,530 --> 00:12:59,490
.كان بابا من دعمني

222
00:12:59,490 --> 00:13:02,160
.لم أخبره بأيّ شيء بالطّبع

223
00:13:02,160 --> 00:13:05,380
.أنقذني وجوده إلى جانبي ببساطة فحسب

224
00:13:05,380 --> 00:13:06,840
.كان مصدر راحتي الوحيد

225
00:13:07,590 --> 00:13:11,520
كرهت أن أخسر، وسمحت
.طريقة عيشه تلك بذلك

226
00:13:11,520 --> 00:13:14,180
.لا بأس إن خسرتُ. وطبعًا، لا بأس إن فزتُ أيضًا

227
00:13:14,180 --> 00:13:16,500
.لا يهمّ في كلتا الحالتين

228
00:13:16,500 --> 00:13:17,800
.أمكنني تصديق ذلك

229
00:13:17,800 --> 00:13:20,590
.أردتُ أن أسعده

230
00:13:20,590 --> 00:13:24,810
.أتى الشّتاء. وأتى على حين غرّة

231
00:13:25,200 --> 00:13:29,120
المتوفّاة من سكّان مدينة نيريما تُدعى
.ميتسويا يوكي-سان، وكان عُمرها 18 سنة

232
00:13:29,120 --> 00:13:33,950
كانت ميتسويا يوكي-سان عضوة
.في مجموعة فنّانات ميستري كيس

233
00:13:33,950 --> 00:13:38,320
.صُدم المعجبون بأخبار موتها المفاجئة

234
00:13:42,710 --> 00:13:44,400
.يا لظرافة الشّجرة

235
00:13:45,200 --> 00:13:46,480
.معك حقّ

236
00:13:47,530 --> 00:13:52,040
،تمّ العثور على جثّة ميتسويا يوكي
.الفنّانة من مجموعة ميستري كيس

237
00:13:52,040 --> 00:13:55,580
.ستقيم وكالتها مؤتمرًا صحفيًّا بعد نهاية الأخبار

238
00:13:56,600 --> 00:14:01,940
سنبدأ العمليّة بعد أسبوع من الآن
.16:00 في 25 من ديسمبر السّاعة

239
00:14:01,940 --> 00:14:04,980
يجب أن أنتظرك في ساحة المواقف وقتها، صحيح؟

240
00:14:04,980 --> 00:14:07,540
نعم. هل شاهدت الأخبار؟

241
00:14:07,540 --> 00:14:09,410
.على الأرجح أنّ المدير ياماموتو لن يحضر

242
00:14:09,410 --> 00:14:12,920
،لحسن حظّنا. كلّما قلّ رجال يانو
.سهُل الأمر علينا أكثر

243
00:14:12,920 --> 00:14:14,280
.هذه مشكلة

244
00:14:14,280 --> 00:14:15,150
ماذا؟

245
00:14:15,150 --> 00:14:16,370
.لا عليك

246
00:14:16,370 --> 00:14:19,150
.صحيح. ثمّة مشكلة

247
00:14:19,150 --> 00:14:22,540
.عُثر على جثّة ميتسويا يوكي قرب مخبأ يانو

248
00:14:22,540 --> 00:14:25,110
.من المحتمل أنّهم انتقلوا

249
00:14:25,110 --> 00:14:28,330
وإن حدث ذلك، سيكون الطّريق الّذي
.افترضتُ أنّهم سيسلكونه بلا فائدة

250
00:14:33,540 --> 00:14:35,020
.أجبت بالفعل

251
00:14:35,360 --> 00:14:36,520
ما الأمر؟

252
00:14:36,520 --> 00:14:38,650
ألن تذهب مع فريق يانو اليوم؟

253
00:14:38,650 --> 00:14:41,670
.لا وقت لديّ لذلك الآن. تعلم هذا

254
00:14:41,670 --> 00:14:42,760
.كلامك صحيح

255
00:14:42,760 --> 00:14:45,280
.أهذا كلّ شيء؟ لديّ مؤتمر صحفيّ لأحضره

256
00:14:45,280 --> 00:14:46,790
.أريد التّحقّق من شيء واحد

257
00:14:46,790 --> 00:14:47,880
ماذا؟

258
00:14:47,880 --> 00:14:50,570
ميتسويا يوكي في الصورة الّتي ظهرت في الأخبار

259
00:14:50,570 --> 00:14:53,380
وميتسويا يوكي الّتي أوصلتُها
.بسيّارتي شخصين مختلفين

260
00:14:55,830 --> 00:14:57,600
هل أنت واثق أنّ الأمر لم يختلط عليك؟

261
00:14:57,600 --> 00:15:01,200
.أوصلتكما معًا. الفتاة الّتي تحبّ الدّجاج المقليّ

262
00:15:01,880 --> 00:15:03,690
.ذكّرني ذلك بشيء

263
00:15:03,690 --> 00:15:06,370
...الفتاة الّتي أوصلتُها في الرّابع من أكتوبر

264
00:15:08,180 --> 00:15:09,300
ماذا؟

265
00:15:10,140 --> 00:15:11,540
ما هذا؟

266
00:15:13,110 --> 00:15:16,290
...لا يمكنني استعمال ياماموتو. ممّا يعني

267
00:15:24,900 --> 00:15:27,980
تبًّا. ما الّذي يفعله؟

268
00:15:34,990 --> 00:15:38,440
.آسف، لكنّك ستظلّ هنا حتّى الكريسماس

269
00:15:39,600 --> 00:15:42,960
.ما عدت أهتمّ بعد الآن

270
00:15:43,670 --> 00:15:45,330
.تمّ إلغاء الحفل

271
00:15:45,330 --> 00:15:47,590
.لن يطلقوا ألبومهم

272
00:15:48,280 --> 00:15:51,370
.لا أصدّق أنّ ميتسويا يوكي-سان قد ماتت

273
00:15:52,090 --> 00:15:56,560
،عندما رأيتها أوّل مرّة في الحفل
.وجدت أنّها راقصة ممتازة

274
00:15:57,050 --> 00:15:58,280
،بالتّفكير في الأمر الآن

275
00:15:58,280 --> 00:16:02,080
ميتسويا يوكي-سان الّتي ترتدي القناع
.شخص مختلف تمامًا

276
00:16:04,070 --> 00:16:06,520
.يوم هزيمة دوبو-سان هو اليوم وكلّي فخر

277
00:16:06,520 --> 00:16:08,820
.سأجبره على تقليدي بتاج النّصر

278
00:16:08,820 --> 00:16:10,870
.في نيل استحسان الزّعيم ولو بالكاد سأنجح

279
00:16:10,870 --> 00:16:13,220
.سيكون هذا أفضل كريسماس كما اتّضح

280
00:16:13,220 --> 00:16:15,340
—إنّ الرّياح تهبّ اليوم. والبرد

281
00:16:14,590 --> 00:16:15,340
...المعذرة

282
00:16:15,340 --> 00:16:16,810
!أيّها الريفيّ المغفّل، أغلق فمك

283
00:16:16,810 --> 00:16:18,330
.إنّه دوري الآن فالزم حدّك

284
00:16:18,330 --> 00:16:20,600
.لكن أظنّ أنّه لا حاجة للتّجهير

285
00:16:20,600 --> 00:16:22,460
.يمكنني قول أنّك راعِيّ إن جاز التّعبير

286
00:16:22,460 --> 00:16:25,880
بوضع العاطفة جانبًا، ما مسعاك يا صغير؟

287
00:16:26,290 --> 00:16:29,920
هلاّ شغّلتما مؤتمر ميستري كيس الصّحفيّ؟

288
00:16:42,530 --> 00:16:46,920
.هذا سيّئ. يتذكّر سائق الأجرة وجه واداغاكي

289
00:16:46,920 --> 00:16:48,440
.بالطّبع يتذكّره

290
00:16:48,950 --> 00:16:51,250
هل من طريقة لتحويل هذا لأمر إيجابيّ؟

291
00:16:51,700 --> 00:16:54,270
إن اكتشف العالم أنّنا حاولنا
...التّغطية على الأمر

292
00:16:54,270 --> 00:16:56,110
.بدأنا للتّوّ تذوّق طعم النّجاح

293
00:16:56,640 --> 00:17:00,080
أنا واثقة أنّ بعضًا من الخمسة الّذين
.حضروا أوّل حفل لنا يتذكّرونها أيضًا

294
00:17:00,080 --> 00:17:01,320
.ذلك ليس ممكنًا وحسب

295
00:17:01,320 --> 00:17:02,720
.معك حقّ

296
00:17:06,560 --> 00:17:07,710
مرحبًا؟

297
00:17:08,320 --> 00:17:11,500
.نعم، أنا بخير. سأبذل جهدي

298
00:17:12,070 --> 00:17:12,930
.نعم

299
00:17:13,520 --> 00:17:15,430
.حظًّا سعيدًا في منافسات الخاسرين

300
00:17:16,160 --> 00:17:19,050
.أعد أن أقف بعد هذا ثانية

301
00:17:20,140 --> 00:17:23,860
.هل أنت بخير؟ آسف لأنّني لم ألاحظ

302
00:17:24,500 --> 00:17:26,810
.أنا لستُ قادرًا على العمل بجدّ

303
00:17:26,810 --> 00:17:30,490
.نعم. لكن لا تضغطي على نفسك كثيرًا. مع السّلامة

304
00:17:30,490 --> 00:17:32,200
أنت، ما الّذي تفعله؟

305
00:17:32,200 --> 00:17:32,860
.آسف

306
00:17:32,860 --> 00:17:34,300
.لنراجع نكاتنا

307
00:17:34,300 --> 00:17:35,480
.فعلنا للتّوّ

308
00:17:35,480 --> 00:17:37,470
.ما زلنا لا نعرف أيّ النّكات سنقدّم

309
00:17:37,470 --> 00:17:39,070
.ظننت أنّنا اتّفقنا على مخبأ المقهى

310
00:17:39,070 --> 00:17:42,070
.نظرًا لهذا الجوّ، قد تكون نكتة آلة الزّمن أفضل

311
00:17:42,070 --> 00:17:44,950
.أتذكّر نكتة آلة الزّمن. سأكون بخير

312
00:17:46,260 --> 00:17:47,980
أما عدت تهتمّ لهذا أبدًا؟

313
00:17:47,980 --> 00:17:49,920
.إن فشلنا، فسننفصل

314
00:17:52,270 --> 00:17:53,300
ماذا؟

315
00:17:55,050 --> 00:17:57,400
.أنت من سيكون في ورطة إن انفصلنا

316
00:17:57,400 --> 00:18:00,640
.اسمع يا بابا، صرتَ مغرورًا بشكل فظيع

317
00:18:01,050 --> 00:18:03,090
.وأنت كنت أكثر إضحاكًا

318
00:18:03,090 --> 00:18:05,000
.لا يمكنني مشاهدتك وأنت تنهار

319
00:18:05,000 --> 00:18:08,970
تظنّ أنّ كلّ الأفلام والمسلسلات والمؤدين
.الكوميديين ذو الشّعبيّة الآن غير مضحكين

320
00:18:08,970 --> 00:18:11,270
.أنت من لا يعيش في العصر

321
00:18:13,240 --> 00:18:15,900
.أفهم أنّك تحبّ كوميديا المانزاي

322
00:18:15,900 --> 00:18:18,320
.أعلم أنّني أعرقل تقدّمك أيضًا

323
00:18:18,800 --> 00:18:22,320
.لذلك أنا آسف يا شيباغاكي. لننفصل اليوم

324
00:18:32,390 --> 00:18:34,700
.سنغلق قريبًا

325
00:18:40,740 --> 00:18:45,310
عُثر على زوجين داخل سيّارة وقعت"
"في البحر، أيعقل أنّه انتحار ثنائيّ؟

326
00:18:46,440 --> 00:18:51,470
حوالي السّاعة 4:15 في رصيف
،تاكيشيبا في حيّ ميناتو

327
00:18:51,470 --> 00:18:56,860
عُثر على الموظّف أودوكاوا كيوشي-سان"
من محافظة سايتاما في مدينة تشيتشيبو

328
00:18:56,860 --> 00:19:00,030
وزوجته يومي-سان ميّتين داخل
".سيّارة غرقت في البحر

329
00:19:00,030 --> 00:19:04,780
.هرب ابنهما، الطالب في الصفّ الرابع، بمفرده"
".لكنّه فاقد للوعي وفي حالة حرجة

330
00:19:04,780 --> 00:19:09,840
تحقّق الشّرطة في احتماليّة"
".انتحار ثنائيّ بالإكراه

331
00:19:13,710 --> 00:19:17,760
.أنا آسف على كلّ المتاعب الّتي سبّبناها

332
00:19:22,460 --> 00:19:25,040
لم نستطع إخفاء صدمتنا

333
00:19:25,510 --> 00:19:28,600
.منذ أن علمنا بالعثور على جثّة ميتسويا يوكي

334
00:19:29,010 --> 00:19:32,330
.في أكتوبر، اتّصلت بنا أمّ ميتسويا يوكي

335
00:19:32,330 --> 00:19:35,190
.لتخبرنا أنّ ابنتها لم تعد للمنزل

336
00:19:35,750 --> 00:19:39,760
فعلنا كلّ ما في استطاعتنا للمساعدة
.في البحث عنها، لكنّنا فشلنا في إيجادها

337
00:19:40,370 --> 00:19:45,160
وأيضًا، كان يفترض لميستري كيس
،أن تقوم بانطلاقتها قريبًا

338
00:19:45,680 --> 00:19:52,180
وطلبنا من فتاة أخرى تقدّمت لتجارب
.الأداء أن تحلّ محلّ ميتسويا يوكي

339
00:19:53,810 --> 00:19:59,410
وفي النّهاية، عنى ذلك أنّنا خدعنا
،العالم ومن لهم علاقة بالأمر

340
00:19:59,980 --> 00:20:02,300
.وعلى ذلك، نقدّم بالغ أسفنا

341
00:20:02,300 --> 00:20:05,770
.سمعتُ أنّ الشّرطة تحقّق في الموضوع كجريمة قتل

342
00:20:05,770 --> 00:20:07,920
هل لديكم أدنى فكرة عمّا حدث لها؟

343
00:20:08,550 --> 00:20:14,530
بشأن ذلك، كان أجرها منخفضًا
.قبل بداية المجموعة

344
00:20:15,030 --> 00:20:17,410
أعتقد أنّها روّجت لنفسي في وسائل
التّواصل الاجتماعيّ

345
00:20:17,410 --> 00:20:19,730
.وربّما كانت مقرّبة من المعجبين أيضًا

346
00:20:19,730 --> 00:20:22,150
أتعني أنّها قتلت على يد معجب ما؟

347
00:20:22,150 --> 00:20:25,480
.كلاّ، أقول أنّه احتمال فحسب

348
00:20:26,090 --> 00:20:31,330
إنّنا نتحمّل مسؤوليّة الإخفاق في حماية
.خصوصيّتها وضمان الأمن الكافي لها

349
00:20:31,330 --> 00:20:36,920
لا توجد كلمات تعبّر عن مدى
.ندمنا على ما حدث

350
00:20:37,400 --> 00:20:42,380
كما أنّنا لا نتحمّل النّظر إلى وجه
شوفوتي دونراكو-سان

351
00:20:42,380 --> 00:20:45,890
.الّذي عهد بابنته لنا في الوكالة

352
00:20:47,230 --> 00:20:48,500
.يا إلهي

353
00:20:49,930 --> 00:20:51,580
.هذا غير معقول

354
00:20:56,880 --> 00:20:57,820
.مرحبًا

355
00:20:58,660 --> 00:21:01,360
.لم أعتقد أبدًا أنّني قد أساعدكم

356
00:21:01,360 --> 00:21:03,530
ألا يفترض بك أن تستعدّ؟

357
00:21:03,530 --> 00:21:07,740
.بما أنّهم نقلوا مخبأهم، سأتبعهم من المصرف

358
00:21:07,740 --> 00:21:09,040
.فهمت

359
00:21:09,370 --> 00:21:11,410
أين رفيقك وأخوك العزيز؟

360
00:21:11,410 --> 00:21:13,480
.لم يحضر للعمل منذ مدّة

361
00:21:13,480 --> 00:21:16,150
،لاحظتُ خطبًا ما في تصرّفاته

362
00:21:16,150 --> 00:21:19,920
لكن لا أصدّق أنّ أخي الصّغير
.الوديع يتجاهل اتّصالاتي

363
00:21:19,920 --> 00:21:23,300
أخبرني يا سائق الأجرة، هل أخبرته بأمر ما؟

364
00:21:24,420 --> 00:21:27,270
لا يُعقل. نحن في نفس الجانب الآن، صحيح؟

365
00:21:27,910 --> 00:21:30,350
،بالنّظر للأمر هكذا، وبشكل عامّ

366
00:21:30,350 --> 00:21:33,030
.فقد كنّا في نفس الجانب منذ البداية

367
00:21:39,810 --> 00:21:41,600
.حان الوقت

368
00:21:41,600 --> 00:21:46,290
تعلم ما الّذي سيحدث لك إن خرجت
عمّا يجدر بك قوله، صحيح؟

369
00:21:55,860 --> 00:21:59,000
أُحيل بي إليك من طرف الطّبيب
.كاتو من مستشفى مينامي ناكانو

370
00:21:59,000 --> 00:22:00,320
.اسمي غوريكي

371
00:22:00,320 --> 00:22:04,050
.أودّ أن أسألك حول أودوكاوا هيروشي

372
00:22:04,710 --> 00:22:08,340
.كان أودوكاوا هيروشي-كُن مريضي

373
00:22:08,740 --> 00:22:11,220
هل بإمكانك أن تصف لي كيف كان حينها؟

374
00:22:11,220 --> 00:22:14,640
.قضى حوالي شهرين في هذا المستشفى

375
00:22:14,640 --> 00:22:19,080
كان يُفترض أن يواصل إعادة التّأهيل
،في عيادة خارجيّة بعدها

376
00:22:19,080 --> 00:22:22,350
لكن أخبرتنا المحكمة أنّ فاعل خير
،قد ظهر في الصّورة

377
00:22:22,350 --> 00:22:24,610
.ثمّ تمّ نقله إلى طوكيو

378
00:22:24,610 --> 00:22:26,720
.لا ندري ما الّذي حدث له بعدها

379
00:22:26,720 --> 00:22:29,740
كيف كانت حالته النّفسيّة بعد الحادثة؟

380
00:22:30,120 --> 00:22:33,330
.لم تكن لديه أيّ ذكريات عن الحادثة

381
00:22:33,330 --> 00:22:38,340
لم نلحظ أيّ مشاكل في وظائفه
،الحركيّة الأساسيّة وقدراته اللّغوية

382
00:22:38,340 --> 00:22:43,840
لذلك نصحناه بالاحتفاظ بمذكّرة
.للعمل على شفائه نفسيًّا

383
00:22:43,840 --> 00:22:46,880
.بدت حالته النّفسيّة مستقرّة لنا

384
00:22:46,880 --> 00:22:48,840
.أخبرني المزيد عن مذكّرته

385
00:22:48,840 --> 00:22:51,940
سجّل قوانين الحياة في المستشفى وأدويته

386
00:22:51,940 --> 00:22:55,900
.وجدول استحمامه ومعلومات أخرى متعلّقة به

387
00:22:55,900 --> 00:22:57,980
.كانت أشبه بيوميّات خاصّة

388
00:22:57,980 --> 00:23:00,870
ما انطباعك بعد قراءة المذكّرة؟

389
00:23:00,870 --> 00:23:03,980
.ظننتُ أنّه طفل غريب

390
00:23:04,320 --> 00:23:05,760
هل لديك تلك المذّكرة؟

391
00:23:05,760 --> 00:23:06,670
.نعم

392
00:23:06,670 --> 00:23:11,290
.بما أنّك قلت أنّك قادم، قرأتها ثانية بعد 30 سنة

393
00:23:11,290 --> 00:23:13,760
هل يمكنني إلقاء نظرة عليها؟

394
00:23:14,760 --> 00:23:18,660
أعلم أنّك قلتَ أنّك طبيب
،أودوكاوا هيروشي-كُن الحاليّ

395
00:23:18,660 --> 00:23:21,970
.لكن ليس مسموحًا لطبيب عامّ مثلك رؤيتها

396
00:23:24,450 --> 00:23:26,460
.لا أطلب منك رؤيتها لأنّني طبيبه

397
00:23:32,060 --> 00:23:33,870
!أطلب ذلك بصفتي صديقه

398
00:23:34,970 --> 00:23:50,340
الحلقة القادمة
ليس كافيًا

399
00:23:35,450 --> 00:23:36,830
أتأكل بشكل جيّد؟

400
00:23:36,830 --> 00:23:37,500
.نعم

401
00:23:37,500 --> 00:23:39,640
.من المهمّ أن تعيش حياة منظّمة

402
00:23:39,640 --> 00:23:40,380
.أعلم ذلك

403
00:23:40,380 --> 00:23:41,680
.وقد بأمان

404
00:23:41,680 --> 00:23:42,400
.حسنًا

405
00:23:42,400 --> 00:23:44,530
.وكفّ عن جعل الجميع يقلقون عليك

406
00:23:44,530 --> 00:23:45,400
.آسف على ذلك

407
00:23:45,400 --> 00:23:46,840
—عليك تكوين عائلة

408
00:23:46,840 --> 00:23:49,940
!اخرس! لستَ أبي! نحن في نفس العمر