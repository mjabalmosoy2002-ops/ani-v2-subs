1
00:01:39,830 --> 00:01:41,100
.أيّها الشّابّ

2
00:01:42,450 --> 00:01:45,070
هل كاباساوا تايتشي في الجامعة الآن؟

3
00:01:45,070 --> 00:01:47,740
كاباساوا تايتشي؟

4
00:01:47,740 --> 00:01:48,910
.صحيح

5
00:01:48,910 --> 00:01:50,420
إنّه مشهور، صحيح؟

6
00:01:50,420 --> 00:01:52,650
.ما عاد يحضر الدّروس

7
00:01:52,650 --> 00:01:55,880
اغترّ بنفسه بالإفصاح عن جامعته
.للعلن، لكنّه خائف في الواقع

8
00:01:55,880 --> 00:01:57,950
،قد يتعامل معه النّاس على الإنترنت كإله

9
00:01:57,950 --> 00:02:01,700
لكن بيننا نحن، إنّه مشهور، لكونه
.جبانًا يسعى للاعتراف بيأس

10
00:03:08,290 --> 00:03:09,510
.كاكيهانا-سان

11
00:03:09,510 --> 00:03:11,800
.نعرف أنّك في الدّاخل يا كاكيهانا-سان

12
00:03:14,350 --> 00:03:17,740
!يا كاكيهانا! عليك إعادة ما استعرتَه

13
00:03:17,740 --> 00:03:20,130
ألم يعلّمك والداك ذلك؟

14
00:03:26,310 --> 00:03:28,390
ما خطبك يا سائق سيّارة الأجرة؟
أجئت لتسليم نفسك؟

15
00:03:28,390 --> 00:03:30,660
أنت هنا لتسلّم نفسك، صحيح؟ ماذا فعلت؟

16
00:03:30,660 --> 00:03:32,190
!ألا تراني آكل طعامي؟

17
00:03:32,190 --> 00:03:33,690
أين أخوك اليوم؟

18
00:03:33,690 --> 00:03:35,650
.سأخبرك أيّها الغبيّ

19
00:03:35,650 --> 00:03:38,070
.عمل أخي في دوريّة النّهار

20
00:03:38,070 --> 00:03:39,310
.لقد انتهى عمله سلفًا

21
00:03:39,310 --> 00:03:40,640
.ممتاز. سأبلّغ عن حادثة

22
00:03:40,640 --> 00:03:41,820
ماذا؟

23
00:03:41,820 --> 00:03:43,950
.ثمّة من أطلق رصاصًا على منزلي

24
00:03:43,950 --> 00:03:46,450
هذا خطير! لماذا لم تتّصل برقم الطّوارئ؟

25
00:03:46,450 --> 00:03:48,150
.تعال معي فحسب

26
00:03:48,150 --> 00:03:49,840
.حسنًا. سأتّصل بأخي

27
00:03:49,840 --> 00:03:51,630
.أريدك أن تأتي وحدك

28
00:03:51,630 --> 00:03:52,910
لماذا؟

29
00:03:52,910 --> 00:03:54,820
.تصبح الأمور صعبة عندما يتورّط أخوك فيها

30
00:03:54,820 --> 00:03:57,180
.ربّما أكون أخي

31
00:03:58,990 --> 00:04:01,570
.وحدهم الأقارب من يجدون نكاتًا كهذه مضحكة

32
00:04:01,570 --> 00:04:04,570
.معك حقّ. أحبّت جدّتي هذه النّكتة

33
00:04:04,570 --> 00:04:06,840
.قل أنّك خارج للقيام بدوريّة

34
00:04:06,840 --> 00:04:07,870
.مفهوم

35
00:04:12,270 --> 00:04:14,410
أخبرني، هل سندخل إلى منزلك؟

36
00:04:14,410 --> 00:04:15,450
.نعم

37
00:04:16,710 --> 00:04:18,800
—لكنّك كما تعلم

38
00:04:18,800 --> 00:04:22,720
هذا محرج للغاية، ولستُ واثقًا
كيف أصف الأمر، لكن ألا تملك

39
00:04:22,720 --> 00:04:24,540
تلميذة الثّانويّة من نيريما محتجزة هناك؟

40
00:04:24,540 --> 00:04:27,720
.كان هذا مباشرًا لحدٍّ عجيب
.لكن لا، بالطّبع لا

41
00:04:30,590 --> 00:04:31,950
.لم تكن تمزح

42
00:04:31,950 --> 00:04:33,260
.هذا هو الخرطوش

43
00:04:33,260 --> 00:04:36,470
.مهلاً لحظة. لا أستطيع الاهتمام بهذا وحدي

44
00:04:36,470 --> 00:04:40,450
ثمّة الكثير من المعاملات الورقيّة
...والإجراءات الّتي يجب اتّباعها

45
00:04:40,450 --> 00:04:42,970
والعديد من القواعد بشأن
...حفظ مكان الجريمة أيضًا

46
00:04:41,860 --> 00:04:43,670
.لا أنوي أن تُحقّق الشّرطة في هذا

47
00:04:43,670 --> 00:04:46,310
ماذا؟ هل أنت غبيّ؟

48
00:04:46,310 --> 00:04:49,880
لنفترض أنّني ذهبت إلى روبّونغي
.ليلاً وشربت حتّى الثّمالة

49
00:04:49,880 --> 00:04:52,880
،وأنّ القطارات لا تعمل
.فاتّصلت بسيّارة أجرة وأتيت أنت

50
00:04:52,880 --> 00:04:56,170
ما الّذي ستعتقده إن أخبرتك
أنّني لا أنوي الذّهاب للمنزل؟

51
00:04:56,170 --> 00:05:00,340
أو افترض أنّني ذهبت لحلاّق وأخبرته
أن يمنحني قصّة شعر طويل؟

52
00:04:59,320 --> 00:05:01,960
.خطر لي أن أطلعك على الحقيقة

53
00:05:01,960 --> 00:05:02,920
أيّ حقيقة؟

54
00:05:03,430 --> 00:05:07,440
،أيّها الأخ دايمون الصّغير
لماذا أردت أن تصبح شرطيًّا؟

55
00:05:07,440 --> 00:05:09,400
.لدحر الشّرّ

56
00:05:09,400 --> 00:05:11,910
ولماذا ترغب في دحر الشّرّ؟

57
00:05:14,910 --> 00:05:16,610
هلا أخبرتني؟

58
00:05:20,380 --> 00:05:22,270
!تسارع

59
00:05:22,270 --> 00:05:24,340
.كنشيرو، كوشيرو

60
00:05:24,340 --> 00:05:26,490
.سنخرج بعد قليل

61
00:05:26,490 --> 00:05:28,310
!حسنًا! إلى اللّقاء

62
00:05:28,310 --> 00:05:29,930
.أحضرا لنا كعكًا

63
00:05:34,180 --> 00:05:36,160
!اصطدام

64
00:05:40,140 --> 00:05:43,910
.قُتل والدانا على يديّ سائق مسرع وهارع

65
00:05:45,870 --> 00:05:48,270
.وكانت سيّارة أجرة أيضًا

66
00:05:48,700 --> 00:05:51,990
.لهذا السّبب لا تتحمّل النّظر إليّ

67
00:05:51,990 --> 00:05:55,780
.سنقبض على الأشرار بأيدينا

68
00:05:55,780 --> 00:05:57,560
.هذا ما أقسمنا عليه أنا وأخي

69
00:05:57,560 --> 00:05:59,680
.أو ربّما هكذا كان الوضع في السّابق

70
00:05:59,680 --> 00:06:00,850
عمّ تتحدّث؟

71
00:06:00,850 --> 00:06:03,720
.لكن الآن، أخوك شرّير

72
00:06:03,720 --> 00:06:07,960
اسمع. صحيح أنّ أخي يختار اللّون
.الأسود عندما نلعب أوتيلو

73
00:06:07,960 --> 00:06:10,490
،وعندما نلعب المطاردة
.يريد أن يكون الهدف دائمًا

74
00:06:10,490 --> 00:06:11,710
—لكنّ ذلك لا يعني

75
00:06:11,710 --> 00:06:14,140
.إنّ أخاك يعمل مع دوبو

76
00:06:14,140 --> 00:06:18,220
سمعتُ بشأن ذلك سابقًا
.وسألت أخي عنه

77
00:06:18,220 --> 00:06:20,300
.وكان جوابه بالرّفض

78
00:06:20,300 --> 00:06:21,830
هل تصدّقه؟

79
00:06:21,830 --> 00:06:23,150
.بالطّبع

80
00:06:23,150 --> 00:06:25,790
،إن خُيّرتُ بينك وبين أخي
!فسأصدّق أخي بالطّبع

81
00:06:25,790 --> 00:06:29,030
أيّ نوع من التّوائم تظنّنا؟

82
00:06:29,030 --> 00:06:30,610
.نحن توأم متطابق

83
00:06:30,610 --> 00:06:31,870
هل تكره دوبو؟

84
00:06:31,870 --> 00:06:33,750
.نعم. إنّه شرّير قبل كلّ شيء

85
00:06:33,750 --> 00:06:37,410
،أيّها الأخ دايمون الصّغير
.سأمنحك فرصة للقبض على دوبو

86
00:06:37,410 --> 00:06:39,660
!فعلاً؟! سيكون ذلك مذهلاً

87
00:06:39,660 --> 00:06:42,850
،لكن إن اعتقلته بشكل عاديّ
.فسيُتّهم بجريمة صغيرة ليس إلاّ

88
00:06:42,850 --> 00:06:45,030
هل ينوي القيام بأمر ما؟

89
00:06:45,030 --> 00:06:45,770
.نعم

90
00:06:45,770 --> 00:06:46,850
ماذا؟

91
00:06:46,850 --> 00:06:48,500
.أنا أعمل مع دوبو الآن

92
00:06:48,500 --> 00:06:51,080
!مهلاً! أنت شرّير

93
00:06:51,080 --> 00:06:53,800
.اهدأ. أنا أتظاهر أنّني أعمل معه فحسب

94
00:06:53,800 --> 00:06:57,310
لكنّك ستصبح شرّيرًا أكثر بشكل
!تدريجيّ بتظاهرك بالعمل معه

95
00:06:57,310 --> 00:06:59,060
.اجلس لو سمحت

96
00:07:00,020 --> 00:07:02,730
.انتظر لحظة، اخرس واستمع

97
00:07:04,890 --> 00:07:06,440
هل تعرف يانو؟

98
00:07:09,560 --> 00:07:11,250
.بإمكانك الكلام عندما أطرح الأسئلة

99
00:07:11,250 --> 00:07:14,470
.يانو؟ إنّه شرّير من النّوع الّذي يظلّ مختبئًا

100
00:07:14,470 --> 00:07:17,080
.دوبو ويانو غريمين

101
00:07:17,080 --> 00:07:19,620
.ونجد زعيمهما على رأسهما

102
00:07:20,170 --> 00:07:23,630
.عمل دوبو ويانو هو تسليم المال لزعيمهما

103
00:07:23,630 --> 00:07:26,500
إنّهما ليسا على وفاق لأنّهما يتنافسان
.على جمع المبلغ الأكبر

104
00:07:30,720 --> 00:07:33,800
والمبلغ هنا هو المال القليل
.أو الكثير الّذي يعطيانه

105
00:07:33,800 --> 00:07:36,450
إن كان لديك شيء تقوله
.أو أيّ سؤال، فيمكنك الكلام

106
00:07:37,230 --> 00:07:39,100
هل تعرف من هو زعيمهما؟

107
00:07:39,100 --> 00:07:43,730
،قبل مدّة، قبل أن نصبح شرطيّين
.اعتُقل دوبو بتهمة السّطو على مصرف

108
00:07:44,060 --> 00:07:46,460
.قد يكون زعيمه هو الجاني الأساسيّ

109
00:07:46,460 --> 00:07:50,730
.فهمت. وأخوك هو أحد معاوني دوبو

110
00:07:50,730 --> 00:07:53,960
إن لم تكفّ عن ذلك، سأوسعك
!ضربًا يا سائق سيّارة الأجرة

111
00:07:53,960 --> 00:07:56,990
لماذا؟ لماذا قد يعمل أخي معه؟

112
00:07:56,990 --> 00:08:00,280
.لا أدري إن كان الدّافع المال أو شيئًا آخر

113
00:08:00,710 --> 00:08:04,790
أعتقد أنّ دوبو يرشي شرطيًّا
.ليسهل عليه القيام بعمله

114
00:08:04,790 --> 00:08:07,410
كيف تقول ذلك بدون دليل؟

115
00:08:07,410 --> 00:08:09,660
.لهذا السّبب ستعتقل دوبو

116
00:08:09,660 --> 00:08:11,670
!لكنّ أخي سيُعتقل أيضًا

117
00:08:11,670 --> 00:08:14,470
.يبدو أنّك بدأت تصدّقني

118
00:08:15,540 --> 00:08:16,750
تكره الشّرّ، صحيح؟

119
00:08:16,750 --> 00:08:17,940
.أكرهه

120
00:08:17,940 --> 00:08:20,860
،إذًا إن كان أخوك يقوم بأشياء شرّيرة
.فعليك أن تعاقبه إذًا

121
00:08:20,860 --> 00:08:23,470
.وإلّا، فسيتزعزع حسّك بالعدالة

122
00:08:24,130 --> 00:08:27,190
.سأعاقبه. هذا إن كان يقوم بأفعال شرّيرة

123
00:08:27,610 --> 00:08:30,900
.وأنا أتظاهر بالعمل مع دوبو

124
00:08:31,380 --> 00:08:33,000
اسمك أودوغاوا؟

125
00:08:33,000 --> 00:08:33,790
.بل أودوكاوا

126
00:08:33,790 --> 00:08:37,450
هذا لا يهمّ. أنت الوحيد
.الّذي يهتمّ لذلك التّفصيل

127
00:08:38,020 --> 00:08:40,920
هل تعرف أنّ دوبو يُلاحَق من طرف
منشئ محتوى مباشر؟

128
00:08:40,920 --> 00:08:43,340
.هل أعرفه؟ أنا مشترك بقناته

129
00:08:43,340 --> 00:08:45,680
.أنا معجب كبير بكاباساوا تايتشي

130
00:08:45,680 --> 00:08:47,520
.إنّكما تسعيان خلف نفس الشّيء

131
00:08:47,520 --> 00:08:48,770
.بالضّبط

132
00:08:49,490 --> 00:08:51,750
إذًا فأنت تعرف بأمر قناع الجمجمة أيضًا، صحيح؟

133
00:08:51,750 --> 00:08:53,710
ذلك الفتى الّذي ظهر في نادي الكاباري؟

134
00:08:53,710 --> 00:08:55,090
ألم يكن ذلك دوبو؟

135
00:08:55,090 --> 00:08:56,780
.لم يكن هو

136
00:08:56,780 --> 00:08:59,940
.يبدو أنّه كان شخصًا سرق مسدّس دوبو

137
00:08:59,940 --> 00:09:02,710
.ولسبب ما، يريد قتلي

138
00:09:02,710 --> 00:09:04,940
.وهذا سبب ما حدث هنا

139
00:09:04,940 --> 00:09:07,950
،بتعبير آخر، يريد دوبو الإمساك بكاباساوا

140
00:09:07,950 --> 00:09:12,230
،واستعادة مسدّسه من قناع الجمجمة
.وتصبح له الأفضليّة على يانو

141
00:09:12,230 --> 00:09:15,040
،أريد حماية نفسي من قناع الجمجمة الغامض

142
00:09:15,040 --> 00:09:18,820
.لذلك أتظاهر بالعمل مع دوبو

143
00:09:19,150 --> 00:09:20,330
.هذا غير منطقيّ

144
00:09:20,330 --> 00:09:22,890
.لا يوجد سبب يدفعك للعمل مع دوبو

145
00:09:22,890 --> 00:09:26,290
.عليك ترك مسألة قناع الجمجمة للشّرطة

146
00:09:27,060 --> 00:09:29,600
هل أنت واثق أنّك لستَ ذكيًّا بالفعل؟

147
00:09:32,670 --> 00:09:34,880
.لديّ ضغينة ضدّ دوبو أيضًا

148
00:09:34,880 --> 00:09:37,170
.حدث أمر فظيع لأحد أصدقائي

149
00:09:37,170 --> 00:09:38,580
.أريد أن أطيح به

150
00:09:38,580 --> 00:09:39,760
من هذا؟

151
00:09:40,260 --> 00:09:44,450
خلاصة الأمر، ينوي دوبو السّطو
.على مصرف قريبًا

152
00:09:44,450 --> 00:09:47,690
!هذا شرّير بكلّ وضوح! ستكون جريمة مكرّرة

153
00:09:47,690 --> 00:09:50,220
،إنّه يظنّ أنّني سأساعده

154
00:09:50,220 --> 00:09:53,750
.لذلك ستعتقل دوبو حينها أيّها الأخ دايمون الصّغير

155
00:09:53,750 --> 00:09:58,520
،هذا رائع إن كان صحيحًا
.لكنّك ستُعتقل أيضًا يا أودوكاوا

156
00:09:58,520 --> 00:10:02,000
.لا بأس. إنّنا نقوم بهذا لدحر الشّرّ

157
00:10:02,330 --> 00:10:05,280
.إنّك عكس الشّرّ

158
00:10:05,280 --> 00:10:07,740
لماذا لا تصفني بالخيّر فحسب؟

159
00:10:08,580 --> 00:10:12,630
كنتَ مقنِعًا للغاية، لكن يصعب
.تصديق كلّ هذا فجأة

160
00:10:13,530 --> 00:10:18,970
أوافقك. لهذا السّبب سأواصل
.السّعي خلف أدلّة

161
00:10:19,740 --> 00:10:22,320
في البداية، ظننتُ أنّك الخاطف

162
00:10:22,320 --> 00:10:25,680
.في قضيّة تلميذة الثّانويّة المفقودة في نيريما

163
00:10:26,290 --> 00:10:28,540
هل يمكنني إلقاء نظرة على منزلك؟

164
00:10:29,320 --> 00:10:30,250
.أكيد

165
00:10:47,540 --> 00:10:49,270
.من مقرّ الشّرطة الرّئيسيّ لكافّة الأقسام

166
00:10:49,270 --> 00:10:52,250
عُثر على جثة مجهولة الهويّة
.عند مصبّ نهر سوميدا

167
00:10:52,250 --> 00:10:54,190
.ليتّجه كشك الشّرطة القريب إلى هناك

168
00:10:54,190 --> 00:10:56,550
...أعيد، من مقرّ الشّرطة

169
00:10:56,550 --> 00:10:57,600
.عليّ الذّهاب

170
00:10:57,600 --> 00:10:58,940
هل تصدّقني؟

171
00:10:58,940 --> 00:11:00,530
!بالطّبع لا

172
00:11:00,530 --> 00:11:04,260
،لكنّني سأستمع لك
.إن كان ذلك سيقود لدحر الشّرّ

173
00:11:04,260 --> 00:11:07,220
!هذا هو رقم هاتفي الخاصّ

174
00:11:29,170 --> 00:11:31,040
.أبليت حسنًا

175
00:11:31,940 --> 00:11:35,650
.عُثر على جثّة مجهولة الهويّة في خليج طوكيو

176
00:11:45,930 --> 00:11:48,300
،هذا الصّباح قبل الفجر
،عند رصيف شيباورا في حيّ ميناتو

177
00:11:48,300 --> 00:11:52,200
.عُثر على جثّة امرأة بين سنّ المراهقة والثّلاثينيّات

178
00:11:52,200 --> 00:11:54,900
،بلّغ عمّال بناء على مقربة بالجثّة

179
00:11:54,900 --> 00:11:58,060
،وحسب تحقيقات الشّرطة
،فإنّ الضّحيّة قُتلت في مكان آخر

180
00:11:58,060 --> 00:12:00,000
.لا يمكنك الهرب الآن

181
00:11:58,060 --> 00:12:00,010
.وأنّ جثّتها رُميت في البحر بعدها

182
00:12:00,010 --> 00:12:02,540
.ويعتقدون أنّه قد مرّ شهر على موتها تقريبًا

183
00:12:12,660 --> 00:12:17,880
كلّ ما يمكنني قوله هو أنّني جدّ"
.آسفة على المشاكل الّتي تسبّبت بها لك

184
00:12:19,210 --> 00:12:23,740
أخبرني دوبو-سان أنّه لا يحتاج
".لمساعدتي أو المال بعد الآن

185
00:12:24,790 --> 00:12:26,950
،يبدو أنّ هنالك سببًا وراء ذلك"

186
00:12:26,950 --> 00:12:30,100
.لكن أعتقد أنّ هذا يعني أنّ علاقتي قد حُلّت

187
00:12:31,370 --> 00:12:34,010
".آمل أن تسامحني

188
00:12:37,930 --> 00:12:41,890
.أنا جدّ آسفة

189
00:12:42,630 --> 00:12:44,690
رجل يُدعى دوبو؟

190
00:12:44,690 --> 00:12:48,520
.نعم. لكنّ علاقتي معه قد حُلّت

191
00:12:48,520 --> 00:12:49,660
.على الأرجح

192
00:12:50,970 --> 00:12:53,740
.لا بدّ أنّ أودوكاوا فعل شيئًا ما

193
00:12:53,740 --> 00:12:57,540
قال أودوكاوا-سان أنّه سيتظاهر
.بالعمل مع دوبو-سان

194
00:12:58,340 --> 00:13:00,980
.فهمت. هذا منطقيّ

195
00:13:00,980 --> 00:13:05,930
على الأرجح أنّه يحاول إنقاذ كلّ منّا
.في الآن ذاته بفعله لذلك

196
00:13:06,800 --> 00:13:10,000
هل هنالك شيء ما يمكنني فعله؟

197
00:13:10,680 --> 00:13:15,730
،حسنًا، لا يمكنني الدّفع لك
لكن هلاّ ساعدتني في عملي؟

198
00:13:15,730 --> 00:13:18,700
عملك؟ أيّ عمل؟

199
00:13:18,700 --> 00:13:22,150
ماذا تقصدين؟ هل نسيت كيف أجني قوت يومي؟

200
00:13:24,110 --> 00:13:27,360
.سنعالج أودوكاوا

201
00:13:37,250 --> 00:13:39,050
.هذا مؤلم. تشنّجت قدمي

202
00:13:39,050 --> 00:13:40,540
.هذا مؤلم

203
00:13:40,540 --> 00:13:42,700
...قدمي متشنّجة. تؤلم بشدّة

204
00:13:50,770 --> 00:13:53,390
آسف، وصلت للتّوّ. أين أنت؟

205
00:13:53,970 --> 00:13:55,430
.هنا، هنا

206
00:13:56,070 --> 00:13:58,850
.ماذا؟ لا أراك يا شيهو-تشان

207
00:13:58,850 --> 00:14:00,950
.كاكّي، أنا هنا

208
00:14:03,130 --> 00:14:05,900
.آسف على جعلك تنتظرين يا شيهو-تشان

209
00:14:05,900 --> 00:14:09,000
.لا بأس. أتيت في الوقت المناسب يا كاكّي

210
00:14:09,870 --> 00:14:12,240
.قام أحد مساعديّ باقتراف خطأ

211
00:14:12,240 --> 00:14:14,010
لذلك وجب أن أنظّف خلـ— ماذا؟

212
00:14:14,010 --> 00:14:16,040
مهلاً، قلتِ أنّني أتيت في الوقت المناسب؟

213
00:14:22,010 --> 00:14:24,840
.أحسنت عملاً. كوني حذرة في طريق العودة

214
00:14:25,110 --> 00:14:27,360
.لا تتأخّري على حدث الهالوين في شيبويا

215
00:14:43,360 --> 00:14:44,820
.ها نحن أولاء

216
00:14:43,360 --> 00:14:44,820
هل أبدو ظريفة؟

217
00:14:43,360 --> 00:14:44,820
.هذا جنوني

218
00:14:51,030 --> 00:14:51,860
.مؤلم

219
00:14:52,990 --> 00:14:55,790
!أنا من عليه قول أنّ ذلك كان مؤلمًا

220
00:14:55,790 --> 00:14:58,470
أين كنت تنظر، هل فقدت بصرك؟

221
00:14:58,470 --> 00:15:00,950
.أهذه حرب؟ أحبّني بلطف

222
00:15:00,950 --> 00:15:03,040
.سئمت من إخبار النّاس لي أن أكون ألطف

223
00:15:03,040 --> 00:15:06,820
،عندما يتعلّق الأمر بحركة المرور
.يفعل الجميع ما يحلو لهم

224
00:15:06,820 --> 00:15:09,220
.لكن "الأمور بخواتمها" ليست كافية عندي

225
00:15:09,220 --> 00:15:13,010
.العنف شأني أيّها المغفّل

226
00:15:14,190 --> 00:15:15,390
ماذا؟

227
00:15:15,390 --> 00:15:19,550
تردّ بـ"ماذا؟" تلك هي إجابتك؟
.لا تجعلني أسخر يا عمّ

228
00:15:19,550 --> 00:15:25,900
إن لم تعتذر، سأمسك بندقيّة
.وأفجّر رأسك. هكذا، وهكذا

229
00:15:25,900 --> 00:15:29,400
سأبعثر دماغك. فصّيه الأيمن والأيسر
.والفصّ الجبهيّ والمخيخ والمخّ

230
00:15:29,400 --> 00:15:34,980
هل تفهمني؟ ما أسعى إليه
.هو اعتذار من القلب

231
00:15:34,980 --> 00:15:37,910
.الخطأ خطؤك لركوبك مزلاجك في الزّحام

232
00:15:37,910 --> 00:15:43,330
اسمع، اسمع. قلت خطئي أنا؟
.هذا رأي الجميع، لكنّني لا أوافقه

233
00:15:43,330 --> 00:15:45,650
.لا وقت لديّ للجدال مع كلّ هاوٍ هنا

234
00:15:45,650 --> 00:15:48,610
.فبيننا أنا وأنت طريق حرير طويلٍ طويل

235
00:15:48,610 --> 00:15:50,590
.مسافة بعيدة بيننا، يا له من عبء ذهنيّ

236
00:15:50,590 --> 00:15:52,130
،سئمت التّعميم

237
00:15:52,130 --> 00:15:54,590
،وإن كنتَ ناضجًا وما إلى ذلك
أين الاعتذار الّذي تدين لي به؟

238
00:15:55,010 --> 00:15:56,190
.آسف

239
00:15:56,190 --> 00:15:59,060
.نعم، هذا صحيح. كلانا فائز الآن

240
00:15:59,060 --> 00:16:03,860
دفء مثل قهوة العملة الواحدة المعلّبة
،الّتي يمكن شراؤها في حشد الهالوين هذا

241
00:16:03,860 --> 00:16:08,720
وبرودة مثل عملات الغسيل التي استعملتُها
.عندما كنت في أسفل الكومة

242
00:16:08,720 --> 00:16:11,070
،أخذ توضيح رأيي وقتًا، لكن اللّيلة

243
00:16:11,070 --> 00:16:13,850
.ما أردت قوله هو من الأفضل لك تصحيح الأمور

244
00:16:13,850 --> 00:16:17,930
.قد يبدو هذا مفاجئًا، لكن ألطف
.أنا آسف يا صديقي

245
00:16:17,930 --> 00:16:21,410
في نهاية اليوم، أريد بعض التّعاطف
.فحسب، فلا تخجل. أجل

246
00:16:25,350 --> 00:16:28,400
.يفقد النّاس رشدهم في الهالوين

247
00:16:32,330 --> 00:16:34,000
هل حفظت الأغنية؟

248
00:16:34,000 --> 00:16:36,180
ليس بعد. كم بقي لدينا من وقت؟

249
00:16:36,180 --> 00:16:38,900
.حسنًا. مفهوم

250
00:16:39,650 --> 00:16:41,860
.سأتّجه إلى هناك بمجرّد انتهاء الحدث

251
00:16:42,370 --> 00:16:44,890
.نعم. مع السّلامة

252
00:16:44,890 --> 00:16:46,560
من كان هذا؟ يانو؟

253
00:16:47,920 --> 00:16:49,170
.نعم، هذا صحيح

254
00:16:49,750 --> 00:16:52,130
هل ما زال علينا الظّهور في احتفاليّات كهذه؟

255
00:16:52,130 --> 00:16:54,690
ألا يمكننا إقامة عرضنا الخاصّ؟

256
00:16:54,690 --> 00:16:57,140
.كوني صبورة قليلاً بعد يا نيكايدو

257
00:16:57,140 --> 00:17:00,390
بحلول عيد الميلاد المجيد، ستكونين
.قد تجاوزت كلّ الحاضرين هنا اليوم

258
00:17:00,390 --> 00:17:01,490
.المعذرة

259
00:17:03,020 --> 00:17:04,000
ما الخطب؟

260
00:17:05,390 --> 00:17:07,890
.أودّ التوّقّف

261
00:17:07,890 --> 00:17:08,880
عمّاذا؟

262
00:17:09,610 --> 00:17:10,800
.ألاعيب الخداع هذه

263
00:17:11,100 --> 00:17:12,880
ماذا بإمكانك فعله إذًا؟

264
00:17:12,880 --> 00:17:14,840
كيف ستجنين المال للوكالة؟

265
00:17:14,840 --> 00:17:16,130
.مهلاً يا نيكايدو

266
00:17:16,570 --> 00:17:19,080
.حسنًا. سنتحدّث لاحقًا يا إيتشيمورا

267
00:17:27,440 --> 00:17:28,710
.شكرًا على الانتظار

268
00:17:29,970 --> 00:17:33,890
مهلاً لحظة. كيف عرفت أنّه أنا؟

269
00:17:33,890 --> 00:17:37,710
سبق وأخبرتك، أنا جيّد في العثور
.على النّاس في الحشود

270
00:17:38,210 --> 00:17:39,470
أكانت بُنيتي؟

271
00:17:39,470 --> 00:17:41,730
أم أنّني لا أندمج مع الحشود بما يكفي؟

272
00:17:41,730 --> 00:17:44,950
.لا، أشكّ أنّ أيّ أحد آخر سيتعرّف عليك

273
00:17:44,950 --> 00:17:47,990
على أيّ حال، أنا مندهش
.لأنّك لست خجلاً من ارتداء هذا

274
00:17:47,990 --> 00:17:51,120
.إنّه مهين. لكن لا خيار أمامي

275
00:17:51,120 --> 00:17:54,340
أخبرني، هل وجدت قناع الجمجمة
في طريقك إلى هنا؟

276
00:17:54,950 --> 00:17:56,020
.لا

277
00:17:56,410 --> 00:17:59,280
.ظننتُ أنّك جيّد في إيجاد النّاس في الحشود

278
00:17:59,280 --> 00:18:02,010
.ليس هذا النّوع

279
00:18:02,010 --> 00:18:03,840
ما معنى ذلك؟

280
00:18:03,840 --> 00:18:07,890
.كيف أشرح هذا؟ الأمر صعب

281
00:18:07,890 --> 00:18:09,400
.حليب لو سمحت

282
00:18:09,400 --> 00:18:11,710
.حاضرة. سآتيك به في الحال

283
00:18:12,520 --> 00:18:16,090
،على سبيل المثال
،بمجرّد أن أحفظ وجه تلك النّادلة

284
00:18:16,090 --> 00:18:19,820
بإمكاني العثور عليها بين الحشود
.حتّى إن غيّرت مكياجها

285
00:18:19,820 --> 00:18:21,930
لماذا؟ أيّ نوع من القدرات هي هذه؟

286
00:18:21,930 --> 00:18:23,960
هل يمكنك رؤية هالات النّاس أو ما شابه؟

287
00:18:24,390 --> 00:18:26,380
.ربّما الأمر قريب من ذلك

288
00:18:26,380 --> 00:18:30,780
لكن إذا لم أرَ وجه شخص ما من قبل
،وكان يرتدي قناعًا يغطّي الوجه

289
00:18:30,780 --> 00:18:33,190
.فسأكون كبقيّة النّاس حينها

290
00:18:33,190 --> 00:18:34,570
.لا يمكنني الجزم

291
00:18:34,570 --> 00:18:39,010
بتعبير آخر، بإمكانك العثور على
،كاباساوا تايتشي بين الحشود

292
00:18:39,010 --> 00:18:41,610
على عكس قناع الجمجمة، صحيح؟

293
00:18:41,610 --> 00:18:42,640
.هذا صحيح

294
00:18:44,330 --> 00:18:45,310
.انظر

295
00:18:49,190 --> 00:18:53,370
.سنبدأ بالتّحقّق من أيّ بلاغ قد يبدو أنّ له مصداقيّة

296
00:18:53,370 --> 00:18:56,970
،كاباساوا هنا في شيبويا أيضًا
.لذا قد نمسك بهما معًا

297
00:19:11,350 --> 00:19:14,750
لا أصدّق أنّ علينا القيام بدوريّات
.من أجل هؤلاء الحمقى ثانية هذا العام

298
00:19:14,750 --> 00:19:18,090
ما الممتع في هذا؟
.يجعل الجميع أنفسهم محطّ سخرية

299
00:19:18,690 --> 00:19:22,180
،حصل كلّ هؤلاء على أزيائهم منذ مدّة
،ثمّ قاموا بتجهيز مكياجهم في المنزل

300
00:19:22,180 --> 00:19:24,470
واستقلّوا القطار كلّ هذه المسافة
من الأرياف، صحيح؟

301
00:19:24,470 --> 00:19:28,150
عند خلع أزياءهم ومكياجهم بعد العودة
.للمنزل، أتساءل إن كانوا يتمنّون الموت

302
00:19:28,150 --> 00:19:29,550
صحيح يا أخي؟

303
00:19:31,250 --> 00:19:34,080
.إنّ أخاك يعمل مع دوبو

304
00:19:37,640 --> 00:19:38,620
.صحيح

305
00:19:42,570 --> 00:19:45,320
.حسب المعلومات الأخيرة، فإنّه في هذه الأرجاء

306
00:19:45,320 --> 00:19:48,590
،حتّى أنّهم نشروا صورًا
.لذلك للتّغريدة بعض المصداقيّة

307
00:19:48,950 --> 00:19:49,750
ماذا؟

308
00:19:54,280 --> 00:19:58,410
.لا أصدّق أنّنا وجدناه بسهولة
.الإنترنت مذهل

309
00:19:58,410 --> 00:20:02,360
،بما أنّ قناع الجمجمة يستهدفك
.ابتعد قليلاً عنّي

310
00:20:02,360 --> 00:20:03,430
ما الّذي ستفعله؟

311
00:20:03,430 --> 00:20:04,390
،سأتبعك

312
00:20:04,390 --> 00:20:06,600
،وعندما تسنح لي الفرصة
.سأجرّه غلى ممرّ خالٍ

313
00:20:06,600 --> 00:20:07,840
لديه مسدّس، صحيح؟

314
00:20:07,840 --> 00:20:09,970
.من الأفضل أن يكون معه

315
00:20:21,870 --> 00:20:25,650
.كم أنّ نغمة رنّتي مثابرة ومطوّلة

316
00:20:25,650 --> 00:20:28,980
.لديّ الكثير ممّا يشغلني الآن. فاستسلمي

317
00:20:28,980 --> 00:20:33,300
إدمان. أتمنّى لو أستطيع أخذ دوائي
والخلود للنّوم، لكن حاوية سفينة؟

318
00:20:33,300 --> 00:20:36,340
.صمتًا رجاءً. لن أقوم بهذا ثانية
.أعد أنّني لن أقوم بهذا ثانية

319
00:20:36,340 --> 00:20:38,820
ألم يحن الوقت بعد لأتعرّف على اسمك؟

320
00:20:39,470 --> 00:20:41,100
من المتّصل؟

321
00:20:41,100 --> 00:20:44,290
.صحيح، أنت المدير المعروف بياماموتو

322
00:20:44,290 --> 00:20:48,560
.إنّك تتّصل متأخّرًا
،واثق أنّك مشغول كثيرًا

323
00:20:48,560 --> 00:20:51,840
.لكنّ الوقت مال. هذا ما تخبرني به دائمًا

324
00:20:51,840 --> 00:20:54,190
.إن لم تحضر إلى هنا قريبًا، سيحدث ذلك ثانية

325
00:20:54,190 --> 00:20:56,900
قابلني عند المستودع الّذي زرناه
.ذلك اليوم. أراك حينها

326
00:21:00,370 --> 00:21:03,070
.هذا مسدّسي. أعده

327
00:21:03,350 --> 00:21:04,780
من تكون يا هذا؟

328
00:21:04,780 --> 00:21:06,830
دوبو. أنت تعرف من أنا؟

329
00:21:06,830 --> 00:21:09,330
دوبو؟ أنت هو بالفعل؟

330
00:21:09,330 --> 00:21:13,650
هل تعلم؟ سيمنح كاباساوا-ساما
.مليون ينّ لأيّ أحد يمسك بك

331
00:21:13,650 --> 00:21:15,130
.هنالك مكافأة على رأسك

332
00:21:15,130 --> 00:21:17,000
أتعمل مع كاباساوا؟

333
00:21:17,000 --> 00:21:19,250
.تراجع، وإلّا أطلقت

334
00:21:26,590 --> 00:21:28,280
.إنّه مزيّف

335
00:21:28,280 --> 00:21:30,390
اسمع، أين المسدّس الحقيقيّ؟

336
00:21:31,280 --> 00:21:32,600
.لا أدري

337
00:21:32,600 --> 00:21:35,230
!هذا ليس كافيًا. سأقتلك

338
00:21:35,230 --> 00:21:37,100
أنت من أطلق النّار في نادي الكاباري، صحيح؟

339
00:21:37,100 --> 00:21:40,980
.ألم يكن ذلك أنت؟ هذا مجرّد كوسبلاي

340
00:21:40,980 --> 00:21:43,280
.سامحني رجاءً

341
00:21:41,430 --> 00:21:44,220
.لا تعبث معي

342
00:21:43,280 --> 00:21:45,220
!أنا لا أعرف حقًّا

343
00:21:45,730 --> 00:21:48,730
أنت؟ أين هو؟

344
00:21:48,730 --> 00:21:50,000
أين هو؟

345
00:21:50,000 --> 00:21:51,380
.يا دوبو. على يسارك

346
00:21:51,380 --> 00:21:52,250
.إنّه كاباساوا

347
00:21:52,250 --> 00:21:53,290
!ذلك الوغد

348
00:22:03,130 --> 00:22:04,260
.لا فائدة

349
00:22:05,140 --> 00:22:08,480
.مذهل. هذا مستحيل

350
00:22:11,930 --> 00:22:13,900
.مساء الخير يا يانو-سان

351
00:22:13,900 --> 00:22:16,180
.مساء الخير يا سيّد سِكيغوتشي

352
00:22:16,180 --> 00:22:18,480
.تبدو تلك البذلة الرّياضيّة جيّدة عليك

353
00:22:18,480 --> 00:22:21,040
.يبدو لي أكثر فأكثر أنّ الأمر سيتحقّق

354
00:22:21,040 --> 00:22:24,500
.حسب الأصوليّة، سأتمّ الأمر حتّى النّهاية

355
00:22:24,500 --> 00:22:27,320
إنّ عنف الوضع الحاليّ مجرّد
.عيّنة مسبقة فحسب

356
00:22:27,320 --> 00:22:29,880
.حان الوقت للمرحلة التّالية. لنواصل التّقدّم

357
00:22:29,880 --> 00:22:33,180
كيف تسير الأمور يا كاكيهانا إيجي؟

358
00:23:34,970 --> 00:23:50,610
الحلقة القادمة
بوركت

359
00:23:35,770 --> 00:23:38,170
هل بحثك عن العمل يسير جيّدًا؟

360
00:23:38,170 --> 00:23:40,000
.أعاني مشاكل في تحديد ماذا أفعل

361
00:23:40,000 --> 00:23:42,480
أجهل كيف أشعر حيال العمل
.لصالح شخص آخر

362
00:23:42,480 --> 00:23:45,770
.لا يمكنني نسيان الابتهاج الّذي شعرت به حينها

363
00:23:45,770 --> 00:23:48,650
.سمحت للتّيّار بجرفك بالفعل