1
00:01:35,010 --> 00:01:36,640
.لا بدّ أنّك تمزح

2
00:01:36,640 --> 00:01:38,700
تبادلت أرقام الهاتف مع شيراكاوا-سان؟

3
00:01:38,700 --> 00:01:41,700
.نعم. صادف أن سارت المحادثة في ذلك الاتّجاه

4
00:01:41,700 --> 00:01:43,790
.تبًّا، كنت لألعنك حتّى الموت لو استطعت

5
00:01:43,790 --> 00:01:45,410
.اقتلني بنفسك

6
00:01:45,410 --> 00:01:46,820
لماذا لا تكون مباشرًا حيال ذلك؟

7
00:01:46,820 --> 00:01:50,040
أعلم. أراهن أنّها تريد طريقة أسهل
.للحصول على سيّارة أجرة

8
00:01:50,040 --> 00:01:51,710
—لتتفادى سعر الاستدعاء وما

9
00:01:51,710 --> 00:01:55,130
بل قالت أنّها تريد لقائي على الغداء
.أو العشاء في أيام إجازتها

10
00:01:55,130 --> 00:01:55,920
.كاذب

11
00:01:58,880 --> 00:02:02,060
.كان عرضنا الفرديّ ناجحًا للغاية

12
00:02:02,060 --> 00:02:03,790
.بيعت التّذاكر بالكامل

13
00:02:03,790 --> 00:02:05,500
.أريد الاستقالة عن عملي بالدّوام الجزئيّ من الآن

14
00:02:05,500 --> 00:02:06,780
.سبق واستقلتُ من عملي

15
00:02:06,780 --> 00:02:09,470
ماذا؟ مع أنّك لم تكتب أيّة نكات؟

16
00:02:09,470 --> 00:02:11,680
.إنّ حبيبتي تعتني بي

17
00:02:11,680 --> 00:02:12,820
.يا لك من حثالة

18
00:02:12,820 --> 00:02:14,860
.قالت حبيبتي أنّ بإمكاني الاستقالة

19
00:02:14,860 --> 00:02:17,280
،تشكّلت بونّو إلومينيشن قبل أربع سنوات

20
00:02:17,280 --> 00:02:19,430
.وهم يعيشون في مكان إجاره 400,000

21
00:02:19,430 --> 00:02:20,870
ألا يثير ذلك غيظك؟

22
00:02:20,870 --> 00:02:23,570
.حسنًا، هكذا هو الحال

23
00:02:24,070 --> 00:02:26,110
لماذا لم نحصد أيّ نجاح على التّلفاز؟

24
00:02:27,270 --> 00:02:29,800
.بحثت عن نفسي في الإنترنت قبل أيّام

25
00:02:29,800 --> 00:02:30,880
.لا تفعل ذلك

26
00:02:30,880 --> 00:02:32,940
"بحثت عن "هوموسابين مضحكان
وكلّ ما حصلت عليه

27
00:02:32,940 --> 00:02:34,650
."كان أمواجًا من "هوموسابين ليسا مضحكين

28
00:02:34,650 --> 00:02:36,420
.يجدر بك ألّا تبحث عن نفسك على الإنترنت بالفعل

29
00:02:36,420 --> 00:02:39,650
.تتطلّب الكوميديا ذكاء وثقافة ليفهمها المرء

30
00:02:39,650 --> 00:02:41,340
.ذلك هو الحدّ الأدنى

31
00:02:41,340 --> 00:02:43,130
.بتعبير آخر، عامّة النّاس أغبياء

32
00:02:43,130 --> 00:02:44,270
.ها قد بدأنا ثانية

33
00:02:44,270 --> 00:02:46,220
.لكنّ ذلك لا يوقفهم عن الحكم علينا

34
00:02:46,220 --> 00:02:47,350
.أغلقوا أفواهكم يا أغبياء

35
00:02:47,350 --> 00:02:50,140
هل تستمعون؟ كون المرء مبدعًا
.طريق لا رجعة منه

36
00:02:50,140 --> 00:02:51,720
.لا تحاولوا التّدخّل

37
00:02:51,720 --> 00:02:54,680
إنّ قمع إبداعكم الخاصّ نزولاً لرغبة قيم المجتمع

38
00:02:54,680 --> 00:02:57,080
.يؤدّي بكم إلى نتائج متواضعة
.هواة ملاعين

39
00:02:57,080 --> 00:02:59,740
لكن أليست الاستجابة لاحتياجات
المستهلك جزءًا من عملينا؟

40
00:02:59,740 --> 00:03:02,190
.إنّنا لا نصنع أجهزة منزليّة هنا

41
00:03:02,190 --> 00:03:05,650
يجب أن تكون لآرائنا الأولويّة عندما
.نسعى خلف حساسيّات النّاس

42
00:03:05,650 --> 00:03:09,480
الأمر منوط لنا أن نقرّر إن لم يكن الأمر
.صائبًا وإن كان علينا المحاولة ثانية

43
00:03:09,480 --> 00:03:11,320
.حسنًا، تلقّينا بعض رسائل المعجبين

44
00:03:11,320 --> 00:03:13,920
هذه من تلميذ ثانويّة في طوكيو
.يُدعى ناغاشيما ساتوشي-كُن

45
00:03:13,920 --> 00:03:15,050
هذا الفتى ثانية؟

46
00:03:15,050 --> 00:03:16,130
".مساء الخير"

47
00:03:16,130 --> 00:03:18,410
".ذهبت لحضور عرض هوموسابين الفرديّ"

48
00:03:18,410 --> 00:03:21,010
،في العادة، يحضر المعجبون العروض الفرديّة"

49
00:03:21,010 --> 00:03:23,350
".لذلك من الطّبيعيّ أن يضحك جمهوركما

50
00:03:23,350 --> 00:03:28,560
وأيضًا، أجد أنّه من الجيّد أنّكما تثقان"
".بقيمتكما الخاصّة وأنّ لديكما قناعة

51
00:03:28,560 --> 00:03:31,160
ولكن كمحترفين، أعتقد أنّه من المحرج لكما"

52
00:03:31,160 --> 00:03:36,100
أن تعتبرا النّاس الّذين لا يقرّون
".بموهبتكما هواة غير مثقّفين

53
00:03:36,100 --> 00:03:38,040
يمكنكما وصف نفسيكما بالمؤدّين فقط"

54
00:03:38,040 --> 00:03:42,760
إن اعترفتما بوجهات النّظر الأخرى
".وثبتّما على عزيمتكما وحقّقتما النّجاح

55
00:03:42,760 --> 00:03:45,510
".لا تخلطا بين الثّقة المفرطة والإيمان بالنّفس"

56
00:03:45,510 --> 00:03:50,010
،وأيضًا، مقارنة ببونّو إلومينيشن"
".فأنتما أقلّ جاذبيّة بكثير

57
00:03:50,010 --> 00:03:52,520
،ملاحظة: استطعتما التّدارك بفضل حيويّتكما"

58
00:03:52,520 --> 00:03:56,190
لكنّ النّكتة الأخيرة في عرضكما الفرديّ
".ليست مضحكة عندما تكون مكتوبة

59
00:03:56,190 --> 00:03:57,200
".حظًّا موفّقًا"

60
00:03:57,200 --> 00:03:58,540
.ليستدع أحدٌ ذاك الوغد إلى هنا

61
00:03:58,540 --> 00:04:00,210
أتشعر بإحراج ما؟

62
00:04:00,210 --> 00:04:01,010
ماذا؟

63
00:04:02,770 --> 00:04:05,610
.ما كنت لأصفه بالإحراج

64
00:04:05,610 --> 00:04:08,510
.أستمع للبرنامج كلّ أسبوع
.أشغّله من باب العادة

65
00:04:09,140 --> 00:04:12,140
أخبرني يا أودوكاوا-سان، لماذا لا تستطيع النّوم؟

66
00:04:13,440 --> 00:04:18,020
.نسيت كيف أنام
.لا أذكر كيف كنت أفعل ذلك

67
00:04:18,860 --> 00:04:20,900
أتريد معرفة سرّ ما؟

68
00:04:25,240 --> 00:04:26,390
.عُدّ الخراف

69
00:04:26,390 --> 00:04:30,490
تجعلين الأمر يبدو وكأنّه من إبداعك
.مع أنّها خدعة قديمة قدم الزّمن

70
00:04:31,380 --> 00:04:33,970
.وأيضًا، أظنّ أنّها سيندي لوبر

71
00:04:33,970 --> 00:04:34,930
ماذا؟

72
00:04:35,800 --> 00:04:36,540
.الأفضل

73
00:04:36,540 --> 00:04:38,170
"شاهدتِ "نحن العالم؟

74
00:04:44,180 --> 00:04:46,250
أودوكاوا-سان، أهنالك شخص تحبّه؟

75
00:04:46,250 --> 00:04:47,370
.لا

76
00:04:47,370 --> 00:04:48,510
.يا للخسارة

77
00:04:48,510 --> 00:04:50,570
.الحياة ممتعة أكثر وأنت مغرم

78
00:04:50,570 --> 00:04:52,380
.أنا كبير جدًّا على ذلك

79
00:04:52,380 --> 00:04:55,130
.ما زلت في الواحد والأربعين
.حياتك في مُقتبلها

80
00:04:55,130 --> 00:04:56,730
كيف تعرفين ذلك؟

81
00:04:56,730 --> 00:04:57,790
.قرأت سجلّاتك الطّبّيّة

82
00:04:57,790 --> 00:04:59,620
تعرفين كلّ معلوماتي الخاصّة، صحيح؟

83
00:04:59,620 --> 00:05:00,520
ماذا عن عائلتك؟

84
00:05:00,520 --> 00:05:02,230
.خرجوا من حياتي قبل حتّى أن أدرك

85
00:05:02,230 --> 00:05:02,860
متى؟

86
00:05:02,860 --> 00:05:04,240
.في نهاية المدرسة الابتدائيّة

87
00:05:04,240 --> 00:05:05,720
كيف أعلت نفسك؟

88
00:05:05,720 --> 00:05:07,380
أهذه مقابلة ضغط؟

89
00:05:07,380 --> 00:05:09,920
.أنا آسفة. تجاوزت حدودي

90
00:05:15,080 --> 00:05:17,900
هل هنالك ما تندمين عليه؟

91
00:05:17,900 --> 00:05:21,750
.ربّما أخذ قرض دراسة لارتياد مدرسة التّمريض

92
00:05:21,750 --> 00:05:22,920
لماذا تندمين على ذلك؟

93
00:05:24,090 --> 00:05:27,550
كنتُ عنيدة حينها ولم أكن
،أريد الاعتماد على والديّ

94
00:05:27,550 --> 00:05:29,720
.لكن أشعر أنّه كان عليّ ذلك

95
00:05:29,720 --> 00:05:31,860
ألم تسدّديه بعد؟

96
00:05:35,400 --> 00:05:37,460
.بلى، سدّدته

97
00:05:42,890 --> 00:05:44,750
أين وُلدتِ؟

98
00:05:44,750 --> 00:05:45,590
.ميازاكي

99
00:05:45,590 --> 00:05:47,380
.غنّي لي أغنية شعبيّة من ميازاكي

100
00:05:47,380 --> 00:05:54,720
...شجرة الفلفل اليابانيّ في الباحة

101
00:05:48,370 --> 00:05:50,000
بإمكانك غناء إحداها فعلاً؟

102
00:05:51,410 --> 00:05:54,720
.سألتك فقط لأنّني افترضت أنّك لا تستطيعين

103
00:05:54,720 --> 00:05:56,410
.إنّها مخيفة نوعًا ما أيضًا

104
00:05:57,660 --> 00:06:00,050
أريد إنشاء عائلة سعيدة

105
00:06:00,050 --> 00:06:02,770
.لكي لا يقلق عليّ والداي في ميازاكي

106
00:06:03,230 --> 00:06:04,880
...أنت

107
00:06:04,880 --> 00:06:06,670
.شيراكاوا ميهو

108
00:06:07,930 --> 00:06:12,560
شيراكاوا-سان، أهنالك شخص تحبّينه؟

109
00:06:12,560 --> 00:06:13,720
.نعم

110
00:06:19,190 --> 00:06:21,650
هكذا إذًا. كيف يبدو؟

111
00:06:21,650 --> 00:06:26,630
.سألت كيف يبدو؟ من الصّعب وصفه قليلاً

112
00:06:26,630 --> 00:06:28,220
ألديك صورة له؟

113
00:06:28,220 --> 00:06:29,590
نعم. أتريد رؤيتها؟

114
00:06:29,590 --> 00:06:30,780
.نعم، نعم

115
00:06:31,150 --> 00:06:33,500
.سأضايق كاكيهانا بإخباره عن الأمر

116
00:06:45,010 --> 00:06:49,310
.تجاوزت كلّ شيء لتحقّق مظهر الصّفاء التّامّ

117
00:06:49,310 --> 00:06:51,900
.مهلاً لحظة. أنا أرتّب أفكاري الآن

118
00:06:54,760 --> 00:06:57,890
،أكره الاعتراف بهذا يا أودوكاوا
.لكن لديك فرصة

119
00:06:57,890 --> 00:06:59,180
فرصة في ماذا؟

120
00:06:59,180 --> 00:07:02,520
.بالنّظر لحالنا، فكلانا متّجه في طريق عزوبيّة أبديّة

121
00:07:02,520 --> 00:07:05,890
.الظّفر بحسناء مثلها سيكون قلبًا كبيرًا للموازين

122
00:07:05,890 --> 00:07:07,500
.الأمر ليس كذلك

123
00:07:07,500 --> 00:07:08,910
هل تكرهها؟

124
00:07:08,910 --> 00:07:10,490
.أنا لا أكرهها

125
00:07:10,490 --> 00:07:11,810
إذًا هل تحبّها؟

126
00:07:11,810 --> 00:07:13,340
.لا أحبّها على وجه الخصوص أيضًا

127
00:07:13,340 --> 00:07:14,590
إن كان عليك الاختيار بين الكره والحبّ؟

128
00:07:14,590 --> 00:07:17,420
لماذا تجبرني على الإجابة
عن سؤال صعب بشكل جازم؟

129
00:07:17,420 --> 00:07:18,300
هل أنت فرقة ميسو-تشيرو؟

130
00:07:18,300 --> 00:07:20,490
.أسألك إلى أيّ طرف تميل

131
00:07:21,090 --> 00:07:23,250
.حسنًا... أفترض أنّه طرف الحبّ

132
00:07:23,250 --> 00:07:23,910
كم؟

133
00:07:23,910 --> 00:07:24,540
كم ماذا؟

134
00:07:24,540 --> 00:07:26,310
.أسألك كم مقدار حبّك لها

135
00:07:28,430 --> 00:07:29,680
.بقدر المكمّلات الأمريكيّة

136
00:07:29,680 --> 00:07:30,670
.هذا كثير جدًّا

137
00:07:32,680 --> 00:07:34,020
ماذا أفعل؟

138
00:07:34,020 --> 00:07:37,180
.لا يجب أن تكون حذرًا كثيرًا

139
00:07:37,180 --> 00:07:39,300
يُقال أنّ قلب المرأة متقلّب
،تقلّب جوّ الخريف

140
00:07:39,300 --> 00:07:41,800
.وأنّ عليك ضرب الحديد وهو ساخن

141
00:07:41,800 --> 00:07:45,750
،لكن إن كنت عنيفًا في تقرّبك
،فستظنّك عجوزًا يائسًا

142
00:07:45,750 --> 00:07:47,630
.لذلك يصعب موازنة الأمر

143
00:07:47,630 --> 00:07:50,920
،إن كنت مكانك، كنت لأناغشها عن طريق تجاهلها

144
00:07:50,920 --> 00:07:53,920
.ثمّ سأبتسم لها بلطف عند رؤيتها في العيادة

145
00:07:52,800 --> 00:07:53,920
.اخرس فحسب

146
00:07:53,920 --> 00:07:54,960
أخرس؟

147
00:07:55,400 --> 00:07:58,610
عندما سألتُ نفسي لِمَ أطلب النّصح
،من شخص ما زال يبحث عن زوجة

148
00:07:58,610 --> 00:08:00,300
.بدأ كلّ كلامك يبدو كضوضاء

149
00:08:00,300 --> 00:08:04,470
لكن بجدّيّة، أراهن أنّ أبويك سيسعدان

150
00:08:04,470 --> 00:08:07,470
.إن تزوّجت قبل أن يعودا

151
00:08:07,470 --> 00:08:09,710
ألا تريدهما أن يقابلا أحفادهما؟

152
00:08:09,710 --> 00:08:14,400
أفضّل أن أري النّاس الّذين تكفّلوا بنفقات عيشي

153
00:08:14,400 --> 00:08:17,180
.بعد مغادرة والديّ أنّني سعيد

154
00:08:17,180 --> 00:08:19,910
تقصد مجموعة الدّعم تلك؟

155
00:08:24,440 --> 00:08:27,710
.لا تدخل حوض الاستحمام في العادة يا أودوكاوا

156
00:08:27,710 --> 00:08:29,730
أتريد المرور على محلّ تايكو؟

157
00:08:29,730 --> 00:08:32,700
.لا، أنا أعمل اللّيلة

158
00:08:36,820 --> 00:08:39,280
.تمهّل، لا تلتقط صورًا في غرفة تغيير الملابس

159
00:08:39,280 --> 00:08:41,660
.من يهتمّ؟ لا أحد غيرنا هنا

160
00:08:41,660 --> 00:08:45,860
قالت تايكو أنّها لم تر وجهك
.منذ مدّة. إنّها تفتقدك

161
00:08:46,560 --> 00:08:50,060
.لا يهمّ إن لم يكن أحد هنا
.مكتوبٌ أنّه ممنوع

162
00:09:07,370 --> 00:09:09,370
هل تستمع لي يا كاكيهانا؟

163
00:09:40,860 --> 00:09:44,020
.كيف يفترض بي تحقيق الباز هكذا؟ اللّعنة

164
00:09:44,020 --> 00:09:46,540
!تايتشي، اذهب للاستحمام

165
00:09:46,540 --> 00:09:47,600
!حاضر

166
00:09:55,860 --> 00:09:59,200
‫140,000 إعادة تغريدة...

167
00:10:46,910 --> 00:10:49,580
.إيماي-سان، انتظرت في الصّفّ من أجلي ثانية

168
00:10:49,580 --> 00:10:50,780
.بالطّبع فعلت

169
00:10:50,780 --> 00:10:53,040
.كنتُ أنتظر انطلاقتك الفنّيّة منذ زمن يا روي-تان

170
00:10:53,040 --> 00:10:54,450
.أنا جاهز لالتقاط الصّورة

171
00:10:55,290 --> 00:10:56,760
أيّ وضعيّة نقوم بها؟

172
00:10:58,070 --> 00:11:00,480
.لديّ سلفًا صور لنا نشكّل قلبًا ونلمس ذراعينا

173
00:11:00,480 --> 00:11:01,730
ماذا نفعل الآن؟

174
00:11:01,730 --> 00:11:05,190
،بما أنّك مميّز للغاية يا إيماي-سان
فما رأيك بعناق؟

175
00:11:05,190 --> 00:11:06,990
ماذا؟ أأنت جادّة؟

176
00:11:11,810 --> 00:11:15,560
،بما أنّك آخر زوّاري اليوم
.سأعطيك توقيعًا لي أيضًا

177
00:11:15,560 --> 00:11:18,510
.شكرًا لك. أعد أن أشتري أغنيتك الأولى

178
00:11:18,510 --> 00:11:21,210
...شكرًا، لكن

179
00:11:21,780 --> 00:11:23,380
.لست واثقة أنّها ستلقى رواجًا

180
00:11:23,990 --> 00:11:25,270
هل الأوضاع سيّئة؟

181
00:11:25,270 --> 00:11:28,010
.حضر أشخاص أقلّ ممّا كنّا نتوقع اليوم أيضًا

182
00:11:28,660 --> 00:11:30,330
.كنت أفكّر حيال ذلك

183
00:11:30,330 --> 00:11:33,250
كلّ من إيتشيمورا-سان وميتسويا-سان
.ستبدوان أفضل بكثير بلا أقنعة

184
00:11:33,250 --> 00:11:35,090
.إنّهما ظريفتين. يا لها من خسارة

185
00:11:35,090 --> 00:11:38,460
كنت أفترض أنّهما ستنزعان
.قناعيهما من أجل الصّور الفوريّة

186
00:11:38,460 --> 00:11:40,450
.لن يأخذ أيّ أحد صورة فوريّة وهما مقنّعتان

187
00:11:40,450 --> 00:11:43,760
قد تكونان ظريفتين، لكنّهما بالطّبع
.ليسا بقدر ظرافتك يا روي-تان

188
00:11:44,440 --> 00:11:48,010
.لكنّ تلك كانت شروط انطلاقتنا

189
00:11:48,710 --> 00:11:52,280
.فهمت. لديهما أسبابهما على ما أظنّ

190
00:11:52,280 --> 00:11:53,560
...وأيضًا

191
00:11:54,920 --> 00:11:57,980
.صار رقص ميتسويا-سان سيّئًا قليلاً

192
00:11:57,980 --> 00:11:59,600
هل هي مريضة أو ما شابه؟

193
00:12:01,650 --> 00:12:05,480
.إنّها تعمل بدوام جزئيّ بينما تدرس وتبثّ من منزلها

194
00:12:05,480 --> 00:12:07,290
.قد تكون متعبة

195
00:12:07,290 --> 00:12:09,160
.يبدو ذلك صعبًا

196
00:12:09,160 --> 00:12:11,160
.لا تضغطي على نفسك كثيرًا يا روي-تان

197
00:12:11,970 --> 00:12:12,750
.تفضّل

198
00:12:13,660 --> 00:12:15,240
.شكرًا لك يا روي-تان

199
00:12:15,240 --> 00:12:18,640
أعد أن أصبح غنيًّا وأشتري الكثير
.من أقراصك وبضاعتك

200
00:12:18,640 --> 00:12:20,520
—أنا مجرّد نادل في نادٍ الآن، لكن

201
00:12:20,520 --> 00:12:22,800
.انتهى الوقت. شكرًا لك

202
00:12:30,220 --> 00:12:34,200
،إيتشيمورا وميتسويا
.لدينا وقت قبل إغلاق المكان

203
00:12:34,200 --> 00:12:37,280
هل بإمكانكما الخروج وبيع ما بقي من بضاعتنا؟

204
00:12:37,280 --> 00:12:39,730
أنت تمزح، صحيح؟ ليس على نيكايدو-سان ذلك؟

205
00:12:39,730 --> 00:12:42,570
ما باليد حيلة. مبيعاتنا ليست
.بنفس جودة مبيعات روي

206
00:12:42,900 --> 00:12:44,930
.لا يهتمّ أحد لنا

207
00:12:44,930 --> 00:12:46,740
.أنا جدّ آسف

208
00:12:49,250 --> 00:12:52,040
.من المحرج للغاية الخروج بهذه الأقنعة

209
00:12:52,040 --> 00:12:54,390
ألا تظنّين أنّ النّجاح مستحيل لنا يا إيتشيمورا-سان؟

210
00:12:54,390 --> 00:12:57,940
تمنعنا هذه الأقنعة من جذب المنفقين
.الكبار مثل نيكايدو-سان

211
00:12:57,940 --> 00:13:00,950
.لن أستطيع جذب المعجبين حتّى إن نزعت قناعي

212
00:13:00,950 --> 00:13:03,770
.لديك احترام ذّات منخفض يا إيتشيمورا-سان

213
00:13:04,390 --> 00:13:07,750
،حسنًا، بدأت مسيرتي بلا قناع
.وها أنا ذي الآن

214
00:13:07,750 --> 00:13:11,260
بل أجد أنّه من غير المعقول
.أنّه ما زال لديك أيّ احترام للذّات

215
00:13:11,260 --> 00:13:15,590
.ربّما السّبب هو أنّ والداي ربّياني بحبّ

216
00:13:15,590 --> 00:13:18,360
.هذا جنونيّ. أنت محقّة. هذا عامل مهمّ

217
00:13:18,360 --> 00:13:23,670
لطالما أخبرني والداي
.أنّه لا يمكنني تحقيق أيّ شيء

218
00:13:23,670 --> 00:13:26,760
ما هي أسعد أوقاتك يا إيتشيمورا-سان؟

219
00:13:26,760 --> 00:13:28,190
.عندما أكون أستحمّ

220
00:13:28,190 --> 00:13:29,700
.بدوتِ كسيّدة عجوز

221
00:13:29,700 --> 00:13:31,010
ماذا عنك يا ميتسويا-سان؟

222
00:13:31,010 --> 00:13:33,130
.عندما آكل. خاصّة إن كان دجاجًا مقليًّا

223
00:13:33,130 --> 00:13:35,120
.هذا جنونيّ. في ذلك الكثير من السّعرات

224
00:13:35,120 --> 00:13:37,380
.مصطلحاتك سيّئة بشكل مجنون

225
00:13:37,380 --> 00:13:40,790
ماذا؟ أنت مجنونة. يا لها من طريقة
.مجنونة للحديث مع زميلة أكبر

226
00:13:42,570 --> 00:13:45,800
.فاق هذا توقّعاتنا. أحسنت عملاً يا نيكايدو

227
00:13:45,800 --> 00:13:48,300
.حتّى الأخبار على الإنترنت تتداولك

228
00:13:48,300 --> 00:13:49,960
.هذا غير كافٍ

229
00:13:49,960 --> 00:13:52,480
نحن أقلّ نجاحًا ممّا يجب أن نكون
.نظرًا للحملة الإعلانيّة الّتي وضعنا

230
00:13:52,480 --> 00:13:55,780
.نحتاج لمعجبين أكثر مثل إيماي-سان

231
00:13:55,780 --> 00:14:00,200
كان ذلك المدعوّ إيماي أحد أولئك الخمسة، صحيح؟

232
00:14:07,680 --> 00:14:12,960
نعم. على الأرجح أنّه الوحيد
.الّذي ظلّ يتابعنا مذّاك الوقت

233
00:14:16,440 --> 00:14:17,900
.إنّه ذاك الشخص

234
00:14:19,330 --> 00:14:22,770
.مرحبًا، معك ياماموتو. نعم

235
00:14:22,770 --> 00:14:25,960
.نعم، مرّ الأمر بسلاسة. نعم

236
00:14:25,960 --> 00:14:28,230
.النّصف، صحيح؟ بالطّبع

237
00:14:28,770 --> 00:14:32,110
ماذا؟ كاميرا سيّارة؟

238
00:14:32,110 --> 00:14:34,100
.سأبحث عنه

239
00:14:34,100 --> 00:14:35,790
هل تعرفون اسم السّائق؟

240
00:14:36,840 --> 00:14:38,560
لستُ واثقًا ممّا بوسعي فعله
.إن لم تعرفوه

241
00:14:39,420 --> 00:14:42,990
.معك حقّ. مفهوم

242
00:14:44,090 --> 00:14:45,480
ماذا قال؟

243
00:14:45,480 --> 00:14:49,110
.لا بأس. لا شيء يدعوك للقلق يا نيكايدو

244
00:15:07,690 --> 00:15:10,080
المعذرة، لكن هل يمكنك أخذي
إلى شينجوكو بـ2,000 ينّ؟

245
00:15:10,080 --> 00:15:13,030
أجرة التّوصيل من هنا
.إلى شينجوكو حوالي 3,500 ينّ

246
00:15:13,030 --> 00:15:14,710
هل بإمكانك القيام باستثناء؟

247
00:15:15,350 --> 00:15:18,140
.حسنًا، سأذهب إلى أقرب ما يمكنني

248
00:15:18,140 --> 00:15:19,940
!كلّا، خذني إلى شينجوكو رجاءً

249
00:15:19,940 --> 00:15:22,810
.أسلوبك في المساومة مُلِحّ لدرجة مريبة

250
00:15:22,810 --> 00:15:25,920
.أرجوك. أنا مفلس

251
00:15:25,920 --> 00:15:27,620
.ما باليد حيلة إذًا

252
00:15:35,830 --> 00:15:38,240
.سُحقًا. كلّها خاسرة

253
00:15:38,240 --> 00:15:41,960
،إن كان لديك مال لشراء هذه
.فعليك حفظ بعضه لسيّارة الأجرة

254
00:15:41,960 --> 00:15:43,400
.الأمر ليس كذلك

255
00:15:43,400 --> 00:15:46,170
.سأستعمل المال لشراء أقراص ميستري كيس

256
00:15:46,170 --> 00:15:47,200
ميستري كيس؟

257
00:15:47,200 --> 00:15:48,550
ألا تعرفهنّ؟

258
00:15:48,550 --> 00:15:50,800
إنّها مجموعة من ثلاثة فنّانات
.حظين بانطلاقتهنّ حديثًا

259
00:15:50,800 --> 00:15:53,000
.لقد حظين بها أخيرًا بعد معاناة لسنتين

260
00:15:53,000 --> 00:15:54,230
.تلك ليست معاناة لفترة طويلة

261
00:15:54,230 --> 00:15:58,470
بالتّفكير للوراء، فقد قابلتهنّ قبل سنة
.في حفلة موسيقيّة كنت أحضرها

262
00:15:58,840 --> 00:16:01,770
حينها، كان الجمهور يتكوّن من خمسة
.أشخاص فقط، بمن فيهم أنا

263
00:16:01,770 --> 00:16:04,850
.لكن اليوم، أتى العديد من المعجبين ليروهنّ

264
00:16:04,850 --> 00:16:08,320
.أشعر بالسّعادة، لكن بالحزن أيضًا
.مشاعري متضاربة

265
00:16:08,320 --> 00:16:12,820
لكنّ معرفتهنّ منذ وقت طويل
.تعطيني حسًّا بالتّفوّق نوعًا ما

266
00:16:12,820 --> 00:16:15,620
.كنت أحد أولئك الخمسة

267
00:16:15,620 --> 00:16:18,120
.لن أنسى كيف شعرتُ حينها أبدًا

268
00:16:18,120 --> 00:16:20,250
.هالة نيكايدو روي الطّاغية

269
00:16:20,250 --> 00:16:22,810
.ذكّرني غناؤها بجانيس جوبلين

270
00:16:22,810 --> 00:16:26,170
ميزات الفنّانة الغريزيّة عندها
.تباينت مع الطّموح الّذي نبع منها

271
00:16:26,170 --> 00:16:30,260
وقدرات ميتسويا يوكي الجسديّة الاستثنائيّة
.المدعومة برقصها المتفوّق

272
00:16:30,260 --> 00:16:33,250
.إضافة لميزان إيتشيمورا شيهو المتواضع

273
00:16:33,970 --> 00:16:35,890
.لكلّ فنّانة منهنّ شخصيّة مميّزة

274
00:16:35,890 --> 00:16:38,070
.لقد كنّ ثلاثيّ الفنّانات المقدّس

275
00:16:38,070 --> 00:16:40,250
،لديك الكثير لتقوله حيالهنّ

276
00:16:40,250 --> 00:16:42,520
لكنّ شخصيّاتهنّ أمست أقلّ إثارة
.للإعجاب كلّما واصلت الحديث

277
00:16:42,520 --> 00:16:45,410
.هذا لأنّني معجب بنيكايدو أكثر

278
00:16:45,410 --> 00:16:47,870
.حتّى أنّني أنشأت حسابًا لمعجبي نيكايدو

279
00:16:47,870 --> 00:16:48,720
فعلاً؟

280
00:16:48,720 --> 00:16:52,830
على أيّ حال، أقيم اليوم حدث
.الطّلب المسبق لقرصهنّ الأوّل

281
00:16:52,830 --> 00:16:54,990
.يحصل كلّ طلب مسبق على تذكرة صورة فوريّة

282
00:16:54,990 --> 00:16:57,950
.كلّما طلبت أكثر، ستحصل على صور فوريّة أكثر

283
00:16:57,950 --> 00:16:59,940
.بإمكانك الحصول على نيكايدو روي لنفسك فقط

284
00:16:59,940 --> 00:17:03,910
إن افترضنا أنّك محقّ، إن حصلت على مال
.اليانصيب، فاصرفه على الأقراص بدل ذلك

285
00:17:03,910 --> 00:17:07,580
.عمّ تتحدّث؟ كلّ ما يمكنني دفع ثمنه هو قرص واحد

286
00:17:07,580 --> 00:17:11,590
أفضّل الفوز باليانصيب
.وجعل نيكايدو روي لي بالكامل

287
00:17:11,590 --> 00:17:13,610
.إنّك تراهن على احتمالات ضعيفة

288
00:17:13,610 --> 00:17:15,970
هل أنت محظوظ أيّها السّائق؟

289
00:17:15,970 --> 00:17:18,610
فتعبير الإشارة للمحظوظين يتضمّن ذكر السائق، أليس كذلك؟

290
00:17:18,610 --> 00:17:19,900
.أراهن أنّك محظوظ

291
00:17:21,220 --> 00:17:25,510
قبل بضعة سنوات، نجوت من حادثة
.كان يجب أن تودي بحياتي

292
00:17:25,510 --> 00:17:26,980
.لذلك ربّما أكون محظوظًا

293
00:17:30,600 --> 00:17:33,180
.إن كنتَ محظوظًا، ما كانت لتقع لك حادثة

294
00:17:33,180 --> 00:17:34,900
.أظنّك على حقّ

295
00:17:34,900 --> 00:17:36,790
وصلنا شينجوكو. هل أنزلك هنا؟

296
00:17:36,790 --> 00:17:38,780
.أكيد! آسف لأنّ كلّ ما لديّ هي 2000 ينّ

297
00:17:39,870 --> 00:17:41,600
،بما أنّك سائق محظوظ

298
00:17:41,600 --> 00:17:44,660
هل أستطيع الحصول على سبعة
من أرقامك المفضّلة بين 1 و37؟

299
00:17:53,040 --> 00:17:58,720
.33 ،32 ،20 ،18 ،12 ،10 ،2

300
00:17:58,720 --> 00:18:00,910
.نعم، يبدو هذا جيّدًا

301
00:18:00,910 --> 00:18:02,060
.سأذهب لشراء ورقة يانصيب

302
00:18:02,060 --> 00:18:03,850
ما زال لديك مال إذًا؟

303
00:18:06,080 --> 00:18:07,240
.يا إلهي

304
00:18:21,690 --> 00:18:23,170
آسف، هل أنت شاغر؟

305
00:18:26,590 --> 00:18:28,330
.آسف لمقاطعة استراحتك

306
00:18:28,330 --> 00:18:29,500
.لكن خذنا لإذاعة اليابان رجاءً

307
00:18:39,940 --> 00:18:41,110
ما الّذي تشاهده؟

308
00:18:41,110 --> 00:18:43,620
فكّرت في أنّني قد أجد شيئًا
.بإمكاننا استعماله في البثّ

309
00:18:43,620 --> 00:18:45,240
.أنت تدرس بجدّ

310
00:18:45,240 --> 00:18:47,430
انظر. ألا يغضبك هذا ببساطة؟

311
00:18:51,160 --> 00:18:53,900
.أوافقك. أفضّل الاستماع للأغنية الأصليّة

312
00:18:53,900 --> 00:18:55,840
.لكنّ بعضها قد يكون مؤثّرًا

313
00:18:56,860 --> 00:18:59,910
عـ-عمّ تتحدّث؟ بعضها مؤثّر؟

314
00:18:59,910 --> 00:19:01,030
.أنت بطيء

315
00:19:01,460 --> 00:19:02,790
وما الّذي تفعله أنت؟

316
00:19:02,790 --> 00:19:04,160
."ماذا؟ "زودن

317
00:19:04,470 --> 00:19:05,700
زودن"؟"

318
00:19:05,700 --> 00:19:06,940
.إنّها لعبة هاتف

319
00:19:12,910 --> 00:19:14,420
ألا تعرف أنّك شخصيّة مشهورة؟

320
00:19:14,420 --> 00:19:16,560
.أستطيع اللّعب مع معجبينا هكذا
فما الخطب في ذلك؟

321
00:19:16,560 --> 00:19:18,280
.استعمل ذلك الوقت لكتابة النّكات

322
00:19:18,280 --> 00:19:20,000
.إنّها تدعو للإدمان

323
00:19:20,000 --> 00:19:22,930
.أربّي حيوانات فيها وما شابه للتّقدّم في المستوى

324
00:19:22,930 --> 00:19:26,290
.هنالك من ربّاك فحسب
فكيف لك أن تعرف كيف تربّي؟

325
00:19:28,520 --> 00:19:30,210
تظنّ أنّني في آخر ترتيب الكوميديا؟

326
00:19:30,210 --> 00:19:31,590
.ليس ضمن المحترفين فحسب

327
00:19:31,590 --> 00:19:33,900
.بل بين كلّ النّاس. فلا تسئ فهم الأمر

328
00:19:33,900 --> 00:19:36,480
أنا في نهاية ترتيب الكوميديا بين كلّ النّاس؟

329
00:19:36,810 --> 00:19:39,660
أخبرني، كيف هي أحوالك مع حبيبتك؟

330
00:19:39,660 --> 00:19:41,490
.لا يمكنني الحديث عن ذلك هنا

331
00:19:41,490 --> 00:19:43,950
.لا داعي للخجل هكذا

332
00:19:43,950 --> 00:19:46,580
إن من يعرفوننا قلائل بقلّة معدّل
.فائدة حساب وديعة ثابت

333
00:19:46,580 --> 00:19:49,940
حسنًا، لحبيبتي فرصة لبلوغ نسبة الكاكاو

334
00:19:49,940 --> 00:19:51,810
.في لوح شوكولاتة مرّ جدًّا

335
00:19:51,810 --> 00:19:53,160
أتقول أنّنا لسنا كذلك؟

336
00:19:53,160 --> 00:19:55,550
أنا أعرفكما. أنتما "هوموسابين"، صحيح؟

337
00:19:55,550 --> 00:19:57,130
.أستمع لكما على المذياع دائمًا

338
00:19:57,130 --> 00:19:58,230
فعلاً؟

339
00:19:58,230 --> 00:20:00,960
،لم أكن أعرف كيف تبدوان
.لكنّني تعرّفت على صوتيكما

340
00:20:00,960 --> 00:20:02,310
.تلك هي المشكلة

341
00:20:02,310 --> 00:20:04,610
أيّها السّائق، ما الّذي نحتاجه في رأيك لننجح؟

342
00:20:04,610 --> 00:20:06,720
لا أدري. ربّما الحظّ؟

343
00:20:06,720 --> 00:20:08,950
.إن كنّا محظوظين، فما كنّا لنحتاج للعمل بجدّ

344
00:20:08,950 --> 00:20:10,640
.نريد أن نكون أفضل المؤدّين في البلاد

345
00:20:11,650 --> 00:20:14,400
.يبدو لي أنّكما لستما ملتزمين بنفس القدر

346
00:20:15,910 --> 00:20:18,280
بالمناسبة، كيف سارت مرحلة ن-1 التّمهيديّة؟

347
00:20:18,280 --> 00:20:19,720
.وصلنا للجولة الثّانية

348
00:20:19,720 --> 00:20:20,920
.هذا مذهل

349
00:20:21,850 --> 00:20:25,800
اسمع يا بابا. ماذا كنت لتفعل
إن قلتُ أنّ علينا حلّ المجموعة؟

350
00:20:25,800 --> 00:20:27,340
.كنت لأقول أنّ ما باليد حيلة

351
00:20:27,340 --> 00:20:29,830
.أنا لا أفهم الكوميديا حقًّا

352
00:20:29,830 --> 00:20:32,270
،أكره الاعتراف بذلك

353
00:20:32,270 --> 00:20:35,830
لكنّك الوحيد الّذي أظنّه
.مضحكًا من أعماق قلبي

354
00:20:35,830 --> 00:20:39,130
.حتّى أنّ كوميديًّا أكبر قال أنّك موهوب

355
00:20:39,130 --> 00:20:40,540
.وأنّك ستنجح يومًا ما

356
00:20:40,540 --> 00:20:44,130
،لذلك إن كنت أعيق تقدّمك
.فأظنّ أنّ عليّ الانسحاب

357
00:20:45,300 --> 00:20:48,310
.أسأت فهم الأمر
.لا يجب أن تتحدّث بشأن التّوقّف

358
00:20:48,310 --> 00:20:51,680
عيبك القاتل هو أنّك لست محبطًا
.بعد قوله لذلك عنّا

359
00:20:51,680 --> 00:20:54,110
!لا يسعني شيء إن كنت لستُ محبطًا

360
00:20:54,110 --> 00:20:56,260
هل تقول أنّ بإمكانك التّحكّم بعواطفك؟

361
00:20:56,260 --> 00:20:58,760
إن استطاع النّاس فعل ذلك، فسيتوقّف
.كلّ الحبّ غير المتبادل عن الوجود

362
00:20:58,760 --> 00:21:00,540
!كان ذلك مضحكًا في الحقيقة

363
00:21:00,540 --> 00:21:02,220
!عليك أن تقول ذلك على الهواء

364
00:21:02,220 --> 00:21:04,950
تقول أنّني مضحك، لكنّني أجهل
!ما الّذي تريدني أن أفعله

365
00:21:04,950 --> 00:21:07,400
إنّها طريقة ردّك عليّ
!عندما تشعر أنّك محاصر

366
00:21:07,400 --> 00:21:09,520
ولماذا لا أردّ عليك هكذا بعد
أن ضغطت عليّ؟

367
00:21:09,520 --> 00:21:12,960
،أيّها السّائق، في المدرسة الإعداديّة
دخل هذا الرّجل في مشاجرة

368
00:21:12,960 --> 00:21:14,140
.مع فتاة انتهت بالتّعادل

369
00:21:14,140 --> 00:21:16,830
!لا علاقة لذلك بهذه المحادثة

370
00:21:16,830 --> 00:21:18,660
!كفاك حديثًا عن حياتي الشّخصيّة

371
00:21:18,660 --> 00:21:21,280
.أنت تلميذ سيّئ ومقاتل سيّئ وكوميديّ سيّئ

372
00:21:21,280 --> 00:21:22,440
أهنالك ما تجيده بالفعل؟

373
00:21:22,440 --> 00:21:24,950
!قدراتي الأكاديميّة ليست جزءًا من هذا

374
00:21:24,950 --> 00:21:26,540
!ارتدنا نفس المدرسة الثّانويّة

375
00:21:26,540 --> 00:21:27,950
!لسنا مختلفين لذاك الحدّ

376
00:21:29,120 --> 00:21:30,640
.إنّه مدير أعمالنا

377
00:21:32,410 --> 00:21:33,810
.سنصل للاستوديو قريبًا

378
00:21:33,810 --> 00:21:35,480
.نعم. إنّنا في سيّارة أجرة

379
00:21:35,480 --> 00:21:38,320
.ماذا؟ نعم، إنّه يجلس أمامي

380
00:21:38,320 --> 00:21:40,870
.نعم. نعم

381
00:21:40,870 --> 00:21:43,520
ماذا؟ من، أنا؟

382
00:21:44,210 --> 00:21:47,240
.نعم. غدًا؟ هذا يناسبني

383
00:21:47,240 --> 00:21:49,660
نعم. أأنت جادّ؟

384
00:21:49,660 --> 00:21:52,330
.نعم. نعم. مع السّلامة

385
00:21:54,920 --> 00:21:55,940
ماذا قال؟

386
00:21:57,110 --> 00:21:58,090
.عرض ظهور منتظم

387
00:21:58,090 --> 00:22:00,190
أنت تكذب. أين؟

388
00:22:00,190 --> 00:22:02,210
.برنامج طعام نهاريّ من نوع ما

389
00:22:02,210 --> 00:22:03,530
—هذا ممتاز؟ مر

390
00:22:03,530 --> 00:22:04,570
.إنّه لي فقط

391
00:22:21,190 --> 00:22:22,150
—أين تـ

392
00:23:34,970 --> 00:23:50,580
الحلقة القادمة
ادّعاءات بائدة وحارس شخصيّ

393
00:23:35,610 --> 00:23:36,600
كيف الأحوال مؤخّرًا يا سيّدتي؟

394
00:23:36,600 --> 00:23:37,420
بشأن ماذا؟

395
00:23:37,420 --> 00:23:38,280
.كاكيهانا

396
00:23:38,280 --> 00:23:39,980
.ليس لديّ ما أخبرك به

397
00:23:39,980 --> 00:23:41,730
.إنّه ميؤوس منه بكلّ تأكيد

398
00:23:41,730 --> 00:23:43,320
.قرد غبيّ ميؤوس منه

399
00:23:43,320 --> 00:23:45,080
.أخفضي صوتك. قد يسمعك

400
00:23:45,080 --> 00:23:46,410
.مصيبة. لقد نظرنا لبعضنا

401
00:23:46,410 --> 00:23:48,030
يا سيّدتي، ألديك أيّ قرارات للسّنة الجديدة؟

402
00:23:48,030 --> 00:23:49,940
.ربّما سأفتح محلاًّ ثانيًا