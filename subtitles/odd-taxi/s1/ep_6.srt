1
00:01:14,540 --> 00:01:15,800
.أيّها السّائق

2
00:01:15,800 --> 00:01:18,260
.أنت معجب ميستري كيس

3
00:01:18,260 --> 00:01:20,170
!تتذكّرني؟

4
00:01:20,170 --> 00:01:22,420
.الأهمّ من ذلك هو أنّني سعيد بلقائك ثانية

5
00:01:22,420 --> 00:01:23,140
لماذا؟

6
00:01:23,140 --> 00:01:26,200
.أردت شكرك. خذني إلى شينجوكو رجاءً

7
00:01:29,200 --> 00:01:30,830
هل فعلتُ شيئًا ما من أجلك؟

8
00:01:30,830 --> 00:01:35,450
.يا رجل، لقد أنقذت حياتي نوعًا ما

9
00:01:35,450 --> 00:01:36,850
أنقذت حياتك؟

10
00:01:36,850 --> 00:01:38,240
.حسنًا، ربّما ذلك مبالغ فيه

11
00:01:38,240 --> 00:01:39,320
فعلاً؟

12
00:01:39,320 --> 00:01:41,220
.لكنّك غيّرت حياتي

13
00:01:41,220 --> 00:01:43,580
.إنّك أشبه بإله إن جاز التّعبير

14
00:01:43,580 --> 00:01:45,740
!مهلاً، إنّها ميستري كيس

15
00:01:46,520 --> 00:01:49,320
—أخبرني أيّها السّائق— بل أيّها الإله

16
00:01:49,320 --> 00:01:50,570
.اسمي أودوكاوا

17
00:01:50,570 --> 00:01:54,040
أودوكاوا-ساما، هل صرت من معجبي ميستري كيس؟

18
00:01:54,040 --> 00:01:56,500
.لا، بل... نوعًا ما

19
00:01:57,050 --> 00:01:59,260
!هذا متوقّع من أودوكاوا-ساما

20
00:01:59,260 --> 00:02:00,720
ماذا فعلت؟

21
00:02:01,430 --> 00:02:06,700
لقد فزت باليانصيب باستعمال
.الأرقام الّتي أعطيتنيها بالفعل

22
00:02:06,700 --> 00:02:08,000
.فعلاً؟ هذا مذهل

23
00:02:08,000 --> 00:02:10,410
!هذه ردّة فعل ضعيفة

24
00:02:10,410 --> 00:02:12,730
.لكنّني اخترت تلك الأرقام بشكل عشوائيّ

25
00:02:12,730 --> 00:02:15,150
.لم تسمع بعد كم ربحت

26
00:02:15,150 --> 00:02:17,440
!فزت بمليار ينّ

27
00:02:18,380 --> 00:02:19,270
فعلاً؟

28
00:02:19,270 --> 00:02:20,620
!فعلاً

29
00:02:20,620 --> 00:02:22,100
،لم أطالب بأرباحي بعد

30
00:02:22,100 --> 00:02:24,420
.لكنّني تحقّقت منها حوالي مئة مرّة

31
00:02:25,340 --> 00:02:28,480
.إن كان ذلك صحيحًا، فلا يجدر بك نشر ذلك الخبر

32
00:02:28,480 --> 00:02:30,430
.هذه أوّل مرّة أخبر فيها أحدًا في الحياة الواقعيّة

33
00:02:30,430 --> 00:02:33,110
.وجب عليّ إخبارك

34
00:02:33,110 --> 00:02:34,920
ما الّذي تعنيه بقولك "الحياة الواقعيّة"؟

35
00:02:34,920 --> 00:02:37,760
،أخبرت النّاس على الإنترنت
.لكنّ ذلك على الإنترنت فحسب

36
00:02:37,760 --> 00:02:41,110
!إضافة لذلك، هذا أمر هائل لأبقيه لنفسي فقط

37
00:02:41,110 --> 00:02:43,010
.وجب عليّ إخبار أحد ما

38
00:02:43,010 --> 00:02:45,750
.بإمكانك الآن شراء أقراص ميستري كيس

39
00:02:45,750 --> 00:02:49,150
هذا صحيح. إنّني أحتفظ ببطاقتي الرّابحة معي

40
00:02:49,150 --> 00:02:51,750
لأستطيع المطالبة بأرباحي بمجرّد
.صدور قرصهنّ

41
00:02:51,750 --> 00:02:53,510
.من الأفضل ألاّ تفقدها

42
00:02:54,190 --> 00:02:56,920
.اسمع يا أودوكاوا-ساما، أردت شكرك

43
00:02:56,920 --> 00:02:58,320
.ليس عليك ذلك

44
00:02:58,320 --> 00:03:00,100
!لا، لا، لا! ذلك غير مقبول

45
00:03:00,100 --> 00:03:02,330
هل تحتاج المال لأمر ما؟

46
00:03:02,330 --> 00:03:03,870
.لا شيء بالتّحديد

47
00:03:03,870 --> 00:03:07,320
إذًا، ربّما يواجه فرد من عائلتك
أو شخص تهتمّ لأمره المشاكل؟

48
00:03:10,730 --> 00:03:11,670
.لا شيء من ذلك

49
00:03:11,670 --> 00:03:14,130
!ألا تشعر بالرّغبة إطلاقًا؟

50
00:03:14,130 --> 00:03:17,050
،في تلك الحالة يا أودوكاوا-ساما
هل أنت متفرّغ الآن؟

51
00:03:17,050 --> 00:03:19,750
.كما ترى، أنا أعمل في الوقت الحاليّ

52
00:03:19,750 --> 00:03:22,460
.سأدفع لك أيّ ما كنت ستجنيه اليوم

53
00:03:22,460 --> 00:03:24,710
.تعال معي فحسب

54
00:03:25,740 --> 00:03:29,070
لستَ مرغمًا على فعل هذا. إلى أين سنذهب؟

55
00:03:29,680 --> 00:03:30,980
!إلى هنا

56
00:03:31,330 --> 00:03:33,850
.أنا نادل في نادي كاباري

57
00:03:33,850 --> 00:03:37,070
،بما أنّك لا تريد أيّ شيء
.فسأعرض عليك شيئًا

58
00:03:37,070 --> 00:03:38,780
.خدمة مجّانيّة مدى الحياة

59
00:03:46,650 --> 00:03:48,210
.إنّه الشّخصيّة الهامّة أودوكاوا-ساما

60
00:03:48,210 --> 00:03:52,080
،تمّ الدّفع مقابل كلّ شيء
.لذلك اطلبوا ما يحلو لكم

61
00:03:52,080 --> 00:03:53,220
فعلاً؟

62
00:03:52,080 --> 00:03:53,230
.هذا رائع

63
00:03:53,230 --> 00:03:54,830
!مذهل

64
00:03:55,260 --> 00:03:57,270
ماذا تريد أن تشرب يا أودوكاوا-سان؟

65
00:03:57,270 --> 00:03:59,550
.في الحقيقة، عليّ القيادة

66
00:03:59,550 --> 00:04:01,950
هل يمكننا أن نشرب نحن؟

67
00:04:08,400 --> 00:04:09,860
.أكيد، تفضّلن

68
00:04:09,860 --> 00:04:11,480
!مرحى

69
00:04:11,480 --> 00:04:14,380
هل نفتح قنّينة دوم بيرينيون إذًا؟

70
00:04:16,810 --> 00:04:19,440
إلى أين أنت ذاهب يا أودوكاوا-ساما؟

71
00:04:19,930 --> 00:04:21,690
.نلت كفايتي. سأغادر

72
00:04:21,690 --> 00:04:26,120
.على مهلك. استمتع بوقتك قليلاً بعد

73
00:04:32,950 --> 00:04:35,010
أتبحث عن شيء محدّد؟

74
00:04:36,380 --> 00:04:37,380
.لا

75
00:05:26,950 --> 00:05:29,390
ما-ماذا حدث؟

76
00:05:29,770 --> 00:05:33,990
.لا أدري. دخل أحدهم حاملاً مسدّسًا

77
00:05:33,990 --> 00:05:35,370
مسدّس؟

78
00:05:35,370 --> 00:05:37,050
.اخرج من الباب الخلفيّ

79
00:05:37,050 --> 00:05:38,840
.إنّه مخفيّ عن واجهة المكان

80
00:06:02,810 --> 00:06:04,450
مهلاً. ماذا تفعل؟

81
00:06:05,010 --> 00:06:08,310
.ما هذا؟ أهذا للهالوين؟ لم يحن وقته بعد

82
00:06:08,310 --> 00:06:09,890
ألا تظنّ أنّك متسرّع قليلاً؟

83
00:06:09,890 --> 00:06:11,910
،سمعتُ بأشخاص يثيرون الشّغب كلّ سنة

84
00:06:11,910 --> 00:06:14,560
.لكن هذه أوّل مرّة أرى فيها شغبًا من شخص واحد

85
00:06:37,370 --> 00:06:40,510
ما الّذي كنت تحاول فعله يا شيباغاكي؟

86
00:06:40,510 --> 00:06:41,670
...بصراحة

87
00:06:42,590 --> 00:06:45,870
ظننتُ أنّه سيكون من المضحك
.أن أتعرّض لطلق ناريّ

88
00:06:45,870 --> 00:06:47,600
.أنت مجنون

89
00:07:16,160 --> 00:07:17,160
ماذا؟

90
00:07:17,660 --> 00:07:21,090
ما الّذي قصدته عندما أخبرتني بألّا أتورّط معك ثانية؟

91
00:07:27,160 --> 00:07:31,080
!أودوكاوا-سان يتجاهلني

92
00:07:29,590 --> 00:07:32,340
!اهدئي. إنّك تزعجين الجيران

93
00:07:32,340 --> 00:07:34,220
.دعني أدخل إذًا

94
00:07:34,880 --> 00:07:36,420
.سنتحدّث في الخارج

95
00:07:37,010 --> 00:07:38,750
هل ثمّة أحد بالدّاخل؟

96
00:07:44,580 --> 00:07:47,440
ماذا حلّ بسيّارتك؟ أتعرّضتَ للسّرقة؟

97
00:07:47,440 --> 00:07:50,650
.لم يأخذوا أيّ شيء

98
00:07:50,650 --> 00:07:53,730
.من الأفضل أن تصلحها قريبًا إذًا وإلاّ

99
00:07:54,280 --> 00:07:55,480
.تعلم، وإلاّ

100
00:07:55,480 --> 00:07:57,400
.لا فكرة لديّ ما الّذي ترمين إليه

101
00:07:57,400 --> 00:08:01,090
.إن ترك شيء مكسور يدفع النّاس لكسره أكثر

102
00:08:01,090 --> 00:08:02,150
نظريّة النّافذة المكسورة؟

103
00:08:02,150 --> 00:08:03,770
.نعم، نظريّة النّافذة المكسورة

104
00:08:03,770 --> 00:08:06,110
.ينطبق ذلك على القلوب أيضًا

105
00:08:06,110 --> 00:08:07,510
ماذا تعنين؟

106
00:08:09,660 --> 00:08:11,760
ما الّذي تريدينه إذًا؟

107
00:08:12,250 --> 00:08:15,860
.أخبرتني ألاّ أتورّط معك

108
00:08:16,570 --> 00:08:18,410
.أعلم

109
00:08:18,410 --> 00:08:21,280
إنّ طريقة اعتقادك أنّه اعتمادًا
على ما سأفعل، ربّما تكونين

110
00:08:21,280 --> 00:08:23,660
قادرة على إنقاذ هذا
—الوضع بغيضة أيضًا

111
00:08:23,660 --> 00:08:24,660
.انتظر

112
00:08:25,110 --> 00:08:29,530
،بصراحة، كنتُ نوعًا ما— كلاّ
.كنت سعيدًا جدًّا بالفعل

113
00:08:29,530 --> 00:08:31,400
.أشعر بالخجل من نفسي

114
00:08:31,400 --> 00:08:32,860
.أرجوك

115
00:08:32,860 --> 00:08:35,150
.لا تستخدمي حيلك الأنثويّة عليّ أيّتها الجبانة

116
00:08:35,150 --> 00:08:36,870
—بسببك، فإنّ غوريكي

117
00:08:36,870 --> 00:08:39,100
.حسنًا، فهمت. سأخبرك بكلّ شيء

118
00:08:39,100 --> 00:08:42,260
.ليس عليك إخباري بما تعرفه

119
00:08:43,030 --> 00:08:46,200
.صحيح أنّني ودوبو-سان كنّا نتواعد

120
00:08:46,200 --> 00:08:48,520
.لقد بدأتِ بشيء كنتُ أجهله

121
00:08:49,130 --> 00:08:50,910
.كان ذلك لأربع سنوات تقريبًا

122
00:08:50,910 --> 00:08:54,050
.لم أستطع رفض طلبه بسبب المال

123
00:08:54,050 --> 00:08:56,320
.لن أستمع لك إن كنت ستبكين

124
00:08:56,320 --> 00:08:58,600
.كما أنّ هذا ليس من شأني

125
00:08:57,690 --> 00:09:00,060
.مهلاً رجاءً. فهمت

126
00:09:01,470 --> 00:09:03,570
.اقترضتُ مبلغًا كبيرًا من دوبو-سان

127
00:09:03,570 --> 00:09:05,950
.كنتُ أسدّده له شيئًا فشيئًا

128
00:09:05,950 --> 00:09:07,900
.لم أستطع رفض طلبه

129
00:09:08,450 --> 00:09:10,880
.فبدأتِ تسرقين الأدوية

130
00:09:13,690 --> 00:09:17,200
.سأخبر الشّرطة

131
00:09:17,200 --> 00:09:20,420
.يعلم غوريكي أنّك الجانية ولم يبلّغ عنك

132
00:09:20,420 --> 00:09:23,360
اتركي الأمر له بدل قيامك بشيء
.لا يجدر بك فعله

133
00:09:24,080 --> 00:09:25,410
وبعد؟

134
00:09:25,410 --> 00:09:26,520
ماذا؟

135
00:09:26,920 --> 00:09:29,230
لماذا تقرّبتِ منّي؟

136
00:09:30,330 --> 00:09:33,840
.أخبرني دوبو-سان أن أحضر له لائحة المرضى

137
00:09:33,840 --> 00:09:39,280
لا بدّ أنّه كانت لديه عدّة طرق لتحويل
.المعلومات الشّخصيّة إلى أرباح

138
00:09:39,280 --> 00:09:45,270
،عندما رأى اسمك على اللائحة
.سألني عن طباعك

139
00:09:45,270 --> 00:09:47,160
وماذا أخبرته؟

140
00:09:47,160 --> 00:09:49,920
.أخبرته أنّك سائق سيّارة أجرة نكِد

141
00:09:50,510 --> 00:09:54,800
.ثمّ أخبرني دوبو-سان أن أتقرّب منك

142
00:09:54,800 --> 00:09:57,380
—لكن مع الوقت، بدأتُ فعلاً أ

143
00:09:57,380 --> 00:09:59,470
.لا أهتمّ لما ستقولينه

144
00:10:00,040 --> 00:10:03,380
وما هو هدف دوبو الحقيقيّ؟

145
00:10:04,180 --> 00:10:06,890
.قال أنّه سيسرق مصرفًا

146
00:10:06,890 --> 00:10:11,130
.على الأرجح أنّه يحتاج لسيّارة أجرة للهرب

147
00:10:11,130 --> 00:10:13,470
سرقة مصرف؟ في هذا الوقت والعصر؟

148
00:10:13,470 --> 00:10:15,930
.قال أنّ الآن هو أفضل وقت لفعل ذلك

149
00:10:15,930 --> 00:10:18,800
.أراد إذًا استعمالي للهرب

150
00:10:18,800 --> 00:10:20,540
.لا بدّ أنّه يظنّني مغفّلاً

151
00:10:20,970 --> 00:10:22,850
.أريدك أن تصدّقني

152
00:10:22,850 --> 00:10:25,460
،تقرّبت منك لأنّه طلب منّي ذلك

153
00:10:25,460 --> 00:10:28,980
لكن مع مرور الوقت، لم تعد لي
.أيّ نيّة لتسليمك له

154
00:10:29,400 --> 00:10:33,040
لا أهتمّ حيال ذلك. وماذا أيضًا؟

155
00:10:33,040 --> 00:10:35,600
.هذا كلّ شيء حسب ظنّي

156
00:10:36,030 --> 00:10:37,440
.مفهوم

157
00:10:37,440 --> 00:10:40,210
.لا تخبري دوبو أنّنا تحدّثنا

158
00:10:40,210 --> 00:10:41,870
ما الّذي ستفعله؟

159
00:10:42,210 --> 00:10:43,520
.أدعه وشأنه

160
00:10:43,520 --> 00:10:46,430
.ربّما سأتظاهر أنّني سأساعده على سرق المصرف حتّى

161
00:10:47,370 --> 00:10:48,740
.حسنًا

162
00:10:48,740 --> 00:10:51,650
بالمناسبة، ما المبلغ الّذي ما زلت تدينين به لدوبو؟

163
00:10:51,650 --> 00:10:53,290
.ثلاثة ملايين ينّ

164
00:10:53,290 --> 00:10:54,870
ما زلت تدينين له بذلك القدر بعد أربع سنوات؟

165
00:10:54,870 --> 00:10:58,840
.لم يقلّ المبلغ بسبب الفوائد

166
00:10:58,840 --> 00:11:02,170
بفوائد باهظة كهذه، كان يجب
.أن تقترضي المال من شخص آخر

167
00:11:02,170 --> 00:11:04,260
.حتّى أنّك صرتِ شريكته في جرائمه

168
00:11:04,260 --> 00:11:06,080
.كان ليضربني

169
00:11:06,080 --> 00:11:10,160
.كما أنّه رجل ضعيف في الواقع. لم أستطع التّخلّي عنه

170
00:11:11,790 --> 00:11:16,100
.فعلاً؟ لا أهتمّ حيال علاقتكما الاتّكاليّة

171
00:11:17,030 --> 00:11:18,580
.مهلاً يا أودوكاوا-سان

172
00:11:20,120 --> 00:11:23,650
.كلّ ما أخبرتك به اليوم هو الحقيقة

173
00:11:24,240 --> 00:11:29,120
.أريد تسديد ديني وترك دوبو-سان. بالفعل

174
00:11:29,680 --> 00:11:33,300
...سأعتذر للطّبيب غوريكي، لأنّني

175
00:11:35,930 --> 00:11:38,160
.لأنّني أحبّك

176
00:11:42,310 --> 00:11:45,540
.إيّاك أن تتورّطي معي ثانية

177
00:12:05,040 --> 00:12:06,800
.أنا متعب

178
00:12:20,740 --> 00:12:23,740
هل أنت بخير؟ قرأت بعض الأخبار
.عن القصّة على الإنترنت

179
00:12:23,740 --> 00:12:27,270
.كان ذلك صادمًا بكلّ تأكيد
.وُجّه هنالك مسدّس نحوي

180
00:12:27,270 --> 00:12:29,470
.استجوبتني الشّرطة بعد ذلك أيضًا

181
00:12:29,470 --> 00:12:34,190
عنوان رئيسيّ: "يواجه شيباغاكي من هوموسابين
."لصًّا مسلّحًا في عمله بدوام جزئيّ

182
00:12:34,190 --> 00:12:36,310
.تبدو "عمل بدوام جزئيّ" سخيفة

183
00:12:36,310 --> 00:12:38,130
ولماذا لم يُجروا معي مقابلة بشكل لائق؟

184
00:12:38,130 --> 00:12:39,820
.أنا من صدّ اللّصّ

185
00:12:39,820 --> 00:12:40,970
فعلاً؟

186
00:12:40,970 --> 00:12:42,050
.فعلاً

187
00:12:42,050 --> 00:12:43,190
كيف؟

188
00:12:43,190 --> 00:12:44,980
.أخبرته أن يطلق عليّ إن استطاع

189
00:12:44,980 --> 00:12:46,010
وبعدها؟

190
00:12:46,010 --> 00:12:49,450
،احترامًا لِما أبديت من رجولة
.قرّر التّراجع

191
00:12:49,450 --> 00:12:50,520
قال ذلك فعلاً؟

192
00:12:50,520 --> 00:12:52,950
.ذلك ما بدا على عينيه خلف القناع

193
00:12:52,950 --> 00:12:55,850
هلاّ كنت دقيقًا أكثر؟
ما كان الوضع بالتّحديد؟

194
00:12:55,850 --> 00:12:58,530
لا يمكنني قول الكثير. لا يريد
.رئيسي أن أتحدّث عن الأمر

195
00:12:58,530 --> 00:13:01,710
أنت من يقول دائمًا أنّ علينا إلقاء
أنفسنا في المشاكل

196
00:13:01,710 --> 00:13:03,570
.من أجل الحصول على قصص مثيرة

197
00:13:03,570 --> 00:13:05,100
ما الفائدة إن لم تستطع الحديث عن الأمر؟

198
00:13:05,100 --> 00:13:07,050
ما الّذي كنت تفعله في هذا الأسبوع الماضي إذًا؟

199
00:13:07,050 --> 00:13:08,520
.كنتُ أسجّل للدّراما خاصّتي

200
00:13:08,520 --> 00:13:10,470
.أعتقد أنّه تمّ إصدار تفاصيل معيّنة عنها الآن

201
00:13:10,470 --> 00:13:11,430
.هكذا إذًا

202
00:13:11,430 --> 00:13:13,680
هذا إضافة لظهوري المنتظم
.على التّلفاز، لذلك لم أنم كثيرًا

203
00:13:14,260 --> 00:13:16,660
إنّ اليافعين حديثي العهد بالنّجاح
.يتباهون هكذا دائمًا

204
00:13:16,660 --> 00:13:20,520
كنتُ أفكّر مؤخّرًا أنّ الكوميديا
.الّتي لا تؤذي أحدًا هي الأفضل

205
00:13:20,520 --> 00:13:24,690
مستحيل. في ظنّي أنّ لا بأس من أذيّة
.شخص واحد لإضحاك عشرة

206
00:13:24,690 --> 00:13:26,450
.يجعل هذا النّاس يبغضونك

207
00:13:26,450 --> 00:13:29,370
.انظر للأشخاص النّاجحين هذه الأيّام
.إنّهم جميعًا ودودون

208
00:13:29,370 --> 00:13:32,210
أتظنّ أنّ ذلك يجعل النّاس يضحكون؟
أعني يضحكون بالفعل؟

209
00:13:32,210 --> 00:13:36,100
عندما كنّا أطفالاً، كنّا نضحك لدرجة أنّ أجسادنا

210
00:13:36,100 --> 00:13:38,710
.كانت تتخدّر من الكلمات القاسية والجارحة

211
00:13:38,710 --> 00:13:40,370
.صحيح، لكنّ الزّمن تغيّر

212
00:13:40,370 --> 00:13:43,250
ماذا؟ أتعتقد أنّ القيام بتعابير غريبة مضحكًا؟

213
00:13:43,250 --> 00:13:44,760
هل تعتقد أنّ تدوير عينيك مضحكًا؟

214
00:13:44,760 --> 00:13:46,080
!أتعتقد أنّ ذلك يضحك النّاس؟

215
00:13:46,080 --> 00:13:48,770
،بما أنّ شيباغاكي-سان قد تحمّس كثيرًا
.لننتقل إذًا إلى بريد المعجبين

216
00:13:48,770 --> 00:13:50,880
هذا من اسم المذياع ويقول "عندما
،يُسأل النّاس عن مكان عيشهم

217
00:13:50,880 --> 00:13:54,300
فإنّ معظم من يجيبون بأوساكا
."هم من أماغاساكي في الحقيقة

218
00:13:54,300 --> 00:13:55,820
.أعلم ما تعنيه

219
00:13:55,820 --> 00:13:59,350
،أماغاساكي في محافظة هيوغو
.لكنّ رمز منطقتهم هو 06

220
00:13:59,350 --> 00:14:00,860
ماذا عن ذلك الشّخص؟

221
00:14:00,860 --> 00:14:01,960
مَن؟

222
00:14:01,960 --> 00:14:05,120
تلميذ الثّانويّة المتذاكي ذاك
.الّذي يرسل لنا بريدًا دائمًا

223
00:14:05,120 --> 00:14:06,600
ناغاشيما ساتوشي-كُن؟

224
00:14:07,280 --> 00:14:08,820
.لم يصلنا أيّ شيء منه اليوم

225
00:14:20,980 --> 00:14:22,950
أين أودوكاوا-سان اليوم؟

226
00:14:22,950 --> 00:14:26,300
قال أنّه سينتهي من العمل باكرًا اليوم
.وسيأتي إن كان مزاجه يسمح بذلك

227
00:14:26,690 --> 00:14:29,070
.تغيّرتَ مؤخّرًا يا كاكيهانا-سان

228
00:14:29,070 --> 00:14:30,260
فعلاً؟

229
00:14:33,220 --> 00:14:35,200
!بابا-سان

230
00:14:36,110 --> 00:14:37,630
هلاّ صافحتني؟

231
00:14:37,630 --> 00:14:38,510
.بكلّ تأكيد

232
00:14:38,510 --> 00:14:39,740
هلاّ أعطيتني توقيعك؟

233
00:14:39,740 --> 00:14:41,080
.شكرًا لك

234
00:14:47,210 --> 00:14:48,160
.إلى ناكامِغورو رجاءً

235
00:14:48,160 --> 00:14:49,540
.أعرف تمامًا ما تعنيه

236
00:14:49,950 --> 00:14:50,960
ماذا؟

237
00:14:51,570 --> 00:14:53,860
ما المضحك في تدوير العينين؟

238
00:14:54,660 --> 00:14:56,570
.فهمك للأمر لا يعني شيئًا لي

239
00:14:56,570 --> 00:14:57,870
من تكون على أيّ حال؟

240
00:14:57,870 --> 00:14:59,260
.لننطلق أيّها السّائق

241
00:15:02,970 --> 00:15:06,630
.أنا ناغاشيما! ناغاشيما ساتوشي

242
00:15:16,310 --> 00:15:18,030
.مرحبًا، أنا كاباساوا تايتشي

243
00:15:18,030 --> 00:15:21,010
هل تدرون أنّه كان هنالك إطلاق نار البارحة

244
00:15:21,010 --> 00:15:23,400
في نادي كاباري "الدّلفين الأبيض" في شينجوكو؟

245
00:15:23,400 --> 00:15:25,290
ظهر في الأخبار، لكن هل تصدّقون الأمر؟

246
00:15:25,290 --> 00:15:29,320
.أرسل لي مُشاهد كان حاضرًا هذا المقطع

247
00:15:29,320 --> 00:15:31,830
.لا بدّ أنّه دوبو

248
00:15:31,830 --> 00:15:35,570
إنّ المزيد والمزيد من أفعال دوبو
.الشّنيعة تُكتشف للعلن

249
00:15:35,570 --> 00:15:37,070
وما يسعدني أكثر فعلاً

250
00:15:37,070 --> 00:15:39,770
هو أنّه كان بمقدوره جني ثروة
،من بيع المقطع لوسائل الإعلام

251
00:15:39,770 --> 00:15:43,380
!لكنّه أرسله إلى كاباساوا تايتشي بالمجّان! بالمجّان تمامًا

252
00:15:43,380 --> 00:15:45,820
،أنا واثق أنّ السّبب هو كرهه الشديد لدوبو

253
00:15:45,820 --> 00:15:49,750
لكن أعتقد أنّ قدرة كاباساوا تايتشي
.المُوحِّدة صارت بتلك القوّة

254
00:15:49,750 --> 00:15:51,250
.وأنّ هذه نعمة

255
00:15:51,250 --> 00:15:55,190
.دليل على أنّني اقتربت أكثر لأصبح إلهًا

256
00:15:55,190 --> 00:15:58,430
!حسنًا يا دوبو، ساعتك وشيكة

257
00:15:58,430 --> 00:16:01,800
.لديّ مليون متابع. أنا إله

258
00:15:59,610 --> 00:16:02,040
.تبدو في حالة يرثى لها

259
00:16:01,800 --> 00:16:04,480
!هل أنت جاهز لتدفع ثمن جرائمك؟

260
00:16:02,040 --> 00:16:04,020
.أعتقد أنّك حسّاس بشكل مفاجئ

261
00:16:04,480 --> 00:16:08,360
.أشعر أنّني أُلامُ على كلّ الجرائم في العالم

262
00:16:08,360 --> 00:16:12,220
.ولم أفهم مدى تأثير الإنترنت

263
00:16:12,220 --> 00:16:14,410
.يبدو الجميع كأعداء لي الآن

264
00:16:14,410 --> 00:16:16,850
.إنّك تستحقّ ذلك بكلّ تأكيد

265
00:16:17,330 --> 00:16:21,880
.المسدّس الّذي استعمله كان لي بالتّأكيد
.هذا هو السّيّئ في الأمر

266
00:16:21,880 --> 00:16:23,420
أهذا من صنيع يانو ذاك؟

267
00:16:23,420 --> 00:16:25,960
.لا أظنّه يانو

268
00:16:25,960 --> 00:16:28,540
.إن كان يانو، لبدا الأمر ذو معنى أوضح

269
00:16:28,910 --> 00:16:32,550
.إن أمعنت النّظر، يبدو أنّه يبحث عن شخص ما

270
00:16:34,080 --> 00:16:36,230
كنتَ في الحمّام عندما حدث ذلك، صحيح؟

271
00:16:36,230 --> 00:16:39,170
هل تقول أنّ هنالك من يحمل ضغينة ضدّي؟

272
00:16:39,170 --> 00:16:41,650
،إن كان كسر نافذة سيّارتك مصادفة أيضًا

273
00:16:41,650 --> 00:16:43,130
.فحظّك عاثر للغاية

274
00:16:43,560 --> 00:16:47,560
لم يُسرق شيء. وبالطّبع، يتضمّن ذلك
.محتوى كاميرا سيّارتي الدّاخليّة

275
00:16:47,560 --> 00:16:49,490
.ذلك قصدي بالضّبط

276
00:16:49,490 --> 00:16:51,760
،إن كنّا نبحث عن دافع

277
00:16:51,760 --> 00:16:56,200
فعلى الأرجح أنّه شخص
.يحاول تعذيبك حتّى الموت

278
00:16:56,200 --> 00:16:59,410
.ذهنيًّا في البداية، ثمّ جسديًّا

279
00:17:02,170 --> 00:17:04,810
.أنا متفاجئ لأنّك هادئ حيال كلّ هذا

280
00:17:04,810 --> 00:17:07,430
.وكأنّك لستَ خائفًا من الموت بالفعل

281
00:17:07,430 --> 00:17:10,670
.أنا خائف. بالطّبع أنا خائف

282
00:17:12,550 --> 00:17:14,380
لماذا لا نوحّد جهودنا إذًا؟

283
00:17:14,380 --> 00:17:15,360
نوحّد جهودنا؟

284
00:17:15,810 --> 00:17:21,300
يحاول رجل الهالوين هذا قتلك
.وأنا أحتاج لاستعادة المسدّس

285
00:17:21,300 --> 00:17:23,060
لماذا لا نقاتل معًا؟

286
00:17:23,400 --> 00:17:26,300
،وبعيدًا عن هذا الأمر
.بخصوص ميستري كيس

287
00:17:26,300 --> 00:17:29,020
.إن كان يانو متورّطًا، فلا يمكنني الاقتراب من هذا

288
00:17:29,020 --> 00:17:31,320
.أريدك أن تساعدني على جمع المعلومات

289
00:17:31,320 --> 00:17:33,350
.أنا من يقوم بكلّ العمل هنا

290
00:17:33,350 --> 00:17:35,460
.لستُ أطلب منك القيام به بلا مقابل

291
00:17:35,460 --> 00:17:39,170
.سأحرص على أن يعود غوريكي لعيادته

292
00:17:39,600 --> 00:17:40,870
.لا بأس

293
00:17:40,870 --> 00:17:42,540
ستساعدني إذًا؟

294
00:17:43,510 --> 00:17:45,460
،قطعنا شوطًا طويلاً للوصول إلى هنا

295
00:17:45,460 --> 00:17:48,070
.لكنّنا مقدّر لنا أن نصير حليفين

296
00:17:48,070 --> 00:17:50,530
.أريد إضافة شرط آخر

297
00:17:50,530 --> 00:17:51,430
ما هو؟

298
00:17:53,560 --> 00:17:56,810
.أعطِ شيراكاوا-سان حرّيّتها

299
00:17:58,160 --> 00:18:00,390
.اشطب كلّ ديونها

300
00:18:02,090 --> 00:18:05,310
.حسنًا. أعدك

301
00:18:11,840 --> 00:18:14,030
.سأبحث عن حامل المسدّس

302
00:18:14,030 --> 00:18:17,170
.أريدك أن تمسك كاباساوا تايتشي يا أودوكاوا

303
00:18:17,170 --> 00:18:20,470
.هذا الفتى؟ قمتُ بتوصيله مرّة

304
00:18:20,470 --> 00:18:23,670
.أعلم. لقد حفظت صورتنا الجماعيّة

305
00:18:23,670 --> 00:18:27,290
،نعرف هويّة كاباساوا تايتشي
.لذلك بإمكاننا فعل شيء حياله

306
00:18:27,290 --> 00:18:29,440
لكن كيف سنجد حامل المسدّس؟

307
00:18:29,440 --> 00:18:30,790
.هالوين

308
00:18:31,370 --> 00:18:34,550
في الهالوين، سأرتدي ملابس حامل المسدّس

309
00:18:34,550 --> 00:18:35,990
.وسأجوب المدينة

310
00:18:35,990 --> 00:18:37,840
سترتدي قناع جمجمة؟

311
00:18:38,530 --> 00:18:41,410
،فهمت. بما أنّ الجميع يعرف وجهك

312
00:18:41,410 --> 00:18:43,830
.فلا يمكنك التّجوال في المدينة في أيّ يوم آخر

313
00:18:43,830 --> 00:18:47,270
.قد يخرج مرتديًا نفس الزّيّ

314
00:18:47,270 --> 00:18:50,350
.في كلّ الأحوال، أتوقّع أن ألقاه بطريقة أو بأخرى

315
00:18:50,350 --> 00:18:53,020
.إنّه من النّوع الّذي يعظّم نفسه

316
00:18:53,020 --> 00:18:56,400
.سأذهب مباشرة إلى جامعة كاباساوا تايتشي وسأقلّه

317
00:18:56,400 --> 00:19:00,200
جامعة؟ كم من الطّلبة ستجد هناك في رأيك؟

318
00:19:00,200 --> 00:19:04,340
.لا بأس. أنا أجيد العثور على النّاس ضمن الحشود

319
00:19:04,340 --> 00:19:06,900
لماذا؟ ألديك نظر حادّ أو ما شابه؟

320
00:19:08,210 --> 00:19:09,660
ماذا تعني بلماذا؟

321
00:19:10,400 --> 00:19:13,090
.بل أجد من الغريب أنّكم سيّئون في ذلك

322
00:19:14,460 --> 00:19:16,790
.تجربة الكاميرا جيّدة

323
00:19:17,550 --> 00:19:21,720
اسمع، إنّك تجني الكثير من المال مؤخّرًا، صحيح؟

324
00:19:21,720 --> 00:19:23,370
.ليس تمامًا

325
00:19:23,370 --> 00:19:26,530
.لقد وُصفتَ بالفنّان الصّاعد الأوّل

326
00:19:26,530 --> 00:19:28,140
ماذا؟ فعلاً؟

327
00:19:28,140 --> 00:19:31,330
.عرفتُ أنّك ستنجح يا بابا-كُن

328
00:19:31,330 --> 00:19:34,670
يصعب شرح الأمر، لكن هنالك أناس
محبوبين رغم غبائهم، أتعلم؟

329
00:19:34,670 --> 00:19:35,900
—رغم غبائهم؟ لستُ

330
00:19:35,900 --> 00:19:38,170
.لم أقصد ذلك بشكل غريب

331
00:19:38,170 --> 00:19:39,610
أوهل يُنظر للأمر بخلاف ذلك؟

332
00:19:39,610 --> 00:19:43,040
.يصعب وصف ما الجيّد حيالك يا بابا-كُن

333
00:19:43,040 --> 00:19:45,130
.لا تستسلم بسهولة

334
00:19:45,130 --> 00:19:46,960
.عُدّ رجاءً كلّ ما هو جيّد حيالي

335
00:19:46,960 --> 00:19:49,470
.لديك فضيلة أو عفّة معيّنة

336
00:19:49,470 --> 00:19:51,920
.باختصار، نشأتك نشأة جيّدة

337
00:19:51,920 --> 00:19:54,750
.أراهن أنّه لا يوجد الكثير ممّن يكرهونك

338
00:19:54,750 --> 00:19:57,660
.لا، لا. يكرهني شريكي على الأرجح

339
00:19:57,660 --> 00:19:59,630
.إنّه ينعتني بالحثالة عديم الفائدة دائمًا

340
00:19:59,630 --> 00:20:02,090
.عليك الانفصال عنه

341
00:20:02,090 --> 00:20:03,030
ماذا؟

342
00:20:03,670 --> 00:20:07,210
.في عالمنا هذا، يتمّ التخلّص الضّعفاء

343
00:20:07,210 --> 00:20:09,440
.إنّ شريكك مجرّد خاسر لا يتقبّل الهزيمة

344
00:20:09,440 --> 00:20:10,760
—لكنّ شيباغاكي

345
00:20:10,030 --> 00:20:13,080
حسنًا، أودّ منك الظّهور
.في برنامج خاصّ بنهاية العام

346
00:20:13,080 --> 00:20:17,880
.سنبدأ التّسجيل الجمعة القادمة
.نريدك معنا بشدّة

347
00:20:20,290 --> 00:20:23,620
.ستقام الجولة الثّالثة من إن-1 يومها
.بإمكاني المجيء بعد ذلك

348
00:20:24,380 --> 00:20:27,200
ما زلت تقوم بذلك؟
.تخلّ عن الأمر فحسب

349
00:20:27,200 --> 00:20:30,310
...قضيتُ سنة أجهّز للأمر، لذلك

350
00:20:32,450 --> 00:20:34,170
.فهمت

351
00:20:34,170 --> 00:20:37,020
.سنقوم ببعض التّعديلات إذًا

352
00:20:37,630 --> 00:20:39,140
.أعتمد عليك يا بابا-تشان

353
00:20:39,140 --> 00:20:40,530
.أعلّق عليك آمالاً كثيرة

354
00:20:48,350 --> 00:20:49,310
.أمسكتك

355
00:20:49,310 --> 00:20:50,760
مهلاً، ماذا تفعلين هنا؟

356
00:20:50,760 --> 00:20:52,900
.رأيت المنتج وهو يغادر

357
00:20:52,900 --> 00:20:54,270
.لا يمكنك الدّخول

358
00:20:54,270 --> 00:20:56,810
.لكنّني لم أرك على الإطلاق مؤخّرًا

359
00:20:56,810 --> 00:20:59,900
.آسف. ليس لديّ وقت حتّى للنّوم هذه الأيّام

360
00:20:59,900 --> 00:21:02,610
.أخبرتك أنّك لم تحتاج لتصبح ناجحًا هكذا

361
00:21:02,610 --> 00:21:05,110
ماذا تفعلين اليوم يا روي-تشان؟
هل تسجّلين شيئًا ما؟

362
00:21:05,110 --> 00:21:07,790
.ستصدر أغنية انطلاقتنا في عيد الميلاد المجيد

363
00:21:07,790 --> 00:21:09,170
.إنّني أروّج لها اليوم

364
00:21:09,170 --> 00:21:11,620
سنحيي حفلة في القاعة تتّسع
.لألفَيْ شخص ذاك اليوم

365
00:21:11,620 --> 00:21:14,500
.فعلاً؟ هذا رائع! أنا سعيد لأجلك

366
00:21:14,500 --> 00:21:16,590
.إنّك تتقدّمين خطوةً خطوة

367
00:21:16,590 --> 00:21:19,570
لطالما قلتِ أنّك تريدين
.الصعود أعلى وأعلى يا روي-تشان

368
00:21:19,570 --> 00:21:23,240
،نعم. وإن سار ذلك على ما يرام
.قالوا أنّهم سيحجزون لنا بودوكان

369
00:21:23,240 --> 00:21:25,210
.فعلاً؟ أنا أشجّعك

370
00:21:25,210 --> 00:21:26,500
.من الأفضل أن أعمل بجدّ أيضًا

371
00:21:26,930 --> 00:21:29,110
.ليس عليك الاجتهاد لذاك الحدّ

372
00:21:29,110 --> 00:21:33,640
.أحبّ أنّك عكس طموحي المفرط يا بابا-سان

373
00:21:34,510 --> 00:21:37,770
.لا تنفكّين عن قول ذلك، لكن ما زلتُ رجلاً

374
00:21:37,770 --> 00:21:39,860
.لكن صحيح أنّني أفتقر للطّموح

375
00:21:40,290 --> 00:21:43,460
.ما المشكلة إذًا؟ هيّا

376
00:21:49,690 --> 00:21:51,460
أواثقة أنّك لا تعتبرينني حيوانك الأليف فحسب؟

377
00:21:51,460 --> 00:21:53,790
.لا أريد حيوانًا أليفًا بوجه حصان

378
00:21:58,710 --> 00:22:00,420
.عرفت أنّني سأجدك هنا

379
00:22:00,420 --> 00:22:02,010
.بدأ التّسجيل. لنذهب

380
00:22:02,010 --> 00:22:03,340
.كان ذلك وشيكًا

381
00:22:03,760 --> 00:22:05,260
.قادمة

382
00:22:05,260 --> 00:22:07,300
.بابا-سان، أنا أرجوك

383
00:22:07,740 --> 00:22:10,380
.واثق أنّك تدرك الأمر الآن بما أنّك أصبحت ناجحًا

384
00:22:10,380 --> 00:22:12,790
.هذا وقت مهمّ للغاية لها

385
00:22:12,790 --> 00:22:14,520
.نعم. أعلم

386
00:22:14,520 --> 00:22:17,700
أعلمني إن فرغ وقت ما في جدول
.أعمالك. سأفرغ جدولي أيضًا

387
00:22:24,150 --> 00:22:25,010
مرحبًا؟

388
00:22:25,010 --> 00:22:26,650
هل تريد أن نلتقي ونناقش موادّنا؟

389
00:22:27,740 --> 00:22:29,660
.آسف. لديّ تسجيل

390
00:22:30,720 --> 00:22:32,910
.ماذا سنفعل؟ الجولة الثّالثة بعد أسبوع

391
00:22:33,690 --> 00:22:35,290
ماذا أفعل؟

392
00:22:35,290 --> 00:22:37,110
ماذا لديك بعد التّسجيل اليوم؟

393
00:22:37,110 --> 00:22:38,490
.لديّ حفلة ختام

394
00:22:38,490 --> 00:22:39,580
وماذا عن الغد؟

395
00:22:39,580 --> 00:22:41,190
.لديّ تصوير في عين المكان طوال اليوم

396
00:22:41,190 --> 00:22:42,550
واليوم الّذي يليه؟

397
00:22:42,550 --> 00:22:44,010
.سأصوٍّر دراما في الصّباح الباكر

398
00:22:44,010 --> 00:22:45,390
واليوم الّذي بعده؟

399
00:22:45,390 --> 00:22:46,490
.لديّ تصوير تغطية في عين المكان

400
00:22:46,490 --> 00:22:47,770
واليوم الّذي يلي ذلك؟

401
00:22:47,770 --> 00:22:48,830
.سأسجّل عرضًا خاصًّا

402
00:22:48,830 --> 00:22:50,040
واليوم الّذي بعده؟

403
00:22:50,040 --> 00:22:51,400
.تصوير خارج البلاد

404
00:23:34,970 --> 00:23:50,610
الحلقة القادم
خدعة أم حلوى

405
00:23:36,260 --> 00:23:39,500
.أيّها الأخ الصّغير دايمون
كيف يسير التّحقيق؟

406
00:23:39,500 --> 00:23:40,540
.اسمع يا أودوكاوا

407
00:23:40,540 --> 00:23:43,330
يملك قانون الخدمة المدنيّة
.المحلّيّ ما يُدعى بالسّرّيّة

408
00:23:43,330 --> 00:23:45,310
،لا أدري ما الّذي يندرج تحته

409
00:23:45,310 --> 00:23:48,690
!لكنّ المعلومات لا تصل لأتباع متدنّين مثلي

410
00:23:48,690 --> 00:23:49,940
!لا تجبرني على قول هذا