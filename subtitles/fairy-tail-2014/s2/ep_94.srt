1
00:00:13,140 --> 00:00:14,710
!إنني أراها

2
00:00:16,090 --> 00:00:18,090
!زيرا! انظري! هُناك

3
00:00:18,640 --> 00:00:20,590
.إنّكِ مُحقّة

4
00:00:21,520 --> 00:00:24,560
!يوري! يوري! لقد لمحتُ اليابسة

5
00:00:32,880 --> 00:00:35,320
!إنني أتطلّع للتجوّل في أنحاء البلدة

6
00:00:35,320 --> 00:00:37,520
!لا أُطيق الانتظار

7
00:00:37,520 --> 00:00:39,420
.أتساءل أيّ نوع من الأماكن هي

8
00:00:39,420 --> 00:00:40,780
كفاكِ شغبًا

9
00:00:40,780 --> 00:00:43,900
.بهذا المد، ينبغي أن نصل خلال ساعة

10
00:00:45,760 --> 00:00:50,840
...أوّل بلدة نزورها أنا وزيرا بعد مُغادرتنا تينروجيما

11
00:00:50,840 --> 00:00:54,090
.إنّها بلدة الميناء هاليجيون

12
00:02:34,340 --> 00:02:36,080
ما الذي تفعله؟

13
00:02:36,640 --> 00:02:38,740
.أربط ما يُسمّى بعقدة الكرسي

14
00:02:38,740 --> 00:02:40,400
عقدة الكرسي؟

15
00:02:40,400 --> 00:02:42,340
حسنًا، أصنعُ حلقةً

16
00:02:42,340 --> 00:02:45,340
.ثُمّ أشدّها لكي لا تنجرف السفينة بعيدًا

17
00:02:45,340 --> 00:02:48,560
.هكذا إذن، إنّكَ جيّدٌ في ذلك

18
00:02:48,560 --> 00:02:51,880
،لم أقرأ أيّ كتابٍ عن السُفن

19
00:02:51,880 --> 00:02:53,600
.لذا لا أعلم أيَّ شيءٍ عنهم

20
00:02:54,700 --> 00:02:56,260
أيُمكنكَ فعل ذلك أيضًا يا يوري؟

21
00:02:56,260 --> 00:02:57,120
!لا تسألي

22
00:02:57,120 --> 00:02:59,350
.حسنًا، كما سمعتِ

23
00:03:00,160 --> 00:03:02,180
لِمَ لا يُمكنني سؤاله؟

24
00:03:02,180 --> 00:03:04,000
.هذا يعني أنّهُ لا يستطيع

25
00:03:04,000 --> 00:03:05,860
...آه، لا يُمكنك فعلها

26
00:03:08,320 --> 00:03:09,570
.على كُلٍ، فلننزل

27
00:03:18,880 --> 00:03:20,620
!أنا الأولى

28
00:03:31,180 --> 00:03:35,320
!مرحبًا! مرحبًا! فواكه طازجة، مقطوفة مُباشرة من الشجرة

29
00:03:35,320 --> 00:03:37,930
!أشتروها الآن! من يشتري أولًا هو الرابح

30
00:03:42,340 --> 00:03:44,110
...هذه هي البلدة

31
00:03:44,110 --> 00:03:46,800
!أوّل بلدة حديثة أراها

32
00:03:48,780 --> 00:03:51,720
.إنّكِ تُعرقلين الصف

33
00:03:51,720 --> 00:03:53,720
!آسفة

34
00:03:54,920 --> 00:03:56,700
.سأُخبرُكِ شيئًا واحدًا

35
00:03:56,700 --> 00:03:58,000
وما هو؟

36
00:03:58,000 --> 00:04:00,000
.أنتِ لستِ أوّل من ينزل من السفينة

37
00:04:00,450 --> 00:04:02,580
هو من نزل أولًّا، صحيح؟

38
00:04:08,600 --> 00:04:10,300
.أوه، هذا صحيح

39
00:04:33,580 --> 00:04:34,760
!هذا مُذهل

40
00:04:34,760 --> 00:04:36,490
...إنّها مُزدحمة جدًا

41
00:04:37,060 --> 00:04:38,950
!انظري! إنّهُ صيّاد سمك

42
00:04:39,480 --> 00:04:41,640
.أتساءل ما إن كان جيّدًا في صيّد السمك

43
00:04:46,260 --> 00:04:48,000
!لم أرى هذا من قبل

44
00:04:49,720 --> 00:04:52,080
!لكنّ رائحته نتنة

45
00:04:53,260 --> 00:04:56,010
!انظري لهذا يا زيرا! إنّهُا جميلة جدًا

46
00:04:56,460 --> 00:04:58,580
!سيغضب عليكِ لارتدائكِ إيّاه دون إذن

47
00:04:59,900 --> 00:05:01,270
!يا لرائحتهم الزكيّة

48
00:05:01,860 --> 00:05:04,380
.لم أرى هذه الزهور سوى في كتاب الصور

49
00:05:05,700 --> 00:05:08,270
!جميل! كما لو أنّها جواهر

50
00:05:08,800 --> 00:05:10,720
أكُل هذه حلويّات؟

51
00:05:10,720 --> 00:05:13,600
عجبًا عجبًا! ألم تريهم من قبل؟

52
00:05:13,600 --> 00:05:16,280
.أجل، كُلّها منزليّة الصنع

53
00:05:16,760 --> 00:05:18,280
.خُذي جرّبي واحدة

54
00:05:18,840 --> 00:05:19,880
ألا بأس بذلك؟

55
00:05:19,880 --> 00:05:21,540
.أجل، لا بأس، لا بأس

56
00:05:24,600 --> 00:05:25,540
!إنّها لذيذة

57
00:05:26,100 --> 00:05:29,560
!إنّها المرّة الأولى التي يتذوّق بها لساني مثل هذا المذاق والشعور

58
00:05:29,560 --> 00:05:31,560
!إنّهُ مُذهل

59
00:05:31,560 --> 00:05:33,010
!زيرا! زيرا

60
00:05:33,520 --> 00:05:34,900
!جرّبي واحدة

61
00:05:34,900 --> 00:05:36,600
.لا أُريد

62
00:05:36,600 --> 00:05:37,360
هاه؟

63
00:05:37,360 --> 00:05:39,300
.أُفضّل أخذ قسط من الراحة بأسرع وقت ممكن بدلًا من ذلك

64
00:05:40,840 --> 00:05:43,300
لا شيء يُعجبكِ، صحيح؟

65
00:05:43,300 --> 00:05:45,810
.بعد كُل شيء، إننا نقرأ عن كُل هذه الأمور في الكُتب

66
00:05:45,810 --> 00:05:49,240
!لا يُمكنكِ التعرّف على العالم بأسره من خلال الكُتب وحسب

67
00:05:49,240 --> 00:05:51,820
!عليكِ أن تري، تلمسي، وتشعري

68
00:05:52,320 --> 00:05:55,460
...إنها ليست إلّا فتاةً ريفيّة

69
00:05:55,460 --> 00:05:58,440
أهذه مرّتها الأولى التي تخرج فيها من الجزيرة حقًا؟

70
00:05:59,480 --> 00:06:00,530
.أنا مُندهش

71
00:06:00,530 --> 00:06:01,860
!يوري

72
00:06:02,500 --> 00:06:04,830
!زيرا وجدت مكانًا نُقيم فيه

73
00:06:07,330 --> 00:06:12,040
.هذا صحيح، سوف نبقى هُنا لبضعة أيّام على الأرجح

74
00:06:12,980 --> 00:06:14,900
ما الخطب يا بريشيتُ؟

75
00:06:15,440 --> 00:06:18,340
.نحن في رحلةٍ برفقة طفلةٍ غير موثوق بها

76
00:06:18,340 --> 00:06:19,090
!أوي

77
00:06:19,700 --> 00:06:23,160
.سأجمع المعلومات عن بلو سكول في المدينة

78
00:06:23,760 --> 00:06:25,350
.سأذهب للنُزل لاحقًا

79
00:06:25,820 --> 00:06:27,480
!إذن فسوف آتي معك

80
00:06:29,060 --> 00:06:33,070
.فبعد كُل شيء، لم أحظى بفرصة حقيقيّة للتحدّث معك بعد يا بريشيتُ

81
00:06:34,800 --> 00:06:35,900
.افعلي ما شئتِ

82
00:06:37,040 --> 00:06:39,360
!زيرا، انتظريني في النُزل

83
00:06:39,360 --> 00:06:40,570
!مايفيسُ

84
00:06:40,570 --> 00:06:42,500
!أراكِ لاحقًا يا زيرا

85
00:06:43,520 --> 00:06:44,880
...يا إلهي

86
00:06:44,880 --> 00:06:48,870
!نظرات ذلك الشخص لا تروقني! توخّي الحذر

87
00:06:51,820 --> 00:06:52,750
ما هذا؟

88
00:06:55,940 --> 00:06:58,550
.انظر! يبدو ذلك مُثيرًا للاهتمام

89
00:07:01,600 --> 00:07:03,140
!وجدتُ شيئًا ظريفًا

90
00:07:06,320 --> 00:07:08,740
!نيه، يبدو ذلك لذيذًا

91
00:07:12,440 --> 00:07:14,420
!انتظرني

92
00:07:16,640 --> 00:07:17,980
إنّكَ هادئ، صحيح؟

93
00:07:19,340 --> 00:07:21,450
هل تُفضّل الصمت؟

94
00:07:22,520 --> 00:07:25,160
.ليس لديّ ما أقولهُ لكِ وحسب

95
00:07:25,680 --> 00:07:27,330
هكذا إذن؟

96
00:07:27,330 --> 00:07:29,460
!شُكرًا لإخباري

97
00:07:31,140 --> 00:07:34,980
.ولكن ليس هنالك حاجة لأن تكون بهذه الجديّة

98
00:07:34,980 --> 00:07:38,210
.إنني لا أعرف هذه البلدة، أنتَ تعرفها

99
00:07:38,800 --> 00:07:43,720
.لذا كُل ما عليك فعله هو الإجابة عن أسئلتي

100
00:07:44,260 --> 00:07:46,460
،بتلك الطريقة، يُمكنني التعلّم

101
00:07:46,460 --> 00:07:50,480
.وأنتَ تُجيب من معرفتك وحسب

102
00:07:57,560 --> 00:07:58,190
إلى أين تذهب؟

103
00:07:58,190 --> 00:08:00,760
.أنا لستُ مُرشدُكِ

104
00:08:00,760 --> 00:08:02,760
.أتيتُ إلى هُنا لجمع المعلومات

105
00:08:03,080 --> 00:08:05,240
.لذا فأنا ذاهبٌ لمكانٍ به الكثير من الناس

106
00:08:05,680 --> 00:08:08,740
!أجل! كُل ما عليك فعله هو الإجابة بتلك الطريقة

107
00:08:28,500 --> 00:08:29,770
!انتظرني

108
00:08:33,900 --> 00:08:34,770
!وهذا ما حصل

109
00:08:42,960 --> 00:08:45,440
...يوجد الكثير من الناس هُنا حقًا

110
00:08:59,200 --> 00:09:01,320
أتعرف شيئًا عن بلو سكول؟

111
00:09:11,200 --> 00:09:12,840
لقد هرب إذن؟

112
00:09:16,340 --> 00:09:16,900
.أوي

113
00:09:17,560 --> 00:09:18,820
...هل تعلمون

114
00:09:18,820 --> 00:09:19,700
...شيئًا عن...

115
00:09:20,080 --> 00:09:20,650
بلو سكول؟...

116
00:09:25,800 --> 00:09:26,880
لماذا؟

117
00:09:32,060 --> 00:09:35,120
هل بلو سكول مُخيفة لهذه الدرجة؟

118
00:09:35,700 --> 00:09:39,240
.أظُن أنّ المُخيف هو أنتَ يا بريشيت

119
00:09:39,240 --> 00:09:39,920
ماذا؟

120
00:09:40,540 --> 00:09:41,820
!لماذا؟

121
00:09:41,820 --> 00:09:43,420
.إنّكَ... قريبٌ جدًا

122
00:10:10,620 --> 00:10:13,380
!أنا خائف! أنا خائف

123
00:10:13,660 --> 00:10:15,260
ماذا؟

124
00:10:15,260 --> 00:10:17,940
لِمَ قطعت تلك الشجرة فجأة؟

125
00:10:17,940 --> 00:10:18,960
...حسنًا

126
00:10:18,960 --> 00:10:21,060
!أوي! ما الذي حدث؟

127
00:10:21,060 --> 00:10:22,500
!أحدهم قطع تلك الشجرة

128
00:10:22,500 --> 00:10:23,960
!هل ذلك الرجل هو من فعلها؟

129
00:10:33,720 --> 00:10:36,380
.مسمار تلك العجلة مُنحل

130
00:10:42,640 --> 00:10:45,480
!أوي! ما الذي تُفكّر به؟

131
00:10:45,480 --> 00:10:47,100
...حسنًا، عجلتُك

132
00:10:47,100 --> 00:10:49,200
!هاه؟ ماذا بشأن عجلتي؟

133
00:10:50,600 --> 00:10:53,800
.مسمار تلك العجلة مُنحل

134
00:10:54,560 --> 00:10:55,840
.أوي، إنّهما مُحقّان

135
00:10:55,840 --> 00:10:56,500
!ماذا؟

136
00:10:56,500 --> 00:10:59,040
!هذا خطير! من الأفضل أن تُصلحه على الفور

137
00:11:02,180 --> 00:11:04,040
!من الجيّد أنّك لمحته! لنذهب

138
00:11:09,580 --> 00:11:10,660
...آنوو

139
00:11:11,960 --> 00:11:13,480
هل أنتَ بخير؟

140
00:11:13,480 --> 00:11:15,350
...وقفتَ فجأةً أمام تلك العربة

141
00:11:15,350 --> 00:11:18,480
.فكّرتُ أنّك قد تكون مريضًا

142
00:11:18,480 --> 00:11:19,640
.أنا بخير

143
00:11:24,540 --> 00:11:25,380
!حذارِ

144
00:11:35,620 --> 00:11:37,370
!ما الذي تفعله؟

145
00:11:40,140 --> 00:11:41,660
!...إنّك مُنحرفٌ حقًا

146
00:11:41,660 --> 00:11:42,700
!أوي، أوي

147
00:11:43,170 --> 00:11:46,170
!ما الذي تفعله؟

148
00:11:46,170 --> 00:11:49,540
!أُراهن أنّك تُحاول إيقاعي في حادثٍ حقًا

149
00:11:49,940 --> 00:11:52,220
...مُخطئ، لقد كُنتُ

150
00:12:05,940 --> 00:12:08,900
.أنتَ تجذب الانتباه حقًّا

151
00:12:08,900 --> 00:12:11,360
...بشكلٍ سلبي

152
00:12:12,000 --> 00:12:13,200
.هذا يحدث دائمًا

153
00:12:14,640 --> 00:12:17,140
.لا تجعل ذلك يُزعجك

154
00:12:17,140 --> 00:12:19,720
.لم تقم بشيءٍ خاطئ

155
00:12:19,720 --> 00:12:22,210
.توقّفي، لستُ بحاجةٍ لشفقتكِ

156
00:12:22,210 --> 00:12:24,580
!إنّها ليست شفقة

157
00:12:24,580 --> 00:12:27,210
!إنني أقول ما أشعر به وحسب

158
00:12:28,680 --> 00:12:31,210
.إنّك أخرقٌ اجتماعيًا، مما يجعل الناس يُسيئون فهمك

159
00:12:31,780 --> 00:12:34,560
.ولكنّ الحقيقة أنّك أنقى من أي أحد آخر

160
00:12:34,560 --> 00:12:38,970
.وبسبب ذلك، إنّك تقوم بأمورٍ خطيرة نوعًا ما

161
00:12:38,970 --> 00:12:42,660
،ورغم ذلك، إنّك تتصرف عن قناعة

162
00:12:42,660 --> 00:12:45,980
.مُختارًا أن تفعل ما تراه صحيحًا وحسب

163
00:12:47,480 --> 00:12:50,120
،إن كانت تلك القناعة لا تجعلك تشعر بالخجل

164
00:12:50,120 --> 00:12:52,320
.فينبغي أن تسير ورأسُكَ مرفوع

165
00:12:53,740 --> 00:12:57,320
.قرأتُ ذلك في كتابٍ عن تقييم الشخصيّة

166
00:12:57,320 --> 00:13:00,740
.تذكّرتُ كلّ ذلك بالنّظر إليك

167
00:13:07,750 --> 00:13:09,800
...آره؟ إنّهُ ذلك الفتى

168
00:13:11,180 --> 00:13:12,760
.كُنتُ أبحث عنك يا سيّدي

169
00:13:14,240 --> 00:13:17,010
.تلك الشّجرة فاسدة من الدّاخل

170
00:13:17,800 --> 00:13:20,820
لقد أنقذتني، صحيح؟

171
00:13:20,820 --> 00:13:22,460
!شُكرًا لك

172
00:13:22,460 --> 00:13:25,270
...فهمت، لقد كانت متُعفّنة كما توقّعت

173
00:13:25,880 --> 00:13:28,560
.أجل، أحد البالغين الذين كانوا بالقرب أخبرني

174
00:13:28,560 --> 00:13:31,530
.آسفة، لقد كُنتُ وقحةً معك

175
00:13:33,880 --> 00:13:36,030
...انتظر رجاءً. أودُ أن أُظهر امتناني

176
00:13:36,720 --> 00:13:38,480
.لستُ بحاجةٍ لامتنانكِ

177
00:13:38,480 --> 00:13:42,040
...في الحقيقة، نحن نبحث عن نقابة

178
00:13:42,040 --> 00:13:43,520
نقابة؟

179
00:13:44,680 --> 00:13:49,980
.ثمّةَ حانةٌ على طرف البلدة، لعلّها تكون فكرة جيّدة أن تسأل هناك عن نقابة

180
00:13:49,980 --> 00:13:52,400
كيف عرفتَ ذلك؟

181
00:13:52,400 --> 00:13:54,050
.سمعتُ ذاك العجوز يتحدّث

182
00:13:54,520 --> 00:13:57,480
.قال أنّ المنبوذين فقط من يتجمّعون هناك

183
00:13:57,480 --> 00:14:01,160
.وأنّ مالك الحانة يعرف العديد من النّاس، لكنّه غريب

184
00:14:02,510 --> 00:14:05,080
.يبدو أنّ تفقدها يستحق العناء

185
00:14:05,080 --> 00:14:06,140
.أجل

186
00:14:07,540 --> 00:14:09,120
!شُكرًا لكما

187
00:14:10,160 --> 00:14:22,170
ناروتو الزعيم

188
00:14:10,160 --> 00:14:22,170
TiME &COC: M-ENC

189
00:15:04,220 --> 00:15:07,480
بريشيتُ... هذه هي الحانة إذن؟

190
00:15:07,480 --> 00:15:09,320
.لها رائحة فريدة

191
00:15:09,320 --> 00:15:11,020
ما هذه الراحة؟

192
00:15:12,720 --> 00:15:14,530
ما الذي تُريدينه أيّتها الصغيرة؟

193
00:15:15,780 --> 00:15:16,780
.لا شيء

194
00:15:19,120 --> 00:15:23,040
.أتعلم يا أخي، هذا المكان ليس للأطفال

195
00:15:24,460 --> 00:15:28,040
.لكننا نُريد التحدّث مع المالك وحسب

196
00:15:28,040 --> 00:15:31,280
.لقد سمعتها أيّها المالك، إنّهما يُريدانك

197
00:15:32,050 --> 00:15:34,050
ومن تكون أنت؟

198
00:15:34,520 --> 00:15:37,160
.أنا بريشيتُ، صائد كنوز

199
00:15:38,380 --> 00:15:41,300
ما الذي يفعله نابش قبور في مكانٍ كهذا؟

200
00:15:41,760 --> 00:15:44,260
،لكن إن كُنتَ تُريد الحديث وحسب

201
00:15:44,260 --> 00:15:45,660
...بطبيعة الحال

202
00:15:46,740 --> 00:15:48,150
.سأطلب الشراب

203
00:15:48,880 --> 00:15:50,200
معه قطع ثلج، صحيح؟

204
00:15:50,200 --> 00:15:51,320
.أجل

205
00:15:51,320 --> 00:15:54,110
.أتيتُ لأنني سمعتُ أنّك تعرف الكثير من الأشخاص

206
00:15:54,110 --> 00:15:57,180
.حسنًا، هذا هو عملي

207
00:15:57,180 --> 00:15:58,160
.بطبيعة الحال

208
00:15:58,740 --> 00:16:01,120
.نحن نبحث عن بلو سكول

209
00:16:01,880 --> 00:16:03,120
أتعرفهم؟

210
00:16:04,300 --> 00:16:05,940
بلو سكول؟

211
00:16:05,940 --> 00:16:09,920
.كلا، لم أسمع عن نقابةٍ كتلك في هذه الأنحاء

212
00:16:09,920 --> 00:16:11,100
.بطبيعة الحال

213
00:16:12,420 --> 00:16:15,500
.أيّ شيءٍ سيفي بالغرض، أريد معلومات

214
00:16:15,500 --> 00:16:16,920
.اسأل في مكانٍ آخر

215
00:16:17,500 --> 00:16:20,890
.ظننتُ أنّها نقابةٌ معروفة

216
00:16:20,890 --> 00:16:25,440
ظهرت العديد من النقابات السحريّة مؤخرًا لدرجة عدم مقدرتي على تذكرهم كلهم‏.‏

217
00:16:25,440 --> 00:16:26,560
.بطبيعة الحال

218
00:16:28,740 --> 00:16:30,150
أتُريدين كأسًا من الحليب أيّتها الصغيرة؟

219
00:16:30,780 --> 00:16:32,900
.كلا، ما أُريده هو المعلومات

220
00:16:32,900 --> 00:16:36,150
.فلتُغادر إذن يا جليس الأطفال

221
00:16:37,180 --> 00:16:40,660
...لا تنسى أن تترك الدمية، بطبيعة الحال

222
00:16:49,480 --> 00:16:50,800
.سأتفقدّ مكانًا آخر

223
00:16:50,800 --> 00:16:52,060
.مهلًا

224
00:16:52,420 --> 00:16:56,420
كيف عرفت أنّ بلو سكول نقابة سحريّة؟

225
00:16:57,480 --> 00:17:00,900
،هناك نقابات مقاتلة ونقابات تجارية

226
00:17:00,900 --> 00:17:04,220
،ونقابات صناعية وغيرها الكثير، لكن من بينها جميعًا

227
00:17:04,820 --> 00:17:08,480
.قلتَ أن بلو سكول نقابة سحرية

228
00:17:11,000 --> 00:17:13,800
في الحقيقة، أنتَ تعرفها، أليس كذلك؟

229
00:17:13,800 --> 00:17:15,800
...كلا، هذا ليس

230
00:17:40,340 --> 00:17:41,090
!وغد

231
00:17:43,580 --> 00:17:44,850
ما معنى هذا؟

232
00:17:45,120 --> 00:17:49,060
!تبًا! إنّهُ رجلٌ وحيّد! عليكم به

233
00:18:40,620 --> 00:18:41,820
!مُذهل

234
00:18:42,260 --> 00:18:44,160
.إنني أرقص مع الأنصال

235
00:18:44,160 --> 00:18:45,820
.أتحكّم بهم بالكامل

236
00:18:56,920 --> 00:18:59,340
...أتظُن أنّ مُجرّد صائد كنوز حقير

237
00:19:09,180 --> 00:19:11,180
يُمكنه هزيمة ساحر؟...

238
00:19:15,960 --> 00:19:17,190
!دائرة سحريّة

239
00:19:24,460 --> 00:19:26,990
!ذلك هو شعار بلو سكول

240
00:19:27,460 --> 00:19:30,840
إذن فهذا الشخص عضوٌ في بلو سكول؟

241
00:19:31,420 --> 00:19:31,990
!أيّها الوغد

242
00:19:32,900 --> 00:19:35,250
.أووتو، من الأفضل ألّا تتحرّك

243
00:19:39,340 --> 00:19:43,540
.بطبيعة الحال، إن خطوتَ خارج الدائرة السحريّة، فسوف تتحوّل إلى أشلاء

244
00:19:45,100 --> 00:19:47,380
.بلو سكول نقابةُ ظلام

245
00:19:48,000 --> 00:19:50,510
.بطبيعة الحال، نحن لا نحصل على طلبات أعمال رسميّة

246
00:19:51,340 --> 00:19:58,600
لهذا السّبب كان على شخصٍ ما أن يجمع معلوماتٍ
.خطيرة في هذه الحانة المحليّة، بطبيعة الحال

247
00:20:00,840 --> 00:20:03,840
.وبالطبيعة الحال، ذلك الشخص كان أنا

248
00:20:03,840 --> 00:20:05,320
!إذن فأنتَ تابع؟

249
00:20:06,020 --> 00:20:06,840
!بطبيعة الحال

250
00:20:06,840 --> 00:20:09,780
!كلّا... لا تُحرّف كلامي أيّها الوغد

251
00:20:10,400 --> 00:20:13,520
إذن ما الذي تفعلينه؟

252
00:20:14,880 --> 00:20:16,580
.هذا الحرف خاطئ

253
00:20:17,960 --> 00:20:22,540
...أظنّه حقلٌ ذو قوى سحريّة مكتوبٌ أساسًا بالحروف الرازونية

254
00:20:23,160 --> 00:20:25,090
.لكنّ حروف روغ مستعملةٌ هنا وحسب...

255
00:20:25,820 --> 00:20:27,050
إنّها تبدو مماثلة، أليس كذلك؟

256
00:20:28,380 --> 00:20:29,000
...بمعنى آخر

257
00:20:29,000 --> 00:20:29,760
!أوي! توقّفي

258
00:20:29,760 --> 00:20:32,510
!هذه الدائرة السحريّة لا تعمل...

259
00:20:33,180 --> 00:20:35,920
!خطوتُ خارج الدائرة ولم يحدث شيء

260
00:20:37,480 --> 00:20:39,020
!من تكونين أنتِ؟

261
00:20:39,620 --> 00:20:42,270
!ويُمكنني استخدام السحر أيضًا

262
00:20:43,620 --> 00:20:44,980
أتقولين السحر؟

263
00:20:44,980 --> 00:20:47,380
.درستُ لسبع سنوات

264
00:20:47,820 --> 00:20:50,530
!بطبيعة الحال، يُمكنني استخدام السحر هكذا

265
00:20:51,440 --> 00:20:52,740
!اظهر

266
00:20:52,740 --> 00:20:56,440
!يا أيّها الوحش الحارس المُقدّس، النازل من سلالم السماء

267
00:21:04,160 --> 00:21:05,420
!تينرو

268
00:21:18,640 --> 00:21:21,840
أين هو مقر بلو سكول؟

269
00:21:22,460 --> 00:21:24,300
.أخبرني رجاءً

270
00:21:29,570 --> 00:21:31,680
!حـ-حسنًا

271
00:21:37,580 --> 00:21:39,080
!أتقولين كان وهمًا؟

272
00:21:39,080 --> 00:21:40,440
!هذا صحيح

273
00:21:40,440 --> 00:21:44,080
إذن فذلك الذئب العملاق كان خُدعة؟

274
00:21:44,080 --> 00:21:46,090
!هذا هو سحري

275
00:21:49,600 --> 00:21:51,920
،بين هذا السحر وأنصالك

276
00:21:51,920 --> 00:21:55,460
.أنا واثقة من أننا سنكون قادرين على استعادة يشم تينرو من بلو سكول

277
00:22:00,260 --> 00:22:03,000
!في البلدة الواقعة غربًا، ماغنوليا

278
00:22:04,500 --> 00:22:06,640
!علينا إخبار الآخرين

279
00:22:07,280 --> 00:22:08,860
.إن ركضتِ هكذا فستقعين

280
00:22:15,400 --> 00:22:16,620
!مؤلم

281
00:22:17,080 --> 00:22:18,500
!لقد حذّرتُكِ

282
00:22:18,500 --> 00:22:19,880
.أنّك ستقعين

283
00:22:20,260 --> 00:22:22,460
!لم أسمعك

284
00:23:57,500 --> 00:24:01,180
في الطريق لماغنوليا، مايفيس والآخرون

285
00:24:01,180 --> 00:24:04,120
!يقضون ليلتهم في الغابة

286
00:24:04,540 --> 00:24:11,640
.يوري وبريشت ووارود يتحدّثون إلى مايفيس إلى جانب بحيرةٍ غامضة

287
00:24:11,640 --> 00:24:14,220
،يشاركونها حكاية مغامرةٍ من الماضي

288
00:24:14,780 --> 00:24:17,820
.حكايةٌ تستعرض قوّة رابطتهم

289
00:24:18,680 --> 00:24:20,910
.الحلقة القادمة: البحيرة المقمرة

290
00:24:21,800 --> 00:24:24,620
.الصّداقة قويّة ولطيفة