148
00:10:17,300 --> 00:10:18,620
!أنهي دوري

149
00:10:18,620 --> 00:10:20,080
فهمت

150
00:10:20,080 --> 00:10:23,520
ليفايثان تابعٌ قويّ بالفعل

151
00:10:23,520 --> 00:10:26,890
لكنّه ليس ندّاً لقوّة تعزيز السحر

152
00:10:26,890 --> 00:10:28,990
!ألعب عاصفة الريح

153
00:10:36,600 --> 00:10:39,760
بطاقة سحر واحدة دمّرت ليفايثان؟

154
00:10:39,760 --> 00:10:44,410
كلّ تعزيز سحر يحسّن قوة عاصفة الريح

155
00:10:44,410 --> 00:10:45,410
مُذهل

156
00:10:45,410 --> 00:10:47,670
لم أنته بعد

157
00:10:47,670 --> 00:10:51,320
!أهاجم قائدك بكلّ أتباعي

158
00:10:51,630 --> 00:10:52,510
!ماذا؟

159
00:10:59,300 --> 00:11:00,070
!هيرو

160
00:11:00,070 --> 00:11:00,810
!هيرو-كن

161
00:11:03,020 --> 00:11:05,050
أنهي دوري

162
00:11:09,130 --> 00:11:11,200
أهذا كلّ ما لديك؟

163
00:11:13,920 --> 00:11:16,010
!بالطبع لا

164
00:11:33,080 --> 00:11:36,340
!يمكنني تخطّي أي مأزق

165
00:11:42,560 --> 00:11:43,800
سبع نقاط لعب؟

166
00:11:43,800 --> 00:11:46,310
إنّه في حالة فيض؟

167
00:11:46,310 --> 00:11:47,300
!أجل

168
00:11:47,300 --> 00:11:49,430
!هنا تظهر قوّة فئة التنانين

169
00:11:49,430 --> 00:11:50,350
!ها أنا ذا

170
00:11:50,350 --> 00:11:51,690
!ألعب أجنحة التنّين

171
00:11:56,430 --> 00:11:59,310
!تُعطي ضرر 1 لكلّ الأتباع

172
00:12:02,700 --> 00:12:05,640
!ثمّ ألعب تنّين البحر من يدي

173
00:12:07,580 --> 00:12:10,740
!لهذا التابع عاصفة في حالة الفيض

174
00:12:11,500 --> 00:12:13,140
!ثمّ أطوّره

175
00:12:16,890 --> 00:12:18,900
انطلق

176
00:12:18,900 --> 00:12:20,290
!يا تنّين البحر

177
00:12:27,880 --> 00:12:30,880
!هذا ما يجعل شادوفيرس مُثيرة

178
00:12:31,500 --> 00:12:33,350
سأقبل ذلك

179
00:12:33,350 --> 00:12:36,350
أنتَ ريوغاساكي هيرو حقاً

180
00:12:36,650 --> 00:12:38,890
كنت لا تزال تشكّ في ذلك؟

181
00:12:38,890 --> 00:12:42,430
!لكن لا أستطيع تصوّر هزيمتك ليونازوكي لوشيا

182
00:12:43,410 --> 00:12:45,740
ألعب خزينة السحر

183
00:12:45,740 --> 00:12:49,400
أعزز سحر إحدى البطاقات في يدي وأسحب بطاقة واحدة

184
00:12:49,400 --> 00:12:51,440
ثمّ ألعب استحضار الغواليم

185
00:12:51,440 --> 00:12:53,300
تصنع غولماً طينياً

186
00:12:53,310 --> 00:12:56,210
ثمّ ألعب عناق النار

187
00:12:56,210 --> 00:12:58,450
!وأدمّر تنّين البحر

188
00:12:58,450 --> 00:13:02,580
