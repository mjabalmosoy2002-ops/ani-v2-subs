!أطوّر الجنرال الأبيض

219
00:12:36,700 --> 00:12:38,270
ليس هذا كلّ شيء

220
00:12:38,270 --> 00:12:40,890
!يتفعّل تأثير فارس الراية الجسور

221
00:12:40,890 --> 00:12:44,460
!عندما يتطوّر تابع آخر، يستدعي فارساً

222
00:12:44,460 --> 00:12:45,980
!مـ-مذهل

223
00:12:45,980 --> 00:12:49,550
!أهاجم تنّين العاصفة الرملية بالجنرال الأبيض

224
00:12:49,550 --> 00:12:51,860
!وأهاجم تنّينك البكر بفارسي

225
00:12:53,060 --> 00:12:54,400
!أنهي دوري

226
00:12:54,940 --> 00:12:56,640
عودة رائعة، ألا تتفق؟

227
00:12:56,640 --> 00:12:57,870
!بلى

228
00:12:58,180 --> 00:13:01,680
!لكن... لا تزال المعركة في بدايتها

229
00:13:02,190 --> 00:13:04,580
!زمجر أيّها التنّين العاجي

230
00:13:11,460 --> 00:13:13,840
!انطلق

231
00:13:19,530 --> 00:13:21,680
كنتُ أعرف أنّ ذلك قادم

232
00:13:21,680 --> 00:13:24,580
!أجل، آمنت أنّي سأسحبه

233
00:13:24,580 --> 00:13:25,960
!أنهي دوري

234
00:13:26,940 --> 00:13:28,320
جيّد يا هيرو

235
00:13:28,320 --> 00:13:29,280
...لكن

236
00:13:29,280 --> 00:13:32,780
!لا أجيد الاستسلام مثلك تماماً

237
00:13:33,010 --> 00:13:35,420
!دوري! سحب

238
00:13:47,020 --> 00:13:48,600
...إ-إنّه

239
00:13:48,600 --> 00:13:51,420
!ورقتي الرابحة، السيّاف المنتصر

240
00:13:51,420 --> 00:13:54,230
!فلترَ ما يمكنه فعله الآن

241
00:13:58,590 --> 00:13:59,900
ماذا؟

242
00:13:59,900 --> 00:14:05,350
يمكن للسيّف المُنتصر تقليص ضرر
!أحد الأتباع أو القائد بمقدار 3

243
00:14:06,310 --> 00:14:09,440
...إضافةً لذلك، حتّى نهاية دورك التالي

244
00:14:09,440 --> 00:14:12,950
!أيّ ضرر يتلقاه يتقلّص بمقدار 3 أيضاً

245
00:14:13,310 --> 00:14:14,370
صدقاً؟

246
00:14:14,620 --> 00:14:15,890
!مذهل

247
00:14:15,890 --> 00:14:16,690
!جميل

248
00:14:16,690 --> 00:14:18,140
!رائع

249
00:14:18,370 --> 00:14:20,130
مذهل يا كازوكي

250
00:14:20,130 --> 00:14:20,930
ربما

251
00:14:20,930 --> 00:14:23,000
لكنّ هذا بفضلك

252
00:14:23,000 --> 00:14:25,230
أستمتع عندما أواجهك

253
00:14:25,230 --> 00:14:27,630
!فأشعر أنّ بإمكاني مواصلة التحسّن

254
00:14:28,050 --> 00:14:29,150
...كازوكي

255
00:14:29,150 --> 00:14:31,380
!أنهي دوري الآن

256
00:14:31,380 --> 00:14:33,260
!هات ما لديك يا هيرو

257
00:14:33,260 --> 00:14:35,350
!أجل، دوري

258
00:14:35,350 --> 00:14:36,150
!سحب

259
00:14:43,250 --> 00:14:44,940
عظاءة النار؟

260
00:14:44,940 --> 00:14:48,530
تُعطي ضرر 1 لتابع للخصم

261
00:14:48,840 --> 00:14:53,270
لكن أيّ ضرر يتلقاه حتّى نهاية دوري
يتقلّص بمقدار 3

262
00:14:53,560 --> 00:14:55,770
...ما يعني أنّ الآن ليس الوقت المناسب

263
00:14:55,770 --> 00:14:57,780
!ألعب تابعين

264
00:14:58,050 --> 00:15:00,370
!رخّ! وملكة الأفاعي

265
00:15:02,300 --> 00:15:05,150
!يتفعّل تأثير فيض ملكة الأفاعي

266
00:15:05,150 --> 00:15:06,620
!يستدعي ميغالوركا واحد

267
00:15:08,540 --> 00:15:09,770
!فيض

268
00:15:09,770 --> 00:15:11,610
!فئة التنانين مذهلة

269
00:15:11,610 --> 00:15:15,920
!أهاجم قائدك بالتنّين العاجي لعشر نقاط ضرر

270
00:15:18,190 --> 00:15:19,320
ماذا؟

271
00:15:19,320 --> 00:15:23,500
يقلّصه تأثير الفارس المُنتصر بمقدار 3، أنسيت؟

272
00:15:24,550 --> 00:15:27,820
!كما يُعطي ضرر 3 لكلّ أتباع الخصم

273
00:15:28,240 --> 00:15:29,690
!الفارس المُنتصر

274
00:15:31,500 --> 00:15:34,450
!أقلّص الضرر بثلاثة فلا فائدة

275
00:15:35,460 --> 00:15:36,620
!قويّ

276
00:15:36,620 --> 00:15:37,830
أنهي دوري

277
00:15:37,830 --> 00:15:39,830
!كازوكي-كن مُبهر

278
00:15:39,830 --> 00:15:42,250
هاجمه هيرو-كن بشدّة

279
00:15:42,250 --> 00:15:45,160
الفارس المُنتصر بطاقة عنيدة

280
00:15:45,420 --> 00:15:51,610
انتهى دورك، فزالت قدرة الفارس المنتصر
بتقليص الضرر له بمقدار 3

281
00:15:52,080 --> 00:15:56,600
!لكنّ قدرته بحماية الأتباع وقائده تبقى

282
00:15:56,900 --> 00:16:00,050
!أعتمد عليك يا جنرال حرس المقدمة

283
00:16:01,210 --> 00:16:03,260
تابع بحاجز؟

284
00:16:03,260 --> 00:16:04,110
!أجل

285
00:16:04,110 --> 00:16:06,160
!لكنّ هذا ليس كلّ شيء

286
00:16:06,160 --> 00:16:11,170
!عندما يتدمر، يستدعي حارس قلعة

287
00:16:11,540 --> 00:16:12,980
كلمات أخيرة؟

288
00:16:13,260 --> 00:16:15,490
لدى حارس القلعة حاجز أيضاً

289
00:16:15,490 --> 00:16:18,230
!مما يجعل دفاعه منيعاً

290
00:16:18,450 --> 00:16:21,040
،ولن أكتفي بالدفاع

291
00:16:21,040 --> 00:16:22,560
!بل سأهاجم بهذا

292
00:16:23,150 --> 00:16:25,160
!قنطور الطليعة

293
00:16:31,840 --> 00:16:35,880
عندما يكون لديك قائد، يحصل على عاصفة

294
00:16:36,240 --> 00:16:41,080
!أهاجم قائدك بقنطور الطليعة والفارس المنتصر

295
00:16:44,020 --> 00:16:45,400
!أنهي دوري

296
00:16:45,400 --> 00:16:49,360
هيرو، هذه قوّتي الكاملة الفائقة
!والتي تتجاوز قوّتي الكاملة

297
00:16:51,300 --> 00:16:52,800
!أخي

298
00:16:52,800 --> 00:16:54,250
!أنت رائع

299
00:16:54,250 --> 00:16:56,130
!ستفوز حتماً

300
00:16:56,340 --> 00:16:59,600
مذهل، أنت مذهل يا كازوكي

301
00:16:59,600 --> 00:17:02,250
أنا أستمتع كثيراً الآن

302
00:17:03,120 --> 00:17:04,870
!وأنا

303
00:17:05,120 --> 00:17:08,650
كازوكي... إن تجاوزتَ قوّتك الكاملة

304
00:17:08,650 --> 00:17:10,260
!فسأفعل المثل

305
00:17:10,260 --> 00:17:11,880
!سأتجاوزها

306
00:17:11,880 --> 00:17:13,430
!سحب

307
00:17:14,550 --> 00:17:16,070
الصيد البريّ؟

308
00:17:16,070 --> 00:17:18,990
سحر يدمّر أتباع يتلقّون ضرراً

309
00:17:18,990 --> 00:17:20,240
ما أفعل؟

310
00:17:20,240 --> 00:17:21,610
ماذا أفعل بالضبط؟

311
00:17:21,850 --> 00:17:27,780
إن هاجمتُ الآن بالتنّين العاجي
يمكنني إصابة الفارس المنتصر بضرر 3

312
00:17:27,780 --> 00:17:31,080
!ثمّ يمكنني تدميره بالصيد البريّ

313
00:17:31,080 --> 00:17:31,850
...لكن

314
00:17:32,290 --> 00:17:33,600
!فكّر

315
00:17:33,600 --> 00:17:34,970
!فكّر بإمعان

316
00:17:40,630 --> 00:17:42,120
!وجدتُها

317
00:17:42,120 --> 00:17:43,240
!هذه هي

318
00:17:43,240 --> 00:17:44,630
!ها أنا ذا يا كازوكي

319
00:17:45,320 --> 00:17:47,070
!ألعب عظاءة النار

320
00:17:48,070 --> 00:17:50,320
!وأصيب الفارس المنتصر بضرر 1

321
00:17:54,330 --> 00:17:57,140
لم يخدشه ذلك حتّى

322
00:17:57,140 --> 00:17:58,000
أجل

323
00:17:58,000 --> 00:18:00,110
لن يهزمه ضرر 1

324
00:18:00,110 --> 00:18:02,300
!لكنّي أتبعه بهذا

325
00:18:02,300 --> 00:18:03,570
!الصيد البريّ

326
00:18:07,350 --> 00:18:10,320
!أدمّر تابعاً تلقى ضرراً

327
00:18:23,760 --> 00:18:27,490
قدرتك الآن في تقليص الضرر بثلاثة
!قد زالت الآن يا كازوكي

328
00:18:27,490 --> 00:18:30,010
!تبّاً! يا للتشكيلة

329
00:18:30,300 --> 00:18:34,510
!أهاجم جنرال حرس المقدمة بملكة الأفاعي وميغالوركا

330
00:18:37,040 --> 00:18:41,660
تتفعّل الكلمات الأخيرة لجنرال حرس المقدمة
!وتستدعي حارس قلعة

331
00:18:42,280 --> 00:18:44,010
!لم أنته بعد يا كازوكي

332
00:18:44,010 --> 00:18:47,040
!أهاجم حارس الحصن بالرخّ

333
00:18:50,150 --> 00:18:52,030
...تبّاً

334
00:18:52,030 --> 00:18:54,160
خسرتَ الحاجز الآن

335
00:18:54,160 --> 00:18:55,030
...ما يعني

336
00:18:55,270 --> 00:18:57,860
!زمجر أيّها التنّين العاجي

337
00:19:00,520 --> 00:19:03,550
!كازوكي، هذه قوّتي الكاملة

338
00:19:03,930 --> 00:19:08,070
كلا، بل قوّتي الكاملة الفائقة
!التي تجاوزت قوّتي الكاملة

339
00:19:24,090 --> 00:19:27,250
!ا-ا-انتهت

340
00:19:27,250 --> 00:19:29,440
!الفائز هو ريوغاساكي هيرو

341
00:19:34,750 --> 00:19:36,690
أنتَ قويّ حقاً يا هيرو

342
00:19:36,690 --> 00:19:38,050
!أنتَ أيضاً يا كازوكي

343
00:19:38,050 --> 00:19:39,830
!كانت مباراة متقاربة جدّاً

344
00:19:40,120 --> 00:19:43,330
!شكراً لك! كانت معركةً مذهلة

345
00:19:43,330 --> 00:19:44,570
!شكراً لك أيضاً

346
00:19:44,570 --> 00:19:46,960
!كانت أفضل واحدة للآن

347
00:19:55,340 --> 00:19:56,850
خسرنا

348
00:19:56,850 --> 00:19:58,180
...يا للخيبة

349
00:19:59,340 --> 00:20:01,510
كانا مُذهلين

350
00:20:01,510 --> 00:20:04,640
ليس سيّئاً، بالنسبة لشيندو كازوكي

351
00:20:05,590 --> 00:20:10,220
!حان الآن وقت الحفل وتوزيع الجوائز

352
00:20:10,480 --> 00:20:11,920
الجوائز؟

353
00:20:11,920 --> 00:20:14,270
...صحيح

354
00:20:14,270 --> 00:20:16,010
!نسيتُ تماماً

355
00:20:16,540 --> 00:20:17,760
!أنا أيضاً

356
00:20:19,870 --> 00:20:21,470
أخبرني يا كازوكي

357
00:20:21,470 --> 00:20:23,680
أردتَ الجائزة بشدّة، صحيح؟

358
00:20:24,390 --> 00:20:26,240
أجل

359
00:20:26,240 --> 00:20:28,750
أرادها أشقائي الصغار

360
00:20:29,090 --> 00:20:32,430
استمتعتُ اليوم لذا فلنتقاسمها

361
00:20:32,430 --> 00:20:33,770
هـ-هيرو؟

362
00:20:33,770 --> 00:20:35,730
!كلا، لا يصحّ هذا

363
00:20:36,150 --> 00:20:38,390
لم أستطع الفوز

364
00:20:38,390 --> 00:20:40,080
لذا سأستسلم

365
00:20:40,430 --> 00:20:41,620
...كازوكي

366
00:20:42,570 --> 00:20:45,140
!لن أخسر المرة القادمة يا هيرو

367
00:20:46,550 --> 00:20:47,500
!أجل

368
00:20:47,880 --> 00:20:54,730
هذه جائزة المركز الثاني، مجموعة بضائع
!للفنّانة المشهور آليس كوروباني

369
00:20:55,940 --> 00:20:58,500
حسناً، قد يسرّ بها المُعجبون

370
00:20:58,500 --> 00:20:59,740
...لكن كازوكي

371
00:21:02,730 --> 00:21:03,870
!رفاق

372
00:21:03,870 --> 00:21:05,960
!كانت جائزة المركز الثاني

373
00:21:05,960 --> 00:21:07,750
!رائع

374
00:21:07,750 --> 00:21:12,070
أردتَ بضائع كوروباني آليس-تشان؟

375
00:21:12,070 --> 00:21:13,900
!أجل، صحيح

376
00:21:13,900 --> 00:21:16,030
!ظننتُها جائزة المركز الأوّل

377
00:21:18,390 --> 00:21:21,030
!حسناً، لا مشكلة. فقد استمتعت

378
00:21:21,030 --> 00:21:22,280
!مُبارك

379
00:21:22,280 --> 00:21:25,370
!ربحتَ جائزة المركز الأوّل، 10 حزم

380
00:21:25,370 --> 00:21:27,040
!سأنقلها لهاتفك

381
00:21:31,690 --> 00:21:32,180
!ما الخطب؟

382
00:21:32,370 --> 00:21:35,100
!لم أرَ هذا قبلاً

383
00:21:35,100 --> 00:21:37,050
!يبدو قويّاً جدّاً

384
00:21:38,130 --> 00:21:40,920
هل ستصبح أقوى الآن فوق ما أنت عليه؟

385
00:21:41,800 --> 00:21:45,030
!لكن يوجد الكثير من اللاعبين الأقوياء

386
00:21:45,030 --> 00:21:47,070
لن أخسر بدوري

387
00:21:47,070 --> 00:21:51,030
!لنصبح أقوى ونلعب مُجدداً يا هيرو

388
00:21:51,030 --> 00:21:51,930
!أجل

389
00:23:25,060 --> 00:23:26,940
!استعراض بطاقات شادوفيرس

390
00:23:26,940 --> 00:23:29,390
!بطاقة اليوم هي هذه، الفارس المُنتصر

391
00:23:29,390 --> 00:23:32,630
!هذا التابع القويّ يقلّص الضرر لحلفائك

392
00:23:32,630 --> 00:23:35,700
نقطة ضعفه الوحيدة هي أنّه
يُستعمل من قبل شيندو كازوكي

393
00:23:35,700 --> 00:23:37,430
!ماذا؟

394
00:23:38,950 --> 00:23:39,430
في الحلقة القادمة

395
00:23:39,560 --> 00:23:41,340
!المذكّرة: موجودة! القلم الأحمر: موجود

396
00:23:41,340 --> 00:23:42,500
!أنا جاهز الآن

397
00:23:42,500 --> 00:23:43,890
ما الذي تفعله يا كاي؟

398
00:23:43,890 --> 00:23:46,540
!سأتحرّى سرّ قوّة يونازوكي لوشيا

399
00:23:46,540 --> 00:23:47,990
!رائع! سأشارك

400
00:23:47,990 --> 00:23:49,950
:الحلقة القادمة
!سبب القوّة

401
00:23:49,950 --> 00:23:51,970
!معركة! شادوفيرس