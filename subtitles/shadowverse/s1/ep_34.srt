1
00:01:34,410 --> 00:01:38,160
...عندما تجتمع الآلتان المقدّستان

2
00:01:41,070 --> 00:01:44,150
!تستدعيان خمسة هجوم ظلّ

3
00:01:44,920 --> 00:01:48,360
!الدمار

4
00:01:48,610 --> 00:01:51,140
!سينتهي كلّ شيء

5
00:01:51,620 --> 00:01:53,810
...هيّا نكمل

6
00:01:54,520 --> 00:01:57,320
!معركة اليأس هذه

7
00:01:58,700 --> 00:02:02,770
استدعى خمسة أتباع بدفاع 5
!وهجوم 5 في الآن ذاته

8
00:02:03,010 --> 00:02:05,320
هذه قوّة الآلات المقدّسة إذاً؟

9
00:02:06,760 --> 00:02:08,840
!أجل، صحيح

10
00:02:08,840 --> 00:02:11,930
!لكنّ هذه البداية فحسب

11
00:02:12,170 --> 00:02:16,080
هيّا يا ريوغاساكي هيرو، حان دورك

12
00:02:16,080 --> 00:02:19,100
!أجل، إنّه دوري! سحب

13
00:02:20,060 --> 00:02:21,240
!حسنٌ

14
00:02:21,240 --> 00:02:23,540
!بطاقة السحر: أجنحة التنّين

15
00:02:23,940 --> 00:02:28,180
لا يمكنك هزيمة هجوم الظلّ
!خاصتي بمثل هذه

16
00:02:28,180 --> 00:02:30,070
معك حقّ

17
00:02:30,070 --> 00:02:32,250
!لكن لديّ هذه أيضاً

18
00:02:32,250 --> 00:02:34,710
!بطاقة السحر: الحريق الهائل

19
00:02:39,310 --> 00:02:42,100
!تعطي ضرر 4 لكلّ الأتباع

20
00:02:43,050 --> 00:02:45,250
...أجنحة التنّين والحريق الهائل

21
00:02:45,250 --> 00:02:49,210
!سويّاً، تصيبك بطاقتا السحر هاتين بضرر 5

22
00:02:49,210 --> 00:02:50,760
!انطلقي

23
00:02:53,100 --> 00:02:56,100
!ماورا، لن أستسلم أبداً

24
00:02:56,100 --> 00:02:58,980
...بخصوصك... أو بخصوص هذا العالم

25
00:02:58,980 --> 00:03:01,630
!سأستعمل هذه المعركة لأريك ذلك

26
00:03:01,630 --> 00:03:03,120
!أنهي دوري

27
00:03:03,430 --> 00:03:05,440
أنت تغيظيني

28
00:03:05,810 --> 00:03:07,890
كم مرّةً عليّ إخبارك؟

29
00:03:08,550 --> 00:03:09,960
...إنّها النهاية

30
00:03:10,390 --> 00:03:13,950
!قدر العالم... وقدري أيضاً

31
00:03:17,140 --> 00:03:18,980
يا للسخرية

32
00:03:19,310 --> 00:03:24,000
!أملي هو يأسكما

33
00:03:24,650 --> 00:03:27,350
!اظهر أيّها القدّيس الإمبراطوريّ

34
00:03:32,790 --> 00:03:37,190
...إذا لم تستسلما، سأذيقكما باستمرار

35
00:03:37,860 --> 00:03:39,880
!طعم اليأس

36
00:03:39,880 --> 00:03:41,400
أنهي دوري

37
00:03:41,750 --> 00:03:43,720
إنّها البطاقة الأسطوريّة

38
00:03:43,720 --> 00:03:44,420
أجل

39
00:03:45,330 --> 00:03:47,990
أعرف مذاق اليأس بالفعل

40
00:03:48,920 --> 00:03:51,120
!دوري، سحب

41
00:03:52,010 --> 00:03:54,470
ذئب الدم، الجلّاد المجنون

42
00:03:56,160 --> 00:04:01,220
يصيب تأثيرهما قائدي بضرر 4

43
00:04:02,780 --> 00:04:06,420
ثمّ ألعب بطاقة السحر: أنياب الدم الثمينة

44
00:04:08,370 --> 00:04:12,020
تستدعي خفّاش غابة واحدة مقابل
كلّ تابع لدى خصمي

45
00:04:12,960 --> 00:04:17,260
وكلّ خفّاش غابة يظهر
يصيب قائده بضرر 1

46
00:04:18,050 --> 00:04:21,550
وأدخل طور الانتقام

47
00:04:22,340 --> 00:04:24,450
!ألعب شيطانة الجواهر، موريانا

48
00:04:28,220 --> 00:04:32,190
!يسترجع تأثير التطوّر خاصّتها نقطة تطوّر واحدة

49
00:04:34,810 --> 00:04:37,570
أصبت قائدك بالضرر إذاً

50
00:04:37,570 --> 00:04:41,810
لتدخل طور الانتقام وتفعّل تأثير انتقام

51
00:04:41,810 --> 00:04:44,390
يا للعبة الذكيّة

52
00:04:44,390 --> 00:04:46,940
...يحمل ذئب الدم عاصفة، فأهاجم قائد

53
00:04:48,310 --> 00:04:55,850
صحيح، يقلّص الدرع المُذنب خاصّتي
الضرر الذي يتلقّاه قائدي بمقدار 2

54
00:04:55,850 --> 00:05:01,070
هجوم ذئب الدم 2، فلن تجني شيئاً من المهاجمة به

55
00:05:02,950 --> 00:05:04,160
أنهي دوري

56
00:05:04,440 --> 00:05:09,520
!تظنّ بإمكانك هزيمتي بذلك؟ مثير للضحك

57
00:05:09,520 --> 00:05:12,800
!ألعب روح الأسد القديم، وأطوّره

58
00:05:12,800 --> 00:05:15,190
!ويتفعّل تأثير التطوّر خاصّته

59
00:05:15,490 --> 00:05:17,950
!احرقهم بضوئك

60
00:05:17,950 --> 00:05:20,890
!يصيب كلّ أتباع الخصم بضرر 2

61
00:05:20,890 --> 00:05:24,430
!ثمّ أستعمله لمهاجمة موريانا

62
00:05:25,900 --> 00:05:27,800
أنهي دوري

63
00:05:29,000 --> 00:05:31,440
!لكن ليس بعد

64
00:05:32,470 --> 00:05:37,790
يصيب تأثير ملاك الكلمة
أحد أتباع الخصم بضرر 1

65
00:05:37,790 --> 00:05:40,330
انتهى دوري الآن فعلاً

66
00:05:42,120 --> 00:05:44,780
!تعرف أنّي لن أدعكما تهربان

67
00:05:44,780 --> 00:05:47,430
!سيتدمّر كلّ شيء

68
00:05:47,430 --> 00:05:49,470
!هذا طريف

69
00:05:56,390 --> 00:05:57,480
هيرو؟

70
00:05:57,480 --> 00:06:00,570
أخبرني يا ماورا، أتستمتع الآن؟

71
00:06:02,140 --> 00:06:04,230
!أجل

72
00:06:04,230 --> 00:06:07,420
!أحبّ مشاهدتكما تعانيان

73
00:06:07,770 --> 00:06:09,750
فهمت، هذا رائع

74
00:06:10,380 --> 00:06:11,560
ما الرائع؟

75
00:06:11,560 --> 00:06:15,100
ظننتُ أنّك تغيّرت

76
00:06:15,100 --> 00:06:16,470
لكنّي كنت مخطئاً

77
00:06:16,740 --> 00:06:18,430
!لم تتغيّر

78
00:06:19,230 --> 00:06:24,010
أنت مثلي ومثل لوشيا

79
00:06:25,200 --> 00:06:27,660
مثلكما؟

80
00:06:27,970 --> 00:06:30,600
لم تستطع هزيمته بالفعل إذاً

81
00:06:30,930 --> 00:06:32,270
كيف؟

82
00:06:32,270 --> 00:06:34,570
شادوفيرس مسليّة جدّاً، أليس كذلك؟

83
00:06:34,570 --> 00:06:36,910
الحماس الذي تشعر به
!عندما تقلب الطاولة

84
00:06:36,910 --> 00:06:38,910
أو عندما تشتدّ الأمور

85
00:06:39,130 --> 00:06:41,210
لا أفهم

86
00:06:41,210 --> 00:06:46,550
!اسمع، أنا أستمتع بمشاهدتكما تعانيان

87
00:06:47,040 --> 00:06:48,930
!هذا ما قلتُه

88
00:06:49,170 --> 00:06:52,420
حسناً، وصفك سيّئ نوعاً ما

89
00:06:52,420 --> 00:06:54,830
،لكن مهما بدوت

90
00:06:54,830 --> 00:06:57,430
...ومهما أبغضت العالم

91
00:07:00,000 --> 00:07:02,960
!لا تزال تحبّ شادوفيرس مثلنا

92
00:07:05,010 --> 00:07:07,610
!زمجر يا تنّين النار

93
00:07:07,920 --> 00:07:10,400
!يتفعّل تأثير تنّين النار

94
00:07:10,400 --> 00:07:13,660
عندما يكون عدد البطاقات في يدي
!اثنين أو أقلّ، يتطوّر

95
00:07:17,860 --> 00:07:23,510
يتفعّل تأثير هجوم تنّين النار ويصيب
!كلّ أتباع الخصم بضرر 3

96
00:07:28,220 --> 00:07:30,130
!أنهي دوري

97
00:07:30,580 --> 00:07:32,600
أحبّ شادوفيرس؟

98
00:07:32,600 --> 00:07:35,430
كيف لك أن تتكلّم عن هذا
مع كلّ ما حصل؟

99
00:07:35,430 --> 00:07:38,570
!لا يهمّ أنّ العالم قد يتدمّر

100
00:07:38,570 --> 00:07:40,590
!أنا أحبّ شادوفيرس

101
00:07:40,590 --> 00:07:42,130
وأنت كذلك، صحيح؟

102
00:07:42,420 --> 00:07:47,020
شادوفيرس مجرّد طريقة لجعلكما تعانيان

103
00:07:47,020 --> 00:07:48,080
ليس صحيحاً

104
00:07:48,650 --> 00:07:52,060
لمَ تحدّيتني لمعركة إذاً؟

105
00:07:52,420 --> 00:07:56,420
عندما كنتَ في أشدّ يأسك، تشبّثت بشادوفيرس للمساعدة

106
00:07:56,740 --> 00:07:57,640
ألستُ محقّاً؟

107
00:07:58,340 --> 00:08:01,580
ما الذي تتكلّمان عنه؟

108
00:08:02,030 --> 00:08:04,160
!ألعب ملاك اللمعان

109
00:08:05,910 --> 00:08:08,000
!أسحب بطاقة

110
00:08:08,000 --> 00:08:11,710
!وألعب مدافع المعبد والراهبة المخلصة

111
00:08:14,930 --> 00:08:17,020
تابعان بحاجز؟

112
00:08:17,020 --> 00:08:20,450
أحبّ شادوفيرس؟ أستمتع بها؟

113
00:08:20,450 --> 00:08:23,760
!هذه سخافة! لا تهمّ

114
00:08:23,760 --> 00:08:25,470
!ليس صحيحاً

115
00:08:25,470 --> 00:08:29,560
فبسبب شادوفيرس يمكننا
!الكلام مع بعضنا هكذا

116
00:08:31,220 --> 00:08:35,080
أخبرتُك أنّ هذا التفكير سخيف

117
00:08:35,490 --> 00:08:38,090
أتفهّم مشاعرك بالإنكار

118
00:08:38,090 --> 00:08:40,680
...لكنّك لا تعرف

119
00:08:40,680 --> 00:08:43,110
!لا تعرف بعد وحسب

120
00:08:43,110 --> 00:08:46,700
!تخترق شادوفيرس قلبك أعمق من الكلمات

121
00:08:46,700 --> 00:08:48,070
!إمبراطور الظلام

122
00:08:50,080 --> 00:08:53,100
يتفعّل تأثير طور الانتقام لإمبراطور الظلام

123
00:08:53,570 --> 00:08:56,820
!فيستهدف ويدمّر تابعين للخصم

124
00:08:59,310 --> 00:09:02,110
!يملك القدّيس الإمبراطوريّ كميناً

125
00:09:02,110 --> 00:09:04,940
!لا يمكنك استهدافه

126
00:09:08,440 --> 00:09:11,150
!ثمّ ألعب قُبلة مصّاص الدماء

127
00:09:12,990 --> 00:09:17,910
!أصيب الراهبة المخلصة بضرر 2
!وأسترجع 2 من دفاعي

128
00:09:19,750 --> 00:09:21,280
سأستعيره يا هيرو

129
00:09:21,280 --> 00:09:21,980
!أجل

130
00:09:21,980 --> 00:09:24,260
!أهاجم قائدك بتنّين النار

131
00:09:24,260 --> 00:09:27,640
!يعطيه تأثير هجومه 10 نقاط هجوم

132
00:09:28,120 --> 00:09:31,220
!يقلّص الدرع المُذنب الضرر بمقدار 2

133
00:09:40,070 --> 00:09:42,740
لا أفهم ألمك

134
00:09:42,740 --> 00:09:45,160
نحن مُختلفان

135
00:09:45,160 --> 00:09:47,940
كلّ ما رأيناه وسمعناه مختلف

136
00:09:48,470 --> 00:09:51,230
لكن مع ذلك، نحن متماثلان

137
00:09:52,060 --> 00:09:52,900
صحيح؟

138
00:09:53,260 --> 00:09:54,820
بلى، معك حقّ

139
00:09:55,350 --> 00:09:57,900
!لأنّنا أصدقاء

140
00:09:58,800 --> 00:10:00,090
...أنا

141
00:10:02,330 --> 00:10:04,070
...لطالما

142
00:10:05,780 --> 00:10:09,280
!لطالما كرهتُ ذلك فيك

143
00:10:12,540 --> 00:10:14,960
عليّ إعطاؤه هذه فحسب؟

144
00:10:14,960 --> 00:10:16,660
أجل

145
00:10:16,660 --> 00:10:21,590
أنا متأكّد أنّها ستفيد
في تدمير شجرة الكوارث

146
00:10:22,690 --> 00:10:26,020
لمَ تعامل ريوغاساكي هيرو
كأنّه شخص مميّز؟

147
00:10:26,420 --> 00:10:29,060
حسناً، لا أستطيع التحديد

148
00:10:29,490 --> 00:10:34,310
لكن هناك ما يجذبني له داخله

149
00:10:36,460 --> 00:10:39,940
لن أدعك تأخذها

150
00:10:39,940 --> 00:10:41,700
!هذه لي

151
00:10:46,110 --> 00:10:48,330
لا أستطيع... استعمالها؟

152
00:10:50,010 --> 00:10:52,190
لمَ لا؟

153
00:10:52,710 --> 00:10:53,850
لمَ؟

154
00:10:54,330 --> 00:10:56,650
!لمَ؟

155
00:10:59,120 --> 00:11:01,950
عليّ تدمير كلّ شيءٍ وحسب

156
00:11:02,380 --> 00:11:05,590
اخضعوا أمام الآلة المقدّسة الثالثة

157
00:11:05,860 --> 00:11:07,930
!حربة الحكم

158
00:11:12,720 --> 00:11:14,400
ما الذي حصل؟

159
00:11:34,480 --> 00:11:36,870
!ماورا

160
00:11:50,120 --> 00:11:50,930
!ماورا

161
00:11:51,860 --> 00:11:56,370
سيدخل كلّ شيءٍ في هذا العالم شجرة الكوارث

162
00:11:56,770 --> 00:12:00,770
هذا قانون الكون، حقيقة غير قابلة للإنكار

163
00:12:01,130 --> 00:12:02,890
ما الذي حلّ به؟

164
00:12:02,890 --> 00:12:07,790
ابتلعته الظلال الفارغة كليّاً على الأرجح

165
00:12:07,790 --> 00:12:11,360
كلّ من يعارض هذا القانون سيُمحى

166
00:12:12,740 --> 00:12:17,230
عندما تجتمع كلّ الآلات المقدّسة، ستحلّ الكارثة

167
00:12:20,380 --> 00:12:25,500
تدمّر تابعاً للخصم، وتطرد آخراً

168
00:12:25,500 --> 00:12:31,140
ويستدعي تأثير حربة الحكم
رسوليْ آلة للملعب

169
00:12:31,440 --> 00:12:35,110
ويعطي قائدهما هجوم 2

170
00:12:35,520 --> 00:12:37,320
أهاجم قائد الخصم

171
00:12:41,780 --> 00:12:43,770
اقتربت لحظة الدمار

172
00:12:44,980 --> 00:12:48,640
دمّر تابعي وتابع لوشيا
!بلمح البصر بمجرّد تأثير

173
00:12:48,640 --> 00:12:51,990
كما قائده نفسه يهاجم

174
00:12:52,600 --> 00:12:55,180
ولا تزال البطاقة الأسطوريّة موجودة

175
00:12:55,180 --> 00:12:58,000
علينا تدميرها قبل أن تتطوّر

176
00:12:58,880 --> 00:13:00,620
وإلّا سنخسر

177
00:13:01,290 --> 00:13:03,690
الوضع مُظلم

178
00:13:03,690 --> 00:13:05,210
لا تزال لدينا فرصة

179
00:13:05,660 --> 00:13:07,560
لدينا هذه، أليس كذلك؟

180
00:13:08,210 --> 00:13:13,590
كما إذا هزمنا ماورا، فسترحل الظلال
الفارغة التي تتلبّسه، صحيح؟

181
00:13:13,840 --> 00:13:14,840
إذا هزمنا؟

182
00:13:14,840 --> 00:13:16,830
!كلا، أقصد عندما نفوز

183
00:13:16,830 --> 00:13:19,020
!سنفوز حتماً وننقذه

184
00:13:19,300 --> 00:13:21,890
يمكننا فعلها معاً، أليس كذلك؟

185
00:13:22,930 --> 00:13:24,650
...يا إلهي، أنت حقّاً

186
00:13:25,390 --> 00:13:26,790
!انتظرنا فحسب يا ماورا

187
00:13:28,410 --> 00:13:30,250
!دوري! سحب

188
00:13:31,400 --> 00:13:33,170
!ألعب تنّين الجواهر

189
00:13:36,380 --> 00:13:41,890
يتفعّل تأثير الفيض خاصّته ويعيد
تنّين النار المدمّر ليدي

190
00:13:42,280 --> 00:13:43,170
...ثمّ

191
00:13:43,170 --> 00:13:46,080
!زمجر مُجدداً يا تنّين النار

192
00:13:46,840 --> 00:13:48,640
!هاجم رسول الآلة

193
00:13:48,640 --> 00:13:52,830
!يصيب تأثير هجومه كلّ أتباع الخصم بضرر 3

194
00:13:54,600 --> 00:13:57,470
تبقّى للقدّيس الإمبراطوريّ دفاع 1

195
00:13:57,470 --> 00:13:58,220
...الآن

196
00:13:58,220 --> 00:13:59,730
...الكلمات الأخيرة

197
00:14:00,660 --> 00:14:06,810
تتفعّل الكلمات الأخيرة لرسول الآلة
وتضيف 2 لهجوم حربة الحكم

198
00:14:07,380 --> 00:14:09,450
!أصبح هجومه 4

199
00:14:09,450 --> 00:14:11,110
الدمار هو قدرك

200
00:14:12,020 --> 00:14:13,770
فلترتعد الآن

201
00:14:13,770 --> 00:14:16,690
بطاقة السحر: حكم الآلة

202
00:14:18,560 --> 00:14:21,610
تدمّر كلّ أتباع الخصم

203
00:14:25,070 --> 00:14:28,320
وتسترجع صحّة كلّ الأتباع بمقدار 4

204
00:14:30,180 --> 00:14:32,560
ظننتُ أنّنا على وشك هزيمته

205
00:14:32,770 --> 00:14:36,800
ثمّ تستدعي أقصى عدد ممكن
من رُسل الآلة

206
00:14:40,760 --> 00:14:43,020
هاجم قائد الخصم

207
00:14:46,270 --> 00:14:48,210
اقترب من النهاية

208
00:14:48,210 --> 00:14:49,530
أنهي دوري

209
00:14:51,060 --> 00:14:54,670
ماورا، لن تصلك الكلمات الآن

210
00:14:54,670 --> 00:14:56,660
لكنّي سأقول ما لديّ بأيّ حال

211
00:14:56,660 --> 00:14:58,730
!أنا أحبّ شادوفيرس

212
00:14:58,730 --> 00:15:02,460
ماورا، أعرف أنّك تفهم في الواقع

213
00:15:04,120 --> 00:15:06,600
من المخيف الاعتراف بالحقيقة

214
00:15:07,100 --> 00:15:09,580
تشعر كما لو أنّ كلّ شيء سينهار

215
00:15:10,070 --> 00:15:13,130
،لكن عندما تتقبّل ذاتك الحقيقيّة

216
00:15:13,130 --> 00:15:16,080
!سيلمع العالم بشدّة بلا شكّ

217
00:15:16,480 --> 00:15:20,240
!أنت نبيل الظلام! الظُلمة الخاطفة

218
00:15:20,510 --> 00:15:22,320
!سيّد هلاك الهاوية

219
00:15:26,850 --> 00:15:29,670
يتفعّل تأثير سيّد هلاك الهاوية

220
00:15:29,670 --> 00:15:33,660
!ويصيب قائدي بضرر حتّى يصبح دفاعه 1

221
00:15:36,610 --> 00:15:41,250
!ثمّ يصيب كلّ الأتباع بالضرر نفسه

222
00:15:43,580 --> 00:15:45,260
كلّ هذا بلا معنى

223
00:15:47,510 --> 00:15:49,340
!ارتفع هجومه مجدداً

224
00:15:49,340 --> 00:15:51,300
!أنا سأقرّر ما إن كان يحمل معنى أم لا

225
00:15:51,710 --> 00:15:54,340
!تطوّر يا سيّد هلاك الهاوية

226
00:16:02,760 --> 00:16:04,860
!يتفعّل تأثير تطوّره

227
00:16:05,320 --> 00:16:11,830
حتّى بداية دوري التالي، لا يتلقّى قائدي
!أو سيّد هلاك الهاوية أيّ ضرر

228
00:16:12,190 --> 00:16:13,580
!خُذ هذه يا ماورا

229
00:16:13,580 --> 00:16:15,400
!إنّها حقيقتي

230
00:16:15,400 --> 00:16:18,440
!القوّة الحقيقيّة التي كسبتُها من شادوفيرس

231
00:16:18,440 --> 00:16:22,490
!يحمل سيّد هلاك الهاوية عاصفة، فأهاجم قائدك

232
00:16:22,800 --> 00:16:25,830
!يتفعّل تأثير هجومه

233
00:16:25,830 --> 00:16:27,920
،عندما لا أحمل بطاقات في يدي

234
00:16:27,920 --> 00:16:29,370
!يرتفع هجومه بمقدار 3

235
00:16:35,550 --> 00:16:36,940
!أنهي دوري

236
00:16:37,770 --> 00:16:40,900
!ستبتلع شجرة الكوارث كلّ شيء

237
00:16:40,900 --> 00:16:42,550
حارس الآلات

238
00:16:52,260 --> 00:16:56,560
يستدعي 4 هجوم ظلّ، ويعطيهم حاجزاً

239
00:16:57,270 --> 00:16:58,730
...مذهل

240
00:16:59,180 --> 00:17:01,400
محنة أخرى إذاً؟

241
00:17:01,400 --> 00:17:05,710
لا يمكن تدمير حارس الآلات بالتأثيرات

242
00:17:05,710 --> 00:17:09,830
إنّه رمز الدمار، النهاية قريبة

243
00:17:09,830 --> 00:17:11,400
أنهي دوري

244
00:17:15,150 --> 00:17:16,460
...لوشيا

245
00:17:16,460 --> 00:17:18,670
أنا متأكّد أنّ هذا دورنا الأخير

246
00:17:18,900 --> 00:17:20,370
أعرف

247
00:17:20,370 --> 00:17:22,530
لذا سأترك الأمر لك

248
00:17:22,770 --> 00:17:24,690
!أجل، شكراً

249
00:17:27,450 --> 00:17:29,020
!ها أنا ذا يا ماورا

250
00:17:29,020 --> 00:17:31,530
!سأصبّ مشاعري في هذه البطاقة

251
00:17:32,060 --> 00:17:34,310
،إذا كان القدر يجعلك تعاني

252
00:17:34,310 --> 00:17:37,850
فأنا ولوشيا والجميع

253
00:17:37,850 --> 00:17:39,740
!سنقاتل قدرك معاً

254
00:17:39,970 --> 00:17:44,890
!جميعنا مختلفون، لكنّ شادوفيرس تربطنا كلّنا

255
00:17:47,260 --> 00:17:51,770
!لن تخسر هذه الروابط لأيّ أحد، حتّى للقدر نفسه

256
00:17:53,680 --> 00:17:56,880
!أنت النار الحارقة! الشعلة التي تحرق السماوات

257
00:17:57,110 --> 00:18:01,530
!أعطني قوّتك يا تنّين الشعلة اللا متناهية

258
00:18:10,120 --> 00:18:15,320
يتفعّل تأثير تنّين الشعلة اللا متناهية
!ويصيب قائد الخصم بضرر 5

259
00:18:20,370 --> 00:18:21,540
!تطوّر

260
00:18:22,470 --> 00:18:24,760
!يا تنّين الشعلة اللا متناهية

261
00:18:25,790 --> 00:18:28,580
،يتدمّر كلّ الأتباع بدفاع 5 أو أقلّ

262
00:18:28,580 --> 00:18:32,760
ويتلقّى قائد الخصم ضرر 1
!مقابل كلّ تابع تدمّر

263
00:18:33,010 --> 00:18:35,430
!ثمّ أهاجم حارس الآلات

264
00:18:37,600 --> 00:18:40,300
!يتفعّل تأثير تنّين الشعلة اللا متناهية

265
00:18:40,300 --> 00:18:42,720
،عندما يصيب تابعاً للخصم بضرر

266
00:18:42,720 --> 00:18:46,470
!يتلقّى قائد الخصم ضرراً مكافئاً

267
00:18:59,220 --> 00:19:00,700
!لننه هذا يا لوشيا

268
00:19:01,330 --> 00:19:02,990
!هيّا بنا يا هيرو

269
00:19:03,290 --> 00:19:06,070
!أهاجم قائدك بسيّد هلاك الهاوية

270
00:19:12,740 --> 00:19:14,110
...هذا الهجوم

271
00:19:14,110 --> 00:19:15,330
!سيصلك

272
00:19:17,120 --> 00:19:19,640
!ها نحن ذا يا ماورا

273
00:19:27,310 --> 00:19:30,600
ذلك... ضوء

274
00:19:34,480 --> 00:19:37,980
لسببٍ ما... أشعر بدفء

275
00:19:42,000 --> 00:19:43,580
مثل آنذاك

276
00:19:54,910 --> 00:19:55,970
!ماورا

277
00:19:59,640 --> 00:20:01,140
أأنت بخير يا ماورا؟

278
00:20:04,330 --> 00:20:06,000
رجعت لطبيعتك وفقما يبدو

279
00:20:06,350 --> 00:20:07,670
...طبيعتي

280
00:20:12,350 --> 00:20:16,020
...لتلك الوحدة مُجدداً... أنا

281
00:20:18,770 --> 00:20:20,230
لستَ وحيداً

282
00:20:20,230 --> 00:20:21,530
نحن معك، أليس كذلك؟

283
00:20:23,700 --> 00:20:25,480
ربما صحيح

284
00:20:31,590 --> 00:20:32,550
...هاك

285
00:20:35,950 --> 00:20:41,900
أخبرني أنّها ضروريّة لتدمير شجرة الكوارث

286
00:20:42,480 --> 00:20:43,600
...ماورا

287
00:20:49,020 --> 00:20:51,380
!ريوغاساكي هيرو، انخفض

288
00:21:07,070 --> 00:21:09,620
ماورا! أأنت بخير يا ماورا؟

289
00:21:10,500 --> 00:21:11,380
!لوشيا

290
00:21:11,860 --> 00:21:13,080
ما الذي حصل؟

291
00:21:19,380 --> 00:21:23,160
مضى وقتٌ طويل مذ أتيت لهذا المكان

292
00:21:24,360 --> 00:21:26,100
...هذه الرائحة

293
00:21:28,330 --> 00:21:29,900
...وهذه الرياح

294
00:21:37,030 --> 00:21:38,150
...مستحيل

295
00:21:38,980 --> 00:21:40,180
...أيمكن

296
00:21:43,280 --> 00:21:44,310
...أيمكن

297
00:21:49,860 --> 00:21:51,340
أهذا أنت يا أبي؟

298
00:23:24,340 --> 00:23:26,320
!استعراض بطاقات شادوفيرس

299
00:23:26,300 --> 00:23:28,800
!هذه بطاقة اليوم: حربة الحكم

300
00:23:28,800 --> 00:23:32,680
إنّها بطاقة خاصّة يمكنها
إعطاء قائدها قوّة هجوم

301
00:23:32,680 --> 00:23:36,090
كانت قويّةً جدّاً، لكن كانت معركة مسليّة حقّاً

302
00:23:36,090 --> 00:23:36,810
صحيح يا لوشيا؟

303
00:23:36,810 --> 00:23:38,160
أجل، معك حق

304
00:23:39,220 --> 00:23:41,900
!الظلال الفارغة تهاجمنا باستمرار

305
00:23:41,900 --> 00:23:43,400
...على هذا النحو، سيكون العالم

306
00:23:43,400 --> 00:23:44,410
!لن أخسر

307
00:23:44,410 --> 00:23:46,560
!سأنقذ أبي حتماً

308
00:23:46,570 --> 00:23:48,860
الحلقة القادمة: مُقدمة النهاية

309
00:23:48,860 --> 00:23:50,820
!معركة! شادوفيرس

310
00:23:50,820 --> 00:23:53,570
ما أسعى له شيءٌ واحد فقط