00:12:32,560 --> 00:12:34,930
ألعب ثلاثة تنانين نار جحيم

211
00:12:36,480 --> 00:12:39,880
!تكلفتهم 3، لكنّ هجومهم 4

212
00:12:39,880 --> 00:12:42,450
!ولديهم اندفاع

213
00:12:42,950 --> 00:12:45,090
خُذوا هذا

214
00:12:49,490 --> 00:12:50,680
!كلا

215
00:12:51,070 --> 00:12:55,760
!هذه قوّة اتّحادي وكو

216
00:13:11,420 --> 00:13:15,020
!عليّ الفوز هذه المرّة

217
00:13:15,020 --> 00:13:17,730
!لذا سينتهي طريقك هنا

218
00:13:18,290 --> 00:13:20,480
!أهاجم قائدك بملك اللبلاب

219
00:13:24,330 --> 00:13:29,280
!انتهت! ارتقى كيرياما شيرو للمرتبة الذهبيّة

220
00:13:29,280 --> 00:13:33,870
!إنّه لاعب المرتبة الذهبيّة الخمسون

221
00:13:33,870 --> 00:13:37,620
!غادر نصف اللاعبون الجزيرة بالفعل

222
00:13:37,620 --> 00:13:43,000
كم من المتبقّين سيمتلكون فرصة
خوض معركة أخرى؟

223
00:13:43,000 --> 00:13:44,500
!دوري

224
00:13:44,500 --> 00:13:46,590
!ألعب القائد الحكيم

225
00:13:52,520 --> 00:13:54,880
!ثمّ ألعب فارس الهجوم

226
00:13:55,250 --> 00:13:59,050
!عندما يكون لديّ قائد في ملعبي، يحصل على اندفاع

227
00:13:59,050 --> 00:14:02,070
!أهاجم به تنّين نار جحيم

228
00:14:02,070 --> 00:14:04,540
!ثمّ أهاجم قائدك برجال الثلج

229
00:14:05,520 --> 00:14:10,080
!شيندو كازوكي، علينا التركيز على هزيمة أتباعهم

230
00:14:10,080 --> 00:14:12,150
لكن لا يمكننا الفوز دون الهجوم، صحيح؟

231
00:14:12,150 --> 00:14:13,070
...لكن

232
00:14:13,070 --> 00:14:14,580
!يكفي ثرثرة

233
00:14:14,580 --> 00:14:16,250
!دوري

234
00:14:16,250 --> 00:14:18,720
!يتفعّل تأثير مزمار أغنية التنّين

235
00:14:18,720 --> 00:14:24,080
كلّ البطاقات التي أُضيفت ليدي
!بتكلفة 3 أو أقلّ تتحوّل لتنّين نار جحيم

236
00:14:24,080 --> 00:14:29,000
!أهاجم رجلاُ ثلجياً بتنّين نار جحيم، وأهاجم قائدك بآخر

237
00:14:29,000 --> 00:14:33,810
!ثمّ ألعب ثلاثة تنانين أخرى، وأطوّر إحداها

238
00:14:33,810 --> 00:14:37,210
أهاجم القائد الحكيم بتنّين نار الجحيم المطوّر

239
00:14:37,210 --> 00:14:39,690
!ثمّ أهاجم رجلاً ثلجياً بالتنّين الآخر

240
00:14:39,690 --> 00:14:41,110
كم يملك منهم؟

241
00:14:41,110 --> 00:14:42,970
!ملأ الملعب بأسره

242
00:14:42,970 --> 00:14:44,730
!سأصطادكما للانقراض

243
00:14:44,730 --> 00:14:45,870
!أنهي دوري

244
00:14:46,220 --> 00:14:48,410
عليّ فعل شيء حيال هذا الوضع

245
00:14:48,410 --> 00:14:48,900
!سحب

246
00:14:49,310 --> 00:14:51,450
عليّ توفير وقت

247
00:14:51,790 --> 00:14:54,380
!ألعب النور المشكالي وقنص الملاك

248
00:14:54,380 --> 00:14:58,410
،يرجع تنّين نار جحيم واحد ليدك
!ثمّ يتلقّى آخر ضرر 1

249
00:14:58,410 --> 00:14:59,480
لا جدوى

250
00:15:00,260 --> 00:15:02,290
!ألعب ثلاثة صواريخ سحر

251
00:15:02,610 --> 00:15:05,970
!يتلقّى كلّ التنانين الثلاثة ضرر 1

252
00:15:06,550 --> 00:15:10,220
!ثمّ أسحب بطاقة بتأثير صواريخ السحر

253
00:15:10,530 --> 00:15:11,990
!رائع يا كاي

254
00:15:11,990 --> 00:15:13,300
!هزمتهم جميعاً

255
00:15:13,300 --> 00:15:14,150
كلا

256
00:15:14,150 --> 00:15:16,800
سيستدعي المزيد من تنانين نار الجحيم

257
00:15:16,800 --> 00:15:18,030
انظر يا كو

258
00:15:18,030 --> 00:15:19,700
إنّه يائس

259
00:15:19,700 --> 00:15:20,600
لا جدوى

260
00:15:21,630 --> 00:15:22,990
أنهي دوري

261
00:15:22,990 --> 00:15:25,110
دوري إذاً

262
00:15:25,110 --> 00:15:27,620
ألعب ثلاثة تنانين نار جحيم

263
00:15:29,650 --> 00:15:30,870
كما ظننت

264
00:15:30,870 --> 00:15:33,180
لا يهمّ كم دمّرت

265
00:15:33,180 --> 00:15:35,810
!يمكننا استدعاؤهم باستمرار

266
00:15:40,870 --> 00:15:43,080
لمَ أنت مُحبط؟

267
00:15:43,620 --> 00:15:46,310
ماذا؟ ألا تدرك؟

268
00:15:46,310 --> 00:15:49,760
لا حدّ لعدد تنانين نار الجحيم
!التي يمكنهما استدعاؤها

269
00:15:49,760 --> 00:15:52,020
!أعي ذلك

270
00:15:52,020 --> 00:15:53,450
،لكن يا كاي

271
00:15:53,450 --> 00:15:55,780
لم نخسر بعد، أليس كذلك؟

272
00:15:55,780 --> 00:15:59,630
!وهذا يعني أنّ لا زال بإمكاننا الفوز

273
00:15:59,630 --> 00:16:02,640
!لنرهما قوّتنا

274
00:16:04,590 --> 00:16:06,630
!السيّاف المنتصر

275
00:16:07,140 --> 00:16:09,530
!يتفعّل تأثير السيّاف المنتصر

276
00:16:09,530 --> 00:16:15,010
أيّ ضرر يتلقاه سيتقلّص بمقدار 3
!حتّى الدور التالي

277
00:16:15,010 --> 00:16:17,410
ثمّ أستدعي الرمّاحة المخضرمة

278
00:16:17,410 --> 00:16:20,620
تأثير السيّاف المنتصر الآخر

279
00:16:20,620 --> 00:16:24,710
يعني أنّ الضرر الذي سيتلقاه أتباعي الآخرون
!سيتقلّص بمقدار 3

280
00:16:25,180 --> 00:16:27,040
!أطوّر الرمّاحة المخضرمة

281
00:16:28,040 --> 00:16:30,550
!وأهاجم تنّين نار الجحيم

282
00:16:31,400 --> 00:16:33,790
كانا ليموتا معاً في العادة

283
00:16:34,230 --> 00:16:36,510
كاي، أنتَ عبقري، صحيح؟

284
00:16:36,510 --> 00:16:40,440
!فلتثبت ذلك في هذه المعركة إذاً

285
00:16:40,840 --> 00:16:42,100
...شيندو

286
00:16:45,280 --> 00:16:48,220
أجل، تلك نيّتي بالطبع

287
00:16:51,030 --> 00:16:53,020
!عبقريّ؟ يا للهراء

288
00:16:53,020 --> 00:16:55,530
!دوري! ها أنا ذا

289
00:16:55,860 --> 00:16:59,370
!ألعب تنّيني نار جحيم، وأطوّر أحدهما

290
00:16:59,370 --> 00:17:03,190
!ثمّ أهاجم الرمّاحة المخضرمة والسيّاف المنتصر

291
00:17:05,440 --> 00:17:08,340
!لن يكفي ذلك لهزيمة السيّاف المنتصر

292
00:17:08,340 --> 00:17:10,040
أشكّ في ذلك

293
00:17:10,040 --> 00:17:11,880
!ألعب سيغفريد

294
00:17:11,880 --> 00:17:15,970
!يدمّر تابعاً واحداً تلقّى ضرراً

295
00:17:16,400 --> 00:17:17,460
!لا يمكن

296
00:17:17,460 --> 00:17:18,460
...ثمّ

297
00:17:18,860 --> 00:17:22,760
!أهاجم قائدكما بتنّيني نار جحيم

298
00:17:25,770 --> 00:17:29,490
!حسناً، وصل الصيد ختامه

299
00:17:42,130 --> 00:17:44,690
شـ-شيندو كازوكي؟

300
00:17:45,900 --> 00:17:49,100
لا تقلق، فلم نخسر بعد

301
00:17:51,830 --> 00:17:53,770
أجل، معك حقّ

302
00:17:54,390 --> 00:17:58,630
!لم نخسر بعد، أي لا زال بإمكاننا الفوز

303
00:17:58,630 --> 00:17:59,390
!سحب

304
00:18:00,000 --> 00:18:00,990
!ها هو

305
00:18:00,990 --> 00:18:05,030
لكن لم أعطه أي تعزيز سحر، فتكلفته 13

306
00:18:05,030 --> 00:18:07,340
لا يمكنني استدعاؤه

307
00:18:08,290 --> 00:18:09,750
!كلا، لحظة

308
00:18:10,140 --> 00:18:12,690
لا يفكّر العباقرة بالخسارة

309
00:18:12,690 --> 00:18:14,580
!بل بالفوز فحسب

310
00:18:15,050 --> 00:18:16,850
!ألعب خزينة السحر

311
00:18:16,850 --> 00:18:19,880
!تعزز سحر بطاقة في يدي مرّتين

312
00:18:19,880 --> 00:18:22,160
تعزيز سحر في هذه المرحلة؟

313
00:18:22,160 --> 00:18:23,120
فات الأوان

314
00:18:23,120 --> 00:18:25,030
!كلا، سأبدأ الآن

315
00:18:25,030 --> 00:18:29,160
تقلّص خزينة السحر تكلفة عناق النار
!إلى صفر، فألعب ثلاثة

316
00:18:29,160 --> 00:18:31,540
!أدمّر ثلاثة تنانين نار جحيم

317
00:18:31,540 --> 00:18:32,920
وما في ذلك؟

318
00:18:32,920 --> 00:18:35,060
أخبرتكما أنّي سأبدأ الآن

319
00:18:35,700 --> 00:18:42,120
عززت خزينة السحر سحر عناق النار
ثلاث مرّات، فأصبحت تكلفته صفراً

320
00:18:42,120 --> 00:18:44,560
ثمّ عُزز سحرها ثلاث مرّات إضافية

321
00:18:44,560 --> 00:18:46,270
فعلتُها في الوقت

322
00:18:46,270 --> 00:18:49,230
!فلتظهر يا ساحر الزمن

323
00:18:50,160 --> 00:18:53,270
!تطوّر! ارجع بالوقت

324
00:18:56,080 --> 00:18:58,080
عندما يتطوّر ساحر الزمن

325
00:18:58,080 --> 00:19:01,700
كلّ أتباعي الذين دُمرّوا
في الدور السابق يرجعون للملعب

326
00:19:01,700 --> 00:19:02,830
ماذا؟

327
00:19:02,830 --> 00:19:04,070
!مستحيل

328
00:19:04,070 --> 00:19:05,330
بل ممكن

329
00:19:05,330 --> 00:19:10,450
هذه الكيمياء الناتجة من حساباتي
!وعزيمة شيندو كازوكي الصلبة

330
00:19:10,740 --> 00:19:14,080
!أهاجم سيغفريد بساحر الزمن

331
00:19:14,880 --> 00:19:16,880
اكتملت المحاكاة

332
00:19:16,880 --> 00:19:18,140
!مستحيل

333
00:19:18,140 --> 00:19:19,330
...لا يُعقل

334
00:19:19,800 --> 00:19:25,940
!أعلن أنّكما ستخسران الدور المُقبل

335
00:19:28,070 --> 00:19:31,470
!ألعب تنّين نار جحيم وملكة مصّاصي الدماء

336
00:19:31,470 --> 00:19:36,510
يستدعي تأثير ملكة مصّاصي الدماء
!خفّاشي غابة بحاجز للملعب

337
00:19:37,480 --> 00:19:38,900
أنهي دوري

338
00:19:39,470 --> 00:19:42,090
!هذا هو الدور الأخير

339
00:19:42,090 --> 00:19:43,650
!ألعب ألكسندر

340
00:19:43,650 --> 00:19:48,790
!يملك ألكسندر اندفاعاً ويمكنه الهجوم 14 مرّة

341
00:19:48,790 --> 00:19:51,030
!أ-أربعة عشر مرّة؟

342
00:19:51,430 --> 00:19:55,200
!أهاجم خفّاشي الغابة بألكسندر

343
00:19:55,200 --> 00:19:59,300
!ثمّ تهاجم الرمّاحة المخضرمة قائدكما

344
00:20:00,600 --> 00:20:02,840
...كيف لي أنا وكو

345
00:20:02,840 --> 00:20:04,170
أن نخسر؟

346
00:20:04,540 --> 00:20:06,300
!أنه الأمر يا كاي

347
00:20:06,300 --> 00:20:08,600
!أعرف يا شيندو كازوكي

348
00:20:11,810 --> 00:20:16,950
!نهاجم قائدكما بالفارس المنتصر وساحر الزمن

349
00:20:33,890 --> 00:20:37,050
!أجل، فزنا بشكلٍ ما

350
00:20:37,050 --> 00:20:37,950
!اللعنة

351
00:20:40,840 --> 00:20:45,070
يبدو أنّكما لم تكونا فريستنا بعد

352
00:20:45,070 --> 00:20:46,460
!لكن لا تنسيا

353
00:20:46,460 --> 00:20:48,630
!ستصبحان كذلك يوماً ما

354
00:20:48,630 --> 00:20:49,720
إلى اللقاء

355
00:20:52,190 --> 00:20:55,260
كانا قويّين، فزنا بالكاد

356
00:20:55,260 --> 00:20:56,560
أجل

357
00:20:56,560 --> 00:20:59,210
!لحظة، لا وقت للإرهاق

358
00:20:59,210 --> 00:21:02,390
!عليّ القتال أكثر والتعويض عن الوقت الفائت

359
00:21:02,910 --> 00:21:04,410
!إلى اللقاء يا كاي

360
00:21:04,410 --> 00:21:06,260
ا-انتظر

361
00:21:06,650 --> 00:21:11,370
هذه المرّة قد... شكراً جزيلاً

362
00:21:11,730 --> 00:21:16,040
كنتُ لأخسر حتماً لو لم تكن معي يا كازوكي-سان

363
00:21:16,040 --> 00:21:19,940
فزتُ بفضلك

364
00:21:19,940 --> 00:21:21,520
!هذه أوّل مرة

365
00:21:22,080 --> 00:21:24,740
!أوّل مرة تناديني بكازوكي-سان

366
00:21:38,940 --> 00:21:41,530
!لقد رجع! اهرب يا كاي

367
00:21:44,490 --> 00:21:48,740
!لـ-لمَ يلاحقوني أيضاً؟

368
00:21:49,790 --> 00:21:53,400
!سئمتُ من هذا

369
00:23:24,170 --> 00:23:25,790
!استعراض بطاقات شادوفيرس

370
00:23:25,790 --> 00:23:28,180
!بطاقة اليوم هي فارس الهجوم

371
00:23:28,180 --> 00:23:31,670
تابع مميّز يحصل على اندفاع
إذا كان هناك قائد في الملعب

372
00:23:31,670 --> 00:23:34,450
توليفة القائد والفرسان هي أفضل
!ميزات فئة الملكيّ

373
00:23:34,450 --> 00:23:38,660
استعمل كازوكي كلمةً معقّدة! أهذا لأنّي قائده؟

374
00:23:38,880 --> 00:23:43,770
يثير وصول مُفاجئ للاعبين غامضين جدد
!الفوضى في مسابقة جائزة شادو الكبرى

375
00:23:38,890 --> 00:23:41,350
في الحلقة القادمة

376
00:23:43,770 --> 00:23:45,380
ما الذي يجري بالضبط؟

377
00:23:45,380 --> 00:23:47,710
!الحلقة القادمة: حاملو الظلّ

378
00:23:47,710 --> 00:23:50,350
!اختفت المروحيّة التي تحمل المعلّق

379
00:23:50,350 --> 00:23:53,650
!معركة! شادوفيرس