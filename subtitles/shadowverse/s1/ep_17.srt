!قدرة إلف الفرس المجنّح

204
00:13:54,280 --> 00:13:57,800
!تخفض دفاع أحد أتباع الخصم ليصبح 1

205
00:13:57,800 --> 00:13:58,780
...ثمّ

206
00:13:59,050 --> 00:14:01,050
!أطوّرها

207
00:14:01,520 --> 00:14:06,070
!تأثير تطوّرها يعطي ضرر 1 لتابع للخصم

208
00:14:08,100 --> 00:14:11,190
!ثمّ أهاجم مقاتل الهيكل العظميّ

209
00:14:15,450 --> 00:14:18,340
!وختاماً، ألعب جنّيةً وحارسة الإلف

210
00:14:18,630 --> 00:14:21,570
لعبتُ بطاقتين على الأقل هذا الدور

211
00:14:21,570 --> 00:14:26,090
لذا يرتفع هجوم ودفاع حارسة الإلف
!بمقدار 1، وتحصل على حاجز

212
00:14:26,090 --> 00:14:29,400
لم تهزمي أتباعي فحسب، بل لعبتِ توليفة؟

213
00:14:29,400 --> 00:14:31,420
أنتِ مثيرة للاهتمام حقّاً يا أوني-سان

214
00:14:33,040 --> 00:14:36,310
تظنّين ذلك؟ أنا عاديّة تماماً

215
00:14:36,690 --> 00:14:39,530
مهما فعلت، كنتُ في المنتصف دوماً

216
00:14:40,060 --> 00:14:42,480
أرى نفسي شخصاً مُملاً

217
00:14:42,910 --> 00:14:45,020
لم أستطع تغيير شيء

218
00:14:45,020 --> 00:14:48,740
وحتّى إن فعلت، لم يكن مهمّاً

219
00:14:50,170 --> 00:14:51,460
...لذا

220
00:14:52,290 --> 00:14:56,040
عندما رأيتُك أوّل مرّة، اعتقدتُ أنّك مُذهلة

221
00:14:57,790 --> 00:15:01,410
أعرف أنّها آليس-تشان التي
صنعها البالغون غالباً

222
00:15:01,410 --> 00:15:04,230
!لكنّك كنتِ مذهلة

223
00:15:04,230 --> 00:15:07,290
!أردتُ أن أصبح مثلك

224
00:15:07,290 --> 00:15:10,150
لكنّك لا تزالين مذهلة، حتّى الآن

225
00:15:10,150 --> 00:15:11,470
أنا عاديّة

226
00:15:11,470 --> 00:15:12,540
وما العيب في ذلك؟

227
00:15:13,090 --> 00:15:16,330
!أحبك وأنتِ عاديّة يا أوني-سان

228
00:15:17,270 --> 00:15:18,760
!اظهر يا دولاهان

229
00:15:18,760 --> 00:15:20,200
!تطوّر

230
00:15:20,900 --> 00:15:23,070
يتفعّل تأثير تطوّره

231
00:15:23,070 --> 00:15:25,300
ترتفع مقبرتي بمقدار 4

232
00:15:25,780 --> 00:15:27,580
!أهاجم حارسة الإلف

233
00:15:30,800 --> 00:15:32,700
!ثمّ صيد الأرواح

234
00:15:32,700 --> 00:15:34,840
!تُعطي ضرر 3 لإلف الفرس المجنّح

235
00:15:39,460 --> 00:15:41,940
كالمرّة السابقة يا أوني-سان

236
00:15:41,940 --> 00:15:43,970
أجل، أتذكّر

237
00:15:43,970 --> 00:15:49,230
لم أعد أعرف إن كان الأفضل
أن أكون مميّزة أو عاديّة

238
00:15:50,410 --> 00:15:52,080
ولا أنا

239
00:15:52,080 --> 00:15:54,810
الإجابة ليست بتلك البساطة

240
00:15:54,810 --> 00:15:58,780
لكن سنحصل على إجابة
هذه المعركة سريعاً، صحيح؟

241
00:15:58,780 --> 00:16:01,090
!لن أخسر يا آليس-تشان

242
00:16:01,420 --> 00:16:04,610
!هذه جملتي

243
00:16:05,690 --> 00:16:07,350
!إذاً، ها أنا ذي

244
00:16:07,350 --> 00:16:09,680
!دوري، سحب

245
00:16:10,070 --> 00:16:12,460
!أهاجم قائدك بجنّية أوّلاً

246
00:16:13,550 --> 00:16:16,380
!ثمّ ألعب شغب الجنّية

247
00:16:16,880 --> 00:16:19,660
!نعيد تابعاً لكلّ منّا ليد المالك

248
00:16:20,090 --> 00:16:23,810
!ثمّ ألعب 4 جنّيات من يدي

249
00:16:24,940 --> 00:16:26,660
!أطوّر إحداهن

250
00:16:30,090 --> 00:16:32,420
...أيعني هذا

251
00:16:32,420 --> 00:16:35,190
!أجل، هذه بطاقتي المفضّلة

252
00:16:35,510 --> 00:16:37,470
!تابعتي المفضّلة

253
00:16:37,900 --> 00:16:39,580
فلتحم الغابة الجنّيات

254
00:16:40,700 --> 00:16:43,550
!أرجوك أيّتها الجنّية اللامعة

255
00:16:53,760 --> 00:16:56,270
،لعبتُ 4 بطاقات على الأقل هذا الدور

256
00:16:56,270 --> 00:17:00,950
لذا تحصل كلّ جنّياتي على 2
!في الهجوم والدفاع، كما عاصفة

257
00:17:05,570 --> 00:17:08,580
!أهاجم قائدك بكلّ الجنّيات

258
00:17:08,580 --> 00:17:11,340
!طرن يا جنّياتي

259
00:17:17,230 --> 00:17:20,650
!آليس-تشان، هذه قوّتي الكاملة

260
00:17:20,980 --> 00:17:23,620
أنتِ قويّة بالفعل يا أوني-سان

261
00:17:23,620 --> 00:17:26,720
!بذلتُ كلّ ما لديّ، صدقاً

262
00:17:26,720 --> 00:17:27,630
فهمت

263
00:17:28,270 --> 00:17:31,600
عليّ بذل كلّ ما لدي بدوري

264
00:17:32,390 --> 00:17:34,990
عاملتك بقسوة، صحيح؟

265
00:17:34,990 --> 00:17:38,750
يحقّ لك كرهي، أليس كذلك؟

266
00:17:38,750 --> 00:17:40,620
!لكن... أرجوك

267
00:17:42,660 --> 00:17:44,330
!أعطني قوّتك

268
00:17:44,330 --> 00:17:46,330
!اركض معي

269
00:17:47,920 --> 00:17:49,900
،يا من يظهر من أعماق العالم السفليّ

270
00:17:51,590 --> 00:17:52,830
...اسمك

271
00:17:56,930 --> 00:17:58,670
!الهيكل العظميّ الراكب

272
00:18:00,760 --> 00:18:02,770
تابع بعاصفة؟

273
00:18:02,770 --> 00:18:04,310
...أهذا

274
00:18:04,310 --> 00:18:06,690
!أجل، إنّه تابعي المفضّل

275
00:18:06,690 --> 00:18:09,170
!يتفعّل تأثير الهيكل العظميّ الراكب

276
00:18:09,170 --> 00:18:12,060
بستّة استحضار أرواح، يدمّر تابعاً للخصم

277
00:18:14,720 --> 00:18:18,900
،كما كلّما يتدمر تابع للخصم في دورك

278
00:18:18,900 --> 00:18:21,220
!يصيب كلّ أتباع الخصم بضرر 1

279
00:18:22,390 --> 00:18:23,820
...لكن إذا كان هذا كلّ شيء

280
00:18:23,820 --> 00:18:25,000
!لم أنته بعد

281
00:18:25,000 --> 00:18:29,410
أخبرتك، يعطي ضرر 1 كلّما
تدمّر تابع، صحيح؟

282
00:18:29,410 --> 00:18:30,700
...إ-إذاً

283
00:18:30,700 --> 00:18:33,630
دمّر جنّية للتو، لذا يعطي ضرر 1 إضافيّ

284
00:18:35,320 --> 00:18:36,920
!وضرر 1 إضافيّ

285
00:18:36,920 --> 00:18:38,550
!وأخيراً، ضرر 1 إضافيّ

286
00:18:42,620 --> 00:18:47,540
ثمّ يعطي ضرر 1 لقائد الخصم
!مقابل كلّ تابع مُدمّر

287
00:18:51,610 --> 00:18:54,060
!ألعب المومياء الصغير من يدي

288
00:18:54,800 --> 00:18:57,320
!مع 4 استحضار أرواح، يحصل على عاصفة

289
00:18:57,930 --> 00:19:02,350
...فهمت، سبب استعمالك لدولاهان لملئ مقبرتك

290
00:19:02,350 --> 00:19:03,460
كان هذا؟

291
00:19:03,460 --> 00:19:05,200
!ها أنا ذي يا أوني-سان

292
00:19:05,950 --> 00:19:07,080
...آليس-تشان

293
00:19:07,080 --> 00:19:11,950
أهاجم قائدك بالهيكل العظميّ الراكب
!والمومياء الصغير اللذان لديهما عاصفة

294
00:19:12,250 --> 00:19:13,480
...مزّقا

295
00:19:14,950 --> 00:19:16,300
!كلّ شيء

296
00:19:37,770 --> 00:19:39,730
أنتِ قويّة حقّاً يا آليس-شان

297
00:19:39,730 --> 00:19:40,900
خسرت

298
00:19:41,210 --> 00:19:43,200
الفوز لي هذه المرّة

299
00:19:43,200 --> 00:19:46,270
لكنّك القويّة

300
00:19:46,270 --> 00:19:47,650
ليس صحيحاً

301
00:19:47,650 --> 00:19:49,960
!بلى

302
00:19:49,960 --> 00:19:52,040
استمتعتُ بوقتي يا أوني-سان

303
00:19:52,040 --> 00:19:54,500
!أنا كذلك

304
00:19:56,790 --> 00:20:00,320
عليّ إيجاد خصمي التالي إذاً

305
00:20:02,370 --> 00:20:05,490
سأكون مخلصةً لنفسي أكثر

306
00:20:05,490 --> 00:20:08,730
...بفضلك! لذا

307
00:20:10,050 --> 00:20:13,510
!أنتِ مميّزة بالنسبة لي

308
00:20:13,510 --> 00:20:15,750
لا تنسي ذلك

309
00:20:18,330 --> 00:20:19,650
!آليس-تشان

310
00:20:20,780 --> 00:20:27,350
!أنتِ مميّزة بالنسبة لي يا آليس-تشان
...لكن، أنتِ فتاة عاديّة

311
00:20:27,350 --> 00:20:33,540
!لذا... أنتِ فنّانة، لكنّك صديقتي مع ذلك! صديقتي

312
00:20:40,430 --> 00:20:42,700
صديقتي الأولى

313
00:20:42,700 --> 00:20:43,960
شكراً لك

314
00:20:45,370 --> 00:20:47,790
!إلى اللقاء يا آليس-تشان

315
00:20:47,790 --> 00:20:51,130
!لا تخسري! سأجتهد بدوري

316
00:20:53,560 --> 00:20:56,880
!أنت! هنا! هنا

317
00:20:59,950 --> 00:21:04,970
لاحقتني مختلف الحيوانات! هذا الخنزير البريّ
!ليس شيئاً يُذكر

318
00:21:17,320 --> 00:21:19,280
كان ذلك وشيكاً

319
00:21:29,730 --> 00:21:32,010
...فظيع

320
00:21:33,510 --> 00:21:35,220
...لكن

321
00:21:35,220 --> 00:21:37,190
أين أنا؟

322
00:21:37,810 --> 00:21:41,310
!هل تهت؟! هذا سيّئ حقّاً

323
00:21:41,770 --> 00:21:45,660
أيوجد أحد هنا؟! أيّ أحد؟

324
00:21:48,990 --> 00:21:50,540
...أذاك

325
00:21:48,990 --> 00:21:53,900
يا له من يوم جميل على الشاطئ

326
00:23:24,170 --> 00:23:26,000
!استعراض بطاقات شادوفيرس

327
00:23:26,000 --> 00:23:28,210
!بطاقة اليوم هي الهيكل العظميّ الراكب

328
00:23:28,210 --> 00:23:29,960
!بطاقتك المفضّلة يا آليس-تشان

329
00:23:29,960 --> 00:23:32,140
!لم أره قبلاً، لكن كان رائعاً

330
00:23:32,140 --> 00:23:35,680
!لديه عاصفة، ويمكنه التسبّب بضرر كبير
مُبهر، صحيح؟

331
00:23:35,680 --> 00:23:36,140
!نعم

332
00:23:36,140 --> 00:23:38,520
أريد فعل شيء جذّاب
!المرّة القادمة بدوري

333
00:23:38,850 --> 00:23:41,310
في الحلقة القادمة

334
00:23:38,860 --> 00:23:40,500
وصل كاي للمرتبة الفضّية

335
00:23:40,500 --> 00:23:42,750
وكازوكي الذي تلاحقه مُختلف الحيوانات

336
00:23:42,750 --> 00:23:44,970
!خصمهما هما زو وكو

337
00:23:44,970 --> 00:23:47,160
!حان وقت الصيد

338
00:23:47,160 --> 00:23:48,390
!لن يجدي الهرب

339
00:23:48,390 --> 00:23:51,530
!الحلقة القادمة: فخّ شنيع! زو وكو

340
00:23:51,530 --> 00:23:53,610
!معركة! شادوفيرس