1
00:00:04,420 --> 00:00:08,110
ما ستحصلون عليه هو هذا العالم عينه

2
00:00:09,810 --> 00:00:11,950
هذه شجرة الكوارث

3
00:00:11,950 --> 00:00:15,880
تجسّدٌ للمصائب قد خُتمت لآلاف السنين

4
00:00:15,880 --> 00:00:18,450
مُدمّرة العالم

5
00:00:18,450 --> 00:00:22,360
وستجلب شجرة الكوارث هذه
نهاية العالم

6
00:00:22,750 --> 00:00:24,070
...لا يُعقل

7
00:00:24,070 --> 00:00:25,830
كيف يمكن هذا؟

8
00:00:29,120 --> 00:00:30,080
!شيوري

9
00:00:30,370 --> 00:00:31,250
لوشيا؟

10
00:00:31,250 --> 00:00:32,700
ماذا نفعل؟

11
00:00:33,610 --> 00:00:36,060
يبدو أنّكم عقدتم عزيمتكم

12
00:00:36,060 --> 00:00:42,670
لكن أوّلاً، عليّ التحقّق من جدارتكم

13
00:00:44,170 --> 00:00:47,630
فليبدأ الاختبار الأخير

14
00:00:59,960 --> 00:01:01,320
ماذا؟

15
00:01:01,320 --> 00:01:02,450
ما هذا؟

16
00:01:02,450 --> 00:01:05,020
الباب الذي يقود للاختبار

17
00:01:05,590 --> 00:01:07,530
تقدّموا رجاءً

18
00:01:09,440 --> 00:01:12,480
علينا دخول كلّ باب
على حدة إذاً؟

19
00:01:13,230 --> 00:01:14,900
هذا مخيف نوعاً ما

20
00:01:14,900 --> 00:01:17,090
!نعم، مُريب جدّاً

21
00:01:19,710 --> 00:01:20,800
سأذهب

22
00:01:20,800 --> 00:01:21,940
وأنا

23
00:01:23,280 --> 00:01:24,390
!لنذهب

24
00:01:24,390 --> 00:01:25,760
!علينا ذلك

25
00:01:28,550 --> 00:01:31,220
رأيتم ذاك المشهد، صحيح؟

26
00:01:31,220 --> 00:01:32,870
علينا إنقاذ الجميع

27
00:01:33,990 --> 00:01:35,460
بالفعل

28
00:01:40,210 --> 00:01:42,460
!يا رفاق، نتقابل لاحقاً

29
00:01:42,460 --> 00:01:43,530
!نعم

30
00:01:54,350 --> 00:01:55,740
أتمنّى لكم التوفيق

31
00:03:50,730 --> 00:03:53,260
هذه قاعة الاختبار؟

32
00:03:56,810 --> 00:03:59,310
لا مجال للرجوع إذاً؟

33
00:03:59,780 --> 00:04:03,470
عليك إنقاذ العالم

34
00:04:03,850 --> 00:04:06,840
عليك تجاوز حدودك

35
00:04:07,580 --> 00:04:11,270
لذا سأطلق العنان لقوّتك

36
00:04:11,590 --> 00:04:12,570
!ليون

37
00:04:12,950 --> 00:04:16,180
،أُفضّل أن يناديني الجميع بالرئيس ليون

38
00:04:16,180 --> 00:04:19,600
لكن سأمنحك استثناءً

39
00:04:19,600 --> 00:04:21,270
...الاختبار الأخير إذاً

40
00:04:21,270 --> 00:04:25,150
نعم، أنت سريع البديهة

41
00:04:25,150 --> 00:04:27,150
صحيح، إنّها معركة

42
00:04:28,730 --> 00:04:34,710
سيواجه البقيّة من لم يستطيعوا
الحصول على حقّ إنقاذ العالم

43
00:04:34,710 --> 00:04:38,800
لاعبو شادوفيرس الأقوى الذين صنعتُهم

44
00:04:39,170 --> 00:04:45,670
وخصمك سيكون أنا، ليون أورانش

45
00:04:46,140 --> 00:04:50,900
إذا كنتُ سأحكم على جدارتك، وأعطيك حقّ إنقاذ العالم

46
00:04:50,900 --> 00:04:53,390
فيتوجّب أن أفعل هذا بنفسي

47
00:04:53,390 --> 00:04:56,850
لا أفهم ما الذي تتكلّم عنه

48
00:04:56,850 --> 00:04:58,300
ستفهم سريعاً

49
00:04:58,700 --> 00:05:00,450
هيّا، لنبدأ

50
00:05:00,450 --> 00:05:02,570
!نعم، لنفعلها

51
00:05:02,570 --> 00:05:05,300
!ستخبرني بكلّ شيء إذا فزت

52
00:05:05,300 --> 00:05:08,410
هذا سببٌ آخر كي أهزمك يا ليون

53
00:05:08,410 --> 00:05:10,220
يعجبني حماسك

54
00:05:10,220 --> 00:05:13,440
آمل أن تستطيع إلحاقه بأفعال

55
00:05:14,070 --> 00:05:16,330
!معركة! شادوفيرس

56
00:05:58,090 --> 00:06:00,390
دوري إذاً

57
00:06:01,270 --> 00:06:05,090
ألعب بطاقة التعويذة: المٌضخّم الأثري

58
00:06:10,840 --> 00:06:13,520
ما-ما هذه التعويذة؟

59
00:06:14,740 --> 00:06:16,390
أنهي دوري

60
00:06:17,010 --> 00:06:20,050
يتفعّل تأثير المُضخّم الأثري

61
00:06:20,050 --> 00:06:24,610
فأضيف بطاقتين لمجموعتي
عند نهاية دوري

62
00:06:27,230 --> 00:06:29,310
مـ-مجموعتك؟

63
00:06:30,180 --> 00:06:32,710
ما هذه التعويذة؟

64
00:06:32,710 --> 00:06:34,200
تبدو غريبة نوعاً ما

65
00:06:34,200 --> 00:06:36,870
ما الخطب يا فتى؟ إنّه دورك

66
00:06:37,970 --> 00:06:39,660
!دوري! سحب

67
00:06:41,260 --> 00:06:42,910
!ألعب التنّين العاجيّ

68
00:06:44,480 --> 00:06:45,910
أنهي دوري

69
00:06:45,910 --> 00:06:48,190
دوري إذاً

70
00:06:48,190 --> 00:06:49,870
أسد السحر الحديديّ

71
00:06:59,820 --> 00:07:01,330
المزيد من البطاقات لمجموعتك؟

72
00:07:01,780 --> 00:07:07,700
صحيح، أضاف تأثير أسد السحر الحديديّ بطاقتين لمجموعتي

73
00:07:07,700 --> 00:07:09,450
أنهي دوري

74
00:07:09,770 --> 00:07:13,740
تلك التعويذة وذاك التابع، إنّهما غريبان

75
00:07:13,740 --> 00:07:16,430
لا تشبه أيّ فئة قد واجهتها قبلاً

76
00:07:16,430 --> 00:07:17,070
!سحب

77
00:07:18,770 --> 00:07:21,600
ألعب تنّين العاصفة الرملية

78
00:07:23,320 --> 00:07:26,390
!وأهاجم قائدك بالتنّين العاجيّ

79
00:07:30,450 --> 00:07:32,010
أوخزني هذا

80
00:07:32,240 --> 00:07:34,140
سأردّ الدين إذاً

81
00:07:34,140 --> 00:07:36,140
دوري، سحب

82
00:07:37,640 --> 00:07:39,130
!ألعب هاملين

83
00:07:40,730 --> 00:07:43,150
يتفعّل تأثيره

84
00:07:43,150 --> 00:07:46,980
فأختار تابعاً تكلفته 3 أو أقلّ من يدي

85
00:07:46,980 --> 00:07:50,090
وأضيف بطاقةً بنفس الاسم ليدي

86
00:07:54,840 --> 00:07:58,270
أخفّض تكلفة أحد الأتباع
في يدي بمقدار 1

87
00:07:58,270 --> 00:08:01,620
وأضيف ثلاثة أتباع بنفس الاسم لمجموعتي

88
00:08:04,090 --> 00:08:05,700
!هذا غريب بالفعل

89
00:08:06,570 --> 00:08:10,370
!كلّ البطاقات التي تستعملها... إنّها غريبة

90
00:08:10,370 --> 00:08:11,460
!غريب

91
00:08:11,460 --> 00:08:13,210
لا توجد في أيّة فئة

92
00:08:14,030 --> 00:08:16,810
أصبت، كلامك صحيح

93
00:08:16,810 --> 00:08:19,980
مجموعتي تختلف عن جميع الفئات

94
00:08:19,980 --> 00:08:24,470
اظهرا يا تحفتيّ العزيزتين

95
00:08:25,820 --> 00:08:28,310
تحفتيّ؟

96
00:08:32,720 --> 00:08:34,370
ما-ماذا؟

97
00:08:34,810 --> 00:08:36,590
ما هذا؟

98
00:08:42,070 --> 00:08:44,360
ظهروا أخيراً

99
00:08:44,750 --> 00:08:47,500
أهذا تابع؟

100
00:08:53,030 --> 00:08:55,270
الأمر يصبح مسلّياً وفقما يبدو

101
00:08:56,120 --> 00:09:00,650
هذه قوّتك... بل قوّتكم إذاً؟

102
00:09:00,650 --> 00:09:05,990
نعم، هذه الحياة التي صنعتها أيدي البشر

103
00:09:05,990 --> 00:09:07,310
التحف

104
00:09:07,310 --> 00:09:09,120
ما هذا؟

105
00:09:09,520 --> 00:09:11,560
ما هي فئتك بالضبط؟

106
00:09:12,390 --> 00:09:13,560
الانتقام

107
00:09:13,560 --> 00:09:15,830
فئة الانتقام؟

108
00:09:15,830 --> 00:09:22,700
الفئة الثامنة الأقرب لشجرة الكوارث، فئة الانتقام

109
00:09:22,700 --> 00:09:27,080
احترس يا فتى، أنت مُنقذ العالم

110
00:09:27,080 --> 00:09:29,450
لا يمكنك الخسارة

111
00:09:31,470 --> 00:09:34,520
لكنّي لا أعرف كيفيّة التهاون

112
00:09:35,050 --> 00:09:38,100
إذا حطّمتُك، فأتأسّف

113
00:09:44,540 --> 00:09:45,720
!قويّ

114
00:09:45,720 --> 00:09:47,060
بالطبع

115
00:09:47,060 --> 00:09:51,270
أنا... بل نحن قد تمّ تدريبنا لنصبح أقوياء

116
00:09:51,930 --> 00:09:53,910
!تجهّزي

117
00:09:54,900 --> 00:09:56,560
!دورك

118
00:09:58,520 --> 00:10:01,420
!تطوّري أيّتها التحفة الغامضة

119
00:10:11,030 --> 00:10:15,340
لم يكن وجود هؤلاء الأتباع
داخل حساباتي

120
00:10:15,340 --> 00:10:19,380
لا يمكنك إنقاذ العالم إذا
لم تستطع هزيمتي

121
00:10:19,380 --> 00:10:24,260
لم تكن حساباتي دقيقة تماماً، لكنّي لم أقل
أنّي لا أستطيع الفوز

122
00:10:24,810 --> 00:10:27,430
!سأريك قوّتي

123
00:10:28,050 --> 00:10:29,950
هذا تابع مثير

124
00:10:29,950 --> 00:10:30,870
...أهو

125
00:10:31,720 --> 00:10:33,510
يخصّك فحسب؟

126
00:10:34,100 --> 00:10:37,840
أعطانا ليون-ساما هذه القوّة

127
00:10:37,840 --> 00:10:39,290
...بهذه القوّة سوف

128
00:10:39,640 --> 00:10:43,660
ترون إذا ما كان بإمكاننا
إنقاذ العالم، صحيح؟

129
00:10:44,950 --> 00:10:50,550
أخبريني، إذا كنتم ستختبروننا أفليس من الأفضل
أن تنقذوا العالم بأنفسكم؟

130
00:10:50,550 --> 00:10:52,400
لمَ لا تفعلون ذلك؟

131
00:10:54,750 --> 00:10:56,790
لا يمكنكم لسبب ما إذاً؟

132
00:10:56,790 --> 00:11:01,850
لا يهمّ، أنا لا أُحب أن أُختبر بالمناسبة

133
00:11:01,850 --> 00:11:03,950
فهذا رسميّ وما شابه

134
00:11:04,310 --> 00:11:05,820
...لذا

135
00:11:06,350 --> 00:11:08,180
!لنستمتع وحسب

136
00:11:08,180 --> 00:11:10,430
!سألعب معك

137
00:11:15,230 --> 00:11:17,180
أنهي دوري

138
00:11:17,180 --> 00:11:18,760
ليس سيّئاً

139
00:11:18,760 --> 00:11:21,570
أنت ناجح لحدّ الآن

140
00:11:21,940 --> 00:11:24,440
!لا يمكنني الخسارة

141
00:11:24,440 --> 00:11:28,830
لكنّ القدر الذي ينتظرك أكثر قسوة

142
00:11:29,800 --> 00:11:33,000
إذا لم تستطع استخراج قوّة
شادوفيرس الحقيقية

143
00:11:33,000 --> 00:11:34,820
لن تفوز أبداً

144
00:11:34,820 --> 00:11:36,200
القوّة الحقيقية؟

145
00:11:36,590 --> 00:11:38,500
قوّة القلب

146
00:11:40,570 --> 00:11:45,000
إذا هزمتني فسأعطيك إيّاها

147
00:11:45,990 --> 00:11:48,400
أتوقّع الكثير منك

148
00:11:48,400 --> 00:11:50,840
لا تخيّبني

149
00:11:51,680 --> 00:11:54,200
ألعب سبيني، حارسة الألغاز

150
00:12:02,050 --> 00:12:04,580
تابع أسطوريّ من فئة الانتقام؟

151
00:12:04,580 --> 00:12:10,290
يتفعّل تأثيرها فتُستدعى تحفتها للملعب

152
00:12:12,560 --> 00:12:16,220
تعطي تابع تحفتها القدرة
على التسبب بضرر 1

153
00:12:16,220 --> 00:12:21,250
لتابع عشوائيّ للخصم في نهاية دوري

154
00:12:24,220 --> 00:12:27,140
أطوّر سبيني، حارسة الألغاز

155
00:12:36,750 --> 00:12:39,300
وأهاجم التنّين حديديّ الحراشف

156
00:12:40,530 --> 00:12:42,400
وأنهي دوري

157
00:12:44,530 --> 00:12:47,530
!لكن لا يزال لديّ عظاءة النار

158
00:12:47,530 --> 00:12:51,050
ولا يزال لديّ تأثير تحفة سبيني

159
00:12:56,630 --> 00:12:58,490
!قـ-قويّة

160
00:13:02,700 --> 00:13:05,740
يمكنك تجاوز هذا

161
00:13:06,270 --> 00:13:09,340
!نعم، لن أخسر أبداً

162
00:13:20,200 --> 00:13:22,140
ألعب النبّالة الميكانيكيّة

163
00:13:24,160 --> 00:13:26,620
!بطاقة أخرى لا أعرفها

164
00:13:27,270 --> 00:13:30,980
لكن لديّ كلّ هؤلاء الأتباع الأٌقوياء

165
00:13:30,980 --> 00:13:33,200
أطوّر النبّالة الميكانيكيّة

166
00:13:35,510 --> 00:13:38,580
يتفعّل تأثير تطوّرها

167
00:13:38,580 --> 00:13:41,670
فأستطيع إلقاء بطاقة تحفة
واحدة من يدي

168
00:13:41,670 --> 00:13:44,970
وأصيب كلّ أعداء الخصم بضرر 2

169
00:13:54,760 --> 00:13:55,960
مثير للشفقة

170
00:13:56,510 --> 00:13:58,690
أأنت أحد المُختارين حقّاً؟

171
00:13:59,610 --> 00:14:03,140
...كانت أقرب لمصادفة من اختيار

172
00:14:03,140 --> 00:14:04,550
مصادفة؟

173
00:14:04,550 --> 00:14:07,030
!لا يمكنك إنقاذ العالم هكذا

174
00:14:07,030 --> 00:14:11,210
لا أعرف ما الذي تتكلّمين عنه حتّى

175
00:14:11,210 --> 00:14:13,540
لمَ أنت هنا إذاً؟

176
00:14:14,540 --> 00:14:21,950
واضح، لأنّه إذا كان العالم في ورطة
فلا بدّ من وجود شيء أستطيع القيام به

177
00:14:21,950 --> 00:14:24,040
!وعليّ فعلها وحسب

178
00:14:24,450 --> 00:14:27,540
بطاقة السحر: خطأ الأبعاد

179
00:14:30,520 --> 00:14:32,430
ماورا أبيلارد

180
00:14:32,430 --> 00:14:35,760
لا تذمر لديّ البتّة من اختيارك

181
00:14:35,760 --> 00:14:40,410
نحن رفيقان مشينا في الطريق
الوعر نفسه معاً

182
00:14:40,410 --> 00:14:42,010
رفيقان؟

183
00:14:42,480 --> 00:14:45,950
...لذا، عندما أفكّر بقدرك

184
00:14:48,280 --> 00:14:50,560
ما الذي تعرفه؟

185
00:14:51,700 --> 00:14:54,800
أنا وحدي أعرف قدري

186
00:14:55,670 --> 00:14:59,430
!لا تتصرّف كأنّك تعرف شيئاً

187
00:14:59,430 --> 00:15:02,270
!انبعث يا إله اللعنات

188
00:15:08,450 --> 00:15:13,210
ثمّ ألعب ملاك النور وأجنحة الإله الحديديّة

189
00:15:15,220 --> 00:15:17,660
يتفعّل تأثير ملاك النور

190
00:15:18,970 --> 00:15:24,100
فيسترجع دفاع قائدي
بمقدار 3، وأسحب بطاقة

191
00:15:25,270 --> 00:15:29,910
سأحمل عبئاً لا تستطيع حمله أبداً

192
00:15:30,350 --> 00:15:34,370
لا يمكنك فهمي

193
00:15:34,370 --> 00:15:40,090
!أنهي دوري، ويتفعّل تأثير إله اللعنات

194
00:15:41,880 --> 00:15:44,790
!ينخفض دفاع قائد الخصم بمقدار 5

195
00:15:46,000 --> 00:15:50,960
لا رفاق، ولا أصدقاء لديّ

196
00:15:54,770 --> 00:15:57,010
...يا للمسكين

197
00:15:57,620 --> 00:16:01,710
سأوقفك هنا

198
00:16:02,920 --> 00:16:04,910
!ألعب مُحاربة الجاذبيّة

199
00:16:05,880 --> 00:16:11,400
!يضيف تأثيرها تابعي تحفة عشوائيّين لمجموعتي

200
00:16:12,790 --> 00:16:14,640
لقد اُخترتم

201
00:16:15,030 --> 00:16:16,850
ولم نُختر نحن

202
00:16:17,300 --> 00:16:18,170
...لكن

203
00:16:18,170 --> 00:16:22,600
!إذا هزمناكم هنا، سنثبت أنّنا نعني شيئاً

204
00:16:22,600 --> 00:16:25,010
!ألعب تحفتين مُحلّلتين

205
00:16:28,770 --> 00:16:30,180
تعنون شيئاً؟

206
00:16:30,180 --> 00:16:34,000
شُكّل فرسان شادو لإنقاذ العالم

207
00:16:34,000 --> 00:16:37,600
خضنا تمريناً مُضنياً لإنقاذ العالم

208
00:16:37,930 --> 00:16:41,440
!لا يمكننا الخسارة لأمثالكم

209
00:16:41,440 --> 00:16:43,560
لا اهتمام لي بهذا

210
00:16:44,290 --> 00:16:47,210
إذا تدمّر العالم، ستختفي شيوري

211
00:16:47,210 --> 00:16:49,320
لا يمكنني السماح بذلك

212
00:16:49,320 --> 00:16:51,610
!لذا سأهزمك

213
00:16:51,610 --> 00:16:53,870
!بطاقة السحر: المخلب القاطع

214
00:16:54,610 --> 00:16:57,110
يتلقّى قائدي ضرر 2

215
00:16:57,820 --> 00:17:00,110
!وضرر 3 لقائدك

216
00:17:02,580 --> 00:17:05,710
!اعو! اغضب يا مصّاص الدماء القرمزيّ

217
00:17:06,610 --> 00:17:09,240
!يصيب كلّ أتباع الخصم بضرر 2

218
00:17:09,560 --> 00:17:13,790
،كما إذا تلقّى قائدي ضرراً هذا الدور

219
00:17:13,790 --> 00:17:17,470
!يصيب قائد الخصم وتابعاً واحداً له بضرر 3

220
00:17:19,060 --> 00:17:24,150
ثمّ ختاماً، يصيب قائدي بضرر 2

221
00:17:25,450 --> 00:17:28,030
آسف، لكنّي سأمضي للأمام

222
00:17:28,030 --> 00:17:30,360
لن يكون الأمر بتلك السهولة

223
00:17:30,360 --> 00:17:35,140
الكلمات الأخيرة للتحفة المُحلّلة تمكنني
من سحب بطاقتين من مجموعتي

224
00:17:35,360 --> 00:17:38,360
!لا يمكنني السماح  بذلك أيضًا

225
00:17:38,750 --> 00:17:40,450
!دوري! سحب

226
00:17:41,420 --> 00:17:43,330
!ألعب فارسة التنّين المُجنّح

227
00:17:45,550 --> 00:17:47,880
،يتفعّل تأثيرها

228
00:17:47,880 --> 00:17:50,880
فتنخفض تكلفة إحدى البطاقات
في يدي بمقدار 2

229
00:17:51,460 --> 00:17:54,920
أهذه خطوة نحو نصرك؟

230
00:17:55,340 --> 00:17:56,960
!نعم

231
00:17:56,960 --> 00:17:58,800
أطوّر فارسة التنّين المُجنّح

232
00:18:00,550 --> 00:18:02,340
!وأهاجم سبيني

233
00:18:03,500 --> 00:18:05,420
!أنهي دوري

234
00:18:05,690 --> 00:18:08,720
يبدو أنّك تستمتع بالمعارك

235
00:18:08,720 --> 00:18:10,940
حتّى عند تدهور الظروف

236
00:18:11,690 --> 00:18:14,020
روحك مُذهلة

237
00:18:14,020 --> 00:18:17,060
!لذا آمل أن تستمرّ بالاستجابة لتطلّعاتي

238
00:18:17,060 --> 00:18:19,940
!ألعب بطاقة السحر: الخلق العظيم

239
00:18:34,460 --> 00:18:39,650
وتضيف تحفة جينيسيس واحدة لمجموعتي

240
00:18:42,050 --> 00:18:47,170
وإذا كنتُ في طور رنين، تستدعي تحفة أثرية

241
00:18:51,310 --> 00:18:53,990
طـ-طور رنين؟

242
00:18:54,560 --> 00:18:57,490
القدرة الثانية الخاصّة لفئة الانتقام

243
00:18:57,490 --> 00:19:00,270
عندما يكون عدد البطاقات
،في مجموعتي زوجياً

244
00:19:00,270 --> 00:19:02,740
يصبح قائدي في طور رنين

245
00:19:02,740 --> 00:19:08,110
والبطاقات بالرنين يمكنها استعمال قوّتها الكاملة

246
00:19:08,110 --> 00:19:11,570
أهاجم فارسة التنّين المُجنح
بتحفتي الأثريّة

247
00:19:12,680 --> 00:19:15,760
!وأهاجم قائدك بتحفة سبيني

248
00:19:18,200 --> 00:19:19,580
أنهي دوري

249
00:19:19,580 --> 00:19:20,980
حان دورك

250
00:19:33,870 --> 00:19:35,060
!هيّا بنا

251
00:19:35,330 --> 00:19:37,490
سأرى قوّة فئة التنانين الحقيقيّة، صحيح؟

252
00:19:37,490 --> 00:19:39,170
!أجل

253
00:19:39,170 --> 00:19:40,030
!سحب

254
00:19:40,890 --> 00:19:42,110
...أنا

255
00:19:42,110 --> 00:19:43,610
...لحظة

256
00:19:44,160 --> 00:19:46,570
لا يزال الوقت باكراً على استدعائه

257
00:19:46,870 --> 00:19:48,180
...إذاً

258
00:19:48,180 --> 00:19:49,990
!ألعب تنّين البحر

259
00:19:49,990 --> 00:19:53,380
يعطيه تأثير طور الفيض خاصته عاصفة

260
00:19:55,920 --> 00:20:00,920
!انطلق! أهاجم القائد بتنّين البحر

261
00:20:02,890 --> 00:20:05,050
أنهي دوري

262
00:20:05,050 --> 00:20:07,280
ماذا؟ أهذا كلّ شيء؟

263
00:20:07,280 --> 00:20:09,480
لا بطاقات ممتازة في يدك؟

264
00:20:10,040 --> 00:20:11,800
ليس صحيحاً البتّة

265
00:20:11,800 --> 00:20:14,090
لديّ البطاقات التي أحتاجها لهزيمتك

266
00:20:14,090 --> 00:20:15,060
فهمت

267
00:20:15,060 --> 00:20:16,980
أتطلّع لذلك

268
00:20:16,980 --> 00:20:21,020
لكن إذا تهاونت، قد تنتهي المباراة

269
00:20:21,020 --> 00:20:22,440
سحب

270
00:20:22,920 --> 00:20:26,940
أهاجم تنّين البحر أوّلاً بتحفة سبيني

271
00:20:29,110 --> 00:20:32,450
تتفعّل الكلمات الأخيرة لتحفة سبيني

272
00:20:34,040 --> 00:20:38,400
فأضيف بطاقة تحفة واحدة
من مجموعتي ليدي

273
00:20:38,950 --> 00:20:40,920
...هذه البطاقة... أهي

274
00:20:40,920 --> 00:20:44,190
صحيح، المفضّلة لي

275
00:20:44,430 --> 00:20:46,800
حسناً، لنبدأ الحتميّ

276
00:20:46,800 --> 00:20:49,100
هذا هو الوجود الخالق

277
00:20:49,100 --> 00:20:50,940
الذي يضع قوانين الكون

278
00:20:53,600 --> 00:20:54,800
...و

279
00:20:56,120 --> 00:20:59,220
الاختبار الذي عليك مواجهته قطعاً

280
00:21:04,810 --> 00:21:08,130
!تجلّي لي يا تحفة جينيسيس

281
00:21:08,130 --> 00:21:10,310
!عـ-عملاق

282
00:21:13,650 --> 00:21:15,740
ريوغاساكي هيرو

283
00:21:15,740 --> 00:21:19,000
ابن ريوغاساكي إيجي الوحيد

284
00:21:19,610 --> 00:21:22,250
لطالما انتظرتُك

285
00:21:22,560 --> 00:21:24,760
كنت تعرف أبي إذاً؟

286
00:21:25,240 --> 00:21:26,850
بالطبع

287
00:21:26,850 --> 00:21:29,090
فهو صديقي

288
00:21:29,090 --> 00:21:32,200
أو كان صديقي بالأحرى

289
00:21:32,200 --> 00:21:35,010
كان صديقك؟ ما قصدك؟

290
00:21:36,100 --> 00:21:39,150
سأخبرك بقصّة من الماضي إذاً

291
00:21:39,720 --> 00:21:42,950
عن يوم اختفائه معها

292
00:21:44,020 --> 00:21:49,460
ويوم بدء العدّ التنازلي لدمار العالم

293
00:23:24,130 --> 00:23:25,760
!استعراض بطاقات شادوفيرس

294
00:23:26,290 --> 00:23:28,680
!بطاقة اليوم هي لكمة التنّين

295
00:23:28,680 --> 00:23:32,310
بطاقة سحر قويّة تصيب
أتباع الخصم بضرر، صحيح؟

296
00:23:32,310 --> 00:23:35,770
نعم! لكن عليك إلقاء بطاقة من يدك

297
00:23:35,770 --> 00:23:38,450
عليك توخّي الحذر عند استعمالها إذاً

298
00:23:38,850 --> 00:23:41,310
في الحلقة القادمة

299
00:23:39,580 --> 00:23:42,930
!كيف أستطيع هزيمة تحفة جينيسيس الخاصة بليون؟

300
00:23:43,180 --> 00:23:47,660
إذا ورثتَ قوّة إيجي، فستستطيع تجاوز هذا

301
00:23:47,660 --> 00:23:49,860
!الحلقة القادمة: بركات وكوارث

302
00:23:50,250 --> 00:23:52,390
!معركة! شادوفيرس