1
00:01:35,800 --> 00:01:40,160
إذا واصلتَ الصراع، فلن تلقى إلّا المزيد من العناء بلا طائل

2
00:01:40,520 --> 00:01:42,160
لا تنهض

3
00:01:42,620 --> 00:01:47,000
تخلَّ عن كلّ شيء، واحلم

4
00:01:50,620 --> 00:01:51,860
...كلا

5
00:01:52,080 --> 00:01:57,500
دُمّرت بطاقتك الرابحة، واختفت بطاقتك الأسطوريّة

6
00:01:58,050 --> 00:02:01,230
!إنّها النهاية، لقد خسرت

7
00:02:01,580 --> 00:02:04,820
...كلا، لم أخسر

8
00:02:05,380 --> 00:02:09,390
وعدتُ بأنّي لن أخسر هذه المرّة

9
00:02:10,340 --> 00:02:12,790
...لذا سوف

10
00:02:15,780 --> 00:02:19,150
أجل، قطعنا وعداً بالفعل

11
00:02:19,450 --> 00:02:20,470
روين

12
00:02:21,070 --> 00:02:25,390
،وعدتك أنّه عندما تكون في خطر
سأهبّ لنجدتك حتماً

13
00:02:25,870 --> 00:02:27,970
وسأقف معك

14
00:02:28,750 --> 00:02:31,680
!أعرني قوّتك يا روين

15
00:02:31,680 --> 00:02:32,720
!أجل

16
00:02:32,720 --> 00:02:36,650
!لإنقاذ هذا العالم، والأناس الأعزّاء عليك

17
00:02:37,160 --> 00:02:38,690
!هيّا بنا يا هيرو

18
00:02:39,920 --> 00:02:41,680
ما الذي حصل؟

19
00:02:41,990 --> 00:02:45,630
يحصل تنّين الشعلة اللا متناهية
!على كلمات جديدة أخيرة

20
00:02:45,630 --> 00:02:49,910
تتحوّل البطاقة التالية التي
!أسحبها لتنّين النار

21
00:02:52,090 --> 00:02:57,540
ويحصل تنّين النار على كلّ تأثيرات
!تنّين الشعلة اللا متناهية

22
00:03:00,310 --> 00:03:01,600
!سأفوز

23
00:03:01,600 --> 00:03:03,430
،سأتجاوزك، والعالم

24
00:03:03,430 --> 00:03:05,460
"وكلمة "استسلام

25
00:03:05,750 --> 00:03:07,790
!سأفوز بالتأكيد

26
00:03:08,090 --> 00:03:10,030
!أنا معك

27
00:03:10,310 --> 00:03:13,080
!زمجر يا تنّين النار

28
00:03:19,290 --> 00:03:22,970
!يتفعّل التأثير الجديد لتنّين النار

29
00:03:22,970 --> 00:03:25,310
!يصيب قائد الخصم بضرر 5

30
00:03:28,470 --> 00:03:33,280
أهاجم بتنّين النار المطوّر
!تنّين نار الظلّ

31
00:03:35,080 --> 00:03:38,110
!ردّ الهجوم يا تنّين نار الظلّ

32
00:03:44,110 --> 00:03:48,370
!عزّز "عويل الظلّ" قوّة تنّين نار الظلّ

33
00:03:48,690 --> 00:03:50,900
!فلتتجرّع الهزيمة يا هيرو

34
00:03:50,900 --> 00:03:52,870
!لا يمكن لأداتك هزيمتي

35
00:03:52,870 --> 00:03:54,830
!ليس أداة

36
00:03:54,830 --> 00:03:57,380
!بل رفيقي

37
00:03:57,740 --> 00:04:01,510
أعطت الكلمات الأخيرة التي محنها تنّين
الشعلة اللا متناهية لتنّين النار

38
00:04:11,340 --> 00:04:12,360
!ماذا؟

39
00:04:12,360 --> 00:04:14,370
!رفيقي قويّ

40
00:04:14,370 --> 00:04:16,840
!لذا يمكنني الذهاب حيثما أريد

41
00:04:17,060 --> 00:04:20,190
!انطلق

42
00:04:29,520 --> 00:04:34,710
هزمتَ أداتي، لكنّك لا تزال
لا تملك دفاعاً

43
00:04:35,040 --> 00:04:37,990
وترفض الاستسلام مع ذلك؟

44
00:04:38,310 --> 00:04:39,210
!أجل

45
00:04:39,210 --> 00:04:42,030
!فهو لا يزال يستطيع الطيران

46
00:04:42,460 --> 00:04:44,120
،أخبرتُك يا أبي

47
00:04:44,120 --> 00:04:49,120
يملك تنّين النار الآن كلّ تأثيرات
!تنّين الشعلة اللا متناهية

48
00:04:51,640 --> 00:04:52,670
أيمكن؟

49
00:04:52,670 --> 00:04:55,930
!يتفعّل التأثير الجديد لتنّين النار

50
00:04:56,120 --> 00:04:58,530
،عندما يهاجم تابعاً للخصم

51
00:04:58,530 --> 00:05:03,570
!يصيب قائده بضرر مكافئ لنقاط هجومه

52
00:05:04,610 --> 00:05:06,900
!سأمضي للأمام

53
00:05:07,110 --> 00:05:10,020
!زمجر يا تنّين النار

54
00:05:18,740 --> 00:05:21,460
هذه قوّتك إذاً؟

55
00:05:21,720 --> 00:05:24,690
لقد... فزت

56
00:05:25,840 --> 00:05:28,290
أجل، خسرت

57
00:05:28,710 --> 00:05:30,460
سأؤمن بك

58
00:05:34,630 --> 00:05:35,870
ما هذا؟

59
00:05:35,870 --> 00:05:42,890
يحوي هاتفك الذكيّ جزءاً من نفس القوّة التي
صنعتُها وأساغي لإيقاف نيكسس

60
00:05:43,550 --> 00:05:51,790
،لم أتمكّن من إتقان استعمالها قطّ
لكنّي متأكّد بإمكانك ذلك الآن

61
00:05:52,770 --> 00:05:54,090
فهمت

62
00:05:54,090 --> 00:05:58,020
كنتُ مرتبطاً بك طوال الوقت إذاً يا أبي؟

63
00:06:01,610 --> 00:06:05,330
أردتُ القيام بكلّ شيءٍ بنفسي

64
00:06:05,710 --> 00:06:08,510
دون مساعدة أحد

65
00:06:09,180 --> 00:06:13,430
لكن ربما هذا ما كنت أبتغيه

66
00:06:13,910 --> 00:06:17,020
لعلّي أردت ائتمانك على كلّ شيء

67
00:06:17,300 --> 00:06:18,690
هذا ما أعتقده

68
00:06:19,090 --> 00:06:23,900
أجل، وأظنّك استدعيتني هنا
أيضاً يا أبي

69
00:06:26,190 --> 00:06:30,430
هيرو، فلتنقذ هذا العالم، وتنقذ أساغي

70
00:06:30,850 --> 00:06:33,380
!أجل، دع الأمر لي يا أبي

71
00:06:38,310 --> 00:06:40,130
!انتظريني يا نيكسس

72
00:06:40,130 --> 00:06:43,390
!سأهزمك حتماً وأنقذ العالم

73
00:07:30,050 --> 00:07:32,450
يسرّني وصولك

74
00:07:33,650 --> 00:07:35,420
...أ-أيمكن

75
00:07:38,850 --> 00:07:40,020
أمّي؟

76
00:07:40,590 --> 00:07:43,390
أجل، أنا أساغي

77
00:07:43,390 --> 00:07:45,790
قلبها بالتحديد

78
00:07:46,230 --> 00:07:50,730
جسدي تحت سيطرة نيكسس

79
00:07:51,220 --> 00:07:53,900
لطالما كان يخصّها لوقتٍ طويل

80
00:07:54,930 --> 00:07:58,060
...حتّى لو أنقذت العالم إذاً، ستبقى أمّي

81
00:07:59,880 --> 00:08:02,070
مُذهلٌ أيّها الفتى

82
00:08:03,460 --> 00:08:06,000
أبهرتني بحقّ

83
00:08:06,000 --> 00:08:10,920
وفيتَ بآمالي، بل تجاوزتها

84
00:08:10,920 --> 00:08:13,100
ليون؟ لمَ أنت هنا؟

85
00:08:13,690 --> 00:08:15,220
هل استيقظت أيضاً؟

86
00:08:15,390 --> 00:08:19,150
أجل، كنتُ قد جهّزت لتحضيرات
قبل وقتٍ طويل

87
00:08:19,150 --> 00:08:21,710
فاستطعتُ الاستيقاظ

88
00:08:21,710 --> 00:08:22,900
تحضيرات؟

89
00:08:23,450 --> 00:08:26,950
أكنت تعرف حصول هذا؟

90
00:08:26,950 --> 00:08:30,800
ابتلاع شجرة الكوارث للعالم؟

91
00:08:30,800 --> 00:08:32,310
أجل

92
00:08:32,310 --> 00:08:36,560
!و... القوّة العظيمة، أتت هنا

93
00:08:37,230 --> 00:08:38,900
!وصلت أخيراً

94
00:08:38,900 --> 00:08:40,210
!انتبه يا هيرو

95
00:08:42,290 --> 00:08:43,540
!أمّي

96
00:08:44,630 --> 00:08:47,690
أنا حاكم هذا العالم

97
00:08:52,540 --> 00:08:53,570
ما الذي فعلته؟

98
00:08:53,920 --> 00:08:57,160
!تعالي لي يا نيكسس

99
00:09:00,800 --> 00:09:01,850
!أمّي

100
00:09:16,610 --> 00:09:18,900
فهمت، ليس سيّئاً البتّة

101
00:09:19,220 --> 00:09:20,950
هذه نيكسس إذاً

102
00:09:21,310 --> 00:09:23,170
أ-أين أمّي؟

103
00:09:23,350 --> 00:09:25,820
امتصصتُها مع نيكسس

104
00:09:25,820 --> 00:09:28,290
إنّها راقدة داخلي

105
00:09:28,290 --> 00:09:29,300
!ليون

106
00:09:29,300 --> 00:09:31,710
لا تبد غاضباً هكذا

107
00:09:32,020 --> 00:09:38,950
...ما تسعى له، وهذا العالم... وكلّ شيء

108
00:09:39,430 --> 00:09:42,350
!لنسوّ النتيجة هنا

109
00:09:42,700 --> 00:09:46,710
!أجل، هذه المعركة النهائيّة بيني وبينك

110
00:09:47,280 --> 00:09:50,120
!معركة! شادوفيرس

111
00:10:04,940 --> 00:10:06,730
...أستعمل فارسة التنّين آيلا

112
00:10:08,430 --> 00:10:09,920
!وأهاجم ماينيو

113
00:10:17,220 --> 00:10:21,630
!ثمّ أهاجم قائدك بتنّين العاصفة الرمليّة

114
00:10:22,720 --> 00:10:23,980
هكذا إذاً

115
00:10:24,770 --> 00:10:26,640
أنهي دوري

116
00:10:26,930 --> 00:10:29,700
مذهلٌ بحقّ

117
00:10:29,700 --> 00:10:31,850
يمكنني استشعار نموّك

118
00:10:34,150 --> 00:10:37,540
!لأجل هدفي، مشروع نيكسس

119
00:10:39,030 --> 00:10:41,230
!ألعب كاهنة الكارثة

120
00:10:41,650 --> 00:10:44,040
ما هو مشروع نيكسس؟

121
00:10:44,360 --> 00:10:47,440
،عندما ظهرت شجرة الكوارث قبلاً

122
00:10:47,440 --> 00:10:53,730
كانت هنالك خطّة لاستغلال قوّتها
لتطوير البشريّة للمستوى التالي

123
00:10:53,730 --> 00:10:56,270
لكنّك لا تحتاج لتوضيح، صحيح؟

124
00:10:56,270 --> 00:10:58,400
فقد شهدتها بالفعل

125
00:10:58,400 --> 00:11:00,720
!إنّها هذه، هذا العالم

126
00:11:00,990 --> 00:11:04,600
خطّة ختم كلّ شيءٍ
داخل شجرة الكوارث

127
00:11:04,600 --> 00:11:06,740
!ذلك مشروع نيكسس

128
00:11:07,110 --> 00:11:09,490
عالم الأكاذيب هذا؟

129
00:11:09,490 --> 00:11:10,580
أكاذيب؟

130
00:11:10,580 --> 00:11:11,980
وما في ذلك؟

131
00:11:12,500 --> 00:11:15,730
يبقى الأمان أماناً، زائفاً أم لا

132
00:11:15,730 --> 00:11:18,280
ستتطوّر البشريّة، وسيختفي الحزن

133
00:11:18,480 --> 00:11:23,110
لن تتبلّل أيّة خدود هنا بالدموع

134
00:11:23,110 --> 00:11:27,960
لا يعطيك ذلك حقّ احتجاز
!الجميع في حلم

135
00:11:27,960 --> 00:11:30,700
لا أطلب منك التفهّم

136
00:11:30,700 --> 00:11:33,460
أهاجم قائدك بالراهبة المخلصة

137
00:11:35,930 --> 00:11:41,660
،إذا قضيت عليكم أيّها السبعة المختارون
سيكتمل مشروع نيكسس

138
00:11:41,660 --> 00:11:44,570
وهذا كلّ ما عليّ فعله

139
00:11:45,560 --> 00:11:47,920
...كنتَ من البداية إذاً

140
00:11:47,920 --> 00:11:48,920
صحيح

141
00:11:49,990 --> 00:11:52,710
...المسابقة الوطنية، ومسابقة جائزة شادو الكبرى

142
00:11:52,970 --> 00:11:55,600
والطريق المؤدي لشجرة الكوارث

143
00:11:55,600 --> 00:12:01,360
كانت كلّها جزءاً من خطّتي لأصبح إلهاً

144
00:12:01,360 --> 00:12:04,520
!أطوّر كاهنة الكارثة

145
00:12:06,830 --> 00:12:09,290
،يتفعّل تأثير تطوّرها

146
00:12:09,290 --> 00:12:15,280
فتدمّر أحد أتباعي وتستدعي
كاهنة كارثة أخرى

147
00:12:16,790 --> 00:12:21,030
ثمّ يتفعّل تأثير تطوّرها الآخر

148
00:12:26,540 --> 00:12:29,600
هـ-هذا... من ذاك الوقت

149
00:12:29,600 --> 00:12:33,100
بطاقة التعويذة: حرم عرين الأسد

150
00:12:33,500 --> 00:12:37,910
!أهاجم بكاهنة الكارثة المطوّرة تنّين البيروكسين

151
00:12:42,910 --> 00:12:46,660
!تتفعّل الكلمات الأخيرة لتنّين البيروكسين
!أسحب ثلاث بطاقات

152
00:12:47,670 --> 00:12:50,730
كانت كلّها وفق خطّتك إذاً؟

153
00:12:50,730 --> 00:12:52,030
أجل

154
00:12:52,030 --> 00:12:57,410
لكن أيّها الفتى، الضعفاء وحدهم
يهدرون وقتهم بالخطط

155
00:12:58,100 --> 00:13:05,000
فخطّتي في النهاية جعلتني أدرك
مدى عجزي لا أكثر

156
00:13:05,270 --> 00:13:07,930
،لإنجاح مشروع نيكسس

157
00:13:07,930 --> 00:13:15,060
احتجتُ للبطاقات الأسطوريّة لهزيمة
إيجي والظلال الفارغة

158
00:13:15,500 --> 00:13:19,770
لكنّي لم أملك حقّ امتلاكها

159
00:13:19,770 --> 00:13:25,860
ولم تكن النسخ المقلّدة التي صنعتُها
قريبةً منها حتّى

160
00:13:26,240 --> 00:13:28,680
كانت بائسة

161
00:13:28,990 --> 00:13:33,070
لكنّي لم أستطع الاستسلام

162
00:13:33,350 --> 00:13:36,790
لذا قرّرتُ جمع المختارين

163
00:13:36,790 --> 00:13:39,010
وجعلهم يستعملون البطاقات الأسطوريّة

164
00:13:39,010 --> 00:13:43,010
وأمهّد لهم الطريق
إلى شجرة الكوارث

165
00:13:43,010 --> 00:13:48,890
استغلّيتُك وماورا لأجل خطّتي

166
00:13:49,580 --> 00:13:51,590
استغلّيتَ ماورا حتّى؟

167
00:13:51,590 --> 00:13:53,170
أجل، صحيح

168
00:13:53,170 --> 00:13:56,490
أفادني ذاك الشيء أكثر مما ظننت

169
00:13:56,940 --> 00:13:58,220
!الشيء؟

170
00:13:58,430 --> 00:14:03,990
عندما أعطاه إيجي القوّة، تمكّنتُ من الحصول
على بيانات قيّمة

171
00:14:03,990 --> 00:14:11,870
سبب تمكّني من التحكّم بقوّة نيكسس الآن
هو لأنّه كان تجربةً مفيدة

172
00:14:12,780 --> 00:14:15,900
...ليون، أنت

173
00:14:15,900 --> 00:14:17,460
!ألعب حارس التنّين

174
00:14:19,110 --> 00:14:20,170
!تطوّر

175
00:14:22,200 --> 00:14:24,580
!هاجم كاهنة الكارثة

176
00:14:26,740 --> 00:14:31,340
وأهاجم كاهنة الكارثة الأخرى
!بتنّين العاصفة الرمليّة

177
00:14:35,920 --> 00:14:37,310
فهمت

178
00:14:37,310 --> 00:14:41,640
أنتَ منفعلٌ هكذا لأنّ ذاك الشيء كان رفيقك

179
00:14:41,640 --> 00:14:44,200
!لا تناده بالشيء! اسمه ماورا

180
00:14:44,200 --> 00:14:46,870
لا أمانع هذا

181
00:14:46,870 --> 00:14:50,740
فعواطفك تصنع الثغرات بك

182
00:14:50,740 --> 00:14:52,120
!ملاك اللمعان

183
00:14:53,730 --> 00:14:55,220
...هذه البطاقة

184
00:14:55,860 --> 00:14:58,340
أجل، البطاقة التي أعطيتُه إيّاها

185
00:15:02,010 --> 00:15:07,320
يسترجع تأثيرها دفاع قائدي
بمقدار 3، وأسحب بطاقة

186
00:15:08,190 --> 00:15:10,930
كان ساذجاً بحقّ

187
00:15:10,930 --> 00:15:14,130
كلّا، كلّ البشر سُذّج

188
00:15:14,860 --> 00:15:19,500
يمكن لبطاقة واحدة التحكّم بهم

189
00:15:19,500 --> 00:15:20,390
تطوّر

190
00:15:24,530 --> 00:15:28,570
أهاجم حارس التنّين بملاك اللمعان

191
00:15:31,650 --> 00:15:35,860
!أتعرف كم عانى ماورا بسببك؟

192
00:15:35,860 --> 00:15:37,280
بالطبع

193
00:15:37,660 --> 00:15:41,080
فقد أعطيتُه البطاقة كي يعاني

194
00:15:42,480 --> 00:15:46,240
!ليون

195
00:15:47,280 --> 00:15:48,080
عجباً

196
00:15:48,080 --> 00:15:50,460
!سحب! راكب التنّين

197
00:15:54,470 --> 00:15:56,850
!بطاقة السحر: اتّقاد التنّين

198
00:15:58,800 --> 00:16:03,520
!تسترجع دفاع قائدي بمقدار 3، وأسحب بطاقتين

199
00:16:09,530 --> 00:16:13,750
!ليون، سأهزمك هنا حتماً

200
00:16:15,050 --> 00:16:18,900
أجل، جميل، جميلٌ بالفعل

201
00:16:25,470 --> 00:16:29,220
آسف، فقدتُ السيطرة لوهلة

202
00:16:29,460 --> 00:16:31,530
أنت ابنه حقّاً

203
00:16:31,530 --> 00:16:33,100
تذكّرني به كثيراً

204
00:16:33,100 --> 00:16:39,040
قد يكون القدر هو سبب
!قتالي لك هنا بالفعل

205
00:16:41,430 --> 00:16:43,940
حسناً، حان وقت اختبارك

206
00:16:51,190 --> 00:16:53,240
...هـ-هذا

207
00:16:54,250 --> 00:16:57,460
،إذا كان حرم عرين الأسد في ملعبي

208
00:16:57,460 --> 00:17:00,100
!يتطوّر التنّين المقدّس

209
00:17:06,660 --> 00:17:08,950
!هاجم راكب التنّين

210
00:17:10,000 --> 00:17:12,830
يملك التنّين المقدّس هلاكاً

211
00:17:13,640 --> 00:17:16,770
ولا يتلقّى ضرراً من المعركة

212
00:17:17,770 --> 00:17:21,640
كما يتفعّل تأثير حرم عرين الأسد

213
00:17:21,640 --> 00:17:28,210
عندما يتدمّر أحد أتباعك، تتلقّى ضرراً
مكافئاً لنقاط هجومه

214
00:17:30,630 --> 00:17:35,820
،وعندما يدمّر الأسد المقدّس تابعاً للخصم بهجوم

215
00:17:37,690 --> 00:17:42,460
نحصل الاثنان على بطاقة السحر: مباركة عرف الأسد

216
00:17:45,070 --> 00:17:47,340
ألعب مباركة عرف الأسد

217
00:17:47,930 --> 00:17:52,820
،يُضاف آخر تابع لعبتُه إلى يدي
وتصبح تكلفته صفراً

218
00:17:53,170 --> 00:17:54,480
...ثمّ

219
00:17:55,830 --> 00:17:57,190
يحصل هذا

220
00:18:00,260 --> 00:18:03,290
حسناً، لو قبلت مباركتي

221
00:18:03,290 --> 00:18:06,350
قد تستطيع الفوز كما فعلتَ المرّة الفائتة

222
00:18:07,170 --> 00:18:11,890
تُلقى مباركة عرف الأسد من يدي
في نهاية الدور

223
00:18:11,890 --> 00:18:12,500
...لذا

224
00:18:12,500 --> 00:18:14,270
!دوري! سحب

225
00:18:14,640 --> 00:18:16,430
أرى أنّك في عجلة

226
00:18:16,430 --> 00:18:18,490
لن أستعمل قوّتك

227
00:18:18,490 --> 00:18:21,100
!سأفوز بقوّتي أنا

228
00:18:21,430 --> 00:18:23,290
!ألعب قبضة التنّين البشريّ

229
00:18:23,290 --> 00:18:26,190
،ألقي البطاقة الأقلّ تكلفة في يدي

230
00:18:26,690 --> 00:18:29,330
!وأصيب تابعاً عشوائياً للخصم بضرر 2

231
00:18:29,330 --> 00:18:31,060
يحصل هذا مرّتين

232
00:18:31,060 --> 00:18:33,930
!ألقي مباركة عرف الأسد

233
00:18:35,330 --> 00:18:36,670
لستَ مسليّاً البتّة

234
00:18:37,630 --> 00:18:39,710
!انطلقي

235
00:18:43,840 --> 00:18:45,280
!لم أنته بعد

236
00:18:45,280 --> 00:18:47,920
!بطاقة السحر: الحريق الهائل

237
00:19:03,860 --> 00:19:05,070
ما رأيك؟

238
00:19:05,070 --> 00:19:07,550
لا أحتاج قوّتك

239
00:19:07,550 --> 00:19:09,250
ساذج

240
00:19:09,760 --> 00:19:14,460
تصيب قبضة التنّين البشريّ
تابعاً عشوائياً بضرر، أليس كذلك؟

241
00:19:14,460 --> 00:19:18,180
إذا أصابت نفس الأسد المقدّس
...في كلتيّ المرّتين

242
00:19:20,070 --> 00:19:24,490
أنت مثل إيجي بالفعل، متهوّر ومهمل

243
00:19:24,790 --> 00:19:26,520
أنهي دوري

244
00:19:26,800 --> 00:19:30,640
...أتذكّر ذاك الوقت بوضوح

245
00:19:30,640 --> 00:19:31,950
ذاك الوقت؟

246
00:19:31,950 --> 00:19:34,480
أخبرتك قبلاً، أليس كذلك؟

247
00:19:34,480 --> 00:19:39,320
كيف بدأت قصّتي وقصّة إيجي وأساغي

248
00:19:39,950 --> 00:19:43,860
اختارت شجرة الكوارث أساغي حاويةً لها

249
00:19:43,860 --> 00:19:49,610
لذا يا ليون، اصنع طريقةً للتخلّص
!من هذا وإنقاذ العالم

250
00:19:51,120 --> 00:19:53,370
جرى كلّ شيءٍ وفق الخطّة

251
00:19:54,190 --> 00:19:57,970
أنا من سبّب هيجان شجرة الكوارث

252
00:19:57,970 --> 00:20:01,310
كنتُ أعرف أنّها ستختار أساغي حاويةً لها

253
00:20:01,310 --> 00:20:05,570
وأنّ إيجي سيلحق بها

254
00:20:05,570 --> 00:20:09,970
كانا تهديداً لمشروع نيكسس

255
00:20:10,560 --> 00:20:12,900
فتخلّصتُ منهما

256
00:20:13,250 --> 00:20:20,630
كان إيجي بطيئاً في إدراك أنّ لا أحد
يستطيع إيقاف تطوّر البشريّة

257
00:20:20,920 --> 00:20:23,860
ليون، لأيّ حدٍّ تتمادى؟

258
00:20:24,310 --> 00:20:25,980
تروقني هذه التعابير

259
00:20:25,980 --> 00:20:30,520
هذا الغضب والكراهيّة... تعجباني كشرّير

260
00:20:30,960 --> 00:20:32,590
!دوري

261
00:20:35,790 --> 00:20:40,460
سأعطيك لمحةً لقوّة
تتجاوز المعرفة البشريّة

262
00:20:44,430 --> 00:20:45,920
!ما-ماذا؟

263
00:20:47,400 --> 00:20:48,830
فهمت

264
00:20:48,830 --> 00:20:52,560
هذا شيءٌ... مبهر بالفعل

265
00:20:52,560 --> 00:20:54,410
ما هذا السحر؟

266
00:20:55,000 --> 00:20:58,160
إنّها القوّة التي تحكم العالم

267
00:20:58,510 --> 00:21:02,070
!رائع! رائع حقّاً

268
00:21:02,490 --> 00:21:05,550
!بطاقة السحر: طور الظلّ

269
00:21:06,690 --> 00:21:09,920
!ينتقل قائدي لطور الظلّ

270
00:21:12,240 --> 00:21:14,450
طـ-طور الظلّ؟

271
00:21:14,830 --> 00:21:19,650
تتغيّر البطاقات في يدي لبطاقات
تحف وبطاقات ظلّ

272
00:21:20,210 --> 00:21:22,980
تتدمّر كلّ البطاقات في ملعبي

273
00:21:23,420 --> 00:21:28,220
!وتتحوّل مجموعتي لتصبح مجموعة ظلّ

274
00:21:28,640 --> 00:21:30,260
مجموعة ظلّ؟

275
00:21:30,260 --> 00:21:33,760
!حسناً أيّها الفتى، وقت الصراخ

276
00:21:33,760 --> 00:21:37,430
!تحفة التحليل: هجوم الظلّ

277
00:21:39,760 --> 00:21:44,980
فلتصح وتبتهج، وترتجف ذعراً

278
00:21:44,980 --> 00:21:49,110
لأنّك تشهد ولادة إله

279
00:23:24,180 --> 00:23:26,060
!استعراض بطاقات شادوفيرس

280
00:23:26,350 --> 00:23:28,820
!هذه بطاقة اليوم: طور الظلّ

281
00:23:28,820 --> 00:23:31,010
هذه بطاقة خاصّة يستعملها ليون

282
00:23:31,010 --> 00:23:33,000
تقوم بتحويل قائدها

283
00:23:33,000 --> 00:23:35,360
لكنّنا سنكون بخير، أليس كذلك؟

284
00:23:35,360 --> 00:23:38,440
!أجل! سنفوز حتماً وننقذ العالم

285
00:23:38,890 --> 00:23:41,400
في الحلقة القادمة

286
00:23:39,100 --> 00:23:41,270
أنا إله هذا العالم

287
00:23:41,270 --> 00:23:45,320
!فلتبك! فلتجهش! خسارتك هنا

288
00:23:45,320 --> 00:23:48,820
!لن أخسر... لن نخسر أبداً

289
00:23:48,820 --> 00:23:50,950
!الحلقة القادمة: وقت التطوّر

290
00:23:50,950 --> 00:23:53,120
!معركة! شادوفيرس