1
00:00:05,980 --> 00:00:07,430
!لوشيا

2
00:00:07,430 --> 00:00:09,310
!هيرو

3
00:00:27,410 --> 00:00:29,320
!رنين، رنين

4
00:00:29,320 --> 00:00:31,250
!وقت الاستيقاظ

5
00:00:31,250 --> 00:00:32,960
...إن لم تستيقظ

6
00:00:37,390 --> 00:00:38,310
!هيرو

7
00:00:38,310 --> 00:00:40,020
!هلّا استيقظت؟

8
00:00:40,020 --> 00:00:41,730
!فعلت

9
00:00:49,070 --> 00:00:50,700
صباح الخير يا جدّي

10
00:00:50,700 --> 00:00:51,910
صباح الخير

11
00:00:59,200 --> 00:01:00,490
وقت الأكل

12
00:01:04,640 --> 00:01:06,860
هلّا ناولتني صلصة الصويا
من فضلك يا جدّي؟

13
00:01:08,400 --> 00:01:09,870
والملح

14
00:01:11,090 --> 00:01:12,430
وصلصة ورشستر

15
00:01:13,880 --> 00:01:15,390
واشتر لي هاتفاً ذكيّاً

16
00:01:15,680 --> 00:01:18,400
كلا، لن تنطلي عليّ

17
00:01:18,400 --> 00:01:20,000
!أرجوك يا جدّي

18
00:01:20,000 --> 00:01:21,140
!كلا

19
00:01:21,830 --> 00:01:23,900
كنتُ أعرف أنّ هذا لن ينجح

20
00:01:23,900 --> 00:01:26,140
حسناً، أيّاً يكن

21
00:01:34,590 --> 00:01:36,240
أبي، أمّي

22
00:01:37,370 --> 00:01:39,490
!أنا ذاهب يا جدّي

23
00:01:39,490 --> 00:01:41,090
!توخَّ الحذر

24
00:01:41,090 --> 00:01:42,210
!حاضر

25
00:01:47,090 --> 00:01:48,330
هيرو

26
00:01:53,310 --> 00:01:55,740
ما كان... ذلك؟

27
00:02:28,200 --> 00:02:31,780
أهذا... هاتف ذكيّ؟

28
00:02:38,260 --> 00:02:39,750
!ا-اشتغل؟

29
00:02:42,760 --> 00:02:45,270
مرحباً هيرو"؟"

30
00:02:45,270 --> 00:02:48,020
أيمكن أنّه هاتفي؟

31
00:02:48,020 --> 00:02:51,110
!أجل! لا بدّ من ذلك

32
00:02:59,160 --> 00:03:01,290
مرحباً؟ هل تسمعني؟

33
00:03:01,680 --> 00:03:06,280
!رائع! رائع! اشترى جدّي لي هاتفاً ذكيّاً

34
00:03:08,030 --> 00:03:09,060
صدقًا؟

35
00:03:09,060 --> 00:03:11,200
!شادوفيرس مثبّت فيه بالفعل

36
00:03:15,760 --> 00:03:17,170
!آ-آسف

37
00:03:48,880 --> 00:03:50,350
!أجل! أجل

38
00:03:50,350 --> 00:03:51,880
كيف إذاً يا ميموري؟ استسلمتِ؟

39
00:03:51,880 --> 00:03:56,000
كازوكي-كن، لا تنتهي شادوفيرس
حتّى آخر دور

40
00:03:57,300 --> 00:04:00,630
ميموري، أيمكنك قلب الطاولة يا ترى؟

41
00:04:00,630 --> 00:04:02,120
أجل، بالفعل

42
00:04:05,810 --> 00:04:09,650
سأستعمل نقاط تطويري الآن
لتطوير ساحرة إلف المعدنية

43
00:04:14,070 --> 00:04:15,890
!وأهاجم قائدك

44
00:04:18,400 --> 00:04:20,810
!انطلقا

45
00:04:26,200 --> 00:04:27,820
!فعلتِها يا ميموري

46
00:04:27,820 --> 00:04:29,290
مُبهر

47
00:04:29,290 --> 00:04:32,260
!تبّاً! خسرت مجدداً

48
00:04:33,140 --> 00:04:35,820
!مباراة أخرى يا ميموري

49
00:04:37,430 --> 00:04:38,830
نفد الوقت

50
00:04:39,320 --> 00:04:40,830
!بأمان

51
00:04:40,830 --> 00:04:42,130
وصلت في الوقت

52
00:04:42,130 --> 00:04:43,530
هيرو

53
00:04:43,530 --> 00:04:44,810
صباح الخير يا هيرو-كن

54
00:04:44,810 --> 00:04:45,720
صباح الخير

55
00:04:45,720 --> 00:04:48,560
!انظروا لهذا

56
00:04:48,560 --> 00:04:50,390
!إنّه هاتف ذكيّ

57
00:04:50,390 --> 00:04:54,630
صحيح! يمكنني لعب شادوفيرس
!أخيراً الآن

58
00:04:54,630 --> 00:04:56,300
!تهانينا يا هيرو-كن

59
00:04:56,300 --> 00:04:57,660
!حسناً يا هيرو

60
00:04:57,660 --> 00:04:59,650
!لنتقاتل فوراً

61
00:04:59,650 --> 00:05:00,260
!أجل

62
00:05:00,640 --> 00:05:03,280
وقت نزالنا أتى أخيراً

63
00:05:03,280 --> 00:05:06,270
أجل، لطالما انتظرتُ هذا اليوم

64
00:05:06,270 --> 00:05:09,110
عجباً، هكذا إذاً

65
00:05:10,570 --> 00:05:12,630
يبدو أنّكما تستمتعان بوقتكما

66
00:05:12,630 --> 00:05:14,320
!جدّاً

67
00:05:14,320 --> 00:05:16,070
آمل الانضمام لكما

68
00:05:16,070 --> 00:05:18,010
انتظر فقط، ستلعب تالياً

69
00:05:18,010 --> 00:05:20,570
أخشى ليس بإمكاني الانتظار

70
00:05:21,030 --> 00:05:23,570
...إيساوساكي سينسي

71
00:05:23,570 --> 00:05:25,250
ريوغاساكي، شيندو

72
00:05:25,250 --> 00:05:26,790
أيمكنني بدء الحصّة؟

73
00:05:27,120 --> 00:05:29,810
!بـ-بالطبع

74
00:05:32,320 --> 00:05:34,800
!وقت الأكل

75
00:05:38,020 --> 00:05:41,280
...لا تأكلا بهذه العجلة وإلّا

76
00:05:44,520 --> 00:05:46,090
هاكما شاياً

77
00:05:49,750 --> 00:05:51,130
نجونا

78
00:05:51,130 --> 00:05:52,410
شكراً لك يا ميموري

79
00:05:52,800 --> 00:05:54,540
على الرحب

80
00:05:54,540 --> 00:05:55,650
!حسنٌ

81
00:05:55,650 --> 00:05:57,160
!لنبدأ إذاً

82
00:05:57,160 --> 00:05:58,360
!هذا ما أريده

83
00:05:58,360 --> 00:06:00,180
يحبّان شادوفيرس حقاً

84
00:06:00,180 --> 00:06:01,380
بالفعل

85
00:06:01,380 --> 00:06:03,580
...معركة! شادو

86
00:06:03,580 --> 00:06:05,630
!ريوغاساكي! شيندو

87
00:06:05,630 --> 00:06:09,100
ساعداني بحمل الأشياء التي نحتاجها
لدرس الفنون ليوم الغد

88
00:06:14,350 --> 00:06:16,130
!ثـ-ثقيلة

89
00:06:16,130 --> 00:06:18,770
كازوكي، أتحمل طرفك حقاً؟

90
00:06:18,770 --> 00:06:20,110
أجل

91
00:06:20,110 --> 00:06:23,370
لمَ أنت مُسترخٍ هكذا إذاً؟

92
00:06:23,370 --> 00:06:26,110
لأنّي أتمرن بخلافك

93
00:06:30,650 --> 00:06:32,130
أنا مُرهق

94
00:06:33,840 --> 00:06:35,660
انظر للوقت

95
00:06:35,660 --> 00:06:38,140
لا يمكننا القتال الآن

96
00:06:38,140 --> 00:06:41,680
لنذهب لملعب شادوفيرس بعد المدرسة إذاً

97
00:06:41,680 --> 00:06:43,460
!فكرة رائعة! لنذهب

98
00:06:43,460 --> 00:06:44,920
!حُسِم الأمر إذاً

99
00:06:53,420 --> 00:06:54,660
!ميموري

100
00:06:54,960 --> 00:06:57,030
ما الخطب؟ ماذا جرى؟

101
00:06:57,490 --> 00:06:59,980
أُخذ هاتف ميموري

102
00:07:00,770 --> 00:07:02,200
من أخذه؟

103
00:07:02,200 --> 00:07:03,100
لمَ؟

104
00:07:03,780 --> 00:07:05,860
لعبت شادوفيرس مع كيباكورا تاكوما

105
00:07:07,300 --> 00:07:09,480
كيباكورا تاكوما؟

106
00:07:09,480 --> 00:07:12,760
...بعدما استدعاكما الأستاذ

107
00:07:15,240 --> 00:07:19,690
أخبروني، من أفضل لاعب
شادوفيرس في هذه الأرجاء؟

108
00:07:20,240 --> 00:07:21,290
من هذا؟

109
00:07:21,290 --> 00:07:23,400
!كيباكورا تاكوما

110
00:07:23,400 --> 00:07:24,420
لا تنظري

111
00:07:24,420 --> 00:07:26,500
تجاهليه فقط

112
00:07:26,500 --> 00:07:28,670
فليأت الأقوى بينكم

113
00:07:28,670 --> 00:07:31,510
سنراهن بهواتفنا في معركة

114
00:07:31,510 --> 00:07:34,770
ماذا؟ لا أحد يريد اللعب؟

115
00:07:35,440 --> 00:07:39,120
سأواجهكم جميعاً إذاً

116
00:07:40,380 --> 00:07:43,280
أأنت أوّل من سيُسحق؟

117
00:07:43,950 --> 00:07:46,310
أم أنت؟

118
00:07:46,310 --> 00:07:47,710
!توقّف

119
00:07:49,120 --> 00:07:50,810
سأواجهك أنا

120
00:07:50,810 --> 00:07:53,610
!توقّفي يا ميموري! لا تفعليها

121
00:07:57,220 --> 00:07:59,640
أنتِ الأقوى؟

122
00:07:59,640 --> 00:08:01,570
مُحال

123
00:08:01,570 --> 00:08:03,220
أ-أنا قويّة

124
00:08:05,460 --> 00:08:07,190
...لـ-لذا

125
00:08:07,190 --> 00:08:10,200
!ارحل بعدما تنتهي المعركة

126
00:08:12,980 --> 00:08:14,580
لا بأس

127
00:08:14,580 --> 00:08:17,220
إن كان بإمكانك تسليتي

128
00:08:17,540 --> 00:08:18,730
!معركة

129
00:08:19,340 --> 00:08:21,220
!شادوفيرس

130
00:08:21,560 --> 00:08:25,100
!ليثم، قائد الطليعة

131
00:08:26,220 --> 00:08:28,810
كان قويّاً جدّاً

132
00:08:29,420 --> 00:08:32,160
خسرت ميموري في لمح البصر

133
00:08:32,880 --> 00:08:37,150
لا يملك الضعفاء حقّ
لعب شادوفيرس

134
00:08:38,020 --> 00:08:41,180
ثمّ سرق هاتفها؟

135
00:08:41,960 --> 00:08:43,270
لا بأس

136
00:08:44,220 --> 00:08:46,300
إنّها غلطتي للخسارة

137
00:08:46,300 --> 00:08:47,920
أعتذر على جعلكما تقلقان

138
00:09:01,910 --> 00:09:02,780
حسنٌ

139
00:09:02,780 --> 00:09:04,340
!إلى اللقاء يا ميموري

140
00:09:05,190 --> 00:09:06,520
أراك غداٍ

141
00:09:07,180 --> 00:09:09,180
!أجل، أراك غداً

142
00:09:16,520 --> 00:09:18,510
أين تذهب؟

143
00:09:18,510 --> 00:09:22,190
أليس واضحاً؟ لأكلّم كيباكورا تاكوما

144
00:09:22,190 --> 00:09:24,460
أين بالضبط؟

145
00:09:27,160 --> 00:09:32,380
آسف، أدركتُ أنّي لا أعرف
أين هو بعد التفكير

146
00:09:33,000 --> 00:09:35,100
!كما ظننت

147
00:09:35,590 --> 00:09:37,340
ملعب شادوفيرس؟

148
00:09:37,630 --> 00:09:40,230
أجل، أظنّه هناك غالباً

149
00:09:40,230 --> 00:09:42,330
حسنٌ، لندخل فوراً

150
00:09:42,330 --> 00:09:45,190
!ريوغاساكي! شيندو

151
00:09:47,860 --> 00:09:50,110
!ساعداني بحمل التمثال الجديد

152
00:09:50,110 --> 00:09:53,440
!انظر! إنّها كوروباني أليس-تشان

153
00:09:53,440 --> 00:09:54,600
!ماذا؟

154
00:09:59,110 --> 00:10:02,920
شيندو، لا أرى أليس-تشان

155
00:10:02,920 --> 00:10:05,430
اشتبهت عليّ

156
00:10:04,630 --> 00:10:06,070
ماذا؟ أين ريوغاساكي؟

157
00:10:06,070 --> 00:10:09,040
!دعك منه، لنحمل ذاك التمثال

158
00:10:09,070 --> 00:10:10,130
أ-أجل

159
00:10:16,410 --> 00:10:20,230
!ميموري، سأستعيد هاتفك مهما كلّف الأمر

160
00:10:52,950 --> 00:10:55,610
أتريد الفوز بقلب أليس؟

161
00:10:55,610 --> 00:10:58,780
لنتواجه في شادوفيرس إذاً

162
00:10:59,090 --> 00:11:01,000
:تذكّر هذه العبارة

163
00:11:01,000 --> 00:11:03,260
"!معركة! شادوفيرس"

164
00:11:03,670 --> 00:11:05,090
!سأنتظرك في الملعب

165
00:11:11,240 --> 00:11:13,160
!من كان ذلك؟ هذا خطر

166
00:11:16,810 --> 00:11:20,770
أنت كيباكورا تاكوما، صحيح؟

167
00:11:24,260 --> 00:11:26,020
من أنت؟

168
00:11:27,760 --> 00:11:29,830
أنا ريوغاساكي هيرو

169
00:11:29,830 --> 00:11:33,690
تاكوما، أخذت هاتف ميموري في المدرسة اليوم، صحيح؟

170
00:11:34,880 --> 00:11:37,040
وماذا إن فعلت؟

171
00:11:37,040 --> 00:11:38,840
!واجهني يا تاكوما

172
00:11:38,840 --> 00:11:42,040
!وإن فزت، عليك إعادة هاتفها

173
00:11:42,560 --> 00:11:47,360
!لا بأس، لكن إن فزتُ أنا سآخذ هاتفك

174
00:12:17,800 --> 00:12:18,840
!هيّا بنا

175
00:12:20,130 --> 00:12:21,370
!أرني ما لديك

176
00:12:21,760 --> 00:12:24,350
!معركة! شادوفيرس

177
00:13:19,070 --> 00:13:21,980
هذه شادوفيرس إذاً؟

178
00:13:21,980 --> 00:13:23,850
!دوري أوّلاً

179
00:13:23,850 --> 00:13:25,480
!ألعب قرصان الفأس

180
00:13:28,190 --> 00:13:29,600
!مُذهل

181
00:13:29,600 --> 00:13:32,210
!حسناً، دوري هو التالي، صحيح؟

182
00:13:35,340 --> 00:13:37,750
!ألعب التنّين العاجيّ

183
00:13:42,580 --> 00:13:43,890
أنهي دوري

184
00:13:44,440 --> 00:13:45,960
ما الطريف؟

185
00:13:45,960 --> 00:13:48,140
ليس طريفاً، بل مُسلٍّ

186
00:13:48,140 --> 00:13:50,800
!لطالما أردت خوض معركة

187
00:13:51,560 --> 00:13:53,880
أأنت مُبتدئ؟

188
00:13:53,880 --> 00:13:55,900
!هذه معركتي الأولى

189
00:13:57,260 --> 00:13:58,820
فهمت

190
00:13:59,390 --> 00:14:01,390
!اظهر يا نائب القائد غيلت

191
00:14:03,140 --> 00:14:06,370
سأعلّمك كيف هي المعركة

192
00:14:07,000 --> 00:14:09,910
!اسحقه يا قرصان الفأس

193
00:14:17,700 --> 00:14:21,940
تستخفّ بي، أتظن بإمكانك هزيمتي
حقّاً يا مُبتدئ؟

194
00:14:21,940 --> 00:14:23,190
أنهي دوري

195
00:14:23,190 --> 00:14:25,650
!أجل، سأهزمك بالطبع

196
00:14:26,220 --> 00:14:28,210
!ها أنا ذا، وسيط التنّين الروحي

197
00:14:29,040 --> 00:14:34,230
تُضاف نقطة لنقاط لعبي
بتأثير هذا السحر

198
00:14:34,230 --> 00:14:38,340
!والآن أستعمل التنّين العاجي لمهاجمة قائدك

199
00:14:44,010 --> 00:14:45,240
!فعلتُها

200
00:14:45,240 --> 00:14:46,350
أنهي دوري

201
00:14:46,350 --> 00:14:48,910
يسعدك هذا القدر؟

202
00:14:48,910 --> 00:14:51,370
يا لك من مبتدئ وضيع

203
00:14:52,090 --> 00:14:54,360
!سأريك مقامك

204
00:14:54,360 --> 00:14:56,600
!اسحقوه الآن

205
00:14:57,370 --> 00:15:00,030
!تبّاً لك! انطلقي يا عُظاءة اللهب

206
00:15:00,030 --> 00:15:01,530
!لن يكفي هذا

207
00:15:01,530 --> 00:15:03,030
!نل منه يا فارس

208
00:15:03,030 --> 00:15:06,040
!أجل! مزّقه هكذا

209
00:15:14,980 --> 00:15:17,060
تبقت 5 من نقاطك فقط

210
00:15:17,060 --> 00:15:20,070
!لا يمكنك هزيمتي

211
00:15:22,690 --> 00:15:27,110
أيُعقل أنّك تخال
باستطاعتك الفوز بعد؟

212
00:15:28,130 --> 00:15:29,250
!أجل

213
00:15:29,250 --> 00:15:32,750
!هكذا إذاً، يمكنك تخيّل ذلك في موتك

214
00:15:33,200 --> 00:15:34,490
!دوري

215
00:15:37,540 --> 00:15:39,320
هذه النهاية

216
00:15:39,320 --> 00:15:41,750
!انطلق يا قائد الطليعة ليثم

217
00:15:41,750 --> 00:15:42,920
!ها أنا ذا

218
00:15:44,010 --> 00:15:45,860
!تطوّر

219
00:15:54,000 --> 00:15:56,860
!لتمزّقه الآن

220
00:16:03,260 --> 00:16:04,520
هذه ليست النهاية

221
00:16:04,520 --> 00:16:08,780
يمكنه صنع فارس مع كلّ هجومٍ له

222
00:16:09,140 --> 00:16:12,520
ما رأيك؟ لا تزال مُختلاً بنفسك؟

223
00:16:18,020 --> 00:16:20,010
!التطوّر مُذهل

224
00:16:20,010 --> 00:16:21,690
!هذا حماسي حقاً

225
00:16:21,690 --> 00:16:23,780
!شادوفيرس مسليّة جدّاً

226
00:16:24,840 --> 00:16:26,290
مسليّة؟

227
00:16:26,290 --> 00:16:30,070
!اخرس! أهاجم قائدك بالفارس الحديديّ

228
00:16:33,440 --> 00:16:35,580
والآن ألعب لصّاً

229
00:16:35,580 --> 00:16:36,680
أنهي دوري

230
00:16:37,050 --> 00:16:39,620
لا نقاط تطوّر لديك

231
00:16:39,620 --> 00:16:41,600
لا يمكنك قلب الطاولة

232
00:16:41,600 --> 00:16:44,700
أفهمت أنّ التسلية لا تكفي للفوز؟

233
00:16:44,700 --> 00:16:47,410
هيّا، اسحب بطاقتك الأخيرة

234
00:16:49,070 --> 00:16:50,690
بطاقتي الأخيرة؟

235
00:16:50,690 --> 00:16:52,120
ليس بعد

236
00:16:52,970 --> 00:16:55,810
!لا تزال المعركة في بدايتها

237
00:16:56,660 --> 00:16:59,070
!دوري! سحب

238
00:17:07,430 --> 00:17:08,750
!اعو

239
00:17:08,750 --> 00:17:10,520
!تنّين النار

240
00:17:14,240 --> 00:17:17,920
!فات الأوان على أن تساعدك تلك البطاقة

241
00:17:17,920 --> 00:17:23,690
يمكنني تطويره دون الحاجة لنقاط تطوّر
عندما تكون لديّ بطاقتين أو أقلّ في يدي

242
00:17:23,690 --> 00:17:26,580
!تطوّر يا تنّين النار

243
00:17:35,140 --> 00:17:36,440
!ماذا؟

244
00:17:36,440 --> 00:17:40,790
!أهاجم الفارس الحديدي بتنّين النار

245
00:17:45,660 --> 00:17:48,420
!تتفعّل قدرة تنّين النار الهجومية

246
00:17:48,840 --> 00:17:56,630
عند هجومه يعطي ضرر 3 نقاط
!لكلّ أتباع الخصم

247
00:18:01,610 --> 00:18:03,140
!يا لقوّته

248
00:18:04,090 --> 00:18:05,590
ما رأيك يا تاكوما؟

249
00:18:06,010 --> 00:18:08,360
!تبّاً! دوري

250
00:18:10,280 --> 00:18:12,520
لمُدافع السراب حاجز

251
00:18:12,860 --> 00:18:17,280
!لا تستطيع مهاجمتي حتى تدمّر هذا التابع

252
00:18:18,110 --> 00:18:20,750
تبقت لك 3 نقاط

253
00:18:20,750 --> 00:18:23,610
!هزيمتك واضحة

254
00:18:23,940 --> 00:18:25,360
!أنهي دوري

255
00:18:29,810 --> 00:18:33,660
لا تعرف من سيفوز أو يخسر
!في شادوفيرس حتى النهاية

256
00:18:33,660 --> 00:18:34,890
!دوري

257
00:18:36,380 --> 00:18:38,760
!ألعب موشوسو

258
00:18:38,760 --> 00:18:42,860
!وأهاجم مُدافع السراب بالتنّين العاجي

259
00:18:44,060 --> 00:18:46,050
!رائع! أنهي دوري

260
00:18:48,670 --> 00:18:50,830
اظهر يا شيطان غوبلينماونت

261
00:18:51,190 --> 00:18:53,850
لديه حاجز أيضاً

262
00:18:53,860 --> 00:18:56,440
مهما بلغت قوّة أتباعك

263
00:18:56,440 --> 00:18:59,150
لا يمكنك الوصول لي قبل هزيمته

264
00:19:00,440 --> 00:19:01,920
أنهي دوري

265
00:19:02,490 --> 00:19:04,060
!في الدور التالي

266
00:19:04,060 --> 00:19:07,570
!في الدور التالي سأريك هزيمتك

267
00:19:07,570 --> 00:19:10,700
!سأنهي المواجهة في هذا الدور إذاً

268
00:19:10,990 --> 00:19:13,220
!ها أنا ذا! سحب

269
00:19:14,350 --> 00:19:17,060
ألعب غضب التنّين

270
00:19:18,360 --> 00:19:21,760
تٌصيب شيطان غوبلينماونت بضرر 6 نقاط

271
00:19:28,510 --> 00:19:32,410
!ثمّ أهاجمه بموشوسو

272
00:19:35,720 --> 00:19:37,380
وما المهم؟

273
00:19:37,380 --> 00:19:41,470
!لديّ 10 نقاط دفاع، ولأتباعك 5 نقاط هجوم

274
00:19:41,860 --> 00:19:43,860
!لستُ واثقاً من ذلك

275
00:19:43,860 --> 00:19:48,330
ترتفع قوّة هجوم التنّين العاجيّ
!بخمس نقاط عندما يهاجم

276
00:19:48,910 --> 00:19:50,160
ماذا؟

277
00:19:50,160 --> 00:19:51,350
...لذا

278
00:19:52,540 --> 00:19:55,620
!تصبح قوّة هجوم التنّين العاجيّ 10

279
00:19:57,080 --> 00:19:59,430
!مُحال! كيف يمكن؟

280
00:20:00,520 --> 00:20:03,220
!ها أنا ذا يا تاكوما

281
00:20:16,000 --> 00:20:17,640
!أجل

282
00:20:24,030 --> 00:20:27,160
خسرت مجدداً؟

283
00:20:27,470 --> 00:20:30,650
...تبّاً! أخي هكذا لن

284
00:20:37,920 --> 00:20:40,920
!كان ذلك مُسلياً جدّاً! شكراً لك

285
00:20:42,420 --> 00:20:45,790
أعد هاتف ميموري الآن كما اتّفقنا

286
00:20:45,790 --> 00:20:48,810
ليس معي، أعطيته ليونازوكي

287
00:20:48,810 --> 00:20:50,430
ماذا؟ ما قصدك؟

288
00:20:50,430 --> 00:20:53,080
!خسرتُ أمام يونازوكي لوشيا

289
00:20:53,080 --> 00:20:55,680
لذا أعطيته إيّاه، تبّاً

290
00:20:56,030 --> 00:20:58,070
وأين ذاك المدعوّ لوشيا؟

291
00:20:58,340 --> 00:21:00,920
في حديقة بالجوار على الأرجح

292
00:21:00,920 --> 00:21:02,930
إن كان حيث هو عادةً

293
00:21:02,930 --> 00:21:04,040
فهمت

294
00:21:07,090 --> 00:21:09,320
لم تفقد شيئاً، صحيح؟

295
00:21:10,590 --> 00:21:11,960
!اخرس

296
00:21:11,960 --> 00:21:13,690
!بالطبع لا

297
00:21:14,000 --> 00:21:15,780
هكذا إذاً، تسرّني معرفة ذلك

298
00:21:15,780 --> 00:21:20,090
إلى اللقاء يا تاكوما! لنخض معركةً
!في وقتٍ ما مُجدداً! كان الأمر مُسلياً

299
00:21:20,810 --> 00:21:22,310
مُسلياً؟

300
00:21:23,980 --> 00:21:24,900
تبّاً

301
00:23:24,440 --> 00:23:26,550
!استعراض بطاقات شادوفيرس

302
00:23:26,550 --> 00:23:28,890
!بطاقة اليوم هي التنّين العاجي

303
00:23:28,890 --> 00:23:31,070
يتطوّر عندما تكون بطاقات يدك قليلة

304
00:23:31,070 --> 00:23:32,670
!فينقذك وقت الحاجة

305
00:23:32,670 --> 00:23:35,250
عندما يهاجم يُصيب كلّ أتباع
!الخصم بضرر 3

306
00:23:35,250 --> 00:23:36,900
!مُذهل

307
00:23:36,900 --> 00:23:38,990
!إنّه أفضل رفيق ممكن

308
00:23:38,980 --> 00:23:41,440
في الحلقة القادمة

309
00:23:39,390 --> 00:23:41,770
!كان يونازوكي لوشيا قويّاً جدّاً

310
00:23:41,770 --> 00:23:44,550
!لديه مصّاصو دماء! مُذهل

311
00:23:44,550 --> 00:23:46,020
!أنت في ورطة يا هيرو

312
00:23:46,020 --> 00:23:47,280
!لكنّي لن أستستلم

313
00:23:47,280 --> 00:23:49,490
!لا تعرف النتيجة في شادوفيرس حتّى النهاية

314
00:23:49,970 --> 00:23:51,740
!الحلقة القادمة: عزيمة هيرو

315
00:23:51,740 --> 00:23:53,690
!معركة! شادوفيرس