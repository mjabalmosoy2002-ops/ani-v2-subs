1
00:01:56,540 --> 00:01:58,040
!لا! توقّفوا

2
00:01:58,040 --> 00:01:59,140
...أنا

3
00:02:00,140 --> 00:02:02,640
!أريد العيش! أريد العيش

4
00:02:02,640 --> 00:02:05,030
!أريد العيش! لا

5
00:02:05,030 --> 00:02:07,720
!لا

6
00:02:23,550 --> 00:02:25,630
...ماورا

7
00:02:28,720 --> 00:02:32,580
أهذا... أهذا قدري؟

8
00:02:33,150 --> 00:02:34,940
فهمت

9
00:02:36,960 --> 00:02:38,720
...إذا كان ذلك

10
00:02:39,510 --> 00:02:41,500
!لن أسامحه أبداً

11
00:02:42,490 --> 00:02:44,530
...ماورا، أنت

12
00:02:49,140 --> 00:02:53,580
!لن أسامح هذا القدر
!لن أسامح هذا العالم

13
00:02:54,560 --> 00:02:58,850
لذا سأدمّر... كلّ شيء

14
00:03:03,390 --> 00:03:05,740
!لم يعد من كان

15
00:03:06,630 --> 00:03:08,160
ماذا نفعل؟

16
00:03:09,060 --> 00:03:11,450
،إذا كان هناك شيء يستطيع الوصول له الآن

17
00:03:12,080 --> 00:03:13,410
!فهو هذه فقط

18
00:03:15,520 --> 00:03:17,370
يا للسذاجة

19
00:03:21,130 --> 00:03:26,460
أنا الآن شيءٌ يتجاوز
البشر كما الظلال الفارغة

20
00:03:27,070 --> 00:03:32,050
!حتّى بالبطاقات الأسطوريّة، لن تستطيعوا هزيمتي

21
00:03:32,940 --> 00:03:35,600
!لن نعرف ذلك حتّى نحاول

22
00:03:35,600 --> 00:03:38,740
هيرو، هذه معركتي

23
00:03:38,740 --> 00:03:40,690
...إذا أوقفتُه

24
00:03:40,690 --> 00:03:43,420
كلا، إنّها معركتنا

25
00:03:43,790 --> 00:03:47,160
!لوشيا، لنوقف ماورا معاً

26
00:03:48,680 --> 00:03:50,370
هكذا أنت، صحيح؟

27
00:03:50,370 --> 00:03:51,380
!أجل

28
00:03:52,990 --> 00:03:55,240
صداقات سخيفة زائفة

29
00:03:55,240 --> 00:03:57,950
لكنّها النهاية الآن

30
00:03:58,290 --> 00:04:03,550
قبل أن أدمّر العالم، سأدمّركما

31
00:04:03,870 --> 00:04:06,350
!معركة! شادوفيرس

32
00:04:47,460 --> 00:04:48,950
دوري

33
00:04:49,350 --> 00:04:52,430
لنبدأ باليأس الأوّل

34
00:04:52,430 --> 00:04:54,480
أول آلة مقدّسة

35
00:04:54,480 --> 00:04:57,560
ألعب بطاقة السحر: الدرع المُذنب

36
00:05:04,990 --> 00:05:07,410
أنهي دوري

37
00:05:07,410 --> 00:05:09,510
ما هذا السحر؟

38
00:05:09,510 --> 00:05:13,000
أظن أنّها بطاقة يمكن للظلال الفارغة
وحدهم استعمالها

39
00:05:13,000 --> 00:05:14,330
دوري

40
00:05:14,330 --> 00:05:15,400
!سحب

41
00:05:16,140 --> 00:05:17,810
ألعب الطيف المُتباطئ

42
00:05:18,340 --> 00:05:20,570
يتفعّل أثيره

43
00:05:21,520 --> 00:05:23,410
!فيُصاب القائدان بضرر 1

44
00:05:33,030 --> 00:05:35,010
لمَ لم يتلقّ ضرراً؟

45
00:05:35,210 --> 00:05:38,760
أحبّ هذا التعبير

46
00:05:38,760 --> 00:05:41,400
بطاقة السحر: الدرع المُذنب

47
00:05:41,400 --> 00:05:43,470
،عندما تُلعب

48
00:05:43,470 --> 00:05:48,820
تعطي قائدها قدرة تخفيض
كلّ الضرر الذي يتلقّاه بمقدار 2

49
00:05:48,820 --> 00:05:52,040
،الضرر الذي يسبّبه الطيف المُتباطئ 1

50
00:05:52,040 --> 00:05:56,440
فيصدّه الدرع بالكامل

51
00:05:57,490 --> 00:06:00,640
سحر يعطي القائد تأثيراً؟

52
00:06:00,640 --> 00:06:03,730
لم أعد بشريّاً

53
00:06:03,730 --> 00:06:07,190
لا يستطيع ذاك القدر
من الضرر التأثير عليّ

54
00:06:07,740 --> 00:06:09,220
أنهي دوري

55
00:06:09,220 --> 00:06:12,970
!تعجبني ملامحك، تعطيني شعوراً رائعاً

56
00:06:12,970 --> 00:06:14,840
!حان دوري

57
00:06:15,240 --> 00:06:18,690
!ألعب بطاقة التعويذة: لحن نداء الوحوش

58
00:06:21,690 --> 00:06:23,850
تعويذة عدّ تنازليّ؟

59
00:06:23,850 --> 00:06:24,910
أجل

60
00:06:24,910 --> 00:06:28,700
البطاقة المثالية لعدّ دمار
الأرض التنازليّ

61
00:06:29,100 --> 00:06:30,600
لمَ يا ماورا؟

62
00:06:32,280 --> 00:06:37,110
لمَ تريد تدمير العالم لهذا الحدّ؟

63
00:06:37,740 --> 00:06:40,220
السبب واضح

64
00:06:40,710 --> 00:06:44,750
حاول هذا العالم تدميري

65
00:06:44,750 --> 00:06:47,680
لذا سأدمّره عوضاً عن ذلك

66
00:06:47,960 --> 00:06:50,430
أي أنّك لا تهتمّ إن اختفى الجميع؟

67
00:06:50,430 --> 00:06:52,000
كلا

68
00:06:52,000 --> 00:06:55,190
،إذا زال كلّ ما يعطيني المعاناة

69
00:06:55,190 --> 00:06:57,390
فسأكون سعيداً جدّاً

70
00:06:57,610 --> 00:07:00,650
!ذلك غير منطقيّ

71
00:07:01,030 --> 00:07:02,630
!ألعب وسيط التنّين الروحي

72
00:07:06,600 --> 00:07:07,730
...ثمّ

73
00:07:08,860 --> 00:07:14,450
،إذا كان يُنقص 2 من كلّ ضرر يتلقّاه
فلن يتأثّر بهجوم الطيف المُتباطئ

74
00:07:15,400 --> 00:07:17,420
أنهي دوري

75
00:07:17,680 --> 00:07:19,550
ريوغاساكي هيرو

76
00:07:19,550 --> 00:07:22,130
أنت ساذجٌ بحقّ

77
00:07:22,390 --> 00:07:25,790
ما الذي لا تجده منطقيّاً بي؟

78
00:07:25,790 --> 00:07:27,910
...الأخذ بثأرك لأنّك تعرّضت للأذى

79
00:07:28,240 --> 00:07:31,710
!إذا واصلت هذا، ستعاني للأبد

80
00:07:31,710 --> 00:07:34,220
!لا تفهم شيئاً

81
00:07:34,220 --> 00:07:36,270
لمَ أتيت لهذا الحدّ؟

82
00:07:37,480 --> 00:07:42,320
لديك شيءٌ ما تريد حمايته أيضاً، صحيح؟

83
00:07:42,320 --> 00:07:45,370
!ماورا! نحن رفاق

84
00:07:45,370 --> 00:07:47,020
!لذا انضمّ لنا

85
00:07:47,020 --> 00:07:51,810
!رفاق؟! ليس لديّ ذلك

86
00:07:52,170 --> 00:07:54,070
ألعب العذراء الملعونة

87
00:07:54,070 --> 00:07:59,560
يقدّم تأثيرها العدّ التنازلي لكلّ
!بطاقات التعويذة خاصتي بمقدار 1

88
00:08:00,250 --> 00:08:04,700
تبقّى للحن نداء الوحوش دور واحد فقط إذاً؟

89
00:08:05,120 --> 00:08:07,060
هـ-هذا سيّئ

90
00:08:07,240 --> 00:08:09,220
يا للسخافة

91
00:08:09,220 --> 00:08:11,880
!أصدقاء! رفاق

92
00:08:11,880 --> 00:08:15,690
أنتم مجرّد ضعاف محتشدين في مجموعة

93
00:08:15,950 --> 00:08:18,080
لا أحتاج لشيء بتلك الهشاشة

94
00:08:18,080 --> 00:08:24,180
!ما كنتُ أحتاجه... كان وعداً واحداً قاطعاً

95
00:08:25,690 --> 00:08:26,960
ماورا؟

96
00:08:26,960 --> 00:08:30,650
أجل، وعدي مع ليون-ساما

97
00:08:34,600 --> 00:08:35,810
...لكن

98
00:08:37,230 --> 00:08:41,320
!لكنّي أخلفت بوعدي

99
00:08:41,970 --> 00:08:46,820
!خنتُ ليون-ساما

100
00:08:48,620 --> 00:08:50,970
!لم يكن بيدك حيلة

101
00:08:50,970 --> 00:08:52,890
!لا يمكن أن تصبح تضحية

102
00:08:53,160 --> 00:08:57,150
كلا، بل أمكنني! كان يجب أن أكون

103
00:08:57,770 --> 00:09:03,000
لم يستطع قلبي إطاعة منطقي

104
00:09:04,550 --> 00:09:05,890
...يا للأسى

105
00:09:08,820 --> 00:09:11,600
!سننقذك حتماً

106
00:09:11,820 --> 00:09:14,070
!دوري! سحب

107
00:09:14,420 --> 00:09:19,460
سيصل العدّ التنازلي للحن نداء الوحوش
إلى صفر في الدور التالي

108
00:09:20,020 --> 00:09:23,070
سيظهر تابعان قويّان

109
00:09:23,400 --> 00:09:26,290
الصقر المقدّس تحديداً الذي يحمل عاصفة

110
00:09:26,690 --> 00:09:30,620
لكنّ قوّة الهجوم هذه
لا تزال خطراً عليه

111
00:09:30,620 --> 00:09:33,580
لا تحمل حاجزاً، لكنّها ستكون طعماً ممتازاً

112
00:09:33,580 --> 00:09:36,950
!ألعب جنرال الظلام وأنهي دوري

113
00:09:37,810 --> 00:09:40,910
دوري إذاً

114
00:09:41,320 --> 00:09:42,330
سحب

115
00:09:42,880 --> 00:09:47,480
أوّلاً، يصل العدّ التنازلي للحن
نداء الوحوش لصفر

116
00:09:48,440 --> 00:09:52,050
ويظهر الصقر المقدّس
وتنّين الشعلة المقدّسة

117
00:09:53,170 --> 00:09:54,400
...ها هما

118
00:09:54,400 --> 00:09:57,070
يتفعّل تأثير العذراء الملعونة

119
00:09:58,690 --> 00:10:01,480
،عندما تتدمّر بطاقة عدّ تنازليّ

120
00:10:01,480 --> 00:10:04,620
تضيف بطاقة بكلمات أخيرة ليدي

121
00:10:06,140 --> 00:10:10,710
ثمّ ألعب بطاقة التعويذة: الثعلبة التقيّة

122
00:10:15,980 --> 00:10:20,580
أهاجم جنرال الظلام بالصقر المقدّس
!والعذراء الملعونة

123
00:10:23,800 --> 00:10:29,520
،سهلٌ جدّاً! على هذا المعدّل
!سيزول العالم بلمح البصر

124
00:10:29,830 --> 00:10:33,190
لن أسمح بحصول ذلك

125
00:10:33,190 --> 00:10:35,940
!سننقذه حتماً

126
00:10:36,380 --> 00:10:38,180
يا للسخافة

127
00:10:38,180 --> 00:10:40,010
أتفهم؟

128
00:10:40,010 --> 00:10:45,920
حتّى لو حصلت معجزة وهزمتماني، لن يهمّ ذلك

129
00:10:45,920 --> 00:10:48,840
!لأنّي لن أساعدكم بعد الآن

130
00:10:48,840 --> 00:10:53,410
ولا يمكنكم إنقاذ العالم دون
البطاقات السبع الأسطوريّة

131
00:10:54,060 --> 00:10:55,510
ألستُ محقّاً؟

132
00:10:55,510 --> 00:10:58,500
كلا، لسنا ننقذ العالم فحسب

133
00:10:59,220 --> 00:11:01,430
!بل سننقذك أيضاً يا ماورا

134
00:11:01,970 --> 00:11:04,670
...كلّ عبءٍ تحمله

135
00:11:04,670 --> 00:11:07,850
!سنتدبّر أمره حتماً

136
00:11:08,190 --> 00:11:11,300
!ألعب موشوسو، وفارسة التنّين آيلا

137
00:11:12,410 --> 00:11:14,240
!آيلا، تطوّري

138
00:11:17,410 --> 00:11:19,480
يتفعّل تأثير موشوسو

139
00:11:19,480 --> 00:11:23,860
عندما يتطوّر تابع آخر، يرتفع هجومه بمقدار 2

140
00:11:24,120 --> 00:11:27,630
!ثمّ أهاجم تنّين الشعلة المقدّسة بآيلا

141
00:11:33,620 --> 00:11:35,640
تنقذوني؟

142
00:11:36,100 --> 00:11:38,220
!تتفعّل الكلمات الأخيرة لآيلا

143
00:11:38,220 --> 00:11:44,050
عندما تتدمّر، ترتفع نقاط اللعب القصوى
!الخاصة بقائدي بمقدار 1

144
00:11:44,600 --> 00:11:46,360
!أنهي دوري

145
00:11:46,740 --> 00:11:52,010
ريوغاساكي هيرو، قلت أنّك ستنقذني؟

146
00:11:52,440 --> 00:11:53,940
!أجل، سأفعل

147
00:11:53,940 --> 00:11:57,480
لا بدّ من وجود طريقةٍ
!بحيث لا تعاني

148
00:12:07,760 --> 00:12:08,880
ماورا؟

149
00:12:26,360 --> 00:12:28,220
أنت تهينني

150
00:12:29,130 --> 00:12:32,380
،لم تشعروا بجوعٍ جعل أبصاركم مشوّشة

151
00:12:32,570 --> 00:12:36,560
أو برد كاد يمزّق أجسادكم

152
00:12:36,560 --> 00:12:38,520
تنقذوني أنا؟

153
00:12:39,160 --> 00:12:41,870
ذلك مستحيل

154
00:12:41,870 --> 00:12:44,280
لا خلاص لي

155
00:12:45,050 --> 00:12:47,700
...حتّى لو أخذتُ يد ليون-ساما، لا أزال

156
00:12:52,520 --> 00:12:53,630
ماورا

157
00:12:54,740 --> 00:12:56,970
هذه شجرة الكوارث

158
00:12:56,970 --> 00:13:01,380
عندما تفيق، سيتجمّد العالم

159
00:13:01,620 --> 00:13:05,340
وسيختفي كلّ شيء

160
00:13:05,670 --> 00:13:07,400
،قبل حصول ذلك

161
00:13:08,600 --> 00:13:10,790
عليك إيقافها

162
00:13:10,790 --> 00:13:13,190
أنا؟ كيف؟

163
00:13:13,550 --> 00:13:20,840
يمكن للبطاقات الأسطوريّة وحدها
ختم الشجرة مؤقتاً

164
00:13:20,840 --> 00:13:23,310
،للتخلّص منها

165
00:13:23,600 --> 00:13:28,370
عليك امتصاص الظلال الفارغة
في جسدك وكسب قوّة أكبر

166
00:13:28,700 --> 00:13:31,440
،بقوّتك حينها

167
00:13:32,660 --> 00:13:36,780
ستستطيع تدمير شجرة الكوارث تماماً

168
00:13:37,270 --> 00:13:40,290
ما الذي سيحلّ بي؟

169
00:13:40,290 --> 00:13:42,670
سيزول وجودك

170
00:13:42,670 --> 00:13:47,290
ويُولد مُنقذ

171
00:13:48,570 --> 00:13:53,700
ماورا، لمَ أنت هنا؟

172
00:13:56,700 --> 00:14:00,700
ليس مسموحاً لي بأن
!أكون نفسي حتّى

173
00:14:00,970 --> 00:14:02,870
!تلك غلطة ليون

174
00:14:02,870 --> 00:14:05,860
!كلا، لم يقم ليون-ساما بشيءٍ خاطئ

175
00:14:06,260 --> 00:14:09,760
!قام بتربيتي

176
00:14:09,760 --> 00:14:11,890
!أرشدني

177
00:14:13,610 --> 00:14:15,810
!لا يمكن أن يكون مُخطئا

178
00:14:20,970 --> 00:14:23,150
إنّها غلطتي

179
00:14:23,150 --> 00:14:27,480
!لأنّي لم أصبح ما أرادني أن أكون

180
00:14:27,840 --> 00:14:30,980
!وكان هذا العالم ما جعلني من أنا

181
00:14:31,330 --> 00:14:35,640
!جعلني هذا العالم شريراً

182
00:14:35,640 --> 00:14:43,140
!ألعب بطاقتيْ التعويذة: الحارس المقدّس ودعاء قوادم الجناح

183
00:14:44,670 --> 00:14:49,190
يقدّم تأثير الحارس المقدّس
!عدّه التنازلي بمقدار 2

184
00:14:49,190 --> 00:14:51,900
!بطاقة السحر: العقيدة المقدّسة

185
00:14:52,840 --> 00:14:58,450
أقدّم العدّ التنازليّ لإحدى تعويذاتي
!بمقدار 2، وأسحب بطاقة

186
00:15:00,740 --> 00:15:05,720
ليتني لم أدرك أنّي أردت العيش

187
00:15:05,720 --> 00:15:08,880
في تلك الحالة، كان العالم لينجو

188
00:15:09,090 --> 00:15:10,660
!ذلك ليس صحيحاً

189
00:15:10,660 --> 00:15:13,730
!لا معنى في عالمٍ أُنقذ بالتضحية بك

190
00:15:14,010 --> 00:15:18,210
!أنت لطيف، لكن هذا نفاق

191
00:15:18,210 --> 00:15:21,440
!ولن يغيّر هذا النفاق قصّتي

192
00:15:22,360 --> 00:15:27,940
لا تقلق، سينتهي ألم هذه المعركة قريباً

193
00:15:28,160 --> 00:15:31,170
!وسينتهي العالم

194
00:15:31,170 --> 00:15:32,830
لن نتركك تنهي العالم

195
00:15:33,920 --> 00:15:37,110
طالما أنا وهيرو هنا

196
00:15:37,370 --> 00:15:39,320
!دوري! سحب

197
00:15:41,000 --> 00:15:44,750
!أهاجم الثعلب الحارس بالطيف المُتباطئ وموشوسو

198
00:15:48,270 --> 00:15:50,270
!لا جدوى

199
00:15:50,270 --> 00:15:52,930
ثمّ ألعب وحش الفيضان العملاق

200
00:15:54,170 --> 00:15:57,420
سنعرف ما إن كانت هناك جدوى
أم لا قريباً

201
00:15:57,800 --> 00:15:59,140
أنهي دوري

202
00:15:59,460 --> 00:16:01,420
تظنّ ذلك؟

203
00:16:01,420 --> 00:16:03,980
!لنكتشف فوراً إذاً

204
00:16:03,980 --> 00:16:08,190
وصل العدّ التنازليّ للحارس المقدّس صفراً

205
00:16:08,190 --> 00:16:10,970
!فيظهر ثعلب حارس

206
00:16:11,970 --> 00:16:13,330
هو مُجدداً؟

207
00:16:13,330 --> 00:16:15,790
أخبرتكما، لا جدوى

208
00:16:15,790 --> 00:16:17,850
!أطوّر الثعلب الحارس

209
00:16:22,320 --> 00:16:24,420
!وأهاجم وحش الفيضان العملاق

210
00:16:25,440 --> 00:16:28,590
كنتُ أعاني

211
00:16:28,960 --> 00:16:32,970
إذا قلتما أنّكما تريدان إنقاذي، سواءً كنتما
تعنيان ذلك أم لا

212
00:16:32,970 --> 00:16:37,040
فلتتذوّقا نفس المعاناة التي مررتُ بها

213
00:16:37,300 --> 00:16:40,320
!فلتظهر يا إله اللعنات

214
00:16:47,890 --> 00:16:49,490
أتى بهذه السرعة؟

215
00:16:49,490 --> 00:16:50,800
!أجل

216
00:16:50,800 --> 00:16:53,870
!ارتعدا وتجمّدا في مكانيكما خوفاً

217
00:16:53,870 --> 00:16:58,650
!كلّ طريقٍ قد تسلكانه محاه الظلام

218
00:16:58,650 --> 00:17:00,320
أنهي دوري

219
00:17:00,320 --> 00:17:02,200
!دوري! سحب

220
00:17:02,550 --> 00:17:04,200
،إله اللعنات

221
00:17:04,200 --> 00:17:07,280
تابع قويّ بهجوم 6

222
00:17:07,600 --> 00:17:09,500
...عليّ هزيمته، لكن

223
00:17:10,470 --> 00:17:14,600
!إذا هزمته فحسب، سيرجع أقوى

224
00:17:15,920 --> 00:17:18,140
!لذا عليّ هزيمته مرّتين

225
00:17:18,550 --> 00:17:22,640
كلا، لا أملك بطاقات كافية لهزيمته مرّتين

226
00:17:22,840 --> 00:17:23,920
ماذا أفعل؟

227
00:17:23,920 --> 00:17:28,310
هيرو، هذه معركتنا نحن الاثنين

228
00:17:29,250 --> 00:17:31,190
ذلك ما قلتَه، أليس كذلك؟

229
00:17:32,710 --> 00:17:34,740
آسف، معك حقّ

230
00:17:35,150 --> 00:17:38,870
لوشيا، لا يمكنني هزيمة إله اللعنات بمفردي

231
00:17:39,450 --> 00:17:41,310
!لذا ساعدني

232
00:17:41,310 --> 00:17:43,090
ليس عليك طلب ذلك

233
00:17:45,270 --> 00:17:47,830
!حسناً، هيّا بنا

234
00:17:47,830 --> 00:17:50,430
!بطاقة السحر: النَفس الحارق

235
00:17:52,120 --> 00:17:55,170
!تصيب الثعلب الحارس بضرر 2

236
00:17:57,310 --> 00:17:59,810
!ثمّ ألعب هايدرا

237
00:17:59,810 --> 00:18:00,760
!تطوّر

238
00:18:04,440 --> 00:18:06,790
!هاجم إله اللعنات

239
00:18:08,980 --> 00:18:10,110
!حسنٌ

240
00:18:10,110 --> 00:18:11,770
انتهيتما؟

241
00:18:11,770 --> 00:18:13,500
أجل، انتهيت

242
00:18:13,500 --> 00:18:15,120
أنهي دوري

243
00:18:15,120 --> 00:18:17,320
لنكمل إذاً

244
00:18:17,320 --> 00:18:20,460
الألم، والمعاناة

245
00:18:20,460 --> 00:18:24,420
!فلترجع الآن، في هيئة أكثر فساداً حتّى

246
00:18:24,420 --> 00:18:26,750
!يا إله اللعنات

247
00:18:30,560 --> 00:18:37,500
،ثمّ يصل العدّ التنازلي لدعاء قوادم الجناح صفراً
ويظهر صقر مقدّس

248
00:18:38,080 --> 00:18:41,400
!يحمل عاصفة، فأهاجم هايدرا به

249
00:18:43,270 --> 00:18:46,940
ثمّ ألعب مانيو والثعلب المقدّس، غريمو

250
00:18:47,310 --> 00:18:52,340
لا يمكن استهداف هاتين البطاقتين من قِبل
التأثيرات، فلا يمكن هزيمتهما بسهولة

251
00:18:52,740 --> 00:18:55,570
أنهي دوري

252
00:18:56,070 --> 00:18:58,070
!لكنّ المعاناة لم تنته

253
00:18:58,070 --> 00:19:00,360
!يتفعّل تأثير إله اللعنات

254
00:19:00,620 --> 00:19:05,260
في نهاية الدور، ينخفض دفاع القائد
!الأقصى بمقدار 5

255
00:19:11,750 --> 00:19:13,910
كيف إذاً؟ هل انتهيت؟

256
00:19:13,910 --> 00:19:14,780
!ليس بعد

257
00:19:16,250 --> 00:19:18,440
بدأنا للتوّ، أليس كذلك؟

258
00:19:19,720 --> 00:19:22,220
تظنّ بإمكانك المقاومة في هذا الوضع؟

259
00:19:22,630 --> 00:19:25,130
يبدو أنك تمتلك الكثير من الثقة

260
00:19:25,130 --> 00:19:26,950
!بالطبع

261
00:19:26,950 --> 00:19:30,360
!فأنا أؤمن في لوشيا

262
00:19:33,730 --> 00:19:36,430
!المعركة في بدايتها

263
00:19:37,270 --> 00:19:40,370
هذه قوّة الدمار خاصّتي

264
00:19:40,710 --> 00:19:45,130
!أو ربما قوّة قلب الوضع، وإنقاذ العالم

265
00:19:45,670 --> 00:19:46,750
!الكشف

266
00:19:58,800 --> 00:20:00,580
!رائع يا لوشيا

267
00:20:01,150 --> 00:20:04,540
ماورا، أنا متأكّد أنّ يأسك عميق

268
00:20:05,060 --> 00:20:08,160
عميقٌ بحيث لا يمكنني النظر في مداه حتّى

269
00:20:08,490 --> 00:20:12,360
لكن، يمكن تغيير اليأس إلى أمل

270
00:20:12,700 --> 00:20:13,550
!أجل

271
00:20:15,870 --> 00:20:18,200
!لا شيء لا يتغيّر أبداً

272
00:20:18,200 --> 00:20:19,950
!نحن رفاق

273
00:20:19,950 --> 00:20:21,670
!أنت لست بمفردك

274
00:20:22,390 --> 00:20:24,330
فهمت

275
00:20:24,540 --> 00:20:27,320
هذه قوّة الصداقة إذاً؟

276
00:20:27,320 --> 00:20:29,690
إنّها أقوى مما ظننت

277
00:20:30,500 --> 00:20:32,870
!لكن ما في ذلك؟

278
00:20:35,220 --> 00:20:37,420
صداقة؟ رفاق؟

279
00:20:37,420 --> 00:20:40,720
!تلك أشياء رائعة حقّاً

280
00:20:40,720 --> 00:20:42,190
...لكن

281
00:20:42,440 --> 00:20:43,480
!ماورا

282
00:20:43,480 --> 00:20:45,500
!فات الأوان

283
00:20:45,500 --> 00:20:51,150
!على أن تنقذ الصداقة... أو الرفاق... هذا العالم

284
00:20:51,150 --> 00:20:53,720
!فات الأوان

285
00:20:56,490 --> 00:21:00,370
!أرهم أيّتها العقيدة الأبديّة

286
00:21:09,650 --> 00:21:10,780
...أهذه

287
00:21:10,780 --> 00:21:13,120
واحدة أخرى؟

288
00:21:13,310 --> 00:21:16,370
بطاقة السحر: العقيدة الأبديّة

289
00:21:16,620 --> 00:21:19,490
اليأس الثاني، الآلة المقدّسة الثانية

290
00:21:20,500 --> 00:21:25,700
!عندما تُلعب هذه البطاقة، يصبح دفاع قائدي 40

291
00:21:26,150 --> 00:21:28,140
!يصبح دفاعه 40؟

292
00:21:28,140 --> 00:21:29,470
...كما

293
00:21:29,470 --> 00:21:31,980
...عندما تجتمع الآلتين المقدّستين

294
00:21:34,900 --> 00:21:38,020
!تستدعي خمس هجمات ظلّ

295
00:21:38,820 --> 00:21:42,200
!الدمار

296
00:21:43,170 --> 00:21:44,950
!سينتهي كلّ شيء

297
00:21:45,850 --> 00:21:48,320
...هيّا نكمل

298
00:21:49,560 --> 00:21:52,550
!معركة اليأس هذه

299
00:23:24,250 --> 00:23:26,430
!استعراض بطاقات شادوفيرس

300
00:23:26,430 --> 00:23:28,420
هاتين هما بطاقاتا اليوم

301
00:23:28,420 --> 00:23:30,990
الدرع المُذنب والعقيدة الأبديّة

302
00:23:30,990 --> 00:23:34,320
أيمكنكما تجاوزهما يا ترى؟

303
00:23:34,320 --> 00:23:35,750
سنفعل

304
00:23:35,750 --> 00:23:37,920
!فلذلك نحن هنا

305
00:23:38,890 --> 00:23:41,350
في الحلقة القادمة

306
00:23:39,300 --> 00:23:42,170
!ماورا، لم تتغيّر

307
00:23:42,170 --> 00:23:45,050
لم نتغيّر جميعاً البتّة
!في حبّنا لشادوفيرس

308
00:23:45,050 --> 00:23:48,180
!هذا ما أكرهه فيك

309
00:23:48,180 --> 00:23:50,450
الحلقة القادمة: معركة اليأس

310
00:23:50,760 --> 00:23:52,960
!معركة! شادوفيرس