1
00:00:15,290 --> 00:00:17,070
أأنت يونازوكي لوشيا؟

2
00:00:20,470 --> 00:00:22,780
ما-ما خطبه؟

3
00:00:23,140 --> 00:00:25,280
أتحتاج شيئاً منّي؟

4
00:00:25,740 --> 00:00:28,540
بحوزتك الهاتف الذي أخذته
من تاكوما، صحيح؟

5
00:00:28,540 --> 00:00:30,440
!إنّه يخصّ صديقتي

6
00:00:30,440 --> 00:00:31,120
...لذا

7
00:00:37,110 --> 00:00:38,880
هاتف ميموري

8
00:00:39,410 --> 00:00:40,970
ستعيده؟

9
00:00:41,330 --> 00:00:42,790
لستُ مهتماً به

10
00:00:48,020 --> 00:00:50,380
غلبتَ كيباكورا تاكوما

11
00:00:50,380 --> 00:00:52,730
أجل، لكن بالكاد

12
00:00:54,440 --> 00:00:56,970
!كان الأمر مسلياً جدّاً

13
00:00:56,970 --> 00:00:59,700
صحيح يا لوشيا، لمَ لا تواجهني؟

14
00:00:59,700 --> 00:01:00,800
تريد مواجهتي؟

15
00:01:00,800 --> 00:01:02,960
تُحب شادوفيرس أيضاً، أليس كذلك؟

16
00:01:03,740 --> 00:01:09,160
لا بأس، لكن كلّ من أغلبهم
يتركون شادوفيرس

17
00:01:10,120 --> 00:01:12,690
لن أتركها لو خسرت

18
00:01:12,690 --> 00:01:15,930
!كما لا نيّة لي بالخسارة بالطبع

19
00:02:54,010 --> 00:02:56,270
!معركة! شادوفيرس

20
00:03:59,760 --> 00:04:02,120
!ها أنا ذا! دوري

21
00:04:04,000 --> 00:04:06,460
!ألعب تنّين الجواهر

22
00:04:07,090 --> 00:04:09,250
!أنهي دوري

23
00:04:09,650 --> 00:04:11,340
دوري

24
00:04:11,340 --> 00:04:12,560
سحب

25
00:04:13,590 --> 00:04:15,410
ألعب الطيف المُتباطئ

26
00:04:17,570 --> 00:04:22,000
تُعطي قدرة هذا التابع ضرراً
بمقدار 1 لكلّ قائد

27
00:04:30,520 --> 00:04:32,880
ضرراً لنا الاثنان؟

28
00:04:32,880 --> 00:04:34,750
!إنّه تابع مثير للاهتمام

29
00:04:35,060 --> 00:04:36,840
أتساءل عن ذلك

30
00:04:36,840 --> 00:04:38,000
أنهي دوري

31
00:04:38,000 --> 00:04:39,700
!دوري إذاً

32
00:04:39,700 --> 00:04:40,420
!سحب

33
00:04:40,850 --> 00:04:43,390
!ألعب عظاءة النار

34
00:04:45,750 --> 00:04:49,920
!قدرتها تعطي ضرر 1 لتابع للخصم

35
00:04:52,210 --> 00:04:56,170
!ثمّ أهاجم قائدك بتنّين الجواهر

36
00:05:00,620 --> 00:05:01,870
ما رأيك يا لوشيا؟

37
00:05:01,870 --> 00:05:02,850
أنهي دوري

38
00:05:04,220 --> 00:05:06,790
لا عجب في أنّك تمكنت
من هزيمة كيباكورا تاكوما

39
00:05:08,880 --> 00:05:10,870
!يمكنني هزيمتك أيضاً

40
00:05:10,870 --> 00:05:11,930
هكذا إذاً

41
00:05:14,740 --> 00:05:16,460
أتطلّع لذلك

42
00:05:16,810 --> 00:05:19,200
!احرقي يا عظاءة النار

43
00:05:20,130 --> 00:05:21,510
دفاعك مكشوف

44
00:05:21,510 --> 00:05:23,950
!تبّاً لك! هجوم مٌضاد

45
00:05:23,950 --> 00:05:25,970
ستحتاج لأكثر من ذلك

46
00:05:29,610 --> 00:05:32,290
نحن متساويان تقريباً للوقت الراهن

47
00:05:32,840 --> 00:05:35,350
أنت مثيرٌ للاهتمام قليلاً

48
00:05:36,020 --> 00:05:37,430
شكراً لك

49
00:05:37,430 --> 00:05:40,380
!لكن الإثارة لا تزال تنتظرنا

50
00:05:40,380 --> 00:05:41,400
!دوري

51
00:05:41,400 --> 00:05:42,520
!سحب

52
00:05:44,040 --> 00:05:46,620
!ألعب إيتين الهائج

53
00:05:47,520 --> 00:05:50,720
!ثمّ... أطوّره

54
00:05:54,380 --> 00:05:56,440
!انطلق

55
00:05:56,440 --> 00:05:58,590
!أهاجم غرغول المعدني

56
00:06:01,660 --> 00:06:05,910
ثمّ أهاجم ذئب الدم خاصتك
!بالتنّين حديديّ الحراشف

57
00:06:05,910 --> 00:06:07,930
!أنهي دوري

58
00:06:09,150 --> 00:06:10,920
قرارٌ جيّد

59
00:06:10,920 --> 00:06:12,680
أكنت تلعب شادوفيرس لوقتٍ طويل؟

60
00:06:13,000 --> 00:06:14,240
!بدأتُ اليوم

61
00:06:16,350 --> 00:06:18,680
ربما هذا جديرٌ بالتجربة

62
00:06:19,570 --> 00:06:21,690
دوري، سحب

63
00:06:23,340 --> 00:06:24,840
ثورة الدم

64
00:06:27,930 --> 00:06:31,740
تُعطي ضرر 3 لتابع للخصم

65
00:06:32,390 --> 00:06:34,780
...إيتين الهائج إذاً

66
00:06:42,500 --> 00:06:44,620
لم تُدمّر إيتين الهائج؟

67
00:06:44,620 --> 00:06:48,750
أثرتَ اهتمامي قليلاً، لذا سأجرّب شيئاً

68
00:06:48,750 --> 00:06:50,340
تجرّب؟

69
00:06:50,340 --> 00:06:53,400
لا أدري ما الذي تتكلم عنه، لكن لا يهمّ

70
00:06:53,400 --> 00:06:55,210
!إن كانت هذه فرصتي، فسأوجعك

71
00:06:56,220 --> 00:06:57,190
!سحب

72
00:07:00,160 --> 00:07:01,390
...أهذه

73
00:07:15,190 --> 00:07:16,530
فهمت

74
00:07:16,530 --> 00:07:17,630
...هذه

75
00:07:17,630 --> 00:07:20,010
!هذه قوّة فئة التنّين

76
00:07:21,260 --> 00:07:24,120
!انشط يا حارس التنّين

77
00:07:28,390 --> 00:07:30,630
هذا التابع في حالة فيض

78
00:07:30,630 --> 00:07:34,990
يحصل على حاجز عندما تكون
نقاط لعبك فوق 7

79
00:07:35,550 --> 00:07:37,680
تابعٌ جيّد

80
00:07:37,680 --> 00:07:39,380
لكن ماذا ستفعل به؟

81
00:07:42,220 --> 00:07:43,820
ما كان ذلك؟

82
00:07:44,220 --> 00:07:46,970
شادوفيرس هي سلسلة اختيارات

83
00:07:46,970 --> 00:07:49,160
ما الذي ستختاره؟

84
00:07:49,590 --> 00:07:50,690
!ذلك جليّ

85
00:07:50,690 --> 00:07:54,110
!أهاجم قائدك بـ إيتين الهائج

86
00:07:58,210 --> 00:08:00,000
أنهي دوري

87
00:08:00,000 --> 00:08:03,450
!لديّ أتباع بهجوم قويّ، بالإضافة إلى حاجز

88
00:08:03,450 --> 00:08:04,300
...بهذه

89
00:08:04,300 --> 00:08:06,220
ربما توقّعت الكثير

90
00:08:07,540 --> 00:08:12,670
لا تفهم لمَ تلعب شادوفيرس البتّة

91
00:08:20,420 --> 00:08:22,270
ما-ما هذا؟

92
00:08:22,270 --> 00:08:24,340
يبدو أنّها النهاية

93
00:08:24,920 --> 00:08:30,280
سأريك قوّة فئة مصّاصي الدماء الحقيقية

94
00:08:31,730 --> 00:08:33,340
دوري

95
00:08:33,340 --> 00:08:34,490
سحب

96
00:08:36,460 --> 00:08:38,430
حان وقت الانتقام

97
00:08:38,430 --> 00:08:39,950
!إمبراطور الظلام

98
00:08:58,990 --> 00:09:00,090
لا يمكن

99
00:09:00,090 --> 00:09:01,360
!أتباعي

100
00:09:02,570 --> 00:09:05,070
إمبراطور الظلام في حالة تنشيط الانتقام

101
00:09:05,070 --> 00:09:09,080
عندما يكون لدى قائده أقلّ من 10 دفاع

102
00:09:09,080 --> 00:09:12,370
يمكنه تدمير 2 من أتباع الخصم

103
00:09:13,460 --> 00:09:15,010
خيّبت أملي

104
00:09:15,010 --> 00:09:17,740
...ظننتني سأتسلى قليلاً، لكن

105
00:09:18,310 --> 00:09:19,760
أتذكر ما قلت؟

106
00:09:19,760 --> 00:09:22,950
...كلّ من يواجهني يترك شادوفيرس

107
00:09:22,950 --> 00:09:26,290
!شادوفيرس ممتعة حقاً

108
00:09:27,400 --> 00:09:28,710
ممتعة؟

109
00:09:28,710 --> 00:09:29,850
!أجل

110
00:09:29,850 --> 00:09:33,700
!مجرّد التفكير بكيف أقلب الطاولة يشعلني حماساً

111
00:09:36,090 --> 00:09:37,680
!ها أنا ذا

112
00:09:37,680 --> 00:09:38,980
!دوري

113
00:09:40,730 --> 00:09:41,840
!حسناً

114
00:09:41,840 --> 00:09:43,440
يمكنني إصابته بالضرر بهذه

115
00:09:43,440 --> 00:09:46,420
لا يمكنك إضراره بالسحر

116
00:09:46,720 --> 00:09:51,990
قدرات بطاقة إمبراطور الظلام تحميه
من تلقي أيّ ضرر أو التعرض للتدمر

117
00:09:53,060 --> 00:09:54,980
!ماذا عن هذا؟

118
00:09:56,900 --> 00:09:58,490
!أنهي دوري

119
00:09:58,490 --> 00:10:00,960
تستعمل حاجزاً لحماية نفسك؟

120
00:10:00,960 --> 00:10:02,780
تهدر وقتك

121
00:10:03,230 --> 00:10:07,020
،ألعب نبيل مصّاصي الدماء فايت
والقاتلة شيطانية اليد

122
00:10:09,650 --> 00:10:10,670
ما هذا؟

123
00:10:10,670 --> 00:10:12,120
ستعرف قريباً

124
00:10:12,480 --> 00:10:14,680
أطوّر القاتلة شيطانية اليد

125
00:10:18,130 --> 00:10:20,710
وأهاجم التنّين البكر

126
00:10:30,270 --> 00:10:32,120
ما-ما هذا؟

127
00:10:32,450 --> 00:10:33,980
استنزاف

128
00:10:33,980 --> 00:10:37,560
عندما يُسبب تابع بهذه القدرة ضرراً

129
00:10:37,560 --> 00:10:41,120
يشفي قائده بالقدر نفسه

130
00:10:42,240 --> 00:10:43,810
لم أنته بعد

131
00:10:44,270 --> 00:10:46,710
ألعب الحشد الجائع

132
00:10:57,570 --> 00:10:58,800
!لا يمكن

133
00:10:58,800 --> 00:11:02,090
بيدك غضب التنّين غالباً

134
00:11:03,670 --> 00:11:06,330
لكن لا يمكنها قلب الوضع

135
00:11:06,330 --> 00:11:08,090
انتهت هذه المعركة

136
00:11:10,440 --> 00:11:11,600
...كلا

137
00:11:12,510 --> 00:11:14,030
!لا زلنا في البداية

138
00:11:24,990 --> 00:11:28,300
!أريد الاستمتاع في هذه المعركة حتّى النهاية

139
00:11:28,300 --> 00:11:31,630
!لذا لن أستسلم حتى النهاية

140
00:11:32,540 --> 00:11:34,100
!دوري

141
00:11:36,070 --> 00:11:38,210
!اظهر أيّها التنّين العاجيّ

142
00:11:38,970 --> 00:11:44,380
،عندما تكون بيدي بطاقتين أو أقلّ
يمكنه التطوّر دون الحاجة لنقاط تطوّر

143
00:11:50,020 --> 00:11:52,380
!انطلق أيّها التنّين العاجيّ

144
00:11:52,380 --> 00:11:53,980
!هاجم

145
00:12:03,170 --> 00:12:05,750
قلب الوضع لهذا الحد؟

146
00:12:05,750 --> 00:12:08,370
!أخبرتك أنّي لا أنوي الخسارة

147
00:12:08,370 --> 00:12:12,740
!تعال الآن! لنجعل هذه المعركة حماسية أكثر

148
00:12:23,860 --> 00:12:26,700
أقلتُ شيئاً غريباً؟

149
00:12:26,700 --> 00:12:30,060
أسحب كلامي عن خيبة الأمل

150
00:12:30,760 --> 00:12:32,810
ما اسمك؟

151
00:12:33,240 --> 00:12:34,840
!ريوغاساكي هيرو

152
00:12:35,400 --> 00:12:37,520
هكذا إذاً، هيرو

153
00:12:40,310 --> 00:12:42,230
ألعب ميثاق الدم

154
00:12:54,430 --> 00:12:58,690
يُعطي ضرر 2 لقائدي، وأسحب بطاقتين

155
00:13:01,040 --> 00:13:04,030
أهاجم قائدك بإمبراطور الظلام

156
00:13:08,340 --> 00:13:10,380
!لم أنته بعد

157
00:13:10,380 --> 00:13:13,050
أنت لا تستسلم يا هيرو؟

158
00:13:13,050 --> 00:13:14,500
!بالطبع لا

159
00:13:14,500 --> 00:13:17,570
!فكيف أفعل وأنا أشعر بهذه المتعة

160
00:13:17,940 --> 00:13:19,070
فهمت

161
00:13:26,150 --> 00:13:29,050
قلتَ من الإهدار إنهاؤها؟

162
00:13:29,050 --> 00:13:31,070
لعلّك مُحق

163
00:13:31,330 --> 00:13:33,440
اظهر يا وحش الفيضان العملاق

164
00:13:34,630 --> 00:13:35,880
أنهي دوري

165
00:13:37,270 --> 00:13:41,310
أيمكنك تجاوز الإحباط مُجدداً؟

166
00:13:41,310 --> 00:13:43,510
!أجل! سأفعل

167
00:13:43,970 --> 00:13:45,090
!سحب

168
00:13:49,860 --> 00:13:52,520
ألعب قوّة التنّين

169
00:14:18,670 --> 00:14:19,980
فهمت

170
00:14:19,980 --> 00:14:21,090
سيتجاوزه؟

171
00:14:21,380 --> 00:14:24,040
!ها أنا ذا يا لوشيا

172
00:14:55,630 --> 00:14:58,490
هل... فزت؟

173
00:15:01,020 --> 00:15:02,720
جـ-جدّياً؟

174
00:15:02,720 --> 00:15:03,480
أجل

175
00:15:03,900 --> 00:15:05,470
!مرحى

176
00:15:06,330 --> 00:15:08,170
!شكراً لك يا لوشيا

177
00:15:08,170 --> 00:15:10,330
!كان المعركة مسليةً جدّاً

178
00:15:11,390 --> 00:15:13,360
أنا متأكد أنّك ستصبح أقوى

179
00:15:20,220 --> 00:15:23,470
ائتمنتك تلك البطاقة بالمستقبل

180
00:15:35,610 --> 00:15:36,760
لوشيا؟

181
00:15:40,870 --> 00:15:42,260
هيرو-كن؟

182
00:15:42,260 --> 00:15:43,590
ماذا تفعل هنا؟

183
00:15:44,580 --> 00:15:45,560
هاك

184
00:15:45,990 --> 00:15:48,370
هاتفي

185
00:15:49,780 --> 00:15:51,510
استعدته؟

186
00:15:51,510 --> 00:15:52,500
!أجل

187
00:15:54,770 --> 00:15:56,310
!شكراً لك

188
00:15:56,310 --> 00:15:58,250
لا بأس

189
00:15:58,250 --> 00:16:00,230
يمكنك لعب معارك الآن مُجدداً، صحيح؟

190
00:16:00,580 --> 00:16:01,560
!أجل

191
00:16:04,420 --> 00:16:07,040
!جدّي! جدّي! جدّي

192
00:16:09,020 --> 00:16:11,070
!جدّي

193
00:16:11,070 --> 00:16:12,390
ما الخطب؟

194
00:16:12,390 --> 00:16:13,670
!أنا أُحبّك

195
00:16:15,160 --> 00:16:17,370
!شكراً لك على شرائك ذاك الهاتف لي

196
00:16:17,370 --> 00:16:19,420
أيّ هاتف تقصد؟

197
00:16:19,420 --> 00:16:21,760
لا تحاول التظاهر

198
00:16:21,760 --> 00:16:23,410
وجدتُه في المخزن هذا الصباح

199
00:16:24,660 --> 00:16:26,160
!...هذا

200
00:16:26,160 --> 00:16:28,250
!أشعر بسعادة كبيرة

201
00:16:28,250 --> 00:16:29,490
!تمكنتُ من لعب شادوفيرس

202
00:16:29,490 --> 00:16:32,100
...كلا، هيرو إنّ هذا

203
00:16:30,390 --> 00:16:32,670
!شكراً لك يا جدّي

204
00:16:32,670 --> 00:16:36,130
!أنتَ أفضل جدّ في العالم

205
00:16:39,050 --> 00:16:42,420
!حسنٌ، وقت الدراسة

206
00:16:45,530 --> 00:16:47,520
...يا إلهي، هذا الفتى

207
00:16:49,770 --> 00:16:53,020
الدم لا يكذب إذاً؟

208
00:16:54,660 --> 00:16:57,520
كان يوماً حافلاً

209
00:16:59,520 --> 00:17:01,970
!أتوق للعب معارك غداً

210
00:17:05,710 --> 00:17:08,710
هذه مسألة معقّدة

211
00:17:13,050 --> 00:17:14,410
!صباح الخير

212
00:17:14,410 --> 00:17:16,110
!ها هو

213
00:17:16,110 --> 00:17:17,420
!هيرو

214
00:17:17,830 --> 00:17:19,570
سمعتُ من ميموري

215
00:17:19,570 --> 00:17:22,800
!استعدت هاتفها من كيباكورا تاكوما

216
00:17:22,800 --> 00:17:23,430
!أجل

217
00:17:23,430 --> 00:17:25,180
لستَ سيّئاً

218
00:17:25,180 --> 00:17:26,690
كيف كانت المعركة؟

219
00:17:26,690 --> 00:17:28,460
!أريد معرفة ذلك بدوري

220
00:17:28,460 --> 00:17:29,200
!وأنا

221
00:17:29,200 --> 00:17:31,450
أريد المعرفة أيضاً

222
00:17:32,820 --> 00:17:35,950
لكن سنبدأ الحصّة قبلها

223
00:17:36,420 --> 00:17:40,110
كيف كانت معركتك مع كيباكورا تاكوما إذاً؟

224
00:17:40,980 --> 00:17:42,770
!كان قويّاً جدّاً

225
00:17:42,770 --> 00:17:44,690
فزتُ بالكاد

226
00:17:44,690 --> 00:17:47,650
!والمعركة بعدها مع لوشيا كانت مذهلة أكثر

227
00:17:47,650 --> 00:17:48,380
لوشيا؟

228
00:17:48,380 --> 00:17:53,120
أجل، غلبتُ شخصاً يُدعى يونازوكي لوشيا أيضاً

229
00:17:54,450 --> 00:17:58,130
!كان الهدوء غالباً عليه، لكنّه قاتل بضراوة

230
00:17:58,130 --> 00:18:01,800
!كان لديّه مصّاصي دماء، وقويّاً جدّاً

231
00:18:02,210 --> 00:18:03,260
ما الخطب؟

232
00:18:03,540 --> 00:18:07,680
!مصّاصي دماء؟ إنّه يونازوكي لوشيا الحقيقي

233
00:18:07,680 --> 00:18:11,410
!مُذهل

234
00:18:11,410 --> 00:18:13,720
!مُـ-مُذهل

235
00:18:13,720 --> 00:18:17,620
!غلب هيرو لوشيا ذاك

236
00:18:21,130 --> 00:18:22,870
هل غلبته حقاً؟

237
00:18:22,870 --> 00:18:24,340
!كيف؟

238
00:18:24,340 --> 00:18:25,240
!أخبرني

239
00:18:25,240 --> 00:18:26,190
!أخبرني أيضاً

240
00:18:31,000 --> 00:18:36,170
...ثمّ يمكننا اشتقاق قيمة إكس كـ 85

241
00:18:34,780 --> 00:18:38,290
كنتُ أفكّر أنّ بإمكاني مواجهة كازوكي اليوم أخيراً

242
00:18:38,590 --> 00:18:41,360
شادوفيرس مسليّة حقاً

243
00:18:41,360 --> 00:18:46,020
!معركتي مع تاكوما ولوشيا بالأمس كانت ممتعة جدّاً

244
00:18:46,020 --> 00:18:46,940
...لكن

245
00:18:47,310 --> 00:18:52,410
لا تفهم لمَ تلعب شادوفيرس البتّة

246
00:18:53,110 --> 00:18:57,310
لا يستمتع بـ شادوفيرس مع أنّه بتلك القوّة؟

247
00:18:57,790 --> 00:18:59,120
...كما

248
00:19:00,220 --> 00:19:02,270
ائتمنتك تلك البطاقة بالمستقبل

249
00:19:02,800 --> 00:19:05,800
ما كان قصده؟

250
00:19:08,800 --> 00:19:12,770
لا أزال عاجزاً عن تصديق أنّك غلبت يونازوكي لوشيا ذاك

251
00:19:12,770 --> 00:19:14,990
!أنتَ مُبهر بحقّ

252
00:19:14,990 --> 00:19:17,450
قال الجميع ذلك

253
00:19:17,450 --> 00:19:19,270
أهو بتلك البراعة؟

254
00:19:19,270 --> 00:19:26,890
يونازوكي لوشيا-كن بارعٌ جدّاً بحيث يُقال
أنّ كل من يواجهه يترك شادوفيرس

255
00:19:28,030 --> 00:19:30,260
بتلك القوّة إذاً؟

256
00:19:30,550 --> 00:19:32,860
!أخبرنا الآن

257
00:19:32,860 --> 00:19:35,650
كيف كانت معركتك مع لوشيا-كن؟

258
00:19:35,650 --> 00:19:37,270
كيف كانت؟

259
00:19:37,270 --> 00:19:39,620
فزت بالكاد فقط

260
00:19:39,620 --> 00:19:42,480
تبقى لي 3 دفاع في النهاية فحسب

261
00:19:42,480 --> 00:19:44,120
ثلاثة دفاع؟

262
00:19:44,120 --> 00:19:46,410
كانت متقاربة حقاً

263
00:19:46,410 --> 00:19:50,750
كنتَ لتخسر لو كان المخلب القاطع بيده

264
00:19:51,200 --> 00:19:53,030
المخلب القاطع؟

265
00:19:53,390 --> 00:19:57,110
يُسبب ضرر 3 لتابع الخصم أو قائده

266
00:19:57,110 --> 00:19:59,540
مع أنّك تتلقى ضرر 2

267
00:20:07,510 --> 00:20:09,650
...أيمكن أنّه تعمّد

268
00:20:10,730 --> 00:20:13,280
!لكنّك فزت

269
00:20:13,280 --> 00:20:14,520
!أنت مُذهل بحق

270
00:20:14,520 --> 00:20:16,280
!بدأتَ شادوفيرس لتوّك أيضاً

271
00:20:21,090 --> 00:20:22,910
!هيرو

272
00:20:40,820 --> 00:20:43,770
...لوشيا... أنت

273
00:20:48,150 --> 00:20:50,610
!لا يمكنني ترك الأمر ينتهي هكذا

274
00:20:54,880 --> 00:20:56,890
ليس هنا؟

275
00:21:04,780 --> 00:21:07,230
ربما لن أتمكن من إيجاده اليوم

276
00:21:09,560 --> 00:21:11,170
...معنى كلامه

277
00:21:12,070 --> 00:21:15,420
ائتمنتك تلك البطاقة بالمستقبل

278
00:21:16,070 --> 00:21:17,630
أظنني فهمته

279
00:21:20,300 --> 00:21:23,370
تعمّد الخسارة

280
00:21:25,900 --> 00:21:28,920
!هذه المرّة أريد الفوز حقّاً

281
00:21:28,920 --> 00:21:31,350
!كلا، بل سأفوز

282
00:21:32,670 --> 00:21:34,500
!انتظرني فحسب يا لوشيا

283
00:21:34,500 --> 00:21:37,750
!سأصبح أقوى

284
00:21:50,300 --> 00:21:52,930
ريوغاساكي هيرو

285
00:23:24,120 --> 00:23:26,150
!استعراض بطاقات شادوفيرس

286
00:23:26,150 --> 00:23:28,850
هذه بطاقة اليوم، إمبراطور الظلام

287
00:23:28,850 --> 00:23:32,760
عندما يكون انتقامه نشطاً، يمكنه تدمير
اثنين من أتباع الخصم

288
00:23:32,760 --> 00:23:36,570
،"يُلحق ضرراً بقائدك بـ "الكلمات الأخيرة
لذا فهناك مخاطرة أيضاً

289
00:23:36,570 --> 00:23:38,880
بطاقة لائقة بفئة مصّاصي الدماء

290
00:23:38,880 --> 00:23:42,640
!بدأ هيرو شادوفيرس للتوّ، وها هو لا يُقهر بالفعل

291
00:23:38,890 --> 00:23:41,350
في الحلقة القادمة

292
00:23:42,640 --> 00:23:45,310
،فكرة أنّه ندٌّ لـ إيجوين كاي، عبقريّ العباقرة

293
00:23:45,310 --> 00:23:47,400
تدفعني للضحك حتّى الألم

294
00:23:47,400 --> 00:23:49,320
!إن كنت تشعر بألم فعليك الذهاب للممرضة

295
00:23:49,320 --> 00:23:51,700
:الحلقة القادمة
خطّة عبقريّ العباقرة

296
00:23:51,700 --> 00:23:53,690
!معركة! شادوفيرس