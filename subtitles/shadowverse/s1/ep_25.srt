1
00:00:20,590 --> 00:00:22,160
دمّري العالم

2
00:00:22,710 --> 00:00:24,840
أوقفي البطاقات الأسطوريّة

3
00:00:26,230 --> 00:00:28,610
اصبغي كلّ شيء

4
00:00:35,020 --> 00:00:39,090
أساغي، سأحميك مهما تطلّب الأمر

5
00:00:56,090 --> 00:00:57,720
ما هذا؟

6
00:00:57,720 --> 00:00:58,880
!فظيع

7
00:00:58,880 --> 00:01:01,650
ليس واقعاً افتراضياً، صحيح؟

8
00:01:04,740 --> 00:01:05,670
!شيوري

9
00:01:06,030 --> 00:01:08,160
الجميع بخير، صحيح؟

10
00:01:08,160 --> 00:01:10,160
!أصدقائي وجدّي

11
00:01:10,420 --> 00:01:13,670
،بلغني أنّ الإجلاء اكتمل

12
00:01:13,670 --> 00:01:16,160
لكن لا يمكن القول أنّهم بأمان

13
00:01:17,230 --> 00:01:18,920
ما معنى ذلك؟

14
00:01:18,920 --> 00:01:23,670
جمّدت قوّة شجرة الكوارث العالم بأسره

15
00:01:24,320 --> 00:01:25,670
!جدّي

16
00:01:26,110 --> 00:01:31,940
المتواجدون داخل الأسوار الدفاعية للبرج المركزيّ
هم الوحيدون القادرون على الحركة الآن

17
00:01:31,940 --> 00:01:34,590
أ-أذلك معقول؟

18
00:01:43,200 --> 00:01:47,230
،وتتلبّس ظلالٌ فارغة الأشخاص المجمّدين

19
00:01:47,230 --> 00:01:49,460
فتتحكّم بهم شجرة الكوارث

20
00:01:49,460 --> 00:01:53,440
أهذا هو الدمار الذي تجلبه شجرة الكوارث؟

21
00:01:53,440 --> 00:01:55,210
هذا جزءٌ منه

22
00:01:55,210 --> 00:02:00,210
لكن يمكن طرد الظلال الفارغة
وإعادة الناس لطبيعتهم

23
00:02:00,510 --> 00:02:02,040
حقّاً؟

24
00:02:02,040 --> 00:02:02,830
كيف؟

25
00:02:03,560 --> 00:02:05,090
شادوفيرس

26
00:02:06,370 --> 00:02:07,600
بشادوفيرس؟

27
00:02:07,910 --> 00:02:09,930
ماذا؟ أرى أنواراً

28
00:02:10,250 --> 00:02:12,810
سبعة أنوار

29
00:02:12,810 --> 00:02:14,940
تبدو أطلالاً ما

30
00:02:14,940 --> 00:02:16,320
صحيح

31
00:02:16,320 --> 00:02:17,500
أطلال

32
00:02:18,240 --> 00:02:20,560
حيث خُتمت البطاقات الأسطوريّة

33
00:02:20,560 --> 00:02:22,640
البطاقات الأسطوريّة؟

34
00:02:22,640 --> 00:02:26,030
البطاقات التي تملك القوّة
لختم شجرة الكوارث

35
00:02:26,300 --> 00:02:29,460
أي أمل البشريّة الأخير

36
00:02:29,460 --> 00:02:34,800
سأرسل كلّ واحدٍ منكم للطلل
حيث توجد بطاقة فئته

37
00:02:35,120 --> 00:02:40,550
أريدكم أن تحصلوا على البطاقات الأسطوريّة
وتجتمعوا عند شجرة الكوارث

38
00:02:40,550 --> 00:02:42,010
أصغوا جيّدًا

39
00:02:42,010 --> 00:02:46,140
خسارتكم تعني دمار البشريّة

40
00:02:46,440 --> 00:02:49,770
،إذا أطلقت شجرة الكوارث قوّتها الكاملة

41
00:02:49,770 --> 00:02:52,790
سيُمحى العالم بلمح البصر

42
00:02:58,440 --> 00:02:59,700
!ماذا؟

43
00:02:59,700 --> 00:03:02,160
أصابتنا قوّة شجرة الكوارث

44
00:03:02,160 --> 00:03:04,200
يبدو أنّنا اقتربنا كثيراً من الأطلال

45
00:03:05,220 --> 00:03:07,100
سنسقط جميعاً

46
00:03:07,100 --> 00:03:08,560
تشبّثوا جيّداً

47
00:03:18,230 --> 00:03:21,460
أتعانون من إصابات؟

48
00:03:21,460 --> 00:03:24,590
يبدو لا، بشكلٍ ما

49
00:03:24,590 --> 00:03:26,460
ظننتُني سأموت

50
00:03:26,460 --> 00:03:29,970
!كما يُتوقع من شركة جينيسيس، يا لها من تقنية فائقة

51
00:03:31,190 --> 00:03:32,610
هذه حالة طارئة

52
00:03:32,610 --> 00:03:36,530
سأرسل لكلّ واحد منكم طلل فئته

53
00:03:37,220 --> 00:03:40,100
ربطتُ أجهزتكم السبعة

54
00:03:44,810 --> 00:03:49,120
تمّ تثبيت كلّ البيانات الضروريّة

55
00:03:49,120 --> 00:03:52,210
بدأت نهاية العالم سلفاً

56
00:03:52,490 --> 00:03:55,430
الوحيدون القادرون على إيقافها وإنقاذ العالم

57
00:03:56,810 --> 00:03:59,630
هم أنتم، السبعة المختارون

58
00:04:03,030 --> 00:04:04,500
عليّ الذهاب

59
00:04:07,670 --> 00:04:09,240
توخَّ الحذر

60
00:04:10,780 --> 00:04:14,190
دخلتَ منطقة الخطر بالفعل

61
00:04:14,190 --> 00:04:16,110
كُن متأهّباً

62
00:04:25,150 --> 00:04:26,630
!كيباكورا تاكوما

63
00:04:26,630 --> 00:04:28,120
!ريوغاساكي

64
00:04:28,120 --> 00:04:30,470
!أنت بخير

65
00:04:31,000 --> 00:04:32,070
بخير؟

66
00:04:32,070 --> 00:04:34,220
أجل، صحيح

67
00:04:34,220 --> 00:04:35,940
أشعر بشعورٍ رائع

68
00:04:39,970 --> 00:04:41,270
...هذا

69
00:04:41,270 --> 00:04:44,880
إنّه ليس كيباكورا تاكوما الذي تعرفه

70
00:04:45,180 --> 00:04:47,630
تلبّسه ظلٌّ فارغ

71
00:04:48,780 --> 00:04:50,260
!سأستعمل هذه إذاً

72
00:04:50,260 --> 00:04:55,640
نعم، يمكنك طرد الظلّ بقوّة شادوفيرس الحقيقيّة

73
00:04:56,100 --> 00:04:58,040
لكن توخَّ الحذر

74
00:04:58,040 --> 00:05:01,140
ليست هذه معركة واقع افتراضيّ
مثل المعارك السابقة

75
00:05:01,400 --> 00:05:03,080
تستعمل طاقةً ذهنية

76
00:05:03,080 --> 00:05:06,660
!لا أفهم تماماً، لكنّي سأنقذك يا تاكوما

77
00:05:06,660 --> 00:05:09,030
ما الذي تتكلّم عنه؟

78
00:05:09,030 --> 00:05:10,150
!هات ما لديك

79
00:05:10,410 --> 00:05:13,420
!معركة! شادوفيرس

80
00:05:44,200 --> 00:05:46,440
الطلل الخاص بك إلى اليمين

81
00:05:46,440 --> 00:05:48,580
بينما طللي لليسار

82
00:05:48,580 --> 00:05:50,190
يبدو أنّنا سننفصل هنا

83
00:05:50,190 --> 00:05:53,440
!أجل! لنحصل على البطاقات الأسطوريّة سريعاً

84
00:06:01,510 --> 00:06:02,220
ميموري؟

85
00:06:02,630 --> 00:06:06,660
أيمكن لشخص مثلي إنقاذ العالم حقّاً؟

86
00:06:06,660 --> 00:06:07,720
أشعر بالقلق

87
00:06:07,720 --> 00:06:11,110
إذا قلتِ ذلك، فأنا لستُ أملك الثقة بدوري

88
00:06:11,110 --> 00:06:12,150
كازوكي-كن؟

89
00:06:12,150 --> 00:06:16,430
:لكنّي أعرف ما كان ليقوله... ما كان هيرو ليقوله

90
00:06:16,430 --> 00:06:19,230
"!لن أستسلم أبداً"

91
00:06:20,600 --> 00:06:23,410
لا يمكننا الاستسلام هنا، أليس كذلك يا ميموري؟

92
00:06:23,410 --> 00:06:25,870
لذا علينا فعلها

93
00:06:25,870 --> 00:06:29,170
!أجل، معك حقّ، سأبذل جهدي

94
00:06:29,170 --> 00:06:29,980
!نعم

95
00:06:29,980 --> 00:06:31,460
!أراك لاحقاً

96
00:06:31,740 --> 00:06:33,490
!هيّا بنا يا تاكوما

97
00:06:33,490 --> 00:06:35,780
!ألعب تنّين الجواهر

98
00:06:37,820 --> 00:06:39,470
ما هذا الشعور؟

99
00:06:39,470 --> 00:06:41,600
هناك إحساس غريب في جسدي

100
00:06:41,600 --> 00:06:44,380
أهذا المقصود من استعمال الطاقة الذهنية؟

101
00:06:44,380 --> 00:06:45,870
!مذهل

102
00:06:45,870 --> 00:06:47,390
!أنهي دوري

103
00:06:59,390 --> 00:07:00,890
...ريوغاساكي

104
00:07:01,410 --> 00:07:03,650
لا يمكنك سماعه، صحيح؟

105
00:07:03,920 --> 00:07:06,120
إنّه يتردد في رأسي

106
00:07:06,480 --> 00:07:08,140
يخبرني بتدمير كلّ شيء

107
00:07:08,140 --> 00:07:10,390
!بصبغ العالم

108
00:07:10,390 --> 00:07:12,900
!لا يسكت الصوت أبداً

109
00:07:13,260 --> 00:07:15,660
!تعالي يا شيطانة اللذّة

110
00:07:17,530 --> 00:07:19,820
تابعة من فئة مصّاصي الدماء؟

111
00:07:20,130 --> 00:07:23,810
ريوغاساكي، هذا من هو أنا الآن

112
00:07:23,810 --> 00:07:26,850
تمكنني القوّة التي منحتني إيّاها شجرة الكوارث

113
00:07:27,220 --> 00:07:31,130
من استعمال بطاقات فئة الملكي كما فئة مصّاصي الدماء

114
00:07:33,600 --> 00:07:36,050
!انطلق يا قرصان الفأس

115
00:07:36,050 --> 00:07:37,850
!هاجم تنّين الجواهر

116
00:07:39,500 --> 00:07:41,700
أشعر بثقلٍ في جسدي

117
00:07:41,700 --> 00:07:42,530
ما هذا؟

118
00:07:42,530 --> 00:07:43,990
سبق وأخبرتُك

119
00:07:43,990 --> 00:07:46,160
ليست هذه معركةً عادية

120
00:07:48,790 --> 00:07:52,670
عندما يتدمّر تابعك، أو عندما تتلقّى ضرراً

121
00:07:52,670 --> 00:07:55,270
ستتقلّص طاقتك الذهنية

122
00:07:55,510 --> 00:07:57,780
من تتلبّسه الظلال الفارغة

123
00:07:57,780 --> 00:08:02,280
يمكن تحريره بتقليص قوّته الذهنية حتّى العدم

124
00:08:02,280 --> 00:08:05,990
،لكن إذا فقدتم طاقتكم الذهنية

125
00:08:05,990 --> 00:08:10,480
ستتلبّسكم الظلال وتحكمكم للأبد

126
00:08:12,790 --> 00:08:16,000
...أتفهّم خوفكم، لكن

127
00:08:16,000 --> 00:08:17,060
...مارغريت

128
00:08:19,830 --> 00:08:21,280
لا يمكننا الخسارة

129
00:08:21,570 --> 00:08:25,550
إذا خسرنا، سيكون الوضع سيّئاً للكلّ، صحيح؟

130
00:08:26,230 --> 00:08:27,430
...لذا

131
00:08:29,010 --> 00:08:30,670
!علينا الفوز وحسب

132
00:08:35,630 --> 00:08:36,700
...لن أخسر

133
00:08:36,940 --> 00:08:38,200
...لن نخسر

134
00:08:38,450 --> 00:08:40,460
!أبداً

135
00:08:40,460 --> 00:08:42,660
انتهيت من الكلام؟

136
00:08:42,660 --> 00:08:43,940
!آسف على الإطالة

137
00:08:43,940 --> 00:08:45,260
!دوري

138
00:08:45,260 --> 00:08:46,200
!سحب

139
00:08:46,200 --> 00:08:50,830
ألعب وسيط التنّين الروحيّ، فترتفع نقاط
لعبي القصوى بمقدار 1

140
00:08:50,830 --> 00:08:52,510
،سأبذل كلّ ما لديّ

141
00:08:52,510 --> 00:08:54,470
!لذا لتظهر كلّ ما لديك بدورك

142
00:08:54,470 --> 00:08:56,040
!أنهي دوري

143
00:08:57,580 --> 00:08:59,440
يا لجرأتك

144
00:08:59,440 --> 00:09:01,570
لا تشعر بالخوف؟

145
00:09:01,570 --> 00:09:04,220
إذا خسرتَ ستكون النهاية

146
00:09:04,550 --> 00:09:08,110
لا تختلف هذه عن المعارك
!التي خضناها سابقاً

147
00:09:08,110 --> 00:09:10,490
!لا يهمّ كون حياتي على المحك من خلاف ذلك

148
00:09:10,490 --> 00:09:12,020
هكذا إذاً

149
00:09:12,020 --> 00:09:14,750
لا حاجة لأتهاون في تلك الحالة

150
00:09:14,750 --> 00:09:18,530
!أهاجم قائدك بقرصان الفأس وشيطانة اللذّة

151
00:09:21,110 --> 00:09:23,370
هذه كلّ ما لديّ

152
00:09:23,370 --> 00:09:26,710
!بطاقة التعويذة: ختم الكوارث

153
00:09:31,510 --> 00:09:33,140
!شجرة الكوارث

154
00:09:34,920 --> 00:09:36,250
...تبّاً

155
00:09:36,600 --> 00:09:39,450
هذه القوّة مهولة

156
00:09:39,450 --> 00:09:42,880
سترغب بها حتماً

157
00:09:43,180 --> 00:09:45,930
حالما تخسر أمامي وتدرك مدى ضعفك

158
00:09:45,930 --> 00:09:47,400
أنهي دوري

159
00:09:47,400 --> 00:09:48,300
!سحب

160
00:09:50,150 --> 00:09:53,140
لا أعرف قدرة بطاقة التعويذة تلك

161
00:09:53,650 --> 00:09:55,280
...في هذه الحالة

162
00:09:55,610 --> 00:09:59,770
ألعب التنّين المسجون، وأنهي دوري

163
00:09:59,770 --> 00:10:01,380
!دوري

164
00:10:01,780 --> 00:10:03,530
!احفر هذا في عينيك

165
00:10:04,000 --> 00:10:06,380
،يتفعّل تأثير ختم الكوارث

166
00:10:06,380 --> 00:10:10,410
فيستدعي جنديّ ظلّ في بداية دوري

167
00:10:12,430 --> 00:10:14,490
ما هذا التابع؟

168
00:10:17,430 --> 00:10:21,690
!قرصان الفأس وشيطانة اللذّة، هاجما التنّين المسجون

169
00:10:21,690 --> 00:10:24,150
!ثمّ ألعب الشيطان الهمجيّ

170
00:10:25,440 --> 00:10:27,140
ما رأيك يا ريوغاساكي؟

171
00:10:28,340 --> 00:10:30,340
!هذا يصبح مُسلّياً

172
00:10:30,340 --> 00:10:31,140
!سحب

173
00:10:31,480 --> 00:10:33,530
!هيّا أيّها التنّين المحارب

174
00:10:33,530 --> 00:10:34,430
!تطوّر

175
00:10:35,510 --> 00:10:38,150
،يتفعّل تأثير التطوّر الخاص بالتنّين المحارب

176
00:10:38,150 --> 00:10:40,980
!فيُصاب أحد أتباع الخصم بضرر 3

177
00:10:48,320 --> 00:10:50,870
!ثمّ أهاجم الشيطان الهمجيّ

178
00:10:53,140 --> 00:10:54,790
ما رأيك يا تاكوما؟

179
00:10:58,670 --> 00:11:00,210
لمَ تضحك؟

180
00:11:00,680 --> 00:11:03,020
لأنّك ساذج

181
00:11:03,020 --> 00:11:05,960
!أيّتها الظلال، اظهري مُجدداً

182
00:11:09,090 --> 00:11:11,730
!هذا الذي هزمتُه قبل قليل

183
00:11:11,730 --> 00:11:14,700
أجل، هزمتَه بالفعل

184
00:11:14,700 --> 00:11:21,690
لكن تفعّل التأثير الأوّل لجنديّ الظلّ، كلماته الأخيرة

185
00:11:25,770 --> 00:11:27,280
آنذاك؟

186
00:11:27,280 --> 00:11:33,040
يعطي جنديّ الظلّ كلمات أخيرة لأحد
أتباعي عندما يتدمّر

187
00:11:33,370 --> 00:11:37,550
تستدعي تلك الكلمات الأخيرة جنديّ ظلّ

188
00:11:37,550 --> 00:11:40,540
،ما يعني، إذا دمّرتَ واحداً

189
00:11:40,540 --> 00:11:43,380
!سيرجع من جديد بتلبّس تابع آخر

190
00:11:43,790 --> 00:11:44,970
...لا يمكن

191
00:11:44,970 --> 00:11:49,580
!هذه قوّتي... بل قوّتنا

192
00:11:49,580 --> 00:11:52,060
...كلّما أستعملها كلما أستوعب

193
00:11:52,060 --> 00:11:56,470
!أنّ هذه القوّة العظيمة تفوق البشريّة

194
00:12:05,530 --> 00:12:08,320
...بشر تتلبّسهم الظلال الفارغة

195
00:12:08,320 --> 00:12:10,540
كيف لهم أن يكونوا بهذه القوّة؟

196
00:12:10,540 --> 00:12:11,330
...لكن

197
00:12:17,450 --> 00:12:20,000
!هذه القوّة مزيّفة

198
00:12:30,000 --> 00:12:32,300
بطاقة السحر: اتّقاد التنّين

199
00:12:32,570 --> 00:12:37,320
!أسترجع دفاع قائدي بمقدار 3، وأسحب بطاقتين

200
00:12:37,320 --> 00:12:41,070
!كما يرتفع الحدّ الأقصى لنقاط لعبي بمقدار 1

201
00:12:41,070 --> 00:12:43,380
!ثمّ ألعب هذه

202
00:12:43,380 --> 00:12:45,930
!بطاقة السحر: أجنحة التنّين

203
00:12:45,930 --> 00:12:48,070
!ضرر 1 لكلّ الأتباع

204
00:12:55,840 --> 00:12:56,990
لا جدوى

205
00:12:56,990 --> 00:13:01,170
تتفعّل الكلمات الأخيرة المُعطاة لهما
!من جنود الظلّ

206
00:13:02,600 --> 00:13:03,540
مُجدداً؟

207
00:13:03,540 --> 00:13:06,170
تبدو هذه القوّة لا مُنتهية

208
00:13:06,170 --> 00:13:08,360
!لا تنفد

209
00:13:09,160 --> 00:13:10,760
أنهي دوري

210
00:13:12,260 --> 00:13:13,630
سأفوز

211
00:13:13,630 --> 00:13:16,560
سأغلبك

212
00:13:18,720 --> 00:13:19,430
تاكوما؟

213
00:13:19,430 --> 00:13:21,820
...تبّاً... بهذه القوّة

214
00:13:23,190 --> 00:13:24,450
!سحب

215
00:13:25,360 --> 00:13:29,570
!يستدعي تأثير ختم الكوارث جنديّ ظلّ

216
00:13:30,010 --> 00:13:32,630
!اظهري أيّتها الرمّاحة العفريتة

217
00:13:32,630 --> 00:13:35,750
!تحمل الرمّاحة العفريتة عاصفة

218
00:13:35,750 --> 00:13:40,620
!أهاجم قائدك بجنديّ الظلّ والرمّاحة العفريتة

219
00:13:46,550 --> 00:13:47,880
تاكوما؟

220
00:13:48,240 --> 00:13:50,930
يبدو أنّ وقت إنهاء هذا قد حان

221
00:13:50,930 --> 00:13:51,880
أنهي دوري

222
00:13:52,670 --> 00:13:53,720
!سحب

223
00:13:53,720 --> 00:13:56,400
!اظهر يا تنّين الجليد

224
00:13:56,930 --> 00:14:01,850
!يتفعّل تأثير تنّين الجليد، فيصيب كلّ الأتباع بضرر 1

225
00:14:06,480 --> 00:14:09,420
لا تعرف الاستسلام كعادتك

226
00:14:09,420 --> 00:14:14,000
كلّ جنود الظلّ الثلاثة المدمّرين
!تلبّسوا الرمّاحة العفريتة

227
00:14:14,000 --> 00:14:16,200
!بطاقة السحر: الصيد البريّ

228
00:14:16,490 --> 00:14:19,180
!تدمّر تابعاً تلقّى ضرراً

229
00:14:25,560 --> 00:14:26,940
!الكلمات الأخيرة

230
00:14:26,940 --> 00:14:34,400
،تلبّس ثلاثة جنود ظلّ الرمّاحة العفريتة
!فيرجع الثلاثة للملعب

231
00:14:35,100 --> 00:14:40,200
أنا متأكد أنّها توليفة قويّة، لكنّها لن تُفلح ضدّي

232
00:14:41,600 --> 00:14:43,090
!تاكوما

233
00:14:43,090 --> 00:14:44,130
...ماذا

234
00:14:45,920 --> 00:14:47,620
...ريوغاساكي

235
00:14:47,620 --> 00:14:48,620
...أنت

236
00:14:48,620 --> 00:14:54,120
حتّى إذا فزتُ بهذه القوّة، أهناك معنى؟

237
00:14:55,020 --> 00:14:56,620
أهذا تاكوما الحقيقيّ؟

238
00:14:56,900 --> 00:15:00,880
أردتُ هزيمتك بقوّتي الخاصة

239
00:15:01,300 --> 00:15:03,850
!فهمت... صحيح

240
00:15:03,850 --> 00:15:05,880
لا تريد فعل هذا في الواقع

241
00:15:05,880 --> 00:15:07,190
...هزيمتك

242
00:15:19,760 --> 00:15:23,230
سيتدمّر العالم بشجرة الكوارث

243
00:15:23,640 --> 00:15:26,820
وهذا كلّ ما أريده

244
00:15:26,820 --> 00:15:29,160
!لذا سأدمّرك أيضاً

245
00:15:30,410 --> 00:15:32,910
!دوري! سحب

246
00:15:33,350 --> 00:15:37,860
!يستدعي تأثير ختم الكوارث جنديّ ظلّ

247
00:15:38,810 --> 00:15:43,510
!ثمّ يتفعّل التأثير الثاني لجنود الظلّ

248
00:15:47,560 --> 00:15:48,650
ما هذا؟

249
00:15:48,650 --> 00:15:53,170
إذا كان لديّ ثلاثة جنود ظلّ
،في ملعبي عند بداية دوري

250
00:15:53,480 --> 00:15:57,330
!يتّحدون ليصبحوا قائد ظلّ

251
00:16:05,690 --> 00:16:09,530
!أهاجم تنّين الجليد بقائد الظلّ

252
00:16:09,950 --> 00:16:12,960
!لكنّ نقاط هجومه صفر

253
00:16:12,960 --> 00:16:16,330
!يتفعّل تأثير هجوم قائد الظلّ

254
00:16:22,410 --> 00:16:24,070
،يدمّر التابع

255
00:16:25,210 --> 00:16:29,740
!ويضيف نقاط هجومه له

256
00:16:30,220 --> 00:16:32,950
امتصّ تنّين الجليد؟

257
00:16:32,950 --> 00:16:37,460
ثمّ ألعب الجزّار المقنّع ومدافع السراب

258
00:16:37,460 --> 00:16:40,060
أنهي دوري

259
00:16:40,060 --> 00:16:41,890
!دورك

260
00:16:41,890 --> 00:16:45,220
!فلتصارع يا ريوغاساكي

261
00:16:45,490 --> 00:16:46,710
...تاكوما

262
00:16:47,450 --> 00:16:49,240
لا بدّ أنّك تعاني

263
00:16:49,240 --> 00:16:51,580
أعاني؟

264
00:16:51,580 --> 00:16:53,040
كلا

265
00:16:53,040 --> 00:16:54,480
...هذا الألم

266
00:16:59,880 --> 00:17:02,580
!سأنقذك... سأنقذك حتماً

267
00:17:02,580 --> 00:17:05,650
!أنقذك والعالم

268
00:17:05,650 --> 00:17:08,010
!دوري! سحب

269
00:17:08,860 --> 00:17:11,270
!أرجوك يا هايدرا! تطوّر

270
00:17:12,710 --> 00:17:15,790
!أهاجم مدافع السراب بهايدرا

271
00:17:17,570 --> 00:17:20,020
!يمكنه الهجوم مرّتين

272
00:17:20,370 --> 00:17:23,520
!أهاجم الجزّار المقنّع أيضاً

273
00:17:24,600 --> 00:17:26,520
!أنهي دوري

274
00:17:26,520 --> 00:17:29,880
!سأنهي هذا... سأنهيه الآن

275
00:17:29,880 --> 00:17:32,780
!سحب! قاتل المخلب

276
00:17:32,780 --> 00:17:35,760
تابع باندفاع وهلاك؟

277
00:17:35,760 --> 00:17:37,270
!ليس ذلك كلّ شيء

278
00:17:37,710 --> 00:17:40,280
!أهاجم هايدرا به

279
00:17:40,790 --> 00:17:44,130
!يتفعّل تأثير هجوم قاتل المخلب

280
00:17:44,130 --> 00:17:48,220
!فيتلقّى قائد الخصم ضرراً مكافئاً لنقاط هجومه

281
00:18:03,700 --> 00:18:06,010
أشعر بثقل... في جسدي

282
00:18:06,410 --> 00:18:08,520
اكتفيت، صحيح؟

283
00:18:08,870 --> 00:18:12,270
...من هذا العالم، ومن هذه المعركة

284
00:18:12,760 --> 00:18:16,280
كلا، ليست النهاية بعد

285
00:18:16,280 --> 00:18:19,560
!هذا العالم... وهذه المعركة

286
00:18:19,560 --> 00:18:21,870
!إنّهما في بدايتهما

287
00:18:23,740 --> 00:18:25,870
!بطاقة السحر: النفَس المشتعل

288
00:18:26,190 --> 00:18:28,620
!تعطي ضرر 2 لتابع للخصم

289
00:18:29,520 --> 00:18:31,520
ما الذي تفعله؟

290
00:18:31,520 --> 00:18:34,740
لو استعملتها على قاتل المخلب، لاستطعتَ تدميره

291
00:18:35,070 --> 00:18:36,120
!ها أنا ذا

292
00:18:36,120 --> 00:18:36,880
ماذا؟

293
00:18:36,880 --> 00:18:39,520
!زمجر يا تنّين النار

294
00:18:39,520 --> 00:18:41,840
،عندما يكون عدد البطاقات في يدي 2 أو أقلّ

295
00:18:41,840 --> 00:18:43,920
!يتطوّر تنّين النار

296
00:18:48,370 --> 00:18:49,480
...إنّه

297
00:18:49,480 --> 00:18:54,160
!يصيب تأثير هجومه كلّ أتباع الخصم بضرر 3

298
00:18:57,710 --> 00:19:00,100
!ثمّ ألعب راكب التنّين

299
00:19:03,880 --> 00:19:05,450
!أنهي دوري

300
00:19:05,450 --> 00:19:07,440
!تبّاً لك

301
00:19:09,460 --> 00:19:11,490
!ألعب القُبلة المُمتصّة للدماء

302
00:19:12,090 --> 00:19:14,430
!تصيب أحد أتباع الخصم بضرر 2

303
00:19:14,620 --> 00:19:18,380
ثم تسترجع دفاع قائدي بمقدار 2

304
00:19:18,690 --> 00:19:20,890
تبقّى من دفاعك 2 فحسب

305
00:19:21,180 --> 00:19:23,170
!بينما لديّ 20

306
00:19:25,520 --> 00:19:28,020
!لا أمل لك بالفوز

307
00:19:29,190 --> 00:19:30,930
!أتساءل عن ذلك

308
00:19:31,320 --> 00:19:32,620
ماذا؟

309
00:19:32,620 --> 00:19:36,730
!سأتجاوز أيّ مأزق، مهما كان عميقاً

310
00:19:36,730 --> 00:19:39,120
!هكذا ألعب شادوفيرس

311
00:19:39,350 --> 00:19:41,340
!دوري! سحب

312
00:19:42,250 --> 00:19:45,130
أهاجم قائدك بتنّين النار

313
00:19:49,260 --> 00:19:51,670
!انطلق

314
00:19:55,860 --> 00:19:57,330
!رسول التنّين

315
00:19:57,330 --> 00:20:00,010
،أضيف بطاقةً ليدي تكلفتها 5 على الأقل

316
00:20:00,010 --> 00:20:02,010
!وأخفض تكلفتها بمقدار 1

317
00:20:02,500 --> 00:20:05,000
!ثمّ ألعب الفارس النجم

318
00:20:05,000 --> 00:20:09,610
يمنحه تأثيره نفس نقاط هجوم
!أقوى تابع لديّ

319
00:20:10,920 --> 00:20:13,640
!فات الأوان على ذلك

320
00:20:13,640 --> 00:20:15,710
!لا زلتُ أملك دفاعي

321
00:20:15,710 --> 00:20:18,030
!نعم، لذا سأنهي الأمر بهذه

322
00:20:19,270 --> 00:20:24,400
!سأنقذك وأنقذ العالم حتماً

323
00:20:24,400 --> 00:20:26,620
!ألعب هجوم التنّين

324
00:20:33,650 --> 00:20:36,630
!أهاجم قائدك بالفارس النجم

325
00:20:36,630 --> 00:20:39,760
!ريوغاساكي

326
00:20:39,760 --> 00:20:43,730
!اخترق

327
00:20:52,630 --> 00:20:53,940
تبّاً

328
00:20:53,940 --> 00:20:57,330
خسرتُ مجدداً

329
00:21:07,040 --> 00:21:08,850
لا بأس، صحيح؟

330
00:21:08,850 --> 00:21:10,700
لا مشكلة

331
00:21:10,700 --> 00:21:13,860
سنأخذه لدينا قريباً

332
00:21:14,300 --> 00:21:15,460
هكذا إذاً

333
00:21:15,460 --> 00:21:17,530
كانت معركةً مذهلة

334
00:21:17,530 --> 00:21:20,960
أنقذته معركتك

335
00:23:24,290 --> 00:23:26,060
!استعراض بطاقات شادوفيرس

336
00:23:26,060 --> 00:23:28,750
!هذه بطاقة اليوم، ختم الكوارث

337
00:23:28,750 --> 00:23:31,460
تستدعي بطاقة التعويذة هذه
!جنديّ ظلّ كلّ دور

338
00:23:31,460 --> 00:23:32,910
!مريبة وظريفة

339
00:23:32,910 --> 00:23:35,770
!لكنّك أكثر ظرافة برأيي

340
00:23:35,770 --> 00:23:36,450
أكثر ظرافة؟

341
00:23:36,450 --> 00:23:38,230
!أنتِ محمرّة

342
00:23:39,020 --> 00:23:41,480
في الحلقة القادمة

343
00:23:39,980 --> 00:23:43,650
!حسناً، أكاد أصل للطلل حيث البطاقة الأسطوريّة

344
00:23:43,650 --> 00:23:46,430
!احترس، إنّه خصم قويّ

345
00:23:46,780 --> 00:23:48,330
!دع الأمر لي

346
00:23:48,330 --> 00:23:50,030
!الحلقة القادمة: أمسك بالأسطورة

347
00:23:50,650 --> 00:23:52,650
!معركة! شادوفيرس