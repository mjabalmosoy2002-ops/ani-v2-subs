1
00:00:09,100 --> 00:00:10,580
لم يعد هناك وقت إذاً؟

2
00:00:11,930 --> 00:00:15,150
أريد إنقاذ أمّي بدوري

3
00:00:15,520 --> 00:00:18,610
...ولفعل ذلك

4
00:00:19,650 --> 00:00:23,400
هل... تدمير العالم هو الطريقة الوحيدة؟

5
00:00:23,840 --> 00:00:25,510
صحيح

6
00:00:28,060 --> 00:00:30,380
...لكن لا يعني ذلك أن

7
00:00:30,810 --> 00:00:33,290
!لا يمكنني قبوله

8
00:00:34,570 --> 00:00:36,800
لا بطاقة يمكنها قلب الوضع؟

9
00:00:38,470 --> 00:00:41,960
لم يعد القدر إلى جانبك

10
00:00:43,190 --> 00:00:45,810
!لا يمكنك تحديد ذلك

11
00:00:45,810 --> 00:00:47,860
!بطاقة السحر: مشورة التنّين

12
00:00:48,370 --> 00:00:51,810
،ألقي البطاقة الأقلّ تكلفة في يدي

13
00:00:51,810 --> 00:00:53,670
!وأسحب ثلاث بطاقات

14
00:00:53,670 --> 00:00:55,330
!حسنٌ! هذه

15
00:00:55,570 --> 00:00:56,860
!تنّين الجواهر

16
00:00:57,580 --> 00:01:02,590
يعيد تأثير طور الفيض خاصّته
تنّين النار المدمّر ليدي

17
00:01:02,810 --> 00:01:06,340
لا أملك نقاط لعب كافية لاستعماله

18
00:01:07,180 --> 00:01:11,620
يمكن لضرر 2 من تنّين الدرع
وهجوم تنّين الجواهر

19
00:01:11,620 --> 00:01:14,330
هزيمة تنّين نار الظلّ

20
00:01:14,590 --> 00:01:16,460
لكنّي متأكد أنّ الوقت لم يحن بعد

21
00:01:17,590 --> 00:01:19,350
!ألعب تنّين الدرع

22
00:01:22,040 --> 00:01:25,760
يصيب تأثير الفيض خاصّته أحد
!أتباع الخصم بضرر 2

23
00:01:28,920 --> 00:01:30,320
لن ينفع

24
00:01:30,660 --> 00:01:32,320
أنهي دوري

25
00:01:32,600 --> 00:01:38,620
يبدو أنّك تلعب تابعاً بحاجز
!لتوفير الوقت، لكن لن يفلح ذلك

26
00:01:39,620 --> 00:01:43,030
!ألعب بطاقة السحر: قوّة التنّين الشرّير

27
00:01:59,030 --> 00:01:59,840
ماذا؟

28
00:02:00,090 --> 00:02:03,210
!هاجم يا تنّين نار الظلّ

29
00:02:03,210 --> 00:02:07,050
،يُضاف التأثير الإضافي من قوّة التنّين الشرّير

30
00:02:07,560 --> 00:02:09,880
!ويتلقّى كلّ الأتباع ضرر 6

31
00:02:11,610 --> 00:02:13,260
أنهي دوري

32
00:02:18,820 --> 00:02:20,080
!دوري

33
00:02:20,440 --> 00:02:23,060
ألعب بطاقة السحر: اتّقاد التنّين

34
00:02:23,060 --> 00:02:24,740
!أسحب بطاقتين

35
00:02:24,740 --> 00:02:26,740
!حسنٌ، هذه هي

36
00:02:27,040 --> 00:02:29,160
!بطاقة السحر: الصيد البرّي

37
00:02:31,450 --> 00:02:34,540
!أدمّر تابعاً تلقّى ضرراً

38
00:02:42,430 --> 00:02:45,350
!ثمّ ألعب التنّين حديديّ الحراشف

39
00:02:45,350 --> 00:02:49,900
الضرر من نقطتين الذي سبّبه تنّين الدرع
كان لأجل هذا إذاً؟

40
00:02:49,900 --> 00:02:51,240
!أجل

41
00:02:51,240 --> 00:02:53,820
!أنا كنت مؤمناً بمجموعتي

42
00:02:54,190 --> 00:02:57,320
مؤمناً؟ يا للسخافة

43
00:02:58,150 --> 00:03:00,360
،إذا كان الإيمان بمفرده يكفي لإنقاذك

44
00:03:00,740 --> 00:03:03,200
لما تذوّقتُ اليأس

45
00:03:04,880 --> 00:03:05,860
...هذه

46
00:03:06,120 --> 00:03:09,010
يتفعّل تأثير تنّين جواهر الظلّ

47
00:03:11,000 --> 00:03:15,460
إذا تدمّر تنّين نار الظلّ
،خلال هذه المعركة

48
00:03:16,740 --> 00:03:19,640
يٌضاف تنّين انقراض ليدي

49
00:03:19,640 --> 00:03:21,290
!النهاية قريبة

50
00:03:21,780 --> 00:03:23,560
!تنّين الانقراض

51
00:03:40,810 --> 00:03:43,490
تـ-تنّين الانقراض؟

52
00:03:44,210 --> 00:03:52,040
لا يمكن للأتباع المطوريّن إصابته بضرر
حتّى بداية دوري التالي

53
00:03:54,420 --> 00:04:01,680
لا يمكن لتنّين النار في يدك هزيمته

54
00:04:02,590 --> 00:04:04,380
أنهي دوري

55
00:04:05,720 --> 00:04:06,850
!دوري

56
00:04:07,130 --> 00:04:08,010
!سحب

57
00:04:09,980 --> 00:04:13,240
لا بطاقات لديّ يمكنها
هزيمة تنّين الانقراض

58
00:04:13,240 --> 00:04:14,150
...في تلك الحالة

59
00:04:14,610 --> 00:04:20,810
!سأختار هذا... ألعب ليفايثان
!كما تنّين العاصفة الرمليّة

60
00:04:21,240 --> 00:04:25,370
وأهاجم تنّين جواهر الظلّ بالتنّين
!حديديّ الحراشف

61
00:04:29,090 --> 00:04:31,070
أنهي دوري

62
00:04:31,910 --> 00:04:37,360
يبدو أنّك تخال بإمكانك تدمير
تنّين الانقراض في الدور التالي

63
00:04:37,360 --> 00:04:40,630
!لكن تلك الاستراتيجية ضعيفة

64
00:04:41,080 --> 00:04:44,850
!أهاجم تنّين العاصفة الرملية بتنّين الانقراض

65
00:04:48,800 --> 00:04:50,270
!لا يزال ليفايثان لديّ

66
00:04:50,460 --> 00:04:53,100
يتفعّل تأثير تنّين الانقراض

67
00:04:53,600 --> 00:04:59,640
عندما يهاجم أحد أتباعي بهجوم 7 أو أكثر، أسحب بطاقة

68
00:04:59,640 --> 00:05:03,110
وإذا كانت تلك البطاقة تابع تنّين

69
00:05:03,700 --> 00:05:05,530
!تصبح تكلفتها صفراً

70
00:05:06,520 --> 00:05:08,920
!انطلق يا تنّين الأصل

71
00:05:11,620 --> 00:05:14,230
،يحمل تنّين الأصل عاصفة

72
00:05:14,230 --> 00:05:16,150
فيهاجم ليفايثان

73
00:05:18,650 --> 00:05:21,190
يتفعّل تأثير تنّين الانقراض

74
00:05:21,190 --> 00:05:25,080
أسحب بطاقة، وإذا كانت تابع تنّين
تصبح تكلفتها صفراً

75
00:05:25,080 --> 00:05:25,600
مجدداً؟

76
00:05:25,600 --> 00:05:28,100
!اسحقه يا تنّين الكور

77
00:05:31,340 --> 00:05:35,940
يتفعّل تأثير تنّين الكور ويدمّر تابعاً للخصم

78
00:05:36,680 --> 00:05:41,070
!ثمّ ألعب تنّين الضباب والتنّين المؤذي

79
00:05:43,940 --> 00:05:46,570
!لعب خمسة أتباع في دورٍ واحد

80
00:05:46,570 --> 00:05:48,790
انتهى أمرك

81
00:05:49,230 --> 00:05:50,740
أنهي دوري

82
00:05:50,980 --> 00:05:53,110
!حان دوري إذاً

83
00:05:53,490 --> 00:05:55,860
لمَ تواصل القتال؟

84
00:05:56,390 --> 00:05:58,090
...فأنت سلفاً

85
00:05:58,780 --> 00:06:01,710
أجل، أنا في مأزقٍ كبير

86
00:06:01,710 --> 00:06:04,230
لكن حدث هذا قبلاً

87
00:06:05,490 --> 00:06:10,230
واجهتُ خصوماً أقوياء، وظننت أنّي
سأخسر مرّات عدّة

88
00:06:11,150 --> 00:06:11,990
...لكن

89
00:06:12,520 --> 00:06:17,980
!في النهاية... في النهاية، أجابت البطاقات ندائي دوماً

90
00:06:18,270 --> 00:06:21,050
!لذا أؤمن ببطاقاتي

91
00:06:21,050 --> 00:06:24,700
!ستشعل هذه النيران المحترقة السماء

92
00:06:24,900 --> 00:06:29,570
!فلتعرني قوّتك يا تنّين الشعلة اللا متناهية

93
00:06:38,970 --> 00:06:44,410
،يتفعّل تأثير تنّين الشعلة اللا متناهية
!فيصيب قائد الخصم بضرر 5

94
00:06:50,170 --> 00:06:52,910
!كنتُ مؤمناً بك

95
00:06:55,930 --> 00:06:58,650
!تطوّر يا تنّين الشعلة اللا متناهية

96
00:07:04,640 --> 00:07:07,560
!دمّر كلّ الأتباع بدفاع 5 أو أكثر

97
00:07:12,700 --> 00:07:17,640
ويُصاب قائد الخصم بضرر 1
!مقابل كلّ تابع مُدمّر

98
00:07:21,100 --> 00:07:22,450
لم تنته بعد إذاً؟

99
00:07:22,700 --> 00:07:24,130
!أجل

100
00:07:24,130 --> 00:07:27,970
!أهاجم تنّين الانقراض بتنّين الشعلة اللا متناهية

101
00:07:28,580 --> 00:07:31,460
!يتفعّل تأثيره

102
00:07:31,460 --> 00:07:33,720
،عندما يهاجم تابعاً للخصم

103
00:07:33,720 --> 00:07:38,020
!يصيب قائد الخصم بالضرر نفسه

104
00:07:49,140 --> 00:07:50,880
!أنهي دوري الآن

105
00:07:52,440 --> 00:07:55,210
لم أتوقّع أن تحاصرني هكذا

106
00:07:55,210 --> 00:07:58,200
قوّة الأساطير مبهرة

107
00:07:58,480 --> 00:08:00,150
!لستُ وحدي

108
00:08:00,150 --> 00:08:03,370
!يملك كلّ أصدقائي قوّة فائقة

109
00:08:03,700 --> 00:08:07,490
!إذا تعاونّا، سنستطيع حماية هذا العالم

110
00:08:08,080 --> 00:08:08,920
!وإنقاذ أمّي

111
00:08:08,920 --> 00:08:13,630
أساغي داخلها، الآن

112
00:08:13,990 --> 00:08:17,680
داخلها؟ أتقصد شجرة الكوارث؟

113
00:08:18,870 --> 00:08:23,610
إنّها محتجزة داخلها من قِبل قوّة عظيمة

114
00:08:24,060 --> 00:08:25,640
قوّة عظيمة؟

115
00:08:25,860 --> 00:08:28,900
أجل، قوّة عظيمة

116
00:08:29,470 --> 00:08:33,740
استولت نيكسس على جسدها، ونامت

117
00:08:34,070 --> 00:08:41,180
لإخراجها منها، عليّ تحقيق هدفها

118
00:08:42,450 --> 00:08:45,620
...هدف نيكسس تلك إذاً

119
00:08:45,620 --> 00:08:50,870
تدمير هذا العالم وامتصاصه داخل شجرة الكوارث

120
00:08:51,060 --> 00:08:53,730
أنت تثرثر يا إيجي

121
00:08:54,230 --> 00:08:59,850
...إذا كانت نائمةً الآن، واستعملنا البطاقات الأسطوريّة لختمها

122
00:09:00,200 --> 00:09:05,940
رغبتكم بحماية العالم صائبة

123
00:09:06,790 --> 00:09:11,040
!لكن كونكم على صواب لا يكفي لإنقاذها

124
00:09:11,410 --> 00:09:13,310
ما-ماذا؟

125
00:09:25,690 --> 00:09:26,800
ما هذا؟

126
00:09:27,430 --> 00:09:29,000
ما الذي يجري؟

127
00:09:31,790 --> 00:09:33,580
ما هذا؟

128
00:09:33,960 --> 00:09:36,550
يقاتل ريوغاساكي هيرو الآن

129
00:09:37,050 --> 00:09:40,260
لا نعرف من خصمه، لكنّه في خطرٍ كبير

130
00:09:40,260 --> 00:09:43,890
!انتظرني يا هيرو! أنا قادم لإنقاذك الآن

131
00:09:43,890 --> 00:09:47,090
!علينا مساعدة هيرو-سان

132
00:09:47,090 --> 00:09:50,080
!أجل! لا بدّ أنّه وحيدٌ الآن

133
00:09:51,470 --> 00:09:52,720
...هيرو-كن

134
00:10:08,190 --> 00:10:10,460
الظلال الفارغة تجتمع داخل تلك البطاقة

135
00:10:10,460 --> 00:10:15,170
لو استسلمت أسرع، لما كان عليك
أن تعاني بلا مغزى

136
00:10:15,540 --> 00:10:18,820
لكن هذا قدرك أيضاً

137
00:10:18,820 --> 00:10:21,270
بطاقة السحر: استيقاظ الظلام

138
00:10:22,810 --> 00:10:24,170
ما هذا؟

139
00:10:24,170 --> 00:10:28,600
،إذا تدمّر تنّين الانقراض في هذه المعركة

140
00:10:28,910 --> 00:10:33,000
تستدعي تنّين انقراض مطوّر للملعب

141
00:10:33,000 --> 00:10:38,520
!سيهبط عليك دمار عظيم يلتهم العالم الآن

142
00:10:40,820 --> 00:10:47,530
كلّ جزء من جسد تنّين الانقراض
المطوّر عبارة عن تابع

143
00:10:47,530 --> 00:10:49,830
تحمل أجنحته الحامية حاجزاً

144
00:10:49,830 --> 00:10:52,320
وتمزّق سيوفه الحادّة خصومه إرباً

145
00:10:52,720 --> 00:10:55,840
هذا هو تنّين الانقراض المطوّر

146
00:10:55,840 --> 00:11:00,540
أ-أي يعادل بمفرده خمسة أتباع؟

147
00:11:00,540 --> 00:11:02,180
تماماً

148
00:11:02,180 --> 00:11:03,480
ها أنا ذا

149
00:11:03,480 --> 00:11:09,400
،لا يمكن لنصل الروح مهاجمة أتباع الخصم
لكنّه يملك عاصفةً وامتصاصاً

150
00:11:09,400 --> 00:11:12,450
أهاجم قائدك بنصل الروح

151
00:11:18,090 --> 00:11:23,480
يسترجع امتصاصه صحّة قائدي بمقدار 2

152
00:11:24,230 --> 00:11:28,040
،طالما أملك نصل الروح وشفرة الريح في ملعبي

153
00:11:28,040 --> 00:11:31,160
يصبح الضرر للأجنحة الحارسة صفراً

154
00:11:31,560 --> 00:11:37,000
طالما هذا التابع موجود، يصبح الضرر
الذي يتلقّاه قائدي صفراً

155
00:11:38,500 --> 00:11:40,710
اقتربت لحظة الدمار

156
00:11:41,150 --> 00:11:44,190
ستستيقظ شجرة الكوارث

157
00:11:45,930 --> 00:11:49,010
!أبي! لن أخسر

158
00:11:49,010 --> 00:11:50,920
!سأفوز وأنقذ الجميع

159
00:11:52,990 --> 00:11:56,160
،فلتصارع إذاً، وتقاوم

160
00:11:56,160 --> 00:11:58,450
!قاتل هذا الدمار العظيم

161
00:11:58,720 --> 00:12:01,370
!دوري! سحب

162
00:12:02,030 --> 00:12:05,660
لا بأس، لا زلتُ أملكك

163
00:12:05,940 --> 00:12:08,660
البطاقة التي لطالما كانت بجواري

164
00:12:09,450 --> 00:12:13,220
!البطاقة التي أنقذتني مرّات عديدة

165
00:12:13,460 --> 00:12:15,990
!زمجر يا تنّين النار

166
00:12:16,280 --> 00:12:19,620
!أهاجم الأجنحة الحارسة بتنّين النار

167
00:12:20,130 --> 00:12:24,350
يصيب تأثير هجومه كلّ
!أتباع الخصم بضرر 3

168
00:12:25,740 --> 00:12:29,140
لا يؤثّر أيّ هجوم على الأجنحة الحارسة

169
00:12:29,140 --> 00:12:30,230
!لم أنته بعد

170
00:12:30,230 --> 00:12:33,640
!أهاجم أجنحة الانبعاث بتنّين الشعلة اللا متناهية

171
00:12:36,560 --> 00:12:41,850
!يتفعّل تأثيره، فيخترق الضرر درعك

172
00:12:42,950 --> 00:12:44,110
يا لسذاجتك

173
00:12:51,340 --> 00:12:52,940
واسترجعت دفاعه بمقدار 10

174
00:12:53,530 --> 00:12:54,800
!ماذا؟

175
00:12:55,260 --> 00:12:58,010
تدمّر الجناح الأيسر

176
00:12:58,010 --> 00:13:01,770
لكن لا يزال الجناح الأيمن وكلا السيفين في الملعب

177
00:13:01,770 --> 00:13:03,430
أيمكنك هزيمتهم؟

178
00:13:03,430 --> 00:13:08,430
!ختاماً، ألعب التنّين المسجون وأنهي دوري

179
00:13:08,430 --> 00:13:10,600
لتبدأ النهاية

180
00:13:11,040 --> 00:13:14,000
أهاجم التنّين المسجون بشفرة الريح

181
00:13:14,000 --> 00:13:18,870
،يتفعّل تأثيرها، عندما تهاجم تابعاً

182
00:13:18,870 --> 00:13:23,020
!تصيبه بضرر 6 قبل أن يحلّ الضرر

183
00:13:26,470 --> 00:13:28,050
لم يستطع المقاومة حتّى؟

184
00:13:28,050 --> 00:13:31,200
ثمّ أستدعي التنّين المتحوّل العملاق

185
00:13:31,510 --> 00:13:35,320
وأفعّل تأثير تنّين الانقراض المطوّر

186
00:13:37,090 --> 00:13:39,470
،عندما يظهر تابع في ملعبي

187
00:13:39,470 --> 00:13:47,140
أدمّره، وأضيف نقاط هجومه
!ودفاعه لنصل الروح

188
00:13:50,180 --> 00:13:53,260
!أهاجم قائدك بنصل الروح

189
00:13:58,530 --> 00:14:02,840
يسترجع الامتصاص صحّة قائدي

