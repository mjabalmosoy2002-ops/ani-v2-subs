1
00:00:12,010 --> 00:00:13,570
حدث ذلك لكم أيضاً؟

2
00:00:13,570 --> 00:00:16,360
...كان مسليّاً نوعاً ما، لكن

3
00:00:16,360 --> 00:00:19,900
أجل، لكن يبقى الحلم حلماً

4
00:00:19,900 --> 00:00:23,420
بالنسبة لي، الحقيقة هي كلّ شيء

5
00:00:23,420 --> 00:00:26,560
تقول ذلك، لكنّك كنت مستمتعاً كثيراً، صحيح؟

6
00:00:26,560 --> 00:00:28,080
!ليس صحيحاً

7
00:00:29,560 --> 00:00:33,030
ماذا عنك يا ريوغاساكي هيرو؟

8
00:00:33,030 --> 00:00:34,440
هل استمتعت؟

9
00:00:34,710 --> 00:00:36,470
...حسناً

10
00:00:37,360 --> 00:00:38,590
أحببتُ الأمر

11
00:00:39,650 --> 00:00:42,890
لكن علينا المضيّ للأمام، أليس كذلك؟

12
00:00:42,890 --> 00:00:44,990
لذا هذا حسن

13
00:00:46,420 --> 00:00:47,920
هذا من طباعك

14
00:00:47,920 --> 00:00:49,110
حقّاً؟

15
00:00:54,060 --> 00:00:55,580
!ما الأمر؟

16
00:00:58,690 --> 00:00:59,960
...أنتِ

17
00:00:59,960 --> 00:01:01,750
أيّها المُفيقون

18
00:01:08,650 --> 00:01:13,330
تجاوزوا كلّ شيء، واذهبوا للقلعة في السماء

19
00:01:17,360 --> 00:01:19,810
العالم يحلم الآن

20
00:01:20,690 --> 00:01:23,290
وعليكم إيقاظه

21
00:01:29,830 --> 00:01:34,230
جذر الفوضى يكمن وراء السماء

22
00:01:51,790 --> 00:01:52,910
حسناً

23
00:01:52,910 --> 00:01:56,930
تريدين منّا صعود تلك الأدراج
وهزيمة جذر الفوضى، صحيح؟

24
00:01:57,440 --> 00:01:58,210
أجل

25
00:01:58,600 --> 00:02:01,400
لا تفشلوا مهما تطلّب الأمر

26
00:02:01,880 --> 00:02:03,770
اهزموه

27
00:02:05,440 --> 00:02:07,420
لننهِ الأمر يا هيرو

28
00:02:07,420 --> 00:02:09,350
!لنبدأ يا لوشيا

29
00:02:17,630 --> 00:02:18,630
!حاذر

30
00:02:19,460 --> 00:02:20,640
!اسبقنا يا هيرو

31
00:02:22,350 --> 00:02:23,530
ظلال فارغة؟

32
00:02:23,950 --> 00:02:26,880
حراسٌ وفقما أظنّ

33
00:02:26,880 --> 00:02:28,320
اذهب يا هيرو

34
00:02:29,010 --> 00:02:29,760
...لكن

35
00:02:29,760 --> 00:02:32,980
أجل، دع الأمر هنا لنا

36
00:02:32,980 --> 00:02:33,740
أجل

37
00:02:33,740 --> 00:02:35,530
!سنكون بخير

38
00:02:35,530 --> 00:02:38,500
أنا أسجّل عودتي الكبيرة لكوني عبقريّاً

39
00:02:38,500 --> 00:02:40,980
!فلتستمتع يا أوني-تشان

40
00:02:42,010 --> 00:02:43,920
...ستستطيع بالتأكيد

41
00:02:45,030 --> 00:02:46,100
فهمت

42
00:02:46,470 --> 00:02:48,170
!أراكم لاحقاً يا رفاق

43
00:02:48,970 --> 00:02:50,060
!أجل

44
00:02:50,780 --> 00:02:53,660
!معركة! شادوفيرس

45
00:02:55,500 --> 00:02:57,410
...أيّها المُفيقون

46
00:03:00,060 --> 00:03:02,410
...مصير العالم

47
00:03:07,240 --> 00:03:09,740
على عواتقكم الآن

48
00:03:11,830 --> 00:03:14,390
تقدّموا للأمام بلا تردّد

49
00:03:16,960 --> 00:03:19,330
...لذاك المستقبل الذي اختفى قبلاً

50
00:03:20,320 --> 00:03:23,220
...رجاءً... رجاءً

51
00:03:25,200 --> 00:03:26,770
!لتصلوه

52
00:03:28,550 --> 00:03:30,210
كنتُ أعرف أنّك ستأتي

53
00:03:30,930 --> 00:03:31,970
...أبي

54
00:03:32,330 --> 00:03:34,790
أحقّق رغبة نيكسس

55
00:03:35,350 --> 00:03:37,860
لإنقاذ أساغي

56
00:03:37,860 --> 00:03:40,670
أريد إنقاذ الجميع

57
00:03:40,670 --> 00:03:43,660
!لذا سأفوز حتماً

58
00:03:44,250 --> 00:03:47,160
!معركة! شادوفيرس

59
00:05:41,390 --> 00:05:43,720
!دوري! سحب

60
00:05:44,080 --> 00:05:47,350
!أهاجم تنّين الظلّ الرمليّ بالتنّين العاجيّ

61
00:05:51,610 --> 00:05:55,620
قلتَ أنّ العالم لن يتدمّر
يا أبي، أليس كذلك؟

62
00:05:56,010 --> 00:05:58,500
أنّ الجميع سيعيشون بسعادة في أحلامهم

63
00:05:59,350 --> 00:06:03,180
صحيحٌ أنّي سُررت برؤية أمّي هنا مُجدداً

64
00:06:03,870 --> 00:06:08,080
!لكنّي أفضّل قتال ذاتك الحقيقيّة هكذا

65
00:06:08,550 --> 00:06:10,850
!بطاقة السحر: وسيط التنّين الروحي

66
00:06:13,490 --> 00:06:14,850
يافعٌ جدّاً

67
00:06:16,670 --> 00:06:20,520
لا تعرف اليأس الحقيقيّ

68
00:06:21,700 --> 00:06:24,230
!أيّتها الظلال، لتغطّي الأرض

69
00:06:24,680 --> 00:06:26,710
ألعب التنّين البشريّ الشرّير

70
00:06:27,580 --> 00:06:30,110
يتفعّل تأثيره

71
00:06:32,110 --> 00:06:34,610
ألقي تابعاً من يدي

72
00:06:40,530 --> 00:06:43,130
ألم يكن تنّين نار الظلّ بطاقتك الرابحة؟

73
00:06:43,130 --> 00:06:47,560
كلّها مجرّد أدوات لتحقيق هدفي

74
00:06:47,890 --> 00:06:50,090
الأمر ينطبق عليك أيضاً، صحيح يا هيرو؟

75
00:06:50,090 --> 00:06:52,870
تلعب شادوفيرس لتحقيق هدفك

76
00:06:52,870 --> 00:06:54,690
وتستعمل بطاقاتك بتلك البغية

77
00:06:54,900 --> 00:06:58,230
!كلا! بطاقاتي ليست مجرّد أدواتي

78
00:06:58,470 --> 00:07:02,030
!كلّها رفيقة لي

79
00:07:02,470 --> 00:07:04,100
!دوري! سحب

80
00:07:04,340 --> 00:07:06,010
!ألعب التنّين المُحارب

81
00:07:07,300 --> 00:07:09,200
ما تفعله يا أبي خطأ

82
00:07:09,200 --> 00:07:14,470
!لا تريد أمّي منك أن تدمّر العالم لأجلها

83
00:07:14,470 --> 00:07:15,960
أعي ذلك

84
00:07:17,110 --> 00:07:20,140
لا تريد أساغي هذا

85
00:07:20,140 --> 00:07:23,170
إنّها أمنيتي أنا، رغبتي

86
00:07:23,170 --> 00:07:28,370
والإجابة الوحيدة التي وجدتها
في نهاية رحلتي الأبديّة

87
00:07:28,370 --> 00:07:29,340
!سحب

88
00:07:38,110 --> 00:07:39,520
!أطوّر موشوسو

89
00:07:41,270 --> 00:07:43,480
!أهاجم المحاكاة الشيطانيّة

90
00:07:43,480 --> 00:07:44,260
...ثمّ

91
00:07:44,260 --> 00:07:48,810
يصيب تأثير التنّين حديديّ الحراشف
!عظاءة نار الظلّ بضرر 2

92
00:07:53,090 --> 00:07:55,460
أطوّر تنّين الظلّ المُحارب

93
00:07:56,320 --> 00:07:58,150
،يتفعّل تأثير تطوّره

94
00:07:59,160 --> 00:08:03,330
،فيصيب نفسه بضرر 2
!وكلّ الأتباع الآخرين بضرر 4

95
00:08:09,550 --> 00:08:10,820
!احرق

96
00:08:12,890 --> 00:08:14,650
!النَفس الحارق

97
00:08:18,910 --> 00:08:21,220
لا يهمّ أيّ ما تفعله

98
00:08:21,220 --> 00:08:23,920
لن نعرف ذلك حتّى نجرّب، صحيح؟

99
00:08:23,920 --> 00:08:25,100
أنهي دوري

100
00:08:25,100 --> 00:08:28,350
فهمت، كما يُتوقّع من ابني

101
00:08:28,350 --> 00:08:32,670
!لكن كما كنتُ سابقاً، فأنت ساذج للغاية

102
00:08:33,010 --> 00:08:34,760
!دوري! سحب

103
00:08:34,760 --> 00:08:36,750
!ألعب حارس تنّين الظلّ

104
00:08:37,840 --> 00:08:40,480
يمتلك حاجزاً وهلاكاً

105
00:08:41,540 --> 00:08:42,720
هيرو

106
00:08:42,720 --> 00:08:46,610
أتظنّ أنّ العالم سيُنقذ طالما
أنّك لا تستسلم فحسب؟

107
00:08:47,050 --> 00:08:49,080
لمَ يا أبي؟

108
00:08:49,080 --> 00:08:51,950
!لمَ يأست من هذا العالم؟

109
00:08:51,950 --> 00:08:55,360
لأنّها الطريقة الوحيدة للمضيّ للأمام

110
00:08:56,830 --> 00:09:01,850
،لإنقاذ أساغي من أن تصبح تضحية
دخلتُ شجرة الكوارث

111
00:09:02,290 --> 00:09:06,400
والتقيتُ هناك اليأس الأبديّ

112
00:09:07,680 --> 00:09:12,370
يتحرّك الزمن داخل شجرة الكوارث
بشكلٍ مختلف عن الواقع

113
00:09:13,450 --> 00:09:17,120
يمكن أن تكون الثانية مئة أو ألف عام

114
00:09:17,790 --> 00:09:22,180
...بحثتُ عن أساغي بلا توقّف، لكن

115
00:09:22,490 --> 00:09:25,970
أساغي، أين أنت؟

116
00:09:26,550 --> 00:09:29,900
وحدة، إنهاك، قلق

117
00:09:30,230 --> 00:09:34,050
كلّها تجانست معاً، وغرقتُ في اليأس

118
00:09:34,700 --> 00:09:37,210
وفقدتُ ذاتي تدريجياً

119
00:09:44,330 --> 00:09:46,510
ما الذي ترغب به؟

120
00:09:46,510 --> 00:09:48,490
ما الذي ستحقّقه؟

121
00:09:49,010 --> 00:09:52,110
ستكون رغبتك هي الأساس

122
00:09:52,480 --> 00:09:55,660
...رغبتي... رغبتي هي

123
00:09:57,030 --> 00:09:59,860
!أساغي... أريد إنقاذك

124
00:10:00,270 --> 00:10:06,000
فلتخدمني إذاً وتحبس العالم في حلمٍ مُسالم

125
00:10:06,000 --> 00:10:09,060
عندها سأحرّر هذه الحاوية

126
00:10:16,800 --> 00:10:20,310
تخلّيتُ عن العالم في تلك اللحظة

127
00:10:21,070 --> 00:10:27,780
تحقيق رغبة نيكسس سيجعلها تترك جسد
أساغي وتختفي لعالمٍ آخر

128
00:10:28,280 --> 00:10:30,610
ستتحرّر أساغي

129
00:10:31,550 --> 00:10:33,210
فهمت يا أبي

130
00:10:33,640 --> 00:10:36,570
تفهم، ولا تزال تصارع؟

131
00:10:36,850 --> 00:10:38,620
...أجل، لأن

132
00:10:38,920 --> 00:10:42,160
ما تقوله هو أنّك لا تستطيع
الثقة بي، صحيح؟

133
00:10:42,840 --> 00:10:46,420
!سأنقذك وأنقذ أمّي والعالم

134
00:10:46,420 --> 00:10:47,670
!سأفعل

135
00:10:48,410 --> 00:10:53,410
!سأريك مدى قوّتي، وأجعلك تؤمن بكلماتي

136
00:10:54,100 --> 00:10:55,580
!ألعب ليفايثان

137
00:10:56,750 --> 00:10:59,040
تريني قوّتك؟

138
00:10:59,040 --> 00:11:01,320
ما الذي تستطيع تحقيقه؟

139
00:11:01,320 --> 00:11:02,890
لا أدري

140
00:11:02,890 --> 00:11:05,970
لكن فعل مجرّد ما تستطيع
!القيام به مملٍّ

141
00:11:05,970 --> 00:11:08,010
...لأنّ الخصم قويّ جدّاً

142
00:11:08,010 --> 00:11:09,640
...لأنّي أظنّ أن ليس بمقدوري الفوز

143
00:11:09,640 --> 00:11:11,640
...ولأنّي لا أستسلم بغضّ النظر

144
00:11:11,640 --> 00:11:13,410
!هذا ما يجعل المعارك مسليّة

145
00:11:13,410 --> 00:11:15,860
!بطاقة السحر: غضب التنّين

146
00:11:17,020 --> 00:11:19,690
!تصيب تابعاً للخصم بضرر 6

147
00:11:25,460 --> 00:11:26,780
أنهي دوري

148
00:11:26,780 --> 00:11:29,160
فهمت، لا بأس

149
00:11:29,420 --> 00:11:33,160
سأريك الفرق في عزيمتينا إذاً

150
00:11:33,450 --> 00:11:34,840
وأريك مدى ضعفك

151
00:11:34,840 --> 00:11:37,410
!وأجعلك تتذوّق اليأس

152
00:11:38,270 --> 00:11:40,630
!ألعب تنّين وميض الظلّ

153
00:11:43,380 --> 00:11:47,770
يصيب تأثير طور الفيض خاصّته
!تابعاً للخصم بضرر 4

154
00:11:53,190 --> 00:11:56,020
ألعب تنّين عاصفة الظلّ الذي يحمل عاصفة

155
00:11:58,570 --> 00:12:01,140
!وأهاجم ليفايثان

156
00:12:06,640 --> 00:12:07,770
!لم أنته بعد

157
00:12:07,770 --> 00:12:09,130
!دوري! سحب

158
00:12:09,350 --> 00:12:11,650
!ألعب حارس التنّين والرخّ

159
00:12:11,650 --> 00:12:15,300
يتفعّل تأثير طور الفيض لحارس التنّين، ويحصل على حاجز

160
00:12:15,700 --> 00:12:18,550
!سأنقذ العالم وأنقذ الجميع

161
00:12:19,090 --> 00:12:21,960
كيف تثق بنفسك لهذا الحدّ؟

162
00:12:21,960 --> 00:12:23,960
!لأنّ لديّ رفاقاً

163
00:12:24,240 --> 00:12:26,290
لديّ روابط مع رفاقي

164
00:12:26,290 --> 00:12:29,800
!لذا بمقدوري الإيمان بنفسي حتّى النهاية

165
00:12:30,550 --> 00:12:36,120
!أطوّر الرخّ! وأهاجم تنّين وميض الظلّ

166
00:12:41,630 --> 00:12:42,950
!أنهي دوري

167
00:12:43,660 --> 00:12:45,250
رفاقك؟

168
00:12:45,250 --> 00:12:46,620
روابطكم؟

169
00:12:47,110 --> 00:12:48,360
ساذج

170
00:12:49,120 --> 00:12:51,190
أنت ساذجٌ بحقّ

171
00:12:51,490 --> 00:12:58,220
سأريك القوّة العظيمة التي حصلت
!عليها في نهاية الوحدة الأبديّة

172
00:13:11,340 --> 00:13:13,910
بطاقة السحر: إعادة إحياء الظلّ

173
00:13:14,820 --> 00:13:16,520
ما هذا السحر؟

174
00:13:19,610 --> 00:13:23,810
ألعب تابعاً ألقيتُه من يدي خلال هذه المعركة

175
00:13:24,120 --> 00:13:27,230
وإذا كان ذلك التابع تنّين نار الظلّ

176
00:13:27,230 --> 00:13:30,120
!يتحوّل لتنّين انقراض

177
00:13:30,120 --> 00:13:33,950
!لذا ألقيتَ تنّين نار الظلّ في المقبرة؟

178
00:13:34,690 --> 00:13:36,740
هنا نهاية كلّ الأشياء

179
00:13:37,210 --> 00:13:40,400
!فلتظهر يا تنّين الانقراض

180
00:13:55,690 --> 00:13:56,600
!تطوّر

181
00:14:01,530 --> 00:14:03,850
!هاجم حارس التنّين

182
00:14:06,320 --> 00:14:09,080
!يتفعّل تأثير تنّين الانقراض

183
00:14:09,080 --> 00:14:14,650
عندما أهاجم بتابع يملك هجوم 7
!أو أكثر، أسحب بطاقة

184
00:14:14,650 --> 00:14:19,680
!وإذا كانت تلك البطاقة تابع تنين، تصبح تكلفتها صفراً

185
00:14:19,680 --> 00:14:22,160
!تعال لي يا تنّين الأصل

186
00:14:24,860 --> 00:14:26,260
...هذه التوليفة

187
00:14:26,450 --> 00:14:29,830
!أهاجم الرخّ بتنّين الأصل

188
00:14:33,430 --> 00:14:36,060
يتفعّل تأثير تنّين الانقراض

189
00:14:36,390 --> 00:14:39,990
فأسحب بطاقة، وتصبح تكلفتها صفراً وألعبها

190
00:14:39,990 --> 00:14:41,470
!حاصد الأرواح

191
00:14:45,360 --> 00:14:46,680
!ويحصل على حاجز

192
00:14:48,050 --> 00:14:49,630
أنهي دوري

193
00:14:49,900 --> 00:14:52,010
!كلا، ليس بعد

194
00:14:52,010 --> 00:14:53,870
سأتجاوزك

195
00:14:53,870 --> 00:14:54,920
...ثمّ

196
00:14:56,290 --> 00:14:58,040
!أهزمك

197
00:14:58,040 --> 00:15:00,420
!بطاقة السحر: أجنحة التنّين

198
00:15:00,420 --> 00:15:02,870
!تصيب كلّ الأتباع بضرر 1

199
00:15:03,120 --> 00:15:06,170
!ثمّ ألعب بطاقة السحر: الحريق الهائل

200
00:15:06,750 --> 00:15:09,080
!تصيب كلّ الأتباع بضرر 4

201
00:15:09,270 --> 00:15:12,890
!يتلقّى كلّ الأتباع ضرر 5 بتأثير السحرين

202
00:15:15,490 --> 00:15:18,180
!هيّا، دورك يا أبي

203
00:15:18,180 --> 00:15:20,230
