1
00:00:04,020 --> 00:00:05,390
!أيّها البطل الصّغير

2
00:00:05,390 --> 00:00:06,270
!تراجعن كلّكنّ

3
00:00:09,150 --> 00:00:11,780
!انتبه خلفك! ما زال هنالك بعضهم

4
00:00:12,100 --> 00:00:12,860
!حسنًا

5
00:00:14,280 --> 00:00:16,740
!آمل أن تكونوا مستعدّين لمفاجأة صادمة

6
00:00:19,180 --> 00:00:20,410
.سأكون خلفك مباشرة

7
00:00:28,140 --> 00:00:30,000
.عمل ممتاز جميعًا

8
00:00:30,490 --> 00:00:33,850
مع إتمامكم لمهمّة القضاء على
،الوحوش بعد ظهر اليوم

9
00:00:33,850 --> 00:00:39,570
أصبحت فرقة البطل توتو مؤهّلة
."لمهمّة ترقية إلى الرّتبة "د

10
00:00:39,570 --> 00:00:41,410
مهمّة ترقية؟

11
00:00:41,410 --> 00:00:45,050
إنّها أشبه باختبار لمعرفة إن كنّا
."قادرين على بلوغ الرّتبة "د

12
00:00:45,050 --> 00:00:47,610
.يبدو أنّ الأمر سيكون أكثر تحدّيًّا قليلاً

13
00:00:47,610 --> 00:00:50,380
وأيّ نوع من المهام هذه؟

14
00:00:50,380 --> 00:00:53,060
.ستقومون بتجاوز ديماس

15
00:00:53,060 --> 00:00:55,860
وهناك، بدل الاعتماد على قوّة
،ومهارة كلّ فرد منكم

16
00:00:56,340 --> 00:00:59,030
.سيُختبر انسجامكم وتعاونكم كفرقة واحدة

17
00:01:00,230 --> 00:01:01,950
!تعاون؟

18
00:02:38,670 --> 00:02:41,260
.مرحبًا بالبطل توتو وفرقته

19
00:02:41,640 --> 00:02:43,280
:تفاصيل هذه المهمّة كالتّالي

20
00:02:43,280 --> 00:02:45,540
عليكم التّقدّم إلى أعمق مستوى
في هذا الدّيماس

21
00:02:45,540 --> 00:02:47,530
.والعودة بما يثبت ذلك

22
00:02:47,530 --> 00:02:48,840
وما الدّليل؟

23
00:02:48,840 --> 00:02:52,190
."قلتَ "أعمق مستوى
ما مدى عمق هذا الدّيماس؟

24
00:02:52,460 --> 00:02:54,320
.أخشى أنّني لا أستطيع إخباركم

25
00:02:54,320 --> 00:02:56,780
!لن يكون للاختبار قيمة إن كنّا نعرف ذلك

26
00:02:56,780 --> 00:02:58,490
!لا تقلقوا

27
00:02:58,490 --> 00:03:02,410
!بفضل تعاوننا، سنتجاوز الأمر بسهولة

28
00:03:02,410 --> 00:03:04,410
!صدقتِ يا سيّدة غوا

29
00:03:04,410 --> 00:03:06,450
!لننهِ الأمر بسرعة

30
00:03:06,810 --> 00:03:08,760
.أ-أجل

31
00:03:10,150 --> 00:03:12,300
.يبدو أنّه عميق بالفعل

32
00:03:12,300 --> 00:03:14,080
.علينا أن نمضي بحذر

33
00:03:19,550 --> 00:03:21,470
حسنًا، ماذا قرّرنا؟

34
00:03:21,950 --> 00:03:27,780
أنا لست مهتمّة بأيّ هراء عن
.قوّة الصّداقة" مع هذه الفرقة"

35
00:03:27,780 --> 00:03:30,310
وما الجدوى أصلاً من التّرقية في الرّتبة؟

36
00:03:30,310 --> 00:03:32,390
.يمكنني أن أجد سببًا

37
00:03:32,390 --> 00:03:36,820
،ستتيح لنا الرّتبة "د" السّفر أكثر
.ومقاتلة أنواع مختلفة من الأعداء

38
00:03:36,820 --> 00:03:40,400
بمعنى آخر، سنوسّع أساليبنا
.في القضاء على ذلك البطل الصّغير

39
00:03:40,680 --> 00:03:43,610
.لا يبدو الأمر من اهتماماتي

40
00:03:44,100 --> 00:03:47,870
،لا طائل من المقاومة
.فلو كنت مكانك لانضممت فورًا

41
00:03:48,180 --> 00:03:48,990
ماذا؟

42
00:03:50,380 --> 00:03:53,960
!اسمعا كلتاكما! علينا التّعاون

43
00:03:53,960 --> 00:03:56,600
.تبًّا. حسنًا

44
00:03:56,600 --> 00:03:58,870
...أنا أيضًا متردّدة، لكن

45
00:04:01,070 --> 00:04:05,470
هذه فرصة لتجاوز الدّور
.والتّحايل على ذلك الوعد السّخيف

46
00:04:05,470 --> 00:04:08,890
وإن تطلّب الأمر، أستطيع هدم
.الدّيماس بالكامل فوق رأسه

47
00:04:09,560 --> 00:04:13,160
،واثقة أنّنا جميعًا نفكّر في الأمر نفسه

48
00:04:13,160 --> 00:04:16,190
.وهو بالنّسبة لي وصفةٌ لمنافَسةٍ جديدة تمامًا

49
00:04:16,840 --> 00:04:19,970
وجودنا في ديماس يعني وجودنا
.في مكان مغلق

50
00:04:19,970 --> 00:04:24,450
إن حدث وأخفقتُ وأنشأتُ سحابة غاز
!مخدّر، فسيكون ذلك محض حادث

51
00:04:24,750 --> 00:04:28,830
.اتفقنا إذًا، هدنة حتّى انتهاء مهمّة التّرقية

52
00:04:28,830 --> 00:04:31,260
!حسنًا! لا اعتراضات

53
00:04:31,260 --> 00:04:32,970
.هذا ما هو عليه الأمر

54
00:04:34,200 --> 00:04:36,060
.لكنّي سأقتله رغم ذلك

55
00:04:42,230 --> 00:04:43,690
...باب

56
00:04:43,690 --> 00:04:46,260
.يبدو أنّ هنالك شيئًا ما على اللّوحة الّتي بجانبه

57
00:04:46,570 --> 00:04:51,180
."لنرَ… "الاختبار الأوّل: قاعة التّضحية

58
00:04:51,180 --> 00:04:55,350
،قدّموا طاقتكم السّحريّة لتفعيله"
".وقدّموا قوّتكم لفتحه

59
00:04:55,690 --> 00:04:58,610
.وذُكر أيضًا: "افعلوا ذلك
."وسينفتح الطّريق أمامكم

60
00:04:58,920 --> 00:05:00,510
وما معنى ذلك؟

61
00:05:00,510 --> 00:05:03,980
.أظنّها مهمّة مشتركة بين ساحر وبطل

62
00:05:03,980 --> 00:05:06,110
!فهمت

63
00:05:10,330 --> 00:05:14,000
.يبدو أنّه يستنزف قوّة من يضع يده في فمه

64
00:05:14,000 --> 00:05:15,710
.أحسنتِ، تخمين جيّد

65
00:05:16,310 --> 00:05:20,460
،وهكذا نكون أنهينا جانب الطّاقة السّحريّة
.والآن دورك في استعمال القوّة يا سيّدي البطل

66
00:05:20,460 --> 00:05:21,670
.مفهوم

67
00:05:32,620 --> 00:05:33,870
!لقد فُتح

68
00:05:33,870 --> 00:05:38,430
على ما يبدو، ستُختبر جوانب
.مختلفة من الفرقة على هذا النّحو

69
00:05:38,430 --> 00:05:40,460
.هذا هو التّعاون فعلاً

70
00:05:44,540 --> 00:05:48,080
...أشعر أنّه انتزع قدرًا لا بأس به من قوّتي

71
00:05:48,600 --> 00:05:51,620
.أتساءل إن كانت سييل بخير

72
00:05:52,780 --> 00:05:57,080
يجدر بالتّعديل الّذي أجريته
.أن يكون قد سلبه جلّ طاقته

73
00:05:57,740 --> 00:05:59,080
—والآن، أستطيع أن

74
00:05:59,080 --> 00:06:03,140
يا سيّدي البطل! دعني أساعدك
!على استعادة قوّتك

75
00:06:03,140 --> 00:06:05,400
!ما الّذي تفعلينه؟

76
00:06:05,400 --> 00:06:07,970
هل هناك مشكلة ما؟

77
00:06:08,280 --> 00:06:12,960
أيّ قاتلة يمكنها استخدام
!سحر العلاج الأساسيّ؟

78
00:06:12,960 --> 00:06:15,550
.أنتِ واضحة أكثر ممّا ينبغي يا سييل

79
00:06:16,490 --> 00:06:19,680
الأساليب المعتادة خارج القائمة اليوم، أنسيتِ؟

80
00:06:19,680 --> 00:06:23,820
!وهذا يعني أنّ كلّ ما عداها متاح

81
00:06:24,180 --> 00:06:26,650
فلنقدّم جميعًا أفضل ما عندنا
!لنتفوّق على بعضنا

82
00:06:28,470 --> 00:06:30,580
!يسعدني أنّكِ فهمتِ

83
00:06:30,580 --> 00:06:33,240
!حسنًا! سأمضي على هذا النّهج

84
00:06:31,530 --> 00:06:35,490
.أعجبني هذا… قوّة التّعاون

85
00:06:33,240 --> 00:06:35,120
!ولن أسمح بأن تتفوّقا عليّ

86
00:06:37,700 --> 00:06:39,540
!يا لشدّتها

87
00:06:39,860 --> 00:06:42,640
."الاختبار الثّاني هو "قاعة الجحيم

88
00:06:42,640 --> 00:06:45,880
.ذُكر أنّه علينا تجاوز النّار المستعرة

89
00:06:46,370 --> 00:06:50,880
!يا لحظّي! ستُضاعف هذه النّار قوّة قنابلي

90
00:06:51,170 --> 00:06:53,790
...عليّ الذّهاب للحمّام

91
00:06:53,790 --> 00:06:55,350
!عجّلي بالعودة

92
00:06:57,310 --> 00:07:00,020
،إنّه مجرّد سحر رياح أساسيّ
هل هناك مشكلة؟

93
00:07:01,330 --> 00:07:03,770
ألم تكوني بحاجة للذّهاب إلى الحمّام يا موني؟

94
00:07:03,770 --> 00:07:06,590
!لا... لا بدّ أنّني توهّمت

95
00:07:08,450 --> 00:07:11,880
..."الاختبار التّالي هو "قاعة الجنون

96
00:07:11,880 --> 00:07:15,700
علينا هزيمة كلّ الوحوش
.الّتي ستظهر من وسط الضّباب

97
00:07:15,700 --> 00:07:21,450
!كلاّ! هذا ليس ضبابًا عاديًّا
!أظنّ أنّه يسبّب الهلوسة

98
00:07:21,450 --> 00:07:23,310
.أتفهّم كيف يمكن أن تكون مشكلة

99
00:07:23,310 --> 00:07:24,940
.سأذهب أوّلاً

100
00:07:26,660 --> 00:07:30,250
...والآن، شيء صغير يجعل الهلوسات أكثر إثارة

101
00:07:30,250 --> 00:07:33,840
!حان وقت أن تهذيان أنتما الاثنتان وتتقاتلا

102
00:07:34,930 --> 00:07:38,690
ماذا؟ أنا أعرف أنّ هذا لن يؤثر
،عليّ أنا والبطل الصّغير

103
00:07:38,690 --> 00:07:40,370
لكن كيف لكما أن تكونا بخير؟

104
00:07:40,370 --> 00:07:42,850
.لديّ دفاعاتي ضدّ تأثيرات الحالات السّلبيّة

105
00:07:42,850 --> 00:07:47,070
لقد حاولتِ تسميمنا جميعًا كثيرًا
.لدرجة أنّني طوّرت مناعة

106
00:07:47,070 --> 00:07:48,060
.يا فتيات

107
00:07:48,440 --> 00:07:50,430
.المخرج أمامنا مباشرة

108
00:07:50,430 --> 00:07:52,310
.يمكننا أن نهرب

109
00:07:50,790 --> 00:07:52,990
!مهلاً أنتما الاثنتان

110
00:07:52,990 --> 00:07:55,800
!هذا قاسٍ جدًّا، لم تخبراني

111
00:07:55,800 --> 00:07:57,930
!لا يحقّ لك الحديث عن الأسرار يا غوا

112
00:07:57,930 --> 00:08:01,500
!معها حقّ! لا أستطيع أن أنافسك

113
00:07:58,650 --> 00:08:01,040
.إنّهنّ متوافقات مع بعضهنّ كثيرًا

114
00:08:04,960 --> 00:08:08,840
،إنّهما حقًّا يعيقانني
.من الأفضل التّخلّص منهما أوّلاً

115
00:08:09,340 --> 00:08:12,340
ستكون أفضل خطّة هي القضاء
.عليهما معًا دفعة واحدة

116
00:08:12,340 --> 00:08:15,090
...إذا ما حدث وقضت اثنتان منّا على بعضهما

117
00:08:15,090 --> 00:08:18,450
،لا يمكنني التّهاون في الأمر
.إن بقيت إحداهما على قيد الحياة

118
00:08:20,970 --> 00:08:23,300
.هناك شيء مختلف في هذه الغرفة

119
00:08:23,300 --> 00:08:25,250
هل يمكن أن يكون هذا هو المستوى الأعمق؟

120
00:08:25,250 --> 00:08:27,650
.لا، ما زال هناك عدّة أبواب

121
00:08:27,950 --> 00:08:30,250
هل علينا اختيار واحد منها؟

122
00:08:31,350 --> 00:08:33,950
!ماذا؟! يبدو أنّ هذه غرفة الكنوز

123
00:08:34,620 --> 00:08:39,160
هيّا بنا! أنا واثقة أنّ هناك كلّ أنواع
!الكنوز، بما فيها الدّليل الّذي نحتاجه

124
00:08:39,440 --> 00:08:42,250
أنيموني، هل تحبّين الكنوز؟

125
00:08:42,980 --> 00:08:47,630
!بالطّبع! لا أستطيع أن أتخيّل أحدًا لا يحبّها

126
00:08:47,630 --> 00:08:49,090
أليس كذلك يا فتيات؟

127
00:08:49,090 --> 00:08:51,480
.لا يعجبني افتراضك

128
00:08:51,480 --> 00:08:53,800
.الثّروة لا تعنيني

129
00:08:54,870 --> 00:08:56,400
...غرفة المجد

130
00:08:56,400 --> 00:09:01,390
إن كان المجد ما تبحث عنه يا سيّدي
!بطل، فانضمّ إليّ في هذه الغرفة

131
00:09:01,390 --> 00:09:03,690
!ماذا؟! انسي هذا

132
00:09:03,690 --> 00:09:09,230
!لنذهب إلى غرفة المتعة ونستمتع جميعًا

133
00:09:12,190 --> 00:09:15,330
!المال هو ما يحرّك العالم يا سيّدي البطل

134
00:09:15,330 --> 00:09:18,520
ألم تصبح بطلاً من أجل المجد؟

135
00:09:18,520 --> 00:09:21,730
!أو يمكنك اختيار الخيار الأوسط: خياري

136
00:09:21,730 --> 00:09:25,710
ما الّذي دهاهنّ جميعًا؟
...كنّ يتفاهمن جيّدًا قبل لحظات

137
00:09:26,130 --> 00:09:30,670
إن كان هذا اختبارًا مصمّمًا لجعلنا
.نقاتل بعضنا، فليكن ذلك

138
00:09:31,160 --> 00:09:35,380
،أفضّل تجنّب القتال
.لكنّني لن أهرب من واحد أيضًا

139
00:09:35,790 --> 00:09:38,480
!أظنّ أنّنا جميعًا على نفس الموجة

140
00:09:38,480 --> 00:09:41,140
!يبدو أنّنا فعلاً فرقة واحدة! يا للمرح

141
00:09:41,470 --> 00:09:45,140
!ماذا أفعل؟ كيف أهدّئهنّ؟

142
00:09:46,600 --> 00:09:48,410
...معركة حتّى النّهاية

143
00:09:48,410 --> 00:09:50,140
...ومن تبقى

144
00:09:50,140 --> 00:09:52,270
.تصل إلى المستوى الأدنى

145
00:09:53,870 --> 00:09:55,630
:تفاصيل هذه المهمّة كالتّالي

146
00:09:55,630 --> 00:09:58,050
عليكم التّقدّم إلى أعمق مستوى
في هذا الدّيماس

147
00:09:58,050 --> 00:09:59,870
.والعودة بما يثبت ذلك

148
00:10:00,750 --> 00:10:02,440
...أعمق مستوى

149
00:10:02,780 --> 00:10:05,240
!يستحقّ التّجربة

150
00:10:12,050 --> 00:10:15,960
ما-ماذا فعلتَ يا سيّدي البطل؟

151
00:10:15,960 --> 00:10:17,920
أين نحن؟

152
00:10:17,920 --> 00:10:19,650
.لست متأكّدة

153
00:10:19,650 --> 00:10:23,080
.لكن أعتقد أنّ هذه الجذور خفّفت من سقوطنا

154
00:10:23,080 --> 00:10:24,940
!أحسنتم بالوصول إلى هنا

155
00:10:25,980 --> 00:10:29,620
.أنا المعروف باسم بيلي القويّ

156
00:10:29,620 --> 00:10:31,400
.سأكون ممتحنكم في هذا الاختبار

157
00:10:31,400 --> 00:10:32,800
ممتحننا؟

158
00:10:32,800 --> 00:10:34,900
إذًا هذا هو أعمق مستوى؟

159
00:10:36,470 --> 00:10:38,440
.بالتّأكيد

160
00:10:38,440 --> 00:10:40,760
يبدو أنّكم اخترتم الطّريق الصّحيح

161
00:10:40,760 --> 00:10:43,530
.دون أن تضلّوا طريقكم في غرف الفخاخ الأخرى

162
00:10:43,530 --> 00:10:45,410
.سأثني عليكم على هذا القدر

163
00:10:45,830 --> 00:10:48,040
!كيف عرفت ذلك أيّها البطل الصّغير؟

164
00:10:49,530 --> 00:10:52,610
،"حـ-حسنًا، بما أنّه قال "أعمق مستوى

165
00:10:52,610 --> 00:10:56,110
.ظننتُ أنّ النّزول للأسفل هو الخيار الأفضل

166
00:10:56,110 --> 00:10:58,380
لم تكن متأكّدًا بالكامل، صحيح؟

167
00:10:58,380 --> 00:11:02,840
.والآن، عقبتكم الأخيرة هي أنا

168
00:11:02,840 --> 00:11:06,920
،إن استطعتم إصابتي بضربة واحدة
.فسيكون ذلك دليلكم

169
00:11:07,770 --> 00:11:11,060
،والآن بعد أن أمعنت النّظر فيكنّ
!يا لكنّ من حسناوات

170
00:11:11,060 --> 00:11:13,830
.لديك ذوق جيّد أيّها البطل

171
00:11:15,150 --> 00:11:16,760
هل يمكنني قتله؟

172
00:11:16,760 --> 00:11:18,620
.دعوني أفعلها رجاءً

173
00:11:20,360 --> 00:11:22,550
.لا، دعنني أتولّى الأمر رجاءً

174
00:11:22,550 --> 00:11:24,880
.كنتُ عاجزًا في بقيّة الدّيماس

175
00:11:24,880 --> 00:11:27,450
.يجب أن أبذل جهدي في القتال على الأقلّ

176
00:11:27,450 --> 00:11:29,820
!يا لها من مجموعة مثيرة للاهتمام

177
00:11:29,820 --> 00:11:33,300
هل تنوي قتالي رجلاً لرجل بالفعل؟

178
00:11:33,940 --> 00:11:38,350
.أنت إمّا شجاع أو أحمق

179
00:11:39,130 --> 00:11:41,630
...وأيًّا كان الأمر، ستجد أنّي

180
00:11:43,340 --> 00:11:45,600
.لستُ سهلاً

181
00:11:49,150 --> 00:11:50,430
.مثير للاهتمام

182
00:11:52,170 --> 00:11:53,900
!الرّكلة الفاصلة للسّماء

183
00:11:53,900 --> 00:11:57,110
!وها هي أخرى من باب الاحتياط

184
00:12:03,070 --> 00:12:06,090
،حتّى مع احتساب السّنوات الّتي أكبرك بها

185
00:12:06,090 --> 00:12:08,350
.فأنا مندهش أيّها البطل

186
00:12:08,740 --> 00:12:11,260
.ذلك العجوز جيّد حقًّا

187
00:12:11,260 --> 00:12:14,650
،نعم، من حيث السّرعة المحضة
.فسيكون ندًّا حتّى لي

188
00:12:14,650 --> 00:12:18,040
!مهلاً، لديّ فكرة رائعة

189
00:12:18,840 --> 00:12:20,110
!سيّدي البطل

190
00:12:20,920 --> 00:12:23,340
!دعنا نشارك في القتال أيضًا رجاءً

191
00:12:23,340 --> 00:12:26,040
!لا يمكننا أن نتركك تسرق الأضواء

192
00:12:26,040 --> 00:12:29,050
!لنُره ما يفعله تعاوننا كفريق

193
00:12:29,960 --> 00:12:31,610
!أقدّر لكنّ ذلك

194
00:12:32,380 --> 00:12:34,720
أيّها القطرة الوحيدة واليائسة
،من النّهر السّماويّ

195
00:12:34,720 --> 00:12:36,980
!تحوّلي إلى نبضة تشعل الجسد

196
00:12:36,980 --> 00:12:39,100
!أيّها النّور، اجتمع في يدي

197
00:12:39,100 --> 00:12:41,610
!بقوّتك، امنحني بركتك

198
00:12:41,610 --> 00:12:44,820
!وهنا تظهر بوم بوم التّحفيز الخاصّة بغوا

199
00:12:51,630 --> 00:12:53,870
!هل تلقين جميعًا تعاويذ دعم عليّ؟

200
00:12:53,870 --> 00:12:55,420
!أشعر أنّني قادر على فعل هذا الآن

201
00:12:55,420 --> 00:12:56,580
!تخمين خاطئ

202
00:12:56,580 --> 00:12:59,650
...أشعر بالحماسة بالفعل

203
00:12:59,650 --> 00:13:02,590
!أقوى ممّا كنتُ عليه حتّى في ذروتي

204
00:13:02,590 --> 00:13:04,090
!بالضّبط

205
00:13:04,630 --> 00:13:06,130
!ها أنا ذا قادم أيّها البطل

206
00:13:06,650 --> 00:13:08,440
—الرّكلة الفاصلة للـ

207
00:13:25,460 --> 00:13:26,820
.تهانينا

208
00:13:26,820 --> 00:13:31,080
.صرتم الآن من الرّتبة "د" بعد إتمامكم للمهمّة

209
00:13:32,440 --> 00:13:35,260
!كا-كانت سهلة إلى حدّ ما

210
00:13:35,260 --> 00:13:37,210
...بفضل تعاوننا كفريق

211
00:13:37,210 --> 00:13:39,080
!لم تكن مشكلة

212
00:13:39,940 --> 00:13:42,800
.بصراحة، كنت قلقًا جدًّا

213
00:13:44,170 --> 00:13:48,760
...عندما بدا أنّكنّ على وشك القتال ضدّ بعضكنّ

214
00:13:49,100 --> 00:13:51,700
.كنتنّ متفاهمات جدًّا من قبل

215
00:13:51,700 --> 00:13:55,160
.كأنّ شخصياتكنّ تغيّرت وصارت عدائيّة

216
00:13:57,440 --> 00:14:00,510
!نـ-نحن نتفاهم بشكل جيّد

217
00:14:00,510 --> 00:14:03,810
أنت أمام مجموعة من السّيّدات
!الجميلات بلا أيّ أسرار

218
00:14:03,810 --> 00:14:06,920
!كنّا تحت تأثير تعويذة دفعتنا إلى الشّجار

219
00:14:06,920 --> 00:14:08,780
!كان ذلك وشيكًا

220
00:14:09,340 --> 00:14:12,970
.فـ-فهمت! أراحني هذا

221
00:14:19,460 --> 00:14:21,810
.تعاون الفريق؟ هراء

222
00:14:21,810 --> 00:14:24,050
.حاولت كلّ واحدة منكما النّيل منّي

223
00:14:24,050 --> 00:14:28,630
.كنّا نعرف جميعنا ما ترمي له الأخرى
.هذا نوع من الصّداقة في رأيي

224
00:14:28,630 --> 00:14:32,350
.ينبغي أن تكونا ممتنّتين لأنّني لم أقتلكما

225
00:14:37,430 --> 00:14:39,460
...أ-أنا آسف

226
00:14:40,250 --> 00:14:43,520
...لكن... عندما استرحت أخيرًا، فإنّ شهيّتي

227
00:14:45,720 --> 00:14:46,610
!أعلم

228
00:14:47,010 --> 00:14:50,450
في تلك الحالة، لماذا لا نذهب
لشرب شيء ما احتفالاً بترقيتنا؟

229
00:14:50,450 --> 00:14:52,190
!يا لها من فكرة جيّدة

230
00:14:52,190 --> 00:14:54,650
أنا مستعدّة للانضمام لكم
.ما دامت ستكون هنالك حلويّات

231
00:14:54,650 --> 00:14:59,350
!أجل! حان وقت حفلة ترابط الفرقة

232
00:15:01,630 --> 00:15:04,160
...حـ-حسنًا

233
00:15:04,160 --> 00:15:07,050
...إليكنّ نـ-نخب نجاح فرقتنا

234
00:15:07,320 --> 00:15:09,270
!بصحّة الجميع

235
00:15:13,370 --> 00:15:16,050
.أنت تشرب بسرعة أيّها البطل الصّغير

236
00:15:16,050 --> 00:15:17,980
.صـ-صحيح

237
00:15:17,980 --> 00:15:21,850
.أشعر أنّني سأفقد الوعي في الحال إذا لم أسكر

238
00:15:23,090 --> 00:15:24,620
!هذا ممتع

239
00:15:24,620 --> 00:15:25,980
صحيح يا سييل؟

240
00:15:27,140 --> 00:15:28,200
.أكيد

241
00:15:28,700 --> 00:15:32,190
...واثقة أنّنا سنبدأ بالشّجار في وقت قريب، لكن

242
00:15:33,700 --> 00:15:38,620
لذيذ! أظنّ الوقت قد حان لتستمتع
!راهبة مثلي بحفلة شرب

243
00:15:39,940 --> 00:15:44,800
ما-ماذا هنالك؟ حتّى الرّاهبات بإمكانهنّ
.الاستمتاع بمشروب بعد يوم شاقّ

244
00:15:44,800 --> 00:15:47,290
!هيّا يا سيّدي البطل، اشرب

245
00:15:47,290 --> 00:15:48,660
.أ-أكيد

246
00:15:50,950 --> 00:15:53,390
!أيّها النّادل، أحضر المزيد من المشروب هنا

247
00:15:55,470 --> 00:15:59,120
!لطالما أردتُ أختًا صغيرة

248
00:15:59,120 --> 00:16:01,970
ما رأيك أن تبدئي بمناداتي
أختي الكبيرة من الآن فصاعدًا؟

249
00:16:01,110 --> 00:16:04,750
.سأقتلك. سأقتلك. سأقتلك

250
00:16:04,750 --> 00:16:08,950
هذا أظرف شيء فيك— بإمكانك
!أن تكوني مصدر إزعاج حقيقيّ

251
00:16:07,740 --> 00:16:10,070
.ستموتين. سأقتلك

252
00:16:10,070 --> 00:16:14,730
...إنّهما تستمتعان بدوننا

253
00:16:14,730 --> 00:16:17,550
.ربّما علينا تركهما والذّهاب معًا

254
00:16:19,540 --> 00:16:22,580
نظرًا لأنّ البطل كان فاقدًا
،للوقت منذ مدّة

255
00:16:22,580 --> 00:16:24,540
هل يمكننا التّصرّف بشكل طبيعيّ الآن؟

256
00:16:24,540 --> 00:16:26,800
.اهدئي قليلاً يا أختي الصّغيرة

257
00:16:26,800 --> 00:16:27,930
.لا تناديني بذلك

258
00:16:27,930 --> 00:16:29,730
.عليك أن تشربي

259
00:16:29,730 --> 00:16:32,930
أنت شيطانة، لذلك لا أعتقد
.أنّ علينا القلق من كسر القوانين

260
00:16:32,930 --> 00:16:35,250
كما أنّ عمرك غير باد عليك من الأساس، صحيح؟

261
00:16:35,250 --> 00:16:39,180
!لا! كما أنّها ليست مسألة قانون
!أنا لا أحبّ تصرّفاتك فحسب

262
00:16:39,180 --> 00:16:43,910
.في الحقيقة يا سييل، هذا حلو ولذيذ جدًّا

263
00:16:44,640 --> 00:16:48,480
.إنّه اختصاصٌ محلّيّ، كوكتيل المزيج الحلو

264
00:16:50,060 --> 00:16:52,940
.أظنّ أنّها تعرف نقطة ضعفك تمامًا

265
00:16:52,940 --> 00:16:55,660
!أ-أنا أقوم بهذا فقط لأنّك أجبرتني

266
00:16:55,660 --> 00:16:58,700
بما أنّ هذا احتفال، فأنا أجاريكم
!بأخذ رشفة واحدة فقط

267
00:16:58,700 --> 00:17:04,460
لكنّي لن أكون من السّكارى
!الفِظاظ والمجنونين مثلك

268
00:17:05,380 --> 00:17:08,170
!المزيد من المشروب أيّها النّادل

269
00:17:08,540 --> 00:17:11,320
...يا أختي الكبيرة، كم أنت دافئة

270
00:17:11,320 --> 00:17:12,510
أليس كذلك؟

271
00:17:12,510 --> 00:17:19,430
!يا سيدي البطل! أريد أن تحملني، احملني

272
00:17:16,900 --> 00:17:19,430
.آسفة، لكنّه فاقد للوعي تمامًا

273
00:17:20,750 --> 00:17:26,180
أتسمعان؟ الأمر منوط بنا بالكامل
لتغيير هذا العالم الفاسد، مفهوم؟

274
00:17:26,180 --> 00:17:28,460
.أنت محقّة في ذلك

275
00:17:28,980 --> 00:17:32,540
...بما أنّنا جميعًا لطيفات وسكرانات

276
00:17:34,140 --> 00:17:36,610
فلماذا لا نتقاتل بالفعل؟

277
00:17:38,110 --> 00:17:41,260
.إنّك حقيرة بالفعل

278
00:17:41,260 --> 00:17:43,870
!أنا لستُ سكرانة

279
00:17:44,170 --> 00:17:46,580
...هذا ما كنتُ أفكّر فيه من قبل، لكن

280
00:17:47,250 --> 00:17:49,580
.غيّرتُ رأيي. أنا أستمتع كثيرًا

281
00:17:52,620 --> 00:17:55,080
.ماذا؟ لن تخدعينني أبدًا

282
00:17:55,080 --> 00:17:57,940
.أستطيع القتال جيّدًا حتّى وأنا سكرانة

283
00:17:57,940 --> 00:18:02,420
أنا جادّة. ربّما أقول هذا فقط
...لأنّي سكرانة، ولكن

284
00:18:02,420 --> 00:18:05,240
.لم يكن لديّ أصدقاء من قبل

285
00:18:07,080 --> 00:18:12,690
لذا أنا سعيدة... بوجود أشخاص يمكنني
.محادثتهم دون استخدام مهاراتي وعقاقيري

286
00:18:12,690 --> 00:18:17,570
بدون عقاقير؟ تعلمين أنّ ذلك الشّراب
يعتبر من العقاقير أيضًا، صحيح؟

287
00:18:17,570 --> 00:18:19,060
.ربّما معك حقّ

288
00:18:19,060 --> 00:18:22,620
لماذا لا تقولين ما تشعرين به فعلاً يا أنيموني؟

289
00:18:22,620 --> 00:18:24,900
.واثقة أنّ لا أصدقاء لديك أيضًا

290
00:18:25,700 --> 00:18:29,210
من أين حصلت أختي الصّغيرة
!على مثل هذه الجرأة؟

291
00:18:35,210 --> 00:18:37,250
.أنا قاتلة مأجورة

292
00:18:37,250 --> 00:18:40,360
...إنّنا لا نبني علاقات مع الآخرين

293
00:18:40,360 --> 00:18:44,720
.ولم أشرب هكذا خارج العمل من قبل

294
00:18:46,810 --> 00:18:48,750
...لذلك... مهلاً

295
00:18:49,270 --> 00:18:51,060
...ما أحاول قوله

296
00:18:51,060 --> 00:18:55,440
.الأمر ليس وكأنّني... لا أستمتع بوقتي هنا

297
00:18:55,440 --> 00:18:58,700
!يا لظرافتك يا موني
!أعطني قبلة صغيرة! قبلة

298
00:18:58,700 --> 00:19:00,360
!مستحيل يا غبيّة

299
00:19:00,700 --> 00:19:03,060
ماذا عنك يا أختي الصّغيرة؟

300
00:19:05,990 --> 00:19:07,240
.يعجبني هذا

301
00:19:07,240 --> 00:19:08,250
ماذا بالضّبط؟

302
00:19:08,510 --> 00:19:11,540
.أقصد... هذا الأمر برمّته

303
00:19:11,840 --> 00:19:16,030
لم يكن مسموحًا لي الأكل
.في الخارج مع الآخرين أبدًا

304
00:19:16,630 --> 00:19:20,320
!أنا ابنة ملك الشّياطين العزيزة

305
00:19:20,320 --> 00:19:24,080
ويُصاحب حبّه الكثير من القيود
!والحماية المفرطة

306
00:19:24,080 --> 00:19:25,560
.يبدو الأمر صعبًا

307
00:19:25,560 --> 00:19:27,350
من يصف نفسه بـ"العزيزة"؟

308
00:19:27,720 --> 00:19:30,100
،كما أنّ البطل ليس سيّئًا

309
00:19:30,100 --> 00:19:33,180
!لكنّني أكثر إثارةً وأهمّيّة

310
00:19:33,180 --> 00:19:36,600
.أعترف أنّه أشدّ ممّا يبدو على الأقلّ

311
00:19:36,600 --> 00:19:39,490
.لم أقبل بمهمّة بهذا التّشويق من قبل

312
00:19:39,490 --> 00:19:43,200
أنتما تحبّان البطل الصّغير بالفعل، صحيح؟

313
00:19:44,060 --> 00:19:45,780
.بالطّبع لا

314
00:19:45,780 --> 00:19:49,690
في تلك الحالة، لماذا لا نقول
جميعًا كم نحبّه في نفس الوقت؟

315
00:19:49,690 --> 00:19:51,380
أتعانين خطبًا ما يا غبيّة؟

316
00:19:51,380 --> 00:19:53,640
!إن لم تقولي، ستخسرين حقّك بقتله

317
00:19:53,640 --> 00:19:55,330
أيّ نوع من الحقوق هذا؟

318
00:19:55,330 --> 00:19:58,000
...حسنًا. استعداد

319
00:19:58,000 --> 00:19:59,040
.اثنان

320
00:19:58,000 --> 00:19:59,770
.واحد وخمسون

321
00:19:58,000 --> 00:19:59,770
.إنّه سرّ

322
00:20:04,720 --> 00:20:07,890
!آهٍ يا موني! إنّك تحبّينه بالكامل بالفعل

323
00:20:07,890 --> 00:20:11,360
كلاّ! اخترتُ رقمًا في المنتصف
!لأقول أنّي لا أشعر بأيّ شيء حقًّا

324
00:20:11,360 --> 00:20:12,830
!وماذا تقصدين بـ"إنّه سرّ"؟

325
00:20:12,830 --> 00:20:15,470
!كم يسهل إغواؤك يا أختي الكبيرة

326
00:20:15,470 --> 00:20:18,090
!حسنًا، ربّما سأقتلكما أيضًا

327
00:20:18,090 --> 00:20:20,870
!أختي سهلة

328
00:20:24,090 --> 00:20:25,590
يا سيّدي البطل؟

329
00:20:27,700 --> 00:20:29,660
.استيقظ رجاءً

330
00:20:29,660 --> 00:20:32,040
.ستُغلق الحانة

331
00:20:32,040 --> 00:20:33,710
.علينا الذّهاب

332
00:20:34,010 --> 00:20:35,880
.نعم، صحيح

333
00:20:36,300 --> 00:20:39,120
...فقدتُ وعي ثانية

334
00:20:36,550 --> 00:20:39,120
لا يمكنك الاعتراف بما تشعرين به فحسب، صحيح؟

335
00:20:39,120 --> 00:20:41,580
هلاّ توقّفت عن التّصرّف بإزعاج؟

336
00:20:40,120 --> 00:20:44,140
.لكنّي مسرور لرؤيتهنّ على وفاق كالعادة ثانية

337
00:20:44,140 --> 00:20:46,760
أيّها البطل الصّغير، ما رأيك بكلمة لإنهاء الحفلة؟

338
00:20:47,100 --> 00:20:49,450
.عفوًا... حسنًا

339
00:20:50,410 --> 00:20:51,220
...أنا

340
00:20:52,300 --> 00:20:55,230
...أ-أعرف أنّي لستُ أهلاً لأيّ شيء

341
00:20:55,230 --> 00:21:00,070
لكنّي سأقوم بكلّ ما في وسعي
...لحماية ثلاثتكنّ، لذلك

342
00:21:00,070 --> 00:21:02,540
.إ-إنّه لشرف لي أن أرتحل معكنّ

343
00:21:18,570 --> 00:21:21,750
.أعرف أنّك هنا

344
00:21:22,110 --> 00:21:25,970
.لا يوجد أيّ أحد آخر يراقب. يمكنك الظّهور

345
00:21:26,510 --> 00:21:29,890
إذًا فقد لاحظتني؟
.ما كان عليّ أن أتوقّع ما هو أقلّ

346
00:21:30,970 --> 00:21:35,100
أنا هابي كيونيل من الحرس
.الملكيّ لملك الشّياطين

347
00:21:36,130 --> 00:21:39,280
.سعيدة برؤيتك مرّة أخرى يا سيّدتي سييل

348
00:23:10,790 --> 00:23:12,970
كيف كنت عندما كنت صغيرة يا موني؟

349
00:23:12,970 --> 00:23:14,420
ما الغاية من هذا السّؤال؟

350
00:23:14,420 --> 00:23:18,340
لا شيء مميّز. أنا مجرّد فقيرة عاديّة
...تربّت في مكان عاديّ قذر

351
00:23:18,340 --> 00:23:19,910
!"أنا خائفة من مفهومك لما هو "عاديّ

352
00:23:19,910 --> 00:23:21,100
ماذا عنك؟

353
00:23:21,100 --> 00:23:22,030
.إنّه سرّ

354
00:23:22,030 --> 00:23:24,030
.هذا كلام فارغ بما أنّك من سألت أوّلاً

355
00:23:24,030 --> 00:23:26,130
لكن يبدو أنّ سييل تربّت
بشكل صحيح، أليس كذلك؟

356
00:23:26,130 --> 00:23:29,260
.نعم. إنّها أميرة شياطين عاديّة في النّهاية

357
00:23:29,260 --> 00:23:32,840
...مع أنّ كونها أميرة لا يعني أنّ لا هموم لها

358
00:23:32,840 --> 00:23:35,160
!آهٍ يا موني! كم أنت لطيفة

359
00:23:35,160 --> 00:23:38,020
أو بالأحرى، لماذا لا تكونين
لطيفة معي هكذا دائمًا؟

360
00:23:38,020 --> 00:23:39,400
!اخرسي