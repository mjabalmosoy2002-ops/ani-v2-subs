1
00:00:01,480 --> 00:00:04,410
تمكّنت ماين بطريقة ما من المساعدة
.في حلّ مشاكل لوتز العائليّة

2
00:00:05,650 --> 00:00:09,450
.لكن بدأت تتولّد لديها مخاوف تخصّ منزلها

3
00:00:10,110 --> 00:00:14,240
هل ما زلت تشعرين بوعكة يا أمّي؟
هل أنت بخير حقًّا؟

4
00:00:16,030 --> 00:00:17,110
...ماين

5
00:00:19,040 --> 00:00:20,330
،في الواقع

6
00:00:20,740 --> 00:00:23,000
.أمّك تحمل جنينًا في بطنها

7
00:00:25,240 --> 00:00:27,670
.ستصبحين أختًا كبيرة

8
00:00:30,380 --> 00:00:34,830
سأصنع كتابًا مصوّرًا للصّغير، اتّفقنا؟

9
00:00:34,830 --> 00:00:35,880
كتاب مصوّر؟

10
00:00:35,880 --> 00:00:37,900
!أجل، كتاب مصوّر

11
00:02:19,300 --> 00:02:22,060
كتاب مصوّر؟

12
00:02:22,520 --> 00:02:24,280
ماذا يعني "كتاب مصوّر"؟

13
00:02:24,630 --> 00:02:26,790
.هذه هي المرّة الثّالثة الآن

14
00:02:27,270 --> 00:02:30,410
الكتب المصوّرة هي كتب أدبيّة
.للأطفال تحتوي على صور

15
00:02:30,970 --> 00:02:33,090
.الكتب غالية بحدّ ذاتها

16
00:02:33,090 --> 00:02:35,940
وتريدين صنعها للرّضّع
الّذين لا يقرؤون أصلاً؟

17
00:02:35,940 --> 00:02:38,550
ما الّذي تفكّرين فيه؟

18
00:02:38,550 --> 00:02:41,550
.سأكون أختًا كبيرة

19
00:02:41,870 --> 00:02:45,470
يبدو أنّ عائلة سيّدتي ماين
،ستُرزق بمولود

20
00:02:45,470 --> 00:02:47,950
.لذلك تريد أن تقدّم هديّةً للرّضيع

21
00:02:48,420 --> 00:02:50,680
.هكذا إذًا. الآن فهمت

22
00:02:50,680 --> 00:02:53,560
.لذا دعني أحصل على ويلما من فضلك

23
00:02:53,870 --> 00:02:54,720
فران؟

24
00:02:55,390 --> 00:02:58,060
،يحتاج كتابٌ مصوّر لرسّام

25
00:02:58,060 --> 00:03:00,110
لذلك تعرّفت على كاهنة برداءٍ
رمادي ماهرة في الرّسم

26
00:03:00,110 --> 00:03:03,070
.وتطلب إذنًا لجعلها خادمة لها

27
00:03:03,070 --> 00:03:06,830
...للأمانة، أردت رسمها بنفسي

28
00:03:10,950 --> 00:03:13,830
.خطّك جيّد، لكنّ رسمك سيّئ للغاية

29
00:03:14,730 --> 00:03:16,830
.أرجوك يا رئيس الكهنة

30
00:03:19,890 --> 00:03:23,610
سيمثّل ذاك الرّضيع نقطة
.ضعف شديدة لك

31
00:03:24,730 --> 00:03:27,450
ولماذا يمثّل نقطة ضعف؟

32
00:03:27,450 --> 00:03:30,900
،عائلتك عزيزةٌ جدًّا على قلبك

33
00:03:31,410 --> 00:03:35,870
ودليلٌ على ذلك محاولتك مواجهة
.كبير الكهنة لحمايتهم

34
00:03:36,570 --> 00:03:39,730
لا أحد يعلم ماذا سيفعل
عندما يعلم بهذا؟

35
00:03:40,970 --> 00:03:43,560
تعلمين جيّدًا أنّ الأمر لن يكون هيّنًا

36
00:03:43,560 --> 00:03:45,790
إذا قلت أنّك لا تستطيعين
.كتم مشاعرك فحسب

37
00:03:47,200 --> 00:03:49,610
.أعلم، نعم. سأضع ذلك في الحسبان

38
00:03:49,610 --> 00:03:55,240
انتهزي هذه كفرصة لتعوّدي نفسك
.على سلوكيّات النّبلاء وثقافتهم

39
00:03:55,770 --> 00:03:57,000
ثقافتهم"؟"

40
00:03:57,000 --> 00:03:59,060
.أعني الموسيقى

41
00:03:59,530 --> 00:04:02,110
.إنّها إحدى التّسالي المفضّلة للنّبلاء

42
00:04:02,740 --> 00:04:04,880
هل لدينا أيّ شخصٍ ملائم؟

43
00:04:05,570 --> 00:04:10,010
ما رأيك بروزينا؟ كانت خادمة
.السّيّدة كريستين

44
00:04:10,350 --> 00:04:13,690
،ماين، إذا أردت رسّامةً تعمل خادمة لك

45
00:04:13,690 --> 00:04:17,030
عليك أن تضمّي خادمة ذات
.كفاءة في الموسيقى أيضًا

46
00:04:17,030 --> 00:04:20,510
!لحظة! لا يمكنك أن تتّخذ القرار عنّي

47
00:04:20,510 --> 00:04:23,270
!لا أملك حتّى آلات موسيقيّة

48
00:04:23,540 --> 00:04:24,670
.هكذا إذًا

49
00:04:25,120 --> 00:04:28,170
.بالطّبع لا يمكن التّمرّن دون آلة موسيقيّة

50
00:04:28,170 --> 00:04:32,500
لذلك، أريد حقًّا أن تكون
.ويلما فقط خادمتي

51
00:04:34,080 --> 00:04:36,800
...أقدّر عرضك اللّطيف، لكن

52
00:04:38,460 --> 00:04:40,420
.لن يبقى أحدٌ ليعتني بهم

53
00:04:40,420 --> 00:04:42,550
.أنا الوحيدة الّتي تفعل ذلك

54
00:04:42,550 --> 00:04:45,590
.أفضّل البقاء في الميتم

55
00:04:46,990 --> 00:04:51,380
في الكاتدرائيّة، ينتقل كافّة الخدم
.إلى غرف أسيادهم

56
00:04:51,740 --> 00:04:56,580
هل من طريقة أجعل فيها ويلما خادمتي
وتعيش في الميتم في نفس الوقت؟

57
00:04:57,270 --> 00:05:00,610
.قرّرت أن أسأل رئيس الكهنة للمشورة

58
00:05:01,510 --> 00:05:03,610
وفي اليوم الّذي كنت سأتناول
...ذلك النّقاش

59
00:05:04,290 --> 00:05:07,390
أرسل رئيس الكهنة هذه الهدايا
.مع خالص تحيّاته

60
00:05:07,390 --> 00:05:08,600
.رائع

61
00:05:08,600 --> 00:05:12,530
رفضت طلبه لأنّني لم أكن أملك آلات
.موسيقيّة، لكنّها وجدت ضالّتها إليّ

62
00:05:12,890 --> 00:05:15,220
.تدعى هارشبيل

63
00:05:15,220 --> 00:05:16,920
هارشبيل؟

64
00:05:16,920 --> 00:05:21,620
يبدو أنّ رئيس الكهنة عازم
.على جعلك تتعلّمين الموسيقى

65
00:05:25,480 --> 00:05:28,430
.مرحبًا يا رئيس الكهنة
.كنت في انتظارك

66
00:05:29,050 --> 00:05:31,930
هذا بسكويتٌ صنعه
.طبّاخييّ خصّيصًا لك

67
00:05:31,930 --> 00:05:36,680
ستكون جزءًا من القائمة في المطعم
.الّذي ستفتتح شركة غيلبيرتا

68
00:05:37,400 --> 00:05:40,420
لم أكن أعلم أنّك تمارسين هواية
.الطّعام أيضًا

69
00:05:40,420 --> 00:05:46,570
نعم. لذلك أريد المرور بتجربة مطعم
.نبلاء حقيقيّ قبل أن نفتتح

70
00:05:46,970 --> 00:05:49,670
.سأدعوك للغداء في وقت ما قريبًا

71
00:05:52,680 --> 00:05:53,790
...حسنًا

72
00:05:54,720 --> 00:05:59,870
قلت أنّك أردت جعل ويلما خادمتك
وتبقى في الميتم في نفس الوقت؟

73
00:05:59,870 --> 00:06:05,470
نعم. إنّها الوحيدة القادرة على الاعتناء
.بالأطفال غير المعمّدين هناك

74
00:06:05,470 --> 00:06:10,670
يمرض الصّغار بسرعة وأحيانًا تصيبهم
.حمّى في وقتٍ متأخّر من اللّيل

75
00:06:13,370 --> 00:06:16,050
،إذا كانت ستبقى ويلما في الميتم

76
00:06:16,050 --> 00:06:18,690
.فهذا سببٌ آخر يدعو لأخذ روزينا

77
00:06:18,690 --> 00:06:20,320
.حتّى أنّني جهّزت لك آلاتك الموسيقيّة

78
00:06:20,630 --> 00:06:22,200
.ينبغي ألاّ يكون لديك أيّ اعتراض الآن

79
00:06:22,890 --> 00:06:27,060
لكن هل هناك أيّ حاجة للموسيقى
في مراسم الكاتدرائيّة؟

80
00:06:35,410 --> 00:06:38,450
ها نحن ذا مجدّدًا مع تلك
.الأداة السّحريّة

81
00:06:42,810 --> 00:06:46,930
سبب كون الموسيقى أساسيّة بالنّسبة لك
.هو لأنّها جزءٌ حيويّ من ثقافة النّبلاء

82
00:06:46,930 --> 00:06:49,600
.قلت ذلك قبل أيّام أيضًا

83
00:06:49,600 --> 00:06:51,920
.لكن لستُ نبيلة

84
00:06:52,260 --> 00:06:56,430
ستكونين بالتّأكيد جزءًا من
.المجتمع النّبيل في المستقبل

85
00:06:57,080 --> 00:07:01,180
.لكن لا أنوي ترك عائلتي

86
00:07:01,860 --> 00:07:04,110
،وفقًا للكاهن

87
00:07:04,110 --> 00:07:06,970
عندما يتزوّج النّبلاء أو أولئك
،المصابون بالملتهم

88
00:07:06,970 --> 00:07:10,940
يجب على شريك حياتهم أن يمتلك قدرة
.مانا مكافئة وإلاّ لا يمكنهما إنجاب أطفال

89
00:07:11,280 --> 00:07:16,200
بالإضافة إلى ذلك، مانا الطّفل
.تتأثّر كثيرًا بمانا أمّه

90
00:07:16,960 --> 00:07:19,470
،مع انخفاض عدد النّبلاء اليوم

91
00:07:19,470 --> 00:07:25,160
يبدو من السّهل التّخيّل أنّ النّبلاء
.الشّباب سيتهافتون عليّ حالما أبلغ

92
00:07:25,810 --> 00:07:30,340
لكن لن يروك سوى أداة تربطهم
.بالمجتمع الرّفيع

93
00:07:30,760 --> 00:07:33,970
إذًا سأكون صانعة أطفال ملائمة؟

94
00:07:33,970 --> 00:07:35,980
.يعود الأمر لك

95
00:07:36,380 --> 00:07:38,740
يعود لي؟ كيف؟

96
00:07:38,740 --> 00:07:43,670
،سواء اعتُبرت أداة لإنجاب أطفال أو لا

97
00:07:43,670 --> 00:07:47,720
فذلك يعتمد على مدى إتقانك
.أداءك كنبيلة

98
00:07:48,240 --> 00:07:50,980
يجب أن تتثقّفي وتدرسي أساليبهم
.لتحمي نفسك

99
00:07:52,380 --> 00:07:54,010
.فهمت

100
00:07:54,010 --> 00:07:58,850
سأجعل روزينا خادمتي أيضًا
.وأتعلّم ما أستطيع منها

101
00:08:01,060 --> 00:08:06,250
بعد ذلك، طلبت من رئيس الكهنة
،أن يعلّمني الطّريقة الصّحيحة

102
00:08:06,250 --> 00:08:08,270
.لذلك عزف على الهارشبيل لأجلي

103
00:08:12,630 --> 00:08:14,040
!إنّه ماهر جدًّا

104
00:08:14,040 --> 00:08:19,310
لا يستطيع المنشدون في محيط البوّابة
!الشّرقيّة حتّى عقد أربطة أحذيتهم

105
00:08:21,320 --> 00:08:26,310
من السّماوات الزّرقاء

106
00:08:27,130 --> 00:08:32,660
يأتي شعاع النّور

107
00:08:32,660 --> 00:08:37,020
بركات لايدنشافت

108
00:08:37,020 --> 00:08:39,280
وريقات برّاقة جدًّا

109
00:08:39,280 --> 00:08:41,570
رائحة الرّياح العذبة

110
00:08:41,570 --> 00:08:44,990
لهب الحياة الحارق

111
00:08:44,990 --> 00:08:50,750
في الصّيف

112
00:08:55,210 --> 00:08:57,390
!كان ذلك رائعًا

113
00:08:57,390 --> 00:09:02,020
لو كنت تغنّي أغاني حبّ، فستقع
.كثير من الفتيات في حبّك

114
00:09:02,750 --> 00:09:04,770
ماذا تقولين؟

115
00:09:05,220 --> 00:09:07,840
.كان ذلك مدحًا

116
00:09:07,840 --> 00:09:10,450
.على أيّ حال، جرّبي ذلك

117
00:09:10,450 --> 00:09:13,180
ماذا؟ الآن؟

118
00:09:19,260 --> 00:09:21,880
.هذه النّوتة الموسيقيّة أساسيّة

119
00:09:23,370 --> 00:09:25,340
.هذه دو

120
00:09:26,250 --> 00:09:27,090
.ري

121
00:09:28,250 --> 00:09:29,060
.مي

122
00:09:29,660 --> 00:09:31,240
.هذا ما يدعى بالسّلّم الموسيقيّ

123
00:10:05,780 --> 00:10:07,190
.هذا مفاجئ

124
00:10:07,700 --> 00:10:11,330
لا أعلم كيف لواحدة من العامّة
،أن تفهم في مجال الموسيقى

125
00:10:11,330 --> 00:10:14,170
.لكن يبدو أنّك سريعة التّعلّم

126
00:10:14,170 --> 00:10:18,060
!تبًّا! أخطأت وصعّبت الأمر على نفسي

127
00:10:18,360 --> 00:10:22,040
.تمرّني على العزف على الهارشبيل كلّ يوم

128
00:10:22,040 --> 00:10:26,800
هل يمكنني اقتطاع جزء من الوقت
المخصّص لمساعدتك مقابل ذلك؟

129
00:10:26,800 --> 00:10:29,060
اقضي وقتًا أقلّ في المطالعة
!بدلاً من ذلك

130
00:10:29,060 --> 00:10:31,830
!سأدافع عن هذا الوقت باستماتة

131
00:10:32,270 --> 00:10:36,700
في النّهاية، اتّفقنا على إنقاص الوقت
.الّذي أقضيه على مساعدته

132
00:10:37,870 --> 00:10:39,010
.مرحى

133
00:10:39,650 --> 00:10:44,410
،أعطى رئيس الكهنة إذنه
.لذا سأجعلك خادمتي

134
00:10:44,810 --> 00:10:47,920
سأبذل قصارى جهدي لخدمتك
.يا سيّدتي ماين

135
00:10:48,300 --> 00:10:50,910
بالمناسبة، هل روزينا هنا؟

136
00:10:50,910 --> 00:10:52,300
.سأحضرها لك

137
00:11:02,560 --> 00:11:05,820
!أيّ آنسة نقيّة هي هذه

138
00:11:05,820 --> 00:11:11,070
ربّما هكذا يتأمّل رئيس الكهنة
.أن أقدّم نفسي

139
00:11:11,940 --> 00:11:15,680
سيّدة ماين، هل أردت التّكلّم معي؟

140
00:11:15,680 --> 00:11:20,790
سأجعلك خادمتي بناءً
.على توصية رئيس الكهنة

141
00:11:21,510 --> 00:11:25,700
عملك الرّئيسيّ هو تعليمي كيفيّة
.العزف على الهارشبيل

142
00:11:25,700 --> 00:11:30,880
فيما عدا ذلك، ستتشاركين مع خدمي
.الآخرين واجباتهم

143
00:11:30,880 --> 00:11:32,320
هل لديك أيّ اعتراض؟

144
00:11:33,780 --> 00:11:35,970
!كيف لي أن أعترض؟

145
00:11:35,970 --> 00:11:39,860
!الهارشبيل هي آلتي الموسيقيّة المفضّلة

146
00:11:40,560 --> 00:11:45,510
انتقلت روزينا إلى مكتب المديرة
.حالما رتّبت كلّ الأمور

147
00:11:45,880 --> 00:11:47,880
!هذه هي الهارشبيل

148
00:11:47,880 --> 00:11:51,080
هل يمكنك العزف عليها لأجلي؟

149
00:11:51,080 --> 00:11:52,760
أيمكنني حقًّا؟

150
00:11:52,760 --> 00:11:55,010
.بالطّبع. لو سمحت

151
00:11:55,010 --> 00:11:57,360
أحضر لي الهارشبيل خاصّتي
.من فضلك إذًا

152
00:12:05,630 --> 00:12:08,070
.لا أصدّق أنّني سأتمكّن من العزف ثانية

153
00:12:09,240 --> 00:12:11,210
هلاّ أحضرت لي كرسيّ؟

154
00:12:18,300 --> 00:12:20,050
.أشعر أنّ هناك مشكلة ما

155
00:12:20,730 --> 00:12:22,180
ما الأمر؟

156
00:12:47,060 --> 00:12:52,460
أعدك أن أخدمك من أعماق
.قلبي يا سيّدتي ماين

157
00:13:04,970 --> 00:13:06,220
!سيّدتي ماين

158
00:13:06,220 --> 00:13:08,040
ما الأمر يا ديليا؟

159
00:13:08,040 --> 00:13:10,680
.روزينا لا تعمل إطلاقًا

160
00:13:10,680 --> 00:13:15,310
عجبًا! من الوقاحة حقًّا
.أن تتّهميني بعدم العمل

161
00:13:15,310 --> 00:13:19,320
إنّها لا تفعل أيّ شيء آخر غير
.العزف على آلتها الموسيقيّة

162
00:13:19,320 --> 00:13:21,010
.وحتّى أنّها لا تستيقظ في الصّباح

163
00:13:21,430 --> 00:13:23,950
هل هذا صحيحٌ يا روزينا؟

164
00:13:23,950 --> 00:13:28,940
عملي هو تعليمك العزف على
.الهارشبيل يا سيّدتي ماين

165
00:13:28,940 --> 00:13:31,700
.والآن دعينا نتمرّن

166
00:13:32,620 --> 00:13:38,050
ديليا، عليّ أن أتمرّن الآن. أعدك
.أنّني سأستمع لشكواك لاحقًا

167
00:13:39,520 --> 00:13:41,470
.حسنًا

168
00:13:47,640 --> 00:13:48,840
.شكرًا لك

169
00:13:49,390 --> 00:13:51,530
هلاّ أخذت الهارشبيل خاصّتي
أيضًا لو سمحت؟

170
00:13:52,640 --> 00:13:54,640
.تفعلها مجدّدًا

171
00:13:56,390 --> 00:13:57,500
.روزينا

172
00:13:58,270 --> 00:14:01,270
لماذا تأمرين فران؟

173
00:14:01,860 --> 00:14:02,890
لماذا؟

174
00:14:02,890 --> 00:14:05,050
.فران هو رئيس خدمي

175
00:14:05,050 --> 00:14:07,150
.لا تنسي ذلك

176
00:14:07,150 --> 00:14:08,270
ماذا؟

177
00:14:08,270 --> 00:14:11,540
،سأذهب لمساعدة رئيس الكهنة الآن

178
00:14:11,540 --> 00:14:14,610
لذا أطلب منك أن تحضري بعض
.الماء مع ديليا يا روزينا

179
00:14:14,610 --> 00:14:17,260
ماذا تقولين؟

180
00:14:17,260 --> 00:14:19,890
أليس هذا عمل كاهنة برداءٍ رماديّ؟

181
00:14:19,890 --> 00:14:21,130
ماذا؟

182
00:14:21,130 --> 00:14:25,310
قد تتضرّر أصابعي إذا قمت
.بأعمال خدم كهذه

183
00:14:26,000 --> 00:14:29,030
.دعي المتدرّبين هناك يتولّيان ذلك

184
00:14:30,380 --> 00:14:35,520
.روزينا، لن أسمح لك بإهانة خدمي

185
00:14:35,520 --> 00:14:39,390
وأنا متأكّدةٌ أنّني طلبت منك أداء
.واجبات أخرى كذلك

186
00:14:39,390 --> 00:14:44,030
لكن يا سيّدتي ماين، أنا مختلفة
.عن الخدم الآخرين

187
00:14:44,030 --> 00:14:47,160
لِم يتعذّر عليك فهم ذلك؟

188
00:14:47,500 --> 00:14:51,590
يبدو أنّك أسأت فهم مركزك ككاهنة
.متدرّبة ذات رداء أزرق

189
00:14:51,590 --> 00:14:52,900
هل أخطأت؟

190
00:14:52,900 --> 00:14:54,820
!أنت المخطئة يا روزينا

191
00:14:54,820 --> 00:14:56,210
!ديليا

192
00:14:57,690 --> 00:15:00,840
ما زلت لا آلف النّهج الّذي
.تسير عليه الكاتدرائيّة

193
00:15:00,840 --> 00:15:03,910
سوف أصغي لأقوال الجميع

194
00:15:03,910 --> 00:15:06,910
قبل أن أقرّر إن كنت على صواب
.أم خطأ يا روزينا

195
00:15:09,990 --> 00:15:14,100
،السّيّدة السّابقة لويلما وروزينا
،السّيّدة كريستين

196
00:15:14,100 --> 00:15:17,960
كانت كاهنة متدرّبة برداءٍ أزرق
.لم تحبّ سوى الفنّ

197
00:15:17,960 --> 00:15:22,040
فضّلت الخدم الّذين لديهم
.موهبة في الفنون

198
00:15:22,710 --> 00:15:27,310
كانت روزينا مفضّلة بواسطة سيّدتها
،لأنّها برعت في الموسيقى

199
00:15:27,310 --> 00:15:31,390
وكانت أعمال الخدم تُنجز كلّها بواسطة الخدم
.الكهنة المتدرّبين ذوي الرّداء الرّماديّ الآخرين

200
00:15:31,970 --> 00:15:37,110
وأعتقد لهذا السّبب هي تستخفّ بالكهنة
.ذوي الرّداء الرّماديّ وكذلك متدرّبيهم

201
00:15:37,700 --> 00:15:40,820
.ستكون هذه مشكلة مستعصية

202
00:15:41,120 --> 00:15:44,750
.كلمة رئيس الخدم من كلمة أسيادهم

203
00:15:44,750 --> 00:15:49,080
لست بحاجةٍ لخدم يرفضون فهم هذا
.الأمر، لذا أعيديهم إلى الميتم

204
00:15:49,080 --> 00:15:53,790
لكن حينئذ لن أتمكّن من التّمرّن
على الهارشبيل، أليس كذلك؟

205
00:15:53,790 --> 00:15:55,960
.سنبحث لك عن شخصٍ آخر

206
00:16:01,470 --> 00:16:04,730
،يا رئيس الكهنة
،قد يكون طلبي غير لائق

207
00:16:04,730 --> 00:16:07,320
لكن هلاّ عذرتني لهذا اليوم؟

208
00:16:08,230 --> 00:16:10,940
،أرغب سماع ما لدى خدمي من أقوال

209
00:16:10,940 --> 00:16:13,360
.لهذا أحتاج بعض الوقت للتّكلّم معهم

210
00:16:14,470 --> 00:16:17,360
تريدين رأيي؟

211
00:16:17,360 --> 00:16:20,500
،نعم. سمعت أنّ تحت أمرة السّيّدة كريستين

212
00:16:20,500 --> 00:16:24,330
كانت أعمال الخدم لا ينجزها
.سوى الكهنة ذوي الرّداء الرّماديّ

213
00:16:24,330 --> 00:16:26,370
هل تتّفقين مع هذا الكلام يا ويلما؟

214
00:16:27,870 --> 00:16:33,540
بعد أن عادت السّيّدة كريستين إلى حياة
،النّبلاء وبعد أن عدت أنا إلى الميتم

215
00:16:33,540 --> 00:16:38,770
كان ذلك عندما اكتشفت
.أنّ معاملتي كانت مميّزة

216
00:16:38,770 --> 00:16:41,650
...إذًا كلّ ما في الأمر أنّ روزينا

217
00:16:42,670 --> 00:16:49,060
سيّدتي ماين، لو سمحت، امنحي
.روزينا وقتًا لتأمّل تصرّفاتها كذلك

218
00:16:50,190 --> 00:16:52,570
.وصلت فكرتك

219
00:16:52,570 --> 00:16:53,830
.شكرًا لك

220
00:17:00,410 --> 00:17:03,090
.ثمّ أجرينا نقاشنا

221
00:17:03,090 --> 00:17:07,410
آلتها الموسيقيّة صاخبة ولا تصغي
.لأحد ولا تعمل أيضًا

222
00:17:07,410 --> 00:17:10,570
ألم تسمعي بمقولة "من لا يعمل، لا يأكل"؟

223
00:17:10,570 --> 00:17:13,260
كيف لي أن أعمل مع شخصٍ مثلها؟

224
00:17:13,260 --> 00:17:15,220
!اطرديها يا سيّدتي ماين

225
00:17:15,220 --> 00:17:18,580
،من الطّبيعيّ أن أكرّس كلّ ما لديّ لفنّي

226
00:17:18,580 --> 00:17:22,100
نظرًا إلى أنّ واجبي هو تعليم سيّدتي
.ماين كيفيّة العزف على الهارشبيل

227
00:17:22,430 --> 00:17:28,470
أريدك أن توسّعي آفاق الفنّ لديك
.أكثر قليلاً يا سيّدتي ماين

228
00:17:28,470 --> 00:17:32,740
روزينا، لا تتأمّلي أن تتلقّي نفس
.المعاملة الّتي تلقّيتها من قبل

229
00:17:32,740 --> 00:17:33,850
ماذا؟

230
00:17:33,850 --> 00:17:38,980
إن كنت ستصبحين خادمتي، أري منك
.تأدية واجباتٍ أخرى غير الموسيقى كذلك

231
00:17:39,390 --> 00:17:43,130
أعي أنّ يديك مهمّتان جدًّا عندما
،يتعلّق الأمر بالعزف على آلتك

232
00:17:43,130 --> 00:17:45,250
لذلك يمكنك الاهتمام
.بالمعاملات الورقيّة

233
00:17:45,840 --> 00:17:49,240
.لكن لم يسبق أن عملت في هذا المجال

234
00:17:52,250 --> 00:17:54,720
إن كانت هناك أشياء لا تعرفينها
،أو تعتقدين أنّك لا تستطيعين فعلها

235
00:17:54,720 --> 00:17:56,880
.فهذه هي الفرصة المثاليّة لتعلّمها

236
00:17:56,880 --> 00:18:01,810
،عندما أصبح غيل وديليا خادميّ
،لم يكونا يجيدان كتابة الرّسائل

237
00:18:01,810 --> 00:18:04,260
.لكن بعد بعض الجهد، تعلّما ذلك

238
00:18:07,570 --> 00:18:12,650
لكنّني لا أستفيد من خدمٍ يرفضون
.أن يقوموا بأيّ عملٍ من البداية

239
00:18:19,490 --> 00:18:24,230
.روزينا، أنا لست السّيّدة كريستين

240
00:18:25,160 --> 00:18:29,180
إمّا أن تقبلي هذه الشّروط
.أو تعودي إلى الميتم

241
00:18:29,180 --> 00:18:31,340
من فضلك اتّخذي قرارك
.مع حلول يوم غد

242
00:18:54,090 --> 00:18:57,990
أظنّني لا أستطيع العودة
.إلى ما كانت عليه الأمور

243
00:19:00,700 --> 00:19:03,900
إذا عملت بجدٍّ، فستعترف بك
.السّيّدة ماين

244
00:19:25,700 --> 00:19:29,870
أرغب في بذل جهد لأكون
.خادمتك يا سيّدتي ماين

245
00:19:30,430 --> 00:19:31,260
ماذا؟

246
00:19:31,260 --> 00:19:34,390
قرّرت الاحتفاظ بها إذًا؟

247
00:19:34,390 --> 00:19:37,790
.نعم. ستتولّى هي المعاملات الورقيّة

248
00:19:38,240 --> 00:19:42,540
مع أنّني متأكّدة أنّ رغبتها للعزف على
.الهارشبيل هي ما قادتها إلى هذا القرار

249
00:19:42,540 --> 00:19:45,530
.حسنًا، هذا يصبّ في صالحنا

250
00:19:45,900 --> 00:19:49,150
.لأنّني أردت أن أرى كيف يسير تمرينك

251
00:19:50,870 --> 00:19:53,270
!فـ-في عشرة أيّام؟

252
00:19:54,450 --> 00:19:57,040
.وهكذا بدأت دروسي المكثّفة

253
00:20:15,430 --> 00:20:24,360
...لنفهم السّعادة معًا

254
00:20:35,380 --> 00:20:37,080
.أحسنت صنعًا

255
00:20:38,350 --> 00:20:40,490
!يُعزى كلّ الفضل لك يا روزينا

256
00:20:40,490 --> 00:20:44,590
لا، هذا لأنّك سريعة التّعلّم
.يا سيّدتي ماين

257
00:20:50,090 --> 00:20:50,950
ماذا؟

258
00:20:51,720 --> 00:20:54,220
لا تحبّ ويلما التّواجد أمام رجال؟

259
00:20:54,500 --> 00:20:57,050
لم تكوني تعلمين؟

260
00:20:57,050 --> 00:21:03,740
ظننت أنّ ذلك كان سبب بقاء
.ويلما في الميتم

261
00:21:04,130 --> 00:21:06,630
هل هناك سببٌ معيّن لذلك؟

262
00:21:09,300 --> 00:21:15,610
خُدعت ويلما بواسطة كاهن برداءٍ أزرق
.وأجبرت على تسليم نفسها له

263
00:21:16,790 --> 00:21:20,080
لحسن الحظّ، لم يلحق بها
...أيّ ضرر آخر

264
00:21:20,500 --> 00:21:23,750
لكن باتت تخاف من الرّجال
.منذ ذلك الحين

265
00:23:02,750 --> 00:23:07,300
أرسل لي رئيس الكهنة مع الهارشبيل
...خاصّتي شراشف

266
00:23:07,300 --> 00:23:11,140
هل هذا شائع بالنّسبة للنّبلاء؟

267
00:23:11,140 --> 00:23:17,080
أعتقد أنّه أرسلها لك ليعتذر عن جعلك
.تغيبين عن الوعي في غرفة الحجز

268
00:23:17,080 --> 00:23:19,290
.لا تذكري هذا لأحد

269
00:23:19,290 --> 00:23:22,080
لأنّ تلقّي الشّراشف يكون عادة من قبل

270
00:23:22,080 --> 00:23:24,210
.العائلة أو الخطيب أو الحبيب

271
00:23:24,210 --> 00:23:27,850
لحظة، لماذا تفعل شيئًا يعطي
!النّاس فكرة خاطئة؟

272
00:23:27,850 --> 00:23:31,920
أنت السّبب لعدم تجهيزك شراشف لنفسك
.بينما تغيبين عن الوعي طوال الوقت

273
00:23:31,920 --> 00:23:34,960
هل يمكنني ردّ تلك الموعظة
مع هذه الهديّة؟