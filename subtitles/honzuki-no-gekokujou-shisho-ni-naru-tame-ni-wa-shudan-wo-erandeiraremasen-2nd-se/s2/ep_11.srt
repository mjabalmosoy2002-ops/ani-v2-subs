1
00:00:02,550 --> 00:00:05,480
تنطلق ماين للقتال بطلبٍ
.من نظام الفرسان

2
00:00:07,370 --> 00:00:11,560
يحين دورك بعد أن يقضي نظام
.الفرسان على الترومبي

3
00:00:11,560 --> 00:00:13,980
.تشيكيكوزا، دامويل

4
00:00:13,980 --> 00:00:15,580
.احرسا الكاهنة

5
00:00:15,580 --> 00:00:16,690
.حاضر

6
00:00:16,690 --> 00:00:20,020
،يا رئيس الكهنة، يا أعضاء نظام الفرسان

7
00:00:20,020 --> 00:00:22,440
.أصلّي لسلامتكم ونجاحكم

8
00:00:26,900 --> 00:00:29,030
.لم تكن تلك البركات ذات قيمة تذكر

9
00:02:15,570 --> 00:02:17,480
لم تكن ذات قيمة؟

10
00:02:18,010 --> 00:02:23,880
إنّ استخدام المانا على البركات
بينما تفتقرين لها

11
00:02:24,250 --> 00:02:26,870
.ليس سوى ضرب من الحماقة

12
00:02:29,750 --> 00:02:32,570
تشيكيكوزا، ماذا تقول؟

13
00:02:32,570 --> 00:02:37,630
هناك فرقٌ كبيرٌ بين الحصول
.على بركات أنغريف من عدمه

14
00:02:38,030 --> 00:02:40,220
.عددنا قليلٌ هذه المرّة أيضًا

15
00:02:40,220 --> 00:02:43,380
أين المشكلة في نعت الأحمق بأحمق؟

16
00:02:44,840 --> 00:02:46,230
...عيناه

17
00:02:47,990 --> 00:02:50,870
لديه نفس نظرة ذاك الكاهن
.ذي الرّداء الأزرق

18
00:02:51,250 --> 00:02:53,610
...تشيكيكوزا، أنت

19
00:02:54,520 --> 00:02:59,070
.أعتذر إذا أغضبتك

20
00:02:59,570 --> 00:03:01,490
.لن أفعلها ثانية

21
00:03:08,350 --> 00:03:11,130
.لا تأخذي كلامه على محمل الجدّ

22
00:03:11,530 --> 00:03:16,850
بعددنا القليل، بركاتك والمانا الّتي
.تزوّدنا بها ستكون تعزيزًا كبيرًا

23
00:03:17,180 --> 00:03:19,420
.اسمعني يا حاكم السّماوات

24
00:03:19,420 --> 00:03:22,330
...أيّها الملك، إله الظّلام

25
00:03:21,040 --> 00:03:22,330
.بدأت

26
00:03:22,330 --> 00:03:24,840
!يا أبا العالم بطوله وعرضه

27
00:03:25,150 --> 00:03:29,540
.لبّ ندائي وامنحني قوّتك المقدّسة

28
00:03:29,540 --> 00:03:32,940
مزّق الشّرّ الّذي ينحرف عن المسار
،وانتزع قوّته

29
00:03:32,940 --> 00:03:36,810
.وهب سلاحي بركاتك

30
00:03:37,290 --> 00:03:38,800
!بركاتك

31
00:03:42,010 --> 00:03:43,780
!اسودّت أسلحتهم

32
00:03:43,780 --> 00:03:45,620
هل يمكنك تفسير ذلك يا فران؟

33
00:03:46,090 --> 00:03:50,670
،لا... هذا أمرٌ جديدٌ بالنّسبة لي أيضًا
.لذا ليس مألوفًا لديّ

34
00:03:50,960 --> 00:03:52,400
،أيّتها الكاهنة المتدرّبة

35
00:03:52,400 --> 00:03:55,300
يحدث هذا للأسلحة الّتي منحت
.حماية إله الظّلام القدسيّة

36
00:03:55,780 --> 00:03:57,990
،إذا أشبعتها بالمانا وهاجمت

37
00:03:57,990 --> 00:04:00,670
.فإنّها ستمتصّ المانا من العدوّ لأجلك

38
00:04:00,670 --> 00:04:03,220
.لا يمكن هزيمة ترومبي بغير هذه الطّريقة

39
00:04:03,670 --> 00:04:08,220
أرى أنّ هنالك نبلاء يتفاعلون بشكلٍ
.طبيعيّ مع كاهنة متدرّبة أيضًا

40
00:04:08,600 --> 00:04:11,740
قليل من النّاس يستطيعون رؤية الفرسان
.وهم يقاتلون على أرض الواقع

41
00:04:12,230 --> 00:04:13,980
.ينبغي أن تراقبي بعناية

42
00:04:14,270 --> 00:04:16,100
.شكرًا لك من القلب

43
00:04:16,450 --> 00:04:19,270
في البداية، سنضعف الترومبي
.باستخدام السّهام

44
00:04:19,270 --> 00:04:22,730
انظري، الشّخص ذو الحرملة الزّرقاء
.هو السّيّد فيرديناند

45
00:04:34,490 --> 00:04:37,000
!كأنّه رامي سهام خيّال

46
00:05:02,980 --> 00:05:05,110
!رئيس الكهنة مذهل

47
00:05:05,110 --> 00:05:07,340
.سيّدتي ماين، انتبهي لكلامك

48
00:05:11,360 --> 00:05:15,550
تتطلّب مضاعفة السّهام
.بهذا الشّكل كثيرًا من المانا

49
00:05:16,090 --> 00:05:20,250
والسّيّد فيرديناند الّذي يستطيع فعل
.ذلك مرارًا هو رائع بحقّ

50
00:05:20,620 --> 00:05:21,760
!أجل

51
00:05:22,560 --> 00:05:25,250
.آمل أن يعود إلى نظام الفرسان

52
00:05:25,590 --> 00:05:27,200
ماذا؟ يعود؟

53
00:05:27,910 --> 00:05:29,760
.لا تخبري أحدًا أنّني قلت ذلك

54
00:05:30,370 --> 00:05:32,080
.عُلم

55
00:05:33,790 --> 00:05:37,740
نظرًا إلى نحالته وعصبيّته وإجادته
،للعمل المكتبيّ بإتقان

56
00:05:37,740 --> 00:05:41,410
.لم أتخيّل أبدًا أن يكون فارسًا سابقًا

57
00:05:43,530 --> 00:05:47,560
لكن أعتقد أنّ رئيس الكهنة
!بارع في كلّ شيء

58
00:05:51,080 --> 00:05:53,150
.بدأت تنجح

59
00:05:53,150 --> 00:05:55,700
أيمكنك رؤية الترومبي وهو يسودّ؟

60
00:05:58,330 --> 00:05:59,540
.أرى بالفعل

61
00:06:01,880 --> 00:06:03,330
.سقط طرف

62
00:06:09,280 --> 00:06:10,360
!الآن

63
00:06:10,360 --> 00:06:12,010
!هجوم

64
00:06:12,010 --> 00:06:13,030
!حاضر

65
00:06:31,440 --> 00:06:33,950
!أسقطنا ما يكفي من أطراف

66
00:06:33,950 --> 00:06:35,460
!لنهاجم الجذع الآن

67
00:06:35,460 --> 00:06:36,590
!حاضر

68
00:06:40,970 --> 00:06:42,140
!اقضوا عليه

69
00:06:51,300 --> 00:06:52,800
.انتهى الأمر تقريبًا

70
00:06:53,330 --> 00:06:58,880
.كنت قلقة من مقاتلة وحش مرعب كهذا

71
00:06:58,880 --> 00:07:02,570
.أنا مسرورةٌ لأنّه يبدو أنّنا لم نتكبّد أيّ ضحايا

72
00:07:02,890 --> 00:07:07,730
يبدو أنّ حضور السّيّد فيرديناند هذه
.المرّة، سهّل عمليّة التّعامل مع الأطراف

73
00:07:11,180 --> 00:07:14,870
دامويل، لماذا تتعامل بودّيّةٍ مع عامّيّة؟

74
00:07:14,870 --> 00:07:15,980
عامّيّة؟

75
00:07:15,980 --> 00:07:17,420
ألا تعلم؟

76
00:07:17,920 --> 00:07:19,630
.إنّها من العامّة

77
00:07:22,740 --> 00:07:27,610
وكعامّيّة، ترتدي الرّداء الأزرق
.الّذي لا يمنح إلاّ للنّبلاء

78
00:07:28,130 --> 00:07:30,340
.يا لها من حمقاء متعجرفة

79
00:07:32,660 --> 00:07:35,480
،صحيح أنّ عدد النّبلاء قد نقص

80
00:07:35,480 --> 00:07:38,740
.لكنّ هذا لا يبرّر منح العامّيّة رداءً أزرقًا

81
00:07:38,740 --> 00:07:42,390
.لست أفهم ما يفكّر به السّيّد فيرديناند

82
00:07:42,700 --> 00:07:46,260
.كفاك سخافة يا تشيكيكوزا

83
00:07:46,260 --> 00:07:48,340
.ما أقوله صحيح

84
00:07:48,340 --> 00:07:51,130
.كبير الكهنة حزين من هذه الحقيقة أيضًا

85
00:07:51,130 --> 00:07:56,620
لا يصدّق أنّ النّظام في الكاتدرائيّة
.يدمّر لأجل عامّيّة واحدة

86
00:07:59,460 --> 00:08:02,380
لِمَ لا تقولين شيئًا أيّتها العامّيّة؟

87
00:08:04,710 --> 00:08:09,900
ألا يمكنك تحريك لسانك البذيء
دون وجود السّيّد فيرديناند؟

88
00:08:13,270 --> 00:08:15,350
!كفّ عن هذا يا تشيكيكوزا

89
00:08:15,350 --> 00:08:17,520
!هدفنا حراستها

90
00:08:17,520 --> 00:08:20,560
!مكانتها لا تعني شيئًا حتّى ننجز مهمّتنا

91
00:08:20,560 --> 00:08:22,470
.اصمت يا دامويل

92
00:08:22,470 --> 00:08:24,160
.الزم حدودك

93
00:08:24,160 --> 00:08:26,220
.لا تُملِ عليّ ما يجب فعله

94
00:08:35,740 --> 00:08:37,020
!هذا مخيف

95
00:08:42,650 --> 00:08:43,620
!سيّدتي ماين

96
00:08:46,000 --> 00:08:47,120
!فران

97
00:08:48,930 --> 00:08:49,950
!سيّدتي ماين

98
00:08:49,950 --> 00:08:52,740
!لا تتحرّك يا فران

99
00:08:53,150 --> 00:08:56,580
ألم يطلب منّا التّحمّل أيًّا كان ما يحدث؟

100
00:08:57,320 --> 00:09:00,340
!يجب ألاّ ندع الأمر يتفاقم سوءًا

101
00:09:01,840 --> 00:09:04,170
.دعيني أعلّمك شيئًا أيّتها العامّيّة

102
00:09:04,570 --> 00:09:09,100
في ظروفٍ كهذه، عليك أن تعتذري
.لسوء سلوك خادمك

103
00:09:11,780 --> 00:09:17,610
.أعتذر على تجاوزات خادمي

104
00:09:20,920 --> 00:09:23,090
ما هذه النّظرة؟

105
00:09:23,090 --> 00:09:27,770
كيف تجرئين أيّتها العامّيّة؟
.ربّما ينبغي أن أقتلع عينيك

106
00:09:35,520 --> 00:09:36,990
."ميسّر"

107
00:09:39,400 --> 00:09:41,330
!لا تفعل يا تشيكيكوزا

108
00:09:41,330 --> 00:09:44,970
!يجب على المتدرّبة أن تؤدّي الطّقوس

109
00:09:44,970 --> 00:09:46,030
.اصمت

110
00:09:46,030 --> 00:09:48,550
.ليس عليك أن تأمرني أيّها النّبيل الأدنى

111
00:09:53,380 --> 00:09:53,970
!لا

112
00:09:55,710 --> 00:10:01,980
بهذا الشّكل سينحسر العامّة خوفًا
.وذعرًا منّا نحن النّبلاء

113
00:10:05,150 --> 00:10:06,380
!رئيس الكهنة

114
00:10:07,540 --> 00:10:08,300
!مؤلم

115
00:10:09,100 --> 00:10:12,500
.تستحقّين هذا لوقوفك فجأة أيّتها الحمقاء

116
00:10:29,020 --> 00:10:29,970
لماذا؟

117
00:10:34,290 --> 00:10:35,280
!سيّدتي ماين

118
00:10:38,470 --> 00:10:40,330
من أين أتى كلّ هذا الترومبي؟

119
00:10:40,330 --> 00:10:42,850
...هذا ذنبك لأنّك وقفت

120
00:10:47,200 --> 00:10:49,070
!سأخرجك أيّتها الكاهنة المتدرّبة

121
00:10:51,270 --> 00:10:55,450
.اسمعني يا حاكم السّماوات
.أيّها الملك، إله الظّلام

122
00:10:55,450 --> 00:10:57,870
!يا أبا العالم بطوله وعرضه

123
00:10:57,870 --> 00:10:59,530
.لبّ ندائي وامنحني قوّتك المقدّسة

124
00:10:58,590 --> 00:10:59,870
!لـ-لا أستطيع التّنفّس

125
00:10:59,530 --> 00:11:01,180
مزّق الشّرّ الّذي ينحرف عن المسار
،وانتزع قوّته

126
00:11:00,430 --> 00:11:01,610
!لوتز

127
00:11:01,180 --> 00:11:03,970
.وهب سلاحي بركاتك

128
00:11:02,190 --> 00:11:03,500
!النّجدة

129
00:11:04,190 --> 00:11:08,050
.حسنًا. سنرتّب لك هذا على الفور

130
00:11:11,290 --> 00:11:13,310
!النّجدة يا لوتز

131
00:11:13,900 --> 00:11:15,180
ماين؟

132
00:11:28,250 --> 00:11:30,880
.وهب سلاحي بركاتك...

133
00:11:28,850 --> 00:11:30,880
...لا... أستطيع التّنفّس

134
00:11:33,610 --> 00:11:35,520
.سأخرجك في الحال أيّتها الكاهنة المتدرّبة

135
00:11:38,860 --> 00:11:40,430
الحماية لا تفلح؟

136
00:11:40,430 --> 00:11:41,870
!تراجع يا دامويل

137
00:11:53,560 --> 00:11:56,600
ماين، ماذا يحدث هنا؟

138
00:11:56,970 --> 00:11:57,990
.دمائي

139
00:11:58,730 --> 00:12:02,040
.دمائي فعّلت الترومبي

140
00:12:02,290 --> 00:12:03,750
دماؤك؟

141
00:12:07,250 --> 00:12:08,610
.لا أصدّق هذا

142
00:12:09,520 --> 00:12:12,370
كان يفترض بكما أن تحمياها
!أيّها المعتوهان

143
00:12:12,680 --> 00:12:14,370
!آسفان حقًّا

144
00:12:15,210 --> 00:12:19,100
لا جدوى من إزالتهم عنها
.إذا بقي الجرح مفتوحًا

145
00:12:21,840 --> 00:12:23,460
."إنتوافنونغ"

146
00:12:25,570 --> 00:12:26,460
."روت"

147
00:12:31,240 --> 00:12:33,070
.حاولي ألاّ تبكي

148
00:12:33,660 --> 00:12:36,270
.فالدّموع تحتوي على مانا أيضًا

149
00:12:36,780 --> 00:12:37,700
.حسنًا

150
00:12:44,290 --> 00:12:45,560
...جرحي

151
00:12:45,950 --> 00:12:49,560
.استخدمت المانا لإغلاقه فقط، لا لشفائه

152
00:12:49,560 --> 00:12:54,380
استخدام المانا خاصّتي فوق ترومبي
.خطير جدًّا، لكن سيفي هذا بالغرض

153
00:12:54,640 --> 00:12:59,830
يا رئيس الكهنة، من فضلك استخدم تلك
.السّهام للتّخلّص من الترومبي

154
00:13:00,170 --> 00:13:03,850
عطّلت الحماية القدسيّة، لذا لا يمكنني
.استخدام الأسلحة بعد الآن

155
00:13:05,400 --> 00:13:09,710
لا يمكن تغيير هيئة سلاح
.حالما يشبع بالبركات

156
00:13:10,120 --> 00:13:12,370
.ينبغي أن تصل المساعدة قريبًا

157
00:13:19,400 --> 00:13:23,080
سيّد فيرديناند؟ لم إشارة الاستغاثة؟

158
00:13:23,080 --> 00:13:24,200
!تأخّرتم

159
00:13:26,550 --> 00:13:27,860
ما كلّ هذا؟

160
00:13:28,220 --> 00:13:33,030
كارستيد، الحارسان الضّعيفان اللّذان
.اخترتهما سمحا بحدوث هذا

161
00:13:33,030 --> 00:13:36,090
!أنقذ ماين حالاً! بسرعة

162
00:13:36,090 --> 00:13:36,880
!حاضر

163
00:13:36,880 --> 00:13:38,600
!يا رجال، في مواقعكم

164
00:13:38,600 --> 00:13:39,760
!حاضر

165
00:13:43,070 --> 00:13:44,760
!قطّعوه

166
00:13:49,420 --> 00:13:53,240
.كارستيد، لا تجرح ماين ولو بخدش

167
00:13:53,240 --> 00:13:55,150
.ستحوّلها إلى طعم

168
00:13:55,150 --> 00:13:56,150
!حاضر

169
00:14:07,480 --> 00:14:08,970
...إنّه قاسٍ

170
00:14:08,970 --> 00:14:10,480
!مرّة أخرى

171
00:14:10,760 --> 00:14:12,280
!حاضر

172
00:14:15,610 --> 00:14:19,820
.أنت الوحيد الّذي يحمل سكّينًا
.أسرع وأخرجها

173
00:14:19,820 --> 00:14:23,320
.لكنّ الحماية لم تنجح قبل قليل

174
00:14:23,320 --> 00:14:27,120
.لقد أغلقت الجرح
.لن يتفعّل الترومبي بعد الآن

175
00:14:31,850 --> 00:14:33,140
!نجحت هذه المرّة

176
00:14:35,990 --> 00:14:38,100
.كن حذرًا يا دامويل

177
00:14:38,950 --> 00:14:42,710
.دامويل، الكاهنة المتدرّبة
كيف حدث هذا؟

178
00:14:43,130 --> 00:14:46,730
.لم أر السّيّد فيرديناند بهذا الغضب قطّ

179
00:14:46,990 --> 00:14:48,170
...في الواقع

180
00:14:56,470 --> 00:14:57,750
هل أنت بخير؟

181
00:14:58,230 --> 00:15:02,870
.لا. من فضلك أحضر خادمي

182
00:15:04,910 --> 00:15:07,680
!أين خادم الكاهنة المتدرّبة؟

183
00:15:08,080 --> 00:15:09,460
!سيّدتي ماين

184
00:15:10,680 --> 00:15:12,610
.إنّها محمومة

185
00:15:12,860 --> 00:15:17,260
هذا غير مفاجئ. فقد لفّت بواسطة
.كلّ أطراف الترومبي تلك

186
00:15:17,870 --> 00:15:20,640
.لا بدّ وأنّها فقدت كثيرًا من المانا أيضًا

187
00:15:20,640 --> 00:15:22,860
.أشربها جرعتي

188
00:15:24,410 --> 00:15:27,170
.اشربي هذا من فضلك يا سيّدتي ماين

189
00:15:28,440 --> 00:15:29,860
ما هذا؟

190
00:15:30,120 --> 00:15:32,680
.جرعة من تحضير رئيس الكهنة

191
00:15:32,680 --> 00:15:36,120
ينبغي أن تساهم في تخفيف الإعياء
.واستعادة المانا

192
00:15:36,450 --> 00:15:38,510
حقًّا؟

193
00:15:45,760 --> 00:15:48,270
هل أنت بخير يا سيّدتي ماين؟

194
00:15:50,130 --> 00:15:53,910
.مذهل. الحمّى تنحسر

195
00:15:58,370 --> 00:16:00,620
.تشيكيكوزا، دامويل

196
00:16:01,250 --> 00:16:06,190
إذا كان لديكما أيّ كلام بشأن
.هذه الفوضى، فتكلّما حالاً

197
00:16:07,430 --> 00:16:11,070
.لا أملك سببًا للدّفاع عن نفسي

198
00:16:11,460 --> 00:16:13,070
.إنّها عامّيّة

199
00:16:13,490 --> 00:16:16,080
.هذا كل ما يهمّ

200
00:16:18,970 --> 00:16:20,820
ماذا عنك يا دامويل؟

201
00:16:21,430 --> 00:16:22,690
...في الواقع

202
00:16:24,430 --> 00:16:27,080
.نحتاج لمعلومات

203
00:16:27,080 --> 00:16:28,340
.عبّر عن رأيك

204
00:16:37,870 --> 00:16:40,230
.هكذا يعمل المجتمع الطّبقيّ

205
00:16:41,090 --> 00:16:46,040
.لكن أنا متأكّدةٌ أنّ رئيس الكهنة سيصدّقني

206
00:16:52,530 --> 00:16:55,750
.سيّد فيرديناند، سيّد كارستيد

207
00:16:56,060 --> 00:16:57,980
ما الأمر أيّتها الكاهنة المتدرّبة؟

208
00:17:00,800 --> 00:17:03,000
،إذا أخبرتكما بما حدث

209
00:17:03,000 --> 00:17:05,960
هل ستضمنان لي السّلامة؟

210
00:17:07,280 --> 00:17:09,010
ماذا تقصدين؟

211
00:17:09,900 --> 00:17:14,860
إذا أخبرتكما بالحقيقة الّتي لا تلائم
،عضوًا في الطّبقة النّبيلة

212
00:17:14,860 --> 00:17:21,530
هل ستجرّانني من شعري
أو تحاولان اقتلاع عيني؟

213
00:17:23,510 --> 00:17:25,030
ماذا؟

214
00:17:25,030 --> 00:17:26,760
فعلت هذا لها؟

215
00:17:27,040 --> 00:17:29,240
.هذا اتّهامٌ لا أساس له

216
00:17:29,240 --> 00:17:33,890
وقفت هذه العامّيّة عندما لم يكن
.عليها ذلك، فآذت نفسها

217
00:17:33,890 --> 00:17:37,420
دامويل، رأيت ما حدث، أليس كذلك؟

218
00:17:37,420 --> 00:17:39,400
.قل الحقيقة

219
00:17:39,400 --> 00:17:42,280
لست متأكّدًا ما إن كان
.دامويل قد رأى ذلك

220
00:17:51,760 --> 00:17:53,340
.منزلتنا مختلفة

221
00:17:54,770 --> 00:17:57,770
،عندما أخبرني تشيكيكوزا أن ألزم حدودي

222
00:17:59,360 --> 00:18:02,050
.لم أستطع منعه

223
00:18:03,860 --> 00:18:05,840
!أنا آسفٌ بحقّ

224
00:18:10,290 --> 00:18:15,020
هذا صحيح. يجب ألاّ تنسى أبدًا
.من هو أعلى رتبة منك

225
00:18:19,740 --> 00:18:21,560
،بالمناسبة يا تشيكيكوزا

226
00:18:22,390 --> 00:18:26,300
من لديه أعلى رتبة بيننا هنا؟

227
00:18:28,120 --> 00:18:30,410
.إنّه أنت يا سيّد فيرديناند

228
00:18:32,080 --> 00:18:33,080
.هذا صحيح

229
00:18:33,690 --> 00:18:36,460
.وأنا أمرتكما

230
00:18:37,140 --> 00:18:42,220
احرصا على حماية الكاهنة"
!"المتدرّبة من أيّ أذى

231
00:18:45,170 --> 00:18:50,790
إذا وضعت مرتبتنا بعين الاعتبار، ينبغي
.أن يكون واضحًا ما عليك فعله

232
00:18:51,500 --> 00:18:55,480
!أنت من يجب أن يلزم حدوده

233
00:18:57,290 --> 00:19:00,000
.لكن... لكن هذه عامّيّة

234
00:19:00,280 --> 00:19:04,180
.الفتاة الّتي آذيتها ليست مجرّد عامّيّة

235
00:19:04,630 --> 00:19:08,580
إنّها كاهنةٌ متدرّبةٌ منحت الرّداء الأزرق

236
00:19:08,580 --> 00:19:11,560
!بإذن المولى نظرًا لوفرة المانا خاصّتها

237
00:19:24,460 --> 00:19:31,270
فلتعلم أنّ أيّ شكوى أو اعتراض على ذلك
!القرار هو معارضة لمولاك

238
00:19:35,580 --> 00:19:41,990
،لم تعص الأوامر وتتخلّ عن واجباتك فحسب

239
00:19:41,990 --> 00:19:44,530
أخللت بمسؤوليّتك ولطّخت
.سمعة نظام الفرسان

240
00:19:44,970 --> 00:19:47,270
.إيّاك والظّنّ أنّك ستفلت

241
00:19:48,950 --> 00:19:52,780
.سيعاقبك الرّبّ في الوقت المناسب

242
00:19:57,590 --> 00:20:02,290
كارستيد، اخترت رجلين غير مؤهّلين
،كحارسين شخصيّين

243
00:20:02,850 --> 00:20:05,960
.وفشلت في تأديب مجنّديك

244
00:20:05,960 --> 00:20:08,510
.كقائد نظام الفرسان، ستتحمّل المسؤوليّة

245
00:20:09,800 --> 00:20:11,820
.ستعاقب في الوقت المناسب أيضًا

246
00:20:13,430 --> 00:20:19,820
كشفت هذه الفوضى ضعفي في القيادة
.في نظام الفرسان حقًّا

247
00:20:20,360 --> 00:20:27,570
.أعتذر أشدّ الاعتذار لتكبّدك عناء التّدخّل

248
00:20:30,260 --> 00:20:34,580
ماين، علينا أن نستكمل الطّقوس
.بينما لا يزال مفعول الجرعة ساريًا

249
00:20:34,580 --> 00:20:35,510
.حاضرة

250
00:20:40,900 --> 00:20:41,770
.تعالي معي

251
00:20:44,940 --> 00:20:45,710
.ها نحن أولاء

252
00:21:01,490 --> 00:21:02,690
.اسمعي يا ماين

253
00:21:03,130 --> 00:21:08,440
أثبتي لهم أنّك جديرة بارتداء
.هذا الرّداء الأزرق

254
00:21:09,120 --> 00:21:14,460
،إذا اعترف نظام الفرسان بأهمّيتك
.فذلك سيعمل كدرعٍ بالنّسبة لك

255
00:21:14,710 --> 00:21:15,800
.عُلم

256
00:21:15,800 --> 00:21:20,710
لكنّها المرّة الأولى لي. لا أعلم
.ما إن كان هذا سينجح

257
00:21:21,030 --> 00:21:23,200
.لا حاجة للقلق

258
00:21:23,670 --> 00:21:25,720
.سأكون داعمًا لك

259
00:21:27,390 --> 00:21:30,710
.لا أخوض معارك لا يمكنني فوزها

260
00:21:33,470 --> 00:21:36,980
...يُتبع

261
00:23:10,450 --> 00:23:12,720
.طقسي الأوّل وشيك

262
00:23:12,720 --> 00:23:14,950
أليس هذا محطّمًا للأعصاب يا رئيس الكهنة؟

263
00:23:14,950 --> 00:23:17,600
.إذًا يمكنك شرب قنينة أخرى من جرعتي

264
00:23:17,600 --> 00:23:19,670
!تلك الجرعة المقرفة من جديد

265
00:23:19,670 --> 00:23:21,840
.في الواقع، ضحّيت بالمذاق

266
00:23:21,840 --> 00:23:24,140
لكن أعطى مفعوله فورًا، أليس كذلك؟

267
00:23:24,140 --> 00:23:28,080
.نعم، لكن المذاق مهمّ. حسّنه أرجوك

268
00:23:28,080 --> 00:23:29,610
وماذا سيكون المقابل؟

269
00:23:29,610 --> 00:23:34,710
أشعر وكأنّ طريقة تفكير رئيس الكهنة
.بدأت تشبه طريقة تفكير بينّو مؤخّرًا