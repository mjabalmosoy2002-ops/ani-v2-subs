1
00:00:01,000 --> 00:00:04,230
،بعد أن علمت أنّ ذلك سينقذ حياتها

2
00:00:04,230 --> 00:00:06,260
.قرّرت ماين الانضمام للكاتدرائيّة

3
00:00:06,890 --> 00:00:10,770
.لكنّ المفاوضات مع كبير الكهنة باءت بالفشل

4
00:00:11,660 --> 00:00:16,240
.إيّاكم أن تمسّوا أمّي وأبي بضرّ

5
00:00:16,930 --> 00:00:20,240
نتيجة لذلك، في حين أنّها تمكّنت
،من الانضمام بشروطها

6
00:00:20,620 --> 00:00:23,120
.ينتظرها العديد من المحن والمصائب

7
00:02:05,400 --> 00:02:09,140
!أنا الآن كاهنة متدرّبة في الكاتدرائيّة

8
00:02:09,560 --> 00:02:13,650
!مرحى! يمكنني أن أقرأ كتبي أخيرًا

9
00:02:14,080 --> 00:02:16,650
.هوّني على نفسك يا ماين

10
00:02:16,650 --> 00:02:18,690
.سوف تصابين بحمّى من جديد

11
00:02:18,690 --> 00:02:20,530
.لا أتمنّى ذلك

12
00:02:20,840 --> 00:02:23,150
.ما زال هناك وقت قبل انضمامك

13
00:02:25,080 --> 00:02:27,690
،مع أنّ انضمامي قد تأكّد

14
00:02:27,690 --> 00:02:31,650
،يبدو أنّ هناك تحضيرات عديدة عليّ تجهيزها

15
00:02:31,650 --> 00:02:34,070
ما يعني أنّني سأحتاج لبعض
.الوقت قبل أن أشرع رسميًّا

16
00:02:34,820 --> 00:02:37,540
سوف ترين بينّو غدًا، أليس كذلك؟

17
00:02:37,540 --> 00:02:41,510
.نعم. أريد أن أخبره عن نتيجة المفاوضات

18
00:02:42,760 --> 00:02:44,190
!طاب يومك

19
00:02:44,190 --> 00:02:46,860
.مـ-مرحبًا

20
00:02:47,130 --> 00:02:50,850
.لوتز، عليك أن ترحّب بالزّبائن بابتسامة

21
00:02:51,150 --> 00:02:54,610
عمّاذا تبحثين اليوم؟

22
00:02:55,860 --> 00:02:58,490
.سمعت أنّكم تبيعون زينة شعر هنا

23
00:02:58,840 --> 00:03:00,400
...زينة شعر

24
00:03:00,400 --> 00:03:02,450
لوتز، هلّي بلحظة؟

25
00:03:05,690 --> 00:03:07,130
.أستأذن

26
00:03:08,160 --> 00:03:13,700
شكرًا على مساعدة لوتز في التّمرّن
.على خدمة الزّبائن يا ماين

27
00:03:13,700 --> 00:03:14,890
.العفو

28
00:03:15,280 --> 00:03:17,550
.أرى أنّه يبذل قصارى جهده

29
00:03:18,200 --> 00:03:21,460
،بخلافي أنا، لوتز قد شرع في تدريبه بالفعل

30
00:03:21,460 --> 00:03:23,250
.وكانت بدايته مبكّرة

31
00:03:23,660 --> 00:03:26,160
قال أنّه تكبّد عناء تعلّم كلّ شيء

32
00:03:26,160 --> 00:03:28,000
.والبسمة تعلو وجهه

33
00:03:28,000 --> 00:03:31,400
حسنًا، كيف سارت المفاوضات؟

34
00:03:31,400 --> 00:03:34,270
.باختصار، حقّقت نجاحًا باهرًا

35
00:03:34,270 --> 00:03:37,770
سأنضمّ ككاهنة برداء أزرق ويمكنني
.الاستمرار في العيش في المنزل

36
00:03:38,410 --> 00:03:41,140
،إذا كنتم بحاجةٍ ماسّة للمانا الخاصّة بماين

37
00:03:41,140 --> 00:03:44,280
.نطالب أن تُعامل كنبيلة

38
00:03:44,640 --> 00:03:47,670
.لا تدعوها تؤدّي عمل متدرّبين برداء رماديّ

39
00:03:48,190 --> 00:03:51,660
.حسنًا. ستُمنح رداءً أزرقًا كاستثناء

40
00:03:51,660 --> 00:03:53,160
هل من شروط أخرى؟

41
00:03:53,400 --> 00:03:56,900
نحن قلقان من تركها تعيش هنا
،بعيدة عن أنظارنا

42
00:03:56,900 --> 00:03:59,570
لهذا نطلب أن يُسمح لها بالاستمرار
.في العيش في المنزل

43
00:03:59,570 --> 00:04:03,180
نعم. جسدها واهن، لهذا نريد أن نحدّد

44
00:04:03,180 --> 00:04:05,310
ما إن كانت في ظرفٍ يسمح لها
.بالعمل كلّ صباح

45
00:04:05,310 --> 00:04:06,750
.لا مشكلة

46
00:04:06,750 --> 00:04:09,790
إنّها ليست يتيمة، لذا يمكنها
.الحضور من وإلى المنزل

47
00:04:09,790 --> 00:04:12,740
وليس عليها أن تضغط على نفسها
.إن لم تكن بحالٍ جيّدة أيضًا

48
00:04:13,140 --> 00:04:14,430
...المعذرة

49
00:04:14,820 --> 00:04:18,440
،حتّى عندما أكون بخير
.لا أستطيع المجيء من دون لوتز

50
00:04:18,440 --> 00:04:19,730
لوتز؟

51
00:04:19,730 --> 00:04:23,030
،نعم. قد يغمى عليّ فجأة في بعض الأوقات

52
00:04:23,030 --> 00:04:24,940
.لذلك هو يراقب حالتي

53
00:04:25,170 --> 00:04:28,210
.تحتاجين لخادم إذًا

54
00:04:28,710 --> 00:04:31,830
،لكلّ كاهنة برداءٍ أزرق بعض الخدم
.لذا لن تكون تلك مشكلة

55
00:04:33,750 --> 00:04:35,400
...خادم

56
00:04:36,200 --> 00:04:37,460
هل من شيء آخر؟

57
00:04:38,830 --> 00:04:42,980
.أنا مسجّلة لدى نقابة التّجّار

58
00:04:42,980 --> 00:04:45,420
هل من مانع أن أستمرّ في إدارة مشغلي؟

59
00:04:47,470 --> 00:04:50,660
...لا تحتاج خادمة الآلهة لشيء كهذا

60
00:04:51,250 --> 00:04:54,190
.أو هذا ما كان سيقوله كبير الكهنة

61
00:04:54,190 --> 00:04:57,380
.لكنّه مصدر دخل مهمّ بالنسبة لي

62
00:04:57,380 --> 00:05:00,590
،يمكنني استئجار اليتامى والدّفع مقابل عملهم

63
00:05:00,590 --> 00:05:03,290
.أو أتبرّع بجزء من الدّخل

64
00:05:03,290 --> 00:05:06,010
هل يمكننا التّوصّل لحلّ وسط؟

65
00:05:07,180 --> 00:05:09,260
إلى أيّ درجة هي مثقّفة؟

66
00:05:09,260 --> 00:05:10,200
عفوًا؟

67
00:05:10,200 --> 00:05:12,540
.أتكلّم مع نفسي فقط

68
00:05:12,970 --> 00:05:16,980
،أفتقر لكثير من المعلومات
.لذا لنناقش هذا في يوم آخر

69
00:05:17,320 --> 00:05:18,310
هل من طلبات أخرى؟

70
00:05:19,000 --> 00:05:19,950
.لا

71
00:05:20,180 --> 00:05:22,870
،سوف تُكلّف بالمحافظة على أدوات سحريّة

72
00:05:22,870 --> 00:05:25,970
.وكما تمنّت، المكتبة

73
00:05:25,970 --> 00:05:27,800
!المكتبة؟

74
00:05:27,800 --> 00:05:30,670
!كم أنت شخص لطيف يا رئيس الكهنة

75
00:05:32,420 --> 00:05:34,340
.شكرًا لك

76
00:05:34,630 --> 00:05:37,480
وقعت في فخّ الكتب إذًا؟

77
00:05:37,480 --> 00:05:40,480
.لكنّه قبل بكلّ شروطي

78
00:05:40,480 --> 00:05:43,410
.نعم. ليست لديّ أيّ شكوى من هذه النّاحية

79
00:05:43,410 --> 00:05:45,390
.يبدو رئيس الكهنة منطقيًّا

80
00:05:45,390 --> 00:05:48,070
.اذهبي إليه إذا احتجت لأيّ مساعدة

81
00:05:48,070 --> 00:05:50,060
.نعم، سأفعل

82
00:06:01,750 --> 00:06:05,710
كان لوتز يبذل قصارى جهده
.في العمل يا سيّدة كارلا

83
00:06:05,710 --> 00:06:10,150
،حقًّا؟ كنت قلقة
.لذا هذا يشعرني بالطّمأنينة

84
00:06:10,430 --> 00:06:15,190
بالمناسبة، ماذا قرّرت أن تفعلي في النّهاية؟

85
00:06:15,190 --> 00:06:17,480
رفضتِ التّلمذة كتاجرة، صحيح؟

86
00:06:17,800 --> 00:06:20,240
،لا أظنّني أستطيع تحمّل العمل في الخارج

87
00:06:20,240 --> 00:06:26,480
لذا سأعمل وأقدّم المساعدة في البوّابة
.وفي المنزل كالعادة

88
00:06:26,480 --> 00:06:28,130
حقًّا؟

89
00:06:28,130 --> 00:06:30,390
.أظنّ أنّ عليك التّركيز على التّعافي أكثر

90
00:06:30,780 --> 00:06:31,580
.حسنًا، وداعًا

91
00:06:32,060 --> 00:06:36,470
نحن نتكتّم على سرّ تلمذتي
.في الكاتدرائيّة عن جيراننا

92
00:06:36,470 --> 00:06:40,470
هذا لأنّ كثيرًا منهم يكرهون
.ممارسات الكاتدرائيّة

93
00:06:40,470 --> 00:06:41,760
.على ذكر الأمر

94
00:06:42,330 --> 00:06:45,230
.ثمّة رجل كان يتجوّل ويسأل عنك

95
00:06:45,230 --> 00:06:47,610
ماذا؟ يسأل عنّي أنا؟

96
00:06:47,610 --> 00:06:50,920
.نعم. عن مشغلك وما شابه

97
00:06:50,920 --> 00:06:53,480
قلت له أنّه خلط بينك وبين
.شخصٍ آخر وصرفته

98
00:06:53,750 --> 00:06:55,400
.لكن ابقي يقظة

99
00:06:55,400 --> 00:06:58,110
.توجد مشاكل في كلّ مكان

100
00:06:58,110 --> 00:07:00,360
.حسنًا. شكرًا لك

101
00:07:03,990 --> 00:07:09,060
لا يعلم بالمشغل سوى بينّو
...ورئيس النّقابة

102
00:07:11,800 --> 00:07:14,410
!امتناننا لوينتول

103
00:07:19,030 --> 00:07:22,040
هكذا إذًا، ستصبح أبًا؟

104
00:07:22,040 --> 00:07:22,880
...نعم

105
00:07:22,880 --> 00:07:27,630
لحظة، لماذا ستستقيل فقط لأنّ
طفلك في الطّريق؟

106
00:07:27,860 --> 00:07:30,290
.السّبب هو ماين

107
00:07:30,290 --> 00:07:33,710
المنتجات الّتي ابتكرتها تباع
.في لمح البصر

108
00:07:34,250 --> 00:07:38,760
لذا طلب منّي بينّو تقديم
.المساعدة في المتجر

109
00:07:38,760 --> 00:07:41,750
...منتجات ماين

110
00:07:42,510 --> 00:07:45,020
.تحبّ الآلهة ابنتي ماين

111
00:07:45,320 --> 00:07:47,890
إنّها إلهة الماء الخاصّة ببينّو
.في نهاية المطاف

112
00:07:48,450 --> 00:07:50,960
إلهة... الماء؟

113
00:07:50,960 --> 00:07:52,730
.لا بدّ وأنّك مبتهج أيضًا

114
00:07:53,230 --> 00:07:55,840
.يسرّني أنّك وجدت وسيلةً لنجاة ماين

115
00:07:59,310 --> 00:08:02,800
أما زلت غير راضٍ عن انضمامها للكاتدرائيّة؟

116
00:08:04,420 --> 00:08:06,950
أوتعتقد حقًّا أنّني قد أكون راضيًا عن ذلك؟

117
00:08:06,950 --> 00:08:09,920
،يقولون أنّهم سيعاملونها كنبيلة

118
00:08:09,920 --> 00:08:13,270
.لكن أعرفهم جيّدًا، محال أن يحدث ذلك

119
00:08:15,180 --> 00:08:18,620
.رغم ذلك، هذا أفضل من أن تموت أمامي

120
00:08:20,380 --> 00:08:24,050
.لعلّ الآلهة عيّنتك جنديًّا لهذا السّبب

121
00:08:25,650 --> 00:08:27,200
ماذا تقصد؟

122
00:08:27,570 --> 00:08:31,590
تمتلك ماين المانا والقدرة على كسب
.الكثير من المال

123
00:08:32,010 --> 00:08:36,030
وهذا يعرّضها لخطر الاختطاف
.بواسطة نبلاء غرباء

124
00:08:36,820 --> 00:08:38,520
!اختطاف؟

125
00:08:38,520 --> 00:08:39,440
!صه

126
00:08:40,130 --> 00:08:43,030
!عملك هو منع ذلك

127
00:08:44,750 --> 00:08:47,520
كحارس بوّابة، يمكنك تفتيش
.كلّ نبيل يأتي إلى هنا

128
00:08:47,520 --> 00:08:50,660
أليس ذلك العمل المثاليّ
إذا أردت حماية ماين؟

129
00:08:51,090 --> 00:08:52,790
.معك حقّ هنا

130
00:08:52,790 --> 00:08:55,600
.سأعِينك أيضًا يا قائد

131
00:08:55,600 --> 00:08:56,630
.شكرًا

132
00:08:56,630 --> 00:08:59,870
.سأحمي عائلتي إضافة إلى هذه البلدة بأكملها

133
00:09:06,980 --> 00:09:09,980
رجل يتحرّى عنك؟

134
00:09:09,980 --> 00:09:14,220
إنّه على الأرجح نفس الشّخص
.الّذي تسلّل إلى نقابة التّجّار

135
00:09:14,890 --> 00:09:17,610
شخص تسلّل إلى نقابة التّجّار؟

136
00:09:17,610 --> 00:09:21,980
.نعم. أنا متأكّد أنّه توصّل لملفّ مشغلك

137
00:09:21,980 --> 00:09:26,370
واثق أنّ شخصًا في الكاتدرائيّة
.يجمع معلومات عنك

138
00:09:27,280 --> 00:09:29,360
.أشعر أنّ النّبلاء لهم يد في الأمر

139
00:09:30,480 --> 00:09:34,080
.هذا ما يسبّبه الانضمام للكاتدرائيّة إذًا

140
00:09:38,230 --> 00:09:39,430
.لا تقلقي

141
00:09:39,870 --> 00:09:41,840
.أنا هنا لأجلك

142
00:09:45,950 --> 00:09:46,920
.شكرًا

143
00:09:48,970 --> 00:09:51,690
عقب ذلك، ذهبنا لنُري كورينا

144
00:09:51,690 --> 00:09:54,850
تعديلاتي الّتي أجريتها على دبّوس
.الشّعر والفستان بناء على طلبها

145
00:09:54,850 --> 00:09:58,710
.أدّى ذلك إلى بيع بينّو حقوق زينة الشّعر

146
00:10:03,480 --> 00:10:06,870
!حان وقت تذوّق الكعكة الإسفنجيّة

147
00:10:07,100 --> 00:10:09,450
ماذا تفعلين هنا؟

148
00:10:09,450 --> 00:10:12,740
...أ-أقدّم المساعدة

149
00:10:12,740 --> 00:10:16,860
لماذا برأيك أعتّم على كافّة
!المعلومات المتعلّقة بك؟

150
00:10:16,860 --> 00:10:19,170
!أنت مستهترة جدًّا

151
00:10:19,170 --> 00:10:20,830
!بدّلي ملابسك حالاً

152
00:10:20,830 --> 00:10:21,860
...حسنًا

153
00:10:35,520 --> 00:10:37,540
رأيت؟ أليست لذيذة؟

154
00:10:39,270 --> 00:10:42,680
لماذا بعت وصفة شيء لذيذ
كهذا إلى فريدا؟

155
00:10:43,140 --> 00:10:46,920
وهل لديك الحقّ لتسأل؟
.أنا متأكّدة أنّك كنت تنهبني

156
00:10:47,250 --> 00:10:52,490
سمعت من فريدا أنّ حقوق المنتجات
.الجديدة تبدأ من قطعة ذهبيّة كبيرة

157
00:10:53,930 --> 00:10:58,140
بالإضافة إلى ذلك، ليس لديك صلاحيّة
.الوصول إلى سكّر وطبّاخ

158
00:10:58,140 --> 00:11:02,330
معظم وصفات أطعمتي الخفيفة
.تعتمد على السّكّر

159
00:11:03,280 --> 00:11:05,300
إذًا كل ما أحتاجه هو طبّاخ وسكّر؟

160
00:11:05,300 --> 00:11:07,670
.لن ينفعك أيّ طبّاخ

161
00:11:07,670 --> 00:11:10,400
،يجب أن يكون ماهرًا بما يكفي لخدمة النّبلاء

162
00:11:10,400 --> 00:11:13,780
.ولديه صلاحيّة وصول غير محدودة إلى الفرن

163
00:11:15,670 --> 00:11:16,830
ما هذا؟

164
00:11:17,310 --> 00:11:22,310
أنا من سوف يشتري كلّ وصفات
.ماين يا سيّد بينّو

165
00:11:22,310 --> 00:11:24,820
.سلامي يا سيّد بينّو

166
00:11:25,540 --> 00:11:26,780
.لا تقلق

167
00:11:27,140 --> 00:11:30,790
.يمكنك الاعتماد عليّ في إتقان وصفات ماين

168
00:11:33,200 --> 00:11:35,530
.شكرًا لك يا سيّدة إيلزي

169
00:11:36,010 --> 00:11:37,410
.مهلاً

170
00:11:38,130 --> 00:11:42,680
كلّ ما أحتاجه هو طبّاخة
وفرن وسكّر وإبداع، صحيح؟

171
00:11:42,680 --> 00:11:44,050
سيّد بينّو؟

172
00:11:44,050 --> 00:11:47,710
،قلت أنّك إذا لم تستطيعي الحصول على كتب
.فليس عليك سوى صنعها بنفسك

173
00:11:47,710 --> 00:11:49,000
...على نفس السّياق

174
00:11:49,000 --> 00:11:51,050
ما الّذي يمكنني فعله إذا لم أملك طبّاخًا؟

175
00:11:51,650 --> 00:11:54,440
يمكنك تدريب واحد بنفسك؟

176
00:11:54,800 --> 00:11:56,470
.تمامًا

177
00:11:56,810 --> 00:12:00,800
أن يكون بينّو شديد الحماس
.هو أمر مثاليّ برأيي

178
00:12:00,800 --> 00:12:04,520
سيفتح امتلاك فرن مخصّص الآفاق
!للعديد من الأطباق

179
00:12:04,520 --> 00:12:06,170
.بيتزا

180
00:12:06,170 --> 00:12:07,380
.غراتان

181
00:12:07,380 --> 00:12:08,950
.لازانيا

182
00:12:09,340 --> 00:12:11,830
!الكيش والفطيرة سيكونان على المائدة أيضًا

183
00:12:11,830 --> 00:12:14,830
!لنفتتح مطعمًا إيطاليًّا

184
00:12:14,830 --> 00:12:17,750
ما الّذي تفعله الآن؟

185
00:12:18,230 --> 00:12:22,830
عليها الذّهاب إلى الكاتدرائيّة ابتداءً
من الغد أيضًا. هل ستكون بخير؟

186
00:12:25,350 --> 00:12:27,460
،بحسب تحرّياتي حول ماين

187
00:12:27,460 --> 00:12:31,100
.إنّها مسجّلة كمالكة مشغل لدى نقابة التّجّار

188
00:12:31,510 --> 00:12:35,140
خادمة آلهة تدير مشغلاً؟

189
00:12:35,140 --> 00:12:40,130
نعم. لكن هذا سيساعدنا في اكتساب
،دخلٍ بشكل دوريّ

190
00:12:40,130 --> 00:12:43,920
لذا أعتقد أنّ السّماح لها بالمتابعة
.هو الخيار الأفضل

191
00:12:45,820 --> 00:12:49,280
،وبالنّسبة للخدم الّذين سنخصّصهم لماين

192
00:12:49,280 --> 00:12:53,910
أخطّط لتعيين أحد خدمي لها
.والطّلب منه أن يوافيني بتقرير

193
00:12:54,350 --> 00:12:55,530
.فكرة سديدة

194
00:12:55,530 --> 00:12:59,240
.إذًا سأرسل أحدًا من عندي كذلك

195
00:13:00,780 --> 00:13:02,570
،بالنّسبة للخادم الأخير

196
00:13:02,570 --> 00:13:06,330
.دع أكثر الأطفال المشاغبين بين اليتامى يزعجها

197
00:13:06,330 --> 00:13:10,170
استنزف منها أكبر قدر ممكن
.من المال والمانا

198
00:13:10,170 --> 00:13:14,640
تلك الشّيطانة الصّغيرة
.ليست نافعة لأيّ شيء آخر

199
00:13:16,230 --> 00:13:17,710
.عُلم

200
00:13:26,430 --> 00:13:28,420
.حسنًا، هذا ليس مثاليًّا بالتّأكيد

201
00:13:41,300 --> 00:13:43,530
.ماين، لا تتحمّسي أكثر من اللاّزم

202
00:13:43,530 --> 00:13:44,930
.أعلم

203
00:13:44,930 --> 00:13:47,270
.لكن يمكنني مطالعة كتب أخيرًا

204
00:13:48,640 --> 00:13:50,760
.انظري، اقتربنا

205
00:13:51,520 --> 00:13:52,730
.أحدهم ينتظر

206
00:13:57,270 --> 00:13:59,900
.صباح الخير يا سيّدتي ماين

207
00:14:00,660 --> 00:14:04,750
!سيّدتي ماين"؟ أشعر أنّ هناك خطأ ما"

208
00:14:03,960 --> 00:14:05,650
!لوتز

209
00:14:05,650 --> 00:14:07,450
!هذا ليس مضحكًا

210
00:14:07,450 --> 00:14:09,150
.آسف، سأتوقّف

211
00:14:09,680 --> 00:14:12,170
سآتي لآخذك عند الجرس الخامس، اتّفقنا؟

212
00:14:14,450 --> 00:14:18,870
.المعذرة... آسفة إذا أقلقت راحتك

213
00:14:19,330 --> 00:14:22,710
.لا داعي لتعتذري منّي

214
00:14:24,260 --> 00:14:26,330
.رئيس الكهنة ينتظرك

215
00:14:48,460 --> 00:14:50,570
.اغربي عن وجهي أيّتها العامّيّة

216
00:15:02,010 --> 00:15:05,370
...نحن نعيش في مجتمع طبقيّ فعلاً إذًا

217
00:15:12,580 --> 00:15:16,420
.سنبدأ الآن بمراسم أخذ القسم

218
00:15:20,810 --> 00:15:22,630
،الرّبيع أخضر

219
00:15:23,100 --> 00:15:27,260
.لون الحياة النّابضة الّذي يتغلّب على الشّتاء القاسي

220
00:15:28,090 --> 00:15:29,900
،الصّيف أزرق

221
00:15:30,390 --> 00:15:35,100
.لون السّماوات الواسعة الّذي يجعل الحياة تدوم

222
00:15:36,020 --> 00:15:37,900
،الخريف أصفر

223
00:15:38,280 --> 00:15:42,350
.لون قمح ناضج ودسم يتدلّى رأسه

224
00:15:43,380 --> 00:15:45,140
،الشّتاء أحمر

225
00:15:45,560 --> 00:15:49,900
لون الموقد الّذي يقاوم البرد
.ويمنح الأمل

226
00:15:51,620 --> 00:15:53,310
.والآن، أدلي بقسمك

227
00:15:56,720 --> 00:15:59,360
.كرّري ورائي

228
00:15:59,940 --> 00:16:00,770
.حسنًا

229
00:16:03,680 --> 00:16:10,470
.استجيبوا لي يا حكّام السّماوات

230
00:16:10,910 --> 00:16:18,050
.يا أيّها الملك والملكة، يا آلهة النّور والظّلام

231
00:16:18,440 --> 00:16:21,280
.استجيبوا لي يا حكّام الأرض الخمسة الخالدين

232
00:16:21,280 --> 00:16:23,240
.حكّام الأرض الخمسة الخالدين...

233
00:16:23,240 --> 00:16:24,440
...إلهة

234
00:16:23,240 --> 00:16:25,610
.إلهة الماء، فريوترين

235
00:16:26,080 --> 00:16:28,410
.إله النّار، لايدنشافت

236
00:16:28,740 --> 00:16:31,180
.إلهة الرّياح، شوتزاريا

237
00:16:31,500 --> 00:16:34,020
.إلهة الأرض، غيدولليه

238
00:16:34,520 --> 00:16:37,060
.إله الحياة، إيفيغليبن

239
00:16:37,590 --> 00:16:40,150
...من السّماوات العظيمة

240
00:16:40,150 --> 00:16:42,760
...إلى الأرض الواسعة...

241
00:16:42,760 --> 00:16:46,340
...عسى أن تتألّق قوى الملك والملكة

242
00:16:46,340 --> 00:16:49,770
...وأن يمنح الخمسة الخالدون بركتهم

243
00:16:50,150 --> 00:16:52,910
.لكلّ الكائنات الحيّة في هذه البلاد...

244
00:16:53,280 --> 00:16:58,410
...ولأعبّر عن امتناني لنعمتكم

245
00:16:58,410 --> 00:17:06,300
أقدّم لكم قلبي وإيماني بكم
.وأعبدكم كآلهة الآلهة

246
00:17:06,300 --> 00:17:09,330
،إلى كافّة آلهة الطّبيعة

247
00:17:09,330 --> 00:17:15,460
أقسم أنّني سأصلّي لكم وأشكركم
.وأكرّس حياتي لكم

248
00:17:20,420 --> 00:17:25,100
الأزرق هو لون إله النّار
،الّذي يساهم في نموّ الحياة

249
00:17:25,100 --> 00:17:28,560
.ولون السّماوات الّتي تحكمها الكائنات السّامية

250
00:17:29,040 --> 00:17:31,230
الكهنة والكاهنات

251
00:17:31,230 --> 00:17:35,560
الّذين يقسمون بعبادتهم
ويتحسّنون على الدّوام

252
00:17:35,560 --> 00:17:37,820
.يُمنحون هذا الرّداء الأزرق

253
00:17:46,410 --> 00:17:50,450
،أيّتها التّلميذة التّقيّة الّتي هدتها الآلهة إلينا

254
00:17:51,560 --> 00:17:53,990
.نستقبلك بصدرٍ رحب

255
00:17:53,990 --> 00:17:58,680
.من أعماق قلبي، أشكرك على التّرحيب بي

256
00:17:58,680 --> 00:18:00,550
.صلّي إذًا

257
00:18:06,230 --> 00:18:08,090
!أقدّم للآلهة صلواتي

258
00:18:13,310 --> 00:18:14,970
.هذا يكفي

259
00:18:14,970 --> 00:18:17,620
.احرصي على تعلّمها قبل احتفالك

260
00:18:19,660 --> 00:18:21,920
.دعيني أعرّفك على خدمك

261
00:18:28,410 --> 00:18:31,340
.اسمي فران. سررت بلقائك

262
00:18:31,640 --> 00:18:34,700
.وكذلك أنا. سررت جدًّا بلقائك

263
00:18:34,700 --> 00:18:38,600
.ماين، أنت ترتدين رداءً أزرقًا

264
00:18:38,600 --> 00:18:42,100
لا يجب أن تتواضعي أمام
.ذوي الرّداء الرّماديّ

265
00:18:42,100 --> 00:18:44,480
.آ-آسفة بشأن ذلك
.سأضع ذلك في الحسبان

266
00:18:45,560 --> 00:18:47,760
.اسمي ديليا. أنا في الثّامنة

267
00:18:47,760 --> 00:18:50,230
.بصفتنا فتاتين، لننسجم معًا

268
00:18:50,230 --> 00:18:51,860
!يا لها من أنيقة

269
00:18:51,860 --> 00:18:54,810
!أنت سيّدتي؟ هذا سيّئ

270
00:18:54,810 --> 00:18:56,220
!أنت مجرّد طفلة

271
00:18:56,220 --> 00:18:57,990
...ماذا؟ المعذرة

272
00:18:57,990 --> 00:18:59,960
.اسمي غيل. عمري عشرة أعوام

273
00:19:02,010 --> 00:19:04,200
.غيل هو خادمك

274
00:19:04,200 --> 00:19:08,240
.عندما يسيء التّصرّف، يجب أن توبّخيه

275
00:19:08,240 --> 00:19:09,820
من؟ أنا؟

276
00:19:10,520 --> 00:19:13,700
المعذرة، هلاّ حاولت ألاّ تكون وقحًا؟

277
00:19:13,700 --> 00:19:15,620
ماذا؟ هل أنت غبيّة؟

278
00:19:17,080 --> 00:19:22,740
،عذرًا يا رئيس الكهنة
."لم يسبق أن امتلكت "خدمًا

279
00:19:22,740 --> 00:19:24,150
.لست بحاجة لهم

280
00:19:23,610 --> 00:19:25,000
.لا

281
00:19:25,000 --> 00:19:29,170
امتلاك كلّ كاهن برداء أزرق
.خدمًا هو أمر إلزاميّ

282
00:19:30,040 --> 00:19:31,840
حقًّا؟

283
00:19:31,840 --> 00:19:36,690
بصفتك سيّدتهم، عليك أن ترشديهم
.بتصرّفاتك وسلوكك

284
00:19:37,160 --> 00:19:40,030
أرشدهم بتصرّفاتي وسلوكي؟

285
00:19:40,490 --> 00:19:42,760
.يا رئيس الكهنة، لحظة من فضلك

286
00:19:42,760 --> 00:19:44,820
ما الأمر يا أرنو؟

287
00:19:45,530 --> 00:19:47,600
.انتظري هنا

288
00:19:53,450 --> 00:19:57,210
يا إلهي، بعد أن تحايلت وتمكّنت أخيرًا
!من خدمة كبير الكهنة

289
00:19:57,720 --> 00:20:01,550
!وها أنا ذي! سحري لن ينجح على فتاة

290
00:20:01,850 --> 00:20:04,190
.بالفعل، هذا غير معقول

291
00:20:04,190 --> 00:20:07,560
أنت من عامّة النّاس، لست نبيلة، صحيح؟

292
00:20:07,560 --> 00:20:09,610
!صن لسانك يا غيل

293
00:20:10,090 --> 00:20:16,810
سيّدتي ماين، قال لك رئيس الكهنة للتّوّ
.أن تضبطي أيّ سلوك سيّئ

294
00:20:17,910 --> 00:20:20,370
عليّ أن أرشدهم، صحيح؟

295
00:20:24,200 --> 00:20:27,950
.إن كان لا يعجبكما ذلك، يمكنني استبدالكما

296
00:20:27,950 --> 00:20:29,960
!فعلتها

297
00:20:29,960 --> 00:20:34,050
.بربّك. محال أن يحدث ذلك

298
00:20:34,050 --> 00:20:38,370
.طلب منّي كبير الكهنة أن أزعجك

299
00:20:39,090 --> 00:20:40,610
كبير الكهنة ماذا؟

300
00:20:40,610 --> 00:20:45,300
.سأدعه يعترف بحيلي وأصبح محظيّته

301
00:20:45,300 --> 00:20:48,270
!مـ-مـ-مـ-محظيّة؟

302
00:20:48,270 --> 00:20:50,270
.الفتيات لديهنّ أفضليّة حقًّا

303
00:20:50,270 --> 00:20:52,940
وهل هذا شيء يدعو للمفخرة؟

304
00:20:52,940 --> 00:20:54,540
.بالطّبع

305
00:20:54,540 --> 00:20:57,610
.إنّه المنصب الّذي تتمنّاه كلّ امرأة

306
00:20:58,310 --> 00:21:01,600
.هذه معلومة شائعة
كيف لك ألاّ تعرفي ذلك؟

307
00:21:01,600 --> 00:21:03,610
.لا بدّ وأنّك غبيّة حقًّا

308
00:21:06,270 --> 00:21:08,050
ما هو شائع بالنّسبة لكم أيّها الدّينيّون

309
00:21:08,050 --> 00:21:11,880
لا علاقة له بما هو شائع في حياة
!مركز المدينة أو حياتي كأورانو

310
00:21:11,880 --> 00:21:13,670
،لو كان رئيس الكهنة

311
00:21:13,670 --> 00:21:17,310
.لأبلى بلاءً أفضل في إيقافهما عند حدّيهما

312
00:21:14,870 --> 00:21:18,000
.فران الّذي يبدو وفيًّا لرئيس الكهنة

313
00:21:18,270 --> 00:21:21,870
.غيل صاحب اللّسان السّليط

314
00:21:18,370 --> 00:21:21,880
هل عقلك سليم؟

315
00:21:22,150 --> 00:21:25,270
وديليا الّتي تريد أن تكون محظيّة
.وأعلنت صراحةً أنّها جاسوسة

316
00:21:25,270 --> 00:21:31,110
يبدو أنّ قدمي وطأت في عالم
.لا أتمنّى أن أكون جزءًا منه

317
00:23:08,810 --> 00:23:10,110
.قولي لي يا ماين

318
00:23:10,110 --> 00:23:13,150
ألم تكوني تتفاوضين مع السّيّد بينّو قبل أيّام؟

319
00:23:13,150 --> 00:23:15,870
تقصدين على حقوق زينة الشّعر؟

320
00:23:15,870 --> 00:23:17,980
ما حجم الصّفقة الّتي حقّقتها؟

321
00:23:17,980 --> 00:23:21,540
.ذهبيّة كبيرة واحدة وسبع ذهبيّات صغيرة

322
00:23:21,540 --> 00:23:24,380
!ذ-ذ-ذهبيّة؟

323
00:23:24,380 --> 00:23:26,360
لم أنهبه، صحيح؟

324
00:23:26,360 --> 00:23:30,170
إنّه حتمًا سعر منصف
لحقوق احتكار، صحيح؟

325
00:23:30,170 --> 00:23:31,240
...ماين

326
00:23:31,240 --> 00:23:34,720
ربّما كان ينبغي أن تدخلي في مجال
.التّجارة بدلاً من الانضمام للكاتدرائيّة