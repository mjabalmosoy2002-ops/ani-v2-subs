1
00:00:03,990 --> 00:00:05,180
!استيقظوا جميعًا

2
00:00:05,910 --> 00:00:09,390
!ثمّة حالة طوارئٍ
!تسلّحوا وتأهّبوا

3
00:00:09,590 --> 00:00:10,630
ماذا يحدث؟

4
00:00:10,630 --> 00:00:12,490
.لا يزال الظّلام دامسًا في الخارج

5
00:00:12,490 --> 00:00:13,940
ماذا جرى؟

6
00:00:14,190 --> 00:00:16,510
.وَصل تابع آيزو لتوّه

7
00:00:16,890 --> 00:00:19,360
.نشب خطبٌ جَسيم في القصر

8
00:00:19,360 --> 00:00:20,420
في القصر؟

9
00:00:20,420 --> 00:00:21,740
ما بال شَعرك؟

10
00:00:22,090 --> 00:00:24,640
هل تَقصد القصر حيث يُقيم الإمبراطور؟

11
00:00:24,970 --> 00:00:27,040
وبأيّ سلاحٍ نتأهّب؟

12
00:00:29,520 --> 00:00:31,040
هل أَحكمتم ربط دُروع الصّدر؟

13
00:00:31,040 --> 00:00:32,200
!ارتدوا دُروعكم كاملةً

14
00:00:32,420 --> 00:00:33,970
!لا تنسوا خُوذاتكم القتاليّة

15
00:00:34,120 --> 00:00:36,900
مَن كان يتخيّل أنّ كُلّ هذه العُدّة
مجهزّةٌ في المَخزن؟

16
00:00:36,900 --> 00:00:38,840
.هذا بِفضل سيريزاوا

17
00:00:39,030 --> 00:00:41,250
صحيحٌ، أين سيريزاوا-سان؟

18
00:00:41,530 --> 00:00:44,680
،إنّه في مَعزلٍ، أيّها الأبله
.دعك منه الآن

19
00:00:45,020 --> 00:00:47,440
،أيّها الرّجال
!أثق بأنّكم مُستعدّون

20
00:00:48,640 --> 00:00:49,800
!لنَنطلق

21
00:02:31,440 --> 00:02:34,040
سيتولّى رجال المِيبورو مهامّ
.الحِراسة داخل أروقة القصر

22
00:02:34,470 --> 00:02:37,190
سنَدخل عبر بوّابة هاماغوري
.في الجانب الغربيّ

23
00:02:37,190 --> 00:02:39,530
هل تقصد أنّنا سنُقاتل داخل القصر؟

24
00:02:39,780 --> 00:02:42,260
ولكن مَن الّذي اجترأ على مُهاجمته؟

25
00:02:42,510 --> 00:02:43,890
.يبدو أنّهم رجال تشوشو

26
00:02:44,050 --> 00:02:47,870
تشوشو؟ أَلم تكن حِماية
القصر مَوكولةً إليهم؟

27
00:02:47,870 --> 00:02:50,630
بلى، ولكن يبدو أنّهم
.قد أُزيحوا مِن مواقعهم

28
00:02:50,920 --> 00:02:53,480
أُزيحوا كَرهًا؟ وما السّبب؟

29
00:02:53,880 --> 00:02:55,770
،لا عِلم لي بذلك

30
00:02:56,100 --> 00:02:59,450
لكن قِيل لي إنّ آيزو وساتسوما
.هُما مَن يتولّيان زِمام الأمور الآن

31
00:02:59,680 --> 00:03:05,230
عُذرًا، شقيقتي تقطن دار أحد
نُبلاء القصر، أَتُراها ستَكون بخيرٍ؟

32
00:03:06,070 --> 00:03:08,410
.أجل، هذا مَكمن القلق

33
00:03:09,060 --> 00:03:12,620
رُغم أنّها لم تُشِر لفصيل
...تشوشو صراحةً، إلّا أنّ

34
00:03:16,180 --> 00:03:17,900
،اغربوا عن وُجوهنا
!يا رجال تشوشو

35
00:03:17,900 --> 00:03:19,930
!لن نسمح لكُم بتَجاوزنا أبدًا

36
00:03:19,930 --> 00:03:21,350
!أيّها الأغبياء الرّعاع مِن ساتسوما

37
00:03:21,350 --> 00:03:22,920
!دَعونا نمرّ

38
00:03:27,060 --> 00:03:27,670
مَن أنتم؟

39
00:03:29,650 --> 00:03:31,540
.لا أعرف أحدًا منكم

40
00:03:31,800 --> 00:03:33,690
مِن أيّ مُقاطعةٍ أنتم؟
وتحت لواء مَن تُحاربون؟

41
00:03:33,690 --> 00:03:35,310
.نحن في خِدمة آيزو

42
00:03:35,570 --> 00:03:37,570
.نحن مِن رجال آيزو

43
00:03:37,570 --> 00:03:38,670
—كلا، لو تَسمح

44
00:03:38,670 --> 00:03:41,940
،كُفّ عن الجِدال وانصرفوا
.لن نفتح هذه البوّابة لأيّ كان

45
00:03:43,300 --> 00:03:46,370
أَتعلم لماذا يُطلقون عليها اسم
بوّابة هاماغوري، نسبةً لصدف المَحار؟

46
00:03:46,370 --> 00:03:46,760
.كلا

47
00:03:46,760 --> 00:03:50,960
لأنّها ظلّت مُوصدةً دومًا، باستثناء مرّةٍ
.واحدة إبّان حريق حقبة هويي العظيم

48
00:03:50,960 --> 00:03:53,960
:وكما يُقال
".لا يفتح المَحار فاه إلّا حين يحترق"

49
00:03:54,240 --> 00:03:57,590
وهذا كَفيلٌ بأن يُنبئك مدى
.إحكام إغلاق هذه البوّابة

50
00:03:57,860 --> 00:04:00,160
هل صِدقًا لا تنفتح البوّابة إلّا نادرًا؟

51
00:04:00,540 --> 00:04:02,510
.يبدو أنّ ثمّة سُوء فهمٍ قد حدث

52
00:04:02,760 --> 00:04:06,970
أَصدر لُورد آيزو تعليماتٍ رسميّة بأن
.نُرابط للحِراسة داخل أروقة القصر

53
00:04:07,360 --> 00:04:08,980
ماذا قُلت؟

54
00:04:10,740 --> 00:04:11,400
.توشي

55
00:04:12,800 --> 00:04:15,840
،نحن رجال ميبو روشيغومي
!نعمل تحت رعاية مُقاطعة آيزو

56
00:04:16,050 --> 00:04:18,840
هل ثمّة مَن يرغب في
...التحدّث بمَنطقٍ ورَويّة

57
00:04:18,840 --> 00:04:20,370
!أَمسك عليك لِسانك

58
00:04:20,370 --> 00:04:22,620
،واغرب عن وجهي
.هيّا، انصرف

59
00:04:22,890 --> 00:04:24,210
.تنحّ جانبًا يا هاسوموكاي

60
00:04:25,360 --> 00:04:28,360
،دَعكم مِن هذا الأحمق
.وتقدّموا للعُبور فحسب

61
00:04:34,400 --> 00:04:35,360
.هكذا تبدّدت الخُطّة إذن

62
00:04:35,360 --> 00:04:36,160
هل أنت أبله؟

63
00:04:36,910 --> 00:04:38,740
،حسنًا، لا بأس
.سنَعود في وقتٍ لاحق

64
00:04:39,380 --> 00:04:40,080
.مهلًا

65
00:04:41,290 --> 00:04:45,240
،لا مجال للأخطاء هُنا
.أنا أتفهّم مَوقفهم

66
00:04:49,370 --> 00:04:50,530
نرحل بكُلّ بساطةٍ؟

67
00:04:49,400 --> 00:04:52,120
.لم يكن هذا الاتّفاق

68
00:04:50,540 --> 00:04:52,090
بعد كُلّ هذا العناء نعود أدراجنا؟

69
00:04:52,120 --> 00:04:53,480
.يا لها مِن خيبةٍ بعد طُول مَسيرٍ

70
00:04:54,520 --> 00:04:57,730
!كلا، يا سيّد كوندو

71
00:05:07,550 --> 00:05:09,490
.أخطأتم الطّريقة

72
00:05:10,800 --> 00:05:13,680
.سيريزاوا-سان

73
00:05:14,490 --> 00:05:15,500
—سير

74
00:05:15,500 --> 00:05:17,000
!سيريزاوا-سينسي

75
00:05:18,080 --> 00:05:19,250
ماذا عن قَرار عزل نفسك؟

76
00:05:20,540 --> 00:05:21,800
.أَنهيته

77
00:05:21,970 --> 00:05:23,070
هكذا ببساطةٍ؟

78
00:05:25,010 --> 00:05:26,320
.راقب فحسب

79
00:05:29,990 --> 00:05:33,360
مَن تُراك تكون يا هذا؟
!لا تقترب أكثر

80
00:05:36,600 --> 00:05:37,860
!تبًا لك

81
00:05:40,550 --> 00:05:41,860
ماذا؟

82
00:05:42,850 --> 00:05:44,860
تُصوّبون رِماحكم نحوي؟

83
00:05:44,860 --> 00:05:46,320
مـ-مروحةٌ؟

84
00:05:46,860 --> 00:05:53,410
إذن، لا مَناص مِن أن نستلّ سُيوفنا نحن
.أيضًا، لكن تذكّروا، أنتم مَن بدأ بالتّهديد

85
00:05:55,090 --> 00:05:58,380
.سنَسحق كُلّ فردٍ منكم حتّى آخركم

86
00:05:59,600 --> 00:06:03,050
.لكنّنا نحظى بحِماية آيزو

87
00:06:03,050 --> 00:06:06,240
فإذا شَهرتم سُيوفكم ضدّنا
،أمام بوّابة القصر

88
00:06:06,520 --> 00:06:09,010
فهَل يعني هذا أنّ آيزو قد
أعلنت التمرّد على الإمبراطور؟

89
00:06:10,130 --> 00:06:11,470
—ماذا

90
00:06:11,470 --> 00:06:13,130
!أيّها الأبله

91
00:06:13,130 --> 00:06:17,110
!أَلا تُميّز بين الصّديق والعدوّ؟

92
00:06:17,110 --> 00:06:20,120
أَترغب في وَصم سيّدك بالخِيانة؟

93
00:06:20,120 --> 00:06:22,930
هل تزعم حقًا أنّك تذود عن الوطن؟

94
00:06:22,930 --> 00:06:24,700
!أَفق مِن غفلتك

95
00:06:27,590 --> 00:06:28,740
.ودَعنا نمرّ

96
00:06:33,780 --> 00:06:35,290
.بات جَليًا مَن هُو الأكثر دهاءً وحِيلةً

97
00:06:36,440 --> 00:06:38,250
!دعـ-دعوهم يمرّون

98
00:06:45,010 --> 00:06:46,100
...مَحار هاماغوري

99
00:06:46,100 --> 00:06:52,490
سيّد كوندو، لا ريب أنّ أُولئك الرّعاع
.كانوا يترقّبون وصول رجال المِيبورو

100
00:06:53,510 --> 00:06:56,640
.أرادوا استعراض قُوّتهم عليك

101
00:06:54,940 --> 00:06:59,470
،ذلك الرّجل عملاقٌ
.وأنا لا أطيق رُؤيته

102
00:06:56,640 --> 00:07:00,020
ممّا لا شكّ فيه أنّهم أدركوا أنّ
.مُهمّتك تعلو على مُهمّتهم شأنًا

103
00:07:02,200 --> 00:07:05,550
،إن كُنت مُوقنًا بأنّك على حقٍ
.فلا تتوان لأجل أحدٍ

104
00:07:06,010 --> 00:07:12,790
فأَقلّ ما يلزم القائد الحِفاظ
.على سلامة رجاله

105
00:07:14,990 --> 00:07:18,010
،عاد سيريزاوا-سينسي
!ويا لها مِن عودةٍ مَهيبة

106
00:07:18,010 --> 00:07:20,140
.هكذا يكون فِعل السّاموراي الحقيقيّ

107
00:07:20,140 --> 00:07:22,660
ماذا كان سيَحلّ بالمِيبورو لولاك؟

108
00:07:24,130 --> 00:07:25,540
.لن أَحيد بكُم عن الحقّ

109
00:07:25,540 --> 00:07:29,970
!إنّك مَلاذنا الأسمى

110
00:07:27,380 --> 00:07:28,680
!أنت المُختار بيننا

111
00:07:28,680 --> 00:07:29,960
أَليس رجلًا فذًا؟

112
00:07:28,860 --> 00:07:29,970
.إنّ تصرّفاته لا تُصدّق

113
00:07:31,030 --> 00:07:33,080
،قُلت ما كان يجب عليّ قَوله

114
00:07:35,080 --> 00:07:36,320
.وهذا يكفي

115
00:07:37,990 --> 00:07:42,710
:عُرفت تلك الاضطرابات لاحقًا بما يُسمّى
".انقلاب الثّامن عشر مِن الشّهر الثّامن"

116
00:07:43,680 --> 00:07:46,560
وعلى الرّغم مِن خُلوّها
،مِن معارك طاحنةٍ

117
00:07:46,870 --> 00:07:51,560
،إلّا أنّ تبعاتها تجلّت بطُرقٍ غير مُتوقّعةٍ
.حتّى في أوساط رجال المِيبورو

118
00:07:59,720 --> 00:08:01,000
!هاسوموكاي

119
00:08:02,030 --> 00:08:03,130
.سأُبارزك

120
00:08:08,320 --> 00:08:10,320
.معذرةً، التبس عليّ الأمر

121
00:08:13,280 --> 00:08:14,690
!حسنًا يا هاسوموكاي

122
00:08:15,150 --> 00:08:18,220
،لنَخرج في جولةٍ تفقديّة
.إنّها مهمّةٌ جَسيمة

123
00:08:19,210 --> 00:08:20,020
ما بالك؟

124
00:08:20,790 --> 00:08:21,560
.لا شيء

125
00:08:22,160 --> 00:08:25,740
كُل ما هُنالك أنّ هاسوموكاي-سان
.لا يبدو على سجيّته مُؤخّرًا

126
00:08:28,640 --> 00:08:30,560
...في الحَقيقة

127
00:08:31,650 --> 00:08:34,520
أنا ساموراي مِن تشوشو
.تسلّلت إلى صُفوف المِيبورو

128
00:08:35,800 --> 00:08:40,050
قَلب النّزاع في القصر مَوازين
،القُوى بين عشيّةٍ وضُحاها

129
00:08:41,080 --> 00:08:45,720
وغادر جميع رفاقي مِن تشوشو
.مدينة كيوتو

130
00:08:47,700 --> 00:08:50,090
...إن انكشف أَمري

131
00:08:50,420 --> 00:08:52,220
،معذرةً يا صاح

132
00:08:52,480 --> 00:08:55,180
،آسفٌ لتعطيلك
.فقد أصابني إسهالٌ مُفاجئ

133
00:08:55,320 --> 00:08:56,820
.كلا، لا بأس بذلك

134
00:09:00,000 --> 00:09:03,760
هل هذا مقرّ إقامة لُورد تشوشو؟
.يبدو مهجورًا تمامًا

135
00:09:04,160 --> 00:09:05,710
.لكن هذا منطقيٌّ

136
00:09:06,140 --> 00:09:09,320
يُقال إنّه كان يُخطّط لاختطاف
.الإمبراطور والقيام بأعمالٍ شنيعة

137
00:09:09,900 --> 00:09:14,200
كلا! أردنا أن يتقدّمنا جلالة
.الإمبراطور لدحر البَرابرة

138
00:09:15,610 --> 00:09:18,910
،نُصرةً لـ تشوشو
.ولأجل اليابان بأسرها

139
00:09:20,030 --> 00:09:22,530
استأصلوهم مِن جُذورهم
.وعلّقوهم على المَشانق

140
00:09:25,260 --> 00:09:28,280
نال رجال المِيبورو مديحًا
.لما قدّموه في القصر

141
00:09:28,510 --> 00:09:31,540
وهُم مُندفعون الآن بحماسٍ
.لتعقّب مَن تبقّى مِن تشوشو

142
00:09:31,550 --> 00:09:32,670
.تفضّل بالدّخول

143
00:09:34,360 --> 00:09:37,640
شينباتشي لا يقضي وقته
.معي مُؤخّرًا، كما تعلم

144
00:09:37,640 --> 00:09:38,380
ماذا؟

145
00:09:38,660 --> 00:09:41,130
حتّى رجالي لا يأخذونني
.على مَحمل الجِدّ

146
00:09:41,130 --> 00:09:42,480
.ناولني ذلك الحساء

147
00:09:42,950 --> 00:09:44,040
.بالتّأكيد

148
00:09:44,450 --> 00:09:47,760
لكن يتعيّن علينا اعتقال أُولئك
.المُتطرّفين مِن تشوشو

149
00:09:47,760 --> 00:09:49,710
.لا يُمكنني ترك الأشرار طُلقاء

150
00:09:50,140 --> 00:09:52,950
،رئيسي ذُو قلبٍ رَحيم
،يصبو للصّحبة

151
00:09:53,280 --> 00:09:55,440
،لكنّه متى عَقد العَزم
.اندفع نحو ما يُريد بتهوّرٍ

152
00:09:56,360 --> 00:09:59,950
سيَكون أوّل مَن يستبيح دَمي
.إن انكشف سِرّي

153
00:10:02,220 --> 00:10:03,070
!سُحقًا

154
00:10:03,070 --> 00:10:04,000
!أفلت مِن بين أيدينا

155
00:10:04,000 --> 00:10:05,190
أين تَوارى؟

156
00:10:05,190 --> 00:10:06,200
!تعقبّوا أثره

157
00:10:06,350 --> 00:10:09,760
!إذا وجدتموه، يُمكنكم قتله
.والمُكافأة ستَكون مِن نصيبكم

158
00:10:09,920 --> 00:10:10,710
.أمرك يا سيّدي

159
00:10:11,200 --> 00:10:13,150
،هاسوموكاي
!اذهب أنت مِن ذلك الاتّجاه

160
00:10:13,150 --> 00:10:13,840
.أجل يا سيّدي

161
00:10:14,780 --> 00:10:18,000
،يا لسُخرية القَدر
.محالٌ أن أجد أحدًا

162
00:10:21,880 --> 00:10:24,110
.أرجو أن لا يكون هُناك أحدٌ بالدّاخل

163
00:10:29,190 --> 00:10:31,000
.لا تصرخ أيّها الأبله

164
00:10:31,000 --> 00:10:33,360
أَمسكت به؟

165
00:10:35,450 --> 00:10:36,980
.أحسنت صُنعًا

166
00:10:36,980 --> 00:10:38,210
!الآن... اقتله

167
00:10:38,210 --> 00:10:39,440
!اشفِ غليلك منه

168
00:10:39,440 --> 00:10:41,750
!نَل مِنه! نَل مِنه

169
00:10:41,750 --> 00:10:45,800
!هيّا أجهز عليه، أسرع

170
00:10:44,740 --> 00:10:46,220
.هذا الرّجل ليس إلّا أنا

171
00:10:46,920 --> 00:10:51,730
،لو آثرت البقاء في كيوتو مُناصرًا لـ تشوشو
.لرُبّما كُنت مكانه في هذه اللّحظة

172
00:10:53,880 --> 00:10:54,730
.افعلها

173
00:10:57,980 --> 00:10:58,990
...إنّه أنت

174
00:11:00,360 --> 00:11:01,060
.اغفر لي

175
00:11:04,460 --> 00:11:05,600
لم أُصِبه؟

176
00:11:12,360 --> 00:11:14,670
ما كُنت لأَتخيّل مصيرًا
.أكثر بُؤسًا مِن هذا

177
00:11:25,350 --> 00:11:28,010
أَبليت بلاءً حسنًا بالأمس
.يا هاسوموكاي

178
00:11:28,660 --> 00:11:29,840
.أنا آسفٌ

179
00:11:30,430 --> 00:11:32,090
.هوّن عليك

180
00:11:32,090 --> 00:11:35,120
،سأُكافئك بوجبة سوبا
ناولني حساءك فحسب، اتّفقنا؟

181
00:11:37,270 --> 00:11:39,880
لماذا يخصّني بتعامله اللّطيف
دُون غيري؟

182
00:11:41,210 --> 00:11:43,290
.سأَبوح له بكُلّ ما يَختلج في صدري

183
00:11:43,740 --> 00:11:44,860
.سأَستجمع شجاعتي

184
00:11:51,240 --> 00:11:55,720
،أنا واثقٌ أنّه سيَتفهّمني
.ولا بأس إن كان في ذلك هلاكي

185
00:12:04,160 --> 00:12:08,320
أسرفت في تناول الحساء
.حتّى اعتصر المَغص أحشائي

186
00:12:08,320 --> 00:12:09,410
!هارادا-سان

187
00:12:09,760 --> 00:12:12,160
.نيو، وهاياشي أيضًا

188
00:12:14,520 --> 00:12:15,840
أين هاسوموكاي-سان؟

189
00:12:15,840 --> 00:12:17,800
.ماذا؟ إنّه بمَقربةٍ مِن هُنا

190
00:12:17,800 --> 00:12:19,420
—كُنت معه مُنذ بُرهةٍ

191
00:12:20,080 --> 00:12:23,040
نحن نظنّ أنّ سيريزاوا-سان
.يبحث عن هاسوموكاي-سان

192
00:12:23,940 --> 00:12:25,070
سيريزاوا؟

193
00:12:30,850 --> 00:12:31,600
!هاسوموكاي

194
00:12:35,740 --> 00:12:36,640
!هاسوموكاي

195
00:12:36,840 --> 00:12:39,490
!اصمد

196
00:12:41,120 --> 00:12:42,730
.يا لي مِن أحمق

197
00:12:42,870 --> 00:12:45,960
!إنّه أنا، افتح عَينيك

198
00:12:43,540 --> 00:12:49,240
،هؤلاء الرّجال لا يتنازعون بشأن مَصير الدّولة
.ولا هُم يخوضون الحُروب مِن أجل ديارهم

199
00:12:46,930 --> 00:12:49,000
.أنصت إليّ

200
00:12:49,600 --> 00:12:51,820
!هاسوموكاي! تنفّس

201
00:12:49,600 --> 00:12:51,830
.إنّهم لا يُلقون بالًا لهيئتهم

202
00:12:52,330 --> 00:12:56,000
،ثيابهم دَنسةٌ، رائحتهم كريهةٌ
.وطريقتهم في الأكل تنقصها اللّباقة

203
00:12:52,680 --> 00:12:56,000
!هاسوموكاي! هاسوموكاي

204
00:12:56,500 --> 00:12:58,870
!هاسوموكاي

205
00:12:56,510 --> 00:12:58,310
.جُلّ همّهم التدرّب على استخدام السّيوف

206
00:12:59,810 --> 00:13:03,230
!اصمد! هاسوموكاي

207
00:12:59,820 --> 00:13:03,230
لكنّي أدركت السّبب الّذي
.حال دُون فِراري

208
00:13:04,420 --> 00:13:05,150
...أَعني

209
00:13:07,200 --> 00:13:10,300
أنّها لم تكن حياةً سيّئةً
.على أيّ حالٍ

210
00:13:12,310 --> 00:13:16,380
إذًا أصبحتُ خائنًا للعهد الآن؟
وهل يُوجد جاسوسٌ أشدّ إخفاقًا منّي؟

211
00:13:17,400 --> 00:13:19,530
،أنت... أجل أنت
.أيّها الفتى

212
00:13:19,680 --> 00:13:22,100
.تبدو عليك سِمات الطّيبة

213
00:13:22,100 --> 00:13:25,780
والآن، يا فتى، تسلّل إلى
.صُفوفهم وتقصّ خبرهم

214
00:13:26,290 --> 00:13:30,290
أيّها الفتى، أَلا يُمكنك العُثور
على ما هُو أكثر نفعًا؟

215
00:13:28,020 --> 00:13:29,760
،أَبدى اهتمامًا بي

216
00:13:30,280 --> 00:13:33,880
لكن يبدو أنّه لم يكترث
.يومًا لمَعرفة اسمي

217
00:13:35,230 --> 00:13:37,550
!هاسوموكاي! هاسوموكاي

218
00:13:38,140 --> 00:13:40,020
هل ترغب في ترك رسالةٍ لذَويك؟

219
00:13:43,790 --> 00:13:44,700
ما هي؟

220
00:13:45,950 --> 00:13:47,300
.لا أستطيع سَماعك

221
00:13:47,960 --> 00:13:50,050
هل أنت متيقّنٌ أنّك لم تعلم
بسِرّي طِيلة تلك المُدّة؟

222
00:13:51,130 --> 00:13:54,730
،كُنت تعلم
.وتنتظر أن أبوح لك بالحقيقة

223
00:13:56,970 --> 00:13:59,810
.شُكرًا لك، هارادا-سان

224
00:14:05,440 --> 00:14:06,370
!هارادا-سان

225
00:14:07,060 --> 00:14:10,240
عثرنا على وثائق هامّةٍ بين
.مُقتنيات هاسوموكاي-سان

226
00:14:11,210 --> 00:14:13,200
.يبدو أنّه كان جاسوسًا لـ تشوشو

227
00:14:14,750 --> 00:14:15,950
.لا يهمّ ذلك

228
00:14:16,390 --> 00:14:17,500
.لكنّه كان خائنًا

229
00:14:17,500 --> 00:14:18,450
،كلا

230
00:14:19,460 --> 00:14:23,550
...سعى ليَكون واحدًا منّا، ونحن

231
00:14:24,780 --> 00:14:25,660
.هارادا-سان

232
00:14:35,890 --> 00:14:38,720
أردت التحدّث معي على
انفرادٍ، نيمي-سان؟

233
00:14:42,490 --> 00:14:44,480
.دَعني أضع خاتمةً لـ سيريزاوا

234
00:14:45,770 --> 00:14:47,980
.سنَقوم بتسوية الأمر بيننا

235
00:14:48,370 --> 00:14:52,370
كلامك يُوحي وكأنّنا على وشك
.فِقدانكما أنتما الاثنين

236
00:14:54,720 --> 00:14:55,800
...إن سَمحت لي

237
00:14:56,240 --> 00:15:01,120
نيمي-سان، ما طبيعة علاقتك
بـ سيريزاوا-سان تحديدًا؟

238
00:15:01,970 --> 00:15:03,640
.كُنا جِيرانًا

239
00:15:05,500 --> 00:15:06,450
فحسب؟

240
00:15:06,760 --> 00:15:07,750
.أجل

241
00:15:11,240 --> 00:15:14,180
،يامانامي
.أُريدك أن تحتفظ بهذه

242
00:15:15,910 --> 00:15:16,670
.إنّها نُظمنا

243
00:15:17,730 --> 00:15:18,540
نُظمنا؟

244
00:15:19,320 --> 00:15:21,650
،صُفوفنا في نُموّ مُستمرّ

245
00:15:22,190 --> 00:15:25,340
والمُنتسبون الجُدد سيَبدّدون
.تماسك تنظيمنا

246
00:15:26,140 --> 00:15:31,740
إنّ الرّعاع الّذين لا تحكمهم قوانين
.واضحةٌ لا يُمكنهم مُجابهة شُرور كيوتو

247
00:15:32,480 --> 00:15:37,040
،دَوّنت كُلّ ما خطر ببالي
.لكنّها لا تزال مُسوّدةً أوليّة

248
00:15:37,950 --> 00:15:40,920
.يامانامي، أُريد منك إتمامها

249
00:15:46,480 --> 00:15:47,560
.نيمي-سان

250
00:15:50,290 --> 00:15:52,250
كان سيريزاوا يقطن في
.الدّار المُجاورة

251
00:15:52,780 --> 00:15:55,000
.وهذا كُلّ ما جمعنا بالفعل

252
00:15:56,150 --> 00:16:00,660
كان هُو الابن الرّابع لسّاموراي، بينما كُنت
.أنا سليل جُنديّ بسيطٍ مِن أدنى المَراتب

253
00:16:01,130 --> 00:16:05,290
لكن التَفاوت في مكانتنا
.لم يكن يعني له شيئًا

254
00:16:05,560 --> 00:16:07,200
!إيوري

255
00:16:07,200 --> 00:16:09,980
،تسوجوجي
ماذا حلّ بوجهك؟

256
00:16:09,980 --> 00:16:14,020
أبرحني أبي ضربًا! كُلّ ما فعلته
!أنّني كسرت مِزهريّته المُفضّلة

257
00:16:14,020 --> 00:16:15,870
!هيّا نتحالف ونُلقّنه درسًا

258
00:16:16,000 --> 00:16:20,000
.كيف؟ والدك ضَخم البِنية

259
00:16:20,360 --> 00:16:23,160
حاول إخوتي الثّلاثة
!الكِبار فِعل ذلك

260
00:16:23,160 --> 00:16:25,600
وقد أُوسعوا ضربًا
.حتّى ازرقّت جُلودهم

261
00:16:25,600 --> 00:16:26,960
.سيَقتلك في المرّة القادمة

262
00:16:30,050 --> 00:16:31,380
،أظنّ أن لا جدوى مِن المُحاولة
أَليس كذلك؟

263
00:16:33,380 --> 00:16:34,480
.سنَنصب له كمينًا

264
00:16:34,760 --> 00:16:35,670
!كمينًا؟

265
00:16:36,160 --> 00:16:37,490
.باستخدام حُفرةٍ مُزدوجة

266
00:16:37,490 --> 00:16:38,480
مُزدوجة؟

267
00:16:42,270 --> 00:16:43,940
.سيَمرّ مِن هُنا في أيّ لحظةٍ

268
00:16:54,840 --> 00:16:56,000
!سقط فيها

269
00:16:56,000 --> 00:16:56,730
!نِلنا منه

270
00:16:58,300 --> 00:16:59,570
!هَوت الطّبقة الثّانية

271
00:16:59,800 --> 00:17:01,310
!هيّا بنا

272
00:17:01,310 --> 00:17:03,210
،ضع سلّةً على رأسك
!وإلّا سيَتعرّف عليك

273
00:17:05,240 --> 00:17:07,670
مَن أنتما؟
هل هذا أنت يا تسوجوجي؟

274
00:17:08,930 --> 00:17:10,010
!كشف أمرنا

275
00:17:10,010 --> 00:17:10,800
!لُذ بالفِرار

276
00:17:12,000 --> 00:17:14,260
!ستَدفعان ثمن فِعلتكما هذه

277
00:17:17,390 --> 00:17:20,010
!ها نحن ذا
.لقنّاه درسًا لن ينساه

278
00:17:20,430 --> 00:17:21,970
!كان ذلك مُريحًا للغاية

279
00:17:22,570 --> 00:17:24,190
.يلزمنا أن نتحسّب لردّه الانتقاميّ

280
00:17:24,530 --> 00:17:27,650
،بقُوّتي وذكائك
.لا يُمكن لأحدٍ رَدعنا

281
00:17:28,280 --> 00:17:30,790
.سنَستهدف دار الاجتماعات تاليًا

282
00:17:30,790 --> 00:17:34,150
دار الاجتماعات؟
.هُناك كلبٌ شرس

283
00:17:34,390 --> 00:17:35,490
ما الخُطّة؟

284
00:17:35,490 --> 00:17:38,700
...دَعني أُفكّر، أولًا

285
00:17:43,480 --> 00:17:47,560
نيمي، أين البقيّة؟

286
00:17:47,560 --> 00:17:49,160
وماذا حَلّ بالاحتفال؟

287
00:17:49,160 --> 00:17:52,150
،لن يُقام احتفالٌ
.أنت الضّيف الوحيد

288
00:17:52,740 --> 00:17:53,710
حقًا؟

289
00:17:53,980 --> 00:17:58,470
كم مضى مِن الزّمن مُنذ أن تواجهنا
وجهًا لوجهٍ هكذا، يا تسوجوجي؟

290
00:17:58,800 --> 00:17:59,770
—تسوجـ

291
00:18:01,890 --> 00:18:06,350
لم يُنادني أحدٌ بهذا الاسم
.مُنذ أمدٍ بعيد يا إيوري

292
00:18:06,800 --> 00:18:13,110
أَخليت هذا المكان لتَنفرد بي؟
.لا جرم أنّك دقيقٌ للغاية

293
00:18:13,840 --> 00:18:15,600
.لنَضع خاتمةً لهذا كُلّه

294
00:18:18,680 --> 00:18:22,710
،سِجلّات التعدّيات على التّجار والأثرياء
.وعمليات التّصفية الدّاخلية

295
00:18:22,960 --> 00:18:27,280
نتائج التّحقيق في خمس جرائم
.قتلٍ، وخمس حالات اختفاءٍ

296
00:18:27,970 --> 00:18:30,320
إنّني أرتاب في أنّ لك
.يدًا فيها جميعًا

297
00:18:31,570 --> 00:18:35,630
أَفضيت بما لديك، وسيَستقيم
.حال رجال المِيبورو بعد رحيلك

298
00:18:38,780 --> 00:18:45,230
على مَهلك... كان يجدر بك أن تعلم
.أنّه لا ينبغي إحضار سيفٍ إلى مَحفلٍ

299
00:18:47,570 --> 00:18:48,490
.سَلّم بالواقع

300
00:18:49,780 --> 00:18:51,630
.انقضى دَورنا

301
00:18:53,600 --> 00:18:55,280
ماذا تَنوي فِعله؟

302
00:18:56,600 --> 00:18:57,940
.سأَقتفي أثرك خُطوةً بخُطوةٍ

303
00:19:02,720 --> 00:19:04,630
.إنّ مَسار الأرواح لولبيّ

304
00:19:05,280 --> 00:19:09,760
يموت البَشر ثُمّ يُبعثون رُضّعًا
.مِن جديدٍ، وهكذا تدور الدّائرة

305
00:19:10,220 --> 00:19:14,790
،لكَم أودّ لو أَقضي ذات الزّمن
.وأُعيد عيشه مرّةً تلو الأُخرى إلى الأبد

306
00:19:15,190 --> 00:19:16,790
عمّ تَهذي؟

307
00:19:17,760 --> 00:19:19,040
.عن رُؤيتي للحياة والمَوت

308
00:19:19,320 --> 00:19:22,450
،لا تكن ساذجًا
.ليس للمرء إلّا حياةٌ واحدة

309
00:19:22,450 --> 00:19:25,000
لهذا السّبب فَعلتُ ما يهواه
.خاطري فحسب

310
00:19:25,530 --> 00:19:27,400
هل تَنوي وضع خاتمةٍ لهذا كُلّه؟

311
00:19:29,070 --> 00:19:30,150
.لكَ ذلك

312
00:19:31,520 --> 00:19:32,900
...ولكن

313
00:19:33,550 --> 00:19:36,020
،إيوري
.ستَضع خاتمةً لك وحدك

314
00:19:36,380 --> 00:19:39,750
هل حَسبت أنّ استمالة
العواطف ستُؤثّر فيّ؟

315
00:19:39,750 --> 00:19:43,790
،هذا ما يجعلك ساذجًا
.وذلك مكمن ضَعفك

316
00:19:44,030 --> 00:19:47,740
،إيوري
.ستَؤدي طقس السّيبوكو هُنا

317
00:19:47,740 --> 00:19:52,080
لن أعجز عن قتلك ثُمّ إخراج
.المَشهد ليَبدو كأنّك انتحرت

318
00:19:55,120 --> 00:19:56,920
عَلام تبتسم؟

319
00:19:57,720 --> 00:19:59,510
،كانت تلك أيّامًا طيّبة

320
00:20:00,720 --> 00:20:03,920
.حيث كان كُلّ شيءٍ بسيطًا وواضحًا

321
00:20:05,200 --> 00:20:07,400
.ولكن، رُويدًا رُويدًا، كَبُرنا

322
00:20:07,660 --> 00:20:11,170
،فتَبدّلت الأماكن، وتغيّر النّاس
،بل وانقلب الزّمان أيضًا

323
00:20:11,620 --> 00:20:13,020
.فغَدت الحياة شائكةً

324
00:20:14,220 --> 00:20:15,370
.هيّا إذن، افعلها

325
00:20:15,810 --> 00:20:17,640
ترغب في إخراج المَشهد كأنّه انتحارٌ؟

326
00:20:18,310 --> 00:20:20,400
،إنّ رجالي بارعون في التحرّي

327
00:20:20,790 --> 00:20:22,860
.وسيَكشفون زيف خدعتك

328
00:20:23,680 --> 00:20:27,400
لن تتغاضى مجموعة كوندو
.عن مقتل قائدٍ

329
00:20:27,890 --> 00:20:30,160
.سيُهدرون دمك لا محالة

330
00:20:30,160 --> 00:20:32,900
!إيوري! تبًا لك

331
00:20:33,330 --> 00:20:36,540
أَليست هذه الطّريقة أكثر إثارةً؟

332
00:20:37,450 --> 00:20:38,540
عمّ تتحدّث؟

333
00:20:38,730 --> 00:20:42,780
،إذا كان لا بُدّ لـ سيريزاوا كامو أن يموت
أَلا يُفضّل أن يموت وسط مَعمعة القتال؟

334
00:20:43,300 --> 00:20:46,810
لا أَحسبك ترضى برصاصةٍ غادرة
تُرديك كأيّ نكرةٍ، أَليس كذلك؟

335
00:20:47,310 --> 00:20:52,060
أمّا المرض؟ أو وَهن الشّيخوخة؟
.فتَلك خياراتٌ مُستبعدة تمامًا

336
00:20:53,430 --> 00:20:58,250
أَلم نكن نستمتع دومًا
بأن نسبق الآخرين بخُطوةٍ؟

337
00:21:06,960 --> 00:21:08,050
.هات ما عِندك، أنا أنصت

338
00:21:08,320 --> 00:21:10,800
...دَعني أُفكّر، أولًا

339
00:21:33,530 --> 00:21:35,560
!نيو

340
00:21:36,300 --> 00:21:37,140
هاياشي-سان؟

341
00:21:37,840 --> 00:21:40,020
...مـ-معذرةً

342
00:21:40,430 --> 00:21:41,980
إلى أين نَهرع هكذا؟

343
00:21:42,300 --> 00:21:43,320
.إنّه نيمي-سان

344
00:21:44,530 --> 00:21:45,480
.لقد أَنهى حياته بيَده

345
00:23:21,640 --> 00:23:23,110
.هيجيكاتا توشيزو يُحدّثكم

346
00:23:24,020 --> 00:23:25,560
.أَقدم نيمي على طقس السّيبوكو

347
00:23:26,470 --> 00:23:29,610
،لست أعلم ما الّذي دفعه لذلك
،أو ماذا كان يَدور في خلده

348
00:23:30,320 --> 00:23:33,590
لكن هويّة مَن له يدٌ في الأمر
.جَليّةٌ للجميع

349
00:23:34,360 --> 00:23:35,720
،سأَضع حدًا لهذا

350
00:23:36,010 --> 00:23:37,630
.فلا مَجال للتّراجع بعد الآن

351
00:23:42,960 --> 00:23:44,530
.سنَحسم خِلافنا مع سيريزاوا نهائيًا

352
00:23:45,990 --> 00:23:48,220
:الحلقة القادمة
."قريبٌ... ولكن بعيدٌ"