1
00:00:02,550 --> 00:00:04,170
!ها هُما المُعِينان قد حضرا

2
00:00:06,040 --> 00:00:08,060
!لا تقتلوهم، لا تستلّوا سُيوفكم

3
00:00:08,510 --> 00:00:10,940
،قول ذلك أهون مِن فِعله
.فهم لا ينوون التّراجع

4
00:00:11,480 --> 00:00:13,450
!تارو، أين أنت؟ أجبني

5
00:00:19,680 --> 00:00:21,080
.تـ-توقّفوا

6
00:00:21,400 --> 00:00:22,580
.سيقضون علينا جميعًا

7
00:00:35,250 --> 00:00:36,760
!سيّد كوندو

8
00:00:37,590 --> 00:00:38,920
...هلّا كففت عن هذا

9
00:00:39,840 --> 00:00:40,730
.يا سيريزاوا-سان

10
00:00:43,710 --> 00:00:44,390
.مِن هُنا

11
00:00:44,820 --> 00:00:45,400
.نيو

12
00:00:45,400 --> 00:00:48,810
!أَتبتغي الوقوف في وجهي يا كوندو؟

13
00:00:54,270 --> 00:00:56,070
!أَتريد مُنازلتي؟

14
00:01:11,280 --> 00:01:14,590
!كُفّوا عن استخدام أسلحتكم جميعًا

15
00:01:16,640 --> 00:01:17,560
.قُضي الأمر

16
00:01:20,030 --> 00:01:23,720
أَتظنّ أنّنا سننسحب ببساطةٍ؟
!صُرِع ثُلّةٌ مِن رجالنا هُنا

17
00:01:24,150 --> 00:01:25,860
.أجل، يُؤسفني حقًا وُقوع ذلك

18
00:01:25,860 --> 00:01:26,770
...أنت

19
00:01:27,640 --> 00:01:30,170
،لن يشفي أسفك غليلنا
!بل ستنالون ما هُو أَمرّ

20
00:01:30,170 --> 00:01:32,400
هل مِن بينكم قائدٌ؟

21
00:01:32,630 --> 00:01:35,880
!أيّ شخصٍ سيَفي بالغرض
مَن هو الأعلى رُتبةً بينكم؟

22
00:01:38,700 --> 00:01:40,920
.ألا مِن مجيبٌ؟ فهمت

23
00:01:42,920 --> 00:01:46,600
سأحمل أنا تبعات هذا النّزاع
.أمام مكتب الحاكم

24
00:01:47,200 --> 00:01:49,680
كما أرغب منكم أن تُحضروا
.قائدكم أيضًا

25
00:01:50,040 --> 00:01:51,580
.لنَحسم الخُصومة هناك

26
00:01:55,880 --> 00:01:58,870
وإن لم يُرضكم ذلك
،وكُنتم تبغون نِزالًا

27
00:02:01,250 --> 00:02:04,080
.فأنا كوندو إيسامي سأكون خَصمكم

28
00:03:39,640 --> 00:03:40,370
.أشكركم

29
00:03:41,040 --> 00:03:42,850
!ابدأوا بعلاج الجَرحى

30
00:03:43,570 --> 00:03:44,860
.سواء كانوا رِفاقًا أم خُصومًا

31
00:03:45,430 --> 00:03:46,860
،مَن كان بمقدوره المُساعدة
!فليفعل

32
00:03:53,170 --> 00:03:54,540
.أفسد هذا الرّجل بهجة اللّحظة

33
00:03:56,200 --> 00:03:58,640
ماذا كان سيَحدث لو تمادوا
في طُغيانهم؟

34
00:03:59,640 --> 00:04:02,640
الوحيد القادر على كبح سيريزاوا
...إذا فقد زِمام نفسه

35
00:04:03,350 --> 00:04:06,510
.هو ذلك الرّجل، كوندو إيسامي

36
00:04:09,280 --> 00:04:11,360
.آخر ما نبتغيه هو النّزاع الدّاخلي

37
00:04:13,830 --> 00:04:15,290
.أربعة قتلى، فهمت

38
00:04:16,170 --> 00:04:19,620
كلا، بل خمسةٌ، إذا احتسبت
.الرّجل الأوّل الّذي أرداه صريعًا

39
00:04:20,400 --> 00:04:22,520
.سنُسلّم الجَثامين بكُلّ احترامٍ

40
00:04:22,960 --> 00:04:25,660
ولكن، أرغب أن يُفضي إليّ
.أحدكم بما جرى

41
00:04:30,720 --> 00:04:33,530
،في الواقع
...أنّ ما حدث كان كالتّالي

42
00:04:36,460 --> 00:04:37,140
.فهمت

43
00:04:38,040 --> 00:04:41,800
إذًا، نشب النّزاع في بدايته بسبب
.خلافٍ على مَن يفسح الطّريق للآخر

44
00:04:45,320 --> 00:04:46,220
ماذا؟

45
00:04:47,210 --> 00:04:48,410
.أَحطت بتفاصيل الوَاقعة

46
00:04:49,290 --> 00:04:51,310
.نيو، هيّا بنا إلى مكتب الحاكم

47
00:04:51,830 --> 00:04:53,280
.يامازاكي-كون، تقدّم لتُرشدنا

48
00:04:53,710 --> 00:04:54,310
.أمرك يا سيّدي

49
00:04:54,740 --> 00:04:59,540
سأبذل قُصارى جُهدي، ولكن كُن متأهّبًا
.لتحمّل التّبعات يا سيريزاوا-سان

50
00:05:00,130 --> 00:05:01,020
.لا مانع عندي

51
00:05:04,780 --> 00:05:06,990
ما عسى أن يكون مصير
سيريزاوا-سان في نظرك؟

52
00:05:06,990 --> 00:05:09,320
،لن ينجو بفعلته بلا عقابٍ
.هذا أمرٌ مقضيّ

53
00:05:16,540 --> 00:05:17,150
.نيو

54
00:05:18,530 --> 00:05:22,340
أُدرك أنّك ترغب في الانحياز
،للضّعفاء والمَظلومين

55
00:05:24,090 --> 00:05:26,840
.لكنّني سأقول الحقيقة

56
00:05:27,320 --> 00:05:29,760
.وللسّلطات حقّ تقرير ما سيَلي

57
00:05:31,220 --> 00:05:32,350
...أَنصت

58
00:05:32,350 --> 00:05:34,350
!مهلًا

59
00:05:36,000 --> 00:05:38,860
!ا-انتظروا! انتظروا لحظةً

60
00:05:39,530 --> 00:05:40,400
تارو-كون؟

61
00:05:43,200 --> 00:05:44,360
.لم تجرِ الأحداث على هذا النّحو

62
00:05:45,090 --> 00:05:46,610
ما الّذي حدث إذًا؟

63
00:05:46,610 --> 00:05:50,710
.هو لم يقتله لمُجرّد أنّه كان فظًا

64
00:05:54,600 --> 00:05:58,040
...مـ-معذرةً، لم أكن أنظر

65
00:06:03,160 --> 00:06:06,420
مَن يكون هذا الصّعلوك النّتن؟

66
00:06:06,910 --> 00:06:08,790
.رائحته تُشبه رائحة المَجاري

67
00:06:10,620 --> 00:06:12,930
.أقول إنّ رائحتك كريهةٌ

68
00:06:14,920 --> 00:06:15,980
.سيريزاوا-سينسي

69
00:06:15,980 --> 00:06:19,400
هل هذا الصّعلوك برفقتك؟

70
00:06:19,400 --> 00:06:22,400
،لا شكّ أنّه مُجرّد شحّاذٍ
أليس كذلك؟

71
00:06:22,680 --> 00:06:26,650
ما باله يتقلّد سيفًا
ويتشبّه بالسّاموراي؟

72
00:06:26,870 --> 00:06:31,690
،لديّ حاسّة شمٍ لا تُخطئ
.ولن تخدعني هذه الثّياب

73
00:06:31,690 --> 00:06:35,120
،هذا المَاثل أمامي ليس آدميًا
.بل حثالةٌ مِن النّفايات

74
00:06:35,440 --> 00:06:38,170
.مُجرّد عالةٍ لا نفع منها

75
00:06:44,100 --> 00:06:46,170
،حَماني سيريزاوا-سينسي

76
00:06:46,460 --> 00:06:48,670
.وصان لي كرامتي

77
00:06:48,670 --> 00:06:52,310
،لذا أرجوك يا كوندو-سان
!أَنقذ سيريزاوا-سينسي

78
00:06:53,120 --> 00:06:56,630
،لم أقوَ على البوح بذلك أمامه
.لكنّني أقوله الآن

79
00:06:57,640 --> 00:06:59,060
.هذا ما حدث إذًا

80
00:07:00,560 --> 00:07:01,360
.حسنًا

81
00:07:02,500 --> 00:07:05,650
،نشكرك لإخبارنا
.عُد أدراجك الآن وانتظر

82
00:07:09,010 --> 00:07:10,120
.هيّا بنا

83
00:07:10,120 --> 00:07:10,950
.بالتّأكيد

84
00:07:10,950 --> 00:07:13,150
،لا يُمكننا تغيير ما حدث

85
00:07:13,700 --> 00:07:15,580
.وليس أمامنا إلّا بذل ما في وُسعنا

86
00:07:15,800 --> 00:07:19,590
ولكن، مَن يدري إذا كان
الحُكم سيكون عادلًا؟

87
00:07:20,450 --> 00:07:21,750
ماذا تقصد بذلك؟

88
00:07:21,750 --> 00:07:23,800
...حاولت إخباركما آنفًا

89
00:07:23,800 --> 00:07:26,700
.أنّ المُحقّق هو أوتشيياما هيكوجيرو

90
00:07:28,140 --> 00:07:30,600
هل هو ذلك الرّجل الّذي سلّط
مُحصّلي الدّيون على والدك؟

91
00:07:32,080 --> 00:07:35,700
مَن يقتات على فرض سَطوته
...على أمثال هؤلاء الرّجال

92
00:07:36,200 --> 00:07:41,030
لا يسمح لدخيلٍ أن ينزع هَيبته
.في معقله

93
00:07:41,800 --> 00:07:44,830
لذا، رُبّما يفرض عُقوبةً قاسية
.على جماعة ميبو روشيغومي

94
00:07:45,200 --> 00:07:45,900
.نيو

95
00:07:47,090 --> 00:07:50,930
إلى أيّ مدىً يُمكن للإنسان أن
يَسبر أغوار قلب إنسانٍ آخر؟

96
00:07:52,430 --> 00:07:55,190
،لا أعلم
.لست مُتأكّدًا تمامًا

97
00:07:56,450 --> 00:08:00,670
لكنّي أرى أنّ معرفة الآخرين مستحيلةٌ
.ما لم نُحاول جاهدين التقرّب منهم

98
00:08:03,000 --> 00:08:03,660
.فهمت

99
00:08:11,480 --> 00:08:16,670
ما خطبك؟
ألا تملك اسمًا خاصًا بك؟

100
00:08:17,410 --> 00:08:20,040
.سأَمنحك اسمًا إذًا

101
00:08:21,560 --> 00:08:24,020
.تارو! تاناكا تارو

102
00:08:24,560 --> 00:08:26,940
.ليَكن هذا اسمك مُنذ هذه اللّحظة

103
00:08:32,520 --> 00:08:35,620
.خفّف مِن حِدّة ذُعرك يا أونوغاوا

104
00:08:35,620 --> 00:08:38,910
،أنت تملك مقرًا لتدريب السّومو
أليس كذلك؟

105
00:08:38,910 --> 00:08:40,660
.أ-أجل يا سيّدي

106
00:08:40,890 --> 00:08:45,710
،رُغم أنّني بلغت السّابعة والسّتين
.لا أزال أُحكم قبضتي على مكتب الحاكم

107
00:08:45,710 --> 00:08:51,670
أنا ذاك البّطل الّذي دَحر المُتمرّد
.سيّئ السّمعة، أوشيو هيهاتشيرو

108
00:08:52,200 --> 00:08:54,310
.هذا ما يعرفه النّاس عنّي

109
00:08:55,880 --> 00:09:02,930
لكن هوايتي الحقيقية هي الدّهس على
.الرّقاب الضّعيفة والتّنكيل بالبُؤساء

110
00:09:04,350 --> 00:09:05,820
...طبعًا، بالإضافة إلى

111
00:09:06,300 --> 00:09:10,040
.تحطيم كِبرياء هؤلاء السّاموراي الرّعاع

112
00:09:11,020 --> 00:09:13,440
كوندو إيسامي مِن جماعة
.ميبو روشيغومي

113
00:09:14,210 --> 00:09:15,490
هل أنت أوتشيياما؟

114
00:09:15,490 --> 00:09:16,410
.بشحمه ولحمه

115
00:09:17,000 --> 00:09:21,840
،أنا أوتشيياما هيكوجيرو
.أَعتى يوريكي في هذه الأنحاء

116
00:09:22,360 --> 00:09:24,820
.سأَفصل في قضيّتكم

117
00:09:25,200 --> 00:09:28,330
،كوندو
.أخبرني بما حدث بالضّبط

118
00:09:31,360 --> 00:09:34,280
،أساء أحد مُصارعيه الأدب معنا
.فأرديناه قتيلًا

119
00:09:34,850 --> 00:09:36,590
...أمّا العِراك الّذي تَبع ذلك

120
00:09:37,040 --> 00:09:40,480
فقد نشب حين طوّقوا نُزلنا
.ولم يتركوا لنا خيارًا آخر

121
00:09:40,860 --> 00:09:43,600
.لسنا مُلامين بأيّ حالٍ مِن الأحوال

122
00:09:44,840 --> 00:09:45,730
.هذا كُلّ ما عندي

123
00:09:45,730 --> 00:09:47,240
!هذا لا يُجدي نفعًا

124
00:09:47,240 --> 00:09:48,860
!طلبت منك سرد التّفاصيل

125
00:09:48,860 --> 00:09:50,920
.يبدو أنّك أخطأت فهمي

126
00:09:51,480 --> 00:09:53,830
.ما جئنا إلى هُنا إلّا لنُسلّمك الجَثامين

127
00:09:54,360 --> 00:09:57,840
فإن كُنت تعتقد أنّ الخطأ يقع على
،عاتقنا وتُلزمنا بتبعات ما جرى

128
00:09:59,010 --> 00:10:01,740
.فسَأبقُر بطني هُنا والآن

129
00:10:07,800 --> 00:10:09,880
مـ-من هؤلاء الرّجال؟

130
00:10:11,240 --> 00:10:15,960
أم ينبغي لي أن أصرعكما كليكما وأُلقي
باللّوم على بعض الخارجين عن القانون؟

131
00:10:18,760 --> 00:10:20,860
.لديّ أشياءٌ ألتزم بحمايتها

132
00:10:21,220 --> 00:10:24,820
،ولأجل صونها
.مستعدٌّ أن أغدو شيطانًا

133
00:10:25,820 --> 00:10:27,650
!مُجرمون
!استلّوا السّيوف أيّها الرّجال

134
00:10:32,640 --> 00:10:33,640
!لا تتحرّكوا

135
00:10:35,520 --> 00:10:37,520
.أَتبغون موتي؟ حسنًا

136
00:10:38,000 --> 00:10:38,780
...ولكن

137
00:10:39,180 --> 00:10:41,500
،إن قتلتموني
.فسينقضّ رِفاقي عليكم

138
00:10:41,500 --> 00:10:45,790
سيُهاجمون مكتب الحاكم هذا
.ويُحيلونه رمادًا في طرفة عينٍ

139
00:10:46,690 --> 00:10:48,310
.أفترض أنّ هذا لا يُزعجكم

140
00:10:54,540 --> 00:10:56,300
...نـ-نحن

141
00:10:57,160 --> 00:10:59,080
.نعتذر أشدّ الاعتذار عمّا جرى

142
00:11:01,350 --> 00:11:05,470
كفى، جماعة ميبو روشيغومي
.هُم المُنتصرون في هذه الجولة

143
00:11:07,060 --> 00:11:08,930
،لا ضَير في ذلك عندك
أليس كذلك يا أونوغاوا؟

144
00:11:08,930 --> 00:11:09,720
.أ-أجل يا سيّدي

145
00:11:11,380 --> 00:11:13,840
،سأعتبر القضيّة محسومةً
.ارحلوا

146
00:11:14,560 --> 00:11:16,020
.بعد إذنك

147
00:11:32,760 --> 00:11:34,680
،يا للهول
.بلغ بي التّوتر مَبلغه

148
00:11:35,200 --> 00:11:36,170
هل أنت على ما يُرام؟

149
00:11:36,540 --> 00:11:39,040
،أجل
.لكنّني لا أخلو مِن النّدم

150
00:11:40,040 --> 00:11:42,720
لم أبقَ مُخلصًا للكلمة
.الّتي أحملها على ظهري

151
00:11:46,040 --> 00:11:50,130
رُبّما لديك موهبةٌ فِطريّة
.في التّمثيل

152
00:11:50,610 --> 00:11:51,480
.لا تُذكّرني

153
00:11:52,270 --> 00:11:55,820
،لا أملك دهاء توشي
.ولا بلاغة يامانامي

154
00:11:56,350 --> 00:11:58,370
كُلّ ما فعلته هو أنّني
.ظللت أندفع للأمام

155
00:11:59,180 --> 00:12:01,910
،كان نهجًا غير لائقٍ
.وأنا خَجلٌ منه

156
00:12:02,930 --> 00:12:06,420
لنتحيّن فُرصةً لتقديم اعتذارنا
.وجَبر الضّرر لمُصارعي السّومو

157
00:12:06,860 --> 00:12:11,240
،أجل، ارتكبنا فِعلًا مُؤسفًا
.آمل أن نتمكّن مِن ذلك

158
00:12:13,350 --> 00:12:14,920
.اعذرني يا يامازاكي-كون

159
00:12:17,620 --> 00:12:22,160
،فقد انضممت لتوّك إلى المِيبورو
.وها نحن قد ظهرنا بمظهر الأشرار

160
00:12:22,600 --> 00:12:23,390
.لا بأس بذلك

161
00:12:24,520 --> 00:12:27,910
رُغم ذلك، ينبغي لي أن ألزم ما اعتدت
.عليه، تيبّس كتفاي مِن الهمّ

162
00:12:29,020 --> 00:12:31,190
آمل ألّا أضطرّ لخوض
.مثل هذا المَوقف مُجدّدًا

163
00:12:32,200 --> 00:12:33,400
،معه كُلّ الحقّ

164
00:12:34,110 --> 00:12:37,080
يَجدر بي أن أُفكّر في سُبلٍ
.لمنع نُشوب أيّ عراكٍ آخر

165
00:12:38,840 --> 00:12:40,440
!ا-انتصرتم؟

166
00:12:40,760 --> 00:12:42,940
!وأخرجتمونا مِن المأزق دُون عُقوبةٍ؟

167
00:12:43,210 --> 00:12:44,680
.هذا ما حدث بالفعل

168
00:12:45,200 --> 00:12:45,810
.تمامًا

169
00:12:46,240 --> 00:12:48,710
كيف قلبتم مَوازين تلك الفوضى؟

170
00:12:48,710 --> 00:12:50,830
لم تقوموا بالإطاحة بهم
جميعًا، أليس كذلك؟

171
00:12:51,340 --> 00:12:55,080
،كلا بالطّبع
.أخبرهم كوندو-سان بكُلّ شيءٍ

172
00:12:55,360 --> 00:12:57,400
كيف أفلحت في إقناعهم؟

173
00:12:58,340 --> 00:12:59,830
.أبدى براعةً مُفاجئةً بالفعل

174
00:13:01,590 --> 00:13:02,800
أين سيريزاوا-سان؟

175
00:13:03,240 --> 00:13:05,220
.خرج مع رِفاقه ليَحتسوا الشّراب

176
00:13:05,570 --> 00:13:07,120
،فهمت
.سأذهب لإحاطته عِلمًا

177
00:13:08,340 --> 00:13:09,140
،كوندو-سان

178
00:13:11,350 --> 00:13:12,480
.فلتكن هذه المرّة الأخيرة

179
00:13:14,590 --> 00:13:15,240
.أعلم ذلك

180
00:13:19,120 --> 00:13:21,400
.إذن هكذا جرى الأمر

181
00:13:21,990 --> 00:13:26,000
،ظننت أنّ ثمّة خطبًا ما
.فهذا لا يبدو مِن شِيم كوندو-سان

182
00:13:26,350 --> 00:13:29,480
.لا أظنّه فَعل ذلك عن طيب خاطر

183
00:13:30,520 --> 00:13:34,630
فقد تنازل عن قناعاته
.ليُلبّي طلب تارو-كون

184
00:13:35,370 --> 00:13:39,880
أعتقد أنّه اختار الطّريقة
.الأكثر نفعًا ليَحمي ما يَهمّه

185
00:13:40,590 --> 00:13:41,800
شيءٌ مُحيّر، أليس كذلك؟

186
00:13:42,520 --> 00:13:45,380
هل كُلّ رجال المِيبورو مثله؟

187
00:13:45,770 --> 00:13:46,480
.كلا

188
00:13:47,720 --> 00:13:51,850
،حتّى بين صُفوفنا
.هذان الاثنان استثنائيّان

189
00:13:55,570 --> 00:13:57,480
!بلا عُقوبةٍ؟

190
00:13:57,480 --> 00:13:59,020
كيف أنجزت ذلك؟

191
00:13:59,440 --> 00:14:01,020
.بقليلٍ مِن التّرهيب

192
00:14:04,780 --> 00:14:06,350
!كفى! امضِيا في طريقكما

193
00:14:06,660 --> 00:14:07,330
.حسنًا

194
00:14:11,920 --> 00:14:14,370
،نيو
.أثق بأنّك ستعود مع تارو

195
00:14:16,170 --> 00:14:18,070
،أمّا ما سيقع بعد ذلك
.فهو شأنٌ بين الرّجال

196
00:14:23,600 --> 00:14:25,250
!أجل! اشربوا حتّى الثّمالة

197
00:14:26,440 --> 00:14:27,430
!كوندو

198
00:14:27,430 --> 00:14:28,840
أما زِلت هُنا؟

199
00:14:31,280 --> 00:14:34,250
،سيريزاوا-سان
هل تُشاركني الشّراب؟

200
00:14:34,430 --> 00:14:37,180
،أنت لا تشرب أبدًا
.ظننت أنّك لا تُطيقه

201
00:14:37,180 --> 00:14:39,470
مَن ذا الّذي يرغب في الشّرب
مع شخصٍ مُتزمّت مثلك؟

202
00:14:39,470 --> 00:14:40,640
.اسمح لي أن أدفع الثّمن

203
00:14:40,640 --> 00:14:41,890
ولمَ لا؟

204
00:14:43,470 --> 00:14:44,190
ماذا؟

205
00:14:48,490 --> 00:14:50,660
،تفضّلا يا سادة
.سأُعدّ لكما كُلّ ما تشتهيان

206
00:14:51,240 --> 00:14:55,160
لم أظنّ أنّنا سنجد كشك
.سُوشي في مثل هذه السّاعة

207
00:14:55,510 --> 00:14:56,930
.هذه هي مدينة أوساكا

208
00:14:57,480 --> 00:14:59,610
أيّها السيّد، بماذا تنصحنا؟

209
00:15:00,370 --> 00:15:02,410
.لديّ سمك نِهريش طازجٌ

210
00:15:02,940 --> 00:15:05,560
إذن، قدّم لهذا الرّجل
.ممّا عندك

211
00:15:05,560 --> 00:15:08,600
،ثمن سمك النّهريش مرتفعٌ
فهل تملك المال؟

212
00:15:11,430 --> 00:15:14,030
.حسنًا، لا يهمّ، سأدفع أنا

213
00:15:14,410 --> 00:15:16,430
.اطلب ما تشتهي

214
00:15:17,390 --> 00:15:18,140
.دعني

215
00:15:18,540 --> 00:15:19,370
.أبدًا

216
00:15:19,660 --> 00:15:23,420
!دعني

217
00:15:21,030 --> 00:15:21,880
.لن أفعل

218
00:15:23,420 --> 00:15:24,430
.كلا

219
00:15:24,760 --> 00:15:26,430
!حسنًا، فهمت

220
00:15:26,830 --> 00:15:28,820
.أنا مَن سيدفع ثمن هذا

221
00:15:29,830 --> 00:15:33,320
إلى أي مدى بلغ عِنادك؟
.الآن لا نملك إلّا ثمن صِغار السّمك

222
00:15:37,390 --> 00:15:38,830
!طعم هذا رديءٌ للغاية

223
00:15:39,470 --> 00:15:41,810
أيّها الشّاب، مِن أين أنت؟

224
00:15:42,160 --> 00:15:45,080
.عائلتي تقطن جبال ميكاوا

225
00:15:48,770 --> 00:15:49,670
هكذا إذن؟

226
00:15:50,080 --> 00:15:53,630
،حسنًا، ثابر في عملك
.ولعلّك تصير ذا شأنٍ يومًا ما

227
00:15:54,070 --> 00:15:55,250
.إيّاك والتّراخي

228
00:15:55,600 --> 00:15:56,720
.أجل، يا سيّدي

229
00:15:58,850 --> 00:16:03,860
سيريزاوا-سان يملك سُمعةً مشبوهةً لدى
.البعض، لكنّه يملك هذا الجانب أيضًا

230
00:16:03,860 --> 00:16:05,690
.وهذا سرّ كسبه للأصدقاء

231
00:16:05,690 --> 00:16:06,720
إذًا؟

232
00:16:09,270 --> 00:16:13,110
لم تدعني للخُروج معك
عبثًا، ما الموضوع؟

233
00:16:17,150 --> 00:16:18,150
.تماديت كثيرًا

234
00:16:22,500 --> 00:16:27,360
أُدرك أنّ ذاك الرّجل قد أساء إليك، في
.الواقع، أخبرني تارو بالسّبب الحقيقيّ

235
00:16:28,600 --> 00:16:29,960
لكن ما تبقّى مِن فِعلك
.كان تجاوزًا صارخًا

236
00:16:30,620 --> 00:16:32,920
فلم يكن هُناك داعٍ
.لإزهاق أربع أرواحٍ

237
00:16:33,960 --> 00:16:38,120
بمهارتك العالية، كان بإمكانك
.الاكتفاء بصرع اثنين منهم فقط

238
00:16:41,800 --> 00:16:44,890
،اشرب
.لن أُجيبك ما لم تفعل

239
00:16:57,120 --> 00:16:58,800
.لم يكن بمقدوري التّغاضي عن ذلك

240
00:16:59,360 --> 00:17:03,190
فلم أُطِق يومًا أيّ مساسٍ بي
.أو بمن يخصّني

241
00:17:03,640 --> 00:17:06,160
،لا حِيلة لي في ذلك
.فهذه هي طبيعتي

242
00:17:07,090 --> 00:17:09,080
—شُكرًا لك، أنا ممتنٌ

243
00:17:09,080 --> 00:17:11,780
،دَعك مِن التكلّف في حديثك
.فهذا محرجٌ

244
00:17:12,280 --> 00:17:17,030
بدأت التحدّث بهذه الطّريقة مُنذ
.سمعت عن ميبو روشيغومي لأوّل مرّةٍ

245
00:17:17,530 --> 00:17:21,180
بما أنّني فلّاحٌ بالمَولد، فقد أردت أن أكون
.ساموراي بالرّوح، إن لم يكن بأيّ شيءٍ آخر

246
00:17:21,330 --> 00:17:23,390
.ما أقصده أنّ ذلك لا يَليق بك

247
00:17:23,730 --> 00:17:24,520
.حسنًا

248
00:17:26,720 --> 00:17:30,290
.هُناك مَن لديهم شكوكٌ حولك

249
00:17:31,290 --> 00:17:31,810
.اشرب

250
00:17:37,260 --> 00:17:40,540
هيجيكاتا، أليس كذلك؟
.يُمكنني معرفة ذلك

251
00:17:40,540 --> 00:17:42,620
أرجوك ابتعد عن المشاكل
.لفترةٍ وجيزة

252
00:17:43,560 --> 00:17:45,070
،كلا

253
00:17:45,940 --> 00:17:48,410
هل يُمكن لسُلحفاةٍ أن تنجو
دُون صدفتها؟

254
00:17:48,410 --> 00:17:52,220
سيّد كوندو، لا يُمكن لأحدٍ
.أن يُغيّر نهج حياته

255
00:17:55,000 --> 00:17:59,410
،سيريزاوا-سان
!أنت تُعجبني... وأنا أحترمك

256
00:17:59,410 --> 00:18:03,200
ماذا؟ ما هذا الآن؟
.بدأت تُثير رِيبتي

257
00:18:04,160 --> 00:18:07,700
لا يُمكن لأحدٍ أن يُغيّر نهج
.حياته، أنت محقٌّ في ذلك

258
00:18:10,960 --> 00:18:16,440
كنت دائمًا مُعجبًا بالسّاموراي وبذلت
.غاية جُهدي لأسير على خُطاهم

259
00:18:16,650 --> 00:18:21,580
ذلك يا سيّد كوندو، لأنّك لست
.ساموراي بالمعنى الحقيقيّ

260
00:18:22,020 --> 00:18:26,280
أجل! لذا سأُواصل السّعي لأُجسّد
!مفهومي الخاصّ عنهم

261
00:18:26,480 --> 00:18:28,360
—اسمع، إنّ السّاموراي هو

262
00:18:28,360 --> 00:18:30,020
،أعلم

263
00:18:30,420 --> 00:18:35,010
كُلّ ساموراي له مَسلكه الخاصّ في
.الحياة، ولا يُمكن لغيره تبديله أو تشويهه

264
00:18:35,780 --> 00:18:37,220
...لكن يا سيريزاوا-سان

265
00:18:40,100 --> 00:18:44,390
مهما كان فِعلك، أرجوك ألّا
.تنحرف عن نهج الإنسانيّة

266
00:18:45,140 --> 00:18:48,140
.فحُدودها بيّنةٌ لأيّ إنسانٍ

267
00:18:48,970 --> 00:18:51,970
.أنا أُؤمن بك يا سيريزاوا-سان

268
00:19:01,580 --> 00:19:03,530
!سيّدي، هل أنت بخير؟

269
00:19:03,530 --> 00:19:06,400
،سيّد كوندو
!حان وقت المُضي قُدمًا

270
00:19:08,530 --> 00:19:10,520
!نحن لا نزال في البداية

271
00:19:11,910 --> 00:19:14,360
!فلنسهر حتّى الصّباح

272
00:19:15,580 --> 00:19:17,920
.للشراب مذاقٌ خاصّ هذه اللّيلة

273
00:19:19,560 --> 00:19:22,520
،سيّد كوندو
.سنقصد مكانًا آخر

274
00:19:23,840 --> 00:19:27,120
فلا يزال في جُعبتي الكثير
.لأقوله لك

275
00:19:28,930 --> 00:19:33,040
،اسمع يا سيّد كوندو
...إنّ مستقبل المِيبورو

276
00:19:41,110 --> 00:19:44,690
.أظنّ أنّ أيًا منهما لم يَعد بعد

277
00:19:46,360 --> 00:19:46,880
ماذا؟

278
00:19:48,890 --> 00:19:50,160
!إنّهما مُستلقيان في الخارج

279
00:19:51,700 --> 00:19:53,070
أَهما على قيد الحياة؟

280
00:19:53,480 --> 00:19:54,160
...عُذرًا

281
00:19:55,610 --> 00:19:59,590
،حينما يستيقظ ذلكما الاثنان في الخارج
.لديّ مقترحٌ جادّ أودّ طرحه

282
00:20:02,190 --> 00:20:04,340
أَترغب في تجنيد المزيد مِن الرّجال؟

283
00:20:04,630 --> 00:20:06,930
.أجل، وبأعدادٍ كبيرة جدًا

284
00:20:08,100 --> 00:20:09,480
.أخبرنا بالسّبب

285
00:20:10,480 --> 00:20:14,160
أعتقد أنّ القُوّة في الكثرة هي
،السّبيل الأمثل لإرهاب الخُصوم

286
00:20:14,870 --> 00:20:17,860
فالقُوّة السّاحقة كفيلةٌ
.بوأد القتال قبل نُشوبه

287
00:20:18,630 --> 00:20:23,610
سحقنا جماعة الريسّيدان ومُصارعي
.السّومو في أوساكا رُغم قِلّة عددنا

288
00:20:24,580 --> 00:20:25,290
.هذا صحيحٌ

289
00:20:25,860 --> 00:20:27,370
،جماعة الريسّيدان كانت حالةً خاصّة

290
00:20:32,290 --> 00:20:34,860
لكن ألا تعتقد أنّ قتال مُصارعي
السّومو كان عبثًا لا طائل منه؟

291
00:20:37,790 --> 00:20:41,370
أَتسعى لزيادة العدد لتقليص
النّزاعات العبثيّة؟

292
00:20:43,320 --> 00:20:45,180
.هذا ليس مِن شِيمك أبدًا

293
00:20:45,640 --> 00:20:50,440
لكنّك تعلم أنّ تجنيد حشدٍ مِن الرّجال
.دُفعةً واحدة سيجلب المتاعب أيضًا

294
00:20:50,600 --> 00:20:52,320
،بالتّأكيد
.أنا موقنٌ مِن ذلك

295
00:20:52,640 --> 00:20:54,750
.فقد يصعب ضبط النّظام

296
00:20:55,540 --> 00:20:58,680
.ونُخاطر بوُقوع انقساماتٍ داخليّة

297
00:20:59,720 --> 00:21:02,340
،أرى أنّنا نسير بشكلٍ جيّد

298
00:21:03,360 --> 00:21:06,320
لكن هل نقنع بالبقاء
على هذا الحال للأبد؟

299
00:21:08,330 --> 00:21:10,510
،لحماية كيوتو

300
00:21:10,960 --> 00:21:14,570
علينا هجر الرّاحة والانطلاق
.نحو آفاقٍ جديدة

301
00:21:15,380 --> 00:21:18,390
،إذا عزمنا جميعًا على ذلك
.فسَننجح حتمًا

302
00:21:22,760 --> 00:21:23,800
بالتّأكيد، ولمَ لا؟

303
00:21:25,380 --> 00:21:26,380
.فلنفعلها

304
00:21:28,480 --> 00:21:30,000
هل سيُجدي هذا نفعًا؟

305
00:21:30,900 --> 00:21:32,980
،بما أن الأمر قد حُسم
.فلنقم بتوزيع منشوراتٍ

306
00:21:32,980 --> 00:21:35,990
،ولافتةٌ أيضًا
مَن منكم بارعُ في الخطّ؟

307
00:21:35,990 --> 00:21:38,220
.حسنًا، سأكتبها أنا

308
00:21:38,220 --> 00:21:39,710
!كلا، أيّ أحدٍ سِواك

309
00:21:39,710 --> 00:21:42,420
التجمّع عند معبد ميبو
!بعد ثلاثة أيّامٍ

310
00:23:21,660 --> 00:23:22,710
.تشيرينو نيو يُحدّثكم

311
00:23:23,290 --> 00:23:27,340
مِن أجل حماية كيوتو، لا بُدّ
.لجماعة المِيبورو مِن مواصلة التقدّم

312
00:23:28,180 --> 00:23:31,260
ولذا سنَشرع في تجنيد
.أعضاءٍ جُدد

313
00:23:31,940 --> 00:23:36,320
يتملّكني مزيجٌ مِن التوجّس والإثارة
.لمعرفة مَن سيُلبّي النّداء

314
00:23:37,290 --> 00:23:39,970
،لكن أمرًا واحدًا يُؤرّقني

315
00:23:41,030 --> 00:23:45,330
ثمّة شيءٌ غير طبيعيّ بشأن
سيريزاوا-سان مُؤخّرًا، أليس كذلك؟

316
00:23:46,470 --> 00:23:48,520
."الحلقة القادمة: "شاةٌ مُنفردة