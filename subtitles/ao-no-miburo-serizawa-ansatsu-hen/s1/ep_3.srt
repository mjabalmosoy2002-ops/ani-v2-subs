1
00:00:00,470 --> 00:00:04,230
،يا للرّوعة، لا شيء يعلو على كيوتو
أليس كذلك يا سيريزاوا-سينسي؟

2
00:00:04,480 --> 00:00:05,980
.فلها سِحرٌ فريد مِن نوعه

3
00:00:05,980 --> 00:00:08,690
أوساكا تعجّ بالضّجيج والزّحام
.أكثر ممّا أطيق

4
00:00:08,690 --> 00:00:10,710
.أهلًا بعودتك يا سيريزاوا-سان

5
00:00:14,020 --> 00:00:15,280
أين البقيّة؟

6
00:00:17,920 --> 00:00:19,600
...إذا كُنتِ تبحثين عنهم، فهم

7
00:00:28,780 --> 00:00:33,790
استعرنا باحة معبد ميبو مِن
.أجل حملة التّجنيد الكُبرى

8
00:00:34,800 --> 00:00:36,730
!أين الرّاغبون بالانضمام إذن؟

9
00:00:37,870 --> 00:00:42,940
وصل بي الأمر إلى دعوة ساموراي غُرباء
.تمامًا لقيتهم أثناء عودتي مِن أوساكا

10
00:00:43,290 --> 00:00:46,600
ظننت أنّنا قد نِلنا قَدرًا
.مِن الشّهرة

11
00:00:46,780 --> 00:00:48,850
،بل سُوء سُمعةٍ
.على وجه الدّقة

12
00:00:50,180 --> 00:00:52,520
،على أيّ حالٍ
.لم أكن أُعلّق آمالًا كبيرة

13
00:00:52,880 --> 00:00:54,490
،ما زال الحُكم سابقًا لأوانه

14
00:00:54,800 --> 00:00:58,070
،فهُناك مَن يسعد بالالتحاق بنا
.مثل يامازاكي-سان

15
00:00:58,400 --> 00:01:00,290
.وهو رجلٌ غريب الأطوار

16
00:01:00,960 --> 00:01:02,920
ألا يُزعجك هذا يا هيجيكاتا؟

17
00:01:03,450 --> 00:01:04,290
ما الّذي يُزعجني؟

18
00:01:05,320 --> 00:01:09,050
خِلتك مُعارضًا لفكرة ضمّ
،رجالٍ جُدد

19
00:01:09,470 --> 00:01:12,270
لذا دُهشت حين لم تُبدِ
.اعتراضًا هذه المرّة

20
00:01:14,100 --> 00:01:17,060
ظننت أنّه مِن الأجدى أن تكون
.جماعة المِيبورو مَلاذًا للآخرين

21
00:01:17,380 --> 00:01:18,370
ماذا تقصد بهذا؟

22
00:01:18,370 --> 00:01:20,080
!وصل بعض الزّوار

23
00:01:20,760 --> 00:01:22,310
ماذا؟ حقًا؟

24
00:01:22,480 --> 00:01:24,230
.سأَرضى ولو برجلٍ واحد فقط

25
00:01:24,770 --> 00:01:26,490
...في الواقع، بخُصوص ذلك

26
00:01:37,610 --> 00:01:39,610
!ماذا؟

27
00:01:39,840 --> 00:01:40,790
.يا إلهي

28
00:03:13,000 --> 00:03:14,710
!مـ-من فضلكم، اصطفّوا

29
00:03:15,250 --> 00:03:17,170
،صفٌّ واحد
!إن لم يكن لديكم مانعٌ

30
00:03:20,030 --> 00:03:21,650
ما الخطب يا نيو-كون؟

31
00:03:21,910 --> 00:03:23,800
.أنا متأثّرٌ جدًا فقط

32
00:03:24,170 --> 00:03:24,610
ماذا؟

33
00:03:24,910 --> 00:03:26,480
...لم يخطر ببالي

34
00:03:26,980 --> 00:03:31,580
أنّ هُناك جمعًا غفيرًا يحرص
.على كيوتو تمامًا كما نفعل

35
00:03:32,120 --> 00:03:35,480
حتّى أنت لا بُدّ أن تُدرك أنّ الدّوافع
.ليست بهذه البساطة فحسب

36
00:03:37,900 --> 00:03:41,600
،فوكوروكوجي كينران
.أظنّ أنّ دَوري هو الأوّل

37
00:03:42,900 --> 00:03:45,860
،نودّ رُؤية مهاراتك
.للتأكّد ليس إلّا

38
00:03:55,260 --> 00:03:57,260
.توقّف، هذا يكفي

39
00:03:57,260 --> 00:03:58,670
.الآن، دَوّن اسمك هُناك

40
00:03:59,930 --> 00:04:00,850
.لا بأس بذلك

41
00:04:01,880 --> 00:04:02,880
.التّالي

42
00:04:03,120 --> 00:04:05,320
!سأكون خصمك

43
00:04:05,610 --> 00:04:07,340
!اختبر بَسالتك أمامي

44
00:04:16,310 --> 00:04:17,200
.اجتزت الاختبار

45
00:04:17,560 --> 00:04:18,860
...جين-سان، أَلم يكن هذا

46
00:04:20,480 --> 00:04:22,360
عُضوًا في جماعة الريسّيدان الدمويّة؟

47
00:04:22,720 --> 00:04:23,240
.بلى

48
00:04:23,950 --> 00:04:26,210
انقلب على عَقبيه
.وهرب عند جسر جوجو

49
00:04:27,150 --> 00:04:29,300
لمَ لا نُبقي هذا سِرًا بيننا
في الوقت الرّاهن؟

50
00:04:29,300 --> 00:04:29,960
.أجل

51
00:04:33,870 --> 00:04:35,870
!هيّا! تنحّوا عن طريقنا

52
00:04:39,100 --> 00:04:40,840
نحن أهل البأس والخِبرة
...المَشهود لها

53
00:04:41,360 --> 00:04:43,350
،مُصارعا كوتشي، ياماتو...

54
00:04:43,940 --> 00:04:46,480
!الأخوان أوزيكي اللّذان لا يُقهران

55
00:04:48,200 --> 00:04:50,190
،سنُخضع البلاد لسيطرتنا

56
00:04:50,190 --> 00:04:55,850
وأوّل خُطواتنا هي صَقلكم أيّها الرّونين
.المُبتدئون لتكونوا طليعة قُوّاتنا

57
00:04:56,520 --> 00:04:58,810
.دَعني أتكفّل بهما يا سوجي

58
00:05:00,040 --> 00:05:02,600
.انظر إلى هذا الهَزيل يا أخي

59
00:05:02,600 --> 00:05:04,160
هل تُمانع إن تولّيت أمره؟

60
00:05:05,680 --> 00:05:07,440
.لقّنه درسًا يا ماسا

61
00:05:08,720 --> 00:05:10,870
يُمكنني مُواجهتكما معًا
.في آنٍ واحد

62
00:05:12,290 --> 00:05:14,300
!أيّها القَروي الأحمق

63
00:05:14,300 --> 00:05:16,920
عُد إلى قريتك النّائية
!وارتمِ في حِضن أُمّك

64
00:05:17,120 --> 00:05:19,690
أَتريد أن أُهشّم جمجمتك؟
أَليس كذلك؟

65
00:05:23,430 --> 00:05:24,430
.معذرةً يا سيّدي

66
00:05:24,430 --> 00:05:26,040
.نرجو مِنك الصّفح عنّا

67
00:05:26,620 --> 00:05:28,260
.دوّنا اسميكما

68
00:05:28,260 --> 00:05:30,200
،أمرك يا سيّدي
.لن نعود إلى هُنا أبدًا

69
00:05:30,200 --> 00:05:31,820
.شُكرًا جزيلًا لك

70
00:05:32,220 --> 00:05:32,720
ماذا؟

71
00:05:33,310 --> 00:05:35,860
.طليعة قُوّاتكم" كما ذَكرت"

72
00:05:35,860 --> 00:05:37,610
.راق لي هذا القول على الأقلّ

73
00:05:38,340 --> 00:05:42,280
كان محض هُراءٍ، لكن التّظاهر
.بالقُوّة أفضل مِن لا شيء

74
00:05:45,100 --> 00:05:47,790
،وقبل المُضيّ قُدمًا
.دَعوني أُخبركم شيئًا واحدًا

75
00:05:48,290 --> 00:05:51,280
كُلّ مَن جاء هُنا اليوم
.قد اجتاز الاختبار

76
00:05:52,390 --> 00:05:58,250
لكن إن ظننتم أنّكم ستَعيشون عالةً
.علينا، فستتلقّون درسًا قاسيًا

77
00:06:01,080 --> 00:06:02,290
.تذكّروا قولي

78
00:06:09,650 --> 00:06:13,170
،"بقولك "ملاذًا للآخرين
هل تقصد جماعة الريسّيدان؟

79
00:06:13,970 --> 00:06:19,940
أي أنّ المِيبورو ستَمنح أوغادًا مثلهم
مكانًا ينتمون إليه... هل هذه هي الفِكرة؟

80
00:06:20,290 --> 00:06:24,820
هُناك رجالٌ لديهم فائضٌ مِن القُوّة
.ولا يجدون ما يُفرّغونها فيه

81
00:06:25,520 --> 00:06:28,280
.كان هذا حالنا في تاما

82
00:06:28,280 --> 00:06:29,200
.هذا صحيحٌ

83
00:06:29,940 --> 00:06:33,960
سنَجمع كُلّ هؤلاء الحمقى
.والأنذال معًا

84
00:06:34,940 --> 00:06:37,570
ومَن يدري ما الّذي
سيَنتج عن ذلك؟

85
00:06:48,930 --> 00:06:51,930
فلتحلّ اللّعنة عليّ إن ساهمت
.في تكاثر مَن هُم على شاكلتهم

86
00:06:53,180 --> 00:06:54,480
.تذكّر ما قاله نيو

87
00:06:56,040 --> 00:06:58,410
.سنَمضي قُدمًا مِن أجل غايتنا

88
00:06:59,220 --> 00:07:00,480
.لا شيء غير ذلك

89
00:07:01,950 --> 00:07:04,440
.صحيحٌ، أصبت كَبد الحقيقة

90
00:07:04,940 --> 00:07:06,730
!ناغاكورا-سان، حلّت مصيبةٌ

91
00:07:07,050 --> 00:07:09,940
!نشب عِراكٌ هُناك
.أرجوك تدخّل لإيقافه

92
00:07:10,470 --> 00:07:11,580
.حسنًا

93
00:07:12,520 --> 00:07:13,770
!سأتكفّل بالأمر

94
00:07:13,770 --> 00:07:14,600
.مِن هُنا

95
00:07:15,090 --> 00:07:17,540
،ناغاكورا-سان
.سأعهد إليك بمُهمّة الاستقبال

96
00:07:18,270 --> 00:07:21,080
!مهلًا يا كوندو
!كُنت أنا مَن سيَقوم بذلك

97
00:07:27,200 --> 00:07:29,030
.لا تقلق، ليس فيها كسرٌ

98
00:07:29,750 --> 00:07:30,750
هل أنت طبيبٌ؟

99
00:07:31,040 --> 00:07:32,970
.أجل، أو كُنت كذلك

100
00:07:35,420 --> 00:07:36,560
...والآن

101
00:07:36,940 --> 00:07:38,490
مَن عساه يكون خصمي؟

102
00:07:38,490 --> 00:07:40,480
،فوكوروكوجي-سان
.إذا سمحت لي

103
00:07:41,310 --> 00:07:43,880
طِفلٌ؟
هل أنت عضوٌ أيضًا؟

104
00:07:43,880 --> 00:07:45,570
.أجل، أنا تشيرينو نيو

105
00:07:47,230 --> 00:07:49,010
وضعيّة استعدادك ليست سيّئةً
.على الإطلاق

106
00:07:56,720 --> 00:07:57,780
.شُكرًا جزيلًا لك

107
00:07:58,350 --> 00:07:59,620
،حسنًا
.واصل على هذا المِنوال

108
00:07:59,860 --> 00:08:01,920
.ذلك الرّجل بارعٌ حقًا

109
00:08:01,920 --> 00:08:04,380
ذَكر أنّه مُساعد مُعلّمٍ
.في مدرسةٍ لفنّ السّيف

110
00:08:04,380 --> 00:08:05,340
.لا عَجب إذًا

111
00:08:07,070 --> 00:08:08,880
.كما توقّعت، الأمر هيّنٌ

112
00:08:08,880 --> 00:08:13,080
لن أجد صُعوبةً في عيش
.حياةٍ رغيدة مع المِيبورو

113
00:08:21,760 --> 00:08:24,140
!استيقظوا
!حان وقت التّدريب الصباحيّ

114
00:08:24,330 --> 00:08:26,280
!ليَجتمع الجميع عند معبد ميبو

115
00:08:28,110 --> 00:08:29,790
.ما زال الظّلام دامسًا في الخارج

116
00:08:30,390 --> 00:08:34,150
!ابدؤوا بمائة ضربةٍ، هيّا

117
00:08:39,330 --> 00:08:40,890
.سأموت جُوعًا

118
00:08:40,890 --> 00:08:42,380
،والآن
...لا بُدّ أنّ الفُطور سيَكون

119
00:08:43,460 --> 00:08:44,500
.إنّه شحيحٌ للغاية

120
00:08:49,460 --> 00:08:53,780
أنصتوا أيّها الرّجال! الجولات التفقديّة
.في المدينة مهمّةٌ جَليلة

121
00:08:55,410 --> 00:08:56,850
.يومٌ سِلميّ آخر

122
00:08:58,500 --> 00:09:00,480
ما قولك في أن تمنحني حساءك؟

123
00:09:02,240 --> 00:09:03,360
!فوكوروكوجي-سان

124
00:09:03,580 --> 00:09:06,140
اليوم أيضًا؟
.إنّك لا تستسلم أبدًا

125
00:09:06,140 --> 00:09:07,100
.إذا سمحت لي

126
00:09:09,860 --> 00:09:10,990
.أنا أُقرّ بالهزيمة

127
00:09:11,470 --> 00:09:12,880
.إنّك تهدر وقتك فحسب

128
00:09:14,440 --> 00:09:15,240
،حسنًا

129
00:09:15,590 --> 00:09:17,640
.سأَقبل نِزالك اليوم

130
00:09:22,960 --> 00:09:23,700
.ها هو قادمٌ

131
00:09:28,480 --> 00:09:29,920
.تركت دِفاعك مَكشوفًا تمامًا

132
00:09:30,640 --> 00:09:33,950
هذا الرّجل كان يكبح قُوّته
.في ذلك الاختبار

133
00:09:35,410 --> 00:09:37,070
!إنّه باسلٌ جدًا

134
00:09:38,870 --> 00:09:39,720
.إذا سمحت لي

135
00:09:42,880 --> 00:09:45,160
،هل هذا المكان وكرٌ للشّياطين
أم ماذا؟

136
00:09:48,070 --> 00:09:48,740
.التّالي

137
00:09:49,440 --> 00:09:50,940
.حتّى الأطفال هُنا أشدّاء

138
00:09:54,800 --> 00:09:56,430
.وحتّى الصّغار يتطاولون عليّ

139
00:09:58,280 --> 00:10:01,400
كيف لي أن أنعم بحياةٍ
رغيدة في مكانٍ كهذا؟

140
00:10:03,140 --> 00:10:04,000
.هزمتني

141
00:10:04,370 --> 00:10:05,520
.شُكرًا جزيلًا لك

142
00:10:11,170 --> 00:10:12,710
كيف يُواصل فِعل ذلك؟

143
00:10:16,400 --> 00:10:18,630
ما هذه الوَرقة الّتي معك؟

144
00:10:18,990 --> 00:10:22,510
هذا هو مَوقعي الحاليّ
.في المِيبورو

145
00:10:22,790 --> 00:10:23,420
ماذا؟

146
00:10:24,040 --> 00:10:26,190
،كُلّما تقدّمت للأمام
.صِرت أكثر قُوّةً

147
00:10:26,190 --> 00:10:28,770
لا بُدّ أنّ كوندو-سان أو
.سيريزاوا-سان في الطّرف الأقصى

148
00:10:29,730 --> 00:10:30,940
.أمّا الضّعفاء فيَقبعون هُنا

149
00:10:31,600 --> 00:10:32,650
ما الفائدة مِن ذلك؟

150
00:10:32,880 --> 00:10:34,940
.لأكون ذا نفعٍ بالطّبع

151
00:10:35,310 --> 00:10:39,030
،أُريد أن أشقّ طريقي نحو الطّرف الأقصى
.خُطوةً بخُطوةٍ وشخصًا تلو الآخر

152
00:10:42,080 --> 00:10:45,460
،إذا كُنت مُتفرغًا الآن
فهل تتدرّب معي؟

153
00:10:51,360 --> 00:10:52,340
.أنا أُقرّ بالهزيمة

154
00:10:52,340 --> 00:10:53,340
ماذا؟

155
00:10:54,320 --> 00:10:58,520
،ظننتك مُجرّد أحمق
.واستخففت بك لأنّك صغير السّن

156
00:10:59,670 --> 00:11:02,970
،خُيّل إليّ أنّك بلا طُموحٍ
.ولم تعرف طعم الحياة الرّغيدة قطّ

157
00:11:03,560 --> 00:11:04,650
،رُبّما كان ذلك صحيحًا

158
00:11:06,010 --> 00:11:07,720
.لكنّني اعتقدت أنّني أسمى مٍن ذلك

159
00:11:11,230 --> 00:11:13,520
...شُكرًا لك، تذكّرت الآن

160
00:11:17,690 --> 00:11:18,640
.مَن كُنت عليه في السّابق

161
00:11:25,600 --> 00:11:26,660
أَتفرّ هاربًا؟

162
00:11:35,280 --> 00:11:37,120
.حُسم مَصيره يا نيمي

163
00:11:38,020 --> 00:11:38,800
.انسحب

164
00:11:39,310 --> 00:11:40,550
!لا تُسئ فهمي

165
00:11:42,320 --> 00:11:43,860
لن تكون هذه آخر مرّةٍ
!تراني فيها

166
00:11:44,200 --> 00:11:48,640
،سأُعيد صَقل نفسي، جسدًا ورُوحًا
!ثُمّ سأعود لهذا المكان

167
00:11:48,640 --> 00:11:51,480
!تذكّر ذلك جيّدًا

168
00:11:55,780 --> 00:11:56,860
.لنَعدّ عودتك احتمالًا قائمًا

169
00:11:57,950 --> 00:12:00,620
،أحسنتم صُنعًا
.اجتزتم سبعة أيّامٍ دُون فِرارٍ

170
00:12:01,350 --> 00:12:05,200
السّتة والأربعون المُتبقّون منكم، أصبحتم
.مُنذ الآن أعضاءً رسميّين في ميبو روشيغومي

171
00:12:06,480 --> 00:12:08,670
وستَبدأون مهامّكم جنبًا
.إلى جنبٍ معنا

172
00:12:10,680 --> 00:12:11,920
!أنا أُعوّل عليكم جميعًا

173
00:12:12,240 --> 00:12:13,460
!أجل يا سيّدي

174
00:12:14,400 --> 00:12:16,820
ذاك الرّجل ذُو العينين النّاعستين الّذي
.وضعت عيني عليه قد لاذ بالفِرار

175
00:12:16,820 --> 00:12:18,450
،هوّن عليك
.لا تدع الأمر يُكدّر صَفوك

176
00:12:18,450 --> 00:12:19,050
ماذا؟

177
00:12:19,800 --> 00:12:21,760
.قُدّمت خُطوةً نحو مَصافّ الأقوياء

178
00:12:24,190 --> 00:12:26,220
.معذرةً، لم يَعد هُناك متّسعٌ

179
00:12:26,490 --> 00:12:27,430
لم يَعد هُناك متّسعٌ؟

180
00:12:28,800 --> 00:12:30,480
.أرى طاولةً شاغرةً في الخلف

181
00:12:30,480 --> 00:12:32,360
،تلك الطّاولة محجوزةٌ

182
00:12:32,840 --> 00:12:36,480
ثمّة سادةٌ مِن تشوشو يرتادون
.المكان دائمًا في مثل هذا الوقت

183
00:12:36,620 --> 00:12:39,000
تشوشو؟
أَتقصدين أُولئك الأعداء؟

184
00:12:39,000 --> 00:12:41,450
ألا تعلمين أنّنا رجال المِيبورو؟

185
00:12:41,670 --> 00:12:42,360
.توقّفا

186
00:12:43,480 --> 00:12:44,320
.معذرةً منكِ

187
00:12:46,000 --> 00:12:47,170
.نحن نعتذر

188
00:12:50,170 --> 00:12:51,060
،معذرةً

189
00:12:51,570 --> 00:12:52,700
.أسفٌ بخُصوص ذلك

190
00:12:58,050 --> 00:13:00,550
.يا لكم مِن جماعةٍ غريبة حقًا

191
00:13:00,550 --> 00:13:02,670
هل تَنوون افتتاح مسرحٍ تمثيليّ؟

192
00:13:02,670 --> 00:13:04,550
،أَعد ما قُلته لتوّك
.أيّها الأحمق

193
00:13:04,550 --> 00:13:05,360
.توقّف

194
00:13:06,260 --> 00:13:07,220
.دَعك منه

195
00:13:08,000 --> 00:13:09,620
.وأنتما أيضًا، كُفّا عن هذا

196
00:13:10,840 --> 00:13:12,520
،أنت لا تُسبّب لي إزعاجًا

197
00:13:13,560 --> 00:13:16,320
.لكن صِغار رجالنا سريعو الغضب

198
00:13:16,320 --> 00:13:19,420
لا أعرف مَن تكون، لكن خيرٌ لك
.أن تَنتقي كلماتك بحذرٍ

199
00:13:21,960 --> 00:13:24,450
،كاتسورا كوغورو
.ساموراي مِن تشوشو

200
00:13:25,290 --> 00:13:26,190
كاتسورا؟

201
00:13:26,190 --> 00:13:27,630
هل هو كاتسورا ذاته؟

202
00:13:29,520 --> 00:13:30,670
ومَن تكون أنت؟

203
00:13:31,040 --> 00:13:33,920
،هيجيكاتا توشيزو
.مِن ميبو روشيغومي

204
00:13:34,680 --> 00:13:35,710
المِيبورو؟

205
00:13:35,710 --> 00:13:36,920
.إذن، هؤلاء هُم المِيبورو

206
00:13:36,920 --> 00:13:39,450
كنت أظنّ أنّ تشوشو
.في خِضمّ حربٍ

207
00:13:39,450 --> 00:13:41,050
ماذا تفعلون في كيوتو؟

208
00:13:41,050 --> 00:13:45,060
،لا أرى داعيًا لإجابتك
.وليس مِن حقّك معرفة ذلك

209
00:13:45,060 --> 00:13:45,930
!يا هذا

210
00:13:45,930 --> 00:13:48,470
.هيجيكاتا-كون، سأتذكّرك جيّدًا

211
00:13:49,710 --> 00:13:52,530
والآن أستأذنكم، فليس
.لديّ متّسعٌ مِن الوقت

212
00:13:53,040 --> 00:13:53,980
،عُذرًا

213
00:13:53,980 --> 00:13:57,680
،إن كُنت مِن مُحبّي السُكريّات
.فأنا أنصحك بـ تشيرينويا

214
00:13:57,890 --> 00:13:59,880
.إنّه دُكّان دانغو لجدّتي

215
00:14:01,960 --> 00:14:03,360
.سأقوم بزِيارته يومًا ما

216
00:14:03,950 --> 00:14:06,360
!كاتسورا-ساما، تفضّل بالدّخول

217
00:14:06,360 --> 00:14:07,950
.طاولتك شاغرةٌ

218
00:14:07,950 --> 00:14:09,800
،طاب يومكِ
.أنا ممتنٌّ لكِ دائمًا

219
00:14:09,800 --> 00:14:12,210
.أنت فاتنٌ للغاية كما العادة

220
00:14:12,210 --> 00:14:14,740
هل أنت متيقّنٌ مِن رغبتك في
تركه يرحل بهذه البَساطة؟

221
00:14:14,740 --> 00:14:15,880
.تجاهله

222
00:14:15,880 --> 00:14:18,880
ومع ذلك، لحُسن الحظّ
.أنّك لست سيريزاوا-سان

223
00:14:18,880 --> 00:14:20,920
فما كان ليَقنع بمُجرّد
.جِدالٍ باللّسان

224
00:14:20,920 --> 00:14:22,580
،إنّه ليس بهذا الغباء
.وأنت تعلم ذلك

225
00:14:23,310 --> 00:14:26,180
إذن، هذا هو كاتسورا كوغورو
.ذائع الصّيت

226
00:14:26,680 --> 00:14:28,820
نيو، ما انطباعك عنه؟

227
00:14:29,560 --> 00:14:32,260
...دَعني أُفكّر
كيف أُعبّر عن ذلك؟

228
00:14:32,720 --> 00:14:34,880
.إنّه شخصٌ يبعث على الارتياح

229
00:14:34,880 --> 00:14:36,400
!ماذا؟! هل جُننت؟

230
00:14:36,400 --> 00:14:38,680
.بل كلامه كان بمثابة إهانةٍ كبيرة

231
00:14:39,150 --> 00:14:40,240
،هكذا إذن

232
00:14:40,550 --> 00:14:44,440
لعلّنا نُسيء فهم الآخرين عندما
.نقف على جانبين مُتعارضين

233
00:14:44,880 --> 00:14:48,280
أي أنّنا نميل لرُؤية مَساوئ النّاس
.حين نُصنّفهم كأعداءٍ

234
00:14:48,720 --> 00:14:49,810
.هذا هو نيو-كون الّذي نعرفه

235
00:14:50,060 --> 00:14:52,980
كلا، قد أكون مُخطئًا
.تمامًا في تقديري

236
00:14:53,380 --> 00:14:55,330
.إنّه مختلفٌ عنّا جميعًا

237
00:14:55,680 --> 00:14:58,560
نيو-كون! كُنت أعلم أنّنا
.نستطيع الاعتماد عليك دائمًا

238
00:14:56,050 --> 00:14:58,530
،إنّه سريع البَديهة
.وينظر للأمور بشُموليّةٍ

239
00:14:58,860 --> 00:15:01,500
.كلا، لست شخصًا مُميّزًا، صِدقًا

240
00:14:59,040 --> 00:15:01,960
هذه الصّفات تُؤهّله لمُهمّةٍ
مُعيّنة، لكن ما هي يا تُرى؟

241
00:15:03,200 --> 00:15:06,130
إذن، هؤلاء هُم جماعة
.المِيبورو، ثلّةٌ مِن الرّعاع

242
00:15:06,130 --> 00:15:08,190
ساموراي الأرياف هؤلاء
...تحمل رُؤوسهم أفكارًا مَغلوطةً

243
00:15:08,190 --> 00:15:11,230
هذا يُثبت أنّه لا يُمكنك
.الوُثوق بما يُقال

244
00:15:12,630 --> 00:15:17,680
فقد كان في نظراتهم شيءٌ يجعلهم مُختلفين عن
.أُولئك المُدّعين الّذين يصرخون بمُعاداة الأجانب

245
00:15:19,360 --> 00:15:20,930
،بالحديث عن كاتسورا-دونو

246
00:15:21,200 --> 00:15:24,680
يُقال إنّه معلّمٌ كبير في
.مدرسة شينتو-مونين

247
00:15:24,970 --> 00:15:27,240
.بدا شخصًا لطيفًا ورزينًا

248
00:15:27,760 --> 00:15:31,320
بالفعل، فلا يوجد مَن أتقن
.فنّ السّيف وكان رجلًا سيئًا

249
00:15:32,030 --> 00:15:34,040
.أتمنّى مُبارزته يومًا ما

250
00:15:35,080 --> 00:15:37,080
،هل هُناك خطبٌ ما
يا يامانامي-سان؟

251
00:15:37,330 --> 00:15:38,000
،كلا

252
00:15:38,800 --> 00:15:43,490
لكنّي أتساءل، ما الّذي أتى برجلٍ
.ذي شأنٍ مِن تشوشو إلى كيوتو

253
00:15:44,470 --> 00:15:48,560
لا ينفكّ يُراودني شعورٌ بأنّ الزّمن
.على وشك التغيّر، وبشكلٍ جذري

254
00:15:51,760 --> 00:15:52,720
الزّمن، أليس كذلك؟

255
00:15:54,430 --> 00:15:58,750
ليست هذه قضيّتنا، سنَنصرف
.للاهتمام بشُؤوننا الخاصّة فحسب

256
00:16:00,810 --> 00:16:02,950
...توشي، بخُصوص ذلك

257
00:16:05,990 --> 00:16:07,850
ماذا جرى؟ وأين الجميع؟

258
00:16:10,720 --> 00:16:11,800
.اسمح لي بالتّوضيح

259
00:16:14,640 --> 00:16:15,480
نيمي-سان؟

260
00:16:19,180 --> 00:16:23,920
يُقال إنّ هذا التّاجر يُحوّل
.أرباحه لدعم المُتطرّفين

261
00:16:24,480 --> 00:16:25,420
ما رأيكم؟

262
00:16:25,800 --> 00:16:26,730
.أجل، أنت هُناك

263
00:16:26,980 --> 00:16:30,300
سيّدي! واجب التّاجر
.هو جلب الثّروة للبلاد

264
00:16:30,300 --> 00:16:33,420
وأعتقد أنّ دعم العُنف
.فعلٌ لا يُمكن السّكوت عنه

265
00:16:33,570 --> 00:16:36,170
،صحيحٌ، ولكن
ما التصرّف الّذي ستتّخذه؟

266
00:16:36,510 --> 00:16:38,180
،سأُوجّه له إنذارًا
.وأُرغمه على التوقّف

267
00:16:38,180 --> 00:16:38,920
!هذا تساهلٌ مُفرط

268
00:16:42,110 --> 00:16:43,270
.بل سنُجرّده مِن كُلّ ما يملك

269
00:16:44,110 --> 00:16:45,230
هل تقصد الاستدانة بالإكراه إذن؟

270
00:16:45,620 --> 00:16:50,440
ستَقتحم فِرقةٌ الدُكّان لتنتزع مبلغًا
."طائلًا لتمويل "المِيزانيّة الحربيّة

271
00:16:50,880 --> 00:16:53,450
.ذلك هو أُسلوب سيريزاوا الدّائم

272
00:16:56,020 --> 00:16:58,830
!انتظر لحظةً يا نيمي
أَلست مِن رجال سيريزاوا؟

273
00:16:59,120 --> 00:17:02,260
،لماذا تَشي به إذن؟ نحن نعرفك جيّدًا
.ولن تنطلي علينا هذه الحِيلة

274
00:17:04,060 --> 00:17:06,890
صِدقًا، عرفت سيريزاوا
.لزمنٍ طويل

275
00:17:07,610 --> 00:17:10,780
زُرنا أماكن كثيرةً وأَثرنا
.الكثير مِن المتاعب معًا

276
00:17:10,780 --> 00:17:12,000
ماذا قُلت لكُم؟

277
00:17:12,000 --> 00:17:14,010
.لكنّه يفقد الاهتمام بسُهولةٍ

278
00:17:14,010 --> 00:17:17,760
فهو رجلٌ لا يعرف الاستقرار في
.مكانٍ، ودائمًا ما يبدأ بإثارة المَشاكل

279
00:17:18,390 --> 00:17:21,560
وماذا بعد؟ إن كان هذا
.تهديدًا، فأنت تُضيّع وقتك

280
00:17:21,880 --> 00:17:22,630
.كفى

281
00:17:23,150 --> 00:17:25,990
إذن، هل لقصّتك بقيّةٌ؟

282
00:17:30,450 --> 00:17:32,360
...عن نفسي

283
00:17:36,440 --> 00:17:40,380
تعلّق قلبي بكيوتو، وأرغب في
.البقاء مع المِيبورو لوقتٍ أطول

284
00:17:40,960 --> 00:17:41,620
...لذا

285
00:17:42,870 --> 00:17:46,380
أُريد اتّخاذ خُطوةٍ ما
.لتَصحيح الأوضاع

286
00:17:46,840 --> 00:17:49,200
لماذا علينا أن نُصدّقك؟

287
00:17:49,830 --> 00:17:53,850
لا أُنكر أنّه رجلٌ كتوم
.لا يُظهر ما يُضمره

288
00:17:54,870 --> 00:17:56,890
لكنّه أنقذ حياتي حين
.تعرّضت للتسمّم

289
00:17:59,280 --> 00:18:02,040
.نيمي، سأضع ثِقتي بك

290
00:18:04,020 --> 00:18:05,510
.يبدو أنّك خسرت يا هيسوكي

291
00:18:07,260 --> 00:18:08,670
.أنا أفهم ما تَشعر به

292
00:18:09,210 --> 00:18:11,240
ولكن، ماذا نحن فاعلون؟

293
00:18:11,240 --> 00:18:13,600
.أرى أنّه لا بديل عن التحدّث إليه

294
00:18:15,390 --> 00:18:16,240
.سأتولّى أنا هذه المُهمّة

295
00:18:16,720 --> 00:18:17,900
.وأنا سأُرافقك إذن

296
00:18:28,310 --> 00:18:29,160
ماذا؟

297
00:18:29,400 --> 00:18:31,580
ما بالك تَقف هُنا؟

298
00:18:31,930 --> 00:18:36,610
خِلتك سلبت أحد التّجار وهرعت إلى
."شيمابارا بتلك الأموال لـ "المِيزانيّة الحربيّة

299
00:18:37,170 --> 00:18:39,190
لكن لعلّي كُنت واهمًا
.فيما سمعت

300
00:18:39,540 --> 00:18:40,470
.سيريزاوا-سان

301
00:18:40,960 --> 00:18:42,080
.الزما أماكنكما

302
00:18:43,040 --> 00:18:45,350
،خطوةٌ أُخرى للأمام
.وسأُطيح برأسيكُما

303
00:18:48,110 --> 00:18:50,730
حبّذا لو كَففت عن خوض
.الصّراعات دُون الرّجوع إلينا

304
00:18:51,280 --> 00:18:52,770
.وكأنّ رأيكم يَعنيني

305
00:18:53,320 --> 00:18:55,340
ما غايتك مِن المِيبورو؟

306
00:18:55,930 --> 00:18:57,740
وما الّذي يدفعك لكُلّ هذا؟

307
00:18:58,010 --> 00:18:59,620
.شُعوري بالواجب

308
00:18:59,620 --> 00:19:00,830
الواجب؟

309
00:19:00,830 --> 00:19:02,370
.سأبتاع مِدفعًا

310
00:19:02,370 --> 00:19:03,410
.لا حاجة لنا به

311
00:19:04,160 --> 00:19:06,060
.فهذه الأدوات وُجدت للحُروب لا غير

312
00:19:06,060 --> 00:19:07,490
.هيجيكاتا

313
00:19:07,830 --> 00:19:10,540
ستُصبح كيوتو ساحةً
.للقتال عمّا قريبٍ

314
00:19:10,540 --> 00:19:14,130
،وكُلّما أسرعنا في الاستعداد
.كان ذلك خيرًا لنا

315
00:19:14,130 --> 00:19:15,260
،لا أفهم مَنطقك

316
00:19:15,890 --> 00:19:17,810
.فأنت تستبق الأحداث بشكلٍ مُفرط

317
00:19:18,380 --> 00:19:21,160
أَلسنا هُنا لمنع حُدوث ذلك؟

318
00:19:21,720 --> 00:19:24,010
.سنُواصل القيام بمهامّنا البسيطة

319
00:19:24,750 --> 00:19:31,520
لا يَسعُنا إضاعة الوقت مِن أجل شاةٍ تموت
.فِداءً لتَصون حياة تسعٍ وتسعين شاةً أُخرى

320
00:19:31,730 --> 00:19:32,870
.أنت مخطئٌ

321
00:19:33,430 --> 00:19:37,160
كان أَجدر بك أن تُدرك أنّ لتلك
.الشّاة المُنفردة اسمًا أيضًا

322
00:19:37,990 --> 00:19:41,060
أَما زِلت تذكر قصّة السّلحفاة
الّتي رَويتها لي؟

323
00:19:41,680 --> 00:19:43,920
حتّى تلك السّلحفاة كانت
تملك اسمًا، أليس كذلك؟

324
00:19:44,740 --> 00:19:49,910
نال مِنك الحُزن حين دُهست، واستشطت
.غضبًا ضدّ ذلك البَطش العشوائيّ

325
00:19:50,370 --> 00:19:54,450
يجب علينا في المِيبورو أن ننظر
.لكُلّ فردٍ بذات القَدر مِن الاهتمام

326
00:19:54,630 --> 00:19:58,550
فمَن سيَفهم مواجع النّاس
إن لم نفعل نحن؟

327
00:20:04,620 --> 00:20:07,120
،هذا ليس مُضحكًا إطلاقًا
.سيريزاوا-سان

328
00:20:08,680 --> 00:20:09,470
ماذا؟

329
00:20:10,320 --> 00:20:12,220
كيف أُصبت بهذا الجُرح؟

330
00:20:15,830 --> 00:20:17,940
.لا أُبالي بأسماء السّلاحف أيًا كانت

331
00:20:18,720 --> 00:20:19,880
.انصرفا مِن أمامي

332
00:20:21,370 --> 00:20:22,600
.ممتنٌّ لك يا سوجي

333
00:20:23,270 --> 00:20:25,770
،لولا وُجودك
.لكُنت هالكًا لا محالة

334
00:20:27,490 --> 00:20:28,150
،أجل

335
00:20:29,480 --> 00:20:31,520
.ذلك الرّجل وحشٌ كاسر

336
00:20:34,400 --> 00:20:37,640
قرّرت مُرافقة سيريزاوا-سينسي
.في نهاية المَطاف

337
00:20:38,300 --> 00:20:38,970
.تارو-كون

338
00:20:39,600 --> 00:20:42,960
،أنا قلقٌ، كما تعلم
.بشأن هذا الأمر وذاك

339
00:20:43,550 --> 00:20:45,060
.أجل، أظنّها فِكرةً جيّدة

340
00:20:45,960 --> 00:20:47,860
على كُلّ حالٍ، نحن نعيش
.جميعًا تحت سقفٍ واحد

341
00:20:48,810 --> 00:20:50,230
.لن يُحدث ذلك فرقًا كبيرًا

342
00:20:50,870 --> 00:20:51,350
.محقٌّ

343
00:20:51,900 --> 00:20:52,540
.أراكما لاحقًا أيّها الرّفيقين

344
00:20:56,620 --> 00:20:59,080
أَواثقٌ أنّك لم تُخطئ حين
تركته يمضي هكذا فحسب؟

345
00:21:00,490 --> 00:21:01,160
.أجل

346
00:21:02,760 --> 00:21:04,720
،طالما أنّنا نحن الثّلاثة مُترابطون

347
00:21:05,470 --> 00:21:06,360
.فسَنكون بخير

348
00:21:11,160 --> 00:21:12,360
—سيريزاوا-سينسي

349
00:21:19,810 --> 00:21:21,430
ما... ما هذا؟

350
00:21:25,580 --> 00:21:27,800
كيف انتهى به الأمر
مُصابًا بهذا الشّكل؟

351
00:23:21,170 --> 00:23:22,520
.سايتو هاجيمي يُحدّثكم

352
00:23:23,000 --> 00:23:26,470
تعيش جماعة المِيبورو حالةً مِن
.الفوضى بسبب المُجنّدين الجُدد

353
00:23:27,080 --> 00:23:30,680
الدّوجو مكتظٌّ، والنّزاعات
.تندلع بين الحين والآخر

354
00:23:31,080 --> 00:23:35,490
إنّنا على شفا كارثةٍ، لذا
...اعتزمنا تعيين قائدٍ، ولكن

355
00:23:36,400 --> 00:23:39,770
ماذا؟ ساموراي غريب الأطوار
ظَهر في فوشيمي؟

356
00:23:40,630 --> 00:23:42,730
وترغب في أن أتقصّى أمره؟

357
00:23:43,420 --> 00:23:46,650
سُحقًا، هل يتعيّن عليّ
فِعل كُلّ شيءٍ هُنا؟

358
00:23:47,340 --> 00:23:49,000
."الحلقة القادمة: "سَيّئي الصّيت