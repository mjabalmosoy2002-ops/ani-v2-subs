1
00:00:00,440 --> 00:00:01,930
نَالوا مِن سيريزاوا؟

2
00:00:01,930 --> 00:00:03,930
.لا أَكاد أُصدّق ذلك

3
00:00:02,970 --> 00:00:04,720
.يقولون إنّ مُغتالين قد تسلّلوا خِفيةً

4
00:00:06,430 --> 00:00:09,110
!سيريزاوا-سينسي

5
00:00:14,780 --> 00:00:17,520
كُلّ هذا جرى بينما كُنت
.غائبًا في أوساكا

6
00:00:26,910 --> 00:00:29,080
،تارو
.ودّع مُعلّمك الوَداع الأخير

7
00:01:01,250 --> 00:01:05,540
سينسي، لم أُوفِك أدنى جُزءِ
.ممّا كُنت مدينًا لك به

8
00:01:09,280 --> 00:01:11,080
.إنّه ليومٌ حَزين

9
00:01:11,950 --> 00:01:16,960
واجبٌ علينا أن نُودّع سيريزاوا-سينسي
.العَزيز على قُلوبنا

10
00:01:17,590 --> 00:01:20,810
فقد كان أوّل مَن تقلّد
،مَقاليد القيادة العُليا

11
00:01:20,810 --> 00:01:23,500
.بَذل نفسه لتَأسيس المِيبورو

12
00:01:23,840 --> 00:01:30,480
أحببناه جميعًا لعَظمته، ولطالما
.تَقدّم صُفوفنا في كُلّ ميدانٍ

13
00:01:30,810 --> 00:01:34,000
،تأمّلوا كُلّ ما قدّمه لأَهل كيوتو

14
00:01:34,000 --> 00:01:36,200
.وكم أَشاع الطّمأنينة في رُبوعها

15
00:01:36,980 --> 00:01:39,830
لم يُخيّل لي قطٌّ أنّه سيَسقط
.صريعًا بنَصل مُغتالٍ

16
00:01:42,800 --> 00:01:45,200
.عملٌ رائع، يا يامانامي-سان

17
00:01:45,410 --> 00:01:49,200
كلا، ليس هذا الخِطاب
.الّذي أَعددته له

18
00:01:50,180 --> 00:01:52,800
لا بُدّ أنّ كوندو-سان يَنطق
.بما يَختلج في صدره

19
00:01:53,630 --> 00:01:58,040
أمّا مَن بَقي منّا، فسَيمضون
،على خُطى سيريزاوا-سينسي

20
00:01:58,040 --> 00:02:02,740
وسنَبذل قُصارى جُهدنا
...سعيًا خلف غايتنا

21
00:02:02,740 --> 00:02:07,210
في حماية كيوتو كسَاموراي
.مُخلصين وأوفياء للوطن

22
00:02:12,390 --> 00:02:15,290
،إن كُنت لا تشعر أنّك بخيرٍ
.فاذهب لتَرتاح في الخلف

23
00:02:15,770 --> 00:02:17,950
.لم يَتبقّ سِوى مَراسم الدّفن

24
00:02:19,490 --> 00:02:20,530
.تارو-كون

25
00:02:46,800 --> 00:02:51,070
لم تَعد المِيبورو تلك الجماعة
.الّتي كُنت تَرتجيها

26
00:02:51,070 --> 00:02:53,020
.وأنا موقنٌ أنّك تُبصر ذلك

27
00:04:23,520 --> 00:04:26,740
يبدو أنّ هَطيل المطر
.قد أَذهب معه الصّيف

28
00:04:27,720 --> 00:04:32,000
،رَفعت تقريرنا للمُفوّض
.وسوّيت المَسألة مع آيزو

29
00:04:32,510 --> 00:04:34,380
.كُلّ شيءٍ يَسير كما رُسم له

30
00:04:35,560 --> 00:04:36,510
.كوندو-سان

31
00:04:39,750 --> 00:04:40,630
ماذا؟

32
00:04:40,920 --> 00:04:44,250
،إليك مِعطف سيريزاوا
.خُذه وارتده

33
00:04:44,860 --> 00:04:46,330
.لا يُمكنني ارتداؤه

34
00:04:47,000 --> 00:04:50,050
سأَحمل أعباء المِيبورو على
.كَاهلي دُونه

35
00:04:53,640 --> 00:04:55,520
هل أَجهزت عليه؟

36
00:04:58,570 --> 00:05:00,440
.علينا أن نتحدّث بشأن ذلك

37
00:05:02,920 --> 00:05:03,840
هاجيمي؟

38
00:05:04,410 --> 00:05:06,330
.أخبرني أنا أيضًا

39
00:05:09,000 --> 00:05:10,720
ماذا حدث في تلك اللّيلة؟

40
00:05:12,030 --> 00:05:12,870
.كوندو-سان

41
00:05:18,660 --> 00:05:20,460
.إذًا، هكذا جَرت الأمور

42
00:05:23,460 --> 00:05:25,960
.فهمت، هذا يُفسّر الكثير

43
00:05:26,800 --> 00:05:29,480
.حسنًا، فرغت ممّا لديّ هُنا

44
00:05:29,480 --> 00:05:30,260
.هاجيمي

45
00:05:30,560 --> 00:05:32,100
كيف حال تارو؟

46
00:05:33,420 --> 00:05:38,420
إنّ الطّريقة الّتي مات بها
.سيريزاوا، لا بُدّ أنّها تُؤرّقه

47
00:05:38,970 --> 00:05:42,440
ماذا لو رَاودته فِكرة مُرافقة
مُعلّمه في مَوته؟

48
00:05:42,640 --> 00:05:46,690
،لم نَعد صِغارًا
.وهُو ليس بهذه الهَشاشة

49
00:05:47,650 --> 00:05:48,740
هكذا إذن؟

50
00:05:49,440 --> 00:05:51,570
.أَكاد أُجزم أنّه يحمل ضغينةً ضدّي

51
00:05:52,610 --> 00:05:54,680
.أنت معتادٌ على لَعب دور الشّرير

52
00:05:57,810 --> 00:05:58,500
.توشي

53
00:05:59,480 --> 00:06:01,960
.قد يُقرّر نيو تركنا

54
00:06:02,300 --> 00:06:03,580
—وإن فَعل ذلك

55
00:06:02,580 --> 00:06:03,580
.كوندو-سان

56
00:06:04,780 --> 00:06:07,460
،أنا مَن جَلبته إلى المِيبورو

57
00:06:08,160 --> 00:06:12,660
،سأَرعاه حتّى النّهاية
.مهما كلّف الثّمن

58
00:06:16,050 --> 00:06:20,940
كان حُضور سيريزاوا كامو
.طاغيًا للغاية

59
00:06:23,110 --> 00:06:26,380
،بعد غيابه
.تبدّل حال المِيبورو

60
00:06:28,230 --> 00:06:32,920
بدأنا بتَصفية جاسوس لـ تشوشو
.كان مُندسًا في صُفوفنا

61
00:06:33,520 --> 00:06:37,040
.ثُمّ أَتبعناه بآخرين

62
00:06:39,410 --> 00:06:41,960
ولكي نَجعل أعداءنا يتخلّون
...عن حذرهم

63
00:06:45,660 --> 00:06:49,090
.لَجأنا حتّى إلى الحِيل القاسية

64
00:06:58,080 --> 00:06:59,350
.هيجيكاتا-سان

65
00:06:59,710 --> 00:07:01,730
.إنّ النّهج الّذي نَسلكه ليس بقويمٍ

66
00:07:03,500 --> 00:07:07,600
هل أدار المِيبورو ظُهورهم
لرَاية الإخلاص؟

67
00:07:07,600 --> 00:07:11,080
،الإخلاص جَوهره في نوايانا
.لا في سُبل تَنفيذنا

68
00:07:11,080 --> 00:07:15,620
إن كان هذا هُو الحال، فقد كان
.حريًا بنا إبقاء سيريزاوا-سان معنا

69
00:07:15,620 --> 00:07:19,080
،إن بَدا علينا الضّعف
.تَهاوى تنظيم صُفوفنا

70
00:07:19,400 --> 00:07:22,960
،علينا استئصال أَمثالهم
.بأيّ طريقةٍ كانت

71
00:07:25,120 --> 00:07:30,400
نيو، يبدو أنّني أَفرطت
.في الرّفق بك

72
00:07:30,780 --> 00:07:32,830
،لن أَتعامل معك كصبيٍ بعد الآن

73
00:07:32,830 --> 00:07:35,270
.بل سأُقحمك في أيّ مُهمّةٍ أراها

74
00:07:37,090 --> 00:07:40,310
.لن أَدعك تَتحكّم بي

75
00:07:45,600 --> 00:07:46,520
هل أنت متيقّنٌ؟

76
00:07:47,800 --> 00:07:49,320
.لا بأس عندي بذلك

77
00:07:50,610 --> 00:07:51,690
!هذا فظيعٌ

78
00:07:53,330 --> 00:07:57,360
زَعمت أنّ المَرء لا يُعاب على
،الخسارة، يا ناغاكورا-سينسي

79
00:07:57,640 --> 00:08:01,960
لكن ذلك المَدعو سيريزاوا قد مات، ومع
ذلك تبدّل حال المِيبورو، أَليس كذلك؟

80
00:08:02,180 --> 00:08:03,580
!إنّ هذا أَقسى مَصيرٍ

81
00:08:06,920 --> 00:08:10,520
،أجل
.رُبّما أنّكِ محقّةٌ في ذلك

82
00:08:11,530 --> 00:08:12,760
...ولكن أَتعلمين

83
00:08:13,830 --> 00:08:18,780
تمكّن البعض مِن التغيّر
.لأَجل رَجلٍ خُذل في مَسعاه

84
00:08:21,810 --> 00:08:23,140
.هاجيمي-كون

85
00:08:25,000 --> 00:08:26,610
كيف سارت مُهمّتك؟

86
00:08:28,550 --> 00:08:31,400
.أنا لا أشعر بالشّفقة تِجاهك

87
00:08:31,880 --> 00:08:33,320
.تلك هي سُنّة الحياة

88
00:08:36,200 --> 00:08:40,260
،إذا كان هذا القَدر كافيًا ليَكسر شَوكتك
.فلم تكُن ذا شأنٍ يُذكر على أيّ حالٍ

89
00:08:40,850 --> 00:08:42,750
،وإن كُنت لا تَقوى على الاحتمال
.فاذهب لتَنام حتّى تَستفيق

90
00:08:55,040 --> 00:08:58,930
ما بَالك مُنطويًا على نفسك؟
!قِف شامخًا

91
00:08:59,500 --> 00:09:03,460
،كَفاك عَبوسًا وتشاؤمًا
!اضحك، ابتسم

92
00:09:10,420 --> 00:09:11,770
.سيريزاوا-سان

93
00:09:17,990 --> 00:09:19,130
.تارو-كون

94
00:09:26,050 --> 00:09:27,900
،نيو
.تَناهى إلى مَسامعي ما جرى

95
00:09:30,070 --> 00:09:33,760
،أنت مَن أَجهز على سيريزاوا-سينسي
أَليس كذلك؟

96
00:09:38,070 --> 00:09:39,200
—أنا في غاية الـ

97
00:09:38,070 --> 00:09:39,200
.كفاك اعتذارًا

98
00:09:40,570 --> 00:09:42,640
،أَجزم أنّ تلك كانت رَغبته
صحيحٌ؟

99
00:09:43,400 --> 00:09:46,470
.أنا لم أُفلح حتّى في الوصول إليه

100
00:09:47,100 --> 00:09:49,110
.لم أَكن أملك القُوّة الكافية

101
00:09:49,620 --> 00:09:51,240
.كان رَجلًا عظيمًا بحقٍ

102
00:09:51,680 --> 00:09:54,070
.ولم أَقدر يومًا على فَهم مَكنونه

103
00:09:54,860 --> 00:09:56,650
،قضى سيريزاوا كامو نَحبه

104
00:09:57,500 --> 00:09:59,080
.ورَحل عن عالمنا

105
00:10:01,560 --> 00:10:04,290
.سلّمت بذلك وتَصالحت مع مَوته

106
00:10:05,200 --> 00:10:08,700
ورُغم ذلك، فإنّ مَرارة العيش
.دُونه تَغلبني أحيانًا

107
00:10:09,910 --> 00:10:13,890
لكنّني أَدركت أنّه لا يُمكنني
.الاستمرار في البُكاء إلى الأبد

108
00:10:15,260 --> 00:10:17,470
.لذا عَزمت أن أبتسم غدًا

109
00:10:18,190 --> 00:10:20,880
"واليوم هُو ذلك "الغد
.الّذي وَعدت نفسي به

110
00:10:25,310 --> 00:10:27,820
.ابتسم أنت أيضًا، يا نيو

111
00:10:30,900 --> 00:10:31,720
لماذا؟

112
00:10:32,890 --> 00:10:36,240
كيف لك أن تَلقاني بمِثل
هذه المَودّة؟

113
00:10:39,560 --> 00:10:43,490
لا يُمكن أن يكون تَقبّل الأمر
.بهذه البَساطة

114
00:10:45,510 --> 00:10:47,410
،ليس بسيطًا

115
00:10:48,210 --> 00:10:49,790
.ولم يكن سهلًا قطٌّ

116
00:10:51,080 --> 00:10:52,290
...ولكن

117
00:10:53,150 --> 00:10:54,130
ولكن ماذا؟

118
00:10:55,240 --> 00:10:56,840
،دَعك مِن هذا
.لدينا مهمّةٌ لنُنجزها

119
00:10:56,840 --> 00:10:59,490
،هيّا، تأهّب
.لنَلتقِ عند جسر جوجو

120
00:11:01,480 --> 00:11:03,800
،نيو
هل لديك متّسعٌ مِن الوقت؟

121
00:11:03,800 --> 00:11:05,260
ناغاكورا-سان؟

122
00:11:08,560 --> 00:11:09,320
!نيو

123
00:11:09,620 --> 00:11:10,560
!أنا هُنا

124
00:11:11,440 --> 00:11:12,340
!تارو-كون

125
00:11:12,340 --> 00:11:13,640
.انظر، هُنا تمامًا

126
00:11:14,590 --> 00:11:17,490
،فهمت
.هذا بفِعل العاصفة المُمطرة

127
00:11:18,020 --> 00:11:18,620
!يا هذا

128
00:11:18,020 --> 00:11:20,910
أجل، لديهم عَجزٌ في
.عدد الرّجال

129
00:11:18,620 --> 00:11:19,810
!أَسرعوا

130
00:11:19,810 --> 00:11:21,470
!انقلوا أَكياس الرّمل هذه

131
00:11:21,730 --> 00:11:23,080
!نحن بحاجةٍ إلى المَزيد مِن الرّجال

132
00:11:21,740 --> 00:11:24,030
.سُحقًا، إنّه ثقيلٌ جدًا

133
00:11:24,030 --> 00:11:26,880
،إنّه هاجيمي
!إذًا لم يتخلّف عن الحُضور

134
00:11:30,350 --> 00:11:31,520
هل فَعل هاجيمي-كون ذلك حقًا؟

135
00:11:32,000 --> 00:11:32,760
.أجل

136
00:11:37,190 --> 00:11:40,470
.بَلغني أيضًا ما حدث مع سيريزاوا

137
00:11:40,690 --> 00:11:43,480
،أَفضى هاجيمي بالحقيقة إلى تارو

138
00:11:43,650 --> 00:11:46,600
.واستماحه عُذرًا لأَجلك

139
00:11:46,750 --> 00:11:50,220
تبًا، سنَتّسخ حتمًا
.ونحن نقوم بهذا

140
00:11:50,670 --> 00:11:58,740
،بذل تارو قُصارى جُهده ليَصرفه
.لكنّه أبى إلّا المُكوث

141
00:12:01,010 --> 00:12:05,290
كما أنّه وصل لتوّه بعد أن قَضى
.على ميكورا، ذلك الجَاسوس الآخر

142
00:12:06,070 --> 00:12:09,120
.رُبّما كانت تلك أوّل مرّةٍ يقتل فيها

143
00:12:09,860 --> 00:12:14,080
لعلّه لم يُطق أن تتحمّل
.أنت وحدك هذا العِبء

144
00:12:14,780 --> 00:12:19,740
لا أحد يعلم ما الّذي
.يَنهش المَرء مِن داخله

145
00:12:21,290 --> 00:12:25,480
إنّ ما يَربطكما أسمى مِن الّذين تعاهدوا
.على الإخاء بعد أن شَربوا مِن كأسٍ واحدة

146
00:12:28,080 --> 00:12:29,190
!أنتما هُناك

147
00:12:29,400 --> 00:12:30,810
.تبًا، وَقعت عينه علينا

148
00:12:30,810 --> 00:12:33,770
ما بالكما واقفين دُون حِراكٍ؟
!هيّا، شاركونا العمل

149
00:12:33,770 --> 00:12:34,940
.لنَمضِ يا نيو

150
00:12:34,940 --> 00:12:35,650
.حسنًا

151
00:12:37,320 --> 00:12:42,320
أرى أنّ القُدرة على إراقة الدّم لأَجل
...مَن لا تربطك به صلة رَحمٍ

152
00:12:43,090 --> 00:12:46,620
.خيرُ دليلٍ على الصّداقة الحقيقيّة

153
00:12:51,460 --> 00:12:54,660
.إنّ هذا ثقيلٌ للغاية

154
00:12:55,310 --> 00:12:57,990
حسنًا، سأَتولّى أنا سدّ هذه
.الشُقوق بالطّين

155
00:12:57,990 --> 00:12:59,800
!لا تَختر لنَفسك العمل اليسير

156
00:13:00,640 --> 00:13:04,090
صحيحٌ، يقول فوجيموتو-سان
.وصَحبه إنّهم سيُغادرون المِيبورو

157
00:13:04,340 --> 00:13:08,760
حسنًا، كان هؤلاء الرّجال أتباعًا
.مُخلصين لـ سيريزاوا-سان

158
00:13:08,760 --> 00:13:11,960
،مهلًا، أنت لا تَنوي الرّحيل معهم
أليس كذلك؟

159
00:13:12,400 --> 00:13:15,680
إيّاك أن تُحاول إقناعي أنّ عهد المِيبورو
...قد ولّى برَحيل سيريزاوا-سان أو

160
00:13:16,060 --> 00:13:17,860
.لم يَنتهِ أمر المِيبورو بعد

161
00:13:18,980 --> 00:13:24,070
بين صُفوفنا آخر ساموراي حقيقيّ في
.العالم أَجمع، كان هذا رأي سيريزاوا-سان

162
00:13:26,460 --> 00:13:27,750
تَقصد كوندو؟

163
00:13:28,010 --> 00:13:31,160
أجل، قال إنّ المِيبورو
.في مأمنٍ معه

164
00:13:31,760 --> 00:13:35,280
هل كانت مِيتة سيريزاوا-سان مهيبةً؟

165
00:13:36,980 --> 00:13:38,710
أجل، كانت الأكثر جَلالًا
.على الإطلاق

166
00:13:38,970 --> 00:13:39,830
.فهمت

167
00:13:42,100 --> 00:13:46,040
أَتذكر حين أخبرتني
ذات مرّةٍ أنّ للبشر أرواحًا؟

168
00:13:47,480 --> 00:13:48,400
.أجل

169
00:13:49,360 --> 00:13:51,370
تُرى، ما الّذي يحدث لأَرواحنا
بعد الموت؟

170
00:13:52,410 --> 00:13:54,750
هل تَمضي لتَستوطن النّباتات؟

171
00:13:55,310 --> 00:13:58,260
أم تُحلّق عاليًا في السّماء
لتَستحيل طُيورًا؟

172
00:13:59,030 --> 00:13:59,910
.أنا آسفٌ

173
00:14:00,840 --> 00:14:04,690
،أعلم ما قُلته لك حينها
.لكنّني لا أملك جوابًا لسُؤالك

174
00:14:06,520 --> 00:14:09,960
ومع ذلك، فأنا لا أَزال
.أُؤمن بوجود الأرواح

175
00:14:10,630 --> 00:14:12,990
...عندما تَقاتلا، راودني شعورٌ

176
00:14:13,790 --> 00:14:19,070
بأنّ رُوحيّ كوندو-سان
.وسيريزاوا-سان قد تَلاقتا

177
00:14:23,710 --> 00:14:28,220
.أكّد لي سيريزاوا-سان صِدق حَدسي

178
00:14:29,970 --> 00:14:32,480
.لذا، أُريد مُساعدة الضّعفاء والمُحتاجين

179
00:14:33,660 --> 00:14:35,010
...عَقدت العزم

180
00:14:35,550 --> 00:14:39,150
سأَعمل في خدمة المِيبورو
.تحت لِواء كوندو-سان

181
00:14:40,050 --> 00:14:41,480
ذلك العهد الّذي استودعنا
.إيّاه سيريزاوا-سان

182
00:14:43,200 --> 00:14:44,480
حقًا؟

183
00:14:44,790 --> 00:14:47,480
.هذا يَبعث على الارتياح

184
00:14:48,120 --> 00:14:50,860
.أنا أيضًا لديّ ما أودّ قوله

185
00:14:53,680 --> 00:14:55,640
!تاناكا؟

186
00:14:55,640 --> 00:14:59,380
ما هذا الاسم اللّعين؟ هل كان
.عاجزًا عن أن يَمنحني اسمًا ذا شأنٍ

187
00:14:59,380 --> 00:15:04,840
حينما أَهوي إلى الجحيم، سأُرغم سيريزاوا-سان
.على أن يشرب معي مُجدّدًا كنِدٍ له

188
00:15:04,840 --> 00:15:06,270
كنِدٍ له؟

189
00:15:06,270 --> 00:15:08,350
،أنصتا جيّدًا

190
00:15:09,230 --> 00:15:13,470
،بِدءًا مِن الآن
.اسمي هُو سيريزاوا تارو

191
00:15:15,700 --> 00:15:20,390
لعلّ جُزءًا مِن رُوح سيريزاوا-سان
يَستوطن داخلي، أَليس كذلك؟

192
00:15:21,720 --> 00:15:25,820
وسأَجعلكم جميعًا تهتفون
.باسمي تارو-ساما ذات يومٍ

193
00:15:28,480 --> 00:15:30,070
.ثمّة ما أودّ قوله أيضًا

194
00:15:30,540 --> 00:15:33,780
تظنّان أنّكما انتصرتما عليّ؟

195
00:15:35,700 --> 00:15:39,210
.أعترف أنّكما غَلبتُماني هذه المرّة

196
00:15:39,940 --> 00:15:42,280
.نِلت منّي حقًا يا تارو

197
00:15:42,780 --> 00:15:45,710
،وأنت يا نيو
.تحمّلت المسؤوليّة الأكبر

198
00:15:46,790 --> 00:15:51,630
،كلاكما أَبلى بلاءً أفضل ممّا فَعلت
.لا جِدال في ذلك

199
00:15:54,450 --> 00:15:55,600
...ولكن رُغم هذا

200
00:15:55,600 --> 00:15:57,500
!لن أَرضى بالهزيمة

201
00:15:57,500 --> 00:16:00,720
،لن أُغلب أمامكما أبدًا
!ليس بعد الآن

202
00:16:01,760 --> 00:16:04,690
.لا سِيّما أمامكما أنتما بالذّات

203
00:16:05,200 --> 00:16:06,350
.هاجيمي

204
00:16:07,450 --> 00:16:08,630
.هاجيمي-كون

205
00:16:11,860 --> 00:16:13,670
ما الّذي يُضحكك؟

206
00:16:13,670 --> 00:16:15,390
،المعذرة

207
00:16:16,020 --> 00:16:18,800
لكنّي لا أَقوى على تمالك نفسي
.أمام مَنظر غُرّتك المُضحك

208
00:16:19,670 --> 00:16:21,630
!أنت مَن قصّها أيّها الأحمق

209
00:16:21,630 --> 00:16:23,410
!هاجيمي-كون، اهدأ

210
00:16:21,630 --> 00:16:24,560
!دَعني، كُفّ يديك عنّي يا نيو

211
00:16:25,670 --> 00:16:28,190
،هُزمت
.وعليك أن تَعترف بذلك

212
00:16:29,610 --> 00:16:31,550
.أَرني ما لديك إذن يا نيو

213
00:16:33,710 --> 00:16:36,640
.تملّكته رُوح سيريزاوا

214
00:16:34,910 --> 00:16:36,640
.أبدِ قليلًا مِن الاحترام للموتى

215
00:16:36,640 --> 00:16:38,890
حتّى سيريزاوا لم يكُن
.كثير الضّحك هكذا

216
00:16:38,880 --> 00:16:42,560
كُنت أعلم أنّك ستَأتي لتَفقّد
.أحوالهم أيضًا يا ناغاكورا-سان

217
00:16:42,560 --> 00:16:43,360
.سوجي

218
00:16:44,050 --> 00:16:48,740
يبدو أنّهم سيُسوّون نزاعاتهم
.قبل أن يفعل المِيبورو ذلك

219
00:16:50,530 --> 00:16:55,860
أُولئك الّذين تَنعقد روابطهم بالقُلوب هُم
.أشدّ صِدقًا، فهُم لا يُقيمون للمَظاهر وزنًا

220
00:16:55,860 --> 00:16:59,990
،تبًا لك يا سيريزاوا
!تعال وتملّكني أنا أيضًا

221
00:16:59,250 --> 00:17:01,390
!بحقّك، كُفّ عن هذا الهُراء

222
00:17:03,080 --> 00:17:04,880
.هذا العالم قاسٍ

223
00:17:06,220 --> 00:17:08,160
،الجميع فيه منخرطٌ في صراعٍ

224
00:17:08,600 --> 00:17:10,600
،كُلٌّ في ميدانه

225
00:17:11,160 --> 00:17:13,010
وفوق كاهل كُلّ منّا
.أعباء يَثقل حملها

226
00:17:13,640 --> 00:17:15,420
،نضطرّ أحيانًا لإزهاق الأرواح

227
00:17:15,880 --> 00:17:18,100
.وأحيانًا لاتّخاذ قراراتٍ مَنزوعة الرّحمة

228
00:17:18,760 --> 00:17:22,120
لكنّنا نُواصل القتال وسط
.هذا الطّوفان مِن المُتغيّرات

229
00:17:23,260 --> 00:17:27,100
،لعلّنا إن ثابرنا في كِفاحنا وتَرحالنا

230
00:17:27,750 --> 00:17:30,280
سنَجد الخلاص ينتظرنا
.حتمًا في مكانٍ ما

231
00:17:30,840 --> 00:17:34,630
،لا أَملك الآن سِوى اليقين بذلك
.والمُضيّ قُدمًا في طريقي

232
00:17:36,270 --> 00:17:40,170
أَقاموا ضريحًا لـ سيريزاوا-سان
.وهيراياما-سان هُنا في معبد ميبو

233
00:17:40,760 --> 00:17:42,720
إذن سيَظلّان مِن الميبورو
حتّى بعد موتهما؟

234
00:17:42,720 --> 00:17:44,540
.أظنّ أنّ هذا يَليق بهما قطعًا

235
00:17:45,330 --> 00:17:46,080
.أجل

236
00:17:47,650 --> 00:17:52,840
ومع ذلك، فَقدنا الكثير مِن الرّجال، رُغم
.استمرارنا في استقطاب المُستجدّين

237
00:17:53,950 --> 00:17:55,820
.لست على يقينٍ من ذلك

238
00:18:03,010 --> 00:18:06,910
إذن، هذا هُو المكان الّذي أَقام فيه
السّاموراي العظيم سيريزاوا-دونو؟

239
00:18:07,420 --> 00:18:10,260
،أنا تانيسابورو
،سيّد الرّماح ذُو الألف كوكو

240
00:18:10,260 --> 00:18:13,360
جِئت بأَتباعي إلى ميبو
.لنَخوض معكم القتال

241
00:18:13,910 --> 00:18:16,240
.أظنّ أنّ هذا ما أَورثنا إيّاه سيريزاوا

242
00:18:18,070 --> 00:18:20,050
.نيو، لقد عدتُ

243
00:18:21,230 --> 00:18:24,280
،أنت تَذكرني حتمًا
!أنا فوكوروكوجي

244
00:18:24,280 --> 00:18:25,920
،جَعلتكم تنتظرون طويلًا
أَليس كذلك؟

245
00:18:26,100 --> 00:18:26,910
مَن هذا؟

246
00:18:27,370 --> 00:18:28,340
.لا أَعرفه

247
00:18:28,340 --> 00:18:30,760
لن تكون هذه آخر مرّةٍ
!تراني فيها

248
00:18:30,760 --> 00:18:33,590
!تذكّر ذلك جيّدًا

249
00:18:33,590 --> 00:18:34,920
!فوكوروكوجي-سان

250
00:18:35,120 --> 00:18:37,070
.أَمعنوا النّظر في هيئتي

251
00:18:37,070 --> 00:18:40,970
،سأُريكم بأس فوكوروكوجي العظيم
.بعد أن بُعثت مِن جديد جسدًا ورُوحًا

252
00:18:42,860 --> 00:18:45,590
لن تكون بهذه العَظمة أبدًا إن
.كان جوهرك يتبدّل تبعًا لمَظهرك

253
00:18:46,150 --> 00:18:47,480
مِن أين أَتت كُلّ هذه الفظاظة؟

254
00:18:47,480 --> 00:18:49,650
ما الّذي حلّ بـ نيو لطيفُ المَعشر؟

255
00:18:51,650 --> 00:18:53,910
،أُدرك أنّ هذا مَطلب لُورد آيزو

256
00:18:53,910 --> 00:18:57,440
لكنّي لا أَكاد أُصدّق أنّنا سنُغيّر
.مُسمّى ميبو روشيغومي

257
00:18:59,880 --> 00:19:00,640
.توشي

258
00:19:01,670 --> 00:19:04,530
سأَحمل لِواء جماعة المِيبورو الّتي
.أرسى دعائمها سيريزاوا-سان

259
00:19:05,600 --> 00:19:07,000
.لا قِيمة للاسم عندي

260
00:19:11,100 --> 00:19:11,850
.خُذه

261
00:19:12,870 --> 00:19:18,790
هذا المِعطف الأبيض الّذي كان يخصّ
.سيريزاوا سيَكون بُرهانًا على مدى التزامك

262
00:19:19,240 --> 00:19:21,420
.أخبرتك أنّني لن أَرتديه

263
00:19:21,420 --> 00:19:24,310
لن تَتزعزع عزيمتي أبدًا
.دُون هذا المِعطف

264
00:19:29,300 --> 00:19:30,930
مـ-ما الّذي تَفعله؟

265
00:19:31,200 --> 00:19:36,030
لن تَقوى على ذلك وحدك، فأَنت تفتقر
.إلى ذاك الجُنون الّذي كان يَتملّكه

266
00:19:38,650 --> 00:19:41,160
.سأَضع أنا هذا الكُمّ الواحد

267
00:19:41,840 --> 00:19:44,680
وثِق بي لأَحمل معك
.ثِقل جماعة المِيبورو

268
00:19:45,570 --> 00:19:48,980
سأَتولّى عنك القيام بالمهامّ
.الّتي لا تُطيقها أنت

269
00:19:54,660 --> 00:19:55,640
.لك ذلك

270
00:20:00,480 --> 00:20:01,210
.لنَمضِ إذن

271
00:20:04,830 --> 00:20:08,680
مَن ذا الّذي مَنح تلك الجماعة
كيانها الجَوهري؟

272
00:20:09,150 --> 00:20:12,130
لم تكُن المَبادئ ولا الفلسفات
.إلّا مظاهر خارجيّةً

273
00:20:12,700 --> 00:20:17,600
،ولا الدّين، ولا القَانون، ولا الواجب، ولا الغاية
.هِي الّتي أَودعت فيها ذاك الجَوهر

274
00:20:18,160 --> 00:20:21,490
،لرُبّما كان أيّ قائدٍ كفيلًا بقيادتنا

275
00:20:21,810 --> 00:20:24,360
فاليَد الَتي تُوجّهنا كانت
،قابلةً للاستبدال

276
00:20:24,360 --> 00:20:29,080
،ومهما كان عدد الأركان الّتي أقامت صَلبنا
.فلا ريب عندي في أنّنا كنا سنُواصل المُضيّ قُدمًا

277
00:20:29,750 --> 00:20:34,720
إنّ جماعتنا النّادرة هذه لم يعرف الزّمان
.لها نظيرًا مِن قبل ولا مِن بعد

278
00:20:35,830 --> 00:20:39,720
.إذ انفردت برُوحٍ لا شبيه لها

279
00:20:40,810 --> 00:20:45,440
.أمّا اسمها فهُو: الشّينسينغومي

280
00:20:58,470 --> 00:21:01,280
،إنّها قصّة أرواحٍ

281
00:21:02,130 --> 00:21:05,030
.أرواحٌ تَدور في مساراتٍ لولبيّة

282
00:21:06,000 --> 00:21:10,520
حتّى لو فارقكَ مَن تُحبّ
...يومًا ما، فلَعلّ

283
00:21:17,670 --> 00:21:19,330
!إيوري

284
00:21:19,520 --> 00:21:21,110
!نحن في مأزقٍ يا إيوري

285
00:21:21,110 --> 00:21:23,760
!صِبية القرية المُجاورة يَشنّون هُجومًا

286
00:21:25,790 --> 00:21:28,560
لا تبقَ جاثيًا هكذا
.شارد الذّهن يا إيوري

287
00:21:28,560 --> 00:21:29,770
.تسوجوجي

288
00:21:29,770 --> 00:21:31,710
.أنا بحاجةٍ إلى عَونك

289
00:21:31,710 --> 00:21:32,880
...ولكن هذه السّلحفاة

290
00:21:33,400 --> 00:21:35,520
!يُمكنها الانتظار، دَعك منها

291
00:21:35,520 --> 00:21:37,320
!ها هُما هُناك، انظروا

292
00:21:37,320 --> 00:21:39,400
!ها قد وَصلوا

293
00:21:37,330 --> 00:21:38,450
!لنَنقضّ عليهم

294
00:21:39,400 --> 00:21:40,360
!هيّا

295
00:21:40,650 --> 00:21:41,540
.حسنًا

296
00:21:41,760 --> 00:21:44,460
!لنَسحقهم سَحقًا

297
00:21:45,460 --> 00:21:48,560
.إنّها قصّة أرواحٍ تتوارثها الأجيال