1
00:00:02,760 --> 00:00:04,760
إلى أين أنت ذاهبٌ؟

2
00:00:05,680 --> 00:00:06,670
.لأَقضي حاجتي

3
00:00:15,740 --> 00:00:17,060
ثلاث مِحفّات؟

4
00:00:17,060 --> 00:00:18,990
لمَن هِي؟
لـ سيريزاوا-سينسي ورِفاقه؟

5
00:00:18,990 --> 00:00:19,720
!نيو

6
00:00:20,670 --> 00:00:23,720
،إنّهم يتوجّهون نحو ميبو
.لا ريب أنّهم هُم

7
00:00:51,070 --> 00:00:51,970
.على مَهلك

8
00:00:52,190 --> 00:00:53,800
هاجيمي، ماذا تَفعل؟

9
00:00:55,280 --> 00:00:56,490
.تنحَّ عن طريقي

10
00:00:58,660 --> 00:01:00,580
.لا يُمكنني السّماح لك بالعُبور

11
00:01:03,350 --> 00:01:05,000
تُريد منّي أن أُنقذ تارو؟

12
00:01:05,610 --> 00:01:06,470
،هذا ما أَرجوه

13
00:01:07,120 --> 00:01:10,470
،فمَا زال صبيًا
.ولا أُريد له أن يَهلك

14
00:01:10,880 --> 00:01:14,480
تظنّ أنّ بمَقدوري صرفه عمّا
،يَبتغي؟ هيهات أن يَحدث ذلك

15
00:01:14,480 --> 00:01:17,270
.فوَلاؤه لـ سيريزاوا متجذّرٌ في الأعماق

16
00:01:17,530 --> 00:01:20,890
،أُدرك ذلك، لذا
.صُدّه عن المُضيّ قسرًا

17
00:01:22,600 --> 00:01:26,210
.عليه أن يُدرك أنّه لا يُجاريك قُوّةً

18
00:01:26,760 --> 00:01:29,950
.سيَرتاع حينما يَستشعر جِدّيتك

19
00:01:35,890 --> 00:01:38,350
،إن أردت تَجاوزي
.فأَرغمني على التّزحزح

20
00:01:38,820 --> 00:01:40,530
.لكن لا تَلُمني إن لَقيت حَتفك

21
00:01:50,570 --> 00:01:54,260
،هذا ما ظَننته
.يا لك مِن أحمق يا هيجيكاتا

22
00:01:57,490 --> 00:01:59,720
،ليس تارو بصبيٍ

23
00:02:00,790 --> 00:02:03,970
ولم يَقطع كُلّ هذا الشّوط
.ليَتراجع جُبنًا في آخر لحظةٍ

24
00:03:45,360 --> 00:03:46,140
.حانت اللّحظة

25
00:03:46,570 --> 00:03:48,720
.لا شكّ أنّهم غارقون في سُباتٍ الآن

26
00:03:49,000 --> 00:03:50,420
.سنَمضي لتفقّد الوَضع

27
00:03:50,640 --> 00:03:51,530
.هيّا بنا يا سوجي

28
00:03:51,820 --> 00:03:52,510
.حسنًا

29
00:03:53,210 --> 00:03:55,710
،عليكما نَزع لثَامكما قبل الوُلوج

30
00:03:56,560 --> 00:04:00,260
.فسَيُثير مَنظركما ارتيابًا إن لمحكما أحدٌ

31
00:04:00,400 --> 00:04:01,370
.أعلم ذلك

32
00:04:05,480 --> 00:04:07,480
هل نَنزعه أيضًا؟
ما دامت الفُرصة سانحةً؟

33
00:04:07,800 --> 00:04:09,320
.رُويدك يا هارادا-سان

34
00:04:14,150 --> 00:04:15,330
ما هذا الضّجيج؟

35
00:04:17,060 --> 00:04:18,490
هل ثمّة أحدٌ هُناك؟

36
00:04:34,700 --> 00:04:36,570
أُمّي، ما الخَطب؟

37
00:04:39,730 --> 00:04:40,760
ماذا يَحدث؟

38
00:04:41,490 --> 00:04:44,200
.لا شيء، عُد إلى مَضجعك

39
00:04:51,040 --> 00:04:52,050
...بيت الخلاء

40
00:04:56,280 --> 00:04:58,070
،إيّاكِ أن تُصدري صوتًا
.وإلّا لَقيتِ حَتفكِ

41
00:04:58,680 --> 00:05:00,730
أنتِ إيتوساتو مِن نُزل
واتشيغايا، حَسبما أظنّ؟

42
00:05:03,680 --> 00:05:06,200
سيّد الدّار في اجتماعٍ
بمكانٍ آخر، أَليس كذلك؟

43
00:05:08,240 --> 00:05:10,010
هل سيريزاوا في الحُجرة الداخليّة؟

44
00:05:13,360 --> 00:05:15,100
.سأَبدأ الحَصر مِن أبعد مَقعدٍ

45
00:05:15,100 --> 00:05:16,010
.سيريزاوا

46
00:05:16,770 --> 00:05:17,560
.أومي

47
00:05:18,800 --> 00:05:19,720
.سيريزاوا

48
00:05:20,680 --> 00:05:21,520
.هيراياما

49
00:05:22,380 --> 00:05:23,290
.كيتشيي

50
00:05:23,910 --> 00:05:24,680
.هيراما

51
00:05:25,410 --> 00:05:26,140
هؤلاء فحسب؟

52
00:05:26,590 --> 00:05:28,360
.حسنًا، أشكركِ

53
00:05:31,920 --> 00:05:32,600
.خُذي هذا

54
00:05:36,210 --> 00:05:38,780
،ليس بالمَبلغ الطّائل
.لكنّه سيُغطّي نفقات السّفر

55
00:05:39,300 --> 00:05:40,860
.غادري هذا المكان فورًا

56
00:05:42,630 --> 00:05:48,660
انسي كُلّ ما سَلف، وما يَجري
.الآن، وما هُو آتٍ لا محالة

57
00:05:49,080 --> 00:05:53,420
،اقضي ليلةً في فوشيمي
.ثُمّ اعبري أوساكا وابتعدي قَدر ما تطيقين

58
00:05:53,920 --> 00:05:54,830
هل هذا واضحٌ؟

59
00:06:00,970 --> 00:06:02,370
متيقّنٌ أنّك تُريد إخلاء سبيلها؟

60
00:06:03,690 --> 00:06:05,990
،بعد ما حَدث لتوّه
.لن يَنالنا منها أيّ سُوءٍ بعد الآن

61
00:06:11,920 --> 00:06:13,960
إذن، سيريزاوا في الحُجرة الداخليّة؟

62
00:06:13,960 --> 00:06:15,800
.أجل، يبدو كذلك

63
00:06:15,800 --> 00:06:16,670
.جيّدٌ

64
00:06:17,160 --> 00:06:18,550
،سأَتولّى أنا وسوجي الجهة الخلفيّة

65
00:06:18,990 --> 00:06:20,810
بينما يتولّى يامانامي
.وسانوسكي المُقدّمة

66
00:06:22,150 --> 00:06:24,910
،دَعوا النّساء يرحلن
.وأَجهزوا على الرّجال الثّلاثة

67
00:06:26,090 --> 00:06:28,890
،أَغمضوا أعينكم
.لتَعتاد على الظّلام

68
00:06:35,680 --> 00:06:36,520
.افتحوها الآن

69
00:06:40,020 --> 00:06:41,110
هل ترون جيّدًا؟

70
00:06:41,110 --> 00:06:41,720
.أجل

71
00:06:43,240 --> 00:06:45,010
،عُدّوا حتّى المئة
.ثُمّ اقتحموا المكان

72
00:06:45,850 --> 00:06:46,660
.تفرّقوا

73
00:07:04,080 --> 00:07:06,600
...واحدٌ وثمانون، اثنان وثمانون

74
00:07:11,420 --> 00:07:12,210
.هذا غريبٌ

75
00:07:13,580 --> 00:07:15,610
ما بال هذا الضّوء يبدو ساطعًا هكذا؟

76
00:07:16,150 --> 00:07:19,200
...سبعةٌ وثمانون، ثمانيةٌ وثمانون

77
00:07:19,200 --> 00:07:21,580
...تسعةٌ وثمانون، تسعون

78
00:07:22,280 --> 00:07:23,050
...هيجيكاتا-سان

79
00:07:24,480 --> 00:07:26,590
،لا يَهمّ
.سنَمضي قُدمًا فيما انتوينا

80
00:07:28,770 --> 00:07:29,920
.أربعةٌ وتسعون

81
00:07:30,510 --> 00:07:31,720
.خمسةٌ وتسعون

82
00:07:32,550 --> 00:07:33,640
.ستّةٌ وتسعون

83
00:07:34,590 --> 00:07:35,860
.سبعةٌ وتسعون

84
00:07:36,580 --> 00:07:37,840
.ثمانيةٌ وتسعون

85
00:07:38,520 --> 00:07:39,910
.تسعةٌ وتسعون

86
00:07:41,280 --> 00:07:42,060
!مئةٌ

87
00:07:53,480 --> 00:07:55,870
.أهلًا بكُم

88
00:07:57,820 --> 00:08:00,660
".استخدموا امرأةً لاستدراجهم"

89
00:08:00,660 --> 00:08:05,370
كُلّ شيءٍ مضى وفق خُطّة
.نيمي حتّى اللّحظة

90
00:08:08,460 --> 00:08:11,150
إذن، هل سُرّبت خُطّتنا؟

91
00:08:11,150 --> 00:08:13,880
هل كان كُلّ ما نَطقت به
...إيتوساتو مُجرّد

92
00:08:17,680 --> 00:08:19,890
سُحقًا، لا يُمكن أن يَسوء
.الحال أكثر مِن ذلك

93
00:08:20,080 --> 00:08:26,600
،سيُعوّدون أبصارهم على الظّلام"
"...لذا استعينوا بضوءٍ ساطع

94
00:08:27,690 --> 00:08:29,640
".ليَسلبهم قُدرة الرّؤية..."

95
00:08:31,220 --> 00:08:33,140
...ما هذا
.لا أَكاد أُبصر شيئًا

96
00:08:33,140 --> 00:08:36,120
.كلا، وَقعنا في فخّه تمامًا

97
00:08:39,040 --> 00:08:40,090
.أنا أرى

98
00:08:40,090 --> 00:08:43,220
لا تُشكّل الظّلمة عائقًا
.ما دُمت أعلم أنّ الضّوء سيَنطفئ

99
00:08:48,270 --> 00:08:51,300
هل أنت مستعدٌّ للموت يا أوكيتا؟

100
00:08:57,640 --> 00:08:58,450
.أنا أرى

101
00:09:06,320 --> 00:09:08,760
ماذا جرى؟
مَن فَعل هذا؟

102
00:09:14,280 --> 00:09:18,000
،إن شَققت بطني
.فسَيتحرّك هيجيكاتا

103
00:09:18,540 --> 00:09:19,840
.وسيَنضمّ إليه أوكيتا

104
00:09:21,400 --> 00:09:26,970
مع اثنين آخرين، أي أربعةٌ في
.المُجمل، أو خمسةٌ على الأكثر

105
00:09:27,440 --> 00:09:32,500
،هارادا، تودو، إينوي، يامانامي
.وناغاكورا كُلّهم خياراتٌ مُحتملة

106
00:09:32,500 --> 00:09:35,190
وهل سيَتحرّك السيّد كوندو؟

107
00:09:35,190 --> 00:09:36,250
.لست أعلم

108
00:09:36,580 --> 00:09:39,990
،سيَرغب في ذلك
.بَيد أنّ القرار مرهونٌ بنَخوته ونُبله

109
00:09:40,260 --> 00:09:43,260
.لا أَكاد أطيق صبرًا

110
00:09:44,480 --> 00:09:46,520
.أنت لا تتبدّل أبدًا

111
00:09:47,830 --> 00:09:49,240
.لكن لتَبتهج

112
00:09:51,160 --> 00:09:53,780
.نحن مَن أوجدنا المِيبورو بأَيدينا

113
00:09:54,440 --> 00:09:56,520
.سيَكونون آخر وأَعظم خُصومنا

114
00:09:57,780 --> 00:09:59,650
فلمَاذا لا نجعلهم يُضفون بهاءً
على مشهد وداعنا الأخير؟

115
00:10:00,650 --> 00:10:03,620
،هلمّوا إليّ
.يا روائع ما صَنعت يداي

116
00:10:03,860 --> 00:10:05,790
!سيريزاوا

117
00:10:13,040 --> 00:10:17,510
!ما خطبك يا أوكيتا؟
!تقدّم، أَرني ما لديك

118
00:10:19,080 --> 00:10:20,000
!حسنًا

119
00:10:20,180 --> 00:10:22,100
.استعدت رُؤيتي

120
00:10:27,730 --> 00:10:28,740
امرأةٌ؟

121
00:10:28,740 --> 00:10:30,720
،أجل، صحيحٌ
.كانت هُناك أُخرى

122
00:10:34,520 --> 00:10:38,130
هارادا، أعلم أنّنا تجاوزنا
،الكثير معًا

123
00:10:38,130 --> 00:10:41,110
لكن مُناصرتك لـ كوندو هِي
.خاتمة آثامك في هذه الدّنيا

124
00:10:41,360 --> 00:10:42,870
!هيراياما

125
00:10:43,060 --> 00:10:44,560
!قُضي الأمر

126
00:10:49,620 --> 00:10:51,040
...لماذا؟ يا لك مِن

127
00:10:57,440 --> 00:11:01,170
هيراياما-سان، يُؤسفني أنّني
.مضطرٌّ لإزهاق رُوحك

128
00:11:06,080 --> 00:11:07,840
متمسّكٌ بمَوقفك، لن تَتزحزح؟

129
00:11:25,870 --> 00:11:28,210
ماذا دَهاك؟
هل هذا قُصارى جُهدك؟

130
00:11:29,520 --> 00:11:30,520
.تنحَّ عن طريقي

131
00:11:31,570 --> 00:11:34,040
!تنحَّ عن طريقي

132
00:11:42,330 --> 00:11:44,230
!سُحقًا، سُحقًا لكُلّ شيءٍ

133
00:11:51,540 --> 00:11:56,560
أَهداني سيريزاوا-سينسي هذا
!السّيف، وقد آن أوان سَطوته

134
00:12:01,820 --> 00:12:03,740
إنّ إمساكك للسّيف بيدك
.اليُسرى معيبٌ

135
00:12:04,270 --> 00:12:06,710
.لن تمدّ ضرباتك بأيّ قُوّةٍ هكذا

136
00:12:06,710 --> 00:12:08,630
أيّ تدريبٍ هذا الّذي تلقّيته؟

137
00:12:18,120 --> 00:12:21,910
...يا-يامانامي، أيّها الخبيث

138
00:12:22,660 --> 00:12:24,080
.غفلتُ لحظةً

139
00:12:24,080 --> 00:12:27,860
لم يخطر ببالي أبدًا أنّ
.خاتمتي ستَكون على يديك

140
00:12:27,860 --> 00:12:31,840
—تريّث، صُغت لتوّي قصيدة مَوتي

141
00:12:40,940 --> 00:12:43,000
.سأَنصت إليها في الحياة الآخرة

142
00:12:44,600 --> 00:12:45,870
.يامانامي

143
00:12:49,190 --> 00:12:50,480
!تبًا لك يا هيراما

144
00:12:50,490 --> 00:12:51,740
!عُد أدراجك

145
00:12:56,750 --> 00:12:58,690
.قُومي، سنَرحل مِن هُنا

146
00:12:58,690 --> 00:13:00,600
!كلا، لا يُمكنني

147
00:13:00,600 --> 00:13:02,780
.بل ستَفعلين! هيّا، تعالي معي

148
00:13:12,620 --> 00:13:14,120
ما الخطب يا أوكيتا؟

149
00:13:14,120 --> 00:13:16,770
.ضربات سيفك ضعيفةٌ للغاية

150
00:13:17,560 --> 00:13:19,520
،لا يُمكننا إضاعة المَزيد مِن الوقت

151
00:13:19,930 --> 00:13:20,870
.يا هيجيكاتا-سان

152
00:13:23,400 --> 00:13:26,510
كُنت قلقًا مِن أن تَغدو تلك
.المرأة مصدر إزعاجٍ لنا

153
00:13:27,620 --> 00:13:29,740
!تنحّي جانبًا أيّتها المرأة
!أنتِ تعترضين الطّريق

154
00:13:29,740 --> 00:13:31,990
،أجبرني على ذلك
!إن استطعت

155
00:13:32,960 --> 00:13:35,170
لم تُناصرين سيريزاوا؟

156
00:13:35,170 --> 00:13:37,750
،إن كان قد هدّدكِ للمَجيء
.فأنتِ بمأمنٍ الآن

157
00:13:38,510 --> 00:13:40,230
.لم يُهدّدني أحدٌ

158
00:13:40,230 --> 00:13:42,010
.لا أُبالي بمَن أُواجه

159
00:13:42,770 --> 00:13:43,720
...أَلا تُبالين

160
00:13:44,790 --> 00:13:46,880
،كُلّما ازداد الخَصم بأسًا
.كان ذلك أَشهى لي

161
00:13:46,880 --> 00:13:50,820
وجماعة المِيبورو الّتي أرعبت
.المدينة بأَسرها خير مَن يَفي بالغرض

162
00:13:51,890 --> 00:13:53,690
مَن تكون هذه المرأة؟

163
00:13:55,920 --> 00:13:59,930
أنا على درايةٍ بشأن إيتوساتو مِن
،واتشيجايا، وكيتشييي مِن كيكيويا

164
00:13:59,930 --> 00:14:02,530
لكن أيّ نوعٍ مِن النّسوة
تكون هذه أومي؟

165
00:14:03,330 --> 00:14:06,820
في الحقيقة، لم أَجد في نفسي
.مَيلًا لتقصّي أمرها بعُمقٍ

166
00:14:07,520 --> 00:14:08,810
ماذا تَعني بقولك؟

167
00:14:09,390 --> 00:14:11,530
.يُقال إنّ مسقط رأسها في نيشيجين

168
00:14:11,890 --> 00:14:16,290
وهُو ادّعاءٌ تُردّده كُلّ بغيّةٍ
.في شيمابارا

169
00:14:16,940 --> 00:14:19,980
،بعد أن هَجرت تلك الحياة
...حازت ثروةً

170
00:14:20,360 --> 00:14:22,840
وتزوّجت مِن سيّد دُكّان هيشييا
.في زُقاق يونجو

171
00:14:23,610 --> 00:14:27,540
تبلغ مِن العُمر خمسةً وعشرين
.عامًا، وهي فتّانةٌ، مَليحةٌ

172
00:14:27,980 --> 00:14:30,280
.ويُشاع أنّها أنعشت التّجارة بذكائها

173
00:14:31,060 --> 00:14:35,070
،وُلدت حسناء
،وظفرت بأرملٍ ثريّ

174
00:14:35,070 --> 00:14:38,120
والآن نالت حظوةً عند سيريزاوا
.أيضًا، لذا أَصابها الغُرور

175
00:14:38,520 --> 00:14:41,360
جوهر الموضوع أنّ الحظّ
.طاوعها فنَعمت بعيشٍ رغيد

176
00:14:42,120 --> 00:14:44,340
،على أيّ حالٍ
.ليست بذات شأنٍ يُذكر

177
00:14:46,930 --> 00:14:48,160
حقًا؟

178
00:14:50,680 --> 00:14:52,330
.كُفّي عن هذا

179
00:14:56,100 --> 00:14:57,350
!كُفّي عن هذا

180
00:14:59,030 --> 00:15:00,340
!نَاولني السّيف

181
00:15:02,540 --> 00:15:04,000
حقًا؟

182
00:15:04,000 --> 00:15:06,710
هل هِي ممّن يُغضّ الطّرف عنهنّ؟

183
00:15:11,380 --> 00:15:14,060
،كلا، مهما يكُن شأنها

184
00:15:14,660 --> 00:15:16,540
.فهِي خارجةٌ عن حُدود المَألوف

185
00:15:19,320 --> 00:15:23,080
،جرى بيعكِ
.لم يَعد لديكِ ملاذٌ للفرار

186
00:15:24,740 --> 00:15:27,750
هيّا، ما الضّرر في ذلك؟

187
00:15:29,220 --> 00:15:32,100
.أنتِ عاجزةً حتّى عن إنجاب الأطفال

188
00:15:33,360 --> 00:15:36,070
!يا لجُرأتها
.ليست سوى زوجةٍ ثانية

189
00:15:36,070 --> 00:15:38,480
وماذا لو كانت جميلةً بعض الشّيء؟

190
00:15:39,240 --> 00:15:41,700
.تولّي أنتِ جمع الدّين

191
00:15:41,700 --> 00:15:44,270
حتّى المِيبورو يَلينون
.في حضرة النّساء

192
00:15:45,180 --> 00:15:49,880
،أصغي إليّ يا أومي
.سيَأتون لقتلي عاجلًا أم آجلًا

193
00:15:50,610 --> 00:15:52,210
فمَاذا ستَفعلين؟

194
00:15:54,750 --> 00:15:57,270
تَراءى لي أنّها الفُرصة الّتي
.كُنت أرقبها

195
00:15:57,770 --> 00:15:59,960
.سأَشفي غليلي منكم جميعًا

196
00:15:59,960 --> 00:16:03,160
لا تَحسبوا أنّ امرأةً ستَتجرّع
.ظُلمكم صاغرةً

197
00:16:04,100 --> 00:16:07,270
لا تظنّوا أنّ بمَقدوركم سلبي
.حُقوقي إلى الأبد

198
00:16:08,290 --> 00:16:11,230
.لطالما تمنّيت أن أردّ الصّاع صاعين

199
00:16:13,550 --> 00:16:16,250
لأُبين لكُم أنّني لا أَرتضي
.هذا العالم

200
00:16:18,170 --> 00:16:20,910
،بلغت مُرادك بالبَطش
أَليس كذلك؟

201
00:16:21,240 --> 00:16:23,800
!كما تَهوى بالفعل

202
00:16:27,000 --> 00:16:29,620
.نُقطة ضعفهم النّساء والأطفال

203
00:16:29,620 --> 00:16:33,600
النّساء؟
.أعرف واحدةً تصلح للمُهمّة

204
00:16:35,840 --> 00:16:38,090
.وإلى هذا الحال انتهى بي المَطاف

205
00:16:38,090 --> 00:16:40,300
!أنت لا تُدرك شيئًا

206
00:16:42,040 --> 00:16:44,360
.ولست بالّذي يُخيفني

207
00:16:45,720 --> 00:16:47,320
...ما الفَرق

208
00:16:47,740 --> 00:16:50,810
،بين أن أُشهر سيفي في وجهها

209
00:16:51,120 --> 00:16:53,990
وبين تَعريض سيريزاوا المدينة للخطر؟

210
00:16:55,040 --> 00:16:56,270
أيّ فرقٍ يُميّزنا عنه؟

211
00:16:57,820 --> 00:17:02,000
تراكماتٌ مِن الشّقاء أفضت
.بنا إلى هذه اللّحظة

212
00:17:02,000 --> 00:17:06,760
سيَشهد العالم يومًا تنتفض فيه النّساء
.ليُذقن الرّجال وبال صَنيعهم

213
00:17:06,760 --> 00:17:08,300
!لا تنسَ هذا أبدًا

214
00:17:08,870 --> 00:17:11,960
تبًا، ما كانت هذه المرأة
.ضمن نِطاق خُطّتي

215
00:17:12,690 --> 00:17:16,100
!ما خطبك؟ هيّا
!أَزهق رُوحي إن كُنت تستطيع

216
00:17:16,560 --> 00:17:20,350
أَلا تهمّها هَويّة مَن تُقاتل طالما
كان رجلًا؟ أيّ منطقٍ هذا؟

217
00:17:21,100 --> 00:17:22,560
!سأَقضي عليك

218
00:17:24,050 --> 00:17:25,440
!سُحقًا لك

219
00:17:25,900 --> 00:17:27,490
.إنّها غايةٌ في الضّعف

220
00:17:29,270 --> 00:17:34,410
نِيّتك ليست خالصةً يا أومي، مَن كانت
.بمثل تردّدكِ هذا لن تُزهق رُوحًا قطعًا

221
00:17:34,410 --> 00:17:35,490
!اخرس

222
00:17:35,490 --> 00:17:38,580
،ما إن أَفرغ مَن قتلهم
!حتّى يحين دورك

223
00:17:38,580 --> 00:17:42,080
،هكذا إذن
.أنا مِن ضمن قائمة اغتيالاتك أيضًا

224
00:17:42,280 --> 00:17:44,900
،بَيد أنّك تمتاز عنهم بكثيرٍ

225
00:17:44,900 --> 00:17:47,640
لم يَرفّ لك جفنٌ حين
.سمعت نَجوى قلبي

226
00:17:47,640 --> 00:17:50,470
،منحتني هذه الفُرصة

227
00:17:50,470 --> 00:17:52,790
،وعاملتني بمنزلة النّظير المُساوي لك

228
00:17:54,810 --> 00:17:58,140
،فلا أنت ممّن يُواسي تملّقًا
.ولا ممّن يخدع رِياءً

229
00:17:58,970 --> 00:18:00,720
.شُكرًا لكِ

230
00:18:03,320 --> 00:18:05,470
،هيجيكاتا-سان
.بدأت تفقد ثباتك

231
00:18:06,820 --> 00:18:10,790
ليست هِي مَن يجب أن
.أُشهر سيفي في وجهها

232
00:18:13,880 --> 00:18:14,990
.هيجيكاتا-سان

233
00:18:16,070 --> 00:18:17,000
!هيجيكاتا-سان

234
00:18:17,900 --> 00:18:19,920
!أيّها المُدّعي المُنافق

235
00:18:19,920 --> 00:18:22,580
!أنت أكثر مَن يزدري النّاس

236
00:18:22,580 --> 00:18:24,580
ماذا؟
ما الّذي تَرمي إليه بحديثها؟

237
00:18:24,580 --> 00:18:29,330
ضاق صدري بأَشباهك مِن الرّجال، أُولئك
!الّذين يتصنّعون العَدل واللّطف زُورًا

238
00:18:29,330 --> 00:18:31,200
!ما أنتم إلّا مصدر كُلّ بلاءٍ وخراب

239
00:18:36,280 --> 00:18:37,200
!سوجي

240
00:18:39,000 --> 00:18:41,000
.لا تَنطق بحرفٍ آخر

241
00:18:42,420 --> 00:18:44,050
.رُويدك، ليس بهذه العَجلة

242
00:18:45,360 --> 00:18:47,800
.تجلّت لك الحقيقة الآن

243
00:18:47,990 --> 00:18:51,310
ماذا؟ هل أنا الوحيد الّذي
لا يفهم ما يجري؟

244
00:18:51,960 --> 00:18:53,800
!تنحَّ جانبًا
!سأَقوم بذلك بنفسي

245
00:18:54,730 --> 00:18:56,280
!مُت

246
00:19:04,660 --> 00:19:07,490
.هيجيكاتا-سان، أنت مخطئٌ

247
00:19:12,710 --> 00:19:17,420
لو سُئلت يومًا عن لحظةٍ
،أصبو لاستعادتها مِن عُمري

248
00:19:17,420 --> 00:19:19,160
...لأَجبت دُون تردّدٍ

249
00:19:20,760 --> 00:19:22,150
.أزهار الكَرز

250
00:19:23,960 --> 00:19:28,000
.يا لجمال أغصان الكَرز المُتدلّية تلك

251
00:19:28,530 --> 00:19:32,030
.كانت حمراء قانيةً كالدّم

252
00:19:35,420 --> 00:19:37,120
أين وَقع بصري عليها يا تُرى؟

253
00:19:44,720 --> 00:19:49,060
،نِلت مُبتغاي
...خُضت آخر نزالٍ في حياتي

254
00:19:49,310 --> 00:19:53,960
.ضدّ أشدّ رجال كيوتو بأسًا

255
00:20:00,320 --> 00:20:02,860
.يا له مِن شُعورٍ غامر

256
00:20:04,660 --> 00:20:07,120
.قاتلت بحقٍ

257
00:20:11,480 --> 00:20:12,770
هل أنت شيطانٌ؟

258
00:20:12,770 --> 00:20:16,230
أَلا يَحمل قلبك ذرّةً مِن رحمةٍ يا أوكيتا؟

259
00:20:16,480 --> 00:20:18,610
.لكن هنيئًا لك

260
00:20:18,610 --> 00:20:21,910
ما كُنت أظنّ أنّك ستَتّخذ مِن جسد أومي
!سبيلًا لتُصيب ثغرةً منّي غابت عن بَصري

261
00:20:21,910 --> 00:20:24,230
.كانت تلك غفلةً منك يا سيريزاوا-سان

262
00:20:30,930 --> 00:20:34,920
هيجيكاتا-سان، أصبحت هِي الآن
.طرفًا في هذا الصّراع

263
00:20:35,480 --> 00:20:38,810
،وفي مُعترك النّزال، يتساوى الرّجل والمرأة
.ويَنتفي الفرق بين الضّعيف والصّنديد

264
00:20:39,400 --> 00:20:40,920
.وذلك ما أَثار حَفيظتها

265
00:20:41,860 --> 00:20:45,150
الشّخص الوحيد الّذي داخله
...التردّد حين اشتدّ الخطر

266
00:20:46,140 --> 00:20:47,410
.لم يكُن سِواك

267
00:20:52,420 --> 00:20:54,390
.أُمّي، يتملّكني الذّعر

268
00:20:54,390 --> 00:20:58,520
،لا بأس، سنَكون بخيرٍ
.الزما الصّمت فحسب ولا تبرحا مكانكما

269
00:21:01,400 --> 00:21:05,040
!أيّ مهارةٍ فذّة هذه
!وأيّ رُوحٍ قتاليّة

270
00:21:05,040 --> 00:21:07,400
.إنّه لمَشهدٌ يُثير الإعجاب

271
00:21:07,910 --> 00:21:09,330
.سيريزاوا-سان

272
00:21:09,740 --> 00:21:13,500
إنّ فُرصي في نزالٍ عادل معك
.لن تتجاوز الثّلاث مِن عشرٍ

273
00:21:14,190 --> 00:21:17,280
وأشكّ في قُدرتي على النّيل
.منك إلّا مُباغتةً

274
00:21:18,400 --> 00:21:23,140
،لم يَعد في الوقت متّسعٌ للمُماطلة
.ولا طاقة لنا بفَقد المَزيد مِن رجالنا

275
00:21:24,520 --> 00:21:28,080
.سأُخاطر بكُلّ ما أملك

276
00:21:38,690 --> 00:21:40,280
سَيفان إذن؟

277
00:23:21,760 --> 00:23:23,510
.يامانامي كيسوكي يُحدّثكم

278
00:23:23,920 --> 00:23:26,200
.فاقونا مكرًا بلا ريبٍ

279
00:23:26,200 --> 00:23:29,920
أرى أنّ نيمي-سان لم يبذل رُوحه
.في هذه المَكيدة هباءً

280
00:23:30,860 --> 00:23:34,740
هل كُلّ مَن لا يخشى المَنيّة
يغدو خصمًا مهيبًا إلى هذا الحدّ؟

281
00:23:34,740 --> 00:23:36,690
.جعلتموني أَعي هذا الدّرس جيّدًا

282
00:23:37,550 --> 00:23:41,480
لكنّنا نحن أيضًا نحمل أمانة
.مُستقبل المِيبورو على عَواتقنا

283
00:23:41,900 --> 00:23:43,990
ولا مَناص لنا مِن الانتصار
.مهما عَظُمت التّضحيات

284
00:23:45,270 --> 00:23:48,030
."الحلقة القادمة: "ضربةٌ غَاشمة