1
00:00:00,540 --> 00:00:03,670
!مرحى، انتهى التّدريب أخيرًا

2
00:00:04,210 --> 00:00:06,200
.إلى اللّقاء، ناغاكورا-سينسي

3
00:00:06,940 --> 00:00:08,260
.نال منّي التّعب

4
00:00:08,260 --> 00:00:09,760
!لنلعب لُعبة مُطاردة الظّل

5
00:00:09,760 --> 00:00:10,600
.محالٌ

6
00:00:10,600 --> 00:00:11,990
ولِمَ لا؟

7
00:00:17,400 --> 00:00:19,950
ما خطبكِ يا تسورو؟
ألا ترغبين في العودة إلى الدّار؟

8
00:00:20,390 --> 00:00:26,590
رُبّما يجدر بي الانسحاب، فأنا ضئيلة الحجم
.ولست قويّةً بما يكفي... فضلًا عن أنّي فتاةٌ

9
00:00:27,020 --> 00:00:30,250
أنتِ ضعيفةٌ لأنّكِ لم تنالي
.كفايتكِ مِن التّدريب

10
00:00:30,440 --> 00:00:31,710
!أُدرك ذلك تمامًا

11
00:00:32,720 --> 00:00:34,380
...لكن

12
00:00:35,640 --> 00:00:39,560
تلك الحكاية عن الشّينسينغومي قد
،أشعلت الحماس في داخلي

13
00:00:40,030 --> 00:00:42,730
ولكن أَلم يَخسروا في النّهاية؟

14
00:00:47,280 --> 00:00:51,970
أخبرني يا ناغاكورا-سينسي، كيف تُحافظ
على قوّتك ويقينك الرّاسخ بهذا الشّكل؟

15
00:00:55,950 --> 00:00:58,000
هل يُعاب المرء على الخسارة؟

16
00:00:58,370 --> 00:01:00,600
،ماذا؟ أعني... بكُلّ تأكيد
أليس كذلك؟

17
00:01:06,230 --> 00:01:08,780
...حسنًا. سأُخبركِ

18
00:01:10,360 --> 00:01:15,680
سأقصّ عليكِ حكاية الرّجل الّذي مضى
.مُثقلًا بكُلّ ظلام المِيبورو فوق كاهله

19
00:01:36,360 --> 00:01:38,220
مَن هؤلاء الرّجال؟

20
00:01:38,220 --> 00:01:40,960
إخلاصٌ؟ يا لها مِن معاطف غريبة
.تلك الّتي يرتدونها

21
00:01:50,230 --> 00:01:52,740
.رائحة البحر تبعث في نفسي الحنين

22
00:01:53,380 --> 00:01:58,600
قدمت إلى أوساكا عبر النّهر
.مع جدّتي وإيروها مِن قبل

23
00:01:58,600 --> 00:02:00,890
.لنعرج على حيّ اللّهو لاحقًا

24
00:02:00,890 --> 00:02:02,280
.ستتهافت علينا النّساء مُجدّدًا

25
00:02:02,280 --> 00:02:04,450
،تكثر الدّكاكين هنا حقًا

26
00:02:04,450 --> 00:02:06,550
.لعلّنا نعثر على صيدٍ ثمين

27
00:02:06,550 --> 00:02:08,360
.لنبحث عن وجبةٍ شهيّة أولًا

28
00:02:09,260 --> 00:02:10,410
.لا تفقدوا صوابكم

29
00:02:10,900 --> 00:02:13,060
...انظر، حصانٌ
.إنّه ضخمٌ جدًا

30
00:02:13,920 --> 00:02:16,990
حصانٌ؟ هذه الدّواب تملأ الأرجاء
.في كُلّ مكانٍ

31
00:02:19,040 --> 00:02:20,990
،سيريزاوا-سان
إلى أين أنت ذاهبٌ؟

32
00:02:21,180 --> 00:02:25,880
لسنا صبيةً يلهون بملابس التّنكر، دعوني
.أنعم بما تبقّى لي مِن وقت فراغٍ قصير

33
00:02:27,070 --> 00:02:29,250
،مهلًا
هل نحن في عُطلةٍ اليوم؟

34
00:02:29,630 --> 00:02:34,300
،أبحر الشّوغون صوب إيدو
.وبذلك انقضت مُهمّة حراسته

35
00:02:34,590 --> 00:02:37,210
،عُذرًا
...لم يتبيّن لي ذلك إلّا الآن

36
00:02:41,040 --> 00:02:42,730
.غاب كوندو-سان عن الأنظار

37
00:04:17,170 --> 00:04:18,480
أين عساه مضى؟

38
00:04:21,680 --> 00:04:22,510
قطّةٌ؟

39
00:04:25,720 --> 00:04:26,630
!ها هو ذا

40
00:04:26,630 --> 00:04:27,680
!كوندو-سان

41
00:04:29,100 --> 00:04:29,700
.نيو

42
00:04:29,700 --> 00:04:31,450
مِن أين جاءت كُلّ هذه القطط؟

43
00:04:31,460 --> 00:04:32,330
...ما هذا

44
00:04:31,970 --> 00:04:35,450
ارتطمت بعربةٍ مُحمّلةٍ
.بسمك البونيتو المُجفّف

45
00:04:38,290 --> 00:04:39,710
،ولكن على أيّ حالٍ
.انظر إلى هناك

46
00:04:43,110 --> 00:04:44,560
.إنّه يبدو مُريبًا

47
00:04:44,760 --> 00:04:48,040
،تعلّمت أنّ لكُلّ جماعةٍ ميدانها
.حتّى في عالم المِهن

48
00:04:48,320 --> 00:04:50,960
:ويُقال
.لا تُنافس في ميدان غيرك

49
00:04:51,520 --> 00:04:55,720
ولكن، هل يصحّ أن تقف الحُدود
عائقًا بيننا وبين عون النّاس؟

50
00:04:56,700 --> 00:04:57,890
.صدقت يا سيّدي

51
00:04:59,920 --> 00:05:01,120
.جيّدٌ، لننطلق إذن

52
00:05:03,010 --> 00:05:05,650
،أيّها السيّد
هل تُبيّت شيئًا لذلك الدُكّان؟

53
00:05:08,850 --> 00:05:09,820
!أرجوك، انتظر

54
00:05:16,500 --> 00:05:18,130
.مذهلٌ

55
00:05:21,160 --> 00:05:23,680
!إنّه يتحرّك مثل سوجي

56
00:05:25,700 --> 00:05:26,600
.فقدت أثره

57
00:05:28,200 --> 00:05:29,110
أين أنا؟

58
00:05:31,930 --> 00:05:32,690
مَن أنت؟

59
00:05:34,290 --> 00:05:34,850
!انحنِ بجسمك

60
00:05:56,880 --> 00:05:58,280
.أرجو أن تستسلم طواعيةً

61
00:06:17,370 --> 00:06:18,480
هل أنت على ما يُرام؟

62
00:06:22,730 --> 00:06:24,320
.مِن الأفضل ألّا تتحرّك

63
00:06:24,970 --> 00:06:26,440
مَن أنتما؟

64
00:06:26,440 --> 00:06:27,680
.نحن مِن جماعة ميبو روشيغومي

65
00:06:28,980 --> 00:06:31,660
.إذن، أنتما مِن المِيبورو

66
00:06:32,290 --> 00:06:33,240
هل سمعت بنا؟

67
00:06:34,380 --> 00:06:35,720
.تناهت إلى مسامعي الأقاويل

68
00:06:36,590 --> 00:06:38,880
فقد غادرت كيوتو
.مُنذ ثلاثة أيّامٍ فقط

69
00:06:38,880 --> 00:06:41,280
هل جئت إلى أوساكا لسببٍ مُعيّنٍ؟

70
00:06:42,990 --> 00:06:46,710
ذلك المكان الّذي كنت
.أُراقبه يعود لوالدي

71
00:06:48,600 --> 00:06:52,860
تمتهن عائلتي الوخز بالإبر، لكن
.نفسي تاقت لخوض غِمار السّيف

72
00:06:53,640 --> 00:06:54,980
.لذا هربت مِن الدّار

73
00:06:55,880 --> 00:06:58,000
.لم يكن شقّ طريقي بالسّيف هيّنًا

74
00:06:59,090 --> 00:07:00,870
حتّى ضاق بي الحال
.وأصبحت رُونين

75
00:07:02,070 --> 00:07:06,410
ثُمّ بلغني أنّ عائلتي اقترضت
،مالًا مِن أشخاصٍ ذوي شُبهةٍ

76
00:07:06,990 --> 00:07:08,730
.فعُدت إلى أوساكا

77
00:07:09,070 --> 00:07:12,330
إن كان الحال كذلك، فلمَ لا تعود لدارك
وتستوضح الحقيقة مِن عائلتك حالًا؟

78
00:07:12,330 --> 00:07:16,320
هل تشعر بالخجل مِن مُواجهتهم
بعد فرارك مِن الدّار؟

79
00:07:16,730 --> 00:07:18,360
،ليس هذا ما يمنعني

80
00:07:21,120 --> 00:07:23,960
مِن الأفضل لكما ألا تُقحما
.نفسيكما في هذه المَعمعة

81
00:07:24,600 --> 00:07:25,880
،فهمت

82
00:07:25,880 --> 00:07:28,510
سنتولّى نحن أمر مُحصّلي
.الدّيون ونطردهم شرّ طردةٍ

83
00:07:29,000 --> 00:07:30,560
.كلا، أنت لا تفهم مَقصدي

84
00:07:30,780 --> 00:07:31,600
.لننطلق

85
00:07:31,860 --> 00:07:32,880
.وأنت أيضًا

86
00:07:35,170 --> 00:07:39,950
أعتقد أنّ مُحصّلي الدّيون الجائرين
.هؤلاء يعملون لحساب السّلطات

87
00:07:41,000 --> 00:07:45,310
لا بُدّ أنّ يوريكي يُدعى أوتشيياما هيكوجيرو
.هو مَن يُدبّر كُلّ شيءٍ مِن خلف السّتار

88
00:07:45,310 --> 00:07:46,640
يوريكي؟ أَتعني رجلًا
ذا نفوذٍ في السّلطات؟

89
00:07:47,120 --> 00:07:49,080
لا أُبالي، فأنا مُجرّد
.رُونين في كُلّ الأحوال

90
00:07:49,950 --> 00:07:53,120
لكن جماعة ميبو روشيغومي تحت
رعاية مُقاطعة آيزو، أليس كذلك؟

91
00:07:55,960 --> 00:07:57,540
ما رأيك يا نيو؟

92
00:07:57,540 --> 00:07:59,000
لم يعد بإمكاننا غضّ الطّرف
.عمّا يحدث

93
00:08:00,670 --> 00:08:01,790
.قُضي الأمر

94
00:08:02,900 --> 00:08:05,720
هل كُلّ رجال المِيبورو مثلكما؟

95
00:08:07,520 --> 00:08:08,330
أَترى هذا؟

96
00:08:08,890 --> 00:08:11,350
.هذا هو النّهج الّذي يقودنا

97
00:08:12,240 --> 00:08:13,210
الإخلاص؟

98
00:08:16,560 --> 00:08:17,940
،لم أُعرّفكما بنفسي

99
00:08:18,980 --> 00:08:21,270
.اسمي يامازاكي سوسومو

100
00:08:21,780 --> 00:08:23,150
.كوندو إيسامي

101
00:08:23,850 --> 00:08:24,930
.تشيرينو نيو

102
00:08:29,990 --> 00:08:31,440
هل تُنصت إليّ؟

103
00:08:33,620 --> 00:08:34,540
ما الّذي تبتغونه؟

104
00:08:36,120 --> 00:08:37,060
.أبي

105
00:08:38,300 --> 00:08:39,340
.سوسومو

106
00:08:39,840 --> 00:08:40,890
هذا ابنك؟

107
00:08:41,460 --> 00:08:44,290
دعك منه الآن، ماذا عن
المال الّذي أقرضناك إيّاه؟

108
00:08:44,890 --> 00:08:50,780
أوفيت ديني، ولن أدفع
.مُونًا واحدًا لا أدين به

109
00:08:51,170 --> 00:08:53,710
!ما أشدّ الشّبه بينه وبين ابنه

110
00:08:54,200 --> 00:08:58,800
أَما سمعت بالفوائد؟ لو تركنا النّاس يمتنعون عن الدّفع حسب
.أهوائهم، لما احتجنا إلى مَن يجلب الخارجين عن القانون قسرًا

111
00:08:58,800 --> 00:09:01,050
.معذرةً

112
00:08:59,520 --> 00:09:00,460
.وفّر عليك كلامك

113
00:09:01,050 --> 00:09:03,010
—أخبرتك أنّ بوسعنا تأجيل ذلك

114
00:09:03,010 --> 00:09:04,810
!تبًا، تبًا، تبًا

115
00:09:06,020 --> 00:09:07,850
تستعرض قوّتك عليّ؟
!سأزجّ بك خلف القُضبان

116
00:09:08,640 --> 00:09:11,920
لا أعلم كم تبتغي، لكن ثمن بيع
.هذا سيسدّ جُزءًا كبيرًا مِن الدّين

117
00:09:11,920 --> 00:09:13,840
فهل تكتفي به؟

118
00:09:13,840 --> 00:09:14,620
ماذا؟

119
00:09:16,030 --> 00:09:16,860
.إنّه سيف كوتيتسو

120
00:09:16,860 --> 00:09:18,200
كـ-كوتيتسو؟

121
00:09:20,780 --> 00:09:24,580
!هذا السّيف خردةٌ تمامًا
.ولا لمعة فيه

122
00:09:24,580 --> 00:09:25,540
.لا بُدّ أنّه مزيفٌ

123
00:09:25,820 --> 00:09:27,300
!احتفظ به

124
00:09:27,300 --> 00:09:29,120
!ماذا تبتغي منّا أن نفعل إذن؟

125
00:09:30,130 --> 00:09:32,740
!لا تستفزّني بإلحاحك

126
00:09:33,930 --> 00:09:37,520
،تبًا، تبًا، تبًا
!استسلمت! أقرّ بالهزيمة

127
00:09:38,560 --> 00:09:39,270
.أنت ضعيفٌ

128
00:09:39,270 --> 00:09:43,480
إيّاك والظنّ أنّ فِعلتك هذه
.ستمرّ دُون حسابٍ

129
00:09:43,480 --> 00:09:46,350
ألا تعرف مَن الّذي يحمي ظهري؟

130
00:09:46,640 --> 00:09:49,600
،أوتشيياما هيكوجيرو
.يوريكي مِن أوساكا

131
00:09:49,600 --> 00:09:51,990
ماذا؟
مَن أنتما بحقّ الجحيم؟

132
00:09:51,990 --> 00:09:53,810
وما خطب تلك المعاطف الغريبة؟

133
00:09:54,670 --> 00:09:57,220
،كوندو إيسامي
.مِن ميبو روشيغومي

134
00:09:57,630 --> 00:10:00,040
،نحن رجال لُورد آيزو
.وحُماة كيوتو

135
00:10:00,560 --> 00:10:02,580
.أنا رفيقه، تشيرينو نيو

136
00:10:02,790 --> 00:10:05,120
كيوتو؟ المِيبورو؟

137
00:10:05,860 --> 00:10:09,610
،لا أعلم ما الّذي تفعلونه هنا
.لكنّكم ستبكون حين ينقضي هذا

138
00:10:13,400 --> 00:10:13,960
.أبي

139
00:10:16,890 --> 00:10:17,660
.سوسومو

140
00:10:19,800 --> 00:10:24,120
.أوقد لأُمّك عود بخورٍ على الأقلّ

141
00:10:28,120 --> 00:10:31,270
هل... أعود في وقتٍ لاحق؟

142
00:10:31,460 --> 00:10:32,240
.لا حاجة لذلك

143
00:10:34,720 --> 00:10:35,170
.حسنًا

144
00:10:37,030 --> 00:10:41,950
معذرةً، لا أودّ أن أكون فظًا، لكن لماذا
استدنت المال في المقام الأوّل؟

145
00:10:42,800 --> 00:10:45,280
لا يبدو عليك أنّك تُعاني
.ضِيقًا في الحال

146
00:10:45,480 --> 00:10:49,790
ثمّة مَن يحتاج العلاج بالإبر
،ولا يقدر على كُلفته

147
00:10:50,370 --> 00:10:54,380
وبعضهم تمنعه عزّة نفسه
.مِن قُبوله دُون مقابلٍ

148
00:10:54,800 --> 00:10:58,850
لذا، استدنت مِن أحد الدّائنين
.ودفعت عنهم

149
00:10:59,400 --> 00:11:04,270
بهذه الطّريقة، يحفظ المريض ماء وجهه
.بادّعائه أنّه سيردّ لي المال لاحقًا

150
00:11:04,270 --> 00:11:05,950
.يا له مِن طبعٍ غريب

151
00:11:06,760 --> 00:11:09,010
.لكنّي كففت عن ذلك الآن

152
00:11:11,120 --> 00:11:12,480
.أنا مدينٌ لك بما قدّمته آنفًا

153
00:11:13,560 --> 00:11:14,310
.شُكرًا لك

154
00:11:18,280 --> 00:11:20,230
.حسنًا، يجدر بنا الرّحيل

155
00:11:29,150 --> 00:11:30,650
...ذلك الفتى ذُو الشّعر الأبيض

156
00:11:31,210 --> 00:11:35,370
أدرك ما بيننا مِن جفاءٍ
.وسعى لتلطيف الأجواء

157
00:11:36,910 --> 00:11:40,600
لديه حِسٌ ثاقب في فهم بواطن
.النّاس، لفت انتباهي حقًا

158
00:11:41,710 --> 00:11:45,010
كما أنّ ذلك الرّجل كوندو له هيبةٌ
.ومكانة، ويُتوقّع منه الكثير

159
00:11:49,140 --> 00:11:50,900
ستضيع الفُرصة مِن بين يديك
.إن لم تلحق بهما الآن

160
00:11:53,880 --> 00:11:56,150
ألا تتوق نفسك لخوض غِمار السّيف؟

161
00:12:06,030 --> 00:12:09,040
أَهرب منك سوسومو ثانيةً؟

162
00:12:09,280 --> 00:12:09,960
.أجل

163
00:12:09,960 --> 00:12:11,920
.يا له مِن فتى ناكرٍ للجميل

164
00:12:13,040 --> 00:12:16,440
لا بُدّ أنّ العيش مريرٌ مع
.ابنٍ صُعلوك لا نفع منه

165
00:12:18,160 --> 00:12:20,040
مـ ما الّذي دهاك؟

166
00:12:22,560 --> 00:12:24,330
!كُفّ عن هذا

167
00:12:27,580 --> 00:12:28,890
!إنّه يمشي

168
00:12:29,560 --> 00:12:31,950
!عزيزي، خطا خُطواته الأولى

169
00:12:31,950 --> 00:12:34,520
حسنًا، كان سيمشي في
.يومٍ ما لا محالة

170
00:12:51,540 --> 00:12:52,320
،بالتّوفيق

171
00:12:54,710 --> 00:12:55,890
.امضِ قُدمًا يا بُنيّ

172
00:13:08,580 --> 00:13:11,310
،يا للرّوعة! هذا السّاكي مذاقه رائعٌ
.والزّاد أيضًا طيّبٌ للغاية

173
00:13:11,310 --> 00:13:13,190
لا عجب أنّهم يدعون
!أوساكا مدينة المَوائد

174
00:13:13,190 --> 00:13:16,770
،هذا كُلّ ما كنت أتمنّاه
.أظنّ أن هذا المكان قد نال إعجابي

175
00:13:16,770 --> 00:13:18,900
ماذا؟ أين غاب تارو؟

176
00:13:19,310 --> 00:13:21,200
!تارو! تارو

177
00:13:22,660 --> 00:13:23,950
.أجل يا سيّدي، أنا هنا

178
00:13:23,950 --> 00:13:26,810
ما خطبك؟
هل كنت تنتظر بالخارج؟

179
00:13:26,810 --> 00:13:27,820
.تعال وشاركنا الشّراب

180
00:13:28,390 --> 00:13:28,830
ماذا؟

181
00:13:29,120 --> 00:13:31,260
.كلا، لا يُمكنني فِعل ذلك أبدًا

182
00:13:31,260 --> 00:13:32,350
.هيّا، لا تكن هكذا

183
00:13:32,350 --> 00:13:36,790
كلا، كلا، أجد نفسي أكثر راحةً
.وأنا قائمٌ على خدمتكم

184
00:13:36,790 --> 00:13:40,440
ما هذا؟
.إنّ الشّح قد تغلغل في أوصالك

185
00:13:40,440 --> 00:13:42,320
ألا يرتقي شرابي لذوقك؟

186
00:13:42,320 --> 00:13:45,080
—كلا، أنا أُقدّر لطافتك، ولكن

187
00:13:45,080 --> 00:13:48,640
تذكّرت، يا تارو، يجب أن نمنحك
.مالًا للإنفاق بين الحين والآخر

188
00:13:48,640 --> 00:13:49,560
ماذا؟

189
00:13:49,560 --> 00:13:52,440
كلا، لا يُمكنني قبول مالك
!دُون أن أُسدي خدمةً تُذكر

190
00:13:52,440 --> 00:13:54,520
هيّا، ما الضّرر في ذلك؟

191
00:13:54,700 --> 00:13:56,580
.ابتع لنفسك زادًا شهيًا

192
00:13:59,880 --> 00:14:01,780
.شـ-شكرًا جزيلًا لك

193
00:14:01,780 --> 00:14:03,630
.لا عليك. هيّا، انطلق

194
00:14:03,630 --> 00:14:04,820
.معذرةً

195
00:14:05,220 --> 00:14:06,550
!شُكرًا جزيلًا لك

196
00:14:09,680 --> 00:14:11,770
كم أعطيته؟

197
00:14:14,200 --> 00:14:16,560
هذا المبلغ لن يشتري له
!سوى حبّة مانجو رديئةٍ

198
00:14:17,800 --> 00:14:20,060
.وما الضّير؟ هذا يكفي تارو

199
00:14:20,360 --> 00:14:23,210
،سيريزاوا-سينسي
هل أنت متوجّهٌ إلى بيت الخلاء؟

200
00:14:23,210 --> 00:14:24,600
.لعلّي سأذهب أنا أيضًا

201
00:14:31,770 --> 00:14:32,560
...ماذا

202
00:14:33,190 --> 00:14:34,430
ما سبب ذلك؟

203
00:14:48,810 --> 00:14:49,760
.لذيذٌ

204
00:14:51,950 --> 00:14:58,040
إذا أمعنت التّفكير، أجد أنّي لم أنعم
.بمثل هذا الفراغ مُنذ صرت مُتدرّبًا

205
00:14:59,200 --> 00:15:01,300
.يا لها مِن سعادةٍ غامرة

206
00:15:10,640 --> 00:15:14,850
لكن القلق يتملّكني إن لم
!يزجرني أحدٌ أو يتسلّط عليّ

207
00:15:15,170 --> 00:15:18,720
ما الّذي يحدث لي؟
وما هذا الشّعور؟

208
00:15:23,060 --> 00:15:25,020
.لـ-لعلّي أعود أدراجي

209
00:15:26,010 --> 00:15:29,150
فقد رسخت غريزة الانصياع
.في وجداني

210
00:15:34,870 --> 00:15:36,440
!سيريزاوا-سينسي

211
00:15:36,660 --> 00:15:41,640
،أنا أسفٌ للغاية، كنت أنوي العودة حالًا
...لكنّي توقّفت لأمُدّ نظري إلى البحر، و

212
00:15:41,640 --> 00:15:43,740
،إن كنت تبتغي شيئًا
.فما عليك إلّا النّطق به

213
00:15:44,280 --> 00:15:45,160
.اتبعني

214
00:15:49,320 --> 00:15:51,880
،لا أبتغي سيفًا طويلًا

215
00:15:51,880 --> 00:15:53,680
.فقد يفوق ثِقله مَقدرتهُ على الحمل

216
00:15:54,380 --> 00:15:58,760
هل لديك ما سعره زهيدٌ؟
.سيهاب كسر سيفٍ نفيس ولن يستخدمه

217
00:15:59,270 --> 00:15:59,880
ماذا؟

218
00:16:18,260 --> 00:16:21,170
مـ-ما هذا؟ ما الخطب؟

219
00:16:21,830 --> 00:16:23,670
لمَ يلتزم الصّمت هكذا؟

220
00:16:24,960 --> 00:16:27,660
أَيريدني أن أحمل هذه الأشياء؟

221
00:16:29,400 --> 00:16:32,220
،يا للمصيبة! كلا
.لا حاجة لي بها

222
00:16:32,220 --> 00:16:33,550
!هذا يبثّ الرّعب في نفسي

223
00:16:33,550 --> 00:16:37,080
سيبدو مظهرنا سيئًا إن
.كان أحدنا أعزل دُون سلاحٍ

224
00:16:39,440 --> 00:16:41,860
،إن استهان بنا العامّة
.فقد هلكنا

225
00:16:42,760 --> 00:16:44,700
.تقلّد سيفيك مُنذ هذه اللّحظة

226
00:16:47,600 --> 00:16:50,070
.وقاتل، هذا كُلّ ما لديّ

227
00:16:54,310 --> 00:16:55,040
.هيّا بنا

228
00:17:01,380 --> 00:17:03,600
،لأكون صريحًا
.هذا عبءٌ ثقيل

229
00:17:05,680 --> 00:17:07,500
،لا رغبة لي في القتال

230
00:17:08,340 --> 00:17:09,470
،فأنا أمقت الألم

231
00:17:09,920 --> 00:17:11,510
.وأكره فِكرة الموت أكثر

232
00:17:12,030 --> 00:17:15,520
أُفضّل الانزواء في الخلف وخفض
.رأسي بينما يخوض الآخرون القتال

233
00:17:28,210 --> 00:17:32,300
ولكن، هل يعني هذا أنّه بات
يكنّ لي شيئًا مِن التّقدير؟

234
00:17:33,410 --> 00:17:36,090
لعلّه يدفعني لأُتمّ عملي
على خير وجهٍ؟

235
00:17:42,120 --> 00:17:43,040
.سيريزاوا-سينسي

236
00:17:43,920 --> 00:17:44,960
.يجب أن أشكره

237
00:17:46,970 --> 00:17:50,040
أتساءل عمّا سيقولان
.حين يريانِني بهذه الهيئة

238
00:17:54,240 --> 00:17:57,720
!سأبذل قُصارى جهدي
!لن يتفوّقا عليّ

239
00:18:02,520 --> 00:18:05,980
...مـ-معذرةً، لم أكن أنظر

240
00:18:11,060 --> 00:18:14,360
مَن يكون هذا الصّعلوك النّتن؟

241
00:18:14,840 --> 00:18:16,720
.رائحته تُشبه رائحة المَجاري

242
00:18:19,870 --> 00:18:21,330
!قُتل مصارعٌ

243
00:18:21,330 --> 00:18:23,520
تناهى إلى مسامعي أنّ ساموراي
!مِن كيوتو هو الجاني

244
00:18:25,650 --> 00:18:28,570
،حين أتدبّر في الماضي
.أتساءل متى بدأ كُلّ ذلك

245
00:18:31,810 --> 00:18:34,760
متى كفّ عن المِزاح معنا؟

246
00:18:37,920 --> 00:18:41,320
ومتى انقطعت ضحكاته النّابعة
مِن القلب؟

247
00:18:43,830 --> 00:18:48,100
،كان الظّلام ينسدل بثباتٍ في أعماقه

248
00:18:50,440 --> 00:18:52,640
.وفي أرجاء المِيبورو

249
00:18:56,720 --> 00:18:58,860
ما هذا الّذي اقترفته بحقّ الجحيم؟

250
00:18:59,660 --> 00:19:01,860
.أُريد منك تفسيرًا قبل كُلّ شيءٍ

251
00:19:02,120 --> 00:19:03,400
هيّا، ما قولك يا سيريزاوا-سان؟

252
00:19:05,240 --> 00:19:06,870
.لم يكن شيئًا يُذكر

253
00:19:08,690 --> 00:19:11,490
.تارو، بلغني أنّك كنت حاضرًا

254
00:19:12,340 --> 00:19:13,560
.اشرح لنا ما جرى

255
00:19:16,390 --> 00:19:18,700
.انطق

256
00:19:18,990 --> 00:19:19,970
ما الّذي جرى؟

257
00:19:25,440 --> 00:19:26,270
...ما هذا الـ

258
00:19:27,480 --> 00:19:30,200
لا بُدّ أنّ الرّجل الآخر
.هو مَن بدأ بالعداوة

259
00:19:30,200 --> 00:19:32,440
.أجل، جنى على نفسه

260
00:19:32,440 --> 00:19:33,430
!هذا هو المكان

261
00:19:34,150 --> 00:19:35,080
!اخرجوا إلينا

262
00:19:36,890 --> 00:19:37,780
ما الخطب؟

263
00:19:39,540 --> 00:19:40,650
.يا للهول

264
00:19:40,650 --> 00:19:41,820
!اخرجوا إلى هنا حالًا

265
00:19:41,820 --> 00:19:42,960
!أيّها السّاموراي الرّعاع

266
00:19:42,960 --> 00:19:44,200
!قتلتم رفيقنا

267
00:19:44,200 --> 00:19:46,110
!جِئنا لتصفية الحِساب

268
00:19:46,110 --> 00:19:47,660
!لا أحد يتطاول على مُصارعي أوساكا

269
00:19:48,070 --> 00:19:49,800
.يبدو أنّهم أطبقوا الحِصار علينا

270
00:19:50,310 --> 00:19:51,170
ما العمل الآن؟

271
00:19:51,170 --> 00:19:52,730
!لـ-لنمنحهم ما يبتغون

272
00:19:52,730 --> 00:19:53,920
!هلمّوا، أرونا ما لديكم

273
00:19:54,200 --> 00:19:57,280
،أقترح أن نكبح جِماح غضبنا
...يُمكننا حلّ هذا بالتّفاوض

274
00:19:57,280 --> 00:19:58,140
.سأمضي إليهم

275
00:19:58,400 --> 00:19:59,040
!تارو؟

276
00:19:59,050 --> 00:20:00,200
متى خرج إلى هناك؟

277
00:20:04,330 --> 00:20:06,250
مَن أنت؟

278
00:20:06,830 --> 00:20:10,150
.أنا... أنا أعتذر حقًا

279
00:20:10,150 --> 00:20:13,140
كان ذنبي أنّ المَوقف
.آل إلى هذا السّوء

280
00:20:13,140 --> 00:20:14,140
!اغرب عن وُجوهنا

281
00:20:18,650 --> 00:20:19,990
أَتريد أن تلقى حتفك؟

282
00:20:19,990 --> 00:20:21,280
!تنحَّ جانبًا أيّها الصّعلوك

283
00:20:21,280 --> 00:20:24,480
...أَيعقل أنّ ساموراي يتقلّد سيفين

284
00:20:24,990 --> 00:20:27,760
يدع ثُلّةً مِن مُصارعي السّومو
يتطاولون عليه؟

285
00:20:28,680 --> 00:20:30,160
!صاحب المِعطف الأبيض

286
00:20:30,160 --> 00:20:31,910
!هو مَن أردى ساكيتشي قتيلًا

287
00:20:32,340 --> 00:20:33,820
...كما توقّعت

288
00:20:34,310 --> 00:20:36,080
.آل العالم إلى الهلاك

289
00:20:42,420 --> 00:20:44,040
!شقّ بطنه

290
00:20:44,520 --> 00:20:45,600
.ساء الموقف جدًا

291
00:20:45,600 --> 00:20:46,660
.يجب أن نتدخّل حالًا

292
00:20:47,190 --> 00:20:50,200
!ما الّذي دهاك بحقّ الجحيم؟

293
00:20:56,710 --> 00:20:58,060
!ها هُما المُعِينان قد حضرا

294
00:21:00,410 --> 00:21:02,440
!لا تقتلوهم، لا تستلّوا سُيوفكم

295
00:21:02,830 --> 00:21:05,320
،قول ذلك أهون مِن فِعله
.فهم لا ينوون التّراجع

296
00:21:05,730 --> 00:21:07,820
!تارو، أين أنت؟ أجبني

297
00:21:13,990 --> 00:21:15,450
.تـ-توقّفوا

298
00:21:15,450 --> 00:21:16,970
.سيقضون علينا جميعًا

299
00:21:18,790 --> 00:21:22,710
،كنت أعلم أنّك قويٌّ
...لكن لم أحسبك بهذه السّطوة

300
00:21:23,050 --> 00:21:24,290
!يا سيريزاوا

301
00:21:41,080 --> 00:21:42,550
...هلّا كففت عن هذا

302
00:21:43,400 --> 00:21:44,260
.يا سيريزاوا-سان

303
00:23:21,710 --> 00:23:25,020
في ليلةٍ مِن ليالي أوساكا حيث
،تتفتّح أوراق الشّجر الغضّة

304
00:23:25,690 --> 00:23:31,800
أشعل طيش سيريزاوا فتنةً أدّت إلى إراقة دماءٍ
.غزيرة، ووضعت المِيبورو أمام مُفترق طُرقٍ عصيب

305
00:23:32,750 --> 00:23:39,150
،هل يتمسّكون برُوح الإخلاص
أم يُؤثِرون الولاء لرِفاق الدّرب؟

306
00:23:39,990 --> 00:23:45,870
،وتحت وطأة هذا الخِيار المُرّ
.يمضي كوندو للقاء المُفوّض مع نيو

307
00:23:46,840 --> 00:23:49,070
."الحلقة القادمة: "نهج الإنسانيّة