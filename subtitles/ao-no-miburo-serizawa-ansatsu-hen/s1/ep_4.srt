1
00:00:02,830 --> 00:00:05,400
مهلًا! مِن أين أتى
أثر السّيف هذا؟

2
00:00:05,400 --> 00:00:08,190
،لم يكن هُنا بالأمس
.ليُقدّم لي أحدكم تفسيرًا

3
00:00:08,350 --> 00:00:09,080
.أجل، سيّدي

4
00:00:09,080 --> 00:00:09,990
.كينجو

5
00:00:12,080 --> 00:00:13,950
ناكامورا، هل تعلم شيئًا
عن هذا؟

6
00:00:13,950 --> 00:00:15,320
.أجل، سيّدي

7
00:00:15,320 --> 00:00:19,540
في اللّيلة الماضية، اصطدمت
،برفيقٍ يُدعى أويدا، وتشاجرنا

8
00:00:20,130 --> 00:00:21,910
ثُمّ هجم عليّ بسيفه
.دُون سابق إنذارٍ

9
00:00:22,580 --> 00:00:24,580
،أَوقفنا النّزاع
.لكن بعد فوات الأوان

10
00:00:25,200 --> 00:00:28,940
،إنّه يَدين بالولاء لك أيّها الزّعيم
.ولكوندو-سينسي أيضًا

11
00:00:29,150 --> 00:00:31,870
أويدا ينحاز لصفّ
.سيريزاوا-سينسي، كما ترى

12
00:00:32,240 --> 00:00:33,830
.لذا، هو المَلوم عمّا حدث

13
00:00:34,270 --> 00:00:35,160
.أنا آسفٌ

14
00:00:35,710 --> 00:00:37,970
،لا بأس
.ما مَضى قد انقضى

15
00:00:42,900 --> 00:00:43,800
.هوّني عليكِ، هوّني عليكِ

16
00:00:45,250 --> 00:00:46,730
.أوكيكو-تشان

17
00:00:46,730 --> 00:00:49,180
،إنّ صُراخها قويٌّ بالفعل
ما خطبها؟

18
00:00:49,480 --> 00:00:52,950
إنّها في نوبة غضبٍ لأنّها
.لم تحظَ بقيلولتها المُعتادة

19
00:00:52,950 --> 00:00:55,970
المكان صاخبٌ بسبب
.مُجنّديك الجُدد

20
00:00:56,950 --> 00:00:57,970
.أُقدّم اعتذاري

21
00:00:58,160 --> 00:01:00,920
.لا تقلق بشأننا

22
00:01:01,880 --> 00:01:03,740
،هوّني عليكِ
.حان وقت النّوم

23
00:01:04,280 --> 00:01:05,400
.لا تُشغل بالك بنا

24
00:02:38,540 --> 00:02:40,000
لماذا لَستُم في جولةٍ تفقديّة؟

25
00:02:40,000 --> 00:02:41,830
!طلبنا سيريزاوا-سينسي

26
00:02:41,830 --> 00:02:44,030
!تلك وجبة كوندو-سينسي

27
00:02:44,030 --> 00:02:46,080
!شَراب سيريزاوا-سينسي له الأولويّة

28
00:02:46,080 --> 00:02:48,630
.سيريزاوا يتسبّب في انقسام صُفوفنا

29
00:02:49,390 --> 00:02:54,530
لا جدوى مِن حراسة كيوتو الآن، سنَسفك
.دماء بعضنا إن لم ينتهِ هذا العَبث

30
00:02:56,010 --> 00:02:57,810
سُحقًا! كيف لي إصلاح ذلك؟

31
00:02:58,250 --> 00:02:59,410
ما العمل؟

32
00:03:00,730 --> 00:03:01,980
!جين-سان

33
00:03:02,640 --> 00:03:03,440
.توشي

34
00:03:03,770 --> 00:03:05,960
ما رأيك في جولة لعبٍ إحياءً
لذكريات الماضي؟

35
00:03:06,380 --> 00:03:10,880
الآن؟ أنت تعلم أنّ
.لدينا مُشكلاتٍ أكبر

36
00:03:11,720 --> 00:03:13,730
إذًا، ما رأيك في جولةٍ؟

37
00:03:19,380 --> 00:03:20,160
.هُزِمتَ

38
00:03:20,890 --> 00:03:22,260
.كان... ذلك سريعًا

39
00:03:22,260 --> 00:03:24,010
هل خَسرت يا هيجيكاتا؟

40
00:03:24,010 --> 00:03:26,510
،اصمت أيّها الصّغير
.اذهب والعب الغُمّيضة

41
00:03:27,320 --> 00:03:28,280
!جولةٌ أُخرى

42
00:03:29,620 --> 00:03:33,780
،المِيبورو مُنقسمون
.وعليّ لمّ شملنا

43
00:03:34,860 --> 00:03:36,890
لكن لا أملك أدنى فِكرةٍ
.عن كيفيّة تحقيق ذلك

44
00:03:39,070 --> 00:03:42,230
يُمكنني إقامة مأدبةٍ
،لتَوطيد الرّوابط بيننا

45
00:03:42,230 --> 00:03:44,580
ولكن هل سيُوافق سيريزاوا؟

46
00:03:44,580 --> 00:03:45,440
.هُزِمتَ

47
00:03:46,550 --> 00:03:48,600
!جولةٌ أُخرى، سُحقًا

48
00:03:49,840 --> 00:03:51,120
.يا لك مِن مَغرورٍ

49
00:03:51,120 --> 00:03:51,840
ماذا؟

50
00:03:52,600 --> 00:03:56,160
أَلم تكن في الثّانية أو الثّالثة عشرة مِن عُمرك
حين قَدِمت إلى الشّيهيكان أوّل مرّةٍ؟

51
00:03:58,140 --> 00:03:59,990
مضى على ذلك أكثر
.مِن عقدٍ مِن الزّمن

52
00:04:00,410 --> 00:04:05,060
ذاك الفتى المُشاكس ثابر
.حتّى صار رجلًا ناضجًا

53
00:04:05,800 --> 00:04:08,830
كنت بعد كُلّ إخفاقٍ تبتكر سُبلًا
.جديدة وتُحاول كرّةً بعد أُخرى

54
00:04:09,130 --> 00:04:12,210
صقلت مهاراتك في السّيف، كما برعت
.في تجارة الدّواء اقتداءً بأسلافك

55
00:04:13,500 --> 00:04:18,750
أنت دائمًا ما تتأمّل المَوقف، وتعرف
.مَوطن الخلل، ثُمّ تجد السّبيل لإصلاحه

56
00:04:19,010 --> 00:04:22,520
.هذا هو جوهر هيجيكاتا توشيزو

57
00:04:24,140 --> 00:04:27,370
،أو هذا هو تصوّري عنك
فهل تُخالفني الرّأي؟

58
00:04:28,520 --> 00:04:30,630
...سأَبدأ بتأمّل المَوقف إذًا

59
00:04:32,540 --> 00:04:34,050
.شُكرًا لك، جين-سان

60
00:04:34,050 --> 00:04:35,020
.لا داعي للشّكر

61
00:04:35,400 --> 00:04:36,180
،هيجيكاتا-كون

62
00:04:37,710 --> 00:04:42,090
ترغب آيزو في الحُصول على قائمةٍ بأعضاء
.المِيبورو الجُدد، ومُخطّطًا لتنظيمنا

63
00:04:42,690 --> 00:04:45,440
لعلّ هذه هي الفُرصة
.الّتي تبحث عنها

64
00:04:48,160 --> 00:04:49,140
.وجدتُها

65
00:04:50,330 --> 00:04:52,710
،جين-سان، يامانامي
.مُدّا لي يد العون

66
00:04:56,100 --> 00:04:59,440
أَتريد منّا أن نُدوّن اسم مَن
نراه جديرًا بقيادة المِيبورو؟

67
00:04:59,440 --> 00:05:00,600
ما مَغزى هذا الإجراء؟

68
00:05:00,600 --> 00:05:03,920
هل تطلب منّا المُفاضلة بين
سيريزاوا-سان وكوندو-سان؟

69
00:05:03,920 --> 00:05:05,330
!الإجابة واضحةٌ

70
00:05:04,980 --> 00:05:08,570
حسنًا، سأمتثل لذلك بدافع
.الوَاجب، بدافع الوَاجب لا أكثر

71
00:05:05,330 --> 00:05:06,960
!سيريزاوا-سينسي العَظيم

72
00:05:08,880 --> 00:05:10,830
مَن غير سيريزاوا-سان؟

73
00:05:18,370 --> 00:05:22,800
يبدو أنّ كِفّة سيريزاوا-سان تَرجح
.بخمسة أصواتٍ مُقابل أربعةٍ لكوندو-سان

74
00:05:23,470 --> 00:05:25,010
إنّه تنافسٌ تقاربت فيه النّتائج
.بشكلٍ مُثير للدّهشة

75
00:05:27,480 --> 00:05:30,400
،هيجيكاتا-كون
ما الّذي تبحث عنه؟

76
00:05:32,580 --> 00:05:33,770
.كُنت مُوقنًا مِن ذلك

77
00:05:35,960 --> 00:05:38,820
،أنت مَن وضع هذه الورقة
أَليس كذلك يا نيو؟

78
00:05:39,210 --> 00:05:40,950
.أجل، أنا مَن فَعل

79
00:05:41,550 --> 00:05:43,450
لماذا لم تُدوّن أيّ اسمٍ؟

80
00:05:44,570 --> 00:05:46,890
،أَمعنت التّفكير مليًا

81
00:05:47,370 --> 00:05:49,260
لكنّي لم أُفلح في حَصر
.الاختيار في رجلٍ واحد

82
00:05:50,280 --> 00:05:55,710
لعلّ تنصيب قائدٍ ليس هو المَسألة
.الأكثر إلحاحًا للمِيبورو في هذه اللّحظة

83
00:05:56,360 --> 00:05:57,310
ما المسألة الأكثر إلحاحًا إذًا؟

84
00:05:58,160 --> 00:06:01,550
حسنًا... أظنّها وضع
.ضوابط تَحكمنا

85
00:06:04,310 --> 00:06:08,930
يبدو أنّ عندي المُهمّة
.المِثالية لك

86
00:06:09,990 --> 00:06:12,140
لماذا لا تُخبره فحسب؟

87
00:06:16,840 --> 00:06:19,220
.نيو، أحتاج مَعونتك

88
00:06:20,010 --> 00:06:22,920
أُريد منك أن تُقيّم حال
.المِيبورو بمنظورك الخاصّ

89
00:06:27,190 --> 00:06:30,570
،سيريزاوا-سان، كوندو-سان
.علينا أن نتحدّث

90
00:06:33,500 --> 00:06:35,050
.فرغنا مِن حَصر الأصوات

91
00:06:35,750 --> 00:06:39,360
اعلموا أنّنا نَهجنا فيها
.نَهجًا عادلًا، فأَصغوا جيّدًا

92
00:06:40,280 --> 00:06:41,090
...القائد هو

93
00:06:43,470 --> 00:06:44,600
!كوندو إيسامي

94
00:06:46,150 --> 00:06:47,400
!فَعلها كوندو-سينسي

95
00:06:47,400 --> 00:06:48,580
!أجل، هذا رائعٌ

96
00:06:48,580 --> 00:06:49,560
!محالٌ

97
00:06:49,560 --> 00:06:51,060
!لا يُمكن أن يكون هذا صحيحًا

98
00:06:51,060 --> 00:06:52,840
...تاليًا، القائد الأعلى

99
00:06:54,550 --> 00:06:55,820
.سيريزاوا كامو

100
00:06:56,010 --> 00:06:57,790
الـ-الأعلى؟

101
00:06:57,790 --> 00:07:01,600
،هذا يعني أنّ له الكلمة العُليا
.كما هو متوقّعٌ مِن سيريزاوا-سينسي

102
00:07:01,600 --> 00:07:03,530
...وقائدنا الآخر هو

103
00:07:03,530 --> 00:07:04,160
ماذا؟

104
00:07:04,160 --> 00:07:05,190
قائدٌ ثالث؟

105
00:07:05,960 --> 00:07:07,070
.نييمي نيشيكي

106
00:07:07,760 --> 00:07:09,040
نييمي-دونو؟

107
00:07:09,040 --> 00:07:10,910
لدينا ثلاثة قادةٍ؟

108
00:07:11,080 --> 00:07:14,850
،اهدؤوا! مَن أُنادي اسمه
.فليُجب

109
00:07:15,300 --> 00:07:16,490
.يامازاكي سوسومو

110
00:07:16,930 --> 00:07:17,400
!حاضرٌ

111
00:07:17,980 --> 00:07:19,250
.أسانو توتارو

112
00:07:19,510 --> 00:07:20,170
!حاضرٌ

113
00:07:20,810 --> 00:07:22,130
.هاياشي شينتارو

114
00:07:23,480 --> 00:07:24,620
.تشيرينو نيو

115
00:07:25,060 --> 00:07:25,530
!حاضرٌ

116
00:07:26,450 --> 00:07:29,040
هؤلاء الخمسة أَدلوا
.بأصواتٍ فارغة

117
00:07:29,450 --> 00:07:32,040
،بمعنى آخر
.لم ينحازوا لأيّ جانبٍ

118
00:07:32,520 --> 00:07:35,590
وبناءً عليه، أُعلن تشكيل
.فريقٍ ثالث مُحايد

119
00:07:36,400 --> 00:07:40,680
سيَعملون على قمع المَفاسد
.وإقامة النّظام بين صُفوفنا

120
00:07:41,080 --> 00:07:43,210
وبصفتهم مُفتّشين، ستكون
.مُهمّتهم التقصّي والتّحقيق

121
00:07:45,120 --> 00:07:47,340
!نتطلّع لخِدمتكم جميعًا

122
00:07:48,640 --> 00:07:49,480
ماذا؟

123
00:07:49,820 --> 00:07:53,030
،إذًا عيّنتم ثلاثة قادةٍ
ومُفتّشين أيضًا؟

124
00:07:53,210 --> 00:07:53,910
.أجل، يا سيّدي

125
00:07:54,680 --> 00:07:58,920
نصبو لبَذل المزيد لأجل حماية
.كيوتو، أكثر مِن أيّ وقتٍ مضى

126
00:07:59,370 --> 00:08:01,910
جيّدٌ، لديّ آمالٌ كبيرة
.مَرجّوة منكم

127
00:08:09,040 --> 00:08:14,850
تتردّد شائعاتٌ بأنّكم أجبرتم
.التّجار على إقراضكم المال

128
00:08:15,400 --> 00:08:18,940
،لا نستطيع التّغاضي عن مثل هذه الأفعال
.في حِين أنّ مُهمّة المِيبورو هي حماية المدينة

129
00:08:19,280 --> 00:08:20,390
ماذا؟

130
00:08:22,580 --> 00:08:26,440
نفقاتنا العسكريّة كُلّها تُبذل
.في سبيل الشّوغونية

131
00:08:26,980 --> 00:08:29,420
.والمِيبورو يمتثلون لأوامر لُورد آيزو

132
00:08:29,420 --> 00:08:33,320
أَلم يكن مِن الأجدى أن
يكون هو عائلنا الأوّل؟

133
00:08:35,120 --> 00:08:39,920
مِن البديهيّ أنّنا نُدرك ثِقل العبء الّذي
،تُشكّله إعالة ثلاثة آلاف مُقاتلٍ على خزينته

134
00:08:40,730 --> 00:08:44,630
لذا سيَعتمد رجال المِيبورو
.على أنفسهم

135
00:08:44,800 --> 00:08:47,130
وأقلّ ما نَرجوه منكم
.هو أن تَدعونا وشأننا

136
00:08:50,080 --> 00:08:52,450
يَحدوني الفُضول، مِن أين
تَرامت إليكم هذه الشّائعات؟

137
00:08:57,510 --> 00:09:02,260
،سأَقوم بزيارة مَصدر هذه الأقاويل
.مقرّ إقامة اللّورد ميناكوتشي

138
00:09:02,600 --> 00:09:04,930
،سيريزاوا-سان
.اسمح لي أن أُرافقك

139
00:09:04,930 --> 00:09:09,750
،سأَكون لطيفًا معهم
.ولا حاجة لي بمَعونتك

140
00:09:15,150 --> 00:09:17,650
أَتظنّ أنّه تعافى مِن تلك
الكَدمة الّتي رأيناها؟

141
00:09:21,200 --> 00:09:25,520
،ناغاكورا، هارادا، وجين-سان
هلّا رافقتموه؟

142
00:09:26,120 --> 00:09:27,380
.كونوا هُناك تحسّبًا لأيّ طارئٍ

143
00:09:27,380 --> 00:09:28,240
.بالتّأكيد

144
00:09:28,240 --> 00:09:29,160
.أنا طوع أَمرك

145
00:09:29,800 --> 00:09:33,840
نييمي-سان، يامازاكي-سان، أرجوكما أن
.تأذنا لي بالذّهاب بالنّيابة عن المُفتّشين

146
00:09:34,890 --> 00:09:38,050
أرغب في مُراقبة تصرّفات سيريزاوا-سان
.عن كثبٍ بقدر استطاعتي

147
00:09:41,540 --> 00:09:45,180
إنّها مُهمّتك الأولى وهي
.مهمّةٌ جسيمة، راقبه جيّدًا

148
00:09:45,770 --> 00:09:46,920
.شُكرًا جزيلًا لكما

149
00:09:51,220 --> 00:09:52,070
مَن تكونون؟

150
00:09:53,000 --> 00:09:57,040
سيريزاوا كامو، القائد الأعلى
،لفِرقة ميبو روشيغومي

151
00:09:57,390 --> 00:09:59,280
.أنا في خدمة لُورد آيزو

152
00:09:59,550 --> 00:10:00,730
لُورد آيزو؟

153
00:10:00,730 --> 00:10:02,030
.لم يُبلّغنا أحدٌ بقُدوم أيّ مبعوثٍ

154
00:10:02,030 --> 00:10:02,850
!تنحّيا

155
00:10:07,250 --> 00:10:08,130
هل أصابكما مَكروهٌ؟

156
00:10:08,610 --> 00:10:09,920
.نعتذر منكما

157
00:10:11,480 --> 00:10:14,440
،نحن فِرقة ميبو روشيغومي
.نعمل تحت رعاية آيزو

158
00:10:14,830 --> 00:10:19,910
تناهى إلى مَسامعنا أنّ فردًا مِن أهل
.هذه الدّار قد نال منّا بالافتراء

159
00:10:19,910 --> 00:10:21,920
.نُصرّ على إحضاره للمُثول أمامنا

160
00:10:22,520 --> 00:10:23,980
.خيرٌ لك أن تخرج

161
00:10:23,980 --> 00:10:26,500
!كلا! سيَقتلونني

162
00:10:26,500 --> 00:10:29,440
.لم أكن أعلم أنّهم بضخامة الدّببة

163
00:10:32,850 --> 00:10:36,120
إذًا أنت المَقصود؟
.لسانك سليطٌ جدًا

164
00:10:37,800 --> 00:10:40,120
لا تجرؤ على الهَرب
!منّي، توقّف مكانك

165
00:10:40,120 --> 00:10:41,310
.هذا لا يُبشّر بالخير

166
00:10:41,310 --> 00:10:42,710
ألا يُوجد تحذيرٌ أو ما شابه؟

167
00:10:49,350 --> 00:10:50,760
.كُفّ عن هذا يا سيريزاوا

168
00:10:50,760 --> 00:10:51,370
!كفاك عبثًا

169
00:10:56,000 --> 00:10:57,720
.واصل ما أنت عليه

170
00:10:59,300 --> 00:11:00,900
ماذا تقول؟

171
00:11:01,790 --> 00:11:03,380
،استرسل في إهانة المِيبورو

172
00:11:03,840 --> 00:11:08,620
،انعتنا بأنّنا مُرعبون، وقساةٌ
.وأشرارٌ، وعتاةٌ، وهمجيّون

173
00:11:08,620 --> 00:11:10,180
.واصل ولا تتوقّف

174
00:11:10,490 --> 00:11:12,850
هـل تقصد معنىً آخر
بكلامك هذا؟

175
00:11:13,570 --> 00:11:16,190
،كلا
.بل هو كما سمعت تمامًا

176
00:11:16,810 --> 00:11:17,520
.نفّذ ما قُلته

177
00:11:20,370 --> 00:11:22,020
.حسنًا، لك ما أردت

178
00:11:25,480 --> 00:11:30,100
،ولا تنسَ كتابة اعتذارٍ رسميّ
.لمُجرّد الحِفاظ على المَظاهر

179
00:11:30,400 --> 00:11:33,880
ولعلّك تُقيم مأدبةً لتعويضنا
.عمّا بدر منك أيضًا

180
00:11:34,700 --> 00:11:36,250
.هذا كُلّ ما عندي، عُذرًا

181
00:11:48,400 --> 00:11:52,740
،عُذرًا يا سيريزاوا-سان
لماذا لم تَزجره عن فِعلته؟

182
00:11:53,720 --> 00:11:57,040
لا أرى سببًا لرغبتك في جعله
.ينشر عنّا شائعاتٍ أكثر سُوءًا

183
00:12:01,220 --> 00:12:03,860
فجاء ردّ سيريزاوا-سان
:على سُؤالي كما يَلي

184
00:12:04,810 --> 00:12:07,110
،أن نكون سَيّئي الصّيت"
".خيرُ مِن أن نكون نكراتٍ مَجهولين

185
00:12:08,100 --> 00:12:09,920
،أن نكون سَيّئي الصّيت
خيرُ مِن أن نكون نكراتٍ مَجهولين؟

186
00:12:10,500 --> 00:12:13,120
...أجل، وقد أخبرني أيضًا

187
00:12:14,000 --> 00:12:18,560
أنّنا لا يُمكننا تجنّب وُقوع حربٍ
.في كيوتو، لذا علينا الاستعداد لها

188
00:12:19,390 --> 00:12:22,940
إنّه يرغب في جعل المِيبورو قُوّةً
.يُهاب جانبها قبل أن يقع ذلك

189
00:12:24,200 --> 00:12:27,460
إنّه لا يرى الأمور بذات الطّريقة الّتي
.يراها كوندو-سان وهيجيكاتا-سان

190
00:12:28,440 --> 00:12:31,910
ترجو مجموعة كوندو عَقد صُلحٍ
،مع مُصارعي السّومو في أوساكا

191
00:12:32,440 --> 00:12:35,880
وجني المال مِن خلال استضافة
.نِزالاتهم في ميبو

192
00:12:36,450 --> 00:12:39,380
بينما يقوم سيريزاوا-سان بإرغام
.التّجار على إقراضه المال

193
00:12:39,600 --> 00:12:41,370
كيف يُمكن أن يَتباينوا
إلى هذا الحدّ؟

194
00:12:41,950 --> 00:12:44,870
إنّه الفرق بين عقليّة
.السّاموراي والفلّاحين

195
00:12:45,470 --> 00:12:46,500
ماذا تقصد بقولك هذا؟

196
00:12:47,160 --> 00:12:49,400
مجموعة كوندو تَنحدر
.مِن أصولٍ فلاحيّة

197
00:12:50,080 --> 00:12:53,400
فهم مِمّن يبذرون البُذور، ويرعون
.سنابل الأرزّ، ويحصدون محاصيلهم

198
00:12:54,240 --> 00:12:56,900
أمّا سيريزاوا فهو ساموراي
.حتّى النّخاع

199
00:12:57,470 --> 00:13:00,710
يستولي على ما يَجده في طريقه
.مُقابل الحماية الّتي يُوفّرها

200
00:13:01,500 --> 00:13:03,720
جوهريًا، لا يُمكن لأيّ منهما
.أن يفهم الآخر

201
00:13:04,080 --> 00:13:06,180
.فالفَجوة عميقةٌ ومِن المُستحيل تقريبها

202
00:13:07,540 --> 00:13:09,840
إنّ نهج سيريزاوا القَسري
،يُمثّل مُشكلةً

203
00:13:10,420 --> 00:13:14,230
لكن لا بُدّ أن تُدرك أنّه يعمل
.وفق منطقٍ ومبادئ خاصّة به

204
00:13:15,320 --> 00:13:16,060
.فهمت

205
00:13:16,560 --> 00:13:20,050
،لكن بصفتي فردًا لا مُفتّشًا

206
00:13:21,050 --> 00:13:24,160
لا أقوى على بُغض سيريزاوا-سان
.مِن أعماق قلبي

207
00:13:27,130 --> 00:13:28,330
.وثمّة أمرٌ آخر

208
00:13:28,980 --> 00:13:31,500
.تبيّنت ما الّذي يُحفّز سيريزاوا-سان

209
00:13:31,990 --> 00:13:32,900
وما عساه أن يكون؟

210
00:13:33,430 --> 00:13:34,280
.العَجلة ونفاد الصّبر

211
00:13:35,070 --> 00:13:39,040
بدا سيريزاوا-سان وكأنّ هُناك
.ما يَسوقه قسرًا نحو غايته

212
00:13:40,670 --> 00:13:42,190
—هل يُعقل أنّه

213
00:13:42,190 --> 00:13:43,730
.فهمت، أحسنت صُنعًا

214
00:13:48,770 --> 00:13:52,190
،سأتولّى زِمام الأمور مِن هُنا
.فهذا صميم عملي

215
00:13:54,680 --> 00:13:55,590
.نييمي-سان

216
00:13:58,780 --> 00:13:59,680
،سايتو-كون

217
00:14:01,590 --> 00:14:04,950
تناهت شائعاتٌ إلى مسامعي عن
.ساموراي غريب الأطوار في فوشيمي

218
00:14:05,190 --> 00:14:06,770
.لعلّه رُونين متطرّفٌ

219
00:14:07,260 --> 00:14:09,060
هل أنت مستعدٌ للتحرّي عنه؟

220
00:14:15,680 --> 00:14:18,960
ما الّذي يقصده يامانامي-سان
بقوله "ساموراي غريب الأطوار"؟

221
00:14:18,960 --> 00:14:21,410
كيف يُفترض بي أن أجده بناءً
على ذلك الوصف فحسب؟

222
00:14:26,380 --> 00:14:29,370
حصانٌ، أليس كذلك؟
.الأحصنة رائعةٌ حقًا

223
00:14:29,640 --> 00:14:31,430
.كم أودّ رُكوب أحدها

224
00:14:31,830 --> 00:14:34,090
رُبّما سيمتلك المِيبورو
.مَربطًا للخُيول يومًا ما

225
00:14:36,290 --> 00:14:37,020
ماذا؟

226
00:14:39,340 --> 00:14:42,730
بلغ بي الجُوع مَبلغه
.حتّى سقطت في النّهر

227
00:14:43,370 --> 00:14:44,750
.غريب أطوارٍ آخر

228
00:14:45,790 --> 00:14:48,700
،كان أنيجاكوجي عبئًا ثقيلًا بما يكفي
فلماذا أجذب المَجانين دومًا؟

229
00:14:49,950 --> 00:14:51,330
مَن أنت بحقّ الجحيم؟

230
00:14:51,330 --> 00:14:52,240
.معذرةً

231
00:14:52,240 --> 00:14:52,880
!هذا الرّجل ضخمٌ للغاية

232
00:14:53,640 --> 00:14:55,650
.ظننت ساقك عمودًا

233
00:14:57,490 --> 00:15:00,010
ألا يَصدف أن يكون
معك حساء دجاجٍ؟

234
00:15:00,010 --> 00:15:01,820
ولماذا بحقّ الجحيم سيكون
معي شيءٌ كهذا؟

235
00:15:01,820 --> 00:15:04,050
بمَقدور أيّ شخصٍ أن
.يُدرك أنّك شخصٌ مُريب

236
00:15:04,050 --> 00:15:05,720
—أخبرني باسمك والمُقاطعة الّتي

237
00:15:05,000 --> 00:15:05,720
.معذرةً

238
00:15:05,720 --> 00:15:08,320
هل يُمكنكِ إعطائي طعامًا لأسدّ
.به جُوعي؟ لست مُتطلبًا

239
00:15:08,320 --> 00:15:09,530
!أنصت إليّ

240
00:15:10,840 --> 00:15:12,300
،لديّ فِجلٌ مُخلّل

241
00:15:13,060 --> 00:15:14,100
هل تُريد بعضًا منه؟

242
00:15:14,100 --> 00:15:15,320
!كلا

243
00:15:15,320 --> 00:15:16,760
.هيّا، خُذ منه قضمةً

244
00:15:16,760 --> 00:15:18,880
.أخبرتك أنّي لا أُريده

245
00:15:19,150 --> 00:15:20,480
.هيّا، لا بأس بذلك

246
00:15:28,550 --> 00:15:29,960
.كِدت أن أُسقطه

247
00:15:32,190 --> 00:15:34,650
.سيف السّاموراي بمثابة رُوحه

248
00:15:34,650 --> 00:15:36,120
.لا تستخدمه بهذه الطّريقة

249
00:15:36,880 --> 00:15:37,880
رُوحه؟

250
00:15:38,490 --> 00:15:43,240
،هذا الشّيء مُجرّد أداةٍ
.ومحالٌ أن يكون رُوحي

251
00:15:50,090 --> 00:15:52,460
أنا سايتو هاجيمي مِن
.ميبو روشيغومي

252
00:15:53,010 --> 00:15:55,720
ما اسمك؟ وأيّ مُقاطعةٍ تتبع؟

253
00:15:59,190 --> 00:16:03,150
،أنا ساكاموتو ريوما
.ولا أَتبع أيّ مُقاطعةٍ

254
00:16:05,150 --> 00:16:06,160
.أنا مُجرّد إنسانٍ

255
00:16:07,000 --> 00:16:08,170
ساكاموتو؟

256
00:16:08,570 --> 00:16:10,310
هل قُلت ساكاموتو ريوما؟

257
00:16:10,880 --> 00:16:15,920
إن كان الأمر كذلك، فإنّ أشخاصًا مثل ذاك
،الرّجل، ممّن يسعون لدفعنا نحو المستقبل

258
00:16:16,480 --> 00:16:20,290
.قد يغدون يومًا ألدّ خُصومك

259
00:16:23,020 --> 00:16:26,920
،ذلك الرّونين ساكاموتو ريوما
.مِن مُقاطعة توسا سابقًا

260
00:16:27,920 --> 00:16:30,110
هل هذا الرّجل هو ساكاموتو ريوما؟

261
00:16:30,720 --> 00:16:32,280
.تبًا

262
00:16:33,080 --> 00:16:36,560
،فقدت صُرّة المال
.لا بُدّ أنّها سقطت منّي في النّهر

263
00:16:37,680 --> 00:16:38,640
.هذه مشكلةٌ حقًا

264
00:16:45,310 --> 00:16:46,140
،هاجيمي

265
00:16:47,780 --> 00:16:49,320
لماذا تُساعدني؟

266
00:16:49,320 --> 00:16:51,840
اصمت، أنت بحاجةٍ إلى
صُرّة المال، أليس كذلك؟

267
00:16:52,240 --> 00:16:53,720
.إذن فلنَبحث عنها وحسب

268
00:16:53,720 --> 00:16:54,920
!مهلًا

269
00:16:55,250 --> 00:16:56,910
ما خطبكما؟

270
00:16:57,550 --> 00:16:59,570
.فقدت صُرّة المال

271
00:17:00,080 --> 00:17:02,400
هل تُساعدنا في البحث عنها
إن كان لديك متّسعٌ مِن الوقت؟

272
00:17:02,740 --> 00:17:05,530
سأُقاسمك المال الّذي
.بداخلها إن وجدتها

273
00:17:05,820 --> 00:17:07,310
.هذا عرضٌ مُغرٍ

274
00:17:07,550 --> 00:17:08,880
أظنّ أنّي سأُشارك
.في البحث أيضًا

275
00:17:09,310 --> 00:17:12,410
ساكاموتو، ذكرت أنّك لم
.تأكل شيئًا مُنذ أيّامٍ

276
00:17:12,410 --> 00:17:14,320
ما الّذي كُنت تفعله لتدبير مَعيشتك؟

277
00:17:15,490 --> 00:17:17,260
.أُنشئ أُسطولًا بحريًا

278
00:17:18,720 --> 00:17:19,640
أُسطولًا بحريًا؟

279
00:17:20,390 --> 00:17:24,660
استدنت خمسة آلاف ريو لتأسيس
.مركز تدريبٍ بحريّ في كاندا

280
00:17:25,520 --> 00:17:29,720
أنا في طريق العودة الآن بعد أن أدّيت واجب
.الشّكر للّورد ماتسودايرا شونغاكو مِن إيتشيزين

281
00:17:29,720 --> 00:17:32,490
خمسة آلاف ريو؟
أَقرضك لوردٌ كُلّ هذا المَبلغ؟

282
00:17:33,190 --> 00:17:34,030
.هذا صحيحٌ

283
00:17:34,830 --> 00:17:37,950
ألا يُجيد هذا الرّجل شيئًا
سوى بيع الأوهام؟

284
00:17:38,890 --> 00:17:41,540
.أتعلم، يبدو هذا مُمتعًا

285
00:17:42,060 --> 00:17:43,080
!يا هذا

286
00:17:43,670 --> 00:17:46,240
أَتودّ الانضمام إلينا لتَقي نفسك
حرّ الشّمس أيّها السّاموراي؟

287
00:17:47,340 --> 00:17:48,000
.سخفٌ شديد

288
00:17:50,630 --> 00:17:52,970
مُعظم السّاموراي يترفّعون
.عن المُساعدة

289
00:17:53,200 --> 00:17:54,810
.ستَصدأ سُيوفهم إن لم يفعلوا

290
00:17:55,140 --> 00:17:58,530
يجب عليهم أن يضعوا سُيوفهم
.جانبًا، كما نفعل نحن تمامًا

291
00:18:02,880 --> 00:18:07,040
يندفع السّاموراي خلف انفعالاتهم
.حينما يُواجهون القُوى الأجنبيّة

292
00:18:07,420 --> 00:18:12,240
بعد تشوشو، ها هي ساتسوما الآن
.تخوض صِراعًا ضدّ إنجلترا

293
00:18:12,240 --> 00:18:13,070
ساتسوما أيضًا؟

294
00:18:13,510 --> 00:18:15,990
حادثة "ناماموغي" هي
.ما أَشعلت الفَتيل

295
00:18:16,360 --> 00:18:20,570
حيث اعترض بعض الإنجليز على
،خُيولهم طريق مَوكب دايميو ساتسوما

296
00:18:20,570 --> 00:18:22,740
فما كان مِن السّاموراي إلّا أن
.أَردوهم قتلى في مكانهم

297
00:18:24,080 --> 00:18:26,800
كان حظ أُولئك الأجانب
.عاثرًا باصطدامهم بالسّاموراي

298
00:18:28,000 --> 00:18:32,050
كما كُنت أقول، السّاموراي ليسوا سُوى
.حِفنةٍ مِن البُلهاء مُتحجّري الرّؤوس

299
00:18:32,530 --> 00:18:33,260
ماذا؟

300
00:18:33,600 --> 00:18:36,270
،السّاموراي لا قيمة لهم
.مُجرّد هباءٍ

301
00:18:36,890 --> 00:18:40,170
كُلّنا في النّهاية بشرٌ مِن
.لحمٍ ودم لا فرق بيننا

302
00:18:41,140 --> 00:18:43,800
أُراهن أنّك تُعاني مِن
.أمثالهم في حياتك

303
00:18:44,600 --> 00:18:48,690
أُولئك المُنغلِقين الّذين يتمسّكون بقُشور التّقاليد
.ويَتوارون خلف مظاهر السّاموراي الجوفاء

304
00:18:52,470 --> 00:18:54,510
ولكن، أَلست واحدًا منهم؟

305
00:18:54,690 --> 00:18:57,950
.بلى، أنا بشرٌ مثلهم تمامًا

306
00:18:58,670 --> 00:19:01,760
لكن الفرق أنّي تجرّدت
.مِن كبريائي ومشاعري

307
00:19:02,200 --> 00:19:06,240
،أنا الآن مُجرّد أداةٍ خاوية مِن الأهواء
.وُجدت لتحقيق غايةٍ لا أكثر

308
00:19:07,630 --> 00:19:09,100
ما خطب هذا الرّجل؟

309
00:19:10,930 --> 00:19:13,460
إذن، ما هي تلك الغاية
الّتي تسعى لتَحقيقها؟

310
00:19:13,830 --> 00:19:14,900
أَلم تُدرك بعد؟

311
00:19:17,820 --> 00:19:22,420
سأُطهّر أرض اليابان العَفنة
.مِن كُلّ شوائبها لتعود نقيّةً

312
00:19:25,480 --> 00:19:26,490
.أيّها العجوز

313
00:19:27,600 --> 00:19:30,340
مرّ ألف عامٍ مُنذ أن ساد
.السّاموراي هذه البلاد

314
00:19:30,960 --> 00:19:32,860
،وبعد انقضاء هذه الألفيّة

315
00:19:33,720 --> 00:19:39,060
يظهر لنا هذا الشّخص بمنطقه
.الشّاذ الّذي يبعث على القلق

316
00:19:39,550 --> 00:19:41,780
مَن ذا الّذي ألقى هذا الشّيء هُنا؟

317
00:19:42,810 --> 00:19:46,440
لم يمرّ بي مَن يستخفّ
.بشأن السّاموراي مثله قطّ

318
00:19:47,700 --> 00:19:49,120
.إنّه رجلٌ خَطِرٌ

319
00:19:50,510 --> 00:19:53,520
.فقد يقلب مَوازين عالمنا يومًا ما

320
00:19:54,480 --> 00:19:56,010
لذا، يجب عليّ الآن
...وفي هذه اللّحظة أن

321
00:19:56,010 --> 00:19:57,250
!وجدتها

322
00:19:58,360 --> 00:19:59,320
أَهذه هي صُرّة المال خاصّتك؟

323
00:19:59,320 --> 00:20:02,090
،أجل، هي بذاتها
.شُكرًا لك

324
00:20:02,410 --> 00:20:03,760
.أنا ممتنٌّ حقًا لكُلّ ما قدّمته لي

325
00:20:03,760 --> 00:20:05,150
!أنا سعيدٌ لأنّك وجدت ضالّتك

326
00:20:07,840 --> 00:20:10,940
،إليك هذه النّبتة ذات الأوراق الأربع
.يقولون إنّها جالبةٌ للحظّ

327
00:20:11,410 --> 00:20:13,760
.بعثت بها أُختي مِن توسا

328
00:20:14,280 --> 00:20:15,860
وهي عندي أَغلى مِن
.الدّنيا وما فيها

329
00:20:15,860 --> 00:20:17,900
.يا لها مِن قصةٍ تُدفئ القلب

330
00:20:18,810 --> 00:20:21,200
!هذا القارب متّجهٌ إلى أوساكا

331
00:20:22,240 --> 00:20:23,900
!مهلًا! خُذني معك

332
00:20:25,120 --> 00:20:28,020
سأُشارك في التّجديف مُقابل
.تخفيضٍ في ثمن الرّحلة

333
00:20:28,020 --> 00:20:29,290
متى أصبح هذا التصرّف مقبولًا؟

334
00:20:40,760 --> 00:20:42,120
...على فكرةٍ

335
00:20:43,380 --> 00:20:46,100
لاحظت أنّك تضع سيفيك
،على جانبك الأيمن

336
00:20:46,820 --> 00:20:48,920
.وهذا يُخالف أعراف السّاموراي

337
00:20:49,880 --> 00:20:53,880
لعلّك تُعاشر أشخاصًا لا يقبلون
.أن تُقيّدهم التّقاليد

338
00:20:59,340 --> 00:21:00,920
،تمسّك بأمثال هؤلاء

339
00:21:01,400 --> 00:21:04,320
.فهُم مَكسبٌ حقيقيّ

340
00:21:11,510 --> 00:21:14,290
،لا تفقد صُرّة المال مرّةً أُخرى
.يا ساكاموتو

341
00:21:16,140 --> 00:21:17,630
!إلى اللّقاء

342
00:21:16,990 --> 00:21:18,620
!أيّها السيّد
!لا تقف على متن القارب

343
00:21:19,460 --> 00:21:22,140
!رافقتك السّلامة، يا هاجيمي

344
00:21:23,340 --> 00:21:26,480
...هل سيأتي زمنٌ

345
00:21:26,480 --> 00:21:30,340
.قد يغدو يومًا ألدّ خُصومك...

346
00:21:31,000 --> 00:21:34,020
أَلتفت فيه إلى يومي هذا بغصّةٍ وندم؟...

347
00:21:35,850 --> 00:21:38,700
هل سيَبزغ فجر عصرٍ جديد يُسدل
فيه السّتار على عهد السّاموراي؟

348
00:21:40,190 --> 00:21:43,350
،وإن بلغنا ذلك الحين
فماذا سيَكون مَصيري؟

349
00:23:22,110 --> 00:23:23,330
.تانكا تارو يُحدّثكم

350
00:23:24,290 --> 00:23:28,090
دائمًا ما يبدو سيريزاوا-سينسي
.رجلًا عظيمًا وشهمًا

351
00:23:28,640 --> 00:23:33,210
،لا أُنكر أنّ طِباعه حادّةٌ ومثيرةٌ للجدل
.لكن قلبه عطوفٌ على الصّغار

352
00:23:33,470 --> 00:23:35,960
حتّى الصّغيرة أوكيكو مِن
.عائلة ياجي تكنّ له المودّة

353
00:23:36,580 --> 00:23:39,570
لذا سأظلّ أتّخذه قُدوةً لي
.كما كُنت على الدّوام

354
00:23:40,880 --> 00:23:45,130
هل يُوجد ما يُمكنني فِعله
مِن أجل سيريزاوا-سينسي؟

355
00:23:46,070 --> 00:23:48,050
."الحلقة القادمة: "وَهج اليَراع