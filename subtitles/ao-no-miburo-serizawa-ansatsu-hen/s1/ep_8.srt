1
00:00:01,370 --> 00:00:02,400
هاياشي-سان؟

2
00:00:02,400 --> 00:00:03,810
إلى أين نَهرع هكذا؟

3
00:00:04,490 --> 00:00:05,610
.إنّه نيمي-سان

4
00:00:06,320 --> 00:00:07,310
.لقد أَنهى حياته بيَده

5
00:00:10,320 --> 00:00:11,750
...محالٌ

6
00:00:11,750 --> 00:00:13,010
،على أيّ حالٍ
.هيّا بنا إلى جيون

7
00:00:13,320 --> 00:00:15,200
تناهى إلى مَسامعي أنّه شقّ بطنه
.في حُجرةٍ مُخصّصة للاحتفال

8
00:00:15,200 --> 00:00:16,510
.يا لها مِن فوضى مُروّعة

9
00:00:16,510 --> 00:00:17,540
أَلم يكُن مِن رجال المِيبورو؟

10
00:00:17,850 --> 00:00:19,000
.إنّ ما جرى يَبعث على القشعريرة

11
00:00:17,850 --> 00:00:19,000
!افسحوا لنا الطّريق

12
00:00:19,000 --> 00:00:20,250
!معذرةً

13
00:00:21,780 --> 00:00:23,900
...نيمي-سان
لماذا فَعلت ذلك؟

14
00:01:58,730 --> 00:02:00,960
.نيو، لا تَنظر

15
00:02:01,520 --> 00:02:03,350
.كلا، سأَكون بخيرٍ

16
00:02:04,010 --> 00:02:05,350
.لا تُجبر نفسك

17
00:02:05,350 --> 00:02:09,110
سأَنظر، عليّ أن أُدرك
.حقيقة ما جرى

18
00:02:14,760 --> 00:02:17,280
!يا للهول
.بات المكان مُضرّجًا بالدّماء

19
00:02:17,280 --> 00:02:18,870
.لم يكُن مُتكتّمًا في فِعلته قطعًا

20
00:02:23,780 --> 00:02:27,040
،سدّدوا لصاحب المكان حقّه
.بما في ذلك أُجور التّنظيف

21
00:02:27,040 --> 00:02:29,210
.واستدعوا رجالًا لإجلاء الجُثمان

22
00:02:29,210 --> 00:02:30,270
،لا حاجة لذلك يا سيّدي

23
00:02:30,270 --> 00:02:33,440
.فقد تلقّينا الأجر كاملًا

24
00:02:33,440 --> 00:02:34,250
ماذا؟

25
00:02:34,830 --> 00:02:36,620
،قُبيل العُثور على الجُثّة

26
00:02:37,020 --> 00:02:42,270
،خرج رجلٌ ضخمٌ يرتدي رِداءً أبيض
.وقد كانت ثيابه مُلطّخةً بالدّماء

27
00:02:42,450 --> 00:02:44,990
...سيريزاوا
مَن عساه يكون سِواه؟

28
00:02:48,400 --> 00:02:50,730
لماذا قد يَنحر القائد نيمي نفسه؟

29
00:02:50,730 --> 00:02:51,800
.لا عِلم لي

30
00:02:51,800 --> 00:02:55,740
رُبّما كان يجمع الأموال سِرًا
واضطرّ لتحمّل التّبعات؟

31
00:02:56,040 --> 00:02:59,050
،أيّها الحمقى! نال منه سيريزاوا
.وهذا جليٌّ تمامًا

32
00:02:59,050 --> 00:03:02,240
هل تعني أنّ سيريزاوا اغتاله
ثُمّ جعل الحادثة تبدو كأنّها سيبوكو؟

33
00:03:02,750 --> 00:03:04,610
.لا أفهم كيف يكون ذلك مُمكنًا

34
00:03:05,480 --> 00:03:08,360
.لا بُدّ أنّ نيمي مَن شقّ بطنه بنفسه

35
00:03:08,760 --> 00:03:10,870
لم تكن هُناك أيّ جُروحٍ
.غير مألوفةٍ سِواها

36
00:03:11,250 --> 00:03:15,780
،أسانو-سينسي طبيبٌ سابق
.وعلينا الاعتداد برأيه

37
00:03:15,780 --> 00:03:18,800
أنا على يقينٍ أنّ شخصًا آخر قام
.بفَصل الرّأس عن الجسد، بالطّبع

38
00:03:19,490 --> 00:03:21,350
.لا بُدّ أنّه سيريزاوا

39
00:03:21,350 --> 00:03:23,560
أَرغم نيمي-سان على طقس
.السّيبوكو قَسرًا

40
00:03:23,910 --> 00:03:25,400
.يَصعب تصديق ذلك

41
00:03:26,080 --> 00:03:30,360
،مهما كانت نيّة القائد نيمي
.لا مفرّ لنا مِن مُجابهة الحقيقة الرّاهنة

42
00:03:31,020 --> 00:03:31,850
...المُعضلة هي

43
00:03:32,870 --> 00:03:36,120
أنّنا نحن المُفتّشين قد فقدنا
.قائدًا لا يُعوّض

44
00:03:37,740 --> 00:03:40,630
إذن، ماذا نحن فَاعِلون الآن؟

45
00:03:41,450 --> 00:03:42,370
لماذا؟

46
00:03:43,340 --> 00:03:46,860
،سأتولّى زِمام الأمور مِن هُنا
.فهذا صميم عملي

47
00:03:47,780 --> 00:03:50,240
.إنّما قيمة السّاموراي تكمن في مِيتته

48
00:03:51,010 --> 00:03:52,250
.خلف هذه الحادثة ما خَفي

49
00:03:53,490 --> 00:03:54,320
ما خطبك؟

50
00:03:55,360 --> 00:03:56,200
.لا شيء

51
00:03:57,000 --> 00:03:59,920
،فَكّر مليًا
ما الّذي سيَقع تاليًا؟

52
00:04:00,470 --> 00:04:01,580
...ما الّذي

53
00:04:02,130 --> 00:04:06,350
لا يُمكنني حماية ما هو أبعد مِن
.هذا الحصير الّذي أجلس عليه

54
00:04:06,640 --> 00:04:08,740
ما بِيَدي فِعله؟

55
00:04:14,760 --> 00:04:16,010
...لا تَقل لي أنّ

56
00:04:16,010 --> 00:04:19,320
،يامانامي
.ما سيَحدث هُو نتيجةٌ مَحتومة

57
00:04:19,850 --> 00:04:22,250
.فسّر الواقعة كما شِئت بعد وقوعها

58
00:04:22,920 --> 00:04:27,290
!يا للعجب
.إنّي أتبنّى وجهة نَظرٍ مُغايرةً تمامًا

59
00:04:27,410 --> 00:04:30,490
.كُنت رجلًا يُحتذى به يا نيمي-سان

60
00:04:32,130 --> 00:04:35,620
لا يَسعنا أن ندعَ الخلاف ينخر في كياننا
.ويَنتشر بين رجالنا أكثر مِن ذلك

61
00:04:38,050 --> 00:04:40,000
أَلم يأنِ الأوان لنتّخذ إجراءً ما؟

62
00:04:40,170 --> 00:04:41,270
.أعلم ذلك

63
00:04:42,840 --> 00:04:43,560
.توشي

64
00:04:44,520 --> 00:04:45,680
.علينا أن نتحدّث

65
00:04:46,010 --> 00:04:47,900
.في مكانٍ لا يسمعنا فيه أحدٌ

66
00:04:59,440 --> 00:05:01,360
.لا بُدّ لـ سيريزاوا أن يَلقى حتفه

67
00:05:01,770 --> 00:05:02,800
.سأُجهز عليه بنفسي

68
00:05:03,980 --> 00:05:06,910
لـ-لكن لماذا؟
.أَمرت بالتريّث مِن قبل

69
00:05:07,420 --> 00:05:09,880
.انقضى الشّهر الّذي حدّدته

70
00:05:10,220 --> 00:05:14,920
،إن سمحت لي بالسّؤال
ما كان الغرض مِن تلك المُهلة؟

71
00:05:16,070 --> 00:05:17,410
.لا يَسعني الإفصاح

72
00:05:26,770 --> 00:05:27,610
.كلا

73
00:05:28,890 --> 00:05:30,580
.لن أسمح لك بالمُشاركة

74
00:05:31,070 --> 00:05:34,060
.عليك البقاء بعيدًا عن هذه الخُطّة

75
00:05:37,920 --> 00:05:40,760
هل تُريد إفساد كُلّ شيءٍ؟

76
00:05:41,390 --> 00:05:42,500
وما الّذي سأُفسده؟

77
00:05:42,970 --> 00:05:46,560
هل تعني الإخفاق؟
هل سيُزعجك ذلك؟

78
00:05:46,840 --> 00:05:48,360
.ليس هذا ما أَرمي إليه

79
00:05:48,360 --> 00:05:51,320
،إذا ذاعَ أنّك صرعته بدافع ضَغينةٍ

80
00:05:51,680 --> 00:05:54,820
فمَاذا سيَحلّ بنا نحن المِيبورو
تحت لِواء "الإخلاص"؟

81
00:05:55,200 --> 00:05:59,340
،سيَضيع كُلّ ما بَنيناه
.كلا، لا يُمكنك التّواجد حين يحدث ذلك

82
00:05:59,710 --> 00:06:01,030
.ليست هذه ضَغينةً

83
00:06:01,540 --> 00:06:04,330
.المُنازلة وجهًا لوجهٍ هي نهج السّاموراي

84
00:06:04,890 --> 00:06:07,340
.إنّ المسألة تتعلّق بالمُروءة والإنسانيّة

85
00:06:08,840 --> 00:06:09,920
.لا بأس

86
00:06:11,080 --> 00:06:12,860
.اقتلني إذن

87
00:06:13,190 --> 00:06:16,480
وإلّا، فإنّي مغادرٌ صُفوف المِيبورو
.وعائدٌ إلى إيدو

88
00:06:18,480 --> 00:06:20,230
.احسم خِيارك

89
00:06:20,440 --> 00:06:23,240
هل ستَمنحني حُريّة التصرّف؟

90
00:06:23,240 --> 00:06:26,240
أم ستُدير جماعة المِيبورو بمُفردك دُوني؟

91
00:06:37,650 --> 00:06:38,510
.كما تشاء

92
00:06:40,680 --> 00:06:44,750
.أنا أُقرّ أنّي أرغمتك على الانتظار بدءًا

93
00:06:45,450 --> 00:06:48,000
.المُهمّة برُمّتها موكولةٌ إليك

94
00:06:50,450 --> 00:06:54,260
لكنّك يا توشي لن تستطيع الانتصار
.على سيريزاوا-سان

95
00:06:55,360 --> 00:06:56,290
.أعلم ذلك

96
00:06:57,640 --> 00:06:58,760
.أنا مَن سيَفعل

97
00:06:59,890 --> 00:07:01,980
.أنا مَن سيَصرع سيريزاوا-سان

98
00:07:04,000 --> 00:07:06,520
.هكذا إذن... ليَكُن

99
00:07:08,960 --> 00:07:10,480
.رُويدكما

100
00:07:10,480 --> 00:07:11,320
هارادا-سان؟

101
00:07:11,710 --> 00:07:14,200
.سأَقتل ذلك الوغد سيريزاوا

102
00:07:15,120 --> 00:07:16,880
.لن تستطيع

103
00:07:17,430 --> 00:07:19,040
!قُلت إنّي سأَفعلها

104
00:07:19,920 --> 00:07:22,340
!هاسوموكاي، هاسوموكاي

105
00:07:22,340 --> 00:07:25,710
.شُكرًا لك، هارادا-سان

106
00:07:27,960 --> 00:07:29,340
.أنا مَن سيَقوم بذلك

107
00:07:30,840 --> 00:07:33,430
،تمهّلا
.ليس هذا وقت الانقسام

108
00:07:33,680 --> 00:07:36,020
علينا حسم هذا النّزاع
.على نهج شيهيكان

109
00:07:36,720 --> 00:07:38,100
.إذن، لا مَناص عن المُنازلة

110
00:07:38,470 --> 00:07:39,790
.لا أرى مَانعًا مِن ذلك

111
00:07:39,790 --> 00:07:41,360
.أَرنا ما عندك

112
00:07:48,800 --> 00:07:49,710
ناغاكورا؟

113
00:07:51,410 --> 00:07:53,480
.لا أَقوى على فِعل هذا

114
00:07:55,640 --> 00:07:58,470
،لا أَلومه
.ليس وهُو يتولّى تدريب تارو

115
00:07:58,470 --> 00:08:03,100
إنّه يَنتهج ذات الأسلوب الّذي يتّبعه
.سيريزاوا، رُبّما كان هذا ما جعله يتردّد

116
00:08:03,910 --> 00:08:07,040
،إنّه يرغب في التمسّك بمبادئه فحسب

117
00:08:07,040 --> 00:08:08,530
.فهذا هُو دَيدنه

118
00:08:09,450 --> 00:08:11,560
تظنّ أنّ لك فُرصةً في النّصر وأنا لا؟

119
00:08:11,990 --> 00:08:13,660
.لنَختبر صِدق قولك في النّزال

120
00:08:13,910 --> 00:08:15,220
.أجل، ليَكُن

121
00:08:17,750 --> 00:08:19,940
،الرّمح سِلاحٌ مُراوغ

122
00:08:20,330 --> 00:08:22,810
فهُو يتميّز بأفضليّةٍ قاطعة
.بسبب طُول مَداه

123
00:08:23,210 --> 00:08:26,310
،ورُمح سانوسوكي بالغ الطّول

124
00:08:26,680 --> 00:08:29,610
لكنّك لن تُدرك ذلك إلّا
.إذا كُنت قد نازلته مِن قبل

125
00:08:30,690 --> 00:08:33,570
جَرت عادته على الالتزام بالسّيف
.عندما يُبارزنا

126
00:08:33,570 --> 00:08:37,110
فلا رَيب أنّه يستشعر أنّ مِيزة الرّمح
.ليست مِن الإنصاف في شيءٍ

127
00:08:37,520 --> 00:08:41,590
إذن، حِين نِزال الرّماح، يكمن السّر
.كُلّه في كيفية الاقتراب منه

128
00:08:42,330 --> 00:08:45,340
.حتّى سوجي سيَجد مشقّةً في ذلك

129
00:08:48,380 --> 00:08:49,470
.بل النّقيض تمامًا

130
00:08:49,470 --> 00:08:50,350
ماذا؟

131
00:08:50,720 --> 00:08:52,310
.أوكيتا يعتمد القَبضة المَعكوسة

132
00:09:01,400 --> 00:09:05,760
،كما ترى
.سأَبذل كُلّ ما في وسعي لبُلوغ غايتي

133
00:09:08,940 --> 00:09:11,340
أعلم أنّ هذا يبتعد كُلّ البُعد
.عن شِيم السّاموراي

134
00:09:12,340 --> 00:09:14,730
.لكن النّصر حَليفي

135
00:09:16,150 --> 00:09:17,740
هل هذا مسموحٌ به أصلًا؟

136
00:09:18,570 --> 00:09:21,740
متيقّنٌ أنّك ستُعامل سيفك بهذه
.الطّريقة؟ سيَنكسر لا محالة

137
00:09:21,910 --> 00:09:24,200
،تآكل حَدّه بالفعل

138
00:09:24,430 --> 00:09:27,750
وكُنت سأَبتاع واحدًا جديدًا
.مِن ساكورا-سان غدًا

139
00:09:30,040 --> 00:09:32,240
هيجيكاتا! متى سنَفعلها، وأين؟

140
00:09:32,240 --> 00:09:33,760
هل لديك خطّةٌ بعد؟

141
00:09:33,960 --> 00:09:34,800
!أخبرنا

142
00:09:41,630 --> 00:09:42,720
.حسنًا

143
00:09:43,320 --> 00:09:46,440
،سنَتحرّك بعد خمسة أيّامٍ
.في الثّامن عشر مِن الشّهر التّاسع

144
00:09:47,020 --> 00:09:48,980
لماذا ذلك اليوم تحديدًا؟

145
00:09:49,420 --> 00:09:52,850
مِن المُقرّر أن تحتفل قُوّاتنا
.بأَكملها في شيمابارا

146
00:09:53,240 --> 00:09:58,360
مكافأة جُهدنا خلال الانقلاب
.وعمليّات التّطهير ستُغطّي النّفقات

147
00:09:58,360 --> 00:10:00,490
.تمّ التّرتيب لذلك مُنذ مُدّةٍ

148
00:10:00,680 --> 00:10:03,120
.وبالطّبع سيَكون سيريزاوا ورِفاقه هُناك

149
00:10:03,320 --> 00:10:06,060
،إذن، نُسقيهم حتّى الثّمالة
ثُمّ نُجهز عليهم بعد ذلك؟

150
00:10:06,320 --> 00:10:09,130
لكن، ماذا لو لم يُسرفوا
في الشّرب؟

151
00:10:09,820 --> 00:10:11,630
.سنَدسّ لهم مسحوقًا مُنوّمًا

152
00:10:12,330 --> 00:10:13,750
.لن تكون هُناك مشكلةٌ

153
00:10:14,570 --> 00:10:17,120
.سنَستدعي ثلاث مِحفّات لنَقلهم إلى الدّار

154
00:10:17,120 --> 00:10:19,010
.تمّ الإعداد لكُلّ التّفاصيل السّابقة

155
00:10:19,380 --> 00:10:23,010
لكن عائلة ياجي لديهم أطفالٌ صِغار
.وأقارب في الدّار

156
00:10:23,640 --> 00:10:28,950
كما أنّ سيريزاوا-سان ورِفاقه
.يَدعون الغيشا أو العشيقات أحيانًا

157
00:10:30,090 --> 00:10:33,530
هل تضمن عدم وجود شُهودٍ حقًا؟

158
00:10:34,000 --> 00:10:37,480
،أُومي مَالكة هيشيا
،وإيتوساتو مِن واتشيغايا

159
00:10:37,960 --> 00:10:39,820
وكِيتشي مِن كيكيويا؟

160
00:10:41,290 --> 00:10:42,950
.لن يُشكّلن عقبةً هُن أيضًا

161
00:10:42,950 --> 00:10:47,030
،فلن نسمح لهُنّ ببلُوغ دار عائلة ياجي
.سأَرشو حَملة المِحفّات

162
00:10:48,440 --> 00:10:51,930
وسنَضرب ضربتنا في مُنتصف
.حُقول الأرز بين شيمابارا وميبو

163
00:10:52,300 --> 00:10:54,440
...سنَأمر الحَملة بالانصراف أوّلًا

164
00:10:55,480 --> 00:10:57,740
بذريعة رَغبتنا في الاستمتاع
.بمنظر اليَراعات

165
00:10:58,370 --> 00:11:02,470
،ثُمّ نطعنهم في صمتٍ
.هُم ومِحفّاتهم معًا

166
00:11:02,890 --> 00:11:06,970
إن لم يُجهز ذلك عليهم، فإنّ
.جُروحًا بليغةً ستَجعلهم صيدًا سهلًا

167
00:11:07,690 --> 00:11:11,230
،حينئذٍ نُلقي باللّوم على مُتطرّفي تشوشو
.ونكون قد أتممنا مُهمّتنا لتلك اللّيلة

168
00:11:11,720 --> 00:11:14,270
إذن، لهذا السّبب قُلت
.إنّني لن أستطيع فِعلها

169
00:11:14,640 --> 00:11:19,000
هل تتردّد في قتل ثَملٍ داخل مِحفّته؟

170
00:11:19,700 --> 00:11:21,520
.عن نفسي، لن أتردّد

171
00:11:23,210 --> 00:11:25,490
.لحُسن الحظّ أنّ شينباتشي ليس هُنا

172
00:11:26,200 --> 00:11:30,000
كوندو-سان وناغاكورا-سان لن
.يَقبلا خُطّتنا هذه بصدرٍ رَحب

173
00:11:30,250 --> 00:11:33,500
علينا أن نُنجز هذه المُهمّة دُون أن
.يُصاب أحدٌ بأذىً باستثناء المُستهدَفين

174
00:11:33,830 --> 00:11:37,430
لا مَجال للمُخاطرة، لا ينبغي
.لأحدٍ أن يعلم أنّنا الفَاعلون

175
00:11:37,980 --> 00:11:40,470
.سوجي وأنا مَن سيَقتل سيريزاوا

176
00:11:40,960 --> 00:11:44,020
.حسنًا، سأَتولّى قَتل هيراياما

177
00:11:44,020 --> 00:11:47,510
،لكن لا تنسَ هيراما
.نحن بحاجةٍ إلى رجلٍ آخر

178
00:11:48,210 --> 00:11:49,460
.أنا مَن سيَقوم بذلك

179
00:11:50,160 --> 00:11:53,250
...يامانامي
هل تَعي ما أنت مقدمٌ عليه؟

180
00:11:54,240 --> 00:11:56,800
أنتم تبحثون عمّن يُواجه
.الأهوال دُون تردّدٍ

181
00:11:57,250 --> 00:11:59,480
فهَل ترى أحدًا أولى بهذه المُهمّة منّي؟

182
00:12:01,910 --> 00:12:02,990
.جيّدٌ

183
00:12:03,300 --> 00:12:04,950
ما مَصير نوغوتشي-كون؟

184
00:12:05,160 --> 00:12:07,950
لا داعي لإراقة دِماء ذلك
.الفتى الخَادم

185
00:12:07,950 --> 00:12:10,530
.سنَبعث به إلى أوساكا في مُهمّةٍ رسميّة

186
00:12:10,860 --> 00:12:12,400
جين-سان، هل ستَتكفّل به؟

187
00:12:13,970 --> 00:12:16,480
هيجيكاتا، هل تُمانع في الرّد
على سُؤالٍ واحد؟

188
00:12:16,970 --> 00:12:21,310
،أُدرك أنّ سيريزاوا قد تمادى كثيرًا
،ولا مَفرّ مِن تنفيذ أمر آيزو السّري

189
00:12:21,710 --> 00:12:25,010
ولكن هل يَقتصر خلاصنا منه
على هذا السّبب فحسب؟

190
00:12:25,820 --> 00:12:29,560
أَليس لديك مَأربٌ شخصيّ
ترغب في نيله؟

191
00:12:40,990 --> 00:12:43,240
لست مُضطرًا لمُصاحبتنا إن
.تَغلغل الشّك في نفسك

192
00:12:43,500 --> 00:12:45,800
.كُلّ ما نرجوه منك أن تلزم الصّمت

193
00:12:45,800 --> 00:12:47,640
.لم أَقل قطّ إنّني سأَنسحب مِن هذا

194
00:12:48,170 --> 00:12:49,650
.غاب عن أذهانكم شخصٌ

195
00:12:51,340 --> 00:12:52,280
.تارو

196
00:12:52,720 --> 00:12:56,000
سيَظلّ إلى جانب سيريزاوا
.حتّى الرّمق الأخير

197
00:12:57,290 --> 00:12:59,720
.هاجيمي، هذه مسؤوليّتك

198
00:12:59,720 --> 00:13:01,840
هل تُريد منّي قَتله؟

199
00:13:01,840 --> 00:13:04,890
،لا تهزأ في موقفٍ كهذا
!إذن، تكفّل أنت بـ تارو

200
00:13:04,890 --> 00:13:06,660
.وأنا سأُجهز على سيريزاوا

201
00:13:07,380 --> 00:13:08,200
.ليس هذا ما أَرمي إليه

202
00:13:10,000 --> 00:13:10,840
ما مَقصدك إذن؟

203
00:13:13,410 --> 00:13:15,000
.أُريد منك أن تُنقذ تارو

204
00:13:54,870 --> 00:13:56,520
إنّها تُمطر بغزارةٍ، أَليس كذلك؟

205
00:13:57,060 --> 00:13:59,560
.يتملّكني شعورٌ بالانقباض مُنذ الصّباح

206
00:13:59,800 --> 00:14:01,680
!هذا فألٌ حَسن

207
00:14:01,680 --> 00:14:03,160
!مطر البَركات

208
00:14:04,110 --> 00:14:05,870
.ماسا-سان، ياشيرو-سان

209
00:14:05,870 --> 00:14:07,290
!يا للرّوعة

210
00:14:07,290 --> 00:14:10,000
!اليوم، سنَحتفل

211
00:14:08,720 --> 00:14:10,990
!أجل

212
00:14:10,380 --> 00:14:13,490
،ستَمضيان إلى شيمابارا للّهو
أَليس كذلك؟

213
00:14:13,640 --> 00:14:15,880
.أجل، حيث الفتيات الحِسان

214
00:14:15,880 --> 00:14:17,370
...رُبّما نقوم بأشياء
...تعرف ما أَقصد

215
00:14:17,370 --> 00:14:19,430
كُفّ عن ذلك، لا يزال صغيرًا
.على سماع مثل هذا الكلام

216
00:14:19,430 --> 00:14:22,040
.لا مكان للصّغار في حيّ اللّهو

217
00:14:25,330 --> 00:14:26,680
.يا لهما مِن أحمقين

218
00:14:26,680 --> 00:14:28,320
.يغمرني السّرور لأنّهما يمرحان

219
00:14:28,320 --> 00:14:32,130
على أيّ حالٍ، أُجزم أنّ القائد نيمي
.كان يتوق للاحتفال أيضًا

220
00:14:32,540 --> 00:14:34,920
.فهُو مَن هيّأ لكُلّ هذا

221
00:14:35,840 --> 00:14:37,480
ماذا؟ نيمي-سان مَن فَعل ذلك؟

222
00:14:38,070 --> 00:14:40,760
لا جَدوى مِن الحديث الآن
.بما أنّه قد فارق الحياة

223
00:14:41,500 --> 00:14:42,420
.ثمّة شيءٌ مُريب

224
00:14:43,150 --> 00:14:47,450
،نيمي-سان قد أَنهى حياته بنفسه
.وكان بمَقدوره اختيار لحظة رَحيله

225
00:14:48,040 --> 00:14:50,160
فلماذا شَاء أن يكون الاحتفال بعد موته؟

226
00:14:51,640 --> 00:14:52,720
وما الغاية مِن ذلك؟

227
00:14:54,010 --> 00:14:56,510
،الجميع ذاهبون إلى الاحتفال
أَليس كذلك؟

228
00:14:56,510 --> 00:14:57,140
.أجل

229
00:14:57,480 --> 00:15:01,090
باستثناء إينوي-سان، الّذي مضى
.بـ نوغوتشي ونفرٍ مِن الرّجال إلى أوساكا

230
00:15:01,090 --> 00:15:03,320
،لا أملك أدنى فِكرةٍ عن السّبب
.لكن هيجيكاتا مَن كلّفه بذلك

231
00:15:04,780 --> 00:15:07,040
.تصرّفوا بشأن سيريزاوا

232
00:15:07,320 --> 00:15:09,040
.أَنتم تفهمون ما نَعنيه

233
00:15:09,440 --> 00:15:11,040
.قتل سيريزاوا

234
00:15:11,280 --> 00:15:13,000
.هذا ما يرمون إليه

235
00:15:14,120 --> 00:15:16,560
أَتُراها مكيدةً مُدبّرةً؟

236
00:15:17,350 --> 00:15:20,640
فخٌّ نُصب لتَمكين مجموعة هيجيكاتا
مِن القضاء على سيريزاوا؟

237
00:15:21,720 --> 00:15:22,730
وبتخطيطٍ مِن نيمي-سان؟

238
00:15:23,930 --> 00:15:26,440
هل مَن المَعقول أنّ سيريزاوا-سان
لا يعلم عمّا يُحاك له؟

239
00:15:33,540 --> 00:15:34,580
.ناغاكورا-سان

240
00:15:35,260 --> 00:15:37,710
معذرةً، ولكن أين هيجيكاتا-سان؟

241
00:15:38,160 --> 00:15:39,040
.لا أملك أدنى فِكرةٍ

242
00:15:45,500 --> 00:15:48,370
ولكن، انظر إلى هذا المطر الّذي
لا يَتوقّف، ماذا سنَفعل؟

243
00:15:49,210 --> 00:15:49,760
.مهلًا

244
00:15:50,490 --> 00:15:52,270
،يا للهول
.لا بُدّ لي مِن سدّ رَمقي بالزّاد

245
00:15:52,270 --> 00:15:53,690
.أشعر برغبةٍ في الاستلقاء قليلًا

246
00:15:54,870 --> 00:15:56,480
...لِمَ انفضّ جمعهم فجأةً

247
00:15:56,480 --> 00:15:57,470
ما خطبك؟

248
00:15:57,930 --> 00:15:59,660
.العرق يتصبّب مِن جبينك

249
00:16:00,240 --> 00:16:01,180
.إنّه اليوم

250
00:16:02,360 --> 00:16:05,430
،إن كان لأيّ حَدثٍ أن يقع
.فسَيكون اليوم

251
00:16:07,840 --> 00:16:08,690
!مهلًا

252
00:16:11,020 --> 00:16:15,110
هيهات للماء المَسكوب أن يُجمع
.في إنائه، ليس بمَقدوري استعادته

253
00:16:16,380 --> 00:16:17,800
.ولا حتّى جزءٌ ضئيل منه

254
00:16:18,800 --> 00:16:21,050
.بَيد أنّني سأَبذل كُلّ ما في وسعي

255
00:16:23,080 --> 00:16:25,370
.إنّما قيمة السّاموراي تكمن في مِيتته

256
00:16:25,820 --> 00:16:28,090
.تَبيّنت موقف سيريزاوا-سان

257
00:16:28,800 --> 00:16:30,630
...إن كان في مَقدوري ذلك

258
00:16:30,880 --> 00:16:32,190
.بَلغتني أُمنيته أيضًا

259
00:16:33,580 --> 00:16:35,080
ما الّذي لا أقبل المُساومة عليه؟

260
00:16:36,040 --> 00:16:37,850
وأيّ سبيلٍ عليّ أن أسلك؟

261
00:16:39,130 --> 00:16:42,230
.استجمع قُوّتك، وكُن صلبًا

262
00:16:42,810 --> 00:16:45,730
إنّ السّعي نحو ذلك الهَدف
...والعمل لأجله

263
00:16:47,390 --> 00:16:48,960
.هُو جوهر كياني

264
00:16:53,590 --> 00:16:54,990
إنّها تُمطر بغزارةٍ، أَليس كذلك؟

265
00:16:57,170 --> 00:16:58,870
أتسائل إن كان المطر سيَتوقّف
.عند حُلول اللّيل

266
00:16:59,270 --> 00:17:00,470
.لا عِلم لي

267
00:17:03,620 --> 00:17:06,040
ابذل قُصارى جُهدك
.مِن أجل تارو-كون

268
00:17:14,090 --> 00:17:15,840
ما عَساهم يظنّونني؟

269
00:17:16,530 --> 00:17:18,070
.حسنًا

270
00:17:27,840 --> 00:17:28,480
مَن القادم؟

271
00:17:28,720 --> 00:17:29,540
.هذا أنا

272
00:17:30,880 --> 00:17:34,240
حقًا؟ مع أنّ موعد مجيئك
.كان يقتصر على اللّيل

273
00:17:34,610 --> 00:17:36,540
.لدينا شحٌّ في المظلّات

274
00:17:36,540 --> 00:17:39,420
،أعطني كُلّ ما لديكِ
.وسأَترك الثّمن هُنا

275
00:17:39,740 --> 00:17:41,470
.خُذ هذه

276
00:17:42,760 --> 00:17:45,580
.رُبّما لا يتسنّى لي الحُضور هذه اللّيلة

277
00:17:46,880 --> 00:17:49,090
هل ثمّة أمرٌ جَلل سيَقع؟

278
00:17:49,500 --> 00:17:50,960
.لا شيء على الإطلاق

279
00:17:51,360 --> 00:17:53,760
،جُلّ ما هُنالك أنّ حُضوري مُستعصٍ
.هذا السّبب فحسب

280
00:17:54,740 --> 00:17:55,800
وماذا بعد؟

281
00:17:56,540 --> 00:17:59,050
لا أُريدكِ أن تُحاولي الموت
.هذه اللّيلة

282
00:18:00,950 --> 00:18:04,200
،إذن قُصّ عليّ حِكايةً
.أيّ حِكايةٍ كانت

283
00:18:04,700 --> 00:18:06,500
.لن أموت ما دُمت تفعل

284
00:18:09,050 --> 00:18:10,060
...دَعيني أُفكّر

285
00:18:10,780 --> 00:18:12,570
.ثمّة رجلٌ يُدعى سيريزاوا

286
00:18:13,930 --> 00:18:18,000
.أَحسب أنّه ساموراي حقيقيّ

287
00:18:23,160 --> 00:18:24,280
.تارو

288
00:18:24,510 --> 00:18:26,160
.تعال ودلّك لي جسدي

289
00:18:26,160 --> 00:18:27,620
.أ-أجل يا سيّدي

290
00:18:28,660 --> 00:18:30,390
ما باله؟

291
00:18:30,760 --> 00:18:34,840
دَأب على توبيخي وقذف الأشياء في وجهي
.بمُجرّد رُؤيتي طِيلة الشّهرين الماضيين

292
00:18:35,500 --> 00:18:38,010
—لكنّه هادئٌ جدًا الآن، كأنّه

293
00:18:38,010 --> 00:18:41,180
هل تُسمّي هذا تدليكًا؟
!بقُوّةٍ أكبر

294
00:18:41,180 --> 00:18:42,880
!اسحقني بكُلّ ما أُوتيت مِن عزمٍ

295
00:18:53,360 --> 00:18:57,530
يا لجُرأتك! تدهس على
!وجه سيريزاوا كامو؟

296
00:18:58,320 --> 00:18:59,730
!هلكت لا مَحالة

297
00:19:00,350 --> 00:19:02,040
.اجلب سيفك

298
00:19:03,130 --> 00:19:05,030
ماذا؟ سيّدي؟

299
00:19:07,340 --> 00:19:12,320
انزع الوتد والمِقبض
.وتولّ صقله كما أَريتك

300
00:19:13,590 --> 00:19:15,500
هل تَذكر ما عليك فِعله؟

301
00:19:15,980 --> 00:19:16,720
.خُذ

302
00:19:17,180 --> 00:19:17,920
.أجل يا سيّدي

303
00:19:26,520 --> 00:19:29,480
.هذا النّصل لن يَليق بك أبدًا

304
00:19:29,490 --> 00:19:30,720
.مـ-معذرةً

305
00:19:31,150 --> 00:19:33,910
.جفّ رِيقي، أحضر لي الشّاي

306
00:19:33,910 --> 00:19:34,720
.حاضرٌ يا سيّدي

307
00:19:36,590 --> 00:19:37,600
.هذا مريبٌ

308
00:19:38,070 --> 00:19:40,350
.إنّه يتصرّف بغرابةٍ شديدة هذا اليوم

309
00:19:42,640 --> 00:19:43,490
.تفضّل يا سيّدي

310
00:19:43,890 --> 00:19:46,360
!يا للهول
.لا أُصدّق أنّني سَكبته

311
00:19:46,360 --> 00:19:48,280
...أيّها الأحمق الصّغير

312
00:19:48,280 --> 00:19:49,410
!أنا في غاية الأسف

313
00:19:49,410 --> 00:19:51,410
.سأَمسحه حالًا وآتي بقدحٍ آخر

314
00:20:14,840 --> 00:20:17,320
!إنّه مستشيطٌ غضبًا

315
00:20:18,710 --> 00:20:21,150
...أَليس اليوم هُو

316
00:20:21,150 --> 00:20:22,200
!سيريزاوا-سينسي

317
00:20:23,160 --> 00:20:24,620
.وصلت مِحفّاتنا

318
00:20:24,620 --> 00:20:25,280
.حسنًا

319
00:20:25,290 --> 00:20:28,050
.تارو، هات مِعطفي

320
00:20:28,050 --> 00:20:28,720
.حاضرٌ يا سيّدي

321
00:20:33,900 --> 00:20:35,240
.أظنّ أنّني سأَمضي الآن

322
00:20:38,920 --> 00:20:40,720
.سـ-سأَتنحّى عن طريقك

323
00:20:45,960 --> 00:20:48,250
!احتفالٌ في سوميا بـ شيمابارا

324
00:20:48,250 --> 00:20:50,640
.كأنّنا مِن الأثرياء النّبلاء

325
00:20:51,680 --> 00:20:55,830
!أيّها الثّري المُغدق
!يا ذا المال الوَفير

326
00:21:19,260 --> 00:21:22,140
.بلغنا البوّابة الرّئيسة لـ شيمابارا يا سيّدي

327
00:23:21,260 --> 00:23:22,860
.تودو هيسوكي يُحدّثكم

328
00:23:23,520 --> 00:23:25,000
.المطر يَنهمر بغزارةٍ

329
00:23:25,510 --> 00:23:28,920
وهذا الطّقس العاصف ما هُو إلّا
.انعكاسٌ للعواصف الّتي تعتصر قُلوبنا

330
00:23:29,740 --> 00:23:32,400
أنا في خِضمّ احتفالٍ، لكنّني
.لا يَسعني أن أدعَ السّكر يتملّكني

331
00:23:33,380 --> 00:23:37,320
جميعنا نسعى للتحرّر مِن قُيود الشّك، والمُضيّ
.دُون التفاتٍ في الدّروب الّتي سلكناها

332
00:23:38,140 --> 00:23:41,900
.لكنّني لا أكاد أُميّز أيّ الدّروب هُو الحقّ

333
00:23:42,340 --> 00:23:45,250
لذا، سأَمضي في فِعل
.ما أَقدر عليه فحسب

334
00:23:46,260 --> 00:23:48,320
."الحلقة القادمة: "دربُ الأَشورا