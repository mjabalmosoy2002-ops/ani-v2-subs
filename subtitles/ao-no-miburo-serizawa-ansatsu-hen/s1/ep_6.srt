1
00:00:00,580 --> 00:00:02,970
هل مِن أشرارٍ هُنا؟

2
00:00:03,330 --> 00:00:05,980
هل مِن أحدٍ يَبتغي العون؟

3
00:00:06,200 --> 00:00:08,730
—إنّ أقوى قُوّةٍ ضاربة، المِيبورو

4
00:00:09,580 --> 00:00:13,070
،صوتك صاخبٌ جدًا، الجميع نِيامٌ
.لذا اكتفِ بالسّير في صمتٍ

5
00:00:15,330 --> 00:00:17,710
ما زِلت تنضح بالحَماس
.يا ماسا-سان

6
00:00:18,060 --> 00:00:19,290
—يُمكنكم الاعتماد دومًا على

7
00:00:19,290 --> 00:00:20,090
.اصمت

8
00:00:20,660 --> 00:00:22,320
.تبًا

9
00:00:30,620 --> 00:00:32,720
،نحن جماعة المِيبورو
.ابقوا هادئين

10
00:00:38,170 --> 00:00:39,030
ما الخطب؟

11
00:00:40,270 --> 00:00:41,820
ماذا؟

12
00:00:41,820 --> 00:00:43,960
.نحن... نحن ميبو روشيغومي

13
00:00:43,960 --> 00:00:46,320
هل... هل تحتاجين عونًا؟

14
00:00:48,160 --> 00:00:49,190
.كلا، لا أحتاج إلى شيءٍ

15
00:00:49,400 --> 00:00:51,910
.معذرةً إذن

16
00:00:52,340 --> 00:00:54,550
.توهّمنا وجود خطرٍ

17
00:00:54,550 --> 00:00:56,950
،لا بأس
.هذه الأخطاء واردةُ الحُدوث

18
00:00:57,500 --> 00:00:59,280
.تقدّما أنتما الاثنان

19
00:02:43,490 --> 00:02:44,320
.مهلًا

20
00:02:47,470 --> 00:02:52,150
لماذا عُدت؟ هل لفت انتباهك ما يَبعث
.على الرّيبة؟ حاولت أن أتصرّف بطبيعيّةٍ

21
00:02:52,840 --> 00:02:53,890
.بل العكس تمامًا

22
00:02:54,710 --> 00:02:55,640
ماذا تقصد؟

23
00:02:56,110 --> 00:03:02,290
مِن المُتوقّع أن ترتعد فتاةٌ في مِثل سنّكِ عند رُؤية
.رجالٍ أشدّاء يقتحمون المكان في هذا الوقت

24
00:03:03,720 --> 00:03:05,180
.لذا أيقنت أنّ هُناك خطبًا

25
00:03:05,180 --> 00:03:06,420
!ابتعد

26
00:03:06,420 --> 00:03:09,120
!سأَفعلها إن اقتربت أكثر

27
00:03:09,700 --> 00:03:10,840
!أنا جادّةٌ فيما أقول

28
00:03:16,500 --> 00:03:19,880
،أحسنت يا سوجي
.الآن، أمسك بها مِن الخلف

29
00:03:23,720 --> 00:03:25,070
.لا تكوني حمقاء

30
00:03:26,320 --> 00:03:28,600
ما زالت صِغيرةً، رُبّما في الثّانية
.عشرة أو الثّالثة عشرة مِن عُمرها

31
00:03:28,970 --> 00:03:32,480
،إنّها تقريبًا في سنّ نيو وهاجيمي
.لا تزال مُجرّد طفلةٍ

32
00:03:32,750 --> 00:03:36,280
لا جدوى مِن الحياة
.إن لم يهتمّ بي أحدٌ

33
00:03:36,280 --> 00:03:36,980
!بل هُناك جدوى

34
00:03:36,980 --> 00:03:40,310
ما الّذي يجعلك واثقًا هكذا؟
.أنت لا تعرف شيئًا عن مُعاناتي

35
00:03:41,650 --> 00:03:45,030
.كانوا جميعًا يُردّدون أنّني لا نفع منّي

36
00:03:45,770 --> 00:03:48,870
،ما زلتِ تتدرّبين
.لكنّكِ لا تتقدّمين أبدًا

37
00:03:49,130 --> 00:03:51,280
.لا نفع منكِ حقًا

38
00:03:51,790 --> 00:03:53,450
،كُنت أُشاطرهم الرّأي

39
00:03:54,200 --> 00:03:56,790
وكُنت أتساءل لماذا لا أستطيع
.فِعل الأشياء كما يَفعل الآخرون

40
00:03:57,190 --> 00:03:59,260
افلتني! إلى أين تأخذني؟

41
00:03:59,260 --> 00:04:01,800
لن أتمكّن مِن العيش
!في أيّ مكانٍ آخر

42
00:04:03,240 --> 00:04:05,880
إن كُنتِ لا تطيقين
.حياة البغايا، فاعتزليها

43
00:04:06,480 --> 00:04:10,690
لكنّه كان الوحيد الّذي
.عاملني بلُطفٍ

44
00:04:10,690 --> 00:04:14,810
كان الوحيد الّذي وقف
.بجانبي حين نَبذني العالم

45
00:04:19,520 --> 00:04:24,270
،مِن المُفترض أن تَري الآن بشكلٍ أفضل
.كُلّ ما في الأمر أنّ بصركِ كان ضعيفًا

46
00:04:24,720 --> 00:04:26,950
.ليس بكِ أيّ عيبٍ

47
00:04:28,480 --> 00:04:31,370
،المكان ضيّقٌ بعض الشّيء
.لكن استخدميه كما يروق لكِ

48
00:04:31,950 --> 00:04:36,520
يُمكنكِ صُنع المِظلّات أو السّواتر
.أو ما تشائين

49
00:04:37,460 --> 00:04:39,720
بات بمقدوركِ أن تضحكي
.مثل بقيّة النّاس

50
00:04:43,720 --> 00:04:46,850
.لم أسمع عنه خبرًا مُنذ مُدّةٍ

51
00:04:47,110 --> 00:04:50,420
يقولون إنّ نبيلًا يُدعى
.أنيجاكوجي قد قُتل

52
00:04:50,420 --> 00:04:52,840
،يا إلهي
.يا له مِن أمرٍ مُفزع

53
00:04:57,890 --> 00:04:59,960
،آكل الزّاد فلا أجد له طعمًا

54
00:04:59,960 --> 00:05:01,920
.وأنظر إلى الزّهور فلا أرى لها لونًا

55
00:05:02,400 --> 00:05:04,860
!لا جدوى مِن الحياة

56
00:05:05,100 --> 00:05:08,180
!أُريد الموت

57
00:05:06,690 --> 00:05:10,240
،ليس بالضّرورة أن يكون للحياة جدوى
.فلستِ بحاجةٍ إلى سببٍ لتَعيشي

58
00:05:10,820 --> 00:05:14,290
،تمسّكي بالحياة اليوم فحسب
!لهذا اليوم وحده

59
00:05:14,640 --> 00:05:16,590
،مهما بلغت قسوة الظّروف الآن

60
00:05:16,590 --> 00:05:20,300
إن تجاوزتِ يومكِ هذا، فرُبّما
.لن ترغبي في الموت غدًا

61
00:05:20,450 --> 00:05:23,080
،مستحيلٌ
.سأَموت غدًا لا محالة

62
00:05:23,080 --> 00:05:24,540
،إذن سيَأتي الغد

63
00:05:24,890 --> 00:05:27,170
،واليوم الّذي يَليه
.والّذي بعده أيضًا

64
00:05:27,590 --> 00:05:30,800
سآتي كُلّ يومٍ لأَتأكّد أنّكِ
!ما زلتِ على قيد الحياة

65
00:05:40,410 --> 00:05:41,560
.شُكرًا لكِ

66
00:05:41,560 --> 00:05:43,510
.لن تفهم أبدًا

67
00:05:44,270 --> 00:05:49,700
مَن الّذي اقتحم أراضي الآخرين
وضيّق عليهم سُبل العيش؟

68
00:05:50,400 --> 00:05:52,840
.لا علاقة لنا بكُلّ هذا

69
00:05:52,840 --> 00:05:56,450
،لا بطرد البَرابرة، ولا بافتتاح المَوانئ
.ولا بالشّوغون، ولا بـ تشوشو

70
00:05:57,540 --> 00:05:59,270
.نحن الطّرف الّذي يُسلب دومًا

71
00:05:59,580 --> 00:06:01,190
.لن تفهم أبدًا

72
00:06:01,830 --> 00:06:03,370
.فكُلّ ما يحدث هُو خَطؤكم

73
00:06:05,210 --> 00:06:09,720
كُلّ ما أردته أن أعيش
.بهُدوءٍ وسلام

74
00:06:11,050 --> 00:06:11,890
.سآتي مُجدّدًا

75
00:06:17,540 --> 00:06:19,640
يبدو أنّه بات لديك مكانٌ آخر
.لتَجوبه في جولتك التفقديّة

76
00:06:19,920 --> 00:06:23,360
،تبًا لك يا سوجي
.ساعدني إن كُنت قريبًا

77
00:06:23,600 --> 00:06:27,930
كلا، لا تحتاجني، ظننت أنّك
.ستُبلي بلاءً حسنًا بمُفردك

78
00:06:29,540 --> 00:06:32,790
كان ذلك الخطاب الّذي
.ألقيته مُؤثّرًا للغاية

79
00:06:32,960 --> 00:06:33,910
.كُفّ عن المزاح معي

80
00:06:34,720 --> 00:06:36,490
.أنا جادٌ فيما أقول

81
00:06:37,440 --> 00:06:41,000
.الأقوياء يضحكون، والضّعفاء يبكون

82
00:06:41,380 --> 00:06:43,460
.أتساءل بالفعل ما الّذي اختلّ وكيف

83
00:06:43,900 --> 00:06:47,730
.ذكّرني ذلك بما ينبغي لنا حمايته

84
00:06:48,920 --> 00:06:52,720
ينقسم رجال المِيبورو بين
.مُؤيّدي كوندو ومُؤيّدي سيريزاوا

85
00:06:53,760 --> 00:06:56,840
،لكنّني، كما تعلم
.أنحاز لك يا هيجيكاتا

86
00:06:58,530 --> 00:06:59,800
.أعلم ذلك

87
00:07:04,540 --> 00:07:05,560
.حريقٌ

88
00:07:05,790 --> 00:07:08,260
،أجل
هل تظنّ أنّه مُجرّد إهمالٍ؟

89
00:07:18,110 --> 00:07:21,040
.لم يكن هذا حادثًا عرضيًا

90
00:07:21,860 --> 00:07:22,970
.بل هُو حريقٌ مُتعمّد

91
00:07:23,920 --> 00:07:26,310
...والمَسؤولون عنه هُم

92
00:07:26,990 --> 00:07:27,720
!كلا

93
00:07:28,000 --> 00:07:31,720
يجب أن يُحرق ياماتويا
!جزاءً على جرائم مالكه

94
00:07:32,520 --> 00:07:36,260
،هذا بأمرٍ مِن سيريزاوا-سينسي
!قائد ميبو روشيغومي

95
00:07:36,260 --> 00:07:40,090
مَن يجرؤ على إلقاء ولو دلو ماءٍ
!واحد، فسَنطيح برأسه فورًا

96
00:07:50,650 --> 00:07:52,230
.يا للفظاعة

97
00:07:52,230 --> 00:07:53,280
ما الّذي يحدث؟

98
00:07:53,280 --> 00:07:55,120
.القصر قريبٌ جدًا

99
00:07:55,120 --> 00:07:57,670
ماذا لو امتدت النّيران إلى
مقرّ سكن جلالة الإمبراطور؟

100
00:07:59,860 --> 00:08:00,870
.إنّهم شياطين

101
00:08:01,160 --> 00:08:02,900
!رجال المِيبورو شياطين

102
00:08:04,870 --> 00:08:07,480
...سيريزاوا-سان
لماذا فعلت ذلك؟

103
00:08:12,680 --> 00:08:15,890
.وقعنا في ورطةٍ لا مخرج منها

104
00:08:16,090 --> 00:08:17,120
.طفح الكَيل

105
00:08:19,540 --> 00:08:23,930
كُلّ ما أردته أن أعيش
.بهُدوءٍ وسلام

106
00:08:26,490 --> 00:08:28,000
.سأَضع حدًا لهذا

107
00:08:30,720 --> 00:08:32,690
،لم ينجُ مِن الحريق سوى المخزن

108
00:08:33,420 --> 00:08:35,580
.أثاروا فوضى لا تُوصف

109
00:08:35,970 --> 00:08:39,450
كان مِن المُمكن أن يلتهم الحريق
.الحيّ كُلّه لو امتدت النّيران

110
00:08:40,020 --> 00:08:42,330
لحُسن حظّنا أنّ الرّياح
.كانت هادئةً

111
00:08:42,780 --> 00:08:44,250
.لا وقت لدينا لنُضيّعه

112
00:08:44,520 --> 00:08:47,080
.سنبدأ بالاعتذار لكُلّ مَن نعرفه

113
00:08:47,820 --> 00:08:49,000
.نيو، تعال معي

114
00:08:51,960 --> 00:08:56,010
أحيانًا، لا أفهم بماذا
.يُفكّر سيريزاوا-سان

115
00:08:56,820 --> 00:08:59,350
ما الحلّ إذا استمرّ
الوضع هكذا؟

116
00:09:00,360 --> 00:09:03,620
أُريد فِعل شيءٍ لتوجيه
.الأمور نحو مسارٍ إيجابيّ

117
00:09:04,730 --> 00:09:07,440
لكنّني لم أتمكّن حتّى مِن
.التحدّث معه وجهًا لوجهٍ

118
00:09:11,380 --> 00:09:12,280
.لنَنطلق

119
00:09:13,120 --> 00:09:17,680
نحن مُفتّشون، وكُلّ ما بيدنا
.فِعله التحرّي واتّخاذ التّدابير

120
00:09:18,760 --> 00:09:20,910
معذرةً، بدا كلامي مُتكلفًا
.بعض الشّيء

121
00:09:21,280 --> 00:09:22,200
.هاياشي-سان

122
00:09:23,560 --> 00:09:24,110
.صحيحٌ

123
00:09:25,900 --> 00:09:27,870
،بعد مزيدٍ مِن التحرّي

124
00:09:28,090 --> 00:09:31,370
...تبين لنا أن ياماتويا مَوّل بمبالغ ضخمةٍ

125
00:09:31,800 --> 00:09:34,840
جماعةً مُناهضة للشّوغون
."تُدعى "المُنتقمون الإلهيون

126
00:09:34,840 --> 00:09:36,160
هل كانوا يَدعمون الثُوّار؟

127
00:09:36,450 --> 00:09:37,000
،أجل

128
00:09:37,530 --> 00:09:41,010
كما أنّهم رفضوا تقديم
.قُروضٍ لـ ميبو روشيغومي

129
00:09:41,010 --> 00:09:43,520
إذًا، أشعل الحريق بغرض الانتقام؟

130
00:09:43,730 --> 00:09:45,010
.ثمّة شيءٌ آخر

131
00:09:45,690 --> 00:09:50,570
استغلّ ياماتويا مكانته كتاجر
...جُملةٍ للحرير الخام

132
00:09:53,200 --> 00:09:55,520
ممّا تسبّب بمشقّةٍ شديدة
.لعامّة النّاس

133
00:09:56,010 --> 00:09:56,920
.هكذا إذًا

134
00:09:57,540 --> 00:09:58,990
،مهما كان الدّافع

135
00:09:58,990 --> 00:10:04,280
يجب أن يُعاقب سيريزاوا مِن
.أجل صون سُمعة المِيبورو

136
00:10:10,260 --> 00:10:12,540
.إنّه أنت فوجيتا-سان

137
00:10:13,510 --> 00:10:14,510
.أوكيتا-سان

138
00:10:15,060 --> 00:10:17,440
ما الّذي يبتغيه تابع آيزو منّي؟

139
00:10:19,500 --> 00:10:24,440
ذَكر لي كوندو-سان أنّك أمهر
.سيّافٍ في ميبو روشيغومي

140
00:10:24,640 --> 00:10:27,520
،حسنًا، لا أعلم إن كنت الأمهر
.لكنّني بالتّأكيد مِن الصّفوة

141
00:10:27,800 --> 00:10:29,750
،بما أنّك تُؤيّد كوندو

142
00:10:31,800 --> 00:10:36,650
،أرجو منك أن تأتي سِرًا إلى مقرّ إقامة الدّايميو
.ولا تصحب معك إلّا مَن تثق بهم

143
00:10:37,320 --> 00:10:37,920
.أَستأذنك بالانصراف

144
00:10:40,100 --> 00:10:42,350
مَن أثق بهم؟

145
00:10:52,890 --> 00:10:54,970
.تصرّفوا بشأن سيريزاوا

146
00:10:55,570 --> 00:10:58,880
إنّ آيزو تنظر إلى هذه المَسألة بجديّةٍ
.بالغة، فلا تضطرّونا إلى قولها صراحةً

147
00:10:59,810 --> 00:11:01,280
.فأَنتم تفهمون ما نَعنيه

148
00:11:07,290 --> 00:11:08,890
.قتل سيريزاوا

149
00:11:10,150 --> 00:11:11,730
.هذا ما يرمون إليه

150
00:11:11,730 --> 00:11:14,510
.إيّاك والمزاح في مسائل كهذه

151
00:11:15,320 --> 00:11:16,630
.لكنّك سمعته بنفسك

152
00:11:16,630 --> 00:11:21,150
إنّهم يُريدون منّا تولّي هذه المُهمّة
.القذرة كي لا تلطّخ أيديهم

153
00:11:21,350 --> 00:11:24,940
إذًا هل ستَطلب مِن سيريزاوا
الانسحاب مِن المِيبورو مثلًا؟

154
00:11:25,360 --> 00:11:27,420
أنت تعلم جيدًا أنّه
.لن ينصاع لذلك أبدًا

155
00:11:27,560 --> 00:11:30,250
،لا يُمكننا طرده أيضًا

156
00:11:30,680 --> 00:11:32,660
فهذا سيَعني تركه ليَعيث فسادًا
.كما يشاء دُون رقيبٍ

157
00:11:33,000 --> 00:11:35,540
.لن تتردّد آيزو في التخلّي عنّا

158
00:11:40,780 --> 00:11:45,520
بـ-بصفتي مُفتّشًا، أقترح أن نطلب مِن سيريزاوا-سان
.أن يعزل نفسه طوعًا ويلزم مَخدعه

159
00:11:46,320 --> 00:11:47,490
لا يزال بإمكانه التّراجع
.عن أفعاله

160
00:11:48,010 --> 00:11:50,540
لا بُدّ مِن وجود طريقةٍ
.لجعله يندم ويُقوّم سُلوكه

161
00:11:53,160 --> 00:11:56,150
محالٌ أن ينصاع سيريزاوا
!لهذا الهُراء

162
00:11:56,150 --> 00:11:59,390
كما أنّ قضاء بعض الوقت في مَخدعٍ
!مُغلق لن يُغيّر مِن طباع أحدٍ أبدًا

163
00:12:00,170 --> 00:12:01,510
.هوّنوا عليكم

164
00:12:02,840 --> 00:12:05,400
.حسنًا، سأَلزم مَخدعي إذًا

165
00:12:09,060 --> 00:12:10,080
.غير معقولٍ

166
00:12:10,080 --> 00:12:11,420
.لا بُدّ أنّك تمزح معنا

167
00:12:11,420 --> 00:12:12,790
.كم هُو جديرٌ بالثّناء

168
00:12:16,400 --> 00:12:18,400
.الآن، صار بإمكانك التحدّث إليه

169
00:12:20,580 --> 00:12:21,300
.محقٌّ

170
00:12:23,200 --> 00:12:26,170
!صدمني هذا حقًا

171
00:12:27,500 --> 00:12:31,800
مَن كان يتوقّع أنّ سيريزاوا-سان
سيَوافق على عزل نفسه كعُقوبةٍ له؟

172
00:12:31,800 --> 00:12:33,320
.عقوبةٌ بالاسم فحسب

173
00:12:35,360 --> 00:12:41,260
أَتعلم، كان سيريزاوا-سان يفرض
.سيطرته علينا مُنذ تأسيس الرّوشيغومي

174
00:12:42,910 --> 00:12:49,700
أَلم تندلع أزمةٌ كبيرة في ذاك النّزل لمُجرّد
أنّ كوندو-سان نَسي حجز حُجرةٍ له؟

175
00:12:50,270 --> 00:12:51,940
.كفى نبشًا في الماضي

176
00:12:54,380 --> 00:12:56,460
هل لاحظت يا هيجيكاتا-سان؟

177
00:12:57,220 --> 00:13:00,680
لم يكن أحدٌ في ذلك الاجتماع الّذي
...ضمّ عشرة أشخاصٍ أشدّ غضبًا مِن

178
00:13:00,680 --> 00:13:01,710
نيو، أَليس كذلك؟

179
00:13:02,360 --> 00:13:03,010
.كلا

180
00:13:04,270 --> 00:13:05,370
.بل هاجيمي-كون

181
00:13:05,920 --> 00:13:10,720
لا أدري لماذا، لكن حريق
.ياماتويا استفزّه بشكلٍ خاصّ

182
00:13:11,210 --> 00:13:11,990
حقًا؟

183
00:13:12,830 --> 00:13:17,040
ولا فكرة لديّ عمّا يَجول
.في عقل كوندو-سان

184
00:13:17,440 --> 00:13:18,610
.لنَنتظر

185
00:13:18,610 --> 00:13:20,190
!ماذا تقصد بـ "لنَنتظر"؟

186
00:13:20,520 --> 00:13:22,610
أرجو منك الانتظار
.لمُدّة شهرٍ واحد

187
00:13:22,800 --> 00:13:24,290
شهرٌ بكامله؟

188
00:13:24,290 --> 00:13:27,240
ماذا لو آلت الأمور إلى
وضعٍ أسوأ بعدئذٍ؟

189
00:13:27,500 --> 00:13:29,030
!أَلست قائدنا؟

190
00:13:32,960 --> 00:13:35,290
ما الّذي كان يرمي إليه بقوله ذاك؟

191
00:13:35,290 --> 00:13:38,310
،لا أكاد أفهمه
.فأَحيانًا يكون لُغزًا مُحيّرًا

192
00:13:45,200 --> 00:13:47,150
عَقدت العزم، أَليس كذلك؟

193
00:13:48,040 --> 00:13:49,270
ماذا تعني؟

194
00:13:50,000 --> 00:13:51,390
.مَقصدك جليٌّ بالفعل

195
00:13:52,400 --> 00:13:54,260
.لا أحد سِواك يُمكنه التكهّن بذلك

196
00:13:54,820 --> 00:13:55,720
،ليس تمامًا

197
00:13:56,120 --> 00:14:00,070
لكن سيريزاوا-سان أعجوبةٌ
،بشريّة خارقة للعَادة

198
00:14:00,300 --> 00:14:02,380
.ومُهمّتنا معه لن تكون يسيرةً

199
00:14:06,750 --> 00:14:09,680
هل تعرف لماذا أنا مِن
مُؤيّديك يا هيجيكاتا؟

200
00:14:10,520 --> 00:14:11,380
.لا أملك أدنى فِكرةٍ

201
00:14:12,070 --> 00:14:16,000
.لأنّني أراك شخصًا استثنائيًا

202
00:14:16,000 --> 00:14:19,200
استثنائيٌ؟
أَلا تقصد غريب أطوارٍ؟

203
00:14:20,560 --> 00:14:23,120
هذا صحيحٌ، فأَنت لا تلتزم
.بالنّهج التّقليدي الصّارم

204
00:14:23,400 --> 00:14:28,210
وبهذا المَنطق، يُعدّ كوندو-سان
.وسيريزاوا-سان مُخلصان لمِيثاق السّاموراي

205
00:14:28,630 --> 00:14:30,750
وهما جديران بالاحترام
.لأجل ذلك دُون ريبٍ

206
00:14:31,280 --> 00:14:34,640
لكن تلك ليست سِوى تقاليد
.شكليّةّ أَوجدها الأسلاف

207
00:14:35,800 --> 00:14:41,350
أمّا أنت، فقد شققت لنفسك طريقًا
.بفلسفةٍ وقناعاتٍ خاصّة بك وحدك

208
00:14:41,720 --> 00:14:44,350
.بينما يفتقر جُلّ النّاس لكليهما

209
00:14:44,580 --> 00:14:48,510
إذ يَستسهلون تبنّي الأفكار
،المَوروثة دُون فِكرٍ

210
00:14:49,160 --> 00:14:52,000
.ولا يجرؤون على التّشكيك بها أصلًا

211
00:14:54,560 --> 00:14:56,220
...أَتعلم يا هيجيكاتا-سان

212
00:14:57,030 --> 00:14:59,460
إنّي أرغب في رُؤية
.البلاد الّتي ستَشيّدها

213
00:14:59,460 --> 00:15:01,110
.إنّ مدى طُموحك شاسعٌ

214
00:15:01,360 --> 00:15:03,630
يُمكنك القول إنّني أُفكر
.في مَصلحتي

215
00:15:04,360 --> 00:15:06,090
ولهذا السبّب أنا مِن
.مُؤيّديك يا هيجيكاتا

216
00:15:07,370 --> 00:15:10,390
تقصد أنّك تراني شخصًا
.يستحقّ الحماية

217
00:15:10,850 --> 00:15:13,550
بل أعني أنّ هذا أقصى
.ما يُقال في مَديحك

218
00:15:15,570 --> 00:15:17,790
سوجي، ماذا ستَفعل أنت؟

219
00:15:18,360 --> 00:15:19,270
أنا؟

220
00:15:20,410 --> 00:15:21,790
هل لديك شكٌّ في ذلك؟

221
00:15:21,790 --> 00:15:26,150
كُنت معك على ذات الدّرب
.مُنذ أن عقدتَ العزم

222
00:15:26,790 --> 00:15:28,600
.ولن أُجادل

223
00:15:29,950 --> 00:15:32,910
.رُغم أنّني سأَحتاج سيفًا جديدًا

224
00:15:33,440 --> 00:15:35,780
سيَتعيّن عليّ أن أقصد
.ساكورا-سان طالبًا ذلك

225
00:15:36,550 --> 00:15:39,220
،وبالطّبع
.لا مجال لإهمال التّدريب

226
00:15:39,740 --> 00:15:42,360
لعلّي أعتزل تحت شلّالٍ هادر
.صقلًا لرُوحي وترويضًا لجسدي

227
00:15:42,760 --> 00:15:44,120
هل تعرف مكانًا جيّدًا؟

228
00:15:45,190 --> 00:15:47,130
.جاءت لحظة الحَسم

229
00:15:47,830 --> 00:15:49,830
.كُن مُستعدًا للتحرّك في أيّ لحظةٍ

230
00:15:55,920 --> 00:15:57,160
.كما تشاء

231
00:16:05,370 --> 00:16:09,280
السّبب الوحيد لعدم امتداد الحريق الّذي أشعله
...ذاك الأحمق سيريزاوا

232
00:16:09,280 --> 00:16:11,120
.هُو أنّ الحظّ حالفنا

233
00:16:12,880 --> 00:16:15,550
،كُنت أعلم ذلك
.فمَوقع النّيران ملاصقٌ للقصر تمامًا

234
00:16:17,130 --> 00:16:19,460
...ولو كان اللّهيب قد تسرّب إلى هُنا

235
00:16:19,800 --> 00:16:20,970
.هاجيمي-تشان

236
00:16:21,840 --> 00:16:24,560
،طالما أنّهم بخير
.فهذا هُو المُهمّ

237
00:16:28,670 --> 00:16:30,280
،بعد حريق ياماتويا

238
00:16:31,060 --> 00:16:34,200
،اعتزل سيريزاوا النّاس
.ولا أحد يعلم السّبب

239
00:16:35,430 --> 00:16:38,630
،فقد لَزم مَخدعه
،ويُقدّم له الزّاد هُناك

240
00:16:39,060 --> 00:16:41,730
بل ويُصرّ على أن يُرافقه الحرس
.حتّى إلى بيت الخَلاء

241
00:16:42,530 --> 00:16:46,230
،المُفتّشون يتفقّدونه بين الحين والآخر
.ولا يخرج مَن عُزلته إلّا في تلك الأوقات فحسب

242
00:16:47,610 --> 00:16:48,740
...لكن ما يُؤرّقني

243
00:16:49,070 --> 00:16:53,360
هُو حينما انفرد به نيو، ولم يخرج
.مِن عنده إلّا بعد قُرابة ساعةٍ

244
00:16:58,800 --> 00:17:02,370
كانت عَيناه مُحمرّتين
.مِن البُكاء، وبدا مَذهولًا

245
00:17:03,480 --> 00:17:05,630
.أحيانًا تطرأ على نيو أفكارٌ جامحة

246
00:17:06,040 --> 00:17:07,420
...عندما رأيته هذا الصّباح

247
00:17:07,420 --> 00:17:09,090
،هاجيمي-كون
.أرغب في نِزالٍ تدريبيّ

248
00:17:09,790 --> 00:17:11,510
،بدا على سجيّته المُعتادة...
...ومع ذلك

249
00:17:12,980 --> 00:17:15,050
.فهُو مصدر إزعاجٍ كشقيقته تمامًا

250
00:17:15,050 --> 00:17:16,470
!أنت هُناك

251
00:17:16,470 --> 00:17:21,350
كيف تجرؤ على التذمّر بالنّقر بلسانك
!قُرب المقرّ المُهاب لجلالة الإمبراطور

252
00:17:21,720 --> 00:17:23,020
!مثيرٌ للشّبهات

253
00:17:23,020 --> 00:17:24,970
لأيّ إقطاعيّةٍ تَدين بالولاء؟
!أَفصح عن نفسك

254
00:17:25,540 --> 00:17:28,580
شِعارهم عبارةٌ عن رقم واحدٍ
.وثلاث نُجومٍ

255
00:17:29,350 --> 00:17:30,960
،مَزيدٌ مِن رجال تشوشو
أَليس كذلك؟

256
00:17:31,290 --> 00:17:33,730
حسنًا، لم يكن لديّ أدنى أملٍ
.في أن يَسمحوا لي بالدّخول

257
00:17:34,780 --> 00:17:35,800
!انتظر مكانك

258
00:17:39,870 --> 00:17:43,000
لم يتسنّ لي قطّ أن أُتمّ جولةً
.حول أسوار القصر

259
00:17:43,240 --> 00:17:45,130
،إنّه مصمّمٌ على هيئة صُندوقٍ

260
00:17:45,740 --> 00:17:48,890
وتتوسّطه قاعة الدّولة الّتي
.تبدو هي الأُخرى كصُندوقٍ

261
00:17:49,160 --> 00:17:54,380
،حسبما قال أنيجاكوجي
.هُناك يقطن الإمبراطور ويُؤدّي مَراسمه

262
00:17:55,100 --> 00:17:57,390
.تسعة بوّاباتٍ تُفضي إلى الدّاخل

263
00:17:57,750 --> 00:18:00,560
.ورجال تشوشو يَحرسون مُعظمها

264
00:18:03,400 --> 00:18:08,280
هذا يُبيّن مدى النّفوذ الّذي تتمتّع
.به تشوشو، حتّى في أَروقة القصر

265
00:18:09,550 --> 00:18:12,020
.إنّ الحُكومة لمثيرةٌ للسّخرية

266
00:18:12,600 --> 00:18:15,050
فالمَسألة برمّتها ليست سِوى شرذمةٍ
.مِن الرّجال يتناحرون بين تلك الجُدران

267
00:18:15,800 --> 00:18:17,930
.هذا جُلّ ما أَفهمه على أيّ حالٍ

268
00:18:18,790 --> 00:18:23,340
لكن المدينة الّتي نعيش فيها تُشبه
.صندوقًا ضخمًا آخر يُطوّقهم جميعًا

269
00:18:24,650 --> 00:18:29,050
،لو أنّ حريقًا نشب بقُوّةٍ
.فلن يَجد مِن بالدّاخل مَهربًا

270
00:18:30,230 --> 00:18:31,980
،مضى وقتٌ طويل
.لعلّي سأَعرج عليها قليلًا

271
00:18:34,540 --> 00:18:37,550
.سُررت برُؤيتك يا هاجيمي
!كُنت بانتظارك

272
00:18:37,550 --> 00:18:39,660
ماذا؟
هل أنت راحلٌ بهذه السّرعة؟

273
00:18:39,660 --> 00:18:41,160
...ساعدني في الدُكّان لـ

274
00:18:41,160 --> 00:18:43,560
!جئت لأَستلم رسالة إيروها فحسب

275
00:18:43,950 --> 00:18:45,780
!أنصت إليّ يا هاجيمي

276
00:18:45,060 --> 00:18:46,290
!إلى اللّقاء

277
00:18:52,080 --> 00:18:55,770
كيف هي أَحوالك يا هاجيمي-تشان؟"
"!هذه أنا إيروها

278
00:18:55,960 --> 00:19:01,150
كانت الأجواء هُنا صاخبةً جدًا لدرجة"
".أنّني لم أجد وقتًا للكتابة، أنا آسفةٌ

279
00:19:01,500 --> 00:19:02,590
".أكاد أُجزم أنّك اشتقت إليّ"

280
00:19:02,590 --> 00:19:03,790
.هيهات أن أفعل

281
00:19:03,790 --> 00:19:06,330
"،لا يُمكنني الخَوض في التّفاصيل"

282
00:19:06,330 --> 00:19:10,040
لكن خطبًا جسيمًا يقع في"
".القصر الآن

283
00:19:10,520 --> 00:19:12,590
وهذا الأمر يجعلني قلقةً"
".بعض الشّيء

284
00:19:12,970 --> 00:19:18,200
آمل ألّا يُصيبك مكروهٌ أنت أو أخي"
".أو بقيّة رجال المِيبورو

285
00:19:18,550 --> 00:19:20,450
،ختامًا، إلى لقاءٍ قريب، هاجيمي-تشان"
".التّوقيع: إيروها

286
00:19:22,540 --> 00:19:23,560
.تلك الحمقاء الصّغيرة

287
00:19:24,450 --> 00:19:27,200
،نحن مَن نحميكِ
فلمَ القلق؟

288
00:19:33,880 --> 00:19:35,200
!حصانٌ؟

289
00:19:35,310 --> 00:19:37,060
.يا له مِن حصانٍ رائع حقًا

290
00:19:37,060 --> 00:19:38,540
.وضخمٌ للغاية أيضًا

291
00:19:39,050 --> 00:19:40,110
ما سبب تواجده هُنا؟

292
00:19:40,360 --> 00:19:43,650
،ابتاعه سيريزاوا-سان
.وقد وصل لتوّه

293
00:19:44,090 --> 00:19:47,040
حصانٌ، أَليس كذلك؟
.ليتني أحظى بواحدٍ

294
00:19:47,540 --> 00:19:50,740
،هذا حصان سيريزاوا-سينسي
.لا تَعبث به

295
00:19:52,460 --> 00:19:54,880
أظنّ أنّني سأَقوم بالتّدريب
.قبل تناول الزّاد

296
00:20:05,790 --> 00:20:07,150
.وضعيّتك مختلّةٌ

297
00:20:08,720 --> 00:20:10,950
يجب أن تبقى يدك اليُسرى
.في المُنتصف تمامًا

298
00:20:11,260 --> 00:20:15,040
انتقالك إلى الضّربة التّالية سيئٌ للغاية
.لأنّك لا تستطيع الحِفاظ على ثباتها هُناك

299
00:20:15,280 --> 00:20:16,320
.هاجيمي

300
00:20:17,840 --> 00:20:18,900
.هذه أساسيّات فنّ السّيف

301
00:20:19,080 --> 00:20:20,730
مـ-من طَلب رأيك؟

302
00:20:21,200 --> 00:20:25,300
أَلا تُبالي بما اقترفه سيريزاوا؟

303
00:20:26,020 --> 00:20:27,950
.كان الكثيرون سيَلقون حتفهم

304
00:20:29,480 --> 00:20:33,200
لدى سيريزاوا-سينسي
.غايةٌ يسعى لها

305
00:20:33,370 --> 00:20:34,710
.أنت لن تفهم مَقصده

306
00:20:35,100 --> 00:20:37,920
.لا مَستقبل لك ببَقائك مع سيريزاوا

307
00:20:38,250 --> 00:20:39,840
عمّ تتحدّث؟

308
00:20:42,320 --> 00:20:43,790
.قتل سيريزاوا

309
00:20:44,090 --> 00:20:45,760
.هذا ما يرمون إليه

310
00:20:46,830 --> 00:20:48,270
.لا شيء، حقًا

311
00:20:49,530 --> 00:20:51,470
.أنا أُؤمن به

312
00:20:51,760 --> 00:20:53,870
.إنّه يفعل الصّواب دومًا

313
00:20:54,760 --> 00:20:58,130
أقول لك دَع عنك ذلك الأبله
!الّذي يعيش في الماضي

314
00:21:01,290 --> 00:21:02,040
،أنصت جيّدًا

315
00:21:03,300 --> 00:21:06,100
.لن أَتهاون معك إن انحزت إليه

316
00:21:19,770 --> 00:21:22,040
"كان قَولي "يعيش في الماضي
.قاسيًا للغاية

317
00:21:22,780 --> 00:21:25,960
حسنًا، يُمكنني دائمًا الاعتذار له
.في تدريب الصّباح

318
00:21:27,420 --> 00:21:31,430
.لكن تلك الفُرصة لم تَسنح قطّ

319
00:21:32,760 --> 00:21:35,460
فمَع بُزوغ أوّل ضوءٍ في
...الثّامن عشر مِن أغسطس

320
00:21:39,570 --> 00:21:43,830
ضرب الاضطراب أرجاء
.القصر الإمبراطوريّ

321
