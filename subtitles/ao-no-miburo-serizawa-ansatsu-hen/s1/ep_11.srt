1
00:00:04,230 --> 00:00:06,400
لم يكُن مِن المُفترض أن يؤول
.الحال إلى هذا المُنقلب

2
00:00:08,400 --> 00:00:12,320
،أعتذر منك يا سوجي
.أَخفقنا في هذه المُهمّة

3
00:00:12,980 --> 00:00:15,280
ما قِيمة المرأة؟

4
00:00:15,800 --> 00:00:17,540
،لا ريب أنّ الجمال مَطلبٌ

5
00:00:17,890 --> 00:00:23,040
لكن العِبرة بما تحمله في جوهرها
مِن صلابةٍ، أَلا تتّفق معي؟

6
00:00:23,260 --> 00:00:25,320
.بلى، أَتّفق

7
00:00:25,790 --> 00:00:28,050
ولكن أَلا ينطبق الأمر ذاته
على الرّجال؟

8
00:00:28,840 --> 00:00:31,040
.أنت وتَلاعبك بالكلمات

9
00:00:31,950 --> 00:00:34,130
،هُناك ما يُثير قلقي

10
00:00:34,130 --> 00:00:40,020
حسب رُؤية نيمي لا يَسعك
.تلقّي أدنى جُرحٍ

11
00:00:40,260 --> 00:00:44,310
،ماذا لو شلّك الخوف
ولم تَعد قادرًا على القتال؟

12
00:00:44,560 --> 00:00:46,520
.كلا، لن يكون ذلك عائقًا

13
00:00:46,520 --> 00:00:51,750
،هكذا يكون القول
.فالجُروح ليست إلّا أوسمةً للشّرف

14
00:00:51,750 --> 00:00:52,860
.لم يكن ذلك مَقصدي

15
00:00:53,850 --> 00:00:56,320
بل سنُتمّ هذا النّزال
.دُون أن يمسّنا خدشٌ

16
00:01:06,520 --> 00:01:10,750
.يبدو أنّك لا تُقيم لي وزنًا

17
00:02:49,880 --> 00:02:55,110
ما لا يَسعني فهمه، لِمَ يستخدم سيفين؟
هل بَلغ به اليأس هذا المَبلغ؟

18
00:02:55,110 --> 00:02:57,280
،حسنًا، لا بأس
.سأُجاريه في رغبته

19
00:02:58,030 --> 00:03:02,780
،استخدام سيفين جيّدٌ للدّفاع
.فهُما يُبقيان الخصم بعيدًا

20
00:03:02,780 --> 00:03:04,160
...ولكن ماذا لو

21
00:03:04,460 --> 00:03:06,880
نَفذت إلى مَداك قبل أن تُوقفني؟

22
00:03:08,560 --> 00:03:11,860
،كما توقعت تمامًا
،تصدّ هُجومي بسيفك الطّويل

23
00:03:11,860 --> 00:03:15,040
.ثُمّ تُحاول القضاء عليّ بالقصير

24
00:03:16,110 --> 00:03:18,670
.لكنّي لن أُمكّنك مِن نيل مُرادك

25
00:03:25,130 --> 00:03:28,140
.حتّى أنا أقف مذهولًا أمام بَراعتي

26
00:03:28,430 --> 00:03:31,760
إنّ هذا الأسلوب المُرتجل في استخدام
!سيفين يبعث على الضّجر

27
00:03:33,280 --> 00:03:37,270
،تَساوت الكِفّتان الآن
.ولن يبقى إلّا السّيوف الطّويلة

28
00:03:37,440 --> 00:03:40,420
.هذا إن لم يتدخّل أحدٌ

29
00:03:40,420 --> 00:03:42,720
.ولكنّي أظنّ أن لا داعي للقلق

30
00:03:44,070 --> 00:03:47,320
لا ضَير عندي، لك مُطلق الحُريّة
.في التّنحي جانبًا والانتظار

31
00:03:47,710 --> 00:03:49,040
.سأَتولّى أنا حسم هذا النّزال

32
00:03:51,280 --> 00:03:53,000
...معذرةً

33
00:03:53,300 --> 00:03:55,000
.لكن هذا لن يُجدي نفعًا

34
00:03:55,000 --> 00:03:56,670
.فأنا أُدرك ما أنا مقبلٌ عليه

35
00:04:05,000 --> 00:04:07,670
.هذا يَبعث على الدّهشة

36
00:04:08,560 --> 00:04:11,190
أنت لا تَتوانى عن فِعل المُستحيل
.لتَنال النّصر

37
00:04:11,400 --> 00:04:16,060
لا صِلة لما فعلتَ بالجُبن، بل هُو الإلهام
.الّذي ينهال عليك في خِضمّ النّزال

38
00:04:17,310 --> 00:04:21,020
أنت سليل النّصل حتمًا، والقتال
.يَجري في عُروقك مَجرى الدّم

39
00:04:21,530 --> 00:04:24,850
.ولكن أزمنةً عصيبة تَلوح في الأُفق

40
00:04:24,850 --> 00:04:27,780
.حيث ستَكون الغَلبة للبنادق والمدافع

41
00:04:28,210 --> 00:04:32,750
إنّكم لآخر جيلٍ يختال بسيفه
.على خصره

42
00:04:33,050 --> 00:04:39,040
،لو وُلدتَ في زمنٍ غير هذا
.لما كان لمَوهبتك أن ترى النّور

43
00:04:40,680 --> 00:04:42,020
!أوكيتا

44
00:04:42,020 --> 00:04:46,180
حريٌّ بك أن تمتنّ للقدر
.الّذي أوجدك في هذا العَصر

45
00:04:46,180 --> 00:04:50,240
.ولكن المُحزن أنّك تفتقر للكبرياء

46
00:04:50,240 --> 00:04:53,930
ها أنت تَبذل نفسك وسيفك
.لأَجل الآخرين

47
00:04:53,930 --> 00:04:56,740
رُغم أنّك نِلت فُرصةً لبُلوغ
...حُلم كُلّ السّيافين

48
00:04:56,740 --> 00:05:00,160
.ميكازوتشي، سيّد النّصال

49
00:05:01,230 --> 00:05:03,440
.كذلك أنت أيضًا

50
00:05:04,110 --> 00:05:04,950
ماذا؟

51
00:05:05,760 --> 00:05:09,240
،لو أنّ مَطلبك القُوّة المَحضة
.لغَدوت سيّد النّصال بلا مُنازعٍ

52
00:05:10,540 --> 00:05:13,620
.ما كان للمِيبورو أن يشتدّ عُودهم لولاك

53
00:05:14,150 --> 00:05:16,210
،قدّمت مصلحة الجماعة على ذاتك

54
00:05:16,540 --> 00:05:19,850
وأَتممت دورك في تمهيد الدّرب
.لهم على أكمل وجهٍ

55
00:05:19,850 --> 00:05:21,840
عمّ تَهذي؟

56
00:05:22,680 --> 00:05:26,340
كُنت أعلم أنّني لن أنال منك
.ما دُمت تعلم مواضع ضرباتي

57
00:05:27,370 --> 00:05:28,180
...لذلك

58
00:05:30,820 --> 00:05:31,930
ماذا؟

59
00:05:32,790 --> 00:05:33,920
السّيف القصير؟

60
00:05:35,250 --> 00:05:37,130
.لعلّه خطّط لهذا مُنذ البداية

61
00:05:38,140 --> 00:05:40,890
إنّه بحقٍ تجسّدٌ حيّ
.لـ "ميكازوتشي" سيّد النّصال

62
00:05:45,580 --> 00:05:49,580
،سيريزاوا-سان
.إنّ لك في نفسي احترامًا جمًا

63
00:05:54,050 --> 00:05:55,970
.لا تتوقّفي، واصلي السّير

64
00:05:56,240 --> 00:05:59,290
،لا أَقوى على ذلك
.ساقاي لا تنفكّان عن الارتجاف

65
00:05:59,290 --> 00:06:00,670
.لا بُدّ لكّ مِن السّير

66
00:06:00,670 --> 00:06:03,020
.لا تَلمسني أيّها القاتل

67
00:06:03,020 --> 00:06:05,550
.لن أنصاع لأَوامرك بعد الآن

68
00:06:06,760 --> 00:06:09,640
.أصغي جيّدًا، أنتِ حرّةٌ

69
00:06:10,070 --> 00:06:12,250
.ولا قَيد يُلزمكِ بالعودة إلى شيمابارا

70
00:06:12,760 --> 00:06:14,300
.غادري كيوتو فحسب

71
00:06:14,560 --> 00:06:16,540
.إذًا خُذني معك

72
00:06:16,750 --> 00:06:18,000
.لا يَسعني فِعل ذلك

73
00:06:18,000 --> 00:06:18,920
!كلا

74
00:06:25,850 --> 00:06:29,370
،أنا مستعدّةٌ للموت
.ولا يُخالجني النّدم

75
00:06:31,380 --> 00:06:33,880
.لا أستطيع لَوم مَن اختار مَنيّته

76
00:06:36,930 --> 00:06:38,370
.فَقدت صديقًا مات بذات الطّريقة

77
00:06:40,000 --> 00:06:43,850
.يامانامي، أُريد منك إتمامها

78
00:06:45,240 --> 00:06:48,880
إن كان مَوتك هُو التّضحية
...لأجل المُستقبل

79
00:06:57,280 --> 00:07:00,920
إذن، لهذا السّبب انتقلت
إلى أُسلوب السّيفين؟

80
00:07:01,220 --> 00:07:08,650
،تسلّلت مِن خلال النّقطة العمياء لعيني المُصابة
لتُهاجمني بذاك السّيف القصير الّذي ألقيته؟

81
00:07:10,240 --> 00:07:11,070
.استعدّ لمَنيّتك

82
00:07:15,030 --> 00:07:18,580
،حُسم النّزال
.فلا تُطل أَمده بلا طائلٍ

83
00:07:19,380 --> 00:07:21,680
.محالٌ

84
00:07:22,020 --> 00:07:23,800
!لم يَحن الوقت بعد

85
00:07:26,490 --> 00:07:29,540
،لن أموت الآن
.ليس بعد

86
00:07:32,940 --> 00:07:36,370
.لن يكون مَصرعي في هذا المكان

87
00:07:36,370 --> 00:07:38,680
!هيجيكاتا-سان
!لا تَدعه يعبر إلى الرّدهة

88
00:07:38,880 --> 00:07:39,880
!أَوقفه

89
00:07:39,880 --> 00:07:41,040
.أنا أُدرك ذلك يقينًا

90
00:07:42,020 --> 00:07:43,400
ولكن لماذا؟

91
00:07:44,830 --> 00:07:46,520
لماذا أنا عاجزٌ عن الحركة؟

92
00:07:48,600 --> 00:07:50,360
.ثمّة رجلٌ يُدعى سيريزاوا

93
00:07:51,720 --> 00:07:55,840
.أَحسب أنّه ساموراي حقيقيّ

94
00:07:56,840 --> 00:07:58,840
ما هُو السّاموراي الحقيقيّ؟

95
00:07:59,110 --> 00:08:02,540
،مَن ينحدر مِن سُلالة السّاموراي
.وتَسكنه رُوح ساموراي

96
00:08:03,260 --> 00:08:05,910
ساموراي برُوح ساموراي؟

97
00:08:05,910 --> 00:08:08,250
.يبدو هذا اعتياديًا

98
00:08:10,220 --> 00:08:11,230
،أنا واهمٌ

99
00:08:13,100 --> 00:08:17,260
،فالسّاموراي ليسوا سوى زَيفٍ
.ولا وجود لأحدٍ بتلك الصّفات

100
00:08:19,770 --> 00:08:22,200
أيّ إقطاعيّةٍ تخدم؟
وما هِي مدرستك في القتال؟

101
00:08:22,660 --> 00:08:24,100
،أَقصد مدارس الدّوجو للمُبارزة

102
00:08:29,320 --> 00:08:30,860
.وأُزاول التّجارة

103
00:08:31,150 --> 00:08:33,530
هل تبتغون دواءً لتلك
الرّضوض والتمزّقات؟

104
00:08:33,530 --> 00:08:35,410
.أُقدّم خصمًا لمن يبتاع بالجُملة

105
00:08:36,000 --> 00:08:38,350
أَلا تبتاعون منّي؟
.فأنا أرى أنّكم مُصابون

106
00:08:40,140 --> 00:08:42,960
.بلغني أنّك ابن فلّاحٍ

107
00:08:43,840 --> 00:08:47,920
أيّ جُرأةٍ هذه الّتي تدفعك
للاستهزاء بنا نحن السّاموراي؟

108
00:08:49,060 --> 00:08:51,520
تَسعون للانتقام منّي جماعةً
وأنتم مُلثّمون؟

109
00:08:51,520 --> 00:08:53,590
كيف يُطلق لقب السّاموراي
على شَاكلتكم؟

110
00:08:54,480 --> 00:08:57,230
أَلا تعلم أنّ لنا الحقّ في
ضرب عُنقك لتَطاولك؟

111
00:08:56,250 --> 00:08:57,200
!أَجهزوا عليه

112
00:08:57,230 --> 00:09:00,140
لا يحقّ للرّعاع أن يقفوا
.في وجه السّاموراي

113
00:08:57,510 --> 00:08:59,090
هل عَرفت مكانتك الآن؟

114
00:09:00,630 --> 00:09:03,630
،لا أشعر بأَلمٍ
.بل لا يُعدّ هذا حتّى مُداعبةً

115
00:09:03,630 --> 00:09:05,640
ما أَنتم إلّا محض حفنةٍ
.مِن المُزيّفين

116
00:09:09,600 --> 00:09:13,560
مَن أقام عِماد هذه البلاد
حين سَاد الأمن؟

117
00:09:15,360 --> 00:09:18,040
ومَن فَلح أرضها؟

118
00:09:19,120 --> 00:09:20,970
.بات يَقيني راسخًا

119
00:09:21,230 --> 00:09:24,420
السّاموراي لم تَعد تسكنهم
.أرواح السّاموراي

120
00:09:24,940 --> 00:09:29,790
،وإن بَقيت ذرّةٌ مِن نُبلٍ
.فهِي في صُدور البَسيطين

121
00:09:31,300 --> 00:09:34,960
.ما كان ظنًا استحال يقينًا بفضلهم

122
00:09:36,620 --> 00:09:39,520
.إنّني لأفتخر بأنّي وُلدت فلّاحًا

123
00:09:41,890 --> 00:09:43,680
.أو هكذا خُيّل إليّ

124
00:09:43,880 --> 00:09:46,610
هُنا يتمّ توظيف الرّونين؟

125
00:09:46,610 --> 00:09:49,200
بلغني أنّهم يمنحون أُجورًا
.سخيّةً لتغطية نفقات السّفر

126
00:09:49,860 --> 00:09:52,860
هل تسعى أنت أيضًا لنَيل
عطايا الشوغونيّة؟

127
00:09:53,600 --> 00:09:55,770
،لا تظنّ أنّنا سواءٌ

128
00:09:56,160 --> 00:09:59,200
فأنا ذاهبٌ لأَضع حدًا للفوضى
.في كيوتو

129
00:09:59,490 --> 00:10:03,200
.حقًا؟ راقت لي هَيئتك

130
00:10:03,200 --> 00:10:05,220
،كفى

131
00:10:05,220 --> 00:10:07,740
،سنَمضي معًا
.لأَجل رِفعة بلادنا

132
00:10:11,090 --> 00:10:13,950
،إن لم نَجد نُزلًا
.فالعراء مَضجعنا

133
00:10:13,950 --> 00:10:15,960
.وهذا يعني أنّ علينا البَقاء دافئين

134
00:10:17,670 --> 00:10:20,390
،مِن خلال رحلتنا معًا
.أدركت كم كان جلفًا ومُتهوّرًا

135
00:10:21,380 --> 00:10:23,720
،أَصبو لأَجمل النّساء

136
00:10:23,720 --> 00:10:25,480
،وأُريد أن أُشيّد قصرًا

137
00:10:26,060 --> 00:10:28,450
.وأن تكون لي سيادةٌ مُطلقة

138
00:10:28,450 --> 00:10:31,790
،في كيوتو
.ضِقت ذرعًا بجشعه

139
00:10:32,670 --> 00:10:38,410
،لكنّه قاد المِيبورو بيقينٍ وبأس
.وأحيانًا بمَكرٍ

140
00:10:39,660 --> 00:10:44,040
،جمع بين الجَسارة والدّهاء

141
00:10:44,710 --> 00:10:46,540
،وكان دومًا مصدر خطرٍ

142
00:10:47,080 --> 00:10:48,800
.لكنّه مَلك سِحرًا طاغيًا أيضًا

143
00:10:50,760 --> 00:10:54,920
،كان كُلّ ما تخيّلته في السّاموراي
.ساموراي حقيقيًا

144
00:10:55,250 --> 00:10:58,230
.ما زِلت قادرًا على النّزال

145
00:10:58,230 --> 00:10:59,930
.صُبّ جام غضبك عليّ يا هيجيكاتا

146
00:11:00,870 --> 00:11:03,580
...سنواتٌ مِن الغِلّ المَكبوت والغيرة

147
00:11:04,960 --> 00:11:08,750
أَليس لديك مَأربٌ شخصيّ
ترغب في نيله؟

148
00:11:09,380 --> 00:11:15,190
بأيّ صفةٍ يتجرأ فلّاحٌ وضيع
على قتل ساموراي شامخٍ؟

149
00:11:15,440 --> 00:11:16,520
هيجيكاتا-سان؟

150
00:11:16,890 --> 00:11:22,280
!بَقاؤك حيًا يجعلني أشعر بالمَذلّة

151
00:11:25,070 --> 00:11:26,700
!أيّها الفلّاح القذر

152
00:11:30,190 --> 00:11:33,500
ما هذا؟
.ضربتك خاويةٌ مِن اليقين

153
00:11:33,500 --> 00:11:36,550
لن أموت على يَدك
.وأنت بهذا الضّعف

154
00:11:36,550 --> 00:11:42,730
،لا ثقة بمَن يُطيل الثّرثرة
.ويتردّد عند الضّرب

155
00:11:42,730 --> 00:11:46,050
.خَذلتني يا هيجيكاتا

156
00:11:47,120 --> 00:11:50,660
،في النّهاية
.عجزتَ أن تكون شيطانًا بحقٍ

157
00:11:59,490 --> 00:12:03,480
أين ستَكون منيّتي؟
.ليس هُنا، هذا مؤكّدٌ

158
00:12:03,480 --> 00:12:04,750
.تبًا لكُلّ شيءٍ

159
00:12:05,800 --> 00:12:07,860
!كفى، سأَفعلها

160
00:12:08,650 --> 00:12:10,870
،عَقدنا العزم
!ولا رُجوع عمّا بدأنا

161
00:12:12,600 --> 00:12:13,950
!تريّث يا سيريزاوا

162
00:12:20,720 --> 00:12:23,070
،أنا مَن سيَضع الخاتمة
.هُنا والآن

163
00:12:23,930 --> 00:12:25,420
.أوكيتا

164
00:12:25,420 --> 00:12:30,730
هذا الرّواق الضّيق لا يمنحك حُريّة
.المُناورة الّتي حظيت بها آنفًا

165
00:12:30,730 --> 00:12:32,010
ماذا ستَفعل؟

166
00:12:37,000 --> 00:12:42,050
طعنة مدرسة تينّين ريشين؟
.أجل، ذلك خِيارك إذن

167
00:12:42,050 --> 00:12:43,970
هل هذه الطّعنة الثُلاثيّة
ذائعة الصّيت؟

168
00:12:44,610 --> 00:12:50,930
بلغني حديث الرّجال عن كيف يُمكن لـ أوكيتا-سينسي
.أن يُسدّد ثلاث طعناتٍ في آنٍ واحد

169
00:12:51,590 --> 00:12:53,920
.لم أُجرّبها بسيفٍ حقيقيّ مِن قبل

170
00:12:54,180 --> 00:12:58,760
،أَرني مهارتك إذن
.سأَردّها جميعًا

171
00:12:59,010 --> 00:13:00,910
.سنَرى بشأن ذلك

172
00:13:01,920 --> 00:13:02,920
...بِدءًا

173
00:13:06,720 --> 00:13:08,130
!ها هِي ذي

174
00:13:08,510 --> 00:13:10,600
.أَخطأ الجميع في العَدّ...

175
00:13:12,420 --> 00:13:13,590
.واحدةٌ

176
00:13:14,670 --> 00:13:15,660
.اثنتان

177
00:13:14,760 --> 00:13:18,520
يبدو أنّهم أغفلوا الطّعنة
.الخاطفة بعد الأولى

178
00:13:16,560 --> 00:13:17,660
.ثلاثٌ

179
00:13:18,530 --> 00:13:19,730
!صَددتها

180
00:13:21,120 --> 00:13:22,320
أربعٌ؟

181
00:13:22,960 --> 00:13:24,320
هل رأيت ذلك؟

182
00:13:25,020 --> 00:13:28,320
،في الواقع
،يُهزم الخصم عند الرّابعة

183
00:13:28,750 --> 00:13:29,830
...لكن الحقيقة

184
00:13:31,770 --> 00:13:32,760
.أنّها خمس طعناتٍ

185
00:13:37,370 --> 00:13:39,470
صدّها كُلّها؟

186
00:13:39,470 --> 00:13:41,960
.كان ذلك مُمتعًا

187
00:13:42,320 --> 00:13:44,710
أَلا تملك أيّ ثغرةٍ؟

188
00:13:45,090 --> 00:13:47,050
...كلا

189
00:13:47,720 --> 00:13:48,760
.بالطّبع...

190
00:13:53,430 --> 00:13:54,480
!هيّا بنا

191
00:13:56,090 --> 00:13:58,180
.سُحقًا

192
00:13:59,130 --> 00:14:00,840
.أنا عاجزٌ تمامًا

193
00:14:04,780 --> 00:14:09,910
نَشبت قدمك بالمِنضدة؟
.نَفد رصيدك مِن الحظّ كما يبدو

194
00:14:10,090 --> 00:14:12,920
.حان أَجلك يا أوكيتا

195
00:14:15,200 --> 00:14:16,290
!يو-بو

196
00:14:18,460 --> 00:14:19,550
طفلُ؟

197
00:14:20,410 --> 00:14:21,680
.تسوجوجي

198
00:14:21,680 --> 00:14:25,560
،تسوجوجي
،أنت جامحٌ للغاية

199
00:14:25,560 --> 00:14:27,670
.لكن فيك خصلةّ طيّبة

200
00:14:28,370 --> 00:14:31,000
.أنّك ترعى مَن هُم دُونك منزلةً

201
00:14:31,000 --> 00:14:32,950
.وتَرفق بالصّغار

202
00:14:33,530 --> 00:14:35,770
،اخرس
!أيّها العجوز الخَرف

203
00:14:35,770 --> 00:14:37,810
هل تَبتغي العِراك؟

204
00:14:38,380 --> 00:14:40,890
.تلك كانت نُقطة ضعفي

205
00:14:41,880 --> 00:14:45,000
،وهِي تافهةٌ جدًا
.لكنّها تُؤرّقني

206
00:14:45,880 --> 00:14:49,540
،أملك مقوّمات الزّعامة بين السّاموراي

207
00:14:49,540 --> 00:14:53,180
لكنّي لا أقوى على تجاهل فَرخٍ
.عجز عن العودة إلى عُشّه

208
00:14:53,840 --> 00:14:54,960
...كما حدث ذات مرّةٍ

209
00:14:56,840 --> 00:14:58,780
.انظروا كم هُو متّسخٌ

210
00:14:58,780 --> 00:15:01,160
أَلا يُمكنه الذّهاب إلى مكانٍ آخر؟

211
00:15:01,160 --> 00:15:02,460
.حبّذا لو يكفّ عن هذه التصرّفات

212
00:15:02,990 --> 00:15:07,030
،تملّكني شعورٌ ما
.فوَجدت نفسي أُحادثه

213
00:15:08,490 --> 00:15:11,680
لماذا أهتمّ بالصّغار إلى هذا الحدّ؟

214
00:15:12,560 --> 00:15:16,350
!لأنّ هذه طبيعتك الحقيقيّة

215
00:15:16,350 --> 00:15:18,770
!ليست كذلك

216
00:15:21,480 --> 00:15:25,690
!ليست كذلك

217
00:15:32,480 --> 00:15:34,280
حافة المَدخل؟

218
00:15:38,000 --> 00:15:40,040
.يا له مِن خطأٍ لا يقع فيه إلّا المُبتدئون

219
00:15:40,560 --> 00:15:41,990
،تبًا

220
00:15:43,540 --> 00:15:45,550
كيف أَسأت تقدير خُطورة الموقف؟

221
00:15:47,040 --> 00:15:53,480
إنّ حماية مدينة كيوتو هِي الغاية
.الّتي ننشدها نحن المِيبورو

222
00:15:54,160 --> 00:15:56,810
كان لِزامًا علينا خوض هذه
.المعركة لتَحقيق ذلك

223
00:15:58,350 --> 00:16:01,560
،سيريزاوا رجلٌ خَطِرٌ جدًا
.ولا سبيل لكَبحه

224
00:16:02,200 --> 00:16:04,900
،عاجلًا أم آجلًا
.سيَقترف ما لا يُمكن إصلاحه قطعًا

225
00:16:06,410 --> 00:16:09,680
علينا حماية جماعة المِيبورو
.مِن الانقسام

226
00:16:10,480 --> 00:16:13,950
،ولنتذكّر ذلك التّكليف السّري مِن آيزو
.هذا ما يمنحنا الذّريعة الكافية لما نعتزم فِعله

227
00:16:14,320 --> 00:16:16,830
ماذا يعني لك السّيف؟

228
00:16:21,060 --> 00:16:22,640
.إنّه وهمٌ لا أكثر

229
00:16:23,000 --> 00:16:26,540
كُنت جازمًا حين أخبرته أنّ تُرهات
.السّاموراي هذه ليست سوى زيفٍ

230
00:16:27,430 --> 00:16:30,360
لكنّي الآن أقف وجهًا لوجهٍ
.أمام ساموراي حقيقيّ

231
00:16:30,880 --> 00:16:32,710
أَتُراني مُخطئًا؟

232
00:16:33,240 --> 00:16:35,800
أَتُراني أقترف خطيئةً لا تُغتفر؟

233
00:16:36,320 --> 00:16:40,560
هل هذا الرّجل بطلٌ فذّ
لا غنى لـ المِيبورو عنه؟

234
00:16:40,560 --> 00:16:46,130
أَتُراه ممّن لا مَثيل لهم؟ هل هُو المُنقذ
الّذي ترتجيه البلاد في كُروبها العَصيبة؟

235
00:16:46,620 --> 00:16:50,080
وتأمّل حالي الآن، أُحاول نَحره
.وهُو غارقٌ في نوبة سَكرٍ

236
00:16:50,430 --> 00:16:53,110
كيف لا أشمئزّ مِن نفسي؟

237
00:16:54,190 --> 00:16:55,010
...ولكن

238
00:16:57,960 --> 00:17:00,680
حتّى أنا، ثمّة مبادئٌ
.لا أقوى التخلّي عنها

239
00:17:01,080 --> 00:17:03,590
.لا أستطيع أن أَدعه للموت

240
00:17:04,680 --> 00:17:07,090
...لَحقت بي لتَنفيذ خُطّتي الحمقاء

241
00:17:07,640 --> 00:17:11,350
.دُون ريبٍ أو كلمة شَكوى

242
00:17:14,830 --> 00:17:15,840
.سوجي

243
00:17:18,220 --> 00:17:21,310
كان لقاؤنا الأوّل وأنت في
.التّاسعة مِن عُمرك

244
00:17:22,140 --> 00:17:24,110
.أذكر ذلك وكأنّه حَدث بالأمس

245
00:17:25,050 --> 00:17:26,550
هل تُقدّم دُروسًا؟

246
00:17:26,550 --> 00:17:29,560
هل أنت متيقّنٌ أنّ بمَقدورك تعليم
الطّلاب في غياب كوندو-سان؟

247
00:17:29,850 --> 00:17:32,360
.انشغل بنفسك أيّها الأحمق

248
00:17:33,600 --> 00:17:34,960
!هيّا، ابدؤوا النّزال

249
00:17:34,960 --> 00:17:35,830
!حاضرٌ يا سيّدي

250
00:17:37,100 --> 00:17:39,830
كان النّاس يَنعتونك بالعبقريّ
.مُنذ أمدٍ بعيد

251
00:17:40,270 --> 00:17:41,640
.تأمّلوا ما أَفعل

252
00:17:45,630 --> 00:17:46,520
.هكذا يكون الإتقان

253
00:17:49,200 --> 00:17:52,090
.كُنت أعلم أنّ اسمك سيَذيع صِيته

254
00:17:52,800 --> 00:17:55,880
.لكنّك كُنت تبدو ضَجرًا لسببٍ ما

255
00:17:57,690 --> 00:18:00,100
.قتالٌ؟ ما أنت إلّا طفلٌ

256
00:18:00,310 --> 00:18:01,680
.كُفّ عن ملاحقتي

257
00:18:02,650 --> 00:18:04,510
.أنا أُراقبك كي لا تَلوذ بالفِرار

258
00:18:05,060 --> 00:18:09,390
لا ينبغي لمَن ينتمي لمدرسة
.تينّين ريشين أن يُهزم أبدًا

259
00:18:10,230 --> 00:18:13,570
،لا أعلم ما الّذي حوّل حالك

260
00:18:14,610 --> 00:18:18,010
.لكنّي وجدت أنّ لِزامًا عليّ مُؤازرتك

261
00:18:20,180 --> 00:18:25,740
ما خِلت أنّك ستُسارع للانضمام إلى هؤلاء
.الرّونين عند أوّل فُرصةٍ سنحت لك

262
00:18:26,320 --> 00:18:28,220
ما المَانع مِن إعانة النّاس
بين الحين والآخر؟

263
00:18:28,670 --> 00:18:30,040
.سأَمضي معك

264
00:18:30,500 --> 00:18:32,880
،انسَ ذلك
.لن أَقوم بحمايتك

265
00:18:33,160 --> 00:18:37,880
.سأَظلّ معك أينما حَللت

266
00:18:39,200 --> 00:18:41,210
.أُراهن أنّك تحسب نفسك رقيبًا عليّ

267
00:18:42,020 --> 00:18:43,390
،لكن الحقيقة كانت

268
00:18:44,250 --> 00:18:48,900
.أنّك أنت مَن يحرس ظهري دومًا

269
00:18:49,540 --> 00:18:52,370
،لطالما وضعت ثِقتك بي
.وتَبعت خُطاي

270
00:18:53,370 --> 00:18:55,290
،تأمّل حالك الآن
.وقد غمرتك الدّماء

271
00:18:56,420 --> 00:18:58,310
.حتّى يداك لم تَعودا طاهرتين

272
00:18:59,650 --> 00:19:04,350
،أعلم أنّي سأَقترف مزيدًا مِن الخطايا
.وسأَندم على كُلّ واحدةٍ منها

273
00:19:04,840 --> 00:19:08,330
وستَظلّ هذه أعظم خطيئةٍ
.في عُمري

274
00:19:09,900 --> 00:19:11,160
...ولكن رغم ذلك

275
00:19:18,280 --> 00:19:20,920
!لا يُمكنني أن أَدع سوجي يموت

276
00:19:25,940 --> 00:19:30,160
،سأَقولها صريحةً
.أنت ساموراي حقيقيّ

277
00:19:30,160 --> 00:19:32,040
ابنُ هذا العَصر، والرّجل
.الّذي كان وجوده ضرورةً

278
00:19:32,040 --> 00:19:33,750
.هيجيكاتا

279
00:19:35,440 --> 00:19:38,200
.اسمي لا يستحقّ أن يُخلّد

280
00:19:38,800 --> 00:19:42,240
سيريزاوا كامو، القائد الأوّل
،لجماعة ميبو روشيغومي

281
00:19:42,550 --> 00:19:45,200
سأَجعل الأجيال القادمة تذكر
.اسمك جيّدًا

282
00:19:45,600 --> 00:19:51,700
،أنا لست سوى نَكرةٍ
.أمّا هُو... فإنّه كنزٌ حقيقيّ

283
00:19:52,300 --> 00:19:55,060
!لذا... مُت

284
00:19:57,920 --> 00:20:02,100
إذًا، بمَقدورك أن تضرب دُون تردّد
حين تكون المسألة مُتعلّقةً برفيقٍ؟

285
00:20:02,470 --> 00:20:08,100
،ليس لقضيّةٍ سامية أو لأَجل مُنظّمةٍ
.بل لدافعٍ شخصيّ مَحض

286
00:20:08,400 --> 00:20:13,110
.هيجيكاتا، ما أَحقرك مِن رجلٍ

287
00:20:13,600 --> 00:20:16,470
.عليك أن تنزع هذا الضّعف مِن نفسك

288
00:20:16,470 --> 00:20:22,110
،فمَن ينشد المَعالي
.لا بُدّ أن يتغاضى عن الصّغائر

289
00:20:22,110 --> 00:20:26,340
،لا تملك جمال أوكيتا
.ولا حِدّة نصله

290
00:20:26,720 --> 00:20:30,350
.كانت ضربةً خرقاء غاشمة

291
00:20:31,000 --> 00:20:31,870
...ولكن

292
00:20:32,420 --> 00:20:34,030
...لسببٍ ما

293
00:20:35,040 --> 00:20:39,880
كان لضربتك ألمٌ يفوق
.كُلّ ما سبقها مِن ضرباتٍ

294
00:20:40,110 --> 00:20:41,240
.مُت

295
00:20:41,550 --> 00:20:42,750
.أرجوك مُت

296
00:20:42,750 --> 00:20:44,970
.مُت، مُت

297
00:20:44,970 --> 00:20:46,680
.مُت

298
00:20:44,970 --> 00:20:47,100
إذًا... ها أنت تملك
.الجُرأة لفِعلها

299
00:20:47,690 --> 00:20:51,590
هكذا، تلك هي الطّريقة
.المُثلى يا هيجيكاتا

300
00:20:52,620 --> 00:20:53,390
...إلّا أنّك

301
00:20:54,320 --> 00:20:56,310
.لا بُدّ أن تتأكّد مِن الإجهاز عليّ

302
00:20:58,070 --> 00:20:59,600
.سُحقًا

303
00:21:06,360 --> 00:21:07,660
!تريّث يا سيريزاوا

304
00:21:09,250 --> 00:21:10,240
!لنُحاصره مِن كلا الجانبين

305
00:21:10,240 --> 00:21:10,910
!أجل

306
00:21:14,790 --> 00:21:15,880
الحُجرة الداخليّة؟

307
00:21:18,600 --> 00:21:19,880
.ليس هُنا

308
00:21:20,070 --> 00:21:22,380
،هذا غير معقولٍ
أين ذَهب؟

309
00:21:22,590 --> 00:21:25,230
.لا تَقل لي أنّه فرّ إلى الخارج

310
00:21:25,230 --> 00:21:26,840
.هذا سيّئٌ يا هيجيكاتا-سان

311
00:21:27,320 --> 00:21:29,130
.بحَالته تلك؟ محالٌ

312
00:21:31,760 --> 00:21:33,690
لعلّ أحدًا أعانه على الفِرار؟

313
00:21:43,410 --> 00:21:44,240
.مِن هُنا

314
00:23:21,040 --> 00:23:22,640
.هيجيجاتا توشيزو يُحدّثكم

315
00:23:23,080 --> 00:23:27,130
سيريزاوا-سان، هل ما زِلت تذكر
ذلك التّحدي في الشّرب بيننا؟

316
00:23:27,550 --> 00:23:29,280
.وحَديثك عن السّلحفاة

317
00:23:29,600 --> 00:23:35,090
زَعمت أنّك ستُواصل القتال
.أينما انتهى بك المَطاف

318
00:23:35,090 --> 00:23:37,360
:وأن تَهتف بكُلّ ما أُوتيت
"!أنا هُنا"

319
00:23:37,710 --> 00:23:39,660
.كان ذاك جَوهر الرّجولة في نَظرك

320
00:23:40,650 --> 00:23:44,880
أشعر وكأنّ صدى كلماتك تلك ما زال
.يتردّد في مَسامعي هذه اللّحظة

321
00:23:45,880 --> 00:23:48,390
."الحلقة القادمة: "سيريزاوا كامو