1
00:00:02,420 --> 00:00:03,440
الحُجرة الداخليّة؟

2
00:00:06,080 --> 00:00:07,440
.ليس هُنا

3
00:00:07,670 --> 00:00:09,950
،هذا غير معقولٍ
أين ذَهب؟

4
00:00:10,140 --> 00:00:12,900
.لا تَقل لي أنّه فرّ إلى الخارج

5
00:00:12,900 --> 00:00:14,450
.هذا سيّئٌ يا هيجيكاتا-سان

6
00:00:15,040 --> 00:00:16,950
.بحَالته تلك؟ محالٌ

7
00:00:19,640 --> 00:00:21,450
لعلّ أحدًا أعانه على الفِرار؟

8
00:00:31,460 --> 00:00:32,290
.مِن هُنا

9
00:00:37,080 --> 00:00:37,910
.هيّا بنا

10
00:02:13,240 --> 00:02:20,040
!أجل، أجل، أجل، أجل

11
00:02:20,040 --> 00:02:22,820
!هيّا يا رجال، ارقصوا

12
00:02:33,130 --> 00:02:34,590
لا يبدو أنّ المطر سيَتوقّف
.عن الهُطول

13
00:02:37,280 --> 00:02:39,080
هل سيُحلّق طائر السّنونو؟

14
00:02:50,590 --> 00:02:54,360
نيو، ما الّذي تَنوي فِعله؟

15
00:02:55,000 --> 00:02:59,360
.لا تَقل لي أنّك تُخطّط لتَهريبي

16
00:03:00,130 --> 00:03:05,600
هل تَبتغي مِن سيريزاوا كامو
أن يَفرّ كي يَنجو؟

17
00:03:07,060 --> 00:03:09,650
أيّ جدوى مِن حياةٍ بلا شرفٍ؟

18
00:03:09,650 --> 00:03:11,360
وماذا سيَبقى لي بعدها؟

19
00:03:11,360 --> 00:03:14,370
!لم يبقَ لديّ عملٌ لم أُنجزه

20
00:03:19,100 --> 00:03:20,420
...ما هذا الّذي

21
00:03:20,420 --> 00:03:22,910
لماذا بحقّ الجحيم أُفكّر فيك الآن؟

22
00:03:23,640 --> 00:03:27,600
ستُرزقين بطفلٍ؟
وما شَأني أنا؟

23
00:03:27,600 --> 00:03:30,350
،أنا ساموراي

24
00:03:30,350 --> 00:03:34,730
ومثلي لا يَعرف الاستقرار
.أو سَكينة الأُسرة

25
00:03:35,910 --> 00:03:38,670
أَنجبيه إن شئتِ، لكن
.تحمّلي عبء تربيته وحدكِ

26
00:03:39,560 --> 00:03:40,620
.ما هذا إلّا مضيعةٌ للوقت

27
00:03:43,210 --> 00:03:47,080
،لو قُدّر لذاك الصّغير أن يُولد
،وعاش طويلًا بما يكفي ليَكبر

28
00:03:47,610 --> 00:03:51,450
.لكَان اليوم في مِثل سنّهم

29
00:03:53,220 --> 00:03:57,660
،كُنتَ الأسوأ بينهم

30
00:03:58,440 --> 00:04:01,750
،دائم التردّد
،لا تملك إيمانًا بنفسك

31
00:04:02,300 --> 00:04:04,790
.وتَغرق في الفشل دومًا

32
00:04:04,790 --> 00:04:07,910
.تُؤرّقك نظرة النّاس إليك

33
00:04:09,420 --> 00:04:13,850
أنت بعيدٌ كُلّ البُعد عن الرّجل
.المِثالي الّذي ينشده سيريزاوا كامو

34
00:04:17,600 --> 00:04:20,360
!سُحقًا
!ملأت نفسي غيظًا الآن

35
00:04:20,360 --> 00:04:23,360
كم أودّ أن أنهال عليه ضربًا
!وركلًا في هذه اللّحظة

36
00:04:29,490 --> 00:04:32,250
،تعال إلى هُنا
.سأَقوم بتنظيفك

37
00:04:37,070 --> 00:04:39,480
...ظننت أنّي آويته بمَحض الصّدفة

38
00:04:39,880 --> 00:04:44,120
!أيّها الفاشل
أَلا تُجيد حتّى صبّ الشّاي؟

39
00:04:44,120 --> 00:04:47,020
...قسوت عليه كثيرًا...

40
00:04:47,530 --> 00:04:50,110
تارو، ضع مزيدًا مِن القُوّة
.في خُطواتك

41
00:04:50,110 --> 00:04:51,540
.أ-أجل، يا سيّدي

42
00:04:52,100 --> 00:04:57,580
فعلت ذلك لإحساسي بالذّنب...
.لأنّي لم أرعَ طفلي

43
00:04:59,220 --> 00:05:02,130
لكن، إن كُنت أفعلها للتّكفير
،عن خَطيئتي

44
00:05:05,570 --> 00:05:11,020
فهَل كان سيَضرّني أن أحتضنه
ولو لمرّةٍ واحدة؟

45
00:05:15,130 --> 00:05:17,770
هل سأَنجو ممّا أنا فيه؟

46
00:05:18,180 --> 00:05:20,670
هل ذاك المُستقبل ممكنٌ؟

47
00:05:22,590 --> 00:05:23,720
.سأَعيش

48
00:05:25,200 --> 00:05:26,340
.أُريد أن أَعيش

49
00:05:41,710 --> 00:05:45,950
،سيريزاوا-سان
.جعلتك تنتظر طويلًا

50
00:05:50,970 --> 00:05:51,990
.الموت

51
00:05:54,810 --> 00:05:56,120
.أَطح برأسي

52
00:05:59,920 --> 00:06:02,630
آمل أن تكون أهلًا للثّقة
.في إتقان ذلك

53
00:06:02,960 --> 00:06:04,880
مَن تظنّ أنّك تُخاطب؟

54
00:06:11,530 --> 00:06:16,080
.أَرني مِيتةً تليق بـ سيريزاوا كامو

55
00:06:21,720 --> 00:06:23,190
.كلا

56
00:06:23,190 --> 00:06:25,060
ما الّذي أُفكّر فيه؟

57
00:06:25,570 --> 00:06:30,580
أَليس هذا المُستقبل الّذي أَردته
أكثر مِن كُلّ ما سواه؟

58
00:06:38,440 --> 00:06:43,050
صدقت، كم انتظرت هذه
.اللّحظة، يا سيّد كوندو

59
00:06:44,640 --> 00:06:46,220
.فَقدت صديقًا مات بذات الطّريقة

60
00:06:48,010 --> 00:06:51,680
إن كان مَوتك هُو التّضحية
...لأجل المُستقبل

61
00:06:52,650 --> 00:06:54,920
هل أَنهى حياته بنفسه؟

62
00:06:55,080 --> 00:06:55,920
،أجل

63
00:06:56,280 --> 00:06:59,680
.لكنّه خلّف وراءه أشياء كثيرةً

64
00:07:03,720 --> 00:07:05,520
مَن تُراك تكون يا هذا؟

65
00:07:05,520 --> 00:07:09,110
!أَلا تُميّز بين الصّديق والعدوّ؟

66
00:07:11,270 --> 00:07:12,400
.دَعنا نمرّ

67
00:07:20,620 --> 00:07:22,730
.هكذا يكون فِعل السّاموراي الحقيقيّ

68
00:07:22,730 --> 00:07:25,160
ماذا كان سيَحلّ بالمِيبورو لولاك؟

69
00:07:26,670 --> 00:07:28,120
.لن أَحيد بكُم عن الحقّ

70
00:07:28,860 --> 00:07:31,320
كان رجلًا شديد الذّكاء
.على نحو استثنائيّ

71
00:07:31,900 --> 00:07:34,920
،يامانامي
.أُريدك أن تحتفظ بهذه

72
00:07:38,980 --> 00:07:40,140
ما الّذي دَهاك؟

73
00:07:40,900 --> 00:07:43,640
.لن أنقاد لرَغبتك

74
00:07:50,020 --> 00:07:52,280
.أهلًا بكُم

75
00:07:52,620 --> 00:07:56,520
أتساءل إلى أيّ حدٍ كان
.كُلّ ما يجري مِن تدبيره

76
00:07:57,600 --> 00:07:58,880
!لا يهمّ ذلك

77
00:07:59,120 --> 00:08:03,130
!فلا شأن لنا به على الإطلاق

78
00:08:03,380 --> 00:08:05,960
،أرجوكِ اهدئي وأَصغي

79
00:08:06,540 --> 00:08:09,290
،هذه المسألة لا تَعنينا نحن فحسب
...أنتِ أيضًا لديكِ

80
00:08:09,290 --> 00:08:10,390
!كلا

81
00:08:10,390 --> 00:08:11,640
!كلا، محالٌ

82
00:08:11,640 --> 00:08:13,640
!لن أَبرح مكاني هذا

83
00:08:15,380 --> 00:08:18,720
،كُفّي عن العَويل
!أيّتها المرأة البَغيضة

84
00:08:19,490 --> 00:08:21,700
،يا للهول
.نَفد صبري وغَلبني غضبي

85
00:08:24,150 --> 00:08:26,800
.أرسلت إيتوساتو إلى فوشيمي

86
00:08:26,800 --> 00:08:28,730
ماذا؟ هل هِي بخيرٍ؟

87
00:08:28,920 --> 00:08:31,430
.الحقي بها وغَادري كيوتو

88
00:08:31,740 --> 00:08:36,040
أَلا ترغبين في بدء حياةٍ
جديدة بسلامٍ؟

89
00:08:45,920 --> 00:08:48,100
أظنّ أن بمَقدوركِ معرفة
الطّريق مِن هُنا؟

90
00:08:49,690 --> 00:08:50,450
.أجل

91
00:08:52,450 --> 00:08:56,360
إنّ مصير المِيبورو معقودٌ
.بهذه المُهمّة

92
00:08:56,830 --> 00:09:01,430
يجب أَلا يتسرّب خبر صِلتنا
.بما يحدث قطّ

93
00:09:02,610 --> 00:09:04,790
.لا يُمكننا السّماح لـ هيراما بالفِرار

94
00:09:05,630 --> 00:09:08,200
.أنا أَعتمد عليك يا هارادا-سان

95
00:09:10,040 --> 00:09:11,920
!عُد أدراجك يا هيراما

96
00:09:12,150 --> 00:09:15,120
!نازلني نِزالًا شريفًا

97
00:09:15,360 --> 00:09:18,170
أَلا تَبتغي القتال دفاعًا عن سيريزاوا؟

98
00:09:18,170 --> 00:09:20,020
أيّ نوعٍ مِن الرّفاق أنت؟

99
00:09:27,800 --> 00:09:29,510
هل تَبكي؟

100
00:09:29,510 --> 00:09:31,220
!هل هكذا تردّ له المَعروف؟

101
00:09:31,220 --> 00:09:32,400
ماذا؟

102
00:09:32,400 --> 00:09:36,520
لا تنسَ! لم يكُن لجماعة المِيبورو أن تكون
.على ما هِي عليه الآن لولا سيريزاوا-سينسي

103
00:09:36,520 --> 00:09:39,050
!لا أحد منكم يُدرك مَقامه الحقيقيّ

104
00:09:39,050 --> 00:09:42,180
إنّ موته سيَكون خسارةً
.فادحة للبلاد

105
00:09:42,720 --> 00:09:44,590
أَليس في قولك شيءٌ مِن المُبالغة؟

106
00:09:45,330 --> 00:09:49,200
هارادا، رَبطت مصيرك بالرّجل
.غير المُناسب

107
00:09:49,200 --> 00:09:51,660
أنا وحدي مَن يختار الشّخص
.الّذي أنحاز إليه

108
00:09:53,540 --> 00:09:54,500
!هذا غدرٌ وخِسّة في القتال

109
00:09:54,500 --> 00:09:55,620
!مُت

110
00:09:56,490 --> 00:09:57,860
!هيهات

111
00:09:58,530 --> 00:10:02,120
.سأَفضح دناءتك أمام المَلأ

112
00:10:02,120 --> 00:10:03,620
ستَفعل ماذا؟

113
00:10:06,800 --> 00:10:08,320
!إيّاك أن تنسى ذلك

114
00:10:19,090 --> 00:10:21,020
تبًا، أين اختفيت؟

115
00:10:21,020 --> 00:10:24,110
!انطق، اخرج إليّ يا هيراما

116
00:10:28,610 --> 00:10:32,160
.سُحقًا، فقدت أثره

117
00:10:37,900 --> 00:10:39,450
ماذا؟ ما الّذي جرى؟

118
00:11:02,960 --> 00:11:04,660
...ما هذا

119
00:11:06,430 --> 00:11:09,680
شيمادا، وارهِ التّراب في
.باطن الأرض

120
00:11:12,600 --> 00:11:13,600
.شينباتشي

121
00:11:14,310 --> 00:11:16,790
،لا أزال أَمقت طريقتك هذه

122
00:11:18,950 --> 00:11:21,850
لكن لا مفرّ لي مِن كتم هذا
.السّر حتّى يلُفّني الكَفن

123
00:11:23,340 --> 00:11:26,500
لا يُمكنني أن أَدعك تَنفرد
.بحمل هذا العبء

124
00:11:26,970 --> 00:11:29,400
.لذا دَعني أُشاطرك تَبعات ما حدث

125
00:11:34,380 --> 00:11:35,250
ما خطبك؟

126
00:11:35,250 --> 00:11:35,920
.لا شيء

127
00:11:37,090 --> 00:11:39,520
ساورني الفُضول حول ما يَفعله
.تلميذي الآن

128
00:11:53,120 --> 00:11:54,740
.طعناتك تحتاج إلى إتقانٍ

129
00:11:55,440 --> 00:11:56,270
!اللّعنة عليك

130
00:11:59,430 --> 00:12:03,120
هذا كُلّ ما عندك؟ هكذا
يكون إخلاصك لـ سيريزاوا؟

131
00:12:10,720 --> 00:12:12,160
.أَفرغ ما في جُعبتك كُلّه

132
00:12:12,580 --> 00:12:15,090
...سأَجعلك تَقذف ما في قلبك

133
00:12:15,500 --> 00:12:18,060
حتّى لا تبقى فيك ذرّةٌ
.واحدة مِن ندمٍ

134
00:12:21,710 --> 00:12:23,160
.هذا هُو سكن عائلة ياجي

135
00:12:23,410 --> 00:12:25,540
.إنّه مقرّ عمليات المِيبورو

136
00:12:30,060 --> 00:12:31,160
.وذلك تارو-كون

137
00:12:31,460 --> 00:12:35,440
إنّه يقوم... بمُختلف الأعمال
.الثّانوية هُنا

138
00:12:36,420 --> 00:12:38,250
،حين قابلته

139
00:12:38,250 --> 00:12:43,330
بدا خامد الرّوح، لدرجةٍ جعلتني
.أعجز عن معرفة ما يَدور في خُلده

140
00:12:48,620 --> 00:12:50,180
.أنا ذاهبٌ للشّرب

141
00:12:50,180 --> 00:12:54,430
.كان يَتبع سيريزاوا كظلّه

142
00:12:51,810 --> 00:12:54,430
.سينسي! مِعطفك

143
00:12:55,040 --> 00:12:56,470
!أَسرع به

144
00:12:57,800 --> 00:13:01,050
،لكن قبل أن أُدرك
.كان قد غدا عاملًا دؤوبًا

145
00:13:05,730 --> 00:13:07,320
.اغسل هذه أيضًا

146
00:13:09,010 --> 00:13:10,800
.حسنًا، نلتقي لاحقًا

147
00:13:14,730 --> 00:13:15,840
.أيّها الأحمق

148
00:13:17,650 --> 00:13:21,320
كان يلعن الجميع مِن خلف
.ظُهورهم باستثناء سيريزاوا

149
00:13:22,120 --> 00:13:23,710
،ولكن بعد ذلك
.جاء نيو

150
00:13:24,760 --> 00:13:26,920
تارو-كون، هل ترغب في مُمارسة
مصارعة السّومو معنا؟

151
00:13:26,920 --> 00:13:28,280
!محالٌ، لن أَفعل

152
00:13:29,610 --> 00:13:31,010
!هيّا أسرع

153
00:13:31,010 --> 00:13:34,080
.بدا أكثر حيويّةً بعد ذلك

154
00:13:34,790 --> 00:13:37,240
أستبعد أنّه كان يَنوي تعلّم
.فُنون السّيف بتاتًا

155
00:13:37,240 --> 00:13:38,210
...بَيد أنّه

156
00:13:40,120 --> 00:13:43,250
مُؤخّرًا، بدأ يتلقّى التّدريب
.على يَد ناغاكورا

157
00:13:44,050 --> 00:13:45,300
...ورُغم هذا

158
00:13:48,480 --> 00:13:49,360
!تبًا لهذا

159
00:13:48,480 --> 00:13:50,210
.تَوازنه مختلٌّ

160
00:13:50,740 --> 00:13:52,070
ويَعتمد في ضرباته على
.قُوّة ذراعيه فحسب

161
00:13:53,100 --> 00:13:55,820
إنّه لم يَنل ما يكفي
.مِن التّدريب بعد

162
00:13:56,400 --> 00:13:57,360
،لكن مع ذلك

163
00:13:59,350 --> 00:14:02,600
تأمّل كيف أَكسبته الرّغبة في
.حماية مَن يُحبّ قُوّةً بالغة

164
00:14:05,240 --> 00:14:09,990
،إن لم أَصل إلى سيريزاوا-سينسي
...فإنّه سوف... سوف

165
00:14:11,300 --> 00:14:14,000
!لن تُجدي نفعًا حتّى لو كُنت بجانبه

166
00:14:14,270 --> 00:14:16,150
،تنحَّ عن الطّريق
!دَعني أَمرّ

167
00:14:16,150 --> 00:14:18,710
ما بالك مُتمسّكًا بـ سيريزاوا
!إلى هذا الحدّ؟

168
00:14:18,710 --> 00:14:24,420
أَحاطتك عائلة ياجي ورِفاق
!كوندو برعايتهم أيضًا

169
00:14:25,960 --> 00:14:27,680
.ولا تنسَ نيو كذلك

170
00:14:28,590 --> 00:14:29,650
.أو أنا

171
00:14:29,650 --> 00:14:31,400
.أنتم لا تُدركون مَقصدي

172
00:14:32,520 --> 00:14:33,760
...سينسي

173
00:14:36,320 --> 00:14:40,310
،قبل أن يظهر أمام النّاس
.يتوقّف لبُرهةٍ خاطفة

174
00:14:43,890 --> 00:14:48,040
تلك هِي اللّحظة الّتي يستجمع فيها
.رباطة جأشه ليَغدو سيريزاوا كامو

175
00:14:53,460 --> 00:14:56,040
،أنا وَحدي مَن يعلم ذلك
.لأنّني كُنت أُلازمه كظلّه

176
00:14:56,720 --> 00:15:00,740
،أُحبّ هذا الجانب فيه
.وأُقدّره لأَجله

177
00:15:02,610 --> 00:15:04,640
إنّه ينشرح للحياة الصّاخبة
،وسط الرّفاق

178
00:15:05,140 --> 00:15:07,250
وكم بدت السّعادة جليّةً
...على وجهه حين كان

179
00:15:08,420 --> 00:15:10,430
!يُقاسم الجميع طعامهم وشرابهم

180
00:15:14,970 --> 00:15:17,720
.قضى جُلّ عُمره محاطًا بالنّاس

181
00:15:20,910 --> 00:15:24,220
.لكنّني موقنٌ أنّه يَعتزم الموت وحيدًا

182
00:15:27,480 --> 00:15:33,180
لذا، أَلا يستحقّ أن يبقى معه رفيقٌ حتّى
النّهاية، وإن كُنت أنا هذا الرّفيق الوحيد؟

183
00:15:42,360 --> 00:15:43,680
.أيّها الأحمق

184
00:15:44,600 --> 00:15:47,080
.إنّك لبَالغ الحُمق لا يُجاريك فيه أحدٌ

185
00:15:51,430 --> 00:15:54,980
لم يَعد بمَقدوري الصّمود
.أكثر، وقد نَفد وقتي

186
00:15:56,140 --> 00:15:57,350
،هذا جيّدٌ بما فيه الكِفاية
أَليس كذلك؟

187
00:15:59,340 --> 00:16:04,350
أَنصت، في النّزال الحقيقيّ، أَمسك سيفك
.بحيث تقصر مسافة نصله الظّاهرة للخصم

188
00:16:04,650 --> 00:16:08,790
قـ-قصيرًا؟
.لكن حينها لن تَبلغه ضرباتي

189
00:16:08,790 --> 00:16:11,360
أَلن يجعلني ذلك في موقفٍ
حرج للغاية؟

190
00:16:11,570 --> 00:16:14,280
،لا ضَير
.قاتل على هذا النّحو

191
00:16:15,100 --> 00:16:17,370
،فمَا هذا السّنونو إلّا صَيدٌ واحد

192
00:16:17,370 --> 00:16:19,760
وعليك إغراؤه بالطُّعم
.قبل أن يبدأ بالتّحليق

193
00:16:27,220 --> 00:16:29,790
،ناغاكورا
.حان وقت استخدامها

194
00:16:34,280 --> 00:16:36,240
ما هذه الوضعيّة؟

195
00:16:36,580 --> 00:16:39,030
هل هذه فِكرته عن السّلاح
.السّري؟ أيّها الأحمق

196
00:16:40,480 --> 00:16:42,570
.لن تنال منّي أبدًا مِن تلك المسافة

197
00:16:42,570 --> 00:16:44,760
أَلا تعرف حتّى حُدود مَداك؟

198
00:16:48,280 --> 00:16:50,000
.غاب عن أذهانكم شخصٌ

199
00:16:51,560 --> 00:16:52,620
.تارو

200
00:16:52,910 --> 00:16:56,270
سيَظلّ إلى جانب سيريزاوا
.حتّى الرّمق الأخير

201
00:16:57,450 --> 00:16:59,920
.هاجيمي، هذه مسؤوليّتك

202
00:17:00,060 --> 00:17:01,870
هل تُريد منّي قَتله؟

203
00:17:01,870 --> 00:17:05,120
،لا تهزأ في موقفٍ كهذا
!إذن، تكفّل أنت بـ تارو

204
00:17:05,120 --> 00:17:06,820
.وأنا سأُجهز على سيريزاوا

205
00:17:07,560 --> 00:17:08,500
.ليس هذا ما أَرمي إليه

206
00:17:10,120 --> 00:17:11,040
ما مَقصدك إذن؟

207
00:17:13,590 --> 00:17:15,350
.أُريد منك أن تُنقذ تارو

208
00:17:17,920 --> 00:17:19,350
.اصمت

209
00:17:20,600 --> 00:17:21,900
إنّها تُمطر بغزارةٍ، أَليس كذلك؟

210
00:17:24,200 --> 00:17:25,890
أتسائل إن كان المطر سيَتوقّف
.عند حُلول اللّيل

211
00:17:26,290 --> 00:17:27,420
.لا عِلم لي

212
00:17:30,630 --> 00:17:33,040
ابذل قُصارى جُهدك
.مِن أجل تارو-كون

213
00:17:37,680 --> 00:17:39,300
.أنا أُدرك ذلك أتمّ الإدراك

214
00:17:40,020 --> 00:17:42,210
،ومع وَضع كُلّ هذا في الحُسبان

215
00:17:45,600 --> 00:17:47,880
سأَجعله يتمنّى لو أنّه
!لم يُواجهني قطٌّ

216
00:17:53,210 --> 00:17:58,380
ما زِلت في بداية تدريبك، ولن تَقوى
.على هزيمة شخصٍ بارع في نزالٍ شَريف

217
00:17:59,290 --> 00:18:04,300
.سيُدرك خصمك مدى ضرباتك سريعًا

218
00:18:04,870 --> 00:18:09,890
لذا، أَنزل يدك اليُمنى للأسفل
.دُون أن تكشف قَبضتك

219
00:18:11,230 --> 00:18:14,470
.واجعلها عند طَرف المقبض تمامًا

220
00:18:14,470 --> 00:18:18,410
هكذا، سيَمتدّ نصلك بمَقدار
.راحة يدٍ

221
00:18:19,230 --> 00:18:22,390
.وحينها، سيَنطلق السّنونو

222
00:18:31,920 --> 00:18:32,900
.السّنونو

223
00:18:41,810 --> 00:18:42,840
!لم أُصبه

224
00:18:46,380 --> 00:18:50,720
إذا بَادرك الخصم، فاستلّ سيفك
.دُون تردّدٍ حين يرتدّ للخلف

225
00:18:51,120 --> 00:18:52,520
.تعلّم بجسدك

226
00:18:53,440 --> 00:18:55,240
.واجعل استلال السّيف غريزةً فيك

227
00:18:56,210 --> 00:18:59,590
.فهَذا النّصل هُو سبيل نجاتك

228
00:19:01,640 --> 00:19:02,820
.رُدّ الضّربة بمثلها

229
00:19:02,820 --> 00:19:04,700
!كلا، توقّف

230
00:19:05,310 --> 00:19:06,390
!تنحَّ

231
00:19:09,700 --> 00:19:11,340
!أرجوك تنحَّ

232
00:19:26,600 --> 00:19:28,060
.بطيءٌ جدًا

233
00:19:28,060 --> 00:19:30,600
.أنت بطيءٌ جدًا يا كوندو-سان

234
00:19:31,100 --> 00:19:34,110
أعتقد أنّ الوقت قد حان
.لنَضع خاتمةً لهذا

235
00:19:34,980 --> 00:19:36,840
.أجل، يا سيريزاوا-سان

236
00:19:43,880 --> 00:19:45,920
!استعدّ للمَوت

237
00:19:59,010 --> 00:20:03,210
،هذا هُو كوندو الّذي عَهدته
.ضربةٌ موفّقة بالفعل

238
00:20:12,190 --> 00:20:13,020
،نيمي-سان

239
00:20:13,890 --> 00:20:15,770
هل لي أن أَستفسر
عن أمرٍ خِتاميّ؟

240
00:20:16,320 --> 00:20:20,630
دأبت أنت وسيريزاوا-سان على
.إثارة الصّخب لزمنٍ طويل

241
00:20:21,140 --> 00:20:25,440
،سيريزاوا-سان يملّ سريعًا
.فيُثير المَتاعب ثُمّ يمضي لغيرها

242
00:20:26,440 --> 00:20:30,920
لكنّك ذكرت لي أنّك أحببت
،كيوتو و المِيبورو

243
00:20:31,520 --> 00:20:33,320
وترغب في المُكوث معنا
.أمدًا أطول

244
00:20:34,440 --> 00:20:38,410
ما الّذي ميّز المِيبورو
عن كُلّ ما مرّ بكُما؟

245
00:20:40,360 --> 00:20:41,970
.تبدّل سيريزاوا هُنا

246
00:20:44,800 --> 00:20:48,530
،كان ذاك الرّجل طيّب النّفس
.بشوشًا، كما كُنت أَهواه أن يكون

247
00:20:58,320 --> 00:21:00,060
...تقصد أنّ

248
00:21:00,280 --> 00:21:00,940
.أجل

249
00:21:02,910 --> 00:21:05,000
لا أَحمل في قلبي سِوى
.الامتنان له

250
00:21:24,810 --> 00:21:27,830
كلا، سأَبقى لأرى هذا
.حتّى المُنتهى

251
00:21:29,360 --> 00:21:33,190
سأَشهد الخاتمة ولن تَمحوها
.ذاكرتي قطعًا

252
00:21:34,680 --> 00:21:36,440
.هذا هُو سيريزاوا-سان

253
00:21:41,660 --> 00:21:42,590
...هذا هُو

254
00:21:43,580 --> 00:21:45,130
.سيريزاوا كامو

255
00:23:21,150 --> 00:23:25,890
،نيمي، بل إيوري
.أَزفت السّاعة

256
00:23:26,560 --> 00:23:30,870
تعهّدت لك بخاتمةٍ تَليق
.باسم سيريزاوا كامو

257
00:23:31,130 --> 00:23:33,680
.وهَا هِي النّهاية تقترب رُويدًا

258
00:23:34,050 --> 00:23:36,760
،لا يَسكن نفسي نَدمٌ
.ولا تُخالجني حَسرةٌ

259
00:23:37,040 --> 00:23:40,190
.لم أُخلّف ورائي عملًا لم يُنجز

260
00:23:40,190 --> 00:23:42,330
أَترى هذا يا نيو؟

261
00:23:42,650 --> 00:23:45,740
هذا هُو المُستقبل الّذي رَجوته
.أكثر مِن أيّ شيءٍ آخر

262
00:23:46,590 --> 00:23:49,070
."الحلقة القادمة: "العهدُ الأَزرق