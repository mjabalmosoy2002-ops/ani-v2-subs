1
00:00:05,140 --> 00:00:06,060
...هذا هُو

2
00:00:07,440 --> 00:00:09,030
.سيريزاوا كامو

3
00:01:41,570 --> 00:01:43,710
!ما زِلت في البداية فحسب

4
00:02:14,780 --> 00:02:17,320
.إنّه يُجاريني دُون أن يَنطق بكلمةٍ

5
00:02:17,660 --> 00:02:23,360
:أيّ رجلٍ آخر كان سيَتساءل
"ما الجدوى مِن هذا القتال العَبثيّ؟"

6
00:02:23,360 --> 00:02:25,450
.لكنّه ليس كغَيره

7
00:02:26,320 --> 00:02:31,040
،طَاوعني في صمتٍ
.هذه شِيمتك المَعهودة

8
00:02:31,790 --> 00:02:35,990
،وهِي سبب إعجابي بك
.هذا ما وَجدته فيك

9
00:02:35,990 --> 00:02:38,720
.جوهر السّاموراي الّذي لا يُحسن التصنّع

10
00:02:39,460 --> 00:02:43,440
،بلغتُ مِن الإتقان ما أَرهق نفسي
.أمّا أنت، فتَملك ما افتقرت إليه

11
00:02:44,570 --> 00:02:46,580
،زهرةُ البَراءة

12
00:02:47,160 --> 00:02:49,660
.ولَهيب الشّغف

13
00:02:50,760 --> 00:02:53,440
...مزايا حظيتُ بها يومًا

14
00:02:54,310 --> 00:02:58,240
.وما زِلت أنت تَتعهّد بالتمسّك بها

15
00:03:00,250 --> 00:03:02,440
...إن أنا هَجمت مِن وضعيّةٍ عالية

16
00:03:05,940 --> 00:03:06,920
أَترى ذلك؟

17
00:03:07,540 --> 00:03:11,540
.هجومٌ مُضادّ رَتيب لا غرابة فيه

18
00:03:12,520 --> 00:03:15,920
لكنّه كفيلٌ بأن يُظهر مَدى
.أهميّة الأساسيّات

19
00:03:16,880 --> 00:03:20,920
يبدو جليًا كم كابدت
.مِن أيّامٍ في صقلها

20
00:03:23,450 --> 00:03:30,560
،كيف لي، أنا سيريزاوا كامو
أن أُضاهي مَقامك؟

21
00:03:38,170 --> 00:03:43,280
لم تكُن لديك خطّةٌ للظّفر
.بزَعامة المِيبورو

22
00:03:44,010 --> 00:03:49,250
،ولم تأتِ بمُعجزةٍ
.ومع ذلك تَهافت الرّجال عليك

23
00:03:53,120 --> 00:03:55,170
!هل هذا تَدبيرُ مجموعة هيجيكاتا؟

24
00:03:56,370 --> 00:03:58,020
.كلا، لا أظنّ ذلك

25
00:03:58,540 --> 00:04:02,210
،مهما كانت غايات الآخرين
.فقد وَقفت أنت بجانبي

26
00:04:03,080 --> 00:04:06,760
سيريزاوا-سان، إنّي لأَحمل
.لك امتنانًا عميقًا

27
00:04:07,210 --> 00:04:09,900
فلا يزال جَمعٌ مِن رجالنا يَنظرون
.إليك بإجلالٍ حتّى اللّحظة

28
00:04:10,170 --> 00:04:14,160
كان بوسعك أن تشقّ صفّ المِيبورو
،وتَخوض غِمار الحرب إن شِئت

29
00:04:14,770 --> 00:04:18,610
،لكنّك نأيت بنا عن صراعٍ شامل

30
00:04:18,610 --> 00:04:20,770
.وحَقنت دماءً غالية

31
00:04:23,400 --> 00:04:24,560
.إنّ فِعلك هذا لجديرٌ بالفَخر

32
00:04:27,710 --> 00:04:32,920
كُلّ ما أردته فحسب ألاّ يُعكّر
!صفو هذه اللّحظة العظيمة أحدٌ

33
00:04:32,920 --> 00:04:34,840
!كُنتَ ساموراي بحقٍ

34
00:04:35,130 --> 00:04:36,840
!وكُنتُ أَتوق لأَن أقتفي أثرك

35
00:04:36,840 --> 00:04:38,720
!كفى حديثًا

36
00:04:43,220 --> 00:04:44,300
!سيريزاوا-سان

37
00:04:49,520 --> 00:04:54,330
أنا ساموراي حقيقيٌّ؟

38
00:04:55,350 --> 00:04:58,850
،كلا يا سيّد كوندو
.أنت مخطئٌ

39
00:05:01,140 --> 00:05:04,070
تلك فِطرتك السّليمة تَهذي
.بهذا القول

40
00:05:04,780 --> 00:05:07,280
،يا لك مِن ساذجٍ

41
00:05:07,280 --> 00:05:09,580
.لا تَفقه مِن الحقيقة شيئًا

42
00:05:10,240 --> 00:05:12,220
،لست أنا ذاك الرّجل

43
00:05:13,150 --> 00:05:15,340
.بل أنا محضُ دورٍ هامشيّ

44
00:05:16,120 --> 00:05:18,150
لست إلّا جسرًا لعُبور
.غيري لا أكثر

45
00:05:18,910 --> 00:05:20,000
،سيريزاوا-سان

46
00:05:20,780 --> 00:05:23,090
.كان عليّ أنا أن أحمل هذا العِبء

47
00:05:34,500 --> 00:05:39,340
،أنت لا تَصلح لأَن تكون شرّيرًا
.فطَبيعتك لا تَقبل ذلك

48
00:05:39,350 --> 00:05:42,970
،ابقَ كما أنت، نقيًا وصادقًا
.فلا داعي لأَن تتبدّل

49
00:05:43,940 --> 00:05:46,120
.والآن، أصغِ إليّ جيّدًا

50
00:05:46,120 --> 00:05:51,770
عاشرتُ صُنوفًا مِن البشر في
.حياتي، وكانوا جميعًا زيفًا

51
00:05:51,770 --> 00:05:57,310
وأنا سيريزاوا كامو أَرهن
!حياتي على هذا القول

52
00:05:57,810 --> 00:05:59,280
...ليس سِواك

53
00:05:59,880 --> 00:06:03,520
!أنت وحدك السّاموراي بحقٍ

54
00:06:09,190 --> 00:06:13,840
،إيّاك أن تنسى
.فأَنت أملي الأَوحد

55
00:06:14,810 --> 00:06:16,600
.أنت حُلمي

56
00:06:18,670 --> 00:06:25,310
كُلّ ما اقترفته جماعة المِيبورو مِن خطايا
.كان مِن صَنيعي أنا ونيمي فحسب

57
00:06:26,990 --> 00:06:28,240
...المِيبورو

58
00:06:29,830 --> 00:06:31,570
.ستُبعث مِن جديدٍ

59
00:06:31,800 --> 00:06:33,330
!وما هذه إلّا البداية

60
00:06:33,640 --> 00:06:34,830
!كُن أكثر صلابةً

61
00:06:35,160 --> 00:06:36,830
!وأعظم شأنًا

62
00:06:37,410 --> 00:06:42,050
،كوندو
!أنت وحدك السّاموراي الحقيقيّ

63
00:06:43,210 --> 00:06:46,140
!وأمانة المِيبورو معقودةٌ بنَاصيتك

64
00:06:52,820 --> 00:06:53,730
...المِيبورو

65
00:06:55,180 --> 00:06:56,600
.في مأمنٍ معي

66
00:06:58,850 --> 00:07:00,360
.فلا تخشَ شيئًا

67
00:07:05,760 --> 00:07:09,650
،امضِ قُدمًا يا سيّد كوندو
.فأَنت تعلم ما يَنبغي عليك فِعله

68
00:07:10,560 --> 00:07:11,540
وماذا عَساي أن أفعل؟

69
00:07:12,390 --> 00:07:15,620
،بَقاؤك هُنا محالٌ
أَليس كذلك؟

70
00:07:15,620 --> 00:07:20,840
فإن ذَاع خبر انشقاقنا، فلَن نكون في أعينهم
.سِوى شرذمةٍ مِن الصّعاليك مرّةً أُخرى

71
00:07:21,680 --> 00:07:23,220
...كُنت تعلم، ورُغم ذلك

72
00:07:24,420 --> 00:07:27,130
،نِلنا كفايتنا مِن اللّهو
!هيّا انطلق

73
00:07:27,630 --> 00:07:29,240
.ارحل

74
00:07:41,450 --> 00:07:42,520
.أرجوك، ارحل

75
00:07:46,720 --> 00:07:47,580
.اعذرني

76
00:07:55,680 --> 00:08:01,890
،صَمدت حتّى النّهاية
.وبَذلت رُوحي حتّى التّلاشي

77
00:08:07,320 --> 00:08:12,160
حسنًا يا نيو؟
كيف رأيت نَهجي في الحياة؟

78
00:08:13,580 --> 00:08:15,600
.أراه نهجًا مهيبًا

79
00:08:16,480 --> 00:08:18,600
ما كان لبشرٍ غيرك أن
.يَحيا كما حَييت أنت

80
00:08:22,040 --> 00:08:26,600
،الحياة والموت سيّان

81
00:08:26,600 --> 00:08:29,640
.والعِبرة بالخَواتيم دومًا

82
00:08:30,490 --> 00:08:34,320
.لم تبقى بي طاقةٌ لشقّ بَطني

83
00:08:35,400 --> 00:08:39,800
إنّه لعارٌ على السّاموراي أن
.يَنزف حتّى الفناء هكذا

84
00:08:40,130 --> 00:08:44,590
.أنا بحاجةٍ لمَن يمنحني الخَلاص

85
00:08:47,040 --> 00:08:48,260
.أنا أُدرك ذلك

86
00:09:01,530 --> 00:09:03,520
...أرى

87
00:09:04,350 --> 00:09:06,420
.أنّك ستُجهز عليّ إذن

88
00:09:07,660 --> 00:09:11,960
على المَرء أن يَنقش نهج حياته
.في صفحات التّاريخ

89
00:09:11,960 --> 00:09:14,800
.هذا ما لقّنني إيّاه والدي

90
00:09:17,720 --> 00:09:21,530
،ليس لي والدٌ
.ولن أعرفه حتّى إن أَبصرته

91
00:09:23,650 --> 00:09:25,550
هكذا إذن؟

92
00:09:26,880 --> 00:09:33,920
هل... هل تمكّنتُ مِن سدّ
فراغ غيابه؟

93
00:09:41,550 --> 00:09:46,900
،كُنتَ لي بمثابة الوالد
...والعَمّ، والمُعلّم

94
00:09:47,970 --> 00:09:49,350
.وكُنتَ كالجَبل شُموخًا

95
00:09:51,440 --> 00:09:53,440
كالجَبل، أَليس كذلك؟

96
00:09:53,680 --> 00:09:57,400
.هذا أسمى مديحٍ كُنت أَرجوه

97
00:09:57,630 --> 00:10:01,070
.نيو، لا تَضلّ سبيلك

98
00:10:01,070 --> 00:10:03,930
.على الرّجل أن يعيش لأَجل الضّعفاء

99
00:10:04,370 --> 00:10:07,830
.وأنت في جوهرك تُدرك هذا يقينًا

100
00:10:08,400 --> 00:10:13,500
،عِشتُ مِلء إرادتي
.وسِرتُ خلف ما أَملاه عليّ قلبي

101
00:10:14,400 --> 00:10:20,140
،كانت حياةً طيّبة
...ولو كان بمَقدوري

102
00:10:21,090 --> 00:10:23,200
.إنّ مَسار الأرواح لولبيّ

103
00:10:23,700 --> 00:10:27,100
يموت البَشر ثُمّ يُبعثون رُضّعًا
.مِن جديدٍ، وهكذا تدور الدّائرة

104
00:10:42,480 --> 00:10:43,680
.افعلها

105
00:10:53,270 --> 00:10:54,880
.وأَسدِ إليّ هذا المَعروف

106
00:11:07,410 --> 00:11:09,440
.لا يَسعني تصديق أنّك نَطحتني

107
00:11:12,920 --> 00:11:15,440
لم أَقوَ على كبح نصلي
.بعد أن أَشرعته

108
00:11:16,460 --> 00:11:18,460
.فقد كانت استجابة جَسدي أقوى

109
00:11:19,030 --> 00:11:21,030
.كانت غريزة السّاموراي

110
00:11:21,310 --> 00:11:23,540
!كلا، توقّف

111
00:11:24,160 --> 00:11:25,320
!تنحَّ

112
00:11:26,530 --> 00:11:28,080
!أرجوك تنحَّ

113
00:11:32,680 --> 00:11:35,230
،شُكرًا لك لأنّك تفاديتها

114
00:11:36,520 --> 00:11:39,420
لولا ذلك لنَدمت طيلة
.ما تبقّى مِن عُمري

115
00:11:42,100 --> 00:11:44,370
،لست خبيرًا في هذه الأمور

116
00:11:45,550 --> 00:11:49,050
ولكن لعلّ ما أَراد سيريزاوا
...تلقينك إيّاه حقًا

117
00:11:50,120 --> 00:11:52,810
.هُو القُوّة على الاستمرار في الحياة

118
00:11:59,140 --> 00:12:03,660
والآن، هل تُسخّر تلك القُوّة
...لأَجل ضُعفاء كيوتو

119
00:12:04,680 --> 00:12:06,800
جنبًا إلى جنبٍ معي؟

120
00:12:40,610 --> 00:12:43,570
العالم الّذي أحيا فيه
.ليس طاهرًا ولا بهيًا

121
00:12:49,100 --> 00:12:50,270
.بل هُو عالمٌ قاسٍ

122
00:12:54,160 --> 00:12:57,800
.ولا سبيل للنّجاة حيثما وَلّينا وجوهنا

123
00:13:06,040 --> 00:13:07,470
،حين انتهى الصّراع

124
00:13:09,400 --> 00:13:13,300
مَن تُراه قد أَردى سيريزاوا قتيلًا؟

125
00:13:17,890 --> 00:13:20,140
هل كان هارادا-سان؟
أم يامانامي-سان؟

126
00:13:21,650 --> 00:13:24,670
،على أيّ حالٍ
.كُتبت النّهاية الآن

127
00:13:25,170 --> 00:13:26,870
.كلا، ليس بعد

128
00:13:28,120 --> 00:13:30,390
.لن نَدع موت سيريزاوا يذهب هباءً

129
00:13:36,760 --> 00:13:39,000
،هيجيكاتا-سان
.ثمّة أشخاصٌ قادِمون

130
00:13:41,470 --> 00:13:43,560
.إنّهم أنتم، المُفتّشون

131
00:13:44,720 --> 00:13:48,960
هل هذا سـ-سيريزاوا صريعًا هُنا؟

132
00:13:54,050 --> 00:13:55,680
ما الّذي حدث بحقّ الجحيم؟

133
00:13:55,990 --> 00:13:57,680
.نالت منه تشوشو

134
00:13:59,150 --> 00:14:02,350
.اغتاله رُونين مِن المُتطرّفين

135
00:14:03,850 --> 00:14:07,020
احملوه على لوحٍ خشبيّ
.إلى دار مايكاوا

136
00:14:07,810 --> 00:14:09,450
،وأنت يا أسانو

137
00:14:10,640 --> 00:14:12,310
،زَاولت الطّب سابقًا
أَليس كذلك؟

138
00:14:12,660 --> 00:14:16,490
افحص الجُثّة ودَوّن تقريرًا
.رسميًا لآيزو

139
00:14:17,720 --> 00:14:19,140
—مَن تُراك تكون حتّى تُملي علينا

140
00:14:19,140 --> 00:14:19,920
.هاياشي-سان

141
00:14:22,420 --> 00:14:23,800
.سوسومو

142
00:14:26,430 --> 00:14:27,580
.سنَبدأ في ذلك على الفَور

143
00:14:38,200 --> 00:14:39,150
،معذرةً

144
00:14:43,990 --> 00:14:46,140
تناهى إلى مَسامعي أنّ
.لُصوصًا قد اقتحموا داركم

145
00:14:46,800 --> 00:14:49,110
هل بدّلا ملابسهما في دار مايكاوا؟

146
00:14:50,110 --> 00:14:51,720
.يَسرّني أن أراكم بخيرٍ

147
00:14:51,720 --> 00:14:55,040
بالمُناسبة، هل صَادف أن أبصرتم
أيًا مِن الجُناة؟

148
00:14:56,500 --> 00:14:58,040
.لم نُبصر شيئًا

149
00:14:58,040 --> 00:15:02,540
سَددت آذاني أنا وصِغاري
.وأغمضنا أعيننا بإحكامٍ

150
00:15:02,860 --> 00:15:04,300
.لا عِلم لنا بأيّ شيءٍ

151
00:15:05,930 --> 00:15:06,920
هكذا إذن؟

152
00:15:08,580 --> 00:15:09,920
هل أُصيب يو-بو بأذىً؟

153
00:15:11,320 --> 00:15:14,390
،أجل، في ساقه
.لكن الإصابة ليست بليغةً

154
00:15:16,840 --> 00:15:19,910
.لا بُدّ أنّ سيفي قد خدشه

155
00:15:20,670 --> 00:15:22,400
.لا داعي للقلق

156
00:15:22,400 --> 00:15:26,400
.سيَعود للرّكض بعد أيّامٍ قلائل

157
00:15:29,110 --> 00:15:29,900
.اعتنوا بأَنفسكم

158
00:15:33,280 --> 00:15:37,910
لدينا رجالٌ آخرون يَفحصون
.الدّار الرئيسيّة، فلتَطمئنوا

159
00:15:38,520 --> 00:15:40,060
هُنا أيضًا؟

160
00:15:41,980 --> 00:15:43,290
.المكان مُضرجٌ بالدّماء

161
00:15:47,820 --> 00:15:49,500
.طعنةٌ بارعة

162
00:15:50,680 --> 00:15:52,140
.كُنت مُوقنًا بعَدم منطقيّة ما جرى

163
00:15:52,790 --> 00:15:54,480
ما مَقصدك؟

164
00:15:55,480 --> 00:15:57,380
لا أجد أثرًا لـ نيو-كون
.في أيّ مكانٍ

165
00:15:57,380 --> 00:15:59,340
.أجل، نيو

166
00:15:59,340 --> 00:16:00,710
أين تَوارى ذاك الفتى؟

167
00:16:04,130 --> 00:16:06,350
،سُحقًا
.لا يُمكنني العُثور عليه

168
00:16:06,350 --> 00:16:08,270
فلنَقم بجولةٍ تفقديّة حول
.مَعبد ميبو

169
00:16:11,590 --> 00:16:15,440
أسانو، ماذا قصدت بقَولك إنّ
ثمّة تفاصيل غير منطقيّةٍ؟

170
00:16:17,390 --> 00:16:22,500
أعتقد أنّ الصّرعى في دار ياجي
.قد قُضي عليهم بأيدي سيّافين مَهرةٍ

171
00:16:22,670 --> 00:16:25,060
.أجل، أَكاد أُجزم بذلك

172
00:16:25,060 --> 00:16:26,880
ونحن نعلم مَن هُم أُولئك
.المَهرة الَذين فعلوها

173
00:16:27,040 --> 00:16:28,960
...هذا جليٌّ، بَيد أنّ

174
00:16:30,040 --> 00:16:32,900
الجُرح الّذي أنهى حياة
.سيريزاوا-سان مختلفٌ تمامًا

175
00:16:34,380 --> 00:16:38,360
فلا يُمكن لسيّافٍ خَبير أن يُسدّد طعنةً
.كتلك الّتي تمتدّ مِن عُنقه حتّى صَدره

176
00:16:38,360 --> 00:16:39,270
ماذا؟

177
00:16:39,480 --> 00:16:45,010
لم يكُن هيجيكاتا-سان أو أوكيتا-سان
.مَن سدّدها، نَاهيك عن القائد كوندو

178
00:16:45,770 --> 00:16:47,980
،إذن
مَن تُراه قتله بحقّ الجحيم؟

179
00:16:47,980 --> 00:16:50,160
.إيّاك أن تَدّعي أنّهم رجال تشوشو

180
00:16:50,160 --> 00:16:52,400
—كلا، بل أَراني أَميل إلى

181
00:16:52,890 --> 00:16:53,650
.ها هُو ذا

182
00:16:55,640 --> 00:16:56,580
نيو؟

183
00:17:02,240 --> 00:17:03,860
هل أنت بخيرٍ؟

184
00:17:03,860 --> 00:17:05,210
هل تعرّضت لهُجومٍ؟

185
00:17:09,410 --> 00:17:10,210
...يا رِفاق

186
00:17:10,430 --> 00:17:12,610
تَماسك، هل مسّك مكروهٌ؟

187
00:17:12,920 --> 00:17:14,870
.كلا، أنا بخيرٍ

188
00:17:14,870 --> 00:17:16,480
ما بَالك إذن؟

189
00:17:17,810 --> 00:17:22,090
شعرت برغبةٍ في الاسترخاء
.تحت المَطر فحسب

190
00:17:22,090 --> 00:17:23,500
هل هذه إحدى تُرّهات سِنّ المُراهقة؟

191
00:17:23,500 --> 00:17:25,030
.حسنًا، فلنَتّجه إلى هُناك

192
00:17:28,710 --> 00:17:33,600
تفضّل، هذا ماءٌ ساخن، أَيقظت
.أحد الكَهنة ليُعدّه لك، اشربه لتَدفأ

193
00:17:33,920 --> 00:17:35,390
.شُكرًا جزيلًا لك

194
00:17:44,830 --> 00:17:45,830
.هذا ما كُنت أَحتاجه

195
00:17:48,080 --> 00:17:50,260
،هل هُناك ما يُزعجك
يا نيو-كون؟

196
00:17:50,260 --> 00:17:50,960
!يا هذا

197
00:17:51,460 --> 00:17:52,630
.كلا، لا شيء

198
00:17:56,380 --> 00:17:57,200
.لا شيء على الإطلاق

199
00:18:06,840 --> 00:18:09,230
يبدو أنّ القائد سيريزاوا
.قد تعرّض لهُجومٍ

200
00:18:11,630 --> 00:18:12,860
حقًا؟

201
00:18:15,040 --> 00:18:16,240
،أنا آسفٌ

202
00:18:17,720 --> 00:18:19,820
هل تَدعونني وحدي لبُرهةٍ؟

203
00:18:23,560 --> 00:18:24,960
ماذا دَهاك؟

204
00:18:24,960 --> 00:18:26,420
ما الّذي حلّ بك؟

205
00:18:28,410 --> 00:18:30,920
إلى أين نحن ذاهبون؟
!أسانو

206
00:18:31,520 --> 00:18:33,720
.سأَذهب لأَتحدّث إلى هيجيكاتا-سان

207
00:18:35,240 --> 00:18:36,540
!تريّث، انتظر قليلًا

208
00:18:36,540 --> 00:18:39,320
!لا يُمكننا تركهم يَفلتون بفِعلتهم

209
00:18:40,200 --> 00:18:44,170
،إنّهم يَسعون لطمس الحقيقة برمّتها
.رُغم أنّهم هُم مُرتكبوها

210
00:18:44,170 --> 00:18:46,120
!هذا ليس صوابًا

211
00:18:47,520 --> 00:18:49,940
.سوف يَقتلونك

212
00:18:49,940 --> 00:18:51,160
!فليَفعلوا

213
00:18:51,160 --> 00:18:54,360
غدوت طبيبًا لأنّني أردت
!صَون أمن كيوتو

214
00:18:54,760 --> 00:18:57,640
!ولهذا السّبب تطوّعت في المِيبورو

215
00:18:58,790 --> 00:19:03,240
،أسانو-سينسي
.أنت أشدّ عِنادًا ممّا خِلتك

216
00:19:03,240 --> 00:19:05,240
عَنيدٌ؟

217
00:19:05,240 --> 00:19:07,840
أنت مَن يَهذي بما لا يُعقل
.يا هاياشي-سان

218
00:19:09,760 --> 00:19:11,750
!نحن مُفتّشون

219
00:19:11,750 --> 00:19:15,340
أَليس كَشف الحقيقة صميم عَملنا؟

220
00:19:16,310 --> 00:19:18,340
مَن المُستفيد مِن هذا؟

221
00:19:20,240 --> 00:19:24,440
لا ريب أنّ لـ نيو يدٌ
.في هذه المَعمعة بشكلٍ ما

222
00:19:25,200 --> 00:19:27,660
لكن ما الفَائدة مِن كشف سِتره؟

223
00:19:28,200 --> 00:19:30,970
مـ-ما الّذي تَرمي إليه؟

224
00:19:31,260 --> 00:19:34,980
.كَشف الحقيقة لن يُنجي أحدًا

225
00:19:35,530 --> 00:19:37,980
.لـ-لكن التّستر إثمٌ

226
00:19:38,200 --> 00:19:39,240
.هكذا يَزعمون

227
00:19:39,980 --> 00:19:41,240
.سنَكون شُركاء في الجُرم

228
00:19:41,450 --> 00:19:42,620
.لا أُبالي

229
00:19:43,040 --> 00:19:45,620
.أنا... كُنت طبيبًا في ما مضى

230
00:19:45,840 --> 00:19:48,630
أنا أتحدّث عن البشر
.في هذه اللّحظة

231
00:19:49,740 --> 00:19:52,130
.أتحدّث مِن أجل نيو ورفاقنا

232
00:19:52,730 --> 00:19:55,150
تفعل كُلّ هذا مِن أجل نيو-كون؟

233
00:19:55,150 --> 00:20:00,140
صدقًا، لا أُكن أدنى مَشاعر
.الاهتمام لـ المِيبورو، ولا لـ هيجيكاتا

234
00:20:00,760 --> 00:20:02,750
.غير أنّني متيقّنٌ مِن شيءٍ واحد

235
00:20:03,400 --> 00:20:04,970
.نيو فتىً طيّب

236
00:20:05,440 --> 00:20:09,310
بمَقدوره البُكاء والغضب في
.المَواضع الّتي ترتقي لذلك

237
00:20:10,040 --> 00:20:13,450
.لَمست هذا خلال عَملي معه كمُفتّشٍ

238
00:20:15,640 --> 00:20:17,870
.وكُلّ ما أَبتغيه أن أكون عونًا له

239
00:20:19,520 --> 00:20:20,430
.هذا مُنتهى قَولي

240
00:20:25,560 --> 00:20:27,160
.فلنَحسم المَسألة هُنا والآن

241
00:20:28,000 --> 00:20:31,920
هل نُساير نحن المُفتّشون
هذا القَرار أم نَمتنع عنه؟

242
00:20:35,850 --> 00:20:38,430
!أسانو، قُلت لك تريّث

243
00:20:39,950 --> 00:20:41,640
.لديّ مهمّةٌ عليّ إتمامها

244
00:20:45,520 --> 00:20:47,940
.سأَمضي لأُعد تقريرًا رسميًا

245
00:20:50,600 --> 00:20:53,510
حسنًا، وما المَانع؟

246
00:21:11,960 --> 00:21:13,280
.إذن قُضي الأمر

247
00:21:14,160 --> 00:21:14,880
،كلا

248
00:21:17,300 --> 00:21:19,030
.بل هِي البداية لا غير

249
00:21:20,090 --> 00:21:21,280
ماذا عن سيريزاوا؟

250
00:21:21,280 --> 00:21:23,300
على نحوٍ ما، سارت
.الأحداث وفق ما رُتّب لها

251
00:21:23,300 --> 00:21:24,290
.حسنًا

252
00:21:24,820 --> 00:21:27,670
شيمادا قام بمُهمّة إزاحة
.هيراما عن طَريقنا

253
00:21:28,750 --> 00:21:32,060
أعتقد أنّنا تسبّبنا لك بالمَتاعب
.أيضًا، يا ناغاكورا-سان

254
00:21:34,960 --> 00:21:37,940
،أخيرًا
.كَفّ المطر عن الهُطول

255
00:23:20,720 --> 00:23:21,960
.تشيرينو نيو يُحدّثكم

256
00:23:22,690 --> 00:23:26,480
وسط زخّات المطر المُنهمر، بدت
.الجبال وكأنّ الضّباب قد غَشيها

257
00:23:27,360 --> 00:23:30,170
إنّ عالمنا هذا قاسٍ
.لا يعرف الرّحمة

258
00:23:30,960 --> 00:23:36,700
ولكن رُغم ذلك، علينا
.نحن المِيبورو أن نمضي قُدمًا

259
00:23:37,540 --> 00:23:41,390
سنَواصل مسيرنا دُون أن
.نُدير ظُهورنا لرَاية الإخلاص

260
00:23:41,390 --> 00:23:43,320
،مِن أجل كيوتو
.ومِن أجل الضّعفاء

261
00:23:44,030 --> 00:23:45,290
.كان هذا مِيثاقنا

262
00:23:46,410 --> 00:23:48,520
."الحلقة القادمة: "أُغنية البِدايات