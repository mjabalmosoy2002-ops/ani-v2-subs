1
00:00:04,150 --> 00:00:05,050
.تارو

2
00:00:06,130 --> 00:00:07,150
.نيو

3
00:00:08,020 --> 00:00:09,400
.هاجيمي

4
00:00:10,240 --> 00:00:11,840
...أيّها الصّبية

5
00:00:13,400 --> 00:00:16,660
نضجتم وصِرتم رجالًا أشدّاء
.دُون أن أَلحظ

6
00:00:18,150 --> 00:00:21,320
أذكر أنّ ثمّة مَن لقّبكم
."بـ "ثُلاثيّ الذّئاب

7
00:00:21,500 --> 00:00:24,490
أرى أنّكم قد غدوتم الآن جَديرين
.بهذا اللّقب بالفعل

8
00:00:25,370 --> 00:00:26,410
...مـ-معذرةً

9
00:00:26,410 --> 00:00:27,750
.تارو

10
00:00:28,780 --> 00:00:31,130
لم تعد مَدينًا لي بأيّ شيءٍ
.بعد اليوم

11
00:00:36,580 --> 00:00:40,520
،أدّيت واجب الولاء بأمانةٍ
.وأبليت بلاءً حسنًا

12
00:00:41,260 --> 00:00:42,800
.سيريزاوا-سينسي

13
00:00:44,000 --> 00:00:45,080
.نيو

14
00:00:45,910 --> 00:00:51,950
خِلتك في البداية مُجرّد صبيٍ مُتعجرف
غريب الأطوار، ولكن الآن؟

15
00:00:52,240 --> 00:00:55,860
،ترغب بحماية الضّعفاء
.وأن تغدو أكثر قُوّةً

16
00:00:55,860 --> 00:00:58,220
.هذا هُو جوهر مَعدنك

17
00:00:59,040 --> 00:01:04,000
،لكن وَيحك، إذا تمسّكت بالمِثاليّات
.فلَن تجني مِن الحياة إلّا القسوة

18
00:01:04,640 --> 00:01:08,850
لم تَعد المِيبورو تلك الجماعة
.الّتي كُنت تَرتجيها

19
00:01:08,850 --> 00:01:10,460
.وأنا موقنٌ أنّك تُبصر ذلك

20
00:01:13,470 --> 00:01:14,610
.هاجيمي

21
00:01:15,600 --> 00:01:19,960
،أنت تملك المَهارة
.فلا تقتفِ أَثري

22
00:01:20,280 --> 00:01:23,160
إيّاك أن يُصبح نهج السّاموراي
.قيدًا يُكبّل رُوحك

23
00:01:24,920 --> 00:01:29,050
!جميعكم أحرارٌ بعد اليوم
!فليحيَ كُلّ منكم كما يَشاء

24
00:03:17,300 --> 00:03:19,550
.سيريزاوا-سان، تفضّل إن شِئت

25
00:03:19,550 --> 00:03:20,470
.بالتّأكيد

26
00:03:21,440 --> 00:03:25,230
!يا مَعشر الرّونين الأعزّاء مِن ميبو
.خدمتم بإخلاصٍ، ليل نهار

27
00:03:25,660 --> 00:03:29,420
.ولذا، مَنحتنا الشوغونيّة مُكافأةً خاصّة

28
00:03:29,920 --> 00:03:31,940
.فلتُسرفوا في الشّراب حتّى مَطلع الفجر

29
00:03:31,940 --> 00:03:34,980
.وتقرّبوا ممّن شِئتم مِن النّساء

30
00:03:34,980 --> 00:03:37,230
.لا تَلتفتوا للمال

31
00:03:37,230 --> 00:03:40,360
بل أَنفقوا ببذخٍ واستمتعوا
!بمظاهر التّرف، في نَخبكم

32
00:03:41,170 --> 00:03:43,360
!اشربوا حتّى الثّمالة

33
00:03:49,110 --> 00:03:51,060
ما بالك يا سيّد كوندو؟

34
00:03:51,060 --> 00:03:53,610
،لا بُدّ للقائد أن يظهر بمظهرٍ لائق

35
00:03:53,610 --> 00:03:54,840
.وأن يكون لغيره خير قُدوة

36
00:03:55,910 --> 00:03:57,380
.سيريزاوا-سينسي

37
00:03:59,110 --> 00:04:02,450
إنّنا في غاية السّعادة لانضمامنا
.إليك في المِيبورو يا سيّدي

38
00:04:02,720 --> 00:04:05,920
هذا يجعلنا نَستشعر لذّة
.الحياة وعَظمة الإنجاز

39
00:04:05,920 --> 00:04:08,620
.لهذا الشّعور وَقعٌ عظيم

40
00:04:08,620 --> 00:04:09,640
.التّالي

41
00:04:10,170 --> 00:04:13,170
ما خِلت أنّ يومًا سيَأتي
.أتقلّد فيه سيفين

42
00:04:16,970 --> 00:04:17,680
.التّالي

43
00:04:17,680 --> 00:04:20,800
يا رجل، لا يكاد عقلي يُصدّق أنّك
.أعددت لنا هذا الاحتفال الباذخ

44
00:04:20,800 --> 00:04:22,800
.أسأنا الظّن بك تمامًا

45
00:04:22,800 --> 00:04:26,990
أجل، كُنّا نحسبك طاغيةً فظًا
.لا يعرف إلّا العنف

46
00:04:29,660 --> 00:04:31,740
،لا تَلتفتوا للماضي
.كُلّ شيءٍ هُنا مباحٌ

47
00:04:32,380 --> 00:04:33,380
.التّالي

48
00:04:33,650 --> 00:04:35,910
بات بمَقدوري إرسال المال
.لأُمّي في الرّيف

49
00:04:35,910 --> 00:04:37,320
!وصار بإمكاني أن أفخر بنفسي

50
00:04:37,320 --> 00:04:40,760
،حقًا؟ يسرّني سماع ذلك
.التّالي

51
00:04:40,760 --> 00:04:43,500
،سيريزاوا-سينسي
!دَعني أُلقي بضع كلماتٍ

52
00:04:43,500 --> 00:04:44,640
!وأنا أيضًا

53
00:04:44,640 --> 00:04:45,630
!سينسي

54
00:04:45,630 --> 00:04:47,680
،هلمّوا جميعًا
!أقبلوا بلا استثناءٍ

55
00:04:59,630 --> 00:05:01,200
هل سنُنفّذ مُخطّطنا حقًا؟

56
00:05:05,080 --> 00:05:10,680
إن انتظرنا لكَمين مِحفّة سيريزاوا
،وسط هذه الرّياح والأمطار

57
00:05:11,120 --> 00:05:13,270
فهَل نحن واثقون مِن أنّنا لن نُخطئها؟

58
00:05:13,270 --> 00:05:14,080
.نحن واثقون مِن ذلك

59
00:05:15,280 --> 00:05:18,580
هل قَتل سيريزاوا هُو الفِعل
الصّائب حتمًا؟

60
00:05:20,060 --> 00:05:23,070
،أعني... سأَقتله إذا أمرتني
.بالطّبع

61
00:05:23,970 --> 00:05:25,170
...بَيد أنّني

62
00:05:29,490 --> 00:05:33,260
لا أستطيع كفّ نفسي عن التّفكير
.في أنّ موته سيَكون خسارةً فادحة

63
00:05:33,260 --> 00:05:35,300
.هيسوكي، انسحب مِن المُهمّة

64
00:05:35,300 --> 00:05:36,060
—كلا، أنا

65
00:05:36,290 --> 00:05:37,320
!قُلت انسحب

66
00:05:46,360 --> 00:05:47,820
ما العمل الآن أيّها العبقري؟

67
00:05:48,240 --> 00:05:49,700
.نَقص عددنا رجلًا

68
00:05:51,880 --> 00:05:53,700
أعلم أنّك كُنت تُفكّر في
.مَصلحة هيسوكي

69
00:05:54,000 --> 00:05:57,960
ومع ذلك، فإنّ هذا سيَجعل
.الهُجوم أكثر صُعوبةً بمراحل

70
00:05:58,880 --> 00:06:01,960
لا أرغب في اصطحاب أيّ شخصٍ
.سيَملؤه النّدم

71
00:06:02,450 --> 00:06:04,390
.فعَاقبة ذلك ستَرتدّ وبالًا علينا

72
00:06:10,930 --> 00:06:13,050
هطل المطر بمثل هذه الغزارة
.في ذلك اليوم أيضًا

73
00:06:14,640 --> 00:06:15,710
.حين كُنت طِفلًا صغيرًا

74
00:06:23,080 --> 00:06:25,570
.أبصرت هِرّةً ضئيلة جرفها تيار النّهر

75
00:06:26,240 --> 00:06:29,450
فما كان مِن أُختي الكُبرى الّتي رافقتني
.حينها إلّا أن تُلقي مِظلّتها وهرعت لنجدتها

76
00:06:30,240 --> 00:06:33,600
كان التّيار جارفًا، لم يكن يخفى على أحدٍ
.أنّ مَسعاها لإنقاذ الهِرّة ضربٌ مِن المُحال

77
00:06:34,040 --> 00:06:35,130
...قُلت لها حينها

78
00:06:35,730 --> 00:06:38,030
،كُفّي عن هذا
.فقد كُتب على الهِرّة الهلاك

79
00:06:38,030 --> 00:06:39,240
وماذا في ذلك؟

80
00:06:45,140 --> 00:06:50,470
أَذهلني ذاك الثّبات في ردّها، فقد كانت
.إجابتها الخالية مِن كُلّ تردّد في غاية الجمال

81
00:06:51,470 --> 00:06:52,700
...وتعلّمت حينها

82
00:06:53,810 --> 00:06:57,240
،أنّ هُبوب الرّياح وانعدام الجدوى

83
00:06:58,040 --> 00:07:00,210
.ليسا عُذرًا للكفّ عن المُحاولة

84
00:07:09,160 --> 00:07:13,350
لا يُمكننا السّماح بأن يَشيع
.أنّنا نتحرّك بأمرٍ مِن آيزو

85
00:07:14,030 --> 00:07:17,000
،فإذا انكشف السّر
.ستَتخلّى آيزو عنّا

86
00:07:17,000 --> 00:07:19,610
.ونَفقد دعم الشّوغون

87
00:07:20,180 --> 00:07:22,360
،وسيَنهار بذلك عِماد قضيّتنا الأسمى

88
00:07:22,360 --> 00:07:26,980
،وسنَعود شِرذمةً مِن الرّونين كما بدأنا
.مُجرّد عصابةٍ مِن الغَوغاء

89
00:07:27,760 --> 00:07:30,880
،وإن حدث ذلك
.فقد قُضي على المِيبورو

90
00:07:32,080 --> 00:07:36,890
لذا، يتحتّم علينا إثبات أنّ المِيبورو
.لا يد لها فيما سنُقدم عليه

91
00:07:37,190 --> 00:07:39,260
يجب أن نُتمّ المُهمّة دُون أن
.يمسّنا خدشٌ واحد

92
00:07:40,020 --> 00:07:44,780
لكن إذا أخفقنا، سنَدّعي أنّنا نحن الأربعة
،فحسب مَن تصرّفنا بمَعزلٍ عن البقيّة

93
00:07:45,360 --> 00:07:48,040
.وأنّ أحدًا مِن رِفاقنا لم يعلم بمُخطّطنا

94
00:07:48,600 --> 00:07:50,420
.وهذا هو الوَاقع، والحقيقة بعَينها

95
00:07:51,680 --> 00:07:52,720
،لا تقلقوا

96
00:07:53,150 --> 00:07:56,840
بمَقدور المِيبورو النّهوض مِن جديد
.ما دام كوندو-سان هُو مِحور ارتكازنا

97
00:07:59,760 --> 00:08:03,370
،إذا فشلنا اللّيلة
.سنَشقّ بُطوننا نَحرًا على الفور

98
00:08:03,970 --> 00:08:07,070
...فتَحمّلنا المسؤوليّة في الحال

99
00:08:08,120 --> 00:08:10,290
سيَحمي بقيّة رجال المِيبورو
.مِن التّبعات

100
00:08:15,250 --> 00:08:17,850
.سأَفعلها، بمُفردي إن اضطررت

101
00:08:19,080 --> 00:08:21,760
لا تأتوا معي ما لم تكونوا
،مُستعدّين للأسوأ

102
00:08:22,240 --> 00:08:23,560
.فأَنا لا أرغب في إكراهكم

103
00:08:25,790 --> 00:08:27,690
.لا أَزعم أنّ مشاعري قد تبدّلت

104
00:08:27,950 --> 00:08:30,240
.يبدو أنّنا غدونا عِصابة هيجيكاتا الآن

105
00:08:35,240 --> 00:08:38,480
،مِن هذه اللّحظة
.سنَسلك درب الأشورا

106
00:08:42,850 --> 00:08:43,960
.سأَنصرف

107
00:08:44,550 --> 00:08:46,880
.أنت هُناك، استدعِ لي مِحفّةً

108
00:08:46,880 --> 00:08:48,340
.أمرك يا سيّدي، في الحال

109
00:08:49,760 --> 00:08:51,380
.تبًا

110
00:08:52,780 --> 00:08:55,700
.اطمئنّ، فلديّ مِحفّةٌ تنتظر بالفعل

111
00:08:57,770 --> 00:08:59,100
.خُذوا هذا السيّد إلى ميبو

112
00:08:59,100 --> 00:08:59,880
.أجل يا سيّدي

113
00:09:06,130 --> 00:09:07,270
ما الّذي دَهاك؟

114
00:09:08,080 --> 00:09:10,770
.لن أنقاد لرَغبتك

115
00:09:13,270 --> 00:09:16,910
كما أنّ هيئة هؤلاء الحَملة لم تَرُقني
.أبدًا، سأَبحث عن مِحفّةٍ أُخرى

116
00:09:16,910 --> 00:09:18,640
.أمرك! سأَجد لك واحدةً فورًا

117
00:09:18,640 --> 00:09:23,070
سنَعود إلى ميبو لجولةٍ أُخرى مِن
.الشّراب، فلدينا نساءٌ بانتظارنا

118
00:09:23,070 --> 00:09:24,620
.هذا هُو السّينسي الخاصّ بنا بحقٍ

119
00:09:24,620 --> 00:09:27,430
لا يُوجد رجلٌ في كيوتو برُمّتها
.يسلب ألباب النّساء مثلما تفعل أنت

120
00:09:29,490 --> 00:09:31,010
ماذا نَفعل الآن؟

121
00:09:31,010 --> 00:09:33,290
.حادت الخُطّة بأَكملها عن مسارها

122
00:09:33,290 --> 00:09:34,970
،إنّها معضلةٌ حقيقيّة

123
00:09:34,970 --> 00:09:39,130
لا يُمكننا أن نَدع حُطام المِحفّة
.مُلقىً هُنا قُبيل بدء هُجومنا

124
00:09:42,290 --> 00:09:44,060
انتظروا حتّى مُنتصف السّاعة
.الرّابعة مِن هزيع اللّيل

125
00:09:44,280 --> 00:09:45,310
ماذا؟

126
00:09:47,590 --> 00:09:52,360
،لن يبقى لهم وجودٌ بعد هذه اللّيلة
.سنَضمن تحقيق ذلك بأَنفسنا

127
00:10:04,440 --> 00:10:06,450
إلى أين أنت ذاهبٌ؟

128
00:10:07,360 --> 00:10:08,330
.لأَقضي حاجتي

129
00:10:21,580 --> 00:10:23,000
ثلاث مِحفّات؟

130
00:10:23,000 --> 00:10:24,990
لمَن هِي؟
لـ سيريزاوا-سينسي ورِفاقه؟

131
00:10:29,190 --> 00:10:29,940
!نيو

132
00:10:30,950 --> 00:10:33,950
،إنّهم يتوجّهون نحو ميبو
.لا ريب أنّهم هُم

133
00:10:36,460 --> 00:10:38,320
ما-ماذا يتعيّن عليّ فِعله؟

134
00:10:46,940 --> 00:10:49,460
تلك المِحفّة الّتي في الطّليعة
.تبدو أثقل مِن البقيّة

135
00:10:49,930 --> 00:10:52,170
.لا شكّ أنّ سيريزاوا-سان بداخلها

136
00:11:02,150 --> 00:11:06,600
،هذا الطّريق يُؤدي إلى دار عائلة ياجي
.ولا يبدو أنّ في نيّتهم التّوقف قبل ذلك

137
00:11:09,320 --> 00:11:11,910
،هذا غريبٌ
.لا أثر لكمينٍ أو مُغتالين

138
00:11:13,070 --> 00:11:17,010
بل لم يُغادر أيّ فردٍ مِن المِيبورو
.منطقة شيمابارا بعد

139
00:11:17,370 --> 00:11:19,450
كيف سيَعترضون سبيل
مجموعة سيريزاوا-سان إذن؟

140
00:11:20,550 --> 00:11:24,990
لعلّ اليوم ليس الموعد المَنشود؟
هل أخطأت حين شعرت أنّ خطبًا ما سيَقع؟

141
00:11:25,720 --> 00:11:27,810
—مِن الأفضل أن أنسحب الآن و

142
00:11:35,800 --> 00:11:36,590
.ها هُم

143
00:11:37,720 --> 00:11:39,120
.صَدق حدسي

144
00:11:40,020 --> 00:11:40,920
.هيجيكاتا-سان

145
00:11:41,160 --> 00:11:41,900
.أوكيتا-سان

146
00:11:42,480 --> 00:11:43,200
.هارادا-سان

147
00:11:43,790 --> 00:11:44,760
كوندو-سان؟

148
00:11:45,160 --> 00:11:46,130
.كلا

149
00:11:49,310 --> 00:11:50,360
بل يامانامي-سان؟

150
00:11:51,510 --> 00:11:53,800
هل يُعقل ألّا يكون كوندو-سان معهم؟

151
00:11:55,110 --> 00:11:57,400
أَلم يكُن ضمن مجموعة المُغتالين أصلًا؟

152
00:12:03,120 --> 00:12:06,560
كان سيريزاوا-سينسي ورِفاقه
.في تلك المِحفّات بالفعل

153
00:12:12,060 --> 00:12:13,620
.يتملّكني شعورٌ سيّئ حيال هذا

154
00:12:13,620 --> 00:12:16,780
،ثمّة خطبٌ ما
...شيءٌ مُفزع على وشك أن يحدث

155
00:12:23,080 --> 00:12:25,090
نيو؟ لم يَعود أدراجه؟

156
00:12:25,600 --> 00:12:27,000
.لا أفهم سبب ذلك

157
00:12:27,220 --> 00:12:28,820
مَن الّذي يَعبأ بهذه التّرهات؟

158
00:12:29,170 --> 00:12:32,480
لديّ مشكلاتٌ أعظم؛ يجب أن
.أَبلغ سيريزاوا-سينسي بسرعةٍ

159
00:12:49,640 --> 00:12:50,590
مَن هذا؟

160
00:12:50,960 --> 00:12:52,420
.يبدو أنّه مُجرّد صبيٍ

161
00:12:57,210 --> 00:12:59,540
ما الّذي يحدث؟
.نيو! إنّه أنت

162
00:13:00,460 --> 00:13:03,200
مهلًا، تعلم أنّ دُخول الصّغار
إلى هُنا محظورٌ؟

163
00:13:03,200 --> 00:13:03,960
.أفسحا لي الطّريق

164
00:13:05,200 --> 00:13:05,960
.كلا

165
00:13:05,960 --> 00:13:07,130
.هيّا، كُفّ عن هذا

166
00:13:07,400 --> 00:13:08,120
.نيو

167
00:13:12,680 --> 00:13:15,510
ما الّذي تفعله هُنا؟

168
00:13:17,800 --> 00:13:19,160
.يا كوندو-سان

169
00:13:22,280 --> 00:13:23,520
ماذا تقصد؟

170
00:13:23,660 --> 00:13:25,670
.أنا أتحدّث عن سيريزاوا-سان

171
00:13:25,670 --> 00:13:27,950
بصفتك قائدًا، لا بُدّ أنّك
.تَعي تمامًا ما يجري الآن

172
00:13:27,950 --> 00:13:29,420
.إيّاك والنّطق بحرفٍ آخر

173
00:13:36,920 --> 00:13:40,790
.إنّني غاضبٌ، كما تعلم

174
00:13:45,730 --> 00:13:47,220
ماذا جرى؟

175
00:13:47,220 --> 00:13:48,710
هل ثمّة خطبٌ ما؟

176
00:13:49,480 --> 00:13:52,570
!أَنصتوا إليّ أيّها السّادة
.سأَسرد على مسامعكم حِكايةً

177
00:13:53,780 --> 00:13:56,140
مضت عشر سنوات مُنذ
.مجيء السّفن السّوداء

178
00:13:56,660 --> 00:13:58,980
وفي أرجاء عاصمتنا كيوتو الّتي
،شارف عُمرها على ألف عامٍ

179
00:13:58,980 --> 00:14:02,810
تمادى الصّعاليك في غيّهم، وبات النّظام
.وسِيادة القانون شيئًا مِن الماضي

180
00:14:03,090 --> 00:14:06,720
حينها أهاب الشّوغون بأهل
.إيدو أن يهبّوا لإصلاح الحال

181
00:14:07,340 --> 00:14:11,930
فاستجاب مائتان وأربعةٌ وثلاثون
.ساموراي لخَوض غِمار ذاك التّحدي

182
00:14:11,930 --> 00:14:13,670
.انظروا، ثمّة عرضٌ يبدأ الآن

183
00:14:13,670 --> 00:14:14,760
هل هي فقرةٌ للتّسلية؟

184
00:14:14,760 --> 00:14:15,670
.هيّا لنَسمع ما لديه

185
00:14:15,830 --> 00:14:19,180
،بَيد أنّهم جميعًا كانوا مِن الأوباش
.واثقين ببَراعتهم في استخدام النّصل

186
00:14:19,650 --> 00:14:22,880
وما كان لرحلتهم نحو كيوتو
.أن تمرّ دُون متاعب

187
00:14:23,740 --> 00:14:26,020
اسمعوا ما كَابدناه نحن المِيبورو
.في طريقنا

188
00:14:26,020 --> 00:14:28,330
فإنّه سيُغرقكم في نوبةٍ
.مِن الضّحك قطعًا

189
00:14:28,330 --> 00:14:30,090
!والآن، أَعيروني انتباهكم

190
00:14:30,370 --> 00:14:31,940
حِكايةٌ؟

191
00:14:31,940 --> 00:14:33,600
.رائعٌ! هات ما عندك

192
00:14:34,470 --> 00:14:36,150
تَقول إنّك غاضبٌ؟

193
00:14:42,340 --> 00:14:45,600
.رَويدك، هدّئ مِن روعك

194
00:14:51,860 --> 00:14:54,850
كيف ارتضيت أمرًا كهذا؟

195
00:14:55,280 --> 00:15:00,080
لم نَأيت بنفسك ودَفعت بحُلفائك
لتنفيذ المُهمّة وحدهم؟

196
00:15:01,160 --> 00:15:03,520
"إنّ هذا يتنافى مع مِيثاق "الإخلاص
.الّذي جعلناه شعارًا لنا

197
00:15:03,520 --> 00:15:06,770
،بل الأدهى مِن ذلك يا كوندو-سان
.أنّ هذا الصّنيع ليس مِن شِيمك أبدًا

198
00:15:11,780 --> 00:15:14,880
لأنّ سيريزاوا-سان قد ضلّ
.عن نهج الإنسانيّة

199
00:15:15,200 --> 00:15:18,930
نهج الإنسانيّة؟
ماذا تقصد بذلك؟

200
00:15:27,320 --> 00:15:28,590
...سيريزاوا-سان

201
00:15:30,680 --> 00:15:32,570
.يبدو أنّه يُعاني مِن علّةٍ ما

202
00:15:34,650 --> 00:15:36,790
،لم يَعرض نفسه على طبيبٍ

203
00:15:37,750 --> 00:15:40,910
لكنّه أسرّ إليّ بأنّه يشعر
.بالمرض يَنهش جسده

204
00:15:41,960 --> 00:15:44,130
ثمّة أوقاتٌ لا يكاد يَقوى فيها
.على إمساك سيفه

205
00:15:45,470 --> 00:15:47,840
.وذكر أنّ أيّامه باتت معدودةً

206
00:15:49,080 --> 00:15:51,960
كُلّف كوندو إيسامي بتَرتيب
،أماكن الإقامة

207
00:15:51,960 --> 00:15:55,560
لكنّه لسببٍ ما، نَسي حجز
.حُجرةٍ لـ سيريزاوا كامو

208
00:15:56,190 --> 00:15:59,480
،حينها ثَارت ثائرة سيريزاوا
.ولم يجد كوندو بُدًا مِن الاعتذار

209
00:15:59,480 --> 00:16:01,830
تبادلا نظراتٍ حادّة وسط
.لهيب الصّراع المُحتدم

210
00:16:01,830 --> 00:16:04,270
والآن، ماذا يُخبّئ القَدر
لهما مِن مُفاجآتٍ؟

211
00:16:05,800 --> 00:16:07,340
!هيّا، جُد علينا ببقيّة الحِكاية بسُرعةٍ

212
00:16:07,860 --> 00:16:11,040
إنّني أُدرك إدراكًا تامًا العِبء الّذي
...تمرّ به أنت ورِفاقك؛ فمَهما يكُن

213
00:16:11,420 --> 00:16:13,700
.تصرّفوا بشأن سيريزاوا

214
00:16:13,880 --> 00:16:15,650
إنّ آيزو تنظر إلى هذه
.المَسألة بجديّةٍ بالغة

215
00:16:16,390 --> 00:16:17,610
.كُنت حاضرًا في ذاك الاجتماع

216
00:16:19,890 --> 00:16:22,790
—لكن التخلّص مِن سيريزاوا-سان

217
00:16:21,780 --> 00:16:22,790
.نيو

218
00:16:22,790 --> 00:16:24,160
.كُفّ عن الحديث حالًا

219
00:16:28,000 --> 00:16:30,290
.لا تتجاهلني لمُجرّد أنّي صبيٌّ

220
00:16:30,860 --> 00:16:32,660
،لم أَعد أقوى على الكِتمان

221
00:16:32,660 --> 00:16:34,930
.وأُصرّ أن تستمع إليّ

222
00:16:35,480 --> 00:16:36,700
.أَفصح عمّا لديك إذن

223
00:16:37,140 --> 00:16:39,990
لماذا لم تُحرّك ساكنًا بصفتك مُفتّشًا؟

224
00:16:39,990 --> 00:16:43,890
كان بمَقدورك جعل هذه القضيّة
.علنيّةً إن أردت ذلك

225
00:16:45,150 --> 00:16:46,950
كيف لي أن أَنطق بحرفٍ لأيّ كان؟

226
00:16:47,600 --> 00:16:50,020
حتّى أنا أملك مِن الفِطنة
.ما يَمنعني عن ذلك

227
00:16:51,420 --> 00:16:53,660
..."نهج الإنسانيّة"
.فهمت مَقصدك الآن

228
00:16:56,450 --> 00:16:57,870
.أنت تعني ما حلّ بـ أوكيكو-تشان

229
00:16:59,670 --> 00:17:02,780
.لكن ذلك لم يكُن خطأ سيريزاوا-سان

230
00:17:03,380 --> 00:17:04,350
هل سألته عن ذلك؟

231
00:17:04,350 --> 00:17:05,200
.أجل، فَعلت

232
00:17:05,680 --> 00:17:08,670
.لكنّه لم يَزد على ما أخبرتك به

233
00:17:09,070 --> 00:17:11,710
.لا أعتقد أنّ سيريزاوا-سان قد قتلها

234
00:17:12,100 --> 00:17:13,380
.فهذا ليس مِن طِباعه

235
00:17:14,000 --> 00:17:14,640
—إذن

236
00:17:14,840 --> 00:17:17,070
.لكنّه كان يعلم شيئًا ما

237
00:17:17,070 --> 00:17:21,630
وفي هذه الحال، أَلم يكُن لِزامًا عليه أن
يقول الحقيقة، على الأقلّ لعائلة ياجي؟

238
00:17:22,040 --> 00:17:24,040
.لهذا السبّب تمهّلت شهرًا كاملًا

239
00:17:25,280 --> 00:17:27,120
لِمَ آثر الكِتمان؟

240
00:17:27,500 --> 00:17:28,670
.تملّكه الذّعر

241
00:17:29,080 --> 00:17:31,980
لا بُدّ أنّه لزم الصّمت ليُؤثر
.سلامته أوّلًا

242
00:17:32,710 --> 00:17:35,860
كان سُلوكه بعيدًا كُل البُعد عن
.سيريزاوا-سان الّذي عرفته

243
00:17:37,640 --> 00:17:41,460
ليس كُلّ امرئٍ يملك مثل
.رباطة جأشك يا كوندو-سان

244
00:17:41,960 --> 00:17:43,790
.فالنّفوس قد يتملّكها الذّعر أحيانًا

245
00:17:46,800 --> 00:17:49,230
.أَوكلت هذه المسألة إلى توشي

246
00:17:49,230 --> 00:17:52,550
،ولن أتدخّل فيها
.فقد عَاهدته على ذلك

247
00:17:53,510 --> 00:17:55,560
وما فعلت هذا إلّا صونًا
.لكيان المِيبورو

248
00:17:55,560 --> 00:17:58,130
.لا أَستسيغ سماع مثل هذا الكلام

249
00:17:58,130 --> 00:17:59,800
،رُبّما لأنّي ما زِلت صبيًا

250
00:18:00,080 --> 00:18:02,140
.لكن قولك هذا لا يمسّ قلبي

251
00:18:02,140 --> 00:18:02,930
...لعلّ سبب ذلك

252
00:18:03,530 --> 00:18:07,060
أنّك في قَرارة نفسك
لست راضيًا عنه أيضًا؟

253
00:18:08,230 --> 00:18:10,150
.مَطالبي الشخصيّة خارج نِطاق نقاشنا

254
00:18:10,150 --> 00:18:12,680
إذن، ماذا عن مَطالب
سيريزاوا-سان الشخصيّة؟

255
00:18:13,210 --> 00:18:14,600
...أَفضى إليّ بقوله

256
00:18:16,120 --> 00:18:18,750
.إنّما قيمة السّاموراي تكمن في مِيتته

257
00:18:19,280 --> 00:18:22,320
.لم يَتبقّ لي شيءٌ لأُقدّمه

258
00:18:22,650 --> 00:18:25,500
...لكن، لو كان بإمكاني

259
00:18:33,120 --> 00:18:37,340
أرجو أن أَبارز السيّد كوندو"
".في نِزالٍ أخير

260
00:18:39,200 --> 00:18:41,010
لن تُطوى هذه الصّفحة
.ما لم تَمثُل أمامه بنفسك

261
00:18:41,740 --> 00:18:44,240
هل تَستكثر على سيريزاوا-سان
هذا المَطلب؟

262
00:18:45,630 --> 00:18:47,020
هل تترك التخلّص منه لرِفاقك؟

263
00:18:50,650 --> 00:18:52,820
وتدّعي أن لا صِلة لك بهذا الشّأن؟

264
00:18:53,740 --> 00:18:55,270
،قضى نيمي-سان نَحبه

265
00:18:55,860 --> 00:19:00,040
وبمَوت سيريزاوا-سان ستَؤول إليك
زَعامة المِيبورو، أَليس كذلك؟

266
00:19:00,040 --> 00:19:02,800
كلا، فأَنا أفتقر إلى المُؤهّلات
.الّتي تتطلّبها هذه المَكانة

267
00:19:02,800 --> 00:19:03,990
!بل ستَتولّى الزّعامة دُون شكٍ

268
00:19:05,780 --> 00:19:10,150
سيَنقاد الجميع لك لأنّك تملك
.قُوّةً حقيقيّة في بَدنك ورُوحك

269
00:19:10,380 --> 00:19:13,500
،أعلم أنّهم سيَتبعونك
.بل سأَفعل أنا أيضًا

270
00:19:13,990 --> 00:19:17,150
لأنّ في أعماق كُلّ امرئٍ
،رغبةً في أن يكون قويًا

271
00:19:17,150 --> 00:19:20,520
.ومِثاليًا في دأبه، وصِدقه، واستقامته

272
00:19:21,150 --> 00:19:23,010
.مَن يرى حال بعضهم لا يَحسبُهم كذلك

273
00:19:24,660 --> 00:19:26,720
لا ضَير في أن يُخفّف الإنسان
.مِن صَرامته هُنيهةً

274
00:19:27,380 --> 00:19:29,280
.لا حاجة لك لأن تَسمعها منّي

275
00:19:29,910 --> 00:19:31,800
،نحن ضُعفاء

276
00:19:31,800 --> 00:19:34,490
.نَميل للتّكاسل ونَنشد الرّاحة

277
00:19:34,920 --> 00:19:35,640
...لكن

278
00:19:39,560 --> 00:19:43,690
"أَليس جوهر "الإخلاص
...يتجلّى في الصّفح

279
00:19:43,700 --> 00:19:45,520
عن الضّعف واحتوائه؟

280
00:19:46,520 --> 00:19:50,480
ما نَفع القائد إن عَجز عن
تلبية مَطلب رفيق دربه؟

281
00:19:51,550 --> 00:19:56,050
أنت بمَوقفك هذا تَحيد عن
.نهج الإنسانيّة

282
00:19:59,010 --> 00:20:01,100
،إن كُنت ستَحمل عِبء جماعة المِيبورو

283
00:20:02,080 --> 00:20:03,520
.فتَحمّله بكُلّ ما فيه

284
00:20:09,480 --> 00:20:12,440
.اعذرني لتَطاولي في قَولي

285
00:20:14,320 --> 00:20:16,200
،اسمع يا سيّد كوندو

286
00:20:16,200 --> 00:20:18,640
...إنّ مستقبل المِيبورو

287
00:20:21,200 --> 00:20:23,280
!يا مَعشر الرّونين الأعزّاء مِن ميبو

288
00:20:27,010 --> 00:20:28,880
ما بالك يا سيّد كوندو؟

289
00:20:29,110 --> 00:20:31,700
،لا بُدّ للقائد أن يظهر بمظهرٍ لائق

290
00:20:31,700 --> 00:20:33,060
.وأن يكون لغيره خير قُدوة

291
00:20:35,270 --> 00:20:35,920
.نيو

292
00:20:36,620 --> 00:20:38,350
هل لديك نجمٌ مسائيّ هادٍ؟

293
00:20:41,160 --> 00:20:42,690
.أَقصد نجم الشّمال

294
00:20:43,780 --> 00:20:46,320
الّذي قِيل إنّ البحّارة
.يستدلون به في مَسارهم

295
00:20:48,700 --> 00:20:50,450
.فهُو ثابتٌ لا يَحيد أبدًا

296
00:20:50,450 --> 00:20:54,320
،وما دام نَصب أعينهم
.فلَن يضلّوا السّبيل

297
00:20:55,000 --> 00:20:57,870
،كان هُو بَوصلتي الّتي أهتدي بها

298
00:20:58,640 --> 00:21:01,960
بل إنّه ليَسمو مقامًا على
.سائر السّاموراي

299
00:21:07,400 --> 00:21:08,290
.هيّا بنا

300
00:21:09,090 --> 00:21:10,000
.كوندو-سان

301
00:21:12,040 --> 00:21:15,040
!تأمّل حالك يا كوندو-سينسي
!أَسرفت في الشّرب حتّى فقدت توازنك

302
00:21:15,040 --> 00:21:16,540
ما كان يجب أن تبلغ هذا الحدّ
.في السّكر

303
00:21:16,790 --> 00:21:18,880
،نيو
.خُذ بيده إلى بيت الخَلاء

304
00:21:19,370 --> 00:21:20,290
.حـ-حاضرٌ يا سيّدي

305
00:21:20,800 --> 00:21:22,120
.سأَتولّى أنا زِمام الأمور هُنا

306
00:21:22,460 --> 00:21:23,390
.تودو-سان

307
00:21:23,390 --> 00:21:24,180
.امضيا لشأنكما

308
00:21:24,650 --> 00:21:25,420
.علينا الإسراع

309
00:21:25,870 --> 00:21:26,440
.أجل يا سيّدي

310
00:21:38,220 --> 00:21:40,010
مـ-من هُناك؟

311
00:23:20,470 --> 00:23:21,960
.هارادا سانوسوكي يُحدّثكم

312
00:23:22,340 --> 00:23:26,680
سيريزاوا، لن أَدعك تُفلت
.بما جَنيته في حقّ هاسوموكاي

313
00:23:27,180 --> 00:23:32,170
ليس مِن شِيمتي طعن الخُصوم في
.الظّلام، لكن قَول سوجي مَنطقيّ

314
00:23:32,170 --> 00:23:34,410
علينا القُبول بأيّ وسيلةٍ في
.هذه المرحلة

315
00:23:34,410 --> 00:23:39,360
سأُريك ما يُمكنني فِعله
.حين يكون الرّمح بين يديّ

316
00:23:39,520 --> 00:23:42,610
.ماذا؟ مهلًا، ثمّة خطبٌ ما

317
00:23:42,970 --> 00:23:45,530
...لا تَقل لي إنّ سيريزاوا ورِفاقه

318
00:23:46,240 --> 00:23:48,000
."الحلقة القادمة: "مُعترك النّزال