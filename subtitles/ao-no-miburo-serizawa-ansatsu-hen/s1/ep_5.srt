1
00:00:00,640 --> 00:00:03,900
،مهلًا
...لا بُدّ أنّكم جماعة المِيبورو

2
00:00:03,900 --> 00:00:07,890
الّتي تقترض مِن التّجار
.كما يفعل اللّصوص تمامًا

3
00:00:08,160 --> 00:00:12,560
نحن حرّاسٌ شخصيّون دُفع لنا
.لنُقاتل مِن أجل الحقّ

4
00:00:12,900 --> 00:00:17,250
إن كُنتم لا ترغبون في التعرّض للأذى، فالأفضل
.أن تُولّوا الأدبار وتعودوا أدراجكم إلى قريتكم

5
00:00:23,350 --> 00:00:24,460
.جُبناء

6
00:00:26,660 --> 00:00:27,460
.لا تأخذكم بهم رأفةً

7
00:00:27,460 --> 00:00:29,120
!هجومٌ

8
00:00:30,320 --> 00:00:32,120
!اسلبوا كُلّ ما هو ثمينٌ

9
00:00:32,120 --> 00:00:33,280
.عجبًا

10
00:00:33,280 --> 00:00:36,200
.يُمكنهم تدبّر الأمر ببراعةٍ دُوننا

11
00:00:36,200 --> 00:00:38,030
.أجل، يبدو كذلك

12
00:00:47,400 --> 00:00:49,130
لماذا تردّدتم؟

13
00:00:49,130 --> 00:00:50,770
.لا حاجة لي بالجُبناء

14
00:00:51,030 --> 00:00:54,250
أَتظنّون أنّ بمَقدوركم حماية
اليابان وأنتم بهذه الهشاشة؟

15
00:00:54,250 --> 00:00:55,200
.كلا، يا سيّدي

16
00:00:55,200 --> 00:00:56,670
.نرجو منك الصّفح

17
00:00:57,350 --> 00:00:59,950
.نحن مِثالٌ للولاء والوطنيّة

18
00:00:59,950 --> 00:01:04,040
نحن أقوى جماعةٍ وطئت قدماها
.الثّرى، فلا يغيبنّ هذا عن بالكم أبدًا

19
00:02:47,680 --> 00:02:51,020
بلغني أنّ أُولئك الثّلاثة
.قد فرّوا مِن المدينة

20
00:02:52,000 --> 00:02:53,440
.جُبناء

21
00:02:54,190 --> 00:02:55,390
هل لي بلحظةٍ مِن وقتكم؟

22
00:02:56,210 --> 00:02:58,320
تارو، ما المَوضوع؟

23
00:02:58,320 --> 00:02:59,280
،معذرةً

24
00:03:01,480 --> 00:03:05,320
،سيريزاوا-سينسي
.أرغب في التحدّث إليك بجدّيةٍ

25
00:03:06,040 --> 00:03:08,530
،أرجوك
.أَوكل إليّ مُهمّةً لأُثبت نَفعي

26
00:03:09,350 --> 00:03:11,110
.لا حاجة لي بالضُعفاء

27
00:03:11,860 --> 00:03:13,880
،أعلم يقينًا أنّني ضعيفٌ

28
00:03:14,250 --> 00:03:15,360
.لكنّني مستعدٌّ لبذل كُلّ غالٍ ونفيس

29
00:03:15,680 --> 00:03:17,470
،إن قبلتني إلى جانبك

30
00:03:17,880 --> 00:03:20,180
فسَأقوم حتّى بتنظيف أماكن
.القاذورات، أو أيّ عملٍ آخر تطلبه

31
00:03:23,660 --> 00:03:24,290
.خُذ هذا

32
00:03:31,270 --> 00:03:32,270
ما هُو؟

33
00:03:32,540 --> 00:03:34,240
.سمٌّ

34
00:03:34,240 --> 00:03:35,520
.دُسّه لـ نيو

35
00:03:38,330 --> 00:03:43,520
فقد باتت حاسّة شمّه الحادة عِبئًا
.لا يُطاق، وأصبح بمثابة مصدر إزعاجٍ لنا

36
00:03:43,860 --> 00:03:45,810
لذا، تأكّد مِن أنّه سيَتجرّعه
.حتّى آخر قطرةٍ

37
00:03:45,810 --> 00:03:49,390
.هذه مهمّةٌ تُلائم قُدراتك

38
00:03:50,210 --> 00:03:52,550
.أنا... لا أقوى على فِعل ذلك

39
00:03:53,000 --> 00:03:54,130
ماذا؟

40
00:03:57,210 --> 00:04:00,620
...أرجوك
.سأفعل أيّ شيءٍ إلّا هذا

41
00:04:01,850 --> 00:04:03,840
.إذن، لا حاجة لي بِك

42
00:04:03,840 --> 00:04:06,160
.إيّاك أن تقترب منّي بعد اليوم

43
00:04:06,350 --> 00:04:07,240
—لكن

44
00:04:07,240 --> 00:04:08,080
.اغرب عن وجهي

45
00:04:08,290 --> 00:04:09,520
!سيريزاوا-سينسي

46
00:04:09,890 --> 00:04:11,600
،قُلت لك
.اغرب عن وجهي

47
00:04:33,080 --> 00:04:35,480
.عجبًا... أذهلتني حقًا

48
00:04:35,480 --> 00:04:38,290
كُنت مُستعدًا تمامًا لتقديم
.ذلك السّم

49
00:04:44,440 --> 00:04:46,170
.إنّه مُجرّد دواءٍ عُشبيّ

50
00:04:56,480 --> 00:04:58,230
أَترغب في تعلّم فُنون السّيف؟

51
00:04:59,170 --> 00:04:59,960
وعلى يَدي أنا؟

52
00:05:06,320 --> 00:05:09,300
.لا مانع لديّ مِن تدريبك

53
00:05:09,710 --> 00:05:14,000
،لا يَطيب لي التدخّل فِيما لا يعنيني
لكن، هل سيريزاوا مَن سبّب لك تلك الكدمة؟

54
00:05:18,990 --> 00:05:21,340
،حسنًا
.سنبدأ بتعلّم وضعيّة الاستعداد

55
00:05:22,120 --> 00:05:23,560
هـ-هكذا؟

56
00:05:23,720 --> 00:05:25,210
.طريقة إمساكك للسّيف معكوسةٌ

57
00:05:25,800 --> 00:05:26,420
والآن؟

58
00:05:26,720 --> 00:05:28,470
.نصل السّيف يرتخي للأسفل

59
00:05:30,140 --> 00:05:32,720
تعلّم كيف تُحافظ على هذه
.الوضعيّة لنصف ساعةٍ

60
00:05:33,850 --> 00:05:35,060
،والآن
.تدرّب على التّلويح

61
00:05:37,320 --> 00:05:41,550
أَتُراه يرغب في تعلّم فُنون
السّيف ليَنتقم مِن سيريزاوا؟

62
00:05:42,440 --> 00:05:43,780
.سدّد الضّربة هُنا

63
00:05:43,780 --> 00:05:48,140
،هيهات له أن ينال منه
.فهذا ضربٌ مِن المُحال

64
00:05:48,650 --> 00:05:50,490
أنت لا تُجيد قطع
.باذنجانةٍ بهذا الأُسلوب

65
00:05:53,850 --> 00:05:55,360
.يا لك مِن أحمق

66
00:05:56,890 --> 00:05:57,860
هل انتهيت؟

67
00:05:58,320 --> 00:06:00,420
!كلا... لا تَستبعدني بعد

68
00:06:02,390 --> 00:06:04,530
إذن، صُبّ في تدريبك
.جميع طاقتك

69
00:06:10,120 --> 00:06:10,970
...أنا

70
00:06:12,180 --> 00:06:16,050
،أمقته مِن كُلّ قلبي
.لكنّني مَدينٌ له

71
00:06:21,920 --> 00:06:23,270
هل كُنت مُخطئًا؟

72
00:06:25,430 --> 00:06:31,680
تارو، أَتسعى حقًا لتنال لك
مكانًا إلى جانب سيريزاوا؟

73
00:06:33,560 --> 00:06:36,440
ما الّذي يدفعك لإضناء نفسك
إلى هذا الحدّ؟

74
00:06:41,840 --> 00:06:44,840
حتّى بلدتي الّتي نشأت
.فيها لم ترغب بي

75
00:06:45,750 --> 00:06:48,350
،وأذلّني مَن تمهّنت عندهم
.فعَاملونني وكأنّي لست مِن البشر

76
00:06:50,210 --> 00:06:52,220
لكن سيريزاوا-سان؟

77
00:06:55,060 --> 00:06:55,890
...إنّه

78
00:06:57,690 --> 00:06:59,390
.تاناكا تارو

79
00:06:59,390 --> 00:07:01,040
.ليَكن هذا اسمك مُنذ هذه اللّحظة

80
00:07:02,280 --> 00:07:05,570
.جعل منّي إنسانًا

81
00:07:09,540 --> 00:07:12,840
،أنا ضعيفٌ حاليًا
!لكنّني سأَشتدّ قُوّةً

82
00:07:13,250 --> 00:07:15,080
!سأَجعل لوُجودي قِيمةً

83
00:07:15,770 --> 00:07:16,470
...حتّى

84
00:07:17,370 --> 00:07:18,790
...حتّى لو بقيت وحيدًا

85
00:07:19,710 --> 00:07:22,710
سأَظلّ صامدًا بجانب
!سيريزاوا-سينسي حتّى آخر رمقٍ

86
00:07:28,200 --> 00:07:29,160
.كفى

87
00:07:30,240 --> 00:07:33,470
مـ-ما الخطب؟
.لا تُنهي التّدريب بهذه البساطة

88
00:07:34,610 --> 00:07:35,970
.سأُعلّمك كما ينبغي

89
00:07:37,360 --> 00:07:40,190
سنحتاج إلى مكانٍ مَعزول بين أشجار الخيزران
.الكثيفة، بعيدًا عن فُضول المُتربّصين

90
00:07:40,850 --> 00:07:42,980
ماذا سنَفعل هُناك؟

91
00:07:44,880 --> 00:07:46,480
...سأَنقل إليك سِرّ

92
00:07:48,070 --> 00:07:49,010
.تقنية السّنونو

93
00:07:52,250 --> 00:07:53,900
!أوكيكو، الدّور عليكِ

94
00:07:54,160 --> 00:07:55,920
.خسرت

95
00:07:56,080 --> 00:07:57,640
!هيّا، حان وقت الاختباء

96
00:08:10,040 --> 00:08:12,360
هل يُمكنني البدء الآن؟

97
00:08:13,120 --> 00:08:15,510
.نحن جميعًا على أهبة الاستعداد

98
00:08:15,800 --> 00:08:17,420
.سأَعثر عليكم حتمًا

99
00:08:18,250 --> 00:08:23,300
عائلتي ياجي، يستضيفون
.ساموراي يُدعون المِيبورو

100
00:08:19,070 --> 00:08:22,400
!أنا قادمةٌ
هل أنتم هُنا؟

101
00:08:24,380 --> 00:08:26,480
...يقول النّاس إنّهم مُخيفون

102
00:08:24,840 --> 00:08:26,110
.حسنًا

103
00:08:26,480 --> 00:08:27,800
.معذرةً

104
00:08:28,070 --> 00:08:30,440
،أيّتها الشقيّة
!أمسكت بكِ الآن

105
00:08:29,840 --> 00:08:34,320
،لكنّهم مَرحون ولُطفاء...
.ويلعبون معي أحيانًا

106
00:08:34,310 --> 00:08:36,290
،حصلت على الدّانغو
هل تُريد بعضًا منه؟

107
00:08:36,290 --> 00:08:36,800
.بالتّأكيد

108
00:08:36,800 --> 00:08:37,500
.للأسف

109
00:08:37,500 --> 00:08:39,050
ماذا؟

110
00:08:37,500 --> 00:08:44,880
كما أنّهم رجالٌ شجعان
.يحمون المدينة مِن الأشرار

111
00:08:45,370 --> 00:08:46,970
!قِطّةٌ جديدة

112
00:08:46,970 --> 00:08:49,620
.كثرت القِطط عندنا مُؤخرًا

113
00:08:50,180 --> 00:08:53,370
ويعود الفضل في ذلك إلى
.هذا الرّجل، كوندو-سان

114
00:08:53,730 --> 00:08:59,090
،إنّه ذو هيبةٍ حتّى حين لا يتكلّم
.في الواقع، أنا أهابه قليلًا

115
00:08:59,360 --> 00:09:02,200
،معذرةً على هذه الضّجة
.يا أوكيكو-تشان

116
00:09:02,200 --> 00:09:04,570
.أنا أُحبّ هيجيكاتا-سان

117
00:09:02,470 --> 00:09:03,860
هل نلتِ كفايتكِ مِن النّوم اليوم؟

118
00:09:04,920 --> 00:09:10,330
إنّه يُشبه المُمثّلين، ويحظى
.بشعبيّةٍ كبيرة لدى النّساء

119
00:09:06,520 --> 00:09:08,300
أخبريني مُجدّدًا إذا تعرّضتِ
.لأيّ أذىً

120
00:09:08,300 --> 00:09:08,920
.حسنًا

121
00:09:11,000 --> 00:09:14,010
أظنّ أنّه كان يعمل في
.بيع الدّواء سابقًا

122
00:09:14,990 --> 00:09:18,080
تاميسابورو و يو-بو؟
.كلا، لم أَرهما

123
00:09:18,080 --> 00:09:19,150
.شُكرًا لك

124
00:09:19,560 --> 00:09:21,260
.لا بُدّ أنّهما هُناك إذن

125
00:09:21,260 --> 00:09:23,360
...لكن أكثر مَن نُحبّه نحن الصّغار

126
00:09:23,360 --> 00:09:24,040
!هكذا

127
00:09:24,040 --> 00:09:25,880
.لا بُدّ أن يكون أوكيتا-سان...

128
00:09:26,000 --> 00:09:31,570
،فهو بشوشٌ لا تُفارقه الابتسامة
.ويلعب معنا الغُمّيضة في معبد ميبو

129
00:09:28,250 --> 00:09:30,140
!خسرت

130
00:09:30,140 --> 00:09:31,570
.فُزت مُجدّدًا

131
00:09:31,570 --> 00:09:32,780
!وجدتك، تامي-ني

132
00:09:32,780 --> 00:09:33,510
.تبًا

133
00:09:34,010 --> 00:09:35,790
هل كُنتم تلعبون الغُمّيضة؟

134
00:09:35,370 --> 00:09:38,010
،يامانامي-سان ذُو طباعٍ هادئة

135
00:09:38,200 --> 00:09:41,360
،وإينوي-سان دؤوبٌ في عمله
.ولا يتكلّم كثيرًا

136
00:09:41,360 --> 00:09:42,960
ماذا عن دُروسكِ؟

137
00:09:41,560 --> 00:09:43,520
.ناغاكورا-سان رجلٌ حازم

138
00:09:45,060 --> 00:09:46,320
،تتهرّبين مِن الدّروس
أليس كذلك؟

139
00:09:46,020 --> 00:09:47,940
سانوسوكي صاخبٌ للغاية

140
00:09:48,750 --> 00:09:49,940
...أمّا تودو-سان فهو

141
00:09:49,940 --> 00:09:51,960
.هُناك مَن يختبئ في بيت الخَلاء

142
00:09:52,380 --> 00:09:53,280
.إنّه يتصرّف كالأطفال...

143
00:09:54,400 --> 00:09:56,120
.وجدتك، يو-ني

144
00:09:56,120 --> 00:09:57,030
!أمسكتِ بي

145
00:09:57,030 --> 00:09:59,570
.لم يبقَ إلّا جارنا شينتارو

146
00:09:58,330 --> 00:10:02,090
،هذا يُذكّرني
.هُناك ثلاثة فِتيةٍ في المِيبورو

147
00:10:02,760 --> 00:10:05,630
يبدو نيو-كون مشغولًا جدًا
.هذه الأيّام

148
00:10:05,890 --> 00:10:09,550
.إذ يزعم أنّه مُفتّش يتقصّى المعلومات

149
00:10:09,830 --> 00:10:13,550
أمّا تارو-تشان فيقضي وقته
.في مُعاونة أهل الدّار

150
00:10:13,800 --> 00:10:17,800
بينما ينصرف هاجيمي-تشان لتفقّد
.سيفه والتّلاعب به طوال الوقت

151
00:10:17,800 --> 00:10:19,680
!ها قد كشفت مَخابئ الجميع

152
00:10:19,680 --> 00:10:20,460
.تبًا، نالت منّا

153
00:10:20,460 --> 00:10:21,560
.كان ذلك سريعًا

154
00:10:22,120 --> 00:10:24,710
!والآن، حان دَوري للاختباء

155
00:10:23,790 --> 00:10:26,310
!إيّاكِ أن تُغادري حُدود ميبو

156
00:10:30,360 --> 00:10:32,570
أين يجب أن أختبئ؟

157
00:10:32,900 --> 00:10:35,580
...ابتعدت كثيرًا حتّى بلغت

158
00:10:47,160 --> 00:10:49,000
!سيريزاوا-سان

159
00:10:49,000 --> 00:10:51,080
.هذه أنتِ أيّتها الصّغيرة

160
00:10:51,400 --> 00:10:53,880
هل مِن الصَواب أن تتجوّلي
هُنا وحيدةً؟

161
00:10:53,880 --> 00:10:55,990
.هذا الرّجل هو سيريزاوا-سان

162
00:10:54,330 --> 00:10:56,880
الكلاب الضّالة ستَلتهم صغيرةً
.مثلكِ في طرفة عينٍ

163
00:10:56,240 --> 00:10:58,960
.إنّه أهمّ ساموراي بين رجال المِيبورو

164
00:10:59,180 --> 00:11:00,920
.بصُحبتك سأكون بخيرٍ

165
00:10:59,730 --> 00:11:04,760
يُحذّرني النّاس منه دائمًا بدعوى أنّه فظٌّ ومُثير
.للمشاكل، وغير ذلك مِن الأوصاف القاسية

166
00:11:00,920 --> 00:11:03,800
الكلاب لن تَقربني طالما
.أنت بجواري

167
00:11:05,360 --> 00:11:06,980
،أنا أعرف حقيقته

168
00:11:09,560 --> 00:11:14,040
فهو في جَوهره رجلٌ رقيق
.القلب يَحنو على الحيوانات

169
00:11:14,920 --> 00:11:16,340
أين كُنت كُلّ هذه المُدّة؟

170
00:11:16,340 --> 00:11:17,500
.كُنت أعمل

171
00:11:17,500 --> 00:11:19,290
.لكنّني أرى معك زُجاجة ساكي

172
00:11:19,290 --> 00:11:20,740
.كُنت أعمل

173
00:11:20,740 --> 00:11:23,320
حقًا؟ هل تخلّصت مِن الأشرار؟

174
00:11:23,320 --> 00:11:24,370
!بالتّأكيد

175
00:11:24,370 --> 00:11:27,480
!كانت معركةً طاحنة

176
00:11:27,480 --> 00:11:30,120
لقّنت تلك الزّمرة الفاسدة
!درسًا لن ينسوه

177
00:11:30,120 --> 00:11:32,140
!يا للرّوعة

178
00:11:32,340 --> 00:11:36,180
!أَصغ إليّ يا سيريزاوا-سان
هل تعرف السّمك الذّهبي؟

179
00:11:36,960 --> 00:11:39,790
.رأيته في المهرجان قبل أيّامٍ

180
00:11:39,790 --> 00:11:42,330
،كان له بريقٌ جذّاب
.وشكلٌ لطيف جدًا

181
00:11:44,240 --> 00:11:47,650
سأبتاع لكِ واحدةً حين أُصادف
.بائع السّمك الذّهبي مُجدّدًا

182
00:11:53,060 --> 00:11:54,960
.أمّا اليوم، فاِكتفي بهذه

183
00:11:55,120 --> 00:11:56,400
!يا لها مِن رسمةٍ مُذهلة

184
00:11:57,570 --> 00:11:59,320
.ليست بالأمر الجَلل

185
00:12:00,430 --> 00:12:01,000
.معذرةً

186
00:12:01,000 --> 00:12:02,240
.كُن حذرًا

187
00:12:02,840 --> 00:12:03,880
.صـ-صدقتِ

188
00:12:08,160 --> 00:12:10,400
هل تعثّرتِ أيّتها الصّغيرة؟

189
00:12:10,400 --> 00:12:12,680
.أنتِ مَن يَجدر بها توخّي الحذر

190
00:12:12,950 --> 00:12:13,560
.تعالي إليّ

191
00:12:17,920 --> 00:12:22,500
نحن نلعب الغُمّيضة، لذا
.إيّاك أن تَشي بمكاني لأيّ كان

192
00:12:25,710 --> 00:12:27,560
.حسنًا، لن أنبس بحرفٍ

193
00:12:28,840 --> 00:12:29,880
.عِدني

194
00:12:31,010 --> 00:12:32,340
.أَعدكِ

195
00:12:33,100 --> 00:12:38,610
هل تعلمين أنّ أسرابًا ساحرة مِن اليَراعات
تملأ هذا المكان بعد حُلول الظّلام؟

196
00:12:38,890 --> 00:12:40,930
!يَراعاتٌ؟ أتوق لرُؤيتها

197
00:12:41,410 --> 00:12:44,620
،إن كُنتِ فتاةً مُطيعة
.فسآخذكِ لمُشاهدتها هذه اللّيلة

198
00:12:44,770 --> 00:12:45,860
!عِدني

199
00:12:46,610 --> 00:12:48,060
.بالطّبع، حسنًا

200
00:12:50,570 --> 00:12:54,320
.ولكن حرارة الجوّ خانقةٌ حقًا

201
00:12:57,430 --> 00:13:00,170
لا ريب أنّ الصّيف
.قد بلغ ذروته الآن

202
00:13:05,700 --> 00:13:08,760
لن يعثر إخوتي عليّ
.في هذا المَخبأ

203
00:13:21,660 --> 00:13:22,930
.يا لها مِن حرارةٍ

204
00:13:27,950 --> 00:13:28,720
ماذا؟

205
00:13:34,080 --> 00:13:35,670
.لا أقوى على الحراك

206
00:13:38,860 --> 00:13:41,800
هل أنتم مُستعدّون للاستسلام؟

207
00:13:43,350 --> 00:13:46,020
.فرغت مِن اللّعب

208
00:13:47,080 --> 00:13:48,990
هل وقعت عيناك على أوكيكو؟

209
00:13:49,320 --> 00:13:51,470
.مضت نحو دار مايكاوا

210
00:13:53,940 --> 00:13:56,720
.نال منّي التّعب

211
00:14:11,560 --> 00:14:13,360
ماذا تقول؟
لم تَعد إلى الدّار بعد؟

212
00:14:13,360 --> 00:14:15,270
!اخرجوا للبحث عنها
!لا تتركوا شِبرًا دُون بحثٍ

213
00:14:14,920 --> 00:14:15,830
!أنت

214
00:14:15,830 --> 00:14:17,550
!انطق بشيءٍ

215
00:14:15,840 --> 00:14:16,540
هل مِن أثرٍ لها؟

216
00:14:16,540 --> 00:14:17,540
.لا وُجود لها هُنا

217
00:14:17,540 --> 00:14:18,920
!إذن فتّشوا في النّاحية الأُخرى

218
00:14:18,920 --> 00:14:19,710
!وجدتها

219
00:14:23,360 --> 00:14:24,940
!سيريزاوا-سينسي

220
00:14:26,230 --> 00:14:28,040
ما سبب هذه الجَلبة؟

221
00:14:28,040 --> 00:14:31,920
حسنًا، يبدو أنّ طِفلة عائلة ياجي
.لم تَعد للدّار مُنذ البارحة

222
00:14:33,340 --> 00:14:36,370
عثروا عليها جُثّةً هامدةً
.بين حُقول الأرزّ

223
00:14:47,840 --> 00:14:48,810
كيف؟

224
00:14:51,870 --> 00:14:53,120
كيف لفاجعةٍ كهذه أن تقع؟

225
00:14:57,750 --> 00:14:59,860
.يبدو أنّه كان حادثًا

226
00:15:00,570 --> 00:15:05,370
،فقد نَشبت قدماها في الوحل
.وتكفّل هذا الجوّ اللّافح بحَرّه بالبقيّة

227
00:15:06,350 --> 00:15:09,160
.اسمح لنا باستقبال ضُيوف الجنازة

228
00:15:09,610 --> 00:15:11,150
.فهذا أقلّ ما يُمكننا فعله

229
00:15:17,300 --> 00:15:19,480
.بلغني أنّها سقطت في حقل الأرزّ

230
00:15:19,480 --> 00:15:21,090
.يا لحُزننا على الصّغيرة أوكيكو-تشان

231
00:15:21,090 --> 00:15:23,470
.لم تبلغ الخامسة مِن عُمرها بعد

232
00:15:23,470 --> 00:15:24,890
.يا لها مِن مأساةٍ تُدمي القلب

233
00:15:26,960 --> 00:15:28,990
،ابنتي في الثّانية

234
00:15:30,230 --> 00:15:32,240
.وأوكيكو كانت تُشارف الخامسة

235
00:15:32,980 --> 00:15:35,330
حُرمت مِن كُلّ مَباهج الحياة
.الّتي كانت تنتظرها

236
00:15:36,480 --> 00:15:39,580
،شارف السّجل على الانتهاء
.ولدينا متّسعٌ مِن الوقت

237
00:15:39,900 --> 00:15:42,370
.ارسم لنا رسمةً ساخرة أو ما شابه

238
00:15:43,240 --> 00:15:45,640
.كان حادثًا مأساويًا بحقٍ

239
00:15:47,460 --> 00:15:50,380
اعتدنا رُؤية النّاس
.يموتون كُلّ يومٍ

240
00:15:50,800 --> 00:15:53,120
.فلا جدوى مِن العَويل الآن

241
00:15:53,380 --> 00:15:56,760
،كلا
.هذه المّرة ليست كغَيرها

242
00:15:57,330 --> 00:16:00,120
وما الّذي يُميّز موت طِفلةٍ عن غيرها؟

243
00:16:00,610 --> 00:16:04,650
لعلّها كانت تلعب الغُمّيضة
.أو أيّ لُعبةٍ أُخرى

244
00:16:05,870 --> 00:16:08,640
،سيريزاوا-سان
كيف لك أن تعرف ذلك؟

245
00:16:10,790 --> 00:16:11,560
ماذا تقصد؟

246
00:16:12,560 --> 00:16:14,010
،حين بحثنا ليلة البارحة

247
00:16:14,310 --> 00:16:18,440
ذكر تاميسابورو ويونوسوكي
.أنّهم كانوا يلعبون الغُمّيضة

248
00:16:18,880 --> 00:16:21,880
.لكنّك كُنت غارقًا في النّوم حينها

249
00:16:21,880 --> 00:16:22,860
مَن يهتمّ؟

250
00:16:24,070 --> 00:16:26,030
،على أيّ حالٍ
.لن يأتي أحدٌ آخر

251
00:17:00,810 --> 00:17:02,290
.مِن الأفضل ألّا تفعل يا نيو

252
00:17:04,800 --> 00:17:05,680
.هيجيكاتا-سان

253
00:17:06,880 --> 00:17:09,840
.لن تنفعها كلماتُ تعزيةٍ الآن

254
00:17:10,530 --> 00:17:11,760
.دعها وشأنها

255
00:17:20,270 --> 00:17:21,100
.فهمت

256
00:17:26,180 --> 00:17:29,770
،لو كنت أعلم أنّ هذا ما ينتظرها
.لأَمضيت معها وقتًا أطول في اللّعب

257
00:17:30,160 --> 00:17:32,960
لم تَعد لديّ رغبةٌ
.في القيام بأيّ عملٍ

258
00:17:35,190 --> 00:17:39,900
كان بمقدوري احتمال الأمر لو حلّ
.بأحدنا، فنحن مُتأهّبون للأسوأ دومًا

259
00:17:40,440 --> 00:17:42,380
لكن أن يَقع هذا لها؟
.لا أعلم كيف أتقبّله

260
00:17:43,140 --> 00:17:46,040
لا أملك إلّا أن أراه حادثًا
...عبثيًا لا معنى له

261
00:17:46,910 --> 00:17:50,120
ولكن، رُبّما لا يُوجد مَفرٌّ
.مِن قُبول هذا الواقع

262
00:17:50,910 --> 00:17:52,800
قد يطرق الموت باب أيّ كان
.في أيّ لحظةٍ

263
00:17:53,240 --> 00:17:54,270
.هيجيكاتا

264
00:17:55,290 --> 00:17:57,670
الفقد يكون أكثر قسوةً
.على مَن بقوا خلفها

265
00:17:58,360 --> 00:18:00,300
.فما عليهم إلّا الصّبر والتحمّل

266
00:18:03,690 --> 00:18:07,310
ماذا يحدث للبَشر حين يموتون؟

267
00:18:07,700 --> 00:18:09,310
.يموتون، وينتهي كُلّ شيءٍ

268
00:18:09,880 --> 00:18:12,320
ألا يُوجد مآلٌ آخر؟

269
00:18:12,560 --> 00:18:15,070
حسنًا، ماذا تعتقد أنت؟

270
00:18:15,880 --> 00:18:20,290
أعتقد أنه سيكون أمرًا جميلًا
...لو تمكّنت رُوح أوكيكو-تشان

271
00:18:21,160 --> 00:18:24,730
مِن العودة لتبدأ حياتها
.كـ أوكيكو-تشان مِن جديد

272
00:18:25,880 --> 00:18:27,690
،ما بالك
هل صِرت واعظًا؟

273
00:18:27,690 --> 00:18:28,790
.لا تجعلني أضحك

274
00:18:28,790 --> 00:18:31,320
.معذرةً، انسَ ما قُلته

275
00:18:38,110 --> 00:18:39,300
اليَراع؟

276
00:18:40,040 --> 00:18:46,680
أَتعلمون، سمعت أنّ أرواح مَن رحلوا
.تسكن في ثنايا اليَراع

277
00:18:47,090 --> 00:18:49,890
أَتريد القول إنّ أوكيكو-تشان
قد عادت؟

278
00:18:50,160 --> 00:18:52,400
.لا أستسيغ هذا النّوع مِن الأساطير

279
00:18:52,830 --> 00:18:57,110
يقولون إنّ اليِراع يشعّ
.ضياءً أخّاذًا قُبيل لحظة موته

280
00:18:57,560 --> 00:19:02,970
ومُنذ أن سمعت ذلك، بات وهجُ
.اليَراع يبدو لي حزينًا للغاية

281
00:19:04,240 --> 00:19:06,610
أمّا أنا فتبدو لي أنوارها
.باعثةً على التّفاؤل

282
00:19:08,500 --> 00:19:11,110
وكأنّها تعزف لَحن البقاء
.رُغم كُلّ الظّروف

283
00:19:13,380 --> 00:19:15,480
كُلّ شخصٍ يرى الأشياء
.بطريقته الخاصّة

284
00:19:16,060 --> 00:19:18,320
أتساءل عمّا كانت ستَقوله
أوكيكو-تشان لو كانت بيننا؟

285
00:19:19,250 --> 00:19:23,080
كانت أوكيكو تثور غضبًا
.حين تُحرم مِن غَفوتها

286
00:19:23,610 --> 00:19:25,520
.كانت تعشق الزّهور والحيوانات

287
00:19:26,660 --> 00:19:30,350
وكم وبّختها أُمّها لالتهامها فجل
.الدّايكون المُخلّل دُون رَويّةٍ

288
00:19:32,210 --> 00:19:34,300
.قِيمة الحياة ليست بأَمدها

289
00:19:35,220 --> 00:19:37,000
.إنّها عاشت حياتها بكُلّ جوارحها

290
00:19:38,140 --> 00:19:41,470
.حُريٌّ بنا أن نتذكّر وهجها دومًا

291
00:19:47,020 --> 00:19:48,000
.أجل، هذا ما سنَفعله

292
00:19:52,580 --> 00:19:56,320
حتّى أنا لم أَعد أشتهي
.الزّاد اليوم

293
00:19:56,320 --> 00:19:58,060
أين سيريزاوا-سينسي؟

294
00:19:58,060 --> 00:20:02,800
إنّه يمقت الأجواء الكئيبة، أظنّه قَصد
.البَلدة للتّرويح عن نفسه بالخَمر

295
00:20:02,800 --> 00:20:04,910
نوغوتشي، أين مَضى تارو؟

296
00:20:04,910 --> 00:20:06,840
.خرج لتوّه

297
00:20:10,090 --> 00:20:11,340
يتدرّب، أليس كذلك؟

298
00:20:11,610 --> 00:20:14,160
.بات هوسه بالتّدريب غريبًا مُؤخّرًا

299
00:20:15,890 --> 00:20:17,320
،نيو-كون
.أَعرني انتباهك لحظةً

300
00:20:17,740 --> 00:20:18,640
يامازاكي-سان؟

301
00:20:26,360 --> 00:20:27,240
...يبدو أنّ

302
00:20:29,420 --> 00:20:31,820
وقع خُطوات صندل الجِيتا العالي
.موجودٌ تحت كُلّ هذه الآثار

303
00:20:32,500 --> 00:20:35,120
هذا يعني أنّها كانت هُنا
.قبل اكتشاف الجُثّة

304
00:20:36,320 --> 00:20:38,700
والفرد الوَحيد في ميبو الّذي
...ينتعل صندل الجِيتا العالي

305
00:20:40,050 --> 00:20:41,540
.هو سيريزاوا-سان

306
00:20:42,870 --> 00:20:44,230
.وهذه كانت مُلقاةً على مقربةٍ مِن هُنا

307
00:20:45,050 --> 00:20:47,520
لا يَسعني الجزم بأنّ
،سيريزاوا مَن رسمها

308
00:20:48,140 --> 00:20:49,600
.لكن صمته يُثير في نفسي الظّنون

309
00:21:16,120 --> 00:21:18,290
!يَراعاتٌ؟ أتوق لرُؤيتها

310
00:21:18,890 --> 00:21:21,320
!عِدني

311
00:21:29,200 --> 00:21:33,320
...أنا... أنا

312
00:21:37,440 --> 00:21:40,970
...أيّتها الصّغيرة

313
00:23:20,570 --> 00:23:21,960
.أوكيتا سوجي يُحدّثكم

314
00:23:22,330 --> 00:23:26,060
يبدو أنّ المُجنّدين الجُدد
.قد ألفوا الحياة في المِيبورو

315
00:23:26,710 --> 00:23:30,320
لكنّهم الآن انقسموا إلى أحزابٍ تُؤيّد
،كوندو-سان وأُخرى سيريزاوا-سان

316
00:23:30,630 --> 00:23:33,520
وبدأت رائحة شيءٍ مُريب تفوح
في الأُفق، أليس كذلك؟

317
00:23:34,080 --> 00:23:38,640
،وعلى ذكر الأمر
ما هذه الرّائحة؟

318
00:23:39,500 --> 00:23:41,110
أَتُراه حريقًا؟

319
00:23:41,650 --> 00:23:45,070
وهل ذاك الّذي أراه وسط اللّهب
هو مَن أظنّه حقًا؟

320
00:23:45,990 --> 00:23:47,720
."الحلقة القادمة: "انقسامٌ