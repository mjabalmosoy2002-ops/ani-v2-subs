1
00:00:48,210 --> 00:00:52,940
"!مسابقة منزل هيموتي الأولى لـ"تقنية جذب جديدة

2
00:00:54,940 --> 00:00:57,510
!جديدة! جديدة

3
00:00:57,510 --> 00:00:58,680
تبدو مألوفة

4
00:00:59,160 --> 00:01:01,890
سنكتشف طرقًا جديدة لجذب الرجال

5
00:01:01,890 --> 00:01:05,830
تبعد كلّ البعد عن اللمس الجسدي ونظرات الإعجاب

6
00:01:05,830 --> 00:01:07,960
!فلتهدفن صوب لقب الملكة

7
00:01:07,960 --> 00:01:08,810
جاذبيّة؟

8
00:01:08,810 --> 00:01:10,490
الجاذبيّة إذًا؟

9
00:01:10,490 --> 00:01:15,710
أنتنّ لستنّ محبوبات كثيراً لذا قد لا تكون
لديكنّ القدرة على الجذب

10
00:01:15,710 --> 00:01:16,660
نفس الأمر ينطبق عليك

11
00:01:18,420 --> 00:01:19,910
بل ينطبق علينا جميعًا

12
00:01:19,910 --> 00:01:21,510
كان ذلك ردًّا شرسًا

13
00:01:22,540 --> 00:01:23,880
من تريد البدء أوّلًا؟

14
00:01:23,880 --> 00:01:25,790
لقد ابتكرت شيئًا للتوّ

15
00:01:25,790 --> 00:01:28,980
تقنيّة كوكورو-تشان الجديدة لجذب الرجال

16
00:01:28,980 --> 00:01:30,650
قومي بطرح السؤال في يوتوب مباشرة

17
00:01:30,650 --> 00:01:31,440
...جدّيًا

18
00:01:32,290 --> 00:01:33,280
فلتصبحي شخصية على يوتوب وحسب

19
00:01:33,280 --> 00:01:35,290
أجل فلتصبحي شخصية يوتوب

20
00:01:35,290 --> 00:01:37,550
ولتطلبي مواعدة شخصيات يوتوب أخرى

21
00:01:38,370 --> 00:01:40,640
زوج يوتوب

22
00:01:42,140 --> 00:01:43,520
أجل

23
00:01:43,520 --> 00:01:45,620
"مثلًا :"ها هي الرسائل التي أرسلها لي هذا اليوم

24
00:01:45,620 --> 00:01:48,580
"ثمّ ستحصلين على آلاف الردود القائلة :"هذا محتوى رديء

25
00:01:49,290 --> 00:01:51,410
مثل رمز عدم الموافقة ذاك

26
00:01:51,410 --> 00:01:52,960
مثل رموز الإعجاب وغير الإعجاب

27
00:01:52,960 --> 00:01:56,080
أجل، على الأرجح أنك ستحصلين على
الكثير من تصويتات عدم الإعجاب

28
00:01:55,260 --> 00:01:56,080
أجل صحيح

29
00:01:56,080 --> 00:01:59,040
لكن قد تتمكّنين من دفع مستحقات
موعدك عن طريق إيرادات الإعلانات

30
00:01:58,610 --> 00:01:59,890
أجل

31
00:01:59,040 --> 00:01:59,890
صحيح

32
00:01:59,890 --> 00:02:01,200
يمكنك القيام بجمع تبرّعات المشاهدين أيضًا

33
00:02:01,200 --> 00:02:02,270
هذا رائع

34
00:02:02,270 --> 00:02:03,160
صحيح

35
00:02:02,510 --> 00:02:04,780
فلتقومي بطرح كتاب صور كتبناه معًا أو شيءٌ من هذا القبيل

36
00:02:06,450 --> 00:02:07,820
هل تشعرين بالغيرة؟

37
00:02:08,870 --> 00:02:10,430
هذا جديد

38
00:02:10,430 --> 00:02:11,210
إنه كذلك

39
00:02:11,210 --> 00:02:12,830
لمَ لا نتوّجك الفائزة وحسب؟

40
00:02:12,830 --> 00:02:14,190
ماذا؟ سلفًا؟

41
00:02:13,240 --> 00:02:15,360
لقد شارك شخصٌ واحدٌ فقط

42
00:02:15,360 --> 00:02:16,890
هل من أحد يرغب في المشاركة؟

43
00:02:16,890 --> 00:02:18,950
إليكم واحدة مبتذلة

44
00:02:18,950 --> 00:02:21,950
تقنيّة تاي-تشان الجديدة لجذب الرجال

45
00:02:26,640 --> 00:02:27,590
يا لغبائك

46
00:02:27,200 --> 00:02:28,870
فلتلمسه

47
00:02:28,870 --> 00:02:29,770
ما الذي سينتج عن ذلك؟

48
00:02:29,770 --> 00:02:30,970
الحظّ الوفير

49
00:02:30,970 --> 00:02:32,400
!فائض من الحظّ

50
00:02:33,250 --> 00:02:35,030
مثل نافورة اللورد؟

51
00:02:35,030 --> 00:02:36,390
صدقًا، ما الذي يخرج؟

52
00:02:36,390 --> 00:02:38,760
هل أقوم بنقع نقودي وما شابه إذًا؟

53
00:02:38,760 --> 00:02:40,890
بالطبع فلتتفضّلي

54
00:02:40,890 --> 00:02:43,560
هلّا توقّفتن عن التحديق بصدري بينما نتحدّث؟

55
00:02:43,560 --> 00:02:44,600
أين هو صدرك؟

56
00:02:45,900 --> 00:02:47,410
!اُنظروا من يتحدّث

57
00:02:47,410 --> 00:02:48,640
إنه موجود في بعض الأيّام

58
00:02:48,640 --> 00:02:49,570
!أنتِ أيضًا

59
00:02:49,570 --> 00:02:50,450
ليس أنتِ

60
00:02:53,410 --> 00:02:55,290
أرجو ألّا تقومي بنقع نقودك

61
00:02:55,290 --> 00:02:56,950
حسنًا سأبدأ

62
00:02:56,950 --> 00:02:59,950
تقنيّة إينيشي الجديدة لجذب الرجال

63
00:02:59,950 --> 00:03:04,660
،كلّما تحدّثتِ وبعد كلّ جملة تقولينها

64
00:03:04,970 --> 00:03:07,280
تقومين بالأنين بطريقة مغرية

65
00:03:07,830 --> 00:03:08,670
...مثلًا

66
00:03:08,670 --> 00:03:11,370
مرحبًا يا كوكورو-كن

67
00:03:12,020 --> 00:03:12,840
مرحبًا

68
00:03:12,840 --> 00:03:14,320
هل أنتِ بخير؟ أأنتِ مريضة؟

69
00:03:14,320 --> 00:03:16,030
كلّا أنا بخير تمامًا

70
00:03:17,320 --> 00:03:18,620
هل تريدين الذهاب لمقهى ما؟

71
00:03:18,620 --> 00:03:21,180
!مقهى؟ بالطبع، فلنذهب إلى مقهى

72
00:03:23,180 --> 00:03:25,620
يجعلك تعتقد أنّ لديك مشكلة في التنفّس

73
00:03:25,620 --> 00:03:27,450
ربما أنت تتهكّمين وحسب

74
00:03:27,450 --> 00:03:30,410
سيكون الأمر مضحكًا للغاية عند الانفصال

75
00:03:30,800 --> 00:03:31,500
فلنجرّب ذلك

76
00:03:31,500 --> 00:03:33,150
اِنتظر،اِنتظر

77
00:03:33,890 --> 00:03:35,730
لماذا تريد إنهاء العلاقة؟

78
00:03:36,520 --> 00:03:38,440
!أجل أجل أجل أجل

79
00:03:38,440 --> 00:03:40,100
لا يسعك سوى الضحك

80
00:03:40,100 --> 00:03:41,850
هل سيكون ذلك هو سبب انتهاء العلاقة؟

81
00:03:45,460 --> 00:03:46,530
هل من شخصٍ آخر؟

82
00:03:46,530 --> 00:03:47,530
أجل

83
00:03:47,530 --> 00:03:50,960
تقنيّة مينامو-تشان الجديدة لجذب الرجال

84
00:03:50,960 --> 00:03:54,940
تقومين بتركيب آلة قمار على بطنك

85
00:03:54,940 --> 00:03:57,070
وتتركينها على بعد رقمٍ واحد من المكسب دومًا

86
00:03:57,710 --> 00:04:00,700
"وتقولين :"أنا على بعد عدد واحد من الفوز
ثمّ تحصلين على رقميْ سبعة

87
00:04:00,700 --> 00:04:03,060
!ثمّ تقوم آخر خانة بالدوران بجنون

88
00:04:03,060 --> 00:04:04,830
!فتصرخين :"أنا على وشك الحصول على سبعة أخرى

89
00:04:05,140 --> 00:04:08,620
"!أنا على بعد عدد واحد من الفوز

90
00:04:09,440 --> 00:04:11,600
آسفة لكنّني لم أفهم أيّ شيء

91
00:04:12,060 --> 00:04:14,120
تقومين بخياطة آلة قمار على بطنك

92
00:04:14,120 --> 00:04:15,100
!ماذا؟

93
00:04:15,100 --> 00:04:21,990
الكثير من الرجال يشعرون بالفضول
لذا تقومين باستغلال ذلك

94
00:04:21,990 --> 00:04:22,820
فهمت

95
00:04:22,820 --> 00:04:24,450
إذًا كأنّها خطوة أبعد عن قلبك؟

96
00:04:24,450 --> 00:04:25,320
أجل تمامًا

97
00:04:25,320 --> 00:04:26,970
"!اِسحب إلى اليمين"

98
00:04:27,830 --> 00:04:30,480
"!تقولين :"اِسحب إلى اليمين

99
00:04:30,480 --> 00:04:32,320
يا لها من فكرة جنونيّة

100
00:04:33,460 --> 00:04:34,770
تصرّف نموذجيّ من مينامو

101
00:04:34,770 --> 00:04:38,310
إذًا ستقومين بالاستيلاء على فضولهم في الحبّ أيضًا، صحيح؟

102
00:04:38,310 --> 00:04:41,720
...عليك بلع العديد من كرات الباتشينكو أوّلًا، لكن

103
00:04:41,720 --> 00:04:43,740
أهكذا يعمل الأمر؟

104
00:04:44,330 --> 00:04:46,660
عندما يربحون، تقومين ببصقها

105
00:04:46,660 --> 00:04:48,190
تقومين ببصقها إذًا؟

106
00:04:48,190 --> 00:04:49,160
أجل

107
00:04:49,160 --> 00:04:51,040
من أين تأتي كرات الباتشينكو يا ترى؟

108
00:04:51,040 --> 00:04:52,330
...حسنًا، في الحقيقة

109
00:04:56,920 --> 00:05:01,730
مسابقة منزل هيموتي الثانية
"لـ"تقنيّة التفادي الخاصة بضائقة الفتاة

110
00:05:03,850 --> 00:05:05,710
!فلتهدفن صوب لقب الملكة

111
00:05:05,710 --> 00:05:06,700
حسنًا سأبدأ

112
00:05:06,700 --> 00:05:11,260
حسنًا يا توكيو-سان، ها هو السيناريو خاصتك

113
00:05:11,260 --> 00:05:16,180
أنت في موعد رفقة صديقك الحميم"
عندما تلتقين بصديقتك الأوتاكو القديمة فجأة

114
00:05:16,180 --> 00:05:18,920
"فيوشك صديقك الحميم على اكتشاف اهتماماتك البليدة

115
00:05:19,510 --> 00:05:20,450
مفهوم

116
00:05:20,450 --> 00:05:22,770
صديقك الحميم هو كوكورو

117
00:05:22,770 --> 00:05:24,090
!أنا؟

118
00:05:24,090 --> 00:05:26,720
وصديقتك غريبة الأطوار هي مينامو

119
00:05:26,720 --> 00:05:27,720
أنا؟

120
00:05:30,200 --> 00:05:33,740
!حسنًا، تقنيّة التفادي الخاصة بتوكيو-تشان. اِنطلقي

121
00:05:34,520 --> 00:05:36,490
كان ذلك ممتعًا

122
00:05:36,490 --> 00:05:37,490
صحيح

123
00:05:37,490 --> 00:05:39,940
لم أتوقع أن تخاف من العجلة لتلك الدرجة

124
00:05:39,940 --> 00:05:40,910
إنها عالية كثيرًا لي

125
00:05:39,940 --> 00:05:41,620
!توكيو؟

126
00:05:41,620 --> 00:05:43,240
!إنها توكيو

127
00:05:43,240 --> 00:05:45,300
إنها أنتِ أليس كذلك؟

128
00:05:45,300 --> 00:05:46,610
هل تعرفينها؟

129
00:05:46,610 --> 00:05:48,540
أجل

130
00:05:48,540 --> 00:05:49,380
إذًا فأنا تعرفينها

131
00:05:49,380 --> 00:05:51,050
!توكيو

132
00:05:51,050 --> 00:05:54,210
من هذا البشريّ الذكر هنا؟

133
00:05:54,210 --> 00:05:55,840
البشريّ الذكر؟

134
00:05:55,840 --> 00:05:58,210
—آسف، سررت بمعرفتك. أنا هو صديق توكيو الحميم

135
00:05:58,210 --> 00:05:59,460
!يا للبذاءة

136
00:06:00,600 --> 00:06:02,050
بذاءة؟ أين ذلك؟

137
00:06:02,050 --> 00:06:06,570
!لطالما قلتِ بأنّك ستتزوّجين من وحيد القرن يا توكيو

138
00:06:06,570 --> 00:06:08,420
ماذا؟ وحيد القرن؟

139
00:06:08,420 --> 00:06:10,980
...آسف، أنا لا أريد التحدّث عن صديقتك بسوء لكن

140
00:06:10,980 --> 00:06:13,630
لديها طريقة غريبة للغاية في التحدّث

141
00:06:13,630 --> 00:06:14,640
...أوه، لا

142
00:06:14,640 --> 00:06:18,190
أنا وتوكيو نلتقي مجدّدًا لأوّل مرّة منذ زمن بعيد جداً

143
00:06:18,190 --> 00:06:20,360
!هذا غير صحيح، فلتخرسي

144
00:06:20,360 --> 00:06:21,750
منذ زمن بعيد جداً؟

145
00:06:21,140 --> 00:06:23,330
!لكن كنّا توأمي روح

146
00:06:23,330 --> 00:06:25,220
ماذا؟ توأمي... ماذا؟

147
00:06:25,220 --> 00:06:27,170
إنها تقول بأنك توأم روحها

148
00:06:27,170 --> 00:06:29,260
آسفة لقد اقترفت خطئًا

149
00:06:29,260 --> 00:06:30,280
أنا لا أعرفها

150
00:06:30,280 --> 00:06:32,580
كلّا لم تفعلي

151
00:06:31,170 --> 00:06:33,960
!هذا غير صحيح

152
00:06:33,960 --> 00:06:36,180
...لكنّك قلتِ للتوّ بأنك تعرفينها

153
00:06:36,180 --> 00:06:37,370
...توكيو

154
00:06:37,370 --> 00:06:40,420
!لكنّنا كنا توأميْ روح بالروح

155
00:06:40,420 --> 00:06:42,240
لحظة، إنها تؤكّد

156
00:06:42,240 --> 00:06:43,020
انتظري

157
00:06:43,020 --> 00:06:51,200
أنا لا أعرف أيّ نوعٍ من العلاقات البائسة تربطك مع هذا الذكر

158
00:06:51,200 --> 00:06:53,810
ما الذي حلّ بالشغف الذي كنتِ تملكينه؟

159
00:06:53,810 --> 00:06:57,430
لحظة، هي لا تبدو كصديقة من الجامعة، صحيح؟

160
00:06:57,430 --> 00:07:00,210
!نحن نلتقي مجدّدًا لأوّل مرّة منذ زمن بعيد جدًا

161
00:07:00,210 --> 00:07:00,930
منذ زمنٍ بعيد جداً؟

162
00:07:00,930 --> 00:07:05,520
من حياتنا السابقة البعيدة، ها نحن نلتقي مجدّدًا

163
00:07:05,520 --> 00:07:07,440
!نحن توأم روح

164
00:07:07,440 --> 00:07:09,350
اِنتظري لحظة

165
00:07:10,530 --> 00:07:13,510
كنت أتساءل عن سبب تجاهلها لرسائلي

166
00:07:13,510 --> 00:07:16,000
!هذا ما كان يحدث إذًا

167
00:07:16,000 --> 00:07:17,840
لحظة، لم تخبريها عن هويّة اللّاين خاصتك إذًا؟

168
00:07:17,840 --> 00:07:19,760
أنت لا تستخدمينه أو لم تخبريها

169
00:07:18,430 --> 00:07:21,250
أنا أعرف رقم هاتفها وحسب

170
00:07:22,660 --> 00:07:24,450
نحن أصدقاء هاتفٍ إذًا

171
00:07:24,450 --> 00:07:27,500
لم أعلم بأنّك تبدين هكذا

172
00:07:25,910 --> 00:07:30,200
!لقد ذهبنا للتسوّق رفقة بعض في محطّة ناكانو

173
00:07:30,200 --> 00:07:31,720
هل نسيتِ ذلك؟

174
00:07:31,720 --> 00:07:33,840
هل تمّت إعادة تركيب ذكرياتك؟

175
00:07:33,840 --> 00:07:35,300
من قبل هذا الذكر؟

176
00:07:35,840 --> 00:07:37,330
!هذا لا يغتفر

177
00:07:37,330 --> 00:07:38,640
...لحظة، ما الذي

178
00:07:37,700 --> 00:07:39,450
!سوف أقوم بتطهير روحك

179
00:07:42,650 --> 00:07:44,060
!فلتختفي! فلتختفي

180
00:07:44,060 --> 00:07:45,600
!لحظة لحظة

181
00:07:45,600 --> 00:07:47,220
!النهاية

182
00:07:48,290 --> 00:07:49,840
!لمَ أنت جيّدة في لعب دور الأوتاكو؟

183
00:07:49,840 --> 00:07:51,040
!يا إلهي

184
00:07:51,040 --> 00:07:52,940
"!هذا لا يغتفر"

185
00:07:52,940 --> 00:07:54,380
!"أيها الذكر"

186
00:07:55,200 --> 00:07:56,210
كان ذلك رائعًا

187
00:07:56,210 --> 00:07:58,450
الشغف كان رائعًا

188
00:07:58,450 --> 00:08:01,360
...الطريقة التي كنت تصرّين بها بعدما عثرت على صديقتك

189
00:08:01,360 --> 00:08:02,990
لم أستطع كبح حماسي

190
00:08:02,990 --> 00:08:05,080
لكنك لا تعرفين طريقة للتواصل معها
سوى بالرسائل النصيّة

191
00:08:55,150 --> 00:08:57,260
ما هذا المكان؟

192
00:08:57,260 --> 00:09:00,570
إنه متجر منعكسات الخادمة

193
00:09:00,570 --> 00:09:01,350
ضغط ضغط؟

194
00:09:01,350 --> 00:09:04,530
يقومون بالضغط عليك من أجل تخفيف التوتر

195
00:09:01,820 --> 00:09:02,740
أجل

196
00:09:04,530 --> 00:09:07,050
أجل. نقوم بالضغط على قدميك من أجل التخلّص من التوتّر

197
00:09:06,370 --> 00:09:07,990
أوه قدميك

198
00:09:07,990 --> 00:09:10,400
لحظة، ما الذي كنت تعتقده؟

199
00:09:10,400 --> 00:09:12,460
ما الذي توقّعته؟

200
00:09:12,460 --> 00:09:13,850
قدميك بالطبع

201
00:09:13,850 --> 00:09:14,880
هل أنت واثقة؟

202
00:09:14,110 --> 00:09:15,720
اعتقدت بأنها الأقدام

203
00:09:14,880 --> 00:09:16,290
أنت تتردّدين

204
00:09:17,520 --> 00:09:18,580
آي-نيان؟

205
00:09:18,580 --> 00:09:19,530
نعم؟

206
00:09:19,930 --> 00:09:24,060
هذا شعور رائع للغاية

207
00:09:24,060 --> 00:09:26,560
أيّ جزء يشعرك بالراحة؟

208
00:09:24,060 --> 00:09:26,560
الأمر مُريب عندما يكون صوتك فقط

209
00:09:27,190 --> 00:09:31,240
أكتافي تحبّ هذا الشعور

210
00:09:32,030 --> 00:09:34,560
سوف أجعلها تحبّه أكثر

211
00:09:35,170 --> 00:09:37,560
لحظة، ما القصة هنا؟

212
00:09:38,680 --> 00:09:40,150
لا يمكنني تصوّر ما يحدث

213
00:09:40,150 --> 00:09:42,070
يجب أن يتمّ حجب هذا الجزء

214
00:09:42,070 --> 00:09:44,320
!هذا يجعل الأمر أسوأ

215
00:09:44,320 --> 00:09:46,940
أعتقد أنّ حجبه سيضرّ بتجارتنا

216
00:09:47,480 --> 00:09:48,800
هذا صحيح

217
00:09:50,130 --> 00:09:52,900
آي-نيان، هلّا قمتِ بالضغط على الأجزاء التي تؤلم؟

218
00:09:52,900 --> 00:09:55,570
موضع الألم؟ أين هو ذلك؟ أسفل قدميك؟

219
00:09:59,950 --> 00:10:02,030
مؤلم حقًّا إذًا، ربما لا بأس بهذا

220
00:10:02,030 --> 00:10:03,370
!مستحيل

221
00:10:05,900 --> 00:10:06,960
...أسفل قدميك

222
00:10:06,960 --> 00:10:07,780
!عقبي

223
00:10:06,960 --> 00:10:09,110
أسفل قدميك متعبة للغاية

224
00:10:07,780 --> 00:10:09,840
!عقبي يؤلمني

225
00:10:10,460 --> 00:10:11,960
هل يؤلمك؟ هل يؤلمك؟

226
00:10:12,440 --> 00:10:14,690
!مخلب قدمي! إنه يؤلمني

227
00:10:14,690 --> 00:10:17,420
مخلب قدمك؟ ماذا؟

228
00:10:17,420 --> 00:10:18,970
هذا متّصل مع أعضائك التناسليّة

229
00:10:18,970 --> 00:10:20,340
!أعضائي التناسليّة سيّئة؟

230
00:10:20,340 --> 00:10:22,790
!أ-أ-أعضاؤه التناسليّة؟

231
00:10:25,670 --> 00:10:26,740
هكذا تمامًا

232
00:10:26,740 --> 00:10:27,490
هل يؤلمك هذا؟

233
00:10:27,490 --> 00:10:29,070
!مؤلم للغاية

234
00:10:29,070 --> 00:10:29,860
هل قام هذا بإيقاظك؟

235
00:10:29,860 --> 00:10:31,810
أنا مستيقظ كليًّا

236
00:10:31,810 --> 00:10:33,500
هل أنت مستيقظ؟

237
00:10:32,680 --> 00:10:34,130
!أنا مستيقظ

238
00:10:33,500 --> 00:10:36,410
من هذا؟

239
00:10:34,130 --> 00:10:35,380
!أنا مستيقظ تمامًا

240
00:10:38,580 --> 00:10:40,580
حسنًا يا نيارين، حان دورك

241
00:10:40,580 --> 00:10:41,940
...فلتستمعي إليّ يا آي-نيان

242
00:10:41,240 --> 00:10:41,940
نعم؟

243
00:10:41,940 --> 00:10:42,690
...قدماي

244
00:10:42,690 --> 00:10:43,650
هل هي منقّعة؟

245
00:10:43,650 --> 00:10:46,180
كلّا، ليست منقّعة بل مبلّلة

246
00:10:46,180 --> 00:10:48,320
...إنها ليست الرائحة

247
00:10:48,320 --> 00:10:50,560
لكننا مشينا من خلال منطقة بها نهر

248
00:10:50,560 --> 00:10:51,540
صحيح صحيح

249
00:10:51,540 --> 00:10:53,380
...هل نقوم بمسحها أوّلًا؟ لكن

250
00:10:53,380 --> 00:10:54,670
!أجل رجاءً

251
00:10:54,670 --> 00:10:57,220
ما هذه؟ منشفة دافئة ومبلّلة؟

252
00:10:56,530 --> 00:10:58,190
منشفة دافئة ومبلّلة

253
00:10:57,220 --> 00:10:59,250
تُمسح قدماي بمنشفة دافئة ومبلّلة

254
00:10:59,250 --> 00:11:00,010
جميل

255
00:11:00,010 --> 00:11:01,690
الآن لن تصبح رائحتها كريهة

256
00:11:02,270 --> 00:11:03,330
!لقد قامت بشمّها

257
00:11:03,330 --> 00:11:04,890
!لقد تمّ شمّي

258
00:11:04,890 --> 00:11:06,140
هذا أمر محرج للغاية

259
00:11:06,140 --> 00:11:07,900
لم أعلم بأنّ هذه إحدى خدماتك

260
00:11:06,340 --> 00:11:09,170
إنه جزء من تحيّات القطط

261
00:11:09,170 --> 00:11:11,610
صحيح، يقومون بشمّ الأجزاء الكريهة

262
00:11:09,540 --> 00:11:12,210
صحيح، يبدأ الأمر بالأنف

263
00:11:12,210 --> 00:11:14,280
لم أتوقّع أن تجعل الأمر بتلك الواقعية

264
00:11:14,280 --> 00:11:16,060
الآن لن أتمكّن من الزواج

265
00:11:18,010 --> 00:11:19,640
هذا الجزء مؤلم

266
00:11:19,640 --> 00:11:20,720
تلك هي كليتك

267
00:11:20,720 --> 00:11:21,680
!كليتي ميّتة؟

268
00:11:21,680 --> 00:11:24,300
لا يمكنك التبوّل كما ينبغي

269
00:11:24,300 --> 00:11:25,460
قد تكونين مصابة بسلس البول

270
00:11:25,460 --> 00:11:27,690
أنت مصابة بسلس البول

271
00:11:31,350 --> 00:11:33,060
!أنا نجمة مشهورة

272
00:11:33,060 --> 00:11:34,180
...وجهك

273
00:11:34,180 --> 00:11:35,760
فلتكوني أكثر ظرافة

274
00:11:35,760 --> 00:11:39,420
لقد شاهدت فيديوهات النجمات وهن يتألّمن

275
00:11:39,420 --> 00:11:41,730
لكن لم يسبق لي أن سمعتهم يصرخن بصوتٍ كهذا

276
00:11:41,730 --> 00:11:42,810
...وأخيرًا

277
00:11:45,180 --> 00:11:47,050
شكرًا لك

278
00:11:45,950 --> 00:11:47,700
تلك هي الأخيرة؟

279
00:11:47,700 --> 00:11:49,270
وأخيرًا، أعضاؤك التناسليّة

280
00:11:51,480 --> 00:11:53,540
!جزء الأعضاء التناسليّة مؤلم

281
00:11:53,540 --> 00:11:57,040
هذه أيضًا عبارة عن فلسفة

282
00:11:57,040 --> 00:11:58,400
!كلّا ليست كذلك