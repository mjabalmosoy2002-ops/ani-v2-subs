1
00:00:00,800 --> 00:00:04,600
لا عَيبَ أَن تُجهِشَ باكيًا

2
00:00:04,700 --> 00:00:08,100
وما حِيلةُ العَيشِ دُونَ مُتنفِّسٍ؟

3
00:00:08,140 --> 00:00:11,640
فما سَرَّنِي سِوى بَسْطُ وجوهِكُم

4
00:00:11,770 --> 00:00:12,800
!كُلَّ حينٍ

5
00:00:12,800 --> 00:00:19,550
قصّة الإخوة الأربعة

6
00:00:20,040 --> 00:00:23,340
عندما أُقلِّبُ بينَ الصّورِ الصّوامتِ

7
00:00:23,370 --> 00:00:27,370
وقد تَنطِقُ الأشياءُ وهيَ صَوَامِتٌ

8
00:00:28,040 --> 00:00:31,040
وما كُلّ نُطْقِ المُخْبِرينَ كلامُ كفَى

9
00:00:31,110 --> 00:00:34,710
هذه سنّةُ الحياة

10
00:00:35,000 --> 00:00:38,500
..نحنُ التَّفَرُّدُ بينَهُم

11
00:00:38,540 --> 00:00:42,540
مَن قالَ إنَّنا مثلُهُم؟

12
00:00:43,010 --> 00:00:47,010
لا عَيبَ أَن تُجهِشَ باكيًا

13
00:00:47,110 --> 00:00:50,580
لا بأسَ إن خَرتَ نَائِحًا

14
00:00:50,550 --> 00:00:54,000
وما كنتُ أدري إذ ثمّة كنفٌ لكَ

15
00:00:54,110 --> 00:00:58,210
بلا زيفٍ أنزوي لهُ منفردًا

16
00:00:58,280 --> 00:01:01,380
ألا عيبَ بأن أبكيَ معكم أيضًا؟

17
00:01:01,400 --> 00:01:05,240
..أمّا لتلكَ البسمات

18
00:01:05,330 --> 00:01:10,330
.أقولُ لها: شكرًا من صميمِ قلبي

19
00:01:13,100 --> 00:01:15,540
شكرًا لكم

20
00:01:16,500 --> 00:01:18,240
.كلَّ حينٍ وآنٍ

21
00:01:22,220 --> 00:01:30,000
Twitter: AlhuseienSub

22
00:01:29,980 --> 00:01:33,980
3 الحلقة

23
00:01:29,980 --> 00:01:33,980
ما يشغلُ تفكيرَ غاكوتو

24
00:01:35,610 --> 00:01:37,400
.إنّهُ أعزُّ أصدقائي

25
00:01:38,200 --> 00:01:40,450
.غاكو-تشان، لنعد للمنزل

26
00:01:41,080 --> 00:01:42,620
.أجل، بالتّأكيد

27
00:01:50,460 --> 00:01:54,760
.في الآونة الأخيرة، بتُ أذهب إلى منزلِ كيريشيما كلَّ يوم بعد المدرسة

28
00:01:57,720 --> 00:01:59,130
.لقد عدنا

29
00:01:59,430 --> 00:02:00,640
أعدتم من المدرسةِ للتّوّ؟

30
00:02:01,430 --> 00:02:02,850
.ثمّة بقايا حلوى دايفوكو

31
00:02:03,060 --> 00:02:04,310
!يا فرحتي

32
00:02:12,480 --> 00:02:14,610
ماذا بشأنِ الواجبِ المنزليّ يا واكا؟

33
00:02:14,980 --> 00:02:16,650
.سيستيقظُ قريبًا بما فيه الكفاية

34
00:02:20,820 --> 00:02:21,820
...في هذه الأثناء

35
00:02:29,620 --> 00:02:33,880
.يبدو أنّ أخاكَ الأكبر قد اعتاد على وظيفته التّعليميّة

36
00:02:37,420 --> 00:02:41,010
.نعم، لكنّ هذا العام سيكون مُعلِّم صفٍّ

37
00:02:41,390 --> 00:02:43,180
.لذا هو يمرُّ بوقتٍ عصيبٍ

38
00:02:44,100 --> 00:02:46,850
.يُقال أنّ مهنة المعلِّم مهنة شاقّة

39
00:02:47,680 --> 00:02:49,980
.عليكَ أنّ تقدّمَ العونَ لهُ

40
00:02:50,640 --> 00:02:55,860
.أودُّ ذلك صدقًا، لكنّ هاياتو يعاملني دائمًا كطفلٍ صغيرٍ

41
00:02:56,070 --> 00:02:58,110
.لن يسمح لي بالمساعدة في أعمال المنزل

42
00:02:58,650 --> 00:03:03,660
.حتّى أخي ميناتو لم يسمح له إلا مؤخرًا بإنجاز بعضِ المهام

43
00:03:04,410 --> 00:03:06,080
...وأظلُّ أتساءلُ متى سيحينُ دوري

44
00:03:07,750 --> 00:03:09,000
.لا أطيقُ صيرًا

45
00:03:09,750 --> 00:03:14,170
.يبدو أنّ أخاكَ من النّوع الذّي لا يجيدُ الاعتماد على الآخرين

46
00:03:18,090 --> 00:03:18,510
.لقد وصلت

47
00:03:18,550 --> 00:03:21,180
.هيّا لنلهو بالحديقة ونلعبَ كرة القدم يا غاكو

48
00:03:21,800 --> 00:03:24,390
.مرحبًا بعودتكما، أخي ميناتو وأوتا

49
00:03:24,970 --> 00:03:27,180
.سأمتنع اليوم عن الذهاب فلا يزالُ واكا يغطُّ نومًا

50
00:03:27,470 --> 00:03:28,100
.فهمت

51
00:03:29,680 --> 00:03:31,890
.إذن، نحن سنغادر الآن

52
00:03:32,730 --> 00:03:35,810
...كان بإمكانكَ على الأقل تركُ حقيبتكَ في المنزل أوّلاً

53
00:03:36,440 --> 00:03:40,690
.تعتبرُ عائلة كيريشيما بمثابةِ المنزل الثّاني لعائلة يوزوكي

54
00:03:41,200 --> 00:03:43,530
.لكنّ في الماضي لم نكن بهذا التّرابط على الإطلاق

55
00:03:44,990 --> 00:03:47,240
.لم يكن الأمر كذلك إلّا في الوقت الذي فقدنا فيه والدينا

56
00:03:56,340 --> 00:03:58,880
.مرحبًا بعودتكَ يا غاكوتو

57
00:04:04,470 --> 00:04:06,390
هل وصلتَ المنزل للتّوّ يا أخي؟

58
00:04:08,310 --> 00:04:10,890
.أخذت المحاضرات وقتًا أكثر من المعتاد اليوم

59
00:04:11,730 --> 00:04:13,440
.هيّا لندخل المنزل

60
00:04:15,100 --> 00:04:17,230
.كان هاياتو طالبًا جامعيًّا في ذلكَ الوقت

61
00:04:17,610 --> 00:04:21,780
وكان يهرعُ إلى المنزل عائدًا كلّ يوم حتّى
.يستقبلني وقت عودتي من روضة الأطفال

62
00:04:22,950 --> 00:04:27,120
كلُّ ما عليه فعلهُ هو نقلي إلى روضة أطفال
.أخرى تسمحُ لي البقاء فيها حتّى وقتٍ متأخرٍ

63
00:04:28,410 --> 00:04:35,080
لكنّه في الغالب افترضَ أنّي لن أتحمّلَ مفارقة
.أصدقائي في الرّوضة بعد أن فقدتُ والديّ للتّوّ

64
00:04:36,830 --> 00:04:38,130
...لكنّ

65
00:04:38,130 --> 00:04:39,130
.أنا

66
00:05:10,490 --> 00:05:13,870
.ثمّة شعورٌ ينتابني مؤخرًا وكأنّ السّيد كيريشيما يحدّق بي

67
00:05:14,200 --> 00:05:18,080
.أنتَ أيضًا يا هاياتو؟ ذلك العجوز كان يراقبني بالأمس

68
00:05:18,330 --> 00:05:19,840
ماذا؟ أنت كذلك يا ميناتو؟

69
00:05:20,130 --> 00:05:23,710
.تمامًا، كان يطيلُ النّظر إليّ

70
00:05:26,300 --> 00:05:30,140
.شعرتُ أنّه كان غاضبًا، لذلك هربتُ على فوري

71
00:05:30,390 --> 00:05:33,560
.هذا تصرُّفٌ فظٌّ، لا تُشمّر هاربًا بوجه الرّجل

72
00:05:33,850 --> 00:05:36,940
.لا عيبَ بردّة فعلي هذه

73
00:05:38,850 --> 00:05:42,820
.ربّما بسبب هذا كان السيد كيرشيما في مزاجٍ سيّئ تجاهنا

74
00:05:44,030 --> 00:05:47,240
ناهيكَ أنّي ظننتُ العجوز رجلاً مخيفًا
.بالفعل نوعًا ما وليس سهل المعشر

75
00:05:48,700 --> 00:05:50,070
.هذه مشكلة

76
00:05:50,620 --> 00:05:57,290
في الحقيقة، أنا كذلك لاحظتُ منذ فترة
.أنّ السّيد كيريشيما يبدو فضوليًّا حولنا

77
00:05:58,420 --> 00:05:59,500
حتّى أنتَ يا ميكوتو؟

78
00:06:07,800 --> 00:06:13,390
.نظرًا لفقداننا والدينا، ربّما يظنُّ أنّنا لسنا منضبطين كفاية

79
00:06:13,600 --> 00:06:15,100
...ربّما حاله كأولئك

80
00:06:15,470 --> 00:06:18,310
ما زلتَ طالبًا يا هاياتو؟

81
00:06:18,730 --> 00:06:21,900
ماذا عن إرسال غاكوتو إلى منزل عمّك َ على الأقل؟

82
00:06:22,310 --> 00:06:24,650
.إنّه مجرّد طفل صغير، لذا سيكون الأمر صعبًا

83
00:06:24,940 --> 00:06:27,900
.لن تقدرَ على الاعتناء بثلاثتهم بمفردكَ

84
00:06:28,860 --> 00:06:31,910
...كلّا، سواء كان غاكوتو أو ميكوتو أو ميناتو

85
00:06:32,570 --> 00:06:33,870
.لن أبعد أحد إخوتي عن ناظري

86
00:06:34,620 --> 00:06:36,830
.لن أسمح أن تتفكّكَ العائلة

87
00:06:36,830 --> 00:06:37,620
...أخي

88
00:06:39,830 --> 00:06:41,000
ألم تنم حتّى الآن؟

89
00:06:41,330 --> 00:06:42,630
هل أيقظتكَ؟

90
00:06:42,880 --> 00:06:44,750
.أعتذر لكَ، سأخلدُ للنّومِ حالاً

91
00:06:46,010 --> 00:06:48,920
لقد حِكتُ لكَ منديلاً قماشيًّا جديدًا
.لتستخدمه في روضة الأطفال

92
00:06:49,300 --> 00:06:51,050
.لذا تأكد من أخذه معكَ غدًا

93
00:06:53,850 --> 00:06:56,850
يوزوكـي غاكوتـو

94
00:07:06,940 --> 00:07:07,690
...أخي

95
00:07:08,860 --> 00:07:12,410
لا يعلم أنّ معظم الأطفال
.يشترون المناديل من المتجر

96
00:07:13,450 --> 00:07:17,330
.ويستخدمون الأقلام لكتابة أسمائهم عليها

97
00:07:21,460 --> 00:07:22,960
.وداعًا يا غاكوتو-كُن

98
00:07:23,210 --> 00:07:24,080
.وداعًا

99
00:07:32,890 --> 00:07:35,050
.لم يصل بعد أخي هاياتو

100
00:07:46,110 --> 00:07:47,360
أعلينا إيقاظه يا رفاق؟

101
00:07:48,440 --> 00:07:50,610
.هاياتو نائمٌ منذ وقتِ الغداء

102
00:07:51,200 --> 00:07:54,870
.دعهُ يكمل نومه، يبدو مرهقًا

103
00:07:55,240 --> 00:07:56,410
.فقط دعه ينم

104
00:08:03,710 --> 00:08:06,750
.سيكون من المفيد لو انتقلتُ حالاً إلى روضة أطفال أخرى

105
00:08:07,880 --> 00:08:10,550
.ليس وكأنّي أملكُ أصدقاءً هنا بحقّ

106
00:08:12,380 --> 00:08:15,430
...استقال هاياتو من وظيفته بدوام جزئيّ

107
00:08:16,180 --> 00:08:19,310
.لكنّ في تلكَ الأوقات كان لديه بعض النّقود ليشتري لي الألعاب

108
00:08:20,390 --> 00:08:22,270
.وغدت لي الحياةُ هانئةً

109
00:08:24,020 --> 00:08:26,900
أهذا لكوني

110
00:08:25,440 --> 00:08:26,900
صبيًّا صغيرًا؟

111
00:08:27,310 --> 00:08:30,190
ماذا عن إرسال غاكوتو إلى منزل عمّكَ على الأقل؟

112
00:08:30,280 --> 00:08:32,320
.إنّه مجرّد طفل صغير، لذا سيكون الأمر صعبًا

113
00:08:32,700 --> 00:08:34,410
.سأتولّـى رعايتـهم جمـيعًا

114
00:08:34,780 --> 00:08:37,530
ما زلتَ طالبًا يا هاياتو؟

115
00:08:37,950 --> 00:08:40,120
.لن تقدرَ على الاعتناء بثلاثتهم بمفردكَ

116
00:08:40,540 --> 00:08:42,040
.بل بوسعي ذلك

117
00:08:43,960 --> 00:08:47,420
لو كنتُ

118
00:08:45,500 --> 00:08:47,420
أكبر قليلاً

119
00:08:53,340 --> 00:08:56,970
يا فتى، ما الذّي تفعله عندك؟

120
00:08:58,680 --> 00:09:00,600
.أنا بانتظار عودة أخي الأكبر للمنزل

121
00:09:02,100 --> 00:09:03,930
ألا يمكنكَ انتظارهُ داخل المنزل؟

122
00:09:04,890 --> 00:09:05,980
.تعسًا

123
00:09:06,190 --> 00:09:09,480
.ثمّة شعورٌ ينتابني مؤخرًا وكأنّ السّيد كيريشيما يحدّق بي

124
00:09:10,110 --> 00:09:11,730
.ثرثرتُ بما لا ينبغي

125
00:09:11,780 --> 00:09:14,820
.الآن سيُسيّء الجيران الظّنَّ تجاه أخي

126
00:09:16,200 --> 00:09:22,290
.لم يحدث هذا من قبل... ربّما أخذت محاضراته وقتًا أطول اليوم

127
00:09:24,120 --> 00:09:26,960
إذن، ما رأيكَ أن تأتي وتنتظر في منزلي؟

128
00:09:30,000 --> 00:09:34,170
.هذا عصير التفاح... آمل أن يعجبك

129
00:09:34,800 --> 00:09:36,840
.شكرًا... جزيلاً

130
00:09:37,590 --> 00:09:39,720
.أحبُّ عصير التفاح

131
00:09:41,760 --> 00:09:43,220
.سعيدٌ لسماع ذلك

132
00:09:44,140 --> 00:09:47,900
"آمل أن يعجبك"
.هذه أوّل مرّةٍ يقول لي أحدهم مثل هذه الكلمات

133
00:09:48,440 --> 00:09:49,980
.أشعرُ وكأنّي رجلٌ بالغٌ

134
00:10:04,040 --> 00:10:06,290
ما هو اسمكَ؟

135
00:10:07,080 --> 00:10:08,080
.اسمي غاكوتو

136
00:10:08,870 --> 00:10:10,790
.تشرفتُ بكَ يا غاكوتو-كُن

137
00:10:11,090 --> 00:10:12,840
.أنا كوجيرو

138
00:10:13,800 --> 00:10:14,920
.السيد كوجيرو

139
00:10:16,170 --> 00:10:19,720
.حتّى أنّه قدّم نفسه لي... يا له من بالغ فريدٍ من نوعه

140
00:10:20,260 --> 00:10:21,430
...عادةً

141
00:10:22,220 --> 00:10:24,520
ما اسمكَ؟

142
00:10:24,520 --> 00:10:25,470
.اسمي غاكوتو

143
00:10:25,850 --> 00:10:29,140
يا لهُ اسم جميل بحقّ، كم عمركَ يا حلو؟

144
00:10:29,140 --> 00:10:30,270
.أربع أعوام

145
00:10:30,270 --> 00:10:35,150
.ما شاء اللّه، تتحدثُ بطلاقة وهذا عمرك... تفضّل هذه الحلوى

146
00:10:40,240 --> 00:10:41,780
...على أيّ حال يا غاكوتو

147
00:10:43,870 --> 00:10:47,040
لا شكّ أنّك مللت لذا هل تودُّ مشاهدة شيئًا ما؟

148
00:10:47,790 --> 00:10:49,230
مركبات العمل

149
00:10:47,790 --> 00:10:49,230
مَركبات العمل

150
00:10:47,790 --> 00:10:49,230
النسخة العاشرة

151
00:10:49,230 --> 00:10:50,720
كم عدد الحيوانات التي تعرفها؟

152
00:10:53,340 --> 00:10:55,630
.لا جدوى من ذلك سيد سوكي

153
00:10:57,260 --> 00:10:59,340
.أمسكوا به هناك، جميعكم

154
00:10:59,760 --> 00:11:02,180
ألا تعرفُ شعار هذه العشيرة؟

155
00:11:02,510 --> 00:11:05,560
.أنتم في حضرةِ ذو المقام الرفيع ميتسوكوني من ميتو

156
00:11:11,850 --> 00:11:15,150
.لا يخفى على أحدٍ شتّى الجرائمِ الفظيعة التّي ارتكبتموها

157
00:11:15,320 --> 00:11:17,110
..سأغير المحتوى المعروض لآخر

158
00:11:17,110 --> 00:11:18,070
...المعذرة

159
00:11:23,370 --> 00:11:25,830
صباح الخير يا هاياتو، أتشعر بتحسن؟

160
00:11:27,450 --> 00:11:29,000
كم الساعة الآن؟

161
00:11:29,000 --> 00:11:34,880
...غاكوتو

162
00:11:43,360 --> 00:11:45,200
.حسنٌ، هذا يحسمُ الأمر

163
00:11:45,530 --> 00:11:47,370
.شكرًا جزيلاً لقدومكم

164
00:11:47,530 --> 00:11:51,160
.لا عليكما، أرجو أن تحظوا بحياةٍ رغدة من الآن فصاعدًا

165
00:11:51,410 --> 00:11:52,120
.أجل

166
00:11:53,370 --> 00:11:57,170
.رسمُ البسمات على وجوهِ البسطاء

167
00:11:57,330 --> 00:12:03,550
.انطلق ميتونو كومون ورفاقه نحو وجهتهم التالية

168
00:12:00,840 --> 00:12:03,990
يُتبع

169
00:12:04,260 --> 00:12:05,720
.مُــدهشٌ بحقّ

170
00:12:05,930 --> 00:12:08,890
.لم يخطر لي أنّ هناك مثل هذهِ العروضِ القويّة

171
00:12:09,640 --> 00:12:14,600
...سعيدٌ لسماع هذا، من بين كلِّ الأعمال الدراميّة

172
00:12:14,810 --> 00:12:17,400
.ميتونوكومون هي إحدى السّلسلات المفضلة لديّ

173
00:12:18,400 --> 00:12:22,940
.أعتذرُ لكَ... كنت تودُّ مشاهدة شيءٍ آخر

174
00:12:23,360 --> 00:12:27,990
.افترضتُ بما أنّكَ طفلٌ فلن ترغبَ إلّا بعروض الأطفال

175
00:12:28,660 --> 00:12:30,620
.لكنّ تبينَ أنّي كنتُ مخطئًا

176
00:12:31,870 --> 00:12:36,170
هل تلكَ الأقراص تخصُّ أحفادكَ أو أقاربك؟

177
00:12:36,710 --> 00:12:40,250
.كلّا، يعيشُ أحفادي بعيدًا عنّي

178
00:12:40,750 --> 00:12:42,130
.نادرًا ما أراهم

179
00:12:43,460 --> 00:12:45,130
إذن، لمِن تعود هذه الأقراص؟

180
00:12:45,840 --> 00:12:48,260
أيعقلُ أنّك تستمعُ بهكذا عروض أيضًا يا سيّد كوجيرو؟

181
00:12:48,970 --> 00:12:54,060
.أعتذر منكَ... لم أكن أعلم أنّ البالغين مهتمّون بأمورٍ كهذه

182
00:12:54,390 --> 00:12:56,190
.أو ربّما أكونَ أسئتوا الحكم عليكَ لكونكَ بالغًا

183
00:12:56,310 --> 00:12:58,770
...كلّا، كلُّ ما في الأمر

184
00:13:01,940 --> 00:13:05,650
.لطالما حاولتُ إيجادَ سبيلٍ للتّواصل معكم أيّها الصّغار

185
00:13:07,860 --> 00:13:10,870
.منذ اليوم الذّي توفّي فيه والداك

186
00:13:12,330 --> 00:13:15,410
أظلُّ أتساءلُ عمّا إذا كان هناك أيّ شيءٍ
.يمكنني القيام به من أجلكم يا رفاق

187
00:13:17,710 --> 00:13:21,790
.أنتَ أيضًا يا هاياتو؟ ذلك العجوز كان يراقبني بالأمس

188
00:13:22,670 --> 00:13:26,590
في الحقيقة، أنا كذلك لاحظتُ منذ فترة
.أنّ السّيد كيريشيما يبدو فضوليًّا حولنا

189
00:13:26,920 --> 00:13:30,300
.ثمّة شعورٌ ينتابني مؤخرًا وكأنّ السّيد كيريشيما يحدّق بي

190
00:13:36,230 --> 00:13:38,140
أهذا هو سببُ مراقبتهِ لنا؟

191
00:13:39,310 --> 00:13:45,190
حتّى أنّ السيد كوجيرو اشترى أقراص الفيديو
.هذه كمحاولةٍ لخلقِ سبيل تواصل معي

192
00:13:49,070 --> 00:13:53,910
.في هذا الزّمن، أصبح التّواصل بين الجيران أكثر صعوبة

193
00:13:54,280 --> 00:13:57,370
...حتّى عندما كان والديك على قيد الحياة

194
00:13:57,710 --> 00:14:00,040
.فلم يكن بيننا إلّا التّحية بأحسنِ الأحوال

195
00:14:00,330 --> 00:14:02,210
...كنتُ مترددًا عمّا إذا كان مقبولاً

196
00:14:02,210 --> 00:14:06,840
.لهَرِمٍ مثلي أن يفرض نفسه ويتحدث معكم يا صغار

197
00:14:06,840 --> 00:14:08,050
...هذا يفسرُ الأمر

198
00:14:12,640 --> 00:14:14,720
.شكرًا على تحدُّثكَ معي اليوم

199
00:14:15,310 --> 00:14:19,440
.لو لم تحدّثني، لكنتُ ما أزال جالسًا خارج منزلي

200
00:14:19,980 --> 00:14:22,150
.ولم أكن لأحظى بفرصةٍ لمشاهدة تلكَ الدراما

201
00:14:25,070 --> 00:14:30,650
.في الحقيقة أظنُّ أنّني بحاجةٍ للانتسابِ إلى روضة أطفال أخرى

202
00:14:31,610 --> 00:14:38,200
لكنّ يبدو أنّ أخي الأكبر هاياتو يظنُّ أنّه سيكون من
.الصّعب بالنسبة لي أن أنتقل إلى روضةٍ أخرى

203
00:14:39,370 --> 00:14:41,210
.لكنّي لا أعتقدُ ذلك

204
00:14:42,710 --> 00:14:44,670
.إذن، كلُّ ما عليكَ إخباره

205
00:14:46,960 --> 00:14:48,130
.لا أقدر

206
00:14:49,210 --> 00:14:52,930
...حتّى بغياب والدينا من حياتنا

207
00:14:53,260 --> 00:14:58,970
.فكلّ تفكير هاياتو مُـنصبٌ على ضمان سعادتنا

208
00:14:59,600 --> 00:15:01,890
...إذا أخبرته، فسيشعرُ وكأنّه خذلني

209
00:15:04,190 --> 00:15:09,490
.لكنّي أشعرُ بحزنٍ عميقٍ عندما أراه يكدحُ بجدًّ

210
00:15:10,740 --> 00:15:15,240
.أنا ما زلتُ صغيرًا لذا ما باليدِ حيلة

211
00:15:15,870 --> 00:15:18,370
.على الرّغم من أنّه لا يزالُ طالبًا مثلنا

212
00:15:19,580 --> 00:15:23,210
...لو كنتُ أكبرَ قليلاً

213
00:15:24,380 --> 00:15:25,250
...هذا لن

214
00:15:28,420 --> 00:15:31,420
.لا حاجة للاستعجال لتصبح بالغًا

215
00:15:32,220 --> 00:15:35,430
.طفولتُكَ لها وقتٌ محدودٌ وهي لا تقدرُ بثمنٍ

216
00:15:36,140 --> 00:15:39,560
.في الواقع، أودُّ قولَ أنّكَ تبدو شخصًا بالغًا إلى حدٍّ ما

217
00:15:41,060 --> 00:15:43,940
.فبغضِ النّظر، أنتَ تواكبُ عجوزًا مثلي بالحديثِ بسهولةٍ

218
00:15:46,230 --> 00:15:49,320
.في الواقع خطر لي هذا الأمر منذ التقيتكَ

219
00:15:50,030 --> 00:15:53,400
.أجدُ سهولةً بالتّحدّث معكَ على غيرِ المتوقع يا سيّد كوجيرو

220
00:15:55,860 --> 00:15:57,490
...وبالنسبةِ لما قلته

221
00:15:57,660 --> 00:16:00,200
.فلقد فكرتُ بهِ مليًا كذلك

222
00:16:03,210 --> 00:16:06,830
.لكنّك أوّل مَن يقول ذلك عنّي على الإطلاق

223
00:16:08,090 --> 00:16:11,880
.ينتابني شعورٌ أفضل الآن، شكرًا لك

224
00:16:14,760 --> 00:16:16,470
.من الجيّد سماعُ هذا

225
00:16:16,840 --> 00:16:21,430
...غاكوتو

226
00:16:21,890 --> 00:16:22,850
غاكوتو؟

227
00:16:23,230 --> 00:16:24,730
...غاكوتو

228
00:16:25,560 --> 00:16:26,690
.أخي الأكبر هاياتو

229
00:16:29,900 --> 00:16:32,530
.آسفٌ يا غاكوتو، أنا حقًّا آسف

230
00:16:32,820 --> 00:16:33,360
...أنا

231
00:16:33,530 --> 00:16:37,240
.لا بأس، كنتُ أنتظركَ في منزلِ السيّد كيجيرو

232
00:16:40,660 --> 00:16:44,960
.أعتذر لما تسببتُ به من مشاكل لكَ يا سيّد كيريشيما

233
00:16:46,460 --> 00:16:47,330
.لا بأس

234
00:16:51,420 --> 00:16:57,220
إذا كنتَ لا تمانع، ما هو رأيكَ أن تسمحَ لغاكوتو
.بالتّردد لمنزلي بعد انتهائه من الروضة

235
00:17:02,390 --> 00:17:05,520
ماذا عن إرسال غاكوتو إلى منزل عمّكَ على الأقل؟

236
00:17:05,680 --> 00:17:07,810
.إنّه مجرّد طفل صغير، لذا سيكون الأمر صعبًا

237
00:17:08,060 --> 00:17:09,730
.لن أبعد أحد إخوتي عن ناظري

238
00:17:10,060 --> 00:17:12,900
ما زلتَ طالبًا يا هاياتو؟

239
00:17:13,070 --> 00:17:15,400
.لن تقدرَ على الاعتناء بثلاثتهم بمفردكَ

240
00:17:16,320 --> 00:17:17,860
.بل بوسعي ذلك

241
00:17:18,570 --> 00:17:21,120
.كلّا، أستطيعُ رعايته بمفردي

242
00:17:21,620 --> 00:17:24,290
.لم أصل اليوم في الوقت... لكنّ هذا لن يتكرر

243
00:17:24,830 --> 00:17:26,080
.سنكونُ بأفضلِ حال

244
00:17:34,760 --> 00:17:37,470
.أنا آسف، لا يجدرُ بي التّدخل في شؤون الآخرين

245
00:17:53,570 --> 00:17:55,360
.لنعد للمنزل يا غاكوتو

246
00:17:59,030 --> 00:18:06,660
.يا أخي الأكبر، أودُّ زيارةَ منزل السيّد كوجيرو

247
00:18:08,540 --> 00:18:09,290
...غاكوتو

248
00:18:10,670 --> 00:18:12,750
.ليس السّبب أنّي لا أؤمن بأنّك قادرٌ على رعايتي

249
00:18:13,170 --> 00:18:15,630
.بل لأنّنا أصبحنا صديقين

250
00:18:16,090 --> 00:18:19,800
...لقد حظينا بوقتٍ ممتعٍ سويّةً لذا أرجوك

251
00:18:41,320 --> 00:18:42,450
.صباح الخير

252
00:18:44,160 --> 00:18:47,620
.أعتذر عمّا بدرَ مني في الأمس

253
00:18:48,580 --> 00:18:51,500
.لا، أنا من عليه الاعتذار

254
00:18:52,370 --> 00:18:55,880
ألا يزالُ طلبكَ قائمًا؟

255
00:18:56,800 --> 00:19:00,300
...الحقيقة أنّي سأبدأ تدريبًا ميدانيًا لأصبحَ معلّمًا قريبًا

256
00:19:01,050 --> 00:19:02,840
.لذا سيكون هذا عونًا لي

257
00:19:05,390 --> 00:19:06,890
.على الرّحبِ

258
00:19:07,100 --> 00:19:11,520
.من الجيّد أن يشعرَ رجلٌ عجوزٌ مثلي بأنّه مفيدٌ لأحدهم

259
00:19:12,600 --> 00:19:16,230
.ناهيكَ أنّه يسعدني وجودَ امرِئ أتحدثُ معه

260
00:19:18,150 --> 00:19:21,520
بالمناسبة يا غاكوتو، هل تحبُّ الشوغي؟

261
00:19:21,830 --> 00:19:23,660
.لم يسبق لي لعبها

262
00:19:23,660 --> 00:19:25,930
.إذن، دعني أعلّمكَ طريقة لعبها

263
00:19:25,930 --> 00:19:27,640
.أتطلعُ لذلك

264
00:19:28,640 --> 00:19:30,330
.لقد وصلت الحافلة

265
00:19:32,470 --> 00:19:36,400
.لنشاهد ميتونو كومون معًا عند عودتكَ

266
00:19:36,400 --> 00:19:38,590
.أجل، سأغادرُ الآن

267
00:19:45,830 --> 00:19:48,040
أتفكر في استراتيجيّة؟

268
00:19:49,770 --> 00:19:54,040
.آسف، لقد شردتُ بالتّفكير قليلاً

269
00:19:54,790 --> 00:19:59,470
.ولم يمضِ وقتٌ طويلٌ حتّى انتقل واكا وعائلته إلى جوارنا

270
00:19:59,470 --> 00:20:02,630
.ثم انتقلنا أنا وواكا إلى نفس روضة الأطفال

271
00:20:03,220 --> 00:20:07,040
.منذ ذلك الحين، وأنا أتردّدُ إلى منزل كيريشيما طوال الوقت

272
00:20:08,720 --> 00:20:12,420
.السّيّد كوجيرو هو صديقي المفضل الأوّل

273
00:20:14,020 --> 00:20:15,930
أتلعبون هذه مرّة أخرى؟

274
00:20:15,930 --> 00:20:17,400
.أستيقظتَ أخيرًا

275
00:20:17,760 --> 00:20:19,400
.واكا هو صديقي المفضل الثاني

276
00:20:19,400 --> 00:20:21,400
.ها قد عدنا

277
00:20:21,400 --> 00:20:22,900
.أنا مُـنهكٌ حقًّا

278
00:20:22,900 --> 00:20:24,530
.تفوحُ مني رائحةُ العرق

279
00:20:24,530 --> 00:20:25,550
.مساء الخير

280
00:20:25,550 --> 00:20:26,910
.لقد عدت

281
00:20:26,910 --> 00:20:29,020
.أهلاً بعودتكِ يا أمّي

282
00:20:29,020 --> 00:20:31,140
.عدتُ يا رفيقي غاكوتو

283
00:20:31,140 --> 00:20:33,170
يبدو أنّكم وصلتم معًا؟

284
00:20:33,660 --> 00:20:37,040
لقد صادفت هذا الشّخص في السّوق وعرض
.عليّ المساعدة في حمل مشترياتي

285
00:20:37,040 --> 00:20:38,770
.يا لهُ من صبيٍّ لطيف

286
00:20:38,770 --> 00:20:41,600
.بل أنتِ من أصرَّ على طلبِ مساعدتي

287
00:20:41,600 --> 00:20:42,880
.إنّها ثقيلةٌ

288
00:20:42,880 --> 00:20:46,580
.لقد كنتُ مارًّا بالقرب من الحديقة وصادفتُ ميناتو والآخرين يلعبون هناك

289
00:20:46,580 --> 00:20:49,520
أنتَ، لا تقلها بهذه الطريقة؟

290
00:20:49,520 --> 00:20:51,810
ألم ندعوك مسبقًا للذهابِ معنا؟

291
00:20:51,810 --> 00:20:53,640
.أجل، أجل، شكرًا لكما

292
00:20:53,640 --> 00:20:55,770
.إذن دعنا نذهب يا غاكوتو

293
00:20:55,770 --> 00:20:59,410
.إلى لقاءِ الغد

294
00:21:00,380 --> 00:21:01,400
...أنا

295
00:21:01,460 --> 00:21:04,650
كوجيرو

296
00:21:01,840 --> 00:21:04,650
يوتا

297
00:21:02,210 --> 00:21:04,650
ساكي

298
00:21:02,590 --> 00:21:04,650
واكا

299
00:21:04,760 --> 00:21:07,910
غاكوتو

300
00:21:05,130 --> 00:21:07,910
ميناتو

301
00:21:05,410 --> 00:21:09,950
.أحظى بالمتعة حقًّا في كلّ أيامي العادية

302
00:21:05,510 --> 00:21:07,910
ميكوتو

303
00:21:05,880 --> 00:21:07,910
هاياتو

304
00:22:48,860 --> 00:22:53,200
ركن المعرفة العرضيّة

305
00:22:53,630 --> 00:22:55,490
مرحباً بالجميع، أنا الدعسوقة

306
00:22:55,490 --> 00:22:57,160
وأنا خنفساء الأيل

307
00:22:57,160 --> 00:23:00,270
.لنبدأ ركن الحقائق العرضية اليوم

308
00:23:00,270 --> 00:23:04,480
حيث سنستمر في تقديم معلومات قيمة
.عن الإخوة يوزوكي الأربعة بطريقة بوم بوم

309
00:23:06,120 --> 00:23:09,490
.دعونا نخبر الجميع عن الأطعمة المفضلة لديهم

310
00:23:09,480 --> 00:23:12,980
ـوتــايــاهـ

311
00:23:09,490 --> 00:23:11,420
.هاياتو يحب الكاري

312
00:23:11,420 --> 00:23:12,990
.وأنا كذلك

313
00:23:12,980 --> 00:23:16,980
ـوتــوـكـميـ

314
00:23:12,990 --> 00:23:14,940
.ميكوتو يحبُّ السمك المطهو ببطء

315
00:23:14,940 --> 00:23:17,000
.هذا الذوق الرفيع لطالب في السنة الأولى من المرحلة الإعدادية

316
00:23:16,980 --> 00:23:20,500
ـوتــاـنــيـمـ

317
00:23:17,000 --> 00:23:18,850
.ميناتو يحبُّ شريحة لحم الهامبرغر

318
00:23:18,850 --> 00:23:20,500
.هذا صحيح

319
00:23:20,500 --> 00:23:23,210
.غاكوتو يحب الساشيمي، وخاصة الساشيمي إسقمري الحصان

320
00:23:20,500 --> 00:23:25,000
ـوتــوكــاغـ

321
00:23:23,210 --> 00:23:25,000
.بالتأكيد

322
00:23:25,000 --> 00:23:27,590
.بالمناسبة، يوتا تحب اللحوم

323
00:23:25,000 --> 00:23:30,020
تاـويـ

324
00:23:27,590 --> 00:23:30,130
.طالما أنه لحم، فستأكله

325
00:23:30,130 --> 00:23:32,740
.لقد كان ذلك لفترة قصيرة فقط، لكن علينا أن نتعمق أكثر في الشخصيات

326
00:23:32,740 --> 00:23:35,590
.يا له من ركنٍ صغيرٍ لطيفٍ

327
00:23:35,590 --> 00:23:36,890
أنتِ محقّة

328
00:23:36,890 --> 00:23:38,890
...وداعـ