1
00:00:05,170 --> 00:00:08,470
.لدينا قاعدة خاصة بيننا

2
00:00:11,060 --> 00:00:12,410
.فوجيميا-سان

3
00:00:12,930 --> 00:00:14,180
.لقد أوقعتي هذه

4
00:00:16,980 --> 00:00:19,750
.فوجيميا-سان مخيفة

5
00:00:22,340 --> 00:00:24,900
.لا يسعني محادثتها في الفصل

6
00:00:24,900 --> 00:00:27,210
.لا يسعني إلقاء التحية حتى

7
00:00:30,270 --> 00:00:32,450
.المعذرة عما حدث اليوم يا هاسي-كن

8
00:00:33,920 --> 00:00:36,350
.كلا، أعتذر لأني حادثتك

9
00:00:36,940 --> 00:00:41,210
رغم ذلك، لهو أمرٌ محزن ألّا نستطيع محادثة
.بعضنا البعض سوى هنا

10
00:00:43,320 --> 00:00:47,490
إن حادثتني أمام الجميع، ربما يتفوّهون
.بأمورٌ عنكِ أيضًا

11
00:00:47,490 --> 00:00:49,160
.لا أكترث لهذا

12
00:00:49,160 --> 00:00:51,720
.إنه قراري لفعل هذا

13
00:00:51,720 --> 00:00:56,730
علاوة على ذلك، أنا مسرورة لأني التقيت بشخص
.أحادثه بشخصيّتي

14
00:00:57,950 --> 00:01:01,700
.آمل أن تجدي أشخاصًا كهؤلاء

15
00:01:02,170 --> 00:01:03,570
.آمل هذا

16
00:01:04,180 --> 00:01:08,260
.لأكون صريحًا، أنا سعيد كوني مميزًا

17
00:01:08,260 --> 00:01:13,580
كنت أخال أن اتّباع قاعدتنا المُقيّدة هيَ ما
،تُعرّف وتحدد صداقتنا

18
00:01:13,580 --> 00:01:15,490
.إلى أن ظهرت تلك

19
00:01:17,330 --> 00:01:18,760
.وجدتك

20
00:01:18,760 --> 00:01:21,900
.إذن هنا أنتِ يا فوجيميا-سان

21
00:02:53,010 --> 00:02:57,050
5. أصدقاء
جدد

22
00:02:57,710 --> 00:02:58,970
.انتهى الفصل

23
00:02:59,990 --> 00:03:01,640
.لا تنسوا فروضكم

24
00:03:02,330 --> 00:03:04,850
.هاسي، تعال لمكتب هيئة التدريس

25
00:03:05,560 --> 00:03:06,590
!لمَ؟

26
00:03:06,590 --> 00:03:08,730
.إنه بخصوص درجاتك

27
00:03:08,730 --> 00:03:11,280
.سنحظى بنقاشٍ طويل حول مستقبلك

28
00:03:11,900 --> 00:03:16,240
.أرغب حقًا بتناول الغداء، لكني سأتأخر قليلاً

29
00:03:16,240 --> 00:03:17,510
!المعذرة

30
00:03:18,810 --> 00:03:20,430
أهو بخير؟

31
00:03:30,540 --> 00:03:31,540
هاسي-كن؟

32
00:03:34,340 --> 00:03:37,140
.مرحبًا يا فوجيميا-سان

33
00:03:37,930 --> 00:03:40,310
...أنتِ في فصلي

34
00:03:40,810 --> 00:03:43,130
.أُدعى ياماغيشي ساكي

35
00:03:43,130 --> 00:03:46,810
.لقد تبعتك لأني أردت محادثتك

36
00:03:47,350 --> 00:03:49,070
محادثتي؟

37
00:03:49,710 --> 00:03:50,820
...انصتي

38
00:04:01,530 --> 00:04:03,540
،إن لم تمانعي

39
00:04:04,340 --> 00:04:06,710
.أرغب بأن نغدو أصدقاء

40
00:04:10,820 --> 00:04:12,670
لمَ؟

41
00:04:12,670 --> 00:04:15,520
.لأني أرغب بأن أغدو صديقتك

42
00:04:15,520 --> 00:04:18,890
.في الحقيقة، أُفضّلك أن تكوني شقيقتي الكبرى

43
00:04:19,800 --> 00:04:22,520
.أو ربما أمي

44
00:04:22,520 --> 00:04:25,630
.لكني أخال أني أُفضّلك كشقيقةً لي

45
00:04:25,630 --> 00:04:27,300
.واحدة أكبر مني بسنتين

46
00:04:27,300 --> 00:04:28,650
ما الذي تقولينه؟

47
00:04:29,060 --> 00:04:31,870
.لطالما أُعجبت بك

48
00:04:31,870 --> 00:04:34,190
.إنك راشدة يا فوجيميا-سان

49
00:04:34,190 --> 00:04:38,170
تتخذين قرارات حياتك بإيجابية، وبوسعك
.فعل كل شيءٍ بنفسك

50
00:04:38,170 --> 00:04:42,650
،أتمنى أن أصبح مثلك

51
00:04:42,650 --> 00:04:46,120
.لكن أريد منكِ الاعتناء بي أيضًا

52
00:04:48,410 --> 00:04:51,830
ألا ترغبين بتكوين صداقة معي؟

53
00:04:51,830 --> 00:04:54,020
...الأمر ليس أني لا أرغب

54
00:04:54,020 --> 00:04:55,800
!هذا مطمئن

55
00:04:55,800 --> 00:04:59,760
.آمل أن نغدو صديقتان جيّدتان يا فوجيميا-سان

56
00:05:03,770 --> 00:05:04,860
...هاسي-كن

57
00:05:06,000 --> 00:05:09,010
لمَ تلك الفتاة تقف وكأنها تنتمي لهذا المكان؟

58
00:05:09,010 --> 00:05:10,650
.مرحبًا

59
00:05:10,650 --> 00:05:13,140
أنتِ ياماغيشي-سان، صحيح؟

60
00:05:13,140 --> 00:05:14,530
ماذا تفعلين هنا؟

61
00:05:14,530 --> 00:05:17,460
.طلبت مني بأن أُصبح صديقتها

62
00:05:18,480 --> 00:05:23,950
بالمناسبة، ما اسميكما؟

63
00:05:23,950 --> 00:05:27,340
.أنا أُدعى هاسي، وهذه هو يوكي

64
00:05:27,340 --> 00:05:29,450
!مهلاً، ألستِ في فصلنا؟

65
00:05:29,450 --> 00:05:31,170
ألا تذكرين اسميْنا؟

66
00:05:31,510 --> 00:05:33,910
هاسي-كن و كيريو-كن؟

67
00:05:33,910 --> 00:05:37,130
إذًا، هل أنتما صديقا فوجيميا-سان؟

68
00:05:39,080 --> 00:05:39,880
.أجل

69
00:05:39,880 --> 00:05:42,640
.لأكون دقيقًا أكثر، أنا صديقها فحسب

70
00:05:42,640 --> 00:05:48,520
إذن، سيكون لدى فوجيميا سان صديقيْن من
.الآن فصاعدًا، بما فيهم أنا

71
00:05:49,640 --> 00:05:53,670
لكن يتوجّب علي تناول الغداء مع أصدقائي
.الآخرين في بعض الأحيان

72
00:05:53,670 --> 00:05:55,960
.لذا لا يسعني القدوم هنا كل يوم

73
00:05:55,960 --> 00:05:57,900
،بخصوص هذا

74
00:05:57,900 --> 00:06:01,970
.لا يسعني التحدث سوى هنا في السطح

75
00:06:01,970 --> 00:06:04,740
.أُفضّل ألّا تتحدثي إلي في الفصل

76
00:06:04,740 --> 00:06:05,870
لمَ؟

77
00:06:06,960 --> 00:06:09,580
...بخصوص هذا، الأمر معقّد

78
00:06:11,630 --> 00:06:15,100
.لا أظنني فهمت، لكن لا بأس

79
00:06:15,590 --> 00:06:18,590
.أراكِ لاحقًا يا فوجيميا-سان

80
00:06:23,310 --> 00:06:25,310
ماذا أفعل يا هاسي-كن؟

81
00:06:26,040 --> 00:06:28,220
.تصرّفي كعادتك

82
00:06:28,710 --> 00:06:32,200
.فلا نعلم أي نوعٍ من الأشخاص هيَ

83
00:06:34,610 --> 00:06:37,610
اليوم التالي

84
00:06:39,550 --> 00:06:41,740
.طاب صباحك يا فوجيميا-سان

85
00:06:42,350 --> 00:06:44,920
هل تفآجأتِ؟
.إنها أنا

86
00:06:44,920 --> 00:06:46,550
...ياماغيشي-سان

87
00:06:48,080 --> 00:06:51,350
.رائحتك زكيّة

88
00:06:52,040 --> 00:06:54,230
أي أنواع الشامبو تستخدمين؟

89
00:06:54,230 --> 00:06:58,000
...لا شيء مميز

90
00:06:58,000 --> 00:07:00,000
.طاب صباحك يا ساكي

91
00:07:00,000 --> 00:07:02,380
.مايكو-تشان، آي-تشان

92
00:07:02,380 --> 00:07:03,560
ما الخطب؟

93
00:07:03,560 --> 00:07:05,460
أحدث أمرٌ ما مع فوجيميا-سان؟

94
00:07:05,460 --> 00:07:07,550
.كنا نتحدث فحسب

95
00:07:07,550 --> 00:07:08,620
أليس كذلك؟

96
00:07:14,370 --> 00:07:17,900
.لقد تحدثت إليها للتو دون أدنى اهتمام

97
00:07:23,610 --> 00:07:25,410
.تريّثي يا فوجيميا-سان

98
00:07:25,410 --> 00:07:28,300
لدينا المقرر ذاته الحصة التالية، أليس كذلك؟

99
00:07:28,300 --> 00:07:29,590
.لنذهب سويةً

100
00:07:29,590 --> 00:07:31,710
،ياماغيشي-سان

101
00:07:32,330 --> 00:07:35,920
.طلبت منكِ البارحة ألّا تتحدثي إليّ سوى في السطح

102
00:07:36,340 --> 00:07:38,840
حقًا؟
ولمَ؟

103
00:07:38,840 --> 00:07:40,550
ألا تذكرين؟

104
00:07:40,550 --> 00:07:44,160
.أخال أنك قلتِ شيئًا عن ذلك

105
00:07:44,160 --> 00:07:46,850
لكن لمَ لا يسعني محادثتك؟

106
00:07:46,850 --> 00:07:48,620
أتمقتيني؟

107
00:07:48,620 --> 00:07:50,270
—ليس كذلك

108
00:07:50,270 --> 00:07:52,790
إذن بوسعي محادثتك، صحيح؟

109
00:07:53,910 --> 00:07:55,910
.هيا، لنذهب

110
00:07:55,910 --> 00:07:57,940
...تريّثي

111
00:07:58,620 --> 00:08:01,150
.ياماغيشي-سان، إنك تُلحّين كثيرًا

112
00:08:03,270 --> 00:08:05,160
.فوجيميا-سان

113
00:08:05,470 --> 00:08:09,130
.هناك جزءٌ لم أفهمه في واجب الرياضيات

114
00:08:09,130 --> 00:08:12,160
أبوسعك شرحه لي؟

115
00:08:12,160 --> 00:08:14,490
أين تذهبين؟

116
00:08:14,490 --> 00:08:16,790
...فوجيميا-سان

117
00:08:18,620 --> 00:08:20,080
أين أنتِ؟

118
00:08:20,080 --> 00:08:22,550
.ياغاميشي-سان، صوتك عالٍ

119
00:08:24,920 --> 00:08:26,140
.ها أنتِ ذا

120
00:08:26,750 --> 00:08:27,970
!تريّثي

121
00:08:28,330 --> 00:08:29,680
!مهلاً يا ياماغيشي-سان

122
00:08:32,360 --> 00:08:34,530
...المعلم إينوي

123
00:08:34,530 --> 00:08:36,430
.لا تركض في الرواق

124
00:08:36,430 --> 00:08:38,110
.المعذرة

125
00:08:44,400 --> 00:08:45,990
هل أنتِ بخير؟

126
00:08:45,990 --> 00:08:47,150
.أجل

127
00:08:47,150 --> 00:08:49,830
المعذرة، إن ياماغيشي-سان تفعل ما تريد
.دون الاكتراث لأحد

128
00:08:49,830 --> 00:08:51,950
.قد تكون مُلحّة بعض الشيء

129
00:08:53,550 --> 00:08:55,890
.إنها مرحة ومثيرة للاهتمام

130
00:08:56,410 --> 00:08:59,240
.متيقنةٌ أن تكوين صداقة معها سيكون ممتعًا

131
00:08:59,240 --> 00:09:01,550
إذن فأنتِ ترغبين بتكوين صداقةٍ معها؟

132
00:09:02,460 --> 00:09:05,390
.لكن، سأنسى أمرها إن حدث ذلك

133
00:09:05,390 --> 00:09:09,590
.ولا أرغب بنسيان أحد، لهذا السبب أتفادى محادثة العامّة

134
00:09:11,660 --> 00:09:14,030
ما رأيكِ بكسر تلك القاعدة؟

135
00:09:15,150 --> 00:09:19,630
.أنا مسرورٌ أننا أصبحنا أصدقاء

136
00:09:20,370 --> 00:09:23,200
.كنتُ محقًا بشأن استجماع شجاعتي لمحادثتك

137
00:09:23,200 --> 00:09:27,180
،قد يصيبك التوتّر في البداية، أو يعتريك الخوف حتى

138
00:09:27,180 --> 00:09:30,030
.لكني متيقنٌ أن الأمر لن يكون سيئًا

139
00:09:31,390 --> 00:09:34,830
.متيقنٌ بأن ياماغيشي-سان ترغب بأن تبدئي أنتِ بمحادثتها

140
00:09:37,370 --> 00:09:39,430
.شكرًا لك يا هاسي-كن

141
00:09:49,720 --> 00:09:51,600
...فوجيميا-سان

142
00:09:53,630 --> 00:09:55,410
أتحتاجين شيئًا؟

143
00:09:55,410 --> 00:09:56,640
،ياماغيشي-سان

144
00:09:57,120 --> 00:09:59,190
أبوسعي محادثتك؟

145
00:10:00,850 --> 00:10:05,770
ذكرياتك المتعلقة بأصدقائك تُمحى كل أسبوع؟

146
00:10:05,770 --> 00:10:09,850
.أجل، آسفة لمفاجأتك

147
00:10:09,850 --> 00:10:12,870
.أُدرك أنه أمرٌ جنونيّ ليُصدّق

148
00:10:13,590 --> 00:10:16,120
،لن أقول أنني لا أصدق هذا

149
00:10:16,120 --> 00:10:18,830
.لكنني لم أفهم هذا جيدًا

150
00:10:19,830 --> 00:10:22,970
ماذا تقصدين بقولك "ذكرياتك أصدقائك"؟

151
00:10:22,970 --> 00:10:24,710
ما معنى "تُمحى"؟

152
00:10:24,710 --> 00:10:26,740
أبوسعك شرحه بشكلٍ مبسّط؟

153
00:10:29,130 --> 00:10:32,070
.أنسى أمر أصدقائي

154
00:10:32,070 --> 00:10:33,490
نسيان أمر أصدقائك؟

155
00:10:33,490 --> 00:10:36,060
.أجل، كلّ يوم إثنين

156
00:10:37,880 --> 00:10:40,230
إذن، أنتِ مثلي

157
00:10:40,950 --> 00:10:43,420
.أنا كثيرة النسيان أيضًا

158
00:10:43,420 --> 00:10:46,270
.دائمًا ما أنسى أسماء الآخرين

159
00:10:46,270 --> 00:10:49,470
.حتى في بعض الأحيان أنسى أنني قد تحدثت إليهم

160
00:10:49,470 --> 00:10:51,070
...الأمر ليس كذلك

161
00:10:51,500 --> 00:10:52,490
.بالتأكيد هو كذلك

162
00:10:54,030 --> 00:10:58,490
تفقدين ذكرياتك في يومٍ معيّن، أليس كذلك؟

163
00:10:58,490 --> 00:11:03,910
.هذه الطريقة أفضل من فقدانها فجأةً، مثلي

164
00:11:04,570 --> 00:11:07,290
.إنك مدهشة

165
00:11:07,290 --> 00:11:09,110
مدهشة؟

166
00:11:09,110 --> 00:11:12,720
.لم أفكر بالأمر بهذه الطريقة

167
00:11:12,720 --> 00:11:16,520
.إنك تبالغين بالتفكير بالأمر

168
00:11:16,520 --> 00:11:20,730
.الأفضل أن تسترخي وتستمتعي بالحياة

169
00:11:21,070 --> 00:11:25,400
فالأشخاص عادةً على أتم الاستعداد لمساعدة
.كثيروا النسيان

170
00:11:25,400 --> 00:11:30,810
بالنسبة لحالتي، ما يقوله الأشخاص هو أنني
.أتهرب من مشاكلي غالبًا

171
00:11:33,940 --> 00:11:36,740
.أخال أنه لا بأس بكِ بطبيعتك

172
00:11:37,810 --> 00:11:41,870
.إنك لطيفة حين تعلوا الابتسامة وجنتك

173
00:11:43,200 --> 00:11:46,170
.سأبدأ بمناداتك كاوري-تشان

174
00:11:46,170 --> 00:11:48,710
.لذا، بوسعك مناداتي باسمي الأول أيضًا

175
00:11:51,150 --> 00:11:53,400
ساكي-تشان؟

176
00:11:53,400 --> 00:11:54,630
.أجل، أجل

177
00:11:56,550 --> 00:11:59,760
!أنا مسرورة كوننا نستخدم أسمائنا الأولى لمناداة بعضنا

178
00:12:00,170 --> 00:12:03,350
.أنا مسرورة لأننا أصدقاء أيضًا

179
00:12:03,350 --> 00:12:06,670
.أتسائل إن كانت فوجيميا-سان قادرة على محادثتها

180
00:12:06,670 --> 00:12:09,440
.على الأرجح أنك تودّ القلق على نفسك عوضًا عنها

181
00:12:10,350 --> 00:12:11,910
.إنها تتناول غدائك

182
00:12:12,650 --> 00:12:15,570
.ايتاداكيماس

183
00:12:15,950 --> 00:12:19,370
!توقفي

184
00:12:25,040 --> 00:12:27,750
.شكرًا على الطعام

185
00:12:28,080 --> 00:12:31,170
...لم يتبقى شيءٌ مطلقًا

186
00:12:31,170 --> 00:12:34,770
.لقد تناولتِ الطعام سريعًا يا ياغاميشي-سان

187
00:12:34,770 --> 00:12:38,190
.المعذرة يا هاسي-كن، لقد أرادت تذوّقه

188
00:12:38,190 --> 00:12:40,740
.لقد كان لذيذًا، لم استطع التوقف

189
00:12:40,740 --> 00:12:43,440
.إنك جيّدة في الطبخ يا كاوري-تشان

190
00:12:43,440 --> 00:12:45,060
.شكرًا يا ساكي-تشان

191
00:12:46,180 --> 00:12:48,270
!منذ متى بدأتما بمناداة بعضكما بأسمائكما الأولى؟

192
00:12:48,620 --> 00:12:53,990
كما أنه لدينا موعدٌ بعد المدرسة غدًا، صحيح؟

193
00:12:53,990 --> 00:12:55,240
.أجل

194
00:12:56,080 --> 00:12:58,240
!موعد؟

195
00:12:58,240 --> 00:13:01,240
الجمعة

196
00:13:05,420 --> 00:13:07,250
.كاوري-تشان

197
00:13:07,700 --> 00:13:09,510
.شكرًا لانتظارك

198
00:13:10,520 --> 00:13:13,090
.كان علينا أن نلتقي في المحطة

199
00:13:13,090 --> 00:13:14,260
لمَ؟

200
00:13:15,800 --> 00:13:18,630
.سينشر الناس إشاعات عنكِ إن رأوكِ برفقتي

201
00:13:21,510 --> 00:13:22,980
.لنذهب

202
00:13:22,980 --> 00:13:24,270
—تريّثي

203
00:13:24,270 --> 00:13:26,230
.لا يهمّ، لنذهب

204
00:13:30,420 --> 00:13:31,190
.صحيح

205
00:13:31,610 --> 00:13:34,070
.هناك مكان عليّ زيارته اليوم

206
00:13:34,070 --> 00:13:35,440
.تعال معي

207
00:13:35,440 --> 00:13:36,940
ستتبعهم، أليس كذلك؟

208
00:13:36,940 --> 00:13:38,640
حسنًا، ألا ينتابك الفضول؟

209
00:13:38,640 --> 00:13:40,320
!إنهما فتاتيْن يخرجان في موعد

210
00:13:41,280 --> 00:13:45,490
.أعني أنّ عليّ التأكد من انسجامهما

211
00:13:45,490 --> 00:13:47,170
حقًا؟
.ابذل جهدك

212
00:13:47,170 --> 00:13:48,290
.سأعود للمنزل

213
00:13:48,290 --> 00:13:50,350
!أرجوك لا تدعني وحدي

214
00:13:50,350 --> 00:13:54,130
إن اكتشفت فوجيميا-سان أنني أتتبعها وحدي، ستخال
.أني غريب الأطوار

215
00:13:54,520 --> 00:13:57,010
.إنك غريب الأطوار في كل الأحوال

216
00:13:57,010 --> 00:13:59,380
!سأبتاع لك فطيرة البيض، هيا تعال

217
00:14:05,180 --> 00:14:08,580
.لطالما أردت تجربة الكريبي هنا

218
00:14:08,580 --> 00:14:09,770
.وأنا أيضًا

219
00:14:10,070 --> 00:14:11,040
!وأنا كذلك

220
00:14:11,040 --> 00:14:13,360
.رغم ذلك، أرغمتني على مرافقتك

221
00:14:13,360 --> 00:14:17,080
.لقد أتيت برفقة هاسي-كن أيضًا سابقًا

222
00:14:17,080 --> 00:14:21,230
.لكنه كان مغلقًا، لذا لم نتمكن من تناول شيء

223
00:14:21,230 --> 00:14:23,530
.سيكون بوسعك ملء معدتك هذه المرة

224
00:14:24,570 --> 00:14:26,230
.المعذرة يا هاسي-كن

225
00:14:29,080 --> 00:14:30,370
.إنه لذيذ

226
00:14:30,370 --> 00:14:31,720
.إنك محقة

227
00:14:31,720 --> 00:14:34,220
ألا بأس بقضمة؟

228
00:14:35,980 --> 00:14:38,460
.اهدأ، إنهما فتاتيْن

229
00:14:38,780 --> 00:14:40,970
.بوسعك أخذ قضمة يا كاوري-تشان

230
00:14:43,710 --> 00:14:44,930
ما الخطب؟

231
00:14:44,930 --> 00:14:46,480
.أنا سعيدة

232
00:14:47,040 --> 00:14:50,860
الأصدقاء يتشاركون طعامهم دائمًا، صحيح؟

233
00:14:50,860 --> 00:14:53,790
.لقد شاهدت هذا في المانغا، لذا لطالما أردت تجربته

234
00:14:56,290 --> 00:14:57,110
...لذيذ

235
00:14:57,490 --> 00:15:02,280
.أجل
.مشاركة الأشياء اللذيذة والأوقات المرحة، هذا مايفعله الأصدقاء

236
00:15:10,750 --> 00:15:13,970
.لطالما أردت الذهاب للتسوّق برفقة صديق أيضًا

237
00:15:14,470 --> 00:15:18,260
.كالذهاب لمحلات الموضة والتحقق من كافة الملابس الرائعة

238
00:15:18,260 --> 00:15:20,130
...كاوري-تشان

239
00:15:22,820 --> 00:15:24,050
أيبدو جيدًا؟

240
00:15:24,050 --> 00:15:26,450
!أجل، إنه جذابٌ حقًا

241
00:15:26,450 --> 00:15:29,090
.يجدر بك تجربة واحدة أيضًا

242
00:15:30,020 --> 00:15:31,750
هل انتهيتِ؟

243
00:15:31,750 --> 00:15:32,690
...أجل

244
00:15:34,020 --> 00:15:36,420
!جذّاب

245
00:15:36,420 --> 00:15:38,610
.هذا محرج نوعًا ما

246
00:15:38,610 --> 00:15:41,670
.هذه ليست ملابس حتى
.إنها أزياء حيوانات

247
00:15:41,670 --> 00:15:44,400
.ما ترتديه فوجيميا-سان ملائمٌ لها

248
00:15:47,630 --> 00:15:49,650
لأين ترغبين بالذهاب الآن؟

249
00:15:49,650 --> 00:15:50,830
.لا أعلم

250
00:15:51,200 --> 00:15:54,030
.أرغب بشرب العصير، لكن الكاراوكي يبدو جيدًا كذلك

251
00:15:54,030 --> 00:15:55,550
...وبعد ذلك

252
00:15:56,890 --> 00:16:00,850
هناك العديد من الأمور التي لطالما أردت
.تجربتها برفقة صديق

253
00:16:01,840 --> 00:16:06,770
.خلت أنكِ أكثر رشدًا وتحفّظًا

254
00:16:06,770 --> 00:16:08,020
هل أحبطتك؟

255
00:16:08,020 --> 00:16:12,180
.كلا، أنا مسرورة لرؤية جانبك الآخر

256
00:16:12,780 --> 00:16:14,390
.شكرًا

257
00:16:14,390 --> 00:16:17,610
.يبدو أن فوجيميا-سان تحظى بالمرح

258
00:16:18,290 --> 00:16:20,090
.أكثر مما كانت عليه عندما كانت برفقتي

259
00:16:28,540 --> 00:16:31,000
.اليوم كان ممتعًا

260
00:16:31,790 --> 00:16:33,510
ماذا تفعلين؟

261
00:16:34,010 --> 00:16:37,550
.أدوّن كل شيءٍ حدث اليوم في مذكرتي

262
00:16:37,550 --> 00:16:40,240
.أرغب بأن يكون لديّ سجلاً عنه على الأقل

263
00:16:40,820 --> 00:16:43,070
.لقد حظينا بالكثير من المتعة

264
00:16:43,070 --> 00:16:46,090
.محال أن تنسيْ كل هذا يوم الإثنين

265
00:16:48,880 --> 00:16:50,760
...سيكون ذلك رائعًا

266
00:16:51,450 --> 00:16:55,520
.لكنني لن أتعرف عليك في المدرسة، حسبما أخال

267
00:16:56,160 --> 00:16:57,520
حقًا؟

268
00:16:58,310 --> 00:17:00,590
.شكرًا لكِ على اليوم يا ساكي-تشان

269
00:17:00,590 --> 00:17:05,190
.لم أخَل مطلقًا أنه سيأتي يوم أكوّن فيه صداقات كالجميع

270
00:17:07,230 --> 00:17:09,280
.ولا أنا كذلك

271
00:17:13,250 --> 00:17:15,230
.أتسائل عمّا يتحدثون

272
00:17:15,230 --> 00:17:16,710
من يعلم؟

273
00:17:16,710 --> 00:17:19,730
.تبدو ياماغيشي-سان فتاة لطيفة ومرحة

274
00:17:19,730 --> 00:17:22,140
.أجل
.فقد تغيّرت كثيرًا

275
00:17:23,890 --> 00:17:27,880
.كنّا في الفصل ذاته في المرحلة الإبتدائية

276
00:17:28,540 --> 00:17:31,340
حقًا؟
لمَ كتمتَ الأمر؟

277
00:17:31,340 --> 00:17:33,480
.لأني لم أرغب بأن أكون مزعجًا

278
00:17:33,480 --> 00:17:36,640
.علاوةً على هذا، فهي لم تتذكر اسمي حتى

279
00:17:37,440 --> 00:17:42,290
.آنذاك، كانت كثيرة النسيان وتعيش بعالمها الخاص

280
00:17:42,290 --> 00:17:44,890
.كانوا يسخرون منها طوال الوقت

281
00:17:44,890 --> 00:17:46,650
.عاملوها بقسوة

282
00:17:47,260 --> 00:17:51,790
.كانت تبكي دائمًا، والذهاب للمدرسة كان صعبًا بالنسبة لها

283
00:17:51,790 --> 00:17:53,620
حقًا؟

284
00:17:53,620 --> 00:17:57,000
.لكنني أحظى بمرحٍ كثير الآن

285
00:17:57,000 --> 00:18:01,080
.لديّ أصدقاء، ولم أعد وحيدة بعد الآن

286
00:18:01,430 --> 00:18:06,880
.والآن بما أننا أصدقاء، أنا متيقنةٌ أننا سنحظى بمتعةٍ أكثر

287
00:18:09,670 --> 00:18:13,620
.والآن... من الأفضل أن أذهب

288
00:18:17,270 --> 00:18:20,190
.حسنٌ، أراك يوم الإثنين

289
00:18:34,940 --> 00:18:37,290
!كاوري-تشان

290
00:18:38,210 --> 00:18:40,430
.إلى اللقاء

291
00:18:42,310 --> 00:18:44,270
!إلى اللقاء

292
00:19:04,900 --> 00:19:06,380
...فوجيميا-سان

293
00:19:11,780 --> 00:19:15,450
الإثنين

294
00:19:20,000 --> 00:19:21,300
.ها هيَ

295
00:19:21,300 --> 00:19:22,580
.طاب صباحك

296
00:19:41,030 --> 00:19:42,180
.طاب صباحك

297
00:19:50,070 --> 00:19:51,920
من أنتِ؟

298
00:20:05,770 --> 00:20:06,880
.مدهش

299
00:20:07,460 --> 00:20:11,270
!إنه حقيقي
!لقد نسيتِ فعلاً

300
00:20:11,270 --> 00:20:14,470
.إنها أنا ياماغيشي ساكي

301
00:20:15,060 --> 00:20:17,030
ساكي-تشان؟

302
00:20:17,030 --> 00:20:22,600
!أجل
.تناولنا الكريبي وذهبنا للتسوق وتحدثنا كثيرًا سويةً

303
00:20:26,470 --> 00:20:28,510
.تشاركنا الكريبي

304
00:20:28,510 --> 00:20:29,820
.أجل، أجل

305
00:20:29,820 --> 00:20:31,080
،ساكي

306
00:20:31,080 --> 00:20:33,380
.قدّمينا إليها

307
00:20:33,380 --> 00:20:38,390
.حسنًا
.للعلم، إن كاوري-تشان كثيرة النسيان أكثر مني

308
00:20:38,390 --> 00:20:41,160
.محال، لا يمكن هذا

309
00:20:41,160 --> 00:20:44,830
.لا أحد يتغلب عليك في النسيان

310
00:20:45,260 --> 00:20:49,350
.حتى أنكِ نسيتِ احضار حقيبتك للمدرسة ذلك اليوم

311
00:20:49,350 --> 00:20:53,450
.رغم أنكِ أحضرتِ غدائك

312
00:20:53,450 --> 00:20:55,630
أحدث ذلك حقًا؟

313
00:20:56,930 --> 00:20:59,780
...كما أنّ كاوري-تشان

314
00:21:03,980 --> 00:21:07,520
.تغدو لطيفة عندما تعلوا الابتسامة وجنتها

315
00:21:16,480 --> 00:21:18,320
.لا يسعك التجهّم

316
00:21:18,790 --> 00:21:20,280
.ابتسمي

317
00:21:27,400 --> 00:21:32,490
.قبل أن أدرك ذلك، تلاشت القاعدة التي قيّدتنا

318
00:21:32,490 --> 00:21:33,630
...وأيضًا

319
00:21:34,490 --> 00:21:37,660
.يبدو أنهم ينسجمون

320
00:21:37,660 --> 00:21:38,260
.أجل

321
00:21:42,130 --> 00:21:44,080
...أقامت للتو بـ

322
00:21:44,080 --> 00:21:46,910
.لقد تعرّفت علينا

323
00:21:46,910 --> 00:21:48,480
.رغم أنه يوم الإثنين

324
00:21:52,020 --> 00:21:55,780
،ببطئ، لكن بلا ريب

325
00:21:55,780 --> 00:21:59,030
.أشعر أننا نحرز تقدمًا

326
00:22:59,470 --> 00:23:05,600
اقرئي المفكّرة التي

327
