1
00:00:05,980 --> 00:00:10,020
هذا السّهم ثمينٌ جداً ولديّ واحد فقط

2
00:00:10,390 --> 00:00:12,830
.إنّه هدفي الثّمين

3
00:00:13,420 --> 00:00:15,530
.كلّ ما عليّ هو استرداده فحسب

4
00:00:17,610 --> 00:00:20,990
إيّاك أن تنتزع ذلك السّهم، سيجعلُه ينزفُ أكثر

5
00:00:23,030 --> 00:00:28,380
لأنّ أخي الصغير غبيّ، عليّ أن أقتلك حالاً

6
00:00:28,930 --> 00:00:32,690
ما يعني بأنّه لن يكون من الجيّد
أن يحلّ أي مكروه بهذا السهم

7
00:00:32,690 --> 00:00:36,680
إذا صدفَ وأن رأتْه الجارة أو انكسر
إلى نصفَين فستكونُ مصيبة

8
00:00:37,370 --> 00:00:39,700
أنا رجلٌ مُرتّبٌ جداً كما ترى

9
00:00:39,700 --> 00:00:42,930
لهذا أريدُ أن أحرص على إبعاد السّهم بعناية

10
00:00:43,240 --> 00:00:47,360
أثناء استماعك للإسطوانات الليزريّة
فإنّك تضعُ الإسطوانة الأولى بعناية في علبتِها

11
00:00:47,360 --> 00:00:50,440
قبل الاستماع للإسطوانة الثانية، صحيح؟

12
00:00:50,860 --> 00:00:52,600
الجميع هكذا

13
00:00:52,980 --> 00:00:54,570
أنا كذلك أيضاً

14
00:00:57,820 --> 00:01:00,820
هل ستدخلُ هذا المنزل؟

15
00:01:00,820 --> 00:01:02,300
!فكِّر قبل أن تتكلّم

16
00:01:02,300 --> 00:01:07,410
إن لم أدخل فلا أستطيع سحقك
ومُعالجة جِراح كويتشي

17
00:01:08,530 --> 00:01:11,760
!أخي، لم أخسر بعد

18
00:01:11,760 --> 00:01:14,050
!توقّف عن مُهاجمته

19
00:01:14,050 --> 00:01:14,840
مُهاجمته؟

20
00:01:15,250 --> 00:01:19,010
!لم ننتهِ بعد

21
00:01:19,870 --> 00:01:21,220
...ثمّة شيء قادم من

22
00:01:21,850 --> 00:01:23,100
!ظلام السّقف

23
00:02:56,820 --> 00:02:58,170
...أوكوياسو

24
00:02:58,590 --> 00:03:01,090
أنت تدهشُني باستمرار أيُّها الغبيّ

25
00:03:01,730 --> 00:03:03,860
،لو لم تقتحم هذا المكان

26
00:03:03,860 --> 00:03:08,010
لكان الستاند الخاصّ بي، باد كومباني
قد هاجمَ جوسكي بالتأكيد

27
00:03:08,010 --> 00:03:11,980
وفي الواقع لقد اعترضتَ مسارَ هجمته

28
00:03:12,280 --> 00:03:14,770
...أخي

29
00:03:14,770 --> 00:03:19,360
إنّ الستاند الخاصّ بك، ذا هاند، هو ستاند مُرعبNلكنّك عاجز تماماً

30
00:03:19,360 --> 00:03:22,720
قلتُ لك مراراً وتكراراً مُذ كنّا صغيرَين

31
00:03:22,720 --> 00:03:25,660
بأنّ الضُّعفاء يُتعِبون من حولهم، أليس كذلك؟

32
00:03:26,300 --> 00:03:31,930
قلتُ لك مراراً وتكراراً بأنّ وحدهم أولئك
الذين يتطوّرون باستمرار من يحقّ لهم العيش، أليس كذلك؟

33
00:03:32,710 --> 00:03:35,200
ما بالُ جِراحه؟

34
00:03:35,560 --> 00:03:38,540
ما طبيعة الهجمة التي جعلَتْك تُصابُ بجروح كهذه؟

35
00:03:39,020 --> 00:03:41,600
على أي حال، يبدو أنّ هناك مُشكلة ما تحدثُ هنا

36
00:03:42,220 --> 00:03:43,770
،أخي الصّغير

37
00:03:43,770 --> 00:03:48,770
!أعتقدُ أنه من البديهيّ أن يموت الخرقى أمثالك

38
00:03:51,100 --> 00:03:52,770
!أحدثَ عدداً كبيراً من الثّقوب مجدداً

39
00:03:52,770 --> 00:03:55,200
ما طبيعة تِلك الهجمة؟

40
00:03:55,520 --> 00:03:57,800
!الألماسة السّاطعة

41
00:04:00,590 --> 00:04:03,370
!أتحاولُ مُهاجمة أخيك أيضاً؟

42
00:04:12,990 --> 00:04:15,290
...جوسكي هيغاشيكاتا

43
00:04:17,350 --> 00:04:21,210
أنا واثقٌ أنّه لن يتركَ هذا الطفل المدعو كويتشي

44
00:04:22,100 --> 00:04:24,960
سيدخلُ إلى هنا مجدّداً على الأرجح

45
00:04:26,880 --> 00:04:29,100
...سأقتله مهما كلّف الأمر

46
00:04:29,610 --> 00:04:33,010
سأقتلُ أي شخص يعترضُ هدفَ هذا
القوس والسّهم

47
00:04:34,070 --> 00:04:36,690
!كائناً من يكون

48
00:04:43,600 --> 00:04:47,820
حسناً إذاً... ما رأيك أن تحدّثني عن الستاند
الخاصّ بأخيك؟

49
00:04:49,990 --> 00:04:52,050
!أخبرني عن طبيعة الستاند الخاصّ به

50
00:04:52,050 --> 00:04:54,500
إن أخبرتَني فسأعالج جراحك

51
00:04:55,460 --> 00:04:59,640
...من المُحال... أن أخبرك

52
00:04:59,980 --> 00:05:01,530
...أحمق

53
00:05:01,940 --> 00:05:03,550
كما توقّعت

54
00:05:05,180 --> 00:05:09,190
حسناً إذاً... أظنُّني لا أملُك خياراً

55
00:05:15,730 --> 00:05:20,830
سأدخلُ إلى هناك مجدّداً، لِذا لا تعترض طريقي يا أوكوياسو

56
00:05:21,140 --> 00:05:24,300
!لا يمتلك كويتشي كثيراً من الوقت

57
00:05:35,000 --> 00:05:39,510
يهاجمُ الستاند الخاصّ به من مكان ما
داخل هذا الظلام

58
00:05:40,270 --> 00:05:43,570
الدّخول إلى هنا غاية في الخطورة

59
00:05:44,790 --> 00:05:48,270
لا أملُك خياراً سوى استخدام كافّة حواسي
بتركيز كامل

60
00:05:48,440 --> 00:05:49,620
!انتظر لحظة

61
00:05:50,520 --> 00:05:54,300
جوسكي؟ لماذا عالجتَ جراحي؟

62
00:05:54,300 --> 00:05:56,150
اصمت، سأخبرُك لاحقاً

63
00:05:56,150 --> 00:06:01,100
قد أُهاجمك، فأنا عدوّك

64
00:06:01,100 --> 00:06:02,280
أتريدُ أن تقاتلني؟

65
00:06:02,280 --> 00:06:06,540
بعدما استمعتُ لإجابتك، لماذا عالجتَ جِراحي؟

66
00:06:06,540 --> 00:06:10,830
أنا لستُ ذكياً جداً، لِذا يتوجّبُ عليك أن تخبرني

67
00:06:10,830 --> 00:06:12,980
!وذلك الجرح في يدِك

68
00:06:12,980 --> 00:06:16,170
تلقّيتَه عندما كنتَ تسحبُني للخارج، أليس كذلك؟

69
00:06:16,460 --> 00:06:21,180
أريدُ أن أعرف سبب قيامك بكلّ هذا لإنقاذي

70
00:06:22,840 --> 00:06:25,110
لا يوجدُ سببٌ وجيه

71
00:06:26,430 --> 00:06:28,400
"لا سبب يدفعُه للموت"

72
00:06:28,960 --> 00:06:31,090
.هذا ما خطرَ في ذهني آنذاك

73
00:06:40,510 --> 00:06:41,830
...كويتشي

74
00:06:50,950 --> 00:06:52,860
يؤدّي الأثر إلى الطابق العلوي

75
00:07:11,610 --> 00:07:14,620
لا يزالُ في جُعبتي مزيد من الأسئلة يا جوسكي

76
00:07:14,230 --> 00:07:15,440
!ما مُشكلتك؟

77
00:07:15,440 --> 00:07:17,440
أتوسّلُ إليك، دعني أنقذُ كويتشي فحسب

78
00:07:16,820 --> 00:07:18,580
!لماذا؟

79
00:07:18,580 --> 00:07:22,690
لِمَ لا تستخدِم قِوى الستاند الخاصّ بك
لمُعالجة يدك؟

80
00:07:22,690 --> 00:07:26,590
ينبغي لك أن تعالجها فحسب كما فعلتَ بوجهي

81
00:07:27,620 --> 00:07:32,090
لا يستطيعُ الألماسة السّاطعة مُعالجة جراحي

82
00:07:32,730 --> 00:07:36,850
هذا يعني أنّ الحياة ليسَتْ بتلك السهولة فحسب

83
00:07:37,320 --> 00:07:38,970
والأهمّ من ذلك

84
00:07:39,380 --> 00:07:42,110
لا أستطيع إنقاذ الأشخاص الذين ماتوا

85
00:07:43,980 --> 00:07:46,230
دعني أقولُ شيئاً واحداً فقط يا أوكوياسو

86
00:07:46,230 --> 00:07:51,450
إن مات كويتشي، فلا أحد يعلمُ ما قد أفعله بأخيك

87
00:07:51,450 --> 00:07:55,860
لِذا لا تكنّ ضغينة اتّجاهي، أخوك من سبّبَ
كلّ هذه المتاعب

88
00:07:56,910 --> 00:08:00,530
هل فهمت؟ إن فهمتَ فاخرج إذاً

89
00:08:17,250 --> 00:08:18,140
!كويتشي

90
00:08:18,990 --> 00:08:21,820
اللّعنة... هذا فخٌّ حقيقيّ

91
00:08:21,820 --> 00:08:25,300
ينوي مُهاجمتي من مكانٍ ما حالما
أقتربُ من كويتشي

92
00:08:25,300 --> 00:08:26,560
...لكن

93
00:08:26,560 --> 00:08:30,600
حتّى لو علِمتُ بأنّه فخّ، لا أملُك خياراً سوى الذهاب

94
00:08:30,600 --> 00:08:34,200
!لم يتبقَّ لكويتشي حتّى ثوانٍ معدودات

95
00:08:36,350 --> 00:08:37,120
!ماذا؟

96
00:08:37,510 --> 00:08:38,990
أوكوياسو، أيُّها الحقير

97
00:08:38,990 --> 00:08:41,290
!جوسكي

98
00:08:45,140 --> 00:08:46,080
...كويتشي قد

99
00:08:47,160 --> 00:08:52,110
لأنّني غبيّ، أتصرّفُ بحسَبِ هوايّ

100
00:08:52,460 --> 00:08:55,710
هذه المرّة، سأردُّ لك الجميل
هذه المرّة فقط

101
00:08:55,710 --> 00:08:57,340
ولن أفعل شيئاً آخر

102
00:08:57,340 --> 00:09:01,410
لن أساعد أخي ولن أفعل شيئاً لك أيضاً

103
00:09:02,470 --> 00:09:04,290
نقطة انتهى

104
00:09:07,650 --> 00:09:10,610
هذا رائع فحسب يا أوكوياسو

105
00:09:19,320 --> 00:09:22,460
كنتَ بخطر جسيم يا كويتشي

106
00:09:22,460 --> 00:09:24,460
يسرُّني أنك استفقت

107
00:09:24,460 --> 00:09:26,110
كم إصبع هذه؟

108
00:09:27,630 --> 00:09:28,760
...خمسة

109
00:09:28,760 --> 00:09:32,580
،عـ-علِق رأسي بين البوّابتَين

110
00:09:32,580 --> 00:09:34,470
...ومن ثمّ

111
00:09:35,680 --> 00:09:37,770
أ-أين نحن؟

112
00:09:37,770 --> 00:09:42,230
ذلك الظرف الخطير الذي كنّا فيه
قبل قليل لم ينتهِ بعد يا كويتشي

113
00:09:42,230 --> 00:09:47,030
أريدُ أن أنزل هذا الدّرج وأهمّ بالخروج

114
00:09:47,660 --> 00:09:51,970
لكن لا أدري ما إن كان أخُ أوكوياسو
...سيدعُنا نخرجُ بأمان

115
00:09:59,140 --> 00:10:01,360
من المؤكّد أنه يوجد شيء ما في الأعلى

116
00:10:01,360 --> 00:10:04,790
شيء يقبع في ظِلال السّقف

117
00:10:08,840 --> 00:10:09,720
ما هذا؟

118
00:10:09,720 --> 00:10:12,100
مرّ شيء سريعٌ جداً

119
00:10:12,100 --> 00:10:14,240
جوسكي، ما الذي يجري؟

120
00:10:14,240 --> 00:10:17,730
كويتشي، أنا متأكّدٌ أنّك لا تملُك أدنى فكرة
عمّا يجري الآن

121
00:10:17,730 --> 00:10:20,690
حالياً، لا تطرح أي سؤال واقترب منّي

122
00:10:21,270 --> 00:10:24,160
في السّابق، كان مخيفاً لأنّني لم أستطع رؤيته

123
00:10:24,160 --> 00:10:26,760
لكن أشعرُ براحة أكبرٍ الآن بعدما رأيتُه

124
00:10:26,760 --> 00:10:29,570
يبدو وكأنّه ضئيل وضعيف القوّة

125
00:10:31,490 --> 00:10:35,490
ستنتهي هذه المعركة بإرسالي للألماسة السّاطعة

126
00:10:35,490 --> 00:10:39,260
وراء ذلك الضئيل حالما يظهر

127
00:10:40,750 --> 00:10:42,000
!ها أنت ذا

128
00:10:43,340 --> 00:10:45,090
ما الأمر؟ هنالِك عددٌ كبيرٌ منهم

129
00:10:45,090 --> 00:10:46,710
...وذلك الزيّ

130
00:10:48,820 --> 00:10:49,930
...ما-ماذا

131
00:10:53,860 --> 00:10:56,640
...تهبطُ مجموعة من الرّجال التي تشبه جنود الدّمى

132
00:10:57,010 --> 00:10:59,600
أهذا هو الستاند الخاصّ بأخِ أوكوياسو؟

133
00:11:01,270 --> 00:11:02,400
!مؤلم

134
00:11:03,150 --> 00:11:04,320
!أيُّها الحقير

135
00:11:09,970 --> 00:11:14,450
أعتقدُ أنّ مهاجمة اثنين أو ثلاثة
لن يلحق ضرراً كافياً

136
00:11:14,450 --> 00:11:18,040
والجروح بسيطة، لكن قوّتهم التدميريّة كبيرة حقاً

137
00:11:18,460 --> 00:11:22,180
سنتأذّى كثيراً إن قاتلنا هؤلاء

138
00:11:23,170 --> 00:11:28,710
منذُ أن قرّرَ أوكوياسو أن يتدخّل وينقذ ذلك الطفل

139
00:11:28,710 --> 00:11:30,690
انحرفَتْ خطّتي عن المسار

140
00:11:30,690 --> 00:11:34,210
...لكن لن يغادرا هذا المنزل

141
00:11:34,210 --> 00:11:40,340
ولن يُغادرا ساحة معركة الستاند الخاصّ بي
باد كومباني

142
00:11:43,670 --> 00:11:43,850
اس

143
00:11:43,710 --> 00:11:43,930
اسم

144
00:11:43,750 --> 00:11:43,970
اسم ا

145
00:11:43,840 --> 00:11:44,060
اسم ال

146
00:11:44,250 --> 00:11:47,050
:اسم الستاند

147
00:11:44,430 --> 00:11:47,050
:اسم المالِك

148
00:11:51,300 --> 00:11:53,560
باد كومباني؟

149
00:11:56,370 --> 00:11:58,430
...جوسكي، ما-ماذا

150
00:11:58,430 --> 00:11:59,480
.لا تطرح الأسئلة

151
00:11:59,480 --> 00:12:02,070
أنا متأكّدٌ أنّك لا تفهم، لكن اصمت وتراجع فحسب

152
00:12:02,070 --> 00:12:03,290
!نحنُ في ورطة حقيقيّة الآن

153
00:12:03,290 --> 00:12:05,550
!إلى كافّة الوحدات، توقّفي

154
00:12:06,180 --> 00:12:08,740
...استعداد، تصويب

155
00:12:10,320 --> 00:12:11,700
!إطلاق

156
00:12:13,020 --> 00:12:14,890
!إلى اليسار

157
00:12:15,290 --> 00:12:16,720
!إطلاق

158
00:12:22,080 --> 00:12:24,600
كما توقّعت، تِلك قوّة تدميريّة كافية لتفجير

159
00:12:24,600 --> 00:12:26,070
!أطرافنا إن أصابَتْنا بشكل مُباشَر

160
00:12:27,510 --> 00:12:29,630
لحسنِ حظّنا أن هناك بعض النوافذ

161
00:12:29,630 --> 00:12:31,790
،كويتشي، هذا هو الطابقُ الثاني

162
00:12:31,790 --> 00:12:34,010
لكن سنكسرُ تِلك النّوافذ ونقفز منها

163
00:12:35,170 --> 00:12:37,400
...أظنُّني كنتُ ساذجاً قليلاً

164
00:12:41,950 --> 00:12:45,520
رائع فحسب... هل لديهم مروحياتٌ أيضاً؟

165
00:12:45,520 --> 00:12:49,410
تُشبِه مروحيات الجيش الأمريكي، أباتشي

166
00:12:51,630 --> 00:12:53,430
!انتبه، هنالك دبّابة

167
00:13:05,640 --> 00:13:07,730
معك حقّ، لديهم دبّابات أيضاً

168
00:13:08,240 --> 00:13:10,020
...كويتشي، كُن حذ

169
00:13:10,020 --> 00:13:11,070
ماذا؟

170
00:13:11,070 --> 00:13:15,490
ما-ماذا قلتَ للتو يا كويتشي؟ هل يمكنُك رؤيتها؟

171
00:13:15,490 --> 00:13:18,120
...هذه الجنود والدبّابات والمروحيّات

172
00:13:18,120 --> 00:13:19,300
هل يمكنُك رؤيتها بوضوح؟

173
00:13:20,110 --> 00:13:24,610
نعم، لستُ أفهم ما يجري، لكن أستطيعُ رؤيتها

174
00:13:24,610 --> 00:13:29,020
هل يُعقَلُ أن تكون قد أصبحتَ مُستخدِم
ستاند بعدما أصابَك ذلك السّهم؟

175
00:13:29,020 --> 00:13:32,330
هل أصبح القزمُ إذاً

176
00:13:33,380 --> 00:13:38,750
يمتلكُ قوّة استخدام ستاند الآن؟

177
00:13:39,420 --> 00:13:42,740
ها أنتَ ذا، الأخُ الكبير لأوكوياسو

178
00:13:42,740 --> 00:13:47,090
تتحلّى ببعض من الجرأة كاشِفاً عن نفسك بهذا الشّكل

179
00:13:50,310 --> 00:13:54,230
الستاند الخاصّ بي، باد كومباني
يتمتّعُ بدِفاعٍ حصين

180
00:13:54,230 --> 00:13:58,760
إنّه جيش لن يدع أيّ غازٍ يغادرُ حيّاً

181
00:13:58,760 --> 00:14:01,500
...أنا متأكّدٌ أنك تودُّ هزيمتي

182
00:14:02,890 --> 00:14:08,200
لكن دعني أقولُ لك الآن أنّ هجمات
ألماستك السّاطعة

183
00:14:08,200 --> 00:14:10,300
لن تطالني أبداً

184
00:14:12,450 --> 00:14:18,680
انظر، هل ترى تشكيلَ جيشي الجميل؟

185
00:14:18,680 --> 00:14:23,480
إلى كافّة الوحدات، حِفاظ على تشكيل المعركة
وضعيّة الاستراحة

186
00:14:24,810 --> 00:14:28,860
شعور جميل أن أراهم مُصطفِّين بأناقةٍ معاً

187
00:14:28,860 --> 00:14:32,310
مع أنّني منزعج قليلاً من انحرافِ تشكيلهم

188
00:14:32,310 --> 00:14:36,290
قليلاً بعدما قتلتَ اثنين أو ثلاثة منهم

189
00:14:36,890 --> 00:14:39,280
أنت مرتّبٌ حقاً

190
00:14:39,280 --> 00:14:42,790
هل خرجتَ إلى هنا لتشرح ذلك فحسب؟

191
00:14:42,790 --> 00:14:45,370
لا، سبب خروجي إلى هنا

192
00:14:45,370 --> 00:14:47,760
هو لمُراقبتك أيُّها الفتى

193
00:14:48,500 --> 00:14:50,000
أ-أنا؟

194
00:14:50,000 --> 00:14:51,200
نعم

195
00:14:51,200 --> 00:14:53,430
كويتشي، صحيح؟

196
00:14:53,430 --> 00:14:57,700
يبدو أنّك كنتَ، وبالرُّغم من توقُّعاتي
مؤهّلاً لتُصبح مستخدِم ستاند

197
00:14:57,700 --> 00:15:01,820
أظهِر الستاند الخاصّ بك حالاً وأرِني
ما الذي يستطيعُ فعله

198
00:15:01,820 --> 00:15:07,470
قد تمتلك القدرة التي كنتُ أبحثُ عنها

199
00:15:08,240 --> 00:15:11,600
إن كنتَ تمتلكُ تِلك القدرة فسأتركُك على قيدِ الحياة

200
00:15:12,430 --> 00:15:13,580
...لـ-لكن

201
00:15:13,580 --> 00:15:15,530
القدرة التي تبحثُ عنها؟

202
00:15:15,530 --> 00:15:17,980
ما هو هدفك بالضبط؟

203
00:15:17,980 --> 00:15:22,480
لستَ في موقف يتيحُ لك حقّ طرح الأسئلة يا جوسكي

204
00:15:22,480 --> 00:15:25,090
!قراري بقتلِك لم يتغيّر

205
00:15:25,090 --> 00:15:27,790
.كُن شكوراً لانّك تمكّنت من العيش فترة أطول قليلاً

206
00:15:27,790 --> 00:15:28,980
هذا رائعٌ فحسب

207
00:15:28,980 --> 00:15:30,980
ماذا تفعل؟

208
00:15:30,980 --> 00:15:32,770
!أظهِر الستاند الخاصّ بك أيُّها الفتى

209
00:15:32,770 --> 00:15:36,320
...ستاند؟ لا أفهم ما يجري

210
00:15:36,320 --> 00:15:39,910
أهي المرّة الأولى لك؟ هكذا إذاً

211
00:15:39,910 --> 00:15:44,760
حسناً! جوسكي، علّمْه كيف يُظهِر ستانداً

212
00:15:44,760 --> 00:15:45,540
ماذا؟

213
00:15:45,540 --> 00:15:50,050
مجال الألماسة السّاطعة أقلّ من متر واحد

214
00:15:50,050 --> 00:15:55,160
إن كانَتْ قدرة ستاند ذلك القزَم قادرة
على التّعويض عن قدرتِك

215
00:15:55,160 --> 00:15:58,450
فقد أتركك تفلت من سريّتي

216
00:15:59,870 --> 00:16:04,590
صحيح... أتمنّى أن يكون ستانداً
قادراً على تحطيمِك

217
00:16:06,040 --> 00:16:09,710
حسناً، إخراج الستاند الخاصّ بك سهل يا كويتشي

218
00:16:09,710 --> 00:16:11,770
كلّ ما عليك هو أن تستشعر

219
00:16:11,770 --> 00:16:14,840
رغبتك بحماية نفسك أو رغبتك بسحقِه

220
00:16:15,460 --> 00:16:17,950
والباقي مجرّد غريزة

221
00:16:19,620 --> 00:16:22,800
ينبغي أن يخرج ستاند يُناسِب عقليّتك

222
00:16:22,800 --> 00:16:27,180
ا-انتظر! لا أستطيعُ فهم كلّ هذا دُفعة واحدة

223
00:16:27,620 --> 00:16:29,150
لا تفهم؟

224
00:16:29,150 --> 00:16:33,440
أظنُّني سأعرّضُك لظرفٍ يُجبرُك على فهم ذلك إذاً

225
00:16:35,300 --> 00:16:37,220
افعلها يا جنديّ القلنسوة الخضراء

226
00:16:47,350 --> 00:16:48,160
!ماذا؟

227
00:16:48,160 --> 00:16:49,110
...هذا

228
00:17:02,400 --> 00:17:05,410
كويتشي، حاول تحريكه

229
00:17:05,410 --> 00:17:06,770
أ-أحرِّك ماذا؟

230
00:17:06,770 --> 00:17:08,730
!ذلك الستاند

231
00:17:08,730 --> 00:17:10,030
ستاند؟

232
00:17:10,830 --> 00:17:13,570
!أ-أنا من أظهرَه؟

233
00:17:13,570 --> 00:17:15,520
ماذا يحدثُ بعد هذا؟

234
00:17:15,520 --> 00:17:18,300
ما القدرة التي يمتلكُها هذا الشيء البيضوي؟

235
00:17:18,300 --> 00:17:23,710
قدرة؟ آسف لتخييب أملك، لكن هذا كُل
ما أستطيع فعله

236
00:17:23,710 --> 00:17:25,110
!هذا كُل ما لديّ

237
00:17:25,110 --> 00:17:27,100
!ماذا؟ أهذا كُل ما لديك؟

238
00:17:29,780 --> 00:17:31,210
...هذا الستاند

239
00:17:32,030 --> 00:17:35,180
هذا يكفي، هذا كُل ما أحتاج معرفته

240
00:17:35,180 --> 00:17:38,060
!إلى كافّة الوحدات، في مواقعكم القتاليّة

241
00:17:39,170 --> 00:17:41,030
كويتشي، اسحب الستاند الخاصّ بك

242
00:17:41,030 --> 00:17:43,590
إن هاجموا ذلك الشيء فستموتُ أيضاً

243
00:17:43,590 --> 00:17:46,610
!أسحَب؟ كيف أسحبُه؟

244
00:17:46,610 --> 00:17:48,950
!بدء الهجوم

245
00:17:59,380 --> 00:18:01,810
!جـ-جوسكي

246
00:18:02,820 --> 00:18:06,160
جيّد، لقد تمّ فصل كويتشي عن جوسكي الآن

247
00:18:06,480 --> 00:18:08,290
...الصّدع في تِلك البيضة

248
00:18:08,290 --> 00:18:12,050
لم يُدرِك الفتى ذلك بعد، لكن قد تكون شيئاً قيّماً

249
00:18:12,050 --> 00:18:15,080
الشخص الوحيد الذي سيموتُ الآن هو جوسكي

250
00:18:17,940 --> 00:18:20,250
،أخُ أوكوياسو الكبير

251
00:18:20,250 --> 00:18:25,320
إن كنت ستشنُّ هجمةً لامشعة بما يكفي
لتدميرِ هذا المنزل

252
00:18:25,320 --> 00:18:27,380
فسأفعلُ المثل

253
00:18:39,040 --> 00:18:42,590
لنُضفِ إلى هذا رونقاً خاصّاً فحسب

254
00:18:46,220 --> 00:18:48,440
...جوسكي هيغاشيكاتا

255
00:18:48,440 --> 00:18:54,450
هل صحيحٌ أنّك تمقتُ من يُهين شعرَك؟

256
00:18:54,450 --> 00:18:58,150
لِمَ لا تجرِّب إهانته فحسب؟ فقط من باب التّجربة

257
00:18:58,150 --> 00:19:01,120
لا، لا حاجة لذلك

258
00:19:01,120 --> 00:19:04,120
لأنّني أعلِنُ بأنّني سأفجِّر

259
00:19:04,120 --> 00:19:07,610
الرأس الذي يستقرُّ شعرُك فيه

260
00:19:07,610 --> 00:19:11,660
في البداية، باد كومباني، ستُطلِق النّار على ساقيك

261
00:19:11,660 --> 00:19:13,520
.لن تتمكّن من الهرب حينها

262
00:19:13,520 --> 00:19:16,020
ومن ثمّ سنُلحِقُ الضررَ بذراعك

263
00:19:16,020 --> 00:19:18,250
.حينها لن تتمكّن من حماية نفسك

264
00:19:18,250 --> 00:19:23,840
ومن ثمّ أعلنُ بأنّني سأفجّرُ دماغك بالإضافة إلى شعرك

265
00:19:24,420 --> 00:19:27,730
...هكذا إذاً، إنّها خطّة لا تشوبها شائبة

266
00:19:28,350 --> 00:19:31,960
!هذا إن تجاهلتَ حقيقة أنّها مستحيلة

267
00:19:32,410 --> 00:19:34,910
أنا مرتّبٌ جداً كما ترى

268
00:19:34,910 --> 00:19:37,170
إن قلتُ أنني سأفعلُ شيئاً بترتيب معيّن فسأفعل

269
00:19:37,170 --> 00:19:38,900
هذا هو معنى الإعلان

270
00:19:39,310 --> 00:19:40,750
...إنّه مكشوف

271
00:19:41,790 --> 00:19:45,340
كلّ ما أحتاجه هو إظهار ذلك الستاند مجدداً

272
00:19:45,340 --> 00:19:50,080
إنه مجرّد شيء يُشبه البيضة، لكن إن جعلتُه
يصطدمُ به

273
00:19:50,080 --> 00:19:52,390
!فقد أتمكّن من هزيمته

274
00:19:52,390 --> 00:19:55,740
!س-سوف أفعلها! كُن واثقاً

275
00:19:56,850 --> 00:19:58,500
!سوف أهزمه

276
00:20:00,230 --> 00:20:02,820
أنا مهتمٌّ جداً بالستاند الخاصّ بك

277
00:20:02,820 --> 00:20:05,680
لهذا لن أقتلَك بعد

278
00:20:06,190 --> 00:20:07,400
!أيُّها الحقير

279
00:20:07,650 --> 00:20:11,020
كافّة الوحدات، إلى الأمام

280
00:20:17,440 --> 00:20:22,870
تماماً مثل موسى الذي شطَرَ البحرَ الأحمر
،ومشى في أرضِه

281
00:20:22,870 --> 00:20:27,870
سأشقُّ طريقي وأخترق هذا الجيش وأهزمك

282
00:20:27,870 --> 00:20:32,880
أيُّها الأحمق، ستسيرُ خطّتي كما أعلنتُ تماماً

283
00:20:32,880 --> 00:20:35,140
!يا جوسكي هيغاشيكاتا

284
00:20:38,990 --> 00:20:40,550
!لـ-لغم؟

285
00:20:40,550 --> 00:20:42,560
أولاً، إلحاق الضرر بساقيك

286
00:20:42,560 --> 00:20:45,580
والآن يا مروحيات الأباتشي، أطلقي صواريخكِ

287
00:20:54,530 --> 00:20:55,570
...ذِراعي

288
00:20:58,070 --> 00:21:00,410
أولاً ساقيك، ومن ثمّ ذراعك

289
00:21:00,410 --> 00:21:02,850
أشعرُ بالاستمتاع حقاً عندما تسيرُ
الأمور كما أعلنتُ تماماً

290
00:21:03,240 --> 00:21:06,650
لنرَ إن كان بمقدورك البقاء قطعة واحدة
بعدما أن تُطلِق سريّتي الأسوأ

291
00:21:06,650 --> 00:21:14,100
كلّ صواريخها وقذائفها وطلقاتها على تِلك
الذراع المُصابة

292
00:21:15,220 --> 00:21:19,230
!لقد خسرتَ يا جوسكي هيغاشيكاتا

293
00:21:19,230 --> 00:21:21,050
!إلى كافّة الوحدات

294
00:21:22,510 --> 00:21:25,280
!استعدّي لإطلاق النار في آن واحد

295
00:21:29,480 --> 00:21:32,860
ماذا تظنُّ نفسك فاعلاً يا جوسكي هيغاشيكاتا؟

296
00:21:33,310 --> 00:21:35,780
هل تستسلم؟

297
00:21:37,200 --> 00:21:40,320
هل تطلبُ منّي أن أدعك وشأنك؟

298
00:21:42,330 --> 00:21:44,060
لن يحدث هذا

299
00:21:45,080 --> 00:21:47,860
!إلى كافّة الوحدات، أطلقي

300
00:21:51,500 --> 00:21:55,720
.اكتملَتْ خطّتي

301
00:21:57,610 --> 00:21:59,000
!ماذا؟

302
00:22:00,580 --> 00:22:05,420
...صواريخي الّتي هاجمَتْ ذِراع جوسكي للتو

303
00:22:10,670 --> 00:22:12,510
هل نسيت؟

304
00:22:12,510 --> 00:22:17,920
ألماسَتي السّاطعة تستطيعُ إصلاح ما دُمِّر

305
00:22:19,020 --> 00:22:25,460
إن نسيت، عليك أن تدوِّن ذلك
وبشكل مرتِّب