1
00:00:03,770 --> 00:00:06,080
كان اليوم يوماً مُضنياً آخر

2
00:00:06,080 --> 00:00:08,640
أريدُ أن أعود إلى المنزلِ بسرعة فحسب كي أسترخي

3
00:00:11,760 --> 00:00:14,670
...كـ-كويتشي

4
00:00:14,670 --> 00:00:16,740
...هازامادا

5
00:00:16,740 --> 00:00:18,990
كف حالك؟

6
00:00:18,990 --> 00:00:21,760
شـ-شكراً لك على ما فعلتَه قبل أيّام

7
00:00:22,890 --> 00:00:25,780
هل شُفيتَ كلّياً الآن؟

8
00:00:26,530 --> 00:00:29,700
تقريباً، خرجتُ من المشفى قبل يومين

9
00:00:32,130 --> 00:00:34,770
أين ذلك الحقير— أعني، أين جوسكي؟

10
00:00:34,770 --> 00:00:36,630
عاد إلى المنزل

11
00:00:36,630 --> 00:00:39,920
يبدو أنّه عثر على رضيعٍة خفيّة البارحة

12
00:00:39,920 --> 00:00:42,710
حدثَتْ جلبة كبيرة بشأن العثور على أمّها

13
00:00:42,710 --> 00:00:44,770
هل هي مستخدمة ستاند؟

14
00:00:44,770 --> 00:00:46,090
على ما يبدو

15
00:00:46,090 --> 00:00:50,680
لم تتودّد الطّفلة إلّا لوالد جوسكي، السيّد جوستار

16
00:00:50,680 --> 00:00:55,680
وكلّما غابَ عنها تُخفي كلّ شيء يحيطُ بها

17
00:00:56,720 --> 00:01:00,760
هل سيبقى السيّد جوستار في البلدة لبعض الوقت إذاً؟

18
00:01:00,760 --> 00:01:02,300
ربّما

19
00:01:02,600 --> 00:01:06,600
هكذا إذاً. بالمناسبة يا كويتشي، هل تحبُّ قراءة المانغا؟

20
00:01:06,600 --> 00:01:10,480
مانغا؟ ربّما بقدر ما يحبّها الآخرون

21
00:01:10,480 --> 00:01:14,280
هل سمعتَ بروهان كيشيبي الذي رسمَ (بينك دارك بوي)؟

22
00:01:14,280 --> 00:01:16,800
!بينك دارك بوي)؟ بالطبع)

23
00:01:16,800 --> 00:01:18,190
!أنا مُعجبٌ به كثيراً

24
00:01:18,190 --> 00:01:19,850
حقاً؟ أيُعجبُك؟

25
00:01:19,850 --> 00:01:21,780
"يمكنُك وصفه بـ"تشويق ورُعب

26
00:01:21,780 --> 00:01:24,220
،هنالك بعض المشاهد المُقرِفة للغاية

27
00:01:24,220 --> 00:01:26,200
لكن الإثارة التي تضيقُ الخِناق عليك

28
00:01:26,200 --> 00:01:28,970
والشخصيّات الواقعيّة عظيمان، أليس كذلك؟

29
00:01:28,970 --> 00:01:30,290
!أجل، أجل

30
00:01:30,700 --> 00:01:35,210
هل تعلم أنّ روهان كيشيبي يعيشُ في موريو في واقع الأمر؟

31
00:01:35,950 --> 00:01:38,700
!ماذا؟! يعيش في موريو؟

32
00:01:38,700 --> 00:01:41,100
!مستحيل! لا تقلْها! هل أنتَ جادّ؟

33
00:01:41,100 --> 00:01:43,120
!لم أصدّق ذلك أيضاً

34
00:01:43,120 --> 00:01:46,380
لكن صدفَ وأن سمعتُ بعضاً من السّماسرة
يتحدّثون عن ذلك

35
00:01:46,380 --> 00:01:49,580
أعلم أنّ هذا يبدو غير قابل للتصديق
لكنّه واقع

36
00:01:50,230 --> 00:01:53,500
أتريدُ أن نذهب ونرى ما إن كنّا قادرين
على الحصول على توقيعه؟

37
00:01:53,500 --> 00:01:55,430
!نعم، سأذهب بالطبع

38
00:01:58,140 --> 00:02:00,050
!يبدو أنّ تفكيرنا واحد

39
00:02:00,050 --> 00:02:01,430
حقّاً؟

40
00:02:03,220 --> 00:02:04,260
!هناك

41
00:02:04,260 --> 00:02:06,450
أعتقدُ أن هذا هو الاستديو الخاصّ به

42
00:02:06,450 --> 00:02:07,790
!الإنارة تعمل

43
00:02:07,790 --> 00:02:09,350
...معك حقّ

44
00:02:09,350 --> 00:02:11,970
أتساءل ما إن كانَ لديه أفراد عائلة آخرون

45
00:02:11,970 --> 00:02:14,100
سمعتُ أنّه يعيش وحيداً

46
00:02:14,100 --> 00:02:16,900
كان أوّل عملٍ له في السّادسة عشر وأصبح الآن في العشرين

47
00:02:16,900 --> 00:02:19,630
!عشرون؟! إنّه صغير جدّاً

48
00:02:20,090 --> 00:02:22,950
أصبح محترفاً في مثل سنّي إذاً

49
00:02:22,950 --> 00:02:26,180
لا جدوى من استراق النّظر يا كويتشي

50
00:02:26,180 --> 00:02:27,710
حاول قرع جرس الباب

51
00:02:27,710 --> 00:02:29,450
أ-أنا؟

52
00:02:29,450 --> 00:02:32,730
هيّا! أنا آمرُك بصِفتي تلميذ أكبر منك

53
00:02:32,730 --> 00:02:34,710
فأنا كثير التوتّر

54
00:02:34,710 --> 00:02:37,780
...ماذا؟ هذا ليس عدلاً

55
00:03:00,940 --> 00:03:02,760
!هذا الوجه

56
00:03:02,760 --> 00:03:04,180
!روهان كيشيبي

57
00:03:04,180 --> 00:03:07,780
يبدو تماماً كصورته التي عُرِضَتْ في الإصدار
المُمتاز من العام الجديد

58
00:03:09,010 --> 00:03:10,950
أعني... روهان سينسي

59
00:03:15,890 --> 00:03:18,020
من أنتما؟

60
00:03:18,020 --> 00:03:20,170
ماذا تفعلان؟ هل تُخطّطان لخدعة ما؟

61
00:03:20,170 --> 00:03:22,060
!لـ-لا! لا يمكن أن نفعل هذا

62
00:03:22,060 --> 00:03:24,910
نحنُ تلميذان في مدرسة بودوغاوكا الثانويّة

63
00:03:24,910 --> 00:03:27,180
نـ-نحن من المعجبين بك يا سينسي

64
00:03:27,180 --> 00:03:29,240
مُعجبان؟ بي أنا؟ هل أنتُما قارئان؟

65
00:03:29,690 --> 00:03:31,080
لقد عُرِفَ عنواني إذاً

66
00:03:31,080 --> 00:03:34,750
لـ-لا... لقد صدفَ وأن سمعتُ به فحسب

67
00:03:34,750 --> 00:03:36,950
،لِذا أعلمُ أنّ طلبي مُفاجئ

68
00:03:36,950 --> 00:03:40,130
لكن سيكون من دواعي سرورنا أن نحصل على توقيعك

69
00:03:40,130 --> 00:03:41,980
مُعجبان بي؟

70
00:03:42,520 --> 00:03:43,640
هذا جيّد

71
00:03:43,640 --> 00:03:45,720
قد نكون منسجِمون إذاً

72
00:03:46,530 --> 00:03:49,140
لا شيء، انسيا الأمر. المعذرة

73
00:03:49,500 --> 00:03:53,070
لا أمانع حصولكما على توقيع أو توقيعين

74
00:03:54,600 --> 00:03:56,350
مرحى! جيّد أنّنا أتينا

75
00:03:57,720 --> 00:03:58,860
وجدتُها

76
00:03:58,860 --> 00:04:01,770
بما أنّكما هنا، ما رأيكما بجولة في الاستديو الخاصّ بي؟

77
00:04:02,500 --> 00:04:04,900
!ستسمحُ لنا بدخول الاستديو الخاصّ بك؟

78
00:04:04,900 --> 00:04:08,780
...لقد أنهيتُ عملي لهذا اليوم، لِذا إن أردتُما

79
00:04:08,780 --> 00:04:09,620
!بالطبع

80
00:04:09,620 --> 00:04:10,610
...إذاً

81
00:04:11,160 --> 00:04:13,200
!أستميحك عذراً

82
00:04:22,300 --> 00:04:23,260
ادخلا

83
00:04:23,260 --> 00:04:26,220
!رائع

84
00:04:30,530 --> 00:04:32,790
!رائع! مخطوطة خامّة رُباعيّة الألوان

85
00:04:33,390 --> 00:04:36,810
إنّها مذهلة، لها وَقْعٌ أكبر بكثير

86
00:04:37,230 --> 00:04:42,480
!أ-أنا متأثّر للغاية! أ-أ-أنا مسرورٌ جدّاً لأنّنا أتينا

87
00:04:42,480 --> 00:04:45,590
منذُ متى وأنت تعمل في موريو؟

88
00:04:45,590 --> 00:04:47,910
انتقلتُ إلى هنا منذُ ثلاثة أشهر

89
00:04:47,910 --> 00:04:49,710
يقعُ ديار عائلتي في مدينة أس

90
00:04:49,710 --> 00:04:52,830
لكن عشتُ هنا لبعض الوقت عندما كنتُ طفلاً

91
00:04:53,100 --> 00:04:56,110
طوكيو مناسبة جدّاً، لكنّها فوضويّة للغاية

92
00:04:56,110 --> 00:04:57,810
البيئة بعيدة كلّ البعد

93
00:04:57,810 --> 00:05:00,670
عن الهدوءِ الذي تتمتّع به موريو
ولا أستطيع العمل هناك

94
00:05:00,670 --> 00:05:01,590
ناهيكما عن أنّه

95
00:05:01,590 --> 00:05:04,210
،بوجود أجهزة الفاكس والنّاسخات في يومنا هذا

96
00:05:04,210 --> 00:05:06,530
أمتلكُ نِظاماً يمكّنني وخلال أربع ساعات

97
00:05:06,530 --> 00:05:09,140
أستطيع إرسال مخطوطة كاملة

98
00:05:09,140 --> 00:05:11,430
يمكنكما القول أنّه لا جدوى من العيش

99
00:05:11,430 --> 00:05:13,850
في المدينة الآن سِوى للحصول على مكانة عديمة الفائدة

100
00:05:13,850 --> 00:05:18,020
المعذرة... ماذا تفعلُ إذاً بالنسبة للمُساعدين أو الطاقم؟

101
00:05:18,020 --> 00:05:20,100
لا أملك أحداً، أرسمُ كلّ شيء بمفردي

102
00:05:20,100 --> 00:05:22,320
!بمفردك؟

103
00:05:22,320 --> 00:05:25,030
ترسمُ 19 صفحةً بمثل هذا الفنّ المُفصَّل
في غضون أسبوع فقط؟

104
00:05:25,030 --> 00:05:27,980
أستطيعُ رسمها خلال أربعة أيّام
أو خمسة إن كانت الصّفحات ملوّنة

105
00:05:26,070 --> 00:05:27,430
!ماذا؟

106
00:05:27,980 --> 00:05:30,850
وفي بقيّة الأيّام، أتمتّعُ بقضاء الرّحلات وما إلى هنالك

107
00:05:30,850 --> 00:05:32,740
،لا أحبّ الاحتكاك مع النّاس حقيقة

108
00:05:32,740 --> 00:05:35,040
ولهذا اخترتُ أن أكون رسّام مانغا

109
00:05:35,040 --> 00:05:37,920
فلو كان لديّ مُساعد، سيزدادُ العمل صعوبةً عليّ

110
00:05:37,920 --> 00:05:39,960
هذا مذهل جدّاً... رائع

111
00:05:39,960 --> 00:05:41,710
!أنتَ عبقريّ

112
00:05:42,220 --> 00:05:43,290
اعذرني لحظة

113
00:05:43,290 --> 00:05:44,600
!عـ-عنكبوت

114
00:05:47,620 --> 00:05:49,380
نحنُ في الضّواحي فعلاً

115
00:05:49,380 --> 00:05:51,350
هنالك كثيرٌ من الحشرات والعناكب

116
00:05:52,560 --> 00:05:54,230
المعذرة... سينسي؟

117
00:05:54,640 --> 00:05:57,740
فهمت... إذاً هذا العنكبوت هو من العنكبوتيّات البطينة

118
00:05:57,740 --> 00:06:01,150
يعيش في البيوت والمناطق الجبليّة في كل أنحاء اليابان

119
00:06:01,150 --> 00:06:03,020
،رُغمَ أنّه غازِل مداريّ

120
00:06:03,020 --> 00:06:06,370
إلّا أنّ هناك بعضها تنسجُ شبكاتٍ ليلاً نهاراً

121
00:06:06,940 --> 00:06:08,430
،بالمناسبة

122
00:06:08,430 --> 00:06:12,070
هل تعلمان ما الذي يلزمكما لرسم مانغا مُثيرة؟

123
00:06:13,280 --> 00:06:14,690
!الحقيقة

124
00:06:14,690 --> 00:06:18,220
الحقيقة هي الطاقة التي تنفخ الحياة
في قطعة عمل

125
00:06:18,220 --> 00:06:21,160
والحقيقة هي بحدِّ ذاتها ترفيهيّة

126
00:06:21,160 --> 00:06:24,700
غالباً ما يعتقد النّاس أنّ المانغا
تُرسَم من وحي الخيال

127
00:06:24,700 --> 00:06:26,060
!لكن هذا ليس صحيحاً تماماً

128
00:06:26,570 --> 00:06:28,930
بالنسبة لي، رسم شيء قد جرّبتُه من قبل

129
00:06:28,930 --> 00:06:31,890
!أو شيء قد أثّرَ بي هو ما يجعله مثيراً

130
00:06:33,900 --> 00:06:38,980
على سبيلِ المثال، يشعر النّاس في المدينة
بالاشمئزاز من هذا العنكبوت ويقتلونه

131
00:06:39,400 --> 00:06:42,980
كرسّام مانغا، عليك أن تعلم
،كيف ترتبطُ أرجلُها

132
00:06:42,980 --> 00:06:46,950
وأماكن عيونه وكيفيّة التّمييز بين ذكر

133
00:06:46,950 --> 00:06:49,410
وأنثى كي تتمكّن من رسمه

134
00:06:49,660 --> 00:06:54,040
يبدو أنّ نسيج العنكبوت يتصلّب
إذا ما تعرّض للهواء

135
00:06:54,040 --> 00:06:56,000
لكن عليك أن تعرف الفتحة التي يخرجُ منها النّسيج

136
00:06:56,790 --> 00:07:00,260
وما هو شكل أحشائه

137
00:07:00,680 --> 00:07:05,740
وعندما يُبقَرُ بطن العنكبوت، كيف يُعاني قبل أن يموت؟

138
00:07:06,280 --> 00:07:09,810
لا بدّ أن تتعلّم هذه الأشياء لأجلِ الحقيقة

139
00:07:10,620 --> 00:07:11,640
!هذا قاسٍ جدّاً

140
00:07:11,640 --> 00:07:12,830
!قاسٍ؟

141
00:07:12,830 --> 00:07:15,940
أيعملُ طفلٌ هاوٍ مثلك على انتقادي
!أنا، روهان كيشيبي؟

142
00:07:16,770 --> 00:07:20,030
!لـ-لا! لم أكن أنتقدك إطلاقاً، أنا آسف

143
00:07:21,440 --> 00:07:22,900
كان ينبغي أن أتذوّق أيضاً

144
00:07:26,500 --> 00:07:31,410
رسّامو المانغا غريبو الأطوار حقّاً كما
يصِفُهم العالم

145
00:07:33,460 --> 00:07:35,580
...مُمتاز! تعبير الألم هذا

146
00:07:35,580 --> 00:07:37,420
!هو مِثال يُحتذى به على شكل المرء عندما يتقيّأ

147
00:07:37,800 --> 00:07:39,250
ينبغي أن أرسمه

148
00:07:39,250 --> 00:07:40,960
حـ-حقّاً؟

149
00:07:46,660 --> 00:07:48,210
يبدو مزيّفاً الآن

150
00:07:49,460 --> 00:07:51,130
انسَ الأمر، لن أرسمه

151
00:07:51,130 --> 00:07:52,690
لن ينفعني

152
00:07:52,690 --> 00:07:54,480
أ-أنا آسف

153
00:07:55,180 --> 00:07:56,810
توقيع، أليس كذلك؟

154
00:07:56,810 --> 00:07:59,340
،سأذهبُ لإحضار قلم توقيع من المطبخ

155
00:07:59,820 --> 00:08:01,430
وأجلب بعض الشّاي كذلك

156
00:08:01,430 --> 00:08:03,180
...المعذرة، لا داعي لذلك

157
00:08:05,590 --> 00:08:08,410
...لكن هذا مذهل! لم أكن أدري

158
00:08:08,410 --> 00:08:11,000
لا بدّ أنّ (بينك دارك بوي) مذهل

159
00:08:11,000 --> 00:08:14,560
...نظراً إلى طريقته في اكتشاف الأشياء

160
00:08:14,560 --> 00:08:16,350
...هازامادا

161
00:08:17,360 --> 00:08:19,620
...أعلمُ أنّنا وصلنا إلى هنا للتو، لكن

162
00:08:19,620 --> 00:08:23,120
ربّما ينبغي أن نذهب إلى المنزل

163
00:08:23,120 --> 00:08:25,150
إلى المنزل؟ أتريد الذهاب إلى المنزل؟ لماذا؟

164
00:08:25,150 --> 00:08:27,060
!هذا ممتعٌ كثيراً

165
00:08:27,060 --> 00:08:30,360
...لا يوجد سبب محدَّد، لكن

166
00:08:30,360 --> 00:08:32,620
أعتقدُ أنه يمكنُك أن تعتبره حدساً

167
00:08:32,620 --> 00:08:35,320
...مع أنّني لستُ بصيراً عادةً

168
00:08:35,320 --> 00:08:39,410
انتابَني إحساسٌ فجأة أنّ روهان سينسي
هو شخص خطير قليلاً

169
00:08:39,410 --> 00:08:40,700
خطير؟

170
00:08:40,700 --> 00:08:44,160
أتعني أنّه قد يكون مُستخدم ستاند؟

171
00:08:44,160 --> 00:08:48,000
...لا، لا شيء من هذا، إنّما فقط

172
00:08:48,000 --> 00:08:55,700
لا أظنّك ينبغي أن تفترض أنّ روهان سينسي هو
مُستخدم ستاند فقط لكونه غريب الأطوار قليلاً

173
00:08:55,700 --> 00:08:57,970
...أنا لا أفترض ذلك

174
00:08:57,970 --> 00:08:59,890
قلتُ فقط أنّه انتابَني إحساسٌ سيّئ

175
00:08:59,890 --> 00:09:04,020
بالإضافة إلى ذلك، إذا كان روهان سينسي مُستخدم ستاند

176
00:09:04,020 --> 00:09:05,890
ألن يكون ذلك رائعاً بالنسبة لنا؟

177
00:09:05,890 --> 00:09:10,240
هذا يعني أنّ بيني وبين رسّام مانغا مشهور شيء مُشترَك

178
00:09:10,240 --> 00:09:12,280
لكن ليسَتْ لديّ مُشكلة

179
00:09:12,280 --> 00:09:16,370
إن انتابَك إحساسٌ سيّئ، يمكننا الذهاب
إلى المنزل اليوم

180
00:09:16,370 --> 00:09:17,950
يمكننا أن نأتي لاحقاً متى شئنا

181
00:09:18,570 --> 00:09:19,570
!لكن

182
00:09:19,570 --> 00:09:22,490
ليس قبل أن ألقي نظرة إلى هذا الشّيء
الذي لفتَ نظري

183
00:09:22,490 --> 00:09:25,190
شيء؟ أي شيء؟

184
00:09:25,190 --> 00:09:27,910
!تبّاً، أنتَ ساذجٌ يا كويتشي

185
00:09:27,910 --> 00:09:30,780
فوق المكتب، بجانب الهاتف

186
00:09:30,780 --> 00:09:32,500
أمعِن النّظر

187
00:09:39,260 --> 00:09:41,480
...هـ-هل يُعقَل أن يكون هذا

188
00:09:41,480 --> 00:09:45,170
أجل! قال أنّه انتهى من العمل للتو، صحيح؟

189
00:09:45,170 --> 00:09:48,120
لقد كنتُ أراقب ذلك بعناية

190
00:09:48,120 --> 00:09:52,600
!مخطوطة لـ(بينك دارك بوي) قد انتهت للتو؟

191
00:09:52,600 --> 00:09:55,520
!هل هذا يعني أنّه لم يرها أحدٌ آخر بعد؟

192
00:09:55,520 --> 00:09:58,030
حالما ألقي نظرةً خاطفةً عليها، يمكننا العودة إلى المنزل

193
00:09:58,030 --> 00:10:00,400
يجب أن نحصل على إذن أولاً

194
00:10:00,400 --> 00:10:04,090
كويتشي، أنتَ لا تعرف رسّامي المانغا إطلاقاً

195
00:10:04,090 --> 00:10:09,790
تكون هذه المخطوطات سرّاً تجاريّاً محميّاً قبل أن تدخل الطّابعات

196
00:10:09,790 --> 00:10:12,190
من المُحال أن يسمح لنا نحنُ الغريبَين بقراءة

197
00:10:12,190 --> 00:10:15,340
مخطوطة لم يراجعْها حتّى المحرِّر بعد

198
00:10:15,340 --> 00:10:17,230
سألقي نظرة ومن ثمّ أعيدها

199
00:10:17,230 --> 00:10:19,100
!هذه فكرة أسوأ حتّى

200
00:10:19,100 --> 00:10:22,080
لا مُشكلة، لن أضرّ أحداً إذا فعلتُ ذلك

201
00:10:34,060 --> 00:10:35,930
ما هذا الإحساس؟

202
00:10:35,930 --> 00:10:40,670
من المعروف أنّها مانغا مشوّقة، لكن هل هذا وَقْع
تأثير مخطوطة خامّة؟

203
00:10:40,670 --> 00:10:42,530
!يقشعرُّ بدني

204
00:10:43,360 --> 00:10:44,730
!إنّها ممتازة

205
00:10:44,730 --> 00:10:47,400
اقلب الصّفحة بسرعة يا هازامادا

206
00:10:47,400 --> 00:10:49,410
!أنا متأثِّر للغاية

207
00:10:49,410 --> 00:10:50,910
يبدو أنّ

208
00:10:51,100 --> 00:10:55,800
مخطوطتي كانَتْ متوافقة معكما في نهاية المطاف

209
00:10:55,800 --> 00:10:57,920
توقّعتُ أن تقرآها

210
00:10:57,920 --> 00:11:02,630
...من يكونوا أوّل من يقرؤون مخطوطتي ويتوافقون معها

211
00:11:04,420 --> 00:11:06,370
...هـ-هازامادا

212
00:11:06,370 --> 00:11:07,510
...كـ-كويتشي

213
00:11:07,510 --> 00:11:12,950
تُفتَح قلوبهم بواسطة قدرتي، هيفينز غيت

214
00:11:12,950 --> 00:11:14,860
!قـ-قدرة؟

215
00:11:16,260 --> 00:11:17,620
!يدي

216
00:11:22,160 --> 00:11:26,130
!كـ-كويتشي! ما الذي يجري؟

217
00:11:35,950 --> 00:11:40,180
هنالك أشياء كثيرة مُسجّلة في الجسم البشري

218
00:11:40,180 --> 00:11:42,680
كلّ شيء ابتداء من اللّحظة التي وُلِدتَ فيها

219
00:11:42,680 --> 00:11:46,270
لقراءة ذلك، سأحوّلكما إلى كتابَين

220
00:11:46,270 --> 00:11:49,560
كِتابان دُوِّنَتْ عليهما حياتكما

221
00:11:51,370 --> 00:11:54,350
!النّجدة

222
00:11:52,860 --> 00:11:54,950
أنتُما تقرآن المانغا أيضاً، أليس كذلك؟

223
00:11:58,820 --> 00:12:00,490
!هذا يحلُّ بي أيضاً

224
00:11:59,160 --> 00:12:00,490
!هازامادا

225
00:12:00,490 --> 00:12:04,000
لن يضرّك هذا فعلياً، لذا لا تقلق

226
00:12:04,000 --> 00:12:06,830
!ما-ما الذي تحاولُ فعله؟

227
00:12:06,830 --> 00:12:12,340
قلتُ لكما في السّابق أنّ إحساس الكاتب
بالحقيقة مهمّ للمانغا، أليس كذلك؟

228
00:12:12,340 --> 00:12:16,200
ما يعني أنّ قراءة حياتكما وخبرتكما

229
00:12:16,200 --> 00:12:19,720
ستزوّدني بأفكار واقعيّة

230
00:12:20,130 --> 00:12:22,190
!لا يمكن الحصول على هذا من المُقابلات

231
00:12:22,190 --> 00:12:28,560
ستخبرني عن أحداثٍ حقيقيّة مئة بالمئة، كما لو أنّني
خضعتُ لها بنفسي

232
00:12:28,560 --> 00:12:37,490
كويتشي هيروسي، المولود في 28 مارس عام 1984
في السّاعة 6:27 صباحاً في مشفى الصّليب الأحمر في مدينة أس

233
00:12:37,490 --> 00:12:41,870
وُلِدتَ سابقاً لأوانك بوزن 2325 غراماً
وقضيتَ أسبوعاً في حاضنة أطفال

234
00:12:42,470 --> 00:12:45,000
...عائلتك مؤلّفة من أربعة أفراد، واسم أختك الكبرى هو أيانا

235
00:12:45,410 --> 00:12:46,410
...هكذا إذاً

236
00:12:46,660 --> 00:12:51,580
يبدو أنّ أيّامك في المدرستَين الابتدائيّة
والإعداديّة كانَتْ عاديّة جدّاً

237
00:12:51,580 --> 00:12:54,300
وشخصيّتك صادقة جدّاً

238
00:12:54,300 --> 00:12:55,820
هذا جديرٌ بالثناء

239
00:12:58,390 --> 00:12:59,850
...أنت

240
00:12:59,850 --> 00:13:03,610
ما هذه القدرة التي تمتلكُها؟! إيكوز؟

241
00:13:04,580 --> 00:13:08,860
!هنالك شخصٌ غيري يمتلك قدرةً كهذه؟

242
00:13:08,860 --> 00:13:10,380
أنت أيضاً؟

243
00:13:14,560 --> 00:13:17,200
...مُستخدما ستاند" هذا"

244
00:13:17,200 --> 00:13:21,270
!كلّ شيء اعتباراً من أبريل عام 1999 مذهل

245
00:13:21,270 --> 00:13:24,010
!بدأتَ تمرُّ بتجارب مذهلة منذُ ذلك الحين فقط

246
00:13:24,010 --> 00:13:26,820
،جوسكي هيغاشيكاتا، جوتارو كوجو

247
00:13:26,820 --> 00:13:30,770
...يوكاكو ياماغيشي، أوكوياسو نيجيمورا، تامامي كوباياشي

248
00:13:31,220 --> 00:13:32,740
...لا أصدّق ذلك

249
00:13:32,740 --> 00:13:34,790
!هذا مذهل، هذا ترفيهيّ جدّاً

250
00:13:34,790 --> 00:13:39,720
لقد اكتشفتُ أفضل مادّة يمكنُ أن يحلم
بها رسّام مانغا، كويتشي هيروسي

251
00:13:40,190 --> 00:13:42,440
،الألماسة السّاطعة

252
00:13:42,440 --> 00:13:44,120
،ستار بلاتنيومّ

253
00:13:44,120 --> 00:13:48,900
!ذا هاند، لوف ديلوكس، إلخ، إلخ

254
00:13:49,580 --> 00:13:53,570
!ما-ماذا تنوي أن تفعل بنا؟

255
00:13:53,570 --> 00:13:55,740
سآخذ ذكرياتك

256
00:13:55,740 --> 00:13:58,370
!كي أستخدمها كمادّة للمانغا خاصّتي

257
00:13:58,370 --> 00:13:59,160
!إيكوز

258
00:14:02,540 --> 00:14:06,560
!كفَّ عن مُهاجمتنا بالستاند الخاصّ بك حالاً

259
00:14:06,930 --> 00:14:07,920
...وإلّا

260
00:14:09,390 --> 00:14:13,110
هل ستدع إيكوز آكت 2 يهاجمني بالصّوت؟

261
00:14:14,260 --> 00:14:17,820
!نعم، حرّرني من الستاند الخاصّ بي أرجوك

262
00:14:17,820 --> 00:14:19,630
!لن أرحمك

263
00:14:19,630 --> 00:14:24,020
أعلم، هذا مكتوب في صفحتك الحادية عشر

264
00:14:24,460 --> 00:14:29,820
أنتَ أكثر خجلاً من مُعظم النّاس
وعِرضة لسخرية الآخرين

265
00:14:29,820 --> 00:14:33,770
لكن عند الشّدائد، تتمتّعُ بالشجاعة
التي تمكّنك من تجاوز خوفك

266
00:14:33,770 --> 00:14:35,270
!باهر حقّاً

267
00:14:35,270 --> 00:14:36,790
!أنا معجبٌ جدّاً بك

268
00:14:36,790 --> 00:14:40,460
أنا متأكّدٌ أنّ قُرّائي سيحبّون شخصيّتك أيضاً

269
00:14:40,460 --> 00:14:44,060
!أنا لا أمزح، سوف أهاجمك صدّقني

270
00:14:44,060 --> 00:14:46,260
...اخرس

271
00:14:46,260 --> 00:14:47,720
!جرّب ذلك فحسب

272
00:14:47,720 --> 00:14:49,430
!إيكوز آكت 2

273
00:14:56,490 --> 00:14:58,820
!أ-أخفقَتْ؟

274
00:14:58,820 --> 00:15:03,230
هل أخفقتَ بالخطأ أم تعمّدتَ الإخفاق؟

275
00:15:03,230 --> 00:15:05,960
!تحكّمك سيّئ جداً

276
00:15:06,320 --> 00:15:08,740
!ما رأيك بهذه إذاً؟

277
00:15:10,600 --> 00:15:12,750
!ما الذي تُهاجمه بالضبط؟

278
00:15:12,750 --> 00:15:18,200
كويتشي، مع الأسف، لقد وضعتُ قفلَ أمان على إيكوز

279
00:15:19,420 --> 00:15:23,630
أصبحتَ عاجزاً عن مُهاجمتي الآن

280
00:15:23,630 --> 00:15:25,630
قفل أمان؟

281
00:15:29,400 --> 00:15:37,270
انظر... لقد دوّنتُ ذلك في صفحتك الحادية عشر، هُنا تحديداً

282
00:15:46,780 --> 00:15:49,910
هذه قدرة هيفينز غيت

283
00:15:49,910 --> 00:15:52,340
،تمكّنني من قراءة تجارب النّاس عن طريق كلمات وصور

284
00:15:52,340 --> 00:15:55,510
وتخوّلني أيضاً لكتابة ذكرياتك

285
00:15:55,510 --> 00:16:01,500
لن تتمكّن من أذيّتي بأي طريقة أو شكل أو صيغة

286
00:16:01,500 --> 00:16:03,510
!ما-ماذا؟

287
00:16:09,100 --> 00:16:12,350
لكن لن أعبث أكثر من ذلك

288
00:16:12,350 --> 00:16:17,080
فإن كتبتُ المزيد، سيجعلُ ذلك حياتك مزيّفة

289
00:16:17,080 --> 00:16:19,610
وبالتّالي لن تنفعني في عملي

290
00:16:20,000 --> 00:16:23,840
لنرَ... أظنُّني سألقي نظرة إلى هازامادا أيضاً

291
00:16:23,840 --> 00:16:27,910
!سينسي! أنتَ عبقريّ، أنا معجبٌ بك

292
00:16:27,910 --> 00:16:29,670
هكذا إذاً...

293
00:16:29,670 --> 00:16:31,030
...لنرَ

294
00:16:31,030 --> 00:16:33,330
أحياناً تشعرُ بالرّاحة بعد مُضايقتك

295
00:16:33,330 --> 00:16:37,920
لِمَن هم أضعف منك، كالقطط والعصافير الصّغيرة

296
00:16:37,920 --> 00:16:41,410
تريدُ أن تفرض نفسك على جونكو من الصفّ 3-ي

297
00:16:41,410 --> 00:16:43,430
لكنّك جبان جدّاً لِذا لا تستطيع

298
00:16:44,260 --> 00:16:46,130
،دائماً ما تتعرّق خصيتاك

299
00:16:46,130 --> 00:16:48,210
،وعندما تضبطهما أثناء الدّرس

300
00:16:48,210 --> 00:16:51,530
لا شيء يُثيرك أكثر من فكرة أنّ شخصاً
ما قد يراك

301
00:16:52,080 --> 00:16:54,020
أنت رجلٌ فظيع

302
00:16:54,020 --> 00:16:57,500
لا يمكن أن يحبّك قُرّائي إذا ما كتبتُ عنك في المانغا خاصّتي

303
00:16:57,850 --> 00:16:59,340
أنتَ عديم الفائدة

304
00:17:02,510 --> 00:17:05,900
هذا ليس عدلاً، لا أمل منّي

305
00:17:04,340 --> 00:17:05,900
لماذا؟

306
00:17:07,330 --> 00:17:08,890
لماذا تفعل هذا؟

307
00:17:08,890 --> 00:17:14,230
حتّى من دون قراءة تجارُبي، أنت رسّامُ مانغا مذهل

308
00:17:14,230 --> 00:17:16,260
!والعالم يعلمُ ذلك

309
00:17:16,260 --> 00:17:19,990
!وتعيش في هذا البيت المذهل بعمر العشرين

310
00:17:19,990 --> 00:17:22,550
!تؤدّي أداءً أفضل بكثير من مُعظم النّاس الذين في سنّك

311
00:17:22,550 --> 00:17:25,890
!ومع ذلك، ما حاجتك لذكرياتي؟

312
00:17:27,380 --> 00:17:31,280
أوتظنّني أنا، روهان كيشيبي، أرسمُ المانغا

313
00:17:31,280 --> 00:17:33,060
!لأجل المال ولفت الانتباه؟

314
00:17:34,550 --> 00:17:37,620
!أرسمُ المانغا كي يقرأها النّاس

315
00:17:37,620 --> 00:17:40,210
!كي يقرأها شخصٌ ما، هذا هو السّبب الوحيد

316
00:17:40,210 --> 00:17:44,500
إنّه سبب بسيط جدّاً، لكن لا يهمّني أي شيء آخر

317
00:17:44,500 --> 00:17:49,670
كي يقرأها النّاس، أبحثُ عن مادّة واقعيّة يومياً

318
00:17:49,670 --> 00:17:54,010
أصغِ جيّداً، كلّما أنهيتُ مخطوطة
أشعرُ بشعور مذهل

319
00:17:54,010 --> 00:17:57,350
الجميع يشعرُ بشعور مذهل كلّما
أنهوا عملاً، أليس كذلك؟

320
00:17:57,350 --> 00:18:00,320
لكن يزول ذلك الشّعور بلمح البصر

321
00:18:00,320 --> 00:18:01,690
،إنّه قصيرُ الأجل

322
00:18:01,690 --> 00:18:05,720
لأنّني بدأتُ أعتقد أنّه لن يقرأ أحدٌ
المانغا المُكتمِلة خاصّتي

323
00:18:05,720 --> 00:18:08,730
.وبدأ عدمُ ثِقتي بنفسي يزداد

324
00:18:08,730 --> 00:18:14,990
ثمّ سأزدادُ تزعزعاً أكثر والسّبب هو أنّ
النّاس ربّما لن تقرأها في الأسبوع القادم وبعدئذ قد لا أعرف

325
00:18:14,990 --> 00:18:18,810
ماذا أرسم وقد لا أشعر برغبةٍ في الاستمرار بهذا العمل

326
00:18:20,560 --> 00:18:26,110
لقد كانَتْ هذه الأحاسيس تخالجني
مراراً وتكراراً مُذ كنتُ في السّادسة عشر

327
00:18:26,110 --> 00:18:30,110
حتّى جاءَ شخصٌ وأطلقَ عليّ سهماً
قبل ثلاثة أشهر

328
00:18:30,110 --> 00:18:32,970
فاكتسبتُ قدرةَ هيفينز غيت

329
00:18:32,970 --> 00:18:35,040
...كيتشو نيجيمورا

330
00:18:35,040 --> 00:18:37,470
نعم، كان ذلك مُدوّناً فيكما أيضاً

331
00:18:37,470 --> 00:18:40,720
أنا متأكّدٌ أنّكما لا تفهمان إحساس العثور

332
00:18:40,720 --> 00:18:43,140
!على أفضل مادّة لاستخدامها في رسمِ تحفة

333
00:18:43,140 --> 00:18:44,900
!لكن ها هي بين يديّ الآن

334
00:18:45,170 --> 00:18:46,440
!إنّها الأمثل

335
00:18:46,440 --> 00:18:51,610
كويتشي، سأجعلُ حقيقتك مِلكاً لي

336
00:19:05,790 --> 00:19:09,550
هل ترى يا كويتشي؟ ألم يكن روهان سينسي رجلاً عظيماً؟

337
00:19:09,550 --> 00:19:11,170
ألست مسروراً لأنّنا ذهبنا؟

338
00:19:11,170 --> 00:19:13,430
نعم، كان ذلك ممتعاً للغاية

339
00:19:13,430 --> 00:19:16,030
،لم يمنحنا هذه التّواقيع الرّائعة فحسب

340
00:19:16,030 --> 00:19:18,510
بل قدّمَ لنا الشّاي والبسكويت أيضاً

341
00:19:18,510 --> 00:19:20,470
أتمنّى الذهاب مجدّداً

342
00:19:20,470 --> 00:19:22,720
نعم، لنذهب مجدّداً

343
00:19:23,040 --> 00:19:24,950
...حسناً، سأسلك هذا الطريق، لذا

344
00:19:26,520 --> 00:19:29,200
كان رجلاً عظيماً حقّاً

345
00:19:38,100 --> 00:19:42,170
لن تتكلّم عمّا حدث يا كويتشي

346
00:19:45,010 --> 00:19:46,170
!ماذا؟

347
00:19:46,170 --> 00:19:47,920
!لـ-لماذا؟

348
00:19:47,920 --> 00:19:50,800
كيف فقدتُ 20 كيلوغراماً؟

349
00:19:52,850 --> 00:19:55,350
!لكن لا أبدو مختلفاً

350
00:19:56,920 --> 00:19:58,890
...وزنها 5 كيلوغرام

351
00:19:58,890 --> 00:20:00,730
الميزان ليس معطّلاً

352
00:20:04,000 --> 00:20:05,990
هـ-هذا مستحيل

353
00:20:05,990 --> 00:20:09,240
!لا-لا بدّ أنّ هذا من صنيع مُستخدم ستاند عدوّ

354
00:20:09,240 --> 00:20:12,600
!وإلّا من المُحال أن أكون قد خسرتُ 20 كيلوغراماً

355
00:20:12,600 --> 00:20:14,330
...لكن من

356
00:20:14,330 --> 00:20:16,920
عليّ أن أتحدّث مع جوسكي حول هذا الأمر

357
00:20:20,120 --> 00:20:22,050
ما الأمر يا كو؟

358
00:20:23,590 --> 00:20:24,670
أنا؟

359
00:20:26,270 --> 00:20:28,470
لحظة... ماذا كان؟

360
00:20:28,470 --> 00:20:30,730
عمّاذا تتكلّم؟ كم أنت غريب

361
00:20:30,730 --> 00:20:31,960
ما الأمر؟

362
00:20:31,960 --> 00:20:36,010
لا شيء، أخي الصّغير يتجوّل بلباسه الداخليّ

363
00:20:36,010 --> 00:20:37,510
ماذا كان؟

364
00:20:37,510 --> 00:20:41,780
أكاد أقسمُ أنّني أردتُ قول كلام مهمّ للتو

365
00:20:45,450 --> 00:20:49,440
حسناً، بما أنّني نسيتُه فهذا يعني أنّه غير مهمّ

366
00:20:53,960 --> 00:20:59,130
تبّاً، أشعرُ أنّ حذائي وحقيبتي ثقيلان اليوم

367
00:20:59,130 --> 00:21:00,010
ماذا؟

368
00:21:01,620 --> 00:21:03,760
...هـ-هذا البيت

369
00:21:03,760 --> 00:21:05,290
لماذا؟

370
00:21:05,290 --> 00:21:09,540
انتهى المطافُ بي بالسّير إلى بيت روهان سينسي
دون شعور بذلك

371
00:21:11,090 --> 00:21:12,730
...الباب مفتوح

372
00:21:12,730 --> 00:21:15,900
،أودّ زيارته وشكره على البارحة

373
00:21:15,900 --> 00:21:20,540
لكن ربّما أتأخّر عن المدرسة، قد تكون فكرة سيّئة

374
00:21:21,150 --> 00:21:24,020
ولعلّه لا يزال نائماً باعتباره رسّام مانغا

375
00:21:24,020 --> 00:21:26,480
لا يجوز أن أقتحم منزله هكذا فحسب

376
00:21:27,050 --> 00:21:29,030
...هذه ليسَتْ بفكرة سديدة

377
00:21:36,470 --> 00:21:38,960
هل رأيت ذلك يا أوكوياسو؟

378
00:21:38,960 --> 00:21:40,220
...أجل

379
00:21:40,220 --> 00:21:43,300
لحقنا بكويتشي لأنّه كان يسلك

380
00:21:43,300 --> 00:21:46,920
الجهة المُعاكِسة للمدرسة، لكن ما الذي يفعله بالضبط؟

381
00:21:46,920 --> 00:21:49,450
لِمَن هذا المنزل؟

382
00:21:49,450 --> 00:21:52,270
تنتابني بعض الشّكوك، لكنّها ليسَتْ حسناء ما، أليس كذلك؟

383
00:22:04,840 --> 00:22:06,570
...روهان سينسي

384
00:22:07,660 --> 00:22:10,530
إنّه يعمل بشكل مسعور

385
00:22:10,530 --> 00:22:11,980
...لكن ما هذا يا تُرى

386
00:22:11,980 --> 00:22:15,760
يظلُّ شعور الرُّعب بالتواجدِ هنا يُلازمني

387
00:22:15,760 --> 00:22:17,480
ما الأمر؟

388
00:22:17,990 --> 00:22:19,440
يسرّني أنّك أتيت

389
00:22:19,440 --> 00:22:22,180
فقد كنتُ أنتظرك، أتيتَ على الموعد