1
00:00:04,230 --> 00:00:07,960
كانت يوكاكو ياماغيشي مكتئبة مؤخّراً

2
00:00:10,320 --> 00:00:11,950
ماذا؟ شخص تحبّينه؟

3
00:00:11,950 --> 00:00:13,670
!أجل! نحبُّ بعضنا البعض

4
00:00:17,520 --> 00:00:20,620
ذهبتُ إلى آنجيلو ستون قبل أيّام

5
00:00:20,620 --> 00:00:23,210
وكان هناك الكثير من السيّاح يلتقطون الصُّور

6
00:00:23,210 --> 00:00:24,290
حقّاً؟

7
00:00:28,980 --> 00:00:30,830
ما الخطب يا كويتشي؟

8
00:00:33,600 --> 00:00:37,320
إن أبقيتُ كويتشي في قلبي فهذا كُل
ما أحتاجه لأكون سعيدة

9
00:00:37,320 --> 00:00:40,580
...كنتُ أظنُّ ذلك، لكن هذا صعبٌ حقّاً

10
00:00:42,010 --> 00:00:43,300
...ولو قليلاً

11
00:00:43,300 --> 00:00:44,640
انظر إليّ أرجوك

12
00:00:45,050 --> 00:00:48,450
...لكن لا أعرف ماذا يُفترَض بي أن أفعل

13
00:00:52,270 --> 00:00:53,650
سندريلّا؟

14
00:01:00,050 --> 00:01:01,890
كم أنا محظوظة؟

15
00:01:01,890 --> 00:01:05,520
!لا أصدّق أنّه تقدّمَ شابٌّ رائعٌ كهذا إلى خطبتي

16
00:01:05,520 --> 00:01:09,140
!شكراً لكِ يا دكتورة آية! شكراً جزيلاً لكِ

17
00:01:12,280 --> 00:01:15,140
...يبدو أنّه من الأفضل أن تقضي المرأة شبابها

18
00:01:15,140 --> 00:01:19,050
...سعيدة وقبيحة عوضاً عن قضائه كئيبة وجميلة

19
00:01:19,600 --> 00:01:21,150
تفضّلي

20
00:01:21,150 --> 00:01:23,680
"ستجعلكِ مُستحضرات تجميلي تلتقين بالحبّ"

21
00:01:23,680 --> 00:01:25,900
ما كُتِبَ على تِلك اللّافتة صحيح

22
00:01:26,390 --> 00:01:28,240
...إن كنتِ مُهتمّة

23
00:01:39,820 --> 00:01:42,500
أهلاً بكِ في صالون سندريلّا للتجميل

24
00:01:42,500 --> 00:01:44,060
تفضّلي بالدّخول

25
00:01:45,380 --> 00:01:47,610
اسمي آية تسوجي

26
00:01:47,920 --> 00:01:50,930
أنا خبيرة تجميل وصاحبة هذا المكان

27
00:01:50,930 --> 00:01:54,440
أتكلّمُ كما لو أنّني أعاني من انخفاض
في ضغط الدمّ، لكن لا تنزعجي من ذلك

28
00:01:55,810 --> 00:01:58,560
لكنّني متحفّزة لعملي كثيراً

29
00:02:02,190 --> 00:02:03,300
...أنتِ

30
00:02:03,780 --> 00:02:05,740
فتاة حسناء

31
00:02:07,500 --> 00:02:11,990
...لم أكن أعلمُ أنّه توجد فتاة بهذا الجمال في موريو

32
00:02:12,400 --> 00:02:15,000
والآن تفضّلي بالجلوس هنا لو سمحتِ

33
00:02:15,610 --> 00:02:18,390
دوّني اسمكِ وعنوانكِ على تلك الاستمارة رجاء

34
00:02:18,390 --> 00:02:21,260
لم أقرّر أن أفعل هذا بعد

35
00:02:21,260 --> 00:02:23,770
إليكِ قائمة الأسعار

36
00:02:24,340 --> 00:02:26,940
التبرُّج للزواج من شخص مشهور"؟"

37
00:02:26,940 --> 00:02:30,110
صالون التّجميل هذا مختلف قليلاً عن بقية الصالونات

38
00:02:30,110 --> 00:02:34,170
أنا خبيرة تجميل تصنعُ وجوهَ السّعادة

39
00:02:37,780 --> 00:02:41,040
،علم الفراسة، شكل وجه الإنسان جوهريّاً

40
00:02:41,040 --> 00:02:43,340
.يستطيع أن يغيّر حظَّ الإنسان

41
00:02:43,340 --> 00:02:45,030
،إن كان لديكِ وجه مُحبَّب

42
00:02:45,030 --> 00:02:47,510
فسيعزّز ذلك حظوظ لقائكِ بالحبّ

43
00:02:48,120 --> 00:02:49,720
مع الأسف

44
00:02:49,720 --> 00:02:53,280
شكل عينيكِ وحاجبيكِ ليس جميلاً

45
00:02:54,130 --> 00:02:55,750
سأكون صريحة

46
00:02:55,750 --> 00:02:57,910
هذا هُراء لدرجة خيّبَتْ أملي

47
00:02:57,910 --> 00:02:59,760
أتحاولين الحصول على مال لِقاء ذلك؟

48
00:02:59,760 --> 00:03:05,150
بهذا الوجه، كلّما أحببتِ شابّاً، ابتعد عنكِ أكثر

49
00:03:06,070 --> 00:03:07,630
هل أنا مخطئة؟

50
00:03:07,630 --> 00:03:09,950
ألم تمرّي بهذه التّجربة؟

51
00:03:09,950 --> 00:03:11,350
أنتِ مخطئة

52
00:03:11,350 --> 00:03:13,370
لم يسبق أن حدث هذا في حياتي

53
00:03:13,370 --> 00:03:15,780
هكذا إذاً. حسناً، هذا جيّد

54
00:03:15,780 --> 00:03:17,910
...في حالتكِ

55
00:03:18,330 --> 00:03:20,150
أنا آسفة

56
00:03:20,150 --> 00:03:22,990
لم أتأقلم على العملِ في الرّسوميات الحاسوبيّة كثيراً

57
00:03:23,900 --> 00:03:26,380
هذا هو الوجه الذي سيلتقي بالحبّ

58
00:03:26,380 --> 00:03:29,570
لحظة... هذه جراحة تجميل

59
00:03:29,570 --> 00:03:31,020
هل ستجرين عمليّة جراحيّة؟

60
00:03:31,020 --> 00:03:34,890
هذا وجهٌ سيُصاغ عبر التبرُّج وتدليك الجمال

61
00:03:34,890 --> 00:03:37,430
لكن لن يدوم مفعوله سوى ثلاثين دقيقة

62
00:03:37,430 --> 00:03:39,020
،إن لم تلتقِ بالحبّ

63
00:03:39,020 --> 00:03:41,430
سأعيدُ إليكِ الألف ين

64
00:03:41,430 --> 00:03:42,900
ما رأيكِ بالتّجربة؟

65
00:03:43,860 --> 00:03:46,560
...موافقة، إن كان تبرُّجاً فقط

66
00:03:46,560 --> 00:03:49,910
سأجرِّب على ما أعتقد، رُغم أنّه
قد يكون مجرّد كذب

67
00:03:50,130 --> 00:03:53,580
شكراً لكِ. لنبدأ إذاً

68
00:03:53,580 --> 00:03:55,790
أغمضي عينيكِ

69
00:03:57,450 --> 00:04:00,360
احرصي على عدم فتح عينيكِ

70
00:04:02,020 --> 00:04:04,710
لا تتحرّكي

71
00:04:04,710 --> 00:04:08,530
فقد تُفسدين عملي

72
00:04:10,880 --> 00:04:12,350
...كويتشي

73
00:04:15,070 --> 00:04:17,740
أهذا هو التبرُّج الذي سيجعلكِ تلتقين بالحبّ؟

74
00:04:18,590 --> 00:04:21,310
أتساءلُ ما إن كان حظِّي سيتغيّر فعلاً بمجرّد تغيير

75
00:04:21,310 --> 00:04:23,360
خطوط عيني وحاجبَيّ؟

76
00:04:25,690 --> 00:04:26,670
كويتشي؟

77
00:04:26,670 --> 00:04:29,070
كنتُ أبحث عنكِ يا يوكاكو

78
00:04:29,070 --> 00:04:30,630
أنا؟

79
00:04:30,630 --> 00:04:34,330
نعم... مررتِ من جانب رينغاتي قبل قليل، أليس كذلك؟

80
00:04:34,330 --> 00:04:37,100
شعرتُكِ حزينة حقّاً

81
00:04:37,100 --> 00:04:39,770
...فـ... فقلِقتُ بعض الشيء

82
00:04:39,770 --> 00:04:41,160
قلِقت؟

83
00:04:41,160 --> 00:04:44,020
هل كنتَ قلِقاً عليّ يا كويتشي؟

84
00:04:44,020 --> 00:04:48,810
،نـ-نعم... حدثَ الكثير، لكن هذا لم يعُد يُضايقني

85
00:04:48,810 --> 00:04:50,890
.لهذا لا أريدكِ أن تكتئبي حيال ذلك

86
00:04:51,250 --> 00:04:52,830
حـ-حقّاً؟

87
00:04:52,830 --> 00:04:53,910
...نعم

88
00:04:53,910 --> 00:04:55,840
...لا أصدّق هذا

89
00:04:55,840 --> 00:04:57,750
هل يعزو الفضلُ للتبرُّج فعلاً؟

90
00:04:58,470 --> 00:05:00,660
...كـ-كويتشي

91
00:05:00,950 --> 00:05:02,850
،عِوضاً عن الوقوف هنا

92
00:05:02,850 --> 00:05:05,040
ما رأيك أن نبحث عن مكانٍ للجلوس والدردشة؟

93
00:05:05,950 --> 00:05:08,820
...عـ-عذراً... إن شئت فقط

94
00:05:08,820 --> 00:05:10,680
...في واقع الأمر

95
00:05:10,680 --> 00:05:12,930
...أظنُّني بدأتُ أعطش قليلاً

96
00:05:13,270 --> 00:05:14,990
!ماذا؟

97
00:05:16,270 --> 00:05:18,040
أنا محظوظة حقّاً

98
00:05:18,040 --> 00:05:19,690
!تتغيّر الأمور بالفعل

99
00:05:20,340 --> 00:05:23,960
تمكّنتُ من الجلوس بجانب الظريف
...والقويّ في نفس الوقت كويتشي

100
00:05:20,960 --> 00:05:23,960
أريدُ أن آكل بارفية بالشوكولاتة فجأة

101
00:05:23,960 --> 00:05:25,820
هل يجعلُني هذا كالبنات؟

102
00:05:25,820 --> 00:05:27,660
!لا! إطلاقاً

103
00:05:27,940 --> 00:05:30,250
!هذا ما أردتُه أيضاً

104
00:05:30,930 --> 00:05:32,430
...هذا أشبه بحلم

105
00:05:32,430 --> 00:05:34,270
!علم الفراسة موجود فعلاً

106
00:05:34,270 --> 00:05:35,810
أنا أحقّقُ نجاحاً باهراً الآن

107
00:05:35,810 --> 00:05:38,390
!حظِّي يحقّقُ نجاحاً باهراً الآن

108
00:05:46,680 --> 00:05:48,970
...لـ-لا أصدّق هذا

109
00:05:49,560 --> 00:05:52,820
...أشعرُ بدفء وقلب كويتشي-كُن النّابض

110
00:05:52,820 --> 00:05:54,190
...تغمرُني السّعادة

111
00:05:54,630 --> 00:05:58,070
هذه أسعد لحظة في حياتي

112
00:05:58,070 --> 00:06:00,610
!إنّها الرّابعة عصراً! لا أصدّق أنّ الوقت تأخّر إلى هذا الحدّ

113
00:06:02,360 --> 00:06:03,850
!مـ-ماذا؟

114
00:06:04,550 --> 00:06:06,090
!مـ-معدتي تؤلمني

115
00:06:07,500 --> 00:06:09,170
!يـ-يوكاكو، أنا آسف

116
00:06:09,170 --> 00:06:10,780
أنا ذاهب إلى المنزل

117
00:06:10,780 --> 00:06:12,350
!كـ-كويتشي

118
00:06:19,010 --> 00:06:19,990
لماذا؟

119
00:06:19,990 --> 00:06:25,430
!لماذا ثلاثين دقيقة فقط؟

120
00:06:29,520 --> 00:06:31,840
يا سيّدة! ألا ترين ضوء الإشارة الحمراء؟

121
00:06:31,840 --> 00:06:32,930
!اصمت

122
00:06:32,930 --> 00:06:35,040
!الضوء هو السّبب لأنّه أصبح أحمر

123
00:06:35,470 --> 00:06:37,820
!لماذا ثلاثين دقيقة فقط؟

124
00:06:37,820 --> 00:06:39,370
!اجعليها أطول

125
00:06:40,000 --> 00:06:42,340
التقيتِ بالحبّ، أليس كذلك؟

126
00:06:42,340 --> 00:06:46,370
ينبغي أن تكتفي بهذا القدر وتعودي غداً

127
00:06:46,370 --> 00:06:49,010
كلّ زبوناتي الأُخريات فعلن ذلك

128
00:06:49,010 --> 00:06:51,920
لا! لا أقبل بحظٍّ يسمح لي بالبقاء

129
00:06:51,920 --> 00:06:54,430
!مع كويتشي لثلاثين دقيقة فقط ثمّ يفرّقنا

130
00:06:55,230 --> 00:06:57,680
!أريدُ التبرُّج الذي يخطف الحبّ

131
00:06:57,680 --> 00:06:58,610
يمكنكِ القيام به، صحيح؟

132
00:06:58,610 --> 00:07:00,810
أنتِ لا تستمعين للآخرين فعلاً

133
00:07:00,810 --> 00:07:02,270
"قلتُ "افعليها

134
00:07:02,700 --> 00:07:04,860
يوكاكو

135
00:07:04,860 --> 00:07:07,020
،استطاعت سندريلّا أن تلتقي بحبٍّ رائع

136
00:07:07,020 --> 00:07:10,610
رُغم أنّه كان يُسخَر من قلبها الطّاهر

137
00:07:10,610 --> 00:07:12,580
ما يعني أنّكِ بحاجة لأن تكوني

138
00:07:12,580 --> 00:07:15,040
مُستعدّة لوقوع هذا اللّقاء الرّائع

139
00:07:15,040 --> 00:07:17,050
هل أنتِ قادرة على فعل ذلك؟

140
00:07:17,050 --> 00:07:19,730
مستعدّة؟ عمّاذا تتكلّمين؟

141
00:07:19,730 --> 00:07:25,040
لا يكفي أن تغيّري سحنتكِ فقط

142
00:07:26,180 --> 00:07:32,580
أصبحتُ خبيرة تجميل لأنّني أعجبتُ
بالعرّابة الجنّية في سندريلّا

143
00:07:32,580 --> 00:07:36,190
أريدُ أن أعيش وأنا أمنحُ السّعادة للأخريات مثلها تماماً

144
00:07:36,680 --> 00:07:39,040
أنتِ حسناء وتروقينني

145
00:07:39,390 --> 00:07:41,730
...ولذلك أفعلُ هذا خصّيصاً لكِ

146
00:07:42,060 --> 00:07:43,320
...لكن

147
00:07:43,320 --> 00:07:47,040
علينا أن نعمل على أجزاء مختلفة

148
00:07:55,470 --> 00:07:57,700
جسدكِ برمّته... الجسد برمّته

149
00:07:57,700 --> 00:08:00,600
يجبُ أن يتحوّل إلى جسدٍ قادر على خطفِ الحبّ

150
00:08:01,120 --> 00:08:04,440
...والاستعدادّ المهمّ الذي نحكي عنه هو هذا

151
00:08:04,850 --> 00:08:07,340
عليكِ أن تستخدمي أحمر الشّفاه هذا في كلّ ثلاثين دقيقة

152
00:08:07,340 --> 00:08:09,030
باستثناء ساعات النّوم

153
00:08:09,510 --> 00:08:12,070
وذلك للحفاظِ على جسدكِ بعد أن أنتهي من العمل عليه

154
00:08:12,380 --> 00:08:17,580
إن كان بمقدوركِ فعل هذا، فستنالين الحظّ
الذي يخطف الحبّ للأبد

155
00:08:18,160 --> 00:08:21,150
السّعر هو 72.000 ين لمدّة 24 ساعة

156
00:08:21,150 --> 00:08:23,210
موافقة. افعلي ذلك

157
00:08:26,710 --> 00:08:30,000
والآن لا تتحرّكي

158
00:08:30,000 --> 00:08:32,220
احرصي على عدم فتح عينيكِ

159
00:08:36,430 --> 00:08:39,820
عرفتُ أنّكِ لستِ خبيرة تجميل عاديّة

160
00:08:42,240 --> 00:08:43,680
...هـ-هذه القوّة

161
00:08:43,680 --> 00:08:46,160
يمكنكِ رؤية ساندريلّا خاصّتي؟

162
00:08:46,630 --> 00:08:49,970
هكذا إذاً... كانت قوى ستاند إذاً

163
00:08:51,020 --> 00:08:53,660
لكن فكّرتُ بالأمر ووجدتُ نفسي لا أكترث

164
00:08:53,660 --> 00:08:58,010
فلو أردتِ أذيّتي لكنتِ قد فعلتِ

165
00:08:58,010 --> 00:09:01,100
أثقُ بكِ، أنتِ بالفعل عرّابة جنّية

166
00:09:02,400 --> 00:09:04,050
...أخفتِني

167
00:09:05,930 --> 00:09:07,800
ابدئي بسُرعة

168
00:09:09,090 --> 00:09:10,710
...يا لكِ من فتاة رائعة

169
00:09:10,710 --> 00:09:13,260
حسناً، سأستخدم سحري

170
00:09:19,660 --> 00:09:23,330
سندريلّا هي ستاند يحوّلُ صورة الجسم

171
00:09:23,590 --> 00:09:27,330
يُتِمُّ هذا العمل بإتقان على جسدكِ لخطف الحبّ

172
00:09:27,690 --> 00:09:32,500
يوكاكو، أصبح جسدكِ لا يُقهَر عندما يتعلّقُ الأمر بالحبّ

173
00:09:36,060 --> 00:09:39,140
...زال الألمُ عن معدتي فجأة

174
00:09:39,140 --> 00:09:42,290
هذه حقيبةُ يوكاكو، تبّاً

175
00:09:42,290 --> 00:09:44,430
عليّ أن أعود وأعيدها إليها

176
00:09:49,080 --> 00:09:50,400
كويتشي

177
00:09:51,110 --> 00:09:53,020
...يـ-يوكاكو

178
00:10:00,630 --> 00:10:05,090
نعم، تفضّلي! هذه حقيبتكِ

179
00:10:06,410 --> 00:10:07,920
وهذه لي

180
00:10:08,230 --> 00:10:11,260
أخذتُها بالخطأ. آسف على ذلك

181
00:10:11,840 --> 00:10:13,300
حـ-حسناً، أراكِ لاحقاً

182
00:10:13,300 --> 00:10:16,060
!ا-انتظر يا كويتشي

183
00:10:16,060 --> 00:10:17,560
انظر إليّ

184
00:10:19,870 --> 00:10:24,650
ألا تشعر بشيء عندما تنظر إليّ؟

185
00:10:24,650 --> 00:10:28,100
...فـ-في الواقع... في الواقع

186
00:10:28,100 --> 00:10:29,470
...في الواقع

187
00:10:30,410 --> 00:10:32,960
!أراك هنا يا كويتشي

188
00:10:32,960 --> 00:10:34,450
روهان-سينسي

189
00:10:34,790 --> 00:10:37,930
أنا متوجّه إلى متجر كامي يو للبحث

190
00:10:37,930 --> 00:10:39,460
تعال معي

191
00:10:39,460 --> 00:10:42,440
...كنتُ أنوي الذهاب إلى المنزل

192
00:10:42,440 --> 00:10:45,880
من المحرج أن تلتقط صوراً داخل متجر بمفردك، أليس كذلك؟

193
00:10:45,880 --> 00:10:46,510
لِذا من فضلك

194
00:10:45,950 --> 00:10:48,020
ما-ما هذا؟

195
00:10:46,510 --> 00:10:48,470
أنت مُلِحٌّ جداً... تبّاً

196
00:10:48,600 --> 00:10:51,730
!ألم يكن من المُفترَض أن أصبح البطلة التي لا تُقهَر؟

197
00:10:52,050 --> 00:10:54,060
ماذا حلَّ بفاعليّة

198
00:10:54,060 --> 00:10:55,860
!قوى سندريلّا خاصّتكِ؟

199
00:10:56,080 --> 00:10:58,030
كو

200
00:10:56,310 --> 00:11:00,530
لا، أصبح قلب كويتشي ملكاً لكِ الآن

201
00:10:58,030 --> 00:11:00,530
أمّي، أختي

202
00:11:00,530 --> 00:11:04,460
لكن ما يرفضكِ هو منطقُه

203
00:11:04,460 --> 00:11:07,750
هل حدث شيء بينكِ وبين كويتشي في الماضي؟

204
00:11:07,750 --> 00:11:08,910
لا بدّ وأنّ هذا هو السبب

205
00:11:08,910 --> 00:11:11,800
هذا السيّد النّبيل هو رسّام مانغا؟

206
00:11:11,800 --> 00:11:14,670
إنّه جميل. هل يمكننا الانضمام؟

207
00:11:12,740 --> 00:11:14,670
لكن لا تقلقي

208
00:11:14,670 --> 00:11:17,510
سيحالفكِ الحظّ في نهاية المطاف

209
00:11:17,510 --> 00:11:19,740
لا يوجد أعظم من سندريلّا

210
00:11:19,740 --> 00:11:24,450
بالمناسبة، إنّها السّاعة 4:45
مضى ثلاثون ساعة تقريباً

211
00:11:24,450 --> 00:11:27,060
احرصي على عدم نسيان استخدام أحمر الشّفاه

212
00:11:27,310 --> 00:11:29,820
نعم، أنا أضعه الآن

213
00:11:30,550 --> 00:11:33,570
الحظّ يحالفني؟

214
00:11:33,570 --> 00:11:37,330
ماذا؟ ستذهبان إلى كاميو؟ ونحن كذلك

215
00:11:37,330 --> 00:11:38,290
!ماذا؟

216
00:11:38,290 --> 00:11:40,240
!ما خطبُ هؤلاء النّاس؟

217
00:11:40,240 --> 00:11:42,200
!ازداد عددهم

218
00:11:42,200 --> 00:11:44,870
!وأتت أقلّ شخصيّة أتمنّى عدم وجودها وهي أمّه

219
00:11:44,870 --> 00:11:48,960
!الحظّ لا يحالفني أبداً

220
00:11:48,960 --> 00:11:51,460
!سأقتلُ صاحبة الصّالون الحقيرة تلك

221
00:11:51,950 --> 00:11:54,180
أظنُّنا يمكننا البدء بالتقاط الصّور هنا

222
00:11:57,990 --> 00:12:00,900
هل تستخدم ضوء الكاميرا؟

223
00:12:00,900 --> 00:12:02,470
هذا سيّئ يا جوسكي

224
00:12:02,470 --> 00:12:05,070
!ارتعدَتْ، والتوتُّر يجعلها تختفي

225
00:12:05,070 --> 00:12:08,240
!أيّها العجوز! هيّا بنا نخرج

226
00:12:08,880 --> 00:12:10,240
!الـ-المعذرة

227
00:12:10,240 --> 00:12:12,310
!أفسِحوا الطريق رجاء

228
00:12:12,310 --> 00:12:12,710
ماذا؟

229
00:12:12,710 --> 00:12:13,620
ما-ما الذي يجري؟

230
00:12:14,370 --> 00:12:16,750
!آسف يا كويتشي

231
00:12:24,540 --> 00:12:26,630
...يـ-يوكاكو

232
00:12:27,240 --> 00:12:29,640
...كـ-كويتشي

233
00:12:33,350 --> 00:12:36,110
هذا... هو الحظّ

234
00:12:36,110 --> 00:12:37,530
!هذا هو

235
00:12:39,460 --> 00:12:41,620
قلوبنا تفهمُ بعضها الآخر

236
00:12:41,620 --> 00:12:45,210
...قلب كويتشي يتدفّقُ إلى قلبي

237
00:12:46,060 --> 00:12:48,200
...هذا كُل ما أريده

238
00:12:48,200 --> 00:12:52,510
...وحياتي ستتغيّر اعتباراً من الآن

239
00:12:57,120 --> 00:12:59,920
:اسم الستاند

240
00:12:58,500 --> 00:12:59,920
:اسم المالِك

241
00:13:00,250 --> 00:13:02,460
...جوسكي، أوكوياسو

242
00:13:02,460 --> 00:13:06,290
...انتهى المطافُ بي بتقبيلِ يوكاكو

243
00:13:12,610 --> 00:13:14,600
!ماذا فعلَتْ؟

244
00:13:14,600 --> 00:13:17,740
أنا متأكّد أنّ تِلك الساقطة التي لا تستسلم
قد أقدمَتْ على شيء ما مجدّداً

245
00:13:17,740 --> 00:13:20,160
...اهدأ! الأمر ليس هكذا

246
00:13:20,640 --> 00:13:21,970
...كلّ ما في الأمر

247
00:13:21,970 --> 00:13:25,710
أنّني وقعتُ في حبِّ يوكاكو أيضاً على ما يبدو

248
00:13:25,710 --> 00:13:26,560
ماذا؟

249
00:13:26,560 --> 00:13:30,540
...بدأتُ أشعرُ أنّ شخصيّتها ليست بسيّئة كثيراً

250
00:13:30,540 --> 00:13:32,690
تجعلُني أشعرُ بالدفء من الدّاخل

251
00:13:32,690 --> 00:13:34,570
أهذا هو الحبّ؟

252
00:13:34,570 --> 00:13:36,860
...لستُ متأكّداً تماماً

253
00:13:34,570 --> 00:13:36,860
أوكوياسو، هل سمعتَه؟

254
00:13:36,860 --> 00:13:39,720
...حتّى الستاند سينفجر وتتطاير أجزاؤه إذا سمع ذلك

255
00:13:39,720 --> 00:13:41,180
...هو ويوكاكو

256
00:13:45,150 --> 00:13:48,710
!مهلاً مهلاً مهلاً! لا يوجد ما يدعو للبُكاء

257
00:13:48,710 --> 00:13:50,330
...لكن يا كويتشي

258
00:13:50,330 --> 00:13:53,760
،لا أدري سبب تغيّرك رأساً على عقب

259
00:13:53,760 --> 00:13:56,820
،لكن إن كنتَ أنتَ ويوكاكو تتبادلان المشاعر

260
00:13:56,820 --> 00:13:59,060
فلا ينبغي أن تكون هنالك مُشكلة

261
00:13:59,060 --> 00:14:01,390
...مع أنّ الأمر ليس كذلك

262
00:14:01,750 --> 00:14:05,310
رفضت يوكاكو رؤيتي منذُ ذلك الحين

263
00:14:05,930 --> 00:14:07,830
هُنا يكمن السرّ الغامض

264
00:14:07,830 --> 00:14:10,150
غابت عن المدرسة في اليومين الماضيين

265
00:14:10,150 --> 00:14:11,550
...إنّها لا تجيب على الهاتف

266
00:14:11,550 --> 00:14:14,770
لم تتّصل بي إطلاقاً. هذا كُل ما في الأمر

267
00:14:14,770 --> 00:14:17,910
...هـ-هل تعني أنّه منذُ قبلتكما

268
00:14:17,910 --> 00:14:19,330
لم تسمع عنها شيئاً؟

269
00:14:19,330 --> 00:14:20,300
إطلاقاً

270
00:14:20,300 --> 00:14:24,150
هذا عجيبٌ جدّاً

271
00:14:24,150 --> 00:14:30,030
على النّقيض، أعجبتُ بوفاء يوكاكو لحبّها

272
00:14:30,030 --> 00:14:32,370
لكن بصراحة، لا أظنّك ستحظى

273
00:14:32,370 --> 00:14:35,290
.بإجابة إلّا إذا سألتَ يوكاكو شخصيّاً

274
00:14:35,590 --> 00:14:38,540
...لا ينبغي أن نقحم أنفسنا في الأمر

275
00:14:38,790 --> 00:14:40,670
...أ-أجل

276
00:14:40,670 --> 00:14:44,060
!لكن إن تعرّضتَ لخطر فأخبرنا

277
00:14:44,060 --> 00:14:45,670
!سنأتي إليك فوراً

278
00:14:45,670 --> 00:14:48,230
شكراً، سأذهب الآن

279
00:14:48,230 --> 00:14:49,110
نعم

280
00:14:49,920 --> 00:14:51,040
...لكن

281
00:14:51,040 --> 00:14:53,340
...كيف يجرؤ كويتشي على تقبيل شخص

282
00:14:53,340 --> 00:14:56,180
...تبّاً، لا ينبغي أن تبكي لسبب كهذا

283
00:15:00,950 --> 00:15:03,360
!هـ-هذا الشّعر

284
00:15:03,360 --> 00:15:04,690
!يوكاكو

285
00:15:05,690 --> 00:15:07,990
!ا-انتظري يا يوكاكو

286
00:15:08,980 --> 00:15:10,480
...عـ-عذراً

287
00:15:15,350 --> 00:15:18,990
لستُ من تبحث عنه

288
00:15:18,990 --> 00:15:23,450
...عـ-عذراً... شعرتُكِ تشبهينها من الخلف، لِذا

289
00:15:32,580 --> 00:15:34,250
!في الواقع، لا، لحظة

290
00:15:37,600 --> 00:15:39,840
...كـ-كويتشي

291
00:15:55,190 --> 00:15:58,320
!كيف تجرؤين على فعل هذا بي أيّتها الحمقاء الغبيّة؟

292
00:15:58,320 --> 00:16:00,160
!وجهي ينهار باستمرار

293
00:16:00,160 --> 00:16:02,200
حتّى لو تبرّجتُ، تسقطُ المُستحضرات فحسب

294
00:16:06,190 --> 00:16:08,740
!أيّتها المرأة الحقيرة

295
00:16:08,740 --> 00:16:10,660
!أعيدي وجهي إلى طبيعته

296
00:16:12,370 --> 00:16:14,070
...يبدو أنّكِ

297
00:16:14,710 --> 00:16:17,060
قد نكثتِ بوعدنا

298
00:16:17,950 --> 00:16:19,690
هذا مؤسف للغاية

299
00:16:19,690 --> 00:16:25,340
قلتُ لكِ مراراً أن تضعي أحمر شفاه سندريلّا
...بعد كُل 30 دقيقة

300
00:16:25,340 --> 00:16:27,610
!أخطأتُ ونسيت

301
00:16:28,550 --> 00:16:31,550
...ما-ما هذا؟ يدايّ

302
00:16:33,590 --> 00:16:35,560
!إنّهما تتفتّتان

303
00:16:35,560 --> 00:16:38,330
الخطوط في يديكِ وبصمات أصابعكِ تختفي

304
00:16:38,330 --> 00:16:41,000
ما كان ينبغي أن تنكثي بالوعد

305
00:16:41,000 --> 00:16:44,900
كان أحمر الشّفاه سيضمنُ حظّكِ

306
00:16:45,140 --> 00:16:49,540
تحتاجين لكثير من الطّاقة لتغيّري حظّ شخص

307
00:16:49,540 --> 00:16:51,530
وذلك الحظّ قد تبدّد الآن

308
00:16:51,530 --> 00:16:54,990
هذه غلطتكِ لاستهانتكِ بحظّكِ

309
00:16:55,170 --> 00:16:57,280
!هـ-هل تريدين أن تموتي؟

310
00:16:57,280 --> 00:16:58,750
أموت؟

311
00:16:58,750 --> 00:17:03,290
أنا لا أدير صالوناً لأجل الطّموح والمال وحدهما

312
00:17:03,290 --> 00:17:06,480
أردتُ أن أكون مثل العرّابة الجنّية

313
00:17:06,480 --> 00:17:10,150
في سندريلّا والتي ترسمُ السّعادة للنّاس

314
00:17:10,520 --> 00:17:12,370
هذا مُخزٍ حقّاً

315
00:17:12,370 --> 00:17:16,290
ما كان ينبغي أن أحاول تحقيق حلمكِ

316
00:17:16,290 --> 00:17:18,930
وجهُكِ وخطوط يديكِ تختفي الآن

317
00:17:18,930 --> 00:17:20,940
!لقد مُسِحا من هذا العالم

318
00:17:21,640 --> 00:17:23,300
ماذا؟

319
00:17:23,300 --> 00:17:24,760
اختفيا تماماً

320
00:17:24,760 --> 00:17:27,430
لا حاجة لفتاة لا تمتلك كلّ أجزائها

321
00:17:27,830 --> 00:17:30,840
وجهي... اختفى؟

322
00:17:30,840 --> 00:17:34,060
أي حياة تعيشُها فتاة من دون أجزائها؟

323
00:17:34,060 --> 00:17:35,410
!يوكاكو

324
00:17:37,330 --> 00:17:39,150
!كـ-كويتشي

325
00:17:39,560 --> 00:17:40,910
ماذا تفعل هنا؟

326
00:17:40,910 --> 00:17:43,180
لا، لا أستطيع... سيكشفني

327
00:17:43,180 --> 00:17:47,510
لـ-لا، لقد أتيتَ للشخص الخطأ

328
00:17:47,910 --> 00:17:51,870
دكتورة آية، لا يُسمَح بدخول الرّجال إلى هنا، صحيح؟

329
00:17:51,870 --> 00:17:53,410
اطرديه من هنا بسرعة رجاء

330
00:17:56,270 --> 00:17:58,690
...إنّها تِلك الشخصيّة

331
00:17:58,990 --> 00:18:01,420
تِلك الشخصيّة القويّة جدّاً

332
00:18:01,420 --> 00:18:03,090
لا شكّ في ذلك، أنتِ يوكاكو

333
00:18:04,410 --> 00:18:07,140
...وقعتُ في حبّ تلك الشخصيّة بعض الشيء

334
00:18:07,590 --> 00:18:11,410
وتِلك المرأة هي مستخدمة ستاند، صحيح؟

335
00:18:11,770 --> 00:18:14,640
...وقد فعلَتْ شيئاً بكِ

336
00:18:15,980 --> 00:18:17,350
انتهى الأمر

337
00:18:17,350 --> 00:18:19,080
لا أستطيع متابعة العيش بعد الآن

338
00:18:19,770 --> 00:18:22,350
!سأقتلُكِ يا آية تسوجي

339
00:18:22,350 --> 00:18:24,100
!سأقتلُكِ

340
00:18:24,100 --> 00:18:25,980
اهدئي

341
00:18:30,380 --> 00:18:33,960
!هذا... جـ-جزء من وجهها يحلّق هنا وهناك

342
00:18:33,960 --> 00:18:35,910
ها نحنُ ذا

343
00:18:37,400 --> 00:18:40,620
...هذا هو كويتشي إذاً

344
00:18:40,620 --> 00:18:42,650
استطاع أن يعرف أنّكِ

345
00:18:42,650 --> 00:18:44,920
يوكاكو ياماغيشي رُغم اختلاف وجهكِ

346
00:18:45,540 --> 00:18:48,250
،رُغم أنّكِ أنكرتِ نفسكِ

347
00:18:48,250 --> 00:18:50,920
إلّا أنّ بعض النّاس يستطيعون تمييز شخصيّة المرء

348
00:18:51,220 --> 00:18:52,830
حسناً يا يوكاكو

349
00:18:52,830 --> 00:18:58,780
...بالنيابة عنه، أمنحُكِ فرصة أخيرة كعرّابة جنّية

350
00:18:59,890 --> 00:19:04,770
فرصتكِ الأخيرة هي اختيار إحدى هذه الوجوه

351
00:19:05,170 --> 00:19:07,770
،رحل وجهُكِ الحقيقيّ الآن

352
00:19:07,770 --> 00:19:13,400
لكن سندريلّا خاصّتي قد حفظَتْ كلّ وجه
عمِلنا عليه حتّى الآن

353
00:19:13,880 --> 00:19:17,150
اختاري وجهكِ من بين هذه الوجوه

354
00:19:17,510 --> 00:19:19,410
،إذا استطعتِ اختيار وجهكِ

355
00:19:19,410 --> 00:19:21,950
من المُمكن إعادته إلى طبيعته

356
00:19:21,950 --> 00:19:24,460
وستعودُ خطوطُ يديكِ وبصمات أصابعكِ بشكل طبيعيّ

357
00:19:24,920 --> 00:19:30,030
كحذاء سندريلّا الزجاجي، اختاري الوجه المناسب لكِ

358
00:19:30,660 --> 00:19:33,490
!كان ينبغي أن تدعيني أفعلُ هذا من البداية أيّتها الحمقاء

359
00:19:33,490 --> 00:19:35,360
!أستطيعُ تمييزه بسهولة

360
00:19:35,360 --> 00:19:38,420
!فأنا أنظرُ إلى وجهي كلّ يوم

361
00:19:39,010 --> 00:19:42,150
،لكن إذا اخترتِ وجه شخص آخر

362
00:19:42,150 --> 00:19:45,000
فلن يليق بكِ ذلك الوجه أبداً

363
00:19:45,000 --> 00:19:49,930
،في الحقيقة، أكثر من مجرّد كلمة يليق

364
00:19:49,930 --> 00:19:53,680
.أحذّركِ أنّ وجهكِ سيصبح قبيحاً

365
00:19:53,680 --> 00:19:58,140
وسيعتمدُ حظُّكِ على ذلك الوجه للأبد

366
00:20:02,610 --> 00:20:04,150
...يـ-يوكاكو

367
00:20:04,150 --> 00:20:05,870
اختاري بتأنٍّ

368
00:20:05,870 --> 00:20:08,650
وجهُكِ في المرآة هو صورة معكوسة

369
00:20:09,060 --> 00:20:10,800
...نـ-نعم

370
00:20:11,890 --> 00:20:14,650
الإجابة الصّحيحة هي أنّ كلّ الوجوه خاطئة

371
00:20:15,000 --> 00:20:17,820
ولا وجه من هذه الوجوه هو وجهكِ

372
00:20:17,820 --> 00:20:21,040
إن استطعتِ كشف ذلك، سأصلحُ وجهكِ

373
00:20:21,380 --> 00:20:23,630
هذه هي قاعدتي كعرّابة جنّية

374
00:20:24,100 --> 00:20:28,040
حالما أبدأ بالتّخمين، تبدو لي وجوهاً أخرى
...مُناسبة أيضاً

375
00:20:28,040 --> 00:20:28,790
...لكن

376
00:20:29,250 --> 00:20:31,620
!هذا هو! لا شكّ في ذلك

377
00:20:31,620 --> 00:20:33,920
!أنا متأكّدة، لأنّه وجهي

378
00:20:33,920 --> 00:20:35,710
هل أنتِ متيقّنة؟

379
00:20:35,710 --> 00:20:38,040
ستكتشفين حالما تحاولين تركيبه

380
00:20:51,230 --> 00:20:54,580
لـ-لا... ليس هذا

381
00:20:54,580 --> 00:20:57,860
عينايّ أكثر ميلاناً

382
00:20:57,860 --> 00:20:59,940
أ-أيُّهم؟

383
00:20:59,940 --> 00:21:02,520
...لـ-لا أستطيع التّمييز إذاً

384
00:21:09,810 --> 00:21:12,080
ما الأمر؟ اختاري بسُرعة

385
00:21:12,890 --> 00:21:16,250
لا، أ... أستسلم للاختيار

386
00:21:16,250 --> 00:21:17,000
ماذا؟

387
00:21:17,270 --> 00:21:18,710
عمّاذا تتحدّثين؟

388
00:21:18,710 --> 00:21:20,880
أتريدين أن تعيشي حياتكِ دون وجه؟

389
00:21:20,880 --> 00:21:23,340
سأدعُ كويتشي يختار عنّي

390
00:21:24,990 --> 00:21:28,360
،لأنّ... مهما كان شكل الوجه أو الحظّ الذي يحملُه

391
00:21:28,360 --> 00:21:33,380
ما دام قد اختارَه كويتشي فهذا كُل ما أحتاجه

392
00:21:33,790 --> 00:21:35,520
أستطيعُ العيش به

393
00:21:35,520 --> 00:21:37,510
لن أتحسّر أبداً

394
00:21:37,510 --> 00:21:39,980
...لـ-لكن هذا ليس

395
00:21:40,980 --> 00:21:42,520
لا يهمّني

396
00:21:45,570 --> 00:21:48,120
اختر أرجوك يا كويتشي

397
00:21:48,880 --> 00:21:50,530
...حـ-حسناً

398
00:21:58,590 --> 00:21:59,750
هذا هو

399
00:22:00,230 --> 00:22:03,380
لا أعرف السّبب، لكن ينتابُني إحساس أنّه هذا

400
00:22:03,710 --> 00:22:06,470
...لكن إن لم يكن الوجه الصّحيح

401
00:22:07,790 --> 00:22:10,880
هذا إيكوز، الستاند الخاصّ بي

402
00:22:10,880 --> 00:22:17,510
استخدمي الستاند الخاصّ بكِ لأذيّة
عينَيّ إيكوز واجعليني أعمى

403
00:22:18,570 --> 00:22:21,020
،قلتِ أنّكِ لن تتحسّري على شيء

404
00:22:21,020 --> 00:22:22,900
،لكن أعرف شخصيّتكِ جيّداً

405
00:22:22,900 --> 00:22:26,930
أنا متأكّدٌ أنّكِ لا ترغبين بأن أحدّق
في وجهكِ وهو ليس لكِ

406
00:22:27,300 --> 00:22:30,470
،ولأنّني وقعتُ في حبّكِ

407
00:22:30,470 --> 00:22:32,560
أكرهُ حدوث ذلك فعلاً

408
00:22:32,560 --> 00:22:36,450
وبالتالي أرى أنّ الحلّ الأمثل هو ألّا أكون قادراً على الرّؤية

409
00:22:40,870 --> 00:22:42,190
...كويتشي

410
00:22:42,190 --> 00:22:43,700
...حسناً يا يوكاكو

411
00:22:43,700 --> 00:22:44,610
...نعم

412
00:22:58,100 --> 00:23:00,140
!ا-انظر يا كويتشي

413
00:23:00,140 --> 00:23:01,300
!إنّه مناسب تماماً

414
00:23:01,590 --> 00:23:02,630
!كويتشي

415
00:23:02,630 --> 00:23:04,580
!نجحنا يا يوكاكو

416
00:23:04,580 --> 00:23:07,010
!هذا لأنّك اخترتَ وجهي عنّي يا كويتشي

417
00:23:06,220 --> 00:23:08,820
من كان يتوقّع أن يقول أنّه
سيجعلُ نفسه أعمى

418
00:23:08,820 --> 00:23:11,580
كي لا يستطيع رؤية وجهها؟

419
00:23:11,980 --> 00:23:16,190
حرفتُ قواعدي كعرّابة جنّية قليلاً
لكن أصلحتُ وجهكِ لأجلكِ

420
00:23:16,190 --> 00:23:19,420
،فإن حدثَ وانتزعتُ منه بصره وهو لا علاقة له بالأمر

421
00:23:19,420 --> 00:23:22,270
فستتلوّثُ سُمعتي كعرّابة جنّية

422
00:23:22,270 --> 00:23:27,030
يوكاكو، يبدو أنّكِ تعرفين على الأقلّ
كيف تختارين الرّجل المُناسب

423
00:23:27,920 --> 00:23:30,670
صالون سندريلّا مفتوح حاليّاً

424
00:23:31,260 --> 00:23:34,390
سيجعلُكِ تبرّجها تلتقين بالحبّ