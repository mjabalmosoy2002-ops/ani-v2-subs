256
00:15:31,330 --> 00:15:34,420
أمُّك وأختُك تُغادران الغرفة

257
00:15:34,420 --> 00:15:38,210
هذا لا يغيّر من حقيقة أنّهما أسيرتان لي

258
00:15:43,800 --> 00:15:47,300
لن أدعك تؤذي أمِّي أو أختي

259
00:15:47,300 --> 00:15:50,440
!جرِّب فحسب يا كويتشي، جرِّب فحسب

260
00:15:50,440 --> 00:15:52,660
!أزِل القفلَ عنهما

261
00:15:52,660 --> 00:15:57,560
إن رأتْك أمُّك تبرحُني ضرباً

262
00:15:57,560 --> 00:15:59,840
فسيتضخّمُ ذنبُها أكثر فأكثر

263
00:16:00,060 --> 00:16:02,100
!قلتُ لك أزل عنهما القفل

264
00:16:02,100 --> 00:16:06,810
لا تستهِن بتامامي كوباياشي أيُّها الوغد الصّغير

265
00:16:06,810 --> 00:16:09,350
!مـ-مُحال أن أزيل القفل عنهما

266
00:16:14,510 --> 00:16:16,350
ماذا؟

267
00:16:16,740 --> 00:16:17,990
هذا لم يُؤلِم

268
00:16:20,470 --> 00:16:22,820
ما هذا؟

269
00:16:22,820 --> 00:16:25,490
الصّوت مُذهل، لكن الضربة ضعيفة جدّاً

270
00:16:26,180 --> 00:16:28,600
أيّ ستاند الذي تملكُه هذا بالضبط؟

271
00:16:28,600 --> 00:16:33,660
!إنّه لا يتمتّع لا بالسّرعة ولا بالقوّة

272
00:16:33,660 --> 00:16:37,140
!كيف تجرؤ على إخافتي بهذا الشّكل أيُّها الأحمق؟

273
00:16:38,040 --> 00:16:44,010
سأريك أنّ قوّة الستاند تنبعُ من قوّتك الذهنيّة

274
00:16:44,630 --> 00:16:47,670
!ما يعني بأنّ قوّتك الذهنيّة هي صفر

275
00:16:47,960 --> 00:16:50,800
!سأحرصُ على أن أُدفِعك الثّمن غالياً

276
00:16:49,080 --> 00:16:51,930
!ثـ-ثمّة شيء غريب يجري لخدِّه

277
00:16:52,380 --> 00:16:53,750
كـ-سْر"؟"

278
00:16:54,110 --> 00:16:56,840
يبدو كتأثير صوتيّ في مانغا

279
00:17:02,750 --> 00:17:06,470
!ما-ما هذا؟ أسمعُ صوتَ رنينٍ غريب في أُذُنَيّ

280
00:17:06,470 --> 00:17:08,670
...كالصوت الذي سمعتُه عندما تلقّيتُ ضربة

281
00:17:09,910 --> 00:17:12,530
!ما الشيء المكتوب في ذِراعي بالضبط؟

282
00:17:13,310 --> 00:17:15,110
!إ-إنّه لا يزول

283
00:17:20,480 --> 00:17:26,360
...لـ-لحظة... هذه الأصوات التي أسمعُها من باطني

284
00:17:26,360 --> 00:17:29,130
!هل الستاند الخاصّ بك هو من فعلَ هذا؟

285
00:17:30,550 --> 00:17:34,160
!اللّعنة، تخلّصْ من هذا الصّوت

286
00:17:43,030 --> 00:17:44,080
إنّه الصوت

287
00:17:44,080 --> 00:17:47,650
يجعلُ الستاند الخاصّ بي الصوتَ
يتردّدُ صداه من داخل جسده

288
00:17:48,060 --> 00:17:52,880
يذكّرُني هذا بقصيدةِ باشو ماتسو الشّهيرة
...التي تعلّمتُها في المدرسة

289
00:17:53,540 --> 00:17:54,820
هادئ وساكِن"

290
00:17:54,820 --> 00:17:55,960
صرير حشرات الزّيز

291
00:17:55,960 --> 00:17:57,000
"يتسرّبُ بين الصُّخور

292
00:17:58,910 --> 00:18:01,870
اللّعنة، لقد وقعتُ في الخدعة كلّياً

293
00:18:02,310 --> 00:18:05,720
إن أزلتَ القفل عن أمّي وأختي
فسأوقفُ الصّوت

294
00:18:05,720 --> 00:18:08,030
،إن ظللتَ تُقاوم

295
00:18:08,030 --> 00:18:11,140
فحتّى أنا لا أعلم ماذا سيحلُّ بجسدِك

296
00:18:12,260 --> 00:18:13,650
!أوقِف هذا الصّوت

297
00:18:17,430 --> 00:18:19,980
كفّ عن العِناد وأزِل ذلكما القفلَين

298
00:18:19,980 --> 00:18:24,980
!اللّعنة! كيف تجرؤ على فعلِ هذا بي؟

299
00:18:26,020 --> 00:18:30,890
مُحال أن أتمكّن من الغشّ والاحتيال
على النّاس إن كنتُ خائفاً من طفل صغير مثلك

300
00:18:30,890 --> 00:18:36,120
كلمة "تاما" في اسمي تعني "جريء" سأريك
مدى جرأتي

301
00:18:40,010 --> 00:18:41,660
!لستُ خائفاً من مجرّد سكّين

302
00:18:41,660 --> 00:18:43,560
!لا تستخفّ بي

303
00:18:43,560 --> 00:18:46,240
!سأُريك كم أنا مُرعِب

304
00:18:46,240 --> 00:18:48,580
!الخوف الحقيقي من الأقفال

305
00:18:50,460 --> 00:18:53,410
!مُؤلم

306
00:18:50,810 --> 00:18:51,910
!ماذا؟

307
00:18:53,420 --> 00:18:55,790
!مُؤلم، مُؤلم، مُؤلم، مُؤلم، مُؤلم

308
00:18:56,760 --> 00:19:00,260
!اجعل الجرح سطحياً واصرخ كالمجنون

309
00:19:00,260 --> 00:19:01,000
!ارمِه

310
00:19:01,000 --> 00:19:01,880
ارمِه؟

311
00:19:02,200 --> 00:19:03,330
ماذا كانَتْ تِلك الصّرخة؟

312
00:19:03,330 --> 00:19:04,130
ما الأمر؟

313
00:19:05,770 --> 00:19:06,660
!كو؟

314
00:19:06,660 --> 00:19:08,260
!الـ-الأمر ليس كما يبدو لكما

315
00:19:10,510 --> 00:19:12,180
!تـ-تبّاً

316
00:19:12,180 --> 00:19:13,930
!نعم

317
00:19:14,860 --> 00:19:19,060
كـ-كو! كيف تجرؤ على فعل شيء
!مُرعب كهذا؟

318
00:19:19,060 --> 00:19:22,940
لا يا أمّي! الأمرُ ليس كما يبدو لكِ

319
00:19:21,670 --> 00:19:22,940
!لا

320
00:19:23,540 --> 00:19:24,940
!أختي

321
00:19:24,940 --> 00:19:28,540
ربِحت، وخسرتَ أنت

322
00:19:28,940 --> 00:19:31,570
أوقِف هذا الصّوت بسُرعة يا كويتشي

323
00:19:31,570 --> 00:19:33,400
،إن لم توقف هذا الصّوت

324
00:19:33,400 --> 00:19:37,320
فلن تتمكّن أمُّك من تحمُّل وزن ذنبها

325
00:19:38,270 --> 00:19:41,470
،عندما يعجزُ البشرُ عن تحمُّل أعباء خطاياهم

326
00:19:41,470 --> 00:19:44,250
فإنّهم يعتبرون الموتَ أفضل لهم

327
00:19:45,410 --> 00:19:48,950
!لـ-لم أعُد... قادرة

328
00:19:48,950 --> 00:19:49,700
!أمّي

329
00:19:49,700 --> 00:19:51,870
!لا أستطيعُ العيش فترة أطول

330
00:19:52,110 --> 00:19:53,860
!كفّ عن ادِّعاء القوّة

331
00:19:53,860 --> 00:19:57,230
!أوقِف هذا الصّوت بسُرعة، هل ستدعُ أمّك تقتلُ نفسها؟

332
00:19:57,230 --> 00:19:59,030
لا، لن أوقف الصّوت

333
00:20:02,740 --> 00:20:03,920
!ثِقي بي

334
00:20:10,370 --> 00:20:11,510
!ماذا؟

335
00:20:13,050 --> 00:20:15,380
!ثِقي بي يا أمّي

336
00:20:15,820 --> 00:20:16,920
!ثِقي

337
00:20:18,150 --> 00:20:19,260
!أمّي

338
00:20:19,670 --> 00:20:20,630
!ثِقي بي

339
00:20:22,450 --> 00:20:25,640
هذه مسألةٌ تتعلّقُ بالرُّوح
مُحال أن تثِقَ بك

340
00:20:27,900 --> 00:20:28,860
...أمِّي

341
00:20:29,520 --> 00:20:33,380
معها حقّ... إن لم أثِق به أنا، أمّه

342
00:20:33,380 --> 00:20:35,310
فمن سيثِقُ إذاً؟

343
00:20:36,200 --> 00:20:38,590
لطالما كان كويتشي ولداً لطيفاً

344
00:20:39,000 --> 00:20:42,820
لا يمكن أن يؤذي أحداً أو يأخذ مال أحد

345
00:20:42,820 --> 00:20:44,200
!نعم

346
00:20:44,200 --> 00:20:46,240
!تـ-تبّاً

347
00:20:50,570 --> 00:20:51,620
!أمّي

348
00:20:51,620 --> 00:20:53,270
!الـ-اللّعنة

349
00:20:53,270 --> 00:20:55,020
...لا يثِقون بأحد عادة

350
00:20:55,020 --> 00:20:57,830
!ما كان والدايّ ليثِقا بي على الإطلاق

351
00:21:05,330 --> 00:21:07,140
!كانَتْ مجرّد مزحة

352
00:21:08,160 --> 00:21:12,710
!كو، كنتُ أمزح فحسب

353
00:21:13,270 --> 00:21:15,220
أزِل القفل عن أختي أيضاً

354
00:21:15,220 --> 00:21:17,420
!لقد أُزيلَ فحسب

355
00:21:17,420 --> 00:21:20,570
لا يمكنُنا إلحاق الضرر بجمالها، صحيح؟

356
00:21:20,570 --> 00:21:24,180
!كنتُ امزحُ فحسب عندما قلتُ أنّني سآخذُ بيتك

357
00:21:24,180 --> 00:21:27,970
وحتّى أنّني أعدتُ الـ7000 ين، أليس كذلك؟
صحيح؟ صحيح؟

358
00:21:27,970 --> 00:21:32,450
سامحني أرجوك، سأفعلُ أي شيء يا سيِّد كويتشي

359
00:21:32,450 --> 00:21:34,350
ماذا؟ ستفعلُ أي شيء؟

360
00:21:34,350 --> 00:21:38,190
نعم يا سيّدي كويتشي، أي شيء
سأكونُ تابِعاً لك

361
00:21:38,460 --> 00:21:40,570
...حسناً إذاً

362
00:21:41,400 --> 00:21:44,820
احرص على إعطائي خمسمئة مئة ألف يوم الغدّ

363
00:21:46,920 --> 00:21:50,890
هذه مزحة، إنّها مجرّد مزحة صغيرة

364
00:21:54,170 --> 00:21:58,140
!لـ-لم تبدُ كمزحة إطلاقاً

365
00:22:01,580 --> 00:22:06,300
أوكوياسو، ما الذي يجري هُنا بالضبط؟

366
00:22:07,200 --> 00:22:09,570
!اسمح لي أن أحمل حقيبتك إلى المدرسة

367
00:22:09,570 --> 00:22:12,000
هل ستحملُها حقّاً؟

368
00:22:12,000 --> 00:22:13,920
!بالتأكيد

369
00:22:13,920 --> 00:22:16,840
سيّدي كويتشي، أنتَ رجلٌ حقيقيّ

370
00:22:16,840 --> 00:22:18,580
كفَّ عن قول ذلك

371
00:22:19,410 --> 00:22:20,770
!أوكوياسو

372
00:22:20,770 --> 00:22:24,620
لا تسألني، فأنا لستُ ذكياً، هل نسيت؟