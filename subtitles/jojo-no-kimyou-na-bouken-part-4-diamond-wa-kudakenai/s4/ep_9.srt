1
00:00:02,640 --> 00:00:06,440
يبدو أنّ عائلة كويتشي لا تعلم أيضاً

2
00:00:06,440 --> 00:00:09,350
كانَتْ تتحدّثُ عن احتمالِ نيّتها للاتّصال بالشرطة

3
00:00:09,350 --> 00:00:13,600
...إنّه مفقود إذاً، وبما أنّ يوكاكو غائبة أيضاً

4
00:00:13,600 --> 00:00:16,290
أحسُّ بالمسؤولية بعض الشيء

5
00:00:17,130 --> 00:00:19,850
ألا تظنُّه قد مات؟

6
00:00:19,850 --> 00:00:22,250
لا، أشكُّ في أنّها ستفعلُ ذلك

7
00:00:22,250 --> 00:00:24,430
لا بدَّ وأنها تحتفظُ به في مكانٍ ما

8
00:00:24,430 --> 00:00:26,830
علينا إيجاده وبسُرعة

9
00:00:27,290 --> 00:00:30,950
قد تتحوّل المسألة إلى مسألة حياة أو موت

10
00:00:33,720 --> 00:00:35,610
!إنّه لا ينفتح

11
00:00:35,610 --> 00:00:38,200
!هذا سيئ

12
00:00:39,910 --> 00:00:43,090
كان عنوان فيلم أيضاً، أليس كذلك؟

13
00:00:43,090 --> 00:00:46,470
لكنّه بدا طويلاً جدّاً، لهذا لم أشاهده

14
00:00:47,710 --> 00:00:50,780
...شارفتُ على إدخاله

15
00:00:51,270 --> 00:00:54,230
...‏0،0،4،1

16
00:00:55,490 --> 00:00:58,240
...عُذراً

17
00:02:26,240 --> 00:02:29,690
غسلتُ لباسك الداخليّ وسِروال بيجامتك

18
00:02:33,490 --> 00:02:34,530
ما الأمر؟

19
00:02:36,450 --> 00:02:38,970
لن أعرف ما لم تتكلّم

20
00:02:39,310 --> 00:02:42,560
...أ-أنا طالب سنة أولى في المدرسة الثانويّة

21
00:02:42,560 --> 00:02:44,640
هذا أسوأ وضع مُمكن

22
00:02:45,610 --> 00:02:50,170
هذا يتجاوزُ مرحلة الحرَج، أشعرُ وكأنّني
كائن بشريّ فظيع

23
00:02:50,170 --> 00:02:53,520
أرجوكِ، كفِّي عن القيام بهذا

24
00:02:54,050 --> 00:02:56,670
أنتِ تكرهينني الآن، أليس كذلك؟

25
00:02:56,670 --> 00:02:58,490
تعتقدينني مُثيراً للشفقة، صحيح؟

26
00:02:59,390 --> 00:03:01,900
دعيني أذهبُ إلى المنزلِ فحسب

27
00:03:01,900 --> 00:03:05,540
ما الذي يُعجبكِ بي بعدما بلّلتُ ملابسي؟

28
00:03:06,880 --> 00:03:08,870
أيُّها المسكين كويتشي

29
00:03:08,870 --> 00:03:12,860
لا بدّ وأنّني أجرحُ قلبك

30
00:03:14,230 --> 00:03:16,890
أنا فتاةٌ سيّئة

31
00:03:16,890 --> 00:03:19,720
!كلامي لا يُجدي نفعاً على الإطلاق

32
00:03:19,720 --> 00:03:22,260
...أ-أشعرُ بالدُّموع وهي تذرف

33
00:03:22,260 --> 00:03:26,380
في البداية بلّلتُ ملابسي والآن أتبلّلُ بالدُّموع

34
00:03:26,840 --> 00:03:28,300
...لكن يا كويتشي

35
00:03:29,830 --> 00:03:33,260
بعد قولِك أنّك كائن بشريّ فظيع

36
00:03:33,260 --> 00:03:39,350
أرى شيئاً حيويّاً وساطعاً في أعماق عينيك

37
00:03:40,270 --> 00:03:44,080
كما لو أنّك لا تزالُ تمتلك ورقةً رابحة مخفيّة

38
00:03:46,000 --> 00:03:49,900
هذا ما يُعجبني فيك

39
00:03:49,900 --> 00:03:52,640
أودُّ أن أرى ماهيّتها

40
00:03:53,940 --> 00:03:56,220
،وإن كانت تنتمي لشخصٍ تحبُّه

41
00:03:56,220 --> 00:03:59,070
فلا ضير من أن تكون حتّى بِرازاً أو فضلات أنفيّة، صحيح؟

42
00:03:59,470 --> 00:04:01,220
غريب أن تشعرَ بالقلق

43
00:04:01,220 --> 00:04:05,850
شعرتُ بنعمةٍ حقيقيّة أثناء غسيل سروالك

44
00:04:09,430 --> 00:04:10,510
!انظر

45
00:04:12,730 --> 00:04:16,200
أنا أعملُ على كرسيّ الصّعق بالكهرباء

46
00:04:16,200 --> 00:04:19,030
سأحرصُ على إعداده قبل موعدِ الدّراسة أثناء العشاء

47
00:04:23,840 --> 00:04:26,990
أفكّر بتحضيرِ وجبة إيطاليّة على العشاء

48
00:04:27,250 --> 00:04:29,400
ينبغي أن أذهب لشراء بعض زيت الزيتون

49
00:04:31,300 --> 00:04:32,620
تطلّع قُدماً لذلك

50
00:04:37,000 --> 00:04:39,540
!الـ-النّجدة

51
00:04:39,540 --> 00:04:42,140
!إنّها تزدادُ سوءاً

52
00:04:42,140 --> 00:04:43,700
،عليّ أن أهرب بسُرعة

53
00:04:43,700 --> 00:04:46,470
!و-وإلّا ستقتلني فعلاً

54
00:04:47,790 --> 00:04:48,810
...لكن

55
00:04:51,080 --> 00:04:53,300
كيف سأهرب؟

56
00:04:57,510 --> 00:05:00,990
"لكن يمتلكُ كويتشي "أصداء

57
00:05:00,990 --> 00:05:05,290
يستطيعُ من خلاله أن يطلب المُساعدة
حتّى لو كُمّمَ فمه، صحيح؟

58
00:05:05,510 --> 00:05:09,170
لكن مدى "إيكوز" هو حوالي 50 متراً

59
00:05:09,460 --> 00:05:12,980
قد يُقتاد إلى مكانٍ لا يعيشُ فيه أحد

60
00:05:12,980 --> 00:05:15,530
هنالِك أماكن نائية كثيرة

61
00:05:17,920 --> 00:05:18,930
!لحظة

62
00:05:19,280 --> 00:05:22,390
قالَتْ أنّها ذاهبة لشراء بعض زيت الزيتون

63
00:05:22,650 --> 00:05:25,490
لكن لا أظنُّها ستخرجُ للتسوُّق في ظرفٍ كهذا

64
00:05:25,490 --> 00:05:27,570
هل ستطلبُ عبر الهاتف إذاً؟

65
00:05:30,800 --> 00:05:31,520
...هل يُعقَل

66
00:05:37,290 --> 00:05:39,560
!هذا هو ! هاتف عمومي

67
00:05:40,370 --> 00:05:42,700
!‏‏48 متراً، نعم

68
00:05:42,700 --> 00:05:45,020
!إنّه ضمن نِطاقي

69
00:05:46,090 --> 00:05:47,890
إيكوز هو ستاند صوتيّ

70
00:05:47,890 --> 00:05:51,420
أستطيعُ الآن إرسال إشارة نجدة لجوسكي

71
00:05:54,290 --> 00:05:57,380
!لا أملُك عملة معدنيّة بقيمة 10 ين

72
00:05:57,790 --> 00:06:00,360
كنتُ أرتدي البيجامة عندما أُحضِرتُ إلى هنا

73
00:06:00,360 --> 00:06:02,260
هل أتّصل بالرقم 110؟

74
00:06:02,610 --> 00:06:05,680
لكن قد تقتل تِلك المرأة الشرطيّ

75
00:06:05,680 --> 00:06:09,240
!عليّ أن أتّصل بجوسكي بأي وسيلة

76
00:06:09,240 --> 00:06:13,280
كنتَ تتساءلُ ما إن كان يوجد هاتفٌ عموميّ قريب، أليس كذلك؟

77
00:06:15,610 --> 00:06:17,300
...يـ-يوكاكو

78
00:06:17,300 --> 00:06:20,740
أعرفُ تماماً ما الذي تفكّر به

79
00:06:20,740 --> 00:06:23,600
سمعتَني أقولُ أنّني ذاهبة لشراء بعض زيت الزيتون

80
00:06:23,600 --> 00:06:25,740
لِذا لا بدّ من وجود هاتف عموميّ

81
00:06:25,740 --> 00:06:28,900
لكن حتّى لو توصّلتَ إليه، لا تحمل عملةً
معدنيّة بقيمة 10 ين

82
00:06:28,900 --> 00:06:30,500
هذا ما كنتَ تفكِّر به، صحيح؟

83
00:06:30,880 --> 00:06:33,760
هـ-هل هناك هاتف عموميّ؟

84
00:06:34,010 --> 00:06:36,270
تدّعي الحماقة حسبما أرى

85
00:06:36,270 --> 00:06:39,420
ينبغي أن تنسى فكرة مُحاولة الاتّصال بشخص

86
00:06:39,420 --> 00:06:42,770
لن تطأ قدماك خارج هذا المنزل

87
00:06:43,060 --> 00:06:47,280
وتحسُّباً فقط، سأدمّرُ زرّ الـ110 في الهاتف

88
00:06:48,720 --> 00:06:50,250
هل تودُّ شيئاً آخر؟

89
00:06:50,250 --> 00:06:52,530
...لـ-لا، ليس تماماً

90
00:06:57,240 --> 00:06:59,630
!ما-ما خطبها؟

91
00:07:00,210 --> 00:07:03,610
...لا جدوى على ما أعتقد... لا أستطيعُ الاتّصال بأحد

92
00:07:13,680 --> 00:07:15,850
ما هذه الأحرف؟

93
00:07:18,690 --> 00:07:21,070
...ينبعثُ صوتٌ من يدي فجأة

94
00:07:22,830 --> 00:07:24,870
!إنّه يتّصلُ بأحد

95
00:07:24,870 --> 00:07:27,650
وحتّى أنّني لم أضرب الرّقم بعد

96
00:07:29,790 --> 00:07:31,750
مرحباً؟ هيغاشيكاتا يتكلّم

97
00:07:31,750 --> 00:07:33,370
!اتّصل

98
00:07:33,370 --> 00:07:36,840
،ما دامت أصوات المُكالمة تمرُّ عبر الهاتف
.ستُجرى المُكالمة الهاتفيّة

99
00:07:37,900 --> 00:07:41,510
مرحباً، هل كويتشي يتكلّم؟ هذا أنا، جوسكي

100
00:07:41,870 --> 00:07:43,430
كويتشي، أين أنت؟

101
00:07:44,040 --> 00:07:46,430
...ماذا؟ أسمعُ صوتَ موجات

102
00:07:48,370 --> 00:07:50,330
...كويتشي، أنت

103
00:07:51,810 --> 00:07:54,700
تمتلكُ قوّةً مثلي؟

104
00:07:56,140 --> 00:08:00,040
!رائع! والآن سيأتي جوسكي إلى هنا حتماً

105
00:08:00,040 --> 00:08:02,130
يستغرقُ الوصول من 15 إلى 20 دقيقة بسيّارة

106
00:08:02,130 --> 00:08:04,060
!عليّ أن أصمدَ ريثما يأتي

107
00:08:04,060 --> 00:08:05,960
!مـ-مهما كلّفَ الأمر

108
00:08:07,530 --> 00:08:10,650
...صوت موجات... هاتف عمومي

109
00:08:12,160 --> 00:08:13,910
...مكان كويتشي

110
00:08:13,910 --> 00:08:15,250
