184
00:12:49,670 --> 00:12:51,590
اختفى! إنّه مجرّد قشرة فارغة

185
00:12:51,590 --> 00:12:52,880
أين وضعته؟

186
00:12:52,880 --> 00:12:53,600
ماذا؟

187
00:12:53,600 --> 00:12:56,450
!أسألُك ماذا حلّ بالشيء الذي في داخله

188
00:12:56,450 --> 00:12:57,220
!ماذا؟

189
00:13:00,980 --> 00:13:01,750
...هـ

190
00:13:01,750 --> 00:13:02,690
...هذا

191
00:13:02,980 --> 00:13:06,400
ما-ما هذا؟ أصدقاء

192
00:13:06,400 --> 00:13:08,190
!لـ-لم يمت

193
00:13:08,490 --> 00:13:11,970
هل سلخَ قشوره القديمة وتحوّلَ إلى شكلٍ جديد؟

194
00:13:11,970 --> 00:13:13,070
ما هذا؟

195
00:13:13,330 --> 00:13:17,200
تغيّر التّصميم قليلاً فقط، وقد انكمش

196
00:13:17,200 --> 00:13:20,120
!مجرّد تغيير شكله لن يحدث أي فرق

197
00:13:20,760 --> 00:13:22,120
!إ-إنّه سريع

198
00:13:25,780 --> 00:13:27,130
ما-ما هذه

199
00:13:27,130 --> 00:13:28,360
!الرّياح؟

200
00:13:30,600 --> 00:13:33,180
!قُذِفَتْ بعيداً

201
00:13:33,180 --> 00:13:36,430
!لا أعرف كيف، لكن قُذِفَتْ بواسطة شيء أشبه برياح

202
00:13:41,230 --> 00:13:43,180
...ما-ماذا حلَّ

203
00:13:43,860 --> 00:13:45,300
بي للتوّ؟

204
00:13:46,600 --> 00:13:49,890
...أحرف إيكوز على الباب

205
00:13:54,860 --> 00:13:58,490
لأنّها لمست الباب الذي كُتِبَتْ عليه تِلك الكلمات
فتحوّلَ ذلك إلى حقيقة

206
00:13:58,490 --> 00:14:02,520
إحساس "الخَرير" قد قذفَها بعيداً

207
00:14:02,520 --> 00:14:06,510
...تمنّيتُ قبلَ قليل أن يقذفها هذا الباب بعيداً

208
00:14:06,510 --> 00:14:09,590
أظنُّني كنتُ أتحكّمُ به عن جهل

209
00:14:10,420 --> 00:14:12,230
!هذا هو إيكوز الجديد

210
00:14:12,660 --> 00:14:14,620
!إيكوز آكت 2

211
00:14:17,910 --> 00:14:19,300
...كويتشي

212
00:14:24,250 --> 00:14:25,640
...إنّهما ذلكما الاثنان

213
00:14:27,430 --> 00:14:30,190
إن كان مكاناً قريباً من البحر فيه
كثير من البيوت غير المسكونة

214
00:14:30,190 --> 00:14:31,920
.فلا بدّ أن يكون هذه المنطِقة المليئة بالقصور

215
00:14:31,920 --> 00:14:36,150
لكن يوجدُ الكثيرُ من القصور هنا

216
00:14:36,150 --> 00:14:37,860
لن نستطيع التّحديد

217
00:14:37,860 --> 00:14:41,780
يجبُ علينا إيجاد الهاتف العمومي الذي استعملَه
كويتشي للاتّصال بنا

218
00:14:42,580 --> 00:14:47,270
لنبحث عن الهاتفِ العموميّ أولاً ومن ثمّ
ننظر إلى البيوت القريبة منه

219
00:14:47,270 --> 00:14:48,260
نعم

220
00:14:50,230 --> 00:14:54,380
كويتشي الظريف الصّغير هو مِلكي أنا

221
00:14:55,280 --> 00:14:57,940
لن أدع أحداً آخر يحصلُ عليه

222
00:15:05,790 --> 00:15:08,980
لا أنصحكِ بالاقتراب أكثر يا يوكاكو

223
00:15:11,120 --> 00:15:13,300
من الواضح تماماً

224
00:15:13,300 --> 00:15:17,110
بأنّكِ عاجزة عن التصدّي لقدرات إيكوز آكت 2

225
00:15:17,880 --> 00:15:20,310
لن تتمكّني من احتجازي هنا

226
00:15:24,090 --> 00:15:26,560
بدأ جفني الأيسر يرتعش

227
00:15:26,560 --> 00:15:28,850
مُذ كنتُ صغيرة وعضلتي الدُّويريّة العينيّة

228
00:15:28,850 --> 00:15:30,710
،ترتعش كلّما انفعلت

229
00:15:31,320 --> 00:15:34,090
.وأصبح عنيفة بعض الشيء

230
00:15:34,520 --> 00:15:36,890
إيّاك أن تغترّ فقط لأنّك

231
00:15:36,890 --> 00:15:39,170
.قد حصلتَ على قدرةٍ مختلفة قليلاً

232
00:15:39,170 --> 00:15:41,510
!سوف أصبح عنيفة الآن

233
00:15:42,300 --> 00:15:45,170
!ساخن

234
00:15:45,170 --> 00:15:46,850
!كيف تجرؤ؟

235
00:15:46,850 --> 00:15:50,230
!احترقَتْ يدي! أيُّها الحثالة

236
00:15:50,230 --> 00:15:52,650
،عندما قلتِ أنّكِ ستُصبحين عنيفة

237
00:15:52,650 --> 00:15:55,110
هل قصدتِ طريقةَ كلامكِ الآن؟

238
00:15:56,600 --> 00:15:59,170
!كيف تجرؤ على فعلِ هذا بي؟

239
00:15:59,170 --> 00:16:00,740
!أنتَ مجرّد فتى جذّاب صغير

240
00:16:01,000 --> 00:16:03,220
!أنتَ مِلكٌ لي

241
00:16:03,220 --> 00:16:05,240
!أنتَ مِلكٌ لي وتجرؤ على عصياني؟

242
00:16:05,880 --> 00:16:08,000
!رُغمَ أنّك مِلك لي؟

243
00:16:08,000 --> 00:16:10,000
!إيكوز آكت 2

244
00:16:11,190 --> 00:16:12,370
أخفقت؟

245
00:16:16,840 --> 00:16:17,760
جوسكي

246
00:16:17,760 --> 00:16:19,050
سمعتُه

247
00:16:19,050 --> 00:16:21,260
كان صوت انكسار شيء

248
00:16:21,620 --> 00:16:23,940
أظنُّه ذاك المنزل

249
00:16:24,950 --> 00:16:28,180
...لـ-لا أصدّق أن ينمو شعرها إلى هذا الحدّ

250
00:16:28,180 --> 00:16:30,270
قدرتها الذهنيّة قويّة جدّاً

251
00:16:30,520 --> 00:16:33,270
...قدرة ذهنيّة سوداء وانتقاميّة بحتة

252
00:16:34,660 --> 00:16:36,640
هل كان يُدعى إيكوز؟

253
00:16:36,640 --> 00:16:39,900
الآن بعدما عرفتُ ما يقومُ به، لم يعُد مدهشاً إطلاقاً

254
00:16:40,480 --> 00:16:43,180
كلّ ما عليّ فعله هو عدم لمس تِلك الأحرف، صحيح؟

255
00:16:43,180 --> 00:16:45,120
...بالمناسبة، سأسألك مرّة أخرى

256
00:16:45,540 --> 00:16:48,370
أنت تحبُّني، صحيح؟

257
00:16:50,890 --> 00:16:54,850
إيّاك أن تقول أنّك لا تحبّني

258
00:16:55,320 --> 00:16:59,130
سأمزّقك وأمزِّق هذا المنزل هُنا والآن

259
00:16:59,600 --> 00:17:03,250
،وإن متَّ فستُصبحُ لي للأبد

260
00:17:03,690 --> 00:17:07,550
لأنّك ستعيشُ في قلبي كذكرى للأبد

261
00:17:09,330 --> 00:17:11,060
!أجبني بسُرعة

262
00:17:11,060 --> 00:17:13,380
أعيشُ هذه الفوضى الآن

263
00:17:13,380 --> 00:17:15,690
.لأنّكِ لا تفهمينني كلّما قلتُ لكِ

264
00:17:16,360 --> 00:17:19,390
لقد كنتُ أقولُ لكِ أنّني لا أحبّكِ

265
00:17:19,390 --> 00:17:21,170
.طوالَ هذا الوقت

266
00:17:22,870 --> 00:17:25,030
!سأقتلُك يا كويتشي

267
00:17:30,850 --> 00:17:32,970
لقد سبقَ وأخبرتُكِ

268
00:17:32,970 --> 00:17:36,310
أنّكِ لن تكوني قادرة على الإمساكِ بي

269
00:17:36,960 --> 00:17:39,590
لقد لمستِ الأحرف التي ستقذفكِ

270
00:17:40,000 --> 00:17:43,380
تِلك الأحرف مكتوبةٌ في جسدي أنا، من دعيتِه بالحُثالة

271
00:17:56,330 --> 00:17:58,560
!ابيضَّ شعرُها

272
00:18:00,890 --> 00:18:03,620
لم تمُت، أليس كذلك؟

273
00:18:06,440 --> 00:18:07,820
!إنّها حيّة

274
00:18:09,170 --> 00:18:11,940
،رُغمَ أنّها مجنونة وشرّيرة للغاية

275
00:18:11,940 --> 00:18:14,520
أظنُّني ينبغي أن أكون سعيداً بهذا

276
00:18:19,900 --> 00:18:22,640
...لم أستطع الإمساك بك

277
00:18:22,640 --> 00:18:26,140
لكن اكتشفتُ أنّ كلّ ما عليّ فعله
هو تدمير الستاند الخاصّ بك

278
00:18:27,470 --> 00:18:29,000
!أيّها الطّفل الصّفيق

279
00:18:29,000 --> 00:18:30,470
!أحمق

280
00:18:33,860 --> 00:18:36,820
...لـ-لا أصدّق أنّكِ ما زلتِ قادرة على الهجوم

281
00:18:36,820 --> 00:18:38,600
!قدرتكِ الذهنيّة جنونيّة

282
00:18:38,600 --> 00:18:40,980
!اصمت

283
00:18:40,980 --> 00:18:45,110
!كيف تجرؤ يا مُبلِّل الملابس الصّغير؟

284
00:18:45,110 --> 00:18:48,810
!كيف تجرؤ على فعلِ ما فعلتَه بي؟

285
00:18:49,550 --> 00:18:53,700
،ابيضَّ شعري الثّمين

286
00:18:53,700 --> 00:18:56,120
!أيُّها الحقير العاجز جنسيّاً

287
00:18:56,990 --> 00:18:59,960
!أحببتُك

288
00:18:59,960 --> 00:19:03,460
!لكن لن أسامحك على ما فعلتَه بشعري الجميل

289
00:19:03,710 --> 00:19:07,620
!لا يهمّني من تكون! لن أسامحك إن ألحقتَ الضررَ بجمالي

290
00:19:09,630 --> 00:19:15,320
سأمزِّق هذا القذر الصّغير المُبلِّل للملابس وأقتلع
منه أعضائه الحيويّة

291
00:19:15,320 --> 00:19:16,720
...تـ-توقّفي

292
00:19:16,720 --> 00:19:17,930
!اصمت

293
00:19:19,700 --> 00:19:22,100
!ستلقى نفس المصير أيضاً، أليس كذلك؟

294
00:19:24,410 --> 00:19:27,070
ماذا؟ ماذا كان ذلك الصّوت للتو؟

295
00:19:27,580 --> 00:19:31,600
أفلِتي إيكوز وتمسّكي بشيء

296
00:19:31,600 --> 00:19:33,080
سينهارُ المُنحدر

297
00:19:33,790 --> 00:19:36,300
،عندما سمعَ إيكوز صوت قلبكِ

298
00:19:36,300 --> 00:19:39,380
سمعَ أيضاً صوت قرقرة الأرض

299
00:19:39,380 --> 00:19:43,540
!لا تختلِق هُراء فقط لاعتقادِك بأنّه سيُنقذك

300
00:19:52,520 --> 00:19:55,890
!عليّ أن أترك هذا الشيء وأتمسّك بشيء ما

301
00:19:55,890 --> 00:19:56,810
!اللّعنة

302
00:19:56,810 --> 00:19:59,810
لـ-لا أملُك... الوقت الكافي

303
00:20:13,890 --> 00:20:16,240
انهارَ كما قلتُ تماماً، صحيح؟

304
00:20:16,240 --> 00:20:20,980
لكنّكِ لا تفهمين أي كلمة أقولها، أليس كذلك؟

305
00:20:24,600 --> 00:20:27,390
هل تعني أنّك دوّنته هُناك مُسبَقاً؟

306
00:20:29,110 --> 00:20:32,230
...عندما كنتُ أحاولُ تمزيق إيكوز

307
00:20:32,690 --> 00:20:36,530
كتبتَ تِلك الأحرف على تِلك الصّخرة تحت المنحدر؟

308
00:20:37,430 --> 00:20:40,510
،هل تعني وبينما كنتُ أحاولُ قتل كويتشي

309
00:20:41,090 --> 00:20:45,270
كان هو يُحاولُ أن يفكّر بطريقةٍ لإنقاذي؟

310
00:20:45,780 --> 00:20:49,370
لـ-لقد خسرتُ خسارة نكراء

311
00:20:51,200 --> 00:20:56,540
لا، خسرتُ في لحظة رُؤيتي لكويتشي

312
00:20:59,990 --> 00:21:02,650
كويتشي، هل أنتَ حيّ؟

313
00:21:02,650 --> 00:21:04,250
!هل أنتَ بخير يا كويتشي؟

314
00:21:04,900 --> 00:21:07,000
!جوسكي، أوكوياسو

315
00:21:07,000 --> 00:21:11,010
!تأخّرتُما كثيراً في الوصول إلى هنا، تبّاً

316
00:21:11,300 --> 00:21:15,270
لـ-لكن ازدادَ حبّي له أكثر فأكثر

317
00:21:17,280 --> 00:21:20,230
لا يهمّني حتّى لو تجاهلَني تماماً

318
00:21:21,020 --> 00:21:23,440
أنا سعيدة بمجرّد التّفكير

319
00:21:24,020 --> 00:21:25,280
!بك يا كويتشي

320
00:21:25,280 --> 00:21:28,580
انظر هناك، أليست هي يوكاكو؟

321
00:21:28,580 --> 00:21:30,530
!ابيضَّ شعرُها تماماً

322
00:21:30,530 --> 00:21:32,030
معك حقّ

323
00:21:32,340 --> 00:21:37,030
لكن ألا تبتسم تِلك الحسناء معبِّرة عن سعادتها؟

324
00:21:37,030 --> 00:21:38,730
وهي تنظرُ إلينا

325
00:21:39,450 --> 00:21:42,040
معك حقّ، هذا مُريب للغاية

326
00:21:42,770 --> 00:21:43,960
!لنخرج من هنا

327
00:21:43,960 --> 00:21:45,770
!أنقذني يا جوسكي

328
00:21:45,770 --> 00:21:47,540
!لا تعتمد عليّ

329
00:21:49,010 --> 00:21:52,680
أنا مصدوم! هل شاهدتَ ذلك يا ماساجي؟

330
00:21:52,680 --> 00:21:55,830
أنا لستُ ثملاً يا عجوز

331
00:21:58,510 --> 00:22:00,070
الرأس النابضيّ

332
00:22:00,070 --> 00:22:02,200
يبدو أنّه اشتهرَ بعد إشاعة تُفيد

333
00:22:02,200 --> 00:22:05,980
،بأنّ بعض صيّادي السّمك رأوا شابّةً ما لبِثَتْ أن تنتحر

334
00:22:05,980 --> 00:22:10,240
حتّى قذفَتْها صخرةٌ في الرأسِ لتُعيدها إلى مكانها

335
00:22:13,320 --> 00:22:14,320
!هيروسي

336
00:22:14,630 --> 00:22:17,030
لقد حضّرتَ جيّداً لهذا الامتحان

337
00:22:17,030 --> 00:22:19,250
يمكنُك أن تنجح بالمُثابرة

338
00:22:20,190 --> 00:22:21,450
...لا أدري

339
00:22:22,070 --> 00:22:24,650
كيف ينبغي أن يكون شعوري حيال الأمر