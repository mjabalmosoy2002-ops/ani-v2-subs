00:18:57,700 --> 00:19:00,660
!إنّه يتقن استعمال تلك السّكين إتقانًا كاملاً

365
00:19:00,680 --> 00:19:03,280
!تتحوّل المكوّنات إلى عجينة بسرعة

366
00:19:03,580 --> 00:19:05,370
.تكاد البطّة أن تجهز

367
00:19:05,370 --> 00:19:07,000
!سنُنهي الصلصة في نفس الوقت

368
00:19:07,220 --> 00:19:08,040
!مفهوم

369
00:19:08,040 --> 00:19:09,370
!أنا جاهز

370
00:19:09,640 --> 00:19:10,620
!حسنًا

371
00:19:25,070 --> 00:19:26,140
..."تري"

372
00:19:27,570 --> 00:19:28,600
..."دوي"

373
00:19:30,130 --> 00:19:31,060
..."أونو"

374
00:19:32,730 --> 00:19:33,820
!"فيني"

375
00:19:36,980 --> 00:19:38,320
.أنتما أوّل من انتهى من الطّبخ

376
00:19:38,690 --> 00:19:42,240
!الرّشاقة هي إحدى محاسن المطبخ الإيطاليّ

377
00:19:42,620 --> 00:19:43,870
!إنّهما سريعان للغاية

378
00:19:43,870 --> 00:19:45,950
!كان عليهما تتبيل تلك البطّة أيضًا

379
00:19:45,950 --> 00:19:47,700
!لا أصدّق أنّ الأمر أخذ منهما أقلّ من ساعة

380
00:19:48,160 --> 00:19:50,040
البطّ المشوي بالأعشاب

381
00:19:50,330 --> 00:19:52,420
.والصّلصة الخضراء

382
00:19:52,880 --> 00:19:54,290
!"بوين أبوتيتو"

383
00:19:55,630 --> 00:19:56,500
،حسنًا

384
00:19:57,130 --> 00:19:58,510
.(إتاداكيماس)

385
00:20:02,470 --> 00:20:05,100
نكهة البطّ البرّيّة والعطِرة

386
00:20:05,560 --> 00:20:10,310
!قد تصاعدت إلى أنفي مانحة النّكهة إحساسًا جليلاً

387
00:20:13,900 --> 00:20:16,730
رجولة وأناقة هذا الطّبق أشبه بصوت جهوريّ

388
00:20:16,730 --> 00:20:18,650
.يتردّد صداه عميقًا في داخل معدتي

389
00:20:19,030 --> 00:20:20,190
...إنّه أشبهُ

390
00:20:25,870 --> 00:20:28,290
.بنغمة آريا تُغنّيها بطّة

391
00:20:32,290 --> 00:20:34,170
ما كنتُ لأمانع أن تحتضنني

392
00:20:34,170 --> 00:20:35,420
!بطّة هكذا

393
00:20:39,300 --> 00:20:40,130
!انظروا

394
00:20:40,130 --> 00:20:41,550
!تلك الصلصة الخضراء

395
00:20:41,550 --> 00:20:43,130
!أهي "سالسا فيردي"؟

396
00:20:43,510 --> 00:20:45,890
،أليست تلك صلصة أساسيّة في المطبخ الإيطاليّ

397
00:20:45,890 --> 00:20:49,020
مُعدّة بسمك الأنشوفة المقطّع
والبقدونس ذو الأوراق المسطّحة؟

398
00:20:49,350 --> 00:20:50,680
فيما كانا يفكّران؟

399
00:20:50,680 --> 00:20:52,310
!الموضوع هو المطبخ اليابانيّ

400
00:20:52,310 --> 00:20:54,480
!سوف يفشلان بكلّ تأكيد

401
00:20:54,480 --> 00:20:58,820
،كلاّ، لم يستعملا الأنشوفة في هذه الصلصة

402
00:20:58,820 --> 00:21:01,150
.بل "الأوروكا" وهي أحشاء سمك (الآيو) المملّحة

403
00:21:02,280 --> 00:21:06,410
،يتمّ إعداد "الأوروكا" على مدى أسبوع أو أكثر في العادة

404
00:21:06,410 --> 00:21:07,910
لكن هذه قد جهزت في الحال، صحيح؟

405
00:21:08,280 --> 00:21:08,910
.أجل

406
00:21:09,240 --> 00:21:12,120
،غلينا أحشاء سمك (الآيو) المغسولة في الساكي

407
00:21:12,120 --> 00:21:14,710
.وبعدها تبّلناها بالميرين وصلصة الصّويا والملح

408
00:21:14,710 --> 00:21:16,580
،يسمح لنا هذا بالحصول على "أوروكا" فوريّة وغنيّة

409
00:21:16,580 --> 00:21:18,880
.بنفحة مناسبة من المرورة

410
00:21:19,210 --> 00:21:20,510
كيف يمكن ذلك؟

411
00:21:20,510 --> 00:21:22,340
.لم يكن ذلك ارتجالهما الوحيد

412
00:21:23,300 --> 00:21:26,220
فبدل البقدونس، فقد قطّعوا نبات البيريلا والثّوم المعمِّر

413
00:21:26,220 --> 00:21:30,890
.للحصول على لون أخضر حيويّ ونكهة آسرة

414
00:21:30,890 --> 00:21:35,190
،كما أنّهما أضافا فلفل اليوزو في العجينة بدل الثّوم

415
00:21:35,190 --> 00:21:36,980
،والّذي لا يُستعمل إلاّ نادرًا في المطبخ اليابانيّ

416
00:21:36,980 --> 00:21:39,320
.وذلك بهدف جعل الطّبق أقرب للمطبخ اليابانيّ

417
00:21:39,650 --> 00:21:40,650
!هذا صحيح

418
00:21:40,650 --> 00:21:42,940
،هذه "سالسا فيردي" بأسلوب يابانيّ

419
00:21:42,940 --> 00:21:44,570
!باستعمال "الأوروكا" الفوريّة كأساس

420
00:21:44,990 --> 00:21:47,660
لقد ابتكرا مُقابلاً يابانيًّا لصلصة إيطاليّة؟

421
00:21:47,660 --> 00:21:48,410
!سُحقًا

422
00:21:48,410 --> 00:21:50,120
.أشعر بالجوع بمجرّد الاستماع لهما

423
00:21:50,450 --> 00:21:55,250
كيف استطاعا الجمع بين عدّة مكوّنات
كهذه هنا في الجبال؟

424
00:21:55,830 --> 00:21:57,960
،على عكس اليابان

425
00:21:57,960 --> 00:22:01,050
.فإنّ إيطاليا لديها تاريخ عريق بالطّبخ المبنيّ على اللّحم

426
00:22:01,500 --> 00:22:03,970
،ففي منطقة توسكاني في بلادهما

427
00:22:03,970 --> 00:22:08,300
يتمّ  إعداد لحم البطّ أو الأرانب
.أو الخنازير البرّيّة في مواسمها

428
00:22:08,640 --> 00:22:13,560
لا بدّ أنّهما تعلّما كيف يتبّلان البطّة
.خلال فترة عيشهما هناك

429
00:22:14,060 --> 00:22:16,390
لقد تمّ تغطية الصّدر بصلصةٍ مُعدّةٍ

430
00:22:16,390 --> 00:22:18,860
،من صلصة الصويا والخردل والفلفل الأسود والعسل

431
00:22:18,860 --> 00:22:20,480
.وبعدها تمّ شيّه إلى أن أصدر رائحة مثاليّة

432
00:22:20,480 --> 00:22:22,570
.إنّه يتناسب تمامًا مع الصّلصة

433
00:22:23,280 --> 00:22:25,280
"لقد أظهرتُما في البطّة و"السالسا فيردي

434
00:22:25,280 --> 00:22:28,070
،عناصر أساسيّة من المطبخ اليابانيّ

435
00:22:28,070 --> 00:22:30,950
.وجمعتما بينهما لتحضّرا طبقًا يابانيًّا بديعًا

436
00:22:31,370 --> 00:22:33,870
...(تاكومي ألديني) و(إسامي ألديني)

437
00:22:34,500 --> 00:22:35,870
.لقد تجاوزتما الاختبار

438
00:22:35,870 --> 00:22:37,120
!"شكرًا"

439
00:22:37,540 --> 00:22:41,250
.لقد استعمل ذكاءه لابتكار طبقٍ غير عاديّ

440
00:22:41,250 --> 00:22:43,710
.رغم كلّ العقبات الّتي وضعت أمامنا

441
00:22:44,050 --> 00:22:45,380
...إنّه يُذكّرني

442
00:22:46,260 --> 00:22:47,800
.بـ(سوما)-كُن

443
00:24:28,530 --> 00:24:30,900
!ميرفيوز

444
00:24:31,320 --> 00:24:33,870
!ناكيري إرينا)، لقد نجحتِ في امتحاني)

445
00:24:35,240 --> 00:24:36,580
.يومًا سعيدًا

446
00:24:40,200 --> 00:24:42,170
،"في الحلقة القادمة من "سوما والشوكوغيكي

447
00:24:42,620 --> 00:24:43,790
:الطّبق التاسع

448
00:24:45,920 --> 00:24:47,750
“.الخليط الّذي سيُزيّن الجبال”

449
00:24:49,300 --> 00:24:50,130
!"شكرًا"

450
00:24:50,130 --> 00:24:51,090
."شكرًا"

451
00:24:51,840 --> 00:24:53,630
!سوف أدوس عليك

452
00:24:53,630 --> 00:24:55,720
.ني-تشان، كان ذلك مُحرجًا