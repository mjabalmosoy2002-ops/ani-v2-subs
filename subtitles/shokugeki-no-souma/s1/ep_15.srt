1
00:00:26,580 --> 00:00:27,590
،أمّا الآن

2
00:00:27,590 --> 00:00:30,840
.دعونا نبدأ بآخر برنامج لنا في هذا المخيّم

3
00:00:31,420 --> 00:00:33,340
ستتسنّى لكم جميعًا

4
00:00:33,340 --> 00:00:35,050
.الاستمتاع بوجبات كاملة من إعداد الخرّيجين

5
00:00:35,050 --> 00:00:37,550
!أجل

6
00:02:31,380 --> 00:02:33,500
على التّلاميذ جمع أغراضهم

7
00:02:33,500 --> 00:02:36,510
.وركوب الحافلات المخصّصة لهم

8
00:02:36,510 --> 00:02:39,130
.أعيدوا مفاتيح غرفكم إلى مكتب الاستقبال

9
00:02:39,130 --> 00:02:42,890
.تفقّدوا محيطكم للتّحقق أنّكم لم تنسوا شيئًا

10
00:02:45,850 --> 00:02:48,350
!انتهينا، انتهينا

11
00:02:48,890 --> 00:02:51,020
.نجحنها جميعًا

12
00:02:51,020 --> 00:02:51,770
.أجل

13
00:02:51,770 --> 00:02:52,230
.صحيح

14
00:02:52,230 --> 00:02:55,230
.حدث كلّ شيء بسرعة فائقة

15
00:02:55,230 --> 00:02:58,070
!لكنّ المخيّم كان صعبًا

16
00:02:58,070 --> 00:02:59,820
!بالفعل

17
00:02:59,820 --> 00:03:04,200
!لم يكن عليكم المجيء إلى غرفتي اللّيلة الماضية أيضًا

18
00:03:04,200 --> 00:03:06,740
.لم تمانع انضمامنا لك في السّابق

19
00:03:07,830 --> 00:03:10,330
.صحيح، واللّيلة الماضية أيضًا

20
00:03:10,330 --> 00:03:12,830
!هيّا اسحبها، اسحب بطاقة الخادمة العجوز

21
00:03:12,830 --> 00:03:14,420
!لننهِ اللّعبة في المسكن عند عودتنا

22
00:03:14,420 --> 00:03:14,960
!ما...؟

23
00:03:14,960 --> 00:03:16,500
.لنقم بدعوة (إشّيكي)-سينباي أيضًا

24
00:03:16,500 --> 00:03:18,630
.يمكننا أن نلعب لعبة "اللّحوح" أيضًا

25
00:03:20,130 --> 00:03:21,470
!شينوميا)-سينباي)

26
00:03:24,390 --> 00:03:26,100
.أرى أنّ كلاكما قد نجى

27
00:03:26,560 --> 00:03:29,060
.صحيح، تمكّنا من النّجاة بطريقة ما

28
00:03:29,930 --> 00:03:31,520
...حقيبة سفر

29
00:03:31,520 --> 00:03:33,310
هل أنت عائد إلى فرنسا بهذه السّرعة؟

30
00:03:33,310 --> 00:03:34,440
.نعم

31
00:03:34,440 --> 00:03:36,690
.لا أستطيع إغلاق مطعمي لوقت طويل

32
00:03:37,230 --> 00:03:39,940
.كما أنّي قرّرتُ ما سيكون هدفي

33
00:03:40,400 --> 00:03:44,160
،سأعمل على جعل مطعم "عند شينو" الأوّل في باريس

34
00:03:44,160 --> 00:03:45,450
.وسأصبو لحمل نجمة "ميشلين" الثّالثة

35
00:03:46,330 --> 00:03:48,830
.لديّ الكثير ممّا أرغب بالقيام به

36
00:03:49,620 --> 00:03:53,500
.ما عادت جائزة "بلوسبول" تكفيني بعد الآن

37
00:03:53,880 --> 00:03:55,000
...النّجمة الثّالثة

38
00:03:55,000 --> 00:03:56,340
!هذا مذهل

39
00:03:56,340 --> 00:04:01,220
!لم يحظى أيّ طاهٍ يابانيّ في فرنسا بذلك أبدًا

40
00:04:02,720 --> 00:04:03,430
...أنتما

41
00:04:03,430 --> 00:04:05,180
!توقّف

42
00:04:05,930 --> 00:04:08,890
!لا يمكنك أن تسبقنا في ذلك يا (شينوميا)-سينباي

43
00:04:08,890 --> 00:04:10,680
.لا فكرة لي عمّاذا تتحدّثين

44
00:04:11,020 --> 00:04:12,640
...(يوكيهيرا سوما)

45
00:04:12,640 --> 00:04:14,520
أهنالك احتمال أنّك مهتم بالطّبخ الإيطالي؟

46
00:04:15,650 --> 00:04:18,650
—تادوكورو)-كُن، سوف تزدهر موهبتك في مطعم سوشي)

47
00:04:18,650 --> 00:04:19,610
!كلاّ

48
00:04:19,940 --> 00:04:22,780
!سوف آخذ (ميغومي)-تشان معي بكلّ حذر

49
00:04:22,780 --> 00:04:24,110
ما-ماذا؟

50
00:04:28,240 --> 00:04:29,490
.أرى أنّهم يتحدّثون إليكما سلفًا

51
00:04:30,120 --> 00:04:32,250
أ-أيّها الطّاهي (دوجيما)، ما-ما الّذي يحدث؟

52
00:04:32,250 --> 00:04:34,040
.إنّهم يقومون بتقديركما

53
00:04:34,330 --> 00:04:36,000
تقديرنا؟

54
00:04:36,000 --> 00:04:38,630
يعتبر هذا المخيّم كأرضِ توظيفٍ محتملة لعرض مناصب

55
00:04:38,630 --> 00:04:40,960
.عمل يمكن للتّلاميذ أخذها في عين الاعتبار بعد التّخرّج

56
00:04:40,960 --> 00:04:44,510
،لقد أغلق الخرّيجون مطاعمهم

57
00:04:44,510 --> 00:04:47,760
،أو تركوا مسؤوليتها لطهاتهم المساعدين
.ليتمكّنوا من المجيء إلى هنا

58
00:04:47,760 --> 00:04:50,430
.وأحد أسباب ذلك هو توظيف طهاة للمستقبل

59
00:04:51,220 --> 00:04:55,440
.فالعثور على الطّهاة الواعدين ليس أمرًا سهلاً

60
00:04:55,440 --> 00:04:57,400
.هكذا إذًا، فهمت

61
00:04:57,690 --> 00:05:00,730
.لم أكن أعرف أنّ للمخيّم سببًا آخر كهذا

62
00:05:00,730 --> 00:05:04,740
أشكّ أنّ (ميغومي) مدركة لمعنى
.أن يُوظّفها أحد من هذه المجموعة

63
00:05:04,740 --> 00:05:06,110
.صحيح

64
00:05:06,360 --> 00:05:09,830
.(يوكيهيرا)-كُن، أنا واثق أنّك ستتألّق هنا في منتجع (توتسوكي)

65
00:05:10,330 --> 00:05:11,580
.أنت مرّحب بك للانضمام إلينا في أيّ وقت

66
00:05:12,160 --> 00:05:14,370
،أقدّر لك عرضك هذا

67
00:05:14,370 --> 00:05:15,920
.(لكنّي أملك مطعم (يوكيهيرا

68
00:05:16,830 --> 00:05:18,130
،صحيح

69
00:05:18,130 --> 00:05:19,960
.فعائلتك تدير مطعمًا

70
00:05:20,290 --> 00:05:23,460
.أجل، نعمل أنا وأبي في المطعم

71
00:05:24,130 --> 00:05:26,340
،لا أدري أين هو الآن أو ماذا يفعل

72
00:05:27,260 --> 00:05:30,470
،لكنّي أريده أن يعترف بمواهبي يومًا ما

73
00:05:30,930 --> 00:05:33,310
.(ويعتبرني جديرًا بتولّي مسؤولية مطعم (يوكيهيرا

74
00:05:51,530 --> 00:05:54,410
سينباي، هدفك هو الحصول على النّجمة الثّالثة؟

75
00:05:54,410 --> 00:05:55,580
سمعتِ ذلك؟

76
00:05:56,120 --> 00:05:58,670
ما رأيك أن آتي وأساعدك؟

77
00:05:58,960 --> 00:06:02,300
.أكيد، يمكنني أن أعيّن خادمة

78
00:06:02,300 --> 00:06:04,130
!ماذا؟

79
00:06:16,430 --> 00:06:17,060
دوجيما)-سان؟)

80
00:06:18,100 --> 00:06:19,650
هل من خطب ما؟

81
00:06:19,650 --> 00:06:20,940
.لا، لا شيء

82
00:06:35,700 --> 00:06:38,460
.حسنًا يا (سوما)-كُن، هذه هي حافلتنا

83
00:06:38,460 --> 00:06:40,370
.حسنًا، أراكِ لاحقًا

84
00:06:42,670 --> 00:06:45,130
!كلاّ... عصابة رأسي

85
00:06:45,920 --> 00:06:48,090
ماذا؟ نسيتِ شيئًا ما؟

86
00:06:48,090 --> 00:06:50,090
.يكاد يحين موعد انطلاق الحافلة

87
00:06:50,090 --> 00:06:50,890
—سأذهب

88
00:06:50,890 --> 00:06:51,840
!لا بأس

89
00:06:51,840 --> 00:06:53,220
!سأذهب أنا

90
00:06:53,220 --> 00:06:55,720
،سأعود في سيّارة أخرى

91
00:06:55,720 --> 00:06:58,730
.لذلك اذهبي أنتِ وخذي أمتعتي معكِ

92
00:06:58,730 --> 00:06:59,940
!حا-حاضرة

93
00:07:02,730 --> 00:07:04,360
!سعيد لأنّي وجدتُها

94
00:07:07,530 --> 00:07:11,780
لقد استمتعنا بالمنتجع بالفعل، صحيح؟

95
00:07:10,530 --> 00:07:12,410
.إ... إنّها الحافة الخطأ

96
00:07:11,780 --> 00:07:14,410
!أتطلّع قُدمًا للسّنة القادمة منذ الآن

97
00:07:15,030 --> 00:07:17,200
،عندما تكون هنالك مجموعة من الحافلات السّريعة

98
00:07:17,200 --> 00:07:19,500
.يصعب تمييز أيّها هي حافلتك

99
00:07:19,500 --> 00:07:22,750
نقترح عليكم بشدّة أن تتأكّدوا من مكان وقوفها

100
00:07:22,750 --> 00:07:25,000
.ورقمها إذا ما اضطررتم إلى الخروج منها

101
00:07:26,000 --> 00:07:28,550
.أنت هو الفتى الّذي أعدّ "سوفليه" عجّة البيض

102
00:07:28,550 --> 00:07:30,300
...أنت موفّر البيض

103
00:07:30,510 --> 00:07:33,300
.لم يكن طبقك سيّئًا أبدًا

104
00:07:34,890 --> 00:07:35,720
...لكن

105
00:07:36,720 --> 00:07:39,270
!أنا آسف لأنّي أفسدتُ الكثير من بيضك

106
00:07:41,190 --> 00:07:43,350
.هذا صحيح

107
00:07:43,770 --> 00:07:49,110
...لكنّي سأسامحك إذا ما اخترتَني

108
00:07:49,610 --> 00:07:53,610
.كموفّر بيض لمطعمك يومًا ما

109
00:07:55,780 --> 00:07:56,830
!أكيد

110
00:07:57,030 --> 00:07:59,160
!آمُل أن تستعمل البازلاّء خاصّتي أيضًا يا فتى

111
00:07:59,160 --> 00:08:01,040
.وجُبني أيضًا

112
00:08:01,040 --> 00:08:02,870
هل ترغب ببعض مقرمشات الأرزّ؟

113
00:08:02,870 --> 00:08:04,290
.خذ دواء السّعال هذا

114
00:08:04,290 --> 00:08:05,420
.شكرًا لكم

115
00:08:05,420 --> 00:08:07,340
!شكرًا! شكرًا لكم

116
00:08:07,340 --> 00:08:09,800
!مهلاً، يجب عليّ أن أذهب

117
00:08:10,130 --> 00:08:11,130
أين حافلتي؟

118
00:08:11,470 --> 00:08:12,260
...أين

119
00:08:13,050 --> 00:08:13,720
...هل

120
00:08:26,230 --> 00:08:26,730
...لما

121
00:08:27,110 --> 00:08:28,650
لماذا أنت هنا؟

122
00:08:28,650 --> 00:08:30,230
قلتِ لماذا؟

123
00:08:30,230 --> 00:08:32,030
.حسنًا، حدثت الكثير من الأشياء

124
00:08:56,640 --> 00:08:57,680
تريدين بعض مقرمشات الأرزّ؟

125
00:08:57,680 --> 00:08:58,970
.كلاّ

126
00:09:02,730 --> 00:09:03,310
دواء سعال؟

127
00:09:03,310 --> 00:09:03,850
.كلاّ

128
00:09:05,480 --> 00:09:06,810
،على فكرة

129
00:09:06,810 --> 00:09:10,230
قلتِ أنّك ستستمتعين برؤية كم سيتطلّب
الأمر منّي حتّى أفشل، صحيح؟

130
00:09:10,230 --> 00:09:11,360
.لكنّي استطعتُ النّجاة

131
00:09:11,360 --> 00:09:12,570
فهل من أفكار؟

132
00:09:13,190 --> 00:09:15,660
.أستطيع تخيّل وجهه الغبيّ والخبيث

133
00:09:18,910 --> 00:09:22,700
.ستُبلي حسنًا بالتّخبّط في قاع البرميل

134
00:09:22,700 --> 00:09:25,500
.أشكّ في أنّه سيتمّ اختيارك في الانتخابات

135
00:09:25,500 --> 00:09:26,500
انتخابات؟

136
00:09:26,500 --> 00:09:28,460
لا تعرف بشأن هذا أيضًا؟

137
00:09:28,460 --> 00:09:31,670
.إنّه تقليد قديم في (توتسوكي) يسمّى انتخابات الخريف

138
00:09:31,670 --> 00:09:34,050
إنّه مهرجان ذوّاقة حيث يُسمح فيه لتلاميذ السّنة الأولى

139
00:09:34,050 --> 00:09:36,340
!بإظهار مهاراتهم والتّنافس مع بعضهم

140
00:09:36,340 --> 00:09:38,090
،مدير الأكاديميّة والمستثمرون

141
00:09:38,090 --> 00:09:40,760
،وكبار الأسماء في مجال الأكل سيحضرونه

142
00:09:40,760 --> 00:09:43,470
وهذا سيجعل الحدث الفرصة الأولى
للتّلاميذ لإظهار مهاراتهم

143
00:09:43,470 --> 00:09:45,180
.لمن هم خارج الأكاديميّة

144
00:09:45,770 --> 00:09:49,400
.عملية الاختيار قد بدأت سلفًا

145
00:09:49,980 --> 00:09:52,570
ألم تلاحظ أعضاء لجنة الاختيار الّذين كانوا في المخيّم؟

146
00:09:52,940 --> 00:09:54,570
.صحيح، أظنّ ذلك

147
00:09:54,780 --> 00:09:56,860
!كانوا أصحاب البدلات، صحيح؟

148
00:09:56,860 --> 00:10:01,280
بعبارات أخرى، لم يكن الغرض من المخيّم
.استبعاد الضّعفاء فحسب

149
00:10:01,280 --> 00:10:04,580
كان له هدف خفيّ وهو التّعرّف على
.من سيرتقي عن البقيّة

150
00:10:04,870 --> 00:10:06,790
.قلتِ مهرجانًا للذّواقّة

151
00:10:06,790 --> 00:10:08,210
!يبدو ممتعًا

152
00:10:08,210 --> 00:10:10,460
!أشعر بالحماس بمجرّد التّفكير به

153
00:10:10,670 --> 00:10:14,260
!سبق وأخبرتُك، من المستحيل اختيار شخص مثلك

154
00:10:14,510 --> 00:10:17,220
ما الّذي كنتَ تقصده بكلامك حينها؟

155
00:10:17,720 --> 00:10:20,300
.تعلّمتُ بالفعل من تجربة الفشل

156
00:10:20,300 --> 00:10:23,060
تعلّمتَ من تجربة الفشل؟

157
00:10:23,060 --> 00:10:25,060
.هذا مجرّد شيء يقوله الخاسر كمحاولة لإخفاء فشله

158
00:10:25,730 --> 00:10:28,350
!الفشل ليس خيارًا عند الطّهاة

159
00:10:29,730 --> 00:10:31,150
فعلاً؟

160
00:10:31,150 --> 00:10:31,520
!فعلاً

161
00:10:32,230 --> 00:10:36,030
!الكمال وحده ما يجب أن يُقدّم على الطّاولة

162
00:10:36,650 --> 00:10:39,700
هذه هي الطّريقة الوحيدة الّتي يمكن
.الوصول بها للخبرة القصوى في عالم الطّبخ

163
00:10:43,620 --> 00:10:45,450
.كطبخ ذلك الرّجل تمامًا

164
00:10:46,660 --> 00:10:47,330
ماذا قلتِ؟

165
00:10:47,620 --> 00:10:48,580
.لا شيء

166
00:10:49,830 --> 00:10:53,090
بالمناسبة، لماذا فاتتك الحافلة؟

167
00:10:53,090 --> 00:10:55,050
.لا شيء يدفعني لأخبرك عن السّبب

168
00:10:55,840 --> 00:10:56,800
.حسنًا

169
00:11:04,260 --> 00:11:07,680
.أظنّ أنّ هذا هو ما يسمّى بالوضع المحرج

170
00:11:08,310 --> 00:11:09,350
.أعتقد أنّي سأخلد لنّوم

171
00:11:23,660 --> 00:11:24,740
!وجدتُه

172
00:11:25,200 --> 00:11:26,240
...لقد ارتحت

173
00:11:46,850 --> 00:11:47,970
...فهمت

174
00:11:48,560 --> 00:11:53,310
.(يوكيهيرا سوما) هو ابنك يا (جويْتشيرو)

175
00:12:08,740 --> 00:12:10,960
.انتهى المخيّم أخيرًا

176
00:12:10,960 --> 00:12:13,580
.سيصبح الوضع هنا صاخبًا من جديد

177
00:12:16,630 --> 00:12:20,210
—ماذا؟ كان ذلك سريعًا

178
00:12:22,470 --> 00:12:25,220
.يا إلهي، لا أصدّق هذا

179
00:12:25,220 --> 00:12:28,560
.كان عليك أن تتّصل على الأقلّ إن كنتَ ستعود

180
00:12:28,560 --> 00:12:30,930
!لم تتغيّر أبدًا! أين ذهبت أخلاقك؟

181
00:12:30,930 --> 00:12:33,480
.حسنًا، كنت قريبًا من هنا فحسب

182
00:12:36,310 --> 00:12:36,980
.لقد عدت

183
00:12:41,940 --> 00:12:43,360
!لقد عُدنا

184
00:12:43,360 --> 00:12:45,240
!عُدنا

185
00:12:45,780 --> 00:12:49,740
أتيت في واحدة من سيّارات الفندق يا (سوما)-كُن؟

186
00:12:49,740 --> 00:12:50,750
!أنا أحسدك

187
00:12:50,750 --> 00:12:52,080
