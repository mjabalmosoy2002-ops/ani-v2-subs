1
00:00:00,520 --> 00:00:02,020
...هل أنتِ

2
00:00:03,590 --> 00:00:05,730
!هل أنتِ تعرجين؟

3
00:00:07,510 --> 00:00:11,550
سابقًا قد لويت كاحلي حينما انزلقتُ

4
00:00:12,070 --> 00:00:15,280
لكن لا تقلق، سأصلُ إلى البيت

5
00:00:16,010 --> 00:00:16,620
سحقًا

6
00:00:18,540 --> 00:00:21,320
مهلًا، ماذا ستفعل؟

7
00:00:21,320 --> 00:00:23,370
كلا، أنزلني حالًا

8
00:00:23,700 --> 00:00:24,790
حسنًا

9
00:00:42,060 --> 00:00:45,780
حين عودتنا كلانا لم يتفوه بأيّ كلمة

10
00:00:55,290 --> 00:00:57,950
أتسائل ماذا كان يدورُ في خلدها؟

11
00:00:58,150 --> 00:01:00,760
وماذا تريدُ أن يحدث؟

12
00:01:00,760 --> 00:01:03,510
أتسائلُ هل كان عليّ أن أصغي لها؟

13
00:01:10,580 --> 00:01:12,980
تَيقَّنتُ لاحقًا

14
00:01:12,980 --> 00:01:18,050
أنّها كانت فرصتي الأخيرة لأنقاذها

15
00:02:54,600 --> 00:02:55,690
ريا

16
00:02:57,940 --> 00:02:59,070
ريا

17
00:03:01,160 --> 00:03:03,380
قد خذلتني

18
00:03:03,970 --> 00:03:06,990
هل أعتقدتِ بأنّي لن ألاحظ ذلك؟

19
00:03:07,730 --> 00:03:10,660
لن أدعكِ تغادرين بعدَ الآن

20
00:03:12,730 --> 00:03:14,130
لن تذهبِ إلى المدرسة

21
00:03:19,300 --> 00:03:21,010
لن تَري أحدًا

22
00:03:21,010 --> 00:03:23,410
لم أعُد أحتمل

23
00:03:21,460 --> 00:03:23,410
لا حاجَةَ لكِ إلى الأصدقاء

24
00:03:23,790 --> 00:03:25,810
سأجعلُ الدواء

25
00:03:24,510 --> 00:03:27,600
أنا كلُّ ما تحتاجين إليه

26
00:03:26,610 --> 00:03:30,450
يُنهي كُلّ شيء

27
00:03:57,510 --> 00:03:58,630
إذًا

28
00:03:59,970 --> 00:04:01,550
لا أستطيعُ الموت

29
00:04:20,290 --> 00:04:23,990
صباح الخير، أبي، أمي

30
00:04:25,160 --> 00:04:26,590
صباح الخير، ريا

31
00:04:26,590 --> 00:04:27,490
لقد سمعتُ

32
00:04:27,750 --> 00:04:31,950
أنتِ قد نكثتِ وعدكِ بتسلُّلِكِ إلى خارج القصر

33
00:04:31,950 --> 00:04:32,960
ماذا تعنين بذلك؟

34
00:04:33,640 --> 00:04:36,210
آسفة يا أمي

35
00:04:36,210 --> 00:04:42,310
لقد كان القمر جميلًا لذا لم أشعر إلا وأنا في الخارج

36
00:04:42,310 --> 00:04:45,200
سحقًا، انتبهي

37
00:04:45,200 --> 00:04:48,600
فأفعالكِ ستنعكس سلبًا عليّ

38
00:04:48,770 --> 00:04:50,720
يكفي ذلك

39
00:04:50,720 --> 00:04:52,850
لا تخاطبي ريا بتلك الطريقة

40
00:04:53,200 --> 00:04:54,440
حسنًا

41
00:04:54,630 --> 00:04:56,190
ماذا عن إفطاركِ يا أمي؟

42
00:04:56,190 --> 00:04:56,940
لا أُريده

43
00:05:06,180 --> 00:05:07,370
ريا

44
00:05:07,370 --> 00:05:12,320
أعتذر لضربي لكِ بالأمس

45
00:05:12,320 --> 00:05:14,810
كلا، فلا بُدَّ منه

46
00:05:14,810 --> 00:05:17,460
لم يكن علي أن أخرج

47
00:05:17,460 --> 00:05:20,880
أنا مُمتنّةٌ لك يا أبي

48
00:05:21,140 --> 00:05:22,880
عليكِ أن تكونِ كذلك

49
00:05:23,710 --> 00:05:26,240
لا بأسَ بما أنّكِ تفهمِّتي ذلك

50
00:05:29,310 --> 00:05:30,140
ريا

51
00:05:30,780 --> 00:05:35,140
الذي يقدرُ على حمايتكِ، أنا لا أحدَ غيري

52
00:05:39,840 --> 00:05:41,020
نعم

53
00:05:42,130 --> 00:05:43,760
على كُلّ حال يا ريا

54
00:05:43,760 --> 00:05:46,330
لماذا ارتديتِ زيّ المدرسة؟

55
00:05:46,330 --> 00:05:49,790
!ألم أخبركِ بعدم الذهاب إلى المدرسة؟

56
00:05:50,240 --> 00:05:53,810
نعم، قد فعلت

57
00:05:54,420 --> 00:05:55,790
أنا أعتذر

58
00:05:55,990 --> 00:05:57,370
سيّدي داينتشرو

59
00:05:59,610 --> 00:06:00,380
ريا

60
00:06:00,820 --> 00:06:02,340
غيّري ملابسكِ

61
00:06:03,220 --> 00:06:05,940
نعم، قد فهمت

62
00:06:17,510 --> 00:06:19,070
هل اكتشفتَ شيئًا؟

63
00:06:19,070 --> 00:06:24,060
نعم، قد علمتُ هويّة الفتى الذي بالأمس

64
00:06:25,380 --> 00:06:29,920
طالب في مدرسة شويو، وابنٌ للكاهن في المنطقة الثانية

65
00:06:30,550 --> 00:06:31,660
هكذا إذًا

66
00:06:32,900 --> 00:06:34,910
هل يقصدون فوريا بحديثهم؟

67
00:06:35,220 --> 00:06:38,460
لكي يتذكر أن لا يقترب من ريا أبدًا

68
00:06:39,560 --> 00:06:41,380
اقطع ذكرهُ

69
00:06:48,360 --> 00:06:51,240
!ماذا يقصد بذلك؟

70
00:06:51,240 --> 00:06:53,850
!!فوريا في خطر

71
00:06:54,310 --> 00:06:55,260
!ماذا؟

72
00:06:55,260 --> 00:06:57,020
غير معقول

73
00:06:57,020 --> 00:07:01,650
!صنعت دواء البعث وأسقيته لبابو، ماذا دهاك؟

74
00:07:01,650 --> 00:07:05,440
!!فعلت ذلك وأنت ابن المعبد

75
00:07:05,440 --> 00:07:06,740
سُحقًا

76
00:07:06,740 --> 00:07:07,910
أليس كذلك يا ميرو؟

77
00:07:07,910 --> 00:07:09,890
فاسدٌ حتى النُّخاع

78
00:07:09,890 --> 00:07:11,410
نعم، حتى النُّخاع

79
00:07:11,780 --> 00:07:14,500
أخي منذ زمن وهو يُحبُّ الزومبي

80
00:07:14,500 --> 00:07:17,330
فاعتدنا على ميولهِ الغريب

81
00:07:17,330 --> 00:07:18,910
ولكن ليس إلى هذه الدرجة

82
00:07:19,160 --> 00:07:20,910
اصمتا واهتمّا بشؤونكما

83
00:07:21,660 --> 00:07:22,790
نعم

84
00:07:22,790 --> 00:07:26,210
ربما ما فعلتهُ لا يُغتفر

85
00:07:27,930 --> 00:07:31,670
ومع ذلك فبابو قد عاد حيًّا

86
00:07:32,750 --> 00:07:35,460
ألستِ سعيدة؟

87
00:07:35,460 --> 00:07:37,260
بعودتهِ حيًّا

88
00:07:39,820 --> 00:07:42,600
...أنا سعيدةٌ أيضًا، لكن

89
00:07:44,220 --> 00:07:47,500
من الصعبِ التصديقُ بأنّهُ قد بُعثَ حيًّا

90
00:07:47,500 --> 00:07:49,110
إذًا ما هذا؟

91
00:07:51,910 --> 00:07:57,600
اسمعتِ، ليس هناك من مُوائهُ يشابه مُواء بابو الغريب

92
00:07:59,700 --> 00:08:03,580
ومع ذلك، لكن به شيءٌ غريب

93
00:08:04,080 --> 00:08:06,530
فعيناه صارت اكثر اتساعًا

94
00:08:06,530 --> 00:08:10,550
لست متأكدة ولكنّه في السابق كانت تبدو عليه الحياة

95
00:08:10,680 --> 00:08:13,180
لكنّه ما زال كما كان

96
00:08:13,410 --> 00:08:15,180
أتسائل عن ذلك؟

97
00:08:15,180 --> 00:08:16,970
إذًا ماذا؟

98
00:08:16,970 --> 00:08:21,310
لنفترض بأنّه قد عاد إلى الحياة

99
00:08:21,530 --> 00:08:24,070
هل أنت متأكد بأنّه لن يتصرف كالزومبي ويهاجم الناس؟

100
00:08:24,070 --> 00:08:28,220
وهل إن عَضَّ الناس لن يصيروا مثلهُ زومبي؟

101
00:08:32,300 --> 00:08:34,530
من المستحيل ذلك فنحن لسنا في مانجا

102
00:08:34,530 --> 00:08:36,410
هل أنتَ مُتيقن بأنّ ذلك لن يحدث؟

103
00:08:39,440 --> 00:08:41,430
مهلًا قليلًا

104
00:08:41,430 --> 00:08:43,310
انتظرني

105
00:08:46,490 --> 00:08:48,860
!يا أخي حقيبتك

106
00:08:48,860 --> 00:08:49,660
لا أريدها

107
00:08:49,660 --> 00:08:51,260
سأتغيب عن المدرسة

108
00:08:53,150 --> 00:08:54,230
سحقًا

109
00:08:55,400 --> 00:08:58,790
ماذا؟ ما الخطب؟

110
00:08:58,790 --> 00:09:00,260
جدّي

111
00:09:00,650 --> 00:09:04,240
أخي يقول بأنّه قد بعث بابو من الموت

112
00:09:04,240 --> 00:09:06,810
ولكنّي أظنّهُ قد أتى بقطٍّ آخر

113
00:09:07,160 --> 00:09:09,340
فهمتُ

114
00:09:09,340 --> 00:09:11,280
قد أعاد بابو إلى الحياة

115
00:09:12,910 --> 00:09:13,820
حسنًا فعل

116
00:09:23,740 --> 00:09:25,460
يا للغرابة

117
00:09:25,650 --> 00:09:28,460
لم يكن يتجول هكذا سابقًا

118
00:09:28,460 --> 00:09:31,590
أليس من الخطر أن تمسكه بيديك

119
00:09:44,220 --> 00:09:47,350
يا وانكو أليس لديكِ تمرينٌ في الصباح

120
00:09:47,630 --> 00:09:49,100
اسرعي بالذهابِ إلى المدرسة

121
00:09:49,510 --> 00:09:53,560
بصفتي كأختِكَ الكبرى يا تشهرو تقع على عاتقي مسؤوليتك

122
00:09:53,560 --> 00:09:54,970
ولكنك ابنة عمّي

123
00:09:56,350 --> 00:09:57,990
!!أَدَخَل فيه

124
00:09:59,220 --> 00:10:00,490
!حقاً! أستدخل؟

125
00:10:25,800 --> 00:10:27,600
أتريدُ قليلًا؟

126
00:10:35,050 --> 00:10:37,490
افعل ما تريد يا مُرائي

127
00:10:46,190 --> 00:10:49,040
!طويلٌ أليس له نهاية؟

128
00:10:49,040 --> 00:10:51,750
انتظرني قليلًا

129
00:10:52,930 --> 00:10:54,800
اختنقتُ

130
00:10:54,800 --> 00:10:58,300
إلى متى ستستمرُّ هذه القناة؟

131
00:11:01,300 --> 00:11:02,990
!أتسمعني؟

132
00:11:02,990 --> 00:11:06,560
قد علقتُ فلا أستطيعُ التقدم

133
00:11:09,340 --> 00:11:11,920
...من الجيد أن تقلق على بابو، لكن

134
00:11:11,920 --> 00:11:15,070
اقلق عليّ كذلك ولو قليلًا

135
00:11:15,420 --> 00:11:17,540
ألست تسمعني؟

136
00:11:20,270 --> 00:11:21,360
تشهرو

137
00:11:21,360 --> 00:11:23,360
يا الغبي

138
00:11:32,830 --> 00:11:34,840
وأخيرًا خرجتُ

139
00:11:34,840 --> 00:11:35,880
!ماذا؟

140
00:11:38,950 --> 00:11:40,260
...أهذا المكان

141
00:11:44,720 --> 00:11:47,120
أسفلَ القصر

142
00:12:00,980 --> 00:12:02,740
يا موقي

143
00:12:03,550 --> 00:12:04,700
أتحبُ كرة القاعدة؟

144
00:12:06,210 --> 00:12:08,160
نعم، أشاهدها

145
00:12:08,460 --> 00:12:10,060
وماذا عن الفتيات؟

146
00:12:11,250 --> 00:12:12,790
أراهم أيضًا

147
00:12:12,790 --> 00:12:14,360
!!تشاهدهم فقط

148
00:12:16,460 --> 00:12:19,770
لذلك أنت مازلت تبدو كالأطفال

149
00:12:30,470 --> 00:12:32,310
تبًا

150
00:12:32,590 --> 00:12:34,640
لا أستطيع الإعتداء عليه

151
00:12:34,640 --> 00:12:37,590
لأنه لا يملك صدرًا

152
00:12:38,540 --> 00:12:41,200
ماذا تعني يا ياستوكا

153
00:12:41,200 --> 00:12:42,770
لم أفهم كلامك

154
00:12:42,770 --> 00:12:46,230
هنا سنتمتع بمشاهدةِ فتيات سانكا

155
00:12:46,230 --> 00:12:47,320
المعذرة

156
00:12:47,920 --> 00:12:50,580
لديّ سؤال

157
00:12:51,710 --> 00:12:57,250
هل فوريا هنا؟

158
00:13:00,630 --> 00:13:02,750
ماذا قلتِ؟

159
00:13:02,750 --> 00:13:07,760
أسئلُ عن طالب السنة الأولى فوريا تشهرو؟

160
00:13:08,100 --> 00:13:11,260
!!فو...رو...تشي

161
00:13:11,510 --> 00:13:13,700
أتعرفهُ يا موقي؟

162
00:13:13,700 --> 00:13:16,180
يبدو

163
00:13:16,180 --> 00:13:18,230
بأنّه لم يحضر اليوم

164
00:13:18,820 --> 00:13:21,360
حسنًا

165
00:13:21,360 --> 00:13:24,960
أخبريني ماذا تريدين منه؟

166
00:13:24,960 --> 00:13:26,780
ماذا تريدين منه؟

167
00:13:29,630 --> 00:13:30,700
لا شيء

168
00:13:32,640 --> 00:13:35,710
قد يخْصونهُ

169
00:13:37,330 --> 00:13:41,130
...الآن الميرة قالت يخْـ

170
00:13:41,410 --> 00:13:43,010
لا شيء

171
00:13:43,010 --> 00:13:44,790
شكرًا لكم

172
00:13:48,490 --> 00:13:52,600
!لماذا أنتِ من يسأل عن فوريا؟

173
00:13:57,460 --> 00:13:59,470
لقد كنتُ مرتبكة

174
00:13:59,470 --> 00:14:02,820
أنا لم أقل أيّ شيء غريب، أليس كذلك؟

175
00:14:03,970 --> 00:14:06,730
فوريا، أين أنت؟

176
00:14:15,000 --> 00:14:17,260
!ماذا؟ ريا هناك

177
00:14:19,470 --> 00:14:21,270
لا، لا بأس الآن

178
00:14:22,840 --> 00:14:24,590
اهتم بذلك لاحقًا

179
00:14:29,740 --> 00:14:32,570
لماذا لا تستمع إلي؟ لماذا؟

180
00:14:33,180 --> 00:14:34,580
لا استوعبُ ذلك

181
00:14:52,750 --> 00:14:54,430
تبًا

182
00:14:54,430 --> 00:14:56,430
بابو إلى أين ذهبت؟

183
00:14:58,950 --> 00:15:01,520
!و وانكو أيضًا لا أدري إلى أين اختفت

184
00:15:01,980 --> 00:15:04,180
!أليس واجبها أن تراقبني؟

185
00:15:05,350 --> 00:15:07,580
سحقًا يبدو بأنّها ستمطر

186
00:15:14,840 --> 00:15:15,390
وجدته

187
00:15:21,330 --> 00:15:23,860
!يأكلُ من القرطاسية

188
00:15:29,940 --> 00:15:30,820
انتظر

189
00:15:31,560 --> 00:15:33,820
هل هذا المكان...؟

190
00:15:40,940 --> 00:15:44,920
كما توقعتُ، إنّه المكان الذي تهوّرت فيه  لتتسلق الجبل بالأمس

191
00:15:46,690 --> 00:15:47,670
!ماذا؟

192
00:15:48,860 --> 00:15:51,170
!مالذي تفعلهُ في هذهِ الساعة؟

193
00:15:53,790 --> 00:15:57,460
سأنتظرهُ بمكاننا المعتاد في الفندق المهجور

194
00:15:57,460 --> 00:16:01,140
فبالتأكيد سأراهُ إذا انتظرته

195
00:16:04,470 --> 00:16:06,890
إنّها غلطتي

196
00:16:08,340 --> 00:16:12,750
لا أريدُ أن أتسبب لفوريا بالمتاعب

197
00:16:13,250 --> 00:16:16,640
إلى أين أنتِ ذاهبة، ياريا؟

198
00:16:17,420 --> 00:16:20,250
أتتجولين؟

199
00:16:20,250 --> 00:16:24,840
ألا يبدو بأنّكِ قد ابتعدت قليلًا؟

200
00:16:27,920 --> 00:16:28,970
من هذا؟

201
00:16:28,970 --> 00:16:31,970
هل من الممكن أن يكون والد ريا؟

202
00:16:31,970 --> 00:16:33,970
هيّا لنعود سويًّا

203
00:16:33,970 --> 00:16:37,640
إن فعلتِ فسأعفو عن فعلتكِ هذه

204
00:16:39,110 --> 00:16:41,470
أنت فتاةٌ ذكيّة

205
00:16:43,630 --> 00:16:49,230
لماذا؟ لأنكِ من عائلةِ سانكا وابنتي كذلك

206
00:16:58,280 --> 00:17:00,080
عن ماذا يتحدثون؟

207
00:17:02,330 --> 00:17:07,090
ماذا؟! ما تعنين بفعلتكِ هذه يا ريا؟

208
00:17:09,440 --> 00:17:10,650
أبي

209
00:17:11,500 --> 00:17:12,470
بالتأكيد

210
00:17:14,440 --> 00:17:18,420
بالتأكيد أنا ابنتك

211
00:17:19,280 --> 00:17:21,740
لكن...ذلك

212
00:17:22,550 --> 00:17:26,870
لا يعني بأنّك ستمتلك قلبي وجسدي لأنّي فقط ابنتك

213
00:17:28,060 --> 00:17:29,700
...ولو قليلًا

214
00:17:31,060 --> 00:17:32,380
