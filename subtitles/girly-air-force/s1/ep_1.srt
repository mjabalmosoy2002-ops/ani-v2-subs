1
00:00:11,530 --> 00:00:13,020
!إنّها الزّاي

2
00:00:33,710 --> 00:00:35,170
!من هنا! بسرعة

3
00:00:35,520 --> 00:00:36,630
!سُحقًا

4
00:00:37,550 --> 00:00:38,590
!الزّاي

5
00:01:08,480 --> 00:01:11,500
كي! ماذا تفعل؟
!علينا مغادرة المكان

6
00:01:11,500 --> 00:01:14,460
.نعم، لن تطفو هذه السّفينة لوقت طويل

7
00:01:14,460 --> 00:01:17,170
.لنذهب يا كي! لا تقلق

8
00:01:17,170 --> 00:01:18,890
.سأحميك مهما كلّف الثّمن

9
00:01:20,160 --> 00:01:21,130
.نعم

10
00:01:37,500 --> 00:01:38,880
!أتت القوات الجويّة

11
00:01:38,880 --> 00:01:39,940
!نالوا منها

12
00:01:40,320 --> 00:01:42,630
!ذلك... لن ينفع

13
00:02:19,320 --> 00:02:20,310
!كي

14
00:02:23,480 --> 00:02:24,530
.لقد استيقظ

15
00:02:25,420 --> 00:02:27,180
.أنماط البيض في المدى المقبول

16
00:02:27,180 --> 00:02:28,280
.كلّ الأنظمة تشتغل

17
00:02:29,560 --> 00:02:30,250
!اسمعي

18
00:02:30,950 --> 00:02:33,220
ما الخطب أيّها المتخلّفة؟

19
00:02:33,220 --> 00:02:35,660
.أريد الطّيران

20
00:03:04,790 --> 00:03:06,610
!كلاّ! توقّفي

21
00:03:24,550 --> 00:03:26,970
هل أسقط ذلك الشّيء أحد الزّاي؟

22
00:04:10,160 --> 00:04:11,340
...مذهل

23
00:04:38,380 --> 00:04:39,680
لن تذهبوا لإنقاذه؟

24
00:04:39,680 --> 00:04:40,280
كي؟

25
00:04:40,280 --> 00:04:41,790
!ما زال الطّيّار بالدّاخل

26
00:04:47,210 --> 00:04:49,970
!كي

27
00:05:01,020 --> 00:05:02,400
الشّمس المشرقة؟

28
00:05:04,100 --> 00:05:06,180
أنت، هل أنت بالدّاخل؟

29
00:05:07,940 --> 00:05:09,200
!ثمّة قارب إنقاذ هنا

30
00:05:09,200 --> 00:05:11,290
!اخرج بسرعة! سوف تغرق الطّائرة

31
00:05:24,500 --> 00:05:26,000
...مـ-مرحبًا

32
00:05:33,410 --> 00:05:35,200
—لست هنا لأؤذيك

33
00:05:43,300 --> 00:05:45,050
..."نوفا إيرا"

34
00:05:46,570 --> 00:05:47,770
!ماذا؟

35
00:05:47,770 --> 00:05:48,910
!تمالكي نفسك

36
00:06:08,340 --> 00:06:10,220
القوّت الجوّيّة الأنثويّة

37
00:07:29,160 --> 00:07:32,520
أين أنا؟

38
00:07:32,520 --> 00:07:33,600
.صحيح

39
00:07:34,170 --> 00:07:35,930
.هذا منزل جدّي في كوماتسو

40
00:07:41,720 --> 00:07:44,540
لم يكن ذلك حلمًا، صحيح؟

41
00:07:48,330 --> 00:07:52,240
تحطّمت طائرة مقاتلة يابانيّة
.في المياه الإقليميّة الصّينيّة

42
00:07:52,240 --> 00:07:54,310
.ذهبت لإنقاذ الطّيّار، فاتّضح أنه فتاة يافعة

43
00:07:54,310 --> 00:07:55,650
.وقد قبّلتني

44
00:07:56,110 --> 00:07:57,560
.هذا مستحيل

45
00:07:58,080 --> 00:08:00,810
.لذلك لم أخبر أحدًا

46
00:08:00,810 --> 00:08:03,110
كي، متى ستستيقظ؟

47
00:08:03,110 --> 00:08:04,650
مـ-مينهوا؟

48
00:08:04,650 --> 00:08:06,090
ألا تعرفين كيف تطرقين الباب؟

49
00:08:06,440 --> 00:08:09,670
.رأيتك وأنت ترتدي ملابسك الدّاخليّة مرّات عدّة

50
00:08:09,670 --> 00:08:12,410
.لا فائدة من الشّعور بالخجل الآن

51
00:08:12,410 --> 00:08:15,320
!الأمر ليس كما كنّا ونحن صغار

52
00:08:15,870 --> 00:08:17,770
ماذا إن حدث العكس؟

53
00:08:17,770 --> 00:08:19,750
ماذا إن كنت أنا من دخل
وأنت تغيّرين ملابسك؟

54
00:08:19,750 --> 00:08:20,690
.سأغضب

55
00:08:20,690 --> 00:08:22,220
!هذا ليس عدلاً

56
00:08:22,490 --> 00:08:24,690
.تفضّل، هذه قائمة المشتريات

57
00:08:24,690 --> 00:08:27,470
!إنّها من أجل الغداء، لذلك اذهب الآن

58
00:08:27,470 --> 00:08:28,820
!أسرع

59
00:08:31,400 --> 00:08:34,370
لماذا تلقين عليّ الأوامر؟
.هذا ليس حتّى منزلك

60
00:08:37,540 --> 00:08:39,290
.أمّي، اشتري لي بعض الحلوى الهلاميّة

61
00:08:39,660 --> 00:08:41,790
كبر ليسي كثيرًا الآن، صحيح؟

62
00:08:41,790 --> 00:08:42,420
!نعم

63
00:08:42,690 --> 00:08:44,110
.لا أصدّق هذا

64
00:08:44,110 --> 00:08:45,620
هل يمكن هزيمته من الأساس؟

65
00:08:52,380 --> 00:08:53,700
.صحيح

66
00:08:53,700 --> 00:08:56,220
.ما زالت هنالك طائرات مدنيّة في الأجواء هنا

67
00:08:58,850 --> 00:09:01,930
يتوافد المزيد والمزيد
.من اللاّجئين من القارّة يوميًّا

68
00:09:01,930 --> 00:09:04,950
إنّ تجاوز الاختلافات والصّعوبات الثّقافيّة

69
00:09:03,210 --> 00:09:04,480
.شكرًا على الطّعام

70
00:09:04,480 --> 00:09:06,500
.العفو. ضع الطّبق هنا فحسب

71
00:09:04,950 --> 00:09:07,940
.مع المحلّيّين قد أمسى مسألة ملحّة

72
00:09:07,940 --> 00:09:11,700
ما الّذي تفعله السّلطات بسماحها
...لهؤلاء الزّاي بمواصلة

73
00:09:13,910 --> 00:09:16,170
."يقولون إنّ الزّاي مجرّد "مجموعة مسلّحة

74
00:09:16,570 --> 00:09:18,350
.اليابان مسالمة جدًّا

75
00:09:18,350 --> 00:09:19,330
وما خطب ذلك؟

76
00:09:19,330 --> 00:09:22,770
ذلك أفضل من الهرب للنّجاة
.بحياتنا كلّ يوم

77
00:09:22,770 --> 00:09:23,860
...ولكن

78
00:09:23,860 --> 00:09:25,990
.أنا أحبّ هذه المدينة

79
00:09:25,990 --> 00:09:28,200
.الهواء عليل وهادئ للغاية

80
00:09:28,650 --> 00:09:30,590
تمكّنت من النّوم جيّدًا
.لأوّل مرّة منذ وقت طويل

81
00:09:31,330 --> 00:09:33,310
...أكيد، ولكن

82
00:09:33,660 --> 00:09:35,590
.سأواصل التّنظيف

83
00:09:35,590 --> 00:09:37,270
.اذهب لريّ الحديقة

84
00:09:37,270 --> 00:09:39,000
ألا تعتقدين أنّك تبالغين؟

85
00:09:39,000 --> 00:09:42,660
قال جدّي إنّك لست بحاجة للقيام
بكلّ هذا، صحيح؟

86
00:09:42,660 --> 00:09:45,610
.أنا أعيش بالمجّان هنا كما تعلم

87
00:09:46,110 --> 00:09:49,440
إن لم أشغل نفسي، فسأبدأ
.في الّتفكير في بعض الأشياء

88
00:09:50,060 --> 00:09:51,310
.فهمت

89
00:09:51,950 --> 00:09:55,040
!مينهوا

90
00:09:52,690 --> 00:09:54,170
!أبي

91
00:09:55,640 --> 00:09:59,490
أنا واثق أنّ والداك سيأتيان
.في سفينة الإخلاء التّالية

92
00:09:59,490 --> 00:10:02,710
.نـ-نعم، أنت محقّ

93
00:10:02,710 --> 00:10:05,810
.أجل. سيوف يتخلّصون من الزّاي في النّهاية

94
00:10:06,140 --> 00:10:09,910
.وبمجرّد زوالها، سنتمكّن من العودة للصّين

95
00:10:11,150 --> 00:10:12,360
كي؟

96
00:10:27,940 --> 00:10:33,110
.كنت واثق أنّ تلك المقاتلة الحمراء كانت يابانيّة

97
00:10:35,090 --> 00:10:36,970
لم أحلم بذلك، صحيح؟

98
00:10:38,530 --> 00:10:41,020
،إن كان بإمكاني قيادة إحداها
.فسأتمكّن من القضاء على الزّاي

99
00:10:41,320 --> 00:10:43,400
!سأتمكّن من الانتقام لأمّي

100
00:10:47,130 --> 00:10:48,120
!كي

101
00:10:48,120 --> 00:10:49,280
.علينا أن نتكلّم

102
00:10:49,850 --> 00:10:50,820
بشأن ماذا؟

103
00:10:51,630 --> 00:10:54,430
ما قصّة الانضمام لأكاديميّة القوّات الجوّيّة
لقوّات الدّفاع الذّاتيّ؟

104
00:10:54,930 --> 00:10:57,140
.الأمر كما يبدو تمامًا

105
00:10:57,570 --> 00:11:01,610
من الممكن الحصول على تدريب
.لأصبح طيّارًا في مقاطعة ياماغوتشي

106
00:11:02,000 --> 00:11:04,040
.لا نحتاج للدّفع لقاء السّكن أو التّعليم

107
00:11:04,040 --> 00:11:05,890
.حتّى أنّه يمكننا الحصول على راتب

108
00:11:05,890 --> 00:11:07,140
صفقة ممتازة، صحيح؟

109
00:11:08,620 --> 00:11:11,850
وماذا إن كان التّعليم مجّانيًّا؟

110
00:11:11,850 --> 00:11:13,560
أنت تفهمين، صحيح؟

111
00:11:13,560 --> 00:11:15,080
،إن قمت بالاستفادة من ذلك

112
00:11:15,080 --> 00:11:17,440
.فحتّى شخص مثلي يمكنه أن يصبح طيّارًا

113
00:11:17,440 --> 00:11:18,170
.غبيّ

114
00:11:18,170 --> 00:11:19,700
ما قصدك بمناداتي بالغبيّ؟

115
00:11:19,700 --> 00:11:21,140
.غبيّ تعني غبيّ

116
00:11:21,140 --> 00:11:22,680
مدرسة قوّات دفاع ذاتيّ؟

117
00:11:22,680 --> 00:11:24,980
هذا يعني أنّك ستصبح جنديًّا، صحيح؟

118
00:11:24,980 --> 00:11:27,360
ستحلّق بطائرة وتقاتل الزّاي؟

119
00:11:27,360 --> 00:11:28,250
أتسعى للموت؟

120
00:11:28,250 --> 00:11:29,410
!لن أموت

121
00:11:29,410 --> 00:11:31,750
رأيت ما حدث عندما هربنا من شانغهاي، صحيح؟

122
00:11:31,750 --> 00:11:33,480
.تلك المقاتلة النّفّاثة الحمراء

123
00:11:33,480 --> 00:11:35,520
،لم يستطع أحد إسقاط الزّاي من قبل

124
00:11:35,520 --> 00:11:37,240
!لكنّها كانت تجهز عليها دون أيّ جهد يُذكر

125
00:11:37,650 --> 00:11:39,870
!أنا واثق أنّه سلاح سرّيّ لقوّات الدّفاع الذّاتيّ

126
00:11:39,870 --> 00:11:43,230
لكنّ "السّلاح السّرّيّ" الّذي تتحدّث
.عنه قد هوى وتحكّم

127
00:11:44,650 --> 00:11:47,710
.لن تصبح طيّارًا أبدًا

128
00:11:47,710 --> 00:11:50,570
لم تستطع حتّى هزيمتي
.في مصارعة الأذرع من قبل

129
00:11:50,570 --> 00:11:52,320
.كان ذلك منذ مدّة

130
00:11:52,320 --> 00:11:54,170
فزت عليك في الرّكض والقفز الطّويل

131
00:11:54,170 --> 00:11:56,410
.وحتّى في اختبار الرّؤية

132
00:11:56,410 --> 00:11:58,410
!هذه أسرع طريقة

133
00:11:58,410 --> 00:12:01,690
سأصبح طيّارًا في قوّات الدّفاع الذّاتيّ
.وأحلّق في تلك الطّائرة النّفّاثة

134
00:12:01,690 --> 00:12:03,540
.قلتُ لا وأنا أعني لا

135
00:12:03,540 --> 00:12:05,940
.سأخبر جدّيك بالأمر

136
00:12:05,940 --> 00:12:09,910
سأخبرهما بأنّه قد خطرت لك فكرة غبيّة
.وأنّ عليهما إيقافك

137
00:12:12,410 --> 00:12:14,410
إلى أين ستذهب يا كي؟

138
00:12:21,970 --> 00:12:24,900
!سُحقًا! سُحقًا! سُحقًا

139
00:12:30,650 --> 00:12:31,730
.هذه هي

140
00:12:32,840 --> 00:12:35,050
...الياس 39

141
00:12:35,520 --> 00:12:36,690
.غريبن

142
00:12:38,050 --> 00:12:39,760
مقاتلة سويديّة؟

143
00:12:40,860 --> 00:12:44,520
لماذا تملك مقاتلة سويديّة
شعار الشّمس المشرقة؟

144
00:12:47,540 --> 00:12:51,880
،إن انضممت إلى قوّات الدّفاع الذّاتيّ الجوّيّة
.فسأتمكن من الطّيران في واحدة منها

145
00:12:52,760 --> 00:12:55,010
.ربّما كنت مخطئًا

146
00:12:59,460 --> 00:13:01,600
ما تلك الطّائرة الضّخمة؟

147
00:13:02,710 --> 00:13:04,330
.باعُ جناحيها هائل جدًّا

148
00:13:05,010 --> 00:13:06,540
!مـ-مستحيل

149
00:13:11,650 --> 00:13:12,840
...إنّها

150
00:13:24,040 --> 00:13:25,470
!سُحقًا

151
00:13:37,150 --> 00:13:38,350
أين أنت؟

152
00:13:38,350 --> 00:13:40,290
.العشاء جاهز

153
00:13:51,810 --> 00:13:55,520
هذه... قاعدة لقوّات الدّفاع الذّاتيّ الجوّيّة؟

154
00:13:55,930 --> 00:13:57,290
قاعدة كوماتسو؟

155
00:14:24,060 --> 00:14:25,520
لا يمكنني رؤية ما بالدّاخل؟

156
00:14:26,690 --> 00:14:29,240
لكن لا يمكنني الاستسلام بعد
!وصولي لهذه المرحلة

157
00:14:32,620 --> 00:14:34,660
هل هنالك أيّ مكان سيُمكّنني
من رؤية ما بالدّاخل؟

158
00:14:38,820 --> 00:14:41,270
!أنا في طرف القاعدة سلفًا

159
00:14:48,940 --> 00:14:52,280
!سُحقًا! لا يمكنني رؤية أيّ شيء من هنا

160
00:14:56,250 --> 00:14:57,950
مـ-مينهوا؟

161
00:14:57,950 --> 00:14:59,990
ما الّذي تفعله هنا؟

162
00:14:59,990 --> 00:15:01,570
ما-ماذا...؟

163
00:15:01,570 --> 00:15:03,460
،طريقة إسراعك إلى هنا
...وفي هذا الوقت المتأخّر

164
00:15:03,460 --> 00:15:05,710
.لقد تبعتك لأنّني تساءلت عمّ تفعله

165
00:15:05,710 --> 00:15:08,870
ما الّذي تفعله بذهابك إلى قاعدة
قوّات الدّفاع الذّاتيّ؟

166
00:15:09,620 --> 00:15:11,730
.هذا ليس من شأنك يا مينهوا

167
00:15:11,730 --> 00:15:12,660
!بل هو كذلك

168
00:15:12,660 --> 00:15:13,220
لماذا؟

169
00:15:13,220 --> 00:15:15,150
!أنا قلقة عليك

170
00:15:15,150 --> 00:15:17,430
إنّك تقوم بأمور مجنونة عندما
.أشيح نظري عنك

171
00:15:18,480 --> 00:15:21,380
اسمعي، هلاّ توقّفتِ عن هذا؟

172
00:15:21,380 --> 00:15:22,930
أتوقّف عمّاذا؟

173
00:15:24,010 --> 00:15:26,530
عن التّصرّف وكأنّك والدتي
!وإخباري عمّ أفعل طوال الوقت

174
00:15:28,280 --> 00:15:30,910
!لن أكون طفلاً للأبد

175
00:15:30,910 --> 00:15:31,980
!دعيني وشأني

176
00:15:31,980 --> 00:15:32,960
!لا يمكنني ذلك

177
00:15:33,310 --> 00:15:34,410
لا يمكنك؟

178
00:15:34,410 --> 00:15:38,390
!أنا قلقة لأنّني أعتقد أنّك بحاجتي

179
00:15:38,390 --> 00:15:42,360
،لا يهمّ إن كنّا في الصّين أو اليابان
!أو حتّى في القطب الشّماليّ

180
00:15:42,360 --> 00:15:44,240
.أنت تتصرّفين بغرابة

181
00:15:44,240 --> 00:15:45,620
.أنت من يتصرّف بغرابة

182
00:15:45,620 --> 00:15:47,350
.أنا طبيعيّة

183
00:15:47,350 --> 00:15:48,820
.لنعد الآن

184
00:15:48,820 --> 00:15:50,440
.يمكننا التّحدّث عندما نعود للمنزل

185
00:15:50,440 --> 00:15:51,960
!توقّفي

186
00:15:51,960 --> 00:15:53,500
ما الّذي دهاك؟

187
00:15:53,500 --> 00:15:55,880
حتّى إن طلب والداي منك
،الاعتناء بي في الماضي

188
00:15:56,450 --> 00:15:58,680
!فليس عليك التّصرّف بهذا العناد

189
00:15:58,680 --> 00:16:00,440
!لقد كنّا صغارًا حينها

190
00:16:00,440 --> 00:16:03,090
!هذا ليس هو السّبب

191
00:16:04,100 --> 00:16:08,240
أنت الشّخص الوحيد
.الّذي أعرفه في هذا البلد الآن

192
00:16:08,600 --> 00:16:11,440
.انفصلت عن عائلتي وأصدقائي

193
00:16:11,440 --> 00:16:14,980
،أنت كلّ ما بقي لي
ومع ذلك تريد الانضمام للجيش؟

194
00:16:14,980 --> 00:16:17,230
ألا يفترض بي أن أقلق؟

195
00:16:17,540 --> 00:16:20,470
هل ذلك يعتبر تصرّف أمٍّ متسلّطة؟

196
00:16:22,290 --> 00:16:24,180
...اسمي يا مينهوا

197
00:16:29,710 --> 00:16:31,130
—مهلاً، ما الّذي

198
00:16:49,830 --> 00:16:51,060
.حسنًا. انزعوا عصابة العينين

199
00:16:54,010 --> 00:16:55,840
!مينهوا! مينهوا

200
00:16:55,840 --> 00:16:59,380
.اسمع، سأطرح عليك أسئلة بسيطة

201
00:16:59,380 --> 00:17:01,420
من تكون؟

202
00:17:01,420 --> 00:17:02,880
من أرسلك؟

203
00:17:02,880 --> 00:17:04,420
أين هي مينهوا؟

204
00:17:04,420 --> 00:17:05,240
أين أنا؟

205
00:17:05,240 --> 00:17:06,840
.ابدأ بالتّكلّم

206
00:17:06,840 --> 00:17:08,720
.لستُ رجلاً صبورًا

207
00:17:08,720 --> 00:17:12,260
.إن لم تبدأ بالكلام، فسأرديك قتيلاً الآن

208
00:17:12,260 --> 00:17:14,270
!واضح أنّ هذا خطأ

209
00:17:14,270 --> 00:17:16,730
.كنّا نتمّشى فحسب

210
00:17:16,730 --> 00:17:19,570
.يا له من عذر تافه

211
00:17:19,570 --> 00:17:24,110
أعتقد أنّ وكالات الاستخبارات لا تدرّب
.جواسيسها للتّعامل مع التّحقيقات بعد الآن

212
00:17:24,110 --> 00:17:25,770
وكالات الاستخبارات؟

213
00:17:26,240 --> 00:17:27,590
.لديك خمس ثوانٍ

214
00:17:28,280 --> 00:17:30,350
.سأضغط على الزّناد بعد خمس ثوانٍ

215
00:17:30,350 --> 00:17:32,130
.وأنا لا أكذب

216
00:17:32,130 --> 00:17:33,030
!أربعة

217
00:17:33,030 --> 00:17:34,310
!مهلاً

218
00:17:34,310 --> 00:17:35,290
!ثلاثة

219
00:17:35,290 --> 00:17:36,530
!فهمتم الأمر بشكل خاطئ تمامًا

220
00:17:36,530 --> 00:17:37,500
.اثنان

221
00:17:37,500 --> 00:17:38,360
...أنا

222
00:17:38,360 --> 00:17:39,440
!واحد

223
00:17:46,740 --> 00:17:50,620
.علمتُ أنّ بإمكانك التّحرّك أيّتها الكسولة

224
00:18:04,030 --> 00:18:05,910
.لا بأس، لا بأس

225
00:18:05,910 --> 00:18:08,080
.سأكفّ عن العبث

226
00:18:08,080 --> 00:18:10,310
.أنت، لنهتمّ بهذا الأمر

227
00:18:10,310 --> 00:18:11,860
.الأميرة منزعجة

228
00:18:20,230 --> 00:18:21,710
.أنا آسف

229
00:18:24,030 --> 00:18:25,850
اسمك ناروتاني-كُن، صحيح؟

230
00:18:27,590 --> 00:18:28,980
.تعال معي

231
00:18:28,980 --> 00:18:30,530
.لدينا أمر علينا التّحدّث بشأنه

232
00:18:30,530 --> 00:18:33,630
مينهوا... هل مينهوا بخير؟

233
00:18:33,630 --> 00:18:34,930
.إنّها بخير

234
00:18:34,930 --> 00:18:37,660
.إنّها تنتظر في مقرّ الحراسة

235
00:18:38,220 --> 00:18:41,120
كانت قلقة بشأنك كفاية للتّسبّب
.ببعض الأضرار الجسيمة

236
00:18:41,120 --> 00:18:42,570
هل هي حبيبتك؟

237
00:18:42,570 --> 00:18:44,010
.الأمر ليس كذلك

238
00:18:44,010 --> 00:18:46,070
.سأعرّفك بنفسي

239
00:18:46,550 --> 00:18:49,210
أنا من معهد البحث والتّطوير التّكنولوجيّ
.التّابع لوزارة الدّفاع

240
00:18:49,210 --> 00:18:52,970
اسمي هو ياشيرودوري وأنا مدير
.مكتب الأبحاث التّكنولوجيّة الخاصّة

241
00:18:52,970 --> 00:18:54,630
وزارة الدّفاع؟

242
00:18:55,020 --> 00:18:56,860
تقصد أنّك من قوّات الدّفاع الذّاتيّ؟

243
00:18:56,860 --> 00:18:58,440
.أنا ضابط تقنيّ، لكن نعم

244
00:18:58,440 --> 00:19:01,410
.تتعلّق أغلب أبحاثي بكيفية قتال الزّاي

245
00:19:02,860 --> 00:19:07,080
هل تعلم لماذا تهزمنا الزّاي بكلّ سهولة؟

246
00:19:07,860 --> 00:19:09,420
،لأنّ هنالك الكثير منها

247
00:19:09,420 --> 00:19:12,540
ولديها مقاتلات أفضل منّا؟

248
00:19:12,870 --> 00:19:14,630
.إجابتك صحيحة بنسبة 30 بالمائة

249
00:19:15,030 --> 00:19:18,530
،إنّ أعدادها جزء من السّبب
.ولكنّها تظلّ جزءًا منه فحسب

250
00:19:19,040 --> 00:19:22,540
.إنّ ما يجعلها تهديدًا هي قدراتها الخاصّة

251
00:19:22,540 --> 00:19:24,770
هايمات" و"إي بي سي إم"؟"

252
00:19:24,770 --> 00:19:27,090
هايما"... "إي بي"؟"

253
00:19:27,090 --> 00:19:30,680
هايمات". اختصار لـ"تكنولوجيا
،"طائرات شديدة المناورة

254
00:19:30,680 --> 00:19:33,200
ممّا يسمح لها بالتّحرّك بطرق لا تستطيع
.المقاتلات بالطّيّارين الوصول إليها

255
00:19:33,200 --> 00:19:38,230
في العادة، يستطيع معظم الطّيّارين البشر
.للمقاتلات تحمّل قوّة جاذبيّة تقدّر بتسعة

256
00:19:38,230 --> 00:19:41,520
،لكنّ الزّاي تستطيع تجاوز ذلك بسهولة

257
00:19:41,520 --> 00:19:44,360
فتستدير وتتسارع بمعدّلات لا يستطيع
.البشر الوصول إليها ببساطة

258
00:19:44,360 --> 00:19:47,530
.لا توجد مقاتلة عاديّة قد تكون ندًّا لها

259
00:19:47,530 --> 00:19:51,700
ولنقل أنّ هنالك من استطاع الوصول
.للمدى المناسب وأطلق صاروخًا

260
00:19:52,020 --> 00:19:55,840
.فما كان ليصيب هدفه ولخرج عن مساره وانفجر

261
00:19:56,250 --> 00:19:58,750
،حتّى إن انتقلنا إلى الوضع اليدويّ واقتربنا

262
00:19:58,750 --> 00:20:02,580
فستصبح من الصّعب رؤيتها
.كلّما اقتربنا إليها

263
00:20:03,770 --> 00:20:07,190
."هذه هي قدرتها الأخرى: "إي بي سي إم

264
00:20:07,190 --> 00:20:09,350
.التّدابير المضادّة للإدراك الإلكترونيّ

265
00:20:09,800 --> 00:20:15,020
لكنّنا لم نجلس مكتوفي الأيدي ونسمح لهذه
.التّكنولوجيا الخارقة المجهولة بالتّغلّب علينا

266
00:20:15,020 --> 00:20:17,640
...أضفنا "هايمات" إلى طائرة مقاتلة موجودة سلفًا

267
00:20:17,640 --> 00:20:20,160
..."وأضفنا قدرات مضادّة لـ"إي بي سي إم

268
00:20:20,160 --> 00:20:23,310
وعزّزنا المقاتلات الخاصّة بجهاز
،"قيادة مستقلّ يُدعى "أنيما"

269
00:20:23,310 --> 00:20:26,850
.وحوّلناها لتقاتل الزّاي

270
00:20:26,850 --> 00:20:28,480
."إنّنا ندعو هذه المقاتلات بـ"البنات

271
00:20:28,870 --> 00:20:31,190
.هذه إحداها

272
00:20:31,190 --> 00:20:34,260
.إنّها مقاتلة سويديّة تُدعى ياس 39

273
00:20:34,760 --> 00:20:35,710
...غريبن

274
00:20:35,710 --> 00:20:41,910
صحيح. إنّها أيضًا المقاتلة الّتي أنقذتك
.خلال عمليّة الإخلاء من شانغهاي

275
00:20:42,460 --> 00:20:45,450
،تمكّنّا من إطلاقها في الجوّ لأوّل مرّة

276
00:20:46,110 --> 00:20:48,100
.لكنّها غير مستقرّة بشكل لا يصدّق

277
00:20:48,100 --> 00:20:51,130
.وكما تعلم، فلقد عانت من تحطّم فظيع

278
00:20:51,980 --> 00:20:53,520
لكن ماذا حدث بعدها؟

279
00:20:53,520 --> 00:20:57,470
،ظهر فتى من العدم وبدأ بالعبث بغطائها

280
00:20:57,470 --> 00:21:00,530
.ثمّ أُعيد تشغيلها فجأة

281
00:21:00,530 --> 00:21:06,290
ثم رأينا ذلك الفتى اليوم
.من خلال كاميراتنا للمراقب

282
00:21:06,290 --> 00:21:09,200
.لذلك قدّمنا عرضًا لها

283
00:21:09,200 --> 00:21:11,320
.كان كافيًا لإعادة تشغيلها

284
00:21:11,320 --> 00:21:13,270
...عندما رأتك

285
00:21:13,780 --> 00:21:15,400
.لا أفهم

286
00:21:15,400 --> 00:21:17,690
.لا تنظر لي. لا أفهم الأمر أيضًا

287
00:21:18,310 --> 00:21:24,390
لكن ما أفهمه هو أنّ تواجدك هنا
.يساعد على توازن الغريبن

288
00:21:28,830 --> 00:21:30,800
.اسمح لي أن أعرّفك بها ثانية

289
00:21:30,800 --> 00:21:33,350
.هذه هي ياس 39 غريبن

290
00:21:35,360 --> 00:21:39,100
هذه هي جهاز قيادة المقاتلة
.المستقلّ، "أنيما" خاصّتها

291
00:21:39,100 --> 00:21:42,340
أريدك أن تجعلها تتمكّن
.من الطّيران بشكل جيّد

292
00:21:43,330 --> 00:21:45,580
هلاّ فعلت هذا

293
00:21:45,580 --> 00:21:49,090
من أجل مستقبل الإنسانيّة أيّها الأمير؟

294
00:23:27,710 --> 00:23:30,110
..."في الحلقة القادمة من "القوّات الجوّيّة الأنثويّة

295
00:23:30,110 --> 00:23:33,060
."الحلقة 02: "موعد كوماتسو

296
00:23:33,790 --> 00:23:37,360
!باربي 01، جاهزة للتّحليق