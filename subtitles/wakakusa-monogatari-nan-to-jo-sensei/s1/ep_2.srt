8
00:01:11,980 --> 00:01:13,930
.أننا ذاهبان لإطعام الأحصنة

9
00:01:14,780 --> 00:01:17,070
.أريد الذهاب معكما

10
00:01:18,480 --> 00:01:20,350
.أمهلاني عشرين ثانية

11
00:01:20,680 --> 00:01:21,290
.واحد

12
00:01:21,600 --> 00:01:22,140
.اثنان

13
00:01:22,570 --> 00:01:23,210
.ثلاثة

14
00:01:26,330 --> 00:01:26,860
.ستة

15
00:01:27,280 --> 00:01:27,800
