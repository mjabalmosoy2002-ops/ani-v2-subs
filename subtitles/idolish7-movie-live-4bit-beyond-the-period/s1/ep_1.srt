1
00:04:28,650 --> 00:04:30,700
!آيدوليش 7

2
00:04:47,440 --> 00:04:51,560
!واحد، اثنان، ثلاثة، أربعة، خمسة، ستّة، سبعة، قفز

3
00:08:32,490 --> 00:08:34,910
جميل للغاية

4
00:08:38,530 --> 00:08:40,630
هذا رائع

5
00:08:41,070 --> 00:08:42,260
!مرحى

6
00:08:45,530 --> 00:08:46,720
!مرحباً جميعاً

7
00:08:46,720 --> 00:08:49,040
"!أهلاً بكم في "بيوند زا بيريود

8
00:08:49,040 --> 00:08:50,020
مرحى

9
00:08:50,020 --> 00:08:53,900
...سنبدأ نحن أوّلاً. استعداد

10
00:08:53,900 --> 00:08:56,010
!نحن آيدوليش 7

11
00:08:59,440 --> 00:09:02,980
إنَّ "بيوند زا بيريود" هو حفل موسيقي خارق وخاصّ

12
00:09:03,460 --> 00:09:09,260
يؤدّيه لكم آيدوليش 7، ري:فالي، تريغر، وزول

13
00:09:09,870 --> 00:09:13,830
لكن هذه رحلة حقيقيّة

14
00:09:13,830 --> 00:09:14,900
أجل

15
00:09:15,300 --> 00:09:20,200
!أجل! خوضوا معنا رحلة

16
00:09:21,310 --> 00:09:26,170
!لنسافر إلى أبعد أصقاع العالم

17
00:09:23,580 --> 00:09:24,300
!أوه

18
00:09:24,920 --> 00:09:26,770
تاماكي

19
00:09:26,770 --> 00:09:32,780
هذا صحيح. سوف نسافر إلى ما وراء
الزمن والفضاء وكلّ ما هو عاديّ

20
00:09:32,780 --> 00:09:37,610
،معاً، لنسافر عبر الأساليب الموسيقيّة الأربعة
والمواسم الأربعة، والعوالم الأربعة

21
00:09:37,980 --> 00:09:38,890
أجل

22
00:09:39,860 --> 00:09:45,090
قلوبنا الستّة عشر وقلوب الجميع هنا اليوم سوف

23
00:09:45,090 --> 00:09:50,000
تسافر عبر الكرة الأرضيّة معاً في
السّفينة الأكثر ترفيهاً في العالم

24
00:09:50,270 --> 00:09:51,750
أجل

25
00:09:51,750 --> 00:09:56,840
سيّداتي سادتي، هل أنتم جاهزون للمغادرة؟

26
00:09:56,840 --> 00:09:59,240
!جاهزون

27
00:09:58,210 --> 00:09:59,240
حسناً

28
00:09:59,240 --> 00:10:01,890
بون فوياج! رحلة موفّقة

29
00:10:01,890 --> 00:10:03,530
!لا أحزمة أمان

30
00:10:03,530 --> 00:10:05,050
!لا جوازات سفر

31
00:10:05,050 --> 00:10:08,970
ما دمنا بأجسامنا وقلوبنا، يمكننا
!الذّهاب إلى أيّ مكان

32
00:10:08,970 --> 00:10:11,310
...فلنبدأ. استعداد، هيّا

33
00:10:11,310 --> 00:10:12,890
!إقلاع

34
00:10:15,680 --> 00:10:20,730
هذه الأغنية التّالية سوف تجوب
!العالم مُسرِعةً على الأغلب أيضاً

35
00:10:20,730 --> 00:10:26,040
بالذّكريات الثّمينة الّتي رافقَتْنا
بينما نسافر عبر الحياة

36
00:10:26,660 --> 00:10:28,120
"!ريستارت بوينتر"

37
00:12:18,310 --> 00:12:19,190
!أوه

38
00:12:18,650 --> 00:12:19,430
شكراً

39
00:12:19,430 --> 00:12:20,610
هل يمكنكم رؤيتنا؟

40
00:12:22,060 --> 00:12:23,690
!شكراً

41
00:12:23,690 --> 00:12:24,570
!أجل

42
00:12:24,570 --> 00:12:25,480
شكراً لكم

43
00:12:26,530 --> 00:12:27,760
!أجل

44
00:12:28,090 --> 00:12:29,790
!تاماكي-كن، كُن حذراً

45
00:12:30,610 --> 00:12:32,990
!مرحى

46
00:12:33,780 --> 00:12:35,790
!هذا الجانب الآن

47
00:13:25,600 --> 00:13:27,680
!ريكّون

48
00:13:27,680 --> 00:13:28,680
!شكراً لكم

49
00:13:28,680 --> 00:13:29,890
شكراً جزيلاً لكم

50
00:13:29,890 --> 00:13:32,660
كيف كانت بداية رحلتكم معنا؟

51
00:13:32,660 --> 00:13:34,600
هل شعرتُم بحنين؟

52
00:13:34,600 --> 00:13:37,420
هل اكتشفتم أيّ شيء جديد؟

53
00:13:37,420 --> 00:13:39,870
الرّحلة بالكاد قد بدأت

54
00:13:39,870 --> 00:13:40,350
أجل

55
00:13:40,350 --> 00:13:44,950
لكن قد تكون المشاهد التّالية مُثيرة بعض الشّيء

56
00:13:46,790 --> 00:13:49,730
!زول! استمتعوا بالحماس

57
00:13:49,730 --> 00:13:51,140
!مرحى

58
00:13:51,140 --> 00:13:52,390
!شكراً لكم

59
00:13:51,290 --> 00:13:52,390
إلى اللّقاء

60
00:13:52,390 --> 00:13:53,660
شكراً لكم

61
00:13:53,660 --> 00:13:55,200
!وداعاً

62
00:13:55,000 --> 00:13:56,100
!شكراً

63
00:13:56,100 --> 00:13:56,870
!مرحى

64
00:13:56,870 --> 00:13:57,570
شكراً لكم

65
00:13:57,570 --> 00:14:00,410
إلى اللّقاء

66
00:14:00,410 --> 00:14:02,000
استمتعوا

67
00:14:02,000 --> 00:14:03,130
!أجل

68
00:14:03,130 --> 00:14:04,110
إلى اللّقاء

69
00:14:06,970 --> 00:14:08,450
!شكراً لكم

70
00:17:04,280 --> 00:17:06,970
!حلبة قوس قزح

71
00:17:10,010 --> 00:17:13,170
هل تستمتعون بـ"بيوند زا بيريود"؟

72
00:17:14,060 --> 00:17:16,660
!لا نستطيع سماعكم. أعلى

73
00:17:16,660 --> 00:17:17,920
!أعلى، هيّا

74
00:17:17,920 --> 00:17:19,330
!أعلى

75
00:17:20,490 --> 00:17:22,170
من نكون؟

76
00:17:22,170 --> 00:17:23,750
!زول

77
00:17:23,750 --> 00:17:25,310
!أعلى حتّى

78
00:17:25,310 --> 00:17:27,620
!زول

79
00:17:27,860 --> 00:17:29,090
شكراً لكم

80
00:17:30,620 --> 00:17:32,090
هل كان ذلك شعوراً جميلاً؟

81
00:17:32,090 --> 00:17:33,760
كان شعوراً رائعاً

82
00:17:33,760 --> 00:17:38,880
سماع النّاس يصيحون "زول" في هذا
!المسرح العظيم بدا مُبهراً

83
00:17:38,880 --> 00:17:42,980
لا ينبغي أن نكون الوحيدين الّذين نستمتع

84
00:17:42,980 --> 00:17:48,100
لا نعلم ما طبيعة السّفر المُبهِج
،الّذي كنتم تستمتعون به

85
00:17:48,100 --> 00:17:50,490
لكنّكم دخلتُم الآن حدودَ زول

86
00:17:50,490 --> 00:17:54,730
نحن أنانيّون جدّاً على العمل كمُضيفين أو كدليل

87
00:17:54,730 --> 00:17:56,690
نحن الضّيوف هنا

88
00:17:56,970 --> 00:18:04,120
يجب أن تأخذونا معكم وتعرضوا لنا المشاهد العظمى

89
00:18:07,030 --> 00:18:09,260
قالوا أنّهم سيفعلونها يا إيسومي-سان

90
00:18:09,260 --> 00:18:10,530
حسناً

91
00:18:11,580 --> 00:18:14,410
جميعكم رقيقون جدّاً مع إيسومي-سان

92
00:18:14,410 --> 00:18:17,000
أنتم من تدلّلونه

93
00:18:17,970 --> 00:18:22,540
"على ذكر الرّحلات، كانت تلك "منطقة التّشابُك

94
00:18:23,030 --> 00:18:27,640
غنّينا أوّلاً تلك الأغنية في مكان بعيد عن هنا

95
00:18:27,640 --> 00:18:30,210
أجل، هذا صحيح

96
00:18:30,210 --> 00:18:32,610
،كنّا متوتّرين جدّاً في ذلك المسرح الهائل

97
00:18:32,610 --> 00:18:34,930
وغنّينا لتفريق شمل أعدائنا

98
00:18:35,870 --> 00:18:38,450
،لكن حالما انتهينا من الغناء بكامل قلوبنا

99
00:18:38,450 --> 00:18:43,610
،لم نرَ أعداءنا في أيّ مكان
فقط أُناساً يرحّبون بنا

100
00:18:44,020 --> 00:18:48,140
"لذلك أدركنا أنّ كلّ هؤلاء "الأعداء
وُجِدوا فقط في داخلنا

101
00:18:49,650 --> 00:18:55,660
وأصواتكم أيقظتنا على ذلك، بما أنّكم
أحببتمونا دوماً على طبيعتنا

102
00:18:56,180 --> 00:18:59,980
!شكراً لكم

103
00:18:57,330 --> 00:18:58,760
!شكراً

104
00:18:59,980 --> 00:19:01,540
شكراً لكم

105
00:19:01,540 --> 00:19:06,250
!واليوم، سوف ننطلق لرؤية مشاهد جديدة معاً

106
00:19:06,250 --> 00:19:08,130
!نحن متحمِّسون جدّاً لذلك

107
00:19:10,070 --> 00:19:12,120
!حسناً، لنواظب على ذلك

108
00:19:12,910 --> 00:19:15,430
انسوا كلّ الهراء غير المهمّ

109
00:19:15,430 --> 00:19:17,540
!سوف نشدّ الرّحال

110
00:19:17,880 --> 00:19:18,480
!هيّا بنا

111
00:19:19,300 --> 00:19:21,900
!ثلاثة، اثنان، واحد

112
00:22:23,210 --> 00:22:24,710
شكراً لكم

113
00:22:24,710 --> 00:22:29,100
أريتمونا مشهداً مُبهراً جدّاً لدرجة
جعلتنا دائخين

114
00:22:29,100 --> 00:22:31,660
!لكن لم يقف القطار في أيّ وقت قريب

115
00:22:32,100 --> 00:22:33,990
تستمرُّ الرّحلة

116
00:22:34,350 --> 00:22:36,340
...خارج النّافذة، نرى

117
00:22:36,340 --> 00:22:37,890
الشّمس تتصاعد

118
00:22:37,890 --> 00:22:40,220
الفجر الأعظم

119
00:22:40,920 --> 00:22:41,830
إلى اللّقاء

120
00:22:45,130 --> 00:22:49,830
!زول

121
00:26:15,420 --> 00:26:17,260
!تريغر

122
00:26:17,260 --> 00:26:19,400
"أهلاً بكم في "بيوند زا بيريود

123
00:26:19,690 --> 00:26:20,850
...نحن

124
00:26:20,850 --> 00:26:22,320
!تريغر

125
00:26:25,240 --> 00:26:29,540
كنّا نخوض معاً رحلة وراء الزّمان والمكان

126
00:26:30,100 --> 00:26:34,180
غاكو، ريو. هل تعرفان معنى تعبير "كوكب المعجزة"؟

127
00:26:34,180 --> 00:26:38,450
أجل. كوكب المعجزة هو الأرض، صحيح؟

128
00:26:38,450 --> 00:26:45,200
أجل. يعني أنّ كوكباً كالأرض قد أُنتِج
بواسطة سلسلة من المُعجزات

129
00:26:45,200 --> 00:26:50,150
أجل. يُقال بأنّ عمر الأرض هو 4.6 مليار سنة

130
00:26:50,510 --> 00:26:54,890
حدثت مُعجزات كثيرة على مدى هذه الفترة الطويلة

131
00:26:55,730 --> 00:27:00,690
اصطدمت أجسام سماويّة وتحطّمت وتكتّلت من جديد

132
00:27:00,690 --> 00:27:05,500
بدأت حيوات وانتهت، ثمّ وُلِدَتْ حيوات جديدة

133
00:27:06,320 --> 00:27:11,060
وبعد كلّ تلك اللّقاءات والافتراقات، نحن نقف هنا الآن

134
00:27:11,060 --> 00:27:11,830
أجل

135
00:27:11,830 --> 00:27:17,920
هل تعرفون التّحدي الجديد الّذي واجهناه في نهاية العام؟

136
00:27:18,340 --> 00:27:21,080
عندما غنّت كلُّ المجموعات الأربع بملء قلوبها

137
00:27:21,420 --> 00:27:23,000
!أجل، رأينا

138
00:27:23,880 --> 00:27:25,770
!شكراً

139
00:27:25,770 --> 00:27:26,970
شكراً لكم

140
00:27:26,970 --> 00:27:30,530
بدت تلك التّجربة إعجازيّة بالنّسبة لنا بنفس الدّرجة

141
00:27:30,530 --> 00:27:36,760
لسنا نحن فقط، بل كلّ النّجوم المشاهير
وأعضاء الطاقم وموظّفي الوكالات

142
00:27:37,080 --> 00:27:42,560
من الصّعب وصف ذلك بكلمات، لكن جميعنا
تأثّرنا بنفس الدّرجة، صحيح؟

143
00:27:42,560 --> 00:27:47,420
أجل. ظللنا نتكلّم حول ذلك بعد انتهاء
تلك الحفلة الهائلة

144
00:27:47,730 --> 00:27:50,880
،حول كيف نرغب في فعل ذلك ثانية بالطبع

145
00:27:51,530 --> 00:27:56,160
وكيف تبدو كلّ هذه اللّقاءات كمُعجزات

146
00:27:56,160 --> 00:28:00,280
"نشير إليكم بالمُجمَل بـ"الجميع

147
00:28:00,590 --> 00:28:03,790
لكن كلّ واحد منكم هو في الواقع شخصٌ فريد

148
00:28:04,520 --> 00:28:08,220
ولو كان كلّ واحد منكم مختلفاً
،عمّا هو عليه الآن

149
00:28:08,740 --> 00:28:12,030
فأشكّ أنّه كان بوسعنا خلق نفس الأجواء

150
00:28:12,030 --> 00:28:17,730
مثلما صنعَتْ سلسلةٌ من المُعجزات الصّغيرة
،الكوكبَ الّذي نعيش فيه

151
00:28:17,730 --> 00:28:24,580
،لو أنّ أيّ شخص حاضر حينها أو الآن مختلفٌ
—لكانت حفلة مُختلفة

152
00:28:25,140 --> 00:28:28,290
لا، بل رحلة مُختلفة

153
00:28:28,690 --> 00:28:31,570
كنّا متأثّرين جدّاً بالفكرة

154
00:28:31,570 --> 00:28:32,450
أجل

155
00:28:32,450 --> 00:28:38,700
بعبارة أخرى، نريد إخبار الجميع... أو بالأحرى إخباركم

156
00:28:39,260 --> 00:28:43,440
شكراً لكم على التّواجد هنا

157
00:28:45,600 --> 00:28:47,190
!شكراً لكم

158
00:28:47,190 --> 00:28:48,450
!تين-كن

159
00:28:48,450 --> 00:28:50,010
شكراً لكم على المجيء لرؤيتنا

160
00:28:50,580 --> 00:28:57,980
سواء كنتم تروننا هنا للمرّة الأولى
،أو كنتم دوماً تراقبوننا

161
00:28:58,370 --> 00:29:02,810
فنحن وأولئك المُحيطون بكم يبتسمون لأنّكم هنا

162
00:29:03,560 --> 00:29:05,540
!تسوناشي-سان

163
00:29:06,470 --> 00:29:08,000
أليس هذا مذهلاً؟

164
00:29:08,000 --> 00:29:11,320
نحن مُتّصلون بمُعجزة لا توجد
إلّا في هذه اللّحظة فقط

165
00:29:11,320 --> 00:29:12,740
ليس تريغر فقط

166
00:29:13,130 --> 00:29:17,590
وليس آيدوليش 7 أو ري:فالي أو زول فقط أيضاً

167
00:29:18,390 --> 00:29:22,760
!لنحتفل بالطريقة الّتي نستطيع مع الجميع هنا

168
00:29:23,170 --> 00:29:25,260
!غاكو

169
00:29:25,260 --> 00:29:27,690
هذه ليست حفلة. إنّها رحلة

170
00:29:27,690 --> 00:29:30,410
إنّهما نفس الأمر. كلاهما احتفال

171
00:29:30,410 --> 00:29:32,290
يروقني هذا

172
00:29:32,650 --> 00:29:35,430
الحفلات الموسيقيّة هي احتفالات بالتّأكيد أيضاً

173
00:29:35,430 --> 00:29:40,700
الاحتفالات مقبولة، لكن ماذا عن هذه
الأغنية المُبهِجة؟

174
00:29:41,070 --> 00:29:45,550
إنّها حول ملاك وشيطان يتشاجران على إنسان

175
00:29:48,300 --> 00:29:49,570
"البُعد الأخير"

176
00:32:37,270 --> 00:32:39,200
!تريغر

177
00:32:41,950 --> 00:32:43,280
!شكراً لكم

178
00:32:43,280 --> 00:32:45,330
!استمتعوا ببقيّة رحلتكم

179
00:32:46,260 --> 00:32:48,960
لنعرّفكم على آخر شركائكم المُسافرين

180
00:32:49,370 --> 00:32:50,420
!ري:فالي

181
00:32:55,030 --> 00:32:56,300
!تريغر

182
00:36:22,230 --> 00:36:24,720
!مومو-كن

183
00:36:25,070 --> 00:36:25,770
!مومو

184
00:36:25,770 --> 00:36:29,590
...أهلاً بالجميع! استعداد، هيّا

185
00:36:29,590 --> 00:36:31,530
!نحن ري:فالي

186
00:36:33,210 --> 00:36:36,010
ألم تكن هذه رحلة ممتعة يا يوكي؟

187
00:36:36,010 --> 00:36:37,810
الأفضل

188
00:36:37,810 --> 00:36:42,120
!لم نركب للتو. كنّا معكم هنا منذ البداية

189
00:36:42,120 --> 00:36:44,000
!كانت قلوبنا معكم طوال الوقت

190
00:36:44,350 --> 00:36:48,650
أجل، جالسين هناك بين الجمهور

191
00:36:48,650 --> 00:36:50,480
!أجل، قلوبنا

192
00:36:50,480 --> 00:36:52,310
القلوب لا تجلس

193
00:36:53,020 --> 00:36:54,560
لا نتكلّم عن أجساد؟

194
00:36:54,560 --> 00:36:56,450
