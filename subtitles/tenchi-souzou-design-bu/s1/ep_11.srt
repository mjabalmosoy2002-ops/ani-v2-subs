1
00:00:01,110 --> 00:00:04,640
هذا الشعور... أأنت تسوتشيا-سان؟

2
00:00:04,860 --> 00:00:05,930
أصبحتَ شاباً؟

3
00:00:05,930 --> 00:00:07,100
ماذا؟

4
00:00:07,310 --> 00:00:10,760
!ربما قذفهم الانفجار إلى غالاباغوس جميعاً

5
00:01:45,330 --> 00:01:48,860
يا رفاق! أأنتم بخير؟

6
00:01:53,540 --> 00:01:56,630
أصبحت هيغوتشي-سان وعضو
!قسم الحشرات طفلين

7
00:01:56,630 --> 00:01:58,340
صغيران جدّاً

8
00:01:58,340 --> 00:02:02,500
يبدو أنّنا صغرنا عمراً عندما
انفجر المسرّع الزمني

9
00:02:02,500 --> 00:02:04,130
أحصل هذا للبقيّة أيضاً إذاً؟

10
00:02:04,490 --> 00:02:08,260
ما هو ضبط غالاباغوس الحاليّ؟

11
00:02:08,260 --> 00:02:13,950
حسناً، كانت ميدو-تشان تختبر البيرانا
بعد قبولها، لذا هي غابة

12
00:02:15,080 --> 00:02:17,820
أي أنّهم منتشرون في هذه الغابة أطفالاً؟

13
00:02:17,820 --> 00:02:20,820
!مـ-مصيبة! علينا إيجادهم سريعاً

14
00:02:21,340 --> 00:02:22,910
انتظر يا شيمودا-كن

15
00:02:22,910 --> 00:02:25,650
غالاباغوس تعجّ بالمخاطر الآن

16
00:02:27,520 --> 00:02:30,660
يُستحسن بنا التفكير بخطّة قبل
الإقدام على خطوة بعميان

17
00:02:30,660 --> 00:02:32,200
خطّة؟

18
00:02:32,510 --> 00:02:38,080
بالمناسبة، أظنّ كيمورا-كن قد احتفظ ببعض كعك
معجون الفاصولياء الذي جلبتَه في جيبه

19
00:02:38,290 --> 00:02:44,530
،إذا تراجع زمن كلّ ما علق في الانفجار
فلربما انطبق ذلك على الكعك أيضاً

20
00:02:44,530 --> 00:02:48,310
ولو حصل ذلك، كيف سيفيدنا العجين؟

21
00:02:48,310 --> 00:02:50,420
كلا، قبل ذلك حتّى

22
00:02:50,420 --> 00:02:53,650
ينتج معجون الفاصولياء البيضاء من حبوب الليما، أليس كذلك؟

23
00:02:54,340 --> 00:02:56,800
عندما تتعرّض حبوب الليما لهجومٍ
من قبل عدوّها الطبيعيّ

24
00:02:56,800 --> 00:02:59,450
تصدر رائحةً تطلب فيها النجدة، صحيح؟

25
00:02:59,450 --> 00:03:03,170
ألم يصنع قسم الحشرات حشرةً
بإمكانها تحديد تلك الرائحة؟

26
00:03:03,170 --> 00:03:05,330
!بلى، من المبهر معرفتك لذلك

27
00:03:05,670 --> 00:03:08,870
صنعنا حشرةً آكلةً للحوم تحبّ آكل الحشرة آكلة الأعشاب

28
00:03:08,870 --> 00:03:11,630
التي تأكل أوراق فاصولياء الليما

29
00:03:11,630 --> 00:03:13,450
عندما تلاحظ هذه الحشرة رسالة
طلب النجدة من الليما

30
00:03:13,450 --> 00:03:15,830
تهرع إلى النبتة وتأكل الحشرة التي
!تلتهم حبوب الليما

31
00:03:16,480 --> 00:03:18,480
!تبدو لذيذة

32
00:03:18,910 --> 00:03:20,320
!النجدة

33
00:03:20,320 --> 00:03:22,330
!أنا أؤكل

34
00:03:23,020 --> 00:03:24,840
...هذا الصوت

35
00:03:24,990 --> 00:03:27,130
!مرحى! طعام

36
00:03:27,580 --> 00:03:29,830
!نويت الأكل، لكنّي سأؤكل

37
00:03:30,310 --> 00:03:31,860
!وفق الخطّة

38
00:03:31,860 --> 00:03:34,700
تبدو كمسرحيّة انتقام متشابكة

39
00:03:34,700 --> 00:03:36,270
إنّه سوسٌ بالمناسبة

40
00:03:37,480 --> 00:03:40,530
سنصنع جهاز استشعار يستغلّ
حسّاس السوس هذا

41
00:03:40,530 --> 00:03:41,480
!أجل

42
00:03:41,710 --> 00:03:46,130
لكنّ إشارة طلب النجدة لن تصدر إلّا
إذا كانت الفاصولياء تؤكل، أليس كذلك؟

43
00:03:46,130 --> 00:03:48,460
لا أتوقّع أنّ كيمورا-سان سيأكل حبوب النبتة

44
00:03:48,460 --> 00:03:51,010
لمجرّد أنّ كعك معجون الفاصولياء تحوّل إليها

45
00:03:51,220 --> 00:03:52,480
أظنّه سيفعل

46
00:03:52,480 --> 00:03:53,670
بلمح البصر

47
00:03:53,910 --> 00:03:57,520
أيمكن أكل هذا؟ عندما تشعر بالحيرة
!فهو الوقت المناسب للأكل

48
00:03:57,520 --> 00:03:58,870
سيأكلها بالفعل

49
00:03:59,260 --> 00:04:01,640
!انتهينا من جهاز استشعار أكل الفاصولياء

50
00:04:01,640 --> 00:04:02,850
!سريع

51
00:04:04,080 --> 00:04:05,220
!تقول أنّها هناك

52
00:04:05,220 --> 00:04:06,650
يأكلها بالفعل؟

53
00:04:06,650 --> 00:04:10,270
لترجعي يا هيغوتشي-كن وتصلحي
جهاز مسرّع الزمن

54
00:04:10,270 --> 00:04:11,100
حسناً

55
00:04:19,190 --> 00:04:20,640
!يا رفاق

56
00:04:20,890 --> 00:04:22,280
كيمورا-كن

57
00:04:22,280 --> 00:04:23,900
كان يأكلها حقّاً

58
00:04:23,900 --> 00:04:25,910
!أنت يافعٌ أيّها الرئيس

59
00:04:25,910 --> 00:04:27,720
ينطبق ذلك عليك

60
00:04:27,720 --> 00:04:29,770
أتينا لإنقاذكم، أين البقيّة؟

61
00:04:30,100 --> 00:04:34,430
،علقتُ في هذه الشجرة
لكن قُذف البقيّة إلى هناك

62
00:04:34,750 --> 00:04:37,190
أسمع صوت ماء، فقد يكونون في البركة

63
00:04:37,190 --> 00:04:38,160
بركة؟

64
00:04:38,380 --> 00:04:41,200
لعلّها بركة اختبار البيرانا

65
00:04:41,200 --> 00:04:42,680
!علينا الإسراع

66
00:04:47,310 --> 00:04:49,840
...ميدو-تشان، هذه البركة

67
00:04:49,840 --> 00:04:51,890
ملأتها بالبيرانا

68
00:04:51,890 --> 00:04:54,250
!كلا! ستهاجمنا

69
00:04:54,250 --> 00:04:56,400
...انتبهوا! إذا تحرّكتم

70
00:05:00,280 --> 00:05:01,970
أسمع صوت أطفال

71
00:05:01,970 --> 00:05:03,020
!هناك

72
00:05:05,840 --> 00:05:08,110
مـ-ميدو-تشان، أأنتِ بخير؟

73
00:05:08,420 --> 00:05:09,480
أجل

74
00:05:09,480 --> 00:05:12,320
!فهذه البيرانا نباتيّة

75
00:05:12,920 --> 00:05:15,020
بيرانا نباتيّة؟

76
00:05:15,020 --> 00:05:19,100
أجل، بما أنّها تشبه البيرانا
آكلة اللحوم الشرسة

77
00:05:19,100 --> 00:05:21,660
فنسبة تعرّضها للهجوم من قِبل
الأسماك الأخرى ضعيفة

78
00:05:21,660 --> 00:05:25,640
ماذا؟ توجد آثار عضّ بيرانا آكلة للحوم
على هذه الزعنفة

79
00:05:26,740 --> 00:05:29,040
!توجد آكلة للحوم هنا إذاً

80
00:05:29,040 --> 00:05:33,150
لا بأس، من الشائع ألّا تقتل
البيرانا آكلة اللحوم فريستها

81
00:05:33,150 --> 00:05:35,560
وتكتفي بأكل جزءٍ من الزعنفة

82
00:05:35,560 --> 00:05:37,630
فهذا لأنّ الزعنفة تتجدد

83
00:05:37,630 --> 00:05:41,130
البيرانا مخلوقات تهتمّ بالمصادر

84
00:05:41,130 --> 00:05:42,310
...هكذا إذاً

85
00:05:42,540 --> 00:05:46,260
،لذا إذا لم يكن بك جزء يرفرف
فلن تقضمك كثيراً

86
00:05:46,260 --> 00:05:47,860
يرفرف؟

87
00:05:48,430 --> 00:05:50,570
علينا الخروج من هنا سريعاً

88
00:05:50,820 --> 00:05:53,200
لنصعد على هذه الورقة بأيّ حال

89
00:05:53,740 --> 00:05:55,730
من الحسن أنّنا أطفال

90
00:05:55,730 --> 00:05:58,040
لم نكن لنستطيع الصعود بأجسادنا البالغة

91
00:05:58,490 --> 00:06:01,870
،لا تسعى البيرانا للهجوم بالتحديد

92
00:06:01,870 --> 00:06:04,350
لكن تجنّبوا طرطشة الماء من باب الحذر

93
00:06:04,350 --> 00:06:06,550
كين-تشان، ما الذي معك؟

94
00:06:07,460 --> 00:06:08,530
...هذا

95
00:06:09,490 --> 00:06:12,970
!أخبرتك للتوّ ألّا تطرطش الماء

96
00:06:12,970 --> 00:06:13,710
آسف

97
00:06:13,710 --> 00:06:15,320
توخّ الحذر

98
00:06:15,320 --> 00:06:17,170
أنا آسفٌ حقّاً يا رفاق

99
00:06:17,780 --> 00:06:21,720
نسيتُ أنّي أضفت عدوّ البيرانا الطبيعيّ
للمساعدة في الاختبار

100
00:06:22,120 --> 00:06:24,610
التماسيح تحديداً

101
00:06:25,740 --> 00:06:27,730
!لمَ فعلت ذلك؟

102
00:06:34,880 --> 00:06:37,000
!تعالا هنا بسرعة

103
00:06:39,520 --> 00:06:41,500
قد تكون هذه نهايتنا

104
00:06:44,240 --> 00:06:45,750
...تـ-تبّاً لك

105
00:06:46,060 --> 00:06:49,560
!فلتأكل هذه وحسب

106
00:06:54,240 --> 00:06:56,040
!رمية جميلة

107
00:06:56,040 --> 00:06:58,820
!انظروا! هناك تأثير

108
00:06:58,820 --> 00:07:00,150
ما كانت تلك؟

109
00:07:00,380 --> 00:07:03,220
هذه جذور البفرة، مصدر التابيوكا

110
00:07:03,220 --> 00:07:05,940
تراجع زمن التابيوكا في شاي الفقاعات
الذي كنت أشربه

111
00:07:05,940 --> 00:07:07,900
عندما كنّا نأكل كعك شيمودا-كن

112
00:07:08,130 --> 00:07:11,480
قبل معالجتها، تحوي جذور البفرة مركّباً سيانيداً

113
00:07:11,680 --> 00:07:14,360
!إنّه سمّ عصبيّ مثل سيانيد البوتاسيوم

114
00:07:14,360 --> 00:07:16,790
!كلي هذه التابيوكا

115
00:07:20,080 --> 00:07:23,340
!تصويب جميل! أغرقتِ الكثير

116
00:07:23,340 --> 00:07:26,330
لكن نفدت جذور البفرة

117
00:07:26,570 --> 00:07:28,700
!لا يزال هناك الكثير منها

118
00:07:28,700 --> 00:07:32,720
!ميزوشيما، أليست تماسيحك؟ فلتفعل شيئاً

119
00:07:32,720 --> 00:07:34,710
سأقوم دون أن تخبريني

120
00:07:35,080 --> 00:07:39,490
التماسيح مخلوقات عالية الاجتماعيّة تتواصل لفظياً

121
00:07:39,490 --> 00:07:42,240
!لذا سأبكي الآن

122
00:07:47,180 --> 00:07:48,310
ما هذا؟

123
00:07:48,310 --> 00:07:50,660
إنّه صوت لطرد التماسيح

124
00:07:50,660 --> 00:07:52,050
لا صوت كذلك

125
00:07:53,130 --> 00:07:55,730
إنّه صوت صغير التمساح عندما ينادي على أمّه

126
00:08:01,490 --> 00:08:03,160
أحدها متّجه نحونا

127
00:08:03,160 --> 00:08:05,080
من استجابت هي أنثى

128
00:08:05,080 --> 00:08:07,240
ما الذي سيفيدنا استدعائها به؟

129
00:08:07,480 --> 00:08:10,240
...ستقترب الأنثى، وعندها

130
00:08:10,530 --> 00:08:13,610
أنت، ما الذي تريده من زوجتي؟

131
00:08:13,610 --> 00:08:16,270
ما الذي تتكلّم عنه يا أحمق؟

132
00:08:16,510 --> 00:08:19,280
!إيّاك أن تمسّ زوجتي

133
00:08:19,750 --> 00:08:21,970
!سأقتلكم جميعاً

134
00:08:21,970 --> 00:08:23,650
!مؤلم... ما مشكلتك؟

135
00:08:23,800 --> 00:08:26,700
!التمساح الزوج يطرد البقيّة

136
00:08:26,700 --> 00:08:28,650
!إنّه صراعٌ كبير

137
00:08:28,840 --> 00:08:30,650
!انتظروا! انتظروا مكانكم

138
00:08:30,650 --> 00:08:32,660
حسناً، ذهبوا بعيداً

139
00:08:32,660 --> 00:08:36,770
!انتظر، لا تزال واحدة هنا! تلك الأنثى

140
00:08:36,770 --> 00:08:39,180
:إنّها تحدّق لنا بنظرة

141
00:08:39,180 --> 00:08:41,520
"ستكونون طعاماً ممتازاً لصغاري"

142
00:08:41,520 --> 00:08:44,530
لا تقلقوا، يمكننا تدبّر الأمر
إذا كانت واحدةً فحسب

143
00:08:45,390 --> 00:08:50,660
،لم أرد صنع هذا لو بيدي
لكن لا خيار آخر

144
00:08:53,460 --> 00:08:56,860
وداعاً يا قضاعتي الظريفة

145
00:08:58,370 --> 00:09:01,170
!هذا الطلب الذي أعمل عليه الآن

146
00:09:03,460 --> 00:09:06,140
"قضاعة ليست ظريفة البتّة"

147
00:09:08,760 --> 00:09:10,150
!رسالة إلهية

148
00:09:10,330 --> 00:09:12,340
!مقبول

149
00:09:15,500 --> 00:09:18,270
!شيمودا-كن! هنا

150
00:09:18,560 --> 00:09:20,870
!هنا! هنا

151
00:09:20,870 --> 00:09:22,350
!رفاق

152
00:09:24,020 --> 00:09:28,270
يا إلهي، أنا ممتنّ لأنّ أحداً لم يتأذ

153
00:09:31,170 --> 00:09:33,200
...كان ظريفاً

154
00:09:33,200 --> 00:09:35,050
إنّه كبيرٌ ومخيف الآن

155
00:09:35,280 --> 00:09:38,300
ساعدنا قسم الحشرات أيضاً، صحيح؟
شكراً لكم

156
00:09:38,300 --> 00:09:40,300
حللنا كلّ شيءٍ بأنفسنا مع ذلك

157
00:09:40,300 --> 00:09:44,420
،هرعنا نحو المكان الذي سمعنا منه الصرخات
لكنّكم كنتم مذهلين حقّاً

158
00:09:44,660 --> 00:09:47,300
خطرت لي فكرة ممتازة بفضل ذلك

159
00:09:47,300 --> 00:09:50,050
ما رأيكم بحشرة تصرخ لطلب المساعدة؟

160
00:09:50,340 --> 00:09:54,500
تفرز عسلاً، وتكون على وفاق مع النمل عادةً

161
00:09:54,500 --> 00:09:56,210
يمكنك شرب عسلي

162
00:09:56,210 --> 00:09:57,320
!رائع

163
00:09:57,540 --> 00:09:59,750
!يرقانة! وقت الأكل

164
00:09:59,750 --> 00:10:01,520
...وعندما تكون على وشك التعرّض للهجوم

165
00:10:03,310 --> 00:10:04,910
!صديق العسل في مأزق

166
00:10:04,910 --> 00:10:06,200
!لنذهب لنجدته

167
00:10:06,200 --> 00:10:09,050
ماذا؟ استوحيت هذا منّا؟

168
00:10:09,880 --> 00:10:11,200
!رسالة إلهية

169
00:10:11,200 --> 00:10:13,280
!مقبول

170
00:10:13,710 --> 00:10:15,330
!مرحى

171
00:10:15,330 --> 00:10:17,930
!سأرجع لقسم الحشرات وأصنعها فوراً

172
00:10:17,930 --> 00:10:19,340
بالتوفيق

173
00:10:19,550 --> 00:10:22,650
أصلحنا المسرّع الزمني، وعاد الوضع لطبيعته

174
00:10:22,650 --> 00:10:25,060
أنا مسرورٌ لسلامة الجميع

175
00:10:25,060 --> 00:10:29,950
لا بأس بالشباب من حينٍ لآخر، لكنّي لا أشعر
بالراحة إلا في جسدي الحالي

176
00:10:30,850 --> 00:10:33,530
بالمناسبة، ما الذي حلّ بذاك الماعز العالق؟

177
00:10:33,770 --> 00:10:35,290
اختفت الدائرة السحريّة أيضاً

178
00:10:35,290 --> 00:10:37,290
يبدو أنّه أُرسل للجحيم بسلام

179
00:10:37,290 --> 00:10:38,720
يسرّني ذلك

180
00:10:44,090 --> 00:10:46,140
!العينة من فريق التصميم

181
00:10:46,140 --> 00:10:47,030
ماذا؟

182
00:10:48,910 --> 00:10:53,220
لمَ جسدها طويلٌ هكذا؟

183
00:10:55,230 --> 00:10:58,280
...أهو خطأٌ في الإرسال؟ أم

184
00:10:58,840 --> 00:11:01,830
!الدليل المصوّر للمخلوقات التي توجد حقّاً

185
00:11:03,370 --> 00:11:07,450
لطالما كانت صورتي عنها أنّها تهاجم
في أسراب، لكن أتقولين أنّها جبانة؟

186
00:11:07,450 --> 00:11:10,060
أجل، تشكّل أسراباً لأنّها جبانة

187
00:11:10,060 --> 00:11:13,750
إذا سقط شيءٌ كبير في الماء، تهرب معظم الوقت

188
00:11:13,750 --> 00:11:16,670
معظم الوقت؟ أي أنّها تهاجم أحياناً؟

189
00:11:16,670 --> 00:11:20,840
إذا كانت الفريسة مصابة، قد تثيرها رائحة الدمّ فتهاجم

190
00:11:20,840 --> 00:11:22,550
!تهاجم بالفعل إذاً

191
00:11:22,550 --> 00:11:27,200
إنّها معروفة بعضّها فقط، لكن هناك
شيءٌ أريدكم أن تعرفوه

192
00:11:27,990 --> 00:11:29,700
!يمكن للبيرانا الكلام

193
00:11:30,020 --> 00:11:31,690
الكلام؟ كيف؟

194
00:11:31,690 --> 00:11:33,940
تستعمل مثانة السباحة لإصدار الصوت

195
00:11:33,940 --> 00:11:35,560
"صوت مثل "بوف

196
00:11:35,560 --> 00:11:37,820
،أظنّها ستصدره عندما تمسك بها
أتريد أن تجرّب؟

197
00:11:38,980 --> 00:11:42,340
أريد أن أعرف لمَ تصدر ذاك الصوت
قبل أن أفعل

198
00:11:42,600 --> 00:11:44,100
لتحذيرك أنّها ستعضّ

199
00:11:44,100 --> 00:11:45,790
!كان كلّه عن العضّ بالفعل

200
00:11:54,850 --> 00:11:58,370
لا تسنح لنا فرص كثيرة لوضع
مساحيق تجميل زاهية كهذه

201
00:11:58,370 --> 00:11:59,860
الأمر مسلٍّ نوعاً ما

202
00:12:00,400 --> 00:12:02,250
حسناً، اكتملت التجهيزات

203
00:12:09,450 --> 00:12:10,490
ما الخطب؟

204
00:12:10,490 --> 00:12:14,150
يقول أونابارا-سان أنّه لن يحضر
حفلة اليوم في الجحيم

205
00:12:14,150 --> 00:12:15,960
ماذا؟ لن تأتي؟

206
00:12:15,960 --> 00:12:19,460
أخبرتُهم أنّنا سنأتي جميعاً سلفاً

207
00:12:19,670 --> 00:12:20,830
ما الأمر؟

208
00:12:20,830 --> 00:12:24,340
في الواقع، أعاني انخفاضاً

209
00:12:24,970 --> 00:12:29,220
لا أحقّق أيّ تقدّم في طلب
"حيوان زغبيّ لكن شائك"

210
00:12:29,580 --> 00:12:32,360
وكلّما استعجلت، كلّما كثرت أخطائي

211
00:12:32,360 --> 00:12:35,360
لم أعد أملك رغبةً بحمل قلم حتّى

212
00:12:35,630 --> 00:12:37,540
لكن عليّ فعل شيء

213
00:12:37,540 --> 00:12:39,310
لذا لا أستطيع مرافقتكم

214
00:12:39,310 --> 00:12:41,120
طلب غامض آخر؟

215
00:12:41,350 --> 00:12:42,940
أتعاطف معك

216
00:12:42,940 --> 00:12:45,950
لمَ لا تقول أنّك تشعر بتوعّك
وتطلب تمديد موعد التسليم؟

217
00:12:45,950 --> 00:12:47,120
يمكنك هكذا حضور الحفلة

218
00:12:47,120 --> 00:12:50,450
سمعتُ أنّ الجحيم خارج نطاق استقبال السماء

219
00:12:51,370 --> 00:12:53,240
عليك الترويح عن نفسك أحياناً

220
00:12:53,240 --> 00:12:56,900
شيمودا-كن، فلتنقل أنّ طلب
أونابارا-سان سيتأخّر

221
00:12:56,900 --> 00:12:58,680
لتوعّك حالته، وبالغ في التعذّر

222
00:12:58,680 --> 00:13:00,370
أ-أذلك مقبول؟

223
00:13:00,540 --> 00:13:03,390
انخفاض المستوى نوعٌ من التوعّك، أليس كذلك؟

224
00:13:03,390 --> 00:13:04,750
لا أرى بأساً

225
00:13:05,180 --> 00:13:06,630
لنذهب إذاً

226
00:13:06,630 --> 00:13:08,540
!انطلاق

227
00:13:21,900 --> 00:13:23,390
مرحباً بكم للجحيم

228
00:13:23,800 --> 00:13:26,300
أرحّب بكم بصرخات البهجة

229
00:13:26,920 --> 00:13:32,780
لنبدأ الآن مأدبة الاحتفال بتأسّس
فريق مبيعات الجحيم

230
00:13:32,970 --> 00:13:36,050
ستتذوّقون طعم الجحيم الحقيقيّ

231
00:13:36,620 --> 00:13:39,040
!حوّلوا هذا للحمكم ودمكم

232
00:13:39,230 --> 00:13:42,040
هذا ما يقوله طاهي شركتنا

233
00:13:42,410 --> 00:13:46,040
فلتستمتعوا بكلّ شيء
حتّى تتجاوزوا التخمة رجاءً

234
00:13:46,320 --> 00:13:48,250
...دون أن يبدو هذا تقليدياً، لكن

235
00:13:48,250 --> 00:13:49,800
!إنّها مأدبة استضافة

236
00:13:50,020 --> 00:13:51,800
!نخبكم

237
00:13:52,030 --> 00:13:55,000
لم يكن عليك فعل هذا لأجلنا فحسب

238
00:13:55,000 --> 00:13:57,430
لا بأس، كما أنّنا سنلجأ لخدماتكم قدماً

239
00:13:59,250 --> 00:14:01,300
هذا مدخل الجحيم إذاً

240
00:14:01,300 --> 00:14:02,770
مبهرجٌ أكثر من مدخلنا

241
00:14:03,100 --> 00:14:05,700
جلبنا هدايا للاحتفال

242
00:14:06,830 --> 00:14:08,940
شكراً على مراعاتكم

243
00:14:09,550 --> 00:14:12,900
ظننا أنّ أشياء كهذه ستنال
إعجابك يا يوكوتا-سان

244
00:14:13,800 --> 00:14:16,940
!ما هذا؟ إنّه أشبه برمزٍ للدمار

245
00:14:16,940 --> 00:14:19,190
!رائعٌ جدّاً

246
00:14:19,190 --> 00:14:21,950
يسرّني أنّه استهواك

247
00:14:22,300 --> 00:14:23,540
هذه هديّتي

248
00:14:25,720 --> 00:14:27,120
!هيكل أفعى عظميّ

249
00:14:27,120 --> 00:14:28,220
!رائع

250
00:14:28,220 --> 00:14:31,810
مذهل، كلّ شيءٍ أسفل الرأس فقري، أليس كذلك؟

251
00:14:31,980 --> 00:14:35,690
في الواقع، يوجد عنقٌ وذيل رغم
أنّهما لا يبرزان كثيراً

252
00:14:35,690 --> 00:14:37,760
عنق الأفعى قصيرٌ لحدٍّ مفاجئ

253
00:14:38,030 --> 00:14:41,370
جلبتُ معي جمجمة دجاجة عملاقة

254
00:14:41,370 --> 00:14:43,140
!رائعة جدّاً

255
00:14:43,450 --> 00:14:45,230
يمكنك ارتداؤها

256
00:14:46,630 --> 00:14:48,230
ما-ما رأيكم؟

257
00:14:48,230 --> 00:14:50,710
هل أبدو كأمير الجنون؟

258
00:14:50,710 --> 00:14:52,740
!تبدو جميلةً عليك، رائع

259
00:14:52,740 --> 00:14:56,160
الحلقة عند العين... أهي عظم؟

260
00:14:56,160 --> 00:15:00,630
للدجاج عظام تحافظ على شكل أعينها

261
00:15:01,130 --> 00:15:02,650
هذه هديّتي

262
00:15:02,990 --> 00:15:04,910
صندوق مستطيل آخر

263
00:15:04,910 --> 00:15:07,020
أعرف هذا

264
00:15:07,020 --> 00:15:08,580
!إنّه آكل نمل

265
00:15:08,580 --> 00:15:09,890
!صحيح

266
00:15:10,340 --> 00:15:13,050
!العظم ممتدّ حتّى طرف فمه

267
00:15:13,380 --> 00:15:15,280
...وأنا جلبتُ هذا

268
00:15:15,280 --> 00:15:16,560
إنّه حصان، صحيح؟

269
00:15:16,560 --> 00:15:17,750
أجل، لمَ؟

270
00:15:17,750 --> 00:15:20,630
بالمناسبة، أتظنّه ذكراً أم أنثى؟

271
00:15:20,630 --> 00:15:22,390
أليس السؤال صعباً؟

272
00:15:22,390 --> 00:15:24,490
الأمر بسيطٌ في الواقع

273
00:15:24,490 --> 00:15:26,980
من يمتلك أسناناً حادّة هنا هو الذكر

274
00:15:26,980 --> 00:15:30,500
يملك أنياباً لمساعدته على القتال
عندما يحاول الفوز بالأنثى

275
00:15:30,500 --> 00:15:32,410
الأحصنة قويّة لحدٍّ مفاجئ

276
00:15:33,720 --> 00:15:35,320
وهذه هديّتي

277
00:15:35,320 --> 00:15:36,410
!كبيرة

278
00:15:38,270 --> 00:15:40,290
...إ-إنّه

279
00:15:40,840 --> 00:15:43,540
!عملاق أحاديّ العين

280
00:15:43,540 --> 00:15:45,080
!رائعٌ جدّاً

281
00:15:45,640 --> 00:15:47,930
كلا، هذا فيل

282
00:15:48,690 --> 00:15:52,430
الفجوة في المنتصف ليست لمقلة العين، بل للأنف

283
00:15:52,430 --> 00:15:53,520
العين هنا

284
00:15:54,810 --> 00:15:57,050
أنا الأخيرة

285
00:15:57,410 --> 00:15:59,400
!خمّن ما هذا

286
00:16:01,090 --> 00:16:03,490
لا فكرة لديّ، أينما نظرت إليه

287
00:16:03,490 --> 00:16:05,930
كأنّه قماش مطويّ

288
00:16:05,930 --> 00:16:09,940
الإجابة هي جمجمة القرش المطرقة

289
00:16:09,940 --> 00:16:12,820
يملك عظاماً إلى أطراف رأسه إذاً

290
00:16:13,090 --> 00:16:16,630
من المسلّي التفكير بالحيوانات
من خلال النظر إلى عظامها

291
00:16:16,630 --> 00:16:19,670
أيمكنني أن أطلب منكم البدء
من العظام في العمل التالي؟

292
00:16:19,670 --> 00:16:21,070
العمل التالي؟

293
00:16:21,070 --> 00:16:25,550
أجل، بعدما سلّمتم ذاك الشيطان العملاق

294
00:16:25,550 --> 00:16:28,710
أردتُ أن أطلب منكم صنع
أليف مرسول صغير

295
00:16:29,610 --> 00:16:30,960
شيء كهذا

296
00:16:31,170 --> 00:16:34,140
يمكننا البدء بطرح الأفكار الآن إذا أردت

297
00:16:34,730 --> 00:16:36,730
في يوم عطلتكم، أأنت متأكّد؟

298
00:16:36,730 --> 00:16:40,050
من المسلّي التفكير نزوةً أحياناً

299
00:16:40,050 --> 00:16:42,930
كلّما بدا أقلّ كعمل، كان أكثر متعة

300
00:16:42,930 --> 00:16:43,970
أتفق

301
00:16:44,200 --> 00:16:48,620
أيمكنك إخبارنا بوظائف ومغزى
هذا الأليف إذاً؟

302
00:16:48,620 --> 00:16:50,370
سيكون مكان العمل تحت الأرض

303
00:16:50,370 --> 00:16:52,030
،بما أنّه سيكون مرسولاً

304
00:16:52,030 --> 00:16:54,130
يُفترض أن يملك حسّ سمع حاد، وسريع الحركة

305
00:16:54,130 --> 00:16:57,730
أفضّل أن يكون قادراً على التواصل
بطريقة فريدة دون صوت

306
00:16:58,160 --> 00:17:02,510
ستكون هنالك رسائل عمل كثيرة
لا نريد أن يسمع بها ضيوفنا

307
00:17:02,510 --> 00:17:07,070
أجل، بسرعة البرق! وعندما يتوقّف، يُفترض أن
!يكون كضباب الليل

308
00:17:07,070 --> 00:17:08,880
شيء كهذا سيكون مثالياً

309
00:17:08,880 --> 00:17:11,270
أسلوب فريد في التعبير
عن نفسه كالعادة

310
00:17:11,940 --> 00:17:17,130
وأيضاً، قد نتلقّى شكاوى إذا
استراح أمام الضيوف

311
00:17:17,360 --> 00:17:21,170
لذا سيكون من الحسن ألّا يظهر بسهولة
ما إن كان نائماً أو مستيقظاً من أول وهلة

312
00:17:21,170 --> 00:17:24,280
يحاولون تفادي شكاوي الزبائن حتّى في الجحيم

313
00:17:24,280 --> 00:17:27,780
في تلك الحالة، علينا التفكير بقضائه لحاجته أيضاً

314
00:17:27,780 --> 00:17:30,650
لم أفكّر بذلك

315
00:17:30,650 --> 00:17:34,200
سيُحلّ الأمر إذا أكل البراز الذي يخرجه من فوره

316
00:17:35,000 --> 00:17:37,470
ألستِ تتمادين قليلاً؟

317
00:17:37,470 --> 00:17:40,790
ليس أمراً غريباً، فالكوالا تأكل البراز أيضاً

318
00:17:42,180 --> 00:17:44,540
للكوالا صنفين من البراز

319
00:17:44,540 --> 00:17:47,230
الفضلات غير القابلة للهضم
ليست للأكل

320
00:17:47,230 --> 00:17:50,820
بينما تكون هذه الأشياء الشبيهة بالدواء
التي يصدرها المصران للأكل

321
00:17:50,820 --> 00:17:53,780
براز الكوالا القابل للأكل صحيّ

322
00:17:53,780 --> 00:17:56,110
لذا طعام صغيرها بعد الفطم هو البراز

323
00:17:56,110 --> 00:17:59,510
مفهوم صنعه لدوائه بنفسه رائع

324
00:17:59,510 --> 00:18:03,820
أودّ استغلال ذلك، نحتاج أن يكون
موظّفينا مفعمين بالصحّة

325
00:18:03,820 --> 00:18:07,890
حسناً، إذا أضفنا كلّ هذه... شيء كهذا؟

326
00:18:10,880 --> 00:18:14,280
!إخافة اعتياديّة تلائم الأليف! رائع

327
00:18:14,280 --> 00:18:18,660
أعطيته عظمة واحدة أسفل الركبة
لجعله يتخصّص في السرعة

328
00:18:18,660 --> 00:18:21,090
،يمكن للساق الالتفاف بعظمتين

329
00:18:21,090 --> 00:18:24,340
لكن دمجها إلى واحدة يجعلها أقوى

330
00:18:24,340 --> 00:18:27,670
بهذه الساق، يمكنه بلوغ سرعة 80 كم في الساعة

331
00:18:27,670 --> 00:18:29,840
!تفكيرٌ عميق في أماكن غير مرئيّة

332
00:18:29,840 --> 00:18:32,830
بما أنّ طلبك كان مفصّلاً وسهل الفهم

333
00:18:32,830 --> 00:18:34,720
انتهى سريعاً

334
00:18:35,140 --> 00:18:37,180
أتريد أن تعمل على المظهر الآن؟

335
00:18:37,180 --> 00:18:40,290
ليس علينا الضغط الآن، يمكنكم إنهاؤه
متى تسنّت لكم الفرصة

336
00:18:40,590 --> 00:18:42,560
ما الخطب يا أونابارا-سان؟

337
00:18:42,560 --> 00:18:47,980
لا شيء، أدركتُ التسلية في صنع الأشياء لا أكثر

338
00:18:47,980 --> 00:18:50,010
يمرّ بانخفاض مستوى حالياً

339
00:18:50,010 --> 00:18:51,950
إنّه مرهق

340
00:18:52,890 --> 00:18:56,860
ما رأيك بصنع شيءٍ بحريّة إذاً؟

341
00:18:58,510 --> 00:19:01,320
إذا حرّرت غرائزك من القيود
ورسمت لتسليتك الشخصيّة

342
00:19:01,320 --> 00:19:02,940
فقد تستطيع إعادة تنظيم نفسك

343
00:19:04,000 --> 00:19:05,220
ما رأيك بهذا؟

344
00:19:05,220 --> 00:19:09,380
هل تمانع التفكير بالمنظر للخارجي
لهذه العظام هنا؟

345
00:19:09,800 --> 00:19:14,260
أريد رؤية ما تصنعه عندما لا تُفرض
عليك قيود، وترسم لاهياً

346
00:19:15,290 --> 00:19:18,600
بحريّة؟ تسلية شخصيّة؟

347
00:19:21,510 --> 00:19:23,510
!حمل أونابارا-سان قلمه

348
00:19:24,190 --> 00:19:26,250
يوكوتا سينباي مذهل

349
00:19:26,690 --> 00:19:28,940
لم أستطع دفعه لفعل ذلك

350
00:19:29,520 --> 00:19:31,520
...يوماً ما، أريد أن

351
00:19:32,130 --> 00:19:33,240
انتهيت

352
00:19:34,520 --> 00:19:35,890
ما رأيكم؟

353
00:19:43,060 --> 00:19:47,400
لحظة! كيف تحوّل شيءٌ مخيف إلى هذا؟

354
00:19:47,400 --> 00:19:49,170
كان ذلك مسليّاً

355
00:19:49,590 --> 00:19:53,910
وضع تلك العظام الطويلة
في ذيله المستدير أيضاً

356
00:19:54,220 --> 00:19:58,070
هذا الشيء الظريف جدّاً... يأكل البراز؟

357
00:19:58,070 --> 00:20:00,240
وينام وعيناه مفتوحتان؟

358
00:20:00,240 --> 00:20:01,420
ما هذه الأذنين؟

359
00:20:06,230 --> 00:20:08,330
ظننتُ أنّ حراراته قد ترتفع فينهار

360
00:20:08,330 --> 00:20:12,050
تملك وظيفة جمع الصوت لتلقّي
الأوامر من بعدٍ أيضاً كهوائيّ

361
00:20:12,300 --> 00:20:16,920
كيف حللت طلب طريقة التواصل
اللا لفظيّة الفريدة؟

362
00:20:16,920 --> 00:20:20,070
جعلته بارعاً في الإحساس بالاهتزازات

363
00:20:20,490 --> 00:20:23,440
يمكنه هكذا الدوس بقدمه للتواصل

364
00:20:25,600 --> 00:20:28,940
أليس هذا أقرب للطلب الغامض
الذي أصابك بالإحباط؟

365
00:20:28,940 --> 00:20:31,920
"تقصد "حيوان زغبيّ لكن شائك

366
00:20:31,920 --> 00:20:34,140
ألن يلائمه تماماً؟

367
00:20:35,150 --> 00:20:39,340
فهمت، صدر هذا لأنّك كنت
تفكّر به طوال الوقت

368
00:20:39,650 --> 00:20:43,620
...من منظور الجحيم، هذا التصميم مقبولٌ أيضاً، لكن

369
00:20:43,620 --> 00:20:44,850
حقّاً؟

370
00:20:45,190 --> 00:20:47,760
إذا كان هناك مستلم سابق، فليس باليد حيلة

371
00:20:48,180 --> 00:20:50,280
فلتوصله للإله رجاءً

372
00:20:50,280 --> 00:20:51,070
حسناً

373
00:20:52,920 --> 00:20:57,210
صحيح... الجحيم خارج نطاق استقبال الإله

374
00:20:57,210 --> 00:20:59,980
ماذا نفعل؟ أريد أن أوصله فوراً

375
00:21:00,230 --> 00:21:04,350
لا تقلق، فقد دعوتُ الإله هنا أيضاً

376
00:21:04,700 --> 00:21:06,470
سيصل قريباً

377
00:21:07,280 --> 00:21:09,250
!سيأتي العميل هنا شخصيّاً؟

378
00:21:09,250 --> 00:21:13,610
انتظر! زيّف أونابارا-سان مرضه
!كي يأتي هنا

379
00:21:13,610 --> 00:21:14,740
!ستُكشف كذبتنا

380
00:21:17,830 --> 00:21:21,700
...هـ-هذا الضوء! أيمكن

381
00:21:22,440 --> 00:21:23,910
!الإله؟

382
00:21:25,900 --> 00:21:28,900
!الدليل المصوّر للمخلوقات التي توجد حقّاً

383
00:21:30,140 --> 00:21:33,680
مظهره ظريف، لكنّه يأكل البراز

384
00:21:33,680 --> 00:21:37,390
يأكل برازاً خاصّاً غنّياً بالفيتامينات كمكمل غذائيّ

385
00:21:37,390 --> 00:21:39,450
أو كانت تلك النيّة

386
00:21:40,760 --> 00:21:43,240
،عندما راقبتُ الأرانب البريّة في الواقع

387
00:21:43,240 --> 00:21:45,840
كانت تأكل برازاً عاديّاً عندما
لم تجد أيّ طعام

388
00:21:45,840 --> 00:21:48,820
صلبة! من ناحية، إذا أكلت ما تفرزه

389
00:21:48,820 --> 00:21:51,090
فأنت أشبه بجهاز حركة مستمرّ

390
00:21:51,090 --> 00:21:54,550
،في الشتاء، عندما لا تكون هناك أعشاب
كانت تأكل فضلات الحيوانات أيضاً

391
00:21:54,550 --> 00:21:56,160
!صلبة بحقّ

392
00:21:56,400 --> 00:22:01,160
بالكلام عن الصلابة، تلكم الأنثى الذكر بدايةً عندما تختاره

393
00:22:01,160 --> 00:22:04,440
تتأكّد من قوّته بلكمه

394
00:22:04,440 --> 00:22:07,180
تبادل اللكمات، ثمّ تبادل الحُب

395
00:22:07,430 --> 00:22:08,440
!قويّة

396
00:22:08,670 --> 00:22:11,780
،يوماً ما في المستقبل القريب
قد لا تبدو هذه الأرانب كرمزٍ للظرافة

397
00:22:11,780 --> 00:22:14,510
بل للقوّة