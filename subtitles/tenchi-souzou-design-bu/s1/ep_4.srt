1
00:00:01,210 --> 00:00:02,530
!صباح الخير

2
00:00:02,890 --> 00:00:05,120
...آمل أنّ عملكم يمضي على

3
00:00:05,780 --> 00:00:07,230
لا مضيّ هناك

4
00:00:07,540 --> 00:00:09,600
مرحباً يا شيمودا-كن

5
00:00:09,810 --> 00:00:10,890
ما الخطب؟

6
00:00:10,890 --> 00:00:12,350
أليس الوضع هكذا دوماً؟

7
00:00:12,350 --> 00:00:14,100
لكن بهذا النحو حقّاً؟

8
00:00:14,100 --> 00:00:16,380
الجميع عالقون حالياً

9
00:00:16,380 --> 00:00:19,630
تورّطوا مع طلبات مزعجة بخلافي

10
00:00:19,630 --> 00:00:21,290
يا لحظّهم التعيس

11
00:00:22,870 --> 00:00:26,130
هناك طلبٌ من الإله خصّيصاً
لك يا كاناموري-سان

12
00:00:27,380 --> 00:00:31,080
طلب: اجعل الحصان يطير بطريقةٍ ما

13
00:02:03,860 --> 00:02:06,220
تسوتشيا-سان هو عادةً"
،من يرتبط به الحصان

14
00:02:06,220 --> 00:02:08,330
لكنّي أردت توجيه التصميم
لكاناموري-سان خصّيصاً هذه المرّة

15
00:02:08,330 --> 00:02:10,540
"التنّين من ذاك اليوم كان مسليّاً

16
00:02:10,540 --> 00:02:12,360
هذا رأي الإله

17
00:02:12,360 --> 00:02:16,110
ماذا؟ ستصنعين بيغاسوس؟ أشعر بالغيرة

18
00:02:16,470 --> 00:02:21,240
ستستطيعين فعلها إذا ساندك
!الجميع بالتأكيد يا كاناموري-سان

19
00:02:21,240 --> 00:02:23,860
لن يكون الأمر بتلك السهولة

20
00:02:23,860 --> 00:02:26,880
تسوتشيا ذو أهميّة كبيرة في هذا، لكنّه مشغول الآن

21
00:02:27,310 --> 00:02:30,920
عليّ مساعدة هيغوتشي-سان في
إصلاح مختبر النماذج الأوليّة

22
00:02:30,920 --> 00:02:33,660
أنا مجبرٌ بعد الضرر الذي تسبّب به حفيدي

23
00:02:34,050 --> 00:02:37,870
لكنّي أتوق لرؤية البيغاسوس
الذي ستصنعه كين-تشان

24
00:02:37,870 --> 00:02:40,250
لا يروقني هذا حقّاً

25
00:02:40,950 --> 00:02:44,290
يبدو أنّ الجميع يعانون

26
00:02:46,420 --> 00:02:48,760
يبدو أنّ ميدو-سان مسترخية

27
00:02:48,760 --> 00:02:51,880
قد يبدو ذلك، لكنّها الأكثر توتّراً حالياً

28
00:02:52,180 --> 00:02:55,370
لم يصلني ردّ من العميل
لثلاثة أيام الآن

29
00:02:55,370 --> 00:02:58,340
،أخبرني أن أنهي العمل بأسرع وقت
فبذلت قصارى جهدي

30
00:02:58,340 --> 00:02:59,300
لكن يبدو

31
00:02:59,300 --> 00:03:00,770
أنّ الوقت كان وفيراً

32
00:03:02,580 --> 00:03:04,790
!يمكنني الإلحاح على الإله قليلاً

33
00:03:04,790 --> 00:03:05,820
لا داعي

34
00:03:06,150 --> 00:03:09,520
إذا تصرّفت كأنّك متحمّس كثيراً

35
00:03:09,520 --> 00:03:11,790
سينقلب عليك ذلك وتندم

36
00:03:11,790 --> 00:03:13,070
...ما استلمتُه

37
00:03:13,410 --> 00:03:17,460
كان طلب "حيوان يركض رغم
"عدم امتلاكه لسيقان

38
00:03:17,460 --> 00:03:20,920
وفوق ذلك، عليّ تقديم ثلاثة عروض

39
00:03:21,410 --> 00:03:24,440
كلّ طلباتنا ألغاز كهذه مؤخراً

40
00:03:25,440 --> 00:03:27,310
أريد أكل شيءٍ حلو

41
00:03:27,310 --> 00:03:30,050
أريد كاسترد كاراميل منزليّ حيث
يكون الكاراميل مرّاً قليلاً

42
00:03:30,700 --> 00:03:34,190
كنتُ أعتقد أنّ المصمّمين يقومون
،بأعمال راقية دوماً

43
00:03:34,190 --> 00:03:36,180
لكن يبدو أنّي كنت مخطئاً تماماً

44
00:03:38,040 --> 00:03:40,410
وصلني تعليق إضافيّ يا كاناموري-سان

45
00:03:40,410 --> 00:03:42,700
"يقول "يمكنك فعل ما يحلو لك

46
00:03:43,010 --> 00:03:46,420
!لا بدّ أنّ الإله يثق بتصاميمك كثيراً

47
00:03:46,420 --> 00:03:47,730
!كلا

48
00:03:47,730 --> 00:03:50,890
هذا يعني أنّه سيترك الأمر كلّه لي
!ويفكّر بعدما ينتهي التصميم فقط

49
00:03:50,890 --> 00:03:52,460
!هذه بداية الجحيم

50
00:03:52,900 --> 00:03:56,230
،نعرف ما هي المشاكل سلفاً
!لذا يمكنني تصميمه مباشرةً

51
00:03:57,350 --> 00:03:59,470
!عـ-عضلات كثيرة

52
00:03:59,470 --> 00:04:01,350
!وبراز كثير

53
00:04:01,580 --> 00:04:06,110
قلّلت ميوستاتين البروتين الذي
يقمع نمو العضلات

54
00:04:06,110 --> 00:04:07,740
أليس مفتولاً؟

55
00:04:09,250 --> 00:04:13,220
!سأرسله للإله بأيّ حال... إرسال

56
00:04:13,490 --> 00:04:16,530
يمكنني الاستراحة لحين وصول ردٍّ إذاً

57
00:04:17,190 --> 00:04:18,240
وصل الردّ بالفعل

58
00:04:18,240 --> 00:04:19,740
ماذا؟ بهذه السرعة؟

59
00:04:21,270 --> 00:04:23,480
سأنقل كلامه كما هو

60
00:04:23,480 --> 00:04:25,570
ماذا؟ أشعر بالخوف

61
00:04:25,570 --> 00:04:28,510
ليس مطابقاً تماماً"، وفقما يقول"

62
00:04:28,510 --> 00:04:29,360
ماذا؟

63
00:04:29,360 --> 00:04:32,580
"أردت شيئاً مفاجئاً أكثر، ليس الشيء نفسه"

64
00:04:32,580 --> 00:04:36,920
حرّري ابتكاريّتك يا كاناموري-سان"، نهاية القول

65
00:04:36,920 --> 00:04:39,620
!ها هي! إعادة التفكير بعد رؤية التصميم

66
00:04:39,620 --> 00:04:43,270
!قل ما تريده منذ البداية

67
00:04:43,270 --> 00:04:45,790
لا أظنّ صراخك هنا سيصله

68
00:04:45,790 --> 00:04:47,880
!لذا أفعل ذلك

69
00:04:53,230 --> 00:04:54,400
!ماذا عن هذا إذاً؟

70
00:04:54,770 --> 00:04:56,640
هذه خطوطٌ رائعة

71
00:04:56,640 --> 00:04:57,920
!إنّه مُبهر

72
00:04:57,920 --> 00:05:01,900
تعمّدت إزالة عضلاته، وقلّصت وزنه الكليّ بدل ذلك

73
00:05:02,270 --> 00:05:04,740
لا يمكنه الطيران من الأرض

74
00:05:04,740 --> 00:05:08,230
لكن إذا قفز من على جرف
وصعد على تيّار، فسيحلّق

75
00:05:08,230 --> 00:05:09,920
!هذا مُبتكر

76
00:05:10,790 --> 00:05:14,450
!أرسلتُها، سيمضي على ما يرام بالتأكيد هذه المرّة

77
00:05:14,450 --> 00:05:16,540
آمل ذلك

78
00:05:18,220 --> 00:05:19,910
أيمكنني قوله؟

79
00:05:19,910 --> 00:05:21,580
وصلنا ردّ بالفعل؟

80
00:05:22,300 --> 00:05:25,590
يراودني شعورٌ سيّئ، لكن تكلّم

81
00:05:26,020 --> 00:05:30,840
،يقول "ليس عليك التركيز على الحصان
"لا بأس بالصغير أيضاً

82
00:05:31,190 --> 00:05:33,810
لمَ لم يخبرني بذلك قبلاً؟

83
00:05:34,510 --> 00:05:37,460
سأعيد التفكير من البداية

84
00:05:37,460 --> 00:05:39,520
بـ-بالتوفيق

85
00:05:40,270 --> 00:05:42,590
يا إلهي، هذا كثير

86
00:05:42,590 --> 00:05:46,390
تفهّم العمل الذي يبذله المصمّمون من فضلك

87
00:05:46,390 --> 00:05:48,120
!حسناً

88
00:05:48,120 --> 00:05:49,560
!شكراً جزيلاً

89
00:05:52,850 --> 00:05:57,320
ا-ا-انتهيت، هلّا أرسلته للعميل من فضلك؟

90
00:05:57,680 --> 00:05:59,700
!حسناً! عملٌ مبارك

91
00:06:00,010 --> 00:06:03,000
!هذا العرض النهائيّ المُطلق للبيغاسوس المنقّح

92
00:06:03,000 --> 00:06:04,760
ما رأيك هذه المرّة؟

93
00:06:05,410 --> 00:06:06,580
إنّه جميلٌ جدّاً

94
00:06:06,840 --> 00:06:09,390
اشتققته من جنّية أزهار

95
00:06:09,390 --> 00:06:12,000
بما أنّي جعلت ذراعيه
،جناحين كالبتلات

96
00:06:12,000 --> 00:06:14,050
يمكنه أن يتقمّص مظهر زهرة

97
00:06:14,050 --> 00:06:15,030
مذهل

98
00:06:15,030 --> 00:06:18,230
يشرب الرحيق كطعام له، ما رأيك؟

99
00:06:18,230 --> 00:06:21,120
!يبدو رائعاً! سأرسله

100
00:06:27,100 --> 00:06:28,530
أيمكنني القول؟

101
00:06:29,580 --> 00:06:30,670
تفضّل

102
00:06:31,280 --> 00:06:34,630
،المراجعة الجحيمية السابقة كانت أفضل"

103
00:06:34,630 --> 00:06:38,990
استعملي تصميماً قطرياً، وخفّفي ألوانه"، نهاية القول

104
00:06:39,960 --> 00:06:41,290
المراجعة السابقة؟

105
00:06:41,290 --> 00:06:44,250
لمَ هذه المصطلحات التقنية فجأة؟

106
00:06:44,250 --> 00:06:48,220
آسف! حصل هذا لأنّي قلت
!ما لم أحسب له للإله

107
00:06:48,220 --> 00:06:51,250
طلبتُ منه تفهمّ عمل المصمّمين

108
00:06:51,490 --> 00:06:55,640
ظننته سيفعل، لكن لا منطقيّته لم تتغيّر

109
00:06:56,010 --> 00:07:00,290
لا بأس، قلت ذلك لأنّك أردت مساعدتنا، صحيح؟

110
00:07:00,630 --> 00:07:03,100
اللوم على العميل

111
00:07:06,050 --> 00:07:08,140
لا أستطيع التفكير بشيء أبداً

112
00:07:08,490 --> 00:07:11,540
أيمكنك أن تريني تصميمك يا كين-تشان
كي أروّح عن نفسي قليلاً؟

113
00:07:11,540 --> 00:07:12,910
لا أمانع

114
00:07:12,910 --> 00:07:14,730
لكنّنا نعاني الاثنان، أليس كذلك؟

115
00:07:16,200 --> 00:07:18,590
أرجع للمراجعة السابقة للتصميم العظميّ إذاً

116
00:07:18,590 --> 00:07:22,170
أقصّر الوجه، وأقلّل الجانب الحصاني

117
00:07:22,170 --> 00:07:25,910
في تلك الحالة، سأتخلّص من عضلات السيقان
أثناء ذلك أيضاً

118
00:07:26,480 --> 00:07:27,840
!انتهيت

119
00:07:29,630 --> 00:07:33,670
إنّه العرض النهائي المُطلق
!للبيغاسوس المنقّح، للأبد

120
00:07:35,320 --> 00:07:38,580
،يتدلّى للأبد-تشان من أماكن مرتفعة

121
00:07:38,580 --> 00:07:40,680
ويستعمل زخم سقوطه للطيران

122
00:07:40,680 --> 00:07:42,580
يمكنه أن يكون خفيفاً هكذا

123
00:07:43,160 --> 00:07:44,690
!هذا مثير

124
00:07:44,690 --> 00:07:46,940
يتدلّى دوماً إذاً

125
00:07:47,310 --> 00:07:52,440
أتريدين إضافة التحديد الصدوي مثل التي
لدى الدلافين كيلا يصطدم بالأشياء؟

126
00:07:52,910 --> 00:07:55,380
...تلك فكرة حسنة! وطعامه

127
00:07:55,380 --> 00:07:58,210
من الأفضل أن يمتصّ الدم نظراً لمظهره

128
00:07:58,210 --> 00:07:59,950
...الرحيق

129
00:08:00,260 --> 00:08:02,770
سيكون أكثر ظرافة إذا امتصّ الدم

130
00:08:02,770 --> 00:08:04,810
الـ-المرّة القادمة

131
00:08:04,810 --> 00:08:06,700
!سأرسله فوراً

132
00:08:08,920 --> 00:08:10,090
!رسالة إلهية

133
00:08:10,380 --> 00:08:12,370
!مقبول

134
00:08:14,590 --> 00:08:17,580
!هذا رائع! ارتحنا أخيراً

135
00:08:17,580 --> 00:08:20,430
!وهذا مقبول أيضاً

136
00:08:20,730 --> 00:08:22,550
ما الذي صنعته؟

137
00:08:22,550 --> 00:08:24,220
...قنفذ بحر راكض

138
00:08:25,120 --> 00:08:26,550
!رائعٌ جدّاً

139
00:08:26,550 --> 00:08:27,920
!سريع! مبهر

140
00:08:27,920 --> 00:08:31,240
قُبل الشيء الذي أرسلته
عندما لم أعد أهتم

141
00:08:31,240 --> 00:08:33,100
!كلا! نسيت محي ذلك

142
00:08:33,440 --> 00:08:35,020
!لديه زوجيّ حلمات

143
00:08:35,020 --> 00:08:37,900
!لن يخرج شيء من الحلمات العلوية

144
00:08:38,360 --> 00:08:40,630
لكنّ التصميم قُبل بالفعل

145
00:08:42,140 --> 00:08:44,220
لا يهم، لندعه كما هو

146
00:08:44,760 --> 00:08:48,620
يمكن أن يكون الجزء الإضافيّ شيئاً
يتمسّك به الرضيع كيلا يسقط

147
00:08:49,090 --> 00:08:50,330
شيء"؟"

148
00:08:53,800 --> 00:08:56,880
!الدليل المصوّر للمخلوقات التي توجد حقّاً

149
00:08:57,760 --> 00:09:00,550
من الأبرع في الطيران بينه والطيور؟

150
00:09:00,550 --> 00:09:02,110
أظنّ الخفّاش أبرع

151
00:09:02,110 --> 00:09:04,770
،بخلاف الطيور التي تطير بأذرعتها كاملة

152
00:09:04,770 --> 00:09:07,600
يمدّ الخفّاش أصابعه ليشكّل جناحاً

153
00:09:07,600 --> 00:09:10,410
تعطيه الأصابع تحكّماً أعلى دقّة

154
00:09:12,260 --> 00:09:15,570
!يُظهر هذا أنّ الأحصنة هي الحيوانات العُليا

155
00:09:15,790 --> 00:09:17,960
لا علاقة للأحصنة بهذا

156
00:09:17,960 --> 00:09:21,540
...ذلك ما أودّ قوله، لكن في تصنيفات الحيوانات

157
00:09:21,540 --> 00:09:23,820
الخفافيش قريبة للأحصنة

158
00:09:24,120 --> 00:09:26,080
!توجد خفافيش بمثابة الأحصنة

159
00:09:26,480 --> 00:09:27,560
!انظري

160
00:09:27,560 --> 00:09:30,420
أطال وجهه كي يصدر صوتاً
أعلى لا أكثر

161
00:09:30,680 --> 00:09:33,060
شبهه بالحصان محض مصادفة

162
00:09:45,310 --> 00:09:49,350
ما خطب كاناموري؟ لباسها منمّق

163
00:09:49,350 --> 00:09:51,200
تبدو متحمّسة

164
00:09:51,200 --> 00:09:53,950
!"طلبي هذه المرّة هو "طير كالجوهرة

165
00:09:54,430 --> 00:09:57,170
لا يمكنك تحسين مزاجك إذا
بدا كلّ شيٍ باهتاً

166
00:09:57,170 --> 00:09:59,810
انظرا لهذا العقيق! ألا يبدو جميلاً؟

167
00:10:00,030 --> 00:10:03,700
ما رأيكما بطيرٍ يلمع بألوان
قوس المطر هكذا؟

168
00:10:03,700 --> 00:10:06,630
...إذا أظهرتِ هذه الثقة

169
00:10:08,090 --> 00:10:11,100
أجل؟ أجل، فهمت

170
00:10:11,390 --> 00:10:15,960
وصل طلب تابع، قال الإله أنّه يريد
"رؤية "طير يصنع جواهراً

171
00:10:17,460 --> 00:10:22,840
،صمّمتُ طيوراً تنجذب للأشياء اللامعة
لكن تصنع جواهراً؟

172
00:10:23,480 --> 00:10:26,030
يمكنكما أخذ واحدة من هذه إذا ساعدتماني

173
00:10:26,030 --> 00:10:28,850
لا أريدها، لا أفهم الجواهر

174
00:10:28,850 --> 00:10:33,970
صحيح، يفتقر هذا المكان
للعاطفيّة والشاعريّة

175
00:10:33,970 --> 00:10:37,300
مما صُنع ذاك الحجر المدعوّ بالعقيق؟

176
00:10:37,300 --> 00:10:41,810
العقيق هو ثنائي أكسيد السيليكون، معدن من السيليكا والماء

177
00:10:41,810 --> 00:10:43,870
السيليكا... فهمت

178
00:10:44,390 --> 00:10:46,370
مثل تلك المواد المجفِّفة
في أكياس البسكويت، أليس كذلك؟

179
00:10:46,370 --> 00:10:49,380
!مهلك! لا تلجأ لأمثلة لا شاعريّة

180
00:10:49,640 --> 00:10:54,410
بالمناسبة، أنهيتُ الطير بلون قوس المطر
الذي طلبتِ مني صنعه

181
00:10:54,410 --> 00:10:56,990
طير مبهرج كذاك سيُستهدف فوراً

182
00:10:56,990 --> 00:10:59,010
!سيكون بخير

183
00:10:59,310 --> 00:11:03,880
،إنّه صغير بحيث يمكنه الوقوف هنا
ووزنه بهذا القدر

184
00:11:03,880 --> 00:11:05,990
!وسريعٌ جدّاً

185
00:11:05,990 --> 00:11:09,160
ما رأيك؟ تظنّه سيكون طعاماً جذّاباً؟

186
00:11:09,160 --> 00:11:10,240
فهمت

187
00:11:10,240 --> 00:11:13,410
قيمته الغذائيّة ضعيفة مقارنة
بالجهد المطلوب للإمساك به

188
00:11:13,820 --> 00:11:16,110
!صحيح! فلا داعي للقلق

189
00:11:16,110 --> 00:11:17,770
!هيغوتشي-سان! أرينا

190
00:11:17,770 --> 00:11:22,650
حسناً، صنعته... لكن لا يملك طاقةً كافية

191
00:11:22,650 --> 00:11:24,940
حجمه صغيرٌ جدّاً فلا يستطيع
المحافظة على درجة حرارة جسمه

192
00:11:24,940 --> 00:11:27,660
!لكنّي جعلته يلمع

193
00:11:27,970 --> 00:11:29,170
ستستسلمين؟

194
00:11:29,560 --> 00:11:32,920
!لـ-لن أستسلم! سأجعله ينجح بطريقةٍ ما

195
00:11:33,770 --> 00:11:35,780
إذا برد، فعليه الأكل وحسب

196
00:11:35,780 --> 00:11:37,470
شيء يمكن أكله بكميّات كبيرة

197
00:11:37,470 --> 00:11:39,580
...وسهل الهضم ومرتفع السعرات الحرارية

198
00:11:47,120 --> 00:11:50,430
!الرحيق! إنّه شاعريّ ومرتفع التغذية

199
00:11:50,840 --> 00:11:53,700
،لكنّي قلّصت عضلات ساقيه

200
00:11:53,700 --> 00:11:56,630
فلا يملك قوّةً كافية
للمشي على الفروع

201
00:11:56,630 --> 00:11:59,360
ولا قوّة نزع البتلات

202
00:11:59,760 --> 00:12:03,290
!إنّه قصير الأجل، لكن لا يكفي ذلك

203
00:12:03,690 --> 00:12:06,320
هل أجعله يحوم مثل النحلة ويشرب مباشرةً؟

204
00:12:06,680 --> 00:12:09,810
لكن لن يستطيع بأجنحة
الطيور الاعتيادية تلك

205
00:12:09,810 --> 00:12:12,840
لا خيار أمامي، سأسأل قسم الحشرات

206
00:12:14,790 --> 00:12:16,080
!كاناموري-سان

207
00:12:16,510 --> 00:12:19,610
هذا ما يحصل عندما تستعجلين
وأنتِ ترتدين أحذية كهذه

208
00:12:19,610 --> 00:12:21,720
ارتداء الكثير من أدوات الزينة أمرٌ خطر

209
00:12:21,990 --> 00:12:25,930
ربما معك حقّ، لكن لا تمنعني مظهري

210
00:12:25,930 --> 00:12:28,490
!فأنا لا أكون أنا إلّا إذا بدوت هكذا

211
00:12:28,490 --> 00:12:31,090
الأمر ينطبق على الحيوانات التي نصنعها

212
00:12:33,510 --> 00:12:36,600
تسألين كيف يطير النحل؟

213
00:12:38,700 --> 00:12:42,900
يرفرف النحل أجنحته أمامياً وخلفياً، فيشكّل دوّامة
في الهواء تمكّنه من الطيران

214
00:12:43,230 --> 00:12:47,520
التصميم ملائم للتوقّف في الهواء
أكثر من التقدّم للأمام

215
00:12:47,520 --> 00:12:51,260
فهمت، قد يستطيع محاكاة ذلك
بما أنّه طيرٌ خفيف وصغير

216
00:12:51,260 --> 00:12:54,500
إذا أضفتِ هذه القدرة، لن يتوقّف الأمر على الحوم

217
00:12:54,500 --> 00:12:56,220
...بل سيستطيع الطيران

218
00:12:56,220 --> 00:12:57,470
!للخلف أيضاً

219
00:12:59,950 --> 00:13:02,010
!نجحت! إنّه يطير

220
00:13:02,010 --> 00:13:04,250
!يستطيع شرب الرحيق أيضاً

221
00:13:04,250 --> 00:13:09,490
أجل، لكن بما أنّه بحاجة للأكل للبقاء
فلا أظنّه سيستطيع النجاة لليلة

222
00:13:09,490 --> 00:13:10,540
سيموت إذا نام

223
00:13:10,540 --> 00:13:11,650
!إذا نام يموت؟

224
00:13:11,650 --> 00:13:14,570
صحيح! ماذا أفعل؟

225
00:13:14,570 --> 00:13:16,510
ما رأيكم بجعله يسبت؟

226
00:13:16,800 --> 00:13:17,940
ليلاً فحسب

227
00:13:17,940 --> 00:13:21,030
تخفضون معدّل نبضات قلبه ودرجة
حرارة جسده مثل وضعية السبات

228
00:13:21,280 --> 00:13:25,530
فد يقلّص ذلك عمليات الأيض لأقلّ
من 10% أثناء نومه

229
00:13:25,530 --> 00:13:26,540
!سينجح

230
00:13:26,940 --> 00:13:28,050
!رسالة إلهية

231
00:13:28,050 --> 00:13:30,030
!مقبول

232
00:13:31,040 --> 00:13:36,040
!نجحت! اكتمل طيري الشبيه بالجوهرة

233
00:13:36,270 --> 00:13:38,160
!شكراً لك يا ميزوشيما

234
00:13:38,160 --> 00:13:40,910
لكن ما الذي حفّزك للمساعدة؟

235
00:13:40,910 --> 00:13:43,680
أنا أفتخر بأسلوبي

236
00:13:44,200 --> 00:13:45,860
أنت مثلي، أليس كذلك؟

237
00:13:45,860 --> 00:13:48,300
فمن الطبيعيّ أن أشعر برغبة بالمساعدة

238
00:13:49,720 --> 00:13:53,210
إضافةً لذلك، بما أنّك كنتِ
تعانين كثيراً في هذا

239
00:13:53,210 --> 00:13:54,690
أنهيت الآخر

240
00:13:56,420 --> 00:13:59,530
دعني أرى، الطير الذي يصنع الجواهر؟

241
00:13:59,530 --> 00:14:00,950
تظنّين هذا سينجح؟

242
00:14:00,950 --> 00:14:02,700
أجل، إنّه بسيط

243
00:14:04,730 --> 00:14:06,420
سأقدّمه لكم إذاً

244
00:14:06,420 --> 00:14:11,320
بالمحافظة على مبدأ هاناموري الأساسيّ
بانجذاب الطيور للأشياء اللامعة

245
00:14:11,320 --> 00:14:14,260
يأكل هذا الطير الألماس الخام

246
00:14:15,250 --> 00:14:17,120
،لا تملك الطيور أسناناً

247
00:14:17,120 --> 00:14:20,430
فتأكل أحجار صغيرة وتخزّنها داخل
حوصلتها الموجودة خلف معدتها

248
00:14:20,430 --> 00:14:22,970
وتستعملها لطحن الطعام

249
00:14:22,970 --> 00:14:25,840
أ-أي أنّها حوصلة ألماس؟

250
00:14:26,110 --> 00:14:29,330
لكنّه لن يستطيع الطيران إذا أكل
أحجاراً بذاك الحجم الكبير

251
00:14:29,610 --> 00:14:32,220
صحيح، لذا أزلتُ الطيران

252
00:14:32,590 --> 00:14:36,340
عزّزتُ قوّة ساقيه، فيمكنه حماية نفسه
من أعدائه بالركل والركض

253
00:14:36,640 --> 00:14:39,010
ستتصادم الألماس الصافية التي ابتلعها

254
00:14:39,010 --> 00:14:42,480
في حوصلته لأعوام، فتصبح بنهاية المطاف

255
00:14:42,480 --> 00:14:43,740
جواهر مصقولة

256
00:14:44,260 --> 00:14:45,970
...وصانعها

257
00:14:46,630 --> 00:14:47,810
!هو هذا الطير

258
00:14:49,470 --> 00:14:52,360
!ما هذا؟! يبدو هزيلاً، ومنزوع الأناقة

259
00:14:52,360 --> 00:14:54,870
!لمَ لا يملك هذا الطير ريشاً؟ ليس جميلاً

260
00:14:54,870 --> 00:14:56,530
لا يحتاجها بما أنّه لا يطير

261
00:14:56,530 --> 00:14:57,960
!تفتقر للشاعريّة

262
00:14:57,960 --> 00:14:59,490
على الطيور أن تكون أكثر هذا

263
00:14:59,720 --> 00:15:02,000
!أعين أكبر ورموش

264
00:15:02,000 --> 00:15:03,750
!وريش أنيق على أجسادها

265
00:15:03,750 --> 00:15:04,510
!توقّفي

266
00:15:04,510 --> 00:15:06,580
!تفسدين جمال فعاليته

267
00:15:06,580 --> 00:15:08,260
!دعني

268
00:15:10,070 --> 00:15:11,250
!رسالة إلهية

269
00:15:11,440 --> 00:15:13,510
!مقبول

270
00:15:16,720 --> 00:15:18,090
ليس جميلاً

271
00:15:18,090 --> 00:15:19,670
غير فعّال

272
00:15:19,670 --> 00:15:22,140
ليس التصميم الذي أردتُه

273
00:15:22,410 --> 00:15:25,130
لكن اقتنع العميل به

274
00:15:25,610 --> 00:15:27,520
أبلينا حسناً

275
00:15:27,730 --> 00:15:30,780
معكِ حقّ، كانت النتيجة جيّدة

276
00:15:31,450 --> 00:15:33,340
أيّ جوهرة تريد كمكافأة؟

277
00:15:33,340 --> 00:15:36,280
إذا كان لديك من تريد إعطاءه واحدة، سأساعدك

278
00:15:38,830 --> 00:15:40,490
ستفي الألماسة بالغرض

279
00:15:42,270 --> 00:15:44,030
سأعطيها هيغوتشي-سان

280
00:15:45,410 --> 00:15:47,120
لـ-لي؟

281
00:15:48,170 --> 00:15:49,680
أأنت متأكّد؟

282
00:15:49,680 --> 00:15:50,800
بالطبع

283
00:15:51,100 --> 00:15:54,580
كنتِ تبحين عن مواد لعدسات
بمعامل انكسار مرتفع، أليس كذلك؟

284
00:15:54,580 --> 00:15:58,050
شكراً لك! هذه مثالية لعدسة
!تركيز لشعاع الليزر

285
00:15:58,960 --> 00:16:02,560
هذا المكان فقير الشاعريّة حقّاً

286
00:16:03,820 --> 00:16:06,800
!الدليل المصوّر للمخلوقات التي توجد حقّاً

287
00:16:08,170 --> 00:16:12,130
لمعان هذه الأجنحة يعود
لارتداد الضوء منها

288
00:16:12,130 --> 00:16:14,380
فيُدعى لوناً هيكلياً

289
00:16:14,380 --> 00:16:18,950
فقاقيع الصابون والزيت على الرامن
!كلّها ألوان هيكلية

290
00:16:19,260 --> 00:16:22,930
هذا مقدّم لكم من قسم الحشرات
الخبير في الألوان الهيكلية

291
00:16:23,300 --> 00:16:25,000
هذا لون هيكلي أيضاً

292
00:16:25,000 --> 00:16:27,600
تظهر ألوان قوس مطر
عندما تميله، أليس كذلك؟

293
00:16:27,880 --> 00:16:32,330
يُصدر اللون بتكويم المربّعات
العاكسة للضوء بشكلٍ عام

294
00:16:32,740 --> 00:16:36,350
فلتتأملوا في هذا المخلوق الذي
!أتقن هذه التقنية

295
00:16:45,730 --> 00:16:48,450
...صباح الخير يا جما

296
00:16:48,450 --> 00:16:49,350
ماذا؟

297
00:16:49,850 --> 00:16:51,360
ماذا؟ ماذا؟

298
00:16:51,360 --> 00:16:52,470
ماذا؟

299
00:16:54,930 --> 00:16:57,620
أأنتم تتعاونون في تشكيل
لوحة فنّية طليعية؟

300
00:16:58,120 --> 00:17:01,010
يُفترض أنّنا نلعب لعبة الاختباء

301
00:17:01,010 --> 00:17:03,090
بثياب بارزة كهذه؟

302
00:17:03,400 --> 00:17:05,780
تسوتشيا-سان، الأمر غير ممكن بالفعل

303
00:17:05,780 --> 00:17:07,200
...الحصان المخطّط ليس

304
00:17:07,200 --> 00:17:08,760
كلا، تمهل

305
00:17:10,950 --> 00:17:13,320
،حتّى لو يمكن لملاك مثل أويدا-سان رؤيتنا

306
00:17:13,320 --> 00:17:16,130
قد لا تستطيع الحيوانات ملاحظتنا بسهولة

307
00:17:16,370 --> 00:17:19,680
قد يكون تمويهاً ممتازاً ضدّ الحيوانات المفترسة
التي تنخفض لتتخفّى

308
00:17:19,680 --> 00:17:22,380
في الحشائش وتنقض على فريستها

309
00:17:22,650 --> 00:17:25,190
شيمودا-كن، انحن هناك من فضلك

310
00:17:25,190 --> 00:17:26,370
حـ-حسناً

311
00:17:26,370 --> 00:17:28,800
وارتدي هذه يا كاناموري-كن

312
00:17:29,340 --> 00:17:32,400
إنّها نظّارات تمكنك
من الرؤية كأسد

313
00:17:33,010 --> 00:17:35,670
كيف الأمر؟ أأنا مخفيّ؟

314
00:17:35,670 --> 00:17:37,420
بارز تماماً

315
00:17:37,420 --> 00:17:39,700
ربما علينا الحركة

316
00:17:39,970 --> 00:17:41,880
بارزون أكثر فأكثر

317
00:17:41,880 --> 00:17:44,650
كأنّكم لا تريدون العيش

318
00:17:45,040 --> 00:17:47,180
ما الذي يفعلونه؟

319
00:17:47,180 --> 00:17:51,680
أتى طلب من العميل بصنع
"حيوانات مخطّطة أكثر"

320
00:17:52,080 --> 00:17:54,790
!حسنٌ! لنصنع حصاناً، حصان مخطّط

321
00:17:55,170 --> 00:17:57,530
ولذا فكّرنا بالأمر معاً

322
00:17:57,530 --> 00:18:01,430
لكن لم نستطع إيجاد منافع في
إضافة تخطيطات لحيوان ضعيف

323
00:18:01,800 --> 00:18:02,930
اقتراح

324
00:18:03,190 --> 00:18:07,280
ما رأيكم بحيوان يبرد بالتخطيطات؟

325
00:18:08,100 --> 00:18:12,620
عند التعرّض للشمس، تختلف دراجة حرارة
الجزء الأبيض عن الأسود، أليس كذلك؟

326
00:18:17,060 --> 00:18:19,200
أيشعرك هذا الزيّ بتبريد حالياً؟

327
00:18:19,680 --> 00:18:21,060
البتّة

328
00:18:21,060 --> 00:18:23,760
أيمكن أنّ أونابارا-سان لم ينم؟

329
00:18:23,760 --> 00:18:27,240
تلقّى طلباً من العميل بصنع حيوان
"كآكل لحوم، لكنّه آكل أعشاب"

330
00:18:27,240 --> 00:18:28,320
ولم ينم ليومين

331
00:18:29,010 --> 00:18:31,980
لا ترغم نفسك على الانضمام لمجموعة التخطيط

332
00:18:31,980 --> 00:18:34,660
لا بأس، فهذا ترويحٌ مناسب

333
00:18:34,660 --> 00:18:39,220
ربما عليّ جعل الحيوان الذي
أصمّمه مخطّطاً أيضاً

334
00:18:39,430 --> 00:18:40,600
!وجدتها

335
00:18:42,150 --> 00:18:44,620
،إذا استعملت قوّة بكتيريا المعدة

336
00:18:44,620 --> 00:18:47,940
سأستطيع صنع آكل لحوم يمكنه
الحصول على المغذّيات من الأعشاب

337
00:18:48,320 --> 00:18:51,850
،لكن بما أنّه لا يملك طاقةً كبيرة
فلن يستطيع التحرّك بسرعة

338
00:18:52,120 --> 00:18:55,880
لذا فكّرتُ بجعله يعيش على أماكن مرتفعة
حيث يقلّ عدد الأعداء

339
00:18:55,880 --> 00:18:57,820
لكن يهطل الثلج على قمم الجبال

340
00:18:58,170 --> 00:19:00,950
ولا يمكنه جمع طاقة كافية للسبات

341
00:19:00,950 --> 00:19:04,030
كما لا مخزون كافٍ لصنع فرو
لوقايته من الثلج شتاءً

342
00:19:04,810 --> 00:19:08,410
!حلّ ذلك هو بالتخطيط! الأبيض والأسود

343
00:19:08,410 --> 00:19:11,390
!بياض للاندماج شتاءً! وسواد للالتئام صيفاً

344
00:19:11,390 --> 00:19:14,070
!أي معطف فرو صيفيّ شتويّ

345
00:19:14,680 --> 00:19:16,010
!رسالة إلهية

346
00:19:16,010 --> 00:19:18,220
!مقبول

347
00:19:18,910 --> 00:19:23,380
أنا مسرورةٌ لك، بروز عينيه أمرٌ ظريف

348
00:19:23,610 --> 00:19:27,740
ألا يفي هذا بطلب الحيوان الضعيف المخطّط أيضاً؟

349
00:19:27,740 --> 00:19:29,000
انتهينا

350
00:19:29,000 --> 00:19:31,980
رئيس تسوتشيا، هل ننسى أمر الحصان المخطّط؟

351
00:19:33,400 --> 00:19:36,290
هاك، جنيتُ ثمار ليالي السهر

352
00:19:36,910 --> 00:19:38,380
سأهتمّ بها

353
00:19:39,120 --> 00:19:40,650
إرسال

354
00:19:40,650 --> 00:19:43,030
كما يُتوقع منك يا أونابارا-سان

355
00:19:43,030 --> 00:19:44,780
...البتّة، لم يكن شيئاً

356
00:19:45,310 --> 00:19:46,230
ما الأمر؟

357
00:19:46,760 --> 00:19:49,220
...لا، يبدو أنّ هذا الصغير

358
00:19:52,920 --> 00:19:53,790
ماذا هناك؟

359
00:19:58,840 --> 00:20:01,260
!علق تصميم آخر به

360
00:20:01,260 --> 00:20:03,390
!كان نجم البحر

361
00:20:03,390 --> 00:20:04,420
نجم البحر؟

362
00:20:04,690 --> 00:20:06,510
ما هي خصائص نجم البحر؟

363
00:20:06,510 --> 00:20:07,750
لا دماغ لديه

364
00:20:07,750 --> 00:20:10,980
مقابل ذلك، يمتلك أعضاء إحساس
بالرائحة في قدميه

365
00:20:10,980 --> 00:20:13,320
وعندما يشمّ رائحة فريسة، يتّجه نحوها

366
00:20:14,030 --> 00:20:15,700
بالمناسبة، نجم البحر آكل لحوم أيضاً

367
00:20:15,700 --> 00:20:18,160
!كلا! إنّه يقترب منّا

368
00:20:18,160 --> 00:20:20,190
أنتِ سريعة الخوف يا كين-تشان

369
00:20:21,150 --> 00:20:22,380
!تلمسه؟

370
00:20:22,380 --> 00:20:23,830
لا بأس

371
00:20:27,280 --> 00:20:29,120
!إنّه يتضاعف

372
00:20:29,120 --> 00:20:31,200
أساسه نجم بحر، فلا عجب

373
00:20:31,200 --> 00:20:34,700
!عندما تحاول الإمساك به، ينزع شعره فيتضاعف عدده

374
00:20:34,700 --> 00:20:37,290
!وهو مخيف

375
00:20:37,730 --> 00:20:40,750
هذه مشكلة، علينا فعل شيء

376
00:20:41,220 --> 00:20:44,300
!هذا لأنّي لم أتحقّق كما يجب

377
00:20:43,480 --> 00:20:45,520
!لا، بل غلطتي لأنّي لم أفعل

378
00:20:45,520 --> 00:20:47,530
!ماذا سنفعل مع هذا؟

379
00:20:47,530 --> 00:20:49,760
!إنّها النهاية

380
00:20:50,860 --> 00:20:52,340
!انتهى أمرنا

381
00:20:53,150 --> 00:20:54,560
لا تقلقوا

382
00:20:56,090 --> 00:20:59,770
هذا ذباب تسي تسي الذي ينقل مرض النوم

383
00:20:59,770 --> 00:21:01,280
يلسع المناطق منتظمة اللون

384
00:21:02,080 --> 00:21:06,810
يُفترض أنّه سيهاجم الباندا بما أنّ
مساحة خطوطه أعرض من ثيابكم

385
00:21:06,810 --> 00:21:08,380
ابقوا ساكنين فحسب

386
00:21:09,510 --> 00:21:11,800
ساكنين هكذا؟

387
00:21:12,100 --> 00:21:13,900
كأنّها رسمة من الجحيم

388
00:21:25,130 --> 00:21:27,090
كنتُ أخشى ما الذي سيحصل لوهلة

389
00:21:27,090 --> 00:21:31,110
استعمال ذباب تسي تسي كان فكرةً مذهلة

390
00:21:31,560 --> 00:21:34,500
بما أنّنا أثبتنا أنّ نسبة
لسع الذباب له منخفضة

391
00:21:34,500 --> 00:21:36,360
هل سنستطيع إنجاح هذا الحصان؟

392
00:21:36,690 --> 00:21:39,190
كان ذلك مذهلاً، لكن رجعنا للحصان؟

393
00:21:39,780 --> 00:21:41,100
!رسالة إلهية

394
00:21:41,100 --> 00:21:43,340
!مقبول

395
00:21:43,650 --> 00:21:45,360
!مرحى

396
00:21:45,710 --> 00:21:48,820
ظننت أنّ المرض لن يؤثر
على هذه الحيوانات الغامضة

397
00:21:48,820 --> 00:21:50,750
لكنّها نامت سريعاً

398
00:21:50,750 --> 00:21:53,130
ذلك لأنّي لعنتها

399
00:21:53,390 --> 00:21:57,430
لـ-لعنتِها؟ أمسموح للملائكة فعل ذلك؟

400
00:21:57,920 --> 00:22:00,170
ربما لا

401
00:22:01,940 --> 00:22:03,870
!رسالة عمل

402
00:22:03,870 --> 00:22:06,670
!أويدا! اذهبي للجحيم