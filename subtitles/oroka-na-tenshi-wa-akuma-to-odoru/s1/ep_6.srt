1
00:01:33,750 --> 00:01:35,300
...أشعر بالنّعاس

2
00:01:35,300 --> 00:01:38,030
.سأفقد وعيي إن لم أحافظ على تركيزي

3
00:01:38,730 --> 00:01:40,330
،أكره الاعتراف بهذا

4
00:01:40,330 --> 00:01:44,670
.لكنّي لم أنم بشكل جيّد ليلة البارحة

5
00:01:41,410 --> 00:01:44,910
...تحديق، تحديق، تحديق، تحديق

6
00:01:44,910 --> 00:01:48,920
.كلّ ذلك بسبب ما حدث البارحة

7
00:01:53,540 --> 00:01:55,340
!عليّ تمالك نفسي

8
00:01:55,700 --> 00:01:57,490
.أنا ملاك

9
00:01:58,660 --> 00:02:05,350
...أنا أهزم الشّياطين وأجعل العالم مكانًا

10
00:02:11,740 --> 00:02:13,030
...أين

11
00:02:14,100 --> 00:02:15,470
أين أنا؟

12
00:02:15,470 --> 00:02:17,860
.كنتُ في الفصل

13
00:02:17,860 --> 00:02:18,780
.مستحيل

14
00:02:22,470 --> 00:02:23,950
...غلبها النّعاس

15
00:02:24,700 --> 00:02:27,310
.لم أنم جيّدًا اللّيلة الماضية أيضًا

16
00:02:27,720 --> 00:02:28,380
ماذا؟

17
00:02:29,180 --> 00:02:31,460
!غلبني النّعاس في الفصل

18
00:02:31,460 --> 00:02:33,780
!يُفترض بي أن أكون تلميذة مجتهدة
!كيف سمحتُ بذلك؟

19
00:02:33,780 --> 00:02:34,630
ماذا هنالك؟

20
00:02:35,570 --> 00:02:36,930
...أنت هناك

21
00:02:38,150 --> 00:02:39,880
هل تحتاجين للمساعدة؟

22
00:02:42,130 --> 00:02:44,270
...ما-ما الّذي

23
00:02:44,750 --> 00:02:47,940
!يظهر أكتسو في حلمي

24
00:02:48,920 --> 00:02:50,190
...لكن

25
00:02:50,650 --> 00:02:52,930
لماذا يبدو حلمي كلعبة محاكاة مواعدة؟

26
00:02:54,220 --> 00:02:55,630
.ذلك ليس مهمًّا الآن

27
00:02:55,630 --> 00:02:57,580
.عليّ إيقاظ نفسي بطريقة ما

28
00:02:58,300 --> 00:02:59,360
!وجدتها

29
00:02:59,850 --> 00:03:04,920
،إن كان كلعبة محاكاة مواعدة
.قد توجد طريقة لهزيمة مسار أكتسو

30
00:03:05,840 --> 00:03:08,290
.لا بأس إذًا. عليّ إنهاء مسار أكتسو فحسب

31
00:03:08,700 --> 00:03:09,980
ماذا هنالك؟

32
00:03:09,380 --> 00:03:11,630
!أكتسو

33
00:03:09,980 --> 00:03:12,090
لماذا تحدّقين بي هكذا؟

34
00:03:13,710 --> 00:03:14,730
!ما هذا؟

35
00:03:14,730 --> 00:03:15,950
!أهو خلل في اللّعبة؟

36
00:03:15,950 --> 00:03:16,800
!هذا مريب

37
00:03:18,090 --> 00:03:19,760
...خيارات

38
00:03:20,150 --> 00:03:21,760
ما-ماذا...؟

39
00:03:23,350 --> 00:03:24,350
.لا يمكنني قراءتها

40
00:03:24,680 --> 00:03:27,560
.ما زال عليّ التّقدّم للأمام

41
00:03:27,560 --> 00:03:29,180
.سأجرّب واحدة

42
00:03:31,700 --> 00:03:35,770
.حسنًا. دعيني أظهر لك قوّتي

43
00:03:33,640 --> 00:03:35,060
!هذا مريب للغاية

44
00:03:35,770 --> 00:03:37,840
!لماذا اللّعبة مليئة بالأعطال؟

45
00:03:37,840 --> 00:03:42,780
.اقتربي لنظرة أفضل

46
00:03:40,760 --> 00:03:42,460
!اخرس

47
00:03:46,060 --> 00:03:47,790
...بالتّفكير في الأمر

48
00:03:48,350 --> 00:03:51,000
لا أعتقد أنّي رأيتُ أماني تغفو
.في الفصل من قبل

49
00:03:51,640 --> 00:03:53,940
.أتساءل كيف تبدو وهي نائمة

50
00:03:58,460 --> 00:03:59,210
.حسنًا

51
00:03:59,930 --> 00:04:01,800
.سأتظاهر أنّي لم أرَ ذلك

52
00:04:10,140 --> 00:04:14,650
...وصلتُ لهذا الحدّ بطريقة التّجربة والخطأ

53
00:04:15,150 --> 00:04:20,010
،عليّ الآن إتمام حدث المواعدة هذا
!وسأكون قد تولّيت أمر أكتسو

54
00:04:20,010 --> 00:04:22,200
.سيوقظني ذلك بكلّ تأكيد

55
00:04:23,540 --> 00:04:24,540
موعد؟

56
00:04:27,910 --> 00:04:30,270
!ما الّذي أفكّر فيه؟

57
00:04:30,270 --> 00:04:32,860
!هذا مجرّد حدث في اللّعبة

58
00:04:32,860 --> 00:04:35,550
!هذا ما انتهى عليه الأمر فحسب

59
00:04:36,940 --> 00:04:37,860
أكتسو؟

60
00:04:38,170 --> 00:04:39,310
.آسف على التّأخير

61
00:04:38,580 --> 00:04:41,160
!ماذا؟

62
00:04:39,310 --> 00:04:40,880
...أتيت في أسرع وقت ممكن

63
00:04:40,880 --> 00:04:41,670
.أعتذر

64
00:04:43,920 --> 00:04:46,470
هـ-هل عليّ إيقاظها؟

65
00:04:47,800 --> 00:04:50,090
.لا تخفني هكذا

66
00:04:50,090 --> 00:04:51,380
...يا لك من

67
00:04:51,380 --> 00:04:52,210
...كلاّ

68
00:04:52,210 --> 00:04:54,460
.تبدو سعيدة، لذلك لن أوقظها

69
00:04:57,090 --> 00:05:00,020
لا أدري إن كان السّبب هو أنّه
،راودتني فكرة الخروج في موعد الغبيّة

70
00:05:00,020 --> 00:05:01,930
.لكنّي لا أستطيع النّظر إلى وجهه

71
00:05:02,580 --> 00:05:03,570
!هذا غباء

72
00:05:03,570 --> 00:05:05,520
!إنّه مجرّد شيطان

73
00:05:05,520 --> 00:05:07,460
لماذا أنا متحمّسة هكذا؟

74
00:05:07,460 --> 00:05:08,740
...ما

75
00:05:13,370 --> 00:05:15,260
...ما الّذي

76
00:05:16,200 --> 00:05:18,200
...كنتُ أفكّر لبعض الوقت

77
00:05:18,870 --> 00:05:22,960
.ربّما أكون واقعًا في حبّك

78
00:05:26,100 --> 00:05:27,380
.أغلقي عينيك

79
00:05:27,380 --> 00:05:31,510
!ما-ما-ما الّذي يتحدّث عنه هذا الشّيطان؟

80
00:05:35,600 --> 00:05:37,690
.لن أغلق عينيّ بطبيعة الحال

81
00:05:40,830 --> 00:05:42,810
لماذا لا أستطيع أخذ قرار؟

82
00:05:42,810 --> 00:05:46,670
...هل لأنّني أريد أن أعرف

83
00:05:47,380 --> 00:05:50,200
إلى أين سيأخذني هذا الخيار؟

84
00:05:50,200 --> 00:05:51,580
...وأيضًا

85
00:05:52,370 --> 00:05:54,200
ما الّذي سيأتي بعد ذلك؟

86
00:05:54,700 --> 00:05:56,830
أغلقي عينيك

87
00:06:02,040 --> 00:06:05,210
.أنا ساموراي الخصر

88
00:06:09,000 --> 00:06:11,430
!أكتسو

89
00:06:14,180 --> 00:06:16,830
!تـ-تماسك

90
00:06:16,830 --> 00:06:18,270
...أنا آسف

91
00:06:18,270 --> 00:06:20,060
.لقد أخفقت

92
00:06:20,510 --> 00:06:22,940
...أكلتُ الكثير، لذلك فإنّ خصري

93
00:06:24,410 --> 00:06:27,690
.لا تنظري إليّ هكذا

94
00:06:27,950 --> 00:06:30,610
.أنا راضٍ

95
00:06:31,110 --> 00:06:33,450
.وقعتُ في الحبّ لأوّل مرّة

96
00:06:34,280 --> 00:06:38,750
...لذلك رجاءً، لمرّة أخيرة فقط

97
00:06:39,330 --> 00:06:40,960
.ابتسمي لأجلي

98
00:06:48,740 --> 00:06:52,850
!أكتسو

99
00:06:54,010 --> 00:06:55,060
أماني؟

100
00:06:56,770 --> 00:06:58,830
.يبدو أنّ كابوسًا راودك

101
00:06:58,830 --> 00:07:00,240
هل أنت بخير؟

102
00:07:00,240 --> 00:07:01,270
أنذهب للممرّضة؟

103
00:07:01,700 --> 00:07:03,930
...أكتسو-كُن

104
00:07:04,990 --> 00:07:07,150
.إذًا فقد كان مجرّد حلم

105
00:07:08,070 --> 00:07:09,860
!لقد أبكاها أكتسو-كُن

106
00:07:09,860 --> 00:07:11,090
!أنا؟

107
00:07:30,810 --> 00:07:34,590
.أنا مرتبكة دائمًا هذه الأيّام

108
00:07:35,650 --> 00:07:40,230
.ظننتُ أنّي متحكّمة أكثر في نفسي

109
00:07:40,860 --> 00:07:42,350
.أعتقد أنّ ما بيدي حيلة

110
00:07:47,340 --> 00:07:50,470
.المنظر من هناك ساطع للغاية

111
00:07:51,430 --> 00:07:53,550
.أستأذن بالدّخول

112
00:07:54,900 --> 00:07:56,590
هل أنت هنا يا أماني؟

113
00:07:56,590 --> 00:07:58,990
.كانت تاناهاشي قلقة عليك أيضًا

114
00:07:58,990 --> 00:08:00,100
.سوف أدخل

115
00:08:04,260 --> 00:08:06,260
ما زالت نائمة؟

116
00:08:06,260 --> 00:08:08,250
!لماذا أكتسو هنا؟

117
00:08:08,250 --> 00:08:10,090
!ما الّذي يريده؟

118
00:08:10,450 --> 00:08:12,810
ما الأسباب الممكنة؟

119
00:08:14,190 --> 00:08:15,810
هل أنت بخير؟

120
00:08:15,810 --> 00:08:18,350
راودك حلم سيّئ لدرجة أنّك
...ذهبت للممرّضة

121
00:08:18,350 --> 00:08:20,100
.أقلقتني كثيرًا عليك

122
00:08:20,380 --> 00:08:22,030
!هذا هو السّبب

123
00:08:22,030 --> 00:08:27,110
إنّه يستعمل عذر الاطمئنان عليّ
!لملء قلبي بمشاعر حلوة ومرّة

124
00:08:28,650 --> 00:08:30,590
.يا لها من خطّة سخيفة

125
00:08:30,590 --> 00:08:33,350
...سأوقفه في حدّه ثمّ

126
00:08:35,490 --> 00:08:37,650
...ثمّ

127
00:08:39,080 --> 00:08:40,780
!ما الّذي أفكّر فيه الآن؟

128
00:08:40,780 --> 00:08:42,360
!إنّه شيطان

129
00:08:44,560 --> 00:08:46,400
!ما الّذي تريده منّي؟

130
00:08:46,400 --> 00:08:48,400
.أنت مستيقظة إذًا

131
00:08:48,400 --> 00:08:50,590
.كان عليك إخباري

132
00:08:50,590 --> 00:08:51,590
...في الحقيقة

133
00:08:56,530 --> 00:08:58,650
!سيقوم بذلك

134
00:08:58,650 --> 00:09:01,350
!سيهاجمني أثناء نومي

135
00:09:02,390 --> 00:09:04,320
أيظنّني فريسة سهلة؟

136
00:09:04,320 --> 00:09:07,100
!لن أسقط بدون قتال

137
00:09:09,110 --> 00:09:10,770
!ما الغاية من ذلك؟

138
00:09:10,770 --> 00:09:12,650
!تستحقّ ذلك

139
00:09:12,650 --> 00:09:14,740
!لن تتفوّق عليّ

140
00:09:15,140 --> 00:09:19,650
لكنّي أشيد بشجاعتك محاولاً
...مهاجمتي أثناء نومي

141
00:09:19,650 --> 00:09:22,350
...وكمكافأة، فسأحرص على أنّك

142
00:09:24,300 --> 00:09:25,560
.كم أنت مريب

143
00:09:25,560 --> 00:09:27,420
!أنت من فعل هذا بي

144
00:09:27,420 --> 00:09:28,900
!ما الغاية من كلّ هذا؟

145
00:09:30,490 --> 00:09:32,260
!أتتظاهر بالغباء؟

146
00:09:32,260 --> 00:09:34,470
!أعلم ما كنت توشك أن تفعله

147
00:09:35,090 --> 00:09:37,400
...كنت ستهاجمني أثناء نومي و

148
00:09:37,400 --> 00:09:42,640
،ستفعل بي ما يحلو لك
!وتُلبسني أزياء من هذا وذاك

149
00:09:42,920 --> 00:09:46,030
.كلاّ، لم يخطر ببالي ذلك حتّى

150
00:09:46,030 --> 00:09:48,590
،كما أنّك كنتِ نائمة
.لذلك كنتُ سأنتظرك في الخارج

151
00:09:48,590 --> 00:09:50,190
.لكنّك خلعت ربطة عنقك

152
00:09:50,190 --> 00:09:50,760
...صحيح

153
00:09:50,760 --> 00:09:52,270
.وفسخت أزرار قميصك

154
00:09:52,730 --> 00:09:54,620
.أردتُ أن أطلب منك معروفًا

155
00:09:55,150 --> 00:09:56,110
.بخصوص هذا

156
00:10:01,140 --> 00:10:04,200
هلاّ محوته رجاءً؟

157
00:10:04,200 --> 00:10:05,690
.قطعًا لا

158
00:10:05,690 --> 00:10:07,000
!أماني

159
00:10:07,000 --> 00:10:08,490
.يكفي

160
00:10:08,490 --> 00:10:11,290
لماذا قد أزيل طوقك بدون أيّ سبب؟

161
00:10:11,290 --> 00:10:13,080
.هناك سبب بالفعل

162
00:10:13,080 --> 00:10:14,170
فعلاً؟

163
00:10:15,190 --> 00:10:18,010
...أنا

164
00:10:19,960 --> 00:10:22,390
!أريد الذّهاب إلى حمّام سينتو خارق

165
00:10:23,740 --> 00:10:26,680
لذلك هل تستطيعين على الأقلّ
تغييره إلى لون أقلّ وضوحًا؟

166
00:10:26,680 --> 00:10:29,310
...وإلاّ، فلن أستطيع حتّى فسخ زرّي العلويّ

167
00:10:29,610 --> 00:10:31,610
!ولن أستطيع دخول المسبح أبدًا

168
00:10:31,610 --> 00:10:33,270
!أكّون

169
00:10:33,270 --> 00:10:37,000
تريد تغييره حتّى تتمكّن من الذّهاب
إلى المسابح وحمّامات السّينتو؟

170
00:10:37,000 --> 00:10:40,710
ألست هنا للعثور على شخص معيّن؟

171
00:10:41,640 --> 00:10:43,120
...بصراحة

172
00:10:43,780 --> 00:10:46,580
.لم أكن أبلي حسنًا جدًّا في الجحيم

173
00:10:49,060 --> 00:10:53,810
إنّ لقاء أشخاص مختلفين في هذا
.العالم أشعرني بالرّضى

174
00:10:54,700 --> 00:11:00,310
،لذلك أريد التّركيز على العمل عندما أعمل
.والاستمتاع بوقتي بالكامل في كلّ شيء آخر

175
00:11:01,190 --> 00:11:04,740
إنّ كلّ شيء هنا ساطع للغاية
.على عكس الجحيم

176
00:11:05,850 --> 00:11:11,020
أعتقد أنّك لن تفهمي الأمر كونك
.ملاكًا تعيش في عالم لامع

177
00:11:12,840 --> 00:11:13,640
ماذا؟

178
00:11:13,640 --> 00:11:15,190
مهلاً، هل أصبتُ وترًا حسّاسًا؟

179
00:11:16,270 --> 00:11:18,820
ما الّذي أتحدّث عنه من الأساس؟

180
00:11:19,090 --> 00:11:21,160
!لماذا أتحدّث عن حياتي هكذا؟

181
00:11:21,160 --> 00:11:24,690
!مريب! مريب! مريب

182
00:11:22,780 --> 00:11:25,580
!سوف تسخر منّي الآن

183
00:11:26,870 --> 00:11:28,340
.أفهم ذلك نوعًا ما

184
00:11:28,340 --> 00:11:30,830
...بالطّبع. أنت ملاك، لذلك

185
00:11:32,680 --> 00:11:36,420
.قلتُ أفهم ذلك نوعًا ما

186
00:11:38,170 --> 00:11:39,300
أماني؟

187
00:11:43,640 --> 00:11:46,680
.أ-أفترض أنّك لم تدع لي خيارًا آخر

188
00:11:47,150 --> 00:11:49,060
.هذا مزعج، ولكن لا بأس

189
00:11:49,710 --> 00:11:54,940
سأطهّر جسمك بشكل جيّد للغاية، ولن تواجه
.أيّ مشاكل في المسابح أو حمّامات السّينتو

190
00:11:58,040 --> 00:12:00,930
ماذا عليّ أن أفعل؟

191
00:12:00,930 --> 00:12:03,200
.أحتاج فقط لإعادة كتابته

192
00:12:03,200 --> 00:12:05,240
.كلّ ما عليك هو الجلوس بثبات

193
00:12:05,730 --> 00:12:06,370
...حسنًا

194
00:12:21,750 --> 00:12:22,820
...ما الّذي

195
00:12:23,300 --> 00:12:24,240
ماذا؟

196
00:12:24,240 --> 00:12:25,160
!هل اقترفتِ خطأ ما؟

197
00:12:25,160 --> 00:12:26,340
!هل سأموت؟

198
00:12:44,810 --> 00:12:47,320
!مهلاً، لم يكن هذا ما أنوي عليه

199
00:12:47,320 --> 00:12:48,620
!اهرب

200
00:12:49,310 --> 00:12:50,080
!ممّاذا أهرب؟

201
00:12:50,080 --> 00:12:51,080
!أكتسو

202
00:12:59,290 --> 00:13:00,300
!أكتسو

203
00:13:00,780 --> 00:13:01,880
!كان ذلك وشيكًا

204
00:13:02,140 --> 00:13:04,330
من تكون على أيّ حال؟

205
00:13:04,330 --> 00:13:05,440
.آسفة

206
00:13:05,440 --> 00:13:07,170
.إنّها سلاح مضادّ للشّياطين

207
00:13:07,170 --> 00:13:08,510
.نسختي

208
00:13:08,840 --> 00:13:10,040
!نسختك؟

209
00:13:11,010 --> 00:13:13,340
.خزّنتها في عنقك

210
00:13:13,340 --> 00:13:15,020
.لا أدري لماذا ظهرت في هذا الوقت

211
00:13:15,020 --> 00:13:17,150
!كان ذلك الشّيء في عنقي؟

212
00:13:17,150 --> 00:13:19,800
.نعم، في حالة ما إذا خُنتني

213
00:13:20,150 --> 00:13:21,050
!أماني

214
00:13:24,330 --> 00:13:25,490
لماذا؟

215
00:13:25,490 --> 00:13:28,490
.إنّها تهاجمني أنا مع أنّي سيّدتها

216
00:13:28,490 --> 00:13:31,700
لا يفترض أن تستجيب لأيّ شيء
.سوى قوّة الشّياطين

217
00:13:31,700 --> 00:13:33,300
!ماذا يحدث؟

218
00:13:33,300 --> 00:13:35,160
أليست إلى جانبك؟

219
00:13:35,860 --> 00:13:38,190
السّبب الوحيد الّذي يخطر ببالي

220
00:13:38,190 --> 00:13:41,500
هو أنّ عُطلاً ما أصابها لتواجدها
.طويلاً في جسد شيطان

221
00:13:41,500 --> 00:13:43,550
وهي الآن في حالة هيجان
...وتهاجم أيًّا كان

222
00:13:44,020 --> 00:13:45,180
!أنت

223
00:13:45,180 --> 00:13:47,590
!انتهى وقت المدرسة منذ مدّة

224
00:13:47,590 --> 00:13:50,890
من الأبله الّذي يُحدث فوضى في فصلي؟

225
00:13:52,640 --> 00:13:54,100
!احمه

226
00:13:54,100 --> 00:13:56,100
!إنّها خارج السّيطرة الآن

227
00:13:56,100 --> 00:13:58,650
!ستهاجم أيّ شيء تراه

228
00:14:19,080 --> 00:14:20,440
!شكرًا لك

229
00:14:20,440 --> 00:14:23,250
!خذه لمكان آخر بسرعة

230
00:14:24,660 --> 00:14:26,880
.إنّها تستعمل القوّة الغاشمة فحسب

231
00:14:26,880 --> 00:14:29,720
.ستتخلّص من هذه القيود قريبًا

232
00:14:29,720 --> 00:14:32,220
!أسرع بينما ما زلتُ أقيّدها

233
00:14:32,700 --> 00:14:35,690
...أهذا أنت يا أكتسو؟ لماذا أنت

234
00:14:35,690 --> 00:14:38,440
.سـ-سمعتُ صوتك وأتيتُ يا سينسي

235
00:14:38,440 --> 00:14:39,690
...فهمت

236
00:14:39,690 --> 00:14:41,310
.لن أنجو

237
00:14:41,310 --> 00:14:43,960
.سينسي، لستَ مصابًا على الإطلاق

238
00:14:43,960 --> 00:14:45,340
.ذلك ليس صحيحًا

239
00:14:45,340 --> 00:14:48,530
.عصفت بي امرأة غامضة بقوّة

240
00:14:49,320 --> 00:14:54,130
.عـ-عليك إخراج الجميع من المدرسة

241
00:14:54,130 --> 00:14:55,900
...رجاءً

242
00:14:55,900 --> 00:15:00,510
!سينسي

243
00:15:02,550 --> 00:15:04,210
!سينسي

244
00:15:04,210 --> 00:15:07,170
أنا أبعده من هنا لأنّك كنت
!بطيئًا في القيام بذلك

245
00:15:07,560 --> 00:15:09,170
.سيكون بخير الآن

246
00:15:12,470 --> 00:15:13,730
!لنهرب إلى السّاحة

247
00:15:13,730 --> 00:15:14,580
!أأنت جادّة؟

248
00:15:14,580 --> 00:15:15,940
.المكان ضيّق هنا

249
00:15:15,940 --> 00:15:17,560
.ستفشل قيودي في كبحها قريبًا

250
00:15:18,180 --> 00:15:21,730
.سأضع حاجزًا، وسأتولّى أمرها هناك

251
00:15:21,730 --> 00:15:23,560
!لا يجب أن نسمح باقتراب أيّ أحد آخر

252
00:15:31,890 --> 00:15:33,870
.وقعت في الفخّ بالكامل

253
00:15:47,500 --> 00:15:48,680
.مذهل

254
00:15:48,680 --> 00:15:51,130
.خشبة المسرح جاهزة الآن

255
00:15:52,720 --> 00:15:54,340
!حان وقت العقاب

256
00:15:54,340 --> 00:15:55,050
!أجل

257
00:16:05,650 --> 00:16:07,860
!الآن! تبّتها

258
00:16:07,860 --> 00:16:09,530
!حسنًا، لك ذلك

259
00:16:13,320 --> 00:16:14,510
لماذا؟

260
00:16:14,510 --> 00:16:17,080
...لا يجدر أن تكون نسختي بتلك القوّة

261
00:16:25,580 --> 00:16:27,850
...يبدو وكأنّ شخصًا ما

262
00:16:31,250 --> 00:16:32,170
...ذلك

263
00:16:33,980 --> 00:16:35,080
!أماني

264
00:16:35,080 --> 00:16:36,590
أنالت منك؟

265
00:16:36,970 --> 00:16:38,780
ما كان ذلك؟

266
00:16:42,060 --> 00:16:44,560
!كفاك من هذا

267
00:16:54,850 --> 00:16:56,370
أهذا معقول؟

268
00:16:59,130 --> 00:17:00,890
!اهربي يا أماني

269
00:17:08,420 --> 00:17:10,490
!قلت اهربي

270
00:17:10,490 --> 00:17:12,920
!ملاك غبيّة

271
00:17:23,290 --> 00:17:25,940
...هذا مؤلم أيّتها الـ

272
00:17:27,430 --> 00:17:28,680
هل أنت بخير؟

273
00:17:28,680 --> 00:17:30,030
!بالطّبع لا

274
00:17:30,030 --> 00:17:31,740
!تمالكي نفسك بسرعة

275
00:17:32,070 --> 00:17:34,920
!لا يمكننا أن نُهزم الآن

276
00:17:37,560 --> 00:17:39,230
!أتيتُ في مهمّة للجحيم

277
00:17:39,230 --> 00:17:40,990
وأنت هنا في مهمّة للسّماء، صحيح؟

278
00:17:40,990 --> 00:17:41,790
.هذا صحيح

279
00:17:41,790 --> 00:17:44,990
.قرّرت صعود سلالم طموحاتي

280
00:17:44,990 --> 00:17:49,020
.كنتُ جاهزة للقيام بأيّ شيء لتحقيق ذلك

281
00:17:49,020 --> 00:17:51,740
!لذلك ما الّذي أفعله الآن؟

282
00:17:52,330 --> 00:17:55,720
.ضعفت ركبتاي بمجرّد أن رأيت ذلك الشّيء

283
00:17:55,720 --> 00:17:56,710
.أنا مثيرة للشّفقة

284
00:17:57,470 --> 00:18:01,090
...لم أتوقّع أبدًا أنّ يذكّرني شيطان

285
00:18:01,670 --> 00:18:06,390
!أنّه لا يجب أن أسمح لنفسي بالتّوقّف هنا

286
00:18:10,040 --> 00:18:11,720
ماذا الآن؟

287
00:18:11,720 --> 00:18:12,520
.اسمع

288
00:18:12,520 --> 00:18:13,860
.لديّ خطّة

289
00:18:13,860 --> 00:18:16,490
.يبدو أنّها تحت سيطرة شخص ما

290
00:18:16,490 --> 00:18:17,610
سيطرة شخص ما؟

291
00:18:17,610 --> 00:18:18,240
.نعم

292
00:18:18,240 --> 00:18:19,240
...لذلك

293
00:18:21,590 --> 00:18:23,870
فعلاً؟ يمكنك ذلك؟

294
00:18:23,870 --> 00:18:25,460
.لا تكن سخيفًا

295
00:18:25,460 --> 00:18:26,870
.ثق بسيّدتك

296
00:18:29,210 --> 00:18:30,040
.حسنًا

297
00:18:30,680 --> 00:18:31,730
!انطلق الآن

298
00:18:31,730 --> 00:18:32,490
!أجل

299
00:18:34,960 --> 00:18:36,210
!الهدوء ضروريّ

300
00:18:44,500 --> 00:18:46,850
،ربّما تكونين سريعة

301
00:18:47,180 --> 00:18:49,910
لكنّ ذلك ليس مهمًّا إن كنت
!تجهلين من أين سأهاجم

302
00:18:49,910 --> 00:18:52,150
!هذه ثغرة

303
00:18:52,150 --> 00:18:53,230
!نلت منك

304
00:18:55,830 --> 00:18:58,690
...مـ-مستحيل

305
00:18:58,690 --> 00:19:00,160
...لا يُعقل

306
00:19:02,220 --> 00:19:04,660
.لم أتوقّع أنّك ستُخدعين بذلك

307
00:19:04,660 --> 00:19:06,660
!لست جيّدة بما يكفي

308
00:19:10,670 --> 00:19:12,810
!أنت لي بمجرّد أن أمسك بك

309
00:19:13,630 --> 00:19:14,170
!أماني

310
00:19:14,480 --> 00:19:15,570
.يا إلهي

311
00:19:15,570 --> 00:19:19,340
.لكان من السّهل أكثر أن أبطلها فحسب

312
00:19:25,220 --> 00:19:26,640
.عرفتُ هذا. ثعابين

313
00:19:26,640 --> 00:19:29,850
!هذه نسختي، لذلك سأستعيدها

314
00:19:47,340 --> 00:19:48,590
هل انتهى الأمر؟

315
00:19:48,590 --> 00:19:49,350
.نعم

316
00:19:51,480 --> 00:19:54,300
.كان ذلك متعبًا أكثر من المعتاد

317
00:19:55,090 --> 00:19:57,090
.جسدي منهك بالكامل

318
00:19:57,090 --> 00:19:58,260
.آسفة

319
00:19:58,260 --> 00:20:00,010
.ما زلتَ مُقيّدًا

320
00:20:00,010 --> 00:20:01,300
هل أنت جادّة؟

321
00:20:01,300 --> 00:20:03,790
ألهذا السّبب لم أكن في كامل قوّتي؟

322
00:20:03,790 --> 00:20:06,040
.شكرًا لأنّك قاتلت بجدّ

323
00:20:06,040 --> 00:20:07,720
لماذا تقولين هذا؟

324
00:20:07,720 --> 00:20:08,620
...صحيح

325
00:20:08,620 --> 00:20:11,730
من الأفضل ألاّ تكوني قد أعدت
.ذلك الشّيء إلى داخلي

326
00:20:11,730 --> 00:20:13,520
.محوت الثّعابين

327
00:20:13,520 --> 00:20:15,170
ماذا عن النّسخة؟

328
00:20:15,170 --> 00:20:18,810
.أعدتها إلى نفسي بالطّبع

329
00:20:20,030 --> 00:20:20,770
!أماني

330
00:20:23,860 --> 00:20:24,730
أماني؟

331
00:20:25,250 --> 00:20:26,020
!أجيبيني

332
00:20:33,300 --> 00:20:34,580
!الحاجز يتداعى

333
00:20:35,210 --> 00:20:36,650
!عليّ الخروج

334
00:20:43,540 --> 00:20:45,510
.لا فائدة منك

335
00:20:46,740 --> 00:20:49,800
...رغم أنّها هزمت ثعابيني

336
00:20:49,800 --> 00:20:52,200
هل كانت بتلك القوّة من قبل؟

337
00:20:52,810 --> 00:20:54,140
.يراودني الفضول الآن

338
00:20:54,860 --> 00:20:57,420
.اذهب لإلقاء نظرة

339
00:20:57,880 --> 00:21:00,000
.لن نحصل على موافقة

340
00:21:00,000 --> 00:21:01,460
.لا بأس

341
00:21:01,460 --> 00:21:03,650
.سأقدّم أنا الطّلب

342
00:21:03,950 --> 00:21:06,700
.حسنًا يا أختي

343
00:21:28,200 --> 00:21:30,620
!ما الّذي أفكّر فيه؟

344
00:21:33,480 --> 00:21:36,180
.يا له من يوم

345
00:21:36,180 --> 00:21:39,050
لم أتوقّع أبدًا أن يقودنا هذا الشّيء
...لكلّ هذه المتاعب

346
00:21:39,050 --> 00:21:41,650
!مهلاً، لم أحلّ هذه المشكلة أبدًا

347
00:21:43,260 --> 00:21:44,600
.آسف

348
00:21:44,600 --> 00:21:46,660
.أظنّ أنّ بإمكاننا التّعامل مع هذا غدًا

349
00:21:46,660 --> 00:21:47,740
.مع السّلامة

350
00:21:54,990 --> 00:21:56,090
أماني؟

351
00:22:00,110 --> 00:22:03,460
.لا تغادر