1
00:01:40,570 --> 00:01:41,810
.شكرًا لك

2
00:01:45,090 --> 00:01:48,610
ذلك المكان الّذي دمّرتَه

3
00:01:49,970 --> 00:01:53,350
.لم يكن يستحقّ أن تتمّ حمايته من الأساس

4
00:01:54,670 --> 00:01:57,150
.وأنت حرّرت ليلي-ساما منه

5
00:01:58,080 --> 00:02:02,910
كلّ ما أمكنني فعله هو المشاهدة
.بلا حول ولا قوّة

6
00:02:03,710 --> 00:02:06,560
.شكرًا على إنقاذك لي

7
00:02:09,580 --> 00:02:12,870
لم يكن عليّ أبدًا إقحام نفسي
.في ذلك الوضع

8
00:02:14,110 --> 00:02:16,050
.ساعدتُ الملائكة بتصرّفي هذا

9
00:02:16,770 --> 00:02:18,910
.إنّ هذا أسوأ شيء قد أفعله كشيطان

10
00:02:20,360 --> 00:02:21,420
...إضافة لذلك

11
00:02:22,020 --> 00:02:25,510
كلّ ما فعلته هو الهرب
.وفقدان السّيطرة وإحداث فوضى

12
00:02:26,920 --> 00:02:27,690
...لكن

13
00:02:29,310 --> 00:02:31,320
لم أخطئ بهذا، صحيح؟

14
00:02:33,350 --> 00:02:34,270
...أنت

15
00:02:36,300 --> 00:02:38,180
.ثمّة فتاة تبكي

16
00:02:38,690 --> 00:02:40,220
.ربّت على رأسي على الأقلّ

17
00:02:43,970 --> 00:02:46,100
أنت رجل. أليس هذا أقلّ ما يمكنك فعله؟

18
00:02:46,500 --> 00:02:49,230
.يمكنك أن تعانقني إن أردت أيضًا

19
00:02:49,450 --> 00:02:52,000
...لا، إنّ ذلك سيكون

20
00:02:52,000 --> 00:02:53,480
.ربّت على رأسي إذًا. بسرعة

21
00:02:54,540 --> 00:02:56,370
ما الّذي تتكلّم عنه؟

22
00:02:58,540 --> 00:02:59,400
.بسرعة

23
00:03:00,170 --> 00:03:01,240
.اخرسي

24
00:03:01,950 --> 00:03:03,240
!أسرع

25
00:03:03,940 --> 00:03:06,330
.يبدو أنّها لن تتخلّى عن هذا الأمر

26
00:03:08,090 --> 00:03:11,450
أعتقد أنّ وضع يدي على رأسها
.ليس سيئًّا لذلك الحدّ

27
00:03:13,800 --> 00:03:15,840
!الوميض الأخير

28
00:03:19,850 --> 00:03:20,810
.جيّد

29
00:03:20,810 --> 00:03:22,130
.صور ممتازة

30
00:03:22,510 --> 00:03:24,610
.أحبّ بيتا 7-4

31
00:03:24,610 --> 00:03:26,540
لماذا تلتقطين صورًا؟

32
00:03:26,540 --> 00:03:28,140
.أجمع بعض الموادّ فحسب

33
00:03:28,810 --> 00:03:29,890
...نعم

34
00:03:29,890 --> 00:03:31,940
.سأرسلها الآن إلى هاتفي

35
00:03:32,460 --> 00:03:33,430
موادّ؟

36
00:03:34,270 --> 00:03:37,250
،إن كنتَ لا تريد أن ترى ليلي-ساما هذه الصّورة

37
00:03:37,250 --> 00:03:40,490
.فستواصل العمل كدرعها من الآن فصاعدًا

38
00:03:42,940 --> 00:03:43,680
!حقيرة

39
00:03:43,680 --> 00:03:45,770
!هل كان كلّ ما قلتِه كذبًا حتّى الآن؟

40
00:03:45,770 --> 00:03:49,090
كنتُ جادّة، لكن خطرت ببالي
.هذه الفكرة للتّوّ فحسب

41
00:03:49,090 --> 00:03:50,360
.كانت فرصة ممتازة

42
00:03:50,360 --> 00:03:51,170
...يا لك

43
00:03:52,140 --> 00:03:54,830
مهلاً، أواثقة أنّ بإمكانك أن تُري ذلك لأماني؟

44
00:03:55,390 --> 00:03:57,350
ألن تكوني في ورطة أيضًا؟

45
00:04:03,830 --> 00:04:06,430
.إنّها تهتمّ لأماني بالفعل

46
00:04:07,340 --> 00:04:12,310
،هذا طبيعيّ لأنّها نسختها
.لكن أراهن أنّ ذلك ليس كلّ شيء

47
00:04:13,780 --> 00:04:17,130
.إنّها متأثّرة جدًّا بشخصيّتها الغريبة بالفعل

48
00:04:17,130 --> 00:04:18,820
...عفوًا

49
00:04:19,120 --> 00:04:20,230
...اسمع

50
00:04:20,670 --> 00:04:22,980
...مقابل إنقاذ ليلي-ساما

51
00:04:23,960 --> 00:04:25,820
فما رأيك بالإمساك بهما؟

52
00:04:28,570 --> 00:04:31,290
!لا تقولي ذلك وكأنّك رجل في متجر مريب

53
00:04:31,290 --> 00:04:32,210
!ما-ماذا؟

54
00:04:32,210 --> 00:04:33,610
.لن أمسك بأيّ شيء

55
00:04:33,610 --> 00:04:34,950
!ستلتقطين صورة لذلك فحسب

56
00:04:42,050 --> 00:04:43,420
أين أنا؟

57
00:04:45,090 --> 00:04:47,930
.تغيّرت ملابسي أيضًا

58
00:04:49,660 --> 00:04:51,270
.أرى أنّك استيقظت

59
00:04:52,780 --> 00:04:54,160
أتريدين أكل شيء ما؟

60
00:04:54,160 --> 00:04:55,650
.لديّ طعام مجمّد فحسب

61
00:04:55,650 --> 00:04:56,930
...أكتسو

62
00:04:56,930 --> 00:04:58,150
لماذا هو هنا؟

63
00:04:59,300 --> 00:05:01,930
.لا، لا بدّ أنّ هذا منزله

64
00:05:02,650 --> 00:05:06,570
ما يعني أنّ من غيّر ملابسي
...لا يمكن أن يكون

65
00:05:08,090 --> 00:05:09,490
!إلاّ أكتسو

66
00:05:15,500 --> 00:05:17,090
.لا، هذا لا يُعقل

67
00:05:17,090 --> 00:05:18,470
.هذا مستحيل

68
00:05:19,620 --> 00:05:21,490
...هل أرتدي

69
00:05:25,570 --> 00:05:27,220
.لا أرتدي شيئًا

70
00:05:27,880 --> 00:05:29,340
ما الخطب؟

71
00:05:29,340 --> 00:05:30,600
هل تشعرين بألم ما؟

72
00:05:41,070 --> 00:05:43,500
!كيف تجرؤ...؟

73
00:05:43,500 --> 00:05:48,900
!كيف تجرؤ؟! كيف تجرؤ؟

74
00:05:48,900 --> 00:05:49,910
!مهلاً

75
00:05:49,910 --> 00:05:52,020
!واضح أنّك مخطئة في أمر ما

76
00:05:55,080 --> 00:05:56,730
!أغلق فمك

77
00:05:56,730 --> 00:06:01,130
!كيف تجرؤ على سلبي نقائي؟

78
00:05:58,180 --> 00:05:58,940
!مهلاً

79
00:06:01,130 --> 00:06:02,750
...ليلي-ساما، ليلي-ساما

80
00:06:06,490 --> 00:06:09,490
اعذريني لأنّني فعلت ذلك
.بينما كنتِ فاقدة للوعي

81
00:06:09,490 --> 00:06:12,510
.آسفة على إخبارك متأخّرًا

82
00:06:25,320 --> 00:06:26,760
.يا إلهي

83
00:06:26,760 --> 00:06:28,360
.كان بإمكانك الاستماع لي أوّلاً

84
00:06:28,860 --> 00:06:30,360
.آسفة

85
00:06:31,810 --> 00:06:34,870
هل تشعرين بأيّ ألم أو ما شابه؟

86
00:06:35,330 --> 00:06:37,270
.أنا بخير

87
00:06:37,530 --> 00:06:38,390
.هذا جيّد

88
00:06:39,080 --> 00:06:39,940
.نعم

89
00:06:44,460 --> 00:06:45,250
...أخبرني

90
00:06:47,170 --> 00:06:50,280
ما الّذي حدث بعد ذلك؟

91
00:06:51,250 --> 00:06:52,550
...أخي

92
00:06:53,390 --> 00:06:55,180
...أنت وأخي

93
00:06:55,180 --> 00:06:56,890
.لم أفعل أيّ شيء له

94
00:06:57,410 --> 00:07:00,390
.جعلتُه يغادر في الحال

95
00:07:00,390 --> 00:07:01,950
.لكنّي حذّرته

96
00:07:03,770 --> 00:07:05,490
.هكذا إذًا

97
00:07:06,180 --> 00:07:08,220
...هناك أمر آخر

98
00:07:08,220 --> 00:07:10,510
...إنّ مظهرك حينها

99
00:07:10,510 --> 00:07:11,780
.مهلاً، مهلاً

100
00:07:12,200 --> 00:07:13,810
...سبق وأخبرتُ ليليا

101
00:07:14,260 --> 00:07:18,330
.بصراحة، لا أعرف لماذا اتّخذتُ تلك الهيئة

102
00:07:18,750 --> 00:07:20,660
.لذلك رجاءً لا تسأليني بعد

103
00:07:21,320 --> 00:07:23,550
لا تعرف؟

104
00:07:26,390 --> 00:07:28,170
.غادر أخي

105
00:07:28,170 --> 00:07:29,750
.حُلّ كلّ شيء

106
00:07:30,390 --> 00:07:32,950
لماذا لا أزال هنا إذًا؟

107
00:07:33,640 --> 00:07:34,970
....أكتسو

108
00:07:35,660 --> 00:07:36,900
...هل

109
00:07:38,770 --> 00:07:40,060
...يُعقل

110
00:07:41,110 --> 00:07:43,940
!أنّك تنوي الانفراد بي؟

111
00:07:44,190 --> 00:07:45,450
!على الإطلاق

112
00:07:45,450 --> 00:07:48,300
—إذًا هل وضعتَ ناعُوظًا

113
00:07:48,300 --> 00:07:49,420
!لم أفعل

114
00:07:49,420 --> 00:07:51,620
!مع أنّي أظنّك تقصدين منوّمًا

115
00:07:52,920 --> 00:07:57,310
،إن أرسل أخوك دعمًا إلى منزلك
.فستكونين في مشكلة

116
00:07:58,500 --> 00:08:00,610
.لذلك السّبب أحضرتك لمنزلي

117
00:08:01,380 --> 00:08:02,390
.أحسنت بذلك

118
00:08:02,820 --> 00:08:03,960
أرأيت؟

119
00:08:04,430 --> 00:08:09,720
ولكن "ناعُوظ"؟
كيف تعرفين تلك الكلمة من الأساس؟

120
00:08:08,290 --> 00:08:10,670
.لا أعرف بصراحة

121
00:08:10,670 --> 00:08:14,760
لا يعرف أكتسو بشأن تلك الهيئة بالفعل؟

122
00:08:17,930 --> 00:08:20,220
.ربّما يكذب عليّ فحسب

123
00:08:20,680 --> 00:08:23,130
.لكنّه لا يبدو ممّن يجيدون الكذب

124
00:08:23,940 --> 00:08:26,980
.لكنّي لم أسمع عن قوّة كهذه من قبل

125
00:08:27,710 --> 00:08:33,540
كلّ ما يمكنني التّفكير فيه
.هو أنّها ملاذ الشّياطين الأخير

126
00:08:35,110 --> 00:08:36,260
...صحيح

127
00:08:36,740 --> 00:08:39,190
.في تلك الحالة، هذه معلومة مهمّة

128
00:08:39,620 --> 00:08:46,290
إن أخبرتهم أنّي بقيت إلى جانبه
.لدراستها أكثر، فقد يتمّ العفو عنّي

129
00:08:47,310 --> 00:08:51,960
قد أنجو من هذا بإخبارهم
.أنّنا قاتلنا أخي لقياس قوّته

130
00:08:52,920 --> 00:08:55,250
.سيحلّ ذلك كلّ شيء

131
00:08:57,550 --> 00:08:58,680
...لكن

132
00:08:59,370 --> 00:09:01,290
...صحيح يا أماني

133
00:09:01,290 --> 00:09:02,350
ماذا هنالك؟

134
00:09:02,910 --> 00:09:04,970
...قد يكون هذا متأخّرًا، لكن

135
00:09:03,560 --> 00:09:06,180
...إن كانت هنالك مشكلة واحدة

136
00:09:06,180 --> 00:09:07,980
...عندما لم أكن واعيًا بما أفعل

137
00:09:07,980 --> 00:09:10,110
...فهي أنّي لا أعرف

138
00:09:10,840 --> 00:09:13,480
.أشكرك على مساعدتي لاستعادة رشدي

139
00:09:17,370 --> 00:09:19,080
...لا أدري

140
00:09:20,700 --> 00:09:22,310
.إن كنتُ أستطيع القيام بذلك

141
00:09:26,060 --> 00:09:27,080
.لا بأس

142
00:09:28,200 --> 00:09:30,350
.لقد تأخّر الوقت

143
00:09:30,790 --> 00:09:32,430
.ربّما من الآمن أن تذهبي الآن

144
00:09:33,010 --> 00:09:34,900
.عليك العودة للمنزل بعد إنهاء كوبك

145
00:09:34,900 --> 00:09:35,970
.سأرافقك إلى هناك

146
00:09:44,040 --> 00:09:45,400
...هنا

147
00:09:46,190 --> 00:09:47,850
ماذا قلت؟

148
00:09:47,850 --> 00:09:48,990
.لا يمكنني سماعك

149
00:09:53,690 --> 00:09:55,530
.سأبيت هنا

150
00:09:58,920 --> 00:09:59,780
!ماذا؟

151
00:09:59,780 --> 00:10:01,280
!عمّ تتحدّثين؟

152
00:10:01,280 --> 00:10:02,990
!ذلك ليس مقبولاً أبدًا

153
00:10:03,450 --> 00:10:06,090
.منزلي صغير على عكس منزلك

154
00:10:06,750 --> 00:10:09,250
.كما لديّ سرير واحد

155
00:10:10,130 --> 00:10:13,620
!لا تسئ الفهم أيّها المنحرف

156
00:10:13,620 --> 00:10:17,920
أنا أتصرّف بحذر فحسب في حالة
!ما إذا نصبوا لي فخًّا في منزلي

157
00:10:17,920 --> 00:10:19,590
!الملائكة مثابرون جدًّا

158
00:10:19,590 --> 00:10:21,610
!لم أسئ الفهم على الإطلاق

159
00:10:21,610 --> 00:10:23,890
!هل لديك أدنى فكرة عمّ تقولينه؟

160
00:10:23,890 --> 00:10:25,230
!اخرس

161
00:10:25,230 --> 00:10:26,770
!قرّرتُ وانتهى الأمر

162
00:10:28,730 --> 00:10:31,700
!وسأنام أنا على السّرير

163
00:10:31,700 --> 00:10:33,150
!لم ينتهي أيّ شيء بعد

164
00:10:33,150 --> 00:10:35,650
!وهل تتوقّعين منّي النّوم على الأرض؟

165
00:10:35,650 --> 00:10:37,150
!لا تقلق حيال ذلك

166
00:10:37,470 --> 00:10:41,160
.سأعطيك غلاف هذا الغطاء

167
00:10:41,730 --> 00:10:42,810
...يا لك من

168
00:10:42,810 --> 00:10:45,970
.بما أنّنا قرّرنا ذلك الآن، حان وقت التّسوّق

169
00:10:46,440 --> 00:10:48,650
!ليليا! ليليا

170
00:10:48,650 --> 00:10:49,260
ماذا؟

171
00:10:49,260 --> 00:10:50,400
!مهلاً لحظة

172
00:10:50,400 --> 00:10:51,960
.اذهبي لشراء ملابس لي

173
00:10:52,290 --> 00:10:53,540
.ومنامة أيضًا

174
00:10:53,540 --> 00:10:55,050
.ولا تنسي فرشاة أسنان

175
00:10:55,700 --> 00:10:58,190
هل توجد أيّ محلاّت مفتوحة الآن؟

176
00:10:58,190 --> 00:10:59,530
.لا بأس

177
00:10:59,530 --> 00:11:00,280
.اذهبي إلى **ـكيو

178
00:11:00,280 --> 00:11:01,100
.لا توجد هنا

179
00:11:01,690 --> 00:11:02,590
.إلى بالـ** إذًا

180
00:11:02,590 --> 00:11:04,040
.لا توجد أيّ منها قريبة من هنا

181
00:11:05,930 --> 00:11:07,240
!أجل

182
00:11:07,240 --> 00:11:09,650
!اذهبي إلى **ـنكي! **ـنكي

183
00:11:09,650 --> 00:11:11,610
تعرفين مجموعة النّوم خارجًا؟

184
00:11:11,610 --> 00:11:16,610
.اشتري ذلك إضافة للشّامبو والبلسم والغسول

185
00:11:16,610 --> 00:11:19,320
!وصابون الجسم والمنظّف

186
00:11:18,340 --> 00:11:20,630
.هذا مزعج للغاية

187
00:11:19,320 --> 00:11:21,480
!تحتاج بشرتي لعناية فائقة

188
00:11:21,480 --> 00:11:22,890
.حسنًا

189
00:11:22,890 --> 00:11:23,950
.سأذهب الآن

190
00:11:29,750 --> 00:11:33,180
.ليلي-ساما، تصبحين على خير

191
00:11:33,180 --> 00:11:34,430
.شكرًا

192
00:11:34,890 --> 00:11:37,950
...أكتسو-دونو، لا تنس ما اتّفقنا عليه من قبل

193
00:11:38,420 --> 00:11:39,710
.اعتن بليلي-ساما

194
00:11:39,710 --> 00:11:41,300
.أ-أكيد

195
00:11:41,830 --> 00:11:44,470
...والآن، أستأذنكما بالذّهاب

196
00:11:54,030 --> 00:11:55,280
...صحيح

197
00:11:55,280 --> 00:11:57,480
.لدينا مدرسة غدًا، لذلك لنذهب للنّوم

198
00:11:57,770 --> 00:11:59,700
.لا حاجة لإخباري بذلك

199
00:11:59,700 --> 00:12:01,990
.سأكون في الحمّام لوهلة

200
00:12:03,500 --> 00:12:04,930
!إيّاك أن تحاول الدّخول

201
00:12:07,200 --> 00:12:08,900
!طبعًا لن أفعل

202
00:12:15,980 --> 00:12:18,460
.أعتقد أنّه يجب أن أبلغهم على الأقلّ

203
00:12:20,260 --> 00:12:23,440
،بصفتي قائدة الشّياطين
.فمن واجبي حماية مستقبلنا

204
00:12:23,440 --> 00:12:26,620
.عليّ أخذ عملي بجدّيّة فائقة

205
00:12:26,620 --> 00:12:28,280
!نعم! هذا مذهل

206
00:12:28,280 --> 00:12:30,640
!ملابس العمل هذه رائعة

207
00:12:32,060 --> 00:12:34,360
.إنّ الرّئيسة لا تجيب

208
00:15:16,490 --> 00:15:18,180
...يا أكتسو

209
00:15:19,700 --> 00:15:26,220
،عندما كان أخي يمسكني على الأرض
.كان الخوف قد تغلّب على عقلي

210
00:15:29,780 --> 00:15:32,890
،رغم أنّي كنت أعلم أنّه لن يؤذيني

211
00:15:33,990 --> 00:15:37,550
...إلاّ أنّ فكرة أنّ أختي الكبيرة كانت تنتظره

212
00:15:38,330 --> 00:15:40,330
.جعلتني أرتعش بلا توقّف

213
00:15:44,610 --> 00:15:49,420
.وحينها تمنّيت أن تساعدني

214
00:15:51,210 --> 00:15:52,650
.في قلبي

215
00:15:53,370 --> 00:15:54,420
.بشدّة

216
00:15:58,220 --> 00:16:01,350
.ثمّ ظهرت

217
00:16:02,170 --> 00:16:06,290
.وواجهتَ أخي

218
00:16:07,950 --> 00:16:10,340
.خادمي الوحيد والأوحد أتى إليّ

219
00:16:11,220 --> 00:16:14,730
.شيطاني الوحيد

220
00:16:17,460 --> 00:16:19,100
.هذا كلّ ما هنالك

221
00:16:19,960 --> 00:16:21,430
...لذلك أتساءل

222
00:16:30,130 --> 00:16:34,230
يا لي من جبانة. هذه هي الطّريقة
.الوحيدة الّتي يمكنني شكرك بها

223
00:16:34,670 --> 00:16:36,040
.أنا آسفة

224
00:16:38,890 --> 00:16:44,660
...لكنّي فعلاً، وبشدّة

225
00:16:57,550 --> 00:16:59,530
.أقدّرك

226
00:17:25,310 --> 00:17:27,060
.لقد استمتعت

227
00:17:27,370 --> 00:17:29,060
.نعم. وأنا كذلك

228
00:17:41,660 --> 00:17:42,790
!يا إلهي

229
00:17:43,090 --> 00:17:45,970
!ما كان عليك الاستيقاظ متأخّرًا
!بالكاد سنصل في الوقت

230
00:17:45,970 --> 00:17:47,500
!وكيف يكون هذا خطئي أنا؟

231
00:17:47,500 --> 00:17:49,460
!خلدتِ للنّوم بسرعة أيضًا

232
00:17:51,090 --> 00:17:54,210
من الأفضل ألاّ تكوني قد فعلتِ
!شيئًا ليلة البارحة

233
00:17:54,540 --> 00:17:57,340
.مثل التّسلّل للثّلاجة بسبب الجوع

234
00:17:58,370 --> 00:18:01,270
!ما كنتُ لأفعل هذا

235
00:18:05,570 --> 00:18:07,250
!ليلي-تشان

236
00:18:07,250 --> 00:18:08,390
!صباح الخير

237
00:18:09,140 --> 00:18:10,190
.صباح الخير

238
00:18:10,710 --> 00:18:12,320
.صباح الخير يا أكتسو-كُن

239
00:18:13,100 --> 00:18:14,530
.نعم، صباح الخير

240
00:18:15,250 --> 00:18:18,320
!أتت ليلي-شان من المنزل مع أكّون ثانية

241
00:18:19,030 --> 00:18:21,870
!ولماذا تشعر بالغيرة من هذا أساسًا؟

242
00:18:21,870 --> 00:18:23,370
!الأمر ليس كذلك

243
00:18:24,030 --> 00:18:27,390
انظر لحالكما يا عصفورا الحبّ
!من الصّباح الباكر

244
00:18:27,390 --> 00:18:29,250
.قابلتُها بالصّدفة فحسب

245
00:18:29,250 --> 00:18:30,500
!قال بالصّدفة قال

246
00:18:30,500 --> 00:18:32,000
.هيّا بنا يا ليلي-تشان

247
00:18:33,150 --> 00:18:35,510
!مهلاً يا كنساكو

248
00:18:35,810 --> 00:18:37,370
.مهلاً، كلاكما

249
00:18:37,370 --> 00:18:42,220
هذه المشاعر الّذي ظهرت
...في قلبي الفارغ

250
00:18:42,220 --> 00:18:45,230
.إنّها كنوز لم أمتلكها من قبل أبدًا

251
00:18:46,510 --> 00:18:49,060
،عندما أتيت إلى هذا العالم في البداية

252
00:18:49,060 --> 00:18:52,500
ما كنتُ لأتصوّر أن يكون لديّ
.شيء أقدّره لهذه الدّرجة

253
00:18:53,420 --> 00:18:58,430
.كلّ هذا بفضلك يا أكتسو

254
00:18:59,930 --> 00:19:06,090
،سأحتفظ بتلك الفكرة لنفسي حاليًّا
.وكلّي سرور بامتلاكي هذه المشاعر

255
00:19:14,080 --> 00:19:15,110
...لكن

256
00:19:15,710 --> 00:19:17,800
...ولكن إن كان هذا كثيرًا

257
00:19:18,950 --> 00:19:24,230
سأكون سعيدة جدًّا إن كانت
.تراودك نفس المشاعر تجاهي

258
00:19:25,850 --> 00:19:26,580
صحيح؟

259
00:19:27,110 --> 00:19:31,510
.يا شيطاني المغفّل اللّطيف والطّيّب

260
00:19:34,460 --> 00:19:35,660
!انتظروني

261
00:19:47,340 --> 00:19:48,690
أختي؟

262
00:19:49,050 --> 00:19:50,090
.نعم

263
00:19:50,090 --> 00:19:52,660
...بشأن تلك المسألة مع ليلي

264
00:19:52,660 --> 00:19:54,440
.لا توجد أيّ مشكلة

265
00:19:54,440 --> 00:19:55,130
.نعم

266
00:19:55,630 --> 00:19:58,670
.كانت في حالة يرثى لها بسبب معموديتك

267
00:19:59,110 --> 00:20:03,430
.لا تزال عديمة الأجنحة كالمعتاد

268
00:20:04,170 --> 00:20:05,960
.لا يوجد ما يدعو للقلق

269
00:20:06,300 --> 00:20:06,900
.نعم

270
00:20:07,640 --> 00:20:08,630
.مع السّلامة

271
00:20:13,960 --> 00:20:15,060
...والآن

272
00:20:15,700 --> 00:20:17,900
ما الّذي سيحدث تاليًا؟

273
00:21:50,990 --> 00:21:52,840
.هنالك شيء غريب حيال هذا

274
00:21:53,160 --> 00:21:58,580
.ملاك مغفّل يرقص مع الشّيطان

275
00:21:59,290 --> 00:22:05,050
.ملاك مغفّل وشيطان بأجنحة مفتوحة

276
00:22:09,540 --> 00:22:11,430
.لم أستطع إبعاد عينيّ عن شعرها اللاّمع

277
00:22:13,910 --> 00:22:17,260
.وعينيها بلون الياقوت اللّتين غلبهما الملل

278
00:22:19,240 --> 00:22:23,030
.وأنفها الصّغير المدبّب
.وشفتيها بلون براعم الكرز

279
00:22:24,130 --> 00:22:27,220
...أدركت في تلك اللّحظة

280
00:22:44,910 --> 00:22:47,340
...انتهت الدّروس، لذلك فبعد المدرسة

281
00:22:51,630 --> 00:22:52,930
...يا إلهي

282
00:22:52,930 --> 00:22:55,730
كيف نسيت شريطي؟

283
00:22:55,730 --> 00:22:57,020
.كم هذا مزعج

284
00:22:58,390 --> 00:23:01,930
لكن لا يجب أن أسمح له
.بإعادته لي في الفصل

285
00:23:02,460 --> 00:23:06,280
.سيسيء الجميع فهم الأمر

286
00:23:08,200 --> 00:23:09,800
!يا-يا رئيسة

287
00:23:09,800 --> 00:23:11,360
.صوت أكتسو

288
00:23:12,250 --> 00:23:14,360
لماذا يصرخ؟

289
00:23:15,170 --> 00:23:17,570
.أكتسو، أتيتُ لاستعادة شريطي

290
00:23:19,390 --> 00:23:20,530
!أكتسو

291
00:23:21,230 --> 00:23:22,990
هل كنتَ بخير؟

292
00:23:32,130 --> 00:23:34,100
...قصّتنا

293
00:23:34,100 --> 00:23:36,860
.ستظلّ مليئة بالفوضى