1
00:00:00,620 --> 00:00:01,660
!انطلق الآن

2
00:00:01,660 --> 00:00:02,390
!أجل

3
00:00:04,900 --> 00:00:06,150
!الهدوء ضروريّ

4
00:00:14,440 --> 00:00:16,750
،ربّما تكونين سريعة

5
00:00:17,120 --> 00:00:19,980
لكنّ ذلك ليس مهمًّا إن كنت
!تجهلين من أين سأهاجم

6
00:00:19,980 --> 00:00:22,080
!هذه ثغرة

7
00:00:22,080 --> 00:00:23,160
!نلت منك

8
00:00:25,730 --> 00:00:28,650
...مـ-مستحيل

9
00:00:28,650 --> 00:00:30,090
...لا يُعقل

10
00:00:32,110 --> 00:00:34,590
.لم أتوقّع أنّك ستُخدعين بذلك

11
00:00:34,840 --> 00:00:36,590
!لست جيّدة بما يكفي

12
00:00:40,600 --> 00:00:42,770
!أنت لي بمجرّد أن أمسك بك

13
00:00:43,560 --> 00:00:44,100
!أماني

14
00:00:44,380 --> 00:00:45,500
.يا إلهي

15
00:00:45,500 --> 00:00:48,020
.لكان من السّهل أكثر أن أبطلها فحسب

16
00:00:48,020 --> 00:00:49,270
!أيّها الشّيطان الرّديء

17
00:00:55,150 --> 00:00:56,570
.عرفتُ هذا. ثعابين

18
00:00:56,570 --> 00:00:59,710
!هذه نسختي، لذلك سأستعيدها

19
00:01:17,310 --> 00:01:18,480
هل انتهى الأمر؟

20
00:01:18,480 --> 00:01:19,250
.نعم

21
00:01:21,420 --> 00:01:24,210
.كان ذلك متعبًا أكثر من المعتاد

22
00:01:25,020 --> 00:01:27,020
.جسدي منهك بالكامل

23
00:01:27,020 --> 00:01:28,180
.آسفة

24
00:01:28,180 --> 00:01:29,970
.ما زلتَ مُقيّدًا

25
00:01:29,970 --> 00:01:31,210
هل أنت جادّة؟

26
00:01:31,210 --> 00:01:33,700
ألهذا السّبب لم أكن في كامل قوّتي؟

27
00:01:33,700 --> 00:01:35,950
.شكرًا لأنّك قاتلت بجدّ

28
00:01:35,950 --> 00:01:37,590
لماذا تقولين هذا؟

29
00:01:37,590 --> 00:01:38,540
...صحيح

30
00:01:38,540 --> 00:01:41,640
من الأفضل ألاّ تكوني قد أعدت
.ذلك الشّيء إلى داخلي

31
00:01:41,640 --> 00:01:43,450
.محوت الثّعابين

32
00:01:43,450 --> 00:01:45,130
ماذا عن النّسخة؟

33
00:01:45,130 --> 00:01:48,710
.أعدتها إلى نفسي بالطّبع

34
00:01:49,960 --> 00:01:50,660
!أماني

35
00:01:53,790 --> 00:01:54,630
أماني؟

36
00:01:55,210 --> 00:01:55,930
!أجيبيني

37
00:02:03,240 --> 00:02:04,510
!الحاجز يتداعى

38
00:02:05,140 --> 00:02:06,490
!عليّ الخروج

39
00:03:58,020 --> 00:04:00,270
!ما الّذي أفكّر فيه؟

40
00:04:03,000 --> 00:04:05,370
.يا له من يوم

41
00:04:05,980 --> 00:04:08,580
لم أتوقّع أبدًا أن يقودنا هذا الشّيء
...لكلّ هذه المتاعب

42
00:04:08,580 --> 00:04:11,380
!مهلاً، لم أحلّ هذه المشكلة أبدًا

43
00:04:12,780 --> 00:04:14,030
.آسف

44
00:04:14,030 --> 00:04:16,180
.أظنّ أنّ بإمكاننا التّعامل مع هذا غدًا

45
00:04:16,180 --> 00:04:17,230
.مع السّلامة

46
00:04:24,920 --> 00:04:26,030
أماني؟

47
00:04:28,190 --> 00:04:31,410
.لا تغادر

48
00:04:32,660 --> 00:04:34,210
!ماذا؟

49
00:04:34,210 --> 00:04:36,080
!ما الّذي تفكّر فيه؟

50
00:04:36,460 --> 00:04:38,600
إن كانت تقول لي ألاّ أعود للمنزل
...في هذا الوقت المتأخّر

51
00:04:38,600 --> 00:04:40,320
فهل يعني أنّها تريدني أن أبيت هنا؟

52
00:04:44,570 --> 00:04:45,970
.إنّها ترتعش

53
00:04:46,890 --> 00:04:48,290
...فهمت

54
00:04:48,290 --> 00:04:50,590
.لم تبدُ على طبيعتها بالفعل

55
00:04:51,690 --> 00:04:54,770
...لستُ توّاقًا لمساعدة ملاك، لكن

56
00:04:57,730 --> 00:04:59,430
.أعتقد أنّ لا خيار لديّ

57
00:05:12,410 --> 00:05:14,770
.كان ذلك يومًا طويلاً

58
00:05:17,020 --> 00:05:21,720
،حتّى بدون النّسخة
.لا يمكنني الهرب ما دمت أملك هذا

59
00:05:23,040 --> 00:05:26,600
طلبتُ منها أن تغيّر لونه على
،الأقلّ للون ليس واضحًا كثيرًا

60
00:05:26,600 --> 00:05:28,650
.لكنّي لم أحصل على أيّ ردّ مباشر منها أيضًا

61
00:05:29,370 --> 00:05:32,870
.قالت أنّ النّسخة كانت تحت سيطرة أحد ما

62
00:05:35,770 --> 00:05:38,070
هل كانت هناك مشاكل ما في الجنّة؟

63
00:05:39,480 --> 00:05:42,100
.مع أنّ هذا ليس مشكلتي أنا في كلّ الأحوال

64
00:05:42,580 --> 00:05:45,610
.لكنّي أتمنّى أن تردّ معروف مساعدتي لها

65
00:05:50,570 --> 00:05:53,060
مهلاً، لماذا انتهى بي المطاف وأنا أساعدها؟

66
00:05:53,910 --> 00:05:56,250
.كان بإمكاني ترك الأمر لها فحسب

67
00:05:56,250 --> 00:05:58,210
!الوداع

68
00:05:58,210 --> 00:06:01,100
هذا لا يعني أنّي أريد رؤيتها
.تموت أمامي أو ما شابه

69
00:06:02,120 --> 00:06:03,620
...مهلاً لحظة، هل أنا

70
00:06:04,200 --> 00:06:06,220
شخص جيّد بالفعل؟

71
00:06:09,940 --> 00:06:10,720
!من أنت؟

72
00:06:15,530 --> 00:06:17,620
.أنا هو أنا

73
00:06:18,120 --> 00:06:20,020
نعم، إذًا من أنت؟

74
00:06:21,030 --> 00:06:22,190
...أنا

75
00:06:22,820 --> 00:06:23,950
!أنت

76
00:06:24,420 --> 00:06:26,200
.إنّه جريء للغاية بالنّسبة لشخص أخطأ للتّوّ

77
00:06:26,930 --> 00:06:28,680
ماذا؟ ماذا يحدث؟

78
00:06:28,680 --> 00:06:29,540
هل أحلم؟

79
00:06:29,940 --> 00:06:31,450
هل أنت دوبلغانغر أو ما شابه؟

80
00:06:31,750 --> 00:06:33,680
.ذلك لا يهمّ

81
00:06:33,680 --> 00:06:35,240
!بل يهمّ كثيرًا

82
00:06:37,140 --> 00:06:39,570
.صحيح أنّك شخص جيّد

83
00:06:40,010 --> 00:06:41,790
لكنّ ذلك ليس كلّ شيء، صحيح؟

84
00:06:42,210 --> 00:06:43,820
ماذا تريد؟

85
00:06:45,310 --> 00:06:47,300
.أنت شيطان

86
00:06:47,300 --> 00:06:49,050
.وهي ملاك

87
00:06:49,340 --> 00:06:53,070
.لا بدّ من سبب جعلك تنقذ العدوّ

88
00:06:53,070 --> 00:06:54,230
سبب؟

89
00:06:54,780 --> 00:06:55,850
.هذا صحيح

90
00:06:56,690 --> 00:06:58,680
!أنت واقع في الحبّ

91
00:06:59,980 --> 00:07:02,810
!ما-ماذا؟

92
00:07:03,730 --> 00:07:05,690
عمّ تتحدّث؟

93
00:07:05,690 --> 00:07:07,380
!واضح أنّ ذلك ليس صحيحًا

94
00:07:08,580 --> 00:07:11,760
.لا بأس. لا حاجة لإخفاء الأمر

95
00:07:11,760 --> 00:07:12,660
...لأنّي

96
00:07:13,300 --> 00:07:17,270
.أعرف كلّ شيء عنك

97
00:07:18,940 --> 00:07:21,650
.لا داعي لكلّ هذه السّلبيّة

98
00:07:21,650 --> 00:07:23,210
.لستُ سلبيًّا

99
00:07:23,520 --> 00:07:26,170
.أعتقد أنّ لديك فرصة جيّدة

100
00:07:27,250 --> 00:07:31,160
.طلبت منك ألاّ تغادر للتّوّ

101
00:07:31,650 --> 00:07:34,230
.واضح أنّ ذلك لأنّها خائفة

102
00:07:34,890 --> 00:07:37,600
.أنت لا تفهم النّساء بالفعل

103
00:07:38,130 --> 00:07:41,980
أيّ نوع من الأشخاص تريد
قربها في وقت كهذا؟

104
00:07:43,370 --> 00:07:45,890
...أعتقد

105
00:07:46,910 --> 00:07:47,730
.هذا صحيح

106
00:07:47,730 --> 00:07:51,740
...إنّ تلك الفتاة

107
00:07:51,740 --> 00:07:53,600
!تكنّ مشاعر لك

108
00:07:53,600 --> 00:07:55,340
!تكنّ مشاعر لي؟

109
00:07:56,980 --> 00:07:58,370
!فهمت

110
00:07:58,370 --> 00:08:00,660
!فهم مثاليّ

111
00:07:58,370 --> 00:08:00,660
!أفهم الأمر بشكل مثاليّ الآن

112
00:08:01,090 --> 00:08:04,710
بتعبير آخر، الفتاة النّائمة على
السّرير هناك معجبة بي؟

113
00:08:06,080 --> 00:08:08,790
!تفهم الأمر بشكل مثاليّ، صحيح؟

114
00:08:13,080 --> 00:08:15,290
.استيقظت الأميرة

115
00:08:15,290 --> 00:08:18,430
!حسنًا، أريني وجهك الظّريف

116
00:08:19,070 --> 00:08:20,670
!يا للحماسة

117
00:08:20,670 --> 00:08:22,060
!يا للإثارة

118
00:08:51,590 --> 00:08:53,220
أنا في منزلي؟

119
00:08:55,830 --> 00:08:58,090
.أعتقد أنّي لم أغيّر ملابسي

120
00:09:20,680 --> 00:09:23,310
.لا أذكر كيف وصلت للمنزل

121
00:09:24,940 --> 00:09:25,780
!أكتسو

122
00:09:25,780 --> 00:09:27,010
!ماذا حدث لك؟

123
00:09:27,010 --> 00:09:28,320
!لماذا أنت هنا؟

124
00:09:28,320 --> 00:09:29,650
...سينسي

125
00:09:29,650 --> 00:09:31,710
...رجاءً لا

126
00:09:31,710 --> 00:09:33,150
.يتحدّث في نومه

127
00:09:33,460 --> 00:09:35,540
لماذا هو في غرفتي؟

128
00:09:36,470 --> 00:09:45,230
.لا تغادر

129
00:09:48,990 --> 00:09:53,290
!ما الّذي فعلتِه أيّتها الغبيّة النّعسانة؟

130
00:09:53,290 --> 00:09:55,110
.لم يبق لديّ أيّ خيار

131
00:09:55,530 --> 00:10:01,570
سأمحو ذكرياتك بهذا الشّيء
!الشّبيه بأطلال بعلبكّ

132
00:10:13,180 --> 00:10:14,380
...صحيح

133
00:10:14,380 --> 00:10:15,830
...أصيب بذلك

134
00:10:16,760 --> 00:10:18,780
.عندما حاول حمايتي وقتها

135
00:10:29,570 --> 00:10:33,480
لماذا أنقذتني؟

136
00:10:34,070 --> 00:10:35,760
.نحن عدوّان

137
00:10:35,760 --> 00:10:38,520
.كان بإمكانك التّخلّي عنّي

138
00:10:38,520 --> 00:10:40,760
...أو هل يُعقل

139
00:10:41,260 --> 00:10:42,370
...أنّك

140
00:10:43,300 --> 00:10:46,120
...في كلّ الأحوال، أنا

141
00:10:46,700 --> 00:10:48,840
.أشكرك على ذلك

142
00:10:51,550 --> 00:10:52,710
!ها قد شكرتك

143
00:10:52,710 --> 00:10:55,530
!فلا تجرؤ على طلب المزيد من الامتنان منّي

144
00:10:55,530 --> 00:10:56,840
!أو أيّ مكافأة

145
00:10:57,220 --> 00:11:02,090
!تبًّا! قلتُ فعلاً أنّي سأمنحه مكافأة كبيرة

146
00:11:02,650 --> 00:11:07,560
سأمنحك عناقًا مقابل كلّ مهمّة
.تؤدّيها على أحسن وجه

147
00:11:07,560 --> 00:11:11,940
...كنتُ أمزح فحسب، لكن إن تذكّر لك

148
00:11:12,390 --> 00:11:16,210
ما فعله يعادل عشرة آلاف
.مهمّة أدّاها على أحسن وجه

149
00:11:16,210 --> 00:11:19,170
...سينسي، أنت ثقيل جدًّا

150
00:11:19,170 --> 00:11:23,880
هذا جُبن، لكن أفترض أنّ عليّ
.جعلها حقيقة ثابتة

151
00:11:24,590 --> 00:11:28,830
.بالمناسبة، لقد أبليت حسنًا

152
00:11:28,830 --> 00:11:29,980
...سأكافئك

153
00:11:29,260 --> 00:11:32,030
...عناق

154
00:11:36,420 --> 00:11:38,130
...ما-ما الّذي

155
00:11:38,130 --> 00:11:39,420
!هل فقدت عقلك؟

156
00:11:39,420 --> 00:11:41,340
!مستحيل أن نقوم بذلك

157
00:11:41,340 --> 00:11:43,680
!لا تتصرّف بسخافة

158
00:11:45,150 --> 00:11:47,430
!كنتُ أنا من ذكر ذلك أوّلاً

159
00:11:48,260 --> 00:11:49,210
ماذا أفعل؟

160
00:11:49,210 --> 00:11:52,860
.لا تسمح لي كرامتي بالتّراجع عمّا قلتُه

161
00:11:52,860 --> 00:11:53,650
!ومع ذلك

162
00:11:55,130 --> 00:11:56,830
!ماذا؟! عناق؟

163
00:11:56,830 --> 00:11:59,110
!هذا محرج للغاية

164
00:11:59,110 --> 00:12:03,110
...توقّف يا سينسي... أرجوك لا

165
00:11:59,380 --> 00:12:03,110
هل أتظاهر أنّ ذلك لم يحدث أبدًا؟

166
00:12:09,950 --> 00:12:12,740
.هذه المرّة فحسب

167
00:12:12,740 --> 00:12:14,290
.لن أقوم بهذا ثانية

168
00:12:17,070 --> 00:12:19,500
.هذه المرّة فحسب

169
00:12:19,500 --> 00:12:21,460
.لن أقوم بهذا ثانية

170
00:12:31,610 --> 00:12:32,770
.مهلاً

171
00:12:32,770 --> 00:12:35,150
.أكتسو نائم

172
00:12:35,150 --> 00:12:37,060
.لا يمكنني أن أعانقه الآن

173
00:12:37,480 --> 00:12:40,020
.ولا أستطيع إيقاظه أيضًا

174
00:12:40,020 --> 00:12:41,360
...ما-ماذا

175
00:12:44,530 --> 00:12:49,150
ومع ذلك، لا أريده أن يواصل
.مضايقتي عندما يستيقظ أيضًا

176
00:12:49,150 --> 00:12:52,130
!أنا في مشكلة سواء فعلتُ أم لا

177
00:12:53,560 --> 00:12:55,000
.حسنًا، التّالي

178
00:12:55,000 --> 00:12:58,890
.بهدف فهمت النّساء، عليك التّفكير كالنّساء

179
00:12:58,890 --> 00:13:00,840
.ستفهم حينها بشكل طبيعيّ

180
00:13:00,840 --> 00:13:03,510
.حسنًا، سأقوم بتوضيح الآن

181
00:13:04,780 --> 00:13:08,030
!بـ-بسرعة

182
00:13:09,550 --> 00:13:10,960
ما كان ذلك؟

183
00:13:10,960 --> 00:13:12,830
!لا تفكّر! اشعر

184
00:13:12,830 --> 00:13:13,770
!جرّب

185
00:13:15,870 --> 00:13:17,650
!بسرعة

186
00:13:17,650 --> 00:13:18,680
!أجل

187
00:13:18,680 --> 00:13:20,330
!كرّر ذلك

188
00:13:20,330 --> 00:13:21,760
!بسرعة

189
00:13:21,760 --> 00:13:24,670
!جيّد! كن أنثويًّا أكثر

190
00:13:25,290 --> 00:13:26,990
...بـ-بـ

191
00:13:29,030 --> 00:13:30,700
!بسرعة

192
00:13:31,280 --> 00:13:33,000
!إنّه مستيقظ

193
00:13:33,000 --> 00:13:34,570
مهلاً، أما زال نائمًا؟

194
00:13:35,430 --> 00:13:37,830
لا أصدّق أنّه قد يشجّعني
...حتّى في نومه

195
00:13:37,830 --> 00:13:39,680
!بسرعة

196
00:13:38,950 --> 00:13:40,090
!اخرس

197
00:13:40,090 --> 00:13:42,590
!كنتُ أوشك أن أقوم بذلك

198
00:13:43,820 --> 00:13:45,130
...لكن

199
00:13:45,450 --> 00:13:47,380
من أين أبدأ؟

200
00:13:50,640 --> 00:13:51,720
!وجدتها

201
00:13:51,720 --> 00:13:52,930
!ذلك هو المكان

202
00:13:52,930 --> 00:13:55,730
.سأكون مناسبة للعناق إن اتّسعتُ هناك

203
00:14:26,820 --> 00:14:30,050
!إيّاك أن تستيقظ يا أكتسو

204
00:14:35,480 --> 00:14:38,020
...سيكون ذلك كافيًا

205
00:14:43,230 --> 00:14:47,490
!حا-حا-حالة طارئة

206
00:14:57,780 --> 00:14:59,780
هل يرتعش؟

207
00:15:01,210 --> 00:15:04,880
.كاد يفقد حياته بالفعل

208
00:15:04,880 --> 00:15:06,300
.لا ألومه

209
00:15:06,800 --> 00:15:09,420
.من الطّبيعيّ أن تراوده كوابيس

210
00:15:13,690 --> 00:15:21,090
لكنّي لم أفكّر أبدًا أنّ مجرّد التّواجد
.برفقة أحد ما قد يكون مريحًا هكذا

211
00:15:23,150 --> 00:15:25,270
.نسيت تمامًا

212
00:15:25,650 --> 00:15:27,900
.عليّ تغيير لون ذلك الطّوق

213
00:15:29,560 --> 00:15:31,000
.يا إلهي

214
00:15:36,070 --> 00:15:40,910
يبدو أنّ مكافأته ستكون مميّزة
.في النّهاية بالفعل

215
00:15:53,450 --> 00:15:55,170
.سيفي ذلك بالغرض

216
00:15:59,930 --> 00:16:01,780
.آسف، لا مال لديّ

217
00:16:01,780 --> 00:16:03,180
!هل أنت لصّ؟

218
00:16:03,180 --> 00:16:05,440
!سأرسلك لك فاتورة لاحقًا

219
00:16:05,440 --> 00:16:09,690
كيف أحضرني للمنزل على أيّ حال؟

220
00:16:12,380 --> 00:16:14,300
.لا، مستحيل

221
00:16:16,360 --> 00:16:18,370
.لا، لا، لا

222
00:16:19,060 --> 00:16:20,530
...ما يعني

223
00:16:29,350 --> 00:16:31,800
!لقد حملني بكلّ تأكيد

224
00:16:45,420 --> 00:16:46,600
!ما الّذي يحدث؟

225
00:16:46,600 --> 00:16:48,590
!لا بدّ أنّ أماني من فعلت هذا

226
00:16:55,210 --> 00:16:56,350
.أظنّني سأغدر

227
00:17:16,490 --> 00:17:18,080
...تذكّرت

228
00:17:18,080 --> 00:17:19,420
...القفل

229
00:17:41,850 --> 00:17:42,830
.عفوًا

230
00:17:42,830 --> 00:17:44,270
هل أيقظتك؟

231
00:17:44,270 --> 00:17:47,330
.لا، إنّه وقت استيقاظي على أيّ حال

232
00:17:47,330 --> 00:17:48,140
.هكذا إذًا

233
00:17:48,620 --> 00:17:50,380
كيف تشعرين؟

234
00:17:50,800 --> 00:17:53,640
.لا أحتاج ليقلق شيطان عليّ

235
00:17:53,640 --> 00:17:56,270
.يبدو أنّك بخير

236
00:17:56,270 --> 00:17:58,390
لماذا لا تزال هنا؟

237
00:18:02,990 --> 00:18:04,090
ما هذا؟

238
00:18:04,520 --> 00:18:06,550
.كنتُ جائعًا

239
00:18:06,550 --> 00:18:09,050
.لذلك ألقيتُ نظرة على ما لديك في الثّلاّجة

240
00:18:10,270 --> 00:18:13,540
،ليس لذلك ما قصدتُه
بل لماذا أعدد طعامًا لي؟

241
00:18:13,540 --> 00:18:14,330
.لأشكرك

242
00:18:14,330 --> 00:18:15,140
علام؟

243
00:18:15,700 --> 00:18:16,810
.على هذا

244
00:18:20,230 --> 00:18:21,870
.أقوم بواجبي كمالكتك فحسب

245
00:18:21,870 --> 00:18:22,700
.نعم، نعم

246
00:18:23,100 --> 00:18:25,330
.كما لا أستطيع إقفال الباب هنا

247
00:18:25,330 --> 00:18:26,280
...لذلك فكّرت

248
00:18:26,280 --> 00:18:28,880
.سيُقفل وحده إن أغلقته

249
00:18:28,880 --> 00:18:30,560
.هكذا إذًا

250
00:18:30,560 --> 00:18:31,540
.إنّه قفل تلقائيّ

251
00:18:38,050 --> 00:18:40,350
.دعينا من ذلك ونبدأ بالأكل

252
00:18:40,810 --> 00:18:43,900
لكنّه لن يكون جيّدًا
.مثل الباستا الّتي حضّرتِها

253
00:18:44,740 --> 00:18:47,300
.أنت لا أدري ذلك

254
00:18:48,420 --> 00:18:50,130
.لا يهمّ

255
00:18:55,590 --> 00:18:57,490
...شكرًا على الطّعام

256
00:18:57,820 --> 00:18:58,910
.ويحي

257
00:19:00,820 --> 00:19:02,500
.لنأكل

258
00:19:11,160 --> 00:19:13,710
.هذه المرّة فقط

259
00:19:17,990 --> 00:19:19,090
ماذا؟

260
00:19:20,010 --> 00:19:22,360
.كنتُ أتظاهر قليلاً فحسب

261
00:19:25,210 --> 00:19:27,310
.لديك الكثير من الفلفل الأخضر في منزلك

262
00:19:27,310 --> 00:19:29,450
.كان عليه تخفيض في السّوق

263
00:19:30,250 --> 00:19:32,880
،لماذا تشتريه إذا كنت تكرهينه
حتّى لو كان عليه تخفيض؟

264
00:19:32,880 --> 00:19:34,750
.لم أقل أبدًا أنّي أكرهه

265
00:19:34,750 --> 00:19:35,890
ماذا؟ فعلاً؟

266
00:19:35,890 --> 00:19:37,450
.اخرس وكُل فحسب

267
00:19:37,450 --> 00:19:37,980
.حسنًا

268
00:19:58,430 --> 00:20:01,090
.إنّه يشعّ بشكل غريب

269
00:20:04,740 --> 00:20:05,750
.إلى اللّقاء

270
00:20:06,410 --> 00:20:07,470
!مهلاً

271
00:20:07,470 --> 00:20:09,470
.المدرسة من هنا

272
00:20:09,810 --> 00:20:12,020
.لن أحضر الحصّة الأولى

273
00:20:12,020 --> 00:20:14,350
.سأذهب للمنزل لأستحمّ

274
00:20:14,350 --> 00:20:17,410
هل تعتقد حقًّا أنّ هذا مقبول؟

275
00:20:17,410 --> 00:20:19,520
.ليس عليك قول ذلك بهذه الطّريقة

276
00:20:19,520 --> 00:20:21,740
.لقد انشغلتُ بمساعدتك البارحة

277
00:20:23,000 --> 00:20:26,440
.نعم، نعم، من الجيّد أنّك أنقذتني البارحة

278
00:20:26,440 --> 00:20:27,660
لماذا نبرة التّهكّم تلك؟

279
00:20:27,660 --> 00:20:33,160
،لو قضى عليّ ذلك الشّيء
.لانفجر طوقك

280
00:20:33,160 --> 00:20:34,930
!أنت تمزحين

281
00:20:40,570 --> 00:20:42,500
!كيف يكون هذا ممكنًا؟

282
00:20:43,350 --> 00:20:44,430
.كذبت

283
00:20:44,430 --> 00:20:46,640
!كفّي عن أكاذيبك السّخيفة

284
00:20:46,640 --> 00:20:47,930
هل أخفتك؟

285
00:20:48,310 --> 00:20:49,390
ماذا؟

286
00:20:50,120 --> 00:20:51,200
.إطلاقًا

287
00:20:51,200 --> 00:20:52,830
.لقد غيّرتُ لونه

288
00:20:52,830 --> 00:20:53,910
.كن ممتنًّا

289
00:20:54,690 --> 00:20:57,190
.فعلتُ ذلك بينما كنتَ نائمًا

290
00:20:57,740 --> 00:20:59,730
.لقد وعدتك

291
00:20:59,730 --> 00:21:00,860
فعلاً؟

292
00:21:00,860 --> 00:21:02,620
!مرحى

293
00:21:02,990 --> 00:21:05,250
!شكرًا يا أماني

294
00:21:05,250 --> 00:21:06,940
!ها أنا قادم يا حمّامات السّنتو الخارقة

295
00:21:06,940 --> 00:21:08,530
!ها أنا قادم أيّتها المسابح

296
00:21:08,530 --> 00:21:10,520
!توقّف، أنت تحرجني

297
00:21:12,700 --> 00:21:15,210
!عجبًا، عجبًا

298
00:21:17,380 --> 00:21:23,720
أ-أكّون وليلي-تشان يقومان
!بأمور صباحيّة معًا

299
00:21:23,720 --> 00:21:27,010
!أمور صباحيّة

300
00:22:59,720 --> 00:23:02,890
!عانقني بشدّة

301
00:23:02,890 --> 00:23:06,370
!يكفي رجاءً

302
00:23:07,820 --> 00:23:11,880
.كاد يفقد حياته بالفعل

303
00:23:11,880 --> 00:23:13,320
.لا ألومه

304
00:23:15,710 --> 00:23:19,630
.من الطّبيعيّ أن تراوده كوابيس

305
00:23:24,670 --> 00:23:27,200
.إذًا فذلك ما حدث بالفعل

306
00:23:27,200 --> 00:23:29,490
.أنقذهما سوء فحسب

307
00:23:29,490 --> 00:23:33,350
إذًا فقد كانت هناك فرصة
.خفيّة في أسوأ الحالات

308
00:23:34,030 --> 00:23:37,410
من المضحك كيف تجري الحياة، صحيح؟