1
00:00:02,210 --> 00:00:05,400
.لم أستطع إبعاد عينيّ عن شعرها اللاّمع

2
00:00:08,710 --> 00:00:11,450
.وعينيها بلون الياقوت اللّتين غلبهما الملل

3
00:00:12,090 --> 00:00:14,120
.وأنفها الصّغير المدبّب

4
00:00:14,580 --> 00:00:16,390
.وشفتيها بلون براعم الكرز

5
00:00:19,440 --> 00:00:22,700
...أدركت في تلك اللّحظة

6
00:00:23,990 --> 00:00:25,160
...أنّ هذه الفتاة

7
00:02:03,780 --> 00:02:05,760
سمعتُ أنّ هنالك تلميذًا جديدًا
.سينتقل إلينا اليوم

8
00:02:05,760 --> 00:02:08,080
.في شهر ماي؟ هذا لا يحدث عادة

9
00:02:08,080 --> 00:02:09,260
!أتساءل كيف سيكون

10
00:02:09,260 --> 00:02:10,520
.آمل أن يكون وسيمًا

11
00:02:10,520 --> 00:02:12,160
.ها قد بدأنا

12
00:02:12,160 --> 00:02:13,480
ولِمَ لا؟

13
00:02:13,480 --> 00:02:15,560
.يمكنك الدّخول عندما أناديك

14
00:02:15,560 --> 00:02:17,210
.لا يوجد ما يدعو للقلق

15
00:02:17,210 --> 00:02:19,390
.واثق أنّك ستنسجم مع الجميع

16
00:02:19,390 --> 00:02:21,630
.شكرًا لك

17
00:02:21,630 --> 00:02:22,540
.العفو

18
00:02:25,940 --> 00:02:27,520
.حسنًا، اجلسوا في مقاعدكم

19
00:02:27,520 --> 00:02:28,800
.حاضر

20
00:02:28,800 --> 00:02:33,380
،كما يعلم بعضكم
.سينضمّ لكم تلميذ جديد

21
00:02:33,380 --> 00:02:35,430
.ها قد بدأنا

22
00:02:36,130 --> 00:02:38,280
.حسنًا، تفضّل بالدّخول

23
00:02:39,050 --> 00:02:40,540
!هيّا بنا

24
00:02:41,440 --> 00:02:43,500
.أكتسو ماساتورا-كُن

25
00:02:43,500 --> 00:02:44,890
.إنّه في السّادسة عشر

26
00:02:47,160 --> 00:02:50,730
،عندما كان صغيرًا
،لم يحبّ حلق شعره بالكامل

27
00:02:50,730 --> 00:02:55,450
لذلك حاول استعمال منشّط نموّ شعر
.والده الّذي اتّضح أنّه كريم إزالة شعر

28
00:02:55,450 --> 00:02:57,260
.كان الأوان قد فات عندما أدرك ذلك

29
00:02:58,370 --> 00:03:01,450
.وأنا أعرف ذلك الشّعور جيّدًا

30
00:03:01,450 --> 00:03:04,320
.حسنًا يا أكتسو، رحّب بالجميع

31
00:03:04,320 --> 00:03:05,180
.حاضر

32
00:03:05,180 --> 00:03:06,710
.سررت بلقائكم

33
00:03:07,280 --> 00:03:09,000
.أنا أكتسو ماساتورا

34
00:03:09,460 --> 00:03:11,480
.هوايتي هي استكشاف الصّيدليّات

35
00:03:11,480 --> 00:03:13,760
...كلمتي المفضّلة

36
00:03:13,760 --> 00:03:15,670
.بُصيلات شعر

37
00:03:16,170 --> 00:03:17,210
!عِش رجاءً

38
00:03:17,210 --> 00:03:21,690
.لم أحظ بحياة جيّدة حتّى الآن

39
00:03:21,690 --> 00:03:29,980
لكنّي آمل أن أصنع ذكريات
.جيّدة مع الجميع هنا

40
00:03:29,980 --> 00:03:31,730
!لنصفّق له جميعًا

41
00:03:33,490 --> 00:03:35,430
!كُن قويًّا

42
00:03:35,430 --> 00:03:36,650
!أنت لها

43
00:03:37,240 --> 00:03:40,040
كيف لم يستطيعوا اكتشاف
كذبة واضحة كهذه؟

44
00:03:40,040 --> 00:03:43,490
!البشر بسطاء للغاية

45
00:03:43,490 --> 00:03:45,640
.هناك شيء ما على رأسك

46
00:03:57,240 --> 00:03:58,630
...أكتسو

47
00:03:58,630 --> 00:04:01,000
.أرى أنّ رأسك مليء بالشّعر

48
00:04:01,680 --> 00:04:04,030
هل تحاول إهانتي؟

49
00:04:04,030 --> 00:04:05,930
!لقد نمى للتّوّ فحسب

50
00:04:05,930 --> 00:04:08,060
!تخلّصتُ من كلّ خلاياي القديمة

51
00:04:08,060 --> 00:04:08,860
!سُحقًا

52
00:04:08,860 --> 00:04:10,920
لماذا كان عليك أن تنمو الآن؟

53
00:04:10,920 --> 00:04:12,560
...يا لهذه

54
00:04:12,560 --> 00:04:15,060
!البُصيلات

55
00:04:15,460 --> 00:04:18,270
!أكتسو، ما الّذي تظنّ نفسك فاعلاً؟

56
00:04:18,270 --> 00:04:19,840
!لا توقفني يا سينسي

57
00:04:19,840 --> 00:04:21,580
!انزع شعري وتخلّص منه

58
00:04:21,580 --> 00:04:23,570
...انزع شعري و

59
00:04:23,940 --> 00:04:25,850
.حسنًا، هذا كلّ شيء

60
00:04:25,850 --> 00:04:27,790
أحسنوا معاملته جميعًا، مفهوم؟

61
00:04:27,790 --> 00:04:29,320
.حاضر

62
00:04:29,320 --> 00:04:31,240
.ذاك هناك هو مقعدك

63
00:04:31,240 --> 00:04:32,370
.حاضر

64
00:04:33,430 --> 00:04:37,910
فعلتُ ما قيل لي، ولكن ربّما
.كان عليّ أن أحذر أكثر

65
00:04:39,000 --> 00:04:43,010
.يبدو أنّ لا أحد يشكّ في حقيقتي بعد

66
00:04:52,520 --> 00:04:54,920
.إنّها ظريفة

67
00:04:54,920 --> 00:04:56,710
.وجميلة

68
00:04:58,080 --> 00:05:00,410
لم أعتقد أبدًا أنّ فتاة بشريّة
.قد تكون جميلة هكذا

69
00:05:05,030 --> 00:05:06,520
!ما كان هذا؟

70
00:05:06,520 --> 00:05:08,950
ما هذا الشّعور الدّافئ الّذي يملأ صدري؟

71
00:05:08,950 --> 00:05:10,600
!أكتسو، ما خطبك؟

72
00:05:10,600 --> 00:05:18,110
!ما الّذي يحدث لجسدي؟

73
00:05:13,930 --> 00:05:16,080
!أكتسو! أكتسو

74
00:05:16,950 --> 00:05:18,540
!أكتسو

75
00:05:20,840 --> 00:05:22,470
هل نُكلّمه؟

76
00:05:21,750 --> 00:05:24,030
ما كان ذلك؟

77
00:05:24,030 --> 00:05:26,260
.ما زلت أشعر بدوار

78
00:05:26,870 --> 00:05:29,240
.لكنّها ظريفة جدًّا

79
00:05:29,240 --> 00:05:30,680
.نقيّة وجميلة جدًّا

80
00:05:30,680 --> 00:05:32,560
.فاتنة ومثاليّة

81
00:05:32,560 --> 00:05:36,090
سأكون راضيًا عن حياتي إن كانت
.فتاة مثلها هي حبيبتي

82
00:05:39,410 --> 00:05:41,440
.إنّها تُمطر بغزارة فجأة

83
00:05:41,860 --> 00:05:44,680
!مهلاً، لم أرتدي ملابسي بعد

84
00:05:46,690 --> 00:05:47,910
!نعم

85
00:05:52,980 --> 00:05:54,470
...أكتسو-كُن

86
00:05:55,010 --> 00:05:56,470
.أنا جاهزة

87
00:05:57,250 --> 00:05:58,110
!أجل

88
00:05:58,110 --> 00:06:01,610
.ربّما عليّ أن أطلب منها ذلك الشّيء

89
00:06:01,610 --> 00:06:04,140
!بالطّبع! يا لها من فكرة

90
00:06:04,140 --> 00:06:06,720
.أحتاج لطريقة لفتح الموضوع معها فحسب

91
00:06:06,720 --> 00:06:09,630
على الأرجح أنّ سؤالي لها مباشرة
.سيُشعرها بالرّيبة

92
00:06:09,630 --> 00:06:11,880
...لـ-ليلي-تشان

93
00:06:12,470 --> 00:06:15,000
يمرّ نسيم عليل كلّ يوم
.من أوائل هذا الرّبيع

94
00:06:15,000 --> 00:06:17,180
فهلّي أن أسألك عن حالك؟

95
00:06:17,180 --> 00:06:20,060
...عندما أراك، إلخ، إلخ، إلخ

96
00:06:20,060 --> 00:06:23,070
!لذلك، أودّ أن أطلب منك الخروج معي

97
00:06:23,340 --> 00:06:24,970
.أنا آسفة

98
00:06:24,970 --> 00:06:26,400
!كان هذا سريعًا

99
00:06:26,400 --> 00:06:28,380
!فكّري في الأمر على الأقلّ

100
00:06:28,380 --> 00:06:30,160
.لا أريد أن أجعلك تنتظر

101
00:06:29,620 --> 00:06:31,820
...أفهم ذلك، ولكن

102
00:06:30,160 --> 00:06:31,820
.ها قد بدأ ثانية

103
00:06:31,820 --> 00:06:34,250
.آسف لأنّه مزعج يا أكتسو-كُن

104
00:06:34,830 --> 00:06:36,700
.لا أمانع

105
00:06:36,700 --> 00:06:37,930
...عفوًا

106
00:06:37,930 --> 00:06:39,600
.أنا تانيغاوا يويا

107
00:06:39,600 --> 00:06:40,710
.نادني تانيغاوا فحسب

108
00:06:40,710 --> 00:06:42,750
.مفهوم يا تانيغاوا

109
00:06:42,750 --> 00:06:43,680
.سررت بالتّعرّف إليك

110
00:06:43,680 --> 00:06:44,280
.نعم

111
00:06:44,280 --> 00:06:45,150
.وأنا كذلك

112
00:06:45,150 --> 00:06:46,760
من يكون؟

113
00:06:47,510 --> 00:06:49,480
.سأجرّب ثانية لاحقًا

114
00:06:49,480 --> 00:06:50,160
.أكيد

115
00:06:50,160 --> 00:06:51,790
.إنّه هيروتا

116
00:06:51,790 --> 00:06:54,030
.لطالما كان يحبّ الفتيات هكذا

117
00:06:54,030 --> 00:06:57,470
إنّه جاهز للاعتراف بحبّه
.لكلّ فتاة ظريفة يراها

118
00:06:57,470 --> 00:06:59,880
.مع أنّه قد يبدو غارقًا في حبّها الآن

119
00:06:59,880 --> 00:07:01,260
.هكذا إذًا

120
00:07:01,260 --> 00:07:03,360
.يا إلهي

121
00:07:03,360 --> 00:07:05,270
.تمّ رفضي ثانية

122
00:07:05,980 --> 00:07:09,240
.هيروتا، سبق وأخبرت أكتسو-كُن عنك

123
00:07:09,240 --> 00:07:10,570
.شكرًا لك

124
00:07:10,570 --> 00:07:12,270
.أنا هيروتا كنساكو

125
00:07:12,270 --> 00:07:15,180
،لديّ الكثير لأتحدّث عنه
.لذلك دعنا نخرج للممرّ

126
00:07:15,180 --> 00:07:16,240
.أكيد

127
00:07:16,640 --> 00:07:19,740
.لقد صُدمتُ كثيرًا عندما عرّفت على نفسك

128
00:07:19,740 --> 00:07:21,580
.كان ذلك حادثًا نوعًا ما

129
00:07:21,580 --> 00:07:23,120
...فلم يكن يفترض أن

130
00:07:23,120 --> 00:07:25,590
.على أيّ حال، سنكون أصدقاء جيّدين

131
00:07:25,590 --> 00:07:28,760
.أعلمني إن كانت لديك أيّ أسئلة

132
00:07:28,760 --> 00:07:29,940
من الفتاة؟

133
00:07:31,280 --> 00:07:32,910
أماني ليلي-تشان؟

134
00:07:32,910 --> 00:07:36,110
.انتقلت إلى هنا قبلك بقليل يا أكّون

135
00:07:36,110 --> 00:07:38,680
.إنّها نصف يابانيّة وكيكوكوشيجو حقيقيّة

136
00:07:40,820 --> 00:07:42,320
.لنذهب إلى غرفة الموسيقى

137
00:07:42,320 --> 00:07:43,130
.حسنًا

138
00:07:43,130 --> 00:07:45,270
لدينا اختبارات بيانو اليوم، صحيح؟

139
00:07:45,900 --> 00:07:47,050
.هكذا إذًا

140
00:07:47,050 --> 00:07:49,610
...نصف يابانيّة وكيكوكوشيجو

141
00:07:49,610 --> 00:07:50,740
ما معنى ذلك؟

142
00:07:50,740 --> 00:07:57,340
إنّها قصيرة وظريفة، لكنّها أيضًا
.ذكيّة جدًّا ولها شخصيّة ممتازة

143
00:07:50,740 --> 00:07:58,620
خيال

144
00:07:57,340 --> 00:07:58,620
...إنّها مثل

145
00:07:58,620 --> 00:07:59,920
ملاك على ما أظنّ؟

146
00:07:59,920 --> 00:08:00,730
!ملاك؟

147
00:08:00,730 --> 00:08:01,550
ما الخطب؟

148
00:08:01,550 --> 00:08:03,440
.لا، لا شيء

149
00:08:03,440 --> 00:08:07,310
على أيّ حال، من الأفضل أن تستعدّ
.إن كنت تسعى خلف ليلي-تشان

150
00:08:07,310 --> 00:08:08,380
أستعدّ؟

151
00:08:09,650 --> 00:08:13,760
.سبق ورفضتني خمس مرّات

152
00:08:13,880 --> 00:08:15,710
!اخرجي معي رجاءً

153
00:08:15,710 --> 00:08:16,680
.أنا آسفة

154
00:08:16,800 --> 00:08:18,350
!لنبدأ كصديقين

155
00:08:18,350 --> 00:08:21,020
.آسفة

156
00:08:19,180 --> 00:08:21,020
!أتوسّل إليك

157
00:08:21,470 --> 00:08:22,540
...عفوًا

158
00:08:21,830 --> 00:08:22,540
.آ

159
00:08:22,540 --> 00:08:24,190
!بحرف واحد؟

160
00:08:24,190 --> 00:08:26,110
أنت لا تتعلّم أبدًا، صحيح؟

161
00:08:26,110 --> 00:08:28,600
!ظننتُ أنّ اليوم هو اليوم المنتظر

162
00:08:29,800 --> 00:08:31,500
!ليلي-تشان

163
00:08:31,500 --> 00:08:34,320
!حسنًا، فأذهب للاعتراف لها مرّة أخرى

164
00:08:34,320 --> 00:08:37,180
!اهدأ! لقد رفضتك للتّوّ

165
00:08:37,180 --> 00:08:38,480
!لا أذكر حدوث ذلك

166
00:08:38,480 --> 00:08:40,400
!اكتفي بذلك لليوم

167
00:08:40,400 --> 00:08:41,840
!اتركني

168
00:08:41,840 --> 00:08:44,010
!لا يستطيع أحد كبح شهوتي

169
00:08:44,010 --> 00:08:45,730
!شهوتك؟

170
00:08:44,010 --> 00:08:47,120
...لا أصدّق أنّ بإمكانها أن تفتن البشر هكذا

171
00:08:45,730 --> 00:08:47,120
إنّه شغفي إذًا، على ما أظنّ؟

172
00:08:47,120 --> 00:08:49,390
.واثق أنّ الأمر ليس كذلك

173
00:08:47,730 --> 00:08:50,150
.كنتُ محقًّا في تقديري عنها

174
00:08:51,590 --> 00:08:53,510
...أماني ليلي

175
00:08:55,080 --> 00:08:58,800
حسنًا، كيف أتقرّب منها؟

176
00:08:58,800 --> 00:09:01,350
.عليّ العودة للمنزل ووضع خطّة

177
00:09:01,350 --> 00:09:03,090
!أنا آسف

178
00:09:03,090 --> 00:09:04,730
أنت أماني؟

179
00:09:05,100 --> 00:09:06,120
ماذا؟

180
00:09:06,120 --> 00:09:07,650
أكتسو-كُن؟

181
00:09:07,650 --> 00:09:10,240
.ظهرت أمامي فجأة. أخافني ذلك كثيرًا

182
00:09:10,240 --> 00:09:12,060
ماذا كنت تفعلين هناك؟

183
00:09:12,060 --> 00:09:14,480
.لـ-لقد ضعت قليلاً

184
00:09:16,820 --> 00:09:19,700
.مهلاً، قد تكون هذه فرصتي

185
00:09:21,200 --> 00:09:22,660
...عـ-عفوًا

186
00:09:23,730 --> 00:09:25,240
ماذا يفترض بي أن أقول؟

187
00:09:26,180 --> 00:09:28,830
.عليّ التّفكير في جملة جيّدة

188
00:09:28,830 --> 00:09:30,680
.أ-أكتسو هو اسمي

189
00:09:30,680 --> 00:09:31,530
.سررت بلقائك

190
00:09:31,530 --> 00:09:33,550
!ما كان ذلك؟

191
00:09:34,550 --> 00:09:36,300
.أعلم هذا

192
00:09:36,300 --> 00:09:38,300
.أنت مضحك يا أكتسو-كُن

193
00:09:38,300 --> 00:09:40,920
.لم أعرّف عن نفسي بعد

194
00:09:40,920 --> 00:09:42,440
.أنا أماني ليلي

195
00:09:42,810 --> 00:09:43,970
.سررت بلقائك

196
00:09:44,710 --> 00:09:46,200
.وأنا كذلك

197
00:09:47,240 --> 00:09:49,730
ما الّذي حدث لكمّ سترتك؟

198
00:09:49,730 --> 00:09:51,200
...هذا

199
00:09:51,200 --> 00:09:53,320
أحدث هذا عندما اصطدمت بك؟

200
00:09:53,320 --> 00:09:54,650
...لا، ليس كذلك

201
00:09:54,650 --> 00:09:56,640
آسف! كيف يمكنني أن أعوّضك عن ذلك؟

202
00:09:56,640 --> 00:09:58,490
.لا-لا تهتمّ بهذا

203
00:09:59,490 --> 00:10:02,430
.لا بدّ من وجود سبب لاصطدامنا ببعضنا

204
00:10:02,430 --> 00:10:05,400
لماذا لا نذهب لاحتساء الشّاي
أو شيء كهذا بهذه المناسبة؟

205
00:10:06,000 --> 00:10:06,880
!حاضر

206
00:10:06,880 --> 00:10:08,870
.كـ-كما ترغبين

207
00:10:09,730 --> 00:10:11,180
ماذا قلت؟

208
00:10:12,130 --> 00:10:13,550
أنت أيضًا؟

209
00:10:13,550 --> 00:10:14,120
.نعم

210
00:10:14,120 --> 00:10:16,760
.يعيش والداي خارج البلاد

211
00:10:16,760 --> 00:10:19,930
.لكن لا بدّ أنّ العيش وحدك كفتى صعب جدًّا

212
00:10:20,390 --> 00:10:22,100
.ليس لذلك الحدّ

213
00:10:22,100 --> 00:10:23,500
هل أنت واثق؟

214
00:10:23,500 --> 00:10:24,840
!واثق، واثق

215
00:10:24,840 --> 00:10:26,160
هل تقوم بواجباتك المنزليّة؟

216
00:10:26,160 --> 00:10:27,920
.نعم، أنظّف وكلّ شيء

217
00:10:27,920 --> 00:10:31,270
.قد يكون عليك إثبات ذلك لي يومًا ما

218
00:10:47,980 --> 00:10:48,860
هل هما بخير؟

219
00:10:49,760 --> 00:10:50,960
ماذا حدث؟

220
00:10:50,270 --> 00:10:51,320
أهما سالمين؟

221
00:10:51,320 --> 00:10:52,490
ما كان ذلك؟

222
00:11:00,720 --> 00:11:02,070
!أكتسو-كُن؟

223
00:11:02,070 --> 00:11:05,600
.آ-آسف لأنّي أمسكتك هكذا

224
00:11:05,600 --> 00:11:07,210
!لا-لا تقلق حيال هذا

225
00:11:07,210 --> 00:11:08,400
هل أنت بخير؟

226
00:11:08,400 --> 00:11:11,210
.يؤلمني جسدي قليلاً

227
00:11:11,210 --> 00:11:13,520
!ماذا تقصد بقليلاً؟

228
00:11:14,480 --> 00:11:16,320
أكتسو-كُن؟

229
00:11:16,320 --> 00:11:17,400
!كلاّ

230
00:11:19,530 --> 00:11:20,440
!ليتّصل أحد بالإسعاف

231
00:11:20,440 --> 00:11:21,640
!نحتاج للمساعدة

232
00:11:21,960 --> 00:11:22,910
هل يمكنك التّحرّك؟

233
00:11:22,910 --> 00:11:24,450
.نـ-نعم

234
00:11:23,700 --> 00:11:24,450
أين الإسعاف؟

235
00:11:24,450 --> 00:11:25,400
.من هنا

236
00:11:26,200 --> 00:11:27,210
!مهلاً

237
00:11:27,210 --> 00:11:27,850
!النّجدة

238
00:11:27,850 --> 00:11:28,950
!هدوء

239
00:11:32,280 --> 00:11:33,080
.خذ

240
00:11:33,080 --> 00:11:35,090
.حسنًا. شكرًا لك

241
00:11:37,590 --> 00:11:39,560
هل أنت واثق أنّك بخير؟

242
00:11:39,560 --> 00:11:41,320
لا تحتاج للذّهاب للمستشفى؟

243
00:11:41,320 --> 00:11:42,140
.لا

244
00:11:42,140 --> 00:11:44,270
.اختفى الألم الآن

245
00:11:44,270 --> 00:11:45,370
فعلاً؟

246
00:11:45,970 --> 00:11:49,610
.شكرًا... على إنقاذي

247
00:11:49,610 --> 00:11:51,320
.العفو

248
00:11:51,720 --> 00:11:52,600
.ذلك واجبي

249
00:11:53,570 --> 00:11:54,780
.آسفة

250
00:11:54,780 --> 00:11:56,860
.هذا ليس أمرًا يدعو للاعتذار

251
00:11:57,990 --> 00:12:00,610
هل يمكنني أن أسألك؟

252
00:12:01,300 --> 00:12:04,280
ما حقيقتك يا أكتسو-كُن؟

253
00:12:07,660 --> 00:12:08,880
.تبًّا

254
00:12:08,880 --> 00:12:11,120
.أنت بخير رغم أنّ شاحنة صدمتك

255
00:12:11,120 --> 00:12:12,910
...وأذناك

256
00:12:12,910 --> 00:12:15,560
...هذا سؤال غريب، ولكن

257
00:12:15,560 --> 00:12:20,000
...أنا أتساءل فحسب، أتساءل إن كنتَ

258
00:12:20,000 --> 00:12:21,740
.لست بشريًّا

259
00:12:25,560 --> 00:12:26,940
!تبًّا

260
00:12:26,940 --> 00:12:28,780
!فشل ذريع

261
00:12:28,780 --> 00:12:31,680
كيف كشفتُ عن هويّتي بهذه السّرعة؟

262
00:12:31,680 --> 00:12:34,520
.لا، عليّ مواصلة الكذب

263
00:12:35,040 --> 00:12:35,690
ماذا؟

264
00:12:36,260 --> 00:12:38,650
.إنّ ردّة فعلها ليست سلبيّة

265
00:12:38,650 --> 00:12:40,970
هل تحبّ الأشياء الخارقة للطّبيعة؟

266
00:12:40,970 --> 00:12:43,580
!حسنًا، سأنتهز هذه الفرصة

267
00:12:45,640 --> 00:12:47,900
.لا تخبري أيّ أحد رجاءً

268
00:12:47,900 --> 00:12:50,200
.معك حقّ. أنا لستُ بشريًّا

269
00:12:50,200 --> 00:12:53,320
...أنا

270
00:12:59,890 --> 00:13:00,950
...في الحقيقة

271
00:13:02,160 --> 00:13:03,610
.شيطان

272
00:13:04,170 --> 00:13:06,140
شيطان؟

273
00:13:06,140 --> 00:13:07,300
.نعم

274
00:13:07,300 --> 00:13:10,030
.أتيت لعالم البشر في مهمّة

275
00:13:10,030 --> 00:13:10,890
مهمّة؟

276
00:13:13,990 --> 00:13:18,360
.عالمنا الجحيم في خطر

277
00:13:19,220 --> 00:13:23,260
.إنّنا في صراع قوّة مع الملائكة

278
00:13:23,260 --> 00:13:26,620
.سيُدمَّر الجحيم قريبًا

279
00:13:27,160 --> 00:13:31,940
.ومع ذلك، يتهاون أبناء جنسي بشأن هذا

280
00:13:32,760 --> 00:13:37,230
لذلك يريد رئيسي تعيين قائد
يتمتّع بشخصيّة استثنائيّة

281
00:13:37,230 --> 00:13:40,170
.لتحفيز سكّان الجحيم

282
00:13:40,560 --> 00:13:44,600
.ومهمتي هي العثور على ذلك الشّخص

283
00:13:44,600 --> 00:13:46,720
وهل وجدته؟

284
00:13:46,720 --> 00:13:49,630
.لا. بدأت في البحث للتّوّ

285
00:13:49,630 --> 00:13:54,350
وكنتُ أتساءل إن كان بمقدورك
.يا أماني مساعدتنا

286
00:13:56,890 --> 00:13:58,240
...لكن

287
00:13:58,240 --> 00:13:59,650
.هذا طلب مفاجئ

288
00:14:00,360 --> 00:14:03,040
.لن أجبرك على الانضمام لنا

289
00:14:03,040 --> 00:14:06,810
إن استطعتِ المجيء للجحيم من وقت لآخر

290
00:14:10,950 --> 00:14:11,940
!أرجوك

291
00:14:14,950 --> 00:14:16,120
...اسمع

292
00:14:16,120 --> 00:14:20,630
أنا مصدومة قليلاً لمعرفتي
.أنّ الشّياطين حقيقيّون

293
00:14:21,250 --> 00:14:24,220
.أنت لستَ كما توقّعت أبدًا

294
00:14:24,750 --> 00:14:27,000
.لقد حميتني من الشّاحنة

295
00:14:27,860 --> 00:14:29,560
.كما أنّك لستَ لحوحًا

296
00:14:29,560 --> 00:14:31,260
.وأنت لطيف أيضًا

297
00:14:31,260 --> 00:14:33,720
...ذ-ذلك ليس

298
00:14:35,140 --> 00:14:37,030
.وها أنت تخجل الآن. كم هذا غريب

299
00:14:40,230 --> 00:14:42,120
أواثق أنّني ما ترغب فيه؟

300
00:14:42,120 --> 00:14:44,740
.لا شيء مميّز حيالي

301
00:14:45,190 --> 00:14:48,080
.لستُ واثقة حتّى أنّ بإمكاني المساعدة

302
00:14:48,080 --> 00:14:50,590
!ذ-ذلك ليس صحيحًا

303
00:14:50,590 --> 00:14:52,620
.أحتاج لتكوني من أبحث عنه

304
00:14:52,620 --> 00:14:56,240
يجب أن يكون شخصًا بظرافتك
.وسيحبّه الجميع

305
00:14:56,240 --> 00:14:59,100
ولكن ألا مانع بالفعل؟

306
00:14:59,790 --> 00:15:06,550
ألن يخافني الآخرون في الجانب
الآخر أو يكرهونني؟

307
00:15:06,550 --> 00:15:08,970
.أعتقد أنّك ستكونين بخير

308
00:15:08,970 --> 00:15:09,880
أأنت واثق؟

309
00:15:17,590 --> 00:15:19,860
!ما-ما هذا؟

310
00:15:24,690 --> 00:15:26,860
أظننتَ أنّ بإمكانك إغوائي؟

311
00:15:26,860 --> 00:15:30,030
.يا لك من شيطان أحمق

312
00:15:30,030 --> 00:15:32,350
من أنت؟

313
00:15:32,350 --> 00:15:33,580
أنا؟

314
00:15:33,580 --> 00:15:36,730
...أفترض أنّ بإمكانك مناداتي

315
00:15:44,560 --> 00:15:48,260
.خادمة السّماء على الأرجح

316
00:15:52,310 --> 00:15:53,640
!أنت ملاك؟

317
00:15:54,800 --> 00:15:56,960
.أستمتع بردّة فعلك

318
00:15:56,960 --> 00:16:00,360
لا أصدّق أنّك دعوتني إلى عالم
...الشّياطين دون أن تدرك أنّي العدوّ

319
00:16:00,360 --> 00:16:02,310
!كم هذا محرج

320
00:16:02,310 --> 00:16:03,620
...تـ-تبًّا

321
00:16:03,620 --> 00:16:05,650
.لا تزعج نفسك

322
00:16:06,820 --> 00:16:10,110
.جسّدتُ تلك السّلسلة بنفسي

323
00:16:10,110 --> 00:16:14,160
كما ترى، لديّ كامل السّيطرة
.على قوّتها وطولها

324
00:16:14,160 --> 00:16:15,760
.وحتّى لونها

325
00:16:15,760 --> 00:16:19,260
.لا يوجد ملائكة كُثر موهوبين مثلي

326
00:16:19,260 --> 00:16:21,580
ولكن لماذا اضطررتُ لأقاتل
اثنين في يوم واحد؟

327
00:16:21,580 --> 00:16:23,420
ماذا إن قتلني العمل بجدّ؟

328
00:16:23,420 --> 00:16:24,630
.عليّ أن أفقع عينيك

329
00:16:25,670 --> 00:16:27,030
!توقّفي

330
00:16:27,030 --> 00:16:27,840
اثنين؟

331
00:16:28,390 --> 00:16:32,090
.هذا ليس بسبب اصطدامي بك

332
00:16:34,410 --> 00:16:39,260
.كنتُ أطيح بعدوّ آخر قبل أن ألتقي بك

333
00:16:40,200 --> 00:16:44,140
أرخيتُ دفاعاتي لوهلة مُعتقدة
.أنّه مجرّد وحش عاديّ

334
00:16:44,520 --> 00:16:46,770
...فقدتُ أعصابي و

335
00:16:49,880 --> 00:16:51,520
!أنا آسف

336
00:16:51,520 --> 00:16:53,240
أنت أماني؟

337
00:16:53,600 --> 00:16:54,590
ماذا؟

338
00:16:54,590 --> 00:16:56,160
أكتسو-كُن؟

339
00:16:56,160 --> 00:16:58,540
.ظهرت أمامي فجأة. أخافني ذلك كثيرًا

340
00:16:58,540 --> 00:17:00,290
ماذا كنت تفعلين هناك؟

341
00:17:04,820 --> 00:17:09,420
.أذللتُه كثيرًا قبل أن أرقيه ببطء

342
00:17:09,840 --> 00:17:13,080
والآن، كيف يجب أن أرقيك أنت؟

343
00:17:14,340 --> 00:17:17,430
لا يمكنني الشّعور بالانزعاج بشأن
.قضاء العدوّ عليّ

344
00:17:17,960 --> 00:17:20,220
.كانت لي نفس النّوايا قبل كلّ شيء

345
00:17:20,220 --> 00:17:22,510
.نعم، نعم

346
00:17:22,510 --> 00:17:23,610
...لكن

347
00:17:24,280 --> 00:17:27,500
!لقد أذللتِ أحد رفاقي

348
00:17:27,500 --> 00:17:29,630
!هذا ما تفعلونه أنتم دائمًا

349
00:17:29,630 --> 00:17:32,800
!حان الوقت لتعرفي حدودك أيّتها الملاك القذر

350
00:17:36,090 --> 00:17:40,200
!من الأفضل ألاّ تستخفّي بالشّياطين

351
00:17:42,740 --> 00:17:45,150
.كم أخفتني

352
00:17:45,150 --> 00:17:48,730
لم أتوقّع أبدًا أن ألتقي شيطانًا
.بإمكانه كسر حاجز سلسلتي

353
00:17:50,240 --> 00:17:52,750
.أثرت إعجابي

354
00:17:52,750 --> 00:17:54,970
!اخرسي

355
00:18:05,180 --> 00:18:06,100
!سُحقًا

356
00:18:12,630 --> 00:18:14,400
...إنّها

357
00:18:16,790 --> 00:18:18,180
.قويّة

358
00:18:21,650 --> 00:18:24,970
.يبدو أنّك أعلى مستوى من الشّياطين العاديّة

359
00:18:24,970 --> 00:18:27,620
.إنّه لأمر مؤسف أنّ عليّ القضاء عليك

360
00:18:27,620 --> 00:18:28,920
.هذا سيّئ

361
00:18:28,920 --> 00:18:30,480
!هذا سيّئ، سيّئ، سيّئ

362
00:18:30,480 --> 00:18:31,630
!ستقضي عليّ

363
00:18:31,630 --> 00:18:32,330
.وجدتُها

364
00:18:32,330 --> 00:18:34,060
ما رأيك بهذا؟

365
00:18:36,510 --> 00:18:39,120
.بإمكاني القضاء عليك الآن

366
00:18:39,120 --> 00:18:44,140
،لكن إن أخبرتني بخطط الجحيم
.فسأدعك تذهب

367
00:18:44,140 --> 00:18:46,310
ولماذا قد أصدّقك؟

368
00:18:47,120 --> 00:18:48,380
هكذا إذًا؟

369
00:18:49,070 --> 00:18:50,300
...في تلك الحالة

370
00:18:52,100 --> 00:18:53,200
...أنا

371
00:18:53,200 --> 00:18:54,360
...ما زلتُ لم

372
00:18:54,360 --> 00:18:57,180
!أحقّق أيّ شيء في هذا الجانب

373
00:19:06,070 --> 00:19:07,620
ما الّذي فعلته بي للتّوّ؟

374
00:19:07,620 --> 00:19:09,610
.ألغيتُ الأمر

375
00:19:09,610 --> 00:19:10,880
.غيّرتُ رأيي

376
00:19:10,880 --> 00:19:12,800
.لن أقضي عليك

377
00:19:12,800 --> 00:19:13,390
ماذا؟

378
00:19:13,390 --> 00:19:15,840
.قلتُ أنّي لن أرقيك

379
00:19:16,260 --> 00:19:17,600
فعلاً؟

380
00:19:17,600 --> 00:19:19,070
ستدعيني أذهب؟

381
00:19:19,070 --> 00:19:20,460
.لا، لا، لا

382
00:19:20,460 --> 00:19:22,010
.الأمر ليس كذلك

383
00:19:22,330 --> 00:19:24,600
سأضعك تحت إشرافي

384
00:19:24,600 --> 00:19:27,580
.وسأجعلك تساعدني في عملي

385
00:19:27,580 --> 00:19:29,020
ماذا؟ عملك؟

386
00:19:29,020 --> 00:19:29,960
عمّ تتكلّمين؟

387
00:19:29,960 --> 00:19:33,160
.اقبل الآن، وستحصل على طوق أماني الخاصّ

388
00:19:33,160 --> 00:19:34,250
!لا أريده

389
00:19:34,250 --> 00:19:37,280
لماذا قد أساعد العدوّ على كلّ حال؟

390
00:19:37,280 --> 00:19:38,690
...السّبب هو

391
00:19:39,510 --> 00:19:42,920
.أريد أن أكون معك يا أكتسو-كُن

392
00:19:43,880 --> 00:19:45,870
!هل تعبثين معي يا هذه؟

393
00:19:45,870 --> 00:19:50,430
دعنا من المزاح، لكنّك ستساعدني
.في تحقيق أهدافي

394
00:19:50,430 --> 00:19:55,390
،لا يمكنني توفير كلّ التّفاصيل لك
.لكن إن وافقت، فسأحرّرك

395
00:19:55,390 --> 00:19:57,080
.على قيد الحياة بالطّبع

396
00:19:57,520 --> 00:19:59,000
.لا أثق بك

397
00:19:59,000 --> 00:20:02,440
.لكنّا لسنا قادرين على الكذب

398
00:20:02,440 --> 00:20:05,050
.تصديقك لي يتوقّف عليك أنت

399
00:20:05,050 --> 00:20:06,550
.ومع ذلك، تتصرّف وكأنّها فتاة جيّدة

400
00:20:06,550 --> 00:20:08,040
ما خيارك؟

401
00:20:08,040 --> 00:20:10,180
أتفضّل البقاء هناك للأبد؟

402
00:20:10,180 --> 00:20:13,690
وهل تودّ أن يجدك أحد المارّة
وتُعرف في كلّ وسائل

403
00:20:10,640 --> 00:20:16,810
مشاركة#

404
00:20:13,690 --> 00:20:16,810
التّواصل الاجتماعي بالفتى
السّاديّ والمازوخيّ المنفرد؟

405
00:20:16,810 --> 00:20:18,060
هيّا؟ هيّا؟

406
00:20:17,250 --> 00:20:21,360
.لا أستطيع أن أثق أنّها ستحرّرني بكلّ تأكيد

407
00:20:18,060 --> 00:20:19,680
أهذا ما تريده؟

408
00:20:19,680 --> 00:20:21,780
!إنّها المعضلة القصوى

409
00:20:21,360 --> 00:20:23,500
.لكن لا خيار آخر لديّ

410
00:20:21,780 --> 00:20:24,630
!لا أطيق الانتظار حتّى تختار

411
00:20:23,500 --> 00:20:26,340
هل أولويّتي هي الخروج من هذا الموقف؟

412
00:20:26,840 --> 00:20:27,980
.حسنًا

413
00:20:27,980 --> 00:20:29,080
.سأتعاون معك

414
00:20:29,080 --> 00:20:31,150
.جيّد، جيّد

415
00:20:31,150 --> 00:20:33,580
.أنت سريع الفهم

416
00:20:33,580 --> 00:20:35,750
.أسرعي وحرّريني

417
00:20:36,240 --> 00:20:38,720
.أقصد حرّريني رجاءً

418
00:20:38,720 --> 00:20:40,480
.لا تتعجّل

419
00:20:40,480 --> 00:20:44,890
قبل ذلك، سترتدي هذا الطّوق
.لتُثبت خضوعك لي

420
00:20:44,300 --> 00:20:46,760
دافئ
ومصنوع
حديثًا

421
00:20:44,890 --> 00:20:46,760
ذلك الشّيء موجود فعلاً؟

422
00:20:47,700 --> 00:20:49,710
!كفّ عن الحركة

423
00:20:49,710 --> 00:20:51,020
!اثبت

424
00:20:54,850 --> 00:20:57,730
.لا تعرف متى تستسلم

425
00:20:57,730 --> 00:20:59,280
!ا-اعفيني رجاءً

426
00:20:59,280 --> 00:21:00,480
.طلبك مرفوض

427
00:21:00,480 --> 00:21:01,150
!الرّحمة

428
00:21:01,150 --> 00:21:02,360
.لا أعرف ما ذلك

429
00:21:02,660 --> 00:21:05,200
.سأضع هذا الطّوق عليك

430
00:21:05,200 --> 00:21:07,690
.إنّه حول عنقك الآن

431
00:21:07,690 --> 00:21:08,780
!لا! أرجوك

432
00:21:10,930 --> 00:21:13,770
.كم أحبّ طريقة صراخك

433
00:21:13,770 --> 00:21:15,960
.يُحسّن ذلك من هذا الوضع أكثر

434
00:21:16,920 --> 00:21:19,420
لا تذهبوا إلى أيّ مكان رجاءً

435
00:21:17,310 --> 00:21:19,160
.عبر الحزام من الحلقة

436
00:21:19,160 --> 00:21:21,050
!أكاد أنتهي

437
00:21:21,050 --> 00:21:22,920
!أرجوك! هذا مؤلم

438
00:21:22,920 --> 00:21:24,280
!هيّا

439
00:21:24,280 --> 00:21:26,660
...يُوضع الإبزيم هكذا، ثمّ

440
00:21:27,120 --> 00:21:29,300
.إنّه ضيّق قليلاً

441
00:21:32,140 --> 00:21:34,360
.حان وقت استعمال القوّة

442
00:21:38,950 --> 00:21:41,760
.اقترفتُ خطأ فظيعًا

443
00:21:41,760 --> 00:21:45,720
ظننتُ أنّ خطئي الوحيد
.هو محاولة تعيين العدوّ

444
00:21:45,720 --> 00:21:51,820
لكنّ ما فعلته أماني لجسدي
.جعلني عاجزًا عن العودة للجحيم

445
00:22:03,440 --> 00:22:05,830
.لا أرى أيّ مستقبل أمامي