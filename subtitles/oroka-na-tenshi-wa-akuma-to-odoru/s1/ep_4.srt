1
00:01:40,240 --> 00:01:42,240
...مكانك أيّها الوغد

2
00:01:42,240 --> 00:01:45,560
.تقبّل أنّك لست ندًّا لي واستسلم فحسب

3
00:01:45,560 --> 00:01:48,040
!سأحرص على ألاّ يكون هلاكك مؤلمًا

4
00:01:48,720 --> 00:01:50,650
لماذا تحاولين القضاء عليّ؟

5
00:01:50,650 --> 00:01:52,490
.لأنّك شيطان

6
00:01:52,490 --> 00:01:54,550
هذا كلّ شيء؟

7
00:01:54,550 --> 00:01:59,050
كما أنّ هنالك كلبًا شاردًا
.يهاجم النّساء مؤخّرًا

8
00:01:59,050 --> 00:02:00,860
إنّه أنت، صحيح؟

9
00:02:01,430 --> 00:02:04,060
.سأخبر إن استطعتِ هزيمتي

10
00:02:04,060 --> 00:02:08,520
لم يجرؤ أيّ أحد من قبل
!على مواجهة شكلي الحقيقيّ

11
00:02:09,360 --> 00:02:10,040
فعلاً؟

12
00:02:10,040 --> 00:02:11,560
.لا أطيق الانتظار

13
00:02:11,560 --> 00:02:13,610
...احذري

14
00:02:13,610 --> 00:02:17,360
...في شكلي هذا، قوّتي وذكائي

15
00:02:17,360 --> 00:02:20,910
!كلّ ذلك يقلّ بـ50% عن شكلي الوحشيّ

16
00:02:22,620 --> 00:02:24,910
.انخفضت قدرتك

17
00:02:24,910 --> 00:02:29,080
أرى أنّك خائفة للغاية من قوّتي
.لدرجة أنّك عاجزة عن الكلام

18
00:02:29,080 --> 00:02:31,030
.لا ألومك

19
00:02:31,030 --> 00:02:32,080
—فمجرّد النّظر إلى

20
00:02:35,050 --> 00:02:37,470
!ما ذلك الزّيّ الضّيّق؟

21
00:02:37,470 --> 00:02:39,200
!إنّه عشوائيّ ومحرج

22
00:02:39,200 --> 00:02:40,170
!أأنت أبله؟

23
00:02:40,170 --> 00:02:43,050
...لكنّي في مرحلة الجسد الصّيفيّ

24
00:02:45,850 --> 00:02:48,170
.أنا قلق عليك لأسباب كثيرة

25
00:02:48,170 --> 00:02:50,600
.شكرًا لك

26
00:02:50,600 --> 00:02:52,690
مـ-مهلاً، ألا يجدر بك أن تكون مختبئًا؟

27
00:02:52,690 --> 00:02:56,910
مهلاً. هل أنت ملاك أيضًا؟

28
00:02:56,910 --> 00:02:58,650
...لا، لستَ كذلك

29
00:02:58,650 --> 00:03:00,780
.أنت واحد منّا

30
00:03:00,780 --> 00:03:03,310
ما الّذي تفعله برفقة ملاك؟

31
00:03:03,310 --> 00:03:05,280
...كنتُ

32
00:03:05,280 --> 00:03:06,590
!خائن

33
00:03:06,590 --> 00:03:09,500
!كلاّ، هناك سبب لهذا

34
00:03:09,500 --> 00:03:10,810
.لا أريد سماع أعذارك

35
00:03:10,810 --> 00:03:12,170
!كلاّ، استمع لي

36
00:03:12,170 --> 00:03:14,030
.لا بأس

37
00:03:14,030 --> 00:03:16,440
،ولكن قبل أن نتكلّم

38
00:03:16,440 --> 00:03:18,510
.هاجم تلك المرأة

39
00:03:18,510 --> 00:03:19,720
...لا يمكنني

40
00:03:20,720 --> 00:03:22,410
.هذا يكفي

41
00:03:22,840 --> 00:03:24,410
.ابتعد عن طريقي

42
00:03:24,410 --> 00:03:28,540
.تدخّل أكثر وسأرقيك أنت أيضًا

43
00:03:28,970 --> 00:03:30,620
!مهلاً كلاكما

44
00:03:30,620 --> 00:03:32,380
!نسيتما أمرًا مهمًّا

45
00:03:32,380 --> 00:03:33,260
ما هو؟

46
00:03:33,260 --> 00:03:34,400
.استمعا إليّ

47
00:03:34,400 --> 00:03:37,900
عليكما أن تهدآ وتتناقشا معًا
.أوّلاً قبل اللّجوء إلى العنف

48
00:03:38,270 --> 00:03:41,430
.بشأن الماضي، وبشأن المستقبل

49
00:03:41,980 --> 00:03:42,910
...أجل

50
00:03:42,910 --> 00:03:45,690
!اضغطا باستمرار على الزّرّ وأكملا القلب

51
00:03:49,910 --> 00:03:53,830
.املآ قلبيكما بالحبّ

52
00:03:53,830 --> 00:03:55,670
!تأكيد المكافأة الإضافيّة

53
00:03:56,970 --> 00:04:00,170
!إنّك تبلين حسنًا رغم مرافقتك لأحمق مثله

54
00:04:00,170 --> 00:04:02,970
!وكذلك أنت، رغم أنّه أحمق من بني جنسك

55
00:04:04,130 --> 00:04:06,680
!إنّك تضحكني بالحديث عن حبّ الشّياطين

56
00:04:06,680 --> 00:04:09,870
الحديث عن الحبّ هو شيء يقوم به
الحمقى والملائكة، صحيح؟

57
00:04:09,870 --> 00:04:11,230
!ليس لديّ وقت لذلك الآن

58
00:04:11,230 --> 00:04:12,270
!ولا أنا

59
00:04:13,140 --> 00:04:14,400
...أنتما

60
00:04:14,400 --> 00:04:17,150
،إن كنتما مصرّان على هذا
...فسأجعل كلاكما يشعر

61
00:04:17,150 --> 00:04:19,960
.بحبّي

62
00:04:23,600 --> 00:04:28,120
،إن وصلت إليكما قوّة الحبّ

63
00:04:28,120 --> 00:04:32,040
.أتمنّى أن تكفّا عن القتال

64
00:04:32,040 --> 00:04:35,100
!والآن، لنستمع لما تشعران به

65
00:04:35,100 --> 00:04:36,620
.لن أقوم بذلك

66
00:04:36,620 --> 00:04:38,570
—إنّ هذا الفتى حقًّا

67
00:04:38,570 --> 00:04:40,590
!إنّها تحمل الميكروفون بالفعل

68
00:04:40,860 --> 00:04:42,800
!هل ستردّ عليه حقًّا؟

69
00:04:42,800 --> 00:04:47,100
.أتمنّى لو لم ألتقي بك من الأساس

70
00:04:47,100 --> 00:04:50,180
.التّواجد معك مرهق للغاية

71
00:04:52,210 --> 00:04:54,750
!الملائكة مرعبون بالفعل

72
00:04:54,750 --> 00:04:57,530
كيف يمكنه التّعامل مع شخص مثلها؟

73
00:04:59,120 --> 00:05:00,400
!الهجوم المضادّ؟

74
00:05:00,400 --> 00:05:04,810
.لم تكوني بحاجة لقول ذلك بتلك الطّريقة

75
00:05:04,810 --> 00:05:06,400
!إنّه حسّاس للغاية

76
00:05:06,400 --> 00:05:10,510
.أعلم أنّ الأمر ما كان لينجح

77
00:05:10,510 --> 00:05:12,200
.إنّه يعترف بذلك

78
00:05:12,200 --> 00:05:13,700
!لم ينتهِ بعد؟

79
00:05:13,700 --> 00:05:15,470
.لا يمكنني سماعك

80
00:05:15,470 --> 00:05:18,400
.إن كان لديك ما تقوله، فقله بوضوح

81
00:05:18,400 --> 00:05:20,280
.انظر ما الّذي فعلته الآن

82
00:05:20,280 --> 00:05:22,130
.أنا مرهَقة أكثر الآن

83
00:05:22,130 --> 00:05:23,630
!يكفي

84
00:05:23,630 --> 00:05:25,630
!ستتحطّم

85
00:05:25,630 --> 00:05:27,380
!لماذا تقوم بهذا؟

86
00:05:27,690 --> 00:05:29,390
مهلاً... أهذا من أجلي؟

87
00:05:29,390 --> 00:05:30,600
...هذا صحيح

88
00:05:30,370 --> 00:05:34,170
!قصيدة هايكو، قصيدة تانكا

89
00:05:30,600 --> 00:05:34,080
.كان يحميني طوال هذا الوقت

90
00:05:34,080 --> 00:05:40,810
واستمرّ في تشتيت انتباه تلك الملاك
!المرعبة كي لا تسعى خلفي

91
00:05:35,060 --> 00:05:37,540
.قصيدة هايكو، الـ*وت لك

92
00:05:43,170 --> 00:05:44,070
...هكذا إذًا

93
00:05:44,070 --> 00:05:46,810
...هذا ما يحدث هنا

94
00:05:46,810 --> 00:05:48,390
...إنّ من يتعلّم الحبّ

95
00:05:48,790 --> 00:05:50,370
...إنّ من يتلقّى الحبّ

96
00:05:50,720 --> 00:05:53,370
.بالكاد يمكنني الوقوف

97
00:05:53,370 --> 00:05:55,620
...لا أتحمّل أكثر. الرّحمة

98
00:05:55,620 --> 00:05:57,560
.قمتَ بما يكفي

99
00:05:58,120 --> 00:06:00,540
.شكرًا لقيامك بهذا لأجلي

100
00:06:00,540 --> 00:06:02,130
.هذا يكفي

101
00:06:02,130 --> 00:06:05,800
!لا أريدك أن تعاني أكثر

102
00:06:06,160 --> 00:06:08,380
.آسف. آسف

103
00:06:12,180 --> 00:06:13,640
.لا أتحمّل هذا

104
00:06:13,640 --> 00:06:16,590
.أريد مغادرة هذا المكان حالاً

105
00:06:16,590 --> 00:06:20,100
بإمكانكما الاستمتاع
.بصحبة بعضكما بدوني

106
00:06:21,770 --> 00:06:25,450
.حسنًا، سأجعلك تعترف بخطاياك لي

107
00:06:25,450 --> 00:06:28,450
ما الّذي تتطلّع إليه ولماذا؟

108
00:06:28,450 --> 00:06:30,890
.كنتُ أبحث عن كتاب

109
00:06:30,890 --> 00:06:32,640
.لكنّي لم أستطع إيجاده

110
00:06:32,640 --> 00:06:33,240
كتاب؟

111
00:06:33,240 --> 00:06:35,560
.لطالما كنتُ وحيدًا

112
00:06:35,560 --> 00:06:37,820
.لم يهتمّ لأمري أيّ أحد أبدًا

113
00:06:38,250 --> 00:06:43,790
وذات يوم، اكتشفت أمر السّراويل الرّياضيّة
.الضّيّقة الّتي تمنح الشّخص قوامًا جميلاً

114
00:06:43,790 --> 00:06:48,800
في البداية، كنتُ سعيدًا بالنّظر
.للنّساء بسراويل رياضيّة ضيّقة فقط

115
00:06:49,150 --> 00:06:53,370
إذًا فلم يسعك سوى مهاجمة نساء
...ترتدين سراويل رياضيّة ضيّقة

116
00:06:53,370 --> 00:06:57,690
لا، ظننتُ أنّهنّ يرتدين سراويل رياضيّة
.ضيّقة، لكنّها كانت سراويل ضيّقة فحسب

117
00:06:57,690 --> 00:06:58,760
عمّ يتحدّث؟

118
00:06:58,760 --> 00:07:00,810
.لا أعرف حتّى الفرق بينهما

119
00:07:00,810 --> 00:07:02,240
.حسنًا

120
00:07:02,240 --> 00:07:04,620
.سأتولّى أمر خطيئتك

121
00:07:04,620 --> 00:07:08,570
.سأرشدك نحو حالة النّقاء

122
00:07:13,600 --> 00:07:16,160
.لم يهتمّ أيّ أحد بشأني حتّى الآن

123
00:07:16,160 --> 00:07:19,790
.أنت أوّل من عاملني بلطف

124
00:07:21,060 --> 00:07:22,120
.شكرًا لك

125
00:07:22,120 --> 00:07:24,380
!أيّها الغبيّ، لا تشكرني

126
00:07:25,450 --> 00:07:28,640
!فعلتُ ذلك لصالحي فحسب

127
00:07:29,880 --> 00:07:32,600
...أنا

128
00:07:41,010 --> 00:07:42,520
...مهلاً، مهلاً

129
00:07:43,780 --> 00:07:46,540
!كم هو ظريف

130
00:07:46,540 --> 00:07:49,040
تعثرين على أكثر الأشياء
.ظرافة دائمًا يا أماني-تشان

131
00:07:49,040 --> 00:07:51,240
.دعي الباقي لي

132
00:07:52,060 --> 00:07:53,720
!مع السّلامة

133
00:07:54,530 --> 00:07:55,960
.وداعًا

134
00:07:57,750 --> 00:07:59,410
ما كان ذلك؟

135
00:07:59,410 --> 00:08:03,040
رئيسة منظّمة إنقاذ الكلاب
.والقطط التّطوّعيّة كيارني-سان

136
00:08:03,040 --> 00:08:04,420
...لم أقصد ذلك

137
00:08:04,420 --> 00:08:07,720
تقصد ما فعلته للشّيطان، صحيح؟

138
00:08:07,720 --> 00:08:10,460
.ختمت قواه وأفكاره الشّرّيرة

139
00:08:10,460 --> 00:08:11,300
ختمتها؟

140
00:08:11,300 --> 00:08:13,230
،إنّنا نختم الأفكار الشّرّيرة

141
00:08:13,230 --> 00:08:16,520
،وإن كان الشّياطين وحوشًا
.ندع المنظّمة تتولّى أمرهم

142
00:08:16,520 --> 00:08:18,540
لكنّي لا أعرف ما الّذي نفعله
.بالشّياطين أشباه البشر

143
00:08:19,310 --> 00:08:22,280
.لا نيّة لديّ في سلب حياة الشّياطين

144
00:08:22,280 --> 00:08:24,600
.مع أنّي لا أعرف موقف بقيّة الملائكة من هذا

145
00:08:25,190 --> 00:08:28,480
ولكن ماذا عن الحاصود الشّرس
الّذي دمّرت الرّصيف به؟

146
00:08:28,480 --> 00:08:31,070
.لم أكن أنوي إصابته به أبدًا

147
00:08:31,070 --> 00:08:33,950
.ودمار الرّصيف كان مجرّد وهم

148
00:08:33,950 --> 00:08:37,980
إضافة لذلك، كنتُ أضبط قوّتي
.بينما كنتُ أقاتل

149
00:08:37,980 --> 00:08:40,830
،حتّى إن أصبته بالخطأ
.كان ليعاني من خدوش فقط

150
00:08:41,830 --> 00:08:45,440
.ماذا؟ لا تبدو مقتنعًا

151
00:08:45,440 --> 00:08:51,120
ماذا عن الشّيطان الّذي أذللتِه
ورقيتِه ببطء في يومنا الأوّل؟

152
00:08:51,120 --> 00:08:52,460
ذاك؟

153
00:08:52,460 --> 00:08:53,270
.انظر

154
00:08:53,700 --> 00:08:54,590
ما هذا؟

155
00:08:55,240 --> 00:08:56,960
ظريف، صحيح؟

156
00:08:56,960 --> 00:09:00,620
.رسمتُ ذلك عليه مقابل ما فعله بسُترتي

157
00:09:00,620 --> 00:09:03,610
قيل لي أنّ ذلك ساعده على
.إيجاد مالك جديد في الحال

158
00:09:03,610 --> 00:09:09,700
إن كنتَ لا تريدني أن أرسم حواجب
.عليك أيضًا، فمن الأفضل ألاّ تتحدّاني

159
00:09:09,700 --> 00:09:10,770
.هناك شيء غريب

160
00:09:11,080 --> 00:09:13,450
هل الملائكة هكذا بالفعل؟

161
00:09:13,450 --> 00:09:16,070
.هذا لا يتطابق مع معلوماتي أبدًا

162
00:09:16,070 --> 00:09:18,700
،إنّها تُبقي على حياة الشّياطين

163
00:09:18,700 --> 00:09:21,240
وتلتقط صورًا معهم بتلك
.النّظرة على وجهها

164
00:09:22,190 --> 00:09:26,200
ولكن حسب الصّور الّتي رأيتها من
.قبل، كانت أفعال الملائكة قاسية

165
00:09:26,780 --> 00:09:28,500
...أم أنّها

166
00:09:28,500 --> 00:09:33,380
.حسنًا يا أكتسو، انخفضت طاقتي نوعًا ما

167
00:09:33,630 --> 00:09:35,090
...هل أماني

168
00:09:36,850 --> 00:09:38,540
مميّزة؟

169
00:09:39,090 --> 00:09:40,970
فعل نذهب للأكل؟

170
00:09:40,970 --> 00:09:42,240
.الطّعام على حسابي

171
00:09:42,240 --> 00:09:43,770
.كمكافأة لك على عملك

172
00:09:45,700 --> 00:09:47,690
.أكيد، لنذهب

173
00:09:48,030 --> 00:09:49,280
ماذا؟

174
00:09:49,280 --> 00:09:50,860
.تبدو وكأنّ لديك ما تقوله

175
00:09:50,860 --> 00:09:51,900
.اخبرني

176
00:09:51,900 --> 00:09:53,370
.إنّك تثير شكوكي

177
00:09:53,370 --> 00:09:54,360
...لا شيء محدّد

178
00:09:54,360 --> 00:09:56,780
.لطالما ظننتُ أنّ الملائكة قاسون

179
00:09:57,120 --> 00:09:59,780
.أنا متفاجئ قليلاً من طيبتك

180
00:10:00,820 --> 00:10:04,410
ماذا؟ أدركت للتّوّ كم أنا طيّبة؟

181
00:10:04,410 --> 00:10:05,990
.إنّك بليد جدًّا

182
00:10:06,640 --> 00:10:08,540
.كنتُ غبيًّا لقولي ذلك

183
00:10:08,540 --> 00:10:10,560
.نعم، غبيّ بالفعل

184
00:10:10,560 --> 00:10:11,840
.لنذهب

185
00:10:11,840 --> 00:10:12,540
.مهلاً

186
00:10:15,110 --> 00:10:16,920
طيّبة"؟"

187
00:10:16,920 --> 00:10:20,170
يقول النّاس عنّي ذلك
،وأنا في حالتي العاديّة

188
00:10:20,170 --> 00:10:23,710
لكنّ هذه أوّل مرّة يقولها لي شخص
.ما عندما أظهرتُ شكلي الحقيقيّ

189
00:10:23,710 --> 00:10:26,560
.لكنّه أبله بالفعل

190
00:10:27,560 --> 00:10:34,090
كلماته سخفية، لا أريد حتّى
.أن أنظر لوجهه الآن

191
00:10:34,090 --> 00:10:36,640
.مهلاً، لا تسرعي هكذا

192
00:10:38,070 --> 00:10:39,570
!ا-انتظري

193
00:10:40,500 --> 00:10:43,550
.أبليتَ حسنًا من أجلي

194
00:10:43,550 --> 00:10:45,740
.فكّرت في أن أكافئك

195
00:10:47,710 --> 00:10:49,340
.انظر لحالك وأنت متحمّس

196
00:10:49,340 --> 00:10:51,230
.كم أنت ظريف

197
00:10:51,230 --> 00:10:52,210
...والآن

198
00:10:52,540 --> 00:10:54,010
!مهلاً يا أماني

199
00:10:59,910 --> 00:11:02,320
.صباح الخير يا أكتسو-كُن

200
00:11:02,320 --> 00:11:04,100
هل كانت قيلولتك جيّدة؟

201
00:11:04,490 --> 00:11:08,180
كيف تجرؤ على النّوم في فصلي؟

202
00:11:08,180 --> 00:11:09,820
!شـ-شيرومورا-سينسي

203
00:11:09,820 --> 00:11:11,580
!مهلاً، لا، توقّف

204
00:11:11,580 --> 00:11:12,940
!خذ هذا

205
00:11:13,440 --> 00:11:15,860
منذ يوم خروجنا أنا وأماني
،لمطاردة الشّياطين

206
00:11:15,860 --> 00:11:18,860
ممنوع الاقتراب

207
00:11:16,140 --> 00:11:18,510
.وهذه الأحلام تراودني

208
00:11:19,280 --> 00:11:23,320
.بالتّفكير في الأمر، كان قلبي يدقّ بسرعة

209
00:11:24,560 --> 00:11:25,530
...كلاّ

210
00:11:25,530 --> 00:11:26,820
.لا، لا، لا

211
00:11:27,160 --> 00:11:29,350
ذلك أمر مستحيل، صحيح؟

212
00:11:29,870 --> 00:11:32,830
!أنا؟ أكنّ مشاعر رومانسيّة؟

213
00:11:33,240 --> 00:11:34,670
.مستحيل

214
00:11:34,670 --> 00:11:36,500
.كما أنّها العدوّ

215
00:11:36,500 --> 00:11:39,050
...وإضافة لذلك، فهي

216
00:11:44,140 --> 00:11:49,190
.سُحقًا، إنّها تتلاعب بي بالفعل

217
00:11:51,840 --> 00:11:53,480
.أنا قادم

218
00:11:55,610 --> 00:11:57,420
!ظهرتَ أخيرًا

219
00:11:57,420 --> 00:12:00,610
لا يجب أن تكون كسولاً فقط
!لأنّ لا مدرسة لديك

220
00:12:04,480 --> 00:12:05,530
—ظهرتَ أخير

221
00:12:06,400 --> 00:12:07,450
.يا إلهي

222
00:12:07,450 --> 00:12:10,540
كيف أغلقت الباب في وجه رئيستك؟

223
00:12:10,540 --> 00:12:12,230
.آسف يا رئيسة القسم ليز

224
00:12:12,730 --> 00:12:14,570
ماذا أتى بك إلى هنا؟

225
00:12:15,040 --> 00:12:17,850
.إنّ الأمر يخصّ ما أرسته لك مؤخّرًا

226
00:12:17,850 --> 00:12:19,840
.هناك شيء أريد إعطاءك إيّاه

227
00:12:20,110 --> 00:12:21,920
أهو في تلك الحقيبة؟

228
00:12:21,920 --> 00:12:23,260
.ليس هذا

229
00:12:24,260 --> 00:12:27,420
.إنّه ما أرتديه الآن

230
00:12:27,420 --> 00:12:31,290
قيل لي أنّ هناك تقليد تغيير ملابس
.ليتناسب مع الموسم

231
00:12:31,290 --> 00:12:33,230
.أحضرتُ زيًّا خاصًّا لتلك المناسبة

232
00:12:33,230 --> 00:12:34,810
لكن لماذا كان عليك ارتداؤه؟

233
00:12:34,810 --> 00:12:37,060
.كما أنّه زيّ فتيات

234
00:12:39,650 --> 00:12:42,080
.سأرسل زيّك لاحقًا

235
00:12:42,080 --> 00:12:43,390
.في البريد العاجل

236
00:12:43,390 --> 00:12:45,540
.واثق أنّك أردت ارتداءه فحسب

237
00:12:47,320 --> 00:12:49,790
كيف وضع مهمّتك؟

238
00:12:49,790 --> 00:12:52,060
هل قابلت أيّ شخص
قد يكون مناسبًا للمهمّة؟

239
00:12:52,450 --> 00:12:53,530
مهمّتي؟

240
00:12:53,530 --> 00:12:54,640
.صحيح

241
00:12:54,640 --> 00:12:57,750
.أتيت إلى هنا في مهمّة

242
00:12:58,400 --> 00:13:02,760
.عالمنا الجحيم في خطر

243
00:13:03,300 --> 00:13:09,890
قرّر رئيسي العثور على شخص ما له
.شخصيّة كاريزميّة لقيادتنا وتحفيزنا

244
00:13:10,380 --> 00:13:13,770
.وتمّ توكيلي بمهمّة البحث عنه

245
00:13:14,280 --> 00:13:16,280
.لا... ليس تمامًا

246
00:13:16,280 --> 00:13:17,690
.فهمت

247
00:13:17,960 --> 00:13:20,480
ألم تعثر ولو حتّى على مرشّح واحد؟

248
00:13:20,480 --> 00:13:21,360
...بلى

249
00:13:21,360 --> 00:13:26,120
،وجدتُ شخصًا بدا مناسبًا
.لكن اتّضح أنّ لديها بعض المشاكل

250
00:13:26,120 --> 00:13:28,780
.إنّها جذّابة، لكن لديها شخصيّة فظيعة

251
00:13:28,780 --> 00:13:32,910
،ربّما أكون انتقائيًّا
.لكن هناك ما يثير قلقي

252
00:13:32,910 --> 00:13:34,090
.فهمت

253
00:13:34,090 --> 00:13:36,480
.أفهم لماذا قد تكون حذرًا

254
00:13:36,480 --> 00:13:39,250
.لكن لا تنس أنّ الوقت يداهمنا

255
00:13:39,600 --> 00:13:42,190
.سأبذل قصارى جهدي لدعمك

256
00:13:42,190 --> 00:13:43,000
.حسنًا

257
00:13:44,090 --> 00:13:46,970
حسنًا، هل نخلد للنّوم؟

258
00:13:46,970 --> 00:13:47,690
ماذا؟

259
00:13:48,560 --> 00:13:50,730
!مـ-مهلاً، هـ-هل ستنامين هنا؟

260
00:13:50,730 --> 00:13:53,180
.لا يملك قسمنا ميزانيّة كبيرة

261
00:13:53,180 --> 00:13:55,050
.لكن لا تقلق

262
00:13:55,050 --> 00:13:56,980
.أحضرتُ معي كلّ شيء أحتاجه

263
00:13:56,980 --> 00:13:58,490
أتلك عدّة استعدادك للنّوم؟

264
00:13:59,100 --> 00:14:01,300
.سأغيّر ملابسي الآن

265
00:14:02,110 --> 00:14:03,860
ما الّذي يفترض بي فعله؟

266
00:14:03,860 --> 00:14:05,690
.هذا خاطئ على عدّة مستويات

267
00:14:05,690 --> 00:14:09,750
تماسك، أهذه واحدة من قصص الحبّ
الممنوع بين الموظّف ورئيسه؟

268
00:14:10,230 --> 00:14:12,170
...يا حَملي الظّريف

269
00:14:12,170 --> 00:14:13,990
.أنا ألباكا

270
00:14:13,990 --> 00:14:15,130
!كلاّ

271
00:14:15,130 --> 00:14:16,500
!هذا سّيئ

272
00:14:17,800 --> 00:14:19,370
هل من خطب ما؟

273
00:14:19,370 --> 00:14:22,010
.سوف تحوّلني إلى رجل

274
00:14:22,010 --> 00:14:23,340
.قشّة

275
00:14:24,070 --> 00:14:26,860
.أحضرت هذه معي

276
00:14:26,860 --> 00:14:27,970
...حسنًا

277
00:14:30,240 --> 00:14:32,120
!لا يمكنني النّوم

278
00:14:32,120 --> 00:14:34,940
!لا يمكنني أكل كلّ ذلك

279
00:14:35,810 --> 00:14:37,760
...لكنّه لذيذ جدًّا

280
00:14:37,760 --> 00:14:39,400
!لذيذ للغاية

281
00:14:39,400 --> 00:14:40,970
أيّ نوع من الحديث أثناء النّوم يكون هذا؟

282
00:14:42,740 --> 00:14:45,230
.سنذهب للتّدريب بعد الفطور

283
00:14:45,680 --> 00:14:47,070
تدريب؟

284
00:14:47,550 --> 00:14:51,530
يا آنستي، هل أنت متفرّغة؟

285
00:14:51,530 --> 00:14:53,470
...أتريدين المجيء معي و

286
00:14:53,470 --> 00:14:55,530
.مقرف. لم يقل أحد أنّ بإمكانك محادثتي

287
00:14:55,530 --> 00:14:59,040
.كما أنّك تجول الأرجاء وتكلّم الجميع

288
00:14:59,040 --> 00:15:01,300
.الإيقاع بنا ليس بتلك السّهولة

289
00:15:02,680 --> 00:15:04,780
!ما عدت أريد القيام بهذا

290
00:15:04,780 --> 00:15:06,670
.إنّنا لا نحرز أيّ تقدّم

291
00:15:06,670 --> 00:15:07,610
...عفوًا

292
00:15:07,610 --> 00:15:10,030
كيف يعتبر هذا تدريبًا؟

293
00:15:10,030 --> 00:15:14,550
،حتّى إن عثرتَ على مرشّح مناسب
.فذلك لا يهمّ إن لم تستطع إحضاره للجحيم

294
00:15:14,550 --> 00:15:18,970
أم أنّك واثق أنّ بإمكانك إعطاءه
تفاصيل واجباته

295
00:15:18,970 --> 00:15:22,210
وإقناعه بتولّيها وإحضاره للجحيم؟

296
00:15:22,210 --> 00:15:24,440
.جرّبتُ ذلك على ملاك بالفعل

297
00:15:24,440 --> 00:15:26,800
حتّى إن وافق أن يكون معبود
،جماهير من نوع ما

298
00:15:26,800 --> 00:15:28,940
.فلن ينفع ذلك إن كان غير راضٍ

299
00:15:29,280 --> 00:15:32,970
نحتاج لموافقته على المجيء حتّى يتمكّن
.من تعزيز معنوياتنا بشكل فعّال

300
00:15:34,180 --> 00:15:35,440
...عفوًا

301
00:15:35,440 --> 00:15:38,650
.كنتُ أبحث عن كلبي منذ أيّام

302
00:15:39,750 --> 00:15:42,670
.لا أظنّ أنّي رأيته

303
00:15:42,670 --> 00:15:45,980
...أكره الضّغط عليك

304
00:15:46,800 --> 00:15:49,320
لكن هلاّ أبلغتني إن رأيته؟

305
00:15:49,320 --> 00:15:53,260
إنّ أختي الصّغيرة المريضة
.قلقة عليه وتأبى الأكل

306
00:15:54,440 --> 00:15:56,030
.حسنًا

307
00:15:56,030 --> 00:15:57,800
.سأسأل أصدقائي أيضًا

308
00:15:57,800 --> 00:16:00,170
هلاّ أعطيتني معلومات الاتّصال بك؟

309
00:16:00,580 --> 00:16:01,890
!شكرًا لك

310
00:16:02,220 --> 00:16:04,410
.أنا ممتنّ لك

311
00:16:04,900 --> 00:16:07,900
.أتمنّى أن تجده بسرعة

312
00:16:08,350 --> 00:16:10,360
.آسف على الكذب

313
00:16:11,060 --> 00:16:13,650
!لكنّي حصلتُ على بياناتها

314
00:16:13,650 --> 00:16:14,780
كيف سار الأمر؟

315
00:16:14,780 --> 00:16:17,210
.بدا ذلك واعدًا

316
00:16:17,210 --> 00:16:18,400
.نعم

317
00:16:18,400 --> 00:16:20,660
.لكنّ الذّنب يثقل كاهلي

318
00:16:20,660 --> 00:16:25,660
تدور الحرب حول تركيز
.كلّ قوّتك في مكان واحد

319
00:16:25,660 --> 00:16:27,040
عمّ تتحدّثين؟

320
00:16:27,040 --> 00:16:30,460
.تحتاج إلى تحديد المكان الأفضل لتركيز جهودك

321
00:16:30,460 --> 00:16:33,280
.كانت تلك المرأة تُمشّي كلبها

322
00:16:33,280 --> 00:16:37,920
،هناك طريق للوصول لكلّ امرأة
.وليس هي فقط

323
00:16:37,920 --> 00:16:39,450
.عليك أن تهدف لذلك

324
00:16:39,450 --> 00:16:42,440
.وهكذا ستتطوّر

325
00:16:42,440 --> 00:16:43,180
.نعم

326
00:16:43,180 --> 00:16:44,730
!يا للظّرافة

327
00:16:44,730 --> 00:16:45,920
!شكرًا لك

328
00:16:45,920 --> 00:16:48,150
.يا لك من شابّ لطيف

329
00:16:48,150 --> 00:16:50,190
.لنواصل

330
00:16:50,190 --> 00:16:53,070
.قم بدعوتها لشرب الشّاي وقضاء الوقت معًا

331
00:16:53,650 --> 00:16:54,960
.مرحبًا

332
00:16:54,960 --> 00:16:56,360
هلّي بدقيقة من وقتك؟

333
00:16:56,360 --> 00:16:57,560
ماذا؟

334
00:16:57,560 --> 00:16:59,580
.مهلاً. هذا أنت يا أكتسو-كُن

335
00:16:59,580 --> 00:17:01,580
!تاناهاشي

336
00:17:01,980 --> 00:17:03,370
ماذا تفعل؟

337
00:17:03,370 --> 00:17:07,290
.لا تقل لي أنّك واحد من أولئك الرّجال

338
00:17:07,290 --> 00:17:09,150
.كلاّ، لا أحاول مغازلتك أو ما شابه

339
00:17:09,150 --> 00:17:11,760
!إنّك تحاول فعلاً مغازلة الآخرين

340
00:17:10,760 --> 00:17:11,760
!كلاّ

341
00:17:12,080 --> 00:17:13,320
.لنذهب إذًا

342
00:17:13,320 --> 00:17:14,240
سنشرب الشّاي، صحيح؟

343
00:17:14,240 --> 00:17:15,130
.على حسابك

344
00:17:15,130 --> 00:17:16,630
...ماذا؟ نعم

345
00:17:18,000 --> 00:17:19,780
.نمت جيّدًا

346
00:17:20,520 --> 00:17:23,140
.يبدو أنّي تأخّرت في النّوم كثيرًا هذا الأحد

347
00:17:23,140 --> 00:17:25,720
لا يبدو أنّه سيكون لدينا وقت
.لصيد الشّياطين اليوم

348
00:17:25,720 --> 00:17:27,560
.أعتقد أنّي سأغسل ملابسي إذًا

349
00:17:28,260 --> 00:17:29,730
لماذا هنا؟

350
00:17:30,120 --> 00:17:33,490
.أردتُ أن يكون مكانًا يرتاده الكبار

351
00:17:33,770 --> 00:17:35,950
.تفضّلي عصير البرتقال

352
00:17:35,950 --> 00:17:37,740
.شكرًا جزيلاً لك

353
00:17:37,740 --> 00:17:41,740
وهل شرب العصير فقط يساعد على ذلك؟

354
00:17:41,740 --> 00:17:43,750
.مـ-معك حقّ

355
00:17:44,900 --> 00:17:47,470
يا رئيسة، ماذا أفعل الآن؟

356
00:17:47,470 --> 00:17:49,320
!ا-انتظر لحظة

357
00:17:49,320 --> 00:17:50,840
!ليس هنا

358
00:17:50,840 --> 00:17:52,130
...مهلاً... لا يعقل

359
00:17:52,540 --> 00:17:53,820
!إنّها تتحقّق من كتاب؟

360
00:17:54,510 --> 00:17:55,100
!سُحقًا

361
00:17:55,100 --> 00:17:56,590
!لا يمكنني الاعتماد على رئيستي

362
00:17:56,590 --> 00:17:57,120
...هذا المكان

363
00:17:57,120 --> 00:18:00,300
...صحيح، لقد كنتُ أتساءل

364
00:18:00,300 --> 00:18:02,350
هل أنت معجب بليلي-تشان؟

365
00:18:02,930 --> 00:18:04,480
.تقضيان الكثير من الوقت معًا

366
00:18:04,480 --> 00:18:06,180
.لا، هذا مستحيل

367
00:18:06,180 --> 00:18:07,690
هل أنت واثق؟

368
00:18:07,690 --> 00:18:09,190
من تكون ليلي-سان؟

369
00:18:09,190 --> 00:18:10,690
!ليس الوقت مناسبًا لذلك يا رئيسة

370
00:18:10,690 --> 00:18:14,270
لكنّك تجدها ظريفة جدًّا، صحيح؟

371
00:18:14,270 --> 00:18:15,570
...بالطّبع

372
00:18:18,570 --> 00:18:20,270
.لا

373
00:18:20,270 --> 00:18:22,160
.أنت كالكتاب المفتوح

374
00:18:22,160 --> 00:18:25,120
.لا تحزن، سأساعدك إن احتجت لأيّ شيء

375
00:18:25,120 --> 00:18:27,750
ماذا عنك يا تاناهاشي؟

376
00:18:27,750 --> 00:18:28,680
أنت وهيروتا؟

377
00:18:28,680 --> 00:18:30,510
تقصد كنساكو؟

378
00:18:30,510 --> 00:18:34,880
.أنا أبذل جهدي، لكنّ الأمر ليس سهلاً

379
00:18:37,460 --> 00:18:41,590
.وكوني صديقة طفولته لا يُساعد أبدًا

380
00:18:41,590 --> 00:18:42,720
!هذه هي

381
00:18:42,720 --> 00:18:45,320
!هذا هو الوقت المناسب لقول شيء لطيف

382
00:18:45,320 --> 00:18:47,180
هل هناك أيّ نصيحة لأقدّمها إليها؟

383
00:18:47,180 --> 00:18:48,020
!أجل

384
00:18:48,020 --> 00:18:51,440
...اسمعي يا تاناهاشي، تدور الحرب

385
00:18:51,440 --> 00:18:52,480
ماذا؟

386
00:18:52,480 --> 00:18:54,030
ما كانت الجملة؟

387
00:18:54,030 --> 00:18:55,440
!لا أتذكّر

388
00:18:55,440 --> 00:19:00,640
تدور الحرب حول تركيز كلّ قوّتك
في مكان واحد، صحيح؟

389
00:19:00,640 --> 00:19:02,520
.هذه مقولة لنابوليون

390
00:19:03,140 --> 00:19:04,760
.معك حقّ

391
00:19:04,760 --> 00:19:08,110
،كنتُ أنا من تضغط عليه طوال الوقت

392
00:19:08,110 --> 00:19:10,480
.لكن ربّما كنتُ أركّز على الشّيء الخاطئ

393
00:19:10,480 --> 00:19:12,420
.شكرًا لك. كانت نصيحة جيّدة

394
00:19:12,420 --> 00:19:14,410
!نجح الأمر

395
00:19:14,410 --> 00:19:17,420
!لا أعرف من هو نابوليتان، لكن شكرًا له

396
00:19:17,840 --> 00:19:20,120
،لا تعتبر هذا وكأنّي أحاول ردّ الجميل

397
00:19:20,120 --> 00:19:23,390
،لكن إن حدث شيء مع ليلي-تشان
.فأنا جاهزة للاستماع لك

398
00:19:23,390 --> 00:19:25,280
.حـ-حسنًا

399
00:19:25,280 --> 00:19:27,270
.أنت رائعة بالفعل

400
00:19:27,660 --> 00:19:28,770
.أعلم ذلك

401
00:19:29,050 --> 00:19:31,690
!وأنت أيضًا لست سيّئًا يا أكتسو-كُن

402
00:19:32,000 --> 00:19:33,630
!حسنًا، الخطوة التّالية

403
00:19:33,630 --> 00:19:36,300
.قم بدعوتها إلى حديقة في اللّيل

404
00:19:36,300 --> 00:19:37,190
!كلاّ

405
00:19:37,190 --> 00:19:39,230
،بعد محادثة جيّدة في الحانة

406
00:19:39,230 --> 00:19:42,890
فلا شكّ أنّها تسعى لتكون وحدها
!معك في حديقة في اللّيل

407
00:19:42,890 --> 00:19:43,820
!أو هذا ما يُقال

408
00:19:43,820 --> 00:19:45,560
!لن أقوم بذلك في هذا الوضع

409
00:19:45,950 --> 00:19:48,750
.إنّها معجبة بصديقي

410
00:19:48,750 --> 00:19:51,380
!لا يُعقل أن أدعوها للحديقة في اللّيل

411
00:19:53,240 --> 00:19:56,540
!ستنتهي حياتي المدرسيّة إن اكتُشِف الأمر

412
00:19:56,540 --> 00:19:58,800
،عدم اتّباع الأوامر سيؤثّر على تقييمك

413
00:19:58,800 --> 00:20:00,280
.حتّى إن كان مجرّد تدريب

414
00:20:00,280 --> 00:20:01,470
!هل أنت جادّة؟

415
00:20:01,470 --> 00:20:03,280
.لقد تأخّر الوقت

416
00:20:03,280 --> 00:20:04,300
.علينا الذّهاب

417
00:20:04,300 --> 00:20:05,430
!تمهّلي

418
00:20:09,350 --> 00:20:10,800
.آ-آسف

419
00:20:10,800 --> 00:20:11,880
...عفوًا

420
00:20:14,160 --> 00:20:15,640
...هل لديك وقت

421
00:20:18,170 --> 00:20:20,300
.غفوت وأنا أغسل ملابسي

422
00:20:20,300 --> 00:20:21,780
.ربّما أصبت بزكام

423
00:20:22,140 --> 00:20:24,240
.ربّما عليّ أخذ حمّام لأدفّئ نفسي

424
00:20:26,070 --> 00:20:26,990
.آسف على ذلك

425
00:20:26,990 --> 00:20:29,120
.لا أمانع

426
00:20:29,120 --> 00:20:31,230
.رغم أنّ ذلك أحرجني

427
00:20:32,290 --> 00:20:36,630
.لكنّي لن أخبر أحدًا عن اليوم

428
00:20:37,020 --> 00:20:38,620
.يمكنني الذّهاب بمفردي من هنا

429
00:20:38,620 --> 00:20:39,870
.شكرًا على كلّ شيء اليوم

430
00:20:39,870 --> 00:20:41,350
.أراك غدًا في المدرسة

431
00:20:44,800 --> 00:20:46,520
.أبليت حسنًا

432
00:20:46,520 --> 00:20:49,960
،كاد الوقت ينفد منّي
.لذلك أفكّر في العودة للمنزل

433
00:20:49,960 --> 00:20:50,930
.هكذا إذًا

434
00:20:51,280 --> 00:20:54,270
.آسفة على الزّيارة المفاجئة

435
00:20:54,570 --> 00:20:58,160
.لكنّي سعيدة برؤية كيف تعيش حياتك

436
00:20:58,160 --> 00:20:58,770
.نعم

437
00:20:59,430 --> 00:21:01,650
...لكن هناك أمر واحد

438
00:21:02,710 --> 00:21:04,310
هل لديك وقت لاحقًا؟

439
00:21:04,310 --> 00:21:06,610
.لا-لا يجب علينا هذا

440
00:21:11,010 --> 00:21:12,730
.لا تقل ذلك

441
00:21:12,730 --> 00:21:13,540
.لا بأس بهذا

442
00:21:16,040 --> 00:21:18,980
!سيّدي؟

443
00:21:19,670 --> 00:21:21,640
،لا مشكلة لديّ بشأن تفضيلاتك

444
00:21:21,640 --> 00:21:24,670
لكنّي لا أعتقد أنّ ذلك كان
.ملائمًا أمام امرأة أخرى

445
00:21:24,670 --> 00:21:26,930
!انسي ذلك رجاءً

446
00:21:27,220 --> 00:21:28,220
...تبًّا لأماني

447
00:21:31,000 --> 00:21:33,180
رغم أنّي أعتقد أنّها ساعدتني قليلاً؟

448
00:21:33,180 --> 00:21:37,440
.طبّق رجاءً مع تعلّمته اليوم من الآن فصاعدًا

449
00:21:37,440 --> 00:21:40,940
.أنا أؤمن أنّك ستكمل مهمّتك

450
00:21:41,560 --> 00:21:44,150
.واصل بذل جهدك

451
00:21:47,330 --> 00:21:49,020
.أنا متعب

452
00:21:49,970 --> 00:21:53,290
.قضيت اليوم بطوله تحت سيادة رئيستي

453
00:21:54,040 --> 00:21:57,670
.ولكن بفضل ذلك، اكتسبت ثقة أكثر

454
00:21:58,240 --> 00:22:03,960
،أودّ العودة لمهمّتي في الحال
.لكن عليّ التّعامل معها أوّلاً

455
00:22:04,580 --> 00:22:07,960
!سأحاول مرّة أخرى