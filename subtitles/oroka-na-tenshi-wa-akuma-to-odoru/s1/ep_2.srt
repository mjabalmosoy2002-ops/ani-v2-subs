1
00:01:35,030 --> 00:01:38,670
ما الّذي تحاولين إرغامي
على فعله باستعمال هذا؟

2
00:01:38,670 --> 00:01:40,070
هل هناك داعٍ له من الأساس؟

3
00:01:40,070 --> 00:01:41,390
.بالطّبع هناك

4
00:01:41,390 --> 00:01:43,770
.إنّه ضروريّ

5
00:01:44,550 --> 00:01:46,510
...والآن يا أكتسو

6
00:01:46,510 --> 00:01:49,380
...بعدما صرتَ خادمي

7
00:01:49,720 --> 00:01:52,380
.ستساعدني على صيد الشّياطين

8
00:01:53,470 --> 00:01:56,280
أتقولين أنّ عليّ قتل بني جنسي؟

9
00:01:56,280 --> 00:01:57,050
هل ترفض؟

10
00:01:57,050 --> 00:01:58,250
!بالطّبع أرفض

11
00:02:00,880 --> 00:02:02,700
.هذا مفاجئ

12
00:02:02,700 --> 00:02:06,520
.لم أكن أعتقد أنّ للشّياطين شعورًا بالقرابة

13
00:02:06,520 --> 00:02:09,520
!لدينا نحن الشّياطين معاييرنا المجتمعيّة الخاصّة

14
00:02:10,070 --> 00:02:12,700
كيف لنا أن نخون من دعمونا؟

15
00:02:13,200 --> 00:02:16,120
.أعددتُ الكثير من الكينبيرا

16
00:02:16,120 --> 00:02:18,200
.شكرًا جزيلاً لك

17
00:02:18,200 --> 00:02:19,420
.كلاّ، شعري متقصّف

18
00:02:19,420 --> 00:02:21,070
!انتبهي لي

19
00:02:21,070 --> 00:02:23,950
.لم يكون لي أيّ دور في ذلك النّوع من الخيانة

20
00:02:23,950 --> 00:02:25,930
!يمكنك أن ترقيني إن اضطررتِ لذلك

21
00:02:26,560 --> 00:02:28,010
ماذا؟

22
00:02:28,010 --> 00:02:29,030
...سُحقًا

23
00:02:30,580 --> 00:02:31,530
!سُحقًا

24
00:02:31,530 --> 00:02:32,380
ماذا؟

25
00:02:32,380 --> 00:02:35,470
.نسيت أن أخبرك

26
00:02:35,470 --> 00:02:38,340
.أنا الوحيدة الّتي يمكنني إزالته

27
00:02:38,870 --> 00:02:41,930
.إنّه يكبح قوّة الشّياطين

28
00:02:41,930 --> 00:02:46,540
.حتّى أنّه يؤدّي دور منارة في حالة هروبك

29
00:02:46,540 --> 00:02:48,520
...كـ-كلاّ

30
00:02:49,100 --> 00:02:51,700
...وبلمسة من قوّتي

31
00:02:56,180 --> 00:02:58,540
!يتحرّك جسدي من تلقاء نفسه

32
00:03:00,620 --> 00:03:03,610
.بإمكاني معاقبتك

33
00:03:03,610 --> 00:03:06,870
.المشكلة الوحيدة هي أنّي أجهل ماذا سيحدث

34
00:03:07,420 --> 00:03:14,010
.هذا هو خياري الوحيد إن رفضت التّعاون

35
00:03:14,010 --> 00:03:17,100
ما قولك؟ هل ستعيد التّفكير في الأمر؟

36
00:03:17,100 --> 00:03:18,680
...و-ولماذا قد

37
00:03:18,680 --> 00:03:19,580
!سُحقًا

38
00:03:19,580 --> 00:03:21,260
ما الّذي يحدث لي؟

39
00:03:21,960 --> 00:03:23,360
...شـ-شكـ

40
00:03:23,360 --> 00:03:25,020
!إنّه يرغمني على الكلام

41
00:03:26,600 --> 00:03:29,380
.شكرًا على الانتظار يا آنستي

42
00:03:29,680 --> 00:03:32,200
.أنا تحت أمرك

43
00:03:32,200 --> 00:03:33,280
!سُحقًا

44
00:03:33,280 --> 00:03:35,860
!لا يمتثل جسدي لأوامري

45
00:03:35,860 --> 00:03:36,540
.انحناء

46
00:03:36,540 --> 00:03:38,270
!لماذا أنحني؟

47
00:03:38,270 --> 00:03:40,110
...جيّد. لنرَ

48
00:03:40,760 --> 00:03:42,390
.أنا عطشى

49
00:03:43,940 --> 00:03:45,820
ما تلك الوضعيّة؟

50
00:03:49,220 --> 00:03:50,970
.شكرًا على الانتظار

51
00:03:53,800 --> 00:03:55,450
.أحضرت لك خيارات عدّة

52
00:03:55,450 --> 00:03:57,310
!كفّ عن التّصرّف كخادم لها يا أنا

53
00:03:58,000 --> 00:04:00,300
.لا أراك تحمل أيّ شيء

54
00:04:00,300 --> 00:04:02,430
.أعتذر

55
00:04:02,430 --> 00:04:05,220
.لم أكن أحمل كيسًا

56
00:04:06,590 --> 00:04:10,590
.هذه هي المشروبات الّتي طلبتها

57
00:04:10,590 --> 00:04:12,650
.لقد دفّأتها بحرارة جسدي

58
00:04:12,650 --> 00:04:14,230
!لماذا فعلتُ ذلك من الأساس؟

59
00:04:18,580 --> 00:04:19,980
!إنّه دافئ

60
00:04:23,680 --> 00:04:25,740
أكره ألاّ أقدّم لك أيّ شيء
.في المقابل بعد كلّ هذا

61
00:04:25,740 --> 00:04:28,010
هل لديك أيّ طلبات؟

62
00:04:29,200 --> 00:04:31,070
أقلت طلبات؟

63
00:04:31,070 --> 00:04:33,530
...في تلك الحالة، أظنّني

64
00:04:33,530 --> 00:04:34,870
ماذا الآن؟

65
00:04:35,510 --> 00:04:38,540
.إنّ جسدي متصلّب كثيرًا مؤخّرًا

66
00:04:38,540 --> 00:04:40,420
...وما يقلقني كثيرًا

67
00:04:40,420 --> 00:04:43,340
.هي مؤخّرتي الّتي في حالة سيّئة

68
00:04:43,340 --> 00:04:46,340
!بل رأسي هو الّذي في حالة سيّئة

69
00:04:46,340 --> 00:04:47,660
ماذا؟

70
00:04:47,660 --> 00:04:49,870
هل تطلب منّي أن أدلّك مؤخّرتك؟

71
00:04:49,870 --> 00:04:51,210
...كلاّ

72
00:04:51,210 --> 00:04:56,650
مجرّد الدّوس عليها بقدميك
.الجميلتين سيكون كافيًا

73
00:05:00,050 --> 00:05:01,720
،لديك ذوق غريب

74
00:05:01,720 --> 00:05:03,290
.هذا متوقّع من شيطان

75
00:05:03,910 --> 00:05:05,450
.حسنًا

76
00:05:05,450 --> 00:05:07,780
...سأحرص على

77
00:05:06,560 --> 00:05:08,790
...كلاّ... كلاّ

78
00:05:08,370 --> 00:05:10,030
!أن أدوس عليها جيّدًا

79
00:05:10,030 --> 00:05:11,580
!كلاّ، رجاءً

80
00:05:11,960 --> 00:05:14,000
!ستتألّم مؤخّرتي كثيرًا هكذا

81
00:05:14,420 --> 00:05:15,870
هل يمكنني ذلك؟

82
00:05:15,870 --> 00:05:17,960
هل مسموح لي بالفعل القيام بهذا؟

83
00:05:18,330 --> 00:05:24,450
هل أوشك على اقتراف خطأ جسيم
لا أستطيع التّراجع عنه؟

84
00:05:24,450 --> 00:05:25,420
...ولكن

85
00:05:25,710 --> 00:05:27,210
.إنّها مكافأة

86
00:05:27,210 --> 00:05:28,840
.إنّها رغبته

87
00:05:28,840 --> 00:05:29,870
.هذه المرّة فقط

88
00:05:29,870 --> 00:05:31,370
.هذا ليس بالأمر المهمّ

89
00:05:31,370 --> 00:05:32,680
.لا، انتظري

90
00:05:32,680 --> 00:05:34,930
هل سينتهي الأمر عند هذا الحدّ؟

91
00:05:34,930 --> 00:05:36,190
...نعم

92
00:05:36,190 --> 00:05:37,420
.سألمسه فحسب

93
00:05:37,420 --> 00:05:39,080
!لمسة من حذائي لا غير

94
00:05:39,080 --> 00:05:41,510
!لن أتمادى أكثر من ذلك

95
00:05:44,680 --> 00:05:48,530
!هل هذين الطّفلين يلعبان الـ—— في العلن؟

96
00:05:48,530 --> 00:05:50,200
!أريد الانضمام

97
00:05:49,120 --> 00:05:50,560
!هذا سيّئ

98
00:05:50,560 --> 00:05:52,450
!إنّها سريعة للغاية

99
00:05:53,730 --> 00:05:55,320
!يمكنني الحركة ثانية

100
00:05:55,320 --> 00:05:56,620
!تمهّلاً

101
00:05:57,350 --> 00:05:59,080
!أيّها الثّنائيّ اللّعين

102
00:06:03,480 --> 00:06:05,310
.لقد ضلّلناه

103
00:06:05,310 --> 00:06:06,720
.نعم

104
00:06:06,720 --> 00:06:09,210
...لنعد لما كنّا نفعله

105
00:06:09,210 --> 00:06:10,140
ما قولك؟

106
00:06:10,140 --> 00:06:12,640
هل ستتعاون معي؟

107
00:06:14,800 --> 00:06:16,640
.فهمت. إنّك ترفض

108
00:06:17,050 --> 00:06:20,020
ستكون محظوظًا لو بقيت على أطرافك
.الأربعة فحسب في المرّة القادمة

109
00:06:20,020 --> 00:06:22,980
.قد لا تكون مرتديًا ملابس أيضًا

110
00:06:23,830 --> 00:06:26,380
!ارقيني فحسب

111
00:06:26,380 --> 00:06:27,720
.لن أفعل ذلك

112
00:06:27,720 --> 00:06:29,070
.ليس بعد على الأقلّ

113
00:06:29,070 --> 00:06:29,950
لماذا؟

114
00:06:31,120 --> 00:06:33,600
.لديّ هدف

115
00:06:33,600 --> 00:06:35,100
.لا يمكنني إخبارك أكثر من هذا

116
00:06:35,680 --> 00:06:39,420
والآن، لا يمكنني السّماح لك
.بالتّصرّف على راحتك أيضًا

117
00:06:42,240 --> 00:06:43,920
ما إجابتك؟

118
00:06:43,920 --> 00:06:46,020
هل ستفعل ما أطلبه منك؟

119
00:06:46,590 --> 00:06:49,370
أم تفضّل القيام بانتحار اجتماعيّ؟

120
00:06:50,630 --> 00:06:53,140
كيف لوجه ظريف كهذا أن يقول
كلمات شرّيرة كهذه؟

121
00:06:53,640 --> 00:06:55,370
...حسنًا، اسمعي

122
00:06:55,370 --> 00:06:58,380
ما رأيك أن أخبرك إن كانت هناك
شياطين في الجوار فحسب؟

123
00:06:58,380 --> 00:07:01,210
بإمكاننا الشّعور ببعضنا
.أن كنّا قريبين نوعًا ما

124
00:07:02,390 --> 00:07:03,650
.هذا يناسبني

125
00:07:04,030 --> 00:07:06,840
...لكن إن فشلت في إخباري

126
00:07:06,840 --> 00:07:08,490
!فهمت! فهمت

127
00:07:08,830 --> 00:07:10,380
!اتّفقنا إذًا

128
00:07:10,380 --> 00:07:12,110
...آسف يا رفاقي

129
00:07:12,110 --> 00:07:14,040
.لا تأتوا إلى عالم البشر بعد الآن رجاءً

130
00:07:14,490 --> 00:07:16,140
.أكتسو ماساتورا

131
00:07:16,140 --> 00:07:19,740
.صرت الآن خادمي

132
00:07:19,740 --> 00:07:21,880
.ولكن ليس بدون مكافأة

133
00:07:21,880 --> 00:07:27,150
سأعيد تأهيلك لتصير رجلاً صالحًا
.وصادقًا وأمينًا بينما تخدمني

134
00:07:27,150 --> 00:07:29,290
.هذا ما ستحصل عليه من هذا

135
00:07:29,290 --> 00:07:30,680
.إنّها مكافأتك

136
00:07:30,680 --> 00:07:32,560
هذه مكافأة؟

137
00:07:32,560 --> 00:07:34,140
ماذا؟ ألديك مشكلة في هذا؟

138
00:07:34,140 --> 00:07:37,000
.لا شيء محفّز فيها

139
00:07:37,000 --> 00:07:39,520
.أفترض أنّك محقّ

140
00:07:39,960 --> 00:07:41,310
...التّحفيز

141
00:07:41,310 --> 00:07:43,200
...وشيء يناسب رجلاً يوشك بلوغ سنّ الرّشد

142
00:07:43,200 --> 00:07:44,820
ما رأيك بهذا إذًا؟

143
00:07:46,640 --> 00:07:51,540
سأمنحك عناقًا مقابل كلّ مهمّة
.تؤدّيها على أحسن وجه

144
00:07:51,540 --> 00:07:53,160
أتريد أن تجرّب؟

145
00:07:55,030 --> 00:07:56,780
!كيف تجرئين؟

146
00:07:56,780 --> 00:07:58,040
!أنا أمزح

147
00:07:58,040 --> 00:08:00,520
لماذا قد تأخذ ذلك على محمل
الجدّ أيّها المنحرف؟

148
00:08:01,000 --> 00:08:04,220
.على أيّ حال، يمكننا التّفكير في مكافأتك لاحقًا

149
00:08:04,220 --> 00:08:05,000
.وجدتكما

150
00:08:06,550 --> 00:08:09,260
!أيّها الثّنائيّ الـ—— في العلن

151
00:08:09,260 --> 00:08:11,340
!تعاليا معي ولا تقاوما

152
00:08:11,340 --> 00:08:12,870
.لنهرب

153
00:08:14,710 --> 00:08:15,500
!انتظري

154
00:08:16,100 --> 00:08:17,260
!مهلاً

155
00:08:17,260 --> 00:08:19,420
!غبيّ! كن طُعمًا له على الأقلّ

156
00:08:19,420 --> 00:08:22,540
لا أذكر أنّ هذه هي طريقة
!كلامك يا أماني-سان

157
00:08:27,230 --> 00:08:29,320
.أنا متعب

158
00:08:29,320 --> 00:08:31,480
.كان ذلك أسوأ يومٍ أوّل

159
00:08:31,480 --> 00:08:32,820
.ملاك غبيّة

160
00:08:32,820 --> 00:08:35,960
.لولا هذا الشّيء... هذا الطّوق

161
00:08:36,320 --> 00:08:37,140
ماذا؟

162
00:08:37,660 --> 00:08:40,010
.اختفى الطّوق

163
00:08:40,010 --> 00:08:41,620
ماذا يحدث؟

164
00:08:41,620 --> 00:08:42,830
هل وقع؟

165
00:08:42,830 --> 00:08:44,700
.لا، ذلك مستحيل

166
00:08:46,020 --> 00:08:47,150
!يا أكتسو

167
00:08:47,150 --> 00:08:48,680
!اسمي ليلي أماني

168
00:08:48,680 --> 00:08:50,430
!ترنّ كلماتي عبر صوتي الصّاخب، يو

169
00:08:50,430 --> 00:08:52,000
!أنا صديقة عزيزة للأشخاص الصُّلع في العادة

170
00:08:52,000 --> 00:08:53,560
!حان الوقت للتّحرّك بسرعة

171
00:08:53,560 --> 00:08:55,090
!اختفى طوقك، لكنّه صار جزءًا من جسدك

172
00:08:55,090 --> 00:08:56,230
...مزعجة

173
00:08:55,520 --> 00:08:57,100
!أنت في بالي يا عزيزي

174
00:08:56,230 --> 00:08:58,540
وكيف تعرف عنواني من الأساس؟

175
00:08:57,100 --> 00:08:59,150
!إنّه وشم دائم، عقوبة إعدامك

176
00:08:59,150 --> 00:09:00,060
.اختلستُ النّظر

177
00:09:00,060 --> 00:09:00,970
.التقطت صورة

178
00:09:00,970 --> 00:09:01,800
.صرت تعرف الآن

179
00:09:01,800 --> 00:09:03,560
.استعمل هذا للطّوارئ

180
00:09:03,560 --> 00:09:05,210
!قرأت أفكاري؟

181
00:09:05,210 --> 00:09:06,780
!أكره هذا

182
00:09:07,590 --> 00:09:08,780
...مهلاً

183
00:09:08,780 --> 00:09:10,090
وشم دائم؟

184
00:09:10,090 --> 00:09:12,700
!لن أستطيع دخول المسابح هكذا

185
00:09:12,700 --> 00:09:15,070
!كلاّ! كنت متحمّسًا جدًّا لذلك

186
00:09:15,070 --> 00:09:17,820
كما أنّي أردت تجربة حمّامات
!السّنتو الخارقة أيضًا

187
00:09:18,500 --> 00:09:20,030
.سُحقًا

188
00:09:20,030 --> 00:09:22,280
...كلاّ يا أكتسو-كُن

189
00:09:22,280 --> 00:09:23,260
.انقلع

190
00:09:23,260 --> 00:09:27,350
.عليّ تولّي أمرها قبل التّسبّب في المشاكل للجحيم

191
00:09:28,450 --> 00:09:29,340
.نعم

192
00:09:29,340 --> 00:09:32,900
.كلّ ما قابلته اليوم هو شيطان وحش

193
00:09:33,720 --> 00:09:35,710
.نعم، قمت برقيه مسبقًا

194
00:09:36,360 --> 00:09:37,370
.نعم

195
00:09:37,370 --> 00:09:39,290
.سأواصل العمل بيقظة

196
00:09:44,280 --> 00:09:47,240
شهدت هذه البلدة شياطين ضعيفة
...فحسب حتّى الآن

197
00:09:47,240 --> 00:09:49,530
.وجدت أخيرًا واحدًا جديرًا

198
00:09:49,530 --> 00:09:52,670
.لن أقوم برقيه بسرعة

199
00:09:52,670 --> 00:09:55,840
...سيرونني أتلاعب بأحد بمثل قوّته

200
00:09:55,840 --> 00:10:00,450
!ستراني السّماء بأكملها

201
00:10:00,450 --> 00:10:04,620
.وسيندمون على الطّريقة الّتي عاملوني بها

202
00:10:04,620 --> 00:10:07,460
...ولأجل ذلك، سأحرص على

203
00:10:08,160 --> 00:10:09,880
!أن تسقط

204
00:10:08,160 --> 00:10:09,880
!أن يسقط

205
00:10:13,940 --> 00:10:15,510
.المعذرة

206
00:10:16,020 --> 00:10:17,360
.مرحبًا

207
00:10:17,360 --> 00:10:20,930
،ليس لدينا الكثير من الوقت
.لذلك لندخل صلب الموضوع

