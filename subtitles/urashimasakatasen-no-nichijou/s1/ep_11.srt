1
00:01:00,080 --> 00:01:02,080
...سابقًا

2
00:01:02,080 --> 00:01:04,530
،مضت ثلاثة أشهر مذ تأسس نادي التلاميذ المنتقلين

3
00:01:04,530 --> 00:01:08,070
.تلقينا هدية في صندوق، وقد كانت قنبلة

4
00:01:08,710 --> 00:01:11,090
.وقد علقنا قي غرفة النادي

5
00:01:11,360 --> 00:01:13,470
.وهكذا بدأت الحلقة 11

6
00:01:13,840 --> 00:01:16,610
لم أُرسلت لنا قنبلة على أي حال؟

7
00:01:16,610 --> 00:01:19,760
!لم أفعل شيئًا في الثانوية لأستحقّ أن أنفجر

8
00:01:19,760 --> 00:01:21,960
.بقيت ثلاث دقائق حتى نهاية الوقت

9
00:01:21,960 --> 00:01:23,010
!حسنًا أيها القائد، أنت لها

10
00:01:23,010 --> 00:01:23,530
.أجل

11
00:01:23,530 --> 00:01:24,400
!ندع الأمر لك أيها القائد

12
00:01:24,400 --> 00:01:25,700
!أنت لها يا قائد فرقة القنابل

13
00:01:25,700 --> 00:01:27,570
!لا، أنا مجرد قائد للنادي

14
00:01:27,930 --> 00:01:29,380
.افصل السلك رجاءً

15
00:01:29,380 --> 00:01:31,190
!تبًّا، لا خيار لديّ

16
00:01:31,360 --> 00:01:34,900
الأحمر هو السلك الذي يجب قطعه دائمًا، صحيح؟

17
00:01:36,100 --> 00:01:37,390
أم أنّه السلك الأزرق هذه المرة؟

18
00:01:37,390 --> 00:01:38,200
!أيّهما؟

19
00:01:38,650 --> 00:01:41,520
!يامادانوكي، دمّر الدارة الكهربائية بهجومك الصاعق

20
00:01:41,520 --> 00:01:43,090
!تقول ذلك وكأنّك مدرب

21
00:01:43,090 --> 00:01:44,650
!لن ينجح ذلك

22
00:01:46,660 --> 00:01:48,210
!حان وقت تلميح

23
00:01:48,210 --> 00:01:49,050
تلميح؟

24
00:01:49,050 --> 00:01:51,150
لم أصبحت ودودة فجأة؟

25
00:01:51,150 --> 00:01:52,600
.أنا مجرد عامل بدوام جزئي

26
00:01:52,600 --> 00:01:53,570
هل هو عمل بدوام جزئي؟

27
00:01:53,570 --> 00:01:54,080
.نعم

28
00:01:54,080 --> 00:01:55,300
.قطاعنا يعاني من نقص في اليد العاملة

29
00:01:55,300 --> 00:01:56,530
.كنت أعمل لعشرة أيام متواصلة

30
00:01:56,530 --> 00:01:59,040
!أريد العودة للمنزل بسرعة

31
00:01:59,040 --> 00:02:00,760
ما هو التلميح إذًا؟

32
00:02:00,760 --> 00:02:04,510
.السلك الصحيح له نفس لون السروال الداخلي الذي أرتديه حاليًّا

33
00:02:04,510 --> 00:02:05,640
!وكيف سنعرف ذلك؟

34
00:02:05,970 --> 00:02:07,660
!لن أخبرك أبدًا

35
00:02:07,660 --> 00:02:09,300
!لا تكن محرجًا

36
00:02:09,300 --> 00:02:12,180
.لكن هذا كان تلميحًا كبيرًا جدًّا

37
00:02:12,180 --> 00:02:13,230
هل عرفت؟

38
00:02:13,230 --> 00:02:13,550
.أجل

39
00:02:13,550 --> 00:02:14,860
!السروال الداخلي أحمر

40
00:02:14,860 --> 00:02:15,950
.لا يمكن، إنّه أزرق

41
00:02:15,950 --> 00:02:17,070
.أنا أرتدي اللون الأزرق الآن

42
00:02:19,800 --> 00:02:21,490
!هذا ليس الوقت المناسب لذلك

43
00:02:21,900 --> 00:02:23,740
!بقيت لنا دقيقة واحدة

44
00:02:23,740 --> 00:02:24,750
!لا

45
00:02:24,750 --> 00:02:25,780
!هذا سيّئ

46
00:02:25,780 --> 00:02:27,540
.علينا الاختيار فحسب

47
00:02:27,540 --> 00:02:29,630
.لكني خائف من قطعه

48
00:02:30,250 --> 00:02:32,200
.ا-انتهى أمرنا

49
00:02:32,200 --> 00:02:34,460
.كانت تلك ذكريات نادي التلاميذ المنتقلين

50
00:02:34,770 --> 00:02:38,760
.ناد هادئ أسسه التلاميذ المنتقلون المنبوذون

51
00:02:38,990 --> 00:02:42,340
،هربنا من الرفض وذهبنا للفضاء

52
00:02:42,750 --> 00:02:44,750
...واستكشفنا الدياميس

53
00:02:44,750 --> 00:02:47,090
هل أنت واثق أنّ هذا حدث في كوننا؟

54
00:02:47,620 --> 00:02:48,710
ماذا كان ذلك؟

55
00:02:48,710 --> 00:02:50,480
ذكرياتنا الثمينة، صحيح؟

56
00:02:50,480 --> 00:02:53,400
.كان وقتًا قصيرًا، لكني أشعر بالحنين بالفعل

57
00:02:53,400 --> 00:02:55,730
.لم يكن علينا أن نتشاجر

58
00:02:56,140 --> 00:02:56,790
.أجل

59
00:02:56,790 --> 00:02:58,250
سوف نفكك القنبلة

60
00:02:58,250 --> 00:03:01,410
!ونعيد حياة نادي التلاميذ المنتقلين السعيدة

61
00:03:01,410 --> 00:03:02,750
!أجل

62
00:03:02,750 --> 00:03:03,830
.انتهى الوقت

63
00:03:03,830 --> 00:03:04,470
حقًّا؟

64
00:03:04,470 --> 00:03:05,160
...ما يعني

65
00:03:05,160 --> 00:03:07,050
!أنها سوف تنفجر

66
00:03:08,830 --> 00:03:10,160
هل انفجرت؟

67
00:03:10,160 --> 00:03:12,640
.بدت كحفلة عيد ميلاد

68
00:03:12,640 --> 00:03:14,350
نحن أحياء، صحيح؟

69
00:03:14,350 --> 00:03:15,530
لسنا شفافين الآن، صحيح؟

70
00:03:15,530 --> 00:03:17,300
.لا

71
00:03:17,300 --> 00:03:19,030
!ما يعني أننا أحياء

72
00:03:19,030 --> 00:03:19,770
!مرحى

73
00:03:19,770 --> 00:03:22,300
.خرج شيء من القنبلة

74
00:03:22,810 --> 00:03:23,800
.إنّها رسالة

75
00:03:23,800 --> 00:03:26,670
.قد تنفجر مجدّدًا، احترس

76
00:03:26,670 --> 00:03:28,650
هل هي من مرسل القنبلة؟

77
00:03:29,450 --> 00:03:30,690
.سأقرأها

78
00:03:31,240 --> 00:03:34,120
،إلى فتياتي العزيزات من نادي التلاميذ المنتقلين"

79
00:03:34,120 --> 00:03:35,850
"هل حمّسكن ذلك؟

80
00:03:35,850 --> 00:03:36,950
".أحبكن"

81
00:03:36,950 --> 00:03:38,820
".التوقيع، غانتيتسو غوزابورو"

82
00:03:43,950 --> 00:03:45,240
.يُتبع