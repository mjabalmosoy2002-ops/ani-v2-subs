1
00:00:01,160 --> 00:00:08,590
!!!شاهدوا فصل الرّوح الفضّيّة من غرفة مضيئة ومن مسافة آمنة من التّلفاز

2
00:00:03,050 --> 00:00:04,110
.يا إلهي

3
00:00:05,470 --> 00:00:09,110
من قال إنّ الأطفال يكبرون حتّى
.من دون آبائهم كان حكيمًا

4
00:00:10,290 --> 00:00:12,510
.عدت لبعض الوقت يا إيدو

5
00:02:01,970 --> 00:02:05,030
أين هو العدوّ إذًا؟

6
00:02:05,030 --> 00:02:06,470
.في كلّ مكان من حولك

7
00:02:07,340 --> 00:02:10,580
،حتّى مع نشرهم لديانتهم عبر الكون

8
00:02:10,580 --> 00:02:13,100
.لا يملكون أيّ مقرّ على أيّ كوكب

9
00:02:14,350 --> 00:02:16,350
.كاتدرائية كويو المتنقّلة

10
00:02:16,780 --> 00:02:19,730
.مقرّهم عبارة عن سفينة حربيّة تحوم في السّماء

11
00:02:20,560 --> 00:02:23,040
،لا يمكن رصدها بالعين المجرّدة أو بالرّادار

12
00:02:23,040 --> 00:02:25,610
.لكن لا شكّ أنّها في سماء الأرض الآن

13
00:02:26,610 --> 00:02:28,320
.وهناك يوجد معلّمنا

14
00:02:29,090 --> 00:02:30,850
كيف سنوقفهم؟

15
00:02:30,850 --> 00:02:32,740
من تظنّني؟

16
00:02:33,290 --> 00:02:38,000
أعرف تمامًا فيمَ يفكّر الإرهابيّون
.من المستوى الثّالث

17
00:02:38,860 --> 00:02:43,360
.لكن هناك شيء عليّ القيام به قبل أن يتحرّكوا

18
00:02:43,360 --> 00:02:45,920
.استغلّ ذلك الوقت للقيام بشؤونك

19
00:02:45,920 --> 00:02:46,860
ماذا؟

20
00:02:46,860 --> 00:02:48,830
.عدت لأوّل مرّة بعد سنتين

21
00:02:48,830 --> 00:02:51,060
أليست هناك بعض الوجوه القديمة تريد أن تراها؟

22
00:02:52,540 --> 00:02:53,960
هل أنت غبيّ؟

23
00:02:53,960 --> 00:02:56,000
كيف لي أن أواجههم؟ ماذا أقول لهم؟

24
00:02:56,000 --> 00:03:00,030
أنا هنا لأنقذ الوحش الّذي جازفتم"
"بأرواحكم لهزيمته؟

25
00:03:00,030 --> 00:03:02,360
هل تظنّ أنّ وجهي هو جامب سكوير؟

26
00:03:04,350 --> 00:03:05,990
.افعل ما شئت

27
00:03:08,990 --> 00:03:10,240
.لا شكّ في الأمر

28
00:03:10,850 --> 00:03:13,620
!سقط رئيس الأعمال الحرّة إلى الجانب المظلم

29
00:03:14,650 --> 00:03:16,960
،بحدوث هذا مع اقتراب النّهاية

30
00:03:16,960 --> 00:03:21,010
لا بدّ أنّها حالة ييأس فيها البطل
حامي البشريّة من حماقتنا

31
00:03:21,010 --> 00:03:23,750
!ويقرّر إبادة كلّ شيء! إنّه نمط ديفل مان

32
00:03:24,240 --> 00:03:27,520
.زاكي، لم أطلب منك أوهامك

33
00:03:27,520 --> 00:03:31,260
أنا أيضًا على وشك اليأس
.من حماقة تابعي وإبادة راتبه

34
00:03:31,260 --> 00:03:32,910
من هو التّابع الأحمق؟

35
00:03:32,910 --> 00:03:35,520
من الّذي جعل من اللّحاق بهما
إلى هذا الحدّ أمرًا ممكنًا؟

36
00:03:36,040 --> 00:03:40,820
صحيح. قلت أنّك تستطيع الطّيران، لذا ركبت
.على ظهرك وحاولت اللّحاق بالسّفينة

37
00:03:40,820 --> 00:03:42,860
!هيّا يا موبوكوب

38
00:03:42,860 --> 00:03:47,430
ثمّ كدت أموت خمس مرّات
.بسببك عندما نفد وقودك

39
00:03:47,430 --> 00:03:49,600
.كان ذلك لأنّني لم أستطع التّزوّد بالوقود

40
00:03:49,600 --> 00:03:51,530
لِمَ وقود موبوكوب هو الأنبان؟

41
00:03:51,530 --> 00:03:53,900
.كما أنّ معجون الفول كان جافًّا وليس مخفوقًا

42
00:03:53,900 --> 00:03:55,670
!لا يمكن أن أُشحن بتلك الطّريقة يا توني

43
00:03:55,670 --> 00:03:57,150
من الّذي تناديه بتوني؟

44
00:03:57,150 --> 00:04:00,420
مواصفاتك الميكانيكيّة
!والعقليّة ليست متزامنة تمامًا

45
00:04:01,520 --> 00:04:03,520
.لا تشح نظرك عنهما

46
00:04:03,520 --> 00:04:05,200
.سنلحق بهما ونرى ما ينويان فعله

47
00:04:05,200 --> 00:04:08,400
ماذا؟ لكن إنّ ضيّعنا الوقت، فجيش
—الشّيطان وجيش ساتان سـ

48
00:04:08,400 --> 00:04:10,050
.لن تحدث الحرب الفانيّة

49
00:04:10,960 --> 00:04:14,260
هل تقصد أنّك ستثق بالزّعيم إذًا؟

50
00:04:14,600 --> 00:04:15,890
.الأمر ليس كذلك

51
00:04:15,890 --> 00:04:18,850
.معرفة هدفهما له الأولويّة

52
00:04:18,850 --> 00:04:22,950
وماذا إن كان يخطّط لشيء شرّير؟

53
00:04:24,090 --> 00:04:25,190
.سأقطعه

54
00:04:25,730 --> 00:04:30,450
.ذلك واجبنا بصفتنا الشّينسينغومي الّتي أنقذها

55
00:04:32,970 --> 00:04:34,070
...هيجيكاتا-سان

56
00:04:34,880 --> 00:04:37,930
.لكن لم يعد هناك وجود للشّينسينغومي

57
00:04:37,930 --> 00:04:39,970
.قلت لك ألاّ تشح نظرك عنهما

58
00:04:41,130 --> 00:04:42,080
.إنّهما يفترقان

59
00:04:42,080 --> 00:04:44,080
!سنفترق نحن أيضًا ونلحق بكليهما

60
00:04:44,080 --> 00:04:45,340
!مفهوم

61
00:04:45,670 --> 00:04:47,340
!سأتبع تاكاسوغي إذًا

62
00:04:47,800 --> 00:04:49,340
!وأنا سأتبع الزّعيم

63
00:04:49,890 --> 00:04:52,170
!هيجيكاتا-سان، اذهب واشتر بعض الأنبان

64
00:04:52,170 --> 00:04:53,590
مفهوم! مخفوق، صحيح؟

65
00:04:54,650 --> 00:04:56,300
!مستحيل

66
00:04:56,300 --> 00:04:59,220
لِمَ انقسمت إلى نصفين؟ ولِمَ أنا خادمك؟

67
00:04:59,570 --> 00:05:00,940
.آسف

68
00:05:00,940 --> 00:05:03,150
.نسيت أنّ لديّ وظيفة تقليد

69
00:05:04,940 --> 00:05:07,700
!سأشتري بعض الأنبان من هنا

70
00:05:07,700 --> 00:05:10,370
!وأنت يا هيجيكاتا اشتر الأنبان من هناك

71
00:05:10,370 --> 00:05:12,610
حاضر! تلك الّتي عليها بذور منثورة فوقها، صحيح؟

72
00:05:13,660 --> 00:05:16,120
!لماذا نفترق لشراء الأنبان؟

73
00:05:16,120 --> 00:05:17,550
.اسمع، يمكنك أن تبقى هكذا

74
00:05:17,550 --> 00:05:20,120
يمكنك أن تكون هيجيكاتا-سان إن بقيت
!طبيعيًّا! اتبع الأعمال الحرّة فقط

75
00:05:20,120 --> 00:05:21,250
!مفهوم

76
00:05:21,570 --> 00:05:23,400
عليّ أن أكون هيجيكاتا-سان الطّبيعيّ، صحيح؟

77
00:05:23,400 --> 00:05:25,250
!اشتريت لك الأنبان

78
00:05:25,250 --> 00:05:28,330
!توقّف! لا مزيد من هيجيكاتا-سان الطّبيعيّ

79
00:05:28,330 --> 00:05:29,590
!ارتد بعض الملابس

80
00:05:30,510 --> 00:05:31,260
!تبًّا

81
00:05:48,400 --> 00:05:49,810
.لا يهمّ

82
00:05:49,810 --> 00:05:53,390
إن التقيت أحدًا، فلا أظنّ أنّ النّظّارات
.الشّمسيّة وحدها ستساعدني على التّنكّر

83
00:06:01,770 --> 00:06:02,650
!أيّتها العجوز

84
00:06:02,650 --> 00:06:05,710
،إن اشتريت هذا السّروال الدّاخليّ
!فهلاّ أسديتني معروفًا؟! رجاءً؟

85
00:06:08,780 --> 00:06:10,550
.هذا ثوب سباحة جميل

86
00:06:11,520 --> 00:06:13,850
.ربّما أشتريه لشين-تشان

87
00:06:13,850 --> 00:06:15,800
.لديك ذوق جميل يا آنسة

88
00:06:16,250 --> 00:06:19,920
،إنّه الطّراز الّذي سيصبح متداولاً
.آخر وأفضل الصّيحات

89
00:06:19,920 --> 00:06:20,930
حقًّا؟

90
00:06:21,670 --> 00:06:23,060
.التّصاميم مبتكرة حقًّا

91
00:06:23,420 --> 00:06:24,940
،هذا يبدو كسروال داخليّ للرّجال

92
00:06:25,540 --> 00:06:27,400
،وهذا به شيء يخرج منه

93
00:06:27,900 --> 00:06:30,200
.وهذا هينتاي كامين

94
00:06:30,200 --> 00:06:32,820
!لِمَ انضممت إلى صفّ دمى العرض؟

95
00:06:33,270 --> 00:06:36,820
.هيجيكاتا-سان، تلك أخت شينباتشي-كن

96
00:06:36,820 --> 00:06:39,800
.يبدو أنّ الزّعيم لا يريد لأحد أن يراه

97
00:06:39,800 --> 00:06:41,950
!لكنّه بارز تمامًا

98
00:06:41,950 --> 00:06:44,580
...وعلينا أن نسرع خلف تاكاسوغي

99
00:06:45,390 --> 00:06:47,580
!أنت أيضًا؟

100
00:06:47,890 --> 00:06:48,800
ماذا؟

101
00:06:48,800 --> 00:06:50,590
غير ممكن، ما الّذي يفعله؟

102
00:06:50,590 --> 00:06:55,590
أهكذا كان ذلك الوغد المتعجرف
يختبئ منّا كلّ هذا الوقت؟

103
00:06:57,820 --> 00:06:59,950
.أنا واثق أنّ وجهه محمرّ تمامًا

104
00:06:59,950 --> 00:07:03,470
هيجيكاتا-سان، أنت تعيب غيرك بعيبٍ
فيك الآن. هل يمكنك أن تتوّقف؟

105
00:07:03,840 --> 00:07:06,250
.أودّ أن ألقي نظرة عن كثب

106
00:07:06,250 --> 00:07:08,600
.أكيد، تفضّلي واخلعيه

107
00:07:08,600 --> 00:07:10,510
...لكن بصراحة

108
00:07:10,510 --> 00:07:13,190
هل هو بارز؟

109
00:07:14,320 --> 00:07:17,200
.إنّه عالق بشيء ما. لا يمكنني خلعه

110
00:07:17,890 --> 00:07:20,530
!سيكون من الأسرع سحقه

111
00:07:23,330 --> 00:07:25,650
!تـ-تحمّل يا يامازاكي

112
00:07:25,650 --> 00:07:28,620
لم ينجح الأمر؟ هلاّ أحضرت المطرقة الّتي هناك؟

113
00:07:28,930 --> 00:07:30,250
!مطرقة؟

114
00:07:30,670 --> 00:07:33,760
.لكنّني لا أدري إن كنت سأشتريه أم لا

115
00:07:33,760 --> 00:07:35,260
.لا تكبحي نفسك

116
00:07:35,710 --> 00:07:38,880
.لدينا الكثير من دمى العرض والخـ*يات

117
00:07:38,880 --> 00:07:41,890
...الأمر ليس كذلك. أنا فقط

118
00:07:44,080 --> 00:07:45,270
.هذا ما أردت رؤيته

119
00:07:45,270 --> 00:07:47,550
!موبوكوب

120
00:07:47,550 --> 00:07:49,690
غطاء الرّأس؟

121
00:07:49,690 --> 00:07:52,730
.لكن ليس هذا ما تخيّلته

122
00:07:53,980 --> 00:07:55,570
.سأعيده لرأسه

123
00:07:55,570 --> 00:07:56,820
!إنّه الرّأس الخاطئ

124
00:07:57,250 --> 00:07:59,320
أهكذا كان؟

125
00:07:59,320 --> 00:08:01,140
ألم يكن هذا المكان الصّحيح؟

126
00:08:01,140 --> 00:08:03,090
.لا، كان هنا

127
00:08:03,090 --> 00:08:05,190
لا، ألم يكن هذا هنا؟

128
00:08:05,190 --> 00:08:07,080
.لا، هنا

129
00:08:07,920 --> 00:08:09,830
إلى أين ذهب يامازاكي؟

130
00:08:10,210 --> 00:08:12,210
!كيف حوّلاه إلى هذا؟

131
00:08:12,630 --> 00:08:15,730
.أنا مهتمّة بنظّارات الشّمس هذه أيضًا

132
00:08:15,730 --> 00:08:17,590
هل يمكنني خلعها؟

133
00:08:21,840 --> 00:08:23,350
!الرّياح تعصف بالبضائع

134
00:08:23,350 --> 00:08:24,600
!لقد هرب

135
00:08:24,600 --> 00:08:27,090
!يحاول ذلك الوغد إنقاذ نفسه

136
00:08:27,520 --> 00:08:29,100
...أظنّني سأنضمّ له

137
00:08:39,170 --> 00:08:40,780
.هذا جيّد

138
00:08:40,780 --> 00:08:43,770
.كدت تفقدين بضاعتك

139
00:08:43,770 --> 00:08:44,490
...أجل

140
00:08:45,900 --> 00:08:47,940
.أظنّنا فقدنا بعض الأرواح بدل ذلك

141
00:08:53,790 --> 00:08:56,190
كيف آلت الأمور إلى هذا؟

142
00:08:56,900 --> 00:09:00,370
ألا يفترض بهذا المكان أن يكون دوجو للمبارزة؟

143
00:09:00,370 --> 00:09:01,680
ما خطبهم؟

144
00:09:03,070 --> 00:09:05,110
وما معنى تايزاب؟

145
00:09:22,450 --> 00:09:24,240
.حسنًا جميعًا

146
00:09:24,240 --> 00:09:26,400
.انتهى تدريب اليوم

147
00:09:26,400 --> 00:09:29,830
أيّ تدريب؟ كانت السّمينات تدرن
!على عجلة فحسب

148
00:09:29,830 --> 00:09:32,920
يمكنكنّ أخذ مكافئات باغين داز
!خاصّتكنّ والذّهاب للمنزل

149
00:09:32,920 --> 00:09:34,090
!من المستحيل أن يخسرن أيّ وزن

150
00:09:34,090 --> 00:09:36,210
!تريدين إبقاءهنّ هنا للأبد، أليس كذلك؟

151
00:09:36,770 --> 00:09:38,880
.آسفة لتأخّري يا كيو-تشان

152
00:09:38,880 --> 00:09:40,960
.لا داعي. كان ذلك مثيرًا للاهتمام

153
00:09:40,960 --> 00:09:43,510
تمارين المبارزة بالسّيف؟

154
00:09:43,510 --> 00:09:49,220
تاي-تشان، ربّما أمثالك هم من يستطيعون إبقاء
.السّيف على قيد الحياة في هذا العصر

155
00:09:49,600 --> 00:09:51,730
.عليّ أن أبذل جهدي كي أجاريك أيضًا

156
00:09:52,350 --> 00:09:53,730
...كيوبي

157
00:09:54,210 --> 00:09:55,820
لكن ألا تمانعين هذا؟

158
00:09:55,820 --> 00:09:56,930
ماذا تقصدين؟

159
00:09:56,930 --> 00:10:00,750
كنت واثقة أنّ شينباتشي-كن
.هو من سيخلف هذا الدّوجو

160
00:10:00,750 --> 00:10:03,240
.مرّت سنتان بالفعل

161
00:10:03,920 --> 00:10:07,240
هل يخططّ ليخلُف ذلك الرّجل بدلاً من ذلك؟

162
00:10:08,170 --> 00:10:10,490
.لا أمانع

163
00:10:10,940 --> 00:10:14,500
.إن كان ذلك ما يريد فعله حقًّا

164
00:10:15,710 --> 00:10:17,060
...فهمت

165
00:10:17,060 --> 00:10:18,420
كيف حال الجميع؟

166
00:10:22,330 --> 00:10:24,010
.كالعادة

167
00:10:24,480 --> 00:10:27,560
،مررنا بالكثير خلال هاتين السّنتين نحن أيضًا

168
00:10:27,560 --> 00:10:32,170
لكن حتّى وإن كنّا في عصر جديد، كلّ ما يمكننا
.فعله هو إبقاء روح السّيّاف على قيد الحياة

169
00:10:32,170 --> 00:10:34,710
.ذلك هو فخر عشيرتنا

170
00:10:38,330 --> 00:10:40,270
.أنا جاهزة لزواج مرتّب

171
00:10:41,520 --> 00:10:43,900
...كيوبي، أنت

172
00:10:44,490 --> 00:10:49,350
لا تقلق. لن أحضر معي أيّة فتيات
.إلى المنزل بعد الآن

173
00:10:50,670 --> 00:10:54,200
،إن كان هناك شخص عازم على العيش مع سيفي

174
00:10:54,200 --> 00:10:57,420
.فسأموت معه بسرور

175
00:10:59,580 --> 00:11:01,040
.فهمت

176
00:11:11,070 --> 00:11:14,180
.أراد رؤية ذلك الرّجل مجدّدًا حقًّا

177
00:11:14,650 --> 00:11:17,410
.لذا أنا سعيدة لأنّه لم يعد

178
00:11:18,620 --> 00:11:22,190
.من يدري؟ ربّما كنت لأتزوّجه

179
00:11:24,140 --> 00:11:26,700
.لكنّني كنت لأودّ رؤية ذلك

180
00:11:27,250 --> 00:11:31,170
.أنت مرتدية ثوب زفاف، وما تبدو عليه إيدو الآن

181
00:11:32,650 --> 00:11:34,720
.هيّا بنا

182
00:11:34,720 --> 00:11:37,810
اتّفقنا اليوم على شراء كيمونو
من أجل لقاء الزّواج، صحيح؟

183
00:11:37,810 --> 00:11:39,290
.صحيح

184
00:11:39,290 --> 00:11:42,290
.لكن دعيني أخبّئ دميتَيْ العرض أوّلاً

185
00:11:47,200 --> 00:11:50,470
!لم تتخطّي خوفك من الرّجال أبدًا

186
00:11:52,050 --> 00:11:55,390
ما كان السّبب في حالة جدّك؟

187
00:11:55,710 --> 00:11:57,390
.تسمّم غذائيّ

188
00:11:57,390 --> 00:12:01,400
وعد بأن يتوقّف عن أكل أشياء
،من الشّارع أو يجمع القمامة

189
00:12:01,840 --> 00:12:05,430
لكن على الأرجح لا يزال يجمع القمامة
.في مكان ما في هذه اللّحظة

190
00:12:05,430 --> 00:12:08,000
!ما زال حيًّا؟

191
00:12:19,710 --> 00:12:23,520
،ابني وحفيدتي ناضجان الآن

192
00:12:23,520 --> 00:12:28,050
.لذا قرّرت التّقاعد والقيام بما أريد

193
00:12:28,630 --> 00:12:33,810
وما تريده هو التّفتيش في القمامة
رغم شكوى النّاس المتواصلة؟

194
00:12:33,810 --> 00:12:35,180
،الجميع ينعتون الأمر بذلك الشّكل

195
00:12:35,490 --> 00:12:39,160
.لكنّني لم أعتبرها قمامة قطّ

196
00:12:39,430 --> 00:12:43,340
هل هذه طريقتك إذًا في تحذير
المجتمع العصريّ من تبذيرهم؟

197
00:12:43,340 --> 00:12:46,460
،لا أريد أن أكون منافقًا لتلك الدّرجة

198
00:12:46,460 --> 00:12:49,050
.لكن ألق نظرة إلى هذا أيّها المخرج

199
00:12:50,010 --> 00:12:52,450
.هذا شيء التقطته اليوم

200
00:12:52,470 --> 00:12:54,950
لكن إن أعطيناه ملابس فخمة

201
00:12:54,950 --> 00:12:57,450
،وشعارًا فخمًا

202
00:13:00,060 --> 00:13:02,460
.فيمكننا استعماله كمضرب للصّراصير

203
00:13:02,980 --> 00:13:04,900
.وانظر، هناك واحد آخر

204
00:13:04,900 --> 00:13:08,340
...يمكننا كتابة شيء كهذا عليه

205
00:13:10,990 --> 00:13:12,840
.وسيتحوّل إلى مضرب ذباب

206
00:13:12,840 --> 00:13:15,640
.هناك واحد آخر

207
00:13:17,340 --> 00:13:20,810
كيف يمكننا إعطاءه وظيفة ما بنظرك؟

208
00:13:21,480 --> 00:13:25,190
يمكننا كتابة كلمة مدير
.واستعماله ككيس رمل للعرقلة

209
00:13:26,140 --> 00:13:29,190
...ليست فكرة سيّئة، لكنّ الجواب الصّحيح هو

210
00:13:29,750 --> 00:13:31,510
،نكتب هذا

211
00:13:31,510 --> 00:13:33,700
.ويمكننا جني الكثير من المال

212
00:13:38,990 --> 00:13:40,720
مـ-ما الّذي يجري؟

213
00:13:40,720 --> 00:13:41,960
...الـ-القمامة

214
00:13:41,960 --> 00:13:47,330
.بدت تلك القمامة حيّة حقًّا بالنّسبة لنا أيضًا

215
00:13:47,330 --> 00:13:53,110
...كما قال العجوز، قد تكون لها وظيفة ما

216
00:13:53,570 --> 00:13:56,740
.كقمامة تزيل القمامة الأخرى

217
00:14:02,350 --> 00:14:05,230
!خرجت من جحيم دمى العرض أخيرًا

218
00:14:05,230 --> 00:14:08,480
.تاكاسوغي، لم أتوقّع أن تنضمّ إليّ أنت أيضًا

219
00:14:08,910 --> 00:14:12,140
أهكذا كنت تهرب من الباكوفو حتّى الآن؟

220
00:14:12,140 --> 00:14:15,230
أنا مندهش لأنّ لديك الجرأة
.لتقول إنّك ستدمّر العالم هكذا

221
00:14:15,230 --> 00:14:15,950
!مهلاً

222
00:14:15,950 --> 00:14:18,000
...قل شيئًا يا تاكاسوغي

223
00:14:23,570 --> 00:14:26,350
تاكاسوغي، منذ متى؟

224
00:14:26,350 --> 00:14:29,040
ألهذا تريد تدمير الأرض؟

225
00:14:29,040 --> 00:14:30,670
!كلاّ يا غبيّ

226
00:14:31,360 --> 00:14:34,210
.مهلاً. جرّب قول جملتك المشهورة

227
00:14:34,210 --> 00:14:37,310
.سأدمّر هذا العالم الفاسد

228
00:14:37,310 --> 00:14:39,620
!بصوت أعلى! قلها من قلبك

229
00:14:39,620 --> 00:14:42,600
!سأدمّر هذا العالم القذر

230
00:14:42,600 --> 00:14:44,600
!بصوت أعلى! بكلماتك

231
00:14:44,600 --> 00:14:46,390
!ني هاو فان آ بين دان

232
00:14:44,600 --> 00:14:46,390
"!كفّ عن ذلك أيّها الوغد"

233
00:14:46,390 --> 00:14:47,600
!وو زين مي جي داو آ باي تشي

234
00:14:46,390 --> 00:14:47,600
"!كيف لي أن أعرف أيّها الغبيّ؟"

235
00:14:47,600 --> 00:14:49,580
.حسنًا، فهمت

236
00:14:49,580 --> 00:14:51,690
تاكاسوغي، كنت ترتاد مدرسة لغات، صحيح؟

237
00:14:51,690 --> 00:14:52,860
!لا، إنّه شخص آخر

238
00:14:53,260 --> 00:14:57,360
كنت أقوم بعملي عندما هدّدني
.رجل بعين واحدة

239
00:14:57,750 --> 00:15:01,120
فهمت. كان ذلك شخصًا آخر؟

240
00:15:01,440 --> 00:15:05,150
كان عليّ أن أعرف أنّها خطّة
.غبيّة بالنّسبة لتاكاسوغي

241
00:15:05,150 --> 00:15:07,120
أين هو الحقيقيّ إذًا؟ ما الّذي يفعله؟

242
00:15:08,190 --> 00:15:11,680
.أمّي، ذلك الدّبّ لا يعطيني بالونة

243
00:15:10,450 --> 00:15:13,280
.على الأرجح يقوم بعملي بدلاً منّي

244
00:15:13,280 --> 00:15:15,380
!هذا غباء أيضًا

245
00:15:17,050 --> 00:15:20,010
.حسنًا. سأستعمل هذا التّنكّر في الوقت الحاليّ

246
00:15:20,010 --> 00:15:23,120
.قد يكون إرهابيًّا، لكنّه أفضل من هينتاي كامين

247
00:15:25,270 --> 00:15:28,900
هذا أوّل شيء يحدث بعد ولادة
!تاكاسوغي شينسكي المزيّف؟

248
00:15:29,210 --> 00:15:31,550
!إلى أيّ حدّ يكرهه النّاس؟

249
00:15:31,550 --> 00:15:35,280
.أتحدّاك أن تخطو خطوة أخرى يا تاكاسوغي شينسكي

250
00:15:35,280 --> 00:15:37,030
!سأملؤك ثقوبًا

251
00:15:40,540 --> 00:15:42,030
ساتشان؟

252
00:15:42,350 --> 00:15:46,160
.لـ-لقد أخطأت يا آنسة

253
00:15:46,160 --> 00:15:48,000
تاكاسوغي لديه عين واحدة، أنسيت؟

254
00:15:48,000 --> 00:15:50,920
...انظري، لديّ كلتا عينيّ

255
00:15:50,920 --> 00:15:54,800
.آسفة، لكنّني لا أكترث لعدد العيون الّتي لديك

256
00:15:56,480 --> 00:15:58,440
حقًّا؟

257
00:15:58,440 --> 00:16:02,930
.أنا مندهش لأنّك لاحظت هذه العين المزيّفة من بعيد

258
00:16:03,290 --> 00:16:03,900
!نبض

259
00:16:03,900 --> 00:16:08,600
هذا صحيح. أنا الرّجل المعروف
.بجملته "سأدمّر العالم"، تاكاسوغي

260
00:16:08,620 --> 00:16:09,240
ماذا في ذلك؟

261
00:16:09,250 --> 00:16:12,190
سيلعب ذلك الدّور؟ يحاول الخروج من
هذا الوضع بصفته شينسكي المزيّف؟

262
00:16:14,060 --> 00:16:17,570
أين ساكاتا غينتوكي؟

263
00:16:19,150 --> 00:16:23,830
.ألم يتخلّ عن إيدو؟ لن يعود إذًا

264
00:16:23,830 --> 00:16:24,810
!نبض

265
00:16:24,810 --> 00:16:28,580
.لم تكن له جذور في أيّ مكان أساسًا

266
00:16:29,020 --> 00:16:31,840
.ألا تفهم؟ قلت لك إنّ التّغابي لن ينجح

267
00:16:31,840 --> 00:16:33,080
.انظري إلى عينيّ

268
00:16:33,400 --> 00:16:34,380
!نبض

269
00:16:34,380 --> 00:16:36,670
هل أبدو لك وكأنّني أتغابى؟

270
00:16:37,090 --> 00:16:39,310
!هذا ما يبدو تمامًا

271
00:16:39,310 --> 00:16:41,410
.كما أنّك تنبض كثيرًا يا شينسكي المزيّف

272
00:16:41,410 --> 00:16:42,720
.أنا لا أكذب أبدًا

273
00:16:43,050 --> 00:16:43,890
!نبض

274
00:16:43,890 --> 00:16:46,450
.الهنود لا يكذبون أيضًا

275
00:16:46,450 --> 00:16:49,600
هل احتجت إلى نبض هناك حقًّا؟ أنت تعتمد
!على ذلك كثيرًا يا شينسكي المزيّف

276
00:16:49,920 --> 00:16:53,650
هل يمكنني الذّهاب الآن؟
.أحتاج إلى تنبيض العالم

277
00:16:53,650 --> 00:16:55,230
!ماذا تقصد بـ"تنبيض" العالم؟

278
00:16:56,300 --> 00:16:57,730
.توقّف

279
00:16:57,730 --> 00:16:59,240
.استسلمي

280
00:16:59,240 --> 00:17:01,390
.انسي أمره

281
00:17:01,390 --> 00:17:02,820
.لا فائدة من انتظاره

282
00:17:03,160 --> 00:17:04,620
حقًّا؟

283
00:17:04,620 --> 00:17:09,600
سأنسى إذًا طريقة إبطال السّمّ
الّذي في جسدك أيضًا، اتّفقنا؟

284
00:17:13,250 --> 00:17:14,880
!حـ-حدث الأمر حينها؟

285
00:17:15,350 --> 00:17:20,630
،ستُدمّر قبل العالم إن ذهبت الآن
هل أنت موافق على ذلك؟

286
00:17:20,630 --> 00:17:21,770
!نبض

287
00:17:21,770 --> 00:17:25,140
ستموت وأنت تخرج البراز
.من جميع منافذ جسدك

288
00:17:25,140 --> 00:17:27,020
!نبض حقيقيّ

289
00:17:27,020 --> 00:17:28,720
!تلك هي طريقة النّبض الصّحيحة

290
00:17:28,720 --> 00:17:29,810
!نبض

291
00:17:29,810 --> 00:17:33,840
بالتّفكير في الأمر، رأيت رجلاً
.بشعر فضيّ هناك قبل قليل

292
00:17:33,840 --> 00:17:36,270
.هذا أكثر نبض مقنع له حتّى الآن

293
00:17:36,620 --> 00:17:37,410
!نبض

294
00:17:37,410 --> 00:17:39,490
.خذني إلى هناك

295
00:17:39,490 --> 00:17:43,690
سأتبع البراز الّذي ستتركه في طريقك
.يا برازيل وبوتيل

296
00:17:43,690 --> 00:17:46,780
.لكنّه لا يجاري النبض الحقيقيّ أبدًا

297
00:17:47,370 --> 00:17:51,290
.لن أعطيك التّرياق إلى أن أرى ساكاتا غينتوكي

298
00:17:52,530 --> 00:17:55,810
.هل تريدين مرافقًا؟ أنت امرأة مدلّلة

299
00:17:55,810 --> 00:17:58,330
لكن هل يمكنك ترويض هذا الوحش الأسود؟

300
00:17:58,330 --> 00:18:01,300
هل تذكّرت إحضار كيس بلاستيكي وماء معك؟

301
00:18:01,610 --> 00:18:05,430
بالطّبع. من آداب السّلوك أن ينظّف
.المالك خلف حيوانه الأليف

302
00:18:05,430 --> 00:18:08,540
!هل هو كلب تشيواوا؟ إنّه مجرد تشيواوا أسود

303
00:18:08,540 --> 00:18:11,560
!لا يمكنه المشي حتّى
ما الّذي سيفعله التشيواوا؟

304
00:18:12,080 --> 00:18:16,970
.أ-أظنّني رأيت غينتوكي في ذلك المحلّ

305
00:18:16,970 --> 00:18:17,570
!عواء

306
00:18:17,570 --> 00:18:19,940
!ما معنى عواء؟! بلغ التشيواوا حدّه

307
00:18:21,410 --> 00:18:23,570
.ماذا؟ أنا لا أراه

308
00:18:24,450 --> 00:18:26,570
.أظنّ أنّ عليّ تفقّد المرحاض أيضًا

309
00:18:29,330 --> 00:18:31,020
.مشغول

310
00:18:31,020 --> 00:18:33,080
.آسف

311
00:18:33,580 --> 00:18:37,250
.يـ-يبدو أنّه المحلّ الخطأ

312
00:18:37,250 --> 00:18:38,330
ذاك ربّما؟

313
00:18:39,130 --> 00:18:40,090
.مشغول

314
00:18:40,750 --> 00:18:41,840
!مشغول

315
00:18:44,130 --> 00:18:46,090
...مشـ

316
00:18:46,090 --> 00:18:47,220
.مشغول

317
00:18:50,320 --> 00:18:51,990
...لا تقولي لي

318
00:18:52,410 --> 00:18:54,860
!أنّك وضعت نينجا في جميع مراحيض إيدو

319
00:18:54,860 --> 00:18:56,730
!كيف استطعت فعل شيء كهذا؟

320
00:18:57,760 --> 00:19:02,870
.لم يختف رجل واحد فقط دون قول أيّ شيء

321
00:19:08,810 --> 00:19:10,750
إلى أين أنت ذاهب يا زينزو؟

322
00:19:13,200 --> 00:19:15,440
،بما أنّ العالم في سلام الآن

323
00:19:15,440 --> 00:19:18,850
.أنا أكبر خطر على الأميرة

324
00:19:19,470 --> 00:19:24,260
.كما أنّ الأونيوابان لديهم أنت يا ساروتوبي

325
00:19:27,520 --> 00:19:30,090
لِمَ جميع الرّجال هكذا؟

326
00:19:30,090 --> 00:19:33,260
ألا يمكنكم أن تقولوا "انتظريني" قبل أن تذهبوا؟

327
00:19:34,030 --> 00:19:35,430
.ساروتوبي

328
00:19:35,970 --> 00:19:39,510
حتّى وإن فعلنا، فهل ستصمتين وتنتظرين؟

329
00:19:42,850 --> 00:19:44,210
.لا أظنّ ذلك

330
00:19:46,670 --> 00:19:48,950
.لذا أحتاج مساعدتكم

331
00:19:49,370 --> 00:19:53,720
،قد لا أكون بنفس قوّة قائدنا زينزو

332
00:19:53,720 --> 00:19:57,290
!لكنّنا نستطيع النّجاح بمساعدتكم

333
00:19:59,010 --> 00:20:02,120
!أنا آمركم بصفتي زعيمة النّينجا ساروتوبي أيامي

334
00:20:02,120 --> 00:20:05,550
!ابحثوا عن ساكاتا غينتوكي واجعلوه يتزوّجني

335
00:20:05,550 --> 00:20:09,050
!كلّ ما فعلته هو استغلال النّينجا لأهدافها الخاصّة

336
00:20:09,890 --> 00:20:12,530
.لن أدعك تحصل على ساكاتا غينتوكي

337
00:20:12,530 --> 00:20:14,930
.هذا منزله

338
00:20:16,090 --> 00:20:19,060
.سأعيده بالقوّة إن لم يعد

339
00:20:19,060 --> 00:20:23,920
.لأنّه لم يقل لي أن أنتظره

340
00:20:25,120 --> 00:20:26,820
.حسنًا، فهمت

341
00:20:28,910 --> 00:20:31,030
أتريدين رؤيته إلى هذا الحدّ؟

342
00:20:32,060 --> 00:20:34,080
...تلك النّظرة الهادئة

343
00:20:35,170 --> 00:20:37,070
.يمكنك رؤيته إذًا

344
00:20:38,450 --> 00:20:41,210
.رأيته في قسم الملابس الدّاخليّة في ذلك المحلّ

345
00:20:44,060 --> 00:20:47,520
مهلاً لحظة... هل يحاول تغيير لباسه الدّاخليّ؟

346
00:20:47,520 --> 00:20:50,340
هل أطلق كلّ شيء؟ أتلك ابتسامة رضى؟

347
00:20:50,340 --> 00:20:52,660
.اتبعيني

348
00:20:52,660 --> 00:20:55,520
!إنّه يتمشّى بشكلٍ غريب! حزامه منخفض جدًّا

349
00:20:55,520 --> 00:20:57,600
!هل يحاول منع البراز من السّقوط؟

350
00:20:58,410 --> 00:21:00,430
ألم يؤثّر السّمّ فيك؟

351
00:21:00,430 --> 00:21:03,280
هل ظننت حقًّا أنّه سيوقف تاكاسوغي؟

352
00:21:03,280 --> 00:21:05,880
.أزلته تمامًا عبر شرجي

353
00:21:05,880 --> 00:21:07,860
!أنت تعترف بأنكّ تبرّزت في سروالك فحسب

354
00:21:09,550 --> 00:21:11,230
.لا أراه في أيّ مكان

355
00:21:11,230 --> 00:21:12,700
!أيّتها الخنزيرة

356
00:21:13,700 --> 00:21:15,370
!ذلك الصّوت

357
00:21:16,090 --> 00:21:17,820
،يمكنك الاحتفاظ بالباقي

358
00:21:17,820 --> 00:21:20,770
لذا أسرعي وأحضري لي طقم
!ملابس كامل مع الملابس الداخليّة

359
00:21:20,770 --> 00:21:23,330
!إنّه بطيء! هذه فرصته، لكنّه بطيء جدًّا

360
00:21:23,330 --> 00:21:24,380
!لقد أطلق كلّ شيء حقًّا

361
00:21:26,320 --> 00:21:29,050
!الحفّاظات الورقيّة هي كلّ ما استطعت شراءه

362
00:21:29,050 --> 00:21:30,620
!تاكاسوغي

363
00:21:30,620 --> 00:21:32,130
!أين أنت؟

364
00:21:35,930 --> 00:21:37,630
!علقت السّلسلة بدمية عرض

365
00:21:37,630 --> 00:21:38,930
!هناك؟

366
00:21:41,730 --> 00:21:43,730
—وجدتـ

367
00:21:43,730 --> 00:21:46,020
!عاد إلى نقطة البداية

368
00:21:46,520 --> 00:21:50,190
ماذا؟ ما الّذي تفعلينه هنا يا تسوكي؟

369
00:21:51,610 --> 00:21:55,280
،رافقت كيوبي إلى هنا أثناء تسوّقها

370
00:21:55,280 --> 00:21:56,910
.وانتهى بي المطاف عالقة بهذه السّلسلة الغريبة

371
00:21:57,230 --> 00:22:00,610
تاي-تشان، لِمَ عليّ خلع ملابسي الدّاخليّة أيضًا؟

372
00:22:00,610 --> 00:22:03,280
.لا يفترض بك ارتداء ملابس داخليّة تحت الكيمونو

373
00:22:03,280 --> 00:22:05,670
...لكنّني أجرّبها فحسب

374
00:22:05,670 --> 00:22:06,920
ماذا؟

375
00:22:07,410 --> 00:22:10,550
.تسوكويو-دونو، لا يمكنني إيجاد ملابسي الدّاخليّة

376
00:22:10,550 --> 00:22:11,920
...هل رأيت

377
00:22:21,050 --> 00:22:22,210
!نبض

378
00:23:58,400 --> 00:24:00,820
.هكذا تنجز يوشيوارا الأمور الآن

379
00:24:00,820 --> 00:24:06,410
!!لقد تلطّخت ملابس كيوبي الدّاخليّة الآن

380
00:24:00,820 --> 00:24:06,410
كيف سيتخطّى شينسكي المزيّف هذا الوضع الحرج؟

381
00:24:06,410 --> 00:24:11,250
،وأنتم المتحمّسون لأسباب أخرى

382
00:24:06,410 --> 00:24:11,250
...حافظوا على ذلك الشّعور وتطلّعوا للحلقة القادمة