1
00:01:47,420 --> 00:01:48,890
...لكن بالنّسبة لك

2
00:01:51,790 --> 00:01:54,580
!فلتمت الآن

3
00:01:57,080 --> 00:01:59,590
!ماذا تظنّ نفسك فاعلاً أيّها الأصلع؟

4
00:01:57,520 --> 00:02:04,240
!!!شاهدوا فصل الرّوح الفضّيّة من غرفة مضيئة ومن مسافة آمنة من التّلفاز

5
00:01:59,590 --> 00:02:00,670
.تبًّا

6
00:02:00,670 --> 00:02:04,590
كيف تجرؤ على المجيء بعد كلّ ما فعلته؟

7
00:02:05,040 --> 00:02:07,340
.سأقضي عليك هذه المرّة بالتّأكيد

8
00:02:07,850 --> 00:02:09,920
...أنت مخطئ يا بابا! إنّه

9
00:02:09,920 --> 00:02:11,360
.لست مخطئًا في شيء

10
00:02:12,350 --> 00:02:16,350
أخ كبير أصيب بثقب في بطنه
وهو يحمي أخته الصّغيرة؟

11
00:02:16,350 --> 00:02:19,230
لا يوجب أب سيثني على ابنه
.ويقول إنّه قام بعمل جيّد

12
00:02:20,940 --> 00:02:25,900
،إن كان هنا ليقوم بأشياء غبيّة كهذه
.فسأقضي عليه للأبد

13
00:02:25,900 --> 00:02:27,370
حقًّا؟

14
00:02:27,370 --> 00:02:29,240
.لا داعي للقلق إذًا

15
00:02:29,710 --> 00:02:33,080
!فما زلت أملك القوّة لقتلك

16
00:02:37,500 --> 00:02:39,730
،أردت أن أترك الطّبق الرّئيسيّ للنّهاية

17
00:02:39,730 --> 00:02:42,710
!لكن إن كنت مصرًّا، فسآكله مع المقبّلات

18
00:02:42,710 --> 00:02:44,460
!توقّفا

19
00:02:45,170 --> 00:02:47,340
!ماذا قلت للتّوّ؟

20
00:02:47,340 --> 00:02:50,870
!رأسُ مَن مصنوع في بنغلاديش؟

21
00:02:50,870 --> 00:02:52,470
!لم يقل أحد شيئًا كهذا

22
00:02:52,470 --> 00:02:56,290
!لا يوجد شيء هناك! أنا لا أرتدي شعرًا مستعارًا

23
00:02:59,920 --> 00:03:01,550
.هذا يكفي

24
00:03:04,560 --> 00:03:06,610
...أنتما

25
00:03:06,610 --> 00:03:09,140
تريدان القتال حتّى في وقت كهذا؟

26
00:03:09,140 --> 00:03:13,230
أنتما لا تتعلّمان أبدًا مهما مرّ من وقت
أو أينما كنا، أليس كذلك؟

27
00:03:14,400 --> 00:03:17,250
.لكن لا بأس

28
00:03:19,840 --> 00:03:23,930
.عائلتي كلّها على الأرض معًا ولو لوهلة

29
00:03:23,930 --> 00:03:26,010
.هذا كافٍ بالنّسبة لي

30
00:03:30,620 --> 00:03:31,390
!اركضوا

31
00:03:31,390 --> 00:03:32,930
!سنمرّ عبرهم

32
00:03:35,760 --> 00:03:36,390
!تبًّا

33
00:03:37,250 --> 00:03:39,270
.استعمله. سيوقّف نزيفك

34
00:03:40,140 --> 00:03:43,540
.لا أكترث إن متّ موت الكلاب بعيدًا عن ناظريّ

35
00:03:43,540 --> 00:03:46,690
.لكنّني لن أدع تموتك على هذا الكوكب

36
00:03:51,760 --> 00:03:53,360
.لم أفعل ذلك من أجلك

37
00:03:53,770 --> 00:03:56,160
.اشكرها هي

38
00:03:59,710 --> 00:04:00,930
الأرض؟

39
00:04:01,680 --> 00:04:05,300
.نعم، أخبرني والدك عنها قبل وقت طويل

40
00:04:06,250 --> 00:04:10,350
.قال إنّ هناك كوكبًا أزرقًا جميلاً جدًّا

41
00:04:11,440 --> 00:04:14,170
هل ذهبت إلى هنا إذًا؟

42
00:04:14,170 --> 00:04:17,060
لا. من يدري متى سأتمكّن من ذلك؟

43
00:04:17,450 --> 00:04:20,550
.لنذهب إلى الأرض يا أمّي

44
00:04:20,550 --> 00:04:24,480
...لنذهب مع بابا وكاموي
.فلتذهب العائلة بأكملها معًا

45
00:04:26,690 --> 00:04:29,520
.ماما، آسف لأنّنا تأخّرنا عليك كثيرًا

46
00:04:30,460 --> 00:04:32,740
.لكنّ الجميع هنا الآن

47
00:04:34,080 --> 00:04:36,740
.هنا على الأرض

48
00:04:38,250 --> 00:04:40,220
أأنتِ الفاعلة يا نوبومي؟

49
00:04:43,600 --> 00:04:47,260
سلاح نوويّ؟ هل تظنّ أنّ ذلك سيهزم أوتسورو حقًّا؟

50
00:04:47,260 --> 00:04:49,810
إنّه الورقة الرّابحة، الشّخص الوحيد
.الّذي يستطيع هزيمة أوتسورو

51
00:04:49,810 --> 00:04:51,760
.أحضرته لأنّه قال ذلك

52
00:04:52,140 --> 00:04:54,400
،وبالنّسبة لدخيل مثلي

53
00:04:54,400 --> 00:04:56,760
.يبدوان عديمي النّفع، والد عطوف وابنه

54
00:04:56,760 --> 00:04:58,270
!هل أنت عمياء؟

55
00:04:58,670 --> 00:04:59,770
ألم أخبركم؟

56
00:05:00,560 --> 00:05:04,270
.قلت أنّني سأجد طريقة لأقتله

57
00:05:04,270 --> 00:05:05,770
...هـ-هل يُعقل

58
00:05:06,770 --> 00:05:10,650
جمعت من جميع أنحاء الكون

59
00:05:11,900 --> 00:05:17,030
!البلّورات الّتي أنجبتها الكواكب

60
00:05:17,820 --> 00:05:19,310
...قطع أمل صغيرة

61
00:05:19,870 --> 00:05:22,040
!بُليْرات الألتانا

62
00:05:22,040 --> 00:05:23,590
بُليرات؟

63
00:05:23,590 --> 00:05:27,670
هل يمكننا إلغاء خلود أوتسورو بتلك الأشياء؟

64
00:05:27,980 --> 00:05:30,170
.أوتسورو ليس خالدًا

65
00:05:30,670 --> 00:05:34,140
إن امتصّ جسده جرعة قويّة من ألتانا
،غير متوافقة معه

66
00:05:34,140 --> 00:05:36,800
.فلن يتمكنّ من الحفاظ على خلوده

67
00:05:38,780 --> 00:05:41,180
.لا أتمكّن من إنقاذ كوكا

68
00:05:42,030 --> 00:05:47,810
،لذا سأحرص هذه المرّة بالأمل الّذي منحتنيه

69
00:05:48,130 --> 00:05:50,290
.على إنقاذ هذا الكوكب الّذي أحبّته

70
00:05:52,240 --> 00:05:53,820
.انظروا

71
00:05:54,560 --> 00:05:57,070
...هذا ما تخبّئه البليرات

72
00:05:57,070 --> 00:05:59,330
!قوّة الألتانا

73
00:06:02,000 --> 00:06:06,000
!عندما نثرتها على رأسي، نما الشّعر على سائر رأسي

74
00:06:07,580 --> 00:06:09,340
لِمَ فعلتم ذلك؟

75
00:06:09,340 --> 00:06:11,600
!انظروا إلى رأسي

76
00:06:11,600 --> 00:06:13,910
!فيه شعر كثيف

77
00:06:13,910 --> 00:06:17,450
!كفّ عن ذلك! فيمَ تستخدم البليرات؟

78
00:06:17,450 --> 00:06:21,550
.أنا أري الأعداء أنّهم ليسوا الخالدين الوحيدين

79
00:06:21,550 --> 00:06:22,800
!جذور شعري خالدة أيضًا

80
00:06:22,800 --> 00:06:24,550
!لا فائدة من ذلك أبدًا

81
00:06:24,550 --> 00:06:27,190
.لنلق نظرة نحن أيضًا

82
00:06:27,840 --> 00:06:30,480
.خالد؟ إنّه شعر مستعار كالعادة

83
00:06:30,480 --> 00:06:33,920
شعر الجميع يتحوّل إلى شعر مستعار
.إن سحبته بتلك القوّة

84
00:06:33,920 --> 00:06:35,820
!ما الّذي فعلته أيّها الحقير؟

85
00:06:35,820 --> 00:06:37,490
!لا نملك الوقت لهذا الهراء

86
00:06:37,810 --> 00:06:38,740
!العدوّ قادم

87
00:06:38,740 --> 00:06:41,980
،يا إلهي. إن كنتم الأشرار في عرض سينتاي

88
00:06:41,980 --> 00:06:46,020
فيفترض بكم أن تفهموا ولا تهاجموا
.بينما الرّجال الآليون يتّحدون

89
00:06:46,020 --> 00:06:48,750
!لكنّ كلّ ما لدينا هو أصلع يتّحد مع شعر مستعار

90
00:06:48,750 --> 00:06:51,290
.سيتوجّب عليّ أن أفهم أنا أيضًا

91
00:06:52,000 --> 00:06:56,270
.سأريكم قوّة سلاح الألتانا المصنوع من البليرات

92
00:06:58,050 --> 00:07:01,300
!استعداد... إطلاق

93
00:07:02,490 --> 00:07:05,310
!وفّروا لي ثلاث ثوانٍ! سينمو من جديد

94
00:07:05,650 --> 00:07:07,200
!من الّذي سينتظر؟

95
00:07:08,190 --> 00:07:10,010
!ما معنى هذا؟

96
00:07:10,010 --> 00:07:13,360
!البليرات، أملنا الأخير، تُستعمل على هراء

97
00:07:13,730 --> 00:07:17,050
،إن كانت تلك ورقتنا الرّابحة
.فقد انتهى أمر الأرض

98
00:07:17,050 --> 00:07:18,530
.لن يبقى سوى جذور الشّعر

99
00:07:18,530 --> 00:07:19,870
!على جذور الشّعر تلك أن تموت أيضًا

100
00:07:19,870 --> 00:07:21,870
!لا يمكننا العبور هكذا

101
00:07:35,370 --> 00:07:36,840
!لقد أطلقت شيئًا ما

102
00:07:37,230 --> 00:07:38,860
.قلت لكم

103
00:07:38,860 --> 00:07:42,100
!رجل عجوز ومدفع يتّحدان! افهموا

104
00:07:42,890 --> 00:07:46,170
تحويل الألتانا المستخرجة من البليرات

105
00:07:46,170 --> 00:07:49,730
!وإطلاقها هو كلّ ما يفعله سلاح الألتانا شوريومون هذا

106
00:07:50,890 --> 00:07:54,100
إنّه منتوج ثانويّ وُلد بينما كنت
.أصنع مسدس نموّ الشّعر

107
00:07:54,100 --> 00:07:56,350
!يبدو أنّه إضافيّ فحسب

108
00:07:56,350 --> 00:08:00,990
.يمكن للألتانا الموجودة به تدمير أيّ خالد

109
00:08:01,580 --> 00:08:05,690
وعلاوة على ذلك، جزيئات الألتانا
الّتي ينشرها المدفع في الجوّ

110
00:08:05,690 --> 00:08:08,500
.تقرض أجساد جميع الخالدين في الجوار

111
00:08:12,780 --> 00:08:16,250
.لن يتمكّن الخالدون من الوقوف مجدّدًا

112
00:08:16,770 --> 00:08:18,570
آخر من سيبقى واقفًا

113
00:08:19,710 --> 00:08:21,040
!هم نحن

114
00:08:22,330 --> 00:08:23,650
!أيّها الأصلع

115
00:08:23,650 --> 00:08:25,620
!لِمَ لم تستعمله عاجلاً بما أنّه معك؟

116
00:08:25,620 --> 00:08:28,540
ما هراء نموّ الشّعر ذاك؟
!هل أردت أن تتباهى فحسب؟

117
00:08:28,540 --> 00:08:32,000
!مهلاً، مهلاً! لم تكن تلك نيّتي

118
00:08:32,000 --> 00:08:35,350
.يستغرق شوريومون وقتًا ليُشحن ويُطلق

119
00:08:35,350 --> 00:08:37,110
.عليّ أن أحسب حساب كلّ طلقة

120
00:08:37,110 --> 00:08:40,900
ماذا؟ ألا تملك أيّ أسلحة ألتانا أخرى؟

121
00:08:41,430 --> 00:08:44,780
...لديّ، لكنّ عددها محدود

122
00:08:45,260 --> 00:08:48,510
!هذه القنابل الصّغيرة مذهلة

123
00:08:48,510 --> 00:08:50,620
!إنّها ترمي بالخالدين وكأنّهم قمامة

124
00:08:50,620 --> 00:08:54,630
!كفّ عن تضييع أسلحتي! متى سرقتها؟

125
00:08:54,630 --> 00:08:58,380
أنا واثق أنّ هذا أفضل بكثير
.من استعمالها لنموّ الشّعر

126
00:08:58,820 --> 00:09:01,070
كما أنّني بهذه الأشياء

127
00:09:01,070 --> 00:09:04,490
.أستطيع إيقاف هذه الجثث بمفردي

128
00:09:05,100 --> 00:09:07,140
اذهبوا. لا يوجد وقت، صحيح؟

129
00:09:08,860 --> 00:09:11,020
.تعبت من مجالستكم

130
00:09:11,020 --> 00:09:14,770
لِمَ عليّ الاعتناء بكلب أيضًا؟

131
00:09:15,440 --> 00:09:16,520
.كامو-سان

132
00:09:16,520 --> 00:09:17,960
.صحيح

133
00:09:17,960 --> 00:09:20,840
،إن كان بحاجة لفتاة صغيرة كي تحميه إلى الأبد

134
00:09:20,840 --> 00:09:22,280
.فسيفقد الرّجل ماء وجهه

135
00:09:22,780 --> 00:09:24,320
هل تتحدّث عنّي؟

136
00:09:26,330 --> 00:09:28,800
.ليس أنت. أنا أتحدّث عن نفسي

137
00:09:30,080 --> 00:09:32,160
.لكن لا داعي للقلق بعد الآن

138
00:09:32,410 --> 00:09:35,540
،حتّى من دونك

139
00:09:36,210 --> 00:09:38,030
.سنكون بخير

140
00:09:38,510 --> 00:09:39,550
.لذا اذهبي

141
00:09:40,830 --> 00:09:43,660
هذه المرّة، من أجل العائلة الجديدة
...الّتي وجدتها لنفسك

142
00:09:44,300 --> 00:09:46,240
.ومن أجل نفسك

143
00:09:48,250 --> 00:09:49,010
.خذ هذا واذهب

144
00:09:50,400 --> 00:09:53,710
.صنعته باستعمال فولاذ مشبّع بالبليرات

145
00:09:55,330 --> 00:09:58,730
أنتم السّاموراي تحبّون السّيوف، صحيح؟

146
00:09:59,660 --> 00:10:03,860
.اعتاد السّاموراي على حمل سلاحين في الماضي

147
00:10:03,860 --> 00:10:08,240
كانوا يُعتبرون محاربين حقيقيّين فقط
.إن حملوا سيفًا طويلاً وآخر قصيرًا

148
00:10:09,020 --> 00:10:11,880
،لكنّهم رموا كبرياءهم في مرحلة ما

149
00:10:11,880 --> 00:10:14,090
،وخسروا معتقداتهم الّتي كان عليهم حمايتها

150
00:10:14,090 --> 00:10:16,250
.وبقي لهم سيف واحد للدّفاع عن النّفس

151
00:10:17,230 --> 00:10:22,260
،كنت أترنّح في تلك الظّلمة ملوّحًا بعصًا خشبيّة

152
00:10:22,260 --> 00:10:26,010
.وتمكّنت من الوصول إلى هذه المرحلة بطريقة ما

153
00:10:26,780 --> 00:10:30,100
كان ذلك فقط لأنّني امتلكت سيفين
كليلين ولا يكسران

154
00:10:31,470 --> 00:10:34,020
.معي هنا

155
00:10:34,380 --> 00:10:39,650
.شكرًا على مساعدتي في لقاء أحد ذلكما الغبيّين

156
00:10:40,290 --> 00:10:42,350
،لذا طالما أملك هذين الاثنين على خصري

157
00:10:42,350 --> 00:10:44,030
.فلن ينكسر هذا السّاموراي

158
00:10:47,890 --> 00:10:51,290
.سأعود بالتّأكيد والسّيفان معي

159
00:10:52,970 --> 00:10:58,540
أخبرني، هل تظنّ أنّ تلك كانت طريقته
في طلب يد ابنتي للزّواج؟

160
00:10:58,930 --> 00:11:00,530
هل خطر ذلك لك للتّوّ؟

161
00:11:00,530 --> 00:11:03,800
.ظننتك كنت مستعدًّا لذلك من البداية

162
00:11:03,800 --> 00:11:05,350
.لا تكن غبيًّا

163
00:11:05,350 --> 00:11:08,800
.كرهتْ كوكا الضّعفاء أمثاله

164
00:11:09,240 --> 00:11:10,430
.فهمت

165
00:11:10,430 --> 00:11:12,930
.لهذا اختارت رجلاً ساذجًا ليكون زوجها

166
00:11:13,930 --> 00:11:16,940
.لا شيء أفضل من الابن بالفعل

167
00:11:17,550 --> 00:11:19,930
،الابنة تغادر من أجل رجل آخر يومًا ما

168
00:11:19,930 --> 00:11:22,070
.لكنّ الابن لا يترك أباه وحيدًا

169
00:11:22,430 --> 00:11:23,970
.يا إلهي

170
00:11:23,970 --> 00:11:28,570
،حياتي مستهدفة دائمًا
!ويدي مبتورة وشعري منزوع

171
00:11:29,630 --> 00:11:33,280
!أبوكما سعيد لأنّ لديه عائلة سعيدة كهذه

172
00:11:42,990 --> 00:11:45,200
.أظنّنا كبحناها كلّها تقريبًا

173
00:11:45,660 --> 00:11:48,320
.المكان الوحيد المتبقّي هو ذاك

174
00:11:48,320 --> 00:11:50,050
.حان وقت الضّربة القاضية

175
00:11:53,470 --> 00:11:54,850
.دعني أعبّر عن امتناني

176
00:11:55,930 --> 00:11:58,800
.تخلّينا عنك وطردناك

177
00:11:59,490 --> 00:12:03,050
.لكنّك لم تتخلّ عنّا أبدًا

178
00:12:05,420 --> 00:12:06,820
.كلاّ. الأمر ليس كذلك

179
00:12:07,770 --> 00:12:10,610
...أنا واثقة أنّ ما أردت حمايته هو

180
00:12:12,850 --> 00:12:13,830
.أعدك

181
00:12:14,610 --> 00:12:17,610
.سنعيدك إلى منزلك وعائلتك

182
00:12:17,610 --> 00:12:19,570
...لذا امنحنا المزيد من

183
00:12:21,070 --> 00:12:21,980
ماذا؟

184
00:12:23,130 --> 00:12:25,490
.مهلاً لحظة

185
00:12:25,490 --> 00:12:28,340
أكنت بهذا الحجم دائمًا؟

186
00:12:28,740 --> 00:12:30,830
ما الخطب يا أختي؟

187
00:12:30,830 --> 00:12:33,530
هل استعملت الكثير من قوّة زين؟

188
00:12:33,530 --> 00:12:35,350
.الحجم الكبير يبدو كالحجم المتوسّط بالنّسبة لي

189
00:12:35,810 --> 00:12:40,730
.أنت لا تتخيّلين. لقد كبرت يا أختي

190
00:12:41,240 --> 00:12:44,080
انحدرت لدرجة أنّك أصبحة كاهنة
،ملهى لبعض الوقت

191
00:12:44,080 --> 00:12:47,730
.لكنّك الآن تقاتلين لتحقيق واجب عشيرتنا

192
00:12:47,730 --> 00:12:50,370
.لقد كبرت حقًّا

193
00:12:50,380 --> 00:12:51,890
.يمكنني أن أرى ذلك أنا أيضًا

194
00:12:51,890 --> 00:12:55,200
.أنت تبدين أكبر من الحياة مثل أوباياشي موتوكو

195
00:12:55,200 --> 00:12:57,240
أليس كذلك يا كوماكو؟

196
00:12:58,750 --> 00:13:01,280
!حتّى كوماكو صغير الآن

197
00:13:01,280 --> 00:13:03,120
!ما الّذي يجري؟ لِمَ يحدث هذا؟

198
00:13:04,350 --> 00:13:05,930
...هل يمكن أنّ هذا

199
00:13:07,920 --> 00:13:09,420
!موني

200
00:13:13,800 --> 00:13:15,800
!أختي

201
00:13:17,310 --> 00:13:19,090
!اركضي

202
00:13:21,390 --> 00:13:22,310
زلزال؟

203
00:13:22,310 --> 00:13:26,190
!كانت خطوط لاي تهدأ
!والآن بدأت تهتاج مجدّدًا؟

204
00:13:26,190 --> 00:13:27,870
ما معنى ذلك؟

205
00:13:27,870 --> 00:13:30,440
!ينبغي أنّ ساداهارو والبقيّة يوقفونها الآن

206
00:13:30,760 --> 00:13:33,280
.الرّوافد فقط هي الّتي هدأت

207
00:13:33,280 --> 00:13:35,450
.ما زال النّهر الرئيسيّ موجودًا

208
00:13:36,220 --> 00:13:38,290
...هل يمكن أنّ ذلك الرّجل

209
00:13:50,110 --> 00:13:52,420
.انفجار البوّابة

210
00:13:52,420 --> 00:13:54,490
.لم يعد بإمكان أحد إيقافها

211
00:13:54,930 --> 00:13:57,930
.لا أوتسورو ولا أحد

212
00:13:59,180 --> 00:14:02,430
.حفلة التّرحيب بكم جاهزة

213
00:14:02,860 --> 00:14:06,960
.أنا في انتظاركم يا تلاميذ شويو

214
00:14:13,100 --> 00:14:17,420
.فقدنا التّحكّم بالطّائر السّماويّ الآن

215
00:14:17,420 --> 00:14:21,160
.ولا نملك الوقت لإخلاء من على متنها أيضًا

216
00:14:21,670 --> 00:14:26,500
،لكن إن تمكّنا من تدمير السّفينة قبل اصطدامها بالأرض

217
00:14:26,500 --> 00:14:30,170
.فيمكننا إنقاذ ذلك الكوكب والمجرّة بأكملها

218
00:14:30,480 --> 00:14:34,170
...والوحيدون القادرون على ذلك الآن

219
00:14:34,170 --> 00:14:36,970
.هم أنت ورجالك يا هاتا

220
00:14:38,560 --> 00:14:42,810
هل تطلب منّي إنقاذ النّاس أيّها الأميرال؟

221
00:14:42,810 --> 00:14:46,610
أم أنّك تطلب منّي قتلهم؟

222
00:14:47,440 --> 00:14:49,310
.لا أدري أنا الآخر

223
00:14:50,050 --> 00:14:55,320
بصفتك شخصًا أحبّ جميع الكائنات
الحيّة، فأيّ طريق تختاره

224
00:14:55,920 --> 00:15:00,400
.سيكون طريقًا أثق بأنّه الصّواب

225
00:15:01,740 --> 00:15:04,040
...هاتا، أخوك

226
00:15:10,250 --> 00:15:13,720
!أخواك إلى جانبك

227
00:15:13,720 --> 00:15:15,290
.لذا لا تتردّد

228
00:15:15,290 --> 00:15:17,980
!ثق بقلبك وتقدّم

229
00:15:20,670 --> 00:15:22,070
...أيّها الأمير

230
00:15:22,070 --> 00:15:25,850
.ما الّذي تنتظره؟ ينبغي أن يكون الجواب واضحًا

231
00:15:26,270 --> 00:15:30,860
.في الواقع، ما كنت لتتردّد في الماضي

232
00:15:32,000 --> 00:15:33,900
.أظنّ ذلك

233
00:15:34,370 --> 00:15:37,540
...لكن لا أعرف السّبب

234
00:15:37,540 --> 00:15:42,990
.كن ملكًا لطيفًا يحبّ جميع الكائنات الحيّة يا هاتا

235
00:15:42,990 --> 00:15:47,370
!قلت لك أن تخرس يا مهووس الحيوانات الأليفة

236
00:15:47,690 --> 00:15:54,140
لكن هناك جزء منّي لا يريد تدمير
.لا السّفينة ولا الأرض

237
00:15:54,750 --> 00:16:01,760
.أتذكّر أنّ كائنًا غريبًا على الأرض ختم على مصيري

238
00:16:02,210 --> 00:16:05,600
.ستتحمّل مسؤوليّة الأمر أيّها السّاموراي

239
00:16:05,600 --> 00:16:10,490
.الكمني مجدّدًا في وجهي إن اتّخذت القرار الخطأ

240
00:16:11,520 --> 00:16:13,760
!فلتستعدّ جميع السّفن للإطلاق

241
00:16:14,720 --> 00:16:17,150
!الهدف هو الطّائر السّماويّ

242
00:16:17,540 --> 00:16:19,680
!سامحاني يا شقيقيّ

243
00:16:20,610 --> 00:16:21,410
...إطـ

244
00:16:26,660 --> 00:16:29,970
!لقد لكمه حقًّا! لكمه في أسوأ وقت ممكن

245
00:16:29,970 --> 00:16:32,250
ماذا؟ فيمَ أخطأ الأمير؟

246
00:16:32,250 --> 00:16:33,920
هل فعل شيئًا سيّئًا؟

247
00:16:33,920 --> 00:16:35,080
.وجهه

248
00:16:35,080 --> 00:16:38,160
ماذا تقصد بأنّ وجهه خاطئ؟
!هذا ليس شيئًا جديدًا

249
00:16:38,160 --> 00:16:39,800
!لطالما كان ذلك الوجه فاشلاً

250
00:16:40,310 --> 00:16:43,600
لكمْتك وفقدت وظيفتي

251
00:16:43,600 --> 00:16:45,560
.وخسرت كلّ شيء في الحياة

252
00:16:46,050 --> 00:16:50,310
.ندمت على خياري مرارًا، وفكّرت في الانتحار مرارًا

253
00:16:50,690 --> 00:16:54,310
لكن أتعلم ما شعرت به بالنّظر إلى وجهك الآن؟

254
00:16:54,310 --> 00:16:56,560
.شعرت بالسّعادة لضربك

255
00:16:56,970 --> 00:16:59,030
.لذا قمت بذلك مرّة أخرى

256
00:16:59,030 --> 00:17:03,330
!وهذه المرّة لكي أتسلّق نحو الأعلى من القاع معك

257
00:17:04,820 --> 00:17:08,300
هل ستتفرّج صامتًا على الأرض وهي تُدمر؟

258
00:17:08,300 --> 00:17:12,770
أم أنّك ستدمّر السّفينة الّتي فيها
شقيقيك ورفاقك لإنقاذها؟

259
00:17:13,280 --> 00:17:17,820
حتّى الطّفل الصّغير سيعرف القرار
.الصّائب من الخاطئ

260
00:17:20,350 --> 00:17:22,000
.كلاهما خطأ

261
00:17:22,480 --> 00:17:27,600
الخيار الصّحيح الوحيد هو إنقاذ
!كلّ شيء، الأرض والسّفينة

262
00:17:29,610 --> 00:17:31,770
.تماسكي يا أختي

263
00:17:31,770 --> 00:17:33,530
.اخرسي وقودي

264
00:17:34,540 --> 00:17:37,360
.لا يمكنني الانسحاب الآن

265
00:17:37,930 --> 00:17:43,360
بدأ هذان الاثنان بفقدان جسديهما
.بسبب استعمال الكثير من قوّة زين

266
00:17:43,870 --> 00:17:47,990
.سيُمحى وجودهما بالكامل على هذا الحال

267
00:17:47,990 --> 00:17:50,120
...يُمحى؟ لا يمكن

268
00:17:55,330 --> 00:17:55,830
!موني

269
00:18:09,500 --> 00:18:10,580
...كوماكو

270
00:18:10,580 --> 00:18:12,890
!كوماكو

271
00:18:13,970 --> 00:18:15,900
!هاتا! لِمَ لا تطلق النّار؟

272
00:18:16,210 --> 00:18:19,890
.أنا من مكتب الهجرة أيّها الأميرال

273
00:18:20,300 --> 00:18:23,860
.أنا آسف، لكن لا يمكننا إسقاط سفينة بها رفاقنا

274
00:18:23,860 --> 00:18:25,680
...ما هذا الغباء

275
00:18:25,680 --> 00:18:29,070
هل تقصد أنّك ستسمح بدخول
!هذه السّفينة المحترقة؟

276
00:18:29,070 --> 00:18:31,260
.نعم. مرحبًا بكم

277
00:18:32,640 --> 00:18:35,540
إن لم نستطع إيقافها، فسيتوجّب
.علينا السّماح لها بالدّخول

278
00:18:36,510 --> 00:18:41,280
هذا عمل رئيس مكتب الهجرة
.السّابق هاسيغاوا تايزو

279
00:18:42,410 --> 00:18:45,300
!فلتتقدّم جميع السّفن بأقصى سرعة

280
00:18:48,640 --> 00:18:50,680
!هل جننت؟

281
00:18:50,680 --> 00:18:52,610
!أيّها الأميرال

282
00:18:52,610 --> 00:18:55,430
ألم تقل أنّك ستثق بخياري؟

283
00:18:55,430 --> 00:18:58,190
.ثق بي إذًا

284
00:18:58,190 --> 00:19:01,280
!ثق بالخيار الّذي اتّخذه هذا الرّجل الّذي وثقت به

285
00:19:03,490 --> 00:19:08,760
أنا أخ صغير يحبّ شقيقيه
،والكائنات المدعوّة بالسّاموراي

286
00:19:08,760 --> 00:19:10,160
!وهذا هو جوابي

287
00:19:17,650 --> 00:19:19,580
دروع مضادّة للصّدمات؟

288
00:19:19,580 --> 00:19:20,210
لا تقل لي

289
00:19:20,520 --> 00:19:23,210
!إنّك تنوي إيقاف هذه السّفينة مباشرة

290
00:19:24,960 --> 00:19:29,360
!هذا جنون! ستجركم هذه السّفينة معها إلى الأرض

291
00:19:29,360 --> 00:19:30,970
.تمامًا

292
00:19:31,600 --> 00:19:36,090
.لكن إن استطعنا تأخير الصّدمة قليلاً ، فذلك يكفي

293
00:19:37,100 --> 00:19:41,110
.أعرف من في الأرض

294
00:19:41,850 --> 00:19:44,610
،أعرف أنّهم والأرض

295
00:19:44,940 --> 00:19:47,610
!سيعودون للحياة بالتّأكيد

296
00:19:50,210 --> 00:19:51,620
!أني-سان! موني-سان

297
00:19:52,140 --> 00:19:53,870
.سأتولّى الأمر هنا

298
00:19:54,940 --> 00:19:57,150
.أسرع واذهب إليه

299
00:19:59,130 --> 00:20:00,630
جنون؟

300
00:20:00,630 --> 00:20:03,880
.أرى أنّ التّخلّي عن أحدكما جنون أكبر

301
00:20:04,810 --> 00:20:06,820
،إن كان كلا الخيارين جنونًا

302
00:20:06,820 --> 00:20:10,130
.فأفضّل اختيار عالم فيه أشخاص أثق بهم

303
00:20:11,090 --> 00:20:13,890
.لا حاجة لأيّ بطائق تعريف أو أوراق قانونيّة

304
00:20:14,910 --> 00:20:17,390
.لا يهمّ إن كنتم أرضيّين أم لا

305
00:20:18,130 --> 00:20:22,770
!أحضروا وجوهكم الغبيّة إلى الدّيار أحياءً فحسب

306
00:20:24,010 --> 00:20:27,780
.هذا هو الجواز الّذي تصدره أرض السّاموراي

307
00:20:29,030 --> 00:20:32,960
!أيّها الأمير! لقد تجاوزت الدّروع حدّها الحرج

308
00:20:32,960 --> 00:20:34,410
!لا يمكننا إيقافها بعد الآن

309
00:20:34,410 --> 00:20:37,910
!سيُسحق الأسطول بأكمله إن استمرّ الأمر

310
00:20:37,910 --> 00:20:39,570
!لم ينجح الأمر حقًّا

311
00:20:39,570 --> 00:20:42,100
!لهذا قلت لك ألاّ تفعل هذا أيّها الأمير الغبيّ

312
00:20:42,100 --> 00:20:43,170
!اخرس أيّها العجوز

313
00:20:43,170 --> 00:20:45,870
.هاسيغاوا، تحمّل المسؤوليّة

314
00:20:45,870 --> 00:20:49,420
علامَ اعتمدت في هذه الخطّة الخرقاء؟

315
00:20:49,420 --> 00:20:51,210
.على الكون بأسره

316
00:20:51,850 --> 00:20:55,930
لا يمكن إيقاف ذلك الشّيء
.إلاّ إن جمعنا جميع سفن الكون

317
00:20:55,930 --> 00:20:59,260
!ماذا؟ كفّ عن التّحدّث في نومك أيّها الغبيّ

318
00:20:59,260 --> 00:21:00,920
...وكأنّنا نستطيع

319
00:21:00,920 --> 00:21:03,900
.لدينا جميع السّفن الّتي تحتاجونها هنا

320
00:21:04,610 --> 00:21:08,930
.لقد عدتم من أعماق اليأس أيّها الأرضيّون

321
00:21:08,930 --> 00:21:13,620
.والآن تحاولون إنقاذ سفينتنا الأمّ من الغرق

322
00:21:13,620 --> 00:21:18,020
أنا مندهش لأنّكم تحاولون إنقاذ كلّ
!تلك الأرواح، أعداءً كانوا أم حلفاء

323
00:21:18,020 --> 00:21:21,380
.ربّما أسأنا الحكم عليكم

324
00:21:21,380 --> 00:21:26,050
أقلت أنّك رئيس مكتب الهجرة السّابق؟
هلاّ منحتنا فرصة؟

325
00:21:26,050 --> 00:21:29,510
...إن قلت أنّك ستنقذ سفينتنا الأمّ

326
00:21:29,510 --> 00:21:33,930
.فسنستعمل كامل أسطولنا لحماية كوكبك

327
00:21:34,590 --> 00:21:36,220
!جيش التّحرير؟

328
00:21:36,220 --> 00:21:37,700
حقًّا؟

329
00:21:37,700 --> 00:21:40,220
.يبدو أنّ إعطاء جوازاتنا بثمن زهيد قد أثمر

330
00:21:42,370 --> 00:21:45,200
.مرحبًا بكم في أرض السّاموراي

331
00:21:54,250 --> 00:21:55,650
.مـ-مستحيل

332
00:21:56,210 --> 00:21:59,160
من أنت حقًّا يا هاسيغاوا تايزو؟

333
00:21:59,520 --> 00:22:02,290
!ما هو كمّ القوّة والسّلطة الّتي تملك؟

334
00:22:02,610 --> 00:22:04,420
أليس الأمر واضحًا؟

335
00:22:04,420 --> 00:22:09,640
،لا أنصاع لأيّ سلطة وأنا حرّ لأقول وأفعل ما أريد

336
00:22:09,640 --> 00:22:12,800
.دون أن أضطرّ لتحمّل مسؤوليّة شيء

337
00:22:13,610 --> 00:22:17,610
.لكنّني لا أملك القوّة والسّلطة والمال

338
00:22:17,610 --> 00:22:19,310
.لا أملك عملاً حتّى

339
00:22:22,050 --> 00:22:23,390
.أنا مجرّد رجل عاطل

340
00:24:00,820 --> 00:24:06,540
،قد يبدو عدم العمل رائعًا فجأة

341
00:24:00,820 --> 00:24:06,540
.لكن انتبهوا جيّدًا لخياراتكم في الحياة في العالم الحقيقيّ

342
00:24:06,540 --> 00:24:11,250
في تلك الأثناء، الحرب الّتي بدأها أوتسورو

343
00:24:06,540 --> 00:24:11,250
...تصل إلى ذروتها