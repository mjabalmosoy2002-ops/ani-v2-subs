1
00:00:07,980 --> 00:00:09,570
!مطلقة قذائف هائلة قادمة باتّجاهنا

2
00:00:09,980 --> 00:00:10,990
!فلتقم بصدّها

3
00:00:13,610 --> 00:00:14,740
!اِطلق
!اِنطلق

4
00:00:21,540 --> 00:00:22,870
!لقد نجحنا

5
00:00:31,300 --> 00:00:32,420
سحقاً

6
00:00:32,420 --> 00:00:33,510
!سأطلق مرّة أخرى

7
00:00:35,880 --> 00:00:37,640
!تجهيز البندقيّة في أقصى قوّتها

8
00:00:37,640 --> 00:00:39,350
!حسناً

9
00:00:54,990 --> 00:00:56,360
بيلد سترايك

10
00:00:56,860 --> 00:01:00,410
إنه غانبلا مصمّمة بطريقة خاصة بناءً على الغاندام سترايك

11
00:01:00,410 --> 00:01:03,450
سلاحها الأساسيّ هو قذيفة شعاعيّة متوسّطة النوعية

12
00:01:03,450 --> 00:01:06,370
من المحتمل أنّ مردوديّة الشعاع متغيّرة

13
00:01:06,370 --> 00:01:10,500
عندما تصل إلى أعلى مردوديّتها فإنها تعادل مطلقة قذائف هائلة

14
00:01:10,880 --> 00:01:15,420
هذه المردوديّة الهائلة... كيف يمكن للقذيفة أن تتحمّلها؟

15
00:01:15,420 --> 00:01:17,840
أرجو أن تلقي نظرة على هذه

16
00:01:17,840 --> 00:01:23,850
على الأرجح أنّ الأسطوانة الداخليّة تحتوي على قطعٍ معدنيّة لتزيد من متانتها

17
00:01:23,850 --> 00:01:28,850
كما أنّ الدرع تمكّن من صدّ طلقة من مطلقة القذائف الهائلة

18
00:01:28,850 --> 00:01:31,860
بالنظر إلى الضرر الذي خلّفته الطلقة

19
00:01:31,860 --> 00:01:37,530
قذ يكون درعاً عاديّاً مضافٌ إليه طبقة رفيعة من الألواح البلاستيكية

20
00:01:38,070 --> 00:01:40,950
...يحتاج هذا إلى مجهود كبير لإنجازه

21
00:01:41,530 --> 00:01:45,370
هل تمكّن ذلك الصبيّ من بنائها كلّها بمفرده؟

22
00:01:45,950 --> 00:01:47,960
إنه القدر

23
00:01:47,960 --> 00:01:51,090
...صانع الغانبلا سي إيوري هو ابن

24
00:01:51,090 --> 00:01:55,300
صاحب المركز الثاني في البطولة العالميّة الثانية لمعركة الغانبلا...

25
00:01:55,300 --> 00:01:57,290
تاكيشي إيوري

26
00:01:59,840 --> 00:02:01,800
فهمت، لا عجب في ذلك

27
00:02:02,890 --> 00:02:06,810
حتى مع ذلك فإنّ نصرنا مضمون

28
00:02:06,810 --> 00:02:10,230
...بعد كلّ شيء فإنّ المعركة تبدأ

29
00:02:11,860 --> 00:02:14,860
قبل أن تدخل ساحة المعركة بوقت طويل...

30
00:02:15,610 --> 00:02:20,610
...فلتصنعها... فلتفتح الصندوق، لا يمكنني الانتظار أكثر

31
00:02:20,610 --> 00:02:23,330
!عالم الغانبلا

32
00:02:23,330 --> 00:02:25,660
!فلتصنعها فلتصنعها، إنه أمر مثير

33
00:02:25,660 --> 00:02:29,960
!فلتصنع عالم الغانبلا

34
00:02:30,750 --> 00:02:32,670
!كيرارا
!كيرارا

35
00:02:33,380 --> 00:02:36,710
!شكراً لكم جميعاً

36
00:02:37,090 --> 00:02:38,510
!كيراران

37
00:02:41,540 --> 00:02:43,660
أنت لست بمفردك

38
00:02:43,660 --> 00:02:46,450
أنا وأنت نملك هذا الرابط بيننا

39
00:02:46,450 --> 00:02:49,790
ذلك الرابط جعلني أرغب في أخذ خطوة نحو الأمام

40
00:02:49,790 --> 00:02:53,990
فلنقم بوصل ألوان أحلامنا

41
00:02:53,990 --> 00:03:00,540
ولنصنع قوس قزحٍ لامع في السماء

42
00:03:05,250 --> 00:03:09,000
أنا لا أملك أية مزايا تستحقّ الحديث عنها

43
00:03:09,000 --> 00:03:12,990
لطالما شعرت بالنقص ولم تكن لديّ أية ثقة

44
00:03:12,990 --> 00:03:16,830
سألتني ما الشيء الممتع في ذلك؟

45
00:03:16,830 --> 00:03:20,620
بينما ابتسمت وهرعت في الجري أمامي

46
00:03:20,620 --> 00:03:22,990
عندما أكون في الداخل بمفردي ذكريات

47
00:03:22,990 --> 00:03:24,990
أستطيع أن أتزامن معك اندماج

48
00:03:24,990 --> 00:03:26,990
معك أستطيع أن أشعر بالثقة في هذه اللحظة

49
00:03:26,990 --> 00:03:27,990
!!استعداد، تجهيز، انطلاق

50
00:03:27,990 --> 00:03:32,580
منذ اللحظة التي شعرت بك فيها بداخل قلبي

51
00:03:32,580 --> 00:03:35,990
كنتُ على يقين بأنّ حلمي سيتحقّق

52
00:03:35,990 --> 00:03:39,990
بتلك الابتسامة التي لا تفارق وجهك

53
00:03:40,200 --> 00:03:43,000
أخذت بيدي بإحكام

54
00:03:43,000 --> 00:03:47,950
معك أنت لا شيء مستحيل

55
00:03:47,950 --> 00:03:51,160
أنت هو الشخص الذي جعلني أحسّ بهذه المشاعر

56
00:03:51,160 --> 00:03:55,580
أنت تعوّض القوّة التي أفتقِدها

57
00:03:55,580 --> 00:03:58,700
سوف أعوّض القوى التي تنقصك

58
00:03:58,700 --> 00:03:59,990
…فلنحلّق بعيداً

59
00:03:59,990 --> 00:04:01,790
لا تقف هكذا دون حراك لا تتوقّف

60
00:04:01,790 --> 00:04:03,790
سأكون إلى جانبك لا تبكي

61
00:04:03,790 --> 00:04:05,330
!لست بمفردك بعد الآن

62
00:04:05,330 --> 00:04:07,870
!!سيكون كلّ شيءٍ على ما يرام على ما يرام

63
00:04:10,600 --> 00:04:13,940
يبدو أنك قد تأهّلت للجولة الثانية

64
00:04:14,730 --> 00:04:18,110
مبارك عليك يا ريجي

65
00:04:19,070 --> 00:04:20,530
كان ذلك سهلاً

66
00:04:20,530 --> 00:04:24,450
—باستخدام الغانبلا الذي صنعه سي، بإمكاننا هزيمة أي

67
00:04:24,610 --> 00:04:25,530
ليس بهذه السرعة

68
00:04:25,530 --> 00:04:26,570
ماذا؟

69
00:04:26,870 --> 00:04:31,950
للغانبلا تاريخ عريق ما تزال تجهله

70
00:04:32,960 --> 00:04:37,040
إن أرخيت دفاعاتك فسيتمكّن من هزيمتك أحدهم

71
00:04:38,290 --> 00:04:40,880
هل تقصد نفسك بذلك الكلام؟

72
00:04:41,660 --> 00:04:43,470
فلتواصل الفوز يا ريجي

73
00:04:44,170 --> 00:04:46,840
أتحرّى شوقاً لرؤيتك في البطولة العالميّة

74
00:04:52,850 --> 00:04:54,480
...البطولة العالميّة

75
00:04:55,350 --> 00:04:58,650
يبدو أنه أصبح لديّ سبب آخر يمنعني من الخسارة

76
00:05:00,110 --> 00:05:02,110
أليس كذلك يا سي؟

77
00:05:05,570 --> 00:05:09,580
الحلقة الرابعة
غانبلا محبوب الجماهير كيرارا ☆

78
00:05:10,410 --> 00:05:11,990
سي

79
00:05:12,580 --> 00:05:14,160
ماذا هنالك يا أمّي؟

80
00:05:14,160 --> 00:05:18,170
هلّا عثرت على الغانبلا الذي تبحث عنه هذه الزبونة؟

81
00:05:18,650 --> 00:05:20,880
ليست لديّ فكرة عنها كلّها

82
00:05:23,880 --> 00:05:25,010
شكراً لك

83
00:05:27,050 --> 00:05:29,010
عفواً

84
00:05:29,010 --> 00:05:31,220
أيّ نوعٍ من الغانبلا تبحثين عنه؟

85
00:05:31,220 --> 00:05:36,230
0080 أنا أبحث عن عدّة جيم من نوع المناطق الباردة ذات الرقم

86
00:05:31,220 --> 00:05:36,230
معناها الغاندام المصنّعة بكميات هائلة GM جيم أو باختصار

87
00:05:36,230 --> 00:05:39,270
ذلك النوع؟ إنه هنا

88
00:05:40,020 --> 00:05:41,610
هل هذه هي؟

89
00:05:42,440 --> 00:05:45,610
!أجل إنها هي! شكراً لك

90
00:05:45,610 --> 00:05:48,110
لا مشكلة. هل تعرفين الكثير عن الغانبلا؟

91
00:05:48,740 --> 00:05:52,160
أحبّ الـجيم من معركة الجيب

92
00:05:52,160 --> 00:05:56,790
...سيطرة الجيم، سيطرة الجيم من نوع الفضاء، قناص الجيم الثاني

93
00:05:57,870 --> 00:06:01,920
الدرايكن-إي الذي تمّت إضافته للجيم القنّاص كان ظريفاً أيضاً

94
00:06:01,920 --> 00:06:03,880
كان ذلك ضمن قوّات ريا للغاندام المتوسّطة صحيح؟

95
00:06:03,880 --> 00:06:05,210
!أجل إنها هي

96
00:06:13,890 --> 00:06:17,560
هل تملكين أسئلة حول الغانبلا الذي اشتريته المرّة الماضية؟

97
00:06:18,020 --> 00:06:20,020
هل تودّين صنعها هنا؟

98
00:06:37,870 --> 00:06:41,140
أنت الشخص الذي التقيته في ذلك المكان المسمّى مدرسة

99
00:06:41,630 --> 00:06:43,250
هل أتيتِ لرؤية سي؟

100
00:06:46,260 --> 00:06:47,840
من تكون تلك الفتاة؟

101
00:06:49,580 --> 00:06:52,800
ألم تأتِ لرؤية سي؟

102
00:06:53,850 --> 00:06:54,850
ما مشكلتها؟

103
00:06:58,430 --> 00:06:59,730
أوي سي

104
00:06:59,730 --> 00:07:00,850
ماذا؟

105
00:07:00,850 --> 00:07:03,150
تلك الفتاة التي كانت في المتجر، هل هي صديقتك الحميمة؟

106
00:07:04,190 --> 00:07:07,860
كلا، ليس الأمر كذلك. إنها زبونة وحسب

107
00:07:07,860 --> 00:07:10,860
بدوت وكأنك تغازلها

108
00:07:10,860 --> 00:07:13,030
كنّا نتحدّث عن الغاندام

109
00:07:13,030 --> 00:07:15,240
يا له من أمر مملّ

110
00:07:15,870 --> 00:07:20,160
لم يسبق لي أن التقيتُ بفتاة تعرف الكثير عن الغاندام

111
00:07:20,160 --> 00:07:25,340
ماذا؟ ستشارك في بطولة معركة الغانبلا يا سي؟

112
00:07:25,630 --> 00:07:29,590
...لقد اجتزت الجولة الثانية حاليّاً لكن

113
00:07:29,590 --> 00:07:31,550
!هذا مذهل

114
00:07:31,550 --> 00:07:33,010
أخجلتني

115
00:07:33,010 --> 00:07:36,680
متى ستكون الجولة الثالثة؟ سوف آتي لتشجيعك

116
00:07:36,680 --> 00:07:40,350
لا داعي لذلك، سيكون الأمر مخجلاً إن خسرت

117
00:07:41,520 --> 00:07:44,690
يمكنني الجزم بالنظر إلى الغانبلا المعروضة

118
00:07:44,690 --> 00:07:48,860
لا شكّ في أنّ الغانبلا خاصتك قويّ للغاية

119
00:07:48,860 --> 00:07:51,360
أتعتقدين ذلك حقّاً؟

120
00:08:01,460 --> 00:08:02,960
صباح الخير يا رئيسة القسم

121
00:08:03,620 --> 00:08:04,540
صباح الخير

122
00:08:05,000 --> 00:08:07,960
هل قمتِ بصنع الغانبلا الذي اشتريته المرّة السابقة؟

123
00:08:08,300 --> 00:08:10,860
إن كانت لديك أية أسئلة فلا تتردّدي في سؤالي

124
00:08:12,100 --> 00:08:14,470
ما... ماذا هناك؟

125
00:08:16,510 --> 00:08:18,680
كلان لا شيء

126
00:08:19,220 --> 00:08:20,720
حـ-حسناً

127
00:08:21,730 --> 00:08:23,600
تقنيّات في
استخدام الألوان
المائيّة

128
00:08:29,570 --> 00:08:33,030
الفتاة التي كنتُ أتحدّث معها البارحة في المتجر؟

129
00:08:34,030 --> 00:08:35,860
لقد كانت مجرّد زبونة

130
00:08:35,860 --> 00:08:37,910
كنّا نتحدّث عن الغانبلا وحسب

131
00:08:38,240 --> 00:08:39,740
لمَ تسألين؟

132
00:09:00,320 --> 00:09:01,890
إيوري-كن

133
00:09:05,060 --> 00:09:07,230
ما المشكلة يا كوساكا؟

134
00:09:07,230 --> 00:09:08,940
لقد أوقعتِ حقيبتك

135
00:09:13,900 --> 00:09:15,030
...تلك الفتاة

136
00:09:15,030 --> 00:09:16,860
هل تعرفها؟

137
00:09:16,860 --> 00:09:20,280
أعتقد بأنني رأيتها من قبل في معركة للغانبلا

138
00:09:20,280 --> 00:09:21,580
...لكن

139
00:09:21,870 --> 00:09:24,000
قد أكون مخطئاً

140
00:09:27,880 --> 00:09:30,840
لمَ أتيتِ لرؤيتي يا ميهوشي-سان؟

141
00:09:31,880 --> 00:09:34,550
هل أحتاج لسبب معيّن كي آتي لرؤيتك؟

142
00:09:35,300 --> 00:09:37,180
كلّا ليس الأمر كذلك؟

143
00:09:37,180 --> 00:09:40,600
لكن كيف عرفتِ بأنّني أرتاد أكاديمية سيهو؟

144
00:09:41,510 --> 00:09:43,850
...كان ذلك

145
00:09:43,850 --> 00:09:45,390
!بفضل حدسي الأنثوي...

146
00:09:47,060 --> 00:09:48,520
أنتِ مثل النيوتايب

147
00:09:49,690 --> 00:09:51,860
هل تريد بعض الشاي؟

148
00:09:51,860 --> 00:09:54,650
أجل شكراً لكِ

149
00:09:59,870 --> 00:10:01,410
...إذاً

150
00:10:01,450 --> 00:10:02,900
لقد كنتُ أتساءل

151
00:10:02,900 --> 00:10:07,000
إن كان في إمكاني رؤية الغانبلا الذي صنعته من أجل البطولة

152
00:10:07,000 --> 00:10:09,630
بالطبع، إنها معي الآن

153
00:10:10,380 --> 00:10:11,540
تفضّلي

154
00:10:11,880 --> 00:10:13,880
!إنها رائعة كما تصوّرتها تماماً

155
00:10:13,880 --> 00:10:15,460
هل يمكنني لمسها؟

156
00:10:15,460 --> 00:10:16,800
بالطبع

157
00:10:17,970 --> 00:10:20,390
إنها مصنوعة بناءً على الغاندام سترايك

158
00:10:20,840 --> 00:10:23,010
أنت تعرفين الكثير حقّاً

159
00:10:23,010 --> 00:10:27,310
...مذهل. القذيفة والدرع أصليّان تماماً

160
00:10:27,310 --> 00:10:29,480
لابدّ أنك أخذت أياماً عديدة لصنعها

161
00:10:29,480 --> 00:10:31,230
أجل نوعاً ما

162
00:10:31,520 --> 00:10:34,150
هل الخلفية متحوّلة؟

163
00:10:34,150 --> 00:10:36,860
أجل، لا تخبري أحد بهذا

164
00:10:36,860 --> 00:10:40,240
لكن هنالك خدعة متعلّقة بتلك الخلفيّة

165
00:10:40,240 --> 00:10:42,530
حقّاً؟ ما هي يا ترى؟

166
00:10:43,240 --> 00:10:44,160
...حسناً

167
00:10:47,910 --> 00:10:50,580
عفواً لكن عليّ استخدام الحمّام

168
00:10:51,630 --> 00:10:53,840
حسناً سأنتظرك هنا

169
00:10:53,840 --> 00:10:54,710
حسناً

170
00:11:10,230 --> 00:11:11,270
عفواً

171
00:11:12,100 --> 00:11:14,860
...ذلك الغانبلا يخصّ إيوري-كن

172
00:11:14,860 --> 00:11:18,440
أجل، لقد طلبتُ منه أن يرينا إياها

173
00:11:19,030 --> 00:11:21,610
من تكونين على أية حال؟

174
00:11:22,870 --> 00:11:26,040
آسف على جعلك تنتظرين

175
00:11:26,040 --> 00:11:27,700
رئيسة القسم؟

176
00:11:28,790 --> 00:11:30,460
لمَ أنتِ هنا؟

177
00:11:32,170 --> 00:11:35,880
آسفة إن أعطيتك الانطباع الخطأ

178
00:11:37,210 --> 00:11:40,880
كان سي يحاول أن يريني الغانبلا خاصّته وحسب

179
00:11:40,880 --> 00:11:42,300
لذا لا داعي لكي تشعري بالقلق

180
00:11:42,840 --> 00:11:44,350
شكراً لك يا سي

181
00:11:44,350 --> 00:11:47,010
سأراك في المتجر مرّة أخرى

182
00:11:47,010 --> 00:11:50,280
أجل، شكراً لك

183
00:11:52,350 --> 00:11:54,350
يا رئيسة القسم؟

184
00:12:01,860 --> 00:12:03,240
فهمت

185
00:12:05,370 --> 00:12:07,450
هذا هو الشباب إذاً

186
00:12:21,050 --> 00:12:22,840
هل ستغادرين يا آنسة؟

187
00:12:23,800 --> 00:12:25,010
أنت هو ذلك العجوز غريب الأطوار

188
00:12:25,010 --> 00:12:29,390
لابدّ أنك هنا لأنك مهتمّة بمعركة الغانبلا

189
00:12:29,390 --> 00:12:30,020
فلنذهب

190
00:12:31,850 --> 00:12:34,940
المكان الذي سنذهب إليه تحدث فيه أقوى المعارك

191
00:12:34,940 --> 00:12:36,480
كما أنّ الدخول مجانيّ

192
00:12:36,480 --> 00:12:38,270
...كلّا ليس الأمر

193
00:12:59,500 --> 00:13:02,340
في الجولة الثالثة من المسابقة الإقليمية التأهيليّة

194
00:13:02,340 --> 00:13:04,800
الفائز في المباراة الأولى هو تاتسويا يوكي

195
00:13:05,470 --> 00:13:08,010
لقد تمّ تعديل الزاكو خاصته بطريقة أفضل

196
00:13:08,550 --> 00:13:10,310
إنه قوّة لا يستهان بها

197
00:13:10,890 --> 00:13:13,130
لقد كان الغانبلا خاصته مثاليًّا

198
00:13:13,930 --> 00:13:18,270
!الغانبلا خاصتنا أقوى بكثير، سنثبت لهم ذلك في هذه المسابقة

199
00:13:18,270 --> 00:13:20,570
أنا أتحرّى شوقاً لذلك أيضاً

200
00:13:21,610 --> 00:13:25,900
لكن قبل ذلك، عليك أن تركّز على الجولة الثالثة

201
00:13:25,900 --> 00:13:30,490
خصمكما التالي فاز بأوّل مبارتين بشكل افتراضيّ

202
00:13:30,490 --> 00:13:32,290
فلتأخذا حذركما

203
00:13:32,290 --> 00:13:33,580
بشكل افتراضيّ؟

204
00:13:33,580 --> 00:13:34,870
—هل لديك مشكلة معـ

205
00:13:34,870 --> 00:13:37,580
ستبدأ الآن المباراة السابعة

206
00:13:38,080 --> 00:13:39,920
!حان دورنا، فلنذهب يا سي

207
00:13:39,920 --> 00:13:41,340
أجل

208
00:13:47,970 --> 00:13:50,930
معركتهما على وشك أن تبدأ

209
00:13:51,850 --> 00:13:52,970
إيوري-كن

210
00:13:54,850 --> 00:13:56,520
...واحد، اثنان

211
00:13:56,520 --> 00:13:58,940
!كيرارا
!كيرارا

212
00:14:09,780 --> 00:14:12,410
...فلتفتح الصندوق، لا يمكنني الانتظار أكثر

213
00:14:12,410 --> 00:14:15,040
!عالم الغانبلا

214
00:14:15,040 --> 00:14:17,790
!فلتصنعها فلتصنعها، يا له من أمر مثير

215
00:14:17,790 --> 00:14:21,920
!فلتصنع عالم الغانبلا

216
00:14:23,130 --> 00:14:27,630
!مرحبا، أنا هي محبوبتكم كيرارا

217
00:14:28,130 --> 00:14:29,300
كيراران

218
00:14:29,300 --> 00:14:31,930
!كيراران
!كيراران

219
00:14:32,300 --> 00:14:33,180
ما بحقّ الجحيم هو هذا؟

220
00:14:33,180 --> 00:14:33,850
لا تسألني أنا

221
00:14:35,930 --> 00:14:37,100
...تلك الفتاة

222
00:14:37,100 --> 00:14:38,890
!كيرارا

223
00:14:38,890 --> 00:14:39,650
!أهو أحد معجبيها؟

224
00:14:42,480 --> 00:14:44,400
...فهمت، إنها

225
00:14:45,820 --> 00:14:47,740
كن حذراً يا إيوري-كن

226
00:14:49,150 --> 00:14:51,410
مرحبا، أنا أدعى كيرارا

227
00:14:51,410 --> 00:14:53,580
لا تكن قاسياً عليّ

228
00:14:53,870 --> 00:14:55,370
فلننهِ هذه المهزلة بسرعة

229
00:14:55,620 --> 00:14:57,500
فلتحرص على ألّا يتشتّت ذهنك

230
00:15:00,420 --> 00:15:03,500
البدء في عمليّة بلافسكي لانتشار الجزيئات

231
00:15:09,840 --> 00:15:12,260
المجال الخامس، المدينة

232
00:15:13,010 --> 00:15:15,180
المرجو تجهيز الغانبلا

233
00:15:20,140 --> 00:15:21,190
بداية المعركة

234
00:15:23,730 --> 00:15:25,360
بيلد سترايك غاندام

235
00:15:25,360 --> 00:15:26,190
!فلننطلق

236
00:15:28,780 --> 00:15:30,700
!كيرارا، فلننطلق

237
00:15:34,870 --> 00:15:36,370
!الغاربيرا تيترا

238
00:15:36,370 --> 00:15:39,460
لقد صُنعت في الأصل لتكون النموذج المبدئي  لوحدة الغاندام الرابعة

239
00:15:40,370 --> 00:15:41,710
أنت فتى ذكيّ

240
00:15:41,710 --> 00:15:43,460
!وماذا في ذلك؟

241
00:15:50,800 --> 00:15:51,590
!يا لسرعتها

242
00:15:52,840 --> 00:15:53,970
!هذا لا يهمّ

243
00:15:57,930 --> 00:15:58,430
!ماذا؟

244
00:15:58,430 --> 00:15:59,390
لماذا؟
!ماذا؟

245
00:16:14,030 --> 00:16:15,320
!ما الذي يحدث؟

246
00:16:15,320 --> 00:16:16,200
!سي

247
00:16:16,200 --> 00:16:18,450
كيف يُعقل أن يحدث هذا...؟

248
00:16:23,670 --> 00:16:26,000
الأجزاء الملتحمة تمّ إلحاق الضرر بها

249
00:16:26,000 --> 00:16:28,380
كيف حدث شيءٌ كهذا؟

250
00:16:28,960 --> 00:16:31,840
لم أسمح لأيّ شخص بأن يلمس البيلد سترايك

251
00:16:33,260 --> 00:16:36,390
...كلّا... لا يمكن

252
00:16:36,720 --> 00:16:39,890
معك حقّ، كيراران

253
00:16:40,310 --> 00:16:41,810
!هل أنتِ هي ميهوشي-سان؟

254
00:16:43,850 --> 00:16:45,400
...كما توقّعت

255
00:16:45,400 --> 00:16:47,150
...ميهوشي-سان

256
00:16:47,150 --> 00:16:50,860
لقد أتت إليّ وهي على علمٍ بأنّني خصمها التالي؟

257
00:16:50,860 --> 00:16:54,030
...وقامت بإلحاق الضرر بالغانبلا خاصّتي عن قصد

258
00:16:55,860 --> 00:16:59,450
المعركة تبدأ قبل دخول ساحة المعركة بوقت طويل

259
00:16:59,450 --> 00:17:01,500
!اِنطلقي يا غيربيرا تيترا

260
00:17:10,880 --> 00:17:12,010
!تبّاً لك

261
00:17:12,010 --> 00:17:15,840
هل أنتِ سعيدة بالفوز بالمعارك بهذه الطريقة يا ميهوشي-سان؟

262
00:17:15,840 --> 00:17:19,220
!القيام بأمور خبيثة كهذه تجلب العار للغانبلا خاصتك

263
00:17:20,470 --> 00:17:22,600
يا لك من شخص لطيف يا سي

264
00:17:22,930 --> 00:17:25,730
لكنني غير مهتمّة بالغانبلا ولا بالغاندام

265
00:17:25,730 --> 00:17:30,440
وكالتي تحاول أن تزيد من شهرتي كمحبوبة جماهير في قتال الغانبلا على طريقة أكيهابارا

266
00:17:30,440 --> 00:17:32,530
لهذا درست بجدّ

267
00:17:33,400 --> 00:17:36,490
وقمت بمشاهدة عشرين أنمي لا أفهم فيها شيئاً

268
00:17:36,950 --> 00:17:39,410
قمت بحفض أسماء مثل زاكو وغوف

269
00:17:39,910 --> 00:17:42,850
وقمتُ بإتقان عمليّة صنع النماذج البلاستيكية وتقنياتها

270
00:17:43,500 --> 00:17:48,330
في بعض الأحيان أسأل نفسي إن كنتُ محبوبة جماهير أم صانعة نماذج

271
00:17:51,050 --> 00:17:54,260
...لكنني واصلت العمل بجدّ

272
00:17:54,260 --> 00:17:56,090
!لكي أحقّق حلمي

273
00:17:58,010 --> 00:18:00,180
!أجل، لكي أصبح أفضل محبوبة جماهير

274
00:18:02,850 --> 00:18:06,520
هذا غير صحيح! إن لم تكوني تحبّين الغانبلا

275
00:18:06,520 --> 00:18:09,690
!فما كنتِ لتتمكّني من صنع غانبلا قويّ كـغيربيرا تيترا

276
00:18:09,810 --> 00:18:12,650
ومن قال بأنّني صنعته بنفسي؟

277
00:18:12,650 --> 00:18:13,530
ماذا؟

278
00:18:15,190 --> 00:18:19,620
لقد طلبتُ من معجبيّ صنعها مقابل السماح لهم بأخذ صورة معي

279
00:18:21,950 --> 00:18:24,910
سأفعل المستحيل للفوز بهذه المعركة

280
00:18:24,910 --> 00:18:27,120
إن فزت فسأحظى بالتغطية الإعلاميّة

281
00:18:27,580 --> 00:18:29,630
كلما زادت التغطية كلما زاد تألّقي

282
00:18:30,540 --> 00:18:33,710
سوف أتمكّن من بدء مشواري كمغنّية وإطلاق ألبومي الأوّل

283
00:18:33,710 --> 00:18:36,630
...هنالك مسرح لامع

284
00:18:36,630 --> 00:18:39,800
!ينتظرني في المبدان الكبير...

285
00:18:42,260 --> 00:18:43,220
!الدرع

286
00:18:43,220 --> 00:18:44,560
أنا آسفة يا سي

287
00:18:44,560 --> 00:18:47,310
!سوف أعوّضك عن ذلك بإرسال تذاكر للمسرح

288
00:18:51,060 --> 00:18:51,940
!كلّا

289
00:18:51,940 --> 00:18:53,020
!إيوري

290
00:18:53,860 --> 00:18:54,480
!سي

291
00:18:56,780 --> 00:18:58,570
ريجي، الفتحة الثانية عشر

292
00:19:05,330 --> 00:19:06,040
!ماذا؟

293
00:19:09,370 --> 00:19:10,960
!لقد تحوّلت الخلفيّة

294
00:19:11,330 --> 00:19:13,880
أهو مقاتل... كلا بل ربما معزّز؟

295
00:19:15,300 --> 00:19:17,510
ما بحقّ الجحيم هو هذا؟

296
00:19:18,130 --> 00:19:21,720
هنالك خدعة خاصة بهذه الخلفيّة

297
00:19:21,720 --> 00:19:24,640
!أهذا ما كان يتحدّث عنه؟

298
00:19:28,350 --> 00:19:30,150
اِسمك هو كيرارا صحيح؟

299
00:19:30,730 --> 00:19:35,150
أنا لا أكره الأشخاص الذين يتحدّون المستحيل

300
00:19:35,440 --> 00:19:37,570
بل يعجبني الأشخاص ذوي الجرأة مثلك

301
00:19:38,690 --> 00:19:39,740
...لكن

302
00:19:40,070 --> 00:19:43,570
!نحن أيضاً نملك أسباباً تجعلنا نرفض الخسارة

303
00:19:55,590 --> 00:19:57,130
انتهت المعركة

304
00:19:58,300 --> 00:20:00,840
...مستحيل، حلمي

305
00:20:01,300 --> 00:20:03,180
...حلم كيرارا

306
00:20:13,940 --> 00:20:17,320
سي، لا تدع الأمر يؤثّر عليك

307
00:20:17,320 --> 00:20:21,280
الآن لن يكون في استطاعتي التحدّث معها حول الغاندام بعد الآن

308
00:20:21,860 --> 00:20:25,160
ماذا؟ ظننتُ بأنك مُعجبٌ بها

309
00:20:25,870 --> 00:20:29,760
مستحيل، أخبرتك بأنها مجرد زبونة

310
00:20:30,290 --> 00:20:33,870
لديّ فكرة! إن أريتها السعادة التي تنتج عن صنع الغانبلا

311
00:20:33,870 --> 00:20:36,460
!فأنا أراهن على أنها ستحبّها

312
00:20:37,500 --> 00:20:39,880
!كلّ ذلك الجهد من أجل لا شيء

313
00:20:39,880 --> 00:20:41,800
!فلنحاول مجدّداً مع بعض

314
00:20:41,800 --> 00:20:43,930
!سوف أصنع لك غانبلا أقوى بكثير

315
00:20:43,930 --> 00:20:46,640
!لا يمكنني الانتظار عاماً آخر

316
00:20:49,850 --> 00:20:51,310
مستحيل

317
00:20:52,060 --> 00:20:54,270
مبارك عليكما يا سي-كن وريجي-كن

318
00:20:54,270 --> 00:20:56,110
شكراً لك يا رال-سان

319
00:20:56,110 --> 00:20:57,980
لقد كانت معركة قويّة

320
00:20:58,480 --> 00:21:03,650
يكبر المحارب عن طريق مواجهته للصعاب والتغلّب عليها

321
00:21:07,030 --> 00:21:08,240
إيوري-كن

322
00:21:08,240 --> 00:21:11,450
رئيسة القسم، هل أتيتِ لتشجيعي؟

323
00:21:11,450 --> 00:21:13,870
مبارك عليكما يا إيوري-كن وريجي-كن

324
00:21:13,870 --> 00:21:14,790
شكراً لكِ

325
00:21:14,790 --> 00:21:16,420
شكراً لك يا رئيسة القسم

326
00:21:18,380 --> 00:21:19,880
...و

327
00:21:20,670 --> 00:21:21,840
ماذا هناك؟

328
00:21:21,840 --> 00:21:25,970
لا أعرف كيفية صنع الغانبلا التي اشتريته من عندك

329
00:21:25,970 --> 00:21:27,760
هلّا قمت بتعليمي في وقتٍ ما؟

330
00:21:28,850 --> 00:21:30,310
بالطبع

331
00:21:30,310 --> 00:21:32,680
هل تريدين المجيء إلى متجري الآن؟

332
00:21:35,060 --> 00:21:36,850
أجل فلنذهب

333
00:21:47,000 --> 00:21:50,450
إن كان هنالك مستقبلٌ تريد لحاقه

334
00:21:50,450 --> 00:21:53,250
مهما كان عدد المرّات التي ستتألّم فيها

335
00:21:53,250 --> 00:21:55,750
فلتبقَ مركّزاً على أحلامك

336
00:21:55,750 --> 00:22:01,200
تلك هي الطريقة التي نجتاز بها الحاضر

337
00:22:09,910 --> 00:22:15,990
حوصرت في تدفّق الزمن بطريقة ما

338
00:22:15,990 --> 00:22:19,620
وكنتُ أتقدّم نحو الأمام ببطء

339
00:22:20,700 --> 00:22:26,750
...بينما مشيت شعرتُ بأنه حتى خطواتي

340
00:22:26,750 --> 00:22:30,660
...بدأت في الاختفاء

341
00:22:30,660 --> 00:22:35,990
لا مكان لديّ أذهب إليه بينما أوجّه قبضتي نحو السماء

342
00:22:35,990 --> 00:22:38,660
فلنحاول طرح السؤال على أنفسنا

343
00:22:38,660 --> 00:22:43,750
التقدّم إلى الأمام بقوّة أكبر

344
00:22:43,750 --> 00:22:46,990
إن كان هنالك مستقبلٌ تريد لحاقه

345
00:22:46,990 --> 00:22:49,990
مهما كان عدد المرّات التي ستتألّم فيها

346
00:22:49,990 --> 00:22:52,250
فلتبقَ مركّزاً على أحلامك

347
00:22:52,250 --> 00:22:54,990
تجاوز الحاضر

348
00:22:54,990 --> 00:22:57,990
...لا أريد صرف نظري عن العوائق

349
00:22:57,990 --> 00:23:00,790
التي تقف أمامي...

350
00:23:00,790 --> 00:23:03,000
لا أريد أن أخسر

351
00:23:03,000 --> 00:23:05,950
ما الذي يمكنني تحقيقه؟

352
00:23:05,950 --> 00:23:10,990
أريد أن أؤمن بالقوّة اللامتناهية

353
00:23:10,990 --> 00:23:13,330
وأريد منّا أن نواصل في تحدّي أنفسنا

354
00:23:13,330 --> 00:23:15,660
دائماً وإلى الأبد

355
00:23:24,410 --> 00:23:26,160
أحسنت صنعاً يا إيوري

356
00:23:26,160 --> 00:23:28,700
لقد فقت كلّ توقّعاتي

357
00:23:28,970 --> 00:23:30,390
لا يمكنني أن أتكاسل الآن

358
00:23:30,390 --> 00:23:31,050
تاتسويا

359
00:23:33,250 --> 00:23:35,520
ألان! لمَ أنت هنا؟

360
00:23:36,370 --> 00:23:38,530
تاتسويا، فلتنصت إليّ بإمعان

361
00:23:39,350 --> 00:23:40,890
لقد أُصيب الزعيم بالمرض

362
00:23:41,900 --> 00:23:43,080
!الزعيم؟

363
00:23:43,560 --> 00:23:45,720
لهذا السبب أنا هنا

364
00:23:47,090 --> 00:23:48,740
لكي آخذك معي

365
00:23:49,320 --> 00:23:52,070
وأجعلك تترك اِسم يوكي خلفك

366
00:23:54,990 --> 00:24:00,690
في الحلقة القادمة

367
00:23:55,990 --> 00:23:59,500
مجرّد النظر إليه يجعلني أعرف مدى قيمة هذا الغانبلا

368
00:23:59,870 --> 00:24:01,500
في الحلقة القادمة، أقوى صانع

369
00:24:01,790 --> 00:24:04,990
ما زلت لا تعرف معركة الغانبلا الحقيقيّة