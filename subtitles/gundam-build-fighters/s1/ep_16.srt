1
00:00:02,730 --> 00:00:04,850
!أبي! أبي

2
00:00:06,650 --> 00:00:08,190
أهلاً بك يا سي

3
00:00:08,190 --> 00:00:10,110
اليوم هو يوم احتفالك

4
00:00:10,690 --> 00:00:11,820
!أجل

5
00:00:11,820 --> 00:00:13,650
فلتتفضّل

6
00:00:26,880 --> 00:00:30,590
!مبارك عليك احتلال المركز السادس عشر في البطولة العالميّة

7
00:00:30,590 --> 00:00:35,510
وأهلا بعودتك من سفرك حول العالم لترويج الغانبلا

8
00:00:42,100 --> 00:00:44,600
لقد أحضرت لك هدية يا سي

9
00:00:47,270 --> 00:00:49,690
!شكراً لك يا أبي

10
00:00:53,990 --> 00:00:56,440
!ما أجمل أن تحبّ الغانبلا
!ما أجمل أن تحبّ الغانبلا

11
00:00:56,440 --> 00:00:58,620
!مرحى للغانبلا
!مرحى للغانبلا

12
00:01:07,880 --> 00:01:09,540
كان ذلك مجرّد حلم

13
00:01:10,960 --> 00:01:14,970
أتساءل أين يمكن أن يتواجد أبي الآن؟

14
00:01:15,000 --> 00:01:20,410
لقد أخفيت نقاط ضعفي عن طريق التصرّف بخشونة

15
00:01:20,410 --> 00:01:23,410
لكنّني لن أهرب بعد الآن

16
00:01:23,870 --> 00:01:26,990
فلنحلّق مجدّداً في تلك السماء

17
00:01:27,250 --> 00:01:30,990
التي بنيتها ودمّرتها ثمّ بنيتها من جديد

18
00:01:30,990 --> 00:01:33,500
مرّات عدّة مراراً وتكراراً

19
00:01:33,500 --> 00:01:37,990
لكنّني عرفت معنى الشعور بالخسارة

20
00:01:37,990 --> 00:01:41,200
أردت أن يعترف بي الجميع دون أن أحرّك ساكناً

21
00:01:41,200 --> 00:01:43,790
حتّى وإن كنتُ أتصرّف بخشونة

22
00:01:43,790 --> 00:01:49,290
لكن، ألا تعلم بأنّ ذلك جعلني أشعر بالفراغ وحسب؟

23
00:01:49,290 --> 00:01:51,910
!فلننطلق! حان وقت الاستيقاظ

24
00:01:51,910 --> 00:01:54,450
!فلتفتح عينيك! قوّتك أصبحت واضحة

25
00:01:54,450 --> 00:01:56,990
!فلتخترق مصيرك! قاتل من أجل نفسك

26
00:01:56,990 --> 00:01:59,370
!لا تبعد ناظريك! فلتحلّق من جديد

27
00:01:59,370 --> 00:02:04,290
...عندما تتمنّى بأن تصبح أقوى

28
00:02:04,290 --> 00:02:06,990
...فإنّ أجنحتك التي كانت ترتعش فيما سبق

29
00:02:06,990 --> 00:02:10,870
سوف تخترق الظلام

30
00:02:10,870 --> 00:02:16,990
لن أشعر بالخوف وأنت إلى جانبي

31
00:02:16,990 --> 00:02:19,830
سوف أُبقي يديك في يدي

32
00:02:20,040 --> 00:02:21,990
...لأنك سبق وأن أخبرتني

33
00:02:21,990 --> 00:02:27,750
بأنّ نقطة ضعفي هي كذلك نقطة قوّتي

34
00:02:27,750 --> 00:02:31,500
تمكّنتُ من النهوض من جديد

35
00:02:31,500 --> 00:02:38,910
من أجلك أنت سوف أتغلّب على كلّ الآلام

36
00:02:38,910 --> 00:02:40,450
مقاتلو نماذج الغانبلا
من أجلك أنت سوف أتغلّب على كلّ الآلام

37
00:02:40,450 --> 00:02:44,000
فلنبدأ الآن ولنحلّق في السماء من جديد

38
00:02:46,540 --> 00:02:48,990
!مرحبا بكم جميعاً

39
00:02:48,990 --> 00:02:51,990
أنا هي الشخصية الممثّلة لمسابقة بطولة الغانبلا العالميّة

40
00:02:51,990 --> 00:02:54,250
!كيرارا، محبوبة جماهير الغانبلا

41
00:02:54,620 --> 00:02:55,660
!كيراران

42
00:02:58,280 --> 00:02:59,950
إنه اليوم العاشر في البطولة العالميّة

43
00:02:59,950 --> 00:03:01,950
وقد انتهت مرحلة التصفيات

44
00:03:01,950 --> 00:03:06,870
!كما تمّ اختيار ستّة عشر فريقاً للتقدّم إلى نهائيات البطولة

45
00:03:06,870 --> 00:03:10,080
،قبل بداية النهائيات، والتي ستكون بعد ثلاثة أيام

46
00:03:10,080 --> 00:03:11,870
...لدينا هنا معنا

47
00:03:11,870 --> 00:03:16,170
!راينر تشومر-سان من ألمانيا والذي لم يتأهل إلى النهائيات مع الأسف...

48
00:03:16,550 --> 00:03:20,420
تشومر-سان، مالذي تتوقّع رؤيته فيما سيأتي؟

49
00:03:22,340 --> 00:03:26,760
من كان يتوقّع بأنّ سي وريجي سيظلّان في المسابقة

50
00:03:27,180 --> 00:03:31,190
سوف أجعل الأمر واضحاً وبسيطاً

51
00:03:31,190 --> 00:03:33,850
فيليني سوف يخسر

52
00:03:33,850 --> 00:03:36,020
سوف يتمّ تدميره كليّاً

53
00:03:36,020 --> 00:03:40,490
لا بدّ أنّ لديك ذوقاً سيّئاً للغاية إن كنتِ معجبة بشخص فاشل مثله يا كيرارا-تشان

54
00:03:40,490 --> 00:03:41,820
!تشومر-سان

55
00:03:44,070 --> 00:03:47,080
!أنا جاهزة بالكامل

56
00:03:47,370 --> 00:03:50,040
الآن يمكنني التعامل مع أولئك الصّحفيّين

57
00:03:54,210 --> 00:03:58,170
هل يمكنك إخبارنا عن الطريقة التي ربّيت بها سي إيوري؟

58
00:03:59,130 --> 00:04:01,170
لم أقم بأيّ شيء خاصّ

59
00:04:01,170 --> 00:04:04,010
كلّ ما أملته هو أن يكون فتى طيّباً وصريحاً

60
00:04:04,010 --> 00:04:07,850
لقد احتلّ زوجك تاكيشي-سان المركز الثاني في البطولة العالميّة الثانية

61
00:04:07,850 --> 00:04:10,350
والآن يحتلّ ابنك المركز السادس عشر ضمن أفضل اللاعبين

62
00:04:10,350 --> 00:04:12,020
أنت تملكين عائلة متيّمة بالغانبلا فعلاً

63
00:04:12,020 --> 00:04:14,400
!كما أنك فائقة الجمال يا سيّدتي

64
00:04:14,400 --> 00:04:17,110
لقد أحرجتني

65
00:04:20,230 --> 00:04:23,070
مغلق مؤقّتاً
~نعتذر عن ذلك ♥~

66
00:04:21,360 --> 00:04:23,070
!تمّ إغلاق الأبواب

67
00:04:23,070 --> 00:04:25,990
نماذج إيوري

68
00:04:23,490 --> 00:04:25,990
فلتنتظراني يا سي وريجي

69
00:04:26,280 --> 00:04:29,910
!ها أنا قادمة لتشجيعكما

70
00:04:29,910 --> 00:04:35,840
نماذج إيوري

71
00:04:35,840 --> 00:04:39,840
الحلقة السادسة عشر
ها نحن نلتقي من جديد يا أبي

72
00:04:41,960 --> 00:04:43,840
كان ذلك خطئي يا سي

73
00:04:43,840 --> 00:04:45,930
أنا آسف لأنني كسرتها

74
00:04:45,930 --> 00:04:49,350
لا داعي لتقول ذلك مرّة أخرى، لم يكن بيدنا حيلة أخرى

75
00:04:50,310 --> 00:04:53,100
أقصد أنّ خصمنا كان فيليني-سان بعد كلّ شيء

76
00:04:53,100 --> 00:04:58,060
لكن هل ستتمكّن من إصلاحها من أجل النهائيات التي ستبدأ بعد يومين؟

77
00:04:58,060 --> 00:05:02,190
لا تقلق، ستساعدني رئيسة القسم وكذا رال-سان

78
00:05:03,030 --> 00:05:05,860
!لديّ فكرة! سأساعدك أنا أيضاً

79
00:05:07,200 --> 00:05:11,240
كلا، لم يسبق لك أن صنعت غانبلا من قبل

80
00:05:11,540 --> 00:05:14,460
سيكون الأمر في منتهى السهولة بالنسبة إليّ

81
00:05:14,460 --> 00:05:16,830
دعني أرى

82
00:05:16,830 --> 00:05:18,500
!ما-ماذا؟

83
00:05:18,500 --> 00:05:19,670
سيكون كلّ شيء على ما يرام

84
00:05:19,880 --> 00:05:21,090
!كلّا

85
00:05:22,500 --> 00:05:24,170
!قلت لك لا

86
00:05:34,350 --> 00:05:36,270
!كيف تتجرّأ على ذلك؟

87
00:05:36,270 --> 00:05:38,770
أ-أنت الذي رفض تركها

88
00:05:40,060 --> 00:05:41,690
لا تزعجني بعد الآن

89
00:05:41,690 --> 00:05:43,320
!سوف أعمل بمفردي

90
00:05:44,860 --> 00:05:47,360
حسناً لقد فهمت

91
00:05:47,360 --> 00:05:51,240
تتصرّف بتسلّط فقط لأنك تجيد صناعة الغانبلا

92
00:05:51,240 --> 00:05:53,040
إلى أين أنت ذاهب يا ريجي؟

93
00:05:53,040 --> 00:05:56,870
هذا لا يخصّك! لقد طلبتَ منّي ألّا أزعجك

94
00:05:56,870 --> 00:05:58,290
وداعاً

95
00:06:02,920 --> 00:06:04,460
وهذا ما حدث

96
00:06:04,880 --> 00:06:06,220
لا داعي لأن تتشاجرا

97
00:06:06,220 --> 00:06:08,430
كلا نحن لا نتشاجر

98
00:06:10,800 --> 00:06:14,600
قد يكون هذا دافعاً لكي يتطوّر ريجي من قدراته

99
00:06:16,270 --> 00:06:20,310
على الأقلّ أصبح مهتمّاً بصناعة الغانبلا الآن

100
00:06:34,870 --> 00:06:36,830
!لـ-لذيذ

101
00:06:37,330 --> 00:06:40,960
لمَ الأكل اليابانيّ لذيذ لهذه الدرجة؟

102
00:06:40,960 --> 00:06:44,500
بالرغم من أنه اختصاص محلّي إلّا أنه لذيذ للغاية

103
00:06:45,250 --> 00:06:48,470
!مرحى لليابان

104
00:06:51,840 --> 00:06:53,930
!أمّي! أمّي

105
00:06:53,930 --> 00:06:55,850
!أريد أن أشتري هارو

106
00:06:55,850 --> 00:06:56,850
حسناً حسناً

107
00:07:06,650 --> 00:07:09,860
ليتني أستطيع البقاء في هذا البلد إلى الأبد

108
00:07:23,170 --> 00:07:25,540
فلتنتظر وحسب يا سي

109
00:07:25,920 --> 00:07:29,380
سوف أصنع غانبلا رائعة حتى لا تتباهى أمامي من جديد

110
00:07:30,550 --> 00:07:31,470
...لكن

111
00:07:32,180 --> 00:07:35,390
هنالك العديد منها حسب ما أرى

112
00:07:36,060 --> 00:07:39,560
كم نوعاً من الزاكّو هنالك يا ترى؟

113
00:07:42,850 --> 00:07:45,650
درع لالا سون المتنقّلة؟

114
00:07:46,400 --> 00:07:48,070
أهذا هو اسم الغانبلا؟

115
00:07:48,070 --> 00:07:50,570
هنالك قصّة بأكملها تدور حولها

116
00:07:52,070 --> 00:07:55,740
يبدو أنك تشتري الغانبلا لأوّل مرّة

117
00:07:55,740 --> 00:07:57,650
من تكون أيها العجوز؟

118
00:07:57,650 --> 00:08:01,810
أنا مجرّد معجب غانبلا يقوم بالتجوال حول العالم

119
00:08:02,580 --> 00:08:07,170
إن كنتَ تواجه مشكلة في الاختيار فبإمكاني مساعدتك

120
00:08:07,170 --> 00:08:09,420
...ماذا؟ ومن طلب منك أنـ

121
00:08:09,420 --> 00:08:10,960
دعني أرى

122
00:08:11,880 --> 00:08:13,090
إنه لا يستمع إليّ

123
00:08:18,470 --> 00:08:19,930
هذه ستكون جيّدة

124
00:08:20,850 --> 00:08:22,350
إنها غاندام المبتدئين

125
00:08:22,350 --> 00:08:26,520
الآلة الرئيسيّة لصانعي غانبلا بذلة الغاندام من نوع جي

126
00:08:26,520 --> 00:08:30,730
هذه الآلة هي أوّل غانبلا صنعها المتحكّم هارو إيري

127
00:08:30,730 --> 00:08:33,400
وهي تتميّز بتحرّكاتها المختلفة

128
00:08:33,400 --> 00:08:37,030
!إنها تملك قدرة عالية على التنقّل حتى وإن تمّ تركيبها بطريقة بسيطة

129
00:08:37,030 --> 00:08:39,240
…كما تملك قذيفة إشعاع وتسعة سيوف أشعّة

130
00:08:39,240 --> 00:08:39,870
!لا تبالغ في الأمر أيها العجوز
كما تملك قذيفة إشعاع وتسعة سيوف أشعّة...

131
00:08:39,870 --> 00:08:42,040
!لا تبالغ في الأمر أيها العجوز

132
00:08:43,210 --> 00:08:44,710
من يكون هذا الشخص؟

133
00:08:44,710 --> 00:08:47,920
...أمّا بالنسبة للفتاة التي تختلس النظر في الخلف

134
00:08:47,920 --> 00:08:48,420
ماذا؟

135
00:08:49,170 --> 00:08:50,300
بالنسبة لكِ

136
00:08:51,380 --> 00:08:53,550
فأنا أنصحك باستخدام غاندام السيطرة

137
00:08:53,760 --> 00:08:54,840
أ-أنا؟

138
00:08:55,510 --> 00:08:56,430
...أنت

139
00:08:57,510 --> 00:09:01,100
لم يسبق لي أن صنعتُ غانبلا من قبل

140
00:09:02,350 --> 00:09:04,810
!عندها سأقوم بتعليمكما

141
00:09:05,730 --> 00:09:07,520
!أترون؟ أنا أملك الأدوات اللازمة

142
00:09:12,030 --> 00:09:14,280
ما الذي تفعلينه هنا؟

143
00:09:14,280 --> 00:09:16,140
إنها مجرّد صدفة

144
00:09:16,660 --> 00:09:18,990
على أية حال، من يكون ذلك العجوز؟

145
00:09:18,990 --> 00:09:20,080
كيف لي أن أعلم؟

146
00:09:20,910 --> 00:09:22,450
!توقّفا عن الهمس

147
00:09:23,120 --> 00:09:25,370
!تجنّبا كلّ ما يمكن أن يلهيكما عن صناعة الغانبلا

148
00:09:25,870 --> 00:09:28,710
أصبحتَ شخصاً مختلفاً بالكامل

149
00:09:28,710 --> 00:09:30,790
يفترض بكما أن تقولا حاضر سيّدي

150
00:09:30,790 --> 00:09:33,130
!وإلّا فاخرصا

151
00:09:33,130 --> 00:09:35,300
!حاضر سيّدي
!حاضر سيّدي

152
00:09:35,840 --> 00:09:40,720
أوّلا، افتحا علبة الغانبلا واستخرجا ورقة التعليمات

153
00:09:42,850 --> 00:09:44,640
ولتقوما بقراءتها بتمعّن

154
00:09:45,270 --> 00:09:46,640
!لديكما دقيقة واحدة

155
00:09:46,640 --> 00:09:47,560
!هذا مستحيل

156
00:09:48,730 --> 00:09:50,520
!حاضر سيّدي

157
00:09:52,570 --> 00:09:54,650
قبل أن تبدآ، عليكما تفقّد القطع أوّلاً

158
00:09:55,070 --> 00:09:58,860
اِحرصا على أن يكون كلّ ما هو مذكور في الورقة موجوداً في العلبة

159
00:09:59,660 --> 00:10:02,200
!لا تنسيا مجموعة القطع وكذا الملصقات

160
00:10:03,490 --> 00:10:06,870
فلتبدآ التركيب حسب أوّل خطوة في ورقة التعليمات

161
00:10:08,290 --> 00:10:12,040
!فلتكونا حذرين عند استخدام الكمّاشات

162
00:10:12,880 --> 00:10:16,630
فلتقطعا البوابة بزيادة ولتقصّا الجزء الزائد بعد ذلك

163
00:10:17,300 --> 00:10:19,010
القصّ مرّتان يجعل الأمر أكثر فاعليّة

164
00:10:22,720 --> 00:10:25,810
فلتجمعا القطع التي تمّ قصّها على حسب التعليمات

165
00:10:26,730 --> 00:10:28,730
إياكما وأن تنسيا مجموعة القطع

166
00:10:29,850 --> 00:10:32,650
نزع الملصق سينقص من قوّة الإلصاق خاصته

167
00:10:33,440 --> 00:10:35,570
!اِحرصا على أن تضعاه في مكانه الصحيح

168
00:10:36,740 --> 00:10:40,730
يجدر بكما مسحه باستخدام قطعة القطن

169
00:10:43,240 --> 00:10:46,470
فلتتأكّدا من حركة الآلة أثناء صنعها

170
00:10:46,470 --> 00:10:50,990
فهمكما للغانبلا خاصتكما سيكون ذا نفعٍ لكما أثناء المعركة

171
00:10:54,880 --> 00:10:56,840
!اِنتهيتُ يا سيّدي
!اِنتهيتُ يا سيّدي

172
00:10:58,840 --> 00:11:00,130
مذهل

173
00:11:00,130 --> 00:11:02,260
لا أصدّق بأنها أوّل مرّة لكما

174
00:11:02,260 --> 00:11:04,520
إنها مصنوعة بإتقان على حسب التعليمات

175
00:11:05,430 --> 00:11:06,850
لقد قمتما بعمل رائع

176
00:11:08,140 --> 00:11:11,690
من أجل تخليد ذكرى صنعكما لأوّل غانبلا

177
00:11:11,690 --> 00:11:13,980
فلتحتفظا بالكمّاشات وكذا الورق الزجاجيّ

178
00:11:13,980 --> 00:11:16,610
لقد عاد إلى طبيعته
لقد عاد إلى طبيعته

179
00:11:16,860 --> 00:11:21,200
يمكنكما إضافة لمسة أخرى على الغانبلا

180
00:11:21,200 --> 00:11:25,220
عن طريق تحديدها باستخدام القلم وإضافة الرذاذ اللامع

181
00:11:26,200 --> 00:11:28,040
!سوف يتمّ تحويلها

182
00:11:28,450 --> 00:11:30,210
!حاضر سيّدي
!حاضر سيّدي

183
00:11:31,330 --> 00:11:33,130
حسناً، أنا ذاهب

184
00:11:33,130 --> 00:11:35,460
أرجو أن تنتبه على نفسك أيها الرئيس

185
00:11:35,460 --> 00:11:39,550
...آنسة بيكر، أرجو أن تهتميّ بذلك الأمر أثناء غيابي

186
00:11:39,550 --> 00:11:44,720
أجل، سوف أفكّر في خطّة جديدة قبل النهائيّات

187
00:11:44,720 --> 00:11:46,470
فلتفعلي ذلك رجاءً

188
00:11:53,560 --> 00:11:55,860
الرئيس ماشيتا لديه رحلة عمل

189
00:11:55,860 --> 00:12:00,990
والآن، كيف لي أن أتسلّل إلى مصنع البي بي إس إي؟

190
00:12:01,740 --> 00:12:04,990
سيكون الأمر أسرع لو قمتُ بالتقرّب من الميجين كاواغوتشي

191
00:12:04,990 --> 00:12:08,240
لكنهم سيلقون القبض عليّ إن لم أنتبه جيّداً

192
00:12:09,080 --> 00:12:10,910
!ما الذي قلته؟

193
00:12:11,460 --> 00:12:14,920
انتظر لحظة، المهمة انتهت سلفاً

194
00:12:15,830 --> 00:12:19,090
!ضميرك لا يسمح لك بذلك؟ هذا لا يهمّني

195
00:12:19,090 --> 00:12:22,510
!المهمّة ستكون دون فائدة إن تمّ عملها خارج المسابقة

196
00:12:22,510 --> 00:12:23,580
ما الذي يحدث؟

197
00:12:24,010 --> 00:12:25,430
!هذا يكفي

198
00:12:25,840 --> 00:12:27,890
!إياك وأن ينتشر هذا الخبر

199
00:12:27,890 --> 00:12:29,850
ألو؟ ألو؟

200
00:12:38,860 --> 00:12:41,780
!سيّدي! تحديد الصفيحة بالقلم قد تمّ
!سيّدي! تحديد الصفيحة بالقلم قد تمّ

201
00:12:41,780 --> 00:12:43,860
!جيّد، والآن إلى آخر مرحلة

202
00:12:43,860 --> 00:12:45,700
!حاضر سيّدي
!حاضر سيّدي

203
00:12:48,870 --> 00:12:51,540
إنه يتغيّر كليّاً عندما يتعلّق الأمر بالغانبلا

204
00:12:51,910 --> 00:12:54,160
إنه يذكّرني بشخصٍ ما

205
00:13:00,880 --> 00:13:02,880
كيف تجري الأمور يا إيوري-كن؟

206
00:13:02,880 --> 00:13:06,800
هل يمكنك إنهاء إصلاح الغانبلا قبل انقضاء هذين اليومين؟

207
00:13:07,530 --> 00:13:09,720
أجل نوعاً ما

208
00:13:10,890 --> 00:13:12,060
!لا تقلق

209
00:13:12,060 --> 00:13:15,140
!سوف أقوم بتشجيعك حتى تنهيها

210
00:13:15,140 --> 00:13:17,400
ماذا؟ ستبقين هنا إلى حين انتهائها؟

211
00:13:19,110 --> 00:13:20,400
...أنا

212
00:13:24,150 --> 00:13:29,990
سوف أحرص على أخذها إلى المنزل عندما يحلّ الظلام

213
00:13:30,780 --> 00:13:33,250
!شـ-شكراً جزيلا لك

214
00:13:46,050 --> 00:13:47,840
!مـ-مذهل

215
00:13:47,840 --> 00:13:51,640
لا أصدّق بأنها تبدو أفضل بكثير

216
00:13:51,640 --> 00:13:53,810
باستخدام التقنيّتين اللتين أخبرنا بهما ذلك العجوز

217
00:13:54,600 --> 00:13:58,900
تصبح الغانبلا أفضل بكثير كلّما أضفت إليها

218
00:13:59,860 --> 00:14:03,030
...الألوان، تغيير الأسلحة، تعديل الآلة

219
00:14:03,730 --> 00:14:05,530
إنها غير محدودة تماماً كمخيّلتك

220
00:14:05,860 --> 00:14:09,160
هذا ما يجعل الغانبلا ممتعة للغاية ويزيدها عمقاً

221
00:14:09,870 --> 00:14:12,910
!ممتاز، فلنقم بتجريبها

222
00:14:12,910 --> 00:14:15,000
هل يمكنك القتال؟

223
00:14:15,000 --> 00:14:15,660
ماذا؟

224
00:14:15,660 --> 00:14:17,160
!معركة الغانبلا

225
00:14:18,250 --> 00:14:20,880
لم يسبق لي أن قمتُ بشيءٍ كهذا

226
00:14:20,880 --> 00:14:22,880
أنا لا أعرف كيفية القيام بذلك حتّى

227
00:14:22,880 --> 00:14:25,340
حسناً لا يهمّ

228
00:14:25,960 --> 00:14:27,670
لا خيار أمامي

229
00:14:28,590 --> 00:14:29,970
لا تقلق

230
00:14:29,970 --> 00:14:32,470
نظام المعارك الذي هنا يحتوي على آلة ذاتية التحكّم

231
00:14:32,470 --> 00:14:35,770
لكي تتمكّن من اللّعب ضدّ الحاسوب

232
00:14:36,850 --> 00:14:39,560
يمكنك الاستمتاع بمعركة بمفردك

233
00:14:43,110 --> 00:14:46,280
البدء في عمليّة بلافسكي لانتشار الجزيئات

234
00:14:52,660 --> 00:14:54,950
المجال الأوّل، الفضاء

235
00:14:57,790 --> 00:14:59,120
فلتبدأ المعركة

236
00:15:01,710 --> 00:15:04,880
!ريجي، غاندام المبتدئين، فلننطلق

237
00:15:13,010 --> 00:15:16,220
ما مدى روعة الغانبلا التي قمتُ ببنائها؟

238
00:15:17,980 --> 00:15:20,390
أجل أجل، إنها مذهلة

239
00:15:20,850 --> 00:15:22,690
حتى وإن كنت تتحكّم فيها لأول مرّة

240
00:15:22,690 --> 00:15:26,650
يمكنك فعل ذلك بإتقان ما دمتَ أنت الذي صنعتها

241
00:15:26,650 --> 00:15:28,360
!معك حقّ

242
00:15:29,990 --> 00:15:32,660
فنرَ من هو خصمي

243
00:15:33,740 --> 00:15:34,580
...تلك الآلة

244
00:15:35,660 --> 00:15:36,700
لقد سبق وأن رأيتها من قبل

245
00:15:39,250 --> 00:15:40,960
إنها ضخمة

246
00:15:40,960 --> 00:15:44,040
تلك الغانبلا تمّ صنعها عن طريق إضافة مخالب إلى الجيونغ

247
00:15:44,710 --> 00:15:49,540
كيف لنظام المعارك أن يحتوي على غانبلا مصنوعة بهذا الإتقان؟

248
00:15:54,640 --> 00:15:56,060
!ماذا؟

249
00:15:58,770 --> 00:16:00,140
!لقد فُصلت الأذرع

250
00:16:00,140 --> 00:16:01,730
!إنه هجوم من كلّ الاتّجاهات

251
00:16:06,820 --> 00:16:07,940
!سحقاً

252
00:16:08,780 --> 00:16:10,990
!لا وجود لفتحة للهجوم

253
00:16:11,820 --> 00:16:12,990
!ريجي

254
00:16:12,990 --> 00:16:14,370
تبّا لك

255
00:16:14,370 --> 00:16:17,380
!...لقد عملت بجهد لصناعة هذه الغانبلا

256
00:16:18,040 --> 00:16:19,910
...لا بدّ

257
00:16:20,290 --> 00:16:24,330
لا بدّ أنّ سي شعر بنفس الشيء خلال كلّ معركة

258
00:16:24,960 --> 00:16:28,630
...وعلى غرار آلتي، فإنّ البيلد سترايك

259
00:16:29,000 --> 00:16:32,620
تستغرق أيّاماً إلى أسابيع عديدة لصنعها...

260
00:16:32,620 --> 00:16:33,800
!أمامك

261
00:16:39,930 --> 00:16:42,020
!فلتهاجمه مباشرة

262
00:16:45,850 --> 00:16:50,820
!لقد قام طيّار الغاندام أمورو ري بهزيمة الجيونغ الخاص بـتشار بتلك الطريقة تماماً

263
00:16:58,620 --> 00:17:01,540
أوه لا! لقد نسيت بأنها تملك أرجلاً كذلك

264
00:17:01,540 --> 00:17:03,000
!يا لك من كاذب

265
00:17:11,710 --> 00:17:12,300
دعم؟

266
00:17:14,050 --> 00:17:16,990
!لا يمكنني المشاهدة وحسب

267
00:17:16,990 --> 00:17:17,920
!أهذا أنتِ

268
00:17:17,920 --> 00:17:18,690
!ها هي ذي الأذرع

269
00:17:39,030 --> 00:17:40,660
...من دونها

270
00:17:40,660 --> 00:17:42,330
!...كلّ ما سيتبقّى هو

271
00:17:42,700 --> 00:17:43,950
...ذلك الجسد

272
00:17:43,950 --> 00:17:45,620
!الضّخم

273
00:18:17,070 --> 00:18:18,570
انتهت المعركة

274
00:18:20,120 --> 00:18:21,870
!أجل

275
00:18:21,870 --> 00:18:22,870
لقد نجحنا

276
00:18:23,120 --> 00:18:24,870
أنت جيّدة

277
00:18:24,870 --> 00:18:27,500
بالطبع، من تظنّني أكون؟

278
00:18:29,880 --> 00:18:33,880
ماذا؟ ظننتُ بأنه لم يسبق لك أن لعبتِ معركة غانبلا من قبل

279
00:18:33,880 --> 00:18:37,930
لـ-لقد تعلّمت عن طريق مشاهدتك وأنت تلعب

280
00:18:37,930 --> 00:18:39,970
لقد كان ذلك سهلاً للغاية

281
00:18:39,970 --> 00:18:41,220
حقّاً؟

282
00:18:41,850 --> 00:18:43,570
بالطبع

283
00:18:43,970 --> 00:18:46,850
على أية حال، إلى متى ستبقى متمسّكا بيدي هكذا؟

284
00:18:46,850 --> 00:18:48,480
!أنتِ التي أمسكتِ بها أوّلاً

285
00:18:48,480 --> 00:18:49,480
!كلّا لم أفعل ذلك

286
00:18:49,480 --> 00:18:51,060
!بلى فعلتِ

287
00:18:54,320 --> 00:18:55,320
اِنتظر لحظة

288
00:18:55,650 --> 00:18:56,360
ماذا هناك؟

289
00:18:56,780 --> 00:18:58,280
أين هو الرجل العجوز؟

290
00:18:58,280 --> 00:18:59,150
ماذا؟

291
00:18:59,860 --> 00:19:01,410
إلى أين...؟

292
00:19:05,950 --> 00:19:08,860
لقد عرفتُ الأمر بمجرّد نظري إلى ذلك الجيونغ

293
00:19:08,860 --> 00:19:11,790
لم أعتقد بأنّني سألتقي بك هنا

294
00:19:14,290 --> 00:19:17,800
أحياناً يكون مالكاً لمتجر نماذج في رواق خلفيّ

295
00:19:17,800 --> 00:19:20,380
وأحيانا يكون مُعجب غانبلا

296
00:19:20,380 --> 00:19:23,470
يسافر حول العالم لترويجها

297
00:19:23,850 --> 00:19:25,760
...لكنّ هيأته الحقيقيّة هي

298
00:19:29,810 --> 00:19:33,020
!الحكم الرئيسيّ لمعارك الغانبلا العالميّة، إيوري تاكيشي

299
00:19:33,900 --> 00:19:35,860
مافيا الغانبلا سي

300
00:19:35,860 --> 00:19:39,480
...أنت رهن الاعتقال بسبب 36 جريمة من بينها

301
00:19:39,480 --> 00:19:43,030
!المشاركة غير القانونيّة في مسابقة غانبلا رسميّة والتحكّم غير المشروع في الغانبلا...

302
00:19:56,210 --> 00:19:59,590
إيّاك وأن تستخدم الغانبلا في أعمال سيّئة

303
00:20:02,510 --> 00:20:04,180
!ماذا؟
!ماذا؟

304
00:20:04,180 --> 00:20:07,720
قمتَ بصناعة غاندام المبتدئين هذه بمفردك؟

305
00:20:07,720 --> 00:20:12,850
ما رأيك؟ أخبرتك بأنّ صنعها سهلٌ للغاية

306
00:20:15,020 --> 00:20:17,020
لم يقم بتركيبها وحسب

307
00:20:17,020 --> 00:20:21,570
لقد قام برسم خطوط الصفائح واستخدم رذاذاً لامعاً كذلك

308
00:20:21,570 --> 00:20:23,140
أمر رائع

309
00:20:24,280 --> 00:20:26,670
هل صنعتها بمفردك فعلاً؟

310
00:20:27,870 --> 00:20:31,580
حسناً لقد تلقّيتُ بعض المساعدة

311
00:20:31,580 --> 00:20:33,120
من قام بمساعدتك؟

312
00:20:33,120 --> 00:20:36,130
رجل عجوز بدا كشخصٍ هادئ

313
00:20:36,130 --> 00:20:38,880
لكنه تحوّل إلى شخص صارم أثناء صناعة الغانبلا

314
00:20:38,880 --> 00:20:41,760
!كما أنه أعطاني هذه

315
00:20:43,590 --> 00:20:45,720
!...تلك الكمّاشات

316
00:20:45,720 --> 00:20:46,510
ما بها؟

317
00:20:48,440 --> 00:20:50,850
كلّا، لا شيء

318
00:20:54,190 --> 00:20:55,480
...أبي

319
00:20:59,020 --> 00:21:00,780
أنا آسف يا سي

320
00:21:00,780 --> 00:21:04,700
...ما زلتُ أجوب العالم متخفّياً لكن

321
00:21:04,700 --> 00:21:06,700
كنتُ أشاهدك على التلفاز...

322
00:21:06,950 --> 00:21:08,870
لقد أصبحت صانع غانبلا متميزاً

323
00:21:08,870 --> 00:21:10,870
حظّاً موفقّاً لك في نهائيات المسابقة

324
00:21:11,290 --> 00:21:12,080
سي...

325
00:21:21,010 --> 00:21:22,960
سوف أبذل قصارى جهدي يا أبي

326
00:21:23,840 --> 00:21:27,760
باستخدام البيلد سترايك التي صنعتُها ورفقة ريجي

327
00:21:43,790 --> 00:21:46,700
كنتُ آكل رقائق البطاطس عندما داهمتني الفكرة فجأة

328
00:21:46,700 --> 00:21:49,830
فلتتمسّك بأيامك الغالية

329
00:21:49,830 --> 00:21:53,990
كم مضت من سنة وأنا آكل نفس الطعام؟

330
00:21:53,990 --> 00:21:55,370
فلتواجه مخاوفك

331
00:21:55,790 --> 00:21:58,830
يطلب منّي الناس بأن أتصرّف على حسب سنّي

332
00:21:58,830 --> 00:22:01,790
أفعل ما أشاء على طريقتي

333
00:22:01,790 --> 00:22:06,080
لكن لا يمكنني أن أدير ظهري للأشياء التي أحبها

334
00:22:06,080 --> 00:22:07,370
حياة عاديّة

335
00:22:07,370 --> 00:22:12,120
أصرف كلّ طاقتي على أشياء طفوليّة

336
00:22:12,120 --> 00:22:15,700
لا يهمّ إن كنتَ صغيراً أو كبيراً في العمر

337
00:22:15,700 --> 00:22:18,910
يمكنك أن تنسى نفسك وأنت تقوم بشيءٍ تحبّه

338
00:22:18,910 --> 00:22:24,990
فلنواصل المشي على نفس الإيقاع

339
00:22:24,990 --> 00:22:30,950
صحيح أنّ خطواتنا أصبحت أبطأ بقليل

340
00:22:30,950 --> 00:22:36,990
غروب شمس ذلك اليوم يلوّن سماء أيّامنا هذه

341
00:22:36,990 --> 00:22:40,120
أريد أن أكون شخصاً غبيّاً في الغد

342
00:22:40,120 --> 00:22:43,330
وحتى بعد خمسين سنة من الآن

343
00:22:43,330 --> 00:22:46,000
روح السراويل القصيرة ستبقى قائمة

344
00:22:46,000 --> 00:22:50,870
فلنقم بتصفير نغمة في طريقنا إلى البيت

345
00:22:50,870 --> 00:22:53,660
روح السراويل القصيرة التي لن تنتهي

346
00:22:53,660 --> 00:22:57,580
ستظلّ طفولتنا خالدة إلى الأبد

347
00:23:02,990 --> 00:23:04,780
!سي! ريجي

348
00:23:04,990 --> 00:23:07,540
!مبارك لكما التأهّل إلى النهائيات

349
00:23:07,540 --> 00:23:09,580
!لقد أتيتُ لتشجيعكما

350
00:23:09,870 --> 00:23:11,320
شكراً لك يا والدة سي

351
00:23:11,330 --> 00:23:13,950
لكن ماذا بخصوص المحلّ يا أمّي؟

352
00:23:13,990 --> 00:23:16,160
لقد أغلقته لبعض الوقت

353
00:23:16,160 --> 00:23:18,250
لكن ماذا عن المبيعات؟

354
00:23:18,250 --> 00:23:19,870
لا تقلق

355
00:23:19,870 --> 00:23:20,990
...لـ-لكن

356
00:23:20,990 --> 00:23:23,040
دعك من ذلك، والدتك هنا الآن

357
00:23:23,040 --> 00:23:25,590
...أعلم ذلك لكن

358
00:23:26,290 --> 00:23:27,800
!أمّي؟

359
00:23:28,330 --> 00:23:29,250
نعم؟

360
00:23:30,600 --> 00:23:33,390
...في الحقيقة... أبي كان

361
00:23:31,470 --> 00:23:33,800
نماذج إيوري

362
00:23:34,750 --> 00:23:38,600
...أخيراً أتيتُ إلى طوكيو من أجل رؤيتك

363
00:23:39,760 --> 00:23:41,370
لمَ المحلّ مقفل؟

364
00:23:41,370 --> 00:23:44,580
!اليوم ليس يوم عطلة أليس كذلك؟ لذا لمَ هو مقفل؟

365
00:23:44,580 --> 00:23:46,990
هل أنتِ غاضبة منّي لأنني غبتُ لفترة طويلة؟

366
00:23:46,990 --> 00:23:49,210
!اِفتحي المحلّ يا رين-تشان

367
00:23:49,210 --> 00:23:50,650
!رين-تشان

368
00:23:50,990 --> 00:23:54,330
!أنا أحبّك يا رين-تشان

