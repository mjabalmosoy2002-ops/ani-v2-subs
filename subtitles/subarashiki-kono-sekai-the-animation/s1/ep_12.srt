1
00:00:04,370 --> 00:00:07,040
!نيكو ساكورابا

2
00:00:07,040 --> 00:00:10,260
.لا أكاد أصدق بأن الشخص المختار هو أنت

3
00:00:16,010 --> 00:00:17,470
!ما الذي تعنيه؟

4
00:00:20,680 --> 00:00:23,520
.لا داعي للشرح

5
00:00:31,570 --> 00:00:33,450
.اختفي الآن

6
00:00:43,790 --> 00:00:45,290
!ماذا؟

7
00:00:45,290 --> 00:00:48,130
!كيف تجرؤ على نسيان أمرنا

8
00:00:52,630 --> 00:00:54,220
ألم أخبرك؟

9
00:00:54,220 --> 00:00:57,220
!أنا من سيكون الملحن التالي

10
00:01:05,140 --> 00:01:08,900
.لا تحاول القتال وحدك

11
00:01:08,900 --> 00:01:10,980
.نحن هنا إلى جانبك

12
00:01:16,280 --> 00:01:18,110
.يكاد وقتي ينفد

13
00:01:22,910 --> 00:01:23,950
.نيكو

14
00:01:32,590 --> 00:01:33,800
!حسنا

15
00:01:41,260 --> 00:01:43,060
!سأقضي عليكم

16
00:01:45,770 --> 00:01:48,060
!هيا يا سيد مياو

17
00:01:59,450 --> 00:02:02,620
!لدي هجمة مصممة خصيصا لك

18
00:02:07,370 --> 00:02:10,330
!لن أخسر أمام أمثالكم

19
00:02:25,350 --> 00:02:27,640
!خذ هذا

20
00:02:40,820 --> 00:02:42,570
.أيقظوا حواسكم

21
00:02:42,570 --> 00:02:43,780
!حسنا--
!لك ذلك--

22
00:03:31,710 --> 00:03:36,170
ألست قادرا على... حماية... شيبويا؟

23
00:03:46,640 --> 00:03:48,640
.لقد فزنا بالتأكيد هذه المرة

24
00:03:48,640 --> 00:03:50,810
.لم ينته الأمر بعد

25
00:03:54,480 --> 00:03:56,400
.هيا نلتقى بالملحن

26
00:04:09,240 --> 00:04:11,120
ذلك العالم الرائع"
"نسخة الأنيمي

27
00:05:32,200 --> 00:05:34,450
"الحلقة الأخيرة: إنه عالم رائع"

28
00:05:34,450 --> 00:05:36,120
"الحلقة الأخيرة: إنه عالم رائع"
.مذهل

29
00:05:36,960 --> 00:05:39,290
.هذه الجداريات

30
00:05:39,290 --> 00:05:40,500
.إنها للقط

31
00:05:41,630 --> 00:05:43,880
هل رسمها كلها؟

32
00:05:43,880 --> 00:05:45,090
.نعم صحيح

33
00:05:48,720 --> 00:05:50,390
...لطالما

34
00:05:57,350 --> 00:06:02,570
لذلك كنت دائما أذهب إلى ذلك المكان
.لرؤية جدارياتك

35
00:06:02,570 --> 00:06:06,780
.كنت أستمتع كثيرا لمجرد رؤيتها

36
00:06:06,780 --> 00:06:11,120
ظننت أنني أخيرا التقيت
.بشخص أرى فيه مثلي الأعلى

37
00:06:11,120 --> 00:06:13,080
...إذاً

38
00:06:13,080 --> 00:06:14,290
لماذا...؟

39
00:06:17,790 --> 00:06:20,460
.لكن وقت التردد انتهى

40
00:06:23,250 --> 00:06:25,920
!أعرف أنك هنا يا سيد هانيكوما

41
00:06:27,170 --> 00:06:29,510
!اخرج إلى هنا أيها الملحن

42
00:06:34,470 --> 00:06:37,230
.لم أرك منذ مدة يا نيكو

43
00:06:37,230 --> 00:06:39,270
!جوشوا؟

44
00:06:39,270 --> 00:06:41,730
هل هذا أنت حقا؟

45
00:06:41,730 --> 00:06:43,940
.نعم صحيح

46
00:06:43,940 --> 00:06:47,070
.يبدو أنك بذلت جهدا كبيرا

47
00:06:47,070 --> 00:06:49,400
.ظننت أنك مت

48
00:06:49,400 --> 00:06:52,870
تمكنت من بلوغ هذه المرحلة
.لأنك قمت بحمايتي

49
00:06:54,700 --> 00:06:55,910
.شكرا لك

50
00:06:59,830 --> 00:07:03,840
.أشكرك أيضا، بفضلك تمكنت من الفوز في هذه اللعبة

51
00:07:03,840 --> 00:07:08,050
!أجل. لقد فزنا في لعبة حاصدي الأرواح

52
00:07:08,050 --> 00:07:09,300
.أنت مخطئ

53
00:07:09,300 --> 00:07:10,630
ماذا؟

54
00:07:10,630 --> 00:07:14,050
.لم نكن نلعب لعبة حاصدي الأرواح

55
00:07:15,140 --> 00:07:17,310
ماذا؟

56
00:07:17,310 --> 00:07:19,430
هل سيبدو الأمر أكثر وضوحا إن أخبرتك

57
00:07:19,430 --> 00:07:23,230
أنني وميغومي كنا نلعب لعبة
من أجل مصير شيبويا؟

58
00:07:24,940 --> 00:07:28,490
.أتدري، أنا هو ملحن شيبويا

59
00:07:38,580 --> 00:07:43,000
.شيبويا غارقة في الرغبات الأنانية
.لقد قررت إنهاءها

60
00:07:43,000 --> 00:07:44,580
!تنهي شيبويا؟

61
00:07:44,580 --> 00:07:46,380
!لكن لماذا يا سيدي الملحن؟

62
00:07:46,380 --> 00:07:49,380
.لأنني قررت التخلي عن شيبويا

63
00:07:49,380 --> 00:07:51,880
.لذا قررت محوها

64
00:07:51,880 --> 00:07:53,430
!تمهل رجاء يا سيدي

65
00:07:53,430 --> 00:07:56,850
!ما تزال أمام شيبويا الكثير من الفرص

66
00:07:56,850 --> 00:08:02,480
.لكن سكانها غافلون لأن حواسهم ضعفت كثيرا

67
00:08:02,480 --> 00:08:04,940
.لدى شيبويا تأثير قوي

68
00:08:04,940 --> 00:08:08,690
علي أن أتصرف قبل أن يتسرب
.التأثير إلى المناطق الأخرى

69
00:08:08,690 --> 00:08:11,400
!أقسم أنني سأصلح شيبويا

70
00:08:11,400 --> 00:08:12,820
كيف ذلك؟

71
00:08:13,990 --> 00:08:17,490
!سأجد طريقة ما. لذا أرجوك

72
00:08:17,490 --> 00:08:21,410
!امنحني فرصة لإنقاذ شيبويا

73
00:08:21,410 --> 00:08:23,710
.لنلعب لعبة

74
00:08:23,710 --> 00:08:24,920
لعبة يا سيدي؟

75
00:08:24,920 --> 00:08:27,790
.أجل. لعبة بيننا

76
00:08:27,790 --> 00:08:29,210
.قوانينها بسيطة

77
00:08:29,210 --> 00:08:31,970
.تفوز يا ميغومي إن تمكنت من إصلاح شيبويا

78
00:08:31,970 --> 00:08:34,180
.تبقى شيبويا

79
00:08:34,180 --> 00:08:36,050
ماذا إن فشلت؟

80
00:08:36,050 --> 00:08:37,430
.أفوز

81
00:08:37,430 --> 00:08:40,560
.سأمحوك أنت وشيبويا

82
00:08:42,100 --> 00:08:44,940
.أمامك شهر

83
00:08:44,940 --> 00:08:48,690
.لا يهمني كيف ستستغله. حظا موفقا

84
00:08:53,990 --> 00:08:57,740
!أجاد أنت؟ أنت هو الملحن؟

85
00:08:57,740 --> 00:09:02,330
.أثارت طريقة "إصلاحه" لشيبويا فضولي قليلا

86
00:09:02,330 --> 00:09:03,580
!أيها الوغد

87
00:09:05,250 --> 00:09:07,880
!كف عن الثرثرة

88
00:09:10,250 --> 00:09:11,460
!ماذا؟

89
00:09:15,630 --> 00:09:19,100
!تبا! ما الذي فعلته؟

90
00:09:20,720 --> 00:09:23,930
آسف، لكن هل لي أن أطلب منك عدم التدخل في هذا؟

91
00:09:29,730 --> 00:09:32,190
!شيكي؟! بيت؟

92
00:09:32,190 --> 00:09:34,110
!ما الذي يحدث؟

93
00:09:35,110 --> 00:09:37,950
!لا أستطيع التحرك

94
00:09:37,950 --> 00:09:39,030
!--أيها ال

95
00:09:39,030 --> 00:09:42,990
.لن أضر بأصدقائك الأعزاء

96
00:09:42,990 --> 00:09:44,790
...بالرغم من ذلك--
!ما الذي فعلته يا هذا؟--

97
00:09:44,790 --> 00:09:46,870
.إنهم مزعجون قليلا

98
00:09:51,380 --> 00:09:56,300
بصفتي الملحن، كانت قوتي أكبر بشكل غير عادل
.من قوة ميغومي فيما يتعلق باللعبة

99
00:09:56,300 --> 00:10:02,010
لذا قمت بكبت قواي الطبيعية
.وراقبت العالم السفلي من العالم الحقيقي

100
00:10:02,010 --> 00:10:05,140
.قررت إرسال شخص يلعب بدلا عني

101
00:10:05,140 --> 00:10:09,150
.بديل واحد من العالم الحقيقي

102
00:10:09,150 --> 00:10:10,860
...مستحيل

103
00:10:10,860 --> 00:10:14,730
.أجل يا نيكو: إنه أنت

104
00:10:14,730 --> 00:10:18,700
...إذاً كل ما... كل ما فعلته كان

105
00:10:18,700 --> 00:10:23,120
.مساعدتي على محو شيبويا

106
00:10:25,580 --> 00:10:29,210
أنت الذي هزم ميناميموتو أيضا؟

107
00:10:29,210 --> 00:10:35,170
.معركتك مع ميغومي كانت مقدسة
.لم أرد السماح له بالتدخل

108
00:10:35,170 --> 00:10:39,470
من جهة أخرى فقد وقف في طريق حين
.أردت الترحيب بك

109
00:10:39,470 --> 00:10:40,760
ما الذي...؟

110
00:10:42,180 --> 00:10:44,510
،كمكافأة لك على فوزك في اللعبة

111
00:10:44,510 --> 00:10:48,690
.سأعيد لك آخر قطعة مفقودة من ذكرياتك
،كنت أحتفظ بها

112
00:10:48,690 --> 00:10:50,150
.يا نيكو

113
00:12:07,430 --> 00:12:09,140
!أنت الفاعل

114
00:12:09,140 --> 00:12:11,560
!أنت قتلتني

115
00:12:11,560 --> 00:12:13,230
.أجل فعلت

116
00:12:13,230 --> 00:12:19,190
كنت ألوم نفسي طوال الوقت
.على عدم وثوقي بك

117
00:12:19,190 --> 00:12:21,990
!جعلت الأمر يبدو وكأن ميناميموتو هو الفاعل

118
00:12:21,990 --> 00:12:25,870
.لقد كان يسعى لينصب نفسه الملحن

119
00:12:25,870 --> 00:12:30,120
.ظن نفسه قادرا على قتلي في العالم الحقيقي

120
00:12:30,120 --> 00:12:32,540
.لكن من البديهي أنه أساء الحساب

121
00:12:36,170 --> 00:12:42,510
فبعكس حاصدي الأرواح، يستطيع الملحن
.استخدام بعض من قوته في العالم الحقيقي

122
00:12:43,880 --> 00:12:46,390
،بعد فراره إلى العالم السفلي

123
00:12:46,390 --> 00:12:50,850
حول نفسه إلى النمط المحرم بغية
.تقليص فارق القوى بيننا

124
00:12:55,520 --> 00:12:59,820
.يجدر بي عقاب السيد هانيكوما أيضا
.لم يكن ينبغي عليه التدخل

125
00:13:01,860 --> 00:13:04,240
هل أعجبتك هذه الغرفة؟

126
00:13:04,240 --> 00:13:06,410
ما الذي تعنيه؟

127
00:13:06,410 --> 00:13:09,280
.لنلعب لعبة

128
00:13:09,280 --> 00:13:15,250
.يصبح الفائز ملحنا ويفعل ما يحلو له بشيبويا

129
00:13:15,250 --> 00:13:20,050
.إن فزت يا نيكو، ستستطيع بناء شيبويا كما تحب وترضى

130
00:13:20,050 --> 00:13:24,720
.حتى أنه بإمكانك إعادة أصدقائك إلى الحياة
عرض جيد أليس كذلك؟

131
00:13:24,720 --> 00:13:29,220
.نضغط على الزناد حين ينتهي العداد
.هذا كل ما في الأمر

132
00:13:29,220 --> 00:13:30,510
أمر بسيط، أليس كذلك؟

133
00:13:34,430 --> 00:13:36,980
.كف عن المزاح

134
00:13:36,980 --> 00:13:39,270
.أنا لا أمزح

135
00:13:39,270 --> 00:13:43,530
قد يفاجؤك الأمر، لكن مفترقات طرق الحياة
.هي بهذه البساطة

136
00:13:44,900 --> 00:13:46,110
.عشرة

137
00:13:47,570 --> 00:13:48,780
.تسعة

138
00:13:50,450 --> 00:13:51,660
.ثمانية

139
00:13:52,990 --> 00:13:54,200
.سبعة

140
00:13:58,040 --> 00:13:59,250
.ستة

141
00:14:00,210 --> 00:14:01,340
...سوف

142
00:14:01,340 --> 00:14:02,550
.خمسة

143
00:14:04,670 --> 00:14:06,050
.أربعة

144
00:14:06,050 --> 00:14:09,140
.ثق بشريكك

145
00:14:09,140 --> 00:14:11,050
.ثلاثة

146
00:14:11,050 --> 00:14:16,230
.وصلت إلى هذا المستوى بفضل ثقتي بأصدقائي

147
00:14:16,230 --> 00:14:17,480
.اثنان

148
00:14:21,110 --> 00:14:22,320
.واحد

149
00:14:26,570 --> 00:14:29,570
.سوف... أثق بك

150
00:15:06,360 --> 00:15:09,530
!ماذا؟ ماذا يجري؟

151
00:15:09,530 --> 00:15:11,990
هل هذه شيبويا؟

152
00:15:13,410 --> 00:15:14,740
.عذرا، أنا آسف

153
00:15:24,920 --> 00:15:29,300
.ما تزال شيبويا هنا، وأنا كذلك

154
00:15:32,720 --> 00:15:35,640
هل عدت للحياة؟

155
00:15:47,820 --> 00:15:50,200
!مرحبا

156
00:15:50,200 --> 00:15:51,950
!إننا هنا

157
00:15:54,450 --> 00:15:56,870
!بيت! رايم

158
00:15:56,870 --> 00:15:58,870
ما الذي أخرك؟

159
00:15:58,870 --> 00:16:01,750
.كدت أظن أنك نسيت موعدنا

160
00:16:01,750 --> 00:16:04,960
.انتظرك أخي طوال الوقت

161
00:16:04,960 --> 00:16:07,250
!لم أكن أنتظر

162
00:16:07,250 --> 00:16:09,670
!عدتما للحياة أيضا

163
00:16:09,670 --> 00:16:12,880
.أجل. لكن لا أعرف كيف

164
00:16:12,880 --> 00:16:16,680
.أنا متأكدة أن هذا بفضلك أنت ونيكو وشيكي

165
00:16:18,390 --> 00:16:19,810
أين هي شيكي؟

166
00:16:33,030 --> 00:16:35,780
.أدعى نيكو ساكورابا

167
00:16:35,780 --> 00:16:37,660
.نادني نيكو

168
00:16:37,660 --> 00:16:41,080
.أدعى شيكي ميساكي. نادني شيكي

169
00:16:42,370 --> 00:16:43,670
.شيكي

170
00:16:45,210 --> 00:16:48,130
.تمكنا من رؤية بعضنا مجددا يا نيكو

171
00:16:53,130 --> 00:16:56,550
.لقد عاد كل شيء إلى حالته الطبيعية في الوقت الحاضر

172
00:16:56,550 --> 00:17:00,930
.ستسبب هذه الفوضى مشاكل مع رؤسائنا

173
00:17:00,930 --> 00:17:07,520
.فالسماح لكيتانيجي بتسيير اللعبة بصفته حاصد أرواح هو أمر غير مسبوق

174
00:17:07,520 --> 00:17:14,070
.أنت أيضا قمت بكبت قواك من أجل أن تقاتل إلى جانب نيكو

175
00:17:14,070 --> 00:17:16,240
.كانت تلك صدمة أخرى

176
00:17:17,450 --> 00:17:19,740
ألم يكن الأمر مخاطرة كبيرة؟

177
00:17:19,740 --> 00:17:25,580
عرف ميناميموتو هويتك الحقيقية
وتعقبك إلى العالم الحقيقي، أليس كذلك؟

178
00:17:25,580 --> 00:17:30,420
.أنا الملحن. لا وجود لحاصد أرواح يستطيع القضاء علي

179
00:17:30,420 --> 00:17:37,720
.لكن ميناميموتو كان يعلم هيأتي في العالم الحقيقي
.حتى ميغومي لم يكن يعلم

180
00:17:37,720 --> 00:17:40,890
لم تخبره أليس كذلك؟

181
00:17:44,850 --> 00:17:47,480
ما الذي يجعلك تظن ذلك؟

182
00:17:47,480 --> 00:17:51,110
.أنت أيضا أردت الحفاظ على شيبويا

183
00:17:51,110 --> 00:17:52,820
.شارات الجمجمة الحمراء

184
00:17:52,820 --> 00:17:54,940
.ماذا

185
00:17:54,940 --> 00:17:59,280
.طلب منك ميغومي أن تصنعها له

186
00:17:59,280 --> 00:18:02,990
.نعم. كان ذلك طلبا من نائب الملحن

187
00:18:02,990 --> 00:18:05,710
.لذا لم أخالف أي قانون

188
00:18:05,710 --> 00:18:10,170
.صممت هذه الشارات لدمغ إرادة كيتانيجي على الناس

189
00:18:11,630 --> 00:18:17,930
كانت فكرة جيدة، لكنه كان يستطيع فقط إجراء
.الدمغ على من يضعون الشارة

190
00:18:17,930 --> 00:18:24,600
لذلك استغل كيتانيجي المهمات كغطاء
.لتوزيع شارات الجمجمة الحمراء

191
00:18:24,600 --> 00:18:26,850
.هذا ما يسمى بسوء استغلال السلطة

192
00:18:28,980 --> 00:18:34,150
.صحيح، سمعت أن هناك جداريات جديدة في أوداغاوا

193
00:18:34,150 --> 00:18:36,400
.يقولون أنها ظهرت بين ليلة وضحاها

194
00:18:36,400 --> 00:18:38,320
.الجميع يتحدثون عنها

195
00:18:38,320 --> 00:18:39,910
.إنه السيد هانيكوما

196
00:18:41,740 --> 00:18:43,870
ما سر الابتسامة العريضة؟

197
00:18:43,870 --> 00:18:45,700
.أنا لم أبتسم

198
00:18:45,700 --> 00:18:48,530
أنت متشوق لتذهب لإلقاء نظرة، أليس كذلك؟--

199
00:18:46,040 --> 00:18:50,440
.هنالك غاية لرسمي للجداريات في أرجاء شيبويا--

200
00:18:49,290 --> 00:18:50,440
.الأمر كذلك--

201
00:18:51,290 --> 00:18:55,010
.رؤية الجداريات ليس أمرا مخصصا للأقلية المختارة

202
00:18:55,010 --> 00:18:59,430
.تخول لي إجراء دمغ لكل شخص يلمسها

203
00:19:01,550 --> 00:19:06,600
.زرعت في كل جدارياتي رمزا لأمر معين

204
00:19:06,600 --> 00:19:10,190
ابذل ما في وسعك للاستمتاع بكل لحظة"؟"

205
00:19:10,190 --> 00:19:12,150
.أنا مندهش لكونك عرفتها

206
00:19:12,150 --> 00:19:15,690
.كان نيكو مسرورا بإخباري بذلك

207
00:19:15,690 --> 00:19:18,610
.إنه أكثر شخص أثرت به

208
00:19:19,650 --> 00:19:22,780
لماذا لم تقم بمحو شيبويا؟

209
00:19:23,910 --> 00:19:26,240
.بسبب نيكو

210
00:19:26,240 --> 00:19:28,160
،اختار إغلاق أذنيه

211
00:19:28,160 --> 00:19:32,790
.وعدم الثقة بأي شيء يقال له، وكذلك العيش وحيدا

212
00:19:32,790 --> 00:19:36,000
.لكنه وثق بي ورمى مسدسه

213
00:19:36,000 --> 00:19:39,720
.هذا كل ما في الأمر

214
00:19:39,720 --> 00:19:44,550
لقد تغير جذريا خلال جولاته الثلاث
.في لعبة حاصدي الأرواح

215
00:19:44,550 --> 00:19:46,680
.إنها معجزة صغيرة

216
00:19:52,100 --> 00:19:57,570
ومع ذلك، كيف استطعنا القيام بهجمة حاسمة كتلك؟

217
00:19:57,570 --> 00:20:03,240
--أحسست أن السيد هانيكوما
.أن القط--كان يشجعنا

218
00:20:03,240 --> 00:20:05,910
...تلك الشارة ورسالته

219
00:20:05,910 --> 00:20:08,620
لم تكن شارة مفتاح، أليس كذلك؟

220
00:20:08,620 --> 00:20:10,580
هل كان ذلك عادلا؟

221
00:20:10,580 --> 00:20:14,210
مهلا، أعطيته شارة مميزة
.على أنها شارة لاعب

222
00:20:14,210 --> 00:20:17,380
.من أجل حمايته من تأثير كيتانيجي

223
00:20:17,380 --> 00:20:19,510
.في رأيي نحن متعادلان

224
00:20:19,510 --> 00:20:21,550
،سأتغاضى عن ذلك

225
00:20:21,550 --> 00:20:26,720
لكن في المقابل، هل لي أن أعرف سبب
عبثك بمولد ميناميموتو؟

226
00:20:26,720 --> 00:20:31,180
.عقدت آمالا كبيرة في مسألة تعلق ميناميموتو بشيبويا

227
00:20:31,180 --> 00:20:36,650
.كان وسيلة لنجاة شيبويا بعد خسارة كيتانيجي

228
00:20:37,730 --> 00:20:43,320
كنت تريده أن يهزمني ليصبح الملحن الجديد؟

229
00:20:43,320 --> 00:20:46,240
.أنا على تمام الاستعداد لتلقي عقابي

230
00:20:46,240 --> 00:20:47,490
.بالطبع

231
00:20:47,490 --> 00:20:52,500
،ولكن، حفزت كلماتك التحول الذي طرأ بنيكو

232
00:20:56,670 --> 00:20:58,590
مر وقت طويل، أليس كذلك؟--
مثلما حصل مع ميغومي--
،عند إطلاقي للعبة حاصدي الأرواح

233
00:20:58,590 --> 00:21:00,170
مثلما حصل مع ميغومي--
،عند إطلاقي للعبة حاصدي الأرواح

234
00:21:00,170 --> 00:21:00,670
!نيكي--
مثلما حصل مع ميغومي--
،عند إطلاقي للعبة حاصدي الأرواح

235
00:21:00,670 --> 00:21:02,260
!نيكي--
،تحويلك لميناميموتو إلى النمط المحرم--
.بالرغم من خطر الفشل

236
00:21:02,260 --> 00:21:04,880
،تحويلك لميناميموتو إلى النمط المحرم--
.بالرغم من خطر الفشل

237
00:21:04,880 --> 00:21:05,220
!مرحبا--
،تحويلك لميناميموتو إلى النمط المحرم--
.بالرغم من خطر الفشل

238
00:21:05,220 --> 00:21:05,890
!مرحبا--
.ولقاء نيكو بلاعبين آخرين--

239
00:21:05,890 --> 00:21:07,220
!أنتما--
.ولقاء نيكو بلاعبين آخرين--

240
00:21:07,220 --> 00:21:08,810
!عدتما للحياة--
.ولقاء نيكو بلاعبين آخرين--

241
00:21:08,810 --> 00:21:10,890
.وأخيرا! كنت متشوقة لتناولها--
.ولقاء نيكو بلاعبين آخرين--

242
00:21:10,890 --> 00:21:13,940
.وأخيرا! كنت متشوقة لتناولها--
.ربما هذا يعني أن كل ذلك كان ضروريا

243
00:21:15,190 --> 00:21:16,190
!تبدون متحمسين اليوم--

244
00:21:16,190 --> 00:21:17,440
.ربما--
!تبدون متحمسين اليوم--

245
00:21:17,440 --> 00:21:20,860
!تابعوا معي! هيا لنستمتع

246
00:21:22,900 --> 00:21:28,660
.لقد أثبتوا أن لا شيء يحدث عبثا في هذا العالم

247
00:21:33,290 --> 00:21:36,330
لذا، "استمتع بكل لحظة"؟

248
00:21:38,000 --> 00:21:41,420
.ما الأمر؟ تبدو كأنك تحس بالوحدة

249
00:21:44,630 --> 00:21:47,800
.غير معقول. إنه دائما يتظاهر

250
00:21:52,520 --> 00:21:56,190
إنه عالم رائع، أليس كذلك؟