1
00:00:33,450 --> 00:00:36,000
‫‫أَرْجُوكَ ٱِبْتَعَد عَن طَرِيقِي !

2
00:00:39,000 --> 00:00:43,450
‫‫هَل آنَت راضً عَن هٰذِهِ المَدِينَة القَذِرَة ؟

3
00:02:48,750 --> 00:02:51,000
‫‫أَنَت فَظِيع !

4
00:02:51,000 --> 00:02:54,290
‫‫الآن يَجُبّ أَنَّ أُنَظِّف كُلّ شَيْء مَرَّة أُخْرى !

5
00:03:12,160 --> 00:03:13,290
‫‫إتبعية

6
00:03:13,290 --> 00:03:14,700
‫‫أُعْرَف

7
00:03:48,750 --> 00:03:51,160
‫‫مرحبآ , آنِسَتَيْيَ

8
00:03:51,160 --> 00:03:55,750
‫‫إِنَّهُ أَمَّرَ خَطِير التَجَوُّل هُنا لِوَحْدكِ

9
00:04:06,700 --> 00:04:09,540
‫‫شُكْراً لَكِ أَيّها الضابِطَة

10
00:04:09,540 --> 00:04:12,750
‫‫لَقَدّ مَرَرتِ بِعَناء لَعُبُور الجِسْر

11
00:04:12,750 --> 00:04:15,410
‫‫لَقَدّ تَمَّ ٱِسْتِدْعائَيْيَ إِلَى المَقَرّ

12
00:04:15,410 --> 00:04:18,200
‫‫أُعْرَف مِن كَآن الجانِي

13
00:04:19,540 --> 00:04:21,370
‫‫أَتِركَ الأَمَرّ لَنا !

14
00:04:21,370 --> 00:04:23,200
‫‫الشَرْطَة لَيِستَ جَيِّدَة

15
00:04:23,200 --> 00:04:26,040
‫‫أَنَتِ تُعَرِّفِ ذُلّكِ جَيِّداً

16
00:04:26,040 --> 00:04:29,120
‫‫لا يُوجِد أَحَدَّ يُمَكِّنكَ الٱِعْتِماد عَلِيّهُ .

17
00:04:29,120 --> 00:04:32,120
‫‫سَوَّفَ أَنْتَقِم لَوالِدِيّ بِنَفْسِي

18
00:04:32,120 --> 00:04:34,450
‫‫ماذا تُخَطِّط أَنَّ تَفْعَل ؟

19
00:04:34,450 --> 00:04:37,580
‫‫أَنا أَتَحَدَّث عَن عَدَونا الحَقِيقِيّ

20
00:04:37,580 --> 00:04:39,580
‫‫مَجْلِس الغُيَّب

21
00:04:54,790 --> 00:04:56,910
‫‫مَرْحَباً يا (بيلو)

22
00:05:04,870 --> 00:05:07,790
‫‫إِنَّهُ دائِماً قَرِيب , دائمآ.

23
00:05:07,790 --> 00:05:11,330
‫‫إِذَن يَجُبّ أَنَّ يَأْتِي وَيَنْضَمّ إِلَينا

24
00:05:11,330 --> 00:05:13,450
‫‫أتسائل ماذا حَدَث لَهُ

25
00:05:13,450 --> 00:05:15,660
‫‫يَجُبّ أَنَّ يَخْبُرنا فَقَطَّ

26
00:05:15,660 --> 00:05:17,290
‫‫يَجُبّ أَنَّ نَذْهَب لِنَسْأَلهُ

27
00:05:18,580 --> 00:05:20,250
‫‫مِن الصَعْب أَنَّ نَسْأَلهُ

28
00:05:20,250 --> 00:05:22,950
‫‫إِنَّهُ يُعْطِي شُعُوراً بِأَنَّهُ لا يُرِيد أَنَّ يَزْعَجكِ .

29
00:05:22,950 --> 00:05:26,410
‫‫بيلو ينقذنا دائمًا

30
00:05:26,410 --> 00:05:28,290
‫‫هَل أَنْتُم حَقّا أَصْدِقائهُ ؟

31
00:05:28,290 --> 00:05:31,200
‫‫إِذاً ، ماذا عَنكِ يا (مايا)؟

32
00:05:31,200 --> 00:05:33,750
‫‫أَنا خائِفَة قَلِيلاً

33
00:05:33,750 --> 00:05:36,250
‫‫لٰكِنَّنِي وَحَيْدَة أَيْضاً

34
00:05:36,250 --> 00:05:38,790
‫‫إِنَّهُ مُمِلّ بِدُون (بيلو)

35
00:05:45,120 --> 00:05:51,620
‫‫لَمَّ نُكِنّ لِنُعْرَف مِن دُونِ تَقْرِيركِ يا (سامرز)

36
00:05:51,620 --> 00:05:56,290
‫كاشو . أَلَم تَكُننَ مُحْبِطاً قَلِيلاً بِشَأْن الإِبْلاغ ؟

37
00:05:56,290 --> 00:05:59,870
‫‫أَعْتَذِر عَن القَرار المُؤَجَّل

38
00:05:59,870 --> 00:06:07,250
‫‫الصَيْف كَآن الوَحِيد الَّذِي رَأَى الوَحْش لِذا ٱِسْتَغْرَقَ الأَمَرّ وَقَتّاً لِلتَأْكِيد

39
00:06:07,250 --> 00:06:13,330
‫‫أُعْرَف (سامرز) أُفْضَل مِنكً

40
00:06:13,330 --> 00:06:16,120
‫‫أَنا مَن أُرْسِلها لِلخارِج

41
00:06:16,120 --> 00:06:18,250
‫‫فِيَّ المُقام الأَوَّل .

42
00:06:18,250 --> 00:06:21,700
‫‫لَقَدّ فَعُلتَها مِن أَجَلَّ حِمايتها

43
00:06:21,700 --> 00:06:24,000
‫‫نِعَم أُعْرَف .

44
00:06:24,000 --> 00:06:29,700
‫‫نَحْنُ نَعْلَم أَنَّ هُناكَ حالات أَكْثَرَ غموضآ فِيَّ الخارِج مِن العَلَوِيّ .

45
00:06:29,700 --> 00:06:35,660
‫‫رَغْم ذُلّكِ ، لِلتَفْكِير تَمَّ الإِبْلاغ عَن مَخْلُوق مِثْل هٰذا .

46
00:06:35,660 --> 00:06:39,410
‫‫أُعْتَقَد إِنَّكَ رَأَيت ما تَقُول إِنَّكَ رَأَيتِهُ

47
00:06:39,410 --> 00:06:47,330
‫‫بُعْد بَعْض المُناقِشَة ، أَخَذنا كَلَمَّة "الوَحْشِيَّة " فِيَّ الٱِعْتِبار

48
00:06:47,330 --> 00:06:56,620
‫‫وَقَرِرتَ ٱِسْتِدْعاء جَمِيع المُتَغَيِّرات البَشَرِيَّة ، الوُحُوش البَشَرِيَّة .

49
00:06:56,620 --> 00:06:59,620
‫‫الوُحُوش البَشَرِيَّة ؟

50
00:06:59,620 --> 00:07:02,950
‫‫لَدَيْهِها مِثْل هٰذا الخاتَم الأَجْنَبِيّ لِذٰلِكَ ...

51
00:07:02,950 --> 00:07:05,080
‫‫سَوَّفَ تَعْتاد عَلِيّ ذُلّكِ قَرِيباً

52
00:07:05,080 --> 00:07:07,790
‫‫رُؤَساؤنا قِدّ أَحَبُّوا هٰذا المُصْطَلَح

53
00:07:07,790 --> 00:07:08,700
‫‫فَهِمتَ .

54
00:07:08,700 --> 00:07:15,910
‫‫وَعِلاوَةً عَلِيّ ذُلّكِ ، فَإِنَّ الوُحُوش الَّتِي يُمْكِن أَنَّ تُخْفِي نَفْسها كَإِنْسان ...

55
00:07:15,910 --> 00:07:17,290
‫‫الفا.

56
00:07:19,160 --> 00:07:20,370
‫‫بيتا

57
00:07:22,330 --> 00:07:24,160
‫‫غاما.

58
00:07:24,160 --> 00:07:26,620
‫‫لَقَدّ تَمَّ تَسَمَّيتِهُم خَصِيصاً

59
00:07:26,620 --> 00:07:28,660
‫‫حَوْلَ هٰؤُلاءِ الثَلاثَة ...

60
00:07:28,660 --> 00:07:32,620
‫‫نِعَم ، أَنَت الوَحِيد الَّذِي أَتَّصِل بِهَمّ عُدَّة مَرّات

61
00:07:32,620 --> 00:07:35,080
‫‫أُرِيد أَنَّ أُسْمِع رَأْيكِ

62
00:07:35,080 --> 00:07:38,000
‫‫هُناكَ فُرْصَة إِنَّهُم حُلَفاؤنا

63
00:07:38,000 --> 00:07:41,790
‫‫--أَوْهَ ؟‫
‫‫-- حُلَفاء ؟ هٰؤُلاءِ الوُحُوش ؟

64
00:07:41,790 --> 00:07:46,700
‫‫شَعَرَت أَنْه كَآن مِن المُمْكِن مِن لَقاءَنا الأَخِير .

65
00:07:46,700 --> 00:07:53,830
‫‫أَيْضاً ، عِنْدَما كَآن (أَلِفا ) فِيَّ شَكَلَ بَشَرِيّ أَنْقَذَنِي ذات مَرَّة مِن الخَطَر

66
00:07:57,540 --> 00:08:00,330
‫‫لَمَّ تَخْبُرِينا بِهٰذا مِن قَبْلُ

67
00:08:00,330 --> 00:08:03,330
‫‫لا أَحَدَّ سَيُصَدِّقنِي عَلِيّ أَيَّة حالَ

68
00:08:03,330 --> 00:08:06,750
‫‫سَنُعَرِّف قَرِيباً إِن كانُوا أَعْدائنا أَو حُلَفائنا

69
00:08:06,750 --> 00:08:10,790
‫‫الدائِرَة الـ18 هِيَ لِلقُبَض عَلِيّ هٰذِهِ المَخْلُوقات

70
00:08:10,790 --> 00:08:13,040
‫‫القَبْض ؟

71
00:08:13,040 --> 00:08:16,370
‫‫وَسَيَشْرُف قائِد العَمَلِيّات عَلِيّ هٰذِهِ المَهَمَّة .

72
00:08:16,370 --> 00:08:18,370
‫‫كَمّاً هُوَ الحال

73
00:08:26,620 --> 00:08:28,200
‫‫قُدُم نَفَّسَكَ

74
00:08:28,200 --> 00:08:31,750
‫‫رَئِيس القِسَم الخاصّ فِيَّ الفُرْقَة الأُولى ( فَيَلُتّ )

75
00:08:31,750 --> 00:08:33,950
‫‫سَأَهْتَمّ بِالأُمُور مِن هُنا

76
00:08:33,950 --> 00:08:36,410
‫‫مَرْحَباً ، أَنا الدائِرَة الـ18

77
00:08:36,410 --> 00:08:38,620
‫‫مُقَدِّمات غَيَّرَ ضَرُورِيَّة .

78
00:08:38,620 --> 00:08:40,000
‫‫خُذْنِي إِلَى المُوَقَّع

79
00:08:40,000 --> 00:08:42,620
‫‫مـ-مِن فَضَلَّكِ أَنْتَظِر ، دَعْنِي أُبَلِّغ عَن الوَضْع

80
00:08:42,620 --> 00:08:44,200
‫‫أَنا مَدَركِ بِالفِعْل .

81
00:08:44,200 --> 00:08:45,790
‫‫بِالطَبْع كُنت ...

82
00:08:45,790 --> 00:08:47,450
‫‫سُونِيا .

83
00:08:47,450 --> 00:08:49,700
‫‫لا تَتَصَرَّفِ لِوَحْدكِ كثيرآ

84
00:08:49,700 --> 00:08:53,160
‫‫أَنَت لَمَّ تَتَغَيَّرِ عَلِيّ الإِطْلاق .

85
00:08:53,160 --> 00:08:56,620
‫‫لَقَدّ أَحْرَجتِ رَئِيسكِ تَماماً .

86
00:08:56,620 --> 00:08:59,160
‫‫إِذاً كَآن هُناكَ حاجَة لِلعَمَل ،

87
00:08:59,160 --> 00:09:00,700
‫‫سَأَذْهَب

88
00:09:02,330 --> 00:09:05,750
‫‫إِذاً بالَغَتِ فِيَّ ذُلّك ، لَن يَتَبَقَّى لَكِ مَكان لِتُذَهِّب إِلَيهِ .

89
00:09:05,750 --> 00:09:09,950
‫‫رَئِيس المَقَرّ ، أَنَت تُغْنِي لُحنَ مُخْتَلِف تَماماً .

90
00:09:09,950 --> 00:09:16,500
‫‫لا تُقِلّ ذُلّك . فِيَّ الحَقِيقَة كُنتِ سَعِيداً جَدّاً لِأَنَّكَ التَفَتُّت إِلَيَّ

91
00:09:16,500 --> 00:09:21,160
‫‫رَغْم ذُلّك، أَنا مُنْدَهِش مِن نَفَسِي لِأَعْتَمِد عَلَيكِ .

92
00:09:27,540 --> 00:09:29,750
‫‫هَل فَقَدَتِه ؟

93
00:09:29,750 --> 00:09:33,160
‫‫عَلِيّ الرَغْم مِن أَنَّنِي كُنتُ قادِرهً عَلِيّ مُطارِدتهُ بعيدآ جدآ

94
00:09:33,160 --> 00:09:34,700
‫‫فَهِمت

95
00:09:34,700 --> 00:09:37,450
‫‫ما هُوَ هَدَف هٰذا الأَحْمَق الجَدِيد بِرَأْيك ؟

96
00:09:37,450 --> 00:09:40,200
‫‫لَقَدّ قالَ أَنْه كَآن يُنَظِّف

97
00:10:02,620 --> 00:10:05,250
‫هٰذِهِ شُقَّة متسخة

98
00:10:05,250 --> 00:10:09,250
‫‫مِن فَضَلَّكِ أَصْنَع لَيّ مِكْنَسَة كَهْرَبائِيَّة مُناسَبَة !

99
00:10:09,250 --> 00:10:12,040
‫‫هوه. مكنسة كهربائية.

100
00:10:12,040 --> 00:10:13,750
‫‫كم هذا رائع

101
00:10:13,750 --> 00:10:16,120
‫‫هل تريد تنظيف الأشياء بشكل سيء؟

102
00:10:16,120 --> 00:10:20,200
‫‫أشعر بشعور جيد عندما يتم تنظيف الأشياء.

103
00:10:21,660 --> 00:10:26,910
‫‫أريد أن أمسح كل ركن من أركان هذه المدينة

104
00:10:26,910 --> 00:10:30,040
‫‫لهذا انضممت إلى قسم الصرف الصحي

105
00:10:30,040 --> 00:10:35,620
‫‫أردت أن أجعل هذه المنطقة تلك التي أطلق عليها (آبر) مكباً للقمامة

106
00:10:41,660 --> 00:10:46,120
‫‫لماذا الجميع بخير مع هذا المكان القذر؟

107
00:10:48,000 --> 00:10:51,660
‫‫كان والدي شخصاً لا يستطيع أن الاستغناء عنة

108
00:10:51,660 --> 00:10:53,330
‫‫لم يكن لدي أب

109
00:10:53,330 --> 00:10:58,450
‫‫في كل مرة كانت أمي تأتي إلى المنزل كانت تجلب رجلاً مختلفاً

110
00:10:58,450 --> 00:11:01,700
‫‫كانوا  دائماً عنيفين جداً إتجاهي

111
00:11:01,700 --> 00:11:03,540
‫‫أمي لم توقفهم أبداً

112
00:11:03,540 --> 00:11:08,450
‫‫بما أن هؤلاء الأشخاص لم يكونوا في المنزل أبدًا ، كنت دائمًا وحدي.

113
00:11:08,450 --> 00:11:15,620
‫‫لم يكن لدي الكثير لأفعله لذا بدأت بتنظيف تلك الغرفة الفوضوية

114
00:11:15,620 --> 00:11:19,790
‫‫غرفة نظيفة , شعور لطيف جداً...

115
00:11:19,790 --> 00:11:21,500
‫‫هذا هو السبب في ...

116
00:11:25,660 --> 00:11:30,790
‫‫لقد نظفت أمي وهذا الرجل أيضاً

117
00:11:30,790 --> 00:11:34,290
‫‫شعور منعش جدآ

118
00:11:34,290 --> 00:11:38,370
‫‫لذلك، وبعبارة أخرى، كنت ترغب في تنظيف
‫‫‫‫ الأشياء وتجعل نفسك تشعر بالارتياح.

119
00:11:38,370 --> 00:11:41,700
‫‫الناس القذرون قمامة

120
00:11:41,700 --> 00:11:46,250
‫‫أنا لا أفهم تمامآ مشاعرك ...

121
00:11:46,250 --> 00:11:49,660
‫‫إنه جيد. لقد أدركت ذلك الآن

122
00:11:49,660 --> 00:11:51,500
‫‫إذا لم أنظف الناس

123
00:11:51,500 --> 00:11:54,040
‫‫العالم لن يكون نظيفاً أبداً.

124
00:11:54,040 --> 00:11:57,120
‫‫طريقة فريدة من نوعها للتفكير.

125
00:11:57,120 --> 00:12:01,250
‫‫نعم! يجب أن أكون أنا

126
00:12:01,250 --> 00:12:03,750
‫‫أتمنى لو ولدت كمكنسة كهربائية

127
00:12:03,750 --> 00:12:05,410
‫‫يمكنك أن تصبح واحداً

128
00:12:05,410 --> 00:12:06,620
‫‫حقآ؟

129
00:12:06,620 --> 00:12:12,870
‫‫هناك تقنية كنت أريد أن أحاول.
‫‫‫‫ أنا متأكد من أنك سوف ترغب في ذلك.

130
00:12:21,370 --> 00:12:25,290
‫‫هذا سيكون تماما عينة مثيرة للاهتمام.

131
00:12:49,080 --> 00:12:50,500
‫‫ما هذا؟

132
00:12:50,500 --> 00:12:51,540
‫‫لا شيئ.

133
00:12:56,450 --> 00:12:58,830
‫‫ما هذا بحق الجحيم؟!

134
00:12:58,830 --> 00:13:03,290
‫‫هذا الصباح، جاء بعض العمال وفعلوا هذا.

135
00:13:03,290 --> 00:13:09,830
‫‫ابتداء من اليوم، هذه الغرفة هي الخط الأمامي للقبض على الوحش البشري.

136
00:13:09,830 --> 00:13:13,080
‫‫اوم,أين ستكون غرفتي؟

137
00:13:13,080 --> 00:13:15,500
‫‫هل تحتاج إلى واحدة؟

138
00:13:15,500 --> 00:13:17,620
‫‫أين الضابط (سامرز)؟

139
00:13:19,750 --> 00:13:21,870
‫‫إلى أين أنت ذاهب؟

140
00:13:21,870 --> 00:13:26,000
‫‫الـ(هيلمزمن) حصلوا على بعض المعلومات عن الوحوش البشرية

141
00:13:26,000 --> 00:13:28,040
‫‫وحوش بشرية؟

142
00:13:28,040 --> 00:13:30,450
‫‫هذا ما يسمى تلك الوحوش.

143
00:13:30,450 --> 00:13:33,620
‫‫يبدو أن الـ(العمليات العليا) في الأعلى أعطوهم هذا الاسم

144
00:13:33,620 --> 00:13:37,750
‫العمليات العليا؟ رئيس ذلك الرجل الـ(فيلت)؟

145
00:13:37,750 --> 00:13:39,450
‫هذا الشخص من القسم الخاص

146
00:13:39,450 --> 00:13:40,540
‫قسم خاص؟

147
00:13:40,540 --> 00:13:43,250
‫إنه أحد أتباع المجلس الغيب.

148
00:13:43,250 --> 00:13:47,120
‫إذاً، شعب (آبر) أمر بهذا؟

149
00:13:47,120 --> 00:13:48,660
‫لا أعرف.

150
00:13:48,660 --> 00:13:51,950
‫في الوقت الراهن، أريد أن أؤكد هذا الرصاص.

151
00:13:51,950 --> 00:13:54,790
‫ثم، يجب عليك إبلاغ هذا إلى الضابط الخاص.

152
00:13:54,790 --> 00:13:57,750
‫لن يأخذ الـ(هيلمزمن) على محمل الجد

153
00:14:02,660 --> 00:14:05,200
‫كما هو متوقع من جان دارك العليا.

154
00:14:05,200 --> 00:14:07,870
‫إنها تعرف القسم الخاص جيداً

155
00:14:18,040 --> 00:14:21,080
‫لقد كان يشبه هذا الرجل تماماً

156
00:14:21,080 --> 00:14:24,080
‫هل رأيتهم مع الاثنين الآخرين من قبل أيضاً؟

157
00:14:24,080 --> 00:14:25,700
‫كل حين وآخر.

158
00:14:25,700 --> 00:14:31,660
‫هذا الرجل، فتاة صغيرة، وصبي أصغر سنا. ثلاثة منهم

159
00:14:43,370 --> 00:14:44,870
‫أيها التافه!

160
00:14:58,620 --> 00:15:00,750
‫قوة الشفط لا تنخفضي!

161
00:15:00,750 --> 00:15:02,410
‫ساعدوني !

162
00:15:08,870 --> 00:15:11,580
‫لا يجب أن تتسخ الأمور

163
00:15:17,080 --> 00:15:19,080
‫لن أقبل التعبئة.

164
00:15:19,080 --> 00:15:23,200
‫لكن وحش امن يتفشى في منطقتنا

165
00:15:23,200 --> 00:15:26,080
‫لقد حصلنا على العديد من التقارير من المواطنين أيضا!

166
00:15:26,080 --> 00:15:28,870
‫إنه ليس هدفي للإعتقال

167
00:15:38,250 --> 00:15:41,200
‫فهمت. سأتوجه إلى مسرح الجريمة

168
00:15:41,200 --> 00:15:43,200
‫الضابط الخاص لا يتحرك؟

169
00:15:43,200 --> 00:15:45,700
‫إنه ليس ألفا لذا يقول أنه لن يفعل أي شيء

170
00:15:45,700 --> 00:15:49,080
‫حصلتِ على نهاية قصيرة للعصا لأنك بالفعل خارج.

171
00:15:49,080 --> 00:15:52,540
‫لماذا ا؟! لقد وضع فقط على هدفه.

172
00:16:02,000 --> 00:16:05,290
‫القمامه! هناك المزيد من القمامة!

173
00:16:24,410 --> 00:16:26,580
‫لقد ظهر!  إنه (ألفا)

174
00:16:26,580 --> 00:16:28,120
‫سنتوجه إلى هناك فوراً

175
00:16:28,120 --> 00:16:30,580
‫تأكد من الإبلاغ عن كل التفاصيل الأخيرة.

176
00:16:33,330 --> 00:16:35,160
‫آمم,إلى أين أنت ذاهب؟

177
00:16:37,580 --> 00:16:42,200
‫ما هي المتعة الذي يحصل عليها هذا الرجل من الحياة؟

178
00:16:42,200 --> 00:16:44,370
‫أنت مجددًا!

179
00:16:44,370 --> 00:16:47,160
‫من فضلك توقف عن إعتراض طريقي دائمآ!

180
00:16:54,290 --> 00:16:57,160
‫لا أستطيع أن أمصهم لا أستطيع أن أمصهم

181
00:16:57,160 --> 00:16:59,790
‫مع جسم كهذا لن تكون قادراً على العودة إلى شكلك البشري

182
00:16:59,790 --> 00:17:04,700
‫هذا جيد! إذا كنت أستطيع تنظيف الأشياء، لا أحتاج أن أكون إنساناً!

183
00:17:04,700 --> 00:17:07,450
‫أنا لست أن أكون إنسانآ! إنها قمامة!

184
00:17:07,450 --> 00:17:09,540
‫لا أصدق ذلك

185
00:17:17,580 --> 00:17:18,700
‫أنت قمامة أيضاً

186
00:17:18,700 --> 00:17:21,910
‫القمامه! القمامه! القمامه!

187
00:17:21,910 --> 00:17:24,450
‫القمامة!

188
00:17:34,080 --> 00:17:37,540
‫ماذا عنك؟ الاجمالي!

189
00:17:37,540 --> 00:17:40,790
‫لم أرى شيئاً قبيحاً هكذا من قبل

190
00:17:40,790 --> 00:17:44,200
‫أيها التافه! أيها التافه! أيها التافه!

191
00:17:51,040 --> 00:17:54,040
‫أشعر بتحسن كبير الآن!

192
00:18:15,500 --> 00:18:17,200
‫أعد التفكير في حياتك.

193
00:18:18,330 --> 00:18:20,950
‫لا ترمي إنسانيتك جانبآ.

194
00:18:23,580 --> 00:18:26,250
‫لا يجب أن تذهب إلى هناك الآن

195
00:18:26,250 --> 00:18:28,660
‫سوف تتأذى مرة أخرى

196
00:18:39,290 --> 00:18:40,700
‫انظرِ؟

197
00:18:40,700 --> 00:18:43,660
‫ولكن يبدو مختلفآ عن ذي قبل.

198
00:18:48,370 --> 00:18:50,370
‫أنا محظوظ

199
00:18:51,450 --> 00:18:56,540
‫مباشرة بعد مهمتي، كنت قادرآ على تأكيد الوحش البشري .

200
00:18:56,540 --> 00:18:57,660
‫افعلها.

201
00:19:58,870 --> 00:20:00,200
‫بيتا ؟

202
00:20:05,500 --> 00:20:06,660
‫غاما؟!

203
00:20:26,790 --> 00:20:28,080
‫تخلص منه

204
00:20:29,790 --> 00:20:31,450
‫ليست هناك حاجة للقمامة.

205
00:20:43,870 --> 00:20:45,080
‫الرجاء الانتظار.

206
00:20:50,370 --> 00:20:53,120
‫ومع ذلك، أنا لا أوافق على أسلوبك .

207
00:20:53,120 --> 00:20:59,290
‫(ألفا) أنقذني لقد حميتك أيضاً

208
00:20:59,290 --> 00:21:01,330
‫معلومات غير ضرورية.

209
00:21:01,330 --> 00:21:03,330
‫مهمتي هي القبض عليهم

210
00:21:03,330 --> 00:21:05,250
‫هذا عملي

211
00:21:05,250 --> 00:21:07,830
‫إذآ، ما معنى إطلاق النار عليه حتى الموت؟

212
00:21:07,830 --> 00:21:13,790
‫كان يجب أن نحصل على معلومات منه كمشتبه به في هذا الحادث

213
00:21:13,790 --> 00:21:16,160
‫هذه قمامة

214
00:21:24,000 --> 00:21:26,580
‫هذا الشخص بدا سعيداً

215
00:21:26,580 --> 00:21:27,790
‫هاه؟

216
00:21:27,790 --> 00:21:31,250
‫أتساءل عما إذا كانت هذه هي السعادة .

217
00:21:31,250 --> 00:21:32,950
‫عمّا تتحدثِ؟

218
00:21:32,950 --> 00:21:38,250
‫كان قادرآ على أن يصبح ما يريد أن يصبح. لهذا كان سعيداً جداً

219
00:21:38,250 --> 00:21:41,120
‫كان سعيدآ بمص البشر.

220
00:21:42,290 --> 00:21:44,450
‫لا أعرف.

221
00:21:44,450 --> 00:21:48,370
‫كيف يمكن للبشر أن يُبعدوا إنسانيتهم بهذه السهولة؟

222
00:21:48,370 --> 00:21:52,620
‫هل نريد حقاً أن نصبح مثلهم؟

223
00:22:07,700 --> 00:22:09,540
‫كنت أنتظرك

224
00:22:09,540 --> 00:22:12,450
‫لقد كنت قريبآ جداً

225
00:22:12,450 --> 00:22:16,040
‫أسرعو وتعالوا إلى جانبي

226
00:22:21,040 --> 00:22:24,500
‫أريدك يا (بيم)