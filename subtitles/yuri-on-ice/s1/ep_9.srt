1
00:01:30,250 --> 00:01:33,440
سرقَ ماكّاتشين بعضاً من الكعك وقد علِق
في حنجرته

2
00:01:33,910 --> 00:01:34,740
!فيكتور

3
00:01:34,740 --> 00:01:36,490
عُد إلى اليابان حالاً

4
00:01:36,490 --> 00:01:40,280
هل يمكنُك أن تصبح مدرّب يوري غداً ولو ليوم واحد فقط؟

5
00:01:40,280 --> 00:01:42,280
ماذا؟

6
00:01:43,130 --> 00:01:45,290
!على أي حال، هذه كارثة

7
00:01:45,800 --> 00:01:48,040
اسأل ياكوف عن أي شيء لا تفهمه

8
00:01:48,830 --> 00:01:51,780
احضنه فحسب إن وقعتَ في ورطة وسوف يُساعدك

9
00:01:52,330 --> 00:01:53,940
آسف يا يوري

10
00:01:53,940 --> 00:01:56,780
حتّى لو لم أكن هنا، سأبقى معك روحيّاً

11
00:01:58,270 --> 00:02:01,520
ومن ثمّ عاد فيكتور إلى اليابان

12
00:02:02,960 --> 00:02:07,500
!!يوري ضدّ يوري. الرُّعب
كأس روستلكوم، التزلُّج الحرّ

13
00:02:07,500 --> 00:02:10,540
يبدو أنّك لم تتكلّم مع المدرّب ياكوف

14
00:02:10,540 --> 00:02:12,500
في التمرين العامّ في هذا الصّباح

15
00:02:12,830 --> 00:02:14,070
!لا مُشكلة

16
00:02:14,520 --> 00:02:17,130
!سأفعلُ ما كنتُ أفعله دوماً في التّمرين مع فيكتور

17
00:02:17,130 --> 00:02:20,360
لماذا قبِلَ ياكوف بطبق شريحة اللّحم ذاك؟

18
00:02:20,360 --> 00:02:23,890
يوري، جاء جدُّك

19
00:02:24,940 --> 00:02:28,120
جدّي، ظننتُك لستَ على ما يرام

20
00:02:28,120 --> 00:02:29,870
جرّب هذه فحسب

21
00:02:31,300 --> 00:02:33,670
يوجد شريحة لحم وبيض مخفوق وأرزّ أبيض هنا

22
00:02:33,670 --> 00:02:34,650
ما شطيرة "البيروشكي" هذه؟

23
00:02:34,650 --> 00:02:36,400
إنّها بيروشكي شريحة اللّحم

24
00:02:36,400 --> 00:02:39,380
كُلها وأتقن عملك في التزلّج الحرّ اليوم يا يوراتشكا

25
00:02:40,910 --> 00:02:41,980
حسناً

26
00:02:42,660 --> 00:02:45,890
برحيل فيكتور، أنا الوحيد القادر على الفوز

27
00:02:45,890 --> 00:02:47,660
ينبغي أن يكون كلّ شيء لصالحي

28
00:02:48,650 --> 00:02:51,230
كأس روستلكوم، الحدث الأخير في دوري السّباق الأكبر

29
00:02:51,230 --> 00:02:54,350
المجموعة الثّانية على وشك أن تبدأ أخيراً
في التزلّج الفردي الحرّ للرجال

30
00:02:54,900 --> 00:02:57,330
يشارك كلّ متزلِّج في هذا الحدث بآماله ومخاوفه

31
00:02:57,330 --> 00:03:00,650
سيحدّدُ هذا الحدث من يتأهّل إلى نهائي
السّباق الأكبر

32
00:03:00,650 --> 00:03:03,180
المنافس الأوّل من المجموعة الثانية
يحتلُّ حالياً المركز السّادس

33
00:03:03,180 --> 00:03:05,680
هو إيميل نيكولا من جمهوريّة التشيك
نيكولا، العمر 18

34
00:03:06,830 --> 00:03:09,270
"إنّه يتزلّج على الموسيقى المقتبسة من الفيلم "أناستاشيا

35
00:03:10,050 --> 00:03:13,290
"سِمته هي "سايبربنك: لم أعد بشريّاً

36
00:03:13,290 --> 00:03:18,170
وكما هو اسم سِمته، ينوي القيام بأربع رباعيّات
وهو إنجاز خرافيّ

37
00:03:18,170 --> 00:03:20,200
.رباعيّة سالكو. جميل

38
00:03:20,200 --> 00:03:21,580
!أحسنت

39
00:03:27,170 --> 00:03:29,540
فيما يلي مجموعة قفز رباعي

40
00:03:30,740 --> 00:03:33,330
حلقة أصابع أقدام رباعيّة، حلقة أصابع أقدام رباعيّة

41
00:03:33,330 --> 00:03:35,060
سأنتهز هذه الفرصة لتوضيح شيء

42
00:03:35,620 --> 00:03:39,340
سأتأهّل لنهائي السّباق الأكبر بمساعدتك أو بدون يا ميكي

43
00:03:40,210 --> 00:03:43,820
لهذا عليك أن تفوز من دون دعمي أيضاً يا ميكي

44
00:03:49,460 --> 00:03:52,220
ستكونُ قفزته التّالية رباعيّة كذلك

45
00:03:52,220 --> 00:03:53,510
حلقة أصابع أقدام رباعيّة

46
00:03:53,510 --> 00:03:54,610
!متألّق

47
00:04:00,670 --> 00:04:03,180
لستُ كلّ امرأة في العالم

48
00:04:03,180 --> 00:04:04,850
!عليك أن تنفتح على العالم أكثر

49
00:04:04,850 --> 00:04:07,300
لستُ بحاجةٍ لأي امرأة أخرى سواكِ يا سالا

50
00:04:07,840 --> 00:04:11,580
كنتُ قادراً على التركيزِ في التزلُّج وتحقيق
كلّ هذا الإنجاز بفضلِ وجودكِ معي

51
00:04:11,910 --> 00:04:14,330
!لا تدعيني وشأني أرجوكِ

52
00:04:14,330 --> 00:04:16,770
!كن قويّاً يا ميكيل كريسبينو

53
00:04:16,770 --> 00:04:18,600
،أستطيعُ التزلُّج من دون حبّك

54
00:04:18,600 --> 00:04:19,690
!وسأبدأ بمواعدة أحد

55
00:04:20,820 --> 00:04:24,050
إذا حلَّ ثانياً أو أكثر، فقد يتمكّن
من التأهُّل لنهائي السِّباق الأكبر

56
00:04:24,760 --> 00:04:28,530
أتحبُّ الرجال التشيكيين الذين ليس لديهم سوى الهُتافات؟

57
00:04:28,530 --> 00:04:32,560
أم تحبُّ الرجال اليابانيين المزاجيين
الذين يُشبهون المنحرفين المكبوتين؟

58
00:04:29,560 --> 00:04:31,450
كانت رقصة تزلّجك القصيرة مغرية للغاية

59
00:04:31,450 --> 00:04:32,560
ماذا؟ شكراً

60
00:04:32,960 --> 00:04:36,760
لذا بالرغم من كونك إيطاليّة، ألا تحبّين
الرّجال السلبيين يا سالا؟

61
00:04:36,760 --> 00:04:37,840
حلقة أصابع أقدام رباعيّة

62
00:04:37,840 --> 00:04:39,320
!كان ذلك ممتازاً

63
00:04:39,320 --> 00:04:42,700
!حتّى الآن، شهدنا أربع رباعيّات خالية من الأخطاء

64
00:04:42,700 --> 00:04:44,460
إنّه غير بشريّ

65
00:04:44,460 --> 00:04:46,090
...تبّاً، أنا متعب

66
00:04:50,550 --> 00:04:51,910
...أرادَ القيام بمجموعة هنا، لكن

67
00:04:51,910 --> 00:04:54,770
سقطَ ولم يستطع إكمال القفزة الثّانية

68
00:04:54,770 --> 00:04:55,850
!تبّاً

69
00:04:57,170 --> 00:04:58,040
—ثلاثيّة سالكو

70
00:04:59,520 --> 00:05:00,980
!ما زلت راسخاً

71
00:05:11,810 --> 00:05:15,360
المجموع الذي حقّقَه إيميل نيكولا
من جمهوريّة التشيك هو 189.15

72
00:05:11,810 --> 00:05:18,540
المجموع     إيميل نيكولا

73
00:05:15,360 --> 00:05:18,540
علامته الإجماليّة هي 271.58. إنّه في المركز الأوّل حالياً

74
00:05:15,850 --> 00:05:16,820
!مرحى

75
00:05:17,820 --> 00:05:18,540
!نعم

76
00:05:18,540 --> 00:05:21,570
سالا، لا أجدكِ على أطراف الحلبة تودّعينه اليوم

77
00:05:21,950 --> 00:05:24,870
أمامنا الآن ميكيل كريسبينو من إيطاليا، العمر 22

78
00:05:24,870 --> 00:05:27,070
أنهى رقصة التزلّج القصيرة في المركز الخامس

79
00:05:27,520 --> 00:05:29,550
هل سينهض في التزلّج الحرّ؟

80
00:05:31,160 --> 00:05:33,460
"إنّه يتزلّج على "سيرينادا لشخصين

81
00:05:35,640 --> 00:05:39,340
سالا، هل تشاهدينني من مكان ما؟

82
00:05:39,820 --> 00:05:43,130
أعلم هذا حتّى لو كنّا مفترقَين

83
00:05:46,340 --> 00:05:47,340
رباعيّة سالكو

84
00:05:49,780 --> 00:05:52,530
لعلَّ ميكي يشعرُ بإحباطٍ قليلاً

85
00:06:05,150 --> 00:06:08,980
شقلبة ثلاثيّة، حلقة فرديّة، وثلاثيّة سالكو

86
00:06:08,980 --> 00:06:10,340
!مجموعة من ثلاث قفزات

87
00:06:10,980 --> 00:06:15,490
ماذا ينبغي أن أفعل بمشاعري؟

88
00:06:19,170 --> 00:06:20,600
دائريّة ثلاثيّة

89
00:06:21,380 --> 00:06:25,490
مقارنة بالتمرين، تزلّجه أكثر سلاسة بكثير

90
00:06:26,170 --> 00:06:28,310
إنّه أشبه بشخص مختلف كلّياً

91
00:06:28,310 --> 00:06:29,500
هل حدث شيء؟

92
00:06:29,500 --> 00:06:30,680
الحبّ

93
00:06:30,680 --> 00:06:35,430
أشعرُ بحبٍّ ضائع في تزلُّج ميكيل

94
00:06:37,770 --> 00:06:41,240
سالا، لم نفترق منذُ الولادة

95
00:06:41,240 --> 00:06:42,980
...عزيزتي سالا

96
00:06:43,420 --> 00:06:44,690
...مولاتي

97
00:06:46,410 --> 00:06:49,030
لماذا يقسو عليّ الأولاد؟

98
00:06:49,420 --> 00:06:51,280
هذا لأنّكِ ظريفة

99
00:06:51,280 --> 00:06:53,510
سأضربهم جميعاً

100
00:06:54,110 --> 00:06:55,760
طلبَ منّي أحدهم الخروج معه مجدّداً

101
00:06:55,760 --> 00:06:57,790
!سأضربه

102
00:06:58,560 --> 00:07:00,040
لا تسيئي فهمي

103
00:07:01,100 --> 00:07:03,500
أنا مجرّد غبيّ

104
00:07:08,520 --> 00:07:13,680
سالا، هذه هي المرّة الأخيرة التي أتزلّجُ فيها لأجلكِ

105
00:07:15,510 --> 00:07:18,610
ينتهي حبّي هنا أيضاً

106
00:07:20,210 --> 00:07:23,940
هذا هو حبِّي الحقيقي

107
00:07:25,410 --> 00:07:27,560
وداعاً يا سالا

108
00:07:39,490 --> 00:07:40,600
ثلاثيّة لوتز

109
00:07:45,500 --> 00:07:47,170
!رائع! بلا أخطاء

110
00:07:58,530 --> 00:08:01,620
!ها هي نتيجة ميكيل كريسبينو من إيطاليا

111
00:08:01,620 --> 00:08:03,600
!علامته هي 193.24

112
00:08:02,230 --> 00:08:08,710
المجموع     ميكيل كريسبينو

113
00:08:03,600 --> 00:08:06,310
علامته الإجماليّة هي 282.89

114
00:08:06,310 --> 00:08:09,430
تخطّى رقمه الشخصيّ الأفضل بفارق 20 نقطة تقريباً

115
00:08:09,430 --> 00:08:10,570
!ميكي

116
00:08:11,970 --> 00:08:12,950
!سالا

117
00:08:13,520 --> 00:08:14,790
!مبروك

118
00:08:15,450 --> 00:08:19,710
كانت تلك أروع رقصة تزلّج رأيتُها منك حتّى الآن

119
00:08:19,710 --> 00:08:21,850
فكّرتَ بي عندما كنتَ تتزلّج، صحيح؟

120
00:08:21,850 --> 00:08:23,080
نـ-نعم

121
00:08:23,080 --> 00:08:26,060
آسفة لأنّني قلتُ كلاماً قاسياً بحقّك قبل قليل

122
00:08:26,060 --> 00:08:27,730
!لكن يسرُّني أنّني فعلت

123
00:08:27,730 --> 00:08:30,090
!نحنُ أفضل مفترقَين إذاً

124
00:08:30,940 --> 00:08:32,710
سيبدأ سيونغ غيل

125
00:08:32,710 --> 00:08:33,470
!إلى اللّقاء

126
00:08:41,710 --> 00:08:42,760
ياكوف

127
00:08:42,760 --> 00:08:43,740
ماذا؟

128
00:08:43,740 --> 00:08:45,520
سأغيّرُ بنية القفزة

129
00:08:46,710 --> 00:08:49,190
سأخفّفُ عدد القفزات في النصف الأوّل من أربعة إلى اثنتين

130
00:08:49,190 --> 00:08:51,160
ستقفزُ ستّ قفزاتٍ في النصف الثاني إذاً؟

131
00:08:51,160 --> 00:08:51,990
أجل

132
00:08:51,990 --> 00:08:53,170
هل لديك وصيّة قبل موتك؟

133
00:08:53,750 --> 00:08:56,950
لا أستطيع الفوز على جيـه جيـه أو يوري بغير طريقة

134
00:09:02,930 --> 00:09:07,710
المجموع     سيونغ غيل لي

135
00:09:02,930 --> 00:09:07,710
رغم أنّ سيونغ غيل لي قد تعافى بعد سقوطه
،في حلقته الرباعيّة المبكِّرة

136
00:09:07,710 --> 00:09:09,330
إلّا أنّه خسرَ خسارة كبيرة في الترتيب

137
00:09:09,330 --> 00:09:11,790
وفقدَ الأمل في التأهُّلِ إلى نهائي السِّباق الأكبر

138
00:09:11,790 --> 00:09:14,640
لكن نتطلّع قدماً لرؤيته في بطولة القارّات الأربع

139
00:09:16,430 --> 00:09:19,890
هنا في دياره، يطلُّ علينا يوري بليسيتسكي، العمر 15

140
00:09:17,890 --> 00:09:27,070
!يوري! يوري! يوري

141
00:09:19,890 --> 00:09:21,950
في المركز الثّالث بعد رقصة التزلُّج القصيرة

142
00:09:21,950 --> 00:09:23,890
!استمعوا إلى هذه الهتافات فحسب

143
00:09:23,890 --> 00:09:28,270
سأربح بالذهبيّة الأولى في أوّل مُشاركةٍ لي في قسم الكبار هنا

144
00:09:30,830 --> 00:09:34,740
"إنّه يتزلّج على "مرح عاطفي بسلّم سي صغير

145
00:09:34,740 --> 00:09:37,280
ألِّفَت رقصة التزلّج بواسطة ليليا بارانوفسكايا

146
00:09:37,280 --> 00:09:39,110
المديرة السّابقة لباليـه بولشوي

147
00:09:39,110 --> 00:09:41,330
،للمشاركة الأولى ليوري بليسيتسكي في قسم الكبار

148
00:09:41,330 --> 00:09:45,470
اختاروا مقطوعة مشهورة جدّاً بصعوبتها
وحدّتها المسرِّعة لنبضاتِ القلب

149
00:09:45,470 --> 00:09:48,070
أتيحَتْ له إمكانيّة تجربة رباعيّات
منذُ مشاركته الرسميّة الأولى في قسم الكبار

150
00:09:48,070 --> 00:09:49,670
وها هي أولى القفزتين في رقصة التزلّج هذه

151
00:09:50,880 --> 00:09:53,820
كما في رقصةِ تزلّجه القصيرة، نزلَ على قدميه بكلِّ ثقة

152
00:09:58,160 --> 00:10:00,140
دائريّة ثلاثيّة من حلزونيّة

153
00:10:01,780 --> 00:10:04,310
كانت عالية جدّاً. ألا يبدو متحمّساً زيادة عن اللزوم؟

154
00:10:04,310 --> 00:10:05,330
هذا صحيح

155
00:10:05,330 --> 00:10:06,770
ارقص بجمال

156
00:10:07,550 --> 00:10:10,370
!الجمال هو قوّة الاستقامة السّاحِقة

157
00:10:10,370 --> 00:10:14,150
لا تعني القوّة شيئاً دون جمال

158
00:10:24,470 --> 00:10:27,400
سلسلة خطوات صعبة جدّاً حتّى لحظة للتنفُّس

159
00:10:27,400 --> 00:10:29,170
من أين له هذا الهدوء؟

160
00:10:29,840 --> 00:10:32,390
من هُنا يبدأ بالتعب

161
00:10:32,390 --> 00:10:34,200
اصمد في النصف الثّاني

162
00:10:35,130 --> 00:10:37,550
...تـ-تبّاً، هذا صعب

163
00:10:38,630 --> 00:10:40,800
سيقفز ستّ قفزات في النصف الثّاني؟

164
00:10:41,650 --> 00:10:44,030
ها قد بدأنا بقفزات النصف الثّاني

165
00:10:44,680 --> 00:10:45,630
ثلاثيّة لوتز

166
00:10:50,510 --> 00:10:53,070
،طبق شريحة اللّحم له ثلاث رباعيّات

167
00:10:53,070 --> 00:10:54,820
وجيـه جيـه له أربع

168
00:10:55,770 --> 00:10:56,440
شقلبة ثلاثيّة

169
00:11:02,090 --> 00:11:05,390
!للتغلُّب على هذا، يجبُ ألّا أرتكب أي خطأ

170
00:11:06,280 --> 00:11:07,690
حلقة أصابع أقدام رباعيّة

171
00:11:07,690 --> 00:11:10,220
هذا هو تسلسُل الرّقص

172
00:11:11,470 --> 00:11:13,380
!لا أريد أن أخسر هكذا مجدّداً

173
00:11:14,120 --> 00:11:19,170
تتوجّه كافّة الأنظار إليه أثناء التزلُّج الحرّ
يوري بليسيتسكي من روسيا، العمر 15

