1
00:00:01,730 --> 00:00:05,100
بطولة مجموعة السِّيرك
اليابانيّة النّسخة 24 اليوم

2
00:00:05,600 --> 00:00:06,730
اليوم تلتفت أنظارنا

3
00:00:06,730 --> 00:00:09,400
إلى سِيرك زهرة عبّاد الشّمس، والّذي
اجتازَ الجولةَ الثّانية

4
00:00:10,110 --> 00:00:12,900
...صنعتا اسماً لنفسيهما بنجاحاتهما الأخيرة

5
00:00:13,110 --> 00:00:15,490
،المُحلِّقة، الآنسة أوكا كاواسومي

6
00:00:16,030 --> 00:00:20,450
،وماسكتها، الابنة المحبوبة للّوتس السّوداء
الآنسة ميزوكا تسوروماكي

7
00:00:21,000 --> 00:00:23,620
إنّهما تُدهشان الجمهور بأدائهما المُبهر

8
00:00:23,620 --> 00:00:25,420
ولا يتوقّفان عند هذا الحدّ

9
00:00:26,250 --> 00:00:30,750
،الأداء غير الهوائيّ مُبهر جدّاً أيضاً
ليأسر الجمهور

10
00:00:31,090 --> 00:00:34,130
،يُعَدّ الآن الحصان الأسود لهذه البطولة

11
00:00:34,130 --> 00:00:36,840
سِيرك زهرة عبَّاد الشّمس أبرزَ
،قوّته الإجماليّة

12
00:00:36,840 --> 00:00:38,720
ليُحقِّق النّصر مرّتين

13
00:00:39,470 --> 00:00:40,310
حسناً، حسناً

14
00:00:40,310 --> 00:00:43,680
يبدو أنّ الحُكّام اندهشوا بالهُتافات الهائلة

15
00:00:44,770 --> 00:00:48,520
ويتأهّل إلى النّهائيّ ويسبقه
بخطوة هو سِيرك الوردة الزّرقاء

16
00:00:48,810 --> 00:00:52,570
هل يستطيع تحدِّي هؤلاء الأبطال؟

17
00:00:52,820 --> 00:00:57,740
أداء الجولة الأخيرة سيُقام على مدى
خمسة أيّام في خيمتَي سِيرك مُتجاورتين

18
00:00:57,870 --> 00:00:59,910
لنستمرّ في مُراقبة هذه المعركة

19
00:01:05,120 --> 00:01:09,170
.رامن بالدّجاج، رامن بالدّجاج
!تفضّل طبقاً آخر

20
00:01:09,170 --> 00:01:10,290
!رشف، رشف، رشف

21
00:01:10,290 --> 00:01:14,340
،رامن بالدّجاج، رامن بالدّجاج
الجميع يبتسمون

22
00:01:14,340 --> 00:01:15,970
ابتسم، ابتسم، ابتسم

23
00:01:15,970 --> 00:01:20,510
!سهلة جدّاً وعمليّة ولذيذة
!خذها معك في نزهتك أو جولة بسيّارة أو أي رحلة

24
00:01:18,590 --> 00:01:22,100
!أمّي، أريد بعض رامن الدّجاج

25
00:01:20,510 --> 00:01:25,310
،احتفِظ بها دوماً بجانبك. غذائيّات نيسّين
ابحث عن هذا الشِّعار هنا

26
00:01:25,310 --> 00:01:29,650
رامن بالدّجاج! ممم، لذيذ

27
00:03:02,490 --> 00:03:05,870
أخيراً! نُشِرَتْ مقالةٌ عنّا
في الصّفحة الأماميّة

28
00:03:05,870 --> 00:03:11,830
لا يُقهَر! سِيرك زهرة عبَّاد الشّمس
!يقتحم النّهائيّ

29
00:03:07,120 --> 00:03:09,910
أجل، كما قالت ميزوكا، نحن نربح

30
00:03:09,910 --> 00:03:11,830
التّالي هو الأداء الأخير

31
00:03:12,080 --> 00:03:15,040
ناهيكِ عن أنّها أوّل رسالة مُعجبين لي

32
00:03:15,040 --> 00:03:16,300
سعيدة للغاية

33
00:03:16,590 --> 00:03:20,090
ليس هذا فحسب، لكن من كان يتوقّع
أن نحصل على كُلّ هذه الهدايا؟

34
00:03:20,090 --> 00:03:21,180
صحيح؟

35
00:03:21,630 --> 00:03:22,930
!أنتما

36
00:03:23,470 --> 00:03:25,010
أين الجميع؟

37
00:03:25,220 --> 00:03:27,260
الغداء جاهز

38
00:03:27,430 --> 00:03:28,270
حسناً

39
00:03:28,270 --> 00:03:30,890
يبدو أنّهن غير جاهزات لترك التّمرين بعد

40
00:03:36,110 --> 00:03:37,530
كيف تسير الأمور؟

41
00:03:40,690 --> 00:03:42,820
ستصبح المعكرونة رطِبة

42
00:03:52,750 --> 00:03:55,460
الالتواءات الجانبيّة صعبة جدّاً

43
00:03:55,920 --> 00:03:58,130
،إن لم تكن ستُواجه نانامي سوميراغي

44
00:03:58,130 --> 00:04:00,210
لكانت قد أزيلَتْ من الفصل

45
00:03:58,130 --> 00:04:00,210
!سأبدأ -
!حسناً -

46
00:04:06,350 --> 00:04:07,720
فعلَتْها

47
00:04:08,010 --> 00:04:09,350
...لكن

48
00:04:09,350 --> 00:04:12,180
معكِ حقّ. وهذا يكفي

49
00:04:12,690 --> 00:04:15,520
إذا كان كُلّ ما تستطيع فعله هو أداء هذا

50
00:04:15,940 --> 00:04:20,230
بهذا المُستوى، لن تتمكّن من إرضاء الجمهور

51
00:04:20,860 --> 00:04:26,070
لم يعثرنَ بعد على طريقة للتّعويض
عن حركاتها المُدمَجة إذاً؟

52
00:04:27,280 --> 00:04:29,490
لا يمكنهما بلوغ المُستوى التّالي

53
00:04:30,120 --> 00:04:33,120
لا أحد يُدرك ذلك أكثر منهما

54
00:04:33,750 --> 00:04:39,040
،أوكا! لِمَ لا تفعلينها وتُحلّقين بجنون
لعشرة أمتار أو ما قارب

55
00:04:39,040 --> 00:04:41,460
أريد أن يقشعرّ بدني أكثر

56
00:04:41,460 --> 00:04:43,630
أو تُزيلين الشّبكة؟

57
00:04:43,630 --> 00:04:45,630
سيكون ذلك مُشوِّقاً

58
00:04:47,260 --> 00:04:49,850
وأيضاً، معكرونة رامن الدّجاج تُصبح رطِبة

59
00:04:49,850 --> 00:04:54,440
جميعكن، ركّزنَ على فصولكن الخاصّة رجاء

60
00:04:54,850 --> 00:04:58,150
الرّجاء التّركيز على سدّ نقاط ضعفكن

61
00:04:59,570 --> 00:05:01,360
سنكون بخير

62
00:05:01,360 --> 00:05:05,280
بصفتي مُديرة الحلبة التّنفيذيّة، لا أريد
أيّ مُشكلة لبقيّتكن، اتّفقنا؟

63
00:05:06,280 --> 00:05:08,740
أوكا، لنُجرِّب ذلك مرّةً أُخرى

64
00:05:09,160 --> 00:05:10,080
حسناً

65
00:05:10,370 --> 00:05:14,210
إيسوزو، من فضلكِ حرِّكي الحبلَ لحزٍّ آخر

66
00:05:14,210 --> 00:05:15,580
هل أنتِ متأكِّدة من ذلك؟

67
00:05:15,580 --> 00:05:17,830
لا تقلقي. افعليها حالاً رجاء

68
00:05:31,430 --> 00:05:33,520
أختي؟ سأدخل

69
00:05:45,440 --> 00:05:46,530
ميزوكا؟

70
00:05:46,990 --> 00:05:48,070
سأدخل

71
00:05:48,070 --> 00:05:48,910
حسناً

72
00:05:49,780 --> 00:05:51,620
إذاً ما زلتِ مُستيقظة

73
00:05:51,740 --> 00:05:53,240
كيف سأتمكّن من النّوم؟

74
00:05:54,370 --> 00:05:56,750
هل ستُغيّرين فصلَ الجميع كذلك؟

75
00:05:57,040 --> 00:05:58,540
أنا أُراجعها فحسب

76
00:05:58,920 --> 00:06:03,090
بالنّسبة للنّهائيّ، أفكِّر عموماً
بإقامة فصول جديدة كُلّياً

77
00:06:06,340 --> 00:06:10,430
لم أُعانِ من السِّيرك هكذا سابقاً

78
00:06:10,850 --> 00:06:12,970
حسناً، هذا لأنّنا ضدّ الآنسة نانامي

79
00:06:13,430 --> 00:06:15,310
لكن الأمر لا يتعلّق بذلك

80
00:06:16,520 --> 00:06:18,100
،مهما فكّرتُ في الأمر مليّاً

81
00:06:18,100 --> 00:06:20,310
أو مهما تمرّنت، أنا مُتوتِّرة

82
00:06:21,230 --> 00:06:23,940
،أدركتُ الآن بأنّني في السّابق

83
00:06:23,940 --> 00:06:27,320
كنتُ بريئة جدّاً، وأُمارس أعمال
السِّيرك فقط لأنّني أحبّها

84
00:06:30,030 --> 00:06:32,950
سأستمرّ في مُرافقتكِ. لنُتابع
فترة أطول قليلاً

85
00:06:33,410 --> 00:06:34,240
أجل

86
00:06:47,300 --> 00:06:48,510
!ها أنا ذي

87
00:06:48,510 --> 00:06:49,470
!حسناً

88
00:07:13,410 --> 00:07:16,290
توقيت  إفلاتكِ خاطئ. سنُكرّر ذلك

89
00:07:16,290 --> 00:07:17,290
!عُلِم

90
00:07:24,500 --> 00:07:29,220
سِيرك الوردة الزّرقاء

91
00:07:25,590 --> 00:07:29,220
آسفة لجعلكِ تأتين إلى هنا فقط
لمُقابلتي يا آنسة ماميا

92
00:07:29,470 --> 00:07:31,590
لا، أنا من ينبغي أن يشكركِ

93
00:07:31,590 --> 00:07:35,180
بفضلكِ، أستطيع البقاء مع بقيّة
أعضاء فرقتنا

94
00:07:35,680 --> 00:07:38,180
هذا يُساهم في تخفيف توتُّري

95
00:07:39,980 --> 00:07:41,690
يسرّني سماع ذلك

96
00:07:44,150 --> 00:07:45,310
...ثمّة شيء

97
00:07:45,730 --> 00:07:49,360
الجميع في سِيرك زهرة عبَّاد
الشّمس يحتاج لمعرفته

98
00:07:58,700 --> 00:07:59,790
من جديد

99
00:07:59,790 --> 00:08:00,700
حسناً

100
00:08:00,700 --> 00:08:02,540
ميزوكا. انتظري لحظة

101
00:08:03,210 --> 00:08:05,080
أنتِ أيضاً يا أوكا. انتظري

102
00:08:06,460 --> 00:08:07,840
أريد التكلُّم معكما

103
00:08:09,300 --> 00:08:10,710
لا تضغطا على نفسيكما

104
00:08:10,710 --> 00:08:12,590
ما فعلتُماه للتوّ كان خطيراً

105
00:08:12,590 --> 00:08:14,890
نعلم بأنّ علينا الضّغط على أنفسنا بطريقةٍ ما

106
00:08:14,890 --> 00:08:17,970
إن لم نُتقن ذلك قريباً، فسينفد الوقت

107
00:08:18,220 --> 00:08:21,810
،إذا استمررتُما في سلوك هذا الطّريق
فستتكبّدان ضرراً لا يمكن مُعالجته

108
00:08:22,310 --> 00:08:25,060
لا تقولا لي بأنّكما، بالتّحديد، لا تعلمان ذلك

109
00:08:27,900 --> 00:08:29,780
سينتهي المطاف بكما مثلي

110
00:08:31,820 --> 00:08:35,320
آنذاك، كنتُ مُستعدّة لقبول العواقب

111
00:08:35,820 --> 00:08:38,330
لكن لا أريدكما أن تُصبحا مثلي

112
00:08:38,830 --> 00:08:40,450
لا يمكن أن تُصبحا مثلي

113
00:08:42,790 --> 00:08:46,040
لكن، لا أعرف ما الّذي يجب فعله فحسب

114
00:08:51,300 --> 00:08:53,510
اسمعا، هل كنتُما تحظيان
بالرّاحة الّتي تحتاجانها؟

115
00:08:53,840 --> 00:08:55,180
أجل، الكثير من الرَّاحة

116
00:08:55,180 --> 00:08:56,590
هذه كذبة

117
00:08:56,590 --> 00:08:59,680
حتّى لو بذلتما قصارى جهدكما، لن
تحصلا على النّتيجة الّتي تُريدانها

118
00:08:59,850 --> 00:09:01,890
لا تفقدا أثرَ هدفكما

119
00:09:02,430 --> 00:09:03,930
حسناً -
حسناً -

120
00:09:05,100 --> 00:09:07,190
انتهى التّمرين لليوم

121
00:09:07,190 --> 00:09:08,610
يمكنكما أخذ استراحة

122
00:09:08,610 --> 00:09:09,520
ماذا؟

123
00:09:09,520 --> 00:09:11,070
لا يجوز أن تفعلي ذلك

124
00:09:11,530 --> 00:09:13,900
آمركما كعضوة أقدم في الفِرقة

125
00:09:13,900 --> 00:09:17,030
اخرجا إلى المدينة اليوم، واستمتعا بالمناظر

126
00:09:17,910 --> 00:09:20,990
،جميعنا نريد أن تتحقّق أُمنية ماريا
مثلكما تماماً

127
00:09:21,990 --> 00:09:24,290
أخذ استراحة هو جزءٌ من عملكما أيضاً

128
00:09:25,040 --> 00:09:26,080
...بالإضافة إلى ذلك

129
00:09:26,250 --> 00:09:29,840
لا يمكنكما أن تحلما بهزيمة نانامي
سوميراغي بوضعكما الرّاهن

130
00:09:31,090 --> 00:09:32,050
حسناً

131
00:09:37,130 --> 00:09:41,100
كم سيكون من الرّائع أن نُتقن تلك
الخدعة في الوقت قبل النّهائيّ؟

132
00:09:41,260 --> 00:09:46,230
لكن لا تكفي كورقة رابحة لهزيمة
الآنسة نانامي

133
00:09:51,770 --> 00:09:55,900
،أعتقد بأنّنا نرتعد زيادةً عن اللُّزوم
كما قالت الآنسة سوفيتلانا

134
00:09:56,030 --> 00:09:57,740
لكن الوقت يُداهمنا

135
00:09:59,070 --> 00:10:00,490
لنُصفِّ ذهنينا

136
00:10:00,950 --> 00:10:03,490
لا مزيد من التجهُّم اليوم. لنستمتع قليلاً

137
00:10:06,790 --> 00:10:08,960
لنُجبر نفسينا على الاستمتاع

138
00:10:10,290 --> 00:10:11,210
حسناً

139
00:10:32,730 --> 00:10:36,690
بطولة اليابان جارية الآن
أهلاً بكم في يوكوهاما
مجموعة السِّيرك

140
00:10:50,540 --> 00:10:54,750
ساحر أوز

141
00:10:51,330 --> 00:10:53,420
إنّها نفس كتابكِ المُصوَّر يا ميزوكا

142
00:10:53,420 --> 00:10:54,750
أجل، صحيح

143
00:10:57,840 --> 00:10:59,220
حسناً. لنُشاهده من جديد

144
00:10:59,970 --> 00:11:00,930
!أجل

145
00:11:06,270 --> 00:11:09,190
أين نحن؟ من المُؤكَّد أنّنا
لسنا في كانساس

146
00:11:09,520 --> 00:11:12,980
لا أستطيع فعلها. أخشى الحيوانات

147
00:11:13,770 --> 00:11:16,360
لكن أريد عقلاً فعلاً

148
00:11:16,980 --> 00:11:19,320
عدتُ إلى الدِّيار أخيراً

149
00:11:19,650 --> 00:11:23,450
لا أريد مُغادرة الدِّيار ثانية أبداً

150
00:11:27,870 --> 00:11:29,870
كان ذلك رائعاً بالفعل

151
00:11:29,870 --> 00:11:32,420
كان مُشوِّقاً بطريقة مُختلفة
عن الكِتاب المُصوَّر

152
00:11:32,420 --> 00:11:34,540
وكان فيلماً مُمتعاً جدّاً

153
00:11:35,250 --> 00:11:36,750
إلى أين تريدين الذّهاب تالياً؟

154
00:11:37,090 --> 00:11:39,510
لنذهب إلى حيث تُريدين الذّهاب

155
00:11:39,720 --> 00:11:43,640
ماذا؟ لا يخطر على بالي أيّ شيء

156
00:11:46,180 --> 00:11:47,970
متحف الطّفيليّ ميغورو

157
00:11:47,970 --> 00:11:49,100
مُحال

158
00:11:52,480 --> 00:11:55,610
حسناً، هل من مُتحدّيين هنا؟

159
00:11:55,770 --> 00:12:00,740
أنتما! تبدوان شابّتين رياضيّتين
قد وصلتا إلى هنا للتو

160
00:12:01,110 --> 00:12:02,740
أتريدان تجربة ذلك؟

161
00:12:03,700 --> 00:12:07,830
إذا استطعتُما مُجاراتنا بفعل نفس الحركات
لدقيقة واحدة، ستحصلان على 100 ين

162
00:12:03,700 --> 00:12:07,830
نُرحِّب بمُتحدّيين
اربح وستحصل على 100 ين

163
00:12:08,580 --> 00:12:10,870
هذا أفضل ممّا دفعَتْه لي الآنسة ماريا

164
00:12:10,870 --> 00:12:12,790
لكن سدّدتِ كافّة ديونكِ

165
00:12:13,420 --> 00:12:14,710
لنفعلها

166
00:12:14,710 --> 00:12:16,540
حسناً، يبدو هذا مُسلّياً، صحيح؟

167
00:12:19,090 --> 00:12:20,510
هل أنتما جاهزتان؟

168
00:12:20,510 --> 00:12:21,420
أجل

169
00:12:22,090 --> 00:12:23,260
هذه

170
00:12:23,380 --> 00:12:24,090
هذه

171
00:12:25,680 --> 00:12:26,640
هذه

172
00:12:27,470 --> 00:12:28,470
هذه

173
00:12:28,470 --> 00:12:29,770
أحسنتُما

174
00:12:30,100 --> 00:12:31,020
هذه

175
00:12:33,600 --> 00:12:34,560
هذه

176
00:12:35,940 --> 00:12:37,110
هذه

177
00:12:44,610 --> 00:12:47,490
بجدّية. من أنتما؟

178
00:12:53,160 --> 00:12:57,130
لكن فعلاً، ما الّذي يُفترض بنا فعله
عندما نحصل على إجازة فجأة؟

179
00:12:57,210 --> 00:12:59,840
لا يخطر على بالي أيّ شيء لفعله

180
00:13:00,130 --> 00:13:04,180
رغم ذلك، هل سيضرُّ ميزوكا
اعتمادنا علينا ولو قليلاً؟

181
00:13:08,050 --> 00:13:10,350
سيّد أخطبوط

182
00:13:10,680 --> 00:13:13,430
لا أستطيع الوصول إليه

183
00:13:14,270 --> 00:13:16,060
يا إلهي

184
00:13:16,520 --> 00:13:18,610
ممنوع الاقتراب

185
00:13:21,190 --> 00:13:22,530
مرحباً

186
00:13:23,900 --> 00:13:27,740
ذهبَ السّيّد أخطبوط للمشي قليلاً

187
00:13:28,780 --> 00:13:30,280
للمشي؟

188
00:13:30,280 --> 00:13:32,370
هذا صحيح. راقبي هذا

189
00:13:35,000 --> 00:13:36,620
حسناً، حسناً

190
00:13:36,620 --> 00:13:37,500
!انظري

191
00:13:38,460 --> 00:13:39,840
عُدت

192
00:13:41,670 --> 00:13:42,960
أهلاً بعودتك

193
00:13:43,880 --> 00:13:45,470
مُذهل

194
00:13:45,630 --> 00:13:48,300
أنتِ السَّاحرة من سِيرك زهرة
عبّاد الشّمس، صحيح؟

195
00:13:48,300 --> 00:13:50,140
أريد رؤية المزيد من ذلك

196
00:13:50,220 --> 00:13:52,720
هلّا ساعدتنا في جذب بعض
بعض الزّبائن أيضاً؟

197
00:13:52,720 --> 00:13:54,430
هل يمكنكِ إعانتي في محلّي أيضاً؟

198
00:13:55,810 --> 00:13:57,390
يبدو هذا مُسلّياً

199
00:13:57,520 --> 00:13:59,560
سنُقدّم المُساعدة أيضاً

200
00:13:59,730 --> 00:14:01,860
إن لم تُمانعوا أن نكون نحن
من يُقدِّم المُساعدة

201
00:14:14,580 --> 00:14:18,790
التقط صورة مع فرانسوا

202
00:14:26,130 --> 00:14:27,550
لقد قضينا وقتاً مُمتعاً، صحيح؟

203
00:14:27,840 --> 00:14:31,640
كان من المُنعِش الشُّعور بالتّقارب
مع الجمهور أكثر من السِّيرك

204
00:14:35,640 --> 00:14:37,600
هذا حلوٌ للغاية

205
00:14:41,730 --> 00:14:45,030
سأحقِّق أُمنيةَ ماريا مهما كلّفَ الأمر

206
00:14:45,230 --> 00:14:46,110
ماذا؟

207
00:14:46,360 --> 00:14:47,360
أجل

208
00:14:47,950 --> 00:14:51,620
تتذكّرين، أليس كذلك؟ تلك
القصّة من طفولتي؟

209
00:14:51,870 --> 00:14:56,080
أجل. قلتِ بأنّكِ أردتِ أداء زهرة
اللّوتس على مسرح كبير

210
00:14:56,410 --> 00:14:58,620
...أجل. بخصوص ذلك

211
00:15:00,170 --> 00:15:02,250
...زهرة اللّوتس الّتي رأيتُها مع أمِّي

212
00:15:02,710 --> 00:15:05,170
!أردتُ أن أكون في السِّيرك

213
00:15:05,170 --> 00:15:07,720
هل هذا سيُسعدكِ يا أمِّي؟

214
00:15:09,180 --> 00:15:11,260
...الطّريقة الّتي ابتسمتْ فيها أُمّي

215
00:15:14,050 --> 00:15:19,890
ظننتُ بانّ أمّي قد تعود إلى الدّيار
إذا أدّيتُ نفس تلك الخدعة

216
00:15:21,940 --> 00:15:27,690
،لكن لم أكن أملك خبرة إطلاقاً
ولم يكن يتبنّانني أي سِيرك

217
00:15:28,280 --> 00:15:29,990
ولماذا يفعلون ذلك؟

218
00:15:29,990 --> 00:15:33,490
من يتّخذ طفلةً مثلي بجدّية؟

219
00:15:33,490 --> 00:15:37,450
سِيرك شقيق النّعمان الذّهبيّ
أهلاً بكم

220
00:15:41,420 --> 00:15:43,460
سِيرك زهرة عبَّاد الشّمس

221
00:15:43,460 --> 00:15:48,630
نبحث عن أعضاء فِرقة جدُد

222
00:15:45,540 --> 00:15:47,380
هل أنتِ مهتمّة بالسِّيرك؟

223
00:15:49,260 --> 00:15:52,550
استمعتْ ماريا إلى ما كان لديّ من كلام

224
00:16:04,980 --> 00:16:09,150
.جميعنا في هذه الفِرقة عائلة
هذه العائلة ستنجح معاً

225
00:16:09,150 --> 00:16:11,700
هذا هو السِّيرك الّذي نريد بناءه

226
00:16:12,910 --> 00:16:14,200
معاً؟

227
00:16:14,820 --> 00:16:17,580
هذا صحيح. فأنتِ جزءٌ من العائلة الآن

228
00:16:17,790 --> 00:16:20,580
سأعمل بشكل مُكثَّف لأجلكن جميعاً

229
00:16:20,960 --> 00:16:21,910
...لذا

230
00:16:22,710 --> 00:16:25,380
أريدكِ أن تُصبحي جناحَي

231
00:16:29,880 --> 00:16:32,420
منحَتْني ماريا كُلَّ شيء

232
00:16:33,340 --> 00:16:36,260
أنا ما أنا عليه اليوم بفضلها

233
00:16:38,010 --> 00:16:41,060
العائلة ستفعلها معاً، صحيح؟

234
00:16:41,520 --> 00:16:45,650
أجل. جميعنا سنتكاتف معاً لتحقيق أُمنية ماريا

235
00:16:47,900 --> 00:16:48,770
ماذا؟

236
00:16:53,530 --> 00:16:55,450
...ما الّذي... ما الّذي

237
00:16:55,450 --> 00:16:58,950
كيف لي أن أُفوِّت ذلك أيضاً؟

238
00:16:59,990 --> 00:17:01,120
هيّا بنا نعود

239
00:17:01,580 --> 00:17:02,540
أجل

240
00:17:04,000 --> 00:17:06,250
لقد بعنا الكثير

241
00:17:06,750 --> 00:17:09,630
أليس من الرّائع التّفاعل مع الجمهور؟

242
00:17:09,630 --> 00:17:11,260
أجل، هذا مُنعشٌ جدّاً

243
00:17:11,760 --> 00:17:16,260
.لو نستطيع صنع بعض أنواع البضائع
كما تفعل الفِرق الأُخرى

244
00:17:16,260 --> 00:17:17,300
سيكون ذلك رائعاً

245
00:17:17,300 --> 00:17:19,810
أعتقد حان الوقت لنصنع شيئاً، أليس كذلك؟

246
00:17:21,180 --> 00:17:22,470
عدنا

247
00:17:22,730 --> 00:17:24,270
عدنا

248
00:17:24,390 --> 00:17:25,900
!أهلاً بعودتكما

249
00:17:26,020 --> 00:17:27,770
كيف حالكن؟

250
00:17:27,940 --> 00:17:30,980
هذا صحيح. لقد استمتعنا كثيراً

251
00:17:31,070 --> 00:17:33,650
أنا سعيدة لأنّكن غيّرتُن الرّوتين اليوميّ

252
00:17:33,940 --> 00:17:36,490
ماذا عنكِ يا ميزوكا؟ -
لماذا تختبئين؟ -

253
00:17:36,860 --> 00:17:39,120
...في الواقع

254
00:17:41,370 --> 00:17:44,040
أنتن، أريد أن أقول شيئاً

255
00:17:46,000 --> 00:17:46,920
...في الواقع

256
00:17:47,630 --> 00:17:50,540
لم أقصد بأنّكن لم تكُن تعملنَ
،بجدٍّ بما يكفي

257
00:17:50,630 --> 00:17:53,380
أو بأنّني لم أحتج مُساعدتكن

258
00:17:53,960 --> 00:17:58,180
كمُديرة حلبة تنفيذيّة، ارتأيتُ بأنّني لا ينبغي
أن أُسبّب لكُن أي مُشكلة

259
00:17:58,590 --> 00:18:00,010
...ولذا

260
00:18:00,600 --> 00:18:02,390
أرجو أن تمددنَ يد العون لي

261
00:18:02,720 --> 00:18:07,020
الفصل الهوائيّ وحده ليس كافياً لاجتياز النّهائيّ

262
00:18:07,140 --> 00:18:10,230
ولذا، أريد من الجميع أن يمددنني يد العون لي

263
00:18:10,520 --> 00:18:12,320
...لكن أوّلاً

264
00:18:13,820 --> 00:18:15,150
نحن آسفتان

265
00:18:15,490 --> 00:18:17,860
...بعد أن قلتُ بأنّه سيكون جهداً جماعيّاً

266
00:18:19,410 --> 00:18:22,620
حسناً، لم نكن نتّخذ الأمر بجدّية
كافية أيضاً. آسفة

267
00:18:23,450 --> 00:18:25,830
وبعد؟ أين ينبغي أن نبدأ إذاً؟

268
00:18:26,210 --> 00:18:27,160
ماذا؟

269
00:18:27,160 --> 00:18:29,120
سأذهب إلى الآنسة شيزوكو، اتّفقنا؟

270
00:18:29,120 --> 00:18:31,540
أين أختي سوفي يا تُرى؟

271
00:18:31,790 --> 00:18:33,300
إذاً ستُساعدنَني؟

272
00:18:33,630 --> 00:18:35,090
بكُلّ تأكيد

273
00:18:35,210 --> 00:18:39,930
ما زالت مُديرة حلبتنا مُتردِّدة، لذا يجب
علينا جميعاً الاعتناء بها، صحيح؟

274
00:18:41,470 --> 00:18:42,890
شكراً جزيلاً

275
00:18:42,890 --> 00:18:44,600
شكراً يا فتيات

276
00:18:45,890 --> 00:18:48,850
ولذا، في الواقع، لديّ فكرة

277
00:18:48,850 --> 00:18:50,520
من فضلكِ أخبريني بما تُفكِّرين فيه

278
00:18:50,520 --> 00:18:53,020
على ذكر الأفكار، لدينا بعض
الأفكار الرّائعة أيضاً

279
00:19:22,850 --> 00:19:24,050
آنسة شيزوكو؟

280
00:19:27,600 --> 00:19:28,930
آنسة رين

281
00:19:29,350 --> 00:19:31,150
لديّ شيء مُهم لأخبركِ به

282
00:19:31,730 --> 00:19:34,150
تعالي معي من فضلكِ. برفقة الآنسة سوفيتلانا

283
00:19:35,110 --> 00:19:36,190
حسناً

284
00:19:38,990 --> 00:19:41,820
عثروا على جرّاح يستطيع إجراء عمليّة لماريا

285
00:19:42,870 --> 00:19:44,410
هذا مُطمئن

286
00:19:44,410 --> 00:19:48,000
ستخضع لعمليّةٍ جراحيّة في الولايات
المُتّحدة أيضاً

287
00:19:49,960 --> 00:19:50,960
...لكن

288
00:19:52,500 --> 00:19:54,500
العمليّة الجراحيّة ستكون صعبة، صحيح؟

289
00:19:54,500 --> 00:19:55,840
أجل

290
00:19:55,840 --> 00:20:00,010
بمُنتهى الصّراحة، ستكون احتمالات
النّجاح مُنخفضة جدّاً

291
00:20:00,670 --> 00:20:01,930
مُستحيل

292
00:20:02,300 --> 00:20:06,390
لهذا أعتقد بأنّها ينبغي أن ترى الجميع

293
00:20:08,100 --> 00:20:11,810
لكن عرضكن الأخير اقترب

294
00:20:12,060 --> 00:20:14,150
...إذا كنتُ سأنقل نبأ كهذا للجميع

295
00:20:16,070 --> 00:20:19,280
لا أدري ما إن كان ينبغي أن أخبر الجميع

296
00:20:20,400 --> 00:20:21,900
هل يمكنكِ إحضار ميزوكا إلى هنا؟

297
00:20:22,030 --> 00:20:23,240
هل أنتِ متأكِّدة؟

298
00:20:23,530 --> 00:20:26,240
لا يمكننا إخفاء هذا الأمر عن مُديرة
حلبتنا التّنفيذيّة

299
00:20:27,160 --> 00:20:28,910
أعلم بأنّها تستطيع تقبُّل ذلك

300
00:20:34,750 --> 00:20:39,340
يجب علينا إخبار الأُخريات، ولنذهب
جميعاً معاً لمُقابلتها

301
00:20:39,760 --> 00:20:41,420
،إذا أخبرناهن بذلك

302
00:20:41,420 --> 00:20:44,930
هل تعتقدين بأنّهن يستطعن التّركيز
على التّمرين والعرض؟

303
00:20:44,930 --> 00:20:46,140
سيكونن بخير

304
00:20:47,100 --> 00:20:52,430
،أنا فقط سوف أخبرهن بذلك بالتّدريج
لذا لا حاجة للقلق

305
00:20:53,020 --> 00:20:54,770
هذا ليس مُطمئناً جدّاً

306
00:20:57,940 --> 00:20:59,570
ماذا؟ ما الّذي يجري؟

307
00:20:59,570 --> 00:21:03,070
اسمعن، قيل لي بأنّ الآنسة ماريا
ستخضع لعمليّة جراحيّة

308
00:21:03,070 --> 00:21:04,110
ماذا؟

309
00:21:04,110 --> 00:21:07,950
عثروا على جرّاح سيجري عمليّةً لها
في الولايات المُتّحدة

310
00:21:08,370 --> 00:21:09,790
هذا جيّد

311
00:21:09,790 --> 00:21:11,160
...رغم ذلك

312
00:21:12,000 --> 00:21:14,120
يبدو أنّها ستكون عمليّة صعبة

313
00:21:14,330 --> 00:21:17,710
،حالما تُسافر إلى الولايات المُتّحدة
لن نتمكّن من رؤيتها لبعض الوقت

314
00:21:18,210 --> 00:21:20,090
متى موعد عمليّتها؟

315
00:21:20,460 --> 00:21:24,090
ستُغادر اليابان في صباح اليوم
الأوّل من عرضكن الأخير

316
00:21:26,550 --> 00:21:28,550
سيحدث ذلك فجأة؟

317
00:21:28,550 --> 00:21:33,180
،ينبغي أن تُغادر بظروف جيّدة
بعد أن نربح البطولة

318
00:21:33,770 --> 00:21:35,440
،نظراً لجدول الجرّاح

319
00:21:35,440 --> 00:21:38,110
،عليها أن تُغادر في ذلك اليوم
وإلّا فلن تصل  إلى هناك في الوقت

320
00:21:38,610 --> 00:21:42,480
عثرنا على هذا الطّبيب أخيراً، لذا
لا نُريد تفويت هذه الفُرصة

321
00:21:43,400 --> 00:21:45,360
،وضعها مُستقرّ الآن

322
00:21:45,650 --> 00:21:48,570
لكن أريدها أن تخضع للعمليّة
في أسرع وقت مُمكن

323
00:21:50,030 --> 00:21:54,540
وهذا كُلّ شيء. لنذهب جميعاً
لزيارة الآنسة ماريا حالاً

324
00:21:54,960 --> 00:21:58,000
،ولنتشارك طاقتنا معها

325
00:21:58,000 --> 00:22:00,340
وذلك كي تتمكّن من السّفر إلى
أمريكا بمعنويّات عالية

326
00:22:03,840 --> 00:22:06,050
لا يُسمَح لماريا باستقبال زُوَّار