1
00:00:01,020 --> 00:00:05,270
سيرك زهرة عبّاد الشّمس

2
00:00:12,030 --> 00:00:13,950
مهلاً، لِمَ كُلّ هذه السّرّيّة؟

3
00:00:15,740 --> 00:00:17,490
الأمر يتعلّق بالآنسة ماريا

4
00:00:17,660 --> 00:00:19,740
هل اكتشفتِ شيئاً؟

5
00:00:20,040 --> 00:00:21,660
ما مُشكلتها؟

6
00:00:21,660 --> 00:00:25,830
في هذه اللّحظة، سمعتُ أنّ الآنسة نانامي فقط
وقلّة مختارة من العائلة

7
00:00:26,040 --> 00:00:28,840
والآنسة رين يُسمَح لهن بزيارتها

8
00:00:28,840 --> 00:00:31,420
رغم ذلك، جميعنا عائلة أيضاً

9
00:00:32,010 --> 00:00:36,010
لندخل بمجموعة صغيرة كي لا نُسبّب أي مُشكلة

10
00:00:36,930 --> 00:00:39,140
إذاً هذا يعني نحن أوّلاً؟

11
00:00:39,140 --> 00:00:39,890
أجل

12
00:00:40,260 --> 00:00:44,390
لكن إذا كانت لا تقبل الزُوّار، ألا يعني هذا
بأنّها ليست بخير؟

13
00:00:44,520 --> 00:00:49,860
،بحسب ما أخبرتني به الآنسة رين
إنّها صافية الذّهن وتستطيع الأكل أيضاً

14
00:00:50,400 --> 00:00:52,610
يبدو أنّهم يُشدِّدون الحرص فحسب

15
00:00:52,610 --> 00:00:56,610
لذا لنلقِ تحيّةً سريعة على ماريا-سان
ونُغادر. لا نريدها أن تتعب

16
00:00:56,610 --> 00:00:57,570
حسناً

17
00:00:57,990 --> 00:01:00,450
إذا كنّا لا نستطيع رؤيتها، فسوف
ندخل بالقوّة حينها، صحيح؟

18
00:01:00,450 --> 00:01:01,450
!أجل

19
00:02:35,960 --> 00:02:38,260
هلّا حاولتُن عدم التسبُّب بمُشكلة؟

20
00:02:39,220 --> 00:02:40,890
نحن آسفات

21
00:02:41,550 --> 00:02:48,020
،لكن سنُغادر إلى طوكيو قريباً
حيث تُقام الخيمة للنّهائي

22
00:02:48,270 --> 00:02:50,810
لن نحصل على فُرصة لرؤيتها بعد الآن

23
00:02:50,810 --> 00:02:52,940
أريد رؤية الآنسة ماريا

24
00:02:55,070 --> 00:02:59,400
يبدو أنّ أملنا الوحيد هو زيارة المطار
في اليوم الّذي تُغادر فيه

25
00:02:59,610 --> 00:03:01,070
...لكن

26
00:03:01,070 --> 00:03:03,870
،أجل، إذا فعلنا ذلك

27
00:03:03,870 --> 00:03:08,160
سيعني ذلك التّنازل عن اليوم الأوّل من أداءنا
في النّهائي، أليس كذلك؟

28
00:03:11,750 --> 00:03:14,130
لديّ رسالة للجميع من ماريا

29
00:03:15,590 --> 00:03:17,800
"شكراً على إثارة قلقي"

30
00:03:18,170 --> 00:03:21,680
"لكن أريدكن جميعاً أن تُركّزنَ على التّمرين"

31
00:03:21,930 --> 00:03:24,300
"لا يجوز أن تشغلنَ أنفسكن بالقلق عليّ الآن"

32
00:03:24,680 --> 00:03:28,270
"لا تقلقن. سأسافر إلى أمريكا بمعنويّات عالية"

33
00:03:29,020 --> 00:03:31,940
"سأتطلّع بشوق لأدائنا في النّهائي"

34
00:03:33,730 --> 00:03:37,730
سأحرص على إبلاغ ماريا بمشاعركن جميعاً

35
00:03:55,330 --> 00:03:57,250
آسفة لِلقائي بكِ في مكان كهذا

36
00:03:57,800 --> 00:03:59,880
لا، لا عليكِ

37
00:04:00,420 --> 00:04:05,930
لا أريد أن يراني الآخرون أجتمع
مع خصمي في النّهائي

38
00:04:06,050 --> 00:04:07,140
أتّفق

39
00:04:07,350 --> 00:04:11,060
بصراحة، لم أتوقّع أبداً أن تقطعي كُلّ هذا الشّوط

40
00:04:14,440 --> 00:04:17,650
أريد أن أصل إلى ذروة السِّيرك

41
00:04:18,020 --> 00:04:21,820
وظننتُ بأنّه راودَكِ نفس شعوري

42
00:04:23,650 --> 00:04:26,620
تريدين التسلُّق إلى أسمى علالي السِّيرك

43
00:04:27,070 --> 00:04:29,160
لهذا السّبب تردّدتِ عندما ضممتُكِ

44
00:04:29,620 --> 00:04:31,290
،لأنّكِ إذا انتقلتِ إلى سوميراغي

45
00:04:31,290 --> 00:04:33,790
ظننتِ بأنّكِ تستطيعين الأداء على مسرح كبير

46
00:04:33,910 --> 00:04:34,830
هل كلامي صحيح؟

47
00:04:37,000 --> 00:04:39,090
...ما أريده يا آنسة كاواسومي

48
00:04:39,960 --> 00:04:44,510
هو بِناء الفِرقة العُظمى، فِرقة تقود
صِناعة السِّيرك في اليابان

49
00:04:44,800 --> 00:04:46,840
لهذا السّبب طلبتُ منكِ الانضمام لنا

50
00:04:47,850 --> 00:04:49,050
لكن رفضتِ طلبي

51
00:04:49,390 --> 00:04:50,640
أنا آسفة

52
00:04:50,930 --> 00:04:52,930
لكن المُؤدّيات الأُخريات حكاية مُختلفة

53
00:04:53,230 --> 00:04:55,940
أضمّهن فقط لأنّ أختي طلبتْ منّي ذلك

54
00:04:56,060 --> 00:05:01,230
حسناً، رغم أنّ ابنة اللّوتس السّوداء
قد تكون إضافة جيّدة

55
00:05:01,530 --> 00:05:04,400
إذا أردتِ التّراجع عن عقدكِ، فلا أُمانع أيضاً

56
00:05:05,240 --> 00:05:07,360
إن خسرتِ، فسوف تُحَلّ فِرقة زهرة عبَّاد الشّمس

57
00:05:07,870 --> 00:05:10,530
أنتِ مُستعدّة لتتفرّقن عن بعضكن الآخر، صحيح؟

58
00:05:10,660 --> 00:05:13,410
نحن لا نُفكّر بالخسارة، ولا بأيّ شكل

59
00:05:16,000 --> 00:05:17,580
دعيني أسألكِ تحسُّباً فقط

60
00:05:18,250 --> 00:05:20,090
ما هو هدفكِ الآن؟

61
00:05:20,670 --> 00:05:23,710
هدفي الآن هو تحقيق أُمنية ماريا

62
00:05:24,050 --> 00:05:25,470
أُمنيتنا جميعنا معاً

63
00:05:26,510 --> 00:05:27,470
هكذا إذاً

64
00:05:29,050 --> 00:05:30,140
سأغادر الآن

65
00:05:30,260 --> 00:05:31,600
أراكِ في اليابان

66
00:05:32,010 --> 00:05:32,810
حسناً

67
00:05:34,930 --> 00:05:36,440
المعذرة، آنسة نانامي؟

68
00:05:39,150 --> 00:05:42,610
شكراً لكِ على تسديد أجور ماريا بالنّيابة عنّي

69
00:05:43,150 --> 00:05:45,240
فعلتُ فقط ما كان أيّ شخص ليفعله

70
00:05:49,240 --> 00:05:50,620
عوّضيني بالفائدة، اتّفقنا؟

71
00:05:50,950 --> 00:05:52,620
حسناً

72
00:05:53,120 --> 00:05:54,290
أمزح فحسب

73
00:05:55,000 --> 00:05:57,790
اشربي عصير البُرتقال هذا، اتّفقنا؟
!إنّه لذيذ

74
00:06:01,750 --> 00:06:03,500
سآخذ واحداً لميزوكا

75
00:06:09,010 --> 00:06:13,390
لا توجد طريقة أُخرى لرؤية الآنسة ماريا
ما لم نذهب إلى المطار مُباشرة

76
00:06:13,680 --> 00:06:15,470
لكن من حيث الوقت، سيعني ذلك

77
00:06:15,470 --> 00:06:18,270
أن نتنازل عن أدائنا في النّهائيّ

78
00:06:18,390 --> 00:06:20,770
وهذا ليس ما ستُريده الآنسة ماريا

79
00:06:21,440 --> 00:06:22,400
...لكن

80
00:06:22,690 --> 00:06:24,780
الجميع، وأنا أيضاً

81
00:06:24,980 --> 00:06:26,610
نريد رؤية الآنسة ماريا

82
00:06:28,990 --> 00:06:31,160
لِمَ لا يمكننا رؤيتها ولو لثانية؟

83
00:06:44,210 --> 00:06:46,960
ميزوكا، ستكونين مُديرة حلبتنا

84
00:06:49,930 --> 00:06:50,970
ميزوكا

85
00:06:54,050 --> 00:06:55,260
!ميزوكا

86
00:07:02,520 --> 00:07:04,320
...ما كانت الآنسة ماريا لتُريده

87
00:07:18,830 --> 00:07:22,370
جميعكن، شكراً لكُن على الاجتماع هنا اليوم

88
00:07:22,880 --> 00:07:25,750
أودّ إبلاغكن عن قراري كمُديرة حلبة تنفيذيّة

89
00:07:28,340 --> 00:07:30,760
لن نتنازل عن أدائنا في النّهائي

90
00:07:31,010 --> 00:07:32,720
،مثلما قالت الآنسة ماريا لنا

91
00:07:32,930 --> 00:07:36,640
سنجعل التّمرين للنّهائي أولويّتنا القصوى

92
00:07:37,220 --> 00:07:40,140
،إذا بذلنا قصارى جهدنا وحاولنا تحقيق هدفنا

93
00:07:40,430 --> 00:07:42,770
فستكون تِلك أفضل هديّة

94
00:07:45,770 --> 00:07:48,860
في الواقع، راودني شعورٌ بأنّكِ ستقولين ذلك

95
00:07:48,860 --> 00:07:49,740
ماذا؟

96
00:07:49,940 --> 00:07:53,410
فأساساً، إذا انسحبنا، فسوف تقتلنا، أليس كذلك؟

97
00:07:53,910 --> 00:07:58,120
بصراحة، ساورتْني شكوك، لكن أستطيع المُتابعة الآن

98
00:07:58,120 --> 00:08:02,160
أجل. بالإضافة إلى ذلك، وصلنا إلى هنا بفضلكِ يا ميزوكا

99
00:08:02,500 --> 00:08:06,630
ميزوكا، مشاعرنا مُشتركة

100
00:08:06,880 --> 00:08:07,960
هذا صحيح

101
00:08:07,960 --> 00:08:13,050
يمكننا إنفاق الجائزة الماليّة الخاصّة بالنّهائي
لزيارتها في أمريكا، صحيح؟

102
00:08:13,050 --> 00:08:14,760
أجل. يبدو ذلك مُمتعاً

103
00:08:15,390 --> 00:08:18,680
أعتقد بأنّكِ اتّخذتِ القرارَ الصّائب أيضاً يا ميزوكا

104
00:08:19,310 --> 00:08:21,140
أتّفق معكِ أيضاً

105
00:08:22,430 --> 00:08:24,140
شكراً لكُن جميعاً

106
00:08:24,770 --> 00:08:27,980
،حسناً، الآن بعد أن اقترب النّهائي

107
00:08:27,980 --> 00:08:30,820
ما رأيكن بكلمة من مُديرة حلبتنا التّنفيذيّة؟

108
00:08:30,820 --> 00:08:31,530
ماذا؟

109
00:08:31,530 --> 00:08:34,320
هنا نحتاج لسماع خِطاب مُحفِّز، صحيح؟

110
00:08:34,320 --> 00:08:36,070
فكرة سديدة، أريد سماع هذا

111
00:08:36,660 --> 00:08:43,160
في الواقع، قد لا يكون ذلك النّوع
...من الخِطابات، لكن

112
00:08:45,120 --> 00:08:49,040
منذ ولادتي، كنتُ في السِّيرك

113
00:08:49,550 --> 00:08:54,130
كان سِيرك اللّوتس موطني، وأصدقائي، وعائلتي

114
00:08:54,510 --> 00:08:56,680
،وعندما تبدّدَ ذلك فجأة

115
00:08:56,680 --> 00:09:00,560
كرهتُ أبي، وأشحتُ بنظري عن السِّيرك

116
00:09:00,930 --> 00:09:03,100
وأردتُ الهرب من هذا العالم

117
00:09:03,730 --> 00:09:06,810
،وعندما أتيتُ إلى زهرة عبّاد الشّمس
لم أُرد أن أكون هنا حقّاً

118
00:09:07,100 --> 00:09:09,770
لأنّني شعرتُ وكأنّني كنتُ أخون عائلتي القديمة

119
00:09:10,150 --> 00:09:12,400
...لكن في حقيقة الأمر، أنا

120
00:09:13,110 --> 00:09:15,490
أُحبّ السِّيرك

121
00:09:15,650 --> 00:09:20,530
.هذا هو المكان الّذي انتمي إليه
الجميع هنا علّموني ذلك

122
00:09:21,950 --> 00:09:26,290
ولا أعتقد بأنّني أنا فقط

123
00:09:30,380 --> 00:09:32,090
...حيث تنتمين

124
00:09:33,050 --> 00:09:34,510
...ما تريدين فعله

125
00:09:38,590 --> 00:09:39,680
...آمالك

126
00:09:40,680 --> 00:09:42,260
وما تستمتعين به

127
00:09:46,600 --> 00:09:49,270
نحن لا نُحقّق حلمَ الآنسة ماريا فقط

128
00:09:49,690 --> 00:09:51,400
ستكون الأمور على ما يُرام

129
00:09:51,940 --> 00:09:57,450
لحماية هذا المكان، وذلك كي نستطيع
...جميعنا أن نبقى معاً للأبد

130
00:09:57,950 --> 00:10:00,160
!لنربح. جميعنا معاً

131
00:10:02,120 --> 00:10:02,910
ماذا؟

132
00:10:03,290 --> 00:10:06,330
قلتِ للتو كلاماً رائعاً حقّاً

133
00:10:06,330 --> 00:10:08,120
تبدين كمُديرة حلبة

134
00:10:08,120 --> 00:10:11,500
ماذا؟ لكن أنتُن من طلب إلقاء خِطاب

135
00:10:15,010 --> 00:10:17,680
بشكل مُفاجئ، أشعر بإحراج شديد

136
00:10:18,510 --> 00:10:19,800
حسناً

137
00:10:19,800 --> 00:10:23,760
سنُسافر إلى طوكيو غداً، لذا استعددنَ جميعاً رجاء

138
00:10:23,760 --> 00:10:24,810
!حسناً

139
00:10:34,110 --> 00:10:35,320
ميزوكا؟

140
00:10:36,360 --> 00:10:39,070
شكراً على لعِب دور مُؤلم كهذا

141
00:10:39,320 --> 00:10:44,580
،لا. أنا المسؤولة عن هذه الفِرقة
لذا فعلتُ فقط ما قد يفعله أيّ شخص

142
00:10:46,200 --> 00:10:47,500
شكراً لكِ

143
00:10:48,080 --> 00:10:50,710
والآن يستطيع الجميع المضيّ قُدماً والتطوُّر

144
00:10:51,710 --> 00:10:55,050
قلتُ بأنّني سأفعل ما يلزم للفوز

145
00:10:55,590 --> 00:10:57,340
هذا ما قلتُه للآنسة ماريا

146
00:10:57,550 --> 00:10:58,340
حسناً

147
00:10:59,380 --> 00:11:04,810
سننتظر كفِرقة تستطيع التّرحيب بعودتها
ونحن فخورات

148
00:11:04,970 --> 00:11:06,060
في أيّ وقت تعود

149
00:11:06,390 --> 00:11:08,390
أجل. سأُخبرها

150
00:11:14,270 --> 00:11:17,110
يسرّني أنّني أتيتُ إلى زهرة عبّاد الشّمس

151
00:11:17,440 --> 00:11:20,570
أنا مسرورةٌ حقّاً لأنّني تمكّنتُ
من اللِّقاء بالجميع

152
00:11:20,860 --> 00:11:24,280
ماذا؟ كان ينبغي أن تقولي ذلك أمام الجميع

153
00:11:24,280 --> 00:11:25,490
لن يحدث هذا

154
00:11:25,490 --> 00:11:26,540
لا تُريدين ذلك؟

155
00:11:26,540 --> 00:11:28,200
لأنّ ذلك سيكون مُحرجاً

156
00:11:29,330 --> 00:11:30,790
انسي ذلك

157
00:11:30,790 --> 00:11:32,630
من فضلكِ ألقي نظرة إلى هذا

158
00:11:34,080 --> 00:11:35,960
ما هذا؟

159
00:11:36,500 --> 00:11:39,090
إنّه برنامجنا الجديد

160
00:11:39,340 --> 00:11:42,220
،ابتداء من الغد، سأدع الجميع ينضمّون

161
00:11:42,340 --> 00:11:44,010
وسيكون قد حان وقت مُعسكر التّدريب

162
00:11:44,010 --> 00:11:45,720
تمهّلي لحظة

163
00:11:45,720 --> 00:11:48,220
...هذا... شيء كهذا

164
00:11:50,230 --> 00:11:51,600
هل يمكننا فعله حقّاً؟-
أجل، يمكنا

165
00:11:55,560 --> 00:11:59,650
في هذا اليوم المُشمس، تبدو السّماء الزّرقاء
مُمتدّة طولاً وعرضاً

166
00:11:59,900 --> 00:12:03,410
بطولة مجموعة السِّيرك
اليابانيّة النّسخة 24

167
00:12:03,660 --> 00:12:06,530
اليوم هو اليوم الأوّل من أداء النّهائي

168
00:12:03,660 --> 00:12:06,870
أداء النّهائي
اليوم الأوّل

169
00:12:06,870 --> 00:12:11,080
البثّ العامّ

170
00:12:07,120 --> 00:12:09,080
،بوجود مقعد في بطولة العالم على المحكّ

171
00:12:09,080 --> 00:12:11,080
...يتنافسان ليُصبحا الفِرقة الأولى في اليابان

172
00:12:11,290 --> 00:12:14,630
،سِيرك الوردة الزّرقاء، بقيادة نانامي سوميراغي

173
00:12:14,630 --> 00:12:18,300
وسِيرك زهرة عبّاد الشّمس بقيادة
ابنة اللّوتس السّوداء

174
00:12:21,010 --> 00:12:22,510
أتطلّع بشوق لمُنافستك

175
00:12:22,970 --> 00:12:24,470
أتمنّى لكِ حظّاً طيّباً

176
00:12:25,720 --> 00:12:29,720
سيُقام أداء النّهائي خلال الأيّام الخمسة المُقبلة

177
00:12:29,720 --> 00:12:31,850
لا يمكننا أن نغمض عيوننا حتّى النّهاية

178
00:12:40,190 --> 00:12:42,280
هل تعتقدين بأنّ زهرة عبّاد الشّمس ستفوز؟

179
00:12:49,200 --> 00:12:50,740
...بيئة هذه القصّة هي

180
00:12:51,370 --> 00:12:53,290
ساحر أوز

181
00:12:53,460 --> 00:12:58,380
اسم الفتاة الّتي قُذِفت بواسطة
زوبعة ضخمة في دوروثي

182
00:12:58,790 --> 00:13:02,670
مع كلبها العزيز، توتو، وصلتْ إلى الشّرق

183
00:13:03,130 --> 00:13:07,510
كانت تعيش حياةً سعيدة في منزل
صغير في مروج كانساس

184
00:13:07,510 --> 00:13:11,270
...مع عمّها هنري وعمّتها إيم

185
00:13:13,890 --> 00:13:16,020
،ساحرة الشّمال قد قالت لدوروثي

186
00:13:16,020 --> 00:13:21,230
ارتدي هذا الحذاء الفضّيّ الّذي"
،ارتدَتْه ساحرة الشّرق

187
00:13:21,230 --> 00:13:22,650
"الّتي كانت مرميّة هناك

188
00:13:23,490 --> 00:13:25,240
حسناً يا جماعة

189
00:13:25,240 --> 00:13:30,530
شجّعوهما رجاء وذلك كي يتمكّنا
من العودة إلى كانساس بالسّلامة

190
00:13:30,530 --> 00:13:32,450
!حسناً-
!دوروثي-

191
00:13:33,790 --> 00:13:37,080
أجل، إنّه النّهائي، لكن لم يتغيّر شيء

192
00:13:37,580 --> 00:13:40,960
،أدّينَ كما تفعلنَ في العادة
واحصدنَ ثِمار ذلك التّمرين

193
00:13:41,550 --> 00:13:46,180
لنحرص على ترفيه والتأثير بالجمهور هناك

194
00:13:46,340 --> 00:13:47,300
!عُلِم

195
00:13:49,720 --> 00:13:52,850
هل هذه الأصوات من خيمة زهرة عبّاد الشّمس؟

196
00:13:56,190 --> 00:14:00,110
حسناً إذاً، مع استمرار دوروثي
في سلوك طريق القرميد الأصفر

197
00:14:00,480 --> 00:14:04,820
تمرّ بفزّاعة يريد دِماغاً، لكن لا يستطيع
النّزول عن عموده

198
00:14:05,150 --> 00:14:06,950
...واحد، اثنان

199
00:14:08,240 --> 00:14:09,030
!هناك

200
00:14:23,340 --> 00:14:26,510
دوروثي أنقذت الفزّاعة

201
00:14:34,180 --> 00:14:35,390
تغلّبنا عليهم، صحيح؟

202
00:14:36,560 --> 00:14:39,100
تحويل الفصول إلى قصّة؟

203
00:14:39,350 --> 00:14:40,350
أجل

204
00:14:40,350 --> 00:14:41,610
ما معنى هذا؟

205
00:14:41,610 --> 00:14:43,070
ما قالَتْه بالضّبط

206
00:14:43,320 --> 00:14:48,030
ارتأينا بأنّ المُنافسة قد لا تتمحور
حول أيّ أداء أفضل فقط

207
00:14:50,110 --> 00:14:54,580
بصيغة أُخرى، فصول الأداء بحدّ ذاتها ليست
الطّريقة الوحيدة لترفيه الجمهور

208
00:14:54,910 --> 00:14:57,450
لا أملك فكرة عمّا تقولينه

209
00:14:57,450 --> 00:14:59,500
!كما قلت، هذا ما أقصده

210
00:15:00,580 --> 00:15:02,210
ساحر أوز؟

211
00:15:02,210 --> 00:15:05,300
هذا صحيح. القصّة الّتي أُحبّها

212
00:15:05,550 --> 00:15:08,800
أوكا وأنا رأينا الفيلم للتو

213
00:15:09,010 --> 00:15:11,680
وكنتُ مأسورة جدّاً بواسطته

214
00:15:12,140 --> 00:15:15,140
ما الّذي يجعله مُمتعاً برأيكن؟

215
00:15:15,680 --> 00:15:18,060
القصّة والشّخصيّات؟

216
00:15:18,060 --> 00:15:19,480
هذا صحيح

217
00:15:19,480 --> 00:15:23,900
هذا ما جعلَني أقول لنفسي، "لِمَ لا يُقدِّم
"السِّيرك هذا النّوع من المتعة أيضاً؟

218
00:15:26,860 --> 00:15:28,900
لديّ مُقترح آخر أيضاً

219
00:15:28,900 --> 00:15:30,820
التقرُّب من الجمهور

220
00:15:30,820 --> 00:15:36,080
السِّيرك هو أُحادي الجانب وعبارة عن استعراض
أمام الجمهور من المسرح

221
00:15:36,080 --> 00:15:37,830
أجل، هو كذلك بالطّبع

222
00:15:37,830 --> 00:15:41,500
لكن سنُحوّل المقاعد إلى مسرح أيضاً

223
00:15:41,870 --> 00:15:43,380
ليس مُجرّد مكان للمُشاهدة

224
00:15:43,380 --> 00:15:45,710
سِيرك حيث يمكنك الاستمتاع مع المُؤدّيين

225
00:15:49,130 --> 00:15:50,630
معها حقّ في ذلك

226
00:15:50,630 --> 00:15:54,680
شعرتُ بأنّ التّفاعل مع الجمهور كان مُمتعاً للغاية

227
00:15:54,680 --> 00:15:55,640
أجل

228
00:15:55,640 --> 00:15:58,430
تقصدين بأن نُدخل الجمهور كُلّه في أدائنا إذاً؟

229
00:15:58,430 --> 00:15:59,430
!أجل

230
00:15:59,430 --> 00:16:02,900
المسألة فقط أنّنا إذا كنّا سنستأنف
،الفصول وتستمرّ القصّة

231
00:16:02,900 --> 00:16:05,110
سنحتاج نصّاً متيناً

232
00:16:05,650 --> 00:16:08,820
هل ترغبين في توكيلي بالنصّ؟

233
00:16:08,980 --> 00:16:11,280
!أجل، شكراً جزيلاً لكِ

234
00:16:12,700 --> 00:16:14,320
كانت تلك هي الخطّة من البداية، صحيح؟

235
00:16:15,280 --> 00:16:16,080
أجل

236
00:16:16,740 --> 00:16:19,250
أرغب في إضافة الأفكار الّتي
توصّلنا إليها أيضاً

237
00:16:19,250 --> 00:16:21,830
أجل! استمررنَ في إيجاد مزيد من الأفكار

238
00:16:23,330 --> 00:16:26,960
بدأتُ أعتقد بأنّ هذا النّوع الجديد
من السِّيرك قد يفلح

239
00:16:26,960 --> 00:16:28,170
أجل

240
00:16:28,170 --> 00:16:29,300
!أنا أيضاً

241
00:16:29,300 --> 00:16:33,760
لنُواجه الآنسة نانامي بهذا السّيرك

242
00:16:36,760 --> 00:16:39,470
،رجل القصدير، الّذي يتوق لقلب
في ورطة الآن

243
00:16:39,810 --> 00:16:43,730
هلّا رميتُم كُرات الزّيت تلك عليه
كي يبدأ بالتحرُّك ثانية؟

244
00:16:43,730 --> 00:16:45,270
!خُذ-
!ها أنت ذا-

245
00:16:45,270 --> 00:16:46,400
!مرحى

246
00:16:47,150 --> 00:16:47,860
زيت

247
00:16:48,730 --> 00:16:49,610
خُذ

248
00:16:50,480 --> 00:16:53,490
!خُذ

249
00:16:54,610 --> 00:16:58,450
سيّد رجل القصدير، أنت جشع جدّاً. لا يمكننا
رؤية حتّى وجهك

250
00:16:59,620 --> 00:17:02,290
سيّد رجل القصدير، لنشكر الجمهور

251
00:17:07,750 --> 00:17:08,630
!خُذ

252
00:17:27,730 --> 00:17:31,190
ظهرَ أسدٌ بطريقة جبانة أمام دوروثي وصديقاتها

253
00:17:31,190 --> 00:17:32,610
أسد-
!جميلة للغاية-

254
00:17:33,650 --> 00:17:36,950
!أتُصدِّقون ذلك؟ هذا الأسد هاجمَ توتو للتو

255
00:17:43,160 --> 00:17:44,960
!آنسة شيزوكو

256
00:17:46,000 --> 00:17:49,710
لكن عندما تُوبّخه دوروثي، يبدأ بالعبوس

257
00:17:50,670 --> 00:17:56,720
،وهكذا قرّروا الذّهاب ورؤية السّاحر
لتحقيق أمانيهم

258
00:18:25,370 --> 00:18:26,710
!يمكنكم فعلها

259
00:18:35,300 --> 00:18:37,170
أيُعقَل هذا؟

260
00:18:37,470 --> 00:18:38,840
...جميعنا

261
00:18:38,840 --> 00:18:43,430
جميعنا نُكافح لبلوغ قمّة العالم
مع الآنسة نانامي

262
00:18:43,850 --> 00:18:46,890
لن أدع أحداً يعترض طريقنا

263
00:18:47,480 --> 00:18:52,480
ركوب قرد مُجنّح، ساحرة الغرب الشّرّيرة
تتعامل مع دوروثي بقسوة

264
00:18:52,650 --> 00:18:57,240
انظروا! دوروثي والآخرون قد سرقوا
مِكنسة السّاحرة الثّمينة

265
00:18:57,240 --> 00:18:59,990
من فضلكم استمرّوا في قذفها وذلك
كي لا تستطيع استرجاعها

266
00:19:00,450 --> 00:19:03,660
هيّا يا جماعة، السّاحرة تُطارد باستماتة

267
00:19:07,660 --> 00:19:09,670
!واظبوا على ذلك جميعاً

268
00:19:22,220 --> 00:19:23,850
،شكراً على مُساعدتكم جميعاً

269
00:19:23,850 --> 00:19:26,770
تمّ قهر ساحرة الغرب الشّرّيرة

270
00:19:27,980 --> 00:19:29,060
!هنا

271
00:19:34,060 --> 00:19:37,570
ستكون هناك استراحة لعشر دقائق الآن

272
00:19:50,540 --> 00:19:51,870
هذا مُستحيل، صحيح؟

273
00:20:13,810 --> 00:20:15,060
مسرح؟

274
00:20:15,060 --> 00:20:18,980
حسناً، رُبّما ليس مسرحاً، إنّما أقرب
إلى أسلوب المسرح

275
00:20:19,190 --> 00:20:22,990
كُنّ يؤدّينَ وفقاً لحبكة القصّة

276
00:20:23,530 --> 00:20:27,540
يستخدمنَ معدّات ويُحمّسن الجمهور بإشراكه

277
00:20:31,290 --> 00:20:33,330
شكراً على التّقرير

278
00:20:33,460 --> 00:20:34,210
العفو

279
00:20:38,380 --> 00:20:41,470
لا يمكن إشعال حماس الجمهور أكثر من ذلك، صحيح؟

280
00:20:41,470 --> 00:20:43,970
كمُؤدّية، لا شيء يتفوّق على لحظةٍ كهذه

281
00:20:43,970 --> 00:20:44,970
!أجل

282
00:20:45,970 --> 00:20:46,680
موتسومي؟

283
00:20:47,300 --> 00:20:48,100
نعم؟

284
00:20:48,470 --> 00:20:50,060
هل أنتِ قلقة بشأن زهرة عبّاد الشّمس؟

285
00:20:51,560 --> 00:20:53,890
لا تسمحي لنفسكِ بأنّ تُشتّتي
بواسطة أشياء أُخرى

286
00:20:53,890 --> 00:20:55,560
ركّزي على المسرح

287
00:20:55,860 --> 00:20:59,780
سـ-سامحيني رجاء

288
00:21:01,400 --> 00:21:04,450
الهدف الآن هو تحقيق أُمنية ماريا

289
00:21:05,030 --> 00:21:07,070
حلم أختي؟

290
00:21:19,800 --> 00:21:20,960
آنسة نانامي؟

291
00:21:24,010 --> 00:21:26,890
لا أصدِّق بأنّ المُؤدِّيين والجمهور واحدٌ الآن

292
00:21:27,090 --> 00:21:30,310
إذاً يستطيع السِّيرك جذب المُتفرّجين
بهذه الطّريقة أيضاً؟

293
00:21:29,260 --> 00:21:31,220
هذا مُمتع للغاية

294
00:21:30,310 --> 00:21:34,520
،هذا مُتوقَّع من ابنة اللّوتس السّوداء
أليس كذلك؟

295
00:21:31,220 --> 00:21:32,270
أجل

296
00:21:32,270 --> 00:21:34,520
الجمهور مُنغمس في ذلك أيضاً

297
00:21:49,280 --> 00:21:50,330
أختي

298
00:21:52,830 --> 00:21:54,210
كُشِفنا

299
00:21:56,420 --> 00:21:57,960
ماذا تفعلين؟

300
00:21:58,170 --> 00:21:59,710
لم ينتهِ عرضكِ

301
00:22:00,170 --> 00:22:02,840
لا تسمحي لنفسكِ بأن تُشتَّتي
بواسطة أشياء أُخرى

302
00:22:04,050 --> 00:22:05,300
لماذا أنتِ هنا؟

303
00:22:06,180 --> 00:22:09,140
هناك شيء يترتّب عليّ رؤيته بأمّ عيني فحسب