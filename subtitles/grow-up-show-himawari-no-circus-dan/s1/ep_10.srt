1
00:00:05,230 --> 00:00:08,980
بطولة مجموعة السِّيرك
اليابانيّة النّسخة 24
قائمة الفِرَق المُنافسة

2
00:00:08,980 --> 00:00:10,990
سِيرك زهرة عبّاد الشّمس
مُديرة الحلبة\ميزوكا تسوروماكي
ابنة اللّوتس السّوداء

3
00:00:19,870 --> 00:00:21,120
استديري إلى هنا

4
00:00:24,000 --> 00:00:26,460
ظريفة للغاية

5
00:00:27,290 --> 00:00:29,340
كما يُقال، "القالِب غالِب"؟

6
00:00:29,550 --> 00:00:30,880
سيكون العنوان الرّئيسيّ

7
00:00:30,880 --> 00:00:33,550
في الصّحُف غداً، "فتاة باهرة الجمال
"تظهر في مجموعة السِّيرك

8
00:00:33,800 --> 00:00:36,470
!ستُحدثين ضجّة كبيرة مع الصُّور وما شابه

9
00:00:37,260 --> 00:00:39,140
على رسلكِ

10
00:00:39,390 --> 00:00:42,390
"وتبيّنَ بأنّها ابنة اللّوتس السّوداء"

11
00:00:42,770 --> 00:00:45,600
تلك الجزئيّة الّتي لا تُعجبني -
آسفة -

12
00:00:46,730 --> 00:00:49,190
أنتِ. ثبّتي تنّورتكِ للأسفل

13
00:00:49,190 --> 00:00:50,150
ماذا؟

14
00:00:50,150 --> 00:00:52,400
!مارلين مونرو

15
00:00:52,400 --> 00:00:54,400
حسناً

16
00:00:55,780 --> 00:00:59,530
لا بأس به، لكن أعتقد بأنّ هذا الزيّ
يجعلكِ تبدين طفوليّة

17
00:01:00,030 --> 00:01:01,580
أوتظنّين ذلك؟

18
00:01:01,740 --> 00:01:04,210
كمُمثِّلة فِرقتنا، أعتقد بأنّكِ مُحقّة

19
00:01:04,660 --> 00:01:07,920
ستُقام قرعة مجموعة السِّيرك
علناً في نهاية المطاف

20
00:01:07,920 --> 00:01:10,630
قد يكون من الأفضل أن تتأنّقي
وتبدي أكثر نضجاً

21
00:01:11,050 --> 00:01:13,380
وما رأيكِ بارتداء بعض المُجوهرات؟

22
00:01:14,300 --> 00:01:16,680
ماذا؟ الآن تبدين كالأطفال حقّاً

23
00:01:16,680 --> 00:01:18,590
حسناً، إنّها الدُّمى الّتي حصلتُ
عليها من عربة في الشّارع

24
00:01:20,050 --> 00:01:22,560
أنتن تسخرن منّي فحسب، أليس كذلك؟
هذا واضح

25
00:01:34,860 --> 00:01:36,530
سأعود في الحال

26
00:01:39,990 --> 00:01:41,870
!تبدين رائعة يا ميزوكا

27
00:01:41,870 --> 00:01:42,700
!حسناً

28
00:01:42,700 --> 00:01:44,580
والآن اخرجي إلى هناك مرفوعة الرّأس

29
00:01:44,580 --> 00:01:46,710
أجل! شكراً جزيلاً لكِ

30
00:03:17,960 --> 00:03:22,930
بطولة مجموعة السِّيرك
اليابانيّة النّسخة 24
قرعة المُنافسات

31
00:03:22,930 --> 00:03:25,140
والآن حُدِّدَتْ كافّة مُنافساتنا

32
00:03:25,140 --> 00:03:26,600
سِيرك الوردة الزّرقاء
سِيرك مجد الصّباح الدّوليّ

33
00:03:26,600 --> 00:03:29,060
نتطلّع جميعنا وبلهفة لرؤية كُلّ فِرقة

34
00:03:29,060 --> 00:03:32,940
تُقدِّم أفضل أداء لديها بتذكرة تأهّلها
إلى بطولة العالم على المحكّ

35
00:03:29,060 --> 00:03:30,520
سِيرك زهرة عبّاد الشّمس
فِرقة الفاوانيا البهلوانيّة

36
00:03:38,360 --> 00:03:41,860
والآن اسمحوا لي أن أُعلن عن الفِرَق
في المُنافسة مرّةً أُخرى

37
00:03:39,740 --> 00:03:41,320
المعذرة. أستأذن

38
00:03:41,860 --> 00:03:43,030
مرحباً

39
00:03:42,530 --> 00:03:46,910
سِيرك الوردة الزّرقاء، سِيرك مجد
الصّباح الدّوليّ

40
00:03:43,660 --> 00:03:46,330
هذه وقاحةٌ منكِ. عودي حالاً

41
00:03:46,330 --> 00:03:50,160
سأعمل كمُديرة حلبة زهرة عبَّاد
،الشّمس بالنّيابة عن الآنسة ماريا

42
00:03:47,620 --> 00:03:52,040
،فِرقة البنفسج البهلوانيّة
سِيرك مجرّة الأرطنسيّة

43
00:03:50,160 --> 00:03:51,210
لذا أنا هنا لأبلغكِ

44
00:03:51,210 --> 00:03:53,420
أستطيع جمع هذه المعلومات من النّشرة

45
00:03:53,040 --> 00:03:57,800
،عرض ضوء النّجوم كوسموس
وفِرقة سحر السّوسن الرّومانسيّ

46
00:03:54,330 --> 00:03:56,380
انتهى المطاف بنا في مجموعتين
مُختلفتين، أليس كذلك؟

47
00:03:56,380 --> 00:03:57,800
بالطّبع

48
00:03:58,800 --> 00:04:00,510
هل أنتِ بمزاجٍ عكر؟

49
00:03:58,800 --> 00:04:03,180
،حديقة فننون الكاكينوها
فِرقة رقص ساسانكوا الهوائيّ

50
00:04:01,720 --> 00:04:03,510
هل أتيتِ إلى هنا لاستفزازي؟

51
00:04:03,510 --> 00:04:06,970
لا، أردتُ فقط أن أتمنّى لكلتينا
النّجاح في هذه البطولة

52
00:04:04,300 --> 00:04:08,390
عرض كاتيليا، فِرقة المُجازفات
ساكورا العذراء

53
00:04:06,970 --> 00:04:08,390
تتمنّين لنا النّجاح؟

54
00:04:08,850 --> 00:04:11,520
أنتِ؟ نجاحي أنا؟

55
00:04:09,520 --> 00:04:14,140
،مجموعة فنون الأحلام زنبق الوادي
وفِرقة الزّنبق البهلوانيّة

56
00:04:11,520 --> 00:04:14,140
أجل. لنبذل كلتانا قصارى جهدنا

57
00:04:14,980 --> 00:04:17,520
بما أنّ كلتينا من عائلة الآنسة ماريا

58
00:04:14,980 --> 00:04:19,110
اللّافندر اللّامعة، فنون كاميليا

59
00:04:20,230 --> 00:04:24,570
فِرقة الفاوانيا البهلوانيّة، وسِيرك
زهرة عبّاد الشّمس

60
00:04:20,570 --> 00:04:22,490
يبدو أنّكِ تريدين إزعاجي حقّاً

61
00:04:24,910 --> 00:04:26,450
سوف نربح مهما كلّفَ الأمر

62
00:04:33,080 --> 00:04:35,120
أين ميزوكا؟

63
00:04:35,120 --> 00:04:36,210
أتِلك هي؟

64
00:04:37,460 --> 00:04:39,800
هل هذا يحدث حقّاً في الصُّور الجماعيّة؟

65
00:04:39,800 --> 00:04:41,670
عيناها مُغمضتان ثانية

66
00:04:42,210 --> 00:04:44,630
الشّيء الوحيد الّذي يمكن
رؤيته حقّاً هو ساقكِ

67
00:04:45,300 --> 00:04:47,260
كُلّ ذلك التأنُّق راح سُدى

68
00:04:47,260 --> 00:04:48,600
!هذا غير صحيح

69
00:04:48,600 --> 00:04:50,640
هذه السّابق، تنبثق من تنّورتكِ

70
00:04:50,930 --> 00:04:52,730
!وذلك الكاحل الصّغير الضيِّق

71
00:04:52,730 --> 00:04:55,100
مُؤلم. أوكا، هذا مُؤلم

72
00:04:55,100 --> 00:04:58,020
ميزوكا، ساقاكِ هما الأفضل
في شرق آسيا كُلّها

73
00:04:58,230 --> 00:04:59,980
لكن ليس في العالم، صحيح؟

74
00:05:00,360 --> 00:05:06,070
ابنة اللّوتس السّوداء
ميزوكا تسوروماكي

75
00:05:00,690 --> 00:05:04,820
هنا، انظرنَ. إنّها صغيرة، لكن
هذه صورة ومُقابلة

76
00:05:06,660 --> 00:05:10,160
لكن كافّة الأسئلة كانت عن المُتناعِلة

77
00:05:11,620 --> 00:05:13,200
حسناً، ما باليد حيلة

78
00:05:13,200 --> 00:05:15,540
نحن الفِرقة الّتي تمكّنتْ من المُنافسة
في الجولة التّمهيديّة فقط

79
00:05:15,540 --> 00:05:18,130
لأنّ ابنة اللّوتس السّوداء عضوة

80
00:05:18,130 --> 00:05:20,710
هذا ما يتناقله النّاس عنّا في الشّارع

81
00:05:20,710 --> 00:05:23,260
حسناً، ليس وكأنّنا نستطيع إنكار ذلك

82
00:05:23,460 --> 00:05:25,760
ليس لديهم اهتمام في الفِرقة

83
00:05:26,380 --> 00:05:29,050
إذاً سيترتّب علينا فقط الإثبات
لهم بأنّهم مُخطِئون بموهبتنا

84
00:05:29,050 --> 00:05:31,010
نعتمد عليكِ يا ميزوكا

85
00:05:31,010 --> 00:05:32,640
حسناً

86
00:05:32,640 --> 00:05:34,020
!مهلاً الآن

87
00:05:37,480 --> 00:05:42,150
زهرة عبّاد الشّمس لن ترانا حتّى
الجولة الأخيرة

88
00:05:42,440 --> 00:05:45,860
أجل، هذا فقط إذا استطعنَ
التأهُّل إلى تلك المرحلة

89
00:05:46,280 --> 00:05:49,530
كانت لديهن الجرأة في الدّوس على مشاعرك

90
00:05:49,530 --> 00:05:52,910
ما أريد رؤيته هو تجرّعهن طعم الهزيمة

91
00:05:52,910 --> 00:05:55,790
لِقاء الإذلال الّذي سبّبنَه لنا
نحن، اللّافندر اللّامِعة

92
00:05:57,710 --> 00:06:00,710
...رغم ذلك، الآنسة ماريا

93
00:06:01,210 --> 00:06:03,920
أليس من الصّعب تصديق
ما فعلَتْه أختكِ كذلك؟

94
00:06:03,920 --> 00:06:05,670
إبطال العقد

95
00:06:11,220 --> 00:06:15,390
ليست إلّا مسألة دفعها لتوقيع اتّفاقيّة
الانتقال بعد المرحلة التّمهيديّة

96
00:06:15,390 --> 00:06:17,940
ماذا؟ إذاً ستُوقِّعين للتّعاقُد معها؟

97
00:06:17,940 --> 00:06:19,270
بكُلّ تأكيد

98
00:06:19,650 --> 00:06:21,480
فأنا أُدير هذا العمل

99
00:06:21,650 --> 00:06:23,980
...ابنة اللّوتس السّوداء تلك

100
00:06:24,110 --> 00:06:26,280
سأحرص على إسقاطها أرضاً

101
00:06:27,610 --> 00:06:31,740
هذا الحُكم الهادئ، الّذي لا تؤثِّر
،به أي عواطف

102
00:06:32,070 --> 00:06:35,370
بينما تكلّمتُ عن الرّغبة في رؤيتهن
يتعرّضنَ لإذلال

103
00:06:35,740 --> 00:06:37,160
أنا خجِلة جدّاً

104
00:06:37,160 --> 00:06:38,960
أتّفق في ذلك

105
00:06:38,960 --> 00:06:40,250
ماذا؟

106
00:06:40,250 --> 00:06:42,920
ما عبّرتُ عنه للتو كان رأيي كمالِكة مشروع

107
00:06:43,500 --> 00:06:45,250
ليس كمُؤدِّية

108
00:06:45,840 --> 00:06:49,550
لنبذل قصارى جهدنا"؟ "عائلة"؟"

109
00:06:53,550 --> 00:06:56,470
تلك الفتاة هي خليفة أختي؟

110
00:06:57,390 --> 00:06:59,190
لن أسمح بحدوث ذلك

111
00:07:05,520 --> 00:07:08,070
راقبي فحسب كيف سأُدمِّر روحها بالكامل

112
00:07:11,820 --> 00:07:13,070
ها أنا ذي

113
00:07:13,490 --> 00:07:14,660
حسناً

114
00:07:15,830 --> 00:07:17,200
لا تقلقي بشأن المسافة

115
00:07:17,200 --> 00:07:19,790
ركّزي فقط على الارتفاع والدّوران

116
00:07:33,340 --> 00:07:36,470
رُبّما ينبغي أن ننسى أمر
الالتفاف في النّهاية؟

117
00:07:37,010 --> 00:07:38,970
إنّه صعبٌ للغاية

118
00:07:39,270 --> 00:07:43,100
أجل، آسفة. لكن دعيني أواصل

119
00:07:43,650 --> 00:07:47,320
أريد الاعتياد على خدعتِنا الجديدة قبل
أن نُقارع الآنسة نانامي

120
00:07:47,780 --> 00:07:50,280
أنتِ لا تبقين في الهواء لفترة
طويلة فحسب

121
00:07:50,900 --> 00:07:53,910
سيستغرق إتقانكِ تِلك الحركة وقتاً

122
00:07:54,700 --> 00:07:56,870
دعيني أُستمرّ في المُحاولة حتّى آخر لحظة

123
00:07:58,830 --> 00:08:00,120
حسناً إذاً

124
00:08:00,370 --> 00:08:03,540
لنُضِف بعضاً من الزّخم ونحاول تسريع الأمور

125
00:08:03,540 --> 00:08:04,330
حسناً

126
00:08:11,300 --> 00:08:13,050
بئس الأمر

127
00:08:13,340 --> 00:08:16,180
بمزيد من الزّخم، أنا أقلّ ثباتاً

128
00:08:16,390 --> 00:08:18,260
لنأخذ استراحة قصيرة

129
00:08:20,680 --> 00:08:21,520
حسناً

130
00:08:23,190 --> 00:08:24,690
سنأخذ استراحةً الآن

131
00:08:24,690 --> 00:08:25,810
حسناً

132
00:08:28,400 --> 00:08:32,320
كنتُ مُتحمِّسة جدّاً لهذه الخدعة
الّتي ستتفوّق على زهرة اللّوتس

133
00:08:32,320 --> 00:08:33,990
لكن هذا لا يفلح

134
00:08:33,990 --> 00:08:36,240
لن يحدث ذلك بين ليلةٍ وضُحاها

135
00:08:36,780 --> 00:08:39,540
من الصّعب جعل ذلك حقيقة، صحيح؟

136
00:08:40,290 --> 00:08:44,710
أتعلمين؟ هذا مُرضٍ بالنّسبة لي

137
00:08:46,710 --> 00:08:51,710
حتّى الآن، كُلّ ما كان السِّيرك يعنيه لي
كان أداء المهام الّتي تُوكَل إليّ

138
00:08:52,460 --> 00:08:55,180
ومتى أنجزتُ مهمّة، كان
ذلك مُمتعاً بالنّسبة لي

139
00:08:55,800 --> 00:09:00,220
،لكنّني أبتكر حركةً معكِ الآن
ستكون هذه مُلكنا

140
00:09:00,510 --> 00:09:03,770
،يسرّني أن أقضي وقتي معكِ هكذا
وأنا أستمتع بهذا

141
00:09:04,100 --> 00:09:05,390
أنا أيضاً

142
00:09:06,350 --> 00:09:09,690
.لن يكون ذلك مُمتعاً لو أنّه كان سهلاً
لننظر للأمر من هذه النّاحية

143
00:09:10,020 --> 00:09:11,190
معكِ حقّ

144
00:09:11,690 --> 00:09:14,240
لنُحلِّق مئات المرّات دون الضّغط
على أنفسنا كثيراً

145
00:09:14,240 --> 00:09:15,280
!أجل

146
00:09:17,200 --> 00:09:18,410
المعذرة

147
00:09:18,410 --> 00:09:19,830
!مساء الخير

148
00:09:19,830 --> 00:09:23,540
الغرفة رقم 2

149
00:09:20,330 --> 00:09:23,540
ليس عليكن المجيء في كُلّ مرّة

150
00:09:24,040 --> 00:09:27,250
،الموقع الخاصّ بجولتنا التّمهيديّة قد أُعلِن
لذا نحن هنا للإبلاغ

151
00:09:27,250 --> 00:09:28,880
أين؟

152
00:09:28,880 --> 00:09:30,000
في يوكوهاما

153
00:09:31,460 --> 00:09:33,130
يا له من موقع ممتاز

154
00:09:33,130 --> 00:09:35,340
ويمكننا التطلُّع لجمهور كبير

155
00:09:35,340 --> 00:09:36,300
أجل

156
00:09:36,300 --> 00:09:41,310
،لكن سيكون الجمهور أكثر تدقيقاً
لذا ابقينَ مُركِّزات، اتّفقنا؟

157
00:09:41,310 --> 00:09:42,430
!عُلِم

158
00:09:43,430 --> 00:09:47,730
،بما أنّنا سننتقل إلى هناك
لن يكون من السّهل زيارتكِ

159
00:09:47,730 --> 00:09:49,150
لا تقلقنَ بشأن ذلك

160
00:09:49,440 --> 00:09:54,360
أحبّذ القول بأنّ الضّربة القاضية هي عدم القدرة على ترك
التّمرين تحت ذريعة زيارتي

161
00:09:54,650 --> 00:09:57,070
...ليس وكأنّنا نريد ترك التّمرين

162
00:09:57,070 --> 00:10:00,200
لكن مُديرة الحلبة الجديدة أكثر من صارمة

163
00:10:00,200 --> 00:10:01,580
أليس كذلك؟

164
00:10:01,580 --> 00:10:05,040
ولِمَ لا؟ الوقت يُداهمنا قبل المرحلة التّمهيديّة

165
00:10:05,290 --> 00:10:08,460
ستُنافسنَ فِرقة الفاوانيا البهلوانيّة أوّلاً، صحيح؟

166
00:10:08,460 --> 00:10:09,250
أجل

167
00:10:09,250 --> 00:10:14,710
فِرقة الفاوانيا البهلوانيّة

168
00:10:09,670 --> 00:10:13,170
الفِرقة الشّهيرة الّتي تأهّلتْ إلى
نصف النّهائي في العام الماضي؟

169
00:10:13,500 --> 00:10:14,710
أجل

170
00:10:15,260 --> 00:10:18,880
