1
00:00:01,140 --> 00:00:07,060
،قبل حوالي 10 أيّام
أثناء جولة تويوكاوا

2
00:00:13,860 --> 00:00:15,490
ما الّذي يجري هنا بالضّبط؟

3
00:00:16,030 --> 00:00:17,280
أجل

4
00:00:21,120 --> 00:00:24,500
هكذا إذاً. قد يكون الأمر هكذا فعلاً

5
00:00:24,920 --> 00:00:27,330
سنتّخذ الإجراءات بسرعة بحيث
نرتقي لتوقّعاتك

6
00:00:28,380 --> 00:00:32,340
هلّا سألتُ عن رأيكِ حول الشّروط
الّتي اقترحناها؟

7
00:00:33,550 --> 00:00:35,970
أجل. شكراً جزيلاً لك

8
00:02:19,780 --> 00:02:22,830
حسناً

9
00:02:27,750 --> 00:02:30,960
بئساً، أريد أكل شيء غير البطاطا

10
00:02:31,540 --> 00:02:34,840
بطاطا على الفطور والغداء والعشاء

11
00:02:34,960 --> 00:02:37,590
أعطي هذه لفرانسوا لاحقاً، اتّفقنا؟

12
00:02:37,590 --> 00:02:38,550
حسناً

13
00:02:38,550 --> 00:02:42,600
مُقارنة بنا، من المُؤكَّد أنّ وضعهن جيّد

14
00:02:42,600 --> 00:02:43,510
من؟

15
00:02:43,510 --> 00:02:44,680
انظري هنا

16
00:02:45,600 --> 00:02:49,730
هل يستطيع سوميراغي التفوُّق"
"سِيرك اللّوتس الأسطوريّ؟

17
00:02:50,020 --> 00:02:55,110
ماذا؟ لكن ألم يربح سيرك اللّوتس في مجموعة
السّيرك خمس مرّات على التّوالي؟

18
00:02:55,360 --> 00:02:58,030
ما زال ذلك الرّقم القياسيّ قائماً اليوم، أليس كذلك؟

19
00:02:58,030 --> 00:02:59,950
لا بُدّ أنّهم بمُستوى مُختلف، صحيح؟

20
00:03:00,280 --> 00:03:01,990
هذا صحيح

21
00:03:01,990 --> 00:03:06,290
مُجرّد اختيارهم لتمثيل اليابان في مجموعة
السّيرك هو شرف

22
00:03:06,290 --> 00:03:08,950
من المُذهل أن يكرّروا ذلك كأبطال

23
00:03:09,250 --> 00:03:12,500
رغم ذلك، كان ذلك قبل عشر سنوات

24
00:03:12,500 --> 00:03:16,460
تطوّرت التقنيّات منذ ذلك الحين، لذا ربّما
لم يعُد الأمر مُستحيلاً

25
00:03:16,460 --> 00:03:22,430
والآنسة نانامي من عائلة سوميراغي لديها
فُرصة جيّدة غالباً للوصول إلى هناك

26
00:03:16,460 --> 00:03:22,430
الآنسة نانامي سوميراغي

27
00:03:23,010 --> 00:03:26,640
،لكن بالنّسبة للأرجوحة البهلوانيّة الطّائرة
امتلاك كيمياء مع ماسِكك إجباريّ

28
00:03:28,560 --> 00:03:29,850
هذا صحيح

29
00:03:31,350 --> 00:03:34,400
،في هذه الحالة، شريك اللّوتس الأسود

30
00:03:34,400 --> 00:03:37,150
السّيّد إيدين ميتشر، سيكون مُلائماً، صحيح؟

31
00:03:37,940 --> 00:03:40,320
إيدين ميتشر؟

32
00:03:44,030 --> 00:03:46,370
هذا هو السّيّد إيدن ميتشر

33
00:03:47,330 --> 00:03:48,790
إنّه رائع

34
00:03:48,790 --> 00:03:50,290
أجنبيّ

35
00:03:50,290 --> 00:03:53,620
أعلم بأنّ اللّوتس الأسود رهيب، لكن هذا
الشّخص رائع للغاية أيضاً

36
00:03:53,620 --> 00:03:54,880
أليس كذلك؟

37
00:03:54,880 --> 00:04:00,420
بصفتي طائرة، لو أستطيع إيجاد ماسِك
كهذا، سأطير من الفرح

38
00:04:02,880 --> 00:04:04,680
قلتُ أطير من الفرح

39
00:04:06,470 --> 00:04:10,600
ميزوكا، كنتِ مع اللّوتس الأسود طوال
الوقت، أليس كذلك؟

40
00:04:11,270 --> 00:04:13,390
أجل

41
00:04:13,640 --> 00:04:14,770
لحسن حظّك

42
00:04:14,770 --> 00:04:18,440
لا أُصدِّق بأنّكِ كنتِ في نفس سيرك
رجل جذّاب كهذا

43
00:04:18,440 --> 00:04:21,150
لم أتوقّع أبداً بأنّه كان جذّاباً

44
00:04:21,150 --> 00:04:22,190
ماذا قلت؟

45
00:04:22,740 --> 00:04:26,240
من الأساس، من يعتقد بأنّ أباه جذّاب؟

46
00:04:29,030 --> 00:04:31,370
...ليس هذا فحسب، لكن كان أشبه بالمُتناعلة

47
00:04:35,080 --> 00:04:36,880
ماذا؟

48
00:04:37,380 --> 00:04:40,130
ميزوكا هي ابنة اللّوتس الأسود؟

49
00:04:40,130 --> 00:04:41,840
لا بُدّ أنّك تمزحين، صحيح؟

50
00:04:42,170 --> 00:04:44,050
هل كنتِ تعلمين يا آنسة رين؟

51
00:04:44,340 --> 00:04:48,720
أجل. لكن بدا أنّ ميزوكا لم تُرِد
ذكر ذلك بنفسها

52
00:04:49,430 --> 00:04:50,930
لذا بقيتُ مُتكتّمة على الأمر

53
00:04:54,940 --> 00:04:58,400
أجل، لكن رغم ذلك، هذه معلومة حسّاسة

54
00:04:58,400 --> 00:05:00,400
عقلي لا يستوعب ذلك

55
00:05:00,400 --> 00:05:02,740
...أنت... أنت

56
00:05:11,450 --> 00:05:14,370
لماذا لم تخبرينا عن ميزوكا؟

57
00:05:14,830 --> 00:05:16,920
في الواقع، كان الأمر مُعقّداً قليلاً

58
00:05:16,920 --> 00:05:19,000
،إنّها ليست بالقصّة الهامّة

59
00:05:19,000 --> 00:05:21,460
لكن سأخبركن يوماً ما، لذا هل
يمكنكن الانتظار حاليّاً؟

60
00:05:21,460 --> 00:05:22,840
حسناً

61
00:05:25,670 --> 00:05:30,760
طلب منّي اللّوتس الأسود الاعتناء بميزوكا
في الوقت الرّاهن

62
00:05:30,970 --> 00:05:33,560
إذاً قصّة ديونها كُلّها كذبة؟

63
00:05:33,560 --> 00:05:35,020
لا، هذه الجزئيّة صحيحة

64
00:05:35,230 --> 00:05:40,020
اللّوتس الأسود لا يُبالي لأيّ شيء عدا السِّيرك

65
00:05:40,230 --> 00:05:43,150
لا أحد يعلم إلى أين تذهب مُكتسباته

66
00:05:43,530 --> 00:05:45,240
مهلاً لحظة

67
00:05:45,240 --> 00:05:48,030
أنتِ واللّوتس الأسود بهذا التّقارب؟

68
00:05:48,030 --> 00:05:50,490
هذا جديد بالنّسبة لي

69
00:05:50,490 --> 00:05:52,950
بجدّية، من أنتِ بالضّبط؟

70
00:05:53,620 --> 00:05:55,500
حسناً، لنضع ذلك جانباً حاليّاً

71
00:05:55,500 --> 00:05:56,660
لا تفعلي رجاء

72
00:05:56,960 --> 00:05:59,420
أليست ميزوكا قيمة عظيمة؟

73
00:05:59,710 --> 00:06:01,630
بالنّسبة لنا، إنّها صفقة رابحة

74
00:06:01,920 --> 00:06:04,670
لا سيّما في ظلّ ظرفنا الماليّ

75
00:06:04,800 --> 00:06:06,670
،أنا آسفة لاضطراري لفعل هذا لها

76
00:06:06,670 --> 00:06:10,890
،لكن لدفعها للعمل في سِيركنا
سأستغلّ ذلك الدَّين

77
00:06:12,180 --> 00:06:13,930
هل أنتِ شيطانة؟

78
00:06:14,720 --> 00:06:19,520
الأمر الوحيد هو أنّني لم أكن أدري بأنّها
مُتردّدة جدّاً عن أداء أعمال السِّيرك

79
00:06:20,940 --> 00:06:24,860
عرضنا التّالي اقترب، لذا ماذا يجدر بنا
أن نفعل بشأن تلك الطّفلة العنيدة؟

80
00:06:25,320 --> 00:06:27,820
حسناً، اتّخذتُ خطوة استباقيّة

81
00:06:27,820 --> 00:06:29,860
يا له من وجه شرّير

82
00:06:30,110 --> 00:06:31,870
...على ذكر عرضنا التّالي

83
00:06:38,580 --> 00:06:39,830
لا داعي للقلق

84
00:06:40,420 --> 00:06:44,090
هذه المرّة، تمكّنتُ من الدّفع لهم سلفاً

85
00:06:44,460 --> 00:06:47,210
،رغم أنّ هناك حديقة ملاهٍ كبيرة في المنطقة

86
00:06:47,210 --> 00:06:50,550
تحقّقتُ من الجدول بأنّه لا مواعيد
لأداء فِرَق سِيرك هناك

87
00:06:50,970 --> 00:06:54,050
ولذا، لا أعتقد بأنّنا سنواجه أي مُشكلة
في جذب الزّبائن

88
00:06:59,690 --> 00:07:01,770
لا تقولي هذا وكأنّكِ تتباهين

89
00:07:08,360 --> 00:07:10,610
ميزوكا؟ هل تُمانعين؟

90
00:07:10,610 --> 00:07:12,530
أبداً. تفضّلي

91
00:07:13,740 --> 00:07:15,030
ماذا تقرئين؟

92
00:07:15,620 --> 00:07:19,290
هذا هو الكِتاب المُصوَّر الّذي كان معكِ
عندما أتيتِ إلينا

93
00:07:19,710 --> 00:07:22,290
أجل. ساحرة أوز

94
00:07:22,920 --> 00:07:26,050
أعطتني إيّاه أمّي عندما كنتُ صغيرة

95
00:07:27,920 --> 00:07:31,590
قرأتُه عدّة مرّات، ودائماً ما أحمله معي

96
00:07:31,760 --> 00:07:32,930
انظري كم هو مُمزَّق الآن

97
00:07:33,260 --> 00:07:34,600
هكذا إذاً

98
00:07:38,680 --> 00:07:40,020
ما طبيعة القصّة؟

99
00:07:41,690 --> 00:07:46,770
باختصار، تحكي عن البطلة دوروثي

100
00:07:46,770 --> 00:07:50,030
وخروجها في رحلة إلى موطنها مع أصدقاء

101
00:07:50,030 --> 00:07:51,860
إنّها مثل موموتارو

102
00:07:51,860 --> 00:07:55,200
في جزئية انضمام أصدقائها لها، أجل

103
00:08:00,410 --> 00:08:01,660
لِمَ لا نخلد إلى النّوم الآن؟

104
00:08:02,750 --> 00:08:03,830
ميزوكا

105
00:08:04,420 --> 00:08:05,380
نعم؟

106
00:08:06,880 --> 00:08:10,340
إذاً أنتِ ابنة اللّوتس الأسود؟

107
00:08:10,710 --> 00:08:11,720
أجل

108
00:08:12,010 --> 00:08:13,880
زلّ لساني، أليس كذلك؟

109
00:08:14,220 --> 00:08:15,850
أخذني ذلك على حين غرّة

110
00:08:16,970 --> 00:08:19,350
المعذرة. اسمعيني جيّداً

111
00:08:20,220 --> 00:08:23,390
،منذ رأيتُه كطفلة

112
00:08:23,390 --> 00:08:28,520
ذُهِلتُ بالفصل الّذي أدّاه أبوكِ، زهرة اللّوتس

113
00:08:30,900 --> 00:08:33,070
أجل، أعلم

114
00:08:33,650 --> 00:08:37,780
صادف أن سمعتك تتكلّمين مع كاسومي
في ذلك اليوم

115
00:08:38,700 --> 00:08:40,740
إنّه الفصل الّذي لطالما حلمتُ به

116
00:08:41,080 --> 00:08:44,710
عندما أطير، دائماً ما أتخيّل ذلك
الفصل في ذهني

117
00:08:45,120 --> 00:08:48,040
،ثمّ عندما حلّقتُ معكِ

118
00:08:48,040 --> 00:08:51,300
شعرتُ بشيء مُميّز لم أشعر به من قبل

119
00:08:51,670 --> 00:08:54,680
،لهذا السّبب، عندما اكتشفتُ بأنّكِ كنتِ ابنته

120
00:08:54,680 --> 00:08:56,930
"قلتُ لنفسي، "حسناً، لا عجب

121
00:08:56,930 --> 00:08:58,800
...إذا استطعتِ وأنا

122
00:09:15,030 --> 00:09:18,780
سِيرك زهرة عبّاد الشّمس

123
00:09:16,950 --> 00:09:18,780
هل الآنسة ماريا صاحية؟

124
00:09:18,780 --> 00:09:22,790
بودرة أسنان ماركة النّمر

125
00:09:19,410 --> 00:09:22,790
دائماً ما تُخبرنا كم هي مُرهَقة مؤخّراً، صحيح؟

126
00:09:23,080 --> 00:09:26,250
أنا واثقة بأنّ تلك المُجازفة الّتي قامت بها
أكاني في الأسبوع الماضي لم تنفع أيضاً

127
00:09:26,250 --> 00:09:27,790
آسفة-
آسفة-

128
00:09:28,710 --> 00:09:32,710
تقول الآنسة رين بأنّه ما زال
ذلك مُؤلماً منذ ذلك اليوم

129
00:09:35,050 --> 00:09:37,720
ماذا سنتناول على الفطور اليوم يا تُرى؟

130
00:09:37,720 --> 00:09:39,470
!بطاطا

131
00:09:44,310 --> 00:09:46,020
!لم أركِ منذ وقت

132
00:09:46,140 --> 00:09:47,230
!ها أنتِ ذي

133
00:09:49,940 --> 00:09:50,610
!هيّا

134
00:09:51,230 --> 00:09:54,190
!ما الّذي يجري؟ ساعديني

135
00:09:54,740 --> 00:09:56,070
!إنّه مُنتهك

136
00:09:56,070 --> 00:09:57,780
!استدعوا الشّرطة

137
00:09:58,740 --> 00:10:01,030
ماذا؟ لحظة، أهذا أنت يا ميتشي؟

138
00:10:01,830 --> 00:10:04,250
مرحباً يا ميزوكا

139
00:10:06,210 --> 00:10:08,000
ماذا؟ أتعرفينه؟-
إنّه ضخم-

140
00:10:08,000 --> 00:10:10,710
مضى وقت طويل. كيف حالكِ؟

141
00:10:14,000 --> 00:10:15,800
ما هذه النّظرة في وجهكِ؟

142
00:10:15,800 --> 00:10:17,300
!ابتسمي

143
00:10:17,300 --> 00:10:18,680
توقّف من فضلك

144
00:10:18,680 --> 00:10:20,470
ميزوكا، من هذا؟-
صديق؟-

145
00:10:20,470 --> 00:10:22,140
هل نستدعي الشّرطة؟

146
00:10:22,510 --> 00:10:23,680
هذه ميتشي

147
00:10:24,180 --> 00:10:26,060
إيدين جيت ميتشر

148
00:10:26,060 --> 00:10:27,230
صباح الخير

149
00:10:27,230 --> 00:10:28,310
ماذا؟

150
00:10:28,310 --> 00:10:30,270
الشّخص الّذي كنتِ تتكلّمين عنه في الأمس؟

151
00:10:30,270 --> 00:10:32,610
تقصدين شريك اللّوتس الأسود؟

152
00:10:33,320 --> 00:10:34,820
سررتُ بلقائكن

153
00:10:35,150 --> 00:10:37,150
لا، مهلاً لحظة

154
00:10:40,820 --> 00:10:42,870
لا يشبه الصّورة إطلاقاً

155
00:10:45,040 --> 00:10:48,620
على ذكركِ للأمر، أبدو أكبر بكثير
الآن، أليس كذلك؟

156
00:10:48,830 --> 00:10:50,120
أهذا هو همُّك؟

157
00:10:50,120 --> 00:10:51,500
التغيُّر جذريّ، أليس كذلك؟

158
00:10:51,710 --> 00:10:53,750
ماذا تفعل هنا فجأة؟

159
00:10:53,750 --> 00:10:57,880
ألا ينبغي أن تعمل في ألبانيا
أو دوقيّة أُخرى الآن؟

160
00:10:58,130 --> 00:11:02,010
بكلّ تأكيد، قطعتُ كلّ هذه المسافة
لأنّني اشتقتُ لرؤية وجهك

161
00:11:02,220 --> 00:11:04,720
حسناً. رأيته الآن، لذا وداعاً

162
00:11:04,720 --> 00:11:06,890
مهلاً، مهلاً، لا تكوني قاسية القلب

163
00:11:07,020 --> 00:11:09,390
يجب عليّ الذّهاب في جولة تسوُّق الآن

164
00:11:12,810 --> 00:11:14,320
هل هي هكذا دوماً؟

165
00:11:15,770 --> 00:11:17,280
أجل، تكون لئيمة أحياناً، لكنّها ظريفة في الواقع

166
00:11:15,770 --> 00:11:17,280
لا تنفك تُثير المتاعب لأنّها
لا تُجيد قراءة مُحيطها

167
00:11:17,280 --> 00:11:18,820
أجل، هكذا هي عادة

168
00:11:17,280 --> 00:11:18,820
إنّها عبقريّة في الأنانيّة وتزعجنا

169
00:11:18,820 --> 00:11:20,240
لا، هذا غير صحيح

170
00:11:18,820 --> 00:11:20,240
دائماً ما تجعلني أُساعدها في أداء تمارين
التمدُّد، لكن ليس وكأنّني أُمانع

171
00:11:20,240 --> 00:11:21,780
كلّ واحدة على حِدة

172
00:11:21,990 --> 00:11:26,160
لكن كان تدريب ميزوكا مُفيداً جدّاً لنا جميعاً

173
00:11:27,120 --> 00:11:29,460
تدريب؟ هي تقوم بذلك؟

174
00:11:30,040 --> 00:11:31,750
إنّها لا تؤدّي إذاً؟

175
00:11:31,750 --> 00:11:35,210
لا. أقصد بأنّها تؤدّي أيضاً

176
00:11:36,750 --> 00:11:40,380
المعذرة، ماذا حدث لميزوكا بالضّبط؟

177
00:11:40,880 --> 00:11:43,470
ما زالت تُعاني من هذه الصّدمة من التّدريب

178
00:11:43,470 --> 00:11:46,060
وتقول بأنّها تكره السِّيرك

179
00:11:46,060 --> 00:11:47,140
!يا إلهي

180
00:11:48,520 --> 00:11:50,680
صدمة إذاً؟

181
00:11:51,390 --> 00:11:53,810
حسناً، هل ترغبنَ في رؤية ذلك بأنفسكن؟

182
00:11:57,070 --> 00:12:00,440
أنتِ مُحترفة، صحيح؟ لذا لا تتحرّكي

183
00:12:00,440 --> 00:12:01,530
حسناً

184
00:12:01,950 --> 00:12:04,490
عجباً لماريا تلك

185
00:12:05,030 --> 00:12:08,830
من كان يتوقّع بأنّها ستستدعي شريك الأسطورة؟

186
00:12:09,120 --> 00:12:11,960
أتساءل ما طبيعة العلاقة بينهما

187
00:12:12,540 --> 00:12:14,290
أظنّني سأضع عصابة عينين أيضاً

188
00:12:15,670 --> 00:12:18,420
!الحركة السّرّيّة! سكّينة التّفّاح المُدهشة

189
00:12:28,970 --> 00:12:30,180
!بانجي بلا حبال

190
00:12:30,180 --> 00:12:31,640
!الحبل

191
00:12:31,640 --> 00:12:32,940
!مرّة أُخرى

192
00:12:40,480 --> 00:12:42,240
ها أنا ذا. هيّا

193
00:12:42,240 --> 00:12:44,030
لماذا أنا؟ لماذا؟ لماذا؟

194
00:12:46,160 --> 00:12:49,490
إذا فعلوا هذا بها وهي طفلة، فلا عجب
في أنّها أُصيبَتْ بصدمة

195
00:12:51,870 --> 00:12:54,080
لم أُمارس تمريناً كهذا منذ مدّة

196
00:12:55,540 --> 00:12:56,960
المعذرة يا سيّد ميتشر؟

197
00:12:57,540 --> 00:12:58,500
نعم؟

198
00:12:58,710 --> 00:13:02,170
عندما كنتُ صغيرة، شاهدتُ فصل زهرة اللّوتس

199
00:13:03,010 --> 00:13:05,890
لهذا قرّرتُ أن أُصبح مُؤدّية سيرك

200
00:13:06,050 --> 00:13:08,760
حسناً، يسرّني سماع ذلك. شكراً لكِ

201
00:13:08,760 --> 00:13:10,100
!العفو

202
00:13:10,100 --> 00:13:12,770
اسمي أوكا كاواسومي

203
00:13:13,390 --> 00:13:18,270
وهل ترغب في إلقاء نظرة إلى أدائي الهوائيّ؟

204
00:13:23,110 --> 00:13:25,490
في الواقع، أنا هنا في إجازة

205
00:13:25,490 --> 00:13:27,990
ناهيك عن أنّ أسعاري غالية

206
00:13:27,990 --> 00:13:29,990
حسناً، بالطّبع

207
00:13:30,660 --> 00:13:33,040
أعتذر لأنّني طلبتُ طلباً وقحاً كهذا

208
00:13:33,040 --> 00:13:33,910
ما هذا؟

209
00:13:33,910 --> 00:13:37,250
بالنّسبة لمُؤدٍّ أسطوريّ، أنت بخيل جدّاً، أليس كذلك؟

210
00:13:40,500 --> 00:13:43,260
أنا ماريا، مُديرة هذه الفِرقة

211
00:13:43,260 --> 00:13:45,510
ما-ري-ا

212
00:13:46,300 --> 00:13:48,840
ماذا؟ سررتُ بلقائكِ

213
00:13:49,260 --> 00:13:53,640
حسناً؟ قطعت كلّ هذه المسافة، لذا ما رأيك
أن ترى ما تستطيع هذه الفتاة فعله؟

214
00:13:53,640 --> 00:13:56,020
إنّها أكثر تحفيزاً من ميزوكا

215
00:13:57,020 --> 00:13:59,310
مُقابل مبيت لليلة واحدة ووجبة. ما رأيك؟

216
00:14:01,070 --> 00:14:05,490
حسناً إذاً. لا أستطيع رفض طلب مُديرة
الفِرقة بحدّ ذاتها، صحيح؟

217
00:14:05,740 --> 00:14:07,400
اذهبي واستعدّي

218
00:14:07,400 --> 00:14:09,570
!حاضرة! شكراً جزيلاً لك

219
00:14:09,570 --> 00:14:12,410
ثمّة أمر واحد. لا تُخيّبي أملي فحسب، اتّفقنا؟

220
00:14:13,700 --> 00:14:14,660
حاضرة

221
00:14:15,660 --> 00:14:18,870
لا يعلم بأنّنا نأكل بطاطا فقط

222
00:14:27,510 --> 00:14:28,680
ها أنا ذي

223
00:14:28,680 --> 00:14:29,720
!حسناً

224
00:14:40,940 --> 00:14:42,400
هذا جميل جدّاً

225
00:14:49,610 --> 00:14:51,070
مُبهر

226
00:15:12,600 --> 00:15:15,720
فاجأتِني لوهلة هناك

227
00:15:16,220 --> 00:15:17,430
...ماذا؟ المعذرة

228
00:15:39,120 --> 00:15:40,750
شكراً جزيلاً لك

229
00:15:46,340 --> 00:15:48,760
أجل، جسدكِ مُدرَّب بما يكفي

230
00:15:48,960 --> 00:15:51,840
!أجل. شكراً جزيلاً لك

231
00:15:52,470 --> 00:15:54,720
بالإضافة إلى تلك الحركة الاستفزازيّة

232
00:15:54,720 --> 00:15:56,760
لديكِ أعصاب فولاذيّة

233
00:15:56,760 --> 00:15:58,310
!أنا آسفة جدّاً

234
00:15:58,560 --> 00:16:00,350
كان ذلك مُمتعاً جدّاً لدرجة
لم أستطع منع نفسي

235
00:16:00,640 --> 00:16:03,690
لكن لديكِ عادات غير مرغوب فيها

236
00:16:05,150 --> 00:16:07,860
هذه غلطتي أنا

237
00:16:08,280 --> 00:16:10,950
،لكن منذ تولّتْ ميزوكا دور ماسِكتها

238
00:16:10,950 --> 00:16:13,610
كانت قادرة على الأداء بلا قيود

239
00:16:14,870 --> 00:16:17,030
إذاً ماذا تفعلين الآن؟

240
00:16:17,030 --> 00:16:22,460
بدأتُ أتمرّن على الشّرائط البهلوانيّة مع سوفيتلانا هنا

241
00:16:27,840 --> 00:16:29,420
،حسناً، في نفس الوقت

242
00:16:29,420 --> 00:16:32,300
أظنّني سألقي نظرة إلى الشّرائط
البهلوانيّة مع يامادا

243
00:16:32,720 --> 00:16:33,840
استعددنَ

244
00:16:33,840 --> 00:16:35,430
يامادا؟-
من؟-

245
00:16:35,430 --> 00:16:36,550
من يامادا؟

246
00:16:37,970 --> 00:16:39,560
شكراً جزيلاً

247
00:16:39,970 --> 00:16:42,730
هل تُمانعين تبديل ملابسك؟

248
00:16:42,730 --> 00:16:43,890
عُلِم

249
00:17:02,910 --> 00:17:03,830
جميل

250
00:17:03,830 --> 00:17:05,000
مُدهش

251
00:17:05,000 --> 00:17:07,380
وقد بدأتا بالتّمرين للتو فحسب

252
00:17:07,380 --> 00:17:09,340
أجل، مُذهل للغاية

253
00:17:14,970 --> 00:17:15,890
!ميزوكا

254
00:17:17,890 --> 00:17:18,720
نعم؟

255
00:17:18,720 --> 00:17:20,850
ما رأيك بذلك الأداء؟

256
00:17:21,850 --> 00:17:25,690
أسأل ما إن كان لديكِ أي نصيحة لهما؟

257
00:17:22,520 --> 00:17:23,930
عادت إذاً؟

258
00:17:23,930 --> 00:17:25,690
ماذا تفعل؟

259
00:17:27,190 --> 00:17:28,770
حسناً، أجل

260
00:17:30,360 --> 00:17:34,650
بدوتما رائعتين لأنّكما مُتزامنتان بشكل مثاليّ

261
00:17:34,650 --> 00:17:37,240
كنتُما رشيقتين، وطريقة التّلويح
بشرائطكما كانت جميلة

262
00:17:37,620 --> 00:17:38,740
ثمّة أمر واحد

263
00:17:38,740 --> 00:17:40,950
،وهو أنّكما إذا شدّدتُما أكثر على ليونة جسديكما

264
00:17:40,950 --> 00:17:42,410
لكان أداؤكما أفضل حتّى

265
00:17:43,000 --> 00:17:44,160
أهذا كلُّ شيء؟

266
00:17:45,250 --> 00:17:46,170
أجل

267
00:17:46,870 --> 00:17:48,290
سيّئ

268
00:17:48,290 --> 00:17:49,710
سيّئ تماماً

269
00:17:49,710 --> 00:17:50,960
هذا ينطبق عليكِ

270
00:17:50,960 --> 00:17:52,300
وعلى ذلك الأداء

271
00:17:52,300 --> 00:17:53,420
ماذا؟

272
00:17:53,760 --> 00:17:55,340
،أوّلاً، كما قالت فحسب

273
00:17:55,340 --> 00:17:58,800
بالنّسبة لليونة جسديكما، هناك مجال للتّحسين

274
00:17:58,800 --> 00:18:00,510
أصابت في ذلك

275
00:18:00,510 --> 00:18:03,430
لكن هناك عيب أكبر في ذلك الأداء

276
00:18:03,850 --> 00:18:05,480
ما هو هذا العيب؟

277
00:18:05,480 --> 00:18:08,100
الكلام سهل إذا كنت ستقوله بشكل مُتقطِّع

278
00:18:09,270 --> 00:18:11,570
حسناً، دعيني أريكِ

279
00:18:13,900 --> 00:18:16,200
همس، همس

280
00:18:17,740 --> 00:18:18,660
حسناً

281
00:18:19,660 --> 00:18:20,780
آسفة

282
00:18:21,950 --> 00:18:23,990
كنتُ مُتوتّرة للغاية رغماً عنّي

283
00:18:23,990 --> 00:18:25,370
أنا مُحرَجة جدّاً

284
00:18:25,370 --> 00:18:28,170
كان كلّ ما استطعتُ فعله للبقاء
هادئة بحدِّ ذاتي

285
00:18:28,750 --> 00:18:31,380
أكاد لا أُصدِّق بأنّ السّيّد ميتشر ييشاهد أداءنا

286
00:18:53,190 --> 00:18:54,860
!هذا أفضل لسبب ما

287
00:18:54,860 --> 00:18:57,070
كان أروع من السّابق

288
00:18:57,070 --> 00:18:58,530
مُبهر للغاية

289
00:19:19,510 --> 00:19:21,220
شكراً جزيلاً لك

290
00:19:21,220 --> 00:19:23,430
لا شكر على واجب

291
00:19:24,310 --> 00:19:27,980
مع ذلك، مستواكِ لا يتدهور إطلاقاً يا يامادا

292
00:19:28,930 --> 00:19:30,100
يامادا ثانية؟

293
00:19:30,100 --> 00:19:31,690
هل يقصد أختي سوفيت؟

294
00:19:31,690 --> 00:19:34,690
المعذرة، أرجو ألّا تذكر هذا الاسم هنا؟

295
00:19:34,820 --> 00:19:36,940
ماذا؟ لا تعلمين بأمرها؟

296
00:19:37,190 --> 00:19:38,190
سوفيتلانا

297
00:19:37,190 --> 00:19:39,530
سوفيتلانا روزين يامادا

298
00:19:38,190 --> 00:19:39,950
سوفيتلانا
روزين يامادا

299
00:19:40,780 --> 00:19:42,700
،في عمر العاشرة

300
00:19:42,700 --> 00:19:46,490
كانت نجمة في سِيرك لانديشي الأعلى
تصنيفاً في الاتّحاد السّوفييتي

301
00:19:46,660 --> 00:19:50,330
وحتّى أنّها نافست في نهائي
مجموعة السِّيرك مرّتان

302
00:19:50,330 --> 00:19:51,670
ماذا؟

303
00:19:53,580 --> 00:19:55,000
هذا مُذهل يا أخت سوفيت

304
00:19:54,500 --> 00:19:57,760
مهلاً يا فتيات، ألا ترين بأنّ سوفيتلانا مُرتبكة؟

305
00:19:55,000 --> 00:19:56,840
لا، تقصد يامادا

306
00:19:57,760 --> 00:19:59,300
يامادا ليست الوحيدة

307
00:19:59,300 --> 00:20:02,840
هذه التّشكيلة بأكملها الّتي جمعتِها
ممتازة للغاية يا آنسة مُديرة فِرقة

308
00:20:04,350 --> 00:20:05,680
،إن تمّ تدريبهن بشكل صحيح

309
00:20:05,680 --> 00:20:09,020
فقد يجدنَ أنفسهن مُرشّحات للوصول
إلى نهائي مجموعة السّيرك يوماً ما

310
00:20:10,180 --> 00:20:12,020
بطولة العالم؟

311
00:20:12,020 --> 00:20:13,520
تقصد نحن؟

312
00:20:14,480 --> 00:20:18,980
هذا في حال استطاعت مُديرتكن
السّيطرة على زمام الأمور

313
00:20:19,820 --> 00:20:22,150
ماذا قلت لتلكما الاثنتين؟

314
00:20:22,280 --> 00:20:23,530
ألا تعلمين؟

315
00:20:26,660 --> 00:20:28,660
أنتِ لا تملكين المُقوِّمات

316
00:20:28,660 --> 00:20:32,370
،كفّي عن هدر وقتكِ في التّدريب
وركّزي على الأداء في المسرح

317
00:20:32,830 --> 00:20:34,790
على الأقلّ ستكونين مقبولة أكثر حينها

318
00:20:36,790 --> 00:20:39,460
مقبولة؟ تقصد ميزوكا؟

319
00:20:39,710 --> 00:20:41,840
لا أريد أن أكون مُؤدّية

320
00:20:42,170 --> 00:20:44,640
لكن ظننتُ بأنّكِ كنتِ تُحلّقين
مع الآنسة كاواسومي؟

321
00:20:44,640 --> 00:20:49,310
،هذا لأنّ ذلك حدث بالصّدفة. أو في الواقع
تمّ إجباري على ذلك

322
00:20:49,970 --> 00:20:52,310
تعلمين بأنّكِ وقحة مع الآنسة كاواسومي، صحيح؟

323
00:20:54,560 --> 00:20:55,650
المعذرة

324
00:21:02,860 --> 00:21:06,620
هل هذا لأنّ والدك انتزع المكان
الّذي تُقدّرينه كثيراً؟

325
00:21:08,530 --> 00:21:10,410
إذاً أنت تعلم بالفعل

326
00:21:11,700 --> 00:21:14,040
إذاً لماذا ما زلتِ باقية مع هذه الفِرقة؟

327
00:21:14,210 --> 00:21:17,040
إن كنتِ لا تطيقين السِّيرك، فلِمَ
لا تُغادرين فحسب؟

328
00:21:17,040 --> 00:21:22,510
لأنّ... في الواقع... لأنّني مَدينة
بدَين شخصيّ لهذه الفِرقة

329
00:21:22,720 --> 00:21:25,010
ويجب عليّ تسديده

330
00:21:25,010 --> 00:21:27,510
إذاً دعيني أسدِّد لكِ هذا الدَّين

331
00:21:27,510 --> 00:21:29,220
بهذا الشّكل، ستكونين حُرّة للاستقالة، صحيح؟

332
00:21:29,930 --> 00:21:31,430
همس، همس، همس

333
00:21:31,640 --> 00:21:34,980
إذاً دعيني أسدِّد هذا لأجلكِ على شكل أقساط

334
00:21:34,980 --> 00:21:36,440
بهذا الشّكل، ستكونين حُرّة للاستقالة، صحيح؟

335
00:21:37,520 --> 00:21:40,110
،لا تقلقي، حالما تستقيلين

336
00:21:40,110 --> 00:21:42,940
سيكون من دواعي سروري تولِّي
واجبات التّدريب خاصّتكِ هنا

337
00:21:49,280 --> 00:21:53,290
قبل أيّ شيء، ما زلتِ لا تفهمين
جوهر السِّيرك

338
00:21:54,960 --> 00:21:56,870
ما الّذي ينقصني لتقول ذلك؟

339
00:21:57,580 --> 00:21:58,750
هل تريدين أن تعرفي؟

340
00:22:01,800 --> 00:22:03,960
...إذاً دعيني أعلّمكِ

341
00:22:06,010 --> 00:22:08,220
معنى السِّيرك الحقيقيّ...