!كان ذلك مُمتعاً

177
00:14:34,010 --> 00:14:35,020
أجل

178
00:14:45,440 --> 00:14:48,900
رابطة مجموعة السِّيرك اليابانيّة

179
00:14:51,660 --> 00:14:55,870
بئس الأمر، إذاً هذه هي نهاية
سِيرك زهرة عبّاد الشّمس

180
00:14:55,870 --> 00:14:58,370
لا حاجة لهذا التّشاؤم

181
00:14:58,830 --> 00:15:02,590
أجل. ليس وكأنّنا لا نستطيع الأداء
في السِّيرك بعد الآن

182
00:15:02,590 --> 00:15:05,380
هل ستسلك كُلُّ واحدة منّا
طريقاً مُنفصلاً الآن؟

183
00:15:05,380 --> 00:15:07,840
لكن قد يُحقِّق هذا الاستقرار في حياتنا

184
00:15:07,840 --> 00:15:10,090
قد لا يبدو الأمر سيّئاً كما نعتقد

185
00:15:14,260 --> 00:15:16,100
تلك الصّفقة ملغيّة

186
00:15:17,020 --> 00:15:18,230
آنسة نانامي؟

187
00:15:18,810 --> 00:15:20,310
ماذا تقصدين؟

188
00:15:20,310 --> 00:15:21,980
ما قلتُه تماماً

189
00:15:22,310 --> 00:15:24,440
سوميراغي لا تحتاجكن

190
00:15:25,020 --> 00:15:26,280
ماذا يُفترض أن يعني هذا؟

191
00:15:26,730 --> 00:15:31,070
،بعد رؤية العرض الّذي قدّمتنه
كيف لنا أن نتبنّاكن؟

192
00:15:31,490 --> 00:15:34,240
إن كنتُن ستُعرقلن سوميراغي بهذه
الطّريقة، فلن أتحمّل ذلك

193
00:15:34,830 --> 00:15:36,830
قالتْ عرقلة

194
00:15:36,830 --> 00:15:38,080
معها حقّ

195
00:15:38,080 --> 00:15:40,080
من فضلك لا تطعنيني من الخلف

196
00:15:40,750 --> 00:15:43,670
في المرّة المُقبلة، سأربح
بأكثر طريقة حاسمة

197
00:15:44,170 --> 00:15:48,920
حينئذ فقط سأتمكّن من إعلان
النّصر ورأسي مرفوع

198
00:15:51,130 --> 00:15:52,510
حسناً إذاً

199
00:15:52,510 --> 00:15:54,850
،سنُتابع بطريقتنا الخاصّة في السِّيرك

200
00:15:54,850 --> 00:15:59,390
ونكسب هُتافات أكبر ممّا ستحصلون
بزهرة اللّوتس خاصّتكم

201
00:16:00,310 --> 00:16:01,940
أتطلّع لذلك بلهفة

202
00:16:06,400 --> 00:16:09,150
ماذا؟ إذاً ماذا سيحلُّ بنا؟

203
00:16:09,150 --> 00:16:11,900
هل هذا يعني بأنّنا نستطيع الاستمرار
في الأداء كزهرة عبّاد الشّمس؟

204
00:16:11,900 --> 00:16:14,910
في الواقع، هكذا يبدو

205
00:16:20,500 --> 00:16:22,670
كنّا وشيكين

206
00:16:23,290 --> 00:16:27,420
أجل. لكن أتعلمين؟ بذلنا جهدنا حقّاً

207
00:16:28,420 --> 00:16:33,630
أنا متأكّدة بأنّ الآنسة ماريا
كانت لتُخبرنا بأنّنا أبلينا حسناً

208
00:16:35,340 --> 00:16:36,720
معكِ حقّ. كانت لتفعل ذلك

209
00:16:37,010 --> 00:16:41,100
،آنسة ماريا، من فضلكِ راقبينا
دائماً وأبداً

210
00:16:41,680 --> 00:16:43,480
!مُؤلم

211
00:16:43,730 --> 00:16:46,400
هذا مُؤلم -
لم تتحفّظ إطلاقاً؟ -

212
00:16:46,400 --> 00:16:48,570
بربّكِ، ماذا كان ذلك؟

213
00:16:49,820 --> 00:16:52,190
من قال بأنّكِ تستطيعين قتلي فحسب؟

214
00:16:52,400 --> 00:16:56,240
لكن بجدّيّة، أيّ شخص كان
ليعتقد بأنّكِ توفّيتِ

215
00:16:56,240 --> 00:16:57,620
!آنسة ماريا

216
00:16:57,620 --> 00:16:59,950
!ماريا-
آنسة ماريا-

217
00:16:58,620 --> 00:17:01,790
المعذرة، اهدأنَ جميعاً رجاء

218
00:16:59,950 --> 00:17:03,080
!مُستحيل-
!آنسة ماريا-

219
00:17:11,420 --> 00:17:13,050
صباح الخير

220
00:17:14,430 --> 00:17:17,600
إذاً، متى ستُسافرين إلى أمريكا تالياً؟

221
00:17:17,760 --> 00:17:19,100
بعد ثلاثة أيّام من الآن

222
00:17:19,100 --> 00:17:21,220
احرصي على المجيء لوداعي

223
00:17:22,180 --> 00:17:23,430
آنسة ماريا؟

224
00:17:25,980 --> 00:17:27,900
سأضبط الأمور أثناء غيابكِ

225
00:17:27,900 --> 00:17:29,610
لا تقلقي بشأن شيء رجاء

226
00:17:30,110 --> 00:17:31,780
أعتمد عليكِ

227
00:17:31,780 --> 00:17:36,280
،جميعكن منحتنني كثيراً من الطّاقة
لذا سأكون بخير

228
00:17:36,280 --> 00:17:37,030
أجل

229
00:17:37,030 --> 00:17:40,080
آنسة رين، من فضلكِ اعتني
بماريا لأجلنا

230
00:17:40,240 --> 00:17:43,660
أجل. الآنسة نانامي قد وبّختْني

231
00:17:45,460 --> 00:17:47,920
أنتن بالتّحديد لا ينبغي أن تضحكن

232
00:17:47,920 --> 00:17:48,750
أجل

233
00:17:54,970 --> 00:17:56,340
ها هي قد سافرت

234
00:17:56,840 --> 00:17:57,640
أجل

235
00:17:58,430 --> 00:18:00,350
المعذرة، آنسة نانامي؟

236
00:18:00,350 --> 00:18:01,430
ماذا؟

237
00:18:01,720 --> 00:18:06,560
،نحن من أخّرنا العمليّةَ الجراحيّة
لكن هل ما زالوا مُوافقين على فعلها؟

238
00:18:07,270 --> 00:18:09,230
وما أدراني؟

239
00:18:10,150 --> 00:18:13,190
ألم تكوني أنتِ من رتّبَ كُلّ شيء؟

240
00:18:13,360 --> 00:18:17,150
أجل، صحيح. بفضل خدعكِ الرّخيصة المعتادة

241
00:18:17,320 --> 00:18:19,490
بإسراف المال لحلّ المُشكلة، صحيح؟

242
00:18:19,740 --> 00:18:24,540
لو كان ذلك صحيحاً، لأضفتُ المزيد
إلى ديونكن، أليس كذلك؟

243
00:18:26,620 --> 00:18:30,040
...بخصوص العمليّة الجراحيّة
تفاوضتُ بالطّبع

244
00:18:30,170 --> 00:18:32,040
سمعتُ بأنّ هذا الجرّاح

245
00:18:32,040 --> 00:18:36,920
كان من أشدّ المُعجبين بالسِّيرك، لذا
ارتأيتُ بأنّني قد أحظى بفُرصة

246
00:18:37,340 --> 00:18:39,050
لكن لم يفلح ذلك؟

247
00:18:39,050 --> 00:18:41,510
لا، لم يفلح-
...إذاً كيف-

248
00:18:41,760 --> 00:18:45,560
من يدري؟ لكنّه وافق لأنّ مُؤدّية
سِيرك شهيرة ما

249
00:18:45,560 --> 00:18:48,020
فعلت المُستحيل لإقناعه

250
00:18:48,020 --> 00:18:49,310
أو هذا ما قيل لي

251
00:18:49,810 --> 00:18:51,810
مُؤدّية ما؟

252
00:18:51,810 --> 00:18:54,650
أجل، سمعتُ بأنّه مشهورٌ جدّاً

253
00:18:58,530 --> 00:18:59,570
سأغادر الآن

254
00:18:59,570 --> 00:19:01,410
حسناً-
حسناً-

255
00:19:03,200 --> 00:19:06,330
،ميزوكا تسوروماكي، أوكا كاواسومي

256
00:19:08,620 --> 00:19:14,340
سأصقل مهاراتي أكثر حتّى وذلك كي أتمكّن
،من إسعاد المزيد من الجمهور

257
00:19:14,340 --> 00:19:16,510
وبالتّالي بلوغ ذروة السِّيرك

258
00:19:17,260 --> 00:19:19,010
احرصنَ على ألّا تُرمَين على
قارعة الطّريق، اتّفقنا؟

259
00:19:31,690 --> 00:19:33,900
،بعد ذلك بفترة قصيرة

260
00:19:33,900 --> 00:19:38,240
،نجد أنفسنا في الطّريق ثانية
في جولة قطريّة أُخرى

261
00:19:39,450 --> 00:19:41,570
يا مُديرة الحلبة

262
00:19:42,360 --> 00:19:45,200
أخبريني إذاً، لماذا لا نزال مُفلسات؟

263
00:19:45,200 --> 00:19:48,950
في الواقع، نفقات مُعالجة الآنسة ماريا
،أكبر ممّا تعتقدين

264
00:19:49,580 --> 00:19:53,080
ولا يمكننا فرض هذا على
الآنسة نانامي للأبد

265
00:19:53,630 --> 00:19:55,630
هذا ليس بالأمر الجلل

266
00:19:55,750 --> 00:19:58,340
ليس سيّئاً لدرجة نستجدي
فيها لأجل الطّعام

267
00:19:58,800 --> 00:20:01,010
ولن نأكل بطاطا طوال الوقت
بعد الآن أيضاً

268
00:20:01,260 --> 00:20:03,220
حسناً، أجل

269
00:20:03,390 --> 00:20:05,720
تلقّينا رسالةً من الآنسة ماريا

270
00:20:05,720 --> 00:20:06,970
ماذا؟

271
00:20:09,100 --> 00:20:10,560
...لنرَ

272
00:20:10,560 --> 00:20:13,270
إلى عضوات فِرقة زهرة عبّاد
،الشّمس العزيزات

273
00:20:13,600 --> 00:20:15,440
كيف حالكن؟

274
00:20:16,270 --> 00:20:19,030
تعافيي لما بعد العمليّة الجراحيّة
يسير على قدم وساق

275
00:20:19,570 --> 00:20:22,280
بدأتُ أضجر من حياة المشفى فحسب

276
00:20:22,780 --> 00:20:27,120
،أنتهز كُلَّ فُرصة للخروج خِلسة من المشفى
والذّهاب إلى السِّيرك هنا

277
00:20:27,950 --> 00:20:31,830
،عندما أضجر من حياتي هنا
سأعود إلى المنزل في النّهاية

278
00:20:32,210 --> 00:20:36,290
وعندما أفعل، أودّ التحقُّق بنفسي
من مدى تطوّركن جميعاً

279
00:20:36,420 --> 00:20:38,380
أتطلّع بلهفة لرؤية الجميع ثانية

280
00:20:40,880 --> 00:20:45,300
مُلاحظة أخيرة. أُرفق صورة زفافنا

281
00:20:48,760 --> 00:20:49,850
زفاف؟

282
00:20:51,890 --> 00:20:53,190
من هو هذا الشّخص الّذي هي معه؟

283
00:20:53,190 --> 00:20:54,480
!دعيني أرى-
الطّبيب؟-

284
00:20:54,480 --> 00:20:55,940
هل هذا الطّبيب؟

285
00:20:56,270 --> 00:20:57,440
...هذا الرّجل

286
00:20:58,020 --> 00:21:01,740
هو الّذي فعلَ المُستحيل لأجلي
كي أخضع لعمليّتي الجراحيّة

287
00:21:02,400 --> 00:21:04,160
...ماذا؟ هذا الشّخص

288
00:21:06,740 --> 00:21:09,200
وهو حُبّي الأوّل أيضاً

289
00:21:13,620 --> 00:21:14,580
!ميزوكا

290
00:21:14,790 --> 00:21:19,040
،ميزوكا، عندما ترينني في المرّة المُقبلة
ناديني "ماما"، اتّفقنا؟

291
00:21:23,510 --> 00:21:24,760
...هذا

292
00:21:25,130 --> 00:21:26,470
...هذا

293
00:21:26,680 --> 00:21:30,510
!المُتناعِلة

294
00:23:36,970 --> 00:23:39,890
النّهاية