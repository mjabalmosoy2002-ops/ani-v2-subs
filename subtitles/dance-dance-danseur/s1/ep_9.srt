1
00:00:03,930 --> 00:00:06,890
"عندما يقول شخص "نيبّوها نيبّيرا

2
00:00:07,440 --> 00:00:11,040
"بالروسيّة، عليك أن تردّ "كوتشورتو

3
00:00:12,040 --> 00:00:13,800
نيبّوها نيبّيرا

4
00:00:14,460 --> 00:00:18,280
...أعددتُ الطعام اليوم

5
00:00:18,800 --> 00:00:21,580
لكن أعتقد بأنّه سيكون لذيذاً

6
00:00:22,210 --> 00:00:24,270
لو، هل تسمعني؟

7
00:00:24,270 --> 00:00:25,720
كوتشورتو

8
00:00:25,720 --> 00:00:26,800
ماذا تعني؟

9
00:00:26,800 --> 00:00:29,000
إنّها سحر لجعل كلّ شيء يسير على ما يُرام

10
00:00:30,290 --> 00:00:32,590
غالباً على أيّ حال

11
00:02:07,230 --> 00:02:09,980
اليوم السّادس من المدرسة الصيفيّة

12
00:02:09,980 --> 00:02:13,360
أنت هنا من الآن؟

13
00:02:13,360 --> 00:02:15,280
ذهبتُ كي آخذك

14
00:02:16,460 --> 00:02:19,800
...المعذرة، أردتُ الحديث معك حول أمر

15
00:02:19,800 --> 00:02:21,870
هل يمكننا التكلّم في الطريق إلى المنزل؟

16
00:02:22,840 --> 00:02:24,700
!هذا مذهل يا لو

17
00:02:24,700 --> 00:02:27,450
أظنّه أكثر مرونة من بعض الفتيات المُنتظمات

18
00:02:28,300 --> 00:02:29,660
!لا أستطيع فعلها

19
00:02:29,660 --> 00:02:32,000
حركة التّباعد التي تبدأ منها مختلفة

20
00:02:33,170 --> 00:02:41,510
المثاليّ

21
00:02:33,170 --> 00:02:41,510
جومبي

22
00:02:33,530 --> 00:02:37,590
عِظام حوضك مائلة للأمام، لذا
لا يمكنك الانحناء للخلف

23
00:02:37,590 --> 00:02:39,900
وأنت تنحني باتجاه ساقك الخلفيّة

24
00:02:41,960 --> 00:02:43,350
،كما قلتُ

25
00:02:43,350 --> 00:02:44,220
هكذا

26
00:02:44,220 --> 00:02:45,100
!وهكذا

27
00:02:45,100 --> 00:02:46,270
مؤلم

28
00:02:46,270 --> 00:02:47,550
لا تلوِ جسدك

29
00:02:47,550 --> 00:02:48,790
سرّتك للامام

30
00:02:48,790 --> 00:02:50,360
!لا تُدِر ساقك الأماميّة باتّجاه الداخل

31
00:02:50,360 --> 00:02:51,980
فليثبّت أحدكم ساقه الأماميّة

32
00:02:51,980 --> 00:02:54,070
!استراحة، استراحة، استراحة، استراحة

33
00:02:54,070 --> 00:02:56,160
أنت تغار منّي، صحيح؟

34
00:02:56,160 --> 00:02:58,410
تمدّدتُ هكذا كلّ يوم

35
00:02:58,410 --> 00:03:00,740
بدأتَ أنت بمرونة

36
00:03:01,430 --> 00:03:05,240
الآن ياماتو ولو وميساكي أمام المرآة

37
00:03:05,700 --> 00:03:08,270
،الثّلاثة يرقصون بمستوى عالٍ جدّاً

38
00:03:08,270 --> 00:03:10,760
لكن لو هو الأفضل حتّى الآن

39
00:03:10,760 --> 00:03:13,870
،مزاجه صعب، وأنا قلق بشأن حماسه للتعلّم

40
00:03:13,870 --> 00:03:16,160
لكنّه شخص لا يتكرّر إلّا مرّة في عدّة عقود

41
00:03:16,160 --> 00:03:17,820
أرى بأنّه ينبغي أن يحظى بالمنحة

42
00:03:17,820 --> 00:03:19,390
ماذا عن موراو جومبي؟

43
00:03:19,390 --> 00:03:21,030
تذكّرت

44
00:03:21,030 --> 00:03:24,280
وجه موراو تعبيريّ جدّاً

45
00:03:24,280 --> 00:03:25,720
يروقني ذلك

46
00:03:25,720 --> 00:03:28,140
يمكنكِ أن تميّزي حماسه ولن يخيّب توقّعاتكِ

47
00:03:28,140 --> 00:03:32,230
ناكامورا-سينسي، أنا لا أسألك عن رأيك به

48
00:03:33,290 --> 00:03:36,730
أريد أن أعرف ما إن كان جديراً بالمنحة أم لا

49
00:03:37,450 --> 00:03:39,450
إعطاء المنحة لموراو؟

50
00:03:41,470 --> 00:03:43,280
ماذا؟ هل ينبغي أن أفلتك؟

51
00:03:43,280 --> 00:03:45,720
!لا... سأفعلها

52
00:03:46,350 --> 00:03:47,370
!أوقفوا هذا حالاً

53
00:03:49,250 --> 00:03:51,080
!قد تتعرّض لإصابة

54
00:03:52,100 --> 00:03:55,780
حاليّاً، التّمرين الاعتيادي يقتضي استخدام
وزن جسدك فقط عند التمدّد

55
00:03:55,780 --> 00:03:59,800
من الخطير جدّاً أن يشكّل الآخرون
الكثير من الضغط عليك

56
00:04:00,190 --> 00:04:01,680
هذه الطريقة قديمة

57
00:04:01,680 --> 00:04:03,950
هل تعلّمتها من جدّك؟

58
00:04:04,650 --> 00:04:07,410
أظنّني أتفهّم سبب هرب أمّك

59
00:04:07,410 --> 00:04:11,060
مازورو من جدّتك

60
00:04:11,060 --> 00:04:13,760
...كانت تمتلك موهبة كبيرة

61
00:04:13,760 --> 00:04:16,170
...ليتها قد حظيت بمُعلّم جيّد فقط

62
00:04:19,760 --> 00:04:21,940
،تقولين بأنّ هذه طريقة قديمة

63
00:04:21,940 --> 00:04:23,450
نيبّوها نيبّيرا

64
00:04:23,920 --> 00:04:25,950
لكن لم أتعرّض لإصابات أبداً

65
00:04:26,690 --> 00:04:28,400
ولا أحد في أويكاوا

66
00:04:28,400 --> 00:04:31,700
يستطيع الرّقص أفضل منّي، صحيح؟

67
00:04:31,700 --> 00:04:32,960
كوتشورتو

68
00:04:32,960 --> 00:04:34,830
!قالها علناً

69
00:04:35,880 --> 00:04:37,460
أشكّ في ذلك

70
00:04:41,020 --> 00:04:44,380
سآتي لمراقبة درس ما بعد الظهر قليلاً اليوم

71
00:04:45,830 --> 00:04:47,300
أتطلّع قدماً لذلك

72
00:04:51,230 --> 00:04:55,500
ابتسامة أياكو-سان خفيفة جدّاً
!لدرجة تجعلني أخاف

73
00:04:55,500 --> 00:04:59,740
سمعتُ بأنّها تعامل الّذين تحبّهم
وكأنّهم في مقابلة يسودها التوتّر

74
00:04:59,740 --> 00:05:01,830
لا بدّ أنّها تضع نُصب عينيها عليك يا لو

75
00:05:01,830 --> 00:05:04,060
حقّاً؟ لكن ما كنتُ لأرغب في ذلك

76
00:05:04,060 --> 00:05:05,960
أفضّل التحسّن من خلال المديح

77
00:05:05,960 --> 00:05:07,490
على أيّ حال، ماذا تريدون أن تأكلوا؟

78
00:05:06,640 --> 00:05:08,470
لو، هل يمكنني التكلّم معك؟

79
00:05:07,490 --> 00:05:11,320
ليس الرّامن بالتأكيد. ما زال لدينا درس بعد الظهر

80
00:05:09,030 --> 00:05:11,320
،لم أستطع قولها قبل الآن

81
00:05:11,320 --> 00:05:14,200
لكن أنا في الواقع من مُعجبي موري مازورو-سان

82
00:05:15,000 --> 00:05:18,240
تبدو مثلها فحسب. لا أصدّق بأنّني لم أستطع التّمييز

83
00:05:18,240 --> 00:05:20,550
أخوك الصّغير ظريف أيضاً

84
00:05:21,970 --> 00:05:25,380
ماذا؟ علمت بشريكها الجديدا وابنهما، صحيح؟

85
00:05:25,380 --> 00:05:27,820
لعلّ ذلك قد فاتك غالباً، صحيح؟

86
00:05:31,060 --> 00:05:33,360
أظنّها في سنّ الرابعة تقريباً

87
00:05:33,360 --> 00:05:35,710
،يبدو وكأنّ مازورو-سان عانت كثيراً

88
00:05:35,710 --> 00:05:37,560
لكن تبدو سعيدة الآن

89
00:05:38,010 --> 00:05:40,310
ألن تعيش معها؟

90
00:05:42,630 --> 00:05:43,500
أكاذيب

91
00:05:44,770 --> 00:05:48,570
إنّها توهم الآخرين بانّها سعيدة

92
00:05:49,150 --> 00:05:51,840
تلك المرأة كاذبة رخيصة

93
00:05:52,240 --> 00:05:54,290
لا أريد أن أختلط معها أكثر من ذلك

94
00:05:56,710 --> 00:05:59,990
...حسناً، أعتقد لم يفلح ذلك

95
00:06:12,220 --> 00:06:14,560
رقصك ديناميكيّ، مع تقنيّة ثابتة

96
00:06:14,560 --> 00:06:16,180
ابتسامتك ظريفة أيضاً

97
00:06:16,630 --> 00:06:18,690
لكن ربطك للحركات سيئ

98
00:06:18,690 --> 00:06:21,040
لست رشيقاً بما يكفي لتكون أميراً

99
00:06:21,040 --> 00:06:25,070
بدلاً من رؤية بحيرة البجعة، أرى بحيرة شيغا

100
00:06:25,070 --> 00:06:27,730
!ماذا؟! تقصدين البحيرة بيوا؟

101
00:06:28,720 --> 00:06:32,910
أنتم الفتيان ترقصون بدور الأمير سيغفريد

102
00:06:32,910 --> 00:06:34,380
الرّشاقة أهمّ من الالتواء

103
00:06:34,380 --> 00:06:36,380
الأناقة أهمّ من الحيويّة

104
00:06:36,380 --> 00:06:37,560
،في اليوم الأخير

105
00:06:37,560 --> 00:06:42,160
خذني من فضلك إلى عالم بحيرة البجعة

106
00:06:42,160 --> 00:06:45,090
هذا مختلف تماماً عمّا قالته تشيزورو-سان

107
00:06:45,400 --> 00:06:46,520
التّالي

108
00:06:46,520 --> 00:06:47,520
لو

109
00:06:52,340 --> 00:06:54,010
نيبّوها نيبّيرا

110
00:06:52,340 --> 00:06:54,010
عسى أن تنجح

111
00:06:57,520 --> 00:06:59,100
كوتشورتو

112
00:06:57,790 --> 00:06:58,800
!فلتذهب إلى الجحيم

113
00:06:59,890 --> 00:07:04,220
!لو، سأعود لأجلك بالتأكيد

114
00:07:04,220 --> 00:07:07,800
إذا بدأت تفتقدني، اتلُ هذه التّعويذة فحسب

115
00:07:07,800 --> 00:07:10,590
!حتّى لو افترقنا، سأجيبك

116
00:07:15,410 --> 00:07:17,040
نيبّوها نيبّيرا

117
00:07:18,790 --> 00:07:20,560
نيبّوها نيبّيرا

118
00:07:22,170 --> 00:07:30,670
نيبّوها نيبّيرا

119
00:07:36,030 --> 00:07:37,700
لو، ما الأمر؟

120
00:07:41,030 --> 00:07:42,190
لو؟

121
00:07:42,900 --> 00:07:45,440
إن كنت لا تريد الأداء، فتراجع إذاً

122
00:07:46,440 --> 00:07:47,440
أنت تعرقلنا

123
00:07:54,780 --> 00:07:55,860
!لو

124
00:07:56,900 --> 00:07:58,360
دعه

125
00:08:05,440 --> 00:08:06,230
!لو

126
00:08:06,510 --> 00:08:08,400
!ماذا تفعل؟ لا تغادر

127
00:08:08,400 --> 00:08:10,010
هل السّبب هو ما قاله عن أمّك؟

128
00:08:10,010 --> 00:08:11,260
!لا

129
00:08:11,260 --> 00:08:14,470
!لأنّه لا يوجد ما أتعلّمه هنا

130
00:08:15,120 --> 00:08:17,470
!أو من تشيزورو-سان أيضاً

131
00:08:18,190 --> 00:08:20,060
!لهذا أردتُ السّفر إلى خارج البلاد

132
00:08:22,020 --> 00:08:24,230
لكن لا أبالي لذلك بعد الآن أيضاً

133
00:08:24,810 --> 00:08:27,730
وماذا يعني لو كنتُ أجيد الباليه؟

134
00:08:29,110 --> 00:08:31,160
!أيّها الأحمق! ما خطبك؟

135
00:08:31,160 --> 00:08:33,610
ألا تحبّ ممارسة الباليه؟

136
00:08:33,610 --> 00:08:34,760
!لا، أكرهها

137
00:08:35,050 --> 00:08:36,580
!أجبِرتُ على ممارستها فحسب

138
00:08:39,490 --> 00:08:41,410
!ماذا؟

139
00:08:42,070 --> 00:08:45,700
!كاذب! أنت تحبّ الباليه

140
00:08:47,920 --> 00:08:49,470
!انتهينا

141
00:08:51,050 --> 00:08:52,710
جومبي-كن

142
00:08:53,260 --> 00:08:55,960
طلبت أياكو-سان أن تحضر إلى المكتب

143
00:08:56,440 --> 00:08:59,590
تبّاً! هل ستخبرني أن أكفّ عن التّباهي؟

144
00:08:59,590 --> 00:09:03,160
لم تعقّب عنّي قبل قليل أيضاً

145
00:09:03,600 --> 00:09:05,420
لا أدري بشأن ذلك

146
00:09:06,100 --> 00:09:13,110
المكتب

147
00:09:11,690 --> 00:09:13,110
المعذرة

148
00:09:18,050 --> 00:09:19,780
تمّ استدعاؤك بواسطة أياكو-سان؟

149
00:09:19,780 --> 00:09:21,510
هل السّبب هو أنا ولو؟

150
00:09:21,510 --> 00:09:23,120
لا

151
00:09:23,850 --> 00:09:27,870
...كان الأمر يخصّني. بشأن ما أفكّر فيه

152
00:09:29,930 --> 00:09:33,690
سمعتُ بأنّ لو غادر في منتصف الدّرس

153
00:09:36,040 --> 00:09:38,960
،بالنسبة للو، كلمة جدّتي مُطلَقة

154
00:09:38,960 --> 00:09:44,890
وهي قد رفضت الباليه اليابانيّ لأنّها
ارتأت بأنّ الرّوسي هو الأفضل

155
00:09:45,210 --> 00:09:48,400
،ظننتُ بأنّك قد تساهم في تغييره قليلاً

156
00:09:48,790 --> 00:09:50,770
لكن أعتقد المسألة ليست بتلك السّهولة

157
00:09:51,960 --> 00:09:54,150
سأذهب لآخذ لو في صباح الغد

158
00:09:57,090 --> 00:09:58,040
...المعذرة

159
00:09:58,460 --> 00:09:59,400
!لنذهب إلى مكان ما

160
00:10:00,100 --> 00:10:02,270
!إنّها عطلة الصّيف... اليوم الأخير

161
00:10:02,270 --> 00:10:06,000
بعد الأداءات المتنوّعة في
المدرسة الصيفيّة، لنذهب إلى مكان ما

162
00:10:06,720 --> 00:10:08,000
!نحن الاثنان

163
00:10:09,150 --> 00:10:10,040
!أجل

164
00:10:11,560 --> 00:10:13,750
!أجل! أحبّها

165
00:10:13,750 --> 00:10:17,680
الأظرف في العالم. الأظرف في العالم

166
00:10:19,840 --> 00:10:23,140
...أنا موراو. المعذرة

167
00:10:27,580 --> 00:10:29,650
أهذه "روميو وجولييت" من ذلك اليوم؟

168
00:10:30,340 --> 00:10:31,520
!تقدير

169
00:10:43,220 --> 00:10:46,970
حسناً يا موراو جومبي-كن؟ كيف كانت
الأيّام الستّة الأخيرة؟

170
00:10:46,970 --> 00:10:49,240
تغيّر عالمك بشكل بليغ، أليس كذلك؟

171
00:10:50,190 --> 00:10:53,230
رقصك وسلوكك مختلفان تماماً

172
00:10:53,230 --> 00:10:56,270
ما كنت لتتغيّر إلى ذلك الحدّ دون محاولة

173
00:10:58,220 --> 00:11:00,430
سأدخل صلب الموضوع مباشرة

174
00:11:00,960 --> 00:11:06,180
أفكّر في إعطائك المنحة لصفّ النخبة

175
00:11:06,730 --> 00:11:11,310
في كلّ عام، نحتفظ بمكان شاغر
واحد لتلميذ من المدرسة الصيفيّة

176
00:11:11,760 --> 00:11:14,690
أودّ أن أعرف ما إن كنت مهتمّاً

177
00:11:15,140 --> 00:11:16,830
...تـ-تبّاً

178
00:11:17,120 --> 00:11:18,370
!أنا سعيد حقّاً

179
00:11:18,370 --> 00:11:20,680
،إذا حصلت على المنحة

180
00:11:20,680 --> 00:11:24,200
فهذا دليل على أنّني اعترفتُ بك، صحيح؟

181
00:11:24,950 --> 00:11:27,450
ا-المعذرة، لكن لماذا؟

182
00:11:27,760 --> 00:11:28,960
لماذا أنا؟

183
00:11:29,430 --> 00:11:32,570
أعني بأنّ لو أفضل منّي بكثير

184
00:11:32,570 --> 00:11:36,390
،هذا صحيح. إنّه ماهر جدّاً بالفعل

185
00:11:36,390 --> 00:11:39,700
وأداؤه جذب النّاس بأعجوبة

186
00:11:39,700 --> 00:11:40,470
،لكن

187
00:11:41,050 --> 00:11:43,180
لا يمكنه أن يصبح محترفاً

188
00:11:44,040 --> 00:11:47,620
...أن يغادر الدّرس فقط لأنّه اهتزّ بسبب شيء

189
00:11:47,620 --> 00:11:50,090
إنّه ضعيف جدّاً ذهنيّاً. لا يمكنه الانسجام مع الآخرين

190
00:11:50,090 --> 00:11:51,810
لا يمتلك منطقاً

191
00:11:53,080 --> 00:11:54,440
،وفوق كلّ شيء

192
00:11:54,440 --> 00:11:56,430
،مهما كان الشخص موهوباً

193
00:11:56,430 --> 00:12:00,940
إن كان لا يريد التعلّم، فلا يسعنا فعل شيء

194
00:12:03,150 --> 00:12:05,780
لا تقل لي بأنّ تشيزورو-سان قالت لك أيضاً

195
00:12:05,780 --> 00:12:09,270
بأنّه عليك أن تكون الأفضل في روسيا؟

196
00:12:09,800 --> 00:12:13,520
ليست هي من قالت أنّه "يجب" أن
...أن أكون. أنا مَن

197
00:12:13,520 --> 00:12:15,880
هكذا إذاً. ما الّذي جعلك تقول ذلك؟

198
00:12:17,250 --> 00:12:19,710
...ارتأيتُ فقط... بأنّ ذلك سيكون رائعاً

199
00:12:20,290 --> 00:12:22,080
...أن أكون الأفضل في روسيا أو ما شابه

200
00:12:22,830 --> 00:12:24,900
هكذا إذاً. فهمت

201
00:12:24,900 --> 00:12:28,040
هلّا استمعت إلى ما أهدف له كذلك؟

202
00:12:34,260 --> 00:12:38,860
إلى مُستويات تجعل الرّاقصين في خارج
البلاد يرغبون في الانضمام لأويكاوا

203
00:12:38,860 --> 00:12:43,170
لإنجاز ذلك، يجب فعل أمور كثيرة

204
00:12:43,170 --> 00:12:47,330
رواتب وضمانات للرّاقصين وذخيرة فنّية ومُموّلون

205
00:12:47,330 --> 00:12:50,380
وربّما حتّى توعية الجمهور تجاه الباليه

206
00:12:51,540 --> 00:12:56,750
وراقص نجم يصبح هدف هذا الحبّ
المُطلَق أمر جوهريّ

207
00:12:57,380 --> 00:13:00,400
...شخص يصنع تاريخ الباليه

208
00:13:00,400 --> 00:13:03,470
سيكون من الأفضل أن يكون مُتدرّباً
بواسطة أويكاوا أيضاً

209
00:13:03,850 --> 00:13:06,280
هذا ما أريدك أن تصبح عليه

210
00:13:07,090 --> 00:13:10,970
ألا تعتقد بأنّ هذا أكثر استحالة وإثارة للاهتمام

211
00:13:10,970 --> 00:13:13,400
من الطموح لتكون راقصاً روسيّاً في القمّة؟

212
00:13:17,870 --> 00:13:22,730
لذا إليك شروط مكافأتك بالمنحة

213
00:13:22,730 --> 00:13:26,320
،ستنضمّ لشركة أويكاوا في نهاية المطاف

214
00:13:26,320 --> 00:13:28,590
وتتوقّف عن الحضور لاستديو غوداي للباليه

215
00:13:28,590 --> 00:13:32,420
إن كنت لا تستطيع قبول هذه الشروط
،ولا تريد المنحة

216
00:13:35,460 --> 00:13:37,960
استديو غوداي للباليه

217
00:13:35,800 --> 00:13:39,460
فمن فضلك لا تأتِ للأداءات المتنوّعة

218
00:13:39,460 --> 00:13:41,320
في اليوم الأخير من المدرسة الصيفيّة

219
00:13:43,380 --> 00:13:44,970
...تشيزورو-سان، أنا

220
00:13:45,380 --> 00:13:47,090
!تمّ الاعتراف بي بواسطة أياكو-سان

221
00:13:47,750 --> 00:13:49,850
!والآن سيعود الأطفال الصّغار أيضاً

222
00:13:50,310 --> 00:13:53,890
ماذا؟ هل تنوي قبول المنحة لصفّ النّخبة؟

223
00:13:53,890 --> 00:13:54,720
!أنتِ ذكيّة

224
00:13:55,880 --> 00:13:58,110
!فكّرتُ في الذهاب إلى كلا المدرستين

225
00:14:00,560 --> 00:14:01,940
لا يمكنك فعل ذلك

226
00:14:01,940 --> 00:14:04,770
لا يبدو هذا كشيء تسمح به أياكو-سان

227
00:14:04,770 --> 00:14:05,960
هذا منافٍ للقواعد

228
00:14:06,900 --> 00:14:09,000
ماذا عن كونك ستصبح أفضل راقص في روسيا؟

229
00:14:09,000 --> 00:14:12,690
إذا قبلت بالمنحة، من المتوقّع أن
تنضمّ لاويكاوا في نهاية المطاف

230
00:14:12,690 --> 00:14:18,130
أجل، لكن يبدو وكأنّ لديهم برنامج
تدريب دراسي خارج البلاد

231
00:14:18,130 --> 00:14:21,920
لذا ارتأيتُ أن أنتهز الفرصة إذا حصلتُ
!عليها. مثلكِ يا تشيزورو-سان

232
00:14:22,370 --> 00:14:24,150
أخبرتني أياكو-سان

233
00:14:24,150 --> 00:14:27,560
رغم أنّكِ كنتِ تدرسين تحت المديرة الفنّية
السّابقة، أويكاوا هاروكا

234
00:14:27,560 --> 00:14:29,530
ذهبتِ للدراسة في الخارج في روسيا، صحيح؟

235
00:14:29,530 --> 00:14:31,500
،حصلت على امتياز في الرّقص في روسيا

236
00:14:31,500 --> 00:14:33,430
،ثمّ عدت إلى أويكاوا وانضممتِ للشركة

237
00:14:33,430 --> 00:14:34,880
—لذا أستطيع ردّ الجميل بنفس الطريقة

238
00:14:34,880 --> 00:14:35,440
!أحمق

239
00:14:36,350 --> 00:14:39,280
عالم الباليه متّصل أكثر ممّا تعتقد

240
00:14:39,280 --> 00:14:42,470
السّمعة السيّئة ستظلّ تلازمك ما دمت ترقص

241
00:14:42,470 --> 00:14:46,990
ولا شيء سيطفئ تألّق راقص صاعد

242
00:14:47,470 --> 00:14:49,860
لم أتمكّن من ردّ الجميل إطلاقاً

243
00:14:50,550 --> 00:14:52,970
،والآن بعد رحيل هاروكا-سان

244
00:14:52,970 --> 00:14:55,690
إنّه شيء سيبقى معي طيلة حياتي

245
00:14:57,110 --> 00:14:59,360
...إذاً... السّفر إلى روسيا

246
00:14:59,360 --> 00:15:01,060
لستُ نادمة عليه

247
00:15:02,010 --> 00:15:04,530
أردتُ الذهاب. ما باليد حيلة

248
00:15:04,530 --> 00:15:07,010
ما أقصده هو أنّك لا يمكنك دخولها وأنت
تعلم بأنّك لن تستوفي الشّرط

249
00:15:07,510 --> 00:15:10,720
تشيزورو-سان، أنتِ تفكّرين خارج الصندوق حقّاً

250
00:15:10,720 --> 00:15:14,140
لم تغضبي في مهرجان الباليه أيضاً بخلاف أياكو-سان

251
00:15:14,490 --> 00:15:15,900
وهل كانت هناك حاجة للغضب؟

252
00:15:15,900 --> 00:15:17,900
كانت مشاهدة ذلك ممتعة

253
00:15:21,630 --> 00:15:23,520
أسعدني هذا

254
00:15:24,280 --> 00:15:25,740
...لكن

255
00:15:25,740 --> 00:15:32,140
أشعر وكأنّ شخصاً مثلي لا يستطيع البقاء
في مكان يقبل هذا الجزء منّي

256
00:15:32,140 --> 00:15:36,110
الذّهاب إلى مكان صارم مثل أويكاوا
جعلني أفكّر بهذه الطريقة

257
00:15:37,310 --> 00:15:39,300
—لهذا فكّرتُ في الذّهاب إلى المكانين

258
00:15:39,300 --> 00:15:40,370
!حسناً

259
00:15:40,780 --> 00:15:43,210
لا تُرِني وجهك هنا بعد الآن

260
00:15:43,910 --> 00:15:46,530
،بغضّ النّظر عن القواعد

261
00:15:46,530 --> 00:15:48,770
،إن كنت تعتقد بأنّ وجودك هنا لم يعد ينفعك

262
00:15:48,770 --> 00:15:51,800
،%وبأنّك لا تستطيع فعل ما أقوله وتثق بي 100

263
00:15:52,370 --> 00:15:54,800
فلا يمكننا أن نعمل معاً بعد الآن إذاً

264
00:15:55,810 --> 00:15:58,710
وداعاً إذاً. افعل ما بوسعك في أويكاوا

265
00:16:03,650 --> 00:16:05,090
أنتِ تمزحين، صحيح؟

266
00:16:05,090 --> 00:16:07,660
!إن كان الامر كذلك، سأبقى في غوداي

267
00:16:07,660 --> 00:16:09,900
!لن آخذ المنحة في أويكاوا

268
00:16:10,520 --> 00:16:12,580
!تشيزورو-سان

269
00:16:17,040 --> 00:16:20,620
سأجد وقتاً مناسباً للتحدّث معها

270
00:16:21,470 --> 00:16:26,380
لكن اليوم هو اليوم السّابع من المدرسة
الصيفيّة، يوم درس عاديّ

271
00:16:26,380 --> 00:16:30,380
اليوم السّابع من المدرسة الصيفيّة

272
00:16:26,910 --> 00:16:29,890
لا مانع أن أذهب إلى أويكاوا، صحيح؟

273
00:16:31,170 --> 00:16:33,650
!ماذا؟! أنا، أمام المرآة؟

274
00:16:33,650 --> 00:16:34,670
!ماذا؟

275
00:16:37,730 --> 00:16:41,270
لكن لو هو الأفضل

276
00:16:41,800 --> 00:16:44,140
لا يمكنه أن يصبح محترفاً

277
00:16:45,310 --> 00:16:48,840
اللّعنة على ذلك الفتى ليس شيئاً يمكن كسره بسهولة

278
00:16:50,150 --> 00:16:52,180
!هذا غير صحيح

279
00:16:52,180 --> 00:16:54,740
!لا أصدّق بأنّها لا تعترف به

280
00:16:55,640 --> 00:16:58,390
كيف لتلك اللّعنة أن تُكسَر؟

281
00:16:58,740 --> 00:17:00,490
غرفة تبديل ملابس الفتيان

282
00:17:00,490 --> 00:17:02,680
غداً هو اليوم الأخير؟

283
00:17:02,680 --> 00:17:05,420
...بدا طويلاً، لكن مضى سريعاً أيضاً

284
00:17:05,420 --> 00:17:07,230
!من المبكّر جدّاً على الحنين

285
00:17:07,230 --> 00:17:10,130
!ما زالت هناك الذروة: الأداءات المتنوّعة

286
00:17:10,860 --> 00:17:13,670
جومبي، هل ستأتي غداً؟

287
00:17:14,780 --> 00:17:18,350
أتيتَ للانتقام لأجل النّقد المتعلّق بغوداي-سينسي، صحيح؟

288
00:17:18,350 --> 00:17:21,940
هل تريدك غوداي-سان أن تفعل ذلك حتّى؟

289
00:17:23,120 --> 00:17:25,500
أجل، معك حقّ

290
00:17:25,500 --> 00:17:28,070
سيكون من المنطقيّ ألّا آتي غداً

291
00:17:29,980 --> 00:17:33,110
!لكن أريد المنحة بعض الشيء الآن

292
00:17:33,480 --> 00:17:34,470
!آسف

293
00:17:39,150 --> 00:17:40,530
ما الخطب؟

294
00:17:40,990 --> 00:17:42,930
!ماذا تقصد بأنّك تريدها "بعض الشيء"؟

295
00:17:43,380 --> 00:17:46,380
كنتُ أسعى تجاه هذه المنحة في العام الماضي

296
00:17:46,380 --> 00:17:49,790
كانت أملي الوحيد للاستمرار في الباليه

297
00:17:50,130 --> 00:17:53,920
...من تعتقد نفسك بتسكّعك بهذا الشّكل

298
00:17:54,370 --> 00:17:56,930
!أتفهّم شعور لو

299
00:17:56,930 --> 00:18:01,220
هل تدرك حتّى بأنّ لو يحبّ مياكو-تشان؟

300
00:18:01,220 --> 00:18:04,060
!قبّلتما بعضكما، صحيح؟ أيّ مزحة هذه؟

301
00:18:04,340 --> 00:18:06,570
!لو رأى ذلك أيضاً

302
00:18:06,570 --> 00:18:07,660
!أنت غافل تماماً

303
00:18:07,920 --> 00:18:10,450
!لا تحاول حتّى أن ترى مشاعر الآخرين

304
00:18:09,320 --> 00:18:10,450
!مهلاً

305
00:18:11,690 --> 00:18:14,400
!اقتحمتَ المكان فحسب وحصلتَ على أفضل دور لنفسك

306
00:18:15,610 --> 00:18:18,660
!ميساكي، ما الخطب؟ هذا ليس من طباعك

307
00:18:19,980 --> 00:18:21,500
...أنا

308
00:18:21,500 --> 00:18:24,040
أحببتُ الباليه لثمان سنوات

309
00:18:25,050 --> 00:18:26,560
ما علاقة لهذا الأمر؟

310
00:18:26,560 --> 00:18:27,650
...لطالما

311
00:18:27,650 --> 00:18:29,420
!لطالما أردتُ فعل ذلك

312
00:18:30,260 --> 00:18:33,880
كانت غلطتي لعدم امتلاكي الشجاعة
للذهاب وحضور الدّروس

313
00:18:33,880 --> 00:18:36,260
،لكن رقصتُ بطريقتي الخاصّة سرّاً

314
00:18:37,270 --> 00:18:40,640
!والآن بدأتُ أتعلّم الباليه الحقيقيّة أخيراً

315
00:18:41,030 --> 00:18:42,010
...أنا

316
00:18:42,830 --> 00:18:45,520
!أريد أن أتحسّن أيضاً

317
00:18:49,320 --> 00:18:50,540
...هذا كلّ شيء

318
00:18:50,960 --> 00:18:54,150
هذا كلّ ما في الأمر. أين المشكلة في ذلك؟

319
00:18:55,160 --> 00:18:57,440
أريد من تشيزورو-سان أن تعلّمني

320
00:18:58,240 --> 00:18:59,150
...لكن

321
00:19:01,530 --> 00:19:02,990
...من أجل

322
00:19:04,410 --> 00:19:05,870
...التحسّن

323
00:19:32,920 --> 00:19:35,900
...إذا كنتُ... في أويكاوا

324
00:19:35,900 --> 00:19:37,760
!جومبي

325
00:19:42,890 --> 00:19:45,280
!أنا مسرورة... لحقتُ بك

326
00:19:45,280 --> 00:19:48,910
انظر، حصلتُ على مجموعة من نشرات الأفلام

327
00:19:48,910 --> 00:19:50,670
تحبّ الأفلام، صحيح؟

328
00:19:50,670 --> 00:19:54,480
ارتأيتُ بأنّه سيكون من الجيّد الحصول
على تذكرة بعد الخامسة لمدينة ملاهٍ أيضاً

329
00:19:54,480 --> 00:19:56,410
لكن سنتواجد هناك لبضع ساعات فقط

330
00:19:56,410 --> 00:19:58,300
هل تقصدين غداً؟

331
00:19:59,730 --> 00:20:01,060
...لا أصدّق ذلك

332
00:20:01,780 --> 00:20:04,570
!إنّها متحمّسة جدّاً لذلك

333
00:20:05,260 --> 00:20:07,930
!لقد قرّرت. سأبقى في غوداي

334
00:20:08,330 --> 00:20:12,250
أجل، أعني بأنّ تشيزورو-سان تركّز
على الأساسيّات مثل أويكاوا

335
00:20:12,250 --> 00:20:16,190
فضلاً عن ذلك، لا أحد في أويكاوا أفضل من لو

336
00:20:16,510 --> 00:20:18,650
لا يستطيع أن يصبح محترفاً

337
00:20:24,660 --> 00:20:28,370
،قلتُ بأنّني لن أحضر الأداءات المتنوّعة اليوم

338
00:20:28,370 --> 00:20:29,660
!لذا لنذهب إلى مدينة ملاهٍ

339
00:20:29,660 --> 00:20:31,960
ماذا؟ لا، عليك أن تؤدّي

340
00:20:31,960 --> 00:20:34,330
عملتَ بجدّ في الأسبوع الّذي مضى

341
00:20:34,330 --> 00:20:37,380
!تغيّر رقصك بصورة إيجابيّة

342
00:20:37,380 --> 00:20:41,880
...أجل... أنا ممتنّ لأياكو-سان

343
00:20:41,880 --> 00:20:43,050
لكن لن أذهب

344
00:20:43,530 --> 00:20:44,220
...لذلك

345
00:20:44,740 --> 00:20:45,610
!سأدخل

346
00:20:45,940 --> 00:20:46,970
—ما

347
00:20:47,490 --> 00:20:49,970
لو! أنت هنا، صحيح؟

348
00:20:49,970 --> 00:20:53,800
—الآن، سنخرج أنا ومياكو فيما يشبه الموع

349
00:20:53,800 --> 00:20:55,230
!لا، بل هو موعد

350
00:20:55,230 --> 00:20:57,230
!إنّه موعد بكل معنى الكلمة

351
00:20:57,920 --> 00:21:01,620
!هل أنت أحمق؟ أنت... أعني إنّها فتاة ظـ-ظـ-ظـ-ظريفة

352
00:21:01,620 --> 00:21:03,480
...وأمام ناظريك أيضاً

353
00:21:03,480 --> 00:21:06,240
!إنّه تحوّل جذري للأحداث! أيّها الأحمق الغبيّ

354
00:21:06,810 --> 00:21:08,770
!هذا لأنّك تبقى حبيساً في الدّاخل

355
00:21:08,770 --> 00:21:12,410
!لهذا تقول أياكو-سان بأنّك لا تستطيع أن تصبح محترفاً

356
00:21:12,870 --> 00:21:14,250
!ألا يستفزّك هذا؟

357
00:21:14,250 --> 00:21:17,420
!هيّا، عليك أن تذهب للأداءات المتنوّعة

358
00:21:18,090 --> 00:21:20,580
،بينما أستمتع بربيع الحياة

359
00:21:20,580 --> 00:21:24,070
!ينبغي أن نذهب وتُري أياكو-سان براعتك

360
00:21:24,070 --> 00:21:28,130
دعها تشعر وكأنّك شخص يجب أن يراه العالم

361
00:21:28,130 --> 00:21:29,830
!اجعلها تسحب كلامها اللّعين

362
00:21:30,280 --> 00:21:31,070
!هيّا

363
00:21:32,480 --> 00:21:36,270
!إن لم تفعل، فسأغضب كثيراً

364
00:21:37,600 --> 00:21:39,550
—أنت! هل تسمعـ

365
00:21:41,160 --> 00:21:42,430
...إنّه مفتوح

366
00:21:43,950 --> 00:21:45,240
لو؟

367
00:23:20,000 --> 00:23:21,000
الحلقة القادمة

368
00:23:21,000 --> 00:23:26,000
الدفء الوحيد الّذي عرفه لو كان
مياكو. كانت نوره

369
00:23:27,010 --> 00:23:33,240
:راقص الباليه، الفصل 10
!"مياكو... يجب أن تكون بجانبه"