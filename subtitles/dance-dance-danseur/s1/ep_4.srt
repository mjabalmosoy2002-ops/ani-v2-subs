1
00:00:07,970 --> 00:00:09,290
!لا

2
00:00:11,240 --> 00:00:13,460
!لا يمكنك حتّى فعل هذا؟

3
00:00:13,460 --> 00:00:15,470
!كم مرّة يجب عليّ أن أخبرك؟

4
00:00:29,430 --> 00:00:33,210
!انتظري أيّتها العجوز— أعني، سينسي

5
00:00:34,530 --> 00:00:36,880
!علّميني الباليه أرجوكِ

6
00:02:10,890 --> 00:02:12,980
!آسف لأنّني لم آتِ للدرس

7
00:02:14,560 --> 00:02:15,650
!أحمق

8
00:02:15,650 --> 00:02:17,860
!هل سبقَ ورأيتَ أميراً برأس محلوق؟

9
00:02:18,200 --> 00:02:19,870
!ما-ماذا؟

10
00:02:20,190 --> 00:02:21,250
!لم أفكّر بذلك

11
00:02:21,250 --> 00:02:22,780
!هذا واضح

12
00:02:22,780 --> 00:02:24,310
أيضاً، خذي

13
00:02:24,310 --> 00:02:26,620
...فيه علبة حلويّات ورسوم التّعليم الشهريّة

14
00:02:26,900 --> 00:02:28,610
طلبت أمّي منّي إحضارها

15
00:02:30,350 --> 00:02:31,630
باليه؟

16
00:02:32,600 --> 00:02:33,630
ينبغي أن تفعلها

17
00:02:34,880 --> 00:02:38,190
كنتُ أعلم سلفاً. أخبرتني أختك

18
00:02:38,190 --> 00:02:39,630
وأعلم بأنّ والدك مسرور

19
00:02:39,630 --> 00:02:42,250
بأنّك فكّرتَ فيما قاله لثمان سنوات

20
00:02:47,820 --> 00:02:48,280
حسناً

21
00:02:48,660 --> 00:02:50,390
قِف بالوضعيّة الخُماسيّة

22
00:02:50,390 --> 00:02:51,820
كأمير

23
00:03:01,590 --> 00:03:05,390
تبدو كأمير وقور جدّاً

24
00:03:06,370 --> 00:03:08,000
هل تتخيّل شيئاً؟

25
00:03:08,960 --> 00:03:10,040
تشار

26
00:03:11,630 --> 00:03:14,560
عادة ما يردّ الشّخص باسم راقص

27
00:03:14,560 --> 00:03:15,630
أتعلمين؟

28
00:03:15,630 --> 00:03:19,260
لا أبالي بشأن كوني أميراً، ولديّ
رأس محلوق أيضاً

29
00:03:20,320 --> 00:03:22,240
أفضّل الرّقص بصفتي روتبارت

30
00:03:23,240 --> 00:03:27,640
...لا أفهم لماذا لو مُتشبّث بفكرة أن يكون الأمير

31
00:03:28,140 --> 00:03:29,220
سيّدتي

32
00:03:32,100 --> 00:03:33,810
"الرّاقص النّبيل"

33
00:03:35,920 --> 00:03:39,690
هذا ما يُدعى به الرّاقص المُؤهّل ليلعب دور الأمير

34
00:03:40,510 --> 00:03:43,200
إنّ "الأمير" هو الذّروة

35
00:03:44,020 --> 00:03:45,630
،للرقص بدور الأمير

36
00:03:45,630 --> 00:03:48,290
تحتاج لمظهر جسديّ مُعيّن ومهارة وإمكانيّات في التّمثيل

37
00:03:48,290 --> 00:03:51,960
وجاذبيّة وعضلات ورشاقة وقدرة دعم

38
00:03:52,250 --> 00:03:56,330
وحدهم الشّخص الّذي يمتلك كلّ هذه الصّفات

39
00:03:56,330 --> 00:03:58,710
مَن يُسمح له بلعب دور الأمير

40
00:03:59,370 --> 00:04:03,030
إنّه نطاق لا يمكن بلوغه بالعمل الدّؤوب وحده

41
00:04:04,970 --> 00:04:08,600
إذا أصبحتُ الأمير، هل سأتمكّن من
الرّقص بدور الأمير؟

42
00:04:09,290 --> 00:04:11,600
ألم تسمع ما قلتُه؟ إنّه الذّروة

43
00:04:12,400 --> 00:04:16,730
إذا استطعتَ الرّقص كأمير وأيضاً
،إتقان أدوار الشخصيّة

44
00:04:17,030 --> 00:04:19,050
حينئذ يمكنك رقص أيّ جزء

45
00:04:20,960 --> 00:04:25,770
لكن سيكون من المستحيل عليك أن
ترقص بدور الأمير

46
00:04:25,770 --> 00:04:28,990
في أعظم شركة في روسيا، بلد الباليه

47
00:04:33,060 --> 00:04:35,000
هذا ما سأفعله إذاً

48
00:04:35,830 --> 00:04:37,070
،قلتُ

49
00:04:37,680 --> 00:04:41,090
سأصبح راقصاً نبيلاً في روسيا

50
00:04:50,640 --> 00:04:52,390
!كلام جريء من فتى برأس محلوق

51
00:04:52,390 --> 00:04:54,480
!أنا جادّ بشأن هذا

52
00:04:54,480 --> 00:04:59,120
!لا تضحكي أيّتها المرأة العجوز

53
00:05:04,770 --> 00:05:05,680
ما هذا؟

54
00:05:05,680 --> 00:05:06,450
!موراو

55
00:05:06,450 --> 00:05:08,990
!ممنوع الرّكض أو القفز في الأروقة

56
00:05:09,720 --> 00:05:11,710
!ما هذا على أيّ حال؟ ماذا تفعل؟

57
00:05:11,710 --> 00:05:14,530
!طرف أمامي طرف جانبي

58
00:05:14,530 --> 00:05:16,990
!إنّها الباليه

59
00:05:17,650 --> 00:05:19,080
صوته مزعج جدّاً

60
00:05:20,960 --> 00:05:22,590
!لا أستطيع التوقّف

61
00:05:23,040 --> 00:05:24,500
...إذا توقّفت

62
00:05:24,500 --> 00:05:26,220
!سأموت

63
00:05:27,300 --> 00:05:28,510
...أنا

64
00:05:28,510 --> 00:05:32,230
!يمكنني أداء الباليه الآن

65
00:05:33,720 --> 00:05:37,350
سأصبح راقصاً نبيلاً في روسيا

66
00:05:39,620 --> 00:05:41,290
!كلام جريء من فتى برأس محلوق

67
00:05:41,290 --> 00:05:43,110
!أنا جادّ بشأن هذا

68
00:05:44,860 --> 00:05:47,110
!يا له من حلم سخيف خياليّ

69
00:05:47,950 --> 00:05:49,620
،في مدارس الباليه النّخبة في روسيا

70
00:05:50,540 --> 00:05:52,960
،بلد الباليه

71
00:05:52,960 --> 00:05:57,030
يُقبَل حوالي 30 فتى من أصل آلاف المُتقدّمين

72
00:05:57,030 --> 00:06:00,800
،بالإضافة إلى ذلك، في السّنوات الثّمانية المُقبلة
تُغربل الامتحانات المزيد منهم

73
00:06:00,800 --> 00:06:03,630
فيبقى أقلّ من النصف عند التخرّج

74
00:06:03,630 --> 00:06:04,980
،بعد ذلك

75
00:06:04,980 --> 00:06:09,180
حفنة فقط من الرّاقصين يتمكّنون من
الانضمام لشركات باليه عالميّة

76
00:06:09,180 --> 00:06:11,050
كشركة مارينسكي أو بولشوي

77
00:06:11,660 --> 00:06:14,550
أن يصبح رجل ياباني راقصاً نبيلاً هناك

78
00:06:14,550 --> 00:06:16,430
هو أشبه بحلم داخل حلم

79
00:06:16,430 --> 00:06:18,020
بجدّية؟

80
00:06:18,020 --> 00:06:21,900
لا أصدّق بأنّك تقول ذلك بعد تلقّي
دروس لأقلّ من شهر

81
00:06:22,800 --> 00:06:25,450
هذا ضربُ من الجنون

82
00:06:27,190 --> 00:06:30,160
،في أوّل مرّة رقصتَ هنا

83
00:06:31,050 --> 00:06:36,330
!رأيتُ أيضاً حلمك الخياليّ

84
00:06:49,290 --> 00:06:50,310
حقّاً؟

85
00:06:51,040 --> 00:06:52,700
تمسّك بقضيب الارتكاز

86
00:06:54,850 --> 00:06:56,430
مدِّد أصابع قدمك

87
00:06:57,230 --> 00:06:59,950
لديك بُنية أقدام مدهشة حقّاً

88
00:07:00,440 --> 00:07:03,630
لديك ذراعان وساقان طويلتان. وأصابع طويلة أيضاً

89
00:07:03,630 --> 00:07:06,690
،لديك قدم كبيرة ومشط قدم عالية
وهو أمر جيّد في الباليه

90
00:07:06,690 --> 00:07:09,450
ورأس صغير وعنق طويلة

91
00:07:10,240 --> 00:07:11,520
...بالإضافة إلى ذلك، وجهك

92
00:07:11,520 --> 00:07:13,550
لا بأس به عندما لا تتكلّم

93
00:07:13,550 --> 00:07:16,660
لديك مُقوّمات الاحترافيّة

94
00:07:16,660 --> 00:07:20,240
لكن هذا يشير إلى المظهر فحسب

95
00:07:20,240 --> 00:07:23,920
تعتمد الباليه بشكل أساسي على المادّة الخام

96
00:07:24,400 --> 00:07:28,800
يجب أن يمتلك المرء شكلاً ملائماً للباليه

97
00:07:28,800 --> 00:07:31,550
...الجزء الوحيد من جسدك الّذي أنا قلقة بشأنه

98
00:07:31,550 --> 00:07:32,890
هو طولك

99
00:07:32,890 --> 00:07:35,470
!لا، سأكون بخير

100
00:07:35,470 --> 00:07:37,350
!كان أبي طويلاً

101
00:07:38,410 --> 00:07:41,800
،بقيتَ رياضيّاً جدّاً على الأغلب

102
00:07:42,140 --> 00:07:46,270
لكن قوّتك المركزيّة ومرونتك اكتسبتهما
غالباً بفضل الجيت كون دو، صحيح؟

103
00:07:47,020 --> 00:07:49,520
هذا يجعلني أرغب في شكر مُعلّمك
في الجيت كون دو

104
00:07:51,700 --> 00:07:56,110
يجب أن أذهب للاعتذار من العمّ ميوكا كما ينبغي

105
00:08:06,970 --> 00:08:08,420
!أنا مسرورة جدّاً

106
00:08:09,420 --> 00:08:11,410
لماذا؟

107
00:08:11,410 --> 00:08:15,250
خلتُك لن ترقص الباليه بعد الآن

108
00:08:16,790 --> 00:08:20,450
،لم أستطع تصفية مشاعري

109
00:08:20,450 --> 00:08:22,390
ممّا جعلَني عبوسة. آسفة بشأن ذلك

110
00:08:22,880 --> 00:08:24,900
ماذا؟

111
00:08:25,480 --> 00:08:28,900
...في الواقع... ليس بخصوص ذلك

112
00:08:29,390 --> 00:08:31,900
هل كان يتمّ استغلالي؟

113
00:08:34,940 --> 00:08:37,820
يـ-يمكنكِ تحسّسه إذا شئتِ

114
00:08:37,820 --> 00:08:40,870
من المُسلّي لمس الشّعر القصير

115
00:08:44,700 --> 00:08:46,060
...الباليه

116
00:08:46,060 --> 00:08:47,920
!هي الأفضل

117
00:08:51,270 --> 00:08:52,560
كم هذا سخيف

118
00:08:59,350 --> 00:09:02,940
حسناً يا مياكو، تمرّني على الرّقصة
الخاصّة ببحيرة البجعة

119
00:09:02,940 --> 00:09:04,660
جومبي، استمرّ في عملك على قضيب الارتكاز

120
00:09:04,660 --> 00:09:06,390
!ماذا؟ ثانية؟

121
00:09:06,390 --> 00:09:10,020
!مارستُ تمارين قضيب الارتكاز طوال يوم أمس أيضاً

122
00:09:10,020 --> 00:09:12,520
بقي أقلّ من شهرين للأداء، صحيح؟

123
00:09:12,520 --> 00:09:15,440
يمكنك الانتقال للمرحلة التّالية حالما تؤدّي
،تمارين قضيب الارتكاز كما ينبغي

124
00:09:15,440 --> 00:09:17,530
!لا يوجد قضيب ارتكاز في المسرح

125
00:09:18,780 --> 00:09:22,080
!تعلّمتُ سلفاً رقصة الأمير

126
00:09:34,110 --> 00:09:38,340
كالعادة، لا أعتبر هذه باليه. هذا منظر قبيح

127
00:09:40,700 --> 00:09:42,300
...على سبيل المثال، بدورانك على قدم واحدة

128
00:09:42,300 --> 00:09:45,070
،لا تستدير بدرجة كافية، فيحدث مَيَلان

129
00:09:45,070 --> 00:09:47,100
وينتهي الأمر باستخدام القوّة الخالصة للدوران

130
00:09:47,100 --> 00:09:49,290
!ماذا؟ حقّاً؟

131
00:09:49,290 --> 00:09:51,980
حاول أن تستدير وتركّز على الحفاظ
على عمليّة الدّوران

132
00:09:51,980 --> 00:09:54,110
لا تهمل ذلك ولو للحظة

133
00:09:55,000 --> 00:09:57,490
الدّوران سهل

134
00:09:57,490 --> 00:10:00,990
لا أعتقد أنّ شيئاً كهذا سيشكّل فرقاً

135
00:10:08,480 --> 00:10:11,170
رأيت؟ لا تستطيع حتّى إتمام دورة واحدة

136
00:10:11,170 --> 00:10:13,340
!ماذا؟! مستحيل

137
00:10:13,660 --> 00:10:15,100
،إذا أردت رقص الباليه

138
00:10:15,370 --> 00:10:17,590
لا يُسمَح لك برقص ما تشاء بعد الآن

139
00:10:19,090 --> 00:10:24,220
!لـ-لم تكن تلك محسوبة! سأعاود المحاولة

140
00:10:24,220 --> 00:10:25,230
أنت مُلتوٍ

141
00:10:25,230 --> 00:10:28,650
...ماذا؟ كان ذلك قليلاً فقط

142
00:10:28,650 --> 00:10:30,020
أليس المهمّ أن أستطيع الدّوران؟

143
00:10:30,020 --> 00:10:31,100
غير صحيح

144
00:10:31,730 --> 00:10:33,320
ليس الدّوران فحسب

145
00:10:33,320 --> 00:10:37,280
،يستخدم الباليه مجموعة حركات أساسيّة

146
00:10:37,280 --> 00:10:40,610
وحتّى التقنيّات الصّعبة هي مجرّد تطبيق للأساسيّات

147
00:10:41,040 --> 00:10:44,760
إن لم تتخلّص من العادات السيّئة الّتي
تظهر لديك أثناء الرّقص بمفردك

148
00:10:44,760 --> 00:10:47,000
،وإتقان الحركات الأساسيّة الصحيحة

149
00:10:47,000 --> 00:10:50,030
"فحينئذ ما تفعله لا يمكن أن يُسمّى "باليه

150
00:10:51,930 --> 00:10:53,430
،بالنسبة لأمثال مياكو ولو

151
00:10:53,430 --> 00:10:56,250
،اللّذين حفظا الأساسيّات عن ظهر قلب منذ صغرهما

152
00:10:56,250 --> 00:10:58,700
أصبحت حركات الباليه جزءاً من جسديهما

153
00:10:59,730 --> 00:11:03,720
هناك أكثر من عشر سنوات بينهم وبين عاداتك السيّئة

154
00:11:05,070 --> 00:11:07,820
ستؤدّي الحركات غير الصّحيحة إلى إصابات أيضاً

155
00:11:08,580 --> 00:11:10,350
ألا تؤلمك ركبتك؟

156
00:11:10,350 --> 00:11:11,630
!كلّا

157
00:11:11,630 --> 00:11:13,400
ما تعابير الوجه هذه؟

158
00:11:13,770 --> 00:11:16,410
الإحراج والعِناد هما أعداء النموّ

159
00:11:16,910 --> 00:11:19,550
حسناً، ماذا ينبغي أن تفعل الآن؟

160
00:11:22,370 --> 00:11:25,660
حسناً الآن، تجاهلنَ الفتى الّذي
عليه أن يتمرّن متأخّراً

161
00:11:28,500 --> 00:11:29,540
!أنت تُدندن بصوت عال

162
00:11:30,990 --> 00:11:33,330
!جومبي، لا تنضمّ للصفّ دون إذن

163
00:11:34,490 --> 00:11:35,330
خذ

164
00:11:35,330 --> 00:11:36,920
هذا حذاء بنعل كامل

165
00:11:37,420 --> 00:11:40,110
هذا سيساعد في تحريك أسفل قدميك بشكل أفضل

166
00:11:45,430 --> 00:11:48,780
قُم بالتنظيف وضع المفتاح في صندوق البريد

167
00:11:48,780 --> 00:11:51,690
...لا أستطيع الحركة

168
00:11:52,130 --> 00:11:57,170
تشيزورو-سان، لم يبقَ إلّا شهر واحد

169
00:11:57,170 --> 00:11:59,190
من فضلكِ علّميني هندسة الرّقصة

170
00:12:00,480 --> 00:12:02,950
أريد أن أرقص

171
00:12:02,950 --> 00:12:04,660
أريد أن أقفز

172
00:12:04,660 --> 00:12:06,820
أريد أن أدور

173
00:12:06,820 --> 00:12:09,030
...تشيزورو-سان

174
00:12:09,030 --> 00:12:10,840
يمكنك تعلّم هندسة الرّقصة لاحقاً

175
00:12:10,840 --> 00:12:13,480
حالما تفهم الأساسيّات، سيغدو الرّقص سهلاً

176
00:12:14,310 --> 00:12:15,470
جومبي

177
00:12:17,000 --> 00:12:18,840
،حالما تصبح الأساسيّات جزءاً من الغريزة

178
00:12:19,400 --> 00:12:21,570
ستتمكّن من الرّقص بحرّية أكبر

179
00:12:24,840 --> 00:12:27,920
لو-كن، لم تتناول العشاء، أليس كذلك؟

180
00:12:28,650 --> 00:12:31,350
أنت تأكل أطعمة ضارّة فحسب، صحيح؟

181
00:12:32,030 --> 00:12:36,230
أرسلت جدّتك بطاقة بريديّة

182
00:12:40,640 --> 00:12:42,610
ماذا عن عقدك معي؟

183
00:12:52,860 --> 00:12:56,620
وكأنّني أُجبَر على اتّخاذ قالب باليه مُعيّن

184
00:12:57,130 --> 00:13:00,040
...الرّقص بحرّية أكبر بدلاً من الرّقص مثلما أريد

185
00:13:00,630 --> 00:13:03,440
ما هذا؟

186
00:13:03,440 --> 00:13:08,170
إلى أي حدّ يعني أنّني أستطيع الوصول؟

187
00:13:08,640 --> 00:13:11,640
84-453-3-7-8 ،أسوغايا-نانتو
سوغينامي-كن، طوكيو
إلى: موري لو غوداي
،عنوان المنزل: هينيموسو، الحيّ 3
كوراغوماوجي، كاناغاوا
تقول كوزورو-سان أنّ صورتها لهذا
الأسبوع ترتدي فيها تنّورة باليه -من الطاقم

188
00:13:09,500 --> 00:13:15,300
لو، تريد الدّراسة في بلاد الخارج في مدرسة
باليه أجنبيّة تحت جناح مُعلّمين مشاهير

189
00:13:15,300 --> 00:13:19,150
كي تفعل ذلك، عليك الرّقص في منافسات
خارج البلاد والحصول على منحة دراسيّة

190
00:13:19,610 --> 00:13:20,640
صحيح؟

191
00:13:22,700 --> 00:13:25,890
مقابل تهيئة الأمور لك للمُشاركة في
،منافسات خارج البلاد

192
00:13:25,890 --> 00:13:27,610
:أعطيتُك شرطين

193
00:13:27,610 --> 00:13:33,040
اذهب إلى المدرسة واربح للحصول على
لقب الرّاقص الأوّل في مهرجان الباليه

194
00:13:33,040 --> 00:13:35,210
—كي تفعل ذلك، عليك المشاركة في الدرو

195
00:13:35,210 --> 00:13:36,240
...أنا

196
00:13:37,050 --> 00:13:40,430
لا أعتقد أنّني أستطيع الدّراسة تحت
جناحك في نهاية المطاف

197
00:13:41,040 --> 00:13:44,410
لا أتحمّل الوقوف على نفس المسرح الّذي
يقف عليه ذلك القرد الجامح

198
00:13:44,410 --> 00:13:50,050
يريد أن يكون راقصاً نبيلاً مثل بولشوي أو مارينسكي؟

199
00:13:50,490 --> 00:13:51,720
!يا للسخافة

200
00:13:53,700 --> 00:13:55,180
لا يُعجبك ذلك؟

201
00:13:57,020 --> 00:14:01,540
ألم ترد جدّتك نفس الأمر لأجلك؟

202
00:14:11,600 --> 00:14:14,000
!كان ليفعلها مازورو في محاولة واحدة

203
00:14:14,470 --> 00:14:17,460
!كان ليفعلها مازورو بجماليّة أكبر

204
00:14:18,280 --> 00:14:19,670
...كان باستطاعة مازورو

205
00:14:24,920 --> 00:14:27,400
مفتاح الاستديو؟

206
00:14:30,700 --> 00:14:32,930
ليس في الخزانة؟

207
00:14:33,280 --> 00:14:35,390
ربّما سهِرَ أحدهم حتّى وقت متأخّر

208
00:14:35,860 --> 00:14:37,570
...صندوق البريد إذاً

209
00:14:37,570 --> 00:14:39,550
ماذا؟ ليس هنا

210
00:14:41,730 --> 00:14:42,950
!لو؟

211
00:14:49,650 --> 00:14:52,250
أهذه الموسيقى من دون كيخوتي؟

212
00:15:22,900 --> 00:15:24,270
!جومبي؟

213
00:15:24,270 --> 00:15:26,620
!لا يجوز أن ترقص دون إذن

214
00:15:26,620 --> 00:15:29,480
مياكو، يقوم بتمارين قضيب ارتكاب فحسب

215
00:15:34,160 --> 00:15:35,030
!جومبي؟

216
00:15:39,070 --> 00:15:42,000
هل كان يفعل هذا طوال اللّيل؟

217
00:15:42,000 --> 00:15:43,960
هذا مستحيل، صحيح؟

218
00:15:45,840 --> 00:15:47,160
إنّه مهترئ تماماً

219
00:15:47,160 --> 00:15:48,920
!غير ممكن! هذا مستحيل

220
00:15:49,240 --> 00:15:52,410
لم يمضِ على ارتدائه هذا الحذاء شهر حتّى

221
00:15:53,560 --> 00:15:55,390
...لم تكن مجرّد ليلة واحدة

222
00:15:57,300 --> 00:16:00,930
مُحال أن ينتهي المطاف به هكذا ما لم
يكن يرقص في كلّ ليلة

223
00:16:07,200 --> 00:16:10,420
أهلاً بعودتك. سأغادر الآن

224
00:16:11,190 --> 00:16:14,450
يا إلهي. كنتَ تُغادر في هذا الوقت؟

225
00:16:14,740 --> 00:16:19,200
كنتُ أقول لنفسي أنّه عندما أستيقظ، كلّ ما يبقى
هو الكثير من الملابس لغسلها

226
00:16:19,200 --> 00:16:22,620
تظلّ مُعلّمتي تلحُّ عليّ وتزعجني بشأن
النّوم أربع ساعات في اللّيلة على الأقلّ

227
00:16:22,620 --> 00:16:23,920
لذا عدتُ إلى لمنزل

228
00:16:24,330 --> 00:16:27,210
أعلم بأنّها إجازة الصّيف، لكن هل أنت متأكّد حقّاً؟

229
00:16:27,210 --> 00:16:28,550
لا تقلقي

230
00:16:28,550 --> 00:16:31,170
عندما أسمع الموسيقى، لا أحتاج للنوم

231
00:16:31,170 --> 00:16:33,770
لم تكن أنت من قلقتُ بشأنه

232
00:16:34,390 --> 00:16:36,030
،منذ كنتَ صغيراً

233
00:16:36,030 --> 00:16:38,510
لم تكن تنام كثيراً. لم أعرف ماذا أفعل معك

234
00:16:39,050 --> 00:16:42,240
لكن ألا تسبّب المتاعب لمُعلّمتك؟

235
00:16:43,390 --> 00:16:45,900
...أمّي، تبدين... أكبر

236
00:16:46,320 --> 00:16:49,080
لا داعي لتبقي معي طوال الوقت

237
00:16:49,080 --> 00:16:52,650
سيكون مضيعة للوقت إذا تمرّنتَ
على الحركات بشكل خاطئ

238
00:16:52,650 --> 00:16:56,410
حسناً، أعتقد حان الوقت لتجربة الرّقصة الثنائيّة

239
00:16:58,370 --> 00:17:01,220
!مرحى! أخيراً

240
00:17:01,880 --> 00:17:04,370
!أعرف هندسة الرّقصة سلفاً

241
00:17:04,890 --> 00:17:08,210
!كنتُ أشاهدكما ترقصانها

242
00:17:08,210 --> 00:17:10,820
حسناً إذاً، فلتجرّبها إذاً

243
00:17:15,810 --> 00:17:18,320
حسناً، تشغيل الموسيقى

244
00:17:19,370 --> 00:17:25,070
،تأتي إلى البحيرة لاصطياد بجعات بداعي التّسلية

245
00:17:25,070 --> 00:17:30,060
لكن بدلاً من بجعة، تظهر فتاة وهي
من النمط المُفضّل لديك

246
00:17:31,170 --> 00:17:32,400
نمط"؟"

247
00:17:36,170 --> 00:17:39,380
هذه هي. جومبي، لا تخجل

248
00:17:39,380 --> 00:17:41,430
فأنت الأمير

249
00:17:42,110 --> 00:17:45,770
كلُّك فضول. أنت بريء وواثق

250
00:17:45,770 --> 00:17:48,050
لا تعلم ما الّذي يعنيه أن يكرهك النّاس

251
00:17:48,050 --> 00:17:50,010
أنت أمير بعمر الرّابعة عشر

252
00:17:50,920 --> 00:17:53,850
!يا إلهي

253
00:17:53,850 --> 00:17:55,430
ما هذا؟

254
00:17:55,430 --> 00:17:56,940
ما أنتِ؟

255
00:17:57,980 --> 00:18:02,070
!صوت الهاجس هذا... لا يزول

256
00:18:03,530 --> 00:18:05,240
أخبريني

257
00:18:05,240 --> 00:18:09,690
أخبريني بسرّ لم تروِه لأحد آخر من قبل

258
00:18:10,820 --> 00:18:16,200
انظري، وكأنّ العالم يتغيّر متى لمسناه

259
00:18:26,290 --> 00:18:27,290
أخبريني

260
00:18:28,770 --> 00:18:32,290
ماذا سيحدث إذا لمستُكِ أكثر؟

261
00:18:32,620 --> 00:18:33,420
هذا يكفي

262
00:18:34,040 --> 00:18:36,800
مذهل، أنت تعرف حقّاً هندسة الرّقصة

263
00:18:37,770 --> 00:18:39,570
كان تمثيلك ممتازاً أيضاً

264
00:18:40,310 --> 00:18:42,910
...في الواقع، لستُ أدري ما إن كنتُ أمثّل

265
00:18:42,910 --> 00:18:45,850
،مياكو، بدوتِ مُنفرّة من الأمير المتحمّس

266
00:18:45,850 --> 00:18:47,640
لكن تلك البراءة كانت مناسبة أيضاً

267
00:18:47,640 --> 00:18:48,160
—ما

268
00:18:48,160 --> 00:18:49,170
"مُنفرّة"

269
00:18:49,170 --> 00:18:50,690
!لم يكن الأمر كذلك

270
00:18:51,060 --> 00:18:54,650
...كنتُ فقط... متفاجئة

271
00:18:55,010 --> 00:18:56,860
!لكن نسيت الأساسيّات

272
00:18:56,860 --> 00:18:59,840
كانت أصابعك رخوة ولم تشدّ ركبتيك

273
00:18:59,840 --> 00:19:02,200
هذا ما يحدث عندما تتعلّم كلّ شيء
في فترة قصيرة جدّاً

274
00:19:02,600 --> 00:19:04,520
،في الأداء المُقبل

275
00:19:04,520 --> 00:19:07,700
أعطِ الأولويّة للتموضع الصّحيح بدلاً من التّمثيل

276
00:19:08,250 --> 00:19:10,740
،ستتمّ مُقارنتك عند الرّقص مع لو تحديداً

277
00:19:10,740 --> 00:19:13,030
وستبرز العيوب في رقصك

278
00:19:15,380 --> 00:19:18,340
متى سيأتي للتمرين؟

279
00:19:21,820 --> 00:19:25,550
...سوف يتجنّبني على الأغلب

280
00:19:41,200 --> 00:19:43,030
!أنت هنا

281
00:19:45,060 --> 00:19:47,170
!انتظر لحظة

282
00:19:47,700 --> 00:19:50,600
تعرف الجزء الّذي يرقص فيه روتبارت والأمير معاً؟

283
00:19:50,600 --> 00:19:52,060
نفّذه معي

284
00:19:52,060 --> 00:19:53,670
سأعود للمنزل بعد ذلك

285
00:20:00,380 --> 00:20:02,870
هذا عندما يتشاجران، صحيح؟

286
00:20:04,010 --> 00:20:06,890
سترقص في المهرجان، أليس كذلك؟

287
00:20:07,900 --> 00:20:09,270
...مهلاً

288
00:20:16,310 --> 00:20:20,670
هل كانت توجد حركة كهذه في هندسة الرّقصة؟

289
00:20:23,180 --> 00:20:24,830
عُد للمنزل أيّها القرد الجامح

290
00:20:26,510 --> 00:20:28,150
...أنت

291
00:20:29,250 --> 00:20:31,570
لماذا رقصت في الصّالة الرياضيّة؟

292
00:20:32,840 --> 00:20:34,430
هذا مذهل، صحيح؟

293
00:20:34,910 --> 00:20:37,120
،لديك نادي مُعجبين الآن

294
00:20:37,120 --> 00:20:39,930
والفيديو الّذي صدر منه حقّق شعبيّة كبيرة

295
00:20:39,930 --> 00:20:41,930
!تغيّر كلّ شيء بسبب ذلك الأمر

296
00:20:41,930 --> 00:20:43,460
لم يتغيّر شيء

297
00:20:44,840 --> 00:20:50,490
فقدَ اهتمامهم بي لأنّك شتّتتهم

298
00:20:50,490 --> 00:20:51,680
!ماذا؟

299
00:20:52,110 --> 00:20:55,690
هل كنتَ تحاول فرض "عدالتك" المقرفة عليّ؟

300
00:20:55,690 --> 00:20:58,310
!كان ليكون أفضل لو أنّهم استمرّوا في السخرية منّي

301
00:20:58,310 --> 00:20:59,820
!الأمر ليس كذلك

302
00:20:59,820 --> 00:21:01,570
!ليس كذلك إطلاقاً

303
00:21:02,320 --> 00:21:05,180
!بلغَهم رقصُك في الواقع أيضاً

304
00:21:06,450 --> 00:21:10,200
...على الأقلّ، تمكّنتُ من إخبارهم آنذاك

305
00:21:10,200 --> 00:21:12,930
...وأنا هنا الآن لأنّ

306
00:21:15,010 --> 00:21:20,160
!لأنّك عندما رقصت، انتهى الأمر بتغيير حياتي

307
00:21:20,910 --> 00:21:23,970
...لهذا السّبب، أيّها الوغد

308
00:21:24,960 --> 00:21:27,970
...بصيغة أخرى، المعذرة

309
00:21:29,680 --> 00:21:31,050
شكراً

310
00:21:37,470 --> 00:21:39,260
،على أيّ حال، قلتُ ما أردتُ قوله

311
00:21:39,260 --> 00:21:40,600
!لذا سأذهب الآن

312
00:21:42,040 --> 00:21:44,040
ثمّة مسألة أخرى

313
00:21:45,000 --> 00:21:49,010
،صحيح أنّني قرد جامح مقارنة بك

314
00:21:49,010 --> 00:21:51,330
وبأنّني منهمك جدّاً في التّدريب على الأساسيّات

315
00:21:53,500 --> 00:21:54,720
لكن أتعلم؟

316
00:21:55,750 --> 00:21:57,670
،في حين أنّك تختبئ في غرفتك

317
00:21:58,270 --> 00:22:00,100
سوف أتفوّق عليك

318
00:23:34,890 --> 00:23:35,890
الحلقة القادمة

319
00:23:36,160 --> 00:23:37,020
!أوديتّو

320
00:23:37,430 --> 00:23:41,150
!أوّل فتاة اخترتُها لنفسي، تعصي الملكة

321
00:23:41,150 --> 00:23:43,690
!أردتُ أن أكون مخلصاً لك

322
00:23:44,270 --> 00:23:47,940
:راقص الباليه، الفصل 5
!"لا يمكنني الموت الآن"