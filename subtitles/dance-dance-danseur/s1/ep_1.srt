!انتظر يا موراو

205
00:14:15,580 --> 00:14:17,580
ماذا؟ ما زلتِ مستيقظة؟

206
00:14:18,280 --> 00:14:19,930
...المعذرة يا أمّي

207
00:14:19,930 --> 00:14:21,880
هل موراو غير جيّد حقّاً؟

208
00:14:23,510 --> 00:14:25,430
...الدّون كيشوت خاصّته

209
00:14:26,110 --> 00:14:28,630
،صحيح أنّها كانت فوضويّة

210
00:14:29,130 --> 00:14:31,030
...لكن ذلك الصّوت

211
00:14:31,030 --> 00:14:33,640
...كنفحة رياح

212
00:14:34,080 --> 00:14:36,390
هل كنتُ أتوهّم؟ ما رأيكِ يا أمّي؟

213
00:14:37,590 --> 00:14:40,760
حسناً، عليه أن يأتي بمفرده غداً

214
00:14:40,760 --> 00:14:42,520
إن لم يأتِ، انتهى الأمر

215
00:14:43,450 --> 00:14:46,280
هيّا، عدم الحصول على ما يكفي من
النّوم سوف يؤثّر على نموّك

216
00:14:46,650 --> 00:14:47,900
اخلدي إلى النّوم بسرعة

217
00:14:47,900 --> 00:14:49,320
ماذا؟

218
00:14:49,320 --> 00:14:51,120
!ستسرقه مدرسة أخرى

219
00:14:51,120 --> 00:14:52,910
ذلك الطفل اللّعين؟

220
00:15:00,030 --> 00:15:01,790
...ذلك الطفل اللّعين

221
00:15:02,400 --> 00:15:06,700
بعد رؤية ذلك، من الطبيعي أن أُصاب بالأرق

222
00:15:09,880 --> 00:15:11,890
لو، هل استيقظت؟

223
00:15:14,810 --> 00:15:16,390
...مفتاح الاستديو

224
00:15:30,350 --> 00:15:32,610
هل يمكنكن إنزال سرّة بطنكن لمُلامسة الأرض؟

225
00:15:32,610 --> 00:15:36,030
جيّد، جيّد! احرصن على مدّ أصابع أقدامكن

226
00:15:36,030 --> 00:15:40,250
سينسي! يوجد فتى غريب هنا

227
00:15:40,250 --> 00:15:42,750
هل نتّصل بالشرطة؟

228
00:15:43,630 --> 00:15:45,010
!أيّتها العجوز

229
00:15:45,010 --> 00:15:47,250
!أنا تجسيد القدرة الرياضيّة

230
00:15:48,700 --> 00:15:50,470
!ما العيب في رقصي؟

231
00:15:51,640 --> 00:15:53,470
أتيت إلى هنا لتتمرّن، صحيح؟

232
00:15:53,470 --> 00:15:55,050
!لـ-لا، لم أفعل

233
00:15:55,050 --> 00:15:57,580
ما أريتني إيّاه من قبل كان مفاجئاً قليلاً

234
00:15:57,580 --> 00:15:59,420
هذه المرّة، أرِني ما يمكنك فعله حقّاً

235
00:15:59,420 --> 00:16:01,560
!ألا تقصدين "أرِني أرجوك" أيّتها العجوز اللّعينة؟

236
00:16:01,560 --> 00:16:04,130
!كفّ عن مناداتي بـ"العجوز" أيّها الطفل اللّعين

237
00:16:04,130 --> 00:16:07,580
حسناً يا فتيات! يقول هذا الفتى بأنّه سيرقص

238
00:16:07,580 --> 00:16:09,570
!لا أريد رؤية ذلك

239
00:16:11,730 --> 00:16:14,110
...حسناً، سأُريكِ

240
00:16:14,110 --> 00:16:18,120
الدون كيشوت خاصّتي الّتي قضيتُ
!طوال اللّيل أدرسها

241
00:16:20,120 --> 00:16:22,120
...لنرَ

242
00:16:26,630 --> 00:16:28,130
—واحد، اثنان، ثـ

243
00:16:28,130 --> 00:16:29,500
!توقّف

244
00:16:29,500 --> 00:16:31,880
!مِرفقك! ظهرك! رؤوس أصابعك! أصابع أقدامك

245
00:16:30,320 --> 00:16:31,880
!مؤلم

246
00:16:31,880 --> 00:16:33,260
!الرّكبتان! انتبه

247
00:16:34,560 --> 00:16:36,890
لا يمكنك حتّى الوقوف بشكل صحيح

248
00:16:37,720 --> 00:16:40,970
!أكثر! أكثر، أكثر، أكثر، أكثر
!مُدّ عمودك الفقريّ أكثر

249
00:16:40,970 --> 00:16:43,040
!هكذا! أطول

250
00:16:43,040 --> 00:16:45,180
يجب الوقوف مُنتصب القامة وشدّ الظهر، صحيح؟

251
00:16:45,180 --> 00:16:45,900
—رأيتُ عبر الإنترنت

252
00:16:45,900 --> 00:16:47,860
جرّب الزفير وجعل معدتك جوفاء

253
00:16:49,820 --> 00:16:52,360
أجل، هذا جيّد كبداية

254
00:16:52,360 --> 00:16:54,580
!ماذا؟ حقّاً أيّتها العجوز؟

255
00:16:54,580 --> 00:16:56,470
كنتَ تبرز صدرك زيادة عن اللّزوم

256
00:16:56,470 --> 00:16:58,810
حاول التّركيز على ظهرك

257
00:16:59,240 --> 00:17:03,510
تظاهر بأنّ هناك شخصاً يمسكك من
تحت سرّتك وخلف عنق

258
00:17:03,510 --> 00:17:05,680
افتح كتفيك أكثر قليلاً

259
00:17:05,680 --> 00:17:06,660
جيّد

260
00:17:06,660 --> 00:17:11,000
...ثمّ كُن أطول وأطول وأطول وأطول

261
00:17:11,270 --> 00:17:12,080
جيّد

262
00:17:12,080 --> 00:17:15,380
ثمّ تظاهر بأنّك تُسحَب أعلى إلى
،أن تقف على رؤوس أصابع قدميك

263
00:17:15,380 --> 00:17:16,630
واضغط على الأرض

264
00:17:16,630 --> 00:17:19,140
...هذه هي الوضعيّة الصّحيحة

265
00:17:19,710 --> 00:17:22,140
!هذه هي الباليه

266
00:17:22,400 --> 00:17:25,890
!قرّب فخذيك إلى بعضهما الآخر أكثر
هناك مساحة كبيرة هنا

267
00:17:25,890 --> 00:17:28,770
...أيّتها العجوز، تلمسينني كثيراً

268
00:17:28,770 --> 00:17:29,900
!عنقك

269
00:17:33,150 --> 00:17:35,710
!جيّد! أنت هنا

270
00:17:35,710 --> 00:17:39,550
لم تكن في المنزل، لذا ظننتُ بأنّك
ذهبتَ للجيت كون دو

271
00:17:39,550 --> 00:17:42,360
!هذه الفتاة مهتمّة بي حتماً

272
00:17:43,660 --> 00:17:46,160
!الجيت كون دو! تبّاً، يجب عليّ الذّهاب

273
00:17:46,160 --> 00:17:47,670
انتظر

274
00:17:47,670 --> 00:17:49,290
من الآن فصاعداً، تعال في كلّ يوم

275
00:17:49,820 --> 00:17:51,570
عليك أن تكون بمستوى مهاري مُعيّن

276
00:17:51,570 --> 00:17:53,550
قبل نشيد اتّحاد الرّقص

277
00:17:55,820 --> 00:17:57,150
—ماذا؟ من قال بأنّني سأشارك في

278
00:17:57,150 --> 00:17:58,820
!تغمرني السّعادة

279
00:17:58,820 --> 00:18:00,690
!لنعمل بجدّ معاً يا موراو

280
00:18:00,690 --> 00:18:03,230
ما-ما مشكلة استديو الباليه هذا؟

281
00:18:03,230 --> 00:18:04,630
أهي خدمة مواعدات؟

282
00:18:07,200 --> 00:18:09,810
...على أيّ حال، هل يعني هذا

283
00:18:09,810 --> 00:18:12,040
...حتّى الآن، أنا

284
00:18:12,040 --> 00:18:14,490
...قد لا أستطيع

285
00:18:16,110 --> 00:18:18,460
!لن أؤدّي ذلك الشيء المدعو بالنّشيد

286
00:18:20,740 --> 00:18:23,260
تبّاً، ثمّة مشكلة ما

287
00:18:23,260 --> 00:18:25,750
!يجب أن أكون رائعاً! رجوليّاً

288
00:18:27,080 --> 00:18:28,250
تبدو ممتازاً اليوم

289
00:18:29,500 --> 00:18:31,000
لا تتحمّس كثيراً

290
00:18:32,060 --> 00:18:34,500
!هذا ممتع! إنّه الأروع

291
00:18:35,410 --> 00:18:41,020
لكن لماذا لا أشعر بتلك "الزلزلة!" أو
حتّى ذلك اللّمعان؟

292
00:18:43,720 --> 00:18:47,520
أبقِ إصبعك الوسطى ممدودة واثنِ
إبهامك عند أسفل الكفّ

293
00:18:47,520 --> 00:18:51,620
...آن با، آن أفان، ألا سيكوند

294
00:18:52,220 --> 00:18:53,840
أبقِ مِرفقيك مرتفعين

295
00:18:53,840 --> 00:18:55,330
آن هو

296
00:18:55,330 --> 00:18:57,730
موراو، هل لديك سؤال؟

297
00:18:57,730 --> 00:18:59,530
!لـ-لا

298
00:18:59,700 --> 00:19:01,060
!جومبي

299
00:19:02,280 --> 00:19:03,920
إلى أين أنت ذهب؟

300
00:19:03,920 --> 00:19:06,040
هيو-تشان

301
00:19:06,460 --> 00:19:10,300
لم تأتِ إلى النّادي إطلاقاً في هذا الأسبوع

302
00:19:10,300 --> 00:19:11,500
هل كان لديك جيت كون دو؟

303
00:19:12,840 --> 00:19:15,210
موراو، ستغادر الآن، صحيح؟

304
00:19:15,210 --> 00:19:17,900
—قالت المعلّمة أنّ عليك أن تحظى بالملابس المناسبة

305
00:19:19,010 --> 00:19:21,900
صحيح! غوداي-سان، لديك واجب الصفّ
اليوم، أليس كذلك؟

306
00:19:21,900 --> 00:19:24,470
!سأذهب إلى النّادي اليوم. إلى اللّقاء

307
00:19:26,470 --> 00:19:29,230
أنت مُحرج من مُمارسة الباليه

308
00:19:29,230 --> 00:19:33,310
...في الواقع، كوّنتُ هذه الصّورة

309
00:19:33,310 --> 00:19:35,860
سوف تنكشف في مهرجان الباليه

310
00:19:35,860 --> 00:19:37,090
أخبرتُكِ بأنّني لن أشارك

311
00:19:37,090 --> 00:19:39,580
ماذا؟ لكنّك تذهب إلى الاستديو يوميّاً

312
00:19:39,580 --> 00:19:42,740
—تحصل على دروس مجّانية كونك سوف تؤدّي

313
00:19:42,740 --> 00:19:45,650
...لـ-لم أذكر شيئاً عن الأداء

314
00:19:45,650 --> 00:19:47,450
على أيّ حال، لا تخبري أحداً

315
00:19:50,810 --> 00:19:54,460
لأنّني ينبغي أن أخبرهم بنفسي

316
00:19:55,260 --> 00:19:57,540
...هذا ما أعتقده، لكن

317
00:19:57,540 --> 00:20:00,430
،إذا اكتشفوا بأنّني أمارس الباليه

318
00:20:00,430 --> 00:20:01,820
سينتهي الأمر

319
00:20:03,240 --> 00:20:04,930
هيو-تشان، ماذا تفعل؟

320
00:20:04,930 --> 00:20:06,400
أسجّل فيديو

321
00:20:06,400 --> 00:20:09,430
آمل أن يحدث شيء طريف

322
00:20:09,430 --> 00:20:10,230
ماذا؟

323
00:20:14,150 --> 00:20:17,010
احتاج شيئاً أكثر طرافة

324
00:20:17,010 --> 00:20:21,110
تذكّرت، سيبدأ تدريب المُعسكر الصّيفي
في 20 و 21 أغسطس

325
00:20:21,110 --> 00:20:22,290
ستذهب، صحيح؟

326
00:20:22,290 --> 00:20:23,770
بالطبع

327
00:20:25,230 --> 00:20:28,410
كان مُعسكر التدريب في العام الماضي
ممتعاً على أيّ حال

328
00:20:29,520 --> 00:20:34,630
لكن لن أتمكّن من الذّهاب إلى
الباليه أثناء تلك الفترة

329
00:20:38,290 --> 00:20:39,790
!تأخّرت

330
00:20:39,790 --> 00:20:41,920
،لستَ جاهزاً لهذا الدّرس

331
00:20:41,920 --> 00:20:43,680
!لذا مارس تمارين التمدّد في الزاوية

332
00:20:45,500 --> 00:20:47,760
...سأمارس التمدّد في الطابق العلويّ

333
00:20:50,140 --> 00:20:53,390
...مُحال أن أتمكّن من التمدّد في تلك الغرفة

334
00:20:53,390 --> 00:20:55,400
مهرجان سوغينامي 73
للباليه

335
00:20:53,390 --> 00:20:58,900
‏21 أغسطس

336
00:20:55,400 --> 00:20:58,900
مهرجان الباليه

337
00:20:55,400 --> 00:20:58,900
قاعدة زينيون سوغينامي الكبيرة

338
00:20:56,560 --> 00:20:58,140
إنّه في نفس يوم معسكر تدريبنا

339
00:20:59,720 --> 00:21:03,200
جومبي، تلقّيتُ مكالمة من ميوكا-كن

340
00:21:03,200 --> 00:21:05,410
يقول بأنّك تتغيّب عن الجيت كون دو؟

341
00:21:05,410 --> 00:21:08,650
لكن أمسيتَ تعود للمنزل متأخّراً في
الآونة الأخيرة. أليس كذلك؟

342
00:21:08,650 --> 00:21:13,410
لـ-لديّ شؤون النّادي، ثمّ أخرج مع
...هيو-تشان والآخرين

343
00:21:13,410 --> 00:21:14,970
حقّاً؟

344
00:21:14,970 --> 00:21:20,880
جومبي، قلتَ لميوكا-كن بأنّك تريد
أن تكون مُنسّق مُجازفات مثل أبيك؟

345
00:21:20,880 --> 00:21:24,800
حسناً، ظننتُ أنّه سيكون من الجيّد
...لو أستطيع أن أكون كذلك

346
00:21:24,800 --> 00:21:28,800
لا يجوز أن ترسم مستقبلك اعتماداً على ما فعله أبوك

347
00:21:29,830 --> 00:21:31,630
...ماذا تقصدين؟

348
00:21:31,630 --> 00:21:36,970
،كان رأس والدك مليئاً بالفنون القتاليّة والمجازفات

349
00:21:36,970 --> 00:21:40,570
لكن لا يبدو الأمر كذلك بالنسبة لك إطلاقاً يا جومبي

350
00:21:42,600 --> 00:21:45,000
...ظننتُ بأنّ أمّي ستكون سعيدة

351
00:21:45,480 --> 00:21:48,160
لأنّني قرّرتُ أن أحذو حذوّ أبي

352
00:21:48,830 --> 00:21:51,570
كان أبي رائعاً للغاية أيضاً

353
00:21:51,910 --> 00:21:54,910
شركة أويكاوا هاروكا للباليه

354
00:21:51,910 --> 00:21:55,280
هذه تذكرة لحضور باليه بحيرة البجعة

355
00:21:55,280 --> 00:21:58,170
ارتأيتُ أنّ بمقدورك أداء هذه
الرّقصة في مهرجان الباليه

356
00:21:58,520 --> 00:21:59,670
ستكون الأمير

357
00:21:59,670 --> 00:22:00,640
!ماذا؟

358
00:22:00,640 --> 00:22:03,760
لا يمكنك المجيء إلى هنا باكراً
كما سبقَ وفعلت؟

359
00:22:03,760 --> 00:22:06,940
وأودّ التّعريف عن نفسي لأمّك، لذا
—هل يمكنني الحصول على رقم هاتفهـ

360
00:22:06,940 --> 00:22:08,030
!لا مشكلة

361
00:22:08,030 --> 00:22:10,240
أخبرتُها بأنّها شؤون تتعلق بالنّادي

362
00:22:10,240 --> 00:22:12,920
ولن أرقص في مهرجان الباليه ذاك

363
00:22:12,920 --> 00:22:15,600
يتزامن مع مُعسكر تدريب كرة القدم الخاص بي

364
00:22:16,840 --> 00:22:18,930
إذاً اعتزل كرة القدم

365
00:22:18,930 --> 00:22:19,680
!ماذا؟

366
00:22:19,680 --> 00:22:23,360
ستجعلك كرة القدم تبني عضلات لست
بحاجة لها، وسيكون ذلك شاقّاً لاحقاً

367
00:22:23,360 --> 00:22:25,020
فضلاً عن أنّك لست بحاجة لعضلات كبيرة

368
00:22:25,020 --> 00:22:27,870
—ماذا؟! أتكلّم عن ناديّي هنا! إنّه نشاط مدرسي رسمي

369
00:22:27,870 --> 00:22:29,700
وماذا يعني؟

370
00:22:30,560 --> 00:22:34,540
سوف تصبح راقص باليه، صحيح؟

371
00:22:39,790 --> 00:22:41,130
ماذا تقولين؟

372
00:22:41,130 --> 00:22:44,150
!هل جُننتِ أيّتها العجوز؟

373
00:22:44,150 --> 00:22:49,560
أخبرتُك! لديّ نادٍ وأصدقائي والجيت
...كون دو، وعائلتي

374
00:22:50,160 --> 00:22:51,430
...و

375
00:23:02,200 --> 00:23:04,020
!توقّفي! توقّفي أيّتها العجوز

376
00:23:04,020 --> 00:23:04,940
أتوقّف عن ماذا؟

377
00:23:05,690 --> 00:23:07,900
...لكن، حسناً

378
00:23:07,900 --> 00:23:11,880
هذا فقط إذا استطعتَ التخلّي عن كلّ شيء آخر

379
00:23:19,000 --> 00:23:20,170
لو-كن؟

380
00:23:22,140 --> 00:23:24,380
هناك تلميذ جديد

381
00:23:24,380 --> 00:23:26,750
صبيّ في نفس صفّ مياكو

382
00:23:27,800 --> 00:23:30,880
قد يكون أكثر موهبة منك

383
00:23:34,890 --> 00:23:35,890
الحلقة القادمة

384
00:23:36,410 --> 00:23:39,220
ما خطب هذا الشّخص؟ هل يقلّل من شأني؟

385
00:23:39,220 --> 00:23:42,560
!وذراعه حول كتفها فجأة

386
00:23:42,560 --> 00:23:48,280
راقص الباليه، الفصل 2: "إنّه... من
"!النّوع الّذي لا يمكنني مُصادقته