ا

34
00:02:42,290 --> 00:02:47,450
الأوركسترا الزرقاء

35
00:04:03,320 --> 00:04:04,200
!تبًا

36
00:04:03,700 --> 00:04:07,200
الحلقة 04: المهرجان الرياضي

37
00:04:04,660 --> 00:04:08,390
!لا يستطيع إمساك لسانه حقًا

38
00:04:08,390 --> 00:04:09,680
،توغاني-سينباي

39
00:04:09,740 --> 00:04:13,900
.لدينا ملخص اليوم للتدريب الجماعي

40
00:04:14,580 --> 00:04:15,650
.شكرًا

41
00:04:17,920 --> 00:04:19,410
.نستأذنك

42
00:04:38,690 --> 00:04:41,640
.الأفضل أن نعود للتمرين

43
00:04:41,640 --> 00:04:42,600
!أجل

44
00:04:43,700 --> 00:04:45,970
هل تشرح لي ما حصل قبل قليل؟

45
00:04:51,620 --> 00:04:53,560
أفقدتَ حماسك؟

46
00:04:56,000 --> 00:04:57,190
...أعتذر

47
00:04:57,380 --> 00:05:00,280
سألتُك، فلمَ لا تجيب؟

48
00:05:00,500 --> 00:05:02,070
!بلى، أنا متحمس

49
00:05:02,070 --> 00:05:05,000
.يجدر بك أن تعي مكانتك أيها الرئيس

50
00:05:05,000 --> 00:05:09,370
.إن كان رئيس النادي متساهلًا، سيتقاعس الكل

51
00:05:09,600 --> 00:05:10,750
.أعلم

52
00:05:12,600 --> 00:05:14,460
فلتُدرك أن قضاء الوقت هكذا

53
00:05:14,460 --> 00:05:16,840
.مجرد مضيعة وحسب

54
00:05:17,480 --> 00:05:20,360
...لا تجعلني أكرر كلامي

55
00:05:19,200 --> 00:05:20,550
!أنت بغيض حقًا

56
00:05:22,780 --> 00:05:26,100
.لم أتوقع أن تكون هكذا حقيقةً

57
00:05:26,990 --> 00:05:29,040
،لكنّي فهمتُ أخيرًا

58
00:05:29,040 --> 00:05:34,150
،إنك ببساطة تستمتع بإيذاء مشاعر الآخرين

59
00:05:34,330 --> 00:05:37,610
.وتنمرك على الرئيس يؤكد كلامي

60
00:05:38,960 --> 00:05:40,780
عمَّ تتحدث؟

61
00:05:41,340 --> 00:05:44,620
.نحن نراجع الأمور فحسب

62
00:05:45,220 --> 00:05:50,200
.دائمًا ما آخذ رأي يوسكي بعد كل تدريب جماعي

63
00:05:50,300 --> 00:05:52,080
.أعتذر لسوء الفهم

64
00:05:52,080 --> 00:05:54,040
هل أسأتُ الفهم؟

65
00:05:55,060 --> 00:05:59,460
.لا تقلق، الجميع يُخطئ

66
00:05:59,850 --> 00:06:03,970
...حسنٌ، الآن أعرف جيدًا

67
00:06:03,970 --> 00:06:06,180
.ما تظنه عني

68
00:06:15,250 --> 00:06:17,040
مهرجان
الصيف

69
00:06:15,850 --> 00:06:17,860
تـ-تـ-توغاني-سينباي؟

70
00:06:18,420 --> 00:06:21,490
!أنت الأفضل يا آونو

71
00:06:22,210 --> 00:06:24,070
...معدتي تؤلمني

72
00:06:27,510 --> 00:06:31,250
!أعني، مهما نظرتِ للأمر، فهو يبدو كتنمّر

73
00:06:31,250 --> 00:06:34,210
،لا أستطيع لومك

74
00:06:34,390 --> 00:06:37,420
.فساكوما لا يراعي كلماته أبدًا

75
00:06:37,810 --> 00:06:41,760
...لكن أن تهاجمه مباشرة، وأنت المخطئ

76
00:06:44,230 --> 00:06:45,590
،لكن هذا مفاجئ

77
00:06:45,590 --> 00:06:50,600
.ظننتُكَ متحفظًا، ولا تقول إلا كلامًا متواضعًا

78
00:06:50,600 --> 00:06:51,970
"متواضعًا؟"

79
00:06:52,410 --> 00:06:57,100
قليلون من طلاب السنة الثانية يجرؤون
.على محادثة ساكوما بهذه النبرة

80
00:06:57,700 --> 00:07:00,440
،بفضلك تحسّن مزاجي

81
00:07:00,440 --> 00:07:01,650
.شكرًا

82
00:07:03,170 --> 00:07:07,780
هل يُعقل أن اجتماع قسمكم سار بشكلٍ سيّئ؟

83
00:07:10,130 --> 00:07:12,410
،كانت الأجواء مريعة

84
00:07:12,640 --> 00:07:16,290
.وانتهز ساكوما الفرصة ليزيد الطين بلّة

85
00:07:18,390 --> 00:07:21,300
اسمع، هل تعرف المهرجان الرياضي؟

86
00:07:21,310 --> 00:07:25,470
.كنا نقرر مَن سيشارك في سباق التتابع

87
00:07:25,470 --> 00:07:28,760
.المهرجان... نسيته تمامًا

88
00:07:29,030 --> 00:07:33,140
.علينا إيجاد خمسة أشخاص من قسمي الوتريات والآت النفخ

89
00:07:34,070 --> 00:07:39,270
،حسنٌ، حان وقت تحديد المشاركين في سباق التتابع

90
00:07:44,960 --> 00:07:47,820
.بالطبع لم يتطوع أحد

91
00:07:47,820 --> 00:07:50,880
.لا ألومهم، فذلك مزعج

92
00:07:50,880 --> 00:07:52,120
ألا تتفق معي؟

93
00:07:52,120 --> 00:07:55,330
.من يريد ذلك، ووقت المسابقة يداهمنا

94
00:07:55,330 --> 00:07:56,910
...حـ-حسنٌ

95
00:07:56,910 --> 00:08:00,000
...أردنا في البداية ترك الأمر لقسمكم

96
00:08:01,180 --> 00:08:05,940
،تعلم، لدينا ما يكفينا من المشاغل في قسم الآت النفخ

97
00:08:05,940 --> 00:08:09,590
.إذ ينبغي أن نعزف في المسابقات الرياضية والبطولات

98
00:08:09,900 --> 00:08:15,140
.لمَ لا ندع قسم الوتريات يتولى ذلك؟! فمشاغلهم أقلّ منّا

99
00:08:17,120 --> 00:08:20,650
مَن اخترتم في النهاية إذن؟

100
00:08:21,540 --> 00:08:23,150
.أنا

101
00:08:23,150 --> 00:08:27,110
!أوقعوني في هذه المصيبة في النهاية

102
00:08:27,170 --> 00:08:29,450
.فهمت الآن

103
00:08:29,920 --> 00:08:32,700
!كله بسببه

104
00:08:32,700 --> 00:08:35,790
لمَ لا نختار قادة المجموعات؟

105
00:08:35,930 --> 00:08:38,290
!توغاني سريعة في الركض أيضًا

106
00:08:39,010 --> 00:08:41,670
!لا فائدة، يغمرني الغضب لمجرد التفكير في الأمر

107
00:08:43,850 --> 00:08:46,800
!لكل قسم مشاكله الخاصة

108
00:08:48,820 --> 00:08:52,050
مَن سيختارون من قسم الوتريات يا ترى؟

109
00:08:52,940 --> 00:08:54,810
.أنا

110
00:08:55,070 --> 00:08:59,270
.هاتوري-سينباي وتاتشيبانا سيشاركان في السباق أيضًا

111
00:09:00,410 --> 00:09:04,320
،مع التوتر والضغط من قرب المسابقة في الآونة الأخيرة

112
00:09:04,320 --> 00:09:08,740
.سيكون المهرجان الرياضي جيًدا للتنفيس عن أعضاء النادي

113
00:09:09,130 --> 00:09:11,570
.أتطلّع إلى بدئه

114
00:09:12,670 --> 00:09:13,700
.لا فارق عندي

115
00:09:15,260 --> 00:09:18,830
ألا يجدر بك استغلال وقتك بالتدريب بدلًا من التركيز
على المهرجان الرياضي؟

116
00:09:18,930 --> 00:09:21,790
.كما أنه لا يحتسب عليه درجات

117
00:09:21,790 --> 00:09:23,540
،تقول هذا

118
00:09:23,540 --> 00:09:25,840
ولكنك لا تحب الرياضة، أليس كذلك؟

119
00:09:29,110 --> 00:09:33,010
.لم أشعر بالارتياح أبدًا في هذه الفعاليات

120
00:09:33,490 --> 00:09:35,100
!يا للكآبة

121
00:09:35,400 --> 00:09:38,390
!هيا، لا داعي لكل هذا العبوس

122
00:09:38,390 --> 00:09:43,150
!لا يمكنك تفويته على أيّ حال، لذا من الأفضل أن تستمتع به

123
00:09:43,370 --> 00:09:45,020
.لن أفعل

124
00:09:45,020 --> 00:09:45,860
!يا إلهي

125
00:09:45,860 --> 00:09:48,900
.من الجيد أن تحفز نفسك لعمل أشياء أخرى غير نشاطات النادي

126
00:09:48,900 --> 00:09:52,280
.هذه وجهة نظرك، لا تحاولي فرضها عليّ

127
00:09:52,500 --> 00:09:56,080
.لا يحب الجميع هذا النوع من الفعاليات

128
00:09:56,080 --> 00:10:01,120
.لكل شخص وجهة نظر مختلفة، ولا أحد ملزم بما يفعله غيره

129
00:10:01,470 --> 00:10:02,960
...ثم إنكِ

130
00:10:02,960 --> 00:10:06,670
...لم تشاركي في الإعدادية، لذا

131
00:10:07,730 --> 00:10:08,580
.أعتذر

132
00:10:08,580 --> 00:10:10,300
.لهذا السبب بالضبط

133
00:10:10,810 --> 00:10:15,430
.حرمت نفسي من الكثير، سيكون من المؤسف ألا أستمتع الآن

134
00:10:16,190 --> 00:10:17,260
،في الواقع

135
00:10:17,320 --> 00:10:20,640
!أنا أتحرق شوقًا، لا أستطيع كبت حماسي

136
00:10:20,870 --> 00:10:25,020
.سأتمكن من إطلاق العنان لنفسي بعد كل هذه السنوات

137
00:10:25,020 --> 00:10:26,650
على ماذا تنوي؟

138
00:10:27,410 --> 00:10:31,110
عليّ البدء بالركض فورًا، وبعدها... ماذا أفعل؟

139
00:10:31,110 --> 00:10:33,400
.يجب أن أستعد جيّدًا، سأفوز حتمًا

140
00:10:33,840 --> 00:10:36,740
من المؤسف ألا نستمتع..."؟"

141
00:10:36,880 --> 00:10:39,850
ثانوية أوميماكو

142
00:10:42,600 --> 00:10:46,330
!حسنٌ، سنسحب قرعة لتحديد أدوار كل شخص في المهرجان

143
00:10:46,640 --> 00:10:48,980
قرعة
المهرجان

144
00:10:46,680 --> 00:10:49,440
ستشاركون في المنافسة

145
00:10:49,440 --> 00:10:52,170
.التي ستسحبونها

146
00:10:53,150 --> 00:10:55,050
متوتر، أليس كذلك؟

147
00:10:56,030 --> 00:11:00,140
.أشعر أنك تدعو أن تحصل على دور باهت لا يجذب الانتباه

148
00:11:00,320 --> 00:11:01,810
.ليس تمامًا

149
00:11:02,410 --> 00:11:05,690
.ما باليد حيلة الآن

150
00:11:05,830 --> 00:11:07,810
.سأفعل ما يُطلب مني

151
00:11:09,750 --> 00:11:12,150
.استسلمت لمصيرك إذن

152
00:11:14,540 --> 00:11:18,700
.وأيضًا، لم أعُد كما كنت في الإعدادية

153
00:11:22,720 --> 00:11:27,460
،في نهاية المطاف، تحمست قليلًا بدوري

154
00:11:30,060 --> 00:11:31,920
.لكنّي لن أخبر أحدًا بذلك

155
00:11:32,560 --> 00:11:34,300
.دورك يا آونو-كن

156
00:11:39,860 --> 00:11:42,010
ماذا سحبت يا آونو؟

157
00:11:42,030 --> 00:11:44,680
معركة الفرسان
(قائد)

158
00:11:48,200 --> 00:11:50,150
!مستحيل

159
00:11:53,330 --> 00:11:56,880
الأوركسترا الزرقاء

160
00:11:53,330 --> 00:11:56,880
الموسم الثاني

161
00:12:00,550 --> 00:12:02,880
المهرجان الرياضي

162
00:12:03,220 --> 00:12:07,500
.نستأنف مع منافسة " البحث عن الكنز" لطلاب  السنة الثانية

163
00:12:09,930 --> 00:12:12,040
.حظًّا موفقًا يا هارو

164
00:12:13,100 --> 00:12:14,880
شخص
معجب
به

165
00:12:22,860 --> 00:12:25,270
!رائع، حازت المركز الأول

166
00:12:26,280 --> 00:12:30,190
.تفاعلت وشجعتها، لكنها في الفريق المنافس

167
00:12:29,480 --> 00:12:31,110
.أنا في الفريق الأصفر

168
00:12:31,160 --> 00:12:33,670
!حسنٌ، هذا لا يهم

169
00:12:33,670 --> 00:12:35,280
أليس كذلك يا آونو؟

170
00:12:36,000 --> 00:12:36,990
...أجل

171
00:12:37,130 --> 00:12:38,740
...أتفق معك

172
00:12:39,000 --> 00:12:43,000
.إلى متى ستظل عابسًا؟ اقترب دورك

173
00:12:43,000 --> 00:12:47,640
.لن تفهمي حجم الضغط الذي يقع على عاتقي

174
00:12:47,640 --> 00:12:49,120
أيّ ضغط؟

175
00:12:49,120 --> 00:12:51,170
!أعني، أنا القائد

176
00:12:51,180 --> 00:12:53,840
...والقائد دائًما

177
00:12:53,840 --> 00:12:55,960
!مَن يُستهدف أولًا

178
00:12:56,020 --> 00:12:58,770
القائد

179
00:12:56,440 --> 00:12:57,720
.أنقذوني

180
00:12:57,130 --> 00:12:59,170
.نعم، فذلك دورك

181
00:12:59,570 --> 00:13:03,280
!سأكون أضعف قائد في التاريخ

182
00:13:03,320 --> 00:13:05,560
!يا لحظّي العاثر

183
00:13:05,560 --> 00:13:07,220
.لا تقلّل من نفسك

184
00:13:07,220 --> 00:13:11,520
وأضف عليها أن المعركة ستكون محتدمة، ويمكن
.أن أتعرض للإصابة

185
00:13:11,520 --> 00:13:13,190
!ها أنتما معًا كالعادة

186
00:13:14,290 --> 00:13:16,780
...يامادا-كن وسايكي

187
00:13:17,170 --> 00:13:20,990
!سمعتُ أنك القائد في معركة الفرسان

188
00:13:21,090 --> 00:13:24,120
،لا أعلم إن كان هذا سيُواسيك

189
00:13:24,300 --> 00:13:27,120
.ولكن سايكي سحب نفس المنافسة أيضًا

190
00:13:27,550 --> 00:13:28,700
حقًا؟

191
00:13:30,470 --> 00:13:31,540
،آونو-كن

192
00:13:32,520 --> 00:13:36,960
.ليكن الفائز بمعركة الفرسان هو العازف المتصدر

193
00:13:36,960 --> 00:13:38,100
لماذا؟

194
00:13:38,100 --> 00:13:41,300
.ما باليد حيلة، إذ أنه لا توجد تجارب تقييم الأداء هذه المرة

195
00:13:41,300 --> 00:13:44,810
.كفاك عبثًا، سنحتفظ بمراكزنا

196
00:13:44,810 --> 00:13:47,560
.فلنقل إذن، أنني أنتقم لما حدث هذا العطلة الصيفية

197
00:13:47,560 --> 00:13:48,660
.في أحلامك

198
00:13:51,910 --> 00:13:56,020
!حسنٌ! حسنٌ! ستبدأ المنافسة، فلتنصرفا

199
00:13:56,210 --> 00:13:57,310
!إلى اللقاء

200
00:13:59,670 --> 00:14:01,700
...لا أريد الذهاب

201
00:14:03,590 --> 00:14:06,200
!لا تقلق، سيسير كل شيءٍ على ما يرام

202
00:14:06,340 --> 00:14:09,160
!ربما تجد الأمر ممتعًا

203
00:14:10,260 --> 00:14:11,910
.حظًّا موفقًا

204
00:14:12,640 --> 00:14:15,790
آونو-كن سيكون قائدنا في معركة
الفرسان القادمة، صحيح؟

205
00:14:16,060 --> 00:14:19,050
.حسنٌ، أظنّنا خسرنا سلفًا

206
00:14:19,060 --> 00:14:20,710
.لا أظن ذلك

207
00:14:21,360 --> 00:14:23,930
،صحيح أنه ليس رياضيًا

208
00:14:24,780 --> 00:14:27,430
.لكنه رجل عند اشتداد المواقف

209
00:14:28,150 --> 00:14:30,930
.يبدو هادئًا، ولكنه عنيد

210
00:14:31,240 --> 00:14:33,640
عجبًا! هل يُعقل أنكِ

211
00:14:33,640 --> 00:14:36,110
معجبة به يا أكيني-تشان؟

212
00:14:36,440 --> 00:14:37,610
ماذا؟

213
00:14:38,790 --> 00:14:40,860
...رغم تأففي، المعركة

214
00:14:42,670 --> 00:14:44,240
!بدأت

215
00:14:50,390 --> 00:14:54,710
.سايكي وفريقه الأصفر أودوا بأنفسهم منذ البداية

216
00:14:54,710 --> 00:14:56,580
هل أنت بخير يا سايكي؟

217
00:14:57,100 --> 00:14:59,420
.على الأقل، نجت نظارته

218
00:15:00,150 --> 00:15:02,970
...أما أنا

219
00:15:03,270 --> 00:15:04,340
عجبًا؟

220
00:15:05,230 --> 00:15:08,890
.لا أحد يهتم لأمري خلافًا للمتوقع

221
00:15:08,890 --> 00:15:10,560
.حظًّا موفقًا يا آونو-كن

222
00:15:11,200 --> 00:15:14,270
...صحيح، أنا في الفريق الأصفر

223
00:15:14,270 --> 00:15:16,980
.سيبدو غريبًا إن شجعته

224
00:15:17,540 --> 00:15:19,440
...لكن، لكن

225
00:15:19,440 --> 00:15:21,400
!آونو

226
00:15:21,540 --> 00:15:23,440
!حظًّا موفقًا

227
00:15:24,790 --> 00:15:26,320
!لنهجم عليه

228
00:15:29,260 --> 00:15:31,790
،من كثرة الهروب

229
00:15:33,390 --> 00:15:35,910
،فاز الفريق الأزرق

230
00:15:36,100 --> 00:15:38,040
.وانتهت معركة الفرسان

231
00:15:39,730 --> 00:15:44,210
لم آخذ عصابة رأس واحدة، ألا بأس بذلك يا ترى؟

232
00:15:44,360 --> 00:15:45,800
الأسلوب
الدفاعي

233
00:15:46,070 --> 00:15:47,380
!بوركت جهودك

234
00:15:47,570 --> 00:15:51,220
!يا لمهارتك في الهرب، أذهلتني يا آونو

235
00:15:51,570 --> 00:15:52,970
.شكرًا

236
00:15:53,070 --> 00:15:55,270
!أبليت حسنًا أنت أيضًا يا سايكي-كن

237
00:15:55,270 --> 00:15:56,640
!وجهي يؤلمني

238
00:15:58,200 --> 00:16:00,810
.هذه الفعاليات لا تناسبني حقًا

239
00:16:01,790 --> 00:16:02,770
...لكن

240
00:16:02,960 --> 00:16:05,190
!أبليت حسنًا يا آونو

241
00:16:05,920 --> 00:16:08,570
.أنقذتنا إذ أنك خفيف الوزن

242
00:16:10,260 --> 00:16:12,870
ما الضير في أن تسمن نفسك قليلًا؟

243
00:16:13,180 --> 00:16:14,410
أتظن ذلك؟

244
00:16:14,410 --> 00:16:18,040
.أجل، أتفق. وأفضل طريقة هي تناول الرامن

245
00:16:18,040 --> 00:16:20,630
.تعال معنا في المرة القادمة لتناوله

246
00:16:20,630 --> 00:16:22,840
.أنت تأكله كل يوم

247
00:16:22,840 --> 00:16:26,010
.انظروا من يتحدث

248
00:16:30,240 --> 00:16:33,140
.سباق التتابع سيبدأ قريبًا

249
00:16:33,140 --> 00:16:36,600
.يُرجى من المشاركين الاستعداد

250
00:16:37,330 --> 00:16:39,350
.يبدو أن دورك حان

251
00:16:43,540 --> 00:16:44,540
.مستعدّة

252
00:16:46,170 --> 00:16:47,820
!بالتوفيق يا ري-تشان

253
00:16:48,000 --> 00:16:49,490
.كافحي

254
00:16:49,500 --> 00:16:51,110
.اظفري بالمركز الأول لنا

255
00:16:51,510 --> 00:16:52,990
!اعتمدوا عليَّ

256
00:16:54,430 --> 00:16:58,540
من تراه أيضًا من نادي الأوركسترا سيشارك في سباق التتابع؟

257
00:17:03,060 --> 00:17:05,460
.يامادا-كن في وضع لا يحسد عليه أيضًا

258
00:17:05,560 --> 00:17:06,760
.آونو-كن

259
00:17:07,810 --> 00:17:09,090
.كوزاكورا-سان

260
00:17:09,360 --> 00:17:14,430
!أحسنتَ في معركة الفرسان، صمدتَ حتى النهاية

261
00:17:15,950 --> 00:17:18,980
.الفضل يعود لزملائي في الفريق

262
00:17:19,080 --> 00:17:21,270
!أنت تستحق الثناء أيضًا

263
00:17:21,790 --> 00:17:24,480
،سقط الجميع غيرك

264
00:17:24,540 --> 00:17:26,980
.لكنك صمدت

265
00:17:27,000 --> 00:17:28,570
!انتبهي يا كوزاكورا-سان

266
00:17:37,260 --> 00:17:41,670
!مجرد حشرة طائرة، ظننته دبورًا

267
00:17:44,020 --> 00:17:45,590
.اعذريني

268
00:17:46,440 --> 00:17:47,630
.لا بأس

269
00:17:51,440 --> 00:17:52,550
.ها هي أكيني

270
00:17:55,280 --> 00:17:57,180
.سيبدأ سباق التتابع قريبًا

271
00:18:03,790 --> 00:18:05,150
.لا

272
00:18:10,500 --> 00:18:12,900
،أخبرني يا آونو-كن

273
00:18:14,260 --> 00:18:15,990
...ما رأيك

274
00:18:17,090 --> 00:18:18,870
بري-تشان؟

275
00:18:19,200 --> 00:18:20,250
ماذا؟

276
00:18:26,180 --> 00:18:31,420
!خذوا أماكنكم... استعدوا... انطلقوا

277
00:18:34,980 --> 00:18:36,640
!بدأ السباق

278
00:18:36,700 --> 00:18:40,600
!نادي الجوقة يتصدر السباق

279
00:18:40,700 --> 00:18:43,230
،نراها تحمل عصا المايسترو

280
00:18:43,230 --> 00:18:46,730
!وهي تقود فريقها نحو النصر

281
00:18:46,730 --> 00:18:48,150
!يا للروعة

282
00:18:50,040 --> 00:18:53,990
!يا لها من عودة مذهلة من نادي الأوركسترا

283
00:18:54,250 --> 00:18:55,860
!إنها تاتشيبانا-سان

284
00:18:56,260 --> 00:18:58,080
...أظن أن أكيني

285
00:18:58,720 --> 00:19:00,490
!ستكون الراكضة الأخيرة

286
00:19:06,350 --> 00:19:08,750
!لديكَ وجهة نظر

287
00:19:09,060 --> 00:19:12,460
!لا يقلّون شأنًا عن نادي ألعاب القوى

288
00:19:13,190 --> 00:19:15,800
!إن تجاوزتْكِ، فلن أسامحك

289
00:19:20,060 --> 00:19:21,850
!إنها العداءة الثانية كما يبدو

290
00:19:21,850 --> 00:19:24,310
!نادي الأوركسترا والجوقة في الصدارة

291
00:19:25,660 --> 00:19:28,110
أنخسر أمام نادٍ موسيقي آخر؟

292
00:19:28,500 --> 00:19:29,980
!أنا لن أخسر

293
00:19:32,210 --> 00:19:34,440
.ابذلي جهدك يا ري-تشان

294
00:19:36,840 --> 00:19:38,450
.هاتوري-سينباي

295
00:19:38,450 --> 00:19:39,570
!أجل

296
00:19:42,260 --> 00:19:44,800
!انطلق يا هاتوري

297
00:19:44,800 --> 00:19:47,710
!إن خسرت، سنقضي عليك

298
00:19:47,710 --> 00:19:49,580
!يا للؤمِكم

299
00:19:50,100 --> 00:19:52,050
!لا داعي أن تذكروني

300
00:19:52,900 --> 00:19:57,380
!يا إلهي! نادي الأوركسترا يوسع الفارق

301
00:19:57,380 --> 00:20:01,180
!يا لسرعته، رغم وزن آلته الموسيقية

302
00:20:02,780 --> 00:20:05,060
!إنه سريع

303
00:20:05,160 --> 00:20:06,560
!رائع جدًا

304
00:20:06,870 --> 00:20:09,560
.نادي الأوركسترا متصدر؟ هذا لا يعقل

305
00:20:10,040 --> 00:20:14,740
لحظة، لحظة...أتدرك حجم الضغط الذي تضعه عليّ؟

306
00:20:14,740 --> 00:20:16,530
،إن وصلتَ أولًا

307
00:20:16,530 --> 00:20:19,780
!فسأضطر للركض بأقصى سرعتي

308
00:20:19,780 --> 00:20:24,080
.توغاني-سينباي، ابذلي جهدك

309
00:20:26,040 --> 00:20:27,620
!ابذلي جهدك

310
00:20:29,020 --> 00:20:30,580
...يا إلهي

311
00:20:31,020 --> 00:20:34,170
!تُريدوني أن أركض؟ إذن، سأفعل ذلك

312
00:20:38,110 --> 00:20:42,010
،أحضرت آلة قديمة من غرفة التخزين

313
00:20:42,320 --> 00:20:46,680
،انتهى الأمر بأن نجبرك على المشاركة

314
00:20:46,950 --> 00:20:50,900
.فارتأيت أن تركضي وبيدك الآلة التي تحبين العزف عليها على الأقل

315
00:20:50,900 --> 00:20:52,480
.هذا لا يسعدني إطلاقًا

316
00:20:54,370 --> 00:20:57,110
.لا أريد مراعاةً لا داعي لها

317
00:20:57,110 --> 00:21:00,820
!والآن! العدّاؤون الأخيرون يستعدون

318
00:21:00,820 --> 00:21:03,780
.احرص على الظفر بالمركز الأول

319
00:21:04,300 --> 00:21:05,290
.حسنٌ

320
00:21:05,890 --> 00:21:07,450
الرئيس هو العداء الأخير؟

321
00:21:13,690 --> 00:21:16,880
...انظر إليه، خسرنا

322
00:21:18,650 --> 00:21:23,390
.نادي الجوقة يعود للسباق، إنه يهدف لانتزاع الصدارة

323
00:21:31,490 --> 00:21:35,230
!لا أستطيع خذلانهم هنا أيضًا

324
00:21:35,500 --> 00:21:38,110
.نادي الأوركسترا لم يستسلم بعد

325
00:21:38,420 --> 00:21:41,660
!يا للأسف، كانوا متقدمين بفارق شاسع

326
00:21:41,960 --> 00:21:44,490
.لا بدّ أنهم تلاعبوا بالترتيب

327
00:21:44,760 --> 00:21:46,450
هلّا صمتّم؟

328
00:21:47,640 --> 00:21:48,950
.اعذرنا

329
00:21:50,850 --> 00:21:52,540
.ابذل جهدك يا رئيس

330
00:21:53,560 --> 00:21:55,460
!أنت لها يا رئيس

331
00:22:00,480 --> 00:22:02,220
!انطلق

332
00:22:05,450 --> 00:22:08,010
!انطلق يا رئيس

333
00:22:19,290 --> 00:22:20,530
،اعذروني

334
00:22:20,920 --> 00:22:24,240
.خذلت جهود الجميع

335
00:22:24,340 --> 00:22:26,870
!لا عليك، لا تكتئب هكذا

336
00:22:26,870 --> 00:22:30,870
!كانت منافسة متقاربة، والمركز الثاني ليس سيئًا

337
00:22:32,100 --> 00:22:34,960
.حسنٌ، سأُعطيك درجة النجاح

338
00:22:35,640 --> 00:22:39,090
بالنظر إلى درجاتك الراسبة في
.حصة الرياضة، لم أتوقع أن تحصد المركز الثاني

339
00:22:39,230 --> 00:22:41,550
.لـ-لـ-لا تخبريهم

340
00:22:41,730 --> 00:22:46,470
لا بأس، ولكن لن نرضى بالمركز الثاني المرة القادمة، مفهوم؟

341
00:22:47,280 --> 00:22:49,470
.سنحصد المركز الأول في المسابقة

342
00:22:52,160 --> 00:22:54,560
،انتهت جميع الفعاليات

343
00:22:56,040 --> 00:23:00,230
.وانتهى المهرجان الرياضي لثانوية أوميماكو

344
00:22:57,210 --> 00:23:02,540
سنفوز بكل فعاليات المهرجان الرياضي

345
00:23:03,800 --> 00:23:07,990
حسنٌ، ما رأيكم أن نناقش أمر سباق التتابع هذا قليلًا؟

346
00:23:08,030 --> 00:23:09,240
ماذا؟

347
00:24:40,600 --> 00:24:44,090
هل آونو-كن معجب بأحد يا ترى؟

348
00:24:43,940 --> 00:24:46,920
.أروني مقطوعة الباكانال التي ستعزفونها بأنفسكم

349
00:24:46,820 --> 00:24:50,090
.لا بدّ لنا من المضي قدمًا

350
00:24:49,900 --> 00:24:53,220
.جميعنا لديه مشاكل عليه مواجهتها يومًا ما

351
00:24:54,310 --> 00:25:00,000
الحلقة 5
مشاكل

352
00:24:55,280 --> 00:25:00,000
الأوركسترا الزرقاء

353
00:24:55,280 --> 00:25:00,000
الموسم الثاني