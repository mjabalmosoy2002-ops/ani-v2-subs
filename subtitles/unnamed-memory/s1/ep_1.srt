1
00:00:03,660 --> 00:00:04,720
!يا صاحب السمو

2
00:00:05,290 --> 00:00:06,710
!أيّها الأمير أوسكار

3
00:00:07,220 --> 00:00:09,180
!هذا خطير جدًا

4
00:00:09,180 --> 00:00:10,490
!علينا أن نعود

5
00:00:10,860 --> 00:00:12,570
!أرجوك يا صاحب السمو

6
00:00:12,570 --> 00:00:14,290
.اصمت يا لازار

7
00:00:14,290 --> 00:00:16,460
كلّ مجهوداتنا للتسلل إلى القلعة

8
00:00:16,460 --> 00:00:18,400
.ستضيع هباءً إن عدنا الآن

9
00:00:18,870 --> 00:00:21,940
ماذا لو انتهى الأمر بإلقاء
الساحرة للعنة أخرى عليك؟

10
00:00:22,420 --> 00:00:24,070
.سأقلق بشأن ذلك حينها

11
00:00:24,070 --> 00:00:26,160
.لا نملك أيّ أدلة أخرى

12
00:00:26,160 --> 00:00:28,260
!أنا متأكد من وجود طريقة أخرى

13
00:00:28,260 --> 00:00:30,880
.مضت 15 سنة ولم أجد شيئًا

14
00:00:30,880 --> 00:00:35,600
أولًا، سنجد ساحرة القمر الأزرق السماوي
.ونسألها عن كيفية إزالة اللّعنة

15
00:00:35,600 --> 00:00:40,470
،إن فشل ذلك، سنجد المسؤولة
.ساحرة الصمت

16
00:00:41,480 --> 00:00:42,560
خطة متكاملة، صحيح؟

17
00:00:44,650 --> 00:00:48,080
.ساحرة مقيمة في برج أزرق سماوي

18
00:00:48,860 --> 00:00:50,770
.أمير مصاب بلعنة

19
00:00:51,500 --> 00:00:54,740
،إن كان بوسعهما إعادة الزمن
فماذا سيتمنيان؟

20
00:00:55,820 --> 00:00:59,650
.هذه قصّة يمكن إعادة كتابة كلّ شيء فيها

21
00:02:38,700 --> 00:02:39,720
.حسنًا، لنذهب

22
00:02:39,720 --> 00:02:41,750
!ا-انتظر من فضلك

23
00:02:41,750 --> 00:02:43,690
،أتفهم شعورك يا صاحب السمو

24
00:02:43,690 --> 00:02:45,870
!لكن المخاطرة كبيرة جدًا

25
00:02:45,870 --> 00:02:50,160
أصلًا، لم تُستكشَف ساحرة الصمت
.في الخمسة عشر سنة الماضية

26
00:02:50,500 --> 00:02:52,390
،وبالنسبة لساحرة القمر الأزرق السماوي

27
00:02:52,390 --> 00:02:55,590
لم يستطع أحد بلوغ قمّة
!البرج طيلة هذه السنوات

28
00:02:57,850 --> 00:03:00,020
.حسنًا، سينجح الأمر بطريقة ما

29
00:03:01,030 --> 00:03:02,740
!لا، لن ينجح

30
00:03:02,740 --> 00:03:06,950
،إن أصابك مكروه
بأيّ وجه سأعود إلى القلعة؟

31
00:03:07,300 --> 00:03:08,870
.عُد بوجه حزين فقط

32
00:03:08,870 --> 00:03:10,820
!تعلم أنّي لا أستطيع فعل ذلك

33
00:03:12,270 --> 00:03:13,510
!يا صاحب السمو

34
00:03:13,510 --> 00:03:15,550
!لا تفتح الأبواب بطيش

35
00:03:15,550 --> 00:03:17,820
!أرجو أن تتصرف بمزيد من الحذر

36
00:03:19,180 --> 00:03:22,360
.المدخل كما تصف السجلات تقريبًا

37
00:03:22,670 --> 00:03:24,250
.هذا صحيح

38
00:03:24,250 --> 00:03:26,430
،وإن صدقت السجلّات

39
00:03:26,430 --> 00:03:30,640
!ينتظرنا عدد من التحدّيات داخل هذه الجدران

40
00:03:30,850 --> 00:03:34,560
ومن يتجاوزها بلوغًا للقمّة

41
00:03:34,560 --> 00:03:37,150
.ستُحقّق الساحرة أمنيته

42
00:03:37,150 --> 00:03:38,310
.لنتحرك بسرعة

43
00:03:38,310 --> 00:03:39,040
.سريعًا

44
00:03:39,040 --> 00:03:40,810
!انتظر من فضلك

45
00:03:41,200 --> 00:03:43,290
.المكان خطير لذا انتظر هنا

46
00:03:43,290 --> 00:03:45,290
.سأعود قبل الغروب

47
00:03:45,590 --> 00:03:48,490
.لـ-لا، محال أن أسمح بهذا

48
00:03:57,680 --> 00:03:58,730
.يا صاحب السمو

49
00:03:58,730 --> 00:04:00,250
.أنا أفكّر الآن

50
00:04:00,250 --> 00:04:02,670
...لـ-لا، في الواقع

51
00:04:03,640 --> 00:04:05,980
!نحن محاطون بالأفاعي

52
00:04:06,620 --> 00:04:08,080
.أرى ذلك بوضوح

53
00:04:10,570 --> 00:04:12,640
.سنكون بخير. ليست سامّة

54
00:04:15,400 --> 00:04:17,950
.لا بدَّ أنّ هذا هو أول تحدّي

55
00:04:18,380 --> 00:04:23,700
هذه نظرية رياضية دُرست منذ حوالي
.مائة سنة في دولة شرقية صغيرة

56
00:04:23,700 --> 00:04:26,580
.اشتهرت بأنّها مسألة بلا حلّ

57
00:04:26,930 --> 00:04:28,570
!لا تُحلّ؟

58
00:04:28,570 --> 00:04:29,630
.كانت كذلك آنذاك

59
00:04:30,270 --> 00:04:32,230
.وجدوا حلّها منذ حوالي عقد من الزمن

60
00:04:41,090 --> 00:04:43,740
.فهمت. هكذا يعمل الأمر

61
00:04:43,740 --> 00:04:45,710
هل أنت متأكد أنّك لا تريد العودة؟

62
00:04:45,710 --> 00:04:47,780
.لا، صار الأمر مثيرًا للاهتمام

63
00:04:53,440 --> 00:04:56,500
يبدو أنّ بعض المتحدّين زارونا
بعد مضي زمن على آخر مرّة يا سيّدتي

64
00:04:57,150 --> 00:04:58,770
.هذا نادر الحدوث

65
00:04:58,770 --> 00:05:02,080
.اعتقدتُ أنّ الجميع نسوا وجود هذا البرج

66
00:05:02,970 --> 00:05:05,060
.كان هناك واحد آخر قبل شهر فقط

67
00:05:05,060 --> 00:05:08,660
نفد منه الوقت بعد أن عجز
.عن حلّ اللّوح الأول

68
00:05:09,000 --> 00:05:10,200
.صحيح

69
00:05:10,860 --> 00:05:14,820
يشق هذان المتحديان طريقهما
.بانتظام في البرج

70
00:05:14,820 --> 00:05:16,740
هل ترغبين في مراقبتهما؟

71
00:05:16,740 --> 00:05:18,140
.لن أذهب

72
00:05:18,140 --> 00:05:20,500
.سأرى أمرهما بعد وصولهما إلى القمة

73
00:05:21,020 --> 00:05:22,220
.أمرك

74
00:05:22,220 --> 00:05:24,270
.اذهب يا ليتولا

75
00:05:24,270 --> 00:05:27,300
.تعرفين ماذا تفعلين عند فشلهما

76
00:05:28,100 --> 00:05:29,470
.مفهوم

77
00:05:31,400 --> 00:05:34,270
،لربّما يتقدّمان بانتظام الآن

78
00:05:34,270 --> 00:05:38,650
لكن معظمهم لا يتجاوزون
.الوحش الحارس الأوّل

79
00:05:41,540 --> 00:05:44,630
لاحظتُ أنّ هذا الشيء يبدو أبيض
.بشكل كبير لكن اتضح أنّه ليس حقيقيًا

80
00:05:45,100 --> 00:05:47,310
.لا بدَّ أنّه وحش حارس مُحرَّك بالسّحر

81
00:05:47,310 --> 00:05:49,880
.سأخاف إن كان هناك أسد حقيقي بهذا الحجم

82
00:05:49,880 --> 00:05:52,400
!شجاعتك مخيفة جدًا

83
00:05:52,400 --> 00:05:54,330
.كان ذلك إحماء جيدًا

84
00:05:55,920 --> 00:05:57,300
أتظنُّ أنّي سأموت إن سقطت؟

85
00:05:57,750 --> 00:06:00,230
!أرجوك لا تقترب من الحافة

86
00:06:00,230 --> 00:06:02,460
.كان عليك الانتظار في الأسفل

87
00:06:02,870 --> 00:06:05,440
لا أستطيع تركك تموت وحيدًا
!هنا يا صاحب السمو

88
00:06:05,440 --> 00:06:06,860
.لن أموت

89
00:06:09,740 --> 00:06:11,300
كم تقدّمنا؟

90
00:06:12,110 --> 00:06:14,740
ينبغي أنّنا تجاوزنا
.المنتصف على الأقل

91
00:06:15,690 --> 00:06:19,070
آخر شخص نجح بهذا
هو جدّ جدّي، صحيح؟

92
00:06:19,070 --> 00:06:22,240
.نعم، قبل حوالي 70 سنة

93
00:06:23,030 --> 00:06:25,090
،في ذلك الوقت، شرع 10 رجال في صعوده

94
00:06:25,090 --> 00:06:29,540
لكن لم يصل إلى القمّة منهم سوى
.الملك ريغيوس الذي كان حاكمًا آنذاك

95
00:06:30,550 --> 00:06:31,550
.فهمت

96
00:06:32,080 --> 00:06:34,220
.كان هذا سهلًا لحدّ الساعة

97
00:06:34,490 --> 00:06:35,910
!علينا أن نعود حقًا

98
00:06:35,910 --> 00:06:37,280
.عُد بمفردك

99
00:06:37,280 --> 00:06:38,690
.ليس وكأنّك تساعد

100
00:06:38,690 --> 00:06:40,910
!لنعد معًا

101
00:06:42,440 --> 00:06:43,630
!صاحب السمو

102
00:06:43,630 --> 00:06:45,080
هل تسمع؟

103
00:06:54,550 --> 00:06:56,220
!سيتحرّكان بكل تأكيد

104
00:06:56,220 --> 00:06:57,230
!لنعد أدراجنا

105
00:06:57,230 --> 00:06:59,450
.انتظر في الخارج بجدية

106
00:07:19,710 --> 00:07:23,970
سيدتي، وصل المُتحدّون إلى
.غرفة التمثال الحجري

107
00:07:23,970 --> 00:07:26,300
يا له من إنجاز. كم عددهم؟

108
00:07:26,940 --> 00:07:28,030
.اثنان

109
00:07:28,030 --> 00:07:30,070
.أو بالأحرى، واحد في الواقع

110
00:07:30,500 --> 00:07:31,510
...شخص واحد

111
00:07:32,860 --> 00:07:36,340
،كنتُ سأعدّ بعض الشاي لهم
.لكن يبدو أنّه سيضيع

112
00:07:36,980 --> 00:07:40,150
هل نمنحهم جائزة مواساة
على الجهد المبذول؟

113
00:07:40,150 --> 00:07:42,120
.يبدو أنّه سيتجاوزها بسهولة

114
00:07:42,420 --> 00:07:43,100
ماذا؟

115
00:07:50,070 --> 00:07:51,760
.كانا مزعجين حقًا

116
00:07:52,420 --> 00:07:54,170
.يسرني أنّك لم تصب بأذى

117
00:07:54,520 --> 00:07:56,620
.ضربة واحدة منهما ولن أفلت سالمًا

118
00:07:57,860 --> 00:07:58,570
.لنذهب

119
00:07:58,570 --> 00:07:59,460
.نعم

120
00:08:00,410 --> 00:08:00,990
!ماذا؟

121
00:08:00,990 --> 00:08:01,710
!صاحب السمو

122
00:08:02,420 --> 00:08:03,520
!أسرع يا لازار

123
00:08:04,730 --> 00:08:06,500
...صـ-صاحب السمو

124
00:08:07,940 --> 00:08:08,520
!انتظر هناك

125
00:08:08,520 --> 00:08:09,480
!إيّاك

126
00:08:11,100 --> 00:08:11,990
.صاحب السمو

127
00:08:12,820 --> 00:08:14,390
.اسبقني

128
00:08:14,710 --> 00:08:15,620
!لا تكن غبيًا

129
00:08:15,620 --> 00:08:16,460
!ستسقط

130
00:08:16,460 --> 00:08:18,590
.لا، سأكون بخير

131
00:08:18,590 --> 00:08:23,330
.أعتذر لكنّني سأعود بدونك

132
00:08:26,350 --> 00:08:27,230
!صاحب السمو

133
00:08:27,510 --> 00:08:28,990
.اسبقني

134
00:08:28,990 --> 00:08:33,710
أنتظر بفارغ الصبر اليوم
.الذي تصبح فيه ملكًا

135
00:08:33,990 --> 00:08:35,180
!مهلًا يا لازار

136
00:08:35,180 --> 00:08:36,240
!لازار

137
00:09:15,250 --> 00:09:16,270
.مرحبًا بك

138
00:09:17,060 --> 00:09:18,660
.أعددتُ لنا بعض الشاي

139
00:09:23,690 --> 00:09:25,130
.تفضل بالجلوس

140
00:09:28,140 --> 00:09:29,140
.تشرفت بلقائك

141
00:09:29,490 --> 00:09:31,740
.اسمي تيناشا

142
00:09:31,740 --> 00:09:35,850
.رغم أنّ هناك القليل الذين ينادوني باسمي

143
00:09:35,850 --> 00:09:36,850
هل أنت الساحرة؟

144
00:09:37,780 --> 00:09:39,040
.لا تبدين كذلك لي

145
00:09:39,480 --> 00:09:42,220
.من الحماقة التشكيك في مظهر ساحرة

146
00:09:43,450 --> 00:09:45,720
.رفيقك نائم في الأسفل

147
00:09:46,380 --> 00:09:47,830
.لم يصب بأذى

148
00:09:48,200 --> 00:09:49,250
.فهمت

149
00:09:59,320 --> 00:10:01,880
هل استخدمتِ السحر لتغيير مظهرك؟

150
00:10:02,390 --> 00:10:04,660
.أنت تسأل أسئلة وقحة

151
00:10:04,660 --> 00:10:05,580
.كلّ هذا طبيعي

152
00:10:05,890 --> 00:10:09,050
،سمعتُ أنّك عشت مئات السنين
.لكن لا تظهر عليك أيّ تجاعيد

153
00:10:09,370 --> 00:10:11,670
.نعيش أضعاف عمر البشر

154
00:10:11,670 --> 00:10:14,250
.توقف جسدي عن التقدّم في العمر ببساطة

155
00:10:14,810 --> 00:10:15,910
إذًا؟

156
00:10:15,910 --> 00:10:18,480
ألم يحِن دورك للتحدث الآن؟

157
00:10:19,480 --> 00:10:23,520
.أنت أول من يصعد هذا البرج بمفرده عمليًا

158
00:10:24,080 --> 00:10:26,200
.أخبرني باسمك على الأقل رجاء

159
00:10:26,200 --> 00:10:27,420
.أعتذر

160
00:10:27,820 --> 00:10:32,140
.أنا أوسكار ليث إنكريتوس لوز فرساس

161
00:10:32,140 --> 00:10:33,370
فرساس؟

162
00:10:33,700 --> 00:10:35,310
هل أنت من عائلة فرساس الملكية؟

163
00:10:35,640 --> 00:10:37,780
.أنا وليّ العهد

164
00:10:37,780 --> 00:10:39,540
هل أنت سليل ريغيوس؟

165
00:10:39,540 --> 00:10:40,750
.أنا حفيد حفيده

166
00:10:40,990 --> 00:10:43,050
!ماذا؟

167
00:10:43,050 --> 00:10:45,320
.تشبهه قليلًا

168
00:10:45,630 --> 00:10:46,560
ربّما؟

169
00:10:47,250 --> 00:10:50,890
.كان وجه ريغيوس ألطف رغم ذلك

170
00:10:51,200 --> 00:10:53,360
.آسف لأنّ تعابير وجهي قاسية

171
00:10:57,690 --> 00:10:58,930
.أعتذر

172
00:10:59,250 --> 00:11:02,200
.مع ذلك، أنت أكثر رجولة منه

173
00:11:02,680 --> 00:11:04,500
،كان ريغ بريئًا جدًا

174
00:11:05,230 --> 00:11:07,870
.وكان لشخصيته جانب طفولي

175
00:11:11,650 --> 00:11:14,810
هل تعيشين هنا بمفردك؟

176
00:11:14,810 --> 00:11:16,880
.لديّ تابعة

177
00:11:16,880 --> 00:11:17,620
.ليتولا

178
00:11:19,050 --> 00:11:21,070
.يسرني التعرف عليك

179
00:11:21,070 --> 00:11:22,820
.اسمي ليتولا

180
00:11:23,250 --> 00:11:26,830
.رفيقك نائم جرّاء تعويذتي

181
00:11:27,250 --> 00:11:28,700
.أشكرك على ذلك

182
00:11:30,530 --> 00:11:34,200
ماذا يحدث للمُتحدّين الذين
لم يستطيعوا العودة؟

183
00:11:34,200 --> 00:11:36,820
هل دُفنوا في مقبرة جماعية أم ماذا؟

184
00:11:36,820 --> 00:11:40,370
.لا تُلمّح إلى أنّي أعيش بجوار مقبرة رجاءً

185
00:11:40,810 --> 00:11:45,450
،لا أريد أن ينتهي الأمر بجثث في البرج
.لذا أحرص على ألّا يموت أحد

186
00:11:45,730 --> 00:11:48,810
ضربة واحد من تلك التماثيل
.الحجرية أكثر من كافية للقتل

187
00:11:48,810 --> 00:11:53,000
تُرسَل إلى الطابق الأرضي ما إن توشك
.على تلقّي ضربة قاتلة

188
00:11:53,710 --> 00:11:57,070
من يفشلون تتغير ذكرياتهم قليلًا

189
00:11:57,070 --> 00:11:59,860
.ويُرسَلون إلى أماكن عشوائية من القارّة

190
00:12:00,320 --> 00:12:03,790
معظمهم يفعلون هذا فقط لإثبات
،أنفسهم أو لاكتساب الشهرة

191
00:12:04,240 --> 00:12:07,620
.لذا أعتقد أنّ هذه تكلفة عادلة يدفعونها

192
00:12:08,340 --> 00:12:13,370
لكن بالنسبة للمُتحَدّين الذي يأتون
،لعلاج مرض أطفالهم وما شابه

193
00:12:13,730 --> 00:12:16,180
.سيّدتي كريمة لفعل ذلك حتّى لو فشلوا

194
00:12:16,180 --> 00:12:18,200
!لا داعي لإخباره بهذا

195
00:12:23,340 --> 00:12:24,720
.أنت غامضة بكل تأكيد

196
00:12:25,150 --> 00:12:26,700
.هكذا أحبذّ الأمر

197
00:12:28,000 --> 00:12:29,890
ألا تذهبين إلى المدينة؟

198
00:12:30,310 --> 00:12:33,590
أسمع أنّ الساحرات الأخريات يُظهرن
.أنفسهن للبشر أحيانًا كثيرة

199
00:12:34,080 --> 00:12:37,210
.لا أريد التدخل في حياة البشر كثيرًا

200
00:12:37,610 --> 00:12:41,340
.لا يفترض أن تُستخدَم قواي نزوة

201
00:12:41,840 --> 00:12:43,130
.فهمت

202
00:12:43,540 --> 00:12:47,740
.يا ليت ساحرة الصمت تفكر مثلك

203
00:12:48,540 --> 00:12:52,820
ألهذا علاقة بسبب قدومك إلى هنا؟

204
00:12:53,470 --> 00:12:56,220
.لعنتني ساحرة الصمت

205
00:12:58,450 --> 00:13:02,460
.لن تنجب وريثًا مجددًا

206
00:13:03,170 --> 00:13:05,190
.ينطبق الأمر نفسه على ابنك

207
00:13:07,430 --> 00:13:11,450
.سيُدمّر دمك أيّ رحم يلامسه

208
00:13:12,270 --> 00:13:16,720
.تنتهي سلالة فرساس معك

209
00:13:19,270 --> 00:13:22,240
لِم انتهى بك الأمر بلعنة كهذه؟

210
00:13:22,660 --> 00:13:27,070
،لا يرغب والدي في التحدث عن الأمر
.لذا لم أسأله مباشرة عن السبب

211
00:13:27,550 --> 00:13:31,080
،يبدو أنّ للأمر علاقة بأمّي
.التي توفيت قبل حدوث ذلك مباشرة

212
00:13:31,840 --> 00:13:33,320
.فهمت

213
00:13:33,730 --> 00:13:37,320
،حاولتُ طبعًا إيجاد طريقة لإزالة اللعنة

214
00:13:37,320 --> 00:13:38,660
لكن مهما قرأت

215
00:13:38,660 --> 00:13:41,710
،أو استكشفتُ أطلالًا بدت واعدة

216
00:13:41,710 --> 00:13:44,730
لم أستطع إيجاد دليل واحد
.لتخليص نفسي من هذه اللّعنة

217
00:13:48,490 --> 00:13:49,900
.ولذا أتيتُ إلى هنا

218
00:13:51,660 --> 00:13:53,710
،قبل التحدث أكثر

219
00:13:53,710 --> 00:13:57,040
لا يوجد ما يضمن إزالة
.اللعنة أصلًا

220
00:13:58,410 --> 00:14:03,650
ما نسميه السحر يُنظَّم ويُسيَّر
.باستخدام مجموعة مشتركة من القواعد

221
00:14:03,650 --> 00:14:06,100
.لكن اللعنات لا تتبع أيّ قواعد

222
00:14:06,100 --> 00:14:09,000
عندما تُضفي على كلمات تحكُّمية
،معنىً تُحدده

223
00:14:09,000 --> 00:14:11,290
،بالإضافة إلى قوة سحرية
.تحصل على لعنة

224
00:14:11,730 --> 00:14:14,990
ما يعني طبعًا، أنَّ هذا
.يختلف حسب المٌلقِي

225
00:14:14,990 --> 00:14:16,410
،في أكثر الحالات تطرفًا

226
00:14:16,410 --> 00:14:19,500
إن كان وقت إلغاء اللعنة
،لم يُحدّد أثناء الإلقاء

227
00:14:19,500 --> 00:14:21,120
.ولا حتّى المُلقي يستطيع إلغائها

228
00:14:21,650 --> 00:14:22,700
لا يستطيع إلغائها؟

229
00:14:22,960 --> 00:14:24,110
.لا يستطيع

230
00:14:24,110 --> 00:14:28,840
.لكن بالمقابل، لا تحمل اللّعنات قوّة كبيرة

231
00:14:29,430 --> 00:14:34,620
،تعجز عن قتل الناس بشكل مباشر
.وتستطيع التصرف بطرق ملتوية فقط

232
00:14:34,970 --> 00:14:38,380
.لكن هذه اللعنة تبدو قوية لحدّ ما

233
00:14:38,640 --> 00:14:39,520
.نعم

234
00:14:39,520 --> 00:14:42,640
.يبدو أنَّ لعنتك تتعدى ما وصَفتُه

235
00:14:42,640 --> 00:14:46,040
،لأنّ ما أصابك ليس لعنة

236
00:14:46,040 --> 00:14:48,940
.بل نوعًا مختلفًا يسمى بركة

237
00:14:49,830 --> 00:14:50,530
ماذا؟

238
00:14:52,970 --> 00:14:54,090
ما هذه؟

239
00:14:54,090 --> 00:14:57,930
أظهرتُ جزءًا من البركة
.التي أُلقِيت عليك

240
00:14:58,400 --> 00:15:02,870
في الأساس، تُلقَى البركات
،بشكل مشابه للعنات

241
00:15:02,870 --> 00:15:04,740
.لكنّهما يختلفان في اتجاه القوة

242
00:15:05,340 --> 00:15:08,060
.تُضخّم الطاقة الموجودة بالفعل

243
00:15:08,410 --> 00:15:13,820
لهذا السبب يمكن أن تكون البركات
بغاية القوة حسب براعة المٌلقي

244
00:15:15,000 --> 00:15:18,430
،التي أُلقِيت عليك تهدم الفكرة

245
00:15:18,430 --> 00:15:23,390
وتحاول حماية أيّ طفل
.لم يُولَد بعد بقوة شديدة

246
00:15:23,810 --> 00:15:25,870
.سيكون مستحيلًا على أمّ عادية تحمّلها

247
00:15:26,830 --> 00:15:31,340
،إن أمكن تحليل البركة
فيمكنك استخدام السحر للتخفيف من حدّتها

248
00:15:31,680 --> 00:15:34,650
.لكن ثمة حوالي 20 طبقة متشابكة هنا

249
00:15:36,100 --> 00:15:38,510
.ساحرة الصمت قوة حقًا

250
00:15:38,940 --> 00:15:40,930
.أنا متأسفة

251
00:15:41,450 --> 00:15:44,370
لا يمكنك... إلغاؤها إذًا؟

252
00:15:46,980 --> 00:15:47,970
.أنتِ

253
00:15:48,690 --> 00:15:49,890
...حـ-حسنًا

254
00:15:50,390 --> 00:15:53,560
قطعتَ كلّ هذا الطريق لذا لا يسعني
.تركك ترحل خالي الوفاض

255
00:15:54,280 --> 00:15:56,800
.سأفعل ما بوسعي

256
00:15:56,800 --> 00:15:58,630
هناك طريقة إذًا؟

257
00:15:58,630 --> 00:16:00,590
.هناك إجابة بسيطة

258
00:16:01,690 --> 00:16:06,310
كلّ ما تحتاجه هو إيجاد امرأة
.تستطيع تحمّل قوة الطفل الوقائية

259
00:16:07,020 --> 00:16:09,080
هل تُوجَد امرأة كهذه حقًا؟

260
00:16:09,080 --> 00:16:12,560
.لا بدَّ من وجود واحدة أو اثنتين في القارة

261
00:16:13,050 --> 00:16:16,390
سأبحث عن شخص بناء على
،قوته السحرية ومقاومته السحرية

262
00:16:16,390 --> 00:16:18,280
.لذا أرجو أن تتغاضى عن أيّ جانب آخر

263
00:16:18,280 --> 00:16:21,250
ماذا لو كانت متزوجة، مُسنّة، أو طفلة؟

264
00:16:21,540 --> 00:16:25,270
إن كانت متزوجة فلا يمكنك
،فعل شيء من الناحية الأخلاقية

265
00:16:25,270 --> 00:16:27,330
.لكن لا بأس بمُسنّة مع بعض السحر

266
00:16:27,850 --> 00:16:31,720
إن كان صغيرة، يمكنك أن ترعاها
!حتّى تصبح امرأتك المثالية

267
00:16:31,720 --> 00:16:35,240
الزواج بفجوات تصل لعشرين
.سنة شيء شائع بين الملوك

268
00:16:40,260 --> 00:16:43,480
!على أيّ حال، سأجد شخصًا ما لذا تفاءل

269
00:16:43,480 --> 00:16:44,940
على أيّ حال؟

270
00:16:46,350 --> 00:16:47,680
.أنتِ

271
00:16:52,090 --> 00:16:53,200
.تيناشا

272
00:16:53,200 --> 00:16:54,250
.أخفتني

273
00:16:54,500 --> 00:16:56,110
لِم يخيفك هذا؟

274
00:16:56,110 --> 00:16:59,130
.لا أحد يناديني باسمي عمليًا

275
00:16:59,130 --> 00:17:00,960
.أنتِ من أخبرتني باسمك

276
00:17:00,960 --> 00:17:02,520
.آسفة

277
00:17:02,520 --> 00:17:04,050
إذًا؟ ما الأمر؟

278
00:17:04,050 --> 00:17:04,990
...حسنًا

279
00:17:05,570 --> 00:17:07,010
ماذا عنك؟

280
00:17:08,820 --> 00:17:13,020
هل بوسعك تحمّل قوّة
ساحرة الصمت السحرية؟

281
00:17:13,710 --> 00:17:16,140
.لن أواجه مشكلة في ذلك طبعًا

282
00:17:17,770 --> 00:17:18,420
.مهلًا

283
00:17:18,850 --> 00:17:20,550
.تقرّر الأمر إذًا

284
00:17:22,040 --> 00:17:23,680
.مهلًا لحظة

285
00:17:25,560 --> 00:17:29,220
هذا أضمن من محاولة البحث عن
.امرأة قد لا تكون موجودة أصلًا

286
00:17:29,650 --> 00:17:35,460
لنقل أنّ أمنيتي كبطل هي أن تغادري
.هذا البرج وتُصبحي زوجتي

287
00:17:37,630 --> 00:17:40,980
!لـ-لا أستطيع قبول هذا

288
00:17:40,980 --> 00:17:43,660
ألم تقولي أنَّكِ ستفعلين ما بوسعكِ؟

289
00:17:43,660 --> 00:17:45,360
!هناك حدود لذلك

290
00:17:45,360 --> 00:17:46,610
!محال، لن يحدث ذلك

291
00:17:46,610 --> 00:17:48,810
أيعقل أنّك متزوجة بالفعل؟

292
00:17:49,130 --> 00:17:50,810
.لا أملك سوابق في الزواج

293
00:17:50,810 --> 00:17:52,190
هل لديك خليل؟

294
00:17:52,190 --> 00:17:53,700
!لم يسبق لي تكوين علاقة

295
00:17:53,700 --> 00:17:56,130
ألم تقولي أنَّ مُسنة ستفي بالغرض؟

296
00:17:56,130 --> 00:18:00,510
!قد أكون مسنة لكن مناداتي بذلك تزعجني

297
00:18:00,510 --> 00:18:02,060
!مهلًا، هذا ليس هو المقصد

298
00:18:02,470 --> 00:18:05,920
لا يعقل أن تكون عاقلًا بمحاولة دسّ
!دماء ساحرة في العائلة الملكية

299
00:18:05,920 --> 00:18:08,520
!سيرفض المجلس الملكي الفكرة بشدة

300
00:18:08,520 --> 00:18:10,760
.لن أمانع رؤية ذلك

301
00:18:11,580 --> 00:18:14,540
...لا أدري إن كنتَ تُذكّرني بريغ أم لا

302
00:18:15,000 --> 00:18:17,080
.شخصيتك لا يُستهان بها حقًا

303
00:18:17,080 --> 00:18:18,710
.أميل إلى اللُؤم

304
00:18:20,450 --> 00:18:22,350
.على أيّ حال، لا أستطيع

305
00:18:22,350 --> 00:18:26,910
،لو حققتُ أمنيات كهذه
.لكنتُ جدّة جدّتك الآن

306
00:18:29,220 --> 00:18:31,840
،لربّما تراجع جدّ جدّي

307
00:18:31,840 --> 00:18:35,120
،لكنّني لستُ هو
.لذا لا علاقة لي بالأمر

308
00:18:35,400 --> 00:18:36,900
ماذا تقول؟

309
00:18:36,900 --> 00:18:37,850
!لا هذا ولا ذاك

310
00:18:37,850 --> 00:18:38,790
!لا توجد استثناءات

311
00:18:38,790 --> 00:18:42,210
مضت سبعون سنة وترفضين
القيام بأيّ استثناءات؟

312
00:18:42,210 --> 00:18:44,060
لِم لا تكونين أكثر تكيُّفًا؟

313
00:18:44,060 --> 00:18:46,530
!هناك حدود لعلمك

314
00:18:46,880 --> 00:18:48,690
،إن رفضتَ الاستماع إليّ

315
00:18:48,690 --> 00:18:50,740
!سأغيّر ذكرياتك وأعيدك إلى القلعة

316
00:18:50,740 --> 00:18:53,310
كيف تجرئين على قول كلام كهذا؟

317
00:18:53,310 --> 00:18:55,270
.أنا من عليها قول هذا

318
00:18:55,540 --> 00:18:57,240
.لا تجعليني أقاوم

319
00:18:59,520 --> 00:19:01,450
...السيف الملكي أكاشيا

320
00:19:01,450 --> 00:19:05,490
إنّه السيف الوحيد في العالم
.الذي يتمتع بمقاومة سحرية كاملة

321
00:19:05,980 --> 00:19:08,410
لِم تحمل هذا الشيء؟

322
00:19:08,410 --> 00:19:10,120
أليس كنزًا ملكيًا؟

323
00:19:10,370 --> 00:19:13,330
.يُفضّل استخدام أغراض كهذه بدل تركها

324
00:19:14,830 --> 00:19:18,770
هذا الشيء هو أسوأ أعدائك، صحيح؟

325
00:19:22,880 --> 00:19:25,170
.لنناقش المسألة أكثر

326
00:19:25,170 --> 00:19:26,640
.أتفق معك

327
00:19:26,640 --> 00:19:27,720
.اهدئي

328
00:19:29,230 --> 00:19:32,580
.أنت عنيد لحدّ غير اعتيادي

329
00:19:32,580 --> 00:19:34,510
.استسلم وتنازل

330
00:19:34,850 --> 00:19:36,980
.أعيد نفس الكلام لك

331
00:19:40,690 --> 00:19:46,320
بالمناسبة، سمعتُ أنّك عشتِ في قلعة فرساس
.لفترة من الزمن قبل سبعين سنة

332
00:19:46,320 --> 00:19:48,580
.لمدة نصف سنة تقريبًا فقط

333
00:19:48,580 --> 00:19:51,430
.أدرّس السحر، أرعى الزهور وما إلى ذلك

334
00:19:51,750 --> 00:19:53,470
.استمتعتُ بوقتي هناك

335
00:19:54,590 --> 00:19:57,160
هل كانت تلك أمنية جدّ جدّي؟

336
00:19:57,160 --> 00:19:57,870
.لا

337
00:20:00,930 --> 00:20:02,810
ما رأيك بهذا إذًا؟

338
00:20:04,100 --> 00:20:05,170
.سنة واحدة

339
00:20:05,770 --> 00:20:09,680
غادري هذا المكان لمدّة سنة
.وعيشي معي في فرساس

340
00:20:09,970 --> 00:20:12,890
.هذا هو طلبي كبطل

341
00:20:13,280 --> 00:20:15,120
هل ستقبلينه؟

342
00:20:21,800 --> 00:20:23,050
.فهمت

343
00:20:23,490 --> 00:20:27,970
إذًا سأغادر هذا البرج
.لأكون حامِيتك

344
00:20:29,630 --> 00:20:30,670
.صاحب السمو

345
00:20:31,040 --> 00:20:32,440
.علينا الاستسلام حقًا

346
00:20:32,440 --> 00:20:33,370
.لازار

347
00:20:33,890 --> 00:20:35,840
!لازار! استيقظ يا لازار

348
00:20:37,170 --> 00:20:38,340
!نعم

349
00:20:38,340 --> 00:20:40,180
ماذا؟ صاحب السمو؟

350
00:20:42,400 --> 00:20:43,360
...حلّ الليل بالفعل

351
00:20:43,360 --> 00:20:44,550
.هيّا، لنعد أدراجنا

352
00:20:44,960 --> 00:20:47,250
ألا بأس بالعودة؟

353
00:20:47,250 --> 00:20:49,710
.نعم، انتهيتُ من غرضي هنا

354
00:20:51,580 --> 00:20:54,150
من هذه يا صاحب السمو؟

355
00:20:54,150 --> 00:20:55,650
.إنّها تلميذة الساحرة

356
00:20:55,650 --> 00:20:59,470
ستمكث في القلعة لمساعدتي
.في إزالة اللّعنة

357
00:20:59,470 --> 00:21:00,830
.اسمي تيناشا

358
00:21:01,500 --> 00:21:03,540
!أ-أنا لازار

359
00:21:04,940 --> 00:21:06,880
هل قابلتَ الساحرة أيضًا؟

360
00:21:06,880 --> 00:21:08,400
.نعم، قابلتُها

361
00:21:08,400 --> 00:21:10,200
ألم تلتهمك حيًا؟

362
00:21:12,280 --> 00:21:14,010
.ستُقتَل يا صاح

363
00:21:20,760 --> 00:21:22,790
.حسنًا، كانت مثيرة للاهتمام

364
00:21:25,220 --> 00:21:26,560
.يا صاحب السمو

365
00:21:26,560 --> 00:21:28,040
!انتظرني من فضلك

366
00:21:34,070 --> 00:21:35,380
سحر إذًا؟

367
00:21:35,380 --> 00:21:36,270
.هذا مفيد

368
00:21:36,530 --> 00:21:38,580
.أستطيع استخدام هذا وقتما تشاء

369
00:21:38,580 --> 00:21:41,740
.اسألني إن أردتَ حرق شيء بالكامل

370
00:21:43,470 --> 00:21:44,690
.لن يكون لذلك حاجة

371
00:21:44,690 --> 00:21:46,950
.ما عليك سوى أن تبقي بجانبي

372
00:21:48,890 --> 00:21:49,850
.تيناشا

373
00:21:51,090 --> 00:21:52,930
،إن غيرتِ رأيك مع مرور الوقت

374
00:21:52,930 --> 00:21:54,950
.بوسعك أن تصبحي مقيمة في فرساس

375
00:21:57,820 --> 00:21:59,560
.لن يتغيّر