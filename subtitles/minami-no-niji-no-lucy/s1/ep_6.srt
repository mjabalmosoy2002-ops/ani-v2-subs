1
00:00:00,000 --> 00:00:04,750
مسرح تحف العالم

2
00:01:50,170 --> 00:01:52,280
!جيد! انزلها

3
00:01:58,740 --> 00:02:00,920
!ممتاز! انزلناها

4
00:02:12,300 --> 00:02:15,280
!إنهم يطاردون الكلب

5
00:02:15,320 --> 00:02:18,290
!توقف أيها الوغد-
!توقف أيها الوغد-

6
00:02:19,800 --> 00:02:21,910
.إنه كلب السيد بيتيويل

7
00:02:21,970 --> 00:02:23,730
هل سرق شيئًا ما مُجددًا؟

8
00:02:23,780 --> 00:02:25,470
.لكن أشعر بالأسف عليه

9
00:02:26,110 --> 00:02:27,830
.آسفة لجعلكما تنتظران

10
00:02:27,850 --> 00:02:29,460
.لنذهب الآن

11
00:02:29,500 --> 00:02:30,410
.حسنٌ-

12
00:02:31,440 --> 00:02:33,370
.الطقس جيد اليوم

13
00:02:33,530 --> 00:02:36,910
انطلق والدي وأخي إلى بلدة أديلايد

14
00:02:37,020 --> 00:02:41,810
أنا ولوسي ماي سنمد يد العون
.لوالدتنا في التنظيف وغسل الملابس

15
00:02:52,520 --> 00:02:54,670
!تمهل-
!انتظر، أيها الوغد-

16
00:02:55,540 --> 00:02:56,560
ماذا؟

17
00:02:57,210 --> 00:03:00,140
أنتما تزعجان هابي مُجددًا؟

18
00:03:00,280 --> 00:03:03,100
.إن ذلك الكلب لصٌ يا سيدي

19
00:03:03,190 --> 00:03:04,350
ماذا تقول؟

20
00:03:04,570 --> 00:03:07,430
إنها الحقيقة، لقد سرق
.قطعة لحم مجففة من خيمتنا

21
00:03:09,000 --> 00:03:11,030
!يا له من اتهامٍ سخيف

22
00:03:11,060 --> 00:03:13,300
!هابي بالتأكيد لن يسرق

23
00:03:13,480 --> 00:03:14,840
أليس كذلك يا هابي؟

24
00:03:15,010 --> 00:03:16,510
.نحن على علمٍ بكل شيء

25
00:03:16,570 --> 00:03:17,720
تعلمان ماذا؟

26
00:03:17,920 --> 00:03:20,580
.هذا الكلب قد سرق لحم السيد بوبل سابقًا

27
00:03:20,650 --> 00:03:21,820
ماذا قلت؟

28
00:03:21,840 --> 00:03:22,730
!اه-

29
00:03:22,810 --> 00:03:25,920
،إن لم يكن بحوزتكما دليلا
!فلن أسمح لكما بقول هذا الهراء

30
00:03:27,030 --> 00:03:28,600
!ذلك الكلب لص

31
00:03:28,640 --> 00:03:32,460
!ومالك ذلك الكلب لصٌ كذلك

32
00:03:32,780 --> 00:03:33,860
!أنتما

33
00:03:33,960 --> 00:03:36,340
!أيها الشقيان! ستدفعان ثمن هذا

34
00:03:36,390 --> 00:03:38,190
ماذا حدث يا عزيزي؟

35
00:03:38,210 --> 00:03:40,030
...كما ترين هذان الشقيان

36
00:03:40,200 --> 00:03:42,320
.لا أهتم بما فعلاه

37
00:03:42,400 --> 00:03:45,270
دعك من هذا وتوجه
إلى أديلايد بأسرع ما يمكنك

38
00:03:45,400 --> 00:03:47,250
.لتجد لنا منزلاً مناسبًا

39
00:03:47,320 --> 00:03:50,210
!لم أعد أتحمل البقاء هنا

40
00:03:50,410 --> 00:03:52,100
ولا أنا كذلك

41
00:03:52,130 --> 00:03:55,880
ولكن حتى لو ذهبت إلى
أديلايد فربما لن أجد منزلاً جيدًا

42
00:03:55,910 --> 00:03:58,120
.فآدم قال أنه لم يجد شيئًا هناك

43
00:03:58,170 --> 00:04:01,120
وهل ستثق فيمَّا قاله ذلك الخادم؟

44
00:04:01,220 --> 00:04:03,140
.يجب أن تتأكد بنفسك

45
00:04:03,160 --> 00:04:05,530
حسنٌ، فهمت! كل ما عليّ فعله هو الذهاب، صحيح؟

46
00:04:06,520 --> 00:04:07,610
!سُحقًا لك

47
00:04:10,580 --> 00:04:11,550
!عزيزي

48
00:04:11,640 --> 00:04:14,840
منذ أن وصلنا هنا وأنت لا تفعل شيء سوى السرقة

49
00:04:31,280 --> 00:04:32,670
!شديه أكثر

50
00:04:32,700 --> 00:04:33,880
.اه

51
00:04:33,940 --> 00:04:35,940
!هكذا

52
00:04:37,280 --> 00:04:39,950
!ممتاز! هكذا

53
00:04:43,660 --> 00:04:45,640
ماذا تفعلان هاتان الاثنتان؟

54
00:04:45,760 --> 00:04:48,410
.ستمزقان الملابس إن أحكمتما قبضتكما لهذه الدرجة

55
00:04:52,230 --> 00:04:55,040
صباح الخير سيد باركر

56
00:04:55,120 --> 00:04:56,890
.صباح الخير

57
00:04:56,950 --> 00:05:00,440
توجه زوجكِ إلى أديلايد اليوم، صحيح؟

58
00:05:01,120 --> 00:05:02,110
.نعم

59
00:05:02,180 --> 00:05:05,500
.غادر مبكرًا هذا الصباح لذا على الأرجح قد وصل بحلول الآن

60
00:05:05,520 --> 00:05:08,520
.متأكدٌ من إيجاد مكانٍ مناسب

61
00:05:08,850 --> 00:05:09,910
.أجل

62
00:05:09,940 --> 00:05:12,660
.توجه سيد بيتيول إلى أديلايد كذلك

63
00:05:12,710 --> 00:05:14,260
.رأيته منذ قليل

64
00:05:14,420 --> 00:05:20,470
ألم يقل أنه يود شراء معدات المنزل التي جلبتموها من انجلترا؟

65
00:05:21,250 --> 00:05:24,620
.زوجي أكدّ له أنه لن يقوم ببيعهم

66
00:05:24,930 --> 00:05:29,110
.متأكدٌ أن هناك منازل جميلة للبيع في أديلايد

67
00:05:29,150 --> 00:05:32,880
.سيستغرق بناء إحداهن عدّة أيام

68
00:05:32,960 --> 00:05:36,940
.لهذا كان يحال بإستماتة الحصول على معداتكم

69
00:05:37,720 --> 00:05:40,960
.إن أتيتَ لغسل ملابسك يمكنك وضعهم مع خاصتي

70
00:05:41,050 --> 00:05:43,440
لا داعي لذلك

71
00:05:44,340 --> 00:05:48,070
.فبعد كل تلك السنوات أصبحت أتقن غسل الملابس

72
00:05:48,310 --> 00:05:50,590
ألا تعلمين أني كنتُ أقطن بمفردي لفترة طويلة؟

73
00:05:57,960 --> 00:05:59,730
ماذا تعتقدين بشأن هذا؟

74
00:05:59,770 --> 00:06:00,780
بشأن ماذا؟

75
00:06:00,830 --> 00:06:04,890
لمَ لم أستطع إيجاد ذلك الدب اللطيف ثانيةً؟

76
00:06:05,230 --> 00:06:07,610
لوسي ماي، هل ربما رأيتِ دب الكوالا؟

77
00:06:07,680 --> 00:06:09,530
هاه؟ إذًا فهو يُدعى كوالا؟

78
00:06:09,560 --> 00:06:12,180
.نعم، السكان الأصليون اطلقوا عليه هذا

79
00:06:12,270 --> 00:06:15,380
.يبدو أنه يعيش في استراليا فحسب

80
00:06:15,600 --> 00:06:18,780
،لكن في هذه المنطقة
.يبدو أنه لا يوجد أحد منهم

81
00:06:19,000 --> 00:06:21,760
.رأينا فتًا من السكان الأصليين يربي واحد

82
00:06:21,850 --> 00:06:24,780
.أعتقد أنه يمكنكم إيجاد البعض هنا إذًا

83
00:06:25,770 --> 00:06:28,690
فهمت، يُطلق عليهم الكوالا إذا

84
00:06:36,350 --> 00:06:37,440
.آه

85
00:06:37,480 --> 00:06:39,860
.رباه، سيتوجب علينا تنظيف هذه الملابس مُجددًا

86
00:06:39,950 --> 00:06:41,250
.آسفة

87
00:06:41,550 --> 00:06:44,110
.عودي إلى النهر وأغسليهم مجددًا

88
00:06:44,330 --> 00:06:45,570
...لكن

89
00:06:45,590 --> 00:06:48,760
"ماذا تقصدين بـ "لكن
.اذهبي لغسل الملابس التي أوقعتهم

90
00:06:49,640 --> 00:06:50,610
.كيت

91
00:06:50,780 --> 00:06:52,620
.رافقيها رجاءً

92
00:06:52,670 --> 00:06:55,420
.لن تستطيع لوسي ماي تنظيف الملابس بمفردها جيدًا

93
00:06:55,740 --> 00:06:56,570
وماذا عن هذه؟

94
00:06:56,600 --> 00:06:59,310
.يمكنني حمله بمفردي، اعطيه لي

95
00:07:01,960 --> 00:07:04,410
إنكِ لفتاةٌ ميؤوس منها حقًا، أليس كذلك؟

96
00:07:04,810 --> 00:07:06,270
.لنذهب لغسلهم يا لوسي ماي

97
00:07:06,580 --> 00:07:09,070
!اه! انتظريني يا أختاه

98
00:07:10,910 --> 00:07:12,820
.إنهما لطيفتين

99
00:07:12,850 --> 00:07:14,770
.إنهما طائشتين

100
00:07:23,770 --> 00:07:25,980
.مارش...مارش

101
00:07:30,850 --> 00:07:31,850
.مارش

102
00:07:34,990 --> 00:07:37,880
!مارش! مارش

103
00:07:38,670 --> 00:07:40,110
ما الخطب يا توب؟

104
00:07:41,900 --> 00:07:43,120
.مارش

105
00:07:43,770 --> 00:07:45,450
يجب ألا تزعج مارش

106
00:07:48,700 --> 00:07:50,870
رباه، أين ذهب مارش؟

107
00:07:54,000 --> 00:07:55,410
!مرحبًا بعودتك

108
00:07:55,460 --> 00:07:57,240
هل أعددتِ الحبل لنشر الملابس؟

109
00:07:57,650 --> 00:07:59,090
ماذا حدث لكيت والبقية؟

110
00:08:02,060 --> 00:08:06,110
لوسي ماي! علينا الإسراع
!وغسل تلك الملابس فورًا

111
00:08:06,160 --> 00:08:07,650
.تمهلي قليلاً

112
00:08:08,300 --> 00:08:09,940
.واثقةٌ أني رأيته

113
00:08:09,940 --> 00:08:12,220
.أشك أن هناك معزة هنا حتى

114
00:08:12,350 --> 00:08:13,480
.هيا لنسرع

115
00:08:13,590 --> 00:08:16,520
هل سمعتِ هذا؟

116
00:08:19,650 --> 00:08:21,700
.أنتِ محقة، إنها معزة

117
00:08:22,640 --> 00:08:25,680
لكن لمَ قد تكون في مكانٍ كهذا؟

118
00:09:19,300 --> 00:09:20,310
همم؟

119
00:09:21,290 --> 00:09:22,360
!اه

120
00:09:23,220 --> 00:09:24,620
!أيها الوغد

121
00:09:28,550 --> 00:09:30,730
.الآن عليّ غسلها مجددًا

122
00:09:39,810 --> 00:09:44,130
!لا تفعلي هذا
!سؤذين ساقها على هذا المنوال

123
00:09:44,190 --> 00:09:47,600
.لكن إن لم أفعل، فلن تتحرر من هنا

124
00:09:52,480 --> 00:09:55,120
!كيت! لوسي ماي
هل أنتما هناك؟

125
00:09:55,500 --> 00:09:56,850
!نعم، نحن هنا

126
00:09:56,880 --> 00:09:58,420
ماذا تفعلان؟

127
00:09:58,480 --> 00:10:00,090
!ساعدنا يا سيد باركر

128
00:10:00,300 --> 00:10:01,250
هاه؟

129
00:10:19,830 --> 00:10:21,310
.رباه، إنها معزة

130
00:10:22,480 --> 00:10:24,100
لمَ هي هنا؟

131
00:10:24,200 --> 00:10:26,560
.كانت هنا بالفعل عندما وجدناها

132
00:10:27,060 --> 00:10:30,630
.يبدو أنها مصابة في ساقها

133
00:10:30,880 --> 00:10:35,110
سيد باركر، أرجوك ساعدنا
.لنخرج ساقها من بين جذور الشجرة

134
00:10:35,170 --> 00:10:36,130
.حسنٌ

135
00:10:41,650 --> 00:10:44,370
!سيد باركر! إنها تتألم

136
00:10:44,560 --> 00:10:48,220
أرى، إذًا ماذا سنفعل الآن؟

137
00:10:51,240 --> 00:10:52,640
.وجدتها

138
00:10:55,480 --> 00:10:58,090
.دائمًا ما أضعها في جيبي

139
00:10:58,120 --> 00:10:59,580
.أملك سكينًا

140
00:11:00,140 --> 00:11:01,850
.شكرًا للإلهة

141
00:11:02,420 --> 00:11:04,530
!لا يمكنك ذلك يا سيد بارك

142
00:11:04,850 --> 00:11:06,110
ولمَ لا؟

143
00:11:06,360 --> 00:11:08,690
ستقطع ساقها، صحيح؟

144
00:11:08,740 --> 00:11:09,720
هاه؟

145
00:11:10,010 --> 00:11:11,010
.اه

146
00:11:13,040 --> 00:11:15,700
.لا، سأحاول قطع الجذور

147
00:11:15,780 --> 00:11:17,610
...سيستغرق هذا وقتًا، لكن

148
00:11:18,140 --> 00:11:20,420
.يمكنني قطع جذور غليظةٍ كتلك حتى

149
00:11:21,780 --> 00:11:23,200
.لنبدأ

150
00:12:12,800 --> 00:12:14,020
.صباح الخير

151
00:12:14,590 --> 00:12:16,130
.هاه؟ اه

152
00:12:18,180 --> 00:12:20,570
هل أديلايد بعيدةٌ عن هنا؟

153
00:12:21,180 --> 00:12:22,900
.هذه أديلايد

154
00:12:22,930 --> 00:12:23,870
هاه؟

155
00:12:26,510 --> 00:12:28,480
.لا يوجد منزل واحد على مرمى البصر

156
00:12:28,650 --> 00:12:30,200
.هذه هي أديلايد

157
00:12:30,480 --> 00:12:34,930
هذه هي الحديقة التي تحيط
.بالبلدة الآن وفي المستقبل كذلك

158
00:12:35,070 --> 00:12:38,180
لقد رسم العقيد لايت حدود المدينة

159
00:12:38,560 --> 00:12:40,370
حديقة تحيط بالمدينة؟

160
00:12:40,440 --> 00:12:41,430
.نعم

161
00:12:42,350 --> 00:12:45,610
ولكن المدينة الآن تبدو وكأنها حديقة

162
00:12:45,920 --> 00:12:48,900
.ليس هناك الكثير من البشر أو المنازل على حدٍ سواء

163
00:12:50,070 --> 00:12:52,430
ألم تتعدوا الثلاثمائة نسمة؟

164
00:12:52,480 --> 00:12:53,710
.هذا صحيح

165
00:12:53,920 --> 00:12:56,400
.رغم ذلك، لم يشيدوا شيئًا سوى الطرق

166
00:12:56,430 --> 00:13:00,470
.فقط الطرق المؤدية من الشمال للجنوب، ومن الشرق إلى الغرب

167
00:13:00,580 --> 00:13:02,230
إذًا الطرق هي الشيء الوحيد الذي شُيد؟

168
00:13:02,410 --> 00:13:05,460
بالحديث عن الأمر إلى أين تتوجهان؟

169
00:13:13,940 --> 00:13:16,090
.هذا مكتب العقيد لايت إذًا

170
00:13:16,340 --> 00:13:17,370
.هذا صحيح

171
00:13:18,290 --> 00:13:21,100
هل علينا إنهاء أعمالنا هنا أولاً

172
00:13:21,290 --> 00:13:24,160
أم نبتاع حاجياتنا أولاً يا والدي؟

173
00:13:29,640 --> 00:13:32,210
.يبدو أننا سنستغرق بعض الوقت هنا

174
00:13:33,880 --> 00:13:36,090
إذًا هلّا ذهبنا لإيجاد عربة أولاً؟

175
00:13:36,110 --> 00:13:37,130
.أنت مُحق يا بن

176
00:13:37,160 --> 00:13:40,490
.ولكنها ليست أي عربة، إنها عربة يجرها ثور أمدها لنا السيد جامبلنج

177
00:13:43,140 --> 00:13:45,390
هذا لأن الثور أقوى من الحصان، صحيح؟

178
00:13:46,470 --> 00:13:49,080
نعم، لكن حتى لو وجدنا عربة

179
00:13:49,160 --> 00:13:51,610
ما فائدتها إن لم تكن هنا أحصنة كافية

180
00:13:52,090 --> 00:13:56,010
والدي، بما أن السيد جامبلنج أهدانا العربة

181
00:13:56,050 --> 00:13:57,690
يمكننا استعمالها لاحقًا

182
00:13:58,250 --> 00:13:59,880
لنجد قطعة أرض مناسبة أولاً

183
00:14:00,290 --> 00:14:02,560
.أنت محق تمامًا في ذلك

184
00:14:17,270 --> 00:14:18,970
.هذه ستفي بالغرض

185
00:14:19,000 --> 00:14:21,000
.شكرًا جزيلاً يا سيد باركر

186
00:14:21,040 --> 00:14:23,370
أأنت واثق أنك لا تحتاج هذا القميص؟

187
00:14:23,490 --> 00:14:25,600
.نعم، كان قديمًا

188
00:14:25,660 --> 00:14:28,350
على أي حال، أتنويان أخذ هذه الماعز للمنزل؟

189
00:14:28,380 --> 00:14:31,450
بما أني وجدتها يمكنني الاحتفاظ بها، صحيح؟

190
00:14:31,790 --> 00:14:34,660
نعم، لكن هذا إذا لم يظهر لها مالك

191
00:14:34,740 --> 00:14:36,500
.واثقٌ بأنها ضلت طريقها

192
00:14:36,540 --> 00:14:38,790
هذا يعني أن مالكها يبحث عنها، صحيح؟

193
00:14:38,820 --> 00:14:39,880
.على الأرجح

194
00:14:39,920 --> 00:14:43,370
.إن ظهر مالكها فسأعيدها، حتى ذلك الحين سأعتني بها

195
00:14:44,340 --> 00:14:45,520
هممم؟

196
00:14:48,080 --> 00:14:49,210
.رباه

197
00:14:49,470 --> 00:14:51,320
ما الخطب سيد باركر؟

198
00:14:52,450 --> 00:14:53,630
هممم

199
00:14:55,850 --> 00:15:00,440
!يا إلهي،إنها تحمل ماعز صغيرة بداخلها

200
00:15:00,590 --> 00:15:02,100
هاه؟ حقًا؟

201
00:15:02,280 --> 00:15:04,660
متى ستضع مولودها يا سيد باركر؟

202
00:15:04,740 --> 00:15:07,250
حسنٌ... لستُ متيقنًا

203
00:15:07,280 --> 00:15:11,000
هذا رائع، أسرع وأخرج لنا قريبًا، حسنًا؟

204
00:15:11,060 --> 00:15:12,280
.لوسي ماي

205
00:15:12,410 --> 00:15:15,670
أتدركين أنها ليست معزكِ بعد؟

206
00:15:15,720 --> 00:15:18,110
أيمكنكِ السير؟ أخبريني، أيمكنكِ السير؟

207
00:15:18,160 --> 00:15:22,960
.هل أنتِ بخير؟ لنمشي ببطء هكذا، خطوة بخطوة

208
00:15:22,990 --> 00:15:25,280
لنعد للمنزل

209
00:15:37,990 --> 00:15:42,100
كيف ستبدو أديلايد في المستقبل؟ هذه هي رؤيتنا الأولية لها

210
00:15:43,420 --> 00:15:46,770
أنت لا تنوي تشييد مدينة كالتي في هذا المخطط، صحيح؟

211
00:15:47,090 --> 00:15:51,590
.أمر العقيد بالالتزام بهذا المخطط

212
00:15:52,300 --> 00:15:55,210
.فنحن بدأنا بتشييد الطرق بُناءً عليه

213
00:15:55,320 --> 00:15:56,630
.فهمت

214
00:15:57,060 --> 00:15:59,740
.على أي حال، كنتُ أخطط لبناء مزرعة هنا

215
00:15:59,790 --> 00:16:01,980
.لهذا قدمنا إلى جنوب أستراليا

216
00:16:02,470 --> 00:16:05,290
أهناك أي مخطط كهذا للأراضي الزراعية؟

217
00:16:05,690 --> 00:16:09,900
في الحقيقة، نحن لم نعاين المساحات الزراعية بعد

218
00:16:10,460 --> 00:16:11,530
ماذا تقصد؟

219
00:16:11,970 --> 00:16:13,380
...حسنٌ... ما أحاول قوله

220
00:16:13,440 --> 00:16:18,700
.أن الأمر سيستغرق بعض الوقت قبل أن تتمكن من تملك أرض زراعية

221
00:16:19,470 --> 00:16:20,990
كم سيستغرق الأمر بالتحديد؟

222
00:16:21,140 --> 00:16:22,780
...حسنٌ... لا يمكنني معرفة ذلك

223
00:16:22,890 --> 00:16:27,490
فبعد كل شيء معاينة الأراضي الزراعية
يجري ببطء وعدد المتقدمين للوظيفة كبير

224
00:16:28,080 --> 00:16:30,070
إلى متى سيتوجب عليّ الانتظار؟

225
00:16:30,200 --> 00:16:32,240
.عام أو اثنين

226
00:16:32,270 --> 00:16:33,530
ماذا قلت؟

227
00:16:33,600 --> 00:16:36,920
...على أي حال، لا يمكنني التأكد من هذا

228
00:16:36,940 --> 00:16:39,030
إذًا من يستطيع التقين من ذلك؟

229
00:16:39,060 --> 00:16:41,390
.حسنٌ... لا أعتقد أن هناك من يمكنه ذلك

230
00:16:41,570 --> 00:16:44,190
حتى العقيد لايت؟

231
00:16:44,310 --> 00:16:48,060
.العقيد لايت حاليًا في... مهمة استقصائية في الجزء الشمالي

232
00:16:48,180 --> 00:16:50,520
...لكن حتى لو سألته

233
00:16:50,630 --> 00:16:54,010
.لن يعطيك رد موثوق كذلك

234
00:16:54,060 --> 00:16:56,160
!هذا ليس بقريبٍ مما وُعِدنا به حتى

235
00:16:56,470 --> 00:16:59,470
...لقد قطعت كل هذا الطريق إلى جنوب أستراليا

236
00:16:59,620 --> 00:17:03,280
لأني أردت بناء مزرعة جميلة في
.أراضيكم الخضراء لأنكم تملكون الكثير منها

237
00:17:03,350 --> 00:17:06,370
أخبرتمونا أننا سنحصل عليها فور وصولنا

238
00:17:06,680 --> 00:17:11,100
سيدي أرجوك تفهم أنه لا يمكنك الحصول على أرض لم تتم معاينتها بعد

239
00:17:11,210 --> 00:17:13,710
.حاليًا ليس باليد حيلة سوى الانتظار

240
00:17:13,980 --> 00:17:16,510
إذًا ماذا تريد مني أن أفعل؟

241
00:17:16,780 --> 00:17:18,780
.لطالما كنتُ فلاحًا

242
00:17:18,990 --> 00:17:21,110
.لا يمكنني تخيل أني قد أعمل في مجال آخر

243
00:17:21,280 --> 00:17:24,580
.حاليًا يتم تشييد طرق المدينة

244
00:17:24,690 --> 00:17:27,910
.وفي الجبال الشرقية يتم تقطيع الأشجار

245
00:17:28,150 --> 00:17:31,490
والحرفيون الذين يبنون المنازل يحتاجون مساعدة

246
00:17:31,590 --> 00:17:33,980
.ما أعنيه، لدينا عدّة وظائف شاغرة

247
00:17:36,040 --> 00:17:39,230
.ليس أنت فحسب، هناك العديد في مثل وضعك هذا

248
00:17:43,150 --> 00:17:46,520
.في هذه الحالة، أريد قطعة أرض في المدينة

249
00:17:46,960 --> 00:17:48,910
أتخطط لبناء منزل؟

250
00:17:49,540 --> 00:17:54,180
لقد جلبنا منزلاً جاهزًا من إنجلترا، رغم أنه ما زال على السفينة

251
00:17:54,230 --> 00:17:56,330
وكيف تخطط لإحضاره هنا؟

252
00:17:56,510 --> 00:17:57,770
.بعربةٍ يجرها ثور

253
00:17:57,980 --> 00:18:01,650
.ستحضره على عدّة جولات، قد يستغرق الأمر شهرًا

254
00:18:01,850 --> 00:18:03,600
إلى ذلك الحين أتنوي البقاء في الخيمة؟

255
00:18:04,860 --> 00:18:08,300
.لا، لم أتوقع قط أنه قد ينتهي بي الحال هكذا

256
00:18:09,360 --> 00:18:12,390
ماذا إن عرضتُ عليك شراء قطعة أرض بالمنزل؟

257
00:18:15,260 --> 00:18:17,590
...في الحقيقة خطر على بالي واحد بالفعل

258
00:18:18,280 --> 00:18:19,590
قطعة أرض تكفي

259
00:18:23,250 --> 00:18:25,760
.لكننا لا نملك منازل كثيرة

260
00:18:25,870 --> 00:18:28,840
فالحرفيون لا يمكنهم مواكبة النمو السكاني الرهيب

261
00:18:29,090 --> 00:18:31,120
.بالنسبة لي سأكتفي بقطعة أرض

262
00:18:40,780 --> 00:18:42,580
إنه منزل صغير حقًا، صحيح؟

263
00:18:42,920 --> 00:18:45,150
.لا يمكنني مناداة هذا بالمنزل

264
00:18:45,970 --> 00:18:48,180
لكن نستطيع بناء منزلنا هنا، أليس كذلك؟

265
00:18:48,520 --> 00:18:50,080
.نعم

266
00:18:50,220 --> 00:18:52,220
يمكننا استخدام هذا للتخزين

267
00:18:59,360 --> 00:19:01,570
هل أقابل أخيرًا جيراني الجدد؟

268
00:19:01,760 --> 00:19:03,780
.لا، لم نقرر بعد

269
00:19:04,220 --> 00:19:06,370
.أدعى جين ماك، سررتُ بلقائك

270
00:19:06,670 --> 00:19:07,390
.نعم

271
00:19:07,940 --> 00:19:10,500
لا بد أن أخي أخبرك عن هذا المنزل، صحيح؟

272
00:19:10,580 --> 00:19:11,460
ماذا؟

273
00:19:11,550 --> 00:19:14,280
إنه يعمل في مكتب العقيد لايت

274
00:19:14,450 --> 00:19:16,780
.وزوجي حاليًا رفقة العقيد لايت

275
00:19:16,830 --> 00:19:19,010
...هذا يعني أن الرجل الذي قابلناه سابقًا

276
00:19:19,960 --> 00:19:22,150
.نعم، واثقةٌ أنه أخي بيرنارد

277
00:19:22,850 --> 00:19:26,110
.أنا آرثر بوبلي، وهذا ابني بن

278
00:19:26,660 --> 00:19:30,020
.جئتُ لرؤية المنزل لإرضاء فضولي

279
00:19:30,170 --> 00:19:31,530
،لطالما أخبرت أخي

280
00:19:31,650 --> 00:19:35,840
"إن دعوت أحدهم ليصبح جارنا، تأكد من أنه شخص صالح أولاً"

281
00:19:36,380 --> 00:19:39,510
.حسنٌ، سنلقي نظرة في الداخل

282
00:19:46,940 --> 00:19:48,200
مستحيل

283
00:19:48,250 --> 00:19:50,850
ماذا عن العقد الذي وقعته مع سيد جامبلنج؟

284
00:19:51,290 --> 00:19:54,830
سيد جامبلنج آذى ساقه ولا يمكنه الحركة الآن، صحيح؟

285
00:19:55,170 --> 00:19:56,510
كيف عرفت هذا؟

286
00:19:56,960 --> 00:19:58,570
.أحدهم أخبرني

287
00:19:58,660 --> 00:20:03,180
.لذا أُلغي هذا العقد، وأعطيت العربة للسيد بيتويل

288
00:20:03,280 --> 00:20:04,650
هل قلت السيد بيتويل؟

289
00:20:04,670 --> 00:20:05,950
تبًا! لقد قلت ذلك

290
00:20:06,580 --> 00:20:08,590
.حسنٌ... كنت ستعرف في نهاية المطاف

291
00:20:08,950 --> 00:20:09,950
.هذا صحيح

292
00:20:10,010 --> 00:20:12,180
ذلك الثور القوي

293
00:20:12,240 --> 00:20:15,690
.سيعمل في خدمة السيد بيتويل بدءًا من بعد غد

294
00:20:16,170 --> 00:20:18,270
أشعر بالأسف لأجلك حقًا

295
00:20:18,760 --> 00:20:20,560
هل هناك أي ثيران أخرى في الجوار؟

296
00:20:20,590 --> 00:20:21,450
...حسنٌ

297
00:20:21,480 --> 00:20:24,480
.واثق أن الجميع قد وجدوا مستأجرين لثيرانهم

298
00:20:24,530 --> 00:20:26,450
.لا أعتقد أن البعض متوفر

299
00:20:26,790 --> 00:20:28,750
إذا أتقول أني لن أجد أحد؟

300
00:20:28,880 --> 00:20:30,100
...أعتقد ذلك

301
00:20:30,240 --> 00:20:34,190
.لكني أتيتُ لأني واثق أن السيد جامبلنج قد أوقع عقدًا

302
00:20:34,440 --> 00:20:37,390
هذا مجددًا؟

303
00:20:37,440 --> 00:20:39,890
لقد أوقعتً عقدًا مع السيد بيتويل

304
00:20:39,960 --> 00:20:41,500
!كما أنه قد دفع سلفًا

305
00:20:42,000 --> 00:20:43,360
ماذا قلت؟

306
00:20:46,380 --> 00:20:48,540
هل فشلت المفاوضات؟

307
00:20:49,050 --> 00:20:52,100
.انتهت المفاوضات بالفعل يا سيد بيتويل

308
00:20:52,180 --> 00:20:53,870
.هذا جيد إذا

309
00:20:53,900 --> 00:20:56,540
تعال يا فتى ولنشرب أكثر

310
00:20:56,660 --> 00:20:58,410
!شكرًا جزيلاً على عرضك

311
00:20:59,150 --> 00:21:00,750
.سمعتَ ما قلته

312
00:21:03,310 --> 00:21:05,410
.إن سيد بيتويل شخص سيئ حقًا

313
00:21:06,710 --> 00:21:08,480
.على أي حال، لنبحث في مكان آخر

314
00:21:08,760 --> 00:21:12,970
.بعد غد، سنحتاج حيوانا ينقل أغراضنا سواء ثور أو حصان

315
00:21:15,470 --> 00:21:16,720
!أنت

316
00:21:17,000 --> 00:21:20,210
تذكرتُ لتوي أن هناك عربة يد شاغرة، ماذا عنها؟

317
00:21:23,480 --> 00:21:27,160
.سحقًا، هذا ما تجده عندما تحاول أن تتصرف بلطف

318
00:22:15,960 --> 00:22:17,290
.وضعت توب في السرير

319
00:22:17,380 --> 00:22:18,660
.شكرًا لكِ

320
00:22:19,070 --> 00:22:21,780
ماذا تعتقدين أنه قد حدث لوالدي وبين؟

321
00:22:21,900 --> 00:22:23,910
.إنهما متأخران قليلاً ليس إلا

322
00:22:24,590 --> 00:22:28,160
أتعتقدين أنهما سيتمكننان من العبور عبر الغابة في الظلام؟

323
00:22:30,370 --> 00:22:33,130
ماذا سأسميكِ؟

324
00:22:33,200 --> 00:22:37,550
.لم يبحث عنكِ أحدهم، لذا أعتقد أنكِ أصبحتِ ملكي

325
00:22:37,780 --> 00:22:39,230
.لوسي ماي

326
00:22:39,650 --> 00:22:40,790
ماذا؟

327
00:22:41,350 --> 00:22:43,230
أنكِ مرتاحة البال حقًا

328
00:22:43,560 --> 00:22:46,530
!جميعنًا قلقون على والدي

329
00:22:46,590 --> 00:22:48,570
.لكنكِ منشغلة بهذه الماعز

330
00:22:48,660 --> 00:22:50,900
!أنا قلقةٌ أيضًا

331
00:22:50,580 --> 00:22:51,270
.لا، لستِ كذلك-

332
00:22:51,570 --> 00:22:55,360
!أنا أتحدث إليها فقط لأني قلقة على والدي وأحاول تشتيت نفسي

333
00:22:55,430 --> 00:22:56,200
!كاذبة

334
00:22:56,670 --> 00:22:58,290
!أختي أنتِ حمقاء

335
00:22:58,370 --> 00:22:59,720
لمَ نعتيني بالحمقاء؟

336
00:22:59,750 --> 00:23:01,760
!نعتكِ بالحمقاء لأنكِ كذلك

337
00:23:01,780 --> 00:23:02,830
ماذا قلتِ؟

338
00:23:03,080 --> 00:23:04,710
!هذا يكفي يا فتيات

339
00:23:04,980 --> 00:23:06,090
!همم

340
00:23:20,890 --> 00:23:23,060
السفينة التي أحضرتنا هنا

341
00:23:23,150 --> 00:23:25,230
.ستعود إلى إنجلترا بعد غد

342
00:23:25,250 --> 00:23:28,050
.بعد غد؟ إنهم ينطلقون أبكر ممّا خُطط له

343
00:23:28,410 --> 00:23:30,080
.هذا ما أخبرني إياه جون

344
00:23:30,210 --> 00:23:33,580
.غدًا يجب أن نفرغ ما تبقى من أمتعتنا

345
00:23:33,700 --> 00:23:34,880
.أنتِ محقة

346
00:23:36,740 --> 00:23:38,560
ماذا حدث لوالدكِ؟

347
00:23:38,650 --> 00:23:39,620
.أتساءل

348
00:23:40,900 --> 00:23:45,330
.لقد حلّ الليل ولم يعد والدي أو أخي بعد

349
00:23:45,890 --> 00:23:49,780
.ظللنا ننتظر صامتين لوقتٍ بدا أنه لن ينتهي

350
00:23:55,620 --> 00:23:58,140
.أتساءل ماذا حدث لأبي

351
00:24:03,780 --> 00:24:06,980
.لم يعد أبي أو أخي رغم أن الوقت قد تأخر

352
00:24:07,060 --> 00:24:10,160
أيمكن أنها قد سلكا طريقًا خاطئًا وأضاعا طريقهما؟

353
00:24:10,360 --> 00:24:13,770
:الحلقة القادمة من لوسي قد تكون من قوس قزح الجنوبي
."حظ بين السيئ"

354
00:24:13,790 --> 00:24:14,980
!احرصوا على مشاهدتها