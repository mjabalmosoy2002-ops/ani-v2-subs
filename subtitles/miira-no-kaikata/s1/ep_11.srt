1
00:00:00,520 --> 00:00:01,280
.انظر

2
00:00:02,160 --> 00:00:04,730
.إنّها دعوة لمهرجان إله الأرض

3
00:00:05,070 --> 00:00:07,460
.إنّه يحدث مرّة في السّنة

4
00:00:07,460 --> 00:00:09,730
.لقد أعطاني إيّاها يامادا-سان الأوني

5
00:00:10,230 --> 00:00:13,400
.لقد كنتَ محبطًا مذ أن آذيتَ ذراعك

6
00:00:13,400 --> 00:00:13,960
...عليك

7
00:00:13,960 --> 00:00:15,110
.لن أذهب

8
00:00:15,920 --> 00:00:17,240
.لا أريد الذّهاب

9
00:00:17,760 --> 00:00:18,730
...تازكي

10
00:01:51,450 --> 00:01:53,590
أنتما تصدّقانني يا رفيقيّ، صحيح؟

11
00:01:57,270 --> 00:01:58,840
.إنّه مجرّد كلب

12
00:01:59,540 --> 00:02:02,190
!ذلك ما قاله تاناكا أيضًا

13
00:02:02,190 --> 00:02:04,210
.حسنًا، إنّه كلب عاديّ

14
00:02:04,210 --> 00:02:05,380
!ليس كذلك

15
00:02:05,380 --> 00:02:07,730
!لقد اختفى بعد أن التقطت هذه الصّورة أيضًا

16
00:02:08,620 --> 00:02:11,270
لقد طفا في الهواء واختفى كالدّخان، صحيح؟

17
00:02:11,270 --> 00:02:11,860
!نعم

18
00:02:12,230 --> 00:02:14,000
.لا بدّ أنّك تتخيّل الأمر

19
00:02:14,000 --> 00:02:15,010
.أو تحلم

20
00:02:15,010 --> 00:02:17,110
!كان مصابًا وينزف

21
00:02:17,990 --> 00:02:22,140
.أراهن أنّها الرّوح المضطربة لكلب صدمته سيّارة

22
00:02:22,140 --> 00:02:22,930
!هذا مخيف

23
00:02:22,930 --> 00:02:25,370
!باتشياما مخيف

24
00:02:25,370 --> 00:02:26,660
باتشياما؟

25
00:02:26,660 --> 00:02:29,250
.إنّه جبل صغير بالقرب من منزلنا

26
00:02:29,250 --> 00:02:32,590
.يقولون أنّ أيّ أحد يدخله، يُلعن

27
00:02:32,590 --> 00:02:34,500
.لقد وجدتُه هناك

28
00:02:36,080 --> 00:02:37,810
!أنتما لستما مهتمّين على الإطلاق؟

29
00:02:38,750 --> 00:02:40,440
ما الّذي تقرأه يا تاناكا؟

30
00:02:40,440 --> 00:02:41,510
.قاموس كانجي

31
00:02:45,310 --> 00:02:47,520
ماذا؟ إينوغامي؟

32
00:02:47,730 --> 00:02:49,520
.إنّه يبدو ككلب عاديّ

33
00:02:49,890 --> 00:02:51,710
.أعتقد أنّه ما زال جروًا

34
00:02:52,260 --> 00:02:56,090
.يمكن للبالغة منها أن تأخذ هيئة البشر والتّحدّث

35
00:02:56,090 --> 00:02:58,070
.قال أنّه كان مصابًا

36
00:02:58,070 --> 00:03:02,030
.لا بدّ أنّ هنالك من طارده إلى باتشياما

37
00:03:03,670 --> 00:03:06,070
أتريدون الذّهاب للبحث عنه؟

38
00:03:07,230 --> 00:03:09,660
.أشعر أنّ علينا القيام بشيء ما

39
00:03:10,910 --> 00:03:12,080
.معك حقّ

40
00:03:12,080 --> 00:03:12,900
.لنذهب

41
00:03:14,930 --> 00:03:16,420
فعلاً يا تاتشان؟

42
00:03:16,620 --> 00:03:18,430
.الوقت متأخّر كثيرًا على الذّهاب اليوم

43
00:03:18,430 --> 00:03:19,840
ماذا عن الغد؟

44
00:03:19,840 --> 00:03:23,430
يجب علينا التّحدّث مع الإلهة إن كنّا
.سنذهب بعد المدرسة

45
00:03:23,430 --> 00:03:24,290
.نعم

46
00:03:26,840 --> 00:03:28,180
.هذه مفاجأة

47
00:03:29,450 --> 00:03:31,810
.أخبرتك أن تدعه وشأنه
ألا تفهم؟

48
00:03:38,360 --> 00:03:41,390
كانت معجزة أنّه ذهب للبحث
.عن كوني من الأساس

49
00:03:41,810 --> 00:03:43,830
.ظننتُ أنّه سيعارض

50
00:03:56,890 --> 00:03:58,120
.سوراينو

51
00:03:58,660 --> 00:04:01,650
.لقد نسيت، لا أستطيع النّوم بعد

52
00:04:01,650 --> 00:04:03,600
.ليس عليّ النّوم

53
00:04:03,600 --> 00:04:05,340
ماذا؟ لماذا؟

54
00:04:05,690 --> 00:04:08,760
.هنالك مسلسل دراميّ أردتُ رؤيته اللّيلة

55
00:04:11,750 --> 00:04:13,390
أهذه هي القناة؟

56
00:04:13,390 --> 00:04:14,260
.نعم

57
00:04:16,420 --> 00:04:19,050
.يمكنك العودة للنّوم يا سوراينو

58
00:04:19,050 --> 00:04:20,230
.سأشاهده أيضًا

59
00:04:20,230 --> 00:04:22,010
.لم أستطع النّوم على أيّ حال

60
00:04:22,010 --> 00:04:22,990
...سوراينو

61
00:04:23,610 --> 00:04:27,240
كما أنّه لا يمكنك استعمال جهاز
التّحكّم بنفسك، صحيح يا آيان؟

62
00:04:27,240 --> 00:04:28,490
!بالفعل

63
00:04:38,250 --> 00:04:40,450
ما خطب مي؟

64
00:04:40,450 --> 00:04:43,010
.إنّه لا يريد البقاء هنا بشدّة

65
00:04:43,430 --> 00:04:45,130
ما حدث أنّه البارحة

66
00:04:45,570 --> 00:04:49,470
استيقظ بعد أن شاهد كابوسًا
.ولم يجدني أمامه

67
00:04:53,930 --> 00:04:56,840
.إنّه هكذا طوال اليوم

68
00:04:56,840 --> 00:04:58,900
.إنّه يتصرّف كالأطفال

69
00:05:02,280 --> 00:05:07,910
،لن يكون من الجيّد إجباره على البقاء
.وقد غادر للّحاق بسورا

70
00:05:08,390 --> 00:05:10,830
أتريد البقاء معي اليوم يا مي-كُن؟

71
00:05:20,610 --> 00:05:22,020
ما كانت تلك القصاصة؟

72
00:05:22,020 --> 00:05:23,200
.لقد اختفت

73
00:05:23,200 --> 00:05:24,720
.لا داعي للخوف

74
00:05:24,720 --> 00:05:26,550
.إنّها مثل علامة

75
00:05:28,720 --> 00:05:30,810
.شكرًا أيّتها الإلهة

76
00:05:34,230 --> 00:05:35,230
،أخبرني يا تازكي

77
00:05:35,730 --> 00:05:39,430
ستبدأ عطلة الصّيف بعد بحثنا اليوم، صحيح؟

78
00:05:39,430 --> 00:05:41,160
.لنخرج للتّنزّه جميعًا

79
00:05:41,160 --> 00:05:41,980
.حسنًا

80
00:05:41,980 --> 00:05:43,290
.أجل

81
00:05:43,290 --> 00:05:45,490
.سأطلب من الآخرين الخروج أيضًا إذًا

82
00:05:45,920 --> 00:05:47,820
أليس هذا رائعًا يا مي-كُن؟

83
00:05:47,820 --> 00:05:49,990
.أتمنّى أن تكون كلّ مواعيدنا متوافقة

84
00:05:50,400 --> 00:05:52,830
ربّما لن نكون قادرين على الذّهاب
.لأيّ مكان معًا بعد التّخرّج

85
00:05:55,240 --> 00:05:59,320
هل تحاول القول أنّنا لن نلتقي بك بعد الآن؟

86
00:06:08,800 --> 00:06:10,000
.أمزح فحسب

87
00:06:11,190 --> 00:06:13,080
.لننظّف أنفسنا ونذهب للمنزل

88
00:06:13,520 --> 00:06:15,180
سوف نذهب للجبل، صحيح؟

89
00:06:15,940 --> 00:06:16,740
.نعم

90
00:06:22,070 --> 00:06:24,310
.المكان جميل هنا

91
00:06:24,310 --> 00:06:26,850
.يبدو لي كأيّ جبل آخر

92
00:06:26,850 --> 00:06:34,410
ربّما تنشر الكائنات الغريبة
.إشاعات لإبعاد النّاس

93
00:06:34,810 --> 00:06:36,830
ماذا؟ من أجل ماذا؟

94
00:06:36,830 --> 00:06:39,420
.لحماية المكان الّذي تسكنه

95
00:06:39,960 --> 00:06:43,670
تعرف أنّ النّاس يتجنّبون أماكن
تُروى قصص عنها، صحيح؟

96
00:06:44,300 --> 00:06:46,260
.يريد الجميع أن يعيشوا بهناء

97
00:06:48,610 --> 00:06:50,180
.إنّه طريق متفرّع

98
00:06:54,390 --> 00:06:56,010
أتريدون الانفصال؟

99
00:06:56,010 --> 00:06:57,500
.لنختر وقتًا نلتقي فيه ثانية

100
00:06:57,500 --> 00:06:58,570
.فكرة جيّدة

101
00:06:59,270 --> 00:07:02,160
.صحيح، إنه يوم الانقلاب الصّيفيّ

102
00:07:02,760 --> 00:07:03,940
.نعم، صحيح

103
00:07:04,790 --> 00:07:07,360
...الانقلاب الصّيفيّ

104
00:07:07,360 --> 00:07:09,190
.أشعر أنّ هنالك أمرًا ما يخصّ هذا اليوم

105
00:07:13,610 --> 00:07:15,080
ماذا كان يا ترى؟

106
00:07:15,450 --> 00:07:17,240
!أتسمعني؟

107
00:07:17,240 --> 00:07:19,290
!إينوغامي-سان

108
00:07:19,290 --> 00:07:21,220
!إينوغامي

109
00:07:21,220 --> 00:07:22,960
!أتسمعني؟

110
00:07:24,950 --> 00:07:27,080
.المكان هادئ في هذا الجبل

111
00:07:28,250 --> 00:07:30,090
.لا يمكن سماع حتّى الصّدى

112
00:07:32,240 --> 00:07:33,700
...هذا غريب

113
00:07:33,700 --> 00:07:36,350
،لا أرى أيّ واحد من الكائنات
.ناهيك عن الإينوغامي

114
00:07:40,920 --> 00:07:44,860
أخبرني يا سورا-كُن، هل حدث
شيء ما بينك وبين كامي-كُن؟

115
00:07:48,250 --> 00:07:51,200
.أنتما لم تتحدّثا على الإطلاق قبل قليل

116
00:07:52,990 --> 00:07:55,430
.قال كلانا أشياء لم يكن علينا قولها

117
00:07:55,770 --> 00:07:57,870
.نشعر أنّنا قد اقترفنا خطأ ما لا غير

118
00:08:00,190 --> 00:08:02,500
.إنّه خطئي أنا في الحقيقة

119
00:08:04,500 --> 00:08:06,180
!أتسمعني؟

120
00:08:06,180 --> 00:08:08,310
!إينوغامي-كُن

121
00:08:08,310 --> 00:08:09,400
!أتسمعني؟

122
00:08:09,400 --> 00:08:10,650
.لا شيء هناك

123
00:08:11,810 --> 00:08:14,890
.هنالك خطب ما لعدم وجود شيء هنا

124
00:08:15,090 --> 00:08:16,640
فعلاً؟

125
00:08:18,800 --> 00:08:19,960
.لنعد

126
00:08:22,910 --> 00:08:24,270
كيف سار الأمر؟

127
00:08:24,270 --> 00:08:24,900
هل وجدتماه؟

128
00:08:25,770 --> 00:08:27,650
.كلاّ، لم نجده

129
00:08:28,010 --> 00:08:30,130
.لم نستطع إيجاده أيضًا

130
00:08:30,130 --> 00:08:32,710
.لم نستطع إيجاد ولو حيوان واحد في الحقيقة

131
00:08:32,710 --> 00:08:34,560
.لم نجد أيّ شيء أيضًا

132
00:08:35,810 --> 00:08:37,160
أليس هذا غريبًا؟

133
00:08:37,420 --> 00:08:39,280
.نعم، هذا غريب

134
00:08:39,730 --> 00:08:42,330
مي-كُن، أتريد دخول جيبي؟

135
00:08:44,310 --> 00:08:45,510
.لنغادر

136
00:08:45,510 --> 00:08:48,010
.قد يحدث شيء ما بمجرّد غروب الشّمس

137
00:08:51,940 --> 00:08:52,890
سورا-كُن؟

138
00:08:52,890 --> 00:08:53,750
ماذا هنالك؟

139
00:08:54,850 --> 00:08:59,140
أخبروني، ألم تشعروا بتغيّر في الجوّ؟

140
00:09:00,410 --> 00:09:01,110
.أنتم

141
00:09:02,430 --> 00:09:03,920
.لقد تحوّل إلى طريق واحد

142
00:09:10,240 --> 00:09:11,780
ما-ماذا...؟

143
00:09:11,940 --> 00:09:13,410
موسيقى مهرجان؟

144
00:09:15,580 --> 00:09:16,830
...الانقلاب الصّيفيّ

145
00:09:16,830 --> 00:09:18,320
..موسيقى مهرجان

146
00:09:18,320 --> 00:09:19,410
.مهرجان

147
00:09:23,040 --> 00:09:27,170
لم نستطع الذّهاب السّنة الماضي، فهل تريد
الذّهاب لمهرجان إله الأرض هذه السّنة؟

148
00:09:27,900 --> 00:09:31,340
.أعطانا يامادا-سان دعوات أيضًا

149
00:09:32,890 --> 00:09:36,640
.لنتوقّف عن التّورّط في تلك الأمور

150
00:09:37,720 --> 00:09:43,150
أعتقد أنّ علينا العثور على أصدقاء
.آخرين وبشر نلعب معهم

151
00:09:45,680 --> 00:09:49,310
لقد بقيت كلمات تازكي عالقة
.في ذهني أكثر من المهرجان

152
00:09:50,160 --> 00:09:52,320
.لا علاقة للأمر به

153
00:09:52,880 --> 00:09:54,600
.لقد نسيت تمامًا

154
00:09:55,270 --> 00:09:56,180
.هذا سيّئ

155
00:09:57,830 --> 00:09:59,920
.لقد أتينا إلى المهرجان

156
00:09:59,920 --> 00:10:01,330
.مهرجان إله الأرض

157
00:10:02,070 --> 00:10:06,080
.إنّه مهرجان خاصّ يحدث في الانقلاب الصّيفيّ

158
00:10:06,330 --> 00:10:07,830
مهرجان؟

159
00:10:07,830 --> 00:10:09,220
—لا بدّ من وجود شخص نعرفه

160
00:10:09,220 --> 00:10:11,340
.لا يكفي أن يكون لدينا معارف

161
00:10:11,690 --> 00:10:14,670
.لا يسمح لأحد لم يكن مدعوًّا بالدّخول

162
00:10:15,990 --> 00:10:18,090
.إنّه مهرجان لا بشر فيه

163
00:10:19,930 --> 00:10:21,360
.بشر

164
00:10:26,130 --> 00:10:27,350
...ظهروا فجأة

165
00:10:28,010 --> 00:10:29,600
.قدّموا دعواتكم

166
00:10:32,080 --> 00:10:33,110
.سأهتمّ بالأمر

167
00:10:34,220 --> 00:10:37,880
.مع أنّه لا فائدة من الكذب

168
00:10:38,210 --> 00:10:40,610
.ولا فائدة من قول الحقيقة

169
00:10:42,320 --> 00:10:46,600
.أنا آسف، لقد ضعنا ووجدنا أنفسنا هنا

170
00:10:46,960 --> 00:10:48,500
...لذلك ليس لدينا

171
00:10:48,500 --> 00:10:50,250
ليس لديكم دعوات؟

172
00:10:54,260 --> 00:10:55,630
.هذا لا يغتفر

173
00:11:00,750 --> 00:11:06,520
بشر يدخلون مهرجاننا المقدّس بلا دعوة

174
00:11:06,520 --> 00:11:08,480
.يستحقّون العقاب

175
00:11:08,480 --> 00:11:12,870
هل يمكن أن أكون الوحيد الّذي يُعاقَب؟

176
00:11:15,650 --> 00:11:18,000
.سأفعل أيّ شيء

177
00:11:18,000 --> 00:11:20,650
.يمكنكم دفعي للعمل حتّى الموت أو التّضحية بي

178
00:11:21,110 --> 00:11:23,910
لذلك هلاّ تركتم الآخرين يذهبون؟

179
00:11:26,900 --> 00:11:28,660
ما الّذي تتحدّث عنه؟

180
00:11:33,630 --> 00:11:36,810
،يالك من بشريّ ممتع

181
00:11:37,520 --> 00:11:38,920
.لكن لن أسمح بذلك

182
00:11:38,920 --> 00:11:39,840
!سورا-تشان

183
00:11:54,000 --> 00:11:54,900
!كلاّ

184
00:12:03,050 --> 00:12:05,370
!جهّزوا أنفسكم جميعًا

185
00:12:08,020 --> 00:12:08,920
ما-ماذا...؟

186
00:12:10,250 --> 00:12:11,170
!مي-كُن

187
00:12:11,170 --> 00:12:12,420
!أبتعد عنّي أيّها الأبله

188
00:12:12,420 --> 00:12:13,620
!ابتعد عنّي

189
00:12:14,710 --> 00:12:18,250
.ماذا؟ لديكم دعوات إذًا

190
00:12:19,420 --> 00:12:21,720
...واحدة، اثنتان، ثلاثة، أربعة

191
00:12:21,720 --> 00:12:23,510
.لديكم دعوات تكفي الجميع

192
00:12:27,930 --> 00:12:30,890
كان بالإمكان تفادي ذلك
.لو قدّمتم الدّعوات باكرًا

193
00:12:31,150 --> 00:12:32,180
!مي-كُن

194
00:12:32,180 --> 00:12:34,140
!عليك أن تكون حذرًا أكثر

195
00:12:37,560 --> 00:12:40,730
.تغيّر الوضع إن كان لديكم دعوات

196
00:12:40,730 --> 00:12:42,480
.شكرًا على المجيء

197
00:12:42,480 --> 00:12:44,570
.استمتعوا بوقتكم

198
00:12:45,430 --> 00:12:46,910
لقد نجونا؟

199
00:12:53,960 --> 00:12:55,910
!كفّ عن هذا

200
00:12:55,910 --> 00:12:58,210
.تقوم بالأشياء من أجلك دائمًا

201
00:13:01,590 --> 00:13:02,490
.تاتشان

202
00:13:02,490 --> 00:13:03,340
.مهلاً

203
00:13:04,070 --> 00:13:05,990
.سوف أتحدّث معه وحدنا لبعض الوقت

204
00:13:12,520 --> 00:13:13,600
!تازكي

205
00:13:13,600 --> 00:13:14,600
!انتظر يا تازكي

206
00:13:16,730 --> 00:13:18,850
لماذا فقدت رشدك فجأة هكذا؟

207
00:13:18,850 --> 00:13:21,730
هل فعلتُ شيئًا أغضبك؟

208
00:13:22,220 --> 00:13:23,360
.عليك أن تشرح

209
00:13:23,360 --> 00:13:24,510
سورا؟

210
00:13:24,510 --> 00:13:26,490
هذا أنت يا سورا، صحيح؟

211
00:13:26,490 --> 00:13:27,680
.يامادا-سان

212
00:13:27,680 --> 00:13:29,920
.لم أرك منذ وقت طويل يا سورا

213
00:13:30,880 --> 00:13:33,030
.لقد كبرت كثيرًا

214
00:13:33,030 --> 00:13:35,020
.حتّى أنّك أصبحت ظريفًا أكثر من السّابق

215
00:13:35,370 --> 00:13:37,200
.ظريف للغاية

216
00:13:35,370 --> 00:13:38,130
.سوف تقتلني يا يامادا-سان
.ستقتلني

217
00:13:39,280 --> 00:13:41,380
ماذا؟ من هذا؟

218
00:13:41,520 --> 00:13:42,640
.هذا تازكي

219
00:13:42,640 --> 00:13:44,170
.صديقي تازكي

220
00:13:44,170 --> 00:13:46,110
.سررت بلقائك

221
00:13:46,110 --> 00:13:49,140
.أنت هو الفتى تازكي

222
00:13:49,420 --> 00:13:52,040
.ظريف. ظريف بالفعل

223
00:13:52,730 --> 00:13:55,640
يامادا-سان، هل يمكنك تركه رجاءً؟

224
00:13:55,640 --> 00:13:57,770
.أنا آسف

225
00:13:58,120 --> 00:14:01,640
.لقد أتيت إلى المهرجان أخيرًا

226
00:14:01,640 --> 00:14:03,270
.أنا جدّ سعيد

227
00:14:03,270 --> 00:14:04,690
.نعم، صحيح

228
00:14:05,670 --> 00:14:09,150
تلك الدّعوات هي الّتي أعطاني
.إيّاها يامادا-سان منذ مدّة

229
00:14:10,040 --> 00:14:11,460
ما الأمر يا سورا؟

230
00:14:12,780 --> 00:14:17,110
.اسمع، لقد أتينا للجبل بحثًا عن إينوغامي

231
00:14:17,110 --> 00:14:18,460
إينوغامي؟

232
00:14:18,460 --> 00:14:20,200
هل رأيت واحدًا هنا؟

233
00:14:20,200 --> 00:14:22,160
.لديه حبل حول عنقه

234
00:14:22,160 --> 00:14:23,710
.يبدو أنّه مصاب

235
00:14:23,950 --> 00:14:26,660
.صحيح، تقصد آ وأو

236
00:14:26,660 --> 00:14:27,920
آ وأو؟

237
00:14:27,920 --> 00:14:29,100
...إنّهما هناك

238
00:14:29,100 --> 00:14:31,100
!سورا-كُن! كامي-كُن

239
00:14:36,390 --> 00:14:38,170
.صحيح، سأعرّفكم على بعض

240
00:14:38,170 --> 00:14:39,980
.إنّهما صديقاي، موغي-تشان ودايتشي

241
00:14:39,980 --> 00:14:41,730
!يا للظّرافة

242
00:14:44,370 --> 00:14:47,740
.آسف، يحبّ يامادا-سان البشر

243
00:14:49,540 --> 00:14:52,120
.لقد اهتممت بأمره هذا الصّباح

244
00:14:52,570 --> 00:14:55,770
.أخذته إلى أو قبل قليل فحسب

245
00:14:55,770 --> 00:14:59,000
أخبرني يا يامادا-سان، من هما آ وأو؟

246
00:14:59,420 --> 00:15:02,070
.إنّهما الاسمين اللّذين أطلقتهما على الإينوغامي

247
00:15:02,070 --> 00:15:04,110
.هنالك اثنان منها، أسمّيهما آ-أون

248
00:15:04,110 --> 00:15:05,860
.لقد فهمت

249
00:15:05,860 --> 00:15:08,060
تقصد آ وأو بقولك آ-أون؟

250
00:15:08,060 --> 00:15:12,140
المقصود بعبارة آ-أون هو بداية
.ونهاية كلّ شيء

251
00:15:12,590 --> 00:15:17,390
.يمثّل كلبا فو في مدخل الضّريح آ-أون

252
00:15:17,620 --> 00:15:18,850
.فهمت

253
00:15:18,850 --> 00:15:21,010
.إنّهما آ-كُن وأو-كُن إذًا

254
00:15:21,010 --> 00:15:22,900
هل كلاهما بأمان؟

255
00:15:23,380 --> 00:15:25,400
،إنّهما بأمان بطريقة ما

256
00:15:25,840 --> 00:15:29,780
.لكن هنالك بشر رأوهما قبل أيّام

257
00:15:30,200 --> 00:15:34,010
.يبدو أنّ آ قد وفّر وقتًا لأو للهرب

258
00:15:34,250 --> 00:15:36,540
،يبدو أنّ آ استطاع الهرب أيضًا

259
00:15:37,060 --> 00:15:39,220
.لكنّ أو كان يبكي بشدّة

260
00:15:39,220 --> 00:15:41,130
.لم يكن هنالك فائدة من الأمر

261
00:15:43,720 --> 00:15:46,830
.كنتم تبحثون عن آ، في اليمين

262
00:15:46,830 --> 00:15:49,170
.نصفه الآخر أو، كان في اليسار

263
00:15:49,610 --> 00:15:52,080
—جيّد، يبدو أنّهما يهدآن

264
00:16:01,790 --> 00:16:03,310
ستذهب من هناك؟

265
00:16:03,510 --> 00:16:06,710
.يا إلهي، إنّه قتال كبير

266
00:16:09,340 --> 00:16:10,930
.سنهتمّ بهذا

267
00:16:13,770 --> 00:16:16,090
،لقد تمكّنت من ملاحقته

268
00:16:16,090 --> 00:16:18,160
.لكنّني لا أدري ما العمل بشأن هذا البكاء

269
00:16:19,200 --> 00:16:20,280
مي-كُن؟

270
00:16:24,560 --> 00:16:29,920
اسمع يا آ-كُن، هل تبكي لأنّ أو-كُن عضّك؟

271
00:16:31,590 --> 00:16:33,680
أم لأنّك جعلت أو-كُن يبكي؟

272
00:16:36,550 --> 00:16:37,520
هكذا إذًا؟

273
00:16:38,840 --> 00:16:43,480
،في الحقيقة، فعلتُ ما فعلتَه للتّوّ
.وقد لكمني صديقي

274
00:16:44,320 --> 00:16:46,950
.لقد انزعجت كثيرًا لأنّ ذلك كان مفاجئًا

275
00:16:46,950 --> 00:16:49,980
.لقد واجهته، وسألته لماذا ضربني

276
00:16:50,750 --> 00:16:54,400
.الأمر واضح عندما نفكّر فيه

277
00:16:55,460 --> 00:16:57,850
،فعلتُ شيئًا من أجل أصدقائي

278
00:16:58,400 --> 00:17:00,950
وانتهى بي المطاف ملحقًا الأذى
.بهم في المقابل

279
00:17:14,610 --> 00:17:17,050
.مي-كُن، أنا آسف بشأن ما فعلت

280
00:17:17,850 --> 00:17:20,650
.أعرف ما هو شعور القلق على أحد ما

281
00:17:21,280 --> 00:17:23,060
.لا أستطيع القيام بما هو صائب فحسب

282
00:17:25,500 --> 00:17:27,520
.لنذهب لرؤية أو-كُن معًا

283
00:17:28,950 --> 00:17:30,440
.أعتقد أنّه ذهب من هنا

284
00:17:32,920 --> 00:17:33,940
ما هذه الضّجّة؟

285
00:17:38,330 --> 00:17:38,950
.أنت

286
00:17:42,220 --> 00:17:46,090
.لن تحلّ أيّ شيء بأذيّة نفسك

287
00:17:47,550 --> 00:17:50,940
هذا يجعل الأمر يسوء أكثر عندما
،تعرف حقيقة مشاعر الآخر

288
00:17:50,940 --> 00:17:52,670
.ومع ذلك لا يبدو ذلك صائبًا

289
00:17:54,170 --> 00:17:58,360
.إنّها دوّامة من الغضب والحزن وكره الذّات

290
00:17:58,980 --> 00:18:01,720
،ينتهي بك المطاف ملقيًا بكلّ ذلك عليه

291
00:18:02,550 --> 00:18:04,350
.حتّى إن كان يهمّك أمره

292
00:18:04,350 --> 00:18:05,600
الأمر صعب، صحيح؟

293
00:18:14,130 --> 00:18:18,060
هرب آ-كُن من هذه الجهة فجأة
.لذلك طاردته إلى هنا

294
00:18:18,630 --> 00:18:19,620
هكذا إذًا؟

295
00:18:28,090 --> 00:18:29,000
.جيّد

296
00:18:33,210 --> 00:18:35,260
ماذا؟ هل ثمّة أمر ما هناك؟

297
00:18:35,660 --> 00:18:36,880
!كلاّ

298
00:18:37,210 --> 00:18:40,640
كيف حصل ذلك الرّجل على هذه؟

299
00:18:41,000 --> 00:18:43,640
هل هو جامع؟

300
00:18:49,380 --> 00:18:53,960
أخبرني يا تازكي، هل تتذكّر عندما
دعوتك لهذا المهرجان؟

301
00:18:54,340 --> 00:18:55,270
.نعم

302
00:18:55,270 --> 00:18:56,150
.بالطّبع

303
00:18:56,590 --> 00:19:01,200
لماذا قلتَ أنّ علينا الكفّ عن التّورّط
مع هذه الكائنات؟

304
00:19:02,020 --> 00:19:03,790
.لطالما شغل ذلك بالي

305
00:19:06,840 --> 00:19:11,170
.هنالك أمر واحد لا أستطيع إخبارك به

306
00:19:12,740 --> 00:19:15,670
.كنتُ حريصًا بشدّة على أخفائه عنك حينها

307
00:19:16,110 --> 00:19:20,430
.شعرتُ أنّني لن أستطيع رؤيتك ثانية إن أخبرتك

308
00:19:21,630 --> 00:19:23,930
أخبرتك ألاّ نتورّط مع هذه الكائنات

309
00:19:24,410 --> 00:19:26,660
.لأنّه ربّما كنت أوشك على إخبارك

310
00:19:27,760 --> 00:19:32,670
،حتّى إن عنى ذلك أن أكذب عليك
.لم أتحمّل فكرة الانفصال عنك

311
00:19:34,660 --> 00:19:37,850
.لطالما ظننت أنّك ستبعد نفسك عنّي

312
00:19:41,110 --> 00:19:44,080
يدخل النّاس حياة الآخرين
.ويخرجون عاجلاً أم آجلاً

313
00:19:44,080 --> 00:19:48,880
،كنتُ أجهّز نفسي لقبول هذا
.وقتما حدث ذلك

314
00:19:49,610 --> 00:19:52,710
هل كنت تفكّر هكذا طوال الوقت؟

315
00:19:53,410 --> 00:19:54,540
.نعم

316
00:19:56,730 --> 00:19:58,180
.كنت أفكّر

317
00:19:58,180 --> 00:20:01,550
،عرفتُ أنّك سترحل يومًا ما أيضًا

318
00:20:01,960 --> 00:20:03,300
.كنتُ أجهّز نفسي

319
00:20:05,330 --> 00:20:06,720
...كاشيواغي

320
00:20:15,230 --> 00:20:16,360
!كاشيواغي

321
00:20:25,340 --> 00:20:26,120
.سوف ننفصل

322
00:20:28,250 --> 00:20:29,870
.لا تقف دون حراك فجأة

323
00:20:29,870 --> 00:20:31,120
.أنت تسبّب الإزعاج للآخرين

324
00:20:31,470 --> 00:20:32,340
.نعم

325
00:20:32,690 --> 00:20:34,730
.اسمع، تمسّك بقميصي

326
00:20:45,320 --> 00:20:47,740
.لن أتركك

327
00:20:49,020 --> 00:20:51,120
كم مضى على بقائي إلى جانبك في رأيك؟

328
00:20:51,520 --> 00:20:53,140
.افهم ذلك وحسب

329
00:20:56,720 --> 00:20:57,960
.شكرًا لك

330
00:20:57,960 --> 00:20:59,650
.وأنا آسف

331
00:20:59,980 --> 00:21:05,160
أعتقد أنّني سأحاول الاعتماد
.عليك أكثر بدءًا من الآن

332
00:21:05,840 --> 00:21:06,750
ألا تمانع؟

333
00:21:09,160 --> 00:21:10,680
.بالطّبع لا أمانع

334
00:21:11,040 --> 00:21:12,920
.لهذا نحن من نحن

335
00:21:20,010 --> 00:21:21,810
نقف جميعًا تحت هذا الشّلاّل

336
00:21:21,810 --> 00:21:25,300
لتصفية أجسادنا وأرواحنا قبل
.أن نستمتع في المهرجان

337
00:21:29,600 --> 00:21:31,770
.يبدو هذا رائعًا

338
00:21:31,770 --> 00:21:33,680
أتريد لمسه يا مي-كُن؟

339
00:21:38,490 --> 00:21:39,700
إنّه رائع، صحيح؟

340
00:21:51,640 --> 00:21:53,220
.إنّهما يتسلّقان الشّلاّل

341
00:21:53,220 --> 00:21:57,700
يقال إن استطاع الإينوغامي تسلّق
.الشّلاّل، فسوف يكبر

342
00:21:57,700 --> 00:21:58,780
فعلاً؟

343
00:21:58,780 --> 00:22:00,090
!لا تستسلما

344
00:22:03,300 --> 00:22:04,840
!اسمعوا

345
00:22:05,790 --> 00:22:08,010
هل رأيتم رجلاً مشبوهًا في الجوار؟

346
00:22:08,010 --> 00:22:10,220
.رجل؟ لم أره

347
00:22:13,680 --> 00:22:14,780
مي-كُن؟

348
00:22:15,560 --> 00:22:16,680
!مي-كُن؟

349
00:23:50,710 --> 00:23:52,690
.مرّت نصف سنة على وصول مي-كُن

350
00:23:52,690 --> 00:23:56,050
.هنالك الكثير لا أعرفه بعد، لكنّ الأمر ممتع دائمًا

351
00:23:56,430 --> 00:23:59,830
.شكرًا على مجيئك لمنزلي يا مي-كُن

352
00:24:00,370 --> 00:24:03,860
."الحلقة الأخيرة من "كيف تحتفظ بمومياء