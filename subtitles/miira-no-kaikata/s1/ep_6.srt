1
00:00:00,560 --> 00:00:02,480
.انظري لكلبتي ساكورا

2
00:00:02,750 --> 00:00:04,560
.انظري لقطّتي تاما

3
00:00:04,560 --> 00:00:06,860
.انظري لعصفورتي سي-تشان

4
00:00:07,250 --> 00:00:09,110
.جميعها ظريفة

5
00:00:09,110 --> 00:00:11,800
أنت تحبّين الحيوانات، صحيح يا موغي-تشان؟

6
00:00:11,800 --> 00:00:13,570
هل تقتنين حيوانًا أليفًا؟

7
00:00:14,280 --> 00:00:17,590
.عائلة موغي-تشان بأكملها تحبّ الحيوانات

8
00:00:17,590 --> 00:00:20,260
لهذا السّبب لا يمكنك أن تقرّري
ما الحيوان الّذي ستقتنينه، صحيح؟

9
00:00:20,260 --> 00:00:22,640
...صحيح، لكن في ذلك اليوم، إ

10
00:00:23,710 --> 00:00:26,510
.لكن حاولي ألاّ تخبري النّاس عنها

11
00:00:26,790 --> 00:00:27,880
إ؟

12
00:00:31,070 --> 00:00:34,010
.كنتُ أتحدّث مع عائلتي بشأن اقتناء خنزير برّيّ

13
00:00:34,200 --> 00:00:35,940
خنزير برّيّ؟

14
00:00:35,940 --> 00:00:37,580
خنزير برّيّ إذًا؟

15
00:00:37,580 --> 00:00:40,870
.لكن أعتقد أنّ أيّ حيوان سيتعلّق بك

16
00:00:40,870 --> 00:00:42,620
.إنّها تكون ظريفة وهي صغيرة

17
00:00:42,620 --> 00:00:44,020
.قد يكون الخنزير البرّيّ جيّدًا أيضًا

18
00:00:46,440 --> 00:00:47,230
...إ

19
00:00:47,730 --> 00:00:48,960
.ساو

20
00:00:48,960 --> 00:00:50,530
.هذا ما قصدَته

21
00:02:28,500 --> 00:02:31,970
كنتِ على وشك أن تتحدّثين بشأن
.إساو في المدرسة اليوم

22
00:02:32,460 --> 00:02:34,960
.نعم، أنا آسفة

23
00:02:35,930 --> 00:02:38,690
،إن كنتِ تحتاجين للحديث عن إساو
.فتحدّثي معنا

24
00:02:39,670 --> 00:02:42,470
.يمكنك أن تتحدّثي بقدر ما تشائين معنا

25
00:02:42,470 --> 00:02:44,400
فـ-فعلاً؟

26
00:02:44,750 --> 00:02:47,750
يمكنني التّحدّث عنه معكما في المدرسة؟

27
00:02:47,750 --> 00:02:50,230
.هذا ما دام لا يسمعنا أحد

28
00:02:50,590 --> 00:02:54,230
.نحن نتناول غداءنا على السّطح في العادة

29
00:02:54,630 --> 00:02:57,750
.عليك الانضمام لنا يا موتيغي-سان

30
00:02:57,750 --> 00:02:58,990
أيمكنني ذلك؟

31
00:03:00,110 --> 00:03:03,210
أردتِ أن تقولي كم أنّ إساو ظريف، صحيح؟

32
00:03:03,890 --> 00:03:06,240
ما الّذي حدث وجعلك تعتقدين أنّه ظريف؟

33
00:03:07,070 --> 00:03:10,870
.أحضر لي إساو علبة ناتو لأفتحها له

34
00:03:11,180 --> 00:03:15,600
لذلك فتحتها له، واستعمل عيدان الأكل
.لتخليطه وأكله بنفسه

35
00:03:15,600 --> 00:03:16,950
قام بخلطه؟

36
00:03:16,950 --> 00:03:22,380
،نعم، ثمّ بعد أن انتهى من الأكل
.ذهب للحمّام وغسل يديه بنفسه

37
00:03:23,680 --> 00:03:25,020
.يبدو أنّه ذكيّ

38
00:03:25,020 --> 00:03:25,740
.نعم

39
00:03:25,740 --> 00:03:27,640
.إساو مدهش

40
00:03:27,850 --> 00:03:32,090
صحيح، لاحظت أنّ بعض النّاس
.يدعونك موغي-تشان

41
00:03:32,090 --> 00:03:34,270
.نعم، إنّه لقبي

42
00:03:34,270 --> 00:03:36,740
كيف تشعرين حيال ذلك يا موتيغي؟

43
00:03:36,740 --> 00:03:38,270
.أعتقد أنّه رائع

44
00:03:38,270 --> 00:03:39,280
.إنّه لقبي

45
00:03:39,630 --> 00:03:45,050
كما أنّ مناداتي بلقبي
.يجعلني أشعر أنّني مميّزة

46
00:03:45,420 --> 00:03:46,780
.إنّ ذلك يُسعدني

47
00:03:47,710 --> 00:03:49,200
.سأبدأ بمناداتها موغي

48
00:03:49,200 --> 00:03:50,690
.أريد جعلها أختًا لي

49
00:03:52,770 --> 00:03:57,510
.سوف تأتي موغي-تشان إلى هنا يوم الأحد

50
00:03:57,510 --> 00:03:58,670
.سيأتي تازكي أيضًا

51
00:03:58,940 --> 00:04:01,300
ستأتي تلك الفتاة الظّريفة ثانية؟

52
00:04:01,740 --> 00:04:03,320
.سيأتي إساو أيضًا

53
00:04:03,320 --> 00:04:04,780
إساو؟

54
00:04:04,780 --> 00:04:07,600
.صحيح، تقصد ذلك التّنّين

55
00:04:07,600 --> 00:04:11,310
ألم تستطع التّفكير في اسم
ليس من أسماء الأولاد؟

56
00:04:11,650 --> 00:04:14,030
.قالت أنّها تحبّه

57
00:04:14,030 --> 00:04:17,820
.لكنّه كان تنّينًا طيّبًا

58
00:04:21,790 --> 00:04:23,960
.لقد كان كأخ أكبر

59
00:04:23,960 --> 00:04:26,050
.صحيح، معك حقّ

60
00:04:27,280 --> 00:04:28,150
ما الخطب؟

61
00:04:28,150 --> 00:04:29,430
ما الخطب يا مي-كُن؟

62
00:04:30,560 --> 00:04:32,550
ظهر يحكّك؟

63
00:04:34,500 --> 00:04:36,580
.كان عليك إخباري. سأحكّ ظهرك لك

64
00:04:36,830 --> 00:04:40,130
إنّ مي-كُن أشبه بأخ أصغر
.عند إمعان النّظر فيه

65
00:04:40,860 --> 00:04:42,060
.معك حقّ

66
00:04:42,520 --> 00:04:46,340
...صحيح، عندما كنت أنظّف الحمّام

67
00:04:56,360 --> 00:04:57,050
!مي-كُن

68
00:04:57,050 --> 00:04:58,110
!مهلاً، توقّف

69
00:05:02,860 --> 00:05:05,250
.من الخطير الرّكض في الحمّام

70
00:05:05,250 --> 00:05:07,160
...ثمّ في يوم آخر

71
00:05:08,230 --> 00:05:09,530
.حسنًا

72
00:05:09,840 --> 00:05:12,630
.سوف أحضر الغسيل

73
00:05:37,710 --> 00:05:40,100
مرحبًا يا كاشيواغي-سان؟

74
00:05:40,900 --> 00:05:42,140
مرحبًا؟

75
00:05:45,000 --> 00:05:47,480
كـ-كاشيواغي-سان؟

76
00:05:48,550 --> 00:05:50,700
مهلاً، أأنت الكلب؟

77
00:05:52,390 --> 00:05:54,240
لماذا يردّ الكلب على الهاتف؟

78
00:05:55,040 --> 00:05:57,500
.آسف، لقد كان ذلك كلبي

79
00:05:57,500 --> 00:05:58,580
.لا بأس

80
00:05:58,580 --> 00:06:00,840
.يا له من كلب ذكيّ

81
00:06:01,960 --> 00:06:03,750
.ذلك ما حدث

82
00:06:04,570 --> 00:06:07,970
إنّ مي-كُن من النّوع الّذي يحتاج
.للعناية وليس الّذي يعتني بالآخرين

83
00:06:09,610 --> 00:06:11,700
.إنّه ظريف بكلّ تأكيد

84
00:06:12,310 --> 00:06:13,570
.نعم

85
00:06:13,570 --> 00:06:16,410
.لهذا السّبب سأقرأ له قصتان مصوّرتان اللّيلة

86
00:06:16,410 --> 00:06:17,600
صحيح يا مي-كُن؟

87
00:06:20,200 --> 00:06:21,050
ماذا؟

88
00:06:21,050 --> 00:06:22,610
.أتساءل ما الخطب

89
00:06:24,820 --> 00:06:26,200
.مرحبًا

90
00:06:27,130 --> 00:06:28,740
.شكرًا على استضافتي

91
00:06:28,740 --> 00:06:29,740
.تفضّلي

92
00:06:35,450 --> 00:06:38,720
.أنا سعيدة لأنّ إساو يبدو سعيدًا أيضًا

93
00:06:38,720 --> 00:06:41,330
،كانت كايدي-سان تتطلّع قُدمًا لهذا أيضًا

94
00:06:41,330 --> 00:06:44,310
.لكن كان عليها المغادرة بسبب عمل طارئ

95
00:06:44,720 --> 00:06:47,290
.هكذا إذًا، هذا مؤسف

96
00:06:47,980 --> 00:06:50,970
كانت هنالك أمور كثيرة أردت
.الحديث بها مع كايدي-سان أيضًا

97
00:06:52,160 --> 00:06:54,210
.انظرا، إنّه يطير

98
00:06:54,920 --> 00:06:55,880
ماذا تقصد؟

99
00:06:55,880 --> 00:06:57,270
.إساو يطير

100
00:06:57,270 --> 00:06:58,660
.معك حقّ

101
00:06:58,660 --> 00:07:00,390
.بالطّبع، إنّه تنّين

102
00:07:00,390 --> 00:07:02,910
.إنّه يطير كثيرًا في المنزل

103
00:07:02,910 --> 00:07:05,420
.يستطيع الطّيران لعلوّ خمسة أمتار

104
00:07:05,420 --> 00:07:09,030
كيف لكما أن تتكيّفا مع هذا بسرعة؟

105
00:07:07,440 --> 00:07:09,030
لقد تعبت

106
00:07:09,850 --> 00:07:12,850
.على أيّ حال، لديّ إعلان ضخم لأقدّمه اليوم

107
00:07:12,850 --> 00:07:14,780
...استعدّا

108
00:07:15,980 --> 00:07:18,290
!تعلّم إساو الكتابة

109
00:07:18,290 --> 00:07:20,530
إساو كتب ذلك؟

110
00:07:20,530 --> 00:07:21,920
!مذهل

111
00:07:23,460 --> 00:07:26,030
.هذا تطوّر باهر في وقت قصير

112
00:07:26,030 --> 00:07:28,300
.نعم، نعم

113
00:07:28,300 --> 00:07:31,300
لماذا تتصرّفين إذًا وكأنّه إنجازك أنت؟

114
00:07:32,690 --> 00:07:34,630
.أبليت حسنًا يا إساو

115
00:07:33,270 --> 00:07:34,900
هل أنت من علّمته يا موغي؟

116
00:07:34,900 --> 00:07:35,720
.كلاّ

117
00:07:36,000 --> 00:07:39,760
أعتقد أنّه تعلّم مع الوقت بينما
.كنت أقرأ له القصص المصوّرة

118
00:07:39,760 --> 00:07:41,600
.إنّه ذكيّ بالفعل

119
00:07:42,070 --> 00:07:44,520
قد يكون قادرًا على الكتابة بالحروف
.اللاّتينيّة إن علّمتِه ذلك

120
00:07:44,520 --> 00:07:45,910
حروف لاتينيّة؟

121
00:07:45,910 --> 00:07:48,820
.كلاّ، من المستحيل أن يستطيع تعلّم الإنجليزيّة

122
00:07:48,820 --> 00:07:49,490
.حسنًا

123
00:07:49,850 --> 00:07:51,550
.إساو، سوف أعلّمك

124
00:07:51,550 --> 00:07:53,240
أتريد أت تحاول كتابة شيء ما؟

125
00:07:53,240 --> 00:07:54,330
.A هذا حرف

126
00:07:54,330 --> 00:07:55,420
.B وهذا حرف

127
00:07:55,420 --> 00:07:56,580
.C وهذا هو

128
00:07:56,580 --> 00:07:57,700
...وهذا

129
00:07:57,970 --> 00:08:00,640
.هذه هي الحروف السّتّة والعشرون

130
00:08:00,640 --> 00:08:02,850
...يمكنك الجمع بينها لتشكيل

131
00:08:12,740 --> 00:08:14,890
...إ-إنّه

132
00:08:14,890 --> 00:08:16,890
.إنّه أفضل من كاشيواغي

133
00:08:16,890 --> 00:08:20,790
.يا أستاذ، أستطيع كتابة الحروف اللاّتينيّة أيضًا

134
00:08:21,520 --> 00:08:24,000
.إنّهم يخطّطون لشيء ما هناك

135
00:08:24,000 --> 00:08:26,520
.يبدو أنّ إساو يعلّمهما شيئًا

136
00:08:27,590 --> 00:08:29,020
.لقد أحضر شيئًا ما

137
00:08:29,020 --> 00:08:32,400
هل علّمك إساو كيف تكتب؟

138
00:08:32,990 --> 00:08:35,780
لنرَ، كيف أبليت؟

139
00:08:36,680 --> 00:08:41,570
سورا-تشان، يراودني شعور أنّ هنالك
.شيئًا ضخمًا مكتوبًا هنا

140
00:08:41,570 --> 00:08:44,130
.أعتقد أنّ عليك أن تستعدّ لما ستقرأه

141
00:08:44,870 --> 00:08:45,630
.حسنًا

142
00:08:45,630 --> 00:08:46,700
.مفهوم

143
00:08:47,290 --> 00:08:51,030
.يبدو مي-كُن قلقًا بالفعل

144
00:08:51,030 --> 00:08:53,050
ما المكتوب فيها؟

145
00:08:57,800 --> 00:08:59,810
معًا للأبد

146
00:09:01,580 --> 00:09:04,830
!هذا ظريف للغاية! إنّه ظريف

147
00:09:04,830 --> 00:09:06,690
!يا إلهي

148
00:09:06,690 --> 00:09:08,160
.تمالك نفسك

149
00:09:09,060 --> 00:09:12,320
في الحقيقة، عندما أعطاني
...إساو رسالة أوّل مرّة

150
00:09:17,670 --> 00:09:19,580
ماذا هنالك يا إساو؟

151
00:09:20,650 --> 00:09:22,640
هل تعطيني رسالة؟

152
00:09:22,640 --> 00:09:23,690
.شكرًا

153
00:09:23,690 --> 00:09:25,150
.أن رائع يا إساو

154
00:09:25,150 --> 00:09:27,160
.لا أصدّق أنّ بإمكانك كتابة رسائل

155
00:09:29,840 --> 00:09:32,590
شكرًا على كلّ شيء

156
00:09:32,590 --> 00:09:35,810
!كنتُ متفاجئة للغاية

157
00:09:35,810 --> 00:09:37,540
فعلاً؟

158
00:09:37,540 --> 00:09:40,840
.لهذا السّبب أخبرتني أن أستعدّ

159
00:09:40,840 --> 00:09:41,510
.نعم

160
00:09:42,190 --> 00:09:42,900
ماذا؟

161
00:09:44,450 --> 00:09:46,550
.يكتب كوني شيئًا أيضًا

162
00:09:46,550 --> 00:09:47,980
ربّما يكتب "أحبّك" أو ما شابه؟

163
00:09:48,210 --> 00:09:50,460
.لن يكتب شيئًا كذلك بكلّ تأكيد

164
00:09:50,460 --> 00:09:54,760
.ربّما سيكتب "سوشي" بدل ذلك

165
00:09:53,110 --> 00:09:58,110
سوشي

166
00:09:55,370 --> 00:09:58,110
.ماذا؟ أستطيع تخيّل ذلك

167
00:09:58,860 --> 00:10:01,590
.يبدو أنّه يعاني من مشكلة في اتّخاذ قراره

168
00:10:01,590 --> 00:10:04,610
"ربّما لم يقرّر هل يكتب "ماكي سوشي
."أو "نيغيري سوشي

169
00:10:04,610 --> 00:10:06,010
فعلاً؟

170
00:10:07,910 --> 00:10:08,950
.ها قد أحضرها

171
00:10:14,170 --> 00:10:15,070
.حسنًا، حسنًا

172
00:10:15,070 --> 00:10:16,630
تريدني أن أقرأها فحسب، صحيح؟

173
00:10:17,030 --> 00:10:19,790
.لمعلوماتك فحسب، أنا لا أقبل طلبات الطّعام

174
00:10:24,440 --> 00:10:25,900
ما المكتوب فيها؟

175
00:10:26,960 --> 00:10:28,310
.لقد طرح سؤالاً

176
00:10:28,310 --> 00:10:30,310
ما رأيك؟

177
00:10:34,520 --> 00:10:35,440
.لا أعرف

178
00:10:37,940 --> 00:10:39,210
من يدري؟

179
00:10:40,560 --> 00:10:41,510
.أنا لا أدري

180
00:10:42,450 --> 00:10:45,390
.لكن أعتقد أنّ كتابتك جيّدة

181
00:10:45,390 --> 00:10:47,360
...عـ-عفوًا

182
00:10:47,360 --> 00:10:49,080
.سوف يتأذّى كوني

183
00:10:49,350 --> 00:10:50,530
.لا بأس

184
00:10:50,530 --> 00:10:52,790
.هذه هي طريقة تازكي في إظهار حبّه

185
00:10:53,220 --> 00:10:55,610
.أنا واثق أنّ كوني يدرك ذلك أيضًا

186
00:10:53,300 --> 00:10:55,230
.حسنًا، حسنًا

187
00:10:55,230 --> 00:10:56,740
.أحسنت

188
00:11:02,270 --> 00:11:03,710
.شكرًا على الطّعام

189
00:11:03,710 --> 00:11:05,080
.شكرًا

190
00:11:05,080 --> 00:11:06,810
.كان ذلك لذيذًا كالعادة

191
00:11:06,810 --> 00:11:09,300
.أنت طبّاخ بارع يا سورا-تشان

192
00:11:09,300 --> 00:11:11,180
.أنا أطبخ طوال الوقت

193
00:11:11,680 --> 00:11:13,310
.سأساعدك على غسل الأطباق

194
00:11:14,510 --> 00:11:15,190
ماذا؟

195
00:11:15,420 --> 00:11:16,850
.لا يخرج الصّابون

196
00:11:16,850 --> 00:11:18,610
هل نفد الصّابون؟

197
00:11:18,610 --> 00:11:22,030
أعتقد أنّ هنالك بعضه
.في الخزانة السّفلى هناك

198
00:11:22,030 --> 00:11:23,020
هنا؟

199
00:11:24,450 --> 00:11:27,200
كان لذيذًا

200
00:11:24,820 --> 00:11:26,100
ما هذه؟

201
00:11:26,100 --> 00:11:27,200
ماذا؟

202
00:11:27,560 --> 00:11:29,390
هل كتبتَ هذا يا إساو؟

203
00:11:31,410 --> 00:11:32,850
.هنالك واحدة هنا أيضًا

204
00:11:33,210 --> 00:11:35,090
.أتساءل إن كانت من كوني

205
00:11:33,460 --> 00:11:36,710
ماكي سوشي

206
00:11:35,550 --> 00:11:36,710
.ثمّة واحدة هنا أيضًا

207
00:11:37,010 --> 00:11:41,850
لا بدّ أنّهم كانوا سعداء للغاية
،لأنّكما أُعجبتما بالرّسائل

208
00:11:41,850 --> 00:11:43,590
.لذلك خبّآها في كلّ المنزل

209
00:11:44,850 --> 00:11:47,440
.لنعثر عليها معًا إذًا

210
00:11:47,440 --> 00:11:49,390
.هذا أشبه بالبحث عن كنز

211
00:11:50,520 --> 00:11:52,310
.هذه الغرفة تثير الشّبهات

212
00:11:52,310 --> 00:11:53,690
هل يمكنني فتحها؟

213
00:11:54,090 --> 00:11:55,770
.على الأرجح أنّك لن ترغبين بفتحها

214
00:11:56,070 --> 00:11:59,000
هل تخبّئ شيئًا سيّئًا فيها؟

215
00:11:59,000 --> 00:12:04,170
كلاّ، يوجد هناك دمية داروما الملعونة
.الخاصّة بأبي وأمور مختومة هناك

216
00:12:04,170 --> 00:12:06,910
...يجعلني ذلك أشعر بفضول أكثر

217
00:12:07,330 --> 00:12:09,700
.لكن بما أنّك حذّرتني من فتحها، فلن أفعل

218
00:12:09,700 --> 00:12:10,720
.آسف

219
00:12:11,330 --> 00:12:12,680
.قد يكون هنالك رسائل أخرى في الخارج

220
00:12:12,680 --> 00:12:13,670
.نعم

221
00:12:17,200 --> 00:12:18,420
.لا بدّ أنّها هي

222
00:12:23,430 --> 00:12:24,940
.انظرا لكلّ هذه

223
00:12:24,940 --> 00:12:26,650
.حصلنا على الكثير منها

224
00:12:26,650 --> 00:12:28,490
.لقد خبّؤوا الكثير

225
00:12:29,320 --> 00:12:30,180
كوني؟

226
00:12:30,510 --> 00:12:32,560
حديقة منزل؟

227
00:12:33,190 --> 00:12:35,060
!كوني، لا تلمس ذلك

228
00:12:36,820 --> 00:12:37,720
!كلاّ

229
00:12:39,870 --> 00:12:40,660
—كـ

230
00:12:56,840 --> 00:12:58,510
ما هذا؟

231
00:12:58,510 --> 00:13:01,550
.إنّه نبتة لفّاح أرسلها لي أبي منذ مدّة

232
00:13:01,550 --> 00:13:04,530
.إنّ صرخته قادرة على إفقادكما لوعيكما لخمس ثوان

233
00:13:04,530 --> 00:13:06,880
.وإن واصلتما سماعها، فستموتان

234
00:13:06,880 --> 00:13:09,720
لماذا تحتفظ بشيء بهذه الخطورة؟

235
00:13:10,040 --> 00:13:13,580
.تستعمله كايدي-سان كمنبّه

236
00:13:27,660 --> 00:13:30,820
حركة واحدة خاطئة وستخلد
.في نوم لا استيقاظ منه

237
00:13:30,820 --> 00:13:33,390
إنّها تقوم بشيء خطير كهذا
.فقط لتستيقظ باكرًا

238
00:13:33,390 --> 00:13:35,170
.عليّ أن أتعلّم منها

239
00:13:35,170 --> 00:13:36,420
.إيّاك

240
00:13:37,250 --> 00:13:38,130
.لقد هرب

241
00:13:38,630 --> 00:13:40,240
.لا بأس

242
00:13:40,240 --> 00:13:41,540
.لا خطر كبير من هذا

243
00:13:42,410 --> 00:13:43,030
ماذا؟

244
00:13:46,590 --> 00:13:48,260
!إنّه سريع للغاية

245
00:13:48,260 --> 00:13:50,760
أ-ألا يجدر بك أن تتبعه؟

246
00:13:50,760 --> 00:13:54,270
ستحدث كارثة إن سقطت الضّمادة
.عن فمه في البلدة

247
00:13:59,300 --> 00:14:02,020
.ظننتني رأيته في مكان ما هنا

248
00:14:03,710 --> 00:14:04,780
!هناك

249
00:14:08,620 --> 00:14:09,400
!إنّه في النّهر

250
00:14:09,400 --> 00:14:10,800
.لنحاول أن نسبقه

251
00:14:17,210 --> 00:14:19,210
.جيّد، إنّه قادم إلى هنا

252
00:14:23,460 --> 00:14:24,840
!مي-كُن

253
00:14:30,080 --> 00:14:31,050
!كوني

254
00:14:38,980 --> 00:14:40,290
...سُحقًا

255
00:14:40,290 --> 00:14:41,740
.على رسلك

256
00:14:43,450 --> 00:14:44,480
!الضّمادة

257
00:14:48,400 --> 00:14:49,570
!إساو

258
00:14:52,740 --> 00:14:53,630
!ممتاز

259
00:14:53,630 --> 00:14:55,370
!عمل رائع يا إساو

260
00:14:56,490 --> 00:14:58,870
.أبليت حسنًا يا إساو

261
00:14:59,140 --> 00:15:01,060
.شكرًا يا إساو

262
00:15:01,060 --> 00:15:03,280
إنّ إساو يُعتمد عليه، صحيح؟

263
00:15:15,250 --> 00:15:16,690
.ستكون بخير هنا

264
00:15:16,690 --> 00:15:18,590
.لقد فقدتُ صوابي للحظة

265
00:15:18,590 --> 00:15:19,600
.نعم

266
00:15:19,600 --> 00:15:22,400
.كان من الممكن أن تكون نهاية البلدة

267
00:15:22,400 --> 00:15:23,630
.بالفعل

268
00:15:23,630 --> 00:15:26,280
.إساو هو نجم اليوم

269
00:15:29,390 --> 00:15:32,030
.ما زال مي-كُن محبطًا

270
00:15:32,410 --> 00:15:33,790
.أتساءل ما الخطب

271
00:15:40,290 --> 00:15:42,100
.لقد أخافني ذلك

272
00:15:42,100 --> 00:15:43,290
.ربّما يشعر بالبرد

273
00:15:52,920 --> 00:15:56,390
.ما زال مي-كُن كالطّفل

274
00:15:56,390 --> 00:15:58,930
.عرفتُ أنّ عليّ الاعتناء به

275
00:15:59,630 --> 00:16:02,310
...لكنّ رؤيته يعتني بكوني هكذا

276
00:16:03,060 --> 00:16:04,190
.فهمت

277
00:16:04,680 --> 00:16:07,820
إنّه من النّوع الّذي يحتاج للعناية
.وليس الّذي يعتني بالآخرين

278
00:16:08,530 --> 00:16:10,820
.كان ذلك يزعجه طوال هذا الوقت

279
00:16:11,640 --> 00:16:14,910
لذلك السّبب كان محبطًا
.على ضفّة النّهر أيضًا

280
00:16:20,020 --> 00:16:22,580
.لا بأس يا مي-كُن

281
00:16:26,250 --> 00:16:27,430
.أحسنت

282
00:16:32,260 --> 00:16:34,340
،لم ألاحظ الأمر

283
00:16:34,770 --> 00:16:37,070
.لكنّ مي-كُن يكبر أيضًا

284
00:16:38,230 --> 00:16:39,350
.شكرًا على استضافتي

285
00:16:39,630 --> 00:16:41,160
.أراكما في المدرسة غدًا

286
00:16:41,580 --> 00:16:44,040
.ودّع الجميع يا مي-كُن

287
00:16:44,040 --> 00:16:46,190
.لنقضي بعض الوقت معًا ثانية يا مي-كُن

288
00:17:08,330 --> 00:17:10,560
.لقد مرّ يوم مسالم آخر

289
00:17:14,130 --> 00:17:16,010
.حسنًا، سوف أقوم بغسلك الآن

290
00:17:18,260 --> 00:17:19,190
.حسنًا

291
00:17:19,190 --> 00:17:20,760
.أنت نظيف

292
00:17:21,190 --> 00:17:22,850
.والآن، يمكنك اللّعب بينما تنتظر

293
00:17:24,700 --> 00:17:26,930
.ادخل الحوض إن شعرتَ بالبرد

294
00:17:45,580 --> 00:17:48,520
.هذا الصّغير حسّاس تجاه الحرارة

295
00:17:49,760 --> 00:17:52,300
.كوني، لا تمشي هناك، فقد تسقط

296
00:18:00,490 --> 00:18:03,520
.أكاد أنسى أنّ هذه هي طبيعتك

297
00:18:10,150 --> 00:18:12,800
.حسنًا، انتهيت من الدّراسة

298
00:18:12,800 --> 00:18:14,610
.وقت الاستحمام

299
00:18:15,100 --> 00:18:16,900
.أعتقد أنّني سأستحمّ بعد أن أقرأ قليلاً

300
00:18:36,120 --> 00:18:36,920
.حسنًا

301
00:18:37,640 --> 00:18:38,830
.إساو

302
00:18:38,830 --> 00:18:40,350
.لنستحمّ معًا

303
00:18:41,710 --> 00:18:42,490
ماذا؟

304
00:18:42,490 --> 00:18:44,390
!سبق وأخذت حمّامك بنفسك؟

305
00:18:45,910 --> 00:18:46,930
...وأيضًا

306
00:18:47,150 --> 00:18:51,230
.وهكذا تحوّل جسد الحوريّة إلى رغوة واختفت

307
00:18:52,310 --> 00:18:55,610
نعم، يا لها من حوريّة مسكينة، صحيح؟

308
00:18:56,190 --> 00:19:00,620
أخبرني يا مي-كُن، لماذا لا نقرأ
قصّة "الطّائر الأزرق" قبل النّوم؟

309
00:19:01,680 --> 00:19:03,280
أنت تحبّ تلك القصّة، صحيح؟

310
00:19:04,700 --> 00:19:07,570
وهكذا ذهب تيلتيل وميتيل

311
00:19:07,570 --> 00:19:10,210
.في رحلة للبحث عن الطّائر الأزرق

312
00:19:10,890 --> 00:19:14,050
،وصل الاثنان إلى أرض الذّكريات المحبوبة

313
00:19:14,050 --> 00:19:16,690
.حيث قابلا رجلاً وامرأة عجوزين

314
00:19:17,490 --> 00:19:21,600
،كان الرّجل يغسل الملابس في الجبال

315
00:19:21,600 --> 00:19:25,800
...عندما جرف النّهر معه دُرّاقتين

316
00:19:29,820 --> 00:19:32,830
.آسف، لقد غلبني النّعاس

317
00:19:32,830 --> 00:19:34,600
إلى أين وصلت؟

318
00:19:34,600 --> 00:19:35,860
...حسنًا

319
00:19:36,230 --> 00:19:38,120
،وصل الاثنان إلى أرض الذّكريات المحبوبة

320
00:19:38,120 --> 00:19:40,650
.حيث قابلا رجلاً وامرأة عجوزين

321
00:19:40,650 --> 00:19:44,470
.كان هنالك طائر أزرق بين يديّ الرّجل

322
00:19:44,470 --> 00:19:47,220
،بمجرّد أن غادرا الأرض

323
00:19:47,220 --> 00:19:50,830
.تحوّل الطّائر الأزرق إلى زرافة واختفى

324
00:19:51,360 --> 00:19:55,100
،ثمّ اتّجه الاثنان إلى جزيرة الأوني

325
00:19:55,100 --> 00:19:59,910
.حيث التقيا بقرد وطائر تدرج ودرّاقة

326
00:20:00,290 --> 00:20:03,110
...ومعًا، عاشوا في سعادة

327
00:20:22,180 --> 00:20:23,470
ماذا؟

328
00:20:24,090 --> 00:20:26,470
ماذا تريد؟

329
00:20:28,150 --> 00:20:30,290
.لا توقظني إن كنت لا تحتاج لشيء ما

330
00:20:30,860 --> 00:20:33,280
.الزم الصّمت حتّى الصّباح

331
00:20:40,240 --> 00:20:42,240
ما الّذي دهاك؟

332
00:20:42,800 --> 00:20:45,290
.إن كنتَ تحتاج للاهتمام، فكن صريحًا

333
00:20:45,290 --> 00:20:46,800
.أنت لست ظريفًا أبدًا

334
00:20:48,400 --> 00:20:50,570
.ذلك لا يؤلم على الإطلاق

335
00:21:32,370 --> 00:21:34,600
ما الخطب يا إساو؟

336
00:21:34,600 --> 00:21:36,400
أتريد النّوم إلى جانبي؟

337
00:21:36,710 --> 00:21:39,210
.أنت ظريف للغاية

338
00:21:39,780 --> 00:21:41,280
.لننم معًا

339
00:21:41,760 --> 00:21:43,650
.ليلة سعيدة يا إساو

340
00:23:33,300 --> 00:23:35,970
.مي-كُن، هيّا لنأكل

341
00:23:36,700 --> 00:23:38,060
ماذا؟ بوتشي؟

342
00:23:42,020 --> 00:23:43,150
.مي-كُن

343
00:23:43,150 --> 00:23:45,770
.تعلّمتَ كيف تحكّ ظهرك بنفسك

344
00:23:51,300 --> 00:23:54,200
.يصبح مي-كُن مهتمًّا بالبستنة هذه الأيّام

345
00:23:54,200 --> 00:23:57,220
لقد ألهمته حبّة اللّفت الكبيرة
.في القصّة المصّورة

346
00:23:57,220 --> 00:24:00,090
.لا أطيق الانتظار حتّى وقت الحصاد

347
00:24:00,690 --> 00:24:01,950
."كيف تحتفظ بمومياء"

348
00:24:01,950 --> 00:24:03,430
.ألقاكم الحلقة القادمة

349
00:24:04,630 --> 00:24:07,920
!ألقاكم الحلقة القادمة