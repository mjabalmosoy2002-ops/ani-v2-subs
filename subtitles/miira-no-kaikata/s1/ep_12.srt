.أنّ الكبير يحتوي على أشياء خطيرة

216
00:14:13,910 --> 00:14:17,290
.لهذا السّبب أعطيتَ الصّندوق الأصغر للآلِهة

217
00:14:19,000 --> 00:14:24,000
لا أعتقد أنّ به أيّ شيء سيّئ، لكن
أيمكنكم أن تتراجعوا فقط للحيطة؟

218
00:14:24,170 --> 00:14:25,730
.مـ-مفهوم

219
00:14:40,450 --> 00:14:41,440
...إنّه

220
00:14:47,160 --> 00:14:50,780
من كان يعتقد أنّه ستكون هنالك
عُدّة مهرجان في الدّاخل؟

221
00:14:50,780 --> 00:14:53,300
.لا أصدّق أنّ كلّ هذا اتّسع هناك

222
00:14:53,300 --> 00:14:54,280
.نعم

223
00:14:57,160 --> 00:14:59,190
.تبدون رائعين يا شباب

224
00:14:59,190 --> 00:15:00,670
.الملابس تناسبكم تمامًا

225
00:15:01,050 --> 00:15:02,320
...كايدي-سان

226
00:15:02,320 --> 00:15:04,040
من أين حصلت على هذه؟

227
00:15:04,340 --> 00:15:07,670
.إنّها أزياء من العمل

228
00:15:08,310 --> 00:15:10,130
يوكاتا للرّجال أيضًا؟

229
00:15:10,130 --> 00:15:11,950
.توقّعتُ حدوث أمر كهذا

230
00:15:13,540 --> 00:15:15,750
.لم أرتدِ يوكاتا من قبل

231
00:15:15,750 --> 00:15:17,580
.تبدو أنيقًا به

232
00:15:17,580 --> 00:15:18,730
فعلاً؟

233
00:15:18,730 --> 00:15:20,370
.تبدين ظريفة أيضًا يا موغي-تشان

234
00:15:20,370 --> 00:15:21,490
فعلاً؟

235
00:15:21,490 --> 00:15:22,650
.أجل

236
00:15:23,310 --> 00:15:25,070
ماذا عن كوني والآخرين؟

237
00:15:25,070 --> 00:15:27,910
!حان وقت المهرجان

238
00:15:31,570 --> 00:15:34,070
!ظريفون! ظريفون! ظريفون
!ظريفون! ظريفون

239
00:15:34,070 --> 00:15:37,340
!أروني المزيد

240
00:15:41,400 --> 00:15:44,160
.لا بأس، هذا أشبه بمهرجان حقيقيّ

241
00:15:44,500 --> 00:15:46,590
هل كانت لديكِ هذه أيضًا؟

242
00:15:46,780 --> 00:15:49,340
...كلاّ، سورا-كُن هو من

243
00:15:49,340 --> 00:15:50,590
.أنا من صنعها

244
00:15:50,840 --> 00:15:51,740
!ماذا؟

245
00:15:51,740 --> 00:15:53,030
متى قمتَ بذلك؟

246
00:15:53,030 --> 00:15:55,970
.بينما كانت كايدي-سان تجهّز اليوكاتا

247
00:15:56,200 --> 00:15:59,210
.مواصفاتك عالية للغاية يا سورا-كُن

248
00:15:59,630 --> 00:16:00,730
أتظنّ ذلك؟

249
00:16:02,080 --> 00:16:03,980
أيّها تريد يا موكوموكو؟

250
00:16:05,970 --> 00:16:07,980
حسنًا. هذه، صحيح؟

251
00:16:10,790 --> 00:16:12,980
.والآن، لنرَ ماذا ربحت

252
00:16:19,150 --> 00:16:20,310
ما هذا؟

253
00:16:20,810 --> 00:16:21,640
...لحظة

254
00:16:21,640 --> 00:16:22,710
.الجائزة الكبرى

255
00:16:22,710 --> 00:16:23,450
!الجائزة الكبرى؟

256
00:16:23,450 --> 00:16:24,880
!أحسنت يا موكوموكو

257
00:16:24,880 --> 00:16:27,760
.فوندوشي إيتّان مومن

258
00:16:28,880 --> 00:16:31,150
الجائزة الكبرى هي فوندوشي؟

259
00:16:31,150 --> 00:16:34,200
.إنّه إيتّان مومن بنفسه نوعًا ما

260
00:16:34,450 --> 00:16:36,390
!مهلاً، كلاّ

261
00:16:36,870 --> 00:16:38,520
.لقد طار بعيدًا

262
00:16:43,730 --> 00:16:45,170
ممرّ رماية؟

263
00:16:48,340 --> 00:16:50,650
ماذا؟ الأهداف تتحرّك؟

264
00:16:51,720 --> 00:16:53,270
.إنّها شيكيغامي

265
00:16:53,690 --> 00:16:56,160
.يبدو أنّها ليست معدّة للبشر

266
00:16:56,160 --> 00:16:59,160
.كلاّ، كلاّ، هذا صعب للغاية

267
00:17:02,190 --> 00:17:03,680
تريد اللّعب أوّلاً؟

268
00:17:17,200 --> 00:17:18,280
.اهدأ

269
00:17:30,170 --> 00:17:32,440
هـ-هل أنت بخير يا مي-كُن؟

270
00:17:32,780 --> 00:17:34,550
تريد الجائزة الأولى، صحيح؟

271
00:17:34,900 --> 00:17:36,240
.تمهّل

272
00:17:58,860 --> 00:18:00,910
هكذا إذًا. أعجبتك؟

273
00:18:01,250 --> 00:18:02,470
.جيّد

274
00:18:12,820 --> 00:18:15,270
هل تختار الكرة البرتقاليّة؟

275
00:18:16,550 --> 00:18:18,240
.لنقم بهذا معًا

276
00:18:20,380 --> 00:18:21,490
.أنت بارع بهذا

277
00:18:29,210 --> 00:18:31,250
...استعداد

278
00:18:36,510 --> 00:18:38,380
.أحسنت يا إساو

279
00:18:38,380 --> 00:18:40,020
.حصلت على الكثير

280
00:18:41,970 --> 00:18:43,350
.سوراينو، في فمي

281
00:18:43,350 --> 00:18:44,640
.ضعه في فمي رجاءً

282
00:18:45,970 --> 00:18:47,190
اليويو؟

283
00:18:47,190 --> 00:18:48,070
.نعم

284
00:18:48,070 --> 00:18:51,900
لا أستطيع تنطيطه، لذلك أودّ
.أن أعرف كيف ملمسه

285
00:18:58,760 --> 00:19:01,530
.فهمت، اليويو قد تنفجر

286
00:19:10,410 --> 00:19:11,430
.تازكي

287
00:19:38,530 --> 00:19:41,460
.أتمنّى أن تستمرّ هذه الحياة طويلاً

288
00:19:45,840 --> 00:19:46,880
.مي-كُن

289
00:19:52,290 --> 00:19:53,280
...المعذرة

290
00:19:54,850 --> 00:19:59,020
.أريد زيارة أماكن كثيرًا معكم في عطلة الصّيف

291
00:20:00,320 --> 00:20:02,870
ربّما لن نكون قادرين على الذّهاب
.لأيّ مكان معًا بعد التّخرّج

292
00:20:05,830 --> 00:20:08,690
.ليس هذه السّنة فحسب، بل القادمة أيضًا

293
00:20:10,180 --> 00:20:11,370
.وما بعدها

294
00:20:12,480 --> 00:20:14,270
.رفقة بعضنا، جميعًا

295
00:20:16,160 --> 00:20:18,430
!لا أطيق الانتظار

296
00:20:18,430 --> 00:20:19,610
إلى أين نذهب؟

297
00:20:20,000 --> 00:20:22,570
.أعتقد أنّ البحر هو أنسب مكان لقضاء الصّيف

298
00:20:22,570 --> 00:20:23,830
!بل التّخييم في الجبال

299
00:20:23,830 --> 00:20:25,620
.ستكون الينابيع الحارّة رائعة أيضًا

300
00:20:25,880 --> 00:20:28,720
!أريد شواءً وألعابًا ناريّة

301
00:20:29,530 --> 00:20:31,620
.أصبح هذا ممتعًا

302
00:20:31,930 --> 00:20:34,160
.لنقم بكلّ ذلك

303
00:20:36,210 --> 00:20:38,790
السّنة القادمة والّتي تليها فحسب؟

304
00:20:40,980 --> 00:20:42,260
.بل المزيد إن أمكن

305
00:20:42,840 --> 00:20:43,680
.وأكثر

306
00:20:46,220 --> 00:20:47,220
.نعم

307
00:20:48,210 --> 00:20:50,530
إلى أين تريدان الذّهاب؟

308
00:20:51,120 --> 00:20:52,600
...سأفكّر في ذلك

309
00:20:52,600 --> 00:20:55,020
.أودّ الذّهاب لرؤية الألعاب النّاريّة

310
00:20:55,020 --> 00:20:56,580
.فكرة جيّدة

311
00:20:56,580 --> 00:20:58,040
.سيكون الشّواء جيّدًا أيضًا

312
00:20:58,040 --> 00:20:59,020
.جميل

313
00:20:59,260 --> 00:21:00,930
.أريد أكل الكثير من اللّحم

314
00:21:19,870 --> 00:21:21,990
.لنأكل يا مي-كُن

315
00:21:25,650 --> 00:21:27,130
.وقت الأكل

316
00:21:38,960 --> 00:21:40,580
هل أنت بخير يا مي-كُن؟

317
00:21:51,150 --> 00:21:52,160
.شكرًا

318
00:23:49,820 --> 00:23:52,940
!شكرًا لكم