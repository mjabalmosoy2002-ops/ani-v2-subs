1
00:00:04,810 --> 00:00:07,520
حسناً، لنرَ

2
00:00:07,520 --> 00:00:10,820
إنّها طويلة جدّاً مُقارنة ببقيّة الشخصيّات
لذا هل يمكنكِ أن تقصّريها؟

3
00:00:11,060 --> 00:00:12,720
!معكِ حقّ

4
00:00:14,890 --> 00:00:17,990
لكن تأخّرَ الوقتُ اليوم، لِذا يمكنكِ
المتابعة غداً

5
00:00:18,830 --> 00:00:19,980
حسناً

6
00:00:19,980 --> 00:00:21,030
أنا آسفة

7
00:00:21,960 --> 00:00:26,210
لكن يا أوبا-تشان، مُقارنةً بالمرّات السابقة
صرتِ أسرع بكثير

8
00:00:26,210 --> 00:00:27,190
لا أبداً

9
00:00:27,190 --> 00:00:29,000
ما زلتُ بطيئة جدّاً

10
00:02:08,280 --> 00:02:11,700
أليسَتْ كثافة الأعمال هي ما تدفع
موزوكو-تشان للمجيء إلى العمل يومياً؟

11
00:02:11,700 --> 00:02:14,450
أجل، إنّه ثقيل قليلاً

12
00:02:14,450 --> 00:02:17,350
رُغمَ أنّ هذا يُساهم في زيادة
حجم عضلاتي

13
00:02:19,190 --> 00:02:21,370
عليك أن تتّبع حمية غذائيّة

14
00:02:27,000 --> 00:02:30,180
لقد مضى شهر منذُ انضمامكِ

15
00:02:30,180 --> 00:02:31,020
ما رأيكِ؟

16
00:02:31,020 --> 00:02:32,630
هل تأقلمتِ مع أجواء العمل؟

17
00:02:32,840 --> 00:02:33,840
إطلاقاً

18
00:02:33,840 --> 00:02:36,220
ما زلتُ أتلقّى طلبات بإعادة أعمالي

19
00:02:36,220 --> 00:02:37,630
!لكن هذا ممتع جدّاً

20
00:02:38,860 --> 00:02:41,470
لـ-لماذا التقطتِ تلك الصّورة؟

21
00:02:41,470 --> 00:02:44,250
كانَتْ ابتسامتكِ ممتازة، لهذا كنتُ
مُضطرّة لالتقاطها

22
00:02:44,250 --> 00:02:45,290
كنتِ مضطرّة؟

23
00:02:45,290 --> 00:02:47,320
هذا ليس سبباً كافياً

24
00:02:47,320 --> 00:02:50,010
على ماذا تعملين الآن؟

25
00:02:50,800 --> 00:02:53,360
لقد أوشكتُ على الانتهاء من القرويّة الثّالثة

26
00:02:53,870 --> 00:02:55,770
سأنهيها قريباً على ما أعتقد

27
00:02:56,230 --> 00:02:58,730
هل كنتِ تسعين لتحسينها عمّا سبق إذاً؟

28
00:02:58,730 --> 00:02:59,860
...نعم

29
00:03:00,190 --> 00:03:03,770
،إعادة الأعمال ترهقني كثيراً

30
00:03:03,770 --> 00:03:06,870
لكن مع ذلك أتحسّن في كلّ مرّة أجري
فيها التّغييرات

31
00:03:07,370 --> 00:03:10,320
،وعندما تعطيني ياغامي-سان الموافقة

32
00:03:10,320 --> 00:03:12,230
ينتابُني أفضل شعور على الإطلاق

33
00:03:15,030 --> 00:03:17,500
لا أدري ما إن كان ينبغي أن أقول هذا الكلام

34
00:03:17,740 --> 00:03:18,850
ما هو؟

35
00:03:18,850 --> 00:03:20,440
يمكنكِ أن تخبريني بكلّ شيء

36
00:03:20,440 --> 00:03:21,940
لن أخبر أحداً

37
00:03:22,480 --> 00:03:24,730
أرى أنّه من غير المناسب أن تنام بلباسها الداخليّ

38
00:03:24,730 --> 00:03:26,230
هذا غير مِهَنيّ

39
00:03:27,120 --> 00:03:28,560
أتّفقُ معكِ

40
00:03:29,260 --> 00:03:33,340
،لكن كلّما رأيتُها وهي تعمل

41
00:03:33,340 --> 00:03:36,940
وكلّما عملتُ معها أكثر، أدركُ كم هي مذهلة

42
00:03:37,580 --> 00:03:41,030
لهذا فهي مثَلي الأعلى وإلهامي

43
00:03:43,650 --> 00:03:44,660
هكذا إذاً

44
00:03:51,560 --> 00:03:53,480
أنا وحيدةٌ أخيراً

45
00:03:53,480 --> 00:03:54,330
...حسناً إذاً

46
00:03:58,110 --> 00:04:00,910
!أنا حرّة! أنا حرّة

47
00:04:01,380 --> 00:04:03,150
حرّة من ماذا؟

48
00:04:03,150 --> 00:04:04,600
!ر-ر-رين؟

49
00:04:04,600 --> 00:04:05,760
ما الذي جاءَ بكِ إلى هنا؟

50
00:04:05,760 --> 00:04:07,850
فاتَني القطار الأخير

51
00:04:08,480 --> 00:04:10,460
اشتريتُ شراباً

52
00:04:10,460 --> 00:04:12,600
...شكراً

53
00:04:15,870 --> 00:04:17,930
ينبغي أن تكوني أكثر حذراً

54
00:04:17,930 --> 00:04:20,400
أنتِ محظوظةٌ لأنّني أنا من رأيتكِ

55
00:04:22,360 --> 00:04:24,890
لكن يُشعرُني هذا بالتحرُّرِ فعلاً

56
00:04:24,890 --> 00:04:28,620
لا يوجد سوايّ هنا على أي حال
فلماذا لا تخلعين لباسكِ؟

57
00:04:28,620 --> 00:04:31,620
حتّى لو لم يكن هنا سواكِ، لا يمكن
أن أخلع ملابسي في مكانٍ مخصّص للعمل

58
00:04:35,950 --> 00:04:37,130
!نعم هكذا

59
00:04:37,450 --> 00:04:41,050
أظنُّكِ لديكِ كثير من العُقَد جرّاء النوم هنا

60
00:04:41,260 --> 00:04:44,610
أذهبُ إلى المنزل كلّ يومين

61
00:04:45,660 --> 00:04:49,080
أظنّكِ ينبغي أن تذهبي إلى المنزل كلّ يوم

62
00:04:45,970 --> 00:04:49,560
!مؤلم

63
00:04:56,050 --> 00:04:59,710
النّوم هنا سوية يُشعرنا وكأنّ أمامنا
موعد نهائي لتسليم العمل

64
00:05:00,770 --> 00:05:01,610
معكِ حقّ

65
00:05:01,610 --> 00:05:04,110
سيُصبح المكان أكثر حيويّة هنا قريباً

66
00:05:04,770 --> 00:05:08,870
عملنا هو منع ذلك، صحيح؟

67
00:05:08,870 --> 00:05:10,240
أعلم

68
00:05:14,510 --> 00:05:17,250
أتساءلُ ما إن كانت اللّعبة
ستحقّقُ مبيعات

69
00:05:18,020 --> 00:05:19,500
من يدري؟

70
00:05:19,500 --> 00:05:22,550
لا يهمّني سوى إصدار مُنتَج أفتخرُ به

71
00:05:23,720 --> 00:05:25,380
أنتِ قويّةٌ جدّاً

72
00:05:26,370 --> 00:05:29,350
هل أنتِ متوتّرة بما أنّه مشروعكِ الأوّل
كمُخرجة فنّية؟

73
00:05:31,690 --> 00:05:33,850
قليلاً

74
00:05:35,070 --> 00:05:37,880
غالباً ما أعتقد أنّكِ ستمسين مخرِجة فنّية أفضل

75
00:05:38,480 --> 00:05:42,690
فأنتِ تشكّلين شخصيّة اللّعبة

76
00:05:52,110 --> 00:05:53,390
دعيني أخبركِ بشيء

77
00:05:53,390 --> 00:05:57,370
أستطيعُ التّركيز في كلّ أعمالي بفضلِ إدارتكِ

78
00:05:57,610 --> 00:06:00,900
والخلفيّة مهمّة في أي لعبة فيديو

79
00:06:02,170 --> 00:06:07,010
ناهيكِ عن أنّه لن يصغي إليّ أحد بشخصيّتي هذه

80
00:06:07,410 --> 00:06:10,890
لماذا أنا سلبيّة جدّاً؟

81
00:06:10,890 --> 00:06:13,680
لا يجوز أن تبرزي هذا الجانب لأحد

82
00:06:15,850 --> 00:06:19,400
على أي حال، لا أعلم ما إن كانت
اللّعبة ستحقّقُ مبيعات جيّدة

83
00:06:19,400 --> 00:06:21,440
لكن أظنُّها ستُمسي لعبة جيّدة

84
00:06:22,650 --> 00:06:23,280
نعم

85
00:06:24,030 --> 00:06:25,440
شكراً

86
00:06:26,120 --> 00:06:28,090
،حسناً، بصراحة

87
00:06:28,090 --> 00:06:32,690
إن كانَتْ موظّفتنا الجديدة تستمتعُ
بالعملِ عليها، فسنكونُ بخير

88
00:06:32,690 --> 00:06:35,610
إذ لا يمكن أن يستمتع المرءُ بالعمل
على لعبةٍ مملّة

89
00:06:35,610 --> 00:06:38,580
نعم، يسرُّني أنّ أوبا-تشان فتاة جيّدة

90
00:06:40,310 --> 00:06:45,680
لكن إن أرادَتْ أن تكون مصمّمة، أريدُها
أن تكون أكثر حزماً بكثير

91
00:06:46,170 --> 00:06:49,250
ما تزالُ جديدة فحسب

92
00:06:49,250 --> 00:06:51,000
أعلم

93
00:06:51,000 --> 00:06:53,630
لكن لو كنتُ مكانها، لبحثتُ عن شخصيّة أحبّها

94
00:06:53,630 --> 00:06:56,140
وطلبتُ تصميمها، حتّى لو رُفِضْت

95
00:06:56,380 --> 00:06:57,660
أنتِ وفيّةٌ جدّاً

96
00:06:57,660 --> 00:06:58,600
أنا؟

97
00:06:58,600 --> 00:07:03,560
لكن بصراحة، أظنُّها منشغلة جدّاً بمشروع القرويين

98
00:07:03,780 --> 00:07:07,650
لعلّكِ تستطيعين أن تطلبي منها تصميم
شيء سهل حالما تنتهين من ذلك

99
00:07:07,650 --> 00:07:09,210
نعم

100
00:07:09,210 --> 00:07:12,820
حالما تُنهي تصميم كلّ سكّان القرية
...فقد أكلّفها بمشروع تصميم

101
00:07:19,170 --> 00:07:20,750
ما-ما الأمر؟

102
00:07:20,750 --> 00:07:23,620
تجمّدَ كمبيوتري

103
00:07:23,620 --> 00:07:26,000
أردتُ العودة إلى العمل ولا أستطيع

104
00:07:27,350 --> 00:07:28,210
أهذا كلّ شيء؟

105
00:07:28,440 --> 00:07:30,130
!هذه مصيبة

106
00:07:30,130 --> 00:07:32,620
!لهذا أكرهُ التّصميم ثلاثي الأبعاد

107
00:07:32,620 --> 00:07:33,790
هل ستنامين إذاً؟

108
00:07:33,790 --> 00:07:34,800
لا

109
00:07:34,800 --> 00:07:37,220
لقد احتسيتُ القهوة، لهذا سأعملُ على التّصميم

110
00:07:39,510 --> 00:07:40,490
تبّاً

111
00:07:42,360 --> 00:07:43,730
لا تجهدي نفسكِ

112
00:07:43,730 --> 00:07:45,510
سأخلد إلى النّوم

113
00:07:45,510 --> 00:07:47,680
حسناً، تصبحين على خير

114
00:08:17,150 --> 00:08:18,680
هل طلعَ الصّباح؟

115
00:08:20,520 --> 00:08:22,520
تكشف عن لباسِها الداخليّ مجدّداً

116
00:08:25,540 --> 00:08:27,610
كو-تشان، ستُصابين بنزلة برد

117
00:08:40,770 --> 00:08:43,120
أتساءلُ إن كانَتْ تشعرُ بالتحرُّر فعلاً

118
00:08:52,240 --> 00:08:52,930
نعم

119
00:08:55,260 --> 00:08:56,980
هذا شعورٌ رائعٌ فعلاً

120
00:08:59,010 --> 00:09:00,570
رأيتُه

121
00:09:04,540 --> 00:09:05,950
!الأمر ليس كما تعتقدين

122
00:09:05,950 --> 00:09:08,650
ما الذي أفكّر به؟

123
00:09:08,650 --> 00:09:10,150
!دعيني أشرح

124
00:09:10,450 --> 00:09:12,490
ينبغي أن تكوني أكثر حذراً

125
00:09:12,490 --> 00:09:15,690
أنتِ محظوظةٌ لأنّني كنتُ أنا من رآكِ

126
00:09:21,650 --> 00:09:23,370
صباح الخير

127
00:09:23,370 --> 00:09:24,020
اختبئي

128
00:09:24,020 --> 00:09:25,310
إنّها أوبا-تشان

129
00:09:26,000 --> 00:09:28,340
تبّاً، لِمَ عليّ الاختباء؟

130
00:09:35,800 --> 00:09:38,250
لنبدأ بالعمل بجدٍّ ونشاط

131
00:09:39,220 --> 00:09:40,940
"قالَتْ "جدّ ونشاط

132
00:09:46,210 --> 00:09:48,940
أتساءلُ ما إن بقيت ياغامي-سان اللّيلة مجدّداً

133
00:09:57,150 --> 00:09:59,070
صباح الخير

134
00:09:59,070 --> 00:10:01,330
—هل نمتِ هنا مجدّداً

135
00:10:09,600 --> 00:10:11,520
!أ-أنا آسفة

136
00:10:11,090 --> 00:10:11,830
!الأمر ليس كما تعتقدين

137
00:10:11,830 --> 00:10:13,480
!الأمر ليس كما تعتقدين يا أوبا-تشان

138
00:10:13,900 --> 00:10:15,270
!لم أرَ شيئاً

139
00:10:15,270 --> 00:10:16,410
لن أخبر أحداً

140
00:10:16,410 --> 00:10:17,410
!لا! لا! لا

141
00:10:17,410 --> 00:10:18,970
!لن أخبر أحداً

142
00:10:22,570 --> 00:10:23,510
هيفومي-تشان

143
00:10:24,160 --> 00:10:25,020
تفضّلي

144
00:10:28,370 --> 00:10:31,260
يون-تشان، أحسنتِ صنعاً هذا الشّهر

145
00:10:31,260 --> 00:10:32,910
شكراً لكِ

146
00:10:34,760 --> 00:10:35,530
هاجيمي-تشان

147
00:10:36,010 --> 00:10:37,130
!نعم؟

148
00:10:37,130 --> 00:10:39,010
واصلي عملكِ الدّؤوب

149
00:10:39,010 --> 00:10:40,410
!سأفعلُ ما بوسعي

150
00:10:41,010 --> 00:10:42,190
أوبا-تشان

151
00:10:42,190 --> 00:10:43,090
نعم؟

152
00:10:43,090 --> 00:10:44,090
تفضّلي

153
00:10:45,120 --> 00:10:47,410
ما هذا؟

154
00:10:47,740 --> 00:10:49,370
إنّه بيان بصرفِ راتبكِ

155
00:10:48,390 --> 00:10:50,400
كم؟ كم؟ كم؟

156
00:10:49,630 --> 00:10:51,500
اطّلعي عليه لاحقاً

157
00:10:51,960 --> 00:10:53,970
ر-راتبي؟

158
00:10:54,480 --> 00:10:56,480
هذا راتبكِ الأوّل، أليس كذلك؟

159
00:10:56,480 --> 00:10:57,350
!نعم

160
00:10:57,350 --> 00:11:00,480
لم أعمل في دوام جزئي من قبل أيضاً
لهذا هو عملي الأوّل فعلياً

161
00:11:00,480 --> 00:11:04,760
إذاً عندما تجرون عمليّة إيداع
مُباشرة، أتلقّى بياناً بصرف راتب فحسب؟

162
00:11:06,230 --> 00:11:09,550
لأنّني عندما أسمعُ بكلمة راتب
أقولُ لنفسي

163
00:11:09,750 --> 00:11:11,760
"!سوف تمتلئ جيبتي في هذا الشّهر"

164
00:11:11,760 --> 00:11:16,510
أو "أنا فقيرة" بحسبِ وزن الظرف

165
00:11:16,510 --> 00:11:19,150
أوبا-تشان، هل أنتِ في الثّامنة عشر فعلاً؟

166
00:11:27,640 --> 00:11:32,310
لـ-لكن... هل يحقُّ لي الحصول على راتبي فعلاً؟

167
00:11:32,800 --> 00:11:37,350
هذا كُل ما فعلتُه، وحتّى أنّني
تلقّيتُ إضافياً

168
00:11:37,350 --> 00:11:42,300
أنتِ تسهرين اللّيل كلّه يومياً
لِذا لا تكوني متحفِّظة

169
00:11:42,610 --> 00:11:43,390
هذا صحيح

170
00:11:43,730 --> 00:11:48,660
عليكِ إذاً أن تعملي بجدٍّ كي تصبحي سريعة جدّاً

171
00:11:48,660 --> 00:11:49,640
!حـ-حسناً

172
00:11:50,140 --> 00:11:53,330
،وحالما تُدرك الشركة مهاراتكِ

173
00:11:53,330 --> 00:11:56,050
!ستحصلين على زيادة راتب

174
00:11:56,550 --> 00:11:59,210
هاجيمي-سان، هل حصلتِ على زيادة راتب؟

175
00:11:59,210 --> 00:12:00,680
وما أدراكِ؟

176
00:12:00,680 --> 00:12:02,300
مع أنّ الزيادة ليسَتْ بكبيرة

177
00:12:02,300 --> 00:12:05,410
أنتِ تنفقينه كلّه على الدُّمى
التي تضعينها على مقعدكِ

178
00:12:06,100 --> 00:12:08,170
من يأبه؟

179
00:12:08,170 --> 00:12:09,670
أستخدمها كمرجع

180
00:12:09,670 --> 00:12:11,830
وتستخدمها ياغامي-سان كثيراً أيضاً

181
00:12:12,420 --> 00:12:13,500
!بخاصّة هذه

182
00:12:13,910 --> 00:12:15,350
تحبّين هذا حقّاً، أليس كذلك؟

183
00:12:15,350 --> 00:12:17,380
رُغم أنّه عديم الجدوى

184
00:12:17,380 --> 00:12:18,770
عمّاذا تتكلّمين؟

185
00:12:18,770 --> 00:12:20,700
روعته بحدِّ ذاتها تجعله قيّماً

186
00:12:20,700 --> 00:12:24,260
من المهمّ العمل بطاقةٍ ونشاط وحيويّة على ما أعتقد

187
00:12:25,500 --> 00:12:27,680
وحتّى أنّني أمتلكُ سيفاً غربيّ الطراز

188
00:12:28,420 --> 00:12:30,480
لديكِ كلّ شيء

189
00:12:30,480 --> 00:12:32,570
أوبا-تشان، أمسكيه. أتحدّاكِ

190
00:12:35,000 --> 00:12:38,020
رائع، إنّه رفيع، لكنّه ثقيل جدّاً

191
00:12:38,250 --> 00:12:39,120
أليس كذلك؟

192
00:12:39,120 --> 00:12:40,650
كلّه معدنيّ

193
00:12:40,980 --> 00:12:42,850
...أنا متفاجئة من قدرتكِ

194
00:12:42,850 --> 00:12:44,930
.على التّلويح به

195
00:12:50,620 --> 00:12:52,870
!أ-أنا آسفة جدّاً

196
00:12:52,870 --> 00:12:54,410
لا مشكلة

197
00:12:54,410 --> 00:12:57,170
رائع، أنقذ حياتكِ

198
00:13:00,530 --> 00:13:03,710
،تحصلين على زيادة راتب مرّة في العام

199
00:13:03,710 --> 00:13:06,680
لِذا قد تحصلين على زيادة راتب في العام المقبل

200
00:13:06,900 --> 00:13:10,600
هل يتمُّ تقييمي كموظّفة جيّدة إذا أنتجتُ
عملاً ذا جودة عالية؟

201
00:13:10,910 --> 00:13:16,600
بما أنّكِ ما زلتِ في بداياتكِ، عليكِ
أن تكملي العمل الذي كلّفتِ به

202
00:13:17,050 --> 00:13:19,520
لكن يتمُّ تقييمكِ أيضاً بحسب

203
00:13:19,520 --> 00:13:22,530
مساهماتكِ في الفريق إضافة إلى عملكِ الخاصّ

204
00:13:22,530 --> 00:13:26,990
بالمناسبة، قائدتكِ كو-تشان هي التي تقيّم فريق الشخصيّات

205
00:13:26,990 --> 00:13:30,120
وأنا أيضاً، المخرجة الفنّية

206
00:13:30,340 --> 00:13:31,480
مُساهمات؟

207
00:13:31,480 --> 00:13:33,480
يبدو الأمر معقّداً

208
00:13:33,480 --> 00:13:34,550
ربّما

209
00:13:34,550 --> 00:13:38,040
لكن حالياً، افعلي ما تعتقدين أنّه مفيد فحسب

210
00:13:38,040 --> 00:13:39,130
،لكن أتعلمين

211
00:13:39,850 --> 00:13:44,030
كنتُنَّ تواجهن وقتاً عصيباً مع ياغامي-سان
باعتبارها صارمة في العمل

212
00:13:44,030 --> 00:13:45,880
تقولين هذا الكلام وكأنّه لا ينطبقُ عليكِ

213
00:13:46,090 --> 00:13:47,390
آه صحيح

214
00:13:47,390 --> 00:13:50,800
ياغامي-سان ليست قائدة فريق التّحريك

215
00:13:51,430 --> 00:13:51,890
لحظة

216
00:13:52,220 --> 00:13:56,170
لماذا أنتِ في هذا الكشك رُغمَ أنّكِ جزء من فريق التّحريك؟

217
00:14:00,420 --> 00:14:01,740
أنا آسفة

218
00:14:01,740 --> 00:14:05,150
أريدُ أن أكون مع فريقي أيضاً

219
00:14:05,150 --> 00:14:05,860
أنا آسفة

220
00:14:06,250 --> 00:14:09,100
لم تعد هنالك مساحات في أكشاك فريق التّحريك

221
00:14:09,100 --> 00:14:10,620
لكن يوجدُ كشكٌ واحدٌ فقط هنا

222
00:14:13,640 --> 00:14:17,120
بالمناسبة، هل تعرفين كيف تنفقين راتبكِ الأوّل؟

223
00:14:17,120 --> 00:14:19,780
لا أعرف

224
00:14:19,780 --> 00:14:21,840
لم يسبق أن فكّرتُ بهذا

225
00:14:22,330 --> 00:14:24,210
كيف أنفقَه الجميع؟

226
00:14:25,420 --> 00:14:28,760
اشتري دُمية شخصيّة لتجعليها تذكاريّة

227
00:14:28,760 --> 00:14:30,140
عادَتْ إلى حيويّتها الكاملة

228
00:14:30,670 --> 00:14:32,570
أنا اشتريتُ ملابس

229
00:14:32,570 --> 00:14:35,140
بذّرتُ كثيراً للشراء من شركة جيّدة

230
00:14:35,490 --> 00:14:37,140
الملابس هي خيار جيّد

231
00:14:37,410 --> 00:14:38,980
هـ-هازوكي-سان

232
00:14:38,980 --> 00:14:42,010
أتساءلُ ما الذي يليقُ بكُنّ جميعاً

233
00:14:42,530 --> 00:14:44,490
هذا الشّاي لذيذ

234
00:14:44,490 --> 00:14:46,440
شكراً لكِ

235
00:14:47,070 --> 00:14:50,280
هازوكي-سان، ماذا اشتريتِ براتبكِ الأوّل؟

236
00:14:50,560 --> 00:14:53,150
لا أعرف

237
00:14:54,250 --> 00:14:58,710
تقايضتُه منذُ زمن بعيد، لهذا لا أتذكّر جيّداً

238
00:14:58,710 --> 00:15:01,250
كم عمركِ إذاً؟

239
00:15:02,900 --> 00:15:04,170
!هاجيمي

240
00:15:04,170 --> 00:15:06,010
هذا موضوعٌ حسّاس

241
00:15:06,010 --> 00:15:06,820
ماذا؟

242
00:15:06,820 --> 00:15:08,010
أشعرُ بالفضول

243
00:15:09,310 --> 00:15:10,380
...لنرَ

244
00:15:10,820 --> 00:15:14,760
...توقّفتُ عن احتساب عمري بعد العشرين، لذا

245
00:15:15,290 --> 00:15:18,110
لنقل أنّني في العشرينات

246
00:15:18,110 --> 00:15:19,940
لستِ في مقعدكِ

247
00:15:19,940 --> 00:15:22,360
كان ينبغي أن أتوقّع أن أعثر عليكِ تتسكّعين

248
00:15:22,360 --> 00:15:23,800
مرحباً يا أوميكو-كن

249
00:15:23,800 --> 00:15:25,400
،لا ضير من أخذ قسط من الرّاحة

250
00:15:25,400 --> 00:15:29,170
لكن ماذا حدثَ للمُستندات التي طلبتُ
منكِ الاطّلاع عليها؟

251
00:15:29,920 --> 00:15:30,900
لقد نسيت

252
00:15:31,360 --> 00:15:33,410
دعيني أكمل استراحتي فحسب

253
00:15:33,410 --> 00:15:35,640
،إن كان هُناك من يشعر بالفضول لمعرفة عمر هازوكي-سان

254
00:15:35,640 --> 00:15:37,560
أستطيعُ مُساعدته

255
00:15:37,990 --> 00:15:39,710
هل نذهبُ يا أوميكو-كن؟

256
00:15:39,710 --> 00:15:42,340
فالوقت ثمين

257
00:15:42,340 --> 00:15:43,540
يا إلهي

258
00:15:43,540 --> 00:15:45,130
هيّا بنا

259
00:15:45,130 --> 00:15:46,710
إلى اللّقاء

260
00:15:47,190 --> 00:15:49,740
في العشرينات من العمر

261
00:15:49,740 --> 00:15:52,150
حسناً، عمّاذا كنّا نتكلّم؟

262
00:15:53,120 --> 00:15:55,570
راتبكِ الأوّل

263
00:15:55,570 --> 00:15:57,000
هذا صحيح

264
00:15:57,000 --> 00:15:58,970
ماذا ستفعلين به يا أوبا-تشان؟

265
00:16:01,910 --> 00:16:04,120
أظنّني سأدخّره

266
00:16:04,120 --> 00:16:06,020
إنّها واقعيّة جدّاً

267
00:16:06,510 --> 00:16:08,910
كيف أنفقتِه يا توياما-سان؟

268
00:16:08,910 --> 00:16:09,970
أنا؟

269
00:16:10,500 --> 00:16:11,620
...أنا

270
00:16:11,620 --> 00:16:13,570
عمّاذا تتكلّمن يا فتيات؟

271
00:16:14,030 --> 00:16:17,900
كنتُ أسألُ توياما-سان كيف أنفقَتْ
راتبها الأوّل

272
00:16:17,900 --> 00:16:20,320
أريدُ أن أعرف أيضاً

273
00:16:20,320 --> 00:16:21,750
كيف ستُنفقينه؟

274
00:16:22,980 --> 00:16:24,210
ألا تتذكّرين؟

275
00:16:24,210 --> 00:16:25,460
!أنتِ غير معقولة

276
00:16:27,510 --> 00:16:28,960
هل فعلنا شيئاً؟

277
00:16:33,020 --> 00:16:34,800
لماذا أنتِ غاضبة جدّاً؟

278
00:16:35,130 --> 00:16:37,000
!مؤلم

279
00:16:37,000 --> 00:16:39,700
قضينا نزهةً يوميّة في نبع ساخن معاً

280
00:16:39,700 --> 00:16:42,120
!هذا صحيح! هذا صحيح

281
00:16:43,630 --> 00:16:46,810
تبّاً، لا داعي للغضبِ من مجرّد نزهة

282
00:16:46,810 --> 00:16:47,830
مجرّد نزهة؟

283
00:16:47,830 --> 00:16:50,030
اخترنا المكان وكلّ شيء معاً

284
00:16:50,030 --> 00:16:52,110
!الآن تذكّرت

285
00:16:53,290 --> 00:16:55,780
هل تتذكّرين إذاً إلى أين ذهبنا؟

286
00:17:02,470 --> 00:17:03,290
!كو-تشان

287
00:17:04,770 --> 00:17:07,100
إنّها مقرّبتان جدّاً

288
00:17:07,100 --> 00:17:09,160
انضممتا معاً أيضاً

289
00:17:09,160 --> 00:17:12,760
لا بدّ وأنّه من الموحش قليلاً أن تكوني
الموظّفة الجديدة الوحيدة في هذا العام

290
00:17:12,760 --> 00:17:14,550
أجل

291
00:17:14,940 --> 00:17:20,060
لكن لستُ منزعجة كثيراً بما أنّني أشعرُ
وكأنّنا جميعاً في نفس السنّ

292
00:17:20,490 --> 00:17:21,620
ماذا تقولين؟

293
00:17:21,620 --> 00:17:26,560
نتصرّفُ بصبيانيّة أكثر أمامكِ كي نتقرّب من بعضنا الآخر

294
00:17:26,820 --> 00:17:27,900
هذا صحيح

295
00:17:28,110 --> 00:17:30,010
ماذا؟ حقّاً؟

296
00:17:30,010 --> 00:17:32,150
لم أكن أعلمُ بذلك أيضاً

297
00:17:32,150 --> 00:17:34,650
هيفومي-سينباي، هل انضممتِ مع أحد ما؟

298
00:17:36,290 --> 00:17:38,910
أجل، في فريق آخر

299
00:17:39,140 --> 00:17:43,410
من المُؤسِف أن تتفرّقا

300
00:17:44,840 --> 00:17:45,770
ليس تماماً

301
00:17:46,450 --> 00:17:47,750
أنا قليلةُ الكلام

302
00:17:47,750 --> 00:17:50,410
آه هذا صحيح

303
00:17:51,030 --> 00:17:54,010
بالمناسبة، كيف أنفقتِ راتبكِ الأوّل؟

304
00:17:56,780 --> 00:17:57,550
...بلاي

305
00:18:00,540 --> 00:18:02,890
أزياء الكوزبلاي

306
00:18:04,560 --> 00:18:05,480
حقّاً؟

307
00:18:05,480 --> 00:18:06,480
هل لديكِ صور؟

308
00:18:12,630 --> 00:18:13,480
لن أتكلّم

309
00:18:15,380 --> 00:18:18,040
حـ-حسناً، الادّخار جيّد

310
00:18:18,040 --> 00:18:22,040
لكن أعتقد أنّ القيام بشيء تذكاريّ أمر جيّد أيضاً

311
00:18:23,720 --> 00:18:26,330
رُغم أنّ بعض الناس سينسونه على أي حال

312
00:18:30,690 --> 00:18:32,880
لكنّك على حقّ

313
00:18:32,880 --> 00:18:34,630
سأفكّرُ بشيء

314
00:18:38,310 --> 00:18:41,600
كيف ينبغي أن أنفق راتبي الأوّل؟

315
00:18:47,600 --> 00:18:48,750
!حسناً

316
00:18:48,750 --> 00:18:49,850
!انتهيت

317
00:18:49,850 --> 00:18:51,780
حان وقتُ شراء دُمى الشخصيّات

318
00:18:51,780 --> 00:18:53,230
أتشترين المزيد؟

319
00:18:54,710 --> 00:18:55,800
غيرانة؟

320
00:18:55,800 --> 00:18:58,140
لم أسأل بدافع الغيرة

321
00:19:00,160 --> 00:19:03,240
لكن قد أشتري شيئاً في طريق عودتي إلى المنزل أيضاً

322
00:19:04,850 --> 00:19:07,060
أوبا-تشان، يمكنكِ المغادرة الآن

323
00:19:07,060 --> 00:19:09,560
ينبغي أن تنتهزي الفرصة وتغادري باكراً اليوم

324
00:19:09,560 --> 00:19:11,680
شكراً لكِ، سأفعلُ ذلك

325
00:19:22,800 --> 00:19:24,760
ماذا ينبغي أن أفعل يا تُرى؟

326
00:19:30,430 --> 00:19:32,270
...ملابس

327
00:19:35,530 --> 00:19:41,520
أجل، اشترى لي والدايّ هذه البدلة

328
00:19:41,520 --> 00:19:43,100
كانَتْ باهظة الثّمن أيضاً

329
00:19:45,250 --> 00:19:46,110
حسناً

330
00:19:47,480 --> 00:19:49,040
!لقد عُدت

331
00:19:49,430 --> 00:19:51,180
أهلاً بعودتكِ

332
00:19:51,180 --> 00:19:53,500
الحمّام جاهز، لِذا ينبغي أن تدخلي

333
00:19:53,500 --> 00:19:54,640
حسناً

334
00:19:55,930 --> 00:19:58,560
آمل أن تنال إعجابهما

335
00:20:00,160 --> 00:20:01,270
!مفاجأة

336
00:20:01,270 --> 00:20:04,700
تقاضيتُ راتبي الأوّل اليوم، لهذا اشتريتُ كعكاً

337
00:21:42,910 --> 00:21:43,970
رين

338
00:21:43,970 --> 00:21:45,690
أما زلتِ غاضبة؟

339
00:21:45,690 --> 00:21:46,750
لا

340
00:21:46,750 --> 00:21:48,250
لستُ غاضبة على الإطلاق

341
00:21:48,250 --> 00:21:50,120
أنا آسفة

342
00:21:50,120 --> 00:21:53,580
نسيتُ أمر النّبع الساخن تماماً فحسب

343
00:21:53,950 --> 00:21:55,520
لا يهمّني

344
00:21:55,520 --> 00:22:01,590
ربّما نزهتنا الأولى معاً لم تعنِ
لكِ شيئاً على أي حال

345
00:22:04,510 --> 00:22:05,380
أنا أمزح فقط

346
00:22:05,900 --> 00:22:07,490
أنا آسفة يا كو-تشان

347
00:22:07,490 --> 00:22:09,090
صدّقيني لستُ غاضبة

348
00:22:09,640 --> 00:22:10,480
أعلم

349
00:22:10,480 --> 00:22:12,600
لنذهب إلى مكانٍ لطيفٍ معاً في الحال

350
00:22:26,600 --> 00:22:29,860
لطالما أردتُ المجيء إلى هذا الحمّام البخاري

351
00:22:30,320 --> 00:22:33,120
ما الذي أصابك اليوم؟

352
00:22:34,540 --> 00:22:38,300
حسناً، كنتِ تقولين أنّكِ متوتّرة
من المسؤوليّة كمُخرِجة فنّية

353
00:22:38,300 --> 00:22:41,630
من الأفضل الاسترخاء قليلاً بمياه ساخنة أوّلاً

354
00:22:43,020 --> 00:22:44,690
شكراً يا كو-تشان

355
00:22:54,370 --> 00:22:56,640
ما-ماذا؟ ما الأمر؟

356
00:22:57,780 --> 00:23:01,150
...لا، كلّ ما في الأمر... رين

357
00:23:03,990 --> 00:23:05,440
هل سمنتِ؟

358
00:23:10,360 --> 00:23:14,000
...أجل، هذه الذراع العلويّة تبدو

359
00:23:15,660 --> 00:23:16,630
رين؟

360
00:23:22,570 --> 00:23:23,670
!كو-تشان

361
00:23:25,690 --> 00:23:28,580
أوبا-تشان، اشتريتِ كعكاً لوالديكِ؟

362
00:23:28,580 --> 00:23:29,230
أجل

363
00:23:29,230 --> 00:23:30,760
لقد بكى أبي

364
00:23:30,760 --> 00:23:33,390
يشعرُ كلّ أب بالسعادة عندما تقومُ
ابنته بعملٍ لطيف

365
00:23:33,390 --> 00:23:35,690
لكن أمّي أكلَت الكعكة عندما كان يبكي

366
00:23:35,690 --> 00:23:37,100
والداكِ مُسلّيان

367
00:23:37,100 --> 00:23:39,930
الحلقة القادمة: أهذا هو عدد اللّيالي التي علينا أن نسهر فيها؟"

368
00:23:37,100 --> 00:23:41,000
في الحلقة القادمة