1
00:00:02,850 --> 00:00:07,370
كنتُ في المدرسة الابتدائيّة عندما لعبتُ
قصّة الجنّيات لأوّل مرّة

2
00:00:09,050 --> 00:00:12,280
أثّرَتْ بي القصّة وهيمن عليّ عالم اللّعبة

3
00:00:12,870 --> 00:00:16,740
لكن زدتُ ولعاً بالشخصيات الجميلة على وجه التّحديد

4
00:00:18,050 --> 00:00:22,310
حينئذ علمتُ بمهنة تصميم الشخصيات

5
00:00:23,530 --> 00:00:27,650
مصمّمة شخصيّات هذه اللّعبة كانت تُدعى ياغامي كو

6
00:00:28,930 --> 00:00:30,190
ياغامي كو

7
00:00:30,770 --> 00:00:32,610
...بالنسبة لي، هذا الاسم

8
00:00:33,440 --> 00:00:35,330
!له معنى خاصّ

9
00:02:06,830 --> 00:02:08,680
اسمي سوزوكازي أوبا

10
00:02:08,680 --> 00:02:11,770
انضممتُ لشركة ألعاب منذُ أسبوع

11
00:02:12,370 --> 00:02:14,410
اسم الشّركة هو إيغل جامب

12
00:02:14,930 --> 00:02:20,180
والمفاجأة أنّني تلقّيتُ ترحيباً من قِبَل الفريق
الذي يصنعُ لعبة قصّة الجنّيات 3

13
00:02:43,330 --> 00:02:44,890
صباح الخير

14
00:02:44,890 --> 00:02:46,560
صباح النّور

15
00:02:47,980 --> 00:02:52,090
هذه السيّدة التي كانت نائمة تحت المكتب
هي ياغامي كو-سان

16
00:02:52,090 --> 00:02:55,820
إنّها مجدّة في العمل ويبدو أنّها
سهرت اللّيل في العمل

17
00:02:56,880 --> 00:03:01,380
أريد أن أصبح مصمّمة شخصيّات مثلها يوماً ما

18
00:03:01,380 --> 00:03:03,580
هذا هو هدفي الحالي

19
00:03:05,220 --> 00:03:06,120
...لكن

20
00:03:06,120 --> 00:03:10,190
لا أنوي النّوم بلباسي الدّاخلي كما تفعل هي

21
00:03:10,190 --> 00:03:11,550
كفّي عن التحديق

22
00:03:11,550 --> 00:03:12,540
كو-تشان

23
00:03:13,000 --> 00:03:15,840
لا تكوني مثالاً سيّئاً للعاملات الأخريات

24
00:03:15,840 --> 00:03:17,590
أيّاً يكن

25
00:03:19,680 --> 00:03:21,350
صباح الخير يا أوبا-تشان

26
00:03:21,350 --> 00:03:23,390
صباح الخير لكِ أيضاً

27
00:03:23,870 --> 00:03:26,330
إنّها توياما رين-سان، مُخرِجة فنّية

28
00:03:25,290 --> 00:03:27,060
أين سروالي؟

29
00:03:26,330 --> 00:03:30,060
عمل المُخرِجة الفنّية هو إدارة كافّة
الأعمال الفنّية ذات الصّلة

30
00:03:27,060 --> 00:03:30,060
يا إلهي، نظّفيها

31
00:03:31,830 --> 00:03:35,650
رين-سان وياغامي-سان انضمّتا للشركة
في نفس الوقت وهما صديقتان مُقرّبتان

32
00:03:32,290 --> 00:03:34,420
هل يمكنني رمي هذه؟

33
00:03:34,420 --> 00:03:36,150
شكراً

34
00:03:36,150 --> 00:03:39,650
أنا الموظّفة الجديدة الوحيدة هذا العام
لهذا أشعرُ بالغيرة قليلاً

35
00:03:39,650 --> 00:03:42,150
!صباح الخير

36
00:03:42,550 --> 00:03:43,790
أوبا-تشان، انظري

37
00:03:43,790 --> 00:03:46,740
!حصلتُ على العصا الجديدة من مون رينجر

38
00:03:47,010 --> 00:03:49,000
هـ-هذا مذهل

39
00:03:49,000 --> 00:03:51,750
هنالك عشرون اقتباساً مختلفاً في هذا الشيء

40
00:03:52,110 --> 00:03:55,850
إنّها مُصمَّمة ومُصنَّعة بإتقان كبير

41
00:03:52,750 --> 00:03:54,970
إنّها شينودا هاجيمي-سان التي تعمل في فريق التّحريك

42
00:03:54,970 --> 00:03:57,100
تجلسُ بجانبي

43
00:03:55,850 --> 00:03:58,670
!كانت باهظة الثمن، لكنّها تستحقّ ذلك قطعاً

44
00:03:57,100 --> 00:03:58,670
إنّها فتاةٌ متألّقة ومُفعمة بالحيويّة

45
00:03:58,900 --> 00:04:00,550
صباح الخير

46
00:03:59,160 --> 00:04:01,720
...أترين؟ عندما تلوحّين بها

47
00:04:05,590 --> 00:04:06,240
مؤلم

48
00:04:06,240 --> 00:04:06,980
!يا للهول

49
00:04:06,980 --> 00:04:08,250
!أنا آسفة يا يون

50
00:04:08,250 --> 00:04:09,350
!يون-سان

51
00:04:09,940 --> 00:04:11,160
إيجيما يون-سان

52
00:04:11,160 --> 00:04:12,900
تعملُ في فريق الشخصيات معي

53
00:04:12,900 --> 00:04:16,590
انضمَّتْ مع هاجيمي-سان، وهي بمثابة أخت كبرى مسؤولة

54
00:04:17,450 --> 00:04:19,370
لماذا تتحمّسين كثيراً في مثل هذه الفترة الصباحيّة؟

55
00:04:19,370 --> 00:04:20,560
أنا آسفة

56
00:04:20,560 --> 00:04:22,530
لقد تحمّست

57
00:04:23,580 --> 00:04:24,570
!أوه

58
00:04:25,850 --> 00:04:29,120
أشعرُ برغبةٍ في التّلويح بها أيضاً

59
00:04:29,120 --> 00:04:30,400
!على رسلكِ

60
00:04:32,810 --> 00:04:34,420
صباح الخير

61
00:04:34,910 --> 00:04:36,860
صباح النّور

62
00:04:42,760 --> 00:04:44,970
إنّها تاكيموتو هيفومي-سان، في فريق الشخصيّات أيضاً

63
00:04:45,470 --> 00:04:48,130
انضمّتْ قبل هاجيمي-سان ويون-سان

64
00:04:48,130 --> 00:04:50,420
،قلّما تتكلّم أو تبتسم

65
00:04:50,420 --> 00:04:54,570
لكنّها لطيفة جدّاً وتُجيب على أسئلتي
من خلال الرّسائل الخاصّة

66
00:04:55,930 --> 00:04:58,970
بالمناسبة، بُنية فريقنا هي على الشّكل الآتي

67
00:04:59,970 --> 00:05:02,070
المُخرجة مسؤولة عن كلّ شيء

68
00:05:02,380 --> 00:05:08,340
يتألّف الفريق الفنّي من فرق التّحريك
والمؤثّرات والشخصيّات والخلفيّات

69
00:05:08,840 --> 00:05:12,580
ياغامي-سان هي أيضاً قائد فريق الشخصيّات

70
00:05:18,270 --> 00:05:20,300
...موزوكو-تشان

71
00:05:21,020 --> 00:05:24,280
توقّفي، لا أستطيع العمل

72
00:05:27,100 --> 00:05:29,600
"قولي "أنا آسفة

73
00:05:30,010 --> 00:05:31,930
تبدين خبيرة

74
00:05:31,930 --> 00:05:33,210
!أنا آسفة للغاية

75
00:05:33,210 --> 00:05:34,770
ألعبُ بقطّتكِ

76
00:05:34,770 --> 00:05:36,340
لا يهمّني

77
00:05:36,340 --> 00:05:39,150
موزوكو هي المخطئة لأنّها عرقلت عملكِ

78
00:05:39,150 --> 00:05:43,780
في الواقع، ينبغي أن تؤدّبيني أنا بصفتي مالكتها أيضاً

79
00:05:44,650 --> 00:05:46,350
أمزح

80
00:05:46,350 --> 00:05:49,600
هيّا، لا تعترضي طريقها يا موزوكو

81
00:05:51,590 --> 00:05:53,140
هازوكي شيزوكو-سان

82
00:05:53,140 --> 00:05:57,530
...إنّها مخرجة قصّة الجنّيات 3، لكن

83
00:05:58,430 --> 00:06:01,170
الغريب أنّها لا تتصرّف على هذا المنوال

84
00:06:03,040 --> 00:06:07,930
اختارت شيزوكو-سان اسمَ موزوكو-تشان
لأنّه بدا لطيفاً

85
00:06:09,320 --> 00:06:10,430
أوبا-تشان

86
00:06:11,010 --> 00:06:12,380
ماذا تفعلين على الغداء؟

87
00:06:13,010 --> 00:06:15,350
سنشتري غداء مُعلّباً

88
00:06:15,910 --> 00:06:18,480
،أوشكتُ أن أنهي هذا الجزء

89
00:06:18,480 --> 00:06:19,770
لذا سأكمله

90
00:06:19,990 --> 00:06:21,050
هكذا إذاً

91
00:06:21,050 --> 00:06:24,100
لكن الأكل مهمّ

92
00:06:24,100 --> 00:06:27,280
ينبغي أن تأكلي أكلة خفيفة كهذه على الأقلّ

93
00:06:27,740 --> 00:06:29,920
!سأردّ لكِ الجميل يوماً ما

94
00:06:29,920 --> 00:06:31,870
يمكنكِ أن تشتري لي غداءً في وقت ما

95
00:06:31,870 --> 00:06:33,170
هل أنتِ جادّة؟

96
00:06:36,570 --> 00:06:39,040
!انتهيتُ أخيراً

97
00:06:39,720 --> 00:06:41,670
يون-سينباي، شكراً جزيلاً لكِ

98
00:06:45,330 --> 00:06:48,960
!ماذا تفعلُ هيفومي-سينباي على الغداء يا تُرى؟

99
00:06:56,930 --> 00:06:59,140
هـ-هل أردتِ شيئاً؟

100
00:06:59,140 --> 00:07:00,670
لـ-لا

101
00:07:00,670 --> 00:07:04,290
كنتُ أتساءل عمّا فعلتِه على الغداء فحسب

102
00:07:05,390 --> 00:07:08,150
آكلُ الغداء قبل المجيء إلى هنا

103
00:07:08,150 --> 00:07:09,520
ماذا؟ هذا مذهل

104
00:07:09,520 --> 00:07:11,580
لا أملك الوقت الكافي لذلك

105
00:07:11,580 --> 00:07:13,490
...مع أنّني آتي قُبيل فترة الغداء

106
00:07:16,240 --> 00:07:19,000
أريدُ أن آكل الغداء من سوجيرو

107
00:07:19,000 --> 00:07:21,670
س-س-س-سوجيرو-سان؟

108
00:07:21,670 --> 00:07:24,000
...هل هو صـ-صـ-صـ-صديقـ

109
00:07:24,000 --> 00:07:24,920
هل أريكِ صورته؟

110
00:07:24,920 --> 00:07:26,050
أيمكنني حقّاً؟

111
00:07:28,400 --> 00:07:30,490
إنّها سريعة في استعمال هاتفها

112
00:07:32,520 --> 00:07:33,220
ها هي

113
00:07:35,450 --> 00:07:36,320
فرشاة؟

114
00:07:37,290 --> 00:07:38,350
قنفذ

115
00:07:40,040 --> 00:07:41,420
،ذكرتِ اسمَ صبيّ

116
00:07:41,420 --> 00:07:43,720
لهذا ظننتُه كان صديقكِ أو ما شابه

117
00:07:45,210 --> 00:07:47,080
صديقي؟

118
00:07:49,130 --> 00:07:52,850
لا أشعر بالرّاحة حول الرّجال

119
00:07:53,920 --> 00:07:55,550
!أتفهّمكِ تماماً

120
00:07:55,550 --> 00:07:57,280
وأنا أتوتّر قليلاً أيضاً

121
00:07:58,440 --> 00:08:00,660
أنا لا أتكلّم عن خبرة بصراحة

122
00:08:00,660 --> 00:08:01,750
أنا آسفة

123
00:08:01,750 --> 00:08:03,440
كنتُ أتكلّمُ عن عالمي الخيالي أيضاً

124
00:08:04,720 --> 00:08:06,100
لديّ المزيد

125
00:08:06,100 --> 00:08:08,200
!إنّه ظريف للغاية

126
00:08:08,200 --> 00:08:08,920
أليس كذلك؟

127
00:08:09,810 --> 00:08:12,380
هل القنافذ ودودة؟

128
00:08:12,700 --> 00:08:13,770
ليس تماماً

129
00:08:13,770 --> 00:08:16,890
يختبئ في جحره دوماً

130
00:08:17,430 --> 00:08:19,140
إنّه جبان جدّاً

131
00:08:19,140 --> 00:08:21,450
وجه التّشابه واضح

132
00:08:22,250 --> 00:08:23,160
...لكن

133
00:08:23,160 --> 00:08:26,530
لقد اقتربتُ من مرحلة القدرة على لمسه

134
00:08:28,310 --> 00:08:30,210
أنتِ تبتسمين يا هيفومي-سينباي

135
00:08:35,570 --> 00:08:36,560
انسي ما رأيتِه

136
00:08:36,560 --> 00:08:37,480
!مال؟

137
00:08:37,950 --> 00:08:39,110
لا

138
00:08:39,110 --> 00:08:40,090
...في الواقع

139
00:08:40,570 --> 00:08:42,000
أبدو غريبة جدّاً

140
00:08:42,000 --> 00:08:43,230
!إطلاقاً

141
00:08:43,230 --> 00:08:45,120
!ابتسامتكِ غاية في الظرافة

142
00:08:46,760 --> 00:08:48,810
تبدين لطيفة جدّاً

143
00:08:49,450 --> 00:08:51,710
سيتقرّب منكِ النّاس أكثر إن كنتِ هكذا

144
00:08:56,130 --> 00:08:58,990
ألا أبدو غريبة؟

145
00:08:58,990 --> 00:09:00,600
!إطلاقاً

146
00:09:02,390 --> 00:09:03,350
...إذاً

147
00:09:09,890 --> 00:09:11,690
!لا، كدتِ تفعلينها

148
00:09:11,690 --> 00:09:13,280
لا أستطيع

149
00:09:13,280 --> 00:09:15,600
انظري إليّ إذاً

150
00:09:15,600 --> 00:09:17,280
انظري إلى سوجيرو-كن

151
00:09:17,280 --> 00:09:22,790
ابتسمي، ابتسمي

152
00:09:22,790 --> 00:09:24,620
—غداء، غـ

153
00:09:26,460 --> 00:09:27,750
ماذا تفعلان؟

154
00:09:30,570 --> 00:09:32,210
أوبا، هل تناولتِ الغداء؟

155
00:09:32,510 --> 00:09:35,100
أردتُ أن أتدرّب

156
00:09:36,590 --> 00:09:39,220
أخذ قسط من الرّاحة هو جزءٌ من العمل

157
00:09:39,490 --> 00:09:40,760
!تفضّلي كرة من الأرزّ

158
00:09:43,390 --> 00:09:45,200
أشعرُ بالاستياء قليلاً

159
00:09:45,200 --> 00:09:47,520
يون-سان أعطتني أكلتها الخفيفة أيضاً

160
00:09:47,810 --> 00:09:50,310
سأصطحبكِ للخارج ونأكل شيئاً أيضاً

161
00:09:50,310 --> 00:09:52,360
!لن أدع المستجدّة تأخذني

162
00:09:53,370 --> 00:09:56,860
عندما تكونين مشغولة فينبغي أن تشتري
شيئاً قبل الدّخول

163
00:09:56,860 --> 00:09:58,350
شكراً جزيلاً لكِ

164
00:09:58,350 --> 00:09:59,030
شكراً على الطعام

165
00:10:01,860 --> 00:10:03,370
!مذهل، تأخّرت الوقت بهذه السرعة

166
00:10:03,750 --> 00:10:05,090
عليّ أن أسرع في الأكل

167
00:10:18,980 --> 00:10:20,170
...صديقة

168
00:10:21,170 --> 00:10:22,410
سوجيرو؟

169
00:10:30,130 --> 00:10:31,050
آسفة

170
00:10:31,570 --> 00:10:32,900
لـ-لا داعي للقلق

171
00:10:34,250 --> 00:10:35,970
أخذني هذا على حين غرة

172
00:10:43,210 --> 00:10:44,460
لقد عُدت

173
00:10:45,140 --> 00:10:49,790
سوجيرو، هل تُعجبك ابتسامتي؟

174
00:11:00,020 --> 00:11:01,920
هل أحضرتِ غداءً اليوم؟

175
00:11:02,700 --> 00:11:03,510
أجل

176
00:11:04,210 --> 00:11:06,970
تشاجرتُ مع سوجيرو

177
00:11:06,970 --> 00:11:07,640
تشاجرتُما؟

178
00:11:08,750 --> 00:11:13,730
لا أظنُّ أنّ سوجيرو يحبُّ ابتسامتي

179
00:11:13,730 --> 00:11:15,040
ماذا؟

180
00:11:19,410 --> 00:11:21,430
إلى أين وصلتِ في الكتاب؟

181
00:11:21,430 --> 00:11:22,720
إلى هنا

182
00:11:22,720 --> 00:11:23,990
وصلتُ إلى هذا الجزء الآن

183
00:11:25,730 --> 00:11:26,530
رائع

184
00:11:26,530 --> 00:11:28,080
لنكلّفكِ بمشروع إذاً

185
00:11:28,340 --> 00:11:29,370
مشروع؟

186
00:11:30,000 --> 00:11:31,350
عمل حقيقي

187
00:11:31,350 --> 00:11:33,250
ستعملين على مشروعكِ الأوّل

188
00:11:35,420 --> 00:11:36,390
!حسناً

189
00:11:38,170 --> 00:11:42,170
هذا نايت-كُن، بطل قصّة الجنّيات 3

190
00:11:42,730 --> 00:11:44,590
يبدو رائعاً مهما نظرتُ إليه

191
00:11:45,450 --> 00:11:47,370
مذهل للغاية

192
00:11:48,250 --> 00:11:51,600
لكن تبدو هذه البلدة موحشة من دون وجود أحد فيها

193
00:11:51,600 --> 00:11:52,410
معكِ حقّ

194
00:11:52,410 --> 00:11:56,570
عملكِ الأوّل هو جعل هذه المدينة حيويّة

195
00:11:56,570 --> 00:11:58,750
كـ-كيف أفعل ذلك؟

196
00:11:58,750 --> 00:12:00,940
أملئيها بالنّاس

197
00:12:01,450 --> 00:12:02,910
،لقد أنشأتُ التّصاميم

198
00:12:02,910 --> 00:12:05,950
لِذا كلّ ما عليكِ هو تصميمها
بأشكال ثلاثية الأبعاد

199
00:12:06,310 --> 00:12:11,200
بالمناسبة، نسمّي الشخصيّات التي لا تستطيعين
التحكُّم بها باسم: ن.ب.سي

200
00:12:11,200 --> 00:12:14,180
أو الشخصيّات الغير قابلة للّعب

201
00:12:14,180 --> 00:12:16,540
بينما الشخصيّات القابلة للّعب: ب.سي

202
00:12:17,800 --> 00:12:21,440
كافّة الـ ن.ب.سي في هذه البلدة قد أُنجِزَتْ
لذا يمكنكِ الاطّلاع عليها كمرجع

203
00:12:23,220 --> 00:12:25,040
!الكثير من آذان القطط

204
00:12:25,040 --> 00:12:26,200
!ما أظرف هذا

205
00:12:26,200 --> 00:12:27,730
إنّها بلدة قطط

206
00:12:27,730 --> 00:12:29,280
أدّتْ هيفومين عملاً عظيماً هنا

207
00:12:30,100 --> 00:12:31,000
!هيفومي-سينباي

208
00:12:31,000 --> 00:12:32,160
!سأبذلُ قصارى جهدي أيضاً

209
00:12:32,160 --> 00:12:32,850
ماذا؟

210
00:12:34,610 --> 00:12:37,380
هل حصلتِ على مشروعكِ الأوّل يا أوبا-تشان؟

211
00:12:37,380 --> 00:12:38,190
نعم

212
00:12:38,190 --> 00:12:39,360
سأبذلُ قصارى جهدي

213
00:12:39,360 --> 00:12:44,110
تذكّرني رؤيتكِ بنفسي عندما
كنتُ في بداياتي

214
00:12:44,610 --> 00:12:47,110
مع أنّها  لم تخطئ كثيراً وقتها

215
00:12:48,030 --> 00:12:51,450
وأنا لم أخطئ كثيراً أيضاً

216
00:12:51,450 --> 00:12:55,610
سكبتُ الشّاي في بعض الأحيان فقط
أو ذهبتُ للشركة الخاطئة

217
00:12:55,610 --> 00:12:56,500
أرأيتِ ما أعنيه؟

218
00:12:56,710 --> 00:12:58,000
!اهدئي

219
00:12:57,010 --> 00:12:58,000
شكراً لك

220
00:12:58,000 --> 00:13:00,050
!مع أنّني في سنتي الثّانية الآن

221
00:13:00,050 --> 00:13:03,540
لِذا لا تتوقّعي منّي أخطاء بعد الآن

222
00:13:03,540 --> 00:13:04,970
!ساخن

223
00:13:08,670 --> 00:13:10,720
!لا

224
00:13:09,650 --> 00:13:11,390
!سأحضر منشفة

225
00:13:11,950 --> 00:13:14,060
نحستِه كلّياً

226
00:13:14,530 --> 00:13:15,900
أنا آسفة

227
00:13:20,980 --> 00:13:23,010
هذا صعب للغاية

228
00:13:23,510 --> 00:13:25,950
كيف فعلَتْها هيفومي-سينباي؟

229
00:13:25,950 --> 00:13:27,130
!فهمت

230
00:13:27,130 --> 00:13:28,930
هكذا يتمّ الأمر إذاً

231
00:13:28,930 --> 00:13:30,000
!أوبا

232
00:13:30,000 --> 00:13:32,230
اقترب وقتُ الحفلة

233
00:13:37,310 --> 00:13:39,880
كيف أؤدّي هذه الجزئية؟

234
00:13:40,420 --> 00:13:41,290
!أوبا

235
00:13:41,900 --> 00:13:43,220
حاضرة؟

236
00:13:43,220 --> 00:13:44,380
حان الوقت

237
00:13:44,380 --> 00:13:46,010
لا تتأخّري على الأُخريات

238
00:13:46,010 --> 00:13:47,960
!أ-أ-أنا آسفة

239
00:13:50,590 --> 00:13:51,350
حسناً إذاً

240
00:13:51,660 --> 00:13:55,350
لنبدأ بحفلة التّرحيب بسوزوكازي أوبا-تشان

241
00:13:55,670 --> 00:13:58,610
!بصحّتكن

242
00:13:59,400 --> 00:14:01,480
!على حساب الشّركة اليوم

243
00:14:01,480 --> 00:14:03,690
!لنأكل ونشرب بجنون

244
00:14:03,690 --> 00:14:05,110
!حسناً

245
00:14:05,110 --> 00:14:06,940
!حان وقتُ الأكل

246
00:14:06,940 --> 00:14:10,190
!لا تلتقطي كلّ اللّحم

247
00:14:11,250 --> 00:14:14,410
أوبا، كلي هذه للاحتفال

248
00:14:14,410 --> 00:14:15,790
ما هذه؟

249
00:14:15,790 --> 00:14:17,830
كُليها فحسب

250
00:14:23,610 --> 00:14:25,390
ماذا كان ذلك؟ حارّ للغاية

251
00:14:26,130 --> 00:14:29,090
تاكوياكي حارّة، على طريقة الرّوليت الروسيّة، خسرتِ

252
00:14:30,030 --> 00:14:32,850
أوبا-تشان، أهذه هي مُشاركتكِ الأولى في حفلة شرب؟

253
00:14:32,850 --> 00:14:34,370
نـ-نعم

254
00:14:34,370 --> 00:14:38,100
فأساساً لم تبلغي السنَّ المسموح للشرب

255
00:14:38,100 --> 00:14:40,060
ماذا؟ هل أصبحت ثملة بهذه السّرعة؟

256
00:14:40,060 --> 00:14:42,860
يون-سان، لا تنامي

257
00:14:43,520 --> 00:14:45,860
يبدو أنّ هيفومي-سينباي قويّة

258
00:14:47,360 --> 00:14:49,360
!هذا صحيح

259
00:14:49,360 --> 00:14:49,920
...و

260
00:14:49,920 --> 00:14:51,360
!هازوكي-سان

261
00:14:52,020 --> 00:14:53,710
ارتأيتُ المجيء

262
00:14:53,710 --> 00:14:55,570
سوزوكازي-كن، ما رأيكِ؟

263
00:14:55,570 --> 00:14:57,530
هل أعجبكِ التّرحيب؟

264
00:14:57,530 --> 00:14:59,870
نعم، يُعاملنَني بلطف

265
00:14:59,870 --> 00:15:01,320
سمعت

266
00:15:01,320 --> 00:15:03,290
تمَّ تكليفكِ بمشروع بسرعة؟

267
00:15:03,290 --> 00:15:06,550
نعم، لكن لم أحرز أي تقدّم فيه بعد

268
00:15:07,790 --> 00:15:09,630
ما زلتِ في يومكِ الأوّل للمشروع

269
00:15:09,630 --> 00:15:14,180
قد يكون العمل على مشروع تصميم ثلاثي
الأبعاد بعد أسبوع واحد فقط مبكّراً جدّاً يا ياغامي

270
00:15:14,580 --> 00:15:18,490
في الواقع، كانَتْ تقطعُ شوطاً كبيراً
من الكتابِ بسرعة فائقة ما دفعَني للتفكير بذلك

271
00:15:18,490 --> 00:15:21,370
لِمَ لا تكونين أكثر صراحة؟

272
00:15:21,860 --> 00:15:25,440
قولي أنّكِ مُندهشة جدّاً

273
00:15:25,660 --> 00:15:26,990
سوزوكازي-كن

274
00:15:26,990 --> 00:15:31,820
ياغامي ليسَتْ صريحة تماماً وهي
في الواقع حسّاسة بعض الشيء، لِذا عامليها برفق

275
00:15:31,820 --> 00:15:32,950
هكذا إذاً

276
00:15:32,950 --> 00:15:35,040
!عودي إلى المنزل فحسب رجاء

277
00:15:35,040 --> 00:15:37,330
!هذه حفلةٌ لفريق الشخصيّات

278
00:15:37,610 --> 00:15:40,210
...أنا في فريق التّحريك

279
00:15:40,210 --> 00:15:42,120
!لا تحاولي تعقيد المسألة

280
00:15:44,070 --> 00:15:45,490
،طاقمنا غريب الأطوار قليلاً

281
00:15:45,490 --> 00:15:47,990
لكن آمل ألّا تكوني قد ارتعدتِ

282
00:15:47,990 --> 00:15:48,870
إطلاقاً

283
00:15:48,870 --> 00:15:52,710
،كنتُ قلقة قليلاً من الانضمام للشركة

284
00:15:52,710 --> 00:15:55,140
لكن أصبحتُ مرتاحة الآن لأنّ الجميع عاملنَني بلطف

285
00:15:56,650 --> 00:15:58,080
هذا جيّد

286
00:16:00,420 --> 00:16:01,520
حسناً إذاً

287
00:16:01,520 --> 00:16:03,350
سوف أذهب

288
00:16:03,590 --> 00:16:05,960
هل ستذهبين إلى المنزل فعلاً؟

289
00:16:05,960 --> 00:16:09,430
ستشعرُ موزوكو بالوحشة من دوني

290
00:16:09,430 --> 00:16:11,360
سأوصلكِ للخارج

291
00:16:13,290 --> 00:16:14,320
!بالمناسبة

292
00:16:14,600 --> 00:16:16,870
شكراً على اللّحم

293
00:16:19,720 --> 00:16:21,400
!أكلَتْ حصّتي

294
00:16:30,440 --> 00:16:32,340
...قولي لي يا أوبا

295
00:16:32,340 --> 00:16:33,840
هل لديكِ صديق؟

296
00:16:37,650 --> 00:16:38,250
ماذا؟

297
00:16:38,250 --> 00:16:40,430
ما-ما حاجتي لصديق؟

298
00:16:41,760 --> 00:16:44,180
لكن يبدو أنّ لديكِ صديق

299
00:16:46,150 --> 00:16:47,030
ماذا؟

300
00:16:47,030 --> 00:16:48,920
ما-ما حاجتي لوجود صديق؟

301
00:16:48,920 --> 00:16:51,150
لماذا تتورّد وجنتاكِ كأي فتاة صغيرة؟

302
00:16:52,290 --> 00:16:56,380
!أعملُ طوال الوقت ولا أملك الوقت الكافي للحبّ

303
00:16:56,380 --> 00:16:59,130
كو-تشان، أنتِ تفرطين في الشّرب

304
00:16:59,130 --> 00:17:01,000
سأشرب هذه

305
00:17:01,000 --> 00:17:03,000
!هذا شراب ثقيل

306
00:17:12,570 --> 00:17:14,630
لا أملك صديقاً أيضاً

307
00:17:14,630 --> 00:17:16,470
!لم يسألكِ أحد

308
00:17:16,750 --> 00:17:17,840
!أوبا-تشان

309
00:17:18,480 --> 00:17:21,390
المستجدّون ينبغي أن يسكبوا المشروب للسينباي

310
00:17:21,390 --> 00:17:22,890
!بـ-بالطبع

311
00:17:27,900 --> 00:17:29,900
!أ-أنا آسفة

312
00:17:33,320 --> 00:17:35,760
لا ينبغي أن تسكبي مشروباً
لشخصٍ بهذه الطريقة

313
00:17:35,760 --> 00:17:37,120
!راقبي وتعلّمي

314
00:17:37,120 --> 00:17:38,160
!كو-تشان

315
00:17:40,700 --> 00:17:41,470
هل ترين؟

316
00:17:41,470 --> 00:17:44,250
!هذا الأفضل من حيث الشّكل والطّعم

317
00:17:44,250 --> 00:17:45,860
!رائع

318
00:17:45,860 --> 00:17:48,670
لا، يجبُ ألّا تبدي مُلهَمة

319
00:17:57,380 --> 00:17:59,070
هل أنتِ بخير؟

320
00:17:59,850 --> 00:18:01,680
أفرطَتْ في الشّرب رُغم وزنها الخفيف

321
00:18:02,100 --> 00:18:05,380
هذه هي حفلة الشرب للكبار إذاً

322
00:18:07,840 --> 00:18:09,840
هل يمكنُكِ أن تطلبي طلباً لأجلي؟

323
00:18:09,840 --> 00:18:11,410
أ-أكيد

324
00:18:11,410 --> 00:18:13,340
!المعذرة

325
00:18:13,340 --> 00:18:14,940
!قادمة

326
00:18:14,940 --> 00:18:19,380
هل يمكنُني أن أطلب هذه... موري موساشي؟ رجاء

327
00:18:19,380 --> 00:18:21,160
إنّها موري تاكيزو

328
00:18:21,160 --> 00:18:23,650
أجل، موري تاكيزو

329
00:18:23,650 --> 00:18:25,890
كيف تفضّلين تقديمها؟

330
00:18:26,540 --> 00:18:29,540
يمكننا تقديمها مع ثلج، أو مزيج مائي
أو مزيج صودا

331
00:18:30,610 --> 00:18:33,290
هيفومي-سينباي، كيف تريدينها؟

332
00:18:34,960 --> 00:18:36,230
كما هي فقط

333
00:18:36,230 --> 00:18:37,680
كما هي؟

334
00:18:37,680 --> 00:18:40,280
كما هي رجاء

335
00:18:40,280 --> 00:18:41,870
المعتدلة إذاً؟

336
00:18:41,870 --> 00:18:43,350
—معتـ

337
00:18:43,350 --> 00:18:46,290
ستكونُ مُعتدلة إذا قدّمتُها كما هي

338
00:18:47,900 --> 00:18:49,690
!نعم، معتدلة لو سمحتِ

339
00:18:49,690 --> 00:18:51,740
موري تاكيزو، معتدلة

340
00:18:51,740 --> 00:18:52,940
سأحضرها

341
00:18:55,590 --> 00:18:57,680
المشروبات الرّوحية باهظة الثّمن حقاً

342
00:18:57,680 --> 00:18:59,740
بعض الزُجاجات تُباع بـ 800 ين

343
00:18:59,740 --> 00:19:01,720
بمقدوري شراء مجلّد مانغا بنفس المبلغ

344
00:19:04,170 --> 00:19:07,000
مـ-ما هو مذاقه يا ترى؟

345
00:19:07,570 --> 00:19:08,460
...المعذرة

346
00:19:08,460 --> 00:19:11,090
هل يمكنُني أخذ رشفة؟

347
00:19:11,090 --> 00:19:11,810
ماذا؟

348
00:19:11,810 --> 00:19:15,630
...ر-ر-رشفة واحدة فقط

349
00:19:15,630 --> 00:19:17,010
!مرحى

350
00:19:27,940 --> 00:19:29,160
!المعذرة

351
00:19:30,330 --> 00:19:31,770
!أ-أ-أنا آسفة

352
00:19:31,770 --> 00:19:34,480
!لـ-لكن لم أفعل شيئاً بعد

353
00:19:35,870 --> 00:19:38,090
سنغلق المطبخ قريباً

354
00:19:38,090 --> 00:19:40,810
هل لديكنّ أي طلبات أخرى؟

355
00:19:40,810 --> 00:19:42,390
ماذا؟ بهذه السّرعة؟

356
00:19:42,390 --> 00:19:43,740
هذا مبكّر جدّاً

357
00:19:48,310 --> 00:19:50,960
يمكنُكِ أن تشربي عندما تبلغين العشرين

358
00:19:51,250 --> 00:19:53,470
أوقفيني في وقتٍ أبكر رجاءً

359
00:19:54,450 --> 00:19:56,080
حسناً إذاً

360
00:19:56,080 --> 00:19:58,120
من سيأتي إلى حفلة ما بعد الحفلة؟

361
00:19:58,120 --> 00:20:00,870
عليّ أن آخذ يون إلى المنزل

362
00:20:02,420 --> 00:20:03,250
ماذا؟

363
00:20:03,250 --> 00:20:05,590
عادَتْ هيفومي-سينباي إلى المنزل اعتباراً من الآن

364
00:20:05,590 --> 00:20:07,130
أستطيعُ الذهاب أنا

365
00:20:08,290 --> 00:20:09,010
!حسناً

366
00:20:09,010 --> 00:20:11,140
!لنذهب نحن الثّلاثة

367
00:20:14,930 --> 00:20:17,050
أيّها السّاقي، إليّ بمشروب

368
00:20:17,050 --> 00:20:18,030
أنتِ يا أوبا؟

369
00:20:19,680 --> 00:20:21,980
...لن أجرّب المشروبات الرّوحية بعد الآن، لذا

370
00:20:21,980 --> 00:20:24,130
هل لديهم عصير هنا؟

371
00:20:24,770 --> 00:20:25,370
!أنت

372
00:20:25,710 --> 00:20:27,630
!سأطلبُ زهرة البرتقال

373
00:20:27,630 --> 00:20:28,870
هذا مشروبٌ روحيّ

374
00:20:30,200 --> 00:20:31,180
ماذا؟

375
00:22:06,010 --> 00:22:10,470
لم أتناول أي مشروب، لكن أشعرُ بالثّمالة

376
00:22:13,990 --> 00:22:15,350
مرحباً؟

377
00:22:16,160 --> 00:22:17,850
!أوتشي

378
00:22:18,530 --> 00:22:20,060
ما الأمر يا نينيتشي؟

379
00:22:20,420 --> 00:22:21,540
!افهميني

380
00:22:21,540 --> 00:22:25,000
يُعاملني الجميع في الكلّية كتلميذة إعداديّة

381
00:22:25,000 --> 00:22:26,550
!إنّهم قُساة جدّاً

382
00:22:27,530 --> 00:22:30,810
لكنّ مظهركِ وتصرّفاتكِ كما الطّفلة
لِذا لا يجوز أن تلوميهم

383
00:22:30,810 --> 00:22:32,450
!لا يحقّ لكِ الكلام يا أوتشي

384
00:22:32,450 --> 00:22:37,130
لـ-لكنّني عضو عامل في المُجتمع
وأتعلّم أشياء لها علاقة بالكبار

385
00:22:37,130 --> 00:22:38,880
!أنا أتطوّر

386
00:22:38,880 --> 00:22:39,960
وماذا تعلّمتِ؟

387
00:22:40,180 --> 00:22:41,600
...مثلاً

388
00:22:41,600 --> 00:22:43,510
كيفيّة طلب المشروبات الروحيّة

389
00:22:43,510 --> 00:22:45,780
!يا للهول! استدعي الشرطة

390
00:22:45,780 --> 00:22:47,470
ليسَ لديّ

391
00:22:48,660 --> 00:22:50,490
ما أخبار العمل؟

392
00:22:51,900 --> 00:22:54,930
ما زال أمامي الكثير لأتعلّمه، لكنّه مُمتع

393
00:22:54,930 --> 00:22:57,980
أرسمُ تصاميمَ ياغامي-سان
الآن على هيئة ثلاثيّة الأبعاد

394
00:22:57,980 --> 00:22:58,920
رائع

395
00:22:58,920 --> 00:23:01,480
أهي لقصّة الجنّيات 3؟

396
00:23:01,770 --> 00:23:02,420
!ماذا؟

397
00:23:04,070 --> 00:23:06,280
!ماذا؟! هل أنتِ جادّة؟

398
00:23:06,280 --> 00:23:08,090
!لـ-لا! لا

399
00:23:08,090 --> 00:23:11,020
ذاك الصّمت هو مجرّد تفكير وتمنّي من قِبَلي

400
00:23:11,020 --> 00:23:14,610
إضافة إلى أنّني لا أستطيع أن أخبركِ
عمّا نعمل عليه

401
00:23:14,610 --> 00:23:16,950
!هذه معلوماتٌ سرّية

402
00:23:16,950 --> 00:23:18,610
أنا آسفة، سأنسى هذا

403
00:23:18,610 --> 00:23:19,910
سأنسى ما سمعت

404
00:23:19,910 --> 00:23:22,710
!لن أدعكِ تتعرّضين للاعتقال

405
00:23:22,710 --> 00:23:24,150
!اعتقال؟

406
00:23:25,850 --> 00:23:29,010
أتشربين المشروبات الروحيّة كذلك يا هيفومي-سينباي

407
00:23:29,010 --> 00:23:30,200
أ-أنا؟

408
00:23:30,200 --> 00:23:33,960
أريدُ أن أشرب مشروباً ساخناً مع زعنفة
سمك الرّقيطة المشويّ المُغطّسة بمايونيز حارّ

409
00:23:33,960 --> 00:23:35,680
هذا ما أتوق إليه

410
00:23:35,680 --> 00:23:37,140
ألستِ قاصراً؟

411
00:23:37,140 --> 00:23:39,930
"الحلقة القادمة: "ماذا يحدث إذا تأخّرتُ عن العمل؟