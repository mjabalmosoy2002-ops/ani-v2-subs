1
00:00:13,000 --> 00:00:14,030
حسناً

2
00:00:14,030 --> 00:00:17,090
أهذا هو آخر القرويين الذين طلبتُ تصميمهم؟

3
00:00:17,090 --> 00:00:19,160
كان ذلك صعباً للغاية

4
00:00:19,160 --> 00:00:20,480
أحسنتِ صنعاً

5
00:00:20,480 --> 00:00:23,250
سأكلّفكِ بعمل تصميم الآن

6
00:00:23,560 --> 00:00:24,750
تفضّلي الهويّة

7
00:00:29,260 --> 00:00:31,260
ماذا؟

8
00:00:35,590 --> 00:00:39,260
أوبا-تشان، هل ستصمِّمين شخصيّة حقيقيّة الآن؟

9
00:00:39,260 --> 00:00:40,270
أ-أجل

10
00:00:40,270 --> 00:00:43,030
كُلِّفنا بفعل ذلك في العام الماضي أيضاً

11
00:00:43,030 --> 00:00:46,490
حدث ذلك بُعيد تأسيس فريقنا لهذا نحن مُرغمات
على القيام بمسابقة

12
00:00:46,490 --> 00:00:47,270
مسابقة؟

13
00:00:47,270 --> 00:00:50,810
اخترعنا تصاميماً وشاركناها مع المجموعة

14
00:00:50,810 --> 00:00:54,760
لكن لم أستطع اختراع أي شيء وبدأ رأسي يؤلمني

15
00:00:54,760 --> 00:00:57,250
أجل، ارتفعت حرارتكِ كأجهزة الكمبيوتر

16
00:00:57,250 --> 00:01:01,450
حينئذ قد أدركتُ أنّني أحبُّ تحريك الشّخصيات فحسب

17
00:01:01,750 --> 00:01:03,280
ما طبيعة الشخصيّة التي تصمّيمنها؟

18
00:01:03,280 --> 00:01:07,750
لنرَ، فتاة في الثّامنة عشر من العمر انضمّت
حديثاً لفرقة سيرك

19
00:01:08,180 --> 00:01:11,190
لون شعرها فاتح وله ذيلان توأمان

20
00:01:11,190 --> 00:01:14,430
صادقة ومفعمة بالحيويّة ولديها مقوّمات السّذاجة كذلك

21
00:01:14,430 --> 00:01:16,430
لحظة، يبدو هذا مألوفاً

22
00:01:16,430 --> 00:01:18,430
هذه أوبا-تشان دون أدنى شكّ

23
00:01:18,890 --> 00:01:23,640
،تقودُ الشخصيّات الرئيسيّة إلى الزنزانة التالية تحت الأرض

24
00:01:23,640 --> 00:01:26,520
!وتُقتَل بواسطة قطّاع طرق أثناء ذلك؟

25
00:01:26,520 --> 00:01:28,350
مسكينة

26
00:03:01,380 --> 00:03:04,320
تصميم الشخصيّات صعب

27
00:03:04,320 --> 00:03:07,270
لعلِّي أحتاج لبعض المراجع

28
00:03:07,270 --> 00:03:09,690
كيف حالها يا تُرى؟

29
00:03:11,670 --> 00:03:14,320
!ترسمينها في رأسكِ

30
00:03:15,130 --> 00:03:16,570
كيف حالكِ؟

31
00:03:16,570 --> 00:03:18,300
سيّئة للغاية

32
00:03:18,300 --> 00:03:19,530
دعيني أرى

33
00:03:21,610 --> 00:03:23,280
هكذا إذاً، تنتابكِ حالة عصف ذهنيّ

34
00:03:23,280 --> 00:03:25,850
ولا واحدة منها تبدو مناسبة

35
00:03:25,850 --> 00:03:30,870
وقد كنتُ مشغولة جدّاً بالعمل مؤخّراً
لدرجة أنّني لم أعد أرسم شيئاً على الإطلاق

36
00:03:30,870 --> 00:03:33,240
ليتني كنتُ أعلم أنّ هذا هو مشروعي التّالي

37
00:03:33,240 --> 00:03:34,380
كفّي عن اختلاق الأعذار

38
00:03:34,380 --> 00:03:35,730
معكِ حقّ

39
00:03:35,730 --> 00:03:36,410
أنا آسفة

40
00:03:37,530 --> 00:03:40,640
ياغامي-سان، هل شاركتِ في مسابقة في البداية أيضاً؟

41
00:03:40,640 --> 00:03:41,870
أجل

42
00:03:41,870 --> 00:03:43,620
رسمتُ بجنون على ما أذكر

43
00:03:43,620 --> 00:03:46,880
هكذا حصلتِ على عمل تصميم الشخصيّة
الرئيسيّة، أليس كذلك؟

44
00:03:46,880 --> 00:03:47,660
نعم

45
00:03:47,660 --> 00:03:49,190
تذكّرت

46
00:03:49,190 --> 00:03:52,750
كنتُ المصمّمة الرئيسيّة أصلاً وأنا في سنّك

47
00:03:53,050 --> 00:03:59,290
مع أنّ في حالتكِ هذه، عليكِ
أن تتفوّقي عليّ أولاً، لِذا لن يكون الأمر سهلاً

48
00:04:02,730 --> 00:04:06,430
،لكن لهذا سينباي كو-تشان لم يحبّونها

49
00:04:06,430 --> 00:04:07,910
وأخذن يُضايقنها كثيراً

50
00:04:07,910 --> 00:04:08,900
!مهلاً

51
00:04:08,900 --> 00:04:10,270
ماذا تقصدين؟

52
00:04:10,530 --> 00:04:13,850
ليس شعوراً جيّداً أن تأتي موظّفة
جديدة وتنتزع منهنّ وظيفة التّصميم الرئيسيّ

53
00:04:13,850 --> 00:04:15,400
.حال تخرّجها من المدرسة الثانوية

54
00:04:15,400 --> 00:04:18,320
تصرّفتُ بقليل من الغرور أيضاً

55
00:04:18,320 --> 00:04:22,060
لهذا كانت تأتي إليّ يوميّاً للحديث عن ذلك بغضب

56
00:04:22,060 --> 00:04:23,830
رين، توقّفي

57
00:04:23,830 --> 00:04:25,830
أظنُّني فهمتُ بعض الشيء

58
00:04:27,060 --> 00:04:33,380
عندما علمتُ أنّكِ كنتِ المصمّمة
الرئيسيّة وأنتِ بمثل سنّي

59
00:04:33,380 --> 00:04:35,290
...شعرتُ بمرارة بعض الشيء

60
00:04:36,030 --> 00:04:40,250
وحسدتُكِ قليلاً أيضاً

61
00:04:40,250 --> 00:04:42,170
ما الذي أقوله؟

62
00:04:42,170 --> 00:04:43,950
عليّ أن أنضج

63
00:04:44,840 --> 00:04:46,910
،لو كنتِ مكانكِ

64
00:04:46,910 --> 00:04:48,680
لما انتابَني الشُّعور ذاته

65
00:04:51,220 --> 00:04:54,140
!لأنّني أعشقُ هذا العمل

66
00:04:57,150 --> 00:04:59,940
هل استمتعتِ في تصميم سكّان القرية؟

67
00:04:59,940 --> 00:05:02,030
أ-أجل

68
00:05:02,030 --> 00:05:04,530
،عرفتُ أنّه لم يكن عملاً مهمّاً

69
00:05:04,530 --> 00:05:05,850
لكن أحببتُه

70
00:05:05,850 --> 00:05:06,750
هكذا إذاً

71
00:05:06,750 --> 00:05:07,740
هذا جيّد

72
00:05:07,740 --> 00:05:10,650
،وضعتُ تصاميم القرويين الخاصّة بكِ على الخريطة

73
00:05:10,650 --> 00:05:12,960
ويرجعُ الأمرُ للملقّم الآن، لِذا ألقي نظرة

74
00:05:12,960 --> 00:05:14,660
حـ-حسناً

75
00:05:19,540 --> 00:05:20,990
!مذهل

76
00:05:20,990 --> 00:05:24,050
!لم أكن أعلم أنّ شكلها هكذا داخل اللّعبة

77
00:05:24,540 --> 00:05:26,680
،من المهمّ الشّعور بمرارة الهزيمة

78
00:05:26,980 --> 00:05:30,920
لكن عند الاستمتاع، تلتمسينه في المُنتَج

79
00:05:30,920 --> 00:05:33,030
هذا هو المهمّ على ما أعتقد

80
00:05:33,030 --> 00:05:33,940
أجل

81
00:05:35,430 --> 00:05:39,360
لقد استمتعتُ بإضافة الحركة لنماذجكِ أيضاً

82
00:05:39,360 --> 00:05:40,110
أجل

83
00:05:40,110 --> 00:05:41,990
كثير من العاملين على التّخطيط

84
00:05:41,990 --> 00:05:46,970
والتّحريك والبرمجة قد شاركوا في هذا المشروع

85
00:05:46,970 --> 00:05:49,370
،لعلِّي مكلَّفة بأبرز عمل

86
00:05:49,370 --> 00:05:51,230
.لكن لا أستطيع القيام بكلّ شيء لوحدي

87
00:05:51,230 --> 00:05:53,300
أعني بذلك تصاميمكِ أيضاً

88
00:05:53,300 --> 00:05:55,300
لِذا لا تنسي ذلك

89
00:05:55,300 --> 00:05:59,760
أ-أشعرُ بتوتُّر فجأة من حجم المسؤوليّة

90
00:06:01,190 --> 00:06:05,800
بالمناسبة، إذا أصبحتُ المصمّمة الرئيسيّة
وصرتُ مشرفة ياغامي-سان

91
00:06:05,800 --> 00:06:08,700
سأبدأ بإزالة النّداء التشريفيّ

92
00:06:09,880 --> 00:06:11,770
ياغامي. تعالي إلى هنا

93
00:06:11,770 --> 00:06:13,350
حينئذ سأغادر الشركة

94
00:06:13,350 --> 00:06:14,590
كذلك أنا

95
00:06:17,940 --> 00:06:19,810
ماذا عنك؟

96
00:06:20,570 --> 00:06:23,160
لا أستطيع البقاء بالتأكيد

97
00:06:24,100 --> 00:06:25,050
لماذا؟

98
00:06:25,050 --> 00:06:27,680
أشعر بمرارة أيضاً

99
00:06:27,680 --> 00:06:29,930
استمرّي في الشّعور بذلك إذاً

100
00:06:32,830 --> 00:06:35,490
!ياغامي-سان، لديّ تصميم

101
00:06:38,130 --> 00:06:40,540
حسناً، يبدو جيّداً

102
00:06:40,840 --> 00:06:42,270
هل لديها اسم؟

103
00:06:42,270 --> 00:06:45,340
...أجل، اخترعتُ اسماً، لكن

104
00:06:45,340 --> 00:06:47,540
...لكن

105
00:06:47,540 --> 00:06:50,980
من المحرج ذكر اسمها

106
00:06:50,980 --> 00:06:54,010
والتكتُّم عليه لن يزيد الأمر إلّا سوءاً

107
00:06:55,350 --> 00:06:56,740
اسمها صوفيا-تشان

108
00:06:56,740 --> 00:06:58,190
صوفيا-تشان؟

109
00:06:59,460 --> 00:07:02,030
لحظة، أهذه أنا؟

110
00:07:02,470 --> 00:07:03,610
هل لاحظتِ للتو؟

111
00:07:03,610 --> 00:07:04,980
!غير معقول

112
00:07:04,980 --> 00:07:06,860
!أكرهكِ يا ياغامي-سان

113
00:07:06,860 --> 00:07:09,490
صوفيا-تشان، لا تكوني نكِدة

114
00:07:12,300 --> 00:07:13,370
أحسنتِ صنعاً

115
00:07:13,670 --> 00:07:16,800
غداً هو يوم السبت، لِذا هل يمكنكِ أن ترتاحي قليلاً

116
00:07:16,800 --> 00:07:18,220
شكراً لكِ

117
00:07:18,220 --> 00:07:19,920
هل لديك أي مخطّطات؟

118
00:07:19,920 --> 00:07:22,730
سأحضر فيلماً مع صديقة طفولة

119
00:07:22,730 --> 00:07:23,610
حقّاً؟

120
00:07:23,610 --> 00:07:24,650
هذا جميل

121
00:07:26,030 --> 00:07:28,630
!سأنام طوال اليوم غداً

122
00:07:34,400 --> 00:07:37,300
!أمّي، أنا جائعة

123
00:07:37,300 --> 00:07:39,030
أما زلتِ ببيجامتكِ؟

124
00:07:39,030 --> 00:07:39,810
لِمَ لا ترتدين ملابسكِ؟

125
00:07:39,810 --> 00:07:42,220
لكنّنا في عطلة نهاية الأسبوع

126
00:07:42,710 --> 00:07:44,310
!أمّي، أريد معكرونة

127
00:07:44,670 --> 00:07:49,800
أعملُ بجدذٍ كلّ يوم وأتقاضى راتبي

128
00:07:49,800 --> 00:07:53,220
أريدُ أن أستريح قدر ما أستطيع

129
00:07:54,270 --> 00:07:56,580
أنتِ كأبيكِ

130
00:07:57,060 --> 00:07:57,990
!لا

131
00:08:07,130 --> 00:08:08,030
!يا أطفال

132
00:08:08,030 --> 00:08:09,630
!شكراً على الحضور

133
00:08:09,630 --> 00:08:11,310
!عودوا لتشجيعنا مجدّداً

134
00:08:11,310 --> 00:08:13,520
!بالطبع يا سيغنال ثلاثة

135
00:08:13,520 --> 00:08:15,640
!إنّهم رائعون للغاية

136
00:08:21,520 --> 00:08:23,410
!يون-نيتشان

137
00:08:25,430 --> 00:08:26,480
مهلاً مهلاً

138
00:08:26,480 --> 00:08:27,580
ماذا حدث؟

139
00:08:27,580 --> 00:08:29,570
!ضربَتْني ميو

140
00:08:31,540 --> 00:08:33,450
ميو، لا يجوز أن تضربيها

141
00:08:34,660 --> 00:08:39,620
!أخذَتْ رين... دميتي... أوّلاً

142
00:08:44,330 --> 00:08:47,540
!حسناً، فهمت! كفّا عن البُكاء

143
00:08:47,540 --> 00:08:50,170
سآخذكما إلى مكان جميل إذا توقّفتُما عن البُكاء

144
00:09:19,770 --> 00:09:21,550
أما زلتِ نائمة؟

145
00:09:21,550 --> 00:09:23,210
سأعدُّ لكِ العشاء

146
00:09:23,210 --> 00:09:24,200
هل يمكنني الدّخول؟

147
00:09:28,430 --> 00:09:29,970
لستِ مضطرّة لذلك

148
00:09:29,970 --> 00:09:32,590
عليكِ الاهتمام بنفسكِ

149
00:09:37,620 --> 00:09:38,430
إنّه لذيذ

150
00:09:39,680 --> 00:09:40,640
شكراً

151
00:09:42,570 --> 00:09:45,920
أتساءلُ كيف تقضي الأخريات عطلة نهاية الأسبوع

152
00:09:47,660 --> 00:09:48,800
!أنا مضطرّة لذلك

153
00:09:48,800 --> 00:09:50,360
!سأغادر

154
00:09:58,940 --> 00:10:02,100
لم أرَ نينيتشي منذُ زمن طويل

155
00:10:02,780 --> 00:10:06,380
إنّها طفوليّة وأنانيّة وخرقاء

156
00:10:06,380 --> 00:10:10,380
وأعتقدُ أنّ الجميع ينادونها بتلميذة المدرسة
الإعداديّة في الكلّية

157
00:10:10,380 --> 00:10:11,930
لا

158
00:10:11,930 --> 00:10:14,880
هل دعَتْني اليوم لأنّها لا تمتلك أي صديقة؟

159
00:10:14,880 --> 00:10:16,320
!آوتشي

160
00:10:16,320 --> 00:10:17,550
هل كنتِ تنتظرينني؟

161
00:10:18,980 --> 00:10:21,720
!نينيتشي، أنا هُنا لأجلكِ دوماً

162
00:10:21,720 --> 00:10:23,060
ماذا؟

163
00:10:29,070 --> 00:10:30,330
!يا للوقاحة

164
00:10:30,330 --> 00:10:31,370
آسفة

165
00:10:31,370 --> 00:10:33,860
كان مجرّد تخمين

166
00:10:33,860 --> 00:10:36,570
!لـ-لديّ الكثير من الأصدقاء

167
00:10:36,570 --> 00:10:41,500
دعيتُكِ فقط لأنّني شعرتُ أنّكِ ستكونين وحيدة
دون وجود أحد بمثل سنّكِ في العمل

168
00:10:41,500 --> 00:10:43,310
بـ-بالطبع

169
00:10:43,310 --> 00:10:44,990
أنتِ لطيفة جدّاً يا نينيتشي

170
00:10:46,100 --> 00:10:48,330
لـ-لا تغازليني

171
00:10:50,070 --> 00:10:52,210
لنذهب ونشترِ تذاكرنا

172
00:10:52,210 --> 00:10:54,190
وإلّا خسرنا المقاعد الجيّدة

173
00:10:54,190 --> 00:10:55,250
نعم

174
00:10:56,060 --> 00:11:00,310
طالبة واحدة و... بالغة واحدة

175
00:11:01,300 --> 00:11:02,050
!لا

176
00:11:02,050 --> 00:11:03,430
!بالغتان

177
00:11:03,430 --> 00:11:05,240
أيّهما؟

178
00:11:05,240 --> 00:11:08,010
!طالبة واحدة وبالغة واحدة

179
00:11:08,800 --> 00:11:11,690
ينبغي أن تستفيدي من السّعر الأرخص

180
00:11:11,950 --> 00:11:15,900
ليس عدلاً أن تسدّدي ثمناً أكبر
ونحن في نفس العمر

181
00:11:17,170 --> 00:11:20,680
هل تريدين إذاً أن تسدّدي
وسطي سعر تذكرتينا؟

182
00:11:20,680 --> 00:11:23,780
موافقة، سأسدّدُ قليلاً من ثمن تذكرتكِ

183
00:11:24,950 --> 00:11:26,540
!فُشار

184
00:11:26,540 --> 00:11:28,470
!أريدُ فُشاراً

185
00:11:30,810 --> 00:11:33,510
...لديهم مُملّح، كاراميل، و

186
00:11:34,200 --> 00:11:37,210
كاراميل بالموز موسميّة؟

187
00:11:37,620 --> 00:11:38,840
!يبدو هذا لذيذاً

188
00:11:38,840 --> 00:11:40,420
حقّاً؟

189
00:11:40,980 --> 00:11:43,260
هل يمكنني الحصول على فُشاراً مُملّحاً وصودا بالبطّيخ؟

190
00:11:43,260 --> 00:11:45,140
مُحافِظة للغاية

191
00:11:46,410 --> 00:11:49,680
الكاراميل بالموز حلوٌ إلى حدّ مقرف

192
00:11:49,910 --> 00:11:51,810
ألم يبيّن اسم النّكهة ذلك؟

193
00:11:53,340 --> 00:11:57,550
نحنُ نوزِّع عصا ضوئيّة للأطفال

194
00:11:57,550 --> 00:11:58,810
تفضّلي

195
00:11:58,810 --> 00:11:59,990
!شكراً لكِ

196
00:12:00,690 --> 00:12:02,320
أريدُ واحدة

197
00:12:02,320 --> 00:12:03,980
أريدُ واحدة، لكن لا أستطيع

198
00:12:03,980 --> 00:12:05,280
فأنا بالغة

199
00:12:05,280 --> 00:12:07,530
أنا واثقة أنّكِ تستطيعين الحصول على واحدة يا نينيتشي

200
00:12:07,980 --> 00:12:08,830
تفضّلي

201
00:12:10,150 --> 00:12:11,160
هل يحقُّ لي؟

202
00:12:11,160 --> 00:12:12,540
بالطبع

203
00:12:13,630 --> 00:12:15,210
حصلَتْ على واحدة بالفعل

204
00:12:15,210 --> 00:12:17,210
يمكنكِ الحصول على واحدة كذلك

205
00:12:20,610 --> 00:12:22,180
لحظة، أنا؟

206
00:12:24,950 --> 00:12:26,640
لا أعرف كيف أعبّر عن شعوري

207
00:12:26,910 --> 00:12:30,790
تلوّحين بها أثناء الفيلم لتشجّيع مون رينجر

208
00:12:30,790 --> 00:12:32,230
رائع، لم أكن أعلم ذلك

209
00:12:32,550 --> 00:12:35,510
لكن أنا مسرورة لأنّكِ استطعتِ المجيء اليوم

210
00:12:35,510 --> 00:12:36,790
لماذا؟

211
00:12:36,790 --> 00:12:40,820
،لأنّني لو دعيتُ صديقاتي لمشاهدة هذا الفيلم

212
00:12:40,820 --> 00:12:42,680
فسيُعاملنَني كتلميذة في الابتدائيّة

213
00:12:42,680 --> 00:12:44,490
أنتِ مُدرِكة لحالتكِ الطفوليّة إذاً

214
00:12:44,490 --> 00:12:49,790
هل "الفتاة السّاحرة مون رينجر" يستحقُّ
المشاهدة سرّاً حقّاً؟

215
00:12:50,040 --> 00:12:51,150
!بالطبع

216
00:12:51,150 --> 00:12:53,510
فقط لكونه خُصِّصَ للأطفال أمر لا يدعو للسخرية

217
00:12:53,510 --> 00:12:55,710
!سيحقّق شهرة واسعة قريباً

218
00:12:55,990 --> 00:12:59,680
هل يحبُّ أحد في مكان عملكِ
أنمي كهذا؟

219
00:12:59,680 --> 00:13:01,800
أم هل يلعبُ الجميع الألعاب؟

220
00:13:02,210 --> 00:13:05,330
أنا متأكّدة أنّهن لا يلعبن الألعاب
لكن لا أدري

221
00:13:05,330 --> 00:13:08,690
قد تحبّ زميلتي في العمل هذا الأنمي
كونها تمتلك كثيراً من دُمى الشخصيّات

222
00:13:08,690 --> 00:13:10,970
أيحقُّ لكم تزيين مقاعدكم بدُمى الشخصيّات؟

223
00:13:10,970 --> 00:13:13,450
لديها عدد هائل من الدُّمى في مقعدها

224
00:13:13,450 --> 00:13:15,730
لعلَّها هنا في المسرح

225
00:13:15,730 --> 00:13:17,170
مستحيل

226
00:13:23,570 --> 00:13:24,750
نفد فُشاري

227
00:13:24,750 --> 00:13:25,700
أنتِ سريعة جدّاً

228
00:13:25,700 --> 00:13:27,570
يمكنكِ أن تشاركيني قليلاً

229
00:13:27,820 --> 00:13:28,990
حقّاً؟

230
00:13:28,990 --> 00:13:30,330
لا أريد أن أسمن

231
00:13:32,200 --> 00:13:33,580
لا داعي

232
00:13:33,580 --> 00:13:34,440
لماذا؟

233
00:13:34,440 --> 00:13:35,580
!لا يوجد سبب

234
00:13:35,930 --> 00:13:37,410
لقد بدأ

235
00:13:42,550 --> 00:13:44,450
!ها أنتِ ذي يا مون رينجر

236
00:13:44,450 --> 00:13:46,220
!النّجدة

237
00:13:46,220 --> 00:13:48,840
!كيف تجرؤ على إبكاء الأطفال؟

238
00:13:48,840 --> 00:13:50,940
!سأدعك تدفع الثّمن

239
00:13:56,940 --> 00:14:00,470
!طلقة قدّاس العزاء ميغا الجزيئيّة

240
00:14:02,480 --> 00:14:04,780
مستحيل

241
00:14:06,650 --> 00:14:09,770
رائع! كانت القصّة جميلة

242
00:14:09,770 --> 00:14:12,380
تأثّرتُ قليلاً بصراحة

243
00:14:12,380 --> 00:14:13,910
وحتّى أنّني لوّحتُ بالعصا

244
00:14:13,910 --> 00:14:20,460
!طلقة قدّاس العزاء ميغا الجزيئيّة

245
00:14:16,790 --> 00:14:18,080
هذا خطأ

246
00:14:22,250 --> 00:14:24,210
كلتاهما خاطئتان

247
00:14:26,280 --> 00:14:28,800
!طلقة قدّاس العزاء ميغا الجزيئيّة

248
00:14:30,030 --> 00:14:33,810
لكن كان ممتعاً في الواقع، لهذا أحتاج إلى كُتيّب

249
00:14:35,180 --> 00:14:37,020
لكن لا أملك الشّجاعة

250
00:14:37,400 --> 00:14:39,700
ألن تشتري شيئاً يا آوتشي؟

251
00:14:39,700 --> 00:14:41,080
!ما أشجعها

252
00:14:41,610 --> 00:14:44,270
هذا محرج جدّاً بالنسبة لي

253
00:14:44,270 --> 00:14:45,580
لماذا أنتِ خجِلة؟

254
00:14:45,580 --> 00:14:46,880
!اصمتي

255
00:14:46,880 --> 00:14:48,650
ماذا تشترين يا نينيتشي؟

256
00:14:48,650 --> 00:14:51,010
الكتيّب وأسطوانة الأغاني ومُلصَق

257
00:14:51,010 --> 00:14:56,330
هذا ما أريده لكن لا أملك مالاً
لهذا لا أستطيع أن أشتري سوى الكتيّب

258
00:14:57,450 --> 00:15:00,340
حصلتُ على راتبي الأوّل قبل أيّام

259
00:15:00,340 --> 00:15:02,000
هل تريدين استدانة بعض المال؟

260
00:15:02,000 --> 00:15:03,820
لـ-لا

261
00:15:03,820 --> 00:15:08,070
استدانة المال سيُفسِد صداقتنا

262
00:15:08,070 --> 00:15:10,430
أنا متفاجئة من معرفتكِ بذلك

263
00:15:10,430 --> 00:15:13,830
لكنّكِ قلقة بشأن صداقتنا

264
00:15:13,830 --> 00:15:14,760
يروقني هذا

265
00:15:14,990 --> 00:15:16,490
بـ-بالطبع

266
00:15:16,490 --> 00:15:18,270
...مقارنة بالسّلع

267
00:15:18,270 --> 00:15:20,180
...أحتاجُ للسّلع حقّاً

268
00:15:22,190 --> 00:15:25,320
ما-ماذا لو اشتريتِها لي

269
00:15:25,320 --> 00:15:28,780
وأخذتها منكِ عندما أحظى بالمال؟

270
00:15:29,290 --> 00:15:30,350
ماذا؟

271
00:15:30,350 --> 00:15:33,510
إن لم تأتي لأخذها فسيُفسِد ذلك صداقتنا

272
00:15:33,510 --> 00:15:35,780
!أنا متأكّدة أنّ الأمور ستكون على ما يُرام

273
00:15:38,580 --> 00:15:43,040
ابتداء من اليوم، سيقتصر عملكِ
على تصميم نموذج ثلاثي الأبعاد من صوفيا-تشان

274
00:15:43,980 --> 00:15:47,960
صوفيا-تشان هي شخصيّة هامّة قابلة للّعب
سيتمّ استخدامها حتّى في الأحداث

275
00:15:47,960 --> 00:15:50,550
لذا احرصي على جعلها أكثر بريقاً من القرويّين

276
00:15:50,550 --> 00:15:51,760
أكثر بريقاً؟

277
00:15:51,760 --> 00:15:56,370
هنالك الكثير من وحدات البكسل التي يمكنكِ
استخدامها على الشّاشة

278
00:15:56,370 --> 00:15:59,430
لهذا يتمّ تعديل كثافة الشخصيّة بحسبِ الأهمّية

279
00:15:59,660 --> 00:16:03,090
لكن صوفيا-تشان ستموت، صحيح؟

280
00:16:03,090 --> 00:16:05,110
الأمر ليس بيدنا

281
00:16:05,720 --> 00:16:08,110
كو-تشان، علينا أن نذهب لاجتماع

282
00:16:08,110 --> 00:16:09,510
تذكّرت

283
00:16:18,290 --> 00:16:21,100
مثل من ينبغي أن أكون؟

284
00:16:21,620 --> 00:16:24,290
حريّ بكِ ألّا تفكّري بأفكار غريبة

285
00:16:25,450 --> 00:16:27,790
ماذا يتناقشن في الاجتماعات؟

286
00:16:27,790 --> 00:16:29,820
ألا تعلمين يا أوبا-تشان؟

287
00:16:29,820 --> 00:16:32,130
يمكنكِ الاطّلاع على الإجراءات في كمبيوترك

288
00:16:32,130 --> 00:16:32,570
ماذا؟

289
00:16:32,570 --> 00:16:33,720
لم أكن أعلم ذلك

290
00:16:33,970 --> 00:16:36,860
جوهريّاً، قادة الفرق والمُدراء يجتمعون

291
00:16:36,860 --> 00:16:38,560
من عدم وجود أي مشاكل

292
00:16:39,230 --> 00:16:41,640
ماذا يحدثُ عندما تقع مشاكل؟

293
00:16:44,590 --> 00:16:47,010
مثلاً... إلغاء الإصدار؟

294
00:16:47,010 --> 00:16:48,060
!ستكون هذه مصيبة

295
00:16:48,060 --> 00:16:49,590
لكن نادراً ما يحدث هذا

296
00:16:51,190 --> 00:16:52,740
حسناً يا إيجيما-كُن

297
00:16:52,740 --> 00:16:53,900
كيف حالُ عملكِ؟

298
00:16:55,150 --> 00:16:56,840
عمّاذا تتكلّمين؟

299
00:16:56,840 --> 00:16:58,620
!أنا أحاكي اجتماعاً

300
00:17:00,230 --> 00:17:03,440
أتّبع برنامجاً وهو العمل على وحش واحد أسبوعياً

301
00:17:03,440 --> 00:17:04,830
—كيف حال عملـ

302
00:17:06,730 --> 00:17:07,420
انسي الأمر

303
00:17:07,420 --> 00:17:10,350
تبدين وكأنّكِ تريدين أن يطرح أحدٌ سؤالاً عليكِ

304
00:17:11,130 --> 00:17:12,750
كيف حالكِ يا أوبا-تشان؟

305
00:17:13,430 --> 00:17:17,640
أظنّكِ ينبغي أن تسألي هاجيمي-سان أولاً

306
00:17:19,140 --> 00:17:21,180
لِذا جوهريّاً، أنا أبلي بلاء حسناً

307
00:17:21,180 --> 00:17:21,880
حسناً

308
00:17:21,880 --> 00:17:23,370
كيف حالكِ يا أوبا-تشان؟

309
00:17:23,370 --> 00:17:24,600
أهذا هو ردّكِ؟

310
00:17:24,600 --> 00:17:26,440
وتقولين أنّكِ من كانساي؟

311
00:17:26,800 --> 00:17:29,910
،لقد تأخّرتُ قليلاً

312
00:17:29,910 --> 00:17:31,840
،لكن حصلتُ على الموافقة على تصميمي

313
00:17:31,840 --> 00:17:34,250
لهذا سأبدأ بالعمل على النّموذج اليوم

314
00:17:34,250 --> 00:17:37,950
أوبا-تشان، أنتِ فتاةٌ جيّدة لدرجة تُبلِغ حتّى
عن تأخّرها في العمل

315
00:17:38,220 --> 00:17:39,460
...الـ-المعذرة

316
00:17:39,460 --> 00:17:41,870
تحدّقُ هاجيمي-سان بي بكلّ حسد

317
00:17:41,870 --> 00:17:42,290
لا، لستُ كذلك

318
00:17:43,370 --> 00:17:46,090
هيفومي-سينباي، كيف حالكِ أنتِ؟

319
00:17:47,470 --> 00:17:49,730
...حقيقة عدد الشخصيّات المتبقّية

320
00:17:49,730 --> 00:17:51,210
...وعدد الأيّام المتبقّية

321
00:17:51,730 --> 00:17:54,340
.وعدم التّطابق بينهما... تخيفني

322
00:17:55,470 --> 00:17:57,430
معك حقّ

323
00:17:57,430 --> 00:17:59,300
سننشغل

324
00:17:59,300 --> 00:18:00,570
أنا آسفة

325
00:18:00,570 --> 00:18:02,560
أخطأتُ في الحِسابات

326
00:18:02,560 --> 00:18:07,230
سأطلبُ من فريق الشخصيّات البقاء
بضعة ليالٍ أو المجيء في أيّام العطلة

327
00:18:07,230 --> 00:18:12,640
حقيقة طريفة: أمر الشّركة بالحضور في أيّام العطلة
يُكسبكنّ إضافيّاً، لِذا فهذا جيّد

328
00:18:12,640 --> 00:18:14,280
أحسنتِ تخفيف الأعباء

329
00:18:14,610 --> 00:18:16,820
سأحضر في أيّام العطلة إذاً

330
00:18:17,420 --> 00:18:18,390
وأنا أيضاً

331
00:18:19,090 --> 00:18:20,260
وأنتِ يا أوبا؟

332
00:18:20,260 --> 00:18:22,180
ما المقصود بـ"إضافي"؟

333
00:18:22,180 --> 00:18:23,540
هل علينا أن نبدأ من هناك؟

334
00:18:24,220 --> 00:18:25,200
!انظرن علامَ حصلت

335
00:18:25,460 --> 00:18:26,450
!كيس نوم

336
00:18:26,450 --> 00:18:28,740
أنتِ تبذلين أقصى طاقتكِ

337
00:18:28,740 --> 00:18:31,390
ستسهرين اللّيل كلّه وتأتين في أيّام العطلة؟

338
00:18:31,390 --> 00:18:32,970
في المرّة الأولى فقط

339
00:18:32,970 --> 00:18:35,100
أريدُ أن أستغرق وقتاً طويلاً على صوفيا-تشان

340
00:18:35,100 --> 00:18:37,580
!وحتّى أنّني اشتريتُ غياراً من الملابس

341
00:18:37,580 --> 00:18:40,090
تبدين مُستمتعة، لكن هذه ساعات إضافيّة

342
00:18:40,090 --> 00:18:40,780
!أعلم

343
00:18:41,670 --> 00:18:45,210
في اللّيل، أشعلي الإنارة في قسمكِ فقط

344
00:18:45,210 --> 00:18:45,960
!حسناً

345
00:18:53,900 --> 00:18:54,660
!بو

346
00:19:00,320 --> 00:19:01,740
تبّاً

347
00:19:03,270 --> 00:19:05,870
،لو كانت لا تستخدم مثل هذه المقالب

348
00:19:05,870 --> 00:19:08,540
.لاحترمتُها بصراحة

349
00:19:12,370 --> 00:19:13,590
لم أعرفكِ لوهلة

350
00:19:16,330 --> 00:19:18,670
أنتِ ظريفة حتّى عندما ترتدين ثياباً رثّاً

351
00:19:26,570 --> 00:19:27,180
!حسناً

352
00:19:27,180 --> 00:19:28,850
!لنفعلها

353
00:19:37,150 --> 00:19:39,360
!أوبا

354
00:19:40,780 --> 00:19:41,850
أين أنا؟

355
00:19:41,850 --> 00:19:43,030
!في العمل

356
00:19:43,480 --> 00:19:45,910
إن كان لديكِ كيس للنوم، فنامي هُناك

357
00:19:45,910 --> 00:19:47,340
ستمرضين

358
00:19:47,340 --> 00:19:49,370
هذا صحيح

359
00:19:49,370 --> 00:19:51,770
سأخلد إلى النّوم قريباً أيضاً

360
00:19:52,260 --> 00:19:54,850
تصبحين على خير

361
00:19:57,740 --> 00:19:58,730
!مفاجأة

362
00:19:58,730 --> 00:20:00,450
!كيس الدبّ

363
00:20:10,710 --> 00:20:13,650
يبدو النّوم في العمل غريباً بعض الشيء

364
00:20:14,270 --> 00:20:17,730
ومن المُمتع رؤية شيء جديد

365
00:20:24,990 --> 00:20:27,700
لا أستطيع الخلود إلى النّوم وهؤلاء يُراقبونني

366
00:20:28,640 --> 00:20:32,610
ياغامي-سان

367
00:20:33,960 --> 00:20:36,130
لا أستطيع النّوم

368
00:20:39,680 --> 00:20:41,160
ما-ما هذا؟

369
00:20:41,160 --> 00:20:43,260
إنّه كيس نوم على شكل دبّ

370
00:20:43,260 --> 00:20:46,090
إن كنتِ لا تستطيعين النّوم فنامي معي إذاً

371
00:20:46,090 --> 00:20:49,060
أو غرفة الاجتماعات هي غرفة خاصّة
لِذا يمكنكِ النّوم هناك

372
00:20:49,060 --> 00:20:51,680
سأذهبُ إلى غرفة الاجتماعات

373
00:20:51,680 --> 00:20:53,580
حسناً، تصبحين على خير

374
00:21:02,790 --> 00:21:03,640
صباح الخير

375
00:21:03,640 --> 00:21:04,530
صباح النّور

376
00:21:05,580 --> 00:21:06,630
صباح الخير

377
00:21:06,630 --> 00:21:08,370
هل خرجت أوبا-تشان لتناول الفطور؟

378
00:21:12,160 --> 00:21:13,930
!أوبا! استيقظي

379
00:21:13,930 --> 00:21:15,710
!الجميع جاء للعمل

380
00:21:15,710 --> 00:21:17,610
!أوبا

381
00:22:48,650 --> 00:22:49,740
ماذا؟

382
00:22:49,740 --> 00:22:53,110
ذهبتِ لحضور فيلم الفتاة السّاحرة مون رينجر؟

383
00:22:53,110 --> 00:22:53,930
أجل

384
00:22:53,930 --> 00:22:55,620
دعَتْني صديقة طفولتي

385
00:22:55,620 --> 00:22:57,210
رحتُ أيضاً

386
00:22:57,210 --> 00:22:58,480
بُعيد مُشاهدة استعراض بطوليّ

387
00:22:58,480 --> 00:22:59,480
حقّاً؟

388
00:23:00,000 --> 00:23:02,710
!طلقة قدّاس العزاء ميغا الجزيئيّة

389
00:23:02,710 --> 00:23:06,210
لا، يُفترض أن تكون هكذا
!طلقة قدّاس العزاء ميغا الجزيئيّة

390
00:23:06,210 --> 00:23:08,090
كلتاكما مخطئتان

391
00:23:10,130 --> 00:23:13,200
لا تقولي لي... انّكِ رحتِ أيضاً يا يون؟

392
00:23:15,260 --> 00:23:18,270
توسّل إليّ أخي وأختي كي أذهب فرافقتُهما

393
00:23:18,270 --> 00:23:19,290
هذا كُل ما في الأمر

394
00:23:19,290 --> 00:23:21,200
كنتِ مُرغمة على الذهاب؟

395
00:23:21,200 --> 00:23:22,380
حقّاً؟

396
00:23:22,380 --> 00:23:23,590
!حقّاً

397
00:23:25,960 --> 00:23:27,630
هل مون رينجر مشهورة؟

398
00:23:27,630 --> 00:23:29,260
!بالطبع

399
00:23:29,260 --> 00:23:33,410
يتحدّثُ عنها الجميع في شبكتي الاجتماعيّة يوميّاً

400
00:23:33,410 --> 00:23:36,540
هذا لأنّك تتبعين أُناساً بنفس الهِوايات

401
00:23:36,540 --> 00:23:39,560
:الحلقة القادمة
".من فضلك درّبي الموظَّفات الجديدات جيّداً"

402
00:23:37,180 --> 00:23:41,000
الحلقة القادمة