!يمكنك فعلها! أيّها النجم اللامع

193
00:14:43,740 --> 00:14:46,910
!يمكنك فعلها! أيّها النجم اللامع

194
00:14:47,120 --> 00:14:50,000
...قناعي المقدّس

195
00:14:50,080 --> 00:14:52,960
!كيف تجرؤ على خدش روح رجل مقنع

196
00:14:59,970 --> 00:15:03,340
التزويد البطاقة قد اكتمل

197
00:15:04,180 --> 00:15:06,640
!نهايتك حانت، أيّها الشرير

198
00:15:07,010 --> 00:15:08,100
!يمكنك الموت الآن

199
00:15:08,470 --> 00:15:11,480
لِما يتغير قناعك كلما أصبحت أقوى؟

200
00:15:11,980 --> 00:15:12,980
!القتل المميز

201
00:15:13,650 --> 00:15:15,230
!نجم لاريات

202
00:15:15,310 --> 00:15:16,320
!نجم

203
00:15:17,480 --> 00:15:19,440
لا يمكنك أن تُريح يديك بعد الآن

204
00:15:19,530 --> 00:15:21,490
!أو تضع قدميك على الأرض

205
00:15:21,820 --> 00:15:24,110
!لكمة النجم الصاروخية

206
00:15:24,910 --> 00:15:27,410
!نجم! نجم! نجم! نجم

207
00:15:27,530 --> 00:15:30,910
!لكمة النجم القاتلة

208
00:15:31,790 --> 00:15:35,830
!نجم! نجم! نجم! نجم
!نجم! نجم! نجم! نجم

209
00:15:35,920 --> 00:15:37,630
!نجم

210
00:15:37,710 --> 00:15:40,420
!سوف تبقَ في الهواء هكذا إلى الأبد

211
00:15:42,130 --> 00:15:43,260
!....وبعدها

212
00:15:43,300 --> 00:15:46,720
!مُت على يد القوة السماويّة للنجم اللامع

213
00:15:46,970 --> 00:15:51,430
!سوف تتحوّل إلى غبار، ولن تعودًا أبدًا إلى الأرض

214
00:15:51,850 --> 00:15:55,350
!أنت رائع للغاية، أيّها النجم اللامع

215
00:16:04,910 --> 00:16:06,240
خُذ هذه

216
00:16:09,990 --> 00:16:11,830
...ومضة النجم

217
00:16:11,870 --> 00:16:14,160
!سوبرنوفا

218
00:16:18,790 --> 00:16:20,920
...هاه؟ مهلًا

219
00:16:28,050 --> 00:16:31,390
نجم.... لامع؟

220
00:16:36,810 --> 00:16:38,900
!!لا تقلق، جيمس

221
00:16:39,190 --> 00:16:42,860
!أنا وأنت وجهان لعملة واحدة، نجم ومشجع

222
00:16:43,360 --> 00:16:44,900
طالما أنا حي

223
00:16:44,900 --> 00:16:46,860
!أنت سوف تعود للحياة بنهاية الأمر

224
00:16:47,200 --> 00:16:48,870
،ولكن ما هو أهم

225
00:16:48,870 --> 00:16:51,240
!وداعًا، أيّها الشرير

226
00:17:01,800 --> 00:17:04,170
جمجمة أفعى عملاقة؟

227
00:17:04,840 --> 00:17:06,630
أذلك هو البانكاي الخاص به؟

228
00:17:06,930 --> 00:17:08,930
لا بدّ وأنّه أطلق البانكاي في لحظاته الأخيرة

229
00:17:09,050 --> 00:17:10,470
بدافع اليأس

230
00:17:10,800 --> 00:17:11,930
كم هذا مثير للشفقة

231
00:17:14,730 --> 00:17:15,810
ماذا؟

232
00:17:23,610 --> 00:17:25,110
ما الّذي يحدث؟

233
00:17:25,780 --> 00:17:29,450
هل يُفترض للبانكاي أن يُغير هيئتهُ بهذه الشاكلة؟

234
00:17:31,240 --> 00:17:33,290
"هيهيو زابيمارو"

235
00:17:33,490 --> 00:17:37,330
"الفرقة صفر - راهب مقلة العين - إيشيبي هيوشيبي

236
00:17:34,370 --> 00:17:36,960
رينجي، ذلك الاسم محض كذبة

237
00:17:37,460 --> 00:17:39,540
ماذا؟ كذبة؟

238
00:17:39,790 --> 00:17:43,800
لأكون أكثر دقة، إنّه نصف الاسم وحسب

239
00:17:43,840 --> 00:17:45,920
ماذا يُفترض بهذا أن يعني؟

240
00:17:46,220 --> 00:17:51,050
هذا يعني بأنّه لم يعترض بك البانكاي بشكل كامل

241
00:17:51,850 --> 00:17:52,890
أنت تمزح، صحيح؟

242
00:17:53,260 --> 00:17:56,060
....ولكننا قاتلنا معًا لفترةٍ طويلة

243
00:17:56,560 --> 00:17:57,560
...مهلًا

244
00:17:57,640 --> 00:18:00,650
كيف تعرف بشأن كل هذا؟

245
00:18:02,060 --> 00:18:05,570
أنا من اخترع اسم الزانباكتو

246
00:18:05,980 --> 00:18:06,990
ماذا؟

247
00:18:07,780 --> 00:18:09,780
الشيكاي والبانكاي أيضًا

248
00:18:10,160 --> 00:18:12,910
كنتُ أول من اطلق الأسماء على أيّ ظاهرة

249
00:18:12,990 --> 00:18:15,330
تحدث في مجتمع الأرواح

250
00:18:16,160 --> 00:18:18,500
ماذا.... تكون؟

251
00:18:19,210 --> 00:18:23,750
"الاسم الّذي مُنح ليّ من قبل ملك الأرواح هو " ماناكو أوشو

252
00:18:23,920 --> 00:18:24,920
هاه؟

253
00:18:25,250 --> 00:18:29,420
"يعني "الناطق بالاسم الحقيقي

254
00:18:30,720 --> 00:18:35,680
سوف أخبرك بالاسم الحقيقيّ لبانكاي زابيمارو

255
00:18:36,220 --> 00:18:38,850
عليك أن تُثبت قوتك لزابيمارو

256
00:18:38,980 --> 00:18:41,940
وذلك كي تستطيع استدعائه بذلك الاسم

257
00:18:42,690 --> 00:18:44,520
!هنا والآن

258
00:18:47,120 --> 00:18:48,520
بانكاي

259
00:18:55,000 --> 00:18:56,990
ساواو زابيمارو

260
00:19:01,870 --> 00:19:04,000
...ذلك البانكاي خطير

261
00:19:04,540 --> 00:19:05,540
إنّه كذلك

262
00:19:05,880 --> 00:19:08,670
لقد تطلّب الكثير من الجهد قبل أن أتمكن من نطق اسمه

263
00:19:09,090 --> 00:19:13,050
في هذه اللحظة، روحي تشتعل

264
00:19:13,140 --> 00:19:15,970
!بحس العدالة وذلك لهزيمتك

265
00:19:16,220 --> 00:19:17,260
!هيهياو

266
00:19:20,980 --> 00:19:23,350
!...هذا لا شيء

267
00:19:34,530 --> 00:19:36,740
!أيّها الحثالة

268
00:19:37,580 --> 00:19:39,830
!كيف تجرؤ على سحق ذراع النجم اليسرى

269
00:19:39,950 --> 00:19:42,710
!سوف تدفع ثمن هذا، أيّها النكرة

270
00:19:43,080 --> 00:19:45,380
!لستُ مهتمًا بالعادلة أو الشر بعد الآن

271
00:19:45,790 --> 00:19:47,130
!أنت ميت لا محالة

272
00:19:47,460 --> 00:19:48,500
أوروتشياو

273
00:20:02,310 --> 00:20:03,810
ساواو زابيمارو

274
00:20:04,900 --> 00:20:06,400
زاغا تيبو

275
00:20:20,240 --> 00:20:22,000
هل أحرقت نفسك؟

276
00:20:24,000 --> 00:20:25,000
ولكن هذا ما ابتغيته، صحيح؟

277
00:20:26,500 --> 00:20:28,040
!أيّها النجم اللامع

278
00:22:04,770 --> 00:22:06,850
...إذًا جيمس قد مات

279
00:22:08,100 --> 00:22:09,440
لقد أبليت حسنًا

280
00:22:10,770 --> 00:22:12,320
...والآن عُد

281
00:22:15,820 --> 00:22:17,610
عُد إليّ

282
00:22:34,800 --> 00:22:35,800
ما الّذي قد....؟

283
00:22:36,090 --> 00:22:38,760
جلالته يوهاباخ نائم

284
00:22:39,680 --> 00:22:41,800
فقط عندما يموت يمكنهُ أن يعود

285
00:22:41,970 --> 00:22:45,890
ليصبح أب الكوينشي لتعزيز قوته

286
00:22:46,560 --> 00:22:49,150
لا يجب أن يُزعج أثناء نومه

287
00:22:49,690 --> 00:22:51,360
ولكن لِما أنت هنا؟

288
00:22:52,110 --> 00:22:54,400
...أنا وجلالتهُ مرتبطان

289
00:22:54,860 --> 00:22:59,360
أو، يجب أن أقول، بأن جلالته مرتبط بجميع الكوينشي

290
00:23:00,030 --> 00:23:01,660
ولكن تعرف ذلك بالفعل

291
00:23:02,660 --> 00:23:03,660
...أجل

292
00:23:04,080 --> 00:23:07,910
ولكن أتعلم لِما جلالته يمتلك مثل تلك القدرة؟

293
00:23:08,540 --> 00:23:10,830
أيّ نوع من الوجود جلالته يكون؟

294
00:23:11,670 --> 00:23:15,420
،أعتقد ولا حتّى جدّك، سوكين إيشيدا

295
00:23:15,550 --> 00:23:17,300
كان قادر على اكتشاف ذلك

296
00:23:22,600 --> 00:23:24,850
...أعتقد بمقدوري أن أخبرك

297
00:23:26,020 --> 00:23:28,640
بما أنّك خليفة جلالته

298
00:23:35,530 --> 00:23:48,130
لا يوجد فرق بين العيش والسماح لك بالعيش

299
00:23:39,580 --> 00:23:48,130
مثلما لا يوجد فرق بين الموت أو أن تُقتل