1
00:00:03,220 --> 00:00:04,810
!لـ-ليفياتانو

2
00:00:04,810 --> 00:00:05,320
!سكوت

3
00:00:05,320 --> 00:00:07,420
.اصمتوا

4
00:00:07,420 --> 00:00:09,100
.فات الأوان على الهرب

5
00:00:09,100 --> 00:00:10,730
.علينا أن ننتظر حتّى يمر

6
00:00:18,750 --> 00:00:21,190
.يبدو أنّه رحل

7
00:00:22,090 --> 00:00:24,770
.حسبتُ أنّنا هالكون

8
00:00:24,770 --> 00:00:28,080
أصبتُ بنصب حاجز
.جعل اكتشافنا أصعب

9
00:00:28,080 --> 00:00:30,300
ماذا كان يفعل هنا؟

10
00:00:30,580 --> 00:00:33,330
.يعتبرُ كلّ إنسان عدوه

11
00:00:33,330 --> 00:00:35,560
.ربّما كان في طريقه ليفعل شيئًا لروندين

12
00:00:35,560 --> 00:00:37,780
.أو ربّما فعل بالفعل وهو عائد الآن

13
00:00:37,780 --> 00:00:39,860
...في كلّ الأحوال، ستتعرّض روندين لـ

14
00:00:39,860 --> 00:00:41,050
!الأمير ليونارد

15
00:00:41,390 --> 00:00:44,270
!تتعرّض روندين لهجوم من الوحوش

16
00:00:46,630 --> 00:00:48,920
يا سموّك، حين تفكّر بشيء
،كهذا المرّة القادمة

17
00:00:48,920 --> 00:00:51,170
هلّا تمتنع عن ذكرهِ رجاء؟

18
00:00:51,170 --> 00:00:52,920
!لا تلُمني

19
00:00:58,200 --> 00:00:59,950
.ثعبان بحر

20
00:01:01,310 --> 00:01:02,540
...هذه

21
00:01:02,840 --> 00:01:04,280
سفينة ليو؟

22
00:01:04,620 --> 00:01:06,770
!يا قبطان! تقدم بأقصى سرعة

23
00:01:06,770 --> 00:01:09,380
!اندفع نحو الميناء
!سنحمي أخي الأكبر

24
00:01:09,380 --> 00:01:10,580
!مفهوم

25
00:01:10,580 --> 00:01:12,600
!ليستعد كلّ الطاقم للمعركة

26
00:01:13,260 --> 00:01:17,360
جهّزوا المدافع السحرية التي
!أعارتنا إيّاها ألباترو

27
00:01:17,360 --> 00:01:18,930
!نعم

28
00:01:18,930 --> 00:01:23,290
والآن، هل سأحظى بفرصة للعودة؟

29
00:03:07,470 --> 00:03:09,990
!لا حاجة للمخاطرة لقتاله يا قبطان

30
00:03:09,990 --> 00:03:11,590
!اجذب انتباهه فقط

31
00:03:11,590 --> 00:03:15,690
أيّها الأمير الواهن، لا، أقصد
.الأمير أرنولد، أنت تطلبُ المستحيل

32
00:03:15,690 --> 00:03:18,090
.اذهب للاختباء في غرفتك إن كنتَ خائفًا

33
00:03:18,750 --> 00:03:22,140
كيف يستطيعُ أخي
تحفيز النّاس دائمًا؟

34
00:03:22,380 --> 00:03:26,380
ثعبان بحر بهذا القُرب من الميناء؟

35
00:03:27,300 --> 00:03:30,300
التفّ إلى يسار ثعبان
!البحر يا قبطان

36
00:03:30,300 --> 00:03:33,090
!كفى عن طلب المستحيل يا أمير

37
00:03:33,090 --> 00:03:34,150
...ليس لدينا وقت

38
00:03:34,370 --> 00:03:36,060
!افعلها فقط

39
00:03:36,830 --> 00:03:37,860
!أتى ليو

40
00:03:37,860 --> 00:03:40,730
!سنتعاون لمهاجمة ثعبان البحر

41
00:03:42,730 --> 00:03:44,790
!التف يسارًا يا قبطان

42
00:03:44,790 --> 00:03:45,750
!عُلم

43
00:03:45,750 --> 00:03:47,200
!انعطاف بقوة إلى الميناء

44
00:03:47,200 --> 00:03:48,700
!افتحُوا منافذ المدافع اليمنى

45
00:03:48,700 --> 00:03:51,990
اضربُوا ثعبان البحر
!بأحدث المدافع السحرية

46
00:03:52,610 --> 00:03:54,660
!جاهزون للإطلاق

47
00:03:55,990 --> 00:03:57,480
.لا تتعجّلوا

48
00:03:57,480 --> 00:03:59,170
.اجذبوه أقرب أولًا

49
00:04:01,590 --> 00:04:02,460
!أطلقوا

50
00:04:05,790 --> 00:04:07,890
!جيّد! المَدافع قويّة كما توقّعنا

51
00:04:07,890 --> 00:04:09,220
!واصلوا الإطلاق

52
00:04:18,260 --> 00:04:19,770
!لم ننتهِ بعد

53
00:04:19,770 --> 00:04:22,330
!وحوش أصغر تتجه نحو سفينة أخي

54
00:04:22,950 --> 00:04:23,960
!يا قبطان

55
00:04:23,960 --> 00:04:25,110
!نقترب الآن

56
00:04:25,330 --> 00:04:27,290
.استعدُوا للقتال المباشر يا فرسان

57
00:04:27,290 --> 00:04:28,440
!نعم

58
00:04:28,440 --> 00:04:29,190
!مارك

59
00:04:30,760 --> 00:04:33,050
.سأذهب لإنقاذ أخي

60
00:04:33,050 --> 00:04:34,640
.ساندني

61
00:04:35,730 --> 00:04:36,980
.فهمت

62
00:04:36,980 --> 00:04:38,500
!مفهوم

63
00:04:38,500 --> 00:04:40,170
.اترك الأمر كلّه لي

64
00:04:42,710 --> 00:04:43,960
!اهجموا

65
00:05:19,810 --> 00:05:20,950
.تأخّرتَ

66
00:05:20,950 --> 00:05:23,720
.آسف. وقعتُ في بعض المشاكل

67
00:05:23,720 --> 00:05:26,080
.أظننا في مشكلة كافية بالفعل

68
00:05:26,080 --> 00:05:28,810
.حسنًا، اسمع هذا. ستزداد الأمور سوءًا

69
00:05:28,810 --> 00:05:30,500
.يا لها من أخبار سارّة

70
00:05:34,840 --> 00:05:37,510
لم تفعل شيئًا غريبًا
وأنت تتظاهر بأنّك أنا، صحيح؟

71
00:05:37,510 --> 00:05:40,640
.لا. أدّيتُ دوركَ بشكل رائع

72
00:05:40,640 --> 00:05:42,200
.لهذا أنا متعب

73
00:05:42,410 --> 00:05:44,130
.أتفق معك

74
00:05:44,130 --> 00:05:47,030
اجتهدتُ كثيرًا لأتظاهر
.بأنّني أنت وأنا مرهق

75
00:05:47,030 --> 00:05:50,650
،ما إن اجتهدت لتتظاهر بأنّكَ أنا

76
00:05:50,650 --> 00:05:52,280
.أخطأتَ بالفعل

77
00:05:52,570 --> 00:05:53,650
أين إلنا؟

78
00:05:53,650 --> 00:05:55,350
.تقاتل على اليابسة

79
00:05:55,350 --> 00:05:57,310
.حسنًا، سأتركُ الباقي لك

80
00:05:57,310 --> 00:05:58,220
.حسنًا، حسنًا

81
00:05:58,220 --> 00:06:00,210
تريد منّي أن أنهي كلّ هذا، صحيح؟

82
00:06:00,540 --> 00:06:02,560
.تفهمُني

83
00:06:05,180 --> 00:06:06,810
!أيّها الأمير أرنولد

84
00:06:07,370 --> 00:06:09,470
إلى أيّ حد نتراجع
بخطوطنا الدفاعية؟

85
00:06:09,820 --> 00:06:12,960
.سأتركُ القرار لك. سأذهب للنّوم

86
00:06:12,960 --> 00:06:14,510
عذرًا؟

87
00:06:14,510 --> 00:06:15,970
.تصرّف كما تشاء

88
00:06:15,970 --> 00:06:18,320
.سيتكفّل ليو بكل شيء على أيّ حال

89
00:06:19,060 --> 00:06:20,310
...يا للعجب

90
00:06:20,310 --> 00:06:24,180
حسبتُ أنّه أفضل قليلًا
...في غياب الأمير ليونارد

91
00:06:28,420 --> 00:06:31,760
.أنا سعيد بسلامتك أيّها الأمير ليونارد

92
00:06:31,760 --> 00:06:36,090
.وأشكرك على قتالك بجانب أسطولنا

93
00:06:36,090 --> 00:06:40,060
لكنَّك تقولُ أنَّ تنين
البحر ليفياتانو قد استيقظ؟

94
00:06:40,060 --> 00:06:43,650
ألهذا السبب ظهر ثعبان البحر ذاك؟

95
00:06:43,650 --> 00:06:47,680
نعم، أعتقد أنَّ هذا هو
.التفسير السليم يا جلالتك

96
00:06:49,600 --> 00:06:52,100
ما زال آرن يتظاهر بأنَّه أنت؟

97
00:06:52,100 --> 00:06:56,400
سيكون أسرع لو تولّى الشرح
عوضًا عنّي، صحيح؟

98
00:06:56,400 --> 00:06:58,600
.حسنًا... هذا صحيح

99
00:06:59,560 --> 00:07:04,120
إذًا الخطر لا يطال ألباترو
فقط بل روندين أيضًا؟

100
00:07:04,120 --> 00:07:06,810
.أظننا لا نستطيع تجاهل ذلك

101
00:07:06,810 --> 00:07:10,320
،إن قُطِعت طُرق البحر
.فلن نستطيع استيراد أيّ شيء

102
00:07:10,320 --> 00:07:12,900
.سينهار هذا البلد

103
00:07:13,210 --> 00:07:15,030
.أنت محق

104
00:07:15,030 --> 00:07:19,750
وبالتّالي، أنا ليونارد ريكس أدلر
،بصفتي سفير الإمبراطورية فوق العادة

105
00:07:19,750 --> 00:07:22,100
.أطرحُ هذا المقترح عليك أيّها الدوق روندين

106
00:07:22,570 --> 00:07:24,980
،إن أردنا مواجهة هذا الخطر

107
00:07:24,980 --> 00:07:27,190
،أرجو أن تنسى الضغائن القديمة

108
00:07:27,190 --> 00:07:31,820
وتعقد هدنة مؤقتة مع ألباترو
.وتُشكّل تحالفًا ضدّ التنين

109
00:07:31,820 --> 00:07:35,710
.أعدكَ أنَّ الإمبراطورية ستدعمُ هذا التحالف

110
00:07:36,840 --> 00:07:38,420
...لكن

111
00:07:41,370 --> 00:07:42,540
.مفهوم

112
00:07:42,540 --> 00:07:44,570
.سأقبل مقترحك

113
00:07:44,570 --> 00:07:47,460
،سنوافق على هدنة مُؤقتة

114
00:07:47,460 --> 00:07:50,390
.وسنُرسل أسطولنا إلى ألباترو لمواجهة التنين

115
00:07:50,390 --> 00:07:52,770
.اشرعوا في التحضيرات فورًا

116
00:07:53,460 --> 00:07:54,940
.شكرًا

117
00:07:56,580 --> 00:07:58,900
أليس أخي مذهلًا؟

118
00:07:58,900 --> 00:08:01,660
لِم لا يتصرف هكذا
بشكل سليم دائمًا إذًا؟

119
00:08:10,570 --> 00:08:14,350
لم يمضِ وقت طويل على
.مغادرتي لكنّني أشعر أنّي غبتُ طويلًا

120
00:08:14,350 --> 00:08:16,880
.مرحبًا بعودتك أيّها الأمير أرنولد

121
00:08:18,470 --> 00:08:21,560
كيف عرفتَ أنّني سأعود اليوم؟

122
00:08:21,940 --> 00:08:23,480
.لأنّني خادمك

123
00:08:23,480 --> 00:08:25,510
.هذا ليس جوابًا

124
00:08:25,510 --> 00:08:27,670
هل كلّ شيء بخير هناك؟

125
00:08:27,670 --> 00:08:28,580
.نعم

126
00:08:28,580 --> 00:08:31,020
يقودُ الدوق روندين أسطوله
،بنفسه نحو ألباترو

127
00:08:31,410 --> 00:08:36,410
.ليُعلن هدنة ويتعامل مع التنين

128
00:08:36,630 --> 00:08:37,960
.ليو رفقته

129
00:08:38,550 --> 00:08:41,450
.يفترض أنّي طريح الفراش بسبب دوار بحر

130
00:08:41,860 --> 00:08:45,580
إلنا خائفة جدًا من البحر
.حتّى أنّها ترفض مغادرة فراشها

131
00:08:47,810 --> 00:08:52,700
وأرسلت ألباترو مهمة رسمية
.لهزيمة تنين البحر

132
00:08:52,700 --> 00:08:55,090
.أعلنَ سيلفر أنّه سيقبلها

133
00:08:55,090 --> 00:08:56,790
.الوضع بخير إذًا

134
00:08:56,790 --> 00:08:59,910
.SS يبدو أنّها ستكونُ مهمة من فئة

135
00:09:00,360 --> 00:09:02,500
ما الوضعُ هنا إذًا؟

136
00:09:02,500 --> 00:09:04,780
.كلّ شيء جيّد هنا

137
00:09:04,780 --> 00:09:07,320
.تثبتُ لينفيا أنّها موهوبة جدًا

138
00:09:07,320 --> 00:09:09,510
..لكن فيني نوعًا ما

139
00:09:09,760 --> 00:09:11,020
هل أخطأت في شيء؟

140
00:09:11,450 --> 00:09:14,350
،أثناء اجتماع مع شركة أشباه البشر

141
00:09:14,350 --> 00:09:17,240
...عرَضت نفسها كجُزء من الصفقة

142
00:09:18,830 --> 00:09:23,080
في النهاية، لم يتمكّنُوا من تقديم
،شيء ذي قيمة مساوية

143
00:09:23,080 --> 00:09:25,920
.واستطاعت تحديد الشروط بسهولة

144
00:09:25,920 --> 00:09:27,420
...يا لها من فتاة صعبة المراس

145
00:09:27,420 --> 00:09:29,670
هل يحقّ لك وصف أحد بهذا؟

146
00:09:29,670 --> 00:09:31,210
ما قصدك؟

147
00:09:31,450 --> 00:09:34,820
بمعنى أنّ أفعالها الخفية
تخدم شخصًا آخر

148
00:09:34,820 --> 00:09:36,850
أهي مختلفة عنك؟

149
00:09:40,070 --> 00:09:41,340
.المعذرة

150
00:09:41,530 --> 00:09:43,600
!ماذا؟ السيّد سيلفر

151
00:09:43,880 --> 00:09:46,100
سيلفر؟ ماذا تفعل هنا؟

152
00:09:46,100 --> 00:09:47,430
.طاب مساؤكما

153
00:09:47,430 --> 00:09:49,800
.أودّ التحدث معك يا آنسة فيني

154
00:09:50,040 --> 00:09:51,640
.حـ-حسنًا

155
00:09:52,300 --> 00:09:54,240
هلّا تتركينا بمفردنا؟

156
00:09:54,240 --> 00:09:57,430
أيتها المغامرة التي التقيتُ بها
.في أراضي الدوق كلاينرت

157
00:09:57,430 --> 00:10:00,060
.يُشرّفني أنّك تتذكرني

158
00:10:00,060 --> 00:10:03,080
.لكنّني حارستُها الشخصية الآن

159
00:10:03,370 --> 00:10:05,070
.أريد محادثتها على انفراد

160
00:10:05,070 --> 00:10:06,760
.امنحينا بعض الوقت معًا

161
00:10:06,760 --> 00:10:09,170
.يمكنُ الوثوق بسيلفر

162
00:10:09,170 --> 00:10:10,820
.أضمن ذلك

163
00:10:12,740 --> 00:10:13,690
.حسنًا

164
00:10:18,250 --> 00:10:20,210
هل حدث شيء؟

165
00:10:20,210 --> 00:10:24,690
حدث الكثير لكن يمكننا
.الحديث عن ذلك لاحقًا

166
00:10:24,690 --> 00:10:26,340
...اسمعي يا فيني

167
00:10:26,340 --> 00:10:31,050
أدرك أنّه لا يحق لي قول
هذا وقد لا تودّين سماعه

168
00:10:31,050 --> 00:10:32,800
.لكن أصغي إليّ

169
00:10:33,270 --> 00:10:34,530
نعم؟

170
00:10:34,770 --> 00:10:37,990
بخصوص ما قُلتِه لتلك المرأة
...من شركة أشباه البشر

171
00:10:37,990 --> 00:10:40,380
.أريد أن تهتمي بنفسك أكثر

172
00:10:40,380 --> 00:10:43,270
.يؤلمني أن أراك تُخاطرين هكذا

173
00:10:43,650 --> 00:10:45,110
.لا داعي لأن تبالغي لذلك الحدّ

174
00:10:45,340 --> 00:10:50,460
...لكنّني لستُ نافعة لك بطرق أخرى

175
00:10:50,460 --> 00:10:53,300
.أنتِ مُميزة يا فيني

176
00:10:56,160 --> 00:11:00,670
أنتِ وسيباس الوحيدان اللّذان
.أسمح لهما برؤية وجهيّ الاثنين

177
00:11:00,990 --> 00:11:04,150
.سيباس أشبه بوصي لي

178
00:11:04,150 --> 00:11:06,820
.مثل والدٍ كان دائمًا بجانبي

179
00:11:06,820 --> 00:11:07,640
...لذا

180
00:11:09,110 --> 00:11:11,240
أنتِ الوحيدة غيره التي
.أستطيع أن أكون هكذا معها

181
00:11:12,040 --> 00:11:13,660
...سيّد آرن

182
00:11:13,660 --> 00:11:17,500
،وبعد أن عرفتِ حقيقتي
.لم تعودي غريبة بالنسبة لي

183
00:11:17,500 --> 00:11:19,760
.إن كان ليو أخي الوحيد

184
00:11:19,760 --> 00:11:22,340
.فأنتِ الوحيدة التي تشاركني سرّي

185
00:11:22,340 --> 00:11:24,060
.لا أحد يحلّ محلّك

186
00:11:24,060 --> 00:11:26,120
.كلّ ما أحتاجه هو أن تكوني بجانبي

187
00:11:29,080 --> 00:11:34,540
لا تتصوّرين كم يخفف عنّي
...مجرّد وجود شخص يشارك سرّي

188
00:11:39,540 --> 00:11:41,320
.أنتِ تُساعدينني كثيرًا دائمًا

189
00:11:41,790 --> 00:11:43,100
.شكرًا

190
00:11:43,100 --> 00:11:47,300
كان عليّ قول هذا سابقًا
.لكنّني انشغلتُ بأمور كثيرة

191
00:11:47,790 --> 00:11:48,810
.أنا آسف

192
00:11:48,810 --> 00:11:51,610
.لا، ليس خطأك

193
00:11:54,140 --> 00:11:57,270
.حسنًا، لنحاول معًا أن نصبح أفضل

194
00:11:59,210 --> 00:12:03,370
.أخبرني رجاء بما يحدثُ في الجنوب

195
00:12:03,370 --> 00:12:05,360
.سأساعدك بأيّ طريقة ممكنة

196
00:12:08,410 --> 00:12:10,130
.هذه هي القصّة...

197
00:12:10,130 --> 00:12:12,510
.هكذا إذًا. فهمت

198
00:12:12,510 --> 00:12:17,460
تُريد تجنّب إقحام الجيش
الإمبراطوري في هذه المعركة، صحيح؟

199
00:12:17,460 --> 00:12:18,380
.نعم

200
00:12:18,380 --> 00:12:22,550
أرى أنَّ الحلّ الأفضل هو
.مقاتلة التنين بصفتي سيلفر

201
00:12:22,550 --> 00:12:24,480
.أتفق معك

202
00:12:24,480 --> 00:12:29,190
.لكن المفتاح هو إن كنّا سنقنع أصحاب القرار

203
00:12:29,190 --> 00:12:30,190
.نعم

204
00:12:30,190 --> 00:12:31,810
.لكنّني لا أستطيع فعل ذلك

205
00:12:31,810 --> 00:12:32,980
هل أستطيع طلب مساعدتك؟

206
00:12:32,980 --> 00:12:36,570
!اترك الأمر لي! سأفعلها

207
00:12:42,190 --> 00:12:43,900
.الجواب هو لا

208
00:12:45,400 --> 00:12:47,490
...لكن أيّها الأمير

209
00:12:47,490 --> 00:12:52,030
لا أستطيعُ فعل المستحيل
.حتّى لو كان طلب بلاو مي

210
00:12:52,030 --> 00:12:54,790
.أنا أكتبُ تحفتي الآن

211
00:12:54,790 --> 00:12:57,470
أنت سيلفر المشهور؟

212
00:12:57,470 --> 00:12:58,630
.صحيح

213
00:12:58,630 --> 00:12:59,910
.سعدتُ بلقائك

214
00:13:00,310 --> 00:13:04,380
أكانت فكرتك أن تأتي إليّ؟

215
00:13:04,380 --> 00:13:08,780
.أريد دعمًا لأضمن أنّني سأقتل التنين

216
00:13:08,780 --> 00:13:11,850
لحُسن الحظ، حاملة السيف المقدّس
.موجودة في الجنوب حاليًا

217
00:13:11,850 --> 00:13:14,420
،وبما أنّني الأمير الرابع

218
00:13:14,420 --> 00:13:17,090
تُريد منّي أن أذهب إلى
الجنوب وأمنح الإذن

219
00:13:17,090 --> 00:13:19,660
باستخدام السيف المقدس
باسم الإمبراطور؟

220
00:13:19,660 --> 00:13:21,450
وليس إخوتي الأكبر أو أختي الصغيرة؟

221
00:13:21,640 --> 00:13:24,500
سيُسبب ذلك مشكلة إن
أُرسِل الجيش إلى الجنوب

222
00:13:24,500 --> 00:13:26,520
.بينما تنين البحر هناك

223
00:13:27,680 --> 00:13:30,730
لا تريد أن تُقحم الدولتان
في صراع العرش؟

224
00:13:30,730 --> 00:13:32,690
.إدراك ثاقب منك

225
00:13:32,690 --> 00:13:36,250
.لكنّني مشغول جدًا لذا أرجو أن تغادرا

226
00:13:36,250 --> 00:13:38,820
أيّها الأمير، أعظمُ الكُتّاب كانُوا دائمًا

227
00:13:38,820 --> 00:13:40,950
.أصحاب التجارب الأكثر إثارة

228
00:13:42,420 --> 00:13:46,170
والدّفاعُ عن الجنوب لن يكون
تجربة ممتازة فقط

229
00:13:46,170 --> 00:13:47,720
.بل سيمنحك شهرة

230
00:13:47,720 --> 00:13:52,300
سيأتيك الكثير من الأدباء
.منجذبين إلى شهرتك

231
00:13:52,300 --> 00:13:55,970
أليس ذلك أثمن من
التحفة التي تكتُبها الآن؟

232
00:13:55,970 --> 00:13:57,230
هل لي أن أسألك شيئًا؟

233
00:13:57,230 --> 00:13:57,890
.بالطبع

234
00:13:57,890 --> 00:14:00,820
لِم أنت هنا يا آنسة فيني؟

235
00:14:00,820 --> 00:14:02,720
أهذا جزء من صراع العرش؟

236
00:14:02,720 --> 00:14:04,610
أم أنَّ هناك سببًا آخر؟

237
00:14:04,950 --> 00:14:08,820
أتحتاجُ سببًا لإنقاذ من تُحبّ؟

238
00:14:15,110 --> 00:14:16,090
!نبيل

239
00:14:16,090 --> 00:14:17,420
!ما أنبل هذا

240
00:14:17,420 --> 00:14:18,340
!حسنًا

241
00:14:18,340 --> 00:14:20,810
،أمام إجابة جميلة وصادقة كهذه

242
00:14:20,810 --> 00:14:24,570
أنا تراوغوت، سأشعر بالخزي
.ككاتب إن لم أوافق على المساعدة

243
00:14:24,570 --> 00:14:27,490
هل أعتبر هذه العبارة أجري؟

244
00:14:32,140 --> 00:14:33,220
!أبي

245
00:14:33,220 --> 00:14:35,530
!أتيتُ ومعي طلب

246
00:14:35,530 --> 00:14:36,220
...رجاء، اسمح لي أن

247
00:14:36,220 --> 00:14:37,280
!ما أوقحك

248
00:14:37,280 --> 00:14:38,950
!لا تقاطع اجتماعي

249
00:14:38,950 --> 00:14:40,190
!ولا تكن صاخبًا هكذا

250
00:14:41,310 --> 00:14:43,200
...أ-أعتذر

251
00:14:43,200 --> 00:14:44,590
...انصرف

252
00:14:44,590 --> 00:14:47,620
.هذا زائر غير مألوف

253
00:14:48,740 --> 00:14:51,950
.أنا سيلفر، أتشرف بالوقوف أمام جلالتك

254
00:14:51,950 --> 00:14:54,100
ما مطلبك؟

255
00:14:54,100 --> 00:14:56,530
أهذا بخصوص تنين البحر في الجنوب؟

256
00:14:56,800 --> 00:15:02,000
.نقالة المغامرين قلقة من تدخّلكم

257
00:15:02,900 --> 00:15:05,560
.تدخل"؟ هذا وصف وقح"

258
00:15:05,560 --> 00:15:09,210
هل من الخطأ أن نُحاول إنقاذ الجنوب؟

259
00:15:09,460 --> 00:15:11,240
.لا أبالي إن فعلتُم

260
00:15:11,240 --> 00:15:13,250
،لا أعلم ما الذي تفكر به النقابة

261
00:15:13,250 --> 00:15:16,970
،لكن إن أحسنتُم التعامل مع الأمر
.فيسعكم إنقاذ أرواح كثيرة

262
00:15:17,370 --> 00:15:21,060
.ما يقلقني هو ألّا تُحسنوا تدبّر الأمر

263
00:15:21,340 --> 00:15:25,770
.أسمعنا ما قصدك بتدبّر الأمر بشكل صحيح إذًا

264
00:15:25,770 --> 00:15:29,140
.تفسيرُ ذلك مهمة من يقفان خلفي

265
00:15:29,140 --> 00:15:30,370
.المعذرة

266
00:15:30,620 --> 00:15:32,950
.تبدين بخير يا فيني

267
00:15:32,950 --> 00:15:37,730
.أرجو أن تُسامحني على تدخّلي هكذا يا جلالتك

268
00:15:39,660 --> 00:15:43,250
.لا بأس. حضوركِ مرحب به دائمًا

269
00:15:43,250 --> 00:15:44,960
...أ-أبي... أنا

270
00:15:44,960 --> 00:15:46,320
"!جلالتك"

271
00:15:47,450 --> 00:15:49,340
...جـ-جلالتك

272
00:15:49,340 --> 00:15:55,170
باختصار، أودّ أن ترسلني
...إلى الجنوب مُمثلًا لك

273
00:15:55,170 --> 00:15:57,680
.لا تتفوه بهراء يا خنزير

274
00:15:57,680 --> 00:16:00,020
.لا يعجبني تدخّلك في هذا

275
00:16:00,690 --> 00:16:02,730
.سأقضي عليك إن حاولتَ التدخل

276
00:16:02,980 --> 00:16:04,430
!تقضي عليّ؟

277
00:16:07,600 --> 00:16:10,570
.استمع إليّ رجاء يا جلالتك

278
00:16:10,570 --> 00:16:14,660
لم يسبق وجود حالة
.أُرسِل فيها جيش لهزيمة تنين

279
00:16:14,660 --> 00:16:18,370
لأنّ المهارة هي المطلوبة
.لهزيمة تنين لا العدد

280
00:16:20,880 --> 00:16:24,980
لذا أرى أنَّ أسرع طريقة
لحلّ هذه المشكلة

281
00:16:24,980 --> 00:16:27,920
هي إرسال الأمير تراوغوت ممثلًا لك

282
00:16:27,920 --> 00:16:30,470
وجعله يمنح الإذن لإلنا
.باستخدام السيف المقدس

283
00:16:30,760 --> 00:16:35,960
لكن لِم تراو بالتحديد يا فيني؟

284
00:16:36,330 --> 00:16:39,680
.لأنّ الثلاثة الآخرين ذو مكانة عالية جدًا

285
00:16:39,680 --> 00:16:44,980
تكليفهم بمهمة إذن السيف المقدس
.سيضر بسمعتهم

286
00:16:44,980 --> 00:16:48,640
.لكن هذه ليست مشكلة بحالة الأمير تراوغوت

287
00:16:48,640 --> 00:16:50,720
...مؤلم

288
00:16:50,720 --> 00:16:52,110
.مغالطة

289
00:16:52,110 --> 00:16:56,850
من ينقذ الجنوب بمفرده
.سينال شهرة عظيمة

290
00:16:56,850 --> 00:16:59,570
.أرفضُ العمل مع نقابة المغامرين

291
00:16:59,570 --> 00:17:03,500
.دع الأمر لي يا جلالتك

292
00:17:03,500 --> 00:17:06,410
!سأستغلّ هذه الفرصة لغزو الجنوب

293
00:17:06,640 --> 00:17:09,010
.يا لك من رجل صريح

294
00:17:09,010 --> 00:17:11,170
.لكنّنا لا نحتاج الجنوب الآن

295
00:17:11,170 --> 00:17:15,080
.إن أردته فخذه حين تصبح إمبراطورًا

296
00:17:15,080 --> 00:17:17,000
ما رأيك يا إريك؟

297
00:17:17,310 --> 00:17:20,220
.أتفق مع فيني

298
00:17:21,410 --> 00:17:23,560
.إنّها الوسيلة الأبسط

299
00:17:23,560 --> 00:17:25,560
مقترحات زاندرا وغوردون

300
00:17:25,560 --> 00:17:28,640
لن تضرّ بعلاقتنا مع
نقابة المغامرين فقط

301
00:17:28,640 --> 00:17:33,840
بل قد تُضعف صورة الإمبراطورية
وصورتك شخصيًا بنظر النّاس

302
00:17:35,250 --> 00:17:38,480
.جيّد، سنعملُ باقتراح فيني إذًا

303
00:17:38,480 --> 00:17:41,980
،حاليًا، لا منفعة تذكر من غزو الجنوب

304
00:17:41,980 --> 00:17:44,170
.ولا قيمة في إرسال جيشنا

305
00:17:44,170 --> 00:17:45,620
...لكن يا أبي

306
00:17:45,620 --> 00:17:47,370
".جلالتك"

307
00:17:47,780 --> 00:17:52,160
،لكن يا جلالتك
.لا داعي لاتباع خطّة مغامر

308
00:17:52,450 --> 00:17:57,220
أختلفُ معك. تجاهل النقابة
.في كيل أضرّ بنا كثيرًا

309
00:17:57,220 --> 00:18:00,870
.سنتبعُ خطّة سيلفر هذه المرّة

310
00:18:00,870 --> 00:18:03,680
أنا متأكد أنّك ستفرح بوجود
إلنا معك، صحيح يا سيلفر؟

311
00:18:04,000 --> 00:18:08,820
.سيكون صعبًا عليّ هزيمة ليفياتانو بمفردي

312
00:18:09,610 --> 00:18:11,030
.تقدّم

313
00:18:11,030 --> 00:18:12,890
.بـ-بالطبع

314
00:18:15,560 --> 00:18:20,040
.آمرُ تراوغوت ريكس أدلر أن يمثلني

315
00:18:20,040 --> 00:18:23,520
.توجّه إلى الجنوب وأوصل السيف للبطلة

316
00:18:23,520 --> 00:18:26,380
.سيكون هذا رمزك كممثلي

317
00:18:26,380 --> 00:18:28,240
.أمرك يا جلالتك

318
00:18:31,160 --> 00:18:35,000
.اعتنِ بابني تراو يا سيلفر

319
00:18:35,240 --> 00:18:36,700
.لا تقلق

320
00:18:36,700 --> 00:18:39,210
.سأعيده إليك سالمًا بلا أذى

321
00:18:41,100 --> 00:18:44,760
.كنتُ أفضّل أن ترافقني فتاة جميلة

322
00:18:51,600 --> 00:18:54,730
!أهلًا بك أيّها الدوق روندين

323
00:18:54,730 --> 00:18:59,250
لم يسعني البقاء في الديار
.نظرًا للظروف أيّها الدوق ألباترو

324
00:18:59,250 --> 00:19:03,330
.لنعلن هدنة ونتصدى معًا لتنين البحر

325
00:19:03,330 --> 00:19:05,070
.أشكرك على تعاونك

326
00:19:05,460 --> 00:19:10,320
بصفتي سفير الإمبراطورية فوق
.العادة، أشهد على هذه الهدنة

327
00:19:10,320 --> 00:19:15,660
لنتعاون مع نقابة المغامرين
!لمواجهة تنين البحر

328
00:19:20,000 --> 00:19:21,140
أين آرن؟

329
00:19:21,140 --> 00:19:22,590
أليس هنا؟

330
00:19:22,900 --> 00:19:24,840
أما زال نائمًا؟

331
00:19:24,840 --> 00:19:27,350
...ميؤوس منه

332
00:19:49,200 --> 00:19:51,710
!أيّها البشر الضعاف

333
00:19:51,710 --> 00:19:55,840
!اسمعوا صوت سنوات حقدي

334
00:19:58,960 --> 00:20:00,080
...هذا

335
00:20:00,080 --> 00:20:00,970
...لا يعقل

336
00:20:00,970 --> 00:20:01,970
!تقرير

337
00:20:01,970 --> 00:20:04,290
!ظهر تنين البحر ليفياتانو

338
00:20:09,410 --> 00:20:10,680
...توخَّ الحذر

339
00:20:11,480 --> 00:20:14,430
.أنا ذاهب يا آنسة فيني

340
00:20:14,430 --> 00:20:15,150
...والآن

341
00:20:15,460 --> 00:20:16,480
!سيّد سيلفر

342
00:20:20,610 --> 00:20:21,520
...عفوًا

343
00:20:22,840 --> 00:20:24,990
.لا داعي للقلق

344
00:20:26,460 --> 00:20:27,490
.نعم

345
00:20:33,730 --> 00:20:35,670
.كن بخير رجاء

346
00:20:35,670 --> 00:20:37,420
...وعُد سريعًا

347
00:20:49,670 --> 00:20:52,350
!أطلقوا! أطلقوا

348
00:20:52,660 --> 00:20:57,320
،يا تنين البحر ليفياتانو
!أساطيل روندين تواجهك

349
00:21:01,930 --> 00:21:04,240
!لا تتخلّفوا عن أسطول روندين

350
00:21:04,240 --> 00:21:07,440
!سنحمي ألباترو يا ليفياتانو

351
00:21:10,450 --> 00:21:12,370
!هنا يا ليفياتانو

352
00:21:13,480 --> 00:21:14,910
أين أخي وإلنا؟

353
00:21:15,250 --> 00:21:17,340
.الأمير أرنولد ليس على السفينة

354
00:21:17,340 --> 00:21:20,220
.ربما عاد إلى القلعة، مرتجفًا من الخوف

355
00:21:20,220 --> 00:21:23,380
عادت القائدة إلنا إلى البر
.لتُساعد في الإخلاء

356
00:21:23,380 --> 00:21:24,530
!فهمت

357
00:21:24,530 --> 00:21:27,930
!الدوق ألباترو! الدوق روندين! تراجعا

358
00:21:27,930 --> 00:21:28,830
!الوضع خطير

359
00:21:29,120 --> 00:21:31,070
!اجذبوا انتباه ليفياتانو

360
00:21:31,070 --> 00:21:32,910
!بلادنا في خطر شديد

361
00:21:32,910 --> 00:21:34,750
،بما أنَّنا شكلنا تحالفًا

362
00:21:34,750 --> 00:21:37,990
!فإنّ شعب ألباترو كأهلنا

363
00:21:37,990 --> 00:21:40,490
!سنقاتل لحماية الشعب

364
00:21:40,700 --> 00:21:43,780
...الدوق ألباترو... الدوق روندين

365
00:21:43,780 --> 00:21:44,700
.يا أمير

366
00:21:45,120 --> 00:21:46,200
...نعم

367
00:21:46,200 --> 00:21:48,810
!مفهوم! سنقاتل معًا

368
00:21:49,250 --> 00:21:51,160
!ابدؤوا إطلاق النار

369
00:21:57,740 --> 00:21:58,910
!أسرعوا

370
00:22:00,790 --> 00:22:03,490
...لو كان لديّ السيف المقدس