1
00:00:01,400 --> 00:00:07,740
سنرى الآن إن كان تنين البحر
.قد استيقظ من سباته

2
00:00:07,740 --> 00:00:08,930
...أختي

3
00:00:08,930 --> 00:00:10,480
.ركّز يا جوليو

4
00:00:10,480 --> 00:00:12,610
.سنستخدم سحرنا لفعل هذا

5
00:02:35,420 --> 00:02:37,300
!تحققوا من الأضرار

6
00:02:37,300 --> 00:02:38,710
!أفرغوا الماء خارجًا

7
00:02:38,710 --> 00:02:40,550
!افحصوا المصابين

8
00:02:40,550 --> 00:02:43,520
30751, 645...

9
00:02:43,520 --> 00:02:45,890
.نجحنا في تجنّب انقلاب السفينة

10
00:02:45,890 --> 00:02:48,860
.لكنّنا انجرفنا بعيدًا جدًا

11
00:02:48,860 --> 00:02:49,960
...والأهم من ذلك

12
00:02:49,960 --> 00:02:53,420
...سُحبنا إلى أراضي تنين البحر

13
00:02:53,420 --> 00:02:57,910
أفترض أنّ أسطول دوقية ألباترو
...كان يحقق في أمره

14
00:02:57,910 --> 00:03:02,010
وأثاروا غضب تنين البحر
.فسبّب عاصفة

15
00:03:02,360 --> 00:03:05,870
.من المرجح أنّ الأمير والأميرة ماتا الآن

16
00:03:05,870 --> 00:03:07,180
.مسكينان

17
00:03:07,180 --> 00:03:08,860
.أيّها الأمير ليونارد

18
00:03:10,870 --> 00:03:13,160
جيّد. أين نحن؟

19
00:03:13,480 --> 00:03:14,420
.هنا

20
00:03:14,730 --> 00:03:17,260
مياه دوقية ألباترو الإقليمية إذًا؟

21
00:03:17,260 --> 00:03:19,450
.ابتعدنا كثيرًا عن مسارنا الأصلي

22
00:03:19,450 --> 00:03:22,430
تنين البحر من أقوى
.الوحوش الموجودة

23
00:03:22,430 --> 00:03:26,350
.نحن محظوظون لأنّنا نجونا من عاصفته

24
00:03:26,350 --> 00:03:27,560
.أتفق

25
00:03:27,560 --> 00:03:31,730
...أنا قلق على ليو
.أعني، على أخي أرنولد والبقيّة

26
00:03:31,730 --> 00:03:33,640
.لنوجه مسارنا إلى روندين

27
00:03:33,640 --> 00:03:36,600
!يا قبطان! انظر باتجاه العاشرة

28
00:03:40,730 --> 00:03:42,840
إحدى سفن ألباترو؟

29
00:03:44,030 --> 00:03:45,270
.مؤسف

30
00:03:45,270 --> 00:03:46,330
...يا أمير

31
00:03:46,330 --> 00:03:50,080
كان الأمير ليونارد سيأمر
.بالبحث عن ناجين بلا شك

32
00:03:50,410 --> 00:03:52,840
قد يكون تنين البحر
.متربصًا تحت الماء

33
00:03:52,840 --> 00:03:55,090
.علينا أن تبتعد من هنا حالًا

34
00:03:55,420 --> 00:03:58,180
.أنتَ الأمير ليونارد

35
00:03:58,180 --> 00:04:00,760
.عليك أن تتصرف وفق ذلك

36
00:04:00,760 --> 00:04:03,990
.أعلم هذا. لكن احتمالية نجاتهم ضعيفة

37
00:04:03,990 --> 00:04:05,050
...علينا أن نغادر

38
00:04:05,050 --> 00:04:07,380
!وجدناهُم! ناجُون

39
00:04:07,380 --> 00:04:09,180
!إنّهم مُتشبّثون بالحطام

40
00:04:10,560 --> 00:04:11,620
...يا أمير

41
00:04:14,250 --> 00:04:15,970
!أرسلوا قارب إنقاذ

42
00:04:15,970 --> 00:04:17,770
!سننقذهم فورًا

43
00:04:22,900 --> 00:04:27,030
.يقولون أنّ هناك كثيرين ما زالوا منجرفين

44
00:04:27,030 --> 00:04:29,000
.يا لها من كارثة

45
00:04:29,360 --> 00:04:31,280
.انتبه لكلماتك

46
00:04:31,280 --> 00:04:32,820
!أعلم

47
00:04:33,130 --> 00:04:34,620
.سنذهبُ لإنقاذهم

48
00:04:34,620 --> 00:04:36,040
هل جننتَ؟

49
00:04:36,040 --> 00:04:39,360
ستغربُ الشّمس قريبًا
،وإن استخدمنا الأضواء

50
00:04:39,360 --> 00:04:41,830
!قد نجذب انتباه تنين البحر

51
00:04:41,830 --> 00:04:45,330
هذا أمر مني كسفير
.فوق العادة أيّها القبطان

52
00:04:45,600 --> 00:04:47,760
.سننقذ طاقم ألبارتو

53
00:04:47,760 --> 00:04:49,370
.لن نتخلّى عن أيّ أحد منهم

54
00:04:49,760 --> 00:04:52,760
لكن ماذا سنفعل لو أتى تنين البحر؟

55
00:04:52,760 --> 00:04:55,090
.نحن هالكون إن ظهر

56
00:04:55,090 --> 00:04:58,610
الأفضل أن ننتهي من الإنقاذ بسرعة
.عِوض تضييع وقتنا نحترس من ذلك

57
00:04:58,610 --> 00:05:03,880
سمعتُ الشائعات لكنّك فعلًا
.رجل طيّب جدًا

58
00:05:03,880 --> 00:05:07,600
،بصفتي قبطان السفينة
...لا أستطيع الموافقة

59
00:05:08,350 --> 00:05:11,050
.لكنّني سأطيع إن كان أمرًا

60
00:05:15,110 --> 00:05:17,210
!عيشوا جميعًا

61
00:05:17,210 --> 00:05:18,640
!عليكم العيش

62
00:05:18,640 --> 00:05:19,720
!سمو الأمير

63
00:05:19,720 --> 00:05:21,270
!اصعد إلى القارب

64
00:05:21,270 --> 00:05:22,520
.لا بأس

65
00:05:22,520 --> 00:05:24,050
.أنا بخير

66
00:05:29,180 --> 00:05:30,230
!تنين البحر

67
00:05:30,230 --> 00:05:31,920
!اهدأ! إنّها مُجرّد أسماك

68
00:05:31,920 --> 00:05:33,650
!ستأتي المساعدة بلا شك

69
00:05:33,650 --> 00:05:35,300
!تذكّروا عائلاتكم

70
00:05:35,300 --> 00:05:36,300
!عيشُوا

71
00:05:36,300 --> 00:05:38,810
.لن تأتي المساعدة

72
00:05:39,110 --> 00:05:43,950
ليس لدينا وسيلة لإبلاغ أيّ
أحد عن استيقاظ تنين البحر

73
00:05:43,950 --> 00:05:45,980
!ولا عن انجرافنا في البحر

74
00:05:46,530 --> 00:05:49,900
!لكن... لكنّنا سننجو بلا شك

75
00:05:52,280 --> 00:05:54,440
!لا جدوى! نحن هالكون

76
00:05:54,440 --> 00:05:56,280
!سيلتهمُنا تنين البحر

77
00:05:56,280 --> 00:05:57,760
!لا تستسلموا

78
00:05:57,760 --> 00:05:59,920
!لا يمكنكم أن تفقدوا الأمل حتّى النهاية

79
00:06:10,030 --> 00:06:12,240
!انظروا جميعًا

80
00:06:12,240 --> 00:06:13,230
!سفينة

81
00:06:13,230 --> 00:06:14,890
!الأمير جوليو! إنّها سفينة

82
00:06:15,520 --> 00:06:17,040
!نـ-نجونا

83
00:06:17,040 --> 00:06:19,470
!هنا

84
00:06:19,470 --> 00:06:21,390
لكن أيّ سفينة هي؟

85
00:06:21,390 --> 00:06:22,620
...إنّها

86
00:06:22,620 --> 00:06:24,260
!سفينة إمبراطورية

87
00:06:25,740 --> 00:06:27,450
...سفينة الأمير ليونارد

88
00:06:27,450 --> 00:06:29,850
!أنا ليونارد ريكس أدلر

89
00:06:29,850 --> 00:06:32,180
!سنبدأُ الآن عمليّات الإنقاذ

90
00:06:32,180 --> 00:06:33,490
!اصبروا قليلًا

91
00:06:33,870 --> 00:06:35,490
!سننقذكم

92
00:06:35,490 --> 00:06:36,990
!أنزلوا سلالم الحبال

93
00:06:36,990 --> 00:06:37,960
!هناك

94
00:06:40,370 --> 00:06:43,690
ليسوا حلفاء ولا أصدقاء
...لكنّهم هبّوا لنجدتنا

95
00:06:44,330 --> 00:06:46,070
...الأمير ليونارد

96
00:06:48,250 --> 00:06:49,860
!هيّا بنا جميعًا

97
00:06:49,860 --> 00:06:51,920
!اطلبوا منهم علاج جرحانا فورًا

98
00:06:51,920 --> 00:06:52,800
!أ-أمرك

99
00:06:52,800 --> 00:06:55,140
!اصبر! سننجو قريبًا

100
00:06:55,140 --> 00:06:56,650
!تمالك نفسك

101
00:06:56,650 --> 00:06:58,020
!تشبث بي

102
00:07:02,470 --> 00:07:03,850
.أحسنت صنعًا

103
00:07:04,190 --> 00:07:05,610
.لا عليك الآن

104
00:07:05,610 --> 00:07:06,600
...شكرًا

105
00:07:06,940 --> 00:07:08,750
!شكرًا جزيلًا

106
00:07:09,200 --> 00:07:11,380
!ناجون كُثر عند الميمنة

107
00:07:11,380 --> 00:07:12,400
!خمسون منهم

108
00:07:16,050 --> 00:07:17,610
ماذا ستفعل؟

109
00:07:17,610 --> 00:07:20,900
لا أدري إن كانت السفينة
.تستطيعُ حملهم جميعًا

110
00:07:20,900 --> 00:07:24,010
.حسنًا، توقّعتُ حدوث هذا

111
00:07:24,010 --> 00:07:27,080
.كان لديهم ثلاث سفن ونحن واحدة

112
00:07:27,080 --> 00:07:29,810
.لديك خطّة إذًا

113
00:07:30,140 --> 00:07:33,880
.سنتخلّى عن كلّ حمولتنا ما عدا الطعام والماء

114
00:07:34,750 --> 00:07:36,880
بما فيها هدايانا لروندين؟

115
00:07:36,880 --> 00:07:38,090
والأسلحة والكنوز؟

116
00:07:38,310 --> 00:07:39,420
.كلّها

117
00:07:39,420 --> 00:07:41,740
.كنوزنا لا تهم. حياتهم أهم

118
00:07:42,010 --> 00:07:44,890
!لن نسمح بموت أيّ فرد منهم

119
00:07:45,190 --> 00:07:46,370
فهمتم؟

120
00:07:47,040 --> 00:07:48,630
.مفهوم

121
00:07:49,180 --> 00:07:52,120
أنت تُخفي مواهبك حقًا إذًا؟

122
00:07:52,120 --> 00:07:53,820
هل قلتَ شيئًا؟

123
00:07:53,820 --> 00:07:57,200
.لا، سيتكفّل الفرسان الملكيون برمي الحمولة

124
00:07:57,200 --> 00:07:58,250
.افعلوا رجاء

125
00:07:58,250 --> 00:08:00,230
!اصطفوا يا فوج الفرسان الثالث

126
00:08:00,230 --> 00:08:01,720
!أكملوا جهود الإنقاذ

127
00:08:01,720 --> 00:08:03,570
!أنقذوا كلّ من نستطيع إنقاذه

128
00:08:03,570 --> 00:08:05,280
!سأتحمّل المسؤولية

129
00:08:05,280 --> 00:08:06,380
!مفهوم

130
00:08:07,940 --> 00:08:10,250
هل أنت بخير أيّها الأمير جوليو؟

131
00:08:10,250 --> 00:08:11,860
...الأمير ليونارد

132
00:08:11,860 --> 00:08:14,330
!أنقذوا المصابين أولًا

133
00:08:14,330 --> 00:08:15,440
!فهمت

134
00:08:15,440 --> 00:08:16,920
!اصبروا قليلًا

135
00:08:17,770 --> 00:08:19,600
.يا لها من خسارة

136
00:08:19,600 --> 00:08:22,470
.يمكننا أخذ واحدة منها ولن يلاحظوا

137
00:08:22,470 --> 00:08:24,390
!كفى كلامًا واعمل

138
00:08:24,390 --> 00:08:25,950
!أنا أمزح

139
00:08:29,770 --> 00:08:32,500
!صعد الجميع ما عدا الأمير جوليو

140
00:08:32,500 --> 00:08:33,990
.أنا سعيد

141
00:08:34,370 --> 00:08:36,600
...أُنقِذ الجميع الآن

142
00:08:36,950 --> 00:08:39,910
!أنت الأخير أيّها الأمير جوليو

143
00:08:48,500 --> 00:08:49,520
!الأمير

144
00:08:49,520 --> 00:08:50,920
!قفز الأمير إلى البحر

145
00:09:18,120 --> 00:09:20,070
!من هنا يا أمير

146
00:09:23,050 --> 00:09:27,270
كان هناك 87 فردًا على
.متن السفن الثلاث

147
00:09:27,270 --> 00:09:28,510
.فهمت

148
00:09:28,510 --> 00:09:30,840
.يبدو أنّنا أنقذناهم جميعًا إذًا

149
00:09:30,840 --> 00:09:31,840
.جيّد

150
00:09:31,840 --> 00:09:35,000
.يبدو أنّه أُنهِك جسديًا ونفسيًا

151
00:09:35,000 --> 00:09:36,430
.علينا أن ندفئه حالًا

152
00:09:36,430 --> 00:09:38,650
.شكرًا. أنقذتني

153
00:09:38,650 --> 00:09:42,520
لا شكر على واجب. اعتدتُ
.أن أخرجك من الماء

154
00:09:43,770 --> 00:09:46,450
عندما كدتَ تغرق في
حمام الأرشيدوق الأعلى

155
00:09:46,450 --> 00:09:48,200
.أنا من أخرجتك من الماء

156
00:09:48,520 --> 00:09:51,980
.كنتُ أخدمهم في الأصل

157
00:09:51,980 --> 00:09:53,650
جديًا؟

158
00:09:53,650 --> 00:09:57,140
نعم. رغم أنّني لم أتوقع
...أن أفعلها مرّة ثانية

159
00:09:57,140 --> 00:10:00,270
.لا تتحدث وكأنّني ارتكبتُ خطأ

160
00:10:00,270 --> 00:10:02,530
،غرفتُ أول مرّة بسبب لكمة

161
00:10:02,530 --> 00:10:04,090
.وهذه المرّة، كنتُ أنقذ حياة شخص

162
00:10:04,090 --> 00:10:05,800
.صحيح

163
00:10:06,790 --> 00:10:08,550
.لم أسألك عن اسمك

164
00:10:08,870 --> 00:10:13,130
مارك تايبر. نائب قائدة
.فوج الفرسان الثالث

165
00:10:13,830 --> 00:10:15,370
.يسرني وجودي معك

166
00:10:15,990 --> 00:10:20,820
.أرجو ألّا نبقى معًا طويلًا يا مارك

167
00:10:20,820 --> 00:10:22,920
...أتفق ولكن

168
00:10:22,920 --> 00:10:26,730
.هناك كثيرون في حالة حرجة أيّها الأمير

169
00:10:26,730 --> 00:10:29,900
لا نملكُ المعدات أو الأدوية اللازمة
.لعلاجهم على متن السفينة

170
00:10:29,900 --> 00:10:34,480
قد لا ينجو بعضهم إن
.لم يتلقوا علاجًا عمّا قريب

171
00:10:35,600 --> 00:10:36,890
.فهمت

172
00:10:36,890 --> 00:10:40,320
.سنتجه إلى دوقية ألباترو يا قبطان

173
00:10:41,540 --> 00:10:43,450
...توقّعتُ هذا

174
00:10:43,450 --> 00:10:46,800
،سيستغرق الوصولُ إلى روندين أيامًا

175
00:10:46,800 --> 00:10:49,770
.لكن يمكننا وصول ألباترو صباحًا

176
00:10:50,140 --> 00:10:51,830
.إنّه خيارنا الوحيد

177
00:10:51,830 --> 00:10:54,020
.أعلم أنّه عمل إضافي لكن من فضلك

178
00:10:54,400 --> 00:10:55,960
.مفهوم

179
00:10:55,960 --> 00:11:02,310
والآن، لنرجو أن تسمح لنا
.ألباترو بالدّخول دون جدال

180
00:11:05,700 --> 00:11:09,130
أيّها الأمير أرنولد، يسأل
القبطان ما إن كان

181
00:11:09,130 --> 00:11:11,730
علينا البحث عن
.سفينة الأمير ليونارد

182
00:11:11,730 --> 00:11:13,610
هذا الكلام مجددًا؟

183
00:11:13,610 --> 00:11:15,790
.أعرف ليو. سيكون بخير

184
00:11:15,790 --> 00:11:17,930
.سنتجه إلى روندين

185
00:11:18,450 --> 00:11:20,380
.كما أنّني لستُ بخير

186
00:11:20,380 --> 00:11:23,490
.لا تزعجني. لا أريد التعامل مع هذا

187
00:11:23,490 --> 00:11:24,870
.حـ-حسنًا

188
00:11:25,280 --> 00:11:27,370
.افعل كما يقول آرن

189
00:11:27,370 --> 00:11:28,490
.مفهوم

190
00:11:32,220 --> 00:11:33,760
.خمسة من عشرة

191
00:11:33,760 --> 00:11:36,370
.كان آرن سيقول أنّه سيترك الأمر للقبطان

192
00:11:36,780 --> 00:11:38,690
...الأمر صعب

193
00:11:41,070 --> 00:11:43,530
.عـ-على أيّ حال، سنواصل التظاهر

194
00:11:43,530 --> 00:11:45,880
.سنقع في ورطة إن اكتشف النّاس الحقيقة

195
00:11:45,880 --> 00:11:47,330
.نعم

196
00:11:48,060 --> 00:11:50,500
...لو لم أكن أعاني من دوار البحر

197
00:11:50,500 --> 00:11:52,360
هل تظنين أنّ أخي بخير؟

198
00:11:52,360 --> 00:11:53,720
.آرن بخير

199
00:11:53,720 --> 00:11:57,520
.مارك معه، وهو أذكى ممّا يظهر عليه

200
00:11:57,520 --> 00:11:58,980
.المشكلة فيك أنت

201
00:11:59,390 --> 00:12:00,880
.صحيح

202
00:12:00,880 --> 00:12:03,310
...لا أستطيع التظاهر بأنّني أخي

203
00:12:03,310 --> 00:12:06,030
،يسهلُ عليهِ أن يتظاهر بأنّهُ أنتَ

204
00:12:06,030 --> 00:12:08,100
.لكن العكس أصعب بكثير

205
00:12:08,460 --> 00:12:12,080
كلاكما أميران، فلِم يبدو أنّكما
نشأتُما بشكلٍ مختلف كليًا؟

206
00:12:12,080 --> 00:12:14,370
.أخي حرّ الطبع

207
00:12:14,370 --> 00:12:17,040
.قضى وقتًا طويلًا خارج القصر

208
00:12:17,040 --> 00:12:19,380
...ولسبب ما، كان يعود باكيًا كلّ يوم

209
00:12:19,380 --> 00:12:22,630
ذلك لأنّ آرن كان يدع
،الآخرين يضربونه

210
00:12:22,630 --> 00:12:23,830
...وأردتُ مساعدته

211
00:12:24,060 --> 00:12:29,100
أعلم، كنتِ دائمًا تحرصين عليه، صحيح؟

212
00:12:29,960 --> 00:12:32,310
.رغم أنّه يرى ذلك إزعاجًا

213
00:12:32,750 --> 00:12:35,320
.ربّما أنت محقة

214
00:12:36,270 --> 00:12:39,220
.لكنّه لم يعتبركِ عبئًا أبدًا

215
00:12:40,470 --> 00:12:43,340
كان مزاج أخي أفضل منذ
أن أتيتِ لمساعدته

216
00:12:43,340 --> 00:12:45,030
.في مهرجان الفرسان للصيد

217
00:12:45,030 --> 00:12:47,170
.إنّه يعتمد عليكِ حقًا في الحقيقة

218
00:12:47,170 --> 00:12:48,740
حـ-حقًا؟

219
00:12:48,740 --> 00:12:50,110
!أضمن لك ذلك

220
00:12:57,530 --> 00:12:59,140
!هذا سخيف

221
00:12:59,140 --> 00:13:00,760
ماذا يحدث؟

222
00:13:00,760 --> 00:13:04,490
.يبدو أنّهم يتوقّعون كلّ حركة نفعلها

223
00:13:06,390 --> 00:13:08,830
...لديهم من يقف بديلًا عنهما

224
00:13:08,830 --> 00:13:11,070
!ليونارد وأرنولد ليسا هنا

225
00:13:11,070 --> 00:13:12,100
...ومع ذلك

226
00:13:12,100 --> 00:13:16,440
أم أنّك تقول أنّ تلك الصغير الساذجة
بلاو مي تفوقني دهاءً؟

227
00:13:17,780 --> 00:13:21,400
.يبدو أنّ هناك شخصًا موهوبًا بجانب ليونارد

228
00:13:21,400 --> 00:13:26,820
إنّه يكتشف خططنا
.ويشاركها مع إخوتك

229
00:13:27,390 --> 00:13:28,900
!هذا يثير غضبي

230
00:13:28,900 --> 00:13:32,440
!كيف يجرؤ أولئك المبدئون على إغضابي؟

231
00:13:32,440 --> 00:13:33,740
!سيندمون على هذا

232
00:13:33,740 --> 00:13:39,720
حاليًا، علينا أن نتجاهل فصيل ليونارد
.ونركّز على التعامل مع غوردون

233
00:13:39,720 --> 00:13:44,460
يمكنك الانتقام لخسارة وزير
.الصّناعة في وقت لاحق

234
00:13:44,460 --> 00:13:45,800
.فهمت

235
00:13:50,420 --> 00:13:54,680
الأمير الطيب الساذج
...والأمير عديم الفائدة الواهن

236
00:13:54,990 --> 00:13:58,170
.لن تكون نهايتكما حسنة

237
00:14:00,270 --> 00:14:01,850
.أحسنت جدًا

238
00:14:01,850 --> 00:14:05,690
أدهشني أنّك استطعتِ استنتاج
.خُطط العدو من معلوماتٍ محدودة

239
00:14:05,690 --> 00:14:08,530
.الأمر أشبه بتوقّع هجمات وحوش

240
00:14:08,530 --> 00:14:11,940
عندما هاجمت الأميرة الثانية

241
00:14:11,940 --> 00:14:14,690
...مؤيّدي الأمير ليونارد

242
00:14:14,690 --> 00:14:19,410
أرسلتِ المعلومات سرًا
إلى الأمير غوردون إذًا؟

243
00:14:19,410 --> 00:14:22,920
...كي تدفعيه لاستهداف الأميرة زاندرا

244
00:14:22,920 --> 00:14:27,410
نعم. وستنشغلُ بالدفاع عن
نفسها ضد هجماتِ غوردون

245
00:14:27,410 --> 00:14:30,000
.ولن تهتم بنا لبعض القوت

246
00:14:30,000 --> 00:14:32,090
!أنتِ مذهلة يا لينفيا

247
00:14:33,660 --> 00:14:35,130
أمِن خطب ما؟

248
00:14:35,130 --> 00:14:39,970
.لا... أتعجب فقط من ثقتكِ بي كثيرًا

249
00:14:40,300 --> 00:14:43,690
.لأنّ آرن يثق بك

250
00:14:43,690 --> 00:14:46,350
ألا يزعجك الأمر؟

251
00:14:46,350 --> 00:14:48,280
...أن يصدر شخص جديد مثلي الأوامر

252
00:14:48,590 --> 00:14:53,820
سواءً كنتُ أنا مفيدة أو
أنتِ، أليس الأمر واحدًا؟

253
00:14:54,180 --> 00:14:55,620
.فهمت

254
00:14:55,620 --> 00:14:58,800
أنتِ لا تعتبرين نفسك فوق الآخرين إذًا؟

255
00:14:59,740 --> 00:15:03,950
.فيني تُقدّم الآخرين على نفسها

256
00:15:03,950 --> 00:15:06,180
...لا، ليس بالضرورة

257
00:15:06,180 --> 00:15:09,920
لِم أنتِ جزء من صراع العرش أصلًا؟

258
00:15:09,920 --> 00:15:13,250
،قد يبدو كلامي وقحًا
.لكن لا تبدين مناسبة له

259
00:15:14,310 --> 00:15:15,970
...أنتِ محقة

260
00:15:15,970 --> 00:15:17,970
!أبادلك الشعور

261
00:15:19,300 --> 00:15:21,450
أكان الأمرُ صادمًا لهذه الدرجة؟

262
00:15:21,450 --> 00:15:25,430
...لم أكُن يومًا مفيدة لآرن أو أخيه

263
00:15:25,430 --> 00:15:31,740
.إنّهما محظوظان جدًا لوجودك بجانبهما

264
00:15:31,740 --> 00:15:34,070
.لا تقلقي كثيرًا بشأن ذلك

265
00:15:34,310 --> 00:15:36,400
...أرجو ذلك

266
00:15:38,180 --> 00:15:40,620
.إذًا لنكن ذي فائدة

267
00:15:41,210 --> 00:15:46,480
هناك أشخاص في العاصمة يريدون
.مساعدة شخصية مشهورة مثلكِ

268
00:15:46,480 --> 00:15:47,670
من؟

269
00:15:48,010 --> 00:15:49,500
.التجار

270
00:15:49,500 --> 00:15:54,120
لكن الفصائل الأخرى استحوذت
على مُعظم التجار، صحيح؟

271
00:15:54,660 --> 00:16:00,460
لذا سنستهدفُ التجار الذين ينوون
!الإقدام على تحرّكات كبيرة في العاصمة

272
00:16:00,700 --> 00:16:02,220
أيوجدون؟

273
00:16:02,220 --> 00:16:05,480
.أظنّكِ سمعتِ بالاسم من قبل

274
00:16:05,480 --> 00:16:07,720
.شركة أشباه البشر

275
00:16:07,720 --> 00:16:09,610
شركة أشباه البشر؟

276
00:16:09,610 --> 00:16:10,740
.فهمت

277
00:16:14,490 --> 00:16:19,330
كِلا الأميران ليونارد وأرنولد
.كانا مهتمين بشركة أشباه البشر

278
00:16:19,330 --> 00:16:21,950
.لكنّهما لم يتواصلا معها بعد

279
00:16:22,430 --> 00:16:24,440
تعرفين السبب، صحيح؟

280
00:16:24,440 --> 00:16:28,680
.نعم. تقودهم مصاصة دماء

281
00:16:28,990 --> 00:16:30,260
مصاصة دماء؟

282
00:16:30,560 --> 00:16:35,590
بعد حادثة كيل، أهل العاصمة
.يكرهون مصاصي الدماء

283
00:16:35,590 --> 00:16:38,740
.لكنّني أظنّها فرصة مناسبة

284
00:16:39,190 --> 00:16:41,510
.لنلتقِ بهم

285
00:16:41,510 --> 00:16:44,430
.أودّ معرفة المزيد عنهم قبل أن أقرّر

286
00:16:44,430 --> 00:16:45,850
.فهمت

287
00:16:45,850 --> 00:16:48,890
هل لي أن أطلب منك تنظيم لقاء؟

288
00:16:49,350 --> 00:16:51,340
.بالطبع

289
00:16:51,340 --> 00:16:54,110
.سنحصلُ على جواب بغضون أيّام قليلة

290
00:16:54,110 --> 00:16:57,110
!سأبذل قصارى جهدي يا آرن

291
00:16:59,930 --> 00:17:02,130
هل أنت بخير يا أمير؟

292
00:17:02,570 --> 00:17:04,910
.انتابني شعور سيئ فقط

293
00:17:08,330 --> 00:17:09,630
.توقّفنا

294
00:17:09,630 --> 00:17:13,190
.نحن قرب دوقية ألباترو على ما أظن

295
00:17:13,190 --> 00:17:14,970
...ما يعني

296
00:17:15,740 --> 00:17:16,970
استقبال رسمي؟

297
00:17:16,970 --> 00:17:19,680
.نعم. أرى 10 سفن

298
00:17:20,370 --> 00:17:22,300
.تنبيه للسفينة الإمبراطورية

299
00:17:22,760 --> 00:17:27,480
لم تُرسل دولتكم أيّ إخطار
.مسبق لدوقية ألباترو

300
00:17:27,480 --> 00:17:29,430
.أعلنُوا نواياكم

301
00:17:29,430 --> 00:17:30,640
.أكرّر

302
00:17:30,640 --> 00:17:32,520
.أعلنوا نواياكم

303
00:17:33,280 --> 00:17:37,920
،أنا ليونارد ريكس أدلر
.الأمير الثامن لإمبراطورية أدرسيا

304
00:17:38,360 --> 00:17:40,620
كنّا في طريقنا إلى روندين حين

305
00:17:40,620 --> 00:17:42,420
،صادفنا بحّارة من دوقيتكم عالقين

306
00:17:42,420 --> 00:17:44,250
.وأنقذنا حوالي ثمانين منهم

307
00:17:44,760 --> 00:17:47,630
.ومن بينهم أميركم وأميرتكم

308
00:17:47,630 --> 00:17:49,650
.نطلبُ إذنًا بالرسو

309
00:17:50,170 --> 00:17:52,710
.فهمنا نواياكم

310
00:17:52,710 --> 00:17:58,580
لكن نرجو أن تنتظروا هناك
.حتّى يأذن الذوق

311
00:17:58,580 --> 00:18:00,260
...لا وقت لهذا

312
00:18:00,260 --> 00:18:02,940
.كثير منهم في حالة حرجة

313
00:18:02,940 --> 00:18:05,790
.يحتاجون العلاج فورًا

314
00:18:05,790 --> 00:18:08,220
.نرجو أن تبقوا مكانكم

315
00:18:08,740 --> 00:18:10,120
أين الأمير والأميرة؟

316
00:18:10,520 --> 00:18:12,820
.ما زالا نائمين

317
00:18:13,190 --> 00:18:17,110
نجا هؤلاء الرجال من عواصف تنين
!البحر ومن الانجراف في البحر

318
00:18:17,450 --> 00:18:20,750
!أنتم الوحيدون القادرون على إنقاذ حياتهم

319
00:18:20,750 --> 00:18:22,390
.القوانين هي القوانين

320
00:18:22,390 --> 00:18:25,580
.لا يمكننا السماح لسفينة بالدّخول دون إذن

321
00:18:25,580 --> 00:18:27,320
هل أستطيع التحدث إلى قبطانكم؟

322
00:18:27,570 --> 00:18:29,670
.أنا القبطان أيّها الأمير

323
00:18:30,960 --> 00:18:34,670
.ضحيتُ بالكثير لإنقاذ حياتهم

324
00:18:34,670 --> 00:18:36,270
.عرّضتُ نفسي للخطر

325
00:18:36,270 --> 00:18:39,840
!لسبب واحد: لم أشأ أن يموتوا

326
00:18:40,370 --> 00:18:42,090
!أرجوك، اتخذ القرار الصحيح

327
00:18:45,270 --> 00:18:49,010
.لا يمكننا خرق القوانين مهما كان السبب

328
00:18:49,010 --> 00:18:50,410
...يا له من عنيد

329
00:18:50,410 --> 00:18:51,890
!يا أمير، إنّ حالة الرجال

330
00:18:52,160 --> 00:18:54,580
!الوقت يداهمنا

331
00:18:54,580 --> 00:18:56,600
!سندخل الميناء أيّها القبطان

332
00:18:56,600 --> 00:18:58,030
!لم نحصل على إذن

333
00:18:58,030 --> 00:19:01,070
!سيموتُ النّاس إن اتبعنا قوانينهم

334
00:19:01,070 --> 00:19:04,200
لن يحاولوا إغراقنا بوجود
!الأمير والأميرة على متن السفينة

335
00:19:04,490 --> 00:19:08,080
علينا الآن فعل كلّ ما بوسعنا
!لإنقاذ هذه الأرواح

336
00:19:08,380 --> 00:19:09,420
!سندخلُ الميناء

337
00:19:09,420 --> 00:19:10,580
.أنت تبالغ كثيرًا

338
00:19:10,580 --> 00:19:12,940
.لم يكن الأمير ليونارد ليصل لهذا الحدّ

339
00:19:13,300 --> 00:19:16,450
.لا... لم يكن ليتصرف بهذه العنفوانية

340
00:19:16,450 --> 00:19:17,660
.قد تكونُ محقًا

341
00:19:17,660 --> 00:19:18,820
وماذا في ذلك؟

342
00:19:19,170 --> 00:19:20,620
.هذه فرصة مناسبة

343
00:19:20,620 --> 00:19:23,090
...أستطيع جعل الجميع يظنّون

344
00:19:23,090 --> 00:19:26,820
أنّ ليونارد ريكس أدلر
.ليس مجرد فتى ساذج

345
00:19:26,820 --> 00:19:29,030
،إن فعلتَ ذلك

346
00:19:29,030 --> 00:19:32,770
سيضطر الأمير ليونارد يومًا ما
.لاتخاذ قرارات أصعب

347
00:19:32,770 --> 00:19:35,560
.سيكون بخير. إنّه أخي

348
00:19:36,280 --> 00:19:40,310
.لا يوجد شيء أفعله لا يقدر عليه

349
00:19:42,160 --> 00:19:45,230
.لا عودة ما إن ندخل الميناء يا أمير

350
00:19:45,590 --> 00:19:47,140
.لن نستطيع الهرب

351
00:19:47,140 --> 00:19:49,630
.قد نُسجن في أسوأ الحالات

352
00:19:49,950 --> 00:19:51,320
.أعلمُ هذا

353
00:19:51,610 --> 00:19:54,090
أنت جزء من صراع العرش، صحيح؟

354
00:19:54,090 --> 00:19:55,950
،إن استُعملت كورقة مساومة سياسية

355
00:19:55,950 --> 00:19:57,910
!سيصعب عليك أكثر أن تُصبح إمبراطورًا

356
00:19:57,910 --> 00:20:00,130
.سأتعاملُ مع ذلك حين يحدث

357
00:20:00,450 --> 00:20:03,600
.أرجو أن تطيع أمري يا قبطان

358
00:20:03,840 --> 00:20:05,830
.هذه سفينتك

359
00:20:05,830 --> 00:20:09,020
.يأتمنك كلّ الطّاقم على حياتهم

360
00:20:09,440 --> 00:20:11,610
لا تجبرني على فعل شيء وقح

361
00:20:11,610 --> 00:20:14,560
كالاستيلاء على الدفة
.وتولّي القيادة بنفسي

362
00:20:15,750 --> 00:20:19,670
.ظننتُك مُجرّد طفل ساذج يا أمير

363
00:20:19,670 --> 00:20:22,470
.لكنّك أظهرتَ ما هو أكثر

364
00:20:22,470 --> 00:20:25,030
!أُعجبت بك

365
00:20:25,030 --> 00:20:27,620
!سندخل الميناء أيّها الطاقم

366
00:20:28,230 --> 00:20:29,080
!أسرعوا

367
00:20:29,080 --> 00:20:33,920
.لدي فكرة لضمان ألّا يهاجمونا يا أمير

368
00:20:34,270 --> 00:20:35,410
ما هي؟

369
00:20:36,010 --> 00:20:37,720
!انظر يا قبطان

370
00:20:41,890 --> 00:20:45,650
انتظر يا أمير! ماذا تفعل؟

371
00:20:46,090 --> 00:20:48,410
!نحن ندخل الميناء

372
00:20:48,410 --> 00:20:50,690
!لا وقت نهدره

373
00:20:51,180 --> 00:20:53,010
!لا يمكننا السماح لك بهذا

374
00:20:53,320 --> 00:20:56,610
،إن كنتَ ستدخل بالقوّة

375
00:20:56,610 --> 00:21:01,140
فسنُطلق النار حتّى لو كان الأمير
!والأميرة على متن السفينة

376
00:21:03,690 --> 00:21:04,940
ماذا؟

377
00:21:06,920 --> 00:21:08,260
...يا قبطان

378
00:21:08,260 --> 00:21:09,610
!العلم الأبيض

379
00:21:16,720 --> 00:21:18,710
!ابتعدوا عن المدافع جميعًا

380
00:21:19,350 --> 00:21:23,970
مستحيل! سفينة إمبراطورية تستسلم؟

381
00:21:23,970 --> 00:21:25,840
!لم أسمع بمثل هذا من قبل

382
00:21:26,200 --> 00:21:29,490
...كما أنّهم يفعلون ذلك لإنقاذ رفاقنا

383
00:21:29,490 --> 00:21:30,800
!لا يصدق

384
00:21:31,110 --> 00:21:33,710
...ليونارد ريكس أدلر

385
00:21:34,340 --> 00:21:37,940
!لم أتوقع وجود أمير كهذا في الإمبراطورية

386
00:21:39,430 --> 00:21:41,640
!انقلوا ذوي الإصابات الخفيفة للعيادات القريبة

387
00:21:41,640 --> 00:21:43,010
!أسرعوا

388
00:21:46,730 --> 00:21:48,480
!لا بأس! ستكون بخير

389
00:21:50,290 --> 00:21:53,780
...انتهى كلّ شيء على خير

390
00:21:53,780 --> 00:21:55,790
.لكنّنا أسرى الآن

391
00:21:55,790 --> 00:21:57,210
.نعم

392
00:21:58,900 --> 00:22:00,160
.هيّا بنا

393
00:22:00,160 --> 00:22:03,720
علينا أن نتحدث مع دوقية
.ألباترو بخصوص تنين البحر

394
00:22:04,700 --> 00:22:07,560
.أنا متأكد أنّ هذا ما يُريدونه أيضًا