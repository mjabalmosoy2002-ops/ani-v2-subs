1
00:00:08,660 --> 00:00:09,940
هل أنتِ بخير يا رينّي؟

2
00:00:11,390 --> 00:00:13,070
...تذكّرتُ للتو

3
00:00:13,070 --> 00:00:17,140
كان شيد يقاتل هذا الشّيء أثناء حمايتي

4
00:00:26,750 --> 00:00:27,680
!رينّي

5
00:00:32,630 --> 00:00:34,470
!هل كنت أنت من فعل هذا؟

6
00:00:50,490 --> 00:00:53,580
...لكن انتهى المطاف بالقبض عليّ و

7
00:00:55,110 --> 00:00:57,780
!لا أريد أن أكون وحيدة ثانية

8
00:00:57,780 --> 00:00:59,450
لن أسمح بحدوث ذلك

9
00:01:02,760 --> 00:01:03,960
فأنا معكِ

10
00:02:44,150 --> 00:02:46,680
أعتذر يا شيد

11
00:02:48,140 --> 00:02:53,370
كاي، كنتُ لأرغب في لقائك بطريقة أخرى ما

12
00:03:03,900 --> 00:03:08,040
قُرِّرَ توسيع النّفوذ على العالم

13
00:03:15,190 --> 00:03:16,220
!ما هذا؟

14
00:03:17,290 --> 00:03:19,300
ينبغي أن تأخذ هذه كذلك

15
00:03:23,340 --> 00:03:28,470
إزالة بطلة الأرواح، شيفرة ريكوغين
كيوكو عن العالم

16
00:03:36,580 --> 00:03:38,280
يا له من شيء مُزعج

17
00:03:47,400 --> 00:03:49,370
تمّ رصد كمّية غير مُتوقَّعة من القوّة السّحريّة

18
00:03:49,910 --> 00:03:52,710
...إتمام الشّيفرة صفر بعد

19
00:03:54,100 --> 00:03:58,210
خاتمة انعكاس المرآة الكونيّ: ضوء

20
00:04:15,100 --> 00:04:15,970
!...هذا

21
00:04:15,970 --> 00:04:19,140
!تمثال حجريّ لبطل السّماويّين؟

22
00:04:20,220 --> 00:04:21,760
!تولَّ القيادة من فضلك

23
00:04:21,760 --> 00:04:23,110
!جان؟

24
00:04:25,700 --> 00:04:27,120
هل أنت بخير يا كاي؟

25
00:04:27,660 --> 00:04:28,590
رينّي؟

26
00:04:28,890 --> 00:04:32,330
نصبتُ حاجزاً حولنا بما أنّه انفجار ضخم

27
00:04:33,510 --> 00:04:34,770
ماذا...؟

28
00:04:34,770 --> 00:04:36,420
هل ريكوغين كيوكو فعلت كلّ هذا؟

29
00:04:36,780 --> 00:04:38,580
...أجل، غالباً

30
00:04:39,630 --> 00:04:40,580
لماذا؟

31
00:04:41,210 --> 00:04:43,380
!كاي! رينّي

32
00:04:43,380 --> 00:04:44,310
!جان

33
00:04:45,160 --> 00:04:46,500
!أنتما بخير؟

34
00:04:46,500 --> 00:04:48,180
!أجل! نحن قادمان حالاً

35
00:04:49,430 --> 00:04:50,510
...كم هذا مُطمئن

36
00:04:55,340 --> 00:04:56,980
...بعد انفجار كهذا، ما زال

37
00:05:11,370 --> 00:05:12,470
!هيّا بنا يا رينّي

38
00:05:13,690 --> 00:05:16,300
استمرار... الحذف

39
00:05:20,630 --> 00:05:21,560
!رينّي

40
00:05:21,860 --> 00:05:25,090
ما سرّ هذا الوحش بالضّبط؟

41
00:05:36,070 --> 00:05:39,020
تمّ رصد تأثير كبير من الكلمة المُحرّمة

42
00:05:39,020 --> 00:05:40,520
!لـ-لا

43
00:05:40,520 --> 00:05:44,370
يبلغ التدخُّل بالعالم الجديد مستويات خطيرة

44
00:05:44,370 --> 00:05:45,300
!لـ-لا

45
00:05:46,200 --> 00:05:48,410
بدء الحذف

46
00:05:48,930 --> 00:05:50,160
!لا

47
00:06:06,790 --> 00:06:09,260
!إيّاك ولمسها

48
00:06:10,190 --> 00:06:14,220
مُقاومة مُتزايدة من حامل السّيف المُحرَّم؟

49
00:06:19,010 --> 00:06:19,940
!ليس بعد

50
00:06:36,930 --> 00:06:38,540
!بدء العمليّة

51
00:06:40,000 --> 00:06:41,720
!كاي! غطِّ رينّي

52
00:06:45,120 --> 00:06:46,360
!أطلِقوا النّيران

53
00:06:56,200 --> 00:06:59,600
هذا السّهم النّاريّ الرّوحي قد امتصّ الحرارة
والسّحر الّذي يسمح له

54
00:06:59,600 --> 00:07:00,920
بالاحتراق للأبد

55
00:07:01,420 --> 00:07:03,900
إنّه الوحيد الّذي تمكّنتُ من صنعه

56
00:07:03,900 --> 00:07:05,360
احرصي على عدم تفويت الإصابة

57
00:07:05,360 --> 00:07:06,610
حسناً

58
00:07:10,980 --> 00:07:13,200
!اخترِق

59
00:07:59,220 --> 00:08:00,920
!لا ترخِ دِفاعك

60
00:08:00,920 --> 00:08:03,460
!ما زلنا لا نعلم ما قد يحدث

61
00:08:06,750 --> 00:08:10,810
لو سيميل-ل-فينوريا سيس

62
00:08:11,420 --> 00:08:13,490
سيز شيا

63
00:08:14,020 --> 00:08:18,880
ليشيافا بيلن ليف إي أس

64
00:08:20,430 --> 00:08:21,680
...هذا

65
00:08:22,270 --> 00:08:23,840
...يا لها من أغنية حزينة

66
00:08:25,150 --> 00:08:30,580
آين إيس إيت شيلا ألرا هيم

67
00:08:30,580 --> 00:08:33,820
ميكي أيندي بليا

68
00:08:41,400 --> 00:08:42,820
...هذا

69
00:08:42,820 --> 00:08:44,740
!إعادة تجسُّد العالم؟

70
00:08:44,740 --> 00:08:46,790
!إلى كافّة الجنود، حاصروا الهدف

71
00:08:50,750 --> 00:08:52,790
!لا، لا تذهب

72
00:08:52,790 --> 00:08:54,770
!هل أنت بخير؟

73
00:08:54,770 --> 00:08:55,700
!فالين

74
00:09:00,120 --> 00:09:03,850
بدء فترة المرحلة الثّانية من إعادة
تجسُّد العالم

75
00:09:20,520 --> 00:09:22,240
منح التّخويل

76
00:09:22,950 --> 00:09:26,210
استخدام القدرة رفيعة المستوى لتنفيذ
"الشّيفرة البديلة"

77
00:09:27,870 --> 00:09:31,850
"بدء تعديل "البطل الأقوى

78
00:09:55,720 --> 00:09:57,050
شيد

79
00:10:09,600 --> 00:10:14,840
شيد، خطؤك قد عطّلَ قدرَنا

80
00:10:15,960 --> 00:10:17,910
لكن لن أستسلم

81
00:10:19,240 --> 00:10:21,760
حتّى لو أصبح كلّ شيء في هذا العالم
...عِبارة عن رُكام

82
00:10:22,530 --> 00:10:25,360
سأحرص على نجاة الوحوش الأسطوريّين

83
00:10:36,830 --> 00:10:40,320
بدء التّسجيل كالنّبيّ شيد

84
00:10:41,750 --> 00:10:43,530
!كفى عبثاً يا لاست رايزر

85
00:10:47,670 --> 00:10:50,000
أنت تُقلّد شكله فحسب

86
00:10:50,350 --> 00:10:52,140
!لا يحقّ لك استخدام هذا الاسم

87
00:10:56,380 --> 00:10:58,220
!أكرهك أيضاً

88
00:11:01,900 --> 00:11:04,000
!لا تسخر من شيد

89
00:11:05,010 --> 00:11:08,020
القبض على الكيان النّهائيّ، رينّي

90
00:11:09,980 --> 00:11:11,000
!كاي

91
00:11:15,870 --> 00:11:18,150
!أعدها

92
00:11:36,750 --> 00:11:37,920
...هل أنا

93
00:11:48,950 --> 00:11:51,230
لماذا تتدرّب كثيراً؟

94
00:11:51,960 --> 00:11:53,870
لأنّه واجبي

95
00:11:54,770 --> 00:11:57,150
هل تنوي أن تصبح شيد البطل؟

96
00:11:57,720 --> 00:11:58,920
لا، الأمر ليس كذلك

97
00:11:59,390 --> 00:12:00,880
...بالنّسبة لي، شيد هو

98
00:12:04,010 --> 00:12:05,840
...شيد هو مَن

99
00:12:08,850 --> 00:12:10,080
...شيد هو

100
00:12:16,180 --> 00:12:18,220
!أنت لست شيد

101
00:12:21,710 --> 00:12:23,300
...أراد شيد

102
00:12:25,050 --> 00:12:27,010
!إنقاذ رينّي

103
00:12:37,710 --> 00:12:38,690
ماذا؟

104
00:12:48,870 --> 00:12:50,140
أيّتها الكائن المُختلَط

105
00:12:50,140 --> 00:12:51,800
لست جزءاً من أيّ عرق

106
00:12:51,800 --> 00:12:53,720
لماذا وُلدتِ أصلاً؟

107
00:12:53,720 --> 00:12:55,230
يا لها من رائحة فوضويّة

108
00:12:55,230 --> 00:12:56,680
!ابتعدي عن الطّريق أيّتها المُهجّنة

109
00:12:56,680 --> 00:12:58,340
...أنتِ وحياتكِ القذرة

110
00:12:58,340 --> 00:13:00,050
لا مكان لكِ

111
00:13:00,670 --> 00:13:02,590
طفلة مسكينة

112
00:13:02,940 --> 00:13:03,920
!كلّا

113
00:13:05,080 --> 00:13:06,870
،كنتُ أكره الجميع

114
00:13:07,430 --> 00:13:09,890
...لكن أحبّهم قليلاً الآن

115
00:13:10,400 --> 00:13:13,370
...كلّ هذا... لأنّ كاي سيبقى معي

116
00:13:15,130 --> 00:13:18,060
!لهذا أستطيع الاستمرار

117
00:13:18,950 --> 00:13:22,960
!لستُ... طفلة مسكينة

118
00:13:36,960 --> 00:13:37,890
!كاي

119
00:13:43,620 --> 00:13:45,600
رينّي، هل أنتِ بخير؟

120
00:13:45,600 --> 00:13:48,440
!أجل! سأقاتل معك يا كاي

121
00:13:51,900 --> 00:13:55,900
!ما قلّدتَه كان مجرّد قوى شيد

122
00:14:01,520 --> 00:14:04,190
...الشّخص الّذي خلفَ إرادة شيد

123
00:14:05,860 --> 00:14:06,950
!كان أنا

124
00:14:32,510 --> 00:14:33,440
!كاي

125
00:14:34,180 --> 00:14:35,430
!خذه

126
00:14:47,790 --> 00:14:48,900
...هذا

127
00:14:50,420 --> 00:14:52,840
لن يتغيّر القدر

128
00:14:53,930 --> 00:14:56,990
ستستمرُّ إعادة تجسُّد العالم ضمن دورة

129
00:14:57,980 --> 00:14:59,850
!هذا ليس القدر

130
00:15:02,270 --> 00:15:04,310
لطالما كان ما يُغيّر العالم

131
00:15:05,740 --> 00:15:09,020
!هو عزيمة المرء

132
00:15:16,860 --> 00:15:19,180
...شيد... المُعطَّل

133
00:15:19,800 --> 00:15:21,840
...العالم... العِرق

134
00:15:39,730 --> 00:15:41,400
هل إعادة تجسُّد العالم...؟

135
00:15:48,750 --> 00:15:49,840
!رينّي

136
00:16:27,380 --> 00:16:28,310
ماذا؟

137
00:16:33,280 --> 00:16:34,880
النّجدة

138
00:16:50,590 --> 00:16:51,650
رينّي؟

139
00:16:51,650 --> 00:16:52,580
!كاي؟

140
00:16:55,660 --> 00:16:56,870
!رينّي؟

141
00:16:57,250 --> 00:17:02,270
أنا مسرورة للغاية... كنتُ أخشى
...عدم استيقاظك

142
00:17:03,620 --> 00:17:05,750
يبدو أنّني أثرتُ قلقك

143
00:17:07,630 --> 00:17:12,040
كاي، هل تعرف شعوري تجاهك؟

144
00:17:12,040 --> 00:17:12,970
ماذا؟

145
00:17:13,290 --> 00:17:17,800
في البداية، كنتُ سعيدة بكوني معك

146
00:17:18,430 --> 00:17:23,080
تحمّلتُ البشر لأنّني أردتُ
،أن أكون معك

147
00:17:23,080 --> 00:17:26,520
وتمكّنتُ من الاستمرار في القتال
لأنّك كنت بجانبي

148
00:17:28,570 --> 00:17:31,880
لكن الآن، لا أريد أن أكون معك فقط

149
00:17:31,880 --> 00:17:32,810
ماذا؟

150
00:17:34,370 --> 00:17:39,340
أريدك أن... تحبّني يا كاي

151
00:17:41,190 --> 00:17:45,980
ما رأيك بي؟

152
00:17:46,630 --> 00:17:47,860
...في الواقع

153
00:17:51,100 --> 00:17:52,800
...رينّي، كيف حالُ كاي

154
00:17:58,070 --> 00:18:00,390
!ماذا تفعلان بالضّبط؟-
!لا يجوز أن تفعلا مثل هذه الأمور-

155
00:18:00,390 --> 00:18:02,930
!مهلاً! لِمَ أتيتما الآن؟

156
00:18:02,930 --> 00:18:05,650
هل أنت بخير؟ نمتَ لثلاثة أيّام

157
00:18:05,650 --> 00:18:06,430
!ثلاثة أيّام؟

158
00:18:06,430 --> 00:18:11,260
،بعد أن هزمتَ لاست رايزر
فقدتَ الوعي فجأة

159
00:18:11,260 --> 00:18:14,610
أحضرناك مباشرة إلى هنا، مشفى
جيش مُتمرّدي يولون

160
00:18:15,090 --> 00:18:18,780
استيقظتْ رينّي في غضون ساعات
...قليلة، بينما أنت يا كاي

161
00:18:20,470 --> 00:18:22,170
هـ... هكذا إذاً

162
00:18:22,580 --> 00:18:25,340
بغضّ النّظر، يسرّني أنّك استيقظت

163
00:18:25,340 --> 00:18:26,560
بالفعل

164
00:18:27,740 --> 00:18:29,670
بالمناسبة... رينّي

165
00:18:30,010 --> 00:18:33,300
من غير المُنصِف أن تحتكري
كاي حالما يستيقظ

166
00:18:33,300 --> 00:18:36,080
!أ-أجل! هذا غير عادل! وثقتُ بكِ

167
00:18:36,080 --> 00:18:37,630
!هـ-هذا عادِل

168
00:18:38,010 --> 00:18:41,520
كنتِ تمسكين بيد كاي لفترة طويلة
!في اللّيلة الماضية أيضاً يا جان

169
00:18:41,520 --> 00:18:42,700
!كنتِ تُراقبين؟

170
00:18:42,700 --> 00:18:46,120
!وريرين لم تترك كاي إطلاقاً أيضاً

171
00:18:46,120 --> 00:18:50,830
،كـ-كان ذلك لمنحه العِلاج فقط
...ولم أكن أفعل شيئاً

172
00:18:51,450 --> 00:18:52,830
عمّاذا كُنّ يتحدّثن؟

173
00:19:17,930 --> 00:19:20,630
لم أتوقّع أن تكوني بخير

174
00:19:20,630 --> 00:19:23,750
...أجل، لا سيّما بعد ذلك الانفجار

175
00:19:25,090 --> 00:19:26,720
ريكوغين كيوكو

176
00:19:26,720 --> 00:19:28,290
لستُ بخير

177
00:19:28,290 --> 00:19:30,830
هذا فقط لأنّني فصلتُ نُواتي

178
00:19:30,830 --> 00:19:35,860
ما لم أمتصّ كمّيةً كبيرة من الأرواح
،أو مقداراً هائلاً من السّحر

179
00:19:35,860 --> 00:19:39,030
فسأستغرق 30 سنة لأتعافى كلّياً

180
00:19:39,770 --> 00:19:41,280
أيّتها الوحش

181
00:19:41,910 --> 00:19:45,890
احرصي على الحِفاظ على اتّفاقية
الهدنة مع البشر

182
00:19:45,890 --> 00:19:47,290
أنت مُزعج

183
00:19:47,290 --> 00:19:52,690
إذا شعرتَ بأنّنا نكثنا بالوعد، فيمكنك
أن تُحطّم كيوكو الصّغيرة الضّعيفة فحسب

184
00:19:52,690 --> 00:19:55,290
...ضعيفة؟ انظروا من يتكلّم

185
00:19:55,290 --> 00:19:57,660
!اسمعوا أيّها البشر والأرواح

186
00:19:58,180 --> 00:20:00,290
،إذا أضررتُم بهذا التّمثال الحجريّ

187
00:20:00,290 --> 00:20:03,220
!فكأنّكم عاديتُم العِرق السّماويّ بأكمله

188
00:20:03,560 --> 00:20:04,910
بالطّبع

189
00:20:04,910 --> 00:20:08,830
سنمنع دخول كافّة الأعراق إلى هذا المكان

190
00:20:08,830 --> 00:20:10,400
كيوكو تتّفق أيضاً

191
00:20:10,810 --> 00:20:15,190
الآن، يجب أن نضع الأولويّة لاكتشاف
المزيد عن لاست رايزر وهزيمته

192
00:20:15,540 --> 00:20:18,580
والدّليل الّذي لدينا هو مع البطل المُتبقّي، صحيح؟

193
00:20:18,580 --> 00:20:19,530
...أجل

194
00:20:20,270 --> 00:20:24,600
بطل الوحوش الأسطوريّين، ملِك النّاب راث إي

195
00:20:29,990 --> 00:20:34,680
الانتقال إلى المرحلة الثّانية من إعادة
تجسُّد العالم قد فَشِل

196
00:20:35,460 --> 00:20:39,260
كان هذا مُتوقّعاً، بما أنّ قوّة لاست رايزر
...واحدة فقط استُخدِمت لأجل ذلك

197
00:20:41,490 --> 00:20:45,710
فضلاً عن ذلك... تلك الطّفلة تستمرّ
في اليقظة

198
00:20:49,830 --> 00:20:52,670
...والشّخص الّذي أشعل ذلك كان

199
00:20:54,100 --> 00:20:55,080
!حسناً

200
00:20:55,080 --> 00:20:55,940
هل يوجد بعضٌ هناك؟

201
00:20:55,940 --> 00:20:56,870
!أجل

202
00:20:57,420 --> 00:20:58,060
ها أنت ذا

203
00:20:58,060 --> 00:20:58,990
!مهلاً

204
00:20:59,400 --> 00:21:00,420
حقّاً؟

205
00:21:06,650 --> 00:21:07,740
كاي

206
00:21:08,170 --> 00:21:10,680
...هل تعتقد بأنّ تمثال البطل السّماويّ

207
00:21:11,230 --> 00:21:12,990
هو نفسه ذاك؟

208
00:21:13,710 --> 00:21:15,120
أجل، ممكن

209
00:21:16,280 --> 00:21:19,340
ستستمرُّ إعادة تجسُّد العالم ضمن دورة

210
00:21:23,630 --> 00:21:27,130
...مع ذلك، رينّي، كاي

211
00:21:27,750 --> 00:21:32,330
كيف يمكنكما الاستمرار في مُقاومة القدر؟

212
00:21:39,410 --> 00:21:42,630
بصراحة، لستُ متأكّداً أيضاً

213
00:21:43,100 --> 00:21:46,620
كلّ ما في الأمر... ائتمنني
شيد على هذا

214
00:21:46,620 --> 00:21:47,490
ماذا؟

215
00:21:48,360 --> 00:21:52,700
على حمايتكِ وإنهاء الحرب
العظيمة للأعراق الخمسة

216
00:21:53,490 --> 00:21:54,710
!كاي

217
00:21:57,890 --> 00:21:58,850
هيّا بنا

218
00:21:58,850 --> 00:21:59,780
!حسناً