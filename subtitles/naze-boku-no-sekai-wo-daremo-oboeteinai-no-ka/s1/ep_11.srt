1
00:00:01,470 --> 00:00:06,620
!أتينا إلى هنا أساساً للتحرّي بشأن هذه البُحيرة

2
00:00:06,620 --> 00:00:07,710
التحرّي؟

3
00:00:08,890 --> 00:00:10,990
هذه ليست بُحيرة

4
00:00:11,490 --> 00:00:13,360
ليست بُحيرة؟

5
00:00:13,360 --> 00:00:15,800
أجل، إنّها روح

6
00:00:31,060 --> 00:00:31,990
...هذا

7
00:00:36,190 --> 00:00:38,360
...بطل الأرواح

8
00:00:39,150 --> 00:00:42,020
!حاكمة الأرواح ريكوغين كيوكو

9
00:00:43,210 --> 00:00:44,560
...أيّها البشر

10
00:00:46,670 --> 00:00:47,820
...أنتم تعترضون طريقي

11
00:01:00,320 --> 00:01:04,870
لماذا لا أحد يتذكّرني
في هذا العالم؟

12
00:02:30,330 --> 00:02:32,880
انعكاس المرآة الكونيّ: مُحيط

13
00:02:32,880 --> 00:02:33,980
!ما... احذروا

14
00:02:57,990 --> 00:02:58,990
!ليس بعد

15
00:03:01,230 --> 00:03:02,160
!الآن

16
00:03:02,160 --> 00:03:03,410
!اشتعلي

17
00:03:08,590 --> 00:03:11,040
انعكاس المرآة الكونيّ: نار

18
00:03:16,210 --> 00:03:17,140
!ماذا؟

19
00:03:25,180 --> 00:03:26,600
!حامل الشّيفرة

20
00:03:44,210 --> 00:03:47,370
هل هذا حامِل شيفرة؟

21
00:03:47,760 --> 00:03:48,710
ماذا؟

22
00:03:58,680 --> 00:04:00,060
...تحذير

23
00:04:00,660 --> 00:04:05,590
تمّ تأكيد احتكاك بين بطلة
الأرواح وحامل الشّيفرة

24
00:04:11,640 --> 00:04:14,900
صوت الفتاة الصّغيرة ذاك، أهذه
أنتِ يا ريرين؟

25
00:04:15,260 --> 00:04:18,550
لستُ أنا. أهي أنتِ يا رينّي؟

26
00:04:18,550 --> 00:04:21,390
لستُ أنا. إنّها جان، صحيح؟

27
00:04:21,390 --> 00:04:22,530
!مـ-مهلاً

28
00:04:22,530 --> 00:04:23,820
!أجب أيّها البشريّ

29
00:04:24,810 --> 00:04:26,950
لماذا تحمل هذا؟

30
00:04:27,970 --> 00:04:30,460
تستطيع الأرواح التكلُّم؟

31
00:04:31,530 --> 00:04:34,240
كان هذا السّيف بحيازة ذلك البشريّ

32
00:04:34,900 --> 00:04:41,060
...ذلك البشريّ، ما فعله بي... جعلني

33
00:04:42,840 --> 00:04:44,170
...هل

34
00:04:44,590 --> 00:04:46,270
هل تقصدين شيد؟

35
00:04:46,270 --> 00:04:47,240
...شيد

36
00:04:48,530 --> 00:04:50,280
،هذا صحيح، شيد

37
00:04:51,130 --> 00:04:53,130
أكثر وجود أكرهه

38
00:04:53,470 --> 00:04:56,000
...عدوّ كافّة الأرواح

39
00:04:57,270 --> 00:05:01,590
...لكن، بشريّ... جلبَ الحكمة إلى كيوكو

40
00:05:03,970 --> 00:05:08,110
،كيوكو تعلّمت... لغة البشر

41
00:05:09,330 --> 00:05:12,370
من أجل فهم كلام شيد

42
00:05:15,060 --> 00:05:17,210
ثأر القدر على وشك أن يبدأ

43
00:05:19,170 --> 00:05:21,940
...إعادة تجسُّد العالم هي البداية فقط

44
00:05:23,090 --> 00:05:26,650
العالم... بدأ يتحوّل

45
00:05:28,090 --> 00:05:30,120
البداية فقط...؟

46
00:05:31,390 --> 00:05:35,560
هل يُعقَل أنّ... الأمر لا يقتصر
على إعادة تجسُّد العالم؟

47
00:05:40,970 --> 00:05:46,660
"تأثّرت بطلة الأرواح من الكلمة المُحرّمة "شيد

48
00:05:47,030 --> 00:05:48,970
ما هذا...؟

49
00:05:51,280 --> 00:05:52,210
!ذلك الشّيء؟

50
00:05:52,530 --> 00:05:53,990
!هذه الّتي كانت مع آلفريا

51
00:05:54,690 --> 00:05:56,290
!لاست رايزر

52
00:05:56,670 --> 00:05:58,630
تنفيذ الشّيفرة صفر

53
00:05:59,160 --> 00:06:01,820
–إزالة شيفرة ريكوغين كيوكو عن العالم

54
00:06:03,470 --> 00:06:07,840
هذا صحيح، كانت كيوكو غاضبة منك

55
00:06:11,880 --> 00:06:14,510
ضرر غير مُتوقَّع

56
00:06:14,510 --> 00:06:17,520
إعطاء الأولويّة لحماية الجسد المختوم

57
00:06:30,050 --> 00:06:31,360
انتهينا

58
00:06:31,360 --> 00:06:32,290
ماذا؟

59
00:06:33,160 --> 00:06:34,990
كيوكو مُتعَبة

60
00:06:35,530 --> 00:06:38,000
لذا، نكتفي بهذا القدر حالياً

61
00:06:40,040 --> 00:06:42,030
ما الّذي تخطِّطين له؟

62
00:06:42,030 --> 00:06:45,420
هل تحاولين كسب بعض الوقت أيّتها الرُّوح؟

63
00:06:47,130 --> 00:06:52,090
،هناك ظرافة ما في غبائك
لكن التّفسير مُرهِق

64
00:06:52,090 --> 00:06:53,510
ماذا قلتِ؟

65
00:06:53,890 --> 00:06:56,330
تقترح كيوكو وقفاً للنّار

66
00:06:56,330 --> 00:06:59,020
!أنتِ من هاجمنا في البداية

67
00:06:59,360 --> 00:07:00,740
سبب اضطراري

68
00:07:01,310 --> 00:07:05,130
ظننتُ بأنّني أتعرّض لكمين عندما
كنتُ أتجدّد فحسب

69
00:07:06,220 --> 00:07:07,710
...تجدُّد

70
00:07:08,420 --> 00:07:11,280
استُنزِفتِ إلى هذه الدّرجة؟

71
00:07:11,800 --> 00:07:14,730
أنتِ، بطلة الأرواح؟

72
00:07:15,410 --> 00:07:20,720
أنت أذكى قليلاً لذا لستَ
بتلك الظّرافة

73
00:07:20,720 --> 00:07:21,650
ماذا؟

74
00:07:22,630 --> 00:07:25,620
كانت كيوكو تقاتل راث إي

75
00:07:25,620 --> 00:07:27,540
!مع بطل الوحوش الأسطوريّة؟

76
00:07:29,030 --> 00:07:30,780
إنّه قويّ

77
00:07:30,780 --> 00:07:34,760
لكن ما كان أكثر إزعاجاً هو ذلك الشّيء

78
00:07:35,420 --> 00:07:39,520
إنّه نفس النّوعيّة من الوحوش الّتي
هاجمت كيوكو من قبل

79
00:07:39,520 --> 00:07:41,480
!تقصدين لاست رايزر

80
00:07:41,480 --> 00:07:43,140
...لاست رايزر

81
00:07:43,900 --> 00:07:47,150
هذا صحيح. أطلق عليه شيد
ذلك الاسم أيضاً

82
00:07:48,980 --> 00:07:50,190
...شيد

83
00:07:51,030 --> 00:07:53,440
كان يعلم بلاست رايزر؟

84
00:07:55,090 --> 00:07:59,270
كلّ الأعراق الخمسة لا تتمنّى
سوى الأفضل لبني جنسها

85
00:07:59,720 --> 00:08:03,160
لكن ذلك الشّيء ليس جزءاً من أيّ عرق

86
00:08:04,120 --> 00:08:05,210
،لا هو شيطان

87
00:08:05,750 --> 00:08:07,170
،ولا سماويّ

88
00:08:07,710 --> 00:08:09,130
،ولا روح

89
00:08:09,570 --> 00:08:11,090
،ولا وحش أسطوريّ

90
00:08:11,620 --> 00:08:13,100
ولا بشريّ

91
00:08:13,920 --> 00:08:15,310
...لهذا هو خطير

92
00:08:16,390 --> 00:08:20,140
لاست رايزر هي الكره بحدّ ذاته لهذا العالم

93
00:08:20,660 --> 00:08:23,220
عدوّ للعالم

94
00:08:25,830 --> 00:08:27,640
هناك مصداقيّة

95
00:08:28,100 --> 00:08:32,330
،الوحش المعروف بلاست رايزر
،لم تُهاجمنا فحسب

96
00:08:32,750 --> 00:08:36,160
بل هاجمت فانيسّا وآلفريا كذلك

97
00:08:37,460 --> 00:08:40,110
إذاً مقصدك هو ألّا نتماشى مع ما يقترحه
هذا العدوّ الثّائر؟

98
00:08:40,820 --> 00:08:44,560
كنّا نقاتل الأرواح طوال هذا الوقت

99
00:08:44,560 --> 00:08:46,150
...لا يجوز لنا

100
00:08:46,570 --> 00:08:51,840
وافقتُ على وقفٍ لإطلاق النّار
مع الشّياطين والسّماويّين كذلك

101
00:08:54,620 --> 00:08:58,520
لا حاجة لنسيان الماضي ونصبح مُقرّبين

102
00:08:59,270 --> 00:09:02,090
،لكن إذا استطعنا التوصُّل إلى اتّفاقيّة لا عنف

103
00:09:02,090 --> 00:09:05,500
فينبغي أن نتمكّن من الحدّ
من تضحيات مستقبليّة

104
00:09:08,650 --> 00:09:12,230
حالياً، سوف نرمي أسلحتنا

105
00:09:12,650 --> 00:09:16,100
حقّاً؟ إذاً كيوكو سوف تذهب

106
00:09:16,600 --> 00:09:17,530
إلى أين؟

107
00:09:18,620 --> 00:09:24,330
إلى ذلك المنزل الأسود. هناك حيث
التقت كيوكو أوّل مرّة مع لاست رايزر

108
00:09:24,690 --> 00:09:25,800
في المقبرة؟

109
00:09:26,470 --> 00:09:29,230
هل تقصدين قبل حدوث إعادة تجسُّد العالم؟

110
00:09:30,330 --> 00:09:31,270
...المقبرة

111
00:09:32,220 --> 00:09:36,270
هذا صحيح، المقبرة. بدأتُ أتذكّر أكثر فأكثر

112
00:09:36,690 --> 00:09:39,860
بعد مغادرة شيد، ظهر ذلك الشّيء

113
00:09:41,720 --> 00:09:43,480
،كانت إمبراطورة الظّلام تتعالى عليه

114
00:09:44,530 --> 00:09:46,270
،وحاكم السّماوات رفضه

115
00:09:47,350 --> 00:09:49,590
وكان لكيوكو شكوكها

116
00:09:51,400 --> 00:09:54,380
وملِك النّاب راث إي كان الوحيد الّذي تقبّلَه

117
00:09:55,890 --> 00:09:59,790
ذلك الوحش... إنّه يتعايش مع لاست رايزر

118
00:09:59,790 --> 00:10:03,010
ماذا؟! هل ليصبح أقوى حتّى؟

119
00:10:03,370 --> 00:10:07,130
لا، محال أن يعتمد بطل الوحوش الأسطوريّة

120
00:10:07,130 --> 00:10:10,670
على شخص ما ليصبح أقوى

121
00:10:11,390 --> 00:10:13,750
...مخطّطات راث إي هي غالباً

122
00:10:14,820 --> 00:10:18,990
شيء آخر غير نتيجة الحرب العظيمة
للأعراق الخمسة

123
00:10:21,310 --> 00:10:23,220
أعتذر لو تأخّرتُ عليكم. هيّا بنا

124
00:10:24,780 --> 00:10:27,480
أيّها البشريّ، أين المدخل؟

125
00:10:27,820 --> 00:10:29,550
من هنا غالباً

126
00:10:29,550 --> 00:10:30,650
اتبعوني

127
00:10:38,940 --> 00:10:40,010
...هذا

128
00:10:40,410 --> 00:10:44,580
أجل، إنّها مثل مقبرة الشّيطان
في اتِّحاد أورزا

129
00:10:49,460 --> 00:10:51,840
إنّه بناء غامض

130
00:10:52,290 --> 00:10:54,590
،لا ينتمي للسّماويّين

131
00:10:54,590 --> 00:10:57,320
وهو ليس شيئاً بُني بواسطة
البشر، صحيح؟

132
00:10:57,320 --> 00:11:00,800
هذا إذاً أحد النُّصُب الحجريّة

133
00:11:02,010 --> 00:11:04,510
لديه نفس بُنية مقبرة الشّيطان

134
00:11:09,880 --> 00:11:12,500
وجدتُ حامل الشّيفرة هناك في الأمام

135
00:11:15,620 --> 00:11:16,710
...هذا المكان

136
00:11:29,630 --> 00:11:32,840
أولئك الّذين طوّقهم قدرُ الكراهية

137
00:11:36,630 --> 00:11:37,960
!إنّه صوت شيد

138
00:11:37,960 --> 00:11:40,120
هذا ما ظننتُه

139
00:11:41,530 --> 00:11:46,980
ارتكبتُ خطأ وكنتُ عاجزاً عن حماية رينّي

140
00:11:48,920 --> 00:11:51,740
من فضلك... صِل إلى ذلك المكان

141
00:11:54,210 --> 00:11:58,890
...إلى المستقبل الآخر الّذي عجزتُ عن بلوغه

142
00:12:27,590 --> 00:12:29,770
ما هذا المكان؟

143
00:12:30,510 --> 00:12:34,790
...كنّا داخل البناء قبل لحظات

144
00:12:36,200 --> 00:12:40,840
لا يروقني هذا. أشعر وكأنّنا
استُدرِجنا نحو فخّ

145
00:12:40,840 --> 00:12:42,150
يراودني نفس الشّعور

146
00:12:42,580 --> 00:12:44,240
كاي، اشرح

147
00:12:44,700 --> 00:12:46,620
لستُ متأكّداً أيضاً

148
00:12:47,140 --> 00:12:49,660
...في أورزا، أُخِذتُ إلى هنا كذلك، و

149
00:12:54,190 --> 00:12:55,620
!إلى أين أنتِ ذاهبة؟

150
00:12:58,530 --> 00:13:01,390
هناك مصدر كبير من القوّة السّحريّة

151
00:13:10,430 --> 00:13:11,930
...هذا

152
00:13:13,100 --> 00:13:14,030
—ما

153
00:13:15,800 --> 00:13:18,340
سيّد... آلفريا؟

154
00:13:25,500 --> 00:13:27,160
...أشعر بقوّة سحريّة

155
00:13:28,860 --> 00:13:29,850
...هذا

156
00:13:31,000 --> 00:13:33,500
فهمت، سحر تحجير

157
00:13:34,150 --> 00:13:35,620
...لو نستطيع تحليله فقط

158
00:13:39,210 --> 00:13:41,290
!ماذا تنوي أن تفعل أيّها البشريّ؟

159
00:13:40,050 --> 00:13:41,950
!دعيني

160
00:13:41,950 --> 00:13:44,200
،إن كنتِ تقولين بأنّ هذا بطل السّماويّين

161
00:13:44,200 --> 00:13:46,540
!فتدميره الآن هو خير للبشريّة

162
00:13:46,540 --> 00:13:48,200
!بالطّبع، لن أدعك تفعل ذلك

163
00:13:48,200 --> 00:13:49,510
!دعيني

164
00:13:50,750 --> 00:13:52,890
هذا ليس مجرّد تحجير

165
00:13:54,820 --> 00:13:57,000
يبدو أنّه مُتجمِّد

166
00:13:57,790 --> 00:14:00,310
المظهر الحجريّ سطحيّ فقط

167
00:14:01,860 --> 00:14:06,530
الشّيفرة صفر... بدأتُ أفهم آليّة عمل ذلك

168
00:14:07,450 --> 00:14:10,710
ما الّذي يجري؟ ما هذا المكان؟

169
00:14:10,710 --> 00:14:14,080
...لا أعلم. لكن عندما أتيتُ إلى هنا قبل أن

170
00:14:20,600 --> 00:14:24,100
تمّ رصد تدخُّل غير مُخوّل
في حقل خالٍ من إحداثيّات

171
00:14:24,100 --> 00:14:26,510
تمّ رصد استجابة دنوّ من الجسد المختوم

172
00:14:27,370 --> 00:14:28,920
...الجسد المختوم

173
00:14:28,920 --> 00:14:31,680
هل تشير إلى آلفريا؟

174
00:14:34,400 --> 00:14:39,040
تنبيه. رصد خطر مُحتمَل على العالم الجديد

175
00:14:39,810 --> 00:14:45,150
"البدء بطور لاست رايزر "الرّغبة في التّدمير
للشّروع في عمليّة العزل

176
00:14:45,150 --> 00:14:46,660
،في الوقت المناسب

177
00:14:46,660 --> 00:14:49,360
يمكنني الثّأر للسيّد آلفريا

178
00:14:49,720 --> 00:14:51,210
إنّها رائحة فظيعة

179
00:14:51,730 --> 00:14:53,210
تُشعِر بالغثيان

180
00:14:53,210 --> 00:14:54,830
تفوح رائحة الموت في الجو

181
00:14:57,220 --> 00:14:58,750
!كم هذا مُريع

182
00:15:00,900 --> 00:15:03,090
تمّت عمليّة الفرز

183
00:15:03,090 --> 00:15:07,880
دمّر ثلاثة، الّذين استجابوا للكلمة
"المُحرّمة "شيد

184
00:15:08,690 --> 00:15:11,590
اعزل الأربعة الّذين لم يستجيبوا

185
00:15:15,430 --> 00:15:16,290
!جان

186
00:15:16,290 --> 00:15:17,220
!كاي

187
00:15:17,850 --> 00:15:19,560
!أقسم بأنّني سأعود

188
00:15:22,770 --> 00:15:25,480
...كاي، جان والآخرون

189
00:15:25,890 --> 00:15:31,240
لا تقلقي. العزل يعني أنّ جان والآخرين
قد أُرسِلوا إلى الخارج

190
00:15:31,710 --> 00:15:35,240
...تعمّد هذا الشّيء تركنا هنا

191
00:15:35,690 --> 00:15:36,860
أتّفق

192
00:15:36,860 --> 00:15:41,440
ربّما اختارتْ أولئك الّذين يمتلكون
ذاكرة حول شيد

193
00:15:41,970 --> 00:15:48,210
بصيغة أخرى، وجودنا في هذا العالم
يُعتبَر غير مرغوب فيه

194
00:15:49,260 --> 00:15:50,950
!سوف أدمّركم

195
00:15:55,050 --> 00:15:56,140
!اللّعنة

196
00:16:00,270 --> 00:16:01,770
جان-ساما، إلى أين؟

197
00:16:02,140 --> 00:16:07,020
سوف أعود. الباب المؤدّي إلى الفضاء البديل
الدّاخلي ينبغي أنّه ما زال موجوداً

198
00:16:07,410 --> 00:16:09,550
ذلك الوحش غير عاديّ

199
00:16:09,940 --> 00:16:13,410
إلى أي درجة تثِقين في هزيمة ذلك
الشّيء إذا عدتِ؟

200
00:16:15,900 --> 00:16:18,870
لديّ ملاذ أخير

201
00:16:19,480 --> 00:16:23,740
لا تفعليها. لا تقصّري حياتكِ
لأجل شيء كهذا

202
00:16:24,200 --> 00:16:27,380
فالباب إلى الفضاء البديل
قد أُوصِد كذلك

203
00:16:28,380 --> 00:16:29,840
إذاً ماذا يجدر بي أن أفعل؟

204
00:16:30,430 --> 00:16:32,300
أوّلاً، نحتاج خطّة

205
00:16:36,030 --> 00:16:37,720
أتّفق

206
00:16:37,720 --> 00:16:41,160
ليس لديّ خطّة الآن

207
00:16:41,160 --> 00:16:45,480
سنعود من جديد حالما نجمع أسلحتنا
وننتهي من التّحضير

208
00:16:45,790 --> 00:16:51,540
أجل. هناك شيء أيضاً أريد تجربته
لذا مدّوني بمساعدتكم

209
00:16:55,300 --> 00:16:57,410
انعكاس المرآة الكونيّ: مُحيط

210
00:16:59,450 --> 00:17:00,810
الشّيفرة صفر

211
00:17:12,930 --> 00:17:17,000
أنتِ أيضاً معنية. لماذا لا تُقاتلين؟

212
00:17:17,930 --> 00:17:19,260
...لا أعلم

213
00:17:20,200 --> 00:17:24,030
أنا خائفة من هذا الشّيء. لا يروقني بصراحة

214
00:17:24,030 --> 00:17:25,760
...لا أريد النّظر إليه

215
00:17:27,700 --> 00:17:32,160
...لماذا؟ أريد القتال بجانب كاي أيضاً

216
00:17:32,860 --> 00:17:35,420
إذاً مدّيني بسحركِ على الأقلّ

217
00:17:35,420 --> 00:17:36,350
ماذا؟

218
00:17:45,390 --> 00:17:47,420
ساهمَ ذلك قليلاً

219
00:17:51,470 --> 00:17:52,900
!تبّاً

220
00:17:53,890 --> 00:17:55,920
انعكاس المرآة الكونيّ: جليد

221
00:17:58,630 --> 00:17:59,720
!تحطّم

222
00:18:05,260 --> 00:18:06,590
...مذهل

223
00:18:08,210 --> 00:18:09,310
ثمّة أمر غير طبيعيّ

224
00:18:10,950 --> 00:18:14,100
تنفيذ تعديل لاست رايزر

225
00:18:23,100 --> 00:18:24,740
...هذا الشّيء لا يُصدَّق

226
00:18:24,740 --> 00:18:29,750
إذا كان يستطيع التجدُّد، فلماذا لم يفعل ذلك
عندما ألحقتْ كيوكو ضرراً به من قبل؟

227
00:18:30,010 --> 00:18:33,470
على ذكرِ الأمر، حدث نفس الأمر
عندما قاتل فانيسّا

228
00:18:34,130 --> 00:18:37,380
فهمت، الوقت الوحيد الّذي يستطيع
...التجدُّد فيه هو عندما

229
00:18:37,680 --> 00:18:39,450
فقط عندما يكون ضمن هذا الفضاء البديل

230
00:18:40,550 --> 00:18:45,900
أيّها البشريّ، كيف هربت من هذا الفضاء
عندما كنتَ هنا في آخر مرّة؟

231
00:18:45,900 --> 00:18:48,020
...آنذاك، كنتُ خائفاً

232
00:18:54,500 --> 00:18:58,190
لذا قطّعتُ الفضاء البديل فحسب
بواسطة حامل الشّيفرة

233
00:18:58,190 --> 00:19:03,190
من المُحبِط قليلاً أن تضطرّ كيوكو
للاعتماد على ذلك السّيف

234
00:19:07,330 --> 00:19:08,260
ماذا؟

235
00:19:11,950 --> 00:19:14,010
كما توقّعت، هذا الشّيء مهمّ بالنّسبة له

236
00:19:14,510 --> 00:19:16,520
سوف نستخدمه لاستدراجه للخارج

237
00:19:16,920 --> 00:19:18,410
لا تضرّيه، اتّفقنا؟

238
00:19:18,970 --> 00:19:21,310
هل أنت قلق على البطل السّماويّ؟

239
00:19:21,710 --> 00:19:24,940
هذا أيضاً، لكن... ريرين سوف تغضب

240
00:19:25,420 --> 00:19:26,850
أنت بشريٌّ غريب

241
00:19:29,230 --> 00:19:30,280
!اهرب

242
00:19:35,970 --> 00:19:36,900
!رينّي

243
00:19:38,570 --> 00:19:39,570
!هيّا بنا

244
00:19:49,610 --> 00:19:51,540
!انعكاس المرآة الكونيّ: نار

245
00:20:03,220 --> 00:20:04,790
!السّيف المُحرَّم

246
00:20:05,350 --> 00:20:06,710
!اقفزا

247
00:20:23,880 --> 00:20:26,490
!انعكاس المرآة الكونيّ: رعد

248
00:20:28,950 --> 00:20:29,950
!اختفي

249
00:20:52,050 --> 00:20:56,300
لا مانع من استخدامنا هذا الكمّ
من هذه المادّة، صحيح؟

250
00:20:56,300 --> 00:20:58,560
!نعتمد عليكِ حقّاً يا ريرين-تشان

251
00:20:58,860 --> 00:21:01,870
!الرّصاص البشريّ لا ينجح على أيّ حال

252
00:21:03,480 --> 00:21:05,200
...لكن إذا كان هذا

253
00:21:05,890 --> 00:21:06,950
!ماذا؟

254
00:21:09,610 --> 00:21:11,370
ماذا حدث للتو؟

255
00:21:20,290 --> 00:21:22,320
أنا مُرهَقة قليلاً

256
00:21:22,320 --> 00:21:23,960
...أ-أجل

257
00:21:25,800 --> 00:21:27,050
ما الخطب؟

258
00:21:34,770 --> 00:21:37,740
ما... هذه القوّة السّحريّة...؟

259
00:21:45,890 --> 00:21:47,070
...هذا الشّيء

260
00:21:47,620 --> 00:21:49,800
...هو الّذي كان قد حبس رينّي

261
00:21:50,730 --> 00:21:52,810
...طور لاست رايزر

262
00:21:53,400 --> 00:21:58,080
بـ"إرادة العالم"، ابدأ ألف رحلة نحو القدر

263
00:21:59,320 --> 00:22:04,960
ابدأ بحذف الكيان الأخير

264
00:23:37,140 --> 00:23:39,980
لماذا لا أحد يتذكّرني
في هذا العالم؟