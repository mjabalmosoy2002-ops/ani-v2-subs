1
00:00:01,610 --> 00:00:04,450
أكره الشّياطين لأنهم مُخادِعون

2
00:00:04,620 --> 00:00:07,310
أكره الأرواح لأنّهم مُخيفون

3
00:00:07,730 --> 00:00:10,170
أكره المخلوقات الأسطوريّة لأنّهم مُتوحِّشون

4
00:00:10,740 --> 00:00:13,260
أكره السّماويّين لأنّهم عنيدون

5
00:00:14,570 --> 00:00:18,030
أكره البشر لأنّهم ضُعفاء

6
00:00:20,190 --> 00:00:25,360
وأكره نفسي أكثر لأنّني
مُكوَّنة من كلّ ما سبق

7
00:00:26,670 --> 00:00:31,330
،لكن كاي، كان الوحيد الّذي لم يخف منّي

8
00:00:31,500 --> 00:00:34,270
والّذي لم يكرهني، وحضنني

9
00:00:35,670 --> 00:00:38,880
كاي، لا تمُت، مفهوم؟

10
00:02:16,490 --> 00:02:19,300
مُسخِّرين كلّ جهودنا معاً، يتوجّه
جيش مُتمرِّدي اتِّحاد أورزا

11
00:02:19,470 --> 00:02:22,280
نحو القصر الحكوميّ عن طريق
المعبر تحت الأرض لشنِّ هجوم

12
00:02:22,690 --> 00:02:25,830
،بينما تُلهي القوّاتُ الرّئيسيّة الشّياطينَ

13
00:02:26,000 --> 00:02:29,040
سنُحرِّر الأسرى من السّرداب ونهزم فانيسّا

14
00:02:29,960 --> 00:02:31,800
جان-ساما من سيعود العمليّة في النّهاية

15
00:02:31,970 --> 00:02:34,380
أعتقد بأنّ العمليّة ستنجح

16
00:02:34,550 --> 00:02:38,420
الشّيء الوحيد الّذي أنا قلِقة
...بشأنه في هذه الخطّة

17
00:02:39,300 --> 00:02:42,800
!هو أنّنا فريق الهجوم الّذي سيهزم فانيسّا

18
00:02:42,970 --> 00:02:46,560
لا أصدِّق ذلك! ما الّذي يتأمّلون منّا
!فعله بوجودنا نحن الأربعة فقط؟

19
00:02:46,730 --> 00:02:50,350
كما قلتُ، هذا من أجل الوصول
إلى فانيسّا في أسرع وقت

20
00:02:50,520 --> 00:02:53,480
!أعلم ذلك، لكن لماذا أنا؟

21
00:02:53,870 --> 00:02:57,690
الوحيدون الّذين أستطيع الوثوق بهم
ليُشكِّلوا سنداً لنا هم أنتِ وأشران

22
00:02:57,860 --> 00:02:59,790
...أفهم ذلك أيضاً، لكن

23
00:02:59,960 --> 00:03:02,120
!هذا مُخيف، مفهوم؟

24
00:03:04,610 --> 00:03:05,910
أتشعرين بتحسُّن؟

25
00:03:07,230 --> 00:03:09,120
أجل... شكراً

26
00:03:09,750 --> 00:03:12,880
أنتِ صديقة كاي لذا أنتِ مُميّزة

27
00:03:13,720 --> 00:03:16,760
لا تقلقي يا ساكي. أنا قويّة

28
00:03:16,930 --> 00:03:19,290
غالباً لن أخسر إن لم تكن فانيسّا

29
00:03:19,460 --> 00:03:21,020
ماذا؟ لماذا إن لم تكن فانيسّا؟

30
00:03:23,210 --> 00:03:24,720
!ما هذا الصّمت؟

31
00:03:25,070 --> 00:03:26,140
لا تقلقي

32
00:03:26,310 --> 00:03:29,400
عندما يحين الوقت، سأدمِّر نفسي
وأقضي على فانيسّا معي

33
00:03:29,570 --> 00:03:30,570
!لا تفكِّري في ذلك حتّى

34
00:03:31,410 --> 00:03:33,600
أنا قلقٌ معكِ أيضاً

35
00:03:33,770 --> 00:03:36,610
،لا نعرف وضع القصر الحكوميّ

36
00:03:36,780 --> 00:03:41,210
وفضلاً عن ذلك، ألن نكون مكشوفين
إذا تحرّكنا كجماعة ضخمة هكذا؟

37
00:03:41,380 --> 00:03:44,880
،أجل. الشّياطين حسّاسة للسّحر

38
00:03:45,050 --> 00:03:46,780
لكن البشر لا يملكون قدرات سحريّة

39
00:03:47,420 --> 00:03:49,750
لهذا ينبغي أن يكون من الأصعب
بالنّسبة لهم إيجادنا

40
00:03:50,070 --> 00:03:52,990
أهذا شيء آخر تعلّمتَه من العالم
الّذي أتيت منه؟

41
00:03:53,160 --> 00:03:54,720
هذا يُشعرني براحة على الأقلّ

42
00:03:55,160 --> 00:03:56,710
أنت هادئ جدّاً يا أشران

43
00:03:57,090 --> 00:03:58,350
عمّاذا تتكلّم؟

44
00:03:58,520 --> 00:04:00,420
كانت يدايّ ترتجفان طوال هذا الوقت

45
00:04:00,950 --> 00:04:03,610
،لكن أتعلم؟ إذا تمكنّا من هزيمة الشّياطين

46
00:04:03,780 --> 00:04:06,180
فسنغدو حديث النّاس

47
00:04:06,820 --> 00:04:10,140
قد نتلقّى إطراء ونُمنَح مُكافأة مُجزية

48
00:04:10,690 --> 00:04:13,790
أنت موضِع ثِقة أكثر من أشران الّذي أعرفه

49
00:04:13,960 --> 00:04:15,850
ماذا يعني ذلك؟ أتمدحني؟

50
00:04:16,450 --> 00:04:17,820
أعتمد عليك

51
00:04:22,810 --> 00:04:27,080
إلى كافّة زملائي في جيش المُتمرّدين
التّابع لاتِّحاد أورزا المتجمّعين هنا

52
00:04:27,250 --> 00:04:29,990
أثني على ثِقتكم في التجمُّع في هذا المكان

53
00:04:30,780 --> 00:04:35,870
لا شكّ أنّ ولاءكم وشجاعتكم
هما أمل البشريّة

54
00:04:36,250 --> 00:04:38,770
،أنا متأكّدة أنّ بعضكم قد يكون قلقاً

55
00:04:38,940 --> 00:04:40,920
بسبب وقت التّحضير القصير لهذه العمليّة

56
00:04:41,390 --> 00:04:43,230
لكن أريدكم أن تتذكّروا

57
00:04:43,490 --> 00:04:46,140
كم سنة مضت ونحن نقاتل؟

58
00:04:46,760 --> 00:04:50,960
بالرُّجوع بالتّاريخ، نجد أنّنا قاومنا
حكم الشّياطين الأقوياء

59
00:04:51,130 --> 00:04:54,320
لمدّة زمنيّة أطول من أن نستطيع نتذكّرها

60
00:04:54,490 --> 00:04:56,900
هذا يُثبِت كم أنّ المدّة كانت طويلة

61
00:04:57,290 --> 00:05:02,230
كان كلّ ذلك تحضيراً لهذا اليوم

62
00:05:02,690 --> 00:05:07,150
حضّرنا روحنا وإرادتنا للقتال لزمن طويل

63
00:05:07,530 --> 00:05:09,540
حان الوقت لنُريهم

64
00:05:09,990 --> 00:05:11,380
!حان الوقت للهجوم المُضادّ

65
00:05:11,870 --> 00:05:15,180
!لنخرج من هذا السّرداب المُظلم يا جنود

66
00:05:17,080 --> 00:05:18,210
!هيّا بنا

67
00:05:30,760 --> 00:05:31,970
...هل هذا

68
00:05:32,490 --> 00:05:34,520
!القصر الحكوميّ؟

69
00:05:37,870 --> 00:05:39,100
!أيُّها البشر

70
00:05:41,650 --> 00:05:43,590
!توقّفوا

71
00:05:44,070 --> 00:05:45,940
أعرف هذا السّحر

72
00:05:48,690 --> 00:05:50,120
!أيّها الوغد

73
00:05:56,940 --> 00:05:57,940
!كاي، فوقك

74
00:06:07,490 --> 00:06:08,840
لنتخلّص منهم دُفعة واحدة

75
00:06:11,840 --> 00:06:13,270
!رصاصة السّهم

76
00:06:20,250 --> 00:06:21,480
هل كان ذلك أنت أيضاً؟

77
00:06:21,780 --> 00:06:25,730
أجل، إنّها رصاصة صُنِّعَتْ في عالمي
لمحاربة المجموعات

78
00:06:25,900 --> 00:06:28,940
لا أصدِّق ذلك. إنّها مُبهرة جدّاً

79
00:06:29,110 --> 00:06:30,200
هل يمكنك الشُّعور بها يا رينّي؟

80
00:06:30,370 --> 00:06:31,370
أجل

81
00:06:33,350 --> 00:06:34,350
!هناك

82
00:06:36,040 --> 00:06:38,840
جان، سأبحث عن فانيسّا

83
00:06:39,010 --> 00:06:40,950
مبدئيّاً، سأصعد لأعلى طابق
في النّاحية الشّماليّة

84
00:06:41,880 --> 00:06:44,270
سنُلفِت الأنظار كثيراً إذا استخدمنا
المصعد والدّرج الأوسط

85
00:06:44,440 --> 00:06:45,540
ماذا عن درج الطّوارئ؟

86
00:06:45,710 --> 00:06:48,600
الطّرف الشّمالي مُتقوِّض. يمكن
استخدام الطّرف الجنوبيّ

87
00:06:48,870 --> 00:06:49,960
هكذا إذاً

88
00:06:50,130 --> 00:06:51,410
،إذاً من الجنوب إلى الشّمال

89
00:06:51,580 --> 00:06:54,120
معنى هذا أنّه سيكون علينا
صعود عشرات الأدراج

90
00:06:54,680 --> 00:06:56,600
!سأوزّع مهام المجموعات

91
00:06:57,490 --> 00:07:00,690
المجموعة الأولى، لا تسمحوا لأيّ شيطان
!يدخل القصر الحكوميّ

92
00:07:01,110 --> 00:07:03,730
!المجموعة الثّانية، أنقذوا السُّجناء تحت الأرض

93
00:07:04,280 --> 00:07:07,190
بينما سنصعد نحن درج الطّوارئ
!في الطّرف الجنوبيّ

94
00:07:08,090 --> 00:07:12,170
ذلك الهجوم السّابق، إنّه عنيف جدّاً
رغم كونه هجوماً رعديّاً واسع النّطاق

95
00:07:12,340 --> 00:07:14,910
أجل، إنّها رصاصتي الفُضلى

96
00:07:15,380 --> 00:07:17,210
حتّى عندما لم تضغط الزّناد؟

97
00:07:18,130 --> 00:07:20,140
لا يمكن للرّصاصة أن تُطلَق
لو كان الأمر كذلك

98
00:07:21,060 --> 00:07:23,870
...شعرتُ بحضور غريب من البداية، لكن

99
00:07:24,040 --> 00:07:26,630
قال كاي بأنّه سيتحدّى فانيسّا
هو وإيّاها فقط

100
00:07:27,140 --> 00:07:28,960
لن تتراجع عن كلامك، صحيح؟

101
00:07:29,990 --> 00:07:30,990
لا

102
00:07:31,320 --> 00:07:32,380
لنسرع

103
00:07:33,030 --> 00:07:35,120
ينبغي أن تتجمّع الشّياطين قريباً

104
00:07:39,060 --> 00:07:40,350
!كاي، هناك

105
00:07:40,520 --> 00:07:41,770
!عفريت

106
00:07:41,940 --> 00:07:44,270
!يستدعي شيطاناً أكبر حجماً

107
00:07:47,840 --> 00:07:48,840
!إنّه قادم

108
00:08:00,910 --> 00:08:01,910
بطيء

109
00:08:07,550 --> 00:08:08,750
!بشر

110
00:08:09,220 --> 00:08:11,060
!جان-ساما، توجّه نحو القمّة

111
00:08:11,230 --> 00:08:12,300
!فالين

112
00:08:12,470 --> 00:08:13,640
إنّها مجرّد دُمية عديمة القيمة

113
00:08:13,810 --> 00:08:15,390
سأقضي عليها وألحق بكِ

114
00:08:15,900 --> 00:08:16,900
لا تقلقي

115
00:08:18,420 --> 00:08:19,420
سأنتظر في الأعلى

116
00:08:34,990 --> 00:08:36,410
سأدخل

117
00:08:38,420 --> 00:08:39,790
!هذا سحرٌ قويّ

118
00:08:42,830 --> 00:08:43,910
!جان؟

119
00:08:49,830 --> 00:08:52,380
لا حاجة للقلق عليّ

120
00:08:52,670 --> 00:08:55,510
!هذا السّحر... رِداء إيلفيّ؟

121
00:08:55,680 --> 00:08:59,320
بالضّبط. إنّها أداة سحريّة تُعرَف
،"باسم "رِداء الضّوء المُقدّس

122
00:08:59,490 --> 00:09:01,010
والّذي غنمناه من قرية إيلف

123
00:09:01,420 --> 00:09:03,980
،عندما يتعلّق الأمر بالمُقاومة السّحريّة
فلا شيء أفضل منه

124
00:09:05,010 --> 00:09:07,100
سنتولّى الأمور هنا

125
00:09:07,850 --> 00:09:08,910
يمكنكما أن تُتابعا التقدُّم

126
00:09:10,390 --> 00:09:13,440
هل كنتَ أنت من قال بأنّك
ستهزم فانيسّا يا كاي؟

127
00:09:13,890 --> 00:09:16,480
أجل، سأحرص على ذلك

128
00:09:22,570 --> 00:09:24,160
!والآن تعال أيُّها الشّيطان

129
00:09:24,680 --> 00:09:26,630
!فارس الضّوء المُقدّس سيُواجهك

130
00:09:30,580 --> 00:09:34,000
لن ترانا الشّياطين بهذا الشّيء، صحيح؟

131
00:09:34,170 --> 00:09:35,590
كيف يعمل ذلك؟

132
00:09:35,760 --> 00:09:37,670
—استخدمتُ سحرَ حاجز

133
00:09:37,840 --> 00:09:38,930
!رينّي

134
00:09:39,200 --> 00:09:43,240
أعني أنّ بشريّاً صنعه ليُحاكي
سحر حاجز ملاك

135
00:09:43,540 --> 00:09:47,130
هذا صحيح. إنّه يكسر الضّوء ويخبئك

136
00:09:47,300 --> 00:09:50,040
احرصا على البقاء قريبين منّي ومن رينّي

137
00:09:58,990 --> 00:10:00,520
صه

138
00:10:23,580 --> 00:10:25,270
أفلح ذلك، صحيح؟

139
00:10:25,440 --> 00:10:27,850
...قصّرَ ذلك من عمري

140
00:10:31,490 --> 00:10:33,120
أعتمد عليكما

141
00:10:33,290 --> 00:10:35,620
،أجل، إمّا أن تهزما فانيسّا

142
00:10:35,790 --> 00:10:40,160
أو نقطع القواطع لإطفاء الإنارة
كلّها عندما تبدو الأمور سيّئة

143
00:10:40,550 --> 00:10:43,760
أجل، سوف نهرب في الظُّلمة

144
00:10:45,850 --> 00:10:47,490
انتظرا أنتما هنا

145
00:10:47,660 --> 00:10:51,000
إذا بقيتُما صامتين، فلا أعتقد
أنّه سيقترب منكما أيّ شيطان

146
00:10:51,170 --> 00:10:52,830
حسناً، بالتّوفيق

147
00:10:53,000 --> 00:10:54,120
لا تضغطا على نفسيكما كثيراً

148
00:11:00,560 --> 00:11:01,590
!مُنبِّه؟

149
00:11:01,760 --> 00:11:02,770
!هل وجدونا؟

150
00:11:02,940 --> 00:11:05,470
!مستحيل، ينبغي أن ينجح حاجزنا

151
00:11:05,880 --> 00:11:07,630
كيف تمكّنوا من رؤيتنا؟

152
00:11:08,680 --> 00:11:11,020
هل يُعقَل أنّها كاشِفات الأشعّة
!تحت الحمراء في البناء؟

153
00:11:14,520 --> 00:11:18,780
أرى أنّ هؤلاء الأشياء البشريّة الّذين يُطلَق
عليهم بالآلات تُؤتي أُكُلها أحياناً

154
00:11:20,800 --> 00:11:22,610
ما هذين الجناحين؟

155
00:11:23,220 --> 00:11:26,360
يا له من مظهر قبيح وفوضويّ

156
00:11:27,400 --> 00:11:29,650
بما أنّك تحبّ الثّرثرة، فأجبني

157
00:11:29,820 --> 00:11:32,710
هل كنتَ أنت من ظلّ يصون نِظام المُراقبة؟

158
00:11:33,370 --> 00:11:35,590
كانت حكمة الإمبراطورة فانيسّا

159
00:11:36,030 --> 00:11:39,450
أنظمة المُراقبة البشريّة هذه مُذهلة

160
00:11:39,620 --> 00:11:41,550
"قالت، "لنستخدمها مهما كلّف الأمر

161
00:11:42,170 --> 00:11:44,760
إذا جعلنا عبداً يُديرها، فلا ينبغي
أن نواجه أي صعوبة

162
00:11:45,130 --> 00:11:49,090
كانت جلالتها مسرورة بهجومكم

163
00:11:49,260 --> 00:11:54,230
ينتابها فضول لتعرف لماذا انتهزتُم
هذه الفُرصة للإقدام على انتحار كهذا

164
00:11:54,740 --> 00:11:57,730
إذاً هل يمكنك أن تُرشدنا إلى فانيسّا؟

165
00:11:58,110 --> 00:12:01,030
ثمّة شيء مُسلٍّ أمامي

166
00:12:01,930 --> 00:12:04,320
فلِمَ عليّ أن أُفوِّته؟

167
00:12:04,490 --> 00:12:05,990
!حقّاً؟

168
00:12:07,410 --> 00:12:08,620
!رينّي؟

169
00:12:12,800 --> 00:12:13,840
!هيّا

170
00:12:17,250 --> 00:12:18,430
!رينّي؟

171
00:12:19,080 --> 00:12:20,120
لا تقلق

172
00:12:20,290 --> 00:12:21,550
اسبقني أنت يا كاي

173
00:12:21,720 --> 00:12:22,720
...لكن

174
00:12:23,210 --> 00:12:25,420
سألحق بك مباشرة

175
00:12:27,640 --> 00:12:29,510
حريّ بكِ أن تلحقي بي

176
00:12:29,680 --> 00:12:31,350
!هذا وعد

177
00:12:35,340 --> 00:12:37,770
أشتمّ ذلك. رائحة ملاك

178
00:12:37,940 --> 00:12:40,260
لكن أشتمّ رائحة شيطان كذلك؟

179
00:12:40,430 --> 00:12:43,710
ورائحة إيلف ورائحة قزم كذلك

180
00:12:43,880 --> 00:12:46,700
وتنّين أيضاً. وكذلك روح

181
00:12:47,300 --> 00:12:49,500
ما أنتِ بالضّبط؟

182
00:12:50,150 --> 00:12:53,410
حتّى أنا لا أعرف

183
00:12:56,300 --> 00:13:01,760
!كلّ ما أعرفه هو أنّني أكرهكم

184
00:13:02,630 --> 00:13:04,960
أريد البقاء مع كاي فحسب

185
00:13:05,130 --> 00:13:08,800
!إن كنت ستتدخّل، فلا أُبالي لما يحدث لكم

186
00:13:22,010 --> 00:13:24,570
أهلاً بك أيُّها البشريّ

187
00:13:25,770 --> 00:13:29,220
إمبراطورة الظّلام... فانيسّا

188
00:13:42,420 --> 00:13:44,260
!أيُّها البشريّ الصّاغر

189
00:13:48,840 --> 00:13:50,100
!ضعيف للغاية

190
00:13:51,560 --> 00:13:53,930
في نهاية المطاف، تبقى بشريّاً

191
00:13:59,980 --> 00:14:02,940
الدّرع؟ لا، تحته

192
00:14:03,310 --> 00:14:04,900
!رِداء إيلفيّ

193
00:14:05,660 --> 00:14:06,740
!شكل التّحرير

194
00:14:11,150 --> 00:14:12,450
،قوس القمر الطّويل

195
00:14:12,620 --> 00:14:13,620
!اخترِق

196
00:14:20,910 --> 00:14:24,420
أدوات إيلف وملاك سحريّة؟

197
00:14:24,870 --> 00:14:29,180
إذا استخدمها بشريٌّ غير قادر على استعمال
السّحر، فستستنزف حياته

198
00:14:30,040 --> 00:14:33,660
!أرى بأنّك اخترت الموت، يا للحماقة

199
00:14:36,120 --> 00:14:41,320
أتقول بأنّني اخترتُ الموت؟ هذا صحيح

200
00:14:41,490 --> 00:14:46,360
من دون تلك العزيمة، مُحال
!لبشريّ أن يهزم شيطاناً

201
00:14:46,780 --> 00:14:51,240
هذا لا يعني شيئاً. عند مُقارنة هذا
...بمُقاتلة بطلة الشّياطين

202
00:14:51,410 --> 00:14:52,490
!جان-ساما

203
00:15:01,780 --> 00:15:04,250
آسفة لو تأخّرتُ عليك يا مولايّ

204
00:15:04,590 --> 00:15:06,400
أخفتِني لوهلة

205
00:15:07,870 --> 00:15:09,510
سمعتُ بذلك

206
00:15:09,880 --> 00:15:15,720
بشريّ يُدعى "دراغونار" يُقاتل بناب دريك كسِلاح

207
00:15:16,240 --> 00:15:17,720
إنّه أنت، أليس كذلك؟

208
00:15:17,890 --> 00:15:18,890
من يدري؟

209
00:15:19,240 --> 00:15:21,370
،أتباعنا يصمدون جيّداً

210
00:15:21,540 --> 00:15:23,770
لكن هناك حدود للوقت الّذي
يمكنهم أن يُكسِبونا إيّاه

211
00:15:23,940 --> 00:15:25,860
يعتمد كلّ ذلك على الوضع
في الطّابق الأعلى

212
00:15:29,850 --> 00:15:31,710
لن ترمي سلاحك؟

213
00:15:31,880 --> 00:15:32,990
ماذا قلتِ؟

214
00:15:33,290 --> 00:15:38,480
يبدو من الصّعب على البشر أن يُصدِّقوا
بأنّ الشّيطان الأقوى هو سقوبة

215
00:15:38,650 --> 00:15:41,750
لا أمانع مُمارسة الحُبّ معك لتمضية الوقت

216
00:15:42,170 --> 00:15:43,240
رفض مُطلَق

217
00:15:43,410 --> 00:15:45,590
طبيعتك الحقيقيّة هي مسخ مُقاتل

218
00:15:49,010 --> 00:15:51,170
!أنت مُثير للاهتمام

219
00:15:51,340 --> 00:15:56,680
وأنا الّتي كنتُ أفكِّر في جعل مُجرّد
،بشريّ مثلك عبدي بسحر واحد

220
00:15:57,150 --> 00:15:59,910
لكن لم أكن أتوقّع ردّة الفعل هذه

221
00:16:00,180 --> 00:16:02,910
على ذكرِ الأمر، سمعتُ أنّ هناك قائداً

222
00:16:03,080 --> 00:16:06,580
يستخدم رِداء إيلفيّاً ضمن جيش
المُتمرّدين البشريّين

223
00:16:06,750 --> 00:16:07,910
أهذا أنت؟

224
00:16:08,080 --> 00:16:10,360
لا. أنا غريب

225
00:16:10,750 --> 00:16:13,510
أتيتُ من عالم يذكر التّاريخ فيه بأنّكِ مهزومة

226
00:16:15,030 --> 00:16:17,220
لسوء حظّك، لا وجود لمثل هذا العالم

227
00:16:17,390 --> 00:16:20,190
لا في الماضي ولا في المستقبل، للأبد

228
00:16:20,360 --> 00:16:22,710
،سواء صدّقتِ ذلك أم لم تُصدّقي

229
00:16:22,880 --> 00:16:25,710
أنا بشريّ ضلَّ طريقه إلى هذا
العالم من عالم آخر

230
00:16:26,280 --> 00:16:28,050
التّاريخ الّذي أتذكّره هو

231
00:16:28,220 --> 00:16:30,410
حيث ولّتْ حربُ الأعراق الخمسة
العظيمة منذ زمن بعيد

232
00:16:31,350 --> 00:16:34,580
إذاً، ما العرق الّذي هزمني؟

233
00:16:34,750 --> 00:16:35,750
البشر

234
00:16:36,830 --> 00:16:37,980
البشر؟

235
00:16:44,980 --> 00:16:50,960
،ليس المخلوقات الأسطوريّة، ولا السّماويّين
ولا الأرواح، إنّما البشر مَن انتصروا؟

236
00:16:51,130 --> 00:16:52,440
كم هذا مُضحك

237
00:16:52,610 --> 00:16:55,910
ومن كان الّذي هزمني بالضّبط؟

238
00:16:56,950 --> 00:16:58,410
النّبيّ شيد

239
00:16:59,650 --> 00:17:00,980
شيد

240
00:17:02,580 --> 00:17:03,740
شيد؟

241
00:17:04,180 --> 00:17:05,790
...سيف... البشر

242
00:17:06,230 --> 00:17:10,240
...شيد... مقبرة... حامل الشّيفرة... ختم

243
00:17:11,070 --> 00:17:12,380
...إعادة تجسيد العالم

244
00:17:13,090 --> 00:17:14,640
ماذا قلتِ للتو؟

245
00:17:14,950 --> 00:17:15,950
لا شيء

246
00:17:16,270 --> 00:17:19,680
أن يهدر شخصٌ مثلي وقته
...على أمور تافهة كهذه

247
00:17:20,220 --> 00:17:22,930
حسناً، كان ذلك مُسلّياً

248
00:17:26,060 --> 00:17:27,270
تحوّل إلى غُبار

249
00:17:29,310 --> 00:17:30,310
إبطال

250
00:17:31,230 --> 00:17:32,230
!ماذا؟

251
00:17:32,450 --> 00:17:34,520
!أنتِ تستخفّين بالبشر أيّتها الشّيطانة

252
00:17:36,800 --> 00:17:37,880
!وهم؟

253
00:17:38,050 --> 00:17:40,530
أهي المرّة الأولى الّتي ترى فيها
!تقنيّة وهم سقوبة؟

254
00:17:43,390 --> 00:17:46,540
هذه ردّة فعل جيّدة. وهذا السّلاح

255
00:17:47,000 --> 00:17:52,030
إنّه يُبطِل سحري ويُطلِق عنان هجوم
مُشابه لنفخة دريك

256
00:17:52,200 --> 00:17:54,740
لا بدّ أنّ هذا السّلاح من عالمك، صحيح؟

257
00:17:54,910 --> 00:17:56,460
هل أنتِ جاهزة لتصديقي الآن؟

258
00:17:56,630 --> 00:17:59,090
!لا تغترّ بنفسك أيُّها البشريّ الصّاغر

259
00:18:03,680 --> 00:18:04,760
غلوريا

260
00:18:04,930 --> 00:18:07,230
!فلتتطهّر بالنِّيران

261
00:18:17,100 --> 00:18:18,820
اللّعنة

262
00:18:18,990 --> 00:18:22,660
يبدو أنّني ركّزتُ كثيراً على اللّهب
لمنعه من تدمير القلعة

263
00:18:23,010 --> 00:18:24,730
والآن ما هي حركتك المُقبلة؟

264
00:18:24,900 --> 00:18:28,290
إنّها تقنيّة ناسِفة تستطيع تدمير أي عِرق

265
00:18:32,060 --> 00:18:34,750
غلوريا، نعيمك

266
00:18:35,010 --> 00:18:36,550
!فوضى الانفجار

267
00:18:40,790 --> 00:18:41,790
كاي

268
00:18:47,420 --> 00:18:49,480
هل كان ذلك من الأعلى؟

269
00:18:53,550 --> 00:18:57,400
لا وسيلة للإفلات من الموت
،من تلك الطّلقة

270
00:18:57,790 --> 00:19:00,710
إلّا إن كنت أحد أبطال الأعراق الأربعة

271
00:19:01,990 --> 00:19:05,260
ومع ذلك، كيف لا تزال حيّاً؟

272
00:19:07,370 --> 00:19:11,500
أُنقِذتُ بواسطة سيف شيد

273
00:19:11,880 --> 00:19:14,760
أيّها البشريّ، ما هذا السّيف؟

274
00:19:15,270 --> 00:19:16,420
لا أدري

275
00:19:16,800 --> 00:19:17,960
!كاي، تراجع

276
00:19:21,980 --> 00:19:23,950
...هذا الجرح

277
00:19:24,800 --> 00:19:27,670
أنا بخير. لكن ضغطتُ على نفسي قليلاً

278
00:19:27,840 --> 00:19:29,710
يسرّني أنّك حيّ

279
00:19:30,150 --> 00:19:32,550
لستِ بخير إذا كنتِ تضغطين على نفسكِ

280
00:19:32,720 --> 00:19:35,750
،اهتزّ البناء بقوّة قبل قليل

281
00:19:35,920 --> 00:19:38,550
وعندما ظننتُ أنّك قد مُتّ، أصابني الذُّعر

282
00:19:38,970 --> 00:19:40,270
!لذا لن أسامحك

283
00:19:40,440 --> 00:19:41,570
!تعالي إليّ يا فانيسّا

284
00:19:41,940 --> 00:19:43,920
!سوف أواجهكِ

285
00:19:44,800 --> 00:19:46,330
ما أنتِ؟

286
00:19:59,140 --> 00:20:03,220
أرصد تقلُّبات غير مُتوقَّعة من بطلة الشّياطين

287
00:20:03,630 --> 00:20:07,140
"تأثُّر من الكلمة المُحرَّمة "شيد

288
00:20:09,660 --> 00:20:12,920
البدء بالاستئصال بواسطة لاست رايزر

289
00:20:13,090 --> 00:20:14,440
!لماذا... أنت؟

290
00:20:14,760 --> 00:20:18,020
تأثير على العالم، إنزال الحكم

291
00:20:18,430 --> 00:20:21,630
...أنت... فهمت

292
00:20:21,800 --> 00:20:24,580
!فهمت الآن، لاست رايزر

293
00:20:24,750 --> 00:20:26,490
تنفيذ الشّيفرة صفر

294
00:20:27,350 --> 00:20:31,330
إزالة شيفرة البطلة فانيسّا عن العالم

295
00:20:34,710 --> 00:20:37,340
!غلوريا، سيكوينشيا

296
00:20:37,810 --> 00:20:41,340
!باركي بدمك وجسدك وروحك

297
00:20:42,460 --> 00:20:46,140
!لا تغترّي أيّتها القمامة

298
00:20:46,910 --> 00:20:50,100
مُقاومة مُعزَّزة من إمبراطورة الظّلام فانيسّا؟

299
00:20:50,440 --> 00:20:55,100
هل يظنُّ مجرّد كلب من كِلاب آلفريا
بأنّه قادر على النّيل منّي بكلِّ غرور؟

300
00:20:55,270 --> 00:21:00,150
...سحر غير مُتوقّع، إتمام الشّيفرة صفر بعد

301
00:21:01,770 --> 00:21:02,940
تناثري

302
00:21:14,410 --> 00:21:17,960
لم تموتي رغم ذلك؟ يا لكِ من كريهة

303
00:21:18,630 --> 00:21:21,610
...تأكيد ضرر يتجاوز حدود التحمُّل

304
00:21:27,950 --> 00:21:30,830
...هذه هي بطلة الشّياطين إذاً

305
00:21:32,010 --> 00:21:35,630
رينّي، كنتِ تقاتلين شخصاً مثلها؟

306
00:21:36,510 --> 00:21:37,650
لا

307
00:21:38,460 --> 00:21:39,580
أنا خائفة

308
00:21:40,180 --> 00:21:42,160
...كانت قوية دوماً، لكن

309
00:21:42,690 --> 00:21:47,110
فانيسّا من العالم السّابق لم تكن
!مُخيفة بهذا الشّكل

310
00:21:47,710 --> 00:21:49,650
ما هذا الجرح؟

311
00:21:49,820 --> 00:21:52,250
إنّه لا يُشفَى حتّى بعد تركيز سحري عليه

312
00:21:52,730 --> 00:21:53,730
أيّاً يكن

313
00:21:55,550 --> 00:22:00,650
والآن الأولويّة للقضاء على الضُّعفاء أمامي