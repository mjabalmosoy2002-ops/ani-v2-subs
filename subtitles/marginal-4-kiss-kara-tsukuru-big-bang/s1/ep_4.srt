1
00:00:57,700 --> 00:00:59,890
...إلى أميرات لاغ'جولييت

2
00:00:59,890 --> 00:01:01,260
!شكراً لحضوركن اليوم

3
00:01:01,260 --> 00:01:05,300
كنتن جمهوراً رائعاً للعرض الأخير من جولتنا

4
00:01:05,300 --> 00:01:07,250
!لنلتقِ مجدّداً يا أميرات

5
00:01:12,000 --> 00:01:14,220
!كان ذلك رائعاً للغاية

6
00:01:14,850 --> 00:01:15,550
أجل

7
00:01:16,060 --> 00:01:19,460
كيرا، شاي، أبليتُما حسناً في جولتكما العالميّة

8
00:01:19,460 --> 00:01:21,650
نهائي اللّيلة قد فاق توقُّعاتي أيضاً

9
00:01:21,650 --> 00:01:22,520
أليس كذلك؟

10
00:01:22,740 --> 00:01:28,120
يمكن قول نفس الكلام بالنسبة إلى تطوّركما كفنّانين

11
00:01:28,120 --> 00:01:30,860
بصِفتي مدير، أشعرُ ببركةٍ لا تُوصَف حقّاً

12
00:01:30,860 --> 00:01:33,100
ألا تبالغ قليلاً؟

13
00:01:33,100 --> 00:01:34,740
أجل، هذا مخيفٌ بعض الشيء

14
00:01:34,740 --> 00:01:36,530
في الواقع، تأكّد ذلك منذُ مدّة من الزمن

15
00:01:36,530 --> 00:01:39,450
خاصّة نظراً لعملكما المفرط في الأشهر الستّة الماضية

16
00:01:39,450 --> 00:01:41,740
،على ذكر ذلك

17
00:01:41,740 --> 00:01:44,160
يبدو أنّكما تستطيعان قضاء يوم كامل كإجازة
الأسبوع المقبل

18
00:01:44,160 --> 00:01:46,160
!حقّاً؟ متى؟

19
00:01:46,160 --> 00:01:47,200
السبت

20
00:01:47,200 --> 00:01:48,780
،فشِلَ تصوير الصّور المحفورة

21
00:01:48,780 --> 00:01:51,380
،وبينما فكّرتُ بالبحثِ عن شيء آخر

22
00:01:51,690 --> 00:01:54,560
اجتزتُما جولةً صعبةً بنجاحٍ باهر جدّاً

23
00:01:54,560 --> 00:01:56,860
!أحبُّك يا ساتشان

24
00:01:56,860 --> 00:01:59,140
حسناً، ينبغي أن ننتهز هذه الفرصة للمرح

25
00:01:59,470 --> 00:02:01,410
إلى أين تريد الذهاب يا شاي؟

26
00:02:01,410 --> 00:02:04,350
انتظر، لِمَ من المُقدَّر أن نخرج معاً دوماً؟

27
00:02:04,350 --> 00:02:06,530
على رسلِك، لا تكن كذلك

28
00:02:06,530 --> 00:02:09,410
لحظة. السّبت المقبل؟

29
00:02:09,410 --> 00:02:10,650
أليس هذا...؟

30
00:02:12,010 --> 00:02:14,900
!أعرف كيف سأقضي يوم إجازتي الآن

31
00:02:17,420 --> 00:02:22,580
!قبلة واحدة إلى أبعد أصقاع المجرّة

32
00:02:22,580 --> 00:02:24,750
!بكلّ سرور

33
00:03:56,000 --> 00:03:59,510
الحلقة 4

34
00:04:00,800 --> 00:04:01,630
مهرجان مايو؟

35
00:04:01,890 --> 00:04:02,660
أجل

36
00:04:02,660 --> 00:04:05,390
إنّه مهرجان ثقافي

37
00:04:05,690 --> 00:04:10,100
في مدرستنا، نفعلها دوماً في ثاني سبت من مايو

38
00:04:10,100 --> 00:04:11,930
هكذا إذاً. هذا منطقيّ

39
00:04:12,160 --> 00:04:15,260
لكن لماذا ظهر هذا الموضوع فجأة؟

40
00:04:15,260 --> 00:04:17,540
—جيّد أنّك سألت

41
00:04:17,540 --> 00:04:21,280
لا تقل لي أنّك تريد المشاركة
مع هذا النادي رجاء

42
00:04:22,130 --> 00:04:24,740
!يا صاح، لا أستطيع قول ذلك بعد الآن

43
00:04:24,740 --> 00:04:26,690
،لأنّنا نجوم

44
00:04:26,690 --> 00:04:29,570
ألن يسبّب القيام بشيء بشكلٍ جماعي
فوضى عارمة؟

45
00:04:29,570 --> 00:04:33,380
قد يكون هذا مزعجاً للمدرسة والناس
الذين يعيشون هنا

46
00:04:33,380 --> 00:04:36,210
لا أعتقد أنّنا بحاجةٍ للقلق بشأنِ ذلك

47
00:04:36,580 --> 00:04:38,610
،لدى مهرجان مايو تذاكر محدودة

48
00:04:38,610 --> 00:04:43,060
لذا لا يستطيع أحدٌ الحضور إلّا الأقرباء
أو الأصدقاء المقرّبين لتلاميذنا

49
00:04:43,060 --> 00:04:45,930
لا أعتقد أنّ هذا سيسبّبُ فوضى كبيرة

50
00:04:46,340 --> 00:04:50,520
لكن أعتقد أنّه من المحزن أن يكون
الحماس منخفضاً

51
00:04:50,520 --> 00:04:52,020
أرأيت؟ هل فهمت الآن؟

52
00:04:52,020 --> 00:04:56,770
هذا يعني أنّك أنت ونحن نستطيع
المُشاركة دون أدنى قلق

53
00:04:57,430 --> 00:05:00,450
وقد أسّسنا نادينا هذا العام

54
00:05:00,450 --> 00:05:01,890
،بعد كلّ هذا العناء

55
00:05:01,890 --> 00:05:05,220
ألن يكون من غير الجائز ألّا نشارك
في مهرجان مايو؟

56
00:05:05,220 --> 00:05:06,160
!لا! قطعاً لا

57
00:05:06,160 --> 00:05:09,360
رائع، أتوم-كن يتكلّم وكأنّه ذكيّ

58
00:05:09,360 --> 00:05:10,280
!كان ذلك سؤالاً بلاغيّاً

59
00:05:10,280 --> 00:05:12,620
تعلّمتُ ذلك في الصفّ البارحة

60
00:05:12,820 --> 00:05:15,280
حسناً، بفرض أنّنا شاركنا

61
00:05:15,280 --> 00:05:17,730
أتوم-كن، ماذا تريد أن تفعل؟

62
00:05:19,070 --> 00:05:20,410
أليس هذا واضحاً؟

63
00:05:20,410 --> 00:05:22,550
!يستلزم مهرجانٌ ثقافي وجود كشك طعام

64
00:05:22,550 --> 00:05:24,920
لكن ينبغي أن يقدّم أشياء مختلفة كثيرة

65
00:05:25,150 --> 00:05:27,750
لهذا علينا أن نتكاتف معاً

66
00:05:27,750 --> 00:05:29,510
فهو نادينا، صحيح؟

67
00:05:29,510 --> 00:05:34,770
لذا يا جماعة، جهِّزوا أطعمتكم المُرشَّحة
على وقتِ الغداء غداً

68
00:05:34,770 --> 00:05:35,830
مفهوم؟

69
00:05:37,920 --> 00:05:41,680
يبدو إذاً أنَّ المجموعة أ ستؤدّي مسرحيّة؟

70
00:05:41,680 --> 00:05:42,250
أجل

71
00:05:42,250 --> 00:05:44,280
ماذا سيفعلُ صفّنا يا ترى؟

72
00:05:44,280 --> 00:05:47,970
المهمّ الآن، هل فكّرتُم بالطعام الذي سنقدّمه
في كشكنا؟

73
00:05:47,970 --> 00:05:49,280
أنا فكّرت

74
00:05:49,280 --> 00:05:52,670
الخيار القديم سيكون شيئاً يعتمد
على الطحين، صحيح؟

75
00:05:52,670 --> 00:05:54,500
،لكن سيغدو ذلك مخيّباً للآمالِ قليلاً

76
00:05:54,500 --> 00:05:57,080
لذا ما رأيكم بشيء مُثير مثل ماريمو مشويّ؟

77
00:05:57,330 --> 00:05:58,560
!ماريمو؟

78
00:05:58,560 --> 00:06:00,960
هل تقترح حقّاً أن نشوي الماريمو الثّمينة خاصّتك؟

79
00:06:00,960 --> 00:06:03,600
قلتُ شيئاً يعتمد على الطحين، أليس كذلك؟

80
00:06:03,600 --> 00:06:07,580
نعِدُّ تاكوياكي ومن ثمّ نسكب كمّية كبيرة
من خبز أعشاب البحر الخضراء

81
00:06:07,580 --> 00:06:10,340
ستكون ظريفة مثل الماريمو ولذيذة

82
00:06:10,340 --> 00:06:13,570
لكن خبز الأعشاب هذا سيعلقُ بأسنانك
بشكلٍ مزعج

83
00:06:13,570 --> 00:06:15,050
هذا مروّع

84
00:06:15,050 --> 00:06:16,770
ماذا عنك إذاً يا أتوم-كن؟

85
00:06:17,030 --> 00:06:18,770
أليست الإجابة واضحة؟

86
00:06:19,020 --> 00:06:20,230
واضحة بالفعل

87
00:06:21,150 --> 00:06:22,360
أظنُّني أعلم أيضاً

88
00:06:22,360 --> 00:06:23,600
أجل

89
00:06:23,600 --> 00:06:24,480
!لنقلها معاً

90
00:06:24,800 --> 00:06:26,190
!مشاوي كوريّة

91
00:06:26,390 --> 00:06:28,340
!وليسَتْ أي مشاوي كوريّة عاديّة

92
00:06:28,340 --> 00:06:30,800
سنقدّمُ لحمَ العجل الياباني
الأسود ذا الدرجة أ-5

93
00:06:30,800 --> 00:06:31,530
معارض

94
00:06:32,620 --> 00:06:34,800
،مهما حاولنا جاهدين

95
00:06:34,800 --> 00:06:37,810
لن نستطيع تمويل شيء كهذا على مستوى
كشك يديره تلميذ

96
00:06:37,810 --> 00:06:40,160
،ناهيك عن فرن الغاز وشوّاية الصاج

97
00:06:40,160 --> 00:06:41,710
هذا غير معقول البتّة

98
00:06:42,000 --> 00:06:44,580
ماذا تريد أن تفعل إذاً يا روي؟

99
00:06:44,580 --> 00:06:47,840
فكّرتُ بالأمر ووجدتُ الخيار الأمثل هو الكريب

100
00:06:47,840 --> 00:06:49,150
،إذا قلّصنا من الزينة التي نقدّمها

101
00:06:49,150 --> 00:06:50,550
فأظنُّنا سنبلي بلاء حسناً

102
00:06:50,550 --> 00:06:53,260
أظنُّ أنّ هذا سيُلفِت أنظار الفتيات

103
00:06:53,560 --> 00:06:54,850
،إن كنّا لا نستطيع تقديم ماريمو مشويّ

104
00:06:54,850 --> 00:06:56,320
فأصوّت للكريب إذاً

105
00:06:56,320 --> 00:06:57,220
!ماذا؟

106
00:06:57,220 --> 00:06:59,180
!المشاوي الكوريّة أفضل بكثير

107
00:06:59,390 --> 00:07:01,030
ألا تعتقد ذلك أيضاً يا آر؟

108
00:07:01,030 --> 00:07:03,440
...في الواقع، يبدو هذا ممتعاً، لكن

109
00:07:03,440 --> 00:07:04,170
!أليس كذلك؟

110
00:07:04,170 --> 00:07:05,940
أرأيت؟ حصلنا على صوت آخر أيضاً

111
00:07:06,440 --> 00:07:08,100
هذا ليس عدلاً يا أتوم-كن

112
00:07:08,100 --> 00:07:10,540
من فضلك لا تجبر آر-كن على الاصطفافِ معك

113
00:07:10,540 --> 00:07:12,410
الكريب عمليّ

114
00:07:12,410 --> 00:07:14,680
!لكن هذا مملّ

115
00:07:14,680 --> 00:07:16,180
!حلم كبير! أقولُ كبيراً

116
00:07:16,180 --> 00:07:17,370
!لنقدّم المشاوي الكوريّة

117
00:07:18,000 --> 00:07:19,550
إنّه مهرجانٌ مدرسيّ

118
00:07:19,550 --> 00:07:21,250
هذا ليس مكاناً للمبالغة في الأمر

119
00:07:21,460 --> 00:07:23,450
وبالتالي، كريب

120
00:07:27,880 --> 00:07:29,690
حسناً، لا بأس

121
00:07:29,690 --> 00:07:32,190
الكلام بهذا الشكل لن ينجز شيئاً

122
00:07:32,190 --> 00:07:34,850
سيكون من الأسهل تحضيرها فحسب

123
00:07:34,850 --> 00:07:35,990
ألا توافقني؟

124
00:07:35,990 --> 00:07:36,970
هل أنتَ جادّ؟

125
00:07:36,970 --> 00:07:39,490
أنا جادٌّ دوماً

126
00:07:39,490 --> 00:07:41,380
لم تكن جادّاً أيضاً، أليس كذلك يا روي؟

127
00:07:42,470 --> 00:07:45,020
لا أملك خياراً، أقبل بتحدّيك

128
00:07:45,230 --> 00:07:47,620
معركة. يا لها من إثارة! يروقني هذا

129
00:07:47,620 --> 00:07:50,090
أل، ترى هذا ممتعاً، أليس كذلك؟

130
00:07:50,090 --> 00:07:52,310
أجل، إنّه ممتع

131
00:07:54,380 --> 00:07:57,320
حسناً، بدأ المرح يزداد

132
00:07:57,320 --> 00:07:58,290
أتوم-كن

133
00:07:59,910 --> 00:08:02,140
،ربّما أسيئ الحكم عليك

134
00:08:02,140 --> 00:08:06,000
لكن أشعر أنّك أكثر انفعالاً من المعتاد

135
00:08:07,370 --> 00:08:08,710
في الواقع، أجل

136
00:08:09,940 --> 00:08:11,370
ماذا؟ عمداً؟

137
00:08:11,370 --> 00:08:13,450
،ربّما. حتّى بالنسبة إلى أتوم-كن

138
00:08:13,450 --> 00:08:15,550
ذلك النوع من التحدّيات لم يكن اعتياديّاً

139
00:08:15,550 --> 00:08:18,000
قبلتَ لأنّك كنتَ تعلم إذاً؟

140
00:08:18,000 --> 00:08:20,800
...أجل. لأنّني أعتقد أنَّ أتوم-كن كان

141
00:08:20,800 --> 00:08:24,450
،أعني روي انتقلَ وما إلى هنالك

142
00:08:24,450 --> 00:08:25,680
،لكن عندما تتعلّق الأمور بالمدرسة

143
00:08:25,680 --> 00:08:26,610
فإنّه دائماً ما يتحفّظ

144
00:08:27,220 --> 00:08:30,940
لكن أريده أن يستمتع

145
00:08:32,240 --> 00:08:33,300
روي-كن؟

146
00:08:33,300 --> 00:08:34,490
!لا شيء

147
00:08:34,990 --> 00:08:37,670
لا شيء على الإطلاق

148
00:08:39,040 --> 00:08:42,560
،إذا قلتُ ذلك صراحة

149
00:08:42,560 --> 00:08:45,120
سأبدو كشخصٍ مغرور

150
00:08:42,560 --> 00:08:45,120
أعني "أنا متأكّدٌ أنّه فعلها لأجلي"؟

151
00:08:45,360 --> 00:08:50,720
عرفتُ أنّه سيجد سهولةً أكبر في الانخراط
في الأمر إذا حرّضتُه

152
00:08:50,720 --> 00:08:53,280
،تبّاً، عندما أكشف عنها بهذا الشكل

153
00:08:53,280 --> 00:08:54,550
!يصبح الأمر محرجاً

154
00:08:54,550 --> 00:08:56,140
!أتوم-كن

155
00:08:56,140 --> 00:08:58,860
لم أكن أعلم أنّك كنتَ تفكّر
بمارجينال 4 إلى هذا الحدّ

156
00:08:58,860 --> 00:09:00,100
عليّ أن أتمالك نفسي

157
00:09:00,570 --> 00:09:03,020
!فأنا القائد

158
00:09:03,550 --> 00:09:04,850
لكن أتعلم يا آر؟

159
00:09:04,850 --> 00:09:06,370
،رغم أنّني قلتُ أنّ ذلك لأجله

160
00:09:06,370 --> 00:09:07,730
...بما أنّني تحدّيتُه

161
00:09:07,730 --> 00:09:10,480
رغم علمي بأنّه كان يحرّضني فحسب
...بما أنّني قبِلت

162
00:09:10,480 --> 00:09:11,900
...فأنا لن

163
00:09:12,420 --> 00:09:13,570
!أتوم-كن

164
00:09:12,420 --> 00:09:15,280
!أخسر أمامه أبداً

165
00:09:16,160 --> 00:09:19,210
سأقدّم كلّ ما لديّ لأفوز

166
00:09:21,310 --> 00:09:22,910
...هذا ما قلتُه، لكن

167
00:09:26,650 --> 00:09:27,830
ما الأمر يا روي؟

168
00:09:28,960 --> 00:09:30,310
ماكيشيما-سان

169
00:09:31,920 --> 00:09:33,840
هكذا إذاً، منافسة مع أتوم

170
00:09:34,150 --> 00:09:36,700
نعم، حدثَ ذلك بالصدفة

171
00:09:36,700 --> 00:09:40,920
أنا متفاجئ قليلاً من اتّخاذك نشاط مدرسيّ
على محمل الجدّ

172
00:09:40,920 --> 00:09:42,720
،كان أتوم-كن جادّاً جدّاً حيال الأمر

173
00:09:42,720 --> 00:09:45,090
شعرتُ وكأنّه كان لزاماً عليّ
أن أستجيب له بلطف

174
00:09:45,090 --> 00:09:46,210
هذا غريب، أليس كذلك؟

175
00:09:46,210 --> 00:09:48,400
لا، أظنُّه أمراً جيّداً

176
00:09:48,860 --> 00:09:50,480
أوتظنّ ذلك؟

177
00:09:50,730 --> 00:09:54,740
وجدتها. إذا كان الكريب بسيطاً جدّاً
فما رأيك بهذا؟

178
00:10:00,030 --> 00:10:02,850
أعلم أنّ المشاوي الكوريّة ليسَتْ شيئاً منطقيّاً

179
00:10:02,850 --> 00:10:03,910
...لكن

180
00:10:03,910 --> 00:10:06,870
أنت تبالغ يا أتوم

181
00:10:06,870 --> 00:10:08,010
أتفكّر بشيء ما؟

182
00:10:08,010 --> 00:10:10,960
نادراً ما أراك بهذه الجدّية

183
00:10:10,960 --> 00:10:17,000
أجل، روي محقٌّ عندما قال أنّ المشاوي
الكوريّة ليست منطقيّة

184
00:10:17,000 --> 00:10:19,640
لكن لن أستسلم لسببٍ كهذا

185
00:10:20,470 --> 00:10:22,830
أعني أنا من أطلقَ التحدّي

186
00:10:22,830 --> 00:10:25,350
قل "كيرا-ساما رهيب" عشر مرّات

187
00:10:25,350 --> 00:10:25,720
!ماذا؟

188
00:10:25,720 --> 00:10:28,440
حينئذ سأعطيك فكرة سديدة

189
00:10:30,660 --> 00:10:32,810
—أحم. حسناً إذاً، حبّذا لو

190
00:10:32,810 --> 00:10:35,570
!انظر! فلتشهد المشاوي الكوريّة خاصّتي

191
00:10:36,930 --> 00:10:38,030
...هذا

192
00:10:38,030 --> 00:10:39,300
ما رأيك؟

193
00:10:39,300 --> 00:10:41,760
بهذه، يمكننا حتّى استخدام لحم عجل
أسود ياباني درجة أ-5

194
00:10:41,760 --> 00:10:44,280
!الحفاظ على سعرِها المناسب للتلاميذ

195
00:10:44,610 --> 00:10:46,040
!حسناً، جرّبوها حالاً

196
00:10:49,380 --> 00:10:49,870
!لذيذة

197
00:10:50,160 --> 00:10:52,410
!إنّها طريّة جدّاً وتكاد تذوب في فمي

198
00:10:52,410 --> 00:10:54,780
ومع الخضار، تصبح متّزنة أيضاً

199
00:10:54,780 --> 00:10:57,350
أليس كذلك؟ حُسمَ الأمر إذاً، صحيح؟

200
00:10:57,850 --> 00:11:01,300
لننتظر إلى أن تأكلوا طبقي

201
00:11:02,060 --> 00:11:04,100
ماذا؟ هذا مجرّد كريب عادي

202
00:11:04,100 --> 00:11:05,890
—لا، هذا

203
00:11:05,890 --> 00:11:07,970
أليست هذه... غاليتّي؟

204
00:11:08,230 --> 00:11:09,780
غي... غيلاتو؟

205
00:11:09,780 --> 00:11:12,690
يُصنَع الغاليتّي بدقيق الحنطة السّوداء
بدلاً من دقيق القمح

206
00:11:12,690 --> 00:11:17,610
وبسبب ذلك، يكون مُشبِعاً أكثر وبالتالي
يؤكَل كطبق رئيسي أكثر منه كحلوى

207
00:11:18,650 --> 00:11:22,100
،هذا لذيذ! إنّه مُبهرَج للغاية

208
00:11:22,100 --> 00:11:24,640
لذا أظنُّه سيُعجِب الفتيات أكثر من الكريب

209
00:11:24,640 --> 00:11:26,910
لكنّه جوهريّ

210
00:11:27,450 --> 00:11:29,830
أعتقد أنّ الشباب سيحبّونه أيضاً

211
00:11:30,420 --> 00:11:31,120
ما رأيك؟

212
00:11:32,270 --> 00:11:33,000
جيّد...

213
00:11:33,500 --> 00:11:35,130
لم أفهم ذلك جيّداً

214
00:11:35,130 --> 00:11:35,500
—هلّا كرّرتَ كـ

215
00:11:35,500 --> 00:11:37,880
!جيّد! جيّد حقّاً

216
00:11:37,880 --> 00:11:39,010
شكراً لك

217
00:11:39,290 --> 00:11:42,630
لكن طبقك كان جيّداً جدّاً كذلك يا أتوم-كن

218
00:11:44,340 --> 00:11:46,740
نعم، كلاهما كانا جيّدين

219
00:11:46,740 --> 00:11:50,060
فكيف نقرّر ماذا نختار إذاً؟

220
00:11:50,370 --> 00:11:52,280
!انتظرا أنتما

221
00:11:52,870 --> 00:11:54,230
ما رأيكم بهذا؟

222
00:11:54,230 --> 00:11:57,060
غاليتّي لحم عجل أسود ياباني درجة أ-5
مشوي على الطريقة الكوريّة

223
00:11:57,060 --> 00:11:57,860
!ابدأوا بالطعام

224
00:11:58,400 --> 00:11:59,110
!هكذا إذاً

225
00:11:59,110 --> 00:12:00,360
فكرة سديدة

226
00:12:02,420 --> 00:12:04,480
هذا لذيذٌ جدّاً يا آر

227
00:12:04,480 --> 00:12:06,330
!حتّى أنا لا أعترض على ذلك

228
00:12:06,330 --> 00:12:08,020
يمكننا الاعتماد على قائدنا

229
00:12:08,450 --> 00:12:09,660
حسناً، حُسِمَ الأمر إذاً

230
00:12:10,120 --> 00:12:13,370
والآن كلّ ما علينا فعله هو أن نرى
ما إن ربحنا في اليانصيب

231
00:12:13,620 --> 00:12:15,610
ما قصّة اليانصيب هذه؟

232
00:12:15,610 --> 00:12:16,980
عمّاذا تتكلّم؟

233
00:12:16,980 --> 00:12:19,340
،نظراً لوجود الكثير من النوادي في مدرستنا

234
00:12:19,340 --> 00:12:22,270
سيحظى نصفهم تقريباً فقط بفرصة
نصب كشك في المهرجان

235
00:12:22,270 --> 00:12:22,750
هذا كُلّ شيء

236
00:12:22,750 --> 00:12:24,160
اليانصيب هو لهذا الغرض إذاً؟

237
00:12:24,160 --> 00:12:24,720
أجل

238
00:12:24,720 --> 00:12:25,890
أعتمدُ عليك يا قائد

239
00:12:26,170 --> 00:12:27,540
!أنا متأكّدٌ أنّك تستطيع فعلها

240
00:12:27,540 --> 00:12:28,970
سأذهب أنا؟

241
00:12:28,970 --> 00:12:30,100
!بالطبع

242
00:12:30,100 --> 00:12:31,350
!حظّاً سعيداً يا قائد

243
00:12:31,350 --> 00:12:32,180
أعتمد عليك

244
00:12:32,530 --> 00:12:35,680
!يا قائد

245
00:12:36,640 --> 00:12:38,480
حـ-حسناً

246
00:12:38,480 --> 00:12:40,580
سأفعل ما بوسعي

247
00:12:55,490 --> 00:12:58,340
لقد حان الوقتُ أخيراً

248
00:13:00,630 --> 00:13:02,510
تهتمُّ بأمور غريبة حقّاً

249
00:13:02,510 --> 00:13:04,340
أعني أتريد الاعتناء بالكوهاي في يوم إجازتك؟

250
00:13:04,340 --> 00:13:06,640
لكن انظر من أتى معي على أي حال

251
00:13:08,170 --> 00:13:10,100
هذا لأنّك ظللتَ تزعجني

252
00:13:10,530 --> 00:13:11,770
أيّاً يكن

253
00:13:11,770 --> 00:13:13,770
وصلنا إلى هنا وانتهى الأمر

254
00:13:15,070 --> 00:13:16,770
!لنتمتّع باللحظة

255
00:13:20,270 --> 00:13:21,780
حسناً

256
00:13:21,780 --> 00:13:23,940
!حسناً! لنذهب

257
00:13:31,540 --> 00:13:33,860
من أين نبدأ؟

258
00:13:33,860 --> 00:13:37,330
أعتقد بشيء كلاسيكي ما مثل كشك الياكيسوبا

259
00:13:37,650 --> 00:13:40,170
!لكن لا يمكنني نسيان كشك السجق

260
00:13:40,680 --> 00:13:42,000
أهذه لعبة رمي الحلقة؟

261
00:13:42,370 --> 00:13:45,200
شاي، من أين ستبدأ؟

262
00:13:45,200 --> 00:13:46,180
شكراً لك

263
00:13:46,430 --> 00:13:47,930
!اشتريتَ شيئاً بهذه السرعة؟

264
00:13:48,340 --> 00:13:50,920
بما أنّني وصلتُ إلى هنا، سأستمتعُ بنفسي

265
00:13:53,250 --> 00:13:55,390
!معك حقّ! هكذا أريدك

266
00:13:59,510 --> 00:14:01,650
ها أنا ذا. حان وقتُ اختبار مهاراتي

267
00:14:02,900 --> 00:14:06,280
صرتُ مهتمّاً بألعاب منظور الشّخص الأول
عبر الشّبكة مؤخّراً

268
00:14:06,280 --> 00:14:09,240
أعرف كلّ خدع الرّماية

269
00:14:12,310 --> 00:14:13,240
أخفقت

270
00:14:15,000 --> 00:14:17,210
!تبّاً، بقيت طلقة واحدة

271
00:14:19,960 --> 00:14:21,130
!كيرا؟

272
00:14:21,130 --> 00:14:23,590
صه! اليوم إجازتنا

273
00:14:23,950 --> 00:14:25,670
لذا من فضلك

274
00:14:27,890 --> 00:14:28,880
!حسناً

275
00:14:30,860 --> 00:14:32,390
!طلقة أخرى

276
00:14:32,770 --> 00:14:35,850
كان ذلك سهلاً جدّاً بالنسبة إليّ

277
00:14:36,290 --> 00:14:39,080
ربّما سيكون أرخص لو اشتريتَه مباشرة

278
00:14:39,080 --> 00:14:40,590
لا يهمّني

279
00:14:40,590 --> 00:14:43,380
على أي حال، ماذا عن كشك مارجينال 4؟

280
00:14:43,380 --> 00:14:44,740
ألم تسمع؟

281
00:14:45,490 --> 00:14:48,740
خسِروا في اليانصيب ولم يستطيعوا
نصب كشك لناديهم

282
00:14:48,740 --> 00:14:50,110
!ماذا قلت؟

283
00:14:50,690 --> 00:14:54,010
بدلاً من ذلك، يفعلون بعض الأمور
كلٌّ في صفِّه الذي ينتمي إليه

284
00:14:54,010 --> 00:14:55,700
ما رأيك أن نتفقّدهم؟

285
00:14:55,700 --> 00:14:56,870
ماذا يفعلون؟

286
00:14:57,170 --> 00:14:58,570
...أعتقد

287
00:15:00,420 --> 00:15:02,510
صفّ روي يؤدّي مسرحيّة

288
00:15:02,510 --> 00:15:04,460
العرض لن يجري إلّا بعد فترة

289
00:15:04,920 --> 00:15:06,760
...وصفّ الآخرين هو

290
00:15:07,170 --> 00:15:08,760
!أهلاً

291
00:15:09,440 --> 00:15:12,220
،مقهانا لا يقدِّم ملابس تنكُّرية فحسب

292
00:15:12,490 --> 00:15:14,540
لكن يحظى ضيوفنا أيضاً بفرصة

293
00:15:14,540 --> 00:15:17,930
ارتداء لِباس يروقهم لالتقاطِ صورة تذكاريّة

294
00:15:18,400 --> 00:15:20,520
ما هو طلبكما؟

295
00:15:21,010 --> 00:15:22,360
!يبدو هذا لذيذاً

296
00:15:22,360 --> 00:15:23,480
!لي أيضاً

297
00:15:23,990 --> 00:15:26,020
غاليتّي مشويّة على الطريقة الكوريّة لو سمحتم

298
00:15:26,360 --> 00:15:27,230
!حالاً

299
00:15:27,810 --> 00:15:28,870
!تلقّينا طلباً آخر

300
00:15:30,280 --> 00:15:33,220
يسرُّني أنّ الطبق مشهور جدّاً

301
00:15:33,220 --> 00:15:36,740
نعم، لكن من المؤسف ألّا نستطيع بيع
هذه مع نادينا

302
00:15:36,740 --> 00:15:38,080
أنا آسف

303
00:15:38,080 --> 00:15:39,830
!تبّاً، كفّ عن الاعتذار

304
00:15:40,110 --> 00:15:43,330
!لا داعي للقلق. فكافّة الضيوف يتمتّعون بطعامنا هنا

305
00:15:44,720 --> 00:15:48,820
لكن في الأصل، كانت الغاليتّي فكرة روي-كن

306
00:15:49,920 --> 00:15:52,500
تريدون أن تبيعوا الغاليتّي في مقهى
الملابس التنكُّرية الخاص بالمجموعة ب؟

307
00:15:52,500 --> 00:15:57,070
أجل، أراد الصفّ أن يفعل شيئاً
آخر إلى جانب الكعك الإسفنجي

308
00:15:57,070 --> 00:16:01,020
سيكون عدم بيعها وهي لذيذة هدراً حقيقيّاً

309
00:16:01,350 --> 00:16:03,350
...لهذا كنّا نقول، إن لم يكن لديك مانع

310
00:16:03,480 --> 00:16:06,700
...سيكون من الأفضل إذا ربحتُ اليانصيب، لكن

311
00:16:08,380 --> 00:16:12,030
لا بأس بالطبع

312
00:16:13,780 --> 00:16:15,200
لا داعي للقلق حيال الأمر

313
00:16:15,410 --> 00:16:18,210
،إن فعلنا ما بوسعنا في تحضيرِ هذه الغاليتّي

314
00:16:18,210 --> 00:16:20,230
فأنا متأكّدٌ أنّ روي-كن سيكون سعيداً أيضاً

315
00:16:20,630 --> 00:16:22,660
أتظنُّ ذلك؟

316
00:16:22,970 --> 00:16:24,500
!أجل، معك حقّ

317
00:16:24,790 --> 00:16:26,040
!نعم

318
00:16:26,580 --> 00:16:27,750
!اثنتان غاليتّي هنا

319
00:16:27,750 --> 00:16:31,170
!لدينا حشدٌ كبير

320
00:16:32,100 --> 00:16:33,050
معك حقّ

321
00:16:33,050 --> 00:16:35,390
لا بدَّ وأنّ الناس يتحدّثون عن مدى
لذّة هذه

322
00:16:38,180 --> 00:16:39,040
!وسيم للغاية

323
00:16:39,040 --> 00:16:39,850
...رائع جدّاً

324
00:16:40,650 --> 00:16:44,050
ماذا تودِّين أن تطلبي يا آنسة؟

325
00:16:45,190 --> 00:16:46,730
اطلبن أي شيء رجاء

326
00:16:46,980 --> 00:16:49,400
فأنا خادمكم في النّهاية

327
00:16:49,890 --> 00:16:52,570
!لحظة... انظرا

328
00:16:52,570 --> 00:16:53,700
...أليس هذا

329
00:16:54,350 --> 00:16:55,780
مستحيل

330
00:16:56,030 --> 00:16:57,240
!مغنِّيا لاغرانغ بوينت؟

331
00:16:57,500 --> 00:16:59,080
هلّا أحضرتم مزيداً من الغاليتّي؟

332
00:16:59,260 --> 00:17:00,910
المزيد من الكعك الإسفنجي إلى هنا

333
00:17:00,910 --> 00:17:02,370
!بكلّ سرور

334
00:17:02,370 --> 00:17:03,290
!كلّا

335
00:17:03,290 --> 00:17:05,000
!ماذا تفعلان؟

336
00:17:05,000 --> 00:17:07,620
أعتقد أنُّكم كنتُم ستعرفوننا

337
00:17:07,620 --> 00:17:08,590
!سنعرفكما بالطبع

338
00:17:09,020 --> 00:17:11,500
!والمؤكّد أنَّ الجميع قد عرفوكما أيضاً

339
00:17:11,500 --> 00:17:12,370
...كيرا

340
00:17:12,370 --> 00:17:13,550
هذا شاي-ساما، صحيح؟

341
00:17:13,550 --> 00:17:16,890
إضافة إلى ذلك، لماذا يساعد الاثنان صفَّنا؟

342
00:17:17,210 --> 00:17:20,410
لأنّ الجميع قد بدوا مشغولين

343
00:17:20,410 --> 00:17:24,230
عندما سألنا، قالوا أنّهم يقبلون بالمساعدة

344
00:17:24,610 --> 00:17:28,400
أعتقد أنَّ صفّنا سيستفيد من أي شخص
لم يهرب

345
00:17:28,400 --> 00:17:32,610
إذاً التذاكر التي طلبها تشان-سان
منّي كانت لكما؟

346
00:17:32,940 --> 00:17:34,070
تماماً

347
00:17:34,070 --> 00:17:37,070
أنتم! ضيوفنا ينتظرون

348
00:17:38,060 --> 00:17:39,030
المعذرة رجاء

349
00:17:39,370 --> 00:17:41,500
أسرعوا في الطلب

350
00:17:43,550 --> 00:17:47,000
أتوم-كن، أتينا. حان وقتُ التبديل

351
00:17:47,310 --> 00:17:48,460
!حسناً

352
00:17:48,930 --> 00:17:50,170
مناوبة؟

353
00:17:50,830 --> 00:17:51,930
...إذاً

354
00:17:58,690 --> 00:18:01,890
ما هي طلباتكن؟

355
00:18:09,450 --> 00:18:13,530
يوصي الطبّاخ بالغاليتّي اليوم يا آنسة

356
00:18:17,820 --> 00:18:19,090
!صرير الغاليتّي

357
00:18:19,090 --> 00:18:20,850
!ظريف

358
00:18:23,140 --> 00:18:24,580
كان ذلك مضحكاً للغاية

359
00:18:24,880 --> 00:18:26,500
يبدو أنَّ الضيوف قد استمتعوا بذلك أيضاً

360
00:18:26,500 --> 00:18:27,730
كانت الزيارة مُستحَقَّة

361
00:18:27,730 --> 00:18:30,210
لماذا لم تخبرانا أنّكما ستأتيان؟

362
00:18:30,450 --> 00:18:34,610
بالفعل يا شاي-كن وكيرا-كن، فاجأتمانا تماماً

363
00:18:34,610 --> 00:18:35,690
نحن آسفان

364
00:18:35,690 --> 00:18:38,890
أردنا أن نرى كيف تتصرّفون
كتلاميذ فحسب

365
00:18:38,890 --> 00:18:42,420
أجل، يبدو أنّهم لا يُعاملونكم أي معاملة
غريبة خاصّة

366
00:18:42,420 --> 00:18:44,100
ويبدو أنّ صفّكم ممتع للغاية

367
00:18:44,620 --> 00:18:46,970
هذا... أجل

368
00:18:47,480 --> 00:18:50,200
أظنُّنا محظوظين جدّاً بصفِّنا

369
00:18:50,200 --> 00:18:50,810
نعم، ربّما

370
00:18:51,130 --> 00:18:53,790
وماذا ستفعلان الآن؟

371
00:18:54,430 --> 00:18:58,610
تذكّرت، ألم يكن صفّ روي سيؤدّي
مسرحيّته في مثل هذا الوقت؟

372
00:18:58,610 --> 00:19:01,070
!حسناً، لنذهب ونحضره الآن

373
00:19:01,610 --> 00:19:05,620
حسناً، كنّا ذاهبين لحضورِ مسرحيّة
روي على أي حال

374
00:19:05,620 --> 00:19:07,690
لكن أليس اليوم هو يوم إجازتكما؟

375
00:19:07,690 --> 00:19:10,370
أليس من الهدرِ قضاء الإجازة على مهرجان
مدرسي قديم بسيط؟

376
00:19:11,290 --> 00:19:12,760
هذا ما يُعجبنا فيه

377
00:19:12,760 --> 00:19:13,290
أجل

378
00:19:14,390 --> 00:19:16,460
بالمناسبة، ما الذي يؤدّونه؟

379
00:19:16,460 --> 00:19:17,920
روميو وجولييت

380
00:19:18,240 --> 00:19:19,460
كلاسيك

381
00:19:20,300 --> 00:19:22,430
لحظة، أليسَتْ هذه مدرسة للذكور؟

382
00:19:22,670 --> 00:19:23,270
أجل

383
00:19:23,270 --> 00:19:25,380
...إذاً روميو وجولييت

384
00:19:25,380 --> 00:19:29,980
في الواقع، يؤدّون مسرحيّات شكسبير التي أُدِّيَتْ
بواسطة رجال فقط

385
00:19:29,980 --> 00:19:31,740
هل هذا يعني جولييت أيضاً؟

386
00:19:31,740 --> 00:19:32,810
أجل، هذا ما يعنيه

387
00:19:35,330 --> 00:19:37,240
سيشارك روي في المسرحيّة، صحيح؟

388
00:19:37,240 --> 00:19:37,980
من هو؟

389
00:19:37,980 --> 00:19:38,850
روميو

390
00:19:38,850 --> 00:19:41,830
هو؟! لا أصدِّق ذلك

391
00:19:42,850 --> 00:19:45,580
الردّ بلطف؟

392
00:19:46,490 --> 00:19:47,990
لا شيء

393
00:19:49,430 --> 00:19:50,870
...على ذكرِ

394
00:19:53,090 --> 00:19:54,380
!روي

395
00:19:54,900 --> 00:19:58,050
أتوم-كن! ماكيشيما-سان وهيمورو-سان؟

396
00:19:58,050 --> 00:19:58,590
!مرحباً

397
00:19:58,980 --> 00:20:01,970
كنّا في الطريقِ لرؤية مسرحيّتك

398
00:20:02,260 --> 00:20:04,660
هكذا إذاً

399
00:20:05,220 --> 00:20:07,970
شكراً لاستقطاعكم من وقتِكم الثّمين لحضورِها

400
00:20:09,000 --> 00:20:09,720
...لكن

401
00:20:10,530 --> 00:20:12,660
ما الأمر؟ هل حدث شيء؟

402
00:20:13,400 --> 00:20:14,190
...في الواقع

403
00:20:15,130 --> 00:20:16,650
تضرّرت المعدَّات؟

404
00:20:17,230 --> 00:20:19,610
حدثَتْ مُشكلة أثناء النقل

405
00:20:19,970 --> 00:20:21,820
!سنُساهم في الإصلاحات إذاً

406
00:20:24,030 --> 00:20:27,530
شكراً لكم، لكن الوقت لا يُسعفنا

407
00:20:31,590 --> 00:20:32,450
لِمَ التأخير؟

408
00:20:32,450 --> 00:20:33,440
حان وقتُها

409
00:20:33,440 --> 00:20:35,170
أتريدين الذهاب إلى مكانٍ ما بما أنّها لم تبدأ؟

410
00:20:37,970 --> 00:20:40,210
في هذه الحالة، ستكون هُنالك ثغرة في الأداء

411
00:20:40,800 --> 00:20:42,670
ليس باليدِ حيلة، وقعَتْ حادِثة

412
00:20:42,670 --> 00:20:46,680
كلّ ما علينا فعله هو أن نبلغ الضيوف
أنَّ عليهم الانتظار

413
00:20:46,680 --> 00:20:48,340
كم سيستغرق التأجيل؟

414
00:20:48,340 --> 00:20:49,560
ما هو الوقت المُقدَّر المُستغرَق للإصلاح؟

415
00:20:49,830 --> 00:20:51,380
...نصف ساعة

416
00:20:52,030 --> 00:20:54,170
لا، أمهلنا عشرين دقيقة

417
00:20:54,170 --> 00:20:54,640
حسناً

418
00:20:58,410 --> 00:21:00,610
سنملئ العشرين دقيقة

419
00:21:02,170 --> 00:21:03,190
لا يمكنكما فعل ذلك

420
00:21:03,490 --> 00:21:05,320
هذا شأن مدرستنا

421
00:21:05,320 --> 00:21:06,350
ساتسكي

422
00:21:06,350 --> 00:21:08,320
البيانات بحوزتك، صحيح؟

423
00:21:08,320 --> 00:21:09,450
اعتنِ بنظام مكبّرات الصوت

424
00:21:09,890 --> 00:21:10,730
!شان-سان؟

425
00:21:10,730 --> 00:21:13,080
تبّاً، يتكلّم بفوقيّة

426
00:21:13,400 --> 00:21:15,270
!حسناً. لنفعل هذا يا شاي

427
00:21:15,270 --> 00:21:15,670
نعم

428
00:21:15,670 --> 00:21:17,860
...انتظروا رجاء، هذا ليس

429
00:21:17,860 --> 00:21:20,800
لا مشكلة، دعنا نتمتّع أكثر فحسب

430
00:21:21,690 --> 00:21:25,660
كنتُ أنا وكيرا مشغولين كثيراً
بالعمل في المدرسةِ الثانويّة

431
00:21:25,660 --> 00:21:29,720
لم نحظَ بفرصة المشاركة بمهرجانات
ثقافيّة وما شابه

432
00:21:29,720 --> 00:21:31,260
،لسنا نادمين على ذلك

433
00:21:31,530 --> 00:21:32,880
لكن أنا متأكّدٌ أنّ هنالك تجارب

434
00:21:32,880 --> 00:21:34,500
لن تمرّوا بها إلّا في مدرسةٍ ثانويّة

435
00:21:34,500 --> 00:21:36,730
وتجارب لن تمرّوا بها إلّا الآن

436
00:21:37,020 --> 00:21:41,080
لهذا نريدكم أن تستمتعوا بها قدر المستطاع

437
00:21:41,080 --> 00:21:42,940
بحياة المدرسة الثانويّة

438
00:21:46,210 --> 00:21:47,360
نحن جاهزون

439
00:21:47,600 --> 00:21:49,070
تمتّعوا بالحاضر

440
00:21:49,480 --> 00:21:51,720
!سنفعل المثل

441
00:22:59,970 --> 00:23:01,440
يسرُّني أنّها نجحَتْ

442
00:23:01,670 --> 00:23:07,610
!كم هما رائعان

443
00:23:07,610 --> 00:23:09,720
...أجل، لكن

444
00:23:10,640 --> 00:23:12,570
!سنبلغُ مستواهما يوماً ما

445
00:23:12,900 --> 00:23:13,410
بالفعل

446
00:23:15,240 --> 00:23:16,320
!سنبدأ

447
00:23:16,320 --> 00:23:18,540
!حسناً يا روميو-ساما! أسرع

448
00:23:21,410 --> 00:23:25,130
وهكذا أداء لاغرانغ بوينت الفدائيّ

449
00:23:25,710 --> 00:23:28,840
والأداء المضحك السّخيف التالي
روميو وجولييت

450
00:23:29,220 --> 00:23:35,630
أصبحا "معجزة مهرجان مايو" الأسطوريّة
التي دُوِّنَتْ في سجلّات تاريخ مدرستنا

451
00:23:36,920 --> 00:23:40,390
:الحلقة القادمة
"أوهام ماضية عن مادّة مظلمة"

452
00:23:37,390 --> 00:23:41,060
الحلقة القادمة