1
00:00:03,310 --> 00:00:06,400
يا إلهي، انتهت استراحة الصّيف بسرعة

2
00:00:06,400 --> 00:00:10,720
تِلك الدُّفعة الأخيرة من الواجبات المدرسيّة
ظلّت تستنزف طاقتي

3
00:00:10,720 --> 00:00:12,820
لدرجة لا أستطيع فيها التّعافي

4
00:00:13,750 --> 00:00:16,240
المشكلة تكمن في أنّك لم تواظب
على كتابة وظائفك كلّ يوم

5
00:00:16,240 --> 00:00:19,190
هذا لأنّك لم تكن تساعدنا

6
00:00:19,190 --> 00:00:21,400
كتابة الوظيفة هي شيء ينبغي أن تفعله بمفردك

7
00:00:21,400 --> 00:00:24,020
روي-كن، أنت صارم جدّاً، صارم بشكل هائل

8
00:00:27,810 --> 00:00:28,910
تسوباسا-كن؟

9
00:00:31,410 --> 00:00:32,810
!ما الخطب؟

10
00:00:32,810 --> 00:00:35,420
كنتُ أحاول الدخول بطريقةٍ رهيبة من النافذة

11
00:00:35,420 --> 00:00:37,310
!فلماذا هو مقفل؟

12
00:00:37,310 --> 00:00:39,850
ادخل من الباب بشكلٍ طبيعي من فضلك

13
00:00:41,250 --> 00:00:43,230
أين ألتو-كن وتيروما-كن؟

14
00:00:43,230 --> 00:00:47,090
تذكّرت، بما أنّنا كنّا مشغولين كثيراً في المخيّم

15
00:00:47,090 --> 00:00:49,700
لم ينهيا وظيفتهما المدرسيّة واضطرّا أن يبقيا

16
00:00:52,640 --> 00:00:54,600
المهمّ الآن، أين أتوم؟

17
00:00:54,600 --> 00:00:55,940
...إنّ أتوم-كن

18
00:00:55,940 --> 00:00:57,800
سيبقى حتّى وقت متأخّر أيضاً لأنّه لم ينهِ وظيفته؟

19
00:00:57,800 --> 00:01:01,160
لا، ظلّ مستيقظاً ثلاثة أيّام متتالية وتمكّن
من إنهائها دُفعة واحدة

20
00:01:01,760 --> 00:01:03,700
وأين هو الآن؟

21
00:01:03,700 --> 00:01:09,560
غادر المدرسة قبلنا لأنّه ثمّة شيء
اجتماع يودّ حضوره

22
00:01:10,840 --> 00:01:11,920
توقّعتُ هذا

23
00:01:12,150 --> 00:01:14,000
ما الذي توقّعته؟

24
00:01:14,000 --> 00:01:16,990
أنا واثقٌ أنّه سيناقش مسألة عقده

25
00:01:16,990 --> 00:01:18,490
أي عقد؟

26
00:01:20,450 --> 00:01:21,890
هوليود

27
00:01:25,140 --> 00:01:27,100
عمّاذا تتكلّم؟

28
00:01:27,490 --> 00:01:33,170
سمعتُ بالصدفة رئيستنا تتكلّم أمام المكتب

29
00:01:33,580 --> 00:01:37,490
أتوم قد تلقّى عرضاً من هوليود

30
00:01:38,720 --> 00:01:41,350
!ما-ماذا؟

31
00:01:44,080 --> 00:01:49,250
!قبلة واحدة لأبعد أصقاع المجرّة

32
00:01:49,250 --> 00:01:51,340
!بكلّ سرور

33
00:03:23,030 --> 00:03:26,470
الحلقة 11

34
00:03:47,630 --> 00:03:52,230
أكبر الأعمال الفنّية والخيال العلمي الشّهير
مسلسل غالاكسي ساموراي من هوليود

35
00:03:52,230 --> 00:03:54,960
وسيشارك أتوم-كن في الموسم الجديد؟

36
00:03:54,960 --> 00:03:57,920
يُزعَم أنّه سيكون شخصيّة جديدة، قرصان فضائي

37
00:03:58,210 --> 00:04:02,420
أعجِبَ المُنتِج بتمثيله الممتاز في برنامج المتحرّي

38
00:04:02,420 --> 00:04:04,810
لم أسمع بشيء كهذا

39
00:04:04,810 --> 00:04:06,890
لم يقل أتوم-كن أي كلمة

40
00:04:06,890 --> 00:04:10,710
إن حدث هذا فسيلتزم بعقد مدّته عام

41
00:04:10,710 --> 00:04:12,850
حينئذ لن يتمكّن من فعل شيء مع مارجينال 4

42
00:04:12,850 --> 00:04:17,020
معنى هذا باعتقادي أنّه حتّى أتوم
لا يستطيع الحديث عن ذلك

43
00:04:17,400 --> 00:04:18,830
يا للهول

44
00:04:19,540 --> 00:04:20,590
على أي حال

45
00:04:20,590 --> 00:04:24,430
إذا أراد أن يغادر مارجينال 4 فذلك سيكون
غير مُحبَّذ بالنسبة لي بصِفتي منافسه

46
00:04:24,430 --> 00:04:25,730
أخبروا أتوم

47
00:04:25,730 --> 00:04:28,620
إن أراد الاستقالة فليفعل ذلك بعدما
يحسم النتيجة معي

48
00:04:34,230 --> 00:04:35,650
أتساءل ما إن كان هذا صحيحاً

49
00:04:35,650 --> 00:04:37,820
ربّما تسوباسا-كن لم يسمع الكلام جيّداً؟

50
00:04:37,820 --> 00:04:39,550
أنا متأكّدٌ أنّه أخطأ السمع فحسب

51
00:04:39,550 --> 00:04:42,050
لكن كيف للمرءِ أن يسيئ سمع كلام واضح كهذا

52
00:04:42,870 --> 00:04:48,310
"على سبيل المثال، بدلاً من "عرض هوليود
يجب أن تكون "عرض خشبي مقدّس"؟

53
00:04:48,310 --> 00:04:49,830
ولماذا خشب مقدّس؟

54
00:04:49,830 --> 00:04:51,210
لأنّه مبجّل

55
00:04:51,210 --> 00:04:52,850
أعتقد أنّ الجملة طويلة

56
00:04:53,090 --> 00:04:56,880
إذاً "هوريموتو-سان يمشي في الأرض"؟

57
00:04:56,880 --> 00:04:59,160
"الشيء الوحيد الملائم هنا ولو على نحو مبهم هو "هوري

58
00:04:59,160 --> 00:05:02,380
ماذا؟ "أرض" قريبة من "عرض" أيضاً

59
00:05:02,380 --> 00:05:04,400
من هوريموتو-سان على أي حال؟

60
00:05:04,400 --> 00:05:06,510
إنّه جارنا

61
00:05:06,510 --> 00:05:08,040
لنكن جادّين هنا

62
00:05:08,040 --> 00:05:10,830
ألن يكون من الأفضل أن نسأل مديرتنا؟

63
00:05:11,200 --> 00:05:12,280
معك حقّ

64
00:05:16,880 --> 00:05:19,040
يبدو أنّ هذا صحيح

65
00:05:19,040 --> 00:05:21,400
وصلَ عرض بالفعل

66
00:05:21,850 --> 00:05:24,280
،أعتقد أنّ أتوم-كن محطّم كذلك

67
00:05:24,280 --> 00:05:28,080
لذا أبقوا هذا سرّاً من فضلكم ريثما يصنع قراره

68
00:05:28,850 --> 00:05:32,240
لا أصدّق أنّهم كتموا هذا السرّ عنّا أيضاً

69
00:05:33,620 --> 00:05:34,990
ليس باليد حيلة

70
00:05:35,510 --> 00:05:39,520
أنا متأكّدٌ أنّ مديرتنا لم ترغب أن تثير قلقنا بلا ضرورة

71
00:05:39,520 --> 00:05:42,360
سيكون أتوم-كن نجم هوليود؟

72
00:05:42,360 --> 00:05:44,280
وسيكون مسرحه فارغاً

73
00:05:44,280 --> 00:05:47,760
قد يوصل قبلة إلى أبعد أصقاع المجرّة فعلاً

74
00:05:47,760 --> 00:05:49,970
حتّى لو فعل، سيكون ذلك في فيلم

75
00:05:55,350 --> 00:05:58,420
جلسة تصوير لكتيّب مهرجان الانفجار الكبير
تبدأ الآن

76
00:05:58,420 --> 00:06:02,690
لا، ليست الآن، بل على وشك أن تبدأ

77
00:06:02,690 --> 00:06:03,710
ما هي الكلمة إذاً؟

78
00:06:04,030 --> 00:06:05,610
صباح الخير

79
00:06:05,610 --> 00:06:07,850
!تأخّرتم يا شباب

80
00:06:07,850 --> 00:06:09,050
...أتوم-كن

81
00:06:09,050 --> 00:06:10,700
اذهبوا واستعدّوا

82
00:06:10,700 --> 00:06:12,950
!كنتُ أنتظركم منذ فترة طويلة

83
00:06:12,950 --> 00:06:14,970
بـ-بالتأكيد

84
00:06:14,970 --> 00:06:17,180
!ابتسموا من فضلكم

85
00:06:20,340 --> 00:06:23,650
عظيم. بعد هذا سنجري المقابلة

86
00:06:28,040 --> 00:06:30,060
أنا مُنهَك

87
00:06:34,540 --> 00:06:36,100
!أتوم-كن

88
00:06:36,870 --> 00:06:38,480
ما هذا الوجه العابس؟

89
00:06:38,480 --> 00:06:42,420
انتشرت تغريدتي بشكلٍ واسع

90
00:06:42,420 --> 00:06:46,800
أعتقد أنّ عناقيد النجوم متحمّسون لمهرجان
الانفجار الكبير

91
00:06:47,180 --> 00:06:48,610
حسناً يا أتوم-كن

92
00:06:49,160 --> 00:06:52,100
أخبرنا تسوباسا-كن بهذا

93
00:06:52,100 --> 00:06:56,810
في الواقع، صدفَ وأن سمع رئيستنا تتكلّم

94
00:06:57,370 --> 00:06:59,400
...لذا

95
00:06:59,400 --> 00:07:01,740
تبّاً يا أر، ادخل صلب الموضوع

96
00:07:01,740 --> 00:07:02,830
!سأسأله

97
00:07:02,830 --> 00:07:05,730
أتوم-كن، هل قرّرتَ ما عليك فعله
بشأن عرض هوليود؟

98
00:07:07,090 --> 00:07:08,370
أتوم-كن؟

99
00:07:11,930 --> 00:07:13,070
!إنّه نائم

100
00:07:14,320 --> 00:07:15,960
لا عجب

101
00:07:15,960 --> 00:07:19,020
فقد ظلّ مستيقظاً لثلاثة أيّام بسبب الوظيفة المدرسيّة

102
00:07:22,190 --> 00:07:27,350
دعونا لا نقول له شيئاً وننتظره
حتّى يبادر هو بالكلام

103
00:07:29,140 --> 00:07:33,300
لحظة، لم توصلوا رسالتي إليه؟

104
00:07:33,300 --> 00:07:35,640
لماذا أنتم هنا على أي حال؟

105
00:07:35,640 --> 00:07:36,940
مرحباً

106
00:07:36,940 --> 00:07:39,140
لا يقبل تسوباسا-كن بـ"لا" كإجابة

107
00:07:43,310 --> 00:07:44,720
حسناً، فهمت

108
00:07:44,720 --> 00:07:47,820
سأذهب وأخبره بشكل مباشر بنفسي

109
00:07:47,820 --> 00:07:50,410
تسوباسا-كن، انتظر قليلاً

110
00:07:50,410 --> 00:07:52,150
لا، لا أستطيع الانتظار فترة أطول

111
00:07:52,150 --> 00:07:53,450
...سأذهب وأخبره بشكلٍ مُباشَر

112
00:07:53,450 --> 00:07:54,950
!لا تذهب

113
00:07:59,570 --> 00:08:00,820
روي-كن

114
00:08:04,110 --> 00:08:05,960
ما-ماذا؟

115
00:08:05,960 --> 00:08:09,310
لا يحقّ لك إيقاف أتوم-كن

116
00:08:09,310 --> 00:08:11,550
أوقفوه أنتم إذاً

117
00:08:11,550 --> 00:08:14,430
وبالطبع لا نملك الحقّ لإيقافه أيضاً

118
00:08:14,960 --> 00:08:17,390
الشّخص الذي عليه أن يتّخذ القرار هو أتوم-كن

119
00:08:20,820 --> 00:08:22,370
-بيت القصيد ليس هنا

120
00:08:22,370 --> 00:08:24,470
!آسف لتأخّري

121
00:08:24,470 --> 00:08:26,940
اجتماع مجلس الصحّة لم ينتهِ إلى الآن

122
00:08:27,650 --> 00:08:30,390
ماذا؟ ماذا تفعلون أنتم هنا؟

123
00:08:30,390 --> 00:08:32,100
...في الواقع، نحن

124
00:08:32,100 --> 00:08:33,820
أتينا للتنزُّه قليلاً فحسب

125
00:08:34,540 --> 00:08:36,460
سنغادر الآن

126
00:08:36,460 --> 00:08:37,680
هيّا بنا

127
00:08:40,530 --> 00:08:42,370
ما خطبهم؟

128
00:08:51,500 --> 00:08:55,620
هل من السّهل إلى هذا الحدّ أن تصبح
نجماً في هوليود؟

129
00:08:56,720 --> 00:08:59,250
أنا متأكّد أنّ أتوم-كن يستطيع فعلها

130
00:08:59,780 --> 00:09:01,930
أظنُّه يرغب في أن يعمل بمفرده على أي حال

131
00:09:02,810 --> 00:09:06,150
!لكن لا يروقني هذا

132
00:09:06,660 --> 00:09:09,770
لا يروقني أن يغادر أتوم-كن مارجينال 4

133
00:09:10,140 --> 00:09:12,440
حتّى لو كان هذا ما يريده

134
00:09:14,070 --> 00:09:15,600
ينتابني نفس الإحساس

135
00:09:28,740 --> 00:09:32,620
سبقَ وقلتُ لك لا يحقُّ لك أن تمنعه

136
00:09:32,620 --> 00:09:37,760
أعلم. عليه إذاً أن يتوقّف عن ذلك بنفسه، صحيح؟

137
00:09:40,460 --> 00:09:42,790
لديّ خطّة جيّدة

138
00:09:42,790 --> 00:09:44,610
أنتم بحاجة للمساعدة

139
00:09:44,610 --> 00:09:45,980
ما هي الخطّة؟

140
00:09:46,930 --> 00:09:48,480
ألّفتُ حواراً

141
00:09:48,480 --> 00:09:51,860
عندما يأتي أتوم، تصرّفوا بناء على هذا فحسب

142
00:09:52,200 --> 00:09:55,900
تبّاً، يوم آخر يستغرق فيه اجتماع
مجلس الصحّة وقتاً طويلاً

143
00:09:56,630 --> 00:09:58,160
آسف لتأخّري

144
00:09:59,240 --> 00:10:05,830
رحتُ إلى صيدليّة البارحة فرأيتُ
دبّاً يتسوّق

145
00:10:05,950 --> 00:10:07,660
!إنّه زوجتي

146
00:10:07,910 --> 00:10:10,960
انتظر لحظة. ألديك زوجة؟

147
00:10:11,210 --> 00:10:12,340
لا، لا

148
00:10:12,460 --> 00:10:14,590
هذه نكتة أمريكيّة قديمة

149
00:10:17,770 --> 00:10:19,470
ماذا تفعلون؟

150
00:10:20,090 --> 00:10:21,090
!أتوم

151
00:10:21,720 --> 00:10:27,730
نلعب لعبة وهي عدم التكلّم باليابانيّة بل الإنجليزيّة فقط

152
00:10:28,190 --> 00:10:32,980
نريد قضاء جولة عالميّة مثل لاغ بو، صحيح؟

153
00:10:34,410 --> 00:10:39,040
حالما يسمعنا أتوم نتكلّم بهذا الشكل
فسيرى أنّه لا يستطيع حتّى أن يفهم كلامنا

154
00:10:39,040 --> 00:10:42,430
وهكذا سيستسلم ولن يذهب
إلى هوليود. خطّة مثاليّة

155
00:10:43,580 --> 00:10:45,160
لكن لحظة يا أتوم

156
00:10:45,160 --> 00:10:47,220
أيّهما تفضّل؟

157
00:10:47,220 --> 00:10:49,970
لحم العجل الأمريكي أم الياباني؟

158
00:10:50,630 --> 00:10:51,900
هذا هراء حقيقيّ

159
00:10:52,400 --> 00:10:54,270
لا أستطيع متابعة هذا فترة أطول

160
00:10:54,270 --> 00:10:55,500
المعذرة

161
00:10:55,500 --> 00:10:57,010
!انتظر يا روي-كن

162
00:10:59,190 --> 00:11:03,050
بالمناسبة، لا أمانع أن آكل لحم
عجل أمريكي أو ياباني

163
00:11:03,050 --> 00:11:03,930
!ماذا؟

164
00:11:07,390 --> 00:11:10,020
لذا أستطيع السفر إلى أي مكانٍ في العالم

165
00:11:10,590 --> 00:11:14,270
لكن لم أكن أعلم بأنّ روي ليس جيّداً
بالإنجليزيّة أيضاً

166
00:11:23,900 --> 00:11:27,190
لا بأس، المشكلة لا تكمن هنا

167
00:11:27,190 --> 00:11:29,200
...إذاً ماريمو هي

168
00:11:29,200 --> 00:11:30,330
طحلب كروي

169
00:11:30,330 --> 00:11:32,330
!وفقاً للتطبيق

170
00:11:36,070 --> 00:11:38,200
روي-كن، ماذا كانت تلك الرّسالة؟

171
00:11:38,200 --> 00:11:39,470
لا شيء

172
00:11:44,790 --> 00:11:48,920
...أتوم-كن لم يخبرنا بشيء في نهاية المطاف

173
00:11:49,860 --> 00:11:51,020
ما الأمر يا أر؟

174
00:11:51,570 --> 00:11:53,940
رأيتُ رسالة الكترونيّة على كمبيوتر روي-كن

175
00:11:54,500 --> 00:11:59,650
لم أقرأ محتواها لكن كانت من وكالة استكشاف الفضاء

176
00:11:59,650 --> 00:12:03,360
وكالة استكشاف الفضاء؟

177
00:12:03,360 --> 00:12:06,410
ربّما استُلهم روي-كن بواسطة أتوم-كن

178
00:12:07,360 --> 00:12:11,210
ويفكّر بترك مارجينال 4 أيضاً

179
00:12:11,210 --> 00:12:12,160
!ماذا؟

180
00:12:12,810 --> 00:12:17,540
أعني أنّ روي-كن أصبح نجماً بسببِ أخته

181
00:12:18,330 --> 00:12:24,090
لكن رؤية أتوم-كن يطارد حلمه وهو
أن يصبح نجماً في هوليود جعلَه ربّما

182
00:12:24,090 --> 00:12:27,050
يفكّر بالعملِ الذي يستطيع فيه ممارسة
الرّياضيات التي يعشقها

183
00:12:30,160 --> 00:12:33,740
والتي هي وكالة استكشاف الفضاء

184
00:13:01,670 --> 00:13:03,420
ما الأمر يا تسوباسا-كن؟

185
00:13:03,800 --> 00:13:06,930
كانت قد خطرت على بالي فكرة جيّدة لمنع
أتوم من الذهاب إلى هوليود

186
00:13:07,160 --> 00:13:11,810
مجدّداً؟ تسوباسا-كن، أنت تهتمُّ حقّاً بأتوم-كن

187
00:13:12,620 --> 00:13:16,710
!لـ-لا! أقولُ هذا بصفتي منافسه فحسب

188
00:13:16,710 --> 00:13:17,770
حقّاً؟

189
00:13:17,770 --> 00:13:20,060
!استمع لفكرتي فحسب

190
00:13:20,060 --> 00:13:22,360
ما رأيك أن تهدّئ من روعك يا تسوباسا-كن؟

191
00:13:22,360 --> 00:13:23,240
روي-كن

192
00:13:24,480 --> 00:13:26,430
لا تدعني أكرّر كلامي

193
00:13:27,320 --> 00:13:29,030
على أتوم-كن اتّخاذ ذلك القرار

194
00:13:29,620 --> 00:13:31,910
لن أدع أحداً يعترض طريقه

195
00:13:35,620 --> 00:13:37,400
أنا جاهز

196
00:13:37,400 --> 00:13:38,840
!انتظر

197
00:13:38,840 --> 00:13:40,370
أر، أل

198
00:13:40,370 --> 00:13:41,800
ما الأمر يا أتوم-كن؟

199
00:13:41,800 --> 00:13:43,380
لنذهب إلى غرفةِ نادينا

200
00:13:43,380 --> 00:13:46,630
في الحقيقة، ثمّة شيء عليّ فعله
لذا سأذهب إلى المنزلِ اليوم

201
00:13:47,540 --> 00:13:48,600
شيء عليك فعله؟

202
00:13:49,450 --> 00:13:52,190
ثمّة محادثة هامّة عليّ إجرائها

203
00:13:52,710 --> 00:13:55,310
بخصوص العمل؟

204
00:13:55,760 --> 00:13:58,280
يمكنك القول أنّها بخصوص العمل

205
00:13:59,020 --> 00:14:02,070
أظنُّها لها علاقة بحلمنا

206
00:14:02,910 --> 00:14:04,530
ما هي؟

207
00:14:04,530 --> 00:14:06,330
لا أستطيع أن أخبركم بعد

208
00:14:07,110 --> 00:14:08,780
عندما ينتهي كلّ شيء، سأخبركم بها

209
00:14:08,780 --> 00:14:09,490
!إلى اللِّقاء

210
00:14:44,780 --> 00:14:47,780
إلى أي طابق ذهب أتوم-كن يا ترى؟

211
00:14:52,510 --> 00:14:53,690
!هناك! انظر يا أل

212
00:14:53,690 --> 00:14:54,540
الطابق 23

213
00:14:56,740 --> 00:14:59,100
لايت ستار وركس؟

214
00:15:23,460 --> 00:15:26,030
لا أريد أن أخضع لتجربة كتلك ثانية

215
00:15:32,360 --> 00:15:36,950
ذهبَ ليقدّم إجابته فيما إن كان سيقبل
بالعرض أم لا أخيراً إذاً؟

216
00:15:36,950 --> 00:15:39,700
هل سيغادر مارجينال 4 فعلاً؟

217
00:15:47,950 --> 00:15:49,050
!إنّها منه

218
00:15:51,120 --> 00:15:52,090
ما محتواها؟

219
00:15:52,950 --> 00:15:56,260
"ثمّة شيء أودُّ الاعتذار منكم بشأنه"

220
00:16:00,010 --> 00:16:04,730
إنّه أمر سرّي، لذا هلّا أتيتم إلى غرفتي رجاء؟

221
00:16:26,320 --> 00:16:28,630
أليس هذا طريقاً أطول؟

222
00:16:29,080 --> 00:16:35,220
أعني حالما نصل إلى غرفة أتوم-كن
ستنتهي مارجينال 4

223
00:16:35,930 --> 00:16:40,640
أعتقد أنّ هذا ما قصده عندما قال
أنَّ عليه الاعتذار

224
00:16:43,170 --> 00:16:44,020
...لكن

225
00:16:46,340 --> 00:16:51,150
إن كان هذا هو القرار الذي اتّخذه
أتوم-كن، فبِصفتي القائد

226
00:16:52,060 --> 00:16:55,110
عليّ توديعه بابتسامة

227
00:16:59,400 --> 00:17:02,040
لا أعرف ماذا ينبغي أن أفعل

228
00:17:02,440 --> 00:17:03,330
روي-كن

229
00:17:03,840 --> 00:17:06,880
إن كان هذا ما يريده أتوم-كن

230
00:17:08,130 --> 00:17:10,630
إن كان هذا ما سيجعل حلمه يتحقّق

231
00:17:11,120 --> 00:17:13,590
إن كان هذا يضمن سعادته

232
00:17:14,420 --> 00:17:16,450
فأتفهّمه بكلّ عقلانيّة

233
00:17:17,050 --> 00:17:21,330
لكن لا أستطيع قبوله فحسب أيضاً

234
00:17:21,330 --> 00:17:22,990
هذا لا يروقني

235
00:17:22,990 --> 00:17:25,100
لا يروقني أن يغادر أتوم-كن مارجينال 4

236
00:17:25,510 --> 00:17:28,950
ظننتُ أنّنا أصبحنا مقرّبين أخيراً

237
00:17:28,950 --> 00:17:31,380
ظننتُ أنَّ بمقدورنا أن نتوحّد

238
00:17:31,380 --> 00:17:34,470
ظننتُ أنّ نحن الأربعة بمقدورنا أن نتألّق كجسد واحد

239
00:17:34,470 --> 00:17:37,240
!لكن بدلاً من ذلك، نتفرّق من جديد؟

240
00:17:40,280 --> 00:17:43,250
كنتُ قد تقدّمتُ إلى هذا

241
00:17:44,740 --> 00:17:47,770
كي أجعل ما تحدّث عنه أتوم-كن حقيقة

242
00:17:47,770 --> 00:17:50,460
إيصال تلك القبلة إلى أبعد أصقاع المجرّة

243
00:17:50,900 --> 00:17:51,920
وما هو هذا؟

244
00:17:52,700 --> 00:17:55,560
إنّه مشروع يستطيع العامّة من خلاله

245
00:17:55,560 --> 00:17:57,960
أن يتقدّموا لترك رسالة على الصّاروخ

246
00:17:57,960 --> 00:18:00,610
الذي ستطلقه وكالة استكشاف الفضاء

247
00:18:00,610 --> 00:18:03,270
من جزيرة تانيغا الشّهر المقبل

248
00:18:04,230 --> 00:18:06,430
تقدّمتُ له

249
00:18:06,940 --> 00:18:11,770
ارتأيت أنّ بمقدورنا إرسال أسطوانة
تحتوي على أحلامنا كفرقة مارجينال 4 إلى هناك

250
00:18:12,800 --> 00:18:18,360
وبهذا الشكل نستطيع أن نوصل قبلة
إلى أبعد أصقاع المجرّة

251
00:18:18,760 --> 00:18:21,850
هذه ليست فكرة ملائمة لروي-كن

252
00:18:22,260 --> 00:18:26,330
بل هي أقرب إلى فكرة من أفكار أتوم-كن

253
00:18:26,760 --> 00:18:27,830
بالفعل

254
00:18:27,830 --> 00:18:32,310
بطبيعتي المعتادة مُحال أن أفكّر
بفعل شيء سخيف كهذا

255
00:18:33,820 --> 00:18:37,760
أعتقد أنّ هذا يعني بأنّ أتوم-كن
قد أفسدني كثيراً أيضاً

256
00:18:39,520 --> 00:18:40,390
...لكن

257
00:18:41,450 --> 00:18:46,370
الآن بعدما بات حلمنا بإيصال قبلة
إلى أبعد أصقاع المجرّة

258
00:18:46,920 --> 00:18:51,740
على وشك أن يتحقّق، فلا طعم له
إن لم يكن أتوم-كن معنا

259
00:18:54,870 --> 00:18:55,910
!أجل

260
00:18:55,910 --> 00:18:58,510
!لنفصح له عن مشاعرنا

261
00:19:00,660 --> 00:19:01,870
!أجل

262
00:19:04,820 --> 00:19:05,910
...شكراً للمجيء

263
00:19:05,910 --> 00:19:08,030
!أتوم-كن، لا تغادر

264
00:19:09,270 --> 00:19:11,270
عمّاذا تتكلّمون؟

265
00:19:11,270 --> 00:19:13,970
نتكلّم عن العرض المُقدَّم من هوليود، صحيح؟

266
00:19:13,970 --> 00:19:15,380
الذي أردت الحديث عنه؟

267
00:19:15,380 --> 00:19:18,050
أجل، غالاكسي ساموراي؟

268
00:19:18,560 --> 00:19:19,800
هل كنتم تعرفون؟

269
00:19:19,800 --> 00:19:23,260
أعلم أنّ هذا حلم هامٌّ بالنسبة لك

270
00:19:23,680 --> 00:19:27,470
وأعلم أيضاً أنّه لا يحقُّ لنا إيقافك

271
00:19:27,770 --> 00:19:32,980
لكن لن أتقبّل حقّاً أن تتفكّك فرقة مارجينال 4 هكذا

272
00:19:33,460 --> 00:19:34,820
لذا أرجوك

273
00:19:34,820 --> 00:19:36,610
!لا تغادر أرجوك يا أتوم-كن

274
00:19:36,610 --> 00:19:38,280
عمّاذا تتكلّمون؟

275
00:19:38,620 --> 00:19:40,720
لقد رفضت وانتهى الأمر

276
00:19:40,720 --> 00:19:42,910
مُحال أن أغادر مارجينال 4

277
00:19:45,100 --> 00:19:48,060
لا أدري لِمَ كلّ هذه الضجّة
لكن شكراً لقلقكم

278
00:19:48,560 --> 00:19:51,660
على أي حال، حلمي ليس هوليود

279
00:19:51,660 --> 00:19:52,830
!إنّه الفضاء

280
00:19:52,830 --> 00:19:54,540
أتوم-كن

281
00:19:55,040 --> 00:19:57,820
لا أنكر أنّني أردتُ خوض مسيرتي منفرداً
في بادئ الأمر

282
00:19:58,260 --> 00:19:59,850
لكن لم يعد الأمر كذلك

283
00:19:59,850 --> 00:20:02,430
أدركتُ شيئاً بعد كل ما فعلناه معاً

284
00:20:02,430 --> 00:20:03,970
لستُ لوحدي

285
00:20:03,970 --> 00:20:06,390
إن لم نكن نحن الأربعة معاً فلا جدوى من شيء

286
00:20:07,910 --> 00:20:09,990
لا أريد أن أكون نجماً هوليودياً

287
00:20:10,460 --> 00:20:13,730
أريد أن أتألّق معكم كفرقة مارجينال 4

288
00:20:15,440 --> 00:20:17,000
!أتوم-كن

289
00:20:17,000 --> 00:20:18,360
!هذا يكفي

290
00:20:20,020 --> 00:20:22,360
وماذا كنت تفعل في ذاك المبنى؟

291
00:20:23,640 --> 00:20:26,410
أعني بناء لايت ستار ووركس

292
00:20:26,410 --> 00:20:27,830
ذهبتَ إلى هناك بمفردك اليوم

293
00:20:28,220 --> 00:20:30,740
لايت ستار ووركس؟

294
00:20:31,350 --> 00:20:35,170
ذهبتُ إلى البناء الذي تتواجد فيه وكالة
استكشاف الفضاء

295
00:20:37,920 --> 00:20:39,880
!معك حقّ

296
00:20:41,650 --> 00:20:45,690
ذهبتُ للتكلّم مع وكالة استكشاف الفضاء

297
00:20:46,600 --> 00:20:50,960
قرأتُ هذا بالصدفة على سكيتر

298
00:20:50,960 --> 00:20:52,980
كانوا يطلبون كتابة رسائل لإطلاقها في الفضاء

299
00:20:53,640 --> 00:20:57,510
إنّه مشروع نُطلِق من خلاله الرّسائل إلى الفضاء

300
00:20:57,510 --> 00:20:59,680
على صاروخٍ سينطلق من جزيرة تانيغا في الشّهر المقبل

301
00:21:00,510 --> 00:21:04,160
إن حملَ هذا الصّاروخ أسطوانة قمنا بتقبيلها
أفلا يعني هذا

302
00:21:04,160 --> 00:21:07,950
أنّنا نستطيع إيصال قبلة إلى أبعد أصقاع المجرّة؟

303
00:21:08,600 --> 00:21:09,890
أتوم-كن

304
00:21:09,890 --> 00:21:11,300
لكن كنتُ قد تأخّرتُ كثيراً

305
00:21:12,340 --> 00:21:16,750
عندما قرأتُه كان الموعد النّهائي
لتسليم الرّسائل قد انتهى

306
00:21:17,450 --> 00:21:19,800
لكن أردتُ فعلاً تحقيق ذلك

307
00:21:20,450 --> 00:21:24,760
لهذا ذهبتُ إلى وكالة استكشاف الفضاء
لألتمس منهم بشكلٍ مباشر

308
00:21:24,760 --> 00:21:26,470
لكن كانت النتيجة سيّئة

309
00:21:26,840 --> 00:21:30,360
أعتقد أنّهم لا يضعون الطلبات التي سُلِّمَتْ
بعد الموعد النّهائي بعين الاعتبار

310
00:21:31,140 --> 00:21:32,800
!أنا آسف حقّاً

311
00:21:32,800 --> 00:21:35,930
كان من الممكن أن تكون هذه فرصتنا
لتحقيق حلمنا

312
00:21:39,340 --> 00:21:41,320
ما المضحك في الأمر؟

313
00:21:41,600 --> 00:21:43,090
لا داعي للقلق

314
00:21:43,090 --> 00:21:46,990
لقد تقدّمتُ بطلب مُسبقاً وتمّ قبولي

315
00:21:46,990 --> 00:21:48,200
!حقّاً؟

316
00:21:48,200 --> 00:21:52,330
فكّر روي-كن مثلما فكّرت أنت

317
00:21:54,570 --> 00:21:55,360
أجل

318
00:21:55,960 --> 00:21:57,430
هذا محرج لكن صحيح

319
00:23:09,110 --> 00:23:11,500
سأبدأ إذاً

320
00:23:17,120 --> 00:23:18,740
!أنا بعدك

321
00:23:22,370 --> 00:23:24,000
وأنا التّالي

322
00:23:26,680 --> 00:23:28,500
وأنا الأخير

323
00:23:37,330 --> 00:23:40,350
:الحلقة القادمة
"انفجار كبير نشأ من قبلة"

324
00:23:37,330 --> 00:23:40,980
الحلقة القادمة