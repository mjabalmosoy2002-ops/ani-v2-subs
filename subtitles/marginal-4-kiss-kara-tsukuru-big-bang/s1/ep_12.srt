1
00:00:07,450 --> 00:00:09,660
!بقي ثلاثة أيّام على بدء مهرجان الانفجار الكبير

2
00:00:09,660 --> 00:00:13,090
!يبدو هذا جيّداً

3
00:00:14,860 --> 00:00:17,370
بالتأكيد. امضِ والتقط صورة

4
00:00:20,710 --> 00:00:22,840
...ثلاثة أيّام فقط

5
00:00:22,840 --> 00:00:24,900
...العدّ التنازلي بيد أر

6
00:00:24,900 --> 00:00:26,720
...متحمّس للغاية الآن

7
00:00:26,720 --> 00:00:28,040
!تمّ النشر

8
00:00:28,260 --> 00:00:30,160
،لا بأس من التحمّس الآن

9
00:00:30,160 --> 00:00:32,010
لكن من فضلك حافظ على أدائك الجيّد

10
00:00:32,240 --> 00:00:34,230
!لا داعي للقلقِ من ذلك

11
00:00:34,230 --> 00:00:36,010
!فأنا آكل المشاوي الكوريّة يومياً

12
00:00:37,720 --> 00:00:40,830
وضعَتْ مديرتنا ذلك بعينِ الاعتبار أيضاً

13
00:00:40,830 --> 00:00:43,260
وحتّى أنّها خفّفَتْ عنّا أعباء العمل قبل المهرجان

14
00:00:43,260 --> 00:00:46,550
هذا صحيح. كانَتْ خير الدّاعمين لنا

15
00:00:46,550 --> 00:00:47,730
أجل

16
00:00:47,730 --> 00:00:49,720
اقتربَ كثيراً

17
00:00:49,720 --> 00:00:51,980
أجل، ثلاثة أيّام فحسب

18
00:00:52,280 --> 00:00:57,710
حسناً، ما رأيكم بالمجيء إلى منزلي اللّيلة
لعقدِ اجتماعٍ أخير؟

19
00:00:57,710 --> 00:00:58,510
!فكرة سديدة

20
00:00:58,510 --> 00:00:59,940
!أجل، لنفعل ذلك

21
00:00:59,940 --> 00:01:01,400
أجل، هيّا

22
00:01:01,400 --> 00:01:02,580
حُسِمَ الأمر إذاً

23
00:01:03,640 --> 00:01:05,610
بقي القليل فقط

24
00:01:07,540 --> 00:01:09,630
هذا هو اجتماعنا الأخير إذاً؟

25
00:01:09,940 --> 00:01:11,590
أليسَتْ هذه مجرّد سهرة منزليّة؟

26
00:01:12,060 --> 00:01:14,760
!لا تدقِّق في التفاصيل

27
00:01:14,760 --> 00:01:18,760
لقد تغيّرتَ حقّاً يا روي-كن

28
00:01:18,760 --> 00:01:22,220
هل يُعقَل أن تكون رغبتك الحقيقيّة هي إقامة
سهرة منزليّة؟

29
00:01:22,220 --> 00:01:25,640
...هـ-هذا

30
00:01:26,140 --> 00:01:30,430
على أي حال، أشعر وكأنّنا فعلناها أخيراً

31
00:01:30,430 --> 00:01:32,170
!قاعة شهاب أحلامنا

32
00:01:32,170 --> 00:01:33,570
أخيراً

33
00:01:33,570 --> 00:01:35,120
،لا أنكر صحّة ما قلتموه

34
00:01:35,120 --> 00:01:39,030
لكن هدفنا لحقيقيّ هو فعلاً
إقامة حفلنا الغنائي هناك

35
00:01:41,780 --> 00:01:43,540
—لذا ما زلنا لم نبلغ ذلك بعد

36
00:01:43,540 --> 00:01:45,040
!يا إلهي

37
00:01:45,040 --> 00:01:46,830
ما الأمر؟ ما خطبك؟

38
00:01:46,830 --> 00:01:49,010
!نسيتُ أمرَ تحضير لباسي الداخلي الجالب للحظّ

39
00:01:49,010 --> 00:01:50,050
هل عليك البدء الآن؟

40
00:01:50,050 --> 00:01:52,000
!إن لم أبدأ الآن فسينفد الوقت

41
00:01:53,250 --> 00:01:55,510
!حان الوقت

42
00:01:55,770 --> 00:01:56,720
!انظروا

43
00:01:56,720 --> 00:01:59,470
عرّضتُه للشمس يوماً كاملاً

44
00:01:59,470 --> 00:02:00,990
ثمّ تركته يرتاح ثلاثة أيّام

45
00:02:00,990 --> 00:02:01,970
هذا معقّدٌ جداً

46
00:02:01,970 --> 00:02:04,280
!مع صورة المجرّة

47
00:02:05,200 --> 00:02:09,450
!جاري تحضير لباسي الداخلي الجالب للحظّ الآن

48
00:02:09,450 --> 00:02:10,730
...والآن صورة

49
00:02:10,730 --> 00:02:12,760
لا داعي لنشر تغريدة حولَ ذلك

50
00:02:12,760 --> 00:02:13,170
لا يجوز؟

51
00:02:13,170 --> 00:02:14,320
لا يجوز

52
00:02:14,960 --> 00:02:16,940
حسناً، لنستأنف اجتماعنا

53
00:02:16,940 --> 00:02:18,400
عمّاذا ينبغي أن نتكلّم في يوم الإجازة؟

54
00:02:18,400 --> 00:02:20,320
كيف تصنعُ لباساً داخليّاً جالباً للحظّ؟

55
00:02:20,320 --> 00:02:21,870
لنبتعد عن ذاك الموضوع

56
00:02:21,870 --> 00:02:24,020
لنتحدّث عن المجهود الذي بذلناه في مخيّم التدريب

57
00:02:24,020 --> 00:02:27,040
أنا واثقٌ أنّ الجميع سيحبّون قصّة ناغاشي أودون

58
00:02:27,040 --> 00:02:28,330
!إنّها جميلة

59
00:02:28,330 --> 00:02:31,040
وكيف أتقنّا النظرة اللّعوب أيضاً

60
00:02:31,040 --> 00:02:34,800
رغم أنّنا ما زلنا لم نقترب أبداً من مستوى
لاغرانجي بوينت

61
00:02:34,800 --> 00:02:38,550
!إذاً لندرس جميعاً نظراتهم اللّعوبة معاً

62
00:02:38,550 --> 00:02:44,470
أظنُّني لديّ أسطوانة كعيّنة
عن أغنيتهم المُصوَّرة الجديدة هنا

63
00:02:49,190 --> 00:02:51,060
...هـ-هذه

64
00:02:51,400 --> 00:02:52,840
...أتوم-كن، هذه

65
00:02:52,840 --> 00:02:55,590
الأسطوانة التي قبّلناها آخر مرّة

66
00:02:55,590 --> 00:02:58,930
ظننتُك أرسلتَها إلى وكالة استكشاف الفضاء

67
00:02:58,930 --> 00:03:03,170
...أجل، فعلت. لكن بما أنّها هنا الآن

68
00:03:03,170 --> 00:03:04,700
...أتوم-كن، لا تقل لي

69
00:03:05,110 --> 00:03:10,960
!أرسلتُ أسطوانة لاغرانجي بوينت بالخطأ

70
00:03:10,960 --> 00:03:14,460
الحلقة الأخيرة

71
00:03:15,940 --> 00:03:19,720
ماذا؟! ذهبَ أتوم إلى تانيغاشيما بنفسه؟

72
00:03:19,720 --> 00:03:23,720
إطلاق الصّاروخ بعد يومين، أي في نفس يوم
عرضنا في قاعة الشّهاب

73
00:03:23,720 --> 00:03:26,660
،لذا عندما سألنا وكالة استكشاف الفضاء

74
00:03:30,330 --> 00:03:34,110
ما الذي يفعله بالضبط ونحن على وشك
أن نقيم عرضاً كبيراً؟

75
00:03:34,110 --> 00:03:35,940
يا له من حافز كبير

76
00:03:35,940 --> 00:03:37,230
،لو أخبرتموني فقط

77
00:03:37,600 --> 00:03:39,780
لأرسلتُ ريوومارو

78
00:03:40,050 --> 00:03:41,280
حمام زاجل؟

79
00:03:41,570 --> 00:03:44,880
يصلُ الحمامُ الزاجل إلى وجهته باستخدام غريزته فقط

80
00:03:44,880 --> 00:03:47,120
لذا إرسال واحد إلى تانيغاشيما أمر مستحيل ربّما

81
00:03:47,120 --> 00:03:49,200
روي-سان، أنت جيّد، لكن كانَتْ تلك دُعابة

82
00:03:49,580 --> 00:03:52,460
أعتقد أنّ المظهر الإيجابي لكلّ هذا هو

83
00:03:52,460 --> 00:03:53,930
أنّنا متفرِّغون تماماً قبل العرض

84
00:03:53,930 --> 00:03:56,420
أتساءل إذا كان قد وصلَ إلى هناك مُسبقاً

85
00:03:56,420 --> 00:04:01,630
!أجل! وصلتُ إلى تانيغاشيما

86
00:04:01,910 --> 00:04:04,510
والآن إلى الحافلة

87
00:04:18,110 --> 00:04:20,170
ذاك هو الصّاروخ

88
00:04:20,170 --> 00:04:21,570
!هذا مذهل

89
00:04:23,300 --> 00:04:25,880
لا، لحظة، الوقت ليس مناسباً للصور

90
00:04:25,880 --> 00:04:27,530
عليّ أن أسرع

91
00:04:29,220 --> 00:04:31,040
!مرحباً! إلى هنا

92
00:04:31,040 --> 00:04:35,490
آسف حقّاً لإزعاجي لكم بهذا الشّكل

93
00:04:36,380 --> 00:04:37,650
تفضّل

94
00:04:37,650 --> 00:04:39,340
سأحرص على إدخالها

95
00:04:39,690 --> 00:04:41,140
!شكراً جزيلاً لك

96
00:04:41,140 --> 00:04:45,180
من فضلكم أوصلوا قبلتنا إلى أبعد أصقاع المجرّة

97
00:04:45,180 --> 00:04:46,180
بالتأكيد

98
00:04:46,180 --> 00:04:49,720
وماذا ينبغي أن نفعل بالأسطوانة
التي أرسلتها بالخطأ؟

99
00:04:49,720 --> 00:04:51,890
...آه هذه

100
00:04:55,140 --> 00:04:56,380
إنّه أتوم

101
00:04:57,100 --> 00:05:00,740
ماذا؟ أسطوانتنا؟ إلى أبعد أصقاع المجرّة؟

102
00:05:00,740 --> 00:05:02,690
ما الذي تفعلونه حتّى؟

103
00:05:02,690 --> 00:05:04,180
!تـ-تانيغاشيما؟

104
00:05:04,180 --> 00:05:04,610
ماذا؟

105
00:05:05,310 --> 00:05:07,440
حسناً. هكذا إذاً

106
00:05:07,440 --> 00:05:08,780
نعم، حسناً

107
00:05:08,780 --> 00:05:10,080
انتظر

108
00:05:12,210 --> 00:05:15,410
مرحباً؟ أجل، عُلِم

109
00:05:15,410 --> 00:05:16,620
ماذا نفعل؟

110
00:05:16,880 --> 00:05:19,460
لا مشكلة على ما أعتقد، هذا مناسب

111
00:05:19,460 --> 00:05:22,590
أظنُّنا سيتوجّب علينا إرسال قبلة عبر الهاتف

112
00:05:24,560 --> 00:05:26,810
!حسناً، تمَّ إيصال القبلات

113
00:05:26,810 --> 00:05:28,050
!اتركوا الباقي عليّ

114
00:05:28,310 --> 00:05:32,910
!إذاً أرسل هذه إلى أبعد أصقاع المجرّة أيضاً من فضلك

115
00:05:32,910 --> 00:05:33,850
حسناً

116
00:05:38,230 --> 00:05:39,650
إنّها من أتوم-كن

117
00:05:39,650 --> 00:05:42,500
"سلّمتُ أسطوانتنا بأمان"

118
00:05:42,500 --> 00:05:46,900
وفي طريقي، طلبتُ منهم إرسال أسطوانة"
"لاغرانجي بوينت أيضاً

119
00:05:46,900 --> 00:05:50,160
ماذا؟ ماذا عنّا إذاً؟

120
00:05:50,160 --> 00:05:52,100
ليس لدينا أي أسطوانة لـ يونيكورن

121
00:05:52,100 --> 00:05:54,860
على رسلكم! كان بمقدوركم أن تحصلوا على واحدة

122
00:05:54,860 --> 00:06:00,170
يقول أتوم-كن أنّه لا مزيد من الرّحلات
اليوم، لذا سيمكث اللّيلة هناك

123
00:06:00,170 --> 00:06:03,140
ويعود إلى طوكيو في عصر يوم غدّ

124
00:06:03,140 --> 00:06:04,740
سيصلُ إذاً قبل تدريبنا على الغناء

125
00:06:04,740 --> 00:06:06,130
!هذا جيّد

126
00:06:06,830 --> 00:06:08,010
ما الأمر يا روي؟

127
00:06:08,010 --> 00:06:11,140
لا شيء، هنالك بوادر إعصار فحسب

128
00:06:11,140 --> 00:06:15,390
لكن يبدو أنّ مساره آمن

129
00:06:15,390 --> 00:06:18,020
...والآن ماذا نفعل بشأن أسطوانتهم

130
00:06:19,260 --> 00:06:20,350
مهلاً

131
00:06:20,350 --> 00:06:21,440
!وجدتُها

132
00:06:22,110 --> 00:06:25,430
حسناً، أظنّني سأسارع إلى هناك مرّة أخرى

133
00:06:28,110 --> 00:06:29,880
أجل، لا تقلق

134
00:06:29,880 --> 00:06:31,070
أخبرني أر بذلك

135
00:06:32,140 --> 00:06:35,290
اشتريتُ إحدى أسطواناتكم بعد ذلك
وسلّمتُها له أيضاً

136
00:06:35,290 --> 00:06:36,620
حقّاً؟

137
00:06:36,620 --> 00:06:38,910
لم أستطع استبعادكم

138
00:06:38,910 --> 00:06:41,280
أجل... شكراً

139
00:06:51,880 --> 00:06:56,500
إذاً ستصل أصواتنا إلى هناك؟

140
00:07:01,090 --> 00:07:05,120
الإعصار ميغا 17 قد غيّرَ مساره
الذي كان جهة الشّمال الغربي

141
00:07:05,120 --> 00:07:08,490
وأصبح يتوجّه الآن نحو تانيغاشيما دون فقدان أي زخم

142
00:07:08,490 --> 00:07:09,950
!حقّاً؟

143
00:07:09,950 --> 00:07:11,670
يبدو أنّه غيّرَ مساره

144
00:07:11,670 --> 00:07:13,950
لكن الأجواء لطيفة هنا

145
00:07:13,950 --> 00:07:15,910
هل يستطيعُ أتوم-كن العودة؟

146
00:07:20,370 --> 00:07:22,120
!معقول؟

147
00:07:22,120 --> 00:07:25,590
هل عليّ أن أعود إلى الكوخ مجدّداً فحسب؟

148
00:07:25,590 --> 00:07:28,090
لا بأس على ما أعتقد بما أنّه قد بقي يوم

149
00:07:36,930 --> 00:07:40,060
أنا آسف يا شباب

150
00:07:40,530 --> 00:07:42,940
إلغاء كافّة الرّحلات ليس غلطتك

151
00:07:42,940 --> 00:07:44,560
،لن يبدأ الحفل قبل ليلة الغدّ

152
00:07:44,560 --> 00:07:46,690
لذا يمكنك المُغادرة في الصّباح

153
00:07:47,280 --> 00:07:48,670
أنا حقّاً آسف

154
00:07:48,670 --> 00:07:50,650
سأحضر هدايا لذا سامحوني أرجوكم

155
00:07:50,650 --> 00:07:52,000
،بدلاً من الهدايا

156
00:07:52,000 --> 00:07:55,160
احرص على المُغادرة في أبكر وقتٍ مُمكن في الصّباح

157
00:07:55,640 --> 00:07:59,150
الإعصار الذي مرَّ بكم يتوجّه الآن شرقاً

158
00:07:59,150 --> 00:08:02,290
من المُحتمَل أن يسوء الطقس هنا في مساءِ الغدّ

159
00:08:02,290 --> 00:08:03,440
معك حقّ

160
00:08:03,440 --> 00:08:06,820
سأحرص على اللّحاق بالرّحلة الأولى كي أتواجد
هُناك بعد الظهر مباشرة

161
00:08:14,980 --> 00:08:16,850
!حسناً

162
00:08:16,850 --> 00:08:19,110
!جوّ صحو تماماً بعد الإعصار

163
00:08:20,020 --> 00:08:22,520
!المديرة! شكراً على مُكالمة الإيقاظ

164
00:08:22,850 --> 00:08:25,330
استيقظتُ للتو. جاري الاستعداد الآن

165
00:08:25,330 --> 00:08:26,690
!انتظريني في قاعة الشّهاب

166
00:08:28,650 --> 00:08:29,840
صباح الخير يا أتوم-كن

167
00:08:29,840 --> 00:08:30,400
!مرحباً

168
00:08:30,400 --> 00:08:31,490
هل أنتَ مستيقظ؟

169
00:08:31,490 --> 00:08:33,360
!أجل، أنا كذلك. شكراً

170
00:08:36,530 --> 00:08:38,500
أتوم، هل استيقظت؟

171
00:08:38,500 --> 00:08:40,240
!أجل. شكراً

172
00:08:43,210 --> 00:08:45,360
حان وقتُ الاستيقاظ أيّها الكتكوت

173
00:08:45,360 --> 00:08:46,670
أنت أيضاً يا كيرا؟

174
00:08:46,670 --> 00:08:48,920
!انتظر، لستُ كتكوتاً

175
00:08:52,750 --> 00:08:54,630
ماذا؟ من هذا؟ ألتو؟

176
00:08:54,630 --> 00:08:55,340
صحيح

177
00:08:57,620 --> 00:08:59,480
حان وقتُ الاستيقاظ يا سيّد خنزير الماء

178
00:08:59,480 --> 00:09:01,010
من تناديه بخنزير الماء؟

179
00:09:03,040 --> 00:09:04,770
إلى أين تريد أن توصل قبلة استيقاظك؟

180
00:09:04,770 --> 00:09:06,440
!ليس إلى أي مكان

181
00:09:08,130 --> 00:09:09,900
من هذه المرّة؟

182
00:09:10,390 --> 00:09:11,570
نعم؟

183
00:09:11,570 --> 00:09:13,210
صباح الخير يا أتوم-كن

184
00:09:13,210 --> 00:09:15,360
—هذا أنت يا روي. غادرتُ الكوخ للتو

185
00:09:15,360 --> 00:09:16,820
!معقول؟

186
00:09:16,820 --> 00:09:19,280
!ما هذا؟ هنالك ازدحامٌ مروريّ كبير

187
00:09:19,280 --> 00:09:21,540
أظنُّني تأخّرتُ كثيراً

188
00:09:21,540 --> 00:09:25,280
كنتُ أحاول التوصُّل إليك لأخبرك
أن تغادر ولو أبكر بدقيقة

189
00:09:25,280 --> 00:09:26,290
لكن كان خطّك مشغولاً

190
00:09:26,290 --> 00:09:27,790
ما الذي يجري؟

191
00:09:27,790 --> 00:09:29,750
قرأتُ على الإنترنت

192
00:09:30,120 --> 00:09:33,840
أنّه في يوم إطلاق الصّاروخ، ازدحمت الشّوارع

193
00:09:33,840 --> 00:09:36,220
لمسافة كيلومترات بسببِ تجمُّع المتفرّجين

194
00:09:36,220 --> 00:09:38,140
،هذا سخيف

195
00:09:38,140 --> 00:09:40,190
لكنّني ذاهب إلى المطار

196
00:09:40,190 --> 00:09:42,140
!إنّه في الاتّجاه الآخر، لذا أنا بأمان

197
00:09:43,450 --> 00:09:46,100
لماذا لا تأتي الحافلة؟

198
00:09:46,100 --> 00:09:47,880
،الحافلة تسلكُ طريقَ ذهاب وإيّاب

199
00:09:47,880 --> 00:09:51,520
لذا إن علِقَتْ في الازدحام نكون
قد عدنا إلى المربّع الأوّل

200
00:09:51,520 --> 00:09:53,360
!ها هي الحافلة

201
00:09:53,360 --> 00:09:56,570
!سأبحث عن سيّارة أجرة إذاً! سأغلق الخطّ الآن

202
00:10:02,530 --> 00:10:03,370
هذا صحيح

203
00:10:03,370 --> 00:10:04,830
عليّ الوصول إلى المطار

204
00:10:04,830 --> 00:10:06,110
أرسلوا سيّارة أجرة حالاً من فضلكم

205
00:10:06,110 --> 00:10:07,960
ماذا؟ كلّها في الخارج؟

206
00:10:08,320 --> 00:10:10,980
ألا تعلمون متى تعود إحداها؟

207
00:10:11,510 --> 00:10:12,710
لا، لا بأس

208
00:10:15,170 --> 00:10:17,840
حسناً، حان الوقتُ للملاذ الأخير

209
00:10:21,300 --> 00:10:22,970
الرّكوب المجّاني

210
00:10:26,020 --> 00:10:27,890
هل أتوم-كن بخير؟

211
00:10:28,290 --> 00:10:30,180
،تأخّرَ عن الموعد

212
00:10:30,180 --> 00:10:32,520
لكن تمكّن من ركوبٍ مجّاني

213
00:10:33,540 --> 00:10:35,940
هل سيشكّل الإعصار هنا مشكلة؟

214
00:10:35,940 --> 00:10:37,150
،على هذا الحال

215
00:10:40,020 --> 00:10:43,220
قاعة الشّهاب متّصِلة بنظام أنفاق محطّة القطار

216
00:10:43,220 --> 00:10:45,790
لذا لن تكون هنالك مشكلة حتّى لو وصلَ الإعصار

217
00:10:46,370 --> 00:10:48,760
المُشكلة الوحيدة هي أتوم-كن

218
00:10:48,760 --> 00:10:52,580
إن لم يلحق بالرّحلة التي تغادر
كاغوشيما قبل الظهر

219
00:10:52,580 --> 00:10:54,590
فسيضطرّ للصعود في رحلة المساء إلى طوكيو

220
00:10:54,910 --> 00:10:57,110
،أي بالتزامن مع وصول الإعصار

221
00:10:57,110 --> 00:10:59,380
ما يعني أنّ رحلته قد تُلغى مجدّداً

222
00:11:03,800 --> 00:11:06,260
اعتمد عليّ! سأحرص على إيصالك

223
00:11:06,770 --> 00:11:09,120
!أنت منقذ! شكراً جزيلاً لك

224
00:11:09,120 --> 00:11:10,270
لا شكر على واجب

225
00:11:10,690 --> 00:11:14,440
لديّ ابن يعيش في مدينةٍ أخرى لكنّه
من أشدّ المُعجبين بماجي 4

226
00:11:15,900 --> 00:11:18,240
!لذا تمسّك جيّداً

227
00:11:21,620 --> 00:11:22,780
!ما الذي يجري مع أتوم؟

228
00:11:25,500 --> 00:11:26,910
...في الحقيقة

229
00:11:27,990 --> 00:11:29,330
!ركوب مجّاني؟

230
00:11:30,490 --> 00:11:32,150
اهدأ من فضلك يا تسوباسا-كن

231
00:11:32,150 --> 00:11:34,070
هذا طبعُ أتوم-سان

232
00:11:35,700 --> 00:11:38,760
ما الذي يفعله؟

233
00:11:39,860 --> 00:11:40,970
تسوباسا

234
00:11:41,280 --> 00:11:43,830
سينجح الأمر. ثِقوا به

235
00:11:47,620 --> 00:11:49,520
لنبدأ بتدريبنا الأخير

236
00:12:17,040 --> 00:12:20,770
يبدو أنّ رحلة الصّباح من تانيغاشيما قد فاتته

237
00:12:20,770 --> 00:12:21,880
هل ستكون الأمور على ما يُرام؟

238
00:12:22,240 --> 00:12:23,310
،إن لحق بالرّحلة التالية

239
00:12:23,310 --> 00:12:26,390
فينبغي أن توصله من كاغوشيما إلى طوكيو
على الخامسة

240
00:12:27,470 --> 00:12:30,820
يصبح الوقت ضيّقاً لكن هذا أفضل
من عدم الوصول

241
00:12:31,510 --> 00:12:32,470
!ألغيَتْ؟

242
00:12:32,470 --> 00:12:33,760
!لكن الطقس صحو

243
00:12:33,760 --> 00:12:36,510
مع الأسف، وقت الوصول إلى طوكيو
يتزامن مع وقت وصول الإعصار

244
00:12:36,510 --> 00:12:38,260
!ليس لي إلّا القطار السّريع إذاً

245
00:12:41,530 --> 00:12:45,190
هذا سيّئ. سيكون العرض قد انتهى حينها

246
00:12:52,030 --> 00:12:54,710
ألغيَتْ كافّة الرّحلات؟

247
00:12:55,460 --> 00:12:57,040
مستحيل

248
00:12:58,880 --> 00:12:59,750
أنا آسف

249
00:13:00,370 --> 00:13:03,050
ما كان لهذا أن يحدث لو لم أقل
شيئاً عن مُحاولة إيصال

250
00:13:03,050 --> 00:13:04,840
قبلاتنا عبر صاروخ في الفضاء

251
00:13:06,260 --> 00:13:08,930
لو لم أخض هذه الرّحلة
...السّخيفة لتسليم الأسطوانة باليد

252
00:13:13,680 --> 00:13:15,200
لا بأس

253
00:13:15,200 --> 00:13:19,480
هذا الجانب السّخيف فيك هو ما يجعلك مُحبَّباً

254
00:13:20,320 --> 00:13:23,450
لا يكون أتوم-كن إن لم يكن سخيفاً

255
00:13:23,450 --> 00:13:24,360
!هذا صحيح

256
00:13:25,320 --> 00:13:26,570
...أنتم

257
00:13:27,800 --> 00:13:30,080
لكن ماذا عن العرض؟

258
00:13:30,350 --> 00:13:31,410
أتريدون القيام به من دون أتوم؟

259
00:13:31,410 --> 00:13:33,260
!مستحيل

260
00:13:33,260 --> 00:13:34,580
!لا جدوى إن لم نكن جميعاً معاً

261
00:13:35,040 --> 00:13:36,540
قائدنا على حقّ

262
00:13:38,250 --> 00:13:40,880
لن يصل أتوم على الموعدِ الآن

263
00:13:40,880 --> 00:13:42,340
!ماذا ستفعلون إذاً؟

264
00:13:43,390 --> 00:13:44,260
...في الواقع

265
00:13:45,890 --> 00:13:48,050
سيصلُ في آخر لحظة فحسب

266
00:13:48,050 --> 00:13:49,500
شاي-سان؟

267
00:13:49,500 --> 00:13:51,280
ماذا تعني؟

268
00:13:51,280 --> 00:13:54,070
سندع أتوم يستقلُّ طائرةً مُستأجرة

269
00:13:54,070 --> 00:13:55,670
انتهينا للتو من المفاوضات

270
00:13:55,670 --> 00:13:56,940
تغادر هانيدا في الثّالثة

271
00:13:57,700 --> 00:14:00,450
ذهاب إلى كاغوشيما وعودة أربع ساعات

272
00:14:00,450 --> 00:14:02,400
لن يصل على موعدِ الافتتاح

273
00:14:02,930 --> 00:14:04,880
سنعدِّل في القائمة

274
00:14:04,880 --> 00:14:07,220
،إن جعلنا عرض ماجي 4 في آخر الترتيب

275
00:14:07,940 --> 00:14:08,910
فسيصلُ في آخر لحظة

276
00:14:10,360 --> 00:14:11,240
...لكن

277
00:14:11,240 --> 00:14:13,760
سنشرح ذلك للعاملين

278
00:14:13,760 --> 00:14:15,450
هل من سببٍ آخر يُفشل هذا الأمر؟

279
00:14:15,450 --> 00:14:17,960
صحيح، لذا لا توجد مشكلة

280
00:14:18,250 --> 00:14:22,450
لكن لطالما كان العرض الأخير الذي يُلهِب
الجمهور هو الذي تؤدّيه لاغرانجي بوينت

281
00:14:22,450 --> 00:14:23,460
...نحن لسنا

282
00:14:23,460 --> 00:14:25,760
نقول أنّه لا توجد مشكلة

283
00:14:26,450 --> 00:14:27,840
أم أنّكم خائفون؟

284
00:14:31,380 --> 00:14:33,540
لا، نحن على ما يرام

285
00:14:33,540 --> 00:14:34,720
!سنفعلها

286
00:14:35,930 --> 00:14:36,980
حُسِمَ الأمر إذاً

287
00:14:37,590 --> 00:14:40,440
لكن هذا ينتهي في الوقتِ المحدَّد

288
00:14:40,440 --> 00:14:43,900
حتّى لو استطاعت الطّائرة العودة
مع الإعصار، هل يمكنها الهبوط؟

289
00:14:43,900 --> 00:14:45,060
،حتّى لو استطاعت

290
00:14:45,060 --> 00:14:47,850
علينا احتساب الوقت من المطار
إلى قاعة الشّهاب

291
00:14:47,850 --> 00:14:52,030
وماذا عن الصُّعود على خشبةِ المسرح من دون أي تحضير؟

292
00:14:53,090 --> 00:14:56,410
لا، إن سار الأمر وفقَ حساباتي، ستكون
الأمور على ما يُرام

293
00:14:56,740 --> 00:14:57,730
ماذا؟

294
00:14:57,730 --> 00:14:59,140
ماذا تقصد؟

295
00:14:59,140 --> 00:15:00,710
الأمر بسيط

296
00:15:01,220 --> 00:15:04,680
لكنّه أيضاً رهانٌ فيه مخاطرة كبيرة

297
00:15:06,250 --> 00:15:10,260
سنصعد جميعاً على الطائرةِ ونذهب لنقلّ أتوم-كن

298
00:15:11,780 --> 00:15:13,200
أهذا هو؟

299
00:15:13,200 --> 00:15:16,100
لا، هنا تبدأ المجازفة الكبيرة

300
00:15:16,440 --> 00:15:18,180
!سأقبل بأي مجازفة

301
00:15:18,180 --> 00:15:19,020
!هات ما عندك يا روي

302
00:15:20,500 --> 00:15:23,990
هذه هي اللّحظة التي أتعدّى فيها على اختصاصك

303
00:15:23,990 --> 00:15:26,920
وأقترح اقتراحاً سخيفاً

304
00:15:28,730 --> 00:15:30,150
هل أنت جادّ؟

305
00:15:30,900 --> 00:15:32,900
هذا جنون حقيقيّ

306
00:15:32,900 --> 00:15:35,290
هل ستفعل ذلك حقّاً؟

307
00:15:35,290 --> 00:15:37,790
!لا، يبدو هذا ممتعاً. أنا موافق

308
00:15:37,790 --> 00:15:38,500
!أنا أيضاً

309
00:15:38,500 --> 00:15:39,200
!كذلك أنا

310
00:15:40,500 --> 00:15:42,290
الوقتُ يُداهمنا، انطلقوا حالاً

311
00:15:42,290 --> 00:15:44,110
وأمر آخر

312
00:15:44,110 --> 00:15:48,340
لن نخبر الأميرات في القاعة أنّكم ستتأخّرون

313
00:15:48,340 --> 00:15:49,340
لذا ضعوا ذلك في الحسبان

314
00:15:50,910 --> 00:15:52,250
ماذا ظننتُم؟

315
00:15:52,250 --> 00:15:55,540
الأميرات قادمات للاستمتاع بالعرض

316
00:15:55,540 --> 00:15:58,190
إقلاقهن سيُعارض مبادئنا

317
00:15:58,190 --> 00:15:59,550
لا تتردّدوا الآن

318
00:15:59,550 --> 00:16:02,210
كلّ ما عليكم فعله هو العودة على الموعد

319
00:16:04,340 --> 00:16:05,190
سنفعلها

320
00:16:05,190 --> 00:16:06,360
!أعدُكم

321
00:16:06,640 --> 00:16:07,480
!أجل

322
00:16:36,400 --> 00:16:38,770
هل سيصلون على الموعد فعلاً؟

323
00:16:38,770 --> 00:16:41,330
كيف لنا ألّا نؤمن بهم؟

324
00:16:41,330 --> 00:16:42,020
ثِقوا بهم

325
00:16:43,620 --> 00:16:44,790
تسوباسا-كن

326
00:16:49,170 --> 00:16:50,450
هذا ما أظنّه

327
00:16:50,450 --> 00:16:52,560
!لنلهب الأجواء في مهرجانِ الانفجار الكبير

328
00:16:52,560 --> 00:16:53,400
!أجل

329
00:16:54,210 --> 00:16:57,730
!أتوم-كن

330
00:16:55,220 --> 00:16:56,320
!اشتقتُ إليك

331
00:16:57,730 --> 00:16:59,700
ربّما افتتحوا الآن

332
00:16:59,970 --> 00:17:01,200
ينبغي أن نسرع أيضاً

333
00:17:01,600 --> 00:17:02,370
!أجل

334
00:17:05,440 --> 00:17:06,290
...ماتَ

335
00:17:06,290 --> 00:17:06,880
...شاهُ...

336
00:17:07,170 --> 00:17:08,790
!ذاتك الطاهرة

337
00:17:08,790 --> 00:17:10,340
!استمتعوا

338
00:17:12,310 --> 00:17:15,470
حسناً، لنبدأ بالتحضير حالاً

339
00:17:16,290 --> 00:17:16,920
انتظروا لحظة

340
00:17:16,920 --> 00:17:18,220
عليّ إخراج هذا أولاً

341
00:17:18,220 --> 00:17:19,910
ما هو؟

342
00:17:19,910 --> 00:17:21,830
لكن علينا إنهاء هذا الأمر بسرعة

343
00:17:22,460 --> 00:17:25,730
لم أحضر شهاباً

344
00:17:26,210 --> 00:17:27,650
،دون لباسي الدّاخلي الجالب للحظّ

345
00:17:27,990 --> 00:17:29,870
لن أتحلّى بالثِّقة بقدرتي على القيامِ بهذا

346
00:17:31,070 --> 00:17:35,240
—من دونه، على ذلك المسرح الضخم

347
00:17:35,240 --> 00:17:37,570
هذا ليس سوى علاجاً مُزيّفاً

348
00:17:38,260 --> 00:17:40,320
،حتّى من دون شهاب

349
00:17:40,320 --> 00:17:42,690
،حتّى من دون لِباسك الدّاخلي الجالب للحظّ

350
00:17:42,690 --> 00:17:46,660
!تبقى شهاب ماجي 4 المفترس

351
00:17:47,590 --> 00:17:48,810
!هذا صحيح

352
00:17:48,810 --> 00:17:50,040
!أجل، ثِق بنا

353
00:17:52,630 --> 00:17:55,890
!يا شباب... شكراً لكم

354
00:18:20,450 --> 00:18:22,780
هل أنتم متفاجئون من وصولنا إلى المسرح
بعد يونيكورن؟

355
00:18:23,330 --> 00:18:28,910
!سندفئ أجواء المسرح لأجل ماجي 4

356
00:18:28,910 --> 00:18:31,240
لكن توخّين الحذر يا أميرات

357
00:18:31,240 --> 00:18:33,500
لا تحرقن أنفسكن إن أصبحت الأجواء حارّة جدّاً

358
00:18:33,870 --> 00:18:38,130
من الصّباح حتّى المساء، كلّ الحبّ لكُنّ

359
00:18:38,130 --> 00:18:40,170
!شكراً لكم

360
00:18:44,170 --> 00:18:46,330
صرنا في سماء طوكيو تقريباً الآن

361
00:18:46,330 --> 00:18:48,080
،الأجواء هادئة إلى حدٍّ مخيفٍ هنا فوق الغيوم

362
00:18:48,080 --> 00:18:51,000
رُغم أنّه يوجد إعصار تحتنا

363
00:18:51,510 --> 00:18:55,650
لكن يا روي، لا أصدِّق إلى الآن أنّك
رسمتَ خطّةً سخيفةً كهذه

364
00:18:56,790 --> 00:18:59,150
يعزو كلّ الفضل إلى وجودي معك أيّها السّخيف

365
00:19:02,080 --> 00:19:03,550
هل سنصلُ على الموعد؟

366
00:19:03,550 --> 00:19:05,970
حساباتي لا تخيب أبداً

367
00:19:05,970 --> 00:19:08,650
!ها هي ذي! عين الإعصار

368
00:19:09,330 --> 00:19:11,790
هل أنتم جادّون؟

369
00:19:11,790 --> 00:19:13,590
لن أتحمّل مسؤوليّة هذا

370
00:19:22,240 --> 00:19:23,140
عُلِم

371
00:19:25,890 --> 00:19:27,140
كلّ شيء على ما يُرام

372
00:19:28,690 --> 00:19:30,060
يسير كلّ شيء وفق الخطّة

373
00:19:30,800 --> 00:19:32,160
هل أنتم جاهزون؟

374
00:19:32,160 --> 00:19:33,520
!بالطبع

375
00:19:33,520 --> 00:19:34,190
!ها نحن ذا

376
00:19:36,970 --> 00:19:38,940
!مذهل! يروقني هذا

377
00:19:39,430 --> 00:19:41,760
!يبدو وكأنّها شُهب

378
00:19:41,760 --> 00:19:45,020
!كظهور أوّل لنا، ملأنا المسرح بالنجوم

379
00:19:45,020 --> 00:19:48,910
!اللّيلة، لنفعل شيئاً أكثر روعة

380
00:19:48,910 --> 00:19:50,770
ماذا تعني؟

381
00:19:50,770 --> 00:19:54,300
حسناً، ما رأيكم بانفجار كبير؟

382
00:19:54,300 --> 00:19:55,390
انفجار كبير؟

383
00:19:55,390 --> 00:19:57,180
!كان بداية الكون

384
00:19:57,180 --> 00:19:58,270
!يبدو ممتعاً

385
00:19:58,270 --> 00:20:00,920
هل سنصنعُ كوناً إذاً؟

386
00:20:00,920 --> 00:20:04,470
!أجل! انفجار كبير ناشئ من قبلة

387
00:20:04,760 --> 00:20:05,570
بقي 10 ثوان

388
00:20:05,570 --> 00:20:07,260
جاري الانتقال لنمط الطيران

389
00:20:07,260 --> 00:20:08,390
تفعيل بطّاريات المحرّك

390
00:20:08,930 --> 00:20:11,330
...ستّة، خمسة، أربعة

391
00:20:11,330 --> 00:20:13,310
كافّة الأنظمة جاهزة

392
00:20:11,840 --> 00:20:15,520
!ثلاثة، اثنان، واحد... إقلاع

393
00:22:10,570 --> 00:22:12,370
!أيُّها العناقيد

394
00:22:12,370 --> 00:22:16,270
ألم تكن افتتاحيّتنا مذهلة؟

395
00:22:16,930 --> 00:22:19,140
هل تلهّفتُم لظهورنا أثناء غيابنا؟

396
00:22:19,140 --> 00:22:22,270
!لا تشيحوا بأنظاركم عن المسرح

397
00:22:23,090 --> 00:22:25,460
سبب قدرتنا على التواجدِ هنا يعزو إلى

398
00:22:25,460 --> 00:22:26,930
،فرقة يونيكورن الصّغار

399
00:22:27,650 --> 00:22:29,460
،ولاغرانجي بوينت

400
00:22:30,880 --> 00:22:34,580
!والأهمّ من ذلك كلّه، يعزو إليكم يا عناقيد النجوم

401
00:22:35,950 --> 00:22:42,260
هل يمكننا الاعتماد عليكم جميعاً
في البقاءِ معنا للأبد؟

402
00:22:42,980 --> 00:22:44,920
مهما حلّقنا عالياً أو ذهبنا بعيداً؟

403
00:22:45,360 --> 00:22:47,510
!نحن مارجينال 4

404
00:23:32,580 --> 00:23:37,220
!قبلة واحدة إلى أبعد أصقاع المجرّة

405
00:23:37,220 --> 00:23:39,620
!بكلِّ سرور