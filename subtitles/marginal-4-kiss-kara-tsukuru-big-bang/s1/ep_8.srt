1
00:00:04,000 --> 00:00:09,170
!قبلة واحدة إلى أبعد أصقاع المجرّة

2
00:00:09,170 --> 00:00:11,340
!بكلّ سرور

3
00:01:53,600 --> 00:01:55,420
مات ضابط شرطة

4
00:01:55,420 --> 00:01:58,010
!قدّموا تعازيكم للرقيب أوساكابي شون

5
00:02:02,460 --> 00:02:04,870
...لم يكن مجرّد رجل علّمَني فحسب

6
00:02:04,870 --> 00:02:07,270
كان شريكي أيضاً

7
00:02:07,730 --> 00:02:10,880
لكن أثناء عمله على قضيّةٍ ما

8
00:02:10,880 --> 00:02:12,760
أرديَ برصاصة

9
00:02:25,300 --> 00:02:26,600
!أوساكابي-سان

10
00:02:29,220 --> 00:02:30,700
،منذ اثني عشر عاماً

11
00:02:30,700 --> 00:02:34,820
"سُرِقَتْ لوحة فنّية اسمها "ملاك البعث
من متحف

12
00:02:34,820 --> 00:02:37,070
أشيع أنّ قيمتها تساوي مئات الملايين بعملة الين

13
00:02:37,070 --> 00:02:40,880
وردَنا مؤخّراً أنّ قضيّة اللّوحة قد عادت للظهور

14
00:02:40,880 --> 00:02:42,380
واقتربَ انقشاع الغموض عن لغزها

15
00:02:42,820 --> 00:02:47,380
أثناء تحقيقنا في القضيّة، كشفنا عن وجود
منظّمة لوحات فنّية واسعة النطاق

16
00:02:47,920 --> 00:02:49,790
بعد فترة ليست بطويلة، فقد أوساكابي-سان حياته

17
00:02:50,460 --> 00:02:53,400
وما زال الفاعل طليقاً في مكانٍ ما

18
00:02:54,230 --> 00:02:56,570
انتهى الأمر بأسوأ احتمال ممكن

19
00:02:56,570 --> 00:02:57,510
حضرة القائد

20
00:02:58,340 --> 00:03:04,660
ذكر أحدهم أنّ تشو-سان قد عثر ربّما
على بعض المعلومات الحسّاسة قبل وفاته

21
00:03:07,250 --> 00:03:09,280
هل سمعتَ شيئاً؟

22
00:03:09,860 --> 00:03:11,540
لا، لا شيء

23
00:03:11,540 --> 00:03:12,520
هكذا إذاً

24
00:03:13,230 --> 00:03:17,310
لم يكن من النوع الذي يتكلّم ما لم يكن متأكّداً

25
00:03:17,310 --> 00:03:19,220
لكن كان مولعاً بتدوين الملاحظات

26
00:03:20,160 --> 00:03:22,480
...دفتر الملاحظات ذاك الذي كان يحمله أينما ذهب

27
00:03:22,480 --> 00:03:24,930
إن ألقينا نظرة إليه فقد نعثر على شيء

28
00:03:25,440 --> 00:03:29,130
مع الأسف، لم يكن دفتر الملاحظات ذاك
من بين مُمتلكاته

29
00:03:29,620 --> 00:03:31,940
هكذا إذاً

30
00:03:34,310 --> 00:03:37,780
...قضيّة منظّمة اللّوحات الفنّية التي كنتُم تعملون عليها

31
00:03:37,780 --> 00:03:38,940
هل يمكنني أن أكلّف غيركم بها؟

32
00:03:38,940 --> 00:03:41,440
لا، لقد حقّقنا كلّ هذا الإنجاز

33
00:03:41,440 --> 00:03:43,200
!أريد محاولة إغلاقها بطريقة ما

34
00:03:43,440 --> 00:03:46,700
يبدو أنّك تخفي شيئاً في جعبتك في نهايةِ المطاف

35
00:03:47,980 --> 00:03:48,950
موافق

36
00:03:49,250 --> 00:03:50,510
لكن اقضِ بقيّة اليوم كإجازة

37
00:03:51,200 --> 00:03:51,990
حاضر

38
00:03:56,530 --> 00:03:59,410
...أوساكابي-سان، لماذا توجّب عليك أن

39
00:04:00,630 --> 00:04:05,090
تبّاً، كم مرّة قلتُ لك أن تناديني تشو-سان
دون أي فائدة تُذكَر؟

40
00:04:07,980 --> 00:04:08,470
أنت

41
00:04:09,690 --> 00:04:10,960
ما خطبك؟

42
00:04:10,960 --> 00:04:13,020
من الوقاحة أن تفعل هذا على قبرِ أحدهم

43
00:04:13,310 --> 00:04:17,610
من يأبه؟ أعني أنّه قبري

44
00:04:19,620 --> 00:04:20,820
ألا تفهم؟

45
00:04:20,820 --> 00:04:22,760
أنت لا تفهم بالطبع

46
00:04:22,760 --> 00:04:25,780
يبدو أنّني عدتُ إلى طبيعتي وأنا أصغر سنّاً

47
00:04:26,790 --> 00:04:29,120
هذا أنا يا أوساكابي

48
00:04:29,120 --> 00:04:30,120
تشو-سان

49
00:04:31,460 --> 00:04:35,580
عُدتَ؟" هذا مُحال أن يحدث"

50
00:04:35,580 --> 00:04:38,240
إضافة إلى ذلك، كيف لشخصٍ في سنّك
أن يكون هو؟

51
00:04:38,240 --> 00:04:40,560
تجد صعوبةً في التصديق، صحيح؟

52
00:04:40,560 --> 00:04:43,130
أظنُّني لستُ أفهم ذلك أيضاً

53
00:04:45,700 --> 00:04:50,130
عندما استفقت، وجدتُ نفسي في مكانٍ رقيق حقّاً
...إمّا البوّابة المؤدّية إلى النعيم أو الجحيم

54
00:04:50,130 --> 00:04:50,640
!لحظة

55
00:04:51,460 --> 00:04:53,100
،ارتدِ هذا أولاً

56
00:04:53,620 --> 00:04:55,730
وإلّا اعتقلتُك بتهمة الكشف عن العورة

57
00:04:55,730 --> 00:04:58,800
أنت صارمٌ كعادتك، أليس كذلك؟

58
00:04:58,800 --> 00:05:01,770
على أي حال، يبدو أنّني مُتّ

59
00:05:01,770 --> 00:05:03,910
،ظننتُ أنّني سأكون في طريقي إلى الحياةِ الآخرة

60
00:05:03,910 --> 00:05:06,740
لكن ظهرَ لاحقاً شخصٌ يُشبه ملاك البعث

61
00:05:07,790 --> 00:05:12,360
وتبيّن أنّ الأشخاص الذين لديهم شيء
يتحسّرون عليه كثيراً لا يمكنهم المتابعة إلى الحياة الآخرة

62
00:05:12,360 --> 00:05:16,620
قيل لي أنَّ أمامي 24 ساعة لتسوية الأمور

63
00:05:16,930 --> 00:05:21,340
مفاجئ، صحيح؟ الحياة الآخرة أكثر تساهلاً ممّا توقّعت

64
00:05:21,620 --> 00:05:23,460
أتتوقّع منّي تصديق ذلك؟

65
00:05:23,460 --> 00:05:26,960
حسناً، ربّما أثقل عليك كثيراً

66
00:05:28,240 --> 00:05:31,940
أعني أنّك من النوع الذي يفسِّر قيام
فتاة مدرسة ثانويّة بإعطاء

67
00:05:31,940 --> 00:05:35,570
صديقها سكّرة على أنّه تجارة مخدّرات

68
00:05:36,380 --> 00:05:37,390
!وما أدراك بذلك؟

69
00:05:39,370 --> 00:05:43,070
في كافّة الأحوال، لا أستطيع الموت هكذا
حتّى لو حاولت

70
00:05:43,070 --> 00:05:47,410
مع أنّني ميّت أصلاً لكن لا يمكنني
الرّقود بسلام

71
00:05:47,410 --> 00:05:51,030
لذا يا يوكيتو، ساعدني حتّى نقبض على الفاعل

72
00:05:52,430 --> 00:05:55,840
تبّاً، أريدُ الانتقام لأوساكابي-سان

73
00:05:55,840 --> 00:05:58,340
لكن لا أظنّني أصدِّق ما قلتَه

74
00:05:59,380 --> 00:06:02,460
على أي حال، سأساعدك حاليّاً

75
00:06:02,460 --> 00:06:04,390
حسناً، اتّفقنا إذاً

76
00:06:04,390 --> 00:06:08,180
لكن أولاً... لنأكل شيئاً ما

77
00:06:15,190 --> 00:06:16,770
!أهلاً بعودتك

78
00:06:16,990 --> 00:06:17,830
!مرحباً

79
00:06:18,750 --> 00:06:19,990
معك ضيف؟

80
00:06:19,990 --> 00:06:21,410
شيء من هذا القبيل

81
00:06:23,990 --> 00:06:25,530
!شكراً على الطعام

82
00:06:25,920 --> 00:06:27,600
هل كان لذيذاً؟

83
00:06:27,600 --> 00:06:29,370
!أجل، كان كذلك

84
00:06:29,370 --> 00:06:30,760
طمأنتَني

85
00:06:31,560 --> 00:06:34,410
عليّ تتبيل كلّ شيء تتبيلاً خفيفاً بسببي

86
00:06:34,710 --> 00:06:35,850
لا مُشكلة

87
00:06:35,850 --> 00:06:39,670
فهذا يلائم عجوزاً مثلي تماماً

88
00:06:40,480 --> 00:06:41,130
عجوز؟

89
00:06:41,130 --> 00:06:42,890
!شكراً على الطعام

90
00:06:43,460 --> 00:06:47,660
آسف يا ماساكي، ثمّة أمور علينا مناقشتها الآن

91
00:06:47,660 --> 00:06:49,470
فهمت

92
00:06:49,470 --> 00:06:52,050
سأدرس في الغرفة الأخرى فحسب

93
00:06:52,930 --> 00:06:56,770
لكن إن أردتُما بعضاً من الشاي فلا تتردّدا
عن مُناداتي رجاء

94
00:07:00,120 --> 00:07:03,980
كنتُ أعلم أنّ لديك أخ، لكن أهو مريض؟

95
00:07:04,770 --> 00:07:05,610
أجل

96
00:07:07,650 --> 00:07:09,030
لستُ بحاجةٍ لأي شفقة

97
00:07:09,940 --> 00:07:13,490
أنوي كسب ما يكفي لتسديدِ نفقات
علاجه يوماً ما

98
00:07:14,000 --> 00:07:16,200
هكذا إذاً، افعل ما بوسعك

99
00:07:16,200 --> 00:07:17,870
لستُ بحاجةٍ لتخبرني بذلك

100
00:07:17,870 --> 00:07:19,600
معك حقّ على ما أعتقد

101
00:07:19,600 --> 00:07:21,540
لندخل صلبَ الموضوع إذاً

102
00:07:21,540 --> 00:07:24,640
لكن قبل أن نبدأ، هل لديك دفتر مُلاحظات أو ما شابه؟

103
00:07:24,640 --> 00:07:27,010
فذاكرتي ضعيفة جدّاً

104
00:07:27,010 --> 00:07:28,510
أشعر بشعور أفضل عندما أدوّن الملاحظات

105
00:07:31,580 --> 00:07:32,790
ما الأمر؟

106
00:07:33,860 --> 00:07:35,800
لا شيء

107
00:07:37,380 --> 00:07:40,980
لمعلوماتِك فقط، لا أتذكّر شيئاً عن تلقّيي رصاصة

108
00:07:41,600 --> 00:07:43,450
عندما استفقت، وجدتُ نفسي ميّتاً

109
00:07:43,450 --> 00:07:46,440
أعتقد أنّ وصف الأمر بهذا الشكل غريب بعض الشيء

110
00:07:47,290 --> 00:07:48,980
،السّلاح الناري الذي استُخدِمَ مجهول

111
00:07:48,980 --> 00:07:51,980
.حتّى بعد تحليل آثار التحزيز على الرّصاصة

112
00:07:51,980 --> 00:07:55,240
احتسبَ الفاعل لكلّ شيء

113
00:07:55,670 --> 00:07:57,820
،عُثِرَ على جثّتِك بالقرب من البحر

114
00:07:57,820 --> 00:08:00,960
لكن نعتقد أنّك تلقّيتَ رصاصة في مكانٍ آخر

115
00:08:00,960 --> 00:08:03,040
لم تكن هنالك أي أدلّة أخرى

116
00:08:03,040 --> 00:08:04,210
...بالمناسبة يا أوساكابي-سان

117
00:08:04,210 --> 00:08:07,030
أتصدّقني الآن إذاً؟

118
00:08:09,440 --> 00:08:11,530
الشابّ الذي يطلق على نفسِه أوساكابي

119
00:08:11,530 --> 00:08:12,610
فكّرتُ في أن أسألك

120
00:08:12,610 --> 00:08:15,680
!نعم، اسأل

121
00:08:16,310 --> 00:08:22,660
قال القائد إيزومي أنَّ الرّقيب أوساكابي قد داس
على رصاصةٍ قبل أن يموت

122
00:08:22,660 --> 00:08:24,270
هل لديك معلوماتٌ عن ذلك؟

123
00:08:24,270 --> 00:08:26,730
آسف، لا أملك أدنى فكرة

124
00:08:27,900 --> 00:08:31,930
العودة للحياةِ أمر عظيم، لكن ذاكرتي ضبابيّة جدّاً

125
00:08:31,930 --> 00:08:33,540
لكن سنتدبّر الأمر

126
00:08:34,760 --> 00:08:36,100
...لذا يا يوكيتو

127
00:08:36,870 --> 00:08:39,440
لطالما أخبرتُك، أليس كذلك؟

128
00:08:39,440 --> 00:08:41,250
لا تهدر الوقت في حكِّ رأسك والتفكير، تحرّك

129
00:08:41,530 --> 00:08:42,980
هذا ينطبق على هذه اللّحظة أيضاً

130
00:08:44,220 --> 00:08:47,360
"لا بدَّ وأنَّ المفتاح هو تلك اللّوحة "ملاك البعث

131
00:08:47,360 --> 00:08:51,350
أنا متأكّدٌ أنّها ستقودنا إلى الفاعل

132
00:08:52,420 --> 00:08:55,110
لقد مُنِحنا 24 ساعة

133
00:08:55,110 --> 00:08:58,090
استهلكنا منها حوالي ستّ ساعات حتّى الآن

134
00:08:58,090 --> 00:09:00,600
موعدنا النّهائي هو السّادسة من مساء الغدّ

135
00:09:00,600 --> 00:09:04,400
علينا إنهاء هذه القضيّة قبل ذلك الحين، اتّفقنا؟

136
00:09:04,400 --> 00:09:05,840
اتّفقنا

137
00:09:06,610 --> 00:09:09,280
سألعب دوري حتّى مساء الغد

138
00:09:09,280 --> 00:09:10,700
في تمثيليّتك

139
00:09:10,700 --> 00:09:11,860
حُسِمَ الأمر إذاً

140
00:09:11,860 --> 00:09:14,700
!لنعد إلى العملِ يا شريكي

141
00:09:14,700 --> 00:09:15,680
أنا متحمِّس للغاية

142
00:09:15,680 --> 00:09:17,350
...ليس رغبةً منّي بهذا، لكن

143
00:09:19,600 --> 00:09:22,860
تريد دخول مقرّ المنظّمة مباشرة؟

144
00:09:22,860 --> 00:09:24,380
الوقت يداهمنا

145
00:09:24,380 --> 00:09:27,870
إضافة إلى أنَّ كافّة اللوحات الفنّية
المسروقة في هذا البلد تمرُّ من خلالهم

146
00:09:28,290 --> 00:09:30,270
لا توجد أي استثناءات عمليّاً

147
00:09:31,380 --> 00:09:32,980
ثِق بالخبراء

148
00:09:32,980 --> 00:09:34,630
إن كان هناك من يعلَم فهُم هؤلاء الناس، صحيح؟

149
00:09:35,320 --> 00:09:37,250
رغم أنَّنا لا نملك ضمانة؟

150
00:09:39,660 --> 00:09:42,480
نحن من رجال الشرطة، لنتكلّم

151
00:09:42,480 --> 00:09:45,770
سمِعنا ما حدثَ بشأن أوساكابي-سان

152
00:09:46,390 --> 00:09:48,100
نالَ ما يستحقّ

153
00:09:48,100 --> 00:09:49,240
!ماذا قلت للتو؟

154
00:09:49,240 --> 00:09:50,150
...لا تقل لي أنّكم

155
00:09:50,150 --> 00:09:53,320
مهلاً مهلاً، أتلمّح إلى أنَّنا فعلنا ذلك؟

156
00:09:54,740 --> 00:09:58,160
على النقيض، نحن الضحايا هنا

157
00:09:58,160 --> 00:10:00,280
ضحايا؟

158
00:10:00,280 --> 00:10:06,710
لم تسمع شيئاً من أوساكابي-سان؟

159
00:10:06,710 --> 00:10:10,670
كلّ ما في الأمر أنّه لم يثق بك

160
00:10:10,670 --> 00:10:11,170
المعذرة

161
00:10:11,170 --> 00:10:12,440
!هذا غير صحيح

162
00:10:12,440 --> 00:10:15,360
!حريّ بك أن تصون لسانك أيّها الشرّير

163
00:10:17,330 --> 00:10:19,460
يكفي، كاين، شيون

164
00:10:20,380 --> 00:10:22,050
إنّهما ضيفانا

165
00:10:22,580 --> 00:10:23,350
حسناً

166
00:10:23,920 --> 00:10:25,600
حاضر سيّدي

167
00:10:26,870 --> 00:10:27,560
من هذا؟

168
00:10:27,940 --> 00:10:30,770
إنّه... جديد. لا تقلق بشأنه

169
00:10:31,230 --> 00:10:33,970
يبدو أنّ عليكما الانتباه لكلامكما

170
00:10:35,090 --> 00:10:38,580
حسناً، لماذا تقول أنّك الضحيّة؟

171
00:10:38,580 --> 00:10:40,190
تعرّضنا لسرقة

172
00:10:40,190 --> 00:10:46,030
منظّمتنا استوردت "ملاك البعث" من خارج البلاد

173
00:10:47,450 --> 00:10:50,800
كنّا ننوي عرضها على المزادِ العلني
في إحدى نشاطاتنا

174
00:10:50,800 --> 00:10:52,220
مزاد غير قانوني

175
00:10:52,220 --> 00:10:53,420
كما تشاء

176
00:10:53,890 --> 00:10:55,460
،وهذا أمر محرج

177
00:10:55,460 --> 00:10:59,060
لكن الحاوية بأكملها التي كانَتْ فيها اللّوحة
قد سُرِقَتْ أثناء الشحن

178
00:10:59,060 --> 00:11:00,380
هذا ما حدث

179
00:11:00,640 --> 00:11:04,290
معنى هذا إذاً أنَّ اللوحة من المُمكِن أن تكون قد بيعَتْ؟

180
00:11:04,290 --> 00:11:06,680
هذا غير ممكن

181
00:11:07,250 --> 00:11:12,150
دائماً ما نضع بضاعتنا في حاوياتٍ خاصّة للنقل

182
00:11:12,150 --> 00:11:16,760
إنّها مُقفَلة تماماً ولن تُفتَح
قبل أن يحين الوقت المُناسب

183
00:11:16,760 --> 00:11:21,280
والعبث بالقفل سيُطلِق مواداً كيميائيّة
تُفقِد اللّوحة قيمتها تماماً

184
00:11:22,360 --> 00:11:25,530
!حاوية؟ هذا صحيح، الحاوية

185
00:11:26,690 --> 00:11:29,630
!ما الأمر؟ تمالك نفسك

186
00:11:29,630 --> 00:11:32,600
آه نعم... آسف، أنا بخير

187
00:11:32,600 --> 00:11:33,830
تبّاً

188
00:11:35,250 --> 00:11:40,270
قلتَ "الوقت المناسب". هل هذا يعني أنّه قفل زمني؟

189
00:11:40,270 --> 00:11:40,840
أجل

190
00:11:41,600 --> 00:11:42,870
متى سيُفتَح؟

191
00:11:42,870 --> 00:11:45,220
غداً في السّادسة مساء

192
00:11:45,790 --> 00:11:49,410
أريدك أن تفهم أنَّنا نحن الضحايا هنا يا حضرة المحقّق

193
00:11:49,410 --> 00:11:52,690
أرجو أن تعثر على لوحتِنا لأجلِنا

194
00:11:52,690 --> 00:11:56,170
سأعثر عليها، لكن ليس لأجلِكم

195
00:11:56,750 --> 00:11:58,900
وذلك كي لا تذهب جهود أوساكابي-سان سُدى

196
00:12:02,750 --> 00:12:03,570
تعقّباهما

197
00:12:03,850 --> 00:12:05,530
لعلّهما يعرفان شيئاً

198
00:12:13,620 --> 00:12:16,400
ماذا كانت تلك يا أوساكابي-سان؟ تلك الحاوية؟

199
00:12:16,400 --> 00:12:18,720
!قلتُ لك أنّه تشو-سان

200
00:12:18,720 --> 00:12:21,280
تبّاً، يحتاج عقلي للطاقة

201
00:12:21,280 --> 00:12:22,340
خذني إلى ذلك المكان

202
00:12:22,850 --> 00:12:23,970
ذلك المكان؟

203
00:12:23,970 --> 00:12:26,340
!المكان الذي نذهبُ إليه دوماً. بسرعة

204
00:12:31,160 --> 00:12:32,610
!هذا هو المذاق

205
00:12:32,610 --> 00:12:34,440
!أنا مسرورٌ لأنّني عدتُ للحياة

206
00:12:35,300 --> 00:12:37,380
على أي حال، ماذا كان ذلك؟

207
00:12:40,410 --> 00:12:41,400
تذكّرت

208
00:12:41,740 --> 00:12:43,820
...جيّد، لكن وجهك

209
00:12:45,780 --> 00:12:50,790
نعم، أتذكّر أنّني تحدثتُ مع راندو عن الحاوية

210
00:12:50,790 --> 00:12:53,530
وكنتُ ربّما أحاول إيجادها

211
00:12:54,430 --> 00:12:55,470
ربّما؟

212
00:12:56,500 --> 00:12:59,530
،ما زلتُ لم أستعد ذاكرتي تماماً بعد

213
00:13:00,460 --> 00:13:02,840
لكن تذكّرتُ دليلاً مهمّاً

214
00:13:04,810 --> 00:13:06,340
عنوان بريد الكتروني؟

215
00:13:06,760 --> 00:13:08,790
إنّها معلومات اتّصال شاهد عيان

216
00:13:09,440 --> 00:13:10,760
ربّما شاهد على تلك الحاوية

217
00:13:14,900 --> 00:13:15,600
أجل، رأيتها

218
00:13:15,990 --> 00:13:18,250
وقد تكلّمتُ مع هذا المحقّق الرّائع

219
00:13:18,250 --> 00:13:19,270
أليس كذلك يا يو؟

220
00:13:19,270 --> 00:13:19,860
أجل

221
00:13:20,360 --> 00:13:21,870
وماذا كان نوع السيّارة؟

222
00:13:21,870 --> 00:13:24,100
كانت كبيرة بعض الشيء؟

223
00:13:24,100 --> 00:13:26,780
مثل التي نراها في الأفلام الأجنبيّة أحياناً

224
00:13:27,060 --> 00:13:30,530
كسيّارة مصفّحة؟

225
00:13:30,530 --> 00:13:31,790
!أجل

226
00:13:31,790 --> 00:13:33,030
وإلى أين اتّجهت؟

227
00:13:33,030 --> 00:13:36,300
رأيناها تدخل المستودع 4 عند المرفأ

228
00:13:37,000 --> 00:13:38,720
بدأتُ أتذكّر

229
00:13:38,720 --> 00:13:41,880
...نعم، أتيتُ إلى هنا ومن ثمّ

230
00:13:42,240 --> 00:13:43,170
ومن ثمّ؟

231
00:13:44,860 --> 00:13:46,470
،وفقاً لكلام ذلكما الصغيرين

232
00:13:46,470 --> 00:13:48,900
لم يكن هنالك سوى شخصاً واحداً في السيّارة

233
00:13:48,900 --> 00:13:52,330
ربّما يكون الفاعل الذي سرقَ اللّوحة
...والشخص الذي

234
00:13:52,330 --> 00:13:54,310
قتلَ أوساكابي-سان

235
00:13:58,210 --> 00:13:59,400
هيّا بنا

236
00:14:04,460 --> 00:14:06,280
هذا قفلٌ جديد

237
00:14:09,360 --> 00:14:12,200
أنا واثقٌ أنّني فعلتُ هذا من قبل أيضاً

238
00:14:13,080 --> 00:14:14,080
أوساكابي-سان؟

239
00:14:19,360 --> 00:14:21,260
هذا دخول غير قانوني

240
00:14:21,260 --> 00:14:23,510
لا أمانع هروبك

241
00:14:23,510 --> 00:14:25,540
سأرحل عمّا قريب

242
00:14:25,540 --> 00:14:26,670
تبّاً

243
00:14:27,330 --> 00:14:28,860
لا أحسّ بوجود أحد

244
00:14:28,860 --> 00:14:31,200
ربّما قُتِلتُ هنا

245
00:14:31,200 --> 00:14:32,640
احترس

246
00:14:33,710 --> 00:14:34,530
نعم

247
00:14:38,230 --> 00:14:39,670
مفاجأة

248
00:14:40,760 --> 00:14:42,480
،تمكّن من سرقة السيّارة

249
00:14:42,770 --> 00:14:44,500
لكن لم يستطع العبث بالقفل

250
00:14:44,500 --> 00:14:48,240
لهذا وضعَها هنا منتظراً إيّاها حتّى تنفتح

251
00:14:48,600 --> 00:14:50,520
يمكننا انتظاره هنا

252
00:14:50,520 --> 00:14:55,060
أجل، لكن ربّما أكون قد رحلت قبل أن يصل
الفاعل إلى هنا

253
00:14:55,060 --> 00:14:59,580
لا أمانع أن ترحلا معاً إلى الحياةِ الآخرة

254
00:15:01,060 --> 00:15:02,440
راندو

255
00:15:02,440 --> 00:15:04,250
هل كنتَ تتعقّبنا؟

256
00:15:04,540 --> 00:15:05,990
شكراً لعملكما الشاقّ

257
00:15:05,990 --> 00:15:09,420
والآن يبدو أنّني سأتمكّن من استعادةِ اللّوحة

258
00:15:10,150 --> 00:15:12,660
أتظنّنا سنسلّمك إيّاها ببساطة؟

259
00:15:12,660 --> 00:15:14,440
هذه مشكلة

260
00:15:14,440 --> 00:15:17,510
يُقال أنَّ هذه القطعة تساوي مئات الملايين

261
00:15:17,510 --> 00:15:21,600
مات أناسٌ لأجلِ هذه اللّوحة

262
00:15:22,980 --> 00:15:25,200
،إن لم نستطع التوصُّل لاتِّفاق

263
00:15:25,200 --> 00:15:26,980
فنحن مستعدُّون كذلك

264
00:15:28,150 --> 00:15:29,050
إلى اليسار

265
00:15:29,050 --> 00:15:29,610
حسناً

266
00:15:29,610 --> 00:15:30,900
!انطلق

267
00:15:33,260 --> 00:15:34,320
...عدوّ سيّدي

268
00:15:34,650 --> 00:15:35,640
!مُت

269
00:15:35,640 --> 00:15:37,520
قُضي عليك أيضاً

270
00:15:50,260 --> 00:15:51,260
...أنت

271
00:15:53,470 --> 00:15:57,180
!إصبع الزناد خاصّتك متهيّج كعادته

272
00:16:03,890 --> 00:16:05,690
لا نملك خياراً آخر

273
00:16:05,690 --> 00:16:08,270
حان وقتُ الجدّية

274
00:16:08,920 --> 00:16:10,570
...أوساكابي-سان

275
00:16:13,780 --> 00:16:15,950
!ها أنا قادم

276
00:16:33,120 --> 00:16:34,050
!شيون

277
00:16:42,820 --> 00:16:45,660
استسلم يا راندو، ربِحنا

278
00:16:47,060 --> 00:16:48,470
ماذا ستفعل الآن؟

279
00:16:48,470 --> 00:16:50,190
!إن أردت، يمكننا أن نلعب هذه اللّعبة طوال اليوم

280
00:16:51,460 --> 00:16:53,940
هل ستطلق سراحهما إن هدأتُ أنا؟

281
00:16:53,940 --> 00:16:58,510
أجل، لن أعتبر هذا أكثر من مجرّد عرقلة للعدالة

282
00:16:58,510 --> 00:17:00,120
!لكن عليكم الخروج من هنا، وحالاً

283
00:17:02,340 --> 00:17:04,330
حسناً، هيّا بنا

284
00:17:05,060 --> 00:17:06,170
...سيّدي

285
00:17:11,690 --> 00:17:12,840
سأقتلك يوماً ما

286
00:17:13,220 --> 00:17:16,980
إن تمكّنتَ من ذلك قبل أن أنتقل
للحياة الآخرة فأتمنّى لك حظّاً طيّباً

287
00:17:27,330 --> 00:17:31,830
تبّاً، كما أتذكّر تماماً، تكون متهوّراً أحياناً

288
00:17:32,650 --> 00:17:35,820
ومهاراتك في المبارزةِ بالسّيف حادّة كما أتذكّرها

289
00:17:36,070 --> 00:17:42,060
أعادني هذا للذكرياتِ عندما كنّا شريكين أوّل مرّة

290
00:17:42,060 --> 00:17:44,850
في ذلك الوقت اقتحمتَ وانتهى الأمر
بيننا باشتباكٍ ناريّ بالطبع

291
00:17:44,850 --> 00:17:48,040
ممّا أجبرنا ذلك على حلّ المسألة بمفردنا بطريقةٍ ما

292
00:17:49,520 --> 00:17:53,060
أجل، كنّا فريقاً جيّداً

293
00:17:53,060 --> 00:17:56,360
لماذا قتلتني إذاً؟

294
00:17:57,010 --> 00:17:59,390
كنتَ أنتَ من قتلني، صحيح؟

295
00:17:59,610 --> 00:18:02,460
أ-أي دعابة هي هذه؟

296
00:18:02,460 --> 00:18:03,260
ولماذا أقتلك؟

297
00:18:04,160 --> 00:18:08,600
تلك السيّارة هي نموذج مخصّص بحسبِ طلب راندو

298
00:18:08,600 --> 00:18:12,020
سيّارة فان غريبة صُمِّمَتْ خصّيصاً لنقل
...الأشياء الثّمينة

299
00:18:12,020 --> 00:18:18,070
ظللتُ أنا وراندو نسمِّي وحدة النقل بالحاوية

300
00:18:18,860 --> 00:18:24,040
ينبغي لذلك أن يستحضر صورةَ شاحنة نقل
عاديّة في الذهن

301
00:18:24,450 --> 00:18:30,720
لكنّك قلتَ تحديداً "سيّارة مصفَّحة" عندما تكلّمتَ
مع ذلكما الصّغيرين

302
00:18:30,720 --> 00:18:31,710
لماذا؟

303
00:18:32,500 --> 00:18:33,750
—هذا مجرّد تفصيل ثانوي

304
00:18:33,750 --> 00:18:35,230
هذا ليس كلّ شيء

305
00:18:35,230 --> 00:18:37,570
تذكّرتُ كلّ شيء

306
00:18:37,570 --> 00:18:41,180
تذكّرتُ مثلاً من كان في قائمة المشتبهين خاصّتي
عندما كنتُ على قيدِ الحياة

307
00:18:41,690 --> 00:18:44,660
...أوساكابي-سان، لا تقل لي أنّ

308
00:18:57,040 --> 00:18:59,200
أظنّك عرفت، صحيح؟

309
00:19:02,650 --> 00:19:06,610
أجل، كنتُ أنا من سرقَ اللّوحة

310
00:19:06,610 --> 00:19:08,550
كنتَ تطمع بالمال؟

311
00:19:08,550 --> 00:19:14,620
أجل، أحتاج لمالٍ لإجراءِ عمليّةٍ جراحيّة لأخي

312
00:19:15,200 --> 00:19:18,130
لكن لا أحد يعلم متى أجريها إذا اعتمدتُ
على راتبِ محقِّق فقط

313
00:19:18,770 --> 00:19:22,960
حتّى ظهرَتْ تلك اللّوحة أمامي

314
00:19:23,880 --> 00:19:29,970
ظننتُ أنَّ الفُرصة قد أتيحَتْ لي

315
00:19:30,770 --> 00:19:32,960
لكنّك لاحظت

316
00:19:32,960 --> 00:19:33,860
!لهذا السّبب

317
00:19:34,910 --> 00:19:37,060
لماذا عدت؟

318
00:19:37,950 --> 00:19:40,820
أنا مضطرٌّ لقتلِك مجدّداً

319
00:19:44,340 --> 00:19:45,620
هكذا إذاً

320
00:19:47,130 --> 00:19:50,910
أنتَ هو الفاعل حقّاً إذاً

321
00:19:52,270 --> 00:19:54,340
يا لك من ساذج

322
00:19:54,850 --> 00:19:57,700
هل صدّقتَ رواية البعث؟

323
00:19:57,700 --> 00:19:59,830
أصدّقتَ شيئاً خياليّاً كهذا؟

324
00:19:59,830 --> 00:20:02,900
أنا لستُ أوساكابي

325
00:20:02,900 --> 00:20:03,930
أنا ابن أخيه

326
00:20:05,530 --> 00:20:10,400
بعد أن سمعتُ بنبأ تلقّيه رصاصة مباشرة
تلقّيتُ رسالة

327
00:20:11,020 --> 00:20:15,930
،هكذا اكتشفتُ أنَّ عمّي اشتبه بك

328
00:20:15,930 --> 00:20:20,150
وأنّه كان محتسباً لاحتمال موته

329
00:20:21,190 --> 00:20:26,920
كان عمِّي يعتني بي منذُ وفاةِ أبي باكراً

330
00:20:27,390 --> 00:20:32,420
لهذا قرّرتُ أن أعرف كلّ تفصيلٍ دقيق
من وصيّتِه إن شئتَ أن تسمّيها بذلك

331
00:20:32,420 --> 00:20:34,660
دفتر مُلاحظاته ذاك

332
00:20:35,250 --> 00:20:37,490
قرّرتُ أن أصبح عمِّي كي أكشف جرائمك

333
00:20:38,340 --> 00:20:40,800
كان ذلك أداء رائعاً إذاً

334
00:20:40,800 --> 00:20:43,700
في النِّهاية، حتّى أنا صدّقتُه

335
00:20:43,700 --> 00:20:45,130
لكن انتهت المسرحيّة

336
00:20:45,130 --> 00:20:46,360
هذه نهايتك

337
00:20:46,360 --> 00:20:47,930
!انتهى مصيرك كمصير أوساكابي-سان

338
00:20:47,930 --> 00:20:50,180
أخشى أن أقول أنَّ المسرحيّة انتهت بالنسبة إليك
يا حضرة المحقِّق

339
00:20:52,750 --> 00:20:54,350
سمعنا كلّ شيء

340
00:20:55,380 --> 00:20:58,100
هذا مؤسفٌ حقّاً يا يوكيتو

341
00:20:59,820 --> 00:21:01,390
مستحيل

342
00:21:01,390 --> 00:21:03,310
،بعدما حصلتُ على دفترِ المُلاحظات

343
00:21:03,310 --> 00:21:06,330
ناقشتُ أمره مع إيزومي-سان
ورسمنا هذه الخطّة معاً

344
00:21:06,330 --> 00:21:10,270
خطّة لجعلِك تعترف بجريمةٍ لم نمتلك
أدنى دليل لإثباتها

345
00:21:44,110 --> 00:21:48,910
لطالما كان عمّي يستمتع كلّما حدّثني عنك

346
00:21:49,450 --> 00:21:51,840
قال أنّه أرادنا أن نلتقي

347
00:21:52,390 --> 00:21:54,620
وأنّنا ربّما سننسجم معاً

348
00:21:55,050 --> 00:21:59,300
بالفعل، قضينا وقتاً ممتعاً معاً

349
00:21:59,960 --> 00:22:02,300
رغم أنّه كان 24 ساعة فقط

350
00:22:17,100 --> 00:22:20,320
برأيي كان ممتعاً للغاية

351
00:22:20,320 --> 00:22:24,480
أجل! كان التمثيل رائعاً أيضاً يا أتوم-كن، وروي-كن

352
00:22:24,480 --> 00:22:27,970
جميل، جميل! ردود الأفعال في سكيتر جيّدة أيضاً

353
00:22:27,970 --> 00:22:30,070
راسلَتْنا مديرتنا أيضاً

354
00:22:30,070 --> 00:22:31,740
!قالَتْ أنّنا أحسنّا صنعاً

355
00:22:31,740 --> 00:22:33,560
آمل أن نكرّر هذا مجدّداً

356
00:22:33,560 --> 00:22:34,940
أعني عرضاً كهذا

357
00:22:34,940 --> 00:22:36,080
!أجل

358
00:22:36,080 --> 00:22:39,580
الحلقة 8

359
00:23:36,640 --> 00:23:37,520
:الحلقة القادمة
"تذكُّر كامبريا في الصّيف"

360
00:23:37,520 --> 00:23:39,810
الحلقة القادمة