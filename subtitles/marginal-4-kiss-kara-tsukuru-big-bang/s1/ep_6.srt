1
00:00:04,830 --> 00:00:06,310
!وجدتُها

2
00:00:07,250 --> 00:00:10,610
مجلّة ألعاب تبادل الأدوار صدرت اليوم وسأحصل
عليها في أوّل الصباح

3
00:00:11,150 --> 00:00:12,190
وجدتُ مجلّتي أيضاً

4
00:00:13,860 --> 00:00:15,930
أتوم-كن؟

5
00:00:16,790 --> 00:00:18,010
انظر هنا

6
00:00:19,230 --> 00:00:22,810
لا بدَّ وأنّه أجريتْ له مقابلة

7
00:00:22,810 --> 00:00:26,120
هذا غريب، لم أسمع شيئاً من مديرتنا

8
00:00:32,260 --> 00:00:36,010
!الكشف عن حبِّ كيريهارا أتوم الشّغوف"؟"

9
00:00:38,530 --> 00:00:43,700
!قبلة واحدة إلى أبعد أصقاع المجرّة

10
00:00:43,700 --> 00:00:45,880
!بكلِّ سرور

11
00:02:16,990 --> 00:02:20,490
الحلقة 6

12
00:02:21,760 --> 00:02:28,290
فرقة المغنّيين النجوم التي تكتسب"
"...شعبيّتها بشكلٍ سريع، مارجينال 4

13
00:02:28,690 --> 00:02:34,690
كان أحد أعضائهم، كيريهارا أتوم، لا يوصل
،قبلةً إلى المجرّة فحسب

14
00:02:34,690 --> 00:02:37,970
بل إلى مطعم مشاوي كوريّة في غينزا

15
00:02:38,560 --> 00:02:39,500
!إنّهم جيّدون

16
00:02:39,500 --> 00:02:41,620
!لا وقت للاندهاش الآن

17
00:02:41,620 --> 00:02:44,740
لا أصدِّق أنَّ باراغرام وينتر قد حصلوا
على سبقٍ صحفيّ حول أتوم-كن

18
00:02:44,740 --> 00:02:47,430
لكن أهو أتوم-كن حقّاً؟

19
00:02:48,120 --> 00:02:51,920
أخشى القول أنّ هذا القميص مألوف لديّ

20
00:02:51,920 --> 00:02:54,730
يمكننا الافتراض بأن يكون هو

21
00:02:55,130 --> 00:02:58,110
يا للهول... ماذا ينبغي أن نفعل يا أل؟

22
00:02:58,410 --> 00:03:01,610
يا إلهي، سكيتر في حالةِ جنون

23
00:03:02,640 --> 00:03:06,440
مع انتشار كلّ هذه الثرثرة، أنا واثق
أنّه يعلم بالأمرِ أيضاً

24
00:03:10,530 --> 00:03:11,330
مراحب

25
00:03:16,660 --> 00:03:20,020
...أتوم-كن، إذاً هذا الشيء

26
00:03:20,020 --> 00:03:22,090
لا أدري كيف أصِف الأمر

27
00:03:23,090 --> 00:03:24,970
هل عرفتُم بهذه السرعة؟

28
00:03:25,540 --> 00:03:28,850
...أعني، أظنُّها ليست غلطتي

29
00:03:30,470 --> 00:03:32,290
—تعترف إذاً أنَّ تلك المقالة صحيحة

30
00:03:32,290 --> 00:03:36,150
!لكن تعليق حسابي في سكيتر أمر مُبالَغ به

31
00:03:38,560 --> 00:03:39,860
ماذا؟

32
00:03:39,860 --> 00:03:42,320
،في اللّيلةِ الماضية قبل الخلود إلى النّوم

33
00:03:42,320 --> 00:03:44,650
اتبعتُ حوالي ألف حسابٍ يضعُ صورَ مشويّات

34
00:03:44,650 --> 00:03:45,820
!هذا قاسٍ جدّاً

35
00:03:48,400 --> 00:03:50,040
"أعتقد أنَّ ذلك صُنِّفَ على أنّه "سبام

36
00:03:50,240 --> 00:03:52,740
!لا، ليس كذلك! إنّها مشاوي كوريّة فعليّة

37
00:03:52,740 --> 00:03:54,260
ليس هذا ما قصد

38
00:03:54,260 --> 00:03:56,900
لكن لا أستطيع العودة إلى سكيتر
ما لم يعيدوا فتح حسابي

39
00:03:56,900 --> 00:03:59,170
!روي، أخبر عناقيد النجوم أرجوك

40
00:03:59,600 --> 00:04:02,550
!قل لهم أنّني أبلي بلاء حسناً اليوم

41
00:04:03,440 --> 00:04:04,320
حسناً

42
00:04:04,320 --> 00:04:06,530
حسناً، سأغادر إلى الصفّ

43
00:04:10,210 --> 00:04:11,510
في الواقع، بحسبِ ما رأيناه

44
00:04:11,510 --> 00:04:13,740
يبدو أنّه لا يعلم بالمقالةِ بعد

45
00:04:13,740 --> 00:04:15,690
لكن هذا غريب

46
00:04:15,690 --> 00:04:21,060
عادةً ما يستقبل مكتبُنا مكالمةً
من المحرّر في حالاتٍ كهذه

47
00:04:21,820 --> 00:04:23,400
هذا ما جرى

48
00:04:23,400 --> 00:04:25,970
حاولتُ الاتّصال بمديرتنا ورئيستنا

49
00:04:25,970 --> 00:04:27,440
لكن لا أستطيع التوصُّل إلى أي منهما

50
00:04:27,440 --> 00:04:30,470
لعلّهما مشغولان كثيراً مع الصّحف

51
00:04:32,500 --> 00:04:37,040
أتساءل ما الرابط بين هذه الفتاة
وأتوم-كن

52
00:04:37,780 --> 00:04:40,250
ماذا لو كانت حبيبته؟

53
00:04:40,610 --> 00:04:43,030
فضائح كهذه محظورة تماماً على المغنّيين النجوم

54
00:04:43,700 --> 00:04:46,050
،للتكفير عن كلّ المتاعب التي تسبّبَ بها

55
00:04:46,050 --> 00:04:47,430
عليه أن يغادر المجموعة

56
00:04:47,430 --> 00:04:49,060
!لـ-لن ندعه يغادر

57
00:04:49,060 --> 00:04:49,680
!هذا مستحيل

58
00:04:49,680 --> 00:04:51,940
!هذا ليس خياراً

59
00:04:51,940 --> 00:04:55,270
هذا إذا افترضنا أنّ هذا صحيح

60
00:04:55,270 --> 00:04:56,630
!روي-كن

61
00:04:56,630 --> 00:04:58,330
أنا متأكّدٌ أنّ شخصاً مثل أتوم-كن

62
00:04:58,330 --> 00:05:03,470
لا يمكن أن يفعل شيئاً يسبِّب الحزن لعناقيد النجوم

63
00:05:03,470 --> 00:05:04,500
أجل

64
00:05:04,500 --> 00:05:06,850
على أي حال، لنؤمن به فحسب

65
00:05:06,850 --> 00:05:07,890
معك حقّ

66
00:05:07,890 --> 00:05:10,160
...أزمة مارجينال 4 الكبرى

67
00:05:10,600 --> 00:05:12,670
كيف نتغلّب عليها؟

68
00:05:14,350 --> 00:05:16,790
آسف يا روي! عليّ أن أستعير كتاب الرياضيّات الخاصّ بك

69
00:05:17,200 --> 00:05:18,870
يمكنك الحصول على هذا أيضاً لو أحببت

70
00:05:20,100 --> 00:05:21,890
،خاصّة في أوقات المصاعب

71
00:05:21,890 --> 00:05:23,730
حاول أن تتأمّل الفضاء

72
00:05:23,730 --> 00:05:26,230
تقدير عدم أهمِّية الكائنات البشريّة

73
00:05:26,230 --> 00:05:28,390
قد يساعدك على تخطِّي أي أزمة

74
00:05:32,400 --> 00:05:34,450
!أتوم-كن، هذه لك

75
00:05:34,450 --> 00:05:35,680
ماريمو جالبة للحظّ

76
00:05:35,680 --> 00:05:37,330
...والآن ستتدحرج المساوئ عن ظهرِك

77
00:05:37,330 --> 00:05:38,770
!مثلما تفعلُ الماريمو

78
00:05:41,110 --> 00:05:43,280
كرّستُ قلبي لهذا

79
00:05:44,190 --> 00:05:46,400
!هذا يكفي يا شباب

80
00:05:46,400 --> 00:05:48,950
!أنتم تخفون عنّي شيئاً ما

81
00:05:49,890 --> 00:05:52,890
ألستَ من يخفي شيئاً؟

82
00:05:53,610 --> 00:05:54,580
أخفي شيئاً؟

83
00:05:54,580 --> 00:05:56,240
ولماذا أفعل ذلك؟

84
00:05:56,240 --> 00:05:58,060
!أنا منفتح دوماً

85
00:05:58,060 --> 00:06:00,300
سأعطيكم حتّى كلّ مقاساتي من رأسي
حتّى أخمص قدميّ

86
00:06:00,300 --> 00:06:03,540
أو عيد ميلادي حتّى بالسّاعة والدقيقة
والثّانية أو حتّى دوران الأرض

87
00:06:03,540 --> 00:06:06,350
سأسألك بشكلٍ صريحٍ إذاً

88
00:06:06,350 --> 00:06:08,300
ما معنى هذا؟

89
00:06:10,250 --> 00:06:12,140
!من أين هذه الصُّورة؟

90
00:06:12,370 --> 00:06:14,120
فسِّر من فضلك

91
00:06:14,510 --> 00:06:18,060
ما الرابط بينك وبين هذه الفتاة؟

92
00:06:19,100 --> 00:06:20,000
ماذا؟

93
00:06:20,560 --> 00:06:23,770
رابط؟ هذه ليسَتْ فتاة

94
00:06:25,760 --> 00:06:28,700
يا صاح، أنتم تعرفونهم خير معرفة أيضاً

95
00:06:35,460 --> 00:06:38,410
...هبطَ من السّماء، وحيد قرن يافع

96
00:06:38,410 --> 00:06:40,170
!يونيكورن جونيور

97
00:06:41,920 --> 00:06:42,660
ماذا؟

98
00:06:42,660 --> 00:06:45,130
أظنُّنا أخطأنا الغرفة

99
00:06:45,620 --> 00:06:46,340
—نزل من السّماء

100
00:06:48,560 --> 00:06:49,550
!أخطأنا مجدّداً

101
00:06:49,940 --> 00:06:51,010
—نزل من

102
00:06:51,250 --> 00:06:53,510
!نزل

103
00:06:56,670 --> 00:06:58,120
نعرفهم؟

104
00:06:58,120 --> 00:06:59,400
!أجل، هذا صحيح

105
00:06:59,400 --> 00:07:02,090
...زملاؤنا الكوهاي الذين سيغنُّون للمرّة الأولى رسميّاً اللّيلة

106
00:07:02,090 --> 00:07:03,980
!يونيكورن جونيور

107
00:07:06,480 --> 00:07:08,090
يونيكورن؟

108
00:07:08,090 --> 00:07:10,320
كنتُ أتحدّثُ عنكم للتو يا شباب

109
00:07:11,320 --> 00:07:16,150
!لحظة، الفتاة في تِلك المقالة كانت... تـ-تيروما-كن؟

110
00:07:19,860 --> 00:07:22,030
أريد بعضاً من الماء

111
00:07:24,920 --> 00:07:27,050
عثرنا عليكم أخيراً

112
00:07:31,410 --> 00:07:33,050
!هذا يفسِّر كلّ شيء إذاً

113
00:07:33,710 --> 00:07:37,060
!مُحال أن أخون مارجينال 4 أو عناقيد النجوم

114
00:07:37,430 --> 00:07:39,880
نعم، هذا مُطمئن

115
00:07:39,880 --> 00:07:42,770
أظنُّها ليسَتْ فضيحة إطلاقاً إذاً

116
00:07:42,770 --> 00:07:45,360
ناهيك عن أنَّ تيروما-كن هو صبيّ

117
00:07:45,360 --> 00:07:47,730
حُلَّت المسألة على ما أعتقد

118
00:07:50,470 --> 00:07:52,320
—يونيكورن، مبروك مشاركتكم الأولى

119
00:07:52,320 --> 00:07:53,740
!لا يوجد ما يدعو للسعادة

120
00:07:55,090 --> 00:07:56,120
تسوباسا-كن؟

121
00:07:56,120 --> 00:08:02,620
كان من المُفترَض أن تكون ظروف حفلنا
الموسيقي الأوّل اللّيلة مثاليّة

122
00:08:14,370 --> 00:08:16,380
حان الوقتُ أخيراً

123
00:08:17,190 --> 00:08:17,970
أجل

124
00:08:18,560 --> 00:08:20,270
أنا متوتِّر

125
00:08:22,170 --> 00:08:26,860
سنكون بخير، فكِّرا بكلّ التمرينات التي مارسناها معاً

126
00:08:27,820 --> 00:08:29,340
!شاهد فحسب يا أتوم

127
00:08:29,340 --> 00:08:32,900
!سيتخطّى عددُ أتباعي عددَ أتباعك خلال فترة قصيرة

128
00:08:36,930 --> 00:08:38,030
...ما

129
00:08:38,030 --> 00:08:40,660
!ماذا؟

130
00:08:41,490 --> 00:08:43,060
...أتوم، أنت

131
00:08:44,540 --> 00:08:47,260
!لماذا سمحتَ لهم بالتقاطِ صورة كهذه؟

132
00:08:47,260 --> 00:08:49,170
في الواقع... فاجأتْني أيضاً

133
00:08:50,210 --> 00:08:51,970
!هذا ليس عذراً

134
00:08:51,970 --> 00:08:55,130
لفت الانتباه بثرثرة غبيّة هو أسخف
شيء على الإطلاق

135
00:08:55,340 --> 00:08:56,700
اهدأ يا تسوباسا-كن

136
00:08:56,700 --> 00:08:58,280
!دعني يا ألتو

137
00:08:58,280 --> 00:09:00,160
سبقَ وشرحتُ لك هذا

138
00:09:00,160 --> 00:09:02,640
كنتُ أستشيرُ أتوم-سان فحسب

139
00:09:03,010 --> 00:09:08,200
أجل! كنتُ ألعبُ دورَ السينباي المثاليّ
وأعلّمه كيف يتحضّر للمشاركةِ الرسميّةِ الأولى

140
00:09:08,610 --> 00:09:10,570
حسناً، في حالتِنا نحن

141
00:09:10,570 --> 00:09:13,590
توحّدَتْ قلوبنا مع عناقيد النجوم

142
00:09:13,590 --> 00:09:15,280
!وهكذا ملأنا السّماء بالنجوم

143
00:09:15,920 --> 00:09:17,740
ملأتم السّماء بالنجوم؟

144
00:09:17,950 --> 00:09:18,860
!أجل

145
00:09:18,860 --> 00:09:20,100
...على ذكرِ ذلك

146
00:09:22,880 --> 00:09:24,710
!هذا اللّحم الرُّخامي لذيذ

147
00:09:24,710 --> 00:09:26,160
!ما علاقة هذا بذاك؟

148
00:09:26,410 --> 00:09:29,790
بالإضافة إلى ذلك، لماذا ذهبتَ للتكلّم مع أتوم
دون أن تخبرني يا تيروما؟

149
00:09:30,100 --> 00:09:33,640
على رسلِك، إلقاء اللّوم على تيروما
لن يقودك إلى نتيجة

150
00:09:37,260 --> 00:09:40,210
!حضرة الرّئيس! كنتُ أحاول الاتِّصال بكِ طوال الصّباح

151
00:09:40,210 --> 00:09:41,850
!جرّبتُ الاتِّصال بالمكتب وبمديرتنا أيضاً

152
00:09:42,930 --> 00:09:46,680
أظنُّك تعلم بالمقالةِ إذاً

153
00:09:46,680 --> 00:09:48,450
كنّا نتزاحم جميعاً على إيجادِ حلّ لذلك

154
00:09:48,450 --> 00:09:51,490
حضرة الرّئيس، أرجوكِ أسكتي الإشاعات بشكلٍ نهائي

155
00:09:51,490 --> 00:09:53,730
تسوباسا؟ هل أنتم هناك أيضاً؟

156
00:09:53,730 --> 00:09:54,610
...أجل، في الواقع

157
00:09:54,610 --> 00:09:55,920
هذا مناسبٌ جدّاً

158
00:09:55,920 --> 00:09:58,700
ابقوا حيثُ أنتم ولا تذهبوا إلى أي مكان

159
00:09:58,700 --> 00:10:01,320
ماذا؟ ما-ماذا تقصدين؟

160
00:10:01,320 --> 00:10:05,180
،إن رأى أحدٌ أتوم وتيروما معاً ثانية

161
00:10:05,180 --> 00:10:06,970
فسيقود ذلك إلى مزيدٍ من سوء الفهم

162
00:10:06,970 --> 00:10:08,580
ماذا عن حفلتهم؟

163
00:10:09,170 --> 00:10:14,040
قُلْ لهم أنَّ تشان سيقلّهم عندما تهدأ الأمور

164
00:10:14,690 --> 00:10:16,280
فليلتزموا أماكنهم حاليّاً

165
00:10:17,280 --> 00:10:18,280
حضرة الرّئيس؟

166
00:10:20,820 --> 00:10:22,700
رسالة من مديرتِنا

167
00:10:22,700 --> 00:10:26,060
أجل، أظنُّها تقول أنَّنا ينبغي أن نصغي للرّئيس

168
00:10:26,060 --> 00:10:28,810
!تبّاً، لم أعد أفهم ما يجري

169
00:10:29,510 --> 00:10:32,710
لا أدري لماذا يستغرقُ تسوية هذا الأمر وقتاً طويلاً

170
00:10:32,710 --> 00:10:34,270
هذا غريبٌ بعض الشيء

171
00:10:34,580 --> 00:10:37,860
حضرة الرّئيس، أنتِ رهيبة حقّاً

172
00:10:37,860 --> 00:10:42,190
تستغلِّين صورة المجلّة تلك وبدلاً
،من تفسير الأمر

173
00:10:42,190 --> 00:10:43,660
تؤجِّجين الوضع

174
00:10:44,100 --> 00:10:48,400
من الأفضل الكشف عن هويّةِ تيروما قبل أن يبدأ
الحفل الرسميّ المُباشَر الأوَّل

175
00:10:48,400 --> 00:10:50,780
،سيُلفِتُ هذا كثيراً من الانتباهِ ليونيكورن

176
00:10:50,780 --> 00:10:53,170
وسينتشر اسم مارجينال 4 أكثر فأكثر

177
00:10:53,870 --> 00:10:55,520
عمل مُتقَن

178
00:10:55,520 --> 00:10:58,770
تشان، أعتمدُ عليك في متابعة
التَّعامُل مع الصُّحف

179
00:10:58,770 --> 00:11:00,010
عُلِم

180
00:11:00,510 --> 00:11:02,250
لا يُسمَح لنا بالخروج

181
00:11:02,250 --> 00:11:04,190
ما معنى هذا؟

182
00:11:09,620 --> 00:11:11,900
إلى متى علينا البقاء هنا؟

183
00:11:11,900 --> 00:11:13,200
!تبّاً

184
00:11:13,200 --> 00:11:15,060
موعد حفلنا يقتربُ أكثر فأكثر

185
00:11:15,060 --> 00:11:16,960
أقدِّر مشاعرك يا تسوباسا-كن

186
00:11:16,960 --> 00:11:19,060
لكن الغضب لن ينفعك

187
00:11:19,060 --> 00:11:21,260
لننتظر الرّئيس حتّى ترجع إلينا فحسب

188
00:11:21,260 --> 00:11:23,660
بالمناسبة، ما رأيكم بشرب شيء ما؟

189
00:11:24,450 --> 00:11:26,790
أظنُّنا لا نمتلك سوى عصير الشّمس

190
00:11:27,070 --> 00:11:29,540
مُحال أن يتمكّن أحدٌ من شرب
هذه المشروبات في ظرفٍ كهذا

191
00:11:30,350 --> 00:11:33,970
إنّه لذيذٌ جدّاً، سيتماشى جيّداً مع كرات
أرزّ السلمون

192
00:11:33,970 --> 00:11:35,630
أريد دايفوكو بالفراولة

193
00:11:35,630 --> 00:11:36,790
...أنتم

194
00:11:36,790 --> 00:11:38,340
تسوباسا

195
00:11:38,340 --> 00:11:40,660
،أعلم أنَّك متوتِّر

196
00:11:40,660 --> 00:11:42,300
لكن هذا ليس سبباً للهيجانِ هكذا

197
00:11:42,770 --> 00:11:44,300
!لستُ متوتّراً

198
00:11:47,440 --> 00:11:49,270
لننتظر فحسب

199
00:11:49,270 --> 00:11:50,610
،حالما ننتهي من غنائنا الرَّسمي الأوَّل

200
00:11:50,610 --> 00:11:55,470
كلّ عناقيد نجومكم سيتحوّلون إلى مُعجبين
بيونيكورن جونيور، رِفاق وحيد القرن

201
00:11:55,470 --> 00:11:56,400
!ماذا قلت؟

202
00:11:56,400 --> 00:12:00,030
!علِّم على كلامي يا أتوم! سأهزمك

203
00:12:00,030 --> 00:12:01,780
!دعني أراك تفعلُ ذلك

204
00:12:01,780 --> 00:12:04,200
القول أسهل من الجعل

205
00:12:04,200 --> 00:12:05,200
!جعل؟ جعل ماذا؟

206
00:12:05,200 --> 00:12:06,670
...هذان الاثنان

207
00:12:06,670 --> 00:12:07,970
...إنّهما

208
00:12:07,970 --> 00:12:09,830
متشابهان

209
00:12:09,830 --> 00:12:12,330
!هذا يكفي

210
00:12:12,330 --> 00:12:15,780
إن كنتُم تجرؤون على القيامِ بكلِّ هذا
فلنحسم الأمر حالاً

211
00:12:15,780 --> 00:12:17,460
!بمعركةٍ معنا نحن الثّلاثة

212
00:12:17,460 --> 00:12:18,190
ماذا؟

213
00:12:18,190 --> 00:12:19,210
الآن؟

214
00:12:20,510 --> 00:12:22,170
يبدو هذا ممتعاً

215
00:12:23,100 --> 00:12:27,270
إن أردتُم معركةً جادّةً نضعُ فيها
كبرياءنا على المحكّ

216
00:12:27,270 --> 00:12:28,640
فأنا أهلٌ لها

217
00:12:29,170 --> 00:12:30,970
جميل

218
00:12:34,450 --> 00:12:35,530
ماذا ينبغي أن نفعل؟

219
00:12:35,530 --> 00:12:37,060
أظنّنا لا نملك خياراً

220
00:12:37,060 --> 00:12:39,740
مُحال أن يتراجع قائدنا

221
00:12:41,110 --> 00:12:43,930
ألتو، تعرف دورك جيّداً

222
00:12:43,930 --> 00:12:45,300
تيروما، أأنت جاهزٌ أيضاً؟

223
00:12:45,300 --> 00:12:48,280
!لنرِهم كم نحن مذهلين قبل أن يبدأ حفلنا

224
00:12:48,800 --> 00:12:49,610
حسناً

225
00:12:50,240 --> 00:12:54,710
لنفعلها إذاً. مباراة من ثلاث نقاط
يونيكورن ضدّ مارجينال 4

226
00:12:55,000 --> 00:12:57,700
لحظة. عـ-علينا المشاركة أيضاً؟

227
00:12:57,700 --> 00:13:01,920
أستطيع مواجهة هؤلاء الحمقى بمفردي

228
00:13:02,130 --> 00:13:04,100
ماذا ينوون أن يفعلوا؟

229
00:13:04,100 --> 00:13:05,540
يغنّون؟ يرقصون؟

230
00:13:05,540 --> 00:13:07,390
منافسة أزياء؟

231
00:13:07,390 --> 00:13:08,740
ليسَتْ كذلك

232
00:13:08,740 --> 00:13:10,640
!ستبدأ المباراة الأولى بعبارةٍ منّا نحن اليونيكورن

233
00:13:11,100 --> 00:13:11,600
...ماتَ شاهُ

234
00:13:11,850 --> 00:13:12,680
...ذاتك

235
00:13:13,220 --> 00:13:14,270
!النقيّة

236
00:13:15,250 --> 00:13:16,980
!استمتعوا

237
00:13:16,980 --> 00:13:19,410
لحظة! ما الذي تجعلوننا نفعله؟

238
00:13:19,410 --> 00:13:22,610
...بزوالِ ذلك عن الطريق، حان الوقتُ لـ

239
00:13:27,780 --> 00:13:29,280
!معركة شطرنج

240
00:13:37,440 --> 00:13:38,610
مات الشّاه

241
00:13:39,790 --> 00:13:41,830
أنا مهتمٌّ بمانغا شطرنج مؤخّراً

242
00:13:41,830 --> 00:13:43,510
!أحسنتَ صنعاً يا ألتو

243
00:13:44,080 --> 00:13:45,160
أظنُّك خسرت

244
00:13:45,160 --> 00:13:47,630
لو لعِبَ روي-كن لربِحَ بسهولة

245
00:13:49,210 --> 00:13:52,340
!سأربح في المباراة الثّانية

246
00:13:52,340 --> 00:13:54,980
!إن كنتُم تقتلون الشّاه فلدينا هذا بالطبع

247
00:13:54,980 --> 00:13:58,200
!قبلة واحدة إلى أبعد أصقاع المجرّة

248
00:13:58,200 --> 00:14:00,560
!بكلِّ سرور

249
00:14:00,560 --> 00:14:02,070
!لماذا تشاركان أنتما؟

250
00:14:02,580 --> 00:14:04,170
...ولهذا السّبب

251
00:14:04,650 --> 00:14:05,820
!تذوُّق قبلة

252
00:14:07,120 --> 00:14:09,140
ماذا قصدَ بـ"لهذا السّبب"؟

253
00:14:09,140 --> 00:14:10,320
لا أدري

254
00:14:10,320 --> 00:14:12,670
أفضل المغنّيين النّجوم في المجرّة

255
00:14:12,670 --> 00:14:18,040
يستطيعون تمييز من يقبِّلونه حتّى بعيون مغمضة

256
00:14:18,040 --> 00:14:21,710
لا أملك أدنى فكرة عمّا تتحدّثون
لكن لا بأس، سنفعلها

257
00:14:22,500 --> 00:14:25,320
!استعداد، انطلاق

258
00:14:27,050 --> 00:14:27,630
بالون

259
00:14:27,630 --> 00:14:30,890
صحيح

260
00:14:29,220 --> 00:14:29,840
مزهريّة

261
00:14:31,480 --> 00:14:32,850
مضرب تنس

262
00:14:32,850 --> 00:14:34,050
جهاز تنظيم حرارة

263
00:14:34,050 --> 00:14:34,850
صنْج

264
00:14:35,340 --> 00:14:36,600
مذهل

265
00:14:37,490 --> 00:14:38,150
حلوى

266
00:14:38,150 --> 00:14:39,790
إنّها قشرة توفو مجفّفة

267
00:14:39,790 --> 00:14:40,420
!جيلي

268
00:14:40,420 --> 00:14:42,190
إنّها توفو حريريّة

269
00:14:42,190 --> 00:14:43,090
!بافاروا

270
00:14:43,090 --> 00:14:44,710
إنّها توفو خاصّة من أوكيناوا

271
00:14:44,710 --> 00:14:46,610
!يا صاح، ابتعد عن التوفو

272
00:14:48,390 --> 00:14:49,250
!توقّفوا

273
00:14:49,250 --> 00:14:51,030
نصر ساحق لتيروما-كن

274
00:14:51,030 --> 00:14:51,780
!حسناً

275
00:14:53,400 --> 00:14:56,820
فوزان ليونيكورن دون أن أفعل شيئاً

276
00:14:56,820 --> 00:14:58,540
!أتوم، خسِرت

277
00:15:01,280 --> 00:15:04,340
تسوباسا، أنت حقّاً لا تدري شيئاً

278
00:15:05,210 --> 00:15:09,590
بصِفتي سينباي، سأعلّمُك قواعد عالمنا

279
00:15:11,220 --> 00:15:12,390
ماذا تعني؟

280
00:15:12,390 --> 00:15:15,760
إن ربحتُم المباراةَ الأخيرة فستحصلون على عشرة
!آلاف نقطة

281
00:15:17,710 --> 00:15:20,310
!هذه قاعدةٌ للتنويع في التّرفيه

282
00:15:20,310 --> 00:15:23,040
!تبّاً! هكذا هو الأمر إذاً

283
00:15:23,040 --> 00:15:25,270
هذا صعب، لكن تعلّمتُ الكثير

284
00:15:25,270 --> 00:15:25,820
أجل

285
00:15:26,080 --> 00:15:28,070
...إنَّ هذا

286
00:15:28,070 --> 00:15:29,530
يا لبراءتهم

287
00:15:30,300 --> 00:15:32,460
!سأربح النقاطَ المليون هذه

288
00:15:32,460 --> 00:15:34,300
أشكُّ ما إن سيكون ذلك سهلاً

289
00:15:34,300 --> 00:15:36,780
حسناً، ما هي المباراة النّهائية؟

290
00:15:36,780 --> 00:15:40,660
لم يكن تذوُّق القبلة كافياً لإطلاقِ عنان
روح شهابي

291
00:15:41,760 --> 00:15:45,630
سنتبارز بقبلةٍ جادّةٍ إلى أبعد أصقاع المجرّة

292
00:15:47,440 --> 00:15:49,710
قبلة... جادّة؟

293
00:15:51,520 --> 00:15:54,720
عليكم الإفصاح عن حبِّكم لهذا الرّجُل وتقبِّلونه

294
00:15:54,720 --> 00:15:56,350
القبلة التي تصِل إلى المجرَّة تربح

295
00:15:56,770 --> 00:15:59,180
أتعني هذا الشّيء؟

296
00:15:59,180 --> 00:16:03,810
بالمناسبة، هذا فيثاغورث، عالم
رياضيّات من اليونان القديمة

297
00:16:05,620 --> 00:16:07,690
سُمِّيَتْ شركتنا تيمُّناً به

298
00:16:08,930 --> 00:16:10,440
!لنبدأ حالاً

299
00:16:11,950 --> 00:16:14,920
سأبدأ أوّلاً

300
00:16:22,400 --> 00:16:26,880
كان موعدنا اليوم ممتعاً للغاية، أليس كذلك
يا فيثاكو؟

301
00:16:29,140 --> 00:16:32,270
رائع، يمكنُك رؤية الكثير من النُّجوم

302
00:16:34,370 --> 00:16:35,620
هل تعلم يا بيثاكو؟

303
00:16:35,620 --> 00:16:40,220
إن تمنّيتَ أمنيةً لدى رؤيتك
نجماً فإنّها تتحقَّق

304
00:16:42,300 --> 00:16:46,020
بيثاكو، أنتَ تتمنَّى بشكلٍ مُستميت

305
00:16:47,710 --> 00:16:49,230
لا تقلق

306
00:16:49,920 --> 00:16:55,240
سأكونُ شهابك وأحقِّق كلّ أمانيك

307
00:17:01,050 --> 00:17:03,350
ما هي أمنيتي؟

308
00:17:04,290 --> 00:17:07,310
إنَّها إسعادك بالطبع

309
00:17:07,310 --> 00:17:11,220
بيثاكو، شكلك المنحوت

310
00:17:11,220 --> 00:17:14,840
ولحيتك الفاتِنة... أحبُّ كلَّ شيء فيك

311
00:17:16,340 --> 00:17:21,480
سأقضي حياتي أثبِت حبِّي
والنظريّة الفيثاغورثيّة

312
00:17:33,060 --> 00:17:34,940
هكذا جرى الأمر

313
00:17:35,440 --> 00:17:37,580
كان ذلك رائعاً للغاية يا أتوم-كن

314
00:17:37,580 --> 00:17:40,580
أنا مندهشٌ من تذكُّرِك للنظريّةِ الفيثاغورثيّة

315
00:17:41,400 --> 00:17:43,200
ماذا كان ذلك؟ كان سخيفاً للغاية

316
00:17:43,200 --> 00:17:45,850
ماذا؟! لنرَ ما لديك إذاً

317
00:17:45,850 --> 00:17:47,380
!لنرَ قبلتك الجادّة

318
00:17:47,380 --> 00:17:50,600
حسناً! ركِّز جيّداً إذاً

319
00:17:53,210 --> 00:17:54,960
!انتظر

320
00:17:55,460 --> 00:17:58,270
هل قصدتَ ما قلتَه حقّاً؟

321
00:17:58,990 --> 00:18:00,720
أنَّك تريد الانفصال عنِّي؟

322
00:18:03,930 --> 00:18:05,740
لا تعلم ما إن كنتُ أحبُّك فعلاً؟

323
00:18:05,740 --> 00:18:07,120
عمّاذا تتكلَّم؟

324
00:18:07,120 --> 00:18:09,620
لا أدري ما الذي يُفترَض أن يعنيه هذا

325
00:18:12,260 --> 00:18:15,240
!إن كنتَ لا تستطيع الوثوق بي، فافعل ما تشاء

326
00:18:30,880 --> 00:18:32,840
!تبَّاً، لا أستطيع فعل هذا

327
00:18:36,130 --> 00:18:38,970
!بيثاكو، لا أريد أن أدعك تذهب

328
00:18:40,910 --> 00:18:42,980
لا يمكنُك الوثوق بحبِّي؟

329
00:18:43,890 --> 00:18:46,600
...إذاً سأجعلُك تثِقُ بي حالاً

330
00:18:54,470 --> 00:18:56,430
ما الأمر يا تسوباسا-كن؟

331
00:18:56,430 --> 00:18:58,070
لـ... لا أستطيع فعلها

332
00:18:58,540 --> 00:19:01,740
ستكون بمثابةِ قبلة غير مُباشَرة مع أتوم

333
00:19:04,120 --> 00:19:05,700
مُحال أن أرغب بذلك أيضاً

334
00:19:05,960 --> 00:19:09,180
مع الأسف. كانَتْ ممتازة

335
00:19:09,180 --> 00:19:12,000
لو استمرَّ لربِحَ تسوباسا-كن على ما أعتقد

336
00:19:12,000 --> 00:19:16,210
مهما كان السّبب، لم يستطع أن يُتمم القبلة
لهذا أنا الفائز

337
00:19:16,700 --> 00:19:19,240
!لو بدأتُ أوّلاً لربِحتُ بسهولة

338
00:19:19,240 --> 00:19:22,940
كنتُ سأقبّلُ بيثاكو دونما تردُّد
حتَّى لو بدأتَ قبلي

339
00:19:26,800 --> 00:19:27,730
!المديرة

340
00:19:27,730 --> 00:19:31,570
نعم، نعم، يسرُّني هذا

341
00:19:31,570 --> 00:19:33,480
اهتممت بأمر الصُّحف إذاً؟

342
00:19:34,590 --> 00:19:36,580
يا جماعة، يمكننا الخروج ثانية

343
00:19:36,580 --> 00:19:38,480
أتى تشان-سان إلى هنا ليقلّنا بالسيَّارة

344
00:19:41,260 --> 00:19:44,450
وافقتَ على أن أكون الرَّابح
في مباراةِ اليوم، صحيح؟

345
00:19:45,050 --> 00:19:48,040
إن كانَتْ لديك أي شكوى فيمكنُك
أن تتحدَّاني متى شئت

346
00:19:56,870 --> 00:20:00,760
سيتجمّعُ الصحفيُّون والإعلاميّون خارج قاعة الحفل

347
00:20:05,300 --> 00:20:07,600
هل أنتُم متوتِّرون؟

348
00:20:09,420 --> 00:20:11,350
ستكونُ الأمور على ما يُرام

349
00:20:11,620 --> 00:20:16,440
لنفعل هذا معتبرين أنفسنا على المسرح
حالما نترجّلُ من السيّارة

350
00:20:16,840 --> 00:20:17,640
حسناً

351
00:20:19,780 --> 00:20:21,650
لنذهب أوّلاً

352
00:20:22,020 --> 00:20:24,830
!ماذا؟ تريدون التّخريب علينا مجدّداً؟

353
00:20:25,460 --> 00:20:26,870
لن نُفسِد هذا الأمر لكم

354
00:20:28,000 --> 00:20:30,150
ثِقوا بنا فحسب

355
00:20:37,220 --> 00:20:41,220
أعلم أنَّه جرى حديثٌ كثيرٌ عنِّي وعن تيروما

356
00:20:41,220 --> 00:20:44,380
لكن لا يوجد ما هو فاضح ومعيب

357
00:20:44,380 --> 00:20:46,050
في مُساعدةِ زميلي الكوهاي

358
00:20:47,320 --> 00:20:52,310
أنا سعيدٌ جدّاً لأنَّ يونيكورن جونيور
ستبدأ بحفلِها الرّسمي الأوَّل اللَّيلة

359
00:20:52,310 --> 00:20:56,190
عقب لاغرانج بوينت ونحن، مارجينال 4

360
00:20:56,190 --> 00:20:59,230
دون أي تأخير، ها هي فرقة يونيكورن قد جاءت

361
00:21:01,540 --> 00:21:04,200
تسوباسا عبقريٌّ في الغناء

362
00:21:04,200 --> 00:21:06,200
يشدُّك صوته كلّما سمعتَه

363
00:21:08,570 --> 00:21:12,620
وحركات ألتو-كن الصّارخة مذهلة جدّاً
وتُمتع الأنظار في المسرح

364
00:21:12,870 --> 00:21:17,210
أعتقدُ أنَّ نقاوة تيروما-كن الطبيعيّة
هي حجر أساس المجموعة

365
00:21:17,640 --> 00:21:20,150
،بوجودِ فرقةٍ مذهلةٍ كهذه خلفنا

366
00:21:20,150 --> 00:21:22,750
يمكننا أن ننام قريري العين

367
00:21:22,750 --> 00:21:23,630
...ادعموا من فضلِكم

368
00:21:24,280 --> 00:21:26,130
!وحيدي القرن

369
00:21:27,550 --> 00:21:30,700
تبّاً، خطفتُم برقَنا

370
00:21:31,760 --> 00:21:34,120
