1
00:00:02,480 --> 00:00:04,700
تمّت الصفقة

2
00:00:04,700 --> 00:00:06,860
شكراً لتعاونك

3
00:00:05,000 --> 00:00:09,000
هذا المسلسل عملٌ خياليّ. الشخصيات والمنظمات والمواقع والقضايا المعروضة وما إليه لا تمت بصلة لأحداث واقعيّة

4
00:00:14,020 --> 00:00:16,000
وصلتني معلومات للتوّ

5
00:00:16,000 --> 00:00:19,510
انسي أمر ريانغ-ها ريانها للوقت الراهن

6
00:00:19,510 --> 00:00:20,700
سُررت بلقائك

7
00:00:22,200 --> 00:00:23,710
قُتل عميلنا

8
00:00:51,400 --> 00:00:53,170
أشعر بالأسى عليك

9
00:00:53,170 --> 00:00:56,740
تلحق بكِ هذه المكاره بسببه

10
00:00:58,970 --> 00:01:00,740
انقلي تحيّاتي له

11
00:01:00,740 --> 00:01:05,570
"أخبريه "حان وقت مواجهتك للعواقب أيّها الخائن

12
00:01:14,770 --> 00:01:17,860
أكلّ هذا من تدبيرك؟

13
00:01:19,610 --> 00:01:21,630
أتعتقدين ذلك صدقاً؟

14
00:03:11,540 --> 00:03:12,770
صباح الخير

15
00:03:12,770 --> 00:03:14,770
يبدو أنّكِ نمتِ بعمق

16
00:03:22,710 --> 00:03:25,190
لا يزال أمامنا وقتٌ قبل
موعد تسجيل الخروج

17
00:03:25,190 --> 00:03:26,610
...ما علينا أن

18
00:03:30,630 --> 00:03:32,570
ربما لستِ إنسانةً صباحيّة

19
00:03:34,180 --> 00:03:37,480
بالمناسبة، لا تزالين على
حالكِ منذ الأمس، صحيح؟

20
00:03:37,480 --> 00:03:39,490
الوحل يغطّيكِ وثيابك

21
00:03:40,110 --> 00:03:41,570
لمَ لا تستحمّي؟

22
00:04:08,380 --> 00:04:09,520
تبّاً

23
00:04:11,060 --> 00:04:13,600
...تعرّضتُ للهجوم وفقما أذكر، ثمّ

24
00:04:23,620 --> 00:04:26,510
أكلّ هذا من تدبيرك؟

25
00:04:27,800 --> 00:04:30,200
لا بدّ أنّي غططت في النوم

26
00:04:35,080 --> 00:04:36,700
خرج

27
00:04:38,510 --> 00:04:39,370
منشفة؟

28
00:04:51,540 --> 00:04:52,850
رجعت

29
00:04:56,820 --> 00:04:59,700
ليست في دورة المياه

30
00:05:07,400 --> 00:05:08,790
ما الذي تفعلينه؟

31
00:05:09,300 --> 00:05:10,330
...ثيابي

32
00:05:12,500 --> 00:05:16,200
ماذا فعلت بثيابي؟

33
00:05:16,200 --> 00:05:21,130
حسناً، كانت متّسخةً فأخذتها
لنظيفها في غسّالات العُملات

34
00:05:21,130 --> 00:05:23,130
!كـ-كلّها؟

35
00:05:23,130 --> 00:05:23,960
أجل

36
00:05:23,960 --> 00:05:27,130
،ألقيتُ كلّ شيءٍ في الغسّالة
معطفك وثيابك الداخليّة وما إليها

37
00:05:28,630 --> 00:05:33,100
...معطفي وثيابي الداخليّة، كلّ شيء

38
00:05:33,100 --> 00:05:37,110
لحظة، هل ثياب النساء الداخليّة
لا تصلح لغسيل الآلات؟

39
00:05:37,740 --> 00:05:40,230
!ليس هذا المهمّ

40
00:05:40,230 --> 00:05:41,690
فهمت

41
00:05:41,690 --> 00:05:42,940
—لا تملكين ثياباً لارتد

42
00:05:47,710 --> 00:05:51,620
ماذا أفعل؟ لمَ هي غاضبةٌ لهذه الدرجة؟

43
00:05:54,350 --> 00:05:55,260
هاك

44
00:05:55,260 --> 00:05:56,500
لقد جفّت

45
00:05:57,900 --> 00:05:59,500
دافئة ومريحة

46
00:06:10,220 --> 00:06:11,130
أجل

47
00:06:11,480 --> 00:06:13,430
أعتذر لإقلاقك

48
00:06:14,680 --> 00:06:17,220
سأوضّح التفاصيل عندما أرجع

49
00:06:17,220 --> 00:06:18,390
إلى اللقاء

50
00:06:21,180 --> 00:06:22,900
هل غضبوا منك؟

51
00:06:23,770 --> 00:06:25,400
للمبيت خارجاً؟

52
00:06:29,950 --> 00:06:30,890
ماذا؟

53
00:06:30,890 --> 00:06:32,130
أين تذهبين؟

54
00:06:32,950 --> 00:06:35,140
سيأتي أحدٌ لإقلالي من الشركة

55
00:06:35,950 --> 00:06:38,440
قلتُ أنّي سأوصلك

56
00:06:38,440 --> 00:06:39,750
لم أطلب

57
00:06:39,750 --> 00:06:41,960
بربّك

58
00:06:43,870 --> 00:06:45,790
صحيح، مهلك

59
00:06:45,790 --> 00:06:46,870
نسيتِ هذا

60
00:06:51,220 --> 00:06:53,220
!لا عجب أنّي لم أجده

61
00:06:53,220 --> 00:06:55,720
إنّه محطّمٌ بالكامل للأسف

62
00:06:55,980 --> 00:06:57,730
وأفسدتِ سيّارتك

63
00:06:57,730 --> 00:06:59,600
ستقعين تحت ضغطٍ كبير

64
00:07:01,950 --> 00:07:03,650
...أعتذر

65
00:07:05,750 --> 00:07:07,170
...على كلّ

66
00:07:08,370 --> 00:07:11,110
المتاعب التي تسبّبتُ بها

67
00:07:12,040 --> 00:07:13,490
عجباً، لم أتوقّع

68
00:07:14,490 --> 00:07:17,430
لكن لا تهتمّي

69
00:07:17,860 --> 00:07:20,750
لم يمّسني الأمر بالتحديد

70
00:07:21,330 --> 00:07:23,390
عدا تأذّيك

71
00:07:25,030 --> 00:07:28,260
...وأظنّني أعرف لمَ

72
00:07:29,460 --> 00:07:30,430
ماذا؟

73
00:07:30,430 --> 00:07:31,760
لا شيء

74
00:07:32,040 --> 00:07:36,420
وأيضاً، أفضّل الشكر بدل الاعتذار

75
00:07:36,820 --> 00:07:41,980
،"على سبيل المثال: "شكراً جزيلاً لك
"أو "لن أنسى لك هذا قطّ

76
00:07:43,880 --> 00:07:48,400
...بالمناسبة، أخبرني من تعدّى عليّ

77
00:07:49,610 --> 00:07:54,030
بأن أقول لك: "حان وقت
"مواجهتك للعواقب أيّها الخائن

78
00:07:54,330 --> 00:07:56,870
ربما تعرف ما يقصده

79
00:08:00,690 --> 00:08:02,380
حسناً، أستأذنك

80
00:08:06,200 --> 00:08:08,710
كان بإمكانكِ إخباري باكراً

81
00:08:19,950 --> 00:08:23,370
قبل 5 أعوام

82
00:08:26,150 --> 00:08:27,860
مرشّح تنفيذي؟

83
00:08:28,080 --> 00:08:29,360
هو؟

84
00:08:29,360 --> 00:08:31,670
أخفض صوتك يا هو

85
00:08:31,670 --> 00:08:32,760
...لكن

86
00:08:32,760 --> 00:08:35,610
سيُعلن المُسنّ عن الأمر في
اجتماع التنفيذيين اليوم

87
00:08:35,610 --> 00:08:37,200
إنّه محسومٌ سلفاً

88
00:08:37,200 --> 00:08:37,870
!ماذا؟

89
00:08:37,870 --> 00:08:40,240
لم تمضِ إلّا ثلاثة أعوام
!على قدومه هنا

90
00:08:40,240 --> 00:08:44,730
!أعرف أنّه يروق للزعيم، لكنّ هذا مُريبٌ جدّاً

91
00:08:44,730 --> 00:08:46,750
اهدأ يا هو

92
00:08:47,000 --> 00:08:49,460
لا يزال مجرّد مرشّح

93
00:08:49,460 --> 00:08:53,380
الأمر يبعد 10 أعوام
إلى 20 عاماً في المستقبل

94
00:08:53,380 --> 00:08:54,870
...ليس ذلك ما

95
00:08:57,740 --> 00:08:58,760
ريانغ-هاغ وو-سان

96
00:08:59,660 --> 00:09:01,010
كنتُ أنوي الكلام معك

97
00:09:01,330 --> 00:09:04,150
قال الآخرون أنّهم سيصلون قريباً

98
00:09:04,150 --> 00:09:06,330
هل لي بدقيقةٍ من وقتك؟

99
00:09:06,330 --> 00:09:07,960
أجل، لا بأس

100
00:09:07,960 --> 00:09:08,830
حسناً

101
00:09:17,590 --> 00:09:18,580
!تبّاً

102
00:09:19,300 --> 00:09:20,940
أعتذر يا ريانها

103
00:09:21,350 --> 00:09:23,040
لا تعطِ الأمر أهميّة

104
00:09:23,040 --> 00:09:25,710
كلا، إنّه محقّ

105
00:09:25,710 --> 00:09:29,050
لا أرى أنّي ملائمٌ للمنصب أيضاً

106
00:09:30,090 --> 00:09:33,660
يؤلمه أنّك تترقّى قبله

107
00:09:33,660 --> 00:09:34,920
بينما كان هنا قبلك

108
00:09:35,330 --> 00:09:36,630
فلتعامله بلطف

109
00:09:38,330 --> 00:09:40,660
أنا أغار من هو-سان مع ذلك

110
00:09:40,660 --> 00:09:41,810
يبدو بغاية الحرّية

111
00:09:41,810 --> 00:09:44,930
هذا الكلام هو ما يغضبه

112
00:09:46,500 --> 00:09:47,800
أنا صريحٌ لا أكثر

113
00:09:48,180 --> 00:09:49,350
أتكلّم بصدق

114
00:10:08,440 --> 00:10:10,230
وصلوا توّاً

115
00:10:11,460 --> 00:10:13,680
لا نعرف ما قد يحصل

116
00:10:13,680 --> 00:10:15,210
كن يقظاً

117
00:10:17,240 --> 00:10:19,910
إنّه مُنتفخ الخدّ أكثر
من العادة اليوم

118
00:10:19,910 --> 00:10:23,260
إنّه غاضبٌ لأنّ ريانغ-هاغ وو
يُغرق ريانها بكلّ الاهتمام

119
00:10:23,260 --> 00:10:27,110
كما سمعتُ أنّ ريانها قد رُشّح
للانضمام لللتنفيذيّن

120
00:10:27,970 --> 00:10:30,900
ليس ذلك فحسب

121
00:10:30,900 --> 00:10:35,080
هنالك خطبٌ ما به

122
00:10:53,750 --> 00:10:54,860
ريانغ-هاغ وو-سان

123
00:10:56,150 --> 00:10:57,750
مرحباً

124
00:10:57,750 --> 00:10:59,570
انتهيت من إلقاء
التحيّة على الجميع؟

125
00:10:59,940 --> 00:11:00,670
أجل

126
00:11:00,670 --> 00:11:02,010
أتريد تدخين لفافة؟

127
00:11:02,010 --> 00:11:03,960
أقدّر بادرتك، لكن كلّا

128
00:11:03,960 --> 00:11:06,270
نسيت، أنت لا تدّخن

129
00:11:06,270 --> 00:11:07,620
اعذرني

130
00:11:14,270 --> 00:11:20,890
حسناً، أيّاً يكن، عليك التنازل قُدماً

131
00:11:21,220 --> 00:11:24,330
يمكن أن تُستهدف لأتفه الأسباب

132
00:11:24,710 --> 00:11:27,620
يجدك الكثيرون مثيراً للإزعاج

133
00:11:28,150 --> 00:11:29,410
خذ حذرك

134
00:11:30,040 --> 00:11:30,910
...صحيح

135
00:11:31,560 --> 00:11:33,430
فرّغ جدولك للغدّ

136
00:11:33,430 --> 00:11:35,530
لنذهب لتناول العشاء مع هو

137
00:11:35,530 --> 00:11:37,340
علينا الاحتفال بك

138
00:11:37,340 --> 00:11:39,550
رغم أنّه يغضب عندما أقول ذلك

139
00:11:40,330 --> 00:11:42,300
غداً؟

140
00:11:42,570 --> 00:11:45,220
لديه مشاكله، لكن كذلك أنت

141
00:11:45,220 --> 00:11:48,810
أنت تستفزّه باستمرار

142
00:11:49,140 --> 00:11:52,020
لمَ لا تسويّا الأمر بينكما بسلام؟

143
00:11:52,020 --> 00:11:54,520
سيكون من الرائع لو انسجمتما معاً

144
00:11:54,520 --> 00:11:58,480
آسف، لا أستطيع غداً

145
00:12:30,510 --> 00:12:33,020
ما الذي يجري بصدق؟

146
00:12:33,020 --> 00:12:37,380
لا تردّين على الهاتف، وسقطت سيّارتك
...من على جرف

147
00:12:39,460 --> 00:12:41,650
أريدك أن تشرحي كلّ شيء من البداية

148
00:12:41,980 --> 00:12:43,860
!أتستمعين لي يا شاتو-تشان؟

149
00:12:45,810 --> 00:12:48,160
أفضّل الشكر بدل الاعتذار

150
00:12:50,150 --> 00:12:51,670
أنا مُرهقة

151
00:12:52,160 --> 00:12:55,540
شاتو-تشان، اشرحي لي

152
00:12:56,600 --> 00:12:58,040
إنّها نائمة

153
00:13:26,660 --> 00:13:29,240
لا تكفي "أنا آسفة" لأفهم

154
00:13:29,480 --> 00:13:31,440
أسألك عمَّ حصل

155
00:13:31,440 --> 00:13:32,490
اشرحي لي

156
00:13:33,580 --> 00:13:35,580
سأدفع مُقابل السيّارة

157
00:13:35,990 --> 00:13:38,010
أقدّم خالص اعتذاري

158
00:13:42,690 --> 00:13:45,130
أخبريني بأمرٍ واحد على الأقلّ

159
00:13:45,130 --> 00:13:48,390
هل بينكِ وبين ريانغ-ها ريانها
تواصل سلفاً؟

160
00:13:52,210 --> 00:13:53,810
أنا آسفة

161
00:14:13,390 --> 00:14:17,330
سيّدي الرئيس، غادرت شاتو-سان

162
00:14:17,330 --> 00:14:18,670
أذلك مقبول؟

163
00:14:20,950 --> 00:14:22,420
سيّدي الرئيس؟

164
00:15:17,950 --> 00:15:19,480
عوداً حميداً

165
00:15:24,050 --> 00:15:26,070
تبدو شقّتكِ ضيّقة

166
00:15:26,070 --> 00:15:27,320
إنّها بعيدةٌ عن المحطّة

167
00:15:27,320 --> 00:15:28,230
وقديمة

168
00:15:28,610 --> 00:15:30,310
ما سبب تواجدك هنا؟

169
00:15:30,310 --> 00:15:31,950
وكيف وجدت مكاني بالأصل؟

170
00:15:31,950 --> 00:15:32,890
رويدك

171
00:15:32,890 --> 00:15:35,620
أتيتُ للاطمئنان عليكِ فحسب

172
00:15:37,140 --> 00:15:38,980
لا داعي لاطمئنانك

173
00:15:38,980 --> 00:15:40,000
غادر من فضلك

174
00:15:47,070 --> 00:15:48,760
ما الذي تريده؟

175
00:15:50,010 --> 00:15:51,760
ستُدخلينني، صحيح؟

176
00:15:53,260 --> 00:15:54,430
انظري

177
00:15:54,430 --> 00:15:56,110
جلبتُ معي هديّةً حتّى

178
00:15:56,110 --> 00:15:59,400
إنّها من محلٍ ذو شعبيّة كبيرة

179
00:15:59,400 --> 00:16:01,350
انتظرتُ في الصفّ لنصف ساعة

180
00:16:02,620 --> 00:16:05,610
ماذا؟ أتشعرين بالتوتر بسببي؟

181
00:16:05,610 --> 00:16:07,010
بئساً

182
00:16:07,010 --> 00:16:10,610
إنّها بادرةٌ منّي لتنمية علاقتنا المهنيّة

183
00:16:14,810 --> 00:16:17,160
لا أستطيع السماح بانتظاره
واقفاً في الخارج أيضاً

184
00:16:27,120 --> 00:16:28,020
هل سأدخل؟

185
00:16:28,020 --> 00:16:29,190
!مرحى

186
00:16:31,260 --> 00:16:34,260
اخلع حذاءك عند الباب رجاءً

187
00:16:35,610 --> 00:16:37,760
شكراً لاستضافتي

188
00:16:43,940 --> 00:16:45,750
شقّة ذات غرفة واحدة

189
00:16:45,750 --> 00:16:47,560
لا سرير لديك؟

190
00:16:47,790 --> 00:16:49,960
أليست هذه الشقّة صغيرةً عليك؟

191
00:16:49,960 --> 00:16:52,320
...ولو كنتِ بمفردك

192
00:16:52,320 --> 00:16:54,350
بالمناسبة، هذا كعك مدوّر بالقشدة

193
00:16:54,350 --> 00:16:56,070
يكفينا الشاي بلا إضافات

194
00:16:59,130 --> 00:17:00,920
أهذه أريكة سريريّة؟

195
00:17:01,400 --> 00:17:03,830
إنّها صغيرةٌ قليلاً عليّ

196
00:17:17,190 --> 00:17:19,720
أخبريني، أهذه أنت؟

197
00:17:20,230 --> 00:17:23,010
هل والداك هم من برفقتك؟

198
00:17:25,720 --> 00:17:28,770
لا علاقة لك

199
00:17:38,050 --> 00:17:41,240
لا علاقة لي، لكنّي مهتمّ

200
00:17:41,940 --> 00:17:43,750
فالأمر عنك

201
00:17:57,590 --> 00:17:59,480
ماذا؟ ألن تأكلي؟

202
00:17:59,830 --> 00:18:02,890
هيّا، لم أدسّ شيئاً فيها

203
00:18:08,200 --> 00:18:10,210
هل انتهى عملكِ لليوم؟

204
00:18:10,210 --> 00:18:12,310
رجعتِ متأخّرة

205
00:18:12,310 --> 00:18:14,650
هل لقيتِ عقاباً أو ما شابه؟

206
00:18:19,010 --> 00:18:20,900
أصبت إذاً؟

207
00:18:20,900 --> 00:18:22,910
أشعر بمسؤوليّة

208
00:18:23,820 --> 00:18:26,040
هل فرضوا عليكِ تقييداً؟

209
00:18:34,210 --> 00:18:38,050
كشفت وكالتي تواصلي معك

210
00:18:42,460 --> 00:18:43,300
إذاً؟

211
00:18:43,610 --> 00:18:45,190
إذاً"؟"

212
00:18:45,190 --> 00:18:50,810
بالأصل، لن يستطيع مديرك
قطع صلتنا غالباً

213
00:18:51,750 --> 00:18:54,810
،طالما يجني ربحاً منّي

214
00:18:54,810 --> 00:18:57,820
ستكون المنظّمة من تقع في مشاكل
إذا تسرّب الأمر

215
00:18:58,120 --> 00:19:01,540
بالأحرى، إمّا ستواصل استغلالي

216
00:19:01,540 --> 00:19:05,330
أو ستضطّر للتخلّص منّي

217
00:19:06,190 --> 00:19:08,670
أيّاً يكن، يعود الأمر لك

218
00:19:12,630 --> 00:19:13,860
لا أفهم

219
00:19:16,920 --> 00:19:20,940
أنت تدرك أنّك تجازف بسلامتك

220
00:19:21,540 --> 00:19:25,890
لا أفهم ما الذي تجنيه
بالحفاظ على تواصلك معي

221
00:19:31,650 --> 00:19:33,400
ماذا عنك؟

222
00:19:33,400 --> 00:19:36,050
...ماذا؟ أنا

223
00:19:35,030 --> 00:19:37,780
نحن الاثنان نجازف بأنفسنا، أليس كذلك؟

224
00:19:37,780 --> 00:19:40,730
واجهتِ خطراً لتوّكِ في الواقع

225
00:19:40,730 --> 00:19:42,240
بسبب أمرٍ يخصّني

226
00:19:54,040 --> 00:19:57,900
أنتِ شديدة الحذر، فلمَ لا تصدّيني؟

227
00:19:58,550 --> 00:20:03,570
ألا يمكنك القبض عليّ في هذا
الوضع إن استغللتِ رفاقك؟

228
00:20:05,020 --> 00:20:05,850
أخبريني

229
00:20:07,540 --> 00:20:12,180
ما الذي تسعين لنيله منّي بالضبط؟

230
00:20:13,150 --> 00:20:14,690
...ما الذي تقول

231
00:20:24,860 --> 00:20:27,420
لستُ في البيت حالياً

232
00:20:28,140 --> 00:20:32,210
فلتترك رسالةً بعد سماع الصافرة رجاءً

233
00:20:35,150 --> 00:20:37,610
مرحباً؟ أنا أمّك

234
00:20:37,610 --> 00:20:40,120
آسفة، أعرف أنّكِ مشغولةٌ بعملك

235
00:20:40,120 --> 00:20:42,840
لم تتّصلي بي لفترة

236
00:20:42,840 --> 00:20:44,590
أليس عليكِ الردّ؟

237
00:20:45,170 --> 00:20:47,940
ذكرى وفاة والدك قريبة، أليس كذلك؟

238
00:20:47,940 --> 00:20:49,340
أيمكنك العودة للبيت؟

239
00:20:49,740 --> 00:20:51,800
عاودي الاتّصال بي

240
00:20:51,800 --> 00:20:52,830
إلى اللقاء

241
00:20:54,660 --> 00:21:00,230
،الخامسة وخمس دقائق مساءً
رسالة واحدة مسجّلة

242
00:21:07,330 --> 00:21:08,950
اعذريني، سأرحل

243
00:21:10,950 --> 00:21:12,340
...صحيح

244
00:21:14,940 --> 00:21:17,880
عليكِ ألّا تسمحي لغرباء
بدخول شقّتك ببساطة

245
00:21:18,470 --> 00:21:20,460
فهنالك أشرار

246
00:21:23,460 --> 00:21:24,920
سأتّصل بكِ لاحقاً

247
00:23:36,700 --> 00:23:39,170
الحلقة القادمة: وجهٌ حقيقيّ