1
00:01:47,160 --> 00:01:51,540
:وقت تسلية السّاحرة
فصل النّهاية

2
00:01:52,180 --> 00:01:56,720
نشتبه بساحرة نظراً إلى أنّ القوّة
المُستخدَمة هي قوّة قاهرة

3
00:01:56,720 --> 00:01:59,590
وأيضاً الرّسائل الّتي عثرنا عليها
في مسارح الجريمة

4
00:01:59,980 --> 00:02:03,220
كلّ واحدة منها تشير إلى أنّ القاتلة ساحرة

5
00:02:03,220 --> 00:02:05,200
على سبيل المثال؟

6
00:02:05,200 --> 00:02:09,650
.أعيش مراراً وتكراراً دون تغيُّر"
"أخلف الإرث تلو الإرث دون تغيُّر

7
00:02:09,650 --> 00:02:11,310
هل تعرف ما الّذي يشير إليه ذلك؟

8
00:02:11,310 --> 00:02:15,080
ساحرة. السّاحرات لا يكبرن في السنّ
وصحّتهن لا تتدهور

9
00:02:15,080 --> 00:02:18,150
،وقوّة السّاحرة تنتقل إلى ذُرّيتها

10
00:02:18,150 --> 00:02:20,450
—لذا حتّى إنجاب أطفال لن يغيّر شيـ

11
00:02:21,300 --> 00:02:22,400
ما الأمر؟

12
00:02:22,400 --> 00:02:25,200
يريد القاتل أن يعلن بأنّه ساحرة

13
00:02:25,200 --> 00:02:26,950
"أنا واثقٌ بأنّ كلّ الأجوبة هي "ساحرة

14
00:02:27,220 --> 00:02:28,760
ما رأيك بهذه الرّسالة؟

15
00:02:28,760 --> 00:02:32,750
أربعة سيقان في الصّباح، وساقان"
"في الظّهر، وثلاثة في اللّيل

16
00:02:32,750 --> 00:02:33,710
ساحرة

17
00:02:33,930 --> 00:02:35,560
بشريّ على ما أعتقد

18
00:02:35,560 --> 00:02:36,870
أجل. بشريّ

19
00:02:37,560 --> 00:02:40,500
غريب. هل كانت تلك إحدى الرّسائل؟

20
00:02:40,500 --> 00:02:43,760
أجل. جميعها غير واضحة المعاني تماماً

21
00:02:43,760 --> 00:02:45,970
القاتل يتلاعب بنا

22
00:02:45,970 --> 00:02:51,740
"نُطلِق عليها بقضيّة "وقت تسلية السّاحرة
لأنّ الأمر يبدو لعبة بالنّسبة له

23
00:02:56,360 --> 00:02:58,450
لكن تلك اللّعبة قد عادت لترتدّ عليه

24
00:02:58,450 --> 00:03:03,910
أدركتُ بأنّ بعض الرّسائل كانت
اقتباساتٍ من كتاب

25
00:03:04,520 --> 00:03:07,890
ويبدو أنّ هذه المكتبة كانت
قد طلبتْ نسخة منه

26
00:03:07,890 --> 00:03:09,870
حتّى التّوقيت مُطابِق

27
00:03:10,130 --> 00:03:12,580
أنا مُندهشٌ من تعقّبكِ الاقتباسات

28
00:03:12,580 --> 00:03:16,500
حالفَني الحظُّ فحسب. لديّ نفس
الكتاب في المنزل

29
00:03:19,220 --> 00:03:20,320
رائحة كريهة

30
00:03:24,680 --> 00:03:26,010
!ماذا تعتقدين أنّكِ تفعلين؟

31
00:03:27,200 --> 00:03:28,840
ادخلا

32
00:03:41,600 --> 00:03:42,860
اللّعنة

33
00:03:45,200 --> 00:03:47,910
يُشير الجرح إلى ضررٍ سحريّ

34
00:03:47,910 --> 00:03:51,120
يبدو من الطّبيعي الاستخلاص إلى أنّ
ساحرة هي ما سبّبَتْه

35
00:03:51,120 --> 00:03:54,770
لا بدّ أنّها فقأتْ عينيه لأنّه رأى شيئاً

36
00:03:54,770 --> 00:03:56,750
مُفارقة عجيبة على ما أفترض

37
00:03:57,260 --> 00:03:59,460
،إذا نوَتْ إخفاء أي آثار تقود إليها

38
00:03:59,460 --> 00:04:02,720
فلِمَ تترك اقتباساتٍ كرسائل من الأساس؟

39
00:04:03,150 --> 00:04:07,020
أخبرتُك. إنّها محض لعبة بالنّسبة لها

40
00:04:07,020 --> 00:04:10,930
لعلّها قرّرَتْ فحسب أن تقتل هذا الرّجل أيضاً

41
00:04:10,930 --> 00:04:13,030
فقدنا دليلَنا

42
00:04:13,030 --> 00:04:16,650
تبدين مُرهَقة. ربّما يجدر بكِ
أخذ قسط من الرّاحة؟

43
00:04:17,330 --> 00:04:19,890
لا ينبغي أن تقترب منّي كثيراً

44
00:04:20,260 --> 00:04:21,220
لِمَ لا؟

45
00:04:21,880 --> 00:04:23,350
بسبب سوابق

46
00:04:24,440 --> 00:04:27,340
الاقتراب منّي لا ينجم عن شيء حميد

47
00:04:30,860 --> 00:04:31,910
ما الأمر؟

48
00:04:31,910 --> 00:04:35,370
حضرة السيّدة هاينيس، عثرنا
على جثّة جديدة هنا أيضاً

49
00:04:35,890 --> 00:04:37,530
ورسالة

50
00:04:37,530 --> 00:04:38,840
ما محتواها؟

51
00:04:41,440 --> 00:04:43,420
أنا مرض

52
00:04:43,420 --> 00:04:46,630
مرض يتكاثر وينتشر

53
00:04:46,630 --> 00:04:50,710
يُدعى هذا المرض باللّعنة. لعنة ساحرة

54
00:04:53,170 --> 00:04:57,480
رغم أنّني أدخلتُك مسرح الجريحة، إلّا أنّك
لم تتمكّن من اكتشاف الكثير

55
00:04:57,730 --> 00:05:01,080
هذا طبيعيّ. فالجثث ليست من صلب اختصاصي

56
00:05:01,080 --> 00:05:03,490
حسناً، لا أتأمّل الكثير على أي حال

57
00:05:03,990 --> 00:05:04,700
إلى اللِّقاء

58
00:05:09,220 --> 00:05:10,240
آشاف

59
00:05:10,990 --> 00:05:12,240
نعم؟

60
00:05:12,240 --> 00:05:14,710
استعدّ. ثمّة شيء هنا

61
00:05:14,710 --> 00:05:16,540
حقّاً؟ لا بدّ أنّكِ تمزحين

62
00:05:17,000 --> 00:05:19,120
تركتُ التّابوتَ في الفندق

63
00:05:21,690 --> 00:05:23,800
!غبيّة! لا تقتحمي بصورة عمياء

64
00:05:37,820 --> 00:05:39,150
!اختفَتْ

65
00:05:39,380 --> 00:05:43,180
هذا واضح. كما الدُّخان حرفيّاً

66
00:05:43,180 --> 00:05:45,920
إذاً إنّها قويّة ومُحترِفة في الهرب أيضاً؟

67
00:05:45,920 --> 00:05:47,860
أعتقد حصلنا على عملٍ مُخصّصٍ لنا

68
00:05:48,350 --> 00:05:50,360
...رغم ذلك، لماذا السّاحرة

69
00:05:50,360 --> 00:05:51,830
كانت تتعقّبها

70
00:05:52,200 --> 00:05:53,080
ماذا؟

71
00:05:53,320 --> 00:05:57,120
منذ التقينا بتلك المرأة، شعرتُ
أنّ شخصاً ما يُراقبنا

72
00:05:57,120 --> 00:05:59,290
يبدو أنّني لم أكن أتخيّل ذلك

73
00:05:59,290 --> 00:06:00,110
!تبّاً

74
00:06:06,170 --> 00:06:08,260
أودُّ أن أطرح عليكِ سؤالاً

75
00:06:09,720 --> 00:06:11,470
ماذا حدث لكِ؟

76
00:06:11,470 --> 00:06:13,470
دخلنا في عِراك قصير مع السّاحرة

77
00:06:13,470 --> 00:06:14,560
وضللتُماها؟

78
00:06:14,560 --> 00:06:16,430
أجل، تماماً

79
00:06:16,430 --> 00:06:17,420
هكذا إذاً

80
00:06:17,770 --> 00:06:20,150
لهذا أملي بكما ضعيف

81
00:06:20,850 --> 00:06:22,980
تلقّيتِ ضرباً مُبرِحاً

82
00:06:22,980 --> 00:06:25,190
عالجتُها سلفاً

83
00:06:25,190 --> 00:06:27,620
الأهمّ، أجيبي عن سؤالي رجاء

84
00:06:28,610 --> 00:06:31,170
ما مدى ارتباطكِ بالسّاحرة؟

85
00:06:31,170 --> 00:06:32,160
ماذا؟

86
00:06:32,590 --> 00:06:34,950
يبدو أنّه كان هناك من يُلاحقكِ

87
00:06:35,200 --> 00:06:37,690
،من الواضح أنَّ السّاحرة تعرف شكلكِ

88
00:06:37,690 --> 00:06:42,560
لذا يمكننا أن نفترض وبثِقة أنّها
كانت تتعقّبكِ أنتِ، لا نحن

89
00:06:42,560 --> 00:06:45,850
وإلّا فلماذا تحاول السّاحرة أن تشدّد
على الإعلان عن هويّتها؟

90
00:06:45,850 --> 00:06:48,170
ربّما لتعبئة الفُرسان

91
00:06:48,170 --> 00:06:50,400
من يأبه لمُقاتلة ضعفاء؟

92
00:06:50,400 --> 00:06:53,930
لكن مهما حاولتْ أن تنتظر، لا يُعارضها
إلّا رجال الشّرطة

93
00:06:53,930 --> 00:06:56,890
...لذا لاستدراج الفُرسان

94
00:06:57,220 --> 00:06:59,600
غيدو، ماذا كنتِ لتفعلين؟

95
00:07:00,000 --> 00:07:02,220
أقتل الضّعفاء

96
00:07:02,220 --> 00:07:02,940
...أو

97
00:07:03,280 --> 00:07:05,630
أقضي على زعيمهم

98
00:07:07,350 --> 00:07:10,810
أنانيّة المُحافِظ هي ما سبّبَتْ هذه الفوضى

99
00:07:10,810 --> 00:07:13,340
لكن لا يعلم بذلك إلّا المُطّلعين
على بواطن الأمور

100
00:07:13,340 --> 00:07:18,810
مُعظم النّاس كانوا ليفترضوا أنّ الشّرطة
ستخسر لولاكِ، مُحاربتهم الحقيقيّة الوحيدة

101
00:07:19,230 --> 00:07:22,500
،ومع هذا، بالرُّغم من كلّ ذلك وأيضاً تعقّبها لكِ

102
00:07:22,500 --> 00:07:26,340
انتظرت السّاحرةُ حتّى نتفرّق، ثمّ استهدفَتْنا نحن

103
00:07:26,860 --> 00:07:28,320
لماذا؟

104
00:07:28,320 --> 00:07:30,220
!لماذا لا تستهدفني أنا؟

105
00:07:30,560 --> 00:07:32,810
!لماذا تتبعني إذا كانت لا تريد قتلي؟

106
00:07:33,280 --> 00:07:36,180
لا أعلم. لهذا سألت

107
00:07:36,390 --> 00:07:37,740
...أيُعقَل

108
00:07:37,740 --> 00:07:39,480
...هل من المعقول

109
00:07:39,480 --> 00:07:43,150
!إذاً تعرفين شيئاً. تكلّمي

110
00:07:44,610 --> 00:07:48,780
كان لهذه القضيّة بداية بالطّبع

111
00:07:50,290 --> 00:07:52,240
نادراً ما أراكِ في هذا الوقت المُبكِّر يا كيرا

112
00:07:52,550 --> 00:07:55,340
دائماً ما أغادر متأخّرة. إذا لم أعُد
إلى المنزل باكراً

113
00:07:55,340 --> 00:07:59,040
،وآكل مع الأطفال متى سنحت لي الفُرصة
فأيّ أمّ سوف أكون؟

114
00:08:00,480 --> 00:08:01,750
!سيّدة هاينيس

115
00:08:02,340 --> 00:08:03,210
ما الأمر؟

116
00:08:04,500 --> 00:08:06,300
...إنَّ منزلكِ

117
00:08:09,590 --> 00:08:11,670
!سيّدة هاينيس. هذا خطير

118
00:08:11,670 --> 00:08:13,630
!أطفالي هناك في الدّاخل

119
00:08:14,050 --> 00:08:16,350
!شولك! لوران

120
00:08:22,170 --> 00:08:23,960
هل كان هناك شهود؟

121
00:08:23,960 --> 00:08:26,440
مدّنا السُّكّانُ المحلّيون بمعلومات

122
00:08:26,760 --> 00:08:30,900
ونعتقد بأنّ الجاني ترك رسالة على جدار
في الطّرف المقابل من الشّارع

123
00:08:33,700 --> 00:08:38,580
.أعيش مراراً وتكراراً دون تغيُّر"
"أخلف الإرث تلو الإرث دون تغيُّر

124
00:08:38,860 --> 00:08:40,770
ما معناه يا تُرى؟

125
00:08:41,180 --> 00:08:42,230
ساحرة

126
00:08:45,580 --> 00:08:47,810
إنّه الوقت الّذي كان مُدوَّناً في رسالة التّحذير

127
00:08:47,810 --> 00:08:48,620
أجل

128
00:08:51,320 --> 00:08:53,440
!اللّعنة! هذا الدُّخان الأرجوانيّ من جديد

129
00:08:53,440 --> 00:08:55,000
!لا نستطيع الرّؤية بوضوح

130
00:08:55,000 --> 00:08:57,390
!جميعكم، احتموا داخل المصفوفة السّحريّة

131
00:08:57,800 --> 00:08:59,010
!ماذا تفعل يا ريوبين؟

132
00:08:59,010 --> 00:09:00,300
سوف أقضي عليها

133
00:09:00,300 --> 00:09:02,700
!لوحدك؟ هذا جنون! إنّها ساحرة

134
00:09:02,700 --> 00:09:07,020
!أجل، أعلم. السّاحرة الّتي قتلت ذلكما الطّفلين

135
00:09:20,300 --> 00:09:23,250
خسرتُ ابنَي وريوبين

136
00:09:24,180 --> 00:09:28,300
كان مُعلّمي في السّحر... وحبيبي

137
00:09:31,840 --> 00:09:34,320
...أعتقد أنّ ذلك التّحذير كانت الغاية منه

138
00:09:34,320 --> 00:09:36,920
ما أخبرتَني به يشرح الأمر

139
00:09:37,600 --> 00:09:40,120
كان لاستدراجه وقتله

140
00:09:40,780 --> 00:09:43,510
تستهدف السّاحرةُ أُناساً يهمّني أمرهم

141
00:09:44,320 --> 00:09:46,690
أصبحتُما ودودين جدّاً معي

142
00:09:46,690 --> 00:09:49,050
أي أنّنا جعلناها تسيء الفهم؟

143
00:09:49,050 --> 00:09:51,120
لكن هذا يوضّح بعض الأمور

144
00:09:51,120 --> 00:09:53,650
من المؤكَّد أنّ السّاحرة تضمر ضغينةً تجاهكِ

145
00:09:53,650 --> 00:09:54,910
هل لديكِ فكرة عن السّبب؟

146
00:09:54,910 --> 00:09:56,490
بالطّبع لا

147
00:09:56,490 --> 00:09:57,810
لكن هذا مثاليّ

148
00:09:58,260 --> 00:10:02,950
،إذا كنتُ أسبِّب لها وسواساً
فقد أحظى بفُرصة للانتقام

149
00:10:03,220 --> 00:10:05,060
انتقام؟

150
00:10:05,060 --> 00:10:08,960
فهمت. لهذا إذاً تماشيتِ مع أكاذيب المُحافظ

151
00:10:09,640 --> 00:10:10,960
هل تلومني؟

152
00:10:11,910 --> 00:10:15,930
،أعطي الأولويّة لانتقامي على حياة المُواطنين

153
00:10:15,930 --> 00:10:18,430
وأظلُّ أكدِّس ضحايا بلا ضرورة

154
00:10:18,830 --> 00:10:22,440
لا أملك حسّ الواجب والعدالة اللّتين
ينبغي لمُتحرٍّ أن يملكهما

155
00:10:22,870 --> 00:10:25,890
لن أنتقدكِ، لكن هل أنتِ مُتيقّنة؟

156
00:10:26,220 --> 00:10:27,770
تبدين في حالةٍ بائسة

157
00:10:27,770 --> 00:10:29,440
لا تتكلّم وكأنّك تفهم

158
00:10:30,000 --> 00:10:33,540
حتّى لو أخذتِ بثأركِ، من سيحتفل بذلك؟

159
00:10:33,540 --> 00:10:34,860
!أعلم

160
00:10:35,190 --> 00:10:39,620
،أعلم بأنّني لستُ قويّة بما يكفي
وأنّه لا أحد يتمنّى الانتقام

161
00:10:39,620 --> 00:10:41,870
!ليس عليك أن تخبرني بذلك

162
00:10:41,870 --> 00:10:47,700
لكن ما زلتُ عاجزة عن فعل شيء
حيال هذا الألم... هذه الكراهيّة

163
00:10:49,200 --> 00:10:50,670
ما هذا؟

164
00:10:50,670 --> 00:10:53,520
لا تنفكّين تتفوّهين بهراء غير مفهوم

165
00:10:53,520 --> 00:10:56,250
إذا أردتِ ردّ الاعتبار، فماذا تنتظرين؟

166
00:10:56,960 --> 00:10:58,970
من يأبه لأجل من تفعلين ذلك؟

167
00:10:59,250 --> 00:11:01,010
قلتِها بنفسكِ

168
00:11:01,010 --> 00:11:02,740
سوف تقتلينها لأنّكِ تكرهينها

169
00:11:02,740 --> 00:11:04,810
ستقتلينها لأنّكِ تريدين الرّاحة

170
00:11:05,020 --> 00:11:07,230
شعور الانتقام رائع

171
00:11:08,270 --> 00:11:10,040
ما-ما الّذي تقولينه؟

172
00:11:10,040 --> 00:11:11,370
!لستُ مثلكِ

173
00:11:11,370 --> 00:11:13,190
لِمَ تشجّعينها؟

174
00:11:13,190 --> 00:11:14,280
!سيّدة هاينيس

175
00:11:15,000 --> 00:11:16,530
!أرسلت السّاحرةُ تحذيراً

176
00:11:16,530 --> 00:11:18,990
!إنّها قادمة إلى مركز الشّرطة بعد ثلاثة أيّام

177
00:11:19,410 --> 00:11:23,530
يا إلهي. لا بدّ أنّها تريد أن تقتل
شخصاً هناك مهما كلّفَ الثّمن

178
00:11:23,530 --> 00:11:25,010
هل يمكنني الوثوق بكما؟

179
00:11:25,860 --> 00:11:29,790
هل يمكنني الوثوق بكما في مُضاهاة السّاحرة؟

180
00:11:29,790 --> 00:11:31,300
يمكنكِ ذلك

181
00:11:32,760 --> 00:11:34,210
...سأعلّمكِ

182
00:11:34,800 --> 00:11:37,900
كيف أنّ طعم الانتقام حلوٌ

183
00:11:44,970 --> 00:11:48,930
التّعويذة الرّئيسيّة للسّاحرة هي الدُّخان
الأرجوانيّ. لا أعرف آليّة عملها

184
00:11:49,480 --> 00:11:53,200
،يمكنها سحق مُعظم الأشياء به
أو قذفهم بعيداً

185
00:11:53,200 --> 00:11:55,020
يمكن استخدامه أيضاً كسِتار دُخانيّ

186
00:11:55,970 --> 00:11:59,250
أعتقد أنّ تعويذة الاختفاء خاصّتها
هي همُّنا الأكبر

187
00:12:00,380 --> 00:12:04,210
بالمناسبة، ماذا فعلت بتلك الأكياس
الجلديّة الّتي أعطيتُك إيّاها؟

188
00:12:04,210 --> 00:12:05,700
لا شيء مُحدَّد

189
00:12:07,770 --> 00:12:10,790
،بخصوص غيدو... أتفهّم ما قالَتْه

190
00:12:11,330 --> 00:12:16,210
،لكن إذا تمكنّا من هزيمة هذه السّاحرة
فهل ذلك سوف يشجّع الجميعَ قليلاً؟

191
00:12:16,890 --> 00:12:18,780
أجل، أنا متأكّدٌ من أنّه كذلك

192
00:12:19,670 --> 00:12:21,120
تأخّرَتْ

193
00:12:21,120 --> 00:12:23,310
هضمتُ كلَّ ما أكلتُه بالفعل

194
00:12:23,310 --> 00:12:25,640
أعيرينا انتباهاً أيضاً أيّتها الحقيرة

195
00:12:26,030 --> 00:12:27,600
كيف حالكِ؟

196
00:12:27,600 --> 00:12:28,830
!ماذا؟

197
00:12:28,830 --> 00:12:30,670
لِمَ تتصرّفين كفتاة عصابة شوارع؟

198
00:12:31,350 --> 00:12:35,470
على أي حال، كيف تخطِّطان لمُواجهة السّاحرة؟

199
00:12:35,470 --> 00:12:37,000
اصمتي وراقبي

200
00:12:40,000 --> 00:12:40,980
!انتظري لحظة

201
00:12:41,390 --> 00:12:43,750
هل تقصدين أنّكِ تعتمدين على هذا الاحتمال؟

202
00:12:43,750 --> 00:12:46,630
يجب أن تعرفي كيفيّة إلغاء لعنة ساحرة

203
00:12:46,630 --> 00:12:51,670
إمّا أن تُقبّلي حبّكِ الحقيقيّ، أو جعل السّاحرة
الّتي أطلقت اللّعنة تلغيها. فقط لا غير

204
00:12:51,670 --> 00:12:54,980
هل يمكنكِ أن تثبتي بأنّ هذه السّاحرة
هي الّتي لعنَتْكِ؟

205
00:12:54,980 --> 00:12:56,500
بالطّبع لا

206
00:12:56,500 --> 00:12:57,820
لا تقلقي

207
00:12:58,500 --> 00:13:02,500
في الواقع، هناك طريقة إضافيّة لإلغاء اللّعنة

208
00:13:03,310 --> 00:13:06,000
وهذا ما نراهن عليه

209
00:13:06,000 --> 00:13:09,890
إذا واجهنا ساحرة واستوفينا شروطاً
مُعيّنة، سوف نشهد عودة

210
00:13:10,220 --> 00:13:12,650
وحش حتّى السّاحرات تخشينه

211
00:13:14,860 --> 00:13:16,230
جاءتْ

212
00:13:19,830 --> 00:13:20,940
إنّي أراها

213
00:13:21,270 --> 00:13:22,070
!استعدّوا

214
00:13:22,670 --> 00:13:24,300
لا تستبقي الأمور يا غيدو

215
00:13:24,300 --> 00:13:25,110
ماذا؟

216
00:13:32,520 --> 00:13:35,330
يا إلهي. هيَجان من اللّحظة الأولى

217
00:13:37,340 --> 00:13:38,640
ما هذا الصّوت؟

218
00:13:38,640 --> 00:13:41,130
!توخّوا الحذر! عادَتْ إلى ألاعيبها القديمة

219
00:13:42,410 --> 00:13:44,100
!ماذا حدث للتو؟

220
00:13:44,100 --> 00:13:48,110
نظراً إلى الرّؤية الضبابيّة، لا يمكننا
الهجوم بطَيش لأنّ معنا حُلفاء

221
00:13:48,110 --> 00:13:50,480
لكن خصمنا متحرّر

222
00:13:52,610 --> 00:13:54,350
إنّه موقف لا نُحسَد عليه

223
00:14:07,880 --> 00:14:09,280
هل أنتم بخير؟

224
00:14:09,280 --> 00:14:13,850
أجل. أستطيع تدبُّر أمري ما دمتُ
أركِّز فقط على البقاء حيّة

225
00:14:15,250 --> 00:14:16,130
!غيدو

226
00:14:17,350 --> 00:14:18,460
!تلك الحقيرة

227
00:14:18,460 --> 00:14:22,940
هذا جيّد. معنى ذلك أنّنا حافظنا
على خسائرنا ضمن الحدّ الأدنى

228
00:14:22,940 --> 00:14:26,590
!هذا سيّئ. دعوني أقتلها فحسب

229
00:14:26,840 --> 00:14:30,390
ما الفائدة من القتال إذا كان عدوّنا
يمتلك وسيلةً للهرب؟

230
00:14:30,390 --> 00:14:32,890
ينبغي أن نحاصرها قبل أن نهاجمها

231
00:14:32,890 --> 00:14:35,320
فعلتُ كلَّ ما طلبتَه حتّى الآن

232
00:14:35,320 --> 00:14:37,850
حريّ بك أن تمتلك خطّة لما هو آتٍ

233
00:14:37,850 --> 00:14:40,590
لا مُشكلة. فقد عثرتُ عليها بالفعل

234
00:14:41,340 --> 00:14:42,770
...كيف بالتّحديد

235
00:14:43,600 --> 00:14:46,230
هل لاحظتِ أنّه يوجد عددٌ أكبر
من الغربان في الآونة الأخيرة؟

236
00:14:48,670 --> 00:14:50,950
إنّهم أقراني

237
00:14:51,270 --> 00:14:56,750
ويمكنني رؤية كلّ شيء يرونه هم

238
00:14:57,390 --> 00:15:00,000
لذا لا يمكنها الإفلات منّا الآن، أينما ذهبَتْ

239
00:15:00,770 --> 00:15:04,550
والآن، هل نذهب لنقابل ساحرة؟

240
00:15:31,110 --> 00:15:31,820
!ماذا؟

241
00:15:35,130 --> 00:15:38,410
يا إلهي. هل يجب عليكِ الاقتحام
بمفردكِ في كلّ مرّة؟

242
00:15:38,880 --> 00:15:41,370
آشاف، هناك اثنان

243
00:15:41,670 --> 00:15:45,130
!لا، انسَ ذلك. اللّعنة

244
00:15:45,130 --> 00:15:48,280
!هذان الحقيران ليسا ساحرتين

245
00:15:48,530 --> 00:15:52,020
شخص آخر. كيف عثروا علينا؟

246
00:15:52,760 --> 00:15:54,470
!هل نجوتَ يا رجل؟

247
00:15:54,470 --> 00:15:57,180
أجل. هل خلتَ أنّك قتلتني؟

248
00:15:57,180 --> 00:16:00,500
حسناً، من الطبيعيّ أن تعتقد ذلك
بعد تلك الفوضى

249
00:16:00,500 --> 00:16:03,170
لسوء حظّكما، أثِق بالمجالات خاصّتي

250
00:16:03,170 --> 00:16:06,090
اللّعنة. هذا الرّجل مُستخدِم سحر

251
00:16:06,090 --> 00:16:07,610
هل أنتما بمفردكما؟

252
00:16:11,710 --> 00:16:15,010
...ما الّذي يجري هنا؟ مستحيل

253
00:16:15,010 --> 00:16:18,580
أنتما على قيدِ الحياة يا شولك؟ لوران؟

254
00:16:20,020 --> 00:16:22,010
تبّاً

255
00:16:22,010 --> 00:16:24,890
أنتِ آخر شخص أردنا أن يكتشف ذلك

256
00:16:25,610 --> 00:16:26,910
تعرفينهما؟

257
00:16:27,740 --> 00:16:31,880
إنّهما ابنايّ. اللّذان أخبرتُك بأنَّ السّاحرة قتلتهما

258
00:16:32,400 --> 00:16:33,590
لكن كيف؟

259
00:16:34,210 --> 00:16:35,740
ماذا تفعلان هنا؟

260
00:16:37,050 --> 00:16:38,200
...أيُعقَل

261
00:16:39,520 --> 00:16:40,770
!هذا مستحيل

262
00:16:41,190 --> 00:16:41,980
...لوران

263
00:16:41,980 --> 00:16:43,180
...شولك

264
00:16:43,960 --> 00:16:46,270
كنتُما السّاحرة؟

265
00:16:46,270 --> 00:16:48,560
لا، هذا مستحيل

266
00:16:48,560 --> 00:16:51,440
أعلم بأنّكما لا تمتلكان ذلك النّوع من القوّة

267
00:16:51,670 --> 00:16:54,250
انظري إلى ما يحملانه يا كيرا

268
00:16:55,520 --> 00:16:58,320
هذه هي الحقيقة وراء قوّتهما الشّبيهة بقوّة السّاحرات

269
00:16:59,090 --> 00:17:02,540
الكِتاب السّحريّ ذو المُجلّدين، سارنواسوس

270
00:17:02,540 --> 00:17:04,000
كِتاب سحريّ؟

271
00:17:04,430 --> 00:17:08,190
توفّر الكُتُب السّحريّة قوّةً وتعويذات لحامليها

272
00:17:08,190 --> 00:17:10,860
الموهبة السّحريّة غير مطلوبة

273
00:17:10,860 --> 00:17:13,940
مجرّد امتلاك كتاب يمنح قوّةً
نظيرة تقريباً لقوّة ساحرة

274
00:17:13,940 --> 00:17:17,720
إنّه من الأدوات المُحرَّمة والّتي تُعتبَر
من محظورات السّحر الأسود

275
00:17:17,720 --> 00:17:21,460
وكلّ مُجلّد من مُجلّدَي الكتاب السّحريّ

276
00:17:21,460 --> 00:17:24,680
يستطيع استدعاء النّصفَ الآخر
بشكلٍ فوريّ عبر الفضاء

277
00:17:24,680 --> 00:17:28,150
لكن فقط نحو مسافة تُقدَّر تقريباً بـ1 كيلومتر

278
00:17:31,070 --> 00:17:32,860
من هذا الرّجل؟

279
00:17:32,860 --> 00:17:36,170
من أين حصلتُما على شيء كهذا؟

280
00:17:36,170 --> 00:17:38,910
!عمّاذا تتكلّمين؟ كانا على مقعدكِ

281
00:17:38,910 --> 00:17:39,820
ماذا؟

282
00:17:40,100 --> 00:17:42,660
!لا يحقّ لكِ مُعاقبتنا

283
00:17:42,910 --> 00:17:45,620
!أنتِ السّبب فيما انتهى بنا الحال

284
00:17:45,910 --> 00:17:48,300
!نحن لا نقتل رغبةً منّا

285
00:17:48,300 --> 00:17:52,340
،تمنحنا هذه الكتُب السّحريّة القوّة
!لكن يترتّب علينا إطعامها بشراً

286
00:17:52,340 --> 00:17:55,470
!سيأكلاننا إذا لم نقدّم لهما القرابين

287
00:17:55,470 --> 00:17:57,590
!إنَّ لمس الكُتُب السّحريّة هو ما جعلَنا هكذا

288
00:17:57,590 --> 00:17:59,860
!لذا كنّا مضطرين للقتل

289
00:17:59,860 --> 00:18:01,250
...لا

290
00:18:03,690 --> 00:18:05,570
هذه حجّة جيّدة

291
00:18:05,570 --> 00:18:08,480
،رأيتُ جثثَ بضعة أشخاص قتلتُماهم

292
00:18:08,790 --> 00:18:11,940
ومن الواضح أنّكما استمتعتُما بكلِّ لحظة

293
00:18:12,370 --> 00:18:16,200
كنتُما مضطرّين؟ لم يكن لديكما خيار؟

294
00:18:16,720 --> 00:18:18,150
...إذاً

295
00:18:18,150 --> 00:18:21,010
!لماذا قتلتُما ريوبين؟

296
00:18:21,010 --> 00:18:23,370
!كان يحبّكما أيضاً

297
00:18:25,130 --> 00:18:26,460
هذا يكفي

298
00:18:26,930 --> 00:18:29,940
لسنا مَدينين لكِ بكافّة الأجوبة

299
00:18:30,420 --> 00:18:32,960
!وهذه معركة حتّى الموت

300
00:18:36,050 --> 00:18:37,300
،لسوء حظّكما

301
00:18:37,630 --> 00:18:41,680
هناك ثلاثة أسباب تجعلكما لا تملكان فُرصة أمامنا

302
00:18:41,680 --> 00:18:42,850
ماذا؟

303
00:18:42,850 --> 00:18:47,310
أوّلاً، فشلتُما في دفع ثمن كتابِكما السّحريّ

304
00:18:47,650 --> 00:18:49,040
!عمّاذا تتكلّم؟

305
00:18:49,040 --> 00:18:52,040
!قتلنا عشرة أشخاص على الأقلّ اليوم

306
00:18:52,040 --> 00:18:53,210
!قدّمنا قرابيننا

307
00:18:53,210 --> 00:18:55,590
تقصد هذه؟

308
00:18:59,690 --> 00:19:00,820
!ما هذا بالضّبط؟

309
00:19:01,200 --> 00:19:05,440
مجرّد دُمية. كيس جلديّ
محشوّ بسائل أحمر

310
00:19:05,440 --> 00:19:08,140
،إنّهم مكشوفون عند إمعان النّظر فيهم

311
00:19:08,140 --> 00:19:11,250
لكن دخانكما جعلَ الرّؤية صعبة للغاية

312
00:19:11,250 --> 00:19:12,800
!وماذا يعني؟

313
00:19:12,800 --> 00:19:16,350
!بهذه القوّة، يمكننا قتل قدر ما نحتاج

314
00:19:16,920 --> 00:19:18,090
!سوف أسحقك

315
00:19:26,610 --> 00:19:29,810
...السّبب الثّاني، حتّى من دون إلغاء اللّعنة

316
00:19:32,300 --> 00:19:34,440
نحن قويّان نسبيّاً

317
00:19:37,530 --> 00:19:40,400
حسناً، يبدو أنّنا لسنا بحاجة
للإدلاء بالسّبب الثّالث

318
00:19:40,400 --> 00:19:43,890
أنتما أيُّها الوقحان لا تملكان المُؤهّلات
الّتي تجعلكما ساحرتين

319
00:19:43,890 --> 00:19:45,180
حقيران

320
00:19:48,390 --> 00:19:50,580
لماذا تظاهرتُما بأنّكما ساحرتان؟

321
00:19:51,200 --> 00:19:54,540
وذلك كي لا نضطرّ لمُقاتلتكِ

322
00:19:54,900 --> 00:19:59,120
كنتِ صغيرة جدّاً على أن تكوني أمّنا

323
00:19:59,120 --> 00:20:02,010
لم نستطع النّظر إليكِ إلّا كامرأة

324
00:20:02,340 --> 00:20:05,880
لم نكن نستطيع أن ندع أحداً
يقترب منكِ يا كيرا

325
00:20:06,820 --> 00:20:08,300
!نحن نحبّكِ

326
00:20:08,300 --> 00:20:10,810
!وأنتِ تحبّيننا أيضاً! أليس كذلك يا كيرا؟

327
00:20:11,440 --> 00:20:14,140
إن كنتِ لن تُنهي هذا، فاغربي
عن وجهي ودعيني أفعلها أنا

328
00:20:15,000 --> 00:20:16,200
لا مُشكلة

329
00:20:18,260 --> 00:20:19,780
سأفعلها أنا

330
00:20:19,780 --> 00:20:21,330
!ا-انتظري

331
00:20:21,330 --> 00:20:23,360
!لماذا؟! لماذا تتخلّين عنّا؟

332
00:20:23,600 --> 00:20:26,120
!قلتِ بأنّكِ تحبّيننا

333
00:20:26,410 --> 00:20:27,780
أحبّكما

334
00:20:28,550 --> 00:20:30,210
لكن تماديتُما

335
00:20:31,020 --> 00:20:33,440
فأنا الآن لا أشفق عليكما حتّى

336
00:20:37,900 --> 00:20:40,340
لماذا تبنّيتِنا إذاً؟

337
00:20:41,700 --> 00:20:43,630
لأنّني أردتُكما أن تعرفا

338
00:20:43,630 --> 00:20:44,630
نعرف ماذا؟

339
00:20:44,980 --> 00:20:46,900
معنى الحبّ المُتبادَل

340
00:20:47,630 --> 00:20:49,660
مثل هذه الأمور العاديّة

341
00:20:53,610 --> 00:20:57,640
قضيّة وقت تسلية السّحرة، والّتي
،آلمت هايدين لفترة طويلة

342
00:20:57,640 --> 00:20:59,900
،ظُنَّ بأنّها من صنيع ساحرة

343
00:20:59,900 --> 00:21:04,200
لكن تبيّن للتو أنَّ من ارتكبَ سلسلة
جرائم القتل كان اثنين من الفتية

344
00:21:04,430 --> 00:21:08,660
آشاف. كنتَ تعلم بأنّ السّاحرة مُزيّفة، أليس كذلك؟

345
00:21:08,950 --> 00:21:13,040
منظّمة ضليعة في الأمور السرّية كنظامنا
سرعان ما سيكشف زيف الأمور

346
00:21:13,040 --> 00:21:17,540
لو كانت قضيّة ساحرات حقيقيّة لما ادّخر
فيلق الفُرسان لحظة في التدخُّل

347
00:21:17,800 --> 00:21:19,450
سوف تدفع الثّمن حالما أنتهي من الأكل

348
00:21:19,450 --> 00:21:21,620
مهلاً، مهلاً. كوني منطقيّة

349
00:21:22,470 --> 00:21:23,510
مرحباً

350
00:21:23,950 --> 00:21:24,790
كيرا

351
00:21:26,170 --> 00:21:27,530
شكراً

352
00:21:27,530 --> 00:21:30,820
ما كان لدينا أمل لولاكما

353
00:21:30,820 --> 00:21:31,930
نؤدّي عملنا فحسب

354
00:21:32,430 --> 00:21:35,140
وسنأخذ الكتابين السّحريّين معنا

355
00:21:35,810 --> 00:21:37,050
...الكتابان السّحريّان

356
00:21:37,050 --> 00:21:40,030
لا أتذكّر بأنّني رأيتُهما من قبل حتّى

357
00:21:40,030 --> 00:21:42,140
للأدوات المُحرَّمة إرادة خاصّة

358
00:21:42,140 --> 00:21:44,740
إنّها تعثر على الشّخص المُناسب
في الزّمان المُناسب

359
00:21:45,040 --> 00:21:47,630
تقصد بأنّهما وصلا إلى هناك من تلقاء نفسيهما؟

360
00:21:47,630 --> 00:21:50,170
قد يكون هذا ما حدث فحسب

361
00:21:50,960 --> 00:21:53,580
،لم يكونا صبيّين مهذّبين تماماً

362
00:21:53,580 --> 00:21:58,300
لكن ما كان ليؤول الأمر بهما إلى ما آل إليه
لولا الكتابين السّحريّين

363
00:21:59,330 --> 00:22:02,590
الموت الّذي كانا سيتكّبدانه مقابل
الفشل في دفع الثّمن

364
00:22:02,590 --> 00:22:05,140
كان ليكون أفظع بكثير

365
00:22:09,540 --> 00:22:10,730
أستأذن بالانصراف الآن

366
00:22:12,020 --> 00:22:12,860
كيرا

367
00:22:14,550 --> 00:22:18,270
إذا واجهتكِ أي مُشكلة أخرى، فاتّصلي بنا

368
00:22:21,680 --> 00:22:22,860
حسناً

369
00:22:23,810 --> 00:22:25,110
سوف أتّصل بكما

370
00:22:25,580 --> 00:22:29,140
إذا ظهرَتْ ساحرة، ثِقا بي

371
00:24:00,450 --> 00:24:06,460
بالطبع، نحن نستعين باختصاصي استحضار أرواح

372
00:24:06,460 --> 00:24:10,710
الجمال والموت

373
00:24:06,460 --> 00:24:10,710
فصل الافتتاحيّة

374
00:24:06,710 --> 00:24:09,880
"الحلقة القادمة: "الجمال والموت: فصل الافتتاحيّة