1
00:00:01,560 --> 00:00:05,190
وحدهم الموتى الأحياء مَن يستطيعون
رؤية ضوء هذا المصباح

2
00:00:05,190 --> 00:00:08,650
وفي عيون أولئك الّذين فقدوا
،عقلهم بسبب الإهمال

3
00:00:08,650 --> 00:00:10,800
يسطع ببريق أكبر

4
00:00:12,610 --> 00:00:15,910
،اخترتُ منطقةً مهجورةً لتخفيف المخاطر

5
00:00:16,700 --> 00:00:19,870
لكن يبدو أنّنا توصّلنا إلى ما نريد دون قصد

6
00:00:21,030 --> 00:00:23,680
يظلّ الأثر يمتدّ عبر هذا الطّريق

7
00:00:28,440 --> 00:00:30,480
،باستحضار الأرواح

8
00:00:31,500 --> 00:00:34,950
لا فُراق يدوم للأبد

9
00:00:39,200 --> 00:00:40,640
ماذا فعلت؟

10
00:00:41,770 --> 00:00:43,680
!ماذا فعلت؟

11
00:00:44,350 --> 00:00:47,140
،سيكون هذا كافياً بالنّسبة له

12
00:00:47,140 --> 00:00:52,990
،لكن بالنّسبةِ لكِ يا امرأة، بالرُّغم من جهودي
لم أستطع معرفة شيء عنكِ

13
00:00:52,990 --> 00:00:56,960
سألزِم نفسي بعرض صفقة الآن

14
00:01:03,750 --> 00:01:04,790
!يوهان

15
00:01:06,400 --> 00:01:10,090
افعلي ما أمليه، وسوف ترينه ثانية قريباً

16
00:01:10,560 --> 00:01:12,940
والآن، اتبعيني

17
00:03:20,870 --> 00:03:25,430
المعذرة... لا بدّ أنّ إجراء عمليّة
تشريحيّة لها أمر صعبٌ عليك

18
00:03:25,960 --> 00:03:27,190
ما رأيك أن أتولّى عنك؟

19
00:03:28,130 --> 00:03:29,650
لا داعي لذلك

20
00:03:30,280 --> 00:03:32,830
لا مُشكلة لديّ

21
00:03:32,830 --> 00:03:34,850
هكذا إذاً

22
00:03:40,340 --> 00:03:43,180
كم هذا فظيع

23
00:03:44,280 --> 00:03:51,640
ميريلي، سوف أعيدكِ بجمالٍ مثاليّ

24
00:03:56,790 --> 00:04:01,630
:الجمال والموت
فصل النّهاية

25
00:04:13,860 --> 00:04:16,380
،على الرُّغم من طريقة معاملتها مع يوهان

26
00:04:16,380 --> 00:04:20,070
يبدو أنّها تقلق عليه كثيراً

27
00:04:50,480 --> 00:04:52,340
المعذرة

28
00:04:52,890 --> 00:04:55,770
يحدث هذا أحياناً عندما ألغي الوضع اليدويّ

29
00:04:56,630 --> 00:05:00,750
يفشل عقلُ الشّخص الميّت الحيّ في العودة

30
00:05:02,160 --> 00:05:03,570
تفضّل بالجلوس

31
00:05:07,630 --> 00:05:11,620
رأينا الكثير من الخدَم الآخرين
في الطّريق إلى هنا

32
00:05:11,990 --> 00:05:14,580
هل يُعقَل أنّ جميعهم موتى أحياء؟

33
00:05:14,870 --> 00:05:16,540
إنّهم كذلك بالفعل

34
00:05:19,620 --> 00:05:21,210
هذه ليست جريمة رجل واحد

35
00:05:21,210 --> 00:05:23,480
لا بدّ أنّ لديك متواطئون

36
00:05:23,480 --> 00:05:28,430
حتّى أنا أعلم بأنّ بعث الموتى الأحياء
يستهلك طاقةً سحريّةً هائلة

37
00:05:28,640 --> 00:05:32,930
مُحال أن تتمكّن من إعادة هذا
العدد الكبير من تلقاء نفسك

38
00:05:32,930 --> 00:05:35,320
هذا ممكن، حتّى من دون مساعدة

39
00:05:35,320 --> 00:05:36,270
ماذا؟

40
00:05:36,270 --> 00:05:41,890
إحياء أشخاص وإبقاؤهم هكذا
مع الصّيانة الدّوريّة

41
00:05:41,890 --> 00:05:45,990
هو ما يستهلك مقداراً هائلاً من القوّة

42
00:05:47,200 --> 00:05:53,320
إنّ عملاً رديئاً كما شوهِد في الموتى الأحياء
في تلك الأطلال لا يتطلّب كلّ هذه القوّة

43
00:05:53,790 --> 00:05:55,870
لقد أهملَ صيانتهم أيضاً

44
00:06:00,930 --> 00:06:05,170
وفي حين أنّ هؤلاء الفتيات يبدين
،بحالة جيّدة للوهلة الأولى

45
00:06:05,870 --> 00:06:08,220
أنا متأكّدة بأنّهن فارغات من الدّاخل

46
00:06:09,890 --> 00:06:15,300
مُستحضِرو الأرواح عديمو الضّمير غالباً
يستوفون المُتطلّبات الأدنى لإنجاز عملهم

47
00:06:15,860 --> 00:06:19,190
لا يكلّفون أنفسهم باستعادة مُعظم
الأعضاء الحيويّة أو الحواس

48
00:06:19,720 --> 00:06:22,150
تخفيفاً من استهلاك السّحر

49
00:06:23,060 --> 00:06:24,860
أحسنتِ الملاحظة

50
00:06:25,750 --> 00:06:27,490
خبيرة في استحضار الأرواح

51
00:06:27,760 --> 00:06:32,450
السّؤال هو فيما إذا كانوا ضالّين

52
00:06:34,240 --> 00:06:38,370
بالطّبع، جميعهم ضالّون بالوضع شبه الاستقلاليّ

53
00:06:44,270 --> 00:06:45,550
أنا مصدومة

54
00:06:46,170 --> 00:06:48,860
حتّى أنت يجب أن تعلم أن صنع
،ضالّين هو خطيئة كبيرة

55
00:06:48,860 --> 00:06:54,680
وكيف أنّ الثّمن الّذي يدفعه الميّتُ
باهظاً مقابل البعث

56
00:06:55,170 --> 00:06:56,520
بالتّأكيد

57
00:06:57,000 --> 00:06:58,480
أي ثمن؟

58
00:07:00,690 --> 00:07:06,460
في العادة، بعد الموت، تبدأ الرُّوح
بالاستعداد للتقمُّص

59
00:07:09,330 --> 00:07:14,070
تمرّ الأرواح بدورة الموت والولادة من جديد

60
00:07:14,070 --> 00:07:17,120
وبعد فترة طويلة، تبلغ مرحلة البعث

61
00:07:17,800 --> 00:07:24,160
لكن استحضار الأرواح يعيدها من ذلك التيّار

62
00:07:26,580 --> 00:07:29,010
لا يدوم البعث السّحريّ للأبد

63
00:07:31,070 --> 00:07:35,440
عندما تفشل التّعويذة في النّهاية
،ويموت الشّخص مرّة ثانية

64
00:07:35,440 --> 00:07:37,810
لا تستطيع روحه العودة إلى تلك الدّورة

65
00:07:39,330 --> 00:07:43,630
لا يمكن العودة إلى التيّار بعد مغادرته

66
00:07:44,930 --> 00:07:50,060
تذهب الأرواح الهائمة إلى مكان
خالٍ من الاتّجاهات

67
00:07:50,060 --> 00:07:54,780
لا حركة ولا ألم. لا ضوء ولا صوت ولا حرارة

68
00:07:55,470 --> 00:07:57,830
عقولهم هي الموجودة ببساطة

69
00:07:58,360 --> 00:08:01,120
ويبقى الأمر على حاله للأبد

70
00:08:02,450 --> 00:08:04,450
...ذلك الجحيم يُدعى

71
00:08:05,830 --> 00:08:06,960
بالفراغ

72
00:08:08,180 --> 00:08:13,220
إذاً كلّ الموتى الأحياء يذهبون إلى هناك؟
يسقطون جميعهم في الفراغ؟

73
00:08:13,220 --> 00:08:14,960
عاجلاً أم آجلاً

74
00:08:24,390 --> 00:08:28,000
،أن تقبل الموت وتنتظر التقمُّص

75
00:08:28,000 --> 00:08:33,560
أم تستعيد حياةً مؤقّتة مقابل
قدر أقسى من الموت؟

76
00:08:34,170 --> 00:08:39,870
تحرمهم من حقّ اتّخاذ ذلك القرار الحاسم

77
00:08:40,990 --> 00:08:43,760
دعي الموتى الأحياء يقلقون بشأن ذلك

78
00:08:43,760 --> 00:08:46,750
هذا لا يؤثِّر على المُستحضرين

79
00:08:47,640 --> 00:08:49,130
!أيّها الحقير

80
00:08:49,130 --> 00:08:53,900
!لماذا فعلت هذا بالتّحديد؟
!ما هو مبرّر أعمالك الشّنيعة؟

81
00:08:54,360 --> 00:08:56,160
هدفي؟

82
00:08:57,070 --> 00:08:58,720
...دعني أفكّر

83
00:08:59,260 --> 00:09:01,060
،ببساطة

84
00:09:01,060 --> 00:09:02,340
أنتِ

85
00:09:02,850 --> 00:09:05,540
أريد جمالكِ

86
00:09:06,750 --> 00:09:13,150
،في الواقع، خسرتُ شخصاً أحبّه
مثلما حدث معكما

87
00:09:16,350 --> 00:09:17,820
يا له من جمال

88
00:09:18,310 --> 00:09:24,310
كانت شابّة حسناء بشعر أحمر ناريّ

89
00:09:25,770 --> 00:09:30,000
لحسن الحظّ أنّني كنتُ أُجيد استحضار الأرواح

90
00:09:30,270 --> 00:09:34,300
كان ينبغي أن يكون اللّقاء معها مسألة بسيطة

91
00:09:34,520 --> 00:09:40,940
لكن مع الأسف، طريقة موتها حرقَتْ مُعظم بشرتها

92
00:09:41,600 --> 00:09:45,040
يمكنني صنع ما أشاء من مخلوقات قبيحة

93
00:09:45,040 --> 00:09:48,310
غير أنّ الجمال يصعب إعادة صنعه

94
00:09:48,820 --> 00:09:54,740
رغم ذلك، كلّ ما عليّ هو أن أجمع أولئك
اللّواتي ما زلنَ يمتلِكن ما فقدَتْه هي

95
00:09:55,000 --> 00:09:58,950
يمكنني استكمال أي نقص مُتبقٍّ بنفسي

96
00:10:01,040 --> 00:10:03,870
الأشياء الجميلة تجذبني

97
00:10:03,870 --> 00:10:10,170
وقد أمنحها أجمل جسد ممكن عندما أبعثها

98
00:10:10,870 --> 00:10:15,560
تمرّنتُ على تلك الجثث الّتي رأيتُماها
من أجل تحسين تقنيّتي

99
00:10:15,560 --> 00:10:18,300
بعض الحالات تكون أنجح من غيرها

100
00:10:19,210 --> 00:10:20,780
هذا هو؟

101
00:10:21,690 --> 00:10:24,010
هذا هو سببك الوحيد؟

102
00:10:24,650 --> 00:10:28,520
تختلف قيمة الأشياء بين شخص لآخر

103
00:10:28,850 --> 00:10:30,430
ما رأيك؟

104
00:10:30,430 --> 00:10:36,030
كلّ الموتى الأحياء والعيّنات المُحنَّطة
في هذه الغرفة تمثّل نجاحاتي

105
00:10:36,760 --> 00:10:39,740
...أعتقد كانت نتيجتها ممتازة. ومع ذلك

106
00:10:40,050 --> 00:10:43,020
لا تُقارَن بجمالكِ

107
00:10:43,960 --> 00:10:49,670
آمل أن تسمحي لي باستخدام جسدكِ كأساس

108
00:10:55,530 --> 00:10:56,920
كم هذا مُملّ

109
00:10:58,180 --> 00:11:00,630
أهذا هو سببك الوحيد حقّاً؟

110
00:11:00,990 --> 00:11:05,480
سايرتُ الأمر لأنّني توقّعتُ ما هو أهمّ من ذلك

111
00:11:05,480 --> 00:11:06,890
...آنسة فانورا

112
00:11:06,890 --> 00:11:08,880
يا له من هدوء

113
00:11:08,880 --> 00:11:13,450
،فهمت. نظراً لمعرفتكِ بالبعث

114
00:11:13,450 --> 00:11:17,020
لا بدّ أنّكِ مستحضرة أرواح أيضاً

115
00:11:17,750 --> 00:11:24,780
تساءلتُ لماذا الموتى الأحياء الّذين تركتُهم
تحت الأرض هربوا فجأة

116
00:11:24,780 --> 00:11:28,500
أعتقد كان ذلك من صنيعكِ

117
00:11:28,800 --> 00:11:33,910
،لكن حتّى لو كنتِ مُستحضرة أرواح
ما الّذي يمكنكِ فعله في هذا الوضع؟

118
00:11:33,910 --> 00:11:37,340
ستلتزمين بالقواعد، أليس كذلك؟

119
00:11:39,530 --> 00:11:42,230
،ما دامت القواعد تقيّدكِ

120
00:11:42,230 --> 00:11:44,440
لا يستطيع أحدٌ معارضتي

121
00:11:45,510 --> 00:11:48,770
إيّاكِ والإقدام على أيّ تصرّف طائش

122
00:11:58,100 --> 00:11:59,360
...آسفة

123
00:12:00,530 --> 00:12:03,160
لكن لستُ مجرّد مُستحضرة أرواح

124
00:12:04,570 --> 00:12:05,990
!عيناكِ

125
00:12:06,480 --> 00:12:08,030
!تلك الرّموز

126
00:12:14,830 --> 00:12:17,000
...لا... مستحيل

127
00:12:22,160 --> 00:12:23,120
!ساحرة

128
00:12:26,530 --> 00:12:28,720
أهدرتُ دموعي

129
00:12:34,480 --> 00:12:35,680
!مستحيل

130
00:12:35,680 --> 00:12:40,230
كيف لي أن أدعو ساحرةً إلى عقر داري؟

131
00:12:40,230 --> 00:12:42,870
ساحرة؟ مستحيل

132
00:12:43,450 --> 00:12:46,780
لكن لستُ مستغرباً بصراحة

133
00:12:47,420 --> 00:12:54,350
منذ رأيتُها أوّل مرّة، بدا جمالها
أخّاذاً، وكأنّه من عالم آخر

134
00:12:54,830 --> 00:12:58,670
إذاً أفهم منكِ بأنّنا سنعتمد الطّريقة الأصعب؟

135
00:12:59,000 --> 00:13:00,250
بالطّبع

136
00:13:00,250 --> 00:13:03,470
لحظة. يبدو أنّكِ نسيتِ شيئاً

137
00:13:03,790 --> 00:13:07,510
لِمَ برأيكِ احتجزتُ رهينة؟

138
00:13:09,280 --> 00:13:13,440
لا يمكنكِ بعث شخص دون جزء من جثّته

139
00:13:13,440 --> 00:13:18,520
إذا جعلتُ أحد الموتى الأحياء يحرقه
—بشكل كامل، فلن ترينه أبـ

140
00:13:18,520 --> 00:13:20,070
افعل ما تشاء

141
00:13:21,390 --> 00:13:23,620
لا أعتبره رهينة

142
00:13:24,130 --> 00:13:25,450
،وبغضّ النّظر

143
00:13:25,770 --> 00:13:30,410
لن أتوقّف حتّى أتولّى أمرك

144
00:13:31,840 --> 00:13:33,840
هكذا إذاً

145
00:13:33,840 --> 00:13:38,080
إذاً يبدو أنّني مضطرٌّ للّجوء إلى العنف

146
00:13:43,460 --> 00:13:46,740
الاستعداد لما هو أسوأ

147
00:13:47,700 --> 00:13:51,270
جيّد أنّني صنعتُ نماذجَ قتاليّة

148
00:13:52,340 --> 00:13:54,140
نماذج قتاليّة؟

149
00:13:54,500 --> 00:13:56,600
ألا تعرف التوقُّف؟

150
00:13:56,990 --> 00:14:02,070
لا أعلم كم عبثتَ بهم، لكنّهم مجرّد ضالّين

151
00:14:02,800 --> 00:14:05,500
،يمكنك تقييدهم بالوضع شبه الاستقلاليّ

152
00:14:05,500 --> 00:14:11,280
لكنّهم يبقون آلات بلا عقل، ليس
لديهم وعي حتّى لأنفسهم

153
00:14:11,690 --> 00:14:13,740
لا يمكنك هزيمتي بهؤلاء

154
00:14:14,880 --> 00:14:16,250
كفى خِداعاً

155
00:14:17,030 --> 00:14:22,020
قلّة من النّاس يتمنّنون أن يصبحوا موتى
أحياء وهم على علم بأنّهم سيهوون في الفراغ

156
00:14:22,880 --> 00:14:29,510
بل وأقلّ منهم عدداً يسخّرون أنفسهم
تحت خدمة أو سيطرة مُستحضِر أرواح

157
00:14:29,510 --> 00:14:32,970
،لكن رغم معرفة كلّ شيء

158
00:14:33,400 --> 00:14:36,680
ما زال البعض يقدّمون أنفسهم للمُستحضرين

159
00:14:37,950 --> 00:14:39,940
...مع فائق الاحترام، أُطلِق عليهم

160
00:14:43,610 --> 00:14:45,390
فُرسان الموت

161
00:14:50,190 --> 00:14:54,780
لا تمسّوا ذلك الرّجل المُلتحي بسوء

162
00:14:55,750 --> 00:14:57,660
...أمّا بالنّسبة للآخرين

163
00:14:58,280 --> 00:15:00,370
افعلوا ما يحلو لكم

164
00:15:15,060 --> 00:15:15,850
!توقّفي

165
00:15:16,770 --> 00:15:17,850
!لا تقاتلي

166
00:15:18,070 --> 00:15:20,270
!تـ-توقّفي أرجوكِ

167
00:15:34,090 --> 00:15:35,160
آسفة

168
00:15:35,690 --> 00:15:41,620
ما دامت التّعويذة نشِطة، فإنّ قتل
الجسد هو الطّريقة الوحيدة لإيقافهم

169
00:15:44,760 --> 00:15:48,460
سأحرص على مُعاقبة مُستحضر الأرواح

170
00:15:56,590 --> 00:15:58,380
!يا لها من سوء حسابات

171
00:15:58,380 --> 00:16:00,950
!لماذا ساحرة بالتّحديد؟

172
00:16:00,950 --> 00:16:02,890
!اللّعنة، اللّعنة، اللّعنة، اللّعنة

173
00:16:03,280 --> 00:16:06,170
!كيف تجرؤ على إفساد مخطّطاتي؟

174
00:16:07,810 --> 00:16:09,190
لكن لم أنتهِ

175
00:16:09,650 --> 00:16:14,860
سوف أعيد تصميم جسدكِ وأجعلكِ
المُحارب الأعظم الآن

176
00:16:16,800 --> 00:16:18,640
هل أنت جادّ؟

177
00:16:18,640 --> 00:16:20,580
يا لك من حقير

178
00:16:23,730 --> 00:16:29,170
أين كلّ ذلك الكلام عن الجمال؟

179
00:16:29,170 --> 00:16:32,260
مستحيل! كيف لا تزال حيّاً؟

180
00:16:32,620 --> 00:16:36,720
لا. أنا ميّت بالفعل

181
00:16:36,940 --> 00:16:39,080
متى بعثَتْك تلك السّاحرة؟

182
00:16:39,080 --> 00:16:41,850
!كانت معي حتّى آخر لحظة

183
00:16:41,850 --> 00:16:43,420
—لم يكن لديها وقت كي

184
00:16:43,420 --> 00:16:47,940
تمهّل. ما الغريب في ذلك؟

185
00:16:48,750 --> 00:16:53,570
كنتُ ميّتاً حيّاً طوال هذا الوقت

186
00:16:55,250 --> 00:17:00,620
لكن الموتى الأحياء لا يستطيعون تجاوز
الموت الجسديّ من دون صيانة استحضاريّة

187
00:17:01,270 --> 00:17:05,870
لذا تسأل لماذا أجلس هنا وكأنّني وُلِدتُ من جديد؟

188
00:17:06,890 --> 00:17:09,340
ينبغي أن تكون الإجابة على ذلك واضحة

189
00:17:09,600 --> 00:17:13,670
لستُ مجرّد ميّت حيّ

190
00:17:16,000 --> 00:17:19,000
أنا ميّتٌ حيّ تابع لساحرة

191
00:17:20,720 --> 00:17:22,470
!تـ-تراجع

192
00:17:22,470 --> 00:17:23,480
!توقّف

193
00:17:29,800 --> 00:17:31,150
...جوهريّاً

194
00:17:33,640 --> 00:17:35,640
صُنِعتُ بطريقة خاصّة

195
00:17:36,470 --> 00:17:37,650
!انتظر

196
00:17:37,650 --> 00:17:40,160
اهدأ. لا تقتلني

197
00:17:40,160 --> 00:17:42,080
!لا تقتلني

198
00:17:42,080 --> 00:17:44,830
...إذا قتلتني، فإنّ كلّ أولئك الموتى الأحياء

199
00:17:45,250 --> 00:17:46,460
سيقتلونك؟

200
00:17:47,050 --> 00:17:50,040
لا، لن أقتلك

201
00:17:50,330 --> 00:17:53,760
اسمع يا هذا، تجاوزتَ كلّ الحدود

202
00:17:54,440 --> 00:17:57,270
انتهكتَ كلّ المُحرّمات في الكتاب

203
00:17:57,270 --> 00:17:59,300
أ... أعلم

204
00:17:59,620 --> 00:18:03,350
سأتحمّل مسؤوليّة أولئك الموتى الأحياء

205
00:18:03,350 --> 00:18:06,380
أغضبتَ فانورا

206
00:18:06,810 --> 00:18:09,980
حتّى الموت لا يليق بك

207
00:18:10,320 --> 00:18:11,910
...تـ-توقّف

208
00:18:13,090 --> 00:18:15,570
سأبدأ بأصابعك

209
00:18:15,860 --> 00:18:17,280
!توقّف أرجوك

210
00:18:17,810 --> 00:18:19,530
—أ-أتوسّـ

211
00:18:33,070 --> 00:18:35,920
...يوهان، أنت

212
00:18:37,390 --> 00:18:39,300
لم أقتله بعد

213
00:18:44,360 --> 00:18:45,280
اسمع

214
00:18:45,280 --> 00:18:46,390
نعم؟

215
00:18:46,390 --> 00:18:52,440
أنا على وشك أن أنتهك القانون، لذا هل
يمكنك التكتّم على هذه الحادثة برمّتها؟

216
00:18:52,440 --> 00:18:53,270
ماذا؟

217
00:18:53,580 --> 00:18:55,290
الوعد لا يكفي

218
00:18:55,800 --> 00:18:58,240
يجب أن توافق على تعويذة عقد

219
00:18:58,520 --> 00:19:00,140
...لا أعلم

220
00:19:00,140 --> 00:19:05,500
يحوم بنِظام الرّنين السّحريّ الغموضُ
على الرّغم من شهرته

221
00:19:05,500 --> 00:19:08,490
لأنّنا نطلب من عملائنا أن يتكتّموا
على ما يجري سرّاً

222
00:19:08,490 --> 00:19:11,580
تريدينني أن أسكت عن جريمة؟
—مُحال أن

223
00:19:11,580 --> 00:19:14,750
ألا تريد إنقاذها؟

224
00:19:15,870 --> 00:19:18,300
،إذا أردت إنقاذ كلّ الضّحايا

225
00:19:19,510 --> 00:19:22,010
فاصمت وافعل ما أقوله

226
00:19:35,700 --> 00:19:42,030
سأدعك تصون كلّ الموتى الأحياء
الّذين بعثتهم ككائنات بشريّة كاملة

227
00:19:44,140 --> 00:19:48,520
سأوفّر القوّةَ السّحريّة، لذا لا تتكاسل

228
00:19:49,270 --> 00:19:51,870
ماذا فعلتِ؟

229
00:19:52,160 --> 00:19:54,830
!ماذا فعلتِ؟

230
00:19:54,830 --> 00:19:56,840
أنا، ميّت حيّ؟

231
00:19:56,840 --> 00:19:59,960
!كيف تجرؤين؟! كيف تجرؤين؟

232
00:19:59,960 --> 00:20:03,840
—معنى هذا أنّني... سأسقط في الفراغ، و

233
00:20:05,480 --> 00:20:07,500
هل أنت قلقٌ من الحياة الآخرة من الآن؟

234
00:20:08,250 --> 00:20:11,460
،أكره تعكير مزاجك

235
00:20:11,460 --> 00:20:16,230
لكن لن أمنحك لحظة سلام
أثناء وجودك في هذا العالم أيضاً

236
00:20:19,260 --> 00:20:24,490
آنسة فانورا، هل هذ يعني أنّني
أستطيع رؤيتها من جديد؟

237
00:20:26,510 --> 00:20:28,920
مثلما كانت من قبل؟

238
00:20:30,710 --> 00:20:31,960
أجل

239
00:20:32,240 --> 00:20:36,030
إنّ بعثها بصورة غير شرعيّة يعني بأنّها
،يجب أن تبقى متوارية عن الأنظار حاليّاً

240
00:20:36,630 --> 00:20:40,170
لكن لديّ طرُق لشرعنتها

241
00:20:41,620 --> 00:20:43,180
حقّاً؟

242
00:20:44,080 --> 00:20:45,290
تنتابك الحيرة؟

243
00:20:46,440 --> 00:20:47,640
ربّما

244
00:20:48,380 --> 00:20:49,930
،أشعر بتضارُب في أفكاري

245
00:20:50,620 --> 00:20:53,880
لكن ثمّة جزء منّي سعيد للغاية

246
00:21:00,170 --> 00:21:01,030
أنتِ؟

247
00:21:01,490 --> 00:21:02,190
ماذا؟

248
00:21:02,440 --> 00:21:04,510
انتهيتِ الآن، أليس كذلك يا فانورا؟

249
00:21:04,510 --> 00:21:05,780
ابتعدي عنه

250
00:21:06,000 --> 00:21:07,140
أنتِ قريبةٌ جدّاً

251
00:21:09,380 --> 00:21:10,240
يوهان

252
00:21:10,490 --> 00:21:11,450
نعم؟

253
00:21:11,790 --> 00:21:15,160
ماذا فعلتَ بأمتعتي؟

254
00:21:15,160 --> 00:21:15,920
ماذا؟

255
00:21:16,770 --> 00:21:17,630
لحظة

256
00:21:18,180 --> 00:21:19,950
أين وضعتُها؟

257
00:21:19,950 --> 00:21:21,410
هل تعني بأنّك أضعتَها؟

258
00:21:21,410 --> 00:21:23,110
—كانت هناك أمور أكثر أهمّية

259
00:21:23,110 --> 00:21:24,610
ابحث عنها

260
00:21:25,300 --> 00:21:26,470
حسناً

261
00:21:27,580 --> 00:21:29,030
ولا حتّى كلمة شكر

262
00:21:29,910 --> 00:21:31,070
يوهان

263
00:21:31,070 --> 00:21:32,780
نعم؟ ماذا تريد؟

264
00:21:34,560 --> 00:21:35,980
أنا آسف

265
00:21:37,060 --> 00:21:42,230
تكلّمتُ بوقاحة دون أن أدرك بأنّك ميّت حيّ

266
00:21:42,230 --> 00:21:45,900
وأخبرتُك أن تحذر من النّساء الحسناوات

267
00:21:46,520 --> 00:21:50,120
لكن لم يكن أمامك خيار، أليس كذلك؟

268
00:21:51,400 --> 00:21:54,230
هل أبدو بائساً في نظرك؟

269
00:21:54,230 --> 00:21:56,180
يبدو لي أنّك مُعنَّف

270
00:21:58,030 --> 00:22:00,130
شيء من هذا القبيل

271
00:22:00,760 --> 00:22:01,880
لكن لا يهمّ

272
00:22:02,660 --> 00:22:03,850
لا تقلق

273
00:22:04,770 --> 00:22:06,670
لا مانع لديّ

274
00:22:17,920 --> 00:22:19,500
!ما-ماذا تفعلين؟

275
00:22:19,990 --> 00:22:21,610
ماذا تقصد؟

276
00:22:25,150 --> 00:22:27,540
كان ذلك لأنّك أذيت يوهان

277
00:24:01,360 --> 00:24:03,960
!لم أحصل حتّى على حبيب بعد

278
00:24:04,910 --> 00:24:09,960
الحلقة القادمة: "السّاحرة وسيف
"الشّيطان: فصل الافتتاحيّة

279
00:24:06,000 --> 00:24:09,960
السّاحرة وسيف الشّيطان

280
00:24:06,000 --> 00:24:09,960
فصل الافتتاحيّة