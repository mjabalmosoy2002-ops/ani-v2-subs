1
00:00:04,000 --> 00:00:05,140
آلات موسيقيّة مُحرَّمة

2
00:00:06,560 --> 00:00:11,310
مجرّد امتلاك أدوات الشّعوذة هذه يمنح
قوّة قريبة من قوّة ساحرة

3
00:00:06,690 --> 00:00:11,570
آلات موسيقيّة مُحرَّمة

4
00:00:12,320 --> 00:00:16,700
أدوات الشّعوذة

5
00:00:12,480 --> 00:00:16,990
،لكن في حين أنّ مستخدميها يكتسبون قوّة

6
00:00:17,530 --> 00:00:23,330
دفعة مادّية

7
00:00:17,680 --> 00:00:23,330
يجب أن يقدِّموا تضحيات مادّية وإلّا
تنازلوا عن حياتهم

8
00:00:24,120 --> 00:00:27,610
ولهذا استعمال الآلات الموسيقيّة مُحرَّم بشدّة

9
00:00:24,290 --> 00:00:33,510
تضحية

10
00:00:28,480 --> 00:00:32,080
مع ذلك لا يخلو الأمر من وجود
أولئك الّذين يلجؤون إلى هذه الأدوات

11
00:00:32,860 --> 00:00:34,180
...وهذا ما سنراه

12
00:02:11,990 --> 00:02:13,180
ماذا كان ذلك الصّوت؟

13
00:02:13,700 --> 00:02:15,360
هل سمعتِ شيئاً؟

14
00:02:15,840 --> 00:02:16,580
أجل

15
00:02:17,500 --> 00:02:19,050
سأعود إلى المنزل

16
00:02:19,050 --> 00:02:20,660
إذا كنتِ قلقة، يمكنني أن أمشي معكِ

17
00:02:20,870 --> 00:02:23,700
سأكون بخير. إنّه ليس ببعيد

18
00:02:23,700 --> 00:02:24,600
تصبح على خير

19
00:02:35,770 --> 00:02:38,090
هناك الكثير من الغربان

20
00:03:23,000 --> 00:03:26,260
ليس بعد. ما زال هذا غير كافٍ

21
00:03:27,000 --> 00:03:29,500
يترتّب عليّ إضافة المزيد

22
00:03:35,900 --> 00:03:39,110
هل توجد ساحرةٌ في هذه الأرجاء؟

23
00:03:42,190 --> 00:03:46,490
لا أدري. يُفترض أن يخبرونا بالتّفاصيل شخصيّاً

24
00:03:49,330 --> 00:03:52,980
ماذا تريدنا أن نفعل هذه المرّة؟

25
00:03:52,980 --> 00:03:55,550
،من فضلك أبقِ هذا سرّاً بيننا

26
00:03:55,550 --> 00:03:58,930
لكن سيّد المنزل لديه ولع في جمع الأشياء

27
00:03:59,450 --> 00:04:03,880
ويؤسفني القول بأنّ عيّنة قد هربت من مجموعته

28
00:04:04,190 --> 00:04:07,120
هربت؟ إنّه حيوانٌ إذاً؟

29
00:04:07,120 --> 00:04:11,100
أجل. وحيوان عنيف كذلك

30
00:04:12,560 --> 00:04:15,790
أودى بحياة الكثير من النّاس من الآن

31
00:04:17,300 --> 00:04:22,620
بما أنّكم استدعيتُم النّظام، فأعتقد
بأنّه ليس مجرّد مخلوق نادر

32
00:04:23,070 --> 00:04:26,160
أيُعقَل أنّ لديكم وحش سحريّ هنا؟

33
00:04:28,800 --> 00:04:29,500
أجل

34
00:04:29,920 --> 00:04:32,580
كما تفضّلت، المخلوق سحريّ

35
00:04:39,410 --> 00:04:42,390
وتريد منّا إخضاع ذاك الشّيء؟

36
00:04:42,390 --> 00:04:46,930
يترتّب عليكما القبض عليه من جديد وبأقصى
سرعة، ومن دون مسّه بضرّ

37
00:04:46,930 --> 00:04:48,910
من دون مسّه بضرّ؟

38
00:04:48,910 --> 00:04:51,420
فهمت. هذا يفسّر سبب معاناتكم

39
00:04:52,200 --> 00:04:54,640
ماذا؟ إلى أين أنتِ ذاهبة يا غيدو؟

40
00:04:54,640 --> 00:04:57,480
سئمتُ هذا الهراء

41
00:04:57,480 --> 00:04:59,360
مهلاً، مهلاً. نحن نعمل هنا

42
00:04:59,610 --> 00:05:02,530
لا أكترث لمجرّد وحش عاديّ

43
00:05:02,530 --> 00:05:04,990
يمكنك تولّي عمل مُجالسة الحيوانات

44
00:05:05,260 --> 00:05:06,660
يا إلهي

45
00:05:07,130 --> 00:05:10,200
من تعتقدين نفسكِ؟ ملكة؟

46
00:05:16,080 --> 00:05:18,790
عفواً. المعذرة على التدخُّل

47
00:05:19,250 --> 00:05:22,840
التحكُّم بالمادّة هو أكثر التّعويذات
،السّحريّة البدائيّة

48
00:05:22,840 --> 00:05:25,760
لكن التحكُّم بالسّوائل يتطلّب موهبة خاصّة

49
00:05:26,220 --> 00:05:29,510
بصراحة، لطالما واجهتُ صعوبة في فعل ذلك

50
00:05:30,880 --> 00:05:32,100
كاذب

51
00:05:32,340 --> 00:05:34,290
أنتِ تجرحينني يا غيدو

52
00:05:34,830 --> 00:05:38,110
ليس من اللّطف نعت النّاس بالكاذبين

53
00:06:09,600 --> 00:06:11,350
هل سيَفي هذا بالغرض؟

54
00:06:15,870 --> 00:06:18,020
عمل مُتقَن

55
00:06:18,340 --> 00:06:20,860
كنتُ مُحِقّاً باستدعائكما

56
00:06:21,270 --> 00:06:22,810
هذا شرفٌ عظيم لنا

57
00:06:22,810 --> 00:06:26,180
الوحوش السّحريّة ليست شرعيّة
في هذا البلد كما تعلم

58
00:06:26,180 --> 00:06:28,200
أردتُ مُعالجة هذا الأمر بهدوء

59
00:06:28,640 --> 00:06:33,000
سمعتُ بأنّكما تقبلان أي عمل، وما أراه
هو أنّ هذه المعلومة صحيحة

60
00:06:33,000 --> 00:06:34,990
ليس تماماً

61
00:06:35,380 --> 00:06:40,360
نحن لا نحشر أنوفنا إلّا في المسائل المُتعلِّقة بالسّحر

62
00:06:42,960 --> 00:06:47,170
منظّمة سحريّة تعمل بالسّحر ولأجل السّحر

63
00:06:47,680 --> 00:06:52,570
إذا واجهتك أي صعوبة، فاتّصل
بنِظام الرّنين السّحريّ

64
00:06:59,030 --> 00:07:02,810
دعوة النّفس إلى طعام بعد العمل
لَهو أمر يُريح الأعصاب

65
00:07:04,160 --> 00:07:06,220
ما الخطب؟ ألن تأكلي شيئاً؟

66
00:07:07,290 --> 00:07:08,780
دعك من هذا

67
00:07:10,920 --> 00:07:13,950
أخبرني ماذا كان عملنا السّابق أيّها المُغفّل

68
00:07:14,490 --> 00:07:20,360
اعتقلنا لصّاً تافهاً ارتكب جرائمَ شنيعة باستخدام السّحر

69
00:07:20,360 --> 00:07:22,580
إنّه عملٌ طيّب إن أردتِ رأيي

70
00:07:22,580 --> 00:07:24,080
وقبله؟

71
00:07:24,080 --> 00:07:27,550
قضينا على شجرة فظيعة تتغذّى على القوّة السّحريّة

72
00:07:27,550 --> 00:07:28,710
وقبل هذا؟

73
00:07:28,710 --> 00:07:31,450
...دعيني أتذكّر

74
00:07:31,450 --> 00:07:34,300
—صحيح. مُلاحِق يستخدم السّحر لغايات سيّئة

75
00:07:34,300 --> 00:07:35,260
!قبله؟

76
00:07:35,260 --> 00:07:37,430
ترويض وحش سحريّ صغير

77
00:07:38,930 --> 00:07:40,630
أتعبث معي؟

78
00:07:40,630 --> 00:07:44,960
لماذا برأيك انضممتُ لنِظامك التّافه؟

79
00:07:44,960 --> 00:07:48,310
ليس عليكِ تذكيري

80
00:07:48,660 --> 00:07:51,280
يا إلهي. كان خمراً لذيذاً

81
00:07:51,280 --> 00:07:53,300
!أسرع وجِد لي ساحرة

82
00:07:53,300 --> 00:07:55,990
إن كنت لا تستطيع فعل ذلك، فهذا
يعني أنّ النِّظام هو مضيعةٌ لوقتي

83
00:07:56,160 --> 00:08:01,370
يجب أن تدركي بأنّ الحالات المُتعلّقة
بالسّاحرات لا تُمطر علينا من السّماء

84
00:08:01,370 --> 00:08:05,000
وعلاقتنا هي علاقة مصلحة مُتبادلة

85
00:08:05,000 --> 00:08:08,500
،مقابل دعمنا الكامل لكِ في تحقيق هدفكِ

86
00:08:08,500 --> 00:08:11,720
وافقتِ على الخدمة تحت سلطة النّظام

87
00:08:11,720 --> 00:08:16,000
نحظى بالأولويّة عندما تكون هناك
قضية متعلّقة بالسّاحرات

88
00:08:16,000 --> 00:08:19,160
لذا إلى حين حدوث ذلك، قومي بعملكِ

89
00:08:19,580 --> 00:08:21,390
،إذا تكاسلتِ كما فعلتِ اليوم

90
00:08:21,390 --> 00:08:24,560
لن نمنحكِ ساحرات أو طعاماً لذيذاً
أو أي شيء آخر

91
00:08:27,120 --> 00:08:30,690
لم تكن بحاجتي اليوم على أي حال

92
00:08:31,120 --> 00:08:32,200
صحيح

93
00:08:33,120 --> 00:08:34,150
المعذرة يا سيّدي

94
00:08:35,320 --> 00:08:37,240
طُلِبَ منّي إعطاؤك هذه

95
00:08:37,860 --> 00:08:38,950
شكراً لك

96
00:08:41,840 --> 00:08:43,080
إنّها من النِّظام

97
00:08:43,080 --> 00:08:45,670
!هل هي ساحرة؟! أعطِني

98
00:08:47,200 --> 00:08:52,080
كم مرّة يجب أن أخبركِ بذلك؟ تحتاجين
خاتم توقيع من النِّظام لكسر هذا الختم

99
00:08:55,090 --> 00:08:58,690
لكن ينبغي أن يكون لديكِ واحدة
من أدوات الوسم هذه أيضاً

100
00:09:02,980 --> 00:09:05,390
ابتهجي يا غيدو

101
00:09:05,780 --> 00:09:08,230
كنّا نتحدّث عن ذلك للتو

102
00:09:27,920 --> 00:09:28,630
!ساحرة

103
00:09:28,840 --> 00:09:31,350
هذه الآنسة هي موكّلتنا فحسب

104
00:09:31,350 --> 00:09:33,480
!إذاً أين السّاحرة اللّعينة؟

105
00:09:33,480 --> 00:09:36,090
نحن نمثّل نِظام الرّنين السّحريّ

106
00:09:36,090 --> 00:09:38,430
أعتقد أنّ لديكِ عمل لنا؟

107
00:09:38,430 --> 00:09:42,460
أنا آسفة للطلب منكما قطع كلّ هذه
المسافة إلى هنا. تفضّلا بالدّخول

108
00:09:44,240 --> 00:09:48,980
.لم أعد قادرة على فتح هذا الصّندوق
هلّا وجدتُما حلّاً له؟

109
00:09:53,560 --> 00:09:57,280
هكذا إذاً. نقش رونيّ

110
00:09:57,760 --> 00:10:01,750
أنتِ محظوظة. إلغاء التّعويذات هو اختصاصي

111
00:10:01,750 --> 00:10:02,620
ممتاز

112
00:10:14,000 --> 00:10:18,170
إذاً ماذا عن عبارة "كنّا نتحدّث عن ذلك للتو"؟

113
00:10:20,800 --> 00:10:24,430
أيُّها الوغد، استعدّ لما هو قادم إليك

114
00:10:25,040 --> 00:10:28,140
لم أذكر شيئاً عن ساحرة، أليس كذلك؟

115
00:10:28,680 --> 00:10:31,860
كان ينبغي أن تدركي ذلك عندما
تركتُ التّابوتَ خلفي

116
00:10:32,120 --> 00:10:34,520
إذاً ماذا عن عبارة "كنّا نتحدّث عن ذلك للتو"؟

117
00:10:34,890 --> 00:10:38,860
ما كنتُ أقصده هو أنّكِ ينبغي أن تتّخذي
القضايا الّتي لا تخصُّ السّاحرات بجدّية

118
00:10:38,860 --> 00:10:40,300
!هُراء

119
00:10:40,300 --> 00:10:43,650
إن شعرتِ بأنّكِ انخدعتِ، فاعتبري ذلك تجربة تعلُّم

120
00:10:43,650 --> 00:10:45,370
تعلّمتِ من ذلك درساً

121
00:10:45,370 --> 00:10:50,250
مُحال أن أتعلّم. الثِّقة بك كانت أكبر غلطة لي

122
00:10:50,250 --> 00:10:53,570
"غلطة" هي كلمة مُرادِفة لـ"تجربة"

123
00:10:53,570 --> 00:10:55,460
كلتاهما طريق مُختصَر نحو الحكمة

124
00:10:55,970 --> 00:10:58,660
آسف، لكن لا نملك وقتاً للجِدال

125
00:10:58,660 --> 00:11:01,090
تلقّينا عملنا التّالي للتو

126
00:11:01,700 --> 00:11:05,230
أتمنّى أن يحالفنا الحظّ هذه المرّة

127
00:11:06,540 --> 00:11:09,470
سأغفر لك ذلك فقط في الوقت الرّاهن

128
00:11:09,470 --> 00:11:13,150
،حالما تُرفَع لعنتي، ولا أكون بحاجة للنِّظام

129
00:11:13,750 --> 00:11:16,270
أوّل شيء سوف أفعله هو قتلك

130
00:11:16,960 --> 00:11:18,240
يسرُّني سماع ذلك

131
00:11:18,980 --> 00:11:23,300
أتطلّع قُدماً لذلك اليوم بنفسي

132
00:11:27,980 --> 00:11:32,900
مضى شهرٌ هادئ خالٍ من السّاحرات منذ ذلك الحين

133
00:11:32,900 --> 00:11:35,450
يا لها من ظهيرة تبعث على السّكينة

134
00:11:36,180 --> 00:11:40,570
برأيي اليوم الّذي تسترجعين فيه جسدكِ
الحقيقيّ لا يزال بعيداً

135
00:11:40,570 --> 00:11:44,340
سأقتلك لاحقاً، لكن يمكنني دوماً
ركل مؤخّرتك الآن

136
00:11:44,340 --> 00:11:46,850
يا لمزاجكِ السيّئ

137
00:11:47,310 --> 00:11:49,680
على أي حال، كُلي حتّى الإشباع

138
00:11:49,680 --> 00:11:50,770
لذيذة، أليس كذلك؟

139
00:11:50,770 --> 00:11:52,140
مقرفة جدّاً

140
00:11:54,070 --> 00:11:56,890
لأجلك يا سيّدي

141
00:11:56,890 --> 00:11:58,600
من النِّظام ثانية؟

142
00:11:58,600 --> 00:11:59,280
أجل

143
00:11:59,280 --> 00:12:02,330
المزيد من الأعمال الرّخيصة غالباً

144
00:12:02,330 --> 00:12:04,700
تبّاً لهذا الهُراء. مزّقها

145
00:12:05,440 --> 00:12:08,540
لا، سيُعجبك هذا يا غيدو

146
00:12:09,960 --> 00:12:11,790
وصل بظرفٍ أسود

147
00:12:12,540 --> 00:12:14,420
وماذا يعني؟

148
00:12:14,900 --> 00:12:22,010
لا يُرسلون هذه إلّا عندما يكون للأمر علاقة
بساحرة وتخصّ القضيّة بشكلٍ جوهريّ

149
00:12:22,610 --> 00:12:28,730
يبدو أنّ هناك ساحرة ترتكب جرائمَ قتل
تسلسليّة في هايدين، عاصمة فيريس

150
00:12:28,730 --> 00:12:33,350
"وحتّى أنّهم وصفوا القضيّة بـ"الشّنيعة

151
00:12:33,350 --> 00:12:34,260
—بالإضافة إلى ذلك

152
00:12:34,260 --> 00:12:36,020
يكفي. أعطِني

153
00:12:36,430 --> 00:12:38,320
أنتِ نفودة الصّبر

154
00:12:40,980 --> 00:12:42,720
نحن على وشك أن ننشغل

155
00:12:42,720 --> 00:12:45,240
بيننا وبين هذه القضيّة مُحيط

156
00:12:45,580 --> 00:12:46,830
احزمي حقائبكِ

157
00:12:51,920 --> 00:12:54,250
إذاً ساحرة وكِتاب سحريّ؟

158
00:12:56,670 --> 00:12:59,630
سنواجه وقتاً عصيباً مع هذه القضيّة

159
00:13:07,150 --> 00:13:09,010
!سيّدة هاينيس، هذا خطير

160
00:13:09,010 --> 00:13:11,220
!طفلايّ في الدّاخل

161
00:13:11,440 --> 00:13:13,820
!شولك! لوران

162
00:13:24,360 --> 00:13:26,240
كنتِ تتأوّهين أثناء نومكِ

163
00:13:26,760 --> 00:13:28,260
هل أنتِ بخير؟

164
00:13:28,260 --> 00:13:30,300
أجل، أنا بخير

165
00:13:30,710 --> 00:13:32,200
هذا جيّد إذاً

166
00:13:39,580 --> 00:13:42,700
آسف. أفلتتْ منّا ثانية

167
00:13:43,180 --> 00:13:44,240
كم عدد الوفيّات؟

168
00:13:44,800 --> 00:13:46,720
خمسة على الأقلّ

169
00:13:47,120 --> 00:13:49,630
...والجثث

170
00:13:51,220 --> 00:13:55,970
مُلتهَمة أو تمّ التّضحية بها أو ما شابه"
ذلك بواسطة ساحرة"؟

171
00:13:56,950 --> 00:14:01,260
كيف لشخص أن يفعل أمراً مروعاً كهذا؟
!يا لها من مجنونة

172
00:14:01,810 --> 00:14:03,940
مجنونة"؟"

173
00:14:05,040 --> 00:14:08,000
رأيتُ الكثير من المُجرمين فاقدي العقل

174
00:14:08,000 --> 00:14:10,140
وثمّة شيء مُشترك واحد بينهم

175
00:14:10,690 --> 00:14:12,250
أتعرف ما هو؟

176
00:14:12,250 --> 00:14:13,080
لا

177
00:14:13,440 --> 00:14:17,830
رغبات غير مُحقَّقة نشأت عن الإحساس بالدُّونيّة

178
00:14:18,350 --> 00:14:24,460
إنّ فقدان السّيطرة عليها قد يحوّل حتّى
الأشخاص العاقلين إلى أشرار مجانين

179
00:14:24,830 --> 00:14:27,040
تقصدين أنّه لا يوجد شخصٌ يُولَد شرِّيراً؟

180
00:14:27,760 --> 00:14:28,900
شخص"؟"

181
00:14:29,790 --> 00:14:31,700
هل السّاحرة شخص؟

182
00:14:32,220 --> 00:14:33,640
لا أدري

183
00:14:33,640 --> 00:14:39,690
لكن سواء كان ساحرة أو بشراً، أي شخص
يستطيع فعل هذا هو قمامة بلا شكّ

184
00:14:40,450 --> 00:14:41,710
أتّفق معك في كلّ حرف

185
00:14:42,140 --> 00:14:44,760
لم نتوقّع هذه المعركة

186
00:14:44,760 --> 00:14:48,320
ألهذا السّبب لم تنصبي كلّ مجالاتكِ في الوقت؟

187
00:14:48,320 --> 00:14:50,970
تقصد أنّها ما كانت لتستطيع الهرب
لو كنتُ قد انتهيت؟

188
00:14:51,460 --> 00:14:52,210
لا

189
00:14:58,230 --> 00:14:59,350
—ما قصدتُه كان

190
00:14:59,350 --> 00:15:00,570
أعلم ذلك

191
00:15:01,200 --> 00:15:07,070
يجب أن نحبسها في صندوق ونجعلها
،تُطلِق أكبر قدر مُمكن من التّعويذات

192
00:15:07,070 --> 00:15:09,170
وإلّا فلن نكتشف سحرها أبداً

193
00:15:10,460 --> 00:15:13,350
لكن حتّى لو حللنا هذا اللّغز، ستبقى
الخطوة الأولى فحسب

194
00:15:13,980 --> 00:15:18,010
ما زال على عاتق القوّة الكاملة لشرطة
هايدين أن تتعامل مع هذا الأمر برويّة

195
00:15:19,200 --> 00:15:23,660
قوّات شرطة ضعيفة لا تستطيع
مُقاتلة وحش بأي وسيلة أخرى

196
00:15:24,190 --> 00:15:27,500
سيّدة هاينيس، لا حاجة لأخبركِ

197
00:15:27,500 --> 00:15:31,150
بأنّ هذا الأمر يتجاوز قتلاً تسلسُليّاً عاديّاً

198
00:15:31,900 --> 00:15:34,040
أنتِ مُستخدِمة السّحر الوحيدة الّتي لدينا

199
00:15:34,600 --> 00:15:37,780
إذا شعرتِ بالعجز، تكلّمي مع المُحافِظ

200
00:15:39,700 --> 00:15:42,620
السّاحرات تندرج ضمن سلطة فيلق الفُرسان

201
00:15:42,960 --> 00:15:46,160
ما لم يتغيّر شيء، سيظلّ عدد الضّحايا في ازدياد

202
00:15:46,160 --> 00:15:47,380
أعلم

203
00:15:49,830 --> 00:15:51,300
أعلم ذلك

204
00:15:55,940 --> 00:15:57,750
،أعلم أنّ الكلام أسهل من الفعل

205
00:15:57,750 --> 00:16:01,180
لكن حاولي ألّا تجلدي ذاتكِ بشأن
ما حدث للمُفتِّش كول

206
00:16:01,750 --> 00:16:04,880
تعاملتُ مع قضايا مروعة كثيرة

207
00:16:04,880 --> 00:16:08,020
ارتأيتُ أنّ النّاس يتذكّرون الجناةَ دوماً

208
00:16:08,530 --> 00:16:12,280
وسرعان ما ينسون الضّحايا

209
00:16:12,840 --> 00:16:17,740
،لكن بعد ذلك قتلَ أحدُهم أُناساً يعنيني أمرهم

210
00:16:18,420 --> 00:16:21,390
فأدركتُ أنّني لا يمكن أن أنسى اسم
الجاني واسم الضحيّة في نفس الوقت

211
00:16:22,710 --> 00:16:26,290
لا تقلق. سأقوم بعملي

212
00:16:35,300 --> 00:16:38,510
يا إلهي. يبدو أنّنا تأخّرنا كثيراً

213
00:16:38,510 --> 00:16:42,850
كفاك هُراء. تركتَها تفلت تحت أنظارنا

214
00:16:42,850 --> 00:16:44,610
هوّني عليّ

215
00:16:44,610 --> 00:16:49,250
واطمئنّي. السّاحرة في هذه القضيّة ستعود

216
00:16:50,710 --> 00:16:56,530
جريمة قتل جماعيّ شنيعة مُرتكَبة بواسطة
"ساحرة، القضيّة المُلقَّبة بـ"وقت تسلية السّاحرة

217
00:16:56,530 --> 00:17:00,830
،حتّى الأسبوع الماضي، بلغ عدد الضّحايا 36
بمن فيهم ضبّاط شرطة

218
00:17:00,830 --> 00:17:02,330
أمر عسير فهمه

219
00:17:02,880 --> 00:17:05,870
ماذا أصبح عدد الضّحايا اللّيلة؟

220
00:17:06,880 --> 00:17:08,740
من أنتما؟

221
00:17:09,230 --> 00:17:11,920
،تقول كلاماً لا أريد التّفكير فيه

222
00:17:12,430 --> 00:17:14,590
لذا أعتقد بأنّك تعلم من أكون

223
00:17:15,130 --> 00:17:17,010
وتبدوان مُريبين

224
00:17:17,440 --> 00:17:19,760
ماذا يوجد داخل هذا التّابوت؟

225
00:17:19,760 --> 00:17:22,380
تستجوبيننا من الآن؟

226
00:17:22,380 --> 00:17:24,160
حسناً، لا يمكنني لومكِ

227
00:17:24,580 --> 00:17:28,060
اطمئنّي، نحن مُحترمان جدّاً

228
00:17:28,650 --> 00:17:30,520
لذا من فضلكِ، أوقفي يدكِ

229
00:17:34,050 --> 00:17:36,420
لا ننوي أن نضرّكِ

230
00:17:36,780 --> 00:17:39,070
على العكس، نرغب في مساعدتكِ

231
00:17:40,130 --> 00:17:41,280
في ماذا؟

232
00:17:41,790 --> 00:17:45,070
أرسلنا نظامُ الرّنين السّحريّ

233
00:17:45,070 --> 00:17:47,810
هناك حادثة ضخمة تعكّر صفو مدينتكم

234
00:17:47,810 --> 00:17:53,000
إذا كنتِ تشتبهين بأنّ ساحرة ما هي
المسؤولة، فلدينا الكثير لنُقدّمه لكم

235
00:18:02,480 --> 00:18:04,200
شرطة هايدين

236
00:18:04,200 --> 00:18:08,100
سنجلس في طاولة خلفيّة، لكن أرغب
في نصب مجال عازل للصّوت

237
00:18:08,100 --> 00:18:09,650
حـ-حاضر

238
00:18:10,760 --> 00:18:12,220
حصلتُ على التّأكيد

239
00:18:12,720 --> 00:18:16,360
يبدو أنَّ المُحافظ  أرسل فعلاً طلباً للنِّظام

240
00:18:16,360 --> 00:18:19,290
مُحال أن أكذب على سيّدة جميلة

241
00:18:19,810 --> 00:18:24,700
بالمُناسبة، هلّا أجّلتِ نصب ذلك المجال إلى ما بعد
أن نطلب طعاماً وينزل إلى الطّاولة؟

242
00:18:24,920 --> 00:18:28,290
بالطبع. على الأقلّ أريد احتساء فُنجان قهوة

243
00:18:28,290 --> 00:18:31,850
لا، من فضلكِ انتظري حتّى نُنهي وجبتنا الكاملة

244
00:18:31,850 --> 00:18:33,760
سيوفّر ذلك عليكِ عناء نصب مجال مرّة أخرى

245
00:18:40,220 --> 00:18:44,060
بالنّسبة لنا، نرغب في معرفة أكبر قدر
ممكن من المعلومات حول القضيّة

246
00:18:44,570 --> 00:18:46,930
أخبرني بروايتك أوّلاً

247
00:18:46,930 --> 00:18:50,850
،صحيح أنّك حصلتَ على مُوافقة المُحافظ
لكن لا أثق بك

248
00:18:50,850 --> 00:18:53,120
لكنّكِ تتعاملين مع قضيّة ساحرات

249
00:18:53,610 --> 00:18:55,950
عاجلاً أم آجلاً، سوف يتدخّل فيلق الفُرسان

250
00:18:55,950 --> 00:18:58,820
لكن لسببٍ ما، المُحافظ يؤخّرهم

251
00:18:59,170 --> 00:19:01,570
ما يجعلكما أملنا الوحيد؟

252
00:19:01,570 --> 00:19:02,740
هكذا يبدو

253
00:19:03,320 --> 00:19:06,320
من الأساس، هذا الوضع بأكمله غريب

254
00:19:06,320 --> 00:19:09,620
قوّات الشّرطة غير مُسلَّحة بأسلحة
كافية لمقاتلة ساحرات

255
00:19:09,620 --> 00:19:11,710
ما تحتاجونه هو جيش

256
00:19:12,020 --> 00:19:16,690
لهذا السّبب حُماة السّلام العالميّون مثل فيلق
الفُرسان يتعاملون مع السّاحرات

257
00:19:17,370 --> 00:19:21,520
المُحافظ يرفض مُساعدتهم غالباً

258
00:19:21,520 --> 00:19:24,350
ليحظى بمجد حلّ القضيّة من دونهم

259
00:19:24,640 --> 00:19:28,940
أي شخص يفهم حماقةَ ذلك، لكن لماذا
تتماشون جميعكم مع هذا الرّأي؟

260
00:19:29,470 --> 00:19:34,220
بصفتكِ مُستخدِمة السّحر الوحيدة لدى شرطة
هايدين، فأعتقد بأنّكِ المسؤولة عن القضيّة

261
00:19:34,220 --> 00:19:37,110
ينبغي أن تحتجّي. فلماذا لا تفعلين؟

262
00:19:39,650 --> 00:19:40,960
من يأبه لذلك؟

263
00:19:40,960 --> 00:19:44,070
فقط أخبريني بكلّ ما تعرفينه عن السَّاحرة

264
00:19:44,070 --> 00:19:46,780
حينئذ سأركل مؤخّرة السّاحرة قدر ما تشائين

265
00:19:47,470 --> 00:19:49,980
لماذا تركّزين كثيراً على السّاحرة؟

266
00:19:50,410 --> 00:19:53,370
مُعظم النّاس يتحاشون التقرُّب
من ساحرة وقاتلة تسلسليّة

267
00:19:53,750 --> 00:19:54,400
—هذا

268
00:19:54,400 --> 00:19:56,220
غيدو، كُلي عظمة

269
00:19:58,530 --> 00:20:01,280
بالنّسبة لمُنظّمتنا جوهريّاً

270
00:20:01,280 --> 00:20:05,050
—نجمع كلّ ما يخصّ السّحر. والسّاحرات بالطّبع

271
00:20:05,050 --> 00:20:08,330
لا تُخفِ شيئاً ما لم تُرد فقدان المزيد من الثِّقة

272
00:20:09,930 --> 00:20:12,440
نصبتُ هذا المجال بنفسي

273
00:20:13,160 --> 00:20:16,560
لا تستطيع الأكاذيب خِداعي داخل هذا المجال

274
00:20:17,630 --> 00:20:18,780
حقيرة

275
00:20:21,090 --> 00:20:23,990
يا إلهي. كم أنتِ فطِنة

276
00:20:25,450 --> 00:20:26,700
أجبني

277
00:20:32,960 --> 00:20:36,080
حسناً، ظروفنا ليست جديرة بالإخفاء

278
00:20:36,680 --> 00:20:39,920
كلّ ما نريده هو إلغاء لعنة

279
00:20:40,550 --> 00:20:41,630
لعنة؟

280
00:20:42,080 --> 00:20:45,220
لعنة ساحرة. لا بدّ أنّكِ سمعتِ عنها

281
00:20:45,220 --> 00:20:49,100
بالتّأكيد. أي شخص يمارس السّحر يعلم ذلك

282
00:20:49,360 --> 00:20:51,540
إذاً سأتكلّم بإيجاز

283
00:20:51,540 --> 00:20:53,940
صديقتي هنا مُصابة بلعنة ساحرة

284
00:20:55,160 --> 00:20:58,300
لذا نبحث عن السّاحرة الّتي استخدمت اللّعنة

285
00:20:58,300 --> 00:21:01,520
وبشكل عشوائيّ تقريباً، بما أنّنا لا نملك دليلاً نتّبعه

286
00:21:01,520 --> 00:21:03,150
هذا ليس كلّ شيء

287
00:21:03,150 --> 00:21:06,140
سوف أجدها وأقتلها

288
00:21:06,140 --> 00:21:07,990
هذا انتقام

289
00:21:08,870 --> 00:21:10,450
...انتقام

290
00:21:13,620 --> 00:21:15,870
لا أعتقد بأنّنا نكذب

291
00:21:17,170 --> 00:21:18,040
صحيح

292
00:21:19,290 --> 00:21:21,170
لا، أصدّقكما

293
00:21:21,850 --> 00:21:24,040
،لديكما أسباب شخصيّة جدّاً

294
00:21:24,040 --> 00:21:27,090
لكن يمكنني الوثوق بها أكثر من وثوقي
بالأهداف العظيمة والنّبيلة

295
00:21:27,090 --> 00:21:32,520
تريدين استخدام التّفكير المنطقيّ؟
أخبرتِنا بأنّكِ تستطيعين كشف الكذب

296
00:21:32,520 --> 00:21:34,380
كذبتُ بشأن ذلك

297
00:21:34,980 --> 00:21:37,350
لا أستطيع استخدام تعويذة بهذه الجودة

298
00:21:37,590 --> 00:21:39,400
!ماذا؟! اللّعنة عليكِ

299
00:21:39,400 --> 00:21:40,710
حسناً، لا مشكلة

300
00:21:41,160 --> 00:21:43,260
سأقبل مساعدتكما

301
00:21:44,150 --> 00:21:45,740
تبدأ شراكتنا غداً

302
00:21:46,340 --> 00:21:48,220
سنلتقي هنا على التّاسعة صباحاً

303
00:21:51,280 --> 00:21:53,030
...عند الإمعان في الأمر

304
00:21:53,440 --> 00:21:56,840
حصلَتْ منّا على معلومات ولم تخبرنا بشيء

305
00:24:01,110 --> 00:24:04,850
حسناً، هل نذهب لرؤية ساحرة؟

306
00:24:05,590 --> 00:24:09,960
"الحلقة القادمة: "وقت تسلية السّاحرة: فصل النّهاية

307
00:24:05,710 --> 00:24:09,960
وقت تسلية السّاحرة

308
00:24:05,710 --> 00:24:09,960
فصل النّهاية