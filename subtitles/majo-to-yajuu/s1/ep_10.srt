1
00:00:02,140 --> 00:00:03,480
هكذا إذاً

2
00:00:03,910 --> 00:00:07,440
أعتقد بأنّ الجلّادين يعملون كثنائيّات نمطيّاً

3
00:00:07,440 --> 00:00:11,400
،نظراً إلى أنّ شريكه لم يظهر
فلا يبدو أنّه يكذب

4
00:00:11,940 --> 00:00:15,870
اجعلهما يتألّمان لدرجة يتمنّيان
ألّا يُولَدا من الأساس

5
00:00:16,400 --> 00:00:17,830
عُلِم

6
00:00:21,790 --> 00:00:24,040
غادر دون أن يسأل حتّى
عن شخصيّتكما المجهولة

7
00:00:24,480 --> 00:00:26,150
أجل، بالطّبع

8
00:00:26,150 --> 00:00:29,500
يمكننا حراستكِ كجوهرة نفيسة

9
00:00:33,040 --> 00:00:38,790
لكن نرحّب أيضاً بتقديمكِ المساعدة
إذا شعرتِ برغبة في ذلك

10
00:02:11,520 --> 00:02:17,400
السّاحرة الأصل

11
00:02:20,280 --> 00:02:21,450
اسمع

12
00:02:22,370 --> 00:02:27,620
،فوّتُّ فُرصتي للسّؤال في تلك المرّة
...لكن حصلتُ على قُبلتي الأولى الثّمينة مع

13
00:02:36,470 --> 00:02:37,180
ماذا؟

14
00:02:37,710 --> 00:02:39,520
هل كان يوجد باب هنا من قبل؟

15
00:02:39,520 --> 00:02:42,030
لا. ظهرَ مؤخّراً

16
00:02:42,470 --> 00:02:44,920
لكن لا يهمّ ذلك. ماذا كنتِ تقولين؟

17
00:02:44,920 --> 00:02:48,060
اِنسَ الأمر. أفضّل ألّا أعرف

18
00:02:48,620 --> 00:02:55,200
ما هذا المكان إذاً؟ مقرّ مُنظّمة الرّنين
السّحريّ ذائعة الصّيت؟

19
00:02:55,200 --> 00:02:57,990
مستحيل، صحيح؟ إنّه صغير جدّاً

20
00:02:58,200 --> 00:03:00,240
معكِ حقّ. إنّه ليس كذلك

21
00:03:00,240 --> 00:03:03,210
مبدئيّاً، ليس لدينا مقرّ

22
00:03:03,210 --> 00:03:05,910
على الأقلّ، لا يوجد مقرٌّ يعرفه الجميع

23
00:03:05,910 --> 00:03:08,130
هذا مدخل للممرّات

24
00:03:08,640 --> 00:03:14,310
،هيلغا، هذا طريق مُخصّصٌ لنا فقط
وذلك كي أرافقكِ إلى برِّ الأمان

25
00:03:17,340 --> 00:03:19,510
على أيّ حال، سوف أعود

26
00:03:19,510 --> 00:03:21,930
كوني مهذّبة وانتظري هنا يا غيدو

27
00:03:23,280 --> 00:03:26,930
عالجني. إنَّ التحرّك هكذا مُزعج

28
00:03:26,930 --> 00:03:28,350
ستكتفين بالانتظار فقط

29
00:03:28,820 --> 00:03:30,940
لِمَ عليكِ أن تتحرّكي؟

30
00:03:40,200 --> 00:03:42,240
هل أنت متأكّدٌ من تركها لوحدها؟

31
00:03:42,240 --> 00:03:45,970
أجل. تطالب المُنظّمة بالسّرّية
في جوانب عديدة

32
00:03:45,970 --> 00:03:50,330
أعلم بأنّكِ وافقتِ على عقدٍ
،سحريّ لحفظ أسرارنا

33
00:03:50,330 --> 00:03:52,190
لكن غيدو رفضَتْ

34
00:03:52,190 --> 00:03:54,920
بالتّالي، التّعاملات الدّاخليّة للمُنظّمة تبقى سرّية

35
00:03:54,920 --> 00:03:57,250
هذا سببٌ آخر يدفع لعدم المُخاطرة بتركها

36
00:03:57,600 --> 00:04:00,520
لا أتخيّلها لا تبرح مكانها وتفتعل مشاكل

37
00:04:00,520 --> 00:04:01,810
لا تقلقي

38
00:04:01,810 --> 00:04:05,890
إنَّ تنفيذ المهمّة وأوامري هو الطّريق
،الأقصر لتحقيق هدف غيدو

39
00:04:05,890 --> 00:04:08,220
وغيدو تعلم ذلك

40
00:04:08,480 --> 00:04:09,730
حقّاً؟

41
00:04:09,730 --> 00:04:12,380
شريكتي أكثر عقلانيّة ممّا تعتقدين

42
00:04:12,380 --> 00:04:14,690
لا داعي للقلق بشأن أي أذى قد تُسبّبه

43
00:04:15,600 --> 00:04:20,140
رغم ذلك، كانت غيدو معروفة بالتصرُّف
بناء على الغريزة

44
00:04:20,520 --> 00:04:23,530
،إلّا أنّ هناك بضعة استثناءات

45
00:04:23,530 --> 00:04:28,680
لكن لا أتوقّع ظهور أحد في بلدة كهذه

46
00:04:31,500 --> 00:04:32,910
!ساحرة

47
00:04:33,200 --> 00:04:35,220
!رأيتُها! رأيتُها! ساحرة

48
00:04:35,220 --> 00:04:36,370
حقّاً؟

49
00:04:37,750 --> 00:04:40,380
أجل! رأيتُها تخمّر جرعة من نوع ما

50
00:04:40,380 --> 00:04:43,340
!إنّها هناك فعلاً! ساحرة وأمامها قِدر كبير

51
00:04:43,340 --> 00:04:46,140
!تخمّر سموماً لتلعن النّاس

52
00:04:46,140 --> 00:04:49,420
رأيتم؟ ماذا قلتُ لكم؟

53
00:04:49,420 --> 00:04:51,200
!ولم تصدّقوني

54
00:04:51,200 --> 00:04:52,890
أجل. كانت تلك غلطتنا

55
00:04:53,360 --> 00:04:55,260
حسناً، ماذا نفعل الآن؟

56
00:04:55,260 --> 00:04:57,790
لن يصدّقنا البالغون إذا أخبرناهم

57
00:04:57,790 --> 00:04:59,770
سيترتّب علينا النّيل منها بأنفسنا

58
00:04:59,770 --> 00:05:00,560
!أنتم

59
00:05:00,560 --> 00:05:01,480
ماذا؟

60
00:05:03,250 --> 00:05:04,720
هل سمعتم شيئاً؟

61
00:05:05,420 --> 00:05:06,570
!انظروا

62
00:05:10,490 --> 00:05:11,920
...ما-ماذا

63
00:05:11,920 --> 00:05:12,870
أين؟

64
00:05:12,870 --> 00:05:13,750
ماذا؟

65
00:05:14,400 --> 00:05:17,750
أين السّاحرة؟ خذوني إليها

66
00:05:18,050 --> 00:05:19,880
!ماذا؟ من أين أتيتِ؟

67
00:05:19,880 --> 00:05:21,000
!ماذا تريدين بالضّبط؟

68
00:05:23,630 --> 00:05:26,910
هذا مزعج. سأقتلكم دُفعة واحدة

69
00:05:26,910 --> 00:05:29,510
اتّخذوا قراركم قبل أن يبقى واحدٌ منكم فقط

70
00:05:31,940 --> 00:05:34,850
سـ-سنفعلها. سنأخذكِ إليها

71
00:05:48,610 --> 00:05:50,660
المعذرة، هذا هو المكان

72
00:05:57,430 --> 00:06:00,330
!ماذا؟ سـ-ستدخلين؟ هذا ليس آمناً

73
00:06:09,480 --> 00:06:13,640
ماذا؟ زوّار صغار جذّابون

74
00:06:18,880 --> 00:06:20,900
يا إلهي! ويحكِ

75
00:06:21,640 --> 00:06:22,560
ماذا؟

76
00:06:22,850 --> 00:06:24,530
!إنّها لا تتحرّك

77
00:06:24,530 --> 00:06:28,650
تجمّدتْ ساقُكِ؟ هذا خطير

78
00:06:28,650 --> 00:06:30,980
سوف أعالجها لكِ

79
00:06:36,120 --> 00:06:38,300
!ما مشكلتكما؟! ابتعدا عن طريقي

80
00:06:39,470 --> 00:06:41,580
تشنّجت ذراعي اليسرى الآن أيضاً؟

81
00:06:41,580 --> 00:06:43,600
مهلاً. كُفّ عن ذلك

82
00:06:43,600 --> 00:06:45,650
الجرحى بحاجة لعناية

83
00:06:49,380 --> 00:06:51,760
لا تكوني محتاطة هكذا

84
00:06:51,760 --> 00:06:55,600
يحبُّ الزّبائن هذا المرهم. إنّه وصفتي السرّية

85
00:06:55,600 --> 00:06:57,100
!عجيب

86
00:06:58,150 --> 00:07:00,780
أنتِ تُشفَين بسرعة

87
00:07:01,320 --> 00:07:02,980
...هذه الرّائحة

88
00:07:02,980 --> 00:07:06,780
لستِ ساحرة، صحيح؟

89
00:07:12,300 --> 00:07:15,450
أهلاً بعودتك. ستستخدم الممرّات؟

90
00:07:15,740 --> 00:07:18,080
أجل، أتمنّى ذلك

91
00:07:18,080 --> 00:07:20,160
إلى أين تؤدّي هذه؟

92
00:07:20,160 --> 00:07:26,300
نحن على تواصل مع الغرف 5010، 6288، و 7006

93
00:07:26,770 --> 00:07:29,150
وأين الغرفة 7006؟

94
00:07:29,150 --> 00:07:31,010
في القارّة السّادسة سيّدي

95
00:07:31,250 --> 00:07:33,270
أجل، سيَفي هذا بالغرض

96
00:07:34,620 --> 00:07:37,860
لا أملك فكرة عمّا تتحدّثان عنه

97
00:07:37,860 --> 00:07:40,140
سأكون على دراية بمثل هذه
الأمور يوماً ما، صحيح؟

98
00:07:40,140 --> 00:07:44,500
بالطّبع. وبخلاف غيدو، يسرّني القول
أنّكِ ستكونين جديرة بالتّعليم

99
00:07:44,750 --> 00:07:48,820
سيّد آشاف، وصلَتْك هذه للتو

100
00:07:49,980 --> 00:07:50,780
...أسود

101
00:07:55,320 --> 00:07:56,200
ما هذا؟

102
00:07:58,010 --> 00:08:00,970
المعذرة. انتظري هنا لحظة

103
00:08:00,970 --> 00:08:01,660
ماذا؟

104
00:08:02,210 --> 00:08:02,920
!انتظر

105
00:08:03,690 --> 00:08:04,780
ما الأمر؟

106
00:08:08,990 --> 00:08:12,550
،لمعلوماتكم، أستخدم السّحر

107
00:08:12,550 --> 00:08:15,840
لكن ما زلتُ خبيرة أعشاب متواضعة

108
00:08:15,840 --> 00:08:20,680
إنَّ مناداتي بالسّاحرة هو إهانة للسّاحرات

109
00:08:20,680 --> 00:08:21,810
نحن آسفون

110
00:08:22,090 --> 00:08:24,380
هذا ثقيل جدّاً. احمله عنّي

111
00:08:24,380 --> 00:08:25,900
قومي بعملكِ

112
00:08:26,320 --> 00:08:30,320
رواياتكِ السّخيفة هي ما أقحَمتْنا
في هذه الفوضى، هل نسيتِ؟

113
00:08:34,260 --> 00:08:35,280
ماذا؟

114
00:08:37,100 --> 00:08:40,950
الكثير من الزُوَّار اليوم

115
00:08:40,950 --> 00:08:43,910
من أين أتيت بالضّبط؟

116
00:08:44,300 --> 00:08:47,130
لم أشعر بك إلى أن فُتِح الباب

117
00:08:47,470 --> 00:08:48,340
ماذا؟

118
00:08:54,160 --> 00:08:55,140
...أنت

119
00:08:55,960 --> 00:08:57,360
!جلّاد

120
00:09:15,920 --> 00:09:18,060
لا بدّ أنّكم تتساءلين عن مكاننا

121
00:09:20,220 --> 00:09:22,520
هذا هو عالَمي الخاصّ

122
00:09:23,230 --> 00:09:26,860
بُعد بديل يتمُّ الوصول إليه من خلال
دخول هذه العباءة

123
00:09:27,830 --> 00:09:32,670
لا يمكنكِ تصوّره ما لم ترتدي العباءة

124
00:09:33,260 --> 00:09:37,760
حواسكِ لا تعمل. أشكُّ في أنّكِ
تستطيعين التّفكير جيّداً حتّى

125
00:09:38,370 --> 00:09:40,440
لكنّكِ مُميّزة

126
00:09:41,360 --> 00:09:43,750
سأتيح لكِ قليلاً من الحرّية

127
00:09:45,210 --> 00:09:47,080
لديّ أسئلة لكِ

128
00:09:48,910 --> 00:09:53,830
يعمل الجلّادون كثنائي. لديّ شريك

129
00:09:54,360 --> 00:09:59,740
بدأ التصرُّف بغرابة، لذا لحقتُ به

130
00:09:59,740 --> 00:10:02,100
لكن أظنّني كشفتُ الأمر متأخّراً

131
00:10:02,610 --> 00:10:06,250
عندما وصلت، بدا أنّ كلّ شيء قد انتهى

132
00:10:11,600 --> 00:10:12,840
!لكن يا للمفاجأة

133
00:10:13,860 --> 00:10:17,940
ما كنتُ لأتمكّن من ذلك لولا
،هذه الأداة المُحرَّمة

134
00:10:17,940 --> 00:10:20,100
والّتي تتيح لي الاختفاء عن العالم

135
00:10:20,960 --> 00:10:23,560
ترتقي مُنظّمة الرّنين السّحريّ لسمعتها

136
00:10:24,720 --> 00:10:29,440
الآن تفهمين الموقف الّذي أنتِ فيه
وتعلمين بأنّكِ يجب أن تتعاوني

137
00:10:29,760 --> 00:10:32,940
لديّ سؤالان لكِ، كلاهما بسيطان

138
00:10:34,240 --> 00:10:38,070
أين أخي الصّغير وأداته المُحرَّمة؟

139
00:10:43,570 --> 00:10:45,580
هل انتهيت الآن؟

140
00:10:47,400 --> 00:10:50,420
أريد أن أتحادث مع هذه الصّغيرة أيضاً

141
00:10:58,460 --> 00:11:00,680
!آشاف

142
00:11:00,990 --> 00:11:04,140
ماذا حدث؟ ما الّذي جعلك ترتبك هكذا؟

143
00:11:04,560 --> 00:11:07,100
أجل، أنا مُرتبك تماماً

144
00:11:07,410 --> 00:11:09,740
هناك ساحرة في هذه المدينة

145
00:11:10,550 --> 00:11:12,770
وليست أي ساحرة

146
00:11:13,440 --> 00:11:16,190
السّاحرة البغيضة" الّتي لعنَتْ غيدو"

147
00:11:17,340 --> 00:11:18,810
...اسمها هو

148
00:11:26,250 --> 00:11:29,420
!آنجيلا

149
00:11:38,800 --> 00:11:40,470
!أيّتها الحقيرة

150
00:11:42,670 --> 00:11:44,100
لم أركِ منذ وقت طويل

151
00:11:44,100 --> 00:11:45,390
اشتقتُ لكِ

152
00:11:45,920 --> 00:11:49,020
،بما أنّ هذا الفضاء لا يؤثِّر بكِ

153
00:11:49,360 --> 00:11:52,450
فلا بدّ أنّ هذه العباءة أكثر من مجرّد استعراض

154
00:11:52,450 --> 00:11:55,360
ظننتُ أنّ عباءتي فريدة من نوعها

155
00:11:55,810 --> 00:11:58,820
هذه؟ صنعتُ واحدة كعباءتك

156
00:12:00,000 --> 00:12:02,030
جميلة، صحيح؟ إنّها نافعة

157
00:12:02,030 --> 00:12:04,250
!هل تقصد بأنّها قلّدَتْه؟

158
00:12:04,250 --> 00:12:07,740
.هذه ليست مجرّد دُمية سحريّة
!إنّها أداة مُحرّمة

159
00:12:07,740 --> 00:12:12,830
وصنعَتْ مثلها وبكامل وظائفها
!بمجرّد النّظر إليها؟

160
00:12:14,000 --> 00:12:18,270
لكن الّتي أصنعها تنفد صلاحيّتها بسرعة

161
00:12:19,250 --> 00:12:21,720
...لذا، لو سمحت

162
00:12:22,030 --> 00:12:23,680
أعطِني خاصّتك

163
00:12:33,060 --> 00:12:34,900
!مستحيل! كيف استطاعت الوقوف؟

164
00:12:35,690 --> 00:12:40,340
لم أمنح هذه المرأة سوى الحدّ
الأدنى من البصر والسّمع

165
00:12:40,340 --> 00:12:43,280
!حُرِمَتْ من كافّة حواسها الأخرى

166
00:12:43,850 --> 00:12:45,510
!لذا كيف؟

167
00:12:46,160 --> 00:12:48,070
!كلتاهما مجنونتان

168
00:12:52,300 --> 00:12:53,600
هل يمكنكما التّواصل؟

169
00:12:58,550 --> 00:13:02,270
لكن حتّى لو استطعتُ التّواصل
معها، لن يفيدني ذلك

170
00:13:02,270 --> 00:13:04,720
فات الأوان على الأمر

171
00:13:06,050 --> 00:13:08,300
سُحِبَ الخيط بالفعل

172
00:13:08,640 --> 00:13:11,010
ماذا؟ ماذا تقصد؟

173
00:13:11,310 --> 00:13:14,680
قوّة تجذب النّاسَ لبعضهم

174
00:13:15,520 --> 00:13:21,570
الملعون واللّاعن كلاهما يشكّلان
نوعاً خاصّاً من الرّوابط

175
00:13:21,570 --> 00:13:25,900
خيوط القدر تلك تجذبهما لبعضهما الآخر

176
00:13:26,180 --> 00:13:29,100
نُطلِق على ذلك بالجذب الخيطيّ

177
00:13:29,100 --> 00:13:34,500
بينما قوّتهما فعّالة، من الصّعب جدّاً أن أتدخّل

178
00:13:35,540 --> 00:13:37,710
على أيّ حال، لا تبدو الأمور مُبشِّرة

179
00:13:38,080 --> 00:13:42,740
عندما شفيتُ جسدَ غيدو، تركتُه
واهناً في بعض الأماكن، تحسّباً فقط

180
00:13:42,740 --> 00:13:44,670
لألّا تفتعل أي متاعب

181
00:13:44,670 --> 00:13:50,140
وبالطّبع، حتّى بكامل صحّتها، لن تملك
غيدو فرصة أمامها

182
00:13:50,470 --> 00:13:53,100
لكن في هذا الوضع، حتّى الهرب سيكون صعباً

183
00:13:53,100 --> 00:13:56,810
ليس وكأنّ غيدو ستحاول الهرب
منها على أيّ حال من الأحوال

184
00:13:56,810 --> 00:13:58,690
!مـ-مهلاً! اهدأ

185
00:14:04,400 --> 00:14:07,810
أنا هادئ تماماً. أرسلتُ غرباناً

186
00:14:07,810 --> 00:14:09,820
البحث بعشوائيّة لن يوصلنا إلى نتيجة

187
00:14:10,310 --> 00:14:12,920
بغضّ النّظر، ينبغي أن تعود إلى الدّاخل

188
00:14:12,920 --> 00:14:15,000
لماذا؟ سأساعدك في البحث

189
00:14:15,000 --> 00:14:17,760
ائتُمِنتُ على سلامتكِ

190
00:14:17,760 --> 00:14:21,300
وهذه مشكلة غيدو. لا أستطيع إقحامكِ فيها

191
00:14:22,000 --> 00:14:25,420
لكن أنا مَدينة لكما بعد أن أنقذتُماني

192
00:14:25,420 --> 00:14:28,470
!عليّ أن آخذكِ معي، وإلّا أكون قد أهدرتُ وقتي

193
00:14:29,360 --> 00:14:31,390
أنقذيني إذاً

194
00:14:32,240 --> 00:14:36,640
إذا كانت إعادتي هي عملكِ، فحافظي
!على سلامة سيف الشّيطان

195
00:14:36,890 --> 00:14:39,110
!عودي وأنقذيني

196
00:14:40,720 --> 00:14:42,590
،في هذه المرّة فقط

197
00:14:42,590 --> 00:14:44,980
مشكلة غيدو هي مشكلتي

198
00:14:45,670 --> 00:14:48,360
تعني الكثير لك، أليس كذلك؟

199
00:14:51,280 --> 00:14:53,660
أجل، تعني الكثير

200
00:14:54,640 --> 00:14:56,850
أكثر من حياتي نفسها

201
00:15:03,770 --> 00:15:06,140
طريف، أليس كذلك؟

202
00:15:06,930 --> 00:15:12,590
أردتُ رؤيتكِ، لكن ليس ذلك
الشّخص الّذي يرافقكِ دوماً

203
00:15:13,030 --> 00:15:15,140
،لذا اختبأتُ في هذه البلدة

204
00:15:15,140 --> 00:15:19,310
وأنشر إشاعات سوف تتجاهلها الكنيسة
والمُنظّمة وسكّان البلدة

205
00:15:20,230 --> 00:15:24,610
إشاعات لن يتّخذها بجدّية سواكِ يا غيدو

206
00:15:24,980 --> 00:15:27,650
مجرّد بضعة قصص خياليّة

207
00:15:28,150 --> 00:15:31,820
وانظري كيف نجح هذا المُخطّط
البسيط بصورة مثاليّة

208
00:15:32,090 --> 00:15:36,160
،يمكننا رؤية بعضنا الآخر في أي وقت
ما دمنا نشعر برغبة في ذلك

209
00:15:36,160 --> 00:15:38,320
القدر نافع هكذا

210
00:15:40,160 --> 00:15:41,370
...لذا يا غيدو

211
00:15:41,790 --> 00:15:44,450
كيف هو شعورك وأنتِ تستخدمين جسدي؟

212
00:15:45,490 --> 00:15:48,630
،بدن السّاحرة يحتاج للتكيُّف فقط

213
00:15:48,630 --> 00:15:54,220
لذا أنا واثقة بأنّه تأقلم مع روحك
وسهّل الأمور كثيراً بالنسبة لك

214
00:15:56,400 --> 00:15:58,680
أبعدي يدكِ

215
00:15:59,200 --> 00:16:03,440
لا تحبّين أن تُلمَسي؟ رغم أنّ لا مشكلة
لديكِ أن توجّهي لكمات؟

216
00:16:04,610 --> 00:16:05,890
كم أنتِ نيّقة

217
00:16:27,220 --> 00:16:29,060
تبدين مغتاظة كثيراً

218
00:16:29,840 --> 00:16:31,390
هل تكرهينني؟

219
00:16:32,590 --> 00:16:36,710
في الواقع، كنتُ ألعب مع شخص
،آخر في الآونة الأخيرة

220
00:16:36,710 --> 00:16:38,290
لكن ربّما مللت

221
00:16:38,790 --> 00:16:41,380
لم يعُد الأمر مُسلّياً

222
00:16:42,430 --> 00:16:43,600
...أخبريني يا غيدو

223
00:16:44,070 --> 00:16:47,560
هل حان الوقت لنتّخذ الأمر بجدّية؟

224
00:16:55,870 --> 00:16:57,600
كان ذلك وشيكاً

225
00:16:57,600 --> 00:16:59,700
كنتِ تسعين لقبلة، صحيح؟

226
00:17:01,330 --> 00:17:03,020
إذاً تعلمين بشأن تلك الخدعة إذاً

227
00:17:03,550 --> 00:17:04,540
لكن لا

228
00:17:04,960 --> 00:17:08,450
،إذا أردتِ حقّاً إلغاء لعنتي
،فليست هذه هي الطّريقة

229
00:17:08,450 --> 00:17:09,810
وليس هذا هو الوقت

230
00:17:12,030 --> 00:17:13,560
طارديني يا غيدو

231
00:17:14,030 --> 00:17:15,900
سأعطيكِ علامات

232
00:17:16,450 --> 00:17:19,040
،إذا بلغتِها كلّها ووصلتِ إليّ

233
00:17:19,040 --> 00:17:21,310
فسأرتقي لتوقّعاتكِ أيضاً

234
00:17:21,670 --> 00:17:25,980
نسيتُ كم عقداً مضى، لكن لنستأنف
من حيث توقّفنا في ذلك اليوم

235
00:17:29,200 --> 00:17:32,060
لا بدّ أنّ المُنظّمة شعرَتْ بالأمر الآن

236
00:17:32,570 --> 00:17:35,700
تذكّرت. لا يستطيعون إيجادي
بينما أرتدي هذا

237
00:17:36,080 --> 00:17:37,780
يا لها من لُقية مُوفّقة

238
00:17:41,810 --> 00:17:43,750
...عجيب أمركِ

239
00:17:44,270 --> 00:17:46,480
لا ترتاحين أبداً، أليس كذلك؟

240
00:17:47,640 --> 00:17:50,090
...أقسم يا آنجيلا

241
00:17:50,690 --> 00:17:54,870
!سأقتلكِ ولو كان هذا آخر عمل في حياتي

242
00:17:55,500 --> 00:17:57,980
تروقني هذه النّظرة في عينيكِ

243
00:18:11,050 --> 00:18:11,850
!غيدو

244
00:18:15,000 --> 00:18:16,980
ما زالت تتنفّس. لا شيء يدعو للقلق

245
00:18:16,980 --> 00:18:19,780
أتقول "لا شيء"؟ إنّها على حافّة الموت

246
00:18:19,780 --> 00:18:22,790
ما دامت غيدو تتنفّس، فالباقي يعمل بصورة تلقائيّة

247
00:18:23,370 --> 00:18:24,330
ما هذا؟

248
00:18:29,170 --> 00:18:30,650
!جلّاد

249
00:18:31,130 --> 00:18:33,920
لم نغب فترة طويلة، ولا أرى أي أثر للمقاومة

250
00:18:34,210 --> 00:18:35,170
...آنجيلا

251
00:18:35,670 --> 00:18:38,130
من تلك السّاحرة بالضّبط؟

252
00:18:39,780 --> 00:18:42,540
شهيرة. وسمعتِ بها أيضاً

253
00:18:43,920 --> 00:18:47,890
آنجيلا السّاحرة الأصل. ينبغي لهذا
أن يكون كلّ ما تحتاجين سماعه

254
00:18:48,170 --> 00:18:49,510
!مستحيل

255
00:18:49,510 --> 00:18:51,560
!تقصد آنجيلا فعليّاً؟

256
00:18:51,870 --> 00:18:54,730
هذا غير ممكن! من المستحيل
!أن تبقى على قيد الحياة

257
00:18:55,270 --> 00:18:58,400
!مُقدَّر للسّاحرات أن يعشن لـ 200 عام فقط

258
00:18:58,890 --> 00:19:00,780
إنّها حيّة، أجل

259
00:19:01,840 --> 00:19:05,120
،السّاحرة الخالدة، آنجيلا آنّي فويل

260
00:19:05,700 --> 00:19:08,400
،إحدى أقوى السّاحرات في العالم

261
00:19:08,400 --> 00:19:11,830
تستمرّ في العيش حتّى يومنا هذا

262
00:19:11,830 --> 00:19:17,020
إن كان هذا صحيحاً، فقد اختارت غيدو
شخصاً مُرعِباً كخصم لها

263
00:19:17,020 --> 00:19:18,600
تماماً

264
00:19:20,650 --> 00:19:25,140
أعتقد كانت آنجيلا من نقشَتْ تلك الأحرف

265
00:19:25,780 --> 00:19:26,470
هكذا إذاً

266
00:19:27,510 --> 00:19:30,140
سيبدأ ذلك أخيراً إذاً

267
00:19:39,510 --> 00:19:41,530
غيدو، هل استيقظتِ؟

268
00:19:43,460 --> 00:19:44,500
سأدخل

269
00:19:51,010 --> 00:19:53,670
هل وجدتَها؟

270
00:19:53,670 --> 00:19:56,370
لا، لا يسعني قول ذلك

271
00:19:56,370 --> 00:19:57,710
اغرب عن وجهي إذاً

272
00:19:58,180 --> 00:20:00,820
لِمَ لا تأكلين؟

273
00:20:00,820 --> 00:20:02,910
انظري إلى نفسكِ وأنتِ مليئة بالجروح

274
00:20:03,360 --> 00:20:08,140
كُلي كي تُشفَي، أنسيتِ؟ كيف أمكنكِ
أن تجوّعي نفسكِ طوال هذا الوقت؟

275
00:20:08,680 --> 00:20:11,470
إذا لم تأكلي، فدعيني أطعمكِ على الأقلّ

276
00:20:11,470 --> 00:20:12,600
انظري إليّ

277
00:20:13,490 --> 00:20:16,060
ما الهراء الّذي ستفعله هذه المرّة؟

278
00:20:18,040 --> 00:20:21,900
...آنذاك، لم تستجب ذراعي وساقي لي

279
00:20:26,320 --> 00:20:29,260
لأنّك فعلت شيئاً لهما، أليس كذلك؟

280
00:20:29,740 --> 00:20:31,040
توقّفي يا غيدو

281
00:20:46,640 --> 00:20:48,790
تبدين نابضة بالطّاقة

282
00:20:49,200 --> 00:20:51,850
أعتقد لستِ بحاجة للشفاء

283
00:20:53,120 --> 00:20:54,810
لن تحصل على فُرصة أخرى

284
00:20:55,360 --> 00:20:58,880
جرّب ذلك ثانية ولن أنتظر حتّى
إلغاء اللّعنة لأقتلك

285
00:20:59,410 --> 00:21:01,150
أنا آسف

286
00:21:01,150 --> 00:21:06,160
لكن كانت كلّ نيّتي هو تجنيبكِ الفشل

287
00:21:06,500 --> 00:21:10,580
أبذل قصارى جهدي لأضمن
أن تسير الأمور بسلاسة

288
00:21:11,020 --> 00:21:16,170
كلّ ما أفعله له معنى، ولن أفعل
شيئاً يخالف اهتماماتكِ

289
00:21:16,580 --> 00:21:18,880
أنتِ مورد بشريّ قيّم

290
00:21:18,880 --> 00:21:23,970
مُحال أن أفعل شيئاً قد يؤدّي إلى خسارتكِ

291
00:21:25,310 --> 00:21:28,690
تعلمين بأنّ اهتماماتنا واحدة

292
00:21:28,690 --> 00:21:32,100
لهذا أطعتِ أوامري

293
00:21:32,580 --> 00:21:36,060
"عندما تشتبهين بأنّني "أفعل شيئاً
،بالرّغم من ذلك

294
00:21:36,410 --> 00:21:39,750
فأنا أفعل ذلك فقط من أجل هدف أكبر

295
00:21:40,440 --> 00:21:42,440
:اسمحي لي أن أكرّر كلامي

296
00:21:42,440 --> 00:21:47,630
لستُ عدوّكِ، ولن أفعل شيئاً لأذيّتكِ

297
00:21:47,630 --> 00:21:50,450
لستُ بحاجة لإيمانكِ أو ثقتكِ

298
00:21:51,000 --> 00:21:55,410
حاليّاً، ضعي ذلك في ذهنكِ فحسب

299
00:21:59,780 --> 00:22:01,200
اغرب عن وجهي

300
00:22:01,200 --> 00:22:03,960
لا أستطيع الذّهاب إلى أيّ مكان
ما لم يتمّ شفائي

301
00:22:04,430 --> 00:22:06,260
فلديّ عظام مكسورة

302
00:22:08,730 --> 00:22:10,780
هذا مفاجئ

303
00:22:11,190 --> 00:22:14,300
!يا إلهي! يا لها من فوضى سبّبتِها

304
00:22:18,120 --> 00:22:19,600
هذا يعيدني للذّكريات

305
00:22:21,540 --> 00:22:25,660
إلى ثلاث سنوات مضت، عندما التقينا أوّل مرّة

306
00:24:00,980 --> 00:24:05,160
مولاتي السّاحرة، هل ترغبين
في العودة إلى المُنظّمة معي؟

307
00:24:05,970 --> 00:24:09,920
الحلقة القادمة: "البلاغة
"والصّمت: فصل الافتتاحيّة

308
00:24:06,540 --> 00:24:09,920
البلاغة والصّمت

309
00:24:06,540 --> 00:24:09,920
فصل الافتتاحيّة