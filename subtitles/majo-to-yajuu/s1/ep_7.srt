1
00:00:04,860 --> 00:00:07,070
ماذا؟ هل ضللتُما الطّريق؟

2
00:00:07,070 --> 00:00:09,180
يمكنني إخراج خريطة إن أحببتُما

3
00:00:10,080 --> 00:00:11,820
لا تقتليه يا غيدو

4
00:00:22,220 --> 00:00:23,930
تعالي إلى هنا يا غيدو

5
00:00:23,930 --> 00:00:25,170
أنت من عليه المجيء

6
00:00:29,380 --> 00:00:31,630
هل تألفين هذه الشّارة؟

7
00:00:31,980 --> 00:00:33,050
كلّا

8
00:00:33,050 --> 00:00:38,350
يا إلهي. أنتِ غير مهتمّة بشيء حقّاً
سوى السّاحرات، أليس كذلك؟

9
00:00:38,570 --> 00:00:41,440
تعتمد الجيوش في العادة على القوّة العدديّة

10
00:00:41,440 --> 00:00:45,040
ضدّ السّاحرات بالذّات، وجود قلّة
من النّخبة لا يجدي نفعاً

11
00:00:45,040 --> 00:00:48,810
يتطلّب الأمر كمّاً واسعاً جدّاً لدرجة
تكاد تكون لا نهائيّة

12
00:00:49,180 --> 00:00:52,880
،لكن المزعج، أنّ هذه القوّة غير مبنيّة على العدد

13
00:00:52,880 --> 00:00:55,820
إنّما على القوّة الفرديّة القاهرة

14
00:00:56,660 --> 00:00:59,680
،إذا واجهتِ شخصاً يبدو أنّه قائدهم

15
00:00:59,680 --> 00:01:01,850
فلا تفترضي أنّكِ تستطيعين هزيمته

16
00:01:01,850 --> 00:01:06,710
الكتيبة السّادسة من فيلق الفُرسان في القارّة
"الثّالثة يقودها "رجل الجليد

17
00:01:06,710 --> 00:01:08,580
مات كوغا

18
00:01:08,580 --> 00:01:11,400
قوّته مُوازية لقوّة ساحرة

19
00:01:12,760 --> 00:01:14,880
لا بدّ أنّه هذا

20
00:02:46,390 --> 00:02:50,480
السّاحرة
وسيف الشّيطان

21
00:02:46,390 --> 00:02:50,480
الفصل الثّاني

22
00:02:58,030 --> 00:02:59,120
توقّفي يا غيدو

23
00:03:00,800 --> 00:03:02,960
وفّري القبلة لوقتٍ لاحق

24
00:03:02,960 --> 00:03:04,670
ماذا؟ لماذا؟

25
00:03:04,670 --> 00:03:06,620
لا بدّ أنّ هذا هو الزّعيم، أليس كذلك؟

26
00:03:06,620 --> 00:03:09,320
!إذا قضيتُ عليه هنا، ينتهي عملنا

27
00:03:09,320 --> 00:03:12,170
غيدو، قوّتكِ هي ورقتنا الرّابحة

28
00:03:12,560 --> 00:03:15,650
لم تفهمي الصّورة الكاملة لهذه القضيّة بعد

29
00:03:15,650 --> 00:03:19,800
أخفي دوماً الورقة الرّابحة حتّى
تنكشف كافّة الأوراق

30
00:03:20,090 --> 00:03:24,190
حاليّاً، أَكسبيها الوقت للهرب

31
00:03:24,190 --> 00:03:25,760
ركّزي على ذلك فحسب

32
00:03:27,930 --> 00:03:29,480
...والآن

33
00:03:29,480 --> 00:03:32,480
أعتقد أنّ تركيزي مطلوب هنا

34
00:03:32,480 --> 00:03:34,990
عمّاذا تتمتمين مع نفسكِ؟

35
00:03:34,990 --> 00:03:38,650
لحظة، هل كنتِ تتكلّمين مع ذلك
الوسيم— أقصد ذلك الرّجل؟

36
00:03:40,530 --> 00:03:42,570
!اسمعي! يجب أن تقاتلي بشكلٍ جيّد

37
00:03:42,840 --> 00:03:45,830
سوف يركِّز عليّ إذا سقطتِ

38
00:03:45,830 --> 00:03:47,630
سأساعدكِ على الهرب

39
00:03:47,630 --> 00:03:50,230
اغربي عن وجهي بينما أُشغله

40
00:03:50,230 --> 00:03:53,670
ماذا؟ لكن ماذا ستفعلين حالما أهرب؟

41
00:03:53,900 --> 00:03:55,680
اصمتي وتحرّكي

42
00:03:56,150 --> 00:03:59,760
وجود ساحرة بجانبي يجعل جسدي يقشعرّ

43
00:04:00,520 --> 00:04:01,550
...حسناً

44
00:04:01,550 --> 00:04:03,220
هذا يصبُّ في صالحي

45
00:04:05,710 --> 00:04:07,790
ذاك هو سيف الشّيطان إذاً؟

46
00:04:07,790 --> 00:04:09,390
كان يقول الحقيقة

47
00:04:10,030 --> 00:04:12,230
هذا سببٌ آخر يدفعني لإنهاء الأمر حالاً

48
00:04:12,230 --> 00:04:13,730
!انظر نحوي

49
00:04:13,730 --> 00:04:15,560
هذا ما أقوم به بالفعل

50
00:04:25,600 --> 00:04:27,950
ماذا؟ خَسِرَتْ من الآن؟

51
00:04:43,470 --> 00:04:45,060
تبّاً

52
00:04:45,060 --> 00:04:46,930
،سمعتُ بأنّك قويّ

53
00:04:46,930 --> 00:04:50,470
لكن لستَ ساحرة حتّى. كيف تستطيع
إطلاق تعويذات دون تحرُّك؟

54
00:04:50,850 --> 00:04:56,190
فاجأتِني كذلك. لم أتوقّعكِ أن تكوني
بهذه السّرعة أو القوّة

55
00:04:56,190 --> 00:04:58,900
لا بدّ أنّ السّلاح بيدكِ اليمنى سحريّ

56
00:04:59,370 --> 00:05:02,030
هل يكمن فيه سرُّ قوّتكِ الخارقة؟

57
00:05:02,400 --> 00:05:07,110
في جُعبتي أسئلة كثيرة، لكن يمكن تأجيلها

58
00:05:11,750 --> 00:05:15,910
السّاحرات لا يمتن بهذه السّهولة
حتّى عند مُحاولة قتلهن

59
00:05:16,570 --> 00:05:19,130
آمل أن يكون ذلك صحيحاً

60
00:05:21,690 --> 00:05:22,820
...ماذا

61
00:05:31,070 --> 00:05:35,320
ما يستطيع مُستخدِم العناصر فعله مُبهر حقّاً

62
00:05:36,400 --> 00:05:38,200
إنّه نظيرٌ لساحرة؟

63
00:05:38,200 --> 00:05:41,150
كيف؟ أتقصد بأنّه غير بشريّ؟

64
00:05:41,690 --> 00:05:43,640
لا، إنّه بشريّ

65
00:05:44,180 --> 00:05:46,240
لكنّه عقدَ ميثاقاً

66
00:05:46,650 --> 00:05:47,950
ميثاق"؟"

67
00:05:48,230 --> 00:05:49,320
تماماً

68
00:05:50,140 --> 00:05:53,890
عقدَ مات كوغا ميثاقاً مع قوّة
:أصليّة لمنافسة السّاحرات

69
00:05:53,890 --> 00:05:56,950
مُستخدِم جليديّ عظيم

70
00:05:58,540 --> 00:06:00,710
إنّه ساحر عنصر

71
00:06:12,620 --> 00:06:13,470
مؤلم

72
00:06:13,890 --> 00:06:15,460
من هذا الرّجل؟

73
00:06:16,490 --> 00:06:18,100
إنّه ساحرة جوهريّاً

74
00:06:19,420 --> 00:06:21,310
آشغان! أين أنت؟

75
00:06:21,590 --> 00:06:22,680
أنا هنا

76
00:06:23,310 --> 00:06:24,750
تعال إليّ

77
00:06:26,350 --> 00:06:27,160
—هذا مُطمئن

78
00:06:27,160 --> 00:06:28,360
لا

79
00:06:28,360 --> 00:06:29,200
ماذا؟

80
00:06:29,200 --> 00:06:31,250
لم أكن أناديكِ

81
00:06:32,160 --> 00:06:33,030
...قصدتُك

82
00:06:33,460 --> 00:06:34,610
أنت

83
00:06:38,320 --> 00:06:43,170
سيف الشّيطان. يسرّني أنّني أمّنتُ
عليه قبل أن تحاولي فعل شيء

84
00:06:43,170 --> 00:06:44,340
!أعده

85
00:06:44,710 --> 00:06:50,180
حقّاً؟ هل أعيد سلاحاً خطيراً كهذا
إلى ساحرة قاتلة؟

86
00:06:55,900 --> 00:06:59,730
أعلم بأنّني لا أستطيع هزيمته. لكن
ما الّذي يمكنني فعله غير ذلك؟

87
00:07:03,250 --> 00:07:04,360
...هذه المرّة

88
00:07:04,360 --> 00:07:05,920
!نلتُ منك

89
00:07:07,260 --> 00:07:08,240
نجوتِ؟

90
00:07:08,240 --> 00:07:11,700
أكسبتُكِ عشرات الثّواني، فلماذا
لا تزالين هنا بالضّبط؟

91
00:07:11,980 --> 00:07:13,530
!أنتِ ساحرة، أليس كذلك؟

92
00:07:13,530 --> 00:07:16,990
حسناً، اعذريني على عدم الارتقاء لتوقُّعاتكِ

93
00:07:20,200 --> 00:07:20,960
ماذا؟

94
00:07:22,510 --> 00:07:24,330
!لا! لا تدعيهم يأخذونه

95
00:07:27,620 --> 00:07:29,380
!يا لها من قوّة

96
00:07:31,440 --> 00:07:33,470
سلّمي سيف الشّيطان

97
00:07:34,180 --> 00:07:36,640
هل أنت مُستميتٌ على الحصول عليه؟

98
00:07:42,680 --> 00:07:45,440
،لا أبالي لهذا الشّيء اللّعين

99
00:07:45,440 --> 00:07:49,540
!لكن لن تحصلوا على شيء منّي أيُّها الأوغاد

100
00:07:50,250 --> 00:07:51,070
ماذا؟

101
00:07:53,570 --> 00:07:55,240
!ما مُشكلتكِ؟

102
00:07:55,890 --> 00:07:57,700
...من بين كلّ عديمي الجدوى

103
00:07:59,410 --> 00:08:04,630
لا أصدِّق ذلك. حملَتْ آشغان ثمّ رمَتْه ثانية

104
00:08:04,630 --> 00:08:07,210
لم أرَ بشريّاً يفعل ذلك من قبل

105
00:08:14,260 --> 00:08:15,150
!اللّعنة

106
00:08:18,010 --> 00:08:19,920
أنتِ ثانية؟

107
00:08:19,920 --> 00:08:21,480
!أعيديه

108
00:08:21,770 --> 00:08:24,160
!لا يحقُّ لكِ حمله

109
00:08:24,160 --> 00:08:27,200
أجل، أفلتيني بسرعة. لا أستطيع تحمّلكِ

110
00:08:27,200 --> 00:08:30,150
.أتريدينه؟ افعلي ما أمليه عليكِ
فلتصمتي وتتبعيني

111
00:08:30,150 --> 00:08:31,340
!عفواً؟

112
00:08:31,340 --> 00:08:33,280
!سوف نلتقي مع آشاف

113
00:08:34,390 --> 00:08:36,490
لِمَ يجدر بي الإصغاء لهذه الشّقيّة؟

114
00:08:36,490 --> 00:08:38,950
آشاف، أين تريد أن نلتقي؟

115
00:08:39,280 --> 00:08:41,870
أنتِ بأمان إذاً يا غيدو. ماذا عنها؟

116
00:08:41,870 --> 00:08:43,750
إنّها معي، وستفعل ما أُمليه عليها

117
00:08:44,000 --> 00:08:45,190
من جديد؟

118
00:08:45,190 --> 00:08:47,050
—كلّ ما علينا الآن هو الإفلات و

119
00:08:49,480 --> 00:08:50,560
هل من مُشكلة؟

120
00:08:52,260 --> 00:08:54,770
!أنتِ! اركضي بأقصى سرعة

121
00:08:59,560 --> 00:09:00,640
—ماذا

122
00:09:05,010 --> 00:09:07,190
!هل يحاول تجميد المدينة بأكملها؟

123
00:09:09,660 --> 00:09:11,400
!تحرّكي! سيلحق بنا

124
00:09:11,850 --> 00:09:12,780
!أنا هنا

125
00:09:13,910 --> 00:09:15,110
ما خطّتكِ؟

126
00:09:15,110 --> 00:09:18,450
،حالما نعبر هذا، مهما حدث
!لا تفلتي يدي أبداً

127
00:09:24,970 --> 00:09:27,750
ما هذه التّعويذات الصّاغرة؟

128
00:09:28,000 --> 00:09:30,880
لا تنعتيها بـ"الصّاغرة" ثانية، مفهوم؟

129
00:09:30,880 --> 00:09:33,630
أكره هذه الكلمة

130
00:09:33,630 --> 00:09:36,610
—دائماً ما تقول أنّ حجم المرأة ليس

131
00:09:35,850 --> 00:09:38,470
!اصمتا! كلاكما

132
00:09:40,190 --> 00:09:41,020
ماذا؟

133
00:09:45,250 --> 00:09:46,310
!أيُعقَل هذا؟

134
00:09:52,520 --> 00:09:55,940
ماذا عسايّ أفعل أمام هذا؟

135
00:10:02,010 --> 00:10:03,510
بونتيفيرت

136
00:10:03,510 --> 00:10:09,020
تقع هذه المدينة في جنوب القارّة
الثّالثة وتتمتّع بطقس جميل

137
00:10:09,620 --> 00:10:11,440
الطّعام لذيذ أيضاً

138
00:10:11,820 --> 00:10:13,000
على حسابنا

139
00:10:13,000 --> 00:10:13,820
!رائع

140
00:10:13,820 --> 00:10:15,560
ورجال شغوفين

141
00:10:16,080 --> 00:10:19,380
دمي كساحرة يجعلني جذّابة
للنّاس لدرجة تُخيفني

142
00:10:20,630 --> 00:10:21,980
أعشق هذه البلدة

143
00:10:23,260 --> 00:10:27,180
تمّ العثور على ستّ جثث في المدينة
في الصّباح الباكر من هذا اليوم

144
00:10:27,180 --> 00:10:30,450
وجميع الجثث تظهر عليها علامات
،سلاح حادّ ما

145
00:10:30,450 --> 00:10:33,750
وتُظهِر الجروح علامات تآكُل سحريّ شديد

146
00:10:33,750 --> 00:10:38,750
تشير التّقارير إلى أنّ قاتلاً
واحداً يستخدم سحراً قويّاً

147
00:10:39,440 --> 00:10:44,330
الضّحايا كلّهم أشخاص التقيتُهم في الأمس

148
00:10:44,780 --> 00:10:47,000
آشغان، هل فعلت شيئاً من جديد؟

149
00:10:48,900 --> 00:10:52,500
ما الّذي يسعني فعله وأنا مختوم هكذا؟

150
00:10:52,970 --> 00:10:57,960
...لكن يا هيلغا، إذا أردتِني أن أفعل شيئاً

151
00:10:59,680 --> 00:11:01,790
!اسحبيني يا هيلغا

152
00:11:02,320 --> 00:11:05,230
لا مخرج آخر لكِ هذه المرّة

153
00:11:05,230 --> 00:11:07,970
إذا لم تسحبيني، فستموتين

154
00:11:09,640 --> 00:11:11,330
لا تُتعِب نفسك يا سيف الشّيطان

155
00:11:12,400 --> 00:11:14,580
لا تستطيع السّاحرة التحرُّك

156
00:11:14,580 --> 00:11:16,350
حماية عنصريّة؟

157
00:11:16,790 --> 00:11:18,820
لا تروقني أيضاً

158
00:11:19,450 --> 00:11:21,500
ضعي السّاحرة وحليفتها في درع

159
00:11:28,660 --> 00:11:31,710
أشكّ في أنّكِ وُضِعتِ في درع من قبل

160
00:11:32,030 --> 00:11:35,390
يضرب نقاطَ الضّغط الّتي تقيّد
تحرير الطّاقة السّحريّة

161
00:11:35,390 --> 00:11:37,670
أداة الكبح المثاليّة للسّاحرات

162
00:11:40,850 --> 00:11:43,600
على ذكرِ الأمر، ألم يذكروا أنّ معهما متواطئ؟

163
00:11:43,600 --> 00:11:45,970
وماهر جدّاً، طبقاً للتّقارير

164
00:11:45,970 --> 00:11:49,640
ماهر جدّاً؟ أنتِ لطيفة للغاية

165
00:11:49,640 --> 00:11:52,690
أنتِ قويّة جدّاً بحدِّ ذاتكِ

166
00:11:53,130 --> 00:11:56,900
سأكون في مأزق حقيقيّ إذا أخذتُم
تلكما الاثنتين وسيف الشّيطان

167
00:11:57,250 --> 00:11:58,470
حقّاً؟

168
00:12:00,200 --> 00:12:02,260
أنا متأسّف لأجلك إذاً

169
00:12:10,330 --> 00:12:14,780
خذوهم إلى القلعة. سأتولّى أمر هذا الشّخص

170
00:12:15,620 --> 00:12:18,240
سوف ألتقي مع القائد

171
00:12:18,240 --> 00:12:20,320
خذوا السّاحرة وصديقتها إلى القاعدة

172
00:12:21,800 --> 00:12:25,890
أفترض أنّني لا أستطيع منعكم من أخذها

173
00:12:26,180 --> 00:12:30,600
.رغم ذلك، هذا يصبُ في صالحي
كنتُ آمل أن أتكلّم معك

174
00:12:31,110 --> 00:12:32,310
ماذا؟

175
00:12:32,640 --> 00:12:35,370
لديّ عين ثاقبة تجاه الأشخاص

176
00:12:35,370 --> 00:12:38,140
،مات كوغا، رجل الجليد

177
00:12:38,140 --> 00:12:42,560
تبدو لي من النّوع الّذي يستمع
إلى حجّة بحسن النّوايا

178
00:12:42,900 --> 00:12:44,530
كلام فارغ

179
00:12:44,780 --> 00:12:49,330
عرقلتَ مهمّتنا، والآن تتكلّم عن "حسن النّوايا"؟

180
00:12:52,680 --> 00:12:55,340
،على ذكر تلك المهمّة

181
00:12:55,340 --> 00:12:58,000
ألا تعتقد بأنّها تبدو مُريبة؟

182
00:12:59,680 --> 00:13:01,880
ساحرة وستّ ضحايا

183
00:13:02,410 --> 00:13:05,520
،لكلّ ضحيّة شاهد مُناسب

184
00:13:05,520 --> 00:13:08,970
والسّاحرة ارتكبَتْ كلّ جريمة قتل
بمهاراتها السّحريّة بالسّيف؟

185
00:13:09,520 --> 00:13:14,680
،إذا أرادتْ ساحرةٌ قتل بشريّ ببساطة
فإنّها تلجأ لأساليب أخرى كثيرة

186
00:13:15,020 --> 00:13:18,480
كأنّها تقول تعالوا واقبضوا عليّ وأعدموني

187
00:13:18,480 --> 00:13:21,270
إنَّ مثل هذه السّخرية تُظهِر ثِقةً حقيقيّة

188
00:13:21,270 --> 00:13:23,360
أي يمكنك القول، ساحرة بكل معنى الكلمة

189
00:13:23,700 --> 00:13:28,710
،لعلّ الخوف من السّاحرات قد تقلّص
لكن يبقى مُتجذّراً بعمق في المجتمع

190
00:13:28,710 --> 00:13:31,600
النّاس حسّاسون جدّاً لدرجة أنّه
،إذا مات شخصٌ وكانت ساحرة قريبة

191
00:13:31,600 --> 00:13:34,400
"فسرعان ما يسمّونها "حادثة ساحرة

192
00:13:35,080 --> 00:13:40,290
إنَّ إلباس تهمة جريمة قتل لساحرة
سهلٌ جدّاً. لا حاجة لدليل ملموس

193
00:13:40,740 --> 00:13:43,000
وهذا ما حدث هنا بالضّبط

194
00:13:43,660 --> 00:13:47,500
أحدهم نصبَ فخّاً لهيلغا فيلفيت

195
00:13:50,380 --> 00:13:51,180
ماذا؟

196
00:13:53,180 --> 00:13:56,140
كيف تجرؤون على حبسي بالجليد؟

197
00:13:56,640 --> 00:14:00,680
لا تظنّوا أنّ خدعة كهذه ستُبقيني نائماً لمدّة طويلة

198
00:14:00,680 --> 00:14:03,480
لا شيء يستطيع أن يحبسني

199
00:14:03,480 --> 00:14:04,990
غير ساحرة

200
00:14:04,990 --> 00:14:06,010
!يا للهول

201
00:14:06,840 --> 00:14:08,300
!ماذا تفعلين؟ لا تُقاومي

202
00:14:08,300 --> 00:14:10,850
!توقّفوا! لا تلمسوا سيف الشّيطان

203
00:14:10,850 --> 00:14:12,390
!لا تنظروا إليه حتّى

204
00:14:15,580 --> 00:14:17,500
!ماذا أصابك؟

205
00:14:17,500 --> 00:14:18,830
!اتركه! إنّه لي

206
00:14:18,830 --> 00:14:21,250
!يكفي! توقّف! هذا لا ينتمي لك

207
00:14:21,250 --> 00:14:23,170
!إنّه ينتمي لي

208
00:14:23,450 --> 00:14:25,130
لقد بدأ

209
00:14:25,130 --> 00:14:31,600
حتّى وهو مختوم، قوّة سيف الشّيطان
الهائلة تُغري وتأسر النّاس

210
00:14:32,460 --> 00:14:37,100
حالما يترسّخ، ينتشر الإغراء بكثافة

211
00:14:37,320 --> 00:14:41,660
الجميع يغرقون طمعاً بقوّتي

212
00:14:42,240 --> 00:14:45,330
مجرّد بشر عديمو الجدوى

213
00:14:46,000 --> 00:14:49,150
المشكلة هي تلك المرأة

214
00:14:49,150 --> 00:14:50,810
لماذا لم أتمكّن من إغرائها؟

215
00:14:51,500 --> 00:14:53,630
من تكون بالضّبط؟

216
00:14:54,540 --> 00:14:56,110
ما الّذي يجري؟

217
00:14:56,640 --> 00:14:59,040
ماذا يحدث هنا؟

218
00:14:59,590 --> 00:15:01,900
يبدو أنّكم تواجهون مشكلة

219
00:15:02,460 --> 00:15:05,340
اسمحوا لي أن أعالج هذه المشكلة

220
00:15:05,600 --> 00:15:08,800
!أخبرتُك أن تبقى في مركز القيادة

221
00:15:08,800 --> 00:15:10,340
!هذا ينطبق عليكم جميعاً

222
00:15:10,630 --> 00:15:13,430
!لم آمركم بنشر المُتعقِّبين

223
00:15:15,140 --> 00:15:17,890
توقّفوا! هل فقدتم صوابكم أيضاً؟

224
00:15:18,150 --> 00:15:19,480
آشغان؟

225
00:15:19,480 --> 00:15:25,320
لا. البشر الّذين يغريهم آشغان
لا يكونون مُنظّمين هكذا

226
00:15:25,320 --> 00:15:26,690
أطلِقوا النّيران

227
00:15:30,440 --> 00:15:33,100
أحدهم ألبسَ السّاحرة تهمة القتل؟

228
00:15:33,100 --> 00:15:36,640
انطلاقاً من خبرتي، لديّ فكرة عمَّن يكون

229
00:15:36,640 --> 00:15:38,950
إنّها مكيدتهم الأقدم في نهاية المطاف

230
00:15:38,950 --> 00:15:40,410
،لا علم لديكم بهم

231
00:15:40,910 --> 00:15:42,970
لكن ثمّة رابط بينكم

232
00:15:44,250 --> 00:15:49,030
،تستهدف هذه المجموعة كافّة السّاحرات
،الخيّرات والشرّيرات على حدٍّ سواء

233
00:15:49,030 --> 00:15:51,350
وتستخدم شتّى الوسائل لاصطيادهن حتّى الانقراض

234
00:15:51,970 --> 00:15:56,140
،إنّه الجانب المُظلِم لفيلق الفرسان النّزيه

235
00:15:56,140 --> 00:15:59,100
:قوّة سرّية من صيّادي السّاحرات

236
00:15:59,660 --> 00:16:01,180
الجلّادون

237
00:16:04,500 --> 00:16:07,600
عرفتُ أنّ هذا سيحدث إذا أحضرتُم
سيف الشّيطان إلى هنا

238
00:16:07,600 --> 00:16:10,030
دون معرفة العواقب

239
00:16:11,470 --> 00:16:13,620
لذا، طبقاً للخطّة

240
00:16:13,620 --> 00:16:15,990
،حتى وسط كلّ هذه الفوضى

241
00:16:16,330 --> 00:16:22,160
يمكنني صنع جنود مُوالين لا يقعون
ضحيّة تأثير سيف الشّيطان

242
00:16:23,990 --> 00:16:26,630
بهذه الأداة المُحرَّمة

243
00:16:30,160 --> 00:16:33,040
والآن، أين هيلغا؟

244
00:16:33,040 --> 00:16:34,720
أين قد تكون؟

245
00:16:34,720 --> 00:16:36,530
جِدها

246
00:16:40,530 --> 00:16:43,520
الجلّادون هم من نظّموا حادثة السّاحرة هذه؟

247
00:16:43,520 --> 00:16:44,490
أجل

248
00:16:44,490 --> 00:16:46,160
مستحيل

249
00:16:46,160 --> 00:16:49,110
الجلّادون يمثِّلون عصر الظّلام

250
00:16:49,110 --> 00:16:51,940
جماعة مقيتة مضى عليها ألف عام

251
00:16:51,940 --> 00:16:55,660
إنَّ نجاة وبقاء الجانب المُظلم لن يُدوَّن
في كُتُب التّاريخ

252
00:16:55,950 --> 00:17:00,110
وفقاً لطبيعة عملي، أعرف الكنيسة
المُقدّسة مثلما تعرفها على الأقلّ

253
00:17:00,840 --> 00:17:03,520
لا أستطيع أن أثبت بأنّ الجلّادين هم من رتّبوا هذا

254
00:17:03,520 --> 00:17:06,630
أنا أخمّن استناداً إلى الخبرة فقط

255
00:17:06,630 --> 00:17:09,450
لكن هل أنت متأكّد بأنّ نظريّتي غير منطقيّة؟

256
00:17:10,890 --> 00:17:16,340
ألم يتقرّب منك أحدٌ بابتسامة
ماكرة، مُدّعياً بأنّه مُعين؟

257
00:17:19,560 --> 00:17:21,810
قلتَ بأنّك تخمّن؟

258
00:17:21,810 --> 00:17:24,310
أجل. لا أكثر

259
00:17:24,310 --> 00:17:27,770
تتفوّه بكلام فارغ. حاليّاً على الأقلّ

260
00:17:27,770 --> 00:17:30,730
"أجل. يسرّني أن تقول "حاليّاً

261
00:17:32,800 --> 00:17:35,020
إلى مركز القيادة

262
00:17:37,220 --> 00:17:39,280
ما الأمر؟ هل تسمعونني؟

263
00:17:39,750 --> 00:17:42,740
هل ما زال كلامي فارغاً؟

264
00:17:48,880 --> 00:17:53,260
،بما أنّك تحتضن عنصراً عظيماً
لم أكن متأكّدة بأنّني أستطيع اختراقك

265
00:17:53,260 --> 00:17:54,360
لكن هذا جيّد

266
00:17:54,920 --> 00:17:58,380
أرى بأنّك لا تزال ضعيفاً أمام الحرارة يا قائد

267
00:17:58,380 --> 00:18:00,600
...لويل

268
00:18:04,270 --> 00:18:08,850
إنّ أذيّتك تُثير غضبَ مُستخدِم
العنصر العظيم، صحيح؟

269
00:18:09,390 --> 00:18:13,890
،الآن بعد أن عرفتَ معلومات كثيرة
لم تعُد بيدقاً مناسباً بعد الآن

270
00:18:14,410 --> 00:18:18,990
رغم ذلك، أعتقد بأنّه لطالما
خطّط للتخلُّص منك

271
00:18:23,200 --> 00:18:25,760
يبدو أنّ كونك صالحاً زيادة عن اللُّزوم

272
00:18:25,760 --> 00:18:28,710
صعّبَ على الجلّادين الاستفادة منك

273
00:18:29,010 --> 00:18:32,000
،قال بأنّك مثاليّ للزجّ بك ضدّ السّاحرات

274
00:18:32,000 --> 00:18:35,670
لكن مع ذلك قيمتك لا تُقارَن بقيمة سيف الشّيطان

275
00:18:35,670 --> 00:18:37,910
هذا عديم الرّحمة، أليس كذلك؟

276
00:18:38,630 --> 00:18:41,440
وداعاً يا سيّدي

277
00:18:48,980 --> 00:18:51,330
لم يبقَ لي مفرّ ولا وسيلة للهرب

278
00:18:52,370 --> 00:18:54,230
انتهى أمري

279
00:18:55,090 --> 00:19:00,070
،سوف تنتهي حياتي هكذا
مُشهَّر بي كقاتلة تسلسليّة

280
00:19:00,610 --> 00:19:03,810
أردتُ خليلاً بشدّة

281
00:19:07,990 --> 00:19:09,580
يا لكِ من فتاة رشيقة

282
00:19:09,920 --> 00:19:13,080
يا نائب القائد، سأدعك تتولّى أمرها

283
00:19:26,880 --> 00:19:29,270
أتساءل من تكونين

284
00:19:30,400 --> 00:19:33,180
يمكنكِ أن تروي لي الحكاية كلّها لاحقاً

285
00:19:37,440 --> 00:19:38,590
!توقّف

286
00:19:39,300 --> 00:19:42,910
ماذا؟ كنتِ هنا إذاً يا هيلغا

287
00:19:44,550 --> 00:19:45,410
هيلغا

288
00:19:46,350 --> 00:19:47,770
اسحبيني

289
00:19:48,740 --> 00:19:52,670
ليسَت إلّا مسألة وقت قبل أن أتحرّر الآن

290
00:19:53,020 --> 00:19:58,880
،إذا كنتِ لا تستطيعين تجنّب ذلك
فالخيار الذكيّ هو أن تسحبيني بنفسكِ

291
00:19:59,350 --> 00:20:04,390
سَحبي هو الوسيلة الوحيدة لكِ كي تنجي

292
00:20:05,520 --> 00:20:06,840
صحيح

293
00:20:07,580 --> 00:20:09,840
يريد ذاك الرّجل سيفَ الشّيطان

294
00:20:09,840 --> 00:20:11,800
،وبوضعي الرّاهن

295
00:20:11,800 --> 00:20:15,910
لن أتمكّن من مقاومة إخباره
عن كيفيّة تحريره

296
00:20:16,940 --> 00:20:18,860
لكن لن أسمح بحدوث ذلك

297
00:20:19,300 --> 00:20:23,410
أيّ شخص غيري يحتاج شيئاً
،لسحب سيف الشّيطان

298
00:20:23,410 --> 00:20:26,650
ولن يحصلوا عليه أبداً إذا متُّ

299
00:20:27,240 --> 00:20:32,060
إذا متُّ، فلن تتمكّنوا من تحقيق مآربكم

300
00:20:32,990 --> 00:20:34,730
أردتُ خليلاً

301
00:20:35,180 --> 00:20:36,990
أردتُ أن أكون سعيدة

302
00:20:37,710 --> 00:20:39,550
،لا أريد أن أرحل هكذا

303
00:20:40,160 --> 00:20:42,840
!لكن مُحال أن أتخلّى عن واجبي الآن

304
00:20:43,320 --> 00:20:46,320
أظلُّ أحمي العالمَ من سيف الشّيطان

305
00:20:46,320 --> 00:20:50,810
هذا هو السّبب الّذي جعلَ
!حظّي سيّئاً طوال هذا الوقت

306
00:20:53,310 --> 00:20:55,520
كيف تتحرّك من تلقاء نفسها؟

307
00:20:55,520 --> 00:20:57,360
ألا يؤثّر عليها تحكُّمي؟

308
00:20:57,620 --> 00:20:59,270
هل هي بشريّة حقّاً؟

309
00:21:01,150 --> 00:21:03,490
!أنتِ! استخدمي تعويذة ما

310
00:21:03,490 --> 00:21:05,530
لا أستطيع بعد. تحرّرتُ للتو

311
00:21:11,870 --> 00:21:13,440
مُشاكسة

312
00:21:13,440 --> 00:21:15,960
السّاحرة وسيف الشّيطان؟ يا لكِ من فتاة جشعة

313
00:21:20,880 --> 00:21:23,090
!ما الّذي تفكّرين فيه بالضّبط؟

314
00:21:25,390 --> 00:21:28,300
!اذهبي! انسيني واحمي سيفَ الشّيطان

315
00:21:28,300 --> 00:21:29,920
!مُحال أن أفعل

316
00:21:29,920 --> 00:21:33,180
عليّ أن آخذكِ معي، وإلّا أكون
!قد أهدرتُ وقتي

317
00:21:34,080 --> 00:21:36,390
أنقذيني لاحقاً

318
00:21:37,020 --> 00:21:40,900
إذا كانت إعادتي هو عملكِ، فحافظي
!على سلامة سيف الشّيطان

319
00:21:42,510 --> 00:21:44,620
!عودي وأنقذيني

320
00:21:48,640 --> 00:21:51,220
مُحال أن يحدث هذا

321
00:21:52,190 --> 00:21:53,910
مُحِقّة تماماً

322
00:21:54,360 --> 00:21:57,870
أعرف كلّ شيء عنكِ

323
00:21:57,870 --> 00:22:00,490
الأمل لا يليق بكِ

324
00:22:01,680 --> 00:22:05,050
هذه القاعدة والسّاحرة مُلكي الآن

325
00:22:05,050 --> 00:22:07,500
وقريباً، سيكون سيف الشّيطان مُلكي أيضاً

326
00:22:08,740 --> 00:22:12,540
لا بصيص أمل لكِ، ولن يكون هناك

327
00:22:13,660 --> 00:22:16,070
لطالما عشتُ وحيدة طوال هذا الوقت

328
00:22:16,580 --> 00:22:19,830
لن يأتي أحدٌ لإنقاذي. لا أمل لديّ

329
00:22:20,230 --> 00:22:22,950
أعرف ذلك جيّداً

330
00:24:00,520 --> 00:24:05,190
والآن هل نكشف ورقتنا الرّابحة؟

331
00:24:05,750 --> 00:24:09,960
الحلقة القادمة: السّاحرة وسيف
"الشّيطان: الفصل الثّالث

332
00:24:05,880 --> 00:24:09,960
السّاحرة وسيف
الشّيطان

333
00:24:05,880 --> 00:24:09,960
الفصل الثّالث