1
00:00:06,890 --> 00:00:08,440
...أجل، إنّه يتحسّـ

2
00:00:08,440 --> 00:00:09,730
لا بأس به

3
00:00:13,610 --> 00:00:15,610
رغم أنّي لا أفهم

4
00:00:17,810 --> 00:00:20,300
أيمكننا إنهاء التمرين الآن؟

5
00:00:20,300 --> 00:00:22,500
لديّ موضوعٌ هام أكلّمك حوله

6
00:00:22,500 --> 00:00:24,260
هلّا توقّفتِ؟

7
00:00:24,260 --> 00:00:26,740
لا تنفكّين عن التأوّه والتثاؤب

8
00:00:28,850 --> 00:00:31,740
هلّا توقّفتِ أنت؟

9
00:00:31,740 --> 00:00:34,980
عليكِ أن تدركي مركزك

10
00:00:35,620 --> 00:00:36,460
...ماذا تقصدين

11
00:00:36,460 --> 00:00:38,010
رويدكما

12
00:00:38,340 --> 00:00:39,140
هيبيكي

13
00:00:39,140 --> 00:00:40,640
أ-أجل

14
00:00:40,640 --> 00:00:44,450
سمعتُ أنّك كنت تخونني مع تلك القصيرة هناك

15
00:00:44,450 --> 00:00:47,240
كيف يمكنك أن تكون مُطارد فتيات هكذا؟

16
00:00:47,240 --> 00:00:51,650
لكنّي أطول منكِ يا كومي-تشان

17
00:00:51,650 --> 00:00:53,180
!لا تنادني بـ كومي-تشان

18
00:00:53,610 --> 00:00:57,210
كما لا تتجرّئين على الافتراء عليّ

19
00:00:57,210 --> 00:01:00,140
أين سمعتِ عن ذلك؟

20
00:01:00,570 --> 00:01:03,180
لديك جرأةٌ حقاً يا هيبيكي

21
00:01:03,180 --> 00:01:04,660
لم أسمع من أيّ مكان

22
00:01:04,660 --> 00:01:08,420
راسلنني بذلك بالأمس لإغاظتي فقط

23
00:01:08,780 --> 00:01:10,870
إنّها معركة فتيات

24
00:01:10,870 --> 00:01:12,050
هذا مثير

25
00:01:12,430 --> 00:01:13,620
راسلتِها؟

26
00:01:13,620 --> 00:01:14,840
أجل

27
00:01:14,840 --> 00:01:18,430
فكّرتُ بأن أخفّف من وتيرتها الحادة

28
00:01:19,210 --> 00:01:24,140
كان يجب أن تعرف أنّك تعتني بأمرنا الآن

29
00:01:25,330 --> 00:01:28,150
كيو-ني صديقٌ لنا كلّنا

30
00:01:28,150 --> 00:01:28,980
ماذا؟

31
00:01:28,980 --> 00:01:30,020
ما الذي تقولانه؟

32
00:01:30,020 --> 00:01:32,580
أنتن مجرّد ألعاب له

33
00:01:32,580 --> 00:01:33,480
!ألعاب

34
00:01:33,480 --> 00:01:36,030
حسناً، سنجري حديثاً هاماً الآن

35
00:01:36,030 --> 00:01:38,030
!انتهى التمرين

36
00:01:38,710 --> 00:01:40,390
كيو-سان

37
00:01:48,900 --> 00:01:50,410
كيريومي

38
00:01:51,860 --> 00:01:52,620
ماذا؟

39
00:01:52,620 --> 00:01:55,220
هل قرّرتَ إنهاء التمرين أخيراً؟

40
00:01:56,300 --> 00:01:59,370
آسف، هذا مهم

41
00:01:59,370 --> 00:02:01,100
أيمكنك المغادرة للآن؟

42
00:02:01,470 --> 00:02:03,140
ماذا؟

43
00:02:03,140 --> 00:02:05,880
لا أريدكِ أن تقاطعي التمرين

44
00:02:05,880 --> 00:02:08,670
أمامنا حفلة

45
00:02:08,670 --> 00:02:10,040
أقاطع؟

46
00:02:10,040 --> 00:02:12,780
كيف يمكنك قول هذا بعدما خنتني؟

47
00:02:12,780 --> 00:02:15,190
أهكذا أسلوبك مع زوجتك الحقيقية؟

48
00:02:15,190 --> 00:02:16,070
لستِ زوجتي الحقيقية

49
00:02:17,440 --> 00:02:21,910
أقدّرك كرسّامةٍ من أعماقي

50
00:02:21,910 --> 00:02:23,920
وأنتِ زميلةٌ ثمينة

51
00:02:23,920 --> 00:02:26,450
لكنّ تلك ليست علاقتنا

52
00:02:31,340 --> 00:02:33,790
كيف شعور استيقاظكِ من حلمك؟

53
00:02:41,660 --> 00:02:42,890
...هيبيكي

54
00:02:43,500 --> 00:02:48,020
!هيبيكي... أيّها الأحمق

55
00:02:50,130 --> 00:02:50,850
كيريومي

56
00:02:51,320 --> 00:02:52,480
!كيريو-ساما

57
00:03:00,230 --> 00:03:01,450
كيو-ني

58
00:03:03,770 --> 00:03:06,200
أتريد التمرين مزّةً أخرى؟

59
00:03:08,260 --> 00:03:09,830
صحيح

60
00:03:10,430 --> 00:03:13,080
حسنٌ، من البداية مجدداً

61
00:03:13,080 --> 00:03:14,960
حسناً

62
00:04:54,940 --> 00:04:59,750
يبدو أنّك تسلّيت كثيراً باللهو مع 3 فتيات

63
00:05:00,430 --> 00:05:08,230
ربما لا مبرّر لهذا، لكن إن ضلّلتُك
بشيءٍ قلتُه، أقدّم اعتذاري

64
00:05:08,810 --> 00:05:09,910
أنا آسف حقّاً

65
00:05:11,150 --> 00:05:13,050
أيّاً يكن، أفهم

66
00:05:13,050 --> 00:05:17,670
لستُ مهمةً لك مُطلقاً، صحيح؟

67
00:05:18,100 --> 00:05:19,650
هذا ليس صحيحاً

68
00:05:19,650 --> 00:05:22,470
رسوماتك كانت ما أعطاني الإلهام

69
00:05:22,470 --> 00:05:27,180
للعمل بجدٍ أكبر على موسيقاي كلّ ذاك الوقت يا كيريومي

70
00:05:27,800 --> 00:05:31,680
والآن أنتَ مهووسٌ بأولئك الثلاثة

71
00:05:33,340 --> 00:05:34,020
أجل

72
00:05:34,620 --> 00:05:40,440
سأعترف بأنّي مُلهمٌ بالموسيقى التي تعزفها الرابطة العائلية

73
00:05:41,940 --> 00:05:47,070
لكن العوالم التي ترسمينها في مجالٍ مختلف عن البقية

74
00:05:47,070 --> 00:05:49,950
لا يمكنني المقارنة بينهما وتحديد الأهمّ

75
00:05:50,320 --> 00:05:53,700
كلّ ما يمكنني قوله أنّ جميعكم مهمّون لي

76
00:05:55,770 --> 00:05:57,710
الرسم وحده لا يكفي إذاً

77
00:05:57,710 --> 00:05:59,870
ليست مسألة أنّه لا يكفي

78
00:06:00,670 --> 00:06:04,030
لا يمكنني التفكير في أشياء دون التفكير بالموسيقى كما أظن

79
00:06:04,530 --> 00:06:07,970
ما في الأمر أنّي أحبّها كثيراً فقط

80
00:06:09,470 --> 00:06:14,330
صوت الفرقة المؤثر، العذب، والرائع

81
00:06:18,030 --> 00:06:24,210
لا أنكر أنّي أردتُ تقديم الرسومات لك
لأنّ موسيقاك نالت إعجابي

82
00:06:24,740 --> 00:06:28,990
لا أظنّ أنّه كان بإمكاني إنهاء أيّ من رسوماتي دون موسيقاك

83
00:06:29,390 --> 00:06:30,470
شكراً لك

84
00:06:30,470 --> 00:06:34,670
ستسمحين لي بالعمل مع جون والآخرين إذاً؟

85
00:06:34,670 --> 00:06:35,820
ماذا؟

86
00:06:35,820 --> 00:06:37,530
لمَ قد أفعل ذلك؟

87
00:06:38,370 --> 00:06:42,470
أنت بحاجةٍ لشخصٍ لعزف موسيقاك في عرضٍ مباشر، صحيح؟

88
00:06:42,470 --> 00:06:43,630
أفهم ذلك

89
00:06:44,070 --> 00:06:45,990
سأؤدي ذلك إذاً

90
00:06:46,990 --> 00:06:50,010
سأبدأ فرقتي الخاصة

91
00:06:52,020 --> 00:06:54,380
ستبدئين فرقتكِ الخاصة؟

92
00:06:54,380 --> 00:06:56,620
أي فرقةٌ فردية؟ بك فقط؟

93
00:06:56,620 --> 00:06:57,930
صحيح

94
00:06:57,930 --> 00:07:01,770
عندها يمكنني تملّكك بموسيقاي وفنّي

95
00:07:02,850 --> 00:07:06,480
!سأجعلك تنسى أولئك القصيرات

96
00:07:06,480 --> 00:07:08,030
عندما تقولين أنّكِ ستبدئين فرقتك الخاصة

97
00:07:08,030 --> 00:07:11,460
تقصدين أنّكِ ستعزفين على الآلات وتغنّين؟

98
00:07:11,460 --> 00:07:12,950
بالطبع لا

99
00:07:13,460 --> 00:07:15,660
كيف أنجز رسوماتي عندها؟

100
00:07:16,370 --> 00:07:21,100
ظننتُ أنّ أداء الحفلة على الجزيرة كان قابلاً للتنفيذ

101
00:07:21,100 --> 00:07:25,000
عندما رسمتُ مع الموسيقى

102
00:07:25,000 --> 00:07:26,860
...إذاً سوف

103
00:07:26,030 --> 00:07:29,410
لكنّي أرفض العزف مع أولئك الثلاثة

104
00:07:31,170 --> 00:07:35,980
لكن إن كنتِ لا تريدين العمل معهن
ماذا ستفعلين بخصوص الأعضاء؟

105
00:07:37,640 --> 00:07:39,860
يوزوها، أنتِ تجيدين الغناء، صحيح؟

106
00:07:39,860 --> 00:07:40,930
غنّي لنا

107
00:07:40,930 --> 00:07:42,170
بالتأكيد

108
00:07:42,170 --> 00:07:43,400
يبدو ذلك مسلياً

109
00:07:43,400 --> 00:07:45,660
لكن ماذا عن المغني الثانوي؟

110
00:07:46,940 --> 00:07:48,330
...حسناً

111
00:07:48,330 --> 00:07:52,410
ربما سيبدو الأمر سخيفاً بلا آلةٍ أو اثنتين

112
00:07:53,250 --> 00:07:54,430
وجدتُها

113
00:07:55,160 --> 00:07:58,410
ستفي هي بالغرض

114
00:07:59,860 --> 00:08:00,650
هي؟

115
00:08:12,620 --> 00:08:15,430
إذاً، هلّا أعطيتِنا إجابتك؟

116
00:08:16,230 --> 00:08:18,050
سأبدأ فرقة

117
00:08:18,050 --> 00:08:23,110
ستعزفين على البيانو أو لوحة المفاتيح أو أيّاً يكن

118
00:08:23,110 --> 00:08:23,810
حسناً؟

119
00:08:24,280 --> 00:08:28,440
كيف وصلتِ لهذا الاستنتاج؟

120
00:08:28,810 --> 00:08:34,090
أشعر بالفضول حقاً، هل أتيتِ معتقدةً أنّي سأقبل؟

121
00:08:34,930 --> 00:08:38,200
أيّ أحمق سيرفض دعوةً مني؟

122
00:08:38,570 --> 00:08:44,160
هذا السؤال وحده يعطيني سبباً كافياً
لإهانتك وطردك

123
00:08:44,160 --> 00:08:46,470
حاذري كلماتك

124
00:08:46,470 --> 00:08:48,840
يمكنني سحب دعوتي

125
00:08:59,930 --> 00:09:00,820
لا بأس

126
00:09:00,820 --> 00:09:01,600
سأنضم

127
00:09:03,230 --> 00:09:04,500
حسنٌ

128
00:09:04,500 --> 00:09:06,780
انتهيتُ لليوم إذاً

129
00:09:06,780 --> 00:09:08,230
سأذهب

130
00:09:10,620 --> 00:09:11,230
هيبيكي

131
00:09:11,230 --> 00:09:12,590
أ-أجل

132
00:09:12,590 --> 00:09:15,360
سأؤدي في الحفلة القادمة

133
00:09:17,030 --> 00:09:21,270
وسنأخذ كافة جمهور فرقة القصيرة

134
00:09:21,270 --> 00:09:24,370
بأدائي الإلهي

135
00:09:24,370 --> 00:09:28,660
مهما كان رسمي حسناً، لا يمكن أن أرضى بعزفٍ رديء

136
00:09:28,660 --> 00:09:31,160
يجدر بكِ أن تأتي بعد تمرين

137
00:09:31,160 --> 00:09:32,170
اخرسي

138
00:09:32,170 --> 00:09:35,100
غادري فقط وأعيدي راحة بالي لي

139
00:09:37,820 --> 00:09:39,760
لم أظنّ أنّكِ ستقبلين

140
00:09:40,080 --> 00:09:42,220
لما وافقتِ؟

141
00:09:42,220 --> 00:09:44,270
لسبب واحد

142
00:09:44,810 --> 00:09:45,770
لمراقبتها

143
00:09:45,770 --> 00:09:47,140
مراقبتها؟

144
00:09:47,140 --> 00:09:50,620
لا يمكن معرفة ما قد تُقدم عليه تلك الفتاة، أشعر بالقلق

145
00:09:50,620 --> 00:09:54,480
فكّرتُ أنّه يجدر بي إبقاؤها قريبةً وتحت السيطرة

146
00:09:55,100 --> 00:09:58,860
لكن هل تريدين المرور بكلّ ذاك العناء لأجلي حقاً؟

147
00:09:58,860 --> 00:10:02,340
لا-لا أفعل هذا لأجلك

148
00:10:02,340 --> 00:10:04,730
لستُ بحاجةٍ لذلك منك

149
00:10:04,730 --> 00:10:12,750
بالإضافة، ليس كأنّي لا أريد أن أريك
مقدرتي على عزف الموسيقى

150
00:10:14,130 --> 00:10:16,850
ا-انتهى الحديث

151
00:10:16,850 --> 00:10:18,650
أشعر بإعياءٍ فجأةً

152
00:10:18,650 --> 00:10:21,470
أوني-تشان، اجلب لي شيئاً بارداً

153
00:10:22,260 --> 00:10:23,010
حسناً

154
00:10:29,750 --> 00:10:34,110
أعرف أنّ كورومي مجتهدةٌ في عزف البيانو

155
00:10:38,530 --> 00:10:41,660
معركة فرقٍ معنا؟ من تظنّ نفسها؟

156
00:10:42,010 --> 00:10:46,050
هل كومي-تشان غاضبةٌ منّا حقاً؟

157
00:10:46,580 --> 00:10:48,950
لكن يبدو ذلك مسلياً

158
00:10:48,950 --> 00:10:52,670
آسف، قد نسبب لكم متاعب في حفلتكن القادمة

159
00:10:53,500 --> 00:10:54,710
مُطلقاً

160
00:10:54,710 --> 00:10:57,020
ليست غلطتك يا كيو-سان

161
00:10:57,020 --> 00:10:57,860
أجل

162
00:10:57,860 --> 00:11:00,230
كلّ هذا بسبب أنانية تلك الصغيرة

163
00:11:00,230 --> 00:11:05,180
ما علينا فعله هو قبول تحدّيها وهزيمتها شرّ هزيمة

164
00:11:05,180 --> 00:11:06,430
هذا كلّ شيء

165
00:11:07,070 --> 00:11:08,420
أنتِ محقّة

166
00:11:08,420 --> 00:11:10,660
لا وقت أمامنا حتّى الحفلة القادمة

167
00:11:10,660 --> 00:11:15,190
لا أدري إن كانت فرقة كيريومي ستصل
لمستوى يؤهل للوقوف على المسرح

168
00:11:15,560 --> 00:11:19,950
لكن إن قدّمتْ الأداء الذي تريده

169
00:11:19,950 --> 00:11:23,200
قد يعطي ذلك الحضور شيئاً جديداً

170
00:11:23,700 --> 00:11:26,530
علينا التحضّر قدر الإمكان

171
00:11:26,530 --> 00:11:28,950
كيو-ني يستمتع بهذا

172
00:11:29,590 --> 00:11:32,490
أتطلّع لمعركة الفرق مع كيريومي

173
00:11:32,490 --> 00:11:34,960
علينا بذل قصارى جهدنا

174
00:11:34,960 --> 00:11:36,800
أجل، صحيح

175
00:11:36,800 --> 00:11:39,220
يا إلهي

176
00:11:39,220 --> 00:11:44,760
لم يخطر لي أن تكون هناك فتاة
تشغل دور آلهة على جزيرة سوريو

177
00:11:44,760 --> 00:11:47,720
لكنّها تسبب نفس الإرهاق هنا كما هناك

178
00:11:49,470 --> 00:11:50,590
بالفعل

179
00:11:52,230 --> 00:11:57,070
لكنّي أغبطها على ذلك

180
00:11:57,070 --> 00:12:01,730
إنّها حازمةٌ بما يكفي لاتّخاذ
كلّ قراراتها بنفسها وصنع الأشياء

181
00:12:01,730 --> 00:12:03,410
هذا رائعٌ نوعاً ما

182
00:12:05,050 --> 00:12:06,600
صحيح

183
00:12:06,600 --> 00:12:10,010
لا يمكنني اتّخاذ كلّ قرارتي بنفسي

184
00:12:10,010 --> 00:12:12,330
أواصل التسبب بمتاعب لك

185
00:12:12,330 --> 00:12:13,620
كلا

186
00:12:14,110 --> 00:12:16,330
لم يسبق وشعرتُ أنّك تسببين متاعب لي

187
00:12:17,380 --> 00:12:20,340
كلا، أعاني من مشاكل كثيرة

188
00:12:22,220 --> 00:12:26,600
لا يمكن أن تنجز الفرقة أيّ شيءٍ دونك

189
00:12:26,600 --> 00:12:29,220
...كما فرض البحث خاصتي

190
00:12:35,450 --> 00:12:37,690
فرض البحث؟

191
00:12:38,000 --> 00:12:43,810
كنتُ مذهولاً ببدء كيريومي لفرقتها
فنسيتُ أمره تماماً

192
00:12:43,810 --> 00:12:46,620
...أريد مساعدتها، لكن

193
00:12:51,710 --> 00:12:53,360
أهذا كيو-سان؟

194
00:12:53,360 --> 00:12:54,320
جون

195
00:12:54,320 --> 00:12:56,460
أعتذر على الاتّصال بك في هذا الوقت المتأخّر

196
00:12:56,460 --> 00:12:57,340
كلا

197
00:12:57,340 --> 00:12:58,460
لا مشكلة أبداً

198
00:12:59,140 --> 00:13:05,090
فكّرتُ بشيءٍ أريد فعله لفرض البحث

199
00:13:05,090 --> 00:13:06,110
حقاً؟

200
00:13:06,110 --> 00:13:07,100
أجل

201
00:13:07,100 --> 00:13:09,970
ماذا قرّرتِ إذاً؟

202
00:13:11,020 --> 00:13:12,720
...أنا

203
00:13:13,220 --> 00:13:15,290
أريد تجربة كتابة أغنية

204
00:13:15,290 --> 00:13:16,310
أغنية؟

205
00:13:16,310 --> 00:13:17,350
أجل

206
00:13:17,350 --> 00:13:20,820
سبق وأن حظينا الثلاثة بفرصة كتابة كلماتٍ معاً

207
00:13:20,820 --> 00:13:26,570
لكنّي أريد تجربة بدء كتابة موسيقى وإنهاء أغنيةٍ بنفسي

208
00:13:26,570 --> 00:13:32,210
إن سألتني عمّا أجيده، الموسيقى هي كلّ ما يمكنني التفكير به

209
00:13:32,740 --> 00:13:35,890
الموسيقى هي ما أريد العمل عليه الآن

210
00:13:35,890 --> 00:13:37,040
...لذا فكّرت

211
00:13:37,510 --> 00:13:39,420
سأساندك بكلّ ما أقدر

212
00:13:39,740 --> 00:13:42,250
شـ-شكراً

213
00:13:42,250 --> 00:13:46,090
لكنّي لا أعرف أين أبدأ

214
00:13:46,090 --> 00:13:47,630
لذا أشعر بتوتر

215
00:13:47,970 --> 00:13:50,120
هكذا يكون الجميع بدايةً

216
00:13:50,120 --> 00:13:51,680
حصل ذلك معي أيضاً

217
00:13:52,260 --> 00:13:53,800
معك؟

218
00:13:53,800 --> 00:13:54,600
أجل

219
00:13:54,600 --> 00:13:57,100
لكنّكِ ستدركين الأمر في النهاية حتماً

220
00:13:57,100 --> 00:14:02,110
اجتهدي، وسيصبح كنزاً داخلكِ للأبد

221
00:14:02,730 --> 00:14:06,820
لذا أريد مساعدتك في اتّخاذ خطوتكِ الأولى

222
00:14:07,330 --> 00:14:11,380
كي يمكنك الحصول على كنزكِ الخاص

223
00:14:12,630 --> 00:14:13,990
...كيو-سان

224
00:14:14,620 --> 00:14:16,900
شكراً جزيلاً

225
00:14:16,900 --> 00:14:18,420
لكنّي أعتذر

226
00:14:18,420 --> 00:14:23,000
سبّبتُ لك متاعب أكثر بمعركة الفرق بيننا وكومي-تشان

227
00:14:23,000 --> 00:14:27,620
كلا. في الواقع، لنطلق أغنيتكِ في الحفلة في نهاية الشهر

228
00:14:28,820 --> 00:14:31,400
يمكننا التباهي أكثر بروعة الرابطة العائلية

229
00:14:31,400 --> 00:14:34,890
إن أخبرناهم أنّكِ كتبتِ تلك الأغنية

230
00:14:35,330 --> 00:14:38,770
ستكون سلاحنا الأقوى في مواجهة كيريومي

231
00:14:41,330 --> 00:14:44,080
سأبذل قصارى جهدي يا كيو-سان

232
00:14:44,080 --> 00:14:46,890
أعتمد عليك على الدوام الآن

233
00:14:46,890 --> 00:14:50,060
لكنّي سأمضي قُدماً ولو تطلّب الأمر وقتاً

234
00:14:56,130 --> 00:14:57,910
حسناً، لنبدأ

235
00:14:58,450 --> 00:15:02,330
سأقدّم نصيحتي لفرض بحث جون

236
00:15:02,730 --> 00:15:04,590
شـ-شكراً

237
00:15:05,000 --> 00:15:09,210
لنبدأ مباشرةً، ما الذي يجعل الموسيقى غنائيةً برأيك؟

238
00:15:09,210 --> 00:15:10,990
ما الذي يجعلها غنائية؟

239
00:15:12,420 --> 00:15:15,400
الألحان، الكلمات، والإيقاع

240
00:15:15,400 --> 00:15:19,850
هذه الأشياء الثلاثة الضرورية لمعزوفة تقليدية

241
00:15:20,080 --> 00:15:23,890
ظننتها ستكون أكثر تعقيداً من ذلك

242
00:15:23,890 --> 00:15:24,690
صحيح

243
00:15:24,690 --> 00:15:27,860
عندما تفكّر بهذه الطريقة، ليست بذاك التعقيد

244
00:15:28,450 --> 00:15:32,360
لذا لنختر أحد هذه الثلاثة لنبدأ به

245
00:15:32,360 --> 00:15:34,540
يمكنك البدء بأيٍّ منها؟

246
00:15:34,540 --> 00:15:35,200
أجل

247
00:15:35,200 --> 00:15:39,870
يمكنك البدء أين تريد، لكن أظن من الأسهل البدء بالألحان

248
00:15:40,410 --> 00:15:43,020
رغم أن ذلك يختلف من شخصٍ لآخر

249
00:15:43,020 --> 00:15:46,500
لكنّي لا أعرف كيف أؤلف لحناً

250
00:15:48,380 --> 00:15:52,070
جون، هلّا همهمتِ قليلاً؟

251
00:15:52,070 --> 00:15:53,950
همهمت؟

252
00:15:53,950 --> 00:15:54,760
أجل

253
00:16:01,230 --> 00:16:03,740
حسنٌ، هذا خيارٌ واحد

254
00:16:04,370 --> 00:16:06,660
لنشغلّه

255
00:16:09,030 --> 00:16:11,530
هذا كلّ ما نحتاجه؟

256
00:16:11,530 --> 00:16:13,150
كنتُ أهمهم فقط

257
00:16:13,590 --> 00:16:15,760
القليل من الهمهمة تكفي

258
00:16:15,760 --> 00:16:21,040
لنقم بهذا عدّة مرّات أخرى
ونختر الأفضل شكلاً رئيسياً

259
00:16:22,150 --> 00:16:24,790
أظنّ بإمكاني الهمهمة أيضاً

260
00:16:24,790 --> 00:16:28,450
كيو، لا يبدو هذا كصنع موسيقى

261
00:16:28,450 --> 00:16:31,820
قدرما يبدو فعل أشياء حتّى يصدر شيءٌ حسن بالمصادفة

262
00:16:32,130 --> 00:16:33,950
صحيحٌ تماماً

263
00:16:33,950 --> 00:16:36,300
فالتوهّج مصادفة

264
00:16:39,290 --> 00:16:43,380
بدل الغرق في التفكير والهلع

265
00:16:43,850 --> 00:16:49,320
أيمكن أنّك لست بحاجةٍ لدراسةٍ صعبة لصنع الموسيقى؟

266
00:16:49,780 --> 00:16:51,320
يمكنك فعلها بلا دراسة

267
00:16:51,640 --> 00:16:57,040
الشاق حقاً هو البدء بعدما حسمت قرارك

268
00:16:57,040 --> 00:17:00,830
والالتزام بذلك حتّى ينتهي

269
00:17:00,830 --> 00:17:04,830
لذا بالنسبة لي، أغنيتكِ جاهزة بالفعل

270
00:17:05,960 --> 00:17:08,960
في اللحظة التي قرّرتِ فيها رغبتكِ في صنعها

271
00:17:15,020 --> 00:17:18,940
حسنٌ، لنواصل تسجيل الهمهمة لفترة

272
00:17:18,940 --> 00:17:21,220
حسناً، سأجرّب

273
00:17:37,740 --> 00:17:41,800
جون، أشعر أنّ هذا يزداد غرابةً

274
00:17:41,800 --> 00:17:44,620
أظنّ همهمتك الأولى كانت الأقرب لأغنية

275
00:17:45,730 --> 00:17:47,500
أظنّ ذلك أيضاً

276
00:17:47,500 --> 00:17:50,370
ربما تشعرين بضغط

277
00:17:50,370 --> 00:17:52,870
تحاولين جاهدة لصنع أغنية جميلة

278
00:17:52,870 --> 00:17:56,010
لدرجة أنكِ وضعتِ حدّاً لقدراتك لإنجاز الأشياء بالصدفة

279
00:17:59,930 --> 00:18:03,630
سيكون من الأفضل أن تهمهمي شيئاً أكثر طبيعيّة

280
00:18:03,630 --> 00:18:08,770
كيو-ني، ما الذي يجعلك ترغب بالهمهمة؟

281
00:18:08,770 --> 00:18:10,490
...في الواقع

282
00:18:10,490 --> 00:18:14,330
وقتما أكون بمزاج ممتاز وفي حالة استرخاء

283
00:18:15,150 --> 00:18:17,740
أجل، أثناء الاستحمام مثلاً

284
00:18:32,750 --> 00:18:35,420
كـ-كيف حصل هذا؟

285
00:18:36,470 --> 00:18:40,930
قلتَ أنك تهمهم عندما تستحم

286
00:18:40,930 --> 00:18:43,630
لكن لمَ عليّ أن أكون هنا؟

287
00:18:43,630 --> 00:18:48,640
كيف يمكن أن نعرف إن كانت همهمتها
جيّدةً أم سيّئةً إن لم تكن موجوداً؟

288
00:18:50,220 --> 00:18:52,400
من المسلّي أن نستحم الأربعة معاً

289
00:18:52,400 --> 00:18:55,610
جون-تان، أتظنّين بإمكانكِ الهمهمة؟

290
00:18:55,610 --> 00:18:56,830
لا تفعلي ذلك يا سورا

291
00:18:56,830 --> 00:18:59,790
ستضعينها تحت ضغطٍ مجدداً

292
00:19:00,620 --> 00:19:02,550
شكراً لكما

293
00:19:02,550 --> 00:19:07,790
سأبذل قصارى جهدي لابتكار شيءٍ طبيعي
دون الإفراط في التفكير

294
00:19:08,450 --> 00:19:09,940
لقد عدت

295
00:19:10,500 --> 00:19:14,290
ارتداء هذا يذكّرني بوقتي بجزيرة سوريو

296
00:19:15,870 --> 00:19:20,300
كان الطعام لذيذاً، والقيلولات رائعة أيضاً

297
00:19:20,300 --> 00:19:23,170
أجل، كانت مسلية جداً

298
00:19:23,170 --> 00:19:24,760
آمل أن نذهب هناك مجدداً

299
00:19:39,490 --> 00:19:40,700
تلك

300
00:19:40,700 --> 00:19:42,110
تلك كانت ممتازة

301
00:19:43,060 --> 00:19:46,620
استعمليها كشكل رئيسي، وستكون أغنيةً مميّزة حتماً

302
00:19:47,350 --> 00:19:48,100
سجّليها

303
00:19:48,100 --> 00:19:50,580
سجّليها قبل أن ننسى

304
00:19:50,580 --> 00:19:51,410
حـ-حسناً

305
00:19:56,710 --> 00:20:00,260
لمَ تحدثن هذه الجلبة في الحمّام؟

306
00:20:09,080 --> 00:20:11,310
ما الذي تفعلونه؟

307
00:20:12,610 --> 00:20:15,310
نساعد جون-تان في صنع الموسيقى

308
00:20:16,450 --> 00:20:17,440
لقد عدت

309
00:20:24,070 --> 00:20:26,070
كيريومي إذاً؟

310
00:20:26,460 --> 00:20:27,200
أجل

311
00:20:27,810 --> 00:20:30,330
قالت أنّنا سنقدّم عرضاً كبيراً بهذه المعزوفة

312
00:20:30,330 --> 00:20:32,710
ونسحب البساط من تحت أقدامكم

313
00:20:33,180 --> 00:20:35,210
أتحمل ضغينة؟

314
00:20:36,940 --> 00:20:41,610
يمكنني عزفها الآن، لكن لا أدري

315
00:20:42,970 --> 00:20:45,340
سمعتُ غناء آيغاي-سان

316
00:20:45,980 --> 00:20:50,540
بصوتها، وبالرسم على المسرح

317
00:20:50,540 --> 00:20:53,350
أشعر أنّي سأكون أضعف حلقة

318
00:20:54,100 --> 00:20:57,860
ربما من الصعب المجاراة بالبيانو فقط

319
00:21:01,340 --> 00:21:03,180
...في تلك الحالة

320
00:21:04,130 --> 00:21:07,870
لمَ لا تصنعي مقطعاً مجهّزاً لإضافة المزيد من الصوت إذاً؟

321
00:21:07,870 --> 00:21:11,680
بالتأكيد، لو كان بمقدوري فعل شيءٍ كذلك. لكن لا يمكنني

322
00:21:11,680 --> 00:21:12,940
سأساعدك

323
00:21:12,940 --> 00:21:13,750
ماذا؟

324
00:21:14,140 --> 00:21:15,720
ما الذي تقوله؟

325
00:21:15,720 --> 00:21:20,370
بغض النظر عنّي، نحن نحاول خوض منافسةٍ مع جون والبقية

326
00:21:21,260 --> 00:21:23,510
...أفهم ذلك، لكن

327
00:21:23,850 --> 00:21:29,010
أريد مساعدتكِ كأخٍ مرّةً ما

328
00:21:33,310 --> 00:21:36,380
أوني-تشان، أنتَ تتصرف بتباهٍ

329
00:23:26,260 --> 00:23:29,760
سنهزمهن شرّ هزيمة في معركة الفرق

330
00:23:29,760 --> 00:23:32,840
يجدر بهن التأسف

331
00:23:32,840 --> 00:23:36,650
آمل أن نثير الحماس في الحفلة