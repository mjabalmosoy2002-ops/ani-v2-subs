.بُني، لا تلُم غيرك على خسارتك

220
00:21:18,380 --> 00:21:18,970
!كفى

221
00:21:26,060 --> 00:21:29,310
.حذرتك من اللعب معه

222
00:21:29,560 --> 00:21:30,730
...لكن

223
00:21:48,620 --> 00:21:49,540
.شين-سان

224
00:21:49,960 --> 00:21:51,670
.ناولني صينية التبغ

225
00:21:54,630 --> 00:21:56,090
ألم تسمعني؟

226
00:21:56,090 --> 00:21:56,960
صينية التبغ.‏

227
00:21:57,840 --> 00:21:59,590
.اجلبها بنفسك

228
00:22:04,090 --> 00:22:05,100
!تبًا لك

229
00:22:14,730 --> 00:22:16,860
.كم أنت مزعج، ابكِ في مكان آخر

230
00:22:16,860 --> 00:22:18,780
!وتسمي نفسك بالغًا؟

231
00:22:25,620 --> 00:22:28,490
!لم أضربك بهذه القوة

232
00:22:28,490 --> 00:22:31,000
.لا يهم إن كانت قوية أو خفيفة

233
00:22:31,000 --> 00:22:32,370
!أنت كبير، تصرف كالبالغين

234
00:22:32,790 --> 00:22:34,920
.ولا يهم إن كنت طفلًا أو راشدًا

235
00:22:41,590 --> 00:22:42,550
!تبًا

236
00:22:51,980 --> 00:22:52,980
!آي

237
00:22:57,650 --> 00:22:59,440
.أنت قاسٍ جدًا

238
00:22:59,900 --> 00:23:01,530
!أنا مجرد طفل صغير

239
00:23:11,950 --> 00:23:13,540
!شينوسكي

240
00:23:15,420 --> 00:23:16,000
ما الأمر؟

241
00:23:16,370 --> 00:23:18,590
ماذا حلّ بوجهك؟

242
00:23:18,590 --> 00:23:20,500
هل دخلت في عراك؟

243
00:23:20,500 --> 00:23:22,170
.يبدو أن أحدهم لقّنك درسًا قاسيًا

244
00:23:22,170 --> 00:23:23,470
من فعل هذا؟

245
00:23:23,760 --> 00:23:27,300
.كان ضخمًا جدًا، ولم أستطع مجاراته

246
00:23:27,300 --> 00:23:30,100
!لو كنت معك لساعدتك

247
00:23:30,760 --> 00:23:32,310
!إنه هنا

248
00:23:48,530 --> 00:23:49,990
!أعلم أنك هنا

249
00:24:13,180 --> 00:24:13,770
ماذا؟

250
00:24:19,980 --> 00:24:20,940
.يا ساتر

251
00:24:23,820 --> 00:24:26,780
.يبدو أنهم يخوضون معركة حامية

252
00:25:04,190 --> 00:25:06,530
.سأعود قبل الغروب يا أبي

253
00:25:06,530 --> 00:25:07,150
.حسنًا

254
00:25:08,900 --> 00:25:11,320
.والدك يبدو شخصًا لطيفًا

255
00:25:11,320 --> 00:25:13,990
.ووالدك أيضًا شخص مميز

256
00:25:13,990 --> 00:25:15,660
هل يقاتلك بجدية؟

257
00:25:15,990 --> 00:25:18,960
.تصرفات والدي غير طبيعية

258
00:25:22,210 --> 00:25:25,050
،من المفترض أرث عمل أبي

259
00:25:25,050 --> 00:25:27,630
.لكن بصراحة، أريد دراسة الطب

260
00:25:27,920 --> 00:25:29,220
حقًا؟

261
00:25:29,220 --> 00:25:31,180
لماذا لا تخبره بذلك؟

262
00:25:31,180 --> 00:25:33,850
.لو لم أكن مُتبنًى، لأخبرته

263
00:25:34,220 --> 00:25:35,680
.لا أستطيع حمل نفسي على إخباره

264
00:25:35,930 --> 00:25:37,350
هل تخشى أن يقسو عليك؟

265
00:25:38,100 --> 00:25:42,310
.لا أبدًا، لم يوبخني قط

266
00:25:44,480 --> 00:25:50,820
.أشفق على صديقك الذي لم يوبخه والداه

267
00:25:50,820 --> 00:25:54,280
.فمن حق الأطفال أن يُبخوا

268
00:25:54,280 --> 00:25:59,580
.فهم لا يميزون دائمًا بين الخطأ والصواب

269
00:25:59,580 --> 00:26:03,040
ما الذي سيحدث لهم برأيك؟

270
00:26:03,040 --> 00:26:04,500
لن يكبروا ليصبحوا صالحين!‏

271
00:26:05,590 --> 00:26:06,840
تمامًا.‏

272
00:26:06,840 --> 00:26:09,670
.لكن وضعي مختلف

273
00:26:09,670 --> 00:26:10,090
...حسنًا

274
00:26:10,090 --> 00:26:12,840
.إنه لا يوبخني، بل يتشاجر معي

275
00:26:15,550 --> 00:26:17,510
ما بك يا شيغوساوا-سينسي؟

276
00:26:17,510 --> 00:26:20,180
.طقم أسناني يتخلخل مؤخرًا

277
00:26:20,180 --> 00:26:21,430
.ساعدني في إيجاده

278
00:26:21,430 --> 00:26:22,100
.بالتأكيد

279
00:26:22,560 --> 00:26:23,850
أين هو؟

280
00:26:30,990 --> 00:26:33,530
!أخيرًا سأتمكن من النوم بجواره

281
00:26:33,530 --> 00:26:36,530
.أبي، أنا أعتذر

282
00:26:37,740 --> 00:26:39,950
.أرجوك يا أبي

283
00:26:46,920 --> 00:26:49,840
.أبي، أنا أعترف بخطأي

284
00:26:49,840 --> 00:26:51,460
لِم تعتذر لي؟

285
00:26:51,840 --> 00:26:54,260
.لم تفعل شيئًا يستوجب الاعتذار

286
00:26:54,630 --> 00:26:56,090
...لكن

287
00:26:56,470 --> 00:26:58,720
.تأكد من إغلاق الأبواب كي لا يدخل البعوض

288
00:27:00,430 --> 00:27:01,980
.بحقك

289
00:27:03,980 --> 00:27:05,480
!أبي

290
00:27:19,490 --> 00:27:21,620
لِم لا أشرب قليلًا قبل النوم؟

291
00:27:31,380 --> 00:27:32,630
...عزيزي

292
00:27:37,800 --> 00:27:39,510
.خذه معك

293
00:27:47,480 --> 00:27:50,110
.أظن أنني خسرت

294
00:28:15,380 --> 00:28:16,380
...شين-سان

295
00:28:28,600 --> 00:28:33,780
!اصطفوا وانظروا نحو العدسة

296
00:28:38,030 --> 00:28:39,910
!ها نحن ذا

297
00:28:39,910 --> 00:28:41,700
!لا تتحركوا من أماكنكم

298
00:28:59,510 --> 00:29:02,600
.أبي، لدي سؤال

299
00:29:02,600 --> 00:29:03,510
ما هو؟

300
00:29:05,770 --> 00:29:07,350
!إنه ذلك الرجل

301
00:29:07,350 --> 00:29:08,480
...أبي

302
00:29:08,980 --> 00:29:12,150
لماذا تركت حياة الساموراي؟

303
00:29:12,150 --> 00:29:13,900
.لم يكن هناك سبب محدد

304
00:29:13,900 --> 00:29:18,320
.لكن التخلي عن السيف والعمل في خدمة التوصيل ليس بالأمر الهيّن

305
00:29:20,240 --> 00:29:22,620
.لا بد أن هناك سببًا وراء ذلك

306
00:29:22,620 --> 00:29:24,490
.أقول الحقيقة

307
00:29:24,490 --> 00:29:30,920
.لكن أمي تقول إنك كنت سامورايًا عظيمًا في شبابك

308
00:29:31,210 --> 00:29:31,960
.مستحيل

309
00:29:33,630 --> 00:29:35,880
.ها أنت تتهرب من الإجابة مجددًا

310
00:29:39,590 --> 00:29:40,970
!إنها تبتلع الطُعم

311
00:29:49,560 --> 00:29:51,230
.أبي، أنت لا تجيد الصيد

312
00:29:51,230 --> 00:29:52,440
.سأنجح هذه المرة

313
00:29:59,490 --> 00:30:00,570
شين-سان؟

314
00:30:00,570 --> 00:30:01,150
نعم؟

315
00:30:01,150 --> 00:30:02,910
.أخبرني إذا أردت أن تصبح ساموراي

316
00:30:03,200 --> 00:30:06,370
.كل ما عليك فعله هو أن تتبناك عائلة والدتك

317
00:30:07,120 --> 00:30:09,250
.لا، لا يمكنني فعل ذلك

318
00:30:09,250 --> 00:30:10,080
لِم؟

319
00:30:10,540 --> 00:30:13,080
!سأشعر بالسوء إن تركت أمي وحدها

320
00:30:13,460 --> 00:30:14,170
.فهمت

321
00:30:20,420 --> 00:30:23,340
.لا بد أن وجودي يسبب لك المتاعب

322
00:30:23,340 --> 00:30:25,890
.شين-سان، أقدّر تفهمك

323
00:30:26,970 --> 00:30:29,520
أليس الطقس جميلًا اليوم؟

324
00:30:29,520 --> 00:30:31,350
.والأزهار متفتحة بالكامل

325
00:30:32,020 --> 00:30:34,230
.إنها جميلة حقًا

326
00:30:34,560 --> 00:30:38,270
...حتى الهواء في هذه الأيام له

327
00:30:40,610 --> 00:30:42,320
.له نكهة مميزة

328
00:30:43,110 --> 00:30:44,240
.إلى اللقاء

329
00:30:57,880 --> 00:30:58,710
!بائع السمك

330
00:30:58,710 --> 00:30:59,170
.نعم

331
00:30:59,170 --> 00:31:00,210
.أريد سمكًا طازجًا

332
00:31:00,210 --> 00:31:01,170
حالاً. كم تريد؟

333
00:31:01,170 --> 00:31:02,170
.تبدو جيدة

334
00:31:02,670 --> 00:31:03,720
!بائع السمك

335
00:31:04,590 --> 00:31:05,840
...لنرى

336
00:31:07,010 --> 00:31:08,720
هل ترغبين باللهو معي يا آنسة؟

337
00:31:10,100 --> 00:31:10,890
!أبي

338
00:31:17,610 --> 00:31:20,110
.لقد وفقنا اليوم

339
00:31:20,110 --> 00:31:21,940
كل هذا السمك؟

340
00:31:21,940 --> 00:31:23,110
.ليس سيئًا أبدًا

341
00:31:27,620 --> 00:31:29,200
!إنه سمك الشبوط

342
00:31:29,200 --> 00:31:32,080
.لا يميز بين أسماك المياه العذبة والمالحة

343
00:31:49,260 --> 00:31:50,970
.ِشكرًا لك

344
00:32:16,080 --> 00:32:17,500
!انتهيت

345
00:32:25,670 --> 00:32:28,800
!شينوسكي، خذ المظلة معك

346
00:32:29,220 --> 00:32:30,430
!لا أحتاج إليها

347
00:32:39,770 --> 00:32:41,440
.يا لك من ولد عنيد

348
00:32:42,900 --> 00:32:45,780
.يزداد تمرده يومًا بعد يوم

349
00:32:45,780 --> 00:32:48,200
!لم يعد يستمع إلى كلامي

350
00:32:48,530 --> 00:32:51,120
.لا يمكنني تحمل كل ذلك وحدي

351
00:32:51,120 --> 00:32:54,120
.الأولاد يحتاجون أبيه ليضبطهم

352
00:32:54,120 --> 00:32:56,040
هل تسمعني يا عزيزي؟

353
00:32:56,620 --> 00:32:58,120
.نعم

354
00:33:43,540 --> 00:33:45,290
ماذا تفعلون؟

355
00:33:45,800 --> 00:33:46,460
!خذ هذا

356
00:33:50,680 --> 00:33:52,180
!توقفوا

357
00:33:55,010 --> 00:33:57,270
!ادفع لنا الآن

358
00:33:59,100 --> 00:34:00,020
!غبي

359
00:34:00,270 --> 00:34:02,140
.أعطنا كل ما لديك

360
00:34:11,610 --> 00:34:12,530
!تبًا

361
00:34:17,580 --> 00:34:20,580
هل تعرضوا لك أيضًا؟

362
00:34:20,580 --> 00:34:23,000
!سحقًا! هذه ثاني مرة لي

363
00:34:23,000 --> 00:34:25,420
هل نُخبر المعلم؟

364
00:34:25,420 --> 00:34:29,510
!لا! لا نعلم ماذا سيفعلون بنا لو علموا

365
00:34:30,210 --> 00:34:31,800
.هذا مزعج جدًا

366
00:34:31,800 --> 00:34:36,050
.لقد أخذوا القلم الريشي البرتغالي الذي أهداه لي والدي

367
00:34:36,050 --> 00:34:37,350
وماذا عنك يا شينوسكي؟

368
00:34:37,350 --> 00:34:39,140
سرقوا منك شيئًا؟

369
00:34:39,600 --> 00:34:41,520
.لا شيء يُذكر

370
00:34:41,520 --> 00:34:43,060
!كن حذرًا

371
00:34:43,060 --> 00:34:44,940
!إنهم خطرون جدًا

372
00:34:45,520 --> 00:34:51,740
!جرّوا فتاةً من المتجر إلى غابة الخيزران خلف المعبد

373
00:34:51,740 --> 00:34:52,900
هل رأيتهم؟

374
00:34:52,900 --> 00:34:54,570
ماذا؟ حقًا؟

375
00:34:54,570 --> 00:34:56,990
ومن كانت الفتاة؟

376
00:35:05,670 --> 00:35:06,880
!شينوسكي

377
00:35:08,210 --> 00:35:09,170
!أمي

378
00:35:09,170 --> 00:35:09,960
.خذ

379
00:35:10,170 --> 00:35:12,630
.لم يكن عليكِ المجيء لاصطحابي

380
00:35:12,630 --> 00:35:13,840
.أنت مبلل بالكامل

381
00:35:13,840 --> 00:35:16,010
.لنتوقف لشرب كوب شاي لتدفأ

382
00:35:16,010 --> 00:35:16,970
تريد أكل الدانغو، أليس كذلك؟

383
00:35:16,970 --> 00:35:17,970
.لا أريد

384
00:35:18,800 --> 00:35:19,930
!شينوسكي

385
00:36:07,690 --> 00:36:09,230
.أهلًا بعودتك

386
00:36:09,230 --> 00:36:10,730
.بدّل ملابسك فورًا

387
00:36:12,230 --> 00:36:13,400
شينوسكي؟

388
00:36:14,240 --> 00:36:16,280
هلّا كففت عني قليلًا؟

389
00:36:16,280 --> 00:36:18,990
ماذا تعني؟

390
00:36:18,990 --> 00:36:21,660
.دللتك كثيرًا حتى أصبحت مغرورًا

391
00:36:21,660 --> 00:36:23,490
.سأصبح أكثر صرامة من الآن

392
00:36:23,790 --> 00:36:26,580
حسنًا، ها هي ملابسي! هل هذا يرضيكِ؟

393
00:36:26,580 --> 00:36:27,460
.خذي

394
00:36:27,790 --> 00:36:29,210
.توقف عن هذا

395
00:36:29,210 --> 00:36:30,460
.اتركيني وشأني

396
00:36:30,460 --> 00:36:31,340
شينوسكي؟

397
00:36:31,340 --> 00:36:32,550
!اخرسي أيتها العجوز

398
00:36:35,630 --> 00:36:37,380
"العجوز؟"

399
00:36:44,180 --> 00:36:46,560
هل نتركه وشأنه؟

400
00:36:46,560 --> 00:36:48,940
.زادت وقاحته مؤخرًا

401
00:36:49,900 --> 00:36:52,820
.عليك أن تكون صارمًا معه أحيانًا ليعرف حدوده

402
00:36:52,820 --> 00:36:55,400
لماذا لا نتركه يتعلم بنفسه؟

403
00:36:55,400 --> 00:36:58,610
.لا أظن ذلك، فهو بحاجة للانضباط

404
00:36:58,610 --> 00:37:02,200
،أمي كانت شديدة معي

405
00:37:04,370 --> 00:37:07,660
.وها أنت ترين النتيجة أمامكِ

406
00:37:08,830 --> 00:37:10,880
.هكذا إذن

407
00:37:10,880 --> 00:37:13,960
.الصراخ والتوبيخ لن يحلّا كل شيء

408
00:37:14,420 --> 00:37:15,960
.معك حق

409
00:37:54,250 --> 00:37:55,460
.سأدخل يا شين-سان

410
00:37:59,800 --> 00:38:02,260
.أستطيع قراءة أفكارك من ملامح وجهك

411
00:38:02,930 --> 00:38:04,680
أحقًا يا أبي؟

412
00:38:04,680 --> 00:38:05,100
.تفضل

413
00:38:07,220 --> 00:38:09,730
ولِم أكذب على ابني؟

414
00:38:14,860 --> 00:38:17,820
.لكنني لا أثق كثيرًا بكلامك

415
00:38:17,820 --> 00:38:18,820
.انظر جيدًا

416
00:38:19,400 --> 00:38:21,490
.أراك بوضوح بهذه العين

417
00:38:22,280 --> 00:38:24,490
،لو أردت شرح الأمر، هذا هو عالم السماء

418
00:38:24,490 --> 00:38:25,570
.وهذا عالم البشر

419
00:38:25,570 --> 00:38:28,510
،إذا كان عالمك في السماء واسعًا، وعالمك الأرضي ضيقًا

420
00:38:28,510 --> 00:38:30,910
.فهذا يعني أنك ستصل لمكانة عالية

421
00:38:30,910 --> 00:38:31,500
مكانة عالية؟

422
00:38:32,410 --> 00:38:33,170
.بلا شك

423
00:38:33,710 --> 00:38:35,000
.إنه أمرٌ مهم

424
00:38:35,000 --> 00:38:36,790
.ستصبح شخصًا معروفًا

425
00:38:37,500 --> 00:38:39,420
تعتقد ذلك؟

426
00:38:40,420 --> 00:38:42,760
.أثق بذلك

427
00:39:00,690 --> 00:39:01,530
...أبي

428
00:39:02,240 --> 00:39:03,650
ألا يمكننا أن نشرب قليلاً معًا؟

429
00:39:03,650 --> 00:39:05,570
.تمهّل، لا تستعجل

430
00:39:05,570 --> 00:39:07,870
وأين المتعة في ذلك؟

431
00:39:07,870 --> 00:39:09,120
.حسنًا، كما تشاء

432
00:39:09,120 --> 00:39:10,410
.هذا ما أردت سماعه

433
00:39:14,460 --> 00:39:16,710
.لا تنسَ رد الجميل

434
00:39:16,710 --> 00:39:17,500
.حالًا

435
00:39:42,110 --> 00:39:43,860
ماذا تفعلون؟

436
00:39:47,200 --> 00:39:47,820
!عليك به

437
00:39:47,820 --> 00:39:48,910
!خذ هذه

438
00:39:49,830 --> 00:39:51,290
!وهذه

439
00:39:51,830 --> 00:39:52,370
!وهذه أيضًا

440
00:39:53,660 --> 00:39:56,620
!كفاك تضييعًا لوقتنا، ادفع ما عليك

441
00:40:00,340 --> 00:40:01,920
!قلت لك، ادفع الآن

442
00:40:04,760 --> 00:40:05,670
!تبًا لكم

443
00:40:07,340 --> 00:40:08,340
أتريد القتال؟

444
00:40:11,760 --> 00:40:15,310
!يا جبان، لا تتظاهر بالشجاعة وأنت لا تملك الجرأة لسحب سيفك

445
00:40:16,850 --> 00:40:18,230
!هيا! هيا

446
00:40:18,770 --> 00:40:21,230
!هاتها هيا

447
00:40:23,280 --> 00:40:25,740
.كان عليك فعل هذه منذ البداية

448
00:40:26,280 --> 00:40:28,200
.لا تُصعب علينا الأمور

449
00:40:32,330 --> 00:40:33,700
!كان ذلك سهلاً للغاية

450
00:40:35,450 --> 00:40:36,370
!رائع

451
00:41:11,160 --> 00:41:12,950
.ستصبح شخصًا معروفًا

452
00:41:13,450 --> 00:41:15,370
.أثق بذلك

453
00:41:48,070 --> 00:41:49,450
ما الذي يحدث؟

454
00:41:53,740 --> 00:41:54,450
ما الأمر؟

455
00:41:55,240 --> 00:41:58,660
!إنه يحاول أخذ السيف لخوض عراك ما

456
00:41:58,660 --> 00:42:00,250
!اتركيني! لا بد أن أواجههم

457
00:42:00,250 --> 00:42:01,170
!لا

458
00:42:01,170 --> 00:42:02,210
!دعيني

459
00:42:02,710 --> 00:42:04,960
!أرجوك أوقفه

460
00:42:05,250 --> 00:42:06,050
!يا إلهي

461
00:42:15,350 --> 00:42:15,760
ماذا؟

462
00:42:16,560 --> 00:42:17,810
.دعيه

463
00:42:18,180 --> 00:42:20,430
.لن يصبح رجلاً إن لم يخض هذا القتال

464
00:42:20,430 --> 00:42:22,310
!لن أسمح بهذا

465
00:42:22,310 --> 00:42:24,520
!لن أتركه حتى لو كلف ذلك حياتي

466
00:42:24,770 --> 00:42:26,480
!لا دخل للنساء في هذا، أيتها القبيحة

467
00:42:29,570 --> 00:42:30,610
.اذهب

468
00:42:30,610 --> 00:42:31,110
!حاضر

469
00:42:46,630 --> 00:42:50,420
.في مثل هذه المواقف، هذا أقصى ما يمكننا فعله

470
00:42:50,670 --> 00:42:53,970
.ثقي به وانتظريه

471
00:42:53,970 --> 00:42:59,470
ألم تقولي أنك تريدينه قويًا وليس مجرد ولد مطيع؟

472
00:42:59,470 --> 00:43:02,980
.لكن، لم يكن من اللائق أن تصفني بالقبيحة

473
00:43:03,520 --> 00:43:04,770
هل قلت ذلك؟

474
00:43:05,600 --> 00:43:08,650
.بالمناسبة، لم أنتهِ من قضاء حاجتي، اتركيه رجاءً

475
00:43:09,190 --> 00:43:10,190
ما هذا؟

476
00:43:11,530 --> 00:43:12,650
.إنها ملابسي الداخلية

477
00:43:13,200 --> 00:43:16,820
.كنت مشغولًا ولم أجد وقتًا لربطها جيدًا

478
00:43:21,080 --> 00:43:21,910
ماذا؟

479
00:43:21,910 --> 00:43:23,460
!كرر ما قلت

480
00:43:23,460 --> 00:43:26,000
!أعيدوا كل ما سلبتموه مني فورًا

481
00:43:26,000 --> 00:43:26,580
ماذا؟

482
00:43:26,920 --> 00:43:29,090
وإن لم نفعل؟

483
00:43:29,290 --> 00:43:31,800
!سأعاقبكم باسم العدالة

484
00:43:34,800 --> 00:43:36,720
!العدالة، يقول

485
00:43:47,060 --> 00:43:48,020
!خذ هذه

486
00:43:53,360 --> 00:43:54,030
.إنه ماهر

487
00:43:54,320 --> 00:43:55,900
!استعدوا لنهايتكم

488
00:43:57,200 --> 00:43:58,740
!هات ما لديك

489
00:44:01,580 --> 00:44:03,580
أتحاول قتلي حقًا؟

490
00:44:05,250 --> 00:44:06,960
!توقف! هذا خطير

491
00:44:08,830 --> 00:44:10,000
!قلت توقف

492
00:44:20,850 --> 00:44:21,810
.توقف

493
00:44:21,810 --> 00:44:23,470
.رجاءً، توقف

494
00:44:23,470 --> 00:44:24,470
.أترجاك

495
00:44:25,890 --> 00:44:26,890
،خذ مال لك

496
00:44:27,690 --> 00:44:29,020
.يمكنك استعادته

497
00:44:58,300 --> 00:44:59,800
.نحن آسفون

498
00:45:05,770 --> 00:45:06,600
.فعلتها

499
00:45:09,270 --> 00:45:10,020
...فعلتها

500
00:45:13,650 --> 00:45:15,980
!فعلتها! انتصرت

501
00:45:47,020 --> 00:45:47,930
!شينوسكي

502
00:45:48,770 --> 00:45:50,060
!عدت

503
00:45:50,060 --> 00:45:51,940
هل ترغب بحمام؟

504
00:45:51,940 --> 00:45:54,060
.بذلت كل ما في وسعي

505
00:45:54,060 --> 00:45:54,940
هل استمتعت بذلك؟

506
00:45:55,360 --> 00:45:55,940
!بالتأكيد

507
00:45:56,690 --> 00:45:58,940
كيف كانت أول معركة لك؟

508
00:45:58,940 --> 00:46:00,740
!انتصرت بسهولة

509
00:46:00,740 --> 00:46:02,950
.رائع. كنت أعلم أنك ستصبح رجلًا عظيمًا

510
00:46:03,990 --> 00:46:04,910
عظيم؟

511
00:46:09,870 --> 00:46:11,420
...شينوسكي

512
00:46:15,540 --> 00:46:17,420
.لا بد أنه شعور جميل

513
00:46:33,900 --> 00:46:35,650
.ما أروعها

514
00:46:35,650 --> 00:46:38,190
...إنها إحدى سفن أسطول باكوفو الحربي

515
00:46:38,190 --> 00:46:41,570
.أسماء سفن حربية يابانية

516
00:46:38,190 --> 00:46:41,570
:الذي يتألف من
.شوكّاكو مارو، تشويو مارو، وبانريو مارو

517
00:46:41,570 --> 00:46:46,660
.وهي تحت قيادة المفوض البحري، كاتسو كايشو-سينسي

518
00:46:47,410 --> 00:46:48,910
كاتسو كايشو؟

519
00:46:48,910 --> 00:46:51,460
.نعم، إنه رجل يستحق الإعجاب

520
00:46:51,790 --> 00:46:54,790
،فقد أبحر على متن سفينة حربية تُدعى كانرين مارو

521
00:46:54,790 --> 00:46:58,340
.قاطعًا المحيط بأكمله ليصل إلى أمريكا

522
00:46:58,340 --> 00:46:59,000
أمريكا؟

523
00:46:59,300 --> 00:47:02,340
.هذه هي الدولة التي تدعى أمريكا

524
00:47:02,340 --> 00:47:03,510
.وهنا اليابان

525
00:47:03,510 --> 00:47:05,090
هذا الشيء الصغير؟

526
00:47:05,090 --> 00:47:08,350
،لو كانت أمريكا وروسيا والصين بحارًا

527
00:47:08,350 --> 00:47:10,520
.فإن اليابان ليست سوى بركة صغيرة

528
00:47:12,020 --> 00:47:17,770
.هناك أناس بيض، وحمر، وسود يعيشون في العالم

529
00:47:17,770 --> 00:47:20,730
!العالم وراء البحار يبدو مذهلًا

530
00:47:22,280 --> 00:47:28,240
.هذا ما يقوله ساكاموتو ريوما-سان دائمًا

531
00:47:28,240 --> 00:47:30,080
ساكاموتو ريوما؟

532
00:47:30,080 --> 00:47:30,870
!نعم

533
00:47:30,870 --> 00:47:33,500
.إنه تلميذ لكاتسو-سينسي

534
00:47:33,500 --> 00:47:36,960
.إنه يعمل بجد ليمهد الطريق لعهد جديد من الازدهار

535
00:47:36,960 --> 00:47:38,710
.إنها لذيذة

536
00:47:38,710 --> 00:47:42,210
.إنها كعكة هولندية تُدعى كاستيلا

537
00:47:42,590 --> 00:47:45,300
.كاستيلا؟ طعمها لذيذ جدًا

538
00:47:45,300 --> 00:47:46,720
.بالتأكيد

539
00:47:46,720 --> 00:47:47,970
.طعمها لا يقاوم

540
00:47:51,140 --> 00:47:52,100
!بخيل

541
00:47:53,020 --> 00:47:54,230
!كاستيلا

542
00:47:54,230 --> 00:47:55,350
!أمريكا

543
00:47:55,350 --> 00:47:57,020
!ساكاموتو ريوما

544
00:47:57,020 --> 00:47:58,770
!عهد جديد

545
00:47:58,770 --> 00:48:02,570
.إنهم جميعًا رائعون

546
00:48:15,500 --> 00:48:20,710
أبي، الحرف "شين" في اسمي شينوسكي يعني "الجديد"، صحيح؟

547
00:48:20,710 --> 00:48:21,380
.نعم

548
00:48:22,300 --> 00:48:24,880
.أظن أنني فهمت السبب

549
00:48:24,880 --> 00:48:26,220
فهمت ماذا؟

550
00:48:26,220 --> 00:48:28,260
.لا أصدق أنني لم ألاحظ هذا من قبل

551
00:48:28,260 --> 00:48:30,600
،كما يقولون
.الأطفال لا يدركون أبدًا مدى محبة والديهم لهم

552
00:48:35,310 --> 00:48:37,770
.لم أفهم قصدك

553
00:48:37,770 --> 00:48:46,110
.أقصد أنك اخترت حرف "شين" لأنك توقعت عهدًا جديدًا

554
00:48:46,110 --> 00:48:47,320
.انظر لما يجري الآن

555
00:48:47,320 --> 00:48:51,740
.حتى الشوغون مضطر للخروج في حملة إلى تشوشو

556
00:48:52,080 --> 00:48:54,660
.عهد شوغونية توكوغاوا يقترب من نهايته

557
00:48:55,160 --> 00:48:58,370
.تعرف الكثير يا شين-سان

558
00:48:58,370 --> 00:49:01,710
.ماذا؟ ظننت أن الجميع يعرف ذلك

559
00:49:02,380 --> 00:49:04,090
هل سنشهد عهدًا جديدًا؟

560
00:49:05,010 --> 00:49:06,670
.نعم، سنشهده يا أبي

561
00:49:08,630 --> 00:49:13,100
.اليابان ستولد من جديد، وسيبدأ عهد جديد

562
00:49:13,100 --> 00:49:15,810
وهذا هو معنى "شين" في اسمي، أليس كذلك؟

563
00:49:17,310 --> 00:49:19,810
.في الواقع، لا

564
00:49:20,980 --> 00:49:22,650
ما السبب إذن؟

565
00:49:23,270 --> 00:49:26,610
...اسمك كان مجرد اختيار عشوائي

566
00:49:26,990 --> 00:49:27,900
.من والدتك

567
00:49:29,320 --> 00:49:32,410
.تفسد اللحظات الجميلة دائمًا يا أبي

568
00:49:36,160 --> 00:49:41,830
!أراهن أنك لا تستوعب مدى الخطر الذي يهدد المحلّ

569
00:49:41,830 --> 00:49:47,260
.تخيل لو أن هذا العجوز مات فجأة اليوم

570
00:49:47,260 --> 00:49:48,800
ماذا ستفعل حينها؟

571
00:49:48,800 --> 00:49:53,050
.أثق أنك ستتدبر أمرك، ربما كقوّاد أو شيء كهذا

572
00:49:53,050 --> 00:49:57,350
لكن ماذا عن زوجتك وشينوسكي؟

573
00:49:57,350 --> 00:49:58,730
ماذا تعتقد؟

574
00:50:13,950 --> 00:50:17,160
لا تريد سماع ثرثرتي المزعجة، أليس كذلك؟

575
00:50:17,160 --> 00:50:18,450
أليس كذلك يا زعيم؟

576
00:50:36,640 --> 00:50:39,020
!الزعيم

577
00:50:39,020 --> 00:50:40,640
!توقعنا قدومك يا زير النساء

578
00:50:41,020 --> 00:50:42,980
.تبدين فاتنة اليوم يا أوكيو-تشان

579
00:50:51,610 --> 00:50:53,150
.يا لها من ضرطه قوية

580
00:50:55,160 --> 00:50:56,620
!بحقك

581
00:50:56,740 --> 00:50:59,200
هل تحاول مغازلتي الآن؟

582
00:50:59,200 --> 00:51:02,620
!أنا مشغولة جدًا الآن

583
00:51:02,620 --> 00:51:06,290
.لكن لا أنكر جرأتك التي لا تتغير أبدًا

584
00:51:07,090 --> 00:51:07,960
ماذا؟

585
00:51:07,960 --> 00:51:09,210
.لم أفعل شيئًا

586
00:51:10,010 --> 00:51:12,300
.نسيه الزبون الذي غادر للتو

587
00:51:13,300 --> 00:51:16,390
.الساموراي الذي ينسى حمل سيفه عند خصره يعد فاشلًا

588
00:51:16,390 --> 00:51:18,560
.ربما كان سكرانًا، لكن لا عذر له

589
00:51:19,560 --> 00:51:20,520
.صدقت

590
00:51:20,520 --> 00:51:23,690
أليس السيف روح الساموراي؟

591
00:51:23,690 --> 00:51:27,110
!يبدو أن كل شيء يتداعى لديه، خصره وروحه على حد سواء

592
00:51:32,150 --> 00:51:32,900
.ناوليني إياه

593
00:51:37,160 --> 00:51:39,120
.ليس بسيف عادي

594
00:51:40,240 --> 00:51:43,000
.سأخرج وأعيده إليه بسرعة

595
00:51:43,790 --> 00:51:44,660
...حسنٌ

596
00:51:46,080 --> 00:51:48,390
!لحظة واحدة يا سيد هاغوري

597
00:51:48,630 --> 00:51:50,590
!نسيت أن تدفع

598
00:51:52,510 --> 00:51:53,720
.خدعنا مرة أخرى

599
00:52:13,940 --> 00:52:17,200
ما غايتك من هذا؟

600
00:52:17,570 --> 00:52:20,990
.قتلي لن يغير شيئًا

601
00:52:21,450 --> 00:52:24,500
.اليابان تمضي نحو مستقبل جديد، ولا أحد بإمكانه منع ذلك

602
00:52:25,210 --> 00:52:26,160
!لا جدوى من النقاش

603
00:52:27,290 --> 00:52:29,170
مصممٌ على قتلي إذن؟

604
00:52:34,420 --> 00:52:38,300
.تبًا! نسيت سيفي هناك

605
00:52:40,600 --> 00:52:41,430
!لا تدعوه يهرب

606
00:52:41,430 --> 00:52:43,890
!توقف

607
00:52:59,280 --> 00:53:00,990
.كان ذلك وشيكًا

608
00:53:06,580 --> 00:53:08,960
هذا لك، صحيح؟

609
00:53:13,590 --> 00:53:16,170
.شكرًا! أنا ممتن لك

610
00:53:16,170 --> 00:53:19,590
.يبدو أن "روح الساموراي" حملٌ ثقيل

611
00:53:20,300 --> 00:53:24,060
.بالفعل، فأنا لا أملك مقوماتها

612
00:53:28,560 --> 00:53:29,480
!وجدته

613
00:53:35,440 --> 00:53:37,690
.لا بد أن لعبة الاختباء هذه صعبة عليك

614
00:53:39,400 --> 00:53:42,240
.الجميع يلاحقوني بلا هوادة

615
00:53:53,250 --> 00:53:55,170
.أنتم حقًا عنيدون

616
00:53:55,170 --> 00:53:57,760
أتريدين اللهو معي لاحقًا يا آنسة؟

617
00:53:57,760 --> 00:53:58,970
!لنغادر فورًا

618
00:54:01,630 --> 00:54:06,720
.سيدي، من الأفضل أن تبتعد قبل أن تزداد الأمور سوءًا

619
00:54:06,720 --> 00:54:08,770
...كنت أتمنى ذلك

620
00:54:09,230 --> 00:54:11,310
.ها نحن نلتقي مرة أخرى يا هاغوريغومو

621
00:54:11,640 --> 00:54:14,440
،شككت أنك لست مجرد زير نساء

622
00:54:14,440 --> 00:54:17,320
!والآن تأكدت أنك جزء من عصابته

623
00:54:19,530 --> 00:54:21,400
.لا علاقة لي به

624
00:54:21,400 --> 00:54:22,160
!اصمت

625
00:54:22,530 --> 00:54:25,990
.لا يمكنك إنكار ذلك، فأنت متورط مع مجرم يهدد النظام

626
00:54:26,830 --> 00:54:29,500
!لا يهم، اقتلوهما معًا

627
00:54:35,790 --> 00:54:37,710
.لست سيئًا

628
00:54:45,090 --> 00:54:47,600
.الحرارة والرطوبة عالية الليلة

629
00:54:47,600 --> 00:54:50,480
.نعم، ربما علينا الاستحمام لاحقًا

630
00:55:07,990 --> 00:55:08,580
...يا لعين

631
00:55:10,870 --> 00:55:11,250
ماذا؟

632
00:55:19,460 --> 00:55:21,210
.إنهم يُريدون رأسي فقط

633
00:55:21,210 --> 00:55:23,470
.يجب أن تبتعد من هنا

634
00:55:23,840 --> 00:55:25,760
.فأنا لا أجيد سوى الهرب

635
00:55:25,760 --> 00:55:26,800
!إلى اللقاء

636
00:55:27,510 --> 00:55:27,970
!انتظر

637
00:55:27,970 --> 00:55:29,260
!لا تدعوه يهرب! لاحقوه

638
00:55:32,640 --> 00:55:33,850
!تبًا

639
00:55:34,520 --> 00:55:37,730
!سنصفّي الحساباتنا في وقت آخر

640
00:56:02,840 --> 00:56:04,300
.أنا جائع

641
00:56:04,300 --> 00:56:05,680
.لنذهب إلى المطعم

642
00:56:05,680 --> 00:56:07,510
وما هو المطعم؟

643
00:56:07,510 --> 00:56:08,760
.مكانٌ لتناول الطعام

644
00:56:08,760 --> 00:56:11,180
رائع! من أين تعلمت هذه الكلمة؟

645
00:56:11,180 --> 00:56:15,440
ابن عمه يدرس في مدرسة
.فوكوزاوا يوكيتشي-سينسي للغة الإنجليزية في ميتا

646
00:56:15,440 --> 00:56:16,940
حقًا؟

647
00:56:37,500 --> 00:56:40,750
!انظرا إليه، يأكل الأرز مع الساكي

648
00:56:40,750 --> 00:56:42,460
!لا يبدو متحضرًا

649
00:56:42,460 --> 00:56:43,880
!أراهن أنه قروي من الأرياف

650
00:56:49,800 --> 00:56:52,220
سأطلب الأودون. وماذا عنك؟

651
00:56:52,220 --> 00:56:54,310
