1
00:00:14,040 --> 00:00:17,490
هناك الكثير من النّاس

2
00:01:51,050 --> 00:01:54,670
رحلة لثلاثة أشخاص معكِ
ومع صديقتكِ يا مُعلّمة؟

3
00:01:54,670 --> 00:01:55,900
!أجل

4
00:01:55,900 --> 00:01:58,300
لكن من فضلكِ لا تناديني بذلك

5
00:01:58,300 --> 00:02:00,370
لستُ مُعلّمة صدّقيني

6
00:02:00,370 --> 00:02:02,130
!لا، أنتِ مُعلّمة يا مُعلّمة

7
00:02:02,500 --> 00:02:05,110
حسناً، من هي صديقتكِ يا فويو-ني؟

8
00:02:05,500 --> 00:02:09,850
إنّها رسّامة مانغا لديها سلسلة
،في مجلّة مختلفة عن مجلّتي

9
00:02:09,850 --> 00:02:11,980
وتبحث عن بعض المُساعدة

10
00:02:11,980 --> 00:02:13,940
ارتأيتُ أنّه سيكون من الجيّد لكما
أن تتعرّفا على بعضكما الآخر

11
00:02:13,940 --> 00:02:16,080
في رحلة قبل العمل المُحتمل معاً

12
00:02:16,400 --> 00:02:20,220
تبحثين عن أعمال جانبيّة
غير أعمالي، صحيح؟

13
00:02:20,220 --> 00:02:22,940
!يبدو أنّه الوقت المناسب للتجمُّع

14
00:02:22,940 --> 00:02:24,760
ا-التجمُّع؟

15
00:02:28,740 --> 00:02:32,380
لذا... هكذا انتهى الحال بنا

16
00:02:33,540 --> 00:02:36,940
يبدو المكان أكثر ازدحاماً الآن
بعد أن تعمّقنا أكثر

17
00:02:38,950 --> 00:02:42,500
لم أتمكّن من التكلّم معها حول الشّينكانسين
في الطّريق إلى هنا إطلاقاً

18
00:02:42,500 --> 00:02:45,470
...رسّامة مانغا وصديقة المُعلّمة

19
00:02:46,520 --> 00:02:47,540
جميل

20
00:02:48,200 --> 00:02:50,340
تينكابوشي ريري-سان

21
00:02:50,690 --> 00:02:56,190
على ذكر الأمر، خيارات استطلاع الرّأي
لهذه الرّحلة كانت باقتراحها هي

22
00:02:56,790 --> 00:02:59,680
...أتساءل ما الّذي جعلها تختار هذه الخيارات الأربعة

23
00:03:02,320 --> 00:03:03,630
حسناً

24
00:03:03,990 --> 00:03:05,880
المعذرة يا تينكوباشي-سان

25
00:03:06,540 --> 00:03:08,420
...بخصوص استطلاع الرّأي

26
00:03:08,420 --> 00:03:11,660
!تشي-تشان، ريري-تشان! انتظرا

27
00:03:14,190 --> 00:03:16,010
لحقتُ بكما أخيراً

28
00:03:16,370 --> 00:03:20,450
كوجيا فويوني-سينسي، أنتِ واهنة حقّاً

29
00:03:20,450 --> 00:03:23,900
لا تقلقي يا تينكوباشي ريري-سينسي

30
00:03:23,900 --> 00:03:27,870
،عندما يخترعون مصل الإنسان الخارق
سأصبح مفتولة العضلات

31
00:03:27,870 --> 00:03:30,020
فويو-ني مفتولة العضلات؟

32
00:03:30,020 --> 00:03:31,970
وسوزوغاموري-سان

33
00:03:32,530 --> 00:03:36,490
،بما أنّ لفظ "تينكابوشي" صعباً
"فيمكنك مُناداتي "ريري

34
00:03:37,780 --> 00:03:38,930
حسناً

35
00:03:39,230 --> 00:03:41,450
"ناديها "ريري-تشان

36
00:03:41,450 --> 00:03:42,670
يبدو ظريفاً، أليس كذلك؟

37
00:03:42,670 --> 00:03:44,340
أجل، أجل. لنذهب يا فويوني

38
00:03:44,340 --> 00:03:46,900
!انتظريني

39
00:03:47,530 --> 00:03:51,120
...تُحيط بها هالة من النّضج
هذا رائع بصراحة

40
00:03:51,500 --> 00:03:53,290
من الصّعب المشي هكذا

41
00:03:51,910 --> 00:03:55,830
...لكن أشعر وكأنّني رأيتُها من قبل

42
00:03:53,290 --> 00:03:55,840
ماذا؟ أنا متأكّدة بأنّ هذا يروقك

43
00:03:56,190 --> 00:03:59,290
لم أتمكّن من السّؤال عن استطلاع الرّأي

44
00:04:02,300 --> 00:04:06,220
أتعتقدان حقّاً أنّه يوجد 1000 توري
هنا في سينبون توري؟

45
00:04:06,690 --> 00:04:11,490
في الواقع، سينبون توري هو القسم
الّذي عبرناه قبل قليل

46
00:04:11,490 --> 00:04:15,310
هناك حوالي 10،000 منه بالمُجمل
في فوشيمي إيناري

47
00:04:15,650 --> 00:04:19,680
نحن على وشك عبور الرّقم 2750

48
00:04:19,680 --> 00:04:21,950
ماذا؟! مُعلّمة، كنتِ تحصين طوال هذا الوقت؟

49
00:04:21,950 --> 00:04:24,040
لا تُصدّقيها

50
00:04:27,710 --> 00:04:29,990
أشعر وكأنّ الهواء قد تغيّر

51
00:04:37,840 --> 00:04:40,380
،في مكان أعمق داخل فوشيمي إيناري-تايشا

52
00:04:40,380 --> 00:04:42,950
هناك حوالي 10،000 مزار صغير
،"يُدعى "أوتسوكا

53
00:04:42,950 --> 00:04:45,150
تمّ تقديمها بواسطة العابدين

54
00:04:45,150 --> 00:04:47,410
تُعرَف هذه المُمارسة بعبادة أوتسوكا

55
00:04:47,980 --> 00:04:52,280
قيل بأنّ إهداء بوّابات توري لهذه الأوتسوكا
بدأ أثناء فترة إيدو

56
00:04:53,460 --> 00:04:55,850
هذا مُخيف قليلاً بصراحة

57
00:04:55,850 --> 00:04:59,720
مكان تسرح فيه مشاعر النّاس؟

58
00:05:01,200 --> 00:05:03,490
...أشعر بالإلهام

59
00:05:04,010 --> 00:05:09,020
إنّ اسم "توري" مُستمدّ من امتصاص
قصص "ستوري" النّاس

60
00:05:09,020 --> 00:05:10,500
هذا غير صحيح

61
00:05:10,500 --> 00:05:13,200
...عندما تجتمع كلّ تلك القصص

62
00:05:16,700 --> 00:05:19,790
!شيء من هذا القبيل؟ أجل
!يمكنني العمل على ذلك

63
00:05:20,710 --> 00:05:23,470
...خيال المُعلّمة الجامح

64
00:05:23,470 --> 00:05:26,710
هكذا نشأت سلسلة المانغا خاصّتها

65
00:05:27,010 --> 00:05:28,440
يجب أن أتعلّم منها

66
00:05:28,440 --> 00:05:30,670
أليس هذا غير قابل للتّصديق؟

67
00:05:30,670 --> 00:05:32,930
هذا ما يجعلها مُمتعة

68
00:05:34,400 --> 00:05:36,320
...سيستغرق ذلك 40 دقيقة

69
00:05:36,320 --> 00:05:38,090
ما رأيكما؟

70
00:05:39,760 --> 00:05:40,660
!هيّا بنا

71
00:05:40,660 --> 00:05:42,020
!انتظر، كُفّ عن الجري

72
00:05:43,590 --> 00:05:44,680
هيّا بنا

73
00:06:19,910 --> 00:06:24,140
مشينا كثيراً صعوداً ونزولاً

74
00:06:24,140 --> 00:06:26,960
أجل، كان مشواراً طويلاً حقّاً

75
00:06:29,280 --> 00:06:31,030
حجر أوموكارو؟

76
00:06:34,290 --> 00:06:36,450
!"فإنّ أُمنيتك ستتحقّق غالباً

77
00:06:36,450 --> 00:06:37,710
جرّبي ذلك

78
00:06:44,310 --> 00:06:47,810
آمل أن أتمكّن من أن أصبح
رسّامة مانغا مُتكاملة

79
00:06:49,160 --> 00:06:49,920
!ها أنا ذي

80
00:06:52,880 --> 00:06:56,050
إنّه ثقيل... أم أنّه خفيف؟

81
00:06:56,050 --> 00:06:57,120
لستُ مُتأكّدة

82
00:06:57,120 --> 00:06:58,960
!إنّه خفيف

83
00:06:59,300 --> 00:07:00,830
ماذا تمنّيتِ؟

84
00:07:00,830 --> 00:07:05,210
حاليّاً... بأن أسلّم عملي قبل الموعد
النّهائيّ المُحدّد

85
00:07:05,210 --> 00:07:06,620
!أُمنيتك هي الخفيفة

86
00:07:14,950 --> 00:07:16,860
!يبدو لذيذاً

87
00:07:17,200 --> 00:07:19,290
هل نذهب ونأكل بعض الحلويّات؟

88
00:07:21,680 --> 00:07:23,930
...عند بلوغ درجة مُعيّنة من التّعب

89
00:07:29,200 --> 00:07:30,510
يصبح مذاقه مُذهلاً

90
00:07:31,950 --> 00:07:33,350
ما هذا؟

91
00:07:33,350 --> 00:07:37,620
ريري-تشان! كان من المُفترض أن
!نحتفي نحن الثّلاثة معاً

92
00:07:37,620 --> 00:07:40,920
بئساً، آسفة. فعلتُ ذلك بحكم
العادة بعد مُغادرة المزار

93
00:07:40,920 --> 00:07:43,300
لحظة، ماذا تشربين؟

94
00:07:44,120 --> 00:07:46,920
مومونوشيزوكو" من ماتسوموتو شوزو بالطّبع"

95
00:07:46,920 --> 00:07:49,620
تتصرّفين وكأنّنا على دراية بذلك

96
00:07:49,620 --> 00:07:51,580
...بعينين حازمتين كهاتين

97
00:07:51,580 --> 00:07:53,790
!لكن لحظة... ساكي؟

98
00:07:53,790 --> 00:07:55,750
له مذاق مُنعش

99
00:07:55,750 --> 00:07:57,070
هذا ساكي كيوتو المحلّي

100
00:07:57,550 --> 00:08:01,280
،هذه المنطقة من كيوتو، حيّ فوشيمي
هي بلدة مصانع السّاكي

101
00:08:01,590 --> 00:08:03,560
!ماتسوموتو شوزو من ذاك الاتّجاه

102
00:08:03,560 --> 00:08:07,160
!وغيكّيكان من هناك، وفوجيوكا شوزو أيضاً

103
00:08:04,620 --> 00:08:07,160
...لحظة، المعذرة

104
00:08:14,330 --> 00:08:17,680
!ما يجعل هذه رحلة ساكي للفتيات

105
00:08:17,680 --> 00:08:18,550
هذا صحيح

106
00:08:18,550 --> 00:08:20,880
لنجرِ مُحادثة صادقة ومفتوحة، اتّفقنا؟

107
00:08:20,880 --> 00:08:22,140
...المعذرة

108
00:08:23,640 --> 00:08:25,080
...في الواقع

109
00:08:25,560 --> 00:08:29,160
،يا إلهي! ظننتُكِ قد بلغتِ الـ 20

110
00:08:29,160 --> 00:08:32,910
بما أنّه كان عيد ميلادكِ مؤخّراً
...وصرتِ في السّنة الثّانية في الكلّية

111
00:08:33,150 --> 00:08:37,280
وُلِدتُ في أوائل العام، لذا
بلغتُ 19 في مارس

112
00:08:38,120 --> 00:08:42,970
!آ-آسفة يا تشي-تشان! أخطأتُ تماماً

113
00:08:42,970 --> 00:08:44,950
لا تقلقي بشأن ذلك

114
00:08:44,950 --> 00:08:47,250
كيوتو مُمتعة حتّى إذا كنتُ لا أستطيع الشّرب

115
00:08:48,430 --> 00:08:50,160
أنا آسفة جدّاً

116
00:08:54,440 --> 00:08:58,640
أسرعي وأصبحي مثلنا أيّتها الآنسة الصّغيرة

117
00:08:58,640 --> 00:09:01,930
،تتصرّفين بصورة رائعة جدّاً
لكنّنا نحكي عن الشّرب هنا، حسناً؟

118
00:09:02,910 --> 00:09:05,230
جميل. ما المدرسة الإعداديّة
الّتي التحقتِ بها؟

119
00:09:05,230 --> 00:09:06,720
التحقتُ بالمدرسة الإعداديّة العاشرة

120
00:09:06,720 --> 00:09:08,660
...انطباعي عنها ينهار

121
00:09:08,660 --> 00:09:11,650
!حسناً، لنزُر المكان التّالي

122
00:09:12,200 --> 00:09:15,140
لا أريد أن أصبح بالغة كهذه

123
00:09:15,140 --> 00:09:18,520
ولن أتورّط—لحظة

124
00:09:18,940 --> 00:09:21,370
...يبدو هذا مألوفاً

125
00:09:24,020 --> 00:09:27,930
بالمُناسبة! أنتِ من كان يشرب
!بمفرده في الفندق في آيزو

126
00:09:27,930 --> 00:09:28,710
ماذا؟

127
00:09:32,050 --> 00:09:36,900
لذا أجل، ذكرتُ رحلتك المُوجَّهة بواسطة
،استطلاع الرّأي لريري-تشان وقلتُ

128
00:09:36,900 --> 00:09:39,250
"!انظري! إنّها تقوم بعمل طريف"

129
00:09:39,250 --> 00:09:40,350
...ثمّ

130
00:09:40,710 --> 00:09:44,350
آيزو، صحيح؟ أنا واثقة بأنّ لديهم
ساكي يابانيّ لذيذ

131
00:09:44,670 --> 00:09:48,720
،توجّهتْ إلى هناك بعد ذلك مُباشرة
لذا افتقدتُما لبعضكما الآخر

132
00:09:48,720 --> 00:09:50,340
إذاً هذا ما حدث

133
00:09:50,910 --> 00:09:52,490
جميعها لذيذة

134
00:09:53,280 --> 00:09:55,830
أتساءل ما هي "ياما-أوني توفو" هذه

135
00:09:55,830 --> 00:09:57,400
لنُجرّبها

136
00:09:58,030 --> 00:10:00,570
إنّها توفو منقوعة بالميسو

137
00:10:01,130 --> 00:10:03,240
لديها ملمس مُماثل لأوني

138
00:10:03,620 --> 00:10:06,860
أجل، لديها ذلك القوام الشّبيه بالأوني فعلاً

139
00:10:06,860 --> 00:10:09,090
النّكهة هي... ميسو؟

140
00:10:09,090 --> 00:10:11,030
إنّها تتناسب مع السّاكي

141
00:10:11,030 --> 00:10:13,080
كنتِ قريبة جدّاً مع اللّقاء بها. مع الأسف

142
00:10:13,510 --> 00:10:23,090
كنتُ قد تخيّلتُ بأنّكما صديقتان حميمتان
بعد اللّقاء ببعضكما في تلك الرّحلة

143
00:10:21,280 --> 00:10:23,100
!مستحيل

144
00:10:25,310 --> 00:10:27,340
!يا لها من قصّة شبيهة بالمانغا

145
00:10:27,340 --> 00:10:28,970
هذا سخيف

146
00:10:28,970 --> 00:10:32,830
...ثمّ ينتهي المطاف بنا في علاقة مُثلّب حُبّ

147
00:10:32,830 --> 00:10:34,680
!ارتأيتُ أنّني أستطيع جعلها قصّة من فصل واحد

148
00:10:34,680 --> 00:10:37,940
!تؤطِّر كلّ شيء ضمن إطار المانغا
!هذه هي المُعلّمة

149
00:10:59,910 --> 00:11:02,320
تأخّر الوقت

150
00:11:02,320 --> 00:11:05,020
ينبغي أن نبحث عن مكان نُقيم فيه قريباً

151
00:11:08,030 --> 00:11:10,930
لنختر مكاناً يحتوي على نبع
!ساخن يفيض بالسّاكي

152
00:11:10,930 --> 00:11:14,440
كيف لكِ أن تقولي ذلك وكأنّها فكرة لامعة؟

153
00:11:14,900 --> 00:11:19,450
مثل هذه الأماكن لا تتواجد إلّا
في القصص الشّعبيّة اليابانيّة

154
00:11:24,270 --> 00:11:27,030
!يا إلهي، يتدفّق السّاكي من فنائنا الخلفيّ

155
00:11:27,630 --> 00:11:30,090
تماماً هكذا

156
00:11:30,800 --> 00:11:32,460
...إنّها تشرب من جديد

157
00:11:33,220 --> 00:11:37,630
في الواقع يا تشي-تشان، حجزتُ
مكاناً لنا بالفعل

158
00:11:37,630 --> 00:11:39,250
حقّاً؟

159
00:11:39,530 --> 00:11:44,020
كيوتو منطقة شهيرة، ولم أُرِد أن نتشرّد

160
00:11:44,020 --> 00:11:46,150
أجل، معكِ حقّ

161
00:11:46,450 --> 00:11:48,830
،قد تفتقر لروح الارتجاليّة المعتادة

162
00:11:48,830 --> 00:11:51,820
لكنّها ملائمة لرحلة بالغين. قد يكون هذا لطيفاً

163
00:11:51,820 --> 00:11:57,230
وثمّة مكان أريد زيارته غداً، لذا
حجزتُ نُزُلاً قريباً منه

164
00:11:57,230 --> 00:12:00,920
لكنّه يبعد حوالي ساعتين عن محطّة كيوتو

165
00:12:00,920 --> 00:12:03,120
!إنّها ليست ارتجاليّة، لكنّها بالتّأكيد مليئة بالطّموح

166
00:12:04,800 --> 00:12:08,060
من فضلكِ لا تقولي لي أنّه في طوكيو

167
00:12:08,060 --> 00:12:09,780
بالطّبع لا

168
00:12:10,050 --> 00:12:11,500
...بالنّسبة لي

169
00:12:14,080 --> 00:12:16,180
!أحبّ الشّرب في القطار أيضاً

170
00:12:16,180 --> 00:12:18,200
المعذرة، لم نسألكِ عن ذلك

171
00:12:18,200 --> 00:12:19,810
منعتُ نفسي في الطّريق إلى هنا

172
00:12:19,810 --> 00:12:21,730
!أنا مسرورة لأجلكِ

173
00:12:26,420 --> 00:12:29,980
أوّلاً، استقللنَ القطار السّريع
المحدود كينوساكي

174
00:12:32,680 --> 00:12:34,470
،ثمّ في محطة فوكوتشياما

175
00:12:34,470 --> 00:12:38,340
انتقلنَ عبر خطّ تانغو نو أومي التّابع
لسكّة كيوتو تانغو الحديديّة

176
00:12:55,170 --> 00:12:56,950
وصلنَ إلى ميازو

177
00:13:03,270 --> 00:13:04,590
هكذا إذاً

178
00:13:13,950 --> 00:13:16,440
ريري-سان، هيّا بنا

179
00:13:16,440 --> 00:13:19,460
وجود تمثال تانوكي يعني أنّه
!إيزاكايا حقيقيّ

180
00:13:21,870 --> 00:13:23,580
أعتقد بأنّه هنا

181
00:13:26,950 --> 00:13:28,290
!وصلنا

182
00:13:28,710 --> 00:13:32,680
هنا سوف نُقيم اللّيلة

183
00:13:34,210 --> 00:13:35,810
!يبدو جميلاً

184
00:13:35,810 --> 00:13:38,160
إنّه يعطي انطباعاً بتلك الرّحلات فعلاً، صحيح؟

185
00:13:38,160 --> 00:13:40,750
!كان يستحقّ قضاء رحلة من ساعتين

186
00:13:40,750 --> 00:13:43,160
يمكنني الشّعور بساكي لذيذ ينتظرني

187
00:13:43,160 --> 00:13:46,770
الشّرب هو كلّ ما تفكّرين فيه، صحيح؟

188
00:13:48,640 --> 00:13:52,900
لكن مكاناً كهذا باهظ غالباً، أليس كذلك؟

189
00:13:52,900 --> 00:13:56,080
،حسناً، لهذا بادرتُ وحجزتُ هذه المرّة

190
00:13:56,080 --> 00:13:58,860
لذا اعتمدا على أختكما الكبرى فحسب

191
00:14:00,070 --> 00:14:01,490
شكراً لكِ يا أختي

192
00:14:01,490 --> 00:14:03,770
لم أكن أتكلّم معك يا ريري-تشان

193
00:14:05,180 --> 00:14:08,790
مرحباً. كنّا ننتظركن

194
00:14:09,470 --> 00:14:11,270
شكراً جزيلاً لكِ

195
00:14:11,270 --> 00:14:13,700
العشاء جاهز للجميع

196
00:14:15,880 --> 00:14:18,660
البناء جميل جدّاً

197
00:14:18,660 --> 00:14:20,670
شكراً جزيلاً لكِ

198
00:14:20,670 --> 00:14:24,960
تمّ ترميمه وتجديده مراراً منذ فترة ميجي

199
00:14:24,960 --> 00:14:26,880
!إنّه حافل بالتّاريخ! مُبهر

200
00:14:27,330 --> 00:14:29,190
هذه هي غرفتكن

201
00:14:29,800 --> 00:14:32,680
يا لها من عرفة جميلة بطراز يابانيّ

202
00:14:32,680 --> 00:14:37,450
يوجد حوض في الغرفة، لكن لدينا
حمّام نبع ساخن أيضاً

203
00:14:37,450 --> 00:14:38,770
استمتعنَ بإقامتكن رجاء

204
00:14:38,770 --> 00:14:40,350
شكراً جزيلاً لكِ

205
00:14:42,620 --> 00:14:44,370
!مساحة كبيرة هنا أيضاً

206
00:14:44,370 --> 00:14:46,700
!بالفعل. أحبّ هذه المساحة

207
00:14:46,970 --> 00:14:50,830
ألا يُشعرك الجلوس في هذه المساحة في نُزُل
تبدين وكأنّك كاتبة مشهورة؟

208
00:14:50,830 --> 00:14:51,910
تماماً

209
00:14:52,280 --> 00:14:55,670
ينابيع ساخنة... مع ساكي ساخن؟

210
00:14:56,240 --> 00:14:58,380
هذا خطير، لذا لا

211
00:15:19,890 --> 00:15:22,470
إنّها درجة الحرارة الملائمة

212
00:15:24,000 --> 00:15:27,670
لا ساخنة جدّاً ولا فاترة... إنّها مثاليّة

213
00:15:30,910 --> 00:15:33,440
فويو-ني؟! هل تذوبين؟

214
00:15:34,440 --> 00:15:35,450
حسناً

215
00:15:35,750 --> 00:15:36,920
...بعد غمر نفسي بالمياه

216
00:15:36,920 --> 00:15:38,210
حان وقت الشّرب

217
00:15:38,210 --> 00:15:39,620
!مرّة أُخرى؟

218
00:15:39,620 --> 00:15:41,720
!انتظري... ريري-سان

219
00:15:41,720 --> 00:15:43,550
!فويو-ني؟

220
00:15:43,550 --> 00:15:45,370
!بئساً

221
00:15:54,710 --> 00:15:56,230
هل طلع الصّباح؟

222
00:16:09,280 --> 00:16:10,610
كاتبة مشهورة؟

223
00:16:12,570 --> 00:16:13,610
صباح الخير

224
00:16:14,390 --> 00:16:16,170
ماذا تفعلين؟

225
00:16:16,170 --> 00:16:20,530
أُدوّن الأفكار فحسب بينما أنا صاحية

226
00:16:22,640 --> 00:16:24,170
رسومها ظريفة

227
00:16:25,120 --> 00:16:28,580
عندما تخطر فكرة على ذهن
فويوني فإنّها لا تنساها

228
00:16:28,870 --> 00:16:33,290
لكنّني أفعل هذا لأنّه يبدو وكأنّه من الهدر
تفويت أي معلومة ولو كانت بسيطة

229
00:16:34,890 --> 00:16:38,840
لا بُدّ أنّ هذا الشّكل من الجهود هو ما يجعل
سلسلة المانغا خاصّتها تنجح

230
00:16:39,840 --> 00:16:42,430
...عـ-على أيّ حال

231
00:16:42,430 --> 00:16:44,370
إنّه مكان جميل حقّاً، أليس كذلك؟

232
00:16:45,320 --> 00:16:48,550
آمل أن أجلس هنا وجهاً لوجه مع شابّ
...نبيل يوماً ما

233
00:16:49,720 --> 00:16:50,830
أمزح فحسب

234
00:16:51,790 --> 00:16:54,990
أنتِ عاطفيّة للغاية، أليس كذلك؟
لم أتوقّع ذلك

235
00:16:55,670 --> 00:16:59,030
هذا طبيعيّ. فأنا رسّامة مانغا شوجو

236
00:17:00,360 --> 00:17:01,400
ريري-سان؟

237
00:17:02,620 --> 00:17:06,960
...في الرّحلات، قرّرتُ ألّا أرحم

238
00:17:07,680 --> 00:17:09,030
كبدي...

239
00:17:10,680 --> 00:17:12,300
لم أفتحها بعد

240
00:17:13,120 --> 00:17:16,050
كيف لكِ أن تقولي هذا الكلام بثقة كهذه؟

241
00:17:16,050 --> 00:17:18,350
أنتِ بارعة في الردّ يا تشيكا-تشان

242
00:17:18,350 --> 00:17:20,830
ماذا؟ أنتِ من قال ذلك أوّلاً

243
00:17:52,570 --> 00:17:56,710
!الإطلالة واسعة جدّاً... وضخمة

244
00:17:56,710 --> 00:17:59,100
أين ذهبت مفرداتكِ يا تشي-تشان؟

245
00:18:00,800 --> 00:18:02,790
هذا جميل

246
00:18:03,250 --> 00:18:05,050
ماذا تفعلين يا ريري-سان؟

247
00:18:05,340 --> 00:18:08,450
إنّ السّاكي أشهى حتّى عندما
تذوب فيه إطلالة جميلة

248
00:18:08,450 --> 00:18:09,390
ألا تعلمين؟

249
00:18:09,390 --> 00:18:10,900
!بالطّبع لا

250
00:18:10,900 --> 00:18:13,300
بجدّية، هذا كلّ ما تُفكّر فيه

251
00:18:13,770 --> 00:18:17,370
...هذه الإطلالة تؤثّر بي

252
00:18:26,010 --> 00:18:28,350
!قد يكون هذا جيّداً. حسناً

253
00:18:28,350 --> 00:18:30,110
!جاء الإلهام للمُعلّمة

254
00:18:30,110 --> 00:18:32,100
لكن هذا لا يُحقّق أي نتيجة تُذكَر

255
00:18:33,390 --> 00:18:35,930
أنتِ تُبعثرين شعركِ من جديد

256
00:18:37,140 --> 00:18:38,130
انظرا إلى هذه

257
00:18:38,130 --> 00:18:41,070
"تُدعى "منصّة ماتانوزوكي

258
00:18:41,070 --> 00:18:42,830
!تُستخدَم للنّظر إلى سيقان النّاس؟

259
00:18:42,830 --> 00:18:44,590
تُستخدَم للنّظر إلى الإطلالة
من خلال السّاقين

260
00:18:50,880 --> 00:18:53,850
أشعر بالدّماء يتدفّق إلى رأسي

261
00:18:55,270 --> 00:18:57,530
،يبدو أنّه عندما يتدفّق الدّم إلى رأسك

262
00:18:57,530 --> 00:19:01,640
فإنّك تشعرين بدُوار ممّا يُضفي غموضاً
أكبر إلى إطلالة أمانوهاشيداتي

263
00:19:02,190 --> 00:19:04,090
!من الخطير فعل ذلك أثناء الثّمالة

264
00:19:13,890 --> 00:19:14,710
انتهيت

265
00:19:19,130 --> 00:19:20,580
!حسناً

266
00:19:22,780 --> 00:19:24,070
!مرحى

267
00:19:24,610 --> 00:19:25,690
!هيّا

268
00:19:32,220 --> 00:19:36,060
!والآن لنمشِ حول أمانوهاشيداتي

269
00:19:36,060 --> 00:19:37,180
!أجل

270
00:19:38,930 --> 00:19:40,440
هناك عجوز مُتخلّفة بيننا

271
00:20:14,260 --> 00:20:15,560
ما هذا؟

272
00:20:16,200 --> 00:20:21,090
في الواقع، انتقمَ سيّافٌ أسطوريّ يُدعى إيوامي
،جوتارو-سان لأبيه هنا

273
00:20:21,090 --> 00:20:24,830
وقضى أيضاً على الكوماينو الخاصّين بالمزار
وذلك بتقطيع كاحلهم

274
00:20:24,830 --> 00:20:27,650
لأنّهم كانوا يُسبّبون فوضى في اللّيل

275
00:20:27,650 --> 00:20:29,950
ماذا؟ هذا رائع جدّاً

276
00:20:30,340 --> 00:20:32,210
يمكنني أن أحوّله إلى مانغا

277
00:20:32,210 --> 00:20:35,330
لا بُدّ أنّه يوجد ساكي يابانيّ سُمّي باسمه

278
00:20:50,060 --> 00:20:53,270
!على ضفّة البحر" كم هذا ظريف"

279
00:20:54,820 --> 00:20:57,090
مزار موتويسي كونو

280
00:20:57,090 --> 00:21:00,770
منذ زمن ما قبل التّاريخ، كان تويوكي
أوكامي يُقدَّس هنا

281
00:21:00,770 --> 00:21:05,200
وقيل بأنّ أماتيراسو أوميكامي
كان يُعبَد هنا سابقاً كذلك

282
00:21:05,940 --> 00:21:09,440
اليوم، كلا الإلَهين قد أُعيدا إلى
،مزار إيسي العظيم في مي

283
00:21:09,440 --> 00:21:13,360
،"لهذا يُعرَف هذا المكان بـ"موتو-إيسي
إيسي السّابق

284
00:21:13,360 --> 00:21:17,580
يا له من مزار جميل. يبدو وكأنّني وصلتُ
إلى المكان الّذي أردتُ إيجاده

285
00:21:17,580 --> 00:21:19,140
بالفعل

286
00:21:19,140 --> 00:21:20,650
!أنتما

287
00:21:20,650 --> 00:21:22,430
!انظرا إلى أرجل الكوماينو

288
00:21:23,570 --> 00:21:25,680
قدماه الأماميّتان مُقطَّعتان

289
00:21:30,680 --> 00:21:33,060
!هزمتُ الهيهي في أوساكا أيضاً

290
00:21:33,420 --> 00:21:37,410
!إيوامي جوتارو-سان رهيب حقّاً

291
00:21:39,860 --> 00:21:42,610
حسناً، هل نذهب ونُقدّم عزاءنا؟

292
00:21:42,610 --> 00:21:43,350
أجل

293
00:21:44,040 --> 00:21:46,420
!مهلاً، انتظراني

294
00:22:06,960 --> 00:22:07,910
لقد جاءت

295
00:22:09,730 --> 00:22:11,730
قادمة

296
00:22:16,260 --> 00:22:18,340
صباح الخير يا ريري-سان

297
00:22:18,720 --> 00:22:21,350
صباح الخير. شكراً على الخروج

298
00:22:21,350 --> 00:22:23,080
شكراً على استضافتي

299
00:22:23,490 --> 00:22:25,200
!أنتِ ترتدين نظّارة

300
00:22:25,200 --> 00:22:27,290
أرتدي نظّارة في المنزل