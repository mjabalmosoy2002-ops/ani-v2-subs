1
00:01:46,540 --> 00:01:47,960
...إيباتا تويا-كُن

2
00:01:48,500 --> 00:01:50,460
،بما أنّك أفضل طالب في قسم الطّبّ

3
00:01:50,460 --> 00:01:54,670
أريد منك أن تقدّم خطاب التّهنئة في حفل
.تسليم الشّهادات للسّنة القادمة

4
00:01:54,670 --> 00:01:55,970
هلاّ قبلت ذلك؟

5
00:01:56,510 --> 00:01:58,180
.يشرّفني هذا

6
00:01:58,180 --> 00:01:59,720
.يسعدني قبول الطّلب

7
00:02:05,390 --> 00:02:07,600
!هيّا، تحدّثي إليه

8
00:02:07,600 --> 00:02:09,400
!لقد غادر

9
00:02:09,400 --> 00:02:12,310
!انظرن، إنّه تويا

10
00:02:12,310 --> 00:02:14,610
!إنّه رائع للغاية

11
00:02:28,750 --> 00:02:30,420
!عبقريّ كعادتك يا تويا-كن

12
00:02:30,670 --> 00:02:34,170
.بفضلك، سنتمكّن من تحقيق ربح هذا الشّهر

13
00:02:34,170 --> 00:02:35,590
!يسعدني سماع ذلك

14
00:02:37,460 --> 00:02:41,640
لذا عن طريق تسليط الضّوء
،على الكتب الّتي انتهى نشرها

15
00:02:41,640 --> 00:02:44,680
زاد ذلك من الطّلب عليها، حتّى المنتجات المخصّصة؟

16
00:02:47,640 --> 00:02:49,940
!عبقريّ كعادتك يا تويا-كُن

17
00:02:50,270 --> 00:02:53,400
لم أتوقّع أنّ نظام عضويات قد يؤدّي
.لظهور هذا العدد من النّاس

18
00:02:53,650 --> 00:02:58,860
كلاّ أيّها العجوز، هذا ليس نظام عضويات
!وإنّما نظام اشتراك

19
00:02:58,860 --> 00:03:00,780
ماذا؟

20
00:03:00,780 --> 00:03:02,870
.لا داعي للقلق بشأن الفرق بينهما

21
00:03:02,870 --> 00:03:04,160
!سأذهب لألعب لعبة قتال

22
00:03:07,790 --> 00:03:11,210
.أقدّر لك إرسالي إلى أعمال الدّوام الجزئيّ خاصّتي

23
00:03:11,670 --> 00:03:13,170
...لكن

24
00:03:13,170 --> 00:03:15,000
!لا تقلق بشأني

25
00:03:15,000 --> 00:03:18,170
.الحمّام العامّ هو الأفضل بعد ساعات الدّوام

26
00:03:18,800 --> 00:03:22,300
!هذا رائع، يتسنّى لي التّمتّع في حمّام النّساء

27
00:03:27,600 --> 00:03:29,100
!مهلاً

28
00:03:30,180 --> 00:03:32,900
!لا يمكنني تنظيفه إن كنت بداخله

29
00:03:34,860 --> 00:03:36,980
!تفضّل راتب هذا الشّهر

30
00:03:37,270 --> 00:03:39,650
ستذهب لكاغا مجدّدًا؟

31
00:03:39,650 --> 00:03:40,650
.أجل

32
00:03:40,650 --> 00:03:44,700
.أنت طالب. من المهمّ الاستمتاع أيضًا

33
00:03:44,700 --> 00:03:48,790
!عندما تصبح طبيبًا، ستكون مشغولاً طيلة اليوم

34
00:03:49,750 --> 00:03:51,120
.سأحضر لك تذكارًا

35
00:03:51,460 --> 00:03:55,380
في تلك الحالة، سأقبل عرضك وأطلب
."حلوى كاغا المعتادة "كينتسوبا

36
00:03:55,880 --> 00:03:59,000
!سيسعد الجميع في مركز كبار السّنّ بذلك أيضًا

37
00:03:59,000 --> 00:04:00,340
!مفهوم

38
00:04:11,230 --> 00:04:13,390
.تستغرق وقتًا طويلاً للشّفاء

39
00:04:13,640 --> 00:04:17,150
!رائع، هذا وسام شرف حقيقيّ

40
00:04:17,150 --> 00:04:18,400
!هذا مؤلم

41
00:04:18,650 --> 00:04:22,610
لم تكن في حاجة للقتال حتّى تُضرب
بهذا السّوء، صحيح؟

42
00:04:22,610 --> 00:04:26,070
.إن لم تقاتل، فلن تتمكّن من الفوز

43
00:04:26,070 --> 00:04:27,870
أكان ذلك "فوزًا"؟

44
00:04:27,870 --> 00:04:30,330
!لن تعلم حتّى تحاول

45
00:04:31,000 --> 00:04:33,040
!هـ-هل أنت بخير؟

46
00:04:35,920 --> 00:04:37,540
!اضربني على صدري

47
00:04:42,590 --> 00:04:44,170
!أجل، هناك تمامًا

48
00:04:44,680 --> 00:04:48,180
!هذه قضيّة قلب! تقاتل من أجل الفوز، صحيح؟

49
00:04:49,010 --> 00:04:52,430
!ما تعابير الوجه هذه؟
!يجب أن تكون لديك روح مغامرة

50
00:04:53,600 --> 00:04:54,730
!هذا مؤلم

51
00:05:01,440 --> 00:05:03,690
.نحن بداخل سيّارة

52
00:05:03,690 --> 00:05:06,200
لماذا نحن مضطرّان لمواجهة الرّيح؟

53
00:05:06,200 --> 00:05:08,570
.هذا بمثابة تجاهل الأفضليّة الكبرى

54
00:05:08,870 --> 00:05:10,910
.أنت لا تفهم الأمر

55
00:05:10,910 --> 00:05:14,460
أليس من الرّائع أن تترك شعرك يتطاير
بين الرّياح بينما نتسابق؟

56
00:05:14,460 --> 00:05:16,580
.أنت لا تملك أيّ شعر يا ماسانوري

57
00:05:16,580 --> 00:05:19,840
،لا تملك أيّ حسّ بالرّومانسيّة
.يجب أن تكون لديك روح مغامرة

58
00:05:19,840 --> 00:05:22,380
.توقّف عن التّحدّث مثل هذا الشّخص

59
00:05:22,380 --> 00:05:24,800
قول ذلك يعني أنّني فزت، صحيح؟

60
00:05:24,800 --> 00:05:27,340
.بما أنّك لم تفز ضدّ دانجي ولا مرّة

61
00:05:29,510 --> 00:05:31,010
هل أزعجك تهكّمي؟

62
00:05:31,760 --> 00:05:32,850
.ليس تمامًا

63
00:05:32,850 --> 00:05:34,100
.كلاّ، أنت غاضب حقًّا

64
00:05:34,520 --> 00:05:35,680
.لستُ غاضبًا

65
00:05:35,680 --> 00:05:37,770
.لا تدع هذا يؤثّر عليك

66
00:05:37,770 --> 00:05:40,860
.ذلك التّصرّف هو ما سيجعلك تفشل

67
00:05:41,150 --> 00:05:43,320
.لم أفشل

68
00:05:43,320 --> 00:05:45,740
.كانت توقّعاتي ساذجة لا غير

69
00:05:45,740 --> 00:05:46,860
.لن أخسر في المرّة القادمة

70
00:05:47,200 --> 00:05:49,450
كم مرّة شاهدت ذاك النّزال؟

71
00:05:49,950 --> 00:05:52,030
.فلتنظر إليّ على الأقلّ الآن

72
00:05:57,920 --> 00:05:59,380
.أحسنت

73
00:05:59,380 --> 00:06:01,750
ما الّذي تحاول إخباري به؟

74
00:06:03,000 --> 00:06:08,800
أحيانًا، ستشعر أنّ لحظات عاديّة
.كهذه هي أسعد لحظات

75
00:06:10,640 --> 00:06:13,930
ما رأيك في إعلان دانجي عن تقاعده؟

76
00:06:13,930 --> 00:06:16,180
.سيعود عمّا قريب

77
00:06:16,180 --> 00:06:20,400
الفتى الّذي أجبره على التّقاعد، كيف هو؟

78
00:06:20,400 --> 00:06:22,020
.لا يدعو للقلق

79
00:06:22,020 --> 00:06:25,780
.مجرّد فتى مسكين وقع ضحية لنزوات دانجي

80
00:06:25,780 --> 00:06:29,950
أمر مثير أن يقلق طالب طبّ
.في جامعة تيتو بخصوص أمر كهذا

81
00:06:29,950 --> 00:06:31,030
.أجل

82
00:06:31,570 --> 00:06:33,530
.لهذا سأنهي الأمر هذه المرّة

83
00:06:33,950 --> 00:06:36,950
.لا أحب الاستسلام قبل هزيمته

84
00:06:38,080 --> 00:06:39,330
ستعتزل؟

85
00:06:54,390 --> 00:06:57,310
.حان الأوان لأترك الألعاب خلفي

86
00:06:57,310 --> 00:07:01,350
.حياة كلّ شخص لها هيئة خاصّة مقدّر لها اتخّاذها

87
00:07:02,060 --> 00:07:04,610
هيئة مقدّر لها اتّخاذها...؟

88
00:07:04,980 --> 00:07:07,820
وأيّ هيئة هي هذه؟

89
00:07:09,610 --> 00:07:10,490
!آسفة

90
00:07:11,320 --> 00:07:13,740
.هذا لأنّ آلة طبخ الأرزّ معطّلة

91
00:07:14,120 --> 00:07:16,490
اشترِ بعض الخبز من أجل الغد، مفهوم؟

92
00:07:16,830 --> 00:07:18,330
.تحاول

93
00:07:23,790 --> 00:07:25,130
!يا ويحي

94
00:07:28,130 --> 00:07:29,260
!هذا خطير كما تعلم

95
00:07:29,590 --> 00:07:31,260
!آسف بخصوص ذلك

96
00:07:31,510 --> 00:07:33,800
!أنت من فريق دانجي

97
00:07:33,800 --> 00:07:34,640
من؟

98
00:07:34,640 --> 00:07:38,520
الفتاة الظّريفة الّتي كانت تشجّع
دانجي وسط الجمهور؟

99
00:07:39,310 --> 00:07:42,770
كان هنالك فتاتان، أتذكر؟ هذا الفتى
.كان يرتدي ملابس فتيات

100
00:07:44,020 --> 00:07:46,150
...الماكياج مذهل

101
00:07:46,150 --> 00:07:48,070
تتسوّق في مثل هذا الوقت المتأخّر؟

102
00:07:48,070 --> 00:07:49,280
.نعم

103
00:08:00,910 --> 00:08:03,670
تحبّ اللّحم مع بيضة مقليّة؟

104
00:08:03,670 --> 00:08:06,420
.نعم، منذ أن كنت طفلاً

105
00:08:06,420 --> 00:08:07,420
أنت أيضًا يا يو-يو-كن؟

106
00:08:07,670 --> 00:08:08,380
!أجل

107
00:08:08,380 --> 00:08:12,260
تجعله بيضة مقليّة فوقه يبدو خاصًّا، صحيح؟

108
00:08:12,260 --> 00:08:13,720
!أجل، صحيح

109
00:08:13,720 --> 00:08:15,430
!فلنأكل ما دام ساخنًا

110
00:08:15,680 --> 00:08:16,510
!أجل

111
00:08:17,930 --> 00:08:19,310
!لنبدأ الأكل

112
00:08:19,720 --> 00:08:22,730
لماذا يبدوان متزامنين؟

113
00:08:24,730 --> 00:08:26,560
.لهذا السّبب كنت ترتدي ملابس فتيات

114
00:08:26,860 --> 00:08:28,150
.هذا صحيح

115
00:08:28,150 --> 00:08:30,400
.هذه ليست هوايتي أو ما شابه

116
00:08:30,400 --> 00:08:32,490
.يمكنك جعلها كذلك

117
00:08:32,490 --> 00:08:34,860
.لم تبدُ غريبة عليك على الإطلاق

118
00:08:34,860 --> 00:08:38,910
ألم تكن لديك أمور أكثر أهمّيّة لتنتبه لها
في ذلك الوقت يا تويا؟

119
00:08:38,910 --> 00:08:39,830
.اخرس

120
00:08:39,830 --> 00:08:44,120
!لكنّك أذهلتني في تلك المباراة حقًّا

121
00:08:44,120 --> 00:08:45,330
أذهلتك؟

122
00:08:45,670 --> 00:08:46,670
!أجل

123
00:08:46,670 --> 00:08:49,840
الطّريقة الّتي واصلت فيها الهجوم
!مرارًا وتكرارًا كانت مذهلة

124
00:08:50,420 --> 00:08:53,340
أتساءل إن كان ذلك هو الغرض
."من وراء "القتال من أجل الفوز

125
00:08:54,470 --> 00:08:57,340
.كان ذلك أمرًا أخبرني به دانجي-سان اليوم

126
00:08:57,340 --> 00:08:59,100
"تقاتل من أجل الفوز، صحيح؟"

127
00:08:59,810 --> 00:09:02,310
...القتال من أجل الفوز

128
00:09:02,310 --> 00:09:04,640
!لقد خسرت

129
00:09:04,640 --> 00:09:07,150
حسنًا، من التّالي؟

130
00:09:07,150 --> 00:09:08,610
.لم يبقَ أحد

131
00:09:08,610 --> 00:09:11,570
.أجل، أنت قويّ للغاية يا تويا

132
00:09:14,490 --> 00:09:15,780
!عفوًا

133
00:09:16,530 --> 00:09:20,910
،لو كانت لديك هذه المجموعة
كيف ستجعلها أقوى؟

134
00:09:20,910 --> 00:09:22,330
ألا تمانع إن ألقيت نظرة؟

135
00:09:22,330 --> 00:09:23,870
!بالطّبع

136
00:09:23,870 --> 00:09:25,870
لكن ألا يعني هذا أنّك تُري ما بحوزتك لخصمك؟

137
00:09:26,120 --> 00:09:27,580
!كلاّ كلاّ

138
00:09:27,580 --> 00:09:29,960
.يسعدني أن أواجهك يومًا ما

139
00:09:29,960 --> 00:09:31,250
...لكن بمستواي الحاليّ

140
00:09:31,500 --> 00:09:34,260
.هكذا إذًا. دعني ألقي نظرة

141
00:09:35,090 --> 00:09:38,090
.هذا ليس سيّئًا على الإطلاق

142
00:09:38,090 --> 00:09:39,430
.إنّها مجهّزة بطريقة جيّدة

143
00:09:39,430 --> 00:09:40,640
أحقًّا ذلك؟

144
00:09:41,260 --> 00:09:43,850
ألم يعد تشكيلها عن طريق تبديلات؟

145
00:09:43,850 --> 00:09:45,270
!صحيح

146
00:09:45,270 --> 00:09:47,640
.تلقّيت نصائح من دانجي-سان والبقيّة

147
00:09:49,860 --> 00:09:53,650
!إن قمت بدمج هذه مع هذه، فستصبح أقوى بكثير

148
00:09:55,440 --> 00:09:57,780
.ماذا هناك؟ تبدو سعيدًا

149
00:09:57,780 --> 00:10:01,620
تويا-سان، أحببت فانغارد منذ صغرك، صحيح؟

150
00:10:02,450 --> 00:10:06,160
.توقّعت ذلك لسبب ما

151
00:10:06,460 --> 00:10:08,710
.معك حقّ

152
00:10:08,710 --> 00:10:12,500
.أجل، حتّى تويا كان فتى في مرحلة ما

153
00:10:12,500 --> 00:10:16,920
لكن لِمَ أنت مركّز على دانجي-سان يا تويا-سان؟

154
00:10:17,380 --> 00:10:18,880
.دخلت في صلب الموضوع مباشرة

155
00:10:18,880 --> 00:10:21,140
!آسف بخصوص ذلك

156
00:10:21,140 --> 00:10:25,430
،بالرّغم من أنّ دانجي-سان مذهل
...فإنّ قدومك لقرية بعيدة كهذه

157
00:10:27,140 --> 00:10:30,020
.أردت القتال في هذه القرية البعيدة

158
00:10:31,190 --> 00:10:35,230
.بالنّسبة لي، دانجي مميّز نوعًا ما

159
00:10:36,360 --> 00:10:38,280
عشرون فوزًا متتاليًا، هل تذكر؟

160
00:10:38,280 --> 00:10:41,030
.لم يسبق لي الالتقاء بشخص متهوّر مثله من قبل

161
00:10:41,990 --> 00:10:45,870
.لهذا أريد مواجهته والفوز

162
00:10:45,870 --> 00:10:49,500
.سأسافر لأيّ مكان من أجل اختبار لحظة كتلك

163
00:10:51,000 --> 00:10:54,960
...سأواجهه وأفوز ثمّ

164
00:10:54,960 --> 00:10:56,210
ثمّ؟

165
00:11:03,470 --> 00:11:06,220
.أعود إلى الحياة الّتي قدّر لي عيشها

166
00:11:24,740 --> 00:11:25,780
!ابذل ما في وسعك

167
00:11:26,200 --> 00:11:28,790
ماذا؟ ألا يمكنك القتال بجدّيّة
إلاّ إن كنت ترتدي ملابس فتيات؟

168
00:11:29,080 --> 00:11:30,790
!سأبذل ما في وسعي الآن

169
00:11:33,580 --> 00:11:36,840
،بروحه الّتي لا تقهر وطريقته المنعشة في اختيار البطاقات

170
00:11:34,000 --> 00:11:35,290
.اخرس

171
00:11:36,840 --> 00:11:39,460
—يُظهر يو-يو لنا أنّه شابّ جيّـ

172
00:11:39,460 --> 00:11:41,050
!مـ-مهلاً

173
00:11:41,590 --> 00:11:42,800
!إنّه تويا

174
00:11:43,050 --> 00:11:44,680
!أيقوم بتحدِّ آخر؟

175
00:11:44,680 --> 00:11:47,010
لكن ألم يتقاعد دانجي؟

176
00:11:47,010 --> 00:11:48,060
!دانجي

177
00:11:51,560 --> 00:11:54,560
!أنا هنا للوفاء بوعد قتالك

178
00:11:56,980 --> 00:11:59,320
،لا يهمّني أمر علمك أو حقوق حديقة الملاهي

179
00:11:59,780 --> 00:12:02,240
.أريد قتال بطاقات في منتهى الجديّة

180
00:12:02,820 --> 00:12:05,120
.قطع مسافة طويلة من أجل هذا فقط

181
00:12:05,120 --> 00:12:07,950
.عدم مواجهته سيكون ضدّ الأخلاق البشريّة

182
00:12:08,410 --> 00:12:11,330
.اخترتما وقتًا غير مناسب من أجل هذا

183
00:12:11,330 --> 00:12:13,210
.دانجي في حالة سيّئة

184
00:12:14,420 --> 00:12:17,290
...في منطقة كاغا النّائية، كان هنالك رجل

185
00:12:17,290 --> 00:12:20,210
.واصل قبول تحدّيات خصوم أقوياء لحماية علم

186
00:12:21,090 --> 00:12:26,260
