1
00:00:01,060 --> 00:00:05,980
يمكن للموسيقى أن تغير العالم

2
00:01:36,880 --> 00:01:39,940
هل تريدني أن أخبرك بشأن سوبر رير؟

3
00:01:39,940 --> 00:01:41,180
.فهمت

4
00:01:41,180 --> 00:01:45,550
،يمكنني أن أخبرك بالكثير بشأنهما

5
00:01:45,550 --> 00:01:50,520
.لكنّ الكلام الكثير لا يلائم أيّ أحد، لذا سألخّص لك

6
00:01:51,080 --> 00:01:55,630
...كانت الفكرة هي الجمع بين فردين موهوبين بشدّة

7
00:01:55,660 --> 00:01:58,860
."لكنّي كنت أفكر في الواقع، "هذا ليس جيدًا...

8
00:01:59,450 --> 00:02:03,650
.لذا لتلخيص الأمر، أظنّ أنّ تلك كانت إجابتهما

9
00:02:03,650 --> 00:02:05,270
هل أردت أن تعرف أكثر؟

10
00:02:07,660 --> 00:02:13,270
،شينجي كانو-كن ورايج هيدا-كن
.توجها إلى مكتب المدير رجاءً

11
00:02:09,190 --> 00:02:13,270
عقلك

12
00:02:09,850 --> 00:02:13,270
أقرأ

13
00:02:30,560 --> 00:02:35,310
أريد منكما أن تفعلا شيئًا بسوبر
.رير لم يفعل أيّ أحد من قبل

14
00:02:36,010 --> 00:02:38,170
.هذه الملابس على سبيل المثال

15
00:02:44,720 --> 00:02:46,560
...هذا

16
00:02:46,560 --> 00:02:48,820
...أقصد، البطن

17
00:02:49,150 --> 00:02:51,540
.لكنّه مثير للاهتمام بالتأكيد

18
00:02:51,540 --> 00:02:53,460
.يمكنني أن أكشف عن جانب جديد من نفسي

19
00:02:53,460 --> 00:02:54,820
.ولا في أحلامك

20
00:02:55,210 --> 00:02:57,770
هل هو جريء بعض الشيء؟

21
00:02:57,770 --> 00:03:01,920
...لكن إن كنتما لا تقبلان الكشف عن القليل من جسديكما

22
00:03:01,920 --> 00:03:05,010
لمَ شينجي هو الرّقم 01 وأنا 02؟

23
00:03:05,010 --> 00:03:06,960
.رايج دائمًا الأكثر تفوقًا

24
00:03:06,960 --> 00:03:09,710
ماذا؟ أذلك هو الجزء الذي لم يعجبك؟

25
00:03:10,490 --> 00:03:13,730
—حسنًا إذًا. رايج يمكنه أن يكون الرقم 01 وشينجي

26
00:03:13,730 --> 00:03:17,150
.كلّا، سيبدو ذلك غريبًا

27
00:03:17,150 --> 00:03:20,340
،أظنّ أنّه من حيث علامتنا التجارية
.يجب أن أملك الرّقم 01

28
00:03:20,340 --> 00:03:22,770
تريد أن تحتفظ به؟

29
00:03:22,770 --> 00:03:25,020
...ماذا؟ هل أنت غبيّ؟ أنا الرّقم واحد

30
00:03:25,020 --> 00:03:29,020
يا إلهي... هذان الاثنان يعملان معًا؟

31
00:03:29,020 --> 00:03:32,290
.أجل. كانت هذه القواعد فكرتك

32
00:03:32,290 --> 00:03:33,690
كانت بالفعل، أليس كذلك؟

33
00:03:36,040 --> 00:03:38,290
.سمعت أغنية سوبر رير

34
00:03:38,290 --> 00:03:40,860
.أقرأ عقلك"، صحيح؟ إنها جميلة"

35
00:03:41,630 --> 00:03:43,140
.أظن ذلك

36
00:03:43,140 --> 00:03:46,830
هل ستقوم برقص متزامن مع شينجي؟

37
00:03:47,250 --> 00:03:53,270
أجل. ذكر الملتحي شيئًا بشأن ذلك لكن من يهتم؟

38
00:03:53,270 --> 00:03:56,000
.للوقت الرّاهن، علّمني الرّقص يا دايا ولا تعلّمه

39
00:04:02,050 --> 00:04:04,730
"،تصميم رقص هذه الأغنية الجديدة، "أقرأ عقلك

40
00:04:04,730 --> 00:04:07,760
.يتطلّب أن ترقصا بتزامن

41
00:04:07,760 --> 00:04:11,770
.ما يعني أنّني من سأتكفّل بتعليمك أنت ورايج

42
00:04:13,210 --> 00:04:17,930
.لكنّي طلبتُ بالفعل من ليون-كن أن يشاركني

43
00:04:17,930 --> 00:04:20,400
.سيفلح الأمر فقط إن قمتما أنتما الاثنان بذلك سويًّا

44
00:04:20,400 --> 00:04:21,740
.تمامًا

45
00:04:21,740 --> 00:04:23,150
.حسنًا، فلنفعل ذلك

46
00:04:55,250 --> 00:04:56,750
.حسنًا، مرّة أخرى

47
00:05:05,010 --> 00:05:06,070
ما هذا؟

48
00:05:07,020 --> 00:05:09,490
هل يفعلان ذلك عمدًا؟

49
00:05:09,490 --> 00:05:12,330
هل سينجحان في التأهّب لهذا الرّوتين قبل الحفل؟

50
00:05:16,640 --> 00:05:18,440
.مهلًا، لقد فعلا "ذلك" بالتزامن

51
00:05:20,890 --> 00:05:24,780
.شينجي، عليك أن تكون أكثر صراحة وقوّة

52
00:05:24,780 --> 00:05:28,840
.وكأنّك... تظنّ أنّ هذا رقص باليه أو ما شابه

53
00:05:29,850 --> 00:05:33,510
.يمكن لشينجي أن يقوم بالباليه من خلفي إذًا

54
00:05:33,820 --> 00:05:34,520
أليس كذلك؟

55
00:05:34,520 --> 00:05:39,150
رايج-كن، ربّما عليك أن تتعلّم
.الحركات قبل أن تنتقد الآخرين

56
00:05:39,970 --> 00:05:42,400
.سأفعل. بعد أن ترتدي ملابسك الضيّقة

57
00:05:44,120 --> 00:05:45,740
.خذ كلامي على محمل الجد

58
00:05:46,090 --> 00:05:47,990
.أنا جاد بالفعل

59
00:05:47,990 --> 00:05:49,800
أهذا الوقت المناسب للشجار حقًّا؟

60
00:05:49,800 --> 00:05:51,990
.عليكما أن تتمالكا نفسيكما وإلّا ستفشلان

61
00:06:15,230 --> 00:06:17,390
رايج-كن، هل تقرأ الجرائد؟

62
00:06:18,720 --> 00:06:21,090
ومن لا يفعل؟

63
00:06:21,090 --> 00:06:22,820
.أقرأ الأخبار على الإنترنت

64
00:06:23,700 --> 00:06:27,950
.الجرائد تخبرك ما يقوله الخبراء

65
00:06:29,090 --> 00:06:30,450
.فهمت

66
00:06:30,980 --> 00:06:33,610
أيمكنك أن تغنّي هذه الأغنية حقًّا وأنت بهذا الحال؟

67
00:06:33,610 --> 00:06:35,870
".الموضوع هو: "الحقبة التي نعيشها

68
00:06:35,870 --> 00:06:40,490
.أعلم بشأن الفوارق الجيلية وما إلى ذلك

69
00:06:41,940 --> 00:06:43,930
.المعرفة ليست كافية

70
00:06:43,930 --> 00:06:46,340
.أنت بحاجة للتفهّم والتعاطف

71
00:06:50,440 --> 00:06:52,130
أيّ جريدة تلك؟

72
00:06:52,640 --> 00:06:53,700
لماذا؟

73
00:06:54,200 --> 00:06:57,350
.فكّرت أن أقرأها أيضًا

74
00:06:57,610 --> 00:06:59,090
هل ستدرس إذًا؟

75
00:06:59,090 --> 00:07:00,920
.أمنحك درجة عالية يا شينجي

76
00:07:04,940 --> 00:07:07,940
.اسمع، أنا أحترمك حقًّا يا دايا

77
00:07:07,940 --> 00:07:10,180
لمَ تقول هذا فجأةً؟

78
00:07:10,610 --> 00:07:13,930
هل رايج-كن هكذا دائمًا؟

79
00:07:14,470 --> 00:07:18,820
.وكأنّه يفكّر في نفسه فحسب

80
00:07:18,820 --> 00:07:20,500
...أجل

81
00:07:20,500 --> 00:07:27,630
لكن رايج يبقى رايج. إنّه يؤمن
.في القيام بالأمور على طريقته

82
00:07:28,150 --> 00:07:30,840
.ذلك يزعجني بحق

83
00:07:31,250 --> 00:07:32,630
يزعجك إذًا؟

84
00:07:33,520 --> 00:07:38,410
،قبل فترة، وطأ على قدمي
.ثمّ قال أنّني أعترض طريقه

85
00:07:38,410 --> 00:07:42,120
.حسنٌ... هذا تصرّف طبيعيّ منه

86
00:07:46,100 --> 00:07:47,150
.فهمت

87
00:07:47,820 --> 00:07:50,280
.رايج هو الرقم 00 وشينجي الرقم 01

88
00:07:50,280 --> 00:07:52,760
.كان ذلك لا مفرّ منه

89
00:07:53,260 --> 00:07:56,660
لمَ يحصل على قميص؟

90
00:07:58,000 --> 00:08:02,360
.قال أحدهم أنني سأبدو أفضل بارتداء قميص

91
00:08:03,890 --> 00:08:06,910
.جسدي عملٌ فنيّ

92
00:08:06,910 --> 00:08:09,680
.وأظنّ أنّ جسدك ليس كذلك

93
00:08:10,490 --> 00:08:14,300
بالمناسبة، لا بأس بارتداء ربطة
عنق دون ارتداء قميص، صحيح؟

94
00:08:15,830 --> 00:08:18,870
.أجل. أظنّ أنّ ذلك سيناسبك

95
00:08:21,650 --> 00:08:24,850
لمَ هو متبجح دائمًا؟

96
00:08:24,850 --> 00:08:26,300
من يخال نفسه؟

97
00:08:27,560 --> 00:08:29,080
أمير؟

98
00:08:29,080 --> 00:08:31,480
.إنه أمير بالفعل، صحيح؟ الأمير شينجي

99
00:08:31,480 --> 00:08:34,220
.كما أنه أكبر منّا بسنة

100
00:08:34,220 --> 00:08:35,320
ما هذا؟

101
00:08:35,320 --> 00:08:38,460
هل يعطيه ذلك الحقّ لاستحقار رايج الجليل؟

102
00:08:38,460 --> 00:08:39,320
إذًا؟

103
00:08:43,700 --> 00:08:45,460
!أنا سعيد حقًّا

104
00:08:45,890 --> 00:08:49,000
!أجل! هذا الغداء الياباني لذيذ

105
00:08:49,000 --> 00:08:50,460
!لحم الخنزير بالزنجبيل

106
00:08:51,460 --> 00:08:52,800
.كانو-كن

107
00:08:53,180 --> 00:08:56,130
.تبدو مرهقًا حقًّا

108
00:08:56,600 --> 00:08:58,680
ثنائيتك الجديدة لا تسير على ما يرام؟

109
00:08:59,630 --> 00:09:02,700
.فقط لا أعلم فيمَ يفكّر

110
00:09:03,440 --> 00:09:07,360
،إن كان لا يريد العمل معي
.لن نستطيع أبدًا الرّقص بتزامن

111
00:09:07,360 --> 00:09:08,860
...وعلى أيّ حال، رايج-كن نوعًا ما

112
00:09:09,930 --> 00:09:10,860
!كانو-كن

113
00:09:11,310 --> 00:09:12,730
هذا المقعد شاغر، صحيح؟

114
00:09:19,240 --> 00:09:20,740
.أكيد، تفضل

115
00:09:28,170 --> 00:09:29,010
!آسف

116
00:09:29,010 --> 00:09:31,040
.لا بأس حقًّا

117
00:09:35,220 --> 00:09:37,900
لمَ لا تستطيع مراعاة الآخرين؟

118
00:09:39,810 --> 00:09:41,310
.قال أنّه لا بأس

119
00:09:42,720 --> 00:09:44,430
!هذا ليس ما قصدته

120
00:09:44,920 --> 00:09:47,590
أقصد أنّ عدم قدرتك على مراعاة الآخرين

121
00:09:47,590 --> 00:09:50,440
.قد تفسّر فشلك في الرقص

122
00:09:53,650 --> 00:09:56,190
...قد يكون هذا من مخيّلتي، لكن

123
00:09:56,900 --> 00:09:59,990
هل تريد الشجار معي؟

124
00:09:59,990 --> 00:10:01,950
.لا تغير الموضوع

125
00:10:01,950 --> 00:10:05,450
!عذرًا... أنا بخير! حقًّا

126
00:10:07,240 --> 00:10:09,440
.أنت شخص مضحك

127
00:10:09,440 --> 00:10:10,730
.هلمّ إذًا

128
00:10:10,730 --> 00:10:12,590
.لا أريد الشجار

129
00:10:13,070 --> 00:10:15,090
.بل لا تستطيع الشجار

130
00:10:15,090 --> 00:10:17,360
.هيّا. سدّد ضربتك

131
00:10:17,740 --> 00:10:20,890
.فكّر في الأمر كتحدٍّ جديد لتجريب يدك

132
00:10:20,890 --> 00:10:22,510
.هيّا يا صاح

133
00:10:26,570 --> 00:10:27,480
ما الخطب؟

134
00:10:28,620 --> 00:10:29,770
!توقف

135
00:10:39,250 --> 00:10:41,380
!رائع. نل منه

136
00:10:41,380 --> 00:10:43,660
!لا! دايا-سان، أوقفه

137
00:10:46,590 --> 00:10:48,660
.لا تعبث معي

138
00:10:50,270 --> 00:10:51,970
!رايج-كن، لا تلعب بنزاهة

139
00:10:52,540 --> 00:10:54,720
!دائمًا ما تحاول تغيير الموضوع

140
00:10:55,170 --> 00:10:57,300
!خذ هذا على محمل الجد، اتفقنا

141
00:10:58,610 --> 00:11:01,180
!أغلق فمك الأحمق

142
00:11:04,300 --> 00:11:06,310
.حسنًا، هذا يكفي

143
00:11:14,240 --> 00:11:15,480
.م.ج.ف

144
00:11:19,390 --> 00:11:20,610
.م.ج.ف

145
00:11:26,380 --> 00:11:28,960
.عليكما أن تتصالحا الآن

146
00:11:30,060 --> 00:11:31,650
.أقصد، أنت وشينجي-كن

147
00:11:31,650 --> 00:11:35,060
.وإلّا ستفشل ثنائية سوبر رير

148
00:11:35,060 --> 00:11:36,900
.هذا ليس من شأنك

149
00:11:36,900 --> 00:11:37,840
!بل شأني

150
00:11:38,260 --> 00:11:43,290
.أنا أتطلّع لرؤيتكما تؤدّيان كثنائيّ سوبر رير

151
00:11:44,070 --> 00:11:48,680
لكن هنالك الكثير من النّاس
.الذين يتوقون لسماع أغنيتكما أيضًا

152
00:11:50,860 --> 00:11:51,730
.تفضل

153
00:11:57,920 --> 00:11:59,660
.كان ذلك فظيعًا

154
00:11:59,660 --> 00:12:02,280
.لم أنحرج هكذا من قبل

155
00:12:02,280 --> 00:12:04,180
.لماذا؟ كان ذلك رائعًا

156
00:12:04,180 --> 00:12:05,560
.لا تمزح

157
00:12:05,560 --> 00:12:06,620
.أنا جاد

158
00:12:06,620 --> 00:12:11,500
.راقني الأمر عندما فقدت صوابك على رايج

159
00:12:11,780 --> 00:12:13,960
.أنت تتصرّف برقيّ دائمًا

160
00:12:17,880 --> 00:12:20,400
،أنا غبيّ، لذا لن يبدو هذا جيّدًا على الأغلب

161
00:12:20,930 --> 00:12:24,890
لكن لمَ لا تنظر إلى عينيه مباشرةً وتخبره بما تشعر به حقًّا؟

162
00:12:25,740 --> 00:12:27,430
.أقصد، أخبرا بعضيكما

163
00:12:28,590 --> 00:12:33,640
.لكن لا أظنّ أنّ رايج-كن وأنا نستطيع الانسجام بعد الآن

164
00:12:40,000 --> 00:12:42,440
.سمعت ما حدث في المقصف

165
00:12:42,440 --> 00:12:45,320
ما الذي يجري معكما؟

166
00:12:49,940 --> 00:12:52,860
.فهمت. لا داعي لقول المزيد

167
00:12:52,860 --> 00:12:54,710
.سنحلّ سوبر رير

168
00:12:56,110 --> 00:13:00,530
.نتائج النزالات عنت أنّكما اجتمعتما معًا ولم يفلح الأمر

169
00:13:00,530 --> 00:13:04,880
أو ربّما كانت هذه الفكرة الجديدة صعبة للغاية

170
00:13:04,880 --> 00:13:07,720
بالنّسبة لشخصين مختلفين جدًّا عن بعضهما؟

171
00:13:08,310 --> 00:13:12,220
.شينجي-كن، عليك أن تبقى كأمير

172
00:13:13,050 --> 00:13:16,890
.أنت طالب نموذجيّ. لا تحاول التغيير من شخصيتك

173
00:13:18,860 --> 00:13:22,860
شينجي طالب نموذجيّ؟ من قرّر ذلك؟

174
00:13:22,860 --> 00:13:25,610
.الطالب النموذجيّ لا يشنّ الشجارات

175
00:13:25,870 --> 00:13:29,370
.لا ترغمه أن يكون "الشخصية" التي تريده أن يكون

176
00:13:33,740 --> 00:13:37,370
.وماذا عنك يا رايج-كن؟ انسَ بشأنه للحظة

177
00:13:37,640 --> 00:13:40,580
.تملك خبرةً في الرّقص أقلّ من الآخرين

178
00:13:40,580 --> 00:13:43,340
.وهي مهارة كبيرة تفتقر إليها

179
00:13:43,340 --> 00:13:45,260
.ومع ذلك تفوّت تمارين الرّقص

180
00:13:45,560 --> 00:13:49,930
وسلوكك الأنانيّ ذاك هو السّبب من فشلك دائمًا، صحيح؟

181
00:13:49,930 --> 00:13:51,260
أليس كذلك يا شينجي-كن؟

182
00:13:51,640 --> 00:13:53,400
فشل؟

183
00:13:54,750 --> 00:13:59,580
أخشى أن أردّ عليك أيّها المدير أنّ رايج-كن هو
.رايج-كن وهو يملك طريقته في القيام بالأمور

184
00:14:00,460 --> 00:14:03,140
...إنّه يملك إلهامًا لا نستطيع بلوغه

185
00:14:03,140 --> 00:14:04,610
.وكاريزما نفتقرها

186
00:14:05,010 --> 00:14:09,030
.لا جدوى من تعريفه بقدر الوقت الذي يتدرّب فيه

187
00:14:09,540 --> 00:14:11,200
.لا يزال هنالك وقت

188
00:14:11,200 --> 00:14:13,740
.لا تلغِ أداءنا رجاءً

189
00:14:19,380 --> 00:14:21,630
...يا ليت الشباب يعود يومًا

190
00:14:21,630 --> 00:14:24,140
.لكن أخشى أنّ الأمر ميؤوس

191
00:14:24,700 --> 00:14:26,640
.فلنلغِ الأمر

192
00:14:26,640 --> 00:14:28,130
.قوما بتمارينكما الاعتيادية

193
00:14:28,130 --> 00:14:29,670
.أنا واثق أنكما ستدركان الأمر

194
00:14:29,670 --> 00:14:31,890
.أنتما جيّدان في إدراك الأمور

195
00:14:31,890 --> 00:14:34,020
هذا أفضل ما في جيلكما، صحيح؟

196
00:14:35,080 --> 00:14:36,590
ما هذا؟

197
00:14:36,590 --> 00:14:39,640
.أقرّ أنّ هذا لم يسر على خير

198
00:14:39,640 --> 00:14:45,080
لكن إلقاء اللّوم على صغر سنّنا
.أو لأنّنا من جيل معيّن لهو أمرٌ مزعج

199
00:14:45,080 --> 00:14:46,660
.لكنّها الحقيقة

200
00:14:46,660 --> 00:14:48,270
...الحقيقة أم لا

201
00:14:48,270 --> 00:14:50,080
.يمكننا فعل هذا

202
00:14:50,080 --> 00:14:53,160
.سنجعل سوبر رير تنجح

203
00:14:53,530 --> 00:14:56,510
...أنتما تقولان الكلام الصواب، لكن

204
00:14:57,650 --> 00:15:01,540
.سنريك ما إن كنّا نجيد الكلام فحسب حينما نعتلي المسرح

205
00:15:02,000 --> 00:15:04,920
.سأخاطر بفخري كمؤدّي

206
00:15:06,420 --> 00:15:07,550
فخرك" إذًا؟"

207
00:15:07,870 --> 00:15:11,170
أنت! هل تهين أداءاتنا الآن؟

208
00:15:11,170 --> 00:15:14,960
!كانت لدينا مشاكل، لكنّنا تغلّبنا عليها

209
00:15:14,960 --> 00:15:17,680
!لأننا أربعة

210
00:15:18,020 --> 00:15:21,420
!لذا سنحقّق النجاح من الآن فصاعدًا

211
00:15:22,080 --> 00:15:25,070
هذا ما في الأمر. هل فهمت أيها العجوز؟

212
00:15:25,430 --> 00:15:27,710
.مناداته بالعجوز وقاحة يا رايج-كن

213
00:15:27,710 --> 00:15:29,730
.فقط ادعوه بالمسنّ

214
00:15:30,560 --> 00:15:32,570
.ذلك لا يختلف شأنًا

215
00:15:33,530 --> 00:15:34,730
!على أي حال

216
00:15:34,730 --> 00:15:36,750
.اخرس وانتظر الحفل فحسب

217
00:15:37,060 --> 00:15:40,080
.سنجعل منه الأداء المطلق

218
00:15:42,660 --> 00:15:43,830
!لا تعبث معنا

219
00:15:51,760 --> 00:15:53,050
كيف سار الأمر؟

220
00:15:53,560 --> 00:15:54,510
.سنقوم بهذا

221
00:15:56,440 --> 00:15:57,510
!ممتاز

222
00:15:58,140 --> 00:16:00,200
قمت بإثارتهما عن قصد، أليس كذلك؟

223
00:16:00,200 --> 00:16:02,610
هل تظن أنّهما يكرهانني الآن؟

224
00:16:03,480 --> 00:16:06,170
وأنت من جيل "الاسترسال"، صحيح؟

225
00:16:06,170 --> 00:16:07,820
.الزم الصمت رجاءً يا سيدي

226
00:16:14,780 --> 00:16:16,820
!رايج، حرّك ساقيك

227
00:16:16,820 --> 00:16:18,280
!شينجي، انتبه لذراعيك

228
00:16:19,040 --> 00:16:21,660
!أنتما تركّزان كثيرًا على الحركات وليس القوة

229
00:16:21,660 --> 00:16:23,680
!اعتبرا أنني المخرج

230
00:16:23,680 --> 00:16:25,040
!اغضبا أكثر

231
00:16:28,060 --> 00:16:29,180
!رائع حقًّا

232
00:16:29,180 --> 00:16:30,670
!مرّة أخرى

233
00:16:31,130 --> 00:16:32,180
!جميل

234
00:16:48,850 --> 00:16:50,080
.جميل

235
00:16:50,080 --> 00:16:51,970
!كنتما منسجمين تمامًا

236
00:17:02,660 --> 00:17:05,180
لكن لا تستطيعان فعل ذلك؟

237
00:17:05,180 --> 00:17:08,120
.كان يجب أن تحاولا مواكبتي

238
00:17:08,120 --> 00:17:09,440
.كلّا، بل تواكبانني

239
00:17:09,440 --> 00:17:10,670
!كلاكما

240
00:17:10,670 --> 00:17:13,670
!دعونا نلتقط صورة للاحتفال بنجاحكما

241
00:17:14,040 --> 00:17:15,980
حقًّا؟

242
00:17:28,230 --> 00:17:32,730
أقرأ عقلك

243
00:19:21,880 --> 00:19:23,970
.(كانت تلك ثنائية سوبر رير (فريدة للغاية

244
00:19:25,310 --> 00:19:28,470
.أجل. كانت سوبر رير حقًّا

245
00:21:10,960 --> 00:21:14,870
مساء الخير جميعًا وشكرًا لكم على
!"مشاهدة "إي أر بي باكستايج باس

246
00:21:14,870 --> 00:21:16,280
!مرحبًا

247
00:21:16,280 --> 00:21:18,220
...حسنًا، إذًا

248
00:21:19,120 --> 00:21:20,930
...كانت تلك سوبر رير

249
00:21:22,370 --> 00:21:24,450
ماذا؟ ما الذي يعنيه ذلك؟

250
00:21:24,450 --> 00:21:26,460
.لا أملك أدنى فكرة

251
00:21:26,460 --> 00:21:28,870
.بحقّكم يا رفاق. خفّفوا عنه

252
00:21:28,870 --> 00:21:33,140
في النهاية، تعرّض لضرب
.مبرح من رايج في التلفاز الوطني

253
00:21:33,140 --> 00:21:36,150
.كلّا، ذلك ليس ما حدث على الإطلاق

254
00:21:36,150 --> 00:21:37,870
.كان تعادلًا على ما أظن

255
00:21:38,360 --> 00:21:43,170
.أجل، لكن يا شينجي-كن، كان قميصك مبعثرًا تمامًا

256
00:21:43,170 --> 00:21:45,550
.كان الجميع في المقصف يشاهدون

257
00:21:45,550 --> 00:21:49,070
.دايا-سان، كنت تقف هناك تقريبًا تتنهّد

258
00:21:49,070 --> 00:21:51,740
،يمكننا أن نضحك على ذلك الآن

259
00:21:51,740 --> 00:21:55,300
لكن في ذلك الوقت، كنتُ أتساءل
"ما الذي سيحلّ بـ م.ج.ف؟"

260
00:21:55,300 --> 00:21:59,170
.أجل. أشعر بالأسى حقًّا بشأن ما حصل

261
00:21:59,170 --> 00:22:01,670
.آسف لأنّكم شاهدتم ذلك

262
00:22:01,670 --> 00:22:05,820
.لكن أظنّ أنّ ذلك كان ضروريًّا

263
00:22:05,820 --> 00:22:09,780
حتّى تلك اللّحظة، لم يكونا هذين الاثنين
.ينظران إلى بعضهما حينما كانا يتحدّثان

264
00:22:09,780 --> 00:22:11,110
أليس كذلك؟

265
00:22:11,110 --> 00:22:13,350
.مثلما كانا في الكواليس

266
00:22:13,350 --> 00:22:16,160
.قد تكون محقًّا في ذلك

267
00:22:16,160 --> 00:22:19,370
!لكن بالطّبع، العنف خاطئ

268
00:22:19,370 --> 00:22:24,370
.هذا صحيح، العنف مخيف
.لا يجب أن تلجؤوا إليه أبدًا

269
00:22:24,370 --> 00:22:26,720
—لكنّك كنت تحاول أن تحصل على ردّ فعل

270
00:22:26,720 --> 00:22:28,080
.توقّفا أنتما الاثنان

271
00:22:28,080 --> 00:22:31,140
!لذا... سوبر رير

272
00:22:31,140 --> 00:22:32,210
تغيّر الموضوع إذًا؟

273
00:22:32,210 --> 00:22:33,380
.بادر

274
00:22:33,380 --> 00:22:34,410
.الرقص

275
00:22:34,410 --> 00:22:37,180
ساعدناكما بالحركات، صحيح؟

276
00:22:37,180 --> 00:22:39,370
.وتمّ تجاهل ذلك نوعًا ما

277
00:22:39,370 --> 00:22:43,080
!أجل يا صاح. لقد ساعدناكما كثيرًا

278
00:22:43,080 --> 00:22:44,910
—أجل، شينجي حقًّا

279
00:22:44,910 --> 00:22:46,370
.كلاكما

280
00:22:46,370 --> 00:22:48,080
.كانا كلاكما

281
00:22:49,330 --> 00:22:51,840
!كان ذلك ممتعًا نوعًا ما

282
00:22:51,840 --> 00:22:54,780
،حاليًّا، نقوم بالكثير من الأشياء كوحدة من أربعة

283
00:22:54,780 --> 00:22:57,300
.لكنّنا لم نفعل ذلك سابقًا

284
00:22:57,300 --> 00:22:59,800
كان كلّ شيء جديدًا تمامًا، صحيح؟

285
00:22:59,800 --> 00:23:01,750
.أجل، كان كذلك

286
00:23:01,750 --> 00:23:04,010
—لكن أنا وليون تعلّمنا الحركات أوّلًا

287
00:23:04,010 --> 00:23:08,030
.حسنًا، حسنًا، حسنًا يا رفاق. لا أحد يهتم

288
00:23:08,030 --> 00:23:10,890
لمَ لا تخبرنا ما كان رأيك بشأن الحلقة؟

289
00:23:10,890 --> 00:23:11,750
.بربّك

290
00:23:13,720 --> 00:23:14,960
.لم أفكر بأي شيء

291
00:23:14,960 --> 00:23:16,950
لم تفعل؟

292
00:23:16,950 --> 00:23:18,860
أظن أنّ كليكما عملتما بجدّ؟

293
00:23:18,860 --> 00:23:20,420
.ذلك غير كافٍ

294
00:23:20,420 --> 00:23:21,380
!وقت العرض المسبق

295
00:23:21,380 --> 00:23:22,710
.هذا مفاجئ

296
00:23:22,710 --> 00:23:26,220
.قصّتنا تدنو من ذروتها

297
00:23:26,220 --> 00:23:27,420
ما الذي سيحدث لـ م.ج.ف؟

298
00:23:27,840 --> 00:23:29,170
.لا شيء على أي حال

299
00:23:29,170 --> 00:23:32,260
من ذا يصدّق ما حدث لشينجي؟

300
00:23:33,400 --> 00:23:35,350
هل حدث شيء؟

301
00:23:36,080 --> 00:23:37,970
.لم يحدث شيء