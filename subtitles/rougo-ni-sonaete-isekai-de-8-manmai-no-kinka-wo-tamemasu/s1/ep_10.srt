1
00:01:32,980 --> 00:01:35,610
...خزّنت الكثير منها لأنّها كانت رخيصة

2
00:01:36,050 --> 00:01:38,420
...لكن ربّما كانت فكرة سيّئة

3
00:01:38,420 --> 00:01:40,990
...ما زالوا لم يخترعوا البارود في ذلك العالم

4
00:01:43,900 --> 00:01:45,750
!إنّه النّقيب

5
00:01:47,460 --> 00:01:49,290
ستقوم بالطّبخ في الخارج؟

6
00:01:57,920 --> 00:01:59,040
...مهلاً

7
00:01:59,490 --> 00:02:01,680
أهذه أرانب؟

8
00:02:01,680 --> 00:02:04,440
.ربّما... بشكل أو بآخر

9
00:02:04,440 --> 00:02:05,760
ربّما؟

10
00:02:05,760 --> 00:02:07,890
!أيعقل أنّه الجاكالوب؟

11
00:02:07,890 --> 00:02:10,150
الحيوان الخرافيّ الّذي يقال أنّه يعيش في الغرب؟

12
00:02:10,150 --> 00:02:12,630
!مستحيل أنّها استطاعت صيد أحدها

13
00:02:12,630 --> 00:02:15,320
.واضح أنّها نادرة جدًّا

14
00:02:27,290 --> 00:02:28,980
!مذاقها لذيذ

15
00:02:29,510 --> 00:02:31,540
.بالإمكان بيعها كطرائد برّيّة

16
00:02:31,540 --> 00:02:32,330
فعلاً؟

17
00:02:32,760 --> 00:02:35,540
.ربّما عليّ تعيين سفين وفرقته

18
00:02:43,160 --> 00:02:46,130
.شكرًا على الدّعوة أيّها النّقيب

19
00:02:46,130 --> 00:02:48,230
،لن تكون لدينا أيّ أعمال كبيرة لمدّة

20
00:02:48,630 --> 00:02:50,910
.لذلك فكّرت بالاستمتاع بقدر المستطاع

21
00:02:50,910 --> 00:02:53,270
.من الصّعب توقّع أنّهم مقاتلون محترفون

22
00:02:53,270 --> 00:02:55,230
.يبدون عاديّين جميعًا

23
00:02:55,670 --> 00:02:58,930
إنّ قيامنا بهذا النّوع من العمل
.لا يعني أنّنا نحبّ الحرب

24
00:03:00,250 --> 00:03:03,360
،قد يبدو كلامي غريبًا لأنّه صادر منّي
.لكن لا شيء يضاهي السّلم السّكون

25
00:03:03,360 --> 00:03:05,530
الأكل بشكل جيّد والتّصرّف بصّخب
!والعيش كما يحلو لنا

26
00:03:06,180 --> 00:03:07,580
...فهمت

27
00:03:08,470 --> 00:03:09,750
!معك حقّ

28
00:03:16,350 --> 00:03:18,710
!لم يزرني أيّ زبائن

29
00:03:18,710 --> 00:03:21,550
،عندما أدّخل 80 ألف قطعة ذهبيّة

30
00:03:21,550 --> 00:03:24,100
فسأكون عجوزًا في السّبعين شاب
!شعرها على هذا الحال

31
00:03:25,780 --> 00:03:26,850
!مرحبًا بكم

32
00:03:27,300 --> 00:03:30,060
!أجل! أوّل زبائني منذ مدّة طويلة

33
00:03:31,290 --> 00:03:33,350
ما الّذي ترغبون بشرائه اليوم؟

34
00:03:33,890 --> 00:03:35,060
!خيمة كلّ مكان

35
00:03:33,890 --> 00:03:35,060
!الحصيرة العازلة

36
00:03:35,570 --> 00:03:36,270
ماذا؟

37
00:03:36,270 --> 00:03:38,520
.كما سمعت، الحصيرة العازلة

38
00:03:38,520 --> 00:03:40,460
!لا، بل خيمة كلّ مكان

39
00:03:40,460 --> 00:03:43,780
عفوًا... ما رأيكما بشراء الاثنين؟

40
00:03:43,780 --> 00:03:45,270
...ذلك

41
00:03:45,270 --> 00:03:47,240
...سيفوق ذلك ميزانيّتنا

42
00:03:48,330 --> 00:03:49,290
...في تلك الحالة

43
00:03:49,950 --> 00:03:51,370
!سأبيعكما كليهما

44
00:03:51,370 --> 00:03:52,710
!ماذا؟

45
00:03:52,710 --> 00:03:54,920
،ولكن، في زيارتكما التّالية

46
00:03:54,920 --> 00:03:57,380
.أحضرا معكما رفاقكما في النّقابة معكما

47
00:03:58,050 --> 00:04:00,310
.سأعطيكما تخفيض 10% إن أحضرتما شخصًا واحدًا

48
00:04:00,310 --> 00:04:02,400
!وسأبيعكما بنصف الثّمن إن أحضرتما خمسة

49
00:04:02,820 --> 00:04:05,640
!وهكذا، بإمكانكما شراء الغرضين بسعر الواحد

50
00:04:05,640 --> 00:04:06,720
!أأنت واثقة؟

51
00:04:06,720 --> 00:04:07,600
!نعم

52
00:04:08,040 --> 00:04:11,180
.حسنًا، سنحضرهم. سنحضر النّقابة بأكملها

53
00:04:12,360 --> 00:04:15,350
سنتمكّن من شراء مشعل النّار هذا
...والموقد وبعض الحصص الغذائيّة

54
00:04:15,350 --> 00:04:16,940
!شكرًا لكما

55
00:04:16,940 --> 00:04:18,280
.يا لحظّنا

56
00:04:18,280 --> 00:04:19,370
.نعم

57
00:04:18,600 --> 00:04:21,880
يخالف هذا سياسة الرّبح الكبير
...والكمّيّة القليلة

58
00:04:21,880 --> 00:04:24,030
.لكن لا يمكنني العمل إن لم يكن لي زبائن

59
00:04:24,410 --> 00:04:27,950
!بإمكان الزّبائن جلب زبائن أكثر بالحافز المناسب

60
00:04:27,950 --> 00:04:31,980
أسمّي هذا "عمليّة عرض التّخفيضات
!"والحسومات للحصول على الذّهب

61
00:04:31,980 --> 00:04:34,040
!سأجمع الكثير من الذّهب هكذا

62
00:04:37,000 --> 00:04:39,710
.هذا هو تقريري عن الآنسة ميتسوها

63
00:04:42,730 --> 00:04:45,110
.لم تستطع معرفة أيّ شيء في النّهاية

64
00:04:45,110 --> 00:04:46,010
.صحيح

65
00:04:46,010 --> 00:04:49,560
،ظهرت فجأة يومًا ما في منطقة الكونت بوزس

66
00:04:49,560 --> 00:04:53,800
.قتلت قطيع ذئاب وحدها وأنقذت فتاة قرويّة

67
00:04:53,800 --> 00:04:57,270
،صارت صديقة لعائلة بوزس بعد ذلك

68
00:04:57,270 --> 00:05:00,260
وفتحت متجرًا في العاصمة
،يبيع منتجات من مصدر مجهول

69
00:05:00,260 --> 00:05:01,570
.وهذا هو حالنا الآن

70
00:05:02,730 --> 00:05:05,780
واثق أنّك وجدت ما يُسمّى نظّارات
.القراءة مفيدة أيضًا

71
00:05:06,120 --> 00:05:08,390
.نعم، بكلّ تأكيد

72
00:05:09,470 --> 00:05:11,320
،معرفة استثنائيّة

73
00:05:11,320 --> 00:05:13,820
إضافة للبراعة اللاّزمة لتنظيم حفل استهلال

74
00:05:13,820 --> 00:05:15,370
...ابنة الفيكونت راينر

75
00:05:15,370 --> 00:05:21,170
.من الصّعب تخيّل أنّها نبيلة عاديّة من بلاد صغيرة

76
00:05:22,170 --> 00:05:24,340
...مبعوثة البرق

77
00:05:24,660 --> 00:05:27,240
.ولكن يبدو أنّها لا تحمل أيّ نوايا سيّئة تجاه مملكتنا

78
00:05:27,240 --> 00:05:28,410
.نعم

79
00:05:28,410 --> 00:05:31,080
،يبدو أنّها تقبل أعمالاً تساعد بهذا الآخرين

80
00:05:31,080 --> 00:05:33,910
،وعندما أنقذت سموّ الأميرة فوق كلّ ذلك

81
00:05:33,910 --> 00:05:37,420
.قادنا هذا للقضاء على شبكة الاتّجار بالبشر

82
00:05:37,420 --> 00:05:38,440
.نعم

83
00:05:38,440 --> 00:05:42,190
.يبدو أنّ سابين معجبة بها كثيرًا

84
00:05:42,930 --> 00:05:45,830
.حسنًا، لن يطرح هذا أيّ مشاكل

85
00:05:45,830 --> 00:05:49,740
ربّما سيكون من الأفضل أن نحاول
.خدمتها أكثر في الحقيقة

86
00:05:49,740 --> 00:05:50,920
...على هذا المعدّل

87
00:05:50,920 --> 00:05:54,700
.نعم. إنّها فتاة صغيرة مصيرة للإعجاب بالفعل

88
00:05:54,700 --> 00:05:58,670
.نعم. مثيرة للإعجاب هو خير وصف

89
00:06:01,940 --> 00:06:02,880
...الأهمّ الآن

90
00:06:04,630 --> 00:06:06,420
...ثمّة مسألة أكثر أهمّيّة

91
00:06:06,420 --> 00:06:08,880
.وهي الوضع المقلق على حدودنا

92
00:06:16,450 --> 00:06:17,690
.تعاليا معنا للحظة

93
00:06:27,700 --> 00:06:29,660
...مرحبًا بكـ

94
00:06:31,600 --> 00:06:33,380
!أختي الكبيرة ميتسوها

95
00:06:33,380 --> 00:06:35,970
.يطلب والدي حضورك للقصر

96
00:06:35,970 --> 00:06:38,020
.قال أنّها مسألة عاجلة

97
00:06:40,060 --> 00:06:45,000
!أنت أوّل صديقة لي تأتي للّعب معي
!كم أسعدني هذا

98
00:06:47,200 --> 00:06:49,750
!لقد وصلوا إلى منطقة أكانيود

99
00:06:49,750 --> 00:06:51,720
!إنّهم على مرمى حجر من العاصمة الملكيّة

100
00:06:52,230 --> 00:06:54,350
.علينا الدّفاع عن آخر خطوط دفاعنا بأرواحنا

101
00:06:54,350 --> 00:06:57,440
.نعم. هذه المملكة بأكملها على المحكّ

102
00:06:57,880 --> 00:06:59,620
!اصطفّوا في الحال

103
00:06:58,490 --> 00:07:00,730
...هذا شعور مختلف تمامًا عن آخر مرّة

104
00:07:00,730 --> 00:07:02,520
.الجميع في حالة تأهّب

105
00:07:03,460 --> 00:07:04,520
.إنّه الحرب

106
00:07:04,520 --> 00:07:05,520
ماذا؟

107
00:07:05,520 --> 00:07:07,750
.العلامات واضحة

108
00:07:07,750 --> 00:07:10,260
...بسبب امتلاك مملكتنا لأرض خصبة

109
00:07:10,260 --> 00:07:11,820
...اللّعنة عليك يا إمبراطوريّة ألدر

110
00:07:11,820 --> 00:07:13,610
ولكنّ تحليلاتنا تقترح

111
00:07:13,610 --> 00:07:17,450
.أنّ لا فرصة كافية لهم لتبرير شروعهم في الغزو

112
00:07:17,810 --> 00:07:20,290
!لا أصدّق أنّهم قد أخذوا موقفًا كهذا

113
00:07:20,290 --> 00:07:24,500
أريدك أن تأخذي سابين وتحتميان
.في بلاد أخرى تكون آمنة

114
00:07:24,500 --> 00:07:25,680
!ماذا؟

115
00:07:25,680 --> 00:07:27,060
...كلاّ

116
00:07:27,060 --> 00:07:30,250
!لا أريد أن أكون الوحيدة الّتي تختبئ خارج المملكة

117
00:07:30,250 --> 00:07:32,060
.هذا من باب الحيطة فحسب

118
00:07:32,060 --> 00:07:34,340
.ستتمكّنين من العودة بمجرّد انتهاء الحرب

119
00:07:35,510 --> 00:07:38,910
تمكّن العدوّ من طرد جيوش مقاطعاتنا في وقت وجيز

120
00:07:38,910 --> 00:07:41,620
.وهو يقترب بسرعة من العاصمة

121
00:07:41,620 --> 00:07:45,190
هُزمت القوّات الّتي تحرس الحدود بهذه السّهولة؟

122
00:07:45,770 --> 00:07:48,690
.خاننا عدد من النّبلاء في تلك المنطقة

123
00:07:48,690 --> 00:07:49,630
!ماذا؟

124
00:07:49,630 --> 00:07:52,790
كانوا ليُبقوا الأعداء بعيدًا في العادة وتوفير الوقت لنا

125
00:07:52,790 --> 00:07:55,680
...ويساعدوننا في حشد القوّات

126
00:07:56,350 --> 00:08:00,910
إضافة لذلك، يبدو أنّ الجيش الإمبراطوريّ
.قد لجأ لتجنيد الوحوش أيضًا

127
00:08:02,120 --> 00:08:04,820
لماذا الوحوش الّتي لا تتشاركنا نفس اللّغة

128
00:08:04,820 --> 00:08:07,310
أن تعمل بتوافق مع الجيش الإمبراطوريّ؟

129
00:08:07,310 --> 00:08:09,800
.لا يمكنني فهم هذا على الإطلاق

130
00:08:09,800 --> 00:08:12,630
،أصدرنا مرسومًا في كلّ أنحاء المملكة

131
00:08:12,630 --> 00:08:16,080
لكن لا يبدو أنّنا سنجمع القوّات الكافية
.لحماية العاصمة في الوقت المناسب

132
00:08:16,520 --> 00:08:19,100
.أنا أعهد لك بها يا آنسة ميتسوها

133
00:08:19,470 --> 00:08:20,810
.أرفض

134
00:08:20,810 --> 00:08:21,890
!ماذا؟

135
00:08:21,890 --> 00:08:25,400
.متجري هو منزلي وقلعتي بالنّسبة لي

136
00:08:25,400 --> 00:08:28,650
!لن أتخلّى عنه أبدًا وأهرب في منتصف الحرب

137
00:08:28,980 --> 00:08:29,940
...ولكن

138
00:08:31,910 --> 00:08:34,780
.أيّتها الآنسة ميتسوها مبعوثة البرق

139
00:08:36,410 --> 00:08:38,950
.سأحمي متجري بنفسي

140
00:08:38,950 --> 00:08:40,810
،إن تعدّى عليه أيّ أحد بغير حقّ

141
00:08:40,810 --> 00:08:43,040
سأدمّر المكان بأكمله بشكل ذاتيّ
!وسأطيح بهم معي

142
00:08:43,550 --> 00:08:45,250
تدمير... ذاتيّ؟

143
00:08:45,780 --> 00:08:47,310
،بتعبير آخر

144
00:08:47,310 --> 00:08:50,350
،سأضربهم بالبرق وأمحو كلّ أثر للمتجر

145
00:08:50,350 --> 00:08:51,510
!قبل أن أسمح لهم بأخذه

146
00:08:53,400 --> 00:08:55,470
.ما كنت لأفعل ذلك بالطّبع

147
00:08:56,320 --> 00:08:59,610
سأنتقل بين العالمين مؤقّتًا وأحضر معي
،المتجر بأكملها لجزيرة مهجورة على الأرض

148
00:08:59,610 --> 00:09:02,270
.ثمّ سأنتقل به ثانية لمكان مختلف في هذا العالم

149
00:09:02,620 --> 00:09:04,920
...لذلك السّبب لا يمكنني قبول طلبك

150
00:09:13,990 --> 00:09:17,700
لكن لا يبدو أنّنا سنجمع القوّات الكافية
...لحماية العاصمة في الوقت المناسب

151
00:09:19,480 --> 00:09:22,580
،قد يبدو كلامي غريبًا لأنّه صادر منّي
.لكن لا شيء يضاهي السّلم السّكون

152
00:09:22,580 --> 00:09:25,000
الأكل بشكل جيّد والتّصرّف بصّخب
!والعيش كما يحلو لنا

153
00:09:39,250 --> 00:09:41,760
...إحضار سابين للأرض

154
00:09:46,120 --> 00:09:47,000
.ها أنا ذي

155
00:09:49,530 --> 00:09:51,900
نذير لفرقة الاستطلاع قادم
!من حدود منطقة ناهياس

156
00:09:52,580 --> 00:09:54,050
!حسنًا! يمكنك الدّخول

157
00:09:55,830 --> 00:09:58,610
!نذير... عرفت

158
00:09:58,610 --> 00:10:01,370
إنّهم شائعون في المسلسلات التّاريخيّة
!ويحملون أعلامًا ويوصلون التّقارير

159
00:10:03,800 --> 00:10:05,700
هل أنت الآنسة ميتسوها؟

160
00:10:05,700 --> 00:10:08,560
.لديّ أوامر من صاحب الجلالة بالسّماح لك بالمرور

161
00:10:08,560 --> 00:10:09,550
.تفضّلي

162
00:10:09,550 --> 00:10:12,670
ماذا؟ ستسمح لي بالمرور بهذه السّهولة؟

163
00:10:16,010 --> 00:10:18,130
.أتساءل أين هي سابين

164
00:10:18,130 --> 00:10:19,360
!آنسة ميتسوها

165
00:10:19,360 --> 00:10:21,760
.أتيت في الوقت المناسب

166
00:10:21,760 --> 00:10:24,970
المستشار. أين هي سابين؟

167
00:10:24,970 --> 00:10:26,910
.بإمكاننا مناقشة ذلك لاحقًا

168
00:10:26,910 --> 00:10:28,350
.تفضّلي من هنا رجاءً

169
00:10:30,080 --> 00:10:32,370
.سمعتُ أنّ العدوّ لديه 20 ألف جنديّ

170
00:10:32,370 --> 00:10:35,360
...ثلاثة آلاف غوبلين وغيلان ووحوش أخرى

171
00:10:35,360 --> 00:10:37,520
.يضمّ جيشنا حاليًّا ألفي رجل

172
00:10:37,520 --> 00:10:39,640
،لكنّ من المرجّح أنّ الجبهة الأماميّة قد دُمّرت

173
00:10:39,640 --> 00:10:41,070
.لذلك فالعدد الحقيقيّ أقلّ بكثير

174
00:10:41,530 --> 00:10:44,610
أهذا... مجلس حرب؟

175
00:10:44,610 --> 00:10:45,790
!ميتسوها

176
00:10:52,130 --> 00:10:54,190
!لا تقترب منّي من الخلف

177
00:10:54,190 --> 00:10:56,110
.سأطلق عليك كائنًا من كنت

178
00:10:56,110 --> 00:10:57,760
.هكذا تدرّبت

179
00:10:58,720 --> 00:11:01,930
مقولة مشهورة من أكثر المقولات
!الّتي أردت قولها دائمًا

180
00:11:01,930 --> 00:11:04,880
!لم أستطع تفويت هذه الفرصة المثاليّة لأقولها

181
00:11:04,880 --> 00:11:06,640
!شكرًا جزيلاً لك

182
00:11:07,120 --> 00:11:11,180
...كلاّ... على الرّحب والسّعة

183
00:11:13,030 --> 00:11:14,900
لماذا أنت هنا على أيّ حال؟

184
00:11:15,370 --> 00:11:19,070
.أنا هنا بسبب إخطار عاجل لتمثيل الكونت يا آنستي

185
00:11:19,070 --> 00:11:20,780
تلقّت منطقة بوزس استدعاء أيضًا؟

186
00:11:20,780 --> 00:11:22,000
.نعم

187
00:11:22,000 --> 00:11:25,840
عاد أبي مع أمّي والبقيّة للتّجهيز
.لإرسال القوّات

188
00:11:25,840 --> 00:11:28,430
.أنا هنا بمثابة صلة وصل ولجمع المعلومات

189
00:11:28,430 --> 00:11:31,000
.إنّه الابن البكر، لذلك عليه الرّفع من هيبته

190
00:11:31,630 --> 00:11:33,740
أيّها المستشار، من تلك الفتاة؟

191
00:11:34,250 --> 00:11:36,970
.إنّها الآنسة ميتسوها فون يامانو

192
00:11:36,970 --> 00:11:39,300
...صحيح، تلك الفتاة

193
00:11:39,300 --> 00:11:40,410
ماذا؟

194
00:11:40,410 --> 00:11:42,110
ماذا يقصد بـ"تلك الفتاة"؟

195
00:11:42,110 --> 00:11:44,120
ما الّذي سمعه عنّي يا ترى؟

196
00:11:44,120 --> 00:11:45,290
مهلاً، من يكون؟

197
00:11:45,290 --> 00:11:47,710
.إنّه قائد العامّ، الماركيز أيبلينغر

198
00:11:47,710 --> 00:11:50,180
.هكذا إذًا، صاحب السّلطة الأعلى هنا

199
00:11:50,870 --> 00:11:54,400
.العدوّ في طريقه للعاصمة وسيبلغها ليلة الغد

200
00:11:54,400 --> 00:11:57,860
.من المرّجح أنّهم سيبدؤون العزو فجرًا

201
00:11:57,860 --> 00:12:00,860
خيارنا الوحيد هو التّحصّن في القلعة
!بما أنّ الأمر آل لهذا المآل

202
00:12:01,290 --> 00:12:02,830
التّحصّن في القلعة؟

203
00:12:02,830 --> 00:12:05,820
!يبدو أنّ عليّ أخذ سابين للأرض بالفعل

204
00:12:06,470 --> 00:12:10,130
والآن، سأعلن عن المعسكرات
.الّتي خُصّصت للجميع

205
00:12:10,130 --> 00:12:12,150
!نذير! نذير

206
00:12:13,000 --> 00:12:15,190
مهلاً! من أيّ فرقة أنت؟

207
00:12:16,000 --> 00:12:17,980
!أنا هنا للتّبليغ عن وضع العدوّ

208
00:12:44,910 --> 00:12:46,410
.مهلاً. ثمّة خطب ما

209
00:12:46,410 --> 00:12:48,650
،يجدر بنذير قادم من مكان بعيد أن يرتدي درعًا جلديًّا

210
00:12:48,650 --> 00:12:51,410
.ويحمل تقريرًا بدون أيّ معدّات إضافيّة في طريقه

211
00:12:51,410 --> 00:12:54,250
...تلك الحقيبة الكبيرة المصنوعة من الجلد القاسي

212
00:12:55,070 --> 00:12:59,170
يجدر به أن يكون متوتّرًا لوقوفه أمام
!قائده، لكنّ نظرات عيونه شرسة للغاية

213
00:12:59,170 --> 00:13:01,130
!إنّها نظرات شخص يحدّق في فريسته

214
00:13:01,130 --> 00:13:03,270
!ستندلع الفوضى إن قُتل الماركيز

215
00:13:03,270 --> 00:13:04,340
!عليّ إيقافه

216
00:13:06,200 --> 00:13:07,640
!يا لي من غبيّة

217
00:13:07,640 --> 00:13:09,290
!أنا من ستُقتل هنا

218
00:13:24,110 --> 00:13:25,280
!سيّد أليكسيس

219
00:13:29,520 --> 00:13:31,240
...هل

220
00:13:31,940 --> 00:13:40,210
هل نجحت في دوري كفارس لك يا آنستي؟

221
00:13:44,400 --> 00:13:45,600
.لن ينفعك هذا

222
00:13:45,600 --> 00:13:46,880
!على الإطلاق

223
00:13:47,630 --> 00:13:51,090
.انظر، أصبت بسهم أيضًا

224
00:13:51,090 --> 00:13:52,010
.لم تنجح

225
00:13:53,470 --> 00:13:56,450
.لكنّك... لم تُقصى أيضًا

226
00:13:56,450 --> 00:13:58,020
.واضح أنّك عملت بجدّ

227
00:13:58,540 --> 00:14:00,460
.سيكون عليك بذل جهد أكثر المرّة القادمة

228
00:14:02,700 --> 00:14:05,240
المرّة القادمة؟

229
00:14:05,690 --> 00:14:06,700
.نعم

230
00:14:08,730 --> 00:14:10,700
.كلاّ. لن تكون هناك مرّة قادمة

231
00:14:11,660 --> 00:14:14,140
.سيتفاقم وضع ذلك الجرح في بطنه

232
00:14:14,140 --> 00:14:19,170
.سيعاني هذا الرّجل الشّجاع من ميتة مؤلمة

233
00:14:28,310 --> 00:14:31,680
...كنتُ أحاول التّصرّف بحذر

234
00:14:32,210 --> 00:14:35,420
.وألاّ أجلب تكنولوجيا متقدّمة جدًّا إلى هنا

235
00:14:35,420 --> 00:14:38,750
.لكي لا تخرج حضارة هذا العالم عن السّيطرة

236
00:14:38,750 --> 00:14:42,010
،قد أكون قد بالغت في بعض الأحيان

237
00:14:42,010 --> 00:14:44,300
.ولكن هذا ما أوصلني إليه قراري

238
00:14:45,910 --> 00:14:49,940
.كدت أموت ولم أستطع حماية المقرّبين منّي

239
00:14:51,440 --> 00:14:52,700
!نلت كفايتي

240
00:14:52,700 --> 00:14:55,220
!اكتفيت من التّصرّف بحذر

241
00:14:55,220 --> 00:14:59,300
.سأعلّمهم ما معنى اليأس والخوف الحقيقيّين

242
00:14:59,840 --> 00:15:02,330
!سأضربهم بكلّ ما أملك

243
00:15:02,890 --> 00:15:06,460
.أيّها الماركيز أيبلينغر، أيّها المستشار ساهر

244
00:15:06,460 --> 00:15:08,420
.لديّ طلب أسأله منكما

245
00:15:09,260 --> 00:15:13,090
.بدءًا من الآن، امنعوا أيّ أحد من دخول الفناء

246
00:15:17,110 --> 00:15:21,020
عالِم أحياء؟ من جامعة هارفرد؟

247
00:15:21,020 --> 00:15:23,880
.أراد إلقاء نظرة على هذا الأرنب

248
00:15:24,890 --> 00:15:27,490
!أكلنا كلّ شيء

249
00:15:27,490 --> 00:15:30,030
لماذا لا تخبره أين دفنّا كلّ البقايا؟

250
00:15:30,030 --> 00:15:31,040
...مفهوم

251
00:15:33,240 --> 00:15:35,000
!ما... ما-ما... ماذا؟

252
00:15:35,000 --> 00:15:36,640
!ليس لديّ وقت للشّرح

253
00:15:36,640 --> 00:15:38,560
!يحتاج للعناية الطّبّيّة في الحال

254
00:15:40,520 --> 00:15:41,580
.باشر

255
00:15:44,040 --> 00:15:46,560
.سأتكفّل بأمره. مِن هنا

256
00:15:51,760 --> 00:15:53,010
.سيّد أليكسيس، كلّ شيء بخير

257
00:15:53,090 --> 00:15:56,390
.اتّبع أيّ إرشادات قد يقدّمها الطّبيب بالإشارة رجاءً

258
00:15:56,890 --> 00:15:59,640
...يا... آنستي

259
00:16:04,590 --> 00:16:06,110
ما تلك اللّغة؟

260
00:16:06,690 --> 00:16:09,570
.لنخرج. علينا أن نتكلّم

261
00:16:12,570 --> 00:16:14,030
!عالم مختلف؟

262
00:16:14,540 --> 00:16:19,370
شعارك هو "اتّصلوا بنا وسنوافيكم
"!في الحال حتّى لو كنتم في أقاصي الأرض

263
00:16:19,370 --> 00:16:20,750
هل أنا محقّة؟

264
00:16:21,090 --> 00:16:23,390
.إنّ ذلك يتجاوز أقاصي الأرض

265
00:16:23,390 --> 00:16:27,300
أريد تعيين جميع من لديك في شركة
.ناب الذّئب العسكريّة الخاصّة

266
00:16:27,300 --> 00:16:30,320
.تعداد العدوّ هو 20 ألفًا ويضّم وحوشًا

267
00:16:30,320 --> 00:16:31,610
وحوش؟

268
00:16:31,610 --> 00:16:33,070
.ساحة المعركة في العالم آخر

269
00:16:33,070 --> 00:16:34,130
...ما

270
00:16:34,130 --> 00:16:39,140
،ثمّة ضمانة بأربعين ألف ذهبيّة على الأقلّ
.إضافة لتعويض إضافي حسب الوضع

271
00:16:39,810 --> 00:16:43,250
.إنّ هذا... هو ما أصفه بالعمل المُكسِب

272
00:16:44,430 --> 00:16:46,060
ستقبل بعرضي إذًا؟

273
00:16:46,790 --> 00:16:47,780
.لا أستطيع

274
00:16:47,780 --> 00:16:48,570
ماذا؟

275
00:16:48,570 --> 00:16:53,570
لا أستطيع تصديق كلّ هذا الكلام
.عن عالم آخر بهذه السّهولة

276
00:16:53,570 --> 00:16:55,700
.نحن محترفون وجادّون في عملنا

277
00:17:09,190 --> 00:17:10,500
!مهلاً، مهلاً، مهلاً

278
00:17:16,180 --> 00:17:17,930
!لا يمكنك رؤية أيّ شيء؟

279
00:17:19,760 --> 00:17:21,020
!أيّها النّقيب

280
00:17:21,850 --> 00:17:22,810
!توقّف

281
00:17:29,110 --> 00:17:30,600
!سلّمني البندقيّة

282
00:17:31,460 --> 00:17:35,350
هكذا إذًا، السّرعة القصوى في
...المستوى ل 27 ميلاً في السّاعة

283
00:17:35,350 --> 00:17:37,410
كم تساوي 27 ميل بالكيلومتر؟

284
00:17:37,410 --> 00:17:40,120
.في كلّ الأحوال، يفسّر هذا لماذا هذا الشّيء بطيء

285
00:17:40,120 --> 00:17:43,080
!مهلاً، لا يمكنك قيادتها بهذه السّهولة

286
00:17:48,330 --> 00:17:51,040
!ما هذا؟

287
00:17:51,870 --> 00:17:53,330
أين نحن؟

288
00:17:53,330 --> 00:17:55,650
...هذا... لا يٌعقل

289
00:17:55,650 --> 00:17:56,910
.كلّ هذا حقيقيّ

290
00:17:57,660 --> 00:18:00,260
.لن تستيقظ حتّى إن قرصت خدّيك

291
00:18:07,810 --> 00:18:10,810
.لا يبدو هذا كخدعة

292
00:18:10,810 --> 00:18:12,940
هل تفهم الآن؟

293
00:18:12,940 --> 00:18:15,820
.لم أكن أكذب أو أختلق الأمور من قبل

294
00:18:17,410 --> 00:18:18,650
...نعم

295
00:18:20,020 --> 00:18:21,950
!ما هذا هناك؟

296
00:18:23,580 --> 00:18:26,630
.الأيائل... في حالة هيجان

297
00:18:27,290 --> 00:18:29,040
هل يحدث شيء ما هناك؟

298
00:18:29,040 --> 00:18:32,370
.ذلك ما يبدو. لنستطلع الوضع

299
00:18:32,370 --> 00:18:33,340
.عُلم

300
00:18:33,340 --> 00:18:35,640
.أعجبني ذلك يا آنسة

301
00:18:48,730 --> 00:18:51,800
.نفق... سيكون ضيّقًا

302
00:18:51,800 --> 00:18:52,940
.لنكمل سيرًا

303
00:19:07,910 --> 00:19:09,250
هل أنتم لاجئون؟

304
00:19:10,670 --> 00:19:11,800
!وحش

305
00:19:11,800 --> 00:19:12,960
من تصف بالوحش؟

306
00:19:12,960 --> 00:19:15,960
!كلاّ! إنّ الغوبلين تلاحقنا

307
00:19:16,440 --> 00:19:17,110
!ماذا؟

308
00:19:17,110 --> 00:19:20,930
!لقد هاجمت عربتنا الخلفيّة وأكلت أحصنتنا

309
00:19:20,930 --> 00:19:23,300
!ستهاجم الأطفال الآن إن لم نهرب بسرعة

310
00:19:24,980 --> 00:19:26,840
هل هناك أطفال في العربات الأخرى أيضًا؟

311
00:19:26,840 --> 00:19:28,850
!نعم! ثمّة الكثير منها

312
00:19:29,230 --> 00:19:31,130
مهلاً، ماذا يحدث؟

313
00:19:31,130 --> 00:19:32,900
!هاجمتهم الوحوش

314
00:19:32,900 --> 00:19:35,380
!ستأكل الأطفال إن لم نساعدهم

315
00:19:36,290 --> 00:19:38,940
.هذا وضع سيّئ

316
00:19:39,500 --> 00:19:42,100
.إخلاء الطّريق له الأولويّة في كلّ الأحوال

317
00:19:42,940 --> 00:19:44,880
.سأذهب لأطمئنّ عليهم في الخلف

318
00:19:48,770 --> 00:19:50,810
.بمجرّد خروجهم من النّفق، سيجدون نهرًا

319
00:19:51,510 --> 00:19:53,580
.سيأخذ عبوره وقتًا

320
00:19:54,310 --> 00:19:58,380
أأنتقل بين العالمين؟ لكنّ القافلة
...طويلة لأنقذ الجميع

321
00:19:58,380 --> 00:20:00,110
.الوضع خطير

322
00:20:00,780 --> 00:20:04,700
...لكنّنا أنا والنّقيب لا نستطيع الهرب وحدنا

323
00:20:05,390 --> 00:20:08,840
.ستعبر الغوبلين النّفق وتهاجم القافلة

324
00:20:10,440 --> 00:20:12,730
!عليّ حماية هؤلاء الأطفال

325
00:20:12,730 --> 00:20:14,230
!هناك! إنّهم هناك

326
00:20:27,930 --> 00:20:29,200
!حسنًا! إنّهم يتحرّكون

327
00:20:35,650 --> 00:20:37,340
!وصلت الغوبلين

328
00:20:37,340 --> 00:20:39,700
هل يستطيعون عبور النّهر جميعًا في الوقت المناسب؟

329
00:20:39,700 --> 00:20:41,440
.إنّ الوقت يداهمهم

330
00:20:43,400 --> 00:20:44,590
!هذه هي الغوبلين إذًا

331
00:20:47,910 --> 00:20:48,850
ماذا؟

332
00:20:57,900 --> 00:20:59,970
.فاض النّهر بسبب الأمطار

333
00:21:00,760 --> 00:21:02,740
...سيعلقون هنا لبعض الوقت

334
00:21:09,490 --> 00:21:11,340
.أريد تعيينك

335
00:21:11,340 --> 00:21:13,250
.مهمّتك هي حماية القافلة

336
00:21:14,800 --> 00:21:17,570
.سأقبل بذلك العرض

337
00:21:17,570 --> 00:21:20,050
.عليّ توفير وقت قدر المستطاع

338
00:21:25,350 --> 00:21:27,210
.اسمعي. اجلبي انتباهها

339
00:21:27,210 --> 00:21:28,160
.عُلم

340
00:21:31,340 --> 00:21:32,350
!أطلقي

341
00:21:38,060 --> 00:21:39,540
!مستحيل

342
00:21:39,540 --> 00:21:41,180
!هذا سيّئ. لنتراجع

343
00:21:42,070 --> 00:21:43,400
!ماذا يحدث؟

344
00:21:43,850 --> 00:21:45,650
!إنّها لا تفهم أنّها قد تعرّض لطلق ناريّ

345
00:21:45,650 --> 00:21:47,520
!ماذا؟! كيف يعقل ذلك؟

346
00:21:49,680 --> 00:21:52,280
...ماذا نفعل؟ كيف يمكننا أن