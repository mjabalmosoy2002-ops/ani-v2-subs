1
00:00:01,000 --> 00:00:04,000
BAM25

2
00:00:01,000 --> 00:00:04,000
RiseKuN

3
00:00:08,290 --> 00:00:10,030
سنذهب يا نفريتيس

4
00:00:10,030 --> 00:00:11,610
انتظروني

5
00:00:13,010 --> 00:00:15,860
،سمعتُ أن هذا المكان يقع في أقاصي العالم

6
00:00:15,860 --> 00:00:17,880
ولكنّه مكان مفعم بالحياة

7
00:00:17,880 --> 00:00:19,880
أرض الماء ماسا هذه

8
00:00:19,880 --> 00:00:23,960
بالرغم من أنّها بعيدة، إلا أنَّ هذه أكبر مدنها

9
00:00:23,960 --> 00:00:26,350
بالمناسبة، أين مارس-سان؟

10
00:00:26,930 --> 00:00:29,220
يبدو أن لديه بعض الأمور الأخرى

11
00:00:29,220 --> 00:00:31,090
سبقنا إلى الأمام

12
00:00:31,090 --> 00:00:32,420
هكذا إذن

13
00:00:32,750 --> 00:00:35,290
يبدو أنّه كان يرغب في الذهاب إلى أرض الماء حقًّا

14
00:00:35,290 --> 00:00:37,320
أعتقد أنّه لا بدَّ من سبب لذلك

15
00:00:40,810 --> 00:00:41,800
المعذرة

16
00:00:45,460 --> 00:00:49,270
أنتَ ملك الخاتم، صحيح؟

17
00:00:49,520 --> 00:00:50,890
...صحيح

18
00:00:50,890 --> 00:00:52,650
هذا مذهل

19
00:00:53,240 --> 00:00:54,900
أنا معجبة كبيرة بكَ

20
00:00:54,900 --> 00:00:57,520
أنتِ تحرجيني

21
00:00:57,520 --> 00:00:59,420
إنّه مشهور حقًّا

22
00:00:59,420 --> 00:01:01,240
كما هو متوقع من زوجي

23
00:01:01,240 --> 00:01:03,580
صحيح، تفضل هذه الزهور من فضلك

24
00:01:04,540 --> 00:01:06,520
وهذه كذلك

25
00:01:30,060 --> 00:01:32,530
،لقد سُمِعتُ الشائعات

26
00:01:33,770 --> 00:01:38,040
ولكنكَ بالفعل أحمق كبير قليل الحذر يا ملك الخاتم

27
00:01:39,890 --> 00:01:42,110
أنا سافير ماسا

28
00:01:43,140 --> 00:01:45,320
عذراء خاتم الماء

29
00:01:46,090 --> 00:01:50,250
وجعلتكَ للتو زوجي

30
00:01:51,100 --> 00:01:52,970
هل يُسمح بهذا حتّى؟

31
00:01:52,970 --> 00:01:54,140
أجل

32
00:03:25,500 --> 00:03:28,970
،ممتنون لتعاونكِ السريع معنا

33
00:03:28,970 --> 00:03:30,890
يا عذراء خاتم الماء

34
00:03:30,890 --> 00:03:33,010
هذا لا شيء

35
00:03:33,010 --> 00:03:36,040
أرى أنّكَ لَم تتأثر أيّها الحكيم العظيم

36
00:03:36,040 --> 00:03:37,190
...هذا يترك

37
00:03:41,440 --> 00:03:44,820
حسنٌ، يمكنكنَّ فعلُ ما تشأْنَ أيّتها الأميرات

38
00:03:44,820 --> 00:03:47,830
أشك في أنّنا سنشكل أيّ علاقة على أيّ حال

39
00:03:48,630 --> 00:03:50,040
والآن يا ملك الخاتم

40
00:03:50,390 --> 00:03:52,820
،بما أنّي جعلتكَ زوجي

41
00:03:52,820 --> 00:03:56,180
هذا يعني أنّكَ صرتَ ملك أرض الماء كذلك

42
00:03:56,180 --> 00:03:57,880
هل يسير الأمر على هذا النحو حقًّا؟

43
00:03:58,130 --> 00:04:01,070
لديكَ واجب حكم هذه الأرض بسلام

44
00:04:01,420 --> 00:04:03,340
هل أنتَ مستعد لذلك؟

45
00:04:03,620 --> 00:04:05,180
أ-أجل

46
00:04:05,490 --> 00:04:07,140
اتبعني إذن

47
00:04:07,140 --> 00:04:11,560
حان وقت استخدامكَ لقوتكَ من أجلي

48
00:04:11,560 --> 00:04:15,020
تجعلين الأمر يبدو واضحًا، ولكن ما الّذي يحدث تحديدًا؟

49
00:04:16,420 --> 00:04:19,110
إن لَم نفعل شيئًا، فستهلك هذه الأمة

50
00:04:22,550 --> 00:04:25,950
إذن فقد كنتِ هنا أيّتها الأميرة سافير

51
00:04:28,100 --> 00:04:30,230
عودي إلى القصر من فضلك

52
00:04:31,540 --> 00:04:33,770
هذا الرجل هنا هو ملك الخاتم

53
00:04:33,770 --> 00:04:36,030
،تزوجته للتو قبل لحظات

54
00:04:36,030 --> 00:04:38,590
وأعطيته خاتم الماء الخاص بماسا

55
00:04:38,840 --> 00:04:41,300
هذا لا يسبب لكَ أيّ مشكلة، صحيح؟

56
00:04:42,330 --> 00:04:43,930
سمعًا وطاعة

57
00:04:43,930 --> 00:04:46,220
في الوقت الحالي، أرغب منكم جميعًا القدوم إلى القصر

58
00:04:50,720 --> 00:04:52,930
إنّه ضخم

59
00:04:53,230 --> 00:04:56,200
الشلال العظيم، إيويوماسا

60
00:04:56,200 --> 00:05:00,430
إنّه رمز مارثا، أرض الماء

61
00:05:01,400 --> 00:05:05,400
وراء هذا الشلال تقع الأرض القديمة

62
00:05:05,400 --> 00:05:09,890
وكذلك المملكة المظلمة حيث يُزعم أن ملك الهاوية يكمن فيها

63
00:05:11,670 --> 00:05:12,870
انظروا

64
00:05:13,560 --> 00:05:17,380
تمتلئ شوارع المدينة بجنود الإمبراطورية

65
00:05:17,380 --> 00:05:19,790
لَم يعد لقوات ماسا أيّ وجود

66
00:05:19,790 --> 00:05:21,760
...الإمبراطورية

67
00:05:21,760 --> 00:05:23,210
أليست بلد مارس-سان؟

68
00:05:23,210 --> 00:05:25,280
من الجيد أنّكَ تتذكر

69
00:05:25,280 --> 00:05:27,130
أتذكر ذلك على الأقل

70
00:05:27,380 --> 00:05:30,840
،تُعدُّ إمبراطورية جيساراس أكبر أمة للبشر

71
00:05:30,840 --> 00:05:34,600
وتستمر في التوسع من خلال تكوين علاقات مع العديد من الدول الأخرى

72
00:05:34,600 --> 00:05:37,460
...إذن ذلك الرجل الّذي رأيناه سابقًا هو

73
00:05:37,460 --> 00:05:41,380
الأمير الأول لجيساراس وشقيق مارس الكبير

74
00:05:42,660 --> 00:05:46,200
الجنرال الّذي لَم يهزم، سلودر جيساراس

75
00:05:46,200 --> 00:05:50,350
ذلك الرجل هو الّذي يجعل أوامر الإمبراطور تتحقق

76
00:05:50,350 --> 00:05:53,480
،وفي حين تم تجنب أمم الخواتم

77
00:05:53,480 --> 00:05:57,000
أظهر قدرته على ضم العديد من الدول الأخرى

78
00:05:57,260 --> 00:06:00,880
هل هذا يعني... أن الإمبراطورية أمة سيئة؟

79
00:06:00,880 --> 00:06:02,650
ليس هناك داعي للسؤال

80
00:06:03,350 --> 00:06:05,860
إنّها قوة احتلال

81
00:06:05,860 --> 00:06:09,930
حمايتنا من وحوش الهاوية مجرد عذر لذلك

82
00:06:10,210 --> 00:06:12,990
،بالتأكيد سيرى بعض الناس الأمر بهذه الطريقة

83
00:06:12,990 --> 00:06:15,420
ولكن هل صحيحٌ أنّهم يجمعون الناس من أجل التصدي

84
00:06:15,440 --> 00:06:19,060
لإعادة إحياء ملك الهاوية؟

85
00:06:19,340 --> 00:06:21,570
تملكين معرفة على غير المتوقع

86
00:06:21,570 --> 00:06:22,940
هل أدهشتكَ؟

87
00:06:22,940 --> 00:06:25,410
حيوانة وضيعة تتصرف وكأنّها تعلم أيّ شيء

88
00:06:26,290 --> 00:06:28,110
أيّتها اللعينة

89
00:06:28,110 --> 00:06:31,830
أتريدني أن أطحنك وأحرقك مع نعناع القطط!؟

90
00:06:35,630 --> 00:06:37,960
إذن هذا هو القصر

91
00:06:42,960 --> 00:06:44,040
ما هذا؟

92
00:06:44,320 --> 00:06:46,280
إنّه هجوم وحش

93
00:06:46,280 --> 00:06:48,380
كانت تنبؤات تلك المرأة صحيحة مجددًا إذن

94
00:06:48,640 --> 00:06:50,120
هل كلُّ شيء على ما يرام؟

95
00:06:50,120 --> 00:06:53,220
هذا سبب وجود الجيش الإمبراطوري هنا

96
00:06:54,760 --> 00:06:56,100
احذر يا ساتو

97
00:07:03,400 --> 00:07:04,460
مُحال

98
00:07:04,460 --> 00:07:05,900
كيف يمكن أن يظهر هنا؟

99
00:07:08,190 --> 00:07:09,280
ملك الخاتم

100
00:07:24,430 --> 00:07:26,250
هذا كان وشيكًا

101
00:07:28,870 --> 00:07:31,050
إذن هذه هي قوة الخواتم؟

102
00:07:31,430 --> 00:07:33,470
يسعدني أنّكَ بخير

103
00:07:32,090 --> 00:07:35,440
...ملك الخاتم ساتو... ربّما يمكنه

104
00:07:33,470 --> 00:07:34,890
أجل، نوعًا ما

105
00:07:35,440 --> 00:07:37,140
كما هو متوقع من زوجي

106
00:07:40,170 --> 00:07:43,490
إذن لَم تكن الأساطير مجرد حكايات خرافية في النهاية

107
00:07:48,020 --> 00:07:51,320
هل هذا الرجل هو ملك الخاتم؟

108
00:07:51,570 --> 00:07:53,090
صحيح يا أبتي

109
00:07:53,090 --> 00:07:55,300
إنّه زوجي

110
00:07:55,300 --> 00:07:58,100
منحته خاتم الماء

111
00:07:58,100 --> 00:07:58,790
مهلًا

112
00:07:59,130 --> 00:08:01,150
أعلم أنّكَ اعتقدتَ أنّكَ تستطيع

113
00:08:01,150 --> 00:08:04,170
،احتجازي في القصر لتمنعني من تسليم الخاتم

114
00:08:04,680 --> 00:08:08,250
ولكن يبدو أن جميع مخططاتكَ قد أُفشلت

115
00:08:08,250 --> 00:08:09,670
أتقولين احتجازك؟

116
00:08:10,030 --> 00:08:12,880
حسنٌ، أتساءل عن ما تعنيه بذلك

117
00:08:14,070 --> 00:08:15,350
أيّتها الماكرة

118
00:08:16,090 --> 00:08:19,480
جيش من الوحوش يقترب بالفعل

119
00:08:19,940 --> 00:08:22,140
من فضلك، توقفي عن التصرف بمفردكِ

120
00:08:22,460 --> 00:08:26,840
ولكن سيكون هذا أمرًا مزعجًا للغاية، صحيح؟

121
00:08:29,340 --> 00:08:33,950
أعطت الخاتم لملك الخاتم تمامًا كما توقعتِ أنّها ستفعل

122
00:08:34,370 --> 00:08:39,390
هل ذلك يعني أن الكارثة الكبرى ستحلّ بأمتنا إذن؟

123
00:08:40,040 --> 00:08:41,660
ملك الخاتم

124
00:08:41,660 --> 00:08:44,250
لو أنّكَ لَم تأتي إلى هنا أبدًا

125
00:08:44,250 --> 00:08:46,220
أنا؟

126
00:08:54,540 --> 00:08:58,260
يا إلهي، أكثر من ذلك وستتعرض صحتكَ للخطر

127
00:08:58,260 --> 00:09:00,530
سأخذكَ لترتاح قليلًا

128
00:09:00,530 --> 00:09:02,790
ملك الخاتم

129
00:09:04,520 --> 00:09:08,020
هل كانت المرأة المريبة تلك والدتكِ يا سافير؟

130
00:09:08,020 --> 00:09:09,570
بالطبع لا

131
00:09:09,970 --> 00:09:12,540
تلك المرأة هي عرافة القصر

132
00:09:13,080 --> 00:09:16,890
،في وقت ما، أصبح والدي يعتمد عليها بشكلٍ كامل

133
00:09:16,890 --> 00:09:18,350
وأصبح حاله هكذا الآن

134
00:09:19,000 --> 00:09:22,110
في الماضي، كان والدي يُبجل كملك حكيم كذلك

135
00:09:27,400 --> 00:09:28,750
أختي الكبرى

136
00:09:28,750 --> 00:09:29,960
لمَ؟

137
00:09:30,870 --> 00:09:36,550
خلتُ أنّنا قطعنا وعدًا لتحديد من ستؤدي واجب أميرة الخاتم، أليس كذلك؟

138
00:09:36,850 --> 00:09:38,040
أعتذر

139
00:09:38,040 --> 00:09:39,510
قررتُ ذلك عنا

140
00:09:40,190 --> 00:09:41,420
مُحال

141
00:09:43,780 --> 00:09:46,130
...إن كانت تناديكَ بأختي، إذن هذا

142
00:09:46,130 --> 00:09:50,900
أجل، هذه أختي التوأم الصغرى، سافيرا

143
00:09:51,170 --> 00:09:53,250
هل أنتما أميرتان توأم؟

144
00:09:54,580 --> 00:09:57,260
لمَ يا أختي؟

145
00:09:58,090 --> 00:10:01,580
كيف أمكنكِ الزواج من رجل بمظهرٍ عادي للغاية؟

146
00:10:03,500 --> 00:10:08,000
كان باستطاعتكِ الارتباط برجل أكثر شهامة

147
00:10:09,140 --> 00:10:11,290
أيُعقل أنّكِ فعلتِ ذلك من أجل حمايتي؟

148
00:10:11,630 --> 00:10:12,780
يا للقسوة

149
00:10:12,780 --> 00:10:15,800
القدر أمرٌ قاسٍ حقًّا

150
00:10:15,800 --> 00:10:17,970
أرجو أن تعذريني يا سافيرا-دونو

151
00:10:18,330 --> 00:10:22,100
ساتو هو الرجل الّذي هزمني، أنا أميرة النار

152
00:10:23,570 --> 00:10:28,250
...صحيح أنّه لا يبدو موثوقًا كمحارب، ولكن ما يزالُ

153
00:10:28,250 --> 00:10:30,190
أعتقدتُ أنّكِ تحاولين مساعدتي

154
00:10:30,190 --> 00:10:31,790
...عفوًا

155
00:10:31,790 --> 00:10:35,410
،كجنية، لا أفهم معنى الجمال عند البشر حقًّا

156
00:10:35,410 --> 00:10:37,110
...لذلك لا أستطيع التعليق

157
00:10:37,360 --> 00:10:39,230
حتّى أنتِ يا نفريتيس

158
00:10:39,230 --> 00:10:42,490
...ساتو

159
00:10:42,900 --> 00:10:45,210
ساتو رائع للغاية

160
00:10:45,210 --> 00:10:46,910
شكرًا لكِ يا هيمي

161
00:10:48,180 --> 00:10:49,150
...على أيّ حال

162
00:10:49,150 --> 00:10:50,370
إنّها لا تنصت

163
00:10:50,370 --> 00:10:54,010
ليس عليكِ الآن الزواج من ملك الخاتم يا سافيرا

164
00:10:55,470 --> 00:10:57,800
لذا لا داعي لتقلقي بشأن أيّ شيء

165
00:10:58,170 --> 00:10:59,630
...أختي

166
00:11:02,420 --> 00:11:03,600
أيّتها الأميرة سافيرا

167
00:11:09,730 --> 00:11:11,680
ماذا؟ ماذا؟

168
00:11:11,680 --> 00:11:13,610
الأجواء هنا متوترة بشكلٍ مريب

169
00:11:13,610 --> 00:11:17,730
،أعلم أن كلَّ ما أقوله قد يبدو كعذر بعد كل ما حدث

170
00:11:19,540 --> 00:11:22,230
لكنّي لَم أنسى وعدي لكِ

171
00:11:25,030 --> 00:11:26,790
...لا أرغب حتّى

172
00:11:27,470 --> 00:11:29,550
في سماع صوتكَ بعد الآن

173
00:11:31,610 --> 00:11:32,820
أيّتها الأميرة سافيرا

174
00:11:35,010 --> 00:11:38,620
ما زلتَ عديم الفائدة كما كان حالكَ دائمًا يا مارس

175
00:11:43,130 --> 00:11:47,880
...رغب مارس-سان في القدوم إلى هذه الأرض بشدة، ولكن هل هذا

176
00:11:48,300 --> 00:11:52,730
أقسم ذلك الرجل وسافيرا بحبهما لبعضهما البعض

177
00:11:54,350 --> 00:11:56,790
ألم يخبركَ شيئًا عن ذلك؟

178
00:11:57,220 --> 00:12:00,190
هذا يبدو كفعلٍ من أفعال ذلك الرجل تمامًا

179
00:12:01,140 --> 00:12:03,410
سأخبركَ عن ذلك إذن

180
00:12:03,790 --> 00:12:05,690
...سأخبركَ بكلِ

181
00:12:05,690 --> 00:12:09,660
ما يخص علاقة أرضنا ماسا بإمبراطوريته جيساراس

182
00:12:13,350 --> 00:12:18,740
منذ زمن بعيد، لَم تكن إمبراطورية جيساراس راضية
عن الأراضي البشرية الّتي كانت تملكها

183
00:12:18,740 --> 00:12:23,790
لذلك قاموا بغزو أرض الماء ماسا

184
00:12:25,050 --> 00:12:27,170
،ومع ذلك، لم يكن سوى اشتباك بسيط للغاية

185
00:12:27,170 --> 00:12:29,870
،وبمجرد أن أدركت الإمبراطورية أنّها لا تستطيع التأثير علينا

186
00:12:29,870 --> 00:12:32,870
لجأوا إلى الدبلوماسية

187
00:12:34,170 --> 00:12:37,780
أنا أمير إمبراطورية جيساراس الثاني، مارماروغياس جيساراس

188
00:12:38,390 --> 00:12:40,950
،رغبتي هي التعلم من حكمة وتاريخ ماسا

189
00:12:40,950 --> 00:12:44,410
وأن أساهم في تعزيز الصداقة بين أمتينا

190
00:12:51,530 --> 00:12:55,460
لَم يستغرق الأمر وقتًا طويلًا حتّى أصبحا مقريبين من بعضهما البعض

191
00:12:59,550 --> 00:13:02,030
وكانت مشاعرهما تجاه بعضهما البعض حقيقية وصادقة

192
00:13:02,470 --> 00:13:04,550
أو هذا ما بدا لي على الأقل

193
00:13:04,940 --> 00:13:08,710
حتّى لو كان مارس قد كلف بمهمة سرية

194
00:13:09,880 --> 00:13:12,270
خذني بعيدًا من هنا رجاءً

195
00:13:12,860 --> 00:13:14,430
كانت مهمة مارس

196
00:13:14,430 --> 00:13:18,830
هي إبلاغ الإمبراطورية عن ما يحدث داخليًا في ماسا

197
00:13:18,830 --> 00:13:20,440
أريد منكِ انتظاري حاليًا

198
00:13:21,700 --> 00:13:24,490
ومع ذلك، لم يفعل ذلك أبدًا

199
00:13:25,060 --> 00:13:27,490
أعدكِ بأنّي سأعود من أجلكِ يومًا ما

200
00:13:27,800 --> 00:13:30,120
،مارس-ساما

201
00:13:30,120 --> 00:13:31,870
أثق بك

202
00:13:33,420 --> 00:13:37,870
ومع ذلك، لَم تكن الإمبراطورية لتتجاهل إهماله لمهمته

203
00:13:38,160 --> 00:13:40,770
،أُستدعيَّ مارس للعودة إلى الإمبراطورية

204
00:13:40,770 --> 00:13:43,460
...وبعد عدة شهور

205
00:13:44,120 --> 00:13:47,780
سأصبح ملك الخاتم بأمر من الإمبراطور

206
00:13:48,340 --> 00:13:51,400
وبهذا سأتمكن أخيرًا من العودة من أجلكِ

207
00:13:54,300 --> 00:13:57,730
،حتّى لو كان واجبنا نحو ملك الخاتم مجرد سبب مفتعل للزواج

208
00:13:57,730 --> 00:14:00,650
إلا أنّه سيسمح لها بالزواج من الشخص الّذي تحبه

209
00:14:01,100 --> 00:14:04,780
،ولدت كلتانا لنكون أميرتي خاتم

210
00:14:04,780 --> 00:14:09,180
لذلك كانت تلك ضربة حظ لَم يكن ليُسمحَ لنا الحُلم بها حتّى

211
00:14:10,850 --> 00:14:11,620
...ولكن

212
00:14:12,310 --> 00:14:15,330
تخلى الأمير مارس عن واجبه في أن يصبح ملك الخاتم

213
00:14:17,670 --> 00:14:22,780
ترك الخواتم لرجل غير معروف ظهر من عالم آخر

214
00:14:23,510 --> 00:14:24,710
...إنّه

215
00:14:25,150 --> 00:14:27,710
تخلى عن وعده لسافيرا

216
00:14:29,810 --> 00:14:31,010
أيّتها الأميرة سافيرا

217
00:14:31,320 --> 00:14:33,050
أرجوكِ، استمع لي مرة أخرى فحسب

218
00:14:33,300 --> 00:14:36,520
لَم تتغير مشاعري أبدًا منذ ذلك اليوم

219
00:14:36,520 --> 00:14:38,840
ما زال قلبي معكِ كما هو

220
00:14:40,310 --> 00:14:41,860
إذن لمَ؟

221
00:14:42,680 --> 00:14:45,900
لمَ لَم تصبح ملك الخاتم؟

222
00:14:49,130 --> 00:14:50,220
...هذا لأنّي

223
00:14:50,990 --> 00:14:51,960
...شعرتُ

224
00:14:53,570 --> 00:14:55,880
أنّي لستُ مناسبًا لذلك

225
00:14:57,530 --> 00:15:02,170
لم أعد أعرف عمّا يدور في ذهنك بعد الآن

226
00:15:10,710 --> 00:15:12,720
...وبعد ذلك بوقتٍ قصير

227
00:15:12,720 --> 00:15:15,310
ظهرت تلك العرافة

228
00:15:16,210 --> 00:15:18,990
لَم يصدقها أحد في البداية

229
00:15:19,490 --> 00:15:23,800
حتّى بدأت تنبؤاتها تتحقق بالفعل

230
00:15:24,810 --> 00:15:28,900
أثبتت تنبؤات تلك العرافة جدواها في صدِّ الوحوش

231
00:15:29,390 --> 00:15:32,740
...لذلك جعلها أبي بجانبه

232
00:15:33,090 --> 00:15:35,820
وأصبح على حاله ذاك الّذي رأيته

233
00:15:36,580 --> 00:15:39,910
هل تعتقدين أن تلك العرافة أُرسلت من قبل الإمبراطورية؟

234
00:15:40,220 --> 00:15:42,350
لا بدَّ وأن يكون هناك صلة بذلك

235
00:15:42,790 --> 00:15:44,820
،هذا ما أعتقده

236
00:15:44,820 --> 00:15:48,140
ولهذا السبب تحديدًا أرغب في الإمساك بتلك الماكرة متلبسةً

237
00:15:50,700 --> 00:15:52,270
سافير اللعينة

238
00:15:52,270 --> 00:15:53,720
تمكنت منّي هذه المرة

239
00:15:55,210 --> 00:15:57,810
اذهبوا لاغتيال ملك الخاتم وسرقة الخواتم

240
00:15:58,450 --> 00:16:01,160
هذا كله من أجل حاكمنا العظيم

241
00:16:01,160 --> 00:16:01,870
حسنٌ

242
00:16:13,710 --> 00:16:15,260
أشعر بالغيرة

243
00:16:15,260 --> 00:16:16,990
لا، ألا يشعر بالخجل؟

244
00:16:17,290 --> 00:16:18,210
...مهلًا، انتظر

245
00:16:18,210 --> 00:16:19,700
أليست إحداهن غير موجودة؟

246
00:16:19,790 --> 00:16:21,090
تلك القطة؟

247
00:16:23,870 --> 00:16:26,770
أتيتم حقًّا لمهاجمته وهو نائم

248
00:16:26,770 --> 00:16:29,380
أميرة الماء تلك ذكية للغاية

249
00:16:30,060 --> 00:16:31,330
لا يملكون قرون؟

250
00:16:31,880 --> 00:16:33,240
هل هم مجرد بشر عاديين؟

251
00:16:43,000 --> 00:16:45,450
أيعني هذا أنّهم يخدمون الإمبراطورية حقًّا؟

252
00:16:47,820 --> 00:16:49,360
مغتالين؟

253
00:16:49,360 --> 00:16:50,180
أجل

254
00:16:50,530 --> 00:16:53,450
أولئكَ الأشخاص موجودون حقًّا

255
00:17:08,940 --> 00:17:11,990
بالمناسبة، إلى أين نذهب؟

256
00:17:11,990 --> 00:17:13,570
إلى منطقة التشمس

257
00:17:17,530 --> 00:17:20,720
،يعاني أشباه التنانين صعوبات في تنظيم درجة حرارة جسدهم

258
00:17:20,720 --> 00:17:24,560
وحين تنخفض درجة حرارته إلى مستوى منخفض، يتسبب ذلك في بطء حركتهم

259
00:17:25,000 --> 00:17:26,680
...فهمت

260
00:17:26,680 --> 00:17:30,570
لذلك يذهبون للتشمس بعد الاستيقاظ من النوم لتسخين أجسادهم

261
00:17:31,290 --> 00:17:33,810
،وإن أصبح جسدهم ساخنًا للغاية

262
00:17:33,810 --> 00:17:35,510
يبردونه باستخدام الماء

263
00:17:36,530 --> 00:17:39,110
ألن تذهبي للعب مع الآخريات؟

264
00:17:39,110 --> 00:17:40,490
أنا بخير

265
00:17:41,240 --> 00:17:42,580
...الأهم من ذلك

266
00:17:43,190 --> 00:17:46,290
،أعلم أنّي قلتُ أنّكَ لا تعتبر موثوقًا كمحارب

267
00:17:46,290 --> 00:17:48,090
...ولكن جسدكَ

268
00:17:48,090 --> 00:17:51,540
يشعرني بالرغبة في الشروع في إنجاب أطفال معكَ يا ساتو

269
00:17:51,950 --> 00:17:54,330
ما رأيكَ في بعض الوقت هذه الليلة؟

270
00:17:54,330 --> 00:17:57,300
مهلًا، هناك ترتيب لذلك

271
00:17:57,300 --> 00:18:00,190
أليس هذا ما تقوله الأميرة كريستال؟

272
00:18:00,190 --> 00:18:02,260
أنتِ، ما الّذي تفعلينه هناك؟

273
00:18:02,530 --> 00:18:04,890
أنا الأولى حسب الترتيب، مفهوم؟

274
00:18:04,890 --> 00:18:07,970
إن كان كل ما تفعلينه هو الانتظار، فحبكِ ضعيف

275
00:18:07,970 --> 00:18:10,900
وحبي لساتو قوي

276
00:18:14,180 --> 00:18:16,820
لا أهتم بذلك، لعلمك

277
00:18:17,650 --> 00:18:18,830
مهلًا

278
00:18:19,890 --> 00:18:22,870
جميعكنَّ غبيات

279
00:18:24,620 --> 00:18:28,760
سـ-سافير، ما نوع ملابس السباحة هذه؟

280
00:18:28,760 --> 00:18:30,930
هذه حديقتي

281
00:18:30,930 --> 00:18:34,300
أستمتع بذلك عارية في الغالب، لكن ارتديتُ هذا من أجلك

282
00:18:34,800 --> 00:18:36,960
...بوضع ذلك جانبًا، يا فتيات

283
00:18:36,960 --> 00:18:39,250
،إن كنتنَّ قلقات بشأن الترتيب

284
00:18:39,250 --> 00:18:41,780
إذن لمَ لا تقررنَّ ذلك عن طريق مسابقة؟

285
00:18:41,780 --> 00:18:42,880
،على سبيل المثال

286
00:18:42,880 --> 00:18:46,390
ما رأيكنَّ أن تكون أسرع من تسبح إلى هناك هيّ الفائزة؟

287
00:18:46,700 --> 00:18:47,980
ماذا؟

288
00:18:50,220 --> 00:18:52,650
أيُعقل أنّكِ تكرهين الماء؟

289
00:18:55,110 --> 00:18:57,660
خذي، خذي، خذي

290
00:18:55,880 --> 00:18:58,320
جميعهنَّ غبيات بحق

291
00:18:57,660 --> 00:18:58,880
توقفي

292
00:18:58,740 --> 00:19:01,180
عذرًا... ماذا عنّي؟

293
00:18:58,880 --> 00:19:01,060
أكره أن يدخل الماء فيها

294
00:19:02,030 --> 00:19:04,080
،بالمناسبة يا ساتو

295
00:19:04,080 --> 00:19:07,250
لَم تستسلم تلك العرافة بعد

296
00:19:07,670 --> 00:19:09,980
تذكر أن تكون حذرًا

297
00:19:09,980 --> 00:19:12,460
حتّى أثناء تظاهركَ بإرخاء حذركَ

298
00:19:12,460 --> 00:19:15,010
أتظاهر؟

299
00:19:15,010 --> 00:19:19,210
لا تفوت فرصة الإمساك بها متلبسةً

300
00:19:28,060 --> 00:19:29,170
مارس-سان

301
00:19:30,790 --> 00:19:33,650
يبدو أنّكَ تمر بالكثير

302
00:19:33,650 --> 00:19:34,700
وأنتَ كذلك

303
00:19:36,440 --> 00:19:41,030
أتحمل نصف مسؤولية حال ماسا هذا

304
00:19:41,820 --> 00:19:43,490
أشعر بالأسف بشأن ذلك

305
00:19:45,960 --> 00:19:50,090
لمَ سمحتَ لي بأخذ دور ملك الخاتم؟

306
00:19:50,600 --> 00:19:51,670
...إن لَم تفعل

307
00:19:52,070 --> 00:19:54,120
لكنتَ قد تزوجت سافيرا-سان

308
00:19:56,600 --> 00:19:58,790
كانت مسؤولية كبيرة للغاية عليَّ لأتحملها

309
00:19:59,330 --> 00:20:00,860
هذا ما أشعر به

310
00:20:01,950 --> 00:20:03,800
أهذا كل ما بالأمر حقًّا؟

311
00:20:04,440 --> 00:20:06,850
،إن كان لديكَ شيءٌ مهم يعتمد على ذلك

312
00:20:06,850 --> 00:20:09,310
تستطيع إذن أخذه منّي، صحيح؟

313
00:20:10,540 --> 00:20:12,020
رأيتُ وجهها

314
00:20:13,580 --> 00:20:16,650
رأيتُ وجه سافيرا في وجه الأميرة كريستال آنذاك

315
00:20:17,430 --> 00:20:21,510
كان نفس التعبير لامرأة تجتمع مع الرجل الّذي أحبته حقًّا

316
00:20:23,080 --> 00:20:25,490
،وبمعرفة مشاعرها هذه

317
00:20:25,490 --> 00:20:27,290
لَم أستطع إعتراض طريقها

318
00:20:29,350 --> 00:20:31,850
...تجاهل مشاعر شخص آخر لتحقيق مبتغاي

319
00:20:32,360 --> 00:20:34,500
كنتُ ضعيفًا على أن أفعل ذلك

320
00:20:35,340 --> 00:20:37,820
هذا هو سبب دعوة أبي لي بالفاشل

321
00:20:39,020 --> 00:20:43,010
لكنّكَ كنتَ قادرًا على التخلي عن كل شيء من أجل الأميرة كريستال

322
00:20:43,950 --> 00:20:48,430
لا بدَّ أن يصبح ملك الخاتم شخصٌ مثلكَ

323
00:20:52,620 --> 00:20:53,690
أخي الكبير

324
00:20:54,390 --> 00:20:57,330
ألن تعيد النظر في الأمر؟

325
00:20:57,330 --> 00:21:00,400
أعتقدتُ أنّكَ وعدتني بعدم التدخل في ماسا من الأساس؟

326
00:21:00,820 --> 00:21:03,860
كان قرار الإمبراطور إرسال تعزيزات إلى أرض الماء

327
00:21:04,130 --> 00:21:07,670
لم تُغفر لكَ بعد جريمة عدم الامتثالكَ لأوامر في أنَّ تصبح ملك الخاتم

328
00:21:08,230 --> 00:21:11,230
،لكنّكَ استطعتَ كسب ثقة ملك الخاتم

329
00:21:11,230 --> 00:21:14,170
،وتأدية عمل جيد في إبلاغنا عن أفعاله

330
00:21:14,750 --> 00:21:16,960
والّذي يعتبره أبونا تكفيرًا صغيرًا

331
00:21:19,150 --> 00:21:22,180
استمر في تحقيق تطلعات أبينا يا مارس

332
00:21:22,630 --> 00:21:26,450
منزلك الوحيد هو إمبراطورية جيساراس لا غير

333
00:21:40,100 --> 00:21:41,500
ما الّذي تريدينه؟

334
00:21:42,580 --> 00:21:45,860
اسرق الخواتم أيّها الأمير مارس

335
00:21:46,370 --> 00:21:47,380
ماذا؟

336
00:21:48,070 --> 00:21:50,660
إنّها إرادة جلالة الإمبراطور

337
00:21:51,160 --> 00:21:54,240
سمح لكَ بكسب ثقة ملك الخاتم

338
00:21:54,240 --> 00:21:56,370
لأنّه كان ينتظر هذه اللحظة

339
00:21:57,090 --> 00:22:01,010
بعد ثلاثة أيام، سيهاجم جيش وحوش ماسا

340
00:22:01,510 --> 00:22:03,610
استغل فوضى هذه المعركة

341
00:22:03,610 --> 00:22:05,630
لقتل ملك الخاتم