1
00:00:05,150 --> 00:00:06,310
صباح الخير

2
00:00:07,260 --> 00:00:11,320
آسف. نويتُ الاستراحة لفترة قصيرة فقط

3
00:00:11,650 --> 00:00:13,740
لا تهتمّ من فضلك

4
00:00:13,740 --> 00:00:17,460
لا بدّ أنّ تلك المعركة مع التنّين قد أرهقَتْك يا ألين

5
00:00:19,740 --> 00:00:20,900
ماذا عن الأُخريات؟

6
00:00:21,590 --> 00:00:22,290
هناك

7
00:00:26,020 --> 00:00:27,130
تبدوان مُفعمتين بالطّاقة

8
00:00:28,800 --> 00:00:29,860
...ألين

9
00:00:31,200 --> 00:00:34,470
المعذرة، بخصوص... كما تعلم

10
00:00:48,600 --> 00:00:53,920
بين منازل المحتاجين، تسافر امرأة
،تستطيع معالجة أي جرح أو مرض

11
00:00:53,920 --> 00:00:55,610
قدّيسة إعجازيّة

12
00:00:56,290 --> 00:01:00,230
سمعتُ إشاعات، لكن لم أتخيّل أبداً
بأنّها كانت تدور حولكِ يا ليزي

13
00:01:00,230 --> 00:01:02,500
آسفة لأنّني لم أخبرك أبداً

14
00:01:04,900 --> 00:01:06,300
لا تلومي نفسكِ بسبب ذلك

15
00:01:06,300 --> 00:01:07,460
...لكن

16
00:01:07,460 --> 00:01:10,140
،سواء كنتِ أميرة أم قدّيسة

17
00:01:10,140 --> 00:01:13,210
بالنّسبة لي، تبقين أنتِ دوماً يا ليزي

18
00:01:13,210 --> 00:01:14,470
...ألين

19
00:01:17,280 --> 00:01:19,220
!ألين

20
00:01:19,930 --> 00:01:21,600
!تعال ونازلني

21
00:01:22,960 --> 00:01:24,480
!حسناً، نداء الواجب

22
00:01:24,480 --> 00:01:26,590
!تعال إلى هنا بسرعة

23
00:01:25,670 --> 00:01:27,470
!قد أطالب بجولة تعليمات أيضاً

24
00:01:27,470 --> 00:01:28,550
!حسناً، قادم

25
00:01:34,010 --> 00:01:37,340
البطل السّابق المنفيّ
يعيش كما يحلو له

26
00:03:00,030 --> 00:03:04,030
الحلقة 2
حدّاد السّيف المُقدَّس المُعلِّم

27
00:03:01,990 --> 00:03:04,030
حسناً، سأراكم لاحقاً

28
00:03:04,640 --> 00:03:07,910
بوسعك الرّكوب معنا إلى أقرب قرية

29
00:03:07,910 --> 00:03:10,750
لا أهوى العربات وما شابه

30
00:03:10,750 --> 00:03:13,550
المشي إلى حيث يرغب مزاجي يلائمني أكثر

31
00:03:16,550 --> 00:03:20,170
آكيرا، هل أنتِ متأكّدة من أنّكِ
تريدين الاعتناء بها؟

32
00:03:20,170 --> 00:03:22,870
لقد تعلّقَتْ بي

33
00:03:22,870 --> 00:03:25,300
سآخذها معي في رحلتي

34
00:03:25,300 --> 00:03:27,090
،تقول بأنّها لا تملك عائلة

35
00:03:28,360 --> 00:03:31,310
ولا يمكنني إعادتها إلى تلك القرية

36
00:03:32,180 --> 00:03:33,560
هذا صحيح

37
00:03:34,310 --> 00:03:35,520
أليس هذا رائعاً؟

38
00:03:35,520 --> 00:03:36,320
!أجل

39
00:03:38,660 --> 00:03:40,820
أعتذر بشأن سيفك يا ألين

40
00:03:41,190 --> 00:03:43,200
لم ينكسر بسببك يا آكيرا

41
00:03:43,510 --> 00:03:44,350
...لا

42
00:03:45,340 --> 00:03:48,390
لكن كان ذلك التنّين خصماً
،من واجبي أن أهزمه

43
00:03:48,880 --> 00:03:50,810
وكان كلّ ما فعلتُه هو الاعتماد
عليك في كلّ شيء

44
00:03:51,270 --> 00:03:54,330
لستُ مؤهّلاً لأكون بطلة حقّاً، أليس كذلك؟

45
00:03:55,400 --> 00:03:57,120
...هذا السّيف الإلهيّ أيضاً

46
00:03:57,120 --> 00:04:00,340
لعلّ شخصاً مثلك ينبغي أن يكون
هو من يحمله

47
00:04:01,780 --> 00:04:05,590
لم أتمكّن من هزيمة التنّين
إلّا لأنّك قاتلته أوّلاً

48
00:04:05,850 --> 00:04:07,010
...ألين

49
00:04:07,010 --> 00:04:11,110
فضلاً عن ذلك، البطل الوحيد الّذي وُجِد
لأجل هذه الفتاة هي أنتِ يا آكيرا

50
00:04:14,170 --> 00:04:16,310
!هيّا! سنذهب

51
00:04:19,000 --> 00:04:20,570
!كفى مُماطلة

52
00:04:23,450 --> 00:04:24,670
!انتظريني

53
00:04:27,400 --> 00:04:28,950
!اعتنيا بنفسيكما

54
00:04:29,550 --> 00:04:31,330
تبدوان منسجمتين معاً

55
00:04:31,670 --> 00:04:32,730
بالفعل

56
00:04:36,870 --> 00:04:37,840
هكذا إذاً

57
00:04:38,190 --> 00:04:40,090
تمّ إسقاط الملِك التنّين الأحمر إذاً

58
00:04:40,410 --> 00:04:41,580
أجل

59
00:04:41,580 --> 00:04:43,750
...استدراج البطلة

60
00:04:43,750 --> 00:04:45,550
والقضاء عليها. تلك كانت الخطّة

61
00:04:45,550 --> 00:04:47,590
...أن تتفوّق عليه بدلاً من ذلك

62
00:04:48,180 --> 00:04:52,650
...هل بالغنا في تقييم التنّين؟ أم

63
00:04:53,350 --> 00:04:57,100
يبدو أنّ القدّيسة قدّمَتْ مساعدة

64
00:04:59,200 --> 00:05:02,990
إذاً يجب ألّا نستخفّ بقوّة
القدّيسة، أليس كذلك؟

65
00:05:02,990 --> 00:05:04,160
!للّعنة

66
00:05:04,900 --> 00:05:06,990
أيُعقَل هذا؟

67
00:05:06,990 --> 00:05:10,040
!ليت قتلهما ذِئاب الصّلصال

68
00:05:10,580 --> 00:05:12,750
في المرّة المقبلة، سنُرسل قطيعاً ضخماً

69
00:05:12,750 --> 00:05:15,250
!ونحرص على إبادتهما بشكل كامل

70
00:05:15,250 --> 00:05:16,750
اهدأ يا بريت

71
00:05:18,490 --> 00:05:20,520
هناك مشكلة المواد

72
00:05:20,520 --> 00:05:22,550
،مع سقوط الملِك التنّين الأحمر

73
00:05:23,190 --> 00:05:25,800
لا نتحمّل ضياع الكائنات الحيّة السّحريّة

74
00:05:25,800 --> 00:05:30,840
لكن يا أبي، على هذا المُعدّل، كأنّنا
!نسمح للبطلة والقدّيسة بالهرب

75
00:05:30,840 --> 00:05:32,060
ماذا تقصد؟

76
00:05:32,060 --> 00:05:35,160
ما دامتا ضمن المناطق الحدوديّة، سنحظى

77
00:05:35,160 --> 00:05:37,930
بفُرص كثيرة لإرسالهما إلى الهاوية

78
00:05:37,930 --> 00:05:39,320
...الأهمّ

79
00:05:42,420 --> 00:05:44,360
لا حاجة لاستعجالي

80
00:05:44,360 --> 00:05:47,030
سأرسل لك رأس الإيلف عمّا قريب

81
00:05:47,760 --> 00:05:49,620
...والآن، أستأذن

82
00:05:51,690 --> 00:05:55,120
...سندفن تلك الدُّمى الإلهيّة المُغيظة

83
00:05:55,120 --> 00:05:57,830
ونأخذ بثأرنا من المملكة والآلهة

84
00:06:00,080 --> 00:06:02,620
أأنتِ صديقة حدّادة يا ليزي؟

85
00:06:02,620 --> 00:06:07,130
تقطن في قرية ليست ببعيدة
من هنا تُدعى غرانهولم

86
00:06:07,440 --> 00:06:11,640
ارتأيتُ أنّها قد تستطيع صنع سيف جديد لك

87
00:06:11,640 --> 00:06:14,510
لم أكن أعلم بوجود بلدات في المناطق الحدوديّة

88
00:06:14,510 --> 00:06:18,140
،الحدّادة هي إيلف غريبة الأطوار
لكن مهاراتها جيّدة

89
00:06:18,420 --> 00:06:22,650
أريد فقط... أن أعتذر منك يا ألين

90
00:06:22,650 --> 00:06:23,550
تعتذرين؟

91
00:06:23,550 --> 00:06:27,620
وحيي هو السّبب الّذي جعلك تتورّط في كلّ شيء

92
00:06:27,620 --> 00:06:30,700
بالطّبع، نحن نفعل هذا فقط بموافقتك يا ألين

93
00:06:32,330 --> 00:06:33,950
في هذه الحالة، أشكركِ

94
00:06:34,750 --> 00:06:35,950
!يمكنك الاعتماد عليّ

95
00:06:35,950 --> 00:06:39,290
لكن يا ليزي، ألا تريدين العودة إلى العاصمة؟

96
00:06:39,290 --> 00:06:41,330
فأنتِ الأميرة

97
00:06:42,940 --> 00:06:45,080
،بياتريس هنا معي

98
00:06:45,080 --> 00:06:48,220
.وقد تواصلتُ مع أبي سلفاً
لا مشاكل على الإطلاق

99
00:06:48,560 --> 00:06:49,950
هذا جيّدٌ إذاً

100
00:06:56,390 --> 00:06:59,980
ليزي-ساما، سأشعل ناراً. انتظري لحظة رجاء

101
00:07:00,380 --> 00:07:03,250
!المُفارقة المتوازية: إنشاء نار

102
00:07:05,390 --> 00:07:06,960
!مُبهر

103
00:07:09,230 --> 00:07:11,110
ما-ما-ماذا...؟

104
00:07:21,280 --> 00:07:23,510
!أ-أ-أنا آسفة

105
00:07:23,510 --> 00:07:25,020
لا عليكِ

106
00:07:26,000 --> 00:07:28,130
،بما أنّكما مخطوبان

107
00:07:28,130 --> 00:07:30,510
فلا مانع بالتّأكيد أن تنامي في حضنه

108
00:07:34,380 --> 00:07:36,260
!إ-إنّه خطيبي السّابق

109
00:07:36,260 --> 00:07:38,770
أجل، هذا صحيح

110
00:07:39,290 --> 00:07:43,060
يمكنكِ أن تنامي هكذا. لا أمانع إطلاقاً

111
00:07:43,060 --> 00:07:45,520
!لكن أنا أمانع

112
00:07:59,360 --> 00:08:01,370
...إمضاء الوقت هكذا

113
00:08:01,980 --> 00:08:05,050
لا أظنّني فعلتُها منذ إعادة
خَلقي في هذا العالم

114
00:08:06,670 --> 00:08:11,540
التقينا أوّل مرّة في ليلة جميلة تحت
ضوء القمر هكذا، أليس كذلك؟

115
00:08:15,230 --> 00:08:16,930
القمر جميل، أليس كذلك؟

116
00:08:18,450 --> 00:08:19,490
من أنتِ؟

117
00:08:20,800 --> 00:08:24,960
.آسفة لأنّني لم أعرّف عن نفسي
اسمي ليزي أدوستيلّا

118
00:08:26,240 --> 00:08:30,070
المعذرة، أتطلّع قُدماً للتعرّف
عليك يا ألين-ساما

119
00:08:30,360 --> 00:08:31,820
التعرُّف عليّ؟

120
00:08:31,820 --> 00:08:33,710
...فـ-في الحقيقة

121
00:08:33,710 --> 00:08:35,820
...ألين-ساما، أنت وأنا

122
00:08:36,820 --> 00:08:38,240
مخطوبان

123
00:08:39,110 --> 00:08:41,330
هذا ما قيل لي

124
00:08:41,840 --> 00:08:42,830
ماذا؟

125
00:08:47,580 --> 00:08:50,090
...الحياة الهادئة الّتي اشتقتُ إليها

126
00:08:50,500 --> 00:08:52,740
قد تكون شيئاً من هذا القبيل

127
00:08:55,160 --> 00:08:57,340
أهلاً بكم في غرانهولم

128
00:08:58,390 --> 00:09:02,580
إنّها حيويّةٌ جدّاً لدرجة لا يمكن
أن أتوقّع بأنّها منطقة حدوديّة

129
00:09:02,580 --> 00:09:06,480
...المُغامِرون والمُتجوِّلون بظروف خاصّة

130
00:09:06,480 --> 00:09:10,360
يجتمعون هنا بالتّحديد لأنّها تقع على الحدود

131
00:09:11,810 --> 00:09:13,050
هكذا إذاً

132
00:09:18,770 --> 00:09:20,990
...إذاً يا ليزي، هذا

133
00:09:21,570 --> 00:09:23,500
حيث تعيش صديقتكِ الحدّادة؟

134
00:09:24,370 --> 00:09:27,740
أنا متأكّدة بأنّها ستصنع السّيف
!المثاليّ لك يا ألين

135
00:09:30,300 --> 00:09:31,250
هذا غريب

136
00:09:32,050 --> 00:09:36,510
في العادة أسمع صوت طنين سيف
يُضرَب حتّى من هذه المسافة

137
00:09:36,510 --> 00:09:38,390
لعلّها ذهبَتْ إلى مكانٍ ما؟

138
00:09:38,390 --> 00:09:41,940
تلك المرأة؟ والّتي لا تهتمّ سوى
بصناعة السّيوف؟

139
00:09:43,190 --> 00:09:44,640
ليزي؟

140
00:09:45,120 --> 00:09:47,140
لا يبدو الباب مُقفلاً

141
00:09:52,540 --> 00:09:53,770
نويل؟

142
00:09:53,770 --> 00:09:56,290
هل أنتِ هنا؟ نويل؟

143
00:09:59,350 --> 00:10:01,530
هذه أسلحة مُتقَنة الصّنع

144
00:10:02,240 --> 00:10:04,180
إنّها أفضل بكثير من سيفي

145
00:10:07,430 --> 00:10:08,770
ليزي، هل أنتِ بخير؟

146
00:10:09,910 --> 00:10:11,080
...إنَّ نويل

147
00:10:11,450 --> 00:10:12,690
...نويل قد

148
00:10:14,280 --> 00:10:15,500
...نويل

149
00:10:18,190 --> 00:10:19,340
تمالكي نفسكِ

150
00:10:20,030 --> 00:10:22,800
ليزي-ساما، هل نسيتِ؟

151
00:10:22,800 --> 00:10:24,630
هذا طبيعيّ بالنّسبة لها

152
00:10:28,990 --> 00:10:30,280
إنّها نائمة؟

153
00:10:31,060 --> 00:10:35,070
البطل السّابق المنفيّ
يعيش كما يحلو له

154
00:10:36,980 --> 00:10:41,630
إذاً في كلّ مرّة تسقط فيها نتيجة
الإعياء، تُعالجينها يا ليزي؟

155
00:10:43,080 --> 00:10:47,760
أجل. مضى وقتٌ طويل، لذا كنتُ قد نسيت

156
00:10:47,760 --> 00:10:52,580
،حالما تبدأ الآنسة نويل بصناعة سيف
فهي لا تأكل ولا تشرب ولا تنام

157
00:10:52,580 --> 00:10:55,010
في مُعظم الوقت، لا تتوقّف إطلاقاً

158
00:10:56,460 --> 00:10:59,720
حذّرتُها أن تنتبه على نفسها

159
00:10:59,720 --> 00:11:01,970
...أخبرتُها مراراً، ومع ذلك

160
00:11:04,920 --> 00:11:06,680
نمتُ جيّداً

161
00:11:08,020 --> 00:11:08,890
ما هذا؟

162
00:11:09,240 --> 00:11:11,990
ليزي وبياتريس؟ لم أركما منذ وقت

163
00:11:12,900 --> 00:11:14,190
من يكون؟

164
00:11:14,870 --> 00:11:16,330
...في الواقع

165
00:11:16,330 --> 00:11:20,330
.إنّه يعمل كحارس لليزي-ساما معي
هذا السيّد ألين

166
00:11:21,620 --> 00:11:22,910
سررتُ بلقائكِ

167
00:11:23,580 --> 00:11:24,710
هكذا إذاً

168
00:11:25,440 --> 00:11:27,660
تريدين منّي أن أصنع سيفاً له، صحيح؟

169
00:11:27,660 --> 00:11:30,850
أجل! أنتِ سريعة حقّاً في فهم الوضع يا نويل

170
00:11:30,850 --> 00:11:31,480
لا أستطيع فعلها

171
00:11:31,480 --> 00:11:33,420
ماذا؟ لِمَ لا؟

172
00:11:34,270 --> 00:11:37,830
.تلقّيتُ طلبات كثيرة الآن
أنا مشغولة جدّاً

173
00:11:38,460 --> 00:11:39,420
إنّها صديقتك؟

174
00:11:39,420 --> 00:11:46,430
...صـ-صدقاً! على الأقلّ
هكذا أنا وهي في نظري

175
00:11:46,840 --> 00:11:50,110
ليزي وأنا صديقتان، لكن هذا
لا علاقة له بالأمر

176
00:11:50,110 --> 00:11:52,850
إن لم يكن لديكِ الوقت، فليكن

177
00:11:52,850 --> 00:11:53,940
...فضلاً عن ذلك

178
00:11:53,940 --> 00:11:55,860
لديه سيف بالفعل

179
00:11:55,860 --> 00:11:58,190
لا، هذا مكسور

180
00:11:58,190 --> 00:11:59,820
ماذا؟ كسرتَه؟

181
00:12:00,480 --> 00:12:04,320
شخص بمهارات باهتة يحمل
...سيفاً من سيوفي هو

182
00:12:11,960 --> 00:12:14,870
استُخدِمَ هذا السّيف لأقصى حدوده

183
00:12:14,870 --> 00:12:16,210
إنّه ميّت كلّياً

184
00:12:17,040 --> 00:12:19,070
كيف يتمكّن شخصٌ من هذا حتّى؟

185
00:12:20,220 --> 00:12:21,590
غيّرتُ رأيي

186
00:12:21,590 --> 00:12:22,860
سأصنع له سيفاً

187
00:12:22,860 --> 00:12:24,290
حقّاً؟

188
00:12:24,290 --> 00:12:25,970
قبل ذلك، اسمح لي أن أسألك

189
00:12:27,470 --> 00:12:30,910
هل لديك اهتمام بسيف يتفوّق
على سيف إلهيّ؟

190
00:12:30,910 --> 00:12:32,480
يتفوّق على سيفٍ إلهيّ...؟

191
00:12:35,420 --> 00:12:37,860
سيف لا يحمله سوى بطل

192
00:12:37,860 --> 00:12:39,500
سيف وُجِدَ لأجل البطل فقط

193
00:12:40,190 --> 00:12:42,870
تقصدين سيفاً يتجاوز حتّى هذا؟

194
00:12:42,870 --> 00:12:43,820
هذا صحيح

195
00:12:44,500 --> 00:12:47,740
قطعة تتجاوز قيمتها قيمة أيّ سيف هنا

196
00:12:48,440 --> 00:12:50,950
،مهما كان الحدّاد مُتميّزاً

197
00:12:50,950 --> 00:12:54,960
لا يستطيع صنع أفضل سيف له
دون أن يعلم من سيحمله

198
00:12:55,810 --> 00:12:58,630
يتطلّب ذلك حاملاً قيّماً

199
00:12:59,300 --> 00:13:01,870
،حتّى الآن، لم أتمكّن من إيجاد واحد

200
00:13:01,870 --> 00:13:03,380
لكن أخيراً، أتيتَ أنت

201
00:13:03,760 --> 00:13:04,880
...نويل

202
00:13:04,880 --> 00:13:07,410
...أحداث ذلك اليوم ما زالت

203
00:13:07,410 --> 00:13:08,390
ليزي

204
00:13:08,390 --> 00:13:10,090
أنا آسفة

205
00:13:10,090 --> 00:13:11,750
حسناً، ما رأيك؟

206
00:13:13,340 --> 00:13:16,760
،حسناً، بعد سماع كلّ هذا
لا أملك سبباً للرّفض

207
00:13:17,520 --> 00:13:21,350
حسناً! بعد حسم الأمر، سأشرع
!في العمل حالاً

208
00:13:21,350 --> 00:13:21,900
ماذا؟

209
00:13:23,750 --> 00:13:25,190
!ماذا؟ لحظة

210
00:13:30,450 --> 00:13:31,500
...فانيسّا

211
00:13:44,780 --> 00:13:46,220
...مهما كلّف الأمر

212
00:13:46,510 --> 00:13:49,020
يجب أن أصنع سيفاً يتفوّق على سيف إلهيّ

213
00:13:54,980 --> 00:13:57,620
آمل ألّا تقوم بأيّ عمل طائش

214
00:13:57,620 --> 00:13:58,530
ليزي؟

215
00:13:58,530 --> 00:14:00,610
لا شيء

216
00:14:00,920 --> 00:14:04,730
أثناء العمل على سيف، لا تتحادث
معنا حتّى لو بقينا للزّيارة

217
00:14:05,020 --> 00:14:07,290
هل نبحث عن نُزُل نقيم فيه

218
00:14:07,290 --> 00:14:10,510
غالباً سنبقى في هذه القرية لبعض الوقت

219
00:14:13,430 --> 00:14:15,620
يجب الإبلاغ عن هذا

220
00:14:16,330 --> 00:14:20,880
حقّاً؟ حقيقة وجود القدّيسة هنا ملائمة جدّاً لنا

221
00:14:21,560 --> 00:14:24,140
لكن ثمّة شيء يحيّرني

222
00:14:25,410 --> 00:14:27,550
،وفقاً لمعلومات ويستفيلت

223
00:14:27,550 --> 00:14:31,510
ينبغي أن يكون الحارس الشّخصيّ
للقدّيسة فارِسة واحدة

224
00:14:32,240 --> 00:14:34,640
هل استأجرَتْه في البلدة؟

225
00:14:34,640 --> 00:14:37,180
من يكون؟

226
00:14:37,680 --> 00:14:40,440
أعتقد يجدر بنا أن نتحرّى قليلاً

227
00:14:42,230 --> 00:14:44,690
والآن... ماذا ينبغي أن نفعل؟

228
00:14:45,010 --> 00:14:48,610
ما رأيك أن تسترخي وتقضي
وقتك كما تشاء فحسب؟

229
00:14:48,610 --> 00:14:51,890
فهذا ما تمنّيتَه دوماً، أليس كذلك؟

230
00:14:51,890 --> 00:14:53,200
هذا صحيح

231
00:14:53,780 --> 00:14:58,550
بما أنّ لديك الوقت، ما رأيك في الذّهاب
وإلقاء نظرة إلى نقابة المُغامرين؟

232
00:14:58,550 --> 00:15:02,830
المواد الّتي حصلنا عليها من ذلك
التنّين يمكن بيعها بمبلغ ضخم

233
00:15:02,830 --> 00:15:04,020
معكِ حقّ

234
00:15:04,530 --> 00:15:08,520
منذ طرد عائلتي لي، لا أملك مالاً

235
00:15:09,140 --> 00:15:10,590
ماذا ستفعلين أنتِ وليزي؟

236
00:15:12,510 --> 00:15:16,600
بياتريس وأنا سوف نتجوّل في البلدة
ونقوم ببعض السّياحة

237
00:15:16,600 --> 00:15:19,060
هكذا إذاً. أراكما لاحقاً

238
00:15:20,660 --> 00:15:21,960
!رافقتك السّلامة

239
00:15:25,150 --> 00:15:26,610
هل أنتِ متأكِّدة من هذا؟

240
00:15:27,190 --> 00:15:31,400
فأنتِ وأنا غالباً لن نتمكّن من مُعالجة
هذا الأمر بمفردها

241
00:15:31,400 --> 00:15:32,870
أعلم

242
00:15:32,870 --> 00:15:36,620
لكن لا أريد توريط ألين في أمور
أكثر ممّا تورّط سلفاً

243
00:15:41,140 --> 00:15:42,620
!تفضّل

244
00:15:43,090 --> 00:15:45,470
أهلاً بك في نقابة المُغامرين

245
00:15:45,470 --> 00:15:47,300
أرغب في مقايضة هذه بالمال

246
00:15:47,300 --> 00:15:50,260
...سأقيّمها إذا انتظرت قليلاً

247
00:15:50,260 --> 00:15:53,170
!هـ-هذا حرشف تنّين

248
00:15:53,170 --> 00:15:56,490
يا لها من أداة ثمينة! ولديك كيس ممتلئ به؟

249
00:15:56,490 --> 00:15:58,520
يؤسفني القول بأنّها لا تفيدني

250
00:15:58,520 --> 00:15:59,750
!مـ-مدير الفرع

251
00:15:59,750 --> 00:16:01,720
!هـ-هذا هائل

252
00:16:00,550 --> 00:16:01,270
!انتظري

253
00:16:01,720 --> 00:16:03,700
!انظر إلى هذا

254
00:16:03,700 --> 00:16:06,490
يبدو أنّ الأمور تتفاقم

255
00:16:06,490 --> 00:16:07,720
المعذرة

256
00:16:09,410 --> 00:16:11,780
هل لي بلحظة؟

257
00:16:12,070 --> 00:16:14,120
...بخصوص ذلك التنّين

258
00:16:14,750 --> 00:16:17,280
هلّا شرحت لي عنه بالتّفصيل؟

259
00:16:17,690 --> 00:16:19,070
...لا أمانع، لكن

260
00:16:19,790 --> 00:16:21,050
المعذرة

261
00:16:22,150 --> 00:16:25,500
أعتذر على التّعريف المُتأخّر. اسمي هوريس

262
00:16:26,320 --> 00:16:28,290
وهذه ميلين

263
00:16:28,730 --> 00:16:30,000
أمازونيّة؟

264
00:16:30,000 --> 00:16:33,750
إنّهن غير مألوفات في هذه المملكة

265
00:16:34,760 --> 00:16:40,520
رغم ما يوحي به مظهرُنا، لا نعرف
ما يكفي من قصص المُغامرات

266
00:16:40,520 --> 00:16:44,140
نحن نسافر للاستماع إلى المُغامرين

267
00:16:44,140 --> 00:16:45,310
حقّاً؟

268
00:16:46,040 --> 00:16:50,440
هل حصلت على حراشف التنّين هذه بمفردك؟

269
00:16:50,440 --> 00:16:52,690
أم لديك حلفاء؟

270
00:16:52,690 --> 00:16:55,680
في الواقع، لم يكن بالإمكان أن أهزمه بمفردي

271
00:16:55,680 --> 00:16:58,700
على سبيل المُصادفة، هل كانت البطلة معك؟

272
00:16:59,460 --> 00:17:01,290
حدسك ممتاز

273
00:17:01,290 --> 00:17:05,120
لا بدّ أنّ مشاهدة ذلك كانت لتكون مُبهرة

274
00:17:05,120 --> 00:17:06,990
!آسفة لو تأخّرت

275
00:17:06,990 --> 00:17:10,570
انتهينا من التّقييم، لذا يمكننا
البدء بالمُقايضة الآن

276
00:17:10,570 --> 00:17:12,880
...حسناً، نستأذن

277
00:17:13,160 --> 00:17:14,780
لنلتقِ ثانية

278
00:17:17,380 --> 00:17:21,390
،أردتُ رؤية الرّجل لأنّني أردتُ قياس قدراته

279
00:17:21,390 --> 00:17:24,700
لكن لم أتوقّعه أبداً أن يكون فاشلاً
دون هِبة تُذكَر

280
00:17:24,700 --> 00:17:26,390
هذا مُدهش

281
00:17:28,320 --> 00:17:30,400
ثمّة شيء يُحيّر ميلين

282
00:17:30,980 --> 00:17:34,880
مهلكِ. إنّه خصمٌ تافه كلّياً

283
00:17:40,140 --> 00:17:43,160
نويل، هل السّيف جاهز؟

284
00:17:46,560 --> 00:17:47,750
توقّعت

285
00:17:52,390 --> 00:17:54,260
آسفة لو تأخّرتُ عليكم

286
00:17:54,260 --> 00:17:55,710
لقد انتهى

287
00:17:58,690 --> 00:18:02,740
إنّه أفضل سيف أستطيع صناعته الآن

288
00:18:08,870 --> 00:18:09,900
أجل

289
00:18:12,560 --> 00:18:15,150
أنتِ لا تمزحين. هذا سيف مُبهر حقّاً

290
00:18:17,440 --> 00:18:20,580
...لنذهب ونختبره... الآن

291
00:18:20,580 --> 00:18:23,200
نويل

292
00:18:24,210 --> 00:18:27,910
لنذهب بعد أن تتعافي

293
00:18:30,660 --> 00:18:32,610
،إذا كان هذا بشأن سهولة الاستخدام

294
00:18:32,610 --> 00:18:34,540
فيمكنني اختبار ذلك بمفردي

295
00:18:34,540 --> 00:18:37,570
أريد أن أراك تستخدمه بأمّ عيني

296
00:18:37,570 --> 00:18:40,430
غالباً سيحتاج بعض التّعديلات ليلائمك أكثر

297
00:18:40,430 --> 00:18:42,170
أنتِ حريصة جدّاً

298
00:18:42,170 --> 00:18:43,350
بالطّبع أنا كذلك

299
00:18:43,350 --> 00:18:46,430
أخبريني يا نويل، لماذا أنتِ حدّادة؟

300
00:18:46,430 --> 00:18:48,430
هل من الغريب رؤية إيلف حدّادة؟

301
00:18:48,430 --> 00:18:52,980
حسناً، إذا وضعنا الموهبة والسّمات
،الخاصّة بعين الاعتبار

302
00:18:52,980 --> 00:18:56,430
فأقول أنّ الأقزام أنسب لمثل هذا العمل

303
00:18:58,510 --> 00:18:59,460
نويل؟

304
00:19:00,550 --> 00:19:04,200
ترعرعتُ على يد قزم

305
00:19:04,200 --> 00:19:07,620
لا أعرف أين وُلِدت أو من هما والدايّ

306
00:19:08,070 --> 00:19:10,120
انتهى المطاف بي في مكان لم أره من قبل

307
00:19:10,120 --> 00:19:11,620
!تماسكي

308
00:19:11,620 --> 00:19:15,380
كنتُ أهيم دون وجهة، والشّخص
...الّذي اعتنى بي

309
00:19:15,380 --> 00:19:16,660
كان فانيسّا

310
00:19:18,380 --> 00:19:21,000
كانت خرقاء وعنيدة ومستعصية

311
00:19:21,680 --> 00:19:25,660
،لم تعلّمني شيئاً عن صناعة السّيف

312
00:19:25,660 --> 00:19:28,900
لكن بالنّسبة لي، تبقى مُعلّمتي العزيزة

313
00:19:29,500 --> 00:19:30,310
هكذا إذاً

314
00:19:30,570 --> 00:19:33,940
!لكن ماضيّي الشّخصيّ غير مهمّ هنا، صحيح؟

315
00:19:33,940 --> 00:19:35,360
!لنكمل

316
00:19:37,290 --> 00:19:39,500
أنتِ من استهلّ الحديث حول ذلك

317
00:19:39,500 --> 00:19:42,700
حسناً، حسناً. يا لها من صدفة

318
00:19:42,700 --> 00:19:44,290
التقينا من جديد

319
00:19:44,290 --> 00:19:47,530
هل خرجت لصيد وحوش بناء
على طلب النّقابة؟

320
00:19:47,530 --> 00:19:49,200
شيء من هذا القبيل

321
00:19:49,200 --> 00:19:53,910
حسناً، عندما تعود، حدّثنا عن الأمر لو سمحت

322
00:19:55,430 --> 00:19:56,720
!ألين

323
00:19:57,610 --> 00:19:59,340
!تعال إلى هنا بسرعة

324
00:19:59,340 --> 00:20:00,650
!أنا قادم

325
00:20:00,650 --> 00:20:03,440
حسناً إذاً، نستأذن بالانصراف

326
00:20:06,930 --> 00:20:08,070
...ذلك الشّخص هو

327
00:20:09,390 --> 00:20:10,520
لا، هذا غير ممكن

328
00:20:12,100 --> 00:20:16,610
لا يبدو أنّه كان يتحرّى عنّا إطلاقاً

329
00:20:18,080 --> 00:20:19,640
ما هو هدفه؟

330
00:20:19,640 --> 00:20:21,400
تعقّبيه

331
00:20:21,400 --> 00:20:24,530
إذا اكتشفَ الأمر، فستعني تلك
مُشكلة بالنّسبة لنا

332
00:20:34,280 --> 00:20:35,680
!يروقني

333
00:20:35,680 --> 00:20:37,090
دعني أراه للحظة

334
00:20:37,980 --> 00:20:38,840
بكلّ تأكيد

335
00:20:42,410 --> 00:20:44,080
أهذه هِبتكِ يا نويل؟

336
00:20:44,080 --> 00:20:44,750
أجل

337
00:20:45,450 --> 00:20:47,320
قوّة السّيف وحدّته

338
00:20:47,320 --> 00:20:50,100
...وحالته الّتي لا تراها العين المُجرّدة
أستطيع رؤيتها كلّها

339
00:20:50,510 --> 00:20:53,090
...سرعة السّيف وزاويته وتموضعه

340
00:20:53,090 --> 00:20:55,100
يحمل السّيف بلا أخطاء

341
00:20:55,670 --> 00:20:58,520
استخدمتَ هذا بصورة مثاليّة دون
أن تترك خدشاً واحداً عليه

342
00:21:00,080 --> 00:21:03,360
كما توقّعتُ. عيني لا تخدعني

343
00:21:06,570 --> 00:21:08,120
يسرّني أنّني لم أخيّب أملكِ

344
00:21:08,530 --> 00:21:12,330
يبدو أنّني أحتاجك لمقاتلة وحوش أقوى

345
00:21:13,080 --> 00:21:14,600
لندخل إلى العمق أكثر

346
00:21:15,070 --> 00:21:16,870
نويل؟

347
00:21:16,870 --> 00:21:18,630
!انتظري لحظة فقط

348
00:21:22,140 --> 00:21:23,130
هذا غريب

349
00:21:24,030 --> 00:21:27,110
تأتي الوحوش كقطيع في العادة

350
00:21:27,920 --> 00:21:30,760
لعلّهم هربوا لأنّهم خائفون منك

351
00:21:31,070 --> 00:21:33,470
لا. لستُ أنا من يخشونه

352
00:21:33,470 --> 00:21:34,080
ماذا؟

353
00:21:34,590 --> 00:21:35,730
...أعتقد

354
00:21:35,730 --> 00:21:36,790
هذا

355
00:21:40,770 --> 00:21:42,030
مذهل

356
00:21:49,350 --> 00:21:52,540
!اهربي

357
00:21:53,120 --> 00:21:54,290
!نويل

358
00:21:54,290 --> 00:21:55,550
!عليكِ أن تهربي

359
00:21:59,560 --> 00:22:00,420
ألين

360
00:22:01,570 --> 00:22:03,210
...استخدم هذا السّيف

361
00:22:03,210 --> 00:22:05,720
...ضدّ... ضدّ هذا الشّيء

362
00:22:07,340 --> 00:22:09,540
!واقتله

363
00:23:45,060 --> 00:23:50,070
عِناد وإصرار

364
00:23:46,140 --> 00:23:48,840
"الحلقة القادمة: "عِناد وإصرار