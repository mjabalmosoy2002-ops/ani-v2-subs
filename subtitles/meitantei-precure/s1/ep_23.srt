1
00:00:11,180 --> 00:00:14,010
ما هي الهويّة الحقيقيّة لكيور إكلير؟

2
00:00:15,430 --> 00:00:20,060
إحدى هذه الفتيات هي بريكيور
!الغامضة، كيور إكلير

3
00:00:20,520 --> 00:00:21,610
من، من؟

4
00:00:21,770 --> 00:00:23,520
لا أعلم أيضاً

5
00:00:23,690 --> 00:00:26,070
ينبغي أن يكون هناك طرف خيط
في كلّ قصّة

6
00:00:26,240 --> 00:00:28,320
!لنتحرّ جميعاً معاً

7
00:00:28,490 --> 00:00:31,410
!قصّة اليوم عن كوريا هووا

8
00:00:31,570 --> 00:00:32,950
!حسناً، فلنبدأ

9
00:00:33,620 --> 00:00:35,370
!المُتحرّية النّجمة بريكيور

10
00:00:36,330 --> 00:00:37,540
!فلنبدأ

11
00:00:39,790 --> 00:00:42,250
،آخر المواضيع السّاخنة

12
00:00:42,420 --> 00:00:45,800
هي توقُّع ظهور ملِك عظيم في 19 يوليو

13
00:00:45,960 --> 00:00:48,550
حتّى مثل هذه المجلّات ازداد الطّلب عليها

14
00:00:45,960 --> 00:00:51,970
‏توقُّعات نهاية العالم 1999

15
00:00:48,720 --> 00:00:51,970
لعلّ الأمر مُرتبط بنهاية الألفيّة بطريقة ما

16
00:00:52,140 --> 00:00:54,680
يزداد الأمر تهويلاً

17
00:00:57,060 --> 00:01:00,850
كيور إكلير لا تتذكّر بأنّها بريكيور

18
00:01:01,190 --> 00:01:06,230
قبل أيّام، الآنسة شيروكو كشفت
تنكُّر اللّصّ الشّبح

19
00:01:06,400 --> 00:01:07,440
...هل تعتقدين

20
00:01:08,030 --> 00:01:09,400
...إن كان كذلك

21
00:01:09,900 --> 00:01:11,950
!قد تكون إيريزا

22
00:01:12,570 --> 00:01:14,740
!مُمكن-
أليس كذلك؟-

23
00:01:14,910 --> 00:01:17,080
من تكون إذاً؟

24
00:01:17,240 --> 00:01:18,620
لا أعلم

25
00:01:19,160 --> 00:01:20,410
لولوكا موريا

26
00:01:20,870 --> 00:01:23,290
أنا متأكّد بأنّها تعرف شيئاً

27
00:01:23,460 --> 00:01:25,670
لكنّها لن تُخبرنا أبداً

28
00:01:25,840 --> 00:01:27,750
...وتلك الصّورة الّتي عثرنا عليها

29
00:01:29,130 --> 00:01:31,260
ما زلنا لا نعرف شيئاً

30
00:01:35,640 --> 00:01:36,970
يا إلهي

31
00:01:44,440 --> 00:01:45,810
!أهلاً وسهلاً

32
00:01:46,570 --> 00:01:47,400
ماذا؟

33
00:01:47,940 --> 00:01:49,860
شكراً على المجيء دوماً

34
00:01:50,320 --> 00:01:53,200
أنا آتي إلى هنا لأنّ مذاقه لذيذ فقط

35
00:01:54,490 --> 00:01:56,200
ماذا تريدين اليوم؟

36
00:01:56,990 --> 00:01:58,790
نعنع بالشّوكولاتة وتوت

37
00:01:58,950 --> 00:02:00,160
!أهلاً وسهلاً

38
00:02:00,620 --> 00:02:03,120
ما رأيكِ أن تتعشّي هنا كنوع من التّغيير؟

39
00:02:03,290 --> 00:02:05,460
الأجواء لطيفة حقّاً

40
00:02:06,000 --> 00:02:07,210
ما رأيكِ؟

41
00:02:08,750 --> 00:02:11,260
!تفضّلي من هنا

42
00:02:17,050 --> 00:02:17,890
!هيّا

43
00:02:28,820 --> 00:02:32,690
!لنبحث عن اللّمحة في القلب

44
00:02:32,860 --> 00:02:35,740
إلهام مُشرِق

45
00:02:36,070 --> 00:02:38,700
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

46
00:02:38,870 --> 00:02:41,410
إنّها تنادينا

47
00:02:41,580 --> 00:02:44,330
أين الحقيقة؟ ما الّذي ستكتشفه؟

48
00:02:44,500 --> 00:02:48,090
لغز تلو الآخر

49
00:02:48,750 --> 00:02:54,130
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

50
00:02:54,300 --> 00:02:59,390
كما الدّليل! شيء يلمع عبر الزّمن

51
00:02:59,640 --> 00:03:02,310
كيف؟ كيف؟ أهي خدعة؟

52
00:03:02,470 --> 00:03:05,270
لماذا؟ لماذا؟ سوف نواجهها

53
00:03:05,560 --> 00:03:10,860
لننظر ونشعر
نكتشف الأسرار

54
00:03:11,190 --> 00:03:16,700
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

55
00:03:17,070 --> 00:03:22,240
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

56
00:03:22,580 --> 00:03:28,040
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

57
00:03:28,210 --> 00:03:31,500
!لنمشِ في ذلك الطّريق معاً

58
00:03:31,670 --> 00:03:35,420
!لنبحث عن اللّمحة في القلب

59
00:03:35,590 --> 00:03:37,260
إلهام مُشرِق

60
00:03:37,430 --> 00:03:43,060
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

61
00:03:43,220 --> 00:03:48,150
ولادتنا ولقاؤنا لَهو لغز رائع

62
00:03:48,310 --> 00:03:51,770
!هيّا يا بريكيور المُتحرّيات النّجمات

63
00:03:58,360 --> 00:04:02,950
!كوريا، تحرٍّ، وآيس كريم

64
00:04:03,540 --> 00:04:05,620
عزيزتي، ماذا تريدين؟

65
00:04:05,790 --> 00:04:08,870
!لنطلب شيئاً ثمّ نتشارك فيما بيننا

66
00:04:09,040 --> 00:04:11,790
!هذا يجعل اتّخاذ القرار صعباً

67
00:04:11,960 --> 00:04:14,210
!أنتِ ظريفة عندما تكونين مُتردّدة

68
00:04:14,380 --> 00:04:16,170
!يا إلهي

69
00:04:19,930 --> 00:04:24,390
تعود هذه الصّورة إلى أيّام تدريبي
في باريس وعمري 16 سنة

70
00:04:24,720 --> 00:04:27,850
ألا أبدو وسيماً كذلك المُمثّل تاكيا كانيشيرو؟

71
00:04:29,310 --> 00:04:30,690
!أمزح فحسب

72
00:04:31,100 --> 00:04:35,730
كنتَ في مثل سنّي الآن

73
00:04:35,900 --> 00:04:37,150
!شكراً على الانتظار

74
00:04:37,650 --> 00:04:39,820
آيس كريم بالنّعنع والشّوكولا والتّوت

75
00:04:41,450 --> 00:04:43,240
لم أطلب أي كعكة

76
00:04:43,410 --> 00:04:46,700
هذا على حسابنا. أعددتُه بنفسي

77
00:04:46,870 --> 00:04:47,870
يمكنكِ تجربته

78
00:04:49,250 --> 00:04:50,420
سأتناول بعضاً

79
00:04:52,580 --> 00:04:53,670
إنّه شهيّ

80
00:04:54,170 --> 00:04:55,840
!تعلّمتُه من المُدير

81
00:04:56,000 --> 00:04:57,420
!إنّها على الطّريقة الباريسيّة

82
00:04:57,920 --> 00:05:02,260
لدينا زبون مُنتظم يطلب دوماً
تورتة التّوت الأزرق

83
00:05:02,760 --> 00:05:06,930
تذكّرينني به، لذا ارتأيتُ بأنّكِ ستحبّينها

84
00:05:09,430 --> 00:05:10,350
!قادم

85
00:05:11,520 --> 00:05:13,020
هنا باتيسري تشوتشو

86
00:05:13,520 --> 00:05:15,020
جيت؟

87
00:05:15,730 --> 00:05:18,240
تورتة توت أزرق وميل فاي-
!كنّا نتحدّث عنه للتو-

88
00:05:18,400 --> 00:05:21,450
سأوصلها لك كالعادة-
!استمتعي بطعامكِ-

89
00:05:21,610 --> 00:05:22,490
!يا مُدير

90
00:05:22,660 --> 00:05:24,740
!سأوصلها لك

91
00:05:24,910 --> 00:05:26,450
!شكراً لكِ

92
00:05:29,870 --> 00:05:32,710
الزّبائن المُنتظمون هم المُتحرّيات النّجمات؟

93
00:05:32,870 --> 00:05:33,790
مُمكن

94
00:05:34,210 --> 00:05:37,750
أتساءل ما إن كانت قد أدركتْ
بأنّكِ مُتحرّية نجمة

95
00:05:46,680 --> 00:05:47,760
!قادمة

96
00:05:49,180 --> 00:05:51,690
!مرحباً! باتيسري تشوتشو هنا

97
00:05:51,850 --> 00:05:53,020
!كوريا

98
00:05:53,520 --> 00:05:56,440
!كما قال المُدير فحسب، لديكم مكتب جميل

99
00:05:56,610 --> 00:05:59,360
!هذا صحيح! إنّها الزّيارة الأولى لكِ هنا

100
00:05:59,860 --> 00:06:02,860
قطعتِ كلّ هذه المسافة. ما رأيكِ
بفنجان من الشّاي

101
00:06:03,030 --> 00:06:04,360
...ماذا؟ لكن

102
00:06:05,990 --> 00:06:07,240
!كوريا

103
00:06:07,660 --> 00:06:08,580
!من فضلكِ

104
00:06:09,330 --> 00:06:12,210
حسناً، سأحتسي واحداً إذاً

105
00:06:17,310 --> 00:06:19,630
!يبدو شهيّاً جدّاً في كلّ مرّة

106
00:06:26,930 --> 00:06:29,560
هذه أشياء من قضيّة جارية

107
00:06:29,720 --> 00:06:32,270
آسفة، لفتت نظري فحسب

108
00:06:32,430 --> 00:06:37,020
لا عليكِ، لا نعلم ما إن كانت هذه
الأشياء ستقودنا إلى نتيجة

109
00:06:37,190 --> 00:06:39,730
هل هي قضيّة صعبة؟

110
00:06:39,900 --> 00:06:42,860
في الواقع، نبحث عن شخص

111
00:06:43,030 --> 00:06:46,570
لكن يبدو أنّ هذا الشّخص فقدَ ذاكرته

112
00:06:46,740 --> 00:06:50,450
إذا استطاع تذكُّر كُلّ شيء، فستُحلّ القضيّة

113
00:06:51,870 --> 00:06:53,120
...ذاكرته

114
00:06:54,830 --> 00:07:00,130
للكعكة شكل ونكهة، وثمّة أمر مُهمّ آخر

115
00:07:00,300 --> 00:07:01,960
ما هو برأيكما؟

116
00:07:02,130 --> 00:07:04,880
شيء آخر؟-
مُهمّ؟-

117
00:07:09,300 --> 00:07:11,510
!عرفت! العطر

118
00:07:11,680 --> 00:07:12,560
!صحيح

119
00:07:13,270 --> 00:07:16,020
تورتة التّوت الأزرق المُفضّلة لديك

120
00:07:16,190 --> 00:07:20,900
التّوت الأزرق والكسترد رائحتها حُلوة
وتجعل فمك رطباً، صحيح؟

121
00:07:21,070 --> 00:07:22,610
!أجل! كثيراً

122
00:07:22,780 --> 00:07:25,280
!فمك رطب دوماً

123
00:07:26,490 --> 00:07:28,910
العطر لا يتمحور حول الشّهيّة فقط

124
00:07:29,070 --> 00:07:32,700
يُقال بأنّه مُرتبط بشكل وثيق بالذّاكرة

125
00:07:32,870 --> 00:07:34,410
!الذّاكرة... فهمت

126
00:07:34,910 --> 00:07:38,380
...رائحة الميل-فاي الحُلوة
،عندما أشتمّها

127
00:07:38,540 --> 00:07:41,460
!أتذكّر عندما أكلتُها مع جدّتي

128
00:07:41,630 --> 00:07:43,210
عندما كنتِ خارج البلاد؟

129
00:07:43,380 --> 00:07:44,710
!أجل! في لندن

130
00:07:44,880 --> 00:07:47,930
أجل. العطر يُحفّز الذّكريات

131
00:07:48,090 --> 00:07:51,890
!هكذا إذاً! قد يكون العطر والذّاكرة دليلاً

132
00:07:52,640 --> 00:07:54,100
!شكراً جزيلاً لكِ

133
00:07:56,230 --> 00:07:58,270
!يسرّني أنّني كنتُ مُفيدة

134
00:08:03,820 --> 00:08:05,190
!عدتِ

135
00:08:05,360 --> 00:08:08,570
وردتنا معلومة عن وجود جوهرة ماكوتو أُخرى

136
00:08:09,070 --> 00:08:12,080
،في مكان تجمُّع ذي رائحة حُلوة عطِرة

137
00:08:12,240 --> 00:08:15,700
"صفحة واحدة تُحافظ على عطر الّباب

138
00:08:19,830 --> 00:08:21,580
...اكتشفتِه

139
00:08:22,630 --> 00:08:25,920
!أنتِ أهلٌ لذلك! لنذهب فوراً

140
00:08:26,090 --> 00:08:28,170
!هيّا! أركانا شادو

141
00:08:30,300 --> 00:08:36,220
!لاي لاي، سيّدي

142
00:08:38,100 --> 00:08:40,600
!تورتة موسميّة ومون بلان

143
00:08:40,770 --> 00:08:42,730
سأحضرهما حالاً

144
00:08:45,820 --> 00:08:48,820
آسفة لو تأخّرت

145
00:08:48,990 --> 00:08:51,660
المُدير غائب، لذا لا يوجد غيري اليوم

146
00:08:57,410 --> 00:08:59,750
شوكولاتة داكنة وكاراميل

147
00:08:59,910 --> 00:09:00,870
ماذا؟

148
00:09:01,040 --> 00:09:03,500
وسأجلس في الشّرفة اليوم

149
00:09:03,920 --> 00:09:04,920
...حسناً

150
00:09:13,010 --> 00:09:14,510
!شكراً على الانتظار

151
00:09:14,970 --> 00:09:17,560
!تفضّلي الشّوكولاتة الدّاكنة والكاراميل خاصّتك

152
00:09:19,730 --> 00:09:21,270
هذه لكِ

153
00:09:22,400 --> 00:09:25,190
...المعذرة، اليوم

154
00:09:25,360 --> 00:09:28,740
"اليوم على السّادسة مساء، سأسرق الصّورة"

155
00:09:29,240 --> 00:09:31,280
"نقابة اللّصوص الشّبح"

156
00:09:32,320 --> 00:09:35,620
هذه ليست مزحة، أليس كذلك؟

157
00:09:36,410 --> 00:09:38,160
أنتِ لصّة شبح؟

158
00:09:38,750 --> 00:09:40,290
لا أُصدِّق ذلك

159
00:09:40,750 --> 00:09:42,040
...أنتِ لا

160
00:09:42,540 --> 00:09:44,750
لا تعرفين اسمي حتّى

161
00:09:44,920 --> 00:09:46,500
لِمَ تعتقدين ذلك؟

162
00:09:46,670 --> 00:09:49,340
حسناً، هلّا أخبرتِني باسمكِ؟

163
00:09:52,180 --> 00:09:55,100
أعرف شيئاً واحداً عنكِ على الأقلّ

164
00:09:55,260 --> 00:09:58,560
دائماً ما تبدين سعيدة عندما تأكلين
الآيس كريم خاصّتكِ

165
00:09:59,930 --> 00:10:01,680
أعلم ذلك

166
00:10:03,850 --> 00:10:05,770
لا يمكنكِ أخذ الصُّورة

167
00:10:08,980 --> 00:10:10,940
الآيس كريم خاصّتكِ ستذوب

168
00:10:32,420 --> 00:10:34,300
إنّها السّادسة 6 مساء تقريباً

169
00:10:34,470 --> 00:10:37,640
،بحسب وصف كوريا للصّ الشّبح

170
00:10:37,800 --> 00:10:39,970
لا بُدّ أنّها لولوكا

171
00:10:40,680 --> 00:10:42,270
أجل، هذه هي

172
00:10:42,430 --> 00:10:43,850
إنّها خصمٌ قويّ

173
00:10:44,020 --> 00:10:45,690
لا أحد يعلم ما قد يفعله

174
00:10:45,850 --> 00:10:48,440
!قد تتنكّر ثانية

175
00:10:48,610 --> 00:10:51,780
على أيّ حال، لن نسمح لها
بسرقة الصّورة، صحيح؟

176
00:10:51,940 --> 00:10:52,740
أجل

177
00:10:55,490 --> 00:10:56,990
نهج مُباشر؟

178
00:10:57,320 --> 00:10:59,370
هل استأجرتِ المُتحرّيتين؟

179
00:10:59,830 --> 00:11:02,160
هذا ما أردتِه، أليس كذلك؟

180
00:11:02,330 --> 00:11:06,460
في نهاية المطاف، كانت لديكِ الكثير
من الفُرص لسرقة الصّورة

181
00:11:07,170 --> 00:11:10,750
لكن تكبّدتِ عناء تسليم بطاقة زيارة

182
00:11:11,250 --> 00:11:14,800
وذلك كي أطلب المُساعدة من وكالة
التحرّي كيوريتو

183
00:11:15,880 --> 00:11:17,680
استنتاج مُثير للاهتمام

184
00:11:18,090 --> 00:11:19,640
!لا يمكنك الحصول على الصّورة

185
00:11:19,800 --> 00:11:20,760
!أجل

186
00:11:21,260 --> 00:11:22,640
!لا داعي للقلق

187
00:11:25,390 --> 00:11:29,690
!أنا، غويمون، لديّ إيّاها هنا

188
00:11:29,860 --> 00:11:33,400
ماذا؟-
كانت لولوكا طعماً؟-

189
00:11:33,570 --> 00:11:34,990
!لم نفكّر في ذلك

190
00:11:35,150 --> 00:11:37,200
!لم تطلب منّي ذلك

191
00:11:37,360 --> 00:11:40,120
!أنا مُجرّد لصّ قدير نافع

192
00:11:42,240 --> 00:11:43,410
