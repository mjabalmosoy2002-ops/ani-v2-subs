00:12:47,480 --> 00:12:48,520
!إكلير

194
00:12:49,190 --> 00:12:51,230
يبدو أنّني أخطأتُ الحِسابات

195
00:12:51,400 --> 00:12:53,440
أنتِ لا تعرفين قوّتكِ

196
00:12:53,610 --> 00:12:56,070
لا تعرفين من تكونين

197
00:12:57,070 --> 00:13:00,860
لا أحد يعرف شيئاً. يبقى اللّغزُ لغزاً

198
00:13:01,820 --> 00:13:04,280
أنتِ وحيدةٌ تماماً

199
00:13:07,290 --> 00:13:08,160
!لا

200
00:13:10,080 --> 00:13:11,580
!لديها نحن

201
00:13:24,390 --> 00:13:25,850
!لديها نحن

202
00:13:27,180 --> 00:13:28,770
!أتيتن أخيراً

203
00:13:29,270 --> 00:13:30,230
...الجميع

204
00:13:30,390 --> 00:13:31,980
!هيّا بنا-
أجل-

205
00:13:32,650 --> 00:13:33,770
!افتحي

206
00:13:42,410 --> 00:13:44,370
!عصا أركانا المُنيرة

207
00:13:48,370 --> 00:13:51,000
!بريكيور! حان وقت الاستيقاظ

208
00:13:53,620 --> 00:13:56,000
المعي أيّتها الزّنبقة البيضاء

209
00:14:04,840 --> 00:14:06,220
!صنبور الزّهور

210
00:14:27,080 --> 00:14:33,750
،الضّوء الأبيض الّذي يُنير الحقيقة
!المُتحرّية النّجمة، كيور أركانا

211
00:14:41,460 --> 00:14:42,590
!افتح

212
00:14:47,720 --> 00:14:49,430
!ساعة جوهرة كيور

213
00:14:52,060 --> 00:14:54,690
!بريكيور! وقت الاستيقاظ

214
00:14:54,850 --> 00:14:56,810
!ثلاثة! اكتشفي

215
00:15:09,530 --> 00:15:11,660
!ستّة! وواجها بعضيكما الآخر

216
00:15:23,590 --> 00:15:26,180
!تسعة! نحن الثّنائي الإعجازيّ

217
00:15:35,020 --> 00:15:36,850
!دوري

218
00:15:37,020 --> 00:15:38,810
!وأنهي الأمر بشكل ظريف

219
00:16:02,920 --> 00:16:08,930
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، أنسر كيور

220
00:16:11,180 --> 00:16:14,310
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

221
00:16:14,470 --> 00:16:17,640
!المُتحرّية النّجمة، كيور ميستيك

222
00:16:21,770 --> 00:16:23,900
!المُتحرّية النّجمة بريكيور

223
00:16:25,690 --> 00:16:28,240
!أرِهن قوّتك يا هانّيندا

224
00:16:28,780 --> 00:16:30,660
!هانّين! هانّيندا

225
00:16:32,870 --> 00:16:35,450
!هان

226
00:16:38,500 --> 00:16:40,120
!إنّه قويٌّ جدّاً

227
00:16:40,830 --> 00:16:43,290
أجل. هذه قوّة شادو

228
00:16:47,300 --> 00:16:48,470
...الجميع

229
00:16:49,840 --> 00:16:54,260
!صديقات؟ لا علاقة لهن بالقوّة

230
00:16:55,390 --> 00:16:57,730
!هانّين. هانّيندا

231
00:16:58,350 --> 00:16:59,190
!بل هي كذلك

232
00:17:01,020 --> 00:17:01,810
!هان

233
00:17:05,780 --> 00:17:09,530
!عندما كنتُ حزينة، أعدّتْ لي كعكة شهيّة

234
00:17:13,660 --> 00:17:15,240
!هان

235
00:17:15,410 --> 00:17:19,750
!أنقذتْني إكلير من أوسونوار
!مدّتني بالشّجاعة

236
00:17:21,870 --> 00:17:24,750
!نين

237
00:17:24,920 --> 00:17:28,260
ما كنتُ لأتواجد هنا لولا إكلير

238
00:17:28,420 --> 00:17:29,720
!وجدتُ إجابتي

239
00:17:31,470 --> 00:17:33,140
...دا! دا

240
00:17:36,680 --> 00:17:37,470
ماذا؟

241
00:17:37,640 --> 00:17:38,720
!الجميع

242
00:17:38,890 --> 00:17:40,690
!لهذا نحن قويّات

243
00:17:40,850 --> 00:17:41,690
!لن نخسر

244
00:17:41,850 --> 00:17:42,940
هذه هي الصّداقة

245
00:17:45,060 --> 00:17:47,570
هذا ليس جواباً

246
00:17:51,610 --> 00:17:54,450
...يبقى اللّغزُ لغزاً. رغم ذلك

247
00:17:54,620 --> 00:17:59,040
لا نعرف كافّة الألغاز، ورُبّما لن نعرف أبداً

248
00:17:59,200 --> 00:18:00,330
...رغم ذلك

249
00:18:00,790 --> 00:18:02,000
...ما أعرفه

250
00:18:02,420 --> 00:18:07,380
!ما علّمني إيّاه قلبي. لَمَعاني

251
00:18:07,840 --> 00:18:12,170
تعتبرين نفسكِ مُتحرّية نجمة، مع ذلك
تقولين بأنّ اللّغز يمكن أن يبقى لغزاً؟

252
00:18:12,340 --> 00:18:14,340
لا تحتاجين معرفة الإجابة؟

253
00:18:14,510 --> 00:18:15,640
...أنا

254
00:18:15,800 --> 00:18:20,600
،مُتحرّية وحلوانيّة وملِكة عظيمة
!كُلّ هذا جزء منّي

255
00:18:20,770 --> 00:18:23,270
أصدقائي علّموني ذلك

256
00:18:23,940 --> 00:18:28,610
حقيقة قلبي... هي رسم
!البسمة في وجه الجميع

257
00:18:31,440 --> 00:18:35,280
!لَمعَان حقيقتي لا ينطفئ أبداً

258
00:18:35,450 --> 00:18:39,240
حتّى لو بقي لغز قوّتي لغزاً

259
00:18:39,410 --> 00:18:41,700
!ستكون قوّة لإنقاذ الجميع

260
00:18:42,200 --> 00:18:44,210
!هذا هو جوابي

261
00:18:56,510 --> 00:19:00,060
!استجابتْ لمشاعري

262
00:19:02,020 --> 00:19:03,600
!دعنَ الباقي لي

263
00:19:07,270 --> 00:19:08,730
!وقت اللّمعان

264
00:19:10,980 --> 00:19:13,440
!والآن سأستجيب للجميع

265
00:19:13,820 --> 00:19:16,610
!هان! نين! دا

266
00:19:17,950 --> 00:19:20,490
...ما تلك القوّة؟ إنّها حتماً ليست

267
00:19:20,660 --> 00:19:23,500
...هان... نين... دا

268
00:19:24,080 --> 00:19:25,830
!الآن يا إكلير

269
00:19:29,250 --> 00:19:30,210
!افتحي

270
00:19:33,670 --> 00:19:35,340
!يا عدسة المرآة المُكبِّرة بري-كيت

271
00:19:35,840 --> 00:19:36,760
!شوشوتان

272
00:19:39,600 --> 00:19:40,810
جوهرة ماكوتو

273
00:19:47,400 --> 00:19:49,440
!كيور إكلير ستُغلق هذه القضيّة

274
00:19:56,860 --> 00:20:02,200
أبسط جناحَي بأناقة وأحلّ اللّغز

275
00:20:02,950 --> 00:20:04,950
هذا هو جوابي

276
00:20:09,130 --> 00:20:13,300
!بريكيور! تحليق بلا حدود

277
00:20:27,560 --> 00:20:28,980
!إغلاق ملفّ القضيّة كيوريتو

278
00:20:29,560 --> 00:20:34,280
!هان! نين! دا

279
00:20:43,200 --> 00:20:45,830
!بوتشي بوتشي كيور كيور

280
00:20:55,170 --> 00:20:58,840
هل كانت تلك قوّة دبّوس نجم كيرارينغ؟

281
00:20:59,010 --> 00:21:00,760
!إكلير، كنتِ مُذهلة

282
00:21:00,930 --> 00:21:02,390
!مُذهلة، مُذهلة

283
00:21:02,550 --> 00:21:05,350
!لقّنتِه درساً-
!فعلتْ ذلك بالطّبع-

284
00:21:05,510 --> 00:21:06,850
ممتازة كعادتكِ

285
00:21:07,520 --> 00:21:10,230
!فأنا الملِكة العظيمة الأظرف في العالم

286
00:21:15,360 --> 00:21:17,690
الأضواء الأربعة من النّبوءة

287
00:21:18,780 --> 00:21:21,410
إنّه دبّوس نجم كيرارينغ

288
00:21:23,820 --> 00:21:26,490
!شكراً جزيلاً لكُن أيّتها المُتحرّيات

289
00:21:27,870 --> 00:21:29,330
!سأغادر

290
00:21:29,500 --> 00:21:31,000
!رحلة مُوفّقة

291
00:21:31,170 --> 00:21:32,920
يسرّني أنّها وصلَتْ في الوقت

292
00:21:33,580 --> 00:21:36,000
لماذا تلمع يا تُرى؟

293
00:21:36,170 --> 00:21:37,130
لا أعلم

294
00:21:37,300 --> 00:21:39,970
!يبقى اللّغز لغزاً

295
00:21:40,130 --> 00:21:46,010
لكن حتّى لو كنّا لا نعلم كيف هي آليّة
الخاتم، ستخبرنا الحقائق

296
00:21:46,180 --> 00:21:49,480
أضاءت إحدى المُجوهرات الأربع

297
00:21:49,640 --> 00:21:50,890
هذه حقيقة

298
00:21:51,060 --> 00:21:56,070
،إذاً ربّما إذا أضاءت الثّلاث الأُخرى
!سنتمكّن من إخراج الخاتم

299
00:21:56,230 --> 00:21:59,150
!أنا متأكّدة من ذلك! أنتِ ذكيّةٌ جدّاً يا شوشوتان

300
00:21:59,320 --> 00:22:00,610
!أحم

301
00:22:02,820 --> 00:22:05,910
!انظروا! إنّها طائرة إيكوي

302
00:22:06,080 --> 00:22:09,540
!عاصمة الزُّهور باريس! لا بُدّ إنّ المشهد جميل

303
00:22:09,700 --> 00:22:12,040
!رحلة مُوفّقة

304
00:23:47,380 --> 00:23:50,100
!اليوم هو يوم الهالوين! لنستمتع معاً

305
00:23:50,260 --> 00:23:52,600
!انظروا إلى كلّ هؤلاء النّاس بالزيّ التنكُّريّ

306
00:23:52,770 --> 00:23:54,350
وكثير من الحلويّات اللّذيذة

307
00:23:54,520 --> 00:23:57,770
،ذلك الشّخص بزيّ السّاحرة التنكُّريّ
أيُعقَل ذلك؟

308
00:23:58,810 --> 00:24:01,860
!المُتحرِّية النّجمة بريكيور
"هالوين أوجاماجو"

309
00:24:02,020 --> 00:24:04,570
!أغلِقَ ملفّ قضيّة اللّغز كيوريتّو