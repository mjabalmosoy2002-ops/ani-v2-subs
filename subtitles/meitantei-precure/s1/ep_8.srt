1
00:00:18,430 --> 00:00:21,140
!بوتشيتان، أنتِ ظريفة جدّاً

2
00:00:21,310 --> 00:00:24,230
!تحصلين على العلامة التامّة في الظّرافة

3
00:00:24,390 --> 00:00:28,070
أنتما أكثر حيويّة من المعتاد

4
00:00:28,230 --> 00:00:30,070
!لكنّها ظريفة للغاية

5
00:00:31,990 --> 00:00:34,070
وأيضاً من أين أتيت بهذه الملابس؟

6
00:00:34,660 --> 00:00:36,820
!أنا من صنعها بالطّبع

7
00:00:36,990 --> 00:00:39,870
تقصد بأنّك أنت من صنعها؟

8
00:00:40,040 --> 00:00:40,870
!أجل

9
00:00:41,040 --> 00:00:43,540
ارتأيتُ بأنّ بوتشيتان أرادت
أن تكون بريكيور أيضاً

10
00:00:43,710 --> 00:00:46,170
لذا صمّمتُها وصنعتُها

11
00:00:49,090 --> 00:00:49,880
ماذا؟

12
00:00:50,340 --> 00:00:51,300
ما الأمر؟

13
00:00:52,170 --> 00:00:53,630
!أنت مُذهل

14
00:00:55,090 --> 00:00:58,680
أن تتمكّن من صنع أشياء ظريفة
!كهذه، هذا مُدهش للغاية

15
00:00:58,850 --> 00:01:04,390
بوتشيتان ظريفة أساساً، وهي
!أظرف بمئة مرّة بزيّها

16
00:01:04,560 --> 00:01:06,900
!جيت-سينباي، أنت عبقريّ

17
00:01:08,190 --> 00:01:09,360
!أعلم

18
00:01:09,980 --> 00:01:12,480
،كنتُ أتساءل حول هذا الأمر لبعض الوقت

19
00:01:12,650 --> 00:01:16,320
لكن كلّ ما تصنعه ظريف جدّاً

20
00:01:16,490 --> 00:01:19,280
كيف تصنع أشياء ظريفة كهذه؟

21
00:01:19,450 --> 00:01:20,910
!لأنّني عبقريّ

22
00:01:21,080 --> 00:01:24,250
حسناً، لم أكن هكذا دوماً

23
00:01:24,410 --> 00:01:27,420
درستُ الظّرافة بجدّية

24
00:01:27,920 --> 00:01:30,750
البري-كيت خاصّتك ظريفة جدّاً

25
00:01:30,920 --> 00:01:35,260
من المُؤسف أن نكون الوحيدات
اللّواتي نحظى بها

26
00:01:36,880 --> 00:01:39,720
جيت-سينباي، لِمَ لا تفتتح متجراً؟

27
00:01:40,470 --> 00:01:41,810
متجر؟

28
00:01:46,850 --> 00:01:50,610
!لنبحث عن اللّمحة في القلب

29
00:01:50,770 --> 00:01:53,860
إلهام مُشرِق

30
00:01:54,110 --> 00:01:56,740
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

31
00:01:56,900 --> 00:01:59,530
إنّها تنادينا

32
00:01:59,700 --> 00:02:02,370
أين الحقيقة؟ ما الّذي ستكتشفه؟

33
00:02:02,530 --> 00:02:06,000
لغز تلو الآخر

34
00:02:06,790 --> 00:02:12,130
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

35
00:02:12,290 --> 00:02:17,510
كما الدّليل! شيء يلمع عبر الزّمن

36
00:02:17,670 --> 00:02:20,340
كيف؟ كيف؟ أهي خدعة؟

37
00:02:20,510 --> 00:02:23,180
لماذا؟ لماذا؟ سوف نواجهها

38
00:02:23,600 --> 00:02:28,770
لننظر ونشعر
نكتشف الأسرار

39
00:02:29,230 --> 00:02:34,730
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

40
00:02:35,070 --> 00:02:40,280
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

41
00:02:40,530 --> 00:02:45,950
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

42
00:02:46,120 --> 00:02:49,500
!لنمشِ في ذلك الطّريق معاً

43
00:02:49,660 --> 00:02:53,420
!لنبحث عن اللّمحة في القلب

44
00:02:53,630 --> 00:02:55,250
إلهام مُشرِق

45
00:02:55,420 --> 00:03:01,090
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

46
00:03:01,260 --> 00:03:06,180
ولادتنا ولقاؤنا لَهو لغز رائع

47
00:03:06,350 --> 00:03:09,810
!هيّا يا بريكيور المُتحرّيات النّجمات

48
00:03:21,150 --> 00:03:28,450
أعتقد ينبغي أن نصنع بعض الأدوات
الظّريفة استناداً إلى بري-كيت ونبيعها

49
00:03:28,620 --> 00:03:32,960
فكرة سديدة! يمكننا استخدام المساحة
!الفارغة في الطّابق الثّاني كمتجر

50
00:03:33,130 --> 00:03:34,250
!عظيم

51
00:03:34,420 --> 00:03:37,210
سنُساعدك. ما رأيك؟

52
00:03:38,050 --> 00:03:40,630
...لكن مع ذلك

53
00:03:40,800 --> 00:03:44,800
يُفترَض أن تتركّز أعمالي على التّحرّي

54
00:03:44,970 --> 00:03:50,020
سيصبّ هذا في مصلحة وكالة
التّحرّي كيوريتو أيضاً

55
00:03:50,180 --> 00:03:52,270
سيأتي النّاسُ إلى المتجر

56
00:03:52,440 --> 00:03:55,400
سيمرّون من جانب وكالة التحرّي

57
00:03:55,560 --> 00:03:58,400
سيعلمون بوجود وكالة تحرّي هنا

58
00:03:59,030 --> 00:04:03,490
،حالما يعلمون، إن حدث شيء
!سيطلبون مُساعدتنا

59
00:04:03,950 --> 00:04:06,320
فهمت. هذا منطقيّ

60
00:04:07,660 --> 00:04:10,500
حسناً، لنحاول افتتاح متجر

61
00:04:10,660 --> 00:04:12,120
!مرحى

62
00:04:14,000 --> 00:04:19,050
،سيترتّب عليّ صنع مُنتجات ذات شعبيّة
!وسندرّ مالاً طائلاً

63
00:04:19,210 --> 00:04:23,050
وجدتُها! ما رأيك أن تصنع
مُلمّع شفاه كمُنتج؟

64
00:04:23,220 --> 00:04:27,180
!أجل! لطالما كنتُ مُهتمّة بالمكياج

65
00:04:27,350 --> 00:04:29,220
!متجر مُستحضرات تجميل إذاً

66
00:04:29,390 --> 00:04:32,430
!أريد شيئاً ذا رائحة جميلة

67
00:04:32,600 --> 00:04:36,100
!أنتما تُريدان شيئاً لنفسيكما فحسب

68
00:04:38,020 --> 00:04:42,150
على أيّ حال، سأعدّ بعض النّماذج

69
00:04:45,030 --> 00:04:48,870
المُتحرّيتان النّجمتان بريكيور
!تتصدّيان لنا من كلّ جانب

70
00:04:49,370 --> 00:04:55,920
دع تلكما المُزعجتين لي. هذه
المرّة وبكلّ تأكيد. سأدحرهما

71
00:04:57,130 --> 00:04:58,920
لا حاجة

72
00:04:59,090 --> 00:04:59,920
ماذا؟

73
00:05:00,300 --> 00:05:04,340
ورد في مُجلّد السّرابات بأنّ
هناك جوهرة ماكوتو جديدة

74
00:05:05,180 --> 00:05:07,590
اذهب واجمعها

75
00:05:07,760 --> 00:05:08,720
...أجل، ولكن

76
00:05:09,220 --> 00:05:13,480
ركّز على سرقة مجوهرات ماكوتو

77
00:05:14,180 --> 00:05:17,480
لاي لاي، سيّدي

78
00:05:18,150 --> 00:05:21,610
هل يمكنه الحصول عليه من دون
الاصطدام مع البريكيور؟

79
00:05:22,440 --> 00:05:23,490
لا أدري

80
00:05:24,900 --> 00:05:26,910
!حسناً، سوف نُنظّف

81
00:05:27,070 --> 00:05:28,740
!لنفعلها

82
00:05:28,910 --> 00:05:30,120
!أجل

83
00:05:30,280 --> 00:05:33,250
أريد عرض مُنتجاتنا هنا

84
00:05:33,410 --> 00:05:36,080
نحتاج بعض صناديق التّخزين

85
00:05:36,250 --> 00:05:39,210
ماذا لو وضعنا بعض الزُّهور هنا؟

86
00:05:39,380 --> 00:05:42,460
!جميل! لنطلب بعضاً من متجر الزّهور

87
00:05:49,390 --> 00:05:51,180
!حان وقت اللّمسة النّهائيّة

88
00:05:54,720 --> 00:05:58,400
!بوري بوري، بريتي سمايل

89
00:06:02,270 --> 00:06:03,320
بوري بوري؟

90
00:06:03,480 --> 00:06:04,860
بريتي سمايل؟

91
00:06:05,240 --> 00:06:06,740
!بئساً

92
00:06:07,320 --> 00:06:09,660
!لـ-لا تدخلا هكذا فجأة

93
00:06:09,820 --> 00:06:12,080
!كانت هناك قلوب ظريفة تطير

94
00:06:12,240 --> 00:06:13,410
ماذا كان ذلك؟

95
00:06:14,240 --> 00:06:16,000
كانت تلك لمستي الأخيرة

96
00:06:16,160 --> 00:06:19,370
أفعلها أيضاً لجعل أدوات
بري-كيت تنكمش

97
00:06:19,540 --> 00:06:20,380
هذه؟

98
00:06:20,790 --> 00:06:24,840
أجل، سأملئها بقوّة جنّيات خاصّة

99
00:06:25,010 --> 00:06:28,470
هل يمتلك هذا النّاظور قوى خاصّة؟

100
00:06:29,010 --> 00:06:31,050
لا يمتلك النّاظور قوى

101
00:06:31,220 --> 00:06:34,720
أرتديه كحِلية جالبة للحظّ

102
00:06:36,730 --> 00:06:40,690
منذ زمن بعيد، اخترعتُ أشياء
مع زملائي في الدّراسة

103
00:06:41,270 --> 00:06:45,610
كنّا نتنافس لنرَ من يستطيع
أن يصنع أفضل اختراع

104
00:06:48,320 --> 00:06:50,990
!مُذهل، خطّه جميل

105
00:06:51,160 --> 00:06:52,530
!سهل الاستعمال

106
00:06:52,700 --> 00:06:54,030
!أنت مُذهل يا جيت

107
00:06:54,490 --> 00:06:58,910
آنذاك، الأداء في الاختراعات
كان الأهمّ بالنّسبة لي

108
00:06:59,080 --> 00:07:01,170
ظننتُ بأنّ المظهر ليس مُهمّاً

109
00:07:01,960 --> 00:07:02,790
...لكن

110
00:07:03,420 --> 00:07:05,210
!شينيان

111
00:07:05,380 --> 00:07:06,920
!مرحباً

112
00:07:07,090 --> 00:07:09,550
ماذا صنعت؟

113
00:07:11,550 --> 00:07:13,090
هذا

114
00:07:13,600 --> 00:07:15,560
!ظريف للغاية

115
00:07:16,810 --> 00:07:18,020
!مُذهل

116
00:07:18,180 --> 00:07:23,940
كانت اختراعات مُعلّمتنا شينيان
الأشهر دوماً

117
00:07:28,150 --> 00:07:29,110
ماذا؟

118
00:07:31,570 --> 00:07:35,370
!بوري بوري، بريتي سمايل

119
00:07:39,540 --> 00:07:40,830
بوري بوري؟

120
00:07:41,000 --> 00:07:46,340
إنّها أُمنية لرسم الابتسامة
في وجه كلّ مَن يستخدمها

121
00:07:47,880 --> 00:07:51,760
الاختراعات تجعل الحياة
والعمل أكثر بساطة

122
00:07:51,930 --> 00:07:56,550
لكن يجب ألّا ننسى تغذية الرُّوح

123
00:07:57,140 --> 00:08:01,020
الحماس الّذي يرسم الابتسامات مُهمّ أيضاً

124
00:08:10,320 --> 00:08:15,070
بعد ذلك، بدأتُ بإضافة
الظّرافة لاختراعاتي

125
00:08:16,200 --> 00:08:21,500
اختراعاتك ترسم البسمة في وجهي حقّاً

126
00:08:21,660 --> 00:08:23,870
كان لديك مُعلّمة لطيفة جدّاً

127
00:08:24,040 --> 00:08:30,090
كان هذا النّاظور لشينيان. أعطتني
إيّاه عندما تخرّجت

128
00:08:30,260 --> 00:08:32,550
!إنّها كنز بالنّسبة لك

129
00:08:35,180 --> 00:08:36,300
!على ما أعتقد

130
00:08:37,970 --> 00:08:39,510
إنّها هنا

131
00:08:42,270 --> 00:08:43,270
...لحظة

132
00:08:43,890 --> 00:08:44,940
!مستحيل

133
00:08:45,350 --> 00:08:47,650
!المُتحرّيات النّجمات بريكيور

134
00:08:47,810 --> 00:08:50,610
!إنّه مقرّ المُتحرّيات النّجمات بريكيور

135
00:08:51,070 --> 00:08:53,650
...لم أخطّط للتورُّط مع بريكيور

136
00:08:54,530 --> 00:08:59,240
لكن! حان الوقت لأسعى للتألُّق

137
00:09:01,120 --> 00:09:03,160
سأسرقها بخفّة

138
00:09:03,660 --> 00:09:04,620
يا عزيزي

139
00:09:10,800 --> 00:09:12,090
!حسناً

140
00:09:12,550 --> 00:09:16,380
!بوري بوري، بريتي سمايل

141
00:09:16,550 --> 00:09:22,140
!سمايل

142
00:09:24,560 --> 00:09:27,690
!بوري بوري، بريتي سمايل

143
00:09:33,360 --> 00:09:34,530
!مرحباً

144
00:09:34,690 --> 00:09:36,570
!أنا من كاميليا للدّيكور الدّاخليّ

145
00:09:36,740 --> 00:09:39,740
!أحضرتُ صندوق التّخزين الّذي طلبته

146
00:09:39,910 --> 00:09:42,540
!تشيهو! شكراً جزيلاً لكِ

147
00:09:42,700 --> 00:09:45,290
أردنا استخدامه في الطّابق الثّاني

148
00:09:45,460 --> 00:09:48,080
هل أنقله إلى الطّابق الثّاني؟

149
00:09:48,250 --> 00:09:49,210
!أجل، من فضلك

150
00:09:50,000 --> 00:09:51,290
!مرحباً

151
00:09:51,460 --> 00:09:53,550
أنا من متجر هاناموري للزّهور

152
00:09:53,710 --> 00:09:57,010
أحضرتُ نباتات مُؤصّصة وزهور مُشذّبة

153
00:09:57,180 --> 00:09:58,800
!شكراً جزيلاً لك

154
00:09:58,970 --> 00:10:01,720
هل يمكننا أن نُقرّر بعد
أن نضعها في المتجر؟

155
00:10:01,890 --> 00:10:02,970
!بالطّبع

156
00:10:03,140 --> 00:10:06,680
جيت! أحضرتُ حلويّاتك المعتادة

157
00:10:06,850 --> 00:10:09,350
حضرة المُدير! شكراً على تسليمها دوماً

158
00:10:09,810 --> 00:10:11,940
أنا من ينبغي أن يشكرك

159
00:10:12,110 --> 00:10:14,570
فأنت أحد أفضل زبائننا

160
00:10:15,190 --> 00:10:17,360
انتظر! سأحضر المال

161
00:10:17,530 --> 00:10:21,120
حسناً! سأذهب وأضع
الكعكة في الثلّاجة

162
00:10:27,000 --> 00:10:27,870
بئساً

163
00:10:28,040 --> 00:10:30,250
سنساعدك-
!شكراً لك-

164
00:10:36,840 --> 00:10:38,510
حصلتُ عليها أخيراً

165
00:10:40,890 --> 00:10:41,930
حسناً

166
00:10:52,440 --> 00:10:54,360
!اختفى! لقد اختفى

167
00:10:54,520 --> 00:10:55,860
ما الأمر؟

168
00:10:56,030 --> 00:10:57,400
ما الّذي اختفى؟

169
00:10:57,570 --> 00:10:59,280
!ناظوري اختفى

170
00:10:59,450 --> 00:11:01,740
!أنا متأكّد بأنّني وضعتُه هنا

171
00:11:01,910 --> 00:11:03,660
!دع الأمر لنا

172
00:11:07,660 --> 00:11:08,450
!افتحي

173
00:11:11,290 --> 00:11:13,130
!عدسة المرآة المُكبِّرة بري-كيت

174
00:11:13,880 --> 00:11:15,210
أزيلي الغطاء

175
00:11:16,130 --> 00:11:18,050
!وضع عدسة المرآة! تشغيل

176
00:11:18,550 --> 00:11:22,550
!بعدسة المرآة، يمكننا إيجاد أيّ دليل

177
00:11:25,050 --> 00:11:27,020
الكثير من آثار الأقدام

178
00:11:27,180 --> 00:11:29,430
!امسحي آثار أقدامنا

179
00:11:33,900 --> 00:11:35,520
!اكتشاف ذهبيّ

180
00:11:35,690 --> 00:11:37,690
!هناك ثلاث مجموعات من الآثار

181
00:11:37,860 --> 00:11:43,280
آثار الأقدام هي من تشيهو
والسّيّد هاناموري وتايرا

182
00:11:43,820 --> 00:11:47,910
هل كنتِ تستجيبين لناظور جيت-سينباي؟

183
00:11:49,580 --> 00:11:52,420
أحد اللّصوص الشّبح قد أخذ النّاظور

184
00:11:52,580 --> 00:11:55,340
لكن ولا واحدة من هذه الآثار
تُشبه آثار أقدامه

185
00:11:55,840 --> 00:11:59,800
إذاً اللّصّ الشّبح هو أحد زُوّارنا الثّلاثة

186
00:12:02,090 --> 00:12:05,050
!الجاني بينهم

187
00:12:08,100 --> 00:12:14,100
أخذتُ صندوق التّخزين الّذي طلبتِه إلى
الطّابق العلويّ وقمتُ بجولة في المتجر

188
00:12:14,270 --> 00:12:16,810
كنتُ أبحث عن أفكار تصميم للدّيكور

189
00:12:17,360 --> 00:12:21,190
كنتُ أضع الكعكة في ثلّاجة وكالة التحرّي

190
00:12:21,740 --> 00:12:28,870
كنتُ أحمل الزّهور إلى الطّابق الثّاني عندما
سمعتُ صوتاً وسارعتُ للنّزول

191
00:12:29,740 --> 00:12:33,410
لا شيء يبدو غريباً في تصرُّفات
وحجج براءة الجميع

192
00:12:33,580 --> 00:12:35,210
فمن فعل ذلك إذاً؟

193
00:12:38,420 --> 00:12:39,750
...بوتشي

194
00:12:39,960 --> 00:12:42,510
ماذا؟ هل سمعتُ "بوتشي"؟

195
00:12:42,670 --> 00:12:44,430
تلك الحقيبة تكلّمتْ؟

196
00:12:44,930 --> 00:12:47,350
لـ-لا بُدّ أنّكم تتخيّلون! صحيح؟

197
00:12:47,510 --> 00:12:49,470
!كانت معدتي تُقرقر

198
00:12:49,640 --> 00:12:52,230
بوتشي بوتشي، أنا جائعة بالتّأكيد

199
00:12:53,690 --> 00:12:55,690
!يا لشهيّتك المفتوحة

200
00:13:03,570 --> 00:13:04,780
!هكذا إذاً

201
00:13:04,950 --> 00:13:06,990
!هذا هو الجواب

202
00:13:07,820 --> 00:13:10,280
...الجاني هو-
!ذلك الشّخص...-

203
00:13:21,500 --> 00:13:22,510
!توقّف

204
00:13:23,130 --> 00:13:25,680
...الشّخص الّذي سرق النّاظور

205
00:13:26,630 --> 00:13:28,140
!هو أنت

206
00:13:28,340 --> 00:13:30,100
ماذا؟ الجاني؟

207
00:13:30,510 --> 00:13:31,760
أنا؟

208
00:13:31,930 --> 00:13:33,350
ماذا تقصدان؟

209
00:13:33,890 --> 00:13:35,480
!لا تتظاهر بالبراءة أمامنا

210
00:13:36,020 --> 00:13:39,770
عندما تكلّمتْ "حقيبتي"، تفاجأ الجميع

211
00:13:39,940 --> 00:13:42,070
!الجميع سِواك

212
00:13:42,650 --> 00:13:45,950
الوحيدون الآخرون الّذين يعلمون
...بأمر بوتشيتان

213
00:13:46,110 --> 00:13:48,240
!هُم نقابة اللّصوص الشّبح...

214
00:13:52,330 --> 00:13:53,660
!مُدهش

215
00:13:53,830 --> 00:13:55,790
،كزهرة جميلة

216
00:13:55,960 --> 00:14:00,040
كنتُ سأغادر وأنا بتنكُّري المثاليّ

217
00:14:00,210 --> 00:14:02,590
كشفتُماني ببراعة يا عزيزتايّ

218
00:14:03,170 --> 00:14:04,090
!نيجي

219
00:14:04,260 --> 00:14:05,720
!أعِد النّاظور لي

220
00:14:05,880 --> 00:14:08,890
آسف، لكن لا أستطيع فعل ذلك

221
00:14:10,350 --> 00:14:11,890
!أيّتها الأكاذيب، طوّقي

222
00:14:12,640 --> 00:14:15,180
!تعال يا هانّيندا

223
00:14:21,770 --> 00:14:24,440
!هانّيندا

224
00:14:24,860 --> 00:14:26,570
!ناظور شينيان

225
00:14:26,740 --> 00:14:27,780
!جيت-سينباي

226
00:14:29,030 --> 00:14:30,200
!لا داعي للقلق

227
00:14:30,370 --> 00:14:33,490
!سنستعيده بكلّ تأكيد

228
00:14:38,540 --> 00:14:39,670
!افتحي

229
00:14:44,630 --> 00:14:46,340
!ساعة جوهرة كيور

230
00:14:48,970 --> 00:14:51,590
!بريكيور! وقت الاستيقاظ

231
00:14:51,760 --> 00:14:53,720
!ثلاثة! اكتشفي

232
00:15:06,440 --> 00:15:08,360
!ستّة! ومُقابل بعضيهما الآخر

233
00:15:20,410 --> 00:15:22,750
!تسعة! نحن الثّنائي الإعجازيّ

234
00:15:32,010 --> 00:15:33,850
!دوري

235
00:15:34,010 --> 00:15:35,720
!وأنهي الأمر بشكل ظريف

236
00:15:59,870 --> 00:16:05,500
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، أنسر كيور

237
00:16:08,000 --> 00:16:11,300
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

238
00:16:11,470 --> 00:16:14,470
!المُتحرّية النّجمة، كيور ميستيك

239
00:16:18,560 --> 00:16:20,770
!المُتحرّية النّجمة بريكيور

240
00:16:23,270 --> 00:16:25,770
!سأُريك إجابتي

241
00:16:25,940 --> 00:16:29,940
!هانّيندا

242
00:16:36,570 --> 00:16:38,660
!هانّيندا

243
00:16:42,410 --> 00:16:43,540
!ميستيك

244
00:16:45,250 --> 00:16:47,710
!هانّيندا

245
00:16:50,880 --> 00:16:53,010
!أنسر! ميستيك

246
00:16:55,640 --> 00:16:59,930
من أيّ جهة تقتربان، سيُصوَّب عليكما

247
00:17:00,100 --> 00:17:02,310
لا أمل لديكما في الفوز

248
00:17:14,030 --> 00:17:17,620
كلّ هذه الجلبة لأجل ناظور

249
00:17:17,780 --> 00:17:20,330
العالم مليء بالأشياء

250
00:17:20,490 --> 00:17:23,000
لِمَ لا تشترون ناظوراً جديداً فحسب؟

251
00:17:24,460 --> 00:17:25,790
!لا غنى عنه

252
00:17:27,420 --> 00:17:29,590
إنّه ليس مُجرّد ناظور

253
00:17:29,750 --> 00:17:32,630
!بالنّسبة لجيت-سينباي، إنّه فريد من نوعه

254
00:17:32,800 --> 00:17:34,220
!إنّه مُهمٌّ بالنّسبة له

255
00:17:34,380 --> 00:17:37,720
!إنّه كنز يرسم البسمة في وجه الجميع

256
00:17:37,890 --> 00:17:40,050
...أنسر... ميستيك

257
00:17:40,890 --> 00:17:43,140
...كنز يرسم البسمة

258
00:17:45,520 --> 00:17:47,520
!لا أستطيع إعادته حقّاً الآن

259
00:17:56,320 --> 00:17:57,490
!وجدتُها

260
00:17:57,660 --> 00:17:58,950
!ميستيك

261
00:17:59,530 --> 00:18:02,030
همس، همس

262
00:18:02,240 --> 00:18:03,330
اتّفقنا؟

263
00:18:03,490 --> 00:18:04,450
!حسناً

264
00:18:06,080 --> 00:18:08,120
!ها أنا ذي

265
00:18:10,250 --> 00:18:11,040
ماذا؟

266
00:18:14,630 --> 00:18:18,340
!هانّيندا! دا! دا! دا

267
00:18:21,260 --> 00:18:22,050
!نين

268
00:18:23,600 --> 00:18:24,390
!هان

269
00:18:26,230 --> 00:18:27,600
!هان

270
00:18:29,600 --> 00:18:31,150
النّهاية

271
00:18:32,940 --> 00:18:34,190
نهايتك بالطّبع

272
00:18:40,780 --> 00:18:43,580
!هان! نيندا-دا-دا! هانّيندا-دا

273
00:18:49,250 --> 00:18:51,710
!هجوم أنسر

274
00:18:52,420 --> 00:18:53,210
!نين

275
00:18:53,460 --> 00:18:55,920
مستحيل، كان ذلك خياراً؟

276
00:18:56,460 --> 00:18:58,050
!الآن-
أجل-

277
00:19:00,510 --> 00:19:01,550
!افتحي

278
00:19:05,680 --> 00:19:08,640
!عدسة المرآة المُكبِّرة بري-كيت! بوتشيتان

279
00:19:15,520 --> 00:19:16,780
!جوهرة ماكوتو

280
00:19:25,030 --> 00:19:26,040
!انظر

281
00:19:27,830 --> 00:19:29,000
!اشعر

282
00:19:31,330 --> 00:19:32,790
!حُلّ اللّغز

283
00:19:35,170 --> 00:19:38,960
!هذا هو جوابنا

284
00:19:39,720 --> 00:19:43,180
!بريكيور! الطّيف الطّائر

285
00:19:53,230 --> 00:19:54,940
!إغلاق ملفّ القضيّة كيوريتو

286
00:19:55,900 --> 00:20:00,320
!هانّيندا

287
00:20:09,790 --> 00:20:12,330
!بوتشي بوتشي كيور كيور

288
00:20:17,250 --> 00:20:19,210
هُزِمتُ بخفّة

289
00:20:24,890 --> 00:20:27,390
...أنتما فعلاً

290
00:20:27,560 --> 00:20:29,720
لا حاجة لشكرنا! صحيح؟

291
00:20:29,930 --> 00:20:32,730
!أجل! جميعنا زُملاء

292
00:20:33,230 --> 00:20:35,310
!متجر زهور هاناموري هنا

293
00:20:35,480 --> 00:20:37,150
!آسف لتأخُّري

294
00:20:37,310 --> 00:20:40,280
!تعطّلتْ سيّارتي فجأة

295
00:20:40,440 --> 00:20:42,320
كان ذلك من صنيع نيجي

296
00:20:42,490 --> 00:20:44,360
!لا مُشكلة إطلاقاً

297
00:20:44,530 --> 00:20:47,370
!سنُساعدك في حمل الزُّهور

298
00:20:59,960 --> 00:21:01,960
هذا عطر زيادة الجمال

299
00:21:02,470 --> 00:21:04,260
!جرّباه على أيديكما وجسدكما

300
00:21:08,970 --> 00:21:13,140
!رائحته عطِرة

301
00:21:13,730 --> 00:21:14,560
أليس كذلك؟

302
00:21:15,190 --> 00:21:16,850
هل هذا هو المتجر؟

303
00:21:17,020 --> 00:21:18,980
بريتي هوليك؟

304
00:21:19,150 --> 00:21:22,900
يعني "مليء بالأشياء الظّريفة
"!الّتي ستُفقدك صوابك

305
00:21:23,360 --> 00:21:25,860
!ري، يومي، اصعدا

306
00:21:26,570 --> 00:21:29,070
!مُذهل! إنّها ظريفة للغاية

307
00:21:29,530 --> 00:21:33,370
أليس كذلك؟-
أردتُ مُلمّع شِفاه-

308
00:21:33,540 --> 00:21:35,710
!أنصح به بشدّة

309
00:21:36,750 --> 00:21:41,750
الاختراعات العظيمة تمنحك
والجميع ابتسامة جميلة

310
00:21:51,640 --> 00:21:53,220
شكراً جزيلاً

311
00:22:06,610 --> 00:22:07,740
إنّها ظريفة

312
00:22:08,610 --> 00:22:12,450
لا بأس. لديه ذوق جميل

313
00:22:12,620 --> 00:22:13,450
أجل

314
00:23:47,210 --> 00:23:50,380
!المُمثّلة الشّهيرة جدّاً، شيروكو إيري

315
00:23:50,550 --> 00:23:51,970
!ظريفة للغاية

316
00:23:52,840 --> 00:23:54,720
شيروكو قادمة إلى مدرستنا؟

317
00:23:54,890 --> 00:23:57,810
...هذا حقّاً-
!حدثٌ مُهمّ...-

318
00:23:58,520 --> 00:24:01,640
!النّجمة المُتحرّية بريكيور
"لا تفترض من تلقاء نفسك"

319
00:24:01,810 --> 00:24:04,230
!وبهذا يكون قد تمّ إغلاق ملفّ كيوريتو