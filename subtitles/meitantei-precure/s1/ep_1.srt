1
00:00:16,180 --> 00:00:18,010
!لا أطيق الانتظار -
توقّفت الثّلوج أيضاً -

2
00:00:21,100 --> 00:00:23,060
!سأحملها أنا -
ماذا؟ -

3
00:00:23,230 --> 00:00:25,400
!سنتأخّر على حفلة عيد الميلاد

4
00:00:25,900 --> 00:00:29,690
!إذا ركضتِ، فسوف تُفسَد يا آنّا

5
00:00:31,070 --> 00:00:32,400
!أعلم

6
00:00:37,320 --> 00:00:39,660
أنتِ! ما الأمر؟

7
00:00:41,040 --> 00:00:42,290
هل هي تائهة؟

8
00:00:48,090 --> 00:00:49,710
!سأجدها لأجلكِ

9
00:00:52,420 --> 00:00:54,920
أنا لا أكذب أبداً

10
00:00:55,090 --> 00:00:56,470
!انتبهي على الكعكة

11
00:01:04,890 --> 00:01:05,890
!وجدتُها

12
00:01:11,400 --> 00:01:15,110
أنا مُندهشة لأنّكِ عرفتِ بأنّ شريطتها
!قد طاردت بفعل الرّياح

13
00:01:15,280 --> 00:01:18,240
لاحظتُ ذلك عندما رأيتُ بأنّ
!لديها شريطة واحدة فقط

14
00:01:18,410 --> 00:01:20,080
آنّا\ عيد ميلاد سعيد

15
00:01:22,870 --> 00:01:25,410
!يبدو شهيّاً جدّاً

16
00:01:25,580 --> 00:01:28,040
!حسناً، حان الوقت لاستعدادي

17
00:01:28,210 --> 00:01:29,920
!أنتِ مُتحمّسة جدّاً

18
00:01:30,090 --> 00:01:31,290
!أنا كذلك بالطّبع

19
00:01:31,460 --> 00:01:33,880
!سأجعل اليوم يوماً مُميّزاً

20
00:01:34,460 --> 00:01:35,670
!سأضع مِعطفي جانباً

21
00:01:49,770 --> 00:01:52,230
!أمّي! شكراً لكِ

22
00:01:52,400 --> 00:01:53,940
ماذا؟ على ماذا؟

23
00:01:54,110 --> 00:01:56,450
!على هديّة عيد الميلاد خاصّتي

24
00:01:57,110 --> 00:02:02,080
ما الّذي تقوله؟ وعدتُ بشراء هاتف
نقّال لها كهديّة

25
00:02:05,660 --> 00:02:06,910
!مُذهل

26
00:02:07,080 --> 00:02:10,960
!الآن بعد أن بلغتُ الـ 14، أبدو ناضجة حقّاً

27
00:02:12,630 --> 00:02:13,840
...بوتشي

28
00:02:15,550 --> 00:02:16,970
!بوتشي

29
00:02:18,470 --> 00:02:19,590
!ماذا؟

30
00:02:19,760 --> 00:02:22,180
ما هذا؟ كلب؟ قطّ؟

31
00:02:22,350 --> 00:02:23,640
!أنا بوتشيتان

32
00:02:24,260 --> 00:02:26,810
...لـ-لقد تكلّم -
!اصمتي -

33
00:02:31,650 --> 00:02:32,650
--ما

34
00:02:32,980 --> 00:02:35,520
!عليك المجيء معي -
ماذا؟ -

35
00:02:35,690 --> 00:02:37,610
!بهذه القِلادة

36
00:02:37,780 --> 00:02:39,450
!مـ-مهلاً

37
00:02:52,830 --> 00:02:56,130
!لم أفرغ من الشّرح بعد

38
00:02:56,920 --> 00:02:58,050
آنّا؟

39
00:02:59,090 --> 00:03:01,390
ما الّذي... ماذا؟

40
00:03:02,430 --> 00:03:03,470
إنّها ليست هنا؟

41
00:03:08,850 --> 00:03:12,600
!لنبحث عن اللّمحة في القلب

42
00:03:12,770 --> 00:03:15,860
إلهام مُشرِق

43
00:03:16,110 --> 00:03:18,730
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

44
00:03:18,900 --> 00:03:21,530
إنّها تنادينا

45
00:03:21,700 --> 00:03:24,360
أين الحقيقة؟ ما الّذي ستكتشفه؟

46
00:03:24,530 --> 00:03:27,990
لغز تلو الآخر

47
00:03:28,790 --> 00:03:34,120
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

48
00:03:34,290 --> 00:03:39,500
كما الدّليل! شيء يلمع عبر الزّمن

49
00:03:39,670 --> 00:03:42,340
كيف؟ كيف؟ أهي خدعة؟

50
00:03:42,510 --> 00:03:45,180
لماذا؟ لماذا؟ سوف نواجهها

51
00:03:45,600 --> 00:03:50,770
لننظر ونشعر
نكتشف الأسرار

52
00:03:51,230 --> 00:03:56,730
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

53
00:03:57,070 --> 00:04:02,280
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

54
00:04:02,530 --> 00:04:07,950
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

55
00:04:08,120 --> 00:04:11,490
!لنمشِ في ذلك الطّريق معاً

56
00:04:11,660 --> 00:04:15,460
!لنبحث عن اللّمحة في القلب

57
00:04:15,630 --> 00:04:17,250
إلهام مُشرِق

58
00:04:17,420 --> 00:04:23,090
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

59
00:04:23,260 --> 00:04:28,180
ولادتنا ولقاؤنا لَهو لغز رائع

60
00:04:28,350 --> 00:04:31,810
!هيّا يا بريكيور المُتحرّيات النّجمات

61
00:04:38,190 --> 00:04:42,990
!الظّهور الأوّل! المُتحرّيات النّجمات بريكيور

62
00:04:43,570 --> 00:04:45,490
وكالة التحرّي كيوريتو

63
00:04:45,910 --> 00:04:47,530
!حان هذا اليوم أخيراً

64
00:04:48,450 --> 00:04:51,240
!سوف أنجح في هذا الاختبار حتماً

65
00:04:54,500 --> 00:04:56,670
المعذرة... ماذا؟

66
00:05:18,480 --> 00:05:20,400
ما-ما الّذي يجري؟

67
00:05:21,820 --> 00:05:23,150
هل كانت هذه القلادة؟

68
00:05:23,320 --> 00:05:25,860
مهلاً، ما الّذي يجري؟

69
00:05:26,030 --> 00:05:28,320
!لستُ أفهم -
!جنّية -

70
00:05:29,870 --> 00:05:31,990
!أنتِ مع جنّية

71
00:05:32,160 --> 00:05:35,120
أنتِ مُتحرّية نجمة من وكالة
التحرّي كيوريتو إذاً؟

72
00:05:35,410 --> 00:05:36,410
ماذا؟

73
00:05:36,920 --> 00:05:38,830
!اسمي ميكورو كوباياشي

74
00:05:39,540 --> 00:05:41,250
اسمي آنّا أكيتشي

75
00:05:41,420 --> 00:05:42,580
!هذا غير مُهمّ

76
00:05:42,750 --> 00:05:44,420
ماذا تقصدين أيّتها الجنّية؟

77
00:05:44,590 --> 00:05:46,760
كنتُ في غرفتي. كيف وصلتُ إلى هنا؟

78
00:05:48,640 --> 00:05:51,930
هل بدأ اختبار التحرّي من الآن؟

79
00:05:52,100 --> 00:05:53,350
!بئساً

80
00:05:53,520 --> 00:05:54,980
!اسمحي لي أن أُجيب

81
00:05:55,560 --> 00:05:59,020
،المُتحرّي الشّهير، شيرلوك هولمز

82
00:05:59,190 --> 00:06:03,190
كان يستطيع معرفة المكان الّذي كان فيه شخص
من الآثار واللّطخات في حذائه

83
00:06:03,360 --> 00:06:05,110
...لذا في حالتك

84
00:06:07,820 --> 00:06:11,160
!أنتِ... لا ترتدين حذاء

85
00:06:11,620 --> 00:06:14,870
مليء بالميزات الجديدة! الأحدث
!في عالم الاتّصالات

86
00:06:15,450 --> 00:06:17,490
!حسناً! فقرتنا التّالية عن الطّقس

87
00:06:17,660 --> 00:06:18,960
...حسناً

88
00:06:19,330 --> 00:06:20,580
!إنّها مثاليّة

89
00:06:21,960 --> 00:06:23,030
ماذا أختار بينهما؟

90
00:06:23,200 --> 00:06:24,290
!هذه

91
00:06:24,460 --> 00:06:25,520
!انسي ذلك

92
00:06:25,690 --> 00:06:28,630
!لا أُصدّق بأنّكِ سقطتِ هنا من غرفتكِ

93
00:06:28,800 --> 00:06:29,920
!صدّقيني

94
00:06:30,090 --> 00:06:31,260
!بوتشي-بوتشي

95
00:06:31,430 --> 00:06:33,990
بوتشي-بوتشي لا تعني شيئاً بالنّسبة لي

96
00:06:34,160 --> 00:06:35,220
...هذه الصّغيرة

97
00:06:35,390 --> 00:06:38,390
!تضع ملهاة. لذا هي رضيعة

98
00:06:38,560 --> 00:06:41,940
أعتقد لهذا لا تستطيع التكلّم -
...ماذا؟ لكن في السّابق -

99
00:06:42,110 --> 00:06:45,530
لسبب ما، إنّها رضيعة الآن
ولا تستطيع التكلّم

100
00:06:45,980 --> 00:06:47,980
ما رأيكِ باستنتاجي؟

101
00:06:48,150 --> 00:06:50,070
هل نجحتُ في اختبار التحرّي؟

102
00:06:50,240 --> 00:06:53,160
ما قصّة اختبار التحرّي الّتي
لا تنفكّين تتحدّثين عنها؟

103
00:06:53,330 --> 00:06:56,790
!هذا سؤال سهل للإجابة عنه

104
00:06:57,950 --> 00:07:02,580
المُتحرّيات النّجمات يتحرّين حول قضايا
!ويُساعدنَ النّاس بحلّ هذه القضايا

105
00:07:02,750 --> 00:07:05,000
!إنّهم آمال وأحلام الجميع

106
00:07:05,170 --> 00:07:10,260
من أجل أن أصبح مُتحرّية نجمة، أتيتُ
!للخضوع لاختبار التحرّي

107
00:07:10,880 --> 00:07:13,260
!المُتحرّيات النّجمات مُذهلات حقّاً

108
00:07:13,430 --> 00:07:14,510
!حسناً

109
00:07:17,270 --> 00:07:18,480
!ماذا؟

110
00:07:20,440 --> 00:07:21,440
!مهلاً

111
00:07:27,070 --> 00:07:28,610
!لم أدفع

112
00:07:30,450 --> 00:07:33,280
سدّدتُ ثمن حذائكِ

113
00:07:33,450 --> 00:07:34,450
!شكراً لكِ

114
00:07:36,950 --> 00:07:40,120
...هذا المكان -
أهي قاعة زفاف؟ -

115
00:07:42,710 --> 00:07:43,790
!إنّه ليس هنا

116
00:07:44,290 --> 00:07:45,880
أين اختفى؟

117
00:07:48,250 --> 00:07:49,510
آنسة كونو

118
00:07:50,800 --> 00:07:52,090
شكراً جزيلاً لكِ

119
00:07:54,340 --> 00:07:56,930
!عروس

120
00:07:57,100 --> 00:07:58,390
سأنسى أمره

121
00:07:58,600 --> 00:07:59,600
ماذا؟

122
00:07:59,770 --> 00:08:00,770
!...لكن

123
00:08:02,390 --> 00:08:04,520
لا وقت قبل المراسم

124
00:08:05,230 --> 00:08:06,940
!ساعديها

125
00:08:10,690 --> 00:08:11,690
!المعذرة

126
00:08:12,400 --> 00:08:15,570
!إن كنتُما تُواجهان مُشكلة، فيمكننا المُساعدة

127
00:08:16,870 --> 00:08:21,910
من جديد، أنا كونو، أعمل في قاعة الزّفاف هذه

128
00:08:22,540 --> 00:08:23,870
وأنا ماري سودا

129
00:08:24,040 --> 00:08:27,380
فقدتُ الإكليل الّذي كنتُ أنوي
ارتداءه لأجل زفافي

130
00:08:27,710 --> 00:08:28,750
ماذا؟

131
00:08:29,630 --> 00:08:31,460
إذاً ما هذا؟

132
00:08:36,800 --> 00:08:41,640
إنّه مُشابه من حيث الحجم والشّكل لإكليل
ماري، لذا قدّمناه كبديل

133
00:08:41,810 --> 00:08:44,100
هذا إكليل ماري

134
00:08:44,270 --> 00:08:48,190
ارتدت أمّي نفس الإكليل في حفل زفافها

135
00:08:48,770 --> 00:08:51,480
أردتُ ارتداءه في حفلي كذلك

136
00:08:52,150 --> 00:08:53,900
لكنّه اختفى من هذه الغرفة

137
00:08:54,070 --> 00:08:56,070
كيف له أن يختفي فجأة؟

138
00:08:57,910 --> 00:09:01,290
مستحيل! هل هذا هو اختبار التحرّي الحقيقيّ؟

139
00:09:02,370 --> 00:09:06,290
!أعدكِ بأنّني سأجده لأجلكِ

140
00:09:07,330 --> 00:09:09,590
لماذا استدعيتمونا إلى هنا؟

141
00:09:10,340 --> 00:09:16,260
كنتُم أنتم الثّلاثة الوحيدين الّذين دخلوا هذه
الغرفة بعد آخر مرّة أضاعت فيها ماري الإكليل

142
00:09:16,430 --> 00:09:19,930
!أحدكم هو الجاني الّذي سرق الإكليل

143
00:09:22,270 --> 00:09:24,510
!لا! هذا مستحيل

144
00:09:24,680 --> 00:09:25,680
ماذا؟

145
00:09:25,850 --> 00:09:31,190
...بـ-بالطّبع... لدينا بعض الأسئلة فحسب

146
00:09:32,530 --> 00:09:35,610
أتيتُ لتصوير العروس

147
00:09:36,200 --> 00:09:38,870
أتيتُ لأطلب معروفاً من ماري

148
00:09:39,820 --> 00:09:40,950
معروف؟

149
00:09:41,120 --> 00:09:43,870
أرادت منّي أن أرمي باقة الورود إليها

150
00:09:44,040 --> 00:09:45,950
!رمية باقة الورود

151
00:09:46,120 --> 00:09:52,040
أجل! إذا أمسكتِ بباقة الورود المرميّة بواسطة
!العروس، فسوف تُشاركينها سعادتها

152
00:09:52,210 --> 00:09:54,130
!لطالما حلمتُ بالإمساك بواحدة

153
00:09:54,670 --> 00:09:56,340
الطّلبات مسموحة؟

154
00:09:56,510 --> 00:09:59,090
ماري، وافقتِ على فعلها، أليس كذلك؟

155
00:09:59,260 --> 00:10:03,800
،توموكا تتأخّر دوماً، لكن أتت في الوقت
لذا لم يكن بيدي حيلة

156
00:10:03,970 --> 00:10:05,520
هكذا إذاً

157
00:10:06,180 --> 00:10:09,730
كنتُ أدخل وأخرج، تحضيراً للمراسم

158
00:10:09,900 --> 00:10:13,810
هل يرتدون نفس الملابس السّابقة؟

159
00:10:13,980 --> 00:10:17,570
أجل. مُحال أن يكونوا قد تمكّنوا
...من إخفاء إكليل

160
00:10:18,320 --> 00:10:19,780
هكذا إذاً

161
00:10:22,080 --> 00:10:23,080
!القبّعة

162
00:10:23,790 --> 00:10:26,030
ربّما وضعه في قُبّعته؟

163
00:10:26,200 --> 00:10:27,290
ماذا؟

164
00:10:27,460 --> 00:10:31,290
هذا الإكليل هو بنفس حجم
إكليل ماري تقريباً

165
00:10:32,000 --> 00:10:34,170
هل يمكنني رؤية قبّعتك؟ -
حسناً -

166
00:10:38,090 --> 00:10:41,010
إنّه لا يتّسع. لا يمكن أن يكون
قد وضعه هنا

167
00:10:41,180 --> 00:10:43,010
ماذا عن حقيبة توموكا؟

168
00:10:44,720 --> 00:10:46,430
لا يتّسع هنا أيضاً

169
00:10:47,270 --> 00:10:49,730
حقيبة الآنسة كونو صغيرة جدّاً أيضاً

170
00:10:51,980 --> 00:10:53,190
شكراً لك

171
00:10:53,360 --> 00:10:55,020
لكن لا مُشكلة حقّاً

172
00:10:56,150 --> 00:10:57,320
...سيترتّب عليّ فقط

173
00:10:58,190 --> 00:10:59,700
نسيان الإكليل

174
00:11:02,780 --> 00:11:07,950
إذا استطعنا معرفة كيف أخذ
الإكليل، فسوف نعرف الجاني

175
00:11:09,790 --> 00:11:12,130
لا أعرف كيف بالضّبط

176
00:11:12,830 --> 00:11:16,000
...لطالما كنتُ

177
00:11:17,170 --> 00:11:18,170
ميكورو-تشان

178
00:11:19,470 --> 00:11:20,760
!ميكورو-تشان

179
00:11:23,430 --> 00:11:24,550
هل أنتِ بخير؟

180
00:11:26,930 --> 00:11:28,430
لا أعلم

181
00:11:28,930 --> 00:11:31,810
لن نرسم البسمة في وجه
ماري على هذا المُعدّل

182
00:11:31,980 --> 00:11:33,520
لن أكون مُتحرّية نجمة

183
00:11:33,940 --> 00:11:36,360
لماذا تريدين أن تكوني مُتحرّية نجمة؟

184
00:11:36,770 --> 00:11:38,730
ساعدنَني من قبل

185
00:11:38,900 --> 00:11:43,030
والآن، أريد أن أصبح مُتحرّية
!نجمة وأُساعد الآخرين

186
00:11:43,570 --> 00:11:45,280
!أنتِ مُذهلة

187
00:11:46,370 --> 00:11:51,540
إن كنتِ مُتحرّية نجمة، فيمكنكِ إيجاد
الإكليل وجعل ماري تبتسم، صحيح؟

188
00:11:51,710 --> 00:11:53,660
أجل، بكلّ تأكيد

189
00:11:53,830 --> 00:11:56,790
!إذاً كوني واحدة! مُتحرّية نجمة

190
00:11:57,590 --> 00:11:58,590
...لكن

191
00:11:58,920 --> 00:12:01,170
!القلق بشأن ذلك لن يُحقّق شيئاً

192
00:12:02,010 --> 00:12:05,380
!تقدّمي خطوة، وستتبعها الإجابة

193
00:12:05,550 --> 00:12:09,310
!خطوة شجاعة واحدة تتحوّل إلى الجواب

194
00:12:11,350 --> 00:12:12,970
!ميكورو-تشان! هيّا بنا

195
00:12:13,140 --> 00:12:15,020
!لنُراجع الأمر ثانية

196
00:12:15,400 --> 00:12:16,400
!حسناً

197
00:12:21,990 --> 00:12:23,690
!هذه هي المرّة الثّانية اليوم

198
00:12:23,860 --> 00:12:27,240
قبل قليل يوم، شريطة فتاة
...طارت نحو السّياج النّباتيّ

199
00:12:27,780 --> 00:12:30,330
...داخل... السّياج

200
00:12:31,580 --> 00:12:32,620
زهور؟

201
00:12:38,800 --> 00:12:39,920
!هكذا إذاً

202
00:12:40,090 --> 00:12:42,420
!هذا هو الجواب

203
00:12:42,590 --> 00:12:45,180
...الجاني هو -
!ذلك الشّخص... -

204
00:12:54,390 --> 00:12:56,400
!نعرف من يكون الجاني

205
00:12:57,900 --> 00:12:59,610
من قد يكون؟

206
00:13:00,110 --> 00:13:01,440
...الجاني

207
00:13:04,030 --> 00:13:05,530
!هو أنتِ

208
00:13:06,280 --> 00:13:07,280
ماذا؟

209
00:13:08,490 --> 00:13:12,330
لكن رأيتُما كيف أنّ الإكليل
!لا يتّسع في حقيبتي

210
00:13:12,500 --> 00:13:14,770
مُحال أن أستطيع إخراجه من غرفتي

211
00:13:14,940 --> 00:13:15,950
أجل

212
00:13:16,120 --> 00:13:19,120
لا يزال الإكليل موجوداً في هذه الغرفة

213
00:13:19,290 --> 00:13:20,290
ماذا؟

214
00:13:20,590 --> 00:13:25,590
طلبتِ من ماري رمي الباقة نحوكِ

215
00:13:25,760 --> 00:13:28,220
ثمّ أخبأتِ الإكليل داخل الباقة

216
00:13:29,390 --> 00:13:32,800
،ثمّ عندما حصلتِ على الباقة من ماري

217
00:13:32,970 --> 00:13:35,440
خطّطتِ لإزالة الإكليل

218
00:13:43,480 --> 00:13:45,150
أنتما ماهرتان

219
00:13:45,320 --> 00:13:48,910
لكنّكما ارتكبتُما خطأ فادحاً واحداً

220
00:13:49,530 --> 00:13:52,540
!لستُ توموكا

221
00:13:54,500 --> 00:13:59,790
!اسمي نيجي! لصّ من نقابة لصوص الشّبح

222
00:13:59,960 --> 00:14:02,670
نقابة اللّصوص الشّبح؟

223
00:14:03,300 --> 00:14:06,380
ألم يكن ذلك تنكُّراً مُذهلاً؟

224
00:14:07,300 --> 00:14:08,590
!سآخذ هذا

225
00:14:11,050 --> 00:14:12,180
!الإكليل

226
00:14:12,350 --> 00:14:13,350
ماذا؟

227
00:14:13,970 --> 00:14:14,970
!بئساً

228
00:14:18,190 --> 00:14:20,520
!توقّف

229
00:14:20,690 --> 00:14:22,190
!إنّه سريع

230
00:14:32,950 --> 00:14:35,280
!يا للمفاجأة

231
00:14:35,450 --> 00:14:37,160
!أعد الإكليل

232
00:14:37,330 --> 00:14:38,870
!لا أحد يستطيع ذلك

233
00:14:39,040 --> 00:14:42,750
يحتوي هذا الإكليل على جوهرة
ماكوتو في داخله في نهاية المطاف

234
00:14:43,170 --> 00:14:44,580
جوهرة ماكوتو؟

235
00:14:44,750 --> 00:14:50,470
اهتمام العروس الشّديد بالإكليل
جذبَ جوهرة ماكوتو نحوه

236
00:14:52,350 --> 00:14:55,640
هدفنا هو جمع هذه الجواهر

237
00:14:55,810 --> 00:15:00,100
!مُقابل الإكليل، سأقدّم عرضاً خاصّاً لأجلكما

238
00:15:01,020 --> 00:15:02,610
!غلّفي أيّتها الأكاذيب

239
00:15:04,020 --> 00:15:06,030
!تعال يا هانّيندا

240
00:15:13,200 --> 00:15:15,950
!هانّيندا

241
00:15:20,540 --> 00:15:24,210
!إنّه هانّيندا، تمّ تطويره حديثاً بواسطة الشّبح

242
00:15:24,380 --> 00:15:27,590
!حان وقت العرض يا صغيري

243
00:15:28,710 --> 00:15:31,050
!هانّيندا

244
00:15:39,140 --> 00:15:40,690
!علينا أن نفعل شيئاً

245
00:15:42,400 --> 00:15:43,810
شيء؟

246
00:15:46,150 --> 00:15:49,240
!انتهى وقت لعِب دور المُتحرّي

247
00:15:49,780 --> 00:15:53,070
عيونكما الخائفة تشرح كلّ شيء

248
00:15:53,950 --> 00:15:55,860
لستِ مُتحرّية

249
00:15:56,030 --> 00:15:58,870
!أنت مُجرّد مُزيّفة تتظاهر بأنّها كذلك

250
00:16:01,580 --> 00:16:02,790
!إنّها حقيقيّة

251
00:16:04,290 --> 00:16:07,210
!ستكون ميكورو-تشان مُتحرّية نجمة

252
00:16:08,170 --> 00:16:09,590
مُتحرّية نجمة؟

253
00:16:10,260 --> 00:16:11,800
لن يحدث هذا أبداً

254
00:16:11,970 --> 00:16:13,300
!بل ستفعل

255
00:16:13,930 --> 00:16:18,100
الآن أريد أن أصبح مُتحرّية نجمة
!وأُساعد الجميع

256
00:16:19,310 --> 00:16:21,560
!تريد مُساعدة النّاس

257
00:16:22,140 --> 00:16:26,610
تدّعين الصّلابة، لكن أعلم بأنّكِ خائفة

258
00:16:28,820 --> 00:16:31,110
هذا صحيح... أنا خائفة

259
00:16:31,990 --> 00:16:34,910
أنا خائفة، لكن أريد استعادة الإكليل

260
00:16:36,450 --> 00:16:40,240
!ماري بحاجة مُساعدة، وأريد مُساعدتها أيضاً

261
00:16:41,910 --> 00:16:43,620
سوية مع ميكورو-تشان

262
00:16:50,090 --> 00:16:51,420
!ميكورو-تشان

263
00:16:52,170 --> 00:16:54,170
!خطوة واحدة من الشّجاعة

264
00:16:54,340 --> 00:16:56,050
!تصبح الإجابة

265
00:16:57,850 --> 00:17:01,010
!أرياني إجابتكما هذه

266
00:17:01,180 --> 00:17:02,980
!هانّيندا

267
00:17:04,520 --> 00:17:07,060
!سوف نستعيده

268
00:17:10,020 --> 00:17:11,650
ماذا؟

269
00:17:12,490 --> 00:17:14,820
!قلادة أُخرى -
!إنّها نفسها؟ -

270
00:17:21,040 --> 00:17:23,500
!بريكيور

271
00:17:27,670 --> 00:17:28,750
!افتحي

272
00:17:33,670 --> 00:17:35,510
!ساعة جوهرة كيور

273
00:17:38,260 --> 00:17:40,890
!بريكيور! وقت الاستيقاظ

274
00:17:41,060 --> 00:17:43,020
!ثلاثة! اكتشفي

275
00:17:55,740 --> 00:17:57,660
!ستّة! ومُقابل بعضيهما الآخر

276
00:18:09,750 --> 00:18:12,250
!تسعة! نحن الثّنائي الإعجازيّ

277
00:18:21,390 --> 00:18:23,300
!دوري

278
00:18:23,470 --> 00:18:25,220
!وأنهي الأمر بشكل ظريف

279
00:18:49,250 --> 00:18:54,920
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، جواب كيور

280
00:18:57,300 --> 00:19:00,590
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

281
00:19:00,760 --> 00:19:03,800
!المُتحرّية النّجمة، كيور ميستيك

282
00:19:07,890 --> 00:19:09,940
!المُتحرّية النّجمة بريكيور

283
00:19:12,560 --> 00:19:15,060
!سأُريك إجابتي

284
00:19:15,230 --> 00:19:17,070
!هانّيندا

285
00:19:19,900 --> 00:19:23,740
!هان! نين! دا

286
00:19:25,330 --> 00:19:27,620
هل قلتُ بريكيور؟

287
00:19:27,790 --> 00:19:32,160
أيّتها المُتحرّية النّجمة! أردتُ أن
!أكون مُتحرّية نجمة بريكيور

288
00:19:32,330 --> 00:19:34,120
ماذأ؟ حقّاً؟

289
00:19:34,290 --> 00:19:35,840
!بوتشي

290
00:19:36,880 --> 00:19:38,460
بريكيور؟

291
00:19:38,960 --> 00:19:41,470
إنّهما ليستا مثلها... وافدتان جديدتان؟

292
00:19:42,300 --> 00:19:43,800
!هانّيندا

293
00:19:45,470 --> 00:19:47,810
!دا

294
00:20:04,530 --> 00:20:06,820
!لن تهزماه هكذا أبداً

295
00:20:06,990 --> 00:20:09,660
!هانّيندا

296
00:20:09,830 --> 00:20:12,960
!خطوة واحدة من الشّجاعة -
!تصبح الجواب -

297
00:20:22,880 --> 00:20:29,640
!هذا هو جوابنا

298
00:20:35,690 --> 00:20:37,690
!كيوريتو إغلاق ملفّ قضيّة

299
00:20:39,570 --> 00:20:42,490
!هانّيندا

300
00:20:51,910 --> 00:20:54,170
!سأنزل السّتار لهذا اليوم

301
00:20:55,920 --> 00:20:57,290
اختفى؟

302
00:21:01,010 --> 00:21:03,260
!تهانينا

303
00:21:03,590 --> 00:21:06,550
يسرّني أنّنا فعلناها في الوقت
!قبل بدء المراسم

304
00:21:08,300 --> 00:21:10,050
!شكراً جزيلاً لكِ

305
00:21:10,220 --> 00:21:12,310
!لم أكن أنا فحسب

306
00:21:12,930 --> 00:21:16,060
اللّصّ؟ -
!إنّها توموكا الحقيقيّة -

307
00:21:16,230 --> 00:21:18,600
!آسفة لتأخُّري

308
00:21:18,770 --> 00:21:20,270
!ها أنا ذي

309
00:21:22,530 --> 00:21:24,240
!مرحى

310
00:21:26,780 --> 00:21:29,570
عليّ العودة إلى المنزل! إنّها
!حفلة عيد ميلادي

311
00:21:29,740 --> 00:21:34,450
المعذرة! إذا أصبحتُ بريكيور، فهذا
يعني أنّني نجحتُ في الاختبار، صحيح؟

312
00:21:34,620 --> 00:21:37,410
!أبريل 1999

313
00:21:37,580 --> 00:21:42,460
أصبحتُ أخيراً نجمة مُتحرّية في
!وكالة التحرِّي كيوريتو

314
00:21:42,960 --> 00:21:45,130
‏1999؟

315
00:21:45,300 --> 00:21:47,550
!كلامكِ غير مفهوم

316
00:21:49,010 --> 00:21:54,060
!لا، إنّه 1999! الثّاني من أبريل! الرّبيع

317
00:21:54,230 --> 00:21:55,230
انظري

318
00:21:57,520 --> 00:21:59,770
ماذا؟ أزهار كرز؟

319
00:22:00,310 --> 00:22:04,400
كنتُ في 2027، يناير، في الشّتاء

320
00:22:05,190 --> 00:22:12,090
إذاً، هل عدتُ بالزّمن إلى الوراء؟

321
00:23:47,150 --> 00:23:49,780
ماذا يعني بريكيور؟ سفر بالزّمن؟

322
00:23:50,690 --> 00:23:53,030
ربّما سنعثر على الجواب إذا
!ذهبنا إلى هناك

323
00:23:53,220 --> 00:23:56,100
إلى أين؟ -
!إلى وكالة التحرّي كيوريتو -

324
00:23:56,810 --> 00:24:01,270
!المُتحرّية النّجمة بريكيور
"!تقديم العبقريّ، جيت-سينباي"

325
00:24:01,690 --> 00:24:04,310
!هذا غامض! المُتحرّية النّجمة كيوريتو