1
00:00:13,720 --> 00:00:15,430
!إنّي أراها

2
00:00:15,640 --> 00:00:17,560
هذه هي جزيرة جييتو؟

3
00:00:18,980 --> 00:00:23,400
ورد في الرّسالة بأنّها كانت قضيّة
ضخمة تهزّ الجزيرةَ بأكملها، صحيح؟

4
00:00:23,980 --> 00:00:26,690
!عزيزتاي المُتحرّيتان، من فضلكما ساعدانا"

5
00:00:27,280 --> 00:00:30,200
أتانا نذيرٌ فظيع

6
00:00:30,740 --> 00:00:31,870
"...على هذا المُعدّل

7
00:00:32,030 --> 00:00:34,740
قد تختفي الجزيرة بأكملها...

8
00:00:34,910 --> 00:00:41,000
أيّتها المُتحرّيتان، مُستقبل الجزيرة
!يعتمد عليكما

9
00:00:42,790 --> 00:00:44,840
!كنتُ أنتظركما

10
00:00:45,340 --> 00:00:46,420
...أنت

11
00:00:46,590 --> 00:00:49,680
أنا المُحافظ باندا، الشّخص الّذي أرسلَ الرّسالة

12
00:00:49,840 --> 00:00:52,840
!شكراً لكما على قطع كلّ هذه المسافة

13
00:00:53,010 --> 00:00:55,680
...حسناً، بخصوص القضيّة

14
00:00:55,850 --> 00:00:58,060
الجزيرة قد تختفي؟

15
00:00:58,230 --> 00:01:00,060
ماذا حدث بالضّبط؟

16
00:01:01,350 --> 00:01:02,400
...فـ-في الواقع

17
00:01:04,110 --> 00:01:08,240
ظهرتْ جنّيةٌ في الجزيرة

18
00:01:08,570 --> 00:01:10,610
!جـ-جنّية؟

19
00:01:15,830 --> 00:01:19,580
!لنبحث عن اللّمحة في القلب

20
00:01:19,750 --> 00:01:22,830
إلهام مُشرِق

21
00:01:23,080 --> 00:01:25,710
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

22
00:01:25,880 --> 00:01:28,510
إنّها تنادينا

23
00:01:28,670 --> 00:01:31,340
أين الحقيقة؟ ما الّذي ستكتشفه؟

24
00:01:31,510 --> 00:01:34,970
لغز تلو الآخر

25
00:01:35,760 --> 00:01:41,100
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

26
00:01:41,270 --> 00:01:46,480
كما الدّليل! شيء يلمع عبر الزّمن

27
00:01:46,650 --> 00:01:49,320
كيف؟ كيف؟ أهي خدعة؟

28
00:01:49,480 --> 00:01:52,150
لماذا؟ لماذا؟ سوف نواجهها

29
00:01:52,570 --> 00:01:57,740
لننظر ونشعر
نكتشف الأسرار

30
00:01:58,200 --> 00:02:03,710
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

31
00:02:04,040 --> 00:02:09,250
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

32
00:02:09,500 --> 00:02:14,930
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

33
00:02:15,090 --> 00:02:18,470
!لنمشِ في ذلك الطّريق معاً

34
00:02:18,640 --> 00:02:22,390
!لنبحث عن اللّمحة في القلب

35
00:02:22,600 --> 00:02:24,230
إلهام مُشرِق

36
00:02:24,390 --> 00:02:30,070
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

37
00:02:30,230 --> 00:02:35,160
ولادتنا ولقاؤنا لَهو لغز رائع

38
00:02:35,320 --> 00:02:38,780
!هيّا يا بريكيور المُتحرّيات النّجمات

39
00:02:45,420 --> 00:02:49,960
!أسطورة من جزيرة ما

40
00:02:50,130 --> 00:02:53,090
نَزِلَتْ أُغنية جنّية على هذه الجزيرة؟

41
00:02:53,260 --> 00:02:54,670
ها هي

42
00:02:56,010 --> 00:03:00,930
جنّية شقيّة أسقطت أشجاراً
ورسمت خربشات

43
00:03:01,770 --> 00:03:05,350
،عندما اختفت فطائر المانجو
،بدأت عقارب السّاعة بالتحرُّك

44
00:03:05,520 --> 00:03:07,850
ثمّ اختفت الجزيرة"؟

45
00:03:10,360 --> 00:03:13,690
إنّها خُرافة قديمة من جزيرة مانجو

46
00:03:13,860 --> 00:03:15,070
جزيرة مانجو؟

47
00:03:15,490 --> 00:03:18,570
كانت الجزيرة مشهورة بفطائر المانجو

48
00:03:18,740 --> 00:03:20,490
ومن هنا استمدّت اسمها

49
00:03:20,660 --> 00:03:25,000
نحن نستمرّ في صنع فطائر المانجو
هنا في جزيرة جييتو أيضاً

50
00:03:25,160 --> 00:03:26,290
حقّاً؟

51
00:03:26,460 --> 00:03:31,960
وفقاً للأسطورة، ظهرتْ جنّية قبل مئة عام

52
00:03:32,920 --> 00:03:36,930
،سكّان الجزيرة انزعجوا من مقالب الجنّية

53
00:03:38,470 --> 00:03:41,470
لكن تلك المقالب كانت مُجرّد بداية

54
00:03:41,640 --> 00:03:43,770
"بدأت عقارب السّاعة بالتحرُّك"

55
00:03:43,930 --> 00:03:48,520
العدّ التّنازليّ لدمار الجزيرة
قد بدأ بالفعل

56
00:03:48,690 --> 00:03:49,650
!دمار؟

57
00:03:50,310 --> 00:03:53,940
مسحت الجنّيةُ جزيرةَ مانجو، ثمّ غادرتْ

58
00:03:54,280 --> 00:04:00,570
والآن، أتتْ جنّيةٌ إلى جزيرتنا وتفعل
!الأشياء ذاتها الواردة في الأسطورة

59
00:04:00,740 --> 00:04:05,750
،على هذا المُعدّل، ستختفي جزيرتنا
!مثلما حدث مع جزيرة مانجو

60
00:04:10,380 --> 00:04:12,000
،قبل ثلاثة أيّام

61
00:04:12,170 --> 00:04:16,170
أتيتُ لتقطيع الحطب، فوجدتُه مُبعثَراً

62
00:04:16,340 --> 00:04:18,880
وجنّية هي من فعلتْ ذلك؟

63
00:04:19,050 --> 00:04:21,180
ربّما يكون حيوان من فعل هذا؟

64
00:04:21,340 --> 00:04:22,760
!لا، كانت جنّية

65
00:04:22,930 --> 00:04:24,600
!إليكما الدّليل

66
00:04:26,220 --> 00:04:28,520
!كنتُ هكذا عندما استيقظتُ صباح اليوم

67
00:04:28,690 --> 00:04:32,860
إنّها خربشات الجنّية! كما في الخُرافة

68
00:04:33,020 --> 00:04:34,360
كما في الخُرافة؟

69
00:04:34,650 --> 00:04:41,910
أجل. الحطب المُبعثَر، والرّسوم
واردة في الخُرافة

70
00:04:42,070 --> 00:04:46,080
"جملة "أسقطت أشجاراً ورسمت خربشات

71
00:04:46,240 --> 00:04:49,660
...التّالية، اختفت فطائر المانجو

72
00:04:49,830 --> 00:04:51,460
ستختفي الجزيرة أيضاً؟

73
00:04:52,790 --> 00:04:55,920
لكن لا نعلم ما إن كانت جنّية
من فعلتْ هذا

74
00:04:56,090 --> 00:04:58,050
!فعلَتْها جنّية

75
00:04:58,220 --> 00:05:00,510
!آكي، كوهارو

76
00:04:58,550 --> 00:05:01,010
حفيدتا المُحافظ
آكي وكوهارو باندا

77
00:05:01,180 --> 00:05:06,600
حفيدتايّ. أعتني بهما أثناء
عمل والديهما خارج الجزيرة

78
00:05:06,770 --> 00:05:12,230
!إنّهما الأظرف في الجزيرة
!لا، بل في اليابان كلّها

79
00:05:12,400 --> 00:05:15,440
!لا، في العالم كلّه

80
00:05:15,610 --> 00:05:18,990
!آكي، كانت الجنّية هنا حقّاً

81
00:05:19,150 --> 00:05:22,030
!أ-أخبرتُكِ! عرفتُ بأنّها حقيقيّة

82
00:05:22,200 --> 00:05:23,450
!مُذهل

83
00:05:25,410 --> 00:05:27,450
!إنّها ظريفة جدّاً

84
00:05:28,620 --> 00:05:30,910
!كانت هديّة من أبي وأمّي

85
00:05:33,830 --> 00:05:39,010
،إذا سرقتْ جنّيةٌ بعض المانجو
...فقد انتهى أمر الجزيرة

86
00:05:39,170 --> 00:05:40,920
!لكن لا داعي للقلق

87
00:05:46,050 --> 00:05:48,350
!الجزيرة بأكملها تتّخذ إجراءات احترازيّة

88
00:05:48,520 --> 00:05:52,600
لذا من فضلكما اقبضا على
!الجنّية في أسرع وقت

89
00:05:52,770 --> 00:05:54,600
!أتوسّل إليكما

90
00:05:57,320 --> 00:06:00,150
ماذا؟ جنّية جعلتْ جزيرةً تختفي؟

91
00:06:00,320 --> 00:06:02,780
مُحال لجنّية أن تفعل شيئاً كهذا

92
00:06:02,950 --> 00:06:04,410
أليس كذلك؟

93
00:06:04,570 --> 00:06:07,370
هذا ما ورد في خُرافة جزيرة مانجو

94
00:06:07,530 --> 00:06:09,370
إذاً أنت تُؤيّد فكرة عدم إمكانيّة ذلك

95
00:06:09,540 --> 00:06:13,080
كمُتحرّيتين، عليكما التّحقيق بشكل شامل

96
00:06:16,130 --> 00:06:17,460
جزيرة مانجو؟

97
00:06:18,500 --> 00:06:23,630
،قالها جيت-سينباي أيضاً. إنّها ليست جنّية
لكن هذا غالباً من صنيع شخص

98
00:06:23,800 --> 00:06:27,720
إذا كان الجاني يفعل الأشياء
،بما يتطابق مع الخُرافة

99
00:06:27,890 --> 00:06:32,770
فإنّ حلّ السّرّ وراء الخُرافة قد يُساعدنا
في حلّ هذه القضيّة بسرعة

100
00:06:32,930 --> 00:06:34,390
!هذا ما أعتقده

101
00:06:34,560 --> 00:06:40,230
لكن عمر الخُرافة مئة عام، لذا
لا أحد يتذكّر تلك الأيّام الآن

102
00:06:43,490 --> 00:06:45,530
برْكة سُلحفاة النّاسك؟

103
00:06:46,360 --> 00:06:51,160
يُقال بأنّ سُلحفاة في هذه البرْكة عاشت
لأكثر من مئة عام

104
00:06:51,330 --> 00:06:52,540
!هذه هي

105
00:06:57,330 --> 00:06:58,750
إنّي أراها

106
00:06:58,920 --> 00:07:03,590
وفقاً لمُجلّد الأسراب، جوهرة
ماكوتو التّالية موجودة هناك

107
00:07:04,170 --> 00:07:06,510
...سأسرقها بخفّة

108
00:07:08,180 --> 00:07:09,140
!بئساً

109
00:07:15,270 --> 00:07:17,060
لا بُدّ أنّها تلك السُّلحفاة

110
00:07:17,230 --> 00:07:18,060
!حسناً

111
00:07:21,730 --> 00:07:22,570
!افتحي

112
00:07:25,280 --> 00:07:26,610
!حلوى بري-كيت الصّمغيّة

113
00:07:28,450 --> 00:07:30,160
!خذي-
!شكراً-

114
00:07:32,080 --> 00:07:35,000
!لذيذة

115
00:07:35,160 --> 00:07:37,000
قبل مئة عام؟

116
00:07:37,170 --> 00:07:42,000
وفقاً للأسطورة، جعلتْ جنّيةٌ
جزيرةَ مانجو تختفي

117
00:07:42,170 --> 00:07:44,710
هل هذا مألوف لديك؟

118
00:07:44,880 --> 00:07:49,680
لم تختفِ أبداً. الجزيرة ما زالت كما هي

119
00:07:49,840 --> 00:07:52,220
لم يتغيّر شيء

120
00:07:52,390 --> 00:07:53,680
...لكن

121
00:07:53,850 --> 00:08:00,690
تغيّر شيء واحد. قبل 100 عام، تغيّر
اسم الجزيرة إلى جزيرة جييتو

122
00:08:02,820 --> 00:08:06,240
سأذهب. حان وقت الأكل

123
00:08:06,820 --> 00:08:08,320
!شكراً جزيلاً لك

124
00:08:09,740 --> 00:08:12,200
...ما تغيّر كان اسم الجزيرة

125
00:08:13,080 --> 00:08:16,960
هل هذا ما قُصِد بجعل الجزيرة تختفي؟

126
00:08:17,460 --> 00:08:19,000
!المُتحرّيتان

127
00:08:19,170 --> 00:08:20,420
ما الأمر؟

128
00:08:21,380 --> 00:08:23,340
حدث ذلك

129
00:08:24,050 --> 00:08:27,720
صندوق المانجو الّذي كان هناك قد اختفى؟

130
00:08:27,880 --> 00:08:30,550
لكنّهم لا يُعدّون المانجو الآن

131
00:08:31,050 --> 00:08:35,310
أخبأتُ بعضاً منه لحفيدتَي العزيزتين
لتناولها كطعام خفيف

132
00:08:35,470 --> 00:08:36,270
ماذا؟

133
00:08:36,430 --> 00:08:40,400
!ظننتُ بأنّها ستكون بأمان من الجنّية هنا

134
00:08:40,560 --> 00:08:43,230
متى وضعت المانجو في السّقيفة؟

135
00:08:43,400 --> 00:08:44,770
في هذا الصّباح؟

136
00:08:44,940 --> 00:08:46,610
هل أقفلتها؟

137
00:08:46,780 --> 00:08:50,200
أجل. احتفظتُ بالمفتاح معي

138
00:08:50,360 --> 00:08:54,030
كانت مُقفَلة منذ وضع المانجو في الدّاخل

139
00:08:54,620 --> 00:08:56,040
إذاً إنّها غرفة مُقفلة؟

140
00:08:56,200 --> 00:08:58,120
!لغز غرفة مُقفلة

141
00:08:58,290 --> 00:09:01,710
القضيّة الصّعبة الّتي يُواجهها
!كلّ مُتحرٍّ عظيم

142
00:09:01,880 --> 00:09:04,630
!لطالما أردتُ حلّ واحدة

143
00:09:04,790 --> 00:09:06,050
!ميكورو، اهدئي

144
00:09:10,090 --> 00:09:12,300
إنّها ليست غرفة مُقفَلة تماماً

145
00:09:12,470 --> 00:09:14,180
...ماذا؟ لا تقوليها

146
00:09:14,350 --> 00:09:17,520
صحيح! من المُمكن لجنّية
أن تتسلّل من هنا

147
00:09:17,680 --> 00:09:19,230
!احتمال وارد

148
00:09:19,390 --> 00:09:23,020
لكنّنا لا نستطيع الدّخول منها
نظراً إلى صِغرها

149
00:09:23,190 --> 00:09:27,320
ربّما استخدم الجاني أداةً
لإخراج المانجو

150
00:09:28,190 --> 00:09:32,610
!إنّها نهايتنا! ستأخذ الجنّيةُ الجزيرةَ الآن

151
00:09:35,780 --> 00:09:38,950
!لا بُدّ من وجود طرف خيط هنا

152
00:09:41,580 --> 00:09:43,330
!عدسة المرآة المُكبِّرة بري-كيت

153
00:09:44,380 --> 00:09:46,090
أزيلي الغطاء

154
00:09:46,630 --> 00:09:48,550
!وضع المُكبّر، تشغيل

155
00:09:54,430 --> 00:09:55,680
ما هذا؟

156
00:09:57,470 --> 00:09:59,060
!اكتشاف عظيم

157
00:09:59,600 --> 00:10:00,560
مهلاً لحظة

158
00:10:02,350 --> 00:10:04,480
هذا ما حدث إذاً

159
00:10:04,650 --> 00:10:07,020
لكن لماذا يفعل ذلك؟

160
00:10:07,400 --> 00:10:09,940
!كوهارو، انظري! الجنّيّة

161
00:10:10,110 --> 00:10:12,110
!أتت الجنّيةُ ثانية

162
00:10:15,070 --> 00:10:17,990
ستأتي الجنّيةُ قريباً وتُصلحها، صحيح؟

163
00:10:19,080 --> 00:10:19,990
أجل

164
00:10:20,540 --> 00:10:22,040
أنا متأكّدة بأنّها ستفعل

165
00:10:29,500 --> 00:10:30,630
!هكذا إذاً

166
00:10:30,800 --> 00:10:32,800
!هذا هو الجواب

167
00:10:33,300 --> 00:10:36,470
...لكن-
هل ينبغي أن نقول شيئاً؟-

168
00:10:37,430 --> 00:10:40,270
يجب أن نكشف الحقيقة

169
00:10:40,770 --> 00:10:43,140
!أجل، كمُتحرّيتين نجمتين

170
00:10:52,360 --> 00:10:56,450
أيّتها الجنّية، من فضلكِ اعفي عن الجزيرة

171
00:10:56,610 --> 00:10:59,580
لم يكن هذا من صنيع جنّية

172
00:11:01,290 --> 00:11:03,120
أنتِ من فعلها، صحيح؟

173
00:11:03,290 --> 00:11:04,410
آكي

174
00:11:05,500 --> 00:11:10,460
أسقطتِ الحطبَ ورسمتِ
على وجه المُحافظ

175
00:11:10,630 --> 00:11:13,720
والمانجو أيضاً، كنتِ أنت

176
00:11:13,880 --> 00:11:18,260
لحظة! من المُؤكَّد أنّها لا تستطيع
أخذ المانجو من السّقيفة

177
00:11:18,430 --> 00:11:21,010
بل تستطيع. حتّى لو لم يستطع بالغ

178
00:11:21,180 --> 00:11:25,600
تستطيع طفلة أن تدخل عبر تلك النّافذة

179
00:11:26,390 --> 00:11:28,730
وجدناها داخل السّقيفة

180
00:11:29,560 --> 00:11:33,230
آثار أقدام وأيادي طفلة أيضاً

181
00:11:34,860 --> 00:11:35,990
أنا آسفة

182
00:11:36,400 --> 00:11:37,660
كوهارو

183
00:11:38,240 --> 00:11:40,780
ساعتكِ مُعطَّلة، أليس كذلك؟

184
00:11:40,950 --> 00:11:45,080
عندما أريتِني إيّاها، لم تكن
العقارب تتحرّك

185
00:11:46,540 --> 00:11:48,880
سقطتْ منّي وانكسرت

186
00:11:49,380 --> 00:11:51,630
حتّى جدّي لم يستطع إصلاحها

187
00:11:52,300 --> 00:11:56,590
قمتِ بكلّ هذه المقالب لأجل
كوهارو، أليس كذلك؟

188
00:11:57,050 --> 00:12:01,350
أردتِ تحسين شعور كوهارو
بعد تحطُّم ساعتها، صحيح؟

189
00:12:05,640 --> 00:12:06,640
...في الخُرافة

190
00:12:07,600 --> 00:12:11,770
بعد اختفاء المانجو، بدأتْ عقارب
السّاعة بالتحرُّك

191
00:12:12,690 --> 00:12:13,690
...لهذا السّبب

192
00:12:14,150 --> 00:12:18,820
أخبرتُها بأنّ الجنّية ستأتي
وتُصلح ساعتها

193
00:12:21,410 --> 00:12:27,580
ظننتُ بأنّني إذا فعلتُ كلَّ شيء
من الرّواية، ستؤمن كوهارو بالجنّية

194
00:12:28,080 --> 00:12:30,830
،لكن أظنّكِ تعلمين سلفاً

195
00:12:31,000 --> 00:12:33,380
...بأنّه ولو فعلتِ كلّ ذلك، الجنّية

196
00:12:34,380 --> 00:12:35,840
أنا آسفة يا كوهارو

197
00:12:36,340 --> 00:12:38,010
كذبتُ عليكِ

198
00:12:38,720 --> 00:12:41,510
أخبرتُكِ بأنّ الجنّية حقيقيّة

199
00:12:42,430 --> 00:12:43,430
...آكي

200
00:12:46,470 --> 00:12:48,100
في الواقع، هذه ليست كذبة

201
00:12:49,730 --> 00:12:50,600
ماذا؟

202
00:12:52,190 --> 00:12:54,570
!لم أتوقّع أبداً أن أجدكما هنا

203
00:12:55,480 --> 00:12:56,570
نيجي؟

204
00:13:00,410 --> 00:13:02,570
!توجد جوهرة ماكوتو في السّاعة

205
00:13:02,740 --> 00:13:03,570
!أعدها

206
00:13:03,740 --> 00:13:05,830
لحظة، لماذا أنت مُبتلّ؟

207
00:13:05,990 --> 00:13:08,710
أنا أتقطّر جاذبيّة، كلصّ

208
00:13:08,870 --> 00:13:11,420
!سآخذ جوهرة ماكوتو هذه

209
00:13:14,420 --> 00:13:16,300
!سنستعيدها بكلّ تأكيد

210
00:13:16,460 --> 00:13:17,710
!انتظرا هنا

211
00:13:20,510 --> 00:13:22,180
!توقّف

212
00:13:25,640 --> 00:13:26,930
إنّها ساعة يد

213
00:13:28,020 --> 00:13:30,060
!أيّتها الأكاذيب، طوّقي

214
00:13:30,770 --> 00:13:33,230
!تعال، هانّيندا

215
00:13:39,900 --> 00:13:42,070
!هانّيندا

216
00:13:44,990 --> 00:13:46,780
!ثلاثة! متّعا أنظاركما

217
00:13:47,290 --> 00:13:49,370
!ستّة! بالّذي لا يُقهَر

218
00:13:49,750 --> 00:13:53,830
!تسعة! هانّيندا الّذي سيهزمكما

219
00:13:54,170 --> 00:13:56,170
!هذا استعراضنا نحن

220
00:13:56,340 --> 00:13:58,590
!سنُريك العرض الحقيقيّ

221
00:14:04,220 --> 00:14:05,220
!افتحي

222
00:14:10,180 --> 00:14:12,140
!ساعة جوهرة كيور

223
00:14:14,770 --> 00:14:17,400
!بريكيور! وقت الاستيقاظ

224
00:14:17,570 --> 00:14:19,530
!ثلاثة! اكتشفي

225
00:14:32,210 --> 00:14:34,330
!ستّة! ومُقابل بعضيهما الآخر

226
00:14:45,970 --> 00:14:48,640
!تسعة! نحن الثّنائي الإعجازيّ

227
00:14:57,770 --> 00:14:59,520
!دوري

228
00:14:59,690 --> 00:15:01,530
!وأنهي الأمر بشكل ظريف

229
00:15:25,720 --> 00:15:31,470
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، أنسر كيور

230
00:15:33,770 --> 00:15:36,940
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

231
00:15:37,100 --> 00:15:40,360
!المُتحرّية النّجمة، كيور ميستيك

232
00:15:44,490 --> 00:15:46,530
!المُتحرّية النّجمة بريكيور

233
00:15:49,200 --> 00:15:51,580
!سأُريك إجابتي

234
00:15:51,740 --> 00:15:54,370
!هانّين! دا! دا

235
00:16:00,630 --> 00:16:03,130
!هجوم آنسر

236
00:16:04,130 --> 00:16:05,550
!هان

237
00:16:07,010 --> 00:16:10,050
!هانّيندا

238
00:16:10,220 --> 00:16:11,760
ما هذا؟

239
00:16:11,930 --> 00:16:14,020
!دا! دا

240
00:16:14,770 --> 00:16:16,020
...عينايّ

241
00:16:16,180 --> 00:16:17,140
!الآن

242
00:16:17,310 --> 00:16:18,060
!دا

243
00:16:21,310 --> 00:16:22,730
!استسلما الآن

244
00:16:22,900 --> 00:16:27,240
أخبرتُكما! هانّيندا الّذي لا يُقهَر
!سوف يهزمكما

245
00:16:27,740 --> 00:16:28,700
!لن نستسلم

246
00:16:28,860 --> 00:16:33,030
تلك السّاعة هي هديّة ثمينة حصلتْ
!عليها كوهارو من والديها

247
00:16:33,200 --> 00:16:37,120
!لهذا عملتْ آكي بجدّ لأجل كوهارو

248
00:16:37,290 --> 00:16:42,000
السّاعة مليئة بالمشاعر اللّطيفة
!تجاه أختها الصّغرى

249
00:16:47,550 --> 00:16:49,010
!سوف نسترجعها بكلّ تأكيد

250
00:16:49,180 --> 00:16:51,550
!هانّيندا

251
00:16:53,180 --> 00:16:55,010
!هانّيندا

252
00:16:55,810 --> 00:16:56,770
!هان-هان

253
00:16:58,850 --> 00:17:00,270
...عشب بحريّ

254
00:17:00,440 --> 00:17:01,600
!لديّ فكرة

255
00:17:02,560 --> 00:17:04,230
!هيّا بنا

256
00:17:05,900 --> 00:17:08,190
!هان! هانّين

257
00:17:10,110 --> 00:17:12,660
!دا، دا-دا-دا! هانّيندا

258
00:17:12,820 --> 00:17:13,740
ماذا؟

259
00:17:16,950 --> 00:17:17,830
!دا

260
00:17:19,910 --> 00:17:20,750
!حسناً

261
00:17:21,830 --> 00:17:22,790
!افتحي

262
00:17:24,880 --> 00:17:26,800
!عدسة المرآة المُكبِّرة بري-كيت

263
00:17:27,340 --> 00:17:28,420
!بوتشيتان

264
00:17:31,720 --> 00:17:33,300
!جوهرة ماكوتو

265
00:17:36,510 --> 00:17:38,310
!كيور آنسر ستُغلق هذه القضيّة

266
00:17:41,810 --> 00:17:43,020
!بريكيور

267
00:17:44,480 --> 00:17:47,110
!سيف النّجم الذّهبيّ آنسر

268
00:18:06,540 --> 00:18:08,460
!إغلاق ملفّ القضيّة كيوريتو

269
00:18:09,210 --> 00:18:12,260
!هانّيندا

270
00:18:21,520 --> 00:18:24,350
!بوتشي بوتشي كيور كيور

271
00:18:28,150 --> 00:18:29,110
!ممتاز

272
00:18:29,570 --> 00:18:32,320
لكن الوقت يمضي

273
00:18:32,900 --> 00:18:36,570
نحو اللّحظة الّتي نربح فيها
!نحن اللّصوص الشّبح

274
00:18:40,950 --> 00:18:41,750
تفضّلي

275
00:18:45,170 --> 00:18:46,130
كوهارو

276
00:18:47,040 --> 00:18:49,130
شكراً لكِ يا آكي

277
00:18:51,510 --> 00:18:54,720
جدّي، آسفة على المقالب

278
00:18:54,880 --> 00:18:56,800
...ما-ما-ما

279
00:18:56,970 --> 00:19:00,010
ماذا عسايّ أقول؟ حُبّكِ لأختكِ نقيّ جدّاً

280
00:19:00,180 --> 00:19:06,150
سأغفر لكِ كلّ مقالبكِ إذا كان هذا
يعني رؤية حفيدتَي تبتسمان

281
00:19:07,610 --> 00:19:09,110
أنتما هنا

282
00:19:09,900 --> 00:19:11,400
جيت-سينباي؟

283
00:19:11,570 --> 00:19:12,570
لماذا أنت هنا؟

284
00:19:13,030 --> 00:19:15,450
فكّرتُ في الزّيارة بشكل
خاطف أثناء وجودكما هنا

285
00:19:15,610 --> 00:19:19,410
لم يستغرق ذلك سوى القليل من الوقت
باستخدام هذا القارب الّذي صنعتُه بنفسي

286
00:19:21,450 --> 00:19:25,000
إنّها لذيذة! كما أتذكّرها تماماً

287
00:19:26,830 --> 00:19:28,210
...تلك السّاعة

288
00:19:28,380 --> 00:19:30,000
...جنّية شقيّة

289
00:19:36,010 --> 00:19:36,970
!تفضّلي

290
00:19:38,640 --> 00:19:40,680
!أُصلِحَتْ

291
00:19:40,850 --> 00:19:42,430
هذا لا يُصدَّق

292
00:19:42,600 --> 00:19:45,020
حسناً، أنا عبقريّ في نهاية المطاف

293
00:19:46,560 --> 00:19:47,730
!لذيذة

294
00:19:48,560 --> 00:19:51,900
اختفت فطائر المانجو وبدأت
عقارب السّاعة بالتحرُّك

295
00:19:52,070 --> 00:19:54,070
ثمّ اختفت الجزيرة

296
00:19:54,610 --> 00:19:56,400
كما قالت السُّلحفاة

297
00:19:56,570 --> 00:20:01,330
اختفت الجزيرةُ فقط لأنّ اسمها
تغيّر إلى جزيرة جييتو

298
00:20:01,490 --> 00:20:04,620
لكن لماذا تغيّر الاسم؟

299
00:20:05,370 --> 00:20:06,960
لماذا جزيرة جييتو؟

300
00:20:08,210 --> 00:20:09,500
...جييتو

301
00:20:10,210 --> 00:20:11,500
!ج-ي-ت؟

302
00:20:11,670 --> 00:20:12,630
!مُستحيل

303
00:20:12,800 --> 00:20:14,130
!لاحظتُما أخيراً

304
00:20:14,920 --> 00:20:18,760
لا أصدّق بأنّ جيت-سينباي هو من أتى
إلى هذه الجزيرة قبل مئة عام

305
00:20:18,930 --> 00:20:22,600
كان عمري 120 سنة فقط عندما فعلتُ ذلك

306
00:20:23,680 --> 00:20:28,020
كنتُ مليئاً بروح المُغامرة، وشرعتُ
في رحلة الاختراعات

307
00:20:28,770 --> 00:20:32,150
لكن في الطّريق طالَتْني عاصفة

308
00:20:33,980 --> 00:20:36,530
فانتهى المطاف بي في هذه الجزيرة

309
00:20:42,910 --> 00:20:48,040
ثمّ ساعدَني أهلُ الجزيرة بينما
كنتُ أُصلح قاربي

310
00:20:50,670 --> 00:20:56,510
الأشجار السّاقِطة في الخُرافة هي
الخشب الّذي جمعتَه لصنع قاربك

311
00:20:56,670 --> 00:21:00,550
بفضل سكّان الجزيرة، عدتَ إلى المنزل بالسّلامة

312
00:21:00,720 --> 00:21:02,470
رددتُ الجميل لهم

313
00:21:03,100 --> 00:21:08,020
قبل 100 عام، كانت ساعة البرج
مُعطّلة وقد أصلحتُها

314
00:21:08,180 --> 00:21:11,600
!بدأتْ عقاربُ السّاعة بالتحرُّك
!هذا هو معناها إذاً

315
00:21:11,770 --> 00:21:13,690
ماذا عن الخربشات؟

316
00:21:13,860 --> 00:21:15,320
...حسبما أذكر

317
00:21:15,940 --> 00:21:18,780
هنا. انظرا بمُكبّر المرآة

318
00:21:20,490 --> 00:21:22,700
مُخطّطات القارب

319
00:21:22,870 --> 00:21:25,530
أعتقد بدتْ كخربشات بالنّسبة لهم

320
00:21:26,370 --> 00:21:30,540
لكن لم أكن أعلم بأنّهم استمدّوا
اسمَ الجزيرة منّي

321
00:21:30,710 --> 00:21:34,840
لا بُدّ أنّهم كانوا مُمتنّين لي لإصلاحي ساعة البرج

322
00:21:36,710 --> 00:21:39,220
!أيّتها المُتحرّيتان

323
00:21:40,840 --> 00:21:42,300
!زورانا ثانية

324
00:21:42,470 --> 00:21:43,430
!حسناً

325
00:21:43,590 --> 00:21:44,550
!وداعاً

326
00:21:50,680 --> 00:21:53,150
!حـ-حسناً، حان وقت الذّهاب

327
00:21:54,860 --> 00:21:56,690
!صه-
!سرّ-

328
00:22:00,650 --> 00:22:02,400
!إذاً الجنّية كانت حقيقيّة

329
00:22:03,910 --> 00:22:05,450
!هنا

330
00:22:06,660 --> 00:22:08,160
ما الأمر؟

331
00:22:08,330 --> 00:22:09,830
هل حدث شيء؟

332
00:22:11,960 --> 00:22:13,040
!هذا سرّ

333
00:23:48,640 --> 00:23:50,890
من هي كيور إكلير؟

334
00:23:51,600 --> 00:23:52,970
!ماذا؟

335
00:23:53,140 --> 00:23:55,060
إنّها إحدى هؤلاء الأربعة؟

336
00:23:55,680 --> 00:23:58,400
!الحلقة القادمة، ظهور إيريزا

337
00:23:59,060 --> 00:24:01,360
خمسة أسابيع حتّى تنكشف هويّتها

338
00:24:01,520 --> 00:24:05,530
!من هي برأيك؟ حُلّ اللّغز وصوّت