1
00:00:13,390 --> 00:00:15,850
!بعد أن نُنظّف، لنشرب الحليب

2
00:00:21,060 --> 00:00:22,400
!توقّفي

3
00:00:23,110 --> 00:00:23,940
!مهلاً

4
00:00:24,520 --> 00:00:27,240
قلتُ لك لا أملك وقتاً للّعب

5
00:00:27,400 --> 00:00:30,660
آسفة! المُعاملات الورقيّة للخروج
--من مسكني الدّراسيّ تأخّر كـ

6
00:00:34,200 --> 00:00:37,120
هل أنا أتوهّم، أم أنّه غير مُرتّب؟

7
00:00:38,620 --> 00:00:43,750
أنتِ هنا الآن، لذا لنجعل هذه وكالة
!تحرٍّ رائعة جدّاً

8
00:00:48,840 --> 00:00:52,590
!لنبحث عن اللّمحة في القلب

9
00:00:52,760 --> 00:00:55,850
إلهام مُشرِق

10
00:00:56,100 --> 00:00:58,730
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

11
00:00:58,890 --> 00:01:01,520
إنّها تنادينا

12
00:01:01,690 --> 00:01:04,360
أين الحقيقة؟ ما الّذي ستكتشفه؟

13
00:01:04,520 --> 00:01:07,990
لغز تلو الآخر

14
00:01:08,780 --> 00:01:14,120
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

15
00:01:14,280 --> 00:01:19,500
كما الدّليل! شيء يلمع عبر الزّمن

16
00:01:19,660 --> 00:01:22,330
كيف؟ كيف؟ أهي خدعة؟

17
00:01:22,500 --> 00:01:25,170
لماذا؟ لماذا؟ سوف نواجهها

18
00:01:25,590 --> 00:01:30,760
لننظر ونشعر
نكتشف الأسرار

19
00:01:31,220 --> 00:01:36,720
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

20
00:01:37,060 --> 00:01:42,270
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

21
00:01:42,520 --> 00:01:47,940
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

22
00:01:48,110 --> 00:01:51,490
!لنمشِ في ذلك الطّريق معاً

23
00:01:51,650 --> 00:01:55,410
!لنبحث عن اللّمحة في القلب

24
00:01:55,620 --> 00:01:57,240
إلهام مُشرِق

25
00:01:57,410 --> 00:02:03,080
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

26
00:02:03,250 --> 00:02:08,170
ولادتنا ولقاؤنا لَهو لغز رائع

27
00:02:08,340 --> 00:02:11,800
!هيّا يا بريكيور المُتحرّيات النّجمات

28
00:02:26,230 --> 00:02:29,320
مُذهل! إنّه أكبر ممّا توقّعت

29
00:02:30,230 --> 00:02:31,780
!الحديقة ظريفة جدّاً

30
00:02:31,940 --> 00:02:33,400
!أجل

31
00:02:35,820 --> 00:02:38,410
!ما أروعها

32
00:02:38,580 --> 00:02:41,040
!وحتّى أنّ الرّائحة عطِرة

33
00:02:41,200 --> 00:02:44,040
يبدو أنّ المُتحرّية النّجمة السّابقة استخدمتها

34
00:02:44,210 --> 00:02:46,460
سأستخدم أنا وبوتشيتان هذه الغرفة

35
00:02:46,630 --> 00:02:47,920
!نحن جارتان

36
00:02:51,510 --> 00:02:53,630
!للكُتُب ترتيب

37
00:02:53,800 --> 00:02:56,130
!تكون أجمل إذا فرزتُها بحسب اللّون

38
00:02:56,300 --> 00:02:58,970
!هذا غير عمليّ

39
00:02:59,140 --> 00:03:02,930
...أهمّية التخلُّص من التحيُّز التأكيديّ في التّحرّيات

40
00:03:03,100 --> 00:03:04,690
!أنتِ! عودي إلى العمل

41
00:03:05,140 --> 00:03:05,980
!حاضرة

42
00:03:08,810 --> 00:03:11,610
إذاً ماذا يوجد في الطّابق الثّاني؟

43
00:03:18,660 --> 00:03:20,780
أعتقد بأنّه مُجرّد مستودع؟

44
00:03:25,410 --> 00:03:27,750
أهذه خريطة للمنطقة؟

45
00:03:27,960 --> 00:03:28,630
أجل

46
00:03:28,790 --> 00:03:31,090
وكالة التّحرّي كيوريتو هنا؟

47
00:03:31,250 --> 00:03:32,090
أجل

48
00:03:32,250 --> 00:03:35,220
ستُبنى بلدتي هنا

49
00:03:37,430 --> 00:03:38,470
آنّا؟

50
00:03:38,970 --> 00:03:41,100
إنّها قريبة جدّاً! لم أكن أعلم

51
00:03:41,260 --> 00:03:43,470
لم أمرّ من هذا الاتّجاه من قبل

52
00:03:45,850 --> 00:03:48,850
سآتي، بعد أن أعود إلى زمني

53
00:03:52,110 --> 00:03:54,400
لديّ فكرة

54
00:03:55,150 --> 00:03:56,740
ديكور منزليّ؟

55
00:03:56,900 --> 00:03:59,200
هذا غير مُهمّ

56
00:03:59,360 --> 00:04:02,080
!مُجرّد خريطة على الجدار أمر مُملّ

57
00:04:02,990 --> 00:04:04,240
!تفضّلي

58
00:04:04,740 --> 00:04:08,670
أليس من الأفضل أن يكون لدينا
مكتب جميل عندما يأتينا مُوكّلون؟

59
00:04:08,830 --> 00:04:09,920
...مُوكّلون

60
00:04:10,500 --> 00:04:14,090
بالطّبع سنقبل كافّة القضايا كقاعدة

61
00:04:14,250 --> 00:04:17,920
لكن مهمّتنا هي إيقاف نقابة لصوص الشّبح

62
00:04:18,090 --> 00:04:19,300
!نعلم ذلك

63
00:04:19,470 --> 00:04:22,550
كنتُ أتساءل

64
00:04:23,220 --> 00:04:26,390
في زمني، العالم ليس مُغلّفاً بالأكاذيب

65
00:04:26,560 --> 00:04:28,850
لم أسمع بالأشباح من قبل

66
00:04:29,020 --> 00:04:30,520
!كذلك هنا

67
00:04:30,690 --> 00:04:31,810
إنّه عالمٌ مُسالم

68
00:04:32,230 --> 00:04:34,150
المُستقبل يتغيّر دوماً

69
00:04:34,320 --> 00:04:40,860
إن لم نعمل بجدّ في هذا، فهذا الزّمن
وزمنك سوف يُغلَّف بالأكاذيب

70
00:04:42,870 --> 00:04:46,540
قد يقع في قبضة جنّي بغيض

71
00:04:46,700 --> 00:04:48,960
جنّي بغيض؟

72
00:04:49,120 --> 00:04:50,500
ألم أخبركما؟

73
00:04:50,670 --> 00:04:54,210
يبقى الأشباح جنّيين مثلنا

74
00:05:03,510 --> 00:05:06,390
لم يبقَ الكثير حتّى السّاعة الموعودة

75
00:05:06,560 --> 00:05:09,310
حتّى فكّ تشفير مُجلّد السّرابات

76
00:05:10,640 --> 00:05:15,150
...نحتاج مجوهرات ماكوتو، لكن هذه الأخطاء

77
00:05:17,280 --> 00:05:20,070
أنا آسف أيّها المايسترو أوسونوار

78
00:05:20,240 --> 00:05:23,370
لم أحتسب لظهور مُتحرّيات بريكيور نجمات

79
00:05:26,030 --> 00:05:30,410
يشير مُجلّد السّرابات إلى جوهرة ماكوتو جديدة

80
00:05:34,420 --> 00:05:37,380
!من الأفضل أن أذهب أنا هذه المرّة

81
00:05:41,220 --> 00:05:43,430
أغيسيني، لماذا أنتِ؟

82
00:05:43,590 --> 00:05:47,510
!تنكّرك بفتاة مُراهقة؟ هذا سخيف جدّاً. مُحال

83
00:05:47,680 --> 00:05:49,180
!كان رديئاً للغاية

84
00:05:49,520 --> 00:05:51,270
!لا أسمح لكِ بقول ذلك

85
00:05:51,430 --> 00:05:53,270
!ها هما من جديد

86
00:05:53,440 --> 00:05:54,100
أجل

87
00:05:54,270 --> 00:05:55,440
!المايسترو أوسونوار

88
00:05:55,610 --> 00:05:58,190
!دع الأمر لي أنا، نيجي

89
00:05:59,070 --> 00:06:00,740
اذهبي يا أغيسيني

90
00:06:00,900 --> 00:06:01,740
ماذا؟

91
00:06:01,900 --> 00:06:05,070
اسرقيها بخفّة وأناقة

92
00:06:05,240 --> 00:06:07,490
!لـ-لا! امنحني فُرصة-
!مرحى-

93
00:06:07,660 --> 00:06:09,200
!لاي لاي، سيّدي

94
00:06:10,250 --> 00:06:11,620
!لاي لاي، سيّدي-
!لاي لاي، سيّدي-

95
00:06:14,250 --> 00:06:15,460
!يا للهول

96
00:06:15,630 --> 00:06:17,670
!هذا جميل جدّاً

97
00:06:18,340 --> 00:06:19,630
!أهلاً وسهلاً

98
00:06:19,800 --> 00:06:22,010
!إنّه مليء بالأشياء الظّريفة

99
00:06:23,380 --> 00:06:24,550
!هذا ظريف

100
00:06:24,720 --> 00:06:25,680
!بالفعل

101
00:06:25,840 --> 00:06:27,260
هل هذه سلحفاة؟

102
00:06:28,220 --> 00:06:31,560
!لا تلمسي! إنّه زُجاج، لذا قد ينكسر

103
00:06:31,730 --> 00:06:33,560
!جيت-سينباي، أريدها

104
00:06:33,730 --> 00:06:34,730
ماذا؟

105
00:06:34,890 --> 00:06:36,150
أنا آسفة

106
00:06:36,900 --> 00:06:39,070
هذه ليست للبيع

107
00:06:39,230 --> 00:06:39,980
ماذا؟

108
00:06:40,150 --> 00:06:41,820
إنّها رمز متجرنا

109
00:06:41,990 --> 00:06:42,900
رمز؟

110
00:06:43,070 --> 00:06:45,860
أجل! الجميع في المتجر يعتنون به

111
00:06:46,410 --> 00:06:50,660
،كما السّلحفاة، قد نكون بطيئين
لكنّنا نتقدّم خطوة خطوة

112
00:06:50,830 --> 00:06:54,710
وذات يوم، سوف نبني متجراً أروع وأكبر

113
00:06:55,120 --> 00:06:58,460
كلّما نظرتُ للسّلحفاة، أشعر
بأنّني أستطيع التقدُّم

114
00:06:58,790 --> 00:06:59,670
!يا للرّوعة

115
00:07:00,090 --> 00:07:04,130
لا أستطيع بيعكم هذه، لكن يمكنني
!أن أريكم بعض الأشياء الأُخرى

116
00:07:04,300 --> 00:07:05,550
!أجل، من فضلك

117
00:07:05,720 --> 00:07:06,890
تشيهو

118
00:07:07,510 --> 00:07:09,350
سأعيدها لكِ

119
00:07:09,760 --> 00:07:11,260
!شكراً لك يا تاكويا

120
00:07:11,430 --> 00:07:13,810
هل تبحثون عن شيء؟

121
00:07:13,980 --> 00:07:17,600
...في الواقع-
نريد أن نزيّن غرفتنا الجديدة-

122
00:07:17,770 --> 00:07:18,730
...في هذه الحالة

123
00:07:19,650 --> 00:07:20,400
!مرحباً

124
00:07:20,570 --> 00:07:21,690
!أهلاً وسهلاً

125
00:07:22,190 --> 00:07:24,360
!يا لها من أريكة ظريفة

126
00:07:24,530 --> 00:07:28,200
هل "ظريف" هي كلّ ما يمكنكما قوله؟
!لدينا أريكة أيضاً

127
00:07:28,370 --> 00:07:30,700
حسناً إذاً، ما رأيكم ببعض الوسادات؟

128
00:07:30,870 --> 00:07:32,790
يمكنكم تلبيس أريكتكم

129
00:07:33,790 --> 00:07:35,500
ستكون الوسادات كافية

130
00:07:35,960 --> 00:07:37,540
سأحضرها

131
00:07:38,380 --> 00:07:41,130
أليست هذه السّتائر رائعة؟

132
00:07:41,290 --> 00:07:42,550
إنّها مُبهرَجة جدّاً

133
00:07:43,460 --> 00:07:45,420
ماذا عن هذه؟

134
00:07:45,590 --> 00:07:47,590
تعطي انطباعاً عن مُتحرٍّ نجم

135
00:07:47,760 --> 00:07:48,680
!أجل

136
00:07:48,840 --> 00:07:50,930
أنتما تستمتعان بوقتكما

137
00:07:53,140 --> 00:07:54,810
أهي قضيّة أُخرى؟

138
00:07:56,810 --> 00:07:58,060
ما الخطب؟

139
00:07:58,230 --> 00:08:00,400
!النّحت! لقد اختفى

140
00:08:00,560 --> 00:08:01,230
ماذا؟

141
00:08:01,400 --> 00:08:03,020
!كان هناك قبل قليل

142
00:08:03,610 --> 00:08:04,780
!ساعدوها

143
00:08:04,940 --> 00:08:06,110
أهذه قضيّة؟

144
00:08:06,280 --> 00:08:09,740
قد تكون هناك جوهرة ماكوتو
في ذلك النّحت

145
00:08:10,570 --> 00:08:14,290
،كلّما أحضرتنا بوتشيتان إلى مكان

146
00:08:14,580 --> 00:08:18,250
،إمّا أن تكون جوهرة ماكوتو في خطر
أو قد تكون قد سُرِقت

147
00:08:18,420 --> 00:08:20,630
فهمت. قد يكون الأمر كذلك

148
00:08:22,290 --> 00:08:24,210
!دعا الأمر لنا

149
00:08:24,380 --> 00:08:25,420
ماذا؟

150
00:08:27,090 --> 00:08:28,220
!افتح

151
00:08:29,090 --> 00:08:30,680
!كتاب بري-كيت

152
00:08:31,800 --> 00:08:33,850
!يصبح أصغر حجماً للنّقل

153
00:08:34,010 --> 00:08:35,390
ألستُ عبقريّاً؟

154
00:08:36,520 --> 00:08:40,560
!نحن مُتحرُّون من وكالة التّحرّي كيوريتو

155
00:08:40,730 --> 00:08:41,940
مُـ-مُتحرُّون؟

156
00:08:42,110 --> 00:08:44,320
!سوف نحلّ قضيّتكما

157
00:08:44,480 --> 00:08:46,280
!من فضلكم

158
00:08:47,650 --> 00:08:49,570
ما الّذي يجري؟

159
00:08:49,740 --> 00:08:51,070
ماذا حدث؟

160
00:08:49,990 --> 00:08:51,070
سائح
توم ميلر

161
00:08:51,360 --> 00:08:53,530
هؤلاء هم جميع من كانوا في المتجر

162
00:08:53,700 --> 00:08:59,160
هل يُعقَل أن يكون اللّصّ قد تسلّل
وسرقه ثمّ خرج خلسة ثانية؟

163
00:08:59,330 --> 00:09:02,830
لكن يوجد حرسٌ على الباب، ولم يرنّ

164
00:09:03,000 --> 00:09:05,300
هل هناك أي أبواب أُخرى؟

165
00:09:05,710 --> 00:09:08,260
هذا هو مرسى تحميل الأثاثات

166
00:09:08,420 --> 00:09:12,550
ربّما دخل اللّصُّ من هناك وخرج
حاملاً النّحت؟

167
00:09:12,720 --> 00:09:15,430
هذا ممكن، لكن من المبكّر جدّاً المعرفة

168
00:09:15,600 --> 00:09:18,770
علينا أن نضع احتمالاً بأن يكون
اللّصّ لا يزال هنا

169
00:09:18,930 --> 00:09:22,440
لكن... لا يملك أحدٌ النّحت

170
00:09:23,770 --> 00:09:26,400
!قد يكون الأمر مُشابهاً للإكليل في حفل الزّفاف

171
00:09:26,570 --> 00:09:29,400
أجل! يمكن إخفاؤه في أيّ مكان

172
00:09:31,450 --> 00:09:34,570
!الكثير من أماكن الإخفاء

173
00:09:37,160 --> 00:09:39,250
ذلك النّحت زجاجيّ، أليس كذلك؟

174
00:09:39,410 --> 00:09:43,250
أجل، لا بُدّ أنّه مخفيّ في مكان
بحيث لا يمكن أن ينكسر

175
00:09:43,420 --> 00:09:44,210
أجل

176
00:09:45,210 --> 00:09:46,380
!عرفت

177
00:09:46,840 --> 00:09:47,800
حقّاً؟

178
00:09:54,090 --> 00:09:55,390
!وجدتُه

179
00:09:55,550 --> 00:09:56,220
!هنا

180
00:09:57,810 --> 00:09:59,390
!شكراً جزيلاً لكما

181
00:10:01,520 --> 00:10:04,020
!واحد، اثنان، كلّ السّتّة هنا

182
00:10:04,190 --> 00:10:05,650
!لم ينكسر شيء

183
00:10:07,860 --> 00:10:09,320
سأعيده إلى الرّفّ

184
00:10:09,480 --> 00:10:11,070
!شكراً لك، من فضلك

185
00:10:11,570 --> 00:10:13,320
أُغلِق ملفّ القضيّة؟

186
00:10:13,490 --> 00:10:18,740
ليس بعد! اللّصّ الشّبح الّذي حاول
!سرقة النّحت موجود بيننا

187
00:10:20,910 --> 00:10:23,040
!ميكورو! وقت الاستجواب

188
00:10:23,210 --> 00:10:27,500
أجل! والآن، أين كنتَ في وقت الجريمة؟

189
00:10:27,670 --> 00:10:30,460
لا أستطيع التكلٌّم باليابانيّة

190
00:10:30,630 --> 00:10:33,420
إنجليزيّة! ماذا نفعل؟

191
00:10:34,550 --> 00:10:38,970
لديّ الشّيء المُناسب! اختراعي
!العبقريّ، حلوى صمغ بري-كيت

192
00:10:42,560 --> 00:10:43,480
!افتح

193
00:10:46,520 --> 00:10:47,860
!حلوى صمغ بري-كيت

194
00:10:52,240 --> 00:10:53,950
!إنّها ظريفة جدّاً

195
00:10:54,110 --> 00:10:55,320
!جرّباها

196
00:10:57,620 --> 00:10:58,780
!طريّة

197
00:10:59,120 --> 00:11:00,410
!لذيذة

198
00:11:00,580 --> 00:11:02,370
!هذا ليس كلّ شيء

199
00:11:02,540 --> 00:11:05,960
مَن يأكلها، سيتمكّن من التكلّم وفهم أيّ لغة

200
00:11:06,120 --> 00:11:08,920
!حقّاً؟ مُذهل-
ما هو المُذهل؟-

201
00:11:09,090 --> 00:11:10,460
!فهمتُ ما قاله

202
00:11:10,630 --> 00:11:13,050
بالمناسبة، تدوم فعاليّتها ثلاث دقائق

203
00:11:13,210 --> 00:11:14,880
!حسناً، من الأفضل أن نسرع

204
00:11:16,220 --> 00:11:18,510
ماذا كنت تفعل في المتجر؟

205
00:11:18,680 --> 00:11:20,760
كنتُ معه، أبحث عن وشاح

206
00:11:21,390 --> 00:11:23,020
هل كنت معه؟

207
00:11:23,180 --> 00:11:23,980
أجل

208
00:11:24,430 --> 00:11:28,060
كان توم يبحث عن وشاح ليُقدّمه لأمّه

209
00:11:28,230 --> 00:11:30,320
اختار وشاحاً جميلاً لي

210
00:11:30,480 --> 00:11:33,740
أجل، اخترتُ طبعة مُشابهة لذلك النّحت

211
00:11:33,900 --> 00:11:37,860
أخبرني بأنّ أمّه تحبّ زراعة
النّباتات في حديقتها

212
00:11:38,030 --> 00:11:39,570
لذا ارتأيتُ بأنّها ستحبّها

213
00:11:39,740 --> 00:11:42,660
وشاح بطبعة مُشابهة للنّحت

214
00:11:42,830 --> 00:11:44,410
طبعة النّحت؟

215
00:11:44,580 --> 00:11:45,750
نباتات؟

216
00:11:45,910 --> 00:11:47,210
أين كنتِ؟

217
00:11:47,370 --> 00:11:52,130
كنتُ أداعب هذا اللّطيف منذ دخلتُ المتجر

218
00:11:52,300 --> 00:11:55,340
قطّ... لا يمكن أن يكون شاهداً

219
00:11:55,880 --> 00:11:57,010
كانت كذلك

220
00:11:57,180 --> 00:11:57,840
ماذا؟

221
00:11:58,010 --> 00:11:59,300
كانت تربت عليّ

222
00:11:59,470 --> 00:12:00,350
ماذا؟

223
00:12:00,510 --> 00:12:02,310
يمكننا فهم القطط؟

224
00:12:02,470 --> 00:12:03,510
ألستُ عبقريّاً؟

225
00:12:03,680 --> 00:12:05,770
إنّها ليست اللّصّة

226
00:12:06,730 --> 00:12:08,350
من بقي؟

227
00:12:08,520 --> 00:12:10,190
تشيهو وتاكويا

228
00:12:10,360 --> 00:12:12,190
...تشيهو؟ قطعاً لا

229
00:12:12,360 --> 00:12:13,400
...المعذرة

230
00:12:13,690 --> 00:12:16,070
أمّي تنتظر، لذا عليّ الذّهاب

231
00:12:16,900 --> 00:12:20,240
تاكويا، نسيت وضع مُلصَق على الغلاف

232
00:12:20,660 --> 00:12:22,080
آسف

233
00:12:22,240 --> 00:12:24,040
لدينا خدمة مُلصقات

234
00:12:24,410 --> 00:12:26,790
اختر واحدة من هذه

235
00:12:27,410 --> 00:12:30,460
...أختار واحدة من هذه السّتّة؟ هذا صعب

236
00:12:30,830 --> 00:12:33,840
سأختار الّتي تتطابق مع لون الوشاح

237
00:12:34,000 --> 00:12:34,920
...وشاح

238
00:12:35,090 --> 00:12:36,300
...ستّة

239
00:12:43,720 --> 00:12:44,850
!هكذا إذاً

240
00:12:45,010 --> 00:12:47,140
!هذا هو الجواب

241
00:12:47,640 --> 00:12:49,390
...اللّصّ هو-
!أجل-

242
00:12:49,560 --> 00:12:50,940
!ذلك الشّخص

243
00:12:59,400 --> 00:13:01,070
!عثرنا على اللّصّ

244
00:13:01,360 --> 00:13:03,660
...الشّخص الّذي سرق النّحت

245
00:13:04,620 --> 00:13:05,950
!هو أنت

246
00:13:06,370 --> 00:13:08,250
أ-أنا؟

247
00:13:08,410 --> 00:13:10,040
!هذا غير ممكن

248
00:13:10,210 --> 00:13:12,670
لا، لا يمكن أن يكون سواك

249
00:13:12,830 --> 00:13:15,960
كان مفتاح هذه القضيّة هو الوشاح

250
00:13:16,130 --> 00:13:17,420
الوشاح؟

251
00:13:17,670 --> 00:13:21,430
أخذتَ النّحت، وخرجت عبر مرسى التّحميل

252
00:13:21,590 --> 00:13:24,850
بما أنّك تعمل هنا، فلا أحد سيلاحظ

253
00:13:25,220 --> 00:13:30,180
لكن عندما حاولت المُغادرة، طلب
منك توم مُساعدته في البحث عن وشاح

254
00:13:30,350 --> 00:13:33,980
ارتعدتَ وأخباتَ النّحت بين الوسادات

255
00:13:34,150 --> 00:13:36,900
لأنّه لن ينكسر هناك

256
00:13:37,070 --> 00:13:38,780
!أنتم تتّهمونني فحسب

257
00:13:38,940 --> 00:13:40,530
!لا يمكن أن يكون تاكويا

258
00:13:40,700 --> 00:13:42,070
توم؟-
نعم؟-

259
00:13:42,410 --> 00:13:49,120
قال تاكويا بأنّ الوشاح الخاص بأمّكِ
لديه طبعة تُشبه النّحت، صحيح؟

260
00:13:49,620 --> 00:13:50,500
أجل

261
00:13:50,660 --> 00:13:52,000
هلّا أريتني؟

262
00:13:52,170 --> 00:13:54,130
أجل، تفضّلي

263
00:13:55,290 --> 00:13:56,000
هور؟

264
00:13:56,170 --> 00:13:58,670
أجل، كما النّحت تماماً، صحيح؟

265
00:13:58,840 --> 00:13:59,510
ماذا؟

266
00:13:59,670 --> 00:14:03,970
أجل. ظنّ تاكويا بأنّه نحت زهرة

267
00:14:04,140 --> 00:14:05,970
رغم أنّه سلحفاة

268
00:14:06,140 --> 00:14:07,220
سلحفاة؟

269
00:14:07,600 --> 00:14:09,680
...عندما عثرنا عليه بين الوسادات

270
00:14:09,850 --> 00:14:13,100
!كلّ السّتّة هنا! لم ينكسر شيء

271
00:14:13,270 --> 00:14:14,730
استغربتُ من ذلك

272
00:14:14,900 --> 00:14:18,440
لا يمكن تمييز شيء كهذا بهذه الطّريقة

273
00:14:18,610 --> 00:14:21,900
ظننتَ بأنّها زهرة، لذا قلتَ بأنّ هناك ستّة

274
00:14:22,070 --> 00:14:24,110
كما لو أنّك كنتَ تحصي بتلات

275
00:14:25,200 --> 00:14:28,830
مُحال لموظّف المتجر تاكويا
أن يرتكب خطأ كهذا

276
00:14:28,990 --> 00:14:30,950
!أنت لست تاكويا

277
00:14:33,120 --> 00:14:34,960
!هذا رديء جدّاً

278
00:14:37,750 --> 00:14:41,590
!أجل! أنا أغيسين من نقابة لصوص الشّبح

279
00:14:44,220 --> 00:14:45,680
!سآخذ هذا

280
00:14:52,930 --> 00:14:53,810
!مهلاً

281
00:14:56,190 --> 00:14:57,980
لماذا أنتِ هنا على أيّ حال؟

282
00:14:58,150 --> 00:15:00,690
رسالة من المايسترو أوسونوار

283
00:15:00,860 --> 00:15:03,070
اهزميهم واسرقيها بخفّة

284
00:15:03,650 --> 00:15:05,660
انتهى. افعلي ذلك

285
00:15:06,860 --> 00:15:07,990
ما مُشكلتكِ؟

286
00:15:08,160 --> 00:15:09,330
!ها هي ذي

287
00:15:09,490 --> 00:15:14,250
تبّاً. لم أكن أُفضّل ذلك لكن إذا كان
...المايسترو أوسونوار من يقول ذلك

288
00:15:15,080 --> 00:15:16,540
!يا أكاذيب، طوّقي

289
00:15:17,250 --> 00:15:19,290
!اقذفهم بعيداً

290
00:15:19,460 --> 00:15:20,550
!هانّيندا

291
00:15:27,050 --> 00:15:29,680
!هانّيندا

292
00:15:33,470 --> 00:15:35,140
ما الّذي يجري؟

293
00:15:36,390 --> 00:15:40,400
!تقنيّة شبح جديدة! أنتم معزولون عن الجميع

294
00:15:41,270 --> 00:15:43,570
!والآن ستبقى قضيّتكم بلا حلّ

295
00:15:50,490 --> 00:15:51,660
!افتح

296
00:15:56,620 --> 00:15:58,330
!ساعة جوهرة كيور

297
00:16:01,090 --> 00:16:03,710
!بريكيور! وقت الاستيقاظ

298
00:16:03,880 --> 00:16:05,590
!ثلاثة! اكتشفي

299
00:16:18,600 --> 00:16:20,610
!ستّة! ومُقابل بعضيهما الآخر

300
00:16:32,580 --> 00:16:34,700
!تسعة! نحن الثّنائي الإعجازيّ

301
00:16:44,000 --> 00:16:46,050
!دوري

302
00:16:46,210 --> 00:16:47,840
!وأنهي الأمر بشكل ظريف

303
00:17:11,950 --> 00:17:17,750
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، جواب كيور

304
00:17:20,080 --> 00:17:23,420
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

305
00:17:23,580 --> 00:17:26,250
!المُتحرّية النّجمة، كيور ميستيك

306
00:17:30,760 --> 00:17:32,840
!المُتحرّية النّجمة بريكيور

307
00:17:35,430 --> 00:17:37,890
!سأُريك إجابتي

308
00:17:38,520 --> 00:17:40,940
!هانّيندا

309
00:17:42,060 --> 00:17:44,150
!إنّها ليست زهرة، إنّها سلحفاة

310
00:17:46,020 --> 00:17:46,900
!هان

311
00:17:47,400 --> 00:17:48,110
!نين

312
00:17:50,150 --> 00:17:51,070
!دا

313
00:17:53,030 --> 00:17:54,910
!تلك الفتيات مُثيرات للاهتمام

314
00:17:55,280 --> 00:17:57,990
!ماذا تفعل يا هانّيندا؟ هذا رديء

315
00:17:58,160 --> 00:17:58,910
رديء؟

316
00:17:59,080 --> 00:18:00,830
يعني أنّ هذا سيّئ حقّاً

317
00:18:01,000 --> 00:18:03,040
صارت صيحة منذ مدّة

318
00:18:03,210 --> 00:18:05,330
!إنّها صيحة الآن إن سألتني

319
00:18:05,500 --> 00:18:07,170
!عليك بهم يا هانّيندا

320
00:18:07,340 --> 00:18:10,800
!هانّيندا

321
00:18:10,970 --> 00:18:11,920
!مهلاً

322
00:18:13,180 --> 00:18:14,010
!دا

323
00:18:20,060 --> 00:18:22,390
!هانّيندا

324
00:18:24,400 --> 00:18:25,100
!دا

325
00:18:28,570 --> 00:18:30,690
!هانّيندا

326
00:18:31,190 --> 00:18:32,490
!أجل

327
00:18:32,650 --> 00:18:34,740
هذه أغي. هل تشاهدني؟

328
00:18:34,910 --> 00:18:37,700
!المايسترو أوسونوار

329
00:18:40,830 --> 00:18:43,290
!أعتقد هذا يعني بأنّني ربحت

330
00:18:43,910 --> 00:18:46,420
هل أنتما غاضبتان لأنّني أخذتُ
جوهرة ماكوتو؟

331
00:18:47,500 --> 00:18:49,750
جوهرة ماكوتو هامّة

332
00:18:50,250 --> 00:18:52,130
إنّها رمز متجرنا

333
00:18:52,300 --> 00:18:54,340
!المسألة لا تقتصر على جواهر ماكوتو فقط

334
00:18:54,510 --> 00:18:58,100
أنتِ لا ترين المشاعر الّني كرّسها
!النّاسُ في ممتلكاتهم

335
00:18:58,260 --> 00:18:59,310
ماذا؟

336
00:18:59,640 --> 00:19:04,600
،كما السّلحفاة، قد نكون بطيئين
لكنّنا نتقدّم خطوة خطوة

337
00:19:04,940 --> 00:19:08,440
!سنستعيد أداة تشيهو الثّمينة

338
00:19:14,610 --> 00:19:16,950
!سوف نستمرّ في المضيّ قدماً أيضاً

339
00:19:23,870 --> 00:19:25,540
!هانّين

340
00:19:34,590 --> 00:19:42,310
!هذا هو جوابنا

341
00:19:47,140 --> 00:19:48,940
!كيوريتو إغلاق ملفّ قضيّة

342
00:19:51,110 --> 00:19:55,440
!هانّيندا

343
00:20:05,000 --> 00:20:07,580
!بوتشي بوتشي كيور كيور

344
00:20:14,130 --> 00:20:15,880
!هذا ذريع

345
00:20:20,300 --> 00:20:22,260
بريكيور إذاً؟

346
00:20:26,730 --> 00:20:29,020
شكراً جزيلاً لكم أيّها المُتحرُّون

347
00:20:29,600 --> 00:20:30,940
!عُدت

348
00:20:31,110 --> 00:20:34,150
أنا متأكّدة بأنّ هذا هو تاكويا الحقيقيّ

349
00:20:34,320 --> 00:20:38,610
لم أجد الكركديه الّذي طلبتِ منّي شراءه

350
00:20:38,780 --> 00:20:40,950
لم أطلب منك فعل ذلك

351
00:20:41,120 --> 00:20:45,580
من المؤكّد أنّ أغيسيني تحوّلتْ
إلى تشيهو وطلبتْ منه الذّهاب

352
00:20:46,750 --> 00:20:48,580
!إنّها جاهزة

353
00:20:49,500 --> 00:20:52,040
!وكالة التحرّي خاصّتنا

354
00:20:55,090 --> 00:20:57,010
...مـ-مالي

355
00:20:57,470 --> 00:20:59,010
!صارت رائعة

356
00:20:59,180 --> 00:20:59,970
!أجل

357
00:21:00,470 --> 00:21:03,220
أتساءل ماذا ستكون قضيّتنا الأولى؟

358
00:21:04,100 --> 00:21:07,520
لقد قرّرتُ بالفعل! مُوكّلي الأوّل

359
00:21:08,890 --> 00:21:10,520
ماذا؟ أنا؟

360
00:21:10,900 --> 00:21:12,310
أجل يا آنّا

361
00:21:12,810 --> 00:21:15,400
!سأعيدكِ إلى زمنكِ الخاص

362
00:21:15,900 --> 00:21:18,490
!أجل! لكن قرّرتُ شيئاً

363
00:21:18,650 --> 00:21:20,450
!أريد إنقاذ الجميع

364
00:21:22,200 --> 00:21:24,990
!لا أتحمّل عالماً مُغلَّفاً بالأكاذيب

365
00:21:25,870 --> 00:21:29,410
!سأكون مُتحرّية بريكيور نجمة معكِ يا ميكورو

366
00:21:29,580 --> 00:21:31,250
!يمكنني العودة لاحقاً

367
00:21:31,420 --> 00:21:32,500
!آنّا

368
00:21:35,960 --> 00:21:38,260
!استأجريني يا آنّا

369
00:21:38,760 --> 00:21:39,670
...ميكورو

370
00:21:40,800 --> 00:21:42,840
!أعيديني إلى زمني من فضلكِ

371
00:21:43,970 --> 00:21:46,060
!سأدرج القضيّة في كُتُبي

372
00:21:49,100 --> 00:21:54,610
سأسعى لأصبح مُتحرّية نجمة عظيمة
!وذلك كي أستطيع حلّ قضيّتك أيضاً

373
00:21:54,770 --> 00:21:55,900
!حسناً

374
00:21:56,070 --> 00:21:59,150
لنساعد بعضنا الآخر في أن نصبح
!مُتحرّيتَين نجمتين عظيمتين

375
00:22:02,360 --> 00:22:05,410
إنّهما مُتشابهتان جدّاً. تُشكّلان ثنائيّاً جيّداً

376
00:22:07,870 --> 00:22:10,580
الأمور على وشك أن تصبح حافلة هنا

377
00:23:47,340 --> 00:23:49,600
!جاء أخيراً! مُوكّلنا الأوّل

378
00:23:49,760 --> 00:23:52,390
...تفّاح، بطاطا، بصل-
بوتشي؟-

379
00:23:52,560 --> 00:23:54,100
!سأتفقّد الدّليل

380
00:23:54,270 --> 00:23:56,640
!تحوّلت مخطوطة المانغا إلى طعام

381
00:23:56,810 --> 00:23:57,690
بوتشي؟

382
00:23:58,230 --> 00:24:01,860
!النّجمة المُتحرّية بريكيور
"!حماسيّ! مُوكّلنا الأوّل""

383
00:24:02,020 --> 00:24:04,190
!وبهذا يكون قد تمّ إغلاق ملفّ كيوريتو