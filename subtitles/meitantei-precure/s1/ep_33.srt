1
00:00:13,930 --> 00:00:15,390
!تفضّلا

2
00:00:16,770 --> 00:00:17,850
!مُذهل

3
00:00:18,020 --> 00:00:20,150
!إنّه جميلٌ جدّاً

4
00:00:21,150 --> 00:00:24,690
تعطي انطباعاً بأنّها غرفة
!كوريا ولولوكا بالفعل

5
00:00:24,860 --> 00:00:27,820
!سأجري برنامجاً حواريّاً هنا

6
00:00:27,990 --> 00:00:30,660
سأحتسي الشّاي مع لولوكا

7
00:00:30,820 --> 00:00:33,160
!بوتشيتان أيضاً

8
00:00:33,330 --> 00:00:34,700
!على الرّحب والسّعة

9
00:00:34,870 --> 00:00:37,330
سأُعلّمك كيفيّة إعداد الشّاي

10
00:00:39,370 --> 00:00:41,880
لكنّها صغيرةٌ بعض الشّيء

11
00:00:42,330 --> 00:00:46,920
...نحن في الغرف الّتي كنتُما تستعملانها

12
00:00:47,380 --> 00:00:52,760
لا تقلقا، كنّا نقول فقط كم نحن
سعيدتان بمُشاركتها، صحيح؟

13
00:00:52,930 --> 00:00:56,720
أجل. إذا أتى زبون، فسنكون
جاهزات للبدء فوراً

14
00:00:57,220 --> 00:00:59,230
!أنتن! إنّهما جاهزتان

15
00:00:59,640 --> 00:01:01,730
!بِطاقات العمل للولوكا وكوريا

16
00:01:02,400 --> 00:01:03,650
!شكراً لك

17
00:01:09,950 --> 00:01:12,280
بوجود لولوكا هنا، أنتن لا تُقهَرن

18
00:01:12,450 --> 00:01:14,120
هذا مُطمئن جدّاً

19
00:01:14,280 --> 00:01:15,950
سنتعلّم منكِ

20
00:01:17,080 --> 00:01:21,080
والآن نستطيع مُساعدة المزيد
من المحتاجين

21
00:01:23,790 --> 00:01:24,880
لنفعلها

22
00:01:26,550 --> 00:01:28,880
...أركانا شادو

23
00:01:29,260 --> 00:01:34,180
غادرتْ تلميذتي دون قول
كلمة وداع لمُعلّمها

24
00:01:34,930 --> 00:01:38,430
سيترتّب عليّ تقديم درس أخير

25
00:01:39,310 --> 00:01:43,730
!وأحرص على أن تتعلّمه

26
00:01:48,860 --> 00:01:52,740
!لنبحث عن اللّمحة في القلب

27
00:01:52,900 --> 00:01:55,780
إلهام مُشرِق

28
00:01:56,120 --> 00:01:58,740
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

29
00:01:58,910 --> 00:02:01,460
إنّها تنادينا

30
00:02:01,620 --> 00:02:04,370
أين الحقيقة؟ ما الّذي ستكتشفه؟

31
00:02:04,540 --> 00:02:08,130
لغز تلو الآخر

32
00:02:08,800 --> 00:02:14,180
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

33
00:02:14,340 --> 00:02:19,430
كما الدّليل! شيء يلمع عبر الزّمن

34
00:02:19,680 --> 00:02:22,350
كيف؟ كيف؟ أهي خدعة؟

35
00:02:22,520 --> 00:02:25,310
لماذا؟ لماذا؟ سوف نواجهها

36
00:02:25,600 --> 00:02:30,900
لننظر ونشعر
نكتشف الأسرار

37
00:02:31,230 --> 00:02:36,740
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

38
00:02:37,120 --> 00:02:42,290
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

39
00:02:42,620 --> 00:02:48,090
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

40
00:02:48,250 --> 00:02:51,550
!لنمشِ في ذلك الطّريق معاً

41
00:02:51,710 --> 00:02:55,470
!لنبحث عن اللّمحة في القلب

42
00:02:55,630 --> 00:02:57,300
إلهام مُشرِق

43
00:02:57,470 --> 00:03:03,100
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

44
00:03:03,270 --> 00:03:08,190
ولادتنا ولقاؤنا لَهو لغز رائع

45
00:03:08,360 --> 00:03:11,820
!هيّا يا بريكيور المُتحرّيات النّجمات

46
00:03:18,370 --> 00:03:22,990
الطّريق إلى مُتحرٍّية نجمة"
"يبدأ بخطوة واحدة

47
00:03:23,410 --> 00:03:25,710
هذه بريتي هوليك

48
00:03:26,250 --> 00:03:29,790
،بالإضافة إلى كوننا مُتحرّيات
سنُدير هذا المتجر أيضاً

49
00:03:29,960 --> 00:03:31,420
أعلم -
ماذا؟ -

50
00:03:31,960 --> 00:03:37,010
تنكّرتْ لولوكا كزبونة وتسوّقتْ هنا سابقاً

51
00:03:37,180 --> 00:03:38,180
أجل

52
00:03:38,340 --> 00:03:40,680
عندما افتتح المتجر أوّل مرّة

53
00:03:41,100 --> 00:03:43,310
ماذا؟ أتيتِ منذ تلك المدّة البعيدة؟

54
00:03:43,470 --> 00:03:45,430
لم ألحظ إطلاقاً

55
00:03:45,850 --> 00:03:50,810
،إن كنتِ ستعملين في بريتي هوليك
فثمّة شيء واحد تحتاجينه

56
00:03:55,610 --> 00:03:58,990
!أهلاً وسهلاً

57
00:03:59,450 --> 00:04:00,780
أهلاً وسهلاً

58
00:04:01,160 --> 00:04:03,370
!لولوكا! كوني لطيفة

59
00:04:03,540 --> 00:04:05,830
الابتسامة هي خدمة زبائن أساسيّة

60
00:04:06,580 --> 00:04:07,620
...ابتسامة

61
00:04:08,250 --> 00:04:12,250
إذا عبسَ المُوظّف، فسيخاف الزّبون

62
00:04:12,750 --> 00:04:16,010
يحتاج الأطفال بالذّات لابتسامة مُشرقة

63
00:04:17,380 --> 00:04:20,930
ماذا؟ -
واجهتَ أيضاً صعوبةً في الابتسام -

64
00:04:25,970 --> 00:04:28,190
!نضجتَ كثيراً

65
00:04:28,350 --> 00:04:29,980
!أنا عبقريّ في نهاية المطاف

66
00:04:30,150 --> 00:04:32,400
!العباقرة لا يبخلون في الجهد

67
00:04:32,770 --> 00:04:34,650
لا عليكِ يا لولوكا

68
00:04:34,820 --> 00:04:37,610
حتّى جيت-سينباي تعلّمَ كيفيّة فعل ذلك

69
00:04:37,780 --> 00:04:39,360
أجل -
!أنتما -

70
00:04:40,410 --> 00:04:43,030
عليّ أن أتمرّن على الابتسام

71
00:04:43,780 --> 00:04:48,210
!كُلّ شيء يصنعه جيت-سينباي ظريف

72
00:04:48,370 --> 00:04:53,210
أجل، تُذكّرني هذه التّصاميم
بدبّوس النّجم كيرارينغ

73
00:04:53,380 --> 00:04:54,210
!بالفعل

74
00:04:54,670 --> 00:04:56,670
دبّوس النّجم كيرارينغ؟

75
00:04:56,840 --> 00:04:58,470
أتعرفنَه؟

76
00:04:58,630 --> 00:05:00,720
أجل! ماذا؟ ألم نُخبرك؟

77
00:05:00,880 --> 00:05:04,140
آسفة! لعلّنا نسينا ذِكره

78
00:05:04,850 --> 00:05:09,310
،آنذاك عندما كنتُ أنا ولولوكا في لندن
تمكنّا من رؤيته مرّة

79
00:05:09,730 --> 00:05:14,690
لم تتمكّن أي مُتحرِّية من إزالة الخاتم

80
00:05:15,520 --> 00:05:19,280
أجل، دبّوس النّجم كيرارينغ
!ليس مُجرّد أداة

81
00:05:19,440 --> 00:05:24,530
،إنّه قيّمٌ لدرجة أنّه أسطوريّ
...أداة فريدة بقوّة عُظمى

82
00:05:24,700 --> 00:05:26,830
على أيّ حال، إنّها أداةٌ مُذهلة

83
00:05:27,160 --> 00:05:30,250
إذاً لا تعرف التّفاصيل أيضاً؟

84
00:05:30,410 --> 00:05:33,040
!هناك أشياء حتّى العباقِرة لا يعرفونها

85
00:05:34,250 --> 00:05:36,500
هل من أحد هنا؟

86
00:05:36,800 --> 00:05:37,710
غويمون؟

87
00:05:37,880 --> 00:05:39,460
هل جوهرة ماكوتو قريبة؟

88
00:05:39,630 --> 00:05:40,420
أين؟

89
00:05:40,590 --> 00:05:41,550
!لا

90
00:05:41,720 --> 00:05:45,140
لستُ هنا لسرقة جوهرة ماكوتو

91
00:05:46,300 --> 00:05:48,640
أركانا شادو! ماذا تفعلين؟

92
00:05:48,810 --> 00:05:50,890
ماذا تقصد؟

93
00:05:51,850 --> 00:05:58,110
أنا أقدم منكِ ومُعلّمكِ. كيف أمكنكِ
مُغادرة اللّصوص الشّبح دون إخباري؟

94
00:05:58,730 --> 00:06:00,440
صعب المراس كعادته

95
00:06:01,030 --> 00:06:02,070
...أنا

96
00:06:04,070 --> 00:06:06,660
لم أعُد أركانا شادو

97
00:06:08,580 --> 00:06:13,670
،أنتِ تلميذة نقابة اللّصوص الشّبح
لا بل تلميذتي يا أركانا شادو

98
00:06:13,830 --> 00:06:16,290
!لا أستطيع أن أترككِ هكذا فحسب

99
00:06:17,040 --> 00:06:19,590
!فلتظهري يا متاهة الخِداع

100
00:06:23,430 --> 00:06:24,970
هناك مخرجٌ واحد فقط

101
00:06:25,430 --> 00:06:28,140
إن وجدتِه، فسوف أقبلكِ

102
00:06:28,310 --> 00:06:32,180
!ليس كلصّة، كمُتحرّية بريكيور نجمة

103
00:06:33,980 --> 00:06:35,770
غويمون مفقود؟

104
00:06:36,060 --> 00:06:39,730
وجدتُ كومةً من هذه، هل هي
رسالة من نوع ما؟

105
00:06:39,900 --> 00:06:41,860
ما المُشكلة؟

106
00:06:42,860 --> 00:06:43,650
!ها هو

107
00:06:43,820 --> 00:06:45,910
!لقد غادر بالفعل

108
00:06:46,240 --> 00:06:47,660
المايسترو أوسونوار

109
00:06:47,820 --> 00:06:52,370
دع الأمر لي لأحسم الأمر
!مع أركانا شادو

110
00:06:55,420 --> 00:06:56,920
هناك مخرجٌ واحد

111
00:06:57,420 --> 00:07:00,250
تؤدِّي الأبواب الأُخرى إلى أماكن مُختلفة

112
00:07:00,420 --> 00:07:05,090
خطأ واحد وستُرسَلين إلى عالم
مجهول تهيمين فيه للأبد

113
00:07:06,930 --> 00:07:08,550
نعم، من هناك؟

114
00:07:08,970 --> 00:07:10,930
!بوري، بوري، بوري، بوري

115
00:07:11,100 --> 00:07:13,140
بوري؟ من أنت؟

116
00:07:13,310 --> 00:07:15,140
!أنا بوريرون

117
00:07:15,310 --> 00:07:17,980
أين أنا؟ من أنت؟

118
00:07:18,150 --> 00:07:19,110
أنا؟

119
00:07:19,400 --> 00:07:24,490
!أنا غويمون من نقابة اللُّصوص الشّبح

120
00:07:24,650 --> 00:07:27,320
!سجق الأخطبوط لذيذٌ جدّاً

121
00:07:27,490 --> 00:07:28,450
!اسمع يا هذا

122
00:07:28,780 --> 00:07:30,240
هل تريد واحدة؟

123
00:07:30,530 --> 00:07:31,370
!لا

124
00:07:34,580 --> 00:07:36,210
والآن مَن؟

125
00:07:39,040 --> 00:07:40,040
!مهلاً

126
00:07:41,840 --> 00:07:42,880
لماذا كلب؟

127
00:07:43,050 --> 00:07:44,130
!مرحباً

128
00:07:44,300 --> 00:07:46,340
!مهلاً! نطقَ الكلب

129
00:07:47,130 --> 00:07:49,220
ماذا يفعل هناك؟

130
00:07:49,390 --> 00:07:50,300
لا أعلم

131
00:07:50,470 --> 00:07:52,180
ما أنت؟

132
00:07:52,350 --> 00:07:54,770
!أنا كوموغي! لنلعب معاً

133
00:07:54,930 --> 00:07:56,770
!لا أملك وقتاً للّعب

134
00:07:58,770 --> 00:08:02,020
الكثير من الأبواب يعني الكثير
!من المُقاطعات

135
00:08:02,190 --> 00:08:03,320
!لا أملك خياراً

136
00:08:05,990 --> 00:08:07,780
سأقلّص العدد إلى ثلاثة

137
00:08:08,070 --> 00:08:08,910
!حسناً

138
00:08:09,320 --> 00:08:12,870
هل يمكنكِ إيجاد باب النّجمة المُتحرّية بريكيور؟

139
00:08:13,280 --> 00:08:16,450
من بين الأبواب الثّلاثة، واحد هو الصّحيح

140
00:08:16,620 --> 00:08:17,870
أيُّهم هو؟

141
00:08:18,330 --> 00:08:21,920
الباب الصّحيح مخفيّ في أرقام اللّمحة

142
00:08:22,420 --> 00:08:23,670
أرقام اللّمحة؟

143
00:08:23,840 --> 00:08:26,090
أرقام مثل 3 و 6 و 9؟

144
00:08:26,800 --> 00:08:28,130
!اللّمحة الأولى

145
00:08:28,470 --> 00:08:30,090
!ثلاثة! اكتشف

146
00:08:30,260 --> 00:08:32,010
هذا الباب مُزيّف

147
00:08:32,600 --> 00:08:35,010
ثلاثة! الاكتشاف مُزيّف

148
00:08:35,930 --> 00:08:37,310
!اللّمحة الثّانية

149
00:08:37,600 --> 00:08:39,140
!ستّة! وواجه واحداً آخر

150
00:08:39,520 --> 00:08:42,150
قد يكون هذا الباب مُزيّفاً

151
00:08:42,440 --> 00:08:44,190
قد تكون 6 مُزيّفة

152
00:08:45,190 --> 00:08:46,570
!اللّمحة الثّالثة

153
00:08:46,900 --> 00:08:48,860
!تسعة! نحن الثّنائيّ الإعجازيّ

154
00:08:49,240 --> 00:08:51,360
!قد يكون هذا الباب حقيقيّاً

155
00:08:51,870 --> 00:08:54,870
تسعة قد يكون حقيقيّاً

156
00:08:55,580 --> 00:08:57,620
هذه كافّة اللّمحات

157
00:08:57,790 --> 00:08:59,410
أيُّ الأبواب هو الحقيقيّ؟

158
00:09:06,050 --> 00:09:10,590
قال بأنّ الجواب مخفيّ في أرقام اللّمحة

159
00:09:11,050 --> 00:09:14,100
...أرقام اللّمحة، 3، 6، 9

160
00:09:14,550 --> 00:09:18,850
...3, 6, 9

161
00:09:19,350 --> 00:09:26,520
إذا كان رقماً، لا ينبغي أن نُشتَّت
بكلمات مثل حقيقيّ ومُزيّف

162
00:09:26,690 --> 00:09:29,110
ما معنى هذا؟

163
00:09:30,150 --> 00:09:32,910
أرقام اللّمحة -
أيُعقَل ذلك؟ -

164
00:09:34,990 --> 00:09:37,620
الآيس كريم والألغاز تذوب
جميعها في نهاية المطاف

165
00:09:39,870 --> 00:09:41,330
...الجواب هو

166
00:09:43,790 --> 00:09:45,250
!ذاك الباب

167
00:10:04,650 --> 00:10:06,270
...الباب الصّحيح هو

168
00:10:07,150 --> 00:10:07,940
ثلاثة

169
00:10:08,230 --> 00:10:10,240
ما هو استنتاجك؟

170
00:10:10,690 --> 00:10:15,910
قلتَ بأنّ الباب الصّحيح كان مخفيّاً
في أرقام اللّمحة

171
00:10:16,320 --> 00:10:21,620
بأرقام اللّمحة، لم تقصد بأنّ 3، 6، 9
الّتي ظهرتْ في اللّمحات

172
00:10:22,080 --> 00:10:23,620
!اللّمحة الأولى

173
00:10:24,040 --> 00:10:25,630
!اللّمحة الثّانية

174
00:10:26,000 --> 00:10:27,630
!اللّمحة الثّالثة

175
00:10:28,000 --> 00:10:30,710
منحتنا ثلاث لمحات

176
00:10:31,170 --> 00:10:34,800
إذاً الجواب هو الباب ثلاثة

177
00:10:40,060 --> 00:10:41,100
!خرجنا

178
00:10:42,390 --> 00:10:45,020
كانت أُحجية بسيطة

179
00:10:45,600 --> 00:10:49,900
أحياناً التّفكير الزّائد يمكن
أن يزيد الأمر تشويشاً

180
00:10:50,070 --> 00:10:51,780
!تسرّني معرفة ذلك

181
00:10:53,900 --> 00:10:56,070
!كودوس، أركانا شادو

182
00:10:56,240 --> 00:10:57,870
!إليكِ هذه المُكافأة

183
00:11:00,790 --> 00:11:01,580
!فرقعة

184
00:11:03,370 --> 00:11:05,250
!سأقدِّم لكِ شهادة الدّبلوم

185
00:11:05,830 --> 00:11:07,580
!الآنسة أركانا شادو

186
00:11:08,380 --> 00:11:10,250
دبلوم؟

187
00:11:10,590 --> 00:11:13,380
أقنعتُ نفسي بأنّني مُحال
أن أقبل تلميذة

188
00:11:13,880 --> 00:11:19,010
لكن روحكِ أدهشَتْني، واتّخذتُكِ
كأوّل تلميذة لي

189
00:11:19,800 --> 00:11:22,270
قضينا أيّامنا نجمع مجوهرات ماكوتو معاً

190
00:11:22,430 --> 00:11:25,730
كوافدة جديدة، تعلّمتِ منّي

191
00:11:25,890 --> 00:11:27,900
تعلّمتِ بسرعة

192
00:11:28,270 --> 00:11:31,770
أحياناً تجاوزتْ روابطنا علاقة
المُعلّم والتّلميذ

193
00:11:32,110 --> 00:11:34,440
أكلنا الآيس كريم معاً

194
00:11:35,110 --> 00:11:38,450
ما الّذي يفعله غويمون؟

195
00:11:39,070 --> 00:11:41,200
لا علم -
لا أدري -

196
00:11:44,200 --> 00:11:47,620
كمُعلّمكِ، أوافق على تخرّجكِ

197
00:11:47,790 --> 00:11:50,790
هذا يُثبت بأنّكِ حقّقتِ استقلاليّة

198
00:11:50,960 --> 00:11:52,840
!والآن، خذيها

199
00:11:53,170 --> 00:11:55,220
ماذا ستفعلين؟

200
00:11:55,380 --> 00:11:56,470
ستأخذينها؟

201
00:11:57,300 --> 00:11:59,220
إنّها ليست بحاجة لها

202
00:12:02,390 --> 00:12:03,220
بوتشيتان؟

203
00:12:08,480 --> 00:12:09,980
ما هذا؟

204
00:12:12,570 --> 00:12:13,980
!جوهرة ماكوتو

205
00:12:14,230 --> 00:12:17,030
ماذا فعل؟ -
!هذا رائع -

206
00:12:17,400 --> 00:12:19,990
!استهنتُ بك يا غويمون

207
00:12:20,160 --> 00:12:27,410
مشاعري الجيّاشة تجاه تلميذتي
!استدعتْ جوهرة ماكوتو

208
00:12:27,580 --> 00:12:29,330
إنّها ليست تلميذتك

209
00:12:29,500 --> 00:12:31,500
!أنت واهم

210
00:12:31,880 --> 00:12:35,340
لكن تبدو مشاعره تجاه لولوكا حقيقيّة

211
00:12:36,880 --> 00:12:41,800
ظهور جوهرة ماكوتو تعني
!بأنّ الاختبار لم ينتهِ

212
00:12:45,140 --> 00:12:47,350
!طوِّقي أيّتها الأكاذيب

213
00:12:47,980 --> 00:12:50,600
!تعال يا هانّيندا

214
00:12:56,690 --> 00:12:59,740
!هان! نين! دا

215
00:13:00,200 --> 00:13:01,280
!هذا رديء جدّاً

216
00:13:01,450 --> 00:13:03,740
لماذا لا يُعيد الجوهرة إلى هنا فحسب؟

217
00:13:03,910 --> 00:13:08,330
!فهمت! يريد رواية أكثر جمالاً وشغفاً

218
00:13:08,830 --> 00:13:10,540
...غويمون

219
00:13:10,960 --> 00:13:13,250
هل تريد أن تُرسَل إلى غرفة الفِخاخ؟

220
00:13:13,670 --> 00:13:15,960
!ها! هانّيندا

221
00:13:16,250 --> 00:13:20,880
،إذا استدعتْ جوهرة ماكوتو
فلا بُدّ أنّها شيء مُميّز

222
00:13:22,260 --> 00:13:25,560
لكن لا يمكننا أن نسمح لنقابة
لصوص الشّبح بالحصول عليها

223
00:13:26,010 --> 00:13:27,220
!افتحي

224
00:13:36,020 --> 00:13:37,730
!عصا أركانا المُنيرة

225
00:13:41,780 --> 00:13:43,870
!بريكيور! حان وقت الاستيقاظ

226
00:13:46,910 --> 00:13:49,250
المعي أيّتها الزّنبقة البيضاء

227
00:13:58,130 --> 00:13:59,260
!صنبور الزّهور

228
00:14:20,400 --> 00:14:27,080
،الضّوء الأبيض الّذي يُنير الحقيقة
!المُتحرّية النّجمة، كيور أركانا

229
00:14:32,960 --> 00:14:33,960
!افتح

230
00:14:39,880 --> 00:14:41,960
!عطر لولب ليلي

231
00:14:44,630 --> 00:14:47,050
!بريكيور! وقت الاستيقاظ

232
00:14:47,800 --> 00:14:49,260
،الدّوران الورديّ

233
00:15:05,320 --> 00:15:06,450
!تفتّحي

234
00:15:29,300 --> 00:15:30,680
!استيقظي

235
00:15:30,850 --> 00:15:36,600
عطر الحقيقة الدّاخليّة، المُتحرّية
!النّجمة كيور إكلير

236
00:15:43,610 --> 00:15:44,860
!افتحي

237
00:15:49,780 --> 00:15:51,370
!ساعة جوهرة كيور

238
00:15:54,370 --> 00:15:56,750
!بريكيور! وقت الاستيقاظ

239
00:15:56,910 --> 00:15:58,460
!ثلاثة! اكتشفي

240
00:16:11,600 --> 00:16:13,640
!ستّة! وواجها بعضيكما الآخر

241
00:16:25,570 --> 00:16:28,030
!تسعة! نحن الثّنائي الإعجازيّ

242
00:16:37,160 --> 00:16:38,750
!دوري

243
00:16:39,120 --> 00:16:40,880
!وأنهي الأمر بشكل ظريف

244
00:17:05,070 --> 00:17:10,660
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، أنسر كيور

245
00:17:13,160 --> 00:17:16,490
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

246
00:17:16,660 --> 00:17:19,580
!المُتحرّية النّجمة، كيور ميستيك

247
00:17:23,790 --> 00:17:25,880
!المُتحرّية النّجمة بريكيور

248
00:17:28,380 --> 00:17:30,720
سأُريك إجابتي

249
00:17:31,470 --> 00:17:35,430
أركانا شادو. هذا امتحان تخرّجكِ

250
00:17:35,850 --> 00:17:41,140
،إذا استطعتِ هزيمتي أنا والهانّيندا
!فسأمنحكِ شهادة دبلومكِ

251
00:17:41,310 --> 00:17:44,110
كم مرّة يجب أن نقول بأنّها
تقول بأنّها لا تحتاجها؟

252
00:17:44,270 --> 00:17:46,190
يريد إعطاءها إيّاها حقّاً

253
00:17:46,360 --> 00:17:48,820
إذا أخذتْها، فرُبّما يُغادر

254
00:17:48,990 --> 00:17:50,650
هذا منطقيّ

255
00:17:52,450 --> 00:17:55,570
!هان! نين! دا-دا-دا-دا-دا

256
00:17:57,290 --> 00:17:58,740
!دادادادادا

257
00:18:07,880 --> 00:18:08,710
ما الأمر؟

258
00:18:08,880 --> 00:18:12,470
إن لم تُقاتلي، فلا يمكنكِ التخرُّج
يا أركانا شادو

259
00:18:13,260 --> 00:18:15,050
لستُ أركانا شادو

260
00:18:15,470 --> 00:18:18,430
!أنا كيور أركانا

261
00:18:25,940 --> 00:18:27,480
!نجمة أركانا اللّامعة

262
00:18:35,160 --> 00:18:38,200
!ها؟ ها؟

263
00:18:39,830 --> 00:18:41,290
!لستِ يقِظة

264
00:18:45,710 --> 00:18:46,630
!افتح

265
00:18:49,340 --> 00:18:50,760
!مصباح بري-كيت

266
00:18:53,130 --> 00:18:54,630
!خُذ هذه

267
00:18:56,470 --> 00:18:59,930
كيف لي أن أُهزَم بواسطة
نسمة خفيفة كهذه؟

268
00:19:04,270 --> 00:19:05,190
!ها-دا-دا

269
00:19:05,350 --> 00:19:06,350
!الآن

270
00:19:07,440 --> 00:19:08,310
!جميعكن

271
00:19:09,650 --> 00:19:11,190
!جوهرة ماكوتو

272
00:19:17,990 --> 00:19:18,950
،آنسر

273
00:19:20,490 --> 00:19:21,580
،ميستيك

274
00:19:23,200 --> 00:19:24,330
،إكلير

275
00:19:25,370 --> 00:19:26,330
!افتح

276
00:19:29,500 --> 00:19:32,630
!هذا هو جوابنا

277
00:19:36,050 --> 00:19:37,340
!بريكيور

278
00:19:38,340 --> 00:19:40,600
!النّجمة المُتحرِّية

279
00:19:50,020 --> 00:19:51,940
!أُغلِق ملفّ القضيّة كيوريتّو

280
00:19:53,480 --> 00:19:58,320
!هانّيندا

281
00:20:07,080 --> 00:20:09,920
!بوتشي بوتشي كيور كيور

282
00:20:17,260 --> 00:20:19,550
كيور أركانا شادو، أعلن بأنّكِ
حقّقتِ الاستقلاليّة

283
00:20:20,470 --> 00:20:21,720
لا بأس بكِ

284
00:20:22,140 --> 00:20:25,770
حسناً. سأعطيكِ شهادة الدّبلوم

285
00:20:26,350 --> 00:20:28,730
إن أصررت، فسوف آخذها

286
00:20:29,230 --> 00:20:30,770
ثمّة أمر آخر

287
00:20:33,190 --> 00:20:34,150
...هذه

288
00:20:34,780 --> 00:20:36,240
لقد نسيتِها

289
00:20:36,940 --> 00:20:39,820
لا يمكنكِ التّظاهر بأنّ الماضي
لم يحدث أبداً

290
00:20:39,990 --> 00:20:42,120
لا يمكنكِ محوه مهما حدث

291
00:20:42,740 --> 00:20:46,500
لا تنسي الطّريقَ الّذي سلكتِه
!كـ أركانا شادو

292
00:20:46,660 --> 00:20:49,500
!انقلي ماضيكِ إلى طريق مُستقبل جديد

293
00:20:51,330 --> 00:20:54,000
إنّه يفعل الكثير حقّاً

294
00:20:54,920 --> 00:21:01,010
.كيور أركانا! الآن نحن عدوّان
!سأسحقكِ بكامل قوّتي

295
00:21:01,180 --> 00:21:02,760
!كوني جاهزة

296
00:21:03,720 --> 00:21:05,930
لن أخسر أبداً

297
00:21:07,020 --> 00:21:08,730
تروقني نظرات العزيمة خاصّتكِ

298
00:21:08,890 --> 00:21:10,850
!سيكون من دواعي سروري هزيمتكِ

299
00:21:21,160 --> 00:21:26,080
...قد لا تُلائم مُتحرِّية نجمة، لكن

300
00:21:26,700 --> 00:21:29,040
هذه خطوة كبيرة لكِ

301
00:21:31,170 --> 00:21:36,130
إنّها دليلٌ على سعيكِ في التّفكير
والعمل والتقدُّم، خُطوة بخُطوة

302
00:21:36,500 --> 00:21:40,510
،في الواقع، زيّكِ ككيور أركانا ظريف

303
00:21:40,670 --> 00:21:44,220
لكن أعتقد بأنّ زيّ أركانا شادو
كان جميلاً أيضاً

304
00:21:45,970 --> 00:21:50,850
رحلة الألف ميل وطريق المُتحرِّية
النّجمة يبدأ بخطوة

305
00:21:51,310 --> 00:21:56,980
لا أطيق انتظار رؤية الطّريق
الّذي سنسلكه معاً

306
00:21:59,150 --> 00:21:59,990
أجل

307
00:22:00,440 --> 00:22:02,740
!إذاً يمكنكِ أن تبتسمي

308
00:22:02,910 --> 00:22:04,490
!ابتسامة

309
00:22:04,660 --> 00:22:06,700
تبدين ظريفة عندما تبتسمين

310
00:23:47,180 --> 00:23:49,890
استرجعنا اللّفيفة من اللّصوص

311
00:23:50,050 --> 00:23:52,010
لكن ثلاثة أشخاص يزعمون تملّكها؟

312
00:23:52,180 --> 00:23:53,430
من هو المالك الحقيقيّ؟

313
00:23:53,600 --> 00:23:55,730
!ينبغي أن تكون هناك أدلّة في رواياتهم

314
00:23:55,890 --> 00:23:57,690
لحظة، هل هذه شيروكو؟

315
00:23:58,230 --> 00:24:01,980
!المُتحرِّية النّجمة بريكيور
"لولوكا والبدر الذّهبيّ"

316
00:24:02,150 --> 00:24:04,440
!أغلِقَ ملفّ قضيّة اللّغز كيوريتّو