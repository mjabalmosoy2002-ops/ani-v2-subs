1
00:00:14,930 --> 00:00:16,100
شهيّ

2
00:00:16,270 --> 00:00:18,020
!شكراً على الانتظار

3
00:00:21,100 --> 00:00:23,570
كنتِ هنا طوال اليوم. من الأمر؟

4
00:00:24,610 --> 00:00:28,360
لا مكان آخر نذهب إليه-
أجل-

5
00:00:32,160 --> 00:00:36,120
!أنتما مُقرّبتان حقّاً

6
00:00:37,250 --> 00:00:41,380
في الواقع، إنّها صديقة كانت
تعيش في حيّي

7
00:00:41,540 --> 00:00:43,590
!يحدث هذا أحياناً

8
00:00:44,210 --> 00:00:45,960
ذات يوم، كنتُ أتكلّم مع زبون

9
00:00:46,130 --> 00:00:49,300
!وتبيّن بأنّه أحد أقربائي البعيدين

10
00:00:51,840 --> 00:00:53,220
انتهت ساعة الازدحام

11
00:00:53,720 --> 00:00:55,220
سأغادر لشراء بضعة أشياء

12
00:00:55,680 --> 00:00:57,220
!اهتمّي بالمحلّ

13
00:00:57,680 --> 00:00:58,730
!حسناً

14
00:01:02,770 --> 00:01:05,570
لولوكا، هل تبحثين عن مكان
جديد للعيش؟

15
00:01:06,230 --> 00:01:07,070
أجل

16
00:01:07,570 --> 00:01:10,150
!في هذه الحالة، أقترح قلعة

17
00:01:10,320 --> 00:01:11,110
قلعة؟

18
00:01:12,950 --> 00:01:15,580
!وذلك كي أقيم حفلةَ شاي هناك مع كوريا

19
00:01:15,740 --> 00:01:18,450
!سنحتسي الشّاي ونتناول الكعك

20
00:01:18,620 --> 00:01:20,040
!يا للرّوعة

21
00:01:20,210 --> 00:01:22,290
لِمَ يحقّ لكما أنتما الاستمتاع بذلك؟

22
00:01:22,460 --> 00:01:24,540
!لولوكا وأنا سنعيش هناك

23
00:01:36,850 --> 00:01:40,730
!لنبحث عن اللّمحة في القلب

24
00:01:40,890 --> 00:01:43,770
إلهام مُشرِق

25
00:01:44,100 --> 00:01:46,730
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

26
00:01:46,900 --> 00:01:49,440
إنّها تنادينا

27
00:01:49,610 --> 00:01:52,360
أين الحقيقة؟ ما الّذي ستكتشفه؟

28
00:01:52,530 --> 00:01:56,120
لغز تلو الآخر

29
00:01:56,780 --> 00:02:02,160
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

30
00:02:02,330 --> 00:02:07,420
كما الدّليل! شيء يلمع عبر الزّمن

31
00:02:07,670 --> 00:02:10,340
كيف؟ كيف؟ أهي خدعة؟

32
00:02:10,510 --> 00:02:13,300
لماذا؟ لماذا؟ سوف نواجهها

33
00:02:13,590 --> 00:02:18,890
لننظر ونشعر
نكتشف الأسرار

34
00:02:19,220 --> 00:02:24,730
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

35
00:02:25,100 --> 00:02:30,280
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

36
00:02:30,610 --> 00:02:36,070
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

37
00:02:36,240 --> 00:02:39,530
!لنمشِ في ذلك الطّريق معاً

38
00:02:39,700 --> 00:02:43,460
!لنبحث عن اللّمحة في القلب

39
00:02:43,620 --> 00:02:45,290
إلهام مُشرِق

40
00:02:45,460 --> 00:02:51,090
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

41
00:02:51,250 --> 00:02:56,180
ولادتنا ولقاؤنا لَهو لغز رائع

42
00:02:56,340 --> 00:02:59,810
!هيّا يا بريكيور المُتحرّيات النّجمات

43
00:03:06,310 --> 00:03:10,980
لقد عدتُ يا وكالة التحرّي كيوريتّو

44
00:03:11,690 --> 00:03:13,990
ماذا ينبغي أن نختار؟

45
00:03:16,030 --> 00:03:17,740
!هذا ظريف إلى حدّ النّجوم

46
00:03:17,910 --> 00:03:19,620
!أجل، قد تكون هذه مُناسبة

47
00:03:25,210 --> 00:03:28,830
!مرحباً

48
00:03:29,000 --> 00:03:30,840
أهلاً بكما

49
00:03:32,960 --> 00:03:34,550
عرفتُ بأنّكِ ستكونين هنا

50
00:03:34,710 --> 00:03:39,640
ليس لدينا رقمكِ، لكن توقّعنا أن
تكوني في متجر كوريا

51
00:03:40,930 --> 00:03:43,100
هل تحتاجانني في شيء؟

52
00:03:43,270 --> 00:03:46,560
أجل! في الواقع، نحتاج معروفاً

53
00:03:50,730 --> 00:03:52,440
مرحباً. باتيسري تشوتشو

54
00:03:52,610 --> 00:03:55,860
أنا آسفة، لكن أعتقد بأنّه
!سقطَ منّي شيء هناك

55
00:03:56,610 --> 00:03:58,110
سقط منكِ شيء؟

56
00:03:58,700 --> 00:04:01,660
كان هديّة عيد ميلاد من حبيبي

57
00:04:01,830 --> 00:04:04,410
آسفة، تكاد بطّاريّة هاتفي تنفد

58
00:04:04,580 --> 00:04:05,620
ميغومي؟

59
00:04:06,160 --> 00:04:08,420
اشتدّ الازدحام. أيمكنكِ البدء الآن؟

60
00:04:08,580 --> 00:04:09,920
!حاضرة

61
00:04:11,590 --> 00:04:12,460
!ماذا؟

62
00:04:15,300 --> 00:04:16,510
!جوهرة ماكوتو

63
00:04:16,970 --> 00:04:19,180
ماذا؟ هل سُرِقَتْ جوهرة ماكوتو؟

64
00:04:19,340 --> 00:04:20,640
!هنا-
!ماذا؟-

65
00:04:21,050 --> 00:04:22,100
!هناك

66
00:04:22,550 --> 00:04:24,180
!ميكورو-
!أجل-

67
00:04:33,820 --> 00:04:37,740
هل فقد أحدٌ هنا شيئاً هامّاً؟

68
00:04:38,700 --> 00:04:40,030
شيء هامّ؟

69
00:04:42,660 --> 00:04:45,200
لا ينقصني شيء

70
00:04:45,700 --> 00:04:47,580
كذلك أنا

71
00:04:47,750 --> 00:04:50,370
لا أحد ينقصه شيء

72
00:04:52,170 --> 00:04:54,250
لكنّه سُرِقَ هنا

73
00:04:57,960 --> 00:04:59,340
...في هذه الحالة

74
00:05:00,260 --> 00:05:03,550
لقد لمعتْ! لا بُدّ أنّ الأداة المسروقة
!هي الأداة الّتي سقطت

75
00:05:03,720 --> 00:05:04,890
سقطت؟

76
00:05:05,060 --> 00:05:09,730
قالت زبونة بأنّ هديّة عيد الميلاد
من حبيبها قد سقطتْ

77
00:05:09,890 --> 00:05:11,810
...جوهرة ماكوتو في هديّة

78
00:05:11,980 --> 00:05:13,270
هذا منطقيّ

79
00:05:13,440 --> 00:05:15,150
ماذا كانت الهديّة؟

80
00:05:15,610 --> 00:05:18,690
هديّة من حبيب؟ ربّما خاتم؟

81
00:05:18,860 --> 00:05:21,450
في الواقع... لا أعلم

82
00:05:21,610 --> 00:05:23,450
لا نعلم ما هي؟

83
00:05:23,620 --> 00:05:26,030
إذاً كيف يمكننا البحث عنها؟

84
00:05:26,200 --> 00:05:28,200
لنُركِّز قليلاً

85
00:05:30,160 --> 00:05:35,880
بعيداً عن الأشخاص هنا، كانت هناك
زبونة أُخرى واحدة فقط اليوم

86
00:05:36,040 --> 00:05:39,170
أجل، لا بُدّ أنَّ المُكالمة كانت منها

87
00:05:39,340 --> 00:05:41,510
كانت تجلس في ذلك المقعد

88
00:05:43,050 --> 00:05:47,220
،إذا كانت قد أسقطَتْها بالقرب من مقعدها
،فأخذَها شخصٌ ما

89
00:05:48,850 --> 00:05:52,640
فإنّ كُلّ هؤلاء الثّلاثة مُشتبه بهم

90
00:05:53,140 --> 00:05:54,600
كُلّ الثّلاثة؟

91
00:05:54,770 --> 00:05:57,110
لا بُدّ أنّ اللّصّ بينهم

92
00:06:05,870 --> 00:06:08,160
!هذا شهيّ حقّاً

93
00:06:09,660 --> 00:06:13,540
!هذا مُضحك! ليس ضمن مُخطّطاتي

94
00:06:14,920 --> 00:06:18,710
ماذا؟ أعتقد بأنّنا التقينا بها من قبل

95
00:06:18,880 --> 00:06:20,260
...في ذلك الوقت

96
00:06:20,420 --> 00:06:21,720
!أحسنتُما صنعاً

97
00:06:22,800 --> 00:06:25,640
!أنا نيجي بالفعل، يا عزيزي

98
00:06:26,090 --> 00:06:27,930
هو ثانية؟

99
00:06:28,100 --> 00:06:30,270
هذا مُمكن، لكن لا يمكننا إثبات ذلك

100
00:06:30,430 --> 00:06:32,640
فنحن لا نعرف ما الّذي سُرِق

101
00:06:32,810 --> 00:06:34,390
!لنسألهم

102
00:06:35,100 --> 00:06:35,900
لا

103
00:06:38,190 --> 00:06:42,360
يأكلون آيس كريم شهيّاً. يجب ألّا نُقاطعهم

104
00:06:45,280 --> 00:06:46,910
هذا هو طبعكِ

105
00:06:47,990 --> 00:06:50,120
اثنان منهم بريئان

106
00:06:50,290 --> 00:06:53,620
لا تريد مُقاطعة الآيس كريم خاصّتهما

107
00:06:53,790 --> 00:06:55,000
هذه هي سياسة لولوكا

108
00:06:55,540 --> 00:06:57,460
!لكن يجب علينا إيجاد الجاني

109
00:06:58,290 --> 00:07:00,090
هناك طُرُق أُخرى

110
00:07:02,380 --> 00:07:04,720
!كم هذا ظريف

111
00:07:05,800 --> 00:07:07,010
هل يمكننا لمسه؟

112
00:07:07,180 --> 00:07:08,890
بكلّ تأكيد

113
00:07:14,560 --> 00:07:19,020
إذا كان أحدهم هو الجاني، فيجب
أن يبتعد أولئك الأطفال

114
00:07:19,190 --> 00:07:20,020
أجل

115
00:07:22,650 --> 00:07:24,070
...لا يوجد خيارٌ آخر

116
00:07:30,990 --> 00:07:31,870
!افتح

117
00:07:34,660 --> 00:07:36,080
!مُلمِّع بري-كيت

118
00:07:46,970 --> 00:07:47,880
حسناً

119
00:07:50,970 --> 00:07:51,970
ماذا؟

120
00:07:57,850 --> 00:08:00,150
!لنلعب هناك

121
00:08:01,020 --> 00:08:03,190
!ظريفة جدّاً

122
00:08:05,360 --> 00:08:06,780
!انتظري

123
00:08:11,280 --> 00:08:12,830
!لولوكا مُذهلة

124
00:08:18,830 --> 00:08:21,960
والآن لنعُد إلى التحرِّي-
!أجل-

125
00:08:22,920 --> 00:08:24,420
انظرا إليها

126
00:08:26,550 --> 00:08:30,340
ذلك الخاتم، هل يُعقَل أن يكون
الهديّة من الحبيب؟

127
00:08:30,510 --> 00:08:36,310
لا، تلك الجوهرة الكبيرة باهظة الثّمن
جدّاً بالنّسبة لشخص صغير

128
00:08:36,890 --> 00:08:40,850
وهي تتطابق مع تلك الّتي في ياقة الكلب

129
00:08:41,350 --> 00:08:43,820
لذا هي ليست الأداة المفقودة

130
00:08:43,980 --> 00:08:44,940
أجل

131
00:08:45,110 --> 00:08:48,360
...هديّة عيد ميلاد لشابّة

132
00:08:49,820 --> 00:08:51,950
رُبّما تكون مع تلك الفتاة؟

133
00:09:08,630 --> 00:09:09,670
هكذا إذاً

134
00:09:09,840 --> 00:09:12,340
فهمتُ الأمر

135
00:09:13,340 --> 00:09:15,510
الآيس كريم والغموض ذابا في نهاية المطاف

136
00:09:17,520 --> 00:09:19,140
ذلك الشّخص هو الجاني

137
00:09:36,870 --> 00:09:37,950
...الجاني هو

138
00:09:39,120 --> 00:09:39,950
أنت

139
00:09:40,460 --> 00:09:42,210
لماذا أنا؟

140
00:09:42,870 --> 00:09:43,960
أنت نيجي، صحيح؟

141
00:09:44,460 --> 00:09:46,170
مـ-من هذا؟

142
00:09:46,840 --> 00:09:51,930
هديّة عيد الميلاد الّتي لديها جوهرة ماكوتو
هي هذه النظّارة الشّمسيّة

143
00:09:52,090 --> 00:09:53,510
نظّارة شمسيّة؟

144
00:09:54,050 --> 00:09:58,220
هدايا الشّابّات لا تكون بالضّرورة ظريفة دوماً

145
00:09:58,970 --> 00:10:02,190
تبيّن بأنّها نظّارة شمسيّة ذات تصميم بسيط

146
00:10:03,060 --> 00:10:06,060
!ذلكما الاثنان يرتديان نظّارةً شمسيّةً أيضاً

147
00:10:06,560 --> 00:10:10,150
أجل، إنّهما ترتديان نظّارةً شمسيّة

148
00:10:11,150 --> 00:10:13,910
لِمَ لا ترتدي نظّارتك أنت؟

149
00:10:14,410 --> 00:10:15,700
...أ-أنا

150
00:10:16,410 --> 00:10:19,160
الفتاة الّتي أضاعتها كانت ضئيلة الحجم

151
00:10:19,740 --> 00:10:24,120
النظّارة الشّمسيّة الّتي تُلائم
مقاسها صغيرة جدّاً عليك

152
00:10:24,790 --> 00:10:30,130
لهذا السّبب وضعت الأُخرتان نظّارتهما
عندما اشتدّت أشعّة الشّمس

153
00:10:30,880 --> 00:10:33,130
بينما تركتَ نظّارتك فوق رأسك

154
00:10:34,090 --> 00:10:36,090
فلو ارتديتها، لكانت قد انكسرت

155
00:10:38,220 --> 00:10:40,770
لكن ما أدراكِ بأنّه نيجي؟

156
00:10:41,180 --> 00:10:43,230
،بين اللّصوص الشّبح

157
00:10:43,390 --> 00:10:46,230
نيجي وأغيسيني ماهران في التنكُّر

158
00:10:46,900 --> 00:10:51,440
لكن دائماً ما ترتدي أغيسيني نظّارتها
الشّمسيّة، لذا هي معتادة عليها

159
00:10:52,070 --> 00:10:56,360
مُحال أن ترتكب خطأ وضع نظّارة
شمسيّة ليست بمقاس مُناسب

160
00:10:58,120 --> 00:10:59,200
صحيح؟

161
00:11:00,080 --> 00:11:01,290
يا أغيسيني؟

162
00:11:02,000 --> 00:11:06,040
!معها حقّ! كنتُ لأضعها في حقيبتي

163
00:11:06,540 --> 00:11:07,960
صحيح

164
00:11:14,470 --> 00:11:16,590
أحسنتِ صنعاً، يا عزيزتي

165
00:11:16,760 --> 00:11:18,390
أركانا شادو

166
00:11:18,550 --> 00:11:22,270
أوه، أعتقد بأنّكِ أركانا فقط الآن؟

167
00:11:22,770 --> 00:11:24,230
نادِني كيفما تشاء

168
00:11:24,390 --> 00:11:27,690
تمّ التنبُّؤ بوجود جوهرة ماكوتو هنا

169
00:11:28,940 --> 00:11:30,860
تنكّرتُ وأتيت

170
00:11:31,400 --> 00:11:36,570
ولسوء الحظّ كانت نظّارة شمسيّة صغيرة

171
00:11:37,490 --> 00:11:40,990
وبأنّكن أنتن البريكيور كُنتُن موجودات

172
00:11:42,910 --> 00:11:47,710
لكن لماذا؟ ليس لديكم أيّ سبب
يدفعكم لسرقة جواهر ماكوتو الآن

173
00:11:47,870 --> 00:11:52,920
لم نخسر بعد. تنبّأ مُجلّد الأسراب نبوءةً جديدة

174
00:11:53,090 --> 00:11:54,590
...نبوءة جديدة

175
00:11:55,630 --> 00:12:01,140
في آخر 1999، سيصبح كُلّ شيء صفراً"

176
00:12:01,760 --> 00:12:05,140
"حامل حجر الحقيقة سيصنع تاريخاً جديداً

177
00:12:09,940 --> 00:12:16,070
،قبل أن يُصبح كُلّ شيء صفراً في 2000
سنجمع جواهر ماكوتو المُتبقّية

178
00:12:16,780 --> 00:12:18,860
!أيّتها الأكاذيب، طوِّقي

179
00:12:19,610 --> 00:12:21,990
!تعال، هانّيندا

180
00:12:28,670 --> 00:12:30,830
!هانّيندا

181
00:12:32,210 --> 00:12:34,420
!سوف نُوقفك

182
00:12:35,130 --> 00:12:36,340
!افتحي

183
00:12:45,220 --> 00:12:46,850
!عصا تير أركانا

184
00:12:50,770 --> 00:12:52,980
!بريكيور! وقت الاستيقاظ

185
00:12:56,030 --> 00:12:58,490
المعي أيّتها الزّنبقة البيضاء

186
00:13:07,370 --> 00:13:08,370
!صنبور الزّهور

187
00:13:29,520 --> 00:13:36,190
،الضّوء الأبيض الّذي يُنير الحقيقة
!المُتحرّية النّجمة، كيور أركانا

188
00:13:41,990 --> 00:13:43,030
!افتح

189
00:13:49,000 --> 00:13:51,080
!عطر لولب ليلي

190
00:13:53,920 --> 00:13:56,290
