1
00:00:11,300 --> 00:00:12,470
...سوف

2
00:00:13,350 --> 00:00:15,270
!أحمي هذا العالم

3
00:00:32,570 --> 00:00:34,410
!ممتاز

4
00:00:34,740 --> 00:00:39,580
!مُطوّقة بشكل كامل بقوّة الظلّ
لم تعودي بريكيور

5
00:00:40,000 --> 00:00:41,380
،بصيغة أُخرى

6
00:00:41,540 --> 00:00:44,420
أنتِ إكليبس شادو الآن

7
00:00:49,880 --> 00:00:53,760
!لنبحث عن اللّمحة في القلب

8
00:00:53,930 --> 00:00:56,810
إلهام مُشرِق

9
00:00:57,140 --> 00:00:59,770
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

10
00:00:59,940 --> 00:01:02,480
إنّها تنادينا

11
00:01:02,650 --> 00:01:05,400
أين الحقيقة؟ ما الّذي ستكتشفه؟

12
00:01:05,570 --> 00:01:09,150
لغز تلو الآخر

13
00:01:09,820 --> 00:01:15,200
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

14
00:01:15,370 --> 00:01:20,460
كما الدّليل! شيء يلمع عبر الزّمن

15
00:01:20,710 --> 00:01:23,380
كيف؟ كيف؟ أهي خدعة؟

16
00:01:23,540 --> 00:01:26,340
لماذا؟ لماذا؟ سوف نواجهها

17
00:01:26,630 --> 00:01:31,930
لننظر ونشعر
نكتشف الأسرار

18
00:01:32,260 --> 00:01:37,760
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

19
00:01:38,140 --> 00:01:43,310
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

20
00:01:43,650 --> 00:01:49,110
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

21
00:01:49,280 --> 00:01:52,570
!لنمشِ في ذلك الطّريق معاً

22
00:01:52,740 --> 00:01:56,490
!لنبحث عن اللّمحة في القلب

23
00:01:56,660 --> 00:01:58,330
إلهام مُشرِق

24
00:01:58,490 --> 00:02:04,120
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

25
00:02:04,290 --> 00:02:09,210
ولادتنا ولقاؤنا لَهو لغز رائع

26
00:02:09,380 --> 00:02:12,840
!هيّا يا بريكيور المُتحرّيات النّجمات

27
00:02:19,560 --> 00:02:24,020
المُتحرّية النّجمة كيور أركانا

28
00:02:26,440 --> 00:02:28,230
!مُذهل

29
00:02:31,030 --> 00:02:33,900
أوسوتشي، ينبغي أن تُشاهدها
!بشكل مُباشر

30
00:02:34,070 --> 00:02:37,870
تصبح الأمور حماسيّة منذ استعرتُ هذا منك

31
00:02:38,030 --> 00:02:41,080
ماذا تقصد بأنّ كيور إكلير
ستصبح الملِك العظيم؟

32
00:02:41,240 --> 00:02:43,080
عليك أن تُصدّقني

33
00:02:43,250 --> 00:02:45,040
اكتشفتُ مؤخّراً فقط

34
00:02:45,580 --> 00:02:48,670
من خلال تحرّيات أركانا شادو المُتألّقة

35
00:02:49,920 --> 00:02:52,550
ما-ماذا عن مركز المايسترو أوسونوار؟

36
00:02:52,710 --> 00:02:54,220
ما الّذي سيحدث؟

37
00:02:56,260 --> 00:03:00,390
لا تقلقوا. سيرحل الملكُ قريباً

38
00:03:08,980 --> 00:03:10,570
لنضع حدّاً لهذا

39
00:03:11,230 --> 00:03:12,230
!انتظري

40
00:03:18,200 --> 00:03:19,070
ابتعدي عن طريقي

41
00:03:19,240 --> 00:03:20,370
!لا

42
00:03:20,530 --> 00:03:23,120
!كوريا ليست الملِك العظيم

43
00:03:23,290 --> 00:03:24,410
توقّفي يا شوشوتان

44
00:03:25,460 --> 00:03:29,250
لم يُخطئ استنتاج لولوكا يوماً

45
00:03:29,420 --> 00:03:30,250
...كوريا

46
00:03:31,170 --> 00:03:33,210
أنا متأكّدة بأنّكِ لاحظتِ هذا أيضاً

47
00:03:33,380 --> 00:03:34,710
...في عينها

48
00:03:36,880 --> 00:03:37,970
ذلك النّجم

49
00:03:41,260 --> 00:03:43,220
إنّه مثل عيونهم

50
00:03:46,600 --> 00:03:47,390
ماذا؟

51
00:03:47,560 --> 00:03:50,110
!لـ-لماذا لم تُخبروني؟

52
00:03:50,270 --> 00:03:55,610
،أ... أنا آسف، لكنّها كانت سريعة جدّاً
فلم نستطع رؤية عينها

53
00:03:55,780 --> 00:03:58,160
ماذا؟ لكن أنا لاحظت

54
00:03:58,320 --> 00:03:59,110
!ماذا؟

55
00:03:59,280 --> 00:04:00,660
!كان ينبغي أن تُخبرنا -
--مُحال لي أن -

56
00:04:00,820 --> 00:04:03,080
!ستدخل غرفة الفِخاخ -
!لا، أرجوك -

57
00:04:03,700 --> 00:04:05,250
تُفيد الأسطورة بأنّ

58
00:04:05,410 --> 00:04:09,170
شخصاً لديه نجمة في عينيه
سيُصبح الملِك العظيم

59
00:04:09,420 --> 00:04:11,960
لم أسمع بهذا من قبل

60
00:04:12,130 --> 00:04:15,760
لولوكا وأنا اكتشفنا ذلك أوّل مرّة
عندما انضممنا للّصوص الشّبح

61
00:04:16,880 --> 00:04:18,510
من الطّبيعيّ ألّا تعلمون ذلك

62
00:04:18,680 --> 00:04:24,260
،إنّها أسطورةٌ قديمةٌ نُقِلَتْ إلينا نحن
العِرق المنسيّ

63
00:04:24,430 --> 00:04:26,890
العِرق المنسيّ؟

64
00:04:27,890 --> 00:04:28,690
أجل

65
00:04:29,270 --> 00:04:30,400
،بواسطة البشر

66
00:04:30,560 --> 00:04:31,610
والجنّيّين أيضاً

67
00:04:31,770 --> 00:04:33,570
كانوا منسيّين

68
00:04:36,440 --> 00:04:38,240
مُفاجئ، أليس كذلك؟

69
00:04:38,860 --> 00:04:43,160
،وُلِد من الرّوابط بين البشر والجنّيّين
لولب ليلي

70
00:04:43,330 --> 00:04:46,660
هل هذا ما وضع النّجمَ في عينك؟

71
00:04:46,830 --> 00:04:48,410
...أو رُبّما

72
00:04:49,290 --> 00:04:53,130
على أيّ حال، هذا مُنعطف لا يُصدَّق
!للأحداث حقّاً

73
00:04:53,630 --> 00:04:57,510
إذاً هذا هو سبب مُحاولة لولوكا هزيمتي

74
00:04:58,510 --> 00:04:59,840
ليس لهزيمتك

75
00:05:00,760 --> 00:05:05,810
تحاول لولوكا سحق جوهرة
ماكوتو في قلبكِ

76
00:05:05,970 --> 00:05:07,020
سحقها؟

77
00:05:07,470 --> 00:05:10,020
،من دون جوهرة ماكوتو الخاصّة بإكلير

78
00:05:10,190 --> 00:05:14,940
ستفقد قوّتَها كبريكيور وذاكرتها
!كمُتحرّية ثانية

79
00:05:15,110 --> 00:05:16,020
هذا صحيح

80
00:05:16,940 --> 00:05:20,740
ستعيش كـ كوريا هووا، الحلوانيّة

81
00:05:22,070 --> 00:05:22,990
!...هذا

82
00:05:23,160 --> 00:05:25,530
!هذا لطف لولوكا

83
00:05:25,700 --> 00:05:27,240
!هذا ليس لطفاً

84
00:05:28,120 --> 00:05:30,910
...نحن لن -
!نسمح بحدوث هذا... -

85
00:05:31,750 --> 00:05:34,330
!كمُتحرّيتين نجمتين

86
00:05:35,840 --> 00:05:36,920
!كوريا

87
00:05:41,380 --> 00:05:42,260
!أجل

88
00:05:45,300 --> 00:05:46,260
!افتح

89
00:05:52,270 --> 00:05:54,480
!عطر لولب ليلي

90
00:05:57,190 --> 00:05:59,610
!بريكيور! وقت الاستيقاظ

91
00:06:00,110 --> 00:06:01,530
،الدّوران الورديّ

92
00:06:17,840 --> 00:06:18,800
!تفتّحي

93
00:06:41,400 --> 00:06:43,070
!استيقظي

94
00:06:43,240 --> 00:06:48,990
عطر الحقيقة الدّاخليّة، المُتحرّية
!النّجمة كيور إكلير

95
00:06:54,120 --> 00:06:56,290
!سأُريك إجابتي

96
00:06:56,920 --> 00:07:01,460
،قوّتها قد ولّتْ منذ زمن بعيد
ومع ذلك إنّها صامدة

97
00:07:03,840 --> 00:07:06,640
يبدو أنّ قلبها هو الوحيد الّذي لم ينكسر

98
00:07:08,050 --> 00:07:10,350
ألم تسمعنَ ما قلتُه؟

99
00:07:10,850 --> 00:07:15,690
مثلما تنبّأ مُجلّد الأسراب، في يوليو
قد استيقظتِ كملِك عظيم

100
00:07:16,440 --> 00:07:18,230
،إن لم أوقفكِ

101
00:07:18,400 --> 00:07:21,690
!سيُطوَّق العالم بظِلال الأكاذيب

102
00:07:22,780 --> 00:07:24,530
!انعكاس ميستيك

103
00:07:26,660 --> 00:07:28,370
!هذا ليس استنتاجاً منطقيّاً

104
00:07:28,530 --> 00:07:31,450
أتستخدمين مُجلّد الأسراب كدليل قاطع؟

105
00:07:31,620 --> 00:07:32,740
!هذا هُراء

106
00:07:34,080 --> 00:07:35,080
!اصمتي

107
00:07:38,210 --> 00:07:39,080
!أجل

108
00:07:39,540 --> 00:07:42,050
!إنّها ليست إجابة وجدتِها بنفسكِ

109
00:07:42,550 --> 00:07:44,670
،حتّى لو كانت كوريا هي الملِك العظيم

110
00:07:44,840 --> 00:07:48,010
هل سيُطوَّق العالم حقّاً بأكاذيب؟

111
00:07:48,510 --> 00:07:50,720
أنا متأكّدة بأنّنا نستطيع إيجاد
!طريقة لمُعالجة الأمر

112
00:07:50,890 --> 00:07:52,430
!لدينا إكلير

113
00:07:52,600 --> 00:07:53,890
!لدينا أنتِ

114
00:07:55,060 --> 00:07:57,520
،إذا اتّخذنا نحن الأربعة خطوةً معاً

115
00:07:58,400 --> 00:08:01,730
!فإنّ خطوة شجاعة واحدة تُصبح الجواب

116
00:08:02,480 --> 00:08:03,820
لا أريد أن أنسى

117
00:08:03,980 --> 00:08:07,280
!فأساساً، أصبحتُ مُتحرّية نجمة

118
00:08:08,030 --> 00:08:11,910
!التقيتُ بشريكات مُتألّقات

119
00:08:17,910 --> 00:08:18,960
!لولوكا

120
00:08:19,120 --> 00:08:20,790
!لولوكا، تماسكي

121
00:08:22,500 --> 00:08:24,340
ديتشي آغين

122
00:08:25,380 --> 00:08:28,430
...المزيد... أحتاج مزيداً من القوّة

123
00:08:28,590 --> 00:08:31,680
...لا! إذا استخدمتِ مزيداً من قوّة الظلّ

124
00:08:31,850 --> 00:08:33,390
!سأنقذ العالم

125
00:08:37,480 --> 00:08:39,230
!مُذهل

126
00:08:39,390 --> 00:08:42,020
!عزيمة مُلائمة للفصل الأخير

127
00:08:42,690 --> 00:08:45,980
سأمدّكِ بقوّتي بكلِّ سرور يا شادو

128
00:08:53,160 --> 00:08:54,280
!لا

129
00:09:11,220 --> 00:09:12,300
نجمة؟

130
00:09:14,550 --> 00:09:19,430
،دمّري الدّليل بأنّ كوريا كانت هنا
والمواد المُتعلِّقة بالملِك العظيم

131
00:09:20,060 --> 00:09:24,940
،إذا عَلِمَتْ لندم بتلك القوّة
ستكون كوريا في خطر

132
00:09:25,860 --> 00:09:28,400
سأستعيد جوهرة ماكوتو الخاصّة بكوريا

133
00:09:29,110 --> 00:09:29,940
شوشوتان

134
00:09:30,530 --> 00:09:34,120
اعتني بكوريا ريثما نعود

135
00:09:40,410 --> 00:09:42,370
لا يمكنكِ هزيمتي

136
00:09:42,830 --> 00:09:45,500
إن أردتِ هذه، فسأعطيكِ إيّاها

137
00:09:46,800 --> 00:09:52,090
،إذا اعتليتِ المسرح كلصّة شبح
وأحضرتِ جوهرة ماكوتو بديلة

138
00:09:52,720 --> 00:09:54,550
...دوركِ سيكون

139
00:09:56,720 --> 00:09:59,270
كيور أركانا شادو

140
00:10:02,020 --> 00:10:03,730
الملِك العظيم المُستقبليّ

141
00:10:03,900 --> 00:10:06,310
سيكون لديه نجمة في عينيه

142
00:10:06,480 --> 00:10:09,940
هذه هي أسطورة عِرقنا

143
00:10:10,360 --> 00:10:11,360
...توقّعتُ ذلك

144
00:10:12,360 --> 00:10:13,740
...كوريا

145
00:10:24,370 --> 00:10:25,830
،سأحصل على جوهرة ماكوتو

146
00:10:26,670 --> 00:10:27,920
وأسحقها

147
00:10:36,590 --> 00:10:40,680
هل تريدين حقّاً أن تفقد كوريا ذاكرتها؟

148
00:10:40,850 --> 00:10:41,850
!لولوكا

149
00:10:42,310 --> 00:10:46,150
أنتِ صديقتي، لذا قلتُ بأنّني
سأحمي كيور إكلير

150
00:10:46,860 --> 00:10:48,020
!لكن كنتُ مُخطئة

151
00:10:48,820 --> 00:10:49,820
!نحن صديقات

152
00:10:50,400 --> 00:10:52,190
!هذا لأنّنا صديقات

153
00:10:52,360 --> 00:10:53,650
...بيدَي هاتين

154
00:10:54,200 --> 00:10:56,530
!يجب أن أوقف كيور إكلير

155
00:11:04,830 --> 00:11:06,710
!بريكيور

156
00:11:10,840 --> 00:11:12,340
!مُذهل

157
00:11:28,310 --> 00:11:29,610
!أوقفي لولوكا

158
00:11:31,110 --> 00:11:33,530
أعلم بأنّكِ تستطيعين إيقافها

159
00:11:34,190 --> 00:11:35,150
ماشوتان؟

160
00:11:37,910 --> 00:11:38,910
هل هذا...؟

161
00:11:40,240 --> 00:11:41,240
أرجوكِ

162
00:11:42,490 --> 00:11:45,160
!أرجوكِ يا كيور إكلير

163
00:11:47,790 --> 00:11:48,580
حسناً

164
00:11:57,300 --> 00:12:00,640
!سيُطوَّق العالم بأكاذيب

165
00:12:00,800 --> 00:12:02,260
!يجب عليّ إيقافها

166
00:12:04,810 --> 00:12:05,730
!يكفي

167
00:12:08,350 --> 00:12:11,400
!أريد أن أكون معكِ

168
00:12:11,980 --> 00:12:15,190
!مع شوشوتان وماشوتان

169
00:12:18,200 --> 00:12:19,160
!مع الجميع

170
00:12:19,320 --> 00:12:21,160
!أريد أن أكون مع الجميع

171
00:12:23,530 --> 00:12:24,830
!وقت اللّمعان

172
00:12:30,790 --> 00:12:33,840
!أريد أن أكون معكِ يا لولوكا

173
00:12:42,680 --> 00:12:43,640
...مُستحيل

174
00:12:45,220 --> 00:12:46,180
!لولوكا

175
00:12:46,850 --> 00:12:48,640
...حتّى إن لم نستطع أن نكون معاً

176
00:12:51,150 --> 00:12:56,030
،ما دمتِ تستطيعين أن تكوني سعيدة
فهذا يكفيني

177
00:12:57,030 --> 00:13:01,410
لا أريد نسيان أيّامي الّتي قضيتُها
!في وكالة التحرِّي كيوريتّو

178
00:13:01,860 --> 00:13:04,410
!لا أريد أن أنسى كيف قبلتِني

179
00:13:05,540 --> 00:13:08,410
لا تنسي لمعانكِ أبداً

180
00:13:10,000 --> 00:13:11,920
أنتِ قويّة

181
00:13:14,590 --> 00:13:17,760
!لن... أنسى ذلك ثانية أبداً

182
00:13:21,180 --> 00:13:22,090
!أخبريني

183
00:13:23,390 --> 00:13:27,560
!بجوابكِ... الحقيقيّ

184
00:13:53,960 --> 00:13:55,380
أنا كوريا هووا

185
00:13:56,420 --> 00:13:58,590
لولوكا... موريا

186
00:13:59,460 --> 00:14:00,510
!سررتُ بلقائكِ

187
00:14:01,590 --> 00:14:02,430
وأنا

188
00:14:08,060 --> 00:14:11,850
!أريد... أن أكون معكِ أيضاً

189
00:14:12,020 --> 00:14:15,060
!أريد أن أتقدّم خطوة للأمام معكِ

190
00:14:15,900 --> 00:14:18,440
!أريد أن أمشي بجانبكِ

191
00:14:29,290 --> 00:14:30,240
!لولوكا

192
00:14:30,910 --> 00:14:34,250
!ردعتْ قوّةَ الظلّ؟

193
00:14:34,420 --> 00:14:38,170
من يحمل حجر الحقيقة سيُصبح ملِكاً عظيماً

194
00:14:38,340 --> 00:14:42,170
ثمّ سيُطوَّق العالم بظِلال من الأكاذيب

195
00:14:42,670 --> 00:14:46,220
هل يمكن أن تكون الظِّلال
الّتي تُغطّي العالم...؟

196
00:14:46,590 --> 00:14:47,600
أجل

197
00:14:47,760 --> 00:14:51,520
الظلّ الّذي غطّى لولوكا... الّذي
!غطّى عالمَ لولوكا

198
00:15:29,350 --> 00:15:30,300
!ليس بعد

199
00:15:30,470 --> 00:15:34,060
!لا يزال هناك ظلّاً صنعتُه

200
00:15:41,570 --> 00:15:43,900
كُلّ هذا غلطتي. أنا آسفة

201
00:15:44,070 --> 00:15:45,110
!لا عليكِ

202
00:15:46,780 --> 00:15:48,200
!لنُوقف الأكاذيب

203
00:15:48,870 --> 00:15:49,660
أجل

204
00:15:50,120 --> 00:15:51,700
!بقوّتنا

205
00:15:53,080 --> 00:15:53,870
!أجل

206
00:15:54,750 --> 00:15:58,000
!فنحن المُتحرّيات النّجمات

207
00:16:04,800 --> 00:16:05,590
أجل

208
00:16:06,880 --> 00:16:08,090
!افتحي

209
00:16:16,640 --> 00:16:18,600
!عصا تير أركانا

210
00:16:22,480 --> 00:16:24,730
!بريكيور! وقت الاستيقاظ

211
00:16:27,780 --> 00:16:30,240
المعي أيّتها الزّنبقة البيضاء

212
00:16:39,080 --> 00:16:40,330
!صنبور الزّهور

213
00:17:01,440 --> 00:17:08,030
،الضّوء الأبيض الّذي يُنير الحقيقة
!المُتحرّية النّجمة، كيور أركانا

214
00:17:13,280 --> 00:17:15,790
سأُريك إجابتي

215
00:17:25,250 --> 00:17:28,050
!المُتحرّية النّجمة كيور أركانا

216
00:17:29,470 --> 00:17:31,720
!أهلاً بعودتكِ يا أركانا

217
00:17:32,760 --> 00:17:34,970
عدتُ يا إكلير

218
00:17:38,350 --> 00:17:39,770
!هيّا! شادو

219
00:17:49,990 --> 00:17:51,400
!لمعان نجمة أركانا

220
00:18:14,260 --> 00:18:15,340
ليس بعد

221
00:18:15,890 --> 00:18:17,390
!ليس بعد يا شادو

222
00:18:28,690 --> 00:18:31,240
ما رأيك بذلك يا كيور أركانا؟

223
00:18:31,400 --> 00:18:35,240
قوّتكن أنتن الأربعة لا تستطيع إيقاف هذا

224
00:18:36,030 --> 00:18:40,120
ماذا؟ من قال بأنّنا أربعة؟

225
00:18:42,000 --> 00:18:44,370
!حان وقت تدخُّل الصّديقات الجنّيات

226
00:18:44,540 --> 00:18:45,540
!شوشوتان

227
00:18:46,130 --> 00:18:47,710
!حان الوقت، حان الوقت

228
00:18:47,880 --> 00:18:49,250
!بوتشيتان

229
00:18:49,800 --> 00:18:51,380
سيسير كُلُّ شيء على ما يُرام

230
00:18:51,880 --> 00:18:53,420
!لا حاجة للتنبُّؤ بذلك

231
00:18:53,880 --> 00:18:54,880
ماشوتان

232
00:18:58,100 --> 00:18:59,140
أجل

233
00:18:59,680 --> 00:19:00,810
!هيّا بنا

234
00:19:02,060 --> 00:19:02,980
!جميعكن

235
00:19:04,310 --> 00:19:05,770
!جوهرة ماكوتو

236
00:19:12,570 --> 00:19:13,570
،آنسر

237
00:19:15,150 --> 00:19:16,110
،ميستيك

238
00:19:17,700 --> 00:19:18,700
،إكلير

239
00:19:20,120 --> 00:19:20,990
!افتحي

240
00:19:24,160 --> 00:19:27,330
!هذا هو جوابنا

241
00:19:30,710 --> 00:19:32,420
!بريكيور

242
00:19:33,300 --> 00:19:35,470
!المُتحرّية النّجمة

243
00:19:44,640 --> 00:19:46,390
!إغلاق ملفّ القضيّة كيوريتّو

244
00:19:59,200 --> 00:20:00,910
!النّجمة المُتحرّية بريكيور

245
00:20:16,260 --> 00:20:17,340
تبّاً

246
00:20:17,840 --> 00:20:19,970
لم أتوقّع مُنعطف الأحداث هذا

247
00:20:20,340 --> 00:20:21,600
لا تقلق

248
00:20:22,300 --> 00:20:25,020
ظهرَ الملكُ العظيم كما هو مُتوقّع

249
00:20:25,640 --> 00:20:28,390
!مُجلّد الأسراب صحيح

250
00:20:29,150 --> 00:20:32,360
!سيدلّني توقّعٌ جديد على الطّريق

251
00:20:34,900 --> 00:20:36,490
!إنِّي أراه -
!ماذا؟ -

252
00:20:36,650 --> 00:20:42,830
في نهاية 1999، سيُصبح كُلّ شيء صفراً

253
00:20:42,990 --> 00:20:43,950
،وأيضاً

254
00:20:44,450 --> 00:20:48,410
حامل حجر الحقيقة سيصنع تاريخاً جديداً

255
00:20:48,580 --> 00:20:52,920
حامل حجر الحقيقة، جوهرة ماكوتو

256
00:20:53,090 --> 00:20:55,340
!هذا رهيب جدّاً وللغاية

257
00:20:55,500 --> 00:20:57,420
سأذهب وأسرق جوهرة ماكوتو

258
00:20:57,590 --> 00:21:01,260
!لكن لم يذكر مُجلّدُ الأسراب مكانَها بعد

259
00:21:01,430 --> 00:21:06,470
سآخذ جوهرةَ ماكوتو مُرسَلة بواسطة
جنّيّة الزّمان والمكان

260
00:21:07,890 --> 00:21:11,560
سأذهب وأسأل السّيّدة عن مكانها

261
00:21:13,190 --> 00:21:15,110
سأغيب لبعض الوقت

262
00:21:16,860 --> 00:21:18,400
حان وقت الجدّ

263
00:21:23,450 --> 00:21:26,450
أنا مُنهَكة. أريد بعض الآيس كريم

264
00:21:26,620 --> 00:21:29,120
ما رأيكِ بالذّهاب إلى تشوتشو
لتناول الآيس كريم؟

265
00:21:29,290 --> 00:21:30,040
!مُوافقة

266
00:21:30,210 --> 00:21:31,420
!نحن أيضاً

267
00:21:31,580 --> 00:21:33,000
!أنا أيضاً، أنا أيضاً

268
00:21:33,170 --> 00:21:35,960
...مهلاً! قبل أن نذهب

269
00:21:36,460 --> 00:21:40,300
من جديد، شكراً لكِ على الانضمام
!لنا يا لولوكا-سينباي

270
00:21:40,470 --> 00:21:41,720
يكفي لولوكا

271
00:21:41,880 --> 00:21:43,840
!لولوكا، لولوكا

272
00:21:44,010 --> 00:21:47,930
لا أستطيع! لديكِ الأقدميّة كبريكيور

273
00:21:48,100 --> 00:21:50,430
اسم ظريف مثل لولوتشي؟

274
00:21:50,600 --> 00:21:52,560
هذا مألوف زيادة عن اللّزوم

275
00:21:52,730 --> 00:21:55,150
في هذه الحالة، لو-تان؟

276
00:21:55,310 --> 00:21:56,150
!لون-لون

277
00:21:56,320 --> 00:21:57,150
!لولو

278
00:21:57,320 --> 00:21:58,070
!لولون

279
00:21:58,230 --> 00:21:59,280
!لالالون

280
00:22:01,700 --> 00:22:04,490
!أعتقد بأنّ لولوكا يُناسبها أكثر

281
00:22:06,030 --> 00:22:07,330
لا يهمّ

282
00:22:07,490 --> 00:22:09,660
لنذهب ونأكل الآيس كريم

283
00:22:10,450 --> 00:22:11,500
أجل

284
00:22:12,000 --> 00:22:13,080
هيّا بنا

285
00:23:48,090 --> 00:23:50,720
سُرِقَتْ جوهرة ماكوتو في باتيسري تشوتشو

286
00:23:50,890 --> 00:23:53,060
لا بُدّ أنّه ذلك الزّبون

287
00:23:53,220 --> 00:23:55,230
!لكن لا نعرف ما الّذي سُرِق

288
00:23:55,390 --> 00:23:57,600
إذاً كيف يمكننا البحث عنه؟

289
00:23:58,270 --> 00:24:02,190
!المُتحرّية النّجمة بريكيور
"لقد عُدت، وكالة التحرِّي كيوريتّو"

290
00:24:02,360 --> 00:24:04,530
!أغلِقَ ملفّ قضيّة اللّغز كيوريتّو