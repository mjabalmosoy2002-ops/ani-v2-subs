1
00:00:14,010 --> 00:00:17,060
!أضئ

2
00:00:17,230 --> 00:00:20,520
!امنحنا نوراً

3
00:00:21,060 --> 00:00:22,690
ماذا تفعلن؟

4
00:00:22,860 --> 00:00:24,570
دبّوس زينة نجم كيرارينغ

5
00:00:24,940 --> 00:00:27,280
نحاول جعله يتوهّج

6
00:00:27,440 --> 00:00:28,820
مُستحيل

7
00:00:28,990 --> 00:00:31,490
!يجب علينا مُحاولة كُلّ شيء

8
00:00:31,660 --> 00:00:32,450
…أجل

9
00:00:32,910 --> 00:00:34,080
هذا شهيّ

10
00:00:36,620 --> 00:00:43,250
لكن لماذا استجابَ لمشاعر كوريا ولولوكا؟

11
00:00:44,290 --> 00:00:45,340
…لا أدري

12
00:00:46,380 --> 00:00:49,340
!لأنّ لديهما قلب حقيقيّ

13
00:00:52,010 --> 00:00:53,680
…قلب حقيقيّ

14
00:00:55,220 --> 00:00:57,020
هذا لا يُفيد كثيراً

15
00:00:58,640 --> 00:01:01,190
!سيستجيب لكِ يوماً ما

16
00:01:01,350 --> 00:01:06,610
ألا تقولين دوماً "أنا لا أكذب أبداً!"؟

17
00:01:08,610 --> 00:01:09,950
!لا أكذب أبداً

18
00:01:11,110 --> 00:01:13,990
سبب معرفتكِ بهم

19
00:01:18,830 --> 00:01:23,290
!لدى وكالة التحرّي كيوريتّو أربعة أشخاص الآن

20
00:01:24,500 --> 00:01:27,750
!وشيء يتسكّع بشكل ع فويّ

21
00:01:27,920 --> 00:01:29,970
!إيريزا-سينسي! ركِّزي

22
00:01:30,840 --> 00:01:32,470
!اقترب موعدكِ النّهائيّ

23
00:01:32,630 --> 00:01:34,010
حـ-حسناً

24
00:01:42,890 --> 00:01:45,060
!تلك الدرّاجة

25
00:01:48,230 --> 00:01:49,610
!يا للهول

26
00:01:52,950 --> 00:01:54,410
!إنّها مافورو

27
00:01:54,570 --> 00:01:57,410
!دليل الفجر، المُتحرّية مافورو

28
00:01:57,580 --> 00:02:00,500
ماذا؟-
!أنا من أشدّ مُعجباتها-

29
00:02:09,880 --> 00:02:13,760
!لنبحث عن اللّمحة في القلب

30
00:02:13,930 --> 00:02:16,800
إلهام مُشرِق

31
00:02:17,140 --> 00:02:19,770
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

32
00:02:19,930 --> 00:02:22,480
إنّها تنادينا

33
00:02:22,640 --> 00:02:25,400
أين الحقيقة؟ ما الّذي ستكتشفه؟

34
00:02:25,560 --> 00:02:29,150
لغز تلو الآخر

35
00:02:29,820 --> 00:02:35,200
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

36
00:02:35,360 --> 00:02:40,450
كما الدّليل! شيء يلمع عبر الزّمن

37
00:02:40,700 --> 00:02:43,370
كيف؟ كيف؟ أهي خدعة؟

38
00:02:43,540 --> 00:02:46,330
لماذا؟ لماذا؟ سوف نواجهها

39
00:02:46,630 --> 00:02:51,920
لننظر ونشعر
نكتشف الأسرار

40
00:02:52,260 --> 00:02:57,760
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

41
00:02:58,140 --> 00:03:03,310
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

42
00:03:03,640 --> 00:03:09,110
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

43
00:03:09,270 --> 00:03:12,570
!لنمشِ في ذلك الطّريق معاً

44
00:03:12,730 --> 00:03:16,490
!لنبحث عن اللّمحة في القلب

45
00:03:16,660 --> 00:03:18,320
إلهام مُشرِق

46
00:03:18,490 --> 00:03:24,120
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

47
00:03:24,290 --> 00:03:29,210
ولادتنا ولقاؤنا لَهو لغز رائع

48
00:03:29,380 --> 00:03:32,840
!هيّا يا بريكيور المُتحرّيات النّجمات

49
00:03:39,220 --> 00:03:44,020
جواب ميكورو

50
00:03:49,940 --> 00:03:53,530
نادراً ما أراك بهذه الكآبة

51
00:03:54,280 --> 00:03:57,360
هل تتساءل عن تلك المصابيح أيضاً؟

52
00:03:59,910 --> 00:04:01,200
على ما أعتقد

53
00:04:02,030 --> 00:04:05,700
تلك هي المصابيح الّتي أضاءتها
…كيور إكلير وكيور أركانا

54
00:04:05,870 --> 00:04:09,750
قد يكونان من المصابيح الأربعة
من مُجلّد الأسراب

55
00:04:09,920 --> 00:04:13,670
أجل، قوّة دبّوس زينة نجم كيرارينغ

56
00:04:14,170 --> 00:04:19,630
أوسوتشي مُركّز جدّاً على نبوءة
عصر جديد يبدأ في 2000

57
00:04:20,300 --> 00:04:24,470
لم يتردّد بشأن دبّوس زينة نجم
كيرارينغ يوماً

58
00:04:25,020 --> 00:04:27,180
تلك القوّة خطيرة جدّاً

59
00:04:27,350 --> 00:04:28,980
دع الأمر لي

60
00:04:29,770 --> 00:04:32,650
سأخرج لسرقة جوهرة ماكوتو

61
00:04:33,820 --> 00:04:36,440
ستكون تلك النّهاية العظيمة، يا عزيزي

62
00:04:43,410 --> 00:04:46,500
تفضّلي-
!شكراً جزيلاً لكِ-

63
00:04:46,660 --> 00:04:48,250
هل يمكنكِ توقيع هذه لأجلي؟

64
00:04:48,830 --> 00:04:50,580
!أنا أيضاً من فضلكِ

65
00:04:51,920 --> 00:04:55,840
،عندما كنتُ أدرس في باريس
!سمعتُ بعملك

66
00:04:56,000 --> 00:05:00,930
،لم أتصوّر أبداً أن تأتي دليل الفجر
!المُتحرّية مافورو إلى متجري

67
00:05:01,090 --> 00:05:03,930
!مافورو شهيرة جدّاً

68
00:05:04,100 --> 00:05:06,180
لا سيّما في أوروبّا

69
00:05:07,560 --> 00:05:10,480
!شكراً جزيلاً لك

70
00:05:11,100 --> 00:05:13,690
!سمعتُ بأنّك تساعد كوريا كثيراً

71
00:05:13,860 --> 00:05:15,520
!الأمر ليس كذلك

72
00:05:15,690 --> 00:05:18,740
!تشوتشو ينجح بفضلها فقط

73
00:05:19,240 --> 00:05:20,400
!يا إلهي

74
00:05:20,900 --> 00:05:21,860
…المعذرة

75
00:05:22,320 --> 00:05:23,780
هل يمكنني التقاط صورة؟

76
00:05:24,280 --> 00:05:27,870
آسفة، لكن لا أسمح بالصّور

77
00:05:28,250 --> 00:05:31,920
من الصّعب التّحقيق وتعقُّب شخص
إذا كان وجهي معروفاً

78
00:05:32,080 --> 00:05:34,580
لذا أحاول ألّا أكشفه

79
00:05:36,290 --> 00:05:39,340
!إيريزا، من المُذهل أنّكِ ميّزتِها

80
00:05:39,510 --> 00:05:43,050
هذا لأنّني مُعجبة بالمُتحرّية مافورو
!أكثر من أيّ شخص آخر

81
00:05:43,220 --> 00:05:46,600
لهذا السّبب أصبحتُ مُتحرّية في وكالة
!التحرّي كيوريتّو

82
00:05:46,760 --> 00:05:47,720
ماذا؟

83
00:05:47,890 --> 00:05:52,310
حمّسَني توقيعكِ! سأعمل بجدّ
!في التحرّي والكتابة

84
00:05:52,480 --> 00:05:55,270
!سوف أنجزها-
!عودة إلى العمل-

85
00:05:55,440 --> 00:05:59,070
إيريزا، هل يمكنكِ التقاط صورة لي بقبّعتي؟

86
00:06:01,150 --> 00:06:05,910
انضمّتْ تلك الفتاة لوكالة التحرّي
كيوريتّو؟ ما الّذي يجري؟

87
00:06:06,070 --> 00:06:07,620
…فـ-في الواقع

88
00:06:07,780 --> 00:06:14,000
حلّتْ قضيّة، لذا ارتأيتُ بأنّها
نجحتْ في الاختبار

89
00:06:16,040 --> 00:06:19,340
!لا يمكنك أن تختبرهن هكذا فحسب-
!أنا آسف-

90
00:06:19,500 --> 00:06:22,300
لا سبيل لتقويمك حقّاً

91
00:06:35,770 --> 00:06:37,560
!مرحباً-
!ما-

92
00:06:37,980 --> 00:06:39,440
المُديرة مافورو؟

93
00:06:39,610 --> 00:06:41,150
هل أموركِ بخير؟

94
00:06:41,320 --> 00:06:42,990
ماشوتان، عدنا إلى المنزل

95
00:06:43,150 --> 00:06:45,530
سأقدّم الكعكة الّتي تلقّيناها

96
00:06:45,700 --> 00:06:48,330
أهلاً بعودتكن. شكراً

97
00:06:48,950 --> 00:06:50,580
لماذا أنتِ هنا؟

98
00:06:50,740 --> 00:06:55,080
أخبرني جيت بأنّ دبّوس زينة
نجم كيرارينغ قد استجاب

99
00:06:55,250 --> 00:06:57,500
ماذا تفعلين هنا بمفردكِ؟

100
00:06:57,670 --> 00:07:01,710
أبحث عن جوهرة ماكوتو لأنّني أدركتُ شيئاً

101
00:07:02,130 --> 00:07:05,970
وردَ هذا كُلُّه في مُجلّد الأسراب
الّذي ألّفَه أسلافي

102
00:07:06,130 --> 00:07:09,180
!تبصيري سيقودني إليها حتماً

103
00:07:09,350 --> 00:07:11,890
!هكذا إذاً! هذا جديرٌ بالإعجاب

104
00:07:12,060 --> 00:07:13,560
ماشوتان، أحسنتِ صنعاً

105
00:07:13,730 --> 00:07:18,150
لولوكا، فقد أضأتِ دبّوس زينة نجم
!كيرارينغ في نهاية المطاف

106
00:07:18,310 --> 00:07:19,480
!أجل

107
00:07:19,650 --> 00:07:24,610
المُديرة مافورو، عليكِ أن تلقي نظرة
!إلى دبّوس زينة نجم كيرارينغ

108
00:07:24,780 --> 00:07:26,280
بوتشيتان، هل يمكنك؟

109
00:07:31,580 --> 00:07:33,790
!بالفعل، نقطتان مُضيئتان

110
00:07:33,950 --> 00:07:36,370
!أنتما مُذهلتان

111
00:07:38,540 --> 00:07:41,500
!هذا مُدهش! مُبهر

112
00:07:53,810 --> 00:07:54,850
آنّا

113
00:07:56,270 --> 00:07:57,350
ما الخطب؟

114
00:07:57,980 --> 00:07:58,770
ماذا؟

115
00:07:59,940 --> 00:08:01,150
لا شيء

116
00:08:02,900 --> 00:08:04,400
لا تخفي شيئاً

117
00:08:07,610 --> 00:08:08,740
…أُخفي

118
00:08:10,820 --> 00:08:12,740
شيئاً؟

119
00:08:14,040 --> 00:08:16,000
هل الأمر مُرتبط بمافورو؟

120
00:08:16,160 --> 00:08:17,210
ماذا؟

121
00:08:17,370 --> 00:08:21,920
عندما تكونين مع مافورو، تتصرّفين بغرابة

122
00:08:23,000 --> 00:08:28,880
حـ-حقّاً؟ أظنّني أتوتّر أمام مُديرة وكالة
التحرّي كيوريتّو

123
00:08:29,430 --> 00:08:31,090
لكن هذا ليس كُلّ شيء، صحيح؟

124
00:08:31,260 --> 00:08:32,140
!ماذا؟

125
00:08:32,680 --> 00:08:36,060
كنتُ معكِ لأكثر من ستّة أشهر

126
00:08:36,220 --> 00:08:37,270
هذا واضح

127
00:08:44,190 --> 00:08:46,740
!أخبريني إذا كان هناك ما يُزعجكِ

128
00:08:49,950 --> 00:08:52,370
تقولين بأنّكِ تعرفينني

129
00:08:53,450 --> 00:08:55,740
لكنّكِ لا تعرفين شيئاً

130
00:08:58,790 --> 00:09:00,790
ماذا تعرفين عنّي؟

131
00:09:01,210 --> 00:09:02,960
ماذا عن عائلتي؟

132
00:09:03,380 --> 00:09:06,420
هل تعرفين سبب وجودي في لندن؟

133
00:09:08,300 --> 00:09:13,340
ظننتُ بأنّكِ لم تتكلّمي عن عائلتكِ
احتراماً لي؟

134
00:09:13,850 --> 00:09:18,220
،لأنّني إذا بدأتُ أفكِّر في أمّي
فسيتملّكني الحزن

135
00:09:19,730 --> 00:09:21,770
بالطّبع، هذا أحد الأسباب أيضاً

136
00:09:22,690 --> 00:09:24,310
لكن هذا ليس كُلّ شيء

137
00:09:24,480 --> 00:09:25,320
ماذا؟

138
00:09:26,860 --> 00:09:27,650
…أنا

139
00:09:36,700 --> 00:09:37,990
غروب الشّمس

140
00:09:38,750 --> 00:09:40,580
حديقة فارغة

141
00:09:41,460 --> 00:09:43,790
!يا أطفال، لا تجرّبوا هذا في المنزل

142
00:09:44,290 --> 00:09:45,340
!بئساً

143
00:09:46,590 --> 00:09:48,170
لأنّ هذا ما يحدث

144
00:09:49,010 --> 00:09:49,920
يا إلهي

145
00:09:50,090 --> 00:09:54,090
من كان يتوقّع أن تتواجد جوهرة
ماكوتو في زحلوقة؟

146
00:09:54,260 --> 00:09:56,180
لكن لن أسرقها بعد

147
00:09:56,680 --> 00:09:59,720
سأريكم كيف أسرقها برشاقة

148
00:09:59,890 --> 00:10:02,270
!هكذا تفعلها نقابة اللّصوص الشّبح

149
00:10:02,980 --> 00:10:05,690
إذا سرقتُها الآن، فهذا غير رشيق

150
00:10:05,860 --> 00:10:10,150
سأفعلها غداً في الظّهيرة حيث
يوجد كثير من النّاس

151
00:10:10,650 --> 00:10:14,280
هذا ليس وقت الهوَس بشأن التّفاصيل

152
00:10:14,740 --> 00:10:16,530
أنا لا أكره ذلك

153
00:10:17,950 --> 00:10:21,410
التنكُّر كأمّ تحمل طفلاً صغيراً لسرقتها؟

154
00:10:21,960 --> 00:10:24,670
مهلاً، لا أستطيع فعل هذا
دون مُمثّل طفل

155
00:10:26,790 --> 00:10:28,880
وكيف أحملها؟

156
00:10:29,050 --> 00:10:32,470
أتنكّر كعامل صيانة وأحضر شاحنة؟

157
00:10:33,090 --> 00:10:36,640
!بئساً! لا أملك رخصة-
!هنا-

158
00:10:36,800 --> 00:10:37,890
!بريكيور

159
00:10:38,050 --> 00:10:39,140
!نيجي

160
00:10:39,310 --> 00:10:41,140
!كيف؟! لم أسرقها بعد

161
00:10:41,310 --> 00:10:45,770
إنّه هنا، ما يعني بأنّ تبصير ماشوتان
كان صائباً

162
00:10:45,940 --> 00:10:47,310
!كان كذلك بالطّبع

163
00:10:47,480 --> 00:10:50,610
!لكن أنا مُتعبة لدرجة لا أستطيع الحركة

164
00:10:50,780 --> 00:10:54,110
!لا بُدّ أنّ جوهرة ماكوتو في تلك الزّحلوقة

165
00:10:54,820 --> 00:10:58,320
كنتُ أحضِّر خطّةً لجريمتي الرّشيقة للتو

166
00:10:58,950 --> 00:11:00,080
حسناً

167
00:11:00,240 --> 00:11:03,120
سأقدّم عرضاً بهزيمتكن بدلاً من ذلك

168
00:11:03,290 --> 00:11:05,710
سيُرضيك هذا، صحيح؟

169
00:11:09,290 --> 00:11:11,460
!أيّتها الأكاذيب، طوِّقي

170
00:11:12,050 --> 00:11:14,300
!تعال، هانّيندا

171
00:11:20,720 --> 00:11:23,730
!هانّيندا

172
00:11:26,440 --> 00:11:27,440
!ميكورو

173
00:11:29,360 --> 00:11:30,190
!حسناً

174
00:11:30,360 --> 00:11:31,690
!افتحي

175
00:11:35,950 --> 00:11:37,660
!افتحي! افتحي

176
00:11:38,240 --> 00:11:39,370
لماذا؟

177
00:11:41,120 --> 00:11:45,250
!افتحي! افتحي

178
00:11:46,040 --> 00:11:49,500
!هانّيندا

179
00:11:59,590 --> 00:12:01,510
!هانّيندا

180
00:12:10,100 --> 00:12:11,020
هل أنتِ بخير؟

181
00:12:11,190 --> 00:12:11,980
!أجل

182
00:12:12,480 --> 00:12:14,150
!دعي الأمر لنا

183
00:12:15,110 --> 00:12:15,990
كوريا

184
00:12:16,150 --> 00:12:16,950
أجل

185
00:12:17,110 --> 00:12:18,240
!افتحي

186
00:12:26,870 --> 00:12:28,830
!عصا أركانا المُنيرة

187
00:12:32,750 --> 00:12:34,960
!بريكيور! حان وقت الاستيقاظ

188
00:12:38,050 --> 00:12:39,180
،المعي

189
00:12:39,340 --> 00:12:40,470
أيّتها الزّنبقة البيضاء

190
00:12:49,230 --> 00:12:50,520
!صنبور الزّهور

191
00:13:11,620 --> 00:13:18,300
،الضّوء الأبيض الّذي يُنير الحقيقة
!المُتحرّية النّجمة كيور أركانا

192
00:13:24,010 --> 00:13:24,970
!افتح

193
00:13:30,940 --> 00:13:33,100
عطر لولب الزّنبق

194
00:13:35,860 --> 00:13:38,360
!بريكيور! حان وقت الاستيقاظ

195
00:13:38,860 --> 00:13:40,280
الدّوران الورديّ

196
00:13:56,340 --> 00:13:57,420
!تفتّحي

197
00:14:20,280 --> 00:14:21,440
!استيقظي

198
00:14:21,820 --> 00:14:27,740
عطر الحقيقة الدّاخليّة، المُتحرّية
!النّجمة كيور إكلير

199
00:14:32,750 --> 00:14:35,120
سأُريك إجابتي

200
00:14:35,630 --> 00:14:37,250
!هانّيندا

201
00:14:43,300 --> 00:14:44,380
!هان

202
00:14:45,220 --> 00:14:47,680
!ني-ني-ني-نين، دا

203
00:14:49,560 --> 00:14:51,850
!افتحي! افتحي

204
00:14:52,480 --> 00:14:53,430
لكن لماذا؟

205
00:14:54,980 --> 00:14:56,900
!ميكورو، حاولي ثانية

206
00:14:59,730 --> 00:15:00,650
ميكورو؟

207
00:15:00,820 --> 00:15:02,530
!هان

208
00:15:11,700 --> 00:15:13,330
!وهم إكلير

209
00:15:19,630 --> 00:15:23,090
!هان! ني-ني-ني-ني-نين! دا

210
00:15:23,550 --> 00:15:28,550
!دا! هان! هان؟ هان؟ دا

211
00:15:37,270 --> 00:15:38,770
!نجم أركانا اللّامع

212
00:15:44,990 --> 00:15:47,240
!ها؟ هان

213
00:15:48,570 --> 00:15:49,620
ميكورو؟

214
00:15:52,080 --> 00:15:53,370
هذه غلطتي

215
00:15:53,540 --> 00:15:54,330
ماذا؟

216
00:15:56,830 --> 00:15:59,580
لستُ بريكيور

217
00:16:00,080 --> 00:16:02,550
لستُ مُتحرّية نجمة حقيقيّة

218
00:16:02,710 --> 00:16:04,840
!لستُ مُؤهَّلة

219
00:16:06,970 --> 00:16:08,300
…تقصدين

220
00:16:10,510 --> 00:16:12,180
!وهذا ليس كلّ شيء

221
00:16:13,260 --> 00:16:16,180
هل هذا يخصّ ما حاولتِ قوله من قبل؟

222
00:16:19,230 --> 00:16:20,650
مهلاً، مهلاً

223
00:16:21,150 --> 00:16:23,270
عدم القدرة على التحوُّل

224
00:16:24,780 --> 00:16:27,610
يُذكّرني هذا بأوّل مرّة التقيتُ فيكِ به

225
00:16:27,780 --> 00:16:30,870
هانّيندا

226
00:16:31,370 --> 00:16:33,450
قلتُها آنذاك أيضاً

227
00:16:34,740 --> 00:16:38,460
أنتِ مُتحرّية مُزيّفة، يا عزيزتي

228
00:16:40,290 --> 00:16:43,340
،إنّه يهزّ نفوس البريكيور

229
00:16:43,500 --> 00:16:46,800
ليمنع المصابيح الأربعة من الإضاءة

230
00:16:46,960 --> 00:16:49,050
لا بأس بك يا نيجي

231
00:16:51,390 --> 00:16:53,680
لا يمكنكِ التحوُّل إلى بريكيور؟

232
00:16:53,850 --> 00:16:55,890
هذا مُضحكٌ للغاية

233
00:16:57,810 --> 00:17:00,310
!هان! نين! نين

234
00:17:07,990 --> 00:17:11,610
صديقتكما تُعانيان بسببكما

235
00:17:11,780 --> 00:17:13,370
أيّتها المُتحرّيتان النّجمتان

236
00:17:13,530 --> 00:17:14,580
لا

237
00:17:15,530 --> 00:17:18,290
!المُتحرّيتان النّجمتان سابقاً، على ما أعتقد

238
00:17:21,960 --> 00:17:23,750
!إنّهما مُتحرّيتان نجمتان

239
00:17:23,920 --> 00:17:24,880
!هان

240
00:17:26,670 --> 00:17:29,420
!بفضلهما، أنا هنا الآن

241
00:17:30,220 --> 00:17:32,680
!لقد عثرتا عليّ

242
00:17:33,260 --> 00:17:35,640
!أنا، البريكيور

243
00:17:35,810 --> 00:17:40,890
أجل! ساعدتا كوريا لتعود إكلير ثانية

244
00:17:41,060 --> 00:17:43,440
مُتحرّية وحلوانيّة

245
00:17:44,020 --> 00:17:47,730
!وجدتُ طريقي الحقيقيّ بفضلهما

246
00:17:49,530 --> 00:17:50,530
!ميكورو

247
00:18:04,630 --> 00:18:05,840
مهلاً، مهلاً

248
00:18:06,000 --> 00:18:09,710
!يبدو أنّ كلماتكما لم تؤثّر إطلاقاً، يا عزيزتي

249
00:18:09,880 --> 00:18:11,420
!هانّيندا

250
00:18:11,590 --> 00:18:14,430
!هان! نين! دا

251
00:18:23,230 --> 00:18:24,730
خلف الهانّيندا؟

252
00:18:25,230 --> 00:18:28,230
إذا وصلتُ إلى خلفه، فلن تُصيبني الرّياح

253
00:18:28,400 --> 00:18:30,690
!هان

254
00:18:30,860 --> 00:18:36,660
الأمر ليس بتلك البساطة. بهذا الأنف
!الطّويل، فلا نقاط عمياء له، يا عزيزي

255
00:18:37,740 --> 00:18:42,500
!هان

256
00:18:43,330 --> 00:18:45,460
!هانّيندا

257
00:18:45,620 --> 00:18:47,670
!هذا هو أركاني الّذي أعرفه

258
00:18:47,840 --> 00:18:48,750
!إكلير

259
00:18:48,920 --> 00:18:51,800
!أجل! حان دوري الآن

260
00:18:54,380 --> 00:18:55,300
!افتحي

261
00:18:58,550 --> 00:19:00,310
!عدسة مرآة بري-كيت

262
00:19:00,890 --> 00:19:01,720
!شوشوتان

263
00:19:04,600 --> 00:19:05,730
!جوهرة ماكوتو

264
00:19:12,360 --> 00:19:14,320
!كيور إكلير ستُغلق هذه القضيّة

265
00:19:21,830 --> 00:19:26,870
أبسط جناحَي بأناقة وأحلّ اللّغز

266
00:19:27,920 --> 00:19:29,920
هذا هو جوابي

267
00:19:34,090 --> 00:19:37,680
!بريكيور! تحليق بلا حدود

268
00:19:52,480 --> 00:19:53,940
!إغلاق ملفّ القضيّة كيوريتو

269
00:19:54,400 --> 00:19:59,910
…هان! نين… دا

270
00:20:07,960 --> 00:20:10,790
!بوتشي بوتشي كيور كيور

271
00:20:20,720 --> 00:20:24,470
خسرتُ المعركة، لكن حقّقتُ بعض المكاسب

272
00:20:25,640 --> 00:20:30,310
يبدو أنّ المصابيح الأربعة لا تتعلّق
بدبّوس زينة نجم كيرارينغ في النّهاية

273
00:20:31,730 --> 00:20:32,820
،أقصد

274
00:20:33,610 --> 00:20:36,490
لا يمكنهما أن يُصبحا بريكيور حتّى

275
00:20:40,030 --> 00:20:41,410
…ربّما

276
00:20:42,740 --> 00:20:47,370
الأمر يتعلّق بأنوار أعضاء نقابة
اللّصوص الشّبح الأربعة؟

277
00:20:48,620 --> 00:20:50,460
هذا غير ممكن

278
00:20:51,460 --> 00:20:52,750
،على أيّ حال

279
00:20:52,920 --> 00:20:57,380
من المؤكّد أنّه ليس ضوءكما، يا من
!تعجزان حتّى عن التحوّل إلى بريكيور

280
00:20:57,840 --> 00:20:59,340
!وداعاً، عزيزتي

281
00:21:02,720 --> 00:21:03,720
ميكورو

282
00:21:05,100 --> 00:21:06,270
أنا آسفة

283
00:21:07,890 --> 00:21:10,770
!جميعنا نمرّ بأيّام سيّئة. لا داعي للقلق

284
00:21:10,940 --> 00:21:12,440
!بل هناك داعٍ

285
00:21:12,560 --> 00:21:13,520
ماذا؟

286
00:21:15,650 --> 00:21:16,650
ميكورو؟

287
00:21:21,570 --> 00:21:22,950
ميكورو، ما الأمر؟

288
00:21:24,330 --> 00:21:25,450
أنا آسفة

289
00:21:26,490 --> 00:21:27,500
…أنا

290
00:21:29,210 --> 00:21:31,040
كنتُ أكذب

291
00:21:32,460 --> 00:21:33,420
ميكورو؟

292
00:21:34,880 --> 00:21:36,670
!المُديرة مافورو، وجدتُهن

293
00:21:38,050 --> 00:21:41,550
،اختفى الجميع في آن واحد
!وتساءلتُ عن السّبب

294
00:21:42,760 --> 00:21:44,890
هل أتى اللّصوص الشّبح؟

295
00:21:45,350 --> 00:21:46,220
أجل

296
00:21:53,980 --> 00:21:55,360
ماذا حدث؟

297
00:22:00,780 --> 00:22:01,610
…جـ

298
00:22:03,280 --> 00:22:04,780
!جدّتي

299
00:22:11,370 --> 00:22:12,540
جدّتي؟

300
00:23:47,380 --> 00:23:49,260
قالت ميكورو بأنّها كانت تكذب

301
00:23:49,430 --> 00:23:51,560
جميعنا لدينا أسرار لا يمكننا ذكرها

302
00:23:51,720 --> 00:23:53,890
لنُؤمن ببريق ميكورو

303
00:23:54,060 --> 00:23:57,190
آنّا، هلّا استمعتِ إلى حقيقتي؟

304
00:23:58,060 --> 00:24:01,900
!المُتحرِّية النّجمة بريكيور
"!دبّوس زينة نجم كيرارينغ اللّامع"

305
00:24:02,070 --> 00:24:04,530
!أغلِقَ ملفّ قضيّة اللّغز كيوريتّو