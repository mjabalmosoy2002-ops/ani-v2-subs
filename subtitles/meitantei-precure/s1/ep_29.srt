1
00:00:12,430 --> 00:00:15,350
من كان يتوقّع بأن تكون سرقتها
بهذه السّهولة؟

2
00:00:15,520 --> 00:00:18,690
لنُسرع ونُقدّمها للمايسترو أوسونوار

3
00:00:18,850 --> 00:00:20,600
لا-
ماذا؟-

4
00:00:21,150 --> 00:00:23,070
يبدأ العرض الحقيقيّ الآن

5
00:00:23,230 --> 00:00:24,110
ماذا؟

6
00:00:26,990 --> 00:00:28,070
!ها هما

7
00:00:28,240 --> 00:00:29,320
!البريكيور

8
00:00:29,780 --> 00:00:31,320
كوريا هووا

9
00:00:31,490 --> 00:00:33,830
دوركِ رئيسيّ اليوم

10
00:00:35,330 --> 00:00:37,540
غويمون، استعدّ لمتاهة الخِداع

11
00:00:37,700 --> 00:00:38,540
ماذا؟

12
00:00:39,250 --> 00:00:41,500
هذا لأجل أوسوتشي أيضاً

13
00:00:42,000 --> 00:00:45,380
!بئس الأمر. تعالي يا متاهة الخِداع

14
00:00:47,170 --> 00:00:49,470
!غويمون مع ديتشي آغين

15
00:00:55,600 --> 00:00:59,100
لنرَ سردَكُن القصصيّ

16
00:00:59,270 --> 00:00:59,980
!مهلاً

17
00:01:00,480 --> 00:01:01,770
ما الّذي يجري؟

18
00:01:04,020 --> 00:01:07,730
!...هذا-
!وكالة التحرّي في لندن-

19
00:01:07,900 --> 00:01:09,030
!ماذا؟

20
00:01:13,910 --> 00:01:17,790
!لنبحث عن اللّمحة في القلب

21
00:01:17,950 --> 00:01:20,830
إلهام مُشرِق

22
00:01:21,160 --> 00:01:23,790
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

23
00:01:23,960 --> 00:01:26,500
إنّها تنادينا

24
00:01:26,670 --> 00:01:29,420
أين الحقيقة؟ ما الّذي ستكتشفه؟

25
00:01:29,590 --> 00:01:33,180
لغز تلو الآخر

26
00:01:33,840 --> 00:01:39,220
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

27
00:01:39,390 --> 00:01:44,480
كما الدّليل! شيء يلمع عبر الزّمن

28
00:01:44,730 --> 00:01:47,400
كيف؟ كيف؟ أهي خدعة؟

29
00:01:47,570 --> 00:01:50,360
لماذا؟ لماذا؟ سوف نواجهها

30
00:01:50,650 --> 00:01:55,950
لننظر ونشعر
نكتشف الأسرار

31
00:01:56,280 --> 00:02:01,790
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

32
00:02:02,160 --> 00:02:07,340
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

33
00:02:07,670 --> 00:02:13,130
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

34
00:02:13,300 --> 00:02:16,600
!لنمشِ في ذلك الطّريق معاً

35
00:02:16,760 --> 00:02:20,520
!لنبحث عن اللّمحة في القلب

36
00:02:20,680 --> 00:02:22,350
إلهام مُشرِق

37
00:02:22,520 --> 00:02:28,150
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

38
00:02:28,320 --> 00:02:33,240
ولادتنا ولقاؤنا لَهو لغز رائع

39
00:02:33,400 --> 00:02:36,870
!هيّا يا بريكيور المُتحرّيات النّجمات

40
00:02:43,460 --> 00:02:48,040
ماضي الثُّنائيّ

41
00:02:52,550 --> 00:02:53,920
ماذا؟ لكن لماذا؟

42
00:02:54,090 --> 00:02:56,510
هذا هو عالم الذّكريات

43
00:02:56,680 --> 00:02:59,550
لا يمكنكن لمس شيء

44
00:03:00,060 --> 00:03:06,060
استعرتُ قوّةَ متاهة الخِداع لإعادة
تمثيل ماضي كوريا هووا

45
00:03:07,190 --> 00:03:10,730
أرى بأنّ قِواكِ مُبهرة

46
00:03:13,900 --> 00:03:17,160
هذه هي بطلتنا الرّئيسيّة

47
00:03:17,320 --> 00:03:19,570
لحظة، هل تلك الفتاة...؟

48
00:03:19,740 --> 00:03:20,910
!كوريا

49
00:03:24,290 --> 00:03:25,580
!وهذه لولوكا

50
00:03:26,040 --> 00:03:27,670
كان هذا قبل ثلاث سنوات

51
00:03:28,250 --> 00:03:30,500
!أنا من اكتشف هذه الفتاة

52
00:03:31,460 --> 00:03:32,960
!وأنا اكتشفتُها هي

53
00:03:37,630 --> 00:03:39,850
كوريا، عرِّفي عن نفسكِ

54
00:03:41,680 --> 00:03:43,010
أنا كوريا هووا

55
00:03:46,520 --> 00:03:48,730
لولوكا... موريا

56
00:03:49,520 --> 00:03:50,650
!سررتُ بلقائكِ

57
00:03:55,400 --> 00:03:57,860
إنّه اليوم الّذي التقيتُما فيه أوّل مرّة

58
00:04:02,240 --> 00:04:03,200
!افتحي

59
00:04:05,660 --> 00:04:07,620
!عدسة مرآة بري-كيت

60
00:04:08,370 --> 00:04:10,420
!لنبحث عن دليل للهرب

61
00:04:10,580 --> 00:04:11,540
!حسناً

62
00:04:22,300 --> 00:04:26,100
يا للرّوعة! أيّ شخص يزورها يُفتَن بواسطتها

63
00:04:26,270 --> 00:04:28,060
!يا له من عطر أخّاذ

64
00:04:31,230 --> 00:04:32,770
!مُذهل

65
00:04:32,940 --> 00:04:35,230
!عطر؟ رائع-
ماذا؟-

66
00:04:36,860 --> 00:04:38,240
!المُديرة مافورو

67
00:04:38,400 --> 00:04:42,120
مافورو، المُتحرّية مافورو، دليل الفجر؟

68
00:04:43,450 --> 00:04:48,830
المُتحرّية الّتي حلّتْ قضيّة التّاج المفقود
الّتي هزّتْ إنجلترا؟ حقّاً؟

69
00:04:49,000 --> 00:04:54,290
مُتحرّية شهيرة عالميّاً هي مُديرة
وكالة التحرِّي كيوريتّو؟

70
00:04:54,880 --> 00:04:56,760
أبقي هذا سرّاً

71
00:04:57,090 --> 00:04:59,510
لا بُدّ أنّها مُتحرّية مُذهلة

72
00:05:00,930 --> 00:05:01,930
ماذا؟

73
00:05:04,720 --> 00:05:06,560
تقدّم الزّمنُ للأمام؟

74
00:05:06,930 --> 00:05:09,480
لا بُدّ أنّ هذا هو الفصل الثّاني

75
00:05:09,640 --> 00:05:15,440
.الجنّيات وأنا من نعمل هنا فقط
تعاوننا يجعل الأمور تسير بسلاسة

76
00:05:17,190 --> 00:05:17,900
ماذا؟

77
00:05:18,070 --> 00:05:23,030
عادةً لا تُفتَح لأحد سوايّ. هذا غير مألوف

78
00:05:23,950 --> 00:05:25,370
يا لها من زنابق جميلة

79
00:05:25,530 --> 00:05:27,700
تُدعى لولب الزّنبق

80
00:05:27,870 --> 00:05:31,000
نشأت من الرّوابط بين الجنّيات والبشر

81
00:05:31,160 --> 00:05:35,340
إنّها ملِكة الزّنبق. أو بالأحرى، الملِكة

82
00:05:39,130 --> 00:05:41,880
رُبّما هذا هو توجيه القدَر

83
00:05:51,180 --> 00:05:52,100
ما هي هذه؟

84
00:05:52,270 --> 00:05:56,520
جوهرة ماكوتو. قلوب البشر الّتي
آمنت بالجنّيات

85
00:05:56,690 --> 00:05:58,190
قلوب البشر؟

86
00:05:58,360 --> 00:06:00,940
آمنت؟ في الماضي؟

87
00:06:01,110 --> 00:06:02,780
أنتِ ذكيّة

88
00:06:04,320 --> 00:06:05,990
ها نحن من جديد

89
00:06:07,280 --> 00:06:11,450
منذ زمن بعيد، كان البشر والجنّيات يتعايشون معاً

90
00:06:11,620 --> 00:06:14,370
!كانوا الشّركاء الأعظم

91
00:06:15,250 --> 00:06:16,880
،لكن بعدها

92
00:06:17,040 --> 00:06:18,750
،مع مضيّ الوقت

93
00:06:18,920 --> 00:06:22,380
لم يعُد البشر يؤمنون ب الجنّيات

94
00:06:23,340 --> 00:06:28,260
قلوب الحقيقة الّتي آمنت بالجنّيات
غادرت البشر

95
00:06:28,810 --> 00:06:32,980
تكتّلَتْ معاً لتُشكِّل جوهرة ماكوتو

96
00:06:34,390 --> 00:06:37,610
قوّة الإيمان رهيبة حقّاً

97
00:06:37,770 --> 00:06:40,610
يمكنها حتّى تحويل الأكاذيب إلى حقيقة

98
00:06:41,190 --> 00:06:44,900
الأشخاص الّذين يستهدفونها هم
نقابة اللّصوص الشّبح

99
00:06:46,110 --> 00:06:50,830
لهذا السّبب أتلاعب بالزّمان والمكان لحمايتها

100
00:06:52,750 --> 00:06:57,380
تريد نقابة اللّصوص الشّبح تطويق
العالم بأكاذيب

101
00:06:57,880 --> 00:06:59,540
ليصبحوا ملِكاً عظيماً

102
00:07:00,050 --> 00:07:02,710
يجب علينا إيقافهم

103
00:07:02,880 --> 00:07:04,220
لكن كيف؟

104
00:07:04,380 --> 00:07:06,430
!كمُتحرّية نجمة بريكيور

105
00:07:06,590 --> 00:07:07,840
مُتحرّية نجمة؟

106
00:07:08,010 --> 00:07:08,800
بريكيور؟

107
00:07:08,970 --> 00:07:13,020
.إنّها تُنقذ النّاس. ويُعجَب بها الجميع
!إنّها أملُنا

108
00:07:13,770 --> 00:07:15,980
الأطفال الّذين ليس لديهم
مَن يعتمدون عليه

109
00:07:16,140 --> 00:07:19,900
النّاس الّذين في ورطة. النّاس
الّذين يحتاجون مُساعدة

110
00:07:20,070 --> 00:07:22,780
!سيرسمون البسمةَ في وجه الجميع

111
00:07:24,070 --> 00:07:25,740
أتريدان تجربة ذلك؟

112
00:07:26,700 --> 00:07:27,820
!أجل

113
00:07:28,870 --> 00:07:30,870
!سأكون مُتحرّية نجمة بريكيور

114
00:07:31,030 --> 00:07:33,620
!سأرسم البسمةَ في وجه الجميع

115
00:07:37,420 --> 00:07:38,500
أنا أيضاً

116
00:07:38,670 --> 00:07:39,960
!مُذهل

117
00:07:40,130 --> 00:07:43,670
الآن بعد أن حُسِم الأمر، الخطوة
!التّالية هي اختبار المُتحرّية

118
00:07:46,880 --> 00:07:48,550
اختفت مزهريّتكم؟

119
00:07:49,260 --> 00:07:53,060
من كان في القصر عندما لاحظتُم الجريمة؟

120
00:07:53,970 --> 00:07:55,680
لم يكن هناك سِوانا

121
00:07:55,850 --> 00:07:59,600
لم يدخل أحدٌ أو يخرج من القصر
قبل أو بعد وقوع الجريمة

122
00:08:01,190 --> 00:08:02,820
لا يمكن فتح النّوافذ

123
00:08:02,980 --> 00:08:04,900
لم يدخل أحدٌ من الخارج

124
00:08:05,070 --> 00:08:06,400
المدخنة؟

125
00:08:06,570 --> 00:08:11,030
إنّها مزهريّة كبيرة، لذا من المُستحيل
تمريرها عبر المدخنة

126
00:08:19,750 --> 00:08:22,000
هل اكتشفتِ شيئاً؟

127
00:08:25,300 --> 00:08:29,300
أجل. أعلم أين اختفت المزهريّة

128
00:08:34,930 --> 00:08:37,350
كانت قد كُسِرَتْ، وأخفيتْ هنا

129
00:08:40,060 --> 00:08:44,730
سارعتِ لإخفائها، فاتّسخت يداكِ
برماد الموقد

130
00:08:45,690 --> 00:08:48,860
لوشي، هل تأذّيتِ؟

131
00:08:54,870 --> 00:08:59,210
نجحتِ في اختبار التحرّي من أوّل مُحاولة
لكِ. هذه هي لولوكا الّتي أعرفها

132
00:09:01,460 --> 00:09:02,540
...كوريا

133
00:09:04,750 --> 00:09:06,800
تبدين مُحبَطة

134
00:09:08,130 --> 00:09:10,430
ستدعين السّعادة تضمحلّ

135
00:09:11,050 --> 00:09:13,260
مُؤسف جدّاً بشأن اختبار التحرِّي

136
00:09:13,430 --> 00:09:14,760
...لقد فشلتُ

137
00:09:14,930 --> 00:09:17,560
أدركتِ الحقيقة

138
00:09:17,720 --> 00:09:21,390
لكن لم تستطيعي قولها خوفاً على لوشي

139
00:09:23,980 --> 00:09:25,110
حسناً

140
00:09:25,570 --> 00:09:28,230
سأُريكِ شيئاً مُميّزاً

141
00:09:33,490 --> 00:09:35,240
!لولوكا، تعالي أيضاً

142
00:09:42,750 --> 00:09:44,000
ما هذا؟

143
00:09:44,170 --> 00:09:46,040
مِشبك نجمة كيرارينغ

144
00:09:46,710 --> 00:09:50,970
لم تتمكّن مُتحرّيةٌ نجمة من قبل
سحب هذا الخاتم

145
00:09:51,130 --> 00:09:56,510
إذا استطعتِ سحب الخاتم، ستُقبَلين
كمُتحرّية نجمة حقيقيّة

146
00:09:57,310 --> 00:09:59,970
...لكن فشلتُ في الاختبار

147
00:10:00,140 --> 00:10:03,390
المُتحرِّي يكشف الحقيقة

148
00:10:03,560 --> 00:10:06,690
فهم تفكير العميل هو جزءٌ من ذلك أيضاً

149
00:10:07,270 --> 00:10:09,360
قالَتْها قبل أن تتمكّني من ذلك

150
00:10:10,650 --> 00:10:13,990
،كوريا ولولوكا، يوماً ما

151
00:10:14,160 --> 00:10:17,200
أنا متأكّدةٌ بأنّكما ستتمكّنان من إخراج الخاتم

152
00:10:20,160 --> 00:10:21,870
!إنّه لمعاني-
ماذا؟-

153
00:10:22,040 --> 00:10:24,330
لمعاني هو ما يُخبرني بذلك

154
00:10:24,830 --> 00:10:27,540
!ينبغي أن تؤمني بلمعانكِ الخاصّ أيضاً

155
00:10:28,710 --> 00:10:31,050
لـ... لمعاني؟

156
00:10:33,300 --> 00:10:35,180
!نحن الآن في وكالة التحرِّي خاصّتنا

157
00:10:35,970 --> 00:10:37,760
...وفقاً لتحرّياتي

158
00:10:37,930 --> 00:10:42,430
بلاد الحقيقة الّتي يبحث عنها اللّصوص
الشّبح موجودة في هذه البلدة

159
00:10:42,600 --> 00:10:44,270
يجب علينا أن نبحث عنها بجدّ

160
00:10:44,440 --> 00:10:47,440
هل أنتِ مُوافقة على أن تكوني
مُساعِدة لولوكا؟

161
00:10:47,610 --> 00:10:48,480
!أجل

162
00:10:48,730 --> 00:10:53,110
سأتعلّم الكثير من لولوكا، ويوماً ما
!سأُصبح مُتحرّية نجمة

163
00:10:54,450 --> 00:10:59,990
قرّرتُ المُساعدة في متجر باتيسري
وذلك كي أجمع مزيداً من المعلومات

164
00:11:00,160 --> 00:11:01,580
واختبار التحرِّي؟

165
00:11:01,740 --> 00:11:04,000
!أعلم بأنّكِ ستنجحين فيه بسهولة

166
00:11:04,160 --> 00:11:07,830
تلقّيتُ بري-كيت الأسطوريّة خاصّتكِ من مافورو

167
00:11:08,000 --> 00:11:10,300
...لكن الأمر ليس بتلك البساطة

168
00:11:10,460 --> 00:11:12,420
طلبتُ هذا من شينيان

169
00:11:12,920 --> 00:11:15,470
بُرهان على الصّداقة بين البشر والجنّيين

170
00:11:15,630 --> 00:11:18,640
عطر مصنوع من لولب الزّنبق

171
00:11:18,800 --> 00:11:22,100
إنّه مثاليّ لكِ، بما أنّ الجنّيات يثِقنَ بكِ

172
00:11:22,270 --> 00:11:23,980
لماذا عطر؟

173
00:11:24,560 --> 00:11:25,480
العبير

174
00:11:25,640 --> 00:11:26,440
ماذا؟

175
00:11:26,690 --> 00:11:27,980
في تلك المرّة

176
00:11:28,150 --> 00:11:31,230
،ما لاحظتِه لم يكن شكل الزُّهور

177
00:11:31,400 --> 00:11:34,150
إنّما عبيرها الخفيّ

178
00:11:35,150 --> 00:11:37,700
تنظرين للأمور بشكل مُختلف عن نظرتي

179
00:11:38,240 --> 00:11:39,660
...لا أعلم

180
00:11:39,820 --> 00:11:41,830
دائماً ما تبقين متأخِّرة بخطوة

181
00:11:41,990 --> 00:11:43,660
هذه هي نقطة ضعفكِ

182
00:11:45,290 --> 00:11:48,500
لكن... لا يمكن لنقطة الضّعف أن
تُصبح نقطة قوّة

183
00:11:49,710 --> 00:11:53,460
خطوة واحدة للخلف يمكن أن تكشف الجواب

184
00:11:54,090 --> 00:11:56,930
لا تنسي لمعانكِ

185
00:11:58,050 --> 00:11:59,390
...لمعاني

186
00:12:00,180 --> 00:12:01,800
أنتِ قويّة

187
00:12:08,140 --> 00:12:09,350
هكذا إذاً

188
00:12:12,940 --> 00:12:14,440
لقد حان هذا اليوم

189
00:12:18,530 --> 00:12:20,990
!حان الوقت أخيراً

190
00:12:23,120 --> 00:12:25,580
سأُصبح بريكيور وأوقفهم

191
00:12:25,750 --> 00:12:27,500
اعتني بالجنّيات

192
00:12:28,460 --> 00:12:29,500
!لولوكا

193
00:12:29,670 --> 00:12:32,420
سنصل إلى صلب الأمر أخيراً

194
00:12:32,590 --> 00:12:35,000
!هذا صحيح! يجب علينا الخروج من هنا

195
00:12:35,170 --> 00:12:36,590
لكن كيف؟

196
00:12:39,840 --> 00:12:42,550
ماذا؟-
...تلك الفراشة غريبة-

197
00:12:48,430 --> 00:12:49,560
!هكذا إذاً

198
00:12:49,730 --> 00:12:51,730
!هذا هو الجواب

199
00:12:52,230 --> 00:12:55,400
!مفتاح الهرب من هنا-
!هذا هو-

200
00:13:04,580 --> 00:13:06,450
!إلى عالم من الأكاذيب

201
00:13:14,590 --> 00:13:19,170
!أنا أؤمن بلمعاني

202
00:13:24,300 --> 00:13:25,680
توقّعتُ ذلك

203
00:13:26,260 --> 00:13:28,810
...هذا هو لولب الزّنبق

204
00:13:29,770 --> 00:13:30,940
!كوريا

205
00:13:34,520 --> 00:13:35,520
!افتح

206
00:13:38,320 --> 00:13:39,860
!ضوء بري-كيت

207
00:13:42,110 --> 00:13:43,570
!آنّا، ميكورو

208
00:13:45,780 --> 00:13:49,500
!هذا هو جوابنا

209
00:13:52,790 --> 00:13:55,960
مُذهل! أحسنتُن المُلاحظة

210
00:13:56,460 --> 00:13:59,630
قلتَ بأنّنا لا نستطيع لمس شيء
في عالم الذّكريات

211
00:13:59,800 --> 00:14:04,220
!لكن حطّتْ تلك الفراشة على رأس بوتشيتان

212
00:14:04,390 --> 00:14:06,100
حينها قد لاحظنا ذلك

213
00:14:06,260 --> 00:14:09,430
كانت تلك الفراشة هي مفتاح
الهرب من المتاهة

214
00:14:10,850 --> 00:14:13,640
!والآن حان وقت غويمون ليتألّق

215
00:14:16,360 --> 00:14:18,440
!أيّتها الأكاذيب، طوِّقي

216
00:14:19,070 --> 00:14:22,070
!هيّا يا هانّيندا

217
00:14:28,240 --> 00:14:30,870
!هانّيندا! هان

218
00:14:31,330 --> 00:14:32,500
!هيّا بنا

219
00:14:36,750 --> 00:14:37,790
!افتحي

220
00:14:42,670 --> 00:14:44,510
!ساعة جوهرة كيور

221
00:14:47,260 --> 00:14:49,890
!بريكيور! وقت الاستيقاظ

222
00:14:50,060 --> 00:14:52,020
!ثلاثة! اكتشفي

223
00:15:04,820 --> 00:15:06,860
!ستّة! وواجها بعضيكما الآخر

224
00:15:18,840 --> 00:15:21,210
!تسعة! نحن الثّنائي الإعجازيّ

225
00:15:30,260 --> 00:15:32,100
!دوري

226
00:15:32,270 --> 00:15:34,020
!وأنهي الأمر بشكل ظريف

227
00:15:58,210 --> 00:16:04,130
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، أنسر كيور

228
00:16:06,260 --> 00:16:09,430
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

229
00:16:09,590 --> 00:16:12,850
!المُتحرّية النّجمة، كيور ميستيك

230
00:16:16,890 --> 00:16:19,150
!المُتحرّية النّجمة بريكيور

231
00:16:22,610 --> 00:16:23,570
!افتح

232
00:16:29,570 --> 00:16:31,700
!عطر لولب الزّنبق

233
00:16:34,540 --> 00:16:36,910
!بريكيور! وقت الاستيقاظ

234
00:16:37,460 --> 00:16:38,750
،الدّوران الورديّ

235
00:16:55,140 --> 00:16:56,100
!تفتّحي

236
00:17:18,750 --> 00:17:19,960
!استيقظي

237
00:17:20,120 --> 00:17:26,210
عطر الحقيقة الدّاخليّة، المُتحرّية
!النّجمة كيور إكلير

238
00:17:31,180 --> 00:17:33,640
!سأُريك إجابتي

239
00:17:34,180 --> 00:17:36,010
!هانّيندا

240
00:17:40,730 --> 00:17:42,100
!هانّيندا

241
00:17:45,110 --> 00:17:46,650
ديتشي آغين

242
00:17:47,980 --> 00:17:48,860
افتحي

243
00:17:56,580 --> 00:17:58,160
!عصا تير أركانا

244
00:18:05,580 --> 00:18:06,630
!اخلط

245
00:18:14,930 --> 00:18:16,010
!اعكس

246
00:18:35,200 --> 00:18:39,200
،تطويق كلّ شيء بالغموض والأسرار
كيور أركانا شادو

247
00:18:40,160 --> 00:18:43,460
حسناً، أهلاً بكم في المتاهة

248
00:18:48,130 --> 00:18:51,380
مهلاً، ألسنا في نفس الصّفّ؟

249
00:18:53,220 --> 00:18:55,510
أليس كذلك يا أركانا شادو؟

250
00:18:57,640 --> 00:18:59,010
ماذا تفعل؟

251
00:18:59,180 --> 00:19:02,480
لا أصدِّق بأنّكِ تريدين سماع الجواب

252
00:19:03,270 --> 00:19:06,850
لم أتوقّع أبداً أن تقطعي كُلّ هذه المسافة

253
00:19:07,020 --> 00:19:11,360
أو رُبّما هناك شيء لا تريدين
من النّاس معرفته؟

254
00:19:13,530 --> 00:19:15,070
!هانّيندا

255
00:19:19,870 --> 00:19:22,330
!انعكاس ميستيك

256
00:19:25,960 --> 00:19:27,920
!لا نستطيع الاقتراب

257
00:19:31,300 --> 00:19:33,880
!هان-نين-نين-نين-نين

258
00:19:39,010 --> 00:19:41,430
!ترسم البسمة في وجه الجميع

259
00:19:42,100 --> 00:19:44,930
لا تنسي لمعانكِ

260
00:19:49,810 --> 00:19:51,610
!وقت اللّمعان

261
00:19:54,740 --> 00:19:57,660
!ها! ها! هانّيندا

262
00:19:59,950 --> 00:20:02,700
!خطوة واحدة للوراء قد تكشف الجواب

263
00:20:02,990 --> 00:20:04,660
!دا! هانّيندا

264
00:20:08,580 --> 00:20:09,540
!افتحي

265
00:20:12,800 --> 00:20:14,550
!عدسة مرآة بري-كيت

266
00:20:15,090 --> 00:20:16,130
!شوشوتان

267
00:20:18,630 --> 00:20:20,090
!جوهرة ماكوتو

268
00:20:26,560 --> 00:20:28,520
!كيور إكلير ستُغلق هذه القضيّة

269
00:20:35,990 --> 00:20:40,870
أبسط جناحَي بأناقة وأحلّ اللّغز

270
00:20:42,370 --> 00:20:44,160
هذا هو جوابي

271
00:20:48,330 --> 00:20:51,920
!بريكيور! تحليق بلا حدود

272
00:21:06,720 --> 00:21:08,350
!إغلاق ملفّ كيوريتّو

273
00:21:08,810 --> 00:21:12,730
!هانّيندا

274
00:21:22,200 --> 00:21:25,030
!بوتشي بوتشي كيور كيور

275
00:21:30,410 --> 00:21:32,960
...فـ-فعلناها

276
00:21:37,300 --> 00:21:38,550
!تراجعي

277
00:21:40,170 --> 00:21:43,430
أعتذر عن إهانتك

278
00:21:43,930 --> 00:21:45,390
سامحيني رجاء

279
00:21:45,890 --> 00:21:47,640
يا أركانا شادو

280
00:21:50,520 --> 00:21:54,940
على أيّ حال، لماذا قرّرتِ المُساعدة
في محلّ باتيسري؟

281
00:21:55,110 --> 00:21:58,980
هناك أماكن أُخرى كان بإمكانكِ
جمع معلومات فيها

282
00:21:59,150 --> 00:21:59,940
أليس كذلك؟

283
00:22:00,110 --> 00:22:02,700
لأنّ لولوكا تُحبّ الآيس كريم

284
00:22:05,660 --> 00:22:07,280
كوريا هووا

285
00:22:07,450 --> 00:22:10,290
،يمكنها استخدام قوّة لولب الزّنبق

286
00:22:10,870 --> 00:22:13,170
لذا هي شخص مُميّز

287
00:23:47,340 --> 00:23:49,800
لا أصدِّق بأنّ لولوكا وكوريا
!لديهما ماضٍ كهذا

288
00:23:49,970 --> 00:23:52,060
ماذا سيحدث للثّنائي الآن؟

289
00:23:52,680 --> 00:23:55,810
!لا مُشكلة! أنا أؤمن بلمعاني

290
00:23:56,560 --> 00:23:58,400
!لولوكا، تبدين مُختلفة

291
00:23:59,190 --> 00:24:01,980
!المُتحرّية النّجمة بريكيور
"ظلّ الكسوف"

292
00:24:02,150 --> 00:24:04,490
!أغلِقَ ملفّ قضيّة اللّغز كيوريتّو