1
00:00:11,130 --> 00:00:13,880
ما هي هويّة كيور إكلير الحقيقيّة؟

2
00:00:15,340 --> 00:00:18,600
!فصل كيور إكلير يبدأ اليوم

3
00:00:19,140 --> 00:00:23,770
قصّة هؤلاء الفتيات الأربعة اللّواتي
!قد يكُنّ كيور إكلير تبدأ الآن

4
00:00:23,940 --> 00:00:26,770
ماذا؟ تعنين بأنّ إحداهن كيور إكلير؟

5
00:00:26,940 --> 00:00:27,810
مَن، مَن؟

6
00:00:27,980 --> 00:00:29,780
لا أعرف أيضاً

7
00:00:29,940 --> 00:00:32,240
ينبغي أن يكون هناك طرف خيط
في كلّ قصّة

8
00:00:32,400 --> 00:00:34,240
!لنتحرَّ جميعاً معاً

9
00:00:34,660 --> 00:00:37,780
!قصّة اليوم عن إيريزا كوروسو

10
00:00:37,950 --> 00:00:39,410
!حسناً، لنبدأ

11
00:00:40,160 --> 00:00:41,750
!المُتحرّية النّجمة بريكيور

12
00:00:42,830 --> 00:00:43,870
!ابدأ

13
00:00:46,790 --> 00:00:47,880
ما هذا؟

14
00:00:48,960 --> 00:00:50,550
نبوءة جديدة؟

15
00:00:51,630 --> 00:00:53,800
تعود الفراشة الزّرقاء"

16
00:00:54,680 --> 00:00:58,850
من أربعة زهور، تبحث عن المُتفتِّحة
"لبسط أجنحتها

17
00:01:00,060 --> 00:01:01,390
...هذا يعني

18
00:01:02,180 --> 00:01:04,100
...تلك الفراشة الزّرقاء

19
00:01:09,690 --> 00:01:11,360
ستعود؟

20
00:01:11,530 --> 00:01:13,940
!سنتدبّر الأمر قبل ذلك الحين

21
00:01:14,110 --> 00:01:17,450
!لكن هويّتها مجهولة! لا وسيلة لنا للهجوم

22
00:01:18,070 --> 00:01:21,700
من أربعة زهور، تبحث عن المُتفتِّحة"
"لبسط أجنحتها

23
00:01:21,870 --> 00:01:26,080
هذا يعني أنّ هناك أربعة أشخاص
قد يصبحون هي؟

24
00:01:26,790 --> 00:01:28,170
لا تقلقوا

25
00:01:28,670 --> 00:01:31,380
ركّزوا على الحصول على جواهر ماكوتو

26
00:01:32,050 --> 00:01:34,210
اليوم الموعود مُقبل علينا

27
00:01:35,010 --> 00:01:36,090
!لاي لاي، سيّدي

28
00:01:37,840 --> 00:01:40,720
...مُستحيل. إنّها لن تأتي أبداً

29
00:01:41,890 --> 00:01:43,520
...كيور إكلير

30
00:01:45,230 --> 00:01:46,480
!مرحباً

31
00:01:47,060 --> 00:01:50,360
!إيريزا-
لِمَ هذا الزيّ؟-

32
00:01:50,520 --> 00:01:52,360
!لقد قرّرت

33
00:01:53,400 --> 00:01:55,150
!سأصبح مُتحرّية

34
00:01:55,320 --> 00:01:56,820
!ماذا؟

35
00:02:01,870 --> 00:02:05,620
!لنبحث عن اللّمحة في القلب

36
00:02:05,790 --> 00:02:08,870
إلهام مُشرِق

37
00:02:09,120 --> 00:02:11,750
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

38
00:02:11,920 --> 00:02:14,550
إنّها تنادينا

39
00:02:14,710 --> 00:02:17,380
أين الحقيقة؟ ما الّذي ستكتشفه؟

40
00:02:17,550 --> 00:02:21,010
لغز تلو الآخر

41
00:02:21,800 --> 00:02:27,140
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

42
00:02:27,310 --> 00:02:32,520
كما الدّليل! شيء يلمع عبر الزّمن

43
00:02:32,690 --> 00:02:35,360
كيف؟ كيف؟ أهي خدعة؟

44
00:02:35,530 --> 00:02:38,200
لماذا؟ لماذا؟ سوف نواجهها

45
00:02:38,610 --> 00:02:43,780
لننظر ونشعر
نكتشف الأسرار

46
00:02:44,240 --> 00:02:49,750
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

47
00:02:50,080 --> 00:02:55,300
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

48
00:02:55,550 --> 00:03:00,970
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

49
00:03:01,130 --> 00:03:04,510
!لنمشِ في ذلك الطّريق معاً

50
00:03:04,680 --> 00:03:08,430
!لنبحث عن اللّمحة في القلب

51
00:03:08,640 --> 00:03:10,270
إلهام مُشرِق

52
00:03:10,440 --> 00:03:16,110
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

53
00:03:16,270 --> 00:03:21,200
ولادتنا ولقاؤنا لَهو لغز رائع

54
00:03:21,360 --> 00:03:24,830
!هيّا يا بريكيور المُتحرّيات النّجمات

55
00:03:31,580 --> 00:03:36,000
كتاب قضايا المُتحرّية إيلّي، الجزء 2؟

56
00:03:36,590 --> 00:03:39,510
إيريزا-
لماذا مُتحرّية؟-

57
00:03:40,300 --> 00:03:44,260
أتتذكّران المرّة الماضية، عندما عثرنا
على القطّة المفقودة ميكو؟

58
00:03:44,430 --> 00:03:46,760
،عندما رأيتُ ابتسامة وكيلتنا كوتارو

59
00:03:46,930 --> 00:03:50,730
!اشتعلت روح المُتحرّية لديّ

60
00:03:52,520 --> 00:03:55,650
أرجوكما! اسمحا لي بالانضمام
!لوكالة التحرّي كيوريتو

61
00:03:56,020 --> 00:03:56,980
ماذا؟

62
00:04:01,400 --> 00:04:02,490
!سينسي

63
00:04:02,650 --> 00:04:04,530
!عرفتُ بأنّكِ ستكونين هنا

64
00:04:05,240 --> 00:04:07,530
!اتّصلتُ بكِ عدّة مرّات

65
00:04:07,700 --> 00:04:09,540
!لم ألحظ إطلاقاً

66
00:04:09,700 --> 00:04:12,660
!كنتُ أُركّز على هدفي الجديد فقط

67
00:04:16,250 --> 00:04:20,880
اسمي يوريكو هينمي، مُحرِّرة إيريزا

68
00:04:22,670 --> 00:04:25,800
اسمي آنّا أكيتشي من مكتب
وكالة التحرّي كيوريتّو

69
00:04:25,970 --> 00:04:27,470
أنا ميكورو كوباياشي

70
00:04:28,100 --> 00:04:30,720
أنا المُخترع العبقريّ، الأستاذ جيت

71
00:04:30,890 --> 00:04:32,890
سمعتُ عنكم جميعاً

72
00:04:33,060 --> 00:04:38,270
حللتُم قضايا الشّبح وفوق كلّ شيء
كنتُم مُلهمين لتتمّة المُتحرّية إيلّي

73
00:04:38,440 --> 00:04:40,440
!أنتما مُتحرّيتان خبيرتان

74
00:04:40,610 --> 00:04:41,900
!يا إلهي

75
00:04:42,070 --> 00:04:44,450
!هذه أوّل مرّة أُنادى فيها بمُتحرّية خبيرة

76
00:04:44,990 --> 00:04:47,660
...أعلم بأنّني عرّفتُ عن نفسي للتو، لكن

77
00:04:47,820 --> 00:04:48,740
المعذرة

78
00:04:49,870 --> 00:04:52,330
سينسي، الموعد النّهائيّ لتسليم
!نسختك قد اقترب

79
00:04:52,500 --> 00:04:53,620
!لنذهب

80
00:04:53,910 --> 00:04:58,710
!لا! سوف أملأ صفحات الحقيقة كمُتحرّية

81
00:04:59,210 --> 00:05:00,840
صحيح؟ أيمكنني ذلك؟

82
00:05:01,000 --> 00:05:04,970
لكن هناك اختبار صعب للانضمام للوكالة

83
00:05:05,130 --> 00:05:05,930
أليس كذلك؟

84
00:05:06,090 --> 00:05:11,310
أنا مُخترع لذا لا أعلم، لكن
أعتقد بأنّه يوجد شيء كهذا

85
00:05:11,930 --> 00:05:14,940
خضعتُ لاختبار، صحيح؟

86
00:05:15,230 --> 00:05:17,060
لا أعلم. صحيح؟

87
00:05:17,690 --> 00:05:21,570
سمعتُ بأنّ الاختبار كان حلّ قضيّة

88
00:05:23,860 --> 00:05:27,200
!إذاً سأخضع لهذا الاختبار

89
00:05:40,290 --> 00:05:42,800
!لا يأتي أي وُكلاء

90
00:05:42,960 --> 00:05:47,510
في العادة نكون مشغولين دوماً! صادفَ
أنّه لم يأتِ أي مُوكّل اليوم

91
00:05:47,680 --> 00:05:49,430
لكن الأمر هكذا دوماً، صحيح؟

92
00:05:49,590 --> 00:05:50,640
ماذا عن اختباري؟

93
00:05:51,350 --> 00:05:54,270
على أيّ حال، لم أخضع لاختبار، صحيح؟

94
00:05:54,430 --> 00:05:57,980
أصبحتُما بريكيور، لذا انضممتُما تلقائيّاً

95
00:05:58,140 --> 00:05:59,480
!صحيح

96
00:05:59,650 --> 00:06:00,690
بري...؟

97
00:06:01,150 --> 00:06:05,490
وجدتُها! لنغتنم هذا الوقت ونأخذكِ
!في جولة تعريفيّة

98
00:06:05,650 --> 00:06:08,360
أوّلاً، مُختبر جيت-سينباي

99
00:06:09,610 --> 00:06:13,540
أجل، سأريكِ الاختراع الجديد
الّذي صنعتُه في الأمس

100
00:06:15,500 --> 00:06:18,830
...نسكب هذا السّائل على صورة ضبابيّة

101
00:06:24,500 --> 00:06:25,880
!انظري إلى هذا

102
00:06:26,050 --> 00:06:28,630
هذه الصّورة منذ 20 عاماً برّاقة وساطعة

103
00:06:28,800 --> 00:06:29,880
ألستُ عبقريّاً؟

104
00:06:30,550 --> 00:06:32,050
قبل عشرين عاماً؟

105
00:06:32,890 --> 00:06:34,390
وهذا هو المُلحَق

106
00:06:34,560 --> 00:06:36,220
هذا هو فضاؤنا المُشترك

107
00:06:36,390 --> 00:06:38,520
الجميع يجتمعون معاً للدردشة هنا

108
00:06:38,690 --> 00:06:40,350
!يبدو هذا مُمتعاً

109
00:06:40,850 --> 00:06:42,440
!وهذه هي غرفتي

110
00:06:42,610 --> 00:06:43,440
!جميل

111
00:06:43,610 --> 00:06:46,900
أجل! السّطح عالٍ وبرّاق

112
00:06:47,070 --> 00:06:51,110
جوهرة ماكوتو. إنّها هنا، من بين كلّ الأماكن

113
00:06:51,280 --> 00:06:56,040
في منطقة مُتحرّيات، مُتحرّية في أداة"
تُوفّر أصوات"؟

114
00:06:56,790 --> 00:06:59,460
لكن ما الّذي يعنيه هذا؟

115
00:07:02,000 --> 00:07:03,790
هل تلك المُتحرّية إيلّي؟

116
00:07:03,960 --> 00:07:07,880
أجل، شريطة هاتف المُتحرّية
إيلّي المُنتظرة طويلاً

117
00:07:08,050 --> 00:07:09,130
أليست رائعة؟

118
00:07:09,300 --> 00:07:10,470
!ظريفة للغاية

119
00:07:10,930 --> 00:07:13,970
مُتحرّية في أداء تُوفّر أصوات

120
00:07:14,640 --> 00:07:16,930
هناك تتواجد جوهرة ماكوتو

121
00:07:17,100 --> 00:07:18,600
ماذا؟ أين؟

122
00:07:19,230 --> 00:07:21,650
هذه السّتائر عقبة في وجهي

123
00:07:21,810 --> 00:07:25,570
وفوق كلّ هذا، ليست أنيقة. أريد
أن أتكلّم معها

124
00:07:26,110 --> 00:07:28,740
مُقابل غرفة آنّا تقع غرفتي

125
00:07:29,320 --> 00:07:31,490
هذا مُطمئن جدّاً

126
00:07:31,660 --> 00:07:33,410
!رُبّما ذوقنا مُتشابه

127
00:07:33,570 --> 00:07:36,200
بنفس الغرفة، تصنع الشّخصيّةُ فرقاً حقّاً

128
00:07:36,370 --> 00:07:37,540
نفس الغرفة؟

129
00:07:37,700 --> 00:07:42,420
،انظري. إنّها بنفس مُخطّط غرفة آنّا
لكن تبدو مُختلفة تماماً

130
00:07:47,420 --> 00:07:48,460
جيت

131
00:07:49,590 --> 00:07:51,010
هل حصلنا على أي قضايا؟

132
00:07:51,170 --> 00:07:54,970
لا. يمكننا قضاء أيّام كاملة دون فعل شيء

133
00:07:55,760 --> 00:07:57,260
حقّاً؟

134
00:07:57,930 --> 00:07:59,600
التّالي هي هذه الغرفة

135
00:07:59,770 --> 00:08:00,600
حـ-حسناً

136
00:08:01,310 --> 00:08:04,190
هذه الحديقة هي فخر وكالة التحرّي

137
00:08:04,350 --> 00:08:05,560
!إنّها جميلة

138
00:08:06,060 --> 00:08:07,690
ماذا؟ أين إيريزا؟

139
00:08:07,860 --> 00:08:10,610
في المكتب. إنّها تتكلّم مع جيت

140
00:08:11,240 --> 00:08:15,820
المُختبر كبير جدّاً، يمكنك أن تدعني
أن أستخدم النّصف، أليس كذلك؟

141
00:08:15,990 --> 00:08:17,780
لِمَ ينبغي لي ذلك؟

142
00:08:18,910 --> 00:08:21,000
إنّها نفودة الصّبر دوماً

143
00:08:21,370 --> 00:08:23,420
إيريزا مُتحمّسة حقّاً

144
00:08:23,920 --> 00:08:27,750
أعرف كيف هو شعورها. كنتُ عازمة أيضاً
على أن أصبح مُتحرّية نجمة

145
00:08:28,630 --> 00:08:31,050
أعتقد يجدر بي أن أدعمها

146
00:08:33,010 --> 00:08:36,640
كانت "المُتحرّية إيلّي" عملي الأوّل

147
00:08:36,800 --> 00:08:41,270
إنّ نشر كِتاب معها أسعدني. كان ذلك مُمتعاً

148
00:08:42,390 --> 00:08:45,600
لكن هذا ما أشعر به أنا فحسب

149
00:08:45,770 --> 00:08:48,940
العمل كمُتحرّية هو حلم طفولتها

150
00:08:49,110 --> 00:08:50,480
منذ الطّفولة؟

151
00:08:50,650 --> 00:08:55,660
أجل. قالت بأنّها أرادت أن تكون
مُتحرّية، لا روائيّة

152
00:08:55,820 --> 00:08:58,870
كان حُلمها، لكن لم تستطع تحقيقه

153
00:08:59,530 --> 00:09:01,490
لم تستطع تحقيقه؟

154
00:09:01,660 --> 00:09:03,620
أجل، هذا ما قالته

155
00:09:12,340 --> 00:09:13,380
هذه؟

156
00:09:13,880 --> 00:09:16,430
أعدتُ اللّون إلى صورة ضبابيّة

157
00:09:16,590 --> 00:09:18,300
باختراعي الأخير

158
00:09:19,010 --> 00:09:20,560
لستُ أفهم ذلك حقّاً

159
00:09:20,720 --> 00:09:23,600
لا أعلم حتّى ما إن كان دليلاً لقضيّة

160
00:09:26,140 --> 00:09:27,730
ما الخطب؟

161
00:09:29,610 --> 00:09:31,150
...هذا-
ماذا؟-

162
00:09:32,110 --> 00:09:33,320
لا شيء

163
00:09:33,860 --> 00:09:36,650
مهلاً، أظنّني تلقّيتُ مُكالمة

164
00:09:39,450 --> 00:09:40,910
!جوهرة ماكوتو

165
00:09:44,080 --> 00:09:45,290
ماذا؟ هذه أنا؟

166
00:09:45,460 --> 00:09:47,250
!لا بُدّ أنّها لصّة شبح

167
00:09:48,710 --> 00:09:49,960
!هاتفي

168
00:09:50,460 --> 00:09:51,290
ما الأمر؟

169
00:09:51,460 --> 00:09:52,920
!سُرِقَ هاتفي

170
00:09:53,090 --> 00:09:53,920
ماذا؟

171
00:09:54,090 --> 00:09:55,920
السّرقة بالقوّة ثانية

172
00:09:56,090 --> 00:09:58,640
...هذه أغيسيني-
!حصلتُ عليها-

173
00:09:58,800 --> 00:10:00,140
!هذا رائع للغاية

174
00:10:09,480 --> 00:10:11,150
إلى أين ذهب اللّصّ؟

175
00:10:11,310 --> 00:10:13,650
!ربّما تنكّر من جديد

176
00:10:13,820 --> 00:10:16,070
!كما في تلك المرّة مع قلم إيريزا

177
00:10:16,690 --> 00:10:17,860
،في تلك المرّة

178
00:10:18,360 --> 00:10:23,370
،لم يعلم اللّصّ بأنّ الشّبكة كانت مُعطّلة
فكان يتكلّم عبر الهاتف

179
00:10:23,540 --> 00:10:25,330
!هكذا عثرنا على الجاني

180
00:10:26,040 --> 00:10:28,460
هذه المرّة، الشّبكة غير مُعطّلة

181
00:10:28,620 --> 00:10:32,290
الشّخص الّذي يتكلّم عبر الهاتف
ليس بالضّرورة أن يكون الجاني

182
00:10:32,880 --> 00:10:35,260
...الشّخص الّذي يتكلّم عبر الهاتف

183
00:10:38,090 --> 00:10:40,640
!أعتقد بأنّني أستطيع إيجاد الجاني

184
00:10:41,140 --> 00:10:43,220
!اعتمدوا عليّ

185
00:10:54,270 --> 00:10:56,150
يمكنكِ إيجاد اللّصّ الشّبح؟

186
00:10:56,320 --> 00:10:57,440
لكن كيف؟

187
00:10:57,610 --> 00:11:00,360
!إنّه عكس ما حدث عندما سُرِق قلمي

188
00:11:00,910 --> 00:11:01,780
عكس؟

189
00:11:01,950 --> 00:11:05,660
حينها، كانت الشّبكة مُعطّلة، لذا
لم يكن الهاتف يتّصل

190
00:11:05,830 --> 00:11:08,250
!لكن هذه المرّة سيتّصل

191
00:11:08,830 --> 00:11:13,130
إذا اتّصلتُ بهاتف الآنسة هينمي
...الّذي سرقه الشّبح

192
00:11:18,510 --> 00:11:24,850
الجاني، لا، اللّصّ الشّبح الّذي
!سرق الهاتف هو أنت

193
00:11:27,770 --> 00:11:29,560
هذا رديء جدّاً

194
00:11:30,890 --> 00:11:33,190
!انظروا! وجدتُ الجاني

195
00:11:33,350 --> 00:11:35,320
!نجحتُ في الاختبار إذاً

196
00:11:35,480 --> 00:11:38,110
!لا تتحمّسنَ كثيراً أمامي

197
00:11:39,860 --> 00:11:41,530
!أيّتها الأكاذيب، طوّقي

198
00:11:42,160 --> 00:11:43,820
!دعيها تُحلِّق

199
00:11:44,370 --> 00:11:45,530
!هانّيندا

200
00:11:51,290 --> 00:11:53,330
!هانّيندا

201
00:11:55,340 --> 00:11:56,130
ماذا؟

202
00:11:57,840 --> 00:11:58,960
اختفت؟

203
00:11:59,510 --> 00:12:01,590
!مُتحرّيون ضدّ مُتحرّيين

204
00:12:02,130 --> 00:12:03,090
!دا

205
00:12:03,260 --> 00:12:04,800
!آنّا-
!أجل-

206
00:12:09,310 --> 00:12:10,230
!افتحي

207
00:12:15,480 --> 00:12:17,110
!ساعة جوهرة كيور

208
00:12:19,860 --> 00:12:22,490
!بريكيور! وقت الاستيقاظ

209
00:12:22,650 --> 00:12:24,610
!ثلاثة! اكتشفي

210
00:12:37,250 --> 00:12:39,420
!ستّة! ومُقابل بعضيهما الآخر

211
00:12:51,270 --> 00:12:53,810
!تسعة! نحن الثّنائي الإعجازيّ

212
00:13:02,740 --> 00:13:04,530
!دوري

213
00:13:04,700 --> 00:13:06,610
!وأنهي الأمر بشكل ظريف

214
00:13:30,810 --> 00:13:36,560
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، أنسر كيور

215
00:13:38,860 --> 00:13:41,900
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

216
00:13:42,070 --> 00:13:45,570
!المُتحرّية النّجمة، كيور ميستيك

217
00:13:49,490 --> 00:13:51,530
!المُتحرّية النّجمة بريكيور

218
00:13:53,830 --> 00:13:56,660
!سأُريك إجابتي

219
00:13:56,830 --> 00:13:58,210
!هانّيندا

220
00:14:03,670 --> 00:14:05,840
!انعكاس ميستيك

221
00:14:15,100 --> 00:14:17,310
!هجوم آنسر

222
00:14:18,480 --> 00:14:19,560
!دا

223
00:14:19,730 --> 00:14:21,360
!أعيدي الشّريطة

224
00:14:21,520 --> 00:14:23,520
!أعيدي لي صورتي

225
00:14:23,690 --> 00:14:26,150
!أخذتُ تلك الصُّورة

226
00:14:26,320 --> 00:14:27,400
صورة؟

227
00:14:27,570 --> 00:14:29,990
!رأيتُها في مكتبك

228
00:14:30,160 --> 00:14:32,200
صورة الفراشة الزّرقاء

229
00:14:32,370 --> 00:14:34,660
ماذا؟ هذا بريكيور

230
00:14:34,830 --> 00:14:35,700
ماذا؟

231
00:14:35,870 --> 00:14:37,620
!تلك الصّورة هي صورة بريكيور؟

232
00:14:37,790 --> 00:14:39,750
بريكيور أُخرى؟

233
00:14:39,920 --> 00:14:42,250
!مكتب لندن لا يعلم ذلك حتّى

234
00:14:43,210 --> 00:14:46,260
هذا مُضحك! ألا تعرفون شيئاً؟

235
00:14:46,920 --> 00:14:50,510
عندما حاولنا الحصول على جوهرة
...ماكوتو الضّخمة جدّاً

236
00:14:50,970 --> 00:14:56,060
!تذكار عابر لسرقة جوهرة ماكوتو

237
00:15:04,860 --> 00:15:06,110
...بريكيور

238
00:15:08,530 --> 00:15:12,320
!إذا عادتْ، فسنفشل تماماً

239
00:15:12,490 --> 00:15:13,370
ماذا؟

240
00:15:15,160 --> 00:15:16,620
أنتِ ثرثارة

241
00:15:18,870 --> 00:15:19,790
!افتحي

242
00:15:27,510 --> 00:15:28,840
!عصا تير أركانا

243
00:15:36,510 --> 00:15:37,520
!اخلط

244
00:15:46,020 --> 00:15:47,020
!اعكس

245
00:16:06,340 --> 00:16:10,130
،تطويق كلّ شيء بالغموض والأسرار
كيور أركانا شادو

246
00:16:11,010 --> 00:16:14,090
حسناً، أهلاً بكم في المتاهة

247
00:16:22,890 --> 00:16:25,310
بريكيور؟-
ماذا تقصدين؟-

248
00:16:25,480 --> 00:16:28,570
لا أدري. لا نعلم من كان

249
00:16:31,530 --> 00:16:34,860
ظهرتْ في تلك المرّة فحسب

250
00:16:37,990 --> 00:16:40,950
ثمّ اختفتْ مع جوهرة ماكوتو

251
00:16:42,660 --> 00:16:45,000
لذا، لن تعود

252
00:16:57,390 --> 00:16:58,970
مطر نجمة أركانا

253
00:17:11,900 --> 00:17:14,740
لا حاجة لتعرفوا شيئاً

254
00:17:14,900 --> 00:17:19,200
!أجل! لا حاجة لتعرفوا شيئاً عن كيور إكلير

255
00:17:19,870 --> 00:17:21,330
كيور إكلير؟

256
00:17:21,910 --> 00:17:23,040
ماشوتان؟

257
00:17:23,200 --> 00:17:24,790
!بئساً! آسفة

258
00:17:25,330 --> 00:17:28,080
!لا تنسونا ثانية

259
00:17:28,250 --> 00:17:30,500
!هانّيندا

260
00:17:30,670 --> 00:17:31,500
!دا

261
00:17:34,170 --> 00:17:35,010
ها؟

262
00:17:36,630 --> 00:17:38,050
!ها! ها

263
00:17:40,930 --> 00:17:41,970
!دعي هذا الأمر لي

264
00:17:42,640 --> 00:17:43,600
!افتحي

265
00:17:45,940 --> 00:17:47,900
!عدسة المرآة المُكبِّرة بري-كيت

266
00:17:48,520 --> 00:17:49,440
!بوتشيتان

267
00:17:53,110 --> 00:17:54,400
!جوهرة ماكوتو

268
00:17:57,200 --> 00:17:59,410
!كيور آنسر ستُغلق هذه القضيّة

269
00:18:02,830 --> 00:18:04,870
!بريكيور

270
00:18:05,750 --> 00:18:08,370
!هجمة ميستيك

271
00:18:27,940 --> 00:18:29,560
!إغلاق ملفّ القضيّة كيوريتو

272
00:18:29,730 --> 00:18:34,030
!هان! نين! دا-ها-ها

273
00:18:42,620 --> 00:18:45,120
!بوتشي بوتشي كيور كيور

274
00:18:48,870 --> 00:18:50,710
!هذا مُزعج للغاية

275
00:18:51,670 --> 00:18:52,630
ماشوتان

276
00:18:52,790 --> 00:18:54,170
أجل، هيّا بنا

277
00:18:54,920 --> 00:18:57,300
لحظة! من هي كيور إكلير؟

278
00:18:57,760 --> 00:19:00,630
!لن أخبركما بشيء بعد الآن

279
00:19:00,800 --> 00:19:05,100
الأهمّ، ألا ينبغي أن تقلقا بشأن
السّتائر في غرفتكم؟

280
00:19:05,260 --> 00:19:06,100
ماذا؟

281
00:19:06,270 --> 00:19:10,100
عندما كانت غرفة لولوكا، كانت
!أكثر أناقة بكثير

282
00:19:10,270 --> 00:19:11,270
ماشوتان

283
00:19:11,440 --> 00:19:13,060
آسفة! زلّ لساني

284
00:19:13,230 --> 00:19:15,230
!يجب أن أبقى صامتة

285
00:19:17,440 --> 00:19:19,320
كانت تلك غرفة لولوكا؟

286
00:19:21,780 --> 00:19:23,410
!شكراً جزيلاً

287
00:19:23,570 --> 00:19:27,790
!ظننتُ بأنّكما رحلتُما، لكنّكما استعدتُماه من اللّصّ

288
00:19:27,950 --> 00:19:29,580
!أنتما المُتحرّيتان النّجمتان حقّاً

289
00:19:29,750 --> 00:19:33,960
لكن لولا وجودكِ هناك، لما تمكنّا من استعادته

290
00:19:36,000 --> 00:19:37,340
مهلاً لحظة

291
00:19:37,510 --> 00:19:41,300
إذا كان تحرّي إيريزا ساعدكما
...في حلّ القضية

292
00:19:41,470 --> 00:19:43,760
فهذا يعني أنّها نجحتْ في اختبار المُتحرّية؟

293
00:19:44,100 --> 00:19:44,930
!ماذا؟

294
00:19:46,970 --> 00:19:48,720
أجل، أظنّها كذلك

295
00:19:50,140 --> 00:19:52,900
أنا؟ مُتحرّية؟

296
00:19:57,190 --> 00:19:59,360
كان وعداً في نهاية المطاف

297
00:20:03,360 --> 00:20:07,540
!سينسي، ارسمي البسمة في وجه المُوكّلين

298
00:20:08,120 --> 00:20:09,790
!كما المُتحرّية إيلّي

299
00:20:12,870 --> 00:20:14,710
!خطرتْ على ذهني فكرة جديدة فحسب

300
00:20:14,880 --> 00:20:15,670
ماذا؟

301
00:20:15,880 --> 00:20:20,630
بينما كنتُما تُطاردان الشّبح، لمعتْ
!في ذهني فكرة بشأن المُتحرّية إيلّي

302
00:20:20,800 --> 00:20:22,680
!عليّ الذّهاب وتدوينها

303
00:20:23,550 --> 00:20:24,640
...لكن

304
00:20:24,800 --> 00:20:27,470
!لم أتخلَّ عن العمل كمُتحرّية

305
00:20:27,640 --> 00:20:30,310
!سأكتب روايات وأمارس التحرّي أيضاً

306
00:20:30,470 --> 00:20:33,350
لكن اليوم، اقترب موعد التّسليم النّهائي

307
00:20:35,860 --> 00:20:39,530
،سأكون مُؤلّفة روايات غموض في مدارس ثانويّة
!إيريزا كوروسو

308
00:20:42,280 --> 00:20:45,320
!أجل! لنذهب، قبل أن تنسي فكرتك

309
00:20:47,070 --> 00:20:52,330
،بالمُناسبة، قلتُما بأنّني حللتُ القضيّة
لكن هذا غير صحيح

310
00:20:52,910 --> 00:20:55,000
مثل قضيّة القطّة المفقودة

311
00:20:55,170 --> 00:20:57,460
!فعلتُها لأنّكما كنتُما معي

312
00:20:58,130 --> 00:21:02,670
لو كنتُ جزءاً من ثُنائي مثلكما، لرُبّما
أصبحتُ مُتحرّية نجمة الآن

313
00:21:03,340 --> 00:21:04,430
!وداعاً

314
00:21:16,560 --> 00:21:20,900
سيكون من اللّطيف أن تنضمّ إيريزا
لوكالة التحرّي كيوريتّو

315
00:21:21,070 --> 00:21:23,070
سيكون ذلك مُمتعاً حقّاً

316
00:21:25,570 --> 00:21:26,860
حان وقت النّوم

317
00:21:27,280 --> 00:21:28,070
أجل

318
00:21:35,790 --> 00:21:38,630
كانت هذه غرفة لولوكا إذاً

319
00:21:38,790 --> 00:21:41,630
بنفس الغرفة، تصنع الشّخصيّةُ فرقاً حقّاً

320
00:21:42,960 --> 00:21:44,590
نفس الغرفة

321
00:21:46,510 --> 00:21:51,890
لو كنتُ جزءاً من ثُنائي مثلكما، لرُبّما
أصبحتُ مُتحرّية نجمة الآن

322
00:21:52,060 --> 00:21:52,930
!ثُنائي

323
00:21:55,730 --> 00:21:59,060
ميكورو! غرفتان في المُلحَق لديهما
!نفس المُخطّط

324
00:21:59,230 --> 00:22:03,570
أجل! رُبّما كان يوجد شخص هنا
!في ثُنائي مع لولوكا

325
00:22:03,730 --> 00:22:06,780
...رُبّما الّتي في غرفة ميكورو

326
00:22:10,320 --> 00:22:11,830
!كانت كيور إكلير

327
00:22:12,660 --> 00:22:15,500
بقي شهر واحد حتّى الموعد المُقدّر
وهو 19 يوليو، 1999

328
00:23:48,760 --> 00:23:50,840
من هي كيور إكلير؟

329
00:23:51,590 --> 00:23:53,430
...البريكيور الّتي اختفت

330
00:23:53,590 --> 00:23:55,680
!سوف نحلّ هذا اللّغز

331
00:23:55,850 --> 00:23:57,930
!الحلقة القادمة، ظهور شيروكو

332
00:23:59,100 --> 00:24:01,440
بقي أربعة أسابيع حتّى تنكشف هويّتها

333
00:24:01,600 --> 00:24:05,610
!من هي برأيك؟ حُلّ اللّغز وصوّت