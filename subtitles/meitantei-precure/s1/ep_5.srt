1
00:00:18,480 --> 00:00:19,900
هل أنتِ متأكّدة بأنّكِ بخير؟

2
00:00:20,060 --> 00:00:21,100
!أنا بخير

3
00:00:21,400 --> 00:00:23,070
!جيت-سينباي هنا

4
00:00:23,570 --> 00:00:24,650
...أجل، لكن

5
00:00:24,900 --> 00:00:27,950
إنّه مُنعزل دوماً في مُختبره

6
00:00:31,490 --> 00:00:33,330
!وبوتشيتان هنا

7
00:00:41,040 --> 00:00:43,040
كانت تفعل هذا منذ البارحة

8
00:00:43,590 --> 00:00:48,970
إنّها تستمتع بوضع الأشياء. تُساعدها
مجوهرات ماكوتو في النّموّ

9
00:00:49,130 --> 00:00:52,720
على أيّ حال، يجب أن تُسرعي
!أو ستتأخّرين عن المدرسة

10
00:00:53,890 --> 00:00:56,560
إن وقع مكروه، فاتّصلي بي عبر مُذكّرة الصّوت

11
00:00:56,720 --> 00:00:57,850
!حسناً

12
00:01:00,060 --> 00:01:01,400
!إلى اللّقاء

13
00:01:01,560 --> 00:01:03,060
!طاب يومكِ

14
00:01:14,410 --> 00:01:15,950
الأجواء هادئة جدّاً

15
00:01:20,830 --> 00:01:24,590
!لنبحث عن اللّمحة في القلب

16
00:01:24,750 --> 00:01:27,840
إلهام مُشرِق

17
00:01:28,090 --> 00:01:30,720
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

18
00:01:30,880 --> 00:01:33,510
إنّها تنادينا

19
00:01:33,680 --> 00:01:36,350
أين الحقيقة؟ ما الّذي ستكتشفه؟

20
00:01:36,510 --> 00:01:39,980
لغز تلو الآخر

21
00:01:40,770 --> 00:01:46,110
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

22
00:01:46,270 --> 00:01:51,490
كما الدّليل! شيء يلمع عبر الزّمن

23
00:01:51,650 --> 00:01:54,320
كيف؟ كيف؟ أهي خدعة؟

24
00:01:54,490 --> 00:01:57,160
لماذا؟ لماذا؟ سوف نواجهها

25
00:01:57,580 --> 00:02:02,750
لننظر ونشعر
نكتشف الأسرار

26
00:02:03,210 --> 00:02:08,710
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

27
00:02:09,050 --> 00:02:14,260
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

28
00:02:14,510 --> 00:02:19,930
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

29
00:02:20,100 --> 00:02:23,480
!لنمشِ في ذلك الطّريق معاً

30
00:02:23,640 --> 00:02:27,400
!لنبحث عن اللّمحة في القلب

31
00:02:27,610 --> 00:02:29,230
إلهام مُشرِق

32
00:02:29,400 --> 00:02:35,070
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

33
00:02:35,240 --> 00:02:40,160
ولادتنا ولقاؤنا لَهو لغز رائع

34
00:02:40,330 --> 00:02:43,790
!هيّا يا بريكيور المُتحرّيات النّجمات

35
00:02:57,590 --> 00:03:01,890
ماذا عن جواهر ماكوتو؟
لِمَ لا تذهب وتسرقها؟

36
00:03:02,060 --> 00:03:05,230
أجل. أعمل على رسم خطّة مُحكمة للحصول

37
00:03:05,690 --> 00:03:09,730
على جواهر ماكوتو الموصوفة في مُجلّد السّرابات

38
00:03:11,110 --> 00:03:14,950
أنت تفشل باستمرار يا نيجي

39
00:03:16,320 --> 00:03:20,200
إن لم تحصل على شيء، فلن
تكون لديك فُرصة ثانية

40
00:03:23,040 --> 00:03:24,330
!لاي لاي، سيّدي

41
00:03:27,420 --> 00:03:29,540
آمل أن تكون ميكورو بخير

42
00:03:29,710 --> 00:03:31,710
إنّها الآن تلميذة إعداديّة سنة ثانية

43
00:03:31,880 --> 00:03:34,590
أتساءل ما إن كانت مُتوتّرة في صفّها الجديد

44
00:03:49,310 --> 00:03:50,230
!مهلاً

45
00:03:56,490 --> 00:03:58,780
!حاولتِ حشر الكثير من الأشياء

46
00:04:02,950 --> 00:04:04,910
يبدو أنّها ستُمطر

47
00:04:05,410 --> 00:04:07,750
!لنُحضر مظلّة لميكورو

48
00:04:15,050 --> 00:04:15,880
!إنّها جاهزة

49
00:04:16,800 --> 00:04:19,590
!حِليّ بري-كيت الأسطوريّة من كتاب قديم

50
00:04:19,930 --> 00:04:20,840
أسطوريّة؟

51
00:04:21,010 --> 00:04:26,980
لا أعرف التّفاصيل، لكنّها ستُنقذ المُتحرّيات
!النّجمات بريكيور من أزمة

52
00:04:27,140 --> 00:04:28,190
!مُبهر

53
00:04:29,310 --> 00:04:30,560
هل ستخرجين؟

54
00:04:30,730 --> 00:04:33,270
أجل! سآخذ مظلّة لميكورو

55
00:04:33,900 --> 00:04:35,980
أعطي ميكورو واحداً من هذه

56
00:04:36,320 --> 00:04:37,990
!عُلِم! شكراً

57
00:04:39,030 --> 00:04:40,360
!سنكون مُتوافقين

58
00:04:43,240 --> 00:04:47,410
حتّى مُتحرّية نجمة مثل ميكورو
لا تستطيع توقُّع الطّقس

59
00:04:49,660 --> 00:04:52,000
أحضرتُ واحدة فقط لميكورو

60
00:04:53,960 --> 00:04:57,050
سآخذها قبل أن تبدأ الأمطار
!بالهطول ونسرع إلى المنزل

61
00:05:02,140 --> 00:05:04,600
هذه مدرسة ميكورو

62
00:05:07,850 --> 00:05:09,180
!ميكورو هناك

63
00:05:09,810 --> 00:05:11,060
--ميكو-
!ميكورو-

64
00:05:11,650 --> 00:05:13,440
!ري

65
00:05:13,810 --> 00:05:16,400
!نحن في نفس الصّفّ ثانية

66
00:05:16,570 --> 00:05:17,820
أنا سعيدة للغاية

67
00:05:17,980 --> 00:05:19,690
!لنقضِ عاماً جميلاً

68
00:05:20,530 --> 00:05:22,200
يبدو أنّ الأمطار ستهطل

69
00:05:22,410 --> 00:05:24,160
نسيتُ مظلّتي

70
00:05:24,320 --> 00:05:26,660
!لديّ واحدة. لنعُد إلى المنزل معاً

71
00:05:26,830 --> 00:05:27,950
!شكراً

72
00:05:29,000 --> 00:05:30,960
!يجب ألّا تنسيها يا ميكورو

73
00:05:31,120 --> 00:05:33,460
!لم أتوقّع أن تُمطر

74
00:05:38,210 --> 00:05:39,300
!أنا آسفة

75
00:05:39,630 --> 00:05:40,550
لا بأس

76
00:05:41,090 --> 00:05:43,130
أنا آسفة لأنّني لم أكن أنتبه

77
00:05:43,430 --> 00:05:44,510
بوتشي

78
00:05:44,760 --> 00:05:45,720
بوتشي؟

79
00:05:47,470 --> 00:05:51,940
!هذه الصّورة، إنّها ر-رائعة جدّاً

80
00:05:52,100 --> 00:05:54,230
...أريد واحدة مثلها أيضاً

81
00:05:55,480 --> 00:05:58,400
شكراً لكِ. إنّها أختي الصّغرى

82
00:05:58,570 --> 00:06:00,150
تبدوان مُقرّبتين

83
00:06:00,320 --> 00:06:07,030
،كيكو هي تلميذة ثانويّة سنة ثانية هنا
ضمن برنامج تبادُل في لندن

84
00:06:09,540 --> 00:06:11,120
هل حدث شيء؟

85
00:06:11,290 --> 00:06:13,710
مُؤخّراً، تحدث أمور غريبة

86
00:06:14,670 --> 00:06:17,630
يظلّ النّاس يقولون لي بأنّهم
رأوا كيكو في البلدة

87
00:06:17,790 --> 00:06:21,090
لكنّها في لندن! لا بُدّ أنّها
شخص آخر يُشبهها

88
00:06:21,260 --> 00:06:23,220
هذا ما توقّعتُه

89
00:06:23,840 --> 00:06:25,760
لكن بعدها رأيتُها

90
00:06:28,050 --> 00:06:31,430
،في هذا الصّباح، في طريقي إلى الجامعة
عند المحطّة

91
00:06:31,850 --> 00:06:36,020
تفاجأتُ، ولحقتُ بها إلى هنا

92
00:06:39,440 --> 00:06:42,530
سألتُ المدرسة وقالوا بأنّ كيكو ليست هنا

93
00:06:42,690 --> 00:06:45,740
اتّصلتُ بها في لندن فلم تردّ

94
00:06:46,160 --> 00:06:47,570
أنا قلقة فحسب

95
00:06:48,120 --> 00:06:50,330
هلّا سمحتِ لي بمُساعدتكِ؟

96
00:06:51,790 --> 00:06:52,950
!افتح

97
00:06:54,250 --> 00:06:55,460
!كتاب بري-كيت

98
00:06:56,710 --> 00:06:57,750
ماذا؟

99
00:06:59,170 --> 00:07:02,670
!أنا آنّا أكيتشي من وكالة التّحرّي كيوريتو

100
00:07:03,380 --> 00:07:06,090
أ-أنا ماريكو كيتامورا

101
00:07:08,720 --> 00:07:11,310
!ماريكو، دعي الأمر للمُتحرّية النّجمة

102
00:07:11,470 --> 00:07:14,520
!سأحرص على إغلاق ملفّ هذه القضيّة

103
00:07:14,680 --> 00:07:17,270
!عند وصف الأمر بهذه الطّريقة

104
00:07:17,850 --> 00:07:19,900
هل يمكنني استعارة تلك الصّورة؟

105
00:07:20,070 --> 00:07:20,860
!أجل

106
00:07:21,020 --> 00:07:22,480
!شكراً جزيلاً لكِ

107
00:07:23,400 --> 00:07:25,320
!يبدو أنّها ستُمطر، لذا تفضّلي

108
00:07:25,820 --> 00:07:26,950
!خذي هذه

109
00:07:27,910 --> 00:07:32,660
احتاجت ماريكو للمُساعدة، لذا
تولّيتُ القضيّة بتسرُّع

110
00:07:34,950 --> 00:07:36,920
يجب أن أخبر ميكورو

111
00:07:40,750 --> 00:07:42,840
ما كان ينبغي أن أزعجها

112
00:07:47,340 --> 00:07:48,510
ميكورو؟

113
00:07:51,100 --> 00:07:52,850
!رئيسة مجلس الطّلبة

114
00:07:53,220 --> 00:07:54,850
الرّئيسة تريدكِ

115
00:07:56,480 --> 00:07:57,640
آسفة

116
00:07:58,520 --> 00:08:00,360
آسفة لاستدعائكِ

117
00:08:00,520 --> 00:08:05,070
سمعتُ بأنّكِ تركتِ مسكنكِ الدّراسيّ
لافتتاح وكالة تحرّي

118
00:08:05,240 --> 00:08:07,400
اقتربتِ خطوة من حلمكِ

119
00:08:08,070 --> 00:08:09,700
أجل، شكراً لكِ

120
00:08:09,860 --> 00:08:14,080
على ذكر الأمر، لديّ معروف لأطلبه

121
00:08:14,830 --> 00:08:17,210
هناك قضيّة أريد منكِ أن أحلّها

122
00:08:17,830 --> 00:08:19,250
مُشكلة الشّبح

123
00:08:20,170 --> 00:08:21,040
ماذا؟

124
00:08:21,630 --> 00:08:25,920
!شـ-شبح؟

125
00:08:35,350 --> 00:08:37,770
أشعر بأنّني مُلفِتة

126
00:08:38,270 --> 00:08:39,600
!وجدتُها

127
00:08:46,650 --> 00:08:47,530
!افتح

128
00:08:50,490 --> 00:08:52,030
!مُلمّع بري-كيت

129
00:09:07,920 --> 00:09:10,510
ما رأيك بطالبة الثّانويّة آنّا أكيتشي؟

130
00:09:12,390 --> 00:09:14,350
!حسناً! حان وقت التحرِّي

131
00:09:16,720 --> 00:09:17,600
!المعذرة

132
00:09:18,930 --> 00:09:21,020
أبحث عن هذه الفتاة

133
00:09:21,190 --> 00:09:24,480
كيكو؟ إنّها في صفّي

134
00:09:27,030 --> 00:09:29,530
!مُذكّرة الصّوت بري-كيت خاصّتي

135
00:09:30,450 --> 00:09:33,490
هاتف نقّالأ؟ سيُصادرونه إذا وجدوه

136
00:09:33,660 --> 00:09:36,240
!لا، لا

137
00:09:39,750 --> 00:09:40,960
لماذا؟

138
00:09:42,080 --> 00:09:45,790
...آسفة على المُقاطعة! بخصوص كيكو

139
00:09:46,130 --> 00:09:48,710
أرسلتْ لي رسالة من لندن
في اللّيلة الماضية

140
00:09:48,880 --> 00:09:50,420
...رسالة

141
00:09:53,010 --> 00:09:55,470
سأتحرّى من تلقاء نفسي فحسب

142
00:09:59,640 --> 00:10:04,060
سيّدي، سمعتُ من الرّئيسة بأنّك رأيت شبحاً

143
00:10:04,400 --> 00:10:06,270
هلّا أخبرتني بالمزيد؟

144
00:10:06,440 --> 00:10:07,520
أجل

145
00:10:08,110 --> 00:10:13,280
في فِناء المدرسة الثّانويّة، رأيتُ
...شخصيّة غريبة لذا اقتربت

146
00:10:33,260 --> 00:10:34,840
اختفتْ

147
00:10:36,970 --> 00:10:40,010
حدث ذلك أكثر من مرّة أو مرّتين

148
00:10:44,850 --> 00:10:47,690
!سألتِني، لكنّكِ لا تستمعين

149
00:10:48,060 --> 00:10:50,940
!أكره الأشباح! لا أتحمّلها

150
00:10:51,730 --> 00:10:54,400
في النّهاية، لم أعرف شيئاً

151
00:10:55,360 --> 00:10:58,120
يا له من طقس سيّئ

152
00:11:02,950 --> 00:11:04,830
مـ-من هناك؟

153
00:11:07,670 --> 00:11:09,210
ما-ماذا؟

154
00:11:19,930 --> 00:11:21,930
!ميكورو! هذه أنا

155
00:11:26,850 --> 00:11:28,100
!آنّا

156
00:11:28,730 --> 00:11:33,150
تولّيتِ قضيّة بمفردكِ؟ لماذا لم تسأليني؟

157
00:11:33,530 --> 00:11:35,280
كنتِ في المدرسة

158
00:11:36,110 --> 00:11:38,570
لم أُرد إزعاجكِ

159
00:11:40,660 --> 00:11:45,960
تعلمين بأنّ المدرسة والتّحرّي كلاهما
مُهمّان بالنّسبة لي، صحيح؟

160
00:11:46,370 --> 00:11:51,880
،إذا حاولتِ فعلها بمفردكِ وأخطأتِ
!ستُسبّبين مُشكلة للعميل

161
00:11:53,920 --> 00:11:57,430
تكلّمي عن نفسكِ! تولّيتِ
!قضيّةً بمفردكِ أيضاً

162
00:11:57,590 --> 00:12:00,890
،اتّصلتُ بكِ عبر مُذكّرة الصّوت
لكن لم تردّي

163
00:12:01,260 --> 00:12:02,890
كنتُ أتحرّى

164
00:12:03,260 --> 00:12:07,100
إذا فشلتُ في تحقيقاتي، فستحزن ماريكو

165
00:12:07,270 --> 00:12:08,440
مَن ماريكو؟

166
00:12:08,850 --> 00:12:12,190
عميلتي. إنّها تبحث عن أختها يا كيكو

167
00:12:18,240 --> 00:12:19,240
ميكورو؟

168
00:12:19,410 --> 00:12:21,200
!آسفة، عليّ الذّهاب

169
00:12:21,660 --> 00:12:22,620
!ميكورو

170
00:12:26,500 --> 00:12:28,290
!لم ننتهِ من الكلام

171
00:12:31,130 --> 00:12:32,130
!المعذرة

172
00:12:33,380 --> 00:12:36,130
لستِ شبحاً... أليس كذلك؟-
ماذا؟-

173
00:12:36,300 --> 00:12:41,300
لا يهمّ. هل رأيتِ شيئاً غريباً
في هذه الأرجاء؟

174
00:12:41,470 --> 00:12:43,300
ليس على وجه الخصوص

175
00:12:52,480 --> 00:12:54,070
يبدو أنّها ستُمطر

176
00:12:55,020 --> 00:12:59,320
ألا يقولون عندما تُحلّق السّنونو
على علوّ مُنخفض أنّها ستُمطر؟

177
00:13:01,240 --> 00:13:02,780
...لم أُفكّر في ذلك

178
00:13:03,830 --> 00:13:06,490
!لا شيء. شكراً على مُساعدتك

179
00:13:21,090 --> 00:13:22,680
هل هي جوهرة ماكوتو؟

180
00:13:24,140 --> 00:13:25,140
!ميكورو

181
00:13:29,640 --> 00:13:32,190
!ميكورو! جوهرة ماكوتو في خطر

182
00:13:32,350 --> 00:13:33,150
ماذا؟

183
00:13:40,070 --> 00:13:42,780
!مهلاً، كيكو-
ماذا؟-

184
00:13:42,990 --> 00:13:44,990
!إنّها مَن كنتُ أبحث عنها

185
00:13:58,630 --> 00:14:00,210
كنتِ تبحثين عنها؟

186
00:14:00,380 --> 00:14:01,920
إنّها ضمن برنامج التّبادل في لندن

187
00:14:02,090 --> 00:14:05,300
،اتّصلتْ بها أختها في هذا الصّباح
لكنّها لم تردّ

188
00:14:05,970 --> 00:14:07,560
أنا لستُ كيكو

189
00:14:13,600 --> 00:14:14,690
!نيجي

190
00:14:15,810 --> 00:14:20,740
!قلتِ بأنّ كيكو في لندم. لعلّها كانت نائمة

191
00:14:20,900 --> 00:14:22,110
ماذا تقصدين؟

192
00:14:22,530 --> 00:14:28,490
إذا كانت 8 صباحاً هنا، فسيكون
!مُنتصف اللّيل في لندن في أبريل

193
00:14:28,660 --> 00:14:29,950
!هكذا إذاً

194
00:14:31,750 --> 00:14:34,670
!لو أخبرتِني فقط، لاستطعنا حلّها بسرعة

195
00:14:34,830 --> 00:14:37,750
!حاولتُ إخباركِ، لكنّكِ غادرتِ

196
00:14:38,090 --> 00:14:41,260
!ترتّب عليّ ذلك! فأنا أعمل على قضيّة أيضاً

197
00:14:44,880 --> 00:14:49,310
أحم! آمل ألّا تنفعلا كثيراً من دوني

198
00:14:49,470 --> 00:14:51,520
لِمَ تتنكّر بهيئة كيكو؟

199
00:14:51,890 --> 00:14:54,560
استخدمتُ تلميذة غائبة ضمن برنامج تبادُل

200
00:14:54,730 --> 00:14:57,150
إنّها خلف البحار

201
00:14:57,310 --> 00:15:00,360
ليس عليّ القلق بشأن مُصادفتها، صحيح؟

202
00:15:00,780 --> 00:15:03,950
كنتُ قادراً على مُعاينة هذا المكان
ليلاً نهاراً

203
00:15:04,360 --> 00:15:06,570
ماذا كنتَ تفعل؟

204
00:15:07,490 --> 00:15:09,780
أبحث عن طريقة لحمل هذا التّمثال

205
00:15:10,490 --> 00:15:14,160
حمل تمثال كبير باستخدام أدوات
مُتاحة في هذه المدينة

206
00:15:14,330 --> 00:15:16,870
ظللتُ أجري بحثاً تلو الآخر وأُفكّر

207
00:15:17,380 --> 00:15:19,040
!احذري

208
00:15:19,590 --> 00:15:23,130
في المدينة؟ ماريكو والأُخريات رأينَك

209
00:15:25,800 --> 00:15:28,760
ما زلتُ لم أكتشف كيفيّة حمله

210
00:15:30,390 --> 00:15:32,720
!لكن بعدها ساعدتِني أنتِ

211
00:15:34,480 --> 00:15:35,730
السّنونو

212
00:15:37,770 --> 00:15:39,480
!يا أكاذيب، طوّقي

213
00:15:40,610 --> 00:15:42,980
!هيّا يا هانّيندا

214
00:15:49,780 --> 00:15:52,620
!هانّيندا

215
00:15:52,910 --> 00:15:55,200
!يمكنني حملها كسنونو

216
00:15:55,370 --> 00:15:59,330
!سأحوّله إلى سنونو، وأنقله بسهولة

217
00:16:01,000 --> 00:16:01,960
!ميكورو

218
00:16:02,460 --> 00:16:03,340
!حسناً

219
00:16:07,760 --> 00:16:09,140
!افتحي

220
00:16:14,060 --> 00:16:15,730
!ساعة جوهرة كيور

221
00:16:18,480 --> 00:16:21,110
!بريكيور! وقت الاستيقاظ

222
00:16:21,270 --> 00:16:22,820
!ثلاثة! اكتشفي

223
00:16:35,910 --> 00:16:37,830
!ستّة! ومُقابل بعضيهما الآخر

224
00:16:49,970 --> 00:16:52,390
!تسعة! نحن الثّنائي الإعجازيّ

225
00:17:01,440 --> 00:17:03,270
!دوري

226
00:17:03,440 --> 00:17:05,230
!وأنهي الأمر بشكل ظريف

227
00:17:29,220 --> 00:17:34,970
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، جواب كيور

228
00:17:37,520 --> 00:17:40,810
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

229
00:17:40,980 --> 00:17:43,810
!المُتحرّية النّجمة، كيور ميستيك

230
00:17:48,190 --> 00:17:50,240
!المُتحرّية النّجمة بريكيور

231
00:17:52,700 --> 00:17:55,280
!سأُريك إجابتي

232
00:17:55,700 --> 00:18:00,830
،جوهرتا ماكوتو دُفعة واحدة
!أقتل عصفورين بحجر واحد

233
00:18:01,410 --> 00:18:06,500
لا يجوز لك ذلك! السّنونو الّتي
!تحمل البهجة هي رمز المدرسة

234
00:18:06,670 --> 00:18:09,710
!هذا التّمثال مليء بأماني التّلاميذ والمُعلّمين

235
00:18:10,760 --> 00:18:13,930
!يبدو أنّه يحمل البهجة لي أيضاً

236
00:18:14,430 --> 00:18:17,850
!هانّيندا

237
00:18:23,770 --> 00:18:25,600
!هانّيندا

238
00:18:25,770 --> 00:18:27,320
!هان! نين

239
00:18:29,980 --> 00:18:33,950
مُبهر، أليس كذلك؟ هجمة هانّيندا
مُتزامنة بشكل مثاليّ

240
00:18:34,110 --> 00:18:36,570
مُقارنة بهما، أنتما مُثيرتان للشّفقة

241
00:18:37,120 --> 00:18:39,950
أنتما خارج الإيقاع

242
00:18:41,450 --> 00:18:42,870
!هان-
!نين-

243
00:18:44,420 --> 00:18:45,620
!دا

244
00:18:52,510 --> 00:18:54,880
لستُما ندّاً لنا

245
00:18:55,680 --> 00:18:59,510
بحسب طريقة تصرّفكما، سيكون
من الأسهل لكما الهرب

246
00:19:00,350 --> 00:19:04,060
،لكن إذا هزمتُ المُتحرّيات النّجمات بريكيور

247
00:19:05,020 --> 00:19:08,020
!فأعلم بأنّ المايسترو أوسونوار سيرضى

248
00:19:08,770 --> 00:19:10,780
هل تُراقبني؟

249
00:19:11,150 --> 00:19:13,190
!المايسترو أوسونوار

250
00:19:20,530 --> 00:19:23,200
!تابعني لحضور عرض مُبهر

251
00:19:23,370 --> 00:19:24,830
!يا مايسترو أوسونوار

252
00:19:25,920 --> 00:19:27,790
!هانّيندا

253
00:19:27,960 --> 00:19:29,750
!سأستعيد التّمثال

254
00:19:29,920 --> 00:19:32,210
!سأستعيد جواهر ماكوتو

255
00:19:41,260 --> 00:19:48,230
!هذا هو جوابنا

256
00:19:52,110 --> 00:19:54,940
لا تدعاني أقولها ثانية

257
00:19:55,110 --> 00:19:57,110
أنتما خارج الإيقاع

258
00:19:57,780 --> 00:20:00,120
!هان! نين! دا

259
00:20:04,200 --> 00:20:07,750
عليكما النّزول عن المسرح

260
00:20:12,800 --> 00:20:16,010
!ستُنقذ المُتحرّيات النّجمات بريكيور من أزمة

261
00:20:23,930 --> 00:20:25,770
ما هذا؟

262
00:20:26,180 --> 00:20:27,270
!افتح

263
00:20:31,230 --> 00:20:33,980
!ماذا؟ افتح! افتح

264
00:20:34,440 --> 00:20:36,740
لكن... لماذا؟

265
00:20:37,610 --> 00:20:39,950
!هانّيندا

266
00:20:40,240 --> 00:20:44,030
!لستُما مُؤهّلتين لصعود المسرح

267
00:20:44,370 --> 00:20:46,450
!أيّتها المُتحرّيتان النّجمتان بريكيور

268
00:20:57,470 --> 00:20:59,260
!ها! هانّيندا

269
00:21:05,970 --> 00:21:07,100
بوتشيتان؟

270
00:21:07,560 --> 00:21:09,020
ما-ماذا؟

271
00:21:15,320 --> 00:21:16,440
!دا

272
00:21:18,570 --> 00:21:20,990
...هـ-هانّيندا

273
00:21:26,700 --> 00:21:28,500
...على هذا المُعدّل

274
00:21:29,040 --> 00:21:30,120
!هانّيندا

275
00:21:32,830 --> 00:21:37,760
!حصلتُ على جوهرتَي ماكوتو! هذا يكفي

276
00:21:38,170 --> 00:21:40,300
!وداعاً أيّتها المُتحرّيتان النّجمتان الجميلتان

277
00:21:45,600 --> 00:21:48,470
...جنّية الزّمان والمكان

278
00:21:52,100 --> 00:21:53,440
!بوتشيتان

279
00:22:02,490 --> 00:22:03,570
بوتشيتان

280
00:22:03,860 --> 00:22:05,030
!بوتشيتان

281
00:23:47,640 --> 00:23:48,590
...إنّ بوتشيتان

282
00:23:48,760 --> 00:23:49,680
!بوتشي

283
00:23:49,850 --> 00:23:52,680
لم نستطع حماية جواهر ماكوتو
أو تمثال السّنونو

284
00:23:52,850 --> 00:23:54,140
...رغم ذلك

285
00:23:54,310 --> 00:23:56,890
!يمكننا فعلها إذا تكاتفنا معاً

286
00:23:57,310 --> 00:24:01,110
!النّجمة المُتحرّية بريكيور
"!عدسة المرآة المُكبّرة بري-كيت الإعجازيّة"

287
00:24:01,730 --> 00:24:04,440
!وبهذا يكون قد تمّ إغلاق ملفّ كيوريتو