1
00:00:15,020 --> 00:00:20,350
جوهرة كوريا لا تزال الوحيدة الّتي
تتوهّج في دبّوس زينة نجم كيرارينغ

2
00:00:20,520 --> 00:00:24,360
،حالما تتوهّج الجواهر الثّلاثة الأُخرى
فأنا متأكّدة بأنّكِ ستحصلين على الرّنين

3
00:00:25,030 --> 00:00:27,530
لكن كيف نجعلها تتوهّج؟

4
00:00:35,700 --> 00:00:36,700
ما الأمر؟

5
00:00:37,200 --> 00:00:39,120
أشتهي الآيس كريم

6
00:00:39,290 --> 00:00:40,920
سأذهب وأشتري بعضاً. اسبقنَني

7
00:00:41,080 --> 00:00:42,210
ماذا؟

8
00:00:42,380 --> 00:00:44,250
آيس كريم في الصّباح؟

9
00:00:44,420 --> 00:00:48,510
.تعشقين الآيس كريم حقّاً
!لا تتأخّري عن حصّة النّشاط

10
00:00:53,430 --> 00:00:54,390
وبعد؟

11
00:00:54,550 --> 00:00:56,270
هل أردت منّي شيئاً؟

12
00:00:59,850 --> 00:01:01,270
شعرتِ بي

13
00:01:02,310 --> 00:01:05,610
،أجل، لبعض الوقت. على أيّ حال
ما هذا اللّباس؟

14
00:01:05,770 --> 00:01:09,070
جوهرة ماكوتو التّالية موجودة في مكانٍ ما
في المدرسة على ما أعتقد

15
00:01:09,650 --> 00:01:12,570
…تماماً! هدفي هو

16
00:01:13,070 --> 00:01:15,620
تلميذة تُدعى ميو إيواساكي

17
00:01:15,780 --> 00:01:17,120
ميو؟

18
00:01:17,290 --> 00:01:19,620
ظهرتْ في مُجلّد الأسراب

19
00:01:20,160 --> 00:01:24,330
هناك جوهرة ماكوتو في هديّة حصلتْ
عليها من حبيبها

20
00:01:26,130 --> 00:01:28,550
أنت توفّر هذه المعلومات براحة كاملة

21
00:01:28,710 --> 00:01:34,850
عندما كنتِ لصّة، كنتِ دائماً ما تتركين
بطاقة زيارة وتُقارعين المُحقِّقين

22
00:01:35,010 --> 00:01:36,310
!لذا سأفعل ذلك أيضاً

23
00:01:38,520 --> 00:01:40,350
رسالة تحدٍّ؟

24
00:01:40,520 --> 00:01:45,060
إمّا أسرق جوهرة ماكوتو، أو تحمينها

25
00:01:45,230 --> 00:01:47,320
!إنّها معركةٌ مُنصِفة

26
00:01:47,480 --> 00:01:50,610
ماذا؟ أليس لدينا رأي في هذا؟

27
00:01:50,780 --> 00:01:52,490
!أخبرتُكِ سلفاً

28
00:01:52,650 --> 00:01:55,070
!سأسحقكِ بكامل قوّتي

29
00:01:55,240 --> 00:01:56,530
حسناً

30
00:01:56,700 --> 00:01:57,530
!لولوكا؟

31
00:01:58,040 --> 00:02:00,040
!هكذا تكون المعنويّات

32
00:02:01,040 --> 00:02:02,330
سأحميها

33
00:02:07,880 --> 00:02:11,760
!لنبحث عن اللّمحة في القلب

34
00:02:11,920 --> 00:02:17,760
إلهام مُشرِق

35
00:02:17,930 --> 00:02:20,470
إنّها تنادينا

36
00:02:20,640 --> 00:02:23,390
أين الحقيقة؟ ما الّذي ستكتشفه؟

37
00:02:23,560 --> 00:02:27,150
لغز تلو الآخر

38
00:02:27,810 --> 00:02:33,200
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

39
00:02:33,360 --> 00:02:38,450
كما الدّليل! شيء يلمع عبر الزّمن

40
00:02:38,700 --> 00:02:41,370
كيف؟ كيف؟ أهي خدعة؟

41
00:02:41,540 --> 00:02:44,330
لماذا؟ لماذا؟ سوف نواجهها

42
00:02:44,620 --> 00:02:49,920
لننظر ونشعر
نكتشف الأسرار

43
00:02:50,250 --> 00:02:55,760
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

44
00:02:56,130 --> 00:03:01,310
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

45
00:03:01,640 --> 00:03:07,100
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

46
00:03:07,270 --> 00:03:10,570
!لنمشِ في ذلك الطّريق معاً

47
00:03:10,730 --> 00:03:14,490
!لنبحث عن اللّمحة في القلب

48
00:03:14,650 --> 00:03:16,320
إلهام مُشرِق

49
00:03:16,490 --> 00:03:22,120
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

50
00:03:22,290 --> 00:03:27,210
ولادتنا ولقاؤنا لَهو لغز رائع

51
00:03:27,370 --> 00:03:30,840
!هيّا يا بريكيور المُتحرّيات النّجمات

52
00:03:37,380 --> 00:03:42,010
جواب لولوكا

53
00:03:45,850 --> 00:03:46,730
!ها أنا ذي

54
00:03:53,440 --> 00:03:55,650
!رقم قياسي شخصيّ! مُمتاز

55
00:03:55,820 --> 00:03:59,360
أنتِ في القمّة! كنتِ مُفعمة بالطّاقة مؤخّراً

56
00:03:59,530 --> 00:04:01,030
رُبّما هي قوّة الحُبّ؟

57
00:04:01,200 --> 00:04:03,240
!كفّي عن ذلك

58
00:04:04,870 --> 00:04:08,540
جوهرة ماكوتو في شيء يخصّ ميو؟

59
00:04:08,710 --> 00:04:10,790
يحاول غويمون الحصول عليها

60
00:04:10,960 --> 00:04:12,630
لكن لم أخبر ميو

61
00:04:12,790 --> 00:04:14,840
لا تريدينها أن تقلق

62
00:04:15,010 --> 00:04:18,760
يبدو أنّ غويمون لم يحاول فعل
شيء أثناء الدّرس

63
00:04:18,930 --> 00:04:22,510
أنا متأكّدة بأنّه سيستهدفها عندما
تكون وحيدة، بعد الدّرس

64
00:04:22,680 --> 00:04:24,430
…في هذه الحالة

65
00:04:24,600 --> 00:04:26,980
!لنحمِ ميو جميعاً

66
00:04:27,140 --> 00:04:28,270
!لنحمِها

67
00:04:28,440 --> 00:04:29,640
!مرحى

68
00:04:32,270 --> 00:04:34,070
!حطّمتُ رقمي القياسيّ

69
00:04:34,230 --> 00:04:35,360
!هذا رائع

70
00:04:36,230 --> 00:04:39,570
!قفزاتي أفضل لأنّكِ ساعدتِني

71
00:04:40,110 --> 00:04:42,280
!هذا لأنّكِ تعملين بجدّ

72
00:04:44,280 --> 00:04:46,750
!إنّها زميلة سينباي مُؤتمنة في الفريق

73
00:04:47,410 --> 00:04:48,330
أجل

74
00:04:48,500 --> 00:04:51,960
يجب على التّلاميذ الأكبر سنّاً أن
!يُمهِّدوا الطّريق للأصغر سنّاً

75
00:04:52,130 --> 00:04:56,550
!هكذا علّمتُ لولوكا تفاصيل اللّصوصيّة الدّقيقة

76
00:04:57,960 --> 00:04:59,300
…عيناي تتحسّسان

77
00:05:01,340 --> 00:05:06,350
حسناً، لكن أين قد تكون
جوهرة ماكوتو هذه؟

78
00:05:06,520 --> 00:05:08,980
قال بأنّها هديّة من حبيبها

79
00:05:09,560 --> 00:05:13,440
قالت ميو بأنّ تاكاشي لم يعطها شيئاً

80
00:05:15,860 --> 00:05:17,230
ربّما ستحصل على واحد قريباً؟

81
00:05:17,690 --> 00:05:20,610
بالمُناسبة، عيد ميلادها في الأسبوع المُقبل

82
00:05:20,780 --> 00:05:25,830
!هديّة عيد ميلاد من تاكاشي
!لا بُدّ أنّ الأمر كذلك

83
00:05:26,620 --> 00:05:27,700
تاكاشي

84
00:05:28,450 --> 00:05:30,210
لنذهب إلى المكتبة

85
00:05:30,370 --> 00:05:33,500
آسفة، يجب عليّ الذّهاب للتسوُّق

86
00:05:33,670 --> 00:05:35,670
!حسناً، ربّما في المرّة المُقبلة

87
00:05:35,840 --> 00:05:37,750
لعلّه ذاهب لشرائها الآن

88
00:05:38,210 --> 00:05:41,800
إذاً قد يكون تاكاشي هو الهدف

89
00:05:41,970 --> 00:05:44,180
!ها هي ذي! موريا-سينباي

90
00:05:46,180 --> 00:05:48,010
!سمعنا عنك

91
00:05:48,180 --> 00:05:50,270
!مُتحرّية الحُبّ

92
00:05:50,430 --> 00:05:53,100
!حُلّي مشاكلنا في الحُبّ

93
00:05:53,600 --> 00:05:54,440
ماذا؟

94
00:05:54,600 --> 00:05:58,480
الإشاعات عن لولوكا مُنتشرة في
كلّ أرجاء المدرسة

95
00:05:58,650 --> 00:06:00,110
سأتعامل مع هذا

96
00:06:00,900 --> 00:06:02,950
!اتبعنَ حبيبها

97
00:06:03,110 --> 00:06:05,200
حسناً-
!هيّا بنا-

98
00:06:20,840 --> 00:06:22,800
،وفقاً لمُلاحظاتي

99
00:06:23,340 --> 00:06:25,260
…من أجل إيجاد الحُبّ

100
00:06:26,760 --> 00:06:28,470
استعيري كتاباً من المكتبة

101
00:06:29,010 --> 00:06:30,680
غيّري تسريحة شعركِ

102
00:06:30,850 --> 00:06:33,640
تعالي إلى المدرسة وخبز في فمكِ

103
00:06:34,140 --> 00:06:35,100
خبز؟

104
00:06:35,270 --> 00:06:37,560
!سنُجرّب ذلك

105
00:06:38,320 --> 00:06:41,230
!أنا التّالية-
!ثمّ أنا! أنا-

106
00:06:42,900 --> 00:06:46,410
أركانا تلك؟ محبوبة ومُوقَّرة بواسطة
نظيراتها الأصغر سنّاً؟

107
00:06:46,570 --> 00:06:49,120
!لقد نضجتْ كثيراً حقّاً

108
00:06:49,280 --> 00:06:50,910
من هذا؟

109
00:06:53,290 --> 00:06:56,080
قرأتُ الكثير من البخوت، وأنا مُرهقة الآن

110
00:06:56,250 --> 00:06:58,130
شكراً لك يا ماشوتان

111
00:07:04,970 --> 00:07:06,090
لولوكا؟

112
00:07:07,340 --> 00:07:09,100
هل تُمانعين أن نذهب إلى المنزل معاً؟

113
00:07:11,140 --> 00:07:13,810
ألن تبتعدي عن طريقكِ هكذا؟

114
00:07:13,980 --> 00:07:17,440
لا مُشكلة، فثمّة محلّ آيس كريم
لذيذ في الطّريق

115
00:07:18,100 --> 00:07:20,900
ماذا؟ إذاً، لنذهب معاً في وقت لاحق

116
00:07:21,360 --> 00:07:22,280
أجل

117
00:07:24,740 --> 00:07:27,070
تهانينا رقمكِ القياسيّ الشّخصيّ

118
00:07:27,240 --> 00:07:30,200
ماذا؟ هل رأيتِني في التّمرين؟

119
00:07:30,370 --> 00:07:32,990
أنا في قمّة أدائي مؤخّراً

120
00:07:33,160 --> 00:07:34,830
بفضل تاكاشي؟

121
00:07:35,120 --> 00:07:37,290
!ماذا؟ مُمكن

122
00:07:37,460 --> 00:07:39,380
لا بُدّ أنّكِ مُتحمِّسة لهديّتكِ

123
00:07:40,090 --> 00:07:41,040
هديّة؟

124
00:07:41,210 --> 00:07:43,460
إنّه عيد ميلادكِ في الأسبوع المُقبل، صحيح؟

125
00:07:49,430 --> 00:07:50,890
إنّه هذا

126
00:07:51,050 --> 00:07:52,720
هذه هي الهديّة إذاً

127
00:07:53,100 --> 00:07:53,890
ماذا؟

128
00:07:54,350 --> 00:07:55,390
هووا؟

129
00:07:55,560 --> 00:07:59,020
لا بُدّ أنّها هديّة عيد ميلاد ميو

130
00:07:59,190 --> 00:08:00,860
هل هي أغنية تحبّها ميو؟

131
00:08:01,020 --> 00:08:03,570
أم أغنية رومانسيّة تريدها أن تسمعها؟

132
00:08:03,730 --> 00:08:06,570
!تفصح لها عن مشاعرك من خلال الغناء

133
00:08:06,740 --> 00:08:09,110
!هذا رومانسيّ جدّاً

134
00:08:09,280 --> 00:08:11,450
لا، هذه ليست هديّة

135
00:08:15,620 --> 00:08:19,960
أخبرتُ تاكاشي بأنّني لا أحتاج هديّة

136
00:08:20,460 --> 00:08:21,540
لماذا؟

137
00:08:21,710 --> 00:08:25,710
أنا سعيدة بمُجرّد التّواجد معه

138
00:08:26,300 --> 00:08:29,720
على أيّ حال، منحَني ما يكفي

139
00:08:32,260 --> 00:08:34,470
كان كلاماً غريباً

140
00:08:34,640 --> 00:08:36,890
!على أيّ حال، أراكِ غداً

141
00:08:40,060 --> 00:08:40,900
هكذا إذاً

142
00:08:42,230 --> 00:08:43,400
سمعتَ ذلك، صحيح؟

143
00:08:43,570 --> 00:08:47,610
لا تملك أي هديّة. ولا تنوي الحصول
على أيّ هديّة

144
00:08:48,400 --> 00:08:50,160
أشكّ في صحّة ذلك

145
00:08:52,700 --> 00:08:53,870
ماذا؟

146
00:08:55,910 --> 00:08:58,620
.آسف أيّتها الآنسة الصّغيرة
!استمتعي بعلاقتكِ الرّومانسيّة

147
00:09:03,250 --> 00:09:04,380
!أعدها

148
00:09:07,460 --> 00:09:09,220
استطاعت اللّحاق بي

149
00:09:09,380 --> 00:09:10,470
…في هذه الحالة

150
00:09:13,180 --> 00:09:15,100
!أيّتها الأكاذيب، طوّقي

151
00:09:16,060 --> 00:09:18,980
!تعال يا هانّيندا

152
00:09:24,860 --> 00:09:27,980
!هانّيندا

153
00:09:29,650 --> 00:09:30,780
!افتحي

154
00:09:39,410 --> 00:09:41,370
!عصا أركانا المُنيرة

155
00:09:45,250 --> 00:09:47,500
!بريكيور! حان وقت الاستيقاظ

156
00:09:50,510 --> 00:09:53,010
المعي أيّتها الزّنبقة البيضاء

157
00:10:01,810 --> 00:10:03,140
!صنبور الزّهور

158
00:10:23,710 --> 00:10:30,920
،الضّوء الأبيض الّذي يُنير الحقيقة
!المُتحرّية النّجمة كيور أركانا

159
00:10:36,220 --> 00:10:38,560
!سأُريك إجابتي

160
00:10:57,990 --> 00:10:59,950
أنتِ بارعة. تحرٍّ ممتاز

161
00:11:00,120 --> 00:11:03,660
تحرٍّ؟ هذا ليس ما يفعله اللّصوص

162
00:11:03,830 --> 00:11:06,460
كان ذلك واضحاً في وجهك

163
00:11:06,620 --> 00:11:09,250
استطعتُ تمييز ذلك من ردّة فعلك

164
00:11:09,420 --> 00:11:11,800
فأنتِ زميلتي الكوهاي

165
00:11:11,960 --> 00:11:14,800
لا، أنتِ مُنافِستي الأبديّة

166
00:11:14,970 --> 00:11:16,220
مُنافِسة؟

167
00:11:16,720 --> 00:11:18,260
تحتاج مئة عام لتُنافسها

168
00:11:19,430 --> 00:11:22,310
!هانّيندا

169
00:11:23,730 --> 00:11:28,610
…لستُ أفهم. إن لم تكن المرآة هديّة، فإذاً

170
00:11:28,770 --> 00:11:31,730
لماذا كين يوجد جوهرة ماكوتو فيها؟

171
00:11:33,230 --> 00:11:36,280
عكستْ ذاتها الجديدة

172
00:11:37,030 --> 00:11:43,410
منذ بدأتْ بمُواعدة تاكاشي، أنا متأكّدة
بأنّ ميو رأتْ نسخةً مُضيئة من نفسها

173
00:11:44,160 --> 00:11:47,120
إذاً تلك هي "الهديّة" من حبيبها

174
00:11:47,290 --> 00:11:48,960
أحسنت صنعاً في كشفها

175
00:11:49,710 --> 00:11:50,790
…أنا

176
00:11:51,340 --> 00:11:52,500
مثلها

177
00:11:55,970 --> 00:11:57,130
!أركانا

178
00:11:58,180 --> 00:11:59,300
هل أنتِ بخير؟

179
00:11:59,930 --> 00:12:01,050
هكذا إذاً

180
00:12:01,430 --> 00:12:04,020
أنتِ مُضيئة الآن أيضاً

181
00:12:10,520 --> 00:12:11,480
!افتح

182
00:12:17,400 --> 00:12:19,570
عطر لولب الزّنبق

183
00:12:22,280 --> 00:12:24,740
!بريكيور! حان وقت الاستيقاظ

184
00:12:25,370 --> 00:12:26,660
الدّوران الورديّ

185
00:12:42,850 --> 00:12:43,930
!تفتّحي

186
00:13:06,700 --> 00:13:07,830
!استيقظي

187
00:13:08,370 --> 00:13:14,130
عطر الحقيقة الدّاخليّة، المُتحرّية
!النّجمة كيور إكلير

188
00:13:21,050 --> 00:13:22,050
!افتحي

189
00:13:27,100 --> 00:13:28,930
!ساعة جوهرة كيور

190
00:13:31,690 --> 00:13:34,310
!بريكيور! حان وقت الاستيقاظ

191
00:13:34,480 --> 00:13:36,020
!ثلاثة! اكتشفي

192
00:13:49,160 --> 00:13:50,790
!ستّة! وواجها بعضيكما الآخر

193
00:14:02,880 --> 00:14:05,390
!تسعة! نحن الثّنائي الإعجازيّ

194
00:14:14,650 --> 00:14:16,150
!دوري

195
00:14:16,690 --> 00:14:18,440
!وانتهي بشكل ظريف

196
00:14:42,630 --> 00:14:45,470
!إغلاق قضيّة أيّ لغز

197
00:14:45,590 --> 00:14:48,390
!المُتحرّية النّجمة، أنسر كيور

198
00:14:50,770 --> 00:14:53,980
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

199
00:14:54,140 --> 00:14:57,440
!المُتحرّية النّجمة، كيور ميستيك

200
00:15:01,230 --> 00:15:03,400
!المُتحرّية النّجمة بريكيور

201
00:15:05,530 --> 00:15:07,740
!هانّيندا

202
00:15:07,910 --> 00:15:09,200
!لست ندّاً لنا

203
00:15:10,080 --> 00:15:12,370
دعنَ هذا لي

204
00:15:12,830 --> 00:15:13,960
…لـ-لكن

205
00:15:14,120 --> 00:15:16,830
!أنتِ تواجهين هانّيندا أكثر قوّة

206
00:15:17,460 --> 00:15:18,540
من فضلكن

207
00:15:20,380 --> 00:15:21,710
حسناً، عُلِم

208
00:15:24,420 --> 00:15:27,090
!هانّيندا

209
00:15:31,850 --> 00:15:33,850
!لا أعرف كيف هو الشّعور

210
00:15:35,480 --> 00:15:42,150
،أنتِ بشريّة، لكن يسرّني بأنّكِ قبلتِني أنا
فرد من العِرق المنسيّ

211
00:15:43,900 --> 00:15:48,200
!لكن يجب عليّ سحقكِ الآن

212
00:15:49,950 --> 00:15:53,790
.عدم الاعتراف بوجودك. أعرف كم هو شعور سيّئ

213
00:15:56,080 --> 00:15:58,330
حدث ذلك معي أيضاً

214
00:16:00,210 --> 00:16:02,550
،لكن مهما حدث

215
00:16:02,710 --> 00:16:05,470
لا يوجد سببٌ وجيه لأذيّة شخص

216
00:16:05,630 --> 00:16:07,510
!لقد تغيّرت

217
00:16:08,130 --> 00:16:10,430
!تقدّمتُ خطوةً جديدة للأمام

218
00:16:10,600 --> 00:16:13,350
!ما زلتِ لا تفهمين تماماً

219
00:16:13,850 --> 00:16:15,850
!هان

220
00:16:24,650 --> 00:16:26,150
!عصا أركانا المُنيرة

221
00:16:32,780 --> 00:16:34,540
!هان! نين! دا

222
00:16:37,660 --> 00:16:38,960
!أركانا

223
00:16:41,580 --> 00:16:45,760
هجماتك أقوى، لكن ما زالت غير كافية

224
00:16:45,920 --> 00:16:47,630
!تبدين أبطأ

225
00:16:48,300 --> 00:16:49,590
انظري يا أركانا

226
00:16:50,130 --> 00:16:54,560
من المُؤكَّد أنّكِ تغيّرتِ. لا بُدّ
أنّكِ تبدين مُنيرة الآن

227
00:16:55,060 --> 00:16:57,680
لكن هذا خارجيّ فقط

228
00:16:57,850 --> 00:17:00,520
هذا أنتِ، لكن ليس ذاتكِ الحقيقيّة

229
00:17:00,690 --> 00:17:04,230
ذاتكِ السّابقة غير معكوسة هناك

230
00:17:05,400 --> 00:17:07,440
أعلم ذلك

231
00:17:09,950 --> 00:17:12,990
وأعرف سبب إعادتك هذا لي

232
00:17:13,160 --> 00:17:15,700
!حسناً إذاً، أريني

233
00:17:25,880 --> 00:17:28,170
لم أنسَ ماضيّي

234
00:17:28,340 --> 00:17:31,050
أنا أحمله معي هنا

235
00:17:36,760 --> 00:17:38,350
!هذا هو أنا أيضاً

236
00:17:38,520 --> 00:17:40,560
!كيور أركانا شادو

237
00:17:42,440 --> 00:17:44,480
أجل، ممتاز

238
00:17:47,570 --> 00:17:50,860
!تلك النّظرة تلائمكِ حقّاً

239
00:17:51,360 --> 00:17:55,370
ارتكبتُ كثيراً من الأخطاء بهذا الشّكل

240
00:17:55,530 --> 00:17:58,200
أذيتُ كوريا وآخرين كُثُر

241
00:17:58,370 --> 00:18:02,670
هل تقصدين بأنّ أركانا شادو
كان الخيار الخطأ؟

242
00:18:02,830 --> 00:18:03,870
!لا

243
00:18:06,790 --> 00:18:09,420
!كُلّ ما لديّ الآن سببه ماضيّي

244
00:18:12,930 --> 00:18:14,010
!دا

245
00:18:14,180 --> 00:18:15,850
!ها! هانّيندا

246
00:18:16,470 --> 00:18:20,680
لذا أقبلها. أخطائي السّابقة وحسراتي أيضاً

247
00:18:20,850 --> 00:18:22,940
!وقِوى أركانا شادو خاصّتي

248
00:18:24,560 --> 00:18:25,440
…نور

249
00:18:26,020 --> 00:18:27,190
وظلّ

250
00:18:27,690 --> 00:18:29,360
هاتان الذّاتان

251
00:18:29,530 --> 00:18:31,650
!تُرشدانني من المتاهة إلى الحقيقة

252
00:18:33,070 --> 00:18:34,860
نور وظلّ؟

253
00:18:38,990 --> 00:18:40,450
!أضيئت

254
00:18:53,260 --> 00:18:55,760
!شُعاع غُبار أركانا النّجميّ

255
00:18:58,350 --> 00:19:02,600
!هانّين! دا

256
00:19:03,730 --> 00:19:05,310
!…إ-إنّها

257
00:19:10,190 --> 00:19:12,230
لنحسم هذا

258
00:19:20,330 --> 00:19:21,240
!ماشوتان

259
00:19:24,210 --> 00:19:25,250
جوهرة ماكوتو

260
00:19:30,130 --> 00:19:32,000
كيور أركانا ستُغلق هذه القضيّة

261
00:19:37,930 --> 00:19:39,970
!هذه هي إجابتي

262
00:19:41,310 --> 00:19:45,390
!بريكيور! الزّنبقة البيضاء أركانا

263
00:19:57,990 --> 00:19:59,660
تمّ إغلاق ملفّ القضيّة كيوريتّو

264
00:20:00,200 --> 00:20:04,830
!هان! نين! دا

265
00:20:14,090 --> 00:20:16,920
!بوتشي بوتشي كيور كيور

266
00:20:22,930 --> 00:20:25,600
قوّة دبّوس نجم كيرارينغ

267
00:20:25,770 --> 00:20:27,560
نور وظلّ

268
00:20:27,730 --> 00:20:30,350
كان ذلك أكثر ممّا تخيّلت يا كيور أركانا

269
00:20:30,940 --> 00:20:32,520
سأقبل الخسارة هذه المرّة

270
00:20:33,020 --> 00:20:38,860
.التقيتُ بمايسترو أوسونوار أوّلاً
أنا مُمتنّ له بشكل كبير

271
00:20:39,990 --> 00:20:42,700
أعتقد بأنّ الظّروف الّتي التقينا
بها فيها كانت سيّئة فحسب

272
00:20:44,990 --> 00:20:46,250
غويمون

273
00:21:05,470 --> 00:21:07,600
أتيتُن لتشجيعي؟

274
00:21:10,730 --> 00:21:16,530
أتيتُ إلى وكالة التحرّي كيوريتّو لأنّني
سمعتُ بوجود بريكيور هناك

275
00:21:17,650 --> 00:21:26,240
،أردتُ التحرّي مع زميلة بريكيور سينباي
لذا يسرّني أنّكِ هنا

276
00:21:27,370 --> 00:21:30,660
لماذا تقولين ذلك الآن؟ لماذا انتظرتِ؟

277
00:21:31,170 --> 00:21:32,370
…لأنّ

278
00:21:32,540 --> 00:21:36,130
يُبقَى وجود البريكيور طيّ الكتمان عن العالم

279
00:21:36,300 --> 00:21:41,130
لم تريدي من أحد أن يتحرّى حول
سبب معرفتكِ بأمرهم

280
00:21:44,220 --> 00:21:47,810
لكلّ شخص سرّ أو أكثر لا يحبّ الحديث عنه

281
00:21:48,390 --> 00:21:49,390
،بالإضافة إلى ذلك

282
00:21:49,810 --> 00:21:52,440
أليست الفتيات رائعات إذا كان لديهن سرّ؟

283
00:21:52,600 --> 00:21:53,770
…لولوكا

284
00:21:54,270 --> 00:21:57,190
يسرّني وجود زميلة كوهاي ظريفة مثلكِ أيضاً

285
00:21:58,780 --> 00:22:00,650
!سينباي

286
00:22:01,030 --> 00:22:05,200
!سينباي! سينباي! لولوكا-سينباي

287
00:22:05,370 --> 00:22:06,330
أنتِ قريبة جدّاً

288
00:22:10,410 --> 00:22:12,160
!قلتُ  بأنّكِ قريبة جدّاً

289
00:23:47,090 --> 00:23:49,010
!تلك الدرّاجة… إنّها المُديرة مافورو

290
00:23:49,180 --> 00:23:51,220
!الأجواء حيويّة جدّاً هنا مع المُديرة مافورو

291
00:23:51,390 --> 00:23:52,930
ميكورو… غريبة أطوار

292
00:23:53,100 --> 00:23:55,680
ما الأمر؟ لا تُخفي شيئاً

293
00:23:55,850 --> 00:23:58,480
آنّا، ماذا تعرفين عنّي؟

294
00:23:59,440 --> 00:24:02,440
!المُتحرِّية النّجمة بريكيور
"جواب ميكورو"

295
00:24:02,610 --> 00:24:04,690
!أغلِقَ ملفّ قضيّة اللّغز كيوريتّو