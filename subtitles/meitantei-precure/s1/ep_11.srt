1
00:00:20,900 --> 00:00:23,400
!المزاد التّالي لديه أشياء جميلة كهذه

2
00:00:23,570 --> 00:00:25,900
!هذا يُشوِّق هاوي التّجميع الخاصّ بي

3
00:00:36,410 --> 00:00:38,500
ما-ما هذا؟

4
00:00:39,120 --> 00:00:43,920
،غداً على 8 مساء
سأسرق أميرة ضوء النّجم

5
00:00:44,090 --> 00:00:46,380
"نقابة لصوص الشّبح

6
00:00:46,550 --> 00:00:50,300
!نـ-نـ-نقابة لصوص الشّبح؟

7
00:00:56,270 --> 00:00:59,730
بطاقة زيارة. هذا أنيق جدّاً، لولوكا

8
00:01:03,860 --> 00:01:07,190
في الأمس، تشينامي هوشو، مالكة
متحف هوشو للفنون

9
00:01:07,360 --> 00:01:11,110
تلقّتْ بطاقة زيارة من نقابة لصوص الشّبح

10
00:01:11,280 --> 00:01:12,160
ماذا؟

11
00:01:12,320 --> 00:01:13,450
،محتوى بطاقة الزّيارة

12
00:01:13,620 --> 00:01:18,120
،غداً على 8 مساء"
"سأسرق أميرة ضوء النّجم

13
00:01:18,290 --> 00:01:20,120
...عزّز المتحف الحِراسة

14
00:01:20,290 --> 00:01:22,120
!آنّا! انظري إلى هذا

15
00:01:22,290 --> 00:01:25,130
!أجل. ميكورو، بوتشيتان

16
00:01:25,920 --> 00:01:27,420
!لنذهب إلى المتحف

17
00:01:27,590 --> 00:01:28,710
!أجل

18
00:01:33,840 --> 00:01:37,600
!لنبحث عن اللّمحة في القلب

19
00:01:37,760 --> 00:01:40,850
إلهام مُشرِق

20
00:01:41,100 --> 00:01:43,730
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

21
00:01:43,900 --> 00:01:46,520
إنّها تنادينا

22
00:01:46,690 --> 00:01:49,360
أين الحقيقة؟ ما الّذي ستكتشفه؟

23
00:01:49,530 --> 00:01:52,990
لغز تلو الآخر

24
00:01:53,780 --> 00:01:59,120
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

25
00:01:59,290 --> 00:02:04,500
كما الدّليل! شيء يلمع عبر الزّمن

26
00:02:04,670 --> 00:02:07,340
كيف؟ كيف؟ أهي خدعة؟

27
00:02:07,500 --> 00:02:10,170
لماذا؟ لماذا؟ سوف نواجهها

28
00:02:10,590 --> 00:02:15,760
لننظر ونشعر
نكتشف الأسرار

29
00:02:16,220 --> 00:02:21,730
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

30
00:02:22,060 --> 00:02:27,270
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

31
00:02:27,520 --> 00:02:32,940
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

32
00:02:33,110 --> 00:02:36,490
!لنمشِ في ذلك الطّريق معاً

33
00:02:36,660 --> 00:02:40,410
!لنبحث عن اللّمحة في القلب

34
00:02:40,620 --> 00:02:42,250
إلهام مُشرِق

35
00:02:42,410 --> 00:02:48,090
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

36
00:02:48,250 --> 00:02:53,170
ولادتنا ولقاؤنا لَهو لغز رائع

37
00:02:53,340 --> 00:02:56,800
!هيّا يا بريكيور المُتحرّيات النّجمات

38
00:03:11,110 --> 00:03:15,900
أركانا شادو... إنّ ترك بطاقة
!زيارة هو أمر سيّئ

39
00:03:16,070 --> 00:03:19,870
لا بأس على ما أعتقد. إنّها
مُتحمّسة بشأن عملها الأوّل

40
00:03:20,030 --> 00:03:22,080
ماذا؟ عمّاذا تتكلّم؟

41
00:03:23,080 --> 00:03:24,500
...بطاقة زيارة

42
00:03:25,710 --> 00:03:28,000
قد يكون هذا مُسلّياً

43
00:03:35,720 --> 00:03:36,930
مُتحرّيتان؟

44
00:03:37,090 --> 00:03:40,300
أجل... تريدان حماية العِقد من اللّصوص

45
00:03:41,260 --> 00:03:44,770
!بطاقة الزّيارة هي أشبه بتحدٍّ للمُحقّقين

46
00:03:45,390 --> 00:03:47,100
!سوف نحبط مُخطّطاتهم

47
00:03:47,270 --> 00:03:47,980
!أجل

48
00:03:48,150 --> 00:03:51,940
ترتدي بوتشيتان زيّ ميستيك الخاصّ
!بها، وهي جاهزة

49
00:03:56,530 --> 00:03:59,280
هاتان الطّفلتان مُتحرّيتان؟

50
00:04:01,490 --> 00:04:02,780
...يا إلهي

51
00:04:06,080 --> 00:04:07,080
!انظري

52
00:04:07,870 --> 00:04:10,210
إنّها المالكة الّتي رأيناها عبر التّلفزيون

53
00:04:10,380 --> 00:04:11,420
!سيّدة هوشو

54
00:04:11,590 --> 00:04:15,880
سررتُ بلقائكِ! اسمي ميكورو كوباياشي
!من وكالة كيوريتو للتحرّي

55
00:04:16,050 --> 00:04:17,340
اسمي آنّا أكيتشي

56
00:04:20,090 --> 00:04:23,260
!يا لها من حقيبة ظريفة

57
00:04:23,430 --> 00:04:25,810
!هذه الزّركشات لا تُقاوم

58
00:04:26,810 --> 00:04:29,190
هلّا بعتِها لي؟-
!ماذا؟-

59
00:04:29,600 --> 00:04:31,900
!لا! إنّها صديقتي

60
00:04:32,060 --> 00:04:36,610
إن فعلتِ، فسأدعكِ تحرسين
أميرة ضوء النّجم. اتّفقنا؟

61
00:04:37,030 --> 00:04:39,150
لـ-لا يمكنك الحصول على بوتشيتان

62
00:04:39,320 --> 00:04:41,740
!لكن دعي أميرة ضوء النّجم علينا

63
00:04:41,910 --> 00:04:43,070
!سوف نحميها

64
00:04:44,580 --> 00:04:46,750
إن غيّرتِ رأيكِ، أبلغيني

65
00:04:52,420 --> 00:04:53,710
!مُذهل

66
00:04:53,880 --> 00:04:57,170
جمعتُ هذه المجموعة من كافّة أنحاء العالم

67
00:04:57,340 --> 00:04:59,420
أتى الجميع لرؤية ذلك

68
00:05:00,220 --> 00:05:01,260
وهذا

69
00:05:02,550 --> 00:05:05,350
هذه هي أميرة ضوء النّجم

70
00:05:06,970 --> 00:05:09,310
!إنّها جميلة جدّاً

71
00:05:09,480 --> 00:05:12,060
إنّه عِقد بارز تاريخيّاً

72
00:05:12,230 --> 00:05:14,360
قيمته لا تقلّ عن 2 مليار ين

73
00:05:14,520 --> 00:05:17,150
!ماذا-
مـ-ملياران؟-

74
00:05:18,320 --> 00:05:21,150
إذاً هذا هو العِقد الّذي تستهدفه
!نقابة لصوص الشّبح

75
00:05:21,320 --> 00:05:23,910
!إنّها لامعة وجميلة جدّاً يا عزيزي

76
00:05:24,070 --> 00:05:26,990
!عزيزتي، أنتِ أكثر لمعاناً حتّى في نظري

77
00:05:30,580 --> 00:05:33,710
هل نقابة اللّصوص هذه جادّة حقّاً؟

78
00:05:33,880 --> 00:05:36,250
هل يُعقَل أن تكون إشاعة مثل
تنبُّؤات نوستراداموس؟

79
00:05:36,420 --> 00:05:38,590
لقد سمعتُ عنهم

80
00:05:38,760 --> 00:05:41,590
ظهروا في قاعة زفاف ومتجر كعك

81
00:05:42,180 --> 00:05:44,760
!حللنا هذه القضايا

82
00:05:44,930 --> 00:05:46,760
حقّاً؟

83
00:05:46,930 --> 00:05:49,520
!أجل! أنا لا أكذب أبداً

84
00:05:49,680 --> 00:05:51,980
!سنحلّ هذه القضيّة أيضاً

85
00:05:52,140 --> 00:05:55,610
!ليس عليكما إقحام نفسيكما. هيّا

86
00:05:56,820 --> 00:05:57,940
!ماذا؟

87
00:05:58,110 --> 00:06:01,400
لدى متحف الفنون الخاص بي حُرّاس نخبة

88
00:06:01,570 --> 00:06:04,450
!لدينا كاميرات مُراقبة تعمل 24 ساعة في اليوم

89
00:06:05,070 --> 00:06:08,240
!العلبة مصنوعة من زُجاج خاصّ فائق المتانة

90
00:06:08,830 --> 00:06:11,960
!حتّى لو وقفَ عليه فيل، لن ينكسر

91
00:06:12,790 --> 00:06:13,920
!مُذهل

92
00:06:14,080 --> 00:06:16,130
!ورقتنا الرّابحة هي هذه الآلة

93
00:06:16,670 --> 00:06:19,670
!الكاميرا تقرأ وجهي وتفتح العلبة

94
00:06:19,840 --> 00:06:21,840
!الأحدث في الأجهزة الأمنيّة عالية الجودة

95
00:06:22,010 --> 00:06:24,130
!التعرُّف على الوجه

96
00:06:24,300 --> 00:06:25,470
تعرفينها؟

97
00:06:25,640 --> 00:06:27,220
!تستخدمها الهواتف الذّكيّة أيضاً

98
00:06:27,390 --> 00:06:28,310
هواتف ذكيّة؟

99
00:06:28,470 --> 00:06:30,560
!لا تُمانعيها

100
00:06:30,720 --> 00:06:34,270
!على أيّ حال، فهمتُما الآن بأنّه لا حاجة لكما

101
00:06:34,440 --> 00:06:37,940
!إذا قرّرتُما إعطائي الحقيبة، فأبلغاني

102
00:06:43,900 --> 00:06:47,740
تريدها اللّصوص الشّبح، ما يعني بأنّها
تحتوي على جوهرة ماكوتو، صحيح؟

103
00:06:47,910 --> 00:06:48,830
بكلّ تأكيد

104
00:06:49,490 --> 00:06:53,500
.ورد في البطاقة السّاعة 8 مساء
!لنجرِ مسحاً للمتحف إلى ذلك الحين

105
00:06:53,660 --> 00:06:54,460
!حسناً

106
00:06:58,130 --> 00:07:01,420
أكثر من عشر كاميرات عند المداخل والمخارج

107
00:07:01,880 --> 00:07:04,840
الكثير من الصّحفيّين، بسبب بطاقة الزّيارة

108
00:07:06,760 --> 00:07:07,640
!حسناً

109
00:07:11,970 --> 00:07:13,480
إنّه مشهور جدّاً

110
00:07:17,310 --> 00:07:18,520
ذلك العِقد

111
00:07:18,980 --> 00:07:21,020
أجل، صحيح

112
00:07:21,190 --> 00:07:24,240
اللّصوص الشّبح يريدونه، لذا هذا وارد في الأخبار

113
00:07:24,400 --> 00:07:27,200
انظري، أليس هذا جميلاً؟-
!جميل-

114
00:07:27,950 --> 00:07:33,410
،هذا ليس كلّ شيء. حتّى قبل الفوضى
كثير من النّاس أحبّوا العِقد

115
00:07:33,950 --> 00:07:37,120
ما الّذي يجذبهم إليه؟

116
00:07:37,420 --> 00:07:40,130
لا أعلم بصراحة

117
00:07:40,290 --> 00:07:44,710
أعتقد بأنّ مشاعر الجميع تشابكت
!معاً وجعلتها تتلألأ

118
00:07:48,340 --> 00:07:49,550
!آنّا

119
00:07:50,300 --> 00:07:51,300
!ميكورو

120
00:07:51,760 --> 00:07:52,810
!المعذرة

121
00:07:54,390 --> 00:07:56,980
بالتّوفيق... أيّتها المُتحرّية النّجمة

122
00:07:57,140 --> 00:07:57,940
ماذا؟

123
00:08:09,530 --> 00:08:12,330
عشر دقائق حتّى الوقت المُعلَن

124
00:08:12,870 --> 00:08:16,160
سيّدة هوشو، هذا خطير. لا أعتقد
...بأنّكِ ينبغي أن

125
00:08:16,330 --> 00:08:19,790
!لا، هذا هو أكثر الأماكن أمناً. هيّا

126
00:08:20,460 --> 00:08:21,670
!مهلاً

127
00:08:25,760 --> 00:08:26,880
!حسناً

128
00:08:27,470 --> 00:08:30,220
!قبل أن نبدأ، سأقرأ بختك

129
00:08:39,190 --> 00:08:40,150
!إنّي أراه

130
00:08:40,310 --> 00:08:44,610
!لولوكا، سيعترض دخيل طريقكِ

131
00:08:45,440 --> 00:08:49,110
شكراً لك. غالباً ما تتحقّق قراءة البخت خاصّتك

132
00:08:49,280 --> 00:08:50,320
...لكن

133
00:08:52,570 --> 00:08:54,530
أنا لا أفشل أبداً

134
00:08:55,370 --> 00:08:56,450
افتح

135
00:09:00,040 --> 00:09:01,580
مُلمِّع بري-كيت

136
00:09:13,010 --> 00:09:14,680
هيّا بنا يا ماشوتان

137
00:09:14,850 --> 00:09:18,220
!دعي الأمر لي يا لولوكا! ابدئي المهمّة

138
00:09:26,610 --> 00:09:30,950
سأذهب إلى الغرفة الكهربائيّة وأقطع
الكهرباء عن المتحف في تمام الثّامنة مساء

139
00:09:31,110 --> 00:09:32,490
سيكون الظّلام حالكاً

140
00:09:33,530 --> 00:09:34,820
!ها هي

141
00:09:38,700 --> 00:09:41,330
!إنّه قاسٍ جدّاً لدرجة لا أستطيع فتحه

142
00:09:42,290 --> 00:09:43,080
!يا للهول

143
00:09:48,300 --> 00:09:49,630
حيوان محشو؟

144
00:09:49,800 --> 00:09:52,970
!التقطَني! أنا ظريفة جدّاً فحسب

145
00:09:53,130 --> 00:09:54,340
لا بُدّ أنّها أداة مفقودة

146
00:09:56,010 --> 00:09:57,560
!بقي دقيقة واحدة

147
00:10:00,020 --> 00:10:01,230
!الآن هي فُرصتي

148
00:10:02,600 --> 00:10:04,150
عشر ثوانٍ

149
00:10:04,310 --> 00:10:13,400
9, 8, 7, 6, 5, 4, 3, 2, 1

150
00:10:08,570 --> 00:10:10,400
زرّ الطّاقة الرّئيسيّ

151
00:10:16,240 --> 00:10:18,030
!انقطع التيّار-
!يا إلهي-

152
00:10:18,200 --> 00:10:20,120
!ستعمل الطّاقة الاحتياطيّة قريباً

153
00:10:22,620 --> 00:10:24,290
مهلاً! ما هذا؟

154
00:10:24,830 --> 00:10:26,330
!بطاقة اللّصوص الشّبح

155
00:10:26,500 --> 00:10:28,460
"!كانت نقابة اللّصوص الشّبح هنا"

156
00:10:28,630 --> 00:10:33,050
تمّ استبدال أميرة ضوء القمر بواسطة"
"عِقد مُزيّف. سامحوني

157
00:10:33,220 --> 00:10:34,630
ماذا؟

158
00:10:34,800 --> 00:10:36,260
!فـ-فـ-فظيع

159
00:10:37,550 --> 00:10:39,010
!توقّفي! إنّه فخّ

160
00:10:39,180 --> 00:10:40,140
ماذا؟

161
00:10:40,310 --> 00:10:44,350
أوهموكِ بأنّها مُزيّفة، وذلك كي
تفتحي العلبة لتفقّدها

162
00:10:44,520 --> 00:10:46,310
!لكنّها الأصليّة فعليّاً

163
00:10:46,810 --> 00:10:47,900
معكِ حقّ

164
00:10:48,690 --> 00:10:50,820
،حالما يُفتَح القفل

165
00:10:52,150 --> 00:10:54,200
سآخذها من العلبة

166
00:10:55,150 --> 00:10:56,780
إنّها خدعة قديمة

167
00:11:00,290 --> 00:11:02,080
هل سُرِقت جوهرة ماكوتو؟

168
00:11:09,170 --> 00:11:10,130
!لحظة

169
00:11:16,970 --> 00:11:18,600
!سار الأمر على ما يُرام

170
00:11:18,760 --> 00:11:19,600
أجل

171
00:11:20,600 --> 00:11:21,760
!افتح

172
00:11:22,390 --> 00:11:23,770
!مصباح بري-كيت

173
00:11:25,100 --> 00:11:26,270
!رمية الحلَقة

174
00:11:31,440 --> 00:11:32,650
كيف وجدتماني؟

175
00:11:32,820 --> 00:11:37,610
هناك أكثر من عشر كاميرات مُراقبة
حول مداخل المتحف

176
00:11:37,780 --> 00:11:39,910
هناك الكثير من الصّحفيّين في الخارج

177
00:11:40,070 --> 00:11:42,870
سيكون من الأسهل الهرب عن طريق السّطح

178
00:11:43,370 --> 00:11:44,580
أحسنتما

179
00:11:48,710 --> 00:11:50,000
!هذه أنتِ

180
00:11:50,170 --> 00:11:52,590
لا يمكنكما إيقافي هكذا

181
00:11:52,750 --> 00:11:54,630
تحوّلا إلى بريكيور

182
00:11:54,800 --> 00:11:55,720
...إن لم تفعلا

183
00:11:55,880 --> 00:11:58,050
،فسأتنكّر وأختلط بين الجمهور

184
00:11:58,590 --> 00:11:59,890
وسأفلت

185
00:12:01,180 --> 00:12:02,390
مُلمّع بري-كيت

186
00:12:10,020 --> 00:12:11,110
!افتحي

187
00:12:16,150 --> 00:12:17,990
!ساعة جوهرة كيور

188
00:12:20,570 --> 00:12:23,200
!بريكيور! وقت الاستيقاظ

189
00:12:23,370 --> 00:12:25,330
!ثلاثة! اكتشفي

190
00:12:38,130 --> 00:12:40,010
!ستّة! ومُقابل بعضيهما الآخر

191
00:12:52,020 --> 00:12:54,360
!تسعة! نحن الثّنائي الإعجازيّ

192
00:13:03,450 --> 00:13:05,160
!دوري

193
00:13:05,580 --> 00:13:07,330
!وأنهي الأمر بشكل ظريف

194
00:13:31,440 --> 00:13:37,480
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، أنسر كيور

195
00:13:39,690 --> 00:13:42,780
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

196
00:13:42,950 --> 00:13:45,950
!المُتحرّية النّجمة، كيور ميستيك

197
00:13:50,250 --> 00:13:52,330
!المُتحرّية النّجمة بريكيور

198
00:13:54,790 --> 00:13:57,380
!سأُريك إجابتي

199
00:13:58,760 --> 00:14:00,380
من أنتِ على أيّ حال؟

200
00:14:00,550 --> 00:14:02,930
لماذا لديكِ مُلمّع بري-كيت؟

201
00:14:03,090 --> 00:14:05,350
ألا يحلّ المُحقِّقون الألغاز؟

202
00:14:05,510 --> 00:14:08,390
ليس من الجذّاب طلب أجوبة فقط

203
00:14:09,180 --> 00:14:11,520
ماشوتان، تمسّكي بهذا

204
00:14:15,690 --> 00:14:18,020
،حسناً. هذه المرّة فقط

205
00:14:18,650 --> 00:14:20,610
سأجيبكما

206
00:14:30,160 --> 00:14:32,660
،حسناً. هذه المرّة فقط

207
00:14:33,160 --> 00:14:35,080
سأجيبكما

208
00:14:37,630 --> 00:14:38,540
افتحي

209
00:14:46,140 --> 00:14:47,800
!عصا تير أركانا

210
00:14:55,190 --> 00:14:56,150
!اخلط

211
00:15:04,530 --> 00:15:05,570
!اعكس

212
00:15:24,800 --> 00:15:27,140
،تطويق كلّ شيء بالغموض والأسرار

213
00:15:27,300 --> 00:15:28,800
!كيور أركانا شادو

214
00:15:29,800 --> 00:15:32,810
حسناً إذاً، أهلاً بكما في المتاهة

215
00:15:45,820 --> 00:15:48,200
!كيور أركانا شادو؟

216
00:15:48,360 --> 00:15:49,570
أنتِ بريكيور؟

217
00:15:50,450 --> 00:15:52,790
حسناً، واجهاني

218
00:16:10,930 --> 00:16:12,760
حركاتكما بسيطة جدّاً

219
00:16:12,930 --> 00:16:15,810
حركتكما التّالية واضحة

220
00:16:28,070 --> 00:16:28,860
!ماذا؟

221
00:16:31,820 --> 00:16:34,370
حركاتكما عريضة ومُتوقَّعة

222
00:16:39,290 --> 00:16:40,880
!مطر نجم أركانا

223
00:16:55,510 --> 00:16:58,020
أنتما تبذلان جهديكما فعلاً

224
00:16:58,770 --> 00:17:00,270
كلّ هذا لأجل قطعة مُزيّفة

225
00:17:00,440 --> 00:17:01,230
ماذا؟

226
00:17:01,400 --> 00:17:03,860
!سيّدتي! لنستدعِ الشّرطة

227
00:17:04,020 --> 00:17:05,690
!لا، أبداً-
ماذا؟-

228
00:17:06,400 --> 00:17:10,150
"أميرة ضوء النّجم استُبدِلت بواسطة أُخرى مُزيّفة"

229
00:17:10,320 --> 00:17:11,950
من ناحية، هذا صحيح

230
00:17:12,370 --> 00:17:16,540
!كلّ القِطع المعروضة في المتحف مُزيّفة

231
00:17:16,700 --> 00:17:19,750
ماذا؟! كـ-كلّها؟ منذ متى؟

232
00:17:19,910 --> 00:17:22,250
!منذ البدء في عرضها

233
00:17:22,420 --> 00:17:24,500
أريد التّباهي أمام الجميع

234
00:17:24,670 --> 00:17:26,800
لكن أخشى من سرقتها

235
00:17:27,300 --> 00:17:30,840
!روح هاوي التّجميع مُعقّدة حقّاً

236
00:17:31,800 --> 00:17:33,140
...مُزيّفة

237
00:17:33,300 --> 00:17:37,770
عِقد من الأكاذيب يأسر النّاس إلى أن
يحتوي على جوهرة ماكوتو

238
00:17:38,430 --> 00:17:40,980
الأكاذيب ليست سيّئة دوماً

239
00:17:41,140 --> 00:17:44,310
ألا تعتقدان ذلك؟ أيّتها المُتحرّيتان النّجمتان

240
00:17:46,440 --> 00:17:47,440
...لكن

241
00:17:47,610 --> 00:17:48,650
!لا

242
00:17:49,690 --> 00:17:52,490
الكذِب وسرقة الأشياء من النّاس؟

243
00:17:53,240 --> 00:17:55,030
!هذا غير مقبول بتاتاً

244
00:18:00,710 --> 00:18:03,370
!هجوم أنسر

245
00:18:13,340 --> 00:18:14,430
أركانا

246
00:18:16,010 --> 00:18:17,890
هذا لأنّكِ تركتِ بطاقة الزّيارة

247
00:18:19,020 --> 00:18:21,100
!يا لها من فوضى عارمة

248
00:18:21,270 --> 00:18:22,140
!مهلاً

249
00:18:22,310 --> 00:18:24,230
!سأحسم هذا الأمر

250
00:18:25,190 --> 00:18:26,810
!أيّتها الأكاذيب، طوّقي

251
00:18:27,480 --> 00:18:29,230
!دعيها تُحلّق

252
00:18:29,650 --> 00:18:30,900
!هانّيندا

253
00:18:36,990 --> 00:18:39,080
!نان! نيندا

254
00:18:41,620 --> 00:18:43,710
!هانّيندا

255
00:18:47,170 --> 00:18:51,960
.الدّخيل من قراءة البخت خاصّتي
!كانت أغيسيني

256
00:18:57,600 --> 00:18:59,640
!هانّين

257
00:19:09,820 --> 00:19:10,610
ماذا؟

258
00:19:16,450 --> 00:19:17,490
!دا

259
00:19:20,490 --> 00:19:21,990
!هذا مُزعج للغاية

260
00:19:25,160 --> 00:19:26,540
لا تعترضي طريقي

261
00:19:27,250 --> 00:19:30,040
!هانّيندا

262
00:19:30,210 --> 00:19:31,920
!ميستيك-
!حسناً-

263
00:19:34,340 --> 00:19:35,380
!افتحي

264
00:19:39,430 --> 00:19:41,430
!عدسة المرآة المُكبِّرة بري-كيت

265
00:19:41,600 --> 00:19:42,600
!بوتشيتان

266
00:19:49,150 --> 00:19:50,520
!جوهرة ماكوتو

267
00:19:58,910 --> 00:19:59,780
!انظري

268
00:20:01,660 --> 00:20:02,700
!اشعري

269
00:20:05,160 --> 00:20:06,580
!حُلّي اللّغز

270
00:20:08,920 --> 00:20:12,710
!هذا هو جوابنا

271
00:20:13,380 --> 00:20:17,050
!بريكيور! الطّيف الطّائر

272
00:20:26,980 --> 00:20:28,810
!إغلاق ملفّ القضيّة كيوريتو

273
00:20:29,650 --> 00:20:33,770
!هان! نين! دا

274
00:20:43,530 --> 00:20:46,000
!بوتشي بوتشي كيور كيور

275
00:20:52,170 --> 00:20:55,090
!أركانا شادو! هذا رديء جدّاً

276
00:20:57,840 --> 00:20:59,340
الآن أعلم وبكلّ يقين

277
00:20:59,840 --> 00:21:01,510
،بوضعكما الرّاهن

278
00:21:03,550 --> 00:21:05,390
لا يمكنكما هزيمة اللّصوص الشّبح

279
00:21:15,440 --> 00:21:18,070
لماذا توجد بريكيور لصّة؟

280
00:21:28,410 --> 00:21:30,750
هذا مؤسف جدّاً بشأن جوهرة ماكوتو

281
00:21:33,170 --> 00:21:36,880
لا تشعري بالاستياء! فالفشل هو جذر النّجاح

282
00:21:38,210 --> 00:21:39,130
مُخطئ

283
00:21:42,760 --> 00:21:44,640
أنا لا أفشل أبداً

284
00:21:45,850 --> 00:21:50,270
وفقاً لطاقم المتحف، كلّ المعروضات
!في المتحف مُزيّفة؟

285
00:21:50,430 --> 00:21:53,980
!أردتُ التّباهي، لكن لم أتوقّع حدوث ذلك

286
00:21:54,150 --> 00:21:57,980
!سأعرض القِطع الحقيقيّة، لذا سامحوني

287
00:21:58,900 --> 00:22:04,320
،سبّبت بطاقة الزّيارة جلبة كبيرة
لذا ستعرض الآن الحقيقيّة

288
00:22:05,320 --> 00:22:06,580
أركانا شادو

289
00:22:06,740 --> 00:22:09,450
هل كان هذا هدفها منذ البداية؟

290
00:23:47,180 --> 00:23:50,510
كيور أركانا شادو. إنّها بريكيور ولصّة
في نفس الوقت؟

291
00:23:50,680 --> 00:23:52,060
لكن لماذا؟

292
00:23:52,220 --> 00:23:55,640
!علينا التحرّي حول هذا الأمر
!ميكورو! بوتشيتان

293
00:23:55,810 --> 00:23:57,140
!هذا صحيح

294
00:23:58,350 --> 00:24:01,900
!النّجمة المُتحرّية بريكيور
"سرّ كيور أركانا شادو"

295
00:24:02,070 --> 00:24:04,360
!وبهذا يكون قد تمّ إغلاق ملفّ كيوريتو