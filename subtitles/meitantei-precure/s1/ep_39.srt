1
00:00:16,640 --> 00:00:17,600
!حسناً

2
00:00:17,770 --> 00:00:20,350
!والآن لنُنجزها بحرص شديد

3
00:00:24,150 --> 00:00:27,860
!بوري بوري، بريتي سمايل

4
00:00:33,700 --> 00:00:34,790
!إنّها جاهزة

5
00:00:34,950 --> 00:00:39,160
...المليء بابتسامة جميلة، والخاصّ جدّاً

6
00:00:39,620 --> 00:00:41,460
مُلمِّع بري-كيت؟

7
00:00:51,680 --> 00:00:54,350
جيت-سينباي، هل أنت بخير؟-
ماذا؟-

8
00:00:54,510 --> 00:00:55,760
!هذه أنا

9
00:00:56,720 --> 00:00:57,720
آنّا؟

10
00:00:57,890 --> 00:01:00,310
نحن نستعدّ للهالوين

11
00:01:00,480 --> 00:01:02,690
جميعنا صنعنا ملابسَ تنكُّريّة

12
00:01:02,850 --> 00:01:04,400
!نحن أيضاً

13
00:01:04,560 --> 00:01:06,650
!نحن جاهزات

14
00:01:07,780 --> 00:01:10,280
صنعتُن ملابسكن التنكُّريّة الخاصّة؟

15
00:01:10,450 --> 00:01:14,070
لكن يمكنكن التنكُّر بسهولة
!بمُلمّع بري-كيت

16
00:01:14,240 --> 00:01:19,660
صنع ملابسنا ومُلحقاتنا الخاصّة
هوء جزء من متعة الهالوين

17
00:01:20,160 --> 00:01:22,330
بالمُناسبة، أنا حاصدة أرواح

18
00:01:22,500 --> 00:01:23,830
!وأنا شيطانة

19
00:01:24,000 --> 00:01:25,460
!وأنا مصّاصة دماء

20
00:01:26,880 --> 00:01:28,340
وأنا جيانغشي

21
00:01:28,920 --> 00:01:30,220
ماذا يعني "جيانغشي"؟

22
00:01:30,380 --> 00:01:32,510
كشبح صينيّ

23
00:01:32,680 --> 00:01:35,140
!يتحرّك بالقفز هكذا

24
00:01:35,300 --> 00:01:38,220
!استمتعتُ بالبحث حوله الكُتُب والأفلام

25
00:01:40,310 --> 00:01:41,850
أهذا ما يدور حوله الأمر؟

26
00:01:42,640 --> 00:01:45,980
ميكورو، ظننتُ بأنّكِ لا تحبّين الأشباح

27
00:01:46,150 --> 00:01:48,070
هذا صحيح... هل أنتِ بخير؟

28
00:01:48,230 --> 00:01:52,320
إنّها ليست مُخيفة، نحن نستمتع بارتداء
الملابس والتجهُّز فحسب

29
00:01:52,490 --> 00:01:54,070
!لذا أنا بخير

30
00:01:55,200 --> 00:01:57,780
حان وقت الذّهاب إلى أركيد التسوُّق

31
00:01:57,950 --> 00:02:00,500
يجب عليّ العودة إلى متجر الكعك للمُساعدة

32
00:02:00,830 --> 00:02:02,750
ماذا؟ هل حدث شيء؟

33
00:02:02,910 --> 00:02:06,460
يُقيم أركيد التسوُّق حدثَ هالوين

34
00:02:06,630 --> 00:02:08,880
!فهو يوم الهالوين في نهاية المطاف

35
00:02:09,050 --> 00:02:10,670
!نريد أن يستمتع الجميع

36
00:02:11,550 --> 00:02:12,880
...وإن أمكن

37
00:02:15,220 --> 00:02:17,680
قد يظهر شبح حقيقيّ؟

38
00:02:22,810 --> 00:02:26,690
!لنبحث عن اللّمحة في القلب

39
00:02:26,860 --> 00:02:29,730
إلهام مُشرِق

40
00:02:30,070 --> 00:02:32,690
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

41
00:02:32,860 --> 00:02:35,410
إنّها تنادينا

42
00:02:35,570 --> 00:02:38,330
أين الحقيقة؟ ما الّذي ستكتشفه؟

43
00:02:38,490 --> 00:02:42,080
لغز تلو الآخر

44
00:02:42,750 --> 00:02:48,130
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

45
00:02:48,290 --> 00:02:53,380
كما الدّليل! شيء يلمع عبر الزّمن

46
00:02:53,630 --> 00:02:56,300
كيف؟ كيف؟ أهي خدعة؟

47
00:02:56,470 --> 00:02:59,260
لماذا؟ لماذا؟ سوف نواجهها

48
00:02:59,550 --> 00:03:04,850
لننظر ونشعر
نكتشف الأسرار

49
00:03:05,190 --> 00:03:10,690
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

50
00:03:11,070 --> 00:03:16,240
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

51
00:03:16,570 --> 00:03:22,040
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

52
00:03:22,200 --> 00:03:25,500
!لنمشِ في ذلك الطّريق معاً

53
00:03:25,660 --> 00:03:29,420
!لنبحث عن اللّمحة في القلب

54
00:03:29,580 --> 00:03:31,250
إلهام مُشرِق

55
00:03:31,420 --> 00:03:37,050
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

56
00:03:37,220 --> 00:03:42,140
ولادتنا ولقاؤنا لَهو لغز رائع

57
00:03:42,310 --> 00:03:45,770
!هيّا يا بريكيور المُتحرّيات النّجمات

58
00:03:52,480 --> 00:03:56,990
هالوين أوجاماجو

59
00:03:57,530 --> 00:04:03,790
!عيد هالوين سعيد

60
00:04:03,950 --> 00:04:06,960
!هذا أوّل هالوين أركيد تسوُّق لنا

61
00:04:07,120 --> 00:04:09,750
!لنقضِ وقتاً مُمتعاً جميعاً

62
00:04:09,920 --> 00:04:13,460
تُظهِر هذه الخريطة كافّة المتاجر المُشارِكة

63
00:04:13,630 --> 00:04:17,720
"!زوروا المتاجر وقولوا "خدعة أو حلوى
!وسيعطونكم حلوى

64
00:04:18,800 --> 00:04:20,050
!آنّا، ميكورو

65
00:04:20,840 --> 00:04:22,430
!كنتُما تعملان بجدّ

66
00:04:22,600 --> 00:04:24,140
!ري! يومي

67
00:04:24,310 --> 00:04:25,600
!أتيتُما

68
00:04:25,770 --> 00:04:26,680
!بالطّبع

69
00:04:26,850 --> 00:04:30,400
إنّه عيد الهالوين الأوّل لنا، لذا
تساءلنا كيف سيبدو

70
00:04:30,560 --> 00:04:33,610
!نرى الكثير من الملابس، هذا مُمتع حقّاً

71
00:04:34,270 --> 00:04:37,940
آنّا، اقترحتِ هذا على رئيس أركيد التسوُّق؟

72
00:04:38,110 --> 00:04:43,910
أجل! أردتُ أن يعرف الجميع بأنّ هناك مهرجاناً
!مُوسميّاً يستطيع الجميع الاستمتاع به

73
00:04:44,080 --> 00:04:45,160
!وجدتُك

74
00:04:45,330 --> 00:04:47,950
!لارتكاب جريمة سرقة قلبي

75
00:04:48,120 --> 00:04:50,580
!أنت رهن الاعتقال

76
00:04:51,000 --> 00:04:52,960
!أمسكتُ بك يا حبيبي

77
00:04:53,130 --> 00:04:56,550
الاعتقال بواسطتكِ كان دافعي
!الحقيقيّ يا عزيزتي

78
00:04:56,710 --> 00:04:59,300
!هذه إحدى طُرُق الاستمتاع بالأمر

79
00:05:03,260 --> 00:05:06,100
أيّها الشّبحان الظّريفان، هل يمكنني مُساعدتكما؟

80
00:05:06,260 --> 00:05:08,520
ماذا كان؟

81
00:05:08,680 --> 00:05:11,600
...المعذرة، خزعة؟ خزعة

82
00:05:12,940 --> 00:05:15,480
!خدعة أو حلوى

83
00:05:15,650 --> 00:05:18,650
!أعطني حلوى، أو سأستخدم خدعةً عليك

84
00:05:18,820 --> 00:05:20,530
!لا نريد ذلك

85
00:05:20,700 --> 00:05:22,950
في هذه الحالة، تفضّل حلوى

86
00:05:23,110 --> 00:05:24,120
!شكراً لك

87
00:05:26,870 --> 00:05:28,620
!خدعة أو حلوى

88
00:05:29,080 --> 00:05:30,080
تفضّلا

89
00:05:31,830 --> 00:05:33,290
!شكراً

90
00:05:37,050 --> 00:05:39,050
!حلويّات هالوين محدودة الكمّية

91
00:05:39,210 --> 00:05:40,300
!ظريفة

92
00:05:40,470 --> 00:05:41,970
!ليحصل كلُّ واحد منّا على قطعة

93
00:05:42,130 --> 00:05:43,930
!شكراً جزيلاً

94
00:05:49,430 --> 00:05:50,890
!انظري! ظريف جدّاً

95
00:05:51,390 --> 00:05:53,100
ربّما ينبغي أن نُجرّبها؟

96
00:05:53,270 --> 00:05:54,100
الآن؟

97
00:05:54,270 --> 00:05:56,820
!لأجلكم فقط يا ناس

98
00:05:56,980 --> 00:06:02,280
حضّرنا أدوات يمكنكم استخدامها
!لارتداء ملابس تنكُّريّة فوراً

99
00:06:02,450 --> 00:06:05,450
!يا إلهي-
!سأختار هذه-

100
00:06:06,240 --> 00:06:07,240
!انظر إلى هذا

101
00:06:07,410 --> 00:06:09,200
!لنذهب ونرَ ما يجري

102
00:06:12,830 --> 00:06:14,330
تسويق ممتاز

103
00:06:14,500 --> 00:06:15,580
!أحسنتِ

104
00:06:29,560 --> 00:06:32,640
لم أكن أدري كيف كنّا سنُقيم
...أوّل هالوين لنا

105
00:06:32,810 --> 00:06:34,890
!لكن يسرّني أنّ الجميع قد استمتعوا

106
00:06:35,060 --> 00:06:38,190
أتى كثير من الزّبائن إلى الباتيسري

107
00:06:38,360 --> 00:06:40,360
!كانت مُديرتي سعيدة للغاية

108
00:06:40,530 --> 00:06:42,070
!حصلتُ على كثير من الحلويّات

109
00:06:42,240 --> 00:06:44,610
!الهالوين مُذهلة حقّاً

110
00:06:45,110 --> 00:06:47,490
يُراودني نفس الشّعور. الآيس كريم لذيذ

111
00:06:47,660 --> 00:06:49,530
لكن حلويّات الهالوين مُميّزة

112
00:06:53,200 --> 00:06:54,750
أين أنا؟

113
00:06:54,910 --> 00:06:55,750
!أنتِ

114
00:06:56,420 --> 00:06:58,790
ما الأمر؟ هل أنتِ تائهة؟

115
00:06:58,960 --> 00:07:03,010
،ذهبتُ للحصول على بعض الحلوى
فضعتُ عن أمّي

116
00:07:03,510 --> 00:07:04,720
ما اسمكِ؟

117
00:07:04,880 --> 00:07:05,800
هينانو

118
00:07:07,220 --> 00:07:10,180
!حسناً يا هينانو، لنبحث عن أمّكِ

119
00:07:10,720 --> 00:07:12,390
هل يمكنكِ إيجاد أمّي؟

120
00:07:12,560 --> 00:07:14,100
!لا تقلقي

121
00:07:14,270 --> 00:07:17,560
!نحن مُتحرّيات، لذا سنجدها بسرعة

122
00:07:18,730 --> 00:07:20,690
!شكراً أيّتها المُتحرّيات

123
00:07:27,160 --> 00:07:30,280
!الهالوين رهيب جدّاً

124
00:07:30,450 --> 00:07:33,450
،الجميع يرتدون ملابس تنكُّريةّ
!إنّه غاية في الرّوعة

125
00:07:34,160 --> 00:07:36,290
!ملابس تلك الفتاة التنكُّريّة ظريفة للغاية

126
00:07:37,080 --> 00:07:38,880
ماذا يُفترض بكِ أن تفعلي؟

127
00:07:39,040 --> 00:07:41,380
!أنا اللّصّة الشّبح أغيسيني

128
00:07:41,540 --> 00:07:45,050
!بذلتُ جهداً كبيراً في أقنعتي وأحذيتي

129
00:07:45,220 --> 00:07:46,340
!مُلحقات

130
00:07:47,760 --> 00:07:48,800
ما هذا؟

131
00:07:49,340 --> 00:07:51,810
!هذه الحلويّات ظريفة جدّاً

132
00:07:52,260 --> 00:07:54,020
إنّها حلويّات هالوين

133
00:07:54,180 --> 00:07:55,020
!أنتِ

134
00:07:55,180 --> 00:07:57,440
لديّ الكثير، يمكنكِ أخذ هذه

135
00:07:59,480 --> 00:08:00,690
شكراً

136
00:08:04,440 --> 00:08:07,650
لحظة! أتيتُ لسرقة جوهرة ماكوتو

137
00:08:08,110 --> 00:08:10,120
!وداعاً

138
00:08:12,200 --> 00:08:14,580
ما المتاجر الأُخرى الّتي ذهبتِ إليها؟

139
00:08:14,740 --> 00:08:16,660
...المعذرة-
آنّا-

140
00:08:17,710 --> 00:08:20,210
هل وجدتُم أمّ هيناتو؟

141
00:08:20,380 --> 00:08:22,920
كانت عند مكتب الاستعلام في المحطّة

142
00:08:23,090 --> 00:08:23,800
...لكن

143
00:08:24,460 --> 00:08:26,260
أخو هينانو الصّغير

144
00:08:26,420 --> 00:08:28,680
لم يتوقّف الرّضيع عن البُكاء

145
00:08:29,430 --> 00:08:32,470
لم يبدُ أنّها كانت تستطيع المجيء

146
00:08:32,640 --> 00:08:33,850
...لذا يا هينانو

147
00:08:34,350 --> 00:08:38,180
هل تريدين الاحتفال معنا بالهالوين؟-
ماذا؟-

148
00:08:38,350 --> 00:08:41,230
سنأخذكِ إلى المنزل عندما ننتهي

149
00:08:41,400 --> 00:08:44,900
لنذهب ونتجوّل في المتاجر
!ونشترِ بعض الحلويّات

150
00:08:45,070 --> 00:08:47,030
!لنستمتع بالهالوين معاً

151
00:08:47,570 --> 00:08:48,490
!حسناً

152
00:08:50,160 --> 00:08:51,200
بالمُناسبة

153
00:08:51,360 --> 00:08:54,490
زيّكِ ظريفٌ حقّاً

154
00:08:54,660 --> 00:08:56,330
أنتِ ساحرة مُلوّنة؟

155
00:08:56,490 --> 00:08:59,290
!أنا دوريمي من أوجاماجو دوريمي

156
00:08:59,460 --> 00:09:00,540
!أحبّها

157
00:09:00,710 --> 00:09:01,790
!دوريمي

158
00:09:02,290 --> 00:09:05,250
!أحبّها أيضاً! نحن مُتشابهتان

159
00:09:07,340 --> 00:09:09,380
...تكلّمت الدّمية المحشوّة

160
00:09:09,880 --> 00:09:11,720
كان ذلك تكلُّماً من البطن

161
00:09:11,890 --> 00:09:13,800
التكلُّم من البطن هو

162
00:09:13,970 --> 00:09:16,510
،عندما تبدو الدّمية وكأنّها تتكلّم

163
00:09:16,970 --> 00:09:20,100
لكن الشّخص الّذي يحمل الدّمية
هو من يتكلّم في الواقع

164
00:09:20,270 --> 00:09:22,810
!أنا ماشوتان! سررتُ بلقائك

165
00:09:23,230 --> 00:09:26,270
!مُذهل! تبدو وكأنّها تتكلّم بالفعل

166
00:09:26,440 --> 00:09:27,820
!نجونا

167
00:09:28,610 --> 00:09:30,860
إذاً ما هو "أوجاماجو دوريمي"؟

168
00:09:31,490 --> 00:09:32,860
أعتقد بأنّها مجلّة هزليّة؟

169
00:09:33,030 --> 00:09:35,530
إنّه كرتون في تلفزيون صباح الأحد

170
00:09:35,910 --> 00:09:39,000
شوشوتان والأُخريات يتطلّعن بلهفة
لمُشاهدته في كلّ أسبوع

171
00:09:39,160 --> 00:09:41,210
!إنّه مُثير حقّاً

172
00:09:42,370 --> 00:09:44,750
أنتن لا تعرفنَ دوريمي؟

173
00:09:44,920 --> 00:09:45,670
!حسناً إذاً

174
00:09:45,840 --> 00:09:47,420
أوجاماجو دوريمي فيه

175
00:09:47,800 --> 00:09:48,960
،دوريمي

176
00:09:49,130 --> 00:09:50,220
،هازوكي

177
00:09:50,380 --> 00:09:51,470
،آيكو

178
00:09:51,630 --> 00:09:52,800
وأونبو

179
00:09:52,970 --> 00:09:55,850
قصّته تحكي عن أربعة تلميذات ساحرات

180
00:09:56,010 --> 00:09:57,430
تلميذات ساحرات؟

181
00:09:57,600 --> 00:09:58,640
ليس ساحرات؟

182
00:09:58,810 --> 00:10:03,140
أجل! دوريمي والأُخريات يُرِدنَ
أن يكنّ ساحرات

183
00:10:03,310 --> 00:10:05,190
لذا هُنّ يساعدن النّاس المحتاجين

184
00:10:05,360 --> 00:10:08,780
!يخضعنَ لامتحانات التّلمذة ويعملنَ بجدّ

185
00:10:08,940 --> 00:10:12,570
!هينانو، أنتِ تحبّين أوجاماجو دوريمي حقّاً

186
00:10:13,150 --> 00:10:18,240
أجل! وانظرنَ، أنا وأمّي صنعنا
!هذه المكنسة

187
00:10:18,740 --> 00:10:22,960
أتمنّى لو أستطيع الطّيران بمكنسة
!مثل دوريمي فحسب

188
00:10:25,880 --> 00:10:27,710
أنتِ هناك أيّتها السّاحرة الصّغيرة

189
00:10:27,880 --> 00:10:30,420
!أريني تلك المكنسة

190
00:10:30,590 --> 00:10:33,880
