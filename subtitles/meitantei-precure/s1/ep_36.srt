1
00:00:13,060 --> 00:00:16,060
!جوهرة ماكوتو

2
00:00:16,230 --> 00:00:17,430
!هنا

3
00:00:17,600 --> 00:00:18,850
!مهلاً

4
00:00:19,020 --> 00:00:20,060
!بسرعة

5
00:00:20,230 --> 00:00:21,150
!حسناً

6
00:00:21,310 --> 00:00:22,270
!هيّا بنا

7
00:00:22,440 --> 00:00:23,520
حسناً

8
00:00:27,900 --> 00:00:30,610
كُتُب مُستعملة

9
00:00:27,900 --> 00:00:30,610
...يا إلهي... يا إلهي

10
00:00:31,740 --> 00:00:33,580
!تمالك نفسك يا جدّي

11
00:00:33,740 --> 00:00:35,830
!شيغي، تماسك

12
00:00:35,990 --> 00:00:37,870
ما الأمر؟ ماذا حدث؟

13
00:00:38,330 --> 00:00:39,670
هل أنت بخير؟

14
00:00:39,830 --> 00:00:41,210
ما الّذي يجري؟

15
00:00:42,080 --> 00:00:43,460
!لقد سُرِق

16
00:00:44,170 --> 00:00:47,970
!ملكيّتي الثّمينة! ميداليّتي الذّهبيّة

17
00:00:48,130 --> 00:00:50,760
مـ-ميداليّة ذهبيّة؟

18
00:00:56,890 --> 00:01:00,770
!لنبحث عن اللّمحة في القلب

19
00:01:00,940 --> 00:01:03,810
إلهام مُشرِق

20
00:01:04,150 --> 00:01:06,780
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

21
00:01:06,940 --> 00:01:09,490
إنّها تنادينا

22
00:01:09,650 --> 00:01:12,410
أين الحقيقة؟ ما الّذي ستكتشفه؟

23
00:01:12,570 --> 00:01:16,160
لغز تلو الآخر

24
00:01:16,830 --> 00:01:22,210
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

25
00:01:22,370 --> 00:01:27,460
كما الدّليل! شيء يلمع عبر الزّمن

26
00:01:27,710 --> 00:01:30,380
كيف؟ كيف؟ أهي خدعة؟

27
00:01:30,550 --> 00:01:33,340
لماذا؟ لماذا؟ سوف نواجهها

28
00:01:33,640 --> 00:01:38,930
لننظر ونشعر
نكتشف الأسرار

29
00:01:39,270 --> 00:01:44,770
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

30
00:01:45,150 --> 00:01:50,320
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

31
00:01:50,650 --> 00:01:56,120
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

32
00:01:56,280 --> 00:01:59,580
!لنمشِ في ذلك الطّريق معاً

33
00:01:59,750 --> 00:02:03,500
!لنبحث عن اللّمحة في القلب

34
00:02:03,670 --> 00:02:05,330
إلهام مُشرِق

35
00:02:05,500 --> 00:02:11,130
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

36
00:02:11,300 --> 00:02:16,220
ولادتنا ولقاؤنا لَهو لغز رائع

37
00:02:16,390 --> 00:02:19,850
!هيّا يا بريكيور المُتحرّيات النّجمات

38
00:02:26,560 --> 00:02:31,030
ميداليّة المِحَن الذّهبيّة

39
00:02:33,860 --> 00:02:37,070
هل قرأت الرّسالة الّتي أرسلتُها؟

40
00:02:39,410 --> 00:02:41,450
قلت بأنّ لندن قد سقطت؟

41
00:02:41,620 --> 00:02:45,670
!أجل، ليتك رأيت ذلك

42
00:02:45,830 --> 00:02:50,920
لكن قبل المشهد النّهائي، بُرهان الفجر قد أفلت

43
00:02:51,840 --> 00:02:55,840
،ما زلتُ لا أعرف أين وضعتْ بوتشيتان
،جنّية الزّمان والمكان

44
00:02:56,010 --> 00:02:57,510
جوهرةَ ماكوتو

45
00:02:58,800 --> 00:03:01,770
قد لا نحتاج جوهرةَ ماكوتو تلك

46
00:03:01,930 --> 00:03:02,970
ماذا؟

47
00:03:03,140 --> 00:03:07,560
حصل نيجي على جوهرة ماكوتو ظهرتْ
في مُجلّد الأسراب

48
00:03:07,730 --> 00:03:09,940
عليه أن يُعيدها إلى هنا فحسب

49
00:03:11,190 --> 00:03:14,240
الميداليّة الذّهبيّة تعني بأنّك الأفضل في العالم؟

50
00:03:14,700 --> 00:03:16,990
إنّها ليست شيئاً فاخراً إلى هذا لحدّ

51
00:03:17,570 --> 00:03:21,910
جدّي وأومي ينتميان إلى نادي السِّهام المحلّيّ

52
00:03:22,370 --> 00:03:23,870
نادي السِّهام؟

53
00:03:24,910 --> 00:03:27,870
إنّها لعبة حيث نرمي سِهاماً نحو هدف

54
00:03:28,040 --> 00:03:29,670
!إنّها ليست لعبة

55
00:03:29,840 --> 00:03:32,300
!السِّهام هي رياضةٌ حقيقيّة

56
00:03:44,930 --> 00:03:46,600
!مُدهش جدّاً

57
00:03:47,350 --> 00:03:48,480
أليس كذلك؟

58
00:03:48,650 --> 00:03:53,360
قدّرَ جدّي الميداليّةَ الذّهبيّةَ الّتي
ربحها في البطولة الإقليميّة

59
00:03:53,530 --> 00:03:55,360
لكنّها سُرِقت

60
00:03:55,990 --> 00:03:58,410
!السِّهام هي سبب حياتي

61
00:03:58,570 --> 00:04:01,240
كرّستُ دمي وعرَقي ودموعي فيها

62
00:04:01,410 --> 00:04:04,580
ثمّ حدث هذا، بعد أن حصلتُ أخيراً
على ميداليّة ذهبيّة

63
00:04:06,790 --> 00:04:08,210
!أيّتها المُتحرّيات، أرجوكن

64
00:04:08,670 --> 00:04:11,080
!استعدنَ ميداليّتي الذّهبيّة

65
00:04:11,250 --> 00:04:14,920
!عُلِم-
!حدّثنا عن الأمر رجاء-

66
00:04:16,260 --> 00:04:19,680
لديّ تمرين سِهام لاحقاً اليوم

67
00:04:20,180 --> 00:04:24,720
كنتُ ألمّع ميداليّتي الذّهبيّة وذلك
كي أريها لأصدقائي

68
00:04:25,350 --> 00:04:28,940
،كان الوقت قد حان للذّهاب
لذا وضعتُ ميداليّتي جانباً

69
00:04:29,440 --> 00:04:31,940
كنتُ أمارس "كانبو ماساتسو" في الغرفة الخلفيّة

70
00:04:33,320 --> 00:04:34,270
كانبو...؟

71
00:04:34,820 --> 00:04:35,940
كانبو ماساتسو

72
00:04:36,440 --> 00:04:38,740
فرك البشرة بمنشفة جافّة

73
00:04:40,410 --> 00:04:42,120
ثمّ ماذا حدث؟

74
00:04:43,120 --> 00:04:46,040
تصبّبتُ عرقاً وعدتُ إلى المتجر

75
00:04:46,500 --> 00:04:47,540
...لكن بعدها

76
00:04:52,790 --> 00:04:55,710
لا أصدّق بأنّ شخصاً قد سرقها

77
00:04:56,300 --> 00:04:59,800
لنتكلّم مع الجميع هنا، من باب الحيطة فقط

78
00:05:00,430 --> 00:05:03,970
ماذا كنتُن تفعلن عندما اختفت
الميداليّة الذّهبيّة؟

79
00:05:05,970 --> 00:05:07,970
أنا حفيدته، ميكي فورويا

80
00:05:08,140 --> 00:05:13,020
،أساعد في المتجر أحياناً
واليوم كنتُ أُرتِّب الكُتُب

81
00:05:13,190 --> 00:05:16,530
ثمّ سمعتُ صرخةَ جدّي فجأة

82
00:05:16,690 --> 00:05:20,650
سارعتُ إلى المكتب، حيث كان قد سقط

83
00:05:20,820 --> 00:05:22,990
كانت الميداليّة الذّهبيّة قد اختفت بالفعل

84
00:05:23,160 --> 00:05:26,490
هل دخل أحدٌ أثناء ترتيبكِ للكُتُب؟

85
00:05:26,660 --> 00:05:29,790
كنتُ خلف رفّ، لذا لم أستطع التّمييز

86
00:05:30,250 --> 00:05:31,500
...هكذا إذاً

87
00:05:33,380 --> 00:05:35,420
اسمي أومي تاكيماتسو

88
00:05:35,920 --> 00:05:40,920
،أعيش تحت هذا المكان بطابقين
وأنا في نفس نادي السِّهام

89
00:05:41,550 --> 00:05:44,010
ساقايّ لا تخدمانني جيّداً

90
00:05:44,180 --> 00:05:48,520
لا أستطيع المشي من دون عكّازتي، لذا
أتيتُ لأخبره بأنّني سأتغيّب عن التّمرين

91
00:05:49,060 --> 00:05:54,150
ثمّ سمعتُ صرخةَ شيغي، لذا
سارعتُ لدخول المتجر

92
00:05:54,650 --> 00:05:56,110
ساقاكِ مُصابان؟

93
00:05:56,270 --> 00:05:59,480
لن تتمكّني من الذّهاب إلى متجر
فطائرنا الاعتياديّ أيضاً

94
00:05:59,650 --> 00:06:02,200
أجل، هذا صحيح

95
00:06:04,360 --> 00:06:05,700
اسمي هارونا ماكيفوسا

96
00:06:06,410 --> 00:06:10,540
كنتُ أمشي في صالة التسوُّق للأركيد
عندما سمعتُ رجلاً يصرخ

97
00:06:10,700 --> 00:06:13,670
أتيتُ فقط لأرى ما حدث

98
00:06:13,830 --> 00:06:16,040
لم أرَ الميداليّة الذّهبيّة

99
00:06:16,210 --> 00:06:19,000
لم يذكر أحدٌ شيئاً غير مألوف

100
00:06:19,170 --> 00:06:20,170
صحيح

101
00:06:21,920 --> 00:06:24,550
كانت الميداليّة الذّهبيّة هنا

102
00:06:24,720 --> 00:06:27,100
لعلّ الجاني قد تركَ آثار أقدام

103
00:06:32,100 --> 00:06:32,930
!افتحي

104
00:06:35,520 --> 00:06:37,400
!عدسة المرآة المُكبِّرة بري-كيت

105
00:06:44,650 --> 00:06:46,360
!اكتشاف عظيم

106
00:06:46,530 --> 00:06:49,450
هذه آثار أقدام شيغي وميكي

107
00:06:50,120 --> 00:06:51,330
هنا أيضاً

108
00:06:52,870 --> 00:06:55,540
آثار أقدام أومي وهارونا

109
00:06:55,710 --> 00:06:59,790
شيغي وميكي فقط كانا بالقرب
من الميداليّة الذّهبيّة

110
00:06:59,960 --> 00:07:03,880
عندما وقع الحادث، كان الأُخرتَان
في مكانٍ أبعد

111
00:07:04,050 --> 00:07:06,010
لا تستطيعان أخذها من هناك

112
00:07:06,180 --> 00:07:07,180
!أجل

113
00:07:07,340 --> 00:07:09,050
إذاً، هل ميكي هي الجانية؟

114
00:07:10,220 --> 00:07:13,430
أم استخدم الجاني خدعةً
لأخذها من مسافة

115
00:07:15,640 --> 00:07:17,980
هذا مُبهر

116
00:07:18,150 --> 00:07:19,110
ماذا؟

117
00:07:19,270 --> 00:07:21,440
يمكنكن رؤية آثار الأقدام؟

118
00:07:23,070 --> 00:07:24,820
!أجل، يمكننا ذلك

119
00:07:24,990 --> 00:07:27,990
يمكننا رؤية آثار الأقدام وأشياء أُخرى أيضاً

120
00:07:28,160 --> 00:07:30,410
أشياء أُخرى غير آثار الأقدام؟

121
00:07:37,460 --> 00:07:38,630
!هكذا إذاً

122
00:07:38,790 --> 00:07:40,750
!هذا هو الجواب

123
00:07:41,750 --> 00:07:44,670
!الجاني هو ذلك الشّخص

124
00:07:53,180 --> 00:07:55,350
بات كُلّ شيء مفهوماً الآن

125
00:07:55,520 --> 00:07:57,100
أحسنتِ صنعاً

126
00:07:57,270 --> 00:08:00,230
هـ-هل أنتن متأكّدات بأنّه ليس
شخصاً موجوداً هنا؟

127
00:08:00,400 --> 00:08:04,730
أجل. الشّخص الّذي سرقَ ميداليّتك
!...الذّهبيّة هو

128
00:08:07,320 --> 00:08:08,530
!أنت

129
00:08:08,700 --> 00:08:09,740
ماذا؟

130
00:08:09,910 --> 00:08:11,240
أومي؟

131
00:08:11,410 --> 00:08:15,700
رأينا آثار أقدامك بوضوح بعدسة
المرآة المُكبِّرة بري-كيت

132
00:08:16,290 --> 00:08:18,830
لكن قلتُن بأنّكن رأيتُن آثار أقدام الجميع

133
00:08:19,000 --> 00:08:21,580
،بالفعل. لكن في حالة أومي

134
00:08:21,750 --> 00:08:25,090
لم نرَ شيئاً كان ينبغي أن يكون موجوداً

135
00:08:25,260 --> 00:08:27,300
أومي، أنتِ من قالها بلسانكِ

136
00:08:27,800 --> 00:08:30,430
لا يمكنكِ المشي من دون عكّازتكِ اليوم

137
00:08:31,470 --> 00:08:34,510
لم تظهر علامة العكّازة في العدسة

138
00:08:34,680 --> 00:08:38,770
بصيغة أُخرى، يمكنكِ المشي
من دونها، لكن كذبتِ

139
00:08:38,940 --> 00:08:40,480
...هـ-هذا فقط

140
00:08:40,940 --> 00:08:44,400
!لـ-لكن لم أقترب من الميداليّة الذّهبيّة

141
00:08:44,570 --> 00:08:46,110
فكيف لي أن آخذها؟

142
00:08:46,280 --> 00:08:48,030
لكن استطعتِ أخذها

143
00:08:48,190 --> 00:08:49,700
!باستخدام هذه العكّازة

144
00:08:50,320 --> 00:08:56,200
حتّى لو كنتِ بعيدة عن المكتب، يمكنكِ
تعليق الأشياء بخطّاف عكّازتكِ

145
00:08:57,120 --> 00:09:00,460
!لـ-لكن مُحال أن تسرقها أومي

146
00:09:00,960 --> 00:09:04,710
أتّفق-
هذا إن كانت أومي الحقيقيّة-

147
00:09:06,250 --> 00:09:07,920
ما الّذي يجري؟

148
00:09:09,420 --> 00:09:11,760
هناك اثنتان من أومي؟

149
00:09:12,260 --> 00:09:14,470
!أحضرتُها من متجر الفطائر

150
00:09:14,640 --> 00:09:17,310
!هارونا-
!في الوقت المُناسب-

151
00:09:18,310 --> 00:09:23,810
عدسة مرآة بري-كيت تلك هي
!شوكة في حلقي

152
00:09:24,690 --> 00:09:25,820
!نيجي

153
00:09:26,360 --> 00:09:27,530
!سأخرج من هنا

154
00:09:27,690 --> 00:09:29,530
!توقّف

155
00:09:33,570 --> 00:09:35,620
من أنتِ؟

156
00:09:37,540 --> 00:09:38,830
ماذا تقصدين؟

157
00:09:39,000 --> 00:09:40,870
لا تدّعي الجهل

158
00:09:41,040 --> 00:09:44,750
قلتِ بأنّكِ أتيتِ عندما سمعتِ الرّجل يصرخ

159
00:09:44,920 --> 00:09:48,550
لكن دخلتِ المتجر بعدنا

160
00:09:49,340 --> 00:09:50,340
إذاً؟

161
00:09:50,800 --> 00:09:52,720
هذا غير منطقيّ

162
00:09:52,880 --> 00:09:56,890
أتينا قبلكِ، ولم نسمع صوت الصُّراخ

163
00:09:57,390 --> 00:10:00,520
رأيتِ عدسة المرآة وقدّمتِ لمحة

164
00:10:00,980 --> 00:10:03,980
ساعدتِ الفتيات في مُلاحظة
التّناقُض الخاصّ بالعكّازة

165
00:10:04,850 --> 00:10:06,520
!مُذهل

166
00:10:07,570 --> 00:10:13,360
شديدات المُلاحظة! لم يسعني سوى
!إعطاء لمحة للمُتحرّيات الجديدات

167
00:10:13,530 --> 00:10:14,950
!...أنتِ

168
00:10:16,200 --> 00:10:19,540
ألا تعتقدان بأنّه ينبغي أن تُطارداه الآن؟

169
00:10:28,710 --> 00:10:30,460
!توقّف

170
00:10:31,340 --> 00:10:33,630
!لا يمكننا تقليص المسافة

171
00:10:33,800 --> 00:10:34,970
مسافة؟

172
00:10:35,390 --> 00:10:36,260
!وجدتُها

173
00:10:39,850 --> 00:10:40,770
!افتحي

174
00:10:43,310 --> 00:10:44,770
!مصباح بري-كيت

175
00:10:47,440 --> 00:10:50,940
ما هذا؟-
!أليس هذا واضحاً؟ إنّها عكّازة

176
00:10:51,110 --> 00:10:52,110
!إنّها كذلك

177
00:10:52,280 --> 00:10:54,990
!هيّا

178
00:10:58,160 --> 00:10:59,830
!لا يمكنك الهرب الآن

179
00:11:00,370 --> 00:11:01,660
بئساً

180
00:11:01,830 --> 00:11:05,210
!كلتاكما لديكما إصرار بمستوى ميداليّة ذهبيّة

181
00:11:06,420 --> 00:11:08,460
!أيّتها الأكاذيب، طوِّقي

182
00:11:09,170 --> 00:11:11,500
!تعال، هانّيندا

183
00:11:18,140 --> 00:11:21,140
!هانّيندا

184
00:11:22,720 --> 00:11:23,730
!جميعكن

185
00:11:23,890 --> 00:11:24,810
!حسناً

186
00:11:29,270 --> 00:11:30,320
!افتحي

187
00:11:35,320 --> 00:11:36,910
!ساعة جوهرة كيور

188
00:11:37,360 --> 00:11:39,280
!عطر لولب ليلي

189
00:11:39,450 --> 00:11:41,160
!عصا أركانا المُنيرة

190
00:11:43,290 --> 00:11:45,660
!بريكيور! حان وقت الاستيقاظ

191
00:11:45,830 --> 00:11:47,790
!ثلاثة! اكتشفي

192
00:11:59,220 --> 00:12:00,550
الدّوران الورديّ

193
00:12:06,730 --> 00:12:08,060
!صنبور الزّهور

194
00:12:48,180 --> 00:12:54,110
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، أنسر كيور

195
00:12:56,280 --> 00:12:59,400
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

196
00:12:59,570 --> 00:13:02,780
!المُتحرّية النّجمة، كيور ميستيك

197
00:13:03,990 --> 00:13:05,580
!استيقظي

198
00:13:05,740 --> 00:13:11,670
عطر الحقيقة الدّاخليّة، المُتحرّية
!النّجمة كيور إكلير

199
00:13:13,630 --> 00:13:20,260
،الضّوء الأبيض الّذي يُنير الحقيقة
!المُتحرّية النّجمة، كيور أركانا

200
00:13:24,930 --> 00:13:26,850
!المُتحرِّية النّجمة بريكيور

201
00:13:29,680 --> 00:13:32,060
سأُريك إجابتي

202
00:13:32,230 --> 00:13:34,650
!هان! نين! دا

203
00:13:38,230 --> 00:13:40,190
!سنتأذّى إذا أصابنا ذلك

204
00:13:47,660 --> 00:13:49,410
هذا تدميريّ للغاية

205
00:13:49,580 --> 00:13:50,580
هذا صعب

206
00:13:50,750 --> 00:13:53,040
!لا وقت لاستراحة

207
00:13:54,080 --> 00:13:55,040
!لن أدعك

208
00:13:59,710 --> 00:14:01,920
!هجوم آنسر

209
00:14:03,590 --> 00:14:05,550
!هان! نين! دا

210
00:14:12,230 --> 00:14:14,480
!انعكاس ميستيك

211
00:14:18,400 --> 00:14:20,940
إنّه خطير قريباً كان أم بعيداً

212
00:14:21,110 --> 00:14:22,240
ما الّذي يمكننا فعله؟

213
00:14:23,450 --> 00:14:24,610
!درعي

214
00:14:28,740 --> 00:14:31,040
أصبح أصغر؟

215
00:14:31,200 --> 00:14:32,540
!هانّيندا

216
00:14:32,710 --> 00:14:34,540
!كم هو ظريف

217
00:14:34,710 --> 00:14:37,380
كان يرمي قطعاً من جسده

218
00:14:37,540 --> 00:14:39,090
!هان! نين! هان! نين

219
00:14:40,960 --> 00:14:42,550
!هان! نين! هان! نين

220
00:14:44,380 --> 00:14:47,390
!هان! نين! هان! نين! هان! نين

221
00:14:49,560 --> 00:14:50,810
!نين

222
00:14:51,560 --> 00:14:53,100
!الآن هي فُرصتنا

223
00:14:54,640 --> 00:14:55,600
!افتحي

224
00:14:59,020 --> 00:15:00,780
!عدسة المرآة المُكبِّرة بري-كيت

225
00:15:00,940 --> 00:15:01,900
!شوشوتان

226
00:15:05,030 --> 00:15:06,240
!جوهرة ماكوتو

227
00:15:12,700 --> 00:15:14,790
!كيور إكلير ستُغلق هذه القضيّة

228
00:15:22,300 --> 00:15:27,220
أبسط جناحَي بأناقة وأحلّ اللّغز

229
00:15:28,300 --> 00:15:30,390
هذا هو جوابي

230
00:15:34,560 --> 00:15:38,150
!بريكيور! تحليق بلا حدود

231
00:15:52,990 --> 00:15:54,410
!إغلاق ملفّ القضيّة كيوريتو

232
00:15:56,120 --> 00:16:00,080
!هان! نين! دا

233
00:16:08,430 --> 00:16:10,970
!بوتشي بوتشي كيور كيور

234
00:16:15,680 --> 00:16:19,730
!نلتُن المجد من هذا، يا عزيزي

235
00:16:22,320 --> 00:16:24,230
يبدو أنّه أفسد الأمر

236
00:16:30,870 --> 00:16:32,120
!أحسنتن صنعاً

237
00:16:33,490 --> 00:16:35,080
!إنّكن ماهرات

238
00:16:35,870 --> 00:16:37,080
هارونا؟

239
00:16:37,250 --> 00:16:38,710
رأيت ذلك؟

240
00:16:38,870 --> 00:16:41,170
ماذا سنفعل؟-
!هذا سيّئ-

241
00:16:41,330 --> 00:16:44,420
!لا مُشكلة-
سأعرّف عنها-

242
00:16:48,800 --> 00:16:51,840
!هذا الضّوء-
مُلمِّع بري-كيت؟-

243
00:16:53,390 --> 00:16:57,390
إنّها مسؤولة عن مكتب لندن الرّئيسيّ
للمُتحرّيات النّجمات بريكيور

244
00:16:58,020 --> 00:17:01,600
هذا بُرهانُ الفجر يا حضرة المُديرة مافورو

245
00:17:04,400 --> 00:17:06,110
وكالة التحرِّي كيوريتّو

246
00:17:08,900 --> 00:17:11,780
أ-أهلاً بكِ في ماكوتو ميراي

247
00:17:11,950 --> 00:17:13,280
!انسَ أمر التّرحيب

248
00:17:14,660 --> 00:17:17,580
...أن يقبل مُخترعٌ مُتحرّيات جديدات

249
00:17:17,750 --> 00:17:20,040
ما الّذي تعلّمته من شينيان؟

250
00:17:21,620 --> 00:17:24,130
حسناً، سأتجاهل الأمر هذه المرّة

251
00:17:27,130 --> 00:17:30,050
سمعتُ كُلَّ شيء من جيت

252
00:17:30,220 --> 00:17:31,010
ماذا؟

253
00:17:31,680 --> 00:17:34,680
أنتِ آنّا أكيتشي وميكورو كوباياشي

254
00:17:34,850 --> 00:17:36,010
!أ-أجل

255
00:17:38,270 --> 00:17:39,270
،رغم ذلك

256
00:17:39,430 --> 00:17:42,560
لم أتوقّع أبداً أن يكون هناك طوقين

257
00:17:46,150 --> 00:17:51,150
لا تتوتّري فقط بسبب وجود مُتحرّية
!نجمة أسطوريّة هنا

258
00:17:52,740 --> 00:17:53,820
توقّعتُ ذلك

259
00:17:55,410 --> 00:17:57,290
رأيتُها في مكانٍ ما من قبل

260
00:17:58,370 --> 00:18:01,580
قلتِ لي بأنّ ديتشي أراكِ ماضي كوريا، صحيح؟

261
00:18:01,750 --> 00:18:03,120
ألم يكن ذلك حينها؟

262
00:18:05,170 --> 00:18:06,920
...ليس كذلك

263
00:18:07,500 --> 00:18:10,510
تسرّني رؤيتكِ ثانية يا مافورو

264
00:18:10,670 --> 00:18:11,670
وأنا كذلك

265
00:18:12,260 --> 00:18:13,260
...المعذرة

266
00:18:13,720 --> 00:18:17,470
!أنا آسفة! كنتُ أعمل كمُساعدة للولوكا سرّاً

267
00:18:17,640 --> 00:18:20,060
!وكنتُ أنا الملِك العظيم

268
00:18:21,020 --> 00:18:24,480
...كـ-كنتُ شادو

269
00:18:26,650 --> 00:18:27,860
أنا آسفة

270
00:18:29,980 --> 00:18:32,360
حدثتْ أمور كثيرة معي أيضاً

271
00:18:32,900 --> 00:18:37,490
لم أتمكّن من المُساعدة بينما
كنتُن تتكبّدن كُلّ هذه المُعاناة

272
00:18:38,870 --> 00:18:40,080
أنا آسفة جدّاً

273
00:18:45,670 --> 00:18:48,540
!لم أتوقّع أبداً أن تأتي إلى هنا

274
00:18:49,670 --> 00:18:51,590
ما المُناسبة؟

275
00:18:51,760 --> 00:18:52,920
...في الواقع

276
00:18:53,090 --> 00:18:54,550
ما هي برأيك؟

277
00:18:54,720 --> 00:18:56,220
هـ-هل هذه حزّورة؟

278
00:18:56,390 --> 00:18:57,970
!أنتِ ماهرة في هذه الأمور

279
00:18:58,800 --> 00:19:00,640
!هذا سؤال صعب

280
00:19:01,560 --> 00:19:03,890
أظنّني لا أملك خياراً

281
00:19:13,860 --> 00:19:14,820
!أنا أراها

282
00:19:16,570 --> 00:19:18,030
الزّهور في الحديقة

283
00:19:20,530 --> 00:19:21,330
أجل

284
00:19:22,910 --> 00:19:23,790
كان هو

285
00:19:25,920 --> 00:19:28,630
ديتشي أغين من نقابة اللّصوص الشّبح

286
00:19:29,210 --> 00:19:31,550
هاجمَ وكالة لندن

287
00:19:33,260 --> 00:19:34,670
هل طاقم الوكالة بخير؟

288
00:19:34,840 --> 00:19:39,100
لا تقلقي، أخرجتُ الجميع في الوقت

289
00:19:39,260 --> 00:19:40,260
هذا مُطمئن

290
00:19:40,430 --> 00:19:43,270
لكن لماذا وكالة لندن؟

291
00:19:44,180 --> 00:19:48,270
كان يبحث عن جوهرة ماكوتو
الّتي جمعَها بوتشيتان

292
00:19:48,770 --> 00:19:52,900
قطع كُلّ المسافة لرؤيتي والسّؤال
عن مكانها

293
00:19:53,980 --> 00:19:55,240
...جوهرة ماكوتو

294
00:19:55,400 --> 00:19:56,860
الخاصّة ببوتشيتان؟

295
00:19:57,780 --> 00:19:58,740
!حسناً إذاً

296
00:19:59,530 --> 00:20:04,080
سأبحث عن الجنّيات اللّواتي تفرّقن

297
00:20:04,790 --> 00:20:05,830
قبل ذلك

298
00:20:06,370 --> 00:20:07,370
خذنَ هذه

299
00:20:09,330 --> 00:20:11,380
أشهرنَ الطّوق الخاصّ بكن

300
00:20:19,340 --> 00:20:20,590
هل هذا...؟

301
00:20:21,100 --> 00:20:24,680
أجل. دبّوس زينة نجم كيرارينغ

302
00:20:25,180 --> 00:20:30,770
من يرتدي خاتم النّجم في الوسط
يمكن أن يصبح مُتحرّية نجمة حقيقيّة

303
00:20:30,940 --> 00:20:35,610
لكن لم يتمكّن أحدٌ من إزالة الخاتم

304
00:20:35,780 --> 00:20:37,530
ولا حتّى أنا

305
00:20:38,240 --> 00:20:39,410
جرّبنَ ذلك

306
00:20:51,920 --> 00:20:53,380
لا أستطيع إخراجه

307
00:20:54,750 --> 00:20:56,550
إنّه لا يُزال بسهولة

308
00:20:57,170 --> 00:20:58,260
...لكن

309
00:20:59,630 --> 00:21:01,300
إليكن ما أعتقده

310
00:21:01,470 --> 00:21:04,560
جميعكن، اللّواتي تغلّبنَ على كثير
،من الصِّعاب

311
00:21:05,060 --> 00:21:07,390
قد يتمكنَّ من إحداث مُعجزة

312
00:21:07,850 --> 00:21:09,020
...مُعجزة

313
00:21:09,890 --> 00:21:12,650
هل يمكنني ترك هذا معكن؟

314
00:21:13,150 --> 00:21:14,020
!أجل

315
00:21:15,980 --> 00:21:20,110
!مُذهل! دبّوس نجم كيرارينغ الحقيقيّ

316
00:21:20,280 --> 00:21:22,570
!لا تُفكّكه لترى آليّة عمله

317
00:21:22,740 --> 00:21:23,700
حاضر

318
00:21:26,200 --> 00:21:30,120
حقّاً؟ يدعك هذا تتواصل معي أينما أذهب؟

319
00:21:30,290 --> 00:21:33,170
إنّه مُنتج مُتقَن من صناعة مُخترق عبقريّ

320
00:21:33,330 --> 00:21:34,960
سأقبله بامتنان

321
00:21:35,540 --> 00:21:38,340
!أنتما، ابقيا واثقتين وثابتتين

322
00:21:38,510 --> 00:21:39,510
!عُلِم

323
00:21:43,050 --> 00:21:44,800
الثّنائي الإعجازيّ؟

324
00:21:45,800 --> 00:21:47,180
أنتما، تشجّعا

325
00:21:49,390 --> 00:21:50,310
!عُلم

326
00:21:57,860 --> 00:21:59,610
!ينبغي أن نذهب إلى المنزل أيضاً

327
00:22:03,030 --> 00:22:04,070
ميكورو؟

328
00:22:04,820 --> 00:22:06,120
!قادمة

329
00:23:47,760 --> 00:23:48,550
ماكوبيون؟

330
00:23:48,720 --> 00:23:49,600
ما هذا؟

331
00:23:49,760 --> 00:23:51,970
!وجدتُها! الدّمية كبيرة الحجم

332
00:23:52,140 --> 00:23:53,060
!إنّها ماكوبيون

333
00:23:53,220 --> 00:23:56,520
!هناك لصّ شبح داخل بدلة الدّمية تلك

334
00:23:57,900 --> 00:24:01,650
!المُتحرِّية النّجمة بريكيور
"وقت الشّاي الخاصّ بأسونوار ونيجي"

335
00:24:02,070 --> 00:24:04,440
!أغلِقَ ملفّ قضيّة اللّغز كيوريتّو