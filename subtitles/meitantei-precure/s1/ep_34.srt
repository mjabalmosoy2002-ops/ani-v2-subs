1
00:00:19,100 --> 00:00:20,980
!توقّف

2
00:00:29,280 --> 00:00:31,370
!إنّه يتوجّه نحو الشّارع

3
00:00:31,530 --> 00:00:32,820
!دعي الأمر لي

4
00:00:35,870 --> 00:00:37,290
لن تفلتوا

5
00:00:37,450 --> 00:00:38,750
يا نقابة اللُّصوص الشّبح

6
00:00:41,330 --> 00:00:42,460
كشفتني؟

7
00:00:42,960 --> 00:00:43,960
!أغيسيني

8
00:00:48,380 --> 00:00:50,340
!أ-أنتِ

9
00:00:50,930 --> 00:00:52,510
لا ينبغي أن نرخي دفاعنا

10
00:00:53,260 --> 00:00:56,100
!هذا رديء! ستندمين على ذلك

11
00:00:57,890 --> 00:00:59,850
!مرحى

12
00:01:00,770 --> 00:01:03,020
لنُعده إلى مالكه

13
00:01:03,190 --> 00:01:05,440
أنا متأكّدة بأنّه قلق

14
00:01:05,610 --> 00:01:07,150
إلى أين ينبغي أن نأخذه؟

15
00:01:07,730 --> 00:01:10,280
...نبّهتنا بوتشيتان

16
00:01:11,570 --> 00:01:14,370
...لكن كان قد سُرِقَ عندما وجدناه بالفعل

17
00:01:15,030 --> 00:01:18,160
مِمَّن سُرِقَ إذاً، وأين؟

18
00:01:20,330 --> 00:01:23,170
!لا نعلم

19
00:01:29,840 --> 00:01:33,720
!لنبحث عن اللّمحة في القلب

20
00:01:33,890 --> 00:01:36,760
إلهام مُشرِق

21
00:01:37,100 --> 00:01:39,730
أنا متأكّدة بأنّنا سنجدها
نحن بريكيور في نهاية المطاف

22
00:01:39,890 --> 00:01:42,440
إنّها تنادينا

23
00:01:42,600 --> 00:01:45,360
أين الحقيقة؟ ما الّذي ستكتشفه؟

24
00:01:45,520 --> 00:01:49,110
لغز تلو الآخر

25
00:01:49,780 --> 00:01:55,160
اجمعوا القِطع من الآن
إلى الماضي والمُستقبل

26
00:01:55,320 --> 00:02:00,410
كما الدّليل! شيء يلمع عبر الزّمن

27
00:02:00,660 --> 00:02:03,330
كيف؟ كيف؟ أهي خدعة؟

28
00:02:03,500 --> 00:02:06,290
لماذا؟ لماذا؟ سوف نواجهها

29
00:02:06,590 --> 00:02:11,880
لننظر ونشعر
نكتشف الأسرار

30
00:02:12,220 --> 00:02:17,720
خطوة شُجاعة واحدة ستؤدّي إلى مُعجزة

31
00:02:18,100 --> 00:02:23,270
الجواب؟! عُثِر عليه عندما
تُلاحظ ما هو غير مُلاحَظ

32
00:02:23,600 --> 00:02:29,070
إنّه القدر، إنّه الحُبّ الّذي
هُمِس به بصوت مُنخفض

33
00:02:29,230 --> 00:02:32,530
!لنمشِ في ذلك الطّريق معاً

34
00:02:32,690 --> 00:02:36,450
!لنبحث عن اللّمحة في القلب

35
00:02:36,620 --> 00:02:38,280
إلهام مُشرِق

36
00:02:38,450 --> 00:02:44,080
مفتاح الجوهرة الّذي يربطنا يفتح
الرّابط ليمضي بنا قُدماً

37
00:02:44,250 --> 00:02:49,170
ولادتنا ولقاؤنا لَهو لغز رائع

38
00:02:49,340 --> 00:02:52,800
!هيّا يا بريكيور المُتحرّيات النّجمات

39
00:02:59,430 --> 00:03:03,980
لولوكا والبدر الذّهبيّ

40
00:03:04,480 --> 00:03:06,480
!المعذرة

41
00:03:06,650 --> 00:03:11,230
نبحث عن مالك هذا الصّندوق الخشبيّ

42
00:03:11,400 --> 00:03:14,280
...أداة مفقودة؟ في هذه الحالة

43
00:03:14,440 --> 00:03:20,080
المعذرة، ليست أداة مفقودة، سُرِقَتْ
بواسطة نقابة اللُّصوص الشّبح

44
00:03:21,280 --> 00:03:22,080
!ماذا؟

45
00:03:24,540 --> 00:03:27,460
أنتُن من وكالة التحرِّي كيوريتّو؟

46
00:03:28,000 --> 00:03:29,920
أنتن صغيرات حقّاً

47
00:03:30,090 --> 00:03:31,920
سمعتُ بعملكن

48
00:03:33,340 --> 00:03:35,050
!أيّتها المُتحرِّيات

49
00:03:35,550 --> 00:03:36,840
...هذا الصّوت

50
00:03:42,060 --> 00:03:44,980
شيروكو إييري

51
00:03:45,600 --> 00:03:47,600
شيروكو، ما هذا الزيّ؟

52
00:03:49,230 --> 00:03:54,070
!شيروكو إييري، رئيسة شرطة ليوم واحد

53
00:03:54,900 --> 00:03:57,070
!ر-رائعة للغاية

54
00:04:07,790 --> 00:04:10,380
لماذا أتيتُن أيّتها المُتحرِّيات إلى الشّرطة؟

55
00:04:10,540 --> 00:04:11,960
...في الواقع

56
00:04:12,500 --> 00:04:15,380
إذاً لا تعرفنَ من هو المالك؟

57
00:04:15,550 --> 00:04:16,510
أجل

58
00:04:16,670 --> 00:04:18,840
لا نعلم ماذا نفعل

59
00:04:19,010 --> 00:04:23,050
دعنَ الأمر لي! تُجرى مُقابلة معي
كرئيسة ليوم واحد في الواقع

60
00:04:23,220 --> 00:04:25,810
!إذا أخبرتِ الجميع بأنّه هنا

61
00:04:25,970 --> 00:04:27,520
!فسيأتي المالك

62
00:04:27,680 --> 00:04:28,560
أجل

63
00:04:28,730 --> 00:04:31,230
حسناً، ما بداخل الصّندوق؟

64
00:04:31,400 --> 00:04:33,820
ما يُشبه مخطوطة قديمة

65
00:04:33,980 --> 00:04:36,070
لا نعرف الكثير عنها

66
00:04:36,230 --> 00:04:38,200
،وجدتُها! بالنّسبة لأشياء كهذه

67
00:04:38,360 --> 00:04:40,700
يمكننا أن نطلب من شخص مُعيّن

68
00:04:41,570 --> 00:04:45,120
!مرحباً يا فتيات! أنتن بمعنويّات عالية كالعادة

69
00:04:41,570 --> 00:04:49,250
مكتب الاستقبال

70
00:04:45,290 --> 00:04:46,540
!سيّدة هوشو

71
00:04:46,700 --> 00:04:48,910
!شكراً على قطع كُلّ هذه المسافة

72
00:04:50,290 --> 00:04:51,960
تشينامي هوشو

73
00:05:01,180 --> 00:05:06,470
سمعتُ بأنّه لديكن شيء أنا، كمالِكة
متحف فنون، أستطيع المُساعدة فيه؟

74
00:05:06,640 --> 00:05:08,480
أجل، من فضلكِ

75
00:05:09,560 --> 00:05:10,770
لنفتح الغطاء

76
00:05:10,940 --> 00:05:13,270
تبدو كمخطوطة

77
00:05:15,520 --> 00:05:19,320
!ماذا؟ يا للهول! يا للهول

78
00:05:19,490 --> 00:05:20,400
ما الخطب؟

79
00:05:20,570 --> 00:05:22,660
!اسمعنَ يا فتيات

80
00:05:22,950 --> 00:05:25,160
،إنّه عملٌ فنِّي مشهور يعود لفترة إيدو

81
00:05:25,330 --> 00:05:29,080
قمر بلا أميرة" الخاصّ بموتونوبو شيراكاوا"

82
00:05:29,250 --> 00:05:31,000
أهو مُميّزٌ حقّاً؟

83
00:05:31,160 --> 00:05:33,040
!بالطّبع هو كذلك

84
00:05:33,210 --> 00:05:35,540
،منذ 400 عام

85
00:05:35,710 --> 00:05:40,800
عندما كانت طوكيو إيدو، صنع موتونوبو شيراكاوا
لوحته الجميلة الوحيدة

86
00:05:40,970 --> 00:05:45,220
نُقِلَتْ إلى أوروبّا حيث ألهمت
الانطباعيّين، ثمّ فُقِدت

87
00:05:45,390 --> 00:05:47,930
!إنّها "قمر بلا أميرة" الأسطوريّة

88
00:05:48,100 --> 00:05:51,480
إ-إذاً هذا يعني بأنّها مُدهشة حقّاً؟

89
00:05:51,640 --> 00:05:53,810
!مذكورة في هذا الكتاب حتّى

90
00:05:54,350 --> 00:05:56,820
!بالفعل! إنّها نفسها تماماً

91
00:05:57,320 --> 00:05:59,780
لكن المخطوطة الحقيقيّة مُمزَّقة

92
00:05:59,940 --> 00:06:03,780
يبدو أنّ هذا التّمزيق حدث منذ زمن بعيد

93
00:06:03,950 --> 00:06:06,740
!على أيّ حال، قيمتها التّاريخيّة لا تتغيّر

94
00:06:06,910 --> 00:06:08,870
!من الواضح أنّها تُساوي بضعة مليارات

95
00:06:09,040 --> 00:06:13,040
!هذا يُحفِّز قلبي المُولع بالجمع
!تحفيز، تحفيز، تحفيز

96
00:06:13,210 --> 00:06:14,250
!سيّدة هوشو؟

97
00:06:16,380 --> 00:06:21,210
ينبغي أن نبرز الصُّورة من الكتاب في التّلفزيون

98
00:06:21,380 --> 00:06:23,130
أجل. أتّفق

99
00:06:23,300 --> 00:06:24,430
!سأُجرّب ذلك

100
00:06:25,840 --> 00:06:28,430
!شيروكو! حان وقت مُقابلتكِ

101
00:06:28,600 --> 00:06:29,600
!حسناً

102
00:06:30,640 --> 00:06:33,640
حضرة الرّئيس شيروكو، هل من كلمات أخيرة؟

103
00:06:34,190 --> 00:06:40,610
"أجل! نبحث عن مالِك "قمر بلا أميرة
الخاصّة بموتونوبو شيراكاوا

104
00:06:40,780 --> 00:06:45,360
الرّجاء الاتّصال بمحطّة شرطة ماكوتو
ميراي حالما تحصلون على معلومات

105
00:06:45,990 --> 00:06:47,870
!شكراً على المُساعدة

106
00:06:56,670 --> 00:06:57,670
!قادمة

107
00:07:00,590 --> 00:07:02,340
هذه أنتِ

108
00:07:06,380 --> 00:07:08,550
أنا آسفة عن المرّة السّابقة

109
00:07:10,350 --> 00:07:12,560
إنّه ليس شيئاً ينبغي أن أغفر له

110
00:07:13,310 --> 00:07:18,520
لكن الشّخص الّذي سرقَ قرط أذني
من غرفة الملابس كان ذلك الرّجل

111
00:07:19,110 --> 00:07:21,480
لكن كنتُ مع اللُّصوص الشّبح

112
00:07:22,070 --> 00:07:25,490
،احتفظتُ بقرط أذني لكِ في ذلك اليوم

113
00:07:25,650 --> 00:07:27,950
لكن توقّعتُ ألّا تأخذيه

114
00:07:28,320 --> 00:07:29,780
ماذا؟ لماذا؟

115
00:07:30,620 --> 00:07:31,830
أخبرتُكِ

116
00:07:31,990 --> 00:07:37,040
المُمثِّلون يُراقبون دوماً النّاسَ"
"وذلك كي يتمكّنون من تقليدهم

117
00:07:38,710 --> 00:07:41,960
في ذلك اليوم، كنتِ تلعبين دور لصّ شبح

118
00:07:42,590 --> 00:07:44,420
أنا مُمثّلة، لذا أستطيع التّمييز

119
00:07:44,960 --> 00:07:46,760
لستِ شخصاً سيّئاً

120
00:07:47,590 --> 00:07:49,390
--حتّى الآن، أنا

121
00:07:51,810 --> 00:07:54,850
!لا تطلقي افتراضات بشأن نفسكِ

122
00:07:57,270 --> 00:07:59,190
صديقاتكِ يفهمنَكِ

123
00:07:59,350 --> 00:08:00,440
أليس كذلك؟

124
00:08:02,980 --> 00:08:07,900
،ناعم كالحرير في فمي. بالنّسبة لي
إنّه آيس كريم حريريّ

125
00:08:08,780 --> 00:08:11,830
.حصلتُ على بعض منه كهديّة
هل تريدين واحدة؟

126
00:08:12,580 --> 00:08:13,740
شكراً لكِ

127
00:08:22,290 --> 00:08:26,760
،إذا أعدنا المخطوطةَ إلى مالكها
ماذا عن جوهرة ماكوتو؟

128
00:08:26,920 --> 00:08:28,470
أجل

129
00:08:28,630 --> 00:08:31,430
!أستطيع بوتشي بوتشي! كيور كيور

130
00:08:31,590 --> 00:08:32,680
المعذرة

131
00:08:33,970 --> 00:08:35,930
بـ-بـ-بما يمكنني خدمتكِ؟

132
00:08:36,310 --> 00:08:38,140
أتى مالكٌ

133
00:08:38,310 --> 00:08:41,150
المُشكلة الوحيدة أنّه يوجد ثلاثة منهم

134
00:08:41,690 --> 00:08:42,480
ماذا؟

135
00:08:45,230 --> 00:08:48,190
إنّه كنز عائليّ يعود لأجيال

136
00:08:48,360 --> 00:08:51,410
!وجدتموها أخيراً! إنّها لي

137
00:08:51,910 --> 00:08:54,120
هذه مُلك جدّي

138
00:08:54,910 --> 00:08:56,370
ما الّذي يجري؟

139
00:08:56,540 --> 00:08:58,580
...اثنان من أولئك الثّلاثة

140
00:08:58,750 --> 00:09:00,540
يكذبان...

141
00:09:00,710 --> 00:09:03,000
إذاً لنتكلّم معهم

142
00:09:04,630 --> 00:09:07,260
كنتَ خارج البلاد حتّى الأسبوع الماضي؟

143
00:09:07,420 --> 00:09:09,920
عدتَ إلى اليابان للتو؟

144
00:09:10,090 --> 00:09:13,930
أجل. سمعتُ بوجود مخطوطة
فُقِدت في بلاد الخارج

145
00:09:14,550 --> 00:09:16,600
رحلتُ إلى جزيرة جنوبيّة

146
00:09:16,770 --> 00:09:21,770
.كنتُ أتصبّب عرقاً تحت شمس حارقة
!كان ذلك قاسياً

147
00:09:22,350 --> 00:09:26,230
لكن سمعتُ عن تاجرة حِرفيّات عتيقة
!فوجدتُها هنا

148
00:09:26,820 --> 00:09:28,230
هكذا إذاً

149
00:09:28,400 --> 00:09:31,950
وحالما أخذتُها إلى المنزل، سُرِقت

150
00:09:32,110 --> 00:09:33,910
وهذا دليلي

151
00:09:35,870 --> 00:09:37,330
بئساً، ليس هذا

152
00:09:39,330 --> 00:09:41,790
من الواضح أنّ هذا تاريخ الأسبوع الماضي

153
00:09:42,710 --> 00:09:44,750
لهذا أصبحت بشرتك سمراء إذاً

154
00:09:45,250 --> 00:09:50,720
أجل. كانت لديّ لحية كثيفة وشعر أشعث

155
00:09:51,670 --> 00:09:52,930
لحية...؟

156
00:09:53,090 --> 00:09:55,390
حلقتُها قبل مجيئي إلى هنا

157
00:09:55,550 --> 00:09:57,600
كذبتَ للتو

158
00:09:57,760 --> 00:09:58,560
ماذا؟

159
00:09:59,180 --> 00:10:02,940
،لو كنتَ تمشي تحت شمس حارقة مُلتحياً

160
00:10:03,100 --> 00:10:06,860
فالمنطقة المُحيطة بفمك وذقنك
لن تسمرّ حينها

161
00:10:07,020 --> 00:10:10,490
لكن وجهك أسمر بالكامل

162
00:10:11,150 --> 00:10:13,700
،سافرتَ إلى بلاد الخارج مُؤخّراً
هذا كُلّ ما في الأمر

163
00:10:13,860 --> 00:10:21,160
أنا آسفة! رأيتُ "قمر بلا أميرة" في التّلفزيون
!وكان الحُبّ من أوّل نظرة

164
00:10:21,330 --> 00:10:23,210
!أنت! ادخل إلى هنا حالاً

165
00:10:23,370 --> 00:10:25,500
إنّه واحد منهما

166
00:10:26,080 --> 00:10:28,960
أحدهما من خارج البلاد. ماذا يمكننا أن نفعل؟

167
00:10:29,550 --> 00:10:30,840
...هذا يستلزم

168
00:10:34,260 --> 00:10:35,140
!افتحي

169
00:10:37,890 --> 00:10:39,220
!حلوى بري-كيت الصّمغيّة

170
00:10:40,560 --> 00:10:41,350
!تفضّلي

171
00:10:41,770 --> 00:10:43,810
!سنكون بخير إذا تناولنا الحلوى الصّمغيّة

172
00:10:44,730 --> 00:10:47,190
كلتانا نستطيع التحدُّث بالإنجليزيّة

173
00:10:47,360 --> 00:10:48,270
أجل

174
00:10:48,440 --> 00:10:50,980
!لكن تبدو لذيذة، لذا لنُجرّبها

175
00:10:56,200 --> 00:10:57,620
!شهيّة

176
00:10:59,200 --> 00:11:03,790
إذاً يا رايان، أنت تنوي الانتقال قريباً

177
00:11:03,960 --> 00:11:08,790
،أجل، لذا كنتُ أُرتِّب المنزل
فصادفَ إيجادي لها

178
00:11:08,960 --> 00:11:12,760
قبل ذلك الحين، لم تكن تعلم بالمخطوطة؟

179
00:11:13,420 --> 00:11:14,220
لا

180
00:11:14,380 --> 00:11:18,970
كان جدِّي يُحبّ الأثريّات، لذا
لا بُدّ أنّه حصلَ عليها في مكانٍ ما

181
00:11:19,140 --> 00:11:23,730
بدا أنّه يُقدّرها، لكن سرعان
ما اكتشفتُ بأنّها اختفت

182
00:11:26,060 --> 00:11:28,860
أنتِ مُعلِّمة مراسم شاي؟

183
00:11:29,020 --> 00:11:31,440
أين حصلتِ على المخطوطة؟

184
00:11:31,980 --> 00:11:35,400
إنّها كنزٌ عائليّ نمتلكه منذ أجيال

185
00:11:35,900 --> 00:11:37,360
أين تكون في العادة؟

186
00:11:37,530 --> 00:11:41,580
عرضناها على الجدار. ثمّ اختفت ذات يوم

187
00:11:41,740 --> 00:11:45,000
لم أكن أعلم بأنّها قيِّمة جدّاً

188
00:11:46,410 --> 00:11:47,830
أحقّاً ذلك؟

189
00:11:50,170 --> 00:11:53,460
كلاهما لم يقولا أيّ كلام غريب

190
00:11:53,630 --> 00:11:58,340
رايان ويوشي قالا بأنّهما لم يكونا
مُدركين لقيمة المخطوطة

191
00:11:58,510 --> 00:12:03,180
كلاهما قالا بأنّها اختفتْ ذات
يوم فحسب، أيضاً

192
00:12:05,560 --> 00:12:06,430
لولوكا؟

193
00:12:08,940 --> 00:12:11,190
الآيس كريم والغموض سيذوبان في نهاية المطاف

194
00:12:12,690 --> 00:12:14,320
ذلك الشّخص هو الجاني

195
00:12:23,870 --> 00:12:25,200
ماذا؟

196
00:12:25,790 --> 00:12:27,710
ما الّذي تقولين بأنّني فعلت؟

197
00:12:28,460 --> 00:12:31,630
قلتِ بأنّكِ علّقتِها على الجدار

198
00:12:31,790 --> 00:12:33,210
أجل، وماذا يعني؟

199
00:12:33,380 --> 00:12:37,170
الصُّورة الّتي عرَضتها شيروكو
في التّلفزيون كانت من كِتاب

200
00:12:37,340 --> 00:12:39,180
ما علاقة ذلك بالأمر؟

201
00:12:39,720 --> 00:12:44,640
،المخطوطة الحقيقيّة مُمزّقة إلى نصفين
لذا لا يمكن أن تتمكّني من تعليقها

202
00:12:45,390 --> 00:12:46,640
!...لـ-لكن

203
00:12:46,810 --> 00:12:49,140
مُزِّقَتْ بعد أن سُرِقَتْ

204
00:12:49,310 --> 00:12:51,400
،عندما استرجعناها

205
00:12:52,020 --> 00:12:54,440
كان الصّندوق مربوطاً بإحكام بواسطة حبل

206
00:12:55,020 --> 00:13:00,780
،منذ سرقته وصولاً إلى البحث في داخله
لم يُفتح الصّندوق

207
00:13:01,240 --> 00:13:04,280
من غير المُرجَّح أن تكون قد مُزِّقَت
بعد أن سُرِقَتْ

208
00:13:04,990 --> 00:13:08,870
على أيّ حال، مُزِّقَت المخطوطة قبل زمن بعيد

209
00:13:09,040 --> 00:13:11,290
لا يمكن أن تكون مُعلَّقة على جداركِ

210
00:13:12,670 --> 00:13:18,260
،سرقتِ المخطوطةَ من منزل رايان
مع الصّندوق

211
00:13:18,760 --> 00:13:21,220
لهذا لم تعلمي بأنّها كانت مُمزَّقة

212
00:13:21,760 --> 00:13:22,840
،أليس كذلك

213
00:13:23,340 --> 00:13:24,550
يا أغيسيني؟

214
00:13:25,600 --> 00:13:28,140
هذا مُخيّب حقّاً

215
00:13:28,640 --> 00:13:30,350
!طوِّقي أيّتها الأكاذيب

216
00:13:31,060 --> 00:13:34,360
!دعها تُحلِّق! هانّيندا

217
00:13:40,400 --> 00:13:42,780
!هانّيندا

218
00:13:46,990 --> 00:13:48,200
!هانّيندا

219
00:13:50,370 --> 00:13:51,160
!توقّفي

220
00:13:51,330 --> 00:13:52,670
لن تفلتي

221
00:13:53,460 --> 00:13:54,460
!افتحي

222
00:14:03,340 --> 00:14:05,050
!عصا أركانا المُنيرة

223
00:14:09,020 --> 00:14:11,180
!بريكيور! حان وقت الاستيقاظ

224
00:14:14,190 --> 00:14:16,690
المعي أيّتها الزّنبقة البيضاء

225
00:14:25,530 --> 00:14:26,820
!صنبور الزّهور

226
00:14:47,390 --> 00:14:54,480
،الضّوء الأبيض الّذي يُنير الحقيقة
!المُتحرّية النّجمة، كيور أركانا

227
00:15:00,230 --> 00:15:01,150
!افتح

228
00:15:07,240 --> 00:15:09,240
!عطر لولب ليلي

229
00:15:11,910 --> 00:15:14,500
!بريكيور! وقت الاستيقاظ

230
00:15:15,080 --> 00:15:16,420
،الدّوران الورديّ

231
00:15:32,720 --> 00:15:33,770
!تفتّحي

232
00:15:56,330 --> 00:15:57,870
!استيقظي

233
00:15:58,040 --> 00:16:03,750
عطر الحقيقة الدّاخليّة، المُتحرّية
!النّجمة كيور إكلير

234
00:16:10,760 --> 00:16:11,890
!افتحي

235
00:16:16,850 --> 00:16:18,690
!ساعة جوهرة كيور

236
00:16:21,440 --> 00:16:24,070
!بريكيور! وقت الاستيقاظ

237
00:16:24,230 --> 00:16:26,190
!ثلاثة! اكتشفي

238
00:16:38,870 --> 00:16:40,880
!ستّة! وواجها بعضيكما الآخر

239
00:16:52,850 --> 00:16:55,140
!تسعة! نحن الثّنائي الإعجازيّ

240
00:17:04,480 --> 00:17:06,190
!دوري

241
00:17:06,360 --> 00:17:08,360
!وأنهي الأمر بشكل ظريف

242
00:17:32,220 --> 00:17:38,220
!النّجمة الذّهبيّة تُغلق ملفّ كلّ غموض
!المُتحرّية النّجمة، أنسر كيور

243
00:17:40,310 --> 00:17:43,650
القفز تجاه بسمات باستنتاج مُتعدّد الأوجه

244
00:17:43,810 --> 00:17:46,940
!المُتحرّية النّجمة، كيور ميستيك

245
00:17:51,110 --> 00:17:53,160
!المُتحرّية النّجمة بريكيور

246
00:17:55,780 --> 00:17:58,240
سأُريك إجابتي

247
00:18:00,410 --> 00:18:02,420
!يبدو الجميع مُبتهجات

248
00:18:02,580 --> 00:18:03,370
!أجل

249
00:18:05,290 --> 00:18:07,750
!التفاف! التفاف! التفاف

250
00:18:07,920 --> 00:18:10,170
!هان-ني هان-ني هان

251
00:18:10,340 --> 00:18:11,420
لن أسمح بذلك

252
00:18:18,560 --> 00:18:20,430
!نجمة أركانا اللّامعة

253
00:18:27,360 --> 00:18:28,610
!هانّيندا

254
00:18:28,770 --> 00:18:31,530
!لم ينتهِ الأمر بعد! والآن انكزهن

255
00:18:31,690 --> 00:18:33,240
!هانّيندا

256
00:18:36,910 --> 00:18:38,450
!ها! هانّيندا

257
00:18:38,620 --> 00:18:39,740
!الآن هي فُرصتنا

258
00:18:39,910 --> 00:18:41,620
!دا

259
00:18:41,790 --> 00:18:42,830
!مهلاً

260
00:18:43,000 --> 00:18:44,540
والآن الحركة الأخيرة

261
00:18:52,670 --> 00:18:53,670
!ماشوتان

262
00:18:56,390 --> 00:18:57,430
جوهرة ماكوتو

263
00:19:02,560 --> 00:19:04,310
...ستُغلق كيور أركانا هذه القضيّة

264
00:19:10,190 --> 00:19:12,230
هذه هي إجابتي

265
00:19:13,610 --> 00:19:17,200
!بريكيور! الزّنبقة البيضاء أركانا

266
00:19:30,340 --> 00:19:32,000
!تمّ إغلاق ملفّ القضيّة كيوريتّو

267
00:19:32,960 --> 00:19:37,640
!هان! نين! دا

268
00:19:46,390 --> 00:19:49,230
!بوتشي بوتشي كيور كيور

269
00:19:52,650 --> 00:19:55,280
!بئساً! هذا يستفزّني كثيراً

270
00:19:55,440 --> 00:19:57,660
!ليس عدلاً أن تتكاثرنَ عليّ

271
00:19:58,110 --> 00:19:59,660
!هذا رديء جدّاً

272
00:20:02,200 --> 00:20:03,910
شكراً لكُن أيّتها المُتحرّيات

273
00:20:05,040 --> 00:20:07,670
سيكون جدّي سعيداً

274
00:20:08,290 --> 00:20:09,460
يسرّني ذلك

275
00:20:10,040 --> 00:20:14,630
أتساءل ما إن كنتُ أستطيع
طلب مُساعدة منكن؟

276
00:20:15,090 --> 00:20:15,880
ماذا؟

277
00:20:17,380 --> 00:20:19,550
إصلاح المخطوطة؟

278
00:20:19,720 --> 00:20:22,260
أجل، طلب من رايان، المالِك

279
00:20:22,430 --> 00:20:27,480
كان يتساءل ما إن كان من المُمكن استعادة
قمر بلا أميرة" بالكامل"

280
00:20:28,020 --> 00:20:29,980
سيكون ذلك شرفاً لي

281
00:20:30,150 --> 00:20:35,650
أعرف مِهنيّاً مُحترفاً يستطيع إصلاحها

282
00:20:36,110 --> 00:20:38,070
!شكراً جزيلاً لكِ

283
00:20:41,200 --> 00:20:44,240
بالمُناسبة. ما اسمكِ؟

284
00:20:45,870 --> 00:20:47,460
لولوكا موريا

285
00:20:48,000 --> 00:20:51,330
في الواقع، عليّ أن أعتذر لكِ

286
00:20:51,790 --> 00:20:52,750
لولوكا

287
00:20:53,090 --> 00:20:55,340
ماذا تقصدين بالضّبط؟

288
00:20:56,010 --> 00:21:02,300
"كنتُ لصّة شبح، سرقتْ "أميرة ضوء النّجم
من متحفكِ

289
00:21:02,470 --> 00:21:06,020
يا إلهي! اليوم مليء بالمُفاجآت

290
00:21:06,180 --> 00:21:08,520
أنا آسفة على ما فعلتُه

291
00:21:12,480 --> 00:21:13,560
حسناً

292
00:21:14,060 --> 00:21:19,570
لكن في ذلك اليوم، سرقتِ النّسخةَ
"المُزيّفة من "أميرة ضوء النّجم

293
00:21:20,150 --> 00:21:23,200
لذا أُسامحكِ هذه المرّة

294
00:21:24,530 --> 00:21:26,160
...لكن... أنا

295
00:21:26,660 --> 00:21:32,370
بفضل ذلك الحادث، قرّرتُ عرض
الحقيقيّة، لذا الأمور بخير

296
00:21:34,040 --> 00:21:35,460
شكراً لكِ

297
00:21:38,460 --> 00:21:39,550
وأيضاً

298
00:21:43,090 --> 00:21:46,390
يمكن إصلاح علاقات البشر كذلك

299
00:21:47,260 --> 00:21:50,390
"تماماً مثل "قمر بلا أميرة

300
00:21:51,690 --> 00:21:55,440
...في تلك اللّيلة كان قمراً مُتناقصاً. لكن اللّيلة

301
00:22:11,870 --> 00:22:13,960
إنّه بدرٌ ذهبيّ

302
00:23:47,220 --> 00:23:50,140
لولوكا وكوريا ستنتقلان إلى المدرسة الثّانويّة؟

303
00:23:50,300 --> 00:23:53,520
رسالة حُبّ بلا عنوان وُجِدت
في غرفة الصّفّ

304
00:23:53,680 --> 00:23:55,310
من أسقطها؟

305
00:23:55,480 --> 00:23:57,900
!دعنَ ألغاز القلب لي

306
00:23:58,350 --> 00:24:01,610
!المُتحرِّية النّجمة بريكيور
"مُتحرِّيات الحُبّ"

307
00:24:01,770 --> 00:24:04,190
!أغلِقَ ملفّ قضيّة اللّغز كيوريتّو