1
00:00:03,450 --> 00:00:06,270
.هناك رجل يقطع مصيرهُ

2
00:00:06,730 --> 00:00:09,050
.وهناك رجل يتحدى السماوات

3
00:00:09,500 --> 00:00:13,470
...هذا هو مصير "هوكُتو شينكين" لـ 2000 عام

4
00:00:14,180 --> 00:00:15,140
!أُنظر

5
00:00:15,390 --> 00:00:20,250
!الآن، تاريخ الدماء الطويل هذا أوشك على الانتهاء

6
00:00:38,220 --> 00:00:45,020
هوكُتو نو كين

7
00:00:38,220 --> 00:00:45,020
قبضة نجمُ الشمال

8
00:01:52,420 --> 00:02:03,720
!مواجهةٌ في هوكُتو رينكيتوزا

9
00:01:52,420 --> 00:02:03,720
!!لا أحد يستطيع إيقافهما الآن

10
00:02:16,000 --> 00:02:18,410
!"هوكُتو رينكيتوزا"

11
00:02:18,580 --> 00:02:20,180
.كما توقعت هذا المكان

12
00:02:24,960 --> 00:02:26,160
.كينشيرو

13
00:02:26,940 --> 00:02:30,490
لدفن عظامك وتاريخ الـ"هوكُتو" المُمتد لـ 2000 عام

14
00:02:30,630 --> 00:02:32,930
.فلا يوجد مكان أفضل من هذا

15
00:02:33,180 --> 00:02:36,420
!رأو، لن تُسيطر على السماوات

16
00:02:36,540 --> 00:02:39,420
.ستموت هُنا مع طموحك

17
00:02:44,340 --> 00:02:47,810
!لم أعُد مهتمًا بالسماوات

18
00:02:50,650 --> 00:02:55,720
.ما أردتهُ بدلًا من السماوات ربما كان أنت

19
00:03:06,420 --> 00:03:07,860
!كينشيرو

20
00:03:08,100 --> 00:03:12,200
!أقوى ذابح للـ"هوكُتو" سيكون رأو

21
00:03:12,900 --> 00:03:16,660
.رأو سيبدأ تاريخ جديد للقوة النهائية الحقيقية

22
00:03:17,020 --> 00:03:18,970
.أنت مَنْ سيموت

23
00:03:19,380 --> 00:03:22,970
..."رأو، أنت الرجل الوحيد الذي خرق قانون الـ"هوكُتو

24
00:03:23,140 --> 00:03:26,110
"وبصفتي وريثًا لـ "هوكتو شينكين

25
00:03:26,450 --> 00:03:28,820
.لن أُسامحك

26
00:03:30,370 --> 00:03:32,850
!كينشيرو
.سأُحطمك حتى الموت

27
00:03:51,850 --> 00:03:53,810
..."موسو تينسي"

28
00:03:53,920 --> 00:03:56,450
تقنية يُتقنها فقط مَنْ يُعانون من الحزن الحقيقة؛

29
00:03:56,460 --> 00:03:59,070
!"التقنية الأسطورية للـ"هوكُتو

30
00:03:59,660 --> 00:04:02,790
أمام "موسو تينسي" التقنية المُطلقة للـ"هوكُتو"؛

31
00:04:02,880 --> 00:04:04,450
.ينتظرك الموت فحسب

32
00:04:09,600 --> 00:04:11,180
!هذه نهايتك

33
00:04:23,910 --> 00:04:25,170
ر-رأو؟

34
00:04:25,240 --> 00:04:27,850
أأنت أيضًا أتقنت "موسو تينسي"؟

35
00:04:28,390 --> 00:04:33,020
.حتى أنا قلبي حافل بالدماء والحُزن

36
00:04:33,520 --> 00:04:34,490
ماذا؟

37
00:04:34,760 --> 00:04:35,920
!ذاك

38
00:04:55,610 --> 00:04:56,250
!كين

39
00:04:56,790 --> 00:04:57,250
!أوي

40
00:05:00,110 --> 00:05:01,210
...يوريا

41
00:05:10,200 --> 00:05:11,190
يوريا-سان؟

42
00:05:12,880 --> 00:05:15,720
رأو، أيُّها الوغد ما الذي فعلتهُ لـ يوريا؟

43
00:05:16,060 --> 00:05:18,390
!تأكد مِنْ هذا بعيناك

44
00:05:46,670 --> 00:05:48,060
...يوريا

45
00:05:53,470 --> 00:05:56,690
.المرأة الأولى التي وضعتُ يدي عليها

46
00:05:59,200 --> 00:06:05,270
!"لكِنّ بسبب حياتها أتقنتُ "موسو تينسي

47
00:06:11,350 --> 00:06:15,510
.يوريا... أعطيني حياتكِ

48
00:06:23,120 --> 00:06:24,500
حياتي؟

49
00:06:24,510 --> 00:06:25,200
.صحيح

50
00:06:26,420 --> 00:06:28,430
!سأْخُذ حياتكِ

51
00:06:29,010 --> 00:06:30,630
!سامحيني يا يوريا

52
00:06:32,020 --> 00:06:36,020
!عِشِ بحزنٍ في قلبي

53
00:06:54,430 --> 00:06:55,550
.انتهى الأمر

54
00:07:12,290 --> 00:07:15,850
...يوريا-سان

55
00:07:18,420 --> 00:07:20,580
.والآن كل شيء سينتهي

56
00:07:21,810 --> 00:07:23,570
...لقد كانت رحلة طويلة

57
00:07:39,930 --> 00:07:44,210
.نحنُ جيش كين-أوه أخيرًا أدركنا أن القتال لا فائدة تُرجى منهُ

58
00:07:44,240 --> 00:07:44,830
.بلى

59
00:07:44,830 --> 00:07:46,860
.والفضل يعود إلى يوريا-ساما

60
00:07:46,900 --> 00:07:48,810
،سواءً كُنت صديقًا أو عدوًا

61
00:07:48,840 --> 00:07:52,160
!"وهبت لنا الضوء اللطيف للـ"نانتو جيبو-سي

62
00:07:52,320 --> 00:07:56,440
!بعد أن رأينا يوريا-ساما اِستيقظنا أخيرًا

63
00:07:57,430 --> 00:07:59,060
!ولكِنّ الآوان قد فات

64
00:07:59,410 --> 00:08:00,520
...يوريا-ساما

65
00:08:00,810 --> 00:08:01,890
...يوريا-ساما قد

66
00:08:02,990 --> 00:08:07,230
.إِذًا، رأو وضع يداهُ على محبوبتهُ وذرف الدموع

67
00:08:08,050 --> 00:08:11,770
...شاهدوا هذا، جميعهم أدركوا أن القتال لا جدوى منهُ

68
00:08:12,000 --> 00:08:14,270
.وقوة الحُب

69
00:08:18,540 --> 00:08:22,950
!واختاروا حب عائلاتهم على القتال عديم الجدوى

70
00:08:27,520 --> 00:08:29,220
..."بينما نحنُ نجوم الـ"غوشا

71
00:08:29,580 --> 00:08:33,590
.لم نستطيع حماية يوريا-ساما حتى النهاية

72
00:08:35,960 --> 00:08:42,400
.ولكِنّ، يوريا-ساما سوف تستمر بالعيش في قلوبهم للأبد

73
00:08:44,440 --> 00:08:45,770
.للأبد

74
00:08:53,650 --> 00:08:54,800
...هوكُتو شيتشيسي

75
00:08:59,320 --> 00:09:01,850
!بدأت معركتهما بالفعل

76
00:09:02,610 --> 00:09:03,290
!لنذهب

77
00:09:03,790 --> 00:09:04,370
...علينا أيضًا

78
00:09:04,370 --> 00:09:08,960
.مشاهدة المعركة بين حاكم نهاية القرن ومُنقذ نهاية القرن

79
00:09:12,530 --> 00:09:13,520
.يوريا-سان

80
00:11:14,620 --> 00:11:16,340
!فلتهلك

81
00:11:57,220 --> 00:11:58,460
.لا أحتاج لاسم

82
00:11:58,590 --> 00:11:59,790
.لا أحتاج لضوء

83
00:12:00,000 --> 00:12:03,060
.كل ما أُريدهُ النصر لـ قبضتاي

84
00:12:03,230 --> 00:12:07,300
!لهزيمتك ولكي أُصبح أقوى رجل في العالم

85
00:12:07,600 --> 00:12:08,800
!هلم يا كينشيرو

86
00:12:39,440 --> 00:12:42,120
أهذا هو الفرح بالألم؟

87
00:12:42,710 --> 00:12:46,940
!لقد كُنا ننتظر هذا اليوم بشوق

88
00:12:50,960 --> 00:12:55,230
..."الآن بما أن كلانا اتقن التقنية السرية "موسو تينسي

89
00:12:55,250 --> 00:12:57,660
.فبقية التقنيات لن تكون أسلحة مفيدة بعد الآن

90
00:12:57,700 --> 00:12:59,610
!لقد عُدنا إلى اللاشيء

91
00:13:00,160 --> 00:13:03,720
!في هذه الحالة، هذا القتال سيكون كـ قتال الاطفال

92
00:13:04,030 --> 00:13:07,050
!هيا، يا كينشيرو

93
00:13:27,060 --> 00:13:30,220
...أنا الذي قمتُ بتعليمك فنون القتال

94
00:13:30,300 --> 00:13:33,370
!رأو دائمًا سيكون متوفقٌ عليك

95
00:13:44,190 --> 00:13:46,530
...عليَّ أن أشكر الإله

96
00:13:48,170 --> 00:13:52,520
.لإرسال رجلٌ قويٌ مثلك أمامي

97
00:13:52,560 --> 00:13:53,470
!تقديم

98
00:14:16,120 --> 00:14:18,510
.يبدو الأمر كما لو أنهما يُقاتلان بلا محاولة إعاقة بعضهما البعض

99
00:14:18,530 --> 00:14:21,900
!هذا غريب... لا أرى أية كراهية منهما

100
00:14:22,230 --> 00:14:25,370
!لا، كأنهما يُصبحا رقيقان

101
00:14:32,110 --> 00:14:34,550
!يمكنني رؤيتهما، عندما كانا طفلان

102
00:14:34,580 --> 00:14:35,270
هاه؟

103
00:14:45,500 --> 00:14:46,700
...بالتفكير في الأمر

104
00:14:47,400 --> 00:14:52,330
.هذا المكان الذي التقينا فيه أنا وأنت بـ يوريا

105
00:14:53,180 --> 00:14:54,080
...أخي

106
00:14:57,340 --> 00:15:01,160
...لم يُسمح لك بالتدريب على فنون القتال بعد

107
00:15:01,550 --> 00:15:04,710
!"أو دخول إلى الـ"دوجو

108
00:15:08,740 --> 00:15:09,570
ما الأمر؟

109
00:15:09,900 --> 00:15:11,030
!هاجمني يا كينشيرو

110
00:15:18,740 --> 00:15:20,500
هذه طفلة الـ"نانتو"؟

111
00:15:20,510 --> 00:15:24,060
."بلى، مصيرها هو أن تُصبح جنرال الـ"نانتو روكو-سي

112
00:15:24,470 --> 00:15:31,670
أُمّها ماتت أثناء الولادة، لهذا يوريا-ساما
.لا تتكلم أو ترى لها عاطفة

113
00:15:32,510 --> 00:15:36,980
.لا ندري ما تُفكر فيه أو ما تراهُ

114
00:15:37,060 --> 00:15:38,630
...فتاة غريبة

115
00:15:40,080 --> 00:15:42,880
.على الرُغم من جمالها، يا للشفقة

116
00:15:43,720 --> 00:15:47,180
."الـ"هوكُتو" والـ"نانتو" وجهانِ لعملةً واحدة كـ الـ"ين" و"يانغ

117
00:15:47,360 --> 00:15:49,550
...إن كُنت تؤمن بهذا المصير

118
00:15:49,630 --> 00:15:53,370
!فكرتُ بإحضار يوريا-ساما إلى هُنا عسى أن يتغير شيء

119
00:15:54,530 --> 00:15:56,810
.لهذا نحنُ هُنا

120
00:16:04,980 --> 00:16:07,300
رأو، أتُعلم كينشيرو فنون القتال؟

121
00:16:07,950 --> 00:16:13,160
."كينشيرو لم يُسمح له بالتدريب نهيك عن دخول الـ"دوجو

122
00:16:13,320 --> 00:16:14,910
لماذا خرقت القانون؟

123
00:16:17,020 --> 00:16:19,500
مَنْ لا يملكون الموهبة ستُسلب قبضاتهم يومًا ما

124
00:16:19,530 --> 00:16:21,510
.ويُطردون في النهاية

125
00:16:21,550 --> 00:16:25,400
.لهذا قد أكون أنقذتهُ مِن بعض المشاكل

126
00:16:25,520 --> 00:16:27,330
.لأنهُ لا يمتلك الموهبة

127
00:16:32,300 --> 00:16:33,270
...هذه الفتاة

128
00:16:51,660 --> 00:16:52,620
.تفضلِ

129
00:17:11,980 --> 00:17:14,240
يوريا-ساما، ما الخطب؟

130
00:17:15,350 --> 00:17:16,310
!تفضلِ

131
00:17:21,420 --> 00:17:24,320
!عادت عواطف يوريا-ساما

132
00:17:25,150 --> 00:17:25,980
.أجل

133
00:17:32,010 --> 00:17:35,830
!رأو لفت اِنتباهها بينما كينشيرو فتح قلبها

134
00:17:36,730 --> 00:17:40,600
."رأو وكينشيرو يحملان مصير الـ"هوكُتو

135
00:17:41,390 --> 00:17:43,800
..."ويوريا الجنرال المستقبلي للـ"نانتو

136
00:17:44,380 --> 00:17:47,780
."ولكِنّ انثان من الـ"هوكُتو" و واحدٌ من الـ"نانتو

137
00:17:48,610 --> 00:17:53,020
!يومًا ما ستكون هناك معركة ستُقسم السماوات

138
00:18:12,070 --> 00:18:14,790
!إن استمرا على هذا المنوال فكلاهما سيموتان

139
00:18:15,210 --> 00:18:16,170
...كين

140
00:19:04,190 --> 00:19:06,190
!ستدخل إلى هالتي

141
00:19:10,190 --> 00:19:12,900
!كينشيرو لا ينظر إلى رأو، ينظر فقط لهالتهُ

142
00:19:13,100 --> 00:19:18,600
أينوي الدخول لـ هالتهِ
ويُطلق العنان لهجوم الـ"موسو" خاصتهُ؟

143
00:19:30,870 --> 00:19:35,910
.الهجوم القادم سيكون فُراقنا الأخير

144
00:19:36,810 --> 00:19:41,990
رأو ذلك الأخ الأكبر المُدهش
!الذي كُنا أنا وتوكي نطمح لنكون مثلهُ

145
00:19:42,030 --> 00:19:46,920
.حتى الآن ذلك الشعور لم يختفي ولا يزال يحترق في قلبي

146
00:19:56,740 --> 00:19:58,870
!هالة كين-أوه-ساما تتناقص

147
00:19:58,890 --> 00:20:01,170
.الضرر الناتج عن هالتهُ يجعلهُ مفتوحًا كثيرًا

148
00:20:01,220 --> 00:20:05,010
...قبضة الـ"موسو" الخاصة بـ كينشيرو لن تترك أي ثغرة

149
00:20:12,820 --> 00:20:14,670
...يوريا-سان، اُنظري

150
00:20:16,030 --> 00:20:19,520
.كين يُقاتل مع قلبكِ

151
00:20:24,270 --> 00:20:25,980
...سيحين الوقت قريبًا

152
00:20:27,170 --> 00:20:28,970
...المعركة الطويلة بينهما

153
00:20:29,510 --> 00:20:30,890
.سيحين وقت نهايتها

154
00:20:32,210 --> 00:20:38,020
.والسلام لأروحهما

155
00:20:41,890 --> 00:20:42,700
.كما تشاء

156
00:20:43,030 --> 00:20:44,960
.حاول هزيمتني إذن

157
00:20:45,010 --> 00:20:47,800
...بتاريخ الـ"هوكُتو" المُمتد لـ 2000 عام

158
00:20:47,860 --> 00:20:51,720
!سأضع كامل حياتي في هاتان القبضتان

159
00:20:53,450 --> 00:20:57,600
!خذ هذه القبضة بكامل روحي

160
00:21:04,610 --> 00:21:06,750
!هالة رأو اِختفت

161
00:21:14,380 --> 00:21:15,720
...يوريا-سان

162
00:21:34,570 --> 00:21:36,970
!توقفا كلاكما

163
00:22:10,130 --> 00:22:12,210
!المعركة الطويلة انتهت

164
00:22:12,250 --> 00:22:16,530
!أسطورة هؤلاء الرجال سوف تستمر حتى المُستقبل

165
00:22:16,550 --> 00:22:18,200
:"في الحلقة القادمة من "هوكُتو نو كين

166
00:22:18,220 --> 00:22:20,080
!"الوداع يا أخويا الـ"هوكُتو

167
00:22:20,100 --> 00:22:23,860
!!الآن حُبهما وحُزنهما ينتهيان

168
00:22:23,990 --> 00:22:27,450
!رأو، لقد كُنت أفضل أصدقائي