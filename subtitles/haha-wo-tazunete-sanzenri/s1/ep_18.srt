276
00:21:17,000 --> 00:21:17,680
.حسناً

277
00:21:22,020 --> 00:21:22,820
.بسرعة

278
00:21:27,140 --> 00:21:28,030
.إذهب

279
00:21:29,830 --> 00:21:30,760
.أوه، أميديو

280
00:21:31,450 --> 00:21:32,760
!أميديو

281
00:21:49,430 --> 00:21:51,940
