00:19:49,100 --> 00:19:51,060
.أميديو، وداعاً

221
00:19:51,060 --> 00:19:52,400
.شكراً لك، عم ببينو

222
00:19:52,400 --> 00:19:54,260
.الوداع، جميعاً

223
00:19:54,260 --> 00:19:55,970
.وداعاً

224
00:20:00,000 --> 00:20:02,170
.وداعاً، ماركو

225
00:20:02,170 --> 00:20:03,910
!وداعاً

226
00:20:22,390 --> 00:20:24,930
.عظيم. ماركو وجد أمه أخيراً

227
00:20:29,230 --> 00:20:30,630
.قال أنه سيعود

228
00:20:32,470 --> 00:20:35,170
.ماركو قال أنه سيعود إلى هنا

229
00:21:30,030 --> 00:21:33,100
.عظيم! إنه الميناء

230
00:21:33,100 --> 00:21:35,160
!عظيم! رائع

231
00:21:35,160 --> 00:21:37,030
!لقد وصلنا أخيراً. عدنا إلى الوطن

232
00:21:37,030 --> 00:21:39,400
.إنها جنوة. أمي وصلنا

233
00:21:39,400 --> 00:21:41,270
!عدنا إلى جنوة

234
00:22:20,510 --> 00:22:22,450
!أبي، طونيو

235
00:22:22,450 --> 00:22:24,450
!ماركو. أميديو

236
00:22:27,980 --> 00:22:29,620
.شكراً جزيلاً لك، ماركو

237
00:22:30,720 --> 00:22:32,790
.لقد كانت رحلةً رائعة

238
00:22:32,790 --> 00:22:34,960
.يجب أن نشكرك، أبي

239
00:22:35,490 --> 00:22:36,660
!ماركو

240
00:22:37,960 --> 00:22:39,060
.أمي

241
00:22:41,460 --> 00:22:43,470
