1
00:00:11,790 --> 00:00:14,810
تحوّلَتْ كوكوري إلى شيطان؟

2
00:00:24,410 --> 00:00:25,520
!لنلذ بالفرار

3
00:00:33,250 --> 00:00:34,340
رسالة؟

4
00:00:36,270 --> 00:00:40,050
قلبٌ جريحٌ يُطلِق رسائلَ على أسهم
"مكتوب عليها "أكرهك

5
00:00:40,050 --> 00:00:41,900
...من السّهل معرِفة ما يدور في ذهنِها

6
00:00:41,900 --> 00:00:46,360
أكبر مخاوِف الشّيطانة كوكوري هو الشّخص
الذي سينتزعُك منها

7
00:00:47,100 --> 00:00:50,740
كلّما كان الحبُّ أعظم، كان القلقُ أكبر

8
00:00:50,740 --> 00:00:52,530
كلّ ما فعلتُه كان فتح ذلك الباب

9
00:00:53,020 --> 00:00:54,180
من تكونين بالضبط؟

10
00:00:55,230 --> 00:00:57,190
أنا إلهة المصير

11
00:00:57,190 --> 00:01:01,040
أخضِعُ أولئك الذين في البلاد العجيبة
لتجارُب ومِحَن، وأقرع جرسَ المصير

12
00:01:01,240 --> 00:01:03,410
!أ-أنتِ إلهة المصير؟

13
00:01:03,680 --> 00:01:06,910
مصيرها بين يديك الآن يا نيكي

14
00:01:06,910 --> 00:01:08,670
!حظّاً سعيداً

15
00:01:08,670 --> 00:01:10,170
ما هذا؟

16
00:01:10,470 --> 00:01:13,160
...فشلُها السحريّ حوّلَها إلى شيطان

17
00:01:13,160 --> 00:01:15,700
الأمير رايد، لديّ رسالةٌ من كايا-ساما

18
00:01:15,700 --> 00:01:17,500
سنستولي على ألاهابيكا

19
00:01:17,500 --> 00:01:18,410
ألاهابيكا؟

20
00:01:18,410 --> 00:01:19,890
!علينا أن نتحرّك

21
00:01:20,410 --> 00:01:22,650
يا لسخرية القدَر يا قنبلة ورديّة

22
00:01:22,650 --> 00:01:24,310
،بسببِ الشّيطان الذي بداخلكِ

23
00:01:24,310 --> 00:01:27,930
لن تتمكّني من حمايةِ المدينةِ التي تحبّينها

24
00:01:28,560 --> 00:01:30,540
هذا أنا! ألا تألفينني؟

25
00:01:30,540 --> 00:01:33,150
!انظر... مفتاح في غصنِ الشّجرة

26
00:01:33,150 --> 00:01:35,740
هُنا حيث يصبُّ النّهر إذاً؟

27
00:01:35,740 --> 00:01:37,580
!لنسترجعه

28
00:01:42,790 --> 00:01:44,410
...مؤلم

29
00:01:45,880 --> 00:01:47,270
!ما هذا يا عجوز؟

30
00:01:47,270 --> 00:01:49,600
أسألُ نفس السّؤال عن لوحتِك
!يا سيّد بطل

31
00:01:49,040 --> 00:01:50,460
أثداء

32
00:01:50,860 --> 00:01:51,840
...هل هذا

33
00:01:52,080 --> 00:01:53,840
من صنيعِ كوكوري؟

34
00:03:32,360 --> 00:03:36,150
يبدو أنّكما أحضرتُما لي ضيفاً غير مُرحَّب به

35
00:03:36,410 --> 00:03:37,940
آسف يا ديريدا

36
00:03:37,940 --> 00:03:41,030
رغم ذلك، كوكوري مهمّةٌ بالنسبةِ لنا

37
00:03:41,320 --> 00:03:43,100
حتّى بعد الذي فعلته بكما؟

38
00:03:43,100 --> 00:03:44,630
!هل بمقدورِك إصلاح ذلك من فضلِك؟

39
00:03:46,240 --> 00:03:50,620
يبدو أنَّ كوكوري قد تحوّلَتْ إلى شيطان
يتمتّعُ بالأذى

40
00:03:50,620 --> 00:03:53,880
نعم، أحاسيسها من طرفٍ واحدٍ
قد حوّلَتْها إلى شيطان

41
00:03:53,880 --> 00:03:55,790
لكن الحبّ ليس شرّاً

42
00:03:56,010 --> 00:03:59,420
إن تركتُماها تُشفي غليلها فينبغي
أن تشعر بتحسُّنٍ مع الوقت

43
00:03:59,820 --> 00:04:01,550
هل ستعود إلى طبيعتِها؟

44
00:04:01,840 --> 00:04:04,470
نعم. إلى ذلك الحين، عامِلها بلطف

45
00:04:04,690 --> 00:04:06,700
اعتبرها حبيبتك

46
00:04:06,700 --> 00:04:07,690
حبيبتي؟

47
00:04:07,690 --> 00:04:10,400
مرحباً يا سيّد، ينبغي أن تعالج
هذه المسألة أخيراً

48
00:04:10,980 --> 00:04:15,190
كان إخفاء كوكوري لمشاعرِها هو
ما حوّلها إلى شيطان

49
00:04:15,380 --> 00:04:18,980
لقد حانَ الوقتُ للتوقُّفِ عن دورِ
اللَّعوب والقبول بمشاعرها

50
00:04:18,980 --> 00:04:21,190
!من تُناديه باللّعوب؟

51
00:04:23,120 --> 00:04:25,740
لا يُمكِن الكذب في البلاد العجيبة

52
00:04:25,740 --> 00:04:29,380
يبدو أنّهما سيُجبَران على مُواجهةِ الأسئلة
التي كانا يتجنّبانها طوال هذا الوقت

53
00:04:29,380 --> 00:04:33,710
بالفعل. هذه فُرصةٌ مثاليّةٌ لمواجهة القضيّة

54
00:04:35,080 --> 00:04:36,120
ذكّرني من تكون؟

55
00:04:36,120 --> 00:04:37,330
!أنا من كان سيسألك ذلك

56
00:04:42,260 --> 00:04:44,370
مُؤلم

57
00:04:50,070 --> 00:04:51,640
ثمّة شيء غريب هنا

58
00:04:55,320 --> 00:04:56,640
...هذا مُؤلم

59
00:04:57,480 --> 00:05:00,020
!لا! ليس هذا ما قصدتُه بغريب

60
00:05:01,760 --> 00:05:03,820
...لا بدَّ وأنّكِ استخدمتِ سحراً مجدّداً يا كوكوري

61
00:05:03,820 --> 00:05:05,280
من الصّعب أن نفهم شيئاً

62
00:05:05,740 --> 00:05:08,580
يا عجوز. ألا يبدو ذلك المنظر غريباً؟

63
00:05:08,580 --> 00:05:09,910
أجل، بالفعل

64
00:05:10,350 --> 00:05:13,820
ألاهابيكا، كائنة في وسطِ البلاد العجيبة الواسِعة

65
00:05:13,820 --> 00:05:17,920
تذكّرني قليلاً بما يشعر به قلبُ كوكوري وهي وحيدة

66
00:05:17,920 --> 00:05:21,630
تماماً. يُشبِه هذا ما يشعر به قلبُ كوكوري كثيراً

67
00:05:21,920 --> 00:05:23,650
ألا يحفِّز فكرة لديك على غير العادة؟

68
00:05:23,650 --> 00:05:25,900
—على غير العادة... هذا تحديداً

69
00:05:25,900 --> 00:05:27,410
"الكلمة المفتاحيّة هي "قلبها

70
00:05:27,410 --> 00:05:28,750
—ألاهابيكا

71
00:05:28,750 --> 00:05:29,300
!تماماً

72
00:05:29,600 --> 00:05:32,040
لم أفكّر بهذه الاحتماليّة

73
00:05:32,040 --> 00:05:35,520
لكن من غير الطبيعي أن تتواجد بلدةٌ مُسالِمة
في وسطِ البلاد العجيبة

74
00:05:35,520 --> 00:05:37,200
—ما الذي ترمي إليه

75
00:05:37,200 --> 00:05:38,310
هذا ما قد

76
00:05:38,310 --> 00:05:39,970
!توصّلتُ إليه

77
00:05:39,970 --> 00:05:43,230
!سيّد بطل! ماذا ينبغي أن أفعل؟

78
00:05:44,650 --> 00:05:48,520
أعتقد أنَّ مكان الأحلام الذي كنّا
مفتونين به جميعاً

79
00:05:50,020 --> 00:05:51,700
كان في الواقع مسرحاً لميغو ميغو

80
00:05:52,200 --> 00:05:55,960
ألاهابيكا هي بحدِّ ذاتها دُمية آليّة ساعة؟

81
00:05:59,520 --> 00:06:00,570
...كوكوري

82
00:06:02,160 --> 00:06:03,000
كوكوري؟

83
00:06:05,240 --> 00:06:07,280
هل سمعتُما شيئاً؟

84
00:06:07,280 --> 00:06:08,600
لا، أنت تتخيّل

85
00:06:08,600 --> 00:06:11,630
!معتوهان! هنالك شيء دوماً

86
00:06:11,630 --> 00:06:12,490
!اذهبا وتفقّدا حالاً

87
00:06:12,490 --> 00:06:13,910
!حـ-حاضر

88
00:06:13,910 --> 00:06:15,860
ما الذي يفعله كايا في ألاهابيكا؟

89
00:06:15,860 --> 00:06:17,060
!أيّاً يكن، عليّ الاختباء

90
00:06:19,810 --> 00:06:21,560
...مُؤلم

91
00:06:22,070 --> 00:06:23,420
!ما هذا؟

92
00:06:23,420 --> 00:06:24,570
...سيّد بطل

93
00:06:25,030 --> 00:06:26,060
توما؟

94
00:06:27,160 --> 00:06:28,550
!سيّد بطل، بسرعة

95
00:06:31,360 --> 00:06:32,460
ذهبا

96
00:06:32,460 --> 00:06:33,450
...لا بدَّ أن أقول

97
00:06:33,740 --> 00:06:35,280
!ما الذي يجري بالضبط؟

98
00:06:35,280 --> 00:06:37,150
إنّه تصميم العجوز كيتا-كيتا

99
00:06:37,150 --> 00:06:39,190
إنّها عمليّاً تحسينات كماليّة للمنزل

100
00:06:39,190 --> 00:06:40,840
ليس ذلك، أعني ألاهابيكا

101
00:06:40,840 --> 00:06:42,450
متى وصل كايا وعصابته إلى هنا؟

102
00:06:42,450 --> 00:06:45,800
في اللّيلةِ الماضية، أتوا فجأةً واستولوا
على البلدة

103
00:06:45,800 --> 00:06:48,130
ماذا يُريدون يا ترى؟

104
00:06:48,130 --> 00:06:49,600
...تبيّن أنَّ

105
00:06:50,130 --> 00:06:52,340
دكّانة توما

106
00:06:50,850 --> 00:06:52,340
!البلدة هي وهم؟

107
00:06:52,340 --> 00:06:55,230
والآنسة كوكوري تحوّلَتْ إلى شيطان؟

108
00:06:55,230 --> 00:06:58,530
رأيتُ ذلك من الأعلى. هذه البلدة
هي في الواقع دائرةٌ سحريّة

109
00:06:58,530 --> 00:06:59,480
،على ذكرِ ذلك

110
00:06:59,730 --> 00:07:03,500
لاذَ كافّة السّائحين بالفرار، لكن
ما زالت المتاجِر مفتوحة

111
00:07:03,500 --> 00:07:05,000
كان ينبغي أن تُدرِك بأنّ هُناك ما هو غريب

112
00:07:07,380 --> 00:07:09,210
توما، هل يمكنني فتح هذا؟

113
00:07:09,210 --> 00:07:09,910
تفضّل

114
00:07:12,910 --> 00:07:14,510
...أقلام رصاص ملوّنة

115
00:07:14,510 --> 00:07:15,920
توما، أريد شراء هذا

116
00:07:15,920 --> 00:07:17,830
!لا يمكنني أخذ مالك

117
00:07:17,830 --> 00:07:19,040
لا، أريد شراءه

118
00:07:19,370 --> 00:07:21,400
أعتقد أنّه سيُعجِب كوكوري

119
00:07:21,400 --> 00:07:25,780
لم أعطِها كثيراً من الهدايا، لذا قد يُساهم
هذا في دفعِها إلى الانفتاح

120
00:07:25,780 --> 00:07:27,470
فكرة سديدة يا سيّد بطل

121
00:07:27,470 --> 00:07:29,380
!العجوز! كيف وصلتَ إلى هنا؟

122
00:07:29,380 --> 00:07:31,750
!لا مهمّة مُستحيلة بالنسبة لي

123
00:07:38,300 --> 00:07:39,560
ما-ما هذا؟

124
00:07:41,960 --> 00:07:44,410
والآن إلى الأمام يا غوليم تيربو الثّالث

125
00:07:44,410 --> 00:07:46,120
!عِث فساداً شديداً

126
00:07:46,120 --> 00:07:47,690
لا حاجة لذلك

127
00:07:47,850 --> 00:07:49,310
ماذا! لا حاجة؟

128
00:07:49,310 --> 00:07:51,900
والآن يا غوليم، دوّر هذا المُفتاح

129
00:07:55,060 --> 00:07:56,460
هل هذا مفتاحٌ في الواقع؟

130
00:07:56,460 --> 00:07:58,140
ليس تمثالاً؟

131
00:07:59,330 --> 00:08:01,780
إنّه مُفتاح متنكِّر بهيئةِ تمثال

132
00:08:01,780 --> 00:08:04,170
سيكشفُ تدويره عن سرِّ ألاهابيكا

133
00:08:04,470 --> 00:08:06,750
والآن فلنبدأ

134
00:08:09,090 --> 00:08:10,070
ما هذا بالضبط؟

135
00:08:10,070 --> 00:08:10,670
!انظروا

136
00:08:11,670 --> 00:08:12,700
...ألاهابيكا تتغيّر

137
00:08:12,700 --> 00:08:14,590
!تبّاً! حريّ بنا الهرب يا جماعة

138
00:08:19,770 --> 00:08:20,880
!مُذهِل

139
00:08:20,880 --> 00:08:23,440
هذه آثار بانفوس، حيث تنام الأرواح الشيطانيّة

140
00:08:23,440 --> 00:08:27,650
كانَتْ ألاهابيكا أكثر قليلاً من مسرح وهميّ
لإخفاءِ وجودها

141
00:08:27,650 --> 00:08:29,350
كتمويه، كان ذلك مثاليّاً

142
00:08:28,680 --> 00:08:31,260
!حسناً يا جماعة، سندخل بانفوس

143
00:08:29,350 --> 00:08:32,030
... لكن كنتُ قد تأثّرتُ بنفسِ السّحر من قبل، لذا

144
00:08:33,150 --> 00:08:34,530
...هذا جنون

145
00:08:34,880 --> 00:08:37,140
ألاهابيكا بحدِّ ذاتها هي آثار بانفوس

146
00:08:37,140 --> 00:08:39,580
لا بدَّ وأنَّ عشيرة ميغو ميغو أرادَتْ إخفاءها

147
00:08:39,580 --> 00:08:41,410
يبدو أنّني تأخّرت

148
00:08:41,950 --> 00:08:43,410
!العجوز ديريدا

149
00:08:43,410 --> 00:08:45,670
كنتَ تعلمُ كلّ شيء عن بانفوس؟

150
00:08:45,670 --> 00:08:47,680
ما سرّ تلك المفاتيح؟

151
00:08:47,680 --> 00:08:48,540
حسناً

152
00:08:49,280 --> 00:08:51,960
سأكشف كلّ شيء لكم

153
00:08:54,040 --> 00:08:58,580
منذ عشرين عاماً، التقيتُ بعشيرةِ ميغو ميغو
في البلاد العجيبة

154
00:08:58,580 --> 00:09:01,810
أخبروني بسرِّ ألاهابيكا آنذاك

155
00:09:01,810 --> 00:09:04,650
هل يُعقَل أن يكون الكنز مخفيّاً
داخل بانفوس؟

156
00:09:04,650 --> 00:09:06,030
أجل، إنّه روحٌ شيطانيّة

157
00:09:06,030 --> 00:09:10,300
استخدمَتْ عشيرةُ ميغو ميغو سحرَها
لبناءِ ألاهابيكا وإخفاء الكنز فيها

158
00:09:10,300 --> 00:09:12,100
...وهنالك المزيد. ألاهابيكا

159
00:09:10,300 --> 00:09:12,430
—ما هذا الشيء؟ حيوان من نوع ما

160
00:09:12,430 --> 00:09:13,200
توما؟

161
00:09:12,430 --> 00:09:13,640
!لا تلمس هذا

162
00:09:17,580 --> 00:09:19,020
أأنت بخير يا توما؟

163
00:09:20,340 --> 00:09:21,620
!إنّه لغم

164
00:09:21,620 --> 00:09:23,410
تلاعُب لفظي ذكيّ بالفعل

165
00:09:24,970 --> 00:09:25,920
!كوكوري

166
00:09:28,570 --> 00:09:29,680
...تفضّلي

167
00:09:30,230 --> 00:09:31,460
إنّها هديّةٌ لكِ

168
00:09:43,450 --> 00:09:44,950
...أظنّها لم تنجح

169
00:09:44,950 --> 00:09:46,980
!أخذت الهديّة وابتعدَتْ

170
00:09:48,740 --> 00:09:50,950
استخدمَت عشيرةُ ميغو ميغو السّحر

171
00:09:50,950 --> 00:09:54,320
لبناءِ البلدةِ التخيّليّة ألاهابيكا
وإخفاء الرُّوح الشيطانيّة

172
00:09:54,860 --> 00:09:58,000
،كان استعادة نبع هوناس هو المُفتاح الأوّل

173
00:09:58,000 --> 00:10:00,760
،وكان مُساعدتكما على الترقِّي هو الثّاني

174
00:10:00,760 --> 00:10:03,700
وكان الثّالث هو إظهار بانفوس

175
00:10:04,020 --> 00:10:05,700
،بما أنّه تسلسُل

176
00:10:05,700 --> 00:10:09,210
لم أستطع إخباركم بالمُفتاحِ الثّالث
منذ البداية

177
00:10:09,580 --> 00:10:12,210
إذاً لنستخدِم هذا المُفتاح الثّاني بسرعة

178
00:10:12,720 --> 00:10:17,440
لا جدوى من ذلك، ما لم تعُد لبشريّتِها
لن نستفيد شيئاً

179
00:10:18,960 --> 00:10:22,050
إذاً قبل أي شيء، يجب أن نعيد
كوكوري إلى طبيعتِها

180
00:10:22,340 --> 00:10:24,480
والهديّة لم تؤثّر البتّة

181
00:10:24,480 --> 00:10:26,520
كلّ ما أعطَتْك إيّاه بالمُقابِل كان سهماً

182
00:10:26,520 --> 00:10:28,590
أعتقد هذا يتطلّب تطهير البدن من الشّيطان

183
00:10:28,590 --> 00:10:30,520
تولَّ هذا الأمر لأجلِنا

184
00:10:30,520 --> 00:10:32,610
هذا مختلفٌ عن كسرِ لعنة بسيطة

185
00:10:32,610 --> 00:10:34,570
يستحيلُ الأمر من دون متخصِّص

186
00:10:36,110 --> 00:10:37,190
...هذا مُستحيل

187
00:10:37,190 --> 00:10:38,320
!سيّد بطل

188
00:10:38,650 --> 00:10:40,640
!اقرأ هذه الرّسالة

189
00:10:40,640 --> 00:10:42,780
لعلّها تقول "أكرهك" فحسب، صحيح؟

190
00:10:44,910 --> 00:10:46,520
كم هذا شِعريّ

191
00:10:46,520 --> 00:10:49,040
!لا بدَّ وأنَّ هذا يمثِّل شعور كوكوري

192
00:10:49,040 --> 00:10:51,630
!الهديّة نفعت في واقعِ الأمر

193
00:10:51,630 --> 00:10:52,630
...أنا

194
00:10:52,850 --> 00:10:56,000
إعادتها إلى إنسانة كان كلّ
ما كنتُ أفكّر فيه

195
00:10:56,000 --> 00:10:58,880
لم أفكّر بها كشيطانة حتّى

196
00:10:59,320 --> 00:11:01,260
شيطانة أم لا، كوكوري تبقى كوكوري

197
00:11:01,750 --> 00:11:03,250
—هل لامسَك الإحساسُ الشعريّ

198
00:11:04,060 --> 00:11:05,830
أدركتَ ذلك أخيراً إذاً

199
00:11:06,480 --> 00:11:07,460
!ديريدا

200
00:11:08,070 --> 00:11:09,640
...عليك أن تخبرني يا ديريدا

201
00:11:09,640 --> 00:11:11,350
عن عشيرةِ ميغو ميغو

202
00:11:11,840 --> 00:11:13,230
وعن غورو غورو

203
00:11:15,650 --> 00:11:19,090
من حيثُ طبيعتها، غورو غورو لا هي
سحر ظلام ولا سحر نور

204
00:11:19,090 --> 00:11:20,610
إنّما سحر القلب

205
00:11:21,240 --> 00:11:23,750
تنشئ حقلاً شخصيّاً فريداً داخل

206
00:11:23,750 --> 00:11:26,380
دائرة السّحر وتستدعي قلبك

207
00:11:26,380 --> 00:11:28,010
!هذه هي غورو غورو

208
00:11:28,010 --> 00:11:31,380
حقيقة فشلها وتحوّلها إلى شيطان
لم تكن خطأ

209
00:11:31,380 --> 00:11:33,920
إنّما كان شكل قلبها آنذاك

210
00:11:34,210 --> 00:11:36,430
على الأرجح ظننتَ أنَّ غورو غورو
كان شيئاً مخيفاً

211
00:11:36,430 --> 00:11:38,700
!وتجنّبتَ تعلُّم الكثير عنه

212
00:11:38,700 --> 00:11:40,760
...رفضتَ أن تُلامسَ قلبها

213
00:11:41,190 --> 00:11:43,690
ممّا أدّى إلى ما يُدعى بالحسرة

214
00:11:43,690 --> 00:11:44,470
!حسرة

215
00:11:44,860 --> 00:11:49,350
كانت الغاية من المُفتاحِ الثّاني هي
تعليم تلك الفتاة غورو غورو النّهائيّ

216
00:11:49,350 --> 00:11:51,140
غورو غورو النّهائي؟

217
00:11:51,280 --> 00:11:52,980
...اسم تِلك الدائرة السحريّة هو

218
00:11:53,260 --> 00:11:54,600
...اسم الدائرة السحريّة

219
00:11:54,750 --> 00:11:56,570
...اسم الدائرة السحريّة هو

220
00:11:56,570 --> 00:11:57,400
...اسمها

221
00:11:58,650 --> 00:12:00,320
قلب عاشِق

222
00:12:03,020 --> 00:12:05,000
إنّه ليس كلاماً سهلاً على رجُلٍ في مُنتصَفِ العمر

223
00:12:05,000 --> 00:12:07,160
!تعليقاتك لن تنفع

224
00:12:07,160 --> 00:12:08,660
...لكن يا ديريدا

225
00:12:08,660 --> 00:12:10,990
دفع قلبها بهذا الشّكل؟

226
00:12:10,990 --> 00:12:13,170
ألن يزيدها هذا انزعاجاً فوق انزعاجها؟

227
00:12:13,900 --> 00:12:15,340
دعني أرى ذلك

228
00:12:16,350 --> 00:12:18,300
...هذه طريقةٌ أخرى

229
00:12:23,670 --> 00:12:25,180
أتذكر ما قلتُه لك؟

230
00:12:25,370 --> 00:12:27,800
عليك أن تكون لطيفاً مع الفتيات

231
00:12:33,820 --> 00:12:34,720
...سوف

232
00:12:34,720 --> 00:12:35,980
!سوف أبحث عن كوكوري

233
00:12:35,980 --> 00:12:36,730
!سيّد بطل

234
00:12:37,340 --> 00:12:41,290
لقد سافرتُ معها طوال هذا الوقت
لكن لم أفهم غورو غورو يوماً

235
00:12:41,290 --> 00:12:43,240
لم أفهم كوكوري يوماً أيضاً

236
00:12:44,150 --> 00:12:46,990
كانَتْ تتواصل مع دوائرها السحريّة
طوال هذا الوقت

237
00:12:47,480 --> 00:12:48,740
...كنتُ أنا

238
00:12:49,740 --> 00:12:51,850
!كنتُ أنا من لم يقل شيئاً

239
00:13:07,520 --> 00:13:08,800
!ما أظرفكِ

240
00:13:09,060 --> 00:13:10,030
ما هذا؟

241
00:13:10,030 --> 00:13:12,220
غداً، ستُقامُ حفلة رقص في القلعة

242
00:13:12,220 --> 00:13:13,520
!يجب أن تظهري بحلّةٍ صارِخة

243
00:13:13,520 --> 00:13:16,300
أنتما، كيف أبدو؟

244
00:13:16,300 --> 00:13:18,860
يا رئيس، لا يُسمَح للكلابِ بدخول حفلٍ راقص

245
00:13:18,860 --> 00:13:19,900
أحقّاً؟

246
00:13:20,130 --> 00:13:22,250
لستَ كلب خدمات

247
00:13:27,010 --> 00:13:28,490
ما الخطب يا جوجو؟

248
00:13:30,080 --> 00:13:31,390
!يد من فنجان شاي؟

249
00:13:31,390 --> 00:13:32,240
ما هذا بالضبط؟

250
00:13:32,240 --> 00:13:33,250
إنّها كو

251
00:13:33,250 --> 00:13:35,530
كو... تقصدين كوكوري؟

252
00:13:35,530 --> 00:13:36,880
إنّها تُمسِك بها الآن

253
00:13:36,880 --> 00:13:38,830
لحظة يا جوجو، ماذا تفعلين؟

254
00:13:39,410 --> 00:13:42,130
رونرون، عليّ الذهاب

255
00:13:42,580 --> 00:13:43,890
تذهبين؟

256
00:13:49,200 --> 00:13:50,860
...هذا دافئ جدّاً

257
00:13:50,860 --> 00:13:52,930
أنتِ أمّي، صحيح؟

258
00:13:58,830 --> 00:14:00,030
جوجو؟

259
00:14:03,880 --> 00:14:05,720
لا تقولي "كي" في وجهي أيّتها الطفلة المُدلَّلة

260
00:14:05,720 --> 00:14:07,440
ماذا تظنّين نفسكِ فاعلة بتحوّلكِ إلى شيطان؟

261
00:14:07,440 --> 00:14:08,660
!بأنياب وما شابه

262
00:14:08,850 --> 00:14:10,250
!كوكوري

263
00:14:10,660 --> 00:14:11,690
جوجو؟

264
00:14:11,690 --> 00:14:12,990
ماذا تفعلين هنا؟

265
00:14:13,330 --> 00:14:14,830
استدعَتْني كو

266
00:14:14,830 --> 00:14:16,260
سأطهّر بدنَها من الشّيطان

267
00:14:17,520 --> 00:14:18,770
:وقال الربّ

268
00:14:18,770 --> 00:14:20,820
"لا تخشَ الشّيطان"

269
00:14:21,390 --> 00:14:23,300
أيحدث أي شيء مُثير للاهتمامِ مؤخّراً؟

270
00:14:24,340 --> 00:14:26,410
إ-إجراء حوار بسيط في وقتٍ كهذا؟

271
00:14:26,410 --> 00:14:28,550
في أوقات كهذه، البالُ الهادئ أمر جوهريّ

272
00:14:28,770 --> 00:14:31,930
—لا أقول مثيراً للاهتمام، لكن في ألاهابيكا

273
00:14:31,930 --> 00:14:33,180
!بدأتْ! اهدأ

274
00:14:33,490 --> 00:14:35,240
ماذا تريدين منّي؟

275
00:14:34,180 --> 00:14:36,180
أدعك، يا من تسير في الظلام، ترى النّور"

276
00:14:36,620 --> 00:14:39,190
"أدعك، يا من تسير في النّور، ترى الظلام

277
00:14:39,190 --> 00:14:40,940
ما-ما الذي يجري؟

278
00:14:40,940 --> 00:14:43,190
ما الشيء المُمتع الذي رأيته في ألاهابيكا؟

279
00:14:43,190 --> 00:14:45,500
!أتريدينني أن ندردش الآن؟

280
00:14:45,500 --> 00:14:47,830
ستدع الشّيطان يفوز. اهدأ

281
00:14:47,830 --> 00:14:48,880
على ذكرِ الأشياء المُمتعة

282
00:14:48,880 --> 00:14:50,000
...المعذرة

283
00:14:50,000 --> 00:14:52,030
كان هُناك الرّجل ذو أسلوب هيبّورو، وثلاثة مفاتيح

284
00:14:52,030 --> 00:14:53,540
!وأضيفَتْ تحسينات كماليّة لمنزلِ توما

285
00:14:53,540 --> 00:14:54,490
!ومن ثمّ هناك الأثداء

286
00:14:56,900 --> 00:14:58,240
انتهتْ

287
00:14:58,240 --> 00:15:01,260
...لكن سقطَتْ كوكوري في البحيرة

288
00:15:03,680 --> 00:15:06,270
سقطَتْ في البحيرةِ فحسب

289
00:15:06,270 --> 00:15:07,510
لم تكن عمليّة فاشلة

290
00:15:07,510 --> 00:15:09,520
!بالفعل، لم تكن فاشلة

291
00:15:09,520 --> 00:15:10,220
!ديريدا

292
00:15:10,500 --> 00:15:12,540
يا للعجب... لونا الصّغيرة

293
00:15:12,540 --> 00:15:14,290
أنا السّاحر ديريدا

294
00:15:14,290 --> 00:15:17,440
أنتِ جوجو الصّغيرة؟ اسمي أدبيرغ

295
00:15:17,440 --> 00:15:19,350
تسرّني رؤيتكِ مجدّداً يا جوجو

296
00:15:19,350 --> 00:15:22,760
نيكي، هل تجمعُ عجائزَ غريبة الأطوار

297
00:15:22,760 --> 00:15:24,200
—إذاً، هذا ما حوّلَ كو إلى شيطان

298
00:15:24,200 --> 00:15:25,270
!لا

299
00:15:26,020 --> 00:15:28,620
نبع هوناس هو نبغ المُغادرين

300
00:15:28,620 --> 00:15:31,300
غادرَتْ في رحلةٍ للترقِّي لمُستوى أعلى

301
00:15:31,300 --> 00:15:32,450
...سيّد بطل

302
00:15:33,110 --> 00:15:33,660
!توما

303
00:15:36,600 --> 00:15:40,290
إن ذهبَتْ كي تترقّى فهذا يعني أنّ الرّوح
‏‏الشيطانيّة موجودة هُناك

304
00:15:40,960 --> 00:15:42,540
آثار بانفوس

305
00:15:47,000 --> 00:15:48,420
!كايا-ساما

306
00:15:48,760 --> 00:15:50,660
حسناً، هل وجدتُم دليلاً إلى الرُّوح الشيطانيّة؟

307
00:15:50,660 --> 00:15:52,400
لم نستطع العثور على شيء

308
00:15:52,400 --> 00:15:55,640
يبدو أنَّ الرّوح الشيطانيّة مخفيّة
ضمن الحجرة الباطنيّة

309
00:15:55,640 --> 00:15:58,380
عظيم، يمكنكِ التجوُّل في الحدودِ المُحيطة الآن

310
00:15:58,380 --> 00:15:59,140
حاضرة

311
00:15:59,370 --> 00:16:00,580
!انظر! الرُّوح الشيطانيّة

312
00:16:00,580 --> 00:16:01,810
!يا له من وجه مُخيف

313
00:16:01,980 --> 00:16:03,440
!حمقاوان! هذا أنا

314
00:16:03,650 --> 00:16:05,700
كايا-ساما، هذا البرج ليس مُطمئناً

315
00:16:05,700 --> 00:16:07,180
!إنّه مسكون

316
00:16:07,940 --> 00:16:10,810
...نسمعُ أصوات غريبة باستمرار، ونرى ظلالاً غريبة

317
00:16:10,810 --> 00:16:13,310
وهُناك من قال أنّ وجوههم تتعرّض للشدّ

318
00:16:13,310 --> 00:16:15,930
وأحياناً نمشي لبعضِ الوقت دون
أن نصل إلى أي مكان

319
00:16:15,930 --> 00:16:17,980
!لا بدَّ من وجود شبح ما في البرج

320
00:16:17,980 --> 00:16:20,540
!حمقاوان! ابحثا عن تِلك الرُّوح الشيطانيّة حالاً

321
00:16:20,540 --> 00:16:21,960
!حاضر

322
00:16:21,960 --> 00:16:25,760
يا إلهي، أي وحوش هؤلاء يخافون
من أشباح؟

323
00:16:28,340 --> 00:16:31,210
لا تقلق أيُّها الأمير رايد. لا يوجد أشباح هنا

324
00:16:31,210 --> 00:16:32,310
!بالطبع لا

325
00:16:32,310 --> 00:16:34,900
لا تسئ فهمي، معدتي تؤلمني فحسب

326
00:16:35,970 --> 00:16:39,440
لكن كنتُ أحسّ بحضورٍ غريب

327
00:16:39,440 --> 00:16:42,180
ومن الواضح أنّه ليس الرّوح الشيطانيّة أيضاً

328
00:16:42,180 --> 00:16:43,670
ما هو بالضبط؟

329
00:16:46,320 --> 00:16:47,440
ما هذا الذي أحسّ به؟

330
00:16:47,630 --> 00:16:48,810
!جوجو، بسرعة

331
00:16:48,810 --> 00:16:50,520
!سنقعُ في ورطةٍ إن عثروا علينا

332
00:16:50,520 --> 00:16:51,800
هذا مُدهش

333
00:16:52,370 --> 00:16:53,830
ثمّة شيء هنا

334
00:16:53,830 --> 00:16:55,200
سيّد البرج

335
00:16:55,200 --> 00:16:57,540
ليسَ وحشاً ولا الرّوح الشيطانيّة؟

336
00:16:57,540 --> 00:16:59,070
إنّه أغرب من ذلك

337
00:16:59,070 --> 00:17:00,490
لا أصدِّق ذلك بعض الشيء

338
00:17:00,490 --> 00:17:01,620
ما-ماذا تقصدين؟

339
00:17:01,620 --> 00:17:06,260
تخيّل راكوناً يركبُ درّاجةً بعجلةٍ واحدة
أثناء رميه كُرات حديديّة

340
00:17:06,840 --> 00:17:09,970
!دعم هُنا! دعم هُنا

341
00:17:09,970 --> 00:17:11,020
لكن هذه مجرَّد استعارة

342
00:17:11,020 --> 00:17:12,930
!لا! حدثَ هذا حرفيّاً

343
00:17:12,930 --> 00:17:15,760
رأينا راكوناً يركبُ درّاجةً بعجلةٍ واحدة
أثناء رميه كُرات حديديّة بالفعل

344
00:17:16,060 --> 00:17:18,010
تحقّقَ طلبي

345
00:17:18,240 --> 00:17:20,620
لا بدَّ وأنّ سيّد البرج يُراقبنا

346
00:17:20,620 --> 00:17:22,140
آمل أن تكون كوكوري بخير

347
00:17:22,380 --> 00:17:25,570
نيكي، ماذا ستفعل عندما ترى كو ثانية؟

348
00:17:26,150 --> 00:17:28,130
هـ-هل هذا مهمٌّ حقّاً؟

349
00:17:28,130 --> 00:17:28,960
أجل

350
00:17:28,960 --> 00:17:31,600
لن أدعك تعبثُ وتحوّلها إلى شيطانٍ ثانية

351
00:17:32,500 --> 00:17:34,150
قبل كلّ شيء، أريد إعطاءها هذه

352
00:17:34,420 --> 00:17:35,190
لماذا؟

353
00:17:35,560 --> 00:17:38,740
لماذا... لأنّني ارتأيتُ أنّها ستُعجبها

354
00:17:39,060 --> 00:17:42,160
في البداية، ظننتُ أنّ هذا سيُساعدها
على أن تكون بشريّة مجدّداً

355
00:17:42,520 --> 00:17:45,680
لكن هذه المرّة، أريد إعطاءها إيّاها كهديّةٍ فحسب

356
00:17:45,680 --> 00:17:47,750
لا مُشكلة في ذلك على ما أعتقد

357
00:17:49,250 --> 00:17:50,450
!وجدنا دُخلاء

358
00:17:50,450 --> 00:17:51,420
!تبّاً

359
00:17:51,420 --> 00:17:53,210
!استعدّوا جميعاً للقتال

360
00:17:53,210 --> 00:17:54,760
!حاضر

361
00:17:54,760 --> 00:17:56,040
ماذا! أنتم جميعاً؟

362
00:17:54,760 --> 00:17:58,610
!كيتا-كيتا! كيتا-كيتا

363
00:17:56,040 --> 00:17:58,300
لستُ مُفيداً كثيراً من دون أدوات

364
00:17:58,300 --> 00:17:58,980
كذلك أنا

365
00:17:58,980 --> 00:18:00,360
لا أشعر بحافِز فحسب

366
00:18:01,780 --> 00:18:04,140
وكأنّه لا يُدرِك المرءُ أنّ فريقه سيّئ
!إلّا بعد دخول الدّيماس

367
00:18:04,440 --> 00:18:07,600
حسناً، أظنّني سأفجّر سحري
الضوئي مجدّداً

368
00:18:07,890 --> 00:18:08,390
!ها نحن ذا

369
00:18:08,980 --> 00:18:11,770
!سحر النّور! كيتا-كيتا

370
00:18:15,300 --> 00:18:17,050
سحر النّور كيتا-كيتا؟

371
00:18:17,530 --> 00:18:20,820
كم هذا مُخيِّب للآمال. أتظنُّ حقّاً أنّك
تستطيع أن تكون بطلاً على هذا المنوال؟

372
00:18:20,820 --> 00:18:23,200
هذا لأنّك لم تكن لتتوقّف عن الثّرثرة
!"كيتا-كيتا! كيتا-كيتا

373
00:18:23,370 --> 00:18:24,840
!هذه فرصتُنا

374
00:18:26,700 --> 00:18:28,250
ما-ما هذا؟

375
00:18:28,600 --> 00:18:30,470
!تمثالان قبيحان يندفِعان نحونا

376
00:18:30,470 --> 00:18:32,210
!إنّهما أكثر رُعباً منّا

377
00:18:34,530 --> 00:18:36,530
أهذا هو سحر النّور كيتا-كيتا؟

378
00:18:36,530 --> 00:18:38,030
!بالطبع لا

379
00:18:38,030 --> 00:18:39,610
...توما، أليس ذلكما

380
00:18:39,610 --> 00:18:43,350
أجل، إنّهما تمثالا العجوز اللّذان
كانا أمام متجري

381
00:18:45,930 --> 00:18:48,300
...ذلك زيّنَ واجهةَ متجري

382
00:18:48,300 --> 00:18:49,060
فهِمت

383
00:18:49,060 --> 00:18:50,980
!كيتا-كيتا تُجلِب الحظَّ السّعيد

384
00:18:50,980 --> 00:18:52,900
كان ذلك على الأرجح من صنيعِ سيّد البرج

385
00:18:52,900 --> 00:18:54,150
...هذا مُنهِك

386
00:18:54,330 --> 00:18:58,280
إذا استطعنا الوصول إلى متجري، سنجدُ أدوات
وأسلحة هُناك، ينبغي أن يكون آمناً

387
00:18:58,280 --> 00:19:00,210
لنبحث عنه إذاً

388
00:19:00,210 --> 00:19:03,880
لكن إذا تجوّلنا بلا وجهة محدّدة
فسيجدُنا أولئك الوحوش

389
00:19:10,440 --> 00:19:11,580
!هنا يا توما

390
00:19:11,580 --> 00:19:13,000
!هذا صحيح! إنّه ذلك الطريق

391
00:19:13,000 --> 00:19:14,590
كيف عرفتُما الطريق؟

392
00:19:14,780 --> 00:19:17,300
هذا برجٌ الآن، لكن المتاجر مصفوفة بنفس الطريقة

393
00:19:17,300 --> 00:19:19,840
ولم نترك مكاناً إلّا وزرناه في ألاهابيكا

394
00:19:20,180 --> 00:19:22,360
!رسمنا الخارِطة كلّها في أذهاننا

395
00:19:22,360 --> 00:19:23,680
هكذا إذاً

396
00:19:23,680 --> 00:19:26,360
!حسناً يا رفاق! لنسرع معاً

397
00:19:26,360 --> 00:19:27,440
!نعم

398
00:19:27,440 --> 00:19:28,310
...تدلِّي

399
00:19:29,770 --> 00:19:31,110
...أ-أنت

400
00:19:31,110 --> 00:19:32,660
!كيبيثبيس

401
00:19:32,660 --> 00:19:33,690
أصبت

402
00:19:34,180 --> 00:19:35,020
شيطان

403
00:19:35,020 --> 00:19:37,280
!في الواقع، أنا شيطانٌ أعلى

404
00:19:37,440 --> 00:19:41,380
وبأمر من كايا-ساما، لن أدع أحداً
يدخل هذا البرج

405
00:19:41,380 --> 00:19:42,320
...والآن

406
00:19:42,550 --> 00:19:44,320
...تبّاً... سيكون هذا

407
00:19:44,320 --> 00:19:46,300
!ستُشَلُّ حركة كافّة الرّجال

408
00:19:46,300 --> 00:19:49,020
!ستؤدّي كافّة النساء أداء مُثيراً

409
00:19:49,160 --> 00:19:50,910
!توقّعتُ هذا

410
00:19:51,220 --> 00:19:53,080
!جوجو ستؤدّي أداءً مُثيراً؟

411
00:19:53,080 --> 00:19:54,330
هل هو جادّ؟

412
00:19:58,840 --> 00:20:00,640
...يا-يا للجرأة

413
00:20:00,640 --> 00:20:04,150
لكن عندما يكون الأمر بهذه الصّراحة
فإنّه يفتقرُ للإغراءِ بعض الشيء

414
00:20:04,150 --> 00:20:07,100
الأمر أشبه باكتشافِ فتاة ترعرعت
بين يدي ذئاب أو ما شابه

415
00:20:07,410 --> 00:20:10,130
!ولسببٍ ما، هذا ما حدث! ما الذي يجري؟

416
00:20:11,390 --> 00:20:13,940
!أُطلِقَ عنان الهمجيّة

417
00:20:15,000 --> 00:20:16,900
!أستطيع الحركة! لسنا مشلولين

418
00:20:16,900 --> 00:20:17,900
من أين أتت تلك الأدغال؟

419
00:20:21,530 --> 00:20:26,160
لماذا أطارد شيطاناً أثناء امتطائي
ذئباً وبزيّي الداخليّ؟

420
00:20:27,000 --> 00:20:29,080
!تبّاً، سأضطرُّ لاستخدام سحري مجدّداً

421
00:20:37,060 --> 00:20:37,540
...هذا

422
00:20:37,850 --> 00:20:39,210
!ذيل السّمندر

423
00:20:39,530 --> 00:20:42,280
السّحر الذي استخدمَتْه كوكوري لهزيمةِ كيبيثبيس

424
00:20:42,280 --> 00:20:44,920
هل سيّد البرج يعلم بأمرنا؟

425
00:20:49,890 --> 00:20:50,930
غبيّ ملعون

426
00:20:52,260 --> 00:20:53,740
ماذا كان ذلك الصّوت؟

427
00:20:53,740 --> 00:20:55,440
أمتأكّد أنّك لم تتخيّله؟

428
00:20:56,710 --> 00:20:58,560
!كايا-ساما

429
00:20:58,790 --> 00:21:00,150
كيبيثبيس؟

430
00:21:00,150 --> 00:21:01,220
!كايا

431
00:21:01,220 --> 00:21:02,580
!أنتم

432
00:21:02,580 --> 00:21:03,660
!تبّاً، اهربوا

433
00:21:03,660 --> 00:21:05,900
!طارداهم! يجبُ القبضُ عليهم

434
00:21:10,050 --> 00:21:12,450
!يمرُّ شبحٌ في الوقتِ الرّاهن

435
00:21:13,200 --> 00:21:14,490
إنّه كما توقّعت

436
00:21:14,490 --> 00:21:16,610
!روح من نوع ما تسكنُ هذا البرج

437
00:21:16,610 --> 00:21:18,660
!قد يكون هذا إشكالاً

438
00:21:17,500 --> 00:21:19,530
!وقْع الضربة السّابِقة يتسبّبُ بانهيار

439
00:21:20,080 --> 00:21:22,960
!نجحنا! لقد استعدنا ألاهابيكا

440
00:21:25,800 --> 00:21:29,050
!لن أقبل بالخسارةِ هذه المرّة

441
00:21:27,910 --> 00:21:29,850
هل أنت بخير يا كايا-ساما؟

442
00:21:29,050 --> 00:21:31,640
،بعد فشلِ مونكو في كوبّال

443
00:21:31,640 --> 00:21:34,500
أُرسِلَ لمُراقبة المنطِقة في محيطِ
جبلِ المُنشار

444
00:21:34,500 --> 00:21:38,400
لا شيء أكثر خزيّاً من أن تكون مسؤولاً
!عن ديماس قد تمَّ تخطّيه من قبل

445
00:21:38,400 --> 00:21:40,110
...لم أتوقّع أن يكون البرج هشّاً إلى ذاك الحدّ

446
00:21:40,110 --> 00:21:43,360
والآن لا يمكننا أن نتباهى بمدى رُعبنا

447
00:21:43,990 --> 00:21:45,020
...فهِمت

448
00:21:45,020 --> 00:21:48,940
كنتُ أحمقاً لمُحاولتي البحث في كلّ زوايا
البرج أساساً

449
00:21:48,940 --> 00:21:51,280
!سنغيّر استراتيجيّتنا ونعود لاحقاً

450
00:21:53,230 --> 00:21:54,290
!انظر

451
00:21:54,290 --> 00:21:56,020
!إنّهم يغادرون

452
00:21:56,020 --> 00:21:58,610
أنا متأكّدٌ أنّهم سيعودون

453
00:21:58,610 --> 00:22:00,960
هذه المرّة، سنُساهم جميعاً في حمايةِ البرج

454
00:22:00,960 --> 00:22:02,700
!لم تبدأ المعركةُ الحقيقيّةُ بعد

455
00:22:02,700 --> 00:22:04,280
!أنا أتحمَّس

456
00:22:04,280 --> 00:22:06,580
!سوف نحمي ألاهابيكا

457
00:22:09,450 --> 00:22:10,600
كان ذلك مُمتعاً

458
00:22:10,860 --> 00:22:11,950
!الظهور بزيّكِ الداخليّ؟

459
00:22:11,950 --> 00:22:14,470
لا تكن غبيّاً. أقصد البرج

460
00:22:14,710 --> 00:22:17,030
إنّه أشبه بمملكتنا الخاصّة

461
00:22:17,030 --> 00:22:19,520
وفي الدّاخل تنام أميرة

462
00:22:19,950 --> 00:22:22,650
هذه معركةٌ لحمايةِ قلبها

463
00:22:27,920 --> 00:22:29,030
...كوكوري

464
00:24:14,560 --> 00:24:15,470
...أليس هذا

465
00:24:15,470 --> 00:24:17,220
إنّه النجم الشّهير، الخياليّ كيتاجيما

466
00:24:17,220 --> 00:24:19,820
قضى خمسة عشر عاماً يهزم وحوشاً صغيرة
في أرجاءِ قلعة

467
00:24:19,820 --> 00:24:22,040
!بتلك الخبرة، بلغَ المستوى 99

468
00:24:22,040 --> 00:24:24,370
إنّه صاحب قوّة خياليّة جوهريّة! تعويذاته
!تُلامس القلب

469
00:24:24,370 --> 00:24:25,900
!هذا هو الخياليّ كيتاجيما