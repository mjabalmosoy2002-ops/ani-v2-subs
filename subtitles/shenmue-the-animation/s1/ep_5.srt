1
00:01:41,420 --> 00:01:44,000
!مذهل! إنهما رائعان

2
00:01:44,210 --> 00:01:47,040
لمَ لا نراهن ببعض المال على هذا؟

3
00:01:47,330 --> 00:01:49,790
.حسنا، أراهن على الفتى الذي يرتدي السترة الجلدية

4
00:01:50,040 --> 00:01:51,750
.أراهن على تشين

5
00:01:54,540 --> 00:01:56,290
...رجاءً، أتمنى أن تصلك الرسالة

6
00:01:57,630 --> 00:01:59,000
!الجوّ بارد

7
00:02:06,790 --> 00:02:09,040
.هكذا إذا

8
00:02:11,040 --> 00:02:16,000
!لحظة، الرقم 17... إنه مخبأ ماد آينجيلز

9
00:02:16,000 --> 00:02:18,540
!تبولت على نفسي! تبا

10
00:02:33,040 --> 00:02:34,080
!تلك الفتاة

11
00:02:34,420 --> 00:02:39,580
لن هل يعتقد الزعيم أنّ هازوكي ذاك سيتغلّب
على غيزانغ تشين؟

12
00:02:39,880 --> 00:02:44,500
.غبيّ، لا أحد يتوقّع فوزه

13
00:02:44,500 --> 00:02:45,790
ما الذي سيحدث إذا؟

14
00:02:45,960 --> 00:02:51,330
،ذلك الفتى هازوكي سيوسع غيزانغ ضربا حتما
.حتى وإن لم يقضِ عليه تماما

15
00:02:51,580 --> 00:02:57,420
.بعدما يتعبان من مهاجمة بعضهما، سنتدخل ونقي عليهما

16
00:02:57,420 --> 00:03:00,000
!فهمت! هذا عبقريّ

17
00:03:00,460 --> 00:03:01,830
!هذه مشكلة

18
00:03:06,750 --> 00:03:08,210
!هذا سيئ! سيئ للغاية

19
00:03:09,460 --> 00:03:10,710
!غورو-تشان؟

20
00:03:11,130 --> 00:03:11,880
ما الأمر؟

21
00:03:12,130 --> 00:03:13,210
!ماي-تشان

22
00:03:14,920 --> 00:03:17,170
!تمالك نفسك

23
00:03:17,170 --> 00:03:19,880
.هذا مؤلم، صفعتك قوية

24
00:03:20,080 --> 00:03:20,920
.اشرح ما حدث

25
00:03:20,920 --> 00:03:23,420
!إنها تلك الفتاة! صديقة أنيكي التي شاهدناها في محل الأزهار

26
00:03:23,420 --> 00:03:24,880
تقصد نوزومي-تشان؟

27
00:03:25,130 --> 00:03:28,290
!أجل! اختطفت من قبل ماد آينجيلز

28
00:03:28,290 --> 00:03:29,540
!ماذا؟ لماذا؟

29
00:03:30,250 --> 00:03:35,130
!كيف لي أن أعرف؟ لكنّ أنيكي في خطر، نصبوا له كمينا

30
00:03:35,420 --> 00:03:38,170
!علينا الاتصال بالشرطة! اسمحي لي باستخدام هاتفك

31
00:03:38,920 --> 00:03:42,830
!لن يصدّق أيّ شخص غبيا مثلك

32
00:03:44,830 --> 00:03:46,500
...قد تكونين محقة

33
00:03:46,830 --> 00:03:47,670
.بالطبع

34
00:03:47,670 --> 00:03:49,580
!ما العمل إذا؟

35
00:03:52,500 --> 00:03:53,420
!اتبعني

36
00:03:54,880 --> 00:03:57,830
!انتظريني

37
00:04:05,170 --> 00:04:08,420
هذا هو المكان الذي يعمل فيه أنيكي. لماذا أحضرتني إلى هنا؟

38
00:04:12,210 --> 00:04:13,670
!سنقضي عليهم بهذه

39
00:04:13,830 --> 00:04:15,630
!هل تمزحـ

40
00:04:16,960 --> 00:04:17,920
ما الذي تفعلونه؟

41
00:04:22,500 --> 00:04:24,630
...أنا أعرفك... أنت هو صديق ريو

42
00:04:32,960 --> 00:04:34,750
...يبدو أنّ غورو لم يقرأ الرسالة

43
00:04:34,750 --> 00:04:37,080
ألم تكتفِ بعد يا هازوكي؟

44
00:04:42,210 --> 00:04:43,210
!هازوكي

45
00:04:43,210 --> 00:04:46,540
!كفاك عبثا! أوسعه ضربا

46
00:04:47,080 --> 00:04:48,580
!وإلا فتعلم ما سيحدث

47
00:04:59,880 --> 00:05:01,040
!تبا لك

48
00:05:10,210 --> 00:05:10,920
إين

49
00:05:10,920 --> 00:05:11,460
سين

50
00:05:11,960 --> 00:05:13,380
!كوكياكو

51
00:05:23,880 --> 00:05:26,790
!أصبحت يوكوسوكا ملكي الآن

52
00:05:29,080 --> 00:05:29,960
!ريو؟

53
00:05:30,330 --> 00:05:33,750
!أجل. لذا نحتاج لاستعارة الرافعة رجاءً

54
00:05:34,460 --> 00:05:36,000
ومن سيشغّلها؟

55
00:05:37,460 --> 00:05:38,630
!أنا

56
00:05:40,210 --> 00:05:41,710
هل استخدمتها من قبل؟

57
00:05:42,000 --> 00:05:44,420
!كلا، لكن لن يوقفني ذلك

58
00:05:45,000 --> 00:05:48,580
أعلم أنك كنت فتاة قوية فيما مضى، لكن الجرأت وحدها
.لن تكون كافية

59
00:05:50,130 --> 00:05:51,420
!أبقِ فمك مغلقا

60
00:05:52,500 --> 00:05:53,210
.أنا آسفة

61
00:05:53,670 --> 00:05:57,040
.لكن لا يمكنني السماح لشخص دون خبرة أن يأخذ الرافعة

62
00:05:57,630 --> 00:05:58,330
...بدل ذلك

63
00:05:59,540 --> 00:06:00,670
!أنا من سيشغلها

64
00:06:05,210 --> 00:06:06,500
ما هذا لصوت؟

65
00:06:29,420 --> 00:06:30,380
!نوزومي-تشان

66
00:06:30,380 --> 00:06:31,250
!ماي-تشان

67
00:06:31,580 --> 00:06:32,380
!حسنا

68
00:06:33,330 --> 00:06:34,710
.كل شيء على ما يرام الآن

69
00:06:34,710 --> 00:06:36,210
!لا وقت لنضيعه، لنخرج من هنا

70
00:06:36,210 --> 00:06:37,040
.شكرا لكما

71
00:06:37,210 --> 00:06:38,500
!أنتم

72
00:06:38,960 --> 00:06:39,750
!اركبوا

73
00:06:40,630 --> 00:06:41,670
!مرحى

74
00:06:51,130 --> 00:06:53,210
!سنذهب لمدخل الميناء مباشرة

75
00:06:53,420 --> 00:06:54,750
!حسنا

76
00:06:58,540 --> 00:06:59,580
أهذا...؟

77
00:07:01,290 --> 00:07:02,080
!هازوكي-كن

78
00:07:02,380 --> 00:07:03,210
!ريو-ني

79
00:07:03,420 --> 00:07:06,210
!أنيكي

80
00:07:08,000 --> 00:07:09,080
...أنيكي

81
00:07:09,500 --> 00:07:12,710
!تبا، كان يجدر بي الوصول إلى هنا مبكرا! أنا آسف حقا

82
00:07:12,920 --> 00:07:14,920
.أنهوا العمل يا شباب

83
00:07:14,920 --> 00:07:15,710
.حاضر

84
00:07:21,080 --> 00:07:22,000
!ما الذي؟

85
00:07:22,250 --> 00:07:25,460
!أنيكي! لم تمت

86
00:07:26,250 --> 00:07:27,670
!طبعا لا

87
00:07:28,130 --> 00:07:29,080
.أحسنت عملا

88
00:07:29,380 --> 00:07:30,460
!حمدا للربّ

89
00:07:31,290 --> 00:07:32,670
.لست سيئا

90
00:07:33,290 --> 00:07:34,130
.أنت أيضا

91
00:07:35,080 --> 00:07:36,290
!ما الذي يحدث؟

92
00:07:42,130 --> 00:07:43,130
!تبا لكم

93
00:07:44,580 --> 00:07:45,670
.هذا فخّ

94
00:07:47,790 --> 00:07:48,580
!فخّ؟

95
00:07:48,790 --> 00:07:52,500
.أخذوا أحد أصدقائي رهينة. عليّ هزيمتك

96
00:07:55,580 --> 00:07:57,380
.فلنتظاهر بالقتال إذا

97
00:07:58,290 --> 00:07:59,210
إينسين

98
00:07:59,540 --> 00:08:00,290
كو

99
00:08:00,790 --> 00:08:01,500
!كياكو

100
00:08:07,750 --> 00:08:10,080
!وكأنني سأدع أمثالكم يهزمونني

101
00:08:11,830 --> 00:08:15,170
.توقّعت أن تقوم بأمر غبيّ كهذا

102
00:08:21,790 --> 00:08:27,000
.للأسف فأنتما لا تملكان قوة كافية لقتال ضدّ هذا العدد

103
00:08:28,500 --> 00:08:29,960
.مات الشاه

104
00:08:31,170 --> 00:08:33,920
.انتهى وقت التحمية وحان وقت القتال الحقيقيّ

105
00:08:34,540 --> 00:08:35,920
!مارك! غورو

106
00:08:36,500 --> 00:08:38,040
!خذا هاراساكي واهربا رجاءً

107
00:08:38,460 --> 00:08:40,420
!لكن لا يمكنكما قتالهما لوحدكما

108
00:08:41,040 --> 00:08:42,210
!اخرجوا من هنا فحسب

109
00:08:42,580 --> 00:08:44,830
!حسنا يا أنيكي! سنذهب

110
00:08:45,080 --> 00:08:45,920
...لكن

111
00:08:45,920 --> 00:08:50,170
!يمكنه الاهتمام ابهذا الأمر! سنعترض طريقه فحسب إن بقينا

112
00:08:52,420 --> 00:08:53,960
.حسنا، لنتحرّك

113
00:08:54,630 --> 00:08:55,540
!اركبوا جميعا

114
00:08:55,540 --> 00:08:57,580
!هيا يا فتيات! انطلقا

115
00:09:00,080 --> 00:09:01,460
!لن يهرب أيّ أحد! أعيدوهم

116
00:09:01,790 --> 00:09:02,710
!تبا

117
00:09:02,710 --> 00:09:03,580
!ها نحن ذا

118
00:09:16,250 --> 00:09:17,500
يمكنك التحرّك؟

119
00:09:17,880 --> 00:09:19,420
أتعرف مع من تتحدث؟

120
00:09:21,830 --> 00:09:23,630
!أرهم الجحيم يا أنيكي

121
00:09:28,880 --> 00:09:29,920
!حطّمهم

122
00:09:34,420 --> 00:09:38,580
!متوقع تماما. عرفت أنّ التورط معكم يعني المشاكل

123
00:09:39,000 --> 00:09:40,920
!يمكنك التذمّر لاحقا

124
00:09:41,330 --> 00:09:43,420
!حسنا. يجدر بك أن تصمد طويلا

125
00:09:43,750 --> 00:09:44,830
!يجدر بك القلق بخصوص نفسك

126
00:10:24,250 --> 00:10:25,670
!تبا

127
00:10:26,040 --> 00:10:27,250
!إنهما وحشان

128
00:10:27,460 --> 00:10:29,580
!هنالك ثنان منهما فقط! لا تصابوا بالجبن

129
00:10:30,000 --> 00:10:30,670
!استعدّ

130
00:10:30,670 --> 00:10:31,460
!أعلم ذلك

131
00:10:51,790 --> 00:10:53,960
!نجحنا! ها هو المخرج

132
00:10:56,750 --> 00:10:58,130
ما الأمر يا نوزومي-تشان؟

133
00:10:59,290 --> 00:11:01,880
...لا يمكننا تركهما هكذا فحسب

134
00:11:02,330 --> 00:11:03,330
...نوزومي-تشان

135
00:11:04,000 --> 00:11:09,130
!لحظة، لقد هربنا للتوّ! إن عدنا الآن فسنكون في ورطة كبيرة

136
00:11:09,130 --> 00:11:11,170
!أبقِ فمك مغلقا

137
00:11:12,000 --> 00:11:12,960
.حسنا

138
00:11:13,960 --> 00:11:14,880
.فلنعد

139
00:11:20,830 --> 00:11:23,130
!أيها الأوغاد! لم ينتهِ الأمر بعد

140
00:11:23,330 --> 00:11:28,460
.لم يعد لديّ سبب لمواصلة القتال مع عصابتك
.هاراساكي بأمان الآن

141
00:11:29,380 --> 00:11:31,880
.لذا سأدعكما تتفاهمان مع بعض

142
00:11:32,420 --> 00:11:33,250
.حسنا

143
00:11:38,920 --> 00:11:40,540
!أيها الوغد

144
00:11:45,790 --> 00:11:48,130
!يمكنني الغشّ أنا أيضا

145
00:11:50,790 --> 00:11:51,580
!لا تتدخّل

146
00:11:52,380 --> 00:11:55,170
!ما زلت قادرا على القتال

147
00:12:08,960 --> 00:12:11,080
.حسنا. فلنذهب

148
00:12:11,250 --> 00:12:11,830
.صحيح

149
00:12:12,880 --> 00:12:13,670
!انتظر

150
00:12:15,460 --> 00:12:17,330
تسعى خلف لان دي، صحيح؟

151
00:12:18,880 --> 00:12:19,580
.هذا صحيح

152
00:12:21,580 --> 00:12:26,250
...إن اعتقدت أنّ القضاء على أمثالنا... هو نصر عظيم

153
00:12:27,670 --> 00:12:31,830
.فأنت لا تعرف حقا... من تواجه

154
00:12:33,880 --> 00:12:37,330
!عندما تصل إلى هونغ كونغ... سيكونون في انتظارك

155
00:12:39,170 --> 00:12:41,540
.أضمن لك أنك لن تعود على قيد الحياة

156
00:12:44,040 --> 00:12:46,330
هازوكي. ما الذي ستفعله الآن؟

157
00:12:47,000 --> 00:12:48,210
هل ستواصل مغامرتك؟

158
00:12:49,380 --> 00:12:54,000
.لا يمكنني الاستسلام الآن. سأجد طريقة للذهاب إلى هونغ كونغ

159
00:12:55,420 --> 00:12:56,670
...سأتحدث مع الزعيم تشين

160
00:12:57,290 --> 00:13:01,630
.كلا، مع والدي. سأقنعه بمساعدتك

161
00:13:04,040 --> 00:13:05,380
.اتصل بنا مجددا

162
00:13:06,670 --> 00:13:07,500
!غيزانغ

163
00:13:10,170 --> 00:13:10,960
.شكرا لك

164
00:13:17,250 --> 00:13:19,500
!أنيكي

165
00:13:22,380 --> 00:13:24,290
!هاراساكي! شباب

166
00:13:25,630 --> 00:13:26,710
...هازوكي-كن

167
00:13:35,210 --> 00:13:37,790
!هذا رائع يا أنيكي

168
00:13:37,790 --> 00:13:39,250
!عدت سالما! هذا جنونيّ

169
00:13:39,540 --> 00:13:41,380
.شكرا على ملاحظة رسالتي يا غورو

170
00:13:42,250 --> 00:13:45,130
.شكرا لك يا مارك وأنت أيضا يا ماي. أنا مدين لكم

171
00:13:45,580 --> 00:13:49,170
.نحن نعمل مع بعض. هذا أقلّ ما يمكنني فعله

172
00:13:49,170 --> 00:13:51,830
!كما أنك كنت لتقوم بالأمر نفسه من أجلنا

173
00:13:52,670 --> 00:13:55,250
.هاراساكي. يسعدني أنك بخير

174
00:13:55,790 --> 00:13:57,920
.هازوكي-كن، أنا آسفة حقا

175
00:13:58,630 --> 00:14:01,750
.و... شكرا جزيلا لك

176
00:14:02,170 --> 00:14:04,330
.كلا، كان كل هذا بسببي

177
00:14:04,750 --> 00:14:07,710
.عرّضتكم للخطر بسبب مشاكلي. أنا آسف

178
00:14:09,790 --> 00:14:10,710
...لا تقلق

179
00:14:13,130 --> 00:14:14,880
-من الواضح يا أنيكي أنك

180
00:14:39,880 --> 00:14:41,420
ما الذي ستفعله الآن؟

181
00:14:47,580 --> 00:14:48,790
هل ستواصل البحث أكثر؟

182
00:14:49,830 --> 00:14:55,170
.لا يمكنني الاستسلام الآن. سأجد طريقة للذهاب إلى هونغ كونغ

183
00:15:09,250 --> 00:15:10,250
.هازوكي-كن

184
00:15:12,380 --> 00:15:15,460
...شكرا لك على كل شيء... حقا

185
00:15:16,170 --> 00:15:19,290
.لم نتحدث عن تلك النصيحة التي كنت تريدينها بعد

186
00:15:21,000 --> 00:15:25,960
.لا تقلق، انتهى الأمر الآن. لقد... اتخذت قراري سلفا

187
00:15:26,960 --> 00:15:27,880
حقا؟

188
00:15:42,920 --> 00:15:46,210
بعد مرور بضعة أيام
ميناء شين يوكوسوكا

189
00:15:48,380 --> 00:15:49,830
...كان وقتي هنا قصيرا لكن

190
00:15:50,710 --> 00:15:52,000
.شكرا لك على كل شيء

191
00:15:55,460 --> 00:15:56,380
.مارك

192
00:15:57,670 --> 00:15:58,580
ستغادر؟

193
00:15:58,830 --> 00:16:00,790
.أجل. أحببت العمل برفقتك

194
00:16:01,250 --> 00:16:04,790
.ريو... واصل المشيء في طريقك الخاص

195
00:16:05,210 --> 00:16:06,630
.أعلم أنك ستكون على ما يرام

196
00:16:07,630 --> 00:16:08,580
!شكرا لك

197
00:16:12,080 --> 00:16:13,710
!زواج؟

198
00:16:14,250 --> 00:16:15,250
.صحيح

199
00:16:15,250 --> 00:16:17,420
.كنا، نتواعد لبعض الوقت

200
00:16:17,830 --> 00:16:20,830
لكن الزواج؟ كيف طرأت تلك الفكرة فجأة؟

201
00:16:21,210 --> 00:16:23,880
.بعد كل تلك الضجة، طرحت عليها السؤال

202
00:16:24,380 --> 00:16:27,290
...مشاهدتها هكذا حين أنقذنا نوزومي-تشان جعلني أدرك

203
00:16:27,290 --> 00:16:29,920
!أنّ ماي هي الفتاة الوحيدة بالنسبة لي

204
00:16:30,670 --> 00:16:32,170
أتوافقين على هذا يا ماي-تشان؟

205
00:16:32,420 --> 00:16:33,250
.أجل

206
00:16:33,790 --> 00:16:36,500
.لا أملّ أبدا رفقة غورو

207
00:16:36,500 --> 00:16:37,710
.حسنا إذا

208
00:16:38,670 --> 00:16:40,170
.لكننا نتحدث عن غورو هنا

209
00:16:44,960 --> 00:16:45,750
...ريو-سان

210
00:16:48,750 --> 00:16:50,540
.هذا يكفي

211
00:16:50,750 --> 00:16:52,630
أقسم أنني سأعود

212
00:16:53,210 --> 00:16:54,830
.بعدما أجد الحقيقة

213
00:16:55,960 --> 00:16:56,960
.ريو-سان

214
00:16:58,290 --> 00:16:59,750
.يمكنك فعلها

215
00:17:00,170 --> 00:17:02,750
.ستجد دليلا على براءة والدك

216
00:17:03,250 --> 00:17:04,380
!نحن نؤمن بذلك

217
00:17:05,170 --> 00:17:06,790
.كن بأمان رجاءً

218
00:17:18,710 --> 00:17:19,710
!هاراساكي

219
00:17:22,710 --> 00:17:23,670
ما الأمر؟

220
00:17:24,330 --> 00:17:26,420
ستغادر إلى هونغ كونغ هذا اليوم، صحيح؟

221
00:17:26,960 --> 00:17:27,630
.أجل

222
00:17:28,210 --> 00:17:32,000
.أعلم كيف أنت مع هذه الأمور لذا لن أقول أيّ شيء

223
00:17:32,540 --> 00:17:35,710
.لكن رجاءً... خذ هذه معك على الأقل

224
00:17:34,290 --> 00:17:35,790
تميمة
حظّ

225
00:17:36,830 --> 00:17:37,580
تميمة؟

226
00:17:38,130 --> 00:17:43,830
.تمنّيت على هذه التميمة أن تكون بأمان مهما حدث
.لذا أعلم أنّ الإله سيحميك

227
00:17:44,580 --> 00:17:45,630
.شكرا على هذه

228
00:17:49,330 --> 00:17:51,330
.أراك مجددا... يوما ما

229
00:17:52,040 --> 00:17:52,830
.أجل

230
00:18:12,000 --> 00:18:15,580
.غباؤك لا حدود له. لقد سئمت منه

231
00:18:17,710 --> 00:18:20,210
.شكرا لك على تدبير سفري إلى هونغ كونغ

232
00:18:20,630 --> 00:18:24,500
.لم أفعل أي شيء. غيزانغ هو من أقنعني

233
00:18:25,170 --> 00:18:28,420
.لكن أخشى أنني لن أسمح لك بالذهاب لوحدك

234
00:18:29,880 --> 00:18:31,210
.سآتي رفقتك

235
00:18:31,960 --> 00:18:35,630
.قد يشكل عائقا أمامك لكنه سيكون حليفك

236
00:18:36,460 --> 00:18:40,130
.نحن مهتمّون بمراقبة تحركات تشي يو مين

237
00:18:40,960 --> 00:18:42,000
.تماما

238
00:18:42,710 --> 00:18:43,580
...غيزانغ

239
00:18:43,920 --> 00:18:47,920
عندما تصل إلى هونغ كونغ، كيف سيجري بحثك؟

240
00:18:47,920 --> 00:18:53,290
سأبدأ في البحث عن يواندا زو. هل تعرف أين يمكنني إيجاده؟

241
00:18:53,710 --> 00:18:57,000
.لوء الحظّ، لا أعرف مكانه الحاليّ

242
00:18:57,330 --> 00:19:01,580
.لكن يمكنني تعريفك على شخص موثوق قد يساعدك

243
00:19:04,130 --> 00:19:04,920
!انتبه

244
00:19:05,460 --> 00:19:06,210
!أبي

245
00:19:12,170 --> 00:19:12,960
!غيزانغ

246
00:19:17,170 --> 00:19:20,130
!آسف! لن تذهب لهونغ كونغ

247
00:19:20,130 --> 00:19:24,460
!لأنك! ستخسر أمامي

248
00:19:25,500 --> 00:19:26,960
!ما الذي تفعله هنا؟

249
00:19:27,250 --> 00:19:29,830
!المرآة ملكي الآن! سآخذها

250
00:19:42,540 --> 00:19:47,710
!أنت القديم، ضعيف! أنت الآن، قوي جدا؟ لماذا

251
00:19:48,380 --> 00:19:49,920
!لن أخسر أمام أيّ شخص

252
00:19:50,630 --> 00:19:53,830
!إلى أن أعرف الحقيقة بخصوص والدي وسبب موته

253
00:20:11,170 --> 00:20:11,750
!غيزانغ

254
00:20:12,000 --> 00:20:12,830
!هل أنت بخير؟

255
00:20:15,040 --> 00:20:16,750
.لا يمكنك السفر ورجلك هكذا

256
00:20:16,750 --> 00:20:20,830
!كلا! سأذهب! لا يمكن أن يواجه هازوكي تشي يو مين من دوني

257
00:20:21,250 --> 00:20:22,420
.توقف يا غيزانغ

258
00:20:23,170 --> 00:20:24,250
.ابقَ هنا

259
00:20:25,500 --> 00:20:28,210
!ماذا؟! لا تعتقد أنّ هذه الإصابة ستجعلني دون فائدة

260
00:20:28,500 --> 00:20:29,750
!ليس الأمر كذلك

261
00:20:30,830 --> 00:20:32,830
...لا أعلم كيف أقول هذا

262
00:20:35,580 --> 00:20:38,920
.أعتقد أنه من الأفضل أن تبقى مع والدك

263
00:20:40,630 --> 00:20:41,460
...هازوكي

264
00:20:43,460 --> 00:20:44,880
.شكرا لكما. إلى اللقاء

265
00:20:45,580 --> 00:20:47,210
.رحلة موفقة

266
00:20:59,080 --> 00:21:02,420
...يا للأسف. كنت آمل أنّ قضاء بعض الوقت بمفردك

267
00:21:02,750 --> 00:21:05,790
.سيمنحك فرصة لتنضج

268
00:21:06,960 --> 00:21:08,790
.البقاء كان الخيار الأفضل

269
00:21:09,330 --> 00:21:11,750
.أعتقد أنّ في إمكاني أن أنضج هنا

270
00:21:12,540 --> 00:21:16,330
.ظننت أنك تكره البقاء إلى جانبي

271
00:21:17,080 --> 00:21:17,960
.كلا

272
00:21:18,500 --> 00:21:20,250
..مهما حدث، فأنا

273
00:21:21,830 --> 00:21:23,130
.ابن والدي دائما

274
00:21:25,210 --> 00:21:27,330
أهذا أمر يستحقّ التكرار؟

275
00:21:30,130 --> 00:21:31,130
...هازوكي

276
00:21:36,210 --> 00:21:36,960
!غيزانغ

277
00:21:38,580 --> 00:21:39,460
.شكرا لك

278
00:21:44,750 --> 00:21:48,420
.كلا. أنا من يجدر به شكرك

279
00:22:03,710 --> 00:22:04,750
...انتظرني فحسب

280
00:22:05,830 --> 00:22:06,880
!يا لان دي

281
00:23:40,000 --> 00:23:45,000
مبجّل

282
00:23:41,330 --> 00:23:43,420
."في الحلقة القادمة "مبجّل