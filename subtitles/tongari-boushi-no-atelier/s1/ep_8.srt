1
00:00:06,430 --> 00:00:08,360
.لا حاجة للخوف

2
00:00:09,860 --> 00:00:12,400
،بمجرّد فقدانك لذكرياتك عن السّحر

3
00:00:12,400 --> 00:00:14,960
.فستنسين حتّى ذلك الخوف

4
00:00:15,590 --> 00:00:18,330
.ستصيرين من "الجاهلين" ببساطة

5
00:00:18,330 --> 00:00:22,630
!أخبرناك أنّ الأمر ليس كما تظنّ
!لماذا لا تصغي إلينا؟

6
00:00:23,080 --> 00:00:24,410
...لا

7
00:00:24,410 --> 00:00:25,640
...لا أريد أن

8
00:00:43,170 --> 00:00:44,440
ما هذا؟

9
00:00:44,440 --> 00:00:46,360
!سرير الثّعبان الرّمليّ؟

10
00:00:46,750 --> 00:00:49,320
!إنّهما يحاولان أن يشرحا لكم ما حدث

11
00:00:49,320 --> 00:00:51,570
!وعدم الإصغاء إليهما قسوة واضحة

12
00:00:52,250 --> 00:00:53,570
من يكنّ؟

13
00:00:54,040 --> 00:00:55,310
.مجرّد أطفال

14
00:00:55,950 --> 00:00:57,830
.لقد أحرقن الأعلام

15
00:00:59,650 --> 00:01:00,960
...أكره حقًّا

16
00:01:01,420 --> 00:01:07,290
البالغين الّذين يظنّون أنّ الأطفال كائنات
.غير بشريّة ومجرّد "أطفال" في نظرهم

17
00:01:07,710 --> 00:01:10,220
.مُلابسات الوضع ليست مهمّة هنا

18
00:01:10,940 --> 00:01:13,450
.تمّ خرق القانون

19
00:01:14,550 --> 00:01:17,010
ولا يُحفظ السّلام والنّظام في هذا العالم

20
00:01:17,010 --> 00:01:22,000
إلاّ بالتزام جميع السّحرة بهذا
.القانون بكلّ صرامة

21
00:01:22,810 --> 00:01:25,730
،وأيّ خلل ولو كان طفيفًا
.يعني انهيارًا محتومًا لذلك

22
00:01:25,730 --> 00:01:29,230
.لذلك لا مجال لأيّ استثناءات

23
00:01:29,740 --> 00:01:34,300
إنّك تُطيل الكلام كثيرًا بالنّسبة
.لشخص يرفض الاستماع بشدّة

24
00:01:37,070 --> 00:01:41,000
.لا تلمس ولو شعرة من تلميذاتي يا إيسثيس

25
00:01:41,840 --> 00:01:45,380
.فهمت. إنّهنّ تلميذاتك أنت إذًا

26
00:01:46,160 --> 00:01:49,000
.إنّهنّ وقحات تمامًا مثل معلّمهنّ

27
00:01:50,260 --> 00:01:53,630
،"إن كنت أنت مثال "التّلميذ الجيّد
.فأنّا مسرور لأنّهنّ لسن كذلك

28
00:01:54,910 --> 00:01:58,130
خاصّة وإن كانت هذه هي طريقة
.عمل فرقة فرسان الحرس السّحريّة

29
00:02:00,090 --> 00:02:03,140
.لا نسعى إلاّ للحفاظ على النّظام

30
00:02:04,540 --> 00:02:08,200
إنّ التّعاويذ القويّة بما يكفي
،لتغيير حتّى تضاريس الأرض

31
00:02:08,200 --> 00:02:11,050
مثلما حدث في جبل دادا
،أو غابة ظلّ ثريستاس

32
00:02:11,050 --> 00:02:13,660
هي تعاويذُ حروبٍ تعود
.إلى ما قبل يوم العهد

33
00:02:15,250 --> 00:02:21,660
،وإذا ما استُخدمت مثلما هو الحال الآن
.فيجب اتّخاذ الإجراءات اللاّزمة

34
00:02:21,660 --> 00:02:22,980
،ومع ذلك

35
00:02:22,980 --> 00:02:26,420
من غير المنطقيّ أن تسلبوا ذكريات
.شخص ما دون السّؤال عن الظّروف

36
00:02:26,880 --> 00:02:31,610
ثمّ إنّني لم أقدّم لتلميذاتي
التّقنيات أو الأدوات اللاّزمة

37
00:02:31,610 --> 00:02:34,180
.لإنجاز تعويذة بهذا الحجم

38
00:02:34,980 --> 00:02:39,310
حتّى إن لم تفعل ذلك، أليس من الممكن
أنّ القبّعات ذات الحواف فعلوا ذلك؟

39
00:02:44,570 --> 00:02:46,360
!أنتم هناك

40
00:02:46,810 --> 00:02:49,300
،لا بأس بالنّقاش الصّحّيّ

41
00:02:49,300 --> 00:02:52,690
لكن أتمنّى ألاّ تكونوا قد نسيتم الواجب
.الّذي على السّحرة تأديته

42
00:02:53,050 --> 00:02:55,200
."ألاّ وهو "وهبُ النّاسِ نعمةَ السّحر

43
00:02:55,630 --> 00:02:58,700
.يبدو أنّ الفتيات يدركن ذلك أكثر منكم

44
00:03:01,290 --> 00:03:04,620
!لذلك كفّوا عن الطّفو وقدّموا المساعدة

45
00:03:04,620 --> 00:03:06,950
!يبدو أنّ تلك الأعلام ستكون مفيدة جدًّا

46
00:03:15,140 --> 00:03:17,440
هـ-هل سيشفيه ذلك؟

47
00:03:17,440 --> 00:03:19,960
.لا، سيوقف النّزيف فحسب

48
00:03:19,960 --> 00:03:22,200
.سآخذه إلى كالن

49
00:03:22,200 --> 00:03:25,310
،إن أخذناه إلى طبيب بسرعة
—فسيتمكّن من النّجا

50
00:03:25,310 --> 00:03:26,580
.رأيتكم

51
00:03:26,580 --> 00:03:29,340
!رأيتكم تصلحون أعلامكم بالسّحر

52
00:03:30,720 --> 00:03:33,140
!بإمكانك شفاء إصاباته أيضًا، صحيح؟

53
00:03:33,140 --> 00:03:36,020
!يجب أن يكون السّحر قادرًا على ذلك أيضًا

54
00:03:37,630 --> 00:03:39,910
.لا، أخشى أنّه ليس كذلك

55
00:03:40,450 --> 00:03:43,480
!كلاّ! ذلك ليس صحيحًا

56
00:03:43,480 --> 00:03:44,920
.اتركني رجاءً

57
00:03:48,320 --> 00:03:50,940
أم أنّك تفضّل أن أتركه هنا؟

58
00:03:56,080 --> 00:03:57,340
.لا بأس

59
00:03:58,990 --> 00:04:01,820
.اعتنوا به رجاءً

60
00:04:08,690 --> 00:04:14,210
،"وبعد أن يغادر "الجاهلون
.سنعود للتّحقّق من الأمر بدقّة

61
00:05:57,780 --> 00:06:00,500
.هذه مجرّد تعويذة أساسيّة شائعة

62
00:06:00,930 --> 00:06:04,450
مستحيل أن تستطيع تدمير
.ضفّة النّهر بالكامل بهذه

63
00:06:04,450 --> 00:06:05,760
.صحيح

64
00:06:08,320 --> 00:06:09,390
.أريني يديك

65
00:06:11,440 --> 00:06:16,450
يقوم سحرة القبّعات ذات الحواف أحيانًا
.بوشم الدّوائر السّحريّة على أجسامهم

66
00:06:16,900 --> 00:06:19,410
التّعاويذ المحظورة الّتي تهدف
،إلى تحسين أو تغيير الجسد

67
00:06:19,410 --> 00:06:22,720
...أو جعل إلقاءها أكثر قوة

68
00:06:25,460 --> 00:06:29,450
،آثار قلم حديثة على الأصابع
...ويدان ملطّختان بالحبر السّحريّ

69
00:06:37,040 --> 00:06:39,040
هل اكتفيت الآن؟

70
00:06:48,540 --> 00:06:52,000
،وإن تبيّن أنّ ورشتك هي أصل المشكلة

71
00:06:52,000 --> 00:06:53,680
.فلن أتساهل معك

72
00:06:54,070 --> 00:06:58,310
احرصي جيّدًا على ألاّ تفقدي
.ما بدأت تتعلّمينه حديثًا

73
00:07:07,040 --> 00:07:09,320
!وتّرني ذلك بشدّة

74
00:07:09,320 --> 00:07:11,700
.أنا مسرور لأنّ الجميع بخير الآن

75
00:07:15,330 --> 00:07:18,420
.لم يكن ينبغي أن نترككما خلفنا

76
00:07:18,420 --> 00:07:19,870
!أنا جدّ آسف

77
00:07:19,870 --> 00:07:22,460
!هذا ليس خطأك أيّها المُعلّم

78
00:07:22,460 --> 00:07:24,670
.لحسن الحظّ أنّ الجميع حضر

79
00:07:22,460 --> 00:07:25,280
...ومع ذلك يا أغات وكوكو

80
00:07:27,120 --> 00:07:30,460
أريدكما أن تدركا أنّ ما فعلتماه
.كان خطيرًا للغاية

81
00:07:31,070 --> 00:07:33,970
،لو انكشفت أسرار السّحر لأيّ أحد

82
00:07:34,610 --> 00:07:38,650
لوجب محو ذكريات كلّ الأشخاص
.الّذين أنقذناهم اليوم

83
00:07:39,470 --> 00:07:42,040
.الذّكريات هي أساس حياة المرء

84
00:07:42,040 --> 00:07:45,240
.وكادت أفعالكما أن تسلبهم جزءًا من ذلك

85
00:07:45,680 --> 00:07:47,140
.آنا آسفة

86
00:07:47,140 --> 00:07:48,630
.سأكون أكثر حذرًا

87
00:07:49,830 --> 00:07:54,370
بعد هذا... أعتقد أنّ أخذي
.للامتحان سيتأجّل

88
00:07:54,730 --> 00:07:58,510
.لكنّكما نجحتما في الأمر
...ولذلك

89
00:07:58,870 --> 00:08:02,620
.سأقدّم طلبًا لتجتازي امتحانك الثّاني يا أغات

90
00:08:04,350 --> 00:08:09,010
إذا نجحتِ، ستصيرين مؤهّلة
.لمرافقتي في المهام الميدانيّة

91
00:08:10,480 --> 00:08:14,260
وحتّى ذلك الحين، هلاّ وعدتني
بألاّ تستعملي السّحر أمام النّاس؟

92
00:08:15,890 --> 00:08:17,140
!نعم

93
00:08:17,140 --> 00:08:19,510
!ماذا؟ أغات وحدها؟

94
00:08:19,510 --> 00:08:22,150
!ماذا عنّا أيضًا أيّها المعلّم؟

95
00:08:22,150 --> 00:08:26,470
لم تُكملن بعد نسخَ دليلِ أساسيّات
السّحر، أليس كذلك؟

96
00:08:27,580 --> 00:08:30,460
.لا بأس. لا أحبّ الامتحانات من الأساس

97
00:08:30,460 --> 00:08:32,620
!ثمّة المزيد من الامتحانات؟

98
00:08:33,800 --> 00:08:35,500
.يا كيفري

99
00:08:36,140 --> 00:08:37,380
أواثق من هذا؟

100
00:08:37,380 --> 00:08:39,710
ألم تكن قلقًا من أنّ أغات تبدو متسرّعة؟

101
00:08:40,180 --> 00:08:41,290
.نعم

102
00:08:41,290 --> 00:08:42,700
...ولكن

103
00:08:41,290 --> 00:08:42,720
!ابذلي جهدك يا أغات

104
00:08:44,220 --> 00:08:45,730
.هذا ليس ما تفعله الآن

105
00:08:47,300 --> 00:08:51,300
.أعتقد أنّها استحقّت أن نؤمن بها

106
00:08:51,630 --> 00:08:53,280
.تتساهل معهنّ كثيرًا

107
00:08:53,280 --> 00:08:56,440
عندما يقسوا تلاميذي على أنفسهم
.كثيرًا، فعليّ التّساهل معهم

108
00:08:57,690 --> 00:08:59,310
!أيّها المعلّم كيفري

109
00:08:59,970 --> 00:09:02,320
!أريد العودة سريعًا لأتدرّب

110
00:09:02,320 --> 00:09:03,430
.انتظري لحظة

111
00:09:09,470 --> 00:09:12,540
.لا يزال هناك أمر آخر يجب القيام به

112
00:09:13,320 --> 00:09:16,330
كانت تلك الفتاة هي تلميذة
كيفري الجديدة، صحيح؟

113
00:09:16,870 --> 00:09:18,580
...إن كانت الشّائعات صحيحة

114
00:09:19,950 --> 00:09:22,830
هل يمكن إثبات أنّ الشّائعات صحيحة؟

115
00:09:22,830 --> 00:09:27,620
لا، البحث عن دليل في ذلك
.المنزل المتحجّر مستحيل

116
00:09:29,000 --> 00:09:32,420
في تلك الحالة، سيكون علينا
.انتزاع اعتراف منها

117
00:09:32,420 --> 00:09:33,340
.انظر

118
00:09:34,150 --> 00:09:38,180
.بسبب تلك التّعويذة، جفّ النّهر بالكامل

119
00:09:38,720 --> 00:09:41,060
جعل سقوطُ صخرةٍ واحدةٍ
،ضفّة النّهر تنهار

120
00:09:41,060 --> 00:09:44,580
،وتحوّل مساره تدفّقه
.وتغيّرت البيئة المحيطة به

121
00:09:45,550 --> 00:09:51,330
وهكذا ضاع ذلك المشهد الجميل
.الّذي كان موجودًا هناك إلى الأبد

122
00:09:53,480 --> 00:09:56,270
.قد تكون تلك الفتاة هي الصّخرة الأولى

123
00:09:56,270 --> 00:10:01,620
،إن كان هنالك احتمال بأن تسقط
.فعليّ إزالتها عن الطّريق بأيّ ثمن

124
00:10:06,130 --> 00:10:08,880
.يملك أولروغيو قلمًا مميزًّا

125
00:10:08,880 --> 00:10:10,940
،إنّه يُسمّى عصا النّقش الحارق

126
00:10:10,940 --> 00:10:14,300
وهو يسمح له بحرق دوائر سحريّة
.على الحجارة والأشجار

127
00:10:16,140 --> 00:10:18,260
.إنّه مجرّد حلّ مؤقّت لا غير

128
00:10:33,670 --> 00:10:35,870
.بدأت مياه النّهر تعود أيضًا

129
00:10:36,230 --> 00:10:39,020
.يبدو أنّ تأثير تعويذة التّفتّت قد بدأ يتلاشى

130
00:10:45,520 --> 00:10:46,360
.كوكو

131
00:10:52,150 --> 00:10:53,870
.خذي، أوقعتِ هذه

132
00:10:54,760 --> 00:10:56,450
.كوني حذرة

133
00:10:56,450 --> 00:10:59,520
نسيان قبّعتك أو حبرك السّحريّ
.قد يكون مشكلة كبيرة

134
00:11:01,320 --> 00:11:04,570
.أنا آسفة. شكرًا جزيلاً لك

135
00:11:07,490 --> 00:11:09,490
...ماذا؟ هذا غريب

136
00:11:11,070 --> 00:11:13,690
.لم ينقص شيء من حبري السّحريّ

137
00:11:15,790 --> 00:11:17,950
!هل هذه قارورة سحريّة أو ما شابه؟

138
00:11:17,950 --> 00:11:20,000
!هل تملأ نفسها باستمرار؟

139
00:11:20,000 --> 00:11:23,090
كوكو، أتمانعين إن ألقيتُ نظرة عليها؟

140
00:11:23,790 --> 00:11:25,080
لماذا أيّها المعلّم؟

141
00:11:37,350 --> 00:11:40,910
.السّحر كذبة تلوّن العالم

142
00:11:42,800 --> 00:11:45,980
،ترسم هذه الأيدي تعاويذ جميلة

143
00:11:45,980 --> 00:11:49,160
.لكنّها تتلطّخ بنفس ذلك الحبر

144
00:11:51,860 --> 00:11:53,100
...والكذب

145
00:11:55,630 --> 00:11:58,110
.من طبيعته أن يُكتشف عند التّدقيق فيه

146
00:12:07,230 --> 00:12:10,160
فإلى متى ستظلّ الحقيقة مخفيّة يا ترى؟

147
00:12:15,010 --> 00:12:16,890
...هذا الحبر السّحريّ

148
00:12:17,780 --> 00:12:20,580
هذا هو الّذي حصلتِ عليه
من السّيّد نولنوا في كالن، صحيح؟

149
00:12:20,580 --> 00:12:21,510
.نعم

150
00:12:27,600 --> 00:12:31,720
.أولروغيو. خذ الفتيات وعودوا إلى الورشة

151
00:12:31,720 --> 00:12:32,820
ماذا؟

152
00:12:32,820 --> 00:12:35,150
وإلى أين تنوي أنت الذّهاب؟

153
00:12:35,150 --> 00:12:36,150
...أنا

154
00:12:37,990 --> 00:12:41,970
،وخلال تلك الفوضى الكبيرة
.غفلتُ عن شراء قلم لكوكو

155
00:12:41,970 --> 00:12:45,330
،المكان قريب
.لذلك سنتوقّف في كالن أوّلاً

156
00:12:45,330 --> 00:12:47,880
.لا تنسَ إذًا أن تحضر لي نبيذَ رحيقِ الأشجار

157
00:12:47,880 --> 00:12:50,460
!زجاجة من الحصاد الأوّل وأخرى معتّقة

158
00:12:50,460 --> 00:12:52,330
!تُعجبني نباهتك

159
00:12:52,960 --> 00:12:54,120
.أنا آسف

160
00:12:57,070 --> 00:13:00,530
.هناك أمر لا بدّ أن أتأكّد منه

161
00:13:07,100 --> 00:13:10,600
!ماذا؟ اختفى الباب

162
00:13:11,070 --> 00:13:12,850
.هذا سيّئ

163
00:13:13,270 --> 00:13:15,480
.يبدو أنّ المتجر مغلق اليوم

164
00:13:15,480 --> 00:13:18,610
ماذا؟! يختفي المتجر بالكامل
!عندما يكون مغلقًا؟

165
00:13:21,930 --> 00:13:23,370
!سيّد كيفري

166
00:13:24,610 --> 00:13:26,620
.وتلك الفتاة أيضًا

167
00:13:26,920 --> 00:13:29,600
.مرحبًا يا تارتا! سررت بوجودك

168
00:13:29,600 --> 00:13:31,620
.عليّ الحديث مع السّيّد نولنوا

169
00:13:31,620 --> 00:13:34,130
.حسنًا، مهلاً لحظة

170
00:13:51,620 --> 00:13:53,590
.تفضّلا بالدّخول

171
00:14:00,450 --> 00:14:03,150
!الغرفة مختلفة تمامًا عمّا كانت سابقًا

172
00:14:04,560 --> 00:14:08,180
يعرف الجميع أنّ من الطّبيعيّ أن تختلف
.الغرف مع اختلاف مقابض الباب

173
00:14:09,100 --> 00:14:11,160
.أظنّ أنّ جدّي في الطّابق الثّالث

174
00:14:11,160 --> 00:14:13,630
.شكرًا لك. نعتذر على التّطفّل

175
00:14:16,960 --> 00:14:18,390
...انتظري لحظة

176
00:14:19,020 --> 00:14:21,670
.عفوًا، ذكّريني باسمك

177
00:14:22,250 --> 00:14:23,310
.اسمي كوكو

178
00:14:23,670 --> 00:14:24,930
!أنا كوكو

179
00:14:24,930 --> 00:14:29,220
كوكو. يجب عليك معالجة تلك
.الإصابة في ساقك اليمنى

180
00:14:30,240 --> 00:14:31,610
.تعالي معي

181
00:14:31,930 --> 00:14:34,310
.لديّ القليل من عشبة السَّكينة لتعقيمها

182
00:14:42,880 --> 00:14:45,380
!ثمّةَ موادٌّ سحريّة كثيرة لا أعرفها

183
00:14:51,200 --> 00:14:52,450
!كم هذا جميل

184
00:14:53,160 --> 00:14:55,710
ما هذا المسحوق البرّاق؟

185
00:14:55,710 --> 00:14:57,900
.لا تعبثي به رجاءً

186
00:14:57,900 --> 00:14:59,940
.لا أريدك أن تغيّري ترتيبها

187
00:15:01,010 --> 00:15:03,090
.إنّها أصباغ سحريّة

188
00:15:03,090 --> 00:15:06,490
.تُخلط مع الحبر لتغيير تأثيره

189
00:15:09,040 --> 00:15:10,390
.سيّد نولنوا

190
00:15:10,740 --> 00:15:14,390
.كيفري؟ المتجر مغلق اليوم

191
00:15:14,390 --> 00:15:17,150
...أعلم، ولكن

192
00:15:18,070 --> 00:15:19,610
.أمزح فحسب

193
00:15:19,610 --> 00:15:22,900
.أعرف تمامًا لماذا أنت هنا

194
00:15:23,480 --> 00:15:27,530
الدّائرة السّحريّة الّتي رُسمت
على بلاط حجارة الشّارع، صحيح؟

195
00:15:28,280 --> 00:15:31,250
.لم أتكتشف أيّ شيء بعد

196
00:15:31,250 --> 00:15:34,790
جرّبتُ تعويذة تفصل بين مختلف
،الأصباغ السّحريّة

197
00:15:35,320 --> 00:15:38,200
.لكنّها مُزجت ببعضها ببراعة شديدة

198
00:15:38,760 --> 00:15:41,540
هل توصّلت أنت إلى أيّ شيء؟

199
00:15:41,540 --> 00:15:44,690
.في الحقيقة، حصلتُ على هذا

200
00:15:58,240 --> 00:16:00,300
!إنّه يُشبهه بالكامل

201
00:16:00,810 --> 00:16:04,570
لا، بل إنّ هذه الزُّرقة الطّفيفة
!مطابقة تمامًا

202
00:16:06,100 --> 00:16:08,430
ولكن من أين حصلت...؟

203
00:16:10,900 --> 00:16:14,830
مهلاً لحظة. أليست هذه قارورتي؟

204
00:16:15,890 --> 00:16:17,260
.حدث الأمر يومها

205
00:16:18,200 --> 00:16:21,920
ألقى ساحر القبّعة ذات الحواف
.سحرًا على القارورة

206
00:16:24,170 --> 00:16:25,600
!ما الّذي تفعله؟

207
00:16:26,360 --> 00:16:29,680
لا يجب عليك الرّسم بذلك الحبر
!السّحريّ قبل أن أتفحّصه

208
00:16:30,610 --> 00:16:32,010
!كيفري

209
00:16:34,220 --> 00:16:38,560
أخبرني، وما تلك الّتي باللّون الزّبرجديّ؟

210
00:16:38,910 --> 00:16:41,560
!القدر الكبيرة المعلّقة في السّقف

211
00:16:41,560 --> 00:16:44,190
.إنّه مسحوق زهرة القمر الأزرق

212
00:16:44,190 --> 00:16:47,190
عند خلطه بالحبر، يدوم تأثير
.التّعاويذ لفترة أطول

213
00:16:49,160 --> 00:16:54,200
وتلك القارورة الصّغيرة على الرّفّ
ذات المسحوق الأبيض اللاّمع؟

214
00:16:54,200 --> 00:16:56,770
.إنّه غبار فراشة العروس الخجولة

215
00:16:56,770 --> 00:16:59,570
،يصير الحبر السّحريّ شفّافًا عند خلطه به

216
00:16:59,570 --> 00:17:01,830
وذلك يُخفي خطوط الدّوائر السّحريّة؟

217
00:17:01,830 --> 00:17:03,470
والّتي بجانبها؟

218
00:17:03,470 --> 00:17:06,640
تحتوي القارورة الطّويلة
.على مسحوق المحّار الجوّال

219
00:17:06,640 --> 00:17:10,270
وتحتوي القارورة المستديرة المجاورة على
.مسحوق حراشف تنّين الشّعلة الذّهبيّة

220
00:17:14,840 --> 00:17:16,310
!هذا مذهل

221
00:17:16,970 --> 00:17:19,320
!أنت مذهل يا تارتا

222
00:17:19,320 --> 00:17:23,100
!هل تحفظ أسماء كلّ هذه الأصباغ؟

223
00:17:23,100 --> 00:17:24,860
.طبعًا... فنحن نتاجر بها

224
00:17:25,250 --> 00:17:28,740
أنت محظوظ. من الرّائع أن تعيش
!في متجر للموادّ السّحريّة

225
00:17:28,740 --> 00:17:33,240
مجرّد رؤية هذه الرّفوف والقوارير
!المصطفّة عليها تجعلني متحمّسة جدًّا

226
00:17:33,950 --> 00:17:37,090
!كم أحسدك على هذا يا تارتا

227
00:17:38,240 --> 00:17:41,270
.العيش في ورشة أفضل بكثير

228
00:17:41,980 --> 00:17:45,500
لا أدري لماذا قد تقول ساحرة
.مثلك ما قلتِه للتّوّ

229
00:17:46,000 --> 00:17:49,260
ألستَ تلميذ سحر أيضًا يا تارتا؟

230
00:17:50,440 --> 00:17:51,690
...أنا

231
00:17:55,260 --> 00:17:57,970
ما وظيفة ذلك المسحوق الأحمر؟

232
00:17:57,970 --> 00:17:59,090
أيّ واحد؟

233
00:18:00,190 --> 00:18:02,140
!ذاك! على ذلك الرّفّ

234
00:18:07,150 --> 00:18:10,400
بين المسحوق الزّبرجديّ
!والمسحوق البنّيّ الذّابل

235
00:18:10,400 --> 00:18:13,400
!أخبريني فقط في أيّ رفّ ومستوى بالضّبط

236
00:18:16,070 --> 00:18:18,960
...إنّ لونه أحمر ساطع
من السّهل رؤيته، صحيح؟

237
00:18:28,500 --> 00:18:31,140
ما كان ذلك الضّوء؟

238
00:18:31,140 --> 00:18:33,180
!كان ذلك مخيفًا

239
00:18:33,180 --> 00:18:34,590
هل أنت بخير؟

240
00:18:38,800 --> 00:18:41,830
!حمدًا على هذا
.لم تنكسر أيّ قارورة منها

241
00:18:45,670 --> 00:18:47,110
.هذا فظيع

242
00:18:47,790 --> 00:18:49,410
!هذه كارثة

243
00:18:50,420 --> 00:18:53,770
،سقطت الأوسام منها
...واختلط كلّ شيء الآن

244
00:18:54,240 --> 00:18:58,870
،حذّرني جدّي من لمسها
.لكنّ الفوضى عارمة الآن

245
00:18:58,870 --> 00:19:02,620
!أنا آسفة. سأساعدك على إعادتها لمكانها

246
00:19:02,930 --> 00:19:04,980
تعرف ما هذه، صحيح؟

247
00:19:07,270 --> 00:19:08,880
—أيّ لون يقابل أيّ مادّة

248
00:19:08,880 --> 00:19:10,380
!لا أدري

249
00:19:11,400 --> 00:19:13,760
...لـ-لكنّك قبل قليل

250
00:19:13,760 --> 00:19:16,760
.أنا أذكرها حسب مكانها على الرّفوف

251
00:19:17,060 --> 00:19:19,260
.لا يمكنني التّمييز بينها حسب ألوانها

252
00:19:27,070 --> 00:19:30,400
.أنا آسف. غادري فحسب

253
00:19:30,770 --> 00:19:31,810
...لكن

254
00:19:34,190 --> 00:19:35,510
،أنا آسف

255
00:19:36,980 --> 00:19:39,720
.لكن لا يوجد ما يمكنك المساعدة به

256
00:19:40,850 --> 00:19:43,860
ثمّة أشياء يستطيع المرء فعلها
.وأخرى يعجز عنها

257
00:19:44,800 --> 00:19:47,230
...بسبب عينيّ المصابتين بالصّبغة الفضّيّة

258
00:19:47,230 --> 00:19:50,750
فلن أصير ساحرًا أبدًا مهما
.اجتهدتُ في دراستي

259
00:19:55,490 --> 00:19:57,430
!ألم أحذّرك بشأن هذا

260
00:19:58,870 --> 00:20:01,050
كيفري، هل أنت بخير؟

261
00:20:03,810 --> 00:20:05,150
!كيفري

262
00:20:06,290 --> 00:20:10,540
لا أصدّق أنّ دائرة سحريّة صغيرة
...كتلك لها كلّ هذه القوّة

263
00:20:12,300 --> 00:20:16,070
.أعتقد أنّها تعويذة القنّينتين التّوأمين

264
00:20:16,910 --> 00:20:20,060
.وعاءان يتشاركان نفس المكوّنات

265
00:20:20,060 --> 00:20:24,440
لا بدّ من وجود ميداليّة صغيرة
.منقوشة بدائرة سحريّة بداخلها

266
00:20:25,170 --> 00:20:27,620
...جعلوا كوكو تستخدم هذا

267
00:20:28,440 --> 00:20:32,290
كانت لا تزال ممتلئة لأنّهم عوّضوا
.ما نُقص بالخليط الغامض

268
00:20:33,180 --> 00:20:36,140
.هذه القارورة خيط يدلّنا إليهم

269
00:20:38,450 --> 00:20:42,270
!وأخيرًا... أمسكتُ بطرف خيط أخيرًا

270
00:20:42,890 --> 00:20:44,530
ما كلّ هذا؟

271
00:20:45,010 --> 00:20:47,070
أتقول أنّ الحبر الّذي في هذه القارورة

272
00:20:47,070 --> 00:20:50,300
بإمكانه إطلاق قوّة هائلة حتّى
من خلال دائرة سحريّة صغيرة؟

273
00:20:51,840 --> 00:20:55,020
!لا يجدر بشيء كهذا أن يوجد في العالم

274
00:20:55,470 --> 00:20:58,830
!هـ-هذا يفوق قدرتي على التّعامل معه

275
00:20:58,830 --> 00:21:00,910
!يجب أن نُبلغ القاعة الكبرى

276
00:21:00,910 --> 00:21:01,700
!هذا مرفوض

277
00:21:02,620 --> 00:21:06,790
لا يجب أن يقع هذا بين أيدي فرقة
.فرسان الحرس أو القاعة الكبرى

278
00:21:06,790 --> 00:21:10,670
من الأفضل ألاّ يعرف أحد
.أنّنا نعرف من الأساس

279
00:21:11,090 --> 00:21:12,880
...كيفري

280
00:21:14,200 --> 00:21:15,940
ما الّذي تقوله؟

281
00:21:17,170 --> 00:21:18,420
...أنت

282
00:21:19,040 --> 00:21:22,650
!هل تدرك ما الّذي تقوله؟

283
00:21:23,490 --> 00:21:25,460
ما الّذي ستفعله؟

284
00:21:25,460 --> 00:21:28,060
!ما الّذي ستفعله بذلك الحبر السّحريّ؟

285
00:21:30,630 --> 00:21:33,310
.أنا آسف يا سيّد نولنوا

286
00:21:42,540 --> 00:21:43,450
.كوكو

287
00:21:45,390 --> 00:21:46,590
.آسف على التّأخّر

288
00:21:46,990 --> 00:21:49,230
...بشأن قارورة حبرك السّحريّ

289
00:21:50,100 --> 00:21:53,620
يبدو أنّه أعطاك حبرًا باهظ
.الثّمن عن طريق الخطأ

290
00:21:54,090 --> 00:21:57,250
اشتريتُ لك حقيبة للتّعويض
.عن ذلك. خذي

291
00:21:58,860 --> 00:22:00,760
!شكرًا جزيلاً لك

292
00:22:14,610 --> 00:22:15,870
.أيّها المعلّم

293
00:22:17,150 --> 00:22:19,900
ما هي الصّبغة الفضّيّة؟

294
00:22:21,030 --> 00:22:22,650
...متلازمة الصّبغة الفضّيّة

295
00:22:22,650 --> 00:22:29,420
حالة عيون يولد بها الشّخص بحيث
.يرى كلّ شيء باللّون الفضّيّ

296
00:22:30,640 --> 00:22:33,910
،وبما أنّ السّحرة يقدّرون حدّة البصر

297
00:22:33,910 --> 00:22:36,670
فقد تكون الحياة في هذا العالم
.أصعب على من يعاني منها

298
00:22:37,040 --> 00:22:41,270
إنّ عدم تقبّلنا لاستثناءات كهذه
.هي من أسوأ صفات السّحرة

299
00:22:44,250 --> 00:22:45,430
.كوكو

300
00:22:47,970 --> 00:22:50,430
.لا داعي لتكوني قلقة إلى هذا الحدّ

301
00:22:51,330 --> 00:22:52,680
.ستكونين بخير

302
00:22:53,090 --> 00:22:57,730
،ما دمتِ تلميذة في ورشتي
.فسأحميك بكلّ ما أوتيت من قوّة

303
00:22:58,670 --> 00:23:01,820
.ليس عليك أن تقلقي حيال أيّ شيء

304
00:23:02,910 --> 00:23:04,060
.على الإطلاق

305
00:23:07,820 --> 00:23:09,670
.جدّي

306
00:23:09,670 --> 00:23:11,090
.أنا آسف

307
00:23:11,090 --> 00:23:15,820
،أفزعني ذلك الضّوء قبل قليل
.فسقطت بعض القوارير من رفوفها

308
00:23:16,830 --> 00:23:19,280
ما كان مصدر ذلك الضّوء القويّ؟

309
00:23:19,730 --> 00:23:21,710
أكانت تعويذة للسّيّد كيفري؟

310
00:23:23,680 --> 00:23:26,050
ماذا؟ ضوء؟

311
00:23:28,370 --> 00:23:30,490
.لا أذكر وجود أيّ ضوء

312
00:23:32,080 --> 00:23:33,630
جدّي؟

313
00:23:35,480 --> 00:23:40,020
الحلقة 9

314
00:23:35,480 --> 00:23:40,020
كابوس غارق في الظّلام