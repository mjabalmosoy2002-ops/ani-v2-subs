1
00:00:05,650 --> 00:00:09,160
هل يكون الرّياضيّون رياضيّين
منذ اللّحظة الّتي يولدون فيها؟

2
00:00:09,950 --> 00:00:12,690
ماذا عن رائدي الفضاء
ومعبودي الجماهير؟

3
00:00:14,140 --> 00:00:16,250
.لا يمكن معرفة ماذا سيكون المرء عند ولادته

4
00:00:17,380 --> 00:00:20,380
ولكن... ماذا عن السّحرة؟

5
00:01:20,870 --> 00:01:23,850
.عجبًا. آسفة على هذه الفوضى

6
00:01:23,850 --> 00:01:25,680
.أوشكتُ على الانتهاء من غسل ملابسي

7
00:01:29,170 --> 00:01:30,880
.سيعود كلّ شيء إلى طبيعته قريبًا

8
00:01:31,330 --> 00:01:34,310
!هذا الينبوع سحريّ

9
00:01:58,490 --> 00:02:00,870
.إنّه آسرٌ في كلّ مرّة أراه فيها

10
00:02:00,870 --> 00:02:03,630
!ما أروع السّحر

11
00:02:07,000 --> 00:02:12,930
،يعجّ العالم بالسّحر
.المعجزة الجوهريّة النّافعة

12
00:02:14,910 --> 00:02:19,580
السّحر الّذي بدأ كلّ شيء

13
00:02:14,970 --> 00:02:17,540
غير أنّ الكيفيّة الّتي يعمل بها
.ما تزال مجهولة

14
00:02:18,780 --> 00:02:22,410
السّحرة هم الوحيدون
،القادرون على إلقاء التّعاويذ

15
00:02:23,980 --> 00:02:28,140
.أمّا النّاس العاديّون فلا ينالون منه إلاّ بركته

16
00:02:29,250 --> 00:02:31,510
.ليس بمقدور الجميع أن يصيروا سحرة

17
00:02:34,510 --> 00:02:38,230
.إنّ من وُلدوا كسحرة محظوظين بالفعل

18
00:02:40,620 --> 00:02:41,680
ماذا؟

19
00:02:45,530 --> 00:02:47,420
—أيّتها الملاءات، أيّتها الملاءات

20
00:02:47,420 --> 00:02:50,750
!آمرك أن تتحوّلي إلى عباءة طائرة

21
00:02:55,650 --> 00:02:56,730
!مهلاً

22
00:02:56,730 --> 00:02:59,160
!هذا ليس "الطّيران" الّذي قصدتُه

23
00:03:15,900 --> 00:03:17,260
!إنّها عربة بيغاسوس

24
00:03:31,060 --> 00:03:33,570
!لم أرَ واحدة تهبط إلى الأرض من قبل

25
00:03:35,910 --> 00:03:39,350
!أمّي! ثمّة عربة بيغاسوس في الخارج

26
00:03:40,320 --> 00:03:45,300
!أمّي

27
00:03:52,590 --> 00:03:54,840
.أنا آسفة! لم أعلم أنّك كنت هناك

28
00:03:55,170 --> 00:03:58,680
.لا بأس. الخطأ خطئي لوقوفي قرب الباب

29
00:03:58,680 --> 00:04:00,650
!يا إلهي. لا أصدق هذا

30
00:04:00,650 --> 00:04:03,590
انظرا! من ظنّ أنّ هذا المكان
!يملك شيئًا كهذا؟

31
00:04:03,590 --> 00:04:07,160
عجبًا، لكن أليس تطريز عشبة
الحُمّيضة قديم الطّراز قليلاً؟

32
00:04:07,160 --> 00:04:10,450
!لن تصدّقا ماذا وجدت
.هذا دانتيل هاريان

33
00:04:10,450 --> 00:04:14,370
إنّه مذهل! لقد نفد بسرعة
.كبيرة في مدينة القلعة

34
00:04:14,370 --> 00:04:17,940
.أصبنا بقطع كلّ هذا الطّريق بعربة بيغاسوس

35
00:04:15,350 --> 00:04:18,750
!إنّهم الأشخاص الّذين أتوا بعربة بيغاسوس

36
00:04:20,310 --> 00:04:22,120
.كلاّ. أنا لستُ معهنّ

37
00:04:22,430 --> 00:04:25,720
المعذرة. ألديك المزيد من هذا الدّانتيل؟

38
00:04:25,720 --> 00:04:27,460
!نعم، بكلّ تأكيد

39
00:04:27,460 --> 00:04:29,450
!كم هذا ظريف أيضًا

40
00:04:28,440 --> 00:04:30,540
.كوكو، ساعدينا ولا تقفي بلا حراك

41
00:04:30,540 --> 00:04:31,690
ماذا عن هذا؟

42
00:04:32,250 --> 00:04:34,000
وبماذا أخدمك يا سيّدي؟

43
00:04:34,000 --> 00:04:36,150
.أنا أبحث عن قماش بلون الدّخان

44
00:04:36,150 --> 00:04:37,800
لكن بإمكاني المجيء لاحقًا
.إذا كنتم مشغولين

45
00:04:37,800 --> 00:04:39,720
.بإمكاني تولّي أمر القصّ من أجلك

46
00:04:39,720 --> 00:04:40,720
أنت؟

47
00:04:40,720 --> 00:04:42,650
.إنّها بارعة في ذلك

48
00:04:42,010 --> 00:04:43,550
!هذا جميل

49
00:04:42,650 --> 00:04:44,140
.مذهل

50
00:04:47,250 --> 00:04:49,850
أيمكنني الذّهاب لرؤية
عربة البيغاسوس عندما أنتهي؟

51
00:04:49,850 --> 00:04:51,170
ماذا؟

52
00:04:51,170 --> 00:04:52,690
!هناك عربة بيغاسوس في الخارج

53
00:04:53,190 --> 00:04:54,520
عربة بيغاسوس؟

54
00:04:54,520 --> 00:04:57,550
من الأفضل ألاّ تفكّري بالعبث
.بأغراض الزّبائن

55
00:04:57,550 --> 00:04:59,400
!لا تقلقي. سألقي نظرة عليها فقط

56
00:05:01,650 --> 00:05:05,330
لن أقول أنّي أريد
.أن أصير ساحرة بعد الآن

57
00:05:09,530 --> 00:05:11,870
.لا بأس إن انتهيت من عملك باكرًا

58
00:05:11,870 --> 00:05:13,540
!أجل

59
00:05:14,460 --> 00:05:17,080
.شكرًا على الانتظار
ما هي المقاسات الّتي تحتاج؟

60
00:05:17,080 --> 00:05:18,400
.حسنًا، دوّنتُها هنا

61
00:05:18,400 --> 00:05:20,050
.شكرًا لك

62
00:05:59,820 --> 00:06:00,920
.عجبًا

63
00:06:02,330 --> 00:06:05,800
.لديك تركيز عالٍ، ويداك ثابتتان لا ترتجفان

64
00:06:05,800 --> 00:06:08,930
—لا علامة لأيّ تردّد وتقطيعك دقيق

65
00:06:08,930 --> 00:06:11,690
.ولمستك الختاميّة متقنة لحدّ كبير

66
00:06:12,350 --> 00:06:15,490
لم أكن أعلم أنّ في هذه القرية
.حرفيّة موهوبة مثلك

67
00:06:17,090 --> 00:06:18,570
.وكأنّه سحر

68
00:06:19,940 --> 00:06:24,450
!لـ-لـ-لـ-لا! إنّه ليس كذلك على الإطلاق

69
00:06:24,450 --> 00:06:27,280
!السّحر أكثر غموضًا وأكثر بريقًا

70
00:06:27,280 --> 00:06:29,450
.إنّه قيّم وجميل جدًّا

71
00:06:29,450 --> 00:06:32,600
...وهو شيء أكثر... أكثر

72
00:06:33,020 --> 00:06:36,580
.قيمة وغِنًى

73
00:06:37,050 --> 00:06:39,310
ما الّذي أقوله؟

74
00:06:39,810 --> 00:06:42,130
تحبّين السّحر كثيرًا، أليس كذلك؟

75
00:06:44,520 --> 00:06:46,640
أتمانعين إن سألتك لماذا تحبّينه؟

76
00:06:52,260 --> 00:06:56,410
،عندما كنتُ طفلة
.ذهبتُ إلى مهرجان في القلعة

77
00:06:56,920 --> 00:07:00,150
.قابلتُ ساحرًا يرتدي قناعًا

78
00:07:17,900 --> 00:07:19,500
،أنتِ هناك

79
00:07:21,050 --> 00:07:23,720
أتودّين شراء كتاب صور سحريّ"؟

80
00:07:26,320 --> 00:07:27,760
سحريّ؟

81
00:07:27,760 --> 00:07:31,560
أحبّ كتب الصّور، ولكن ما هو السّحر؟

82
00:07:31,910 --> 00:07:36,070
.السّحر معجزة تبعث الحيويّة في هذا العالم

83
00:07:37,620 --> 00:07:40,110
،عربة بيغاسوس تحلّق في السّماء الواسعة

84
00:07:40,110 --> 00:07:43,150
والينبوع الدّائم الّذي يُبقي
...المياه صافية كالبلّور

85
00:07:43,150 --> 00:07:46,850
حتّى حجارة الرّصيف تحت قدميك

86
00:07:46,850 --> 00:07:50,820
.الّتي تتلألأ مع كلّ خطوة— كلّ ذلك سحر

87
00:07:52,980 --> 00:07:54,700
!جميل جدًّا

88
00:07:54,700 --> 00:07:58,820
!السّحر رائع! أنا أحبّ السّحر

89
00:07:58,820 --> 00:08:01,460
.يأتي معه عصًا سحريّة بالمجّان

90
00:08:04,810 --> 00:08:07,720
وهكذا اشتريت هذا؟

91
00:08:08,050 --> 00:08:10,670
.لكنّك قلتِ أنّك أردت فراولة مشويّة

92
00:08:10,670 --> 00:08:15,210
،عندما تبعت الفراشة
.وجدت شخصًا يرتدي قبّعة مدبّبة

93
00:08:15,210 --> 00:08:17,300
.سبق وأخبرتني بذلك

94
00:08:17,300 --> 00:08:21,730
!لذلك فهو كتاب صور سحريّ
!ومعه عصًا سحريّة

95
00:08:24,020 --> 00:08:26,390
.حسنًا. لنعد للمنزل الآن يا كوكو

96
00:08:26,390 --> 00:08:27,520
.تأخّر الوقت

97
00:08:27,520 --> 00:08:28,730
!أمّي

98
00:08:29,240 --> 00:08:34,990
عندما أكبر، أريد أن أصير ساحرة
!تجعل عالمنا نابضًا بالحياة

99
00:08:34,990 --> 00:08:36,200
.لا يمكنك ذلك

100
00:08:36,200 --> 00:08:37,550
لِمَ لا؟

101
00:08:38,540 --> 00:08:39,370
.كوكو

102
00:08:39,880 --> 00:08:45,230
لا يمكنك أن تصيري ساحرة
.إلاّ إن وُلدتِ بقوى سحريّة

103
00:08:45,880 --> 00:08:49,770
لا يملك الأشخاص العاديّون
.ما يلزم ليصبحوا سحرة

104
00:08:51,540 --> 00:08:53,450
.والآن، لنعد إلى المنزل

105
00:08:53,450 --> 00:08:54,390
!ولكن انظري

106
00:08:55,120 --> 00:08:57,720
!تلمع الأرض كلّما خطوتُ فوقها

107
00:09:00,640 --> 00:09:05,070
،إن لمعت الأرض كلّ الطّريق إلى المنزل

108
00:09:05,460 --> 00:09:08,090
فربّما ستكونين قادرة
.على استعمال السّحر أيضًا

109
00:09:17,660 --> 00:09:20,820
.وبعد ذلك، صرت أحبّ مشاهدة السّحر

110
00:09:20,820 --> 00:09:22,920
لا أستطيع التّخلّي عن حلمي
.بأن أصير ساحرة

111
00:09:22,920 --> 00:09:25,420
—هلاّ أخبرتني أكثر عن

112
00:09:26,960 --> 00:09:28,350
ما كان ذلك؟

113
00:09:29,090 --> 00:09:29,970
كوكو؟

114
00:09:29,970 --> 00:09:32,490
.هيّا، اهدآ الآن

115
00:09:33,230 --> 00:09:34,900
.اهدآ، اهدآ

116
00:09:44,350 --> 00:09:46,470
.انظر ما الّذي فعلتَه

117
00:09:46,470 --> 00:09:48,430
.اخرس... هذا مؤلم

118
00:09:48,430 --> 00:09:49,590
هل أنتما بخير؟

119
00:09:49,590 --> 00:09:50,590
.كوكو

120
00:09:50,590 --> 00:09:52,050
ماذا حدث؟

121
00:09:52,050 --> 00:09:54,240
.لم نفعل أيّ شيء. انكسرت وحدها

122
00:09:54,240 --> 00:09:57,380
.كاذب! لقد زحفت تحتها

123
00:09:57,380 --> 00:09:58,790
!أيّها الواشي

124
00:09:58,790 --> 00:10:01,370
.لقد أصاب رأسه، وسقطت

125
00:10:01,370 --> 00:10:03,500
!ماذا؟ كم هذا فظيع

126
00:10:04,060 --> 00:10:06,040
!انظرا ما الّذي حلّ بعربة البيغاسوس خاصّتنا

127
00:10:06,040 --> 00:10:08,300
.لقد كانت لوالدنا

128
00:10:08,300 --> 00:10:12,050
أنا جدّ آسفة على المتاعب
!الّتي تسبّبا بها لكنّ

129
00:10:12,320 --> 00:10:14,270
.لـ-لن يغيّر الاعتذار أيّ شيء

130
00:10:14,270 --> 00:10:16,410
!لا يمكننا العودة للمنزل بدون عربة

131
00:10:16,410 --> 00:10:18,310
ما الّذي يُمكننا فعله؟

132
00:10:19,370 --> 00:10:20,460
.المعذرة

133
00:10:22,730 --> 00:10:24,230
أيمكنني إصلاحها من أجلكنّ؟

134
00:10:25,910 --> 00:10:28,980
.الضّرر ليس جسيمًا حسب ما يبدو لي

135
00:10:28,980 --> 00:10:31,230
مهلاً، ومن تكون أنت؟

136
00:10:31,500 --> 00:10:34,800
أنا أعتذر. أظنّ أنّ التّعرّف عليّ
.سيكون سهلاً بقبّعتي المميّزة

137
00:10:40,990 --> 00:10:44,430
.أنا ساحر، واسمي كيفري

138
00:10:47,380 --> 00:10:49,230
.القبّعة المدبّبة

139
00:10:49,750 --> 00:10:51,000
أبإمكانك إصلاح عربتنا؟

140
00:10:51,000 --> 00:10:52,280
.نعم

141
00:10:52,280 --> 00:10:54,780
.أنقذتَ الموقف يا سيّدي السّاحر

142
00:10:54,780 --> 00:10:55,970
.لا أمانع على الإطلاق

143
00:10:56,490 --> 00:10:59,420
سأعيد إلقاء التّعويذة
.على أرضيّة العربة فحسب

144
00:10:59,420 --> 00:11:01,590
!سيساعدنا ذلك كثيرًا

145
00:11:01,590 --> 00:11:03,190
.بكلّ سرور

146
00:11:03,190 --> 00:11:05,260
ولكن، قد يكون القيام
—بهذا في الخارج

147
00:11:05,260 --> 00:11:07,690
!يـ-يمكنك استعمال ورشتنا

148
00:11:07,690 --> 00:11:08,710
!كوكو

149
00:11:09,040 --> 00:11:10,610
!لا تمانعين، صحيح يا أمّي؟

150
00:11:12,080 --> 00:11:13,110
...لأنّه

151
00:11:13,680 --> 00:11:16,110
.ساحر حقيقيّ

152
00:11:17,190 --> 00:11:19,810
...وربّما هذه فرصتي لرؤية

153
00:11:20,790 --> 00:11:23,630
.اللّحظة الّتي يُلقي فيها التّعويذة

154
00:11:32,490 --> 00:11:34,320
،أثناء إلقائي للتّعويذة

155
00:11:34,320 --> 00:11:38,120
أيمكنك مراقبة الخارج حتّى
لا يتسلّل أحد إلى الدّاخل؟

156
00:11:38,540 --> 00:11:41,140
.لا تسمحي لأيّ أحد بالدّخول مهما حدث

157
00:11:41,140 --> 00:11:42,180
مفهوم؟

158
00:11:45,150 --> 00:11:47,770
الحياة ليست بتلك السّهولة، أليس كذلك؟

159
00:11:48,770 --> 00:11:51,770
ولكن لماذا لا يمكننا مشاهدة كيف يتمّ ذلك؟

160
00:11:52,730 --> 00:11:55,970
،يمتلئ هذا العالم بالسّحر

161
00:11:55,970 --> 00:11:58,850
.ولكنّنا نجهل كيف يتمّ إلقاؤه

162
00:11:59,360 --> 00:12:01,660
.وحدهم السّحرة من يعرفون ذلك السّرّ

163
00:12:02,410 --> 00:12:03,820
...السّرّ

164
00:12:10,410 --> 00:12:11,500
ماذا؟

165
00:12:11,500 --> 00:12:12,740
!لقد انزلقت

166
00:12:14,800 --> 00:12:16,660
مهلاً! ما الّذي تظنّان أنّكما فاعلين؟

167
00:12:16,660 --> 00:12:17,550
!اكتشفت أمرنا

168
00:12:17,550 --> 00:12:19,300
.لا تعرها اهتمامًا، سنكون بخير

169
00:12:19,300 --> 00:12:21,270
أيمكننا رؤية الغرفة من هنا؟

170
00:12:22,300 --> 00:12:23,210
!انتظرا

171
00:12:23,210 --> 00:12:24,830
!أخفضي صوتك

172
00:12:24,830 --> 00:12:26,560
!ابتعدا

173
00:12:38,940 --> 00:12:40,920
.ماذا؟ كم هذا مملّ

174
00:12:40,920 --> 00:12:42,490
.معك حقّ

175
00:12:50,450 --> 00:12:51,460
!ما الّذي يحدث؟

176
00:13:22,870 --> 00:13:24,300
!لا يفترض بي الرّؤية

177
00:13:24,300 --> 00:13:26,240
!لكنّي أريد ذلك بشدّة

178
00:13:26,240 --> 00:13:27,120
!لكن ليس عليّ ذلك

179
00:13:54,700 --> 00:13:56,300
...إنّه يرسم

180
00:14:00,310 --> 00:14:03,170
يستعمل السّحر بقلم؟

181
00:14:05,170 --> 00:14:09,250
...لم يكن بعصًا إذًا

182
00:14:11,010 --> 00:14:15,140
...السّحر ليس تعويذات تُلقى

183
00:14:16,870 --> 00:14:18,060
!بل تُرسم

184
00:14:19,750 --> 00:14:20,920
.سيفي هذا بالغرض

185
00:14:20,920 --> 00:14:22,970
.كوكو، لقد انتهيت

186
00:14:31,360 --> 00:14:32,350
كوكو؟

187
00:14:32,350 --> 00:14:33,610
.شكرًا على عملك الدّؤوب

188
00:14:33,610 --> 00:14:34,620
.العفو

189
00:14:52,110 --> 00:14:54,780
.أشعر ببعض الاطمئنان الآن

190
00:14:55,540 --> 00:14:57,950
،إنّك تحبّين السّحر كثيرًا

191
00:14:58,470 --> 00:15:04,730
لذلك كنتُ أخشى أن تقولي أنّك
.تريدين الذّهاب مع ذلك السّاحر

192
00:15:06,160 --> 00:15:08,550
.فقدتُ والدك بسبب المرض

193
00:15:08,870 --> 00:15:13,060
...لذلك إن تركتني أنت أيضًا، فربّما

194
00:15:13,060 --> 00:15:16,940
!لن أفعل ذلك! لن أتركك وحدك يا أمّي

195
00:15:20,150 --> 00:15:24,040
.شكرًا لك. إنّك فتاة طيّبة يا كوكو

196
00:15:42,310 --> 00:15:43,590
.تصبحين على خير

197
00:15:43,870 --> 00:15:45,360
.وأنت على خير

198
00:15:45,360 --> 00:15:46,710
.لحظة يا كوكو

199
00:15:49,680 --> 00:15:52,220
.لا تهتمّي. تصبحين على خير

200
00:15:52,910 --> 00:15:54,220
.وأنت أيضًا

201
00:16:02,730 --> 00:16:05,990
كنتُ أخشى أن تقولي أنّك تريدين
.الذّهاب مع ذلك السّاحر

202
00:16:23,550 --> 00:16:26,460
رُسِمت أنماطٌ في كلّ صفحات
.كتاب الصّور السّحريّ

203
00:16:27,000 --> 00:16:30,290
.لم تكن العصا هديّة إضافيّة مع الكتاب

204
00:16:31,180 --> 00:16:34,150
!إنّ القلم بحدّ ذاته كان العصا السّحريّة

205
00:16:47,850 --> 00:16:51,600
.آسفة يا أمّي... لن أذهب إلى أيّ مكان

206
00:16:52,160 --> 00:16:53,220
.دعيني أجرّب هذا فحسب

207
00:17:43,000 --> 00:17:43,980
ماذا؟

208
00:17:46,580 --> 00:17:49,210
.كلاّ، لم يحدث أيّ شيء

209
00:17:49,210 --> 00:17:52,470
.هذا طبيعيّ، لن يكون الأمر بهذه السّهولة

210
00:18:18,860 --> 00:18:21,540
!لقد لمع! استعملتُ السّحر بالفعل

211
00:18:21,540 --> 00:18:24,220
!هذا رائع، إنّه سحر! استعملتُ السّحر
!السّحر حقيقيّ

212
00:18:24,220 --> 00:18:26,010
!نجح الأمر! ما العمل؟! ما العمل؟

213
00:18:26,870 --> 00:18:28,700
.إنّ السّحر شيء يُرسم إذًا

214
00:18:28,700 --> 00:18:31,590
.لكن لم يكن يفترض بي رؤيته
هل سيغضب إن عرف ذلك؟

215
00:18:31,590 --> 00:18:32,750
...كلاّ

216
00:18:36,600 --> 00:18:39,710
.لكنّي سأرسم نمطًا آخر
...واحد آخر فحسب

217
00:18:53,410 --> 00:18:56,280
كتاب صور... كتاب صور؟

218
00:18:57,870 --> 00:19:00,150
.إنّ ذلك يزعجني بالفعل

219
00:19:02,990 --> 00:19:04,110
!أهذا معقول؟

220
00:19:06,190 --> 00:19:08,140
!مذهل! كانت هذه تعويذة نار

221
00:19:08,140 --> 00:19:10,020
!لا، لا تحترقي أكثر

222
00:19:11,580 --> 00:19:13,550
.كان ذلك وشيكًا

223
00:19:14,800 --> 00:19:15,800
...لكن

224
00:19:17,550 --> 00:19:19,820
.أعتقد أنّي بدأت أفهم شيئًا فشيئًا

225
00:19:20,310 --> 00:19:23,560
.الرّسوم الكبير أقوى من الصّغيرة

226
00:19:23,560 --> 00:19:26,890
وتدوم الّتي تُرسم بشكل جيّد أكثر
.من الرّسومات السّيّئة

227
00:19:27,620 --> 00:19:30,720
.لكنّ رسمها بشكل جيّد وأكبر صعب جدًّا

228
00:19:31,020 --> 00:19:33,400
.جعل ذلك الرّجلُ الأمرَ يبدو سهلاً للغاية

229
00:19:34,110 --> 00:19:35,070
!وجدتُها

230
00:19:40,120 --> 00:19:41,750
...كما توقّعت

231
00:19:41,750 --> 00:19:45,580
بإمكاني رسمها بشكل جيّد
.إن تتبّعتُ النّموذج على الكتاب

232
00:19:54,940 --> 00:19:56,180
!نجحت

233
00:20:16,910 --> 00:20:18,110
رسمتِ سحرًا، صحيح؟

234
00:20:18,110 --> 00:20:21,240
!ما الّذي رسمته؟
!أيّ نوع من التّعاويذ رسمتِ؟

235
00:20:21,240 --> 00:20:24,740
لا أدري. تتبّعتُ النّموذج
.الّذي كان في كتاب الصّور فحسب

236
00:20:24,740 --> 00:20:25,800
كوكو؟

237
00:20:28,610 --> 00:20:29,670
!أمّي

238
00:20:33,970 --> 00:20:35,110
!كوكو؟

239
00:20:35,670 --> 00:20:36,590
!اهربي

240
00:20:42,800 --> 00:20:44,850
...أمّي... كلاّ

241
00:20:45,470 --> 00:20:49,140
!أمّي! أمّي! أمّي

242
00:20:49,140 --> 00:20:50,530
!أمّي

243
00:20:49,140 --> 00:20:50,900
!هذا... سحر محظور

244
00:20:50,900 --> 00:20:52,230
!كلاّ، اتركني

245
00:20:52,230 --> 00:20:54,510
!اتركني! اتركني

246
00:20:52,230 --> 00:20:54,510
!لا! ستعلقين في ذلك أيضًا

247
00:20:54,510 --> 00:20:56,080
!عليّ إنقاذ أمّي

248
00:20:56,080 --> 00:20:57,650
!لا فائدة! إنّها تعويذة

249
00:20:57,650 --> 00:20:58,980
—وتعويذة شرّيرة أيضًا

250
00:20:58,980 --> 00:21:00,120
!كلاّ

251
00:21:05,350 --> 00:21:06,080
!كوكو

252
00:21:06,080 --> 00:21:07,560
!أمّي

253
00:21:09,210 --> 00:21:10,940
!لا

254
00:21:15,680 --> 00:21:19,220
...أنا آسفة... لم أكن أعرف

255
00:21:19,670 --> 00:21:21,670
.بالطّبع لم تعرفي

256
00:21:22,160 --> 00:21:24,720
.اِحْتُفظ بذلك سرًّا حتّى لا يحدث أمر كهذا

257
00:21:25,540 --> 00:21:29,130
...حبر خاصّ ومجموعة دوائر سحريّة

258
00:21:29,130 --> 00:21:31,970
.هو كلّ ما يحتاجه المرء لاستعمال السّحر

259
00:21:31,970 --> 00:21:34,730
.هذا السّرّ هو القاعدة الأعظم لدى سّحرة

260
00:21:35,520 --> 00:21:39,240
،وبعد أن اكتشفتِ الأمر الآن
.عليّ مسح ذاكرتك

261
00:21:43,040 --> 00:21:44,450
!لا تفعل رجاءً

262
00:21:44,450 --> 00:21:48,120
!إن نسيتُ كلّ شيء، فمن سينقذ أمّي؟

263
00:21:48,760 --> 00:21:50,620
.هذا مؤسف للغاية

264
00:21:51,260 --> 00:21:53,250
،لا أذكر أيّ نوع من السّحر رسمت

265
00:21:53,250 --> 00:21:56,160
لكنّي حفظتُ ما الّذي كُتب
!في كتاب الصّور عن ظهر قلب

266
00:21:56,160 --> 00:21:58,680
...وإن نسيتُ ذلك، فإنّ أمّي

267
00:21:59,940 --> 00:22:01,130
كتاب الصّور؟

268
00:22:01,670 --> 00:22:03,030
.هذا صحيح

269
00:22:03,030 --> 00:22:06,930
،إن كان كتاب الصّور ذلك يخصّهم
!فلن أستطيع تتبّعهم

270
00:22:07,650 --> 00:22:11,090
،إن محوت ذاكرة هذه الفتاة
!فلن تكون لي أيّ طريقة لتتبّعهم

271
00:22:11,980 --> 00:22:14,380
حفظتِ الكتاب عن ظهر قلب، صحيح؟

272
00:22:15,550 --> 00:22:17,590
والصّفحة الّتي نسختِها؟

273
00:22:20,980 --> 00:22:24,220
،إن استطعنا إيجاد نفس الكتاب
.سنجد الدّائرة السّحريّة الّتي رسمت

274
00:22:26,950 --> 00:22:31,370
أيمكننا إنقاذ أمّي إن عرفنا
أيّ دائرة سحريّة كانت؟

275
00:22:33,960 --> 00:22:35,260
...ما زالت هنالك

276
00:22:35,760 --> 00:22:37,060
.فرصة لإنقاذها

277
00:22:37,570 --> 00:22:38,800
!سيّد كيفري

278
00:22:39,740 --> 00:22:45,360
!لا تمسح ذاكرتي رجاءً
!سأفعل أيّ شيء لإنقاذ أمّي

279
00:22:47,300 --> 00:22:49,180
أيمكنك الاحتفاظ بالسّرّ؟

280
00:22:49,180 --> 00:22:50,460
!بالطّبع

281
00:22:52,040 --> 00:22:53,850
ألديك العزيمة لتتعلّمي؟

282
00:22:53,850 --> 00:22:55,870
لأتعلّم... ماذا؟

283
00:22:56,330 --> 00:22:59,100
.بمجرّد معرفتك للحقيقة، لا يمكن محوها

284
00:22:59,100 --> 00:23:02,860
في تلك الحالة، عليك أن تصيري
.أحد حاملي السّرّ

285
00:23:03,440 --> 00:23:06,750
هذه هي الطّريقة الوحيدة
.للإبقاء على ذاكرتك

286
00:23:08,160 --> 00:23:09,350
.كوكو

287
00:23:09,350 --> 00:23:10,880
،من الآن فصاعدًا

288
00:23:12,500 --> 00:23:14,510
.ستصيرين ساحرة

289
00:23:35,390 --> 00:23:39,980
الحلقة 2

290
00:23:35,390 --> 00:23:39,980
مدرسة السّهول