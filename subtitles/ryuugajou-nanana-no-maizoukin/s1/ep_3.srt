1
00:00:07,350 --> 00:00:11,070
أكان هذا كنز مجموعة نانانا الموجود في تلك الغرفة؟

2
00:00:22,420 --> 00:00:25,070
كلّ ما فعلهُ هو إضافة الماء لصنع الشّاي

3
00:00:25,490 --> 00:00:27,920
لهذا اسمه "الإبريق الذي لا يحتاج إلى أوراق"؟

4
00:00:29,000 --> 00:00:32,520
"اسمهُ الرّسميّ هو " شيان تشا في

5
00:00:33,450 --> 00:00:37,010
شربُ هذا الشّاي امتيازٌ خاصّ لنادي المغامرة

6
00:00:38,120 --> 00:00:42,350
أودُّ أن أرحّب بكم رسميّاً كأعضاء جدد في نادي المغامرة

7
00:00:42,790 --> 00:00:45,840
أنا سعيدٌ جدّاً لانضمام ثلاثة أعضاء ذي قدرة عالية لنا

8
00:00:46,390 --> 00:00:47,970
هل لي أن أسأل سؤالاً؟

9
00:00:47,970 --> 00:00:48,740
تفضّلي

10
00:00:49,270 --> 00:00:52,530
ماذا يفعل هذا النّادي بالضّبط على أيّ حال؟

11
00:00:56,920 --> 00:00:58,530
...لم يشترِ أي شيء منها

12
00:00:58,530 --> 00:01:01,160
...فهمت، مجموعة نانانا

13
00:01:01,630 --> 00:01:06,550
مضى عشر سنوات على
موت ريوغاجو نانانا يا يويغا-دونو

14
00:01:07,100 --> 00:01:10,960
لكنَّني أعتقد أنّ المدرسة الثّانويّة الثّالثة اكتمل بناؤها منذ ستّ سنوات

15
00:01:11,490 --> 00:01:12,760
هذا صحيح

16
00:01:13,130 --> 00:01:16,850
إذاً، من أخفى كنز مجموعة نانانا في المدرسة؟

17
00:01:16,850 --> 00:01:20,260
لم أتوقّع أن تسأليني هذا بهذه السُّرعة

18
00:01:20,260 --> 00:01:22,100
أنتِ مُحقّقة بارعة بالفعل

19
00:01:23,440 --> 00:01:25,310
لا تقُم بمدحي كثيراً

20
00:01:26,880 --> 00:01:29,270
ولكنَّني لا أعرف جواباً لهذا

21
00:01:30,660 --> 00:01:33,410
الشّخص الّذي أخفى كنوز مجموعة نانانا

22
00:01:33,410 --> 00:01:35,740
يُدعى ليبراكون

23
00:01:36,340 --> 00:01:40,450
"تُدعى الأماكن المُخبّأة بها الكنوز "الأطلال

24
00:01:40,450 --> 00:01:44,200
وحتّى الآن يستمرُّ ظهورها طوال الوقت على جزيرة ناناي

25
00:01:45,990 --> 00:01:48,270
بالمُناسبة، أنا آسفٌ لطلبِ هذا منكَ فور انضمامك لنا

26
00:01:48,270 --> 00:01:50,080
ولكن أودّ أن تسدي لي معروفاً يا ياما-كن

27
00:01:50,510 --> 00:01:51,790
ما هو؟

28
00:01:53,130 --> 00:01:57,010
إنه شيء لا يستطيع غيرك فعله كونك تسكن في الغرفة 202

29
00:03:29,290 --> 00:03:30,990
...جوغو

30
00:03:42,360 --> 00:03:44,550
أنتَ عديم الفائدة حقّاً

31
00:03:44,550 --> 00:03:47,280
كيف تجرؤ على إطعامي بودينغ رخيصة
سعر ثلاثة منها 98 ين؟

32
00:03:47,280 --> 00:03:49,650
إن كنت رجلاً، فأقلّ شيء يمكنك فِعله

33
00:03:49,650 --> 00:03:53,070
هو شراء بودينغ راندويا الخفيفة كلّ يوم لحبيبتك

34
00:03:53,070 --> 00:03:55,870
أيُّها الفاشل عديم الجدوى

35
00:04:01,520 --> 00:04:04,610
"والآن، بما أنّك أكملتَ اختبار "الأحباء المزيفين

36
00:04:04,610 --> 00:04:08,360
سأعطيكَ تلميحاً لإيجاد الأطلال كما وعدتك

37
00:04:15,340 --> 00:04:17,860
في برجٍ يرتفع عالياً في السّماء

38
00:04:19,110 --> 00:04:21,860
موجود داخل صندوق زجاجي

39
00:04:32,260 --> 00:04:33,500
لنفعل هذا مُجدّداً في وقت ما

40
00:04:33,710 --> 00:04:35,650
سنمثّل شيئاً مختلفاً في المرّة القادمة

41
00:04:43,220 --> 00:04:44,880
أدَفعتكَ للقيام باختبار كهذا؟

42
00:04:45,380 --> 00:04:48,450
جعلت كونجو-سينباي تقوم بمُختلف الأشياء أيضاً

43
00:04:48,450 --> 00:04:53,020
ولكن لمَ لا تُخبرني نانانا-تشان بمكان الأطلال فحسب؟

44
00:04:53,470 --> 00:04:57,260
لدى نانانا-سان طريقة تفكير فريدة من نوعها

45
00:04:57,260 --> 00:04:58,980
بإمكانك أن تقول أنَ لها مجموعة قوانين خاصّة بها

46
00:04:59,520 --> 00:05:02,440
"يُمكنك أن تدعوها "قوانين نانانا

47
00:05:02,920 --> 00:05:06,070
عندما يتعلّق الأمر بالبحث عن مجموعة نانانا

48
00:05:06,070 --> 00:05:08,910
فإنّ نانانا-سان تبقى في موقف محايد طوال الوقت

49
00:05:08,910 --> 00:05:10,410
موقف محايد؟

50
00:05:10,660 --> 00:05:14,950
أجل، إنّها لا تُخبر أحداً عن مكان الأطلال

51
00:05:14,950 --> 00:05:17,370
أو عن كيفيّة حلّ الألغاز الموجودة ضمنها

52
00:05:17,900 --> 00:05:21,340
ولكنّها تزوّد بالمعلومات الكافية

53
00:05:21,720 --> 00:05:25,550
إن أحضرتَ لها كنزاً وجدته فستخبرك عنه

54
00:05:26,230 --> 00:05:27,680
فهمت

55
00:05:27,680 --> 00:05:29,910
لهذا السّبب هي مُحايدة نحوي أيضاً

56
00:05:29,910 --> 00:05:33,020
...مع أني أحاول مساعدتها في إيجاد قاتلها

57
00:05:33,490 --> 00:05:35,870
كان الأمر مُشابهاً لكونجو-سينباي

58
00:05:36,990 --> 00:05:39,800
إذاً، فقوانين نانانا غير قابلة للخرق على الإطلاق

59
00:05:49,450 --> 00:05:50,670
حسناً، إنَّنا نعتمدُ عليكِ

60
00:05:50,670 --> 00:05:51,800
وأنت أيضًا

61
00:05:53,970 --> 00:05:55,870
من هي كونجو-سان؟

62
00:05:56,260 --> 00:05:57,820
إنَّها فتاة أكبر منّي بعامين

63
00:05:57,820 --> 00:05:59,500
بالرّغم من كلّ شيء، كانت مُبتهجة جدّاً

64
00:06:00,150 --> 00:06:02,460
كانت تتمتّع بالشّجاعة وتستطيع اتّخاذ القرارات

65
00:06:02,850 --> 00:06:04,940
كانت بمثابة أخت كبرى

66
00:06:06,950 --> 00:06:08,770
كانت ذكيّةً أيضاً

67
00:06:08,770 --> 00:06:12,480
أنقذتنا سرعة بديهتها من عِدّة مواقف صعبة

68
00:06:14,040 --> 00:06:14,960
تلقّيت رسالة

69
00:06:14,960 --> 00:06:17,100
تينساي
وجدنا مدخلاً للأطلال في الطّابق 164

70
00:06:17,470 --> 00:06:18,560
كان هذا سريعًا

71
00:06:21,020 --> 00:06:21,980
متجر فارغ للبيع
من يأتي أولاً، يأخذه

72
00:06:22,230 --> 00:06:24,940
إنّه مجرّد بابٍ عاديّ
لمَ سيكونُ هنا؟

73
00:06:25,430 --> 00:06:27,440
أليسَ من الممكن أن يكون مجرّد متجر فارغ؟

74
00:06:27,980 --> 00:06:30,270
مثل هذه الأبواب في الطّوابق الأخرى

75
00:06:30,270 --> 00:06:32,960
تتطلّب رموز مرور وبطاقات إلكترونية

76
00:06:32,960 --> 00:06:36,700
ولكن هذا الباب لديه قفل رمز مرور فقط

77
00:06:37,270 --> 00:06:40,670
اذهبوا إلى الغرفة المقابلة لها وسترَون

78
00:06:46,160 --> 00:06:47,740
هل رأيتم؟

79
00:06:47,740 --> 00:06:48,760
ماذا سنرى؟

80
00:06:48,760 --> 00:06:52,470
إنّنا ننظر إلى مبنى سداسيّ، ولكن يوجد زاوية هناك

81
00:06:52,470 --> 00:06:54,600
والغرفة المعروضة في الإعلان ليست شاغرة

82
00:06:55,250 --> 00:06:58,560
بالإضافة إلى أنّ جميع الغرف تبدو معكوسة أفقيا

83
00:07:00,580 --> 00:07:01,980
من الصّعب ملاحظة هذا

84
00:07:02,250 --> 00:07:03,920
إنّها خدعة مرآة

85
00:07:03,920 --> 00:07:06,940
أين ستكونُ غرفة الأطلال إذاً؟

86
00:07:13,500 --> 00:07:14,830
لا يوجد هناك مدخل

87
00:07:15,280 --> 00:07:16,950
يبدو أنّنا أصبنا الهدف

88
00:07:17,240 --> 00:07:19,140
عملٌ جيّد يا تينساي-كن

89
00:07:21,720 --> 00:07:24,420
نحنُ نعلمُ إذاً أنَّ هذا الباب يقودُ إلى الأطلال

90
00:07:24,950 --> 00:07:27,880
ولكن لسوء الحظ
لا نملك رمز المرور

91
00:07:28,840 --> 00:07:30,250
سِتّ خانات؟

92
00:07:36,800 --> 00:07:39,620
حال اكتشافنا لوجود الأطلال في المبنى المرتفع

93
00:07:39,620 --> 00:07:41,520
قمتُ ببعض الأبحاث مُسبقاً

94
00:07:42,370 --> 00:07:46,630
الحادي عشر من أكتوبر هو يوم ميلاد
موتسومي كوما مهندس هذا المبنى

95
00:07:47,030 --> 00:07:51,530
إذاً، سِتّة من "موتسو" في موتسومي كوما
ثمّ نجمة و1011؟

96
00:07:51,780 --> 00:07:54,280
ما الّذي جعلكَ تعتقد أنّ هذه الأرقام ستكون كلمة المرور؟

97
00:07:54,710 --> 00:07:57,250
تفكّر نانانا-سان دائماً بأصدقائها

98
00:07:57,250 --> 00:08:00,620
اعتقدتُ أنّها ستضع هذا كرمز مرور لمبنى

99
00:08:00,620 --> 00:08:02,510
كان مهمّاً جداً بالنسبة له

100
00:08:02,870 --> 00:08:04,630
أنت رائع يا إيشين-ساما

101
00:08:05,550 --> 00:08:08,960
والآن، أعتقد أنّه يجب علينا اختيار الأعضاء الّذين سيدخلون من هنا

102
00:08:09,660 --> 00:08:11,220
اختيار الأعضاء؟

103
00:08:11,600 --> 00:08:14,300
ليس من الأفضل الدخول بأعداد كبيرة

104
00:08:14,720 --> 00:08:18,260
على عكس غرفة الاختبار
لم يسبق أن رأيت هذه الأطلال من قبل

105
00:08:20,340 --> 00:08:21,930
سنعرّض حياتنا للخطر

106
00:08:24,900 --> 00:08:29,020
سيشملني الفريق أنا وياما-كن وتينساي-كن

107
00:08:29,020 --> 00:08:29,730
أتوافقون؟

108
00:08:31,990 --> 00:08:34,040
انتظري هنا برفقة داروكو-كن يا يو

109
00:08:34,040 --> 00:08:36,650
و كوني على استعداد في حال حصول شيءٍ لنا

110
00:08:37,270 --> 00:08:38,160
كونوا حذرين

111
00:08:39,630 --> 00:08:41,630
كوني حذرةً يا تينساي

112
00:08:41,630 --> 00:08:43,040
إنّه يقول أنّنا سنعرّض حياتنا للخطر

113
00:08:43,650 --> 00:08:45,460
أجل، سيكون الأمر على ما يرام

114
00:08:45,460 --> 00:08:47,280
سنتغلّب على هذا بدون مشاكل

115
00:08:48,440 --> 00:08:49,590
أنتِ مُحقّة

116
00:08:50,780 --> 00:08:52,720
هلّا نذهب إذاً؟

117
00:09:49,350 --> 00:09:50,470
شيءٌ ما هناك

118
00:09:53,370 --> 00:09:54,300
تينساي

119
00:10:18,820 --> 00:10:21,250
ما كان كلّ هذا؟

120
00:10:26,760 --> 00:10:28,480
لقد عادَ الممرّ

121
00:10:29,130 --> 00:10:30,570
إنّهُ طريّ

122
00:10:31,360 --> 00:10:32,400
ماذا علينا أن نفعل؟

123
00:10:33,450 --> 00:10:34,940
لنجرّب هذا الطّريق

124
00:10:56,400 --> 00:10:58,670
هذا سيِّئ، هذا سيِّئ، هذا سيِّئ

125
00:10:58,670 --> 00:11:00,090
سوف تموت تينساي

126
00:11:10,230 --> 00:11:11,010
جوغو

127
00:11:11,720 --> 00:11:12,560
ما الأمر؟

128
00:11:13,190 --> 00:11:15,320
شكراً لإنقاذك لي

129
00:11:18,620 --> 00:11:21,660
لا داعي لذلك، أنتِ مدينةٌ لي

130
00:11:22,210 --> 00:11:24,160
أجل، أنا مدينةٌ لك

131
00:11:26,830 --> 00:11:29,580
فهمت، هذا هو النّظام إذاً

132
00:11:31,090 --> 00:11:32,830
حان دورك يا جوغو

133
00:11:43,680 --> 00:11:44,630
تبّاً

134
00:11:44,630 --> 00:11:47,340
ستندمين على هذا إن مِتُّ يا تينساي

135
00:11:59,750 --> 00:12:02,450
يتحرّك هذا العنكبوت في مجموعة أنماط

136
00:12:02,450 --> 00:12:04,570
ينهارُ الممرّ في نقطتين في وقتٍ واحد

137
00:12:04,890 --> 00:12:08,250
ويتمُّ إصلاح واحد منهما فقط في وقتٍ واحد

138
00:12:08,720 --> 00:12:10,750
وإن كان به إنسان، فلن يتمّ إصلاحه

139
00:12:13,310 --> 00:12:16,880
ويستغرق الممرّ خمس دقائق تقريباً لكي يتصلّب بعد إصلاحه

140
00:12:17,280 --> 00:12:19,130
حتّى ذاك الحين، لن ينهار هذا الممرّ

141
00:12:19,520 --> 00:12:22,040
بعبارة أخرى، علينا فقط اتّباع

142
00:12:22,040 --> 00:12:23,750
مسار من الممرّات التي تشكّلَتْ حديثاً

143
00:12:28,590 --> 00:12:31,330
سيُكمل عمّا قريب الطّريق الّذي رسمتهُ هنا

144
00:12:31,330 --> 00:12:33,740
حالما يُكمل هذا الطّريق يا يويغا-دونو

145
00:12:33,740 --> 00:12:35,860
سوف تركض إلى صندوق الكنز

146
00:12:35,860 --> 00:12:36,730
فهمت

147
00:12:36,730 --> 00:12:38,360
اذهب إلى اليسار يا جوغو

148
00:12:44,070 --> 00:12:45,110
بقيت نقطة واحدة

149
00:12:45,110 --> 00:12:46,570
إلى اليسار يا جوغو

150
00:12:50,310 --> 00:12:52,010
الآن يا يويغا-دونو

151
00:13:29,080 --> 00:13:32,560
لم تكن ندّاً للمُحقّقة البارعة

152
00:13:50,800 --> 00:13:53,100
...هل يُعقل أن يكون هذا

153
00:13:58,530 --> 00:13:59,730
أيّها الرئيس يويغا

154
00:14:00,660 --> 00:14:02,940
قِفا مكانكما

155
00:14:15,050 --> 00:14:17,040
ما الّذي يحصل؟

156
00:14:17,320 --> 00:14:20,050
لطالما أردتُ الحصول على هذه العصا

157
00:14:27,510 --> 00:14:29,670
خُذيني إلى المخرج

158
00:14:37,750 --> 00:14:40,100
حسناً، وداعاً لكليكما

159
00:14:40,740 --> 00:14:41,960
لا يعقل أن تكون جادّاً

160
00:14:43,600 --> 00:14:44,780
إنّهُ جاد

161
00:14:52,190 --> 00:14:53,620
هل أنتم بخير؟

162
00:14:59,200 --> 00:15:01,280
أين هما الآخران؟

163
00:15:02,180 --> 00:15:05,300
تركتهما في الدّاخل

164
00:15:05,300 --> 00:15:07,050
ولكن لماذا؟

165
00:15:08,510 --> 00:15:11,470
خذي قيلولة يا داروكو-كن

166
00:15:19,910 --> 00:15:21,780
ماذا سنفعل بها؟

167
00:15:21,780 --> 00:15:25,010
اتركيها هنا، فلن تستطيع فعل شيء

168
00:15:22,950 --> 00:15:25,640
كلا يا تينساي

169
00:15:25,010 --> 00:15:27,930
والأهمّ من هذا، اتّصلي بإيكاكو شونجو

170
00:15:26,470 --> 00:15:28,360
قلتُ لكِ توقّفي

171
00:15:27,930 --> 00:15:29,950
أخبريها أنّنا حصلنا على واحدة من مجموعة نانانا

172
00:15:30,390 --> 00:15:31,320
مفهوم

173
00:15:34,580 --> 00:15:36,250
هل أنت هنا يا كاغيتورا؟

174
00:15:36,250 --> 00:15:37,290
أجل

175
00:15:37,830 --> 00:15:40,750
لقد انهارت الأطلال وسقطت

176
00:15:41,260 --> 00:15:43,330
كيف تجري الأمور في الطّوابق السفليّة؟

177
00:15:43,640 --> 00:15:46,800
حقّاً؟ لم يتغيّر شيءٌ هنا

178
00:15:47,150 --> 00:15:50,150
فهمت، أنا سعيدٌ أنّهُ لم يُصب أحد بأذى

179
00:15:50,590 --> 00:15:52,660
هل أنتَ مُتأكّدٌ حيالَ هذا يا إيشين؟

180
00:15:53,220 --> 00:15:54,580
حول ماذا؟

181
00:15:54,580 --> 00:15:56,260
حول ذلكما الاثنين

182
00:15:57,580 --> 00:15:59,030
سيكونان على ما يُرام

183
00:15:59,030 --> 00:16:02,890
إنّهما أذكى وأمهرُ منّي بكثير

184
00:16:03,400 --> 00:16:05,600
سيستطيعان الخروج بأنفسهما

185
00:16:07,680 --> 00:16:10,690
أنا لا أفهمُ هذا
هذا ليسَ منطقيّاً

186
00:16:15,200 --> 00:16:17,590
إنّ الأطلال مذهلةٌ بالفعل

187
00:16:17,590 --> 00:16:19,980
لا يستطيعُ أحد أن يرانا

188
00:16:19,980 --> 00:16:23,560
يُحاطُ صندوق الكنز بسطوحٍ كالمرايا

189
00:16:25,930 --> 00:16:26,900
ما الّذي تفعله؟

190
00:16:26,900 --> 00:16:30,880
اتّصلتُ بالشُّرطة
لذا يجب أن يصلوا عمّا قريب

191
00:16:30,880 --> 00:16:32,510
علينا أن نُمضي الوقت إلى ذلك الحين

192
00:16:32,990 --> 00:16:36,110
أنفاسك تُدغدغني يا جوغو

193
00:16:36,110 --> 00:16:37,640
ابتعد عنّي قليلاً

194
00:16:38,480 --> 00:16:39,720
حذارِ

195
00:16:41,400 --> 00:16:42,270
ما الأمر؟

196
00:16:43,560 --> 00:16:45,730
لا يُعجبني هذا الشّعور

197
00:16:47,620 --> 00:16:48,500
مهلاً

198
00:16:51,500 --> 00:16:53,870
ما الّذي تُحاولينَ فعله؟

199
00:16:55,220 --> 00:16:57,780
هل هذا ما يدعونَهُ تأثير الجسر المُعلّق؟

200
00:16:58,630 --> 00:17:01,260
أوشكتُ أن أقع في حبّكَ بشكلٍ خطير

201
00:17:03,120 --> 00:17:05,080
لماذا قلبكِ ينبضُ بهذه السُّرعة؟

202
00:17:05,260 --> 00:17:09,310
اصمت
فأنا لم أعانق رجلاً من قبل

203
00:17:09,670 --> 00:17:11,580
وماذا عنك؟

204
00:17:11,580 --> 00:17:13,050
ماذا عنّي؟

205
00:17:14,210 --> 00:17:17,560
أنا أسألكَ إن كُنتَ لا تشعر بشيء عندما

206
00:17:17,560 --> 00:17:19,930
يكونُ شخصٌ من الجنس الآخر بين ذراعيك

207
00:17:24,250 --> 00:17:26,290
هل قلبكَ ينبض بسرعة الآن أيضاً؟

208
00:17:28,520 --> 00:17:30,720
أنا فقط

209
00:17:31,430 --> 00:17:34,110
لديّ ارتفاع في ضغط الدمّ

210
00:17:34,360 --> 00:17:36,570
إذاً، أنا لديّ ارتفاع في ضغط الدمّ أيضاً

211
00:17:41,940 --> 00:17:45,540
بالمُناسبة، لمَ أنتِ مُحقّقة؟

212
00:17:45,990 --> 00:17:47,930
لأحفر اسمي في التّاريخ

213
00:17:48,330 --> 00:17:50,630
هذا ليسَ شيئاً تُخبرين به النّاس

214
00:17:50,630 --> 00:17:51,550
لماذا؟

215
00:17:51,980 --> 00:17:55,550
عندما قُلتِ هذا في الصفّ
ضحك الجميع عليكِ

216
00:17:55,700 --> 00:17:58,510
لا أحبّ أن أكون مدعاة سُخرية
ولكنَّني لن أتوقّف عن قول ذلك

217
00:17:59,260 --> 00:18:02,970
لأنني لن أحب عدم مقدرتي لقول ذلك

218
00:18:03,520 --> 00:18:06,960
أعلمُ ماذا يعتقد النّاس بي

219
00:18:08,180 --> 00:18:11,650
لكنَّني مازلتُ أرغب بأن أكون محقّقة بارعة

220
00:18:12,870 --> 00:18:15,360
أنتِ حمقاء بالفعل

221
00:18:27,230 --> 00:18:30,050
لمَ مُساعدتي الّتي لا جدوى لها

222
00:18:30,050 --> 00:18:32,580
نائمة دون أدنى اهتمام؟

223
00:18:35,360 --> 00:18:36,800
هذا يؤلم

224
00:18:37,780 --> 00:18:40,550
صباح الخير يا داروكو
إنّها طريقةٌ جيّدة للاستيقاظ

225
00:18:41,620 --> 00:18:43,340
تينساي

226
00:18:45,330 --> 00:18:48,250
والآن، أخبرونا ما الّذي حصلَ بالتّفصيل

227
00:18:53,830 --> 00:18:56,880
أنتَ لا تنوي أن تدعهُ يُفلت جرّاء ما فعلهُ لنا صحيح؟

228
00:18:56,880 --> 00:18:58,330
بالطبع

229
00:18:58,330 --> 00:19:01,200
لن أشعر بالرّاحة إلى أن أضرب رئيس النّادي ذاك

230
00:19:01,200 --> 00:19:02,770
وأنا أشعر بالمثل

231
00:19:02,770 --> 00:19:06,230
لن أشعر بالرّضى إلى أن ألقّنه درساً

232
00:19:06,230 --> 00:19:07,780
ماذا نفعل إذاً؟

233
00:19:07,780 --> 00:19:09,180
دَعني أذهب

234
00:19:09,180 --> 00:19:11,330
أعتقد أنَّني أعرف إلى أينَ ذهبَ يويغا-دونو

235
00:19:11,890 --> 00:19:14,290
حسناً، اتركي البقيّة لي

236
00:19:15,580 --> 00:19:20,040
المعذرة أيّها الشرطيّان
هلّا سمحتما لهاتين الاثنتين بالذّهاب؟

237
00:19:20,040 --> 00:19:22,050
سأخبركما ماذا حصل بنفسي

238
00:19:25,000 --> 00:19:26,020
حسناً

239
00:19:27,450 --> 00:19:28,720
لنذهب إذاً

240
00:19:39,410 --> 00:19:43,450
والآن، لمَ لا تُخبرني كلّ شيء

241
00:19:43,450 --> 00:19:46,450
تعرفه عن مجموعة نانانا؟

242
00:19:51,740 --> 00:19:53,920
لقد عدت

243
00:20:01,660 --> 00:20:03,390
لمَ تبدو هكذا؟

244
00:20:03,750 --> 00:20:05,760
...حسناً، في الواقع

245
00:20:08,630 --> 00:20:10,730
حسناً فهمت، ارتدِ ثيابك

246
00:20:12,750 --> 00:20:15,310
ماذا كانت تلكَ العصا يا نانانا-تشان؟

247
00:20:15,590 --> 00:20:17,270
إنَّها عصا السّاحر

248
00:20:17,640 --> 00:20:20,530
"اسمها الرّسميّ هو "عصا دوفولد فان زاموس

249
00:20:20,880 --> 00:20:24,930
إنّها عصا كانت تُستخدم من قِبل ساحر حقيقيّ في العصور الوسطى

250
00:20:24,930 --> 00:20:27,740
ولكن العصا بحدّ ذاتها تحملُ قوى سحريّة عظيمة أيضاً

251
00:20:28,180 --> 00:20:31,680
كيفَ عرف الرّئيس يويغا عنها؟

252
00:20:34,060 --> 00:20:36,180
لا أدري

253
00:20:36,180 --> 00:20:39,880
ربُما كانت إحدى الأمور الّتي ذكرتها عندما تكلّمتُ معهُ من قبل

254
00:20:40,260 --> 00:20:43,260
ماذا؟ هل أنتِ عديمة الاهتمام لهذه الدّرجة يا نانانا-تشان؟

255
00:20:44,040 --> 00:20:45,780
كلا، لستُ كذلك

256
00:20:46,730 --> 00:20:49,260
ما نوع القوّة الّتي تملكهُا العصا؟

257
00:20:51,260 --> 00:20:52,950
تستطيع عصا السّاحر

258
00:20:52,950 --> 00:20:56,520
أن تحقّق أيّ أمنية لحاملها

259
00:20:58,440 --> 00:21:01,440
ماذا؟ لا بُدّ أنّها لا تُقهر إذاً

260
00:21:02,190 --> 00:21:04,410
في الواقع، إنَّها ليست كذلك

261
00:21:04,730 --> 00:21:06,570
ليست كذلك؟

262
00:21:08,780 --> 00:21:09,400
لديك رسالة واردة

263
00:21:09,400 --> 00:21:14,900
تينساي
سيعقد الرّئيس يويغا صفقة مع رئيس العُظماء السّبعة إيكاكو شونجو

264
00:22:52,170 --> 00:22:54,340
لقد كنتُ بانتظارك يا جوغو