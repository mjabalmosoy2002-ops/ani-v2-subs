1
00:00:14,430 --> 00:00:16,160
هل أنتِ راحلة حقّاً؟

2
00:00:16,490 --> 00:00:17,370
أجل

3
00:00:17,920 --> 00:00:21,290
ولكنّك قلتِ أنّك ستُساعديني بإيجاد قاتلي؟

4
00:00:21,910 --> 00:00:25,300
أعتذر... ولكنَّني لا أستطيع فعل ذلك

5
00:00:25,830 --> 00:00:27,750
هذه المهمّة كبيرة بالنّسبة إليّ

6
00:00:28,300 --> 00:00:29,400
...لأنَّني

7
00:00:29,400 --> 00:00:33,910
أتخافين أن تُقتلي إن وجدتِ قاتلي أيضاً؟

8
00:00:35,510 --> 00:00:39,220
هذا ما أظهرتهُ لي المرآة الكاشفة للمستقبل

9
00:00:40,860 --> 00:00:44,100
ولكن لا تقلقي، فأنا لم أستطع أن أفعل ذلك

10
00:00:44,600 --> 00:00:48,870
ولكنَّني متأكّدة أنَّ الشّخص التّالي الّذي سينتقل إلى هنا سيحقّق أمنيتك

11
00:02:29,890 --> 00:02:32,030
لقد كنتُ بانتظارك يا جوغو

12
00:02:34,230 --> 00:02:37,920
هل سيعقد ذاكما الاثنان صفقة مع إيكاكو شونجو؟

13
00:02:38,200 --> 00:02:41,610
أجل، يبدو أنّه يخطِّط لبيع العصا مقابل مئة مليون ين

14
00:02:42,340 --> 00:02:43,560
مئة مليون؟

15
00:02:45,900 --> 00:02:48,240
وكأنّنا سنسمح لهم بفعل ما يحلو لهم

16
00:02:48,630 --> 00:02:50,170
يا جوغو

17
00:02:50,170 --> 00:02:54,480
هل تعتقد أنَّنا سنستطيع استعادة العصا منهم؟

18
00:02:56,320 --> 00:02:57,500
ما الأمر؟

19
00:03:00,240 --> 00:03:03,450
بدأتُ أشعرُ بالخوف

20
00:03:07,890 --> 00:03:09,890
هلّا عانقتني؟

21
00:03:12,420 --> 00:03:14,100
حسناً، تعالي إلى هنا

22
00:03:23,020 --> 00:03:24,270
من أنت؟

23
00:03:24,270 --> 00:03:26,430
أنت أطول بثلاث سنتيمترات من جوغو

24
00:03:26,840 --> 00:03:30,230
من يُلاحظ اختلافاً بسيطاً كهذا؟

25
00:03:30,230 --> 00:03:32,280
أنا محقّقة بارعة كما ترى

26
00:03:32,280 --> 00:03:34,740
إذاً أعتقد أنّه ليس من المفاجئ أنّكِ اكتشفت أمري

27
00:03:37,010 --> 00:03:39,620
أنتَ الشرطيّ المزيّف الّذي رأيناه سابقاً

28
00:03:39,620 --> 00:03:41,530
حسناً، لا أستطيع أن أخبركِ اسمي

29
00:03:41,530 --> 00:03:44,200
ولكن في العمل
أنا معروف باسم ذو المئة وجه

30
00:03:44,200 --> 00:03:46,140
لفرقة الّلص الشّبح ماتسوري

31
00:03:47,130 --> 00:03:49,120
لا أصدّق أنّهُ كان لصّاً حقيقياً

32
00:03:49,510 --> 00:03:50,370
هل وقعتِ في حبّي الآن؟

33
00:03:50,740 --> 00:03:54,170
أجل، لا بدّ أن أعتقلك

34
00:03:54,170 --> 00:03:54,880
ماذا؟

35
00:03:55,460 --> 00:03:58,380
تمهّلي
فقد اختطفنا جوغو-كُن كما تعلمين

36
00:03:58,380 --> 00:04:00,880
الوداع يا جوغو
أراكَ في الحياة الأخرى

37
00:04:00,880 --> 00:04:03,350
هل ستدعينهُ يموت؟

38
00:04:03,350 --> 00:04:04,480
قِف مكانك

39
00:04:04,480 --> 00:04:06,500
هذا مؤلم

40
00:04:04,480 --> 00:04:06,500
كلّ شيءٍ يسير وفق الخُطّة

41
00:04:06,500 --> 00:04:09,820
الآن علينا فقط أن نسرق الكنز أليس كذلك؟

42
00:04:09,820 --> 00:04:10,620
أجل

43
00:04:11,200 --> 00:04:13,850
ها هي الدّفعة الّتي وعدتكِ بها

44
00:04:19,440 --> 00:04:20,990
إنّها ليست مُزيّفة أليسَ كذلك؟

45
00:04:21,500 --> 00:04:22,980
إنّها حقيقيّة

46
00:04:24,070 --> 00:04:24,950
فهمت

47
00:04:25,610 --> 00:04:27,520
ولكنَّكَ فاجأتني

48
00:04:27,520 --> 00:04:29,910
لم أتوقّعكَ أن تتحالف مع ماتسوري

49
00:04:29,910 --> 00:04:31,600
أنا أعتذر، سامحيني

50
00:04:32,030 --> 00:04:33,950
أنا حقاً آسف

51
00:04:34,490 --> 00:04:38,500
بالمُناسبة، ألا تُريدين مجموعة نانانا؟

52
00:04:39,060 --> 00:04:40,550
ما الّذي تقصده؟

53
00:04:41,450 --> 00:04:43,990
أنا أرغب باستعادة كنز مجموعة نانانا

54
00:04:43,990 --> 00:04:45,520
الّذي كان هنا

55
00:04:45,520 --> 00:04:47,050
أريدُ مساعدتكم

56
00:04:47,400 --> 00:04:50,010
أنا أشعرُ بالامتنان لمُساعدتك يا آنسة يوكيهيمي

57
00:04:50,790 --> 00:04:53,100
هل اخترتنا كشركاءٍ لك

58
00:04:53,100 --> 00:04:55,730
لإبعاد المحقّقة البارعة عن الخطر؟

59
00:04:55,980 --> 00:04:57,280
بالطّبع لا

60
00:04:57,280 --> 00:05:00,980
لم أردها أن تعرف حقيقتي فقط

61
00:05:10,600 --> 00:05:12,520
هلّا تتولّين أمر الفتاة؟

62
00:05:14,950 --> 00:05:17,460
مفهوم، كُن حذراً

63
00:05:29,500 --> 00:05:33,570
لم أكن أعتقد أنّ الأمر سينتهي بقتالي لك

64
00:05:34,770 --> 00:05:37,410
لم أكُن أعتقد أيضاً

65
00:05:37,410 --> 00:05:41,900
أنّكَ ستريدُ بيع كنزٍ من مجموعة نانانا

66
00:05:43,990 --> 00:05:46,300
لن أفعل هذا بالطّبع

67
00:05:46,300 --> 00:05:50,620
أستطيع تحقيق أيّ أمنيةٍ أريدها بهذا

68
00:05:50,970 --> 00:05:54,330
إنّهُ أكثر الكنوز قوّة في مجموعة نانانا

69
00:05:57,020 --> 00:05:59,790
إذاً، ما الّذي تريده بالفعل؟

70
00:06:00,760 --> 00:06:02,450
أن أسيطر على العالم

71
00:06:04,330 --> 00:06:05,360
ماذا؟

72
00:06:05,360 --> 00:06:06,970
أن أسيطر على العالم

73
00:06:07,230 --> 00:06:11,530
طموحي هو حكم هذا العالم

74
00:06:11,950 --> 00:06:14,970
إنّه أحمق
الرّئيس يويغا أحمقٌ بالفعل

75
00:06:14,970 --> 00:06:20,400
الشّيء الأوّل الّذي سأفعله بهذه العصا هو التّلاعب بإيكاكو شونجو

76
00:06:20,400 --> 00:06:22,640
و من ثمّ ستكون هذه الجزيرة لي

77
00:06:22,870 --> 00:06:26,900
حسناً... على أيّ حال سأضطرّ لاستعادة هذا الشّيء

78
00:06:27,190 --> 00:06:31,370
إذاً سأتخلّص منكَ بقِوى هذه العصا

79
00:06:32,200 --> 00:06:33,010
احترق

80
00:06:37,310 --> 00:06:39,290
! إنّهُ سحرٌ حقيقيّ

81
00:06:40,450 --> 00:06:41,250
تجمّد

82
00:06:44,050 --> 00:06:45,090
اطعن

83
00:06:49,040 --> 00:06:51,950
حركاتك السّريعة هذه تُزعجني

84
00:06:52,400 --> 00:06:53,220
والآن

85
00:06:54,260 --> 00:06:57,020
قف بلا حِراك يا ياما جوغو

86
00:06:57,410 --> 00:06:58,970
هذا غِشّ

87
00:06:59,630 --> 00:07:01,090
سيؤلم هذا قليلاً

88
00:07:01,860 --> 00:07:03,190
فلتطِر بعيداً

89
00:07:11,590 --> 00:07:12,770
فلتطِر بعيداً

90
00:07:16,320 --> 00:07:17,690
فهمتُ الآن

91
00:07:17,690 --> 00:07:19,890
تتفاوت القوّة طِبقاً لتخيّلاتي الذهنيّة

92
00:07:19,890 --> 00:07:21,290
ومدى ارتفاع صوتي؟

93
00:07:21,930 --> 00:07:23,770
هذا يؤلم بالفعل

94
00:07:23,770 --> 00:07:27,520
شكراً لك يا ياما-كُن
لقد ساعدتني بالحصول على معلومات ممتازة

95
00:07:27,520 --> 00:07:30,590
توقّف عن هذا

96
00:07:30,590 --> 00:07:33,310
من تعتقد نفسك؟

97
00:07:35,670 --> 00:07:40,110
هذه الجزيرة ممتلئة بالأشخاص المُزعجين

98
00:07:40,110 --> 00:07:43,650
" أريد أن أكون محقّقة بارعة"
" أريد السّيطرة على العالم"

99
00:07:43,650 --> 00:07:45,200
هل أنتم جميعاً أغبياء؟

100
00:07:45,200 --> 00:07:47,150
لا يرغب أحد بسماع هذا الهراء

101
00:07:47,770 --> 00:07:50,140
هذا محرجٌ لدرجة أنّني سأتقيّأ

102
00:07:50,140 --> 00:07:52,890
هذا ليسَ شيئاً تستطيع أن تقوله ليسمعه العالم

103
00:07:52,890 --> 00:07:56,350
مُجرّد النّظر إلى أشخاصٍ مثلكَ يُزعجني

104
00:07:56,350 --> 00:07:58,700
أنا أشفق عليك يا ياما-كُن

105
00:07:59,030 --> 00:07:59,950
ماذا؟

106
00:08:00,400 --> 00:08:03,180
أيّ نوعٍ من الاعتراض المُضحك هذا؟

107
00:08:03,180 --> 00:08:05,420
هل تقول أنّه من المحرج أن تمتلك حلماً؟

108
00:08:07,070 --> 00:08:09,120
ما هو الصّحيح بالنّسبة لك إذاً؟

109
00:08:09,120 --> 00:08:13,180
هل ستكون طبيعيّاً إن كُنتَ تماماً مثل أيّ شخص آخر؟

110
00:08:13,490 --> 00:08:15,340
هل مُشاركتهم الضّحك

111
00:08:15,340 --> 00:08:19,890
على أولئك الّذين يناضلون لتحقيق أهدافهم يجعلكَ طبيعيّاً؟

112
00:08:19,890 --> 00:08:22,890
أيّ شخص يفعل هذا هو أدنى أنواع الحثالة

113
00:08:23,150 --> 00:08:25,300
لا يفقد النّاس أحلامهم أبداً

114
00:08:28,260 --> 00:08:29,900
أنتَ تُغضبني

115
00:08:30,440 --> 00:08:33,150
لنُقم مسابقة لكي نكتشف من المحقّ

116
00:08:33,500 --> 00:08:37,330
هل ستنتصر أحلامك على معتقداتي المتعفّنة؟

117
00:08:37,330 --> 00:08:38,780
دعنا نُقم اختبار تحمّل

118
00:08:39,450 --> 00:08:40,420
حسناً

119
00:08:40,890 --> 00:08:44,290
فلتذق طعم سحري

120
00:09:02,640 --> 00:09:04,640
ولكن يجب أن أعترف أنّكَ قويّ

121
00:09:07,390 --> 00:09:09,920
كان والداي متمسكان بالانضباط

122
00:09:09,920 --> 00:09:12,570
وحتّى الآن، لم أفوّت يوماً من التّدريب

123
00:09:12,930 --> 00:09:16,110
ولكنَّنا إن تابعنا ستصبح حياتك على المحكّ

124
00:09:17,610 --> 00:09:19,580
اذهب ونَم في منزلك

125
00:09:19,790 --> 00:09:21,300
يا ياما جوغو

126
00:09:22,170 --> 00:09:24,040
هكذا يلعبها إذاً

127
00:09:28,270 --> 00:09:29,250
ماذا حصل؟

128
00:09:32,580 --> 00:09:34,210
نفدت الطّاقة منها أخيراً

129
00:09:34,520 --> 00:09:37,260
ما الّذي يحصل هنا؟

130
00:09:37,260 --> 00:09:40,000
لم تكُن تعلم أليسَ كذلك؟

131
00:09:40,000 --> 00:09:42,290
تلكَ العصا بها عيب

132
00:09:42,630 --> 00:09:43,430
عيب؟

133
00:09:43,720 --> 00:09:46,250
"أنتَ قلت " أيّ أمنيةٍ أرغب بها

134
00:09:46,250 --> 00:09:50,220
ولكن استخدامات عصا السّاحر محدودة

135
00:09:50,220 --> 00:09:51,400
ماذا؟

136
00:09:51,790 --> 00:10:04,890
احترق، احترق، احترق

137
00:09:54,840 --> 00:09:59,630
رأيت فقط مميزاتها ولم تنظر إلى عيوبها

138
00:09:59,970 --> 00:10:03,970
انجذابك الشّديد للعصا الّتي لطالما رغبت بها لسنواتٍ عديدة

139
00:10:03,970 --> 00:10:07,960
واقتناعك بأنّه الكنز الأكثر قوّة في مجموعة نانانا

140
00:10:07,050 --> 00:10:07,960
قلت احترق

141
00:10:07,960 --> 00:10:11,590
هو الّذي أجبرك على التّخلي عن أيّ شكّ في قوّة العصا

142
00:10:08,820 --> 00:10:11,590
احترق، احترق

143
00:10:12,090 --> 00:10:16,550
ومبالغتك في تقدير قوّة العصا ألحق بك الخسارة

144
00:10:12,420 --> 00:10:13,560
احترق

145
00:10:14,080 --> 00:10:16,550
كلا، هذا مُستحيل

146
00:10:18,760 --> 00:10:22,520
أيّها الرّئيس يويغا، كان عليك أن تجعل نانانا-تشان تعلمك

147
00:10:22,520 --> 00:10:24,260
كيفية استخدام العصا

148
00:10:24,260 --> 00:10:29,230
ولكنّ شعورك بالذّنب لما فعلتهُ بنا قد أوقفك

149
00:10:31,350 --> 00:10:36,350
لم تكن قادراً على إبقاء عزّتك في حلمك إلى النّهاية

150
00:10:36,350 --> 00:10:40,810
بمعنىً آخر، لم يعنِ حلمكَ الكثير لك

151
00:10:47,590 --> 00:10:49,940
مثير للشّفقة، مثير للشّفقة بالفعل

152
00:10:49,940 --> 00:10:51,690
!فلتمت يا ياما جوغو

153
00:10:51,690 --> 00:10:54,680
أين وصلت بنفسك لتلقِ عليه محاضرة هكذا؟

154
00:10:55,060 --> 00:10:58,810
تخلّيتَ عمّا تؤمن به منذ زمنٍ طويل

155
00:10:58,810 --> 00:11:01,590
أنت حثالة تندمج مع الحشد

156
00:11:08,480 --> 00:11:09,980
ألن تضربني؟

157
00:11:10,930 --> 00:11:12,970
لا أعتقد أنّ هذا ضروريّ

158
00:11:13,400 --> 00:11:14,840
كلانا يعلم أنني قد ربحت

159
00:11:14,840 --> 00:11:16,070
أعطني العصا

160
00:11:16,070 --> 00:11:17,570
أخشى أنّ هذا سيكون مستحيلاً

161
00:11:17,570 --> 00:11:19,090
سامحني يا زميلي

162
00:11:20,210 --> 00:11:23,960
لا نستطيع إعطاءك العصا من أجل طموح إيشين

163
00:11:27,940 --> 00:11:29,420
هل أنتَ بخير؟

164
00:11:32,290 --> 00:11:33,810
أين إيبارا-سينباي؟

165
00:11:33,810 --> 00:11:34,800
لقد هربت

166
00:11:36,290 --> 00:11:38,050
لماذا لم تضربه؟

167
00:11:39,140 --> 00:11:40,610
سؤال جيّد

168
00:11:42,960 --> 00:11:45,010
لا يفقد النّاس أحلامهم أبداً

169
00:11:45,260 --> 00:11:50,770
لم أستطع ضرب شخص بحلم غبيّ كذاك

170
00:11:52,270 --> 00:11:54,770
قام بتوبيخك فعلاً، أليس كذلك؟

171
00:11:54,770 --> 00:11:57,980
فعل ذلك حقّاً، فقد عجزت عن التكلّم

172
00:11:58,330 --> 00:12:01,970
ولكن لم يبدُ ياما شخصاً سيّئاً

173
00:12:01,970 --> 00:12:03,050
ماذا؟

174
00:12:03,050 --> 00:12:05,620
بعد أن آذى إيشين-ساما بهذه الطّريقة؟

175
00:12:19,280 --> 00:12:20,130
!تينساي-كُن

176
00:12:22,920 --> 00:12:24,760
مرحباً يا يويغا-دونو

177
00:12:24,760 --> 00:12:27,280
سُررتُ بلقائك هنا

178
00:12:27,280 --> 00:12:29,560
ماذا تكونين بالضبط؟

179
00:12:30,000 --> 00:12:32,270
محقّقةٌ بارعة فقط

180
00:12:32,270 --> 00:12:35,020
ولكنَّني الآن رسولة من إيكاكو شونجو

181
00:12:35,630 --> 00:12:36,980
ما الّذي تتكلّمين عنه؟

182
00:12:37,300 --> 00:12:38,650
في الواقع، عندما أوضحتُ

183
00:12:38,650 --> 00:12:40,910
سوء تفاهم للحكومة

184
00:12:40,910 --> 00:12:43,080
طلبتُ مُساعدة إيكاكو

185
00:12:43,080 --> 00:12:46,120
أبرمنا صفقةً رغم عدم رغبته لها

186
00:12:46,120 --> 00:12:47,450
لكنّه أراد أن يقدّم لي خدمة واحدة

187
00:12:47,840 --> 00:12:50,070
ماذا علينا أن نفعل؟ هل نشق طريقنا ونهرب؟

188
00:12:50,070 --> 00:12:53,240
كلا، ربّما تكون قادراً على تولّي الأمر بنفسك

189
00:12:53,240 --> 00:12:55,150
ولكنّ هذا كثيرٌ بالنّسبةِ لي وليو

190
00:12:55,520 --> 00:12:56,940
إن أعطيتكِ هذه

191
00:12:56,940 --> 00:13:00,550
هل تضمنينَ لي سلامتي أنا وصديقاي؟

192
00:13:01,890 --> 00:13:03,980
رسالة من إيكاكو

193
00:13:03,980 --> 00:13:07,390
"أنا أعمل بالتّجارة، ولكنّني لا أسرق"

194
00:13:07,600 --> 00:13:08,780
إنّها كلماته

195
00:13:24,610 --> 00:13:26,950
أعتذر لمناداتك إلى هنا

196
00:13:27,500 --> 00:13:29,100
هل أنت بخير؟

197
00:13:30,130 --> 00:13:32,280
أنا أتألّم كثيراً

198
00:13:32,280 --> 00:13:33,490
سامحني

199
00:13:33,490 --> 00:13:34,950
خنتُ زميلي

200
00:13:34,950 --> 00:13:37,920
واستخدمت قوّتي دون جدوى، فانتهى الأمر هكذا؟

201
00:13:38,580 --> 00:13:39,690
هذا ما تستحقه

202
00:13:40,090 --> 00:13:41,790
بالفعل

203
00:13:42,700 --> 00:13:45,610
وبعد؟ ماذا ستفعل الآن؟

204
00:13:46,020 --> 00:13:48,230
سأذهب للبحث عن شيءٍ آخر

205
00:13:48,660 --> 00:13:51,500
كنزٌ من مجموعة نانانا سيحقّق لي أهدافي

206
00:13:54,930 --> 00:13:57,230
حسناً، سأمرّ على غرفة النّادي في بعض الأحيان

207
00:13:59,090 --> 00:14:01,030
لا مزيد من الخيانة

208
00:14:02,080 --> 00:14:04,100
لا أستطيع أن أضمن لك هذا

209
00:14:07,970 --> 00:14:10,620
أهلاً يا جوغو، كنتُ بانتظارك

210
00:14:10,620 --> 00:14:12,470
ماذا تقصدين بهذا؟

211
00:14:12,470 --> 00:14:15,660
هذا غير صحيح، لقد تخلّيتِ عنّي

212
00:14:15,660 --> 00:14:16,580
ما الّذي تتحدّث عنه؟

213
00:14:17,560 --> 00:14:21,790
اختطفني أولئك الأشخاص
وأنتِ تخلّيتِ عنّي

214
00:14:21,790 --> 00:14:22,960
لمَ تقول هذا؟

215
00:14:22,960 --> 00:14:25,960
ألستَ تعمل مع فرقة الّلص الشّبح ماتسوري؟

216
00:14:26,870 --> 00:14:27,810
ماذا؟

217
00:14:28,680 --> 00:14:33,560
لماذا عليّ أن أصدّق اختطافك المزيّف؟

218
00:14:33,560 --> 00:14:36,810
...تمهّلي قليلاً، هذا

219
00:14:36,810 --> 00:14:37,770
ما الأمر؟

220
00:14:38,390 --> 00:14:39,980
كيفَ عرفتِ هذا؟

221
00:14:40,520 --> 00:14:43,500
تأكّدتُ من هذا عندما دخلت

222
00:14:43,500 --> 00:14:45,480
الغرفة 202 رغما عنك وتحقّقتُ من هاتفك

223
00:14:46,250 --> 00:14:47,610
ماذا؟ أتمزحين معي؟

224
00:14:48,080 --> 00:14:48,820
هذا مُستحيل

225
00:14:49,310 --> 00:14:52,400
قلتَ لي أنّك تركتَ المتجر تلكَ الّليلة

226
00:14:52,400 --> 00:14:55,190
بسبب ارتجاج هاتفك، أليسَ كذلك؟

227
00:14:55,190 --> 00:14:57,330
أجل، ولكن لم يصدّقني أحد

228
00:14:58,130 --> 00:15:01,290
كلا، أنا صدّقتك

229
00:15:01,740 --> 00:15:05,450
لم يكُن هناك أيّ رسائل أو اتّصالات على هاتفك

230
00:15:05,450 --> 00:15:08,160
ولكن كان هناك منبّه ضُبط على ذاكَ الوقت

231
00:15:09,050 --> 00:15:11,640
كان وقت سقوط الصّندوق الّذي

232
00:15:11,640 --> 00:15:14,750
يحتوي على الجوهرة
في ذاك الممرّ بمظلّة

233
00:15:17,440 --> 00:15:20,010
كُنت تعلم مسبقاً يا جوغو

234
00:15:20,010 --> 00:15:23,820
أنّ الجوهرة ستقع هناك في ذاك الوقت

235
00:15:23,820 --> 00:15:25,070
وكيفَ علمتَ هذا؟

236
00:15:25,550 --> 00:15:28,960
لأنّكَ علِمتَ كلّ شيءٍ عن جريمة ماتسوري

237
00:15:28,960 --> 00:15:30,650
المُخطّط لها مُسبقاً

238
00:15:31,240 --> 00:15:34,120
وكيفَ اكتشفتَ هذا؟

239
00:15:34,530 --> 00:15:37,370
لأنّك تعمل مع ماتسوري

240
00:15:37,700 --> 00:15:40,820
واستوليت على ما خطّطوا له رُغماً عنهم

241
00:15:41,230 --> 00:15:42,500
أين هو دليلكِ؟

242
00:15:42,890 --> 00:15:45,630
لقد اخترقتُ هاتفك النقّال

243
00:15:47,420 --> 00:15:49,410
لم أكن أتوقّعهم

244
00:15:49,410 --> 00:15:53,470
يستخدمون شبكة انترنت اجتماعيّة لإعداد خطّتهم

245
00:15:53,770 --> 00:15:56,310
ومتى فعلتِ هذا؟

246
00:15:56,780 --> 00:15:59,490
بينما كُنّا نشاهد فيديو المتجر

247
00:15:59,490 --> 00:16:04,440
قمتُ بتحميل برنامج اختراق على هاتفك النقّال

248
00:16:05,090 --> 00:16:07,200
حتّى عندما كُنّا عالقين في الأطلال

249
00:16:07,200 --> 00:16:11,640
اتّصلتَ بأعضاء ماتسوري طلباً للمساعدة

250
00:16:16,750 --> 00:16:19,430
هذا لا يُصدّق

251
00:16:19,430 --> 00:16:22,310
لم أكُن أتخيّل أنّكِ ستكتشفين الأمر بهذه الطّريقة

252
00:16:23,140 --> 00:16:25,490
لقد اكتشفت كل شيء

253
00:16:25,490 --> 00:16:26,540
إذاً؟

254
00:16:26,540 --> 00:16:28,750
هل ستُسلّمينني للشّرطة؟

255
00:16:29,260 --> 00:16:32,930
كلّ محقّقٍ بارع يحتاج إلى منافس يا جوغو

256
00:16:34,090 --> 00:16:36,500
وبالطّبع من الأفضل أن يكون المنافس شرّيراً

257
00:16:36,500 --> 00:16:40,730
وبالتّحديد، يكون أصلهُ شرّير ولديهِ قدرة جسديّة عالية

258
00:16:40,730 --> 00:16:42,590
وعقل مدبّر

259
00:16:42,590 --> 00:16:44,560
وبالطّبع، عينان شرّيرتان

260
00:16:44,750 --> 00:16:48,260
مهلاً، أنتِ لن تطلبي منّي أن أكون كلّ هذا صحيح؟

261
00:16:48,260 --> 00:16:51,250
كلا، لن أطلب منكَ أن تصبحَ واحداً الآن

262
00:16:51,250 --> 00:16:53,230
لأنّكَ هكذا بالفعل

263
00:16:53,230 --> 00:16:55,200
ماذا تقصدين؟

264
00:16:55,570 --> 00:16:57,550
أنت تجلس في المدرسة بجانبي

265
00:16:57,550 --> 00:16:59,010
وبدءاً من الغد

266
00:16:59,010 --> 00:17:03,220
سأنتقل أنا وداروكو إلى الغرفة 203 في المنزل السّعيد

267
00:17:03,220 --> 00:17:04,670
...سوف

268
00:17:09,600 --> 00:17:13,250
أنا المحقّقة البارعة إيكيو تينساي

269
00:17:14,390 --> 00:17:15,710
اصمتي

270
00:17:20,470 --> 00:17:21,930
أبي

271
00:17:22,720 --> 00:17:23,780
ما الأمر؟

272
00:17:24,200 --> 00:17:26,440
أخبرتني يوكيهيمي بما حصل

273
00:17:26,440 --> 00:17:28,650
اتّصلت الآن لأنّني أحببتُ ما سمعت

274
00:17:28,650 --> 00:17:30,280
هكذا الأمر إذاً؟

275
00:17:30,280 --> 00:17:31,780
ما أحوال الجزيرة؟

276
00:17:32,280 --> 00:17:35,650
نفيتني إلى جزيرة غريبة

277
00:17:36,130 --> 00:17:40,030
ولكنَّ هذا حرّرني من أعمال ماتسوري منتهية الصلاحية

278
00:17:40,430 --> 00:17:42,750
أنا أعيش كما يحلو لي

279
00:17:44,550 --> 00:17:45,750
يسرُّني سماع هذا

280
00:17:46,050 --> 00:17:48,300
والآن، بما أنّكَ أدرتَ ظهرك

281
00:17:48,300 --> 00:17:50,480
لماتسوري، وتعيش كما تريد

282
00:17:50,480 --> 00:17:52,530
ما الّذي استحوذ على قلبك لكي

283
00:17:52,530 --> 00:17:54,080
تورّط يوكيهيمي وإيبارا؟

284
00:17:54,760 --> 00:17:56,370
لا شيء على وجه الخصوص

285
00:17:58,370 --> 00:18:01,350
ألم تقل أنّك لن تحلّ مكاني؟

286
00:18:01,350 --> 00:18:02,970
هذا صحيح

287
00:18:02,970 --> 00:18:05,490
أنتَ تقول أنّكم لصوص نبلاء يسرقون من الأشرار

288
00:18:05,490 --> 00:18:08,310
ويساعدون الأشخاص الواقعين في المشاكل، ولكن هذا هراء

289
00:18:08,940 --> 00:18:10,600
أعتقد هذا

290
00:18:11,270 --> 00:18:13,730
أعلمُ أنك لا تحبّ النّاس على أيّ حال

291
00:18:15,890 --> 00:18:18,580
لا تفترض أنّك تعرفني أيّها الرّجل العجوز

292
00:18:18,580 --> 00:18:22,700
أظنك حصلتَ على صديقة أو صديقتين إذاً؟

293
00:18:25,640 --> 00:18:28,310
من الأفضل أن تصدّق هذا، فالفتيات تُحبّني

294
00:18:28,610 --> 00:18:32,880
لا تستطيع تلك الفتاة الشّقراء الّتي التقيتها الابتعادّ عنّي

295
00:18:33,540 --> 00:18:35,090
ولكن بطريقةٍ مختلفة

296
00:18:35,440 --> 00:18:37,650
هذا مُذهل

297
00:18:38,230 --> 00:18:41,220
كم تُحبّها إذاً؟

298
00:18:41,670 --> 00:18:43,020
قل لي

299
00:18:43,020 --> 00:18:45,100
لمَ عليَّ فعل هذا؟

300
00:18:45,100 --> 00:18:47,420
أنتَ لا تكره النّاس أليسَ كذلك؟

301
00:18:47,420 --> 00:18:49,230
أخبرني إذاً

302
00:18:49,470 --> 00:18:52,460
حسناً، أنا أحترمها

303
00:18:52,960 --> 00:18:55,190
أعتقد أنّها مذهلة حقّاً

304
00:18:55,580 --> 00:18:57,270
هذا كلّ شيء، أليسَ كذلك؟

305
00:18:57,740 --> 00:18:59,460
ألا تحبّها كثيراً

306
00:18:59,460 --> 00:19:02,550
لدرجة التخلّي عن كلّ شيء لأجلها؟

307
00:19:02,550 --> 00:19:04,830
...ليس الأمر وكأنّني وقعتُ في حبّها أو

308
00:19:04,830 --> 00:19:07,540
إذاً، إن احتاجتكَ يوماً ما

309
00:19:07,540 --> 00:19:10,170
هل ستفعل شيئاً من أجلها؟

310
00:19:10,170 --> 00:19:13,500
حسناً، سأفعل ما بوسعي

311
00:19:13,500 --> 00:19:15,840
ولأي درجة تقصد عندما قلت "ما بوسعك"؟

312
00:19:19,590 --> 00:19:22,550
بمعنى آخر
مازلت لست قادراً على حبّ الآخرين

313
00:19:22,930 --> 00:19:25,360
لهذا السّبب لا أعتقد أنّكَ تستطيع إنقاذ أحد

314
00:19:25,880 --> 00:19:30,270
أنت تملك القوّة
ولكنّك لا تستخدمها لأجل الآخرين

315
00:19:32,070 --> 00:19:34,430
هذا يعني أنَّني مهما قلت لك

316
00:19:34,840 --> 00:19:38,340
فأنت لست مؤهّلاً للتفوّق عليّ من البداية

317
00:19:38,340 --> 00:19:39,520
ليس عليك أن تقول لي هذا

318
00:19:39,520 --> 00:19:41,590
سوف أموت قبل أن أصبح نبيلاً

319
00:19:41,590 --> 00:19:43,610
إن أردت ماتسوري
فبإمكانك أنت ورجالك

320
00:19:43,610 --> 00:19:44,770
أن تستمرّوا في الأمر

321
00:19:44,770 --> 00:19:46,170
لن أفعل ذلك

322
00:19:46,170 --> 00:19:47,560
لن أفعل ذلك أبداً

323
00:19:47,560 --> 00:19:49,120
أفضّل الموت على ذلك

324
00:20:01,070 --> 00:20:02,800
هل هذا معقول؟

325
00:20:03,200 --> 00:20:04,260
تبّاً لك

326
00:20:04,740 --> 00:20:06,720
توقّف عن الّلحاق بي

327
00:20:11,290 --> 00:20:13,190
كم هذا مزعج

328
00:20:22,370 --> 00:20:23,880
رمية موفّقة

329
00:20:25,200 --> 00:20:26,370
أهلاً بعودتك

330
00:20:28,180 --> 00:20:29,330
لقد عدت

331
00:20:31,010 --> 00:20:34,390
هذا كاشف الكذب المُضيء أليسَ كذلك؟

332
00:20:35,250 --> 00:20:39,370
ألم تقل أنّك ستستخدمه لتعقد صفقة؟

333
00:20:39,370 --> 00:20:42,090
أجل، ولكن انتهى بي الأمر بإعادته

334
00:20:42,700 --> 00:20:46,470
أعطيتها شيئاً مزيّفاً على سبيل المزاح ولكنَّها لم تلاحظ

335
00:20:47,780 --> 00:20:51,180
أنتَ شرّيرٌ جدّاً بالفعل، أليس كذلك؟

336
00:20:51,180 --> 00:20:52,780
أنا لست كذلك

337
00:20:53,770 --> 00:20:57,190
المعذرة ولكنَّني اعتقدت أنّ هذا سيكون هدراً

338
00:20:57,190 --> 00:20:59,300
لذا، لم أرغب بالتخلي عنه

339
00:20:59,300 --> 00:21:00,690
حسناً، أعتقد أنّه لا بأس بهذا

340
00:21:02,200 --> 00:21:04,560
ما الّذي تقصدينه؟

341
00:21:04,880 --> 00:21:08,120
إن كُنتَ أنت
فأنا متأكّدة أنّك ستستخدمه لفعل شيءٍ جيّد

342
00:21:19,010 --> 00:21:23,480
أعني أنّك ستجد قاتلي من أجلي، صحيح؟