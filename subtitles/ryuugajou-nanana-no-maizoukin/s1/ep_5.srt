1
00:00:12,220 --> 00:00:15,600
تناولوا ما تريدون فالطّعام اليوم على حسابي

2
00:00:16,390 --> 00:00:20,910
:هذه وجبة غوكوغيو الخاصّة
إنّه خيارُنا الأفضل في الّلحم المشويّ

3
00:00:21,420 --> 00:00:24,420
ما زلتَ شابّاً، لذا تناول كل ما تريده

4
00:00:25,680 --> 00:00:27,590
بما أنّكَ ما زلتَ شابّاً

5
00:00:34,280 --> 00:00:37,090
مهلاً، أنتَ لا تحتاج للكولاجين

6
00:00:37,090 --> 00:00:40,310
أنا أريد بشرة ناعمة أيضاً

7
00:00:46,380 --> 00:00:48,190
تذهب الغنائم للدّخيل

8
00:00:48,560 --> 00:00:51,760
تناولي البصل
أنتِ مُحقّقة أليس كذلك؟

9
00:00:51,760 --> 00:00:55,610
افتحي فمكِ يا تينساي

10
00:00:56,830 --> 00:01:02,330
مجرّد مساعدة تطلب منّي فتح فَمي
لا بدّ أنّك  نسيت مكانتك

11
00:01:02,710 --> 00:01:04,700
تناوَلتِها بجميع الأحوال

12
00:01:04,700 --> 00:01:08,070
لم أستطع مقاومة الرّائحة القويّة للدّهون

13
00:01:12,810 --> 00:01:15,470
إنه... جيّد

14
00:01:15,890 --> 00:01:18,070
إنّهُ يبدو كخادمةٍ يافعة

15
00:01:18,070 --> 00:01:20,970
لكنّهُ فخ، ولديهِ إكسكاليبار مثلي

16
00:01:21,780 --> 00:01:25,350
هل يستطيع مقاومة تذوّق لعاب فتاة؟

17
00:01:25,350 --> 00:01:27,290
كلا، بالطّبع لن يفعل

18
00:01:30,450 --> 00:01:32,540
شكراً على الطّعام

19
00:01:33,200 --> 00:01:34,820
ماذا؟

20
00:01:36,270 --> 00:01:38,110
كنتُ أحاول إشباع الشهيّة الخاطئة

21
00:01:38,560 --> 00:01:40,350
شكراً على الطّعام

22
00:01:43,830 --> 00:01:46,670
هل فعلها؟ أم لم يفعلها؟

23
00:03:22,570 --> 00:03:27,430
والآن، أودُّ مناقشة نشاطاتنا المستقبليّة

24
00:03:28,240 --> 00:03:31,980
في الواقع، لديّ دليل عن مكان قد توجد به أطلال

25
00:03:32,940 --> 00:03:35,730
إنّها بلدة للينابيع الحارّة
موجودة في الجزء الغربي من الجزيرة

26
00:03:35,730 --> 00:03:39,890
أعتقد بإمكاننا الذّهاب إلى هناك في رحلة مَبيت في عطلة نهاية الأسبوع

27
00:03:39,890 --> 00:03:43,180
ينابيع حارّة؟ يبدو هذا مُمتعاً

28
00:03:43,180 --> 00:03:45,160
أجل، لنقم بهذا

29
00:03:45,620 --> 00:03:46,940
ينابيع حارّة

30
00:03:46,940 --> 00:03:48,730
برفقة إيشين-ساما

31
00:03:49,900 --> 00:03:52,840
كم ستكلّف هذه الرّحلة؟

32
00:03:52,840 --> 00:03:56,460
لقد أنفقت مُرتّبي من العمل الجزئيّ هذا الشّهر

33
00:03:56,460 --> 00:03:58,500
لا داعي للقلق

34
00:03:58,160 --> 00:04:00,090
انتظرت هذا اليوم

35
00:03:58,710 --> 00:04:01,180
جنيتُ بعض المال الإضافي، لذا أنا سأدفع

36
00:04:00,640 --> 00:04:03,990
سأفعل أيّ شيء. وسأدعه يفعل أيّ شيء

37
00:04:01,180 --> 00:04:03,990
حقّاً؟ حسناً سأذهب

38
00:04:03,990 --> 00:04:05,430
سنذهب جميعاً إذاً

39
00:04:07,840 --> 00:04:09,500
جوغو

40
00:04:09,500 --> 00:04:13,350
إنّنا قادمان إلى منزلك غداً
لذا حضّر العشاء

41
00:04:13,660 --> 00:04:16,490
ما الذي تقولينه وبطنك على هذه الحال؟

42
00:04:16,490 --> 00:04:17,360
سوف تسمنين

43
00:04:20,330 --> 00:04:22,770
أنت لا تعرف شيئاً

44
00:04:22,770 --> 00:04:24,410
المحققون البارعون لا يسمنون

45
00:04:24,770 --> 00:04:27,030
لا تربطي جملة "المحققة البارعة" بكلّ شيء

46
00:04:27,030 --> 00:04:30,120
ولن أعدّ العشاء لكما غداً

47
00:04:30,400 --> 00:04:32,950
رأيكَ غير مهمّ

48
00:04:32,950 --> 00:04:36,540
قالت لنا نانانا-دونو أنَّ باستطاعتنا زيارتها متى نريد

49
00:04:36,540 --> 00:04:39,090
منذ متى وأنتِ صديقة لها؟

50
00:04:39,090 --> 00:04:41,660
حسناً، ليلة سعيدة يا جوغو

51
00:04:42,620 --> 00:04:43,800
ليلة سعيدة

52
00:04:44,310 --> 00:04:46,560
حسناً، ليلة سعيدة

53
00:04:47,260 --> 00:04:48,300
لا تجرئي على القدوم

54
00:04:51,520 --> 00:04:55,740
إذاً، بخصوص كنز مجموعة نانانا في بلدة الينابيع الحارّة

55
00:04:55,740 --> 00:04:57,060
للعلم فقط

56
00:04:57,060 --> 00:04:59,810
بما أنّني أعطيتك تلميحاً المرّة الماضية
فلن أعطيك شيئاً لفترة

57
00:04:59,810 --> 00:05:00,690
ماذا؟

58
00:05:01,180 --> 00:05:03,860
أشعر أنّ تدليلك سيفسدك

59
00:05:03,860 --> 00:05:05,150
لذا سأكون صارمة

60
00:05:05,700 --> 00:05:07,110
...ولكن

61
00:05:07,550 --> 00:05:11,310
لكن يبدو أنّ الذّهاب للينابيع الحارّة مع الجميع جميل

62
00:05:11,310 --> 00:05:14,370
لم يكن هناك ينابيع حارّة عندما كنت على قيد الحياة

63
00:05:16,650 --> 00:05:19,230
حسناً، أنا لا أستطيع مغادرة هذه الغرفة

64
00:05:19,230 --> 00:05:21,300
لذا، سوف أكتفي بقصصك

65
00:05:21,780 --> 00:05:24,600
أخبرني كلّ شيء، اتفقنا؟

66
00:05:26,290 --> 00:05:27,470
لكِ ذلك

67
00:05:27,810 --> 00:05:30,850
...ولكن... ينبوع حار مع نانانا

68
00:05:30,850 --> 00:05:32,170
ركّز

69
00:05:32,170 --> 00:05:33,570
أجل

70
00:05:35,270 --> 00:05:37,730
يوكيهيمي

71
00:05:35,270 --> 00:05:37,730
علينا التحدّث
أخبرني أيّ يوم سيكون مناسباً لك

72
00:05:45,340 --> 00:05:47,200
أنت متحمس للغاية

73
00:05:47,470 --> 00:05:50,410
أجل، لديّ موعد اليوم

74
00:05:50,410 --> 00:05:52,570
!هذا جيد

75
00:05:52,570 --> 00:05:55,370
تأكّد أن تُرافقها بشكل لائق

76
00:05:55,870 --> 00:05:58,710
...ألا يُفترض بك أن تغاري أو

77
00:05:58,710 --> 00:06:00,610
أحضر معك البودينغ في طريق عودتك

78
00:06:00,610 --> 00:06:01,520
حسناً

79
00:06:07,300 --> 00:06:08,510
أهلاً

80
00:06:17,960 --> 00:06:19,740
شاي مثلّج بالّليمون

81
00:06:19,740 --> 00:06:21,150
بالتّأكيد

82
00:06:21,910 --> 00:06:26,740
إذاً، ما سبب هذه الدعوة؟

83
00:06:26,740 --> 00:06:28,540
إلى ماذا تنظر بالضّبط؟

84
00:06:28,540 --> 00:06:30,360
المعذرة

85
00:06:32,080 --> 00:06:34,690
إن أردت أن تنظر، فانظر كما تريد

86
00:06:35,310 --> 00:06:36,330
أو

87
00:06:37,050 --> 00:06:38,620
هل تفضّل لمسهما؟

88
00:06:39,460 --> 00:06:41,570
أيمكنني ذلك؟

89
00:06:43,330 --> 00:06:44,630
حسناً

90
00:06:45,090 --> 00:06:47,720
ماذا تريدين يا شو-سان؟

91
00:06:47,720 --> 00:06:50,540
كيفَ عرفت؟

92
00:06:51,220 --> 00:06:53,890
هل لأنّني جعلتُ صدري كبيراً؟

93
00:06:54,770 --> 00:06:55,970
كلا

94
00:07:01,190 --> 00:07:02,610
لنجرّب هذا مجدّداً

95
00:07:02,610 --> 00:07:04,280
لم نرك منذ فترة طويلة أيّها السيّد الشاب

96
00:07:04,810 --> 00:07:07,110
أشكرك على المساعدة في ذاك اليوم

97
00:07:07,110 --> 00:07:09,540
كانت لدينا مصحلة مشتركة وحسب

98
00:07:11,220 --> 00:07:14,700
إذاً، متى ستعود إلى ماتسوري؟

99
00:07:16,340 --> 00:07:17,410
لن أعود

100
00:07:18,070 --> 00:07:21,370
لن تحتاج إذًا إلى هذا المال بعد الآن، صحيح؟

101
00:07:21,890 --> 00:07:25,830
...ابنٌ مطرود يقبل المال من أبيه

102
00:07:25,830 --> 00:07:28,380
يبدو لي أنك تتعامل مع الحياة على أنّها نكتة

103
00:07:28,380 --> 00:07:30,590
سأحتفظ بكلّ هذا لنفسي

104
00:07:30,590 --> 00:07:33,190
!انتظري! هذا اختلاس

105
00:07:33,190 --> 00:07:35,240
ليكن ذلك. ما قصدك؟

106
00:07:39,120 --> 00:07:40,600
حسنًا، خذيه

107
00:07:42,100 --> 00:07:43,990
أنت عنيدٌ بالفعل

108
00:07:45,230 --> 00:07:46,980
دعني أسألك سؤالاً

109
00:07:47,500 --> 00:07:50,570
لماذا تبحث عن مجموعة نانانا؟

110
00:07:51,670 --> 00:07:52,820
هذا سرّ

111
00:07:53,890 --> 00:07:56,730
تشارك ماتسوري هدفك
ألم يخطر لك

112
00:07:56,730 --> 00:08:00,180
أنّ العودة إلينا ستعطيك فرصة أكبر للنّجاح؟

113
00:08:00,180 --> 00:08:02,830
لا تكلّميني وكأنني أحمق

114
00:08:02,830 --> 00:08:04,290
أنا مدركٌ لذلك

115
00:08:04,520 --> 00:08:06,670
لمَ لا تعودُ إذاً؟

116
00:08:07,610 --> 00:08:10,510
لأنَّه لا يمكنني أن أوافق على نوايا ماتسوري

117
00:08:11,510 --> 00:08:13,220
ماذا تقصد؟

118
00:08:13,610 --> 00:08:17,310
ليس لديّ اهتمام بفعل أيّ شيء لمساعدة النّاس

119
00:08:18,080 --> 00:08:21,260
وهل طُردتَ لأنّكَ أخبرتَ الزّعيم بهذا؟

120
00:08:21,260 --> 00:08:22,180
هذا صحيح

121
00:08:23,250 --> 00:08:26,940
اكتسبتَ سلوكاً وقحاً منذ المرّة الأخيرة الّتي رأيتك بها

122
00:08:27,590 --> 00:08:30,940
لطالما شعرت بذلك
ولكنَّني لم أقلهُ من قبل

123
00:08:31,880 --> 00:08:34,800
سوف أقضي على مبادئك المتعفّنة هذه

124
00:08:35,600 --> 00:08:38,910
عِدني هنا والآن بأنّك ستعود إلى ماتسوري

125
00:08:39,150 --> 00:08:40,160
أرفض هذا

126
00:08:40,160 --> 00:08:41,410
!عُد

127
00:08:41,770 --> 00:08:43,040
!قلت لك، أرفض هذا

128
00:08:43,040 --> 00:08:44,250
!عُد

129
00:08:44,250 --> 00:08:46,620
!أرفض رفضًا تامًا

130
00:08:52,910 --> 00:08:55,180
ما هي مكانتي عندك أيها السيد الشاب؟

131
00:08:56,750 --> 00:08:57,640
ماذا؟

132
00:08:58,210 --> 00:09:03,100
كيف يرى ياما جوغو فوغي يوكيهيمي؟

133
00:09:03,100 --> 00:09:05,570
...أنا، في الواقع

134
00:09:05,570 --> 00:09:09,930
أنتِ كأختٍ كبرى ساعدتني كثيرًا

135
00:09:10,740 --> 00:09:12,570
سيكون هذا كافياً

136
00:09:13,260 --> 00:09:15,030
انتهى هذا النّقاش

137
00:09:15,030 --> 00:09:17,010
لا أريد أن أرى وجهك مجدّداً

138
00:09:23,150 --> 00:09:24,330
لقد عدت

139
00:09:24,330 --> 00:09:25,710
أهلاً بعودتك

140
00:09:25,980 --> 00:09:27,740
ما الّذي تفعلونه؟

141
00:09:27,740 --> 00:09:29,520
إنّها حفلة ألعاب

142
00:09:30,420 --> 00:09:31,210
تفضّل

143
00:09:31,590 --> 00:09:33,710
أنا هنا من أجل نفقات الخدمة العامة

144
00:09:36,860 --> 00:09:38,720
هل يُفترض أن تكلّف هذا القدر؟

145
00:09:38,720 --> 00:09:40,680
ين 3978                       الغاز

146
00:09:38,720 --> 00:09:40,680
ين 15765                   الكهرباء

147
00:09:38,720 --> 00:09:40,680
ين 2340                    الماء

148
00:09:38,720 --> 00:09:40,680
بالأخصّ الكهرباء

149
00:09:41,580 --> 00:09:45,180
ربّما لأنّه يوجد فتاة تعيش هنا وتلعب 24 ساعة يوميّاً

150
00:09:45,790 --> 00:09:49,600
شكراً لك يا جوغو على كلّ هذه الألعاب الّتي تشتريها

151
00:09:49,600 --> 00:09:52,650
فأنا أمضى اليوم كله بلعب ألعاب الانترنت ولوحة التحكم

152
00:09:53,860 --> 00:09:56,240
...أصغي أيتها المالكة

153
00:09:56,240 --> 00:09:58,360
أنا في ضائقة ماليّة هذا الشّهر

154
00:09:59,460 --> 00:10:02,330
سأحتاج النّقود في نهاية هذا الأسبوع
وإلّا سيتمّ طردك حالاً

155
00:10:04,550 --> 00:10:06,980
ليس كافياً أبداً

156
00:10:06,980 --> 00:10:08,750
لم يكن ذلك عالياً كفاية

157
00:10:10,920 --> 00:10:12,210
هل يمكنك الذهاب من الأسفل؟

158
00:10:13,060 --> 00:10:14,170
هكذا

159
00:10:17,550 --> 00:10:18,840
لقد مِتِّ

160
00:10:36,870 --> 00:10:39,950
أخبرني يويغا-سينباي من السّنة الثّالثة عنكم

161
00:10:40,730 --> 00:10:44,700
قال بأنّك تستطيع مساعدتي بإيجاد عمل جزئيّ بشكلٍ سريّ

162
00:10:44,700 --> 00:10:47,710
أنت ياما-كُن
لقد سمعتُ عنك

163
00:10:48,190 --> 00:10:51,340
أدعى سانادا هاجيكي
وأنا في السّنة الثّانية مثلك

164
00:10:51,880 --> 00:10:55,310
مرحباً بك بالنّقابة التّابعة للمدرسة الثّانويّة الثّالثة

165
00:10:55,310 --> 00:10:57,960
أهذه كلّها عروض أعمال سريّة؟

166
00:10:57,960 --> 00:11:01,590
أجل، ليس بمقدورك جني المال الكافي في أوقات العمل

167
00:11:01,590 --> 00:11:02,850
المسموح بها على الجزيرة

168
00:11:02,850 --> 00:11:05,600
تستجيب النّقابة هنا لهذه الحاجة

169
00:11:05,600 --> 00:11:09,810
حسناً، إن وجدت شيئاً يثير اهتمامك أحضره إليّ

170
00:11:09,810 --> 00:11:11,060
حسناً، شكراً

171
00:11:14,320 --> 00:11:16,280
عرض عمل

172
00:11:14,320 --> 00:11:16,280
رب العمل: مابورو شيكي
المكان: المنزل السّعيد في القطاع الجنوبي

173
00:11:14,320 --> 00:11:16,280
طبيعة العمل: أعمال حديقة وتسوق و أعمال أخرى
(..الشراب والشراب والشراب)
مؤهلات التوظيف: غير مطلوبة
الدّفع: قابل للتفاوض بالإضافة للمكافآت

174
00:11:14,320 --> 00:11:16,280
الإطار الزّمني: من شهر إلى ثلاثة أشهر، يومان بالأسبوع
السّاعات: بضع ساعات بالأمسيات

175
00:11:20,050 --> 00:11:23,320
نقل عاجل للبضائع
لقطاع تسوكويومي

176
00:11:23,990 --> 00:11:27,350
وقت هذا العمل في الغد من الثانية إلى الرابعة

177
00:11:27,350 --> 00:11:28,290
ثمانية آلاف ين؟

178
00:11:28,660 --> 00:11:29,910
يبدو هذا جيّداً

179
00:11:32,840 --> 00:11:35,000
!ضفائر سوداء

180
00:11:35,000 --> 00:11:38,440
...دع هذا العمل يقود إلى أفعال إجرامية

181
00:11:39,430 --> 00:11:41,160
!أنتِ... تينساي؟

182
00:11:41,160 --> 00:11:44,250
بما أنّك منافس للمحقّقة البارعة

183
00:11:44,250 --> 00:11:46,970
فأنا أحتاجك للتغلّب على الشر

184
00:11:47,360 --> 00:11:49,270
ما هذا الشّعر الأسود؟

185
00:11:49,270 --> 00:11:51,860
يُعدُّ التنكر مهارة أساسيّة للمحقّقين البارعين

186
00:11:51,860 --> 00:11:52,940
يبدو جميلاً أليس كذلك؟

187
00:11:53,580 --> 00:11:56,100
أعتقد أنّك تبدين طبيعية

188
00:11:56,100 --> 00:11:59,390
تظن في نفسك أنه ليس سيئًا

189
00:11:59,390 --> 00:12:01,400
أجل، هذا لو لم تكوني أنتِ من ترتدينه

190
00:12:02,690 --> 00:12:04,620
لمَ لا تنظر إلى عينيّ وتخبرني بهذا؟

191
00:12:04,620 --> 00:12:08,760
انظر، انظر

192
00:12:07,370 --> 00:12:08,760
توقّفي عن هذا

193
00:12:08,760 --> 00:12:10,440
...يا رفاق

194
00:12:10,440 --> 00:12:12,620
هلّا احتفظتما بهذا للخارج؟

195
00:12:14,180 --> 00:12:17,590
على أيّ حال، هل تحاولين دفع فواتيرك أيضاً؟

196
00:12:17,590 --> 00:12:20,590
أنا لا أسعى خلف النقود بالتّحديد

197
00:12:22,590 --> 00:12:25,750
كنت أبحث فقط عن قضايا مثيرة للاهتمام

198
00:12:22,590 --> 00:12:26,970
عرض عمل

199
00:12:34,550 --> 00:12:36,270
أين أنا بالتّحديد؟

200
00:12:38,360 --> 00:12:40,130
ما هذا المكان؟

201
00:12:46,290 --> 00:12:50,670
تبّاً يا تينساي
قمتِ بإلقاء لعنة غريبة عليّ

202
00:12:50,670 --> 00:12:52,000
سيّدي الشاب؟

203
00:12:54,200 --> 00:12:55,660
شو-سان؟

204
00:12:57,880 --> 00:12:59,500
لقد أنقذتني بالفعل

205
00:12:59,730 --> 00:13:03,970
لا بأس، أنا سعيد لأنّني كنت عوناً لك

206
00:13:04,460 --> 00:13:07,380
لم أكن أعلم بوجود مكان كهذا على جزيرة ناناي

207
00:13:07,380 --> 00:13:09,650
القطاع التّاسع لجزيرة ناناي

208
00:13:09,650 --> 00:13:11,180
معروف باسم قطاع تسوكويومي

209
00:13:11,550 --> 00:13:14,770
إنّه قطاع مضطرب، تأتي إليهِ خراف الجزيرة السوداء سويّاً

210
00:13:14,770 --> 00:13:19,180
لا تقترب منه الشّرطة
بل إنّها تتغاضى عنه في الواقع

211
00:13:21,010 --> 00:13:23,000
لمَ أنت هنا يا شو-سان

212
00:13:23,000 --> 00:13:25,040
أريد شراء بعض الأدوات للعمل

213
00:13:25,040 --> 00:13:29,490
لدى المنظّمة الّتي تحكم هذه القرية طريق تهريبها الخاصّ

214
00:13:29,490 --> 00:13:30,750
تهريب؟

215
00:13:33,460 --> 00:13:36,090
بالمُناسبة، أتذكر كنز مجموعة نانانا

216
00:13:36,090 --> 00:13:38,490
الّذي أعدتهُ لنا مؤخّراً؟

217
00:13:38,490 --> 00:13:39,840
الجوهرة الزّرقاء

218
00:13:39,840 --> 00:13:42,080
أجل

219
00:13:42,080 --> 00:13:44,690
يبدو أنّها كانت مزيّفة

220
00:13:44,690 --> 00:13:46,710
ماذا؟ حقًا؟

221
00:13:46,710 --> 00:13:51,100
وقال لنا الزّعيم أنّك مسؤول عن ذلك

222
00:13:51,520 --> 00:13:54,270
...كم هو قاسٍ والدي

223
00:13:54,270 --> 00:13:56,560
...عندها قالت يوكيهيمي

224
00:13:56,970 --> 00:14:03,530
"سيّدي، أنا أثق بك ولكنّني أثق بالسيّد الشابّ بنفس القدر"

225
00:14:04,580 --> 00:14:10,240
كانت المرّة الأولى الّتي أرى بها يوكيهيمي تعاتب الزّعيم

226
00:14:12,930 --> 00:14:15,220
ما خطبك؟

227
00:14:15,220 --> 00:14:20,450
المعذرة، أعتقد أنّ الكثير من الغبار قد دخل إلى عيني

228
00:14:20,800 --> 00:14:24,340
أنتَ سعيدٌ لأنّ يوكيهيمي دافعت عنك أليس كذلك؟

229
00:14:24,710 --> 00:14:29,300
كلا، أنا متفاجئ فقط من قُصر طبيعتي البشرية

230
00:14:30,200 --> 00:14:35,110
إذاً يا سيّدي الشابّ، إنّه سؤال متأخر ولكن ماذا يوجد بهذه الحقيبة؟

231
00:14:35,110 --> 00:14:36,190
هل تريد أن ترى؟

232
00:14:42,730 --> 00:14:45,190
..كلا، لا بأ

233
00:14:45,840 --> 00:14:47,510
والآن بما أنّك متواطئ

234
00:14:47,510 --> 00:14:49,000
ليس لي علاقة بهذا

235
00:14:49,000 --> 00:14:50,110
أنا ذاهب للمنزل

236
00:14:50,110 --> 00:14:51,970
لا تتركني وحيداً

237
00:14:51,970 --> 00:14:54,620
سماع هذا من شابّ آخر لا يجعلني سعيداً

238
00:14:55,580 --> 00:14:57,640
تفضّل، هذا هو المكان

239
00:14:59,840 --> 00:15:01,580
هذا مبتذلٌ جدّاً

240
00:15:06,360 --> 00:15:09,530
إلى الّلقاء يا سيدي الشابّ
دعنا نلتقي مجدّداً إن نجوت

241
00:15:09,530 --> 00:15:11,410
!شو-سان

242
00:15:17,740 --> 00:15:20,350
!يا تيتسو

243
00:15:23,340 --> 00:15:25,400
فتى التّوصيل هنا

244
00:15:30,570 --> 00:15:31,870
ادخل

245
00:15:36,160 --> 00:15:37,790
توقّف

246
00:15:43,570 --> 00:15:46,170
إنّه سيف يابانيّ، أليس كذلك؟

247
00:15:48,430 --> 00:15:53,090
...كنت أتساءل إن كان حقيقيا

248
00:15:53,540 --> 00:15:55,520
لا داعي لأن تعرف

249
00:15:58,160 --> 00:16:00,340
المعذرة يا أختي

250
00:16:12,780 --> 00:16:16,170
هل أنت ربّة العمل؟

251
00:16:16,170 --> 00:16:18,180
من تكون أنت؟

252
00:16:18,180 --> 00:16:19,240
أنا

253
00:16:20,620 --> 00:16:22,920
أين أختي يا يون؟

254
00:16:28,240 --> 00:16:30,190
أختي مشغولة

255
00:16:30,190 --> 00:16:32,900
قالت أن ينتظرها فتى التّوصيل

256
00:16:33,310 --> 00:16:35,890
لقد سمعتها، انتظر هنا

257
00:16:36,660 --> 00:16:38,100
حسناً

258
00:16:45,990 --> 00:16:47,690
لا تتحرّك

259
00:16:48,120 --> 00:16:50,820
أنت الآنسة يون أليس كذلك؟

260
00:16:50,820 --> 00:16:52,390
ما الّذي تنظر إليه؟

261
00:16:52,390 --> 00:16:54,450
أنا لست خائفة منك

262
00:16:54,790 --> 00:16:56,270
كم هذا فظّ

263
00:16:56,270 --> 00:16:58,160
أنا أبدو هكذا فقط

264
00:17:10,710 --> 00:17:13,300
أنا أعتذر فقد تماديت في مزاحي

265
00:17:15,120 --> 00:17:16,760
أنت يا فتى التّوصيل

266
00:17:17,300 --> 00:17:19,470
لا تستطيع لمس الأشياء دون إذن

267
00:17:19,650 --> 00:17:20,970
أجل، أجل

268
00:17:20,970 --> 00:17:23,260
عليكَ توخّي الحذر

269
00:17:23,260 --> 00:17:25,820
أختي هي رئيسة تسوكويومي
وهي سيّئة جداً

270
00:17:25,820 --> 00:17:28,190
و رائعة جدّاً ومخيفة جدّاً

271
00:17:31,960 --> 00:17:33,510
...هذا

272
00:17:33,510 --> 00:17:36,410
هل وجدت شيئاً يثير اهتمامك؟

273
00:17:43,270 --> 00:17:44,460
أينَ البضاعة؟

274
00:17:58,420 --> 00:18:01,600
ما مشكلتك؟ هل أنت بخير؟

275
00:18:01,600 --> 00:18:03,300
أجل

276
00:18:03,300 --> 00:18:05,140
تفضّلي

277
00:18:05,140 --> 00:18:07,370
لم تنظر إلى ما بداخلها، صحيح؟

278
00:18:07,370 --> 00:18:09,060
أحضرتها إلى هنا فقط

279
00:18:12,690 --> 00:18:15,990
هل سمعت عن مجموعة نانانا؟

280
00:18:16,710 --> 00:18:18,240
...كلا

281
00:18:18,240 --> 00:18:22,950
يُقال أنها الكنوز مخبّأة بجميع أنحاء جزيرة ناناي

282
00:18:23,660 --> 00:18:26,950
يُقال أنّها تمتلك قوىً خاصّة

283
00:18:28,490 --> 00:18:31,450
على سبيل المثال، هذا هو سهم إرادة السّماء

284
00:18:31,450 --> 00:18:33,340
إنّه يُشير فقط إلى الحقيقة

285
00:18:33,760 --> 00:18:36,010
ويخترق قلوب الكاذبين

286
00:18:46,100 --> 00:18:47,010
ماذا؟

287
00:18:51,010 --> 00:18:53,340
لماذا قفزَ بكلّ قواه؟

288
00:18:53,340 --> 00:18:54,690
أحمق، يا لك من أحمق

289
00:18:55,850 --> 00:18:57,780
أنت كفتى صغير

290
00:18:58,490 --> 00:19:01,660
لا تأبه لها، إنّها تخدعني في أغلب الأحيان أيضاً

291
00:19:01,660 --> 00:19:05,300
لا أصدق أنّك أخذت هذا بجديّة

292
00:19:05,300 --> 00:19:08,040
أجل، لقد خدعتني بالفعل

293
00:19:08,740 --> 00:19:12,920
وكأنّك تعلم أنّ مجموعة نانانا موجودة بالفعل

294
00:19:13,400 --> 00:19:16,970
كلا، أنا جبانٌ فقط

295
00:19:16,970 --> 00:19:19,210
وكاذب

296
00:19:19,210 --> 00:19:23,180
...كلا، كان هذا
كذبت اليوم في المدرسة

297
00:19:23,580 --> 00:19:27,150
اعتقدت أنّني متأخر عن هذا العمل، لذا أردت المغادرة باكرًا

298
00:19:27,150 --> 00:19:28,510
حقّاً؟

299
00:19:29,710 --> 00:19:30,940
شكراً على جهودك

300
00:19:33,770 --> 00:19:35,650
هل أنت جائع؟

301
00:19:35,650 --> 00:19:38,030
سأستخدم هذا لصنع كعكة لذيذة

302
00:19:38,680 --> 00:19:40,470
ماذا؟ ولكنّه مجرّد طحين

303
00:19:41,560 --> 00:19:44,030
إنّه ليس طحيناً عاديّاً

304
00:19:44,030 --> 00:19:47,490
هذا طحين حلويّات ذو ثلاث نجوم
إنّه فريد من نوعه لدرجة أنه لا يخرج من المتجر

305
00:19:47,930 --> 00:19:50,960
كذبتَ مرّتين

306
00:19:54,260 --> 00:19:55,750
إنّه هجوم

307
00:20:00,340 --> 00:20:01,180
تبّاً

308
00:20:01,460 --> 00:20:04,430
أخرجه من الباب الخلفيّ يا تيتسو

309
00:20:04,900 --> 00:20:07,110
ابقي هنا يا يون

310
00:20:11,210 --> 00:20:13,310
عُد لتناول الكعك في وقت لاحق

311
00:20:22,640 --> 00:20:24,710
غادر بينما الفرصة سانحة

312
00:20:24,710 --> 00:20:26,100
ياما جوغو

313
00:20:26,600 --> 00:20:27,660
ما هذا؟

314
00:20:27,960 --> 00:20:29,500
إنّه اسمي

315
00:20:29,500 --> 00:20:31,370
بلّغ تحيّاتي للآنسة يون

316
00:20:31,910 --> 00:20:35,330
لن أفعل هذا
تنتهي تحيّاتك هنا

317
00:20:35,330 --> 00:20:37,650
أنت تملكيّ بالفعل

318
00:20:38,180 --> 00:20:39,630
إلى الّلقاء يا تيتسو-كُن

319
00:20:52,420 --> 00:20:55,370
لم أحصل على المال من ذاك العمل

320
00:20:57,050 --> 00:20:59,030
ألا تستطيع إحضاره غداً؟

321
00:20:59,030 --> 00:21:00,780
هذا مُستحيل

322
00:21:00,780 --> 00:21:02,800
"السيّدة الّتي ينادونها "الأخت

323
00:21:02,800 --> 00:21:04,890
إنّها فألٌ سيّء حقّاً

324
00:21:04,890 --> 00:21:07,040
لا أريد مقابلتها ثانيةً

325
00:21:07,930 --> 00:21:10,790
ولكن ماذا ستفعل بشأن الفاتورة؟

326
00:21:10,790 --> 00:21:12,750
سؤال جيّد

327
00:21:13,360 --> 00:21:15,560
جمعتُ كلّ النّقود الّتي أملكها

328
00:21:15,560 --> 00:21:17,690
ولكن مازال ينقصني 3000 ين

329
00:21:18,420 --> 00:21:20,960
لذا، المعذرة يا نانانا-تشان