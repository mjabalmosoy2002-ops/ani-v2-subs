1
00:00:10,050 --> 00:00:11,800
...يا للهول

2
00:00:11,800 --> 00:00:16,240
...يبدو أنّني ارتكبتُها فعلاً

3
00:00:23,490 --> 00:00:27,750
نشاهد هنا مقطعاً مُسجّلاً بكاميرا مُراقبة
قد صدر مؤخّراً

4
00:00:27,750 --> 00:00:30,000
—يُعتقَد بأنّ هذا الرجل متورط

5
00:00:32,200 --> 00:00:33,690
نجحَتْ

6
00:00:34,850 --> 00:00:39,010
أشكّ بأنّ أيّاً منّا ستكون خاتمته جيّدة

7
00:02:22,120 --> 00:02:24,170
!مـ-من أنت بالضبط؟

8
00:02:38,760 --> 00:02:40,130
!تبّاً

9
00:02:48,230 --> 00:02:49,600
—ا-اعفُ عنّي

10
00:02:56,170 --> 00:02:58,050
تبدو مسترخياً جدّاً

11
00:02:58,050 --> 00:03:00,360
من اشترى تشاومي؟

12
00:03:01,480 --> 00:03:04,330
مريض نفسي مُصاب بولَع جنسي

13
00:03:04,330 --> 00:03:06,660
يا لها من فتاةٍ مسكينة

14
00:03:06,660 --> 00:03:09,220
...تمَّ العبث بها لفترة طويلة

15
00:03:09,220 --> 00:03:11,250
!لم أسأل عن ذلك

16
00:03:11,250 --> 00:03:12,710
!أعطني اسماً

17
00:03:14,280 --> 00:03:16,490
دعني أخبرك بشيء آخر

18
00:03:16,490 --> 00:03:20,700
مرِضَتْ أمّك وتوفّيتْ قبل خمس سنوات

19
00:03:20,700 --> 00:03:23,780
كلّ الأموال التي كنتَ تواظب على إرسالها
للمنزل شهريّاً

20
00:03:23,780 --> 00:03:25,980
كانت من نصيبي أنا

21
00:03:25,980 --> 00:03:27,130
!أيّها الحقير

22
00:03:33,020 --> 00:03:35,960
لا يمكنك قتلي

23
00:03:35,960 --> 00:03:40,740
لأنّك لست قاتلاً مأجوراً محترفاً. أنت مجرّد قاتل

24
00:03:41,430 --> 00:03:46,010
هذا الرجل هو ما يدعونه بالقاتل المأجور المحترف

25
00:03:46,470 --> 00:03:47,940
!اصمت

26
00:03:50,950 --> 00:03:52,900
أثِق بتولِّيك الباقي

27
00:04:02,370 --> 00:04:03,820
لا جدوى

28
00:04:03,820 --> 00:04:06,760
السّكاكين لا تؤثّر بي

29
00:04:16,810 --> 00:04:18,940
تحمل سكّينة أخرى؟

30
00:04:18,940 --> 00:04:22,440
لكن سبقَ وقلتُ لك أنّ السّكاكين لا تؤثّر بي

31
00:04:37,460 --> 00:04:40,570
...ينبغي أن تكون قد سمعتَ بمُسدّسات السكّين

32
00:04:41,450 --> 00:04:43,650
إن كنتَ محترفاً

33
00:04:54,490 --> 00:04:55,770
...ياه

34
00:04:56,180 --> 00:04:59,170
كدتَ تموت خنقاً

35
00:04:59,590 --> 00:05:01,730
يسرّني أنني وصلتُ في الوقت

36
00:05:01,730 --> 00:05:04,400
...لم تصل

37
00:05:04,400 --> 00:05:06,770
وكيف عرفتَ مكاني؟

38
00:05:10,370 --> 00:05:14,330
جهاز تنصُّت نموذجي على شكل عنكبوت
الظهر الأحمر ومُحدِّد مواقع

39
00:05:14,330 --> 00:05:17,290
ألصقته بك عندما كنتَ نائماً

40
00:05:18,250 --> 00:05:20,530
سينتقل إلى هذا الرّجل الآن

41
00:05:22,590 --> 00:05:23,890
حسناً، لننسحب من هنا

42
00:05:25,800 --> 00:05:28,050
لا تتباطأ

43
00:05:28,530 --> 00:05:29,850
أتريدني أن أحملك على ظهري؟

44
00:05:29,850 --> 00:05:32,260
اخرس. لا ضرورة لذلك

45
00:05:35,860 --> 00:05:37,640
لماذا تساعدني؟

46
00:05:38,600 --> 00:05:40,730
جماعة هاكاتا فضوليّون

47
00:05:49,090 --> 00:05:50,320
لا تبكِ

48
00:05:51,880 --> 00:05:53,430
أنا لا أبكي

49
00:05:57,430 --> 00:05:59,820
،إذاً استيقظتَ في غرفة فندق

50
00:05:59,820 --> 00:06:02,840
فوجدتَ امرأة غريبةً لا تعرفها ميّتة بجانبك

51
00:06:02,840 --> 00:06:03,860
أجل

52
00:06:04,600 --> 00:06:08,610
بالكاد أتذكّر أنّني تلقّيتُ دعوةً بواسطة
،سيّدة حسناء

53
00:06:08,610 --> 00:06:12,300
لكن لم تكن هي نفس الفتاة الميّتة
وكانت أصغر سنّاً

54
00:06:12,300 --> 00:06:14,450
نُصِبَتْ مكيدة لك؟

55
00:06:14,450 --> 00:06:15,220
ماذا؟

56
00:06:15,730 --> 00:06:19,140
أحدهم قد ألبسك تهمة القتل

57
00:06:19,140 --> 00:06:21,770
لا بدّ وأنّ المرأة التي استدعتك كانت متواطئة

58
00:06:21,770 --> 00:06:23,240
...اللّعنة

59
00:06:23,830 --> 00:06:26,990
عرفتُ أنّني ما كان ينبغي أن آتي
إلى هذه المدينة

60
00:06:26,990 --> 00:06:29,990
كان ينبغي أن أستقيل من عملي حقّاً

61
00:06:29,990 --> 00:06:33,130
كنتُ أتساءل حول ذلك أيضاً

62
00:06:33,130 --> 00:06:36,540
لماذا يعمل شخصٌ مثلك لحساب شركة القتل؟

63
00:06:37,480 --> 00:06:38,710
...في الواقع

64
00:06:39,720 --> 00:06:43,380
كدتُ أقتل شخصاً ذات يوم

65
00:06:56,150 --> 00:06:58,850
...كانت مُجرّد كرة بيسبول مُصوّبة نحو الرأس

66
00:06:59,540 --> 00:07:05,960
نجا اللّاعب، لكن في ذلك الوقت، حسبتُ
أنّني قتلتُه

67
00:07:07,030 --> 00:07:11,490
في مقابلتي حول عملي الرّاهن، تكلّمتُ عمّا حدث

68
00:07:11,970 --> 00:07:13,970
ولسببٍ ما، استأجروني

69
00:07:14,410 --> 00:07:15,880
هكذا إذاً

70
00:07:15,880 --> 00:07:20,080
ربّما بالغوا في تقييمِ أهمّية تجربتك
التي كدت فيها أن تقتل أحدهم

71
00:07:20,080 --> 00:07:23,880
لم أعد أستطيع رمي حتّى كرة واحدة
نحو أحد منذ ذلك الحين

72
00:07:24,420 --> 00:07:27,370
...من المستحيل أن أقتل أحداً بداعي العمل

73
00:07:28,730 --> 00:07:31,820
على ذكرِ ذلك، أنتم تتلقّون أعمالاً أيضاً، صحيح؟

74
00:07:31,820 --> 00:07:33,050
للثأر للناس؟

75
00:07:33,050 --> 00:07:34,050
أجل

76
00:07:34,050 --> 00:07:35,830
!إذاً انتقموا لأجلي

77
00:07:35,830 --> 00:07:36,510
ماذا؟

78
00:07:36,510 --> 00:07:40,980
!أرجوكم أوقعوا الشّخص الذي أوقعني في مكيدة

79
00:07:43,940 --> 00:07:46,870
يوافق الثّائر على العمل

80
00:07:49,610 --> 00:07:51,610
خاب أملي تماماً

81
00:07:51,610 --> 00:07:56,070
يبدو أنّ هذا القاتل المأجور لم يكن
رفيع المستوى

82
00:07:57,250 --> 00:07:58,280
!زانغ-سان

83
00:07:59,060 --> 00:08:00,180
!انظر

84
00:08:00,760 --> 00:08:02,750
لقد حظي بمُساعدة إذاً

85
00:08:02,750 --> 00:08:04,180
سأقتلهما معاً

86
00:08:04,180 --> 00:08:07,350
سأستأجر أفضل قاتل مأجور في هاكاتا

87
00:08:07,350 --> 00:08:10,330
هل يمكنك أن تدعنا نتكفّل بالعمل؟

88
00:08:10,740 --> 00:08:13,470
لن ندع هذا الفاشل يستمر

89
00:08:13,890 --> 00:08:16,650
...صحيح أنّه كلما زاد عدد العاملين خفّ الحمل

90
00:08:16,650 --> 00:08:20,390
لكن عملكم هو القبض عليهما حيّين

91
00:08:20,710 --> 00:08:22,850
سنكون نحن من نقتلهما

92
00:08:24,820 --> 00:08:26,360
عُلِم

93
00:08:40,370 --> 00:08:43,140
استيقظتَ إذاً

94
00:08:43,570 --> 00:08:45,050
هل أنتَ جائع؟

95
00:08:45,050 --> 00:08:47,030
أتريد رامن تونكوتسو؟

96
00:08:47,560 --> 00:08:49,720
وضعت لي الضمادات؟

97
00:08:49,720 --> 00:08:51,850
طلبتُ من طبيب أعرفه

98
00:08:53,010 --> 00:08:54,820
ينبغي أن تهوّن على نفسِك لبعض الوقت

99
00:08:57,370 --> 00:08:58,830
أستذهب إلى مكانٍ ما؟

100
00:08:58,830 --> 00:09:00,260
بالطبع

101
00:09:00,260 --> 00:09:04,170
سأقتل الشّخصَ الذي قتل أختي الصّغيرة

102
00:09:04,660 --> 00:09:07,100
أتعرف من كان؟

103
00:09:07,610 --> 00:09:09,700
ينبغي لهذا أن يمنحني بعض الأدلّة

104
00:09:09,700 --> 00:09:13,610
وتعتقد أنّك تستطيع فعل كلّ ذلك بمفردك؟

105
00:09:15,430 --> 00:09:18,760
،تتصرّف وكأنّك تستطيع فعل أي شيء لوحدِك

106
00:09:19,290 --> 00:09:21,750
لكن لا يستطيع النّاس النجاة لوحدِهم

107
00:09:22,200 --> 00:09:25,930
أخبرتُك هذا الصّباح أنّني سأساعدك، أليس كذلك؟

108
00:09:25,930 --> 00:09:28,690
...إذاً جِد الشّخصَ المسؤول

109
00:09:29,270 --> 00:09:31,590
!جِد المريض النفسي الذي قتلَ أختي

110
00:09:34,550 --> 00:09:36,110
أترى؟

111
00:09:36,110 --> 00:09:37,920
لا تجيد سوى الكلام

112
00:09:37,920 --> 00:09:39,700
بيوض سمك البلوق الحار تفي بالغرض

113
00:09:40,260 --> 00:09:42,600
سأقبل بالعمل

114
00:09:42,600 --> 00:09:45,530
المقابل هو بيوض سمك البلوق
الحارّ لخمس سنوات

115
00:09:49,450 --> 00:09:51,590
...موناكاتا-سان

116
00:09:51,590 --> 00:09:54,030
متى سأحصل على فتاةٍ جديدة؟

117
00:09:54,030 --> 00:09:55,370
أنا مشغول

118
00:09:55,370 --> 00:09:56,430
اطلب منّي لاحقاً

119
00:09:56,430 --> 00:09:58,740
...ماذا؟ لكن

120
00:09:59,130 --> 00:10:02,910
سنتّصل بالوسيط ونشتري فتاةً أخرى

121
00:10:02,910 --> 00:10:06,020
انتظر بهدوء، اتفقنا؟

122
00:10:06,930 --> 00:10:08,150
!ذلك الابن الغبيّ

123
00:10:08,750 --> 00:10:10,630
ألا يمكنه أن يكبح جماح نفسه لبعض الوقت؟

124
00:10:12,370 --> 00:10:15,450
لا تصبِح هكذا إلّا عندما تلوم نفسك

125
00:10:16,970 --> 00:10:20,610
أتعتقد أنّ موت إيفانوف كان غلطتك؟

126
00:10:22,950 --> 00:10:26,770
يبدو ذلك القاتل المأجور لين أبرع ممّا توقّعنا

127
00:10:27,380 --> 00:10:30,670
أتساءل ما إن كان السّاموراي
نيواكا الذي تروي عنه الإشاعات

128
00:10:30,670 --> 00:10:32,030
هذا غير وارد

129
00:10:32,730 --> 00:10:35,910
مُحال أن يستخدم السّاموراي نيواكا مسدّساً

130
00:10:38,850 --> 00:10:41,170
رأيتُه مرّة

131
00:10:42,500 --> 00:10:43,860
السّاموراي نيواكا

132
00:11:06,850 --> 00:11:08,170
...إذاً عينك

133
00:11:08,600 --> 00:11:10,660
لم أستطع أن أحرك ساكناً

134
00:11:11,160 --> 00:11:14,060
نيّته لقتلي قد شلَّتْ حركتي

135
00:11:14,060 --> 00:11:17,060
منذ ذلك الحين وأنا أخشى الموت

136
00:11:17,590 --> 00:11:22,260
توظّفتُ لدى المُحافِظ لأنني ارتأيتُ أنه سيكون
منصباً أقلّ خطورة

137
00:11:23,170 --> 00:11:24,430
هل تكرهينني؟

138
00:11:25,570 --> 00:11:26,710
بالطبع لا

139
00:11:27,580 --> 00:11:31,050
أريد من السّاموراي نيواكا أن يؤدّي عملاً لأجلي

140
00:11:31,050 --> 00:11:34,500
سمعتُ أنّك تستطيع التّواصل معه

141
00:11:35,040 --> 00:11:37,690
أجل، أستطيع بالفعل

142
00:11:37,690 --> 00:11:41,620
لكنّه يطلب مبلغاً ضخماً وهو نيّقٌ جدّاً

143
00:11:41,620 --> 00:11:43,430
أما زلتَ تريدني أن أطلب منه مع ذلك؟

144
00:11:43,430 --> 00:11:45,930
يتعلّق هذا الأمر بسمعةِ منظّمتنا

145
00:11:45,930 --> 00:11:47,970
لن ندّخر مالاً لأجل ذلك

146
00:11:47,970 --> 00:11:49,930
هكذا إذاً

147
00:11:50,310 --> 00:11:52,940
ومن هو الهدف؟

148
00:11:53,590 --> 00:11:56,690
هذا هو متّهمنا الأساسي، إيتو تاكويا

149
00:11:57,290 --> 00:12:00,760
كان يقضي أجمل أوقات حياته في اللّيلة الماضية

150
00:12:00,760 --> 00:12:04,660
تنقّل بين حانة حضن النّساء إلى ملاهٍ ليليّة
وحانات تعرّي في ناكاسو طوال اللّيل

151
00:12:04,660 --> 00:12:06,700
ما المقصود بحانة حضن النساء؟

152
00:12:06,700 --> 00:12:08,570
مكان تستطيع فيه أن تلمس أثداء النساء

153
00:12:08,570 --> 00:12:09,750
والملهى اللّيلي؟

154
00:12:10,180 --> 00:12:11,960
مكان تستطيع فيه أن تلمس أثداء النساء

155
00:12:11,960 --> 00:12:13,060
والتعرّي؟

156
00:12:13,530 --> 00:12:15,290
مكان تستطيع فيه أن تلمس أثداء النساء

157
00:12:15,290 --> 00:12:16,630
كلّها متشابهة إذاً

158
00:12:16,630 --> 00:12:19,200
حسناً، الذهاب إلى هذه الأماكن
بحدِّ ذاته ليس جريمة

159
00:12:19,200 --> 00:12:22,590
المشكلة هي ما فعلَه بعد الذهاب إلى فندق

160
00:12:23,130 --> 00:12:24,800
هذا غريبٌ حقّاً

161
00:12:25,400 --> 00:12:28,380
،وقعَتْ حالتان سابقتان متشابِهتان

162
00:12:28,380 --> 00:12:31,320
لكن في كلتيهما، رُميَتْ الجثّة في مكانٍ ما

163
00:12:31,320 --> 00:12:33,640
هذه أوّل مرّة تُترَك فيها الجثّة في فندق

164
00:12:33,640 --> 00:12:38,550
إضافة إلى أنّ هذا الرجل انتقل مؤخّراً
إلى هنا، فوكوكا، بحكمِ عمله

165
00:12:38,970 --> 00:12:41,860
عندما وقعت جريمتا القتلِ السّابقتان، كان
ما يزال في طوكيو

166
00:12:41,860 --> 00:12:43,110
...إذاً

167
00:12:43,670 --> 00:12:46,090
ربّما تمّ إيقاعه في مكيدة

168
00:12:46,550 --> 00:12:48,000
...بانبا

169
00:12:48,960 --> 00:12:50,100
...إذاً

170
00:12:50,760 --> 00:12:52,340
...هل هذه الفتاة

171
00:12:52,340 --> 00:12:54,620
هي حبيبتك الجديدة أو ما شابه؟

172
00:12:54,620 --> 00:12:56,410
لا

173
00:12:56,410 --> 00:12:57,650
أنا رجل

174
00:12:58,250 --> 00:12:59,040
رجل؟

175
00:12:59,040 --> 00:13:00,550
لديك هذا الميول؟

176
00:13:00,550 --> 00:13:01,910
—هذا ليس

177
00:13:01,910 --> 00:13:03,000
...مؤلم

178
00:13:04,420 --> 00:13:07,030
أرأيت؟ قلتُ لك عليك أن تهوّن على نفسك

179
00:13:07,030 --> 00:13:09,190
!يجب أن تخبره بأنّه مخطئ أيضاً

180
00:13:09,190 --> 00:13:11,350
من الواضح أنّه يعلم ذلك

181
00:13:11,960 --> 00:13:14,660
شيغيماتسو-سان يسخر منك فحسب

182
00:13:16,120 --> 00:13:18,870
أنت لين شيانمينغ إذاً؟

183
00:13:19,460 --> 00:13:21,070
حدثَتْ أمور كثيرة معك

184
00:13:21,070 --> 00:13:23,570
ما قصّة الجميع يدخلون ويخرجون من هنا؟

185
00:13:23,570 --> 00:13:26,320
من صاحب رأس الفطر هذا؟

186
00:13:26,320 --> 00:13:30,360
أينوكيدا-كن، مُخبِر موثوق جدّاً

187
00:13:31,130 --> 00:13:33,540
شكراً لمجيئك إلى هنا

188
00:13:33,540 --> 00:13:35,650
حسناً، لا بأس بين الفيّنة والأخرى

189
00:13:35,650 --> 00:13:37,750
خذ، يمكنك استعادته

190
00:13:38,930 --> 00:13:40,210
هل حصلت على أي شيء مفيد منه؟

191
00:13:41,380 --> 00:13:45,920
غصتُ فيه بعمق، لكن لم أستفد منه كثيراً

192
00:13:47,860 --> 00:13:49,720
لا تشعر بالخيبة إلى هذه الدرجة

193
00:13:51,380 --> 00:13:54,100
مُحال أن أخرج خالي الوفاض بالطبع

194
00:13:56,280 --> 00:13:58,650
إليك المقطع المُسجَّل بكاميرا المُراقبة
في مسرحِ الجريمة

195
00:13:59,380 --> 00:14:02,960
كانت هذه الكاميرا مُعطّلة بحسبِ المزاعم
،لهذا لم تتوصّل الشرطة لهذا المقطع

196
00:14:02,960 --> 00:14:06,240
لكن كانت ما تزال موجودة
في خادمات الفندق لسببٍ ما

197
00:14:06,820 --> 00:14:09,950
أولاً، هذا مقطع من ثلاث ساعات تسبق جريمة القتل

198
00:14:10,500 --> 00:14:13,790
هذه هي المرأة التي وصلَتْ إلى الفندق
برفقةِ إيتو تاكويا

199
00:14:13,790 --> 00:14:15,030
...هذا

200
00:14:15,030 --> 00:14:18,210
أجل، القاتلة المأجورة لدى المُحافظ، ريكو-سان

201
00:14:19,050 --> 00:14:22,970
ثمّ بعد نصف ساعة، يأتي شخص آخر
مألوف بالنسبةِ إلينا

202
00:14:23,890 --> 00:14:24,960
!هذا الرّجل

203
00:14:24,960 --> 00:14:27,760
يحمل حقيبةً كبيرة

204
00:14:27,760 --> 00:14:30,340
كما لو أنّه ينقل شخصاً بداخلها

205
00:14:31,560 --> 00:14:33,670
...إذاً كانت تشاومي في الدّاخل

206
00:14:34,310 --> 00:14:36,730
قلتَ أنّ تلك المرأة تعمل لحسابِ المُحافظ؟

207
00:14:36,730 --> 00:14:38,350
...معنى هذا أنّ الشخص المسؤول عن هذا

208
00:14:38,350 --> 00:14:40,610
حسناً، دعنا لا نستبق الأحداث

209
00:14:41,050 --> 00:14:44,550
فيما يلي، أريد أن أسمعك محادثة مُسجَّلة

210
00:14:44,550 --> 00:14:47,780
بواسطةِ جهاز تنصُّت العنكبوت الذي وضعه
بانبا-سان على جثّةِ العملاق

211
00:14:49,010 --> 00:14:51,130
...موناكاتا-سان

212
00:14:51,130 --> 00:14:53,760
متى سأحصل على فتاةٍ جديدة؟

213
00:14:53,760 --> 00:14:54,950
أنا مشغول

214
00:14:54,950 --> 00:14:55,930
اطلب منّي لاحقاً

215
00:14:55,930 --> 00:14:58,710
...ماذا؟ لكن

216
00:14:58,710 --> 00:15:02,490
سنتّصل بالوسيط ونشتري فتاةً أخرى

217
00:15:02,490 --> 00:15:05,650
كن مهذّباً واهدأ فحسب، اتفقنا؟

218
00:15:07,050 --> 00:15:09,560
لدى المُحافظ ابن واحد

219
00:15:09,560 --> 00:15:12,340
اسمه هارادا يوسكي، تلميذ في الكلّية

220
00:15:12,830 --> 00:15:16,730
،لديه ماضٍ مريب، ويمارس مختلف أنواع الجرائم

221
00:15:16,730 --> 00:15:18,810
لكن لم تظهر أي منها للعلَن

222
00:15:18,810 --> 00:15:21,670
إذاً كان المُحافِظ يغطِّي على كلّ تلك الجرائم

223
00:15:21,670 --> 00:15:23,270
...معنى هذا

224
00:15:23,750 --> 00:15:28,740
ما يعني أنّ هذا البغيض المدعو هارادا يوسكي
هو من قتل أختي الصّغيرة

225
00:15:32,150 --> 00:15:34,490
،متأكّد أنّني أستطيع التحرّي عنه

226
00:15:34,490 --> 00:15:36,570
،لكن متأكّد أيضاً أنّهم اتّخذوا إجراءات أمنيّة

227
00:15:36,570 --> 00:15:38,410
ناهيك عن القتلةِ المأجورين

228
00:15:38,410 --> 00:15:40,600
قد يكون من الصّعب مُداهمة المكان

229
00:15:40,600 --> 00:15:41,990
لديّ فكرة

230
00:15:42,620 --> 00:15:45,890
قالوا أنّهم كانوا على وشك شراء فتاة أخرى، صحيح؟

231
00:15:45,890 --> 00:15:48,090
سأصبح تلك الفتاة

232
00:15:49,050 --> 00:15:52,950
لكن تحتاج هذه الخطّة لشخصٍ يلعب دور الوسيط

233
00:15:52,950 --> 00:15:55,510
بانبا، هل يمكنك المساعدة؟

234
00:15:58,840 --> 00:16:00,480
وكيف لي أن أرفض؟

235
00:16:01,110 --> 00:16:04,550
أينوكيدا-كن، أيمكنك أن تتحرّى عن زمان ومكان
عمليّة التبادل؟

236
00:16:04,550 --> 00:16:05,940
عُلِم

237
00:16:06,360 --> 00:16:08,980
...وأيضاً

238
00:16:14,390 --> 00:16:15,870
يا عمّ

239
00:16:15,870 --> 00:16:18,680
ما هو العمل الهامّ الذي أردتَ مناقشته؟

240
00:16:19,210 --> 00:16:21,580
ثمّة أمور عليّ القيام بها

241
00:16:21,580 --> 00:16:24,710
هل للأمر علاقة برابطةِ كاكيو؟

242
00:16:27,300 --> 00:16:30,240
تلقّيتُ للتو اتّصالاً منهم بشأن عمل

243
00:16:30,240 --> 00:16:36,470
لديهما هدفان. أحدهما هو قاتل مأجور
كان يعمل لصالحهم يُدعى لين شيانمينغ

244
00:16:36,470 --> 00:16:41,660
والآخر مُخبِر قد تحالفَ معه يُدعى بانبا زينجي

245
00:16:41,660 --> 00:16:42,960
هذا سيّئ

246
00:16:42,960 --> 00:16:44,680
وهذا ليس كلّ شيء

247
00:16:44,680 --> 00:16:50,680
:طلبوا من رجُلي المُفضَّل أن يؤدّي العمل
السّاموراي نيواكا

248
00:16:51,810 --> 00:16:54,490
لا أريدك أن تموت

249
00:16:54,490 --> 00:16:57,820
لكن من واجبي أن أكمل أي عمل أقبلُ بأدائه

250
00:16:58,310 --> 00:17:03,810
بانبا، هل يمكنني أن أعرّف السّاموراي نيواكا
على رابطةِ كاكيو؟

251
00:17:03,810 --> 00:17:06,460
بالتأكيد، افعل ذلك

252
00:17:06,460 --> 00:17:07,830
هل أنت متأكِّد؟

253
00:17:07,830 --> 00:17:10,310
أنت هو الهدف

254
00:17:10,310 --> 00:17:11,810
ماذا ستفعل؟

255
00:17:15,000 --> 00:17:17,320
قد أتظاهر بأنّني ميّت

256
00:17:25,700 --> 00:17:26,660
لا تتحرّك

257
00:17:27,080 --> 00:17:28,770
لندردش قليلاً

258
00:17:30,730 --> 00:17:33,110
!مؤلم

259
00:17:33,110 --> 00:17:35,300
لا تكن قاسياً كثيراً

260
00:17:35,300 --> 00:17:37,700
أليس من الواضح أنّني لستُ شخصاً
مفتول العضلات؟

261
00:17:37,700 --> 00:17:41,300
ما يحدث تالياً يعتمد على أقوالك

262
00:17:41,300 --> 00:17:44,870
أنا متأكّدة أنّ لديك فكرة ما عن سببِ
تعاملنا معك بهذه الطريقة

263
00:17:44,870 --> 00:17:47,380
...لنرَ

264
00:17:47,380 --> 00:17:50,680
شغّلتُ الهاتفَ الذكيّ الذي ينتمي لإيفانوف هنا

265
00:17:50,680 --> 00:17:53,300
لذا تمكّنتُما من إيجاد مقهى الإنترنت هذا
باستخدام نظام تحديد المواقع في الهاتف

266
00:17:53,300 --> 00:17:56,160
ثمّ استخدمتُما مقطع كاميرا المُراقبة
في المقهى للاكتشاف

267
00:17:56,160 --> 00:17:58,300
بأنّني كنتُ مُخبِر بانبا-سان

268
00:17:58,300 --> 00:17:59,050
هل كلامي صحيح؟

269
00:18:00,420 --> 00:18:02,410
،بما أنّك اخترت مسار العمل هذا

270
00:18:02,410 --> 00:18:05,020
فينبغي أن تحاول ارتداء شيء
يصعب ملاحظتك به بين الناس

271
00:18:05,460 --> 00:18:10,360
أتعلمان لماذا يمتلك عنكبوت الظهر الأحمر
ظهراً أحمر؟

272
00:18:10,750 --> 00:18:15,060
لولم يكن شكله فاضحاً لاستطاع
قتل أناس أكثر

273
00:18:15,720 --> 00:18:17,470
لكنّه فاضِح، أليس كذلك؟

274
00:18:17,470 --> 00:18:20,530
...عندما فكّرتُ في السّبب، قرّرت

275
00:18:20,530 --> 00:18:23,910
!بأنّ السّبب هو أنّه يبدو أروع هكذا

276
00:18:23,910 --> 00:18:26,040
روك، أليس كذلك؟

277
00:18:26,040 --> 00:18:27,480
اخرس

278
00:18:27,480 --> 00:18:30,010
أخبرنا أين بانبا

279
00:18:30,010 --> 00:18:31,920
لا حاجة لذلك

280
00:18:31,920 --> 00:18:34,280
سيأتي قريباً من تلقاء نفسه

281
00:18:34,280 --> 00:18:35,450
ماذا تعني؟

282
00:18:37,010 --> 00:18:41,470
يبيع المُخبِرون المعلومات لتأمين قوت يومهم

283
00:18:42,010 --> 00:18:44,560
هل تعي من لديه اليد الطولى هنا؟

284
00:18:46,310 --> 00:18:47,970
حسناً، سأصنع لك معروفاً

285
00:18:48,680 --> 00:18:53,270
يريد لين شيانمينغ أن يُدفِع ابن المحافظ
الثّمن على قتله أخته الصغيرة

286
00:18:53,270 --> 00:18:54,670
أخته؟

287
00:18:54,670 --> 00:18:57,560
ينوي بانبا زينجي مساعدته

288
00:18:58,100 --> 00:19:00,820
لهذا قلتَ أنّه سيأتي من تلقاء نفسه

289
00:19:01,330 --> 00:19:03,240
لماذا يستهدفونه؟

290
00:19:04,330 --> 00:19:05,440
...هذا

291
00:19:06,360 --> 00:19:08,960
عائد لكم

292
00:19:09,510 --> 00:19:11,040
دكتور سايكي، هل أنت هنا؟

293
00:19:11,690 --> 00:19:12,990
بانبا-سان

294
00:19:12,990 --> 00:19:15,040
ليس من عادتك أن تأتي مرّتين في يوم واحد

295
00:19:15,420 --> 00:19:17,710
شكراً على المساعدة قبل قليل يا دكتور

296
00:19:17,710 --> 00:19:22,730
أنت الوحيد الذي أحضر ضحيّة سكّين
إلى عيادة جراحة تجميليّة

297
00:19:23,170 --> 00:19:24,480
—حسناً، ما الأمر هذه المرّة

298
00:19:24,480 --> 00:19:25,850
بانبا-تشان

299
00:19:25,850 --> 00:19:29,260
جيرو-يان، ما الأمر؟

300
00:19:29,260 --> 00:19:32,600
يا إلهي! وهل تأتي امرأةٌ بالغة
إلى هنا لسببٍ آخر؟

301
00:19:32,600 --> 00:19:33,760
—أريد أن أكون جميلـ

302
00:19:33,760 --> 00:19:36,890
أتى جيرو إلى هنا لرمي جثّة. في مستودع الجثث

303
00:19:36,890 --> 00:19:38,860
لا تكن قاسياً يا دكتور

304
00:19:39,620 --> 00:19:41,740
وما شكل هذه الجثّة؟

305
00:19:43,240 --> 00:19:45,030
ما شكلها؟

306
00:19:45,560 --> 00:19:47,080
ها هي ذي

307
00:19:48,930 --> 00:19:50,950
...بانبا-تشان

308
00:19:50,950 --> 00:19:54,460
هل يمكنني محادثتك بشأن عمل انتقامي
قبلتُه اليوم؟

309
00:19:54,460 --> 00:19:57,090
نعم، بالتأكيد

310
00:19:59,000 --> 00:20:00,150
ما الأخبار؟

311
00:20:00,150 --> 00:20:02,300
هل اكتشفت متى ستجري عمليّة التبادُل؟

312
00:20:07,430 --> 00:20:10,600
أنت فائق الجمال. أنيق للغاية

313
00:20:10,600 --> 00:20:11,460
أليس كذلك؟

314
00:20:11,910 --> 00:20:13,390
هذا أفضل ما لديّ

315
00:20:13,770 --> 00:20:15,280
ماذا عنّي؟

316
00:20:15,280 --> 00:20:16,580
هل أبدو كعضو عصابة؟

317
00:20:16,580 --> 00:20:18,770
أقرب إلى مُضيف بلا شعبيّة بين الفتيات

318
00:20:18,770 --> 00:20:20,070
هذا قاسٍ

319
00:20:20,070 --> 00:20:21,650
لنسرع

320
00:20:21,650 --> 00:20:23,210
الوقت يُداهمنا

321
00:20:24,230 --> 00:20:27,030
هل أنت متأكّدٌ أنّك لا تريد إعادة
النظر في هذه الاستراتيجيّة؟

322
00:20:27,370 --> 00:20:29,380
إنّها محفوفة بالمخاطر

323
00:20:29,380 --> 00:20:31,240
،حتّى لو تمكّنتَ من قتل الابن

324
00:20:31,240 --> 00:20:33,290
لن تفلت بدون عواقب

325
00:20:33,290 --> 00:20:36,140
كلّ ما يهمّني هو قتل ذلك الرّجل

326
00:20:36,140 --> 00:20:38,820
ولو على جثّتي، لا مانع لديّ

327
00:20:40,050 --> 00:20:42,940
لا تقل كلاماً محزناً

328
00:20:42,940 --> 00:20:45,520
لنفكّر بخطّةَ هروب أيضاً

329
00:20:45,520 --> 00:20:46,760
اغرب عن وجهي

330
00:20:49,080 --> 00:20:50,270
حِلية حظّ سعيد

331
00:20:50,710 --> 00:20:52,590
اتّصل بي متى احتجت لشيء

332
00:20:52,590 --> 00:20:54,230
سآتيك مسرعاً

333
00:20:56,230 --> 00:20:57,690
شكراً

334
00:21:07,730 --> 00:21:10,290
إذاً البضاعة الموعودة في الدّاخل؟

335
00:21:10,290 --> 00:21:11,780
أجل

336
00:21:11,780 --> 00:21:13,000
أتريد تفتيش المحتويات؟

337
00:21:13,890 --> 00:21:14,980
هنا؟

338
00:21:16,040 --> 00:21:17,460
لا أعتقد أنّ هذا ضروري

339
00:21:18,200 --> 00:21:19,140
...حسناً إذاً

340
00:21:20,890 --> 00:21:22,170
اكتملَتْ صفقتُنا

341
00:21:29,850 --> 00:21:33,060
آسف يا لين-كن

342
00:21:33,060 --> 00:21:34,890
لكن حظّاً سعيداً

343
00:22:34,910 --> 00:22:36,840
تمَّ خيانتك

344
00:22:36,840 --> 00:22:38,060
وجدتُك أيّها الحقير

345
00:22:38,060 --> 00:22:40,500
قد تكون هذه أوّل مرّة يفشل فيها
السّاموراي نيواكا

346
00:22:40,500 --> 00:22:42,750
مرحباً! أنا الثّائر

347
00:22:42,750 --> 00:22:44,280
قاتل القتلة المأجورين

348
00:22:44,280 --> 00:22:46,750
!حسناً! لنقم بهذا

349
00:23:13,730 --> 00:23:15,440
وصلنا بهذه السرعة؟

350
00:23:15,440 --> 00:23:17,960
لقد سلّمتُ البضاعة كما هو موعود

351
00:23:17,960 --> 00:23:20,580
افعل ما تشاء

352
00:23:30,450 --> 00:23:34,040
لقد التقينا ببعضنا الآخر كثيراً
اليوم، أليس كذلك يا لين؟