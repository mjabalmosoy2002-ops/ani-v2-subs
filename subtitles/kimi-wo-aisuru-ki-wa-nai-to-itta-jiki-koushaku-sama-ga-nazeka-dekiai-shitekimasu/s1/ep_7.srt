1
00:00:07,330 --> 00:00:08,410
"!النّجدة"

2
00:00:08,410 --> 00:00:12,620
الضّغط من عائلة روياس الدّوقيّة"
"!ستُدمِّر عائلتي النّبيلة

3
00:00:17,240 --> 00:00:19,930
جارمو-ساما، ماذا سنفعل؟

4
00:00:20,940 --> 00:00:22,630
لا شيء

5
00:00:27,640 --> 00:00:30,690
الفيكونت هيلكو، ما بين أخطائه
،وإدمانه على الكحول

6
00:00:30,690 --> 00:00:32,900
كان غالباً مُقدّراً له أن يهوي على أيّ حال

7
00:00:33,920 --> 00:00:38,190
إن كان الأمر كذلك، تقديمه النّفع
قبل مُغادرته المسرح

8
00:00:38,190 --> 00:00:40,390
يُلائمه أكثر في النّهاية، ألا تعتقد ذلك؟

9
00:00:43,970 --> 00:00:45,400
يا إلهي

10
00:00:49,890 --> 00:00:54,410
!يوليوس-ساما... يوليوس-ساما ذاك

11
00:00:57,240 --> 00:01:01,230
مهلاً، توقّفي عن ذلك. هل تنوين
ملء المنزل بأكمله بالرّيش؟

12
00:01:03,410 --> 00:01:04,660
...أخي العزيز

13
00:01:05,540 --> 00:01:07,550
هل أنا جميلة؟

14
00:01:08,570 --> 00:01:11,590
أجل، أنتِ كملاك

15
00:01:15,460 --> 00:01:17,180
!أعي ذلك تماماً

16
00:01:18,540 --> 00:01:21,190
...لكن، يوليوس-ساما

17
00:01:22,270 --> 00:01:25,600
قال بأنّ إيلسا-ساما أهمّ بالنّسبة له

18
00:01:29,220 --> 00:01:31,950
!كم هذا مأساويّ

19
00:01:32,570 --> 00:01:36,300
سيرافينا، أنتِ أجمل بكثير
من أيّ جوهرة

20
00:01:36,300 --> 00:01:38,950
لا أُصدِّق بأنّه لم يستطع رؤية جاذبيّتكِ

21
00:01:41,090 --> 00:01:43,470
!أخي

22
00:01:45,980 --> 00:01:49,580
!يوليوس-ساما أعمى تماماً

23
00:01:51,300 --> 00:01:53,030
!لن أُسامحه أبداً

24
00:01:53,770 --> 00:01:56,840
لطّخَ علاقته مع سيرافينا

25
00:01:56,840 --> 00:02:00,470
لكن ينبغي أن تكون العلاقة ما زالت
ذات قيمة بالنّسبة ليوليوس

26
00:02:01,700 --> 00:02:05,230
كان ظهورها غير مُتوقَّع حقّاً

27
00:03:39,460 --> 00:03:41,950
كان ذلك إنجازاً حقيقيّاً يا يوليوس

28
00:03:42,260 --> 00:03:47,500
تزوير نقاء المعادن الخامة فضيحة
كبيرة تمسُّ الثِّقة بالنّسبة لمملكتنا

29
00:03:47,500 --> 00:03:50,500
ومنعتَ ذلك بأقلّ الأضرار

30
00:03:52,890 --> 00:03:57,330
رغم ذلك، دائماً ما تتّخذ إجراءات وراء
الكواليس عندما تُدمِّر الأشياء

31
00:03:57,330 --> 00:04:00,510
نادراً ما تتّخذ إجراء في الواجهة

32
00:04:00,510 --> 00:04:05,520
حسناً، كانت الطّريقة الوحيدة بما أنّني
كنتُ أتعامل مع نبيل أحمق

33
00:04:06,840 --> 00:04:10,510
وأحسنت صنعاً في جهود التحرِّي
الأُخرى الّتي بذلتَها

34
00:04:10,510 --> 00:04:13,520
كرِّس نفسك للعمل داخل القلعة
لبعض الوقت، اتّفقنا؟

35
00:04:13,950 --> 00:04:15,360
عُلِم

36
00:04:18,940 --> 00:04:21,160
،بالتّفكير في الأمر الآن

37
00:04:21,160 --> 00:04:24,540
حضرتَ ذلك الحفل السّاهر قبل
أيّام مع زوجتك، أليس كذلك؟

38
00:04:24,540 --> 00:04:26,520
—هل من تقارير حول التقدُّم في ذلك

39
00:04:26,520 --> 00:04:27,860
أستأذن بالانصراف

40
00:04:30,870 --> 00:04:33,110
بحسب تصرّفه، من المُؤكَّد أنَّ شيئاً قد حدث

41
00:04:37,840 --> 00:04:40,310
،مع اقتراب نهاية العام

42
00:04:40,310 --> 00:04:44,050
سنبدأ بالتّحضير لأعمال مكتبيّة
وفعاليّات كثيرة

43
00:04:46,370 --> 00:04:48,060
دائماً ما يتّخذ الأمور بطريقة هزليّة

44
00:04:51,580 --> 00:04:54,580
هانّيس، خبزتُ بعض البسكويت

45
00:04:56,250 --> 00:04:57,760
هل تريد سكون؟

46
00:04:57,760 --> 00:05:00,270
!شكراً جزيلاً لكِ

47
00:05:00,270 --> 00:05:02,280
متى ستأخذ استراحتك المُقبلة؟

48
00:05:02,780 --> 00:05:05,580
!يوليوس-ساما

49
00:05:12,130 --> 00:05:15,090
أريدك أن تعطي هذا لأختي

50
00:05:16,700 --> 00:05:17,720
ما هذا؟

51
00:05:18,570 --> 00:05:22,090
إنّه كتابٌ اخترتُه لعيد ميلادها

52
00:05:23,490 --> 00:05:26,010
هل عيد ميلاد إيلسا قريب؟

53
00:05:26,010 --> 00:05:30,600
توقّعت. أختي ليست من النّوع الّذي
يذكر هذه الأشياء من تلقاء نفسها

54
00:05:30,930 --> 00:05:33,700
وُلِدت في العاشر من شهر الأوركيد البيضاء

55
00:05:34,600 --> 00:05:38,170
هذا الكِتاب هو طبعة جديدة من مُؤلِّف
،تُحبّه أُختي

56
00:05:38,610 --> 00:05:41,710
لكنّها غالباً لا تشتري لنفسها
،شيئاً من باب التّسلية

57
00:05:41,710 --> 00:05:44,420
...وتوقّعتُ ألّا تطلب منك شراءه أيضاً، لذا

58
00:05:46,220 --> 00:05:50,840
بخلاف الظّاهر، تُحبّ أختي الخيال والرّومانسيّة

59
00:05:52,580 --> 00:05:55,130
عيد... ميلادها

60
00:05:56,410 --> 00:06:00,230
!زوجي، عيد ميلاد سعيد

61
00:06:00,510 --> 00:06:04,890
طوال هذا الوقت، لم أسأل
عن عيد ميلادها أبداً

62
00:06:09,330 --> 00:06:12,400
!يوليوس-ساما، أُشجِّعك

63
00:06:14,230 --> 00:06:17,490
أنت مُختلف حقّاً عن إيلسا، أليس كذلك؟

64
00:06:21,620 --> 00:06:27,000
مؤخّراً، بدا زوجي مشغولاً جدّاً

65
00:06:27,000 --> 00:06:30,700
حتّى على العشاء، كان يقرأ المُستندات

66
00:06:36,040 --> 00:06:39,030
زوجي؟ أحضرتُ لك بعض الشّاي

67
00:06:40,420 --> 00:06:41,420
تفضّلي بالدّخول

68
00:06:44,090 --> 00:06:45,430
المعذرة

69
00:06:52,370 --> 00:06:56,890
سأتركه هنا. من فضلك احرص
على أخذ استراحة جيّدة

70
00:06:57,330 --> 00:06:58,440
حسناً

71
00:07:02,310 --> 00:07:05,440
حسناً إذاً، سأخلد إلى النّوم أوّلاً

72
00:07:09,650 --> 00:07:10,800
إيلسا؟

73
00:07:13,360 --> 00:07:15,960
أنا آسف. لاحظتُ مؤخّراً فحسب

74
00:07:16,360 --> 00:07:18,960
أتيتُ فقط لإحضار الشّاي لك

75
00:07:19,500 --> 00:07:23,850
انتظري لحظة فحسب. أعطاني
هديّةً لكِ

76
00:07:25,270 --> 00:07:26,840
من هانّيس؟

77
00:07:29,480 --> 00:07:31,660
،من المُبكِّر قليلاً تقديمها لكِ

78
00:07:31,660 --> 00:07:33,970
لكن قال بأنّها كِتاب لهديّة عيد ميلادكِ

79
00:07:34,350 --> 00:07:37,470
!شكراً لك

80
00:07:39,570 --> 00:07:43,010
آمل أن تسمحي لي بالاحتفال
في اليوم الفعليّ معكِ

81
00:07:43,010 --> 00:07:43,970
ماذا؟

82
00:07:45,000 --> 00:07:49,990
،مثلما احتفلتِ بعيد ميلادي
أريد فعل شيء لأجلكِ

83
00:07:55,550 --> 00:07:59,640
!أجل، سيُسعدني هذا كثيراً
!سأتطلّع بلهفة لذلك

84
00:08:08,160 --> 00:08:11,610
إنّه الكتاب الجديد الّذي كنتُ
!أنتظر قراءته

85
00:08:13,230 --> 00:08:14,610
،بالتّفكير في الأمر الآن

86
00:08:14,610 --> 00:08:18,270
هذا هو أوّل عيد ميلاد سأقضيه
مع شخص بعيداً عن عائلتي

87
00:08:18,680 --> 00:08:22,080
آمل أن تسمحي لي بالاحتفال
في اليوم الفعليّ معكِ

88
00:08:24,290 --> 00:08:26,820
لسبب ما، نبضات قلبي تتسارع

89
00:08:33,580 --> 00:08:38,290
عيد ميلادي... يتزامن مع تفتُّح
الأوركيد البيضاء، صحيح؟

90
00:08:52,580 --> 00:08:57,310
أنا آسف يا إيلسا. عيّنوا موعدَ اجتماع
يجب عليّ حضوره قطعاً

91
00:08:57,810 --> 00:09:01,620
لا عليك! ابذل قصارى جهدك
في العمل من فضلك

92
00:09:03,740 --> 00:09:06,720
هناك مكان أرغب في أخذكِ إليه اليوم

93
00:09:06,720 --> 00:09:08,840
آمل أن تذهبي إلى هناك وتنتظرينني

94
00:09:09,740 --> 00:09:12,520
حسناً. أتطلّع قُدماً لذلك

95
00:09:13,820 --> 00:09:15,820
حسناً، سأغادر

96
00:09:16,830 --> 00:09:18,610
!بالتّوفيق

97
00:09:20,160 --> 00:09:22,330
يبدو مُتحفِّزاً جدّاً

98
00:09:22,330 --> 00:09:24,890
لكن كُلّ ما سيفعله هو حضور اجتماع

99
00:09:34,470 --> 00:09:36,010
ثلج؟

100
00:09:36,010 --> 00:09:38,850
آمل أن يتوقّف عن التّساقُط
مع حلول المساء

101
00:09:43,070 --> 00:09:47,790
مولاتي، يبدو أنّ يوليوس-ساما
لم يصل بعد

102
00:09:47,790 --> 00:09:49,360
الرّجاء الانتظار داخل العربة

103
00:09:49,710 --> 00:09:50,770
حسناً

104
00:09:53,810 --> 00:09:55,890
...توقّعتُ أن يحدث هذا، ولذلك

105
00:09:58,240 --> 00:10:03,380
البطّانيّة الّتي تلقّيتُها من أبي
وأمّي دافئة للغاية

106
00:10:04,290 --> 00:10:06,380
سأسترخي وأنتظر

107
00:10:09,580 --> 00:10:13,210
هذه القصّة جميلة مهما قرأتُها من مرّات

108
00:10:15,660 --> 00:10:19,030
أمير مُتغطرس، لا يلقي بالاً
،لأولئك المُحيطين به

109
00:10:19,700 --> 00:10:24,500
لُعِنَ بواسطة ساحرة، ويتحوّل
إلى نبتة وردة

110
00:10:25,290 --> 00:10:26,650
،يختفي الأمير

111
00:10:26,650 --> 00:10:31,400
وفي كلّ يوم، ينمو علّيق شائك
ليبتلع القلعة

112
00:10:31,780 --> 00:10:35,030
يحاول أهل القرية المُرتعدون
حرق الوردة

113
00:10:35,030 --> 00:10:36,410
...ثمّ

114
00:10:37,210 --> 00:10:39,200
...ابنة بائع الزُّهور

115
00:10:42,000 --> 00:10:45,910
أشواك النّباتات موجودة للحرص"
"على عدم كسر القصبات

116
00:10:45,910 --> 00:10:49,770
الأشواك هي دليلٌ على الرّغبة"
"في النموّ بشكل أقوى

117
00:10:50,930 --> 00:10:54,670
،يقع الأمير في غرام قلب الفتاة الجميل

118
00:10:54,670 --> 00:10:59,430
،ولدى شعوره بالخجل من غطرسته
يستعدّ للاحتراق

119
00:11:00,260 --> 00:11:03,860
تستغرب الفتاةُ من توقُّف العلّيق
،الشّائك عن النموّ

120
00:11:03,860 --> 00:11:06,440
وتجد وردةً زرقاء بين الأشواك

121
00:11:06,860 --> 00:11:09,160
...عندما تلمس البتلات برفق

122
00:11:11,140 --> 00:11:15,070
تُكسَر لعنة السّاحرة، ويعود
الأمير إلى شكله البشريّ

123
00:11:15,660 --> 00:11:20,050
يقع الاثنان في الحُبّ، بينما يتشاركان
،حُبّهما مع بعضهما الآخر

124
00:11:20,050 --> 00:11:22,450
...يعيشان بسعادة للأبد بعدها

125
00:11:26,010 --> 00:11:30,210
البرد قارس. يُذكّرني بمعيشتي مع والدَي

126
00:11:31,190 --> 00:11:32,890
هذا غريبٌ جدّاً

127
00:11:32,890 --> 00:11:38,550
لطالما تمنّيتُ زواجاً حميميّاً
،كزواج أمّي وأبي

128
00:11:39,160 --> 00:11:41,520
،واعتقدتُ أنّه في هذا الزواج

129
00:11:41,520 --> 00:11:46,080
سأؤدّي ببساطة واجب زوجة
في عائلة دوقيّة

130
00:11:46,080 --> 00:11:48,500
...لكن الآن، زوجي

131
00:11:49,850 --> 00:11:50,910
!إيلسا

132
00:11:54,170 --> 00:11:55,860
!آسف لتأخُّري

133
00:12:03,970 --> 00:12:06,870
زوجي، لا بُدَّ أنّك كنتَ تعمل بجدّ

134
00:12:07,850 --> 00:12:12,880
أنا آسف لاستعجالكِ، لكن سنذهب
إلى مسرح الفنون الوطنيّة حالاً

135
00:12:13,420 --> 00:12:17,380
ماذا؟ تقصد ذلك البناء الكبير هناك؟

136
00:12:21,980 --> 00:12:27,800
هديّتي لكِ هي الأوبرا الّتي استند إليها
الكتاب الّذي أهداكِ إيّاه هانّيس

137
00:12:29,050 --> 00:12:30,650
أوبرا؟

138
00:12:30,650 --> 00:12:33,010
هل حضرتِها بالفعل؟

139
00:12:38,280 --> 00:12:39,650
!أنا سعيدةٌ للغاية

140
00:12:41,690 --> 00:12:42,840
يسرّني ذلك

141
00:12:47,660 --> 00:12:50,230
هيّا بنا. إنّها على وشك أن تبدأ

142
00:12:50,230 --> 00:12:51,670
!حسناً

143
00:13:40,470 --> 00:13:43,530
!أجل، كانت رائعة

144
00:13:44,760 --> 00:13:48,010
أنا آسفة لأنّها كانت مُثيرة
بالنّسبة لي فقط

145
00:13:48,870 --> 00:13:51,980
مضى وقت منذ حضرتُها، لذا كانت
مُمتعة جدّاً بالنّسبة لي

146
00:13:52,660 --> 00:13:56,980
شكراً لك على إحضاري إلى
عرض رائع كهذا

147
00:14:00,140 --> 00:14:01,720
لا، أنا من ينبغي أن يشكركِ

148
00:14:02,990 --> 00:14:05,620
إن لم تعلّميني بأنّ أيّام عيد
،الميلاد مُميّزة

149
00:14:06,120 --> 00:14:08,990
...وعلّمتِني كيفيّة الاحتفال بها

150
00:14:09,900 --> 00:14:14,060
فلا أعتقد بأنّني كنتُ لأحظى
برغبة من أعماق قلبي

151
00:14:14,060 --> 00:14:16,280
في الاحتفال بعيد ميلاد شخص هكذا

152
00:14:17,080 --> 00:14:19,580
عيد ميلاد سعيد يا إيلسا

153
00:14:22,970 --> 00:14:26,320
عقب هذا، قال طاقم العمل بأنّه يريد
،الاحتفال بعيد ميلادكِ أيضاً

154
00:14:26,320 --> 00:14:28,300
،لذا عندما نعود إلى المنزل
سنتناول العشاء

155
00:14:28,300 --> 00:14:29,470
!هكذا إذاً

156
00:14:29,470 --> 00:14:33,180
شعرتُ بأنّ الجميع كانوا سرّيّين اليوم

157
00:14:36,380 --> 00:14:39,060
أنا متأكِّدة بأنّهم بذلوا جهداً كبيراً في الأمر

158
00:14:43,880 --> 00:14:46,330
...أمّي، أبي

159
00:14:47,150 --> 00:14:48,370
...هانّيس

160
00:14:51,030 --> 00:14:53,780
...أعلم بأنّكم قلقون عليّ

161
00:14:54,530 --> 00:14:56,370
يبدو أنّهم أتوا ليقلونا

162
00:14:56,790 --> 00:14:59,790
هيّا، لنعُد إلى المنزل

163
00:15:00,750 --> 00:15:03,390
لكن كان عيد ميلادي في هذا العام مُدهشاً...

164
00:15:04,660 --> 00:15:05,860
أجل

165
00:15:06,380 --> 00:15:09,400
كان يوماً مُميّزاً جدّاً

166
00:15:24,680 --> 00:15:29,740
سبانخ وبروكولي وبصل وجزر
...وفاصولياء عريضة

167
00:15:30,400 --> 00:15:31,410
!حسناً

168
00:15:33,560 --> 00:15:35,370
هل قرّرتِ؟

169
00:15:36,010 --> 00:15:37,080
!أجل

170
00:15:37,740 --> 00:15:42,290
قبل أيّام، ساعدَني زوجي
،في تحضير التّربة

171
00:15:42,290 --> 00:15:45,090
لذا أنا مُتيقّنة من أنّني سأتمكّن
من زراعة خضراوات شهيّة

172
00:15:45,370 --> 00:15:47,590
!بالمُناسبة يا إيلسا-ساما

173
00:15:47,590 --> 00:15:51,100
هل تريدين شتلة نوع جديد من الورود؟

174
00:15:52,130 --> 00:15:54,670
إنّها تتفتّح في كُلّ موسم، لذا
،إذا اعتنيتِ بها جيّداً

175
00:15:54,670 --> 00:15:57,100
فسوف تستمرّ في الازدهار

176
00:15:58,400 --> 00:15:59,750
ورود؟

177
00:16:11,230 --> 00:16:14,530
تًشبه قليلاً الورود في الأوبرا
الّتي شاهدناها في عيد ميلادي

178
00:16:16,540 --> 00:16:18,850
أجل، أرغب في واحدة من هذه رجاء

179
00:16:25,410 --> 00:16:27,880
قمتُ ببعض عمليّات الشّراء الجيّدة

180
00:16:29,190 --> 00:16:29,880
...لحظة

181
00:16:31,790 --> 00:16:33,880
أين أنا؟

182
00:16:33,880 --> 00:16:36,510
أتيتُ إلى مكانٍ لا أعرفه

183
00:16:46,900 --> 00:16:47,820
!انتظرني

184
00:16:47,820 --> 00:16:48,670
!من هنا

185
00:16:48,670 --> 00:16:51,580
يبدو أنّ لديهم منزل أطفال كذلك

186
00:16:52,890 --> 00:16:54,910
أتساءل ما إن كان الجميع بخير

187
00:16:56,860 --> 00:17:00,420
مطلوب مُعلِّمين؟ وطلب لتبرُّعات؟

188
00:17:00,940 --> 00:17:04,920
فقط لكونهم يتامى لا يعني
أن يستطيعوا الأكل مجّاناً

189
00:17:04,920 --> 00:17:08,250
دعيهم يعملون! يمكنهم أن يكونوا
عتّالين أو مُنظِّفي مداخن

190
00:17:08,250 --> 00:17:10,920
العاصمة الملكيّة غارقة في العمل

191
00:17:10,920 --> 00:17:12,280
،بالنّسبة لهؤلاء الأطفال

192
00:17:12,280 --> 00:17:15,930
قضاء الوقت في الكدح ليس مُهمّاً
كقضائه في الدّراسة

193
00:17:17,430 --> 00:17:19,930
رغم أنّه ليس لديكِ مَن يُعلّمهم؟

194
00:17:21,940 --> 00:17:25,950
لا يعنيني إذا هُدِمَ مركزٌ كهذا كما تعلمين

195
00:17:25,950 --> 00:17:27,380
!المعذرة

196
00:17:28,520 --> 00:17:31,950
قرأتُ بأنّكم بحاجة مُعلِّمين

197
00:17:32,720 --> 00:17:35,950
.أنا من عائلة روياس الدّوقيّة
اسمي هو إيلسا

198
00:17:39,950 --> 00:17:43,460
تبدو مُستميتاً لتجنُّب رحلات
العمل يا يوليوس

199
00:17:43,860 --> 00:17:48,460
بالطّبع. فهذا سيعني ترك القصر
فارغاً ولأسابيع عديدة

200
00:17:49,880 --> 00:17:53,320
في السّابق، كان يذهب إلى أيّ
مكان يؤمَر بالذّهاب إليه

201
00:17:54,240 --> 00:17:57,910
إذاً، تنوي تأخذ إجازة لبعض الوقت
حالما يكتمل هذا الإجراء

202
00:18:01,200 --> 00:18:03,600
أجل، هذه هي نيّتي

203
00:18:05,560 --> 00:18:06,920
عريس لعين

204
00:18:07,880 --> 00:18:09,720
بالمُناسبة

205
00:18:09,720 --> 00:18:13,610
،عندما خرجتُ بعد ظهر اليوم
لمحتُ زوجتك في البلدة

206
00:18:14,970 --> 00:18:18,910
كانت بمُفردها عند الكنيسة وبدت
شاردة في التّفكير في شيء ما

207
00:18:21,510 --> 00:18:24,010
دون مُرافق ثانية

208
00:18:29,010 --> 00:18:33,220
آمل أن نتمكّن من تناول"
"العشاء معاً اللّيلة

209
00:18:34,370 --> 00:18:37,020
لـ-ليس هذا ما كنتُ أُفكِّر فيه

210
00:18:37,020 --> 00:18:38,190
بلى، كنتَ كذلك

211
00:18:40,470 --> 00:18:43,140
أهلاً بعودتك يا يوليوس-ساما

212
00:18:46,560 --> 00:18:49,150
زوجتك تنتظر في غرفة المعيشة

213
00:18:49,550 --> 00:18:51,290
حسناً، شكراً لكِ

214
00:18:55,040 --> 00:18:56,160
إيلسا

215
00:19:06,170 --> 00:19:07,440
هذا غير م عتاد

216
00:19:07,440 --> 00:19:11,170
وجبتكما جاهزتان. هل أُوقظها؟

217
00:19:11,780 --> 00:19:12,780
لا

218
00:19:13,710 --> 00:19:15,920
دعيها تنام لفترة أطول

219
00:19:15,920 --> 00:19:17,390
عُلِم يا سيّدي

220
00:19:47,320 --> 00:19:48,680
!زوجي

221
00:19:50,380 --> 00:19:52,710
!يا لسخافتي! أنا آسفة جدّاً

222
00:19:53,540 --> 00:19:55,720
لا بُدّ أنّك مُرهَقة من جولتك

223
00:19:55,720 --> 00:19:59,840
أجل، ذهبتُ لمُعاينة البذور والشّتلات
لزرعها في الحديقة

224
00:19:59,840 --> 00:20:03,720
،والأوبرا قبلها كانت رائعة
فانتهى الأمر بشرائي وردة أيضاً

225
00:20:04,180 --> 00:20:06,430
يبدو أنّها تتفتّح عدّة مرّات خلال العام

226
00:20:06,430 --> 00:20:08,520
لذا آمل أن تتطلّع لها

227
00:20:09,560 --> 00:20:10,730
هكذا إذاً

228
00:20:10,730 --> 00:20:12,280
...و

229
00:20:12,930 --> 00:20:16,740
يجب أن أُخبره عن منزل الأطفال

230
00:20:18,600 --> 00:20:19,720
...أنا

231
00:20:29,090 --> 00:20:30,750
هل نتناول وجبتنا؟

232
00:20:30,750 --> 00:20:33,120
انتظرتَني؟

233
00:20:34,580 --> 00:20:35,760
ليس تماماً

234
00:20:36,360 --> 00:20:39,830
أردتُ ترتيب العمل الّذي أحضرتُه
إلى المنزل، هذا كُلّ شيء

235
00:20:41,170 --> 00:20:43,740
أنت مشغولٌ دوماً، أليس كذلك؟

236
00:20:44,140 --> 00:20:47,770
تجاوزنا نقطةَ تحوُّل، لذا ينبغي
أن تهدأ الأمور في الأسبوع المُقبل

237
00:20:49,280 --> 00:20:51,380
حالما تهدأ، أريني الحديقة رجاء

238
00:20:51,770 --> 00:20:52,970
!بالطّبع

239
00:20:53,390 --> 00:20:58,780
سأؤجِّل مُشكلة الأطفال إلى أن
يستقرّ عمل زوجي

240
00:20:59,990 --> 00:21:02,780
حقّاً؟ شكراً لك على التّقرير

241
00:21:09,830 --> 00:21:12,900
مُعلِّمة لمنزل أطفال؟