1
00:00:02,440 --> 00:00:04,150
أكره منزلي

2
00:00:05,130 --> 00:00:08,490
...برودة المقعد حيث أجلس وحيداً

3
00:00:08,870 --> 00:00:10,140
...و

4
00:00:20,100 --> 00:00:22,360
يبدو أنّك غازلت فتاة

5
00:00:22,360 --> 00:00:24,000
عائلتها ليست من مرتبة نبيلة

6
00:00:24,500 --> 00:00:27,450
هلّا اخترت شريكاتك بحرص أكبر؟

7
00:00:27,760 --> 00:00:31,210
ماذا عنكِ؟ كُفّي عن إدخال
رجال إلى هذا المنزل

8
00:00:31,210 --> 00:00:32,760
سنصبح حديث النّاس

9
00:00:33,130 --> 00:00:36,370
أصوات والدَي وهما يتشاجران معاً

10
00:00:36,370 --> 00:00:38,270
هي الشّيء الوحيد الّذي يملأ هذا المنزل

11
00:00:38,790 --> 00:00:42,510
...مولايّ، مولاتي، مولايّ الصّغير يوليوس قد

12
00:00:42,510 --> 00:00:43,510
ماذا؟

13
00:00:46,380 --> 00:00:47,780
هكذا إذاً

14
00:00:47,780 --> 00:00:49,240
تنصّتّ علينا

15
00:00:54,960 --> 00:00:56,210
حلم؟

16
00:00:57,290 --> 00:01:00,040
كنتُ قد نسيتُ كُلّ ذلك ونسيتُ
...والدَي، ومع ذلك

17
00:01:02,830 --> 00:01:05,290
لا بُدّ أنّ السّبب هو أنّني مضيتُ بهذا الزّواج

18
00:02:40,360 --> 00:02:43,020
مضى شهر منذ تزوّجتُ يوليوس-ساما

19
00:02:44,410 --> 00:02:45,520
!البازلّاء

20
00:02:46,910 --> 00:02:48,490
هذا هو حصادي الأوّل

21
00:02:50,900 --> 00:02:54,900
...يومنا الأوّل جلبَ بضع مُفاجآت

22
00:02:55,660 --> 00:02:58,660
لكن كان لطيفاً بما يكفي قائلاً بأنّني
،أستطيع قضاء وقتي كيفما أُحبّ

23
00:02:59,010 --> 00:03:01,910
لذا كنتُ أزرع خضراوات في زاوية الأرض

24
00:03:04,570 --> 00:03:06,170
!صباح الخير

25
00:03:08,470 --> 00:03:10,760
صباح الخير يا مولاتي

26
00:03:10,760 --> 00:03:13,420
شكراً لك كالعادة

27
00:03:15,440 --> 00:03:19,680
والخادمات سمحنَ لي بالحياكة معهن

28
00:03:19,680 --> 00:03:22,650
!إيلسا-ساما، أنتِ ماهرةٌ في هذا حقّاً

29
00:03:22,650 --> 00:03:25,090
يُسعدني سماعكِ تقولين هذا

30
00:03:30,930 --> 00:03:33,960
كنتُ أقضي وقتي بهدوء ورفاهية

31
00:03:38,790 --> 00:03:40,050
!زوجي العزيز

32
00:03:40,050 --> 00:03:41,450
!صباح الخير

33
00:03:43,970 --> 00:03:45,070
صباح الخير

34
00:03:50,210 --> 00:03:53,960
أشعر وكأنّها تنظر إليّ بإمعان
أكبر من المعتاد اليوم

35
00:03:55,100 --> 00:03:57,470
هل وضعتْ سُمّاً في طعامي أو ما شابه؟

36
00:04:03,550 --> 00:04:05,370
لا، هذا مُستحيل

37
00:04:11,160 --> 00:04:14,740
يبدو أنّها انسجمتْ مع خادمات المنزل بالفعل

38
00:04:15,340 --> 00:04:17,220
إنّها فتاة عجيبة

39
00:04:22,110 --> 00:04:25,240
لم يلمسه اليوم أيضاً

40
00:04:26,040 --> 00:04:30,940
يبدو أنّ الخضراوات الّتي زرعتُها
لا تُلائم ذوقه

41
00:04:30,940 --> 00:04:33,380
من فضلكِ لا تدعي الأمر يؤرقكِ

42
00:04:34,430 --> 00:04:37,880
لطالما كان يوليوس-ساما يكره الكثير
من الأطعمة دون تجربتها حتّى

43
00:04:37,880 --> 00:04:39,760
إنّه يُعذّب رئيس الطبّاخين كثيراً

44
00:04:39,760 --> 00:04:41,780
يكرهها دون تجربتها؟

45
00:04:41,780 --> 00:04:44,510
يكره مُعظم الخضراوات

46
00:04:44,510 --> 00:04:50,020
تقصدين بأنّه يكرهها دون حتّى
أن يقضم لقمة واحدة؟

47
00:04:50,370 --> 00:04:52,020
...لكن هذا فقط

48
00:04:52,300 --> 00:04:55,830
!سأصحّح عادات الأكل لدى زوجي

49
00:04:59,330 --> 00:05:02,810
أكثر طريقة جوهريّة للتّعامل
مع كره الخضراوات

50
00:05:02,810 --> 00:05:05,940
هي فرمها إلى قطع ناعمة ومزجها
...مع أطعمة أُخرى، لكن

51
00:05:07,300 --> 00:05:10,540
إيلسا-ساما، وصلكِ بريد

52
00:05:13,040 --> 00:05:15,040
هناك الكثير اليوم

53
00:05:15,040 --> 00:05:19,520
يبدو أنّ مُعظمها دعوات إلى حفلات
شاي باستضافة الطّبقة النّبيلة

54
00:05:20,300 --> 00:05:23,330
يبدو أنّ الزّواج من يوليوس-ساما

55
00:05:23,330 --> 00:05:26,060
جذبَ الكثير من الاهتمام

56
00:05:27,140 --> 00:05:29,550
!يا له من ظَرف جميل

57
00:05:30,560 --> 00:05:35,510
هذه الدّعوة هي من زوجة الماركيز
ريكّونين، ريبيكّا-ساما

58
00:05:35,510 --> 00:05:37,000
ريبيكّا-ساما؟

59
00:05:39,430 --> 00:05:43,160
المرأة الجميلة الّتي التقيتُ بها
!في يوم مراسم الزّفاف

60
00:05:43,870 --> 00:05:47,620
قالت بأنّها صديقة طفولة يوليوس-ساما

61
00:05:47,620 --> 00:05:50,660
أجل، عائلة الماركيز ريكّونين

62
00:05:50,660 --> 00:05:55,130
وعائلتنا الدّوقيّة روياس كانا
على وِفاق لأجيال

63
00:05:55,130 --> 00:05:59,630
ربّما سأتمكّن من سماع المزيد
عن يوليوس-ساما

64
00:06:00,320 --> 00:06:03,130
سأقبل هذه الدّعوة

65
00:06:03,550 --> 00:06:05,080
سيرافينا-ساما

66
00:06:05,080 --> 00:06:09,170
هذه هي الدّعوات إلى السّهرات
وحفلات الشّاي الّتي وصلت اليوم

67
00:06:09,950 --> 00:06:14,330
اليوم، تشمل دعوةً من زوجة
الماركيز ريكّونين

68
00:06:15,570 --> 00:06:17,170
من ريبيكّا-ساما؟

69
00:06:18,270 --> 00:06:21,460
إذاً زوجة ذلك الرّجل قد تكون
حاضرة هناك أيضاً

70
00:06:22,420 --> 00:06:26,440
سأحضر حفلة الشّاي هذه كذلك

71
00:06:30,350 --> 00:06:32,780
وصلنا يا إيلسا-ساما

72
00:06:38,130 --> 00:06:40,930
هذا هو عقار ريبيكّا-ساما إذاً

73
00:06:41,940 --> 00:06:43,670
أنا مُتوتّرة جدّاً

74
00:06:44,000 --> 00:06:45,680
!إيلسا-ساما

75
00:06:45,990 --> 00:06:48,230
شكراً على حضوركِ

76
00:06:48,230 --> 00:06:51,290
،سأعرّفكِ عن نفسي مرّة أُخرى
اسمي ريبيكّا ريكّونين

77
00:06:53,430 --> 00:06:55,440
أنا إيلسا روياس

78
00:06:55,440 --> 00:06:57,060
تمكّنتُ فقط من إلقاء التّحيّة عليكِ

79
00:06:57,060 --> 00:06:59,220
في يوم مراسم الزّفاف

80
00:06:59,220 --> 00:07:03,440
أنا مسرورة جدّاً لأنّه سنحتْ لي هذه
!الفُرصة للتكلُّم معكِ بكلّ راحة

81
00:07:03,870 --> 00:07:06,950
كما توقّعت. ريبيكّا-ساما لطيفة جدّاً

82
00:07:06,950 --> 00:07:10,650
!وأنا ابتهجتُ كثيراً بتلقّي دعوتك

83
00:07:13,480 --> 00:07:17,710
إيلسا-ساما، كيف هي حياتكِ
كعروس مع يوليوس؟

84
00:07:18,330 --> 00:07:21,710
يُعاملني يوليوس-ساما بشكل جيّد

85
00:07:22,290 --> 00:07:25,690
!الطّعام شهيّ، وسريري منفوش

86
00:07:25,690 --> 00:07:29,220
،ومنحني قطعةَ أرض في حديقة
!ويسمح لي بفعل ما أشاء

87
00:07:31,860 --> 00:07:36,240
أنا مسرورة جدّاً لأنّ يوليوس
ارتبط بشخص مثلكِ

88
00:07:36,890 --> 00:07:41,340
عندما يتعلّق الأمر بأيّ شيء غير
العمل، إنّه ميؤوس منه

89
00:07:41,340 --> 00:07:43,860
كصديقة له، كنتُ قلقة عليه

90
00:07:43,860 --> 00:07:45,760
حقّاً؟

91
00:07:45,760 --> 00:07:50,240
لكن انطباعي عن يوليوس-ساما هو
بأنّه وقور دوماً

92
00:07:51,470 --> 00:07:54,170
حسناً إذاً. سأذهب لتحضير الشّاي

93
00:07:54,170 --> 00:07:56,250
انتظري في هذه القاعة رجاء

94
00:08:03,920 --> 00:08:06,120
مـ-مرحباً

95
00:08:06,120 --> 00:08:07,370
طاب يومكن

96
00:08:07,370 --> 00:08:08,760
مرحباً بك

97
00:08:09,360 --> 00:08:11,530
ماذا؟ هذه أوّل مرّة نلتقي فيها، أليس كذلك؟

98
00:08:11,530 --> 00:08:13,850
أجل، من دواعي سروري لقاؤك

99
00:08:13,850 --> 00:08:17,060
!شاي ريبيكا-ساما شهيّ حقّاً

100
00:08:17,060 --> 00:08:18,770
!إذاً، أتطلّع قُدماً له

101
00:08:18,770 --> 00:08:21,650
إيلسا-ساما، لم أركِ منذ وقت

102
00:08:23,870 --> 00:08:25,280
...هذه

103
00:08:25,730 --> 00:08:29,820
هذه السّيّدة الجميلة الّتي أتت وألقت
!علينا التّحيّة في يوم الزّفاف

104
00:08:31,530 --> 00:08:34,470
سيرافينا-ساما، أجل، مضى بعض الوقت

105
00:08:34,470 --> 00:08:37,280
يسرّني أنّكِ تتذكّرينني

106
00:08:37,280 --> 00:08:40,790
.اسمحي لي أن أعرّف عن نفسي ثانية
أنا سيرافينا من عائلة بارنيلّا الدّوقيّة

107
00:08:41,470 --> 00:08:43,540
!إنّها مُبهرة اليوم أيضاً

108
00:08:44,530 --> 00:08:46,780
تسرّني رؤيتكِ مُجدّداً

109
00:08:46,780 --> 00:08:50,620
،هذه أوّل مرّة أحضر فيها حفلة شاي

110
00:08:50,620 --> 00:08:53,800
لذا أشعر بالرّاحة برؤية شخص أعرفه

111
00:08:54,190 --> 00:08:56,290
تغمرني السّعادة

112
00:08:56,290 --> 00:08:59,810
شكراً على دعوتي إلى مراسم زفافك

113
00:08:59,810 --> 00:09:01,120
—لا أبداً! أنا من يشكركِ على

114
00:09:01,120 --> 00:09:05,320
!تفاجأتُ كثيراً عندما تزوّجتما فجأة

115
00:09:05,320 --> 00:09:10,820
كان يوليوس-ساما صديقاً لي
منذ ما قبل ذلك بكثير

116
00:09:10,820 --> 00:09:15,110
سيرافينا-ساما، أنتِ صديقة يوليوس-ساما، أيضاً؟

117
00:09:15,110 --> 00:09:18,080
!إذاً يسرّني أن أسمع قصصكِ عنه

118
00:09:19,710 --> 00:09:22,080
أجل، بالطّبع

119
00:09:22,600 --> 00:09:26,670
منذ التقيتُ بيوليوس-ساما في سهرة
...قبل ثلاث سنوات

120
00:09:27,000 --> 00:09:29,510
عاملَني بمودّة كبيرة

121
00:09:29,970 --> 00:09:32,320
،إنّه لا يبرع في فنّ المُحادثة فحسب

122
00:09:32,320 --> 00:09:36,830
بل يقدّم لي هدايا صغيرة بصورة عفويّة
وهو لطيف جدّاً

123
00:09:37,600 --> 00:09:39,630
،عندما نقضي الوقت معاً

124
00:09:39,630 --> 00:09:42,350
دائماً ما يحرص على أن أستمتع بوقتي

125
00:09:42,350 --> 00:09:44,180
أحقّاً ذلك؟

126
00:09:45,560 --> 00:09:50,610
يوليوس-ساما هو رجلٌ جميل يُلاطف
النّساء جميعهن بنفس الدّرجة

127
00:09:50,610 --> 00:09:52,590
إذاً، رغم أنّه تمّ اختياركِ زوجة له

128
00:09:52,590 --> 00:09:54,870
،فقط لتحقيق توازُن في مكانة عائلته

129
00:09:54,870 --> 00:09:57,630
أنا متأكّدة بأنّه يُعاملكِ بلطف كذلك

130
00:09:58,200 --> 00:09:59,870
...سيرافينا-ساما

131
00:10:00,320 --> 00:10:03,870
،أُفضّل عدم  مُناقشة أيّ أمر فظّ

132
00:10:03,870 --> 00:10:08,120
لكن هل نسيتِ بأنّ عائلتها دوقيّة؟

133
00:10:08,880 --> 00:10:13,880
،إيلسا-ساما هي زوجة يوليوس
وهو وريث دوقيّة

134
00:10:21,270 --> 00:10:23,520
اعذريني على وقاحتي رجاء

135
00:10:23,950 --> 00:10:26,520
أشعر أنّني لستُ بحالة جيّدة

136
00:10:27,020 --> 00:10:28,960
أستأذن لليوم

137
00:10:33,280 --> 00:10:37,280
إيلسا-ساما، من فضلكِ لا تدعي
الأمر يؤرقكِ

138
00:10:37,280 --> 00:10:41,340
،دائماً ما أدعو سيرافينا-ساما
لكنّها لا تحضر أبداً

139
00:10:41,340 --> 00:10:45,040
شعرتُ أنّه من الغريب أن تحضر
...هذه المرّة، لكنّني

140
00:10:45,040 --> 00:10:49,900
،أجل، فهمت. وهي نحيلة جدّاً
أنا قلقة عليها

141
00:10:51,070 --> 00:10:52,610
هل يُعقل أنّ هذه الفتاة لم تلحظ

142
00:10:52,610 --> 00:10:55,550
بأنّ سيرافينا-ساما كانت تحاول
أن تستعلي عليها؟

143
00:10:55,890 --> 00:10:58,300
إلى أيّ درجة هذه الفتاة بريئة؟

144
00:10:58,840 --> 00:11:01,600
...هذه السّيّدة ويوليوس

145
00:11:01,600 --> 00:11:03,340
!يجب أن أحذّرها

146
00:11:12,180 --> 00:11:13,570
،إيلسا-ساما

147
00:11:13,570 --> 00:11:17,570
ثمّة شيء حول يوليوس أريد
مُناقشته معكِ بصراحة

148
00:11:19,850 --> 00:11:21,970
،لأجل سياسات المملكة

149
00:11:21,970 --> 00:11:25,330
يستهدف يوليوس مُختلَف الفتيات
لاستخراج معلومات

150
00:11:25,330 --> 00:11:27,780
إنّه عميلٌ ذكيّ

151
00:11:28,330 --> 00:11:30,140
عميل ذكيّ؟

152
00:11:30,140 --> 00:11:33,510
إنّه شخص يستطيع التّعامل بعقلانيّة
،مع عواطفه

153
00:11:33,510 --> 00:11:36,340
لذا، من ناحية، إنّه الشّخص المثاليّ للعمل

154
00:11:36,340 --> 00:11:39,490
لكن الخِلاف بين والديه

155
00:11:39,490 --> 00:11:41,490
جعلاه يفقد الثِّقة بالحُبّ الرّومانسيّ

156
00:11:41,490 --> 00:11:43,850
خِلاف بين والديه؟

157
00:11:43,850 --> 00:11:47,990
،حتّى لو كانت امرأة تكنّ له مشاعر حقيقيّة
،عندما ينتهي عمله

158
00:11:47,990 --> 00:11:51,860
يبدو أنّه يتركهن دوماً دون مُبالاة لمشاعرهن

159
00:11:51,860 --> 00:11:55,500
،أنا صديقة طفولته فحسب، ومع ذلك
حتّى في حالتي

160
00:11:55,500 --> 00:12:00,510
وجّهتْ لي نساءٌ لا أعرفهن حتّى
كلاماً قاسياً تجاهي

161
00:12:01,690 --> 00:12:05,170
،وصحيح أنّ هناك ظروفاً لا يمكن تجنّبها

162
00:12:05,170 --> 00:12:06,940
،لكنّه شخصٌ لطيف ضمنيّاً

163
00:12:06,940 --> 00:12:09,290
لذا آمل أن تكوني جيّدة بما يكفي
لعدم التخلِّي عنه

164
00:12:09,290 --> 00:12:11,380
ولِمَ أتخلّى عنه؟

165
00:12:11,890 --> 00:12:16,380
...صحيح أنّني مُتفاجئة قليلاً، لكن
كانت المرّة الأولى

166
00:12:17,880 --> 00:12:22,200
لم يكن يوليوس-ساما كالآخرين الّذين
تقدّموا للزواج منّي

167
00:12:22,200 --> 00:12:27,010
لم يستخفّ بعائلتي أو يفرض
شروطاً غير مُناسبة

168
00:12:27,400 --> 00:12:28,560
...ليس ذلك فحسب

169
00:12:28,560 --> 00:12:30,650
،إنّه يساهم في استعادة أراضينا المُتداعية

170
00:12:30,650 --> 00:12:34,150
وحتّى أنّه يُقدّم المُساعدة وذلك كي يتمكّن
أخي الأصغر من الدّراسة

171
00:12:34,530 --> 00:12:38,030
لا يمكن أن يكون شخص كهذا سيّئاً

172
00:12:39,740 --> 00:12:43,020
أريد أن أردّ جميل يوليوس-ساما

173
00:12:43,020 --> 00:12:44,660
!كم هذا مُطمئن

174
00:12:45,420 --> 00:12:47,240
،إذا واجهتِ أي عقبة يوماً

175
00:12:47,800 --> 00:12:50,370
فتعالي وأخبريني رجاء، أيّاً كانت العقبة

176
00:12:50,370 --> 00:12:51,750
!سوف أُساعدكِ

177
00:12:51,750 --> 00:12:53,420
!شكراً جزيلاً لكِ

178
00:12:53,420 --> 00:12:57,900
ريبيكا-ساما، في هذه الحالة، أودّ
أن أطلب منكِ شيئاً

179
00:12:57,900 --> 00:12:59,170
اطلبي منّي أيّ شيء رجاء

180
00:12:59,480 --> 00:13:02,680
ما الأطعمة الّتي يحبّها يوليوس-ساما؟

181
00:13:02,680 --> 00:13:03,770
عفواً؟

182
00:13:03,770 --> 00:13:08,020
كلّما أكل، دائماً ما يترك شيئاً في صحنه

183
00:13:08,020 --> 00:13:10,000
!هذا يؤرقني كثيراً

184
00:13:09,050 --> 00:13:10,690
إيلسا-ساما ظريفة

185
00:13:10,690 --> 00:13:13,370
،يبدو أنّه يكره الخضراوات بالتّحديد

186
00:13:13,370 --> 00:13:16,150
لكن لا أعرف ما الأطعمة الّتي يُحبّها

187
00:13:16,150 --> 00:13:17,690
غراتان

188
00:13:17,690 --> 00:13:18,990
غراتان؟

189
00:13:18,990 --> 00:13:23,270
في هذه الحالة، سيكون من السّهل خلط
!خضراوات مفرومة إلى قِطع ناعمة

190
00:13:23,770 --> 00:13:25,880
هذه فكرة مُبهرة

191
00:13:25,880 --> 00:13:28,700
يحبّ بالتّحديد الغراتان مع اللّحم

192
00:13:29,080 --> 00:13:32,630
عندما كنّا طفلين، كان هناك طبق كبير
،مُخصّص لحفلة

193
00:13:32,630 --> 00:13:35,030
وأكلَه كُلّه بمفرده

194
00:13:35,030 --> 00:13:37,800
وبّختْه رئيسة الخدم

195
00:13:38,900 --> 00:13:42,330
بوضعه الحالي الآن، أنا متأكّدة
بأنّكِ لن تُصدّقي ذلك

196
00:13:42,330 --> 00:13:43,370
إطلاقاً

197
00:13:43,370 --> 00:13:48,970
رغم ذلك، لم أكن أعلم بأنّ يوليوس ما زال
لديه تفضيلات طفوليّة

198
00:13:49,320 --> 00:13:53,230
،وفي الشّهر المُقبل، شهر الجُرَيس
سيبلغ الرّابعة والعشرين أيضاً

199
00:13:54,480 --> 00:13:57,980
يوم ميلاد يوليوس-ساما في الشّهر المُقبل؟

200
00:13:57,980 --> 00:14:00,740
أجل، السّابع من شهر الجُرَيس

201
00:14:00,740 --> 00:14:04,830
،اعتنى كُلّ هذا الاعتناء بي
!وأنا لم أكن أعلم

202
00:14:05,360 --> 00:14:08,240
في الواقع، لا يُقيم حفلات عيد ميلاد
أو ما شابه في نهاية المطاف

203
00:14:09,230 --> 00:14:13,100
إذا احتفلتُ بعيد ميلاده، فهل
تعتقدين بأنّه سيكره ذلك؟

204
00:14:14,430 --> 00:14:15,840
!إنّها رائعة

205
00:14:17,020 --> 00:14:19,080
!أنا متأكّدة بأنّه سوف يبتهج

206
00:14:25,760 --> 00:14:28,800
اقتربَ عيد ميلاد يوليوس-ساما

207
00:14:28,800 --> 00:14:30,770
كيف ينبغي أن نحتفل به؟

208
00:14:30,770 --> 00:14:34,040
الطّبق الرّئيسيّ في العشاء سيكون
...غراتان باللّحم

209
00:14:34,040 --> 00:14:36,270
وأريد أن أُقدّم له هديّة ما

210
00:14:52,910 --> 00:14:56,690
إيلسا-ساما، ماذا تُعدّين؟

211
00:14:56,690 --> 00:14:57,920
هذا سرّ

212
00:14:57,920 --> 00:14:58,990
ماذا؟

213
00:14:58,990 --> 00:15:00,500
هذا يُشعرني بفضول

214
00:15:02,230 --> 00:15:04,170
و... ما هذا؟

215
00:15:04,170 --> 00:15:07,240
هذه صُدرة أعددتُها بنفسي

216
00:15:07,600 --> 00:15:10,190
أنجزتُ عملي لليوم بالفعل

217
00:15:10,190 --> 00:15:11,410
بمفردكِ؟

218
00:15:12,080 --> 00:15:14,680
!هذا لأجل مهرجان الشّمس

219
00:15:16,440 --> 00:15:18,060
مهرجان الشّمس

220
00:15:18,690 --> 00:15:21,110
إنّه مهرجان سيُقام في الشّهر المُقبل

221
00:15:21,110 --> 00:15:23,690
للاحتفال بتأسيس مملكة رالت

222
00:15:23,690 --> 00:15:26,860
عندما ألقى الملكُ الأوّل خطابَه
،في يوم التّأسيس

223
00:15:26,860 --> 00:15:29,350
،حملَ النّاسُ زهور عبّاد الشّمس احتفالاً

224
00:15:29,350 --> 00:15:32,200
وهكذا بدأ حسبما قالوا

225
00:15:32,200 --> 00:15:33,900
أعي ذلك

226
00:15:33,900 --> 00:15:34,970
ماذا؟

227
00:15:34,970 --> 00:15:39,260
لأنّنا احتفلنا بمهرجان الشّمس
في دياري كذلك

228
00:15:43,530 --> 00:15:45,590
!هكذا إذاً

229
00:15:45,590 --> 00:15:49,740
سمعتُ بأنّ مهرجان الشّمس في العاصمة
الملكيّة هو فعاليّة جميلة ومُبهجة

230
00:15:49,740 --> 00:15:52,220
لطالما تمنّيتُ حضوره يوماً ما

231
00:15:52,220 --> 00:15:54,270
!أبقي سقف توقُّعاتكِ مُرتفعاً

232
00:15:54,270 --> 00:15:56,740
إنّه أفضل مهرجان في العاصمة الملكيّة

233
00:15:56,740 --> 00:15:58,020
!أتطلّع قُدماً له

234
00:15:58,020 --> 00:15:59,790
سيترتّب عليّ حياكة فستان
لنفسي أيضاً

235
00:15:59,790 --> 00:16:02,710
!حسناً، مع مَن ستذهبين؟ بربّكِ، أخبريني

236
00:16:02,710 --> 00:16:07,730
!لكن أتطلّع قُدماً لعيد ميلاد يوليوس-ساما أكثر

237
00:16:14,570 --> 00:16:16,650
أخيراً، إنّه غداً

238
00:16:17,920 --> 00:16:19,000
يوليوس

239
00:16:19,000 --> 00:16:23,460
هل الدّعوات إلى المراسم التّذكاريّة لمهرجان
الشّمس تسير على ما يُرام؟

240
00:16:23,460 --> 00:16:26,430
أجل. كُلّ ما بقي هو إرسالها

241
00:16:26,430 --> 00:16:29,760
ويا ييري، ماذا عن التّرتيبات الأمنيّة؟

242
00:16:29,760 --> 00:16:33,580
في الواقع، سيُشارك تقريباً كُلّ النّبلاء
من أرجاء المملكة

243
00:16:33,580 --> 00:16:35,770
كما في السّنوات السّابقة، ستُتّخذ
إجراءات أمنيّة صارمة

244
00:16:36,450 --> 00:16:40,270
"كما في السّنوات السّابقة"
قد لا تكون كافية هذه المرّة

245
00:16:40,700 --> 00:16:44,190
لأنّ الكونت بارنيلّا قد يحاول
التّخطيط لشيء ما

246
00:16:44,480 --> 00:16:45,690
صحيح؟

247
00:16:46,280 --> 00:16:47,480
أجل

248
00:16:47,480 --> 00:16:51,250
في السّنوات الأخيرة، جمعتْ عائلةُ الكونت
،بارنيلّا قوّة بسرعة كبيرة

249
00:16:51,250 --> 00:16:53,040
وتدفُّق أموالهم مُريب أيضاً

250
00:16:53,040 --> 00:16:56,410
وحركات الابن يارمو تبدو مُريبة كذلك

251
00:16:56,410 --> 00:17:00,070
كنتُ قد طلبتُ من يوليوس التقرُّب
،من الابنة للتّحقيق

252
00:17:00,070 --> 00:17:02,750
لكن لم يتمكّن من الحصول على
أيّ دليل ملموس

253
00:17:04,540 --> 00:17:08,580
على أيّ حال، فعلتُ أشياء كثيرة
،لاعتراض طريق الكونت

254
00:17:08,580 --> 00:17:10,910
لذا أنا متأكّد بأنّه يضمر ضغينة تجاهي

255
00:17:10,910 --> 00:17:13,550
سموّك تُعادي كثيراً من النّاس حقّاً

256
00:17:14,350 --> 00:17:15,840
...حتّى لو كان هذا صحيحاً

257
00:17:15,840 --> 00:17:18,410
سوف تحميانني، أليس كذلك؟

258
00:17:20,150 --> 00:17:21,560
،بالمُناسبة يا يوليوس

259
00:17:21,560 --> 00:17:24,060
كيف كانت زوجتك مؤخّراً؟

260
00:17:24,060 --> 00:17:26,320
لا توجد أي مشاكل على وجه الخصوص

261
00:17:26,320 --> 00:17:28,350
سمعتُ بأنّها كانت تحضر حفلات شاي

262
00:17:28,350 --> 00:17:30,880
وتبرز في المُجتمع مُؤخّراً

263
00:17:30,880 --> 00:17:32,440
يسرّني سماع ذلك

264
00:17:32,440 --> 00:17:34,070
...إن كان عليّ تقديم مثال

265
00:17:34,070 --> 00:17:36,470
،سمعتُ بأنّ البستنة كانت هوايتها

266
00:17:36,470 --> 00:17:38,410
لذا ظننتُ بأنّها تزرع وروداً أو ما شابه

267
00:17:38,410 --> 00:17:40,580
عندما سمحتُ لها باستخدام زاوية
...من الحديقة كما شاءت

268
00:17:40,860 --> 00:17:43,580
لسبب ما، يبدو أنّها تزرع خضراوات

269
00:17:44,080 --> 00:17:45,300
خضراوات؟

270
00:17:45,300 --> 00:17:47,310
...أجل. جزر وفاصولياء

271
00:17:47,310 --> 00:17:50,090
وأبلغتني في هذا الصّباح بأنّها
حصدتْ فجلاً

272
00:17:50,090 --> 00:17:53,950
يوليوس، أنت تكره الخضراوات، أليس كذلك؟

273
00:17:55,060 --> 00:17:57,610
!يا لها من فتاة مُبهِجة

274
00:17:58,600 --> 00:18:00,310
من أيّ ناحية؟

275
00:18:00,310 --> 00:18:03,350
،لديك عادة إثارة مشاكل مع النّساء

276
00:18:03,350 --> 00:18:05,770
...لذا كنتُ قلقاً بعض الشّيء، لكن

277
00:18:05,770 --> 00:18:09,210
أنا أجمع معلومات بناء على أوامرك أنت

278
00:18:09,210 --> 00:18:12,560
أعتقد ستصبحان زوجين رائعين، أليس كذلك؟

279
00:18:14,780 --> 00:18:16,870
سنُصبح زوجين رائعين؟

280
00:18:26,890 --> 00:18:28,920
مضى شهران منذ زواجنا

281
00:18:28,920 --> 00:18:32,430
أتناول الفطور مع تلك الفتاة
،في كلّ صباح ببساطة

282
00:18:32,430 --> 00:18:34,130
ثمّ تُودّعني

283
00:18:34,130 --> 00:18:36,640
عندما أعود، تكون حاضرة للتّرحيب بي

284
00:18:37,160 --> 00:18:39,210
وأنا أقبل الأمر، هذا كُلّ شيء

285
00:18:41,200 --> 00:18:42,640
...أنا متأكّد بأنّني

286
00:18:42,640 --> 00:18:46,210
"لا أفهم هذا الشّيء الّذي يُدعى "منزل

287
00:18:48,140 --> 00:18:50,400
مولايّ، أهلاً بعودتك

288
00:18:52,540 --> 00:18:54,900
إنّها ليست هنا للتّرحيب بي اليوم؟

289
00:18:55,660 --> 00:18:57,910
مولاتي تنتظرك في قاعة الطّعام

290
00:18:59,310 --> 00:19:00,470
فهمت

291
00:19:03,200 --> 00:19:06,920
يبدو وكأنّ... الإضاءة في كلّ أنحاء
المنزل خافتة

292
00:19:30,340 --> 00:19:34,440
!زوجي العزيز! عيد ميلاد سعيد

293
00:19:36,490 --> 00:19:38,190
...عـ-عيد ميلادك

294
00:19:38,570 --> 00:19:39,930
هو اليوم، أليس كذلك؟

295
00:19:39,930 --> 00:19:40,970
أجل، صحيح

296
00:19:40,970 --> 00:19:42,660
!يسرّني هذا

297
00:19:43,450 --> 00:19:45,110
افتحها من فضلك

298
00:19:57,460 --> 00:19:58,970
هل أنتِ من طرّزَه؟

299
00:19:58,970 --> 00:20:01,970
أجل، صحيح

300
00:20:03,970 --> 00:20:05,530
،عندما عشتُ مع والدَي

301
00:20:05,530 --> 00:20:08,480
كنّا نحتفل هكذا كعائلة في كلّ عام

302
00:20:08,480 --> 00:20:12,410
بالنّسبة لي، عيد الميلاد هو
...دوماً يوم حماسيّ

303
00:20:13,290 --> 00:20:16,490
...وأنت وأنا أصبحنا عائلة، لذا

304
00:20:18,830 --> 00:20:22,680
،أردتُ الاحتفال بطريقة مُشابهة

305
00:20:23,660 --> 00:20:29,250
لذا نويتُ أن تكون هذه حفلة
مُفاجئة بوجودنا بمفردنا فقط

306
00:20:30,750 --> 00:20:33,750
هل تطفّلتُ زيادة عن اللّزوم؟

307
00:20:34,470 --> 00:20:36,760
هل كان هذا انتهاكاً لاتّفاقنا؟

308
00:20:43,750 --> 00:20:45,770
لا، لا أُمانع

309
00:20:48,520 --> 00:20:50,520
تفاجأتُ قليلاً فحسب

310
00:20:50,940 --> 00:20:53,140
!إذاً، كانت مُفاجأتي ناجحة

311
00:20:55,380 --> 00:21:00,550
!زوجي العزيز، عيد ميلاد 24 سعيد

312
00:21:09,510 --> 00:21:10,990
شكراً لكِ