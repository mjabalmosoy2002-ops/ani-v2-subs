601
00:45:44,420 --> 00:45:45,750
.ساعداني

602
00:45:45,750 --> 00:45:48,290
.لديهم قفل معقّد لهذا النّظام

603
00:45:48,290 --> 00:45:51,620
.إنّه يأخذ وقتًا لإعادة تأسيس التّحكّم بثبات المستعمرة

604
00:45:51,620 --> 00:45:52,480
.أكيد، أكيد

605
00:45:54,940 --> 00:45:56,590
.من الأفضل أن نسرع

606
00:45:56,590 --> 00:45:58,980
.يبدو أنّهم قد بدؤوا إرسال القوّات للأرض

607
00:45:59,560 --> 00:46:01,800
.لا أستطيع فتح القفل الأخير

608
00:46:01,800 --> 00:46:03,950
.سيكون علينا إعادة وصل الخطوط مباشرة

609
00:46:04,800 --> 00:46:07,370
يوجد العديد من الأصدقاء الّذين
.عملتُ معهم على هذه المستعمرة

610
00:46:07,970 --> 00:46:11,540
عندما أدركت ما كانت خطط دكيم
،الأصليّة وراء عمليّة النّيزك

611
00:46:12,080 --> 00:46:14,160
وجدت أنّ هذه هي الطّريقة
.الوحيدة لوضع حدّ له

612
00:46:14,650 --> 00:46:17,730
.لكنّ الوصول إلى هنا أخذ منّي وقتًا كثيرًا

613
00:46:18,060 --> 00:46:19,120
ماذا عن ووفي؟

614
00:46:19,550 --> 00:46:23,130
هل أصبح جنديّ ماريميا لحصول
على خططهم فحسب؟

615
00:46:23,570 --> 00:46:25,800
.كلاّ، إنّه يكره الطّرق الملتوية

616
00:46:31,410 --> 00:46:32,780
.حسنًا، انتهينا

617
00:46:33,210 --> 00:46:34,020
.هذا ديو

618
00:46:35,650 --> 00:46:37,370
!هل أنت واثق تمامًا؟

619
00:46:37,370 --> 00:46:39,320
!أوقفتم عمليّة النّيزك؟

620
00:46:43,820 --> 00:46:45,310
.معكم ريح

621
00:46:45,310 --> 00:46:46,740
!سأدمّر إم أو 3

622
00:47:02,810 --> 00:47:04,190
!تأخّرتَ كثيرًا

623
00:47:04,190 --> 00:47:05,050
!إلى الملتقى

624
00:47:11,720 --> 00:47:13,270
.تأخّرنا كثيرًا

625
00:47:13,270 --> 00:47:14,180
.لا تقلق حيال الأمر

626
00:47:14,640 --> 00:47:17,140
.تمكّنّا على الأقلّ من إنقاذ المستعمرة

627
00:47:17,140 --> 00:47:19,310
.إنّكم محاصرون بالكامل

628
00:47:19,310 --> 00:47:20,570
.اخرجوا وأيديكم مرفوعة

629
00:47:21,000 --> 00:47:22,070
.انتهى الأمر

630
00:47:22,460 --> 00:47:24,290
.ليس تمامًا

631
00:47:24,660 --> 00:47:26,280
.وصلتني رسالة من كاتر

632
00:47:26,930 --> 00:47:28,160
.معكم كاتر

633
00:47:28,570 --> 00:47:32,290
.أعدت توجيه قمر التّخلّص من الموارد التّابع نحو الأرض

634
00:47:32,290 --> 00:47:35,700
.سيصل إلى مدار الأرض خلال 24 ساعة

635
00:47:36,110 --> 00:47:38,470
.ديو، ابعث رسالة لكاتر

636
00:47:38,950 --> 00:47:42,800
أخبره أن يرسل بذلة الجناح صفر
.اتّجاه إتش إي إس 88

637
00:47:42,800 --> 00:47:43,550
!ماذا؟

638
00:47:44,130 --> 00:47:45,610
.سأستلم الجناح صفر في الفضاء

639
00:47:46,140 --> 00:47:48,010
.سنوفّر الوقت هكذا

640
00:47:48,620 --> 00:47:49,670
!افتحوا الباب

641
00:47:49,670 --> 00:47:50,470
!افتحوا

642
00:47:51,120 --> 00:47:53,380
.بإمكانك أخذ المكّوك الّذي في الحظيرة الرّابعة

643
00:47:53,880 --> 00:47:56,720
.ديو، لديّ طلب آخر منك

644
00:47:57,060 --> 00:47:58,710
.هذا ليس من عادتك

645
00:47:58,710 --> 00:48:01,210
.أراك تقدّم طلبات كثيرة فجأة

646
00:48:01,210 --> 00:48:02,490
!اضربني

647
00:48:02,490 --> 00:48:04,090
!ما-ماذا قلت؟

648
00:48:04,400 --> 00:48:05,070
!طفح الكيل

649
00:48:05,070 --> 00:48:06,790
!دمّروا الباب

650
00:48:06,790 --> 00:48:07,530
!أسرع

651
00:48:08,470 --> 00:48:10,310
.هذا مفهوم

652
00:48:10,810 --> 00:48:12,990
!سألكمك بكلّ ما لديّ

653
00:48:17,150 --> 00:48:18,710
...ما-ما الّذي

654
00:48:19,120 --> 00:48:20,610
.هذا من أجل صالحنا

655
00:48:20,610 --> 00:48:21,920
.صرنا متساويين الآن

656
00:48:23,820 --> 00:48:25,070
.إنّه في عهدتك

657
00:48:25,070 --> 00:48:25,730
.حسنًا

658
00:48:31,500 --> 00:48:32,730
.لا تقلقوا

659
00:48:32,730 --> 00:48:34,220
.تولّيت أمره

660
00:48:34,220 --> 00:48:36,210
.لكنّه منع عدم استقرار المستعمرة

661
00:48:38,500 --> 00:48:39,480
!توقّف

662
00:48:40,010 --> 00:48:41,230
!تمهّل

663
00:49:01,790 --> 00:49:02,820
...زيكس

664
00:49:19,410 --> 00:49:20,560
أهذه أنت يا نوين؟

665
00:49:22,720 --> 00:49:24,520
.أتيت لاصطحابك

666
00:49:25,150 --> 00:49:26,180
.شكرًا

667
00:49:28,520 --> 00:49:30,740
.نوين، أرى أنّك بخير

668
00:49:31,690 --> 00:49:32,620
.نعم

669
00:49:33,660 --> 00:49:36,700
.زيكس، مرّت سنة ويومان

670
00:49:42,130 --> 00:49:45,500
.في كريسماس العام 196 بعد المستعمرات

671
00:49:46,440 --> 00:49:50,920
استولى جيش ماريميا على الإقامة
.الرّئاسيّة لأمّة المجال الأرضيّ المتّحدة

672
00:49:51,460 --> 00:49:53,550
،ومع استمرار تساقط الثّلج

673
00:49:53,550 --> 00:49:56,570
.انتهى السّلام على الأرض بعد سنة واحدة قصيرة

674
00:49:56,570 --> 00:50:01,770
،و"المانعين" الّذين يُعتبرون وسيلة الانتقام الوحيدة

675
00:50:01,770 --> 00:50:03,940
.كانوا معدومي الحيلة ليشكّلوا أيّ فرق

676
00:50:05,850 --> 00:50:15,130
ما دام بمقدورنا النّظر لأعين بعضنا ونفهم

677
00:50:15,440 --> 00:50:25,120
فإنّ البشر سيواصلون العيش بحرّيّة وبدون تردّد

678
00:50:25,390 --> 00:50:34,390
عندما نتجاوز أخطاءنا، يمكننا العيش لطيبة حقيقيّة

679
00:50:35,030 --> 00:50:44,570
اكتشفنا أنا وأنت قوّة عظيمة نعرفها باسم الحبّ

680
00:50:44,640 --> 00:50:46,640
...أنا أؤمن بحبّك

681
00:50:46,640 --> 00:50:48,770
...أرتعش

682
00:50:49,140 --> 00:50:53,670
وأتمنّى أمنية صامتة بقبلة

683
00:50:53,720 --> 00:50:56,200
،عدني بهذا

684
00:50:56,310 --> 00:50:58,820
...لا تنس رجاءً

685
00:50:58,990 --> 00:51:03,620
...أنت توجد بداخلي، وأنا أوجد بداخلك

686
00:51:03,790 --> 00:51:05,980
،أؤمن بأحلامك

687
00:51:06,010 --> 00:51:08,200
...بمشاعري المتزايدة تجاهك

688
00:51:08,260 --> 00:51:12,940
...سأغيّر هذا الشّوق لصلوات لك

689
00:51:12,840 --> 00:51:13,840
.وصلت

690
00:51:13,070 --> 00:51:17,840
...ليتك تستطيع سماع نبض قلبي

691
00:51:18,170 --> 00:51:21,340
...يخفق بقوّة وشدّة

692
00:51:21,360 --> 00:51:27,730
...بعيدًا جدًّا

693
00:51:46,270 --> 00:51:53,140
...لن نكسب شيئًا ولن يظلّ أحد

694
00:51:53,210 --> 00:51:56,670
...دعني أعرض ليد الرّضيع الصّغيرة

695
00:51:56,750 --> 00:52:00,240
قلبي الخافق الحقيقيّ هذا

696
00:52:00,520 --> 00:52:07,320
نودّ جميعًا أن نُحتضن في دفء نفيس للأبد

697
00:52:07,590 --> 00:52:14,720
كدفء نور الشّمس بينما يشعّ عبر الغابة

698
00:52:14,800 --> 00:52:16,210
،أؤمن بحبّك

699
00:52:16,210 --> 00:52:21,560
بإرادة عدم الاستسلام أبدًا بينما تفرد
تلك الأجنحة المكسورة والمجروحة

700
00:52:21,640 --> 00:52:27,360
...تحلّق عبر السّماوات وتُظهر حلمًا أبديًّا

701
00:52:50,670 --> 00:52:51,690
.هيرو

702
00:53:13,580 --> 00:53:16,630
إغلاق البوّابة 1، إغلاق البوّابة 2

703
00:53:17,050 --> 00:53:18,550
.إغلاق البوّابتان 3 و4

704
00:53:18,770 --> 00:53:20,660
.إغلاق البوّابتان 5 و6

705
00:53:20,970 --> 00:53:23,310
!تمّ تحصين الإقامة الرّئاسيّة في بروكسل

706
00:53:26,240 --> 00:53:28,970
.إنّ قلعني محميّة بالكامل الآن

707
00:53:29,410 --> 00:53:31,120
ألا تجدين الأمر غريبًا؟

708
00:53:31,120 --> 00:53:35,690
لماذا قد يكون ملجأ كهذا ضروريًّا
في عالم مسالم بدون أسلحة؟

709
00:53:37,910 --> 00:53:42,120
.إنّ التّاريخ أشبه برقصة فالس أبديّة

710
00:53:42,890 --> 00:53:47,110
.تتواصل إيقاعات الحرب والسّلام والثّورة الثّلاثة للأبد

711
00:53:47,670 --> 00:53:51,730
.ولكن، سيتغيّر التّاريخ بتتويجي

712
00:53:52,230 --> 00:53:56,360
في اللّحظة الّتي سينتهي فيها
...العام 196 بعد المستعمرات

713
00:53:56,360 --> 00:53:59,250
.سأكون على قمّة المجال الأرضيّ

714
00:53:59,250 --> 00:54:02,170
.وسيبدأ عصر جديد

715
00:54:14,230 --> 00:54:16,360
!ستسقطون هذه المستعمرة على الأرض؟

716
00:54:17,850 --> 00:54:18,970
!هذا عبث لا غير

717
00:54:18,970 --> 00:54:21,900
!أقود بذلة ناتاكو لدحر الشّرّ من الكون

718
00:54:22,360 --> 00:54:26,310
.قرّر التّحالف سلفًا التّخلّص من هذه المستعمرة

719
00:54:26,310 --> 00:54:30,650
فبدل المشاهدة فحسب، فسيكون
.من الأفضل البدء بعمليّة النّيزك

720
00:54:30,650 --> 00:54:33,530
!كلّ ما نحتاج فعله هو هزيمة العدوّ الضّروريّ

721
00:54:37,970 --> 00:54:40,920
!سأدمّر كلّ الشّرّ بعدل وإنصاف

722
00:54:49,850 --> 00:54:50,810
.ها هو ذا

723
00:55:05,150 --> 00:55:07,910
.لن أسمح لك بالذّهاب للأرض

724
00:55:12,470 --> 00:55:14,460
أهذا هو ما تعتبره عدالة؟

725
00:55:14,990 --> 00:55:17,120
عليّ أن أحدّد بنفسي

726
00:55:17,120 --> 00:55:21,370
سواء كان السّلام على حساب أرواح
!النّاس يُعتبر سلامًا أم لا

727
00:55:27,490 --> 00:55:30,130
!وسأصير الشّرّ بعينه لاكتشاف ذلك

728
00:55:32,560 --> 00:55:34,550
.لم تتغيّر البشريّة

729
00:55:34,550 --> 00:55:38,730
!هُزم كلّ الأعداء، لكنّ الأرض لم تتغيّر البتّة

730
00:56:24,310 --> 00:56:25,360
ما الخطب؟

731
00:56:26,820 --> 00:56:28,080
!ما هذا الدّخان؟

732
00:56:29,120 --> 00:56:29,860
ما الخطب؟

733
00:56:37,160 --> 00:56:38,420
.أنا آسفة

734
00:56:39,230 --> 00:56:41,250
.أحتاج لتنويمكم لبعض الوقت فحسب

735
00:56:50,870 --> 00:56:52,410
.أرى أنّ جميعكم بخير

736
00:57:02,620 --> 00:57:04,000
.حسنًا

737
00:57:04,000 --> 00:57:06,310
.على كاتر أن يصل في أيّ لحظة الآن

738
00:57:08,820 --> 00:57:09,550
ما هذا؟

739
00:57:23,270 --> 00:57:24,190
!مرحبًا

740
00:57:24,190 --> 00:57:25,990
!كان بمقدورك على الأقلّ أن تأتي لمساعدتي

741
00:57:26,340 --> 00:57:29,580
.لا عيب أبدًا في إنقاذ صديق في محنة

742
00:57:29,960 --> 00:57:31,470
.لم أكن أنتظرك

743
00:57:32,100 --> 00:57:33,060
.لكن أنتظر شخصًا آخر

744
00:57:33,970 --> 00:57:34,770
!آسفة على التّأخير

745
00:57:35,220 --> 00:57:37,680
!تمّ إنقاذ كلّ الرّهائن على هذه المستعمرة

746
00:57:38,190 --> 00:57:39,390
.لنذهب إذًا

747
00:57:39,730 --> 00:57:40,610
.فهمت، فهمت

748
00:57:40,610 --> 00:57:42,440
.إذًا فقد كنتَ تقصدها هي

749
00:57:42,440 --> 00:57:43,790
.شكرًا لك يا ديو

750
00:57:43,790 --> 00:57:46,610
.كنتَ طيّبًا كفاية لتترك لي خلفك وليمة بأكملها

751
00:57:46,610 --> 00:57:49,110
.كلامك هذا قاس جدًّا إن كان مزاحًا

752
00:57:49,110 --> 00:57:51,150
،لكن إن كنت تتهكّمين فحسب
!فذلك أسوأ بكثير

753
00:58:14,220 --> 00:58:18,510
كلّما قاتلت أكثر، صارت التّضحيات
.من أجل السّلام خسارة أكثر فأكثر

754
00:58:18,510 --> 00:58:20,030
!عليك أن تدرك ذلك

755
00:58:31,470 --> 00:58:33,460
!انتهت الحرب الّتي قاتلناها

756
00:58:33,460 --> 00:58:35,060
لا نحتاج لمحاربين إذًا؟

757
00:58:35,060 --> 00:58:37,910
هل سيُلقى بالجنود الّذين لا يعرفون
سوى القتال جانبًا فحسب؟

758
00:58:40,220 --> 00:58:43,500
!قاتل الجنود لاكتساب حسّ من السّلام

759
00:58:43,500 --> 00:58:45,210
!ثق بالعالم الّذي نعيش فيه

760
00:58:48,670 --> 00:58:52,280
!أقوم بهذا من أجل النّاس الّذين استُعملوا كأسلحة

761
00:58:52,280 --> 00:58:55,300
!أنا أقاتل من أجل كلّ الجنود، بمن فيهم أنت

762
00:58:56,630 --> 00:58:57,580
.ووفي

763
00:58:57,580 --> 00:59:00,090
.أنا وأنت نتقاتل هكذا

764
00:59:00,090 --> 00:59:03,980
ألا تشعر بالرّضا كما أشعر أنا عندما تقاتل؟

765
00:59:04,520 --> 00:59:06,460
!أنا وأنت متشابهان

766
00:59:06,460 --> 00:59:10,240
!بإمكاننا الاعتراف بوجودنا فقط في ساحات المعركة

767
00:59:14,250 --> 00:59:16,660
!تذكّر فحسب يا ووفي، مات تيريز

768
00:59:16,660 --> 00:59:18,200
!هزمتَه سلفًا

769
00:59:18,200 --> 00:59:19,620
!أنت مخطئ

770
00:59:19,620 --> 00:59:21,950
!ما زلت أقاتله حتّى الآن

771
00:59:35,940 --> 00:59:36,890
.زيكس

772
00:59:36,890 --> 00:59:39,790
!تمّ تحصين الإقامة الرّئاسيّة في بروكسل

773
00:59:39,790 --> 00:59:41,230
!لا يمكننا اختراقها

774
00:59:41,230 --> 00:59:42,690
!أدرك ذلك

775
00:59:42,690 --> 00:59:46,310
،لكن ما لم أقوم بما أستطيع
!فلن يقف أيّ أحد في وجههم

776
00:59:50,590 --> 00:59:52,370
من تنتظر؟

777
00:59:52,370 --> 00:59:54,510
.شخص يأمل بالسّلام

778
00:59:54,510 --> 00:59:59,950
،إن سمح النّاس لماريميا بالقيام بما يحلو لها
.فسيسمحون بولادة ملياردو بيسكرافت ثانٍ

779
01:00:16,410 --> 01:00:16,990
.نوين

780
01:00:17,400 --> 01:00:19,530
.ليس عليك البقاء إلى جانبي

781
01:00:19,530 --> 01:00:20,170
.كلاّ

782
01:00:20,170 --> 01:00:24,210
.أخبرتك قبل سنة أنّني لن أتركك أبدًا

783
01:00:25,450 --> 01:00:27,010
.انتظرت كلّ هذا الوقت

784
01:00:27,440 --> 01:00:29,780
.وما عدت أريد الانتظار أكثر

785
01:00:30,690 --> 01:00:31,610
.مفهوم

786
01:00:46,540 --> 01:00:49,130
.لا أوافق على أساليب ريلينا بيسكرافت

787
01:00:49,480 --> 01:00:54,040
إنّ اعتقادها أنّ السّلام ينبع من التّخلّي
!عن الأسلحة وتقييد الجنود خاطئ

788
01:00:54,750 --> 01:00:57,010
!ولهذا السّبب تسمح باستبداد ماريميا؟

789
01:00:57,010 --> 01:01:00,430
!هناك تتجمّع أرواح من يقاتلون

790
01:01:02,800 --> 01:01:04,430
...قد يكون لا بأس بذلك الآن

791
01:01:04,430 --> 01:01:07,560
!لكن سينتهي الأمر بماريميا وهي تعيد التّاريخ

792
01:01:07,560 --> 01:01:09,890
.تاريخ مليء بالحروب البائسة

793
01:01:10,370 --> 01:01:15,420
ما لم نوقف سير هذه الأحداث، فسيصبح
.المزيد من الجنود مثلنا حاجة لا بدّ منها

794
01:01:15,420 --> 01:01:19,160
إن حدث ذلك، فسيواصل تاريخ
.من المآسي تكرار نفسه

795
01:01:20,710 --> 01:01:22,560
.أخبرني يا ووفي

796
01:01:22,560 --> 01:01:24,490
كم من الأشخاص علينا أن نقتل بعد؟

797
01:01:30,020 --> 01:01:33,780
كم مرّة عليّ أن أقتل تلك الفتاة وكلبها؟

798
01:01:40,760 --> 01:01:43,050
.لن تخبرني صفر بأسّ شيء

799
01:01:43,570 --> 01:01:45,470
!فأخبرني أنت يا ووفي

800
01:02:14,000 --> 01:02:17,030
هل على حدث كذاك أن يتكرّر؟

801
01:02:23,170 --> 01:02:25,050
هل أنتما مستعدّان للذّهاب؟

802
01:02:25,050 --> 01:02:27,010
!نعم، جاهز في أيّ وقت

803
01:02:27,550 --> 01:02:30,100
.هذا ما يجب أن كون عليه عمليّة النّيزك

804
01:02:30,710 --> 01:02:31,600
!هيّا بنا

805
01:02:49,100 --> 01:02:52,180
!تالغيس وبذلة ثور تجاوزتا دفاعات النّقطة دي رقم 3

806
01:02:52,180 --> 01:02:54,150
!ما الّذي بإمكانهم فعله ببذلتين فحسب؟

807
01:02:54,150 --> 01:02:56,720
.أرسلوا قوّاتنا الهجوميّة المتبقّية إلى النّقطة دي

808
01:02:56,720 --> 01:02:57,460
!عُلم

809
01:02:58,210 --> 01:03:02,070
.يبدو أنّ اللّقاء بين شقيقين سيكون صعبًا هذه المرّة

810
01:03:04,510 --> 01:03:08,970
إنّنا نواجه حمقى يتمرّدون ضدّ النّظام
.الجديد بشكل ميؤوس منه

811
01:03:10,020 --> 01:03:15,670
.ضعوا في اعتباركم أهمّيّة الأرواح الّتي سنفقدها

812
01:03:15,670 --> 01:03:16,470
.جدّي

813
01:03:16,470 --> 01:03:18,760
.ظننتُ أنّه لن تكون هنالك حروب أخرى

814
01:03:18,760 --> 01:03:19,710
.هذا صحيح

815
01:03:21,560 --> 01:03:24,650
إذًا، لماذا ما زال هؤلاء يتحاربون؟

816
01:03:25,230 --> 01:03:29,960
.لسوء الحظّ، ليس كلّ من في العالم بمثل تعقّلك

817
01:03:32,470 --> 01:03:35,070
.بل في الحقيقة، النّاس متعقّلون أكثر من اللاّزم

818
01:03:35,560 --> 01:03:38,830
.قلّة فقط من النّاس يردّون بالمثل على ماريميا

819
01:03:42,320 --> 01:03:44,530
هل تعتقد أنّ هذه هي مُثُل تيريز؟

820
01:03:45,620 --> 01:03:49,260
.إنّها لا تدرك أنّها مجرّد دمية بين يدي دكيم فحسب

821
01:04:35,330 --> 01:04:36,480
.هذه هي

822
01:04:36,480 --> 01:04:38,640
!لا كلمات وداع لديّ لأقوله بعد يا زيكس

823
01:04:38,640 --> 01:04:39,650
!بكلّ تأكيد

824
01:04:47,950 --> 01:04:49,820
.أنا سعيد لأنّنا لم نأت بعد فوات الأوان

825
01:04:50,920 --> 01:04:51,890
!كاتر؟

826
01:04:58,190 --> 01:05:00,500
.إنّكما مثيران للإعجاب بالفعل

827
01:05:00,500 --> 01:05:03,120
.قاتلتما كلّ هذا العدد دون قتل جنديّ واحد

828
01:05:03,460 --> 01:05:06,800
سأكون سعيدة إن استطعنا تعليم
.هؤلاء النّاس شيئًا ما

829
01:05:18,080 --> 01:05:22,480
!لنأخذ الأسلحة والحرب بحدّ ذاتها للجحيم معنا

830
01:05:38,670 --> 01:05:40,160
.بقي حوالي 250

831
01:05:40,690 --> 01:05:42,170
.أي 50 بذلة لكلّ واحد

832
01:05:42,590 --> 01:05:45,260
.إن كان هذا كلّ شيء، فسنتمكّن من تدبّر أمورنا

833
01:05:50,350 --> 01:05:51,630
!بذل غاندام؟

834
01:05:53,780 --> 01:05:57,240
إلى متى سيواصل أولئك الأشقياء
!الوقوف في طريقي؟

835
01:05:57,950 --> 01:06:02,710
،حتّى إن دمّروا البذل المتنقّلة فعلاً
.فمن المستحيل أن يخترقوا هذا الملجأ

836
01:06:03,280 --> 01:06:05,760
.لا طائل ممّا يحالون فعله

837
01:06:08,960 --> 01:06:10,160
...إنّني

838
01:06:10,470 --> 01:06:11,860
ما الخطب يا ريلينا؟

839
01:06:15,680 --> 01:06:17,170
...إنّني

840
01:06:20,080 --> 01:06:21,790
!إنّني كنت أهرب من الحقيقة

841
01:06:26,380 --> 01:06:27,370
!أيّها النّاس

842
01:06:27,370 --> 01:06:29,800
!لا تخشوا هذا البثّ الّذي تشاهدونه

843
01:06:31,120 --> 01:06:34,040
.السّلام ليس شيئًا سُلّم إليكم ببساطة

844
01:06:34,040 --> 01:06:35,260
...على كلّ شخص أن

845
01:06:35,900 --> 01:06:37,580
!مهلاً، ألم تكن...؟

846
01:06:37,580 --> 01:06:39,290
!إنّها الملكة ريلينا

847
01:06:40,300 --> 01:06:44,440
ما زال الوقت باكرًا لتظهري نفسك
.للنّاس أيّتها الملكة السّابقة

848
01:06:46,380 --> 01:06:49,230
هل ترشدين العامّة إلى معركة؟

849
01:06:49,740 --> 01:06:53,110
!ألا يعارض ذلك سياسات السّلام الكامل؟

850
01:06:53,650 --> 01:06:56,120
.لم أعد بيسكرافت

851
01:06:56,120 --> 01:07:00,200
.ما نحتاجه الآن ليس مبدأ أو دافعًا

852
01:07:00,200 --> 01:07:01,790
.بل قلبًا يؤمن بالسّلام

853
01:07:11,010 --> 01:07:13,720
هل ستواصلون الجلوس دون تحريك ساكن فحسب؟

854
01:07:13,720 --> 01:07:14,550
ماذا؟

855
01:07:14,550 --> 01:07:18,680
.ماريميا هي السّيّد الّذي كنتم تنتظرونه دائمًا

856
01:07:19,350 --> 01:07:21,930
.هيّا، لوّحوا بذيولكم فرحًا واركضوا إليها

857
01:07:22,930 --> 01:07:25,270
!هل تشبّهيننا بالكلاب؟

858
01:07:25,270 --> 01:07:27,230
.ماذا؟ أستسمحك عذرًا

859
01:07:27,230 --> 01:07:28,400
.دعني أصحّح كلامي

860
01:07:28,810 --> 01:07:32,110
.إنّكم لستم كلابًا تلوّح بذيولها أمام سيّدها

861
01:07:32,820 --> 01:07:34,820
!أنتم الذّيول بحدّ ذاتها

862
01:07:35,070 --> 01:07:36,910
!أغلقي فمك

863
01:07:36,910 --> 01:07:41,410
أنت تنظرين إلى رجل أسقط خمسة
!بذل متنقّلة في الحرب قبل سنة

864
01:07:41,410 --> 01:07:44,830
.لا يهمّ، فلا أرى أيّ رحال هنا

865
01:07:45,120 --> 01:07:50,290
الرّجال الوحيدون الّذين أعرفهم إمّا
!دُفنوا أو في ذلك البثّ على الشّاشة

866
01:08:42,140 --> 01:08:45,230
...السّلام ليس شيئًا سُلّم إلينا ببساطة

867
01:08:51,400 --> 01:08:53,610
.أظنّ أنّنا كنّا مخطئين

868
01:08:54,070 --> 01:08:55,070
.معك حقّ

869
01:08:55,440 --> 01:08:57,400
.نحن من يجدر بنا أن نقاتل

870
01:08:57,490 --> 01:08:59,950
.وبالطّبع، لن نستعمل أيّ أسلحة للقتال

871
01:09:00,490 --> 01:09:03,410
هل هذه هي المسؤوليّة
الّتي منحت لنا نحن النّاجين؟

872
01:09:04,280 --> 01:09:10,080
علينا إثبات أنّنا نستحقّ هذا السّلام
.الّذي عملنا بجدّ لتحقيقه

873
01:09:10,460 --> 01:09:13,960
.علينا تأكيد أنّنا جديرون بهذه الحرّيّة

874
01:09:15,000 --> 01:09:16,710
!حسنًا، أنا ذاهب

875
01:09:16,710 --> 01:09:19,590
!سأذهب إلى ريلينا في الإقامة الرّئاسيّة

876
01:09:19,590 --> 01:09:20,720
تقصد الآن؟

877
01:09:20,720 --> 01:09:21,510
!نعم

878
01:09:21,510 --> 01:09:22,390
لكن كيف؟

879
01:09:22,390 --> 01:09:23,600
!سنجد طريقة ما

880
01:09:23,600 --> 01:09:24,850
!سأذهب أيضًا

881
01:09:24,850 --> 01:09:27,730
!لا أستطيع الانتظار دون فعل أيّ شيء

882
01:09:27,730 --> 01:09:29,060
!وأنا معكم أيضًا

883
01:09:29,060 --> 01:09:31,100
!ليتبعنا البقيّة فحسب

884
01:09:31,100 --> 01:09:32,690
!حسنًا، أنا معكم أيضًا

885
01:09:32,930 --> 01:09:34,110
!سأذهب أيضًا

886
01:09:34,110 --> 01:09:35,270
!وأنا كذلك

887
01:09:35,270 --> 01:09:36,980
!حان الوقت لنقاتل من أجل شيء ما

888
01:09:36,980 --> 01:09:38,110
!هل سنصل إلى هناك في الوقت المناسب؟

889
01:09:38,570 --> 01:09:40,700
.أظنّ أنّ لا خيار أمامي

890
01:09:41,360 --> 01:09:45,450
.اسمحوا لي أن أوصلكم جميعًا بمركبتي

891
01:10:39,550 --> 01:10:40,920
!خذ هذا

892
01:10:57,560 --> 01:10:58,480
!تبًّا

893
01:10:58,480 --> 01:11:00,520
!إنّهم يتوافدون علينا دفعة واحدة

894
01:11:05,490 --> 01:11:06,700
!ها أنا ذا

895
01:11:23,380 --> 01:11:26,510
.يبدو أنّنا نقاتل في معركة خاسرة أخرى

896
01:12:08,050 --> 01:12:09,010
.صفر

897
01:12:09,350 --> 01:12:10,430
أيمكنك الحراك؟

898
01:12:23,280 --> 01:12:24,230
.أكيد

899
01:12:24,860 --> 01:12:26,740
.سيكون هذا قتالك الأخير

900
01:12:56,180 --> 01:12:58,980
!يا ربابنة الغاندام... هذا يكفي

901
01:12:58,980 --> 01:13:00,350
.اتركونا وانسحبوا

902
01:13:00,350 --> 01:13:01,560
!نـ-ننسحب؟

903
01:13:05,570 --> 01:13:08,950
.إن كنّا نقاتل بدافع القتل، لكنّا قد انتهينا منذ زمن

904
01:13:08,950 --> 01:13:11,820
!لكن سيكون المجيء إلى هنا بلا طائر في النّهاية

905
01:13:13,830 --> 01:13:15,950
!على هذا المعدّل، ستموتان هباءً

906
01:13:18,710 --> 01:13:22,080
.إن كنّا نخطّط للتّراجع، لكنّا قد غادرنا سلفًا

907
01:13:22,080 --> 01:13:25,050
.لكن أعلم أنّه سيكون من الصّعب مواصلة القتال

908
01:13:31,800 --> 01:13:34,180
.اعتدنا أن نكون مثلهم تمامًا

909
01:13:34,180 --> 01:13:38,180
.أقنعهم دكيم بالإيمان أنّ القتال هو سبب عيشهم

910
01:13:38,180 --> 01:13:39,060
...لكن

911
01:13:39,060 --> 01:13:41,690
.لا داعي للقلق حيال هذا

912
01:13:41,690 --> 01:13:44,610
!صرنا محترفين في مثل هذه المعارك الخاسرة

913
01:13:51,200 --> 01:13:55,030
.لهذا السّبب بإمكاننا دائمًا أن نكون صادقين مع أنفسنا

914
01:13:55,450 --> 01:13:59,500
.لم أعد لحمل اسم دارليان لأنتقم لوالدي

915
01:13:59,960 --> 01:14:02,080
.لا يمكن تحقيق أيّ شيء عبر الانتقام

916
01:14:02,080 --> 01:14:05,000
!لن تولّد الكراهية سوى المزيج من الكراهية

917
01:14:05,290 --> 01:14:08,670
.تفكّرين بتلك الطّريقة فقط لأنّك خسرتِ المعركة

918
01:14:08,670 --> 01:14:10,470
.لكنّني مختلفة

919
01:14:10,470 --> 01:14:12,630
.سأكون المنتصرة بالفعل

920
