1
00:00:01,810 --> 00:00:05,770
يبدو أنّ هنالك جواسيس لإيلوميناتي
.ضمن تنظيم الصّليب الحقيقيّ

2
00:00:06,560 --> 00:00:09,480
.اثنان في الفاتيكان، وواحد في فرع اليابان

3
00:00:09,480 --> 00:00:14,660
،كلّ ما نعرفه الآن هو عددهم
.لكنّ هذه معلومة جيّدة من أليفي

4
00:00:14,660 --> 00:00:15,570
...شورا

5
00:00:15,950 --> 00:00:18,580
.اكتشفي من الجاسوس في فرع اليابان

6
00:01:52,000 --> 00:01:54,510
"يوهان فاوست يقدّم"
"مهرجان كروس"

7
00:01:54,510 --> 00:01:57,010
"شروط المشاركة"
ثنائيّات من تلميذة وتلميذة"
"من أكاديميّة الصّليب الحقيقيّ

8
00:01:57,300 --> 00:02:00,140
!أتطلّع قدمًا للمهرجان المدرسيّ بشدّة

9
00:01:57,590 --> 00:02:03,180
الحلقة 3: مهرجان أكاديميّة الصّليب الحقيقيّ

10
00:02:00,140 --> 00:02:04,270
لأنّه لم أستطع أبدًا المشاركة في هذه الأشياء
!خلال المدرسة الابتدائيّة والإعداديّة

11
00:02:04,270 --> 00:02:06,390
أتريدين المجيء معي للحفل الرّاقص؟

12
00:02:06,390 --> 00:02:08,390
.أعتذر يا شيما-كُن

13
00:02:08,390 --> 00:02:10,900
.أتدري؟ هناك من سأرافقه سلفًا

14
00:02:10,900 --> 00:02:12,440
.هكذا إذًا

15
00:02:12,440 --> 00:02:13,900
!آسفة –
!أنا آسفة –

16
00:02:13,900 --> 00:02:15,400
!أنا آسفة –
!أنا جدّ آسفة –

17
00:02:15,400 --> 00:02:16,440
!آسفة –
!آسفة –

18
00:02:16,440 --> 00:02:17,820
!مهلاً يا شيما

19
00:02:17,820 --> 00:02:21,030
سبق وأخبرتُ أمميا-كُن أنّي أردت
!الذّهاب معه، وقد وافق بالفعل

20
00:02:21,030 --> 00:02:22,200
!لذلك أنا آسفة

21
00:02:24,330 --> 00:02:25,870
ما معنى هذا؟

22
00:02:26,200 --> 00:02:27,790
ومن هو أمميا هذا؟

23
00:02:28,040 --> 00:02:30,580
!أريد المشاركة في المهرجان مهما كلّف الأمر

24
00:02:30,580 --> 00:02:32,790
!سيكون هنالك الكثير من الفنّانين الكبار

25
00:02:32,790 --> 00:02:34,670
!لكن يجب الحضور برفقة فتاة

26
00:02:34,670 --> 00:02:37,760
...لا ترتاد شيمي هذه المدرسة، وإيزومو

27
00:02:37,760 --> 00:02:39,590
.لن أشارك فيه

28
00:02:40,550 --> 00:02:42,720
.لن أستطيع الذّهاب أيضًا

29
00:02:41,300 --> 00:02:44,850
!ليس لديّ أيّ صديقات أخريات

30
00:02:42,720 --> 00:02:44,850
.ليس وكأنّ هنالك فتيات يمكنني أن أسألهنّ

31
00:02:44,850 --> 00:02:45,560
.غباء

32
00:02:45,930 --> 00:02:47,270
ما بالكما؟

33
00:02:47,270 --> 00:02:48,930
!تتصرّفان وكأنّكما في جنازة

34
00:02:48,930 --> 00:02:50,020
!اسمعوا

35
00:02:50,020 --> 00:02:54,110
امتحان شهادة طاردي الأرواح الشّرّيرة
.السّنويّ بعد ثلاثة أشهر فقط

36
00:02:54,860 --> 00:02:57,110
!أريد النّجاح فيه من أوّل محاولة

37
00:02:57,400 --> 00:03:00,450
لمن السّيّئ أنّ المدرسة الخاصّة مغلقة
.وأنّنا متأخّرون في دروسنا

38
00:03:00,450 --> 00:03:03,620
وبما أنّ التّدريب العمليّ قد بدأ الآن
!في الدّورة الثّانية، ما عاد لدينا وقت

39
00:03:03,910 --> 00:03:04,910
.إلى اللّقاء

40
00:03:05,450 --> 00:03:06,700
.يا إلهي

41
00:03:07,790 --> 00:03:10,290
.هذه أوّل مرّة أتّفق فيها معها

42
00:03:10,290 --> 00:03:11,710
إلى أين ستذهب؟

43
00:03:11,710 --> 00:03:14,210
.لديّ تدريب أسلحة ناريّة

44
00:03:14,670 --> 00:03:18,510
بما أنّي أريد تجاوز امتحانَيْ الآريا
،والدراغون في نفس الوقت

45
00:03:18,510 --> 00:03:21,220
.فلا وقت لديّ للرّومانسيّة

46
00:03:22,220 --> 00:03:24,350
.جميعهم رائعون

47
00:03:25,800 --> 00:03:27,810
!إنّهم يفوّتون الكثير عليهم في هذه الحياة

48
00:03:28,520 --> 00:03:31,730
،صحيح أنّ الامتحان يُعقد مرّة في السّنة
!ولكن بالإمكان خوضه كلّ سنة

49
00:03:31,730 --> 00:03:35,690
بينما مهرجان المدرسة للسّنة الأولى
!هو أمر يحدث مرّة في العمر

50
00:03:36,320 --> 00:03:39,440
هل من الخطأ في الاستمتاع
بأيّام الصّبا القصيرة؟

51
00:03:39,440 --> 00:03:40,440
!كلاّ

52
00:03:40,860 --> 00:03:44,240
علينا أن نعيش وكأنّ شمس الغد لن تشرق
!بينما ما زالت تسمح لنا الفرصة

53
00:03:44,240 --> 00:03:45,070
...شيما

54
00:03:45,490 --> 00:03:46,620
!أنت محقّ تمامًا

55
00:03:46,620 --> 00:03:48,160
!اتّفقنا على شيء ما أخيرًا

56
00:03:48,160 --> 00:03:49,410
!أسأت الحكم عليك بالكامل

57
00:03:49,410 --> 00:03:52,830
"شكرًا يا أوكومورا-كُن! إلاّ أنّ "أسأت الحكم
!كانت عبارة قاسية، لذا لا تستعملها

58
00:03:55,880 --> 00:04:00,420
أوكومورا-كُن... يبدو أنّ كلانا
.نسي وجود امرأة مهمّة

59
00:04:00,420 --> 00:04:01,720
ماذا؟ من تقصد؟

60
00:04:02,010 --> 00:04:04,340
!ماذا؟ هذا ليس عادلاً يا شيما! عد

61
00:04:04,800 --> 00:04:07,180
!رائع! شكرًا

62
00:04:07,180 --> 00:04:10,980
لكن سبق وطلب منّي زميل في السّنة
.الثّالثة الذّهاب معه قبل قليل

63
00:04:11,310 --> 00:04:12,730
.هكذا إذًا

64
00:04:12,730 --> 00:04:14,730
!وها قد تلاشى أملنا الأخير

65
00:04:14,730 --> 00:04:16,770
!كلاّ! لن أستسلم بعد

66
00:04:16,770 --> 00:04:19,230
.سأعثر على فتاة بمفردي

67
00:04:19,230 --> 00:04:23,240
"منزل مسكون بالأشباح"

68
00:04:20,150 --> 00:04:23,240
.يبدو أنّ اليافعين مستمتعون بوقتهم

69
00:04:25,530 --> 00:04:28,120
ألن تنضمّ إلى البقيّة؟

70
00:04:39,090 --> 00:04:40,960
.تبًّا له

71
00:04:41,340 --> 00:04:43,340
.الاسم الحقيقيّ، تاكارا نيمو

72
00:04:43,340 --> 00:04:46,430
،ابن الرّئيس التّنفيذيّ لشركة الألعاب
.هوايات تاكارا

73
00:04:46,430 --> 00:04:49,260
.انضمّ لهذه الأكاديميّة منذ سنته الثّانية

74
00:04:49,260 --> 00:04:51,100
من يكون؟

75
00:04:52,890 --> 00:04:55,640
.صباح الخير يا أوكومورا-كُن

76
00:04:52,890 --> 00:04:55,640
بعد بضعة أيّام

77
00:04:55,640 --> 00:04:58,480
...بعد افتراقنا

78
00:04:58,480 --> 00:05:03,780
سألتُ حوالي عشرين فتاة لا أعرفهنّ
.حتّى، لكنّهنّ رفضنني جميعًا

79
00:05:04,400 --> 00:05:06,610
.الحياة صعبة

80
00:05:06,610 --> 00:05:09,030
.أذهلتني يا شيما

81
00:05:09,700 --> 00:05:12,950
.لقد فُطر قلبي بعد أن رفضتني فتاتان فقط

82
00:05:10,280 --> 00:05:12,290
!صباح الخير لكما

83
00:05:12,950 --> 00:05:16,580
أرى أنّكما تعانيان من متلازمة
.سير الأموات الأحياء

84
00:05:16,580 --> 00:05:17,290
!مهلاً يا سوغورو

85
00:05:17,580 --> 00:05:18,750
ما الخطب؟

86
00:05:18,750 --> 00:05:20,540
...أظنّ

87
00:05:20,880 --> 00:05:23,880
أنّ بون كان يشعر بالقلق
.حيال الحفل الرّاقص أيضًا

88
00:05:23,880 --> 00:05:25,720
ماذا؟ أستذهب يا سوغورو؟

89
00:05:25,720 --> 00:05:27,260
...في الحقيقة

90
00:05:27,260 --> 00:05:29,930
،طلبت منه فتاة من فصلنا الذّهاب معها

91
00:05:29,930 --> 00:05:33,270
.ولكنّها انفجرت باكية بعد أن رفض طلبها

92
00:05:33,270 --> 00:05:36,230
.لذلك تلقّت روحه ضررًا كبيرًا فحسب

93
00:05:36,230 --> 00:05:39,650
هل تمازحني؟ حتّى معاناته من مستوى
!مختلف تمامًا عن معاناتنا

94
00:05:39,650 --> 00:05:41,400
!أنت رائع جدًّا! كم أحسدك

95
00:05:41,400 --> 00:05:45,530
أنت غير مناسب لتكون برفقتنا
!نحن الموتى السّائرون

96
00:05:45,530 --> 00:05:51,620
ومِن أرواحنا نحن الرّجال المتعبون جميعًا ممّن
،علّقوا آمال صباهم على المهرجان المدرسيّ

97
00:05:51,620 --> 00:05:53,290
!نلعنك لعنًا

98
00:05:53,290 --> 00:05:57,790
أنتما هما الملعونان! انظرا لنفسيكما
!وأنتما تستسلمان لرغباتكما

99
00:05:57,790 --> 00:06:00,670
إنّ المهرجانات المدرسيّة كما
.لو كانت من صنيع شياطين المارا

100
00:06:01,000 --> 00:06:04,550
اسمحا لروحيكما على الأقلّ
.أن تحظى بنهاية مسالمة

101
00:06:05,550 --> 00:06:07,470
!كاتسو

102
00:06:07,470 --> 00:06:09,180
!صباح الخير لكم جميعًا

103
00:06:09,800 --> 00:06:11,260
...ماذا؟ مورياما-سان

104
00:06:11,260 --> 00:06:13,180
شيمي! ماذا تفعلين هنا؟

105
00:06:13,180 --> 00:06:15,180
...صحيح، أنا

106
00:06:15,890 --> 00:06:20,190
!سأصير زميلتكم في المدرسة بدءًا من الآن

107
00:06:20,190 --> 00:06:21,190
فعلاً؟

108
00:06:21,480 --> 00:06:24,070
!نجحت في اختبار القبول للتّلاميذ المنتقلين

109
00:06:24,440 --> 00:06:29,740
،كان يوكي-تشان يدرّسني كلّ هذا الوقت
،لكنّي أردت إخبارك بعد أن أنجح

110
00:06:29,740 --> 00:06:31,450
.لذلك طلبتُ منه ألاّ يخبرك

111
00:06:31,990 --> 00:06:34,990
لهذا السّبب كنتما دائمًا تتصرّفان بخلسة؟

112
00:06:34,990 --> 00:06:36,540
ماذا؟ –
!لا شيء –

113
00:06:36,540 --> 00:06:37,960
!شيمي-سان

114
00:06:38,620 --> 00:06:40,040
!غرفة هيئة التّدريس من هنا

115
00:06:40,040 --> 00:06:42,420
!حسنًا! إلى اللّقاء

116
00:06:43,420 --> 00:06:45,420
لندرس معًا إن انتهى بي المطاف
!في نفس فصلكم

117
00:06:47,260 --> 00:06:48,510
...أخيرًا

118
00:06:49,050 --> 00:06:51,720
!حان وقتي

119
00:06:52,640 --> 00:06:54,850
!يمكنني أن أسأل شيمي الآن

120
00:06:57,770 --> 00:06:58,980
!أوكومورا-كُن

121
00:06:58,980 --> 00:07:01,350
!رافقني إلى الحفل الرّاقص رجاءً

122
00:07:01,600 --> 00:07:03,190
.شكرًا جزيلاً لك

123
00:07:06,320 --> 00:07:08,280
لذلك لن يكون لديّ وقت
.فارغ في ذلك اليوم

124
00:07:08,280 --> 00:07:09,110
ماذا؟

125
00:07:09,740 --> 00:07:12,870
.لا بأس. لا تكتئبي

126
00:07:11,410 --> 00:07:12,870
...أوكومورا-سينسي

127
00:07:13,200 --> 00:07:16,330
أوكومورا-كُن، لا بدّ أنّك مشغول
.جدًّا لكونك محبوبًا هكذا

128
00:07:20,080 --> 00:07:21,830
.وأنت أيضًا كما يبدو

129
00:07:21,830 --> 00:07:24,710
لماذا يفعلن هذا فجأة؟

130
00:07:25,040 --> 00:07:27,340
!هذا مكان للتّعلّم

131
00:07:27,670 --> 00:07:31,680
لن تؤذي أحدًا إن رفضت دعواتهنّ
.بقول أنّك ضمن فريق عمل المهرجان

132
00:07:31,680 --> 00:07:33,590
.ربّما سأجرّب ذلك

133
00:07:33,590 --> 00:07:36,010
...بشأن أوكومورا الآخر... رين

134
00:07:36,010 --> 00:07:39,060
يبدو في حالة جنون وقد تعهّد
.بسؤال مورياما-سان للحفل الرّاقص

135
00:07:39,060 --> 00:07:41,980
!جميع من حولي مولع بشخص آخر

136
00:07:44,270 --> 00:07:47,360
مهلاً، ما الّذي تفعلينه هنا يا مورياما شيمي؟

137
00:07:47,820 --> 00:07:48,860
!مفاجأة

138
00:07:48,860 --> 00:07:53,240
!قالت أنّها انتقلت إلى هنا حديثًا
!إنّها في الفصل ب معي

139
00:07:53,240 --> 00:07:54,200
!نعم

140
00:07:54,200 --> 00:07:57,370
!كاميكي-سان، لنتناول الغداء معًا

141
00:07:57,660 --> 00:07:59,370
هل أنت جادّة؟

142
00:07:59,660 --> 00:08:01,870
هل يمكنني مناداتك شيمي-تشان؟

143
00:08:01,870 --> 00:08:03,830
!ماذا؟ بالطّبع يمكنك

144
00:08:03,830 --> 00:08:05,080
!وأنا أيضًا

145
00:08:05,080 --> 00:08:07,880
!يمكنك مناداتي نوريكو أو نوريرين

146
00:08:06,710 --> 00:08:09,630
.إنّهما منسجمتان معًا بالكامل

147
00:08:08,380 --> 00:08:09,630
!مرحى

148
00:08:09,960 --> 00:08:13,680
،ومع ذلك، عليّ الاعتراف
.لقد انتقلت في الوقت المثاليّ

149
00:08:13,680 --> 00:08:16,010
!المهرجان المدرسيّ على الأبواب

150
00:08:16,010 --> 00:08:17,510
!لا بدّ أن تشاركي فيه

151
00:08:17,510 --> 00:08:19,010
!هناك حفل راقص وما شابه

152
00:08:19,010 --> 00:08:20,640
حفل راقص؟

153
00:08:20,640 --> 00:08:22,430
!يبدو هذا ممتعًا! أودّ الذّهاب

154
00:08:22,430 --> 00:08:25,770
.لكن يمكنك الحضور فقط برفقة شريك

155
00:08:25,770 --> 00:08:27,270
شريك؟

156
00:08:27,270 --> 00:08:28,400
—أتقصدين

157
00:08:28,400 --> 00:08:30,650
وقع تزايد في الثّنائيّات الجدد
!في كلّ المدرسة

158
00:08:33,070 --> 00:08:36,200
لكنّي أعتقد أنّه لا بأس من الذّهاب
.رفقة صديق أيضًا

159
00:08:37,910 --> 00:08:40,080
—ربّما... سأحاول سؤال أحدهم لـ

160
00:08:40,080 --> 00:08:40,910
!شيمي

161
00:08:42,540 --> 00:08:43,660
...رين

162
00:08:44,370 --> 00:08:45,580
!مرحبًا

163
00:08:45,920 --> 00:08:47,380
...عفوًا

164
00:08:47,790 --> 00:08:50,300
أيمكننا التّكلّم على انفراد؟

165
00:08:52,090 --> 00:08:54,470
...ا-اسمعي

166
00:08:54,470 --> 00:08:58,050
هل سمعت بأمر الحفل الرّاقص
في مهرجان المدرسة؟

167
00:08:58,470 --> 00:09:00,350
نعم! يبدو ممتعًا، صحيح؟

168
00:09:00,350 --> 00:09:02,310
!أردتُ أن أتحدّث معك حيال ذلك أيضًا

169
00:09:02,600 --> 00:09:04,600
ماذا؟ أ-أنت جادّة؟

170
00:09:04,600 --> 00:09:05,480
!نعم

171
00:09:05,810 --> 00:09:07,310
—كما تعلم، أنا

172
00:09:07,310 --> 00:09:09,320
!مـ-مهلاً لحظة! دعيني أكلّمك أوّلاً

173
00:09:09,320 --> 00:09:12,110
!أفكّر في سؤال يوكي-تشان

174
00:09:16,820 --> 00:09:18,200
...هكذا إذًا

175
00:09:18,700 --> 00:09:22,790
سـ-ستسألين يوكيو إذًا؟

176
00:09:23,250 --> 00:09:26,500
!لقد تسرّعت في الحديث قبلك
ماذا كنت تريد أن تسألني؟

177
00:09:26,500 --> 00:09:27,880
...لا شيء

178
00:09:27,880 --> 00:09:30,710
...لا... تهتمّي

179
00:09:30,710 --> 00:09:32,000
أأنت واثق؟

180
00:09:32,420 --> 00:09:36,800
في أحد الأيّام عندما كان
...يوكي-تشان يدرّسني

181
00:09:38,590 --> 00:09:43,140
...يوكي-تشان... بشأن المثال رقم 3

182
00:09:45,100 --> 00:09:46,060
يوكي-تشان؟

183
00:09:53,440 --> 00:09:57,360
راودني شعور أنّ لديه الكثير
.ليقلق حياله ويشغل باله

184
00:09:57,360 --> 00:10:00,780
.لذلك أردت أن ينسى كلّ ذلك لبعض الوقت

185
00:10:05,200 --> 00:10:08,420
ويقول لي أنّه لا يخفي شيئًا؟
!ذلك المغفّل

186
00:10:08,870 --> 00:10:10,920
.لا، لا تهتمّي

187
00:10:11,340 --> 00:10:12,590
.تبدو فكرة جيّدة

188
00:10:12,590 --> 00:10:14,460
.يمكنك سؤاله

189
00:10:14,460 --> 00:10:17,260
.بما أنّه كان يتصرّف بشكل غريب مؤخّرًا

190
00:10:17,260 --> 00:10:18,680
.حـ-حسنًا

191
00:10:20,010 --> 00:10:21,180
رين؟

192
00:10:25,600 --> 00:10:26,930
ما الّذي حدث له؟

193
00:10:26,930 --> 00:10:29,060
.رفضته مورياما-سان

194
00:10:29,060 --> 00:10:30,480
.يا إلهي

195
00:10:30,480 --> 00:10:32,190
من كان يدري؟

196
00:10:32,190 --> 00:10:34,820
.لم أتوقّع أبدًا أن ترفضه مورياما-سان

197
00:10:34,820 --> 00:10:39,950
.أعتقد أنّ شيمي معجبة بيوكيو بالفعل

198
00:10:41,320 --> 00:10:45,330
"غرفة عاملي صيدليّة الشّياطين"

199
00:10:42,450 --> 00:10:45,330
أ-أتريد مرافقتي إلى الحفل الرّاقص؟

200
00:10:47,330 --> 00:10:50,370
أ-أتقصدينني أنا؟

201
00:10:50,370 --> 00:10:51,500
هل أنت ذاهب مع أحد ما؟

202
00:10:51,500 --> 00:10:52,170
.لا

203
00:10:52,170 --> 00:10:53,920
!لنذهب معًا إذًا

204
00:10:53,920 --> 00:10:55,750
!أعلم أنّنا سنستمتع بوقتنا

205
00:11:00,840 --> 00:11:04,180
في الحقيقة، أنا ضمن فريق
،العمل على المهرجان

206
00:11:04,180 --> 00:11:05,970
.لذلك لن يكون لديّ وقت فراغ يومها

207
00:11:07,220 --> 00:11:09,560
.لكنّني أقدّر عرضك هذا وأعتذر منك

208
00:11:10,600 --> 00:11:12,560
.هـ-هكذا إذًا

209
00:11:12,560 --> 00:11:15,070
!لا بأس! لا تضغط على نفسك كثيرًا

210
00:11:15,440 --> 00:11:17,820
.حاضر. شكرًا جزيلاً لك

211
00:11:21,160 --> 00:11:22,620
لماذا سألتني أنا؟

212
00:11:22,950 --> 00:11:25,950
.كنتُ واثقًا أنّها ستذهب مع أخي

213
00:11:26,580 --> 00:11:27,450
!سُحقًا

214
00:11:27,750 --> 00:11:29,710
ما الّذي تعتقد نفسك فاعلاً؟

215
00:11:29,710 --> 00:11:31,710
!ما الـ... مهلاً! منذ متى وأنت هنا؟

216
00:11:31,710 --> 00:11:33,920
.أنا هنا قبل حتّى وصول شيمي

217
00:11:33,920 --> 00:11:36,710
حسنًا، لماذا كنت تقول "سُحقًا"؟

218
00:11:40,800 --> 00:11:43,430
.كان يوكي-تشان يبتسم قبل قليل

219
00:11:44,180 --> 00:11:45,680
...رغم ذلك

220
00:11:46,010 --> 00:11:48,430
.شعرتُ وكأنّني رُفضت

221
00:11:49,350 --> 00:11:51,440
...لا أدري كيف أشرح الأمر، لكنّي

222
00:11:51,440 --> 00:11:52,940
.أشعر بالقلق

223
00:11:54,270 --> 00:11:55,940
...أشعر بقلق شديد

224
00:11:55,940 --> 00:11:57,440
.رين

225
00:11:59,030 --> 00:12:01,740
أتساءل ما الّذي تراه في شخص
.بأربعة عيون مثلك

226
00:12:01,740 --> 00:12:04,110
إنّها لا تكنّ لي مشاعر كهذه، مفهوم؟

227
00:12:04,110 --> 00:12:06,620
لكنّك معجب بها، صحيح؟

228
00:12:07,490 --> 00:12:08,620
!كلاّ

229
00:12:13,870 --> 00:12:17,040
حسنًا، ما الّذي تفعله بالتّسلّل خلسة هكذا؟

230
00:12:21,590 --> 00:12:23,590
إذًا فقد كنت تعرفين بوجودي هنا؟

231
00:12:23,590 --> 00:12:28,640
إنّ اختلاس النّظر للتّلاميذ المفتونين
!بالحفل الرّاقص هو من هواياتي

232
00:12:28,970 --> 00:12:31,640
.إذًا فأنت الفائز بجائزة أسوأ ذوق ممكن

233
00:12:31,640 --> 00:12:32,770
...ولكن

234
00:12:32,770 --> 00:12:36,400
أنت من كان يتسلّل خلسة هنا، صحيح؟

235
00:12:36,400 --> 00:12:39,150
تعتقدين أنّني جاسوس للإيلوميناتي؟

236
00:12:39,940 --> 00:12:42,950
.دعيني أحذّرك ثانية

237
00:12:43,860 --> 00:12:46,200
!لن أسمح لك بإحباطي

238
00:12:47,530 --> 00:12:50,040
...إن حاولتِ ذلك

239
00:12:50,040 --> 00:12:52,710
.سأقضي عليك بيديّ هاتين

240
00:12:55,080 --> 00:12:57,750
...خلال المهرجان الّذي سيبدأ غدًا

241
00:12:57,750 --> 00:13:00,630
وإلى جانب الحشود الهائلة
،من السّائحين الّذين سيأتون

242
00:13:00,630 --> 00:13:05,300
وأنا واثقة أيضًا أنّكم تعرفون أنّه هنالك
،تزايدًا في طلبات المساعدة لطرد الأرواح

243
00:13:05,300 --> 00:13:08,890
!لذا يرجى القيام بدوريّات وفقًا لذلك

244
00:13:12,600 --> 00:13:15,390
!شيمي-تشان، هذا مبالغ فيه قليلاً

245
00:13:16,560 --> 00:13:18,690
.لكنّ الجميع بدوا مشغولين

246
00:13:18,690 --> 00:13:20,820
.أتساءل إن كانوا سيأتون غدًا

247
00:13:20,820 --> 00:13:24,030
كما أنّ يوكي-تشان رفض طلبي عندما
.سألته أن يرافقني للحفل الرّاقص

248
00:13:24,030 --> 00:13:27,030
ماذا؟ ألم يطلب منك أوكومورا-كُن الذّهاب معه؟

249
00:13:27,030 --> 00:13:28,570
ماذا؟ تقصدين رين؟

250
00:13:28,570 --> 00:13:30,160
.لا، لم يطلب منّي ذلك

251
00:13:30,160 --> 00:13:32,160
...ولكن يومها

252
00:13:32,870 --> 00:13:37,000
كنتُ أخبر رين كم أنّ يوكي-تشان
.يبدو متعبًا مؤخّرًا

253
00:13:38,000 --> 00:13:42,510
ظننتُ أنّها ستكون فكرة جيّدة
...أن أطلب منه الذّهاب للحفل

254
00:13:42,630 --> 00:13:44,720
ماذا؟ رفض طلبك؟

255
00:13:44,720 --> 00:13:47,220
—نعم! أظنّني لم أملك القوّة الكافية

256
00:13:47,220 --> 00:13:48,470
!سُحقًا له

257
00:13:48,470 --> 00:13:50,970
هل لديك أيّة أفكار جيّدة يا رين؟

258
00:13:51,430 --> 00:13:53,770
!لا تطلبي مساعدتي! أنت وحدك الآن

259
00:13:53,770 --> 00:13:54,770
!رين

260
00:13:55,600 --> 00:13:58,900
.لا فكرة لديّ لماذا كان رين غاضبًا

261
00:13:59,360 --> 00:14:03,780
أعتقد أنّ أوكومورا-كُن كان سيطلب
.منك الذّهاب معه للحفل

262
00:14:03,780 --> 00:14:04,740
ماذا؟

263
00:14:04,740 --> 00:14:08,780
من تحبّين أكثر يا شيمي-تشان؟
أوكومورا-كُن أم سينسي؟

264
00:14:08,780 --> 00:14:11,030
من أحبّ أكثر؟

265
00:14:12,660 --> 00:14:14,410
!أ-أحبّ كلاهما

266
00:14:14,410 --> 00:14:17,870
!كلاهما صديق عزيز عليّ في نهاية المطاف

267
00:14:17,870 --> 00:14:22,550
.لم أقصد هذا النّوع من الحبّ
.بل الحبّ بمعناه الرّومانسيّ

268
00:14:22,550 --> 00:14:23,460
ماذا؟

269
00:14:24,710 --> 00:14:26,340
رومانسيّ؟

270
00:14:26,340 --> 00:14:30,340
!هذا مبكّر جدًّا بالنّسبة لي
!لذلك رجاءً منك لا تسألي

271
00:14:28,430 --> 00:14:31,220
.أوكومورا-كُن، الطّريق أمامك طويل

272
00:14:31,600 --> 00:14:37,230
سأنسى أمر الحفل الرّاقص بالكامل
!وأقدّم كلّ ما لديّ لمشروع الفصل

273
00:14:31,600 --> 00:14:37,230
"كرات أرزّ"

274
00:14:37,230 --> 00:14:40,350
ماذا؟ أستستسلم بهذه السّهولة يا أوكومورا-كُن؟

275
00:14:40,350 --> 00:14:42,860
.أظنّ أنّ الوقت حان لتستسلم أيضًا

276
00:14:42,860 --> 00:14:47,150
سأذهب ولو عنى ذلك جعل كونكو-سان
!يرتدي ملابس فتيات إن اقتضى الأمر

277
00:14:47,150 --> 00:14:47,900
صحيح؟

278
00:14:47,900 --> 00:14:48,700
ماذا؟

279
00:14:49,030 --> 00:14:53,240
في الحقيقة، سأذهب إلى الحفل الرّاقص
.مع رئيسة نادي نَسخ السّوترا

280
00:14:53,240 --> 00:14:54,490
!هذا لا يُعقل

281
00:14:55,080 --> 00:14:57,660
هل كنتما لتموتا إن درستما
طرد الأرواح لبعض الوقت؟

282
00:14:55,450 --> 00:14:56,620
...رين

283
00:14:57,660 --> 00:14:58,910
!وخاصّة أنت يا أوكومورا

284
00:14:58,910 --> 00:15:02,750
أنا أدرس بالفعل! مثل التّفكير بحركات
...رفقة شورا خلال فصل المسايفة

285
00:15:02,750 --> 00:15:05,210
ماذا تعني بـ"حركات"؟
هل أنت في الابتدائيّة؟

286
00:15:06,670 --> 00:15:09,130
لماذا لا تخرس فحسب؟

287
00:15:07,760 --> 00:15:11,050
هل كنت توشك أن تطلب منّي
الذّهاب للحفل الرّاقص؟

288
00:15:09,130 --> 00:15:12,890
عليك تحسين جودة هجماتك أوّلاً
!قبل إنشاء حركات جديدة

289
00:15:11,050 --> 00:15:13,720
ألهذا السّبب أنت غاضب؟

290
00:15:12,890 --> 00:15:13,720
...من الجيّد أنّي

291
00:15:16,470 --> 00:15:17,680
.بالطّبع لا

292
00:15:18,020 --> 00:15:20,020
.ذلك ليس من شيم رين الّذي أعرفه

293
00:15:20,020 --> 00:15:22,020
.لأنّ ذلك سيكون رومانسيًّا

294
00:15:22,020 --> 00:15:24,230
!سأستجمع شجاعتي وأعوّضه عن ذلك غدًا

295
00:15:24,230 --> 00:15:24,980
!يا فتاة

296
00:15:25,610 --> 00:15:26,650
أتسمعينني؟

297
00:15:26,650 --> 00:15:29,280
!آسفة! كنت شاردة التّفكير

298
00:15:29,280 --> 00:15:32,490
يا إلهي. بإمكاننا جني الكثير من المال
...خلال المهرجان المدرسيّ

299
00:15:32,490 --> 00:15:35,030
.لذلك سأطلب منك مساعدتي غدًا

300
00:15:35,030 --> 00:15:36,790
!نسيت ذلك تمامًا

301
00:15:36,790 --> 00:15:38,000
!أنا آسفة

302
00:15:38,330 --> 00:15:40,920
،ولكن، سبق وحصلتُ على دور الوحش

303
00:15:40,920 --> 00:15:42,750
لذلك أتمنّى أن تسمحي لي
!بالذّهاب لبعضة مرّات

304
00:15:43,250 --> 00:15:45,790
.لا مشكلة لديّ في ذلك

305
00:15:46,500 --> 00:15:49,760
!قد لا تتسنّى لي فرصة تعويض رين

306
00:15:50,260 --> 00:15:55,050
في اليوم التّالي

307
00:15:50,880 --> 00:15:54,640
!يُقام هذا المهرجان لكم أيّها التّلاميذ

308
00:15:54,640 --> 00:15:56,640
!لذلك اشربوا وكلوا وارقصوا

309
00:15:56,640 --> 00:15:59,520
افعلوا كلّ هذا بينما تتحدّون أنظمة
...المدرسة دون كسرها

310
00:15:59,520 --> 00:16:01,640
!واستمتعوا قدر المستطاع

311
00:16:02,730 --> 00:16:06,900
!أعلن الآن بداية مهرجان أكاديميّة الصّليب الحقيقيّ

312
00:16:12,860 --> 00:16:14,110
"مقهى النّظّارات"

313
00:16:14,110 --> 00:16:15,370
"الهرب من فصل 1-أ الخاصّ"

314
00:16:23,000 --> 00:16:24,290
!نجحنا يا غوداين

315
00:16:24,290 --> 00:16:26,170
!تمّ الاعتراف بمجهوداتنا

316
00:16:26,170 --> 00:16:30,210
أظنّ ذلك. لكن بما أنّ معظم زملائنا
،في الفصل سيذهبون للحفل الرّاقص اللّيلة

317
00:16:30,210 --> 00:16:31,380
فهل سيكون لدينا عاملون بما يكفي؟

318
00:16:35,850 --> 00:16:38,510
!مـ-مهلاً! إيزومو

319
00:16:39,890 --> 00:16:41,180
ماذا تريد؟

320
00:16:41,770 --> 00:16:43,020
!وجدتك أخيرًا

321
00:16:43,600 --> 00:16:46,150
أتوسّل إليك! ارتدي هذا وساعدينا
!في صندوق الأداء

322
00:16:46,520 --> 00:16:49,530
مستحيل! لماذا لا تطلب ذلك
من مورياما شيمي؟

323
00:16:49,530 --> 00:16:52,650
!ا-الوضع محرج بيننا الآن

324
00:16:52,650 --> 00:16:55,110
!هناك عدّة فتيات أخريات للقيام بهذا

325
00:16:55,110 --> 00:16:59,660
!أيّتها الغبيّة! هذا عمل قبل كلّ شيء
!لذلك يجب أن تكون فتاة أثق بها

326
00:17:00,080 --> 00:17:02,040
!لا يجب أن تكون أيّ فتاة كانت

327
00:17:04,080 --> 00:17:05,460
!لذلك أنا أرجوك

328
00:17:05,460 --> 00:17:07,080
!سأشتري لك مثلّجات لاحقًا

329
00:17:07,080 --> 00:17:09,670
!حسنًا! أنا موافقة

330
00:17:09,670 --> 00:17:12,170
!سأساعدك، مفهوم؟ لذلك اغرب عن وجهي

331
00:17:12,170 --> 00:17:13,340
أتقولين الحقيقة؟

332
00:17:13,340 --> 00:17:15,550
!حسنًا! أنا مدين لك

333
00:17:15,550 --> 00:17:17,640
!وكأنّي كنتُ أقصد ذلك! مغفّل

334
00:17:17,640 --> 00:17:20,560
.إنّك تنقذينني دائمًا في أوقات كهذه

335
00:17:21,180 --> 00:17:23,310
!أعد أن أردّ لك الجميل يومًا ما

336
00:17:24,600 --> 00:17:26,100
...أنت

337
00:17:26,100 --> 00:17:27,810
...ومورياما شيمي

338
00:17:27,810 --> 00:17:31,230
.عليكما أن تتعلّما رؤية جوانب الآخرين الخفيّة

339
00:17:31,230 --> 00:17:32,110
ماذا؟

340
00:17:34,360 --> 00:17:37,200
.أنا لا أثق في أيّ أحد

341
00:17:41,950 --> 00:17:45,410
هل قلتُ شيئًا أزعجها؟

342
00:17:46,330 --> 00:17:49,460
!كلاّ! سأتأخّر

343
00:17:49,460 --> 00:17:52,170
.اذهبي بسرعة. لا يمكنني التّركيز

344
00:17:52,170 --> 00:17:52,920
!وجدته

345
00:17:53,460 --> 00:17:55,470
طُلب منك حضور الحفل الرّاقص
أيضًا، صحيح يا إيزومو-تشان؟

346
00:17:55,470 --> 00:17:59,180
!كلاّ! طُلب منّي العمل كبائعة فحسب

347
00:17:59,180 --> 00:18:00,680
.مع أنّي لن أذهب

348
00:18:02,810 --> 00:18:03,810
...إيزومو-تشان

349
00:18:05,310 --> 00:18:08,310
.حاولي أن تكوني صريحة بشأن مشاعرك

350
00:18:11,690 --> 00:18:12,980
!لا تتدافعوا

351
00:18:12,980 --> 00:18:14,940
!تقدّموا للأمام رجاءً

352
00:18:19,740 --> 00:18:21,490
!لم تحضر إيزومو بعد

353
00:18:21,490 --> 00:18:23,080
!بالتّوفيق يا أوكومورا-كُن

354
00:18:23,080 --> 00:18:26,080
يبدو أنّنا تعوّدنا على إدارة هذا
،الكشك بثلاثتنا فقط

355
00:18:26,080 --> 00:18:27,750
لذلك لماذا لا تأخذ استراحة؟

356
00:18:27,750 --> 00:18:29,250
ماذا؟ أواثق من ذلك؟

357
00:18:42,100 --> 00:18:44,270
...أتمنّى لو أستطيع

358
00:18:44,970 --> 00:18:46,810
.الذّهاب مع شيمي

359
00:18:52,480 --> 00:18:53,650
!شيمي

360
00:18:55,320 --> 00:18:56,110
!رين

361
00:18:56,110 --> 00:18:57,610
لماذا أنت هنا؟

362
00:18:58,030 --> 00:19:00,110
.أتيت لتوصيل بعض الأزهار من الخلف

363
00:19:00,110 --> 00:19:04,240
إنّنا نبيع الكثير من الزّهور
.في المهرجان المدرسيّ

364
00:19:04,240 --> 00:19:05,240
وأنت يا رين؟

365
00:19:05,240 --> 00:19:07,330
...إنّها قصّة طويلة

366
00:19:07,330 --> 00:19:09,000
.لكنّي أصنع كرات الأرزّ

367
00:19:11,880 --> 00:19:13,380
ما المضحك؟

368
00:19:15,750 --> 00:19:18,630
!يمكنني الحديث معك ثانية يا رين

369
00:19:18,970 --> 00:19:21,180
!حمدًا على هذا

370
00:19:23,760 --> 00:19:25,220
...شيمي

371
00:19:27,060 --> 00:19:28,270
.ارقصي معي

372
00:19:30,390 --> 00:19:31,400
ماذا؟

373
00:19:36,480 --> 00:19:37,570
...هذه هي

374
00:19:37,990 --> 00:19:40,240
مشاعر رين حيالي؟

375
00:19:42,620 --> 00:19:45,410
...أ-أنا

376
00:19:45,700 --> 00:19:50,210
من تحبّين أكثر يا شيمي-تشان؟
أوكومورا-كُن أم سينسي؟

377
00:19:54,210 --> 00:19:55,840
!أحبّك أنت

378
00:19:56,670 --> 00:19:57,710
.غبيّة

379
00:19:59,760 --> 00:20:01,550
.ليس عليك إخباري

380
00:20:08,020 --> 00:20:09,020
!رين

381
00:20:14,610 --> 00:20:18,360
!التقاط الصّور ممنوع

382
00:20:25,620 --> 00:20:27,450
!يوكيو

383
00:20:27,990 --> 00:20:28,990
أخي؟

384
00:20:28,990 --> 00:20:30,410
وشيمي-سان أيضًا؟

385
00:20:31,290 --> 00:20:32,370
ماذا يحدث؟

386
00:20:32,370 --> 00:20:34,170
.أنا أعمل الآن

387
00:20:36,040 --> 00:20:37,290
...يوكيو –
...يوكي-تشان –

388
00:20:38,550 --> 00:20:40,630
!ارقص معنا رجاءً

389
00:20:42,630 --> 00:20:44,890
!محظوظون! إنّهم يستمتعون بصباهم

390
00:20:44,890 --> 00:20:47,100
ما رأيك أن نبدأ الرّقص أيضًا؟

391
00:20:47,430 --> 00:20:49,810
.آسف، رئيسي يستدعيني

392
00:20:49,810 --> 00:20:50,640
.عد للعمل

393
00:20:51,140 --> 00:20:53,980
أيّ فكرة هذه وضعتَ في رأس
شيمي-سان يا أخي؟

394
00:20:54,310 --> 00:20:56,440
.ماذا؟ لكنّ شيمي هي من بدأت كلّ هذا

395
00:20:56,440 --> 00:20:57,150
!كاذب

396
00:20:57,770 --> 00:20:59,690
!لا يمكننا الرّقص نحن الثّلاثة معًا من الأساس

397
00:20:59,690 --> 00:21:01,400
!لا داعي للقلق

398
00:21:01,400 --> 00:21:04,030
!كلّ ما علينا فعله هو تشكيل دائرة والدّوران

399
00:21:04,030 --> 00:21:05,450
!فكرة ممتازة

400
00:21:05,450 --> 00:21:06,570
!شيمي-سان

401
00:21:08,450 --> 00:21:09,200
!لا تبصق

402
00:21:09,200 --> 00:21:10,580
...رين

403
00:21:12,410 --> 00:21:14,080
!شكرًا لك

404
00:21:18,750 --> 00:21:20,250
!أنا أحبّك

405
00:21:25,510 --> 00:21:27,180
!الأمر ليس كما يبدو

406
00:21:27,180 --> 00:21:31,390
إن خلفت بوعدي، فسأشعر
!بالسّوء حيال ذلك لا غير

407
00:21:31,390 --> 00:21:32,600
!أنت

408
00:21:35,350 --> 00:21:37,350
!تعالي معي في الحال

409
00:21:37,730 --> 00:21:39,440
تاكارا نيمو؟

410
00:21:39,440 --> 00:21:41,610
!لماذا؟ أنا مشغولة الآن

411
00:21:42,690 --> 00:21:43,900
!ظهور

412
00:21:44,320 --> 00:21:47,620
!جالب حظّ كاميكي تسوكونو العزيز

413
00:21:53,750 --> 00:21:57,880
مـ-من أين حصلت على ذلك؟

414
00:22:00,130 --> 00:22:02,090
.أجبني

415
00:22:02,880 --> 00:22:05,010
!أجبني

416
00:23:35,010 --> 00:23:40,020
الحلقة القادمة
[مُخبر]