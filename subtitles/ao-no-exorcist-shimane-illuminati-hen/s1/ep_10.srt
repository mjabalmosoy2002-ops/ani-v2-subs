1
00:00:06,980 --> 00:00:08,940
!أنقذتمونا يا رفاق

2
00:00:09,320 --> 00:00:10,480
من هذه؟

3
00:00:10,480 --> 00:00:11,860
!إنّها والدة إيزومو

4
00:00:11,860 --> 00:00:12,610
ماذا؟

5
00:00:12,610 --> 00:00:13,700
!ضعوها على كورو رجاءً

6
00:00:13,990 --> 00:00:16,570
!تلبّس شيطانٌ كاميكي-سان

7
00:00:16,570 --> 00:00:19,030
هل يُعقل أنّها... ذات الذّيول التّسعة؟

8
00:00:19,370 --> 00:00:21,830
!فات الأوان الآن

9
00:00:21,830 --> 00:00:23,620
!غادروا المكان بسرعة

10
00:00:23,960 --> 00:00:27,130
كاميكي! ما خطبك؟

11
00:00:27,130 --> 00:00:29,040
!بإمكاني منحك مساعدات أوّلية بالألوي

12
00:00:29,040 --> 00:00:30,380
!دعي الأمر لي فحسب

13
00:00:30,380 --> 00:00:31,170
!ني

14
00:00:31,170 --> 00:00:32,670
!اخرسوا

15
00:00:33,510 --> 00:00:34,930
!كاميكي-تشان

16
00:00:37,430 --> 00:00:39,560
.جنّ جنونها

17
00:00:40,600 --> 00:00:44,270
،لا أستطيع حتّى الوصول إليها
.ناهيكم عن السّيطرة عليها

18
00:00:44,770 --> 00:00:49,190
لهذا السّبب لا خيار لدينا
.سوى ختمها لألف عام

19
00:00:49,570 --> 00:00:52,900
كيف تمكّنتِ من النّجاة وهي بداخلكِ
طوال السّنوات الخمس الماضية؟

20
00:00:52,900 --> 00:00:54,110
...يا أمّي

21
00:00:55,110 --> 00:00:56,450
...أنا

22
00:00:56,950 --> 00:00:58,070
...أعجز

23
00:00:58,740 --> 00:00:59,870
...عن المواصلة

24
00:01:03,500 --> 00:01:07,370
!لا يوجد أحد بإمكانه إنقاذي

25
00:02:47,430 --> 00:02:49,230
!كا-كاميكي-سان

26
00:02:47,930 --> 00:02:53,940
الحلقة 10: أصدقاء

27
00:02:49,230 --> 00:02:50,480
!أنتم تعترضون طريقي

28
00:02:51,560 --> 00:02:52,860
!أوكومورا-سينسي

29
00:02:52,860 --> 00:02:54,570
كيف نطرد روح ذات الذّيول التّسعة؟

30
00:02:54,860 --> 00:02:57,190
!إنّها شيطان متوسّط قديم وقويّ

31
00:02:57,190 --> 00:03:00,240
لم يكتشف أيّ أحد كيف يجب
!طردها بشكل متقن بعد

32
00:03:01,200 --> 00:03:03,700
في الحقيقة، آل كاميكي هم
.الخبراء في ذلك المجال

33
00:03:03,700 --> 00:03:06,330
إن استعادت والدة كاميكي-سان
—وعيها وقامت بـ

34
00:03:10,080 --> 00:03:12,290
...يمكنني... الرّؤية

35
00:03:14,080 --> 00:03:15,590
!إيزومو

36
00:03:18,510 --> 00:03:23,260
.أخضِعي نفسك داخل جسد ابنتي

37
00:03:23,260 --> 00:03:28,470
.أطلب أنا تامامو هذا منك

38
00:03:41,360 --> 00:03:42,450
ما هذا؟

39
00:03:43,240 --> 00:03:45,200
!إنّ الإحصائيّات غير منتظمة تمامًا

40
00:03:45,200 --> 00:03:46,950
!يـ-يكفي

41
00:03:46,950 --> 00:03:47,660
!يا رفاق

42
00:03:48,080 --> 00:03:50,450
!علينا إبقاء الزّومبي بعيدًا عنهما

43
00:03:50,870 --> 00:03:51,710
!مفهوم

44
00:03:52,460 --> 00:03:54,080
!تماسكي يا كاميكي

45
00:03:54,080 --> 00:03:57,460
هل نسيت أنّ امتحان شهادة طرد
الأرواح لم يبق له سوى ثلاثة أشهر؟

46
00:03:58,420 --> 00:04:02,170
...أفهم الآن لماذا كنت بعيدة عنّا

47
00:04:02,170 --> 00:04:04,590
!لكن عليك التّخلّي عن عادتك تلك

48
00:04:04,890 --> 00:04:07,600
!كاميكي-سان... سننقذك مهما كلّف الأمر

49
00:04:07,970 --> 00:04:09,600
!ني-تشان –
!ني –

50
00:04:11,390 --> 00:04:14,270
!إيزومو! نحن هنا لأجلك أيضًا

51
00:04:20,110 --> 00:04:22,400
.عودي لجسدي

52
00:04:22,400 --> 00:04:24,320
...أنا أدعوك

53
00:04:24,320 --> 00:04:26,700
!بكلّ احترام

54
00:04:36,170 --> 00:04:37,590
!كاميكي-سان

55
00:04:39,380 --> 00:04:41,130
...أنا

56
00:04:41,670 --> 00:04:43,840
...ذاتُ الذّيول التّسعة الخاصّة بإيزومو

57
00:04:43,840 --> 00:04:45,970
أين ذهبت؟

58
00:04:46,680 --> 00:04:49,510
.عادت ذات الذّيول التّسعة إليّ

59
00:04:51,430 --> 00:04:52,560
...وأيضًا

60
00:04:52,890 --> 00:04:55,980
.ستموت مع هذا الجسد

61
00:04:56,480 --> 00:04:58,730
...هذه هي نهاية

62
00:04:58,730 --> 00:05:00,860
.خططك

63
00:05:08,030 --> 00:05:09,370
!أمّي

64
00:05:15,120 --> 00:05:17,880
...حمدًا على هذا

65
00:05:18,830 --> 00:05:20,920
...إيزومو

66
00:05:24,010 --> 00:05:25,670
.سامحيني

67
00:05:26,680 --> 00:05:27,800
!لا تفعلي هذا

68
00:05:29,050 --> 00:05:30,550
لماذا؟

69
00:05:31,680 --> 00:05:37,190
!أنا من كنت أنقذك دائمًا

70
00:05:38,190 --> 00:05:40,940
!لن يُنقذني أيّ أحد

71
00:05:40,940 --> 00:05:42,980
...لذلك لن أعتمد على أيّ أحد

72
00:05:42,980 --> 00:05:44,440
!ولن أثق بأحد

73
00:05:44,820 --> 00:05:47,610
...هكذا عشت حياتي دائمًا

74
00:05:49,200 --> 00:05:53,080
لذلك لماذا قد تفعلين هذا الآن
بعد كلّ هذا الوقت؟

75
00:05:56,870 --> 00:06:00,710
...لأنّك كنزُ تاما-تشان الغالي

76
00:06:27,110 --> 00:06:31,120
...كنتُ... مخطئة تمامًا

77
00:06:34,990 --> 00:06:37,540
.لا بأس

78
00:06:38,620 --> 00:06:40,670
...الجميع

79
00:06:41,170 --> 00:06:43,500
...هنا من أجلك

80
00:06:43,880 --> 00:06:45,920
...تسوكومو

81
00:06:46,630 --> 00:06:48,050
...وأوكي-تشان

82
00:06:49,510 --> 00:06:51,470
...وميكي أيضًا

83
00:06:52,850 --> 00:06:54,760
...لذلك سيكون

84
00:06:56,390 --> 00:06:58,770
—كلّ شيء بخـ

85
00:07:30,630 --> 00:07:32,300
.فهمت

86
00:07:32,970 --> 00:07:34,390
...والدتها

87
00:07:36,060 --> 00:07:38,850
ماتت وهي تحميها، صحيح؟

88
00:07:42,560 --> 00:07:44,810
وماذا إن ماتت؟

89
00:07:45,270 --> 00:07:47,650
!يولد البشر ثمّ يموتون كالحثالة

90
00:07:47,650 --> 00:07:51,820
لا تقفوا هناك وأنتم تبكون فقط
!لأنّ عجوزًا شمطاء نفقت أيّها الحثالة

91
00:07:51,820 --> 00:07:54,200
!لستُ مثلكم! أنا مميّز

92
00:07:52,910 --> 00:07:54,200
...غيدويين

93
00:07:54,200 --> 00:07:55,450
...إنّه سوف

94
00:07:54,200 --> 00:07:56,950
!لستُ حثالة مثل بقيّتكم

95
00:07:55,450 --> 00:07:56,950
ما الّذي يفعله؟

96
00:07:56,950 --> 00:08:00,790
...سأجبر شيطانًا على أن يتلبّسني

97
00:08:01,210 --> 00:08:04,000
!لأنّي المختار بطبيعة الحال

98
00:08:09,840 --> 00:08:12,090
!أشعر به! أشعر به بالتّأكيد

99
00:08:12,090 --> 00:08:13,760
...يمكنني الشّعور بالشّيطان

100
00:08:13,760 --> 00:08:18,890
أشعر أنّ كلّ خلاياي تولد
!من جديد واحدة تلو الأخرى

101
00:08:17,430 --> 00:08:19,600
!هل يُعقل هذا؟ –
!تراجعوا جميعًا –

102
00:08:20,720 --> 00:08:24,600
!انضممت لصفوف المميّزين أخيرًا

103
00:08:24,600 --> 00:08:29,150
!الموت لكلّ البشر

104
00:08:30,900 --> 00:08:32,440
!إنّه يلتهم الزّومبي

105
00:08:32,440 --> 00:08:36,240
انظروا إليه! لا بدّ أنّ شيطانًا
!مُلتهمًا للموتى قد تلبّسه

106
00:08:37,990 --> 00:08:41,040
ما زالوا يملكون الأجساد المعزّزة
بتجارب الإكسير إذًا؟

107
00:08:41,040 --> 00:08:42,620
...غيدويين

108
00:08:42,620 --> 00:08:44,620
!كلاّ! لا يجب عليك التّحرّك في وضعك هذا

109
00:08:45,000 --> 00:08:47,380
.عليّ القتال أيضًا

110
00:08:48,170 --> 00:08:50,130
.ما عادت لي أيّ أسلحة

111
00:08:50,500 --> 00:08:51,920
...رغم ذلك

112
00:08:52,420 --> 00:08:54,380
...إنّه الشّخص الوحيد الّذي عليّ أن

113
00:08:55,470 --> 00:08:56,680
...أمّي

114
00:08:57,050 --> 00:08:58,390
...تسوكومو

115
00:08:58,390 --> 00:08:59,430
...أوكي

116
00:08:59,430 --> 00:09:00,760
...ميكي

117
00:09:01,560 --> 00:09:04,560
!امنحوني القوّة رجاءً

118
00:09:14,570 --> 00:09:17,780
"ميكي"

119
00:09:14,570 --> 00:09:17,780
"أوكي"

120
00:09:17,780 --> 00:09:18,910
!بطيئة

121
00:09:19,240 --> 00:09:20,740
!استدعيتنا أخيرًا

122
00:09:21,040 --> 00:09:22,410
!كنّا في انتظارك

123
00:09:26,170 --> 00:09:28,380
!أوكي! ميكي

124
00:09:28,790 --> 00:09:30,170
ولكن كيف يُعقل هذا...؟

125
00:09:30,170 --> 00:09:32,210
.يبدو أنّه تهاون معنا

126
00:09:32,710 --> 00:09:36,630
مع أنّ الأمر تطلّب وقتًا طويلاً
.قبل أن نستطيع الحركة ثانية

127
00:09:36,630 --> 00:09:37,800
!هذا مخيف

128
00:09:37,800 --> 00:09:39,510
!الحبابير مخيفة جدًّا

129
00:09:39,510 --> 00:09:40,720
ماذا؟

130
00:09:41,720 --> 00:09:44,390
.أنا من ستُطيح به

131
00:09:44,390 --> 00:09:49,060
.لكنّي سأكون عرضة للخطر أثناء ترتيلي لصلاتي

132
00:09:50,110 --> 00:09:51,440
...لذلك أرجوكم

133
00:09:52,020 --> 00:09:54,190
!قدّموا لي العون جميعًا

134
00:10:00,200 --> 00:10:02,410
هلاّ حميتِ والدتي؟

135
00:10:04,120 --> 00:10:05,540
!بالطّبع سأفعل

136
00:10:05,830 --> 00:10:06,910
!هذا صحيح

137
00:10:07,330 --> 00:10:08,870
!لهذا السّبب أتينا إلى هنا

138
00:10:08,870 --> 00:10:10,710
!لستِ بحاجة لتطلبي منّا ذلك أساسًا أيّتها المغفّلة

139
00:10:11,000 --> 00:10:12,960
!تملك البياكّو صفات النّور والظّلام

140
00:10:12,960 --> 00:10:15,090
!قد ينفع ذلك مع شيطان ملتهم للموتى

141
00:10:15,550 --> 00:10:17,380
!أظنّ أنّ الأمر يستحقّ المحاولة

142
00:10:17,380 --> 00:10:19,340
!لنساعد كاميكي-سان جميعًا لتقوم بالتّرتيل

143
00:10:19,640 --> 00:10:21,100
....في حالتك الآن يا إيزومو

144
00:10:21,600 --> 00:10:24,350
!بإمكاننا إعارتك شيئًا أقوى من تطهير الأرواح

145
00:10:26,640 --> 00:10:27,980
...شكرًا لكم

146
00:10:32,940 --> 00:10:33,770
!سأبدأ

147
00:10:35,400 --> 00:10:37,530
!رقود الأرواح

148
00:11:12,650 --> 00:11:16,940
...كما تتبدّد غيوم المطر بالرّياح

149
00:11:18,570 --> 00:11:21,320
!أخضعوا هذه الرّوح الشّرّيرة

150
00:11:21,610 --> 00:11:24,450
!طهّروا هذا الجسد

151
00:11:24,910 --> 00:11:26,620
...البطولة للرّوح الطّائشة

152
00:11:26,620 --> 00:11:28,290
...الحِلم للرّوح السّاكنة

153
00:11:28,660 --> 00:11:30,040
...المنّة للرّوح الفرحة

154
00:11:30,370 --> 00:11:32,290
.الصّفاء للرّوح السّامية

155
00:11:32,580 --> 00:11:35,790
...واحد، اثنان، ثلاثة، أربعة، خمسة

156
00:11:35,790 --> 00:11:38,800
.ستّة، سبعة، ثمانية، تسعة

157
00:11:41,510 --> 00:11:44,050
!رقود الأرواح

158
00:11:45,050 --> 00:11:47,640
!أمقُتُ البشر

159
00:11:47,640 --> 00:11:49,560
!لا يهتمّون إلاّ لأنفسهم

160
00:11:49,560 --> 00:11:51,480
!جميعهم منافقون

161
00:11:51,730 --> 00:11:53,480
!جميعهم حثالة قذرون

162
00:11:56,730 --> 00:11:59,530
!إيزومو

163
00:11:59,530 --> 00:12:04,280
ألا تشعرين بذلك أيضًا؟

164
00:12:05,410 --> 00:12:07,030
.ليس بعد الآن

165
00:12:17,800 --> 00:12:19,550
!هذا مذهل

166
00:12:19,880 --> 00:12:20,800
ما الّذي يحدث؟

167
00:12:21,130 --> 00:12:22,470
.لقد بدأ يتقلّص

168
00:12:22,470 --> 00:12:24,430
هل هزمتْه؟

169
00:12:25,090 --> 00:12:26,800
...لم أنتهِ

170
00:12:27,180 --> 00:12:28,350
.من أمره بعد

171
00:12:28,350 --> 00:12:29,060
!إيزومو

172
00:12:30,140 --> 00:12:32,230
!يبدو أنّها فقدت وعيها

173
00:12:32,230 --> 00:12:33,690
!حمدًا على هذا

174
00:12:34,190 --> 00:12:36,730
.أنجزنا مهمّتنا بإنقاذ كاميكي-سان

175
00:12:36,730 --> 00:12:40,280
سنتراجع الآن وننتظر وصول التّعزيزات
.إلى هنا قبل إعادة تجميع صفوفنا

176
00:12:40,280 --> 00:12:41,780
!مهلاً لحظة

177
00:12:41,780 --> 00:12:42,950
—ما زال شيما

178
00:12:42,950 --> 00:12:45,610
هذا صحيح! سنعيد شيما
!معنا أيضًا بكلّ تأكيد

179
00:12:45,610 --> 00:12:47,320
...أفهم ما تشعران به، لكن

180
00:12:47,320 --> 00:12:48,870
!مهلاً

181
00:12:49,790 --> 00:12:51,540
!عليّ الاعتراف ببراعتكم جميعًا

182
00:12:51,540 --> 00:12:52,500
!شيما

183
00:12:52,500 --> 00:12:54,160
.أظنّ أنّ أفضل خيار لي هو الانسحاب

184
00:12:54,160 --> 00:12:55,170
!انتظر

185
00:12:58,340 --> 00:13:00,130
هل أنا السّبب؟

186
00:13:03,340 --> 00:13:05,010
.على الإطلاق

187
00:13:05,010 --> 00:13:06,890
.فعلتُ هذا من أجلي

188
00:13:07,640 --> 00:13:08,390
!حسنًا إذًا

189
00:13:08,890 --> 00:13:11,060
!اعتنوا بأنفسكم جميعًا

190
00:13:15,140 --> 00:13:17,150
!يا رفاق! علينا الخروج من هنا في الحال

191
00:13:18,020 --> 00:13:19,610
!وإلاّ حاصرنا كلّ هؤلاء الزّومبي

192
00:13:20,070 --> 00:13:21,400
!نفد منّي الرّصاص

193
00:13:21,400 --> 00:13:22,480
!دعني أتولّى أمرهم

194
00:13:22,480 --> 00:13:23,940
—تقطيع

195
00:13:23,940 --> 00:13:24,740
ماذا؟

196
00:13:26,860 --> 00:13:28,910
بون! هل أنتم بخير؟

197
00:13:29,830 --> 00:13:31,330
كينزو؟

198
00:13:31,330 --> 00:13:35,710
اسمحوا لنا رجاءً نحن وحدة إنقاذ بون
!لمكتب كيوتو الفرعيّ بتولّي هذا الأمر

199
00:13:36,290 --> 00:13:37,670
.نحن هم التّعزيزات

200
00:13:37,670 --> 00:13:39,380
.شكرًا على عملكم الدّؤوب

201
00:13:39,380 --> 00:13:42,920
تعمل مكاتب كيوتو وميي
...وماتسوي الفرعيّة معًا

202
00:13:42,920 --> 00:13:45,720
.ومنطقة إيناري تحت سيطرتنا سلفًا

203
00:14:06,950 --> 00:14:08,410
...أنا

204
00:14:09,700 --> 00:14:11,240
.انتهى كلّ شيء الآن

205
00:14:12,120 --> 00:14:13,330
تاكارا؟

206
00:14:13,330 --> 00:14:15,080
.مع أنّ غيدويين هرب منّا

207
00:14:16,960 --> 00:14:18,830
!لم ينتهِ الأمر بعد إذًا

208
00:14:19,170 --> 00:14:22,210
!لا فكرة لديّ ما الّذي حلّ بتسوكومو

209
00:14:23,630 --> 00:14:24,800
...قبل خمس سنوات

210
00:14:25,130 --> 00:14:28,630
خانت امرأة الإيلوميناتي لتتمكّنا
.أنت وتسوكومو من الهرب

211
00:14:28,630 --> 00:14:32,140
مع من كانت الصّفقة الّتي عقدتها في رأيك؟

212
00:14:32,430 --> 00:14:34,310
.كانت مع فرسان الصّليب الحقيقيّ

213
00:14:34,720 --> 00:14:38,100
ولكنّ تلك المرأة قد قُتلت
.وتمّ أسرك أنت

214
00:14:38,390 --> 00:14:41,150
كانت تسوكومو هي الوحيدة
.الّتي استطاعت الوصول لبرّ الأمان

215
00:14:41,900 --> 00:14:43,230
...إذًا

216
00:14:43,230 --> 00:14:45,030
...تسوكومو

217
00:14:47,780 --> 00:14:48,950
حيّة؟

218
00:14:51,620 --> 00:14:54,120
.هذه هديّةُ تماثلٍ بالشّفاء من رئيسي

219
00:14:54,120 --> 00:14:56,660
لماذا لا تنتهزين هذه الفرصة لتري بنفسك؟

220
00:15:18,810 --> 00:15:20,690
.حسنًا، سأغادر الآن

221
00:15:20,690 --> 00:15:22,150
.سأعود للمنزل باكرًا اليوم

222
00:15:22,150 --> 00:15:24,820
!كم هذا رائع! رافقتك السّلامة

223
00:15:25,820 --> 00:15:27,690
!إلى اللّقاء يا أبي

224
00:15:28,190 --> 00:15:29,990
!سأغادر الآن

225
00:15:31,360 --> 00:15:32,740
...تسوكومو

226
00:15:34,240 --> 00:15:36,200
.اسمها تاكارا تسوكيكو الآن

227
00:15:36,200 --> 00:15:39,080
إنّها ابنة الرّئيس التّنفيذيّ لشركة
،حواسيب تاكارا التّرفيهيّة بالتّبنّي

228
00:15:39,080 --> 00:15:42,830
،شركة فرعيّة لمجموعة تاكارا
.بعدما لم يحظَ بأيّ أطفال

229
00:15:42,830 --> 00:15:44,210
.وهذا يجعلها قريبتي

230
00:15:45,130 --> 00:15:48,510
.مجموعة تاكارا ملك لمديرنا ميفيستو فيليس

231
00:15:48,510 --> 00:15:50,720
.إنّها مخفيّة تمامًا وتحت حماية شاملة

232
00:15:51,510 --> 00:15:54,180
.إنّها تعيش حياة هانئة ومريحة

233
00:15:54,890 --> 00:15:56,390
...تسوكومو

234
00:15:56,850 --> 00:15:59,680
.حسنًا، علينا الاستعداد للمدرسة يا تسوكيكو

235
00:15:59,680 --> 00:16:01,600
هل يمكنني ريّ الزّهور؟

236
00:16:01,890 --> 00:16:03,440
.ما دمت لن تتأخّري

237
00:16:03,440 --> 00:16:04,480
...تسوكومو

238
00:16:04,480 --> 00:16:05,650
!حسنًا

239
00:16:05,650 --> 00:16:08,230
!كبرتِ كثيرًا

240
00:16:08,570 --> 00:16:11,780
.حسنًا، صار ذلك المفتاح لك الآن

241
00:16:11,780 --> 00:16:13,820
.لك كامل الحرّيّة لفعل ما تشائين به

242
00:16:21,210 --> 00:16:22,620
...على الأقلّ

243
00:16:23,040 --> 00:16:25,130
!على الأقلّ يمكنني رؤيتها

244
00:16:32,220 --> 00:16:33,630
!تسوكومو

245
00:16:40,390 --> 00:16:41,600
من أنت؟

246
00:16:50,150 --> 00:16:51,400
...هذه الدّمية

247
00:16:52,400 --> 00:16:53,530
هل تذكرينها؟

248
00:16:53,530 --> 00:16:54,200
!نعم

249
00:16:54,530 --> 00:16:56,320
!إنّها كنزي

250
00:16:56,320 --> 00:16:58,160
!ظننتُ أنّي فقدتها

251
00:16:58,160 --> 00:16:59,700
!كم سرّني هذا

252
00:16:59,700 --> 00:17:01,290
كنزك؟ –
!نعم –

253
00:17:01,790 --> 00:17:05,580
قيل لي أنّي وُلدت وأنا أحمل
.هذه الدّمية في يدي

254
00:17:05,580 --> 00:17:08,380
.لذلك السّبب أخبرتني أمّي بالاعتناء بها

255
00:17:08,380 --> 00:17:09,880
.أتساءل إن كان ذلك صحيحًا

256
00:17:10,960 --> 00:17:13,340
!شكرًا لك يا أختي

257
00:17:20,010 --> 00:17:21,640
.مع السّلامة

258
00:17:25,060 --> 00:17:26,810
...مع السّلامة

259
00:17:40,910 --> 00:17:42,240
من كانت؟

260
00:17:50,500 --> 00:17:51,960
.صباح الخير يا كاميكي-سان

261
00:17:52,460 --> 00:17:54,880
هل تشعرين بتحسّن الآن؟

262
00:17:54,880 --> 00:17:57,680
.أعاني آلامًا في كامل جسدي

263
00:17:59,050 --> 00:18:00,390
...أنا

264
00:18:02,260 --> 00:18:04,810
...كانت لديّ أخت فقدتُها منذ زمن

265
00:18:04,810 --> 00:18:06,100
.تسوكومو

266
00:18:06,850 --> 00:18:09,360
...وفي السّنوات الخمس الأخيرة

267
00:18:10,310 --> 00:18:13,480
!كنتُ أتخيّل فقط أمورًا فظيعة تحدث لها

268
00:18:13,900 --> 00:18:15,900
!لكنّها كانت آمنةً سالمة

269
00:18:16,240 --> 00:18:18,160
!بدت سعيدة للغاية

270
00:18:18,950 --> 00:18:22,540
.لديها الآن أب وأمّ يبدوان لطيفين معها

271
00:18:23,120 --> 00:18:25,540
.لقد كبرت وصالت فتاة لطيفة للغاية

272
00:18:27,160 --> 00:18:31,540
...أنا فعلاً

273
00:18:32,590 --> 00:18:34,210
!شاكرة لهذا

274
00:18:37,090 --> 00:18:41,350
!لكنّها ما عادت تذكرني

275
00:18:43,810 --> 00:18:46,770
!كانت في الثّالثة فقط في آخر لقاء لنا

276
00:18:46,770 --> 00:18:48,690
...فلا عجب

277
00:18:48,690 --> 00:18:51,110
...أعلم ذلك، ولكن

278
00:18:51,650 --> 00:18:55,900
كان إنقاذ تلك الفتاة هو ما عشت لأجله
...هذه السّنوات الخمس الماضية

279
00:18:55,900 --> 00:18:58,150
!هذا ليس عدلاً أبدًا

280
00:18:58,950 --> 00:19:00,950
!لا يمكنني تحمّل هذا

281
00:19:03,200 --> 00:19:04,120
.نعم

282
00:19:04,120 --> 00:19:06,750
!ليس لديك أيّ فكرة عن هذا الشّعور

283
00:19:06,750 --> 00:19:09,870
ما كان شخص مثلك محاط
...بعائلة سعيدة

284
00:19:09,870 --> 00:19:13,250
!وكبر في كنفها وحمايتها... أن يفهم

285
00:19:14,170 --> 00:19:15,840
...يا للشّفقة

286
00:19:15,840 --> 00:19:18,050
...الّتي أشعر بها تجاه نفسي

287
00:19:18,380 --> 00:19:19,430
.نعم

288
00:19:20,260 --> 00:19:21,680
!إيّاك أن تبكين

289
00:19:21,680 --> 00:19:23,800
!دموعك على خدّك دائمًا

290
00:19:23,800 --> 00:19:26,350
إن تأذّيتِ، فلماذا لا تردّين عليّ؟

291
00:19:26,350 --> 00:19:29,890
،أنا المُلامة على صراخي عليك هكذا
!لذلك قولي هذا فحسب

292
00:19:29,890 --> 00:19:32,900
—هذا هو ما لا أستطيع تحمّله حيال

293
00:19:35,360 --> 00:19:36,940
!حمدًا على هذا

294
00:19:37,780 --> 00:19:46,330
"محطّة أكاديميّة الصّليب الحقيقيّ"

295
00:19:38,530 --> 00:19:40,110
...قالت لي نوري-تشان

296
00:19:40,110 --> 00:19:43,200
...قبل أن تودّعنا في المحطّة

297
00:19:43,910 --> 00:19:45,870
.اعتني بإيزومو-تشان

298
00:19:46,950 --> 00:19:48,540
...إنّ إيزومو-تشان

299
00:19:48,870 --> 00:19:51,170
.تشعر بالغيرة منك يا شيمي

300
00:19:51,170 --> 00:19:52,040
ماذا؟

301
00:19:52,040 --> 00:19:53,710
.وكذلك من أوكومورا-كُن

302
00:19:53,710 --> 00:19:56,920
"...إنّهم يبكون ويضحكون ويغضبون معًا دائمًا"

303
00:19:56,920 --> 00:20:00,840
".أتمنّى لو أكون حرّة مثلهم"
.هذا ما قالته لي مرّة

304
00:20:04,260 --> 00:20:06,100
.ساعدوها رجاءً

305
00:20:07,220 --> 00:20:08,350
...لذلك

306
00:20:08,850 --> 00:20:10,890
...فإنّ رؤيتك تبكين يا كاميكي-سان

307
00:20:10,890 --> 00:20:12,230
...وتضحكين

308
00:20:12,230 --> 00:20:13,770
...وتغضبين أيضًا

309
00:20:14,560 --> 00:20:16,110
!أراحتني كثيرًا

310
00:20:19,320 --> 00:20:22,860
!باكو... تلك الغبيّة

311
00:20:24,200 --> 00:20:26,990
!يا لها من ثرثارة

312
00:20:27,580 --> 00:20:31,500
!سأوسعها ضربًا عندما أعود

313
00:20:43,260 --> 00:20:45,260
!صباح الخير يا سوغورو

314
00:20:45,260 --> 00:20:47,430
.أتينا لرؤية إيزومو وشيمي

315
00:20:47,430 --> 00:20:50,100
.ليس الآن. عودا في وقت لاحق

316
00:20:50,100 --> 00:20:50,770
ماذا؟

317
00:20:50,770 --> 00:20:52,230
ماذا؟ ما الّذي يحدث؟

318
00:20:52,230 --> 00:20:53,600
هل حدث أمر ما؟

319
00:20:53,600 --> 00:20:55,600
!لا تحدث أيّ جلبة
—أخفض صوتك

320
00:20:55,900 --> 00:20:57,190
!كلاّ

321
00:20:57,480 --> 00:20:59,070
!تطهير الأرواح

322
00:20:59,070 --> 00:21:00,530
!أهذا معقول؟

323
00:21:00,530 --> 00:21:03,280
!هذا مبالغ فيه كثيرًا

324
00:21:08,990 --> 00:21:11,330
...أمّي، أنا

325
00:21:14,420 --> 00:21:17,540
.لن أشعر بالأسى على نفسي بعد الآن

326
00:21:20,090 --> 00:21:21,590
.سأذهب الآن

327
00:21:24,220 --> 00:21:25,720
انتهيت؟

328
00:21:26,220 --> 00:21:27,890
!حسنًا، لنعد للمنزل

329
00:21:28,220 --> 00:21:30,220
!نوري-تشان في انتظارنا أيضًا

330
00:23:34,970 --> 00:23:39,980
الحلقة القادمة
[العنكبوت الورديّ]