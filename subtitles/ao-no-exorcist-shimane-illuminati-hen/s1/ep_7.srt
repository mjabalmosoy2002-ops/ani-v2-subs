1
00:00:01,520 --> 00:00:04,270
.هذا كلّ ما أستطيع إخباركم به

2
00:00:04,810 --> 00:00:05,980
...هذا يعني

3
00:00:05,980 --> 00:00:08,610
...أخذت الإيلوميناتي كاميكي-سان

4
00:00:08,900 --> 00:00:10,730
لتأخذ مكان والدتها؟

5
00:00:11,690 --> 00:00:13,610
!يا للقسوة

6
00:00:15,570 --> 00:00:16,240
!لنسرع

7
00:00:20,160 --> 00:00:22,790
...مختبر الإيلوميناتي الّذي ذكرتَه

8
00:00:23,210 --> 00:00:24,620
هلاّ أخبرتنا عن مكانه؟

9
00:00:24,620 --> 00:00:27,420
.إنّهم يغزون هذه المنطقة من تحت الأرض

10
00:00:27,750 --> 00:00:28,920
تحت الأرض؟

11
00:00:28,920 --> 00:00:30,170
أين هو المدخل؟

12
00:00:30,550 --> 00:00:32,090
.يخطر ببالي مكان معيّن

13
00:00:32,090 --> 00:00:33,260
.سأقودكم إلى هناك

14
00:00:33,840 --> 00:00:34,680
!حسنًا

15
00:00:34,970 --> 00:00:37,300
هل انتهيتم من كلّ ذلك الكلام المعقّد؟

16
00:00:37,300 --> 00:00:38,350
...أخي

17
00:00:38,350 --> 00:00:40,810
.لا تقل لي أنّك لم تستمع لكلمة ممّا قيل

18
00:00:41,100 --> 00:00:43,350
.استمعتُ إليه بالفعل

19
00:00:43,350 --> 00:00:46,770
.بعضًا منه على الأقلّ
سوف ننقذهما ونعود، صحيح؟

20
00:00:49,730 --> 00:00:52,820
!لنجد المدخل في أقرب وقت ممكن

21
00:00:52,820 --> 00:00:54,030
!نعم

22
00:02:25,370 --> 00:02:30,500
الحلقة 7: تردّد

23
00:02:43,640 --> 00:02:44,510
...أخبرني

24
00:02:45,180 --> 00:02:48,770
كيف تشعر الآن؟

25
00:02:49,600 --> 00:02:52,020
.سألتك يا ورديّ الشّعر

26
00:02:53,110 --> 00:02:54,730
هل تستمتع بهذا؟

27
00:02:54,730 --> 00:02:56,650
أم أنّك حزين؟

28
00:02:57,900 --> 00:02:59,400
أيّهما؟

29
00:02:59,400 --> 00:03:01,070
!اخرسي وسيري

30
00:03:04,200 --> 00:03:05,700
رأيتها، صحيح؟

31
00:03:05,700 --> 00:03:07,240
.رأيتَ أمّي

32
00:03:08,080 --> 00:03:10,290
هل ذلك هو ما سأصير عليه؟

33
00:03:12,250 --> 00:03:14,540
.هذا يعني أنّي سأموت

34
00:03:15,590 --> 00:03:17,000
—انتهى كلّ –
!اخرسي –

35
00:03:18,380 --> 00:03:22,130
،ما زلتِ في مرحلة الفحص الجسديّ

36
00:03:22,130 --> 00:03:26,600
لذلك ستصيرين حرّة قريبًا
...بمجرّد نجاح التّجارب المخبريّة

37
00:03:26,600 --> 00:03:28,770
لذلك لماذا لا ننظر للأمر من منظور إيجابيّ؟

38
00:03:29,060 --> 00:03:31,890
.إنّ نجحت التّجارب المخبريّة، فسأُقتل

39
00:03:33,730 --> 00:03:36,900
.أنا ميتة في كلّ الأحوال

40
00:03:37,320 --> 00:03:40,780
.أحضرنا الموضوع رقم 0987

41
00:03:40,780 --> 00:03:41,570
.تفضّلوا

42
00:03:46,910 --> 00:03:50,330
!مرحبًا! من اللّطيف منك زيارتنا يا إيزومو

43
00:03:51,660 --> 00:03:53,250
!انتهى كلّ شيء

44
00:03:53,250 --> 00:03:54,880
!كلّ شيء

45
00:03:55,170 --> 00:03:56,000
!كلاّ

46
00:03:56,000 --> 00:03:56,790
!إيزومو-تشان

47
00:03:56,790 --> 00:03:58,800
ما-ما الّذي حلّ بها؟

48
00:03:58,800 --> 00:04:00,300
!هدّئوها في الحال

49
00:04:00,800 --> 00:04:02,050
!سيتضرّر جسدها

50
00:04:02,550 --> 00:04:03,680
!المخدّر

51
00:04:07,760 --> 00:04:09,140
!أستدعيكما بكلّ احترام

52
00:04:09,430 --> 00:04:10,270
!أوكي! ميكي

53
00:04:10,680 --> 00:04:12,060
!احمياني

54
00:04:16,980 --> 00:04:18,440
ما الّذي تفعلونه؟

55
00:04:18,440 --> 00:04:20,440
!أتعبثون معي؟! اذهبوا خلفها بسرعة

56
00:04:20,860 --> 00:04:22,570
.اذهب يا لوندستروم

57
00:04:22,570 --> 00:04:23,320
!عُلم

58
00:04:23,320 --> 00:04:25,110
!سأذهب أيضًا

59
00:04:25,110 --> 00:04:26,030
!أيّها الدّكتور غيدويين

60
00:04:26,030 --> 00:04:27,120
ماذا هنالك؟

61
00:04:27,120 --> 00:04:29,330
!تمّ إبلاغنا بوجود دخلاء في المدخل الأماميّ

62
00:04:29,330 --> 00:04:29,950
ماذا؟

63
00:04:29,950 --> 00:04:32,830
ما الّذي يفعله أولئك الحرس الأغبياء؟

64
00:04:32,830 --> 00:04:34,750
!إنّهم لا يستجيبون في الوقت الحاليّ

65
00:04:34,750 --> 00:04:37,880
!سُحقًا! يحيط بي الحمقى في كلّ مكان

66
00:04:38,500 --> 00:04:40,340
!وجدتها

67
00:04:40,340 --> 00:04:43,010
لماذا لا نرسل تجاربنا الفاشلة خلفهم؟

68
00:04:45,800 --> 00:04:46,680
!يا ميكي

69
00:04:46,680 --> 00:04:48,600
تأخّرت! ما الّذي كنت تفعله؟

70
00:04:48,600 --> 00:04:51,520
.أتى أشخاص من التّنظيم لإنقاذك

71
00:04:53,930 --> 00:04:56,020
!لن أعود للتّنظيم –
ماذا؟ –

72
00:04:56,020 --> 00:05:00,520
سأذهب لإيجاد تسوكومو بمجرّد
!خروجي من هنا ولن يوقفني شيء

73
00:05:00,900 --> 00:05:04,150
!لن أعتمد على أيّ أحد ثانية أبدًا

74
00:05:05,950 --> 00:05:07,950
...لا أهتمّ كيف ستكون حياتي

75
00:05:07,950 --> 00:05:10,200
!سأقضيها كلّها في حماية تسوكومو

76
00:05:12,660 --> 00:05:13,750
.انظروا

77
00:05:12,830 --> 00:05:16,290
— قبل بضعة ساعات —

78
00:05:13,750 --> 00:05:16,290
.إنّه تلك القلعة قرب الضّريح

79
00:05:17,170 --> 00:05:19,170
هل ذلك مجمّع بلدة السّلام إيناري؟

80
00:05:19,170 --> 00:05:21,750
.يمكن الدّخول للطّوابق التّحأرضيّة من هناك

81
00:05:21,750 --> 00:05:22,670
...ما

82
00:05:26,130 --> 00:05:29,090
إنّهم يجمعون البشر الّذين حوّلوهم
....إلى حمقى ضعفاء في هذا الشّارع

83
00:05:29,090 --> 00:05:31,180
.ويأخذونهم إلى القلعة

84
00:05:31,640 --> 00:05:33,100
ماذا تعني؟

85
00:05:33,100 --> 00:05:36,060
.أمعنوا النّظر للبشر هنا

86
00:05:36,390 --> 00:05:38,440
...لا يملكون ذرّة غضب أو حزن

87
00:05:38,440 --> 00:05:39,810
...لا خوف ولا حسد

88
00:05:40,480 --> 00:05:42,530
.لا كراهية ولا ألم

89
00:05:43,190 --> 00:05:47,570
إنّهم أشبه بأطفال بريئين
.كلّ ما يفعلونه هو الأكل باستمرار

90
00:05:47,910 --> 00:05:52,660
،إنّ قضمة واحد من الطّعام هنا
.ستجعل آكلها يتحوّل مثلهم

91
00:05:54,620 --> 00:05:56,250
!رين! عليك التّوقّف عن الأكل

92
00:05:56,250 --> 00:05:57,620
!ابصق ما في فمك

93
00:05:57,620 --> 00:06:00,630
لكنّنا أكلنا منه جميعًا، صحيح؟

94
00:05:58,000 --> 00:06:00,960
!ما كلّ هذا؟ هذه مضيعة للطّعام

95
00:06:01,420 --> 00:06:04,000
.تميمة أعشاب طبّيّة تحميكم جميعًا

96
00:06:04,000 --> 00:06:05,090
تميمة؟

97
00:06:05,090 --> 00:06:07,090
.لا أذكر أنّه تمّ تفعيل أيّ شيء كهذا

98
00:06:07,090 --> 00:06:08,880
ماذا؟ أعشاب طبّيّة؟

99
00:06:09,720 --> 00:06:11,760
شطيرة أعشاب شيمي-سان؟

100
00:06:12,640 --> 00:06:17,390
"بلدة السّلام إيناري"
"محطّة حافلات مباشرة"

101
00:06:17,390 --> 00:06:20,940
في النّهاية، من يقعون تحت تأثير
...تعويذة هذه الأرض

102
00:06:20,940 --> 00:06:23,940
"مسار بلدة السّلام إيناري"

103
00:06:21,310 --> 00:06:23,940
.يصعدون على متن تلك الحافلة نحو القلعة

104
00:06:24,400 --> 00:06:26,570
.ولا يعودون أبدًا

105
00:06:26,570 --> 00:06:30,360
بتعبير آخر، تغسل الإيلوميناتي
،أدمغة المدنيّين على نطاق واسع

106
00:06:30,360 --> 00:06:33,530
وتأخذهم إلى بلدة السّلام إيناري
وتأسرهم هناك؟

107
00:06:33,530 --> 00:06:34,950
لأيّ هدف بالتّحديد؟

108
00:06:34,950 --> 00:06:38,120
.لا أعرف أيّ شيء عن أهدافهم

109
00:06:38,120 --> 00:06:39,330
...الشّيء الوحيد الّذي يمكنني قوله

110
00:06:39,750 --> 00:06:43,920
هو أنّه رغم أنّ هذه الأرض
...قد تبدو مزيّنة ببذخ من الخارج

111
00:06:44,380 --> 00:06:45,960
...إلاّ أنّها عفنة من الدّاخل

112
00:06:45,960 --> 00:06:48,510
!ولا تختلف عن أيّ وكر للدّيدان

113
00:06:48,510 --> 00:06:50,590
هل سنركب تلك الحافلة أيضًا؟

114
00:06:50,590 --> 00:06:53,010
.على الأرجح أنّ الحافلة مراقبة

115
00:06:53,010 --> 00:06:54,890
.سنتّجه إلى هناك سيرًا على الأقدام

116
00:07:00,980 --> 00:07:08,740
"بلدة السلام إيناري"

117
00:07:05,610 --> 00:07:07,280
.إنّها أزياء الإيلوميناتي الرّسميّة

118
00:07:07,280 --> 00:07:08,740
.هذا هو المكان

119
00:07:09,490 --> 00:07:11,990
.فسنقوم بإحياء والدنا الشّيطان ساتان

120
00:07:12,620 --> 00:07:16,990
وبعد ذلك، سنمزج عالمَيْ أسيا وجهنّم
...المنفصلين حاليًّا ليصيرا عالمًا واحدًا

121
00:07:17,660 --> 00:07:21,370
.وسيعرف العالم السّلام الحقيقيّ

122
00:07:21,370 --> 00:07:24,000
ما غاية الإيلوميناتي الحقيقيّة؟

123
00:07:24,670 --> 00:07:28,670
بوّابة جهنّم المصنوعة على يد البشر
...وما يحدث هنا في إيناري

124
00:07:28,670 --> 00:07:31,010
.لا بدّ أنّ الأمران متّصلان ببعض

125
00:07:31,470 --> 00:07:34,600
.يعجّ هذا المكان بالحرس
ما الّذي سنفعله؟

126
00:07:34,600 --> 00:07:35,260
...يا سيّد فيليس

127
00:07:35,720 --> 00:07:39,850
عثرنا على ما يبدو أنّه مدخل
.لمختبر الإيلوميناتي التّحأرضيّ

128
00:07:39,850 --> 00:07:42,520
!أحسنتم! قمتم بعمل ممتاز

129
00:07:43,100 --> 00:07:44,860
متى سيصل الدّعم؟

130
00:07:44,860 --> 00:07:46,900
...ما زلنا مشغولين كثيرًا هنا

131
00:07:46,900 --> 00:07:51,150
ولا يمكنني تقديم أيّ ضمانات
.حيال متى يمكنني إرسال الدّعم

132
00:07:51,150 --> 00:07:55,410
ربّما تكون كاميكي-سان قد اختُطفت
.لتقوم الإيلوميناتي بالتّجارب على جسدها

133
00:07:55,830 --> 00:07:58,080
!ليس لدينا أيّ وقت لنضيّعه أيضًا

134
00:07:58,080 --> 00:08:00,250
...سواء انتظرتم الدّعم أو تسلّلتم إلى هناك

135
00:08:00,250 --> 00:08:04,080
.فسأترك الأمر لك أيّها القائد أوكومورا

136
00:08:04,630 --> 00:08:07,040
...أنت الوحيد هناك من المايستر

137
00:08:07,040 --> 00:08:10,420
،ولكن إن وقعت معركة ما
.فأنتم تملكون مؤهّلات كافية لتولّي ذلك

138
00:08:10,420 --> 00:08:15,470
.سأرسل إليكم دعمًا بكلّ تأكيد
!ولكن إلى ذلك الحين، حظًّا سعيدًا أيّها القائد

139
00:08:16,350 --> 00:08:17,510
ما...؟

140
00:08:17,510 --> 00:08:19,270
هل كلّ شيء بخير؟

141
00:08:20,220 --> 00:08:21,640
.يتمّ استدعائي

142
00:08:21,640 --> 00:08:23,270
!إيزومو في خطر

143
00:08:24,440 --> 00:08:26,480
.لا بدّ أنّ كاميكي إيزومو استدعته

144
00:08:26,770 --> 00:08:28,070
استدعته؟

145
00:08:28,070 --> 00:08:32,950
هل يعني ذلك أنّ كاميكي-سان
في وضع اضطرّت فيه للقتال الآن؟

146
00:08:34,110 --> 00:08:35,200
...يا رفاق

147
00:08:35,200 --> 00:08:39,120
لنثق أنّهم سيرسلون لنا الدّعم
.ونقتحم المكان من مدخله الأماميّ

148
00:08:39,120 --> 00:08:40,370
هل أنتم جاهزون لذلك؟

149
00:08:41,700 --> 00:08:43,500
!لا أمانع

150
00:08:50,920 --> 00:08:52,630
مـ-من تكونون يا هؤلاء؟

151
00:08:52,630 --> 00:08:55,340
!هذا ليس مكانًا للتّلاميذ! عودوا لمنازلكم

152
00:08:55,340 --> 00:08:57,760
.اتّبعوا أوامري كقائد لكم

153
00:08:57,760 --> 00:08:58,970
.وخاصّة أنت يا أخي

154
00:08:58,970 --> 00:09:01,310
.إنّنا نواجه بشرًا هنا. تساهل معهم

155
00:09:01,310 --> 00:09:02,770
...لا داعي للقلق

156
00:09:03,930 --> 00:09:05,520
!أيّها القائد ذو النّظّارات

157
00:09:05,770 --> 00:09:06,560
!خذوا هذا

158
00:09:07,020 --> 00:09:07,980
...تقطيع

159
00:09:07,980 --> 00:09:09,520
!الشّيطان

160
00:09:16,660 --> 00:09:19,740
!خذ هذا

161
00:09:21,410 --> 00:09:22,540
!هذا سهل تمامًا

162
00:09:22,540 --> 00:09:23,620
...مهلاً

163
00:09:23,620 --> 00:09:25,250
هل يمكنني التّعليق على شيء؟

164
00:09:25,250 --> 00:09:27,710
"!تقطيع الشّيطان"

165
00:09:27,710 --> 00:09:28,630
!اخرس

166
00:09:28,630 --> 00:09:32,670
كانت هذه حركة عشوائيّة منّي
!قرّر شورا تسميتها بذلك

167
00:09:32,670 --> 00:09:37,130
قال شورا أنّ منحها اسمًا سيجعل
!تصوّر لهيبي أسهل عندما أستعمله

168
00:09:37,130 --> 00:09:41,140
"إيناري"

169
00:09:49,150 --> 00:09:53,150
"مرحبًا في بلدة السّلام إيناري"

170
00:09:53,530 --> 00:09:55,400
...مركز تسوّق

171
00:09:56,360 --> 00:09:58,910
....الأشخاص الّذين ركبوا الحافلة

172
00:09:58,910 --> 00:10:00,780
هل هم هنا بالفعل؟

173
00:10:00,780 --> 00:10:03,290
.لا أرى أيّ شخص هنا، ناهيكم عن العدوّ

174
00:10:03,290 --> 00:10:04,750
.لا، إنّهم هنا

175
00:10:05,450 --> 00:10:06,620
.يوجد شيء ما هنا

176
00:10:06,620 --> 00:10:07,920
.لا ترخوا دفاعاتكم

177
00:10:07,920 --> 00:10:09,880
هل تشعر بشيء ما؟

178
00:10:09,880 --> 00:10:11,460
.أصابتني القشعريرة

179
00:10:11,460 --> 00:10:14,090
قد يكون هذا مزيّفًا؟

180
00:10:14,090 --> 00:10:15,670
.اهدؤوا جميعًا

181
00:10:16,050 --> 00:10:19,550
بما أنّنا اخترقنا المكان من المدخل
.الأماميّ، فسيظهر العدوّ بالتّأكيد

182
00:10:19,550 --> 00:10:24,180
لنبحث عن المدخل إلى الطّابق التّحأرضيّ
.دون أن ننفصل إن أمكن ذلك

183
00:10:26,980 --> 00:10:29,440
!إيزومو، أوكي، هناك شيء ما متّجه نحونا

184
00:10:32,940 --> 00:10:33,690
!أوكي

185
00:10:34,400 --> 00:10:37,820
!مهلاً، ما هذا؟ لقد قُطعت ساقي

186
00:10:40,200 --> 00:10:41,570
...أنا آسف

187
00:10:41,910 --> 00:10:45,830
!لن أسمح لك بتجاوزي يا إيزومو-تشان

188
00:10:48,620 --> 00:10:50,960
!شيما رنزو

189
00:11:06,350 --> 00:11:07,430
!إنّه شخص

190
00:11:07,430 --> 00:11:08,100
ماذا؟

191
00:11:08,480 --> 00:11:10,310
!مهلاً! أنت هناك

192
00:11:25,330 --> 00:11:26,040
!غول

193
00:11:28,830 --> 00:11:32,040
...أنا... جائع

194
00:11:34,590 --> 00:11:36,750
هل... تكلّم؟

195
00:11:42,720 --> 00:11:43,720
ما الّذي يحدث؟

196
00:11:47,680 --> 00:11:48,770
غول؟

197
00:11:48,770 --> 00:11:49,480
.لا

198
00:11:50,100 --> 00:11:53,650
.بما أنّه تكلّم، فلا بدّ أنّه زومبي

199
00:11:54,150 --> 00:11:55,270
ما الفرق؟

200
00:11:55,270 --> 00:11:56,980
!تعلّمنا هذا في الفصل

201
00:11:57,530 --> 00:12:00,900
يتمّ القضاء على الغيلان بطريقة
.مختلفة قليلاً عن الزّومبي

202
00:12:00,900 --> 00:12:04,110
يستطيع الزّومبي الكلام في بعض
...الحالات وإن كان ذلك نادرًا

203
00:12:04,110 --> 00:12:06,620
...ولوصف الأمر بعبارات أبسط

204
00:12:06,620 --> 00:12:09,200
...من السّهل القضاء على الغيلان

205
00:12:09,200 --> 00:12:12,370
بينما من الصّعب هزيمة
.الزّومبي أو حتّى التّعامل معهم

206
00:12:12,920 --> 00:12:15,420
.يتمّ إنشاؤهم بطريقة مختلفة من الأساس

207
00:12:15,420 --> 00:12:18,670
بينما الغيلان عبارة عن شياطين
...تتلبّس جثث بشر

208
00:12:19,050 --> 00:12:23,470
فإنّ الزّومبي بشر تلبّست طفيليّات
.شيطانيّة أجسادهم النّخريّة

209
00:12:23,800 --> 00:12:25,050
...بشر

210
00:12:25,470 --> 00:12:28,260
...إذًا هل بإمكاننا إنقاذهم

211
00:12:28,810 --> 00:12:30,770
إن طردنا تلك الطّفيليّات الشّيطانيّة منهم؟

212
00:12:31,600 --> 00:12:36,810
لم يستعد أيّ بشريّ إنسانيّته بعد
.تعرّض جسده لهذه الدّرجة من النّخر

213
00:12:37,230 --> 00:12:40,030
قتلهم في الحال هو الخلاص
.الوحيد الّذي يمكننا منحهم إيّاه

214
00:12:45,450 --> 00:12:48,620
.موضوع التّجارب رقم 6411

215
00:12:48,620 --> 00:12:50,540
—أيّ نوع من التّجارب

216
00:12:55,460 --> 00:12:56,750
.هذا غير منطقيّ

217
00:12:56,750 --> 00:12:59,000
.واثق أنّي اخترقت جذع دماغه

218
00:12:59,000 --> 00:13:00,550
هل أنت بخير يا كونكومارو؟

219
00:13:00,840 --> 00:13:02,800
.نـ-نعم

220
00:13:04,090 --> 00:13:05,050
!يا رفاق

221
00:13:13,310 --> 00:13:14,980
من أين أتى كلّ هذا؟

222
00:13:14,980 --> 00:13:16,810
!أوكومورا-سينسي

223
00:13:26,360 --> 00:13:27,820
ما الّذي يحدث؟

224
00:13:30,030 --> 00:13:33,160
علينا العثور على الباب إلى الطّابق
!التّحأرضيّ قبل أن يحاصرونا

225
00:13:37,750 --> 00:13:39,590
!اهربوا! اهربوا

226
00:13:39,590 --> 00:13:41,840
!مع أنّه لا يوجد أيّ مهرب لكم من هنا

227
00:13:42,130 --> 00:13:45,760
،قد يكونون تجارب فاشلة
لكنّهم أبطال نسبة الواحد في المائة

228
00:13:45,760 --> 00:13:48,970
الّذين لم يموتوا في الحال
!خلال تجارب الإكسير

229
00:13:51,680 --> 00:13:55,480
لا يسعكم إلاّ فقدان الأمل في مواجهة
!فرقة الزّومبي الخالدين خاصّتي

230
00:13:55,850 --> 00:13:58,730
!مهلاً! قرّب الصّورة أكثر

231
00:13:58,730 --> 00:14:02,230
!سأستمتع كثيرًا بفيلم الرّعب الدّمويّ هذا

232
00:14:09,370 --> 00:14:10,990
أيّها الدّكتور غيدويين؟

233
00:14:11,490 --> 00:14:15,040
نـ-نغيل ساتان؟

234
00:14:15,040 --> 00:14:18,000
!لـ-لم أره من قبل

235
00:14:18,000 --> 00:14:21,210
!تعتبره المنظّمة هدفًا أمنيًّا بالغ السّرّيّة

236
00:14:21,210 --> 00:14:23,380
!كما أنّه برفقة أخيه الصّغير الّذي كنّا نراقبه

237
00:14:23,380 --> 00:14:25,420
...ما-ما-ما

238
00:14:25,760 --> 00:14:27,720
ما الّذي يحدث؟

239
00:14:27,720 --> 00:14:29,220
لماذا هما هنا؟

240
00:14:29,220 --> 00:14:31,680
...ماذا أفعل؟ ما الّذي سوف

241
00:14:39,650 --> 00:14:41,730
.تغيير في الخطّة

242
00:14:42,020 --> 00:14:42,690
!حاضر

243
00:14:43,820 --> 00:14:47,440
افتحوا آلة التّخلّص من البقايا
!وأسقطوهم في منطقة الإطعام

244
00:14:47,440 --> 00:14:51,660
!سنمسك بهما ونقدّمهما إلى لوسيفر-ساما

245
00:14:51,660 --> 00:14:56,000
سأطعم الباقي لأبطال نسبة
.الواحد من الألف

246
00:15:10,760 --> 00:15:13,850
!لا فائدة! نحن محاصرون تمامًا –
!لا مهرب هناك أيضًا –

247
00:15:13,850 --> 00:15:15,760
!إنّهم كُثر

248
00:15:16,100 --> 00:15:18,020
.خيارنا الوحيد هو فتح طريقنا بأنفسنا

249
00:15:18,020 --> 00:15:20,640
ماذا إن أطلقت قذيفة من البازوكا خاصّتي؟

250
00:15:20,640 --> 00:15:21,770
.لن ينفع ذلك يا بون

251
00:15:22,060 --> 00:15:26,030
،إن لم نستطع قتلهم في الحال
.فسيُهاجموننا وهم يشتعلون

252
00:15:26,360 --> 00:15:30,860
لكنّ لهيب أوكومورا-كُن
!قد يحوّلهم لرماد في الحال

253
00:15:31,200 --> 00:15:32,490
...أنا

254
00:15:32,910 --> 00:15:35,030
!لا خيار أمامنا سوى القتال بعزيمة الآن

255
00:15:35,330 --> 00:15:36,990
!إن تردّدنا، فسنموت جميعًا

256
00:15:44,080 --> 00:15:45,420
ما الّذي يحدث؟

257
00:15:47,300 --> 00:15:47,920
!بون

258
00:15:48,880 --> 00:15:49,800
!شيمي

259
00:15:53,390 --> 00:15:55,050
!كلاّ

260
00:16:06,190 --> 00:16:09,610
!جميعها أشياء مزيّفة

261
00:16:09,610 --> 00:16:10,650
!هذا لا يُغتفر

262
00:16:13,240 --> 00:16:13,910
ماذا؟

263
00:16:14,240 --> 00:16:16,530
!قطّ

264
00:16:17,830 --> 00:16:19,290
ما هذه الأشياء؟

265
00:16:19,290 --> 00:16:22,000
أين ذهب الجميع؟

266
00:16:25,330 --> 00:16:29,130
يامانتاكا-كُن قادر على حرق وجود
.جهنّم بحدّ ذاته

267
00:16:29,130 --> 00:16:33,510
بإمكانه حرق تلك الثّعالب الصّغيرة
.دون ترك أيّ أثر

268
00:16:35,390 --> 00:16:38,390
...لذلك ما رأيك بالعودة للتّجارب

269
00:16:38,390 --> 00:16:40,270
يا إيزومو-تشان؟

270
00:16:40,810 --> 00:16:44,190
!لكنّي واثقة أنّك لا تستطيع أذيّتي

271
00:16:44,850 --> 00:16:45,900
.معك حقّ

272
00:16:46,150 --> 00:16:48,400
...لا أستطيع أن أضرّ بجسدك

273
00:16:48,770 --> 00:16:51,150
.لكن بإمكاني إفقادك وعيك

274
00:16:51,490 --> 00:16:55,160
.إن تهاونت قليلاً كما فعلتُ البارحة

275
00:16:57,200 --> 00:16:59,290
!غادرا حالاً يا أوكي وميكي –
!مهلاً! إيّاك –

276
00:16:59,290 --> 00:17:01,200
!توقّفي! إنّه أعلى مستوى منك

277
00:17:02,040 --> 00:17:04,290
!سأفوز، إن استطعت الإطاحة بك

278
00:17:06,540 --> 00:17:07,210
!مذهلة

279
00:17:09,630 --> 00:17:10,710
!بربّك

280
00:17:10,710 --> 00:17:12,590
...إن لم تكفّي عن التّصرّف بعنف

281
00:17:12,590 --> 00:17:16,340
،فقد يشوّش ذلك على تحكّمي
!وستصير حالتك يُرثى لها

282
00:17:18,850 --> 00:17:23,600
مع أنّ ذلك لا يعني
.أنّه لن يكون ملائمًا لأبحاثنا

283
00:17:27,480 --> 00:17:29,230
!لن أسمح لك بذلك أيّها التّانوكي اللّعين

284
00:17:29,730 --> 00:17:31,400
!أوكي! ميكي

285
00:17:31,400 --> 00:17:33,240
لماذا؟ ألم آمركما؟

286
00:17:33,610 --> 00:17:34,990
!أيّتها الغرّة

287
00:17:34,990 --> 00:17:36,860
!نحن أسلحتك

288
00:17:37,320 --> 00:17:38,620
!استعملينا

289
00:17:41,160 --> 00:17:43,700
...باسم أوكانوميتاما-نو-كامي

290
00:17:44,210 --> 00:17:46,420
!فلن أدعك تتجاوزني أيّها التّانوكي

291
00:17:45,500 --> 00:17:46,420
!هذا ساخن

292
00:17:47,040 --> 00:17:48,580
.ما باليد حيلة

293
00:17:48,580 --> 00:17:50,170
.لكنّي لا أريد القيام بهذا

294
00:17:52,210 --> 00:17:54,670
!دايتوكو فونّو يوكتسو

295
00:17:54,970 --> 00:17:55,930
!اللّهب الزّاحف

296
00:18:06,600 --> 00:18:07,440
!ميكي

297
00:18:11,020 --> 00:18:12,440
...ميكي

298
00:18:14,240 --> 00:18:16,200
...هذا مستحيل

299
00:18:17,530 --> 00:18:18,950
!غبيّة

300
00:18:20,070 --> 00:18:22,330
...انسيني وأسرعي

301
00:18:22,740 --> 00:18:24,700
!وانظري أمامك

302
00:18:33,840 --> 00:18:34,630
!أوكي

303
00:18:34,630 --> 00:18:35,880
!توقّف! هذا يكفي

304
00:18:36,260 --> 00:18:37,260
!اختف فحسب

305
00:18:37,680 --> 00:18:39,090
ألا تصغي لأوامري؟

306
00:18:39,090 --> 00:18:42,140
!أرجوك

307
00:19:04,870 --> 00:19:06,870
...إنّهما

308
00:19:07,370 --> 00:19:09,580
...كانا أشبه

309
00:19:10,000 --> 00:19:15,300
.بأخوين لي

310
00:19:17,130 --> 00:19:18,630
هكذا إذًا؟

311
00:19:19,050 --> 00:19:20,550
.آسف

312
00:19:31,940 --> 00:19:34,230
.اعترضت طريقنا بلا سبب

313
00:19:34,230 --> 00:19:35,900
!أنا آسف

314
00:19:35,900 --> 00:19:39,490
!حصلتُ على كلّ الفضل لنفسي

315
00:19:39,490 --> 00:19:43,320
...فأنا توّاق لاكتساب ثقة المنظّمة

316
00:19:44,450 --> 00:19:45,700
.مهلاً

317
00:19:46,040 --> 00:19:48,500
.لا يُعقل أنّ هذا يحدث ثانية

318
00:20:11,440 --> 00:20:12,850
!أجل

319
00:20:12,850 --> 00:20:14,860
هل أمسكتم إيزومو؟

320
00:20:15,150 --> 00:20:18,360
سقط الدّخلاء إلى كلّ واحدة من مناطق
الإطعام أيضًا. ماذا نفعل الآن؟

321
00:20:18,360 --> 00:20:21,490
.مفهوم. احرصوا على القيام بالأمر كما يجب

322
00:20:18,730 --> 00:20:22,490
!دعهم وشأنهم حاليًّا

323
00:20:23,610 --> 00:20:25,740
.استيقظ القائد الأعلى

324
00:20:26,080 --> 00:20:27,990
لوسيفر-ساما؟

325
00:20:28,580 --> 00:20:30,580
.ناده بالقائد الأعلى

326
00:20:30,580 --> 00:20:31,750
.ولا تستعمل اسمه بقلّة احترام هكذا

327
00:20:32,120 --> 00:20:34,210
.قيل لي أنّه يرغب في الحديث معنا

328
00:20:34,210 --> 00:20:36,840
.لذلك جهّز ملخّصًا للوضع الحاليّ

329
00:20:37,500 --> 00:20:38,380
.أنت محظوظ

330
00:20:38,960 --> 00:20:41,630
استطعت تولّي أمر الفوضى
.قبل أن يُكتشف خطؤك

331
00:20:41,970 --> 00:20:43,260
!حاضر

332
00:20:43,260 --> 00:20:46,640
!أنا فعلاً مسرور حيال ذلك

333
00:20:49,270 --> 00:20:52,690
!تتصرّفين بتعالٍ معي أيّتها الخنزيرة

334
00:20:52,690 --> 00:20:55,400
!انتظري فحسب

335
00:21:02,190 --> 00:21:03,400
أين أنا؟

336
00:21:03,740 --> 00:21:06,910
!أتسمعونني يا رفاق؟

337
00:21:06,910 --> 00:21:08,240
!أين أنتم؟

338
00:21:08,240 --> 00:21:10,240
!أجيبوني

339
00:21:12,620 --> 00:21:14,210
أهذا معقول؟

340
00:21:15,500 --> 00:21:17,380
أيوجد أيّ أحد هنا؟

341
00:21:19,460 --> 00:21:20,880
.أنا وحدي

342
00:21:21,300 --> 00:21:22,300
!مستحيل

343
00:21:22,300 --> 00:21:25,050
سقطنا جميعًا في أماكن منفصلة؟

344
00:21:30,310 --> 00:21:36,310
...لحم... أشمّ رائحة لحم

345
00:21:36,690 --> 00:21:38,060
!يوكيو

346
00:21:38,060 --> 00:21:39,480
!سوغورو

347
00:21:39,480 --> 00:21:40,900
!كونكومارو

348
00:21:40,900 --> 00:21:42,440
!تاكارا! كورو

349
00:21:42,990 --> 00:21:44,780
!شيمي

350
00:21:46,860 --> 00:21:52,290
...طعام... طعام... طعام

351
00:21:52,700 --> 00:21:55,710
.إليك نصيحة صغيرة

352
00:21:56,000 --> 00:22:00,460
بدءًا من الآن، لا يمكنك الفوز
.ما لم تكن مستعدًّا لقتل بعض البشر

353
00:23:34,970 --> 00:23:39,980
الحلقة القادمة
[عزيمة]