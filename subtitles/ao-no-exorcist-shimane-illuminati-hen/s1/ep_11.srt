1
00:00:00,520 --> 00:00:03,390
ولكن ما الّذي سنفعله حيال شيما؟

2
00:00:03,390 --> 00:00:06,560
!سبق وواجهتُ ميفيستو بشأن إعادته

3
00:00:07,310 --> 00:00:08,320
!بون

4
00:00:09,530 --> 00:00:10,480
!جوزو

5
00:00:15,410 --> 00:00:17,370
.لا أعرف حتّى من أين أبدًا

6
00:00:18,080 --> 00:00:19,490
...إنّ رنزو

7
00:00:19,490 --> 00:00:21,250
.سامحني رجاءً يا بون

8
00:00:21,250 --> 00:00:22,290
ماذا؟

9
00:00:23,410 --> 00:00:24,870
...لا-لا يُعقل أنّ

10
00:00:25,500 --> 00:00:27,750
.رنزو جاسوسنا

11
00:00:29,670 --> 00:00:33,260
تقصد... أنّه عميل مزدوج؟

12
00:00:33,670 --> 00:00:34,840
.هذا صحيح

13
00:02:07,480 --> 00:02:10,900
لا أعرف حتّى كيف أعتذر لكم بشأن
،إخفاء الأمر عنكم طوال هذا الوقت

14
00:02:09,100 --> 00:02:15,030
الحلقة 11: العنكبوت الورديّ

15
00:02:10,900 --> 00:02:13,730
.لكن كان علينا أن نحرص ألاّ يعلم سوى قلّة بهذا

16
00:02:14,150 --> 00:02:16,150
.لحماية رنزو أيضًا

17
00:02:17,950 --> 00:02:19,360
لحمايته؟

18
00:02:19,700 --> 00:02:22,490
هل تعرفون من هم الإيلوميناتي؟

19
00:02:23,080 --> 00:02:25,410
!إنّهم لا يرون البشر كبشر

20
00:02:25,410 --> 00:02:27,830
!لن يتوقّفوا عند قتله فحسب إن كُشف أمره

21
00:02:28,160 --> 00:02:30,420
لماذا ورّطتموه في هذا الأمر؟

22
00:02:30,420 --> 00:02:32,590
.كانت هذه مهمّة أرادها رنزو بشدّة

23
00:02:32,590 --> 00:02:33,840
...ماذا

24
00:02:33,840 --> 00:02:35,340
قلت؟

25
00:02:35,340 --> 00:02:40,590
"مؤسّسة النّور"
"الإيلوميناتي"

26
00:02:35,670 --> 00:02:38,220
.أراني رنزو هذه في مثل هذا الوقت قبل سنة

27
00:02:39,720 --> 00:02:40,590
...أخي جو

28
00:02:41,090 --> 00:02:43,390
هل سبق وسمعت بمؤسّسة النّور؟

29
00:02:43,390 --> 00:02:46,310
.أعطتني فتاة جذّابة هذه البطاقة اليوم

30
00:02:46,310 --> 00:02:48,560
.لكنّ الأمر يبدو مريبًا كثيرًا

31
00:02:48,560 --> 00:02:51,060
.كنتُ أتساءل بشأن التّواصل معهم أم لا

32
00:02:51,060 --> 00:02:52,060
.سأحتفظ بها

33
00:02:52,060 --> 00:02:52,900
ماذا؟

34
00:02:53,400 --> 00:02:57,400
،اسمع. عندما ترى تلك الفتاة ثانية
.فلا تقترب منها أبدًا

35
00:03:00,030 --> 00:03:01,530
...في السّنوات القليلة الماضية

36
00:03:01,530 --> 00:03:05,030
وصلتنا الكثير من التّقارير عن
...جهود مؤسّسة النّور

37
00:03:05,030 --> 00:03:07,410
.لتجنيد أعضاء من التّنظيم

38
00:03:09,370 --> 00:03:11,870
.لا يزال رنزو يافعًا

39
00:03:11,870 --> 00:03:15,710
لا أعتقد أنّهم سيجنّدون فتى
.ليس حتّى عضوًا من التّنظيم بعد

40
00:03:15,710 --> 00:03:19,300
ألن يفعل كبار المسؤولين أيّ شيء حيال هذا؟

41
00:03:19,300 --> 00:03:22,640
.لدينا جواسيسنا الخاصّون في ذلك الجانب بالطّبع

42
00:03:23,220 --> 00:03:27,390
ولكن بغضّ النّظر عن حقيقة
..."وصف أنفسهم بـ"الإيلوميناتي

43
00:03:27,390 --> 00:03:29,020
.إلاّ أنّ الأعضاء الرّئيسيّين يشوبهم الغموض

44
00:03:29,020 --> 00:03:31,890
لم يقترب أيّ أحد من قبل
.بما يكفي لاكتشاف من يكونون

45
00:03:32,140 --> 00:03:35,520
نودّ أخذ بعض الإجراءات قبل
.أن يقدموا على فعل أيّ حركة

46
00:03:38,230 --> 00:03:39,320
...لذلك

47
00:03:40,030 --> 00:03:43,570
أودّ تعيين رنزو كجاسوس
!تحت إشرافي المباشر

48
00:03:45,070 --> 00:03:49,120
على الأرجح أنّ هنالك سببًا
.وراء محاولة الإيلوميناتي لتجنيده

49
00:03:50,200 --> 00:03:52,460
اُختير رنزو من قِبل كيان العبادة
...الرّئيسيّ لعشيرة شيما

50
00:03:52,460 --> 00:03:56,090
.اليامانتاكا إضافة لكونه حامل اللّهب الأسود

51
00:03:56,090 --> 00:03:59,510
إنّ اللّهب الأسود هو الثّاني بعد
.اللّهب الأزرق من حيث القيمة

52
00:03:59,880 --> 00:04:03,760
ليس ذلك فحسب، لكن تمّ قبوله
.أيضًا في مدرسة طرد الأرواح الخاصّة

53
00:04:03,760 --> 00:04:05,550
كما أنّه لا يزال يافعًا
،ولا تحوم حوله الشّبهات

54
00:04:05,550 --> 00:04:09,720
لذلك ستحاول الإيلوميناتي تحويله
.بالتّأكيد إلى بيدق مناسبّ بشدّة لهم

55
00:04:14,730 --> 00:04:18,360
.كما سنفعل نحن تمامًا من الجانب المقابل

56
00:04:18,360 --> 00:04:23,450
هذا يعني أنّ له فرصة أفضل
.من غيره لبلوغ قلب الإيلوميناتي

57
00:04:23,740 --> 00:04:26,700
.لا أستطيع التّفكير في أيّ جاسوس أفضل منه

58
00:04:27,450 --> 00:04:29,410
!اسمح لي برفض هذا العرض رجاءً

59
00:04:29,410 --> 00:04:31,870
—سواء كانت أوامر المدير أم لا، فإنّها ليست

60
00:04:31,870 --> 00:04:34,830
.سنوفّر له دروسَ جاسوسيّة تدريبيّة جيّدة

61
00:04:35,210 --> 00:04:37,000
!ذلك ليس ما أقصده

62
00:04:37,000 --> 00:04:41,260
يحتاج الجاسوس ليكون قاسيًا بما
.يكفي للتّخلّي عن عائلته وأصدقائه

63
00:04:41,760 --> 00:04:44,260
كيف لنا أن نفعل ذلك بفتى
في الخامسة عشر فقط؟

64
00:04:44,930 --> 00:04:46,640
.لا أمانع القيام بذلك

65
00:04:48,100 --> 00:04:48,760
!هذا مؤلم

66
00:04:49,390 --> 00:04:50,260
!رنزو

67
00:04:52,060 --> 00:04:53,520
.أقصد أنّ هذا يبدو ممتعًا

68
00:04:53,520 --> 00:04:55,770
.إضافة لأنّي أرغب في معرفة حقيقتهم

69
00:04:56,060 --> 00:04:58,020
أنت، منذ متى وأن تصغي إلينا؟

70
00:04:58,020 --> 00:04:58,810
...عفوًا

71
00:04:58,810 --> 00:05:00,020
.من البداية

72
00:05:00,020 --> 00:05:01,480
ماذا؟

73
00:05:01,480 --> 00:05:02,320
...هكذا إذًا

74
00:05:02,940 --> 00:05:04,700
من البداية؟

75
00:05:04,700 --> 00:05:08,660
قد يكون مناسبًا لهذا أكثر ممّا
.تتوقّع أيّها الرّئيس شيما

76
00:05:08,660 --> 00:05:09,740
!يكفي رجاءً

77
00:05:09,740 --> 00:05:11,240
.أراهن أنّي كذلك أيضًا

78
00:05:11,240 --> 00:05:13,200
!هذه ليست لعبة

79
00:05:13,200 --> 00:05:15,370
.لا، أنا جادّ

80
00:05:16,290 --> 00:05:18,920
.أودّ فعلاً تولّي هذه المهمّة

81
00:05:20,000 --> 00:05:22,420
أريد أن أقف على قدميّ
.في أقرب وقت ممكن

82
00:05:22,420 --> 00:05:26,430
وأودّ أيضًا أن أرى إلى أيّ مدى
.يمكنني الوصول بقواي الخاصّة

83
00:05:27,590 --> 00:05:29,430
...رنزو

84
00:05:29,430 --> 00:05:33,930
هل أنت مستعدّ لخيانة حتّى
أولئك المقرّبين لك؟

85
00:05:34,680 --> 00:05:37,810
.ذلك هو اختصاصي كما تعلم

86
00:05:40,520 --> 00:05:43,190
.لم يعرف بهذا سوى قلّة قليلة منّا

87
00:05:43,190 --> 00:05:46,700
وفوق ذلك، الوحيد الّذي يعرف أيّ
...نوع من المهمّات يقوم بها رنزو

88
00:05:47,240 --> 00:05:49,320
.هو السّيّد فيليس

89
00:05:58,250 --> 00:06:00,880
هل ارتحت بما يكفي يا غيدويين-كُن؟

90
00:06:00,880 --> 00:06:03,300
!لـ-لوسيفر-ساما

91
00:06:03,300 --> 00:06:04,760
أين أنا؟

92
00:06:08,010 --> 00:06:09,510
.الدّوميناس ليمينيس

93
00:06:09,510 --> 00:06:11,550
الدّوميناس ليمينيس؟

94
00:06:11,550 --> 00:06:14,850
السّفينة الشّبح الطّائرة الضّخمة
الّتي بناها المختبر الأمريكيّ الشّماليّ؟

95
00:06:16,390 --> 00:06:20,060
!بحثي! مختبري! ما الّذي حلّ بهما؟

96
00:06:20,060 --> 00:06:22,820
.لقد سيطر فرسان الصّليب الحقيقيّ على كلّ شيء

97
00:06:23,190 --> 00:06:25,030
.لا داعي للقلق

98
00:06:25,360 --> 00:06:29,240
.كنتُ أنوي دائمًا التّخلّي عن مختبر الشّرق الأقصى

99
00:06:30,030 --> 00:06:33,910
...في الحقيقة، كنتُ أقيم هناك هذه المرّة

100
00:06:33,910 --> 00:06:39,960
فقط لأستعيد قوّتي الجسديّة
.بعد ضغط إعلان الحرب

101
00:06:39,960 --> 00:06:46,210
تلقّيتُ سلفًا تقارير بأنّ مختبر
.الشّرق الأقصى يعمل بنحو استبداديّ

102
00:06:46,210 --> 00:06:50,090
.أواجه صعوبة كبيرة في فهم الأفعال الّتي اتّخذتَها

103
00:06:50,090 --> 00:06:53,010
!ما-ما كان لكلّ هذا أن يحدث أبدًا

104
00:06:53,010 --> 00:06:56,470
فعلتُ ما فعلتُه فقط لأنّي أردت
.إرضاءك يا لوسيفر-ساما

105
00:06:57,850 --> 00:07:00,980
ظننتَ أنّ ذلك سيُرضيني؟

106
00:07:00,980 --> 00:07:04,020
!أتوسّل إليك أن تغفر لي

107
00:07:07,490 --> 00:07:12,030
.عجز أعواني عو عجزي أنا

108
00:07:12,030 --> 00:07:15,370
.لا حاجة لتلقي اللّوم على نفسك

109
00:07:18,080 --> 00:07:20,580
!لوسيفر-ساما

110
00:07:20,580 --> 00:07:22,290
!يا لكلماتك الرّحيمة

111
00:07:22,630 --> 00:07:25,040
...لقد تجاوزتُ أولئك البشر الوضيعين

112
00:07:25,040 --> 00:07:27,550
!وصرتُ كائنًا مميّزًا بحقّ

113
00:07:27,550 --> 00:07:30,050
...في المرّة القادمة، سأتطلّع لتوقّعاتك

114
00:07:30,050 --> 00:07:31,970
!بدون فشل يا لوسيفر-ساما

115
00:07:33,010 --> 00:07:34,640
...غيدويين

116
00:07:35,260 --> 00:07:37,680
...لوسيفر-ساما

117
00:07:38,350 --> 00:07:41,190
.ما أنت إلاّ بشريّ عاديّ

118
00:07:42,940 --> 00:07:43,690
ماذا؟

119
00:07:44,900 --> 00:07:49,190
...مجرّد كائن بشريّ عاديّ أحمق

120
00:07:49,530 --> 00:07:51,950
.وحقير وانتقاميّ

121
00:07:52,280 --> 00:07:53,200
ماذا؟

122
00:08:08,000 --> 00:08:08,920
!أيّها القائد الأعلى

123
00:08:13,630 --> 00:08:18,810
.إنّ الوقت يداهمنا بما أنّي أعلنت الحرب الآن

124
00:08:21,730 --> 00:08:26,060
إن اعترض أيّ شيء طريقنا
...أو اتّضح أنّه مضيعة لوقتنا

125
00:08:27,570 --> 00:08:30,860
.إذًا لن تكون لنا حاجة منه

126
00:08:30,860 --> 00:08:35,490
اسمعوا! خذوا هذه اللّحظة
!لتتلوا قسَم الإيلوميناتي

127
00:08:35,780 --> 00:08:38,780
.سنرشد العالم إلى الوئام

128
00:08:38,780 --> 00:08:40,370
...إنّنا الأبطال

129
00:08:40,370 --> 00:08:44,500
الّذين وقفوا لبناء عالم واحد
.بدون شياطين أو بشر

130
00:08:44,870 --> 00:08:48,250
.لن نتردّد مهما كانت المحنة الّتي تنتظرنا

131
00:08:48,250 --> 00:08:50,250
!لن نخشى حتّى الموت

132
00:08:54,050 --> 00:08:55,260
...مهما حدث

133
00:08:56,140 --> 00:08:59,510
.فكّروا في أنّ رنزو بعيد عن متناولنا

134
00:09:02,560 --> 00:09:03,480
...بون

135
00:09:03,890 --> 00:09:06,100
.آسف. شردتُ قليلاً

136
00:09:06,440 --> 00:09:09,150
لقد تأخّر أوكومورا-كُن، صحيح؟

137
00:09:09,480 --> 00:09:11,440
كيف حالكم جميعًا يا رفاق؟

138
00:09:11,690 --> 00:09:14,700
!أنا شيما! شكرًا لكم

139
00:09:14,700 --> 00:09:17,450
إنّ المدرسة الخاصّة مزعجة اليوم أيضًا، صحيح؟

140
00:09:17,820 --> 00:09:21,330
من المؤسف أنّ هذا ليس درسًا
عن الأثداء، صحيح؟

141
00:09:21,330 --> 00:09:23,290
!أثداء! أثداء

142
00:09:24,660 --> 00:09:26,670
.صحيح، سأوزّع الحلوى على الجميع

143
00:09:26,670 --> 00:09:28,080
!تفضّلي

144
00:09:28,080 --> 00:09:29,960
ما الّذي حلّ بك يا أوكومورا-كُن؟

145
00:09:30,380 --> 00:09:33,090
!أنا شيما، مفهوم؟ تفضّل بعض الحلوى

146
00:09:33,090 --> 00:09:35,840
أنت أوكومورا-كُن بشعر مستعار
ورديّ فحسب، صحيح؟

147
00:09:36,300 --> 00:09:37,010
ماذا؟

148
00:09:37,010 --> 00:09:38,590
!سُحقًا يا كونكومارو

149
00:09:38,590 --> 00:09:41,640
إن كنتَ من كانساي، فعليك منحي
!ردًّا كوميديًّا أفضل من ذلك حتّى

150
00:09:41,640 --> 00:09:44,270
!سوغورو! لماذا لا تبتهج؟

151
00:09:44,270 --> 00:09:45,350
!ماذا؟

152
00:09:45,770 --> 00:09:49,230
أوكومورا، هلاّ التزمت الصّمت قليلاً؟

153
00:09:49,230 --> 00:09:50,060
ماذا؟

154
00:09:50,400 --> 00:09:51,320
...أنا

155
00:09:51,320 --> 00:09:53,900
!أشعر بالمسؤوليّة أيضًا

156
00:09:53,900 --> 00:09:56,490
!قلتُ أنّي سأعيده، ولكن... سُحقًا

157
00:09:56,490 --> 00:09:57,200
...رين

158
00:09:57,570 --> 00:10:00,240
!نادوني وسأحضر في الحال

159
00:10:00,240 --> 00:10:01,700
!هذا أنا شيما يا رفاق

160
00:10:02,700 --> 00:10:04,410
لم يحضر سينسي بعد، صحيح؟

161
00:10:04,410 --> 00:10:06,290
!وصلتُ في آخر لحظة

162
00:10:06,290 --> 00:10:07,410
مهلاً! من أنت؟

163
00:10:07,410 --> 00:10:08,250
!أنا شيما

164
00:10:08,250 --> 00:10:09,380
!بل أنا شيما

165
00:10:10,710 --> 00:10:12,420
.آسف على التّأخير أيّها الفصل

166
00:10:12,420 --> 00:10:13,670
.سأسجّل الحضور الآن

167
00:10:14,380 --> 00:10:15,460
...أوكومورا

168
00:10:15,460 --> 00:10:16,880
.أرى أنّه غائب

169
00:10:16,880 --> 00:10:17,550
ماذا؟

170
00:10:17,550 --> 00:10:18,340
.كاميكي

171
00:10:18,340 --> 00:10:19,090
.حاضرة

172
00:10:19,090 --> 00:10:19,760
.شيما

173
00:10:19,760 --> 00:10:20,430
.حاضر –
.حاضر –

174
00:10:20,430 --> 00:10:21,100
ماذا؟

175
00:10:21,100 --> 00:10:21,930
.سوغورو

176
00:10:21,930 --> 00:10:22,720
.حاضر

177
00:10:22,720 --> 00:10:23,470
.تاكارا

178
00:10:23,470 --> 00:10:25,020
أهناك خطب ما في عينيك؟

179
00:10:25,020 --> 00:10:26,390
ألا تراني هنا؟ –
ماذا؟ –

180
00:10:26,390 --> 00:10:27,100
.ميوا

181
00:10:27,100 --> 00:10:27,940
.حاضر

182
00:10:27,940 --> 00:10:28,810
.مورياما

183
00:10:28,810 --> 00:10:29,810
!حاضرة

184
00:10:30,100 --> 00:10:33,070
.حسنًا. لنبدأ درس صيدلانيّات الشّياطين

185
00:10:33,360 --> 00:10:36,440
ابدآ القراءة رجاء بصوت عال من فصل
.غضروف السّاحرات كلاكما يا شيما

186
00:10:36,740 --> 00:10:37,440
.حسنًا

187
00:10:37,440 --> 00:10:39,700
!مهلاً! هذا غريب جدًّا

188
00:10:39,700 --> 00:10:43,450
إنّ وجود اثنين من شيما أمر غريب كيفما
نظرت إليه، صحيح يا أوكومورا-سينسي؟

189
00:10:43,830 --> 00:10:46,120
أعني ما الّذي ترمي إليه يا أوكومورا-كُن؟

190
00:10:46,580 --> 00:10:47,620
.أسف

191
00:10:48,160 --> 00:10:51,080
،ظننتُ أنّي تحت اختبار ما
.لذلك كنتُ حذرًا

192
00:10:51,080 --> 00:10:53,920
كيف هي حياتك اليوميّة يا أوكومورا-سينسي؟

193
00:10:54,170 --> 00:10:57,420
لا، لا، لا! لماذا لا يوبّخني أيّ أحد منكم؟

194
00:10:57,420 --> 00:11:00,800
!لقد عاد شيما الجاسوس
!يفترض بكم أن تبدؤوا بتوبيخي الآن

195
00:11:02,680 --> 00:11:05,350
.ليس وكأنّي أطلب منكم القيام بذلك بالفعل

196
00:11:06,600 --> 00:11:08,100
!سامحني رجاءً

197
00:11:08,640 --> 00:11:12,350
!لم أفكّر أبدًا أنّي سأعود إلى هنا أيضًا

198
00:11:12,770 --> 00:11:16,860
كنتُ واثقًا أنّي سأودّعكم وحياتي
!المدرسيّة إن تمّ الإمساك بي يومًا

199
00:11:16,860 --> 00:11:17,860
—ولكن ها أنا ذا

200
00:11:20,400 --> 00:11:22,450
—بون –
.لقد نجوت إذًا –

201
00:11:23,820 --> 00:11:25,200
...هل لديك أدنى فكرة

202
00:11:25,200 --> 00:11:27,870
كم كنّا قلقين عليك؟

203
00:11:28,160 --> 00:11:29,370
!أكيد أنّي سأسامحك

204
00:11:29,370 --> 00:11:32,370
!ولكن في المقابل، ستخبرنا بالحقيقة في الحال

205
00:11:33,960 --> 00:11:34,960
!إنّه محقّ

206
00:11:35,340 --> 00:11:37,960
.سمحتَ لأوكي وميكي بالعيش

207
00:11:38,380 --> 00:11:41,090
لا بدّ أنّه كان لديك سبب ما لذلك، صحيح؟

208
00:11:43,180 --> 00:11:47,430
.إنّ مثل هذه الأمور مزعجة كثيرًا بالنّسبة لي

209
00:11:47,430 --> 00:11:50,480
...أعتقد أنّه يمكن وصفها بـ

210
00:11:50,810 --> 00:11:53,310
!مرحلتي المتمرّدة الثّانية

211
00:11:53,650 --> 00:11:56,190
مرحلة تمرّد؟

212
00:11:56,610 --> 00:11:59,280
هل أنت راضٍ الآن يا بون؟

213
00:12:02,820 --> 00:12:06,080
!وكأنّ عذرًا واهيًا كهذا قد يُرضيني

214
00:12:07,540 --> 00:12:09,160
...فسأقتله

215
00:12:09,500 --> 00:12:11,210
!ثمّ سأموت أنا أيضًا

216
00:12:11,500 --> 00:12:12,790
!مهلاً يا سوغورو

217
00:12:12,790 --> 00:12:14,670
!لا تقل لي أنّك تنوي الموت أيضًا

218
00:12:14,670 --> 00:12:15,420
ماذا؟

219
00:12:15,790 --> 00:12:18,170
من قد يموت لأجل حثالة مثله أيّها الحثالة؟

220
00:12:18,170 --> 00:12:19,170
!كاذب

221
00:12:19,710 --> 00:12:20,460
!إيزومو-تشان

222
00:12:20,460 --> 00:12:22,340
!طرد الحثالة

223
00:12:27,050 --> 00:12:28,350
...أنا فعلاً

224
00:12:28,350 --> 00:12:30,720
!سأموت هنا

225
00:12:31,180 --> 00:12:32,850
ماذا بوسعي فعله؟

226
00:12:32,850 --> 00:12:34,560
.سأساعدك يا شيما

227
00:12:34,560 --> 00:12:36,560
...أوكومورا-كُن

228
00:12:36,560 --> 00:12:39,900
ما رأيك أن نتخلّص من كلّ ملابسك أوّلاً؟

229
00:12:39,900 --> 00:12:40,690
ماذا؟

230
00:12:40,690 --> 00:12:44,150
سنهدأ جميعًا إن كنت ترتدي
!ملابسك الدّخليّة فقط

231
00:12:44,150 --> 00:12:46,740
عمّا تتحدّث؟ توقّف رجاءً
...يا أوكومورا-كُن! أنا

232
00:12:51,370 --> 00:12:53,410
!مهلاً يا رفاق! ستقتلونه

233
00:12:53,710 --> 00:12:55,830
!هل أنت بخير يا شيما-كُن؟

234
00:12:56,250 --> 00:12:58,420
...مورياما-سان

235
00:12:58,710 --> 00:13:00,300
!أنت ملاك

236
00:13:00,300 --> 00:13:03,130
!ساعديني رجاءً

237
00:13:03,420 --> 00:13:05,550
!كلاّ

238
00:13:07,010 --> 00:13:09,260
!حرقت حتّى ملابسه الدّخليّة –
!آسف. لقد أخطأت –

239
00:13:09,260 --> 00:13:10,680
.انتبهوا جميعًا

240
00:13:10,680 --> 00:13:13,560
.عليكم أن تكفّوا عن مضايقته

241
00:13:14,640 --> 00:13:15,770
!ميفيستو

242
00:13:16,440 --> 00:13:17,860
.لم أركم منذ مدّة

243
00:13:18,110 --> 00:13:19,440
—أيّها الـ –
!توقّف –

244
00:13:19,440 --> 00:13:22,780
.عليّ أخذكم جميعًا للمكتب في الحال

245
00:13:22,780 --> 00:13:26,160
هناك ضيف مزعج من الفاتيكان
...في انتظارنا هناك الآن

246
00:13:26,160 --> 00:13:26,950
"...واحد"

247
00:13:26,950 --> 00:13:27,820
"...اثنان"

248
00:13:27,820 --> 00:13:28,870
"!ثلاثة"

249
00:13:33,200 --> 00:13:35,080
!يا للهول

250
00:13:35,080 --> 00:13:37,370
!يبدو هذا كسحر بالفعل

251
00:13:38,210 --> 00:13:39,750
.مرحبًا

252
00:13:39,750 --> 00:13:41,880
.أنا لوين لايت

253
00:13:41,880 --> 00:13:44,010
!سررت بلقائكم جميعًا

254
00:13:45,050 --> 00:13:47,220
!لا-لايتنينغ

255
00:13:47,220 --> 00:13:49,010
ماذا؟ هل هو مشهور أو ما شابه؟

256
00:13:49,010 --> 00:13:51,350
إنّه أحد الفرسان العظماء
!واليد اليمنى للفارس المقدّس

257
00:13:51,760 --> 00:13:54,350
!إنّه تقريبًا الرّقم 2 في التّنظيم

258
00:13:54,350 --> 00:13:58,560
،إنّه خبير في الأريا وسحر الاستدعاء
!ويُعرف بلقب "لايتنينغ" أي البرق

259
00:13:59,190 --> 00:14:00,310
...يا إلهي

260
00:14:00,310 --> 00:14:02,150
.لستُ شخصًا مميّزًا لذلك الحدّ

261
00:14:02,150 --> 00:14:03,570
!مقرف –
!مهلاً –

262
00:14:03,570 --> 00:14:06,990
هل أنت بالفعل هو أوكومورا رين-كُن
!الّذي تسري في عروقه دماء ساتان؟

263
00:14:06,990 --> 00:14:07,740
ماذا؟

264
00:14:07,740 --> 00:14:09,950
!كنت أودّ أن ألقاء منذ وقت طويل

265
00:14:09,950 --> 00:14:12,870
!كم هذا مذهل! لا هالة لديك على الإطلاق

266
00:14:12,870 --> 00:14:14,790
!تبدو مثل أيّ مراهق عاديّ

267
00:14:14,790 --> 00:14:15,580
ماذا؟

268
00:14:16,790 --> 00:14:17,870
...شيما رنزو-كُن

269
00:14:18,710 --> 00:14:19,830
.نعم

270
00:14:19,830 --> 00:14:22,090
.أحسنتما عملاً أنت والسّيّد فيليس

271
00:14:22,420 --> 00:14:26,630
لطالما كان التّنظيم متعطّشًا للحصول
.على معلومات عمّا يدور داخل الإيلوميناتي

272
00:14:26,630 --> 00:14:31,010
لكنّ كبار المسؤولين لا يثقون كثيرًا
...في السّيّد فيليس

273
00:14:32,100 --> 00:14:33,720
.هذا لسوء الحظّ بالفعل

274
00:14:34,100 --> 00:14:38,190
لذلك أتيتُ لتحديد إن كان بالإمكان
.أن نثق بك أم لا يا شيما-كُن

275
00:14:39,310 --> 00:14:40,560
..."نثق به"

276
00:14:42,440 --> 00:14:47,700
،عفوًا، إن اتّضح أنّه لا يمكننا ذلك
ما الّذي سيحدث لشيما-سان؟

277
00:14:48,030 --> 00:14:49,910
.سأضطرّ حينها لتعذيبه

278
00:14:52,240 --> 00:14:54,490
.لكنّي أودّ تفادي القيام بذلك إن أمكن

279
00:14:54,830 --> 00:14:56,500
.لنبدأ بالعمل في الحال

280
00:14:57,160 --> 00:15:00,210
أخبرنا، كيف استطعت العودة
إلى فرسان الصّليب الحقيقيّ؟

281
00:15:00,210 --> 00:15:01,540
!حسنًا

282
00:15:01,540 --> 00:15:03,460
...إنّ ما حدث هو

283
00:15:04,460 --> 00:15:06,800
.عد إلى فرسان الصّليب الحقيقيّ

284
00:15:07,090 --> 00:15:08,920
!مهلاً لحظة رجاءً

285
00:15:08,920 --> 00:15:13,050
إن عدتُ الآن، فلن يكون الوضع
!جيّدًا بالنّسبة لي

286
00:15:13,390 --> 00:15:16,560
.فعلاً؟ لكنّي واثقة أنّ لا شيء من ذلك سيحدث

287
00:15:16,850 --> 00:15:18,060
أليس كذلك؟

288
00:15:18,350 --> 00:15:20,060
...أ-أنا

289
00:15:20,060 --> 00:15:22,860
.سيرغب التّنظيم بمعلومات عنّا بكلّ تأكيد

290
00:15:22,860 --> 00:15:26,320
.ولكن لا أعتقد أنّهم سيثقون بي بعد الآن

291
00:15:26,650 --> 00:15:30,320
إن عجزتَ عن التّسلّل لصفوف فرسان
.الصّليب الحقيقيّ، فلا حاجة لنا بك

292
00:15:30,740 --> 00:15:34,280
عليك أن تحظى بثقتهم ثانية
.بلسانك المخادع ذاك

293
00:15:34,280 --> 00:15:36,370
.إن لم تستطع، فسينتهي الأمر بالكامل بيننا

294
00:15:36,370 --> 00:15:37,700
...هكذا إذًا

295
00:15:38,250 --> 00:15:43,920
ما يعني أنّك الآن جاسوس رسميّ لكِلا الطّرفين؟

296
00:15:43,920 --> 00:15:47,760
ولكن بصراحة، لستُ واثقًا
.إن كان الإيلوميناتي يثقون بي أيضًا

297
00:15:48,050 --> 00:15:50,590
!لا داعي للقلق! يمكنك النّجاح

298
00:15:50,590 --> 00:15:52,840
!فلم يقرّروا قتلك بعد

299
00:15:53,930 --> 00:15:54,890
.هذا صحيح

300
00:15:54,890 --> 00:15:57,350
.إنّ اكتشاف كيفية استعماله أشبه بلعبة

301
00:15:57,350 --> 00:16:01,390
،إن استعملناه بطريقة صحيح
.قد نستطيع التّغلّب على الإيلوميناتي

302
00:16:01,390 --> 00:16:06,150
نعم. لكن هذا فقط إن افترضنا
أنّ بإمكاننا أن نثق به، صحيح؟

303
00:16:07,610 --> 00:16:11,150
هل هو من النّوع الّذي يمكنكم
أن تثقوا به من وجهة نظركم؟

304
00:16:14,570 --> 00:16:17,030
!مستحيل أن نثق به على الإطلاق

305
00:16:17,030 --> 00:16:18,120
!أوكومورا

306
00:16:18,120 --> 00:16:19,250
!مهلاً، مهلاً

307
00:16:19,580 --> 00:16:24,420
أليس هذا هو الوقت الّذي تصرخ فيه
!عادة قائلاً أنّ شيما صديقنا؟

308
00:16:24,420 --> 00:16:25,960
!كلاّ! أنا أتحدّث عنك أنت

309
00:16:25,960 --> 00:16:27,670
ماذا؟ تقصدني أنا؟

310
00:16:27,670 --> 00:16:31,920
إنّ السّبب وراء شكّ الجميع في شيما
!من الأساس هو أنّه لا أحد يثق بك

311
00:16:31,920 --> 00:16:33,430
.هذا ليس عدلاً

312
00:16:33,430 --> 00:16:35,510
.لكنّه محقّ في كلامه

313
00:16:35,510 --> 00:16:36,180
ماذا؟

314
00:16:36,760 --> 00:16:40,560
.أنا ممتنّة لك على حمايتك لأختي

315
00:16:40,560 --> 00:16:43,310
لكن لماذا لم تخبرني من البداية؟

316
00:16:43,310 --> 00:16:46,650
لو أنّك أخبرتني عندما انضممتُ
—للأكاديميّة، لكنتُ

317
00:16:46,650 --> 00:16:49,150
!انقلبتم عليّ جميعًا الآن

318
00:16:49,150 --> 00:16:50,570
!هذا ليس كلّ شيء

319
00:16:50,570 --> 00:16:51,780
...إن كان جاسوسًا

320
00:16:51,780 --> 00:16:54,070
...كنّا لنعرف أيضًا أنّ تودو كان خائنًا

321
00:16:54,070 --> 00:16:56,410
!قبل أن تُسرق العين اليسرى للملك النّجس

322
00:16:56,740 --> 00:16:58,200
.ذلك صحيح

323
00:16:58,200 --> 00:16:59,990
.كنتُ مدركًا لذلك

324
00:17:00,740 --> 00:17:05,330
ما فعلناه لفرع كيوتو وأولئك الّذين
.لقوا حتفهم كان خاطئًا إلى حدّ ما

325
00:17:05,330 --> 00:17:08,960
ما... إذًا لأيّ غرض كانت تلك المعركة؟

326
00:17:09,710 --> 00:17:13,340
.إنّ السّيّد فيليس مشكوك في أمره بالفعل

327
00:17:13,760 --> 00:17:19,430
من المرجّح بشدّة أنّه كان خلف الهجمات
.مِن أمايمون والدّكتور نيغاوس

328
00:17:19,430 --> 00:17:21,310
.والهدف هو اختبار قدرات أخي

329
00:17:21,310 --> 00:17:22,310
ماذا؟

330
00:17:22,310 --> 00:17:24,980
.لكن ما زال هنالك لغز أكبر

331
00:17:24,980 --> 00:17:28,690
لماذا يسمح لنغيل ساتان
بالعيش ولماذا يقوم بتربيته؟

332
00:17:29,020 --> 00:17:30,650
!لنستمع لتفسيرك الآن

333
00:17:30,650 --> 00:17:32,820
!لا مهرب لك من هذا أيّها السّيّد فيليس

334
00:17:38,740 --> 00:17:42,410
!يا رفاق! أرى أنّكم تستعملون أدمغتكم أخيرًا

335
00:17:42,410 --> 00:17:44,370
.رغم أنّ ذلك بعد فوات الأوان

336
00:17:44,660 --> 00:17:46,420
.الأمر تمامًا كما قلتم

337
00:17:46,420 --> 00:17:50,380
كنتُ أجبركم جميعًا على خوض
.كلّ هذه الاختبارات

338
00:17:51,170 --> 00:17:54,170
هناك ترتيب عليّ اتّباعه بشأن
،تطويركم واستعمالكم

339
00:17:54,170 --> 00:17:57,180
.ولا أستطيع القيام بحركة واحدة خاطئة

340
00:17:57,180 --> 00:17:58,010
...وهذا ينطبق عليك

341
00:17:58,010 --> 00:18:02,970
...وعليك... وعليك... وعليك
...وعليك... وعليك... وعليك

342
00:18:02,970 --> 00:18:04,730
.وبطبيعة الحال، عليك أيضًا

343
00:18:05,390 --> 00:18:09,310
،أنتم بيادقي العزيزة
.وكلّ واحد منكم لا غنى عنه

344
00:18:09,310 --> 00:18:12,900
.وأنا اللاّعب الّذي يتحكّم بهذه البيادق

345
00:18:12,900 --> 00:18:15,690
ماذا؟ ما المقصود بهذا؟

346
00:18:16,110 --> 00:18:18,030
نحن مجرّد ألعاب في نظرك؟

347
00:18:18,360 --> 00:18:20,490
.أنا لستُ العدوّ في كلّ الأحوال

348
00:18:20,490 --> 00:18:23,080
أليست تلك الحقيقة وحدها كافية؟

349
00:18:23,080 --> 00:18:24,700
!بالتّأكيد ليست كافية

350
00:18:24,700 --> 00:18:25,450
!أخي

351
00:18:25,700 --> 00:18:28,170
ماذا تظنّنا أيّها الوغد؟

352
00:18:28,170 --> 00:18:29,880
!أنت الخائن الحقيقيّ هنا

353
00:18:30,790 --> 00:18:34,050
التّكشير عن أنيابك في وجهي
.هو أكثر الأشياء غباء الّتي يمكنك فعلها

354
00:18:34,050 --> 00:18:35,130
.لذلك تراجع

355
00:18:35,130 --> 00:18:36,670
!اخرس

356
00:18:36,670 --> 00:18:40,010
لماذا عليّ القيام بما تقوله لي؟

357
00:18:40,590 --> 00:18:42,010
أليس الأمر واضحًا؟

358
00:18:43,180 --> 00:18:45,310
.لهزيمة لوسيفر

359
00:18:51,520 --> 00:18:54,530
...أنتم أيّها الدّيدان الضّعيفة

360
00:18:54,530 --> 00:18:58,740
لا تصلحون إلاّ لتكونوا تحت
.رحمة تهديد العظماء

361
00:18:59,110 --> 00:19:01,410
،إن كان من الصّعب عليكم تقبّل ذلك

362
00:19:01,410 --> 00:19:04,740
.إذًا أروني على الأقلّ أتفه علامات تطوّركم

363
00:19:07,080 --> 00:19:08,500
—أيّها الوغد

364
00:19:08,830 --> 00:19:10,330
.هذا يكفي

365
00:19:10,330 --> 00:19:11,960
.لقد خرجنا عن موضوعنا

366
00:19:12,290 --> 00:19:16,340
لكنّي صرتُ واثقًا الآن أنّ السّيّد فيليس
.لا يملك ثقة من يوجدون هنا أيضًا

367
00:19:18,920 --> 00:19:22,720
حسنًا، هل نتّفق إذًا أنّه لا يمكننا
أن نثق بشيما أيضًا؟

368
00:19:22,720 --> 00:19:24,850
!مهلاً لحظة رجاءً

369
00:19:24,850 --> 00:19:27,220
!أعطوني فرصة للدّفاع عن نفسي

370
00:19:27,600 --> 00:19:28,600
ماذا؟

371
00:19:33,020 --> 00:19:34,730
.أنا أثق به

372
00:19:36,650 --> 00:19:40,150
!أنا أيضًا! أنا أثق بشيما-سان الّذي أعرفه

373
00:19:40,150 --> 00:19:43,160
.لا يُخطئ ميوا-كُن في حكمه على الآخرين أبدًا

374
00:19:43,450 --> 00:19:46,410
.قد يكون حثالة، لكنّه ليس شخصًا سيّئًا

375
00:19:46,410 --> 00:19:47,540
.مع التّأكيد أنّه حثالة

376
00:19:49,330 --> 00:19:51,540
!شيما صديق لي

377
00:19:51,540 --> 00:19:53,290
!لن أسمح لك بتعذيبه

378
00:19:54,500 --> 00:19:55,630
.هكذا إذًا

379
00:19:56,170 --> 00:19:59,130
.حسنًا، أظنّني سأذهب الآن

380
00:19:59,130 --> 00:20:01,470
بالتّأكيد لن تدعه وشأنه، صحيح؟

381
00:20:01,470 --> 00:20:04,220
بالطّبع سأدعه وشأنه. لم أكن أنوي
.القيام بعكس ذلك من الأساس

382
00:20:04,220 --> 00:20:05,180
من الأساس؟

383
00:20:05,970 --> 00:20:07,430
.حاليًّا على الأقلّ

384
00:20:08,850 --> 00:20:12,230
أنا مختلف قليلاً عن إنجل
.وبقيّة كبار المسؤولين

385
00:20:12,730 --> 00:20:15,860
ولكن، لا نرغب في انتشار خبر
،حادثة شيما-كُن أكثر من هذا

386
00:20:15,860 --> 00:20:19,990
لذلك سأرسل لكم جميعًا اتّفاقيّات عدم
.الإفصاح لتوقيعها لاحقًا. أنا أعتمد عليكم

387
00:20:21,490 --> 00:20:23,360
ماذا عن شيما؟

388
00:20:23,360 --> 00:20:26,200
.يبدو أنّه تفادى التّعرّض للتّعذيب

389
00:20:26,200 --> 00:20:27,450
!حمدًا على هذا

390
00:20:27,450 --> 00:20:32,290
حسنًا، ربّما بدا ذلك الشّخص راضيًا
—وهو يغادر، ولكنّي لستُ

391
00:20:31,250 --> 00:20:32,290
.مهلاً، مهلاً

392
00:20:32,290 --> 00:20:34,380
.سنواصل هذا الحديث لاحقًا

393
00:20:37,500 --> 00:20:38,800
!ذلك الوغد

394
00:20:39,460 --> 00:20:41,920
.يبدو أنّنا تجاوزنا هذا بطريقة ما

395
00:20:41,920 --> 00:20:44,390
.لا يروق لي ذلك المدعوّ لايتنينغ فحسب

396
00:20:44,390 --> 00:20:45,850
.بأكثر من طريقة

397
00:20:46,220 --> 00:20:47,260
...عفوًا

398
00:20:47,260 --> 00:20:48,600
ماذا عنّا؟

399
00:20:48,600 --> 00:20:51,270
.ما زال لديّ ما أقوله لكما

400
00:20:51,270 --> 00:20:52,730
...ولكن

401
00:20:54,600 --> 00:20:59,530
لا يوجد بكلّ تأكيد الكثير ممّن
...قد يندفعون بلا أيّ خوف

402
00:20:59,530 --> 00:21:04,360
عندما تتوقّع منهم أن يظلّوا بعيدين
.أو معاملتك بحذر شديد من باب التّرهيب

403
00:21:05,160 --> 00:21:07,990
.لا أقابل أشخاصًا هكذا كلّ يوم

404
00:21:07,990 --> 00:21:10,080
ألا توافقانني؟

405
00:21:10,540 --> 00:21:12,000
.أكيد

406
00:21:12,370 --> 00:21:15,620
.أنا أعرف ذلك أكثر من غيري

407
00:21:16,630 --> 00:21:18,630
هل أنت واثق من ذلك؟

408
00:21:20,380 --> 00:21:21,840
...حسنًا يا أوكومورا-سينسي

409
00:21:21,840 --> 00:21:25,380
.أرسل تقريرًا بما حدث هنا لكيريغاكوري-سينسي

410
00:21:27,390 --> 00:21:28,390
.حاضر

411
00:21:29,140 --> 00:21:33,390
يا إلهي، أشعر وكأنّنا تعرّضنا
!لطقوس تطهير للتّوّ

412
00:21:33,680 --> 00:21:36,230
!أنا منهك بالكامل

413
00:21:36,650 --> 00:21:37,900
.أحسنت عملاً

414
00:21:38,270 --> 00:21:40,150
.أستأذن بالذّهاب الآن

415
00:21:40,690 --> 00:21:41,860
!مهلاً لحظة

416
00:21:41,860 --> 00:21:43,030
!كدت أنسى

417
00:21:43,400 --> 00:21:47,280
أوكومورا-سينسي، قابلتَ القائد الأعلى، صحيح؟

418
00:21:54,210 --> 00:21:58,130
.أقصد ملك النّور لوسيفر-سان

419
00:23:34,970 --> 00:23:39,980
الحلقة القادمة
[مشاعر حقيقيّة خفيّة]