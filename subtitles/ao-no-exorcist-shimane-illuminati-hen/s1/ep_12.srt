1
00:00:01,520 --> 00:00:05,350
.ماذا؟ أظنّني سمعتُ أنّك قابلته

2
00:00:05,690 --> 00:00:09,610
.إنّه ذلك الشّخص الشّاحب والهزيل

3
00:00:11,610 --> 00:00:14,860
.أقصد بكلامي ملك النّور لوسيفر-سان

4
00:00:19,240 --> 00:00:20,740
عمّ تتحدّث؟

5
00:00:21,080 --> 00:00:22,750
!ما بالك؟

6
00:00:22,750 --> 00:00:25,960
.لديّ رسالة من لوسيفر-سان بنفسه

7
00:00:25,960 --> 00:00:28,130
.يبدو أنّه يريدني أن أذكّرك

8
00:00:28,500 --> 00:00:33,760
".إن أرتدتَ الخلاص، فبابي مفتوح دائمًا"

9
00:02:07,480 --> 00:02:11,730
!سُحقًا! ذلك المهرّج الغبيّ ميفيستو

10
00:02:12,020 --> 00:02:14,980
إن كنت تريد هزيمة لوسيفر لهذا
!الحدّ، فلماذا لا تقاتله بنفسك؟

11
00:02:15,530 --> 00:02:20,240
.بصراحة، لا أفهم أيًّا من هذا. أنا أستسلم

12
00:02:15,530 --> 00:02:21,530
الحلقة 12: مشاعر حقيقيّة خفيّة

13
00:02:20,240 --> 00:02:22,950
لماذا لا نذهب للمنزل جميعًا ونرتاح؟

14
00:02:22,950 --> 00:02:25,240
.معك حقّ. أحتاج للتّفكير في هذا أيضًا

15
00:02:25,580 --> 00:02:27,620
.إنّني أوافقك الرّأي هذه المرّة

16
00:02:29,040 --> 00:02:30,620
...لكنّ شيما-كُن

17
00:02:32,210 --> 00:02:36,380
سيعود للثّانويّة وللمدرسة الخاصّة أيضًا، صحيح؟

18
00:02:36,800 --> 00:02:41,010
هل تعتقدون أنّ بإمكاننا العودة
لسابق عهدنا كأصدقاء ثانية؟

19
00:02:42,260 --> 00:02:43,390
...مورياما-سان

20
00:02:44,140 --> 00:02:46,850
!غبيّة! لا تقلقي حيال هذا

21
00:02:46,850 --> 00:02:48,430
أتذكرين ما قلناه جميعًا للتّوّ؟

22
00:02:48,430 --> 00:02:50,350
.إنّنا نثق بشيما

23
00:02:52,060 --> 00:02:53,020
ماذا؟

24
00:02:53,270 --> 00:02:55,020
!من المستحيل أن أثق فيه

25
00:02:55,400 --> 00:02:56,190
ماذا؟

26
00:02:56,190 --> 00:02:59,150
السّبب الوحيد الّذي جعلني
!أقول ذلك هو لإنقاذه

27
00:02:59,150 --> 00:03:00,030
ماذا؟

28
00:03:00,530 --> 00:03:01,530
...بون

29
00:03:01,530 --> 00:03:03,030
...كونكومارو

30
00:03:03,030 --> 00:03:06,290
هل ما زلت تثق به بالفعل؟

31
00:03:06,290 --> 00:03:08,450
...أنا

32
00:03:11,620 --> 00:03:13,580
!لم تعد لي أدنى فكرة

33
00:03:13,580 --> 00:03:15,210
!بون! انتظر رجاءً

34
00:03:15,590 --> 00:03:16,550
!تبًّا

35
00:03:16,550 --> 00:03:18,340
!يا له من حثالة

36
00:03:19,800 --> 00:03:21,800
.لا أحبّ هذا بالفعل

37
00:03:23,970 --> 00:03:27,220
.إنّني أوافقك الرّأي هذه المرّة أيضًا

38
00:03:32,100 --> 00:03:34,770
سينسي، هل أنت بخير؟

39
00:03:34,770 --> 00:03:36,940
!تبدو مخيفًا للغاية

40
00:03:41,200 --> 00:03:43,820
كيف يمكنني الهرب من هنا؟

41
00:03:44,820 --> 00:03:47,990
على الأرجح أنّ أخي بإمكانه الهرب
.من هنا بحرقه لهذه الجدران

42
00:03:47,990 --> 00:03:49,870
!ليتني كنتُ أملك لهيب أخي

43
00:03:50,120 --> 00:03:51,580
...إذًا

44
00:03:51,910 --> 00:03:55,500
هل بإمكاننا إنقاذهم إن طردنا
تلك الطّفيليّات الشّيطانيّة منهم؟

45
00:03:55,880 --> 00:03:59,630
!هذا ليس وقتًا مناسبًا للتّفكير بعمق
لماذا تقوم بهذا دائمًا؟

46
00:04:08,560 --> 00:04:09,220
!مستحيل

47
00:04:18,190 --> 00:04:20,030
..."سررت بلقائك"

48
00:04:20,030 --> 00:04:22,610
أفترض أنّها التّحيّة المناسبة
...في وضع كهذا

49
00:04:22,610 --> 00:04:24,570
.يا أوكومورا يوكيو-كُن

50
00:04:25,610 --> 00:04:27,580
كيف؟ لماذا؟

51
00:04:28,330 --> 00:04:32,450
.أنا ملك النّور لوسيفر

52
00:04:33,210 --> 00:04:36,330
.سمعتُ الكثير عنك من تودو-كُن

53
00:04:39,380 --> 00:04:40,670
.لا داعي للقلق

54
00:04:41,010 --> 00:04:42,880
.لا نيّة لي في إيذائك

55
00:04:42,880 --> 00:04:44,470
!لا تقترب

56
00:04:55,940 --> 00:04:57,100
.فهمت

57
00:04:57,520 --> 00:05:00,070
.كان تودو-كُن محقًّا تمامًا

58
00:05:00,070 --> 00:05:02,740
.إنت مثير للاهتمام بالفعل

59
00:05:03,110 --> 00:05:04,490
.أريدك

60
00:05:04,490 --> 00:05:07,570
.أنت مرحّب بك في الإيلوميناتي

61
00:05:07,570 --> 00:05:09,240
!لا تتفوّه بهكذا هراء

62
00:05:09,240 --> 00:05:10,280
—لماذا قد

63
00:05:11,910 --> 00:05:15,750
.لكن حسب الوضع الحاليّ، فإنّك في خطر

64
00:05:15,750 --> 00:05:18,040
.إنّك لستَ محميًّا

65
00:05:18,040 --> 00:05:21,420
،إن عرف فرسان الصّليب الحقيقيّ بأمر عينيك

66
00:05:21,420 --> 00:05:25,090
...فإمّا أنّهم سيحبسون للقيام بالبحوث

67
00:05:25,090 --> 00:05:27,680
.أو سيعدمونك في أسوأ الحالات

68
00:05:28,800 --> 00:05:30,180
.أنت ضعيف

69
00:05:30,890 --> 00:05:34,430
أخي... هل ستواصل التّفكير بعمق هكذا للأبد؟

70
00:05:34,730 --> 00:05:37,060
!ما عدا لديّ وقت للتّفكير بعمق

71
00:05:37,520 --> 00:05:40,150
!لذلك أعطني قوّتك تلك فحسب

72
00:05:42,650 --> 00:05:44,860
هذا ليس ساخنًا! أهو أخي؟

73
00:05:46,110 --> 00:05:48,660
.سأغادر الآن

74
00:05:48,990 --> 00:05:50,320
.لا أريد إجبارك على شيء

75
00:05:51,080 --> 00:05:54,160
.لكنّي أريدك أن تتذكّر شيئًا واحدًا

76
00:05:54,160 --> 00:05:57,580
.أستطيع منحك القوّة

77
00:05:58,540 --> 00:06:03,090
يمكنني على الأرجح تحرير
.قواك وإمكاناتك الخاملة

78
00:06:05,510 --> 00:06:10,550
هل تريد معرفة لغز تلك العيون
والسّرّ خلف ولادتك؟

79
00:06:11,850 --> 00:06:15,560
.هذه هي الحقيقة الّتي ستمنحك القوّة

80
00:06:15,810 --> 00:06:18,060
.أريد إنقاذك

81
00:06:20,270 --> 00:06:21,440
!لا حاجة لذلك

82
00:06:21,770 --> 00:06:23,270
.هكذا إذًا

83
00:06:23,610 --> 00:06:26,440
.لكنّي واثق أنّنا سنلتقي ثانية

84
00:06:30,700 --> 00:06:34,950
.روحك ليست قويّة أيضًا

85
00:06:35,540 --> 00:06:37,710
سينسي؟ سينسي؟

86
00:06:39,790 --> 00:06:42,000
!أشعر بالسّوء حيال هذا بالفعل

87
00:06:42,000 --> 00:06:46,130
لكن لديّ مهمّة لأؤدّيها بصفتي
.جاسوسًا للإيلوميناتي

88
00:06:46,460 --> 00:06:47,800
".لا داعي لذلك"

89
00:06:48,130 --> 00:06:49,510
.أخبره بهذا رجاءً

90
00:06:49,970 --> 00:06:51,260
ماذا؟

91
00:06:51,890 --> 00:06:53,100
.عُلم

92
00:06:53,100 --> 00:06:55,680
لكن لا تعر الأمر أهمّيّة كثيرة، مفهوم؟

93
00:06:55,680 --> 00:06:56,850
!إلى اللّقاء

94
00:06:57,470 --> 00:06:58,480
!شيما-كُن

95
00:06:58,850 --> 00:06:59,640
نعم؟

96
00:07:00,140 --> 00:07:04,730
هل أنت بالفعل إلى جانب
فرسان الصّليب الحقيقيّ؟

97
00:07:04,730 --> 00:07:07,990
!بالطّبع أنا كذلك

98
00:07:08,650 --> 00:07:11,700
.لذلك سأقوم بتحذيرك بما أنّي إلى جانبكم

99
00:07:11,700 --> 00:07:16,370
ألا يجدر بك الحديث عن هذا الأمر
مع شخص ما يا أوكومورا-سينسي؟

100
00:07:18,370 --> 00:07:24,710
،أنا محايد في كلّ الأحوال
.لذلك لا أستطيع سوى تحذيرك

101
00:07:30,300 --> 00:07:32,380
!سُحقًا

102
00:07:51,070 --> 00:07:54,320
من كان يظنّ أنّي سأراك في
هذا الوقت المبكّر من اليوم؟

103
00:07:54,700 --> 00:07:59,450
عليّ أن أحرص أن أكون في كامل
.لياقتي لأؤدّي دوري كجاسوس جيّدًا

104
00:07:59,450 --> 00:08:01,660
ماذا عنك يا بون؟ أليس الوقت باكرًا جدًّا؟

105
00:08:02,040 --> 00:08:04,670
.أنا أركض هكذا كلّ صباح تقريبًا

106
00:08:08,590 --> 00:08:10,920
!بون! شكرًا جزيلاً لك

107
00:08:11,340 --> 00:08:12,840
!لأنّك تثق بي

108
00:08:16,510 --> 00:08:17,720
!لا أهتمّ

109
00:08:17,720 --> 00:08:21,180
،إن كان لديك وقت لشكري
!فعليك شكر الآخرين أيضًا

110
00:08:21,180 --> 00:08:24,190
!افعل ما تشاء فحسب
!لن أتحدّث معك بعد الآن

111
00:08:24,520 --> 00:08:25,440
!بون

112
00:08:25,440 --> 00:08:28,150
!عثرتُ على ما أريد فعله

113
00:08:28,610 --> 00:08:31,490
وجدت عالمًا حيث لا يوجد فيه
!متاعب أو قيود تعرقلني

114
00:08:31,490 --> 00:08:34,070
!مكان يمكنني العيش فيه كما أريد

115
00:08:34,740 --> 00:08:35,530
ماذا؟

116
00:08:35,530 --> 00:08:39,370
،لا أظنّ أنّك قد تفهم الأمر
!لكنّ هذا كلّ شيء بالفعل

117
00:08:39,370 --> 00:08:40,950
!ثق بي رجاءً

118
00:08:40,950 --> 00:08:42,960
هل تتحدّث عن كونك جاسوسًا؟ –
!نعم –

119
00:08:43,330 --> 00:08:44,460
!هذا جنون

120
00:08:44,460 --> 00:08:47,040
!أنا آسف بالفعل

121
00:08:47,040 --> 00:08:49,960
!لكن أعتقد حقًّا أنّي مناسب كجاسوس

122
00:08:56,300 --> 00:08:58,600
إذًا فقد اتّخذت قرارك بنفسك، صحيح؟

123
00:08:58,600 --> 00:08:59,890
!نعم

124
00:08:59,890 --> 00:09:01,350
أتجد هذا ممتعًا؟

125
00:09:01,350 --> 00:09:04,270
!نعم، هذا ممتع للغاية بالنّسبة لي

126
00:09:05,190 --> 00:09:06,560
.فهمت

127
00:09:07,310 --> 00:09:09,150
إذًا فقد وجدته؟

128
00:09:09,150 --> 00:09:10,150
ماذا؟

129
00:09:10,150 --> 00:09:12,480
!لا، أنا أفهم الآن

130
00:09:12,820 --> 00:09:15,740
.لا أثق بك على الإطلاق، لكن حظًّا سعيدًا

131
00:09:17,870 --> 00:09:19,990
.شكرًا جزيلاً

132
00:09:25,960 --> 00:09:27,500
هل ستتمكّن من الانسجام معهم؟

133
00:09:27,500 --> 00:09:29,460
.نعم، بطريقة أو بأخرى

134
00:09:29,460 --> 00:09:30,920
هل أخبرته؟

135
00:09:30,920 --> 00:09:33,170
.نعم. كان مضطربًا جدًّا

136
00:09:33,630 --> 00:09:36,010
هل بدا أنّه قد يكلّم أحدًا بشأن ذلك؟

137
00:09:36,010 --> 00:09:39,180
.لا، على الأرجح أنّه لن يفعل في رأيي

138
00:09:39,510 --> 00:09:40,720
.هذا جيّد

139
00:09:40,720 --> 00:09:42,770
.واصل الضّغط عليه

140
00:09:42,770 --> 00:09:44,430
.عُلم

141
00:09:52,860 --> 00:09:54,030
!أجل

142
00:09:54,030 --> 00:09:55,950
...آسف يا رفاق

143
00:09:55,950 --> 00:09:57,570
...ولكنّي الآن

144
00:09:57,570 --> 00:09:59,950
!أستمتع كثيرًا بوقتي

145
00:10:03,120 --> 00:10:05,870
.لذلك سأقوم بتحذيرك بما أنّي إلى جانبكم

146
00:10:06,330 --> 00:10:11,130
ألا يجدر بك الحديث عن هذا الأمر
مع شخص ما يا أوكومورا-سينسي؟

147
00:10:12,130 --> 00:10:13,590
...هل عليّ

148
00:10:13,590 --> 00:10:15,630
الحديث مع شخص ما؟

149
00:10:16,010 --> 00:10:17,470
.أنت ضعيف

150
00:10:19,220 --> 00:10:20,340
"منتجع الاستجمام الاستوائيّ للغاية"
"تذاكر دعوة"

151
00:10:20,850 --> 00:10:22,010
!سُحقًا

152
00:10:22,350 --> 00:10:27,640
ترك شخص ما مدفئة أقدام ما زالت
.تعمل في كومة القمامة الضّخمة

153
00:10:27,640 --> 00:10:30,860
لا بأس بإحضار شيء كهذا
للمنزل دون إذن، صحيح؟

154
00:10:30,860 --> 00:10:31,520
ماذا؟

155
00:10:31,810 --> 00:10:34,110
.أنا أشعر بالبرد كثيرًا مؤخّرًا

156
00:10:34,110 --> 00:10:36,400
أتذكر كيف أنّ هذه الغرفة تشبه
الجحيم في الصّيف؟

157
00:10:36,400 --> 00:10:38,110
—لنجعلها مريحة في الشّتاء على الأقلّ

158
00:10:38,110 --> 00:10:39,320
.افعل ما يحلو لك

159
00:10:39,320 --> 00:10:40,820
.سأغادر الآن

160
00:10:40,820 --> 00:10:43,660
.سأعود متأخّرًا، لذلك لا تنتظرني على العشاء

161
00:10:47,870 --> 00:10:50,250
لماذا يبدو حسّاسًا جدًّا هكذا؟

162
00:10:50,670 --> 00:10:53,210
.يبدو يوكيو متعبًا دائمًا

163
00:10:53,880 --> 00:10:55,880
"مستشفى الصّليب الحقيقيّ العامّ"

164
00:10:56,210 --> 00:10:58,470
ماذا؟ ستخرجين من المستشفى غدًا؟

165
00:10:58,470 --> 00:11:01,510
.ما دامت لن تُظهر النّتائج أيّ شيء سيّئ اليوم

166
00:11:01,510 --> 00:11:04,260
!إذًا، أنا أهنّئك على هذا

167
00:11:04,260 --> 00:11:05,260
!شكرًا لك

168
00:11:05,640 --> 00:11:09,480
لا بدّ أنّ كونك طارد الأرواح الوحيد في
.تلك المهمّة الأخيرة كان صعبًا عليك أيضًا

169
00:11:09,480 --> 00:11:11,350
.سرّني أنّكم عدتم سالمين

170
00:11:11,350 --> 00:11:12,900
.نعم، صحيح

171
00:11:13,190 --> 00:11:17,820
ومع ذلك، من كان يظنّ
أنّ تاكارا وشيما جاسوسان لميفيستو؟

172
00:11:17,820 --> 00:11:23,820
سيسمح كبار مسؤولي فرسان الصّليب
.الحقيقيّ لشيما-كُن بالعمل كعميل مزدوج

173
00:11:24,200 --> 00:11:28,450
إنّه مصدر معلومات قيّم عن
الإيلوميناتي قبل كلّ شيء، صحيح؟

174
00:11:28,450 --> 00:11:32,120
لكنّنا لا نستطيع حتّى أن نثق
.بالسّيّد فيليس أو شيما-كُن

175
00:11:32,120 --> 00:11:33,960
ألا تجدين هذا خطيرًا؟

176
00:11:33,960 --> 00:11:36,420
لم يثق أيّ أحد بميفيستو من
.الأساس في كلّ الأحوال

177
00:11:36,960 --> 00:11:41,340
وليس هناك شكّ في أنّه لا يمكنك
.أن تتخلّى عن حذرك حول شيما

178
00:11:42,970 --> 00:11:46,310
لو كنت مكانك، لتحدّثت مع
.سوغورو وميوا مرّة أخرى

179
00:11:47,100 --> 00:11:50,060
كان هؤلاء الثّلاثة معًا منذ
ولادتهم، أليس كذلك؟

180
00:11:50,390 --> 00:11:55,110
سيكون من الصّعب خداع
.شخص يُعتبر جزءًا من العائلة

181
00:11:56,270 --> 00:11:58,570
أتظنّين ذلك بالفعل؟

182
00:11:59,530 --> 00:12:01,780
.ما الخطب؟ تبدو شاحبًا

183
00:12:03,070 --> 00:12:04,320
فعلاً؟

184
00:12:04,320 --> 00:12:05,990
.أنا بخير تمامًا

185
00:12:05,990 --> 00:12:07,990
...صحيح. كعربون شكر على عملنا

186
00:12:07,990 --> 00:12:10,080
...أرسل لنا السّيّد فيليس هذه التّذاكر

187
00:12:08,830 --> 00:12:11,710
"منتجع الاستجمام الاستوائيّ للغاية"
"تذاكر دعوة"

188
00:12:10,080 --> 00:12:13,460
إلى منتجع الاستجمام الاستوائيّ
.للغاية في الصّليب الجنوبيّ

189
00:12:13,460 --> 00:12:14,460
فعلاً؟

190
00:12:16,040 --> 00:12:18,630
!لنستمتع بالمنتجع الاستوائيّ

191
00:12:18,630 --> 00:12:20,550
!يبدو هذا جيّدًا! أراهن أنّه سيكون ممتعًا

192
00:12:20,840 --> 00:12:22,010
.سرّني سماع هذا

193
00:12:22,010 --> 00:12:26,300
حسنًا يا شورا-سان، خذي البقيّة
.معك أيضًا بما أنّي لن أذهب

194
00:12:26,300 --> 00:12:28,140
!أيّها الوغد الصّغير

195
00:12:28,140 --> 00:12:31,980
!أنت أكثر من يحتاج لهذا، صحيح؟

196
00:12:31,980 --> 00:12:40,990
"منتجع الاستجمام الاستوائيّ للغاية"

197
00:12:33,890 --> 00:12:35,230
!أعجبني هذا

198
00:12:35,230 --> 00:12:38,150
المنتجع بأكملها لنا نحن وحدنا
!لهذا اليوم! هذا رائع

199
00:12:38,150 --> 00:12:40,990
!يشعرني هذا بالحنين
!اعتدت المجيء إلى هنا وأنا طفل

200
00:12:41,400 --> 00:12:43,110
!هذا المكان ممتع للغاية

201
00:12:43,610 --> 00:12:45,990
أهذا صحيح؟

202
00:12:46,990 --> 00:12:48,330
!هذا مؤلم

203
00:12:48,330 --> 00:12:49,620
!أيّها الجاسوس

204
00:12:49,620 --> 00:12:51,950
!"مهلاً! لا تنادني بـ"الجاسوس

205
00:12:51,950 --> 00:12:53,460
!أنا جاسوس بالفعل

206
00:12:53,830 --> 00:12:56,460
تحدّثتَ مع كونكومارو أيضًا، صحيح؟

207
00:12:56,790 --> 00:12:57,920
...إنّ

208
00:12:58,710 --> 00:13:00,210
...ذلك

209
00:13:00,840 --> 00:13:02,880
.إذًا فقد تحدّثتَ مع بون

210
00:13:02,880 --> 00:13:04,470
.سرّني سماع ذلك

211
00:13:04,840 --> 00:13:07,680
لستَ غاضبًا يا كونكو-سان؟

212
00:13:08,100 --> 00:13:12,470
.تسنّى لي مسحك بمكنسة
.لذلك فهذا كافٍ في نظري

213
00:13:12,770 --> 00:13:16,150
.هذا ما قاله وصار كلّ شيء كما كان

214
00:13:16,350 --> 00:13:19,480
.لذلك ظننتُ أنّه لا حاجة للكلام عن أيّ شيء

215
00:13:21,230 --> 00:13:22,530
.آسف

216
00:13:22,530 --> 00:13:24,740
.أودّ البقاء وحدي الآن

217
00:13:24,740 --> 00:13:26,570
هلاّ تركتني وشأني رجاءً؟

218
00:13:26,570 --> 00:13:27,490
ماذا؟

219
00:13:32,330 --> 00:13:33,290
...عفوًا

220
00:13:34,460 --> 00:13:37,880
لا تمانعين الاستحمام معًا، صحيح؟

221
00:13:37,880 --> 00:13:39,210
ماذا؟

222
00:13:40,880 --> 00:13:44,720
لا أريدك أن ترينني عارية، مفهوم؟

223
00:13:45,010 --> 00:13:47,260
!بالطّبع لا أمانع ذلك

224
00:13:47,260 --> 00:13:49,890
!انسي ما قلتُه من قبل فحسب

225
00:13:49,890 --> 00:13:50,850
!مرحى

226
00:13:50,850 --> 00:13:52,520
!حسنًا، سأسبقكما

227
00:13:52,520 --> 00:13:55,480
!أجل! لم أذهب لمسبح منذ مدّة

228
00:13:56,230 --> 00:13:57,980
!مذهل

229
00:13:59,020 --> 00:14:00,360
!انظري يا كاميكي-سان

230
00:14:00,650 --> 00:14:02,230
!إنّه ضخم للغاية

231
00:14:02,230 --> 00:14:03,780
!لندخل المسبح بسرعة

232
00:14:03,780 --> 00:14:05,950
.يا إلهي، أظنّ أنّ لا خيار آخر لي

233
00:14:05,950 --> 00:14:07,280
!مرحى

234
00:14:14,200 --> 00:14:16,210
ألن تسبحي يا كاميكي-سان؟

235
00:14:16,210 --> 00:14:17,620
.لا أريد

236
00:14:18,330 --> 00:14:21,380
.من المؤسف أنّ نوري-تشان لم تستطع المجيء

237
00:14:21,380 --> 00:14:23,090
.لا يسعنا فعل شيء حيال ذلك

238
00:14:23,090 --> 00:14:25,630
.هذه مكافأة لقاء المعركة الّتي خضناها

239
00:14:26,090 --> 00:14:29,510
.إضافة لذلك، بإمكاننا العودة متى نشاء

240
00:14:30,720 --> 00:14:34,770
.المكان قريب في كلّ الأحوال
.لنعد نحن الثّلاثة معًا لاحقًا

241
00:14:35,220 --> 00:14:37,310
!أجل! لنعد إلى هنا ثانية لاحقًا

242
00:14:39,810 --> 00:14:42,730
!مرحى

243
00:14:47,240 --> 00:14:50,070
!يا رفاق! عليكما تجربة هذا

244
00:14:50,070 --> 00:14:51,530
!هذا ممتع للغاية

245
00:14:51,910 --> 00:14:53,700
.لا أظنّني سأفعل

246
00:14:53,700 --> 00:14:56,410
.قد تقصّر الصّدمة من عمري

247
00:14:56,410 --> 00:14:58,540
.أخي، لم تعد في الابتدائيّة

248
00:14:58,910 --> 00:15:01,500
.كم أنتما مملاّن

249
00:15:03,710 --> 00:15:05,050
!تاكارا-سينباي

250
00:15:05,050 --> 00:15:06,800
هل تبلّل دميتك في الماء أيضًا؟

251
00:15:09,760 --> 00:15:13,470
لو كنت مكانك، لتحدّثت مع
.سوغورو وميوا مرّة أخرى

252
00:15:15,560 --> 00:15:17,100
.عفوًا يا ميوا-كُن

253
00:15:17,470 --> 00:15:18,390
ماذا؟

254
00:15:18,390 --> 00:15:21,850
هل تثق بشيما-كُن بالفعل؟

255
00:15:23,480 --> 00:15:26,360
.آسف على سؤالك فجأة هكذا

256
00:15:26,360 --> 00:15:28,030
.لا عليك

257
00:15:28,610 --> 00:15:30,610
.أنا أثق به بالفعل

258
00:15:31,240 --> 00:15:32,110
على أيّ أساس؟

259
00:15:32,490 --> 00:15:35,370
...على أساس... أنّه

260
00:15:37,240 --> 00:15:39,500
...عندما كنّا نقاتل الملك النّجس

261
00:15:39,910 --> 00:15:43,750
.تركنا شيما-سان وهرب في مرحلة ما

262
00:15:43,750 --> 00:15:44,750
ماذا؟

263
00:15:44,750 --> 00:15:46,250
.قال أنّه لم يرد الموت

264
00:15:46,960 --> 00:15:51,880
لطالما كان شيما-سان كسولاً
.ومحبًّا للمتعة مذ كان طفلاً

265
00:15:51,880 --> 00:15:57,010
،ظننتُ دائمًا أنّه يومًا ما
.سيهرب إلى مكان ما بعيدًا جدًّا

266
00:15:58,020 --> 00:16:03,270
.وفي ذلك اليوم، قلتُ لنفسي أنّه فعلها أخيرًا

267
00:16:04,230 --> 00:16:05,150
...ولكنّه

268
00:16:05,480 --> 00:16:07,020
.عاد

269
00:16:08,610 --> 00:16:11,530
.هذا هو الأساس الّذي بنيتُ عليه ثقتي

270
00:16:11,860 --> 00:16:12,780
.هكذا إذًا

271
00:16:13,410 --> 00:16:14,780
!بون

272
00:16:14,780 --> 00:16:18,080
بما أنّنا في سيرة ذلك الجاسوس، أين هو الآن؟

273
00:16:18,080 --> 00:16:20,000
...بما أنّك ذكرتَ هذا

274
00:16:20,870 --> 00:16:21,540
ماذا؟

275
00:16:21,960 --> 00:16:23,540
!ها هو هناك

276
00:16:27,090 --> 00:16:29,340
ما الّذي تفعله يا شيما-سان؟

277
00:16:29,340 --> 00:16:31,170
!أنا أركّز

278
00:16:31,170 --> 00:16:32,760
!لا تتحدّثوا معي

279
00:16:32,760 --> 00:16:34,300
ما الّذي حلّ بك؟

280
00:16:34,300 --> 00:16:35,510
!إنّك تتصرّف بغرابة

281
00:16:36,390 --> 00:16:37,640
أنا؟

282
00:16:37,640 --> 00:16:39,010
أتصرّف بغرابة؟

283
00:16:39,560 --> 00:16:41,520
!أنتم من يتصرّفون بغرابة

284
00:16:41,850 --> 00:16:44,770
تتصرّفون جميعكم بودّ ومرح
...وتستمتعون بوقتكم في المسبح

285
00:16:44,770 --> 00:16:46,270
!ما بالكم؟ هذا مريب جدًّا

286
00:16:46,690 --> 00:16:47,860
ماذا؟ ما الّذي يحدث؟

287
00:16:47,860 --> 00:16:50,030
!كلّ هذا مزيّف

288
00:16:50,030 --> 00:16:52,240
!أنا صريح لا غير

289
00:16:52,240 --> 00:16:53,320
...ما الّذي

290
00:16:53,320 --> 00:16:54,490
!شيما

291
00:16:54,490 --> 00:16:57,160
هل ما زلت تحمل ضغينة ما؟

292
00:16:57,160 --> 00:16:59,080
!بُح بما لديك فحسب

293
00:16:59,080 --> 00:17:00,910
!حسنًا، سأقول ما لديّ

294
00:17:01,830 --> 00:17:04,040
...في هذا المسبح

295
00:17:04,040 --> 00:17:05,790
...توجد مزلجة مائيّة

296
00:17:06,290 --> 00:17:09,040
!يستطيع الأزواج النّزول فيها على قوارب

297
00:17:09,420 --> 00:17:11,130
أريد النّزول مع إيزومو-تشان
...بملابس السّباحة

298
00:17:11,510 --> 00:17:12,970
...أو مورياما-سان

299
00:17:13,380 --> 00:17:15,680
!أو حتّى كيريغاكوري سينسي على ذلك القارب

300
00:17:16,180 --> 00:17:19,560
إنّ أيّ رجل كان ليرغب
!في ركوبها مهما كلّف الأمر

301
00:17:20,010 --> 00:17:23,770
وفي الوقت الحاليّ، تصعد تلك
!الفتيات الثّلاثة الدّرج للتّزلّج عليها

302
00:17:24,390 --> 00:17:28,610
،حتّى إن ركبت اثنتان منهما على قارب
!ستظلّ واحدة منهنّ وحدها

303
00:17:28,860 --> 00:17:31,610
!وأنا من سيركب خلفها

304
00:17:31,940 --> 00:17:34,700
!وأنا أيضًا! أريد الرّكوب خلف شيمي

305
00:17:35,070 --> 00:17:36,110
...أخي

306
00:17:36,490 --> 00:17:37,570
!صديقي

307
00:17:37,910 --> 00:17:39,910
!كلاّ! أنا لستُ مثلك

308
00:17:40,280 --> 00:17:43,080
!لا أودّ أن تكون أيّ فتاة على عكسك أنت

309
00:17:43,080 --> 00:17:44,540
!يجب أن تكون شيمي دون سواها

310
00:17:44,870 --> 00:17:46,830
ما خطب أوكومورا-كُن؟

311
00:17:46,830 --> 00:17:49,960
كلّ الرّغبات المريبة في ذهنه
!تتسرّب للخارج الآن

312
00:17:49,960 --> 00:17:52,630
.إضافة لشيما، هناك شيء ما ليس في محلّه

313
00:17:52,630 --> 00:17:54,380
هل يُعقل أنّ شيطانًا وراء هذا؟

314
00:17:56,430 --> 00:17:57,800
!سينسي! انظر هناك

315
00:17:58,220 --> 00:18:00,300
!إنّهما القردة الحكيمة الثّلاثة

316
00:18:00,680 --> 00:18:04,270
إنّ القردة الثّلاثة الحكيمة تعلّمنا
ألاّ ننغمس في الأفكار الشّرّيرة، صحيح؟

317
00:18:04,850 --> 00:18:07,270
."لا أرى شرًّا". "لا أتكلّم شرًّا". "لا أسمع شرًّا"

318
00:18:07,690 --> 00:18:13,860
لكنّ هذه الشّياطين ترغم أيّ بشريّ قريب
!بأن يرى ويتكلّم ويسمع الأفكار

319
00:18:13,860 --> 00:18:16,860
!شيمي لي أنا وحدي

320
00:18:20,280 --> 00:18:21,120
!سُحقًا

321
00:18:21,120 --> 00:18:23,410
!لقد وصلنَ لقمّة الدّرج سلفًا

322
00:18:23,410 --> 00:18:25,290
!عليّ الإسراع

323
00:18:25,790 --> 00:18:26,960
!لن أسمح لك

324
00:18:26,960 --> 00:18:28,830
!ركلة الشّيطان

325
00:18:30,130 --> 00:18:31,880
ما الّذي تفعله؟

326
00:18:32,840 --> 00:18:33,880
ماذا يحدث؟

327
00:18:34,340 --> 00:18:35,880
!لا تعترض طريقي

328
00:18:36,170 --> 00:18:38,430
!سيدمّران المكان على هذا الحال

329
00:18:38,430 --> 00:18:39,590
!سأذهب لإحضار أسلحة

330
00:18:39,590 --> 00:18:40,300
!سينسي

331
00:18:40,760 --> 00:18:44,350
لا يجب أن أسمح لها أن تتلبّسني
!وأبوح بكلّ أسراري

332
00:18:44,350 --> 00:18:45,310
!مهما كلّف الأمر

333
00:18:46,810 --> 00:18:51,310
.لا ترى ولا تسمع ولا تقل ما لا يليق

334
00:18:51,650 --> 00:18:55,320
السّيطرة على النّفس واستعادة
!الاحترام هو الغاية المنشودة

335
00:19:03,530 --> 00:19:04,490
ماذا؟

336
00:19:04,490 --> 00:19:05,950
أنا... ماذا؟

337
00:19:06,370 --> 00:19:09,210
...ماذا؟ ما الّذي

338
00:19:10,920 --> 00:19:13,210
...إنّها مجرّد تعويذة

339
00:19:13,210 --> 00:19:15,300
.لكن من الجيّد أنّي تذكّرتها فجأة

340
00:19:15,300 --> 00:19:17,090
!بون! هذا هو المتوقّع منك

341
00:19:17,090 --> 00:19:19,470
!أنقذتنا يا سوغورو-كُن

342
00:19:31,150 --> 00:19:33,650
...التهم الأميرات الثّمانية

343
00:19:40,740 --> 00:19:42,740
"العنوان: فرسان الصّليب الحقيقيّ"
"الاسم: أوكومورا يوكيو"

344
00:19:41,740 --> 00:19:42,740
.نحن آسفون

345
00:19:43,240 --> 00:19:45,990
أرسلوا فاتورة الإصلاحات
.إلى فرسان الصّليب الحقيقيّ رجاءً

346
00:19:46,410 --> 00:19:49,660
.أريد أن أختفي
.ليتني أستطيع التّحوّل لحلوى قطنيّة

347
00:19:49,660 --> 00:19:53,670
.لا نهتمّ أبدًا إن سمعنا أفكارك الدّفينة

348
00:19:54,000 --> 00:19:58,840
إضافة لذلك، أنا مرتاح نوعًا ما
.لأنّ شهواته الدّنيويّة ما زال كما هي

349
00:20:01,130 --> 00:20:02,720
...بون... أنا

350
00:20:03,260 --> 00:20:09,230
.لديّ شعور بأنّه لا خداع فيما يقوله شيما-سان

351
00:20:11,520 --> 00:20:12,980
أتظنّ ذلك؟

352
00:20:23,530 --> 00:20:24,490
!تفضّل

353
00:20:24,490 --> 00:20:28,240
"الصّليب الجنوبيّ"

354
00:20:25,240 --> 00:20:28,240
يعيد تواجدنا في الصّليب الجنوبيّ
ذكريات قديمة، صحيح؟

355
00:20:31,120 --> 00:20:34,710
.آسف لأنّ شيطانًا تلبّسني

356
00:20:34,710 --> 00:20:36,710
.رغم أنّني شيطان أيضًا

357
00:20:36,710 --> 00:20:38,460
ألأننّي نصف شيطان؟

358
00:20:41,050 --> 00:20:43,930
هناك ما يشغل بالك منذ مدّة، صحيح؟

359
00:20:45,470 --> 00:20:49,680
سيكون من الصّعب خداع
.شخص يُعتبر جزءًا من العائلة

360
00:20:50,180 --> 00:20:53,520
،لا فكرة لديّ ما الّذي يحدث
ولكن لماذا لا تتكلّم مع أخيك الكبير؟

361
00:20:54,100 --> 00:20:55,770
!سأساعدك

362
00:20:56,440 --> 00:20:57,690
...هل فعلاً

363
00:20:58,820 --> 00:21:01,780
أبدو ضعيفًا لذلك الحدّ؟

364
00:21:03,860 --> 00:21:05,160
...إنّني فقط

365
00:21:05,910 --> 00:21:07,160
.متعب قليلاً

366
00:21:07,160 --> 00:21:08,410
.لا داعي للقلق

367
00:21:08,990 --> 00:21:10,160
فعلاً؟

368
00:21:10,160 --> 00:21:11,040
.نعم

369
00:21:12,120 --> 00:21:13,910
!شكرًا على المثلّجات

370
00:21:25,970 --> 00:21:30,760
لا أصدّق أنّي ظننتُ أنّ القدوم
...إلى هنا سيُريحه قليلاً

371
00:21:35,600 --> 00:21:37,690
...والآن

372
00:23:11,370 --> 00:23:12,740
...يوكيو

373
00:23:12,740 --> 00:23:14,870
...بدل العيش في خوف من الظّلام

374
00:23:15,120 --> 00:23:17,870
.عليك أن تصير أقوى وتساعد النّاس وأخيك

