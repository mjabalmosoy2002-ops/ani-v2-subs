1
00:00:02,550 --> 00:00:06,710
أوّل مرّة شعرتُ بهذا كان قبل نحوِ عقد

2
00:00:07,590 --> 00:00:10,960
في ذلك الوقت، كانت هنالك مشكلة بقربي

3
00:00:10,960 --> 00:00:14,260
لذا حللتها بأسرع طريقة

4
00:00:14,260 --> 00:00:16,490
فإذا بالأمر يحدث لي فجأةً

5
00:00:16,940 --> 00:00:19,440
"ماذا؟ هذا مألوف"

6
00:00:19,440 --> 00:00:22,630
"لقد فعلتُ هذا قبلًا"

7
00:00:23,260 --> 00:00:24,500
إحساس تكرار المشهد

8
00:00:25,210 --> 00:00:29,460
،عندما تقوم بشيءٍ ما لأوّل مرّة
لكن تشعر أنّه شيءٌ مألوف

9
00:00:29,460 --> 00:00:32,970
بعدئذٍ، لم يغادرني ذلك الشعور للحظة

10
00:00:33,670 --> 00:00:37,310
بإمكاني التعبير عن هذا الشعور بكلمةٍ واحدة، بغيض

11
00:00:38,030 --> 00:00:42,100
،لا أستطيع رؤية المستقبل
لذا لا فائدة من هذا الأمر

12
00:00:42,100 --> 00:00:44,700
!إنّما يجعل كلّ شيءٍ سيّئًا

13
00:00:44,700 --> 00:00:46,150
هذا مملّ جدًّا

14
00:00:46,150 --> 00:00:47,660
أريد معرفة المجهول

15
00:00:47,660 --> 00:00:51,910
لذا أريد أن أقوم بأشياء مجنونة مع
أشخاص مجانين حتّى تحدث أشياء مجنونة

16
00:00:51,910 --> 00:00:54,100
وأدمّر تكرار المشهد هذا

17
00:00:55,210 --> 00:00:58,020
إن استطعتُ فعل ذلك فلا أهتمّ إن متّ

18
00:00:58,020 --> 00:01:01,870
لا، بل إنّها الطريقة الوحيدة التي تشعرني بالحياة

19
00:01:02,750 --> 00:01:03,960
...لكن

20
00:01:03,960 --> 00:01:06,550
من هنا يصبح الأمر غريبًا

21
00:01:06,590 --> 00:01:08,570
،عندما أشعر بتكرار المشهد هذا

22
00:01:08,570 --> 00:01:12,170
أيّما أفعل، لا أموت لسببٍ ما

23
00:01:13,090 --> 00:01:15,800
شخصٌ جذّابٌ عابرٌ قد أتى

24
00:01:17,900 --> 00:01:19,260
مضحك، صحيح؟

25
00:01:19,260 --> 00:01:22,140
كبطلٍ خياليّ ذي مستوى رديء لا يخسر أبدًا

26
00:01:22,740 --> 00:01:24,860
أنا دمية الإله

27
00:02:56,530 --> 00:02:57,530
!شيرو

28
00:02:59,030 --> 00:03:01,070
!أيها الغبي

29
00:03:01,070 --> 00:03:03,690
!أخبرتك ألّا تتدخّل في هذا

30
00:03:03,690 --> 00:03:05,280
اخرس

31
00:03:05,280 --> 00:03:08,910
كلامك لا يعنيني

32
00:03:08,910 --> 00:03:11,380
أنا نجمُ حياتي الخاصّة

33
00:03:11,890 --> 00:03:14,500
لا تتدخّل أنت في هذا

34
00:03:17,270 --> 00:03:21,670
عمّاذا تتحدّث؟

35
00:03:22,380 --> 00:03:27,100
...لا تأتِ فجأةً وتثرثر أيها الوغد

36
00:03:31,140 --> 00:03:32,270
أرأيت؟ تكرارٌ للمشهد

37
00:03:32,640 --> 00:03:34,750
فعلتَ هذا من قبل

38
00:03:36,050 --> 00:03:38,530
والأمر سيان معي

39
00:03:38,530 --> 00:03:42,240
تبًّا. حاول بجدٍّ أكبر

40
00:03:42,240 --> 00:03:44,030
وإلّا لن يتوقّف تكرار المشهد

41
00:03:45,170 --> 00:03:47,530
...ما أنت

42
00:03:50,820 --> 00:03:53,910
ليون، لقد غيّرتُ رأيي

43
00:03:53,910 --> 00:03:55,750
تكفّلي أنت بذاك الفتى

44
00:03:57,100 --> 00:03:57,880
مفهوم

45
00:03:58,410 --> 00:04:01,260
يبدو أنّهما قد أجمعا على خطّة

46
00:04:01,260 --> 00:04:02,840
...لذا يا رين

47
00:04:03,410 --> 00:04:04,770
لا تنظر هكذا

48
00:04:04,770 --> 00:04:06,130
رأيتَ ما حدث للتو، صحيح؟

49
00:04:06,130 --> 00:04:08,600
لستُ فاشلًا إلى ذلك الحد

50
00:04:09,080 --> 00:04:10,910
هكذا يبدو

51
00:04:10,910 --> 00:04:12,350
...لكن لا تنسَ

52
00:04:12,770 --> 00:04:15,230
أرفض أن أساعدك على الانتحار

53
00:04:15,790 --> 00:04:17,690
!لا تمت أيها الأحمق

54
00:04:34,390 --> 00:04:36,850
أنت سريع بالنّسبة لإنسانٍ عاديّ

55
00:04:36,850 --> 00:04:39,380
وكذا طريقة تحركك... أنت معتادٌ على هذا

56
00:04:39,880 --> 00:04:41,560
لكن أهذا كلّ شيء؟

57
00:04:57,650 --> 00:05:00,370
تفاديتها؟

58
00:05:00,370 --> 00:05:02,530
لقد كنتُ جادًّا إلى حدٍّ ما

59
00:05:04,220 --> 00:05:05,390
حسنًا

60
00:05:05,390 --> 00:05:08,110
بالكاد تنجح على ما أظن

61
00:05:08,110 --> 00:05:09,450
أخبرني باسمك يا فتى

62
00:05:10,540 --> 00:05:12,620
يوسا شيرو

63
00:05:12,620 --> 00:05:14,030
يمكنك أن تنساه إن أردت

64
00:05:14,030 --> 00:05:17,960
ستموتُ قريبًا على أيّ حال

65
00:05:26,570 --> 00:05:28,230
آسف

66
00:05:28,230 --> 00:05:30,480
لكنّي لن أموت اللّيلة

67
00:05:30,480 --> 00:05:34,430
لن يدعوني أموت

68
00:05:37,530 --> 00:05:39,770
!افتخر يا فتى

69
00:05:39,770 --> 00:05:45,810
مضت 40 سنة منذ استخدمتُ
هذه في قتالٍ مباشرٍ ضدّ إنسانٍ عاديّ

70
00:05:45,810 --> 00:05:48,240
لا يمكنني التراجع في هذه المرحلة

71
00:05:48,240 --> 00:05:52,200
لأنّها تبدأ بالصّراخ وتطالبني
!بأن أدعها تشرب الدّماء

72
00:06:04,390 --> 00:06:05,840
أذلك مؤلم؟

73
00:06:05,840 --> 00:06:07,170
أراهن أنّه كذلك

74
00:06:07,530 --> 00:06:09,670
!ابكِ فرحًا

75
00:06:17,270 --> 00:06:19,250
!لن أدعك تهرب

76
00:06:26,460 --> 00:06:27,730
سأسألك مرّةً أخرى

77
00:06:27,730 --> 00:06:29,670
ألستَ مهتمًّا بالمجيء معي؟

78
00:06:29,670 --> 00:06:31,070
!بالطّبع لا

79
00:06:38,230 --> 00:06:39,500
مذهل

80
00:06:39,840 --> 00:06:42,330
كيف تستطيع التفاعل هكذا؟

81
00:06:42,330 --> 00:06:44,460
لستَ عاديًّا حقًّا

82
00:06:44,930 --> 00:06:46,730
وكذلك هو

83
00:06:46,730 --> 00:06:47,800
أنتما صديقان، صحيح؟

84
00:06:49,150 --> 00:06:51,000
كلاكما غريبا الأطوار

85
00:06:51,420 --> 00:06:53,570
لستما إنسانين عاديين بالتأكيد

86
00:06:53,570 --> 00:06:54,430
...لا أتوقّع أقلّ من هذا من

87
00:06:57,190 --> 00:06:58,470
ممّاذا؟

88
00:06:58,470 --> 00:07:01,160
دمى ساحرٍ مجنون؟

89
00:07:02,010 --> 00:07:03,490
لا تعبثي معي

90
00:07:03,490 --> 00:07:06,780
!أنتم غرباء الأطوار

91
00:07:26,050 --> 00:07:30,420
أشعرُ أنّي بدون جدوى عندما أنظر إليك

92
00:07:32,020 --> 00:07:34,760
،لأصل إلى مستواك الحاليّ

93
00:07:34,760 --> 00:07:38,690
لا تدري كم استغرقني من
عام وكم من شخصٍ قتلت

94
00:07:41,460 --> 00:07:44,450
تستطيع أن تُصرّح بفخرٍ أنّك لا تحبّ القتال

95
00:07:44,450 --> 00:07:46,780
وأن تبقي من عزيز عليك إلى جانبك

96
00:07:46,780 --> 00:07:48,980
أن تُحِبَّ وتُحَبّ. أنت ولدٌ سعيد

97
00:07:49,690 --> 00:07:54,150
لا بدّ أنّ استنكارك لأمثالي يُشعركَ كبطل

98
00:07:55,540 --> 00:07:56,860
أشعر بالغيرة

99
00:07:56,860 --> 00:07:58,080
لدرجةٍ لا أستطيع مسامحتك

100
00:08:05,920 --> 00:08:07,680
!تشكيل

101
00:08:54,470 --> 00:08:55,900
ما الخطب؟

102
00:08:55,900 --> 00:08:58,180
لا تستطيع أن تهرب الآن

103
00:09:25,550 --> 00:09:28,540
ما زلتِ ساذجة للغاية يا ليونهارت

104
00:09:28,540 --> 00:09:31,760
لا يمكنك الاستهانة بإنسانٍ يائس

105
00:09:31,760 --> 00:09:35,760
لو أنّك تذكّرتِ ذلك لأمكنكِ التعامل مع هذا

106
00:09:36,300 --> 00:09:38,640
لا يهم. جيّد جدًّا

107
00:09:39,900 --> 00:09:41,370
مستحيل

108
00:09:41,370 --> 00:09:44,520
!لا... لا، هذا غير معقول

109
00:09:45,420 --> 00:09:48,550
دعني أقدّم لكَ نفسي مرّةً أخرى

110
00:09:48,550 --> 00:09:50,480
أنا كاهن الكأس

111
00:09:50,860 --> 00:09:54,510
ثالث رهبان لونغينوس الطاولة
المستديرة السّوداء الثلاثة عشر

112
00:09:54,510 --> 00:09:57,450
فاليريا تريفا كريستوف لوهينغرين

113
00:09:58,490 --> 00:10:01,760
الشخص الذي استلم اللعنة
لكونهِ رجل مقدّس شرّير

114
00:10:01,760 --> 00:10:06,410
من طرف الشخص الذي ربّما يُدعى أباك

115
00:10:10,050 --> 00:10:11,110
أجل

116
00:10:11,110 --> 00:10:12,380
سيشتبكان قريبًا

117
00:10:12,380 --> 00:10:14,240
تماسك حتّى حينها

118
00:10:14,240 --> 00:10:15,510
أجل، اتّجه يسارًا الآن

119
00:10:16,100 --> 00:10:17,430
عُلم

120
00:10:44,580 --> 00:10:46,410
تكرار للمشهد. تكرار للمشهد

121
00:10:46,410 --> 00:10:48,020
لا أحتمل هذا

122
00:10:48,020 --> 00:10:50,330
كلّ هذا الهراء ولم يحدث شيء؟

123
00:10:50,710 --> 00:10:52,970
من أنت؟

124
00:10:52,970 --> 00:10:56,050
لا يمكن أن أخطئ بسببِ الحظّ فحسب

125
00:10:56,830 --> 00:10:57,980
من يدري؟

126
00:10:57,980 --> 00:11:00,130
ربّما أنت سيّئ فحسب؟

127
00:11:02,140 --> 00:11:03,260
لا فائدة

128
00:11:03,260 --> 00:11:06,100
لا تستطيع قتلي الآن

129
00:11:06,100 --> 00:11:09,230
!فلتعمل بجدّ أكبر إن لم يعجبك هذا

130
00:11:12,850 --> 00:11:14,480
!أيها الشقيّ

131
00:11:14,480 --> 00:11:15,940
!شيرو، الآن

132
00:11:46,850 --> 00:11:48,350
!فلتنكسر

133
00:12:13,790 --> 00:12:15,130
...هذا

134
00:12:16,190 --> 00:12:17,710
فهمت

135
00:12:17,710 --> 00:12:19,090
هذا جنون

136
00:12:21,630 --> 00:12:25,060
أراهن أنّ ليون ستموت... من الخوف

137
00:12:26,800 --> 00:12:30,910
بما أنّك هدأتَ أخيرًا

138
00:12:30,910 --> 00:12:33,940
أعتقد أنّ ليونهارت أخبرتك

139
00:12:35,650 --> 00:12:38,940
...لكن، أردتُ أن أتحدّث إليك

140
00:12:38,940 --> 00:12:44,120
عن جارتنا المشتركة لا غير

141
00:12:45,740 --> 00:12:49,070
هل تحبّ تريجيا؟

142
00:12:50,790 --> 00:12:54,350
ينتابني فضولٌ شديد

143
00:12:54,350 --> 00:13:00,030
هل أنت مستعدٌّ لقتلِ تريجيا إن اقتضى الأمر؟

144
00:13:02,260 --> 00:13:05,470
هذا ما يعنيه أن تقاتلنا

145
00:13:06,580 --> 00:13:07,970
...أنا

146
00:13:08,460 --> 00:13:10,520
ما زلتُ لا أعلم أيّ شيء

147
00:13:10,560 --> 00:13:13,350
...ممّا تتحدّثون، لكن

148
00:13:14,640 --> 00:13:17,350
!لا تعاملوها وكأنّها واحدة منكم

149
00:13:17,860 --> 00:13:19,020
...بعبارةٍ أخرى

150
00:13:19,940 --> 00:13:22,730
ما الذي تحاول قوله يا فوجي-سان؟

151
00:13:22,730 --> 00:13:24,690
وماذا غير هذا؟

152
00:13:24,690 --> 00:13:26,290
لن أدعها تموت

153
00:13:26,290 --> 00:13:27,450
ولن أدعك تقتلها

154
00:13:27,450 --> 00:13:31,660
!سأهزمك وأنهي هذا، بالطبع

155
00:13:38,020 --> 00:13:39,940
فهمت! ستفعل إذًا؟

156
00:13:39,940 --> 00:13:41,670
ماذا عن هذا؟

157
00:13:41,670 --> 00:13:44,260
!كم هذا مثير للشفقة

158
00:13:44,260 --> 00:13:47,650
لن تخسر وستفوز؟

159
00:13:47,650 --> 00:13:50,340
ضدّي أنا؟ ضدّنا؟

160
00:13:50,340 --> 00:13:51,600
!أنت؟

161
00:13:52,090 --> 00:13:55,280
ستؤمن بالحبّ وتهزمنا؟

162
00:13:55,280 --> 00:13:57,510
!يا لقلبك النقيّ

163
00:13:57,510 --> 00:14:04,230
إذًا... هل سمعتَ كلامه يا سيّد هايدريخ؟

164
00:14:20,090 --> 00:14:21,710
لستَ سيّئًا

165
00:14:22,170 --> 00:14:24,870
أبليتَ جيّدًا بقولك أنّك لن تخسر أمامي

166
00:14:26,090 --> 00:14:29,200
روحك جديرة بأن تكون عدّوًا

167
00:14:38,410 --> 00:14:39,940
سأخبرك باسمي

168
00:14:39,940 --> 00:14:42,080
أنا راينهارد

169
00:14:42,660 --> 00:14:47,940
لقد أنعم عليّ قريبك بلقب مفستوفيليس

170
00:14:47,940 --> 00:14:50,740
تستطيع القول أنّني رجلٌ كالشيطان

171
00:15:07,450 --> 00:15:08,430
...رين

172
00:15:10,140 --> 00:15:11,750
لا أفهم

173
00:15:11,750 --> 00:15:13,280
من هذا؟

174
00:15:13,740 --> 00:15:15,970
...إنّه حقًّا... حقًّا

175
00:15:15,970 --> 00:15:19,430
ماذا يدعى هذا الشعور؟

176
00:15:23,060 --> 00:15:24,780
...الخوف

177
00:15:25,540 --> 00:15:27,110
الخوف؟

178
00:15:27,910 --> 00:15:31,200
إنّه مريع

179
00:15:32,220 --> 00:15:33,690
هذا صحيح

180
00:15:33,690 --> 00:15:36,400
بالتّأكيد يجب أن

181
00:15:37,120 --> 00:15:39,480
!يُهزمَ هنا

182
00:15:59,460 --> 00:16:00,560
فليكن

183
00:16:01,030 --> 00:16:02,100
هلمّ إليّ

184
00:16:42,790 --> 00:16:43,800
...سيّدي

185
00:16:44,590 --> 00:16:47,770
راقبي يا ليونهارت

186
00:16:47,770 --> 00:16:50,030
هذا هو السيّد هايدريخ

187
00:16:52,460 --> 00:16:54,450
سيّدنا

188
00:16:54,450 --> 00:16:57,740
ووحشٌ حقيقيّ

189
00:16:59,490 --> 00:17:01,410
يا لها من روح

190
00:17:01,410 --> 00:17:03,840
...أكلّ أولئك

191
00:17:03,840 --> 00:17:04,790
أجل

192
00:17:04,790 --> 00:17:08,460
عدد جيشه يُقدّر بالملايين

193
00:17:09,550 --> 00:17:13,140
جيشٌ من المحاربين شُكِّلَ
،من أموات الحرب العظمى

194
00:17:13,590 --> 00:17:15,960
محاربو فالهالا

195
00:17:17,060 --> 00:17:21,140
كما أنّه لم يُفتح سوى صليبين معقوفين الآن

196
00:17:21,870 --> 00:17:25,880
لا داعي لقول ما يعنيه هذا

197
00:17:26,780 --> 00:17:31,140
بعبارة أخرى، إنه ليس جادًّا ولو قليلًا بعد

198
00:17:31,140 --> 00:17:32,430
بالفعل

199
00:17:32,430 --> 00:17:35,030
حاليًّا، إنه ليس سوى ظلّ

200
00:17:36,490 --> 00:17:39,130
لا أحد يعلم كيف يكون في وضعه الجاد

201
00:17:39,130 --> 00:17:41,000
ولا أريد أن أعلم

202
00:17:41,740 --> 00:17:44,000
إنّما أعلم شيئًا واحدًا

203
00:17:44,620 --> 00:17:47,320
لقد خُلِقَ في العالم الخاطئ

204
00:17:47,930 --> 00:17:52,000
وجوده بحدّ ذاته يُدمّر كلّ شيء

205
00:17:58,650 --> 00:18:00,730
ما الخطب؟

206
00:18:00,730 --> 00:18:03,910
لا يعقل أنّ الأمر قد انتهى

207
00:18:05,030 --> 00:18:08,840
ارقص بشكلٍ جميلٍ لأجلي
يا ابنَ كارل غير الشرعيّ

208
00:18:08,840 --> 00:18:11,110
ذلك كان الوعد

209
00:18:24,870 --> 00:18:26,410
!تنحّوا

210
00:19:42,210 --> 00:19:43,180
ثلاثة

211
00:19:43,630 --> 00:19:44,600
اثنان

212
00:19:45,150 --> 00:19:46,580
واحد

213
00:19:46,580 --> 00:19:47,870
إطلاق

214
00:20:12,540 --> 00:20:16,150
!خذ هذه

215
00:20:16,940 --> 00:20:19,610
لن تستطيع هزيمتي إن كنتَ خائفًا

216
00:20:29,230 --> 00:20:32,100
حبّك للحرب ناقص

217
00:20:32,900 --> 00:20:35,250
بالتّالي، سوف أعلّمك

218
00:20:36,150 --> 00:20:38,920
أحبّ كلّ شيء

219
00:20:39,350 --> 00:20:42,260
بمُساواة، مهما كان

220
00:20:42,890 --> 00:20:46,080
حبّي هو التدمير

221
00:20:46,080 --> 00:20:48,220
أدمّر كلّ شيء

222
00:20:48,620 --> 00:20:52,020
كلّ شيءٍ في الكون

223
00:20:54,270 --> 00:20:57,510
،حتّى أجد شيئًا لم أدمّره

224
00:20:58,010 --> 00:21:01,150
...إلى أن أتغلّب على تكرار المشهد هذا

225
00:21:02,030 --> 00:21:04,780
أنا في انتظار دييس إيري

226
00:21:11,870 --> 00:21:12,700
رين...

227
00:21:13,390 --> 00:21:14,630
!رين

228
00:21:25,550 --> 00:21:29,520
!ماري! ماري

229
00:23:35,050 --> 00:23:41,250
رسم:      أوغيبوتي