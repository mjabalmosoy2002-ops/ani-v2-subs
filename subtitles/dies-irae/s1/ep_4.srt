1
00:00:10,790 --> 00:00:11,740
!رين

2
00:00:11,740 --> 00:00:14,360
—يجب أن أتحدّث إليك

3
00:00:18,220 --> 00:00:19,890
ما الخطب يا أياسي-سان؟

4
00:00:20,550 --> 00:00:21,980
...ريا-سينباي

5
00:00:21,980 --> 00:00:24,120
هل رأيت رين؟

6
00:00:24,120 --> 00:00:25,100
لا

7
00:00:25,670 --> 00:00:27,080
لماذا؟

8
00:00:27,080 --> 00:00:31,210
...أشعر وكأنّه يتحاشاني

9
00:00:31,690 --> 00:00:34,490
لقد غادر هذا الصّباح دون أن يتحدّث معي

10
00:00:34,490 --> 00:00:35,930
هل تشاجرتما؟

11
00:00:36,260 --> 00:00:37,600
هل تستطيعين إيجاد سببٍ معيّن؟

12
00:00:37,980 --> 00:00:40,680
في الواقع، لا أجد سببًا

13
00:00:41,010 --> 00:00:44,140
لقد كانت ذكرياتي مشوّشة مؤخرًا

14
00:00:44,140 --> 00:00:45,470
ماذا؟

15
00:00:45,900 --> 00:00:47,310
هذا غير منطقيّ

16
00:00:47,310 --> 00:00:50,250
،وهذا ما أردت الحديث معه بشأنه

17
00:00:50,250 --> 00:00:52,500
!لكنّي لا أجده

18
00:00:52,500 --> 00:00:53,790
!بئسًا

19
00:00:53,790 --> 00:00:57,700
!أين ذهبت يا رين؟

20
00:01:09,460 --> 00:01:11,130
يبدو وكأنّك تعاني

21
00:01:12,820 --> 00:01:15,190
هل تتحاشى أياسي-سان؟

22
00:01:15,190 --> 00:01:16,630
فعلتَ الصواب

23
00:01:16,630 --> 00:01:18,260
أنت خطيرٌ الآن

24
00:01:18,990 --> 00:01:20,100
...اخرسي

25
00:01:20,100 --> 00:01:22,350
إن كنتِ لا تحتاجين شيئًا فلتغادري

26
00:01:22,740 --> 00:01:23,430
...وإلّا

27
00:01:24,810 --> 00:01:27,020
وإلّا ماذا؟

28
00:01:29,810 --> 00:01:31,100
تقتلني؟

29
00:01:31,570 --> 00:01:33,280
لكنّك لا تستطيع فعل ذلك بعد

30
00:01:33,730 --> 00:01:36,250
لا تستطيع حتّى هزيمتي الآن، أليس كذلك؟

31
00:01:38,740 --> 00:01:39,820
،إن أردتَ المحاولة

32
00:01:39,820 --> 00:01:41,770
تعال إلى هنا مجدّدًا اللّيلة

33
00:01:41,770 --> 00:01:44,250
وسأعلمك كلّ الأمور

34
00:01:44,650 --> 00:01:46,350
بشأن كيفية استخدام هذه

35
00:03:17,790 --> 00:03:20,900
...وهكذا جرى الأمر

36
00:03:20,900 --> 00:03:23,140
المسرح جاهزٌ أخيرًا

37
00:03:23,140 --> 00:03:25,930
لكنّ ذلك كلّ ما جرى في الواقع

38
00:03:25,930 --> 00:03:29,100
أعتقد أنّ ما زال هنالك ما يستدعي قلقنا

39
00:03:29,100 --> 00:03:30,340
...على وجه الخصوص

40
00:03:30,340 --> 00:03:34,190
الحرب التي يسعى السيّد هايدريخ
لشنّها لا يجب أن تكون فاترة

41
00:03:34,190 --> 00:03:36,400
هذا ما تصبو لقوله، صحيح؟

42
00:03:36,400 --> 00:03:39,820
موت الكائنات الدونية لن تأخذنا إلى فالهالا

43
00:03:36,400 --> 00:03:42,000
فالهالا: أو قاعة ولائم هي القاعة الموجودة في العالم الآخر التي يذهب إليها من مات
في المعارك ويعيشون فيها بسعادة بضيافة أودين، كبير الآلهة

44
00:03:39,820 --> 00:03:44,610
،يجب أن يكون العدوّ قويًّا
رمزًا لمجدنا

45
00:03:44,610 --> 00:03:45,350
أجل

46
00:03:45,350 --> 00:03:47,410
لذا دعونا نأخذ خطوة إضافية أخيرة

47
00:03:47,410 --> 00:03:50,160
في سبيل السيّد هايدريخ

48
00:03:50,540 --> 00:03:53,290
،كممثّلٍ لسيّدنا

49
00:03:53,890 --> 00:03:56,250
...آمركم جميعًا

50
00:03:56,670 --> 00:04:00,050
تتطلّب الحرب أحيانًا تقوية العدوّ

51
00:04:02,290 --> 00:04:04,130
هذا هو الوضع

52
00:04:04,700 --> 00:04:08,100
لقد أُمرتُ بأنْ أجعلك مفيدًا أكثر

53
00:04:08,100 --> 00:04:10,380
،عارض البعض ذلك

54
00:04:10,380 --> 00:04:12,100
لكنّي لم أفعل

55
00:04:12,100 --> 00:04:14,530
لذا فقد وكّلتُ بالمهمّة

56
00:04:14,530 --> 00:04:17,390
،كما أنّنا بنفس العمر

57
00:04:17,390 --> 00:04:20,480
ممّا يعني أنّني قد أكون الأرحمَ إليك

58
00:04:21,290 --> 00:04:22,440
ماذا؟

59
00:04:23,650 --> 00:04:27,200
لستُ كبيرةً كالبقية

60
00:04:27,200 --> 00:04:30,760
أظنّ أنّنا سنجد بيننا العديد من النقاط المشتركة

61
00:04:30,760 --> 00:04:32,460
...إليكِ عنّي

62
00:04:32,460 --> 00:04:34,580
ألم تقولي أنّكم تسعون خلف الحرب؟

63
00:04:34,890 --> 00:04:38,140
أجل، لكنّ الأمور على هذا الحال الآن

64
00:04:38,140 --> 00:04:40,020
لا تكن عصبيًّا معي

65
00:04:40,020 --> 00:04:41,590
،إن أردتَ أن تقاتل قريبًا

66
00:04:41,590 --> 00:04:43,120
أصبح أقوى

67
00:04:43,120 --> 00:04:43,800
مفهوم؟

68
00:04:46,110 --> 00:04:49,670
أوّلًا، فلنبدأ بالأساسيات

69
00:04:49,670 --> 00:04:51,390
من نحن؟

70
00:04:51,710 --> 00:04:53,090
...قلتُ هذا قبلًا

71
00:04:53,090 --> 00:04:55,750
بدأ كلّ شيءٍ مع ساحرٍ واحد

72
00:04:56,790 --> 00:04:59,310
كارل كرافت. ميركيريوس

73
00:05:00,490 --> 00:05:02,280
،أثناء الحرب العالمية الثانية

74
00:05:02,280 --> 00:05:05,990
،اكتسب كلٌّ من الجنود والمجرمين القوّة بمساعدته

75
00:05:06,420 --> 00:05:09,390
ومجموعهم ثلاثة عشر بمن فيهم هو

76
00:05:11,410 --> 00:05:14,270
رهبان لونغينوس الطاولة السوداء الثلاثة عشر

77
00:05:14,820 --> 00:05:16,730
هم نحن

78
00:05:18,590 --> 00:05:21,780
،لكنّ العديد منّا ماتوا أو رحلوا

79
00:05:21,780 --> 00:05:24,180
لذا تمّ استبدال البعض بينما البعض
الآخر غير موجودين ببساطة

80
00:05:27,390 --> 00:05:33,100
لقد ماتت الخامس، لذا أخذتُ مكانها قبل نحو قرن

81
00:05:34,140 --> 00:05:38,340
ومثل البقية، لديّ أمنية أرغب بتحقيقها

82
00:05:38,340 --> 00:05:40,310
هل أخبرك أيّ أحدٍ بشأن ذلك؟

83
00:05:40,310 --> 00:05:43,190
أجل، لكن ليس بالتفصيل

84
00:05:43,500 --> 00:05:45,610
إذًا، لن أخبرك أيضًا

85
00:05:45,610 --> 00:05:47,200
الأمر سريّ

86
00:05:48,660 --> 00:05:53,160
لكن بوسعي أن أخبرك أنّنا
مجموعة من الفاشلين في الأساس

87
00:05:53,710 --> 00:05:55,810
،لقد كنّا مجموعة غريبة أساسًا

88
00:05:55,810 --> 00:06:00,080
لذا إن أردنا تحقيق رغبتنا
فعلينا فعل ذلك بطريقةٍ غريبة

89
00:06:00,080 --> 00:06:02,010
وهي الحرب؟

90
00:06:02,010 --> 00:06:02,740
أجل

91
00:06:02,740 --> 00:06:05,210
والحرب تحتاجُ عدوًّا، أليس كذلك؟

92
00:06:05,600 --> 00:06:10,190
،كرافت، إنّه ثاني أهمّ عنصر بالنّسبة لنا

93
00:06:10,190 --> 00:06:14,210
قيل أنّه سيُجهّز العدوّ المناسب
في المكان والوقت المناسبين

94
00:06:14,210 --> 00:06:19,330
وسوف نقاتله وننتصر عليه ونُحقّق أحلامنا

95
00:06:20,100 --> 00:06:22,650
بعبارةٍ أخرى، يُفترض بنا هزيمتك

96
00:06:23,930 --> 00:06:25,810
هذا غير منطقي

97
00:06:25,810 --> 00:06:27,390
عمّاذا تتحدّثين؟

98
00:06:27,390 --> 00:06:29,810
لا أعلم أدنى فكرة من تكونون

99
00:06:29,810 --> 00:06:31,870
أو من يكون ذاك المدعو ميركوريوس

100
00:06:31,870 --> 00:06:35,160
لكنّ الوضع الرّاهن هو أنّ الجميع يلاحقونك

101
00:06:35,810 --> 00:06:38,300
إلّم يعجبك الأمر فلتشتكِ إلى كرافت

102
00:06:38,300 --> 00:06:41,150
جميع المحاربين القدامى يبغضونه

103
00:06:41,150 --> 00:06:43,390
...إنّه بذيء جدًّا حسبما سمعت

104
00:06:43,390 --> 00:06:45,170
لا، ليس هو فحسب

105
00:06:45,680 --> 00:06:50,750
العديد من ذوي المراتب العليا
اختفوا عقب الحرب العظمى الأخيرة

106
00:06:51,380 --> 00:06:53,300
وكرافت من بينهم

107
00:06:53,300 --> 00:06:56,750
،لذا لا أعلم الكثير عنهم

108
00:06:56,750 --> 00:06:59,370
لكن سمعت أنّهم وحوشٌ جميعًا

109
00:06:59,370 --> 00:07:02,270
وأنّه إن بدأت الحرب فسيرجعون

110
00:07:02,270 --> 00:07:06,280
بعبارة أخرى، أنتم الذين أسفل عمود الرّسم الطوطمي

111
00:07:06,280 --> 00:07:08,460
عليكم أن ترضوا الأشخاص المهمّين؟

112
00:07:08,460 --> 00:07:09,530
أجل

113
00:07:09,530 --> 00:07:11,670
وإلّا لن تتحقّق رغبتي

114
00:07:16,570 --> 00:07:19,690
السّحر الذي منحنا كرافت يخوّلنا التعاقد

115
00:07:19,690 --> 00:07:24,000
مع سلاحٍ خاصّ وكذا اكتساب قوّته

116
00:07:24,500 --> 00:07:26,350
تُدعى هذه الأسلحة بالآثار

117
00:07:26,350 --> 00:07:29,180
وأغلبيّتها ملعونة

118
00:07:29,180 --> 00:07:31,610
،لذا تلتهم أرواح البشر

119
00:07:31,610 --> 00:07:34,390
الأمر الذي يجعلنا أقوى وأصعب للقتل

120
00:07:35,660 --> 00:07:38,310
،إن قتلنا مئة نكتسبُ أرواح مئة

121
00:07:38,780 --> 00:07:42,020
ونستطيع أن نفعل مئة ضعف
ممّا يستطيع البشر فعله

122
00:07:42,660 --> 00:07:47,070
لهذا لم تستطع المسّ بي

123
00:07:47,070 --> 00:07:49,250
،الركل واللّكم لا يفيدان بشيء

124
00:07:49,250 --> 00:07:51,910
ولا القنابل والمسدّسات

125
00:07:51,910 --> 00:07:54,410
لقد قتل العديد من النّاس وأصبح قويًّا للغاية

126
00:07:54,980 --> 00:07:57,250
وأنت مثله الآن

127
00:07:57,250 --> 00:07:59,610
لديكَ سلاحٌ يحوّل الأرواح إلى قوّة

128
00:08:00,020 --> 00:08:01,950
لكنّك ما تزال مبتدئًا

129
00:08:02,410 --> 00:08:03,700
،بما أنّها تعويذة

130
00:08:03,700 --> 00:08:06,590
كلّما زادت خبرتك معها زاد ما تستطيع فعله

131
00:08:06,590 --> 00:08:11,550
إنشاء
تشكيل
تفعيل

132
00:08:07,070 --> 00:08:09,030
المستوى الأدنى هو التفعيل

133
00:08:09,030 --> 00:08:10,220
بعده التّشكيل

134
00:08:10,220 --> 00:08:11,550
ثمّ الإنشاء

135
00:08:11,940 --> 00:08:16,340
،بينما المستوى الأعلى لم يصل إليه أحد قبلًا

136
00:08:16,340 --> 00:08:18,000
لذا لا نعلم ما هو

137
00:08:18,000 --> 00:08:20,520
لكنّك الآن عندَ مستوى التّفعيل

138
00:08:21,560 --> 00:08:25,810
المرحلة حيث تستطيع بفكرةٍ أن تُفعّل قدرات أثرك

139
00:08:26,250 --> 00:08:29,440
على سبيل المثال، سيفٌ يستطيع إطلاق قاطعٍ خفيّ

140
00:08:29,440 --> 00:08:33,610
قد يبدو الأمر مريحًا لكنّ هذه المرحلة غير مستقرّة

141
00:08:34,350 --> 00:08:36,150
،بما أنّك لم تتقن أثرك بعد

142
00:08:36,150 --> 00:08:38,450
مستوى القوّة منخفض ومن
السّهل أن يخرج عن السيطرة

143
00:08:40,620 --> 00:08:42,970
،لذا يجب أن تصل إلى مستوى التشكيل على الأقل

144
00:08:43,380 --> 00:08:46,950
حيث تستطيع أن تمنح لأثرك
شكلًا ماديًا وتحوّله إلى سلاح

145
00:08:47,430 --> 00:08:50,380
إلّم تستطع فعل هذا فلا يوجد
ما نتحدّث عنه يا فوجي-كُن

146
00:08:50,690 --> 00:08:53,940
لذا حاول ذلك أوّلًا

147
00:08:53,940 --> 00:08:55,730
سأعلّمك الأساسيات

148
00:09:22,510 --> 00:09:24,090
!وجدتك أخيرًا

149
00:09:24,090 --> 00:09:26,580
!أين كنت؟

150
00:09:30,610 --> 00:09:33,100
،اسمع، لا أعلم ما حدث

151
00:09:33,100 --> 00:09:34,670
لكنّك كنت تتصرّف بغرابة مؤخرًا

152
00:09:35,120 --> 00:09:36,930
قمتَ بسدّ الحفرة التي في الغرفة

153
00:09:36,930 --> 00:09:40,750
أقصد، أعلم أنّني ربّما فعلتُ
...بعض الأشياء التي لا يجب عليّ فعلها

154
00:09:41,670 --> 00:09:43,950
!لكنّي لن أعلم ما يجري إلّم تخبرني

155
00:09:43,950 --> 00:09:47,290
هل فعلتُ ما يدفعك لتتحاشاني؟

156
00:09:52,170 --> 00:09:54,150
!عجبًا

157
00:09:54,150 --> 00:09:56,610
ما الخطب أنتما؟

158
00:09:56,610 --> 00:09:59,620
شجار بين الأحبة؟

159
00:09:59,620 --> 00:10:01,120
...ليس هكذا

160
00:10:01,120 --> 00:10:03,740
إنّما يتصرّفُ بغرابة

161
00:10:04,580 --> 00:10:05,650
فهمت

162
00:10:05,650 --> 00:10:07,540
...ذلك لأنّ

163
00:10:08,340 --> 00:10:09,290
آسف يا كاسومي

164
00:10:09,710 --> 00:10:11,700
لم أخبرك

165
00:10:11,700 --> 00:10:15,630
في الواقع، أنا أواعد ساكوراي

166
00:10:18,510 --> 00:10:19,520
هكذا إذًا؟

167
00:10:19,520 --> 00:10:24,010
ماذا؟ حقًّا؟

168
00:10:24,430 --> 00:10:25,180
أليس كذلك؟

169
00:10:27,050 --> 00:10:29,560
أجل، يبدو أنّنا نتواعد

170
00:10:29,560 --> 00:10:32,380
إنّها غيورة جدًّا

171
00:10:32,380 --> 00:10:35,410
لذا... تفهّمي رجاءً يا كاسومي

172
00:10:36,010 --> 00:10:36,900
أجل

173
00:10:37,230 --> 00:10:40,280
من الآن فصاعدًا، سأعتني بفوجي-كُن

174
00:10:40,280 --> 00:10:42,490
شكرًا على كلّ شيء يا أياسي-سان

175
00:10:43,590 --> 00:10:46,500
...أ-أكيد

176
00:10:46,500 --> 00:10:49,110
آ-آسفة لأنّي لم أدرك ذلك

177
00:11:02,300 --> 00:11:05,330
...لا... لا

178
00:11:08,230 --> 00:11:09,480
!آسفة

179
00:11:09,480 --> 00:11:10,950
...لم أكن أنتبه

180
00:11:24,010 --> 00:11:24,910
فهمت

181
00:11:24,910 --> 00:11:26,770
فهمتُ الأمر أخيرًا

182
00:11:26,770 --> 00:11:30,660
أنتِ الرّوح التي تسكن المقصلة، صحيح؟

183
00:11:31,890 --> 00:11:35,610
متى وكيف حدث لك ذلك؟

184
00:11:37,090 --> 00:11:38,490
أستطيع أن ألمسك

185
00:11:39,220 --> 00:11:41,290
كما قال كاليوسترو تمامًا

186
00:11:41,750 --> 00:11:44,370
أنت بخير حتّى إن لمستك

187
00:11:45,030 --> 00:11:46,050
هذا يسعدني

188
00:11:46,870 --> 00:11:48,830
أنت دافئ جدًّا

189
00:11:50,170 --> 00:11:51,290
...رين

190
00:11:51,290 --> 00:11:54,380
...واثقةٌ أنّك

191
00:11:57,730 --> 00:12:00,650
لا أشعر بالارتياح أمام السيوف

192
00:12:00,650 --> 00:12:04,050
أملك ذكرى سيّئة معها

193
00:12:04,050 --> 00:12:04,820
...لكن

194
00:12:05,350 --> 00:12:07,460
أنت فتاة جيّدة، صحيح؟

195
00:12:07,460 --> 00:12:09,040
أفهم ذلك

196
00:12:09,350 --> 00:12:12,950
لذا أريدك أن تكوني سعيدة أيضًا إن كان ممكنًا

197
00:12:20,780 --> 00:12:22,700
ما الذي تفعله يا فوجي-كُن؟

198
00:12:25,220 --> 00:12:26,260
مرحبًا

199
00:12:26,260 --> 00:12:28,780
إنّنا نبحث عن الأب

200
00:12:28,780 --> 00:12:29,680
هل رأيته؟

201
00:12:29,680 --> 00:12:31,650
الأب تريفا؟

202
00:12:31,650 --> 00:12:33,700
...كلّا، أخشى أنّي لم أره

203
00:12:33,700 --> 00:12:34,690
لكن لمَ؟

204
00:12:34,690 --> 00:12:37,890
لأنّ ريا لئيمةٌ معه دائمًا

205
00:12:37,890 --> 00:12:39,190
أهذه غلطتي؟

206
00:12:39,190 --> 00:12:41,400
أهي غلطتي إذًا؟

207
00:12:41,400 --> 00:12:44,280
بعبارة أخرى، هرب من البيت بسببكما؟

208
00:12:44,760 --> 00:12:47,280
فوجي-كُن، حكمك على النّاس فظيع

209
00:12:47,280 --> 00:12:49,300
—إنه في الواقع

210
00:12:50,150 --> 00:12:51,770
حسنٌ، هذا ما في الأمر

211
00:12:51,770 --> 00:12:54,630
فوجي-كُن، انتبه إلى نفسك

212
00:12:54,630 --> 00:12:57,430
انتظري يا ريزا، لم ننتهِ من الحديث

213
00:12:57,430 --> 00:12:58,610
!ريزا

214
00:13:13,520 --> 00:13:15,240
غريب

215
00:13:15,240 --> 00:13:17,940
ظننته أتى إلى هنا

216
00:13:24,820 --> 00:13:25,940
ماذا؟

217
00:13:26,780 --> 00:13:29,340
ما الخطب يا فوجي-سان؟

218
00:13:30,240 --> 00:13:33,120
من الجميل مقابلتك هنا

219
00:13:33,120 --> 00:13:34,540
هل احتجت شيئًا؟

220
00:13:35,050 --> 00:13:37,260
...لا، أنا

221
00:13:38,610 --> 00:13:41,340
أظنّ أنّهما طلبتا منك البحث عنّي

222
00:13:41,340 --> 00:13:44,440
كم هذا محرج

223
00:13:44,440 --> 00:13:47,880
تلكما الاثنتان تأخذان عنّي فكرة سيّئة

224
00:13:47,880 --> 00:13:49,640
هذا ليس صحيحًا

225
00:13:49,640 --> 00:13:52,640
أظنّ أنّهما قلقتان

226
00:13:52,640 --> 00:13:54,350
لذا عليك أن تعود

227
00:13:54,890 --> 00:13:56,430
فهمت

228
00:13:56,430 --> 00:14:01,260
أنا قلقٌ بشأن تريجيا بدوري

229
00:14:01,260 --> 00:14:04,430
إنّه ليحزنني أنّها لا تعي ذلك

230
00:14:05,940 --> 00:14:07,160
فوجي-سان

231
00:14:07,160 --> 00:14:09,530
هل تحبّ تريجيا؟

232
00:14:13,170 --> 00:14:14,340
أعتذر

233
00:14:14,340 --> 00:14:16,520
لقد كان سؤالًا غريبًا

234
00:14:16,520 --> 00:14:18,060
وداعًا

235
00:14:18,060 --> 00:14:18,960
!انتظر

236
00:14:30,450 --> 00:14:31,850
...مستحيل

237
00:14:32,790 --> 00:14:34,190
لقد كنتُ أتخيّل

238
00:14:34,870 --> 00:14:36,060
أتخيّل

239
00:14:40,020 --> 00:14:41,520
كاسومي
أياسي

240
00:14:42,390 --> 00:14:43,450
مرحبًا؟

241
00:14:43,450 --> 00:14:44,710
ماذا هناك يا كاسومي؟

242
00:14:45,500 --> 00:14:47,550
كاسومي

243
00:14:49,490 --> 00:14:50,740
...رين

244
00:14:51,230 --> 00:14:52,740
...أنجدني

245
00:14:54,140 --> 00:14:56,700
حبيبتك ظريفةٌ جدًّا، أليس كذلك؟

246
00:14:56,700 --> 00:14:58,660
ما يجعلني أريد أكلها

247
00:14:59,150 --> 00:15:00,930
أنا شبيني

248
00:15:00,930 --> 00:15:02,290
من معجبيك

249
00:15:03,070 --> 00:15:04,260
لا تتحرّك

250
00:15:04,260 --> 00:15:08,260
!أنا آتٍ لأقتلك

251
00:15:45,150 --> 00:15:47,090
...أيها الوغد

252
00:15:47,090 --> 00:15:48,460
!مرحبًا

253
00:15:48,460 --> 00:15:51,240
هل تستمتع بمأدبة اللّيلة؟

254
00:15:51,240 --> 00:15:54,140
...سأعرفك عن نفسي مجدّدًا

255
00:15:54,140 --> 00:15:59,760
عاشر رهبان لونغينوس الطاولة
السوداء الثلاثة عشر، روت شبيني

256
00:15:59,760 --> 00:16:01,690
يسرّني لقاؤك

257
00:16:04,270 --> 00:16:05,650
لا جدوى من ذلك

258
00:16:05,650 --> 00:16:08,230
حاليًا، لا تستطيع قطعها

259
00:16:08,600 --> 00:16:11,090
أخبرتكَ ليونهارت بالفعل، صحيح؟

260
00:16:11,090 --> 00:16:12,990
هذا مستوى التشكيل

261
00:16:12,990 --> 00:16:16,120
...أثرٌ على شكلِ سلاح

262
00:16:17,080 --> 00:16:20,610
لا شيء يستطيع إنقاذك
ما لم تصل إلى نفس المستوى

263
00:16:20,610 --> 00:16:22,930
كأي شيء آخر

264
00:16:33,550 --> 00:16:36,370
لكن مع ذلك، عيناك تملؤهما الرّوح القتالية

265
00:16:36,370 --> 00:16:39,160
!أحببتُ هذا! بديع

266
00:16:39,160 --> 00:16:41,010
،واثقٌ أنّك سمعتَ هذا أيضًا

267
00:16:41,010 --> 00:16:43,770
لكنّنا نريدك أن تكون قويًّا

268
00:16:44,120 --> 00:16:46,140
،بالتّالي، ليونهارت توفّر لك الدروس

269
00:16:46,140 --> 00:16:51,110
بينما أنا أوفّر لكَ الاختبار العمليّ

270
00:16:51,110 --> 00:16:55,250
لكن بيني وبينك، لا نيّة لدي لأكون عدوّك

271
00:16:55,250 --> 00:16:56,870
ولو أراد آخرون ذلك

272
00:16:58,070 --> 00:16:59,080
ماذا؟

273
00:16:59,420 --> 00:17:01,880
...ما قلته تمامًا

274
00:17:01,880 --> 00:17:04,040
أنا لستُ كالبقية

275
00:17:04,040 --> 00:17:06,870
بالتّالي، أريد أن أعمل معك

276
00:17:06,870 --> 00:17:10,250
لكن فقط إن كنتَ مفيدًا

277
00:17:17,680 --> 00:17:21,390
!أرني قيمتك الحقيقيّة

278
00:17:32,580 --> 00:17:34,370
ما رأيك الآن؟

279
00:17:34,370 --> 00:17:36,730
!أرني! أرني

280
00:17:55,910 --> 00:17:58,290
هل أنت مجنون؟

281
00:17:58,290 --> 00:17:59,840
ما الذي تحاول فعله؟

282
00:18:02,290 --> 00:18:03,520
...سأقتلك

283
00:18:03,860 --> 00:18:06,480
...سأقتلك، أقسم على ذلك

284
00:18:06,480 --> 00:18:08,460
!سأقتلك

285
00:18:10,290 --> 00:18:12,190
!تشكيل

286
00:18:30,230 --> 00:18:31,470
فهمت

287
00:18:31,470 --> 00:18:34,300
إذًا، ابنُ الوحش وحشٌ بالفعل؟

288
00:18:46,690 --> 00:18:48,100
!فليكن

289
00:18:48,100 --> 00:18:50,750
!إذًا، حان وقتُ العرض الحقيقيّ

290
00:19:01,110 --> 00:19:03,070
ماذا؟

291
00:19:18,090 --> 00:19:19,420
!مهلًا، لا

292
00:19:19,420 --> 00:19:20,170
...ذاك كان

293
00:19:20,170 --> 00:19:22,180
!يا كاهن الكأس، أنقذني

294
00:19:28,520 --> 00:19:30,300
لا تستهن بي

295
00:19:30,300 --> 00:19:34,110
!هل ظننتَ أنّني سأتصرّف دون تأمينٍ مسبق؟

296
00:19:39,650 --> 00:19:43,870
وهل ظننتَ أنّني لن أحزر ما ستفعل؟

297
00:19:43,870 --> 00:19:45,760
...وداعًا يا شبيني

298
00:19:45,760 --> 00:19:47,490
متُ داخل الصّليب المعقوف

299
00:19:55,830 --> 00:19:58,710
!لا! لا

300
00:19:59,270 --> 00:20:04,230
!لا

301
00:20:50,510 --> 00:20:52,540
ليس هنا أيضًا؟

302
00:20:52,540 --> 00:20:54,890
أين ذهب؟

303
00:20:57,690 --> 00:21:00,280
!رين

304
00:21:00,660 --> 00:21:02,650
لقد أضعتُ هاتفي

305
00:21:02,650 --> 00:21:05,450
فظننتُ أنّه قد يكون هنا

306
00:21:05,450 --> 00:21:08,930
كما أنّ هنالك الكثير من الأغراض هنا

307
00:21:08,930 --> 00:21:12,470
...ظننتُ أنّني إلّم أنظّف فستغضب ساكوراي-سان

308
00:21:13,790 --> 00:21:15,010
أنا مسرورٌ حقًّا

309
00:21:16,050 --> 00:21:17,540
مسرورٌ حقًّا

310
00:21:18,060 --> 00:21:19,140
...كاسومي

311
00:23:34,930 --> 00:23:41,250
رسم: ميناتوغاوا كازومي