1
00:00:05,910 --> 00:00:08,440
والآن، يكفي انتظارًا

2
00:00:08,940 --> 00:00:10,650
لقد انتهت المهزلة

3
00:00:10,650 --> 00:00:12,690
،بي، ماليوس

4
00:00:12,690 --> 00:00:14,820
ليونهارت، بابيلون

5
00:00:14,820 --> 00:00:16,620
وتوبال كاين

6
00:00:17,610 --> 00:00:19,200
سيحلّ الفجر عمّا قريب

7
00:00:19,200 --> 00:00:22,940
ومعه ستندلع الحرب

8
00:00:22,940 --> 00:00:26,360
دعوها تقودكم إلى أعماق الجنون

9
00:00:27,380 --> 00:00:30,580
حاليًّا، صليبان معقوفان قد فُتِحا

10
00:00:31,500 --> 00:00:36,180
وكلاهما يفتقدان إلى شخصٍ جديرٍ
بالتضحية في سبيل السيّد هايدريخ

11
00:00:36,180 --> 00:00:39,350
التضحية الأولى ستكون السيدة كيرخيايزن

12
00:00:39,770 --> 00:00:41,660
والثانية ستكون شبيني

13
00:00:41,660 --> 00:00:47,400
لا أحد سوى هذين الاثنين جديران بالمباركة الذهبية

14
00:00:47,850 --> 00:00:49,770
،لكن بقي ستّة

15
00:00:50,280 --> 00:00:52,650
وهنالك ستّة منّا

16
00:00:53,180 --> 00:00:57,490
بالتّالي، إن لم يتملّكنا الطمع
فسيكلّل كلّ شيءٍ بالنجاح

17
00:00:57,490 --> 00:01:00,950
إلّا أنّ السيّد هايدريخ يبتغي الدم

18
00:01:00,950 --> 00:01:04,230
لم يتغيّر البتّة منذ الأيّام الخوالي

19
00:01:04,230 --> 00:01:09,560
جميعًا، تذكّروا ذلك بينما تتصرّفون كأنيابه ومخالبه

20
00:01:12,770 --> 00:01:14,350
،بدايةً، سأبيح خمسةً

21
00:01:14,350 --> 00:01:16,840
أو ثلاثة أخرى على الموجودين الآن

22
00:01:16,840 --> 00:01:19,100
ليتمّ فتحها

23
00:01:19,100 --> 00:01:23,680
لكن اجتنبوا الاختيار في نفس اليوم قدر الإمكان

24
00:01:24,810 --> 00:01:27,470
الحرب تشتهي مذبحةً

25
00:01:27,470 --> 00:01:30,650
امنحنا النصر

26
00:01:36,310 --> 00:01:38,030
...فوجي-كُن

27
00:01:40,970 --> 00:01:47,000
لكن هل سينتظرنا السيد هايدريخ ببساطة؟

28
00:01:47,000 --> 00:01:50,020
...لا أتوقّع أن يفعل

29
00:01:58,110 --> 00:02:01,780
زاميل، ستفتحين الخامس

30
00:02:01,780 --> 00:02:05,020
،سيكون عليك استخدام القوّة
لكن لكِ أن تكوني خشنة

31
00:02:05,020 --> 00:02:07,060
بعدها لاعبيهم قليلًا

32
00:02:07,550 --> 00:02:09,190
اجعليهم كما يجب

33
00:02:09,190 --> 00:02:11,420
يافول ماين هير

34
00:03:42,710 --> 00:03:45,700
انظروا إلى هذا المشهد! لقد تحطّم الجسر بالكامل

35
00:03:46,260 --> 00:03:48,220
،ما زلنا نجهل ما أحدث هذا

36
00:03:48,220 --> 00:03:51,510
،بيدَ أنّ تقاريرَ عديدة تزعم ظهور عملاق

37
00:03:51,510 --> 00:03:57,170
بينما يشكّ البعض أنّه من صنيع
غازٍ مسمّمٍ يؤدّي إلى الهلوسة

38
00:03:57,580 --> 00:04:02,420
سواهارا كانت بالفعل تحت تهديد
سلسلةٍ من جرائم القتل الوحشية

39
00:04:03,470 --> 00:04:05,220
ما الذي يجري هنا؟

40
00:04:05,220 --> 00:04:07,830
!هذا ليس الوقت المناسب للذهاب إلى المدرسة

41
00:04:10,730 --> 00:04:11,640
كما أنّ رين ليس هنا

42
00:04:12,030 --> 00:04:13,590
!هذا مريب

43
00:04:14,020 --> 00:04:15,060
!حسمتُ أمري

44
00:04:19,740 --> 00:04:20,690
!مرحبًا

45
00:04:22,140 --> 00:04:22,700
مرحبًا؟

46
00:04:25,700 --> 00:04:26,410
!مفاجأة

47
00:04:37,400 --> 00:04:41,050
!!فتاتك معي
اتّصل بي

48
00:04:39,260 --> 00:04:41,050
مرحبًا؟

49
00:04:41,050 --> 00:04:43,300
هونجو، ماذا تفعلين؟

50
00:04:43,300 --> 00:04:46,130
رين-كُن، أنت بخير

51
00:04:46,130 --> 00:04:47,100
أنا مسرورة

52
00:04:47,100 --> 00:04:49,310
...اسمعي، ما الذي

53
00:04:50,380 --> 00:04:53,300
كاسومي-تشان هنا

54
00:04:53,300 --> 00:04:54,060
أتريد أن تكلّمها؟

55
00:04:54,060 --> 00:04:55,450
!أيها الغبي

56
00:04:55,450 --> 00:04:56,560
!غبي! غبي! غبي! غبي

57
00:04:56,560 --> 00:05:00,290
أتعلم كم كنت قلقة؟

58
00:05:00,290 --> 00:05:02,130
اخرسي. اخرسي

59
00:05:02,130 --> 00:05:03,990
اهدئي يا كوروبوكورو

60
00:05:03,990 --> 00:05:06,210
!من تنعت بكوروبوكورو؟

61
00:05:06,210 --> 00:05:11,330
شيرو، لا يعقل أنّك أمضيت كلّ
هذا الوقت بالعبث هنا

62
00:05:06,970 --> 00:05:07,930
أسمعت؟

63
00:05:07,930 --> 00:05:10,590
إنها بخير

64
00:05:10,590 --> 00:05:11,330
وكذلك شيرو

65
00:05:13,330 --> 00:05:14,220
فهمت

66
00:05:14,220 --> 00:05:15,330
حسنًا

67
00:05:15,730 --> 00:05:18,440
كنتُ قلقًا في البداية لكنّ هذا
يزيح عنّي بعض المتاعب

68
00:05:18,440 --> 00:05:21,710
لا يمكنني أن أدعها تذهب إلى المدرسة الآن

69
00:05:21,710 --> 00:05:24,600
يبدو أنها لم تكن تنوي ذلك أساسًا

70
00:05:24,600 --> 00:05:28,090
على أيّ حال، لا أظنّ أنّ هذا
وقتٌ مناسب للذهاب

71
00:05:28,090 --> 00:05:30,850
!فسّر ما يجري هنا

72
00:05:29,610 --> 00:05:30,850
إذًا يا رين

73
00:05:30,850 --> 00:05:34,340
هل أنت مهتمّ أكثر بالحديث معنا الآن؟

74
00:05:34,340 --> 00:05:35,300
أجل

75
00:05:35,300 --> 00:05:37,540
لديكما معلومات، صحيح؟

76
00:05:37,540 --> 00:05:38,980
أريد معرفتها

77
00:05:39,430 --> 00:05:40,700
...لكن أوّلًا

78
00:05:40,700 --> 00:05:41,900
أعلم

79
00:05:42,450 --> 00:05:43,700
أهلًا يا رين

80
00:05:43,700 --> 00:05:45,070
هل أنت بخير؟

81
00:05:45,070 --> 00:05:46,450
ما الأخبار؟

82
00:05:46,450 --> 00:05:47,490
!تدري ما الأخبار

83
00:05:47,490 --> 00:05:49,450
!لا تقل لكاسومي شيئًا

84
00:05:49,450 --> 00:05:51,370
!بشأن قتالنا أوّ أيًّا من ذلك

85
00:05:51,790 --> 00:05:53,020
عُلِم

86
00:05:53,020 --> 00:05:54,620
أظنّك مدينًا لي بواحدة إذًا

87
00:05:54,620 --> 00:05:56,490
أهذا رين؟

88
00:05:56,490 --> 00:05:58,190
دعني أتحدّث إليه

89
00:05:58,690 --> 00:06:01,560
!أنت مزعجة جدًّا

90
00:06:01,560 --> 00:06:03,030
تعالي إلى هنا

91
00:06:03,030 --> 00:06:04,510
فلنسمع ما لديك

92
00:06:05,020 --> 00:06:07,360
إذًا، هل تقدّمت علاقتك مع رين؟

93
00:06:07,360 --> 00:06:08,880
تقدّمت كيف؟

94
00:06:08,880 --> 00:06:11,040
ماذا؟ هل ستظلّين بكرًا إلى الأبد؟

95
00:06:11,040 --> 00:06:12,600
...أمرك ميؤوس

96
00:06:12,600 --> 00:06:13,720
!اخرس

97
00:06:14,790 --> 00:06:17,270
على أيّ حال، فلندخل إلى صلب الموضوع

98
00:06:26,410 --> 00:06:27,780
فهمت

99
00:06:27,780 --> 00:06:30,510
...هذا صعب

100
00:06:30,510 --> 00:06:33,870
لكن... تلك السينباي. هل واثقٌ أنّ لا بأس بتركها؟

101
00:06:33,870 --> 00:06:35,470
لا

102
00:06:35,470 --> 00:06:37,330
...لكنّ الكاهن قال

103
00:06:38,490 --> 00:06:43,790
أشكّ أنّك تثق بي لكن أريد قول هذا

104
00:06:43,790 --> 00:06:49,430
لا أملك أيّ نيّة في إيذاء تريجيا

105
00:06:51,100 --> 00:06:52,970
وصدّقته

106
00:06:52,970 --> 00:06:54,710
مستحيل

107
00:06:54,710 --> 00:06:58,230
لكن لم يبدُ وكأنّه كان يكذب تمامًا

108
00:06:59,070 --> 00:07:01,690
بدا من الواضح أنّهما يعرفان بعضهما الآخر

109
00:07:01,690 --> 00:07:06,740
إن حاولت أخذها لربّما انتهى
بك الحال تقاتل كلّ من هناك

110
00:07:07,610 --> 00:07:08,880
لا يهم

111
00:07:08,880 --> 00:07:11,530
ما كنتَ لتستطيع فعل ذلك بينما تحمي الجميع

112
00:07:12,100 --> 00:07:14,360
والأهم، أنت لا تملك معلوماتٍ كافية

113
00:07:15,490 --> 00:07:17,990
وهنا يحين دورك يا هونجو

114
00:07:17,990 --> 00:07:21,000
الأماكن الثمانية التي قالوا
...أنّهم أعدّوها في هذه المدينة

115
00:07:21,420 --> 00:07:23,590
تعرفين ما هي، صحيح؟

116
00:07:23,590 --> 00:07:25,210
أجل

117
00:07:25,700 --> 00:07:29,050
لطالما شهدت مدينة سواهارا
العديد من الشركات الغريبة

118
00:07:29,050 --> 00:07:32,160
،وإن ضمنّا الأماكن التي تحت تأثيرها

119
00:07:32,160 --> 00:07:34,400
فذلك يشمل المدينة بأكملها أساسًا

120
00:07:35,140 --> 00:07:41,070
كما سمعت، لعلّ هذه المدينة أُعدّت لأجل أهدافهم

121
00:07:42,440 --> 00:07:44,970
أخبرني جدّي نفس الشيء

122
00:07:44,970 --> 00:07:45,800
جدّك؟

123
00:07:45,800 --> 00:07:46,660
أجل

124
00:07:46,660 --> 00:07:50,070
هل نسيت اسم المستشفى
الذي نزلت فيه أنت وشيرو؟

125
00:07:50,500 --> 00:07:53,240
والداي يديرانه

126
00:07:53,240 --> 00:07:56,200
مستشفى هونجو العام

127
00:07:56,200 --> 00:07:58,450
إذًا، أنتِ غنيّة وتتصرّفين هكذا؟

128
00:07:58,450 --> 00:08:00,250
أتصرّف كيف؟

129
00:08:00,250 --> 00:08:04,330
على أيّ حال، بفضل عائلتي أعلم
الكثير من الأشياء المريبة التي تدور في هذه المدينة

130
00:08:04,910 --> 00:08:07,480
وتلك... الصلبان المعقوفة؟

131
00:08:07,480 --> 00:08:08,550
هنالك ثمانية منها، صحيح؟

132
00:08:09,050 --> 00:08:12,530
أجل. قالوا أنّ اثنين منها قد فتح سلفًا

133
00:08:12,530 --> 00:08:13,510
أتعرف أين؟

134
00:08:13,850 --> 00:08:14,470
أجل

135
00:08:15,050 --> 00:08:16,220
في المنتزه على الأغلب

136
00:08:16,530 --> 00:08:17,970
وفي المتحف

137
00:08:17,970 --> 00:08:21,600
إذًا، نصف المتبقيّة الستّة بسيطة على الأقل

138
00:08:22,020 --> 00:08:23,270
مستشفاي

139
00:08:23,270 --> 00:08:24,440
المدرسة

140
00:08:24,440 --> 00:08:25,600
الكنيسة

141
00:08:25,600 --> 00:08:28,360
عرفتها بنفسك، صحيح؟

142
00:08:29,100 --> 00:08:32,530
بالنّسبة للمستشفى، كان فقط بعدما
سمعتُ ما قلته، لكن أجل

143
00:08:33,260 --> 00:08:35,200
إلّا أنّني لا أعرف الثلاثة المتبقية

144
00:08:35,750 --> 00:08:37,670
أخبريني يا هونجو

145
00:08:42,050 --> 00:08:43,120
مدينة الملاهي

146
00:08:44,080 --> 00:08:45,830
البرج

147
00:08:46,180 --> 00:08:47,790
القاعة المدنية

148
00:08:47,790 --> 00:08:49,850
هذه هي الأماكن الثمانية

149
00:08:49,850 --> 00:08:54,230
هذه الأماكن الثمانية حيث
يكون تأثيريهم قويًّا جدًّا

150
00:08:54,230 --> 00:08:58,180
وإن استثنينا الكنيسة، إنّها أماكن
حيث يحتشد الكثير من النّاس

151
00:08:58,180 --> 00:09:01,240
لن يكون هناك تقليص للتضحيات

152
00:09:02,140 --> 00:09:03,480
ماذا ستفعل إذًا؟

153
00:09:03,480 --> 00:09:06,640
لا تستطيع حماية الستّة في آنٍ واحد

154
00:09:07,220 --> 00:09:08,920
سأذهب إلى المدرسة

155
00:09:08,920 --> 00:09:11,730
هذا أناني، لكنّه أهمّ مكانٍ بالنسبة لي

156
00:09:12,410 --> 00:09:15,860
كما أنّ ساكوراي وروسالكا كانتا هناك

157
00:09:16,290 --> 00:09:18,120
لا أستطيع تجاهلهما

158
00:09:18,120 --> 00:09:19,540
حسنًا

159
00:09:19,540 --> 00:09:21,240
توقّعت أن تقول ذلك

160
00:09:21,240 --> 00:09:25,620
لقد تدمّر الجسر وانتشرت فيديوهات
لذلك العملاق في الإنترنت

161
00:09:25,990 --> 00:09:31,130
بعد كل تلك الفوضى، سيكون من الرّائع
لو أنّ الجميع لبثوا في منازلهم لفترة

162
00:09:31,130 --> 00:09:35,840
،لكنّ اليابان عاشت السلام لفترة طويلة
بالتّالي لا يمكننا أن نأمل ذلك

163
00:09:35,840 --> 00:09:39,090
ألا تستطيعين فعل شيء حيال
الأشخاص الذين في المستشفى؟

164
00:09:40,590 --> 00:09:43,720
سأفعل ما في حولي

165
00:09:44,210 --> 00:09:44,980
فهمت

166
00:09:45,590 --> 00:09:47,680
على كل حال، شكرًا يا هونجو

167
00:09:47,680 --> 00:09:49,260
سأردّ لك المعروف يومًا ما، أعدك

168
00:09:49,260 --> 00:09:50,980
لذا كوني حذرة

169
00:09:50,980 --> 00:09:53,100
لا ترتكبي أيّ حماقة

170
00:09:53,100 --> 00:09:54,320
إلى اللقاء

171
00:09:54,320 --> 00:09:55,690
هل فرغت من الحديث؟

172
00:09:55,690 --> 00:10:00,160
!انظر! لقد استعرت زيّ كاسومي

173
00:10:00,570 --> 00:10:02,160
سنذهب إلى المدرسة، صحيح؟

174
00:10:02,740 --> 00:10:04,120
ألا يبدو جميلًا عليّ يا رين؟

175
00:10:05,180 --> 00:10:07,080
أجل. يبدو كذلك حتمًا

176
00:10:09,020 --> 00:10:10,470
حقًّا

177
00:10:15,790 --> 00:10:17,560
فلنذهب يا ماري

178
00:10:42,070 --> 00:10:44,080
الجميع يتصرّفون بغرابة

179
00:10:44,080 --> 00:10:45,490
أجل

180
00:10:45,490 --> 00:10:48,830
كما أنّ ساكوراي وروسالكا ليستا هنا

181
00:10:49,470 --> 00:10:50,830
ولا السينباي

182
00:10:51,230 --> 00:10:53,960
بعبارة أخرى، إنّهم يحاولون
أن يمنعوا الجميع من الهروب؟

183
00:10:54,550 --> 00:10:56,920
لقد جعلوا الجميع يذهبون
إلى المدرسة مهما حدث

184
00:10:57,310 --> 00:10:59,680
...بواسطة التنويم المغناطيسي أو هكذا شيء

185
00:11:01,060 --> 00:11:03,890
،لكن في تلك الحالة
لمَ ليسوا هنا؟

186
00:11:03,890 --> 00:11:06,230
ومتى فعلوا هذا أساسًا؟

187
00:11:07,500 --> 00:11:10,080
تبًّا. لم أدرك الأمر إطلاقًا

188
00:11:10,080 --> 00:11:13,150
!رين، فلنجلس هنا

189
00:11:15,870 --> 00:11:18,300
!عيناك هكذا

190
00:11:18,300 --> 00:11:20,450
لم تسترح بتاتًا، أليس كذلك؟

191
00:11:20,450 --> 00:11:22,030
لذا اجلس

192
00:11:22,450 --> 00:11:24,160
!إنه شعورٌ جيد

193
00:11:49,290 --> 00:11:50,300
شكرًا

194
00:11:52,980 --> 00:11:54,730
أنا جائع

195
00:11:54,730 --> 00:11:56,860
هل أنت جائع يا رين؟

196
00:11:56,860 --> 00:11:58,000
أجل

197
00:11:58,000 --> 00:11:59,080
قليلًا

198
00:12:00,230 --> 00:12:01,570
هل أنت بخير يا ماري؟

199
00:12:01,910 --> 00:12:04,310
أنا بخير

200
00:12:04,310 --> 00:12:05,610
ماذا يجب أن نفعل؟

201
00:12:05,610 --> 00:12:07,100
أتريدني أن أجد شيئًا لأجلك؟

202
00:12:07,100 --> 00:12:08,540
لا

203
00:12:09,160 --> 00:12:14,590
سأجد نفسي أفكّر بشأن
...أمورٍ لا أستطيع تغييرها

204
00:12:15,130 --> 00:12:16,420
كالعادة

205
00:12:18,500 --> 00:12:25,220
أريد أن أسمع ما اعتدتَ فعله هنا دائمًا

206
00:12:25,540 --> 00:12:29,400
هنالك الكثير من النّاس في نفس عمرك هنا

207
00:12:29,400 --> 00:12:32,110
!والبناية جميلة وكأنها قلعة

208
00:12:32,110 --> 00:12:34,220
!يبدو هذا ممتعًا للغاية

209
00:12:38,900 --> 00:12:40,650
...إنه كذلك

210
00:12:40,650 --> 00:12:42,140
حقًّا؟

211
00:12:42,140 --> 00:12:43,450
أجل

212
00:12:43,930 --> 00:12:47,380
كاسومي وشيرو كانا في نفس صفي

213
00:12:48,230 --> 00:12:50,720
إنهما غبيان وصاخبان

214
00:12:50,720 --> 00:12:54,050
لذا لطالما جذبا المشاكل

215
00:12:54,700 --> 00:12:56,870
لكنّ ذلك كان ممتعًا جدًّا في الواقع

216
00:12:57,690 --> 00:13:00,680
تمنّيتُ لو أنّه يستمرّ إلى الأبد

217
00:13:02,060 --> 00:13:05,430
لطالما قصدت السطح لأهرب من الجميع

218
00:13:06,050 --> 00:13:09,790
في سنتي الأولى هنا، قابلت تلك السينباي الغريبة

219
00:13:10,700 --> 00:13:13,480
ثمّ تبعتني باكاسومي إلى الأعلى

220
00:13:13,480 --> 00:13:17,650
وفي النهاية أصبح مكانًا نتسكّع فيه

221
00:13:18,380 --> 00:13:20,710
،لطالما كان شيرو متعجرفًا للغاية

222
00:13:21,170 --> 00:13:24,360
بينما كانت السينباي تأكل تلك الشطائر الغريبة

223
00:13:25,770 --> 00:13:28,510
،إلى حينٍ قريب

224
00:13:29,140 --> 00:13:31,560
كان أربعتنا سويًّا دائمًا

225
00:13:33,900 --> 00:13:35,420
...والآن

226
00:13:36,370 --> 00:13:39,740
إذًا، هل يمكنني أن أكون الخامسة؟

227
00:13:41,430 --> 00:13:43,260
ألا بأس؟

228
00:13:51,190 --> 00:13:51,970
لا بأس

229
00:13:52,410 --> 00:13:54,390
واثق أنّ الأمر سيكون ممتعًا

230
00:13:54,390 --> 00:13:55,640
هذا وعد

231
00:15:24,610 --> 00:15:26,070
ليلة سعيدة

232
00:15:26,790 --> 00:15:29,030
!ليلة سعيدة يا فتيان

233
00:15:31,930 --> 00:15:33,200
لقد أتت

234
00:15:33,200 --> 00:15:35,190
أجل، يبدو كذلك

235
00:15:39,150 --> 00:15:41,460
مهلًا! ما الذي يجري هنا؟

236
00:15:43,920 --> 00:15:45,040
...أذاك

237
00:15:48,140 --> 00:15:50,670
خبّئيها في مكانٍ ما

238
00:15:50,670 --> 00:15:52,130
أعلم

239
00:15:52,130 --> 00:15:54,090
لقد كذبنا على رين-كُن

240
00:15:54,550 --> 00:15:57,820
إن تركناها تموت فسيصبح مخيفًا لاحقًا

241
00:16:05,710 --> 00:16:06,680
...رين

242
00:16:06,680 --> 00:16:07,910
ما كان ذلك؟

243
00:16:10,150 --> 00:16:13,360
لا يعقل... صليب معقوف؟

244
00:16:23,710 --> 00:16:26,340
ليلًا، عندما ينام كلّ شيء

245
00:16:27,150 --> 00:16:30,300
كم من الجميل أن تغادر قاع البحر

246
00:16:35,070 --> 00:16:37,550
يا لها من فرحة، تلاعب الأمواج

247
00:16:38,460 --> 00:16:43,930
،عبر الصمت المكسور الآن
ننادي بأسمائنا

248
00:16:43,930 --> 00:16:46,860
الشعر حالك السّواد يدور وقع الرياح

249
00:16:46,860 --> 00:16:49,520
يا لها من فرحة وأنت تراه يجفّ

250
00:16:55,510 --> 00:16:57,450
!أحسنت

251
00:16:58,050 --> 00:17:02,410
أدّيتِ بشكلٍ جيد جدًّا بالنسبة لآنسة كبيرة

252
00:17:02,900 --> 00:17:04,630
مرحبًا

253
00:17:04,630 --> 00:17:07,420
لم أتوقع أن تأتين

254
00:17:07,820 --> 00:17:10,650
تقصد بي، صحيح؟

255
00:17:10,650 --> 00:17:13,400
بدا مهتمًّا بك

256
00:17:14,180 --> 00:17:17,740
لكنّي أحبّ أخذ حاجيات الغير

257
00:17:18,370 --> 00:17:20,390
لا، هذا صحيح

258
00:17:20,860 --> 00:17:23,600
أحبّ أن أعبث بما يفعله النّاس

259
00:17:25,210 --> 00:17:27,980
!هذا يدغدغ

260
00:17:27,980 --> 00:17:29,560
!إنه شعور رائع

261
00:17:29,560 --> 00:17:32,320
!منطقتك هي المدرسة

262
00:17:32,320 --> 00:17:34,320
أمّ أنّ تقمّصك لشخصية تلميذة مراهقة بدأ يضرّك

263
00:17:34,320 --> 00:17:35,550
يا لولي المسنّة؟

264
00:17:35,550 --> 00:17:38,870
كلّا، سأستحوذ على تلك أيضًا

265
00:17:38,870 --> 00:17:42,530
أنا وقحة وطمّاعة وجائعة

266
00:17:42,530 --> 00:17:43,830
...لذا رجاءً

267
00:17:44,150 --> 00:17:45,290
دعاني ألتهمكما

268
00:17:46,750 --> 00:17:48,020
―برياه

269
00:17:48,300 --> 00:17:51,750
!تشيتي هانغاريا ناهاتيرا

270
00:18:17,050 --> 00:18:19,030
!ظريفٌ جدًّا

271
00:18:19,030 --> 00:18:22,980
،تعلمان أنّ ذلك لن يفلح
!لكنّ هذا كلّ ما تستطيعان فعله

272
00:18:29,870 --> 00:18:31,800
...والآن، أنتما

273
00:18:31,800 --> 00:18:34,300
دعاني أسمع آخر كلامكما

274
00:18:34,300 --> 00:18:36,020
هذا ممل جدًّا

275
00:18:36,020 --> 00:18:37,090
تكرار المشهد مجدّدًا

276
00:18:37,090 --> 00:18:38,930
أنتِ مملّة

277
00:18:40,030 --> 00:18:41,680
!سوف أسحقك أيتها الكائنات الدونية

278
00:18:44,230 --> 00:18:46,410
عمّاذا كانا يتحدّثان أساسًا؟

279
00:18:46,410 --> 00:18:47,550
هل هما غبيّان؟

280
00:18:47,550 --> 00:18:48,890
هذه مشكلة القردة

281
00:18:56,130 --> 00:18:59,360
أنت، فيمَ تفكّر؟

282
00:19:00,690 --> 00:19:01,490
آسف

283
00:19:01,930 --> 00:19:05,620
لم أقصد اعتراض طريقك

284
00:19:07,590 --> 00:19:11,700
لمَ كنت تلاحقني طوال اليوم؟

285
00:19:11,700 --> 00:19:14,130
لقد كنت تلاحقني طوال الوقت

286
00:19:14,130 --> 00:19:16,420
خلتُ أنّك قد تقتلني في أيّ لحظة

287
00:19:16,420 --> 00:19:18,730
وكانت هذه النتيجة

288
00:19:18,730 --> 00:19:20,050
فسّر

289
00:19:20,050 --> 00:19:24,430
كان لديّ عملٌ في المكان
الذي أردت الذهاب إليه

290
00:19:24,430 --> 00:19:27,870
،لذا أردتُ القيام بالأمور بأكبر تستّر ممكن

291
00:19:27,870 --> 00:19:29,750
فلاحقتك

292
00:19:29,750 --> 00:19:31,940
أظنّ أنّ ذلك زاد الطينة بلّة

293
00:19:32,660 --> 00:19:35,900
،لكن أفترض أنّ الجانب المشرق

294
00:19:36,370 --> 00:19:38,900
هو أنّ هذا ما زال يمكن إصلاحه

295
00:19:43,420 --> 00:19:45,650
أوتظنّ أنّك تستطيع الإفلات منّي

296
00:19:45,650 --> 00:19:48,790
بهذا الكلام بعد أن تدخّلتَ في شأني لأجل مصالحك؟

297
00:19:50,930 --> 00:19:53,170
إن أردت أن تعتذر، أخبرني بشيءٍ واحد

298
00:19:53,610 --> 00:19:57,500
ماذا كنت أنت وشبيني تفعلان سرًّا؟

299
00:19:57,990 --> 00:20:02,470
بدا وكأنّك أردت إسكاته فحسب

300
00:22:09,580 --> 00:22:11,270
وا عجباه

301
00:22:11,270 --> 00:22:14,470
الأجناس التي تتصرّف وفق
غريزتها يصعب التعامل معها

302
00:22:14,470 --> 00:22:15,600
حسنًا

303
00:22:15,600 --> 00:22:20,270
لقد كنّا نبحث في أمر سلالة سونينكيند

304
00:22:20,270 --> 00:22:21,190
ماذا؟

305
00:22:21,190 --> 00:22:25,310
لقد فعّل الصليب المعقوف لبرلين مرّةً

306
00:22:25,310 --> 00:22:27,150
تذكره، أليس كذلك؟

307
00:22:27,150 --> 00:22:32,490
لقد امتصّ إيزاك من قبل السيّد
هايدريخ وأصبح قلب فالهالا

308
00:22:32,570 --> 00:22:35,890
لقد كانت أمّه ليزا برينر

309
00:22:35,890 --> 00:22:39,860
بي، هل تذكر أنّه كان لإيزاك أخًا؟

310
00:22:39,860 --> 00:22:41,000
أجل

311
00:22:41,000 --> 00:22:42,770
توأم، صحيح؟

312
00:22:42,770 --> 00:22:44,500
يوهان على ما أظن

313
00:22:44,860 --> 00:22:47,230
سمعتُ أنّه قد مات

314
00:22:48,550 --> 00:22:49,450
...لا يعقل

315
00:22:49,450 --> 00:22:50,610
أجل

316
00:22:50,610 --> 00:22:52,640
يوهان قد نجا

317
00:22:52,640 --> 00:22:55,590
لقد كذبت ليزا بشأن موته

318
00:22:55,590 --> 00:22:59,090
لا بدّ أنّها لم ترد رؤيته يُضحّى به

319
00:22:59,090 --> 00:23:01,980
...بعبارة أخرى، كان هناك سونينكيند آخر

320
00:23:01,980 --> 00:23:05,710
إذًا، أين تلك السلالة الآن؟

321
00:23:07,900 --> 00:23:09,300
فهمت

322
00:23:09,300 --> 00:23:11,280
هذا ما في الأمر إذًا؟

323
00:23:11,280 --> 00:23:12,900
...بمفهومٍ آخر

324
00:23:12,900 --> 00:23:13,780
أجل

325
00:23:13,780 --> 00:23:16,620
سوف أستخدم كلّ القطع المتوفرة إليّ

326
00:23:16,620 --> 00:23:21,830
تلك هي العدالة التي يجب أن
أطبّقها كوني قائدنا الفعليّ

327
00:23:34,970 --> 00:23:41,250
رسم:        وينغهارت