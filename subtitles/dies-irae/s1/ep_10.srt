1
00:00:15,230 --> 00:00:17,540
نسخ الرّمح المقدّس

2
00:00:18,070 --> 00:00:19,180
،أثناء الحرب العظمى

3
00:00:19,180 --> 00:00:21,870
،جدّي الأكبر، بعد أن تمّت دعوته إلى ألمانيا

4
00:00:21,870 --> 00:00:23,950
كُلّف بتلك المهمّة

5
00:00:28,330 --> 00:00:31,130
لكنّ ذلك ليس غريبًا على وجه الخصوص

6
00:00:32,300 --> 00:00:35,720
،من أجل حماية السيوف الشهيرة من الاهتراء والسّرقة

7
00:00:35,720 --> 00:00:38,120
اُستخدم النّسخ كثيرًا في العموم

8
00:00:39,680 --> 00:00:41,890
بالأحرى كانت إجراءات احترازية

9
00:00:42,990 --> 00:00:44,720
إلّا أنّه كان هنالك سوء تقدير

10
00:00:45,330 --> 00:00:50,320
أو بالأحرى، لعلّ ذلك كان مخطّطًا من البداية

11
00:00:54,650 --> 00:00:57,820
لقد كان جدّي الأكبر متفوّقًا للغاية

12
00:00:59,200 --> 00:01:01,650
فأصبحت النّسخة أكثر من مجرّد نسخة

13
00:01:01,650 --> 00:01:05,660
والرمح المقدّس الذي زوّره استحوذ عليه وقتله

14
00:01:16,190 --> 00:01:18,740
مؤسّس الحدادة، توبال كاين

15
00:01:19,690 --> 00:01:21,970
لقد مُنِح ألقابًا كتلك

16
00:01:23,900 --> 00:01:26,500
منذ ذلك الحين، استُحوِذَ أفراد سلالة ساكوراي

17
00:01:26,500 --> 00:01:28,800
،من قبل ذلك السيف

18
00:01:28,800 --> 00:01:31,240
وأصبحوا جزءاً من الطّاولة السّوداء المستديرة

19
00:01:32,370 --> 00:01:36,700
،ومع أنّ أرواحهم امتصّت
جثثهم ما زالت تتحرّك

20
00:01:36,700 --> 00:01:39,450
،وعندما يضمحلّون، ينتقل الرمح إلى الساكوراي القادم

21
00:01:39,450 --> 00:01:42,240
إنّه إجراءٌ لا ينتهي أبدًا

22
00:01:44,110 --> 00:01:45,980
سيحين دوري

23
00:01:46,550 --> 00:01:50,050
لكنّ أحدهم حاول مرّةً أن يبعدني عن ذلك المصير

24
00:01:51,050 --> 00:01:53,980
لستِ بحاجةٍ للقلق بشأن أيّ شيء يا كي

25
00:01:54,310 --> 00:01:56,170
سأنهي كلّ هذا

26
00:01:57,160 --> 00:01:59,290
ستكونين سعيدة

27
00:01:59,870 --> 00:02:01,330
أعدك

28
00:02:01,330 --> 00:02:02,260
مفهوم؟

29
00:02:02,260 --> 00:02:03,460
أجل

30
00:02:03,460 --> 00:02:05,640
كاي وبياتريس، أحبّكما

31
00:02:05,640 --> 00:02:08,210
!أريد أن أظلّ معكما إلى الأبد

32
00:02:10,190 --> 00:02:11,530
...إنّه يحبطني

33
00:02:11,530 --> 00:02:14,610
غبائي حينها

34
00:02:15,330 --> 00:02:17,280
لم أكن أعلم أيّ شيء

35
00:02:18,070 --> 00:02:22,790
دون أيّ أساسٍ منطقيّ، اعتقدتُ
أنّ كلّ شيءٍ سيظلّ على حاله

36
00:02:23,710 --> 00:02:27,820
وما عرفته تاليًا هو اختفاء من أحببت

37
00:02:29,890 --> 00:02:33,080
لهذا أردتُ أن أسترجع كلّ شيء

38
00:02:33,550 --> 00:02:37,940
،أردتُ أن أراهما مجدّدًا
!مهما كانت التضحية

39
00:02:40,230 --> 00:02:41,670
أحبّهما

40
00:02:43,060 --> 00:02:46,290
...أخي... بياتريس

41
00:04:20,690 --> 00:04:22,910
وا عجبي، يا لها من مشكلة

42
00:04:22,910 --> 00:04:26,330
زاميل قد ظهرت

43
00:04:26,700 --> 00:04:29,330
فلنوقف القتال مؤقتًا يا ريزا

44
00:04:29,330 --> 00:04:31,790
لا نملك الوقت لهذا

45
00:04:36,750 --> 00:04:41,750
يبدو أنّها أمرت بفتح الصليب المعقوف الخامس

46
00:04:41,750 --> 00:04:44,440
تمّ تحديد الهدف

47
00:04:44,440 --> 00:04:45,680
انظري

48
00:04:46,990 --> 00:04:49,500
أنت مستهدفة

49
00:04:49,500 --> 00:04:53,600
اقترفي خطأً واحدًا وستضغط زاميل على الزناد

50
00:04:54,230 --> 00:04:57,130
لكنّي متواريٌ عن الأنظار حتّى الآن

51
00:04:57,130 --> 00:04:58,090
...بقولي هذا

52
00:04:58,090 --> 00:05:01,370
تريدني أن أدعك تحمي حفيدة يوهان؟

53
00:05:01,370 --> 00:05:02,410
صحيح

54
00:05:02,880 --> 00:05:03,940
ما رأيك؟

55
00:05:03,940 --> 00:05:05,220
لن يحدث

56
00:05:06,790 --> 00:05:08,130
ولمَ لا؟

57
00:05:08,130 --> 00:05:11,010
ألا تثقين بي؟

58
00:05:11,580 --> 00:05:13,060
،أبسبب زاميل

59
00:05:13,410 --> 00:05:17,960
تريدين أن تتعاندي وتقولي كلّ هذا؟

60
00:05:18,980 --> 00:05:20,130
يا للسخف

61
00:05:20,610 --> 00:05:23,630
حريّ بكِ أن تكوني أذكى من هذا

62
00:05:24,100 --> 00:05:27,760
كم من شخصٍ تركته يموت بسبب ذلك؟

63
00:05:29,330 --> 00:05:33,920
أيها الأب، لم تعد تعرف كيف يشعر الغير، أليس كذلك؟

64
00:05:37,060 --> 00:05:41,990
،سابقًا، كنتَ ضعيفًا ومثيرًا للشّفقة بعض الشّيء

65
00:05:41,990 --> 00:05:43,640
لكنّي أحببتُ ذلك فيك نوعًا ما

66
00:05:44,330 --> 00:05:46,480
لقد كنتَ إنسانًا بحق

67
00:05:47,700 --> 00:05:52,560
،لكن أعلم أنّ ذلك الجزء فيك قد أخجلكَ تمامًا

68
00:05:53,090 --> 00:05:55,200
لكن لمَ حدث هذا؟

69
00:05:56,130 --> 00:05:58,460
ليس لكِ الحقّ في قول ذلك لي

70
00:05:59,790 --> 00:06:03,800
أجل. كلانا غبيّان

71
00:06:04,240 --> 00:06:07,320
من التعجرفِ أن نحسبَ أنّنا نستطيع حماية الآخرين

72
00:06:08,240 --> 00:06:09,460
...لهذا

73
00:06:13,810 --> 00:06:17,890
واجب فوجي-كُن هو أن يحمي حفيدة يوهان

74
00:06:18,650 --> 00:06:21,340
على خلافك، لستُ حثالة

75
00:06:23,200 --> 00:06:25,850
الرّجال يحمون النّساء

76
00:06:26,460 --> 00:06:28,200
الأمر بتلك البساطة، أليس كذلك؟

77
00:06:29,660 --> 00:06:32,690
ابقَ هناك وكن مطيعًا

78
00:06:33,550 --> 00:06:35,280
سوف أترك عيني

79
00:06:35,690 --> 00:06:38,130
إن تحرّكت، سيهاجمك كاين

80
00:06:38,850 --> 00:06:43,330
حتّى أنت لا تستطيع أن تخفي نفسك عندما تقاتل

81
00:06:45,630 --> 00:06:47,050
انتظري يا ريزا

82
00:06:49,930 --> 00:06:51,390
...هذا

83
00:06:57,260 --> 00:06:59,570
ما الذي تحاولين فعله يا برينر؟

84
00:07:00,490 --> 00:07:01,830
لا يهم

85
00:07:04,190 --> 00:07:05,680
قفي يا فتاة

86
00:07:05,980 --> 00:07:07,730
أمنحك الإذن بالحراك

87
00:07:08,470 --> 00:07:11,850
،يبدو أنّ تلك الحقيرة تريد أن تتكلّم

88
00:07:11,850 --> 00:07:14,830
لكنّي لن أصغي لها

89
00:07:14,830 --> 00:07:17,220
تكفّلي أنتِ بالأمر

90
00:07:18,510 --> 00:07:19,610
حاضر

91
00:07:23,850 --> 00:07:28,280
والآن يا فتى... أخبرتك أن تذهب

92
00:07:28,950 --> 00:07:31,290
لن يحدث أيّ شيء إن بقيتَ واقفًا هناك فحسب

93
00:07:31,660 --> 00:07:35,900
أم تراكَ تريد أن ترى ما أستطيع فعله أوّلًا؟

94
00:07:38,490 --> 00:07:39,850
!غرائزك جيّدة

95
00:07:39,850 --> 00:07:41,520
أنت ناجح في الوقت الرّاهن

96
00:07:43,350 --> 00:07:45,130
هل ستهرب فحسب؟

97
00:07:51,320 --> 00:07:53,180
ألا تملك شيئًا؟

98
00:07:53,490 --> 00:07:55,850
لا تخيّبني

99
00:07:57,930 --> 00:08:04,000
إن كنتَ تريد قتال السيّد هايدريخ بغباء
في حالتك تلك فيجب أن تموت بدلًا من ذلك

100
00:08:04,650 --> 00:08:09,200
،كُلِّفتُ بجعلك أقوى
لا أن أدعك على قيد الحياة

101
00:08:16,680 --> 00:08:19,860
فلنرَ إن كنتَ تستطيع النجاة من هذا

102
00:08:19,860 --> 00:08:20,880
انطلق

103
00:08:35,850 --> 00:08:37,680
شكرًا على إظهارك لي هذا

104
00:08:37,680 --> 00:08:39,790
!حماسك رائع

105
00:08:40,770 --> 00:08:42,730
لكن، هذه مشكلة

106
00:08:43,100 --> 00:08:46,210
لن تستطيع المتابعة هكذا

107
00:08:48,170 --> 00:08:50,460
انهض يا فتى

108
00:08:51,030 --> 00:08:54,050
فالسيّد هايدريخ ليس طيّبًا مثلي

109
00:08:54,470 --> 00:08:57,120
إن كنتَ بطلًا، اجعل المستحيل ممكنًا

110
00:08:57,120 --> 00:09:00,430
إمّا أن تعوّل على أجنحتك في الصّعاب أم لا

111
00:09:00,430 --> 00:09:04,810
هنالك نوعان من الأشخاص لا أكثر

112
00:09:08,720 --> 00:09:11,480
فهمت ما في الأمر

113
00:09:17,910 --> 00:09:21,090
مجيء ملاك للتغلّب على الوضع الرّاهن

114
00:09:22,130 --> 00:09:23,660
هذا يفلح أيضًا

115
00:09:24,060 --> 00:09:27,540
لأجل أن تكون بطلًا، أنت بحاجةٍ إلى حبِّ إلهة

116
00:09:27,930 --> 00:09:30,490
ها قد التقينا مجدّدًا أيتها الأميرة

117
00:09:31,510 --> 00:09:34,090
أنا أعمل كإحدى الحرّاس الشخصيّين للسيّد هايدريخ

118
00:09:34,090 --> 00:09:37,470
اسمي إليونور فون بيتينبورغ

119
00:09:38,710 --> 00:09:41,790
لقد قاطعتنا بذلك التعبير على وجهك

120
00:09:41,790 --> 00:09:45,100
ما غايتك هنا يا ترى؟

121
00:10:05,090 --> 00:10:08,460
تراجعي، لن أسمح لكِ بمسّه بأيّ مكروه

122
00:10:10,030 --> 00:10:11,370
فهمت

123
00:10:11,370 --> 00:10:15,490
أيعني هذا أنّك ستواجهيننا جميعًا؟

124
00:10:15,490 --> 00:10:17,980
كلّا، بل أنت فقط

125
00:10:17,980 --> 00:10:20,720
أنتِ الوحيدة التي تبتغي القتال

126
00:10:25,090 --> 00:10:27,580
صحيح، لقد أصبتِ

127
00:10:27,580 --> 00:10:29,770
يبدو لي الوضع كذلك أيضًا

128
00:10:30,980 --> 00:10:35,970
الحلفاء الذين لا يملكون العزيمة للقتال
في ساحة المعركة هم أسوأ من الأعداء

129
00:10:36,680 --> 00:10:38,110
...والآن، ما العمل

130
00:10:39,540 --> 00:10:42,060
الأمر أمركِ هنا

131
00:10:42,060 --> 00:10:44,030
وسأتّبع أوامرك

132
00:10:44,030 --> 00:10:45,700
لا أملك رأيًا

133
00:10:47,100 --> 00:10:48,950
سمعتِ ما قالته

134
00:10:48,950 --> 00:10:51,670
وماذا عنك يا برينر؟

135
00:10:53,580 --> 00:10:58,840
،لم تكوني هنا من البداية أساسًا
بيد أنّكِ تملين الأوامر؟

136
00:10:58,840 --> 00:11:00,720
لا تتدخّلي في هذا يا إليونور

137
00:11:01,930 --> 00:11:04,470
ليون، إنها خالدة

138
00:11:05,310 --> 00:11:07,700
أثناء المباركة الذهبية، كلّ ما يمكن أن يحدث

139
00:11:07,700 --> 00:11:10,230
هو إمّا الانبعاث أو صنعُ خالد

140
00:11:10,910 --> 00:11:15,610
ضحّت إليونور ببرلين وتحقّقت رغبتها بالفعل

141
00:11:17,630 --> 00:11:20,610
لذا لا يمكنني أن أدعك تفعلين أيّ شيءٍ مزعجٍ هنا

142
00:11:21,030 --> 00:11:24,170
كلّ الأرواح البشرية هنا ملكي

143
00:11:24,660 --> 00:11:27,490
لم تعودي بحاجةٍ إليها، أليس كذلك؟

144
00:11:27,990 --> 00:11:31,860
هذا صحيح. إن كان اختياري فلستُ بحاجةٍ لها حقًّا

145
00:11:33,020 --> 00:11:35,510
...إلّا أنّ السيّد هايدريخ أخبرني

146
00:11:36,240 --> 00:11:39,510
أنّه يريد منّي فتح الصليب المعقوف الخامس

147
00:11:41,690 --> 00:11:43,640
لا، توقفي... هذا ليس مثيرًا للاهتمام إطلاقًا

148
00:11:43,640 --> 00:11:45,100
لقد كنتُ عالقةً معك

149
00:11:45,100 --> 00:11:47,850
بوسعي أن أعرف ما تفكّرين

150
00:11:48,330 --> 00:11:50,590
،لا أفهم منطقكِ من هذا

151
00:11:50,590 --> 00:11:53,500
لكنّك لا تريدين أن يموت أحدهم هناك

152
00:11:54,090 --> 00:11:57,570
بصورة جليّة، لا تريدين أن
يُفجّر هذا المكان عن بكرة أبيه

153
00:11:59,070 --> 00:12:02,150
لكنّ ذلك لا يهمّني

154
00:12:03,860 --> 00:12:04,620
!انتظري

155
00:12:04,620 --> 00:12:05,710
اخرسي

156
00:12:06,260 --> 00:12:09,410
،الوقتُ متأخر قليلًا على قول هذا
لكنّي أكرهك

157
00:12:10,390 --> 00:12:11,330
...وأيضًا

158
00:12:12,310 --> 00:12:14,670
كيرخيايزن كانت هناك دائمًا لمنعنا من الشجار

159
00:12:14,670 --> 00:12:16,960
...لكنّها لم تعد هنا

160
00:12:20,500 --> 00:12:22,010
أيتها الصغيرة

161
00:12:22,530 --> 00:12:26,250
سأعطيك أمرًا حتّى شخصٌ غبيّ مثلك يستطيع فهمه

162
00:12:26,610 --> 00:12:29,090
إن تحرّكت تلك الغبيّة، اقتليها

163
00:12:30,000 --> 00:12:34,270
،إن أردتِ الصليب المعقوف الخامس
فلتقتلا بعضيكما يا برينر

164
00:12:34,600 --> 00:12:38,070
أنت معتادة على التخلّص من الأشقياء، صحيح؟

165
00:12:38,590 --> 00:12:42,420
،إن وجدتكِ هنا عند انتهائي

166
00:12:42,440 --> 00:12:45,100
سأحوّلكِ إلى رماد

167
00:12:46,950 --> 00:12:48,790
...وبالتّالي

168
00:12:49,080 --> 00:12:53,180
لأجل أن أجعل ذلك الرّجل يهيّج
،الأوضاع مع هاتين الغبيّتين

169
00:12:53,180 --> 00:12:55,310
أحتاج منه أن يبادر

170
00:12:55,950 --> 00:12:57,920
هلّا أيقظته؟

171
00:12:57,920 --> 00:13:00,090
كلّا. لن أفعل

172
00:13:00,810 --> 00:13:02,100
فهمت

173
00:13:02,440 --> 00:13:05,050
هكذا تنوين حمايته

174
00:13:06,570 --> 00:13:10,310
...لكن، أريد أن أسألكِ شيئًا

175
00:13:10,710 --> 00:13:15,060
أتعين حقًّا ما معنى القتال؟

176
00:13:26,110 --> 00:13:28,300
ألم تنصتي؟

177
00:13:28,300 --> 00:13:30,320
أنا خالدة

178
00:13:33,500 --> 00:13:35,820
لا تملكين النيّة للقتل

179
00:13:35,820 --> 00:13:37,230
ولستِ جاهزة لفعل ذلك

180
00:13:37,660 --> 00:13:39,790
،على حالك

181
00:13:39,790 --> 00:13:42,880
لا تستطيعين قتلي، محاربة فالهالا

182
00:13:43,850 --> 00:13:48,510
إ... إنّما أريد أن أصبح الخامسة

183
00:13:48,960 --> 00:13:52,100
لذا لا أريد أن يذهب رين

184
00:13:52,100 --> 00:13:54,220
كاسومي هنا أيضًا

185
00:13:54,220 --> 00:13:55,490
!إنّي أهتمّ لهما

186
00:13:59,870 --> 00:14:03,480
،تريدين أن تكوني قريبةً منه
لهذا تظلّين معه؟

187
00:14:03,480 --> 00:14:05,400
يا للسخف

188
00:14:05,400 --> 00:14:08,610
لم تدفعي أيّ شيء بعد

189
00:14:09,950 --> 00:14:13,660
،إن كان هناك مستقبل تبتغينه
أظهري بعض العزيمة اللّازمة

190
00:14:16,020 --> 00:14:20,000
عملي هو أن أشحذ السّيف الذي سأقدّمه إلى سيّدي

191
00:14:23,430 --> 00:14:25,250
لا تنكسري

192
00:14:25,940 --> 00:14:28,080
والآن، أريني

193
00:14:32,410 --> 00:14:33,450
هذا مؤلم

194
00:14:33,980 --> 00:14:35,170
...هذا مؤلم

195
00:14:35,170 --> 00:14:36,220
هذا مؤلم

196
00:14:37,290 --> 00:14:41,980
رين، لقد كنتَ تحتمل هذا

197
00:14:43,650 --> 00:14:47,690
أنا آسفة، لم أفهم أيّ شيء

198
00:14:47,690 --> 00:14:49,990
جعلتك تتعامل مع كلّ شيء

199
00:14:51,300 --> 00:14:53,280
كيف لك أن تعمل بجدّ هكذا؟

200
00:14:53,690 --> 00:14:55,560
كيف لك أن تحتمل كلّ هذا؟

201
00:14:57,020 --> 00:14:58,450
...أخبرني

202
00:15:02,990 --> 00:15:04,790
سأنصت

203
00:15:05,670 --> 00:15:09,580
أريد... أن أكون مثلك

204
00:15:15,890 --> 00:15:18,770
لقد استيقظت. كيف تشعر؟

205
00:15:19,090 --> 00:15:20,420
...اللعنة عليك

206
00:15:20,420 --> 00:15:23,240
كيف تجرؤين على ضرب فتاتي؟

207
00:15:23,240 --> 00:15:24,920
!سأقتلك

208
00:15:25,950 --> 00:15:27,900
أعتذر على ذلك

209
00:15:27,900 --> 00:15:30,610
لقد كان جزءًا من أوامر سيّدي

210
00:15:30,610 --> 00:15:33,070
يبدو أنّ ذلك أفلح مع ذلك

211
00:15:37,630 --> 00:15:40,250
ماري، أنا آسف

212
00:15:40,250 --> 00:15:41,740
لقد أُذيتِ بسببي

213
00:15:42,140 --> 00:15:43,580
واثقٌ أنّ ذلك مؤلم

214
00:15:43,580 --> 00:15:47,170
...لا... على الإطلاق

215
00:15:48,870 --> 00:15:50,140
رين

216
00:15:51,860 --> 00:15:53,590
...فلنقاتل سويًّا

217
00:15:53,970 --> 00:15:55,690
ولننتصر

218
00:15:55,690 --> 00:15:58,100
سأحميك

219
00:16:01,870 --> 00:16:04,510
!لا تجرئي على ضرب رجلي

220
00:16:04,510 --> 00:16:06,400
!سأقتصّ منك

221
00:16:21,550 --> 00:16:24,900
إذًا... ماذا تفعلين؟

222
00:16:25,830 --> 00:16:27,320
لا شيء على وجه الخصوص

223
00:16:27,830 --> 00:16:30,090
إنّما أتّبع الأوامر

224
00:16:31,430 --> 00:16:33,650
فكّري بالوضع قليلًا

225
00:16:34,210 --> 00:16:36,720
على هذا المعدّل، سيموت الجميع

226
00:16:37,510 --> 00:16:39,440
إليانور تشحن نفسها

227
00:16:40,030 --> 00:16:41,730
ذلك أشبه بعدٍّ تنازليّ

228
00:16:44,350 --> 00:16:48,060
هل كانت زاميل قريبة من بياتريس؟

229
00:16:48,060 --> 00:16:50,820
نعم، لقد كانت قائدتها المباشرة

230
00:16:51,290 --> 00:16:53,650
لقد كانتا كشقيقتين

231
00:16:54,080 --> 00:16:57,950
لذا لا تملكين أفضل انطباع

232
00:16:58,900 --> 00:17:00,580
أسرعي واهربي

233
00:17:02,070 --> 00:17:04,770
لقد قمت بسلّ سيفي الآن

234
00:17:04,770 --> 00:17:08,460
فما الذي يضمن لي أنّك لن تهاجميني؟

235
00:17:08,950 --> 00:17:10,590
لا تملكين أيّ إيمان

236
00:17:11,820 --> 00:17:14,930
إذًا، يجب أن أخبرك ببساطة

237
00:17:14,930 --> 00:17:18,790
الأب هنا أيضًا

238
00:17:19,460 --> 00:17:23,780
لقد تركتُ وسيلتي للهجوم كاين معه

239
00:17:23,780 --> 00:17:24,480
ماذا؟

240
00:17:28,490 --> 00:17:30,980
لم تصل في الوقت المناسب يا فتى

241
00:17:31,490 --> 00:17:34,940
والآن، هل تستطيع احتمال هذا؟

242
00:17:35,910 --> 00:17:36,530
الآن

243
00:17:40,180 --> 00:17:41,020
ماذا؟

244
00:17:41,530 --> 00:17:46,770
قلتُ أنّ من المهمّ من ينقذ من

245
00:17:50,590 --> 00:17:52,830
...أنا آسفة يا فوجي-كُن

246
00:17:53,730 --> 00:17:56,140
،رغبتي أنانية

247
00:17:56,990 --> 00:18:00,600
لكن أريد منك أن تنقذ ريا أيضًا

248
00:18:08,590 --> 00:18:09,590
كاسومي؟

249
00:18:10,930 --> 00:18:12,110
...لمَ

250
00:18:17,870 --> 00:18:20,030
هذا ما يجري إذًا

251
00:18:20,610 --> 00:18:22,950
لقد استخففتِ بي يا برينر

252
00:18:25,160 --> 00:18:27,660
!كما ترغبين، سأفجّر كلّ شيء

253
00:18:31,130 --> 00:18:36,170
إيزاك، يوهان، ريا

254
00:18:37,310 --> 00:18:41,230
أنا آسفة... يا أطفالي

255
00:18:43,500 --> 00:18:44,750
وداعًا

256
00:18:49,390 --> 00:18:51,270
!سينال منّا

257
00:18:51,610 --> 00:18:53,230
...كيف لي أن

258
00:18:57,860 --> 00:19:01,780
...الإنشاء والألوهية. رغبتي

259
00:19:03,740 --> 00:19:05,700
...أوقف الوقت

260
00:19:06,060 --> 00:19:08,410
!أوقفه

261
00:19:31,290 --> 00:19:32,750
أيها المتغطرس

262
00:19:32,750 --> 00:19:34,860
من سمح لك بالهرب؟

263
00:19:36,820 --> 00:19:39,000
تراجعي يا زاميل

264
00:19:52,590 --> 00:19:55,290
لقد أكملتِ مهمّتك

265
00:20:07,190 --> 00:20:08,310
مفهوم

266
00:20:08,780 --> 00:20:10,770
مفهوم يا صديقي

267
00:20:11,290 --> 00:20:13,980
لا أنوي أخذ فريستك

268
00:20:14,700 --> 00:20:17,960
أقرّ أنّني انجرفتُ قليلًا

269
00:20:17,960 --> 00:20:20,610
هذا طبعي فسامحني

270
00:20:21,030 --> 00:20:22,740
،بالمناسبة يا ماكينا

271
00:20:22,740 --> 00:20:24,320
ماذا حلّ بشرايبر؟

272
00:20:24,650 --> 00:20:26,940
واثقٌ أنّه مع سونينكيند

273
00:20:27,430 --> 00:20:31,200
ينوي السيّد هايدريخ فتح السّادس

274
00:20:31,200 --> 00:20:33,800
هذا مثير

275
00:20:35,090 --> 00:20:36,370
...انظر لذاك

276
00:20:36,370 --> 00:20:37,850
هنالك جرذ

277
00:20:38,300 --> 00:20:41,630
إنّه الوحيد الذي يستطيع احتمال نيراني

278
00:20:42,380 --> 00:20:45,480
...ماذا أفعل بشأنه يا ترى

279
00:20:49,110 --> 00:20:50,170
...وا عجبي

280
00:20:50,170 --> 00:20:52,590
يبدو أنّي قد فُضِحت

281
00:20:52,590 --> 00:20:54,460
فوجي-كُن، رأيت ذلك أيضًا، صحيح؟

282
00:20:54,460 --> 00:20:56,730
إنّهما يعملان بقربٍ من السيّد هايدريخ

283
00:20:57,120 --> 00:21:01,160
أشبه بعدوّاي الزائلين

284
00:21:02,590 --> 00:21:04,530
على أيّ حال، فلنتحرّك

285
00:21:05,960 --> 00:21:08,340
أرغب بتشكيل تحالفٍ معك

286
00:21:10,080 --> 00:21:12,030
سأخبرك بكلّ شيء

287
00:21:14,090 --> 00:21:16,040
ريزا قد ماتت

288
00:21:18,410 --> 00:21:21,880
لمَ لا نأخذ بثأرنا معًا؟

289
00:23:35,010 --> 00:23:41,250
رسم:          شينوتسكي شينوبو