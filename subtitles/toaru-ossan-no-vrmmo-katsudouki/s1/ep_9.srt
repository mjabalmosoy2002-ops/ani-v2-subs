1
00:01:42,820 --> 00:01:46,610
آرث، هل سمعت الأنباء عن الحملة
الإعلانيّة الجديدة؟

2
00:01:47,790 --> 00:01:50,540
أجل، إنّها رهيبة

3
00:01:50,540 --> 00:01:52,290
ماذا؟ أي حملة؟

4
00:01:52,290 --> 00:01:54,030
ماذا؟ لا تعلمين؟

5
00:01:54,030 --> 00:01:57,730
صدرت أربعة ألعاب واقع افتراضي الآن

6
00:01:58,470 --> 00:02:01,580
،هناك حياة حرّة إضافيّة"، لكن لعبة قتاليّة أيضاً

7
00:02:02,970 --> 00:02:05,660
،ولعبة رماية منظور شخص أوّل

8
00:02:07,050 --> 00:02:08,840
ولعبة آليّين

9
00:02:10,450 --> 00:02:14,760
حتّى الآن جميعها تحتاج خوذة
،واقع افتراضي خاصّة بها

10
00:02:15,150 --> 00:02:20,120
،لكن جميعها بحاجة لمزيد من اللّاعبين
لذلك تعاون النّاشرون معاً

11
00:02:21,500 --> 00:02:24,700
حتّى تصبح كلّ الألعاب قابلة للّعب بأي خوذة

12
00:02:24,700 --> 00:02:26,010
هكذا إذاً

13
00:02:26,290 --> 00:02:33,570
وهكذا بدؤوا بحملة إعلانيّة كبيرة
لتجربة مجّانية مدّتها 15 يوماً

14
00:02:34,920 --> 00:02:41,210
وسيضيفون مملكة الجنّيات في "حياة
حُرّة إضافيّة" منذ اليوم الأوّل

15
00:02:42,550 --> 00:02:48,020
ستحصل الألعاب الأربعة كلّها
على لاعبين أكثر بكثير

16
00:02:49,270 --> 00:02:50,430
!مؤلم

17
00:02:50,430 --> 00:02:52,070
!هذه للزبائن

18
00:02:52,070 --> 00:02:55,250
،سأضرب أيّ شخص يلمسها
!وبمن في ذلك أنت يا زوفاي

19
00:02:55,250 --> 00:02:56,950
!ضربتني بالفعل

20
00:02:57,300 --> 00:02:58,870
نورا

21
00:02:59,400 --> 00:03:01,340
هذه لكِ

22
00:03:04,200 --> 00:03:06,920
،تحسُّباً لقيام زوفاي بأيّ عمل أخرق

23
00:03:06,920 --> 00:03:09,520
يمكنني أن أضربه ضرباً مُبرِحاً، صحيح؟

24
00:03:10,560 --> 00:03:12,140
لماذا تفعلين هذا؟

25
00:03:13,830 --> 00:03:15,450
أعتمد عليكِ

26
00:03:15,450 --> 00:03:16,510
حسناً

27
00:03:17,540 --> 00:03:20,480
،إذا كان سيأتي هذا العدد الكبير من اللّاعبين الجُدد

28
00:03:20,480 --> 00:03:25,080
يجب على كافّة النّقابات الاستعداد لمحاولة ضمّهم

29
00:03:25,080 --> 00:03:27,780
اسمعي، ضعي هذا جانباً

30
00:03:27,780 --> 00:03:30,880
أتعتقد أنّنا ينبغي أن نبدأ بضمّ أعضاء أيضاً؟

31
00:03:31,210 --> 00:03:35,230
أعتقد بوسعنا أن نكون نقابة متوسّطة
الحجم جيّدة لو أردنا ذلك

32
00:03:35,510 --> 00:03:39,450
،أوّلاً، علينا الحرص على ضبط إليزا

33
00:03:39,450 --> 00:03:41,910
وإلّا سيواجه الأعضاء الجدُد وقتاً عصيباً

34
00:03:41,910 --> 00:03:43,650
إليزا؟

35
00:03:50,820 --> 00:03:53,900
أنقذَها آرث قبل أيّام، صحيح؟

36
00:03:56,160 --> 00:04:00,290
اسمع يا آرث، ما رأيك أن تنضمّ لنقابتنا؟

37
00:04:03,530 --> 00:04:04,710
لا

38
00:04:04,710 --> 00:04:06,650
لماذا؟

39
00:04:06,650 --> 00:04:09,360
أنا آسف لأنّني أظلّ أرفضكم
في كلّ مرّة تطلبون

40
00:04:11,510 --> 00:04:15,930
لكن على أيّ حال... جزء من الأمر
هو أنّني أريد أن أقوم بعملي

41
00:04:17,350 --> 00:04:21,580
لكن هناك بعض الأشياء أفضّل
ألّا يعلم عنها اللّاعبون الآخرون

42
00:04:22,190 --> 00:04:25,310
...الملكة وأختها على سبيل المثال

43
00:04:30,240 --> 00:04:32,470
أداة جديدة لذخيرتك؟

44
00:04:32,470 --> 00:04:35,720
ربّما سأكون أوّل من يتناول قضمة

45
00:04:36,990 --> 00:04:39,140
هذا شيء جديد أصنعه للزبائن

46
00:04:39,140 --> 00:04:40,260
!لا تأكليه

47
00:04:40,940 --> 00:04:42,950
أنت لئيم

48
00:04:42,950 --> 00:04:43,880
من أنتِ؟

49
00:04:44,190 --> 00:04:49,060
أتريدني أن أرى هذا اللّحم الشهيّ ولا آكله؟

50
00:04:49,060 --> 00:04:50,960
اسمعي يا ريو

51
00:04:50,970 --> 00:04:52,140
ريو؟

52
00:04:51,390 --> 00:04:54,830
،إذا سمحتُ لكِ بالبدء في الأكل
!ستأكلين 15 من هذه الشّرائح

53
00:04:54,830 --> 00:04:56,420
!أنتِ شرِهة

54
00:04:56,420 --> 00:04:58,490
من تنعته بالشّرِه؟

55
00:04:58,490 --> 00:05:00,340
هذا صحيح، أليس كذلك؟

56
00:05:00,340 --> 00:05:02,630
!سوف تندم على قول ذلك

57
00:05:02,900 --> 00:05:04,810
...المعذرة

58
00:05:05,840 --> 00:05:07,730
من تكونين؟

59
00:05:08,060 --> 00:05:11,560
...لم أرَ زيّاً كهذا من قبل

60
00:05:11,560 --> 00:05:12,750
ملابس يابانيّة؟

61
00:05:12,750 --> 00:05:16,160
ولا تبدين كجنّية

62
00:05:17,580 --> 00:05:19,030
...في الحقيقة

63
00:05:20,510 --> 00:05:21,620
!آرث

64
00:05:21,620 --> 00:05:23,500
،لا تقل لي أنّ الملكة لم تكن كافية لك

65
00:05:23,500 --> 00:05:25,490
فاستهدفتنا أيضاً؟

66
00:05:25,490 --> 00:05:27,090
ماذا؟

67
00:05:27,090 --> 00:05:28,400
!أنا أغار كثيراً

68
00:05:28,400 --> 00:05:29,430
—ليتني أستطيع

69
00:05:32,800 --> 00:05:35,100
!لا تبدأ بأفكارك الغريبة أيضاً يا ريج

70
00:05:35,100 --> 00:05:36,590
!هذا مديح

71
00:05:36,590 --> 00:05:37,800
!اصمتا

72
00:05:38,220 --> 00:05:41,780
!إنّها عمليّاً تأكل كلّ ما لديّ من طعام

73
00:05:41,780 --> 00:05:44,730
!ليتني أستطيع إعطائكما إيّاها

74
00:05:44,730 --> 00:05:46,930
يبدوان مُقرّبين جدّاً

75
00:05:44,730 --> 00:05:47,090
هل يمكنني أكل هذه؟

76
00:05:47,090 --> 00:05:50,630
...حسناً

77
00:05:47,950 --> 00:05:51,950
أطلق عليها "ريو"، صحيح؟

78
00:05:53,160 --> 00:05:56,950
بالفعل. آرث الوحيد الّذي يستطيع
أن يناديني بهذا الاسم

79
00:05:57,670 --> 00:06:00,720
لا أنوي السّماح لأيّ شخص آخر فعل ذلك

80
00:06:02,070 --> 00:06:04,150
سأكتب هذا في منتدى اللّعبة

81
00:06:04,150 --> 00:06:08,170
إن فعلت، فلا أعتقد أنّني سوف
أطبخ لك من جديد

82
00:06:09,000 --> 00:06:15,070
،إذاً في البداية كان لعوب الجنّيات
والآن هو مُربِّي تنّينة؟

83
00:06:15,070 --> 00:06:16,890
يسلك طريقاً مُثيراً للاهتمام في الحياة

84
00:06:16,890 --> 00:06:17,930
بالفعل

85
00:06:18,890 --> 00:06:20,580
كفّوا عنّي يا جماعة

86
00:06:22,270 --> 00:06:26,360
ماذا سيحدث إذا رحتُ إلى مملكة
الجنّيات وأنا بهذا الشّكل؟

87
00:06:27,250 --> 00:06:31,990
تقع مملكة الجنّيات جنوب المدينة
الثّانية، نيكشيا

88
00:06:31,990 --> 00:06:35,200
هناك قلعة في وسطها، مع انتشار
،بلداتها على شكل صليب

89
00:06:35,200 --> 00:06:38,270
وحصون تعمل كنقاط تفتيش
في كلّ اتّجاه رئيسيّ

90
00:06:40,000 --> 00:06:44,270
!واليوم هو اليوم الّذي أُدخِلَتْ فيه للّعبة

91
00:06:45,620 --> 00:06:50,090
بالطبع، كثير من اللّاعبين في طريقهم إلى هناك

92
00:06:51,070 --> 00:06:54,170
الطريقة المعتادة للوصول إلى هناك هي المشي

93
00:06:54,590 --> 00:06:56,980
،بوجود كثير من النّاس المتوجّهين إلى نفس المكان

94
00:06:56,980 --> 00:06:59,390
،فذلك يعني أنّ الجميع لديهم شيء مُشترك

95
00:06:59,390 --> 00:07:02,110
ومن السّهل التكلّم مع أشخاص لم تلتقيهم أبداً

96
00:07:02,910 --> 00:07:05,320
هذا هو الحصن الشّمالي إذاً؟

97
00:07:05,320 --> 00:07:07,310
ذاك هو الحصن إذاً؟

98
00:07:07,310 --> 00:07:09,310
وصلنا أخيراً

99
00:07:12,860 --> 00:07:15,750
...إنّه ضخم

100
00:07:22,050 --> 00:07:23,170
...المعذرة

101
00:07:23,170 --> 00:07:24,040
نعم؟

102
00:07:24,040 --> 00:07:28,670
إن لم تمانع، أودّ أن ألقي نظرة عن كثب
إلى هذا الخاتم في يدك اليسرى

103
00:07:29,030 --> 00:07:32,940
ألم تذكر هي شيئاً عن أنّ هذا
الخاتم يؤدّي وظيفة عبور؟

104
00:07:33,250 --> 00:07:35,300
هذا؟

105
00:07:37,070 --> 00:07:40,270
هذا هو خاتم الملِكة، أجل

106
00:07:40,270 --> 00:07:42,670
أنت آرث إذاً

107
00:07:42,670 --> 00:07:44,840
سررتُ بلقائك

108
00:07:44,840 --> 00:07:48,820
أنا الرّجل المسؤول عن الحصن الشّماليّ

109
00:07:48,820 --> 00:07:50,690
هلّا تكلّمنا قليلاً؟

110
00:07:50,690 --> 00:07:52,270
هل هناك مشكلة؟

111
00:07:52,270 --> 00:07:57,430
طلبَتْ سموّها أن تُحضَر إليها فوراً

112
00:07:59,500 --> 00:08:01,900
!أحضره إلى هنا

113
00:08:01,900 --> 00:08:02,620
!حاضر

114
00:08:02,620 --> 00:08:03,830
ما الّذي يجري؟

115
00:08:03,830 --> 00:08:05,310
حدث؟

116
00:08:06,530 --> 00:08:08,570
...الجميع يحدّقون بي

117
00:08:21,710 --> 00:08:28,640
هذا بيكاشا، طائر يُسمَح لقلّة مختارة
من الجنّيات ركوبه فقط

118
00:08:28,640 --> 00:08:30,990
يسمح لك بالتنقّل بسرعة فائقة

119
00:08:30,990 --> 00:08:34,910
من فضلك بيكاشا هذا إلى بلدة القلعدة

120
00:08:34,910 --> 00:08:37,480
...يبدو هذا الرّيش المنفوش مُريحاً جدّاً

121
00:08:37,480 --> 00:08:38,920
كم أشعر بالغيرة

122
00:08:38,920 --> 00:08:41,240
لكن لن نتمكّن من ركوبه، صحيح؟

123
00:08:42,570 --> 00:08:44,510
...سأحاول تجاهل ذلك

124
00:08:44,910 --> 00:08:46,640
حسناً، شكراً

125
00:08:46,640 --> 00:08:48,180
!بيكاشا، شكراً على حملك لي

126
00:08:53,250 --> 00:08:55,340
!إنّه منفوش بالفعل

127
00:09:02,070 --> 00:09:05,680
وضعَ بيكاشا حاجزاً ليحجب الرِّياح؟

128
00:09:05,990 --> 00:09:08,330
الرّياح ليست شديدة كما توقّعتُ أن تكون

129
00:09:08,820 --> 00:09:12,600
!التّحليق هنا يُشعرني بأنّني في قصّة خيال حقيقيّة

130
00:09:13,040 --> 00:09:14,770
أتلك هي المدينة؟

131
00:09:33,830 --> 00:09:35,570
شارفتُ على الوصول

132
00:09:51,980 --> 00:09:53,360
!مرحباً

133
00:09:54,970 --> 00:09:59,770
أشكركِ على التّرحيب الدّافئ، جلالتك

134
00:10:00,970 --> 00:10:03,210
تبدو مُطمئِنّة

135
00:10:03,210 --> 00:10:06,770
تعلم أنّني لن أسخر منها في مكان كهذا

136
00:10:07,360 --> 00:10:10,630
حضّرنا موكباً صغيراً

137
00:10:11,390 --> 00:10:12,530
موكب؟

138
00:10:13,180 --> 00:10:15,080
!أنت النّجم

139
00:10:22,030 --> 00:10:23,640
!آمل أن تستمتعوا بذلك جميعكم كذلك

140
00:10:43,960 --> 00:10:46,690
،لا أحبّ أن أكون محطّ اهتمام

141
00:10:46,690 --> 00:10:49,480
لكن سيكون مضيعة للوقت أن أرفض
...وأنخرط في قتال

142
00:10:53,820 --> 00:10:56,350
ولا أكره ذلك مثلما ظننتُ أنّني سأفعل

143
00:11:04,730 --> 00:11:12,330
حتّى لو كانت لعبة، فقط قلّة من اللّاعبين
!سوف يخضعون لتجربة كهذه

144
00:11:12,870 --> 00:11:16,140
ولهذا ينبغي أن أحاول الاستمتاع قدر المستطاع

145
00:11:18,010 --> 00:11:21,070
هذا الخيال ليس حقيقة

146
00:11:22,080 --> 00:11:25,580
!لكن الذّكريات الّتي يخلّفها حقيقيّة

147
00:11:29,560 --> 00:11:31,720
أشكرك على التّرحيب الدّائم

148
00:11:32,250 --> 00:11:37,130
...لكن أعتقد بالغتِ قليلاً

149
00:11:37,130 --> 00:11:42,670
كانت الغاية من الموكب الحرص
على أن يعرف كلّ جنّي

150
00:11:42,670 --> 00:11:45,550
في المملكة بأنّك هنا

151
00:11:45,550 --> 00:11:50,120
!كانوا جميعهم ينتظروك

152
00:11:52,630 --> 00:11:56,900
وانتشرت إشاعات مفادها بأنّني أحتكرك لنفسي

153
00:11:58,160 --> 00:11:59,970
كانت تلك الإشاعات حقيقيّة

154
00:12:03,640 --> 00:12:04,420
!بئساً

155
00:12:13,120 --> 00:12:15,660
!ربّما سأستمرّ في احتكارك كلّك لنفسي

156
00:12:15,660 --> 00:12:17,090
!مهلاً

157
00:12:18,070 --> 00:12:20,480
سموّكِ، تحكّمي بنفسكِ

158
00:12:20,940 --> 00:12:26,520
بالطبع. سنقدّر أن تبقى في بلدنا لبعض الوقت

159
00:12:26,890 --> 00:12:32,320
،لن نفعل شيئاً لتعكير إقامتك
كتعيين مُرافِق أو مُراقِب

160
00:12:33,610 --> 00:12:35,290
حسناً

161
00:12:35,290 --> 00:12:39,510
ابتداء من الغد، سوف أعود إلى كوني مُغامراً عاديّاً

162
00:12:40,060 --> 00:12:44,870
سأعود إلى بلدة الحصن وأبدأ
في إلقاء نظرة محيطة

163
00:12:45,680 --> 00:12:49,010
إذاً بهذا، ينتهي اجتماعنا

164
00:12:52,130 --> 00:12:55,620
هذه أطول فترة قمتُ بتسجيل الدّخول فيها

165
00:12:59,200 --> 00:13:03,170
...حان وقت تسجيل الخروج و

166
00:13:05,610 --> 00:13:07,210
إلى أين أنت ذاهب؟

167
00:13:07,210 --> 00:13:10,720
كنتُ ذاهباً إلى النُّزُل للنوم

168
00:13:11,530 --> 00:13:14,640
إذاً ما رأيك أن ننام بجانب بعضنا
الآخر في سريري؟

169
00:13:22,660 --> 00:13:23,950
!انتظر

170
00:13:27,140 --> 00:13:28,840
!تبّاً

171
00:13:29,970 --> 00:13:33,490
!قفزتُ من النّافذة كلصّ

172
00:13:34,830 --> 00:13:39,070
...في الواقع، لديّ مهارة اللصّ الخيريّ

173
00:13:41,360 --> 00:13:47,350
بعد مغادرتي للقلعة، أوصلوني إلى بلدة
الحصن الجنوبي عبر بيكاشا

174
00:13:48,010 --> 00:13:50,590
...سبب اختياري للجانب الجنوبيّ

175
00:13:51,300 --> 00:13:54,190
،هل كان هذا الجانب الأبعد من نيكشيا

176
00:13:54,190 --> 00:13:57,370
ولهذا يوجد عدد أقلّ من اللّاعبين هنا

177
00:13:59,500 --> 00:14:03,710
!المعذرة! هزمتُ تلك الأرانب الرّفيعة الثّمانية

178
00:14:05,080 --> 00:14:07,220
هزمتهم بهذه السّرعة؟

179
00:14:07,220 --> 00:14:09,850
ظننتُ أنّ ذلك سيستغرق بضعة أيّام

180
00:14:09,850 --> 00:14:12,720
هل رأيت أي طيور لصّة؟

181
00:14:12,720 --> 00:14:13,980
!بالتّأكيد

182
00:14:14,370 --> 00:14:16,610
،بعد أن رميتُ على أرنب رفيع

183
00:14:17,130 --> 00:14:20,340
!حاول واحد سرقة فريستي أمام ناظري

184
00:14:20,840 --> 00:14:22,720
!لذا أسقطتُه

185
00:14:23,590 --> 00:14:25,670
!أنت مذهل حقّاً

186
00:14:26,430 --> 00:14:29,320
بالمناسبة، هل هناك مكان يمكنني
استخدامه للطبخ؟

187
00:14:30,040 --> 00:14:32,600
استخدم المطبخ في الخلف

188
00:14:32,810 --> 00:14:34,780
سأدفع لكِ الإيجار

189
00:14:34,780 --> 00:14:37,610
!كم أنت لطيف

190
00:14:38,090 --> 00:14:41,830
هذه حانة ومُدرِجة مهام في وسط البلدة

191
00:14:41,830 --> 00:14:44,030
الطّابق الثّاني هو نُزُل

192
00:14:44,450 --> 00:14:49,990
قرّرتُ الإقامة هنا لبعض الوقت لأجعل
هذه قاعدتي بينما أؤدّي المهام

193
00:14:50,840 --> 00:14:53,010
أوّلاً سأستخدم بعض التّوابل البسيطة

194
00:14:53,010 --> 00:14:55,780
وذلك كي أتمكّن من تذوُّق طعم اللّحم جيّداً

195
00:15:01,470 --> 00:15:03,270
أجل، إنّه لذيذ

196
00:15:03,270 --> 00:15:07,600
،شريحتا الفيليه مُقطّعتان إلى قطع رقيقة
لكن يمكن الشُّعور بمذاق اللّحم

197
00:15:07,600 --> 00:15:09,550
لا يوجد مذاق مُريب أيضاً

198
00:15:09,900 --> 00:15:13,820
!حسناً، سأعدُّ طبقاً بسيطاً يُبرِز المكوِّنات فعليّاً

199
00:15:14,910 --> 00:15:17,790
قرّرتُ أن أرى ما إذا كان بمقدوري استخدام
لحم الطّائر اللّصّ لصنع شيش كباب

200
00:15:17,790 --> 00:15:20,180
مثلما فعلتُ مع الأرنب ذي القرن

201
00:15:21,720 --> 00:15:23,640
:وجرّبتُ طبقاً آخر

202
00:15:23,640 --> 00:15:28,990
مزيج من لحم أرنب رفيع مع بقايا
الطّائر اللصّ، معجونة في لحمة برغر

203
00:15:28,990 --> 00:15:33,060
إنّها أوّل مرّة أجرّب فيها ذلك، وقد يكون
...هذا غريباً قليلاً، لكن

204
00:15:34,860 --> 00:15:36,730
!حان وقت الطعام

205
00:15:36,730 --> 00:15:38,590
!أوّلاً، شيش الكباب

206
00:15:39,470 --> 00:15:43,130
أجل، يمكنني تذوّق المزيد من النّكهة
!مع كلّ عضّة

207
00:15:45,680 --> 00:15:47,550
هذا ليس سيّئاً أيضاً

208
00:15:48,050 --> 00:15:50,660
!كأنّني شممتُ رائحة طيّبة

209
00:15:51,960 --> 00:15:53,950
!يبدو هذا لذيذاً

210
00:15:53,950 --> 00:15:56,630
طبخ البشر مختلف حقّاً

211
00:15:56,630 --> 00:15:58,180
!أتمنّى تجربته

212
00:15:58,180 --> 00:16:01,320
...المعذرة، إن كنتم مستعدّين للدفع

213
00:16:01,320 --> 00:16:02,270
!نحن كذلك

214
00:16:04,380 --> 00:16:07,820
!شيش الكباب هذا يتماشى مع البيرة

215
00:16:07,820 --> 00:16:11,980
هذه الأرانب الرّفيعة البغيضة ليست
قاسية جدّاً الآن؟

216
00:16:11,980 --> 00:16:15,450
!لم أكن أعلم أنّ الطّيور اللّصّ لذيذة

217
00:16:15,450 --> 00:16:17,080
!أريد شراباً آخر

218
00:16:17,080 --> 00:16:19,240
!قادمة

219
00:16:19,240 --> 00:16:24,530
لم أتوقّع أن أطبخ حتّى بعد المجيء
إلى مملكة الجنّيات

220
00:16:24,530 --> 00:16:26,000
لكن أعتقد لا بأس في ذلك؟

221
00:16:26,810 --> 00:16:31,350
في الأيّام العديدة المُقبِلة، تألّفَتْ
،دورة لعِبي من أداء المهام

222
00:16:32,390 --> 00:16:34,650
،وطبخ ما قتلتُه

223
00:16:35,540 --> 00:16:40,360
!ثمّ الأكل والشّرب مع الجميع

224
00:16:40,360 --> 00:16:45,260
...كنتُ أستمتع كثيراً مع كافّة الجنّيات، لكن

225
00:16:45,260 --> 00:16:48,200
!سيّدتي، عليكِ إخفاء آرث حالاً

226
00:16:48,200 --> 00:16:51,360
الابنة الغبيّة للرّجل الّذي يُدير
!الحصن في طريقها إلى هنا

227
00:16:52,330 --> 00:16:53,420
!بسرعة

228
00:16:53,420 --> 00:16:55,170
!آرث، اختبئ في الأسفل

229
00:17:00,730 --> 00:17:04,840
سمعتُ أنّه يوجد بشريّ هنا يطبخ طعاماً غريباً

230
00:17:05,540 --> 00:17:07,910
أحضروه إليّ حالاً

231
00:17:08,510 --> 00:17:12,690
سوف أمنحه فُرصة للعمل كطبّاخ لي

232
00:17:12,690 --> 00:17:15,170
...هذه طريقة مُتغطرسة جدّاً في  الكلام

233
00:17:15,460 --> 00:17:20,590
أنا آسفة. لقد غادر بالفعل

234
00:17:21,370 --> 00:17:26,510
أعلم أنّه كان هنا قبل بضعة أيّام على الأقلّ

235
00:17:26,900 --> 00:17:29,210
هل أنتِ متأكّدة بأنّه غادر؟

236
00:17:29,210 --> 00:17:31,500
ستكون العاقبة وخيمة إذا أخبأتِه

237
00:17:31,500 --> 00:17:36,950
أعلم بأنّه لن يرفض فُرصة الطّبخ لي

238
00:17:36,950 --> 00:17:43,710
أخبرتُه أنّه من الخطير المُغادرة من دون
،أن يستغرق وقتَه للتّحضير كما ينبغي

239
00:17:43,710 --> 00:17:47,280
لكن قال بأنّ لديه عمل طارئ في الشّرق

240
00:17:56,880 --> 00:17:58,240
الشّرق، صحيح؟

241
00:17:58,240 --> 00:17:58,960
صحيح

242
00:17:59,970 --> 00:18:00,880
هكذا إذاً

243
00:18:01,110 --> 00:18:02,000
!أنتما

244
00:18:02,000 --> 00:18:05,020
أحضرا لي معلومات عن كلّ مُغامر توجّهَ شرقاً

245
00:18:05,020 --> 00:18:12,240
لا يُسمَح لأي طبّاخ أن يُغادر هذه المدينة
!من دون الطّبخ لي مرّة على الأقلّ

246
00:18:12,240 --> 00:18:16,150
!عندما تجدانه، اقبضا عليه وأحضراه لي

247
00:18:16,150 --> 00:18:17,100
!حاضر

248
00:18:20,690 --> 00:18:23,350
أنتِ أيضاً. اتّصلي بي إذا عرفتِ شيئاً

249
00:18:23,350 --> 00:18:24,300
عُلِم

250
00:18:29,310 --> 00:18:31,130
ما مشكلتها؟

251
00:18:31,130 --> 00:18:33,740
إنّها بذلك الغباء دوماً، صحيح؟

252
00:18:34,240 --> 00:18:36,040
أمان الآن على ما أعتقد

253
00:18:36,380 --> 00:18:40,040
تلك الفتاة الحمقاء تضع نُصب
عينيها عليك الآن

254
00:18:40,040 --> 00:18:42,610
أنا آسفة يا آرث

255
00:18:42,610 --> 00:18:44,090
...هذه غلطتي

256
00:18:44,440 --> 00:18:47,350
كنتِ تعرفين من أكون؟

257
00:18:47,350 --> 00:18:48,400
أجل

258
00:18:48,400 --> 00:18:53,770
هناك في الواقع أمر من الملِكة
،أنّنا حتّى لو عرفناك

259
00:18:53,770 --> 00:18:55,780
لن نقول شيئاً

260
00:18:55,780 --> 00:18:57,360
لم أكن أعلم

261
00:18:57,360 --> 00:19:01,850
ولم يبدُ أنّك أردت مُعاملة خاصّة أيضاً

262
00:19:02,700 --> 00:19:07,290
تسبّب تلك الفتاة مشكلات كثيرة بشخصيّتها هذه

263
00:19:07,290 --> 00:19:11,110
لكن والدها يُدير الحصن، لذا لا أحد
يجرؤ على قول شيء

264
00:19:11,110 --> 00:19:16,540
.وهو لا يعاقبها أبداً على أنانيّتها أيضاً
...إنّه يدلّلها

265
00:19:16,540 --> 00:19:19,320
هل فهمت يا أبي؟

266
00:19:19,320 --> 00:19:22,730
لا نتائج إيجابيّة للتّعامل بقسوة مع جماعتك

267
00:19:23,300 --> 00:19:25,990
لا أستطيع أن أسبّب مزيداً من المشاكل لكم

268
00:19:25,990 --> 00:19:27,140
سوف أغادر

269
00:19:33,340 --> 00:19:37,540
لولا هذا، لأردتُك أن تبقى هنا للأبد

270
00:19:37,540 --> 00:19:40,450
لا، قضيتُ وقتاً رائعاً

271
00:19:40,860 --> 00:19:42,110
...و

272
00:19:43,020 --> 00:19:45,900
،وجود أشخاص يقولون بأنّهم أحبّوا طبخي

273
00:19:45,900 --> 00:19:48,510
...يشربون معي ويستمتعون

274
00:19:48,950 --> 00:19:52,630
!كانت حياتي مُمتعة للغاية

275
00:19:58,950 --> 00:20:01,430
انتظرتُ أن يخيّم اللّيل ثمّ غادرت

276
00:20:21,990 --> 00:20:23,610
أنت آرث، صحيح؟

277
00:20:24,420 --> 00:20:26,350
سمعنا بما يجري

278
00:20:26,350 --> 00:20:29,910
سبّبَتْ تلك الفتاة الغبيّة الكثير من المشاكل

279
00:20:30,350 --> 00:20:34,510
يجمع النّاس أدلّةً عن سلوكها لتقديمها للملِكة

280
00:20:35,080 --> 00:20:37,440
عُد عندما تهدأ الأمور

281
00:20:41,360 --> 00:20:43,900
هيّا. بسرعة

282
00:20:43,900 --> 00:20:45,030
شكراً لك

283
00:20:48,840 --> 00:20:50,020
من هنا

284
00:20:52,180 --> 00:20:53,680
تأخّرت

285
00:20:55,260 --> 00:20:57,520
اصعد على ظهري بسرعة

286
00:21:00,800 --> 00:21:03,370
كان طبخك لذيذاً

287
00:21:05,680 --> 00:21:07,210
أكلته؟

288
00:21:07,210 --> 00:21:10,230
،أجل. وكعربون شكر بسيط

289
00:21:10,230 --> 00:21:12,450
سوف أوصلك إلى البلدة الجنوبيّة

290
00:21:15,580 --> 00:21:17,360
!حسناً، لنسرع إذاً

291
00:21:17,360 --> 00:21:18,200
!دع الأمر لي

292
00:21:19,330 --> 00:21:22,210
!وداعاً يا بلدة الحصن في الجنوب

293
00:21:22,760 --> 00:21:25,750
!وداعاً يا جنّيات الجنوب

294
00:21:37,380 --> 00:21:39,140
تلقّينا تقريراً من سكّان

295
00:21:39,870 --> 00:21:43,920
بلدة حصن الجنوبيّة بأنّ ابنة

296
00:21:43,920 --> 00:21:49,160
الرّجل الّذي يدير الحصن تصرّفَتْ بشكل
سيّئ مع مُغامِر بشريّ

297
00:21:50,320 --> 00:21:52,040
...هذا فظيع

298
00:21:52,040 --> 00:21:57,240
.نحاول أن نكون أصدقاء مع البشر
لا يجوز أن نسمح بعرقلة ذلك

299
00:21:57,240 --> 00:22:02,490
وذلك المُغامر هو... آرث