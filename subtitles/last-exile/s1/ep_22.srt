1
00:00:29,010 --> 00:00:29,970
!رصدنا صوتَ محرّك

2
00:00:41,280 --> 00:00:42,550
!إنها السيلفانا

3
00:00:48,250 --> 00:00:50,100
.هم أحياء إذًا

4
00:00:50,100 --> 00:00:52,160
هذا يستلزم تغييرًا في الخطة، أليس كذلك؟

5
00:02:24,870 --> 00:02:32,410
الملكة دلفيني

6
00:02:44,940 --> 00:02:47,190
...يا نائبة القائد، القائدُ قد

7
00:02:47,190 --> 00:02:49,650
.أجل، أعرف ذلك

8
00:02:49,650 --> 00:02:55,460
.وكذلك فإن "ديو" و"أل" و"كلاوس"، أخذتهم المايسترو معها

9
00:02:55,460 --> 00:02:56,320
كلاوس؟

10
00:03:00,220 --> 00:03:01,930
لم تُراها أخذت كلاوس؟

11
00:03:12,930 --> 00:03:16,430
.يا لوسامتك يا ديو

12
00:03:17,200 --> 00:03:19,140
.أختي

13
00:03:21,840 --> 00:03:24,140
ما رأيك يا لوسيولا؟

14
00:03:25,780 --> 00:03:30,310
.مباركٌ لكما يا دلفيني-ساما ويا ديو-ساما

15
00:03:30,920 --> 00:03:32,410
!كلاوس

16
00:03:33,920 --> 00:03:35,490
ما الذي جرى لديو؟

17
00:03:37,460 --> 00:03:41,020
.الآن عرفتُ لِمَ كان ديو مرعوبًا منكِ

18
00:03:42,090 --> 00:03:44,790
!لأنه عرِف أنكِ ستقتلين قلبه

19
00:03:45,230 --> 00:03:49,710
.عجبًا، نحن مقرّبان

20
00:03:54,770 --> 00:03:56,710
!أأنت راضٍ بهذا يا لوسيولا؟

21
00:03:59,210 --> 00:04:01,260
.بالطبع

22
00:04:02,450 --> 00:04:04,470
.فهذا عالمي

23
00:04:05,520 --> 00:04:10,650
.عليكما بتهنئته كذلك؛ فاليوم سيُمسي ديو بالغًا

24
00:04:33,380 --> 00:04:35,430
قلتَ إن اسمك كلاوس؟

25
00:04:35,430 --> 00:04:41,090
.علِمتُ أنك أردّت معرفة ما يجري في السماء

26
00:04:42,500 --> 00:04:46,100
.لي إخبارك بذلك لو أردّتَ

27
00:04:48,350 --> 00:04:50,730
.فالسماء ملكٌ لي

28
00:04:50,730 --> 00:04:56,650
.ومعرفة ما أفعله هنا سيجيب عن تساؤلاتك

29
00:04:57,470 --> 00:04:59,360
."طقوس "العهد

30
00:04:59,360 --> 00:05:02,470
روحي والسماء كيانٌ واحد

31
00:05:02,470 --> 00:05:04,610
وكيانٌ واحد مع السُحب البيضاء

32
00:05:04,610 --> 00:05:07,710
السماء الزرقاء تحرّرني

33
00:05:07,710 --> 00:05:09,750
الحائط المقدّس يقيني جحيم الأرض

34
00:05:09,750 --> 00:05:12,720
أهبُ كياني إلى عاصفةِ السماء

35
00:05:12,720 --> 00:05:15,310
لحين انقضاء الزمن الأبدي

36
00:05:15,310 --> 00:05:17,920
سوف أحمي وطننا

37
00:05:17,920 --> 00:05:20,760
الذي تُحيط به السماء الزرقاء، والسُحب البيضاء، والحائط القرمزي

38
00:05:20,760 --> 00:05:23,390
أنا كيانٌ واحد مع السماء

39
00:05:24,800 --> 00:05:30,210
.أصغوا إليّ أيها الأسياد يا من اجتمعتم هنا اليوم وعلامة "العهد" منقوشةٌ على جباهكم

40
00:05:30,970 --> 00:05:35,270
.أنتم من ستنشئون جيل النقابة التالي

41
00:05:35,270 --> 00:05:39,540
.النقابة هي القانون. والنقابة هي النظام

42
00:05:39,540 --> 00:05:41,270
.النقابة هي العالم

43
00:05:42,950 --> 00:05:45,490
.ما نصبوا إليه هو الاستقرار الأزلي

44
00:05:46,250 --> 00:05:49,350
.استقرار العالم الأزلي

45
00:05:49,350 --> 00:05:53,000
.للولاء" جائزةٌ خاصة اللّيلة"

46
00:05:53,000 --> 00:05:54,670
!إلى جيل النقابة التالي

47
00:06:00,170 --> 00:06:01,630
،سيف العهد

48
00:06:02,000 --> 00:06:06,840
.وحدهم من يتعهدون بأزليّتهم إلى النقابة يُسمح لهم بحمله

49
00:06:06,840 --> 00:06:11,020
!إن كنت تريد أن ترِث لقبي، فخذ السيف

50
00:06:11,020 --> 00:06:15,520
.سأعهد لقب "المايتسرو" لمن يلتقطه

51
00:06:15,520 --> 00:06:17,910
.سيفٌ واحد فقط

52
00:06:17,910 --> 00:06:21,590
ولكن كم من بينكم تحترق أوراحهم بالعهد؟

53
00:06:25,290 --> 00:06:27,130
،تعرفون بالفعل

54
00:06:27,130 --> 00:06:30,490
.أن الليلة ستكون مِحنة آغون

55
00:06:31,170 --> 00:06:33,160
!إذًا، لتبدؤوا

56
00:06:38,270 --> 00:06:39,010
!ديو

57
00:06:40,210 --> 00:06:42,200
ما الذي تحاولين حملهُ على فِعله؟

58
00:06:42,200 --> 00:06:45,470
!أنتِ أخته، ألستِ كذلك؟ لتوقفيه رجاءً

59
00:06:47,680 --> 00:06:48,720
.كلّا

60
00:07:02,590 --> 00:07:04,990
!يا للروعة يا ديو

61
00:07:05,430 --> 00:07:08,950
.وها قد بِتّ تعرف ما يجري في هذه السماء يا كلاوس

62
00:07:10,740 --> 00:07:13,340
!مراسم طقوس عهد النقابة ستبدأ

63
00:07:14,010 --> 00:07:16,080
!لتستعد كافة القوات للهجوم

64
00:07:16,080 --> 00:07:18,140
!استعدّوا للقتال

65
00:07:21,450 --> 00:07:22,390
ما هذا؟

66
00:07:22,390 --> 00:07:25,740
.إنه وسام نجاةٍ أعطته لي إحدى صديقاتي

67
00:07:25,740 --> 00:07:27,980
.إنه يدويّ الصنع

68
00:07:27,980 --> 00:07:29,070
!مذهل

69
00:07:29,070 --> 00:07:34,810
أتعلمين أنكِ لو جمعتِ عشرين وسامَ نجاةٍ، فستترقّين وتصعدين على متن السفينة التي تريدينها؟

70
00:07:35,170 --> 00:07:38,260
لم أكن أعلم، أتقول الحقيقة؟

71
00:07:38,260 --> 00:07:39,180
.أجل

72
00:07:39,990 --> 00:07:45,300
.وإلى أن أحوز وسام النجاة العشرين الحقيقي من مهمّتنا هذه، فهي أشبه بتميمة حظ

73
00:07:56,110 --> 00:08:00,700
.أنتما صديقاه، فألقيا نظرةً على وسامةِ ديو

74
00:08:07,230 --> 00:08:09,160
أل، ما الخطب؟

75
00:08:11,000 --> 00:08:13,640
.دلفيني-ساما، إنها الشرنقة

76
00:08:13,640 --> 00:08:16,330
.ستكونين نجمة عرضنا التالية يا ألفيس

77
00:08:17,410 --> 00:08:18,520
.تعاليا معي

78
00:08:19,200 --> 00:08:21,000
تمهلي! ماذا عن ديو؟

79
00:08:21,810 --> 00:08:24,070
.يكفي أن أعرف النتيجة فقط

80
00:08:24,640 --> 00:08:26,730
ولكن ماذا لو مات؟

81
00:08:27,950 --> 00:08:30,850
.إن مات ديو فهي غلطته

82
00:08:30,850 --> 00:08:35,650
.ما أريد معرفته هو من سيرث لقبي

83
00:08:35,650 --> 00:08:38,590
.كلاوس، هيا عجّل بمجيئك رفقة ألفيس

84
00:08:38,590 --> 00:08:39,270
!لا أريد

85
00:08:40,590 --> 00:08:44,840
.عندما تخبرك دلفيني بأن تأتيَ بشيءٍ فعليك أن تأتيَ به

86
00:09:02,010 --> 00:09:03,000
هل انتهيتِ؟

87
00:09:06,020 --> 00:09:07,620
.بذلت جهدكِ حقًا

88
00:09:07,620 --> 00:09:08,870
!يا للروعة

89
00:09:08,890 --> 00:09:10,530
!بورك عملكِ

90
00:09:13,730 --> 00:09:14,840
.شكرًا لكم

91
00:09:15,930 --> 00:09:18,370
.مع الأسف أنه ليس موجودًا في لحظةٍ كهذه

92
00:09:18,800 --> 00:09:21,330
.هلّا نذهب لاصطحاب كلاوس-كن إذن

93
00:09:22,100 --> 00:09:23,380
!سنذهب لنسلّم على النقابة

94
00:09:25,570 --> 00:09:29,380
.ألم تسمعي؟ نحن الآن في طريقنا إلى النقابة لننال منهم

95
00:09:29,380 --> 00:09:31,740
.سنردّ لهم الصاع صاعين

96
00:09:31,740 --> 00:09:34,340
.-فهكذا تسري الأمور في سيلفانا -اقتلهم جميعًا

97
00:09:34,650 --> 00:09:39,270
!وفوقها، أسوأ بثلاثِ أضعافِ مما ذُقنا، هذا مخيف

98
00:09:39,820 --> 00:09:42,520
!أسرع بجلب تلك المعدّات يا إيثان

99
00:09:42,520 --> 00:09:44,080
!علم، أنا آتٍ

100
00:09:46,790 --> 00:09:49,320
.أنهت لاڤي إصلاحات سفينتها

101
00:09:49,860 --> 00:09:52,400
!أحقًا ما تقول؟ هنيئًا لكِ

102
00:09:52,400 --> 00:09:54,230
.شكرًا لك

103
00:09:56,530 --> 00:09:58,300
أين وجدّتها؟

104
00:09:58,300 --> 00:10:01,440
.وجدّتها ملقيةً على أرض حجرةِ الاستعدادات، فأتيتُ بها

105
00:10:02,470 --> 00:10:04,330
ما سِرّها؟

106
00:10:06,180 --> 00:10:09,170
.قالت آل إنه منظر خلّاب رأته في حلم

107
00:10:09,170 --> 00:10:13,440
ولهذا علينا الذهاب لإنقاذ كلاوس وأل، أليس كذلك؟

108
00:10:13,440 --> 00:10:17,350
.ولأنها صوّرتها إلى هذا الحد، فأريدها أن تُكملها لآخرها

109
00:10:17,350 --> 00:10:21,920
كونك أنهيتِ إصلاحها، فلم لا ننال من النقابة بفانشيب كلاوس؟

110
00:10:22,310 --> 00:10:23,800
.كفاك غباءً

111
00:10:25,600 --> 00:10:27,000
...أيتها القائدة

112
00:10:27,000 --> 00:10:30,760
.سفينة كلاوس ولاڤي ليست بسفينةٍ مُقاتلة

113
00:10:36,170 --> 00:10:39,120
.أنهيتها إذًا، مباركٌ لك

114
00:10:39,670 --> 00:10:42,120
.أجل، شكرًا

115
00:10:44,620 --> 00:10:47,000
...آمل ألّا تُراق الدماء هنا

116
00:10:47,000 --> 00:10:48,710
!أخفِ سلاحك أيها المغفل

117
00:10:48,710 --> 00:10:50,350
!صحـ- ويحي

118
00:11:16,950 --> 00:11:20,950
ما الذي تفعلينه؟ تعلمين أن على متن تلك البوارِج أطقُم، صحيح؟

119
00:11:20,950 --> 00:11:26,920
.إنهم محظوظون، فلقد ماتوا بلمس الملاذ من أجلي

120
00:11:27,560 --> 00:11:28,810
!الملاذ

121
00:11:39,370 --> 00:11:41,980
تشعر بها أيها الملاذ، أليس كذلك؟

122
00:11:41,980 --> 00:11:45,560
!هذا، صحيح، مفتاحكَ هنا

123
00:11:45,790 --> 00:11:47,010
!كفاكِ

124
00:11:47,250 --> 00:11:50,970
أخبريني يا ألفيس، أتعلمين ما الملاذ؟

125
00:11:52,520 --> 00:11:54,530
.لديكِ الحق لتعرفي

126
00:11:55,380 --> 00:11:56,760
!كُفاكِ رجاءً

127
00:11:58,710 --> 00:12:01,200
.أما أنت فأطبق فمك

128
00:12:03,330 --> 00:12:05,660
.دعيني أخبركِ يا ألفيس

129
00:12:06,360 --> 00:12:10,990
.الملاذ هي فُلكٌ مستعمرةٌ منذ أمدٍ سحيق

130
00:12:10,990 --> 00:12:12,540
فُلك مُستعمرة؟

131
00:12:12,540 --> 00:12:16,840
.أجل، فعلى متنها أولئك الذين أسسوا هذا العالم

132
00:12:16,840 --> 00:12:20,240
.ولو صعدّتِ على متنها، فستستطيعين الذهاب إلى عالمٍ آخر

133
00:12:21,150 --> 00:12:24,980
الإشاعات مخيفةٌ، أليس كذلك؟ أليس الأمر ذاته مع السيلفانا؟

134
00:12:25,980 --> 00:12:29,850
.سيلفانا -اقتلهم جميعًا-
.السلاح المطلق الملاذ

135
00:12:29,850 --> 00:12:31,320
.عجبي كم هذا مخيف

136
00:12:31,670 --> 00:12:34,020
.إنه أداةٌ للقتل والتدمير

137
00:12:34,020 --> 00:12:39,440
.لعلّه تعبيرٌ عن رغباتِ الدنيويين الذين يتأملون تدمير العالم

138
00:12:39,440 --> 00:12:43,730
.علينا الاعتزاز بهذه الآمال، فهي أحلاهم

139
00:12:43,730 --> 00:12:48,750
.ولأن للدنيويين أحلامٌ فعليهم أن يتعرّقوا ويكدحوا

140
00:12:48,750 --> 00:12:52,880
.ولذا، فإن واجبي جعلهم يستمرّون في أحلامهم

141
00:12:52,880 --> 00:12:58,180
عليّ الاحتفاظ بحقيقة أنه يهيم في التيّار العظيم إلى الأبد، أليس كذلك؟

142
00:12:58,180 --> 00:13:01,010
.عليّ الحرص على ألّا يشهده أي أحد

143
00:13:14,930 --> 00:13:16,630
.ألفيس، تعالي هنا

144
00:13:17,230 --> 00:13:18,870
!كلّا، لا تذهبي

145
00:13:18,870 --> 00:13:19,990
!أل

146
00:13:23,340 --> 00:13:25,940
.أنا... هنا

147
00:13:32,250 --> 00:13:33,200
...أل

148
00:13:37,210 --> 00:13:38,940
الملاذ الأخير

149
00:13:42,490 --> 00:13:44,290
الملاذ الأخير

150
00:13:59,180 --> 00:14:01,500
.ألقِ نظرةً أيها الملاذ

151
00:14:02,180 --> 00:14:06,280
.فها هنا المفتاح الذي سيوقظك من سباتك الطويل

152
00:14:07,420 --> 00:14:10,120
.ظريفتي ألفيس

153
00:14:11,460 --> 00:14:13,580
.بدءًا من الآن أنتِ نجمة العرض

154
00:14:15,460 --> 00:14:18,330
.أحضر الشاعِر يا سيكادا

155
00:14:18,330 --> 00:14:20,200
.علم

156
00:14:20,200 --> 00:14:21,870
الشاعر؟

157
00:14:39,550 --> 00:14:40,710
!أليكس

158
00:14:42,250 --> 00:14:43,580
!أليكس

159
00:14:45,190 --> 00:14:46,620
!أليكس

160
00:14:48,730 --> 00:14:54,520
،ما سأريك إياه الآن ليس ما يجري في السماء

161
00:14:56,000 --> 00:14:58,800
.بل ما سوف يجري

162
00:15:12,450 --> 00:15:17,650
.أيها الشاعر المحترم، لِتبُح لي بالكلماتِ التي أخفيتها عنّي

163
00:15:20,530 --> 00:15:23,240
.أراك تبذل جهدك في المقاومة، ولكن لا فائدة

164
00:15:24,030 --> 00:15:30,950
.فهذه الأشواك تحقنك بمصل الحقيقة الذي تخلّل إلى عقلك وغُرِسَ فيه بالفعل

165
00:15:35,870 --> 00:15:41,650
:حينما صعدّتما على متن السيلفانا بهذه الفانشيب، أخبرني القائد شيئًا

166
00:15:41,650 --> 00:15:44,260
".إنه يشبه ذاتي القديمة"

167
00:15:44,980 --> 00:15:49,340
.يبدو أن كلاوس حلّق بعيدًا أبعد مما وصلنا إليه نحن

168
00:15:52,590 --> 00:15:54,190
هل أنتِ بخير؟

169
00:15:55,360 --> 00:15:58,550
.أشعر أنني بلا جدوى دونه

170
00:15:59,860 --> 00:16:05,620
.إنه عنيد، لذلك أثابر كثيرًا لأراعيَ من حولنا

171
00:16:05,620 --> 00:16:13,300
.لذلك... حينما اختفى فجأةً، شعرتُ بالاكتئاب

172
00:16:14,410 --> 00:16:18,050
.ولا أعرف كيف أروّح عن نفسي

173
00:16:19,680 --> 00:16:23,920
!تاتيانا ويا أليس، أنقذا كلاوس وأل

174
00:16:23,920 --> 00:16:24,860
!أرجوكما

175
00:16:25,260 --> 00:16:28,050
.نعدكِ أننا حتمًا سننقذهما

176
00:16:32,000 --> 00:16:38,440
عزيزي الشاعر، هلّا تتلو كلمات الحقبة القديمة الموقِظَة؟

177
00:16:41,040 --> 00:16:45,980
.هلّا تبُح بالأحاجي هنا ومن أجلي يا أليكس رو

178
00:16:51,320 --> 00:16:55,410
.إذًا، سنستهلّ بأحجية آل داغوبيرت

179
00:16:57,220 --> 00:17:00,810
.الأمواج التي تلوّن الأرض ذهبًا

180
00:17:03,900 --> 00:17:06,800
النَفَس المُبارك الذي يغذّي الحياة

181
00:17:07,700 --> 00:17:10,960
.أرضُ القمح

182
00:17:23,510 --> 00:17:25,400
.الشرنقة تستجيب

183
00:17:26,680 --> 00:17:29,060
.يا لغبائك يا أليكس

184
00:17:29,060 --> 00:17:34,750
.لو كنت مهذبًا منذ البداية ونطقت بها، لما كان على عقلك أن يتألم هكذا

185
00:17:34,750 --> 00:17:36,260
.لا تلم إلا نفسك

186
00:17:37,800 --> 00:17:38,540
!لوسيولا؟

187
00:17:43,130 --> 00:17:44,930
.كم أنت فتى مطيع يا لوسيولا

188
00:17:45,240 --> 00:17:48,340
.هلّا تبقي صديقك حيث هو

189
00:17:48,340 --> 00:17:51,050
.أريدك أن تمنع تدخلاتِه

190
00:17:51,050 --> 00:17:52,390
.سمعًا وطاعة

191
00:17:53,340 --> 00:17:58,930
.إذًا يا أليكس، حان دور أحجية آل هاميلتون من فضلك

192
00:18:00,550 --> 00:18:05,210
ما الذي يكمن في أعماق الذاكرة؟

193
00:18:07,960 --> 00:18:11,620
حيثُ وُلد كلّ شيء، وحيث يعود كل شيء

194
00:18:12,130 --> 00:18:15,200
.العالم الأزرق

195
00:18:31,670 --> 00:18:34,220
!رصدنا صوتًا مجهولًا

196
00:18:34,450 --> 00:18:38,100
.ليس صوت محرّك، أرجّح أنه الضوء الذي عبر للتو

197
00:18:38,460 --> 00:18:39,650
ضوء؟

198
00:18:40,020 --> 00:18:43,420
.اكتمل مسح الشرنقة الليزري

199
00:18:45,400 --> 00:18:49,830
هل فتَكت بك المايسترو يا أليكس؟

200
00:18:56,740 --> 00:19:00,810
.هيا، اتلُ أحجية آل باسيانوس

201
00:19:03,460 --> 00:19:05,520
!أليكس

202
00:19:05,520 --> 00:19:07,310
...لا أعرف

203
00:19:12,320 --> 00:19:13,990
.محال ألّا تعرفها

204
00:19:14,590 --> 00:19:19,250
.أنا على علمٍ بأنك تعرف كلّ الأحاجي

205
00:19:19,730 --> 00:19:20,470
...لا أعرف

206
00:19:25,340 --> 00:19:30,150
.أجب، يستحيل أن تعصيَ مصل الحقيقة

207
00:19:32,180 --> 00:19:33,780
!دلفيني-ساما

208
00:19:34,350 --> 00:19:38,160
.يُحتمل أن هذا الرجل لا يعرفها حقًا

209
00:19:41,580 --> 00:19:45,760
.فهمت، هكذا إذًا

210
00:19:45,760 --> 00:19:48,680
تظنّ أنك تفوقني دهاءً، أليس كذلك؟

211
00:19:49,960 --> 00:19:52,000
.يا لظرافتك

212
00:19:53,600 --> 00:19:57,250
.ولكن... لا فائدة

213
00:19:57,250 --> 00:19:58,540
.أخبرني

214
00:19:58,540 --> 00:20:03,040
.فلا بد أن من يعرف أحجية آل باسيانوس بجابنك

215
00:20:04,140 --> 00:20:05,060
...هيا

216
00:20:23,960 --> 00:20:26,120
.يا لك من مطيعٍ يا أليكس

217
00:20:27,230 --> 00:20:31,140
.سيكادا، لتُمسك بجلالتها ولتأتِ بها إليّ هنا

218
00:20:31,140 --> 00:20:32,540
.طوع أمركِ

219
00:20:43,450 --> 00:20:44,830
.أنا آسفة

220
00:20:44,830 --> 00:20:47,700
.يبدو أن أحاجي الليلة قد انتهت

221
00:20:47,700 --> 00:20:49,650
.لنحاول مجددًا في وقت لاحق

222
00:20:50,520 --> 00:20:52,970
!توقفي! لا تلمسِي أل

223
00:20:54,860 --> 00:20:59,860
.دلفيني-ساما، إنه اتصال من ساحة العهد

224
00:21:01,200 --> 00:21:03,700
انتهت المعركة، أليس كذلك؟

225
00:21:37,940 --> 00:21:41,150
.لقد بلغت يا ديو

226
00:21:42,940 --> 00:21:46,480
.الذي سيرث لقب المايسترو هو ديو

227
00:21:46,480 --> 00:21:51,080
.لنوّرث أسرار آل إراكليا للجيل القادم سويةً

228
00:21:53,250 --> 00:21:56,990
.هيا نعد لنهنّئ ديو

229
00:21:56,990 --> 00:21:59,710
.أحضر ألفيس يا لوسيولا

230
00:21:59,710 --> 00:22:00,520
!أمرك

231
00:22:03,430 --> 00:22:05,870
.وذلك الصديق أيضًا

232
00:22:10,470 --> 00:22:13,460
.العديد من الأحداث العظيمة تنتظرنا

233
00:23:52,240 --> 00:23:55,440
أخرجَ الصبي الشقي منك يا ديو؟

234
00:23:55,880 --> 00:23:57,890
.أعتذر يا أختي

235
00:23:57,930 --> 00:23:59,910
.لكم أهوى ديو المطيع

236
00:24:00,580 --> 00:24:04,040
.لقد أتيتُ بمكافأة إلى ظريفي ديو

237
00:24:04,390 --> 00:24:05,350
لي؟

238
00:24:05,790 --> 00:24:07,910
.لتُعطِه اسمًا

239
00:24:09,260 --> 00:24:20,890
تبييت لوسيولا

240
00:24:11,290 --> 00:24:15,490
.الحلقة القادمة والثالثة والعشرون من الملاذ الأخير: تبييت لوسيولا

241
00:24:16,330 --> 00:24:20,100
!لوسيولا! من الآن فصاعدًا أنت لوسيولا