4
00:00:11,650 --> 00:00:12,570
!دعها

5
00:00:12,570 --> 00:00:14,640
!دع أل

6
00:00:21,700 --> 00:00:22,660
!كلاوس

7
00:02:14,780 --> 00:02:21,410
تلاعبٌ رُتَبِي

8
00:02:49,190 --> 00:02:50,500
.أل

9
00:02:57,340 --> 00:02:58,650
.ها هي شُحنتنا

10
00:03:00,380 --> 00:03:01,610
.عُلِم

11
00:03:17,430 --> 00:03:17,840
.إنّها حيّة

12
00:03:20,100 --> 00:03:21,010
!مهلًا

13
00:03:24,890 --> 00:03:26,140
!كلاوس

14
00:03:26,470 --> 00:03:29,170
.أحسنت عملًا أيها المرسول

15
00:03:29,170 --> 00:03:31,850
.أتممتَ مهمتك، عد إلى المنزل هيّا

16
00:03:32,980 --> 00:03:35,400
!دعو أل

17
00:03:42,650 --> 00:03:43,490
.هذا نصف الأجر

18
00:03:45,150 --> 00:03:46,200
!أليكس

19
00:03:46,860 --> 00:03:48,200
أأنت أليكس رو؟

20
00:04:07,340 --> 00:04:08,810
!السيلڨانا

21
00:04:31,330 --> 00:04:32,790
.حسنٌ، سأصعد بها إلى البارِجة

22
00:04:34,000 --> 00:04:35,540
.غودوين

23
00:04:36,000 --> 00:04:38,920
.تَلطَّف في حمل الشُحنة

24
00:04:42,840 --> 00:04:43,930
.آسف

25
00:04:47,750 --> 00:04:49,510
!تمهّل يا أليكس

26
00:04:54,520 --> 00:04:56,230
.كلاوس

27
00:05:02,030 --> 00:05:03,110
!أل

28
00:05:28,020 --> 00:05:29,180
!كلاوس

29
00:05:35,060 --> 00:05:36,310
فيمَ تفكر؟

30
00:05:41,170 --> 00:05:42,480
.لم يفُتِ الأوان بعد

31
00:05:49,850 --> 00:05:53,650
،أنصِت، حتى إن رقّعت ثقب الهيكل

32
00:05:53,650 --> 00:05:55,870
.فلن نستطيع الطيران بلا وقود

33
00:05:56,790 --> 00:05:59,040
.سأجلبه الآن

34
00:06:02,380 --> 00:06:06,380
مهلًا، مهلًا، أتعني أنّك ستستخدم وقود ذلك الشيء؟

35
00:06:09,500 --> 00:06:10,720
!كلاوس

36
00:06:24,820 --> 00:06:26,880
إنّه ميّت، أليس كذلك؟

37
00:06:26,880 --> 00:06:27,740
.بلى

38
00:06:31,700 --> 00:06:34,660
!هلّا تتوقف يا كلاوس

39
00:06:35,360 --> 00:06:38,080
شهدت أل مقتل ثلاثة أشخاص بأمّ عينيها.

40
00:06:40,030 --> 00:06:40,670
!ربّاه

41
00:06:41,930 --> 00:06:44,670
ألم ترَي عينَي أليكس؟

42
00:06:45,070 --> 00:06:46,550
.ماذا؟ أ- أجل

43
00:06:47,200 --> 00:06:49,670
...رجلٌ يجوب السمَوات مثله

44
00:06:49,670 --> 00:06:53,050
.لم تكن عينا أبي هكذا أبدًا

45
00:06:53,050 --> 00:06:57,110
!أمعن النظر إليّ يا كلاوس

46
00:06:59,550 --> 00:07:02,650
.أنصت، مهمّتنا انتهت بالفعل

47
00:07:03,350 --> 00:07:05,070
.لقد أوصلنا الشُحنة

48
00:07:05,490 --> 00:07:07,070
!وهنا تنتهي مهمّتنا

49
00:07:07,720 --> 00:07:12,780
!لن تنتهي مهمتنا قبل أن يخبرنا ما الذي ينوي فعله بأل

50
00:07:14,160 --> 00:07:18,410
.إن لم نتيقّن من سلامة شُحنتنا، فالفشل مصير مهمّتنا

51
00:07:24,740 --> 00:07:26,840
!كم أنت ساذج يا كلاوس

52
00:07:44,160 --> 00:07:47,610
.لقد نسيَت هذا معنا

53
00:07:49,900 --> 00:07:54,120
.لنوصله إليها، لا بد أن أل بحاجة إليه

54
00:07:56,340 --> 00:07:59,000
.يبدو أنّ تصنيف خطورة هذه سيبلغ عشرة نجوم

55
00:08:01,580 --> 00:08:03,170
!كم أنتِ ساذجةٌ يا لاڨي

56
00:08:05,510 --> 00:08:07,630
.ليس بقدرك يا كلاوس

57
00:08:32,360 --> 00:08:34,310
ما خطب هذا الوقود؟

58
00:08:34,310 --> 00:08:36,750
!إنه في غاية النقاء

59
00:08:36,750 --> 00:08:40,290
!إن لم نعدّل مزيج الوقود سيحترق المحرك

60
00:08:40,700 --> 00:08:44,620
!من ذا الذي يستخدم وقودًا نقيًّا كهذا بحق؟

61
00:08:44,990 --> 00:08:47,380
أيمكن أنها النقابة؟

62
00:08:47,380 --> 00:08:48,630
!النقابة؟

63
00:08:53,930 --> 00:08:54,860
.لاڨي

64
00:08:55,730 --> 00:08:58,890
.لأنه كان من الهدر تركه هناك

65
00:08:59,500 --> 00:09:02,680
،خِلتُ أن بوسعنا استخدامه لتعديل الفانشيب

66
00:09:03,770 --> 00:09:05,190
.شخصيتك ملفتةٌ حقًا

67
00:09:05,190 --> 00:09:08,940
!ما بك؟ لمِن الضروري ادّخار المال

68
00:09:31,500 --> 00:09:32,590
كيف حالك؟

69
00:09:34,340 --> 00:09:37,090
.تشرّفت بمعرفتك يا ألڨيس هاميلتون

70
00:09:37,940 --> 00:09:40,810
.أنا صوفيا، نائبة قائد هذه البارِجة

71
00:09:41,740 --> 00:09:43,270
.تشرّفنا

72
00:09:45,350 --> 00:09:46,950
.لا بدّ أنّكِ مرهقة

73
00:09:46,950 --> 00:09:50,450
.أعِدك بأن تكون حياتك مريحةً هنا

74
00:09:50,450 --> 00:09:53,070
.سلي ما تشائينه دون تردّد

75
00:09:54,260 --> 00:09:56,070
أثمّة ما يمكنني فعله لأجلك؟

76
00:10:01,330 --> 00:10:03,700
.سأحضِر لك العشاء لاحقًا

77
00:10:03,700 --> 00:10:05,450
.ارتاحي حتّى ذلك الحين

78
00:10:11,670 --> 00:10:14,840
.يجدر بك التبسّم عند مجالسة الأطفال

79
00:10:15,180 --> 00:10:17,090
أكنتِ تراقبين يا تاتيانا؟

80
00:10:18,010 --> 00:10:21,600
،لم أكن لأجرؤ على القيام بفعلٍ فظّ، إنّه حدسٌ وحسب

81
00:10:23,520 --> 00:10:26,520
...رغم هذا، أن تعتني نائبة القائد بطفلة

82
00:10:28,860 --> 00:10:30,770
.لكِ أن تعتني بها لو أحببت

83
00:10:46,540 --> 00:10:47,540
!أيّها القائد

84
00:10:48,780 --> 00:10:50,770
!تاتيانا ويسلا، أُبلغكم بحضوري

85
00:10:52,180 --> 00:10:53,310
ما أخبار الشُحنة؟

86
00:10:53,310 --> 00:10:55,090
.استيقظَت للتو

87
00:10:55,850 --> 00:10:56,920
.هكذا إذًا

88
00:10:57,990 --> 00:11:00,960
.حلّقي إلى حيث يُقيم الإمبراطور يا ويسلا

89
00:11:00,960 --> 00:11:02,930
.أخبريه أنّ الشُحنة قد أُمِّنَت

90
00:11:03,290 --> 00:11:04,650
!عُلِم

91
00:11:05,390 --> 00:11:07,430
!تقريرٌ من مرصد السارية الخلفيّة

92
00:11:07,960 --> 00:11:12,030
!فانشيب وحيدةٌ مجهولة تقترب من جهة الساعة السابعة

93
00:11:12,030 --> 00:11:13,190
فانشيب؟

94
00:11:28,280 --> 00:11:29,710
!وقودنا يتقلقَل

95
00:11:30,020 --> 00:11:34,820
!مهما علا نقاؤه، فعلى هذا المنوال، بالكاد سيبقى لنا وقودٌ كافٍ لرحلة العودة

96
00:11:34,820 --> 00:11:36,080
.لا يهم

97
00:11:36,930 --> 00:11:37,760
.انظري

98
00:11:41,130 --> 00:11:43,390
!ها قد لحِقنا بهم! لننطلق

99
00:11:43,390 --> 00:11:44,180
!تمهّل

100
00:11:45,270 --> 00:11:47,000
!إنّها إشارةٌ ضوئيّة

101
00:11:47,000 --> 00:11:49,680
.يبلغوننا أن نبقى بعيدين

102
00:11:49,680 --> 00:11:50,850
!سأتجاهلها

103
00:11:50,850 --> 00:11:52,370
!هذه هي الروح

104
00:11:53,610 --> 00:11:57,310
.مع ذلك، من الأفضل أن أبلغهم ملاحظة

105
00:11:57,310 --> 00:11:58,360
ملاحظة؟

106
00:11:59,010 --> 00:12:01,700
!بالتأكيد، إنّها مهمّة

107
00:12:01,700 --> 00:12:03,700
!من الكياسة أن تقدّم نفسك عند الزيارة

108
00:12:12,920 --> 00:12:16,000
!السيلڨانا ستُطلِق، فما الذي قلتِه لهم؟

109
00:12:17,370 --> 00:12:20,550
!كلّ ما قلته إنّ لدينا توصيلةً لهم

110
00:12:23,200 --> 00:12:25,940
.سنهلك إن أصابتنا إحداها

111
00:12:25,940 --> 00:12:29,870
!انقضّ عليهم يا كلاوس، سننتصر لو تمكّنا من بلوغ متنها

112
00:12:31,480 --> 00:12:32,100
!حسنٌ

113
00:12:42,950 --> 00:12:45,030
!إنّهم يطلقون حقًا

114
00:12:55,470 --> 00:12:57,000
.سنلتفّ من الخلف يا لاڨي

115
00:13:20,860 --> 00:13:21,780
!لا جدوى

116
00:13:21,780 --> 00:13:26,110
!حانت نهاية حياتي القصيرة

117
00:13:41,130 --> 00:13:44,310
!أوَيعبثُ رماة مضادات الطيران؟

118
00:13:48,390 --> 00:13:50,010
،تلك الفانشيب

119
00:13:50,330 --> 00:13:51,180
.ويسلا

120
00:13:52,490 --> 00:13:54,270
.إنّهما يذكرانني بما كنتِ عليه

121
00:13:58,130 --> 00:14:01,230
.سأغادر رفقة أليستر للقاء الإمبراطور

122
00:14:06,310 --> 00:14:08,450
.إنّك ثرثارٌ اليوم

123
00:14:11,620 --> 00:14:13,450
!لا يسعني ضبط ارتفاعنا

124
00:14:13,450 --> 00:14:14,870
!نفد الوقود منّا

125
00:14:14,870 --> 00:14:18,960
!إمّا نصطدم أو يسقطوننا، إننا هالكان بكلتا الحالتين

126
00:14:19,490 --> 00:14:21,460
!لا تستسلمي يا لاڨي

127
00:14:21,960 --> 00:14:23,000
!سنهبط اضطراريًا

128
00:14:24,230 --> 00:14:25,960
!أُكِّدَ استخدام الفانشيب لفرامل الهواء

129
00:14:26,430 --> 00:14:27,690
.أوقفوا الإطلاق

130
00:14:50,390 --> 00:14:53,850
...إ-إنّني... حيّة

131
00:14:54,520 --> 00:14:55,590
.أجل

132
00:15:03,670 --> 00:15:05,700
!ماعزي الغالي

133
00:15:09,100 --> 00:15:11,240
.إ- إمساكٌ رائع

134
00:15:11,240 --> 00:15:13,550
.هلّا تربطي خطّافنا هناك

135
00:15:14,010 --> 00:15:17,040
.ماذا؟ أجل، حسنٌ

136
00:15:21,350 --> 00:15:22,810
.من هنا يا لاڨي

137
00:15:24,490 --> 00:15:27,570
.إنّه مصعد، لعلّنا نستطيع الصعود به

138
00:15:27,570 --> 00:15:31,090
لِم أوقفوا الإطلاق يا ترى؟

139
00:15:31,090 --> 00:15:33,320
.كانت فرصةً مثاليّة لإسقاطنا

140
00:15:34,160 --> 00:15:36,580
.على الأرجح أنهم رأوا في إسقاطنا مضيعة للجهد

141
00:15:38,570 --> 00:15:41,800
هذه البارِجة ضخمةٌ جدًا، فهل سنستطيع إيجاد أل؟

142
00:15:41,800 --> 00:15:44,870
.آمل ألّا يطلقوا علينا فجأةً

143
00:15:52,350 --> 00:15:53,390
ما رأيك؟

144
00:15:53,880 --> 00:15:55,580
.يبدو مرآب طائرات

145
00:15:55,580 --> 00:15:57,220
.لا أحد هنا

146
00:16:03,270 --> 00:16:06,160
ألا يصعد هذا المصعد أكثر؟

147
00:16:07,900 --> 00:16:08,720
!لاڨي

148
00:16:15,970 --> 00:16:17,440
.هذه

149
00:16:17,440 --> 00:16:20,620
.أجل، إنّها الفانشيب التي أنقذتنا

150
00:16:21,940 --> 00:16:23,170
!لا تلمساها

151
00:16:29,020 --> 00:16:30,210
.كلاوس

152
00:16:33,720 --> 00:16:35,790
...عجبًا، أنت

153
00:16:35,790 --> 00:16:37,350
لِم أتيتَ هنا؟

154
00:16:37,960 --> 00:16:40,390
ألديك شكوى تقدّمها بخصوص تسديد نصف الأجر؟

155
00:16:42,350 --> 00:16:46,230
.لم يسبق وأن شهِدت هبوطًا اضطراريًّا كهذا

156
00:16:46,770 --> 00:16:49,870
.لدينا شكوى نقدّمها إليكما أيضا

157
00:16:49,870 --> 00:16:54,400
.لقد خدشتما السيلڨانا بتلك الخردة التي تحلّقان بها

158
00:16:54,780 --> 00:16:56,340
خردة؟

159
00:16:56,340 --> 00:17:03,250
!أيجدر بنا أن نذيقكما ما نفعله بمن يخدش السيلڨانا؟

160
00:17:03,750 --> 00:17:05,540
.إنّني هنا لأجل العمل وحسب

161
00:17:06,150 --> 00:17:11,670
لا أظن أن توصيل هذا الحيوان المحشو هو ما أتى بكما إلى هنا، أليس كذلك؟

162
00:17:13,430 --> 00:17:14,660
!صحيح

163
00:17:14,660 --> 00:17:20,030
!طٌلِبَ منّا إيصالهُ لـ(أل)، الفتاةِ التي أخذتموها

164
00:17:20,540 --> 00:17:21,860
.كان ذلك طلبًا من عميلنا

165
00:17:32,450 --> 00:17:36,030
.أنا محض مرسول، سأغادر حالما تنتهي مهمّتي

166
00:17:36,450 --> 00:17:39,150
.يروقني هذا الفتى

167
00:17:39,150 --> 00:17:42,330
أتفحصته بالفعل يا غيل؟

168
00:17:42,660 --> 00:17:47,290
...يبدو أنّ لديه مفهومًا خاطئًا لمعنى الشجاعة

169
00:17:47,760 --> 00:17:50,360
.ربّاه، لم تترك لنا أي خيار

170
00:17:51,000 --> 00:17:54,220
.هات شحنتك أيها المرسول

171
00:17:58,010 --> 00:18:01,010
.ينصّ الطلب على أن أسلّم الشُحنة شخصيًا

172
00:18:01,010 --> 00:18:05,850
أهذا أسلوب تتصرف به تجاه من يحاول أن يسديك خدمة؟

173
00:18:06,350 --> 00:18:10,310
.يبدو أنه يتحضّر علينا أن نلقّنه درسًا في ذلك

174
00:18:11,220 --> 00:18:15,420
!هذا سيئ يا كلاوس، يستحسن ألّا تغضبهم أكثر

175
00:18:15,420 --> 00:18:18,220
.ألا تذكر الشائعات؟ كلّي ثقة أنّها حقيقة

176
00:18:18,830 --> 00:18:20,200
.سأتحرّاها بنفسي

177
00:18:21,260 --> 00:18:22,200
!مهلًا

178
00:18:24,700 --> 00:18:25,800
.تنحَّ

179
00:18:25,800 --> 00:18:29,570
.ماذا؟ طلب منّي التنحي

180
00:18:29,570 --> 00:18:32,380
!لا بدّ أنّه شخصيّة مهمّة تبعًا لطريقة كلامه

181
00:18:34,180 --> 00:18:35,240
!كلاوس

182
00:18:36,040 --> 00:18:39,220
.لا شك أنك لا تدرك أين أنت

183
00:18:41,550 --> 00:18:44,850
.قد باشرت عملك بسرعةٍ يا كوستابي

184
00:18:45,250 --> 00:18:47,770
.حسنٌ، من الأفضل أن نتخلّص من القمامة

185
00:18:47,770 --> 00:18:48,770
!لا تلمسها

186
00:18:52,060 --> 00:18:52,990
.أمسكتها

187
00:18:52,990 --> 00:18:54,270
!أعدها

188
00:19:00,030 --> 00:19:03,240
!أعدها

189
00:19:08,580 --> 00:19:09,330
!كلاوس

190
00:19:24,760 --> 00:19:26,890
!قائدة السِّرب! تحيّة

191
00:19:28,890 --> 00:19:30,060
!ابتعدا

192
00:19:31,070 --> 00:19:33,600
كلاوس، هل أنت بخير؟

193
00:19:49,180 --> 00:19:50,580
ما اسمك؟

194
00:19:52,650 --> 00:19:55,880
.سألتك القائدة عن اسمك، فأجبها

195
00:19:58,730 --> 00:20:00,760
.كلاوس ڨالكا

196
00:20:02,030 --> 00:20:03,220
.سأتذكّره

197
00:20:08,370 --> 00:20:09,980
.أجهزة التحكم، فُحِصت

198
00:20:10,570 --> 00:20:13,480
.فحص العدّادات والساتِر

199
00:20:13,480 --> 00:20:16,280
.محبس الوقود، مستقرّ

200
00:20:16,280 --> 00:20:17,980
.الخليط، مُوسِر

201
00:20:18,480 --> 00:20:21,570
.فحص ما قبل الطيران، اكتمل

202
00:20:22,750 --> 00:20:23,530
.تحقُّق

203
00:20:30,990 --> 00:20:34,540
،بالنسبة للفتاة التي تبحثان عنها، توجّها إلى حجرة القيادة واستعلِما أمرها هناك

204
00:20:35,260 --> 00:20:36,500
.شكرًا

205
00:20:37,260 --> 00:20:38,550
ما اسمك؟

206
00:20:40,570 --> 00:20:42,840
ألن تخبريني اسمك بالمقابل؟

207
00:20:42,840 --> 00:20:44,830
مع من تظنّ نفسك تتحدّث؟

208
00:20:46,510 --> 00:20:49,890
.اسمي تاتيانا، تاتيانا ويسلا

209
00:20:50,710 --> 00:20:52,390
.سأتذكّره

210
00:20:58,620 --> 00:20:59,570
...يا هذا

211
00:21:00,590 --> 00:21:04,650
.لمن النادر أن تسأل القائدة ويسلا شخصًا عن اسمه

212
00:21:37,890 --> 00:21:41,230
.هل أنت بخير؟ لا بدّ أنّ حجرة القيادة في هذا الطابق

213
00:21:41,830 --> 00:21:42,730
.أجل

214
00:21:52,340 --> 00:21:53,540
!أليكس

215
00:21:54,340 --> 00:21:55,910
أيعقل أنّنا أخطأنا الغرفة؟

216
00:21:56,710 --> 00:21:58,170
.أدهشني لحاقكما بنا

217
00:21:59,280 --> 00:22:01,280
أين أل؟

218
00:22:01,280 --> 00:22:04,210
...إنّنا هنا لإيصال شيء إلى أل

219
00:22:06,890 --> 00:22:08,010
.كلاوس

220
00:22:09,690 --> 00:22:11,320
!تماسك يا كلاوس

221
00:22:13,190 --> 00:22:15,630
.كلاوس

222
00:22:15,630 --> 00:22:17,060
!كلاوس

223
00:23:52,160 --> 00:23:54,800
!أل، يا للطمأنينة

224
00:23:54,800 --> 00:23:55,830
كلاوس؟

225
00:23:56,630 --> 00:23:59,120
.كلاوس أمامك مباشرةً يا أل

226
00:24:00,200 --> 00:24:03,000
.يا كلاوس، تقول أل إنها خائفة

227
00:24:03,000 --> 00:24:06,480
ألا يمكنكَ فعل شيءِ حيال هذا الوجه الذي هو ثلاثة أضعاف حجمه الطبيعي؟

228
00:24:06,480 --> 00:24:08,130
.القول أسهل من الفعل

229
00:24:10,220 --> 00:24:16,390
هجومُ الحكم

230
00:24:11,350 --> 00:24:15,250
الحلقة المقبلة من الملاذ الأخير
الحلقة السادسة: هجومُ الحَكم

231
00:24:15,250 --> 00:24:16,350
.تطلّعوا إليها رجاءً

232
00:24:16,350 --> 00:24:18,550
حسنٌ، حسنٌ، تريدني أن أقولها عنك، أليس كذلك؟

233
00:24:16,390 --> 00:24:21,360
هجومُ الحكم

234
00:24:18,550 --> 00:24:21,270
!جميعًا، تطلّعوا إلى حلقة الأسبوع القادم