202
00:12:18,090 --> 00:12:21,840
أيّتها الإلهة، أعيدي إلينا الآن
.اللّهب المقدّس الّذي أوقدته كلماتك

203
00:12:18,390 --> 00:12:19,990
ماذا؟ عِمْليق؟

204
00:12:19,990 --> 00:12:21,370
أليست عملاقًا؟

205
00:12:21,840 --> 00:12:25,340
امنحيني نارك المتّقدة، لا لمحاربة
.الظّلام، بل لإنارته

206
00:12:22,770 --> 00:12:25,340
.ستحتاج لوسي إلى بعض الوقت لإكمال ترنيماتها

207
00:12:25,900 --> 00:12:28,100
لا يبدو أنّ فوجيان ونينا
.قادران على الحركة

208
00:12:28,550 --> 00:12:29,920
أظنّ أنّ عليّ أن أفعل

209
00:12:29,920 --> 00:12:31,100
!ما بوسعي وحدي

210
00:12:38,000 --> 00:12:39,970
!سحر الماء: الضّباب

211
00:12:41,600 --> 00:12:42,610
.عجبًا

212
00:12:42,960 --> 00:12:45,660
أيّتها الإلهة، أليس لديك نصيحة؟

213
00:12:48,320 --> 00:12:50,800
.أنت كثيرة الكلام عادة

214
00:12:50,800 --> 00:12:51,620
!تخفٍّ

215
00:12:53,170 --> 00:12:54,620
ماذا تفعل؟

216
00:12:55,040 --> 00:12:55,870
!تفادٍ

217
00:12:56,800 --> 00:12:57,880
!هل يراني؟

218
00:13:02,150 --> 00:13:03,000
!تفادٍ

219
00:13:09,480 --> 00:13:11,160
...ذلك الخنجر

220
00:13:11,160 --> 00:13:12,860
من أين حصلت عليه؟

221
00:13:14,220 --> 00:13:16,400
إنّه عظيم الشّأن

222
00:13:16,400 --> 00:13:17,900
.أكثر ممّا ينبغي لبشري أنّ يحمله

223
00:13:17,900 --> 00:13:19,400
—ماذا؟ هل

224
00:13:22,130 --> 00:13:23,030
!ماكوتو

225
00:13:27,220 --> 00:13:28,530
.مهلاً

226
00:13:29,280 --> 00:13:30,840
!ذلك الصّوت

227
00:13:30,840 --> 00:13:32,990
أهذه أنت يا سيّدة نوا؟

228
00:13:32,990 --> 00:13:34,720
.يكفي أيّها العجوز

229
00:13:34,720 --> 00:13:36,850
.ذلك الفتى من أتباعي

230
00:13:37,440 --> 00:13:39,790
هكذا إذًا؟

231
00:13:40,120 --> 00:13:41,340
العجوز؟

232
00:13:41,340 --> 00:13:43,420
.حسنًا، أعتذر عمّا بدر منّي

233
00:13:44,340 --> 00:13:46,320
!آخ

234
00:13:46,320 --> 00:13:48,070
.كن ممتنًّا يا ماكوتو

235
00:13:48,070 --> 00:13:50,330
.إيمانك بي هو ما أنقذك

236
00:13:50,330 --> 00:13:51,300
ماذا؟

237
00:13:51,560 --> 00:13:53,940
،ما دمت من أتباع السّيّدة نوا

238
00:13:53,940 --> 00:13:55,950
.فأنت بمثابة فرد من العائلة

239
00:13:55,950 --> 00:13:58,500
هل تعرفان بعضكما يا نوا؟

240
00:13:58,500 --> 00:14:00,440
.أنت جبان للغاية يا ماكوتو

241
00:14:00,440 --> 00:14:02,970
.من المستحيل أن يأكل البشر

242
00:14:04,410 --> 00:14:07,820
.لا، بل بدا متحمّسًا للغاية لالتهامي

243
00:14:07,820 --> 00:14:11,200
.أفزعني هجومك المفاجئ عليّ

244
00:14:11,200 --> 00:14:14,160
.ولم أفعل سوى الدّفاع عن نفسي

245
00:14:14,160 --> 00:14:16,330
...يبدو أنّ العِمْليق يشعر بالذّنب

246
00:14:16,580 --> 00:14:18,800
،عفوًا يا ماكوتو ويا أيّها العجوز

247
00:14:18,800 --> 00:14:20,660
.يبدو أنّ وقتي قد انتهى

248
00:14:20,660 --> 00:14:22,670
.حسنًا، البقيّة بين أيديكم

249
00:14:22,670 --> 00:14:24,340
بين أيدينا؟

250
00:14:26,180 --> 00:14:27,850
حسنًا، أعتذر؟

251
00:14:27,850 --> 00:14:29,590
.لأنّني قطعت إصبعك

252
00:14:30,490 --> 00:14:33,200
هل يمكنك إعادته إلى مكانه؟

253
00:14:33,200 --> 00:14:34,380
.لا بأس

254
00:14:34,380 --> 00:14:36,860
.سينمو من جديد بعد عشرة آلاف سنة

255
00:14:37,350 --> 00:14:39,480
،يسرّني سماع ذلك

256
00:14:39,480 --> 00:14:40,600
على ما أظنّ؟

257
00:14:41,630 --> 00:14:42,940
...عفوًا

258
00:14:42,940 --> 00:14:44,110
ما الّذي يجري هنا؟

259
00:14:45,680 --> 00:14:47,110
.يبدو أنّ الأمور بخير

260
00:14:48,610 --> 00:14:52,120
!هيّا هيّا، تناول الكثير من الطّعام

261
00:14:52,120 --> 00:14:54,610
!كم يذكّرني هذا بالماضي

262
00:14:54,610 --> 00:14:58,620
لا أصدّق أنّني أستطيع التّمتّع
!بخيرات الأرض مجدّدًا

263
00:14:59,380 --> 00:15:04,290
لا أصدّق أنّ هذا الرّجل صديق للإلهة
.الشّرّيرة الّتي يؤمن بها تاكي-دونو

264
00:15:04,720 --> 00:15:05,380
!ماذا؟

265
00:15:05,380 --> 00:15:07,140
!ماكوتو، أنت من أتباع إلهة شرّيرة؟

266
00:15:07,140 --> 00:15:08,560
!لم أكن أعلم ذلك

267
00:15:08,560 --> 00:15:10,130
.لأنّني لم أخبرك قطّ

268
00:15:10,130 --> 00:15:16,720
نحن العماليق موجودون لحراسة
.السّيّدة نوا وبقيّة الجبابرة

269
00:15:16,720 --> 00:15:20,000
لكنّني هُزمت في الحرب قبل
خمسة عشر مليون سنة

270
00:15:20,000 --> 00:15:22,900
.ووُضعتُ تحت ختم التّحجّر ذاك

271
00:15:22,900 --> 00:15:25,890
.وبفضلك تحرّرت أخيرًا

272
00:15:26,510 --> 00:15:29,780
.وفوق ذلك، قدّمت لي الطّعام

273
00:15:30,400 --> 00:15:32,350
هل من أمنية تودّ تحقيقها؟

274
00:15:32,350 --> 00:15:35,330
ماذا؟ أتسألني عن أمنيتي؟

275
00:15:35,330 --> 00:15:36,160
.نعم

276
00:15:39,100 --> 00:15:43,170
أيّها العِمْليق العظيم، هل تسمح لي
بالحصول على إصبعك المقطوع؟

277
00:15:43,170 --> 00:15:43,860
ماذا؟

278
00:15:43,860 --> 00:15:46,170
!لكن لا بأس إن لم يكن ذلك ممكنًا

279
00:15:46,610 --> 00:15:49,850
.إن كان ذلك سيسعدك، فافعل ما تشاء

280
00:15:49,850 --> 00:15:51,470
!أنا ممتنّ لك جزيل الامتنان

281
00:15:51,470 --> 00:15:53,300
ما الّذي ينوي فعله بذلك؟

282
00:15:53,780 --> 00:15:55,300
...والآن

283
00:15:55,300 --> 00:15:59,720
.يبدو أنّك تواجهين صعوبة في التّحكّم بسحرك

284
00:15:59,720 --> 00:16:00,460
ماذا؟

285
00:16:00,460 --> 00:16:01,640
كيف عرفت ذلك؟

286
00:16:01,640 --> 00:16:04,140
.أعيريني عصاك لوهلة

287
00:16:12,140 --> 00:16:15,120
.سيجعل هذا استخدامك لسحر الأرض أسهل

288
00:16:15,120 --> 00:16:15,970
!ماذا؟

289
00:16:15,970 --> 00:16:16,950
!حقًّا؟

290
00:16:17,660 --> 00:16:19,680
...يا إلهة الأرض، كيريس

291
00:16:19,680 --> 00:16:21,970
...يا ابنة الوحشيّين

292
00:16:23,460 --> 00:16:26,280
.أعتذر عمّا بدر منّي سابقًا

293
00:16:26,280 --> 00:16:31,210
،تكفيرًا عن ذنبي
.سأمنحك بركة عِمْليق الأرض

294
00:16:33,490 --> 00:16:34,220
ماذا؟

295
00:16:34,850 --> 00:16:38,220
!عجبًا! أشعر بقوّة ما تتفجّر بداخلي

296
00:16:40,850 --> 00:16:43,730
.هـ-هذه قوّة هائلة

297
00:16:43,730 --> 00:16:44,960
!م

298
00:16:44,960 --> 00:16:46,350
!مذهل

299
00:16:46,730 --> 00:16:49,860
!سحر الأرض: الرّصاصة الصّخريّة

300
00:16:50,630 --> 00:16:51,360
!كلاّ

301
00:16:54,160 --> 00:16:57,370
لم تستطع استخدام سحر الأرض
.إطلاقًا خلال تدريبنا

302
00:16:57,720 --> 00:17:00,070
.مع أنّها لا تزال تفتقر إلى التّحكّم

303
00:16:58,350 --> 00:17:00,070
!أنا آسفة جدًّا

304
00:17:00,070 --> 00:17:01,620
.لا بأس

305
00:17:01,620 --> 00:17:03,080
!يا لحظّهم

306
00:17:03,080 --> 00:17:05,120
تُرى هل يمكنني الحصول على شيء أنا أيضًا؟

307
00:17:05,840 --> 00:17:08,670
.لقد نِلت بالفعل بركة السّيّدة نوا

308
00:17:08,670 --> 00:17:10,280
،ومنحتك كنزًا إلهيًّا

309
00:17:10,280 --> 00:17:12,040
ومع ذلك ما زلت تطمع في المزيد؟

310
00:17:12,040 --> 00:17:15,200
.سيقودك الطّمع المفرط إلى الهلاك

311
00:17:15,200 --> 00:17:16,760
حتّى إنّه يستطيع قراءة أفكاري؟

312
00:17:17,260 --> 00:17:18,790
.حسنًا، لا يهمّ

313
00:17:18,790 --> 00:17:20,750
.أخبرني بأمنيتك

314
00:17:22,240 --> 00:17:25,140
.أريد إنقاذ السّيّدة نوا من معبد قاع البحر

315
00:17:26,050 --> 00:17:28,000
.لا أستطيع فعل ذلك

316
00:17:28,000 --> 00:17:32,160
لكنّ تقديم مصلحة سيّدتنا
على رغباتك الشّخصيّة

317
00:17:32,160 --> 00:17:33,860
.يدلّ على نبل روحك

318
00:17:33,860 --> 00:17:36,280
.دعني أقدّم لك بعض النّصائح

319
00:17:37,020 --> 00:17:39,370
لغة أرواح العناصر الّتي تستخدمها

320
00:17:40,020 --> 00:17:43,620
.ليست لغة ينبغي لك استخدامها باستخفاف

321
00:17:44,080 --> 00:17:48,350
إن أردت استعارة قوّة أرواح
،العناصر بصفتك بشريًّا

322
00:17:48,350 --> 00:17:50,840
،فعليك أن تراها وتتحدّث إليها

323
00:17:50,840 --> 00:17:52,270
.وتصادقها

324
00:17:52,270 --> 00:17:56,110
هذا كلّه جميل، لكنّني لا أستطيع
.رؤية أرواح العناصر

325
00:17:58,410 --> 00:17:59,390
.انظر

326
00:17:59,920 --> 00:18:00,890
ماذا؟

327
00:18:01,940 --> 00:18:03,460
أهذه مانا؟

328
00:18:04,560 --> 00:18:05,740
...هذا رائع

329
00:18:08,190 --> 00:18:11,650
...أرواح العناصر هي المانا نفسها

330
00:18:12,310 --> 00:18:13,400
...فهمت

331
00:18:14,360 --> 00:18:15,910
.عليّ أن أطلب عونها

332
00:18:16,950 --> 00:18:19,840
.كان من الحماقة أن أحاول إخضاعها لأوامري

333
00:18:19,840 --> 00:18:21,660
.يبدو أنّك فهمت

334
00:18:22,080 --> 00:18:24,630
من يفتقرون إلى الموهبة
.لا يستطيعون رؤيتها

335
00:18:24,630 --> 00:18:28,160
.ومع ذلك، يبدو أنّ أرواح العناصر تستلطفك

336
00:18:28,670 --> 00:18:30,280
.واصل السّعي إلى التّحسّن

337
00:18:32,400 --> 00:18:34,380
.والآن، وداعًا

338
00:18:39,280 --> 00:18:41,770
واصل السّعي إلى التّحسّن؟

339
00:18:46,550 --> 00:18:48,430
.قول ذلك أسهل من فعله

340
00:18:48,890 --> 00:18:52,510
بلغتُ الحدّ الأقصى، ولم يعد
.بوسعي فعل أيّ شيء جديد

341
00:18:52,980 --> 00:18:55,820
ما الّذي يُفترض بي فعله بعد الآن؟

342
00:18:56,920 --> 00:18:59,320
...إتقان السّحر 99

343
00:19:00,540 --> 00:19:03,150
.ينبغي أن أسعد ببلوغي الحدّ الأقصى

344
00:19:03,150 --> 00:19:04,190
لماذا لا أشعر بذلك؟

345
00:19:08,070 --> 00:19:09,990
أهذا كلّ ما في الأمر؟

346
00:19:14,090 --> 00:19:15,410
!أيّتها الإلهة؟

347
00:19:16,000 --> 00:19:17,340
.اسمع يا ماكوتو

348
00:19:17,340 --> 00:19:19,840
أنت من أتباعي، صحيح؟

349
00:19:19,840 --> 00:19:22,340
هل تعرف ما هي وظيفة الإلهة؟

350
00:19:22,870 --> 00:19:24,290
جمع القرابين؟

351
00:19:24,290 --> 00:19:25,460
!ليس هذا ما أعنيه

352
00:19:25,460 --> 00:19:27,470
!لستُ بحاجة إلى شيء كهذا! أحمق

353
00:19:27,470 --> 00:19:28,640
!أنصت إليّ

354
00:19:28,640 --> 00:19:32,280
!وظيفة الإلهة هي إرشاد الحملان الضّالّة

355
00:19:32,280 --> 00:19:33,120
...حسنًا

356
00:19:33,120 --> 00:19:35,930
كنتَ قلقًا وفاقدًا للحماسة
!مؤخرًا، أليس كذلك؟

357
00:19:35,930 --> 00:19:39,240
،في مثل هذه الأوقات
!عليك أن تطلب نصيحتي

358
00:19:38,300 --> 00:19:40,740
.مـ-مهلاً، ثدياك يلامسانني

359
00:19:40,740 --> 00:19:42,240
.ذلك عن قصد

360
00:19:43,920 --> 00:19:46,240
لماذا لا تطلب نصيحتي؟

361
00:19:46,240 --> 00:19:49,220
...حسنًا، الاعتماد على إلهة يبدو

362
00:19:49,220 --> 00:19:51,250
.لا بأس، لذا اعتمد عليّ قدر ما تشاء

363
00:19:51,720 --> 00:19:54,360
.هيّا، أعرني كتاب الرّوح للحظة

364
00:19:54,360 --> 00:19:55,130
ماذا؟

365
00:19:56,450 --> 00:19:57,310
.تفضّلي

366
00:19:58,280 --> 00:20:00,380
...والآن، لنجرِ تعديلاً بسيطًا هنا

367
00:20:03,520 --> 00:20:04,270
!خذ

368
00:20:05,070 --> 00:20:06,010
!ماذا؟

369
00:20:06,310 --> 00:20:08,740
!إتقان السّحر 103؟

370
00:20:08,740 --> 00:20:09,770
!ما هذا؟

371
00:20:10,070 --> 00:20:14,840
ماكوتو، أنت من النّوع الّذي يرفع مستواه
إلى 99 في ألعاب تقمّص الأدوار، صحيح؟

372
00:20:14,840 --> 00:20:18,780
لذا شعرتَ بالفتور بعد بلوغك
الحدّ الأقصى من الإتقان، صحيح؟

373
00:20:20,320 --> 00:20:22,030
كشفتِ أمري إذًا؟

374
00:20:23,430 --> 00:20:25,760
ومن تظنّني؟

375
00:20:25,760 --> 00:20:29,000
.سأطلعك أيضًا على معلومة خاصّة

376
00:20:29,000 --> 00:20:33,040
،عندما يتجاوز إتقانك 105
.ستتمكّن من رؤية أرواح العناصر

377
00:20:33,350 --> 00:20:34,180
ماذا؟

378
00:20:34,180 --> 00:20:35,450
!حقًّا؟

379
00:20:35,450 --> 00:20:36,420
!هذا صحيح

380
00:20:36,420 --> 00:20:39,030
أرأيت؟ هل أعاد ذلك إشعال حماستك؟

381
00:20:39,030 --> 00:20:39,920
!نعم

382
00:20:39,920 --> 00:20:41,350
!شكرًا جزيلاً لك

383
00:20:41,880 --> 00:20:43,030
.لا شكر على واجب

384
00:20:43,030 --> 00:20:44,780
.واصل الاجتهاد فحسب

385
00:20:44,780 --> 00:20:45,800
.أراك لاحقًا

386
00:20:46,670 --> 00:20:48,050
...بالمناسبة

387
00:20:48,550 --> 00:20:51,130
.لا يُسمح التّلاعب بكتاب الرّوح

388
00:20:51,130 --> 00:20:54,190
.إن اكتشف أحد أمرك، فسيشنقك المحقّقون

389
00:20:54,620 --> 00:20:56,960
!ما الّذي تقصدينه؟

390
00:20:56,960 --> 00:21:01,250
قرّرت الكنيسة من تلقاء نفسها
.أن الحدّ الأقصى في كتاب الرّوح هو 99

391
00:21:01,250 --> 00:21:04,140
لكنّ الحقيقة هي أن إتقان
،السّحر لا حدّ أقصى له

392
00:21:04,140 --> 00:21:06,700
.لذا عدّلتُه ليُظهر قيمتك الحقيقيّة

393
00:21:07,180 --> 00:21:10,640
،لكن إن علمت هايلاند أو كنيسة روز بالأمر

394
00:21:10,640 --> 00:21:12,880
.فسيعتبرونك مهرطقًا ويعدمونك

395
00:21:11,450 --> 00:21:20,210
"إعدام"

396
00:21:12,880 --> 00:21:13,880
هل فهمت؟

397
00:21:13,880 --> 00:21:14,990
.ماذا؟ انتهى الوقت

398
00:21:14,990 --> 00:21:15,960
.عليّ الذّهاب الآن

399
00:21:15,960 --> 00:21:16,920
!ماذا؟ مهلاً

400
00:21:16,920 --> 00:21:17,690
...مهلاً

401
00:21:17,690 --> 00:21:18,610
ماذا؟

402
00:21:18,610 --> 00:21:20,210
أتريد التّحدّث معي أكثر؟

403
00:21:20,750 --> 00:21:24,640
.حسنًا، أودّ أن أتحدّث معك لوقت أطول

404
00:21:25,120 --> 00:21:27,220
.أنت تصبح فتى صالحًا أكثر فأكثر

405
00:21:27,680 --> 00:21:30,220
واصل على هذا المنوال
وقع حبّي، اتّفقنا؟

406
00:21:30,220 --> 00:21:31,970
.أرجوك توقّفي عن النّظر إليّ هكذا

407
00:21:33,680 --> 00:21:35,230
.ثمّة أمر أخير

408
00:21:36,170 --> 00:21:39,230
.توجّه إلى المتاهة العظمى، لابيرينثوس

409
00:21:41,290 --> 00:21:43,920
.ينتظرك هناك لقاءٌ مميّز

410
00:21:45,970 --> 00:21:49,540
.تلك تعليمات محدّدة بشكل مريب

411
00:21:49,540 --> 00:21:51,840
هل الإلهة بخير؟

412
00:21:54,200 --> 00:21:57,770
.ماكوتو، أنت أعظم أتباعي

413
00:21:58,740 --> 00:22:03,000
.مع أنّ الوقت لم يحن بعد لأكلّفك بأيّ شيء

414
00:23:35,220 --> 00:23:39,980
"الحلقة 6: ماكوتو تاكاتسكي يلتقي بتنّين"