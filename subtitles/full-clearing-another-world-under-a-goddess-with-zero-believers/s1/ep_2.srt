1
00:00:08,820 --> 00:00:09,940
.ماكوتو

2
00:00:11,700 --> 00:00:13,690
!انظر، يمكنك رؤيتها هناك في الأمام

3
00:00:18,800 --> 00:00:21,050
إذًا تلك هي ماكالان؟

4
00:00:25,880 --> 00:00:28,850
!خضروات، قُطفت طازجة هذا الصّباح

5
00:00:28,850 --> 00:00:31,010
!أنصح بالطّماطم اليوم

6
00:00:31,010 --> 00:00:33,740
!لديّ سترة جلديّة قيّمة

7
00:00:33,740 --> 00:00:35,260
!سارعوا فالكمّيّة محدودة

8
00:00:35,260 --> 00:00:36,410
!مرحبًا

9
00:00:36,410 --> 00:00:37,510
!ما رأيك في كأس من الجعّة؟

10
00:00:37,880 --> 00:00:40,430
!لديّ جعّة طازجة وباردة هنا

11
00:00:49,870 --> 00:00:52,790
.تبدأ حياتي كمغامر أخيرًا

12
00:01:14,510 --> 00:01:17,010
اجتياز عالم آخر بالكامل"
"برفقة إلهة لا يؤمن بها أحد

13
00:02:25,560 --> 00:02:29,310
"يخوض ماكوتو تاكاتسكي تحدّيًا"

14
00:02:34,090 --> 00:02:35,360
...عـ-عذرًا

15
00:02:36,900 --> 00:02:38,140
!طاب مساؤك

16
00:02:38,140 --> 00:02:39,890
كيف يمكنني مساعدتك؟

17
00:02:40,150 --> 00:02:42,640
.أودّ التّسجيل كمغامر

18
00:02:42,640 --> 00:02:44,790
.إذًا فهذه هي المرّة الأولى لك معنا

19
00:02:44,790 --> 00:02:46,870
هل معك كتاب الرّوح الخاصّ بك؟

20
00:02:46,870 --> 00:02:47,630
.نعم

21
00:02:48,990 --> 00:02:50,900
.شكرًا جزيلاً

22
00:02:50,900 --> 00:02:52,490
.سأتحقّق منه الآن

23
00:02:55,620 --> 00:02:58,500
.أنا ضعيف، وإحصائيّاتي متوسّطة

24
00:02:58,500 --> 00:03:00,380
.أعلم ذلك بالفعل

25
00:03:01,850 --> 00:03:05,820
.يبدو أنّك بحاجة للمزيد من التّدريب أوّلاً

26
00:03:05,820 --> 00:03:07,350
.ربّما في المرّة القادمة

27
00:03:12,690 --> 00:03:14,390
.لا توجد مشكلة هنا

28
00:03:14,390 --> 00:03:15,030
ماذا؟

29
00:03:15,510 --> 00:03:17,900
.تُخصَّص رتبة معيّنة لكلّ مغامر

30
00:03:17,900 --> 00:03:21,640
.ستبدأ برتبة الحجر

31
00:03:21,640 --> 00:03:22,910
.حسنًا

32
00:03:22,910 --> 00:03:25,770
.سنصدر لك بطاقة نقابة

33
00:03:25,770 --> 00:03:29,050
،سيستغرق إعدادها بضع ساعات
هل يناسبك ذلك؟

34
00:03:29,050 --> 00:03:30,270
.لا بأس بهذا

35
00:03:30,540 --> 00:03:33,190
،ستكون جاهزة بحلول هذا المساء

36
00:03:33,190 --> 00:03:34,900
.لذا يرجى العودة إلينا مجدّدًا

37
00:03:34,900 --> 00:03:36,790
!أتطلّع للعمل معك

38
00:03:36,790 --> 00:03:39,600
.أنا سعيد جدًّا لأنّها لم تُعلّق بأيّ شيء

39
00:03:51,990 --> 00:03:53,220
.يبدو أنّ هذا هو المكان

40
00:03:59,210 --> 00:04:01,180
!أهلاً بك

41
00:04:01,180 --> 00:04:03,430
هل أنت مغامر يا سيّدي؟

42
00:04:04,050 --> 00:04:06,310
لدينا الكثير من السّلع الرّائعة
.لنعرضها عليك

43
00:04:06,310 --> 00:04:09,690
،عفوًا، هل صاحب المتجر
السّيد فوجيوارا، موجود؟

44
00:04:10,160 --> 00:04:12,890
مهلاً، هل أنت تاجر؟

45
00:04:12,890 --> 00:04:15,190
.يمكنني تدوين تفاصيل عرضك التّجاريّ

46
00:04:15,190 --> 00:04:18,430
.لا، لا. أنا صديق له

47
00:04:18,430 --> 00:04:19,950
.اسمي ماكوتو تاكاتسكي

48
00:04:20,970 --> 00:04:22,700
!انتظر لحظة من فضلك

49
00:04:22,700 --> 00:04:24,010
!يا زعيم

50
00:04:24,010 --> 00:04:26,140
!هناك شخص يدعى تاكاتسكي يطلب مقابلتك

51
00:04:26,140 --> 00:04:27,740
!ماذا قلت؟

52
00:04:30,960 --> 00:04:33,210
!أجل! إنّه تاكّي-دونو

53
00:04:33,610 --> 00:04:35,670
!فوجيان! لم أرَك منذ زمن طويل

54
00:04:38,090 --> 00:04:39,970
.شكرًا على الطّعام

55
00:04:39,970 --> 00:04:42,050
.كان لذيذًا للغاية

56
00:04:42,400 --> 00:04:44,570
.أنا سعيد لأنّه أعجبك

57
00:04:44,570 --> 00:04:47,730
،هذا المكان، حانة فتيات القطط
.هو مكان أوصي به بشدّة

58
00:04:48,740 --> 00:04:51,180
أليس السّبب هو حبّك للفتيات القطط فقط؟

59
00:04:51,180 --> 00:04:55,760
ثمّ إنّ تلك العاملة في متجرك كانت
.ظريفة، وكان لديها أذنا أرنب أيضًا

60
00:04:56,820 --> 00:04:59,140
تقصد نينا-دونو؟

61
00:04:59,140 --> 00:05:01,780
.لم أخترها بسبب مظهرها

62
00:05:01,780 --> 00:05:02,890
حقًّا؟

63
00:05:02,890 --> 00:05:04,860
!أنا جادّ

64
00:05:04,860 --> 00:05:06,410
.إنّه أمر مذهل حقًّا

65
00:05:06,410 --> 00:05:08,000
.لديك متجرك الخاصّ

66
00:05:08,000 --> 00:05:09,890
.أنت تحقّق نجاحًا باهرًا في حياتك

67
00:05:10,910 --> 00:05:13,750
عندما رفعتُ مستوى إتقاني
،لمهارة مشغّل الرّوايات المرئيّة

68
00:05:13,750 --> 00:05:16,570
.اكتسبت القدرة على قراءة أفكار الآخرين

69
00:05:16,570 --> 00:05:19,760
وقد أثبتت هذه المهارة فائدةً هائلةً
.في المفاوضات والصّفقات التّجاريّة

70
00:05:19,760 --> 00:05:22,590
فعلاً؟ هل يعني هذا
أنّك تستطيع قراءة الأفكار؟

71
00:05:22,590 --> 00:05:25,690
.لقد أصبحتُ من أتباع إحدى الإلهات

72
00:05:25,690 --> 00:05:26,800
فعلاً؟

73
00:05:26,800 --> 00:05:29,270
.وقد منحتني هذا

74
00:05:29,270 --> 00:05:31,110
هل يمكنك فحصه وتقييمه لي؟

75
00:05:31,110 --> 00:05:32,990
!بالطّبع! اترك الأمر لي

76
00:05:32,990 --> 00:05:34,170
!مـ-مهلاً

77
00:05:34,170 --> 00:05:36,020
...حسنًا، دعني أرى

78
00:05:37,280 --> 00:05:40,090
.تصميم بسيط، لكنّه مزخرف ببراعة

79
00:05:40,090 --> 00:05:44,410
،يبدو النّصل وكأنّه مصنوع من الميثريل
.لكنّه معدن لم أرَ مثله من قبل

80
00:05:44,410 --> 00:05:45,300
ماذا؟

81
00:05:46,540 --> 00:05:48,290
ماذا؟ ماذا؟

82
00:05:48,290 --> 00:05:49,450
...حسنًا

83
00:05:49,450 --> 00:05:51,970
.وُضعت عليه تعويذة تمنع فحصه أو تقييمه

84
00:05:51,970 --> 00:05:52,540
ماذا؟

85
00:05:52,540 --> 00:05:54,370
!لا فائدة، لا فائدة

86
00:05:54,370 --> 00:05:58,910
لقد صقلتُ مهارة التّقييم
!لديّ إلى أقصى حدّ ممكن

87
00:05:59,530 --> 00:06:04,050
ومع ذلك، فهذه جودة استثنائيّة
.لم أرَ مثلها من قبل

88
00:06:04,380 --> 00:06:05,300
ماذا؟

89
00:06:05,300 --> 00:06:07,770
!هـ-هذا السّكّين مذهل

90
00:06:07,770 --> 00:06:09,190
!لا

91
00:06:09,190 --> 00:06:13,070
هذه المادّة المشبّعة بالطّاقة السّحريّة
!هي المعدن الأسطوريّ، الأدامانتيت

92
00:06:13,070 --> 00:06:14,750
!إنّه يتمتّع بمتانة تضاهي متانة الآلهة

93
00:06:14,750 --> 00:06:15,810
!تضاهي الآلهة؟

94
00:06:15,810 --> 00:06:19,480
استخدمت الإلهة قوّتها أيضًا
،لتزويده بقدرات متنوّعة

95
00:06:19,480 --> 00:06:22,450
!الكثير منها لم أسمع به من قبل حتّى

96
00:06:22,450 --> 00:06:27,950
!هذا بلا شكّ أقوى سلاح رأيته في حياتي

97
00:06:28,290 --> 00:06:29,450
.مذهل

98
00:06:29,780 --> 00:06:31,540
.سأعطيك هذا بدلاً من ذلك

99
00:06:31,950 --> 00:06:34,220
!لكنّني لن أسامحك إن أضعتَه

100
00:06:35,170 --> 00:06:37,140
هل أعطتني شيئًا رائعًا كهذا؟

101
00:06:37,140 --> 00:06:38,910
...لكن، هذا

102
00:06:38,910 --> 00:06:41,670
."يُدعى "خنجر الإلهة الشّرّيرة نوا

103
00:06:41,670 --> 00:06:42,700
!إلهة شرّيرة؟

104
00:06:42,700 --> 00:06:43,680
!تبًّا

105
00:06:44,650 --> 00:06:46,380
.ما...؟ مهلاً

106
00:06:46,380 --> 00:06:49,680
ما الّذي يعنيه هذا العالم
بـ"إله شرّير" في المقام الأوّل؟

107
00:06:49,680 --> 00:06:51,310
...بخصوص ذلك

108
00:06:51,310 --> 00:06:53,190
...حسب ما أذكر، تقول الأساطير

109
00:06:53,770 --> 00:06:57,670
أنّ الآلهة الشّرّيرة هي آلهة قديمة
.كانت تحكم العالم الإلهيّ يومًا ما

110
00:06:57,670 --> 00:07:02,700
وفي حرب الجبابرة، وهي حربٌ دارت بين
،الآلهة، تمكّنت الآلهة المقدّسة من هزيمتهم

111
00:07:02,700 --> 00:07:04,950
.وأطلقت عليهم لقب الآلهة الشّرّيرة

112
00:07:04,950 --> 00:07:08,580
.إنّها لا تزال محبوسة ومختومة في مكان ما

113
00:07:08,580 --> 00:07:10,320
.يا للأسف

114
00:07:10,320 --> 00:07:14,570
وقد ظننتُ أنّني حصلتُ أخيرًا على أول ميزة
.استثنائية لي منذ قدومي إلى هذا العالم

115
00:07:14,570 --> 00:07:17,330
سأضطرّ على الأرجح لسؤالها
.عن أمر الآلهة الشّرّيرة هذا

116
00:07:17,920 --> 00:07:20,330
.حاول ألاّ تقوم بأيّ تصرّف متهوّر

117
00:07:20,330 --> 00:07:22,840
...بالمناسبة، هناك شائعات تقول

118
00:07:23,260 --> 00:07:26,010
أنّ ستًّا من كاهنات الآلهة السّبع

119
00:07:26,010 --> 00:07:30,600
قد تلقّين رؤىً تفيد بأنّ ملك الشّياطين
.العظيم سيعود للحياة بعد بضع سنوات

120
00:07:30,600 --> 00:07:32,010
.يا للهول

121
00:07:32,010 --> 00:07:36,410
بل يزعم البعض أنّنا استُدعينا
إلى هذا العالم

122
00:07:36,410 --> 00:07:38,480
.استعدادًا للمعركة ضدّه

123
00:07:39,020 --> 00:07:41,210
.هذا سيناريو شائع جدًّا في الألعاب

124
00:07:41,210 --> 00:07:42,290
أليس كذلك؟

125
00:07:42,780 --> 00:07:46,390
،بالمناسبة يا تاكّي-دونو
ما هي خططك بعد هذا؟

126
00:07:46,390 --> 00:07:49,870
.أخطّط لمواصلة التّدريب كمغامر لفترة من الوقت

127
00:07:51,270 --> 00:07:56,250
ما رأيك في تشكيل فريق معي
لاستكشاف أحد الدّياميس؟

128
00:07:57,270 --> 00:07:58,650
،أنا ممتنّ لعرضك

129
00:07:58,650 --> 00:08:01,000
لكنّني أرغب في البدء بالعمل
.بمفردي لبعض الوقت

130
00:08:01,000 --> 00:08:02,300
.فهمت

131
00:08:02,300 --> 00:08:06,490
ففي نهاية المطاف، يكمن جوهر
.حياة اللاّعب في اللّعب الفرديّ

132
00:08:06,490 --> 00:08:10,760
ومع ذلك، لا تتردّد في التّواصل معي
.إذا واجهتَ أيّ صعوبات

133
00:08:10,760 --> 00:08:12,740
.نعم، شكرًا لك

134
00:08:16,010 --> 00:08:18,520
.لقد تمّ تسجيلك الآن في نقابتنا

135
00:08:18,820 --> 00:08:20,020
.أتمنّى أن تبذل قصارى جهدك

136
00:08:20,730 --> 00:08:21,580
!حاضر

137
00:08:25,030 --> 00:08:28,060
.سأخوض مهمّتي الأولى غدًا

138
00:08:31,030 --> 00:08:32,520
.سأقوم بهذا الأمر

139
00:08:39,020 --> 00:08:41,850
ما الّذي تفعلينه أيّتها الإلهة؟

140
00:08:41,850 --> 00:08:43,820
لا، بل نوا؟

141
00:08:44,970 --> 00:08:47,200
هذا هو اسمك، أليس كذلك؟

142
00:08:48,350 --> 00:08:49,050
.نعم

143
00:08:49,050 --> 00:08:51,060
إذًا، هل أنتِ إلهة شرّيرة؟

144
00:08:51,870 --> 00:08:54,540
.في الوقت الرّاهن، أرجوكِ ارفعي رأسك

145
00:08:54,540 --> 00:08:57,810
من المزعج التّحدّث إليك وأنت
.تتوسّلين بهذا الشّكل

146
00:08:57,810 --> 00:09:00,560
إذًا، هل ستبقى معي بصفتك تابعي؟

147
00:09:01,870 --> 00:09:03,570
!ما قصّة هذا الصّمت؟

148
00:09:03,850 --> 00:09:04,720
!أنا آسفة

149
00:09:04,720 --> 00:09:06,310
!لم أقصد خداعك

150
00:09:06,310 --> 00:09:08,070
.لم أذكر الأمر فحسب

151
00:09:08,070 --> 00:09:09,570
.يبدو هذا كعمليّة احتيال

152
00:09:09,570 --> 00:09:11,190
!إنّها ليست عمليّة احتيال

153
00:09:11,190 --> 00:09:13,290
!ما زلتُ إلهة

154
00:09:13,290 --> 00:09:16,870
لكنّكِ واحدة من الآلهة القديمة
الّتي خسرت الحرب، أليس كذلك؟

155
00:09:17,740 --> 00:09:22,350
وصفُك إيّاي بالقديمة أمرٌ
.مزعجٌ بعض الشّيء

156
00:09:22,350 --> 00:09:26,340
.لقد كنتُ واحدةً من أصغر الجبابرة

157
00:09:26,670 --> 00:09:28,940
.من فضلك، ابحثي عن تابع آخر

158
00:09:28,940 --> 00:09:30,100
!لا أستطيع! لا أستطيع! لا أستطيع

159
00:09:30,100 --> 00:09:31,400
،أنا ضعيفة، ووُصفتُ بأنّني إلهة شرّيرة

160
00:09:31,400 --> 00:09:34,050
لذا استغرق الأمر ألف عام
!لأحصل على تابع واحدٍ فقط

161
00:09:34,050 --> 00:09:35,530
!لا تجعل الأمر يبدو بسيطًا

162
00:09:35,530 --> 00:09:40,100
أجل، لكنّك كنت مهملةً لدرجة أنّك سمحتِ
.لهذا الخنجر بالكشف عن كونك إلهةً شرّيرة

163
00:09:40,100 --> 00:09:41,520
!أنت مخطئ

164
00:09:41,520 --> 00:09:43,880
لم يكن من المفترض أن يظهر ذلك
!عند استخدام مهارة تقييم عاديّة

165
00:09:43,880 --> 00:09:45,830
.إذًا كنتِ تحاولين خداعي فعلاً

166
00:09:45,830 --> 00:09:47,110
...ماذا؟ لا

167
00:09:47,110 --> 00:09:48,860
...أ-أنا

168
00:09:48,860 --> 00:09:51,320
الآلهة المقدّسة وحدها هي من
.تصفني بالإلهة الشّرّيرة

169
00:09:51,320 --> 00:09:53,270
.ما زلتُ إلهةً، على أيّ حال

170
00:09:54,630 --> 00:09:55,620
.نوا

171
00:09:56,240 --> 00:09:57,690
.ما زلتُ تابعًا لك

172
00:09:57,690 --> 00:09:59,500
ماذا؟ حـ-حقًّا؟

173
00:09:59,500 --> 00:10:00,620
.نعم

174
00:10:01,160 --> 00:10:06,630
!يا ماكوتو، أنت تابعي الغالي جدًّا، جدًّا

175
00:10:06,630 --> 00:10:10,160
.بدأتِ تبدين مريبة بكثرة مبالغاتك هذه

176
00:10:10,160 --> 00:10:11,460
.تبدو هادئًا جدًّا

177
00:10:11,460 --> 00:10:14,320
.يا إلهي، مهارتك تلك مزعجة حقًّا

178
00:10:14,320 --> 00:10:18,120
بالمناسبة، هل لديك أيّ توجيهات جديدة لي؟

179
00:10:18,120 --> 00:10:20,670
لماذا أردتَ رسالة مقدّسة بشدّة هكذا؟

180
00:10:20,670 --> 00:10:25,650
لقاء إلهة والحصول على خنجرٍ
.فحسب أمرٌ مخيّبٌ للتّوقّعات قليلاً

181
00:10:25,650 --> 00:10:28,210
،في أغلب الحالات
،يطلبون شيئًا غير منطقيّ

182
00:10:28,210 --> 00:10:30,630
.مثل هزيمة ملك الشّياطين

183
00:10:30,630 --> 00:10:33,030
.هذا أمر نمطيّ في ألعاب تقمّص الأدوار

184
00:10:33,030 --> 00:10:35,440
...حسنًا

185
00:10:35,440 --> 00:10:38,540
ما رأيك بأن أطلب منك أن تأتي لإنقاذي؟

186
00:10:38,540 --> 00:10:40,590
!هذا سيناريو حدثٍ كلاسيكيّ بامتياز

187
00:10:40,590 --> 00:10:42,650
!هذا بالضّبط ما كنت آمله

188
00:10:42,650 --> 00:10:44,450
إذًا، أين أنت؟

189
00:10:45,450 --> 00:10:47,220
...حسنًا، أنا

190
00:10:47,220 --> 00:10:48,540
،أنا في متاهة

191
00:10:49,290 --> 00:10:55,400
معبد قاع البحر، الّذي يُقال أنّه يقع
.في أعمق أعماق محيطات هذا العالم

192
00:10:55,400 --> 00:10:58,390
إنّه ديماس محصّنٌ صعبٌ
.لم يصل إليه البشر بعد

193
00:11:01,370 --> 00:11:03,060
هل تودّ الانسحاب إذًا؟

194
00:11:03,060 --> 00:11:06,560
سماع أنّ الأمر يمثّل تحدّيًا
!يجعلني أكثر حماسة

195
00:11:07,530 --> 00:11:10,070
صحيح، أنت لا تستسلم أبدًا، صحيح؟

196
00:11:10,070 --> 00:11:11,600
.سآتي إليك

197
00:11:11,600 --> 00:11:14,570
.سأنقذك كعربون شكرٍ على الخنجر

198
00:11:14,570 --> 00:11:18,650
أمّا الخنجر، فقد كان شكري لك
.لأنّك أصبحت من أتباعي

199
00:11:18,650 --> 00:11:20,080
.ولكن لا بأس

200
00:11:20,080 --> 00:11:23,930
كما قلتُ سابقًا، احرص على
.ألاّ تنسى صلواتك اليوميّة أبدًا

201
00:11:23,930 --> 00:11:26,030
.أضمن لك أنّ أمورًا جيّدة ستحدث

202
00:11:26,030 --> 00:11:28,590
ستحصل على مكافآت
.لأنّك لا تزال تؤمن بي

203
00:11:28,590 --> 00:11:31,590
يبدو هذا كمكافأة تسجيلِ دخول في ألعاب
.الهواتف الّتي تعتمد على الدّفع للفوز

204
00:11:31,590 --> 00:11:35,520
.شيء من هذا القبيل
.حسنًا، سأنتظرك بصبر

205
00:11:35,520 --> 00:11:37,400
،إذا حرّرتني

206
00:11:37,400 --> 00:11:39,850
!فسأفعل أيّ شيء تطلبه

207
00:11:41,710 --> 00:11:43,450
.لقد بالغتْ في حماستها

208
00:11:43,450 --> 00:11:47,440
هل تكتفي تلك الإلهة بقول
أيّ شيء تظنّ أنّه سيؤثّر عليّ؟

209
00:11:46,010 --> 00:11:49,020
اجتياز عالم آخر بالكامل"
"برفقة إلهة لا يؤمن بها أحد

210
00:11:52,020 --> 00:11:55,030
حسنًا، إذا كنت تبحث عن
...مهمّتك الأولى، فهناك

211
00:11:55,600 --> 00:11:57,750
".صيد ثلاثة أرانب ذات قرون"

212
00:11:57,750 --> 00:12:00,870
نقل بضائع إلى غريت كيث"
".بواسطة عربة

213
00:12:00,870 --> 00:12:03,910
نقل بضائع إلى هايلاند"
".بواسطة عربة

214
00:12:03,910 --> 00:12:04,630
...وأيضًا

215
00:12:04,630 --> 00:12:08,250
عفوًا... هل توجد أيّ مهام
تتضمّن القضاء على الوحوش؟

216
00:12:08,250 --> 00:12:08,760
ماذا؟

217
00:12:08,760 --> 00:12:10,540
أنت تعمل بمفردك، أليس كذلك؟

218
00:12:10,540 --> 00:12:13,900
إذًا، أعتقد أنّ هذه المهام
.هي الأنسب لتبدأ بها

219
00:12:13,900 --> 00:12:15,050
.فهمت

220
00:12:15,770 --> 00:12:17,800
.سأختار إذًا مهمّة صيد الأرانب ذات القرون

221
00:12:18,470 --> 00:12:20,670
.حسنًا، سأسجّل اسمك لهذه المهمّة

222
00:12:20,670 --> 00:12:22,880
،بالمناسبة، إذا صادفت أيّ غوبلن أو أورك

223
00:12:22,880 --> 00:12:24,520
.فيُرجى الإبلاغ عن ذلك

224
00:12:24,520 --> 00:12:25,970
،هناك مهمّة مفتوحة للقضاء عليها

225
00:12:25,970 --> 00:12:28,470
.لذا ستحصل على مكافأة إذا هزمها أحد

226
00:12:28,470 --> 00:12:29,190
فعلاً؟

227
00:12:29,750 --> 00:12:31,400
هل لديك أيّ أسئلة؟

228
00:12:31,400 --> 00:12:33,190
.لا، لا بأس بهذا

229
00:12:33,190 --> 00:12:35,690
.حسنًا، حظًّا موفّقًا

230
00:12:37,830 --> 00:12:42,190
الأرانب ذات القرون
،الّتي أصطادها هي من الفئة 0

231
00:12:42,190 --> 00:12:44,450
.وهي وحوش يمكن حتّى لعامّة النّاس هزيمتها

232
00:12:46,490 --> 00:12:47,080
!ها هو أحدها

233
00:12:47,540 --> 00:12:49,690
!سحر الماء: سهم الجليد

234
00:12:53,090 --> 00:12:54,180
.كنت أعلم

235
00:12:54,180 --> 00:12:57,350
سحري ضعيف جدًّا لدرجة
.أنّني لا أستطيع القضاء عليه

236
00:12:58,090 --> 00:12:59,230
!أنا آسف

237
00:13:01,490 --> 00:13:02,880
.صدتُ ثلاثة الآن

238
00:13:02,880 --> 00:13:04,850
.لقد أتممت مهمّتي الأولى بنجاح

239
00:13:06,010 --> 00:13:07,970
.أظنّ أنّني سأستمرّ في الصّيد قليلاً

240
00:13:11,020 --> 00:13:12,180
ماذا؟

241
00:13:12,180 --> 00:13:13,600
أهذه غوبلن؟

242
00:13:13,600 --> 00:13:15,360
.أعدادها كبيرة

243
00:13:16,300 --> 00:13:18,610
.لقد هزمتُ الغوبلن من قبل

244
00:13:18,940 --> 00:13:21,110
"هل ستقاتل الغوبلن؟"
"نعم" "لا"

245
00:13:21,560 --> 00:13:23,990
...إذا تخلّصتُ من الّتي تعمل بمفردها

246
00:13:23,990 --> 00:13:25,620
ماذا؟ أستقوم بذلك؟

247
00:13:26,440 --> 00:13:28,300
.سأجرب الأمر

248
00:13:38,050 --> 00:13:39,130
!تسلّل

249
00:13:43,210 --> 00:13:44,270
!تجمّد

250
00:13:50,140 --> 00:13:52,140
!رائع! يمكنني فعلها

251
00:13:52,420 --> 00:13:52,990
ماذا؟

252
00:13:52,990 --> 00:13:54,790
هل هزمتَ خمسة من الغوبلن؟

253
00:13:54,790 --> 00:13:56,170
بمفردك تمامًا؟

254
00:13:56,170 --> 00:13:56,900
.نعم

255
00:13:57,350 --> 00:13:58,940
.يا إلهي، لا تتهوّر هكذا

256
00:13:58,940 --> 00:14:00,270
.كان من الممكن أن تتعرّض للأذى

257
00:14:00,270 --> 00:14:01,400
...صحيح

258
00:14:06,830 --> 00:14:08,860
!ماذا؟ عشرة منها؟

259
00:14:08,860 --> 00:14:11,080
هل تعاونت مع مغامرين
آخرين للقضاء عليها؟

260
00:14:11,080 --> 00:14:12,410
.لا، بمفردي

261
00:14:12,410 --> 00:14:13,830
هذا مستحيل، صحيح؟

262
00:14:14,250 --> 00:14:16,940
!لا يمكن لساحر مبتدئ أن يفعل ذلك وحده

263
00:14:16,940 --> 00:14:17,960
!مستحيل

264
00:14:17,960 --> 00:14:20,990
ألم أقل لك ألاّ تكون متهوّرًا؟

265
00:14:24,390 --> 00:14:25,590
!عشرون؟

266
00:14:26,520 --> 00:14:28,600
!عجبًا، أحسنت صنعًا

267
00:14:29,240 --> 00:14:31,970
إذًا أنت هو المستجدّ الّذي يتحدّث عنه الجميع؟

268
00:14:31,970 --> 00:14:33,730
.ابذل قصارى جهدك هناك

269
00:14:38,150 --> 00:14:41,150
!هزمتَ ثلاثين منها دفعة واحدة يا ماكوتو

270
00:14:41,470 --> 00:14:43,400
.نعم، أعتقد ذلك

271
00:14:43,690 --> 00:14:45,200
!كنت أعلم

272
00:14:45,200 --> 00:14:48,410
!كنتُ أعلم أنّك فتىً كفؤ يا ماكوتو

273
00:14:48,410 --> 00:14:52,100
مهلاً يا رجل، إلى أيّ مدى
تحبّ صيد الغوبلن بالضّبط؟

274
00:14:52,100 --> 00:14:54,410
!مرحبًا يا منظّف الغوبلن

275
00:14:55,170 --> 00:14:58,090
!توقّفوا، لا تطلقوا عليه ألقابًا سيّئة كهذه

276
00:14:58,090 --> 00:14:59,670
.لا تهتمّ لما يقولونه

277
00:15:00,580 --> 00:15:03,810
.تمنّيت لو كان لديّ لقبٌ أكثر روعة قليلاً

278
00:15:05,510 --> 00:15:09,160
يا زعيم! ها هي الأرانب
.ذات القرون الّتي طلبتها

279
00:15:09,160 --> 00:15:11,510
!حسنًا، شكرًا لك على مساعدتك الدّائمة

280
00:15:11,510 --> 00:15:13,150
ماذا ستطلب اليوم؟

281
00:15:13,150 --> 00:15:15,390
،هذا على حساب المحلّ
.تقديرًا لمساعدتك الكبيرة لنا

282
00:15:15,390 --> 00:15:18,940
إذًا، سأطلب طبق المشويّات
.ومشروب التّفّاح الغازيّ

283
00:15:18,940 --> 00:15:20,450
.في الحال

284
00:15:20,450 --> 00:15:23,320
بالمناسبة، ما هو مستواك الآن؟

285
00:15:23,320 --> 00:15:24,870
.أعتقد أنّه المستوى 14

286
00:15:24,870 --> 00:15:28,060
،بما أنّك وصلت إلى المستوى 14
.فقد أصبحت مغامرًا مكتمل القدرات

287
00:15:28,060 --> 00:15:29,320
.سيّد لوكاس

288
00:15:29,320 --> 00:15:31,320
!المعذرة

289
00:15:31,320 --> 00:15:32,960
،كنت في الخارج أصطاد تنانين الرّمال

290
00:15:32,960 --> 00:15:35,330
ولم أذق قطرة خمر واحدة
.طوال الأيّام الثّلاثة الماضية

291
00:15:35,330 --> 00:15:37,430
،كانت المكافأة مجزية
.لكنّ العمل كان مقرفًا

292
00:15:37,430 --> 00:15:39,330
.يبدو أنّها كانت فترة عصيبة

293
00:15:39,660 --> 00:15:44,090
ألم يحن الوقت بعد لتخوض
تحدّي ديماس من الرّتبة البرونزيّة؟

294
00:15:44,090 --> 00:15:45,630
.معك حقّ

295
00:15:45,630 --> 00:15:49,090
حسنًا، أخطّط للقيام بذلك
.بمجرّد وصولي إلى المستوى 20

296
00:15:49,090 --> 00:15:51,950
على المبتدئين أن يبذلوا جهدًا
.أكبر وبوتيرة أكثر ثباتًا

297
00:15:51,950 --> 00:15:55,780
!هيّا، أنت من الرّتبة الذّهبيّة، قُل له شيئًا

298
00:15:55,780 --> 00:15:57,600
...حسنًا

299
00:15:58,000 --> 00:15:59,850
.يبدو أنّكم جميعًا تقضون وقتًا ممتعًا

300
00:15:59,850 --> 00:16:02,420
أحضر لي جعّة، واقلِ لي بعض
.الخضروات الطّازجة

301
00:16:02,420 --> 00:16:03,110
.في الحال

302
00:16:03,110 --> 00:16:06,610
!حسنًا، في صحّتكم

303
00:16:10,800 --> 00:16:14,310
!لا شيء يضاهي مشروبًا جيّدًا بعد العمل

304
00:16:14,310 --> 00:16:15,240
!واحدٌ آخر

305
00:16:15,240 --> 00:16:17,120
.تريّثي بالشّرب

306
00:16:17,480 --> 00:16:20,500
،يا ماكوتو، لقد اكتسبتَ الكثير اليوم

307
00:16:20,500 --> 00:16:22,220
!لذا اشرب حتّى ترتوي

308
00:16:22,220 --> 00:16:25,710
.أنا الرّجل الّذي صمد أمام إغراء إلهة

309
00:16:24,350 --> 00:16:25,710
!هيّا، هيّا

310
00:16:25,710 --> 00:16:27,010
.هذا لا شيء بالنّسبة لي

311
00:16:26,670 --> 00:16:28,370
!اشرب، اشرب المزيد

312
00:16:27,010 --> 00:16:28,370
!صفاء الذّهن

313
00:16:29,250 --> 00:16:31,740
.ماري، أنتِ قريبة أكثر من اللاّزم

314
00:16:31,740 --> 00:16:33,270
ممَّ تشعر بالخجل؟

315
00:16:33,270 --> 00:16:34,260
.لا أشعر بالخجل

316
00:16:34,260 --> 00:16:36,210
!تبًّا، ذلك الوغد

317
00:16:34,260 --> 00:16:35,820
.أنت ظريف جدًّا

318
00:16:35,820 --> 00:16:37,200
!توقّفي رجاءً

319
00:16:36,210 --> 00:16:38,270
.منظّف غوبلن غبيّ

320
00:16:38,270 --> 00:16:40,240
!لقد هزمت ثلاثين غوبلن أخرى اليوم

321
00:16:40,240 --> 00:16:42,430
!عمل رائع! عمل رائع

322
00:16:43,560 --> 00:16:46,030
!صيد الغوبلن ليس بالأمر المميّز

323
00:16:46,030 --> 00:16:48,710
ما هذا يا جان؟

324
00:16:48,710 --> 00:16:51,870
!ماكوتو فتى طيّب، لذا لا تفتعل شجارًا معه

325
00:16:51,870 --> 00:16:54,090
.عليكما أن تتوافقا كزميلين مبتدئين

326
00:16:54,090 --> 00:16:55,830
!أنت أيضًا يا لوكاس؟

327
00:16:55,830 --> 00:16:58,900
لماذا لم تعد تعرض عليّ أن تدرّبني؟

328
00:16:58,900 --> 00:17:02,020
،أنا أعتني بالجميع بينما هم في رتبة الحجر

329
00:17:02,020 --> 00:17:05,680
،لكن بمجرّد وصولكم إلى رتبة البرونز
.أتعامل معكم كرجالٍ بالغين

330
00:17:06,250 --> 00:17:08,020
هل سمعت يا لوكاس؟

331
00:17:08,020 --> 00:17:11,430
!سنخوض مهمّة صيد وحوش تاليًا

332
00:17:11,430 --> 00:17:12,650
فعلاً؟

333
00:17:12,650 --> 00:17:13,930
ما هو هدفكم؟

334
00:17:13,930 --> 00:17:15,180
.غولٌ شارد

335
00:17:15,180 --> 00:17:16,970
.فهمت

336
00:17:16,970 --> 00:17:20,060
تلك خطوةٌ ضروريّةٌ
.للارتقاء إلى الرّتبة الحديديّة

337
00:17:20,060 --> 00:17:20,940
!حظًّا موفّقًا

338
00:17:20,940 --> 00:17:23,190
!نعم! يمكنك الاعتماد علينا

339
00:17:32,450 --> 00:17:34,480
.لا تقلق بشأنه

340
00:17:34,480 --> 00:17:37,310
.أنا بخير، لم يزعجني على الإطلاق

341
00:17:37,310 --> 00:17:39,450
سأواصل المضيّ قدمًا بوتيرتي
.البطيئة الخاصّة

342
00:17:39,450 --> 00:17:45,210
لا أعتقد أنّ القضاء على مجموعة
.من الغوبلن يوميًّا يُعدّ وتيرة بطيئة

343
00:17:45,530 --> 00:17:48,460
.لكن بالنّسبة لي، فهذا عملٌ في غاية السّهولة

344
00:17:51,890 --> 00:17:54,980
.هذه هي الغوبلن العشرين لليوم

345
00:17:54,980 --> 00:17:59,160
سأصطاد الآن بعض الأرانب ذات
.القرون لأعود بها إلى حانة الزّعيم

346
00:18:05,660 --> 00:18:08,480
هل هذا... غولٌ شارد؟

347
00:18:09,260 --> 00:18:11,620
.سيكون الانسحاب هو الخيار الأمثل

348
00:18:13,130 --> 00:18:14,750
!إنّه قريب

349
00:18:16,360 --> 00:18:17,240
ماذا؟

350
00:18:21,200 --> 00:18:22,950
هل يوجد وحشٌ آخر في الجوار؟

351
00:18:24,820 --> 00:18:26,000
!ماذا؟

352
00:18:29,820 --> 00:18:31,610
ما هذا الشّيء؟

353
00:18:31,610 --> 00:18:33,760
!ذلك الغول ضخمٌ للغاية

354
00:18:34,150 --> 00:18:35,510
!قاطع الرّياح

355
00:18:43,510 --> 00:18:44,810
!إنّه خطير جدًّا

356
00:18:45,120 --> 00:18:46,100
!لنغادر من هنا

357
00:18:48,100 --> 00:18:49,420
!بسرعة

358
00:18:50,820 --> 00:18:51,960
!هذا سيّئ

359
00:18:53,320 --> 00:18:54,950
"هل ستنقذ الفتاة؟"
"نعم" "لا"

360
00:18:55,370 --> 00:18:57,110
.يمكنك تركها

361
00:18:57,110 --> 00:18:59,450
.شكرًا على النّصيحة

362
00:19:00,120 --> 00:19:00,950
!كلاّ

363
00:19:00,950 --> 00:19:02,160
!لوسي

364
00:19:02,620 --> 00:19:03,460
!لا

365
00:19:05,890 --> 00:19:06,820
...لكن

366
00:19:08,460 --> 00:19:10,460
.مستحيل أن أتخلّى عنها

367
00:19:14,840 --> 00:19:17,340
!سحر الماء: سهم الجليد

368
00:19:21,440 --> 00:19:23,100
!هذه فرصتك! اهربي

369
00:19:24,340 --> 00:19:25,880
!حـ-حسنًا

370
00:19:26,880 --> 00:19:29,610
!مهلاً! لماذا تحاول التّظاهر بالبطولة؟

371
00:19:29,610 --> 00:19:31,740
أنا في ذلك العمر الّذي أرغب
.فيه بالاستعراض قليلاً

372
00:19:31,740 --> 00:19:34,360
لن أسامحك إن متَّ، هل فهمت؟

373
00:19:38,620 --> 00:19:41,370
كنت أعلم أنّ الغيلان قادرة
،على تجديد أجسادها

374
00:19:41,370 --> 00:19:43,630
لكنّني لم أتخيّل أبدًا أن تكون
.العمليّة بهذه السّرعة

375
00:19:43,630 --> 00:19:45,620
!أرأيت؟! ماذا ستفعل الآن؟

376
00:19:48,150 --> 00:19:50,130
!مهلاً، أنا هنا

377
00:19:52,180 --> 00:19:52,880
!ماذا؟

378
00:19:52,880 --> 00:19:54,040
!تفادٍ

379
00:19:58,020 --> 00:19:58,980
!إنّه سريع

380
00:20:01,760 --> 00:20:02,470
!تحرّك

381
00:20:08,630 --> 00:20:09,530
!جيّد

382
00:20:11,230 --> 00:20:13,790
!سحر الماء: المشي على الماء

383
00:20:16,400 --> 00:20:18,640
!اسمع! أنا هنا

384
00:20:24,670 --> 00:20:25,500
.أنا آسف

385
00:20:26,070 --> 00:20:28,500
.يصبح النّهر عميقًا جدًّا بعد تلك النّقطة

386
00:20:33,640 --> 00:20:34,500
!الآن

387
00:20:35,810 --> 00:20:38,260
!سحر الماء: تدفّق

388
00:20:52,350 --> 00:20:53,730
.نجح الأمر

389
00:20:54,270 --> 00:20:55,530
!أنت

390
00:20:55,530 --> 00:20:57,280
هل أنت بخير؟

391
00:20:57,610 --> 00:20:58,630
!نعم

392
00:20:58,630 --> 00:21:00,280
.هزمتُه للتّوّ

393
00:21:07,260 --> 00:21:08,290
!حقًّا؟

394
00:21:11,920 --> 00:21:13,290
...اسمع

395
00:21:11,920 --> 00:21:13,290
!العفو

396
00:21:13,290 --> 00:21:17,050
،أريد إحضار رأس الغول معي
هل يمكنكم مساعدتي في ذلك؟

397
00:21:20,930 --> 00:21:21,850
!مهلاً

398
00:21:21,850 --> 00:21:23,050
!اسمعوا جميعًا

399
00:21:23,050 --> 00:21:25,200
،عضونا الجديد الواعد ماكوتو

400
00:21:25,200 --> 00:21:27,060
!تمكّن من هزيمة غولٍ ضخم

401
00:21:27,370 --> 00:21:29,310
!أجل

402
00:21:29,600 --> 00:21:35,070
من الآن فصاعدًا، لن أسمح لكم بالاستمرار
.في مناداته بمنظّف الغوبلن

403
00:21:35,070 --> 00:21:35,810
!أجل

404
00:21:35,810 --> 00:21:38,190
.هذا يعني أنّنا بحاجة إلى لقب جديد

405
00:21:38,590 --> 00:21:40,610
!ما رأيكم بقاتل الغيلان؟

406
00:21:42,340 --> 00:21:44,810
.لا أعتقد أنّني بحاجة إلى المزيد من الألقاب

407
00:21:50,960 --> 00:21:53,710
.أنا سعيد لأنّ الأمور سارت على ما يرام

408
00:21:56,700 --> 00:21:58,960
مرحبًا، هل تمانع لو انضممتُ إليك؟

409
00:23:35,200 --> 00:24:39,960
الحلقة 3: يضمّ ماكوتو تاكاتسكي"
"عضوًا جديدًا إلى فريقه