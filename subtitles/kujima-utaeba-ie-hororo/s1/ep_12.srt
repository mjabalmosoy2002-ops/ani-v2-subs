1
00:00:20,480 --> 00:00:21,800
.حسنًا

2
00:00:24,920 --> 00:00:27,020
.كلّ شيء في مكانه الآن

3
00:00:33,930 --> 00:00:35,350
!ليس هكذا

4
00:00:35,680 --> 00:00:40,420
ليس تلك الزّاوية. حَاذِها مع
.الزّاوية العلويّة اليمنى هناك

5
00:00:43,210 --> 00:00:45,440
!تقوم بذلك بشكل خاطئ

6
00:00:47,730 --> 00:00:50,300
!أنت فاشل في التّعليم يا سوغورو

7
00:00:50,300 --> 00:00:52,620
!أنت عديم الرّحمة

8
00:00:52,620 --> 00:00:53,200
!ماذا؟

9
00:00:53,200 --> 00:00:55,910
.سوغورو، علّم أراتا أوّلاً

10
00:00:55,910 --> 00:00:59,160
.سأتعلّمها أنا من أراتا

11
00:00:59,160 --> 00:01:02,200
!ماذا؟ هذا ضِعف العمل

12
00:01:02,200 --> 00:01:03,890
.أنتما تُزعجان الجيران

13
00:01:05,870 --> 00:01:08,840
!تعرّضنا للتّوبيخ لأنّك صاخب يا سوغورو

14
00:01:05,870 --> 00:01:10,700
!أنا أُوبَّخ بسببك فحسب

15
00:01:10,700 --> 00:01:12,220
!صوتي ليس عاليًا، أليس كذلك؟

16
00:01:12,220 --> 00:01:14,000
.حرك يديك، لا فمك

17
00:01:14,000 --> 00:01:15,310
—لماذا يجب أن تكون

18
00:01:14,270 --> 00:01:15,310
.كوجيما

19
00:01:16,220 --> 00:01:17,220
.تفضّل

20
00:01:17,220 --> 00:01:19,230
!ماذا؟ كرات الأرزّ

21
00:01:20,280 --> 00:01:21,470
!شكرًا لك

22
00:01:21,470 --> 00:01:23,480
.سأضعها في الكيس

23
00:01:23,480 --> 00:01:25,010
.والصّور أيضًا

24
00:01:25,010 --> 00:01:27,990
وضعتُها في ثلاثة أكياس
.حتّى لا يتسرّب الماء إليها

25
00:01:28,310 --> 00:01:30,480
.لنضع بعض الأوريغامي فيها

26
00:01:34,160 --> 00:01:36,720
.لن تتبلّل الآن

27
00:01:37,800 --> 00:01:39,500
.أنا جاهز

28
00:01:40,230 --> 00:01:41,280
.حسنًا

29
00:03:29,040 --> 00:03:31,330
.حسنًا، اعتنِ بنفسك

30
00:03:31,330 --> 00:03:32,230
.حاضر

31
00:03:34,010 --> 00:03:37,970
.أنا ممتنٌّ جدًّا لمساعدتك في أعمال المنزل

32
00:03:38,670 --> 00:03:40,740
.أبلغ سلامنا لماكسيم

33
00:03:43,800 --> 00:03:46,020
هلاّ... سمحتَ لي؟

34
00:04:37,830 --> 00:04:40,300
.ما زال الظّلام حالكًا

35
00:04:40,300 --> 00:04:43,200
.لا أحد هنا لأنّ القطارات لم تبدأ بالعمل بعد

36
00:04:43,700 --> 00:04:45,010
.لنأخذ وقتنا إذًا

37
00:04:45,430 --> 00:04:46,250
!نعم

38
00:05:14,250 --> 00:05:16,990
.كوجيما! انظر إلى الجسر

39
00:05:17,300 --> 00:05:19,830
.هناك شخص يمشي مع كلب

40
00:05:21,090 --> 00:05:22,820
ماذا نفعل؟

41
00:05:24,870 --> 00:05:28,910
،النّهر منخفض الآن
.لذا لا يوجد مكان للاختباء

42
00:05:32,090 --> 00:05:34,170
!لديّ فكرة

43
00:05:34,170 --> 00:05:35,900
ماذا؟ حقًّا؟

44
00:05:35,900 --> 00:05:38,400
!نعم. دع الأمر لي

45
00:05:44,860 --> 00:05:46,490
.صباح الخير

46
00:05:46,490 --> 00:05:48,990
.صـ-صباح الخير

47
00:05:51,530 --> 00:05:54,290
.مهلاً، لا تنبح. هيّا بنا

48
00:05:54,290 --> 00:05:57,380
المعذرة... ماذا؟

49
00:05:58,530 --> 00:05:59,760
.نباح

50
00:06:00,650 --> 00:06:02,100
.نباح، نباح

51
00:06:14,030 --> 00:06:15,270
...نباح

52
00:06:19,770 --> 00:06:21,530
!لم يكن هذا لينجح أبدًا

53
00:06:21,530 --> 00:06:23,240
!كوجيما! اهرب

54
00:06:23,240 --> 00:06:25,280
!نـ-نباح

55
00:06:40,910 --> 00:06:43,540
!لم ينجح الأمر إطلاقًا

56
00:06:43,540 --> 00:06:45,090
.لقد بالغت في الأمر

57
00:06:45,090 --> 00:06:47,300
.كنت آمل أن نأخذ وقتنا للوصول إلى هنا

58
00:06:57,030 --> 00:06:59,450
.لا يزال مستوى الماء منخفضًا جدًّا

59
00:07:02,660 --> 00:07:04,650
.لننزل إلى الأسفل

60
00:07:15,600 --> 00:07:16,680
.سلطعون

61
00:07:16,680 --> 00:07:17,580
سلطعون؟

62
00:07:17,920 --> 00:07:19,390
.إنّه صغير جدًّا

63
00:07:19,390 --> 00:07:20,970
ربّما لا يزال طفلاً؟

64
00:07:21,670 --> 00:07:26,840
كانت سلطعونات رويكو الّتي
!أكلناها في منزل الجدّ كبيرة

65
00:07:26,840 --> 00:07:28,870
.كانت لذيذة أيضًا

66
00:07:28,870 --> 00:07:30,140
.بالتّأكيد

67
00:07:44,360 --> 00:07:45,980
.بدأت الشّمس تشرق

68
00:07:46,710 --> 00:07:48,860
.يجب أن نذهب

69
00:07:52,370 --> 00:07:53,570
ما الخطب؟

70
00:07:53,570 --> 00:07:56,370
هـ-هل تشعر بالحزن؟

71
00:08:06,830 --> 00:08:08,130
.سيكون كلّ شيء بخير

72
00:08:08,510 --> 00:08:10,830
.سنفترق لنصف عام فقط

73
00:08:12,160 --> 00:08:14,600
.سيمرّ الوقت سريعًا

74
00:11:30,680 --> 00:11:34,160
مرّت الأشهر السّتّة الماضية
بسرعة أيضًا، أليس كذلك؟

75
00:11:35,380 --> 00:11:36,380
.صحيح

76
00:11:37,440 --> 00:11:39,120
.هذا صحيح

77
00:11:39,120 --> 00:11:41,350
.وقد كان ذلك ممتعًا للغاية

78
00:11:48,140 --> 00:11:49,820
عملة عشرة ينّ؟

79
00:12:06,730 --> 00:12:08,040
.هيّا بنا

80
00:12:09,710 --> 00:12:11,640
!حسنًا، عشرون ينّ

81
00:12:11,640 --> 00:12:15,060
،عشر عملات أخرى من هذه
!ويمكنني شراء كرة أرزّ

82
00:12:20,420 --> 00:12:24,670
،في ذلك الوقت
،عندما التقيت بك لأوّل مرّة

83
00:12:24,670 --> 00:12:29,130
كنتُ على وشك العودة إلى روسيا
.بعد أن تناولتُ كرة أرزّ

84
00:12:29,920 --> 00:12:34,450
.لم أجد سِربي، وكنتُ أتضوّر جوعًا أيضًا

85
00:12:35,370 --> 00:12:38,650
!لكنّني سعيد جدًّا لأنّني بقيت

86
00:12:41,950 --> 00:12:43,640
.شكرًا لك

87
00:12:43,640 --> 00:12:46,660
!أنا سعيد جدًّا بلقائك يا أراتا

88
00:12:51,480 --> 00:12:54,020
!سأكون هنا، لذلك سأراك قريبًا

89
00:12:55,200 --> 00:12:59,390
،نعم! وأنا سأعود وأخبرك
!"عدتُ إلى المنزل"

90
00:13:10,240 --> 00:13:13,240
!أراك قريبًا

91
00:13:15,980 --> 00:13:18,580
!رحلة سعيدة

92
00:14:14,220 --> 00:14:16,010
!سأخرج الآن

93
00:19:04,470 --> 00:19:08,320
حقًّا؟ تأخذ دروسًا في اللّغة
الرّوسيّة يا سوغورو؟

94
00:19:08,320 --> 00:19:10,050
.أسمعني ما لديك

95
00:19:10,500 --> 00:19:12,120
.حسنًا، لا أمانع

96
00:19:16,840 --> 00:19:20,930
،إذا كنت تحبّ التّزلّج"
".تعلّم أن تحبّ حمل الزّلاّجة

97
00:19:20,930 --> 00:19:25,690
،يستقبلونك بحسب مظهرك"
".ويودّعونك بحسب عقلك

98
00:19:25,690 --> 00:19:29,690
".العمل ليس ذئبًا، فلن يهرب إلى الغابة"

99
00:19:29,690 --> 00:19:31,690
!كان هذا رائعًا

100
00:19:33,610 --> 00:19:39,700
.لغتك الرّوسيّة فظيعة"
".أكاد لا أفهم منها شيئًا

101
00:19:40,010 --> 00:19:41,110
!ماذا قلتِ؟

102
00:19:42,080 --> 00:19:44,450
"!ادرس بجدّ"

103
00:20:13,860 --> 00:20:15,040
...تاراكو و

104
00:20:15,040 --> 00:20:15,910
...كيريكو يقدّمان

105
00:20:15,910 --> 00:20:17,860
!التّوقّعات الجوّيّة

106
00:20:19,200 --> 00:20:23,670
سيكون شتاء هذا العام دافئًا
!في جميع أنحاء البلاد

107
00:20:23,670 --> 00:20:25,130
!ماذا؟

108
00:20:25,130 --> 00:20:29,750
إذًا سترتبك الطّيور المهاجرة إلى اليابان
!في هذا الوقت من العام

109
00:20:29,750 --> 00:20:31,410
يا إلهي! ماذا نفعل؟

110
00:20:31,410 --> 00:20:34,160
!هل هذا ما يسمّونه الاحتباس الحراريّ؟

111
00:20:34,160 --> 00:20:36,380
!لا تغضب يا كيريكو-سان

112
00:20:48,450 --> 00:20:50,400
كان جيّدًا، أليس كذلك؟

113
00:20:50,400 --> 00:20:51,630
حقًّا؟

114
00:20:51,630 --> 00:20:53,670
.يوم دافئ آخر

115
00:20:54,040 --> 00:20:56,880
ماذا؟ هل قلت شيئًا يا ماكوتو؟

116
00:20:56,880 --> 00:21:00,530
.ماذا؟ لا، لا شيء

117
00:21:30,850 --> 00:21:32,540
كيف حالك؟

118
00:21:32,540 --> 00:21:36,820
بعد رحيلك في أبريل، انتهى
.الرّبيع الدّافئ بسرعة البرق

119
00:21:36,820 --> 00:21:40,660
وشعرت أنّ الصّيف الحارق
.أطول ممّا توقّعت

120
00:21:40,980 --> 00:21:44,820
.لكنّ الجوّ بدأ يبرد أخيرًا

121
00:23:15,730 --> 00:23:16,920
!مرحبًا بعودتك

122
00:23:17,370 --> 00:23:18,920
!عدتُ إلى المنزل

123
00:23:26,260 --> 00:23:29,760
.جئت لرؤيتك ثانية