1
00:00:02,980 --> 00:00:04,110
.ليس هنا

2
00:00:04,110 --> 00:00:05,680
.ليس هنا. ليس هنا

3
00:00:05,680 --> 00:00:06,610
!ليس هنا

4
00:00:07,550 --> 00:00:11,120
!واجبي المدرسيّ للعطلة الشّتويّة ليس هنا

5
00:00:11,120 --> 00:00:15,560
هل نسيته في منزل جدّيك؟

6
00:00:18,620 --> 00:00:21,510
.لا، فكّرتُ في أخذه

7
00:00:21,510 --> 00:00:25,440
لكنّي لم أجده، لذلك أخذتُ
.واجبًا منزليًّا آخر

8
00:00:25,870 --> 00:00:30,000
.ظننتُ أنّه سيكون في مكان ما هنا

9
00:00:30,630 --> 00:00:33,640
!لا بدّ أنّي تركته في المدرسة

10
00:00:34,500 --> 00:00:36,550
يُجبِر معلّم الدّراسات الاجتماعيّة

11
00:00:36,550 --> 00:00:41,220
كلّ تلميذ نسي واجبه المنزليّ
.على تبرير سبب نسيانه

12
00:00:41,650 --> 00:00:45,020
!لذا عليّ تسليمه مهما كان الأمر

13
00:00:46,290 --> 00:00:47,600
.لا مفرّ من ذلك

14
00:00:47,600 --> 00:00:51,680
سأتّصل بمعلّمي وأسأله إن كان
.بإمكاني الحضور إلى المدرسة لأخذه

15
00:00:53,260 --> 00:00:54,920
المدرسة؟

16
00:00:55,530 --> 00:00:57,650
هل ستذهب إلى المدرسة؟

17
00:00:57,650 --> 00:00:59,660
خلال عطلة الشّتاء؟

18
00:00:59,660 --> 00:01:02,540
.نعم. ربّما غدًا

19
00:01:03,580 --> 00:01:06,460
كيف هي المدرسة؟

20
00:01:15,820 --> 00:01:18,460
هل تريد المجيء معي؟

21
00:02:50,020 --> 00:02:56,030
「من عاشر قومًا 40 يومًا، صار منهم」

22
00:02:59,390 --> 00:03:02,040
قال معلّمي أنّه سيكون
.هناك بحلول الثّامنة

23
00:03:02,430 --> 00:03:04,350
.لذلك فلنغادر المنزل بعد السّابعة

24
00:03:08,130 --> 00:03:11,050
.لا أستطيع إغلاق أزرار قميصي بالكامل

25
00:03:11,050 --> 00:03:14,840
.صحيح، رقبتك سميكة

26
00:03:14,840 --> 00:03:17,800
هل نترك الأزرار العلويّة مفتوحة؟

27
00:03:17,800 --> 00:03:21,690
هذا ما يرتديه الأب عادةً، أليس كذلك؟

28
00:03:21,690 --> 00:03:22,560
.نعم

29
00:03:22,560 --> 00:03:27,310
إذا كنت ترتدي بدلة، ربّما ستبدو
.أقلّ إثارة للرّيبة في الخارج

30
00:03:27,310 --> 00:03:29,710
.لذا، أخذت ما كان معلّقًا

31
00:03:30,060 --> 00:03:32,530
،ليس هذا ضروريًّا

32
00:03:32,530 --> 00:03:36,070
لكن بما أنّني بحثت عن طريقة
.ربطها، فلترتدي ربطة عنق

33
00:03:43,340 --> 00:03:44,340
.انتهيت

34
00:03:45,640 --> 00:03:47,830
.ثمّ ارتدِ السّترة

35
00:03:48,290 --> 00:03:51,840
.وهذا ما استخدمته في مهرجان المدرسة

36
00:03:51,840 --> 00:03:57,210
،نراه كثيرًا على التّلفاز
.ويعرف الجميع أنّه قناع

37
00:03:57,210 --> 00:03:59,420
لذا أعتقد أنّ هذا أفضل
.من وجهك كما هو

38
00:04:03,010 --> 00:04:04,280
ما رأيك؟

39
00:04:04,850 --> 00:04:07,100
!نعم، تبدو جيّدًا

40
00:04:08,630 --> 00:04:10,910
،بدلاً من التّجوّل بهيئتك كالمعتاد

41
00:04:10,910 --> 00:04:14,670
سيفترض النّاس أنّك ترتدي زيًّا
.تنكّريًا أو شيئًا من هذا القبيل

42
00:04:14,670 --> 00:04:16,860
.فهمت

43
00:04:19,730 --> 00:04:23,410
.ما زال والداي نائمين، فلنتسلّل للخارج

44
00:04:23,840 --> 00:04:24,840
.حسنًا

45
00:04:30,660 --> 00:04:32,000
.هذا مريب

46
00:04:33,400 --> 00:04:36,550
بما أنّ الوقت مبكّر، لا أعتقد
.أنّه سيكون هناك الكثير من النّاس

47
00:04:36,550 --> 00:04:38,850
،لكن سنسلك الطّريق الخلفيّ
.تحسّبًا لأيّ طارئ

48
00:04:39,360 --> 00:04:40,360
.حسنًا

49
00:05:05,090 --> 00:05:07,660
كم تبقّى من الوقت؟

50
00:05:08,330 --> 00:05:12,910
،أجد صعوبة في التّنفّس
.ولا أستطيع الرّؤية جيّدًا

51
00:05:12,910 --> 00:05:14,580
.أنت تنظر إليها الآن

52
00:05:16,500 --> 00:05:17,670
ماذا؟

53
00:05:19,000 --> 00:05:21,970
!المبنى بأكمله هو المدرسة

54
00:05:21,970 --> 00:05:24,990
!ماذا؟! هذه هي؟

55
00:05:29,000 --> 00:05:32,690
هذه أوّل مرّة أدخل فيها
.من مدخل هيئة التّدريس

56
00:05:39,190 --> 00:05:41,640
.تفضل، ارتد هذين الخفّين

57
00:05:56,760 --> 00:06:00,130
سأذهب لأحضر مفتاح الفصل
.من غرفة هيئة التّدريس

58
00:06:02,990 --> 00:06:04,730
.حسنًا

59
00:06:16,800 --> 00:06:18,730
.إنّها كبيرة

60
00:06:49,040 --> 00:06:50,230
.لقد عدت

61
00:06:51,060 --> 00:06:52,120
هل نذهب؟

62
00:06:52,120 --> 00:06:53,140
.نعم

63
00:06:55,640 --> 00:06:58,380
.هذه كلّها فصول دراسيّة

64
00:06:59,150 --> 00:07:01,020
.رائع

65
00:07:01,650 --> 00:07:03,660
.أنا في السّنة الأولى، الفصل الثّالث

66
00:07:07,160 --> 00:07:11,100
!رائع

67
00:07:15,710 --> 00:07:18,260
هل تجلسون جميعًا على نفس المقاعد؟

68
00:07:18,260 --> 00:07:21,890
،نعم. يجلس التّلاميذ على هذا الجانب

69
00:07:22,210 --> 00:07:25,790
ويقف المعلّم على هذا الجانب
.لتدريس الفصل

70
00:07:26,170 --> 00:07:27,860
.فهمت

71
00:07:28,380 --> 00:07:31,060
هل يمكنني خلع القناع؟

72
00:07:31,060 --> 00:07:32,310
.نعم

73
00:07:41,150 --> 00:07:44,080
!التّلميذ رقم 16، كوجيما-سان

74
00:07:44,080 --> 00:07:47,320
.أخبرني كيف أقرأ هذه الجملة

75
00:07:47,320 --> 00:07:50,370
!إنّها "تدريب شاق" يا سيّدي

76
00:07:50,370 --> 00:07:51,330
!كنتَ وشيكًا

77
00:07:51,330 --> 00:07:53,680
!"إنّها "تعليم حماسيّ

78
00:08:00,580 --> 00:08:04,390
أتمنّى لو كنتَ تستطيع حضور
.الفصل معي هكذا

79
00:08:04,390 --> 00:08:06,340
.أنا لا أريد

80
00:08:06,690 --> 00:08:07,690
فعلاً؟

81
00:08:08,870 --> 00:08:13,940
ما زالت أمامي سنوات من
.الدّراسة في الثّانويّة والجامعة

82
00:08:14,400 --> 00:08:18,100
.أنا سعيدٌ لأنّي لستُ بشريًّا

83
00:08:22,610 --> 00:08:24,840
!نسيتُ أنّني جئتُ لأخذ دفتر تماريني

84
00:08:29,610 --> 00:08:33,140
كدتُ أعود إلى المنزل
.بعد أن استمتعتُ بوقتي

85
00:08:34,690 --> 00:08:36,380
!ها هو ذا

86
00:08:36,380 --> 00:08:39,620
،كنتُ أعلم أنّه سيكون هنا
!لكنّني سعيدٌ بذلك

87
00:08:39,620 --> 00:08:44,610
حسنًا، حصلنا على ما جئنا
.من أجله، لنعد إلى المنزل

88
00:08:44,610 --> 00:08:45,750
.نعم

89
00:08:50,740 --> 00:08:53,880
.سأعيد المفتاح، لذا انتظر هنا

90
00:08:53,880 --> 00:08:55,630
!حسنًا

91
00:08:59,110 --> 00:09:00,890
.يجب أن أرتدي هذا

92
00:09:12,120 --> 00:09:14,690
ما الّذي أخّر كودا كلّ هذا الوقت؟

93
00:09:14,690 --> 00:09:17,610
جاء ليأخذ الواجب، أليس كذلك؟

94
00:09:18,290 --> 00:09:20,330
.ربّما عليّ أن أطمئنّ عليه

95
00:09:30,130 --> 00:09:31,620
!المعذرة

96
00:09:31,620 --> 00:09:34,830
أنا التّلميذ رقم 16 من الفصل 3
.من السّنة الأولى واسمي كودا

97
00:09:37,120 --> 00:09:39,350
.ماذا؟ ليس هنا

98
00:09:40,810 --> 00:09:43,810
.السّنة الأولى، الفصل الثّالث
.السّنة الأولى، الفصل الثّالث

99
00:09:43,810 --> 00:09:46,160
.السّنة الأولى، الفصل الثّالث

100
00:09:53,010 --> 00:09:55,120
.ها قد عدت

101
00:09:56,330 --> 00:09:59,580
.كلاّ، هذا ليس أراتا

102
00:10:00,430 --> 00:10:02,340
!شـ-شخص مريب؟

103
00:10:06,090 --> 00:10:08,340
...أشكّ في ذلك، لكن

104
00:10:08,910 --> 00:10:11,590
هل أنت وليّ أمر تلميذ؟

105
00:10:11,590 --> 00:10:13,130
وليّ أمر"؟"

106
00:10:13,710 --> 00:10:15,520
والد أحد تلاميذنا؟

107
00:10:15,520 --> 00:10:17,250
!أريدك أن تخلع هذا القناع

108
00:10:19,600 --> 00:10:21,200
.سأتّصل بالشّرطة

109
00:10:21,200 --> 00:10:23,350
.تعال معي إلى غرفة هيئة التّدريس

110
00:10:23,350 --> 00:10:24,370
.هذا سيّئ

111
00:10:24,370 --> 00:10:29,100
.إنّه غاضبٌ جدًّا، ولن يستمع إليّ

112
00:10:32,160 --> 00:10:34,110
!مهلاً! عد إلى هنا

113
00:10:37,620 --> 00:10:39,330
...ما الّذي

114
00:10:39,330 --> 00:10:40,700
!ماذا؟

115
00:10:40,700 --> 00:10:45,560
هل يرتدي قناعًا آخر تحته؟

116
00:10:45,560 --> 00:10:47,710
.هذا مريب جدًّا

117
00:10:48,630 --> 00:10:49,670
".هذا مؤلم"

118
00:10:49,670 --> 00:10:50,550
ماذا؟

119
00:10:51,380 --> 00:10:53,720
"ما الّذي فعلته لأستحقّ هذا؟"

120
00:10:53,720 --> 00:10:57,140
".لم أفعل أيّ شيء خاطئ"

121
00:10:57,140 --> 00:11:00,890
"...كلّ من يراني يبدأ فورًا بـ"

122
00:11:02,140 --> 00:11:04,600
"!!!سئمتُ من كلّ هذا"

123
00:11:09,810 --> 00:11:11,850
.خرج الأمر عن السّيطرة

124
00:11:14,800 --> 00:11:15,800
.حسنًا

125
00:11:17,490 --> 00:11:22,240
المعذرة يا معلّم؟ هل كلّ شيء بخير؟

126
00:11:22,240 --> 00:11:24,750
!كودا! لا تقترب من هنا

127
00:11:24,750 --> 00:11:28,690
،ثمّة شخصٌ مُريبٌ هنا
!لذا اخرج من هنا

128
00:11:29,010 --> 00:11:30,250
!بسرعة

129
00:11:31,250 --> 00:11:32,880
أيّها المعلّم؟

130
00:11:32,880 --> 00:11:33,970
ماذا؟

131
00:11:33,970 --> 00:11:39,370
.لا أرى... الشّخص الّذي تتحدّث عنه

132
00:11:41,140 --> 00:11:42,160
ماذا؟

133
00:11:44,140 --> 00:11:45,780
.لا، إنّه هنا

134
00:11:46,980 --> 00:11:48,650
!ذهب؟ إلى أين؟

135
00:11:50,480 --> 00:11:57,430
،قبل أن أتحدّث إليك
.كنتَ تُحدّث نفسك

136
00:11:59,290 --> 00:12:00,290
ماذا؟

137
00:12:02,410 --> 00:12:07,140
،أعدتُ المفتاح إلى غرفة هيئة التّدريس
.لذا سأذهب إلى المنزل الآن

138
00:12:07,480 --> 00:12:10,080
.شكرًا لمجيئك اليوم

139
00:12:12,960 --> 00:12:16,910
.حـ-حسنًا. انتبه لنفسك

140
00:12:21,750 --> 00:12:23,370
.حمدًا على هذا

141
00:12:23,370 --> 00:12:26,430
.من الجيّد أنّك هربت بسرعة

142
00:12:26,430 --> 00:12:28,040
.كان ذلك مخيفًا

143
00:12:28,040 --> 00:12:31,440
.كان غاضبًا منّي جدًّا

144
00:12:31,440 --> 00:12:34,520
ما كان ذلك؟

145
00:12:31,440 --> 00:12:35,820
في الحقيقة، أعتقد أنّه كان
.خائفًا أكثر منك

146
00:12:34,520 --> 00:12:35,820
بشريّ؟

147
00:12:35,820 --> 00:12:36,820
وهم؟

148
00:12:36,820 --> 00:12:37,800
حلم؟

149
00:12:39,250 --> 00:12:40,630
.هيّا بنا إلى المنزل

150
00:12:40,630 --> 00:12:44,230
.أشعر بالأسف على معلّمي

151
00:12:47,770 --> 00:12:49,740
.بدأ فصل دراسيّ جديد

152
00:12:51,460 --> 00:12:55,740
.وتحدّث المعلّم عمّا حدث في كلّ حصّة

153
00:12:56,250 --> 00:12:59,420
...فضائيّ يرتدي بدلة

154
00:12:59,820 --> 00:13:02,820
...شبح يرتدي قناع حصان

155
00:13:03,290 --> 00:13:08,090
لكن نظرًا لعدم منطقيّة
.قصته، لم تُصدّق كثيرًا

156
00:13:22,050 --> 00:13:25,490
هل من المنطقيّ التّدرّب تحت المطر؟

157
00:13:25,490 --> 00:13:28,750
تحاول جميع الفرق الرّياضيّة
.مشاركة مساحة محدودة

158
00:13:28,750 --> 00:13:31,520
.خرج أراتا من المدرسة بسرعة كبيرة

159
00:13:32,070 --> 00:13:33,750
.كم أحسده

160
00:13:33,750 --> 00:13:36,500
!هذا صحيح! تبًّا لأراتا

161
00:13:37,010 --> 00:13:42,760
قبل أن يغادر، تحدّث عن العشاء
!بينما كنّا نوشك أن نبدأ التّدريب

162
00:13:43,330 --> 00:13:46,640
!سنتعشّى اليوم بيروغي

163
00:13:46,640 --> 00:13:49,410
مهلاً، أهو بيروغو؟

164
00:13:49,410 --> 00:13:51,050
أم بيروجو...؟

165
00:13:51,450 --> 00:13:52,700
...بيرو

166
00:13:53,890 --> 00:13:57,800
!لا يهمّ. حان وقت العودة للمنزل

167
00:13:59,250 --> 00:14:01,860
.أخبرني بذلك أثناء واجب التّنظيف

168
00:14:02,220 --> 00:14:03,900
.بيرو، بيرو، بيرو

169
00:14:03,900 --> 00:14:06,410
راودني الفضول لمعرفة أيّ
...نوع من الأطعمة كان

170
00:14:06,410 --> 00:14:11,260
.بيرو، بيرو، بيروبيرو، بيرو

171
00:14:07,730 --> 00:14:11,260
.كنتُ جائعًا أثناء تدريبنا

172
00:14:11,660 --> 00:14:17,250
.لذا، سأمرّ على منزل أراتا لأرى ما هو

173
00:14:17,250 --> 00:14:18,310
أترافقني؟

174
00:14:18,760 --> 00:14:20,040
.هذا غير متوقّع

175
00:14:32,490 --> 00:14:34,440
هل تعرف أين يسكن؟

176
00:14:34,440 --> 00:14:37,720
.ذهبتُ مرّةً لأخذ المانغا الّتي أعرته إيّاها

177
00:14:37,720 --> 00:14:39,800
.لكننّي لم أدخل منزله

178
00:14:39,800 --> 00:14:40,560
ماذا؟

179
00:14:42,290 --> 00:14:43,460
...أهذا

180
00:14:46,780 --> 00:14:48,070
إنسان؟

181
00:14:58,510 --> 00:15:00,450
...ذ-ذلك

182
00:15:00,450 --> 00:15:02,960
!ذلك ليس إنسانًا

183
00:15:04,750 --> 00:15:06,450
.مـ-مهلاً لحظة

184
00:15:06,450 --> 00:15:08,530
!هذا منزل أراتا

185
00:15:10,370 --> 00:15:13,270
أينظر حوله ليتأكّد أنّ لا أحد يراقبه؟

186
00:15:13,270 --> 00:15:15,150
!هذا مريب جدًّا

187
00:15:15,920 --> 00:15:17,980
.إنّه يدخل منزل أراتا

188
00:15:26,290 --> 00:15:28,740
مرحبًا؟ هذا أنت يا إيجي؟

189
00:15:28,740 --> 00:15:32,930
أراتا؟ رأينا للتّوّ شخصًا
.مريبًا جدًّا يدخل منزلك

190
00:15:32,930 --> 00:15:34,250
هل أنت بخير؟

191
00:15:34,250 --> 00:15:35,270
!ماذا؟

192
00:15:35,270 --> 00:15:38,230
ر-ربّما أنت مخطئ؟

193
00:15:38,230 --> 00:15:41,790
!لا، إيتشينو رآه أيضًا

194
00:15:41,790 --> 00:15:44,440
.شيء كبير وأبيض وأسود

195
00:15:45,050 --> 00:15:49,090
...حسنًا، هذا... كان

196
00:15:49,090 --> 00:15:51,060
!يا أراتا

197
00:15:51,060 --> 00:15:55,620
—استعرتُ مظلّة من ميتسوكي-سان اليوم، لذا

198
00:15:53,210 --> 00:15:55,620
!مـ-مهلاً يا كوجيما

199
00:15:55,620 --> 00:15:57,610
...صـ-صـ-صديقاي قد

200
00:16:11,730 --> 00:16:13,360
.ادخلا

201
00:16:17,910 --> 00:16:21,660
.لذلك سيمكث كوجيما معنا حتّى الرّبيع

202
00:16:21,660 --> 00:16:23,960
لكنّنا نحاول تجنّب أن يرانا أحد

203
00:16:23,960 --> 00:16:27,170
لأنّ كوجيما على الأرجح
.نوع جديد من الحيوانات

204
00:16:27,170 --> 00:16:28,300
...لهذا السّبب

205
00:16:29,250 --> 00:16:30,930
!مهلاً، هل تستمعان؟

206
00:16:30,930 --> 00:16:31,930
!لا أستمع

207
00:16:31,930 --> 00:16:33,300
لِمَ لا؟

208
00:16:34,640 --> 00:16:37,040
ما الّذي تفعلانه؟

209
00:16:37,040 --> 00:16:38,120
ما هذه الوضعيّة؟

210
00:16:38,120 --> 00:16:40,220
!أنا خائف جدًّا من النّظر

211
00:16:41,710 --> 00:16:45,660
.لطالما قلت أنّني لا أحبّ أفلام الرّعب

212
00:16:45,660 --> 00:16:49,700
.هذا يُثير خوفي بشدّة

213
00:16:49,700 --> 00:16:51,250
!كوجيما ليس مخيفًا

214
00:16:51,250 --> 00:16:53,580
!تأمّلا جيّدًا قبل أن تقولا ذلك

215
00:16:53,580 --> 00:16:56,550
.عينا كوجيما مستديرتان وظريفتان

216
00:16:58,590 --> 00:17:00,180
.ظريفتـ... كلاّ

217
00:17:12,080 --> 00:17:17,720
أراتا، هل يمكنك أن تحاول رسم كوجيما؟

218
00:17:17,720 --> 00:17:18,730
ماذا؟

219
00:17:18,730 --> 00:17:26,560
على عكسنا، ربما غُسِل دماغك
.لتظنّ أنّ كوجيما ظريف

220
00:17:27,470 --> 00:17:31,150
...ربّما عيناه واسعتان في الواقع

221
00:17:37,330 --> 00:17:38,870
!تراه كما نراه

222
00:17:40,590 --> 00:17:42,520
.لا أمل إذًا

223
00:17:42,520 --> 00:17:47,010
معاييرك عمّا هو ظريف تختلف
.عن معاييرنا من الأساس

224
00:17:47,010 --> 00:17:48,630
!إنّه ظريف، مفهوم؟

225
00:17:52,800 --> 00:17:55,410
وما خطبك يا إيتشي؟

226
00:17:55,410 --> 00:17:57,390
...أنت تضغط المنطقة بين عينيك

227
00:17:57,860 --> 00:18:01,140
.أنا أخاف من الأشياء المدبّبة

228
00:18:01,970 --> 00:18:03,710
.ا-الأشياء المدبّبة

229
00:18:04,840 --> 00:18:09,000
،عندما يُوجَّه شيء مدبّب نحوي
.تبدأ المنطقة بين عينيّ بالنّبض

230
00:18:12,030 --> 00:18:15,010
!كفى. كلاكما

231
00:18:15,010 --> 00:18:18,260
.كنتُ متوتّرًا عندما عرفتما بأمر كوجيما

232
00:18:19,020 --> 00:18:24,090
!لكنّني كنت آمل أن نلعب نحن الأربعة معًا

233
00:18:26,000 --> 00:18:27,000
!أراتا

234
00:18:27,000 --> 00:18:31,340
انتظر! إلى أين أنت ذاهب
!وتتركنا وحدنا معه؟

235
00:18:58,280 --> 00:19:00,540
!لماذا لا يتكلّم أحد؟

236
00:19:00,950 --> 00:19:02,660
!أخفتني

237
00:19:02,660 --> 00:19:05,410
.تركتكم أنتم الثّلاثة معًا

238
00:19:05,410 --> 00:19:06,920
لماذا تخجلون؟

239
00:19:06,920 --> 00:19:11,550
،لو استطعتَ ارتداء هذا
.فسيصير الوضع أفضل بكثير

240
00:19:11,550 --> 00:19:15,180
.عمّ تتحدّث؟ إيتشي هو من سيرتديه

241
00:19:15,180 --> 00:19:15,880
!أنا؟

242
00:19:16,840 --> 00:19:17,810
ماذا؟

243
00:19:17,810 --> 00:19:18,930
لماذا؟

244
00:19:18,930 --> 00:19:21,420
!ولماذا في رأيك؟

245
00:19:21,420 --> 00:19:29,190
لماذا يرتدي كوجيما هذا لأشخاص
!أتوا إلى منزلي دون سابق إنذار؟

246
00:19:29,780 --> 00:19:33,280
.سيحدّ هذا من رؤيتك، وهذا سيساعدك

247
00:19:34,230 --> 00:19:36,660
.إيجي، أحضرتُ لك قناعًا للعين

248
00:19:38,670 --> 00:19:40,850
.حجّتك منطقيّة

249
00:19:41,260 --> 00:19:42,810
.أوافقك الرّأي

250
00:19:49,240 --> 00:19:53,200
.ماذا؟ ثمّة رائحة زكيّة

251
00:19:53,890 --> 00:19:56,090
.لا أشمّ إلاّ رائحة المطّاط

252
00:19:56,620 --> 00:19:58,590
!يا رفاق

253
00:19:58,590 --> 00:20:02,350
.أرجوكم توقّفوا عن الشّجار من أجلي

254
00:20:08,850 --> 00:20:10,860
.كنتُ أطهو هذا في الفرن

255
00:20:10,860 --> 00:20:13,110
!إنّه جاهز

256
00:20:13,110 --> 00:20:15,760
!رائع! يبدو شهيًّا

257
00:20:15,760 --> 00:20:17,630
!ماذا؟! أنت من طبخه؟

258
00:20:18,240 --> 00:20:22,620
أهذا البيرو... البيرو...؟

259
00:20:23,030 --> 00:20:24,160
"!بيروغ"

260
00:20:24,160 --> 00:20:27,120
.إنّها فطيرة محشوّة باللّحم والخضار

261
00:20:27,120 --> 00:20:31,140
.يتغيّر الاسم بين المفرد والجمع

262
00:20:31,140 --> 00:20:36,630
.بيروشكي" تعني فطيرة صغيرة"

263
00:20:36,630 --> 00:20:38,110
بيروغ؟

264
00:20:38,110 --> 00:20:39,040
بيروغي؟

265
00:20:39,040 --> 00:20:41,390
...بـ-بيروزو

266
00:20:41,550 --> 00:20:46,560
".بيروغي، بيروغ. بيروشكي، بيروجوك"

267
00:20:47,070 --> 00:20:48,020
.دوركم

268
00:20:48,020 --> 00:20:53,520
.بيروغي، بيروغ. بيروشكي، بيروجوك

269
00:20:53,520 --> 00:20:59,220
".بيروغي، بيروغ. بيروشكي، بيروجوك"

270
00:20:59,220 --> 00:21:04,790
.بيروغي، بيروغ. بيروشكي، بيروجوك

271
00:21:04,790 --> 00:21:10,350
".بيروغي، بيروغ. بيروشكي، بيروجوك"

272
00:21:10,350 --> 00:21:15,800
.بيروغي، بيروغ. بيروشكي، بيروجوك

273
00:21:15,800 --> 00:21:21,550
".بيروغي، بيروغ. بيروشكي، بيروجوك"

274
00:21:21,550 --> 00:21:27,030
.بيروغي، بيروغ. بيروشكي، بيروجوك

275
00:21:27,030 --> 00:21:32,640
".بيروغي، بيروغ. بيروشكي، بيروجوك"

276
00:21:32,640 --> 00:21:38,070
.بيروغي، بيروغ. بيروشكي، بيروجوك

277
00:21:38,070 --> 00:21:43,820
".بيروغي، بيروغ. بيروشكي، بيروجوك"

278
00:21:40,850 --> 00:21:43,820
أيستدعون شيطانًا؟

279
00:21:45,410 --> 00:21:48,830
.يبدو أنّهما هدآ بعد تناول البيروغ

280
00:21:48,830 --> 00:21:53,610
،وعدا ألاّ يخبرا أحدًا عن كوجيما
.ثمّ عادا إلى منزليهما

281
00:21:48,840 --> 00:21:51,840
!مع السّلامة

282
00:21:56,840 --> 00:21:58,600
،على الرّغم من كلّ شيء

283
00:21:57,330 --> 00:22:02,650
...اسمعا، طبخ لي كوجيما طبقًا روسيًّا آخر

284
00:21:58,600 --> 00:22:02,650
أنا سعيدٌ لأنّ لديّ المزيد من الأشخاص
.لأتحدّث معهم عن كوجيما

285
00:23:34,410 --> 00:23:36,850
.بيروغي، بيروغ

286
00:23:36,850 --> 00:23:39,540
.بيروشكي، بيروجوك