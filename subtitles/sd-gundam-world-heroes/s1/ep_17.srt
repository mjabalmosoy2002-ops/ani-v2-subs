1
00:00:04,170 --> 00:00:06,810
!يا إلهي! ها قد أتوا ثانيةً

2
00:00:06,810 --> 00:00:08,570
...هذه المرّة لا محالة

3
00:00:08,570 --> 00:00:10,060
.انتظر يا روبن هود

4
00:00:10,060 --> 00:00:11,650
لمَ توقفني؟

5
00:00:11,650 --> 00:00:13,640
...فقط الرّب يعلم ما سيفعلون هنا

6
00:00:13,640 --> 00:00:15,110
.هذا مثير للاهتمام برأيي

7
00:00:15,110 --> 00:00:16,220
ماذا؟

8
00:00:17,140 --> 00:00:19,560
.إنّه ليو بي، صحيح؟ لذا أنا مهتمّ

9
00:00:19,830 --> 00:00:21,390
...لكن جلالتك

10
00:00:22,120 --> 00:00:24,280
.إنّك تتكلّم أكثر من اللّازم يا روبن هود

11
00:00:24,280 --> 00:00:26,730
هل تحاول عصيان الملك؟

12
00:00:27,110 --> 00:00:30,070
...عصيان جلالته؟ هذا ليس ما

13
00:00:31,050 --> 00:00:32,030
...أنا

14
00:00:33,400 --> 00:00:35,510
.حسنًا. سأضبط نفسي

15
00:00:35,990 --> 00:00:37,660
.أجل. رجاءً

16
00:00:38,370 --> 00:00:41,200
...محارب أجنبيّ يملك قوّة الهارو

17
00:00:43,000 --> 00:00:45,790
أيّ رجل هو؟

18
00:02:20,890 --> 00:02:22,440
".شرف فارس"

19
00:02:30,120 --> 00:02:32,630
ما الأمر؟ هل أنت متوتّر؟

20
00:02:33,460 --> 00:02:35,590
.أنا متخوّف بشأن ما حدث البارحة

21
00:02:35,920 --> 00:02:37,380
بشأن سيما يي؟

22
00:02:37,590 --> 00:02:39,970
.لم أتوقّع أن يكون في هذه البلاد

23
00:02:41,010 --> 00:02:42,970
...أتساءل ما الّذي يدبّر له هذه المرّة

24
00:02:43,760 --> 00:02:46,350
.سنفعل ما يقع على عاتقنا فحسب

25
00:02:46,770 --> 00:02:48,730
.لذا أوّلًا، نحن بحاجة لرؤية الملك أرثر

26
00:02:49,270 --> 00:02:50,390
.معك حقّ

27
00:02:51,270 --> 00:02:54,690
.الملك أرثر. النّاس من مختلف البلدان يحترمونه

28
00:02:54,940 --> 00:02:56,690
.إنّه الملك

29
00:02:56,690 --> 00:02:59,450
...آمل أن يعير لنا هارو بحرّيّة

30
00:02:59,820 --> 00:03:02,740
!سنتعامل مع الأمر كما هو. لنذهب

31
00:03:03,490 --> 00:03:05,740
كيف ندخل؟

32
00:03:06,160 --> 00:03:08,290
...هذا هو المشكل، صحيح

33
00:03:11,000 --> 00:03:11,960
ماذا؟

34
00:03:16,250 --> 00:03:17,500
...أنت

35
00:03:17,880 --> 00:03:19,970
.تعال. الملك ينتظر

36
00:03:23,930 --> 00:03:26,390
.ارتحلتم مسافة طويلة، أقدّر زيارتكم

37
00:03:26,680 --> 00:03:29,520
.مرحبًا بكم في قلعة كاميلوت

38
00:03:30,140 --> 00:03:32,190
أنت الملك أرثر، صحيح؟

39
00:03:32,730 --> 00:03:35,700
!أنت! كيف تجرؤ على الحديث إلى الملك بهذه الطّريقة

40
00:03:35,700 --> 00:03:37,610
.لا تغضب كثيرًا يا روبن هود

41
00:03:39,110 --> 00:03:41,490
أنت غاندام يونيكورن ليو بي، أليس كذلك؟

42
00:03:41,990 --> 00:03:43,110
.أجل

43
00:03:43,490 --> 00:03:46,450
وما الّذي تفعله هنا في مكان كهذا؟

44
00:03:46,870 --> 00:03:48,990
.لا أعتقد أنّك أتيت للسّياحة

45
00:03:49,290 --> 00:03:50,450
...أجل، أنا

46
00:04:02,630 --> 00:04:04,390
.أيّها الملك أرثر، أريد أن أسألك مساعدتك

47
00:04:05,050 --> 00:04:07,260
!اترك هارو خاصّتك معنا رجاءً

48
00:04:07,850 --> 00:04:08,850
هارو؟

49
00:04:09,050 --> 00:04:09,680
.نعم

50
00:04:10,140 --> 00:04:12,640
.اسمح لنا أن نشرح رجاءً أيّها الملك أرثر

51
00:04:13,600 --> 00:04:14,730
!أنتم

52
00:04:14,730 --> 00:04:16,980
!مستحيل أن ننصت لذلك

53
00:04:17,310 --> 00:04:18,490
.حسنًا

54
00:04:18,490 --> 00:04:19,570
.تفضّل

55
00:04:24,030 --> 00:04:28,990
.ثمّة خمسة هارو في العالم، ونحتاجهم لإنقاذ العالم

56
00:04:29,580 --> 00:04:30,790
.فهمت

57
00:04:30,790 --> 00:04:32,910
!أيّها الملك أرثر، ساعدنا رجاءً

58
00:04:34,210 --> 00:04:36,110
.فهمت. حسنًا

59
00:04:36,110 --> 00:04:37,310
ماذا؟

60
00:04:37,450 --> 00:04:38,640
!جلالتك

61
00:04:38,640 --> 00:04:42,580
!إنّ هارو هو كنز بلادنا، كما أنّه شعار الملوكيّة

62
00:04:42,580 --> 00:04:45,730
...لا يمكننا أن نسلّمه لهؤلاء المحتالين

63
00:04:45,730 --> 00:04:46,800
!لكن

64
00:04:47,260 --> 00:04:49,500
.ما زلت غير واثق من عياركم

65
00:04:49,500 --> 00:04:53,350
.ما إن كنتم تملكون القوّة لتحديد مصير العالم

66
00:04:55,020 --> 00:04:59,020
.ليو بي. أنت تملك هارو أيضًا. أنا واثق أنّك تفهم

67
00:04:59,440 --> 00:05:02,050
.القوّة الّتي يمتلكها هارو خاصّة وشديدة القوّة

68
00:05:02,050 --> 00:05:05,530
وماذا سيحدث إن انتهى به المطاف بين أيدي شرّيرة؟

69
00:05:06,490 --> 00:05:09,700
.لهذا لا أستطيع أن أعهده لكم بسهولة

70
00:05:10,370 --> 00:05:14,340
.أيضًا، لا يوجد دليل دامغ يثبت أنّكم تقفون في ضوء العدالة

71
00:05:14,340 --> 00:05:16,630
!ليو بي ليس شخصًا سيّئًا على الإطلاق

72
00:05:16,630 --> 00:05:17,920
!لا تعامله كذلك

73
00:05:17,920 --> 00:05:19,790
!صمتًا أيّها القرد

74
00:05:23,170 --> 00:05:26,010
.اسمح لي بالرّد رجاءً أيّها الملك أرثر

75
00:05:26,340 --> 00:05:28,010
.العكس صحيح أيضًا

76
00:05:28,930 --> 00:05:34,890
أليست حقيقة أنّ ليو بي يملك هذا الهارو
الخاصّ هي أفضل دليل بحدّ ذاتها؟

77
00:05:36,310 --> 00:05:38,840
.فهمت مقصدك، أنت فصيح اللّسان

78
00:05:38,840 --> 00:05:41,740
.المحارب الجيّد دائمًا ما يملك استراتيجيًّا جيّدًا

79
00:05:41,740 --> 00:05:43,280
أليس كذلك يا ميرلين؟

80
00:05:43,280 --> 00:05:45,500
...أجل، إنّ ثناءك أكثر ممّا أستحقّ

81
00:05:45,500 --> 00:05:47,740
!ليو بي فائق القوّة

82
00:05:47,740 --> 00:05:50,540
ماذا عنك؟ كم أنت قويّ؟

83
00:05:50,540 --> 00:05:53,410
...موضوعنا ليس القوّة أو الضّعف

84
00:05:54,410 --> 00:05:56,080
.هذا مثير للإعجاب

85
00:05:56,910 --> 00:06:00,720
.لسنا واثقين أيّ فظاعة ستلمّ بهذا العالم

86
00:06:00,720 --> 00:06:04,630
!لكن إن كان هناك ما أستطيع فعله، فسأكرّس كلّ قوّتي لفعله

87
00:06:05,340 --> 00:06:07,800
!رجاءً! ساعدنا في هذا

88
00:06:11,180 --> 00:06:13,810
.إنّ كارثة تدنو من هذا العالم

89
00:06:14,310 --> 00:06:18,640
...كيف أحدّد ما إن كان هذا الرّجل يستحقّ الثّقة

90
00:06:19,350 --> 00:06:20,950
.مع فائق الاحترام، جلالتك

91
00:06:20,950 --> 00:06:23,230
.لديّ فكرة

92
00:06:23,770 --> 00:06:24,950
.أخبرني

93
00:06:24,950 --> 00:06:25,940
.حاضر، جلالتك

94
00:06:26,280 --> 00:06:31,030
...لنتيقّن ما إن كان هذا الرّجل شجاع حقًّا أو مجرّد أحمق متحايل

95
00:06:31,030 --> 00:06:35,290
ما رأيك أن تختبره بنفسك يا صاحب الجلالة؟

96
00:06:35,660 --> 00:06:38,450
.أي، مبارزة

97
00:06:38,450 --> 00:06:40,000
...يا له من فاعل خير

98
00:06:40,670 --> 00:06:42,000
.أبهرتني يا ميرلين

99
00:06:42,330 --> 00:06:44,600
.نحن متّفقون

100
00:06:44,600 --> 00:06:46,680
ما المبارزة؟

101
00:06:46,680 --> 00:06:48,600
.المبارزة هي قتال

102
00:06:48,600 --> 00:06:50,600
.سيقاتل الملك أرثر ضدّ ليو بي

103
00:06:50,600 --> 00:06:53,400
.فذلك سيظهر من الأقوى

104
00:06:53,400 --> 00:06:55,680
!هذا بسيط! أحببته

105
00:06:55,680 --> 00:06:56,890
...قتال

106
00:06:57,930 --> 00:07:03,150
.ليو بي، لطالما أردت أن أبارز شخصًا مثلك

107
00:07:04,150 --> 00:07:07,740
.لا يتسنّى لك مبارزة مالك هارو كلّ يوم

108
00:07:09,110 --> 00:07:11,450
.سيحدّد سيفي هذا

109
00:07:12,110 --> 00:07:16,120
.وسأحقّق رغبتك، إن هزمتني

110
00:07:16,120 --> 00:07:18,290
.حسنًا

111
00:07:34,090 --> 00:07:36,390
...ذاك الرّجل، ميرلين

112
00:07:41,640 --> 00:07:43,600
أهناك ما يجول في بالك؟

113
00:07:44,230 --> 00:07:45,260
.أجل

114
00:07:45,260 --> 00:07:48,660
.الهارو أشبه بكنز كبير في هذه البلاد

115
00:07:48,660 --> 00:07:51,530
فقد قالوا عنه شعار الملوكيّة، صحيح؟

116
00:07:51,780 --> 00:07:56,200
لمَ تملك عائلتي شيئًا خاصًّا هكذا؟

117
00:07:57,120 --> 00:08:00,290
يا هارو. من أين أنت؟

118
00:08:01,620 --> 00:08:06,050
...أبي وجدّي وحتّى جدّي الأكبر

119
00:08:06,050 --> 00:08:09,340
.لطالما كان معنا، وهكذا هو الأمر

120
00:08:09,800 --> 00:08:13,630
.لم أعر للأمر الكثير من التّفكير إلى أن خرجنا في هذه الرّحلة

121
00:08:14,130 --> 00:08:18,010
.الأهمّ الآن هو استعارة الهارو من الملك أرثر

122
00:08:18,430 --> 00:08:19,930
.مفهوم

123
00:08:20,770 --> 00:08:23,850
.لا يمكنني أن أخسر

124
00:08:24,560 --> 00:08:26,520
!سأفوز بهذا القتال لا محالة

125
00:08:28,230 --> 00:08:30,280
.لنحاول بكلّ جهدنا يا هارو

126
00:08:32,990 --> 00:08:35,700
.ثمّة نزال ينتظرك في صباح الغد
.لنخلد إلى الفراش مبكّرًا اليوم

127
00:08:36,070 --> 00:08:37,200
.معك حقّ

128
00:08:40,410 --> 00:08:43,370
...يفترض أن يكون القمر كاملًا اللّيلة

129
00:08:50,710 --> 00:08:52,380
من هناك؟

130
00:08:53,590 --> 00:08:57,390
.اعذر زيارتي المتأخّرة رجاءً يا صاحب الجلالة

131
00:08:58,180 --> 00:09:00,850
...هناك ما أودّ طلبه من أجل دعمك

132
00:09:01,850 --> 00:09:02,850
.أخبرني

133
00:09:06,440 --> 00:09:09,900
،هذه ثمرة بحثي

134
00:09:09,900 --> 00:09:14,400
.قناع سرّيّ يساعد حامله أن يتلاعب بقدرته بشكل كامل

135
00:09:14,860 --> 00:09:16,450
...بأيّ حال يا صاحب الجلالة، رجاءً

136
00:09:16,450 --> 00:09:18,280
.لا داعي لذلك. انصرف

137
00:09:18,280 --> 00:09:19,340
ماذا؟

138
00:09:19,340 --> 00:09:20,700
ألم تسمعني يا ميرلين؟

139
00:09:21,330 --> 00:09:23,160
.قلت انصرف

140
00:09:23,660 --> 00:09:24,650
...لكن

141
00:09:24,650 --> 00:09:28,010
...إن حدث أسوأ احتمال وفاز، فإنّ هارو بلادنا سوف

142
00:09:28,010 --> 00:09:30,340
.سيكون ذلك القدر إذًا

143
00:09:30,880 --> 00:09:33,600
.لن تكسب شيئًا بالقوّة المزيّفة

144
00:09:33,600 --> 00:09:35,730
...لكن أنا

145
00:09:35,730 --> 00:09:37,760
.أقدّر اهتمامك

146
00:09:38,680 --> 00:09:41,850
.تأخّر الوقت. من الأفضل أن تستريح مبكّرًا

147
00:09:43,930 --> 00:09:46,640
...أقدّر كلماتك

148
00:09:55,240 --> 00:09:57,490
هل استرحت جيّدًا ليلة البارحة؟

149
00:09:57,490 --> 00:10:00,510
.أجل. كان الفراش ناعمًا ونمت كالأطفال

150
00:10:00,510 --> 00:10:02,300
.يسعدني معرفة ذلك

151
00:10:02,300 --> 00:10:04,580
.والآن دعني أكرّر سؤالي يا ليو بي

152
00:10:05,750 --> 00:10:09,530
.تريد أن تنقذ العالم. هذه هي نيّتك الحقيقيّة

153
00:10:09,530 --> 00:10:13,210
.أجل. سأهزمك وآخذ الهارو

154
00:10:14,130 --> 00:10:15,670
!هذا من أجل العالم

155
00:10:17,300 --> 00:10:18,340
.حسنًا

156
00:10:18,340 --> 00:10:21,190
،إن وقع أحدكما من هذا المسرح ولمس الأرض بساقيه

157
00:10:21,190 --> 00:10:23,010
.أو إن قال "أستسلم"، فسيخسر

158
00:10:23,640 --> 00:10:24,810
!حسنًا

159
00:10:24,810 --> 00:10:25,930
.موافق

160
00:10:26,730 --> 00:10:27,850
...إذًا

161
00:10:29,690 --> 00:10:30,730
!ابدآ

162
00:10:36,530 --> 00:10:37,750
!لقد هاجم مباشرةً

163
00:10:37,750 --> 00:10:38,780
.لا

164
00:10:38,780 --> 00:10:41,160
.يمكنه الاستفادة من الخطوة الأولى

165
00:10:51,040 --> 00:10:52,810
.فهمت. أنت رشيق

166
00:10:52,810 --> 00:10:53,880
...لكن

167
00:10:57,420 --> 00:10:58,720
.مذهل

168
00:11:11,480 --> 00:11:12,450
...هذا وشيك

169
00:11:12,450 --> 00:11:13,820
!ليو بي، بالتّوفيق

170
00:11:13,820 --> 00:11:14,910
!ركّز

171
00:11:14,910 --> 00:11:15,860
!حسنًا

172
00:11:21,450 --> 00:11:23,540
!أجل، هكذا! أجل

173
00:11:23,540 --> 00:11:26,990
!لا! كاد يفعلها! ظننت أنّه سيفوز

174
00:11:28,910 --> 00:11:31,250
...غاندام أرثر إم كي 3

175
00:11:32,290 --> 00:11:34,640
.كيف أصوغ الأمر؟ إنّه مسرف

176
00:11:34,640 --> 00:11:38,210
،لكن بما أنّني لم أستطع التحكّم بأرثر

177
00:11:38,590 --> 00:11:42,380
.من الجيّد أنّه يقاتل مع ليو بي هكذا

178
00:11:42,840 --> 00:11:45,220
.خطّتي لا تشوبها شائبة

179
00:11:49,020 --> 00:11:50,140
!ليو بي

180
00:11:50,730 --> 00:11:52,060
...إنّه قويّ جدًّا

181
00:11:52,440 --> 00:11:53,810
!هذا هو الملك أرثر

182
00:11:54,770 --> 00:11:56,400
.يمكنك الاستسلام إن أردت

183
00:11:57,150 --> 00:11:59,820
.قد تتكبّد بعض الأضرار الفادحة إن تحاملت على نفسك

184
00:12:00,740 --> 00:12:03,490
.أصدقائي الآن يبحثون عن الهارو من حول العالم

185
00:12:03,950 --> 00:12:06,950
!لا يمكنني الاستسلام بتلك السّهولة

186
00:12:08,040 --> 00:12:09,120
!هارو

187
00:12:11,830 --> 00:12:12,930
.ما زلت صغيرًا

188
00:12:12,930 --> 00:12:14,250
ماذا؟

189
00:12:14,920 --> 00:12:17,050
.قتال بين مالكَي هارو

190
00:12:17,050 --> 00:12:18,920
.كنتُ متطلّعًا لهذا

191
00:12:19,670 --> 00:12:22,600
...لكنّك لا تحاول رؤية قوّة الهارو الحقيقيّة، بل

192
00:12:22,600 --> 00:12:25,180
.يستخدم قوّته دون مراعاة كبيرة، لم أتوقّع ذلك

193
00:12:26,180 --> 00:12:27,350
ماذا قلت؟

194
00:12:27,350 --> 00:12:29,230
.نظّف عينيك

195
00:12:29,230 --> 00:12:30,390
!هذه قوّة الملك

196
00:12:43,990 --> 00:12:45,080
...تلك القوّة

197
00:12:45,080 --> 00:12:47,320
ما بال ذلك الشّخص؟

198
00:12:56,080 --> 00:12:57,180
...لماذا

199
00:12:57,180 --> 00:13:00,750
!يا لها من قوّة جبّارة... كما أنّه لم يطلب حتّى مساعدة الهارو

200
00:13:02,090 --> 00:13:03,170
!هارو

201
00:13:11,220 --> 00:13:13,430
!إكسكاليبر

202
00:13:28,030 --> 00:13:29,830
!ليو بي

203
00:13:35,670 --> 00:13:39,070
.سيكون من الجيّد إن سقط ليو بي

204
00:13:39,070 --> 00:13:43,180
.ستكون الأمور أسهل بكثير إن ظلّ تجوكا فقط

205
00:13:43,180 --> 00:13:44,260
ماذا؟

206
00:13:49,230 --> 00:13:52,150
.تلقّيت إكسكاليبر خاصّتي وما زلت واقفًا

207
00:13:52,730 --> 00:13:54,020
.عجيب

208
00:13:54,430 --> 00:13:55,870
.تجوكا

209
00:13:55,870 --> 00:13:57,140
.لا داعي للقلق

210
00:13:57,530 --> 00:14:01,980
...يستحيل أن يقوم بشيء كهذا عدّة مرّات على التّوالي

211
00:14:05,900 --> 00:14:08,070
.الأمر لا يتعلّق بالحصول على المساعدة من الهارو

212
00:14:09,620 --> 00:14:12,490
!بل بإطلاق العنان لقوّتك

213
00:14:15,250 --> 00:14:18,260
!لا يظهر أيّ رحمة

214
00:14:23,220 --> 00:14:24,550
!ليو بي

215
00:14:32,060 --> 00:14:33,020
.حُسم الفائز

216
00:14:33,000 --> 00:14:33,740
!ليس بعد

217
00:14:37,190 --> 00:14:38,620
!لا تتحامل على نفسك

218
00:14:38,620 --> 00:14:41,110
.إن أنهينا هذا الآن، ستتكبّد جراحًا سطحيّة فقط

219
00:14:41,490 --> 00:14:42,860
أولم أخبرك؟

220
00:14:43,950 --> 00:14:46,030
.لا يمكنني الخسارة

221
00:14:46,370 --> 00:14:49,040
!حتّى إن كُسرت

222
00:14:49,610 --> 00:14:52,040
!سأحصل على اعترافك

223
00:14:53,540 --> 00:14:54,710
!خذ هذه

224
00:15:10,390 --> 00:15:11,860
مهلًا، إلى أين تذهب؟

225
00:15:11,860 --> 00:15:14,600
!ليو بي في خطر، لا يمكنني الوقوف هنا فحسب

226
00:15:15,150 --> 00:15:16,980
!لنرَ إن كنت ستظلّ واقفًا بعد هذا

227
00:15:19,570 --> 00:15:21,160
.لا يمكننا أن نساعده الآن

228
00:15:21,160 --> 00:15:22,410
!لماذا؟

229
00:15:22,410 --> 00:15:26,540
.سيعني ذلك أنّنا لا نؤمن أنّه سيفوز، ولا نؤمن بقوّته

230
00:15:26,540 --> 00:15:27,740
ماذا؟

231
00:15:31,080 --> 00:15:34,160
لن ننقذه لأننا نؤمن به؟

232
00:15:37,130 --> 00:15:39,840
...ليس بعد

233
00:15:40,880 --> 00:15:43,380
.يجب على رجل من طينتك أن يعرف هذا

234
00:15:44,220 --> 00:15:45,930
!أنّك لا تستطيع هزيمتي

235
00:15:46,800 --> 00:15:50,600
.إلّم أخسر، فلن تفوز أيضًا

236
00:15:51,270 --> 00:15:52,470
أليس كذلك؟

237
00:15:53,680 --> 00:15:54,690
.فهمت

238
00:15:55,850 --> 00:16:00,190
!إذًا سأستخدم كامل قوّتي! سأظفر بالنّصر

239
00:16:01,860 --> 00:16:03,270
...يا إلهي

240
00:16:06,410 --> 00:16:08,480
.سيكون التّعادل أفضل نتيجة

241
00:16:08,480 --> 00:16:11,540
...أحتاج من أحدهما أن يسقط على الأقلّ

242
00:16:15,370 --> 00:16:17,500
.إنّك لرجل قويّ بحقّ

243
00:16:18,290 --> 00:16:21,800
.لكنّي لن أخسر. لن أستسلم

244
00:16:22,880 --> 00:16:25,020
...مهما حدث هذا من مرّة

245
00:16:25,020 --> 00:16:27,130
!سأقف مع ذلك

246
00:16:31,640 --> 00:16:32,600
ما ذلك؟

247
00:16:33,180 --> 00:16:34,390
...لا أدري

248
00:16:36,270 --> 00:16:41,390
هناك احتمالات لا حصر لها أمام ليو بي لا أستطيع رؤيتها؟

249
00:16:43,440 --> 00:16:44,780
.سيكون هذا الأخير

250
00:16:47,070 --> 00:16:48,360
...إكسـ

251
00:16:49,660 --> 00:16:51,080
!هلمّ

252
00:16:51,080 --> 00:16:53,360
!إكسكاليبر

253
00:17:13,600 --> 00:17:14,720
!جلالتك

254
00:17:16,100 --> 00:17:17,350
!ليو بي

255
00:17:18,230 --> 00:17:19,810
!استُبعد كلا الجانبين

256
00:17:19,810 --> 00:17:20,680
ماذا؟

257
00:17:21,650 --> 00:17:22,570
!إنّه تعادل

258
00:17:22,570 --> 00:17:23,610
!مهلًا

259
00:17:24,610 --> 00:17:25,830
!هذا لا يمكن

260
00:17:25,830 --> 00:17:27,650
!بدأنا فقط

261
00:17:27,990 --> 00:17:30,660
...مع ذلك، أنت واقف

262
00:17:33,150 --> 00:17:34,400
!لنفعل هذا

263
00:17:35,410 --> 00:17:37,370
!هذا يكفي يا ليو بي

264
00:17:40,370 --> 00:17:42,580
!عليّ أن أفوز

265
00:17:43,380 --> 00:17:47,710
!أنا رجل يمكنك أن تعهد له بالهارو! سأحصل على اعترافك

266
00:17:49,050 --> 00:17:50,520
.جلالتك

267
00:17:50,520 --> 00:17:54,300
.لقد خرق ذلك الرّجل القواعد، لا داعي لتظهر له أيّ رحمة

268
00:17:54,970 --> 00:17:56,770
...الآن هو الوقت

269
00:18:03,980 --> 00:18:06,290
!إنّه قناع الظّلام

270
00:18:06,290 --> 00:18:07,690
...هل يعقل

271
00:18:10,280 --> 00:18:11,860
!ابق بعيدًا عن جلالته

272
00:18:11,860 --> 00:18:13,740
!أيّها الوغد

273
00:18:13,970 --> 00:18:15,490
.طُلب منّي فعل هذا

274
00:18:15,830 --> 00:18:19,160
!إن حاولت التملّص، فلن أتردّد في الإطاحة بك

275
00:18:19,160 --> 00:18:20,250
ماذا؟

276
00:18:28,210 --> 00:18:30,300
من أنت؟

277
00:18:33,050 --> 00:18:35,550
...كدتُ أنجح

278
00:18:42,390 --> 00:18:44,020
!كما ظننت، إنّه أنت فعلًا

279
00:18:44,860 --> 00:18:45,860
!سيما يي

280
00:18:46,810 --> 00:18:48,480
!إنّه ذلك الشرّير من آخر مرّة

281
00:18:53,240 --> 00:18:55,170
...الجدران تقترب

282
00:18:55,170 --> 00:18:58,780
!لقد فضحتني. كم هذا طيش منّي

283
00:18:59,370 --> 00:19:00,800
!سأحصل على جوابي اليوم

284
00:19:00,800 --> 00:19:04,700
لأيّ غرض تستخدم قناع الظّلام ذاك؟

285
00:19:04,700 --> 00:19:07,510
.ستعرف حينما يحين الوقت

286
00:19:07,510 --> 00:19:09,540
.تطلّع لذلك فحسب

287
00:19:09,540 --> 00:19:10,960
هل تحاول الهرب؟

288
00:19:10,960 --> 00:19:12,510
.سأراك في وقت آخر

289
00:19:16,300 --> 00:19:18,720
.الخطر يدنو من العالم

290
00:19:19,430 --> 00:19:21,270
هذا جزء منه أيضًا، أليس كذلك؟

291
00:19:22,480 --> 00:19:23,950
...أجل، لهذا السّبب الهارو

292
00:19:23,950 --> 00:19:26,890
...صحيح! لنعد إلى النّزال إذًا

293
00:19:27,900 --> 00:19:29,310
.لا

294
00:19:29,310 --> 00:19:31,410
.لقد تمّ التوصّل إلى نتيجة بالفعل

295
00:19:31,410 --> 00:19:32,520
ماذا؟

296
00:19:33,450 --> 00:19:36,070
.أحسّ بإيمان قويّ في سيفك

297
00:19:37,070 --> 00:19:39,120
.سأؤمن بذلك

298
00:19:40,700 --> 00:19:41,680
هل أنت واثق؟

299
00:19:41,910 --> 00:19:42,580
.أجل

300
00:19:43,250 --> 00:19:45,000
.اعتن به فعلًا رجاءً

301
00:19:49,800 --> 00:19:51,260
!شكرًا لك أيّها الملك أرثر

302
00:19:55,180 --> 00:19:56,970
!نجحنا! تجوكا

303
00:19:58,800 --> 00:20:01,470
ما الخطب؟ ألست سعيدًا بشأن هذا؟

304
00:20:02,390 --> 00:20:03,680
.أجل، هذا يسعدني

305
00:20:07,060 --> 00:20:08,360
...سيما يي

306
00:20:08,940 --> 00:20:11,690
ماذا تظنّ حقًّا؟

307
00:20:14,360 --> 00:20:16,040
!حسنًا

308
00:20:16,040 --> 00:20:18,820
...لست واثقًا كم فعلنا هذا من مرّة، لكن

309
00:20:18,820 --> 00:20:22,170
.لنحتفل بحقيقة أنّنا حصلنا على الهارو بسلام

310
00:20:22,170 --> 00:20:24,330
!بصحّتنا

311
00:20:29,290 --> 00:20:30,620
!إنّه شهيّ

312
00:20:30,620 --> 00:20:32,460
!هذا ما أردته تمامًا

313
00:20:35,800 --> 00:20:38,390
...إلى متى سيحتفلون

314
00:20:42,510 --> 00:20:44,680
أنت معي، صحيح؟

315
00:20:50,980 --> 00:20:52,890
!هناك طائر! في مكان كهذا

316
00:20:52,890 --> 00:20:54,530
ما رأيك أن نحوّله إلى طعام؟

317
00:20:55,110 --> 00:20:56,910
...انتظر

318
00:20:56,910 --> 00:20:58,660
.يبدو غريبًا بعض الشّيء

319
00:21:03,410 --> 00:21:04,950
ما الأمر يا سون كيان؟

320
00:21:04,950 --> 00:21:06,370
!ليو بي

321
00:21:08,210 --> 00:21:11,160
فهمت، في القصر التّحمائيّ إذًا؟

322
00:21:11,670 --> 00:21:14,620
.أجل، كان ذلك صعبًا. لكنّنا تمكنّا من النّجاح

323
00:21:14,620 --> 00:21:18,010
.حصلنا أيضًا على هارو الملك أرثر هنا

324
00:21:18,800 --> 00:21:22,820
...لكنّ ذلك الرّجل، سيما يي. لا أستطيع سوى القلق حيال ذلك

325
00:21:22,820 --> 00:21:26,930
.إن كان هناك أيّ مشكل، سنتّصل بكم على الفور

326
00:21:27,240 --> 00:21:28,730
.حسنًا، إنّنا نعتمد عليكم

327
00:21:29,740 --> 00:21:33,450
.سنتبع خطّتنا ونذهب إلى عالم ريجينا تاليًا

328
00:21:34,280 --> 00:21:36,860
.لأنّه يفترض أن يكون مكان الهارو الأخير

329
00:21:42,050 --> 00:21:44,690
...غاندام سيزر ليجيند

330
00:21:44,690 --> 00:21:46,360
.أتساءل أيّ رجل يكون

331
00:21:52,950 --> 00:21:56,000
،مهما بلغت كنوزي الشّريفة

332
00:21:56,000 --> 00:21:58,040
...إلّم أستطع أن أنقذ من أحبّ

333
00:21:59,250 --> 00:22:00,830
!يا لعجزي

334
00:22:02,130 --> 00:22:04,550
!لا، لن أستسلم

335
00:22:04,550 --> 00:22:08,170
...مهما كلّف الأمر

336
00:23:45,220 --> 00:23:50,030
.إنّ ووكونغ يتصرّف بغرابة هذه الأيّام، ينتابني شعور سيّئ حيال ذلك

337
00:23:50,850 --> 00:23:53,410
.إس د غاندام أبطال العالم

338
00:23:53,890 --> 00:23:56,830
".في الحلقة القادمة، "صانع سيوف فخور

339
00:23:57,420 --> 00:24:00,110
!لا تفوّتوا هذه المغامرة