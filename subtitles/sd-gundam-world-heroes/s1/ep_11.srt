1
00:00:04,950 --> 00:00:06,060
...أيّها القائد، لقد حاصرنا السّارق الشّبح إكس

2
00:00:06,060 --> 00:00:10,670
.في قسم الممتلكات الثّقافيّة الهامّة

3
00:00:10,860 --> 00:00:15,480
.لقد أخذ على نفسه عناء الهرب إلى مكان بلا مدخل، يا للأحمق

4
00:00:15,480 --> 00:00:17,590
...هذه المرّة، بالتّأكيد سوف

5
00:00:19,220 --> 00:00:21,590
.استسلم أيّها السّارق الشّبح إكس

6
00:00:25,620 --> 00:00:27,850
...لا تسبّب اضطرابًا واستسلم

7
00:00:28,600 --> 00:00:29,560
ما الّذي يجري؟

8
00:00:35,770 --> 00:00:37,180
ما ذلك الشّيء؟

9
00:00:37,180 --> 00:00:40,290
،سابقًا، أثناء تطوّر هذه المدينة

10
00:00:40,290 --> 00:00:43,370
.استُخدمت هذه التّحف لحراسة منقطة الخليج

11
00:00:43,700 --> 00:00:45,910
.لم أتوقّع أن تكون مفعّلة

12
00:00:48,500 --> 00:00:50,910
.كدت تنجح يا فيردي باستر

13
00:00:52,080 --> 00:00:54,140
!لن تهرب بفعلتك هذه

14
00:00:54,140 --> 00:00:57,360
!سأقبض عليك لا محالة أيّها السّارق الشّبح إكس

15
00:00:58,460 --> 00:01:01,700
.لا بدّ أنّك تعبت من هذا المنزل الضيّق يا عزيزي

16
00:01:01,700 --> 00:01:04,540
.لنخرج ونرى سماء اللّيل

17
00:01:19,800 --> 00:01:21,050
!مرحى

18
00:01:21,340 --> 00:01:23,810
!هذا مذهل! أنت رائع يا معلّم

19
00:01:23,810 --> 00:01:26,380
.سار كلّ شيء بخير

20
00:01:26,380 --> 00:01:29,810
!لكن كيف يمكنه أن يكون بهذه العشوائيّة

21
00:01:29,810 --> 00:01:34,010
.والآن، لنذهب إلى البيت يا عزيزي

22
00:01:34,010 --> 00:01:36,040
.إلى ديارنا الجميلة

23
00:03:13,710 --> 00:03:17,960
"القمر هناك"

24
00:03:22,470 --> 00:03:24,640
.يا إلهي. هذه الفردوس

25
00:03:24,970 --> 00:03:29,560
.ليست سيّئة على الإطلاق
.الينابيع السّاخنة هنا في عالم موشا

26
00:03:29,560 --> 00:03:31,360
.أكيد

27
00:03:31,360 --> 00:03:32,870
.بالأخصّ هذه الشّينوبيو

28
00:03:32,870 --> 00:03:36,130
حتّى أنّه تمّ ترشيحه كأحد
.أفضل 100 ينبوع ساخن في عالم موشا

29
00:03:36,130 --> 00:03:40,670
،إنّه مفيد لالتهاب المفاصل والالتواء والكدمات وجروح السّيف

30
00:03:40,670 --> 00:03:45,040
وكذلك الألم العصبيّ الوربيّ وتيبّس الرّقبة وشلل النّوم

31
00:03:45,040 --> 00:03:47,080
والحبّ من طرف واحد والقلب
...المفطور وحتّى أنّه مفيد للغيرة

32
00:03:48,040 --> 00:03:49,290
ما الخطب؟

33
00:03:50,500 --> 00:03:54,380
.لا شيء. إنّه يذكّرني بسايزو

34
00:03:55,250 --> 00:03:58,510
إنّه ذلك النّينجا الّذي كان مع نوبوناغا، صحيح؟

35
00:03:58,510 --> 00:04:00,840
.بدا أنّك تعرفه

36
00:04:02,630 --> 00:04:07,160
.أعرفه منذ مدّة، حتّى قبل أن أبدا في خدمة نوبوناغا-ساما

37
00:04:07,160 --> 00:04:09,770
.اعتدنا أن نقاتل سويًّا

38
00:04:11,020 --> 00:04:15,210
.أنا وسايزو خضنا معارك كثيرة سويًّا

39
00:04:15,210 --> 00:04:18,830
.وثقنا ببعضنا وتطوّرنا سويًّا من خلال منافسة الصّداقة

40
00:04:18,830 --> 00:04:20,360
.كان صديق لا يمكن تعويضه

41
00:04:21,690 --> 00:04:25,030
...لكن، كنتُ الوحيد

42
00:04:25,030 --> 00:04:27,370
.الّذي رأى الأمر كذلك

43
00:04:29,030 --> 00:04:32,180
.كان سايزو يكنّ مشاعر متقلّبة تجاهي لوقت طويل

44
00:04:32,180 --> 00:04:35,770
.لقد حسدني

45
00:04:35,770 --> 00:04:38,460
.لم أعلم إلى تلك اللّحظة

46
00:04:39,550 --> 00:04:41,390
.شعرت بالنّدم

47
00:04:41,390 --> 00:04:45,700
.كنينجا، سايزو متفوّق على الآخرين

48
00:04:45,700 --> 00:04:47,570
،لو أنّني لاحظت المصاعب الّتي كان يواجهها

49
00:04:47,570 --> 00:04:50,430
...لما انتهى الأمر كذلك

50
00:04:51,220 --> 00:04:52,770
...الظّلام في الدّاخل

51
00:04:54,060 --> 00:04:56,190
.هذا حال نوبوناغا أيضًا

52
00:04:57,150 --> 00:04:59,440
...ما يضمره هذا الرّجل

53
00:05:00,070 --> 00:05:01,400
.هي الكراهية

54
00:05:01,900 --> 00:05:04,770
.شعرتُ بها بينما كنت أقاتله

55
00:05:04,770 --> 00:05:10,010
.يريد من كلّ الأشياء في الحياة أن تنصاع لقوّتك الّتي لا تقهر

56
00:05:10,010 --> 00:05:12,200
.قلب ظلاميّ وبلا قعر

57
00:05:13,330 --> 00:05:18,040
...الطّموح والرّغبة في الانتصار والغيرة والكراهية

58
00:05:18,790 --> 00:05:20,720
من الممكن أنّ ذلك القناع الظلاميّ

59
00:05:20,720 --> 00:05:24,880
.يضخّم هذا الجانب المظلم من البشريّة

60
00:05:25,510 --> 00:05:27,800
...الجانب المظلم من البشريّة

61
00:05:29,640 --> 00:05:30,930
.هيّا بنا يا ساسكي

62
00:05:33,020 --> 00:05:34,390
...سو سو-دونو

63
00:05:35,350 --> 00:05:38,040
...نوبوناغا وسايزو

64
00:05:38,040 --> 00:05:42,190
.قبل أن يأسر قناع الظّلام عقليهما كلّيًّا

65
00:05:43,780 --> 00:05:45,240
.سنفعل أيّ ما يتطلّب

66
00:05:46,900 --> 00:05:49,450
!نجحت

67
00:05:50,950 --> 00:05:54,600
".لقد اكتمل. سأدعوه بـ"شاطئ الذّكريات

68
00:05:54,600 --> 00:05:58,100
...عجبًا، لم أعلم أنّك بارع في هذا

69
00:05:58,100 --> 00:06:00,080
!إنّه ليس قريبًا حتّى

70
00:06:00,920 --> 00:06:01,540
ماذا؟

71
00:06:01,540 --> 00:06:03,000
...كيف انتقلت من هذا

72
00:06:04,380 --> 00:06:06,440
!إلى هذا؟

73
00:06:06,440 --> 00:06:09,820
.معك حقّ، الأسلوب مختلف قليلًا

74
00:06:09,820 --> 00:06:12,810
!ليس قليلًا. بل مختلف تمامًا

75
00:06:15,680 --> 00:06:18,500
!شاطئ ذكرياتي

76
00:06:18,500 --> 00:06:21,710
.قطعنا شوطًا طويلًا من أجل الهارو في عالم نيو

77
00:06:21,710 --> 00:06:23,820
...والآن انتهى به المطاف محطّم

78
00:06:24,270 --> 00:06:27,630
مهلًا، أين تجوكا؟

79
00:06:27,630 --> 00:06:31,990
.إنّه في تلك الغرفة في الخلف، يتمتم لوحده

80
00:06:38,870 --> 00:06:41,460
!كما أنّ لديه الكثير من الكتب هنا

81
00:06:42,630 --> 00:06:43,960
.فاجأني ذلك أيضًا

82
00:06:44,590 --> 00:06:46,210
ما هي؟

83
00:06:46,550 --> 00:06:50,190
.هذه كلّ الوثائق القيّمة، لم أرها من قبل

84
00:06:50,190 --> 00:06:52,520
.لا أدري كيف تمكّن من جمعها كلّها

85
00:06:52,520 --> 00:06:55,850
...بالنّسبة لكيف قام بجمعها

86
00:06:58,390 --> 00:07:01,040
.دعنا لا نسأل الآن

87
00:07:01,040 --> 00:07:02,560
.أجل

88
00:07:02,940 --> 00:07:04,360
!أنا صائد كنوز

89
00:07:05,270 --> 00:07:07,650
...قد نستطيع أن نجد

90
00:07:07,650 --> 00:07:12,820
.أجل، من المرجّح جدًّا أن نجد معلومات عن الهارو هنا

91
00:07:12,820 --> 00:07:13,990
.فهمت

92
00:07:14,410 --> 00:07:19,120
.قد نجد أيضًا طريقة لترميم الهارو المنكسر

93
00:07:20,040 --> 00:07:24,400
لكن هل أنهاها أرسين كلّها؟

94
00:07:24,400 --> 00:07:26,180
من يدري؟

95
00:07:26,180 --> 00:07:31,090
.لكنّه ليس لصًّا كما توقّعناه

96
00:07:33,180 --> 00:07:34,550
!أنا صائد كنوز

97
00:07:37,060 --> 00:07:39,390
...ما سرقوه

98
00:07:39,390 --> 00:07:42,620
.كان الهارو، أهمّ قطعة أثريّة في مدينة القائد

99
00:07:42,620 --> 00:07:45,730
.بعبارة أخرى، إنّه رمز هذه المدينة

100
00:07:46,110 --> 00:07:48,650
.هذا لا يغتفر بتاتًا

101
00:07:49,150 --> 00:07:51,760
ألم تعثروا على مكان السّارق الشّبح إكس بعد؟

102
00:07:51,760 --> 00:07:53,580
.أعتذر بصدق. توقّفت إشارة جهاز الإرسال بشكل مفاجئ

103
00:07:53,580 --> 00:07:57,960
.فقدنا أثره

104
00:07:57,960 --> 00:08:01,680
.لا بدّ أنّه يرسل إشارة مشوّشة من معقله

105
00:08:01,680 --> 00:08:04,840
.نفّذوا بحثًا شاملًا من حيث انقطعت الإشارة

106
00:08:04,840 --> 00:08:05,830
!حاضر

107
00:08:06,540 --> 00:08:09,710
.إيّاك أن تفكّر أنّنا سنستسلم هكذا

108
00:08:09,710 --> 00:08:11,340
!أيّها السّارق الشّبح إكس

109
00:08:18,720 --> 00:08:20,830
.يبدو أنّه ليس هذا

110
00:08:20,830 --> 00:08:22,730
ليو بي، كيف سار الأمر؟

111
00:08:24,520 --> 00:08:26,780
...نعم، لنرَ

112
00:08:26,780 --> 00:08:27,980
.تبًّا

113
00:08:29,270 --> 00:08:33,840
...لم أجد أيّ شيء له علاقة بالهارو

114
00:08:33,840 --> 00:08:35,530
!ليو بي، ذلك الكتاب

115
00:08:40,830 --> 00:08:42,080
تجوكا؟

116
00:08:42,620 --> 00:08:46,460
!أحسنت يا ليو بي! هذا حساب مكتوب لهارو

117
00:08:47,170 --> 00:08:50,210
!قد نستطيع لملمة الهارو المنكسر

118
00:08:52,010 --> 00:08:52,710
!ها هو ذا

119
00:08:53,200 --> 00:08:54,780
ما المكتوب؟

120
00:08:54,780 --> 00:08:57,260
...لنرَ، باختصار

121
00:08:57,720 --> 00:09:00,120
،هذه الهارو الخمسة منتشرة حول العالم

122
00:09:00,120 --> 00:09:02,520
.ولكلّ منها سماتها الخاصّة

123
00:09:02,890 --> 00:09:06,330
،خذ هارو عالم المملكة كمثال

124
00:09:06,330 --> 00:09:09,770
.والّذي تمتلكه، خاصيّته هي الشّجاعة الفائضة

125
00:09:10,440 --> 00:09:12,280
...الشّجاعة الفائضة

126
00:09:12,280 --> 00:09:16,530
.والّذي في عالم القراصنة، اعتبار الأصدقاء

127
00:09:16,860 --> 00:09:19,300
ماذا عن الّذي وجدناه هذه المرّة؟

128
00:09:19,300 --> 00:09:22,040
...الّذي في عالم نيو، خاصيّته هي

129
00:09:22,790 --> 00:09:25,270
.لا، لا أستطيع قراءة الجزء الأساسيّ

130
00:09:25,270 --> 00:09:26,620
ماذا؟

131
00:09:26,620 --> 00:09:28,960
.ذلك الجزء محكوك على ما أظنّ

132
00:09:30,250 --> 00:09:34,880
لماذا؟ لم حدث ذلك لهذا الجزء بالضّبط؟

133
00:09:35,220 --> 00:09:39,800
...هذه سنّة الحياة. إنّه كتاب قديم جدًّا، على أيّ حال

134
00:09:40,930 --> 00:09:44,850
...مهلًا، يبدو مبلّلًا قليلًا

135
00:09:45,390 --> 00:09:47,580
...ربّما أصبح مفقودًا مؤخّرًا فحسب

136
00:09:47,580 --> 00:09:49,100
!مهلًا

137
00:09:49,100 --> 00:09:51,770
لمَ أحدثت هذه الضجّة فجأةً؟

138
00:09:51,770 --> 00:09:55,710
!أقصد... بشأن ذلك، بإمكاننا أن نسأل أرسين

139
00:09:55,710 --> 00:10:00,370
.بما أنّه قرأه بالفعل، فربّما يدري ما هو مكتوب هنا

140
00:10:00,370 --> 00:10:03,160
.فهمت، هذا مفهوم

141
00:10:10,880 --> 00:10:11,840
.بصحّتك

142
00:10:14,340 --> 00:10:17,380
...أرسين-سان! هناك شيء نريد أن نسأل عنه

143
00:10:18,380 --> 00:10:20,800
ما زال ذلك الشّيء الضّخم هنا؟

144
00:10:22,550 --> 00:10:25,560
...ويبدو أنّه يلهو مع وكوونغ

145
00:10:25,850 --> 00:10:29,520
.يبدو أنّهما ينسجمان جيّدًا

146
00:10:30,150 --> 00:10:33,270
.إنّه أسلوب لا مبالٍ

147
00:10:33,610 --> 00:10:38,400
.يجب أن أستمتع بسماء اللّيل الهادئة والرّومانسيّة هذه بسحر

148
00:10:38,740 --> 00:10:42,620
أم أنّ ذلك سيكون فظًّا جدًّا بالنّسبة للنّجوم المتلألئة؟

149
00:10:43,240 --> 00:10:47,020
.قرأنا عن الوثائق التّاريخيّة في دراستك

150
00:10:47,020 --> 00:10:49,770
.القراءة والمغامرة تساعد على إثراء حياة النّاس

151
00:10:49,770 --> 00:10:51,330
.هذه الرّوح المطلوبة

152
00:10:52,170 --> 00:10:56,340
.وجدنا شيئًا نعتقد أنّه يدعى الحساب المكتوب لهارو

153
00:10:56,670 --> 00:10:59,810
...لكن مع الأسف، لا نستطيع قراءة الجزء المتعلّق

154
00:10:59,810 --> 00:11:01,720
.بخاصيّة الهارو في عالم نيو

155
00:11:02,340 --> 00:11:05,810
.يبدو أنّ ذلك الجزء أصبح مفقودًا بسبب كتاب قديم جدًّا

156
00:11:07,470 --> 00:11:11,400
.أرسين، أفترض أنّك قرأت هذا الكتاب بالفعل

157
00:11:11,900 --> 00:11:12,810
.بالطّبع

158
00:11:13,230 --> 00:11:16,550
.الوثائق القديمة لا غنى عنها بالنّسبة لصائد كنوز

159
00:11:16,550 --> 00:11:18,320
...إذًا

160
00:11:21,490 --> 00:11:22,910
ما ذلك؟

161
00:11:24,740 --> 00:11:27,370
.وجدتك أيّها السّارق الشّبح إكس

162
00:11:27,790 --> 00:11:29,160
!إلى الجميع، انتشروا

163
00:11:30,370 --> 00:11:31,250
.أخبرنا رجاءً

164
00:11:32,080 --> 00:11:34,840
ما هي سمة الهارو في عالم نيو؟

165
00:11:36,130 --> 00:11:40,210
...الهارو في عالم نيو، خاصّيته هي

166
00:11:40,210 --> 00:11:41,760
...هي

167
00:12:00,000 --> 00:12:01,130
ما هي؟

168
00:12:02,580 --> 00:12:04,950
!بربّك، لمَ تركتنا نترقّب هكذا

169
00:12:04,950 --> 00:12:10,330
.نسيت. فقد قرأته قبل وقت طويل

170
00:12:10,330 --> 00:12:13,420
.ما كان يجب أن أتوقّع شيئًا منه

171
00:12:17,630 --> 00:12:18,680
ما الّذي يجري؟

172
00:12:18,680 --> 00:12:19,310
!ووكونغ

173
00:12:29,980 --> 00:12:32,530
.لقد حاصرنا هذا المبنى

174
00:12:33,030 --> 00:12:35,320
.لا تتسبّب بضجّة وسلّم نفسك

175
00:12:36,190 --> 00:12:39,450
...إن رأينا أيّ إشارة للمقاومة

176
00:12:41,070 --> 00:12:42,280
.هنا

177
00:12:43,450 --> 00:12:47,170
فلتصدّق أنّنا سنبني نصبًا
.تذكاريًّا لإسقاط أكبر شرّير في تاريخنا

178
00:12:51,920 --> 00:12:53,260
!تشو يون

179
00:12:54,500 --> 00:12:57,190
!انظر! عملي الجديد

180
00:12:57,190 --> 00:12:59,600
".أدعوه، "الصّباح حيث يستيقظ الحبّ

181
00:13:02,560 --> 00:13:04,950
!حبّي

182
00:13:04,950 --> 00:13:07,450
ما الّذي تفعله يا تشو يون؟

183
00:13:07,450 --> 00:13:09,310
!انظر من حولك! انظر لما يجري

184
00:13:15,400 --> 00:13:16,900
...هؤلاء المزعجون

185
00:13:16,900 --> 00:13:19,000
...انتظر يا تشو يون! إنّه

186
00:13:19,000 --> 00:13:22,010
!لن أدعكم تمسّون معلّمي بضرّ

187
00:13:22,010 --> 00:13:23,050
!اهدأ فحسب

188
00:13:23,080 --> 00:13:24,390
!توقّف يا تشو يون

189
00:13:24,390 --> 00:13:25,810
لماذا؟

190
00:13:25,810 --> 00:13:28,550
.يظهر الهدف نيّة المقاومة

191
00:13:28,550 --> 00:13:30,880
.تمّ تحديده على أنّه عرقلة للمهمّة

192
00:13:31,580 --> 00:13:35,410
.كما يرغبون، سنبني لهم نصبًا تذاكريًّا هنا

193
00:13:36,540 --> 00:13:38,630
!هاجموا جميعًا

194
00:13:42,670 --> 00:13:44,030
.لقد أطلقوا علينا

195
00:13:44,030 --> 00:13:47,280
!لم يتركوا لنا خيارًا آخر. هيّا بنا يا رفاق

196
00:13:47,280 --> 00:13:48,890
.لا نملك خيارًا

197
00:14:10,530 --> 00:14:12,700
!تمّ تحديد الهدف. أطلقوا

198
00:14:27,220 --> 00:14:28,720
!عمل ممتاز

199
00:14:28,720 --> 00:14:31,680
!سحقًا. إلى الجميع، أطلقوا وابلًا

200
00:14:31,680 --> 00:14:32,890
!أطلقوا

201
00:14:43,900 --> 00:14:45,400
.كدنا ننجح

202
00:14:50,860 --> 00:14:52,950
!تشغيل طور باستر

203
00:15:01,330 --> 00:15:02,620
.لا نهاية لهذا

204
00:15:02,800 --> 00:15:03,710
.أجل

205
00:15:05,130 --> 00:15:06,340
ما ذلك؟

206
00:15:10,340 --> 00:15:13,220
!ريلغان العدالة

207
00:15:40,750 --> 00:15:43,920
.أيّها القائد، لقد ألقينا القبض على بقيّة المشتبه بهم

208
00:15:48,340 --> 00:15:49,340
ما ذلك؟

209
00:15:52,890 --> 00:15:56,830
.لقد اكتشفنا عددًا كبيرًا من التّحف في المخبأ

210
00:15:56,830 --> 00:16:00,850
.نعتقد أنّ كلّ هذه الأشياء سُرقت من قبل السّارق الشّبح إكس

211
00:16:01,810 --> 00:16:03,140
ماذا عن الهارو؟

212
00:16:03,650 --> 00:16:04,940
.لقد استرجعناه

213
00:16:06,230 --> 00:16:07,520
...لا يمكن

214
00:16:07,520 --> 00:16:08,860
.حسنًا

215
00:16:15,070 --> 00:16:17,240
أهناك ما تودّ قوله؟

216
00:16:18,080 --> 00:16:23,080
أخبرني، متى كانت آخر مرّة نظرت إلى سماء اللّيل؟

217
00:16:23,670 --> 00:16:24,920
ماذا قلت؟

218
00:16:25,960 --> 00:16:29,460
.انظر. القمر هناك

219
00:16:37,930 --> 00:16:40,870
!كنتُ منتظرًا هذه اللّحظة

220
00:16:40,870 --> 00:16:42,690
أهو إلهاء؟

221
00:16:49,070 --> 00:16:51,900
!والآن، إنّه وقت العرض

222
00:17:10,250 --> 00:17:13,630
.وقت الذّهاب للبيت يا أطفال

223
00:17:30,860 --> 00:17:32,500
...ما الّذي يجري

224
00:17:32,500 --> 00:17:36,660
.أرسلتهم إلى الدّيار فحسب، حيث ينتمون

225
00:17:36,660 --> 00:17:38,030
ماذا؟

226
00:17:39,490 --> 00:17:41,950
.لا يدري الكثير بشأن هذا

227
00:17:42,370 --> 00:17:47,170
...لكن الكثير من الكنوز المخزّنة في متاحف هذه المدينة

228
00:17:47,170 --> 00:17:50,390
،سُرقت سابقًا من أماكن مختلفة

229
00:17:50,390 --> 00:17:53,210
.أو تمّ شراؤها عبر طرق غير قانونيّة

230
00:17:54,260 --> 00:17:58,260
كلّنا نشتاق لديارنا أحيانًا، صحيح؟

231
00:17:58,680 --> 00:18:01,560
.ذات الأمر ينطبق على الكنوز

232
00:18:02,180 --> 00:18:05,040
...إذًا كنت تسرق

233
00:18:05,040 --> 00:18:06,980
!بل أصطاد الكنوز

234
00:18:07,520 --> 00:18:09,630
...كنت تصطاد الكنوز

235
00:18:09,630 --> 00:18:13,570
.لأنّك أردت أن تعيد تلك الأشياء لحيث تنتمي

236
00:18:27,160 --> 00:18:29,500
!لا تدلِ بملاحظات طائشة أيّها السّارق الشّبح إكس

237
00:18:29,500 --> 00:18:33,000
أتظنّ أنّك ستفلت إن كذبت؟

238
00:18:34,840 --> 00:18:38,090
...يصعب تصديق ذلك فجأة

239
00:18:39,340 --> 00:18:42,620
.لست بحاجة لتصديقي، لا أمانع

240
00:18:42,620 --> 00:18:46,080
...أفهم ذلك تمامًا يا معلّمي

241
00:18:46,080 --> 00:18:47,290
...تشو يون

242
00:18:47,290 --> 00:18:48,810
.لم يكذب

243
00:18:51,190 --> 00:18:53,230
.أرسين لم يكذب

244
00:18:54,440 --> 00:18:55,990
.شكرًا لك يا ولد

245
00:18:56,570 --> 00:18:59,740
.أثلجت صدري قليلًا

246
00:19:01,200 --> 00:19:02,670
.المعذرة

247
00:19:02,670 --> 00:19:05,060
لقد تأكّدنا أنّ الأشياء الّتي تمّت
...سرقتها من قبل السّارق الشّبح إكس

248
00:19:05,060 --> 00:19:08,660
.قد تمّت سرقتها كلّها من أماكن مختلفة حول العالم

249
00:19:08,660 --> 00:19:10,250
ماذا قلت؟

250
00:19:11,710 --> 00:19:12,670
ما الخطب؟

251
00:19:16,670 --> 00:19:18,260
...ما الّذي يجري

252
00:19:19,130 --> 00:19:22,760
!إنّ الهارو يرمّم نفسه

253
00:19:23,930 --> 00:19:25,510
...قلب صالح

254
00:19:27,020 --> 00:19:29,030
...وفقًا لبياناتي

255
00:19:29,030 --> 00:19:32,950
.تمّ اعتبار هذا الهارو كرمز مدينة القائد منذ القِدم

256
00:19:32,950 --> 00:19:35,910
.هنالك أسطورة بشأنه

257
00:19:35,910 --> 00:19:39,280
.أنّ الهارو سيكون القلب الصّالح

258
00:19:40,110 --> 00:19:43,990
.فهمت. تلك هي سمة الهارو في عالم نيو

259
00:19:44,990 --> 00:19:46,740
...القلب الصّالح

260
00:19:48,330 --> 00:19:50,050
.مُرّر من شخص لآخر، ليُخزّن أخيرًا في ذلك المتحف

261
00:19:50,050 --> 00:19:55,590
.هذا ما حدث

262
00:20:05,430 --> 00:20:07,140
...السّارق الشّبح إكس

263
00:20:16,230 --> 00:20:17,320
!أيّها الرّئيس

264
00:20:17,780 --> 00:20:21,120
.تمّ التأكّد من صحّة شهادتك

265
00:20:21,120 --> 00:20:24,240
.وتمّ إلغاء اسمك من قائمة أكثر المطلوبين

266
00:20:24,780 --> 00:20:29,200
...لكن إن كان الأمر كذلك، ألن يكون من الأفضل ألّا تسرق

267
00:20:29,200 --> 00:20:30,950
.إنّه صيد كنوز

268
00:20:31,910 --> 00:20:36,790
ألن يكون من الأفضل ألّا تقوم
بصيد الكنوز وتقول الحقيقة فحسب؟

269
00:20:38,300 --> 00:20:40,760
.سيكون ذلك غير رومانسيّ حقًّا

270
00:20:41,090 --> 00:20:44,450
.انبعاث الهارو يلخّص كلّ شيء

271
00:20:44,450 --> 00:20:47,990
.أنت رجل صاحب قلب صالح

272
00:20:47,990 --> 00:20:51,580
.مع أنّني كنتُ أؤدّي واجبي، سامحني على فظاظتي

273
00:20:51,580 --> 00:20:52,850
...أيّها السّارق الشّبح إكس

274
00:20:53,230 --> 00:20:56,020
.لا، غاندام أرسين إكس

275
00:20:56,020 --> 00:20:57,610
!غمز

276
00:20:58,900 --> 00:21:03,380
،ذكرتم أنّ العالم يواجه تحدّيًا غير مسبوق

277
00:21:03,380 --> 00:21:05,570
.وقد تمّ تأكيد صحّة ذلك أيضًا

278
00:21:05,570 --> 00:21:08,400
.أنا مسرور حقًّا لأنّنا تفاهمنا أخيرًا

279
00:21:08,400 --> 00:21:12,660
.باسم القلب الصّالح، أثق بك بهذا

280
00:21:17,210 --> 00:21:20,650
.إنّه واجبنا أن نحمي سلامة مدينة القائد

281
00:21:20,650 --> 00:21:23,740
.لكن تواصلوا معنا رجاءً إن احتجتمونا

282
00:21:23,740 --> 00:21:26,840
.أينما كنتم في العالم، سنكون هناك

283
00:21:27,200 --> 00:21:29,380
!شكرًا لك يا فيردي باستر

284
00:21:35,590 --> 00:21:39,270
.أخيرًا، لدينا الهارو سليم

285
00:21:39,270 --> 00:21:42,380
!معلّمي رائع حقًّا

286
00:21:44,490 --> 00:21:46,790
.يبدو أنّ القمر خرج ثانيةً

287
00:21:53,060 --> 00:21:53,940
!ووكونغ

288
00:21:53,940 --> 00:21:55,290
ما الخطب؟

289
00:21:57,420 --> 00:22:01,160
...لقد... هربت من ذلك المكان

290
00:22:01,960 --> 00:22:02,820
ماذا؟

291
00:22:06,560 --> 00:22:07,670
القمر؟

292
00:23:39,980 --> 00:23:41,980
في الحلقة القادمة

293
00:23:44,750 --> 00:23:47,470
!سو سو-سان، التقينا أخيرًا

294
00:23:47,470 --> 00:23:51,240
!مهلًا، الآن ليس الوقت! ووكونغ في مأزق

295
00:23:51,760 --> 00:23:54,390
.إس د غاندام أبطال العالم

296
00:23:54,390 --> 00:23:56,740
".في الحلقة القادمة، "مهمّة ووكونغ

297
00:23:57,510 --> 00:23:59,790
!لا تفوّتوا هذه المغامرة