1
00:00:01,660 --> 00:00:07,500
!ليو بي، أقم العدالة في هذه البلاد معي

2
00:00:08,420 --> 00:00:09,550
...ليو بي

3
00:00:12,380 --> 00:00:13,610
ما الخطب؟

4
00:00:14,050 --> 00:00:17,550
.بإمكانك الاستفادة من قوّتك من أجل العالم

5
00:00:20,890 --> 00:00:22,060
!أرفض ذلك

6
00:00:22,850 --> 00:00:25,480
.يبدو أنّه كانت لديّ التوقّعات الخاطئة

7
00:00:27,730 --> 00:00:29,120
...إذًا

8
00:00:29,120 --> 00:00:30,670
.فلتمت

9
00:02:36,180 --> 00:02:38,140
الحلقة 16
أيّام النّدم

10
00:02:51,940 --> 00:02:53,650
.آسف يا رفاق

11
00:02:54,110 --> 00:02:56,660
.علينا اتّباع أوامر رئيسنا

12
00:03:00,080 --> 00:03:01,290
.انتهى الأمر

13
00:03:05,710 --> 00:03:06,540
ماذا؟

14
00:03:10,080 --> 00:03:11,830
...إنّهم

15
00:03:13,220 --> 00:03:15,670
!إنّهم مراقبة التّنين من منطقة شو

16
00:03:17,010 --> 00:03:18,260
!إنّهم أصدقاء ليو بي

17
00:03:18,260 --> 00:03:19,320
!أجل

18
00:03:19,320 --> 00:03:21,810
!سنشعل النّار أيضًا

19
00:03:30,230 --> 00:03:32,070
!ليو بي، لنذهب! نحن الثّلاثة معًا

20
00:03:34,320 --> 00:03:35,530
!حسنًا

21
00:03:46,830 --> 00:03:50,830
!سوينغيكي ريوها

22
00:03:54,290 --> 00:03:55,580
!لن يفلح ذلك

23
00:04:00,600 --> 00:04:03,600
!تيمبو هو-أودايهازان

24
00:04:22,280 --> 00:04:25,790
!هارو! علمت أنّ ليو بي سيحتاج إلى قوّتك

25
00:04:26,580 --> 00:04:28,380
!سأرسلك إلى هناك الآن

26
00:04:28,380 --> 00:04:30,250
.لا تغترّ بنفسك

27
00:04:31,170 --> 00:04:34,840
هل تظنّ أنّ بإمكانك المرور من هنا بسهولة؟

28
00:04:36,670 --> 00:04:38,220
!دعني أتولّى هذا

29
00:04:47,180 --> 00:04:48,390
...أنت

30
00:04:50,100 --> 00:04:51,190
!تشو يو

31
00:04:52,400 --> 00:04:53,730
أما زلت حيًّا؟

32
00:05:11,460 --> 00:05:13,210
!تشو وي

33
00:05:17,800 --> 00:05:19,230
...مؤلم

34
00:05:19,230 --> 00:05:21,430
...لقد نجوت

35
00:05:21,760 --> 00:05:24,620
لكن، أين أنا؟

36
00:05:24,620 --> 00:05:27,020
أبي، من هذا الشّخص؟

37
00:05:32,770 --> 00:05:35,190
!تفضّل، كل قدر ما تريد

38
00:05:35,730 --> 00:05:37,740
كيف حال ليو بي والجميع؟

39
00:05:38,940 --> 00:05:41,450
.سيكونون بخير بالتّأكيد

40
00:05:43,530 --> 00:05:46,450
...لنتحدّث عن الأمر لاحقًا

41
00:05:49,120 --> 00:05:50,750
!هيّا بنا يا هارو

42
00:05:54,630 --> 00:05:56,710
!انتظرني يا ليو بي

43
00:06:01,590 --> 00:06:04,430
.ليو بي، سأسألك مرّة أخرى

44
00:06:04,890 --> 00:06:08,390
.سأصفح عن حياتك إن اتّبعت أوامري

45
00:06:13,520 --> 00:06:15,890
...قلت لا بالفعل

46
00:06:16,480 --> 00:06:18,070
...فهمت

47
00:06:19,110 --> 00:06:20,440
!فلتمت إذًا

48
00:06:27,790 --> 00:06:29,280
!ريوسوسن

49
00:06:34,630 --> 00:06:36,750
!هل يعقل... تشو يو

50
00:06:37,210 --> 00:06:38,500
!ليو بي

51
00:06:39,420 --> 00:06:41,760
!خذ هذه

52
00:06:44,550 --> 00:06:45,840
!هارو

53
00:07:13,570 --> 00:07:14,920
!سو سو-سان، لا رادع لي الآن

54
00:07:19,420 --> 00:07:20,750
.هذا مثير للاهتمام

55
00:07:21,370 --> 00:07:22,620
!خذ هذه

56
00:07:31,680 --> 00:07:33,090
!هيّا

57
00:07:33,090 --> 00:07:34,550
!ليو بي

58
00:07:34,550 --> 00:07:36,060
!أوسعه ضربًا

59
00:07:40,270 --> 00:07:42,770
.يمتلك المرء قوّة التّنين

60
00:07:42,990 --> 00:07:45,490
...وبتلك القوّة

61
00:07:45,490 --> 00:07:47,190
.سينقذ المرء العالم

62
00:07:50,660 --> 00:07:56,330
!تشوزيتو شيغوكو سويغيكي ريوها

63
00:08:08,590 --> 00:08:10,010
!سو سو-ساما

64
00:08:25,950 --> 00:08:26,990
.ليو بي

65
00:08:28,450 --> 00:08:29,870
.سيكون ذلك كافيًا

66
00:08:34,750 --> 00:08:37,490
...فات الأوان بالفعل

67
00:08:38,500 --> 00:08:41,540
...ما عاد أحد يستطيع إيقافه

68
00:08:44,920 --> 00:08:46,130
ماذا قلت؟

69
00:08:49,010 --> 00:08:50,300
هارو؟

70
00:08:52,590 --> 00:08:54,770
.فقط ثلاث دقائق أخرى

71
00:08:57,180 --> 00:08:58,930
حقًّا؟

72
00:08:59,440 --> 00:09:03,110
.تجوكا، يا لك من قبيح

73
00:09:03,570 --> 00:09:06,550
.دائمًا ما تعترض طريقي

74
00:09:06,550 --> 00:09:08,070
!سيما يي-سان

75
00:09:08,530 --> 00:09:13,120
لمَ اختارك معلّمنا تجو غا بدلًا منّي؟

76
00:09:13,490 --> 00:09:17,790
.لو أنّه اختارني، لما احتاج المرور بذلك

77
00:09:19,920 --> 00:09:22,200
ما الغاية من هذا؟

78
00:09:22,200 --> 00:09:26,210
...لقد حرّضت دوداكو وحتّى أنّك حرّضت سو سو

79
00:09:26,840 --> 00:09:29,830
.لا، لا يوجد معنى أعمق للأمر

80
00:09:29,830 --> 00:09:33,150
.الفوضى هي رحم النّظام الجديد بالضّبط

81
00:09:33,150 --> 00:09:37,770
!حان الوقت لنعيد بناء هذا العالم

82
00:09:38,230 --> 00:09:41,980
نحن... من أنت حقًّا؟

83
00:09:45,360 --> 00:09:48,110
...لحظة أن تعرف

84
00:09:49,280 --> 00:09:51,660
!هي اللّحظة الّتي تنتهي فيها

85
00:10:03,040 --> 00:10:06,880
!حان الوقت لإنهاء هذا يا تجو كا

86
00:10:19,560 --> 00:10:21,850
...العرافة هي تخصّصك، وتستخدم ذلك

87
00:10:22,390 --> 00:10:26,620
.للتنبّؤ عندما يخرج القمر من وراء الغيوم

88
00:10:26,620 --> 00:10:30,900
إذًا، تنوي تفعيل أجزاء أو، صحيح؟

89
00:10:31,530 --> 00:10:36,080
.وستستخدمها للإطاحة بليبرا على ما أظنّ

90
00:10:36,580 --> 00:10:40,040
!لكنّ حظّك قد نفد

91
00:10:40,500 --> 00:10:42,570
!هذه نهايتك

92
00:10:50,010 --> 00:10:51,010
هل أنت بخير؟

93
00:10:51,380 --> 00:10:52,700
!ليو بي

94
00:10:52,700 --> 00:10:54,430
!أخبرني هارو عن هذا

95
00:11:03,190 --> 00:11:04,350
!هذه هي

96
00:11:25,240 --> 00:11:26,420
!نجحت

97
00:11:30,670 --> 00:11:33,590
.سنلتقي من جديد يا تجو كا

98
00:11:36,510 --> 00:11:37,640
...لقد اختفى

99
00:11:39,720 --> 00:11:42,180
!بسرعة! ستصطدم

100
00:11:42,520 --> 00:11:45,480
!لننسحب يا جماعة

101
00:11:48,200 --> 00:11:52,030
،بسبب تجو كا وليو بي المزعجين

102
00:11:52,580 --> 00:11:57,460
...دُمّرت خطّتي من أجل عالم المملكة

103
00:11:59,330 --> 00:12:01,290
.لكنّي أملك هذا الآن

104
00:12:01,490 --> 00:12:04,240
.لن أدعهم يعترضون طريقي بعد الآن

105
00:12:04,960 --> 00:12:08,130
.كما أنّني أملك بطاقة رابحة أخرى في جعبتي

106
00:12:08,590 --> 00:12:11,640
.هؤلاء المغفّلون لا يملكون أدنى فكرة

107
00:12:24,270 --> 00:12:27,890
...في تلك الحالة، من أجل التغلّب على قناع الظّلام

108
00:12:27,890 --> 00:12:28,780
.أجل

109
00:12:28,820 --> 00:12:32,020
...نحتاج إلى شخص ارتدى القناع من قبل

110
00:12:33,120 --> 00:12:34,200
.هذا أنا

111
00:12:34,700 --> 00:12:38,910
.حصلنا عليه عندما قاتلنا محاربي قناع الظّلام في عالم المحارب

112
00:12:39,500 --> 00:12:42,170
...تجو كا، أنت

113
00:12:42,880 --> 00:12:47,250
.ما زالت تجربة لا تصدّق ولا أستطيع شرحها، عندما أفكّر بها الآن

114
00:12:52,970 --> 00:12:57,600
...لحظة أرتدي ذلك القناع، المشاعر السّلبيّة داخلي

115
00:12:58,140 --> 00:13:02,520
.اعترتني مشاعر الغضب والغيرة والرّيبة فجأةً

116
00:13:03,350 --> 00:13:07,800
.أصبح جسدي مليئًا بهذه القوّة الّتي لا تصّدق عندما أدركت الأمر

117
00:13:09,400 --> 00:13:11,240
،ولاستعادة صوابنا

118
00:13:11,570 --> 00:13:14,120
.علينا أن نطرد الظّلام الّذي يستوطن قلوبنا

119
00:13:15,350 --> 00:13:18,160
.أي علينا أن ندمّر ذلك القناع

120
00:13:21,000 --> 00:13:24,540
.فور أن يُدمّر القناع، سيتخلّص ذلك الشّخص من اللّعنة

121
00:13:25,130 --> 00:13:26,710
.فهمت

122
00:13:27,250 --> 00:13:30,670
لكنّك عرفت أنّ ذلك كان خطيرًا. لمَ ارتديت القناع مع ذلك؟

123
00:13:31,220 --> 00:13:33,480
صحيح! تريد أن تغيضه فحسب، صحيح؟

124
00:13:33,480 --> 00:13:35,810
!يا لها من عادة سيّئة

125
00:13:35,810 --> 00:13:37,270
...هذا

126
00:13:37,270 --> 00:13:41,070
يمكن إرضاء الفضول بالتّجربة فقط، أليس كذلك؟

127
00:13:41,070 --> 00:13:44,930
.دائمًا ما تحاول خداعي بقول أشياء تناسبك

128
00:13:44,930 --> 00:13:47,120
.لن ينطلي عليّ ذلك بعد الآن

129
00:13:47,120 --> 00:13:52,600
إلّا أنّ هذه العادة السّيئة للباحثين
.هي ما قدّمت المساهمة هذه المرّة

130
00:13:52,860 --> 00:13:55,030
.يبدو الأمر كذلك

131
00:13:55,570 --> 00:13:57,490
!أرأيت؟ هذا هو سو سو

132
00:13:57,950 --> 00:14:02,690
.تمكّنت من التّعامل مع الأمر لأنّه كان تجوكا، صحيح؟ ليو بي

133
00:14:02,960 --> 00:14:03,850
.هذا صحيح

134
00:14:04,000 --> 00:14:04,920
!هذا قاسٍ

135
00:14:05,540 --> 00:14:06,510
،لكن بقول ذلك

136
00:14:06,510 --> 00:14:10,960
.من الصّعب للغاية هزيمة شخص حصل على قوّة قناع الظّلام

137
00:14:11,760 --> 00:14:14,260
.بما أنّنا مواجه نوبوناغا، فسيصبح الأمر أصعب حتّى

138
00:14:26,690 --> 00:14:30,270
.بشأن ذلك، لديّ فكرة

139
00:14:31,280 --> 00:14:35,740
.هناك صانع سيوف مشهور يدعى "ماغوهاتشي" في عالم موشا

140
00:14:36,410 --> 00:14:38,960
...أعتقد أنّه يستطيع صنع كاتانا

141
00:14:38,960 --> 00:14:43,000
يضاهي أو يتفوّق على كاتانا نوبوناغا-ساما
".الأسطوريّ، "هيشيكيري-هاسيبي

142
00:14:43,580 --> 00:14:48,750
.نحتاج تكتيك ضربة قاضية وكاتانا أسطوريّ لإزالة القناع

143
00:14:49,250 --> 00:14:54,420
.ساسكي، لنذهب للقاء صانع السّيوف ذاك قبل ذهابنا لعالم ريجينا

144
00:14:54,800 --> 00:14:55,840
.حاضر

145
00:15:33,750 --> 00:15:35,410
.هذا جميل

146
00:15:35,410 --> 00:15:36,470
ماذا؟

147
00:15:37,010 --> 00:15:41,220
.سمعت أنّ النّاس لا يتسنّى لهم رؤية هذا المظهر كثيرًا

148
00:15:42,560 --> 00:15:43,720
.فهمت

149
00:15:45,850 --> 00:15:47,530
أنت ووكونغ، صحيح؟

150
00:15:47,530 --> 00:15:50,310
.سمعت أنّك لا تملك ذكريات من ماضيك

151
00:15:53,440 --> 00:15:56,620
.تظهر أشياء باهتة قدر قليل في عقلي

152
00:15:56,620 --> 00:16:02,320
.لكنّي لست واثقًا ماذا تعني

153
00:16:04,790 --> 00:16:05,740
...فقط

154
00:16:07,960 --> 00:16:13,590
...ربّما قد قتلت شخصًا يعني لي الكثير، بيديّ هاتين

155
00:16:16,010 --> 00:16:17,210
.فهمت

156
00:16:20,630 --> 00:16:24,250
.إن كنت لا تستطيع تذكّرها، ما عليك سوى أن تظلّ كذلك

157
00:16:25,010 --> 00:16:26,170
ماذا؟

158
00:16:27,060 --> 00:16:28,980
.عش اللّحظة فقط وأعزّها

159
00:16:32,100 --> 00:16:33,560
...الجوّ بارد

160
00:16:40,360 --> 00:16:42,820
أنت نادم بشأن الماضي، صحيح؟

161
00:16:45,620 --> 00:16:49,040
.هذا النّدم هو ما يجعلك تعاني

162
00:16:49,410 --> 00:16:51,140
.لكن لا بأس

163
00:16:51,220 --> 00:16:51,790
ماذا؟

164
00:16:52,540 --> 00:16:55,800
.أنا أيضًا كان لديّ ما ندمتُ عليه وعانيت من قبل

165
00:16:56,920 --> 00:17:00,300
.لكنّي أفهم هذا فقط لأنّني قلق بشأن ذلك باستمرار

166
00:17:01,010 --> 00:17:02,520
ماذا عرفت؟

167
00:17:02,520 --> 00:17:04,260
.إنّه أمر بسيط حقًّا

168
00:17:05,260 --> 00:17:09,100
.إن كنت تظنّ أنّك قمت بالأمر بشكل خاطئ، لا تدعه يحدث ثانيةً فحسب

169
00:17:10,560 --> 00:17:13,570
...أتساءل إن كان باستطاعتي ذلك

170
00:17:13,570 --> 00:17:14,980
.يمكنك

171
00:17:17,020 --> 00:17:20,030
.لا تقلق. لست لوحدك الآن

172
00:17:20,950 --> 00:17:23,530
ليو بي وتجوكا، إنّهما معك، صحيح؟

173
00:17:25,480 --> 00:17:28,790
.لا شكّ في ذلك، إن بقيت معهما

174
00:17:30,410 --> 00:17:35,080
.معك حقّ. سيكون الأمر بخير إن ظللنا معًا

175
00:17:35,500 --> 00:17:37,210
.بالضّبط

176
00:17:54,050 --> 00:17:56,080
.هذا مريح حقًّا

177
00:17:56,080 --> 00:17:57,280
أليس كذلك؟

178
00:17:57,280 --> 00:17:59,870
.حسنًا. سأسلّم هذا لك

179
00:17:59,870 --> 00:18:03,410
لكن ألن يتسبّب ذلك بالمشاكل؟

180
00:18:03,410 --> 00:18:06,620
.لا داعي للقلق... لديّ واحد إضافيّ

181
00:18:07,490 --> 00:18:10,290
.شكرًا على لطفك إذًا. لا أستطيع التّعبير عن امتناني ما يكفي

182
00:18:12,750 --> 00:18:15,290
.اعتن بسو سو رجاءً

183
00:18:16,040 --> 00:18:18,930
.يظهر شعورًا مفرطًا بالعدالة أحيانًا

184
00:18:18,930 --> 00:18:20,430
.بإمكاني سماعك

185
00:18:20,430 --> 00:18:22,970
.كما أنّه صبيانيّ قليلًا، بطريقة غريبة

186
00:18:22,970 --> 00:18:24,680
!كفّ عن إعطائه أفكارًا غريبة

187
00:18:25,000 --> 00:18:26,140
أرأيت؟

188
00:18:26,340 --> 00:18:28,100
...لنرَ

189
00:18:32,180 --> 00:18:35,020
.عجبًا. هذا جميل للغاية

190
00:18:37,480 --> 00:18:38,910
.بالتّوفيق

191
00:18:38,910 --> 00:18:40,480
.أنت أيضًا يا سو سو-سان

192
00:18:43,990 --> 00:18:45,890
.إلى اللّقاء يا سو سو-سان

193
00:18:46,160 --> 00:18:47,200
.حسنًا

194
00:18:47,780 --> 00:18:49,590
.نراك في عالم ريجينا

195
00:18:49,590 --> 00:18:50,810
.حسنًا

196
00:19:28,160 --> 00:19:30,190
...قلعة كاميلوت

197
00:19:30,570 --> 00:19:33,170
.لنزر ذلك المكان صباح الغد ثانيةً

198
00:19:33,170 --> 00:19:34,370
.أجل

199
00:19:39,380 --> 00:19:40,960
...إنّه قناع الظّلام

200
