1
00:00:04,020 --> 00:00:06,440
.لا تبدو سعيدًا للغاية يا إيزان-كُن

2
00:00:06,730 --> 00:00:08,020
عمّاذا تتحدّث؟

3
00:00:08,020 --> 00:00:09,940
.الحلبة متحمّسة للغاية

4
00:00:09,940 --> 00:00:12,070
.انتخابات الخريف لهذه السّنة كانت ناجحة للغاية

5
00:00:12,070 --> 00:00:14,660
.لا يوجد ما قد لا يُسعدنا في هذا بصفتنا المنظّمين

6
00:00:14,860 --> 00:00:19,410
لكنّها تبدو مختلفة تمامًا عمّا تخيّلتَه أنت، صحيح؟

7
00:00:21,000 --> 00:00:22,870
.لا فكرة لي عمّاذا تتحدّث

8
00:00:23,250 --> 00:00:27,580
أنت من وضع ميماساكا سوبارو
في طريق سوما-كُن، صحيح؟

9
00:00:28,290 --> 00:00:30,000
،إن استغلّ تاكومي-كُن

10
00:00:30,000 --> 00:00:32,460
.كان سوما-كُن ليوافق على الشّوكوغيكي بدون شكّ

11
00:00:32,760 --> 00:00:36,590
إن هُزم أمام جمهور كبير دون
،أن يتمكّن من الانتقام لصديقه

12
00:00:36,590 --> 00:00:38,850
.فلن تكون هنالك مذلّة أكبر من ذلك

13
00:00:39,220 --> 00:00:42,810
حافظتَ على يديك نظيفتين، وتلاعبتَ
.بكلّ شيء من خلف الكواليس

14
00:00:42,810 --> 00:00:45,140
.هذا أسلوبك يا إيزان-كُن

15
00:00:45,690 --> 00:00:47,690
.لكنّ خططك لم تنجح

16
00:00:48,190 --> 00:00:51,110
استعملتَ دهاءك لتنصب فخًّا له
،بأفضل الطّرق الّتي تعرفها

17
00:00:51,570 --> 00:00:55,610
.لكن على الأرجح أنّك أنت من وقع فيه بدل ذلك

18
00:00:55,950 --> 00:00:57,070
!ماذا قلت؟

19
00:00:57,360 --> 00:00:59,910
.أتمنّى لو تأخذون حصصًا ثانية

20
00:00:59,910 --> 00:01:01,830
ألا يريد أحد منكم المزيد؟

21
00:01:02,750 --> 00:01:04,960
.هذه نهاية الطّريق

22
00:01:05,710 --> 00:01:09,210
—بهذا، ينتهي التّقييم

23
00:01:08,330 --> 00:01:10,670
،إن كنتم تريدون حصصًا ثانية

24
00:01:10,670 --> 00:01:13,670
أتمنّى لو تضيفون هذا فوق الأرزّ
.وتأكلون بالهناء والشّفاء

25
00:01:17,470 --> 00:01:20,010
،كلاّ، لأكون أكثر دقّة

26
00:01:20,010 --> 00:01:21,850
.لستَ أنت وحدك

27
00:01:22,310 --> 00:01:25,640
.شعر الجميع في توتسكي بنفس الشّعور

28
00:01:27,100 --> 00:01:30,480
.طبق سمك الصّوري الّذي أعددتُه لم يكتمل بعد

29
00:01:30,900 --> 00:01:31,820
...هذا

30
00:01:32,820 --> 00:01:34,490
حساء أبيض؟

31
00:03:08,500 --> 00:03:10,410
.لنأكل حصصًا ثانية

32
00:03:14,290 --> 00:03:18,210
،يوكيهيرا-كُن، يمكنك أن تصارع حتّى النّهاية

33
00:03:18,210 --> 00:03:23,430
لكن أليست هذه نفس الفكرة
!الّتي استعملتَها في مباراتك ضدّي؟

34
00:03:23,720 --> 00:03:25,510
.كلاّ، إنّها ليست كذلك يا أليس

35
00:03:25,970 --> 00:03:26,600
—هذه

36
00:03:27,010 --> 00:03:28,430
.تفضّلوا أيّها الحكّام

37
00:03:28,430 --> 00:03:29,980
،هذا هو طبق سمك الصّوري الّذي أعددتُه

38
00:03:30,350 --> 00:03:32,640
".أرزّ سمك الصّوري على شكل حساء"

39
00:03:33,480 --> 00:03:34,400
!بالهناء والشّفاء

40
00:03:38,730 --> 00:03:43,530
،الحساء اللّزج نوعًا ما قد تغلغل في الطّبق

41
00:03:43,530 --> 00:03:45,570
.وامتزج مع الأرزّ بكلّ خفّة

42
00:03:54,710 --> 00:03:55,920
!لقد فعلها

43
00:03:55,920 --> 00:03:57,090
!لقد كشف عن صدره

44
00:03:58,800 --> 00:04:00,670
...إنّه خفيف وقشديّ

45
00:04:00,960 --> 00:04:04,640
!هذا الحساء الأبيض عبارة عن حليب الصّويا

46
00:04:04,640 --> 00:04:06,050
!هذا صحيح

47
00:04:06,050 --> 00:04:10,350
أضفتُ الميسو والقليل من جبنة البارمزان
،بشكل تدريجيّ لحليب الصّويا

48
00:04:10,350 --> 00:04:12,640
!ثمّ غليتُه ببطء إلى أن أصبح الحساء دافئًا

49
00:04:13,020 --> 00:04:14,270
حليب الصّويا؟

50
00:04:15,600 --> 00:04:17,360
.لاحظتِ الأمر يا أليس

51
00:04:17,360 --> 00:04:19,730
.المكوّن الأساسيّ للحساء هو المرق

52
00:04:20,150 --> 00:04:24,240
لقد استعمل حليب الصّويا كالمرق
.وبنى طبقه على ذلك الأساس

53
00:04:24,700 --> 00:04:26,200
.فهمت

54
00:04:27,070 --> 00:04:30,290
.المرق عبارة عن أومامي بشكل أساسيّ

55
00:04:30,290 --> 00:04:33,750
يحتوي حليب الصّويا على كمّيّات كبيرة
.من حمض الغلوتاميك كالأعشاب البحريّة

56
00:04:34,250 --> 00:04:38,000
إنّه أكثر من كافٍ ليقوم مقام
.الأساس لنكهة الحساء

57
00:04:38,460 --> 00:04:40,880
.إضافة لذلك، مركّبات الأومامي لديها تأثير تآزريّ

58
00:04:40,880 --> 00:04:42,880
،عند تواجد المكوّنين معًا

59
00:04:42,880 --> 00:04:44,930
فإنّ الأومامي النّاتج يكون أكثر
.بكثير من مجموع أجزائه

60
00:04:44,930 --> 00:04:46,720
حمض الإينوزينيك في سمك الصّوري

61
00:04:46,720 --> 00:04:48,390
...وحمض الغلوتاميك في حليب الصّويا

62
00:04:48,390 --> 00:04:50,600
.الجمع بين هذين المكوّنين منطقيّ للغاية

63
00:04:50,600 --> 00:04:52,560
...حساء حليب الصّويا

64
00:04:52,980 --> 00:04:54,850
.مثير للاهتمام

65
00:04:57,020 --> 00:05:02,230
هنالك مكوّنات أصبحت فجأة بارزة
.أكثر عند إضافة الحساء أيضًا

66
00:05:02,610 --> 00:05:05,240
ما هذا الّذي مزجتَه مع الأرزّ؟

67
00:05:05,240 --> 00:05:06,490
.برقوق مقرمش مخلّل

68
00:05:07,110 --> 00:05:07,860
برقوق مقرمش مخلّل؟

69
00:05:07,860 --> 00:05:08,620
!ماذا؟

70
00:05:08,620 --> 00:05:09,950
!إنّه يستعمل وجبات خفيفة شائعة ثانية

71
00:05:10,280 --> 00:05:12,790
.يقوم هذا البرقوق بدور مهمّ للغاية

72
00:05:12,790 --> 00:05:15,250
ذلك الإحساس المقرمش في الفم ممتع
!ويضيف تأثيرًا بصريًّا مليئًا بالحيويّة

73
00:05:15,250 --> 00:05:17,870
يساعد البرقوق مستقبلات المذاق
،على تجاوز دسامة سمك الصّوري

74
00:05:17,870 --> 00:05:19,670
.ويوفّر مذاقًا منعشًا حتّى بعد البلع

75
00:05:19,920 --> 00:05:23,170
.استغلّ الطبّقُ قدرةَ الحموضة على تعزيز الشّهيّة

76
00:05:23,170 --> 00:05:26,470
.كما أنّ البرقوق قد خُلّل في الملح

77
00:05:26,470 --> 00:05:28,680
!إنّه الخيار المثاليّ ليكمّل سمك الصّوري المعتّق

78
00:05:28,930 --> 00:05:32,600
المكوّن الآخر الّذي يجذب الانباه
!هو جبنة البارمزان في الحساء

79
00:05:32,600 --> 00:05:34,390
هذا المكوّن الغربيّ قد اجتمع مع المكوّنات اليابانيّة

80
00:05:34,390 --> 00:05:36,980
كسمك الصّوري بنخالة الأرزّ المملّحة
والبرقوق المخلّل والميسو

81
00:05:36,980 --> 00:05:39,270
!لإنشاء نكهة جديدة تمامًا

82
00:05:39,270 --> 00:05:44,740
...يذكّرني هذا بلحظة لقائي بمحبوبي

83
00:05:46,490 --> 00:05:47,900
.من هنا

84
00:05:51,490 --> 00:05:56,080
لقاء أمسى ممكنًا بين طرفين قد تطوّرا
...في بلادين وثقافتين مختلفتين

85
00:05:56,080 --> 00:05:57,710
.أكثر اللّقاءات تميّزًا

86
00:05:59,460 --> 00:06:00,540
.هذا غير ممكن

87
00:06:00,540 --> 00:06:02,420
.لقد نال ثناءً حسنًا

88
00:06:02,630 --> 00:06:04,960
...من كان يعلم أنّ التّلميذ المنتقل سوف

89
00:06:04,960 --> 00:06:06,880
هل قرأتَ هذا العدد من "توتسكي الرياضيّة"؟

90
00:06:06,880 --> 00:06:08,590
،حسب نادي الصّحاقة

91
00:06:08,590 --> 00:06:10,010
بإمكانهم نشر المزيد من النّسخ

92
00:06:10,010 --> 00:06:13,720
.إذا ما كتبوا مقالاً يهاجمون فيه سوما-كُن

93
00:06:13,720 --> 00:06:15,180
.بالطّبع بإمكانهم ذلك

94
00:06:15,180 --> 00:06:18,640
لقد قال علنًا أنّ هذه الأكاديميّة
.مجرّد جسر عليه أن يعبره

95
00:06:18,640 --> 00:06:20,770
.يمكنك أن ترى ذلك في ردّة فعل الجمهور أيضًا

96
00:06:20,770 --> 00:06:23,690
التّلميذ المنتقل غير محبوب ليس بالاسم
.فحسب، بل في الواقع أيضًا

97
00:06:23,690 --> 00:06:24,820
أهذا صحيح بالفعل؟

98
00:06:25,440 --> 00:06:28,150
.لا أظنّ أنّ هذا هو السّبب الوحيد

99
00:06:28,700 --> 00:06:32,200
أحرز نتيجة متقاربة للغاية في منافسة التّوابل
.مع هاياما-كُن في المرحلة التّمهيديّة

100
00:06:32,200 --> 00:06:36,200
هزم في المنافسات الرّئيسيّة
.حفيدة شيطان الطّعام أليس-كُن

101
00:06:36,200 --> 00:06:40,960
إضافة لهزيمته لميماساكا-كُن، الوحش
.الّذي لم يخسر في 99 تحدّي شوكوغيكي

102
00:06:41,670 --> 00:06:45,210
ومع ذلك لا يرغب العديد من التّلاميذ
.الاعتراف بسوما-كُن

103
00:06:45,500 --> 00:06:46,880
ما السّبب يا ترى؟

104
00:06:48,090 --> 00:06:51,430
لقد طرحتُ هذا السّؤال
.على والد سوما-كُن من قبل

105
00:06:51,430 --> 00:06:52,140
!أبي

106
00:06:52,640 --> 00:06:55,470
!سوف أصبح الطّاهي الّذي سيتغلّب عليك يا أبي

107
00:06:55,760 --> 00:06:57,430
أهكذا إذًا؟

108
00:06:57,430 --> 00:06:58,730
.حسنًا، أتمنّى لك التّوفيق

109
00:06:58,730 --> 00:06:59,430
!أجل

110
00:06:59,430 --> 00:07:01,940
!لنقم بمباراة طبخ الآن

111
00:07:02,900 --> 00:07:07,320
لم يكن يمتلك سوما أيّ مهارات
.طبخ خاصّة في نظري

112
00:07:08,030 --> 00:07:09,650
،يقول الأطفال أشياء كهذه دائمًا

113
00:07:10,110 --> 00:07:13,570
.لذلك توقّعتُ أنّه سيكتفي بعد أن أهزمه مرّة أو مرّتين

114
00:07:14,280 --> 00:07:17,990
.لكنّ سوما لم يستسلم أبدًا

115
00:07:18,580 --> 00:07:20,960
.يكون دائمًا أقرب إليّ بخطوة واحدة

116
00:07:21,670 --> 00:07:23,330
.أدركتُ شيئًا ما في أحد الأيّام

117
00:07:23,330 --> 00:07:28,460
هنالك شيء يمتلكه أيّ شخص
.عاديّ ولا يمتلكه سوما

118
00:07:28,960 --> 00:07:30,170
ماذا تقصد بذلك؟

119
00:07:30,720 --> 00:07:32,840
يعتقد الجميع

120
00:07:32,840 --> 00:07:36,810
.أنّه من الواضح أن يخسر شخص أمام آخر موهوب أكثر

121
00:07:36,810 --> 00:07:39,350
يريدون التّقليل من توقّعاتهم

122
00:07:39,350 --> 00:07:42,810
.لحماية كبريائهم واحترامهم لأنفسهم وما إلى ذلك

123
00:07:43,810 --> 00:07:45,810
.لكنّ سوما لا يملك آليّة الدّفاع تلك

124
00:07:46,190 --> 00:07:49,820
.إنّه يمتلك القوّة لمواجهة ما ينقصه وجهًا لوجه

125
00:07:50,190 --> 00:07:54,160
.إنّها قوّة لا تُصدّق حتّى أنا لا أمتلكها

126
00:07:54,990 --> 00:07:57,120
ما يُلهم طبخ سوما-كُن

127
00:07:57,120 --> 00:08:00,540
.ليست عبقريّة طبيعيّة أو أيّ شيء من ذلك

128
00:08:00,540 --> 00:08:01,660
.إنّه يجد الحلول لمشاكله فحسب

129
00:08:02,080 --> 00:08:04,580
.يستمرّ في تجربة وصفاته مرارًا وتكرارًا

130
00:08:04,580 --> 00:08:08,000
،يستطيع الجميع فعل ذلك
.لكن لا يقوم أيّ أحد بذلك بالفعل

131
00:08:08,340 --> 00:08:09,670
.أراهن أنّ ذلك لن ينجح

132
00:08:09,960 --> 00:08:12,630
إنّه في مواجهة هاياما أكيرا الّذي يملك
.حاسّة شمّ تفوق البشر

133
00:08:13,010 --> 00:08:16,390
كما أنّ كوروكيبا ريو طبّاخ من النّخبة
.اختارته عائلة ناكيري

134
00:08:16,390 --> 00:08:17,430
هل من طريقة للفوز في مواجهتهما؟

135
00:08:17,430 --> 00:08:19,100
.ما كنتُ لأزعج نفسي حتّى بالتّفكير في ذلك

136
00:08:19,100 --> 00:08:20,470
.هذا مستحيل

137
00:08:20,470 --> 00:08:22,600
.طبعًا سيفوز العبقريّ

138
00:08:22,890 --> 00:08:26,610
لماذا يرون سوما-كُن بهذه النّظرة المتدنّية؟

139
00:08:26,900 --> 00:08:28,520
،لأنّهم إذا ما اعترفوا به

140
00:08:28,520 --> 00:08:31,320
.فذلك يعني اعترافهم بافتقارهم لبذل المجهود

141
00:08:34,070 --> 00:08:37,030
.لكنّ الطّاولة على وشك أن تنقلب

142
00:08:37,320 --> 00:08:38,280
!إنّه رائع

143
00:08:38,280 --> 00:08:38,780
.أجل

144
00:08:38,780 --> 00:08:41,910
!إنّه في نفس مستوى ذلكما الوحشين هناك

145
00:08:41,910 --> 00:08:43,210
.ربّما ينجح في التّغلّب عليهما

146
00:08:43,500 --> 00:08:46,170
.أجل، قد أبدأ باحترامه بعد الآن

147
00:08:46,500 --> 00:08:47,460
...يوكيهيرا

148
00:08:47,460 --> 00:08:49,960
.يوكيهيرا

149
00:08:48,210 --> 00:08:49,040
!يوكيهيرا

150
00:08:49,960 --> 00:08:51,630
...إنّ يوكيهيرا سوما

151
00:08:51,630 --> 00:08:53,090
!رائع

152
00:08:57,590 --> 00:08:58,550
!سعيد لأنّه أعجبكم

153
00:08:59,390 --> 00:09:01,520
!بهذا تنتهي مرحلة التّقدير

154
00:09:02,390 --> 00:09:03,890
!سننتقل الآن للتّقييم النّهائيّ

155
00:09:10,440 --> 00:09:11,440
.يكفي

156
00:09:11,730 --> 00:09:13,440
من الفائز؟ من الفائز؟

157
00:09:13,440 --> 00:09:14,530
!واثقة أنّ الأمر سيكون على ما يرام

158
00:09:14,530 --> 00:09:15,450
!يمكنه أن ينجح

159
00:09:15,450 --> 00:09:16,450
!يمكنه ذلك

160
00:09:16,450 --> 00:09:17,490
...سوما-كُن

161
00:09:21,910 --> 00:09:23,120
...يوكيهيرا

162
00:09:23,120 --> 00:09:26,160
،بعد تقليلك للفارق بين جودة مكوّناتنا
.أستطعتَ أيضًا تقديم طبق من ذلك المستوى

163
00:09:26,540 --> 00:09:28,000
.هذا مثير للاهتمام

164
00:09:28,000 --> 00:09:30,130
.أنت مثير للاهتمام بالفعل يا يوكيهيرا

165
00:09:31,880 --> 00:09:34,920
.هذه هي النّتيجة النّهائيّة سواء كانت جيّدة أم سيّئة

166
00:09:35,380 --> 00:09:36,420
!هذه اللّحظة الحاسمة

167
00:09:36,760 --> 00:09:38,430
.أوّلاً، أحسنتم صُنعًا

168
00:09:38,800 --> 00:09:42,310
لقد قدّمتم لنا القدرات مميّزة لكلّ واحد
،منكم في أفضل حالاتها

169
00:09:42,310 --> 00:09:45,430
!في معركة ارتقت لمستوى النّهائيّات

170
00:09:45,430 --> 00:09:47,310
،بالنّظر إلى تقنيّاتكم في الطّبخ

171
00:09:47,560 --> 00:09:50,060
.كنتم أنتم الثّلاثة متعادلون

172
00:09:50,060 --> 00:09:52,520
وبالنّظر إلى قدراتكم على الحكم
،على جودة المكوّنات

173
00:09:52,770 --> 00:09:55,400
.كانت الغلبة لكوروكيبا وهاياما بشكل واضح

174
00:09:55,400 --> 00:09:58,820
لقد قاما باتّخاذ القرار المثاليّ
.عند اختيارهما لسمك الصّوري

175
00:09:59,410 --> 00:10:03,830
.ولكنّ يوكيهيرا قد قلّل من ذلك الفارق بفضل إبداعه

176
00:10:04,200 --> 00:10:07,710
!كان ابتكاره ذاك مميّزًا بينكم أنتم الثّلاثة

177
00:10:09,870 --> 00:10:10,540
!ممتاز

178
00:10:10,960 --> 00:10:13,090
،وما فاجأنا أكثر

179
00:10:13,090 --> 00:10:17,380
.هو امتلاك الأطباق الثّلاثة لنكهات متقاربة المستوى

180
00:10:19,880 --> 00:10:22,640
ولكنّ العامل الّذي فصل بينكم

181
00:10:22,890 --> 00:10:25,600
.كان لأيّ درجة كان الطّبق انعكاسًا لتميّز الطّاهي

182
00:10:26,600 --> 00:10:28,810
لتميُّز الطّاهي؟

183
00:10:28,810 --> 00:10:30,850
.هذا صحيح يا يوكيهيرا-كُن

184
00:10:31,150 --> 00:10:34,070
الطّبق الّذي امتلأ بأصالة حقيقيّة

185
00:10:34,070 --> 00:10:39,530
يمكّننا من تصوّر الطّاهي في خيالنا
.عن طريق تذوّق طعامه فحسب

186
00:10:39,530 --> 00:10:40,950
،بعبارات أخرى

187
00:10:40,950 --> 00:10:42,950
وحده الطّبق الّذي تميّز بأصالة

188
00:10:42,950 --> 00:10:45,240
.لا يمكن إلاّ لطاهٍ معيّن أن يعدّه

189
00:10:45,240 --> 00:10:51,630
،نسمّي هذا الطّبق باختصاص الطّاهي
.كعلامة احترام له

190
00:10:51,880 --> 00:10:53,710
المتنافس الّذي استحقّ النّصر

191
00:10:53,710 --> 00:10:57,050
هو الطّاهي الّذي سعى خلف
!طبخه بطريقته الخاصّة

192
00:10:57,050 --> 00:11:01,180
الطّاهي الّذي سعى ليعرف
!كيف يجب أن يكون طبخه

193
00:11:02,470 --> 00:11:04,800
...واسم ذلك الشّخص هو

194
00:11:15,770 --> 00:11:19,650
.لا أعرف كيف يبدو والداي ولا حتّى اسمي الحقيقيّ

195
00:11:19,650 --> 00:11:26,030
كلّ ما أعرفه هو أنّه قد تمّ التّخلّي عنّي
.وأنا رضيع في ضواحي حيّ فقير

196
00:11:26,030 --> 00:11:29,450
.أنت تستحقّ ما هو أفضل من هذا

197
00:11:29,950 --> 00:11:33,580
!قد تضع حاسّة شمّك بصمتها على العالم بأسره

198
00:11:38,340 --> 00:11:43,180
كانت شيومي جون من أخرجتني
.من ذلك الحيّ الفقير

199
00:11:44,260 --> 00:11:47,560
،وافق الأستاذ هاياما الّذي كان مرشد جون حينها

200
00:11:47,560 --> 00:11:49,970
.أن يُصبح وليّ أمري القانونيّ

201
00:11:50,560 --> 00:11:56,270
لقد اختارا لي اسمًا يشير إلى شخص سيسلّط
.الضّوء على عالم جديد من الطّبخ

202
00:11:56,270 --> 00:11:58,150
.سمّياني أكيرا

203
00:12:18,800 --> 00:12:21,260
.أكيرا-كُن فتى جيّد

204
00:12:21,260 --> 00:12:23,880
.إنّه صادق للغاية في مساعدتي في بحثي

205
00:12:24,220 --> 00:12:27,180
.إنّه يساعدني التّعويض عمّا ينقصني

206
00:12:27,180 --> 00:12:29,640
.لا أستطيع أن أوفيه حقّه من الشّكر

207
00:12:30,520 --> 00:12:31,600
...لكن

208
00:12:32,350 --> 00:12:33,730
.أنا خائفة

209
00:12:33,730 --> 00:12:38,650
أخشى أنّي أجعل أكيرا-كُن يقوم بشيء
.هو لا يرغب به من أجلي فحسب

210
00:12:39,980 --> 00:12:40,820
.كلاّ

211
00:12:41,610 --> 00:12:43,820
.هذا ليس صحيحًا يا جون

212
00:12:44,400 --> 00:12:46,700
—لقد رأيتِ شيئًا ما فيّ
.رأيتِ قيمتي الحقيقيّة

213
00:12:47,410 --> 00:12:51,580
.تستحقّ ما هو أفضل من هذا

214
00:12:52,120 --> 00:12:54,370
!لقد منحتني سببًا لأعيش

215
00:12:54,620 --> 00:12:57,290
.أنت من سلّط الضّوء عليّ

216
00:12:58,000 --> 00:13:00,670
.عليّ أن أفوز من أجل جون

217
00:13:01,090 --> 00:13:02,840
!هذا ليس كافيًا

218
00:13:03,720 --> 00:13:06,340
طبخي بلا فائدة إلاّ إذا استطعت الفوز

219
00:13:06,340 --> 00:13:07,930
.باستعمال طريقة لا يستطيع أحد نسخها

220
00:13:09,140 --> 00:13:11,600
.سأغيّر عالم التّذوّق عن طريق قوّة الرّوائح

221
00:13:11,850 --> 00:13:13,930
.هذا هو طبخي

222
00:13:15,310 --> 00:13:18,520
!سأقدّم كلّ ما لديّ في هذا الطّبق

223
00:13:23,110 --> 00:13:24,530
...المنتصر

224
00:13:25,320 --> 00:13:27,160
!هو هاياما أكيرا

225
00:13:38,540 --> 00:13:39,580
!هاياما

226
00:13:39,580 --> 00:13:40,840
!إنّه هاياما

227
00:13:41,750 --> 00:13:44,050
.كارباتشيو سمك الصّوري المحروق

228
00:13:44,050 --> 00:13:47,130
.إنّه طبق يستحقّ أن يوصف باختصاص الطّاهي

229
00:13:54,720 --> 00:13:56,680
!تهانيّ لك يا هاياما-كُن

230
00:13:57,390 --> 00:13:58,900
...تهانيّ لك

231
00:13:58,900 --> 00:13:59,900
...تهانيّ

232
00:14:00,520 --> 00:14:02,860
!لقد نجحت يا هاياما-كُن

233
00:14:03,190 --> 00:14:05,820
...أنا سعيدة من أجلك! سعيدة للغاية

234
00:14:05,820 --> 00:14:08,320
.إنّك تحافظ على هدوئك دائمًا

235
00:14:08,320 --> 00:14:10,160
!عليك أن تعبّر عن فرحك أكثر

236
00:14:10,820 --> 00:14:11,490
—لقد فزت

237
00:14:18,160 --> 00:14:21,130
أ-أ-أكيرا-كُن، ما كان ذلك؟

238
00:14:21,130 --> 00:14:23,090
!لا-لا شيء

239
00:14:25,170 --> 00:14:29,720
.أكيرا-كُن، يقال أنّ رائحة القرفة تبهج المرء

240
00:14:33,720 --> 00:14:34,390
...فهمت

241
00:14:35,310 --> 00:14:37,430
...تعابيره خلال نصف النّهاية

242
00:14:38,850 --> 00:14:40,560
!أنا من سيحتلّ القمّة

243
00:14:40,560 --> 00:14:42,310
!لن أسمح لأيّ أحد آخر بالاقتراب

244
00:14:42,770 --> 00:14:45,530
.لم تكن تلك ابتسامة ثقة

245
00:14:45,530 --> 00:14:47,320
.بل كانت لتحفيز نفسه

246
00:14:47,320 --> 00:14:49,490
.كان الأمر أقرب إلى أنّه يهدّد نفسه

247
00:14:50,240 --> 00:14:51,410
.كم هذا رقيق

248
00:14:52,240 --> 00:14:55,290
.هاياما-كُن، كان ذلك طبقًا رائعًا

249
00:14:55,290 --> 00:14:57,160
.شكرًا لك أيّها الطّاهي دوجيما

250
00:14:57,450 --> 00:15:01,830
لكنّ المواهب العظيمة تنقلب
.على أصحابها في النّهاية

251
00:15:02,750 --> 00:15:06,590
آمُل أن تتمكّن من الحفاظ
.على علاقة جيّدة مع موهبتك

252
00:15:10,840 --> 00:15:11,840
!ريو-كُن

253
00:15:11,840 --> 00:15:14,760
!لا، لا، لا، لا، لا، لا، لا، لا

254
00:15:14,760 --> 00:15:17,640
!لا أصدّق أنّك خسرت وأنا أشاهدك

255
00:15:17,640 --> 00:15:19,850
!لا، لا، لا، لا، لا، لا

256
00:15:18,100 --> 00:15:19,850
.هذا يؤلم

257
00:15:19,850 --> 00:15:21,810
!ما الغرض من هذا؟

258
00:15:21,810 --> 00:15:24,230
كيف تتحدّث هكذا مع سيّدتك؟

259
00:15:24,230 --> 00:15:25,270
!انتهى أمرنا

260
00:15:25,270 --> 00:15:27,280
!يمكنك أن تعتذر لي عندما تشعر بالأسف

261
00:15:29,280 --> 00:15:32,410
!سوف أصبح الطّاهي الّذي سيتغلّب عليك يا أبي

262
00:15:34,280 --> 00:15:35,330
.اسمع يا سوما

263
00:15:35,330 --> 00:15:36,950
.تلك السّمكة ليست جيّدة

264
00:15:39,120 --> 00:15:42,580
إيّاك أن تُهزم أمام أيّ أحد آخر
!إلى أن تُهزم أمامي مرّة أخرى

265
00:15:46,290 --> 00:15:47,250
.هاياما

266
00:15:47,960 --> 00:15:50,380
هل بإمكانك إعداد المزيد من ذلك الكارباتشيو؟

267
00:15:50,380 --> 00:15:51,970
.لديّ المكوّنات لذلك

268
00:15:51,970 --> 00:15:52,800
.دعني أتذوّقه

269
00:15:53,090 --> 00:15:53,890
ماذا؟

270
00:15:54,720 --> 00:15:55,260
لماذا؟

271
00:15:55,260 --> 00:15:56,350
.دعني أتذوّقه

272
00:15:56,800 --> 00:15:58,350
—لكنّه يتطلّب وقتًا حتّى

273
00:15:58,350 --> 00:16:01,350
!دعني أتذوّقه أيضًا يا هذا

274
00:16:01,350 --> 00:16:03,190
لماذا تتصرّف وكأنّك تحاول أن تبدأ شجارًا؟

275
00:16:06,480 --> 00:16:08,320
ما قصّتكما أنتما الاثنان؟

276
00:16:09,400 --> 00:16:11,780
.كان باستطاعتي إعداده بشكل أفضل

277
00:16:11,780 --> 00:16:14,030
ماذا؟ أتقدّم الأعذار الآن؟

278
00:16:14,030 --> 00:16:14,910
.اسمعا

279
00:16:14,910 --> 00:16:17,990
لقد تمّ تحديد التّرتيب التّمهيديّ
.لتلاميذ السّنة الأولى اللّيلة

280
00:16:17,990 --> 00:16:20,370
.وأنا الأول بيننا نحن

281
00:16:20,370 --> 00:16:23,410
.عليكما أن تظهرا بعض الاحترام لي الآن

282
00:16:23,410 --> 00:16:26,080
!هل تريد أن نجري مباراة أخرى الآن؟

283
00:16:26,080 --> 00:16:26,880
.لا مانع لديّ

284
00:16:26,880 --> 00:16:28,420
.لن تتغيّر النتيجة أبدًا

285
00:16:28,420 --> 00:16:29,420
.على رسلكما

286
00:16:29,750 --> 00:16:32,670
.هاياما، لقد أعددتَ طبقًا لا بأس به

287
00:16:32,920 --> 00:16:35,680
لماذا تتحدّث بتعالٍ معي يا صاحب المركز الثّالث؟

288
00:16:35,680 --> 00:16:37,850
!أنت لا تعرف ذلك

289
00:16:37,850 --> 00:16:38,970
!لا تختلق أمورًا من عندك

290
00:16:39,220 --> 00:16:41,390
!أتقول أنّي أقلّ مرتبة منك؟

291
00:16:41,390 --> 00:16:43,180
!لا تصرخ وأنت تأكل

292
00:16:43,180 --> 00:16:44,850
.لكنّ طبقك كان رائعًا أيضًا يا هاياما

293
00:16:44,850 --> 00:16:48,110
.ربّما لا يوجد ما يدعو للقلق بشأن هاياما

294
00:16:48,110 --> 00:16:51,650
.يبدو أنّ هذا الثّلاثيّ سيكون مثيرًا للاهتمام

295
00:16:52,820 --> 00:16:54,280
.أجل

296
00:16:54,280 --> 00:16:56,860
إنّ الألماس الخامّ يصقل نفسه
.عن طريق التّصادم فيما بينه

297
00:16:56,860 --> 00:17:00,490
.هذا هو مبدأ توتسكي الأساسيّ

298
00:17:00,490 --> 00:17:05,620
!بالفعل. لقد وُلد اللّيلة عبقريّ جديد

299
00:17:18,720 --> 00:17:19,220
.تبًّا

300
00:17:39,620 --> 00:17:42,330
!سوما-كُن، أبليتَ بلاءً حسنًا

301
00:17:42,330 --> 00:17:46,080
أجل، سوف نحتفل اللّيلة بفوز يوكيهيرا
!بالمرتبة الثّانية

302
00:17:46,080 --> 00:17:47,330
!لنحتفل

303
00:17:47,330 --> 00:17:48,920
!أجل، في غرفة ماروي

304
00:17:48,920 --> 00:17:51,000
لماذا تحتفلون دائمًا في غرفتي؟

305
00:17:51,000 --> 00:17:52,590
لأنّها كبيرة، مفهوم؟

306
00:17:53,300 --> 00:17:55,090
آسف، هل يمكنكم أن تسبقوني؟

307
00:17:59,260 --> 00:18:00,680
ما الّذي تريده يا أبي؟

308
00:18:00,680 --> 00:18:01,510
.مرحبًا يا سوما

309
00:18:01,510 --> 00:18:02,680
.لم أحدّثك منذ مدّة

310
00:18:03,010 --> 00:18:03,970
...أخبرني

311
00:18:03,970 --> 00:18:05,850
كيف سارت المنافسات الرّئيسيّة؟

312
00:18:05,850 --> 00:18:07,980
...حسنًا، لقد

313
00:18:07,980 --> 00:18:08,730
...لذلك

314
00:18:08,730 --> 00:18:11,310
!ماذا؟ لقد خسرت، صحيح؟

315
00:18:11,310 --> 00:18:12,440
من فاز؟

316
00:18:12,770 --> 00:18:13,610
.هاياما

317
00:18:14,070 --> 00:18:15,990
.تلميذ شيومي

318
00:18:16,820 --> 00:18:18,030
تمالك نفسك، أتسمعني؟

319
00:18:18,030 --> 00:18:20,660
.الأمر أشبه بخسارتي ضدّ شيومي

320
00:18:21,070 --> 00:18:21,950
.سُحقًا

321
00:18:21,950 --> 00:18:24,870
.يصبح مبتهجًا للغاية عندما يسخر منّي

322
00:18:24,870 --> 00:18:26,450
أيّ نوع من الآباء قد يشعر بالسّعادة

323
00:18:26,450 --> 00:18:27,710
عندما يخسر أبنه؟

324
00:18:28,000 --> 00:18:32,500
لكن صراحة، سيكون الأمر مدهشًا
.لو استطعتَ إتقان التّحكّم في الرّوائح

325
00:18:32,920 --> 00:18:34,840
.كلاّ، لا يقتصر الأمر على هذا فحسب

326
00:18:35,090 --> 00:18:37,050
...أحسستُ في طبقه

327
00:18:38,010 --> 00:18:40,050
.بشيء أقرب إلى الهوس

328
00:18:40,550 --> 00:18:43,050
.أبي، أنا سعيد لأنّي تركتُ مطعم يوكيهيرا

329
00:18:43,810 --> 00:18:47,390
.لو لم أفعل ذلك، ما كنتُ لألاحظ كلّ هذه الأمور

330
00:18:47,770 --> 00:18:53,400
لذلك سأقوم باكتشاف نوع الطّبخ
.الّذي أستطيع أنا وحدي أن أتقنه

331
00:18:53,400 --> 00:18:57,240
إن لم أفعل ذلك، فلا فائدة تُرجى منّي
.في إدارتي لمطعم العائلة

332
00:18:57,860 --> 00:18:58,280
ماذا؟

333
00:18:58,570 --> 00:19:02,490
بما أنّي قلتُ ذلك، فذلك لا يبدو مختلفًا
.عمّا كنتُ أفعله سابقًا

334
00:19:02,490 --> 00:19:05,740
.حسنًا، لِمَ لا؟ اسلك تلك الطّريق

335
00:19:09,160 --> 00:19:10,920
هل تثاءب للتّوّ؟

336
00:19:10,920 --> 00:19:11,790
.مع السّلامة

337
00:19:13,210 --> 00:19:14,750
لقد التقى أخيرًا بشخص في مثل سنّه

338
00:19:15,340 --> 00:19:18,710
قادر على هزيمته كما هو الآن إذًا؟

339
00:19:19,380 --> 00:19:21,340
.هذا صحيح يا سوما

340
00:19:21,970 --> 00:19:23,260
.التقِ بهم

341
00:19:23,890 --> 00:19:27,560
.يستطيع الطّاهي التّقدّم بفضل لقاءات كهذه فحسب

342
00:19:28,470 --> 00:19:30,730
،إن واجهتَ طبقًا بمفردك

343
00:19:31,440 --> 00:19:34,310
.فلن ترى إلاّ نفسك الّتي عهدتَها في الماضي

344
00:19:36,770 --> 00:19:40,570
...طبخي الخاصّ

345
00:21:11,700 --> 00:21:13,120
!مرحبًا

346
00:21:13,120 --> 00:21:14,660
!نيكوميتشي

347
00:21:14,660 --> 00:21:15,370
!مرحبًا بك

348
00:21:15,370 --> 00:21:17,170
.شكرًا على الرّسالة

349
00:21:17,170 --> 00:21:19,090
وصلتك شحنة لحم طرائد جيّدة؟

350
00:21:19,090 --> 00:21:19,710
!أجل

351
00:21:19,710 --> 00:21:21,250
!تبدو لذيذة

352
00:21:21,880 --> 00:21:22,380
.انتهيت

353
00:21:22,710 --> 00:21:24,970
!إنّه لي، لكنّه يبدو رائعًا عليك

354
00:21:24,970 --> 00:21:26,630
.شكرًا يا ميغومي

355
00:21:26,630 --> 00:21:28,840
!حسنًا، لنبدأ

356
00:21:29,180 --> 00:21:29,930
!أجل

357
00:21:29,930 --> 00:21:30,890
.هذا جميل

358
00:21:30,890 --> 00:21:34,640
.فتيات جميلات متفاهمات في المطبخ

359
00:21:34,640 --> 00:21:38,190
.إنّهنّ لا تبدين جميلات بعد إمعان النّظر فيهنّ

360
00:21:39,110 --> 00:21:40,900
بالمناسبة، أين هو يوكيهيرا؟

361
00:21:40,900 --> 00:21:43,150
.إنّه هناك اليوم

362
00:21:43,530 --> 00:21:46,320
وبهذا، فإنّ النّكهة الخفيفة لحليب الصّويا

363
00:21:46,320 --> 00:21:50,370
.تعزّز الملوحة الخفيفة لسمك الصّوري بطريقة جيّدة

364
00:21:50,370 --> 00:21:53,540
ومع ذلك، يبدو البرقوق المخلّل مكوّنًا رخيصًا

365
00:21:53,540 --> 00:21:55,120
.بالنّسبة لي لآكله

366
00:21:55,120 --> 00:21:57,080
!لكنّك تأكله وكأنّك تحبّه

367
00:21:57,080 --> 00:21:57,920
.اسكب لي المزيد

368
00:21:57,920 --> 00:21:59,080
وتريد المزيد أيضًا؟

369
00:21:59,380 --> 00:22:02,960
.رغم أنّ الكارتوتشيو الّذي أعددتُه لك البارحة كان أفضل

370
00:22:03,960 --> 00:22:05,920
!حاول أن تعدّه مرّة أخرى

371
00:22:05,920 --> 00:22:07,090
!لنقارن أطباقنا

372
00:22:07,090 --> 00:22:09,800
هذا لا يهمّ، لكن لماذا لا تقومان
بتجربة الأطباق عندكما؟

373
00:22:10,180 --> 00:22:11,300
!لقد أعددتُ الشّاي

374
00:22:11,600 --> 00:22:13,680
!ليس عليك أن تقومي بالضّيافة يا جون

375
00:22:13,680 --> 00:22:17,020
كما أنّك تقدّمين كعكًا عالي الجودة أيضًا؟

376
00:22:17,020 --> 00:22:18,940
!إنّهما لن يمانعا تناول وجبات خفيفة رخيصة

377
00:22:18,940 --> 00:22:20,310
.نستطيع سماعك

378
00:22:20,310 --> 00:22:22,320
.أنت بخيل وتحبّ التّذمّر أيضًا

379
00:22:20,520 --> 00:22:24,230
.الاختصاص... طبق يُظهر شخصيّة الطّاهي

380
00:22:22,320 --> 00:22:24,730
.هذا لأنّك مجرّد وغد

381
00:22:24,730 --> 00:22:27,740
.ما الشّيء الّذي يمتلكه طبخ هاياما، ويفتقر إليه طبخي

382
00:22:28,570 --> 00:22:29,240
!على مهلك

383
00:22:29,240 --> 00:22:30,240
!لا تقحمه كلّه في فمك

384
00:22:30,240 --> 00:22:31,410
!هاياما

385
00:22:31,410 --> 00:22:33,580
.أريد مقارنة أطباقنا

386
00:22:33,580 --> 00:22:35,750
.اطبخ لي طبق كارباتشيو سمك الصّوري المحروك لو سمحت

387
00:22:35,750 --> 00:22:36,660
.بل طبقان

388
00:22:36,950 --> 00:22:38,410
.اخرسا. غادرا

389
00:22:38,410 --> 00:22:39,500
اثنان لكلّ واحد، مفهوم؟

390
00:22:39,710 --> 00:22:41,040
!يا هؤلاء

391
00:22:42,290 --> 00:22:45,960
إنّ يوكيهيرا ذاك مجنون لقضائه الكثير
.من الوقت مع شخص خسر أمامه

392
00:22:46,260 --> 00:22:46,880
.نعم

393
00:22:46,880 --> 00:22:48,220
أليس محبطًا بسبب النّتائج؟

394
00:22:48,720 --> 00:22:52,350
.أنا واثق أنّ سوما-كُن محبط أكثر ممّا نعتقد

395
00:22:52,350 --> 00:22:54,220
.لهذا السّبب هو هناك طوال الوقت

396
00:22:54,560 --> 00:22:57,560
،لكن بغرض أن يعرف المرء من يكون

397
00:22:57,560 --> 00:23:00,560
.عليه أن يخطو خارج العالم الّذي يعرفه

398
00:23:01,060 --> 00:23:05,230
.حتّى إن كان ذلك يعني مواجهة من تغلّب علينا

399
00:23:06,400 --> 00:23:08,860
.أنا واثق أن نفس الأمر ينطبق على الفتيات أيضًا

400
00:23:09,700 --> 00:23:13,240
إنّهنّ يحاولن بذل ما بوسعهنّ
،لتعلّم شيء ما من الأخرى

401
00:23:13,240 --> 00:23:14,580
.كما يفعل سوما-كُن تمامًا

402
00:23:15,410 --> 00:23:17,660
.سُحقًا، لن نسمح لهم بتجاوزنا

403
00:23:17,950 --> 00:23:19,210
!لنُقِم مهرجان تذوّق أطباق

404
00:23:19,210 --> 00:23:20,330
!تعالوا أنتم أيضًا

405
00:23:20,330 --> 00:23:20,790
!أجل

406
00:23:20,790 --> 00:23:22,630
!لنفعل هذا

407
00:23:22,630 --> 00:23:25,090
!ليس في غرفتي ثانية

408
00:23:25,290 --> 00:23:27,420
!تعال أيضًا يا إيبوساكي

409
00:23:28,380 --> 00:23:30,800
لن تذهب معهم، صحيح يا إيبوساكي-كُن؟

410
00:23:31,680 --> 00:23:34,350
أم أنّك تريد الانضمام للفتيات؟

411
00:23:34,640 --> 00:23:36,850
.أنت نار من تحت تبن يا إيبوساكي-كُن

412
00:23:37,930 --> 00:23:41,060
...حسنًا، لا داعي للعجلة

413
00:23:41,850 --> 00:23:47,070
في كلّ الأحوال، يمكن لتلاميذ السّنة الأولى
.في الثّانويّة أن يرتاحوا لوقت قصير فحسب

414
00:23:48,030 --> 00:23:49,490
لماذا؟

415
00:23:49,490 --> 00:23:50,440
ما الّذي تعنيه؟

416
00:23:51,320 --> 00:23:55,200
.سيتمّ إرسالكم خارج الأكاديميّة قريبًا

417
00:23:56,160 --> 00:23:57,200
.سوف يبدأ الأمر

418
00:23:57,450 --> 00:24:00,960
.برنامج التّدريب العمليّ، ستكونون متدرّبين

419
00:24:01,410 --> 00:24:03,370
متدرّبون؟

420
00:24:06,090 --> 00:24:08,800
"في الحلقة القادمة: "المتدرّبون