1
00:00:03,560 --> 00:00:06,440
،أكاديميّة توتسكي لمراسم الشّاي وفنّ الطّبخ

2
00:00:06,940 --> 00:00:11,900
معقل فنّ الطّبخ الّذي لا ينفكّ عن تقديم
.طهاةٍ ذوي شهرة عالميّة

3
00:00:13,150 --> 00:00:18,330
يشارك تلاميذ السّنة الأولى لديهم
،في انتخابات الخريف

4
00:00:18,330 --> 00:00:20,240
.والّتي بلغت الآن مرحلة حرجة

5
00:00:20,740 --> 00:00:23,040
إن مَن تأهّل مِن الجولات التّمهيديّة

6
00:00:23,040 --> 00:00:26,420
.يستعدّون الآن للمعركة التّالية

7
00:00:30,590 --> 00:00:31,210
!حسنًا

8
00:00:33,260 --> 00:00:36,300
هل حزمتُ سكّيني متعدّد الاستعمالات؟

9
00:00:37,260 --> 00:00:38,260
...ها هو ذا

10
00:00:39,010 --> 00:00:42,520
!هل حزمتُ المؤقّت؟

11
00:00:42,520 --> 00:00:45,140
سيقدّمون اليوم شرحًا
.عن المنافسة الرّئيسيّة فحسب

12
00:00:45,140 --> 00:00:46,850
فهل تحتاجين أدواتك لذلك؟

13
00:00:47,150 --> 00:00:48,940
.صحيح، معكما حقّ

14
00:00:48,940 --> 00:00:51,530
.يا إلهي. أنت لا تتغيّرين

15
00:00:51,530 --> 00:00:53,320
.أهلا يا تادوكورو

16
00:00:53,320 --> 00:00:55,280
.وصلت السّيّارة الّتي ستوصلنا

17
00:00:56,160 --> 00:00:57,160
!لنذهب

18
00:00:58,660 --> 00:01:02,620
،المتأهّلون الثّمانية الّذين لا تنقصهم الخبرة ولا التّميّز

19
00:01:02,620 --> 00:01:07,580
!سيبذلون قصارى جهدهم للصّعود للقمّة

20
00:01:08,080 --> 00:01:10,290
!ستبدأ منافسات انتخابات الخريف الرّئيسيّة الآن

21
00:01:23,850 --> 00:01:26,350
...سوما-كُن، بشأن نتائج الاختيار العشوائيّ

22
00:01:26,690 --> 00:01:29,610
.فسوف تشارك في أوّل جولة

23
00:01:29,610 --> 00:01:31,570
.موضوع الجولة هو البينتو

24
00:01:31,570 --> 00:01:32,780
البينتو؟

25
00:01:33,110 --> 00:01:34,280
تقصد علب الغداء؟

26
00:01:34,530 --> 00:01:35,860
.هذا صحيح

27
00:01:35,860 --> 00:01:39,570
انتهِ من كلّ الاستعدادات الضّروريّة اليوم
.من أجل منافسة الغد

28
00:01:39,570 --> 00:01:44,540
أرى أنّ هذه الأكاديميّة متواضعة أكثر
.ممّا ظننت لاختيارها البينتو

29
00:01:45,660 --> 00:01:47,250
عمّاذا تتحدّث؟

30
00:01:47,250 --> 00:01:49,120
.أنت جاهل إلى أقصى الحدود

31
00:01:49,120 --> 00:01:52,420
.البينتو هو ثقافةُ طعامٍ تُميّز اليابان وحدها

32
00:01:52,420 --> 00:01:58,090
لطالما أحبّ الذّوّاقةُ البينتو المعدّ
.من المكوّنات الموسميّة الرّاقية

33
00:01:58,090 --> 00:02:00,720
حتّى الطّهاة المشهورين خارج البلاد
،يعرفون البينتو حقّ المعرفة

34
00:02:00,720 --> 00:02:03,220
.كما أنّ كلمة "بينتو" قد أُضيفت للقاموس الفرنسيّ

35
00:02:03,510 --> 00:02:06,230
إنّه موضوع مناسب بشكل لا جدال
.فيه لاحتفالٍ بالطّعام كهذا

36
00:02:06,520 --> 00:02:10,730
"إنّه وحش مختلف تمامًا بالنّسبة لطعامِ "الذّوّاقة
!من الدّرجة الثّانية الّذي تجيده أنت

37
00:02:12,060 --> 00:02:14,530
عليّ أن أعترف، لا زلتُ غير معجب
.بهذا الجانب منكِ

38
00:02:14,980 --> 00:02:20,110
،أنا جدُّ بارع في الحديث مع الآخرين
.لكنّك شخص مختلف تمامًا يا ناكيري

39
00:02:20,110 --> 00:02:20,860
!ماذا؟

40
00:02:21,120 --> 00:02:24,450
كانت الأمور متوتّرة بيننا في طريقنا
!إلى هنا من المخيّم أيضًا

41
00:02:24,450 --> 00:02:25,540
!ماذا تقصد؟

42
00:02:25,540 --> 00:02:27,500
!لا فكرة لي إلامَ ترمي

43
00:02:27,500 --> 00:02:30,000
!إنّك تثير غضبي

44
00:02:28,580 --> 00:02:30,920
.هذا غريب

45
00:02:32,880 --> 00:02:35,550
.لديّ زائر بشأن موضوع مختلف تمامًا

46
00:02:35,840 --> 00:02:37,340
.لذلك أنا أستأذن

47
00:02:39,010 --> 00:02:40,340
.يوكيهيرا سوما

48
00:02:41,010 --> 00:02:45,010
.ابذل ما بوسعك لتتجاوز هذه الجولات

49
00:02:45,430 --> 00:02:48,680
.سيكون من المؤسف أن تفشل في أوّل جولة

50
00:02:50,890 --> 00:02:54,650
إذًا، من سيكون خصمي؟

51
00:02:55,770 --> 00:02:58,110
!شكرًا على انتظاركم بصبر

52
00:02:58,110 --> 00:03:00,110
!حان وقت المنافسة الرّئيسيّة لانتخابات الخريف أخيرًا

53
00:03:00,110 --> 00:03:05,620
!سوف نبدأ بالمباراة الأولى في الجولة الأولى

54
00:03:05,950 --> 00:03:08,580
،المشارك الأوّل هو المتنافس يوكيهيرا سوما

55
00:03:08,580 --> 00:03:11,420
الّذي تعادل في المركز الثّاني في المرحلة
.التّمهيديّة للمجموعة ب

56
00:03:11,420 --> 00:03:12,670
!ممتاز

57
00:03:12,670 --> 00:03:14,250
!حظًّا سعيدًا يا يوكيهيرا

58
00:03:14,630 --> 00:03:17,000
،وستُواجهه المتنافسة ناكيري أليس

59
00:03:17,000 --> 00:03:22,380
وهي الفائزة بلا منازع بالمرحلة
!التّمهيديّة للمجموعة ب

60
00:03:25,390 --> 00:03:26,760
.ناكيري أليس

61
00:03:27,010 --> 00:03:30,770
،حفيدة مدير الأكاديميّة ناكيري سينزايمون

62
00:03:30,770 --> 00:03:33,690
.والبطلة الأولى للعديد من المسابقات العالميّة

63
00:03:34,100 --> 00:03:37,150
.عبقريّة تُلقّب بابنة فنّ الطّبخ الجزيئيّ العزيزة

64
00:03:37,650 --> 00:03:40,780
حصل طبق الكاري الّذي أعدّته على أعلى
،العلامات في المرحلة التّمهيديّة

65
00:03:40,780 --> 00:03:44,870
وقد استعملت أحدث التّقنيّات
.وتركت انطباعًا ممتازًا

66
00:03:45,530 --> 00:03:47,870
كيف ستتصدّى لذلك يا يوكيهيرا؟

67
00:03:47,870 --> 00:03:53,620
.يوكيهيرا-كُن، سوف أسحرك بطبخي في هذا اليوم

68
00:03:53,620 --> 00:03:54,670
!هذا مذهل

69
00:03:54,670 --> 00:03:56,960
!إنّها أحدث معدّات الطّبخ

70
00:03:56,960 --> 00:03:58,380
،رغم أنّي أجلس على مقاعد المشاهدين

71
00:03:58,380 --> 00:04:01,090
.إلاّ أني أستطيع الإحساس بالتّوتّر بينهما

72
00:04:01,090 --> 00:04:04,010
لا أصدّق أنّه سيواجه إحدى
.حفيدَتَيْ ناكيري في جوّ كهذا

73
00:04:04,010 --> 00:04:09,100
نعم، أتساءل ما هو الضّغط
.الّذي يعاني منه يوكيهيرا الآن

74
00:04:09,100 --> 00:04:11,520
أنا نادمة تمامًا

75
00:04:11,520 --> 00:04:16,360
لأنّي لن أستطيع رؤية طبخك إلاّ مرّة
.واحدة على هذه الحلبة العظيمة

76
00:04:16,360 --> 00:04:20,320
إن خسرتِ، بإمكانكِ مشاهدة
.طبخي بين المشاهدين

77
00:04:20,320 --> 00:04:22,150
.أشكّ أنّ ذلك قد يحدث على الإطلاق

78
00:04:22,650 --> 00:04:26,740
أفكارك البالية وبراعة تقنيّاتك الّتي تعتمد
على عروض السّيرك الّتي تقدّمها

79
00:04:26,740 --> 00:04:29,120
لن تكون كافية لتتغلّب على
.حدود معرفة فنّ الطّبخ

80
00:04:31,080 --> 00:04:34,000
ماذا؟ ألم تنم جيّدًا البارحة؟

81
00:04:34,000 --> 00:04:37,330
.صحيح، لقد سهرتُ لوقت متأخّر وأنا أجرّب طبقي

82
00:04:37,330 --> 00:04:39,090
.كان الفجر قح طلع قبل أن أدرك حتّى أن الوقت قد مرّ

83
00:04:39,500 --> 00:04:41,550
،لكن لا تقلقي

84
00:04:41,550 --> 00:04:44,510
.هذا مجرّد يوم عاديّ بالنّسبة لي

85
00:04:44,880 --> 00:04:46,760
،لدينا زبناء في المطعم بتوقّعات عالية

86
00:04:46,760 --> 00:04:48,220
،وسكاكين لامعة مشحوذة وكأنّها شفرات حادّة

87
00:04:48,550 --> 00:04:49,930
...ومجموعة من المكوّنات

88
00:04:50,220 --> 00:04:51,430
الشّيء المختلف الوحيد

89
00:04:51,430 --> 00:04:54,310
.هو أنّي أملك منافسة أعمال مرعبة تقف أمامي

90
00:04:54,980 --> 00:04:58,480
.وسأفوز بالكثير هذا اليوم بعد أن أهزمك

91
00:04:58,480 --> 00:05:00,400
!وسأستعمل كلّ ما اكتسبتُه لأصبح أقوى بكثير

92
00:05:02,940 --> 00:05:04,530
!لننتقل للمباراة الأولى

93
00:05:04,530 --> 00:05:06,200
."الموضوع هو "البينتو

94
00:05:06,200 --> 00:05:08,030
!الوقت المخصّص هو ساعتان

95
00:05:09,660 --> 00:05:12,790
!ابدآ الطّبخ

96
00:05:14,580 --> 00:05:17,290
.حظًّا سعيدًا يا سوما-كُن

97
00:05:25,220 --> 00:05:27,050
.الأمر يشبه مشاهدة تجربة كيميائيّة

98
00:05:27,050 --> 00:05:28,640
!ماروي، اشرح لنا

99
00:05:28,640 --> 00:05:31,510
.لا أستطيع، هذا يتجاوز حدود معرفتي

100
00:05:31,510 --> 00:05:33,390
!هل هذه النّظّارات للزّينة فحسب؟

101
00:05:36,600 --> 00:05:40,360
.يجعل هذا حمضي النّوويّ اليابانيّ سعيدًا للغاية

102
00:05:45,070 --> 00:05:45,990
ماذا؟

103
00:05:45,990 --> 00:05:48,860
،كنتِ تسخرين من براعة تقنيّاتي منذ قليل

104
00:05:48,860 --> 00:05:50,070
.لكنّك ماهرة أيضًا

105
00:05:50,320 --> 00:05:51,200
!بالطّبع

106
00:05:51,490 --> 00:05:52,830
!كم هذا فظّ

107
00:05:52,830 --> 00:05:55,200
!لا يجب عليك التّحديق في الآخرين هكذا

108
00:05:55,200 --> 00:05:59,170
أتذكّر أنّ هنالك من كان يحدّق
...بي خلال المخيّم

109
00:05:59,170 --> 00:06:01,670
...إنّه يواجه حفيدة المدير

110
00:06:01,670 --> 00:06:02,630
!سُحقًا

111
00:06:02,630 --> 00:06:06,670
يوكيهيرا، من الأفضل أن تكون
!لديك خدع ما في جعبتك

112
00:06:06,670 --> 00:06:08,680
...أراهن أنّ بمقدوره الفوز

113
00:06:10,140 --> 00:06:10,800
!والآن

114
00:06:11,090 --> 00:06:13,390
!يوشك كِلا المتنافسَيْن على الانتهاء

115
00:06:13,930 --> 00:06:15,640
من سينتهي أوّلاً؟

116
00:06:15,930 --> 00:06:18,140
!إنّها المتنافسة ناكيري أليس

117
00:06:18,560 --> 00:06:20,600
.حان موعد تقديم الغداء

118
00:06:20,600 --> 00:06:22,110
!ماذا؟

119
00:06:22,440 --> 00:06:23,900
ما هو ذلك؟

120
00:06:23,900 --> 00:06:26,440
هل ذلك... ضبابٌ تحت تلك الأغطية؟

121
00:06:26,440 --> 00:06:29,110
!تبًّا، كم هو سهل عليها أن تفاجئنا بالكامل هكذا

122
00:06:29,490 --> 00:06:32,570
.ها أنتِ ذي تقدّمين شيئًا غريبًا ثانية

123
00:06:32,950 --> 00:06:35,740
!يا له من عرض يثير اهتمام المرء

124
00:06:35,740 --> 00:06:37,830
.هذا يناسب تمامًا أحتفالاً بالطّعام هكذا

125
00:06:47,920 --> 00:06:49,510
إنّه سوشي التّيماري؟

126
00:06:49,510 --> 00:06:50,380
.أجل

127
00:06:50,380 --> 00:06:54,260
استعملتُ كلّ تقنية أمتلكها لأُعدّ
.بينتو التّيماري هذا

128
00:06:54,600 --> 00:06:55,890
!إنّه في غاية الجمال

129
00:06:56,310 --> 00:06:59,890
.هذا الضّباب صادر من النّيتروجين السّائل

130
00:06:59,890 --> 00:07:04,150
كما أنّ لديه دورًا آخر وهو الحفاظ
.على السّوشي طازجًا وباردًا

131
00:07:04,150 --> 00:07:05,480
،اسمحوا لي

132
00:07:05,480 --> 00:07:09,570
أودّ أن أطلب منكم أن تأكلوا البينتو
.ابتداءً من أعلى اليسار

133
00:07:09,820 --> 00:07:12,070
.لدينا أوّلاً، خيرات البحر

134
00:07:13,070 --> 00:07:15,580
.هنالك رغوة أعلى محار أذن البحر هذا

135
00:07:15,580 --> 00:07:19,330
.الرّغوة هي مرق عشب البحر

136
00:07:19,750 --> 00:07:22,210
كان أذن البحر ملفوفًا أيضًا
.بعشب البحر خلال التّحضير

137
00:07:24,540 --> 00:07:25,880
،وعن طريق لفّ أذن البحر بعشب البحر

138
00:07:25,880 --> 00:07:28,880
نستطيع التّخلّص من الرّطوبة الزّائدة
.وإبقائه طازجًا لوقت أطول

139
00:07:28,880 --> 00:07:31,130
.إنّها طريقة مناسبة تمامًا لإعداد البينتو

140
00:07:31,130 --> 00:07:32,050
.معك حقّ

141
00:07:32,840 --> 00:07:35,890
.لكنّي أشكّ أنّ ذلك هو السّبب الوحيد لعشب البحر

142
00:07:37,060 --> 00:07:38,270
،من أجل ذلك السّوشي

143
00:07:38,600 --> 00:07:41,980
استعملت سمك البونيتو الّذي تمّ تعتيقه
.ليومين تحت درجة حرارة منخفظة

144
00:07:44,400 --> 00:07:45,980
!وكأنّ الأومامي ضربٌ من الخيال

145
00:07:47,110 --> 00:07:49,690
هذا الأومامي ليس مصدره
...هو سمك البونيتو وحده

146
00:07:50,110 --> 00:07:54,610
استعملتُ في السّوشي الأوّل حمض الإينوزينيك من
.سمك البونيتو وحمض الغلوتاميك من عشب البحر

147
00:07:54,610 --> 00:07:58,080
.نكهتا الأومامي هاتين لديهما تأثير تعاونيّ

148
00:07:58,540 --> 00:08:01,250
يشكّل طبق البينتو هذا صورة كاملة في الفم

149
00:08:01,250 --> 00:08:04,580
.بينما نأكل كلّ سوشي بشكل متتابع

150
00:08:04,580 --> 00:08:05,750
.هذا مذهل

151
00:08:05,750 --> 00:08:06,840
!أريد أن أتذوّقه

152
00:08:06,840 --> 00:08:07,540
.يبدو لذيذًا

153
00:08:07,960 --> 00:08:09,420
.تذوّقوا الصّفّ الثّاني الآن

154
00:08:09,420 --> 00:08:13,510
إنّه يضمّ أنواعَ سوشي معدّ من الخضروات
."ويحبّ البعض تسميته "كعك السّوشي

155
00:08:13,840 --> 00:08:15,590
.لم تستعمل أوراق طحالب النّوري في هذا السّوشي

156
00:08:15,590 --> 00:08:18,560
بل استعملتُ شرائح خضروات
.رقيقة للغاية ولففتُ السّوشي بها

157
00:08:18,560 --> 00:08:21,770
.هذا البينتو لا يتحمّل الألوان الدّاكنة والثّقيلة

158
00:08:22,140 --> 00:08:24,230
.وأخيرًا، الصّفّ الثّالث

159
00:08:24,520 --> 00:08:26,610
!من الواضح تمامًا أنّه الطّبق الرّئيسيّ

160
00:08:26,940 --> 00:08:29,690
.إنّه سوشي شرائح لحم بقريّ معتّق

161
00:08:32,400 --> 00:08:34,450
!ها هي ذي موجة أخرى

162
00:08:34,450 --> 00:08:38,910
...نكهتا الأومامي تنتشران في الفم بأكمله

163
00:08:39,240 --> 00:08:43,000
أستطيع أن أرى مصدر حمض الإينوزينيك
،بما أنّ هنالك لحمًا في الطّبق

164
00:08:43,000 --> 00:08:44,160
لكن ما هو مصدر حمض الغلوتاميك؟

165
00:08:44,460 --> 00:08:45,540
.الطّماطم

166
00:08:45,870 --> 00:08:46,960
الطّماطم؟

167
00:08:46,960 --> 00:08:48,540
.أنا لا أراها في أيّ مكان

168
00:08:48,540 --> 00:08:50,500
.كانت واحدة من مكوّنات كعك السّوشي

169
00:08:51,510 --> 00:08:57,510
استعملتُ جهاز الطّرد المركزيّ لأفصل
."الطّماطم إلى صبغة وألياف و"عصير

170
00:09:02,970 --> 00:09:04,310
!فهمت

171
00:09:04,310 --> 00:09:07,520
يصعب التّصديق أنّ المكوّن الرّئيسيّ
!قد تمّ تقديمه بشكل خفيّ تمامًا

172
00:09:08,730 --> 00:09:10,900
.والآن، العنصر الأخير

173
00:09:11,320 --> 00:09:14,360
ما هذه الكريّات الموضوعة بجانب
سوشي سمك الأُسبور؟

174
00:09:17,910 --> 00:09:19,240
...الكريّات

175
00:09:20,370 --> 00:09:22,330
!عبارة عن مرق مركّز

176
00:09:23,040 --> 00:09:26,370
هذا طبق أرزّ بالشّاي وسمك الأُسبور
!يجتمع ويتشكّل على اللّسان

177
00:09:28,420 --> 00:09:30,920
".ابنة فنّ الطّبخ الجزيئيّ العزيزة"

178
00:09:30,920 --> 00:09:33,300
.إنّ تقنيّاتها توفي لقبها حقّه

179
00:09:33,300 --> 00:09:36,220
لقد استمرّت بإمتاع ضيوفها بطبخها
.من البداية حتّى النّهاية

180
00:09:37,090 --> 00:09:39,550
هذا الرّضى العميق

181
00:09:39,800 --> 00:09:43,520
!وكأنّنا نستمتع بوليمة في مطعم يابانيّ تقليديّ فاخر

182
00:09:45,020 --> 00:09:46,940
من علبة البينتو الصّغيرة هذه

183
00:09:46,940 --> 00:09:48,440
...تتدفّق إلينا

184
00:09:49,190 --> 00:09:51,860
!حكمة فنّ الطّبخ

185
00:09:51,860 --> 00:09:53,150
!لقد كشف عن صدره

186
00:09:53,150 --> 00:09:53,980
!لقد فعلها

187
00:09:53,980 --> 00:09:55,360
!لقد عرّى المدير عن صدره

188
00:09:55,820 --> 00:09:57,530
.أبليتِ حسنًا

189
00:09:59,030 --> 00:10:02,240
.هذه هي قوّة ناكيري أليس الحقيقيّة

190
00:10:02,240 --> 00:10:04,240
كيف يمكن لطاهية كهذه أن تكون في نفس عمرنا؟

191
00:10:04,450 --> 00:10:07,210
حتّى إن قضيتُ حياتي بأكملها
...لأبلغ مستواها، فلن أستطيع

192
00:10:07,710 --> 00:10:11,590
،عندما تلمع عبقريّة شخص ما بشدّة
.فإنّها تترك خلفها ظلاًّ

193
00:10:11,960 --> 00:10:13,300
.هذا هو الثّمن الّذي يجب أن تدفعه

194
00:10:13,710 --> 00:10:15,920
.هذه هي أكاديميّة توتسكي

195
00:10:16,420 --> 00:10:19,300
لا حاجة لي بالضّعفاء الّذين قد يتداعون
.بسبب هذا العرض

196
00:10:19,760 --> 00:10:20,760
.انظروا

197
00:10:23,850 --> 00:10:25,970
!خمسة بينتو، جاهزة

198
00:10:26,810 --> 00:10:30,650
.هنالك على الأقلّ طاهٍ واحد لم يُردع

199
00:10:31,190 --> 00:10:33,860
يوكيهيرا سوما، ما هو طبقك؟

200
00:10:35,780 --> 00:10:36,820
.بينتو النّوري

201
00:10:36,820 --> 00:10:39,490
!ماذا؟

202
00:10:37,780 --> 00:10:38,950
!هل قال بينتو النّوري؟

203
00:10:39,490 --> 00:10:42,530
كيف له أن يطمح لهزيمة ناكيري أليس بذلك؟

204
00:10:52,000 --> 00:10:52,880
!بينتو النّوري؟

205
00:10:52,880 --> 00:10:53,380
ما هذا؟

206
00:10:53,380 --> 00:10:54,710
.قُضي عليه

207
00:10:54,710 --> 00:10:55,670
.يوكيهيرا-كُن

208
00:10:56,170 --> 00:10:56,880
ماذا؟

209
00:10:57,630 --> 00:10:59,260
ما هو بينتو النّوري؟

210
00:10:59,260 --> 00:11:01,640
ماذا؟ لا تعرفينه؟

211
00:11:01,640 --> 00:11:03,890
.سأعدّ لك واحدًا لاحقًا

212
00:11:03,890 --> 00:11:06,310
.لكنّه ليس بينتو النّوري العاديّ

213
00:11:07,270 --> 00:11:09,270
!إنّه بينتو النّوري المطّور بأسلوب يوكيهيرا

214
00:11:10,230 --> 00:11:11,980
!تفضّلوا، بالهناء والشّفاء

215
00:11:13,480 --> 00:11:14,940
.إنّها تسمّى جِرار الغداء

216
00:11:15,320 --> 00:11:20,400
إنّها مصنوعة من الفولاذ المقاوم للصّدأ
.وتستطيع الحفاظ على حرارة الأرزّ والحساء

217
00:11:21,320 --> 00:11:23,910
.علب البينتو اليابانيّة متطوّرة كما أرى

218
00:11:24,120 --> 00:11:27,990
يمكن لنماذج أحدث أن تحافظ على
.حرارة محتوياتها طوال نصف يوم

219
00:11:27,990 --> 00:11:30,410
إن قمنا بتسخين الحساء
،قبل أن نضعه في الجرّة

220
00:11:30,410 --> 00:11:32,540
.فإنّه سيحافظ بشكل ممتاز على دفء الأرزّ

221
00:11:32,540 --> 00:11:34,290
!هذا عمل ذكيّ

222
00:11:34,290 --> 00:11:36,130
أين هو التّوتّر؟

223
00:11:36,130 --> 00:11:38,050
.إنّ المباراة لم تنتهي بعد

224
00:11:38,050 --> 00:11:40,800
.إنّها تتصرّف بتعالٍ تجاه يوكيهيرا

225
00:11:41,130 --> 00:11:45,100
.ابتسامتها تلك تؤكّد أنّها واثقة من فوزها

226
00:11:46,470 --> 00:11:49,680
.أوّلاً، هنالك ثلاثة أطباق جانبيّة

227
00:11:52,100 --> 00:11:55,810
!كعكة السّمك المقليّة مع النّوري هذه مذهلة

228
00:11:55,810 --> 00:11:59,690
.لقد أعددتُ كعكة السّمك من الصّفر

229
00:11:59,690 --> 00:12:02,070
.لقد استعمل الجعّة في الخليط

230
00:12:02,070 --> 00:12:04,820
،الكحول يتبخّر بشكل أسرع من الخليط

231
00:12:04,820 --> 00:12:06,780
.لذلك أصبحت خفيفة ومقرمشة

232
00:12:06,780 --> 00:12:07,530
ماذا؟

233
00:12:07,530 --> 00:12:08,830
كيف تعرفين ما قام به يا ريوكو؟

234
00:12:09,290 --> 00:12:13,250
رأيتُ يوكيهيرا-كُن يجرّب أطباقه
،في المسكن ليلة أمس

235
00:12:13,250 --> 00:12:15,170
.لذلك طلبتُ أن أتذوّقها

236
00:12:17,380 --> 00:12:19,710
!الكثير من الأومامي يتدفّق في فمي

237
00:12:19,710 --> 00:12:21,260
!أستطيع شمّ رائحة البحر

238
00:12:22,380 --> 00:12:24,380
.سوف أضمّك

239
00:12:24,380 --> 00:12:26,090
مـ-من أنت؟

240
00:12:29,350 --> 00:12:32,520
نبات الأرقطيون المقليّ على طريقة الكينبيرا
.يملك نكهة عميقة وناعمة أيضًا

241
00:12:32,730 --> 00:12:37,060
لقد أضفتُ القليل من المايونيز
.وخلّ البلسميك كمكوّنات سرّيّة

242
00:12:37,060 --> 00:12:38,110
.فهمت

243
00:12:38,110 --> 00:12:40,730
.لقد كنتَ دقيقًا للغاية مع هذ الطّبق

244
00:12:41,940 --> 00:12:44,700
انظروا إلى مدى سهولة تقطيع
.سمك القدّ المقليّ بعيدان الأكل

245
00:12:45,030 --> 00:12:49,740
لا بدّ أنّ سمك القدّ قد طُبخ في مرق
.وتُبّل قبل أن يتمّ قليُه

246
00:12:49,740 --> 00:12:53,120
.منحته هذه الخطوة قوامًا ناعمًا وهشًّا

247
00:12:54,500 --> 00:12:55,960
!ماذا؟

248
00:13:01,050 --> 00:13:04,130
!يا لها من نكهة نقيّة ومعتدلة

249
00:13:04,130 --> 00:13:07,430
!إنّها أشبه بنسيم عليل في المرتفعات

250
00:13:07,840 --> 00:13:10,260
!يا لها من نكهة مصقولة

251
00:13:10,260 --> 00:13:11,560
!ما مصدر هذا؟

252
00:13:11,930 --> 00:13:14,730
.يمكن العثور على الإجابة عن سؤالك في المرق

253
00:13:15,100 --> 00:13:18,480
.هذا مرق سمك التّونة المجفّف

254
00:13:18,480 --> 00:13:19,900
.هذا صحيح

255
00:13:19,900 --> 00:13:23,740
طبختُ سمك القدّ في مرق معدّ من سمك
.التّونة المجفّف وعشب الرّيشيري البحريّ

256
00:13:24,030 --> 00:13:25,650
...تونة مجفّفة

257
00:13:25,650 --> 00:13:28,700
.لا بدّ أنّه أعدّه من سمك التّونة أصفر الزّعنفة

258
00:13:28,700 --> 00:13:29,740
.نعم

259
00:13:29,740 --> 00:13:35,040
رغم أنّه ليس غنيًّا كمرق سمك البونيتو، إلاّ أنّه
.يمتلك نكهة أومامي حسّاسة وراقية للغاية

260
00:13:35,250 --> 00:13:39,960
،يمتلك سمك القدّ نكهة أومامي خفيفة أيضًا
.لذلك فإنّ التّونة المجفّفة هي خيارة ممتاز

261
00:13:39,960 --> 00:13:42,420
!يا له من طبق خفيف

262
00:13:42,670 --> 00:13:44,380
!حان دور الحساء الآن

263
00:13:45,550 --> 00:13:48,260
!إنّه حساء اللّحم المقدّد وميسو البصل

264
00:13:51,050 --> 00:13:52,140
...وهذا أيضًا

265
00:13:54,680 --> 00:13:58,390
.يملأ العبير المميّز لمرق التّونة أنوفنا

266
00:13:59,060 --> 00:14:01,770
،وإلى جانب البصل بحلاوته الذّائبة

267
00:14:01,770 --> 00:14:04,730
.يصبح الحساء وكأنّه يغلّف الجسد بأكمله

268
00:14:05,400 --> 00:14:09,860
هنالك أيضًا حيلة قمت فيها
.باستغلال علبة البينتو هذه

269
00:14:09,860 --> 00:14:14,450
فقط عن طريق إضافة المرق
،والمكوّنات والتّوابل في الحاوية

270
00:14:14,450 --> 00:14:17,210
تمكّنتُ من الحصول على حساء
.حلو بعد بضع ساعات

271
00:14:17,210 --> 00:14:18,500
.ستُطبخ الخضروات في ذلك الوقت

272
00:14:18,750 --> 00:14:20,960
.هذا مفيد

273
00:14:21,460 --> 00:14:24,250
،لن يكون هنالك أيّ وقت إضافيّ اليوم
.لذلك طبختُ المكوّنات سلفًا

274
00:14:24,250 --> 00:14:27,760
.أنت تعرف الكثير عن البينتو

275
00:14:27,760 --> 00:14:31,090
.أكيد. لقد كنتُ أعدّها في مطعم عائلتي

276
00:14:31,760 --> 00:14:33,760
.لكنّ ذلك ليس كافيًا يا يوكيهيرا-كُن

277
00:14:34,510 --> 00:14:36,470
.إنّ مجهوداتك تقليديّة بشكل واضح

278
00:14:36,470 --> 00:14:40,230
حتّى البينتو يجب أن يكون مليئًا
.بالمفاجآت المدهشة

279
00:14:40,600 --> 00:14:43,230
.تمامًا كما هو حال بينتو التّيماري الّذي أعددتُه

280
00:14:43,230 --> 00:14:46,990
.إنّه يبدو لذيذًا بالفعل

281
00:14:46,990 --> 00:14:48,700
.دعيني أجرّبه في وقت لاحق

282
00:14:49,740 --> 00:14:50,820
.أجل، بكلّ تأكيد

283
00:14:51,360 --> 00:14:56,660
لكن هل كان طبقك رائعًا بالفعل كبينتو؟

284
00:14:57,250 --> 00:14:58,500
ما الّذي قلتَه؟

285
00:14:59,000 --> 00:15:03,000
لقد سألتك ماذا يجب علينا
.أن نضع في علب البينتو

286
00:15:05,130 --> 00:15:08,670
إحدى زبائن مطعمنا الدّائمين
.هي عجوز تدعى كيو-سان

287
00:15:09,220 --> 00:15:11,630
،كانت تأتي كلّ يوم تقريبًا

288
00:15:11,630 --> 00:15:14,470
لكن في أحد الأيّام، تأذّى ظهرها
.ولم تستطع المجيء

289
00:15:15,970 --> 00:15:17,220
مرحبًا؟

290
00:15:18,060 --> 00:15:19,310
!أيّتها الجدّة كيو

291
00:15:19,310 --> 00:15:20,810
!هل ظهرك على ما يرام؟

292
00:15:20,810 --> 00:15:24,230
سوما-تشان، أليس مطعمكم
مشغول في هذا الوقت؟

293
00:15:24,230 --> 00:15:25,730
...هذا مؤلم

294
00:15:26,230 --> 00:15:27,190
!تفضّلي

295
00:15:27,570 --> 00:15:28,280
ماذا؟

296
00:15:28,280 --> 00:15:29,900
لم تتعشّي اليوم بعد، صحيح؟

297
00:15:29,900 --> 00:15:30,570
!إلى اللّقاء

298
00:15:31,070 --> 00:15:33,030
أتيتَ إلى هنا فقط لتوصل لي هذه؟

299
00:15:34,120 --> 00:15:36,490
،كان المطعم فارغًا

300
00:15:36,490 --> 00:15:37,700
.لذلك أعددتُ هذا من أجلك

301
00:15:37,700 --> 00:15:39,700
!كليه واستعيدي عافيتك

302
00:15:40,580 --> 00:15:45,710
!ملاحظة: أزيلي النّوري قبل أن تأكلي الأرزّ

303
00:15:50,210 --> 00:15:53,380
يجب على المرء أن يتذوّق ما كنتُ أحاول إيصاله

304
00:15:55,390 --> 00:15:57,180
.من خلال علبة البينتو ذلك اليوم

305
00:15:58,140 --> 00:16:01,560
!النّكهات وما يوجد خلفها

306
00:16:01,560 --> 00:16:02,730
ماذا؟

307
00:16:03,390 --> 00:16:05,440
ما هذا الأرز؟

308
00:16:05,440 --> 00:16:07,230
...هل... هذا

309
00:16:07,650 --> 00:16:09,440
!بينتو النّوري بالفعل؟

310
00:16:11,570 --> 00:16:15,530
.هنالك حُبيبات سوداء غريبة فوق الأرزّ

311
00:16:15,820 --> 00:16:16,740
ما هو ذلك؟

312
00:16:16,740 --> 00:16:17,370
كافيار؟

313
00:16:17,370 --> 00:16:18,080
بطارخ سمك؟

314
00:16:18,080 --> 00:16:19,120
.إنّها سوداء

315
00:16:19,620 --> 00:16:21,540
!هذا مثير للفضول

316
00:16:21,540 --> 00:16:23,370
.ومع ذلك عليّ تذوّقه

317
00:16:23,370 --> 00:16:24,750
!تمنّوا لي الحظّ

318
00:16:27,500 --> 00:16:31,420
!أشعر وكأنّ بطارخ السّلمون تتدفّق في فمي

319
00:16:31,420 --> 00:16:36,090
!ما ينطلق من داخلها هو أومامي النّوري

320
00:16:38,510 --> 00:16:43,140
طيبة أومامي النّوري المالح تتدفّق
.لتغطّي كلّ حبّة أرزّ

321
00:16:43,140 --> 00:16:44,600
!لا أستطيع تحمّل هذا

322
00:16:44,600 --> 00:16:46,650
!إنّه يبعث على الإدمان

323
00:16:46,850 --> 00:16:49,270
أعددتَ تلك الكريّات عن طريق
استخراج أومامي النّوري

324
00:16:49,270 --> 00:16:53,900
.وإضافة ألجينات الصّوديوم وكلوريد البوتاسيوم

325
00:16:53,900 --> 00:16:55,740
!هذا طبخ جزيئيّ

326
00:16:55,740 --> 00:16:56,660
...لكنّ ذلك

327
00:16:56,660 --> 00:16:58,410
!هو اختصاص ناكيري أليس

328
00:16:58,740 --> 00:17:01,040
كيف تعرف هذه التّقنيّة؟

329
00:17:01,040 --> 00:17:06,710
دعاني إيشّيكي-سينباي في أحد الأيّام
.لأساعد في فصل تعليم الطّبخ للأطفال

330
00:17:06,960 --> 00:17:07,420
ماذا؟

331
00:17:07,750 --> 00:17:10,170
.لقد أصبحتُ صديقًا للأطفال

332
00:17:10,170 --> 00:17:13,090
.وفي النّهاية، أعطوني حلويّات ووجبات خفيفة

333
00:17:13,090 --> 00:17:15,680
...إحدى هذه الحلويّات ذكّرتني بشيء ما

334
00:17:16,680 --> 00:17:19,430
.لقد جرّبتُ واحدة من هذه وأنا صغير

335
00:17:19,430 --> 00:17:20,600
ماذا؟

336
00:17:20,600 --> 00:17:21,600
!منتوج حلويّات رخيص؟

337
00:17:21,850 --> 00:17:23,810
ما هذه الحلويّات؟

338
00:17:24,180 --> 00:17:27,190
.هذه واحدة من الحلويّات التّعليميّة

339
00:17:27,770 --> 00:17:30,310
...كلوريد البوتاسيوم وألجينات الصّوديوم

340
00:17:30,570 --> 00:17:33,690
.إنّها حلويّات تعلّمنا كيف نعدّ بطارخ سمك اصطناعيّة

341
00:17:33,690 --> 00:17:35,610
.كنت أحبّها كثيرًا وأنا صغير

342
00:17:35,610 --> 00:17:37,240
.لقد لعبتُ كثيرًا بها

343
00:17:37,240 --> 00:17:38,530
!انظر يا أبي

344
00:17:38,530 --> 00:17:39,740
!لقد جعلتُ حساء الميزو يجمد

345
00:17:39,740 --> 00:17:41,990
.هذا ممتع

346
00:17:41,990 --> 00:17:44,250
.لكن إيّاك أن تقدّم ذلك في مطعمنا

347
00:17:44,250 --> 00:17:48,210
هذه الكريّات السّوداء هي قنابل أومامي النّوري

348
00:17:48,210 --> 00:17:50,290
.الّتي أعددتُها من النّوري المتبّل

349
00:17:51,960 --> 00:17:55,420
لقد فكّر في تقنيّة طّبخٍ جزيئيّ
من منتوج حلويّات رخيص؟

350
00:17:56,420 --> 00:17:58,470
...هنالك شيء آخر في الأرزّ

351
00:18:00,800 --> 00:18:02,930
!ما كلّ هذه النّكهة؟

352
00:18:02,930 --> 00:18:05,100
!إنّها تونة مجفّفة مطبوخة في صلصة الصّويا

353
00:18:05,100 --> 00:18:07,850
!لقد كان طبقًا من أربعة مستويات

354
00:18:08,520 --> 00:18:13,570
إن كان طبق ناكيري أليس عبارة عن
،صندوق مجوهرات مرتّب بشكل دقيق

355
00:18:13,980 --> 00:18:19,360
فبينتو النّوري هذا هو صندوق كنز
!مليء بالعجائب الّتي تنتظرنا لنكتشفها

356
00:18:19,780 --> 00:18:22,740
إنّه يذكّرني برحلاتي الميدانيّة
...والنّزهات وأنا طفل صغير

357
00:18:22,740 --> 00:18:26,540
...تلك الحماسة عندما أفتح علبة البينتو

358
00:18:26,540 --> 00:18:29,330
!إنّي أتذكّر كلّ ذلك الآن

359
00:18:29,330 --> 00:18:33,670
بينتو التّيماري الّذي أعددتُه يضمّ طبقًا
!أخيرًا وهو الأرزّ بالشّاي مع سمك الأُسبور

360
00:18:33,670 --> 00:18:36,340
—جودة المذاق الإجماليّة كانت أعلى في طبقي

361
00:18:36,340 --> 00:18:37,630
!توقّفوا رجاءً

362
00:18:37,630 --> 00:18:40,640
أيمكنكم ترك حوالي ثلثٍ واحد من الأرزّ؟

363
00:18:40,890 --> 00:18:44,890
لا زال هنالك طبقة أخرى
.في الجرّة تحت الغطاء الأوّل

364
00:18:45,890 --> 00:18:47,140
!إنّها صلصة كودزو

365
00:18:47,430 --> 00:18:52,560
تضمّ صلصة كودزو تلك، ثلاثة أضعاف الكمّيّة
!العاديّة من التّونة المجفّفة وعشب الرّيشيكي

366
00:18:52,900 --> 00:18:55,940
.اسكبوها علي الأرزّ السّاخن وتذوّقوه

367
00:18:56,360 --> 00:18:57,900
.هذه هي الضّربة القاضية

368
00:18:58,150 --> 00:18:59,490
...هذا بالطّبع

369
00:18:59,490 --> 00:19:01,660
...سوف يكون

370
00:19:01,950 --> 00:19:04,080
!لذيذًا

371
00:19:04,280 --> 00:19:06,290
!آهٍ على صلصة كودزو

372
00:19:06,290 --> 00:19:08,040
!إنّها في غاية الرّوعة

373
00:19:08,330 --> 00:19:10,330
...إذا أضفنا قنابل النّوري

374
00:19:10,330 --> 00:19:12,670
!فسنحصل على نكهة من نوع جديد بالكامل

375
00:19:12,960 --> 00:19:15,170
...هؤلاء الحكّام

376
00:19:15,170 --> 00:19:17,550
،إنّهم يأكلون ويستمتعون بوقتهم

377
00:19:17,840 --> 00:19:20,470
.على عكس حالهم وهم يأكلون طبق ناكيري أليس

378
00:19:21,340 --> 00:19:22,340
.يوكيهيرا-كُن

379
00:19:22,800 --> 00:19:26,850
هل تحاول أن تثبت أنّ على البينتو
أن يمتلك "قلبًا" أو ما شابه؟

380
00:19:26,850 --> 00:19:29,640
المهمّ هنا هو النّكهة، أليس كذلك؟

381
00:19:29,640 --> 00:19:31,060
"إيّاك أن تفكّر أنّ "العقل يغلب الواقع
—سيُجدي معي

382
00:19:31,060 --> 00:19:31,770
!كلاّ

383
00:19:32,150 --> 00:19:35,310
.لا يتعلّق الأمر بذلك يا أليس

384
00:19:35,310 --> 00:19:36,150
.جدّي

385
00:19:37,280 --> 00:19:38,900
!متى كشف عن صدره؟

386
00:19:39,150 --> 00:19:44,200
.يا أليس، البينتو الّذي أعددتِه اعتمد على البرودة

387
00:19:44,200 --> 00:19:47,120
.أكيد، لأنّ البينتو يجب أن يكون باردًا

388
00:19:47,120 --> 00:19:51,830
.لم يحبس يوكيهيرا سوما نفسه في ذلك المجال

389
00:19:53,000 --> 00:19:56,420
،لقد فكّر في البداية بحاوية البينتو

390
00:19:56,420 --> 00:20:00,840
.ثمّ ملأها بالمتعة الّتي تعزّزتْ نكهتُها بالدّفء

391
00:20:01,220 --> 00:20:03,510
.ذلك ما يجب عليه أن يكون البينتو

392
00:20:04,180 --> 00:20:07,560
.بالطّبع كان طبقك لذيذًا للغاية

393
00:20:07,560 --> 00:20:10,890
لكن ألم يكن من الممكن أيضًا تقديم نفس الطّبق

394
00:20:10,890 --> 00:20:12,890
في منافسة موضوعها هو السّوشي؟

395
00:20:13,980 --> 00:20:18,190
.لقد استعملتِ مهاراتك لملء العلبة فحسب

396
00:20:18,520 --> 00:20:21,490
هنالك نكهات يمكنها أن تتواصل معنا
.عن طريق البينتو وحده

397
00:20:22,150 --> 00:20:24,990
هنالك تقنيّات خلاّقة يمكن أن نقوم
.بها لتطوير ثقافة البينتو

398
00:20:25,450 --> 00:20:27,950
.يمكن للبينتو أن يكون ممتعًا ومبتَكرًا بطريقته الخاصّة

399
00:20:28,700 --> 00:20:31,830
هل أحاط طبقك بكلّ هذا؟

400
00:20:31,830 --> 00:20:35,120
.لكن بكلّ تأكيد... ما يهمّ هو النّكهة

401
00:20:35,120 --> 00:20:37,040
.أنا لا أعارضك من هذه النّاحية

402
00:20:37,750 --> 00:20:40,210
!بالهناء والشّفاء يا ناكيري أليس

403
00:20:52,770 --> 00:20:55,520
.أليس-ساما، تبدين في أبهى حلّة

404
00:20:55,520 --> 00:20:57,310
كيف هي إرينا-ساما؟

405
00:20:57,310 --> 00:20:59,570
.أبلغي سلامنا إلى إرينا-ساما رجاءً

406
00:20:59,570 --> 00:21:01,650
.إرينا-ساما

407
00:21:00,270 --> 00:21:02,150
!إرينا-ساما

408
00:21:02,150 --> 00:21:03,280
...إرينا-ساما

409
00:21:03,900 --> 00:21:08,660
يا والدي، أرغب بالذّهاب إلى مختبر
.أبحاثك في اسكندنافيا

410
00:21:08,660 --> 00:21:11,490
!خذني إلى هناك أرجوك

411
00:21:12,540 --> 00:21:14,580
...التّقنيّات الحديثة... الأكثر تقدّمًا

412
00:21:15,000 --> 00:21:18,330
عليّ أن أمتلك أسلحة تكون لي وحدي
...لكي لا أخسر أمام إرينا

413
00:21:19,340 --> 00:21:21,670
...لا يجب أن أخسر أمام أيّ أحد

414
00:21:22,090 --> 00:21:24,420
...قبل أن أفوز على إرينا، ومع ذلك

415
00:21:31,060 --> 00:21:32,350
!أحضروا لي الفرشاة

416
00:21:54,410 --> 00:21:56,120
...إنّه دافئ

417
00:21:59,380 --> 00:22:01,500
!المباراة الأولى في الجولة الأولى

418
00:22:01,500 --> 00:22:02,800
...المنتصر

419
00:22:04,260 --> 00:22:06,510
!هو يوكيهيرا سوما

420
00:22:07,300 --> 00:22:08,340
!سعيد لأنّ طبخي أعجبكم

421
00:22:08,340 --> 00:22:09,840
!لقد فاز

422
00:22:09,220 --> 00:22:10,800
!مرحى

423
00:22:13,760 --> 00:22:14,600
!يوكيهيرا

424
00:22:14,600 --> 00:22:15,930
...الآنسة أليس

425
00:22:17,770 --> 00:22:22,060
.يوكيهيرا، أنت مثير للاهتمام بالفعل

426
00:23:53,450 --> 00:23:54,490
.سوما-كُن

427
00:23:54,490 --> 00:23:55,450
!هذا مذهل

428
00:23:55,450 --> 00:23:56,660
!أنت رائع

429
00:23:59,750 --> 00:24:01,620
.حا-حاضرة

430
00:24:02,850 --> 00:24:05,460
...إنّه دوري الآن

431
00:24:15,140 --> 00:24:18,600
:في الحلقة القادمة
."تفاعل النّور والظّلّ"