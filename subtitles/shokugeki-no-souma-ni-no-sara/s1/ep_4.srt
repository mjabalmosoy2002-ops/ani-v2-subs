1
00:00:03,390 --> 00:00:05,690
بشأن المباراة الرّابعة في انتخابات الخريف

2
00:00:05,690 --> 00:00:10,070
بين المتنافس تاكومي ألديني
،والمتنافس ميماساكا سوبارو

3
00:00:10,070 --> 00:00:12,530
.فستكون عبارة عن شوكوغيكي

4
00:00:16,010 --> 00:00:18,670
!تحدّي شوكوغيكي خلال انتخابات الخريف؟

5
00:00:18,670 --> 00:00:20,200
أمسموح بهذا أصلاً؟

6
00:00:21,040 --> 00:00:23,210
.لا يوجد أدنى شكّ في أنّ الشّروط قد تحقّقت

7
00:00:23,610 --> 00:00:28,470
!أعلنت الإدارة أنّ ما نحن بصدده هو شوكوغيكي رسميّ

8
00:00:28,470 --> 00:00:29,090
.أجل

9
00:00:29,670 --> 00:00:31,090
...لا تعرف أيّ قيودٍ للمكان والزّمان

10
00:00:31,460 --> 00:00:33,380
!هذه هي طبيعة الشّوكوغيكي

11
00:00:33,590 --> 00:00:38,350
حتّى الآن، قام خمسة حكّام باتّخاذ قرار
،مشترك بشأن نتائج هذه المنافسات

12
00:00:38,350 --> 00:00:41,430
،لكن سيكون هنالك استثناء في هذه المباراة
.بحيث سيقدّم كلّ حكم صوتًا واحدًا

13
00:00:41,820 --> 00:00:45,140
.وبذلك ستأخذ المباراة شكل تحدّي شوكوغيكي

14
00:00:45,140 --> 00:00:45,930
.شوكوغيكي

15
00:00:45,930 --> 00:00:48,860
!سيدخل المتنافسان للحلبة الآن

16
00:00:46,390 --> 00:00:46,850
.مذهل

17
00:00:53,040 --> 00:00:53,940
...ني-تشان

18
00:00:55,880 --> 00:00:59,700
.لا بدّ أنّ امتلاك أخ غير كفء أمر صعب

19
00:01:01,530 --> 00:01:02,420
.التقطه

20
00:01:02,910 --> 00:01:04,040
ماذا؟

21
00:01:04,040 --> 00:01:06,870
سأعلّمك كيف تتصرّف بشكل لائق
.بما أنّك تفتقر لذلك

22
00:01:07,240 --> 00:01:11,140
.إذا التقطتَه، فسيعني ذلك أنّك قبلت التّحدّي

23
00:01:11,130 --> 00:01:14,920
."هكذا نقوم بـ"النّزالات

24
00:01:15,440 --> 00:01:18,400
يسعى الإيطاليّون إلى الانتقام
.دائمًا بعد التّعرّض للإذلال

25
00:01:18,970 --> 00:01:21,760
إن فزت أنا، فسأجعلك تنحني وتعتذر ها هنا

26
00:01:21,760 --> 00:01:24,060
،لسكّين الميتزالوتا الّتي دنّستَها

27
00:01:24,060 --> 00:01:26,520
!وإلى أخي أيضًا

28
00:03:02,820 --> 00:03:03,530
!ماذا؟

29
00:03:03,530 --> 00:03:04,580
!يوكيهيرا

30
00:03:04,580 --> 00:03:05,700
!ميغومي

31
00:03:05,700 --> 00:03:07,450
!يا إلهي، أين كنتما؟

32
00:03:07,830 --> 00:03:13,040
حـ-حسنًا، كنّا برفقة تاكومي-كُن
،وميماساكا-كُن قبل فترة وجيزة

33
00:03:13,040 --> 00:03:16,710
.لكنّهما لم يقولا أيّ شيء عن الشّوكوغيكي

34
00:03:16,710 --> 00:03:21,130
كان ميماساكا ينوي جعل هذه المباراة
.تحدّيَ شوكوغيكي منذ البداية

35
00:03:21,880 --> 00:03:23,890
.إنّه من هذا النّوع من الأشخاص

36
00:03:24,470 --> 00:03:26,260
إنّه يقوم ببحث شامل ومفصّل
،عن التّلاميذ الّذين يستهدفهم

37
00:03:26,260 --> 00:03:31,940
،ثمّ يستعمل أيّ وسيلة ضروريّة لإغضابهم وتهديدهم

38
00:03:31,940 --> 00:03:33,900
.ويجرّهم إلى المواجهة

39
00:03:33,900 --> 00:03:38,650
.لقد فاز سلفًا بتسعة وتسعين تحدّي شوكوغيكي

40
00:03:38,650 --> 00:03:40,360
...تسعة وتسعون

41
00:03:40,940 --> 00:03:42,780
!الموضوع هو طبق تحلية

42
00:03:44,030 --> 00:03:46,990
!ليبدأ الطّبخ

43
00:03:50,330 --> 00:03:52,160
...مكوّناتهما

44
00:03:52,160 --> 00:03:54,170
!إنّ لهما نفس المكوّنات بالضّبط

45
00:03:54,460 --> 00:03:58,880
أحضرتُ وثائق عن المكوّنات الّتي استعملها
.ميماساكا سوبارو في تحدّياته السّابقة

46
00:03:58,880 --> 00:04:01,510
.إنّها توضّح مكوّنات استُعملت من كِلا الطّرفين

47
00:04:03,220 --> 00:04:05,300
!ماذا؟

48
00:04:05,720 --> 00:04:09,180
!إنّه يفوز دائمًا رغم تقديمه لنفس طبق خصمه

49
00:04:10,970 --> 00:04:12,480
.سيميفريدّو

50
00:04:13,600 --> 00:04:16,480
.هذا ما سنُعدّه أنا وأنت اليوم

51
00:04:18,520 --> 00:04:22,320
،إنّ سيميفريدّو بارد بنفس برودة البوظة

52
00:04:22,320 --> 00:04:25,450
.وناعم بنفس نعومة ملمس الكعكة

53
00:04:25,450 --> 00:04:29,660
سيكون لهذا السّيميفريدّو طبقة
،تتكوّن من حلوى المكسّرات

54
00:04:29,660 --> 00:04:32,960
،وطبقة بوظة مع الميرانغ والقشدة الكثيفة

55
00:04:32,960 --> 00:04:36,880
،وطبقة من الكعك الاسفنجيّ
.أي سيتكوّن من ثلاث طبقات

56
00:04:37,750 --> 00:04:39,090
هل أخطأتُ في شيء؟

57
00:04:40,050 --> 00:04:42,340
.إذًا هذا ما عرفتَه عن طريق مطاردتك لي

58
00:04:43,380 --> 00:04:45,550
أتعتقد أنّ بإمكانك الفوز إن كانت
لديك نفس الوصفة؟

59
00:04:47,010 --> 00:04:49,720
!لا تستخفّ أبدًا بأحد أفراد عائلة ألديني

60
00:04:50,890 --> 00:04:55,440
.يلهو ميماساكا بنظام الشّوكوغيكي كلعبة له

61
00:04:56,230 --> 00:05:00,480
إنّه يرغم خصومه دائمًا على المراهنة
.بأهمّ شيء عند الطّاهي، أدواته

62
00:05:00,480 --> 00:05:04,820
.ثمّ يمحو كرامتهم عن طريق سلبهم إيّاها

63
00:05:05,200 --> 00:05:07,860
أيظنّ نفسه المحارب موساشيبو بينكي؟

64
00:05:07,860 --> 00:05:09,450
.يا لذوقه الضّعيف

65
00:05:09,450 --> 00:05:13,040
قيل مرّة أنّه أخذ سكّينًا عزيزة على أحدهم

66
00:05:13,040 --> 00:05:15,410
،كانت تعود لأمّه المتوفّاة

67
00:05:15,410 --> 00:05:18,330
.وفعل ذلك بينما كان يضحك بشكل جنونيّ

68
00:05:18,330 --> 00:05:23,590
هذا يعني أنّ تاكومي-كُن قد وضع
...سكّين ميتزالونا على المحكّ

69
00:05:25,010 --> 00:05:27,260
!لا-لا يوجد ما نقلق عليه

70
00:05:27,260 --> 00:05:28,640
.انظروا إليه فحسب

71
00:05:28,970 --> 00:05:30,510
!إنّه لا يُظهر أيّ تردّد

72
00:05:30,510 --> 00:05:32,470
!أجل، حركاته دقيقة للغاية

73
00:05:33,060 --> 00:05:37,690
إن فشل في احترام المقادير بأيّ شكل أثناء
.تحضير طبق التّحلية، فسيفسد المذاق

74
00:05:37,690 --> 00:05:40,360
.لهذا السّبب يحتاج المرء لانتباه كبير للتّفاصيل

75
00:05:40,360 --> 00:05:42,650
—وفحلٌ مثل ميماساكا ما كان لـ

76
00:05:43,690 --> 00:05:44,320
!ماذا؟

77
00:05:45,570 --> 00:05:48,280
.إ-إنّه دقيق للغاية في حركاته

78
00:05:48,280 --> 00:05:51,070
...إنّه يكاد يشبه

79
00:05:51,070 --> 00:05:53,370
!فتاة تقوم بالتّطريز

80
00:05:56,040 --> 00:05:58,580
.مع السّلامة يا ألديني

81
00:05:58,580 --> 00:06:01,170
!هذه هي مرحلة إضافة التّعديلات

82
00:06:03,380 --> 00:06:07,420
،يخفق تاكومي-كُن صفار وبياض البيض معًا

83
00:06:07,800 --> 00:06:11,930
بينما يخفقهما ميماساكا-كُن بشكل
.منفصل عندما يعدّ الخليط

84
00:06:12,800 --> 00:06:15,930
.يُجري ميماساكا سوبارو تحقيقًا مفصّلاً عن خصومه

85
00:06:16,480 --> 00:06:20,270
إنّه يجمل كلّ وأيّ معلومة عن الأطباق الّتي يجرّبوها

86
00:06:20,270 --> 00:06:22,560
.ليتوقّع ما الّذي يحاول خصمه إعداده

87
00:06:22,560 --> 00:06:28,030
ثمّ يقوم بتعديل نسخته الخاصّة
.من الطّبق ليتقدّم عن خصمه بخطوة

88
00:06:28,030 --> 00:06:31,110
كعكة عجينة الجينواز معدّة عن طريق
،خفق صفار وبياض البيض معًا

89
00:06:31,110 --> 00:06:33,870
.لديها قوام رطب ورقيق

90
00:06:33,870 --> 00:06:36,870
ومن جهة أخرى، فإنّ كعكة عجينة البسكويت
،المعدّة عن طريق خفقهما بشكل منفصل

91
00:06:36,870 --> 00:06:38,960
،لديها قوام مليء بالهواء

92
00:06:38,960 --> 00:06:42,040
،لذلك ستمتصّ الكثير من الشّراب
.وستُعطينا ملمسًا ممتازًا

93
00:06:42,040 --> 00:06:47,380
ستكون نسختي قادرة على زيادة منافع
.هذا الشّراب المقدّس

94
00:06:47,880 --> 00:06:51,180
.لقد اخترتَ بُنية سلسة وناعمة

95
00:06:51,180 --> 00:06:54,220
هذا هو الخيار الّذي اتّخذتَه دائمًا
.مذ أن كنتَ في إيطاليا

96
00:06:54,640 --> 00:07:00,190
،لكن عندما يتمّ مقارنة هاتين الكعكتين
.ستكون لكعكتي نكهة أقوى

97
00:07:00,560 --> 00:07:03,650
إذًا، فعن طريق القيام بتعديل
،في مرحلة بها خيارات أخرى

98
00:07:03,650 --> 00:07:07,650
تمكّن من تقليل احتمال خسارته
.إلى أن جعله يدنو من الصّفر

99
00:07:07,650 --> 00:07:11,110
ستقوم بإعداد الشّراب الآن، صحيح؟

100
00:07:11,110 --> 00:07:12,820
بهذا الخمر المقطّر؟

101
00:07:13,820 --> 00:07:15,280
!إنّه يملك خمر ليمونتشيلّو المقطّر أيضًا

102
00:07:16,240 --> 00:07:19,250
.إنّه خمر إيطاليّ مقطّر مُعدّ من اللّيمون

103
00:07:19,660 --> 00:07:24,460
خمر الرّم وخمر الأماريتّو هما المستعملان
،في العادة لإعداد الشّراب

104
00:07:24,460 --> 00:07:26,840
.لكنّه يستعمل نفس المكوّن حتّى في هذه المرحلة

105
00:07:26,840 --> 00:07:30,420
.إنّه يعلم بشأن باناكوتّا اللّيمونتشيلّو أيضًا

106
00:07:30,420 --> 00:07:34,050
،إنّ مطعمكم المسمّى تراتّوريا ألديني

107
00:07:34,050 --> 00:07:37,310
.لديه طبق خاصّ يتمّ استعمال هذا فيه بشكل كبير

108
00:07:37,310 --> 00:07:42,390
.لهذا السّبب توقّعتُ أنّك ستستعمله في السّيميفريدّو

109
00:07:44,230 --> 00:07:46,650
هل يستطيع توقّع خطواتي بالفعل؟

110
00:07:47,230 --> 00:07:49,690
.هنالك تعديلات آخرى أيضًا

111
00:07:49,690 --> 00:07:55,370
سأعدّ الكاسترد باستعمال جبنة الماسكربون
.إضافة إلى القشدة الكثيفة لإغنائه أكثر

112
00:07:55,700 --> 00:07:59,870
إنّه نفس الشّيء الّذي قمتَ به عندما أعددتَ
.الباستا بالكاري في المرحلة التّمهيديّة

113
00:08:00,160 --> 00:08:05,080
ما هو شعور أن يتفوّق عليك شخص
يستعمل مهاراتك الخاصّة؟

114
00:08:05,080 --> 00:08:06,750
!أيّها المدير

115
00:08:06,750 --> 00:08:09,000
هل يمكن السّماح بمباراة كهذه؟

116
00:08:09,000 --> 00:08:12,050
.في الشّوكوغيكي، الطّعام هو كلّ شيء

117
00:08:12,590 --> 00:08:15,890
لا يوجد سبب للاحتجاج
.على ميماساكا سوبارو بسبب تصرّفه

118
00:08:15,890 --> 00:08:19,810
.شُغل ميماساكا سوبارو الشّاغل هو الفوز فحسب

119
00:08:19,810 --> 00:08:22,730
."لذلك السّبب نجده "يدقّق في التّفاصيل

120
00:08:23,100 --> 00:08:26,440
.إنّه يدرس خصومه جيّدًا بهدف أن يصبح مثلهم

121
00:08:26,810 --> 00:08:30,650
.الأشخاص العاطفيّون من أمثالك هم أفضل الخصوم

122
00:08:31,150 --> 00:08:34,110
،قد تبدو هادئًا ورزينًا من الخارج

123
00:08:34,400 --> 00:08:36,990
.لكنّك شغوف بشأن طبخك

124
00:08:36,990 --> 00:08:40,660
،إنّك تحبّ وتفخر ببلادك الأمّ

125
00:08:40,660 --> 00:08:43,120
.وسيظهر ذلك دائمًا في طبخك

126
00:08:43,540 --> 00:08:48,340
.أنا سعيد لأنّك أظهرتَ لي أنّك تمامًا كما توقّعتُك

127
00:08:48,340 --> 00:08:52,550
.إنّه يستمرّ بملاحظ خصمه ويكشف حقيقته

128
00:08:54,010 --> 00:08:57,890
!ميماساكا سوبارو هو ملك المطاردين

129
00:08:59,350 --> 00:09:01,770
!إنّه أكثر خطورة ممّا توقّعت

130
00:09:01,770 --> 00:09:05,270
!يجب على تاكومي أن يقوم بتعديل جديد أيضًا

131
00:09:05,270 --> 00:09:07,650
لكن هل يملك الوقت للقيام بذلك؟

132
00:09:07,650 --> 00:09:09,270
هل سيخسر فحسب؟

133
00:09:09,270 --> 00:09:12,030
إنّ ني-تشان مرن للغاية، لقد تعلّم
.ذلك عن طريق العمل في المطبخ

134
00:09:12,480 --> 00:09:15,030
!ما كان إيطاليّ أن يخسر أبدًا في تحدّي طبق تحلية

135
00:09:15,740 --> 00:09:19,450
...إنّه يعرف وصفتي الأصليّة بالكامل

136
00:09:19,450 --> 00:09:20,620
ما العمل؟

137
00:09:20,620 --> 00:09:22,830
هل أعدّ شيئًا جديدًا من البداية؟

138
00:09:22,830 --> 00:09:24,790
.كلاّ، ليس لديّ الوقت لذلك

139
00:09:24,790 --> 00:09:26,210
هل هنالك ما يمكنني فعله؟

140
00:09:26,210 --> 00:09:27,420
أهنالك أيّ شيء يمكنني فعله؟

141
00:09:29,540 --> 00:09:30,960
،بمجرّد أن أضع الخليط في الفرن

142
00:09:30,960 --> 00:09:32,960
.لن أستطيع القيام بأيّ تعديلات عليه

143
00:09:32,960 --> 00:09:36,260
هل عليّ إضافة ليمون مقطّع لتحسين الرّائحة؟

144
00:09:36,680 --> 00:09:39,840
.كلاّ، سوف يفسد ذلك الملمس الضّروريّ

145
00:09:40,300 --> 00:09:44,930
أنت هناك، أليس عليك أن تضعه في الفرن
إذا كنتَ تريد أن تكمل في الوقت؟

146
00:09:49,520 --> 00:09:51,520
!وضع تاكومي خليطه في الفرن أيضًا

147
00:09:51,520 --> 00:09:54,780
لم يعد قادرًا الآن على القيام بتعديلات
.إلاّ في الإضافات والصّلصة

148
00:09:54,780 --> 00:10:00,780
لكن لا يوجد أيّ شيء في مكوّنات
!تاكومي يستطيع استعماله للقيام بتعديلات

149
00:10:01,160 --> 00:10:03,160
.لديّ وقت محدّد

150
00:10:03,160 --> 00:10:04,790
.عليّ الاستمرار في إعداد الطّبق

151
00:10:05,410 --> 00:10:08,160
!أصبحتُ عالقًا في هذه السّكّة الّتي وضعتُها أنا بنفسي

152
00:10:09,250 --> 00:10:12,090
.أمامنا الآن أقلّ من ثلاثين دقيقة

153
00:10:13,590 --> 00:10:15,260
!انتهى كلاهما من الخَبز

154
00:10:15,260 --> 00:10:16,170
ماذا؟

155
00:10:16,170 --> 00:10:20,220
هل لون كعكة ميماساكا أغمق من كعكة ألديني؟

156
00:10:20,220 --> 00:10:21,220
!هذا صحيح

157
00:10:21,220 --> 00:10:22,510
لماذا؟

158
00:10:22,510 --> 00:10:24,720
.بسكويت جوكوند

159
00:10:25,020 --> 00:10:30,020
.تمّ تغيير جلّ الدّقيق بدقيق اللّوز

160
00:10:30,350 --> 00:10:33,480
.إنّه يعطينا كعكة إسفنجيّة أكثر غنى وعبقًا

161
00:10:33,820 --> 00:10:35,480
!تعديل آخر

162
00:10:36,650 --> 00:10:41,490
كلّما زاد فخرهم، تسمّروا في أماكنهم أكثر
.عند إدراكهم أنّهم في ورطة

163
00:10:41,490 --> 00:10:44,830
إنّهم يصبحون خائفين من تقديم
.أطباق يعرفون أنّها ستخسر

164
00:10:44,830 --> 00:10:49,210
ونفس الوضع ينطبق عليك، أليس كذلك يا ألديني؟

165
00:10:49,910 --> 00:10:51,710
...إن خسرت الآن

166
00:10:52,500 --> 00:10:54,590
لماذا أتيتُ هنا لليابان من الأساس؟

167
00:11:02,140 --> 00:11:03,510
!ني-تشان

168
00:11:06,850 --> 00:11:09,680
.إيّاك أن تقلق يا أخي الصّغير

169
00:11:11,560 --> 00:11:13,900
.تذكّر مطبخ ألديني

170
00:11:13,900 --> 00:11:15,320
...الضّجيج والصّخب

171
00:11:15,940 --> 00:11:18,190
!ثق بما تعلّمتَه هناك

172
00:11:22,740 --> 00:11:24,700
.لنُرهم ما لدينا

173
00:11:24,700 --> 00:11:27,160
في هذه المباراة، سوف أتفوّق
...على نفسي حتّى الآن

174
00:11:27,990 --> 00:11:31,120
!سأتفوّق على الوصفة الّتي أعددتُ حتّى الآن

175
00:11:33,920 --> 00:11:36,250
.حسنًا، لقد انتهيت

176
00:11:37,800 --> 00:11:39,210
!يا لجماله

177
00:11:39,590 --> 00:11:43,640
أهذا هو السّيميفريدّو الّذي سيتغلّب
على طبق تاكومي ألديني؟

178
00:11:43,640 --> 00:11:44,590
...نعم

179
00:11:45,140 --> 00:11:48,010
.حلوى المكسّرات معطّرة باللّوز

180
00:11:48,010 --> 00:11:51,980
.الطّبقة الشّبيهة بالبوظة هي قشدة نصف مذابة

181
00:11:52,480 --> 00:11:54,730
.كلّ ذلك عملٌ حسّاس ومتقن

182
00:11:55,520 --> 00:11:58,320
!هذا ترقيع باستعمال أفكار سطحيّة مختلفة

183
00:11:58,320 --> 00:12:00,820
!أشكّ أن تشكّل النّكهات تجانسًا كاملاً فيما بينها

184
00:12:00,820 --> 00:12:02,740
.حسنًا، لنتذوّقه

185
00:12:04,360 --> 00:12:06,620
!الفرق في الملمس الّذي شكّلته الطّبقات الثّلاثة

186
00:12:06,870 --> 00:12:09,660
أستطيع أن أعرف فقط عن طريق
!إدخال المعلقة في الطّبق

187
00:12:11,330 --> 00:12:14,670
،الحلاوة الطّازجة للّيمون تملأ الفم

188
00:12:14,670 --> 00:12:17,290
!وعبير اللّوز يمتّع حاسّة الشّمّ لديّ

189
00:12:17,290 --> 00:12:21,010
لقد امتزجت النّكهات معًا دون أن تطغى
!أيّ واحدة على الأخرى، هذا مذهل

190
00:12:21,510 --> 00:12:27,470
يا للحلاوة والطّراوة... لقد حثّ هذا كلّ
.الأنوثة بداخلي على الظّهور

191
00:12:27,760 --> 00:12:32,890
اخترتُ بسكويت جوكوند لأنّه يتماشى جيّدًا
.مع حلوى المكسّرات

192
00:12:32,890 --> 00:12:35,150
بإمكانك الإحساس بعبير وغنى اللّوز
—في الكعكة الإسفنجيّة أيضًا

193
00:12:35,150 --> 00:12:36,230
!اخرس

194
00:12:36,230 --> 00:12:39,190
ألا تملك أيّ مبادئ كطاهٍ؟

195
00:12:39,690 --> 00:12:42,150
.أنا لا أفهم ما تقصده

196
00:12:42,570 --> 00:12:46,910
.التّدقيق في التّفاصيل" هو شعاري"

197
00:12:46,910 --> 00:12:51,120
لم أبخل بأيّ جهد في تحليل قدرات
.خصمي والتّخطيط لنصري

198
00:12:51,580 --> 00:12:54,710
ما الخطأ في ذلك؟

199
00:12:56,880 --> 00:12:58,590
.لا أريد أن أعترف به

200
00:12:58,590 --> 00:13:00,040
!لا أريد ذلك

201
00:13:00,040 --> 00:13:01,960
.لكنّي لا أستطيع مقاومة الإغراء

202
00:13:02,460 --> 00:13:04,050
...يا له من رجل لا يُطاق

203
00:13:04,050 --> 00:13:06,220
...لا يُطاق... لا يُطاق

204
00:13:06,220 --> 00:13:10,890
...لا يُطاق... لا يُطاق
!...لا يُطاق... لا يُطاق...لا يُطاق

205
00:13:10,890 --> 00:13:13,390
.أنا أكرهه، إنّه في غاية الرّوعة

206
00:13:13,390 --> 00:13:16,060
.لكنّ ابتسامته تجعل قلبي يدور كزوبعة

207
00:13:16,060 --> 00:13:17,310
.ومع ذلك، عليّ أن أسأل

208
00:13:17,310 --> 00:13:20,900
اضغط على مسرّع الحبّ رجاءً
...في طبق تحليتك ولنرحل

209
00:13:20,900 --> 00:13:24,740
...لا يُطاق... لا يُطاق
...لا يُطاق

210
00:13:26,110 --> 00:13:28,700
...تحوّلتُ إلى فتاة حتّى دون التّفكير في ذلك

211
00:13:29,030 --> 00:13:34,160
إنّه طبق التّحليّة الأفضل الّذي يُشعر آكله
.وكأنّ وسامة ألديني قد تضاعفت

212
00:13:34,160 --> 00:13:36,620
كيف له أن يأمل بالفوز الآن؟

213
00:13:38,710 --> 00:13:39,830
ماذا؟

214
00:13:39,830 --> 00:13:42,050
أستقوم بتقديم طبقك لهم بالفعل؟

215
00:13:42,420 --> 00:13:43,670
.لا تستخفّ بي

216
00:13:43,670 --> 00:13:45,550
.أنا شخص محترف

217
00:13:45,880 --> 00:13:48,970
.علينا تقديم الطّعام لزبنائنا مهما حدث

218
00:13:48,970 --> 00:13:50,390
...ذلك الطّبق

219
00:13:50,390 --> 00:13:53,890
إنّه مختلف عن السّيميفريدّو
.الّذي رأيتُ ني-تشان يجرّبه

220
00:13:53,890 --> 00:13:55,140
.معك حقّ

221
00:13:55,140 --> 00:13:58,690
هنالك طبقة رقيقة للغاية بين
!القشدة والكعكة الإسفنجيّة

222
00:13:59,100 --> 00:14:00,440
!طبقة رابعة

223
00:14:13,990 --> 00:14:14,740
...رجاءً

224
00:14:16,290 --> 00:14:17,410
!تعالي

225
00:14:19,750 --> 00:14:21,210
!إنّه ينضح بالحياة

226
00:14:22,090 --> 00:14:24,170
!يا له من نسيم متوسّطي عليل

227
00:14:26,300 --> 00:14:29,590
.أكلتُ الكثير من السّيميفريدّو

228
00:14:30,090 --> 00:14:32,760
!لكنّ هذا مختلف تمامًا عنها جميعها

229
00:14:32,760 --> 00:14:35,140
ما مصدر نكهة اللّيمون الطّاغية هذه؟

230
00:14:35,140 --> 00:14:37,850
!وما هذه الطّبقة الذّهبيّة؟

231
00:14:38,060 --> 00:14:42,440
.إنّها خثارة اللّيمون، تابل من أصول إنجليزيّة

232
00:14:42,770 --> 00:14:43,900
!خثارة اللّيمون

233
00:14:43,900 --> 00:14:46,690
يتمّ الحصول على بعض أنواعه
.من أجل العائلة الملكيّة البريطانيّة

234
00:14:46,690 --> 00:14:48,400
.إنّ لديه تاريخًا عريقًا

235
00:14:48,820 --> 00:14:52,370
.هذا المعجون الأنيق معطّر بنكهة اللّيمون الحلوة والمرّة

236
00:14:52,370 --> 00:14:55,410
.إنّها تذوب في الفم رفقة كعكة الجينواز الإسفنجيّة

237
00:14:55,410 --> 00:14:57,200
!يا له من إحساس خفيف في الفم

238
00:14:57,200 --> 00:15:00,210
الكعكة الإسفنجيّة المُعدّة عن طريق خفق بياض
،البيض وصفاره بشكل منفصل خشنة أكثر

239
00:15:00,210 --> 00:15:02,920
!لذلك لا يمكن الحصول على هذا الملمس

240
00:15:02,920 --> 00:15:09,840
خثارة اللّيمون مُعدّة من البيض والسّكّر
.وعصير اللّيمون وقشره، إضافة للزّبدة

241
00:15:09,840 --> 00:15:13,220
!لكن لم يتبقّى لك الكثير من الزّبدة

242
00:15:13,600 --> 00:15:15,140
.استعملتُ هذا كبديل

243
00:15:15,140 --> 00:15:17,020
.زيت الزّيتون

244
00:15:17,020 --> 00:15:19,890
.إنّه ليس مجرّد زيت زيتون عاديّ

245
00:15:20,180 --> 00:15:22,690
.هذا إبداع إيطاليّ للغاية

246
00:15:22,690 --> 00:15:26,230
بالفعل، الرّائحة المنعشة للزّيتون
!تتناسب جيّدًا مع اللّيمون

247
00:15:26,570 --> 00:15:29,990
لقد تفوّق عليّ في مسألة الكعكة
.الإسفنجيّة للسّيميفريدّو

248
00:15:29,990 --> 00:15:33,950
.ما كانت كعكتي لتنافس تأثير بسكويت جوكوند

249
00:15:33,950 --> 00:15:36,740
.شعرتُ أنّ عليّ أنّ أراهن على نكهة اللّيمون للفوز بالمباراة

250
00:15:37,490 --> 00:15:42,000
ظننتُ أنّه لو أمكنني تعزيز نكهة اللّيمون المنعشة
،وعمقها الخفيف باستعمال خثارة اللّيمون

251
00:15:42,580 --> 00:15:45,540
فلن يكون السّيميفريدّو الّذي أعددتُه
!فقيرًا مقارنة بما أعدّه هو

252
00:15:46,340 --> 00:15:49,630
!كانت لديك فكرة للاسترجال باستعمال شيء من إنجلترا

253
00:15:49,630 --> 00:15:53,550
ومع ذلك نجح في إعادة الطّبق
!إلى أصوله الإيطاليّة وهو ما يبرع فيه

254
00:15:53,840 --> 00:15:55,180
،بعبارات أخرى

255
00:15:55,550 --> 00:16:00,180
!هذا مكوّن جديد يجب أن يُسمّى خثارة اللّيمون الإيطاليّة

256
00:16:02,390 --> 00:16:06,060
.لقد أنشأ مذاقًا جديدًا في ظروف صعبة كهذه

257
00:16:07,400 --> 00:16:09,030
.تاكومي، إيسامي

258
00:16:10,280 --> 00:16:13,280
.خذا هذه معكما عندما تغادران لليابان

259
00:16:13,700 --> 00:16:16,700
.إنّه زيت الزّيتون الّذي تُعدّه عائلتنا

260
00:16:17,080 --> 00:16:19,410
.أنا واثق أنّه سوف يحميكما

261
00:16:20,160 --> 00:16:22,870
.لقد حماه اسم عائلة ألديني

262
00:16:24,290 --> 00:16:27,130
،عندما حظيتُ بوميض الإلهام
...ظننتُ أنّي سمعتُ صوتًا

263
00:16:27,420 --> 00:16:29,340
!صوت تغيّر السّكّة

264
00:16:31,460 --> 00:16:33,800
!صوت وصفتي السّابقة وقد تغلّبتُ عليها

265
00:16:36,390 --> 00:16:37,680
.أويزومي-دونو

266
00:16:38,050 --> 00:16:39,810
.يبدو أنّك لاحظتَ أيضًا

267
00:16:39,810 --> 00:16:40,930
!أيّها المدير

268
00:16:47,190 --> 00:16:49,020
أنت... ما الخطب؟

269
00:16:57,070 --> 00:16:58,120
ما المضحك؟

270
00:16:58,410 --> 00:16:59,870
"ما المضحك؟"

271
00:16:59,870 --> 00:17:02,080
!لا تُحزنّي

272
00:17:02,080 --> 00:17:05,460
!أنا أعرف كلّ شيء عنك

273
00:17:05,460 --> 00:17:06,290
.أخبروني

274
00:17:06,290 --> 00:17:08,670
أدركتم الأمر بعد أن قارنتما الطّبقين، صحيح؟

275
00:17:08,670 --> 00:17:11,300
بإمكانكما معرفة مدى عمق نكهة
!السّيميفريدّو الّذي أعددتُه

276
00:17:11,300 --> 00:17:14,050
!أضفتُ مكوّنًا سرّيًّا أيضًا قبل كلّ شيء

277
00:17:14,420 --> 00:17:16,010
.اللّيمون المحفوظ

278
00:17:16,430 --> 00:17:18,010
إنّه تابل تقليديّ مغربيّ الأصل

279
00:17:18,010 --> 00:17:21,470
!يُصنع عن طريق تمليح ليمون كامل لعدّة أسابيع

280
00:17:21,470 --> 00:17:25,600
إنّه تابل قويّ للغاية قادر على تعزيز

281
00:17:26,100 --> 00:17:28,860
.الحموضة والملوحة والمرارة والعفوصة والاعتدال

282
00:17:29,230 --> 00:17:34,360
أضفت قطعًا من اللّيمون المحفوظ ومياهه المالحة
.للكعكة الاسفنجيّة وحلوى المكسّرات والصّلصة

283
00:17:34,860 --> 00:17:38,870
.المرارة الخفيفة قد عزّزت من حلاوة السّيميفريدّو

284
00:17:40,320 --> 00:17:42,040
.أرأيت؟ لقد "وثقتُ" بك

285
00:17:42,040 --> 00:17:45,870
لقد عرفتُ أنّك ستستعمل المرونة
،الّتي اكتسبتَها في المطبخ

286
00:17:45,870 --> 00:17:47,790
،وأن ترفض الاستسلام

287
00:17:47,790 --> 00:17:49,880
!وتضيف تعديلاً أخيرًا

288
00:17:50,290 --> 00:17:54,760
كما أنّك تحمل معك دائمًا تميمة
!الحظّ خاصّتك وهو زيت الزّيتون

289
00:17:54,760 --> 00:17:56,720
.كلّ ما كان عليّ فعله هو تقفّي عملية تفكيرك

290
00:17:56,720 --> 00:18:03,060
الاستنتاج الوحيد الممكن هو أن تلتجئ
!إلى خثارة ليمون بأسلوب إيطاليّ

291
00:18:03,060 --> 00:18:05,350
!كم أنت ظريف

292
00:18:05,350 --> 00:18:07,600
!إنّك ترقص على راحة يدي

293
00:18:07,600 --> 00:18:11,520
!أنت لم تعلم حتّى أنّي توقّعتُ كلّ حركاتك

294
00:18:13,820 --> 00:18:15,070
!يا لها من فارق ضئيل

295
00:18:15,070 --> 00:18:17,360
إنّه صغير للغاية لدرجة أنّه لا يمكن ملاحظة الفرق

296
00:18:17,360 --> 00:18:18,950
.إلاّ إذا قمنا بالمقارنة المباشرة بينهما

297
00:18:19,660 --> 00:18:20,660
!...ومع ذلك

298
00:18:20,660 --> 00:18:23,990
،إنّك مُنساق بشيئين اثنين

299
00:18:24,240 --> 00:18:26,950
،علاقتُك بأخيك الصّغير إيسامي

300
00:18:27,250 --> 00:18:30,880
.وإعادة مباراتك مع يوكيهيرا سوما

301
00:18:31,670 --> 00:18:36,380
ما هو شعورك وأنت تخسر هذين
الشّيئين في نفس الوقت؟

302
00:18:38,130 --> 00:18:39,180
..."شيطان"

303
00:18:39,430 --> 00:18:40,890
!وصل الحكّام لقرار موحّد

304
00:18:41,140 --> 00:18:43,550
.هذا هو فوزي البارز رقم 100

305
00:18:43,550 --> 00:18:44,720
.سوف آخذ هذه

306
00:18:44,720 --> 00:18:49,390
!الفائز بالجولة الرّابعة هو المتنافس ميماساكا سوبارو

307
00:18:52,060 --> 00:18:53,560
،ومع نهاية هذه الجولة

308
00:18:53,900 --> 00:18:57,530
تكون كلّ مباريات المرحلة الأولى
!من انتخابات الخريف قد اكتملت

309
00:18:57,530 --> 00:18:59,320
.ستُقام المرحلة الثّانية بعد أسبوع من الآن

310
00:18:59,700 --> 00:19:03,700
وكما حدث في المرحلة الأولى، سنقوم بالسّحب
،لتحديد الثّنائيات المتبارية في المرحلة الثّانية

311
00:19:03,700 --> 00:19:05,660
.وسيتمّ إعلامكم بالنّتائج في نهاية اليوم

312
00:19:05,660 --> 00:19:06,660
!هذا كلّ شيء

313
00:20:38,630 --> 00:20:40,880
!أنا منزعجة للغاية

314
00:20:40,880 --> 00:20:42,510
!ما قصّة ذلك المطارِد؟

315
00:20:42,510 --> 00:20:44,260
أفهم حقيقة شعورك، لذلك لا
.تنفّسي عن غضبك فيّ أنا

316
00:20:44,630 --> 00:20:46,890
...لا بدّ أنّ تاكومي-كُن مصدوم الآن

317
00:20:51,520 --> 00:20:52,480
سوما-كُن؟

318
00:20:52,480 --> 00:20:53,730
.سأعود للمسكن

319
00:20:53,730 --> 00:20:54,480
ماذا؟

320
00:20:56,230 --> 00:20:57,980
!انتظر يا يوكيهيرا

321
00:20:57,980 --> 00:21:01,400
لماذا لم ترد أن تتحدّث مع تاكومي؟

322
00:21:04,360 --> 00:21:05,240
.أهلاً

323
00:21:05,240 --> 00:21:06,360
!ميماساكا؟

324
00:21:06,360 --> 00:21:08,030
!لماذا أنت في غرفة يوكيهيرا؟

325
00:21:08,030 --> 00:21:09,200
.لديّ مفتاح احتياطيّ

326
00:21:10,870 --> 00:21:11,700
ما الّذي تريده؟

327
00:21:12,080 --> 00:21:15,160
.لديّ أمر أرغب أن أبلغك به

328
00:21:15,160 --> 00:21:16,170
.حسنًا

329
00:21:16,170 --> 00:21:18,670
.سأعدّ بعض الشّاي

330
00:21:20,540 --> 00:21:22,840
صحيح يا ميماساكا، هل تعشّيت؟

331
00:21:23,340 --> 00:21:27,130
لديّ حساء لحم بقر من البارحة. أتريد بعضه؟

332
00:21:27,130 --> 00:21:29,550
.أكيد، شكرًا

333
00:21:29,550 --> 00:21:32,680
!عليه أن يطرد ذلك الشّخص خارجًا فحسب

334
00:21:32,680 --> 00:21:35,310
.إنّ يوكيهيرا يستضيفه كأنّه أيّ شخص آخر

335
00:21:35,600 --> 00:21:38,270
،بشأن الثّنائيّيْن اللّذين سيتباريان في المرحلة الثّانية

336
00:21:38,270 --> 00:21:40,270
.فإنّ القرار قد اتُخذ

337
00:21:40,650 --> 00:21:41,820
فعلاً؟

338
00:21:41,820 --> 00:21:44,610
،ستجمع مباراة بين كوروكيبا وهاياما

339
00:21:44,610 --> 00:21:48,820
.والأخرى ستجمعنا أنا وأنت يا يوكيهيرا

340
00:21:48,820 --> 00:21:49,950
.هكذا إذًا

341
00:21:49,950 --> 00:21:52,660
أتيتَ كلّ هذه المسافة لتخبرني بهذا فحسب؟

342
00:21:52,660 --> 00:21:54,250
أنت تعرف ما قصدي من كلّ هذا، صحيح؟

343
00:21:54,250 --> 00:21:56,290
!لنقم بتحدّي شوكوغيكي

344
00:21:56,290 --> 00:21:58,460
...سكّين الطّبخ الّتي تستعملها دائمًا

345
00:21:59,830 --> 00:22:01,880
.ستكون لي إن فزتُ أنا

346
00:22:02,130 --> 00:22:04,340
.وفي المقابل، سأعطيك هذه إن فزتَ أنت

347
00:22:05,670 --> 00:22:10,260
.يوكيهيرا سوما، أنا أعرف بالفعل ما الّذي يزعجك

348
00:22:11,300 --> 00:22:15,810
أنت لن تغفر أبدًا لأيّ إهانة غير عادلة
.في حقّ أيّ أحد تحترمه

349
00:22:16,810 --> 00:22:19,850
.ذلك الإيطاليّ المسكين... إنّه مثير للشّفقة

350
00:22:19,850 --> 00:22:23,480
!لقد هُزم شرّ هزيمة قبل حتّى أن يواجهك

351
00:22:23,820 --> 00:22:27,110
!إنّ فخره ومستقبله كطاهٍ في الحضيض

352
00:22:29,570 --> 00:22:30,740
ما رأيك؟

353
00:22:30,740 --> 00:22:33,740
!هيّا، فليعتريك الغضب

354
00:22:33,740 --> 00:22:37,250
.إنّي أسخر من صديقك العزيز

355
00:22:37,250 --> 00:22:40,790
.حسنًا، هذا مؤسف بالفعل

356
00:22:40,790 --> 00:22:44,050
لكنّ تاكومي ليس من النّوع الّذي قد
.يسمح لشيء كهذا بإفساد حياته

357
00:22:44,420 --> 00:22:45,880
.وهنالك أمر آخر

358
00:22:46,670 --> 00:22:49,720
.أنت هو المثير للشّفقة يا ميماساكا

359
00:22:49,720 --> 00:22:51,140
ما الّذي قلتَه؟

360
00:22:51,140 --> 00:22:53,430
أنا أحترم مهاراتك بالفعل، أتعلم هذا؟

361
00:22:53,430 --> 00:22:58,890
إنّ إعادة إنشاء طبق أعدّه شخص مثل
.تاكومي يتطلّب مهارة عالية

362
00:22:59,140 --> 00:23:02,270
لكن لماذا تزعج نفسك بمباريات لا فائدة منها كهذه؟

363
00:23:03,900 --> 00:23:08,190
."هُزم ألديني شرّ هزيمة في مباراة "بلا فائدة

364
00:23:08,190 --> 00:23:10,740
—بصفتي طاهٍ، فقد تغلّبتُ عليه بالكامـ

365
00:23:10,740 --> 00:23:11,490
.كلاّ

366
00:23:11,990 --> 00:23:15,200
.لقد استغللتَ مجهودات تاكومي لا غير

367
00:23:15,490 --> 00:23:21,670
يمكن لطبق ما أن يتألّق بسبب عمليّة
.التّجارب والأخطاء الّتي مرّ بها

368
00:23:22,290 --> 00:23:24,460
.أنت مثير للشّفقة

369
00:23:24,840 --> 00:23:28,920
.أنت لا تعرف الفرحة الحقيقيّة للطّبخ

370
00:23:29,260 --> 00:23:31,380
.لهذا السّبب أنت قادر على الضّحك في مباراة كتلك

371
00:23:31,840 --> 00:23:35,050
.إنّك تسلب النّاس فخرهم عن طريق فوز سطحيّ

372
00:23:35,050 --> 00:23:37,350
.لا أستطيع احترامك كطاهٍ بسبب شيء كهذا

373
00:23:37,720 --> 00:23:39,560
.سأقبل تحدّيك للشّوكوغيكي

374
00:23:39,560 --> 00:23:42,480
.لكن ما أريده ليس هو سكّين الميتزالونا فقط

375
00:23:42,940 --> 00:23:47,190
أريد الأدوات التّسعة والتّسعين الأخرى
.الّتي أخذتَها حتّى الآن أيضًا

376
00:23:47,190 --> 00:23:48,570
ماذا؟

377
00:23:48,570 --> 00:23:49,780
.لا تكن سخيفًا

378
00:23:49,780 --> 00:23:52,240
!هذا كثير جدًّا

379
00:23:52,240 --> 00:23:54,660
ما الّذي يمكنك أن تعطيه لي في المقابل
يستحقّ أن أخاطر بمائة أداة من أجله؟

380
00:23:54,660 --> 00:23:56,780
.حسنًا، سأكفّ عن كوني طاهيًا إن خسرت

381
00:23:59,910 --> 00:24:03,250
.سأكفّ عن كوني طاهيًا

382
00:24:06,000 --> 00:24:09,420
."في الحلقة القادمة: "السّرّ في القضمة الأولى