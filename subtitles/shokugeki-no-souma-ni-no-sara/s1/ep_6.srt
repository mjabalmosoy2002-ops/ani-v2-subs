1
00:00:05,150 --> 00:00:10,440
.إنّها أشبه بالمعركة المشهورة على جسر غوجو

2
00:00:14,530 --> 00:00:16,570
معركة بين بينكي حامل السّكّين

3
00:00:16,950 --> 00:00:22,000
!وبين حامل السّكّين أوشيواكامارو

4
00:00:24,120 --> 00:00:25,000
!هذا هو تعديلي

5
00:00:27,920 --> 00:00:30,300
...تدلّ رائحته أنّه متبّل ولكن خفيف

6
00:00:30,300 --> 00:00:32,970
...يا لها من رائحة دخان مميّزة

7
00:00:34,050 --> 00:00:35,470
!هذا لحم مجفّف

8
00:00:36,680 --> 00:00:38,850
،لكن إن كان يحاول تقليد يوكيهيرا

9
00:00:38,850 --> 00:00:41,560
.كان عليه استعمال لحم الذّيل في حسائه

10
00:00:41,560 --> 00:00:43,180
ما الغرض من اللّحم المجفّف إذًا؟

11
00:00:43,600 --> 00:00:47,190
...إنّ اللّحم المجفّف في الحساء يعني شيئًا واحدًا

12
00:00:47,600 --> 00:00:49,440
.إنّه ينوي استعمال للزّينة

13
00:02:23,950 --> 00:02:29,960
يوكيهيرا سوما، هدف وصفتك
.هو حساء لحم بقر تمّت تصفيته

14
00:02:30,370 --> 00:02:34,040
وهذا سيجعل الطّبق مملاًّ
.إذا تكوّن من الصّلصة واللّحم فقط

15
00:02:34,040 --> 00:02:38,300
.ولهذا السّبب أصبحت الزّينة خطوة أساسيّة

16
00:02:38,920 --> 00:02:40,970
يُقال أنّ حساء لحم البقر قد تطوّر
،من طبق لحم البقر بالبورغينيون

17
00:02:40,970 --> 00:02:44,350
وهو طبق لحم بقر مطبوخ في النّبيذ الأحمر
.من منطقة بورغونْيْ في فرنسا

18
00:02:44,350 --> 00:02:46,810
،وهو طبق يحتوي دائمًا على زينة

19
00:02:47,430 --> 00:02:49,430
،وتكون في العادة من الخبز المحمّص

20
00:02:49,430 --> 00:02:51,440
،والبصل اللّؤلئيّ المجمّد

21
00:02:51,440 --> 00:02:53,060
،والفطر المقلي

22
00:02:53,520 --> 00:02:54,900
.إضافة للّحم المجفّف

23
00:02:54,900 --> 00:02:57,320
.يا لها من رائحة تسيل اللّعاب

24
00:02:57,320 --> 00:02:59,860
!إنّها خفيفة ولكنّ تأثيرها قويّ

25
00:02:59,860 --> 00:03:03,320
لقد استعمل خشب شجرة الميسكيت
.لتدخين اللّحم المجفّف

26
00:03:03,660 --> 00:03:05,990
شجرة تنتمي لعائلة الخضراوات
.أصلها من جنوب أمريكا

27
00:03:05,990 --> 00:03:09,080
إنّها غير معروفة في اليابان كخشب
.يُستعمل لتدخين اللّحم

28
00:03:09,500 --> 00:03:12,170
،في ولاية تكساس، معقل المشويّات

29
00:03:12,170 --> 00:03:14,840
.يُعتبر واحدًا من أفضل أخشاب التّدخين لديهم

30
00:03:15,290 --> 00:03:17,210
،وبسبب رائحته الحادّة

31
00:03:17,210 --> 00:03:19,300
،يُستعمل لتدخين اللّحم ذي النّكهة القويّة

32
00:03:19,300 --> 00:03:21,760
.ويضفي لونًا ذهبيًّا لامعًا

33
00:03:21,760 --> 00:03:23,760
،وفي الماء المالح

34
00:03:23,760 --> 00:03:27,640
،أضفتُ عشبة المريميّة وجوزة الطّيب وورق الغار

35
00:03:27,970 --> 00:03:30,980
!إضافة إلى مكوّني السّرّي وهو السّكّر الأسمر

36
00:03:31,270 --> 00:03:33,940
.سيُقوّي هذا من الأومامي بشكل لا يصدّق

37
00:03:33,940 --> 00:03:37,860
هل كان ميماساكا بهذه الدراية بالتّدخين والتّجفيف؟

38
00:03:37,860 --> 00:03:39,780
!إنّ معرفته وخبرته توازيان ما لدى إيبوساكي

39
00:03:40,110 --> 00:03:41,820
!ما الّذي يحدث؟

40
00:03:41,820 --> 00:03:43,280
...وغد

41
00:03:43,280 --> 00:03:47,830
لا يبدو أنّ يوكيهيرا-كُن سيضيف
.أيّ شيء غير عاديّ للزّينة

42
00:03:47,830 --> 00:03:51,460
ربّما اعتبرها مجرّد شيء إضافيّ
.يقدّم إلى جانب الطّبق

43
00:03:51,460 --> 00:03:52,040
ماذا؟

44
00:03:52,040 --> 00:03:53,620
.الزّينة، الزّينة

45
00:03:53,920 --> 00:03:57,840
.الزّينة مكوّن ضروريّ في حساء لحم البقر أيضًا

46
00:03:58,130 --> 00:03:59,090
.كم هذا مخيّب للآمال

47
00:03:59,500 --> 00:04:02,050
!لا يستطيع يوكيهيرا سوما الفوز

48
00:04:02,050 --> 00:04:06,510
الخروج باستنتاجات متسرّعة قبل
.تذوّق طبقه... هو أمر بغيض

49
00:04:06,510 --> 00:04:11,270
لا بدّ أنّ وجود شخصين مثلكما كطاهيين
.رئيسيّين أمر متعب في المطبخ

50
00:04:11,270 --> 00:04:12,600
.اخرسي يا ذات الثّلاثين عامًا

51
00:04:12,600 --> 00:04:14,560
!لم  أبلغ الثّلاثين بعد

52
00:04:14,560 --> 00:04:15,850
!لا زلت في العشرينات

53
00:04:15,850 --> 00:04:19,020
!كفّي عن هذه التّصرّفات الظّريفة

54
00:04:19,020 --> 00:04:23,200
تسونوزاكي، لا يجب عليك التّحدّث
.عن سنّ أحدهم أمامه

55
00:04:23,200 --> 00:04:26,200
.حسنًا، هذا مفهوم يا فويومي-سينباي

56
00:04:26,200 --> 00:04:28,830
!لماذا أنت مهذّبة مع ميزوهارا-سينباي فقط؟

57
00:04:28,830 --> 00:04:31,040
.أنا من تختار من يستحقّ احترامي

58
00:04:31,790 --> 00:04:34,290
قام ميماساكا بالبحث في أمر لحم
.الذّيل الّذي هو المكوّن الحاسم

59
00:04:34,290 --> 00:04:37,250
.ثمّ قام بتعديلٍ باستخدام لحمه المجفّف الخاصّ

60
00:04:37,790 --> 00:04:41,210
.إنّ يوكيهيرا في وضع لا يُحسد عليه الآن بالفعل

61
00:04:42,630 --> 00:04:44,470
ما-ماذا عليه أن يفعل؟

62
00:04:44,470 --> 00:04:46,220
...على هذه الحال، فإنّ يوكيهيرا سوف

63
00:04:46,890 --> 00:04:49,050
.إن انهزمتُ أمامك، سأكفّ عن كوني طاهيًا

64
00:04:49,390 --> 00:04:51,140
...يوكيهيرا-سينباي

65
00:04:51,140 --> 00:04:54,100
.هذا أنت يا سوتسودا ميتسورو

66
00:04:54,980 --> 00:04:57,480
.عليك اختيار كلمة سرّ أفضل

67
00:04:57,940 --> 00:05:00,650
.استعمال تاريخ ميلادك هو أمر واضح

68
00:05:03,240 --> 00:05:05,240
سوف أخبر الأكاديميّة بأكملها

69
00:05:05,240 --> 00:05:07,950
!عن انتصار يوكيهيرا-سينباي باستعمال طبعتي الخاصّة

70
00:05:09,490 --> 00:05:12,200
!رأيتَ ملاحظاتي؟

71
00:05:12,450 --> 00:05:15,160
.لقد جعلت عملي سهلاً بالفعل

72
00:05:16,160 --> 00:05:17,670
.لك الفضل في كلّ هذا

73
00:05:18,540 --> 00:05:21,420
كلّ الأيّام الّتي قضاها يوكيهيرا-سينباي
...في اختبار وصفاته

74
00:05:21,420 --> 00:05:25,970
...كلّ ذلك الوقت الّذي قضاه في الابتكار
.قد أصبح معلومات بين يدي ميماساكا

75
00:05:25,970 --> 00:05:27,550
.وكلّ هذا خطئي أنا

76
00:05:31,350 --> 00:05:32,600
...هذا

77
00:05:32,810 --> 00:05:35,980
اسمك تسونوزاكي تاكي-سينباي، صحيح؟

78
00:05:36,870 --> 00:05:39,860
،أظنّ أنّك قلت الكثير من الأمور عنّي

79
00:05:40,270 --> 00:05:41,860
...لكنّي سأصغي لشكواكِ

80
00:05:42,770 --> 00:05:44,820
!بعد أن تتذوّقي طبقي

81
00:05:45,150 --> 00:05:45,860
...هذه

82
00:05:45,860 --> 00:05:46,700
...أنواع مختلفة

83
00:05:46,700 --> 00:05:47,400
...من أجزاء

84
00:05:47,400 --> 00:05:48,070
!اللّحم

85
00:05:48,070 --> 00:05:48,990
.لحم الجانِبَيْن

86
00:05:48,990 --> 00:05:49,780
.لحم اللّسان

87
00:05:49,780 --> 00:05:50,700
!الكرشة

88
00:05:50,700 --> 00:05:51,330
!شرائح الخاصرة

89
00:05:52,030 --> 00:05:53,870
...إذًا

90
00:05:53,870 --> 00:05:55,290
،يا أعزّائي الحكّام

91
00:05:55,660 --> 00:06:00,000
!سوف آخذكم الآن في جولة في حديقة اللّحوم

92
00:06:00,920 --> 00:06:04,420
!غليتُ لحم اللّسان بشكل جزئيّ وقشّرته

93
00:06:04,420 --> 00:06:05,090
!إنّه سريع

94
00:06:05,460 --> 00:06:09,010
،سأحمّر اللّحم بالزّبدة لتليينه

95
00:06:09,010 --> 00:06:11,140
!وأضيف زيت الزّيتون لإنعاش النّكهة

96
00:06:11,430 --> 00:06:15,220
سأنقع لحم الجانِبَيْن في النّبيذ الأحمر
.والبقدونس وورق الغار

97
00:06:15,600 --> 00:06:17,810
،سأتبّله بالملح والفلفل

98
00:06:17,810 --> 00:06:19,730
سأضع طبقة رفيعة من الدّقيق
!على اللّحم وأقوم بتحميره

99
00:06:20,400 --> 00:06:22,900
!سأستعمل الفرن لأشوي الشّرائح الّتي لا زالت في القِدر

100
00:06:24,690 --> 00:06:26,690
!ماذا يفعل؟

101
00:06:26,690 --> 00:06:29,280
.هذا يعني أنّه يرتجل كلّ شيء الآن

102
00:06:29,530 --> 00:06:30,740
...يرتجل الطّبخ

103
00:06:30,740 --> 00:06:31,990
...إنّ لحم البطن ذاك

104
00:06:33,950 --> 00:06:35,160
ماذا؟

105
00:06:35,160 --> 00:06:36,660
!هل يهرب؟

106
00:06:38,000 --> 00:06:39,000
.لقد عاد

107
00:06:40,710 --> 00:06:43,670
أنا سعيد لأنّي أحضرتُ معي مشواة
.الفحم خاصّتي لغرفة الاستعداد

108
00:06:43,920 --> 00:06:46,130
يستعمل مشواة الفحم من أجل الحساء؟

109
00:06:46,130 --> 00:06:48,130
ما الّذي ينوي فعله؟

110
00:06:48,130 --> 00:06:51,050
.إنّه يقوم بابتكار الطّبق الآن بالفعل

111
00:06:51,050 --> 00:06:52,260
.يا يوكيهيرا

112
00:06:52,720 --> 00:06:56,470
.هذه هي الطّريق الّتي ستسلكها كما توقّعت

113
00:06:56,810 --> 00:07:00,640
إنّ الخصوم الّذين يعرفون طريقة بحثي
.يأخذون طريقًا أو طريقين معروفين

114
00:07:00,640 --> 00:07:04,560
.الأوّل هو التّظاهر، وبعدها محاولة خداعي

115
00:07:04,560 --> 00:07:06,690
يعلنون في البداية عن الطّبق
،الّذي سيعدّونه قبل المباراة

116
00:07:06,690 --> 00:07:09,740
وبعدها يحاولون خداعي عن طريق إعداد
.طبق مختلف تمامًا في المباراة

117
00:07:10,320 --> 00:07:11,150
،والطّريق الآخر

118
00:07:11,150 --> 00:07:15,120
،الّذي يسلكه الخصم الّذي يثق بمهاراته

119
00:07:15,120 --> 00:07:17,040
!هو الطّبخ الارتجاليّ

120
00:07:17,040 --> 00:07:21,160
.يأتون دون تجهيز أيّ خطّة، ثمّ يبدأون بالطّبخ

121
00:07:21,160 --> 00:07:23,830
يعتقدون أنّي لن أقرأ أفكارهم
.ما داموا لا يفكّرون في شيء ما

122
00:07:23,830 --> 00:07:27,250
لكنّ أغلبيّتهم يستسلمون للذّعر

123
00:07:27,250 --> 00:07:30,130
،ويخسرون دون حتّى تقديم طبق منتهٍ

124
00:07:30,130 --> 00:07:33,390
.لكن أراهن أنّك ستقدّم طبقًا جيّدًا للغاية

125
00:07:33,390 --> 00:07:35,850
.أنت لست من النّوع الّذي يُذعر في منتصف الطّريق

126
00:07:35,850 --> 00:07:38,350
لماذا تُثني عليّ فجأة هكذا؟

127
00:07:38,350 --> 00:07:40,560
.أنا أثق بك

128
00:07:40,560 --> 00:07:42,940
.أعرف كلّ شيء عنك

129
00:07:42,940 --> 00:07:45,860
،أعلم أنّك ذهبتَ إلى شقّة ألديني هذا الصّباح

130
00:07:46,440 --> 00:07:50,990
.وأعلم أنّك أحضرتَ الكثير من اللّحم بعد ذلك

131
00:07:52,740 --> 00:07:56,700
.سوف نقوم  بتقييم طبق ميماساكا سوبارو أوّلاً

132
00:07:56,910 --> 00:08:01,910
.حسنًا، بالهناء والشّفاء

133
00:08:02,120 --> 00:08:06,960
لقد استعمل اللّحم المجفّف والفطر
.والبصل اللّؤلئيّ المجمّد كزينة

134
00:08:06,960 --> 00:08:11,340
."عبارة مجمّد بالفرنسيّة هي "غلاسي

135
00:08:11,340 --> 00:08:14,010
.السّطح اللاّمع يجمع مكوّنات الطّبق معًا

136
00:08:14,010 --> 00:08:14,720
!اخرسي

137
00:08:14,720 --> 00:08:15,890
!تذوّقيه فحسب

138
00:08:15,890 --> 00:08:18,510
.سـ-سأتذوّقه

139
00:08:23,440 --> 00:08:29,110
لُزوجة لحم الذّيل والميسو البيضاء الخفيفة
!المخفيّة عميقًا مذهلة للغاية

140
00:08:30,110 --> 00:08:32,860
!أعتقد أنّ لساني يذوب الآن

141
00:08:32,860 --> 00:08:37,820
ومع ذلك، رائحة خشب الميسكيت
!المنبعثة من اللّحم المجفّف قويّة للغاية

142
00:08:37,820 --> 00:08:39,450
!إنّه لذيذ بشكل لا يصدّق

143
00:08:39,740 --> 00:08:42,330
.لقد توقّعتُ كلّ أفكارك

144
00:08:42,330 --> 00:08:44,960
.عرفتُ أنّك ستلتجأ للطّبخ الارتجاليّ أيضًا

145
00:08:44,960 --> 00:08:48,840
!لهذا السّبب اخترتُ هذا اللّحم المجفّف

146
00:08:48,840 --> 00:08:51,210
!لقد أمضى خمسة أيّام كاملة في ماء مالح

147
00:08:51,210 --> 00:08:54,260
،وبعدها جفّفتُه في الهواء لمدّة يوم كامل

148
00:08:54,260 --> 00:08:56,800
.ثمّ دخّنته لخمس ساعات

149
00:08:56,800 --> 00:09:01,010
يتطلّب هذا المستوى من الأومامي
.كلّ هذا الوقت والمجهود

150
00:09:01,010 --> 00:09:02,470
...بالفعل

151
00:09:02,470 --> 00:09:05,230
أومامي لحم الخنزير هذا المعتنى به جيّدًا

152
00:09:05,230 --> 00:09:08,980
!لم يقم بإضعاف نكهة لحم البقر، بل قام بتعزيزها

153
00:09:08,980 --> 00:09:11,780
!هذا بفضل الوقت وكذلك الجهد المبذول

154
00:09:11,780 --> 00:09:14,740
يمتلك هذا الطّبق قوّة يمكن اعتبارها

155
00:09:14,740 --> 00:09:16,490
!النقيض الكامل لأيّ طبق مرتجل

156
00:09:16,490 --> 00:09:18,870
!هذا تمامًا ما حدث في مباراة تاكومي

157
00:09:18,870 --> 00:09:21,740
...لقد عرف أيضًا أنّ سوما-كُن سيرتجل طبقه

158
00:09:21,740 --> 00:09:23,910
.لقد توقّع كلّ شيء

159
00:09:23,910 --> 00:09:25,330
!لقد قام بخطوة استباقيّة

160
00:09:25,620 --> 00:09:28,460
!يا لخفّته! يا للينِه

161
00:09:28,790 --> 00:09:31,340
لقد تخطّت هذه النّكهة أيّ شيء يمكن
.لأيّ بحث معمّق القيام به

162
00:09:32,420 --> 00:09:33,550
...إنّ هذا أشبَه

163
00:09:35,010 --> 00:09:38,510
!بصراع حامٍ بين اللّحم في حلبة قتال

164
00:09:40,300 --> 00:09:44,470
!هذه اللّذّة المفرطة تهزّ المرء حتّى النّخاع

165
00:09:44,470 --> 00:09:46,940
!كلاّ! لا أستطيع احتماله

166
00:09:47,850 --> 00:09:49,400
...التّفاعل بين لحم البقر ولحم الخنزير

167
00:09:50,190 --> 00:09:52,860
!تأثير متجانس

168
00:09:53,280 --> 00:09:55,070
!يا له من ثناء

169
00:09:55,070 --> 00:09:57,820
!حتّى الطّهاة المحترفون مذهولون

170
00:10:09,920 --> 00:10:12,540
!يا لحماقتك يا يوكيهيرا

171
00:10:12,790 --> 00:10:16,760
...ابتكار طبق  الآن بينما ينزل عليك الإلهام

172
00:10:17,090 --> 00:10:21,970
،قد يبدو ذلك فكرة رائعة من الوهلة الأولى
!لكنّه مجرّد إخفاء لحقيقة الأمر فحسب

173
00:10:21,970 --> 00:10:26,140
إنّ من يخطّط لطبخه بأدقّ التّفاصيل

174
00:10:26,140 --> 00:10:29,270
!ويقوم بالتّجهيزات الضّروريّة دائمًا ما يفوز

175
00:10:29,270 --> 00:10:34,900
،لا يهمّ كم  من خدعة تخبّئ في جعبتك
!فكلّ ذلك بلا فائدة

176
00:10:34,900 --> 00:10:36,480
!كلّه بلا فائدة

177
00:10:36,900 --> 00:10:40,070
.حسنًا، إيّاك أن تنسى هذه اللّحظة بدًا

178
00:10:41,070 --> 00:10:46,410
.هذا آخر طبق ستقدّمه لزبون في حياتك

179
00:10:55,420 --> 00:10:58,170
.لقد أحزنتَني يا ميماساكا

180
00:10:59,010 --> 00:11:02,340
.أنا أيضًا أثق بك

181
00:11:02,340 --> 00:11:03,140
ماذا؟

182
00:11:03,140 --> 00:11:08,100
.لقد فكّرتُ بك أيضًا طوال الأسبوع المنصرم

183
00:11:11,690 --> 00:11:13,480
،مهما كانت الخدعة الّتي سيقوم بها الآن

184
00:11:14,230 --> 00:11:16,190
.فسوف تقع في مجال توقّعاتي حتمًا

185
00:11:16,190 --> 00:11:19,900
ومع ذلك... لماذا أنا خائف؟

186
00:11:19,900 --> 00:11:21,860
.حسنًا، تفضّلوا

187
00:11:22,860 --> 00:11:23,990
!بالهناء والشّفاء

188
00:11:24,570 --> 00:11:26,580
...إنّه حساء لحم البقر بأسلوب يوكيهيرا

189
00:11:26,580 --> 00:11:28,790
!الخاصّ بانتخابات الخريف

190
00:11:29,540 --> 00:11:31,410
!هنالك أجزاء مختلفة وعديدة من اللّحم

191
00:11:33,460 --> 00:11:36,000
.من الأفضل ألاّ يكون هذا الطّبق أضحوكة

192
00:11:36,000 --> 00:11:38,380
—لم أرَ في حياتي كلّها حساء لحم بقر كهـ

193
00:11:37,500 --> 00:11:38,920
ما الّذي تعنينه؟

194
00:11:38,920 --> 00:11:41,010
.إنّه حساء لحم بقر بالفعل

195
00:11:41,590 --> 00:11:43,930
.وكلّ ذلك مجرّد زينة

196
00:11:43,930 --> 00:11:44,550
!ماذا؟

197
00:11:44,550 --> 00:11:46,430
كلّ هذا زينة؟

198
00:11:46,430 --> 00:11:48,680
...رائحة دخان الفحم

199
00:11:48,680 --> 00:11:51,180
.إنّه مطهوّ بدقّة

200
00:11:52,940 --> 00:11:55,690
...هذا مجرّد إقحام لمكوّنات عشوائيّة معًا لا غير

201
00:11:56,060 --> 00:11:58,650
!يا لها من محاولة فظّة

202
00:11:58,650 --> 00:12:02,610
.بالكاد يمكنها أن تقارن بزينتي

203
00:12:03,030 --> 00:12:06,910
لقد عزّزتُ اللّحم المجفّف الّذي أضفتُه
.برائحة خشب الميسكيت المغرية

204
00:12:07,370 --> 00:12:10,830
.لا يمكنه منافسة نكهتي المصقولة بدقّة

205
00:12:13,290 --> 00:12:16,710
.لا يختلف الحساء بحدّ ذاته عن الّذي تذوّقناه سابقًا

206
00:12:17,000 --> 00:12:18,630
...أمّا الزّينة

207
00:12:29,260 --> 00:12:30,270
!ماذا؟

208
00:12:31,470 --> 00:12:32,350
!يمين

209
00:12:32,850 --> 00:12:33,810
!يسار

210
00:12:34,560 --> 00:12:36,810
!ودورة مفاجئة

211
00:12:37,230 --> 00:12:38,730
!لذيذ

212
00:12:39,900 --> 00:12:43,700
!لحم الجانِبَيْن الخفيف واللّيّن يذوب في الفم

213
00:12:43,700 --> 00:12:46,450
!اللّسان والكرشة يقدّمان ملمسًا وشعورًا رائعين

214
00:12:48,740 --> 00:12:50,990
لحم البطن المشويّ على الفحم

215
00:12:50,990 --> 00:12:54,410
!مليء بالعصارة بسبب تقطيعه بشكل سميك

216
00:12:54,830 --> 00:12:56,420
،حتّى عند تذوّقها مع الحساء

217
00:12:56,420 --> 00:12:58,670
.فإنّ الزّينة تضيف لمسة ممتازة للطّبق

218
00:12:58,960 --> 00:12:59,880
.نعم

219
00:12:59,880 --> 00:13:02,460
،قد يبدو الطّبق متسرّعًا للوهلة الأولى

220
00:13:02,460 --> 00:13:04,630
.لكنّ كلّ مكوّن قد أعدّ بشكل متقن

221
00:13:04,630 --> 00:13:07,300
.إنّها حديقة ملاهٍ قد تمّ بناؤها بكلّ حذر

222
00:13:07,300 --> 00:13:10,180
.يا له من توازن مثاليّ

223
00:13:10,640 --> 00:13:11,810
!مستحيل

224
00:13:11,810 --> 00:13:14,480
!كيف أمكنه القيام بهذا من خلال الارتجال؟

225
00:13:14,480 --> 00:13:16,100
،لأكون صريحًا

226
00:13:16,100 --> 00:13:18,770
،كنتُ أفكّر بنفس طريقتك

227
00:13:18,770 --> 00:13:23,070
وفكّرتُ في استعمال زينةٍ قويّةِ النّكهة
.كاللّحم المجفّف المدخّن لتقوية النّكهة

228
00:13:23,820 --> 00:13:25,490
.لكنّ ذلك لن يكون صائبًا

229
00:13:26,650 --> 00:13:28,620
.تلك ليست طريقتي في الطّبخ

230
00:13:29,740 --> 00:13:33,790
أردتُ شيئًا يمكن لكمّيّات كبيرة من النّكهات والمكوّنات

231
00:13:33,790 --> 00:13:35,370
.أن تجتمع وتشكّل طبقًا واحدًا

232
00:13:36,660 --> 00:13:41,210
لم أتوقّع أبدًا أن يكون لحساء لحم البقر
.نكهة عميقة وشاملة

233
00:13:41,210 --> 00:13:45,590
.أجل، لقد ألهمني طبق معيّن لإعداد هذا

234
00:13:45,590 --> 00:13:47,050
أيّ طبق؟

235
00:13:47,050 --> 00:13:49,550
لقد ساورني بصيص الإلهام ذاك
.هذا الصّباح في الحقيقة

236
00:13:50,220 --> 00:13:51,300
.إنّه حساء تشيكوزين

237
00:13:52,640 --> 00:13:55,560
،يتمّ اعتبار الطّبق على أنّه حساء بسيط بشكل خاطئ

238
00:13:55,560 --> 00:13:58,730
.لكن عندما يُعدّه المحترفون، فهو أمر مختلف تمامًا

239
00:13:58,730 --> 00:14:00,230
أليس كذلك يا هيناكو-سينباي؟

240
00:14:00,230 --> 00:14:01,400
.نعم

241
00:14:01,400 --> 00:14:06,990
عن طريق طبخ كلّ نوع من الخضراوات
،ببطء وبشكل منفصل ولوقت معيّن

242
00:14:06,990 --> 00:14:09,110
.يمكننا تعزيز لون ونكهة كلّ مكوّن على حدى

243
00:14:09,910 --> 00:14:13,280
،وبعدها نعيد جمع المكوّنات في طبق واحد نهائيّ

244
00:14:13,280 --> 00:14:16,450
.مع إعارة انتباهنا إلى التّوازن بين المكوّنات

245
00:14:16,910 --> 00:14:18,210
.نفس الشّيء ينطبق على هذا الطّبق

246
00:14:18,540 --> 00:14:21,790
.حساء تشيكوزين... هذا طبق شعبيّ بالتّأكيد

247
00:14:21,790 --> 00:14:23,670
!هذا هو اختصاص يوكيهيرا

248
00:14:23,670 --> 00:14:28,130
يوكيهيرا، ألم تكن تطبخ بشكل مرتجل
!ودون أيّ تخطيط مسبق؟

249
00:14:28,380 --> 00:14:30,590
.لم أقل أبدًا أنه طبخ مرتجل

250
00:14:31,220 --> 00:14:34,640
!لقد كنتُ أبني هذا الطّبق طوال حياتي

251
00:14:35,430 --> 00:14:37,890
...الطّريق الّذي سرتُ فيه للوصول لهذه المرحلة

252
00:14:37,890 --> 00:14:40,810
...تشكيلات النّكهات العديدة الّتي جرّبتُها

253
00:14:42,610 --> 00:14:47,360
لقد استجمعتُ كلّ ما لديّ لابتكار
.هذا الطّبق في رأسي

254
00:14:47,360 --> 00:14:49,320
لطالما أخذتَ الخطوة الضّروريّة فقط

255
00:14:49,320 --> 00:14:53,200
.لاكتشاف وتجاوز طبق خصمك

256
00:14:53,200 --> 00:14:55,330
توقّعتُ أنّك ما كنتَ لتستطيع القيام
.بما كنتُ أحاول القيام به

257
00:14:55,620 --> 00:15:00,000
!طريقة لا يمكن لبحثي المعمّق أن يتغلّب عليها؟

258
00:15:00,330 --> 00:15:04,790
ما أنشأه هنا هو نعيم مزيّن بكلّ النّكهات
...اللّذيذة الّتي يمكن للحم البقر أن يوفّرها

259
00:15:05,300 --> 00:15:08,340
أرض من الأحلام تجعلك ترغب
...بالبقاء فيها للأبد

260
00:15:09,550 --> 00:15:10,970
!ويعشقها الجميع

261
00:15:12,720 --> 00:15:15,680
!أرض ملاهي يوكيهي

262
00:15:32,570 --> 00:15:33,320
...لحظة

263
00:15:33,780 --> 00:15:37,160
.لنتذكّر هذا اليوم للأبد

264
00:15:39,290 --> 00:15:39,870
!أجل

265
00:15:40,200 --> 00:15:44,750
!لنكن جميعًا أصدقاء للأبد

266
00:15:47,960 --> 00:15:49,800
!اتركي يدي

267
00:15:51,050 --> 00:15:54,090
.لديك يدين صغيرتين وظريفتين يا تاكي-تشان

268
00:15:54,090 --> 00:15:54,800
!ماذا؟

269
00:15:54,800 --> 00:15:57,310
!لماذا أنت غارقة في دموعك؟

270
00:15:56,050 --> 00:15:57,310
!يا للظّرافة

271
00:15:57,310 --> 00:16:01,310
يبدو أنّ يوكيهيرا هو الّذي لم يكن
.بحاجة للتّستّر على أيّ شيء في النّهاية

272
00:15:58,140 --> 00:16:00,730
!كفّي عن التّحديق

273
00:16:01,730 --> 00:16:05,940
الطّريق الطّويلُ جدًّا بالسعي خلف
...طريقتك الخاصّة في الطّبخ

274
00:16:06,360 --> 00:16:09,360
.هذا هو العمق الّذي يمتلكه الطّاهي المحترف

275
00:16:10,190 --> 00:16:14,740
جمع يوكيهيرا كلّ ذلك في طبق واحد
!بشكل يثير الإعجاب

276
00:16:14,740 --> 00:16:19,080
.حان الآن وقت التّقييم النّهائيّ

277
00:16:19,620 --> 00:16:22,500
بهذا تنتهي الجولة الأولى
،لنصف نهاية انتخابات الخريف

278
00:16:22,500 --> 00:16:24,460
!وتحدّي الشّوكوغيكي

279
00:16:24,460 --> 00:16:27,920
!أيّها الحكّام، ادلوا بأصواتكم رجاءً

280
00:16:28,880 --> 00:16:31,630
!والآن، ما هي النّتيجة؟

281
00:16:32,670 --> 00:16:34,300
!تصويت بالإجماع

282
00:16:34,630 --> 00:16:37,760
،فاز المتنافس يوكيهيرا سوما بالشّوكوغيكي

283
00:16:37,760 --> 00:16:41,180
!وسينتقل إلى النّهائيّات

284
00:16:41,680 --> 00:16:42,890
!سعيد لأنّ الطّبق أعجبكم

285
00:16:43,810 --> 00:16:44,890
!لقد فاز

286
00:16:44,890 --> 00:16:46,100
!سوما-كُن

287
00:16:49,820 --> 00:16:50,900
...مستحيل

288
00:16:50,900 --> 00:16:54,110
!لا يستطيع أحد الإفلات من بحثي المعمّق

289
00:16:54,110 --> 00:16:55,780
،إن كان ذلك ما تظنّه

290
00:16:55,780 --> 00:16:57,740
.عليك تذوّقه أيضًا

291
00:17:07,880 --> 00:17:09,790
!أرض ملاهي يوكيهي

292
00:17:10,380 --> 00:17:13,920
سُحقًا... لماذا هذا... ممتع للغاية؟

293
00:17:14,800 --> 00:17:18,890
بدأت أتذكّر كيف كان الحال

294
00:17:19,600 --> 00:17:21,100
!عندما بدأت الطّبخ في بادئ الأمر

295
00:17:35,530 --> 00:17:37,610
.إنّكما تحرجانني

296
00:17:37,610 --> 00:17:40,620
.كلّ ما أفعله هو التّعلّم عن طريق التّقليد

297
00:17:41,200 --> 00:17:44,580
هل سيُثني عليّ أبي عندما يرى هذه؟

298
00:17:45,160 --> 00:17:47,040
!لا تفرح كثيرًا بهذا التّقليد الضّعيف

299
00:17:47,540 --> 00:17:52,130
!يتمتّع نخبة الطّهاة بحسّ الأصالة

300
00:17:52,630 --> 00:17:55,210
لا يحتاج هذا المطعم إلى طهاة ليس
!لديهم إيمان شخصيّ

301
00:17:56,130 --> 00:17:57,930
،بعدها ببضعة أيّام

302
00:17:58,380 --> 00:18:01,850
أقيم عرض لأطباقنا الجديدة مع حضور
.الكثير من الزّبائن من الشّخصيّات المهمّة

303
00:18:02,560 --> 00:18:04,310
.لم أقم بالأمر بدافع الحقد

304
00:18:04,680 --> 00:18:07,100
.أردتُ أن أحظى باحترامه فحسب

305
00:18:07,730 --> 00:18:11,560
،أضفتُ تعديلاً واحدًا بسيطًا لطبق والدي الخاصّ

306
00:18:11,900 --> 00:18:13,650
.وفزت

307
00:18:15,400 --> 00:18:17,650
...لقد نُفيت

308
00:18:17,650 --> 00:18:18,990
.كلاّ، الأمر ليس كذلك

309
00:18:19,240 --> 00:18:21,870
.لقد هرب والدي منّي

310
00:18:22,490 --> 00:18:25,950
.ماذا؟ الطّبخ أمر سهل

311
00:18:26,700 --> 00:18:28,000
...خطوة واحدة فحسب

312
00:18:28,000 --> 00:18:30,580
خطوة صغيرة واحدة هي كلّ ما أحتاجه
.لأتغلّب على خصومي

313
00:18:30,580 --> 00:18:32,880
!أنا أتمتّع بتلك الموهبة

314
00:18:33,090 --> 00:18:34,250
انظروا لهذا؟

315
00:18:34,590 --> 00:18:37,470
نخبة اليابان بأكملها في أكاديميّة النّخبة للطّبخ

316
00:18:37,470 --> 00:18:39,760
.يقفون في حيرة شديدة ويخسرون أمامي

317
00:18:40,550 --> 00:18:44,060
النّخبة؟ الإيمان؟

318
00:18:44,060 --> 00:18:45,010
.هذا هراء

319
00:18:45,010 --> 00:18:46,720
.طهاة بلا قيمة

320
00:18:47,930 --> 00:18:51,600
.ميماساكا سوبارو... أنت مفيد

321
00:18:51,810 --> 00:18:53,440
.اعمل معي

322
00:18:54,360 --> 00:18:56,320
.سأدعك تعيث فسادًا كما يحلو لك

323
00:19:01,490 --> 00:19:03,370
،بهذا الشّوكوغيكي

324
00:19:03,370 --> 00:19:08,830
.يكون ميماساكا سوبارو قد خسر ملكيّته لكلّ هذه الأدوات

325
00:19:09,160 --> 00:19:13,210
يوكيهيرا سوما، أعتقد أنّك تريد إعادة
.كلّ هذه الأدوات لأصحابها الأصليّين

326
00:19:13,540 --> 00:19:14,590
أهذا صحيح؟

327
00:19:14,590 --> 00:19:15,670
!نعم

328
00:19:23,720 --> 00:19:28,100
!ها قد عادت مائة سكّين لصاحبها

329
00:19:28,100 --> 00:19:30,100
.المعذرة يا يوكيهيرا-كُن

330
00:19:30,810 --> 00:19:36,400
.هذا سكّين أمّي. حصلتُ عليه عندما توفّيت

331
00:19:37,190 --> 00:19:38,360
.شكرًا لك

332
00:19:38,360 --> 00:19:40,150
.شكرًا جزيلاً لك

333
00:19:44,200 --> 00:19:45,950
.حان الوقت

334
00:19:45,950 --> 00:19:48,160
.سوف أغادر توتسكي

335
00:19:48,160 --> 00:19:50,370
.لن أطبخ بعد الآن

336
00:19:50,370 --> 00:19:53,370
.لقد تكبّدتُ هزيمة نكراء

337
00:19:53,370 --> 00:19:55,500
—لم يعد هنالك شيء لأفخر بـ

338
00:19:55,750 --> 00:19:57,000
!غبيّ

339
00:19:57,000 --> 00:20:00,340
لماذا وافقت على تحدّي الشّوكوغيكي إذًا؟

340
00:20:01,920 --> 00:20:04,010
تعال، ما الخطب؟

341
00:20:04,010 --> 00:20:05,050
ألن تأخذ سكّينك؟

342
00:20:05,510 --> 00:20:09,310
.إنّه الوحيد المتبقّى يا تاكومي

343
00:20:10,810 --> 00:20:12,190
...ألديني

344
00:20:14,810 --> 00:20:15,940
.يا ميماساكا سوبارو

345
00:20:16,730 --> 00:20:18,520
.لقد خسرت أمامك

346
00:20:18,520 --> 00:20:19,610
.كانت هزيمة ساحقة

347
00:20:20,230 --> 00:20:22,360
!لكنّي لن أخسر المرّة القادمة

348
00:20:22,780 --> 00:20:25,160
،إن كنتَ تسبقني بخطوة واحدة

349
00:20:25,160 --> 00:20:27,580
!فسأسبقك بخطوتين... بل عشرة... مائة خطوة

350
00:20:27,910 --> 00:20:29,740
.لن أسمح للأمور أن تنتهي هكذا

351
00:20:29,740 --> 00:20:31,200
!هل تسمعني يا ميماساكا؟

352
00:20:33,500 --> 00:20:35,710
.أمسى الميزّالونا ملكًا ليوكيهيرا الآن

353
00:20:36,130 --> 00:20:38,170
.سوف أسترجعه يومًا ما

354
00:20:38,170 --> 00:20:40,130
!بعد أن أفوز بتحدّي شوكوغيكي ضدّك

355
00:20:41,010 --> 00:20:42,880
!أبقه في مأمن حتّى ذلك الحين

356
00:20:45,220 --> 00:20:46,300
أرأيت؟

357
00:20:46,890 --> 00:20:49,470
إنّ من يسعون ليكونوا طهاة محترفين

358
00:20:49,970 --> 00:20:52,180
.جميعهم أشخاص لا يرضون بالهزيمة

359
00:20:52,930 --> 00:20:54,640
.اسمع يا ميماساكا

360
00:20:54,980 --> 00:21:00,780
لا تحاول أبدًا أن تسلب كبرياء خصمك
.بالكامل في مباراة واحدة ثانية

361
00:21:01,320 --> 00:21:03,740
حتّى إن كان كلّ الفخر والثّقة اللّذين
جمعتهما خلال سنواتٍ عديدة

362
00:21:03,740 --> 00:21:06,030
...قد دُمّرا إلى أشلاء بسبب فشل كبير

363
00:21:06,660 --> 00:21:09,700
...حتّى إن مررتَ بتجارب تحطّمك من الدّاخل

364
00:21:10,030 --> 00:21:12,870
.فما زال عليك أن تفتح محلّك في اليوم التّالي

365
00:21:14,160 --> 00:21:15,960
.هذا هو ما يعنيه أن تكون طاهيًا

366
00:21:16,670 --> 00:21:17,920
أولست كذلك؟

367
00:21:18,920 --> 00:21:19,840
يا ميماساكا؟

368
00:21:21,210 --> 00:21:25,720
أيخبرني أن أستمرّ في الطّبخ رغم طبيعتي؟

369
00:21:28,680 --> 00:21:31,560
...قلبي القاسي والبارد

370
00:21:33,640 --> 00:21:35,770
.أمسى رقيقًا ثانية

371
00:21:37,060 --> 00:21:40,310
!لديّ بشرة كالفتيات

372
00:21:42,070 --> 00:21:45,190
قرّر وضع حياته كطاهٍ على المحكّ

373
00:21:45,190 --> 00:21:47,700
،ليوصل رسالة عن قلب صفحة جديدة
حتّى في حالة الخسارة؟

374
00:21:48,030 --> 00:21:50,070
.لا يبدو لي هذا منطقيًّا كثيرًا

375
00:21:50,070 --> 00:21:51,700
.نعم، معك حقّ

376
00:21:51,990 --> 00:21:53,790
.لكنّه أمر سيقوم به سوما-كُن

377
00:21:54,950 --> 00:21:56,460
.اسمعي يا ناكيري

378
00:21:56,460 --> 00:21:58,620
.لقد تمكّنتُ من الوصول لهذه المرحلة

379
00:21:58,920 --> 00:22:02,590
خطوة واحدة أخرى وأصل حيث أستطيع مواجهتك

380
00:22:02,840 --> 00:22:04,210
.على مقعد الأفضل في السّنة الأولى

381
00:22:05,380 --> 00:22:06,760
.الزم حدودك

382
00:22:07,470 --> 00:22:10,090
!مستواي أنا أبعد وأعلى منك بكثير

383
00:23:43,230 --> 00:23:44,360
...وأيضًا

384
00:23:44,940 --> 00:23:47,190
.لا تنسَ أن تحضر لي ذلك الكتاب

385
00:23:48,070 --> 00:23:52,910
!سننتقل الآن للجولة الثّانية من نصف النّهاية

386
00:23:53,530 --> 00:23:59,450
!لدينا المتنافس كوروكيبا ريو والمتنافس هاياما أكيرا

387
00:24:06,250 --> 00:24:09,420
."في الحلقة القادمة: "وحوش تلتهم بعضها