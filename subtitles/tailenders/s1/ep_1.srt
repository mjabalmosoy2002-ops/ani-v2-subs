1
00:00:17,030 --> 00:00:21,830
،تيرولوس: كوكبٌ يشهد انقلابًا بيئيًّا سريعًا

2
00:00:21,830 --> 00:00:26,580
نتج عن آلة تهيئةٍ بيئيةٍ معطوبة
كان المراد منها استصلاح الكوكب

3
00:00:26,580 --> 00:00:31,130
،عاثت ظاهرة "التَّدافع" فسادًا في الكوكب منذ قرون

4
00:00:32,510 --> 00:00:36,550
مسببةً تشوُّهاتٍ تكتونيَّةً وتغيُّراتٍ
مناخيَّةً حادةً وطفراتٍ في الحياة البريَّة

5
00:00:36,550 --> 00:00:40,010
ولمَّا عجزت البشرية عن الاستقرار في
هذه الظُّروف القاسية التي لا تُحتمل

6
00:00:40,010 --> 00:00:43,020
طوَّرت مدنًا ضخمةً متحرِّكةً على عجلاتٍ للعيش فيها

7
00:00:45,100 --> 00:00:48,900
!طال تحديقي في ظهرك

8
00:00:49,360 --> 00:00:53,530
‫أيُّها الملك الخاسر -لترقد روحك بسلام-
‫هذا هو اليوم الذي سأتفوَّق فيه عليك

9
00:00:54,740 --> 00:00:56,660
!ابتعد عن طريقي أيُّها المتذيِّل

10
00:00:58,490 --> 00:01:02,580
!شيرو! اقتفِ خطى شبح البطل

11
00:01:03,660 --> 00:01:05,920
تجاوز المتسابقون العمود السابع

12
00:01:05,920 --> 00:01:06,710
!هذا لا يُبشّر بالخير أيُّها العجوز

13
00:01:07,080 --> 00:01:08,250
!المحرّك على وشك الانفجار

14
00:01:08,250 --> 00:01:09,590
!ماذا؟

15
00:01:09,840 --> 00:01:10,750
!شيرو

16
00:01:10,750 --> 00:01:12,090
!اخرس

17
00:01:12,090 --> 00:01:13,970
!هيهات أن أتوقَّف وقد غدوتُ قاب قوسين أو أدنى

18
00:01:16,220 --> 00:01:18,090
لا تتهوَّر يا شيرو

19
00:01:18,090 --> 00:01:18,890
!ماذا قلت؟

20
00:01:19,390 --> 00:01:21,310
أقصد أنَّ هذا أبعد من نجوم السَّماء عن أمثالك

21
00:01:21,970 --> 00:01:25,350
!أيُّها الوغد غودسبيد

22
00:01:29,270 --> 00:01:33,820
أحيّيك على وصولك إلى هنا بذلك المحرّك البائس

23
00:01:33,820 --> 00:01:38,320
غير أنَّ الفوز السَّاحق اليوم سيكون
!حليف المتسابق المتكامل وحده

24
00:01:38,780 --> 00:01:40,070
!اخرس

25
00:01:42,580 --> 00:01:44,830
،على أيِّ حال، حسب ذلك المنطق

26
00:01:44,830 --> 00:01:47,330
!سأفوز حتمًا

27
00:01:47,330 --> 00:01:48,540
!كلَّا، الفوز لي

28
00:01:48,540 --> 00:01:50,540
سيمرُّ المتسابقون بالعمود الثامن خلال ثوانٍ قليلة

29
00:01:54,210 --> 00:01:55,840
هذا سيّئٌ أيُّها العجوز

30
00:01:55,840 --> 00:01:58,260
إنَّهم يتوقَّعون حدوث تدافعٍ من المستوى الرابع

31
00:01:58,260 --> 00:02:01,100
قد نضطرُّ إلى إلغاء السِّباق

32
00:02:01,100 --> 00:02:02,850
!ليستمرَّ السِّباق

33
00:02:02,850 --> 00:02:07,140
مَن وُلد وترعرع في أوركس، لن
!تروِّعه نتوءات الطَّريق الطبيعية

34
00:02:07,140 --> 00:02:08,690
!سنفوز بهذا السِّباق

35
00:02:08,690 --> 00:02:10,100
!حـ-حاضر

36
00:02:10,730 --> 00:02:11,610
!شيرو

37
00:02:11,610 --> 00:02:12,690
!نلتُ منك

38
00:02:12,690 --> 00:02:16,110
اليومَ سيتحطَّم رقم الخاسر
القياسي العظيم الصامد منذ مئة عام

39
00:02:23,580 --> 00:02:25,700
!ضرب التَّدافع

40
00:02:26,580 --> 00:02:27,620
!وإنَّه هائل

41
00:02:52,100 --> 00:02:58,530
!ليس هذا خطَّ نهايتي

42
00:03:05,950 --> 00:03:08,330
ألم يكن ذلك مؤسفًا؟

43
00:03:08,330 --> 00:03:10,120
لا أتَّفق معك

44
00:03:12,290 --> 00:03:14,500
الملك... الخاسر

45
00:03:16,340 --> 00:03:17,510
هذه ليست النهاية بعد

46
00:03:17,510 --> 00:03:18,670
!ما زال بوسعي فعلها

47
00:03:18,670 --> 00:03:20,510
...دعوني

48
00:03:20,510 --> 00:03:25,760
!دعوني أسابق

49
00:03:38,030 --> 00:03:41,070
توقَّف قلبه تمامًا

50
00:03:42,070 --> 00:03:43,610
...أظنُّ أنَّ هذا يعني

51
00:03:43,610 --> 00:03:46,200
!إيَّاك أن تنطق بها! ما زال حيًّا

52
00:03:48,410 --> 00:03:52,210
حتَّى أوركس لم تسلم من التَّدافع

53
00:03:52,210 --> 00:03:53,920
لن نصمد طويلًا هنا

54
00:03:53,920 --> 00:03:56,290
شرعت المناطق الطبيَّة الأخرى في الإخلاء بالفعل

55
00:03:56,290 --> 00:03:58,630
!لا يسعنا أن نتركه على هذه الحال

56
00:03:58,630 --> 00:03:59,840
!ابذل كلَّ ما في وسعك

57
00:04:02,510 --> 00:04:03,840
...شيرو

58
00:04:03,840 --> 00:04:05,720
عد إلينا قريبًا

59
00:04:06,470 --> 00:04:11,390
يسهل إصلاح السيارة ولكن
لا جدوى منها دونكَ وأنتَ سائقها

60
00:04:17,020 --> 00:04:18,320
!مرحبًا

61
00:04:18,320 --> 00:04:20,150
مـ-مَن أنتما؟

62
00:04:20,150 --> 00:04:21,490
!إنَّنا في منتصف عمليةٍ جراحيَّة

63
00:04:24,660 --> 00:04:26,280
أُخضِعا

64
00:04:26,280 --> 00:04:27,700
أحسنتَ صنعًا

65
00:04:30,120 --> 00:04:32,580
أمتأكدةٌ أنَّكِ لا تريدين ملاحقة غودسبيد؟

66
00:04:32,580 --> 00:04:36,000
لا أريد أن أضطرَّ إلى التعامل مع رجلٍ متزوِّج

67
00:04:36,000 --> 00:04:39,590
لن يركب معي إلا مَن كان صلبًا وعنيدًا لا ينكسر

68
00:04:39,590 --> 00:04:41,840
سمعتُ أنَّ الأسطورة كان على الشَّاكلة نفسها

69
00:04:41,840 --> 00:04:43,130
فلتصمت

70
00:04:43,130 --> 00:04:44,340
لا داعي للعجلة

71
00:04:48,260 --> 00:04:49,560
...والآن

72
00:04:51,100 --> 00:04:53,270
يا لها من غرفةٍ رائعة

73
00:04:53,270 --> 00:04:58,270
أقصد أنَّه ليس بالمكان الرَّديء لقضاء اللحظات الأخيرة

74
00:04:58,560 --> 00:05:00,360
كنتَ قاب قوسين أو أدنى
ومع ذلك نأى عنك المراد

75
00:05:00,360 --> 00:05:05,740
لو تقدَّمتَ قليلًا بعد، لحطَّمتَ الرقم القياسي
المئوي الذي لا يُقهر

76
00:05:05,740 --> 00:05:09,070
للمتسابق الأسطوري، الملك الخاسر

77
00:05:10,280 --> 00:05:14,580
لو لم يُقاطَع السِّباق، لكنتَ قد تفوَّقتَ عليه

78
00:05:14,580 --> 00:05:15,870
يا للأسف

79
00:05:15,870 --> 00:05:18,290
لن يجدي هذا المحرِّك نفعًا بعد الآن

80
00:05:18,290 --> 00:05:21,880
ألا تريد محرِّكًا أفضل؟

81
00:05:21,880 --> 00:05:23,800
سأمنحك أفضل محرِّكٍ على الإطلاق

82
00:05:24,630 --> 00:05:26,180
...أمَّا بخصوص المقابل

83
00:05:26,180 --> 00:05:28,800
...حسنًا، دعني أفكر

84
00:05:29,970 --> 00:05:32,310
ما رأيك بحياتك مقابلًا؟

85
00:05:33,970 --> 00:05:36,310
ليست صفقةً سيّئة، ألا توافقني؟

86
00:05:40,230 --> 00:05:42,610
لا تتحمَّس كثيرًا للعودة إلى السِّباق

87
00:05:43,610 --> 00:05:48,740
!إذا كنتَ تريد المضيَّ قدمًا، فسأمنحك قوةً جديدة

88
00:05:48,740 --> 00:05:53,240
!والآن، استفق! استفق بقوة محرِّكي توموي

89
00:05:53,240 --> 00:05:55,830
!سأمنحك القوَّة

90
00:05:55,830 --> 00:05:57,250
!استفق يا توموي شيرو

91
00:05:57,670 --> 00:05:58,750
!استفق

92
00:06:13,850 --> 00:06:14,970
...ما هذا الذي

93
00:06:17,230 --> 00:06:18,690
صباح الخير يا شيرو

94
00:06:18,690 --> 00:06:21,810
هل من تعليقٍ على مدى قوَّة نبضات محرِّك توموي؟

95
00:06:22,310 --> 00:06:27,570
!أُدعى ميكاجورا توموي وأنا والدتك الجديدة

96
00:06:27,570 --> 00:06:29,610
ماذا؟ لا أرى أمارات السَّعادة على وجهك

97
00:06:31,620 --> 00:06:35,950
كما وعدتك، هذا أفضل محرِّكٍ قد تحصل عليه

98
00:06:35,950 --> 00:06:38,830
ولكنَّه يؤدِّي وظيفة قلبك أيضًا

99
00:06:41,080 --> 00:06:43,170
هلَّا نشارك في سباقٍ معيَّن

100
00:07:02,100 --> 00:07:04,150
وصلت

101
00:07:04,900 --> 00:07:06,650
ها قد أتت المدينة المستضيفة

102
00:07:07,740 --> 00:07:09,280
آنا بيرينا

103
00:07:09,280 --> 00:07:12,160
المدينة المتحرِّكة الأخيرة التي
لا تعرف سوى الانطلاق قدمًا

104
00:07:14,200 --> 00:07:16,580
ويا له من جمهورٍ غفيرٍ يبدأ بالاحتشاد

105
00:07:16,580 --> 00:07:20,160
عجبًا! تلك السيارة هناك كلاسيكيةٌ حقيقيَّة

106
00:07:20,160 --> 00:07:21,710
...انظر يا شيرو

107
00:07:21,710 --> 00:07:24,670
ابتلع التَّدافع أوركس

108
00:07:24,670 --> 00:07:27,670
لم يعد بمقدوري التفوُّق على الخاسر هناك

109
00:07:27,670 --> 00:07:30,170
ليس لي سوى هذا السِّباق

110
00:07:30,170 --> 00:07:33,590
!سباق إعادة تطوير الكوكب

111
00:07:33,590 --> 00:07:37,260
!أنصتوا إليَّ أيُّها الحمقى الجسورون

112
00:07:37,260 --> 00:07:41,600
!ستتسابقون في جراوند إنديا من أجل جائزةٍ ضخمة

113
00:07:41,600 --> 00:07:45,190
سباق إعادة تطوير الكوكب في جراوند إنديا؟

114
00:07:45,190 --> 00:07:49,740
أجل، نتَّجه إلى هناك الآن

115
00:07:49,740 --> 00:07:53,200
إنَّها إحدى الأراضي الـ 26 غير المُستكشفة على الكوكب

116
00:07:53,200 --> 00:07:57,410
أرى أنَّ علينا شقَّ طريقنا عبر
أعماقها للوصول إلى الجنوب

117
00:07:57,410 --> 00:07:59,750
تلك نقطة الانطلاق لهذا السِّباق

118
00:08:00,910 --> 00:08:06,250
السِّباق الذي اختفى فيه الملك
الخاسر منذ أكثر من مئة عام

119
00:08:06,920 --> 00:08:10,670
لا تشبه أبدًا ذلك الرجل الذي كان يتذمَّر منذ لحظات

120
00:08:10,670 --> 00:08:15,760
يجب أن تزرع هذا في آلة التهيئة
البيئيَّة القابعة في قلب إنديا

121
00:08:17,850 --> 00:08:22,060
مَن يزرع جهاز إرساله أولًا يفز

122
00:08:22,060 --> 00:08:22,850
تمهَّلي قليلًا

123
00:08:23,440 --> 00:08:26,940
ألم يكن الهدف الأساسي للمدن المتحرِّكة على عجلاتٍ
إبعادنا عن آلة التهيئة البيئيَّة قدر الإمكان؟

124
00:08:26,940 --> 00:08:30,730
من الحماقة جعل ذلك المكان الهدف

125
00:08:30,730 --> 00:08:33,280
ألم يكن اللقب "المُتذيِّلون"؟

126
00:08:33,280 --> 00:08:34,910
أتسمِّي هذه حماقة؟

127
00:08:34,910 --> 00:08:41,040
،إذًا لتتفوَّق على أسطورة الملك الخاسر
لا بدَّ أن تصبح أكثر حماقةً منه

128
00:08:43,080 --> 00:08:46,420
ما غايتكِ الحقيقيَّة على أيَّة حال؟

129
00:08:46,960 --> 00:08:48,670
وضِّح ما تقصده

130
00:08:48,670 --> 00:08:50,550
...جائزةٌ ماليةٌ ضخمة

131
00:08:50,550 --> 00:08:55,340
فضلًا عن أنَّ مستضيف السِّباق لا يبتغي سوى
شقِّ طريقٍ عبر الأراضي غير المُستكشفة

132
00:08:55,340 --> 00:08:56,590
بيد أنَّ هذا ليس ما تسعين إليه

133
00:08:56,590 --> 00:08:57,510
!ما أشدَّ فطنتك

134
00:08:57,510 --> 00:08:59,640
اصمت وركِّز على القيادة

135
00:09:00,930 --> 00:09:02,220
لعلَّني أسعى وراء المال حقًّا

136
00:09:02,220 --> 00:09:03,640
فأنت لم تدفع ثمن جراحتك بعد

137
00:09:04,600 --> 00:09:08,190
ألم تعبثي بجسدي من أجل مصالحكِ الأنانيَّة فحسب؟

138
00:09:10,190 --> 00:09:16,910
من الرَّائع أن نوسِّع آفاقنا في
الأراضي غير المُستكشفة

139
00:09:16,910 --> 00:09:18,450
اصمتي

140
00:09:18,450 --> 00:09:21,700
،إذا كانت هذه نيَّتكِ الحقيقيَّة
فامضي قدمًا من دوني

141
00:09:23,080 --> 00:09:25,210
لا معنى للمضيِّ قدمًا من دونك

142
00:09:27,500 --> 00:09:32,210
هدفي سحق آلة التهيئة البيئيَّة بمحرِّكي توموي

143
00:09:32,210 --> 00:09:38,090
سأسحق تلك الآلة اللعينة المتسبِّبة
في كلِّ هذه التقلُّبات البيئيَّة

144
00:09:38,090 --> 00:09:40,100
بضربةٍ واحدةٍ من محرِّكي توموي

145
00:09:48,730 --> 00:09:53,690
لن ينال لقب الأسطورة إلا مَن يُسقط الجدار أولًا

146
00:09:53,690 --> 00:09:57,700
ولو كان الموت ينتظره في الجانب الآخر

147
00:10:00,950 --> 00:10:02,370
ألم أقل لك هذا آنفًا؟

148
00:10:02,370 --> 00:10:06,660
يؤدِّي محرِّك توموي وظيفة قلبك ومحرِّك سيارتك أيضًا

149
00:10:06,660 --> 00:10:09,080
ما الخطب؟ لا تبدو بخير

150
00:10:09,080 --> 00:10:09,960
لا شيء

151
00:10:10,880 --> 00:10:13,750
أتحرَّق شوقًا لبدء السِّباق لا غير

152
00:10:13,750 --> 00:10:16,170
أسرَع، أسرَع

153
00:10:16,170 --> 00:10:18,630
هؤلاء هم المُتذيِّلون

154
00:10:18,630 --> 00:10:20,970
هذا سباق إعادة تطوير الكوكب

155
00:10:21,760 --> 00:10:24,560
السِّباق الذي عجز الملك الخاسر حتَّى عن إكماله

156
00:10:24,560 --> 00:10:26,480
وسأكون أوَّل مَن يعبر خطَّ النهاية ذاك

157
00:10:27,730 --> 00:10:30,900
أريد رؤية صنيعك ذاك، فلا
تحرمني من مشاهدته هذه الكرَّة

158
00:10:35,610 --> 00:10:36,530
أهذا أحد معارفك؟

159
00:10:36,860 --> 00:10:37,690
كلَّا

160
00:10:40,950 --> 00:10:42,530
حسنًا، ها قد بدأ السّباق

161
00:10:57,460 --> 00:10:59,680
تدافع؟ لماذا الآن؟

162
00:10:59,680 --> 00:11:01,590
أيبدو هذا المشهد مألوفًا لديك؟

163
00:11:01,590 --> 00:11:04,510
تبًّا! التسكُّع هنا بالغ الخطورة

164
00:11:04,510 --> 00:11:05,810
كيف جزمتَ بذلك؟

165
00:11:05,810 --> 00:11:06,560
!حدسي

166
00:11:06,560 --> 00:11:07,560
فهمت

167
00:11:29,580 --> 00:11:30,830
...أسلوب القيادة ذاك

168
00:11:30,830 --> 00:11:32,290
محالٌ أن يكون مَن أظنُّه

169
00:11:40,510 --> 00:11:41,680
!تبًّا

170
00:11:42,930 --> 00:11:45,970
!هيَّا

171
00:11:45,970 --> 00:11:46,850
!رائع

172
00:11:48,720 --> 00:11:51,190
سحقًا، كانت بدايتنا بطيئة

173
00:11:51,190 --> 00:11:52,850
!بدت لي مقبولةً إلى حدٍّ كبير

174
00:11:53,230 --> 00:11:54,310
كيف ذلك؟

175
00:12:09,830 --> 00:12:11,790
سأدمِّرك

176
00:12:12,160 --> 00:12:14,290
لنحافظ على سلامتنا أيُّها السَّادة

177
00:12:37,730 --> 00:12:40,400
!ما الذي يحدث هنا؟

178
00:12:40,400 --> 00:12:42,990
أهذا أيضًا أحد آثار التَّدافع؟

179
00:12:42,990 --> 00:12:47,280
لمَ آل المآل بآلة التهيئة البيئيَّة إلى
صنع مثل هذه البيئة برأيك؟

180
00:12:47,280 --> 00:12:52,120
لو استبعدنا خروجها عن
السَّيطرة، فلا شكَّ أنَّها تمقتنا بشدَّة

181
00:12:53,830 --> 00:12:54,620
توموي-سان

182
00:12:54,620 --> 00:12:55,670
نعم؟

183
00:12:55,670 --> 00:12:58,750
سأرسل إليكِ بقيَّة بيانات المضمار الآن

184
00:12:58,750 --> 00:13:00,340
!عُلم

185
00:13:00,340 --> 00:13:02,800
كما أنَّ ثمة اسمًا يجب أن تنتبهي
إليه في قائمة المتسابقين

186
00:13:02,800 --> 00:13:04,130
ما هذا الهراء؟

187
00:13:04,130 --> 00:13:08,390
!لم تذكر بياناتي شيئًا عن عائقٍ كهذا

188
00:13:08,890 --> 00:13:11,270
إنَّها بياناتٌ قديمةٌ تعود إلى مئة عامٍ مضت

189
00:13:11,270 --> 00:13:13,810
أرى أن نلتفَّ حوله

190
00:13:13,810 --> 00:13:15,230
!سنخترقه

191
00:13:15,230 --> 00:13:16,310
ماذا قلت؟

192
00:13:16,770 --> 00:13:18,610
أليس هذا بديهيًّا؟

193
00:13:18,610 --> 00:13:22,940
!لن أتفوَّق على الملك الخاسر لو سلكتُ طريقًا ملتويًا

194
00:13:22,940 --> 00:13:24,950
أرى أنَّك لم تتغيَّر

195
00:13:25,280 --> 00:13:27,950
!ظهر غودسبيد في لوحة المُتصدِّرين يا شيرو

196
00:13:28,410 --> 00:13:30,160
!أتمزحين معي؟

197
00:13:30,160 --> 00:13:31,950
...صدق حدسي، أنت

198
00:13:33,500 --> 00:13:34,960
!غودسبيد

199
00:13:41,000 --> 00:13:42,500
!أيُّها الوغد! أهذا حقيقي؟

200
00:13:42,500 --> 00:13:45,470
مُنحتُ هذا الجسد مقابل حياتي

201
00:13:46,170 --> 00:13:48,890
...ولكنِّي لا أندم على ذلك

202
00:13:48,890 --> 00:13:53,060
إذ بات بمقدوري التَّسابق جنبًا
إلى جنبٍ معك هكذا

203
00:13:53,060 --> 00:13:54,020
!أرني ما عندك

204
00:13:54,020 --> 00:13:54,470
!شيرو

205
00:13:55,390 --> 00:13:56,180
!ماذا؟

206
00:14:00,980 --> 00:14:04,530
!ارقدا في سبات! فقد عفا عليكما الزَّمن

207
00:14:07,400 --> 00:14:08,700
!يا لهما من أحمقَين

208
00:14:08,700 --> 00:14:10,320
ماذا يظنَّان أنَّهما يفعلان؟

209
00:14:10,320 --> 00:14:12,030
إلى أين ذهب غودسبيد؟

210
00:14:12,450 --> 00:14:15,200
!باغتهما بجولةٍ أخرى يا أخي

211
00:14:20,500 --> 00:14:22,920
ما هذا؟ متى سبقنا بكلِّ هذه المسافة؟

212
00:14:31,350 --> 00:14:33,560
!تمسَّكي بشدَّة

213
00:14:43,070 --> 00:14:44,610
...هـ-هذه

214
00:14:49,280 --> 00:14:50,410
!مدينةٌ متحرِّكةٌ على عجلات

215
00:14:50,410 --> 00:14:52,120
ماذا تفعل في مكانٍ كهذا؟

216
00:14:54,160 --> 00:14:59,830
لم تُبنَ الحضارة المتحرِّكة على عجلاتٍ
من أجل تفادي التَّدافعات فحسب

217
00:14:59,830 --> 00:15:04,630
في الأصل، حاولت البشريَّة استخدام المدن
المتحرِّكة على عجلاتٍ مرارًا لإزالة آلة التهيئة البيئيَّة

218
00:15:04,630 --> 00:15:07,260
...بيد أنَّ الأضرار والخسائر البشريَّة تجاوزت كلَّ الحدود

219
00:15:07,260 --> 00:15:11,550
وفي النهاية، تخلَّت البشريَّة المُنهكة عن
جهودها المستمرَّة في الاقتلاع

220
00:15:13,680 --> 00:15:18,100
‫وبعد مرور قرون، بات سكان المدن المتحرِّكة
‫على عجلاتٍ يصفون التَّفادي بأنَّه "تقدُّم"

221
00:15:18,100 --> 00:15:22,350
،لهذا حينما نسير عكس التَّيار
يطالبنا الناس بمواكبة العصر

222
00:15:24,190 --> 00:15:25,400
لهذا نمثِّل آخر المتسابقين

223
00:15:25,400 --> 00:15:27,650
ولهذا نُعرف بالمُتذيِّلين

224
00:15:41,040 --> 00:15:42,710
لا أحد هنا

225
00:15:42,710 --> 00:15:45,880
أظنُّ أنَّ الجميع سلكوا الطريق المنطقي

226
00:15:45,880 --> 00:15:49,210
لا يجرؤ على سلوك هذا الطريق إلا الحمقى أمثالنا

227
00:15:54,510 --> 00:15:57,430
مَن يشقُّ طريقه عبر الجبل؟ أعساه غودسبيد؟

228
00:15:57,720 --> 00:15:59,770
كلَّا، ليس هذا فعلي

229
00:15:59,770 --> 00:16:01,270
!ماذا؟

230
00:16:05,190 --> 00:16:06,310
!غودسبيد

231
00:16:07,440 --> 00:16:09,530
،لستُ أدري مَن يسبِّب لك المتاعب

232
00:16:09,530 --> 00:16:12,110
لكن بفضله، لحقتُ بك بلا عناء

233
00:16:12,110 --> 00:16:14,820
لستُ متفرِّغًا للهو معك الآن

234
00:16:14,820 --> 00:16:15,950
!ما كان ذلك؟

235
00:16:15,950 --> 00:16:17,780
هيناموتو إيزو

236
00:16:17,780 --> 00:16:21,250
معلِّمي الذي أكمل السِّباق في جراوند جوليت

237
00:16:23,580 --> 00:16:27,840
يبدو أنَّ ورثة الأسطورة قد احتشدوا هنا

238
00:16:31,840 --> 00:16:36,430
!يحتفل البركان بفوزي

239
00:16:40,430 --> 00:16:42,430
أظنُّك توموي شيرو

240
00:16:42,430 --> 00:16:44,310
أنت الرجل الذي كاد يلقى حتفه في أوركس

241
00:16:44,310 --> 00:16:47,560
ما زلتَ غضًّا وقليل الخبرة بمئة عامٍ لتتحدَّى الأسطورة

242
00:16:47,560 --> 00:16:48,150
!اخرس

243
00:16:48,570 --> 00:16:53,360
تغيَّرتُ عمَّا كنتُ عليه سابقًا
بل وعمَّا كنته قبل لحظات

244
00:16:53,360 --> 00:16:54,820
!ويعود كلُّ الفضل لهذا

245
00:16:55,490 --> 00:16:57,320
محرِّكٌ داخل صدرك إذًا؟

246
00:16:57,780 --> 00:16:59,700
!سأدمِّره

247
00:17:06,370 --> 00:17:07,330
!معلِّمي

248
00:17:07,920 --> 00:17:10,880
لن تتفوَّق على الأسطورة دون أن تعقد
العزم على التضحية بكلِّ شيء

249
00:17:10,880 --> 00:17:14,010
ماذا تبقَّى لي لأتخلَّى عنه؟

250
00:17:14,340 --> 00:17:16,760
!استفتِ أعماق قلبك

251
00:17:23,770 --> 00:17:24,980
ما هذا؟

252
00:17:25,350 --> 00:17:26,650
أظنُّ أنَّ دوري قد حان الآن

253
00:17:26,650 --> 00:17:28,020
!أحسنتِ صنعًا يا توموي

254
00:17:28,810 --> 00:17:30,650
لن يجدينا هذا نفعًا

255
00:17:30,650 --> 00:17:32,820
لا بدَّ من وجود سبيلٍ للتخلُّص من هذا الرجل

256
00:17:32,820 --> 00:17:33,780
...أعتقد أنَّ ثمة سبيلًا واحدًا

257
00:17:33,780 --> 00:17:35,240
!نفِّذيه بسرعةٍ إذًا

258
00:17:34,650 --> 00:17:36,660
!لا تستهن بي

259
00:17:36,660 --> 00:17:38,820
!أيُّها المتسابق السَّاذج

260
00:17:46,040 --> 00:17:47,670
!بات هذا لي الآن

261
00:17:53,840 --> 00:17:55,010
!مستحيل

262
00:17:55,010 --> 00:17:57,180
!انتزعتُ المحرِّك

263
00:17:57,180 --> 00:17:58,800
أنَّى لك القدرة على مواصلة التقدُّم هكذا؟

264
00:17:58,800 --> 00:18:02,930
!وما بال هذه السُّرعة؟

265
00:18:12,820 --> 00:18:14,900
مـ-ما هذا؟

266
00:18:14,900 --> 00:18:18,200
انتزع محدِّد السُّرعة لمحرِّك توموي فحسب

267
00:18:18,200 --> 00:18:19,160
يا له من أحمق

268
00:18:19,780 --> 00:18:22,240
،كسبنا وقتًا بفضله

269
00:18:22,240 --> 00:18:25,330
لأنَّ إزالة المحدِّد باتت ضروريةً من الآن فصاعدًا

270
00:18:26,040 --> 00:18:29,210
أرى أنَّ كلَّ تفصيلةٍ صغيرةٍ تسير وفقًا لحساباتكِ

271
00:18:29,210 --> 00:18:30,630
أتخفين أسرارًا أخرى في جعبتكِ؟

272
00:18:31,880 --> 00:18:35,090
مقعدي هو الوحيد في هذه السيارة المزوَّد بنظام قذف

273
00:18:36,920 --> 00:18:38,170
ممتاز

274
00:18:39,680 --> 00:18:40,550
غودسبيد

275
00:18:42,050 --> 00:18:43,050
سأشقُّ طريقي عبر هذا

276
00:18:43,850 --> 00:18:47,020
تلتهم النيران مقعدي في هذه اللَّحظة فعليًّا

277
00:18:47,640 --> 00:18:51,310
!سنعرف مَن الأسرع حقًّا الآن يا شيرو

278
00:18:54,770 --> 00:18:55,820
يا للندم

279
00:19:07,370 --> 00:19:09,500
!سنخرج عن نطاق التغطية اللاسلكيَّة عمَّا قريب

280
00:19:09,500 --> 00:19:11,000
سأغلق خطوط الاتِّصالات

281
00:19:11,000 --> 00:19:11,830
!توموي-سان

282
00:19:12,630 --> 00:19:16,340
لا تقلق، فهذا عينُ ما حدث قبل قرنٍ من الزَّمن

283
00:19:17,920 --> 00:19:18,920
كوني بخير

284
00:19:18,920 --> 00:19:20,130
شكرًا لك

285
00:19:22,050 --> 00:19:25,850
هذه المرة الأولى التي تشكرينني فيها

286
00:19:30,810 --> 00:19:33,940
!هذه آلةُ التهيئة البيئيَّة لإنديا

287
00:19:35,320 --> 00:19:36,150
!ما هذا؟

288
00:19:38,690 --> 00:19:41,360
لـ-لا أشعر أنِّي أتقدَّم إلى الأمام على الإطلاق

289
00:19:42,410 --> 00:19:44,870
أأنا أحلم؟

290
00:19:44,870 --> 00:19:48,700
أترى ذلك يا شيرو؟

291
00:19:49,540 --> 00:19:51,160
!ذلك الظَّهر

292
00:20:03,090 --> 00:20:04,550
...لا يعقل

293
00:20:04,550 --> 00:20:06,260
...ولكنَّ ذلك الظَّهر

294
00:20:10,810 --> 00:20:12,390
...ذلك الخاسر

295
00:20:12,390 --> 00:20:13,810
!الملك الخاسر

296
00:20:15,690 --> 00:20:19,610
أدركني أحدهم أخيرًا

297
00:20:19,610 --> 00:20:20,650
!مستحيل

298
00:20:20,650 --> 00:20:23,320
لا شكَّ أنَّ أحدهم قد وضع لنا سائقًا شبحًا

299
00:20:24,030 --> 00:20:27,370
!هذا ليس سائقًا شبحًا

300
00:20:27,370 --> 00:20:28,330
معك حق

301
00:20:28,330 --> 00:20:31,200
إنَّه بشحمه ولحمه

302
00:20:31,660 --> 00:20:35,460
يبدو أنَّكِ لم تتعلَّمي شيئًا يا ميكاجورا

303
00:20:35,460 --> 00:20:38,460
صادف أنَّ وجهتنا واحدة ليس إلا

304
00:20:38,460 --> 00:20:39,340
،ولكن أيُّها الخاسر

305
00:20:39,920 --> 00:20:44,380
تشبه تلك الهيئة التي اتَّخذتها تمامًا الهيئة
المثاليَّة التي تصوَّرتها لمحرِّكي توموي

306
00:20:44,380 --> 00:20:45,140
!محرِّك توموي؟

307
00:20:45,800 --> 00:20:48,260
!لا تخبريني أنَّكِ كنتِ على درايةٍ بأمر الخاسر

308
00:20:48,260 --> 00:20:50,350
!لماذا لم تخبريني؟

309
00:20:50,350 --> 00:20:52,770
محرِّكٌ يتكيَّف ويتطوَّر مع بيئته

310
00:20:52,770 --> 00:20:54,980
هذا محرِّك توموي

311
00:20:54,980 --> 00:20:57,440
محرِّكٌ لا نهاية لتطوُّره

312
00:20:57,440 --> 00:20:58,900
!وكأنَّني أفهم ما يعنيه ذلك

313
00:20:58,900 --> 00:21:02,110
!أخبرتِني قبل قليلٍ أنَّكِ لا تملكين خفايا أخرى في جعبتكِ

314
00:21:02,110 --> 00:21:03,320
!لا يعقل

315
00:21:04,150 --> 00:21:06,700
!مئة عام! مئة عام

316
00:21:06,700 --> 00:21:10,830
واصل ذلك الرجل القيادة بكلِّ
طاقته القصوى لمدة مئة عام

317
00:21:10,830 --> 00:21:12,120
مئة عام

318
00:21:12,120 --> 00:21:13,200
فهمت

319
00:21:13,200 --> 00:21:15,870
كان الفارق الزمني هائلًا

320
00:21:18,000 --> 00:21:21,170
ليست التغيُّرات البيئيَّة الأثر الوحيد
لآلة التهيئة البيئيَّة في إنديا

321
00:21:21,170 --> 00:21:24,170
كلَّما دنا المرء منها، ازداد تشوُّه نسيج الزَّمكان

322
00:21:24,170 --> 00:21:25,880
محالٌ أن تدنو منها مهما حاولتَ جاهدًا

323
00:21:27,050 --> 00:21:32,060
بمعنى آخر، كلَّما حاولنا الدُّنو
منها، ازداد انفصال العالم عنَّا

324
00:21:32,060 --> 00:21:34,520
!دقائق معدودةٌ استحالت إلى سنين

325
00:21:34,520 --> 00:21:35,690
هذا صحيح

326
00:21:35,690 --> 00:21:40,520
عند الوصول إلى هنا، يتَّضح أنَّ السُّرعة
القصوى ليست سوى مفهومٍ بحدِّ ذاته

327
00:21:40,940 --> 00:21:43,320
!لا، السُّرعة نسبيَّة

328
00:21:43,320 --> 00:21:46,320
!السُّرعة القصوى التي لا مثيل لها لا معنى لها

329
00:21:51,030 --> 00:21:52,580
!شيرو

330
00:21:52,580 --> 00:21:57,460
أنت فريدٌ من نوعك حقًّا أيُّها الخاسر

331
00:21:57,460 --> 00:21:58,750
ومَن عساك تكون؟

332
00:21:58,750 --> 00:22:00,080
توموي شيرو

333
00:22:00,080 --> 00:22:01,460
أنا مَن سيتفوَّق عليك

334
00:22:03,170 --> 00:22:04,550
!يا لها من ثقة

335
00:22:06,010 --> 00:22:07,430
!مذهل

336
00:22:07,430 --> 00:22:09,090
!ما زال بمقدوره زيادة السُّرعة

337
00:22:10,220 --> 00:22:11,810
...يا له من رجل

338
00:22:17,640 --> 00:22:19,270
شكرًا لكِ يا توموي

339
00:22:19,270 --> 00:22:21,480
تمكنتُ من الوصول إلى هنا بفضلكِ

340
00:22:21,480 --> 00:22:23,980
!ليس الوقت مناسبًا لهذا يا شيرو

341
00:22:24,320 --> 00:22:27,530
اعتنِ بها جيدًا يا غودسبيد

342
00:22:27,530 --> 00:22:29,240
!توقَّف يا شيرو

343
00:22:30,410 --> 00:22:31,740
حسنًا

344
00:22:31,740 --> 00:22:35,040
يؤسفني أنَّ رحلتي تنتهي هنا

345
00:22:35,540 --> 00:22:39,290
يكفيني أنِّي رأيتُ ظهوركم من بعيد

346
00:22:40,630 --> 00:22:43,800
يا له من غريب أطوار

347
00:22:45,300 --> 00:22:46,670
أعتذر

348
00:22:46,670 --> 00:22:49,010
اندمج جسدي تمامًا مع الآلة الآن

349
00:22:51,090 --> 00:22:52,050
!لا! لا

350
00:22:53,010 --> 00:22:55,060
!أنت محرِّكي أنا

351
00:22:55,060 --> 00:22:58,310
!طوَّرتُ المحرِّك المثالي أخيرًا

352
00:22:59,350 --> 00:23:02,560
...ستتخلَّى عنِّي كما فعل الخاسر تمامًا يا شيرو

353
00:23:14,740 --> 00:23:16,620
سألحق بك مرارًا وتكرارًا دون كلل

354
00:23:20,040 --> 00:23:24,340
يتحوَّل الطريق الذي سلكته أمس
إلى مسارٍ مجهولٍ تمامًا اليوم

355
00:23:25,000 --> 00:23:28,460
،لكنَّنا سنواصل التقدُّم إلى الأمام ونستكشف خفاياه

356
00:23:28,460 --> 00:23:33,890
ولو رفضتنا آلة التهيئة البيئيَّة

357
00:23:33,890 --> 00:23:35,600
!لم ينتهِ هذا بعد

358
00:23:35,600 --> 00:23:37,220
!ما زلتُ قادرًا على المواصلة

359
00:23:39,850 --> 00:23:44,230
!سأتقدَّم إلى نقطةٍ لم يطأها أحدٌ قبلي قط

360
00:23:54,070 --> 00:24:00,000
!ليس هذا خطَّ نهايتي

361
00:24:10,010 --> 00:24:12,880
!سباق إعادة تطوير الكوكب

362
00:24:12,880 --> 00:24:16,100
أيُّها الحمقى الجسورون القاطنون
في المدن المتحرِّكة على عجلات

363
00:24:16,640 --> 00:24:19,470
!أخطأتُ الوصف، أيُّها الأوغاد التَّافهون

364
00:24:20,680 --> 00:24:25,100
لمَّا عدتُ من إنديا، إذا بمئة عامٍ أخرى قد انقضت

365
00:24:26,110 --> 00:24:33,700
أمَّا غودسبيد، الذي عاد معي، فلم
يسعفه الوقت إلا قليلًا ليلتقي بأحفاده

366
00:24:33,700 --> 00:24:38,830
سمعتُ أنَّ والد شيرو بذل قصارى
جهده لإبقاء أوركس قائمة

367
00:24:40,370 --> 00:24:44,080
ما زالت البشريَّة مقيَّدةً بأغلال آلات التهيئة البيئيَّة

368
00:24:45,630 --> 00:24:50,380
لعلَّ آلات التهيئة البيئيَّة تبحث عن إجابةٍ ما

369
00:24:50,380 --> 00:24:53,010
إجابةٌ عن مدى التغيُّر الذي
تستطيع الكائنات الحيَّة الخضوع له

370
00:24:53,010 --> 00:24:57,720
لن تسمح بالبقاء على قيد الحياة إلا
للقادرين على التكيُّف مع التغيُّرات البيئيَّة

371
00:24:57,720 --> 00:25:01,140
تتقدَّم التكنولوجيا مع اكتشاف آلاتٍ جديدة

372
00:25:01,140 --> 00:25:04,560
‫مخلِّفةً البشريَّة وراءها...

373
00:25:04,560 --> 00:25:08,060
نحن على مشارف الوصول إلى آنا بيرينا يا توموي-سان

374
00:25:09,980 --> 00:25:14,070
!بجدّيّة، يا لك من جريء

375
00:25:15,410 --> 00:25:17,240
طال انتظاري أكثر من اللازم

376
00:25:17,240 --> 00:25:21,080
،لا تنسي أنِّي انتظرتُ مئة عامٍ فحسب
لذا أعتقد أنَّ معاناتكِ كانت أسوأ

377
00:25:26,120 --> 00:25:27,630
...في الحقيقة

378
00:25:27,630 --> 00:25:31,840
أعتقد أنَّ المشكلة أنَّني وكَّلتُ
إلى غيري أداء الجزء الأهم

379
00:25:31,840 --> 00:25:33,970
ماذا؟ ماذا تقصدين؟

380
00:25:33,970 --> 00:25:35,590
لا شيء

381
00:25:40,810 --> 00:25:42,470
!استكشفوا خفايا العالم

382
00:25:42,470 --> 00:25:44,980
!هذا ليس خطَّ نهايتنا

383
00:25:44,980 --> 00:25:48,650
!اجتمعوا أيُّها المُتذيِّلون

384
00:25:49,650 --> 00:25:55,950
ليس أمامنا -نحن الملاحقين- إلا القفز
فوق الجدران ذاتها برشاقةٍ أكبر

385
00:25:55,950 --> 00:25:59,570
كي نصطفَّ جميعًا يومًا ما عند خطِّ البداية نفسه