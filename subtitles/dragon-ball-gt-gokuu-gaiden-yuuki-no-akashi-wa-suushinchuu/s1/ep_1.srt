1
00:00:05,990 --> 00:00:09,300
.شيئاً فشيئاً, أصبحتُ مسحوره

2
00:00:09,650 --> 00:00:13,400
.بواسطة وجهِك المُبتسم والمُبهر

3
00:00:13,650 --> 00:00:19,000
.دعنا نقفزُ خارج هذا الظلام اللانهائي

4
00:00:19,320 --> 00:00:23,890
.أمسكْ بيديّ

5
00:00:28,080 --> 00:00:31,440
,عندما صادفْتُك أولاً

6
00:00:31,780 --> 00:00:40,820
.تذكّرت ذلك المكان, عندما كنت طفلاً, وأنا أحمِلُ عزيزاً

7
00:00:41,320 --> 00:00:45,950
,ألن ترقُص معيّ

8
00:00:46,000 --> 00:00:49,500
على طريق مُلتويّ من الضوء والظلّ ؟

9
00:00:49,990 --> 00:00:54,940
وحتى الآن, هل فقدّت التفكير بالقرب منه ؟

10
00:00:54,990 --> 00:01:02,580
,هناك أوقات عندما أتأكّد من ذلك أُريدُ أن أرجع للوراء قليلاً فقط

11
00:01:02,590 --> 00:01:10,000
! ولكن التمسُّك بالحب والشجاعة والكبرياء, أُكافحْ

12
00:01:10,590 --> 00:01:14,000
.شيئاً فشيئاً, أصبحتُ مسحوره

13
00:01:14,250 --> 00:01:18,000
.هذا الكوكب آخر بقايا الأمل

14
00:01:18,250 --> 00:01:24,540
.بالتأكيد أيّ شخص يُريد أن يأخُذ الخلود بيده

15
00:01:24,920 --> 00:01:28,260
,على الرغمِ من أنني أتصرف وكأنيّ لا أهتمُّ أبداً

16
00:01:28,590 --> 00:01:32,000
! أُنظر إليّ, أنا واقع في حُبّك

17
00:01:32,590 --> 00:01:38,000
.دعنا نقفزُ خارج هذا الظلام اللانهائي

18
00:01:38,250 --> 00:01:43,580
.أمسكُ بِيدِكْ

19
00:01:54,250 --> 00:01:56,650
كا ... ميّ

20
00:01:56,920 --> 00:01:59,320
ها ... ميّ

21
00:01:59,590 --> 00:02:01,120
!! ها

22
00:02:07,860 --> 00:02:10,360
,إحترق مع إنتقامه من السيّاجين

23
00:02:10,700 --> 00:02:14,380
وتخطيطه للسيطرة على الكون, [ بيّبيّ ] قدّ

24
00:02:14,520 --> 00:02:18,660
.تلاشى إلى الشمس, وذلك بفضل تصرّف [ غوكو ]

25
00:02:25,920 --> 00:02:28,480
,السلام قد حلّ مرّةٌ أُخرى وعاد إلى الأرض

26
00:02:28,680 --> 00:02:31,620
.والجميع قد إحتفل بصخبٍ شديد في ذلك اليوم

27
00:02:32,250 --> 00:02:35,560
.100سنة قد مرّت منذُ ذلك الوقت

28
00:02:44,590 --> 00:02:47,120
.ولم يتبقّى أيّ شخص موجود منذُ ذلك الوقت

29
00:02:47,250 --> 00:02:50,100
.بإستثناء شخصٍ واحد

30
00:02:53,850 --> 00:02:55,330
! إنتظريّ

31
00:03:02,850 --> 00:03:05,160
.أيّها الجدّ المحترم ... أيّها الجدّ المحترم

32
00:03:06,850 --> 00:03:08,700
.[ سون غوكو ]

33
00:03:09,520 --> 00:03:11,920
... والآن

34
00:03:12,290 --> 00:03:14,690
.حان الوقت لتدريبك يا [ غوكو ]

35
00:03:14,850 --> 00:03:17,270
! حاضر يا جدتيّ [ بان ]

36
00:03:23,190 --> 00:03:30,370
القصة الجانبية لـ [ غوكو ]
!! الكرة ذات الأربعة نجوم هي الدليلُ على الشجاعة

37
00:03:31,850 --> 00:03:35,250
.حسنٌ, [ غوكو ] إقفز بأقصى ما تستطيع

38
00:03:35,520 --> 00:03:36,860
.حاضر

39
00:03:45,850 --> 00:03:50,300
.التوازن مهمٌّ هنا, شاهد وركّز الآن

40
00:03:53,790 --> 00:03:57,430
.[ غوكو ], جرّب الآن

41
00:04:04,790 --> 00:04:06,730
! جدتيّ

42
00:04:15,790 --> 00:04:18,030
! جاهز ؟ ها أنا ذا

43
00:04:25,300 --> 00:04:28,390
.ألا يُمكنُك حتى من إلتقاط الكرة

44
00:04:30,120 --> 00:04:33,180
.لقد تقوّست بإتجاهي, وأنزلقت من بين يديّ

45
00:04:33,200 --> 00:04:39,120
.إسمع, سلفَك جديّ [ غوكو ] كان قويّاً جدّاً فيّ ذلك

46
00:04:40,260 --> 00:04:45,260
.لا أحد كان يقارع جديّ, لقد كان قويّاً

47
00:04:52,020 --> 00:04:55,300
.وأنت من نفس سلالة جديّ [ غوكو ]

48
00:04:56,060 --> 00:04:59,140
.وأنت يجب أن تمتلك قوةً مذهله

49
00:04:59,420 --> 00:05:00,720
جدتيّ [ بان ] ؟

50
00:05:01,180 --> 00:05:02,390
ماذا تريد ؟

51
00:05:02,580 --> 00:05:04,230
! أنا جائع

52
00:05:05,720 --> 00:05:07,000
.لِنعُد .. لِنعُد

53
00:05:07,140 --> 00:05:08,240
.حسنٌ ... حسنٌ

54
00:05:08,820 --> 00:05:12,480
.بالمناسبة, أنت أخذت هذه العادة من جديّ [ غوكو ]

55
00:05:12,760 --> 00:05:15,490
.جدتي [ بان ] أنا أُحبّ الهامبورغر الذي تُعديه

56
00:05:22,100 --> 00:05:28,040
,وهكذا, الشاب والشابة ذهبا إلى المدينة

57
00:05:28,300 --> 00:05:29,740
.لبيع الحمار

58
00:05:29,960 --> 00:05:32,780
.أنتم هناك, إنظروا هنا وكونوا هادئين من فضلكم

59
00:05:33,100 --> 00:05:35,120
.بسبب ظروفهم الخاصة

60
00:05:35,940 --> 00:05:38,620
.حسنٌ, هذا يكفي لهذا اليوم

61
00:05:53,860 --> 00:05:54,920
لماذا فعلت هذا ؟

62
00:05:55,700 --> 00:05:56,760
.[ باك ]

63
00:06:06,880 --> 00:06:08,320
لديك شيّءٌ جميلٌ هنا. صحيح ؟

64
00:06:08,320 --> 00:06:09,990
... هـ .. هذه

65
00:06:10,540 --> 00:06:11,900
.أعطيني إيّاها

66
00:06:14,700 --> 00:06:17,390
.حسنٌ, بالتأكيد

67
00:06:18,800 --> 00:06:20,650
.ماذا ؟ أنت لم تغضب

68
00:06:21,000 --> 00:06:25,800
.نحنُ نعلمُ بأنك تتلقّى تدريبات خاصة من جدتُك [ بان ]

69
00:06:26,340 --> 00:06:29,900
.لـ .. ليّست تدريبات خاصة, إنّه فقط تدريّب

70
00:06:30,080 --> 00:06:33,160
.لا يُهمُني إذا كان تدريب أو رئيس

71
00:06:33,740 --> 00:06:37,630
أنت تُفكر بأن تُصبح قويّاً ومن ثُم تنتقمُ منّا, أليس كذلك ؟

72
00:06:38,460 --> 00:06:39,920
.هذا ليّس صحيحاً

73
00:06:40,140 --> 00:06:42,180
.سوف أقضي عليك في أيّ وقت

74
00:06:42,500 --> 00:06:46,340
.ولكن, ضرب شخصٌ ضعيف مثلُك هو ليّس شيّءٌ أتفاخر به

75
00:06:47,040 --> 00:06:48,400
.سوف أخذُ هذا

76
00:06:48,420 --> 00:06:49,920
هل هذا أزعجُك ؟

77
00:06:50,240 --> 00:06:51,260
! ضعيف

78
00:07:01,720 --> 00:07:04,720
أنت عُدت للمنزل من دون أن تقول أيّ شئ ؟

79
00:07:05,060 --> 00:07:06,990
لماذا تهرُب منهم ؟

80
00:07:07,180 --> 00:07:10,760
لماذا لم تقلّ لهم " أرجعوا إليّ قلمي " ؟

81
00:07:10,980 --> 00:07:13,380
.لا أستطيع, لا أستطيع هؤلاء الأشخاص أقوياء

82
00:07:13,620 --> 00:07:15,850
.إذا وقفتُ ضدهم, فسوف يوسعونيّ ضرباً

83
00:07:16,140 --> 00:07:17,590
.وفوق ذلك, إنهم ثلاثة ضد واحد

84
00:07:18,000 --> 00:07:22,540
.لا بأس إذا كُنت ستُضرب ! ولا بأس إذا خسرت القتال

85
00:07:22,620 --> 00:07:25,820
... إسمعنيّ يا [ غوكو ], القوّة الحقيقيّة هيّ

86
00:07:32,620 --> 00:07:35,020
.جدتيّ ما الأمر ؟ جدتيّ [ بان ]

87
00:07:35,560 --> 00:07:37,900
.أنتيّ ! إستيقظيّ

88
00:07:38,660 --> 00:07:42,780
.أنتيّ ! جدتيّ ... جدتيّ

89
00:07:49,440 --> 00:07:52,840
.جدتيّ, تماسكيّ ! لن أجعلُكِ تقلقين بعد الآن

90
00:07:52,920 --> 00:07:54,850
.وبالتأكيد سوف أتدرّب أيضاً

91
00:07:55,120 --> 00:07:59,880
! موافقة ؟ سوف أصبح قويّاً بالتأكيد, وأهزم [ باك ] والآخرين بسهولة

92
00:07:59,940 --> 00:08:02,800
! لذلك أصبحيّ أفضل يا جدتيّ [ بان ]

93
00:08:03,340 --> 00:08:05,460
,ليّس هكذا يا [ غوكو ]

94
00:08:05,520 --> 00:08:10,460
,القوّة الحقيقيّة هيّ ليّست مجرد حصولك على طاقة قويّة

95
00:08:10,880 --> 00:08:12,600
,إنها الشجاعة, الشجاعة فيّ مواجهة الأشياء بكلّ ما لديك

96
00:08:12,680 --> 00:08:14,840
,ولا داعيّ للقلق حول ما ستكون عليه النتيجة

97
00:08:14,880 --> 00:08:17,740
.عندما تعتقد بأنّك على حقّ

98
00:08:17,920 --> 00:08:20,000
.وهذا ما تفتقده أنت

99
00:08:20,840 --> 00:08:22,020
.الشجاعة

100
00:08:22,220 --> 00:08:26,940
,إسمع ... أنت طفل إستثنائيّ

101
00:08:28,980 --> 00:08:32,680
,وليّس فقط بأنك من سلالة جديّ [ غوكو ]

102
00:08:33,020 --> 00:08:38,940
.أنت تشبه تماماً جديّ [ غوكو ], فيّ كلّ شيّء

103
00:08:39,240 --> 00:08:42,200
مـ .. ما الذيّ تتحدثين عنه يا جدتيّ ؟

104
00:08:43,000 --> 00:08:50,600
,أنا علمتُ ذلك عندما وُلدت, لهذا السبب سميّتُك بإسمه

105
00:08:51,080 --> 00:08:52,600
.[ سون غوكو ]

106
00:08:52,900 --> 00:08:55,920
.توقفيّ عن ذلك. أنا لستُ قويّاً

107
00:08:56,140 --> 00:08:59,620
! أنا لستُ جيّداً بدون وجودك بجانبيّ يا جدتيّ [ بان ]

108
00:08:59,660 --> 00:09:03,700
.إسمعنيّ. إمتلك تلك الشجاعة التيّ لا يُمكنُك التعرض للضرب من قبل أيّ شخصٍ أيّضاً

109
00:09:05,400 --> 00:09:06,980
! جدتيّ ... جدتيّ

110
00:09:07,000 --> 00:09:08,960
.هذا سيّء. جهّزيّ جهاز إستنشاق الأوكسجين

111
00:09:09,100 --> 00:09:10,450
! حـ .. حاضر

112
00:09:10,980 --> 00:09:12,980
تعال يا [ غوكو ], دعنا نذهب للخارج, موافق ؟

113
00:09:13,040 --> 00:09:15,330
... ولكن جدتيّ

114
00:09:20,520 --> 00:09:22,900
هل جدتيّ [ بان ] ستموت ؟

115
00:09:24,500 --> 00:09:26,020
سوف تتحسّن, صحيح ؟

116
00:09:26,500 --> 00:09:27,790
! [ غوكو ]

117
00:09:27,790 --> 00:09:32,670
! أخبرينيّ بأنها سوف تتحسّن ! عدينيّ بذلك

118
00:09:37,280 --> 00:09:39,920
! لا ! لا

119
00:09:40,980 --> 00:09:46,060
! لا ! شخصٌ ما ... شخصٌ ما يساعدها

120
00:10:08,940 --> 00:10:12,860
! جدتيّ ... لا أُريدُك أن تموتيّ

121
00:10:27,340 --> 00:10:29,860
كرة ... التنيّن ؟

122
00:10:30,380 --> 00:10:35,970
.نعم. إنها كراتٌ غامضة, ويمكنها منح أيّ أُمنية, إنها رائعة

123
00:10:38,640 --> 00:10:41,840
.لقد ذهبتُ إلى الفضاء وحظيّتُ بمغامرة رائعة للبحث عنهم

124
00:10:42,520 --> 00:10:44,120
,على الرغم من أنها مجموعة مختلفة عن هذه

125
00:10:44,720 --> 00:10:47,120
.من أجل إنقاذ الأرض

126
00:10:47,240 --> 00:10:50,280
.كان هذا منذ زمن طويل يا [ غوكو ]

127
00:10:54,180 --> 00:10:55,820
! كرة التنيّن

128
00:10:57,440 --> 00:10:58,320
! فهمت

129
00:10:58,960 --> 00:11:02,900
! بقوّة كرات التنيّن, ربما جدتيّ [ بان ] قد أنقذُها

130
00:11:17,260 --> 00:11:26,100
فيّ منزل ( Paozu ) أعتقد بأنّها موجودة فيّ جبل
! جديّ [ غوكو ] وأنا سوف أعثُرُ عليها بالتأكيد, وأشفيّ جدتيّ [ بان ] من مرضها

131
00:11:26,300 --> 00:11:29,180
! لذلك لا تموتيّ قبل أن أعثُر عليها

132
00:11:30,220 --> 00:11:34,420
مرحباً يا [ غوكو ], ما هذا اللباس ؟ هل أنت ذاهبٌ إلى مكانٍ ما ؟

133
00:11:35,980 --> 00:11:37,280
! ( Paozu ) جبل

134
00:11:37,420 --> 00:11:40,020
؟ هل أنت غبيّ ؟! ( Paozu ) جبل

135
00:11:40,200 --> 00:11:43,920
! مشهور بوجود تلك الوحوش البشعة التيّ تعيش هناك, كما تعلم ( Paozu ) جبل

136
00:11:45,100 --> 00:11:49,080
من المستحيل أن ضعيفٌ مثلك سيذهبُ إلى هناك, أليّس كذلك ؟

137
00:11:50,280 --> 00:11:52,540
إنه مُحقّ, إنه مُحقّ ! ما الذيّ تُفكّرُ به ؟

138
00:11:54,200 --> 00:11:56,630
! أنتم, تنحوّ جانباً

139
00:12:00,080 --> 00:12:01,700
ما كان ذلك الآن ؟

140
00:13:03,420 --> 00:13:06,460
.بالتأكيّد إنّه طريقٌ طويل

141
00:13:28,860 --> 00:13:30,840
ما الذيّ تفعله يا فتى ؟

142
00:13:31,200 --> 00:13:33,020
.لقد كُنّتُ أستريّح

143
00:13:33,580 --> 00:13:35,120
إلى أيّن أنت ذاهب ؟

144
00:13:36,980 --> 00:13:38,080
.( Paozu ) إلى جبل

145
00:13:40,400 --> 00:13:41,900
؟ ( Paozu ) جبل

146
00:13:46,660 --> 00:13:48,960
! قوليّ أيّها العمّ, إسمح ليّ بالركوب معك

147
00:13:50,740 --> 00:13:52,240
! إنّه مُريّح ! إنّه مُريّح

148
00:13:52,300 --> 00:13:55,060
صحيح؟ ,( Paozu ) لكن, جبل

149
00:13:55,380 --> 00:13:57,800
.يا فتى, لديّك ذوّقٌ غريّب

150
00:14:00,780 --> 00:14:01,940
أتُريّد بعضاً من هذا ؟

151
00:14:02,260 --> 00:14:05,260
! لا ... لديّ ما يكفيّ

152
00:14:20,740 --> 00:14:22,190
هذا صحيح يا فتى ؟

153
00:14:22,440 --> 00:14:25,060
.يجب عليّك أن تذهب إلى الحمّام

154
00:14:25,180 --> 00:14:26,960
.أمامنا طريّقٌ طويّل

155
00:14:28,960 --> 00:14:32,000
.حـ .. حسنٌ, سأذهبُ وأعودُ سريّعاً

156
00:14:39,240 --> 00:14:40,080
... أنت

157
00:14:40,280 --> 00:14:42,860
.لقد نسيّت هذا, خُذّ

158
00:14:43,120 --> 00:14:43,920
ماذا ؟

159
00:14:44,960 --> 00:14:46,320
.شكراً على الطعام

160
00:14:49,560 --> 00:14:51,620
! إ .. إنتظر

161
00:14:55,360 --> 00:14:58,280
.لقد ... سرق أغراضيّ

162
00:15:12,180 --> 00:15:14,320
ما الذيّ حدث لوجهك المثيّر للشفقة ؟

163
00:15:15,280 --> 00:15:18,120
.عمٌّ لطيّف سرق أغراضيّ

164
00:15:18,200 --> 00:15:20,680
! بحقّ, لهذا السبب أنت أحمق

165
00:15:20,780 --> 00:15:23,860
! كُلّما كان الشخص لطيّفاً, كُلّما قلّت الثقة به

166
00:15:23,980 --> 00:15:25,600
... حتى ولوّ قُلت هذا الآن

167
00:15:26,500 --> 00:15:29,040
بالمناسبة يا [ باك ], ما الذيّ تفعله هنا ؟

168
00:15:29,540 --> 00:15:32,860
,ما الذيّ أفعله هنا ؟ الذهابُ إلى المدرسة مُملّ

169
00:15:33,200 --> 00:15:36,400
.معك قد يكون ممتعاً ( Paozu ) لذا ظننّت بأن الذهاب إلى جبل

170
00:15:36,640 --> 00:15:38,080
معيّ أنا ؟

171
00:15:38,440 --> 00:15:44,740
.يأكُلك ( Paozu ) نـ .. نعم ظننّتُ بأنيّ أودُّ مشاهدة وحش من جبل

172
00:15:45,860 --> 00:15:48,980
إذاً, والآن ما الذيّ تُريّد فعله ؟ هل ستعود ؟

173
00:15:49,360 --> 00:15:53,380
.مهما كان ,( Paozu ) يجب أن أذهب إلى جبل

174
00:15:54,720 --> 00:15:58,900
ولكن طعامُك وملابسُك قد تمّ سرقتُها, صحيح ؟

175
00:16:05,780 --> 00:16:07,740
[ باك ], ما الذيّ يفعله يا تُرى ؟

176
00:16:08,700 --> 00:16:10,760
! إنتظر يا فتى

177
00:16:10,800 --> 00:16:11,520
.أنا آسف

178
00:16:13,400 --> 00:16:15,540
.أيّها العمّ نحن آسفون

179
00:16:47,060 --> 00:16:49,000
ما رأيُك بسلاحيّ السرّيّ ؟

180
00:16:49,080 --> 00:16:50,360
! لقد كان الأروع

181
00:17:01,040 --> 00:17:01,580
ماذا ؟

182
00:17:08,900 --> 00:17:10,680
! هذا قذر

183
00:17:12,640 --> 00:17:13,240
! إنتظر

184
00:17:13,760 --> 00:17:16,760
! توقف عن هذا ! هذا قذر

185
00:17:17,020 --> 00:17:20,060
! إنتظر -
! سوف أمسحها بك -

186
00:17:26,040 --> 00:17:27,560
لما فعلت هذا !؟

187
00:17:28,260 --> 00:17:29,640
! [ باك ] , إنظر

188
00:17:33,840 --> 00:17:34,620
! [ غوكو ]

189
00:17:43,160 --> 00:17:45,540
! ( Paozu ) جبل -
! ( Paozu ) جبل -

190
00:17:51,320 --> 00:17:53,860
,بالتفكيّر فيّ الأمر, أنا لم أسألك بعد

191
00:17:53,940 --> 00:17:55,500
عن غرضِك لقدومك إلى هذه الرحلة ؟

192
00:17:55,520 --> 00:17:57,980
قوليّ, هل تعرف ماهيّ كرة التنيّن ؟

193
00:17:59,580 --> 00:18:00,540
ماذا ؟ ماهيّ هذه ؟

194
00:18:01,420 --> 00:18:06,840
.كرة التنيّن. إنّها كرةٌ غامضة تمنحُك أيّ أُمنيّة

195
00:18:07,340 --> 00:18:11,700
؟ ( Paozu ) كلامٌ فارغ ! وهل هيّ فيّ جبل

196
00:18:12,360 --> 00:18:17,740
.نعم ... أُريّد أن أُنقذ جدتيّ [ بان ] بأُمنيّتيّ

197
00:18:18,360 --> 00:18:21,620
هل هيّ بهذا السوّء الجدة [ بان ] ؟

198
00:18:23,980 --> 00:18:24,840
! تعال إليّ

199
00:18:25,560 --> 00:18:27,260
! وأنت أيّضا إغرُب عن وجهيّ

200
00:18:32,800 --> 00:18:36,340
.ضربُ شخصٌ ما بسلاح يُعتبر قتالاً قذراً

201
00:18:37,360 --> 00:18:39,120
.إذا أردت القتال, فأفعلها بيديّن عاريتيّن

202
00:18:39,800 --> 00:18:42,160
إنّها لطيفة الجدّة [ بان ], صحيح ؟

203
00:18:42,380 --> 00:18:44,440
.إنّها مخيّفة قليّلاً, على الرغم من ذلك

204
00:18:44,540 --> 00:18:48,020
! على هذا النحوّ, فإنّها سوف تموت

205
00:18:51,120 --> 00:18:55,680
! لا تبكيّ ! كُلّ نقانقُك بسرعة, أو ستُصبح سيّئة

206
00:19:02,240 --> 00:19:04,840
.وهناك شيّءٌ آخر ... خذّ هذه

207
00:19:06,660 --> 00:19:09,080
! أنا لا أريد ... شيّءٌ كهذا

208
00:19:09,520 --> 00:19:11,180
.بعد أنّ نظرت إليّه جيّداً, إنّه عاديٌّ جدّاً

209
00:19:14,060 --> 00:19:15,080
.شكراً لك

210
00:19:25,960 --> 00:19:27,940
! [ غوكو ], إهرب

211
00:19:29,180 --> 00:19:30,340
! أسرع

212
00:20:01,080 --> 00:20:03,600
.فليساعدنيّ ... أحدٌ ما

213
00:20:09,020 --> 00:20:10,460
! [ غوكو ]

214
00:20:26,180 --> 00:20:28,900
! أيّتها الذئاب البائسة آكلت الرجال

215
00:20:39,600 --> 00:20:43,780
أيّها الطفل, لقد كُنتَ تقريّباً أن تُؤكل, صحيح ؟

216
00:20:47,580 --> 00:20:49,420
! والآن كّلُ شيّءٍ بخيّر

217
00:20:50,920 --> 00:20:52,480
! [ غوكو ]

218
00:20:54,260 --> 00:20:55,760
! [ غوكو ]

219
00:20:58,300 --> 00:21:00,560
! أنقذنيّ

220
00:21:02,140 --> 00:21:05,780
مـ .. ما الذيّ أفعله هنا !؟

221
00:21:09,900 --> 00:21:16,180
! لا يُمكنُنيّ النزول ! أنا خائفٌ جدّاً ! لا يُمكنُنيّ النزول

222
00:21:25,040 --> 00:21:29,140
! بعد أن أنقذتيّنا, تقدميّ لنا كُلّ هذا الطعام اللذيّذ

223
00:21:30,100 --> 00:21:34,100
! هناك المزيّد منه, ليّس هناك أيّ حاجة للتردّد

224
00:21:40,580 --> 00:21:43,840
... يا لها من وجبة لذيّذة خاصة

225
00:21:44,060 --> 00:21:45,680
! وهناك إثنيّن منهم

226
00:21:45,720 --> 00:21:49,660
.[ مامبا ], ليّس من العدل أن تحتفظيّ بهم لوحدك

227
00:21:54,140 --> 00:21:57,180
! هذا صحيح ! دعينيّ آكلهم أيّضاً

228
00:22:00,780 --> 00:22:04,260
.بحقّ ! لقد تعبتُ من حاسّة الشمّ الحادة التيّ لديّكم

229
00:22:08,980 --> 00:22:10,280
[ باك ], هل نُمت ؟

230
00:22:10,300 --> 00:22:11,680
.لا, أنا مُستيّقظ

231
00:22:12,000 --> 00:22:14,760
تلك الآنسة لطيّفة بشكل غيّر عاديّ, صحيح ؟

232
00:22:15,500 --> 00:22:20,040
والآن إذاً, أيٌّ منكم أيّها الطفلان سنأكلهُ أوّلاً ؟

233
00:22:31,520 --> 00:22:32,460
ماذا !؟

234
00:22:34,720 --> 00:22:36,340
! وهذا أيّضاً إختفى

235
00:22:37,940 --> 00:22:39,960
! من الجيّد أنك عرفت ذلك

236
00:22:40,080 --> 00:22:44,880
لأنّك قلت يا [ باك ] بألّا أثق بالأشخاص اللطفاء, أليّس كذلك ؟

237
00:22:44,920 --> 00:22:45,820
.هكذا إذاً

238
00:22:45,920 --> 00:22:47,420
! ها أنتم هنا

239
00:22:51,440 --> 00:22:55,360
! إنتظروا

240
00:23:06,620 --> 00:23:10,960
! كم هو لطيّفٌ منكم أن تقطعوا كُلّ هذه المسافة حتى يتمّ طبخكم

241
00:23:34,580 --> 00:23:38,120
,سوف أُقطّعكم إلى قطع بهذه السكيّنة

242
00:23:38,720 --> 00:23:41,360
! وأغليّكم بداخل هذا الوعاء الكبيّر

243
00:23:42,600 --> 00:23:46,220
! شهوة التفكيّر فيّ الأمر تجعل اللّعاب يسيّل من فميّ

244
00:23:51,420 --> 00:23:57,120
.لـ .. لا تصنعيّ هذا الوجه الغاضب, إنّه يُفسد جمال وجهك

245
00:23:57,600 --> 00:23:58,820
جمال وجهيّ ؟

246
00:23:59,080 --> 00:24:03,600
! يا إلهيّ ! هل حقّاً تظنّ ذلك ؟ يا لك من فتى جيّد

247
00:24:12,380 --> 00:24:14,740
أتتوقّعون منيّ بأن أُخدع بهذه الحيّلة !؟

248
00:24:25,440 --> 00:24:28,140
! أنا لن أسمح لك بالهرب يا فتى

249
00:24:29,120 --> 00:24:29,980
! [ غوكو ]

250
00:24:38,940 --> 00:24:42,700
! إنتظر لحظة أنت ! أنت التاليّ, بعد هذا الفتى

251
00:24:51,480 --> 00:24:53,360
! الآن هيّأّ نفسك

252
00:25:13,880 --> 00:25:15,040
! خُذيّ هذا

253
00:25:20,200 --> 00:25:22,240
! [ غوكو ] ! هل أنت بخيّر ؟ نحن سوف نهرب

254
00:25:28,120 --> 00:25:32,120
! تبّاً لكم ! سوف آكُلكُم مهما كان

255
00:25:50,180 --> 00:25:53,460
؟ ( Paozu ) أكانت تلك السيّدة وحش جبل

256
00:25:54,960 --> 00:25:58,480
! يا للعار ! هيّا بنا لنذهب ! لا تكُنّ مُتباطئاً

257
00:25:59,340 --> 00:26:01,860
نذهب ؟ أنت تعنيّ بأن نعبُر هذا الجسر ؟

258
00:26:02,320 --> 00:26:03,520
لا يوجد لديّنا خيارٌ آخر, صحيح ؟

259
00:26:03,520 --> 00:26:06,140
! إذا لم نُسرع, فسوف تلحقُ بنا

260
00:26:06,920 --> 00:26:10,200
! إنّه خطيّرٌ جدّاً ! دعنا لا نفعل هذا يا [ باك ]

261
00:26:15,480 --> 00:26:16,280
! [ باك ]

262
00:26:28,360 --> 00:26:31,740
! لا بأس ! أسرع وتعال

263
00:26:47,800 --> 00:26:49,840
! لا تنظر إلى الأسفل يا [ غوكو ]

264
00:26:55,240 --> 00:26:58,480
! [ غوكو ] ! إنظر إلى هنا

265
00:26:58,840 --> 00:27:03,300
... أنا لستُ خائفاً ... أنا لستُ خائفاً أبداً ... أنا لستُ

266
00:27:13,380 --> 00:27:15,800
! أنا خائف ! أنا خائف

267
00:27:17,460 --> 00:27:20,180
! [ غوكو ] ! هيّا أسرع

268
00:27:20,860 --> 00:27:23,540
! لا ! لا أستطيع التحرّك

269
00:27:24,440 --> 00:27:25,440
! [ غوكو ]

270
00:27:29,220 --> 00:27:33,680
! أنقذنيّ ! أنا سأسقُط

271
00:27:39,180 --> 00:27:42,600
! [ غوكو ] ! أنا قادمٌ لإنقاذك حالاً

272
00:27:48,440 --> 00:27:51,140
! [ غوكو ] ! أمسك بيديّ

273
00:27:51,460 --> 00:27:54,620
! [ بـ .. باك ]

274
00:27:55,260 --> 00:27:57,900
! أمسك بيديّ بسرعة

275
00:27:58,260 --> 00:28:02,500
! لا أستطيع ! إذا تحرّكت فسأسقط

276
00:28:02,740 --> 00:28:07,620
أيّها الجبان ! ألم تكُنّ ذاهباً لمساعدة الجدّة [ بان ] !؟

277
00:28:26,700 --> 00:28:28,320
! [ باك ]

278
00:29:18,240 --> 00:29:20,880
! [ غوكو ] ! هيّا أسرع

279
00:29:21,520 --> 00:29:23,480
! [ باك ] ! أنت حيّ

280
00:29:42,220 --> 00:29:43,700
! [ باك ]

281
00:29:45,040 --> 00:29:49,980
... إذا كانت لديّ فقط الشجاعة لأُخرجُها فيّ ذلك الوقت, لكان [ باك ]

282
00:29:52,500 --> 00:29:56,200
... جدتيّ [ بان ], أنا بالفعل جبان بعد كُلّ هذا

283
00:30:05,920 --> 00:30:09,260
! لا فائدة من هروبِك منيّ

284
00:30:09,820 --> 00:30:11,920
.إبقى هادئاً حتى أكُلُك

285
00:30:31,320 --> 00:30:34,080
! أنا خائف ! ... أنا خائف

286
00:30:41,520 --> 00:30:46,020
! لا يُمكنُنيّ الهرب. أنا لستُ خائفاً. يجب أن أتحلّى بالشجاعة

287
00:30:54,820 --> 00:30:56,060
! أنت ليّ الآن

288
00:31:06,260 --> 00:31:12,920
! أنت الفتى الذيّ هرب من [ مامبا ] ! أنت تبدو أكثر لذّةً

289
00:31:15,720 --> 00:31:19,700
أتعتقدُ بأنّك ندّاً ليّ بهذه العصا ؟

290
00:31:46,080 --> 00:31:52,720
.لقد أتيّت إلى هنا للبحث عن كرة غامضة, تُدعى بكرة التنيّن

291
00:31:56,220 --> 00:31:58,860
,ولكن لم أكُنّ سوى كالقطّة الخائفة

292
00:31:58,940 --> 00:32:02,240
... والصديّق الذيّ كان معيّ سقط إلى أسفل قاع الممرّ الضيّق

293
00:32:04,820 --> 00:32:06,640
.وكان يحاول إنقاذيّ

294
00:32:45,280 --> 00:32:47,420
.أ .. أنتيّ والدته إذاً

295
00:32:57,260 --> 00:32:57,860
ماذا ؟

296
00:33:05,240 --> 00:33:09,220
هـ .. هل من المُمكن أنّك تُريّد إيصاليّ إلى مكان كرة التنيّن ؟

297
00:33:51,320 --> 00:33:52,460
!! ها هوّ ! إنّها هناك

298
00:33:53,140 --> 00:33:56,260
! يجب أن يكون هذا هو منزل جديّ [ غوكو ], تماماُ مثلما قالت جدتيّ [ بان ]

299
00:33:57,720 --> 00:34:00,280
! لقد فعلتها ! وأخيّراً أنا هنا

300
00:34:01,180 --> 00:34:02,320
! أنتمّ يا رفاق

301
00:34:03,780 --> 00:34:06,000
! وأخيّراً وجدناك يا فتى

302
00:34:06,300 --> 00:34:09,960
الشعر هوّ حياة المرأة بأكملها ! وأنت كيّف تجرؤّ على قصّ شعريّ ؟

303
00:34:09,980 --> 00:34:11,200
! جهّز نفسك

304
00:34:11,680 --> 00:34:13,520
.الشعر القصيّر المقصوص هو أيّضاً لطيّف

305
00:34:15,820 --> 00:34:17,740
! ما الذيّ تفعلانه !؟ إنّه يهرب

306
00:34:21,560 --> 00:34:25,060
! لماذا يحدُثُ هذا !؟ بعد أنّ وصلتُ إلى هنا

307
00:34:25,100 --> 00:34:26,780
!! إنتظر

308
00:34:30,660 --> 00:34:33,980
لقد إختفى ! إنّه يستطيع إستخدام هذا النوّع من السحر !؟

309
00:34:34,160 --> 00:34:37,760
.كما توقّعت, إنه ليّس طفلاً عاديّاً بعد كُلّ شيّء

310
00:34:47,420 --> 00:34:49,200
! من هنا ! من هنا

311
00:34:50,060 --> 00:34:52,520
! هذا الفتى يستخفُّ بنا

312
00:34:52,760 --> 00:34:53,960
! أنت تمزح

313
00:34:54,200 --> 00:34:56,360
! الطيران خلفنا ليّس عدلاً

314
00:35:21,960 --> 00:35:25,560
! [ يوماوّ ] ( Paozu ) أنا هوّ سيّد جبل

315
00:35:26,520 --> 00:35:28,280
أهذا هوّ السيّد [ يوماوّ ] !؟

316
00:35:29,320 --> 00:35:32,780
.لقد كُنتُ هادئاً, بيّنما كُنتُم تواجهون مشكلة مع هذا الفتى

317
00:35:32,840 --> 00:35:33,860
! يا لكم من مثيّرون للشفقة

318
00:35:35,340 --> 00:35:37,600
! نحنُ آسفون للغايّة

319
00:35:41,900 --> 00:35:42,500
ماذا !؟

320
00:35:54,420 --> 00:35:56,080
!! مُتّ

321
00:36:09,800 --> 00:36:14,100
سـ .. سيّد [ دُبّ ], هل تُحاول مساعدتيّ ؟

322
00:36:14,420 --> 00:36:16,180
! إترُكنيّ

323
00:36:23,520 --> 00:36:25,220
! سوف أدعسُكم

324
00:36:32,060 --> 00:36:33,660
! خُذّ هذه

325
00:36:36,620 --> 00:36:38,380
! أيّها المُزعج

326
00:36:42,460 --> 00:36:43,420
! سيّد [ دُبّ ]

327
00:36:49,880 --> 00:36:52,180
! هذه المرّة بالتأكيّد سوف ألتهمُكم

328
00:36:57,520 --> 00:36:58,300
! سيّد [ دُبّ ]

329
00:37:08,680 --> 00:37:10,640
! أنت تُزعجُنيّ

330
00:37:24,740 --> 00:37:26,140
! أنا آسف يا سيّد [ دُبّ ]

331
00:37:41,580 --> 00:37:43,020
! والآن سأقضيّ عليّك

332
00:37:49,580 --> 00:37:51,620
! توقّف

333
00:37:52,780 --> 00:37:54,300
ماذا !؟

334
00:37:57,940 --> 00:38:00,120
! لن أسمح لك بإيذاء أيّ شخصٍ آخر

335
00:38:02,500 --> 00:38:04,820
! أنا سأحميّ الجميّع

336
00:38:27,620 --> 00:38:32,240
هـ .. هذا مستحيّل ! من أيّن حصل هذا الفتى على هذا النوّع من القوّة !؟

337
00:38:45,860 --> 00:38:50,540
أيّها الحقيّر ... مـ .. من أنت ؟

338
00:39:20,840 --> 00:39:23,680
أنا ... ما الذيّ حدث بحقّ ... ؟

339
00:39:28,760 --> 00:39:33,160
.هكذا إذاً ! أنتم قضيّتم عليّه, صحيح ؟ شكراً لكم

340
00:39:57,500 --> 00:40:01,460
.كرة التنيّن يجب أن تكون فيّ مكانٍ ما فيّ هذا المنزل

341
00:40:06,820 --> 00:40:11,260
.ليّست هنا ... ليّست هنا ... ليّست هنا

342
00:40:17,220 --> 00:40:19,720
! هذه هيّ ! لا شكّ فيّ ذلك

343
00:40:23,300 --> 00:40:27,260
! والآن يُمكنُنيّ شفاء جدتيّ [ بان ] من المرض

344
00:40:32,380 --> 00:40:36,780
.إلهيّ, أرجوكّ إستمع إلى أُمنيّتيّ

345
00:40:36,980 --> 00:40:40,920
! أرجوك أنقذ جدتيّ [ بان ], التيّ أُحبُّها كثيّرا جدّاً

346
00:40:49,660 --> 00:40:54,820
.أ .. أرجوك أنقذ [ باك ], الذيّ سقط فيّ الممرّ الضيّق فيّ محاولة لإنقاذيّ

347
00:40:58,440 --> 00:41:01,880
لماذا ؟ لماذا لم يحدُث أيّ شيّء ؟

348
00:41:02,040 --> 00:41:05,660
أليّس تنيّن عملاق يّدعى [ شيّنلونغ ] من المفترض أن يظهر !؟

349
00:41:05,960 --> 00:41:11,060
! إلهيّ ! سيّد كرة التنيّن ! أرجوك إسمع أُمنيّتيّ

350
00:41:15,320 --> 00:41:18,860
لماذا ؟ لماذا !؟

351
00:41:19,320 --> 00:41:23,180
لماذا لم تمنحنيّ أُمنيّتيّ ؟

352
00:41:23,900 --> 00:41:25,400
! اللعنة

353
00:41:30,080 --> 00:41:32,780
لماذا أتيّت إلى هنا بعد كُلّ هذه المسافة !؟

354
00:41:32,900 --> 00:41:35,760
.يجب أن تحصل على كُلّ كرات التنيّن معاً, أو لن تنفع معك

355
00:41:36,180 --> 00:41:37,820
ألم تقُلّ لك [ بان ] ؟

356
00:41:38,880 --> 00:41:39,800
! مرحباً

357
00:41:44,560 --> 00:41:45,440
من أنت ؟

358
00:41:46,460 --> 00:41:51,520
من أنا !؟ أنا هوّ كبيّر كبيّر ... كمّ هوّ العدد مجدّداً ؟

359
00:41:52,000 --> 00:41:53,940
.على أيّ حال, أنا هوّ جدُّك

360
00:41:54,640 --> 00:41:57,660
جـ .. جديّ ... [ غوكو ] ؟

361
00:41:58,180 --> 00:41:58,720
! نعم

362
00:41:59,360 --> 00:42:01,860
! أتعلم, أنت حقّاً قويّ

363
00:42:02,020 --> 00:42:04,680
.لقد مضى وقتٌ طويّل مُنذُ أن توتّرتُ هكذا

364
00:42:04,800 --> 00:42:07,680
.أنا ؟ أنا دائماً ضعيّف

365
00:42:08,460 --> 00:42:12,460
! هذا ليّس صحيّحاً. أنت حقّاً قويّ

366
00:42:13,100 --> 00:42:16,000
أكُنتُ ... شجاعاً ؟

367
00:42:16,540 --> 00:42:18,180
! بالطبع لقد كُنت

368
00:42:18,480 --> 00:42:19,640
... أنت حفيّد حفيّدتيّ

369
00:42:19,680 --> 00:42:24,280
... وطفل حفيّدتيّ

370
00:42:25,140 --> 00:42:28,300
! حسنٌ, على أيّ حال, أنت [ سون غوكو ], بعد كُلّ شيّء

371
00:42:29,920 --> 00:42:33,960
... ولكن, عندما حاول صديّقيّ إنقاذيّ

372
00:42:38,240 --> 00:42:39,480
! أنت

373
00:42:40,640 --> 00:42:41,580
! [ باك ]

374
00:42:43,000 --> 00:42:45,000
! [ غوكو ]

375
00:42:45,340 --> 00:42:48,860
! جـ .. جدتيّ [ بان ] ! لقد تحسنّتيّ

376
00:42:49,120 --> 00:42:50,600
! لقد أنقّذتها

377
00:42:51,440 --> 00:42:55,880
! من كُنت تظُنّنيّ !؟ أنا لن أموت بهذه السهولة

378
00:42:56,060 --> 00:43:01,620
! الجميّع بخيّر ! كرة التنيّن قد منحتنيّ أُمنيّتيّ

379
00:43:02,340 --> 00:43:03,660
جديّ [ غوكو ] ؟

380
00:43:04,620 --> 00:43:08,480
.هذا ليّس صحيّحاً ! لم تكُنّ كرة التنيّن

381
00:43:08,960 --> 00:43:11,380
! إنّها بسبب شجاعتك

382
00:43:13,780 --> 00:43:16,520
! إبذل جهدك يا [ سون غوكو ]

383
00:43:17,860 --> 00:43:18,700
! حاضر

384
00:43:21,160 --> 00:43:27,000
.وهكذا, رحلة الفتى الشابّ الشجاعة للبحث عن كرة التنيّن قد وصلت إلى نهايتها

385
00:43:28,160 --> 00:43:30,040
! أنا سأبذُل جهديّ

386
00:43:30,900 --> 00:43:33,620
! شاهدنيّ فقط يا جديّ [ غوكو ]

387
00:43:34,180 --> 00:43:38,040
فيّ يده, يُمسك بإحكام الكرة ذات الأربعة نجوم

388
00:43:38,500 --> 00:43:43,100
.بالتأكيّد, ستُصبح تذكاراً من جدّه [ غوكو ]

389
00:43:43,500 --> 00:43:46,060
,تماماً كما فيّ الماضيّ, عندما كان [ غوكو ] طفلاً

390
00:43:46,640 --> 00:43:50,340
.عندما كانت تذكاراً من جدّه

391
00:44:18,320 --> 00:44:24,980
,أتمنّى بأنّ الكلمات تأتيّ إليّ بسهولة

392
00:44:25,200 --> 00:44:31,580
.مثل كتابة رسالة إلى صديّق

393
00:44:32,800 --> 00:44:36,920
,أودُّ الحصول على المزيّد من الوقت

394
00:44:37,340 --> 00:44:44,860
.من أجلنا لكيّ نعرف بعضنا بشكلٍ أفضل قليّلاً

395
00:44:46,960 --> 00:44:53,980
,بالتفكيّر فيّ أن أفراد عائلتك همّ الوحيّدون الذيّن لن يخونوك

396
00:44:54,440 --> 00:45:00,200
.إنّه مجرّد حبٌّ بائس أسألهُ لمحبوبهم

397
00:45:01,600 --> 00:45:14,560
,على الرغم من أنّنيّ أعرف بأن التخليّ عن الإيّمان قد يجعلُنيّ أكونُ مرتاحة

398
00:45:15,120 --> 00:45:17,020
! ألا ترى

399
00:45:18,320 --> 00:45:21,560
,على الرغم من أنّنيّ آمل وأدعيّ

400
00:45:21,780 --> 00:45:29,540
! بيّن المعجزات والذكريات, أنا ما زلتُ قلقة بعض الشيّء

401
00:45:29,660 --> 00:45:31,960
! ألا ترى

402
00:45:32,660 --> 00:45:40,040
,مهما قد يكون إندفاع الجميّع فيّ العالم أيّضاً

403
00:45:40,160 --> 00:45:44,500
! تمسّك أنت بيّ