1
00:00:13,540 --> 00:00:14,980
!ساكورا-تشان

2
00:02:27,080 --> 00:02:29,150
.كونكِ آلية يبدو رائعًا

3
00:02:29,180 --> 00:02:31,260
.فأنتِ لا تلهثين من التعب

4
00:02:31,280 --> 00:02:33,890
.لستِ مثلي، أعتقد أنني سأموت

5
00:02:33,920 --> 00:02:37,660
ساكورا-تشان، كيف علمتِ بمكان وجود كي؟

6
00:02:37,690 --> 00:02:40,210
.لم أكن أعلم، لقد كانت مصادفة

7
00:02:40,490 --> 00:02:42,220
.لقد ذهبت لأوصل البيتزا

8
00:02:42,620 --> 00:02:44,850
ألن تأكليها؟

9
00:02:45,630 --> 00:02:47,170
.لقد نسيت تركها هناك

10
00:02:47,200 --> 00:02:51,260
.وتركت دراجتي أيضًا، اللعنة، سأطرد مرة أخرى

11
00:02:54,340 --> 00:02:55,500
.أنا آسفة

12
00:02:56,940 --> 00:02:59,220
.لا فائد من تأنيب نفسكِ

13
00:02:59,240 --> 00:03:02,250
ولكن لماذا كنتِ في ذلك المكان؟

14
00:03:02,280 --> 00:03:03,970
أتعلمين ما يفعلون هناك؟

15
00:03:06,050 --> 00:03:10,510
.ولكنه أخبرني بأن كي يمكنها أن تحصل على ثلاثون أو أربعون ألف

16
00:03:11,790 --> 00:03:12,980
ثلاثون ألف؟

17
00:03:13,990 --> 00:03:15,050
...هذا جنون

18
00:03:17,790 --> 00:03:20,700
.سأسمع باقي القصة بعد الاستحمام

19
00:03:20,730 --> 00:03:24,460
.الجو حار لدرجة أنني أتعرق

20
00:03:34,610 --> 00:03:38,060
لماذا تأخرت هكذا؟ -
.آسف، لقد هربوا مني -

21
00:03:38,080 --> 00:03:40,320
!إذن، لقد فلتوا منك

22
00:03:40,350 --> 00:03:44,330
.لا تهتم. لن يستغرق الأمر وقتًا طويلاً للعثور على مخبأهم

23
00:03:44,350 --> 00:03:45,360
ماذا؟

24
00:03:45,390 --> 00:03:48,100
.لقد كانت فتاة مهذبة، وهو أمر نادر هذه الأيام

25
00:03:48,120 --> 00:03:50,650
.لكنها تركت لنا بطاقة عملها

26
00:03:51,860 --> 00:03:54,100
.وأتساءل عما إذا كانت قد هربت من المنزل

27
00:03:54,130 --> 00:03:55,860
إنها لا تخطط للبقاء هنا، أليس كذلك؟

28
00:03:56,400 --> 00:04:00,060
.لا أريدها أن تصدأ، لكن يجب أن أسمح لها باستخدام الحمام

29
00:04:25,190 --> 00:04:27,130
.آه، هذا شعور جيد

30
00:04:31,170 --> 00:04:33,630
هل ستخرجين يا ساكورا-تشان؟ -
.نعم -

31
00:04:34,000 --> 00:04:36,180
إلى أين؟ التسوق؟

32
00:04:36,200 --> 00:04:37,140
.العمل

33
00:04:37,910 --> 00:04:39,900
.ليس توصيل البيتزا، ولكن مكان مختلف

34
00:04:40,580 --> 00:04:43,040
.في هذه الأوقات العصيبة، عليكِ أن تعمل بجد

35
00:04:46,710 --> 00:04:48,680
.سأتأخر، لذا يمكنكِ أن تخلدي للنوم

36
00:04:49,120 --> 00:04:51,280
.يمكنكِ تناول البيتزا أيضاً

37
00:04:51,920 --> 00:04:54,750
.صحيح، لا يمكنكِ ذلك، أنتِ آلية

38
00:04:55,560 --> 00:04:57,180
.حسنًا، سأحتفظ بها للفطار

39
00:04:58,990 --> 00:05:00,150
.سأخرج الآن

40
00:05:00,530 --> 00:05:03,090
.كوني فتاة مطيعة وانتظريني -
.ساكورا-تشان -

41
00:05:04,970 --> 00:05:08,930
قلت أنني سأستمع لقصتكِ، أليس كذلك؟

42
00:05:10,740 --> 00:05:12,540
أترغبين بالقدوم معي؟

43
00:05:16,280 --> 00:05:19,770
.لقد فهمت، لقد توفي جدكِ

44
00:05:21,820 --> 00:05:27,880
ولكن.. لتصبحي إنسانة.. عليكِ الحصول على ثلاثين ألف صديق؟

45
00:05:28,290 --> 00:05:29,330
حقًا؟

46
00:05:29,360 --> 00:05:31,880
جدكِ كان مريضاً، أليس كذلك؟

47
00:05:34,700 --> 00:05:36,360
هل تعتقدي أنه كان يهذي؟

48
00:05:36,860 --> 00:05:39,580
...ربما … لا، لكن

49
00:05:39,600 --> 00:05:41,210
لا يمكنكِ تصديق ذلك؟

50
00:05:41,240 --> 00:05:44,880
حسنًا… فيما سيفيدك هؤلاء الثلاثون ألف شخص؟

51
00:05:44,910 --> 00:05:47,740
هل سيهرعون إليكِ ويحوّلونكِ إلى إنسانة؟

52
00:05:55,350 --> 00:05:57,340
.كي، أنا آسفة

53
00:05:58,120 --> 00:06:00,680
.أنا دائمًا أفكر في نفسي فقط

54
00:06:01,220 --> 00:06:04,680
.لم أفهم معاناتكِ

55
00:06:05,090 --> 00:06:06,720
.لا بأس

56
00:06:07,200 --> 00:06:09,910
.لنفكّر بالأمر، معًا

57
00:06:09,930 --> 00:06:12,240
ماذا يمكننا أن نفعل لنجعلك بشرية؟

58
00:06:12,270 --> 00:06:15,240
.شقتي ضيقة، ولكن يمكنكِ البقاء بقدر ما تريدي

59
00:06:15,600 --> 00:06:17,800
.شكرًا لكِ، ساكورا-تشان

60
00:06:59,850 --> 00:07:00,970
..مرحبـ

61
00:07:03,890 --> 00:07:05,680
.مساء الخير

62
00:07:07,960 --> 00:07:09,650
.آنسة تشوكاوا

63
00:07:10,190 --> 00:07:13,530
.اسمي كورياغاوا، مرحبًا بك

64
00:07:17,000 --> 00:07:21,110
هل يمكنكِ تشغيل هذه العينة في المتجر؟

65
00:07:21,140 --> 00:07:24,230
...شكرًا لك، سأفعل ذلك

66
00:07:24,740 --> 00:07:27,320
.هذه ميما توكيكو، صديقة طفولتي

67
00:07:27,340 --> 00:07:28,830
.مرحباً، أنا تاتاكي

68
00:07:29,280 --> 00:07:30,440
!مرحبًا

69
00:07:32,650 --> 00:07:35,430
ما هذا؟ أهو مقطع فيديو؟

70
00:07:35,450 --> 00:07:37,130
.إنه بث مباشر من جولة العام الماضي

71
00:07:37,150 --> 00:07:40,500
.الإصدار بعد شهرين من الآن لكن الحفلة الأخيرة بعد يومين

72
00:07:40,520 --> 00:07:43,170
.حتى أنهم يجعلونك تقوم بأعمال التسويق

73
00:07:43,190 --> 00:07:46,140
.لا على الإطلاق. هذه خدمتي الخاصة

74
00:07:46,160 --> 00:07:48,140
.على كل المساعدة التي يمكنني تقديمها لك

75
00:07:48,160 --> 00:07:50,360
.شكرًا لك

76
00:07:53,870 --> 00:07:55,650
.تاتاكي شويتشي

77
00:07:55,670 --> 00:07:58,180
.سمعت أنه رئيس نادي معجبيها

78
00:07:58,210 --> 00:07:59,750
من؟

79
00:07:59,770 --> 00:08:02,150
...بالطبع، الشخصية الرئيسية في هذا الفيديو

80
00:08:02,180 --> 00:08:04,740
.المغنية المشهورة والأعلى مشاهدة أوتسو ميهو

81
00:08:51,730 --> 00:08:54,370
.لقد تغيرت

82
00:08:54,400 --> 00:08:58,780
...لقد كانت مجرد مغنية جيدة وليست بكل هذه الشهرة

83
00:08:58,800 --> 00:09:00,820
.لكنها أصبحت جيدة جدًا مؤخرًا

84
00:09:01,870 --> 00:09:04,650
.مظهرها الفاتن، يجذبك انتباهك بشدة

85
00:09:04,670 --> 00:09:06,420
أتساءل ما سبب جمالها؟

86
00:09:06,440 --> 00:09:08,140
!أعتقد أنها رجل

87
00:09:17,590 --> 00:09:19,960
...هل يمكنكِ تغليف هذا

88
00:09:19,990 --> 00:09:21,960
إلى كوريجاوا ساكورا؟

89
00:09:22,890 --> 00:09:24,450
!كيف يمكن هذا

90
00:09:25,330 --> 00:09:26,990
...تعالي معي قليلاً

91
00:09:27,600 --> 00:09:28,970
.لا تخافي

92
00:09:29,000 --> 00:09:31,120
.يريد الزعيم أن يتحدث معكِ

93
00:09:41,780 --> 00:09:43,690
ماذا تريد؟

94
00:09:43,710 --> 00:09:45,660
ألم تنسِ هذه؟

95
00:09:45,680 --> 00:09:48,330
.فكرت أن أعُيدها لكِ

96
00:09:48,350 --> 00:09:52,700
...مدير عملك كان خائفًا

97
00:09:52,720 --> 00:09:55,600
.حتى أنه أخبرنا بعنوانكِ

98
00:09:55,620 --> 00:09:59,100
.لقد شكرني عدة مرات

99
00:09:59,130 --> 00:10:00,500
لقد تتبعتني، أليس كذلك؟

100
00:10:00,530 --> 00:10:03,010
.لأن الأمر مهم حقًا

101
00:10:03,030 --> 00:10:07,520
.وإلا لما أتيت إلى هنا في منتصف الليل

102
00:10:10,670 --> 00:10:12,680
لماذا أتيتم؟

103
00:10:12,710 --> 00:10:14,150
.مرحبًا، أيتها الفتاة الآلية الصغيرة

104
00:10:14,180 --> 00:10:16,050
.مرحبًا مجددًا

105
00:10:16,080 --> 00:10:20,290
!ماذا؟ لا علاقة لها بالأمر

106
00:10:20,310 --> 00:10:23,460
.بالطبع لا! لن أقحمها في ذلك

107
00:10:23,480 --> 00:10:24,660
.يمكنك الذهاب للمنزل الآن

108
00:10:24,690 --> 00:10:25,630
ماذا؟

109
00:10:25,650 --> 00:10:31,770
.لقد أخبرتك، لدي عمل معكِ، أيتها فتاة البيتزا اللطيفة

110
00:10:31,790 --> 00:10:33,690
.ستصبحين نجمة أفلام

111
00:10:34,900 --> 00:10:38,540
.إن كان الأمر بشأن الدراجة، فشكراً لك

112
00:10:38,570 --> 00:10:40,340
.بل بشأن العمل

113
00:10:40,370 --> 00:10:41,890
لقد انتهينا، أليس كذلك؟

114
00:10:44,210 --> 00:10:46,350
.أريدك أن تعملي معي

115
00:10:46,370 --> 00:10:48,340
.فهمت

116
00:10:49,080 --> 00:10:51,050
هل تودين الظهور لأول مرة في أفلامنا؟

117
00:10:51,080 --> 00:10:55,020
!أنا؟ أنصت لما تقوله

118
00:10:58,990 --> 00:11:00,560
ألم تفهمي بعد؟

119
00:11:00,590 --> 00:11:02,530
.أنتِ لطيفة، ستنجحين في هذا

120
00:11:02,560 --> 00:11:05,000
.أضمن لكِ ذلك

121
00:11:05,030 --> 00:11:07,930
.هذه هي فرصتك، ستصبحين معشوقة الجميع

122
00:11:08,600 --> 00:11:10,240
هل تمزح معي؟

123
00:11:10,260 --> 00:11:14,390
.لا توجد فتاة اليوم ستقع في فخ رخيص كهذا

124
00:11:15,340 --> 00:11:17,920
.أولاً، ليس لدي وقت لذلك

125
00:11:17,940 --> 00:11:21,370
.لدي عمل بتفريغ الشاحنات خلال النهار

126
00:11:23,180 --> 00:11:26,090
..تفريغ شاحنات، وتوصيل البيتزا، ثم العمل في محل فيديوهات

127
00:11:26,110 --> 00:11:29,550
ما رأيك أن أضاعف ما تحصلين عليه منهم جميعًا وأكثر؟

128
00:11:30,850 --> 00:11:32,950
راتب شهر مع 10% من الزيادة؟

129
00:11:33,590 --> 00:11:36,500
ليس سيئًا بالنسبة لراتب مبدئي، صحيح؟

130
00:11:36,520 --> 00:11:37,430
كل هذا؟

131
00:11:37,460 --> 00:11:40,700
هل هذا صحيح؟ أليس هذا مبلغ كبير، ساكورا-تشان؟

132
00:11:40,730 --> 00:11:42,370
.كي، لا تتدخلِ

133
00:11:42,400 --> 00:11:44,560
.لقد قلتِ، أنكِ يجب أن تعملي لجني المزيد من المال

134
00:11:45,200 --> 00:11:47,030
.إنها ليست مسألة مال

135
00:11:49,000 --> 00:11:53,680
.نحن نقوم بالدفع الفوري إننا شركة في النهاية

136
00:11:53,710 --> 00:11:55,890
.لستُ مهمتة بالأمر، حاليًا

137
00:11:55,910 --> 00:11:59,190
.حاليًا؟ فهمت، ستوافقين قريبًا

138
00:11:59,210 --> 00:12:01,730
.مستحيل، لن أفعل

139
00:12:01,750 --> 00:12:04,130
.لقد انتهينا، يمكنك أن تعود لمنزلك

140
00:12:04,150 --> 00:12:07,300
.ولكن هذه فرصة كبيرة

141
00:12:07,320 --> 00:12:08,910
.من أجلي ومن أجلك

142
00:12:23,340 --> 00:12:24,930
كوريجاوا؟

143
00:12:25,710 --> 00:12:27,650
.لدي عمل لأنجزه، لذا وداعاً

144
00:12:27,680 --> 00:12:29,670
.سأعود

145
00:12:30,480 --> 00:12:32,380
.ربما سأزورك المرة القادمة في شقتك

146
00:12:37,720 --> 00:12:38,960
!مهلاً

147
00:12:38,990 --> 00:12:40,630
.إلى اللقاء

148
00:12:40,650 --> 00:12:43,120
إلى اللقاء؟؟
.توقف، أيها الوغد

149
00:12:47,600 --> 00:12:48,490
ماذا؟

150
00:12:49,500 --> 00:12:52,300
.من الواضح أنها لا تريد العمل معك لذا دعها وشأنها

151
00:12:58,010 --> 00:12:59,200
!تاتاكي-سان

152
00:12:59,710 --> 00:13:01,180
...أنا لن

153
00:13:06,750 --> 00:13:08,910
.أسامحك، أيها الوغد

154
00:13:09,720 --> 00:13:11,280
ماذا؟

155
00:13:15,990 --> 00:13:18,220
!أقصدك أنت! أيها الأحمق

156
00:13:43,420 --> 00:13:46,390
.شكراً جزيلاً لك -
.لم أفعل شيء يذكر -

157
00:13:47,150 --> 00:13:49,300
.أنت قوي حقًا

158
00:13:49,320 --> 00:13:52,470
.أعتقد أن هذا بسبب أني محب للفنون القتالية

159
00:13:52,490 --> 00:13:53,540
محب؟

160
00:13:53,560 --> 00:13:57,070
أيجب أن أبقى حتى يغلق المتجر؟

161
00:13:57,100 --> 00:13:59,640
.لا بأس. لا أعتقد أنهم سيرغبون في العودة مرة أخرى

162
00:13:59,670 --> 00:14:01,400
.آمل ذلك

163
00:14:04,710 --> 00:14:06,120
.لا مشكلة

164
00:14:06,140 --> 00:14:10,320
.لكن لن يكون لديك وقت لمشاهدتها إن لم تذهب للمنزل الآن

165
00:14:10,340 --> 00:14:11,250
.هذا صحيح

166
00:14:11,280 --> 00:14:13,360
.رسوم الإرجاع المتأخر باهظة لديكم

167
00:14:13,380 --> 00:14:14,660
.شكرًا لك

168
00:14:14,680 --> 00:14:16,660
.نعم، نعم، نعم

169
00:14:16,680 --> 00:14:19,900
.حسناً، سأرحل الآن. طابت ليلتك آنسة تشوكاوا

170
00:14:19,920 --> 00:14:21,330
.لقد أخبرتك أنه كورياغاوا

171
00:14:21,360 --> 00:14:22,670
...وأيضًا

172
00:14:22,690 --> 00:14:25,200
.إنها ميما -
.اسمي كي -

173
00:14:25,230 --> 00:14:27,990
.طابت ليلتك، كي-تشان

174
00:14:43,080 --> 00:14:45,770
.كي، لقد انتهى البث

175
00:14:54,050 --> 00:14:57,420
.بالطبع، لاعب بيسبول

176
00:14:58,230 --> 00:14:59,840
لاعب بيسبول?

177
00:14:59,860 --> 00:15:03,840
.اللاعب من الدرجة الأولى سيكون لديه 30,000 مشجع بسهولة

178
00:15:03,860 --> 00:15:06,710
.لكن كي فتاة

179
00:15:06,730 --> 00:15:09,150
.إن لم يعجبك فما رأيك في قائد سياسي

180
00:15:09,170 --> 00:15:12,160
ربما لا، ماذا إذن عن قائد ديني؟

181
00:15:13,440 --> 00:15:14,840
التالي؟

182
00:15:15,380 --> 00:15:19,490
!ملك، ملكة، رئيس

183
00:15:19,510 --> 00:15:20,980
التالي؟

184
00:15:23,350 --> 00:15:25,030
..ساكورا-تشان

185
00:15:25,050 --> 00:15:27,400
.أنا آسفة لوضعك في هذا الموقف

186
00:15:27,420 --> 00:15:28,700
.لا مشكلة

187
00:15:28,720 --> 00:15:32,160
أردتِ قبول عرض تاماري، أليس كذلك؟

188
00:15:34,230 --> 00:15:35,840
ما الذي تقولينه؟

189
00:15:35,860 --> 00:15:38,740
...ستتقاضين أجراً كبيرًا

190
00:15:38,770 --> 00:15:42,210
.لكنكِ رفضت لأن كي كانت معكِ

191
00:15:42,240 --> 00:15:45,470
.يا لكِ من سخيفة، إذن كان عليكِ قبوله أولاً

192
00:15:46,310 --> 00:15:49,320
.ستتمكني من الحصول على 30.000 منحرف حينها

193
00:15:49,340 --> 00:15:50,670
..كي

194
00:16:53,710 --> 00:16:56,180
.هذا فظيع

195
00:16:57,510 --> 00:16:59,610
من كان ليفعل هذا؟

196
00:17:00,110 --> 00:17:01,660
.أنا

197
00:17:01,680 --> 00:17:03,380
سيدي؟

198
00:17:05,790 --> 00:17:08,150
.أنا من فعل ذلك

199
00:17:14,600 --> 00:17:16,340
.نفس الشيء

200
00:17:16,360 --> 00:17:19,160
.لم يتغير شيء منذ ذلك الحين

201
00:17:51,300 --> 00:17:53,510
كيف تنامين هكذا؟

202
00:17:53,530 --> 00:17:55,780
.أنا ذاهبة للعمل، ساكورا

203
00:17:55,800 --> 00:17:58,430
"عليكِ أن

204
00:17:55,800 --> 00:17:58,430
تستحمي"

205
00:17:55,800 --> 00:17:58,430
تستحمي!"

206
00:18:27,070 --> 00:18:29,650
.سيدي، مقابلتك شرف لي

207
00:18:29,670 --> 00:18:31,850
.أعتقد أننا نستطيع إنهاء العمل قبل الغد

208
00:18:31,870 --> 00:18:34,150
.بالطبع، لن ننام حتى ننتهي

209
00:18:34,170 --> 00:18:36,190
لقد عملنا على مدار 24 ساعة

210
00:18:36,210 --> 00:18:39,420
،أعتقد أنه قد يكون سطحيًا قليلًا في البداية

211
00:18:39,450 --> 00:18:43,210
.ولكن بمجرد أن بدأنا، أصبح لدينا بيت مكتمل

212
00:18:43,680 --> 00:18:45,740
.لا نفكر إلا في العمل

213
00:18:50,220 --> 00:18:52,690
.أرى ذلك كل الشكر لمجموعتك

214
00:18:53,130 --> 00:18:54,370
..بالطبع

215
00:18:54,390 --> 00:18:58,660
.نجاح الجولة كان بسبب موهبة ميهو وشعبيتها

216
00:18:59,300 --> 00:19:03,910
.أنا سعيد لأننا تمكنا من المساعدة في ذلك قليلاً

217
00:19:03,940 --> 00:19:07,950
.تريد ميهو إلغاء ظهورها على المسرح غدًا

218
00:19:07,980 --> 00:19:10,950
هل هي مريضة؟ -
.لا يمكنها أن تنهض -

219
00:19:10,980 --> 00:19:15,110
.أخبرها أن تغني وهي جالسة -
.بالإضافة إلى أن السيد دي قد عاد -

220
00:19:21,590 --> 00:19:22,950
..هذا الإعداد

221
00:19:25,060 --> 00:19:26,250
.حطمه في الحال

222
00:19:29,100 --> 00:19:29,870
سيدي؟

223
00:19:29,900 --> 00:19:32,880
.استخدم الإعداد الأخير لها في بدايتها

224
00:19:32,900 --> 00:19:36,530
...لكن، لكن، سيدي

225
00:19:36,870 --> 00:19:40,250
...لندعهم يروا مهيو كما هي في البداية

226
00:19:40,270 --> 00:19:43,140
.بدون أي مساعدة من المجموعة

227
00:19:45,480 --> 00:19:49,780
!ساعتين إضافتين من العمل

228
00:19:59,930 --> 00:20:03,520
.كي

229
00:20:12,940 --> 00:20:15,240
!كي! كي

230
00:20:17,580 --> 00:20:20,090
هل أنتِ بخير، كي؟

231
00:20:20,110 --> 00:20:22,420
هل هناك شيء بكِ يا كي؟

232
00:20:22,450 --> 00:20:24,990
.يد كي مجعدة جدًا

233
00:20:25,020 --> 00:20:28,530
كم مضى على فقدان وعيك؟

234
00:20:28,560 --> 00:20:31,120
.لو كان الدش بارداً لكنتِ ميتة الآن

235
00:20:33,830 --> 00:20:36,270
ما الأمر؟ فقر الدم؟

236
00:20:36,300 --> 00:20:38,340
تسرب الزيت؟ تسرب كهربائي؟

237
00:20:38,370 --> 00:20:39,710
.كي لا تعرف

238
00:20:39,730 --> 00:20:41,810
كي لا تعلم لماذا كانت نائمة؟

239
00:20:41,840 --> 00:20:44,200
ألا تتذكرين شيء؟

240
00:20:53,250 --> 00:20:56,440
.كي، يكفي هذا.. يكفي

241
00:20:59,220 --> 00:21:02,990
.ليس عليكِ أن تضغطي على نفسك

242
00:21:42,600 --> 00:21:43,930
ماذا..؟

243
00:21:49,940 --> 00:21:52,810
سيرغي؟
ماذا عن..؟

244
00:21:52,840 --> 00:21:54,880
"ما هو وضع "ب-ب-أ-ر

245
00:21:54,910 --> 00:21:58,280
.فشل فحصنا في تحديد مشكلة في الآلي

246
00:21:58,750 --> 00:22:01,410
.لذلك، لقد جلبته في الشاحنة

247
00:22:05,150 --> 00:22:09,150
