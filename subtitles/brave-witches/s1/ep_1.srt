1
00:00:07,150 --> 00:00:09,240
‏1939

2
00:00:09,240 --> 00:00:13,190
وجدت البشريّة نفسها فجأة في مواجهة
مع خصم غامض

3
00:00:13,630 --> 00:00:16,330
أطلقوا عليه اسم نيوروي

4
00:00:32,100 --> 00:00:33,090
،في طرفة عين

5
00:00:33,090 --> 00:00:36,390
نجح نيوروي في اجتياح معظم أوروبّا

6
00:00:36,390 --> 00:00:39,550
مشرّداً الكثير من الناس عن منازلهم وبلادهم

7
00:00:43,650 --> 00:00:49,240
لمحاربة النيوروي، طوّرَت البشريّة سلاحاً جديداً

8
00:00:49,240 --> 00:00:54,510
وِحدات الهجوم الطّائرة التي لا يستطيع
استخدامها سوى السّاحرات

9
00:00:54,510 --> 00:00:56,530
وهُن فتيات بقوى سحريّة

10
00:00:57,390 --> 00:01:03,150
اجتمعت السّاحرات من كلّ أنحاء العالم لاستخدام
وحدات الهجوم هذه ضدّ النيوروي

11
00:01:03,680 --> 00:01:06,050
تمّ تشكيل فرقة من هذه السّاحرات

12
00:01:08,500 --> 00:01:12,430
الجناح القتالي المُشترَك 502 لقوّات التّحالف

13
00:01:13,060 --> 00:01:17,650
"أطلق عليهم النّاس اسم "السّاحرات الشُجاعات

14
00:03:51,500 --> 00:03:53,410
!صباح الخير

15
00:03:54,510 --> 00:03:55,550
!أبي

16
00:03:56,490 --> 00:03:57,780
تفضّل غدائك

17
00:03:57,780 --> 00:03:59,830
شكراً

18
00:03:59,830 --> 00:04:01,970
حسناً؟ هل أصلحت المُستقبِل؟

19
00:04:01,970 --> 00:04:04,590
أجل، أصلحَه بلمح البصر

20
00:04:04,590 --> 00:04:05,530
!رائع

21
00:04:05,530 --> 00:04:06,840
!هذا هو أبي الذي عهدتُه

22
00:04:07,200 --> 00:04:10,310
...لا أدري متى قد نتلقّى رسالة هامّة

23
00:04:10,660 --> 00:04:12,350
المهندس كاريبوتشي منقذنا

24
00:04:12,610 --> 00:04:16,690
تستطيع محطّة الإرسال تغطية كلّ المسافة
إلى جزيرة البحر الجنوبي، أليس كذلك؟

25
00:04:16,730 --> 00:04:19,900
أجل، إنّه برج الراديو الأطول في فوسو

26
00:04:19,900 --> 00:04:21,650
!رائع

27
00:04:21,840 --> 00:04:23,560
حضرة مساعد الملازم ميزونوما، رسالة

28
00:04:24,110 --> 00:04:24,880
رسالة؟

29
00:04:26,840 --> 00:04:27,820
هكذا إذاً

30
00:04:28,200 --> 00:04:31,810
ستصلُ فرقة حامِلة الطائرات الثّالثة
إلى الميناء بعد الظهر

31
00:04:31,810 --> 00:04:32,780
فرقة حامِلة الطائرات الثّالثة؟

32
00:04:32,940 --> 00:04:34,030
!إنّها أختي الكبيرة

33
00:04:34,300 --> 00:04:38,490
أجل، مُساعدة المُلازم كاريبوشي تاكامي
بطلة ساسيبو، عائدة إلى الدّيار

34
00:04:38,490 --> 00:04:40,160
!رائع

35
00:04:42,730 --> 00:04:44,710
أختي الكبيرة ستعود

36
00:04:48,500 --> 00:04:50,610
أشعرُ أنّني أستطيع فعلها اليوم

37
00:05:03,870 --> 00:05:04,770
!واحد

38
00:05:06,330 --> 00:05:07,070
!اثنان

39
00:05:09,520 --> 00:05:10,150
–ثلاثة

40
00:05:16,600 --> 00:05:17,910
!عُدت

41
00:05:17,910 --> 00:05:19,110
...يا للهول

42
00:05:19,110 --> 00:05:21,330
لم تستطيعي عبوره مجدّداً اليوم؟

43
00:05:21,330 --> 00:05:24,350
!انسي ذلك! يقولون أنّ أختي ستعود اليوم

44
00:05:24,350 --> 00:05:25,540
تاكامي؟

45
00:05:25,540 --> 00:05:27,590
دائماً ما تأتي تلك الفتاة فجأة

46
00:05:27,760 --> 00:05:30,140
بسبب مهمّتها. ليس بيدها حيلة

47
00:05:31,510 --> 00:05:33,230
!أراكِ لاحقاً

48
00:05:33,230 --> 00:05:34,690
انتظري! ألن تبدّلي ملابسكِ؟

49
00:05:34,690 --> 00:05:36,010
!ستجفُّ بينما أركض

50
00:05:42,670 --> 00:05:44,170
!التّالية! آكياما

51
00:05:44,170 --> 00:05:44,690
حاضرة

52
00:05:57,070 --> 00:05:59,410
!جسدكِ لا يتساير مع المحرّك

53
00:05:59,410 --> 00:06:00,810
!عشر دورات في السّاحة

54
00:06:00,810 --> 00:06:02,050
!التّالية! واتانابي

55
00:06:02,050 --> 00:06:02,510
حاضرة

56
00:06:04,600 --> 00:06:07,110
سمعتُ أنّ مساعدة المُلازم كاريبوتشي ستعود

57
00:06:07,110 --> 00:06:09,260
أجل، من تدريب قوّات التحالف البحريّة

58
00:06:09,260 --> 00:06:10,600
مضَتْ ثلاثة أشهر

59
00:06:10,600 --> 00:06:11,890
إنّها مذهلة للغاية

60
00:06:11,890 --> 00:06:14,540
لا أصدّق أنّهم عيّونها في فرقة حاملة الطائرات

61
00:06:15,550 --> 00:06:16,630
...صحيح

62
00:06:16,630 --> 00:06:20,770
الفيلم التّالي الذي يُنتجونه يحكي
عن أيّامها التي قضتها في أوروبّا، صحيح؟

63
00:06:20,890 --> 00:06:21,900
!أجل

64
00:06:21,900 --> 00:06:25,860
!دحرت قوّات العدوّ بمفردها أثناء الانسحاب من ليباو

65
00:06:25,860 --> 00:06:28,330
!إنّها حقّاً بطلة ساسيبو

66
00:06:29,100 --> 00:06:34,820
لا بدّ وأنّ مُساعدة المُلازم كاريبوتشي حزينة
بوجود أخت فاشلة لها مثلكِ

67
00:06:35,040 --> 00:06:36,050
...ميسومي-سان

68
00:06:36,050 --> 00:06:37,930
!ماذا؟ ما الذي يعنيه هذا؟

69
00:06:38,380 --> 00:06:39,790
يعني ما عنيتُه تماماً

70
00:06:39,790 --> 00:06:41,250
!التّالية! ميسومي

71
00:06:41,250 --> 00:06:42,140
حاضرة

72
00:06:45,540 --> 00:06:47,650
لا تدعيها تهزمكِ يا هيكاري

73
00:06:47,650 --> 00:06:48,710
نعم

74
00:06:51,420 --> 00:06:52,770
!مُناورة مِثقاب

75
00:06:52,770 --> 00:06:54,430
!هذه مُناورة طلّاب في مرحلة متقدّمة

76
00:06:56,450 --> 00:06:57,350
!حسناً

77
00:07:00,950 --> 00:07:02,470
!التّالية! كاريبوتشي

78
00:07:02,470 --> 00:07:03,010
حاضرة

79
00:07:05,360 --> 00:07:06,390
!أستطيعُ فعل ذلك أيضاً

80
00:07:10,790 --> 00:07:11,740
إنّها تدور؟

81
00:07:14,990 --> 00:07:15,730
!هيكاري

82
00:07:18,340 --> 00:07:19,690
...مؤلم

83
00:07:20,000 --> 00:07:20,990
!هل أنتِ غبيّة؟

84
00:07:21,440 --> 00:07:23,490
!أي أحمق يسقطُ من سماء خالية من الأعداء؟

85
00:07:23,810 --> 00:07:25,290
!أريد عشرين دورة

86
00:07:25,830 --> 00:07:26,710
!حاضرة

87
00:07:26,710 --> 00:07:27,630
مثيرة للشفقة

88
00:07:28,730 --> 00:07:32,000
لا أصدّق أنّكِ أخت كاريبوتشي تاكامي الصّغرى

89
00:07:32,000 --> 00:07:33,290
بطلة ساسيبو

90
00:07:33,340 --> 00:07:35,370
تحصلين على علامة ف.س

91
00:07:35,370 --> 00:07:37,800
أتعتقدين نفسكِ قادرة على الانضمام لفرقة ساحرات؟

92
00:07:37,800 --> 00:07:40,300
بلى! وهل من مُشكلة في ذلك؟

93
00:07:40,780 --> 00:07:42,980
!سأكون ساحرة مثل أختي

94
00:07:44,000 --> 00:07:45,730
أنتِ غبيّة متفائلة بإفراط

95
00:07:47,990 --> 00:07:49,580
!التّالية! كوباياشي

96
00:07:49,750 --> 00:07:50,480
حاضرة

97
00:07:54,590 --> 00:07:55,860
!وداعاً

98
00:07:55,870 --> 00:07:57,440
إنّها تركض مجدّداً

99
00:07:57,440 --> 00:07:59,250
لديها أعلى لياقة في المدرسة كلّها

100
00:07:59,950 --> 00:08:02,690
...ليت قوّتها السحريّة بنفس درجة لياقتها

101
00:08:27,220 --> 00:08:28,140
!أختي

102
00:08:31,190 --> 00:08:32,980
!أختي

103
00:08:33,380 --> 00:08:35,820
—أنا هنا

104
00:08:44,270 --> 00:08:46,070
عُدتُ يا هيكاري

105
00:08:46,070 --> 00:08:48,070
!أهلاً بعودتكِ يا أختي

106
00:08:52,170 --> 00:08:53,830
تأخّرَتْ تاكامي-تشان

107
00:08:54,180 --> 00:08:56,840
...أريدُ الاستماع لحديثنا عن ليباو مجدّداً

108
00:08:57,130 --> 00:08:57,960
ها هي ذي

109
00:08:58,810 --> 00:09:00,480
!يا لها من سيّارة فاخرة

110
00:09:00,480 --> 00:09:03,210
هذا بديهي، فهي بطلة ساسيبو

111
00:09:06,230 --> 00:09:07,540
!هيكاري

112
00:09:08,550 --> 00:09:10,020
...عُدت

113
00:09:11,620 --> 00:09:13,180
لقد عُدت

114
00:09:14,690 --> 00:09:16,690
!هذه تاكامي-تشان التي نعرفها

115
00:09:18,820 --> 00:09:21,250
آسفة على كلّ تِلك الإزعاجات

116
00:09:21,250 --> 00:09:22,740
أنا متأكّدة أنّكِ بحاجةٍ للاسترخاء

117
00:09:23,020 --> 00:09:25,820
لا، هذا يجعلُني أكثر استرخاء

118
00:09:25,820 --> 00:09:27,160
!انظري إلى هذا يا أختي

119
00:09:27,490 --> 00:09:28,340
!مفاجأة

120
00:09:28,340 --> 00:09:29,660
!إنّها مقالات عنكِ

121
00:09:30,190 --> 00:09:31,950
احتفظَتْ بها كلّها

122
00:09:33,910 --> 00:09:35,530
...هذا مُحرِج

123
00:09:35,530 --> 00:09:37,200
لا،ل يس كذلك

124
00:09:37,200 --> 00:09:40,560
هذا دليلٌ على أنّكِ تبلين بلاء حسناً كساحرة

125
00:09:40,560 --> 00:09:43,300
آه تذكّرت! عليّ تفقّد صحيفة اليوم

126
00:09:43,990 --> 00:09:45,060
!مقالة حول السّاحرات

127
00:09:45,600 --> 00:09:50,060
الرّائدة ساكاموتو تسعى وتُكافِح كعضو"

128
00:09:50,060 --> 00:09:54,660
"في الجناح القتالي المُشترَك 501، ساحِرات الهجوم

129
00:09:54,660 --> 00:09:57,680
أختي، هل تعرفين الرّائدة ساكاموتو؟

130
00:09:57,680 --> 00:10:00,190
كنتُ معها أثناء الانسحاب من ليباو

131
00:10:00,530 --> 00:10:03,740
كانتْ حادّة الطبع لكنّها جديرة بالاحترام

132
00:10:08,050 --> 00:10:10,250
هل هي ساحرة فوسو أيضاً؟

133
00:10:10,250 --> 00:10:12,000
...لا أدري

134
00:10:12,000 --> 00:10:16,000
إذا تمّ تعيين ساحرة فوسو في جناح
قتالي مُشترَك

135
00:10:16,000 --> 00:10:18,370
...لوردَ ذلك في الأخبار

136
00:10:22,910 --> 00:10:25,620
!مضَتْ فترة طويلة مُذ استرخيتُ في حمّام

137
00:10:26,040 --> 00:10:28,420
الماء ثمين في سفينة، صحيح؟

138
00:10:28,420 --> 00:10:29,560
أجل

139
00:10:29,950 --> 00:10:32,010
...أختي، أريني إيّاها

140
00:10:33,100 --> 00:10:34,340
مجدّداً؟

141
00:10:38,850 --> 00:10:40,780
هل النظر إلى ندبة مسلٍّ إلى هذا الحدّ؟

142
00:10:41,110 --> 00:10:45,630
لكن تلقّيتِ هذا الجرح بينما تُقاتلين
لحماية الجميع أثناء انسحاب ليباو، صحيح؟

143
00:10:45,630 --> 00:10:47,210
!إنّها رائعة للغاية

144
00:10:47,940 --> 00:10:50,380
!أنتِ تدغدغينني

145
00:10:51,350 --> 00:10:52,740
صحيح يا أختي

146
00:10:52,740 --> 00:10:55,250
!افتُتِحَتْ صالةٌ جديدة بالقرب من المحطّة

147
00:10:55,450 --> 00:10:59,660
انتهَتْ بعثتكِ، لِذا ستمكثين في ساسيبو
لبعض الوقت، أليس كذلك؟

148
00:11:00,730 --> 00:11:01,730
ما الخطب؟

149
00:11:02,060 --> 00:11:03,670
،في الحقيقة يا هيكاري

150
00:11:03,670 --> 00:11:07,390
عندما وصلتُ إلى الميناء اليوم، تلقّيتُ أوامر جديدة

151
00:11:07,790 --> 00:11:08,720
أوامر؟

152
00:11:10,020 --> 00:11:13,720
سيتمّ إرسالي إلى أوروبّا

153
00:11:16,350 --> 00:11:17,540
أوروبّا؟

154
00:11:32,600 --> 00:11:34,160
صباح الخير يا أمّي

155
00:11:35,030 --> 00:11:36,000
صباح النّور

156
00:11:36,000 --> 00:11:36,830
أين هيكاري؟

157
00:11:45,590 --> 00:11:49,680
سيتمّ إرسالي إلى أوروبّا

158
00:11:50,150 --> 00:11:53,660
ستغيب أختي مجدّداً

159
00:11:55,380 --> 00:11:56,370
!هيكاري

160
00:11:59,170 --> 00:11:59,830
!أختي

161
00:12:08,040 --> 00:12:11,040
حاولي أن تقفزي في الهواء قبل أن تستشعري
الماء بقدميكِ

162
00:12:20,500 --> 00:12:21,600
هيكاري؟

163
00:12:24,190 --> 00:12:25,890
...كان ذلك وشيكاً

164
00:12:32,060 --> 00:12:33,560
...اسمعوا جميعاً

165
00:12:34,320 --> 00:12:37,820
كما تعلمون، الوضع في أوروبّا مروع

166
00:12:38,240 --> 00:12:41,230
هُم بحاجةٍ لمزيد من السّاحرات، وبشكلٍ فوريّ

167
00:12:41,690 --> 00:12:47,230
وبالتالي، ستختارُ مدرستنا متطوّعة للانتقال إلى أوروبّا

168
00:12:47,570 --> 00:12:49,960
انتقال إلى أوروبّا؟

169
00:12:49,960 --> 00:12:54,000
وبما أنّ من سينتقِل سيكون تلميذاً
فلن يتمّ نقله إلى خطوط الجبهة البعيدة

170
00:12:54,370 --> 00:12:56,460
لكن لك تكون المهمّة سهلة

171
00:13:01,400 --> 00:13:04,350
...أنتِ عرّيفة صفّ السنة الأولى

172
00:13:04,880 --> 00:13:06,460
ميسومي ميا

173
00:13:06,460 --> 00:13:09,980
أنا تلميذة في السنة الأولى لكنّني أؤمن
بأنّ مهارتي ستكونُ أكثر من كافية

174
00:13:11,390 --> 00:13:12,980
!أنا أتطوّعُ أيضاً

175
00:13:13,880 --> 00:13:16,230
!كاريبوتشي هيكاري سنة أولى

176
00:13:17,330 --> 00:13:18,100
أنتِ؟

177
00:13:18,100 --> 00:13:20,360
!أريدُ الذهاب إلى أوروبّا أيضاً

178
00:13:21,540 --> 00:13:22,710
عظيم

179
00:13:22,710 --> 00:13:26,990
بعد ثلاثة أيّام، سنقيمُ امتحانَ اختيار لنرى
من منكما أكثر تأهيلاً

180
00:13:28,860 --> 00:13:30,380
امتحان اختيار؟

181
00:13:30,680 --> 00:13:31,290
أجل

182
00:13:31,290 --> 00:13:34,610
!إذا هزمتُ ميسومي-سان هناك، أستطيعُ الذهاب إلى أوروبّا

183
00:13:35,010 --> 00:13:38,110
لكن هل هُم مُستميتون للحصول على ساحِرات؟

184
00:13:38,110 --> 00:13:41,250
لم تتخرّجي من المدرسةِ بعد

185
00:13:41,630 --> 00:13:46,050
حتّى تاكامي انتظرَتْ حتّى تخرّجَتْ من المدرسة
للانضمام للجيش

186
00:13:46,050 --> 00:13:49,210
!لكنّها تخرّجَتْ وهي في مثل سنِّي

187
00:13:49,210 --> 00:13:51,500
لأنّها مُنِحَتْ ترقيات خاصّة

188
00:13:51,500 --> 00:13:56,410
ألا تقولين لي دوماً أنّه على السّاحرة
أن تسعى لخدمة الآخرين؟

189
00:13:56,410 --> 00:13:58,380
!لِمَ لا أستطيع الذهاب؟

190
00:13:59,050 --> 00:14:01,220
!فأنا ساحرةٌ أيضاً

191
00:14:02,320 --> 00:14:03,300
...هيكاري

192
00:14:05,090 --> 00:14:06,870
!انتظرا

193
00:14:17,690 --> 00:14:18,590
...هيكاري

194
00:14:20,230 --> 00:14:24,840
في كلّ يوم، أتّبع نفس النّهج الذي اتّبعتِه

195
00:14:24,840 --> 00:14:26,940
أخضعُ لنفس التّدريب

196
00:14:27,910 --> 00:14:30,350
،ظننتُ أنّني إذا استطعتُ عبور البحر مثلكِ

197
00:14:30,350 --> 00:14:32,600
فقد أصِل إلى مستواكِ

198
00:14:33,530 --> 00:14:35,730
إذا رسبتُ في الامتحان فسأستسلم

199
00:14:36,300 --> 00:14:39,630
فساحرة ضعيفة في أوروبّا لن تسبّب
إلّا المتاعب للجميع

200
00:14:40,120 --> 00:14:43,350
لكن لا أريد أن أستسلم دون القيام بأي شيء

201
00:14:45,880 --> 00:14:48,290
!بالتأكيد، حظّاً سعيداً يا هيكاري

202
00:14:51,760 --> 00:14:55,100
سنبدأ الآن بامتحان تحديد من سيذهبُ إلى أوروبّا

203
00:14:55,490 --> 00:14:57,860
الامتحان يستندُ على معركةٍ فعليّة

204
00:14:58,410 --> 00:14:59,840
ستُمنَح المُتشاركتان أسلحة

205
00:14:59,840 --> 00:15:03,370
ويُطلَب منهما إنجاز مهام ضمن الوقت المُخصَّص

206
00:15:04,670 --> 00:15:06,710
إذا لم تتخطّيا نقاط العبور

207
00:15:06,710 --> 00:15:09,250
أو تنهيا الامتحان في الوقت، سترسبان

208
00:15:10,160 --> 00:15:12,030
،إذا نجحَتْ كلا المُتشاركتَين

209
00:15:12,030 --> 00:15:14,770
سيتمّ اختيار الأسرع للانتقال

210
00:15:19,630 --> 00:15:20,510
!استعداد

211
00:15:34,820 --> 00:15:36,550
لا أحبّ تلك الغيوم

212
00:15:36,870 --> 00:15:39,530
سماء أوروبّا ليسَتْ رقيقة تماماً

213
00:15:40,430 --> 00:15:41,630
معكِ حقّ

214
00:15:43,460 --> 00:15:44,810
هذا الامتحان هو مضيعةٌ للوقت

215
00:15:45,200 --> 00:15:48,740
مُحال أن تتمكّني من هزيمتي وأنتِ تعلمين ذلك

216
00:15:48,740 --> 00:15:51,050
!لا نعلم ما لم نجرّب

217
00:15:51,250 --> 00:15:53,830
!سألقّنكِ ذلك تلقيناً إذاً

218
00:16:08,000 --> 00:16:09,570
لا مُقارنة على الإطلاق

219
00:16:18,500 --> 00:16:20,680
السّاحرتان تقتربان

220
00:16:21,010 --> 00:16:26,970
سيادة المُشير، هل من فائدة من إرسال تلميذة
عديمة الخبرة إلى أوروبّا؟

221
00:16:27,760 --> 00:16:30,660
لا يجوز أن نتجاهل مطالب الأوروبّيين

222
00:16:30,660 --> 00:16:33,440
فلا أحد يعلم متى قد تُصبح بلدنا منطِقة حرب

223
00:16:34,170 --> 00:16:38,520
وأنتِ قد بدأتِ أيضاً كمُبتدئة، أليس كذلك يا شيندو-كُن؟

224
00:16:40,510 --> 00:16:41,430
ها هما

225
00:17:00,130 --> 00:17:02,700
إنّها تتحرّك بشكلٍ جيّد جدّاً

226
00:17:14,480 --> 00:17:17,210
أتِلك هي أخت مُساعدة المُلازم كاريبوتشي الصّغرى؟

227
00:17:17,210 --> 00:17:18,030
أجل

228
00:17:20,320 --> 00:17:21,940
ستعصُف

229
00:17:22,400 --> 00:17:25,170
لن يُهاجم العدوّ في الأوقات التي تناسبُنا دوماً

230
00:17:29,560 --> 00:17:31,280
...يدخلُ المطرُ إلى عينيّ

231
00:17:31,720 --> 00:17:33,200
!ملابسي ثقيلة

232
00:17:43,790 --> 00:17:45,550
تقترِب؟

233
00:17:46,880 --> 00:17:49,430
ألا تنقص سرعتها في هذا الطّقس؟

234
00:17:49,430 --> 00:17:51,090
من أين لها كلّ هذه اللّياقة؟

235
00:17:58,190 --> 00:18:00,420
!اقتربت... اقتربت

236
00:18:01,740 --> 00:18:04,660
إن لم أنقص القوّة السحريّة التي أستهلكُها، ستُجاريني

237
00:18:13,200 --> 00:18:14,910
!بقي نقطة عبور واحدة

238
00:18:15,290 --> 00:18:16,630
ابتعدَتْ مجدّداً

239
00:18:17,200 --> 00:18:18,520
...في هذه الحالة

240
00:18:19,370 --> 00:18:20,340
!انتبهي

241
00:18:31,260 --> 00:18:33,220
رسالة من نقطة العبور الأخيرة

242
00:18:33,480 --> 00:18:36,460
لا ميسومي ولا كاريبوتشي قد وصلتا

243
00:18:36,460 --> 00:18:37,600
ماذا؟

244
00:18:43,080 --> 00:18:43,980
!ميسومي-سان

245
00:18:49,350 --> 00:18:52,710
!ميسومي-سان

246
00:18:54,370 --> 00:18:55,660
...كاريبوتشي-سان

247
00:19:03,770 --> 00:19:04,620
!واحد

248
00:19:06,030 --> 00:19:06,820
!اثنان

249
00:19:12,900 --> 00:19:13,920
!ثلاثة

250
00:19:22,080 --> 00:19:23,550
...كاريبوتشي

251
00:19:28,500 --> 00:19:31,450
!ميسومي-سان

252
00:19:35,880 --> 00:19:37,610
أنا مسرورةٌ للغاية

253
00:19:38,640 --> 00:19:39,920
...كاريبوتشي-سان

254
00:19:40,520 --> 00:19:43,290
شكراً لكِ على إنقاذي

255
00:19:44,190 --> 00:19:45,850
...لم أفعل

256
00:19:49,600 --> 00:19:53,170
لقد... عبرتُ البحر

257
00:19:53,980 --> 00:19:54,930
فعلتُها

258
00:19:55,200 --> 00:19:56,850
!فعلتُها

259
00:19:56,850 --> 00:19:58,510
!فعلتُها يا ميسومي-سان

260
00:19:58,880 --> 00:20:00,280
!شكراً لكِ

261
00:20:00,900 --> 00:20:01,550
ماذا؟

262
00:20:02,350 --> 00:20:04,510
تمكّنَتْ من عبور ذلك البحر؟

263
00:20:07,820 --> 00:20:12,500
،بما أنّ كِلينا لم نتمكّن من الوصول في الوقتِ المُحدَّد

264
00:20:12,500 --> 00:20:14,100
رسبنا في الامتحان

265
00:20:23,480 --> 00:20:25,640
...تبدين سعيدة يا هيكاري

266
00:20:26,350 --> 00:20:28,260
،رسبتُ في الامتحان

267
00:20:28,260 --> 00:20:31,550
لكن أشعرُ أنّني اقتربتُ منكِ قليلاً

268
00:20:32,190 --> 00:20:37,440
سأضاعفُ جهودي كي أستطيع التّحليق معكِ

269
00:20:37,820 --> 00:20:38,560
نعم

270
00:20:38,820 --> 00:20:39,800
!سأنتظرُكِ

271
00:20:44,810 --> 00:20:46,910
!صباح الخير

272
00:20:47,270 --> 00:20:49,100
مُساعدة المُلازم معكِ اليوم؟

273
00:20:49,100 --> 00:20:50,260
صباح الخير

274
00:20:51,360 --> 00:20:53,720
تفضّل غدائك يا أبي

275
00:20:53,720 --> 00:20:55,310
شكراً

276
00:20:56,200 --> 00:20:57,810
رسالة واردة يا حضرة مُساعد المُلازم

277
00:21:01,570 --> 00:21:02,810
إنّها لهيكاري-تشان

278
00:21:03,710 --> 00:21:04,560
لي أنا؟

279
00:21:07,140 --> 00:21:08,840
إنّها من الأركان العامّة لقوّات البحريّة

280
00:21:09,840 --> 00:21:13,430
نجحَتْ كاريبوتشي هيكاري في امتحانها"

281
00:21:13,430 --> 00:21:16,330
"استعدّي للانتقال إلى أوروبّا

282
00:21:16,330 --> 00:21:18,030
...هل هذا

283
00:21:18,030 --> 00:21:19,360
!فعلتِها يا هيكاري

284
00:21:19,360 --> 00:21:22,080
!نجحتِ! يمكننا السّفر إلى أوروبّا معاً

285
00:21:25,800 --> 00:21:27,210
...نجحت

286
00:21:28,150 --> 00:21:29,660
أنا نجحت؟

287
00:21:32,390 --> 00:21:34,330
هذا لأنّكِ بذلتِ مجهوداً كبيراً

288
00:21:35,870 --> 00:21:38,030
!فعلتُها! فعلتُها

289
00:21:38,030 --> 00:21:39,950
!فعلتُها

290
00:21:42,550 --> 00:21:48,960
في نفس الوقت، كان يتكوّنُ عشُّ نيوروي جديد في أوروبّا

291
00:21:51,940 --> 00:21:54,940
يتبع

292
00:23:25,990 --> 00:23:30,130
بكثير من الطموحات والآمال في قلوبنا
أتوجّه أنا وأختي إلى أوروبّا

293
00:23:30,130 --> 00:23:32,110
لكن يُهاجم النيوروي فجأة

294
00:23:32,110 --> 00:23:34,800
!انتظري يا أختي! سأقاتلُ معكِ

295
00:23:34,930 --> 00:23:38,490
:الحلقة القادمة من ساحِرات شُجاعات
!حلِّقي يا تشيدوري