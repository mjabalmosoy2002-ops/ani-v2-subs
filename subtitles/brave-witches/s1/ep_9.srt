1
00:00:05,030 --> 00:00:07,700
هجوم نيوروي أثناء طيراننا التجريبي؟

2
00:00:08,550 --> 00:00:09,860
...إنّه قويّ

3
00:00:09,860 --> 00:00:11,450
!سيكون هذا ممتعاً

4
00:00:14,620 --> 00:00:17,140
!قاوِم قبضتَيّ

5
00:00:18,670 --> 00:00:19,670
!حلّقت نحوه مباشرة

6
00:00:21,430 --> 00:00:22,770
...مرّة أخرى

7
00:00:30,110 --> 00:00:32,600
!تسوروغي إيسّين

8
00:00:37,780 --> 00:00:38,780
ما رأيك؟

9
00:00:38,780 --> 00:00:41,560
!الآن بعدما حصلتُ على شيدان كاي، أنا لا أُقهَر

10
00:00:44,170 --> 00:00:45,530
حقّاً؟

11
00:00:47,950 --> 00:00:49,610
!كانّو-سان

12
00:02:33,270 --> 00:02:36,060
،بسببِ شظايا النيوروي التي علِقَتْ في المَسرَب

13
00:02:36,060 --> 00:02:38,440
تضرّرت العنفة السحريّة

14
00:02:38,440 --> 00:02:40,810
أنتِ ضابطة طيران الآن يا كانّو-سان

15
00:02:40,810 --> 00:02:42,790
عليكِ الاعتناء بجهازكِ بشكل أفضل

16
00:02:42,980 --> 00:02:44,920
!رتبتي غير مهمّة

17
00:02:44,920 --> 00:02:47,500
عملي الوحيد هو هزيمة النيوروي

18
00:02:49,680 --> 00:02:50,680
هيكاري-سان؟

19
00:02:50,680 --> 00:02:51,880
نعم؟

20
00:02:51,880 --> 00:02:55,110
لا تتشبّهي بالساحرات الكاسِرات، اتّفقنا؟

21
00:02:55,850 --> 00:02:58,620
ساحرات كاسِرات؟

22
00:02:58,620 --> 00:03:02,520
فتيات ثلاثة يتصرّفن بجنون ويكسرن أجهزتهن

23
00:03:02,810 --> 00:03:04,580
أولاً، نيبّا-سان

24
00:03:04,580 --> 00:03:07,100
أ... أنا لا أحطّم أجهزتي

25
00:03:07,100 --> 00:03:08,160
تتحطّم من تلقاء نفسها

26
00:03:08,430 --> 00:03:10,250
وأيضاً كانّو-سان

27
00:03:10,790 --> 00:03:12,280
أنا أدمِّر النيوروي، صحيح؟

28
00:03:12,280 --> 00:03:14,100
!لا مانع لديّ إذا تحطّمت أجهزتي

29
00:03:14,100 --> 00:03:17,240
وكروبينسكي-سان التي تمتثل للشفاء

30
00:03:18,650 --> 00:03:20,170
هل أنتِ مصابة بالرشح الآن؟

31
00:03:20,170 --> 00:03:23,510
فتاة ظريفة تتحدّثُ عنّي

32
00:03:24,280 --> 00:03:27,230
بفضلكِ تمّ استعادة خطوط إمدادنا

33
00:03:27,230 --> 00:03:28,090
أحسنتِ صنعاً

34
00:03:28,090 --> 00:03:30,390
لكن انتهى المطافُ بي هكذا

35
00:03:30,740 --> 00:03:32,860
يبدو أنّ النيوروي كان قويّاً

36
00:03:32,860 --> 00:03:34,150
...أجل

37
00:03:34,150 --> 00:03:37,870
لو لم تعطني هيكاري-تشان هذا لكنتُ في عداد الموتى

38
00:03:37,870 --> 00:03:38,840
هكذا إذاً

39
00:03:39,180 --> 00:03:41,900
،إذا كانوا أقوياء بما يكفي لجرحكِ

40
00:03:41,900 --> 00:03:43,840
فأرغب بمُقاتلتهم يوماً ما

41
00:03:44,130 --> 00:03:46,360
جروحكِ بحدِّ ذاتها لم تُشفَ

42
00:03:46,360 --> 00:03:47,770
أنتِ لا تتعلّمين أبداً

43
00:03:47,770 --> 00:03:49,450
مرفوض

44
00:03:49,900 --> 00:03:52,870
ستبدأ عملية واسعة النطاق عمّا قريب

45
00:03:53,130 --> 00:03:56,390
ركّزي على الشِّفاء كي تكوني جاهزة لها

46
00:03:56,710 --> 00:03:58,160
هل حان الوقتُ أخيراً؟

47
00:03:58,730 --> 00:03:59,700
نعم

48
00:04:05,790 --> 00:04:08,650
...ما زلتُ متخدّرة

49
00:04:10,430 --> 00:04:11,760
كاريبوتشي؟

50
00:04:12,600 --> 00:04:14,640
ماذا تفعلُ في هذه السّاعة؟

51
00:04:18,550 --> 00:04:19,910
...تشيدوري

52
00:04:20,270 --> 00:04:22,830
لم أعد أسمع شيئاً

53
00:04:22,830 --> 00:04:24,900
هل أختي بخير؟

54
00:04:24,900 --> 00:04:26,360
لا تقلقي

55
00:04:26,700 --> 00:04:29,360
تاكامي لا تموت بتلك السهولة

56
00:04:29,740 --> 00:04:31,020
!كانّو-سان

57
00:04:31,370 --> 00:04:34,020
إنّها فائقة القوّة

58
00:04:34,020 --> 00:04:36,860
،المرّة الأولى التي رأيتُها فيها في أكاديميّة كوري البحريّة

59
00:04:36,860 --> 00:04:39,750
ظننتُ أنّها كانت الفتاة الوحيدة التي ستكون شريكتي

60
00:04:40,300 --> 00:04:41,930
...شريكتكِ

61
00:04:42,250 --> 00:04:44,640
هل يمكنني أن أكون شريكتكِ؟

62
00:04:45,480 --> 00:04:46,740
أنتِ؟

63
00:04:47,080 --> 00:04:48,760
هذا مُحال

64
00:04:48,760 --> 00:04:51,260
ماذا عليّ أن أفعل لأكون شريكتكِ إذاً؟

65
00:04:51,260 --> 00:04:52,790
المسألة بسيطة

66
00:04:52,790 --> 00:04:54,540
كوني أقوى فحسب

67
00:04:54,540 --> 00:04:56,090
مثل تاكامي

68
00:04:56,980 --> 00:04:59,310
أختي قالَتْ ذلك

69
00:04:59,310 --> 00:05:02,940
،عندما هزمنا النيوروي وجلبنا السّلام إلى العالم

70
00:05:02,940 --> 00:05:05,580
تريدُ الخروج في رحلةٍ مع تشيدوري

71
00:05:06,530 --> 00:05:08,010
هكذا هو طبعها

72
00:05:08,980 --> 00:05:11,990
ما السبب الذي تقاتلين لأجله؟

73
00:05:11,990 --> 00:05:13,030
ما السبب برأيكِ؟

74
00:05:13,030 --> 00:05:17,710
ألا يستفزّكِ مجيء هؤلاء من مكانٍ ما
ونشر الفوضى العارمة؟

75
00:05:18,700 --> 00:05:20,460
هذه طبيعتُكِ فحسب

76
00:05:20,460 --> 00:05:23,460
لكن لهذا عليّ أن أصبح قويّة

77
00:05:23,700 --> 00:05:25,590
!أقوى بكثير ممّا أنا عليه الآن

78
00:05:26,530 --> 00:05:29,590
!لكنّكِ قويّة جدّاً الآن

79
00:05:29,590 --> 00:05:30,300
!لا

80
00:05:31,450 --> 00:05:33,980
...كروبينسكي أقوى بكثير منّي

81
00:05:33,980 --> 00:05:39,130
!لكن سأكون أقوى منها واقضي على النيوروي

82
00:05:39,130 --> 00:05:40,800
!بأسرع وقت مُمكن

83
00:05:40,800 --> 00:05:41,580
!نعم

84
00:05:41,880 --> 00:05:43,800
!سأفعلُ ما بوسعي أيضاً

85
00:05:43,800 --> 00:05:45,090
بلهاء

86
00:05:45,090 --> 00:05:47,870
أنا لا أعتمد على قوّتكِ

87
00:05:49,770 --> 00:05:51,570
!حسناً

88
00:05:56,710 --> 00:05:59,620
تبدو كانّو اليوم متوتّرة قليلاً

89
00:05:59,620 --> 00:06:02,840
تريدُ هزيمة النيوروي بأسرع ما يُمكن

90
00:06:02,840 --> 00:06:04,040
لماذا؟

91
00:06:04,640 --> 00:06:07,290
،كخطوة أولى لنا نحو تدمير غريغوري

92
00:06:07,290 --> 00:06:11,970
أمرَنا مقرُّ الجيش بتدميرِ النيوروي الذي يظهر هنا

93
00:06:11,970 --> 00:06:13,970
والتوجُّه نحو بيتروزافودسك

94
00:06:13,970 --> 00:06:16,480
بيتروزافودسك... ألم نكن هناك للتو؟

95
00:06:16,480 --> 00:06:18,720
استعدناها أخيراً

96
00:06:18,720 --> 00:06:21,910
...ما يعني أنّه ما لم نهزم هذا النيوروي

97
00:06:21,910 --> 00:06:24,060
...ستُقطَع إمداداتنا مجدّداً

98
00:06:24,060 --> 00:06:25,230
!لا

99
00:06:25,230 --> 00:06:28,070
!تعرّضت كروبينسكي-سان لجروح وهي تحمي تلك الإمدادات

100
00:06:28,070 --> 00:06:29,770
كلّ ما علينا فعله هو هزيمة النيوروي فحسب

101
00:06:29,770 --> 00:06:31,630
أليس كذلك يا قائدة الطيران رال؟

102
00:06:31,630 --> 00:06:33,820
نعم، صحيح

103
00:06:34,240 --> 00:06:36,200
سأكتسبُ خبرةً في القتالِ الفعليّ

104
00:06:36,200 --> 00:06:39,020
سأهزم أكبر قدر مُمكن وأصبح أقوى

105
00:06:39,020 --> 00:06:40,280
،كانّو-سان

106
00:06:40,280 --> 00:06:43,930
لا تتهوّري فقط لكونكِ اعتدتِ على جهازكِ الجديد

107
00:06:43,930 --> 00:06:46,040
نعم، أعلم

108
00:06:47,360 --> 00:06:48,740
رأيتُ نيوروي

109
00:06:48,740 --> 00:06:50,150
إنّه لا يتحرّك

110
00:06:50,150 --> 00:06:51,800
!كانّو، سأهاجم أولاً

111
00:06:57,470 --> 00:06:59,310
الباقي، ابقين بعيدات

112
00:06:59,310 --> 00:07:00,520
!من تضرب أولاً تربح

113
00:07:00,520 --> 00:07:01,880
!سأهاجم أنا

114
00:07:06,680 --> 00:07:07,360
!هيكاري

115
00:07:07,360 --> 00:07:09,670
ما الذي تفعله؟

116
00:07:10,520 --> 00:07:12,230
!وكأنّنا وخزنا خليّة نحل

117
00:07:12,230 --> 00:07:14,810
!لا وقت للهجوم

118
00:07:15,230 --> 00:07:16,720
...هذا النمط الهجوميّ

119
00:07:17,230 --> 00:07:18,410
...ربّما

120
00:07:22,690 --> 00:07:23,870
!فهمت

121
00:07:23,870 --> 00:07:25,060
!النواة

122
00:07:25,060 --> 00:07:27,700
كان يُهاجم لإبقاء تلك المنطقة محميّة

123
00:07:27,700 --> 00:07:29,560
!أحسنتِ يا روسمان-سينسي

124
00:07:29,560 --> 00:07:30,500
...كانّو-سان

125
00:07:30,500 --> 00:07:32,200
!نعم، اتركي الأمر لي

126
00:07:35,160 --> 00:07:36,780
إنّه يُطلِق بكثافة

127
00:07:36,780 --> 00:07:39,160
كانّو-سان، تراجعي

128
00:07:39,160 --> 00:07:40,060
!أنا بخير

129
00:07:40,060 --> 00:07:41,130
!سأقترب منه

130
00:07:41,380 --> 00:07:42,600
!كانّو-سان

131
00:07:42,600 --> 00:07:46,440
كروبينسكي هزمت ذلك النيوروي بمفردها

132
00:07:46,690 --> 00:07:47,770
!أستطيعُ فعلها أيضاً

133
00:07:53,790 --> 00:07:54,650
!كانّو-سان

134
00:08:02,200 --> 00:08:05,250
!ساشا! ساشا

135
00:08:06,640 --> 00:08:09,160
ساشا! ساشا

136
00:08:11,520 --> 00:08:12,780
!ساشا

137
00:08:30,450 --> 00:08:32,340
سرعة نبضات قلبها مستقرّة

138
00:08:32,340 --> 00:08:33,880
إنّها بخير الآن

139
00:08:35,070 --> 00:08:36,550
أليس هذا رائعاً يا جورجيت؟

140
00:08:36,550 --> 00:08:37,390
نعم

141
00:08:42,710 --> 00:08:43,890
كانّو-سان؟

142
00:08:46,130 --> 00:08:47,390
كانت غلطتي

143
00:08:48,140 --> 00:08:51,020
...كنتُ متهوّرة للغاية وساشا

144
00:08:51,450 --> 00:08:54,060
هذه ليسَتْ غلطتك

145
00:08:55,040 --> 00:08:58,370
غداً، سنشنُّ هجوماً آخر على ذلك النيوروي

146
00:08:58,630 --> 00:09:01,800
إلى ذلك الحين، احرصا على الرّاحة جيّداً

147
00:09:06,510 --> 00:09:07,710
...كانّو-سان

148
00:09:08,290 --> 00:09:09,660
كاريبوتشي؟

149
00:09:10,040 --> 00:09:10,980
ماذا تريدين؟

150
00:09:11,400 --> 00:09:14,080
كنتُ أفكّرُ بساشا-سان

151
00:09:18,400 --> 00:09:21,410
كانّو-سان... هيكاري-سان؟

152
00:09:21,410 --> 00:09:22,290
!ساشا

153
00:09:22,290 --> 00:09:23,420
!ساشا-سان

154
00:09:23,420 --> 00:09:27,030
كانّو-سان... أنتِ بخير

155
00:09:27,030 --> 00:09:30,030
نعم، أنا بخير. بفضلكما

156
00:09:30,030 --> 00:09:31,510
...أنا مسرورة

157
00:09:31,990 --> 00:09:33,840
شكراً لكما

158
00:09:34,260 --> 00:09:36,040
أنا على ما يُرام الآن

159
00:09:36,790 --> 00:09:40,460
!ساشا، أنا آسفة! كانت غلطتي

160
00:09:40,460 --> 00:09:44,000
ارتكبتُ خطأ لعدمِ تغطيتي لكِ ناريّاً كما ينبغي

161
00:09:44,260 --> 00:09:46,060
هذه ليست غلطتكِ

162
00:09:46,320 --> 00:09:50,490
...لا، لو لم أتهوّر وأتعجّل

163
00:09:51,170 --> 00:09:53,470
هذا هو طبعُكِ

164
00:09:53,470 --> 00:09:56,060
لذا لا تلومي نفسكِ

165
00:09:57,680 --> 00:09:59,060
...ساشا

166
00:09:59,060 --> 00:10:02,690
أنا متأكّدةٌ أنّكِ تستطيعين هزيمة ذلك النيوروي

167
00:10:02,690 --> 00:10:04,830
لذا افعلي ما بوسعكِ

168
00:10:04,830 --> 00:10:08,130
!نعم، أعدكِ أنّني سأهزمه

169
00:10:08,130 --> 00:10:09,380
هيكاري-سان؟

170
00:10:09,900 --> 00:10:11,470
ساعديها كذلك، اتفقنا؟

171
00:10:11,470 --> 00:10:12,280
نعم

172
00:10:12,570 --> 00:10:13,930
!ابقي في مكانكِ

173
00:10:13,930 --> 00:10:14,680
!حاضر

174
00:10:29,850 --> 00:10:32,980
لماذا تتكاسلان؟

175
00:10:32,980 --> 00:10:35,380
!هذا ليس إحماء

176
00:10:35,800 --> 00:10:36,890
...حسناً

177
00:10:36,890 --> 00:10:39,370
!لن أخسر في الجري

178
00:10:41,630 --> 00:10:43,640
،طبقاً للمعلومات التي تلقّيناها مؤخراً

179
00:10:48,470 --> 00:10:50,800
،إن لم نستطع هزيمته

180
00:10:50,800 --> 00:10:54,100
فإنّ خطوط إمدادنا ستُقطَع مجدّداً وسنتضوّر جوعاً

181
00:10:54,100 --> 00:10:55,610
!لا

182
00:10:55,610 --> 00:10:57,910
لا يمكننا القتال بمعدة فارغة

183
00:10:58,190 --> 00:11:00,600
لنهزم ذلك النيوروي

184
00:11:00,600 --> 00:11:02,790
!لأجلِ كروبينسكي-سان وساشا-سان أيضاً

185
00:11:02,790 --> 00:11:04,100
!بالطبع

186
00:11:04,390 --> 00:11:06,920
!لن أدع ذلك الشيء يفلت بفعلتِه أكثر من ذلك

187
00:11:06,920 --> 00:11:08,880
كانّو، كضابطة طيران

188
00:11:08,880 --> 00:11:11,030
أنتِ الأعلى رتبة هنا

189
00:11:11,600 --> 00:11:13,500
أنا القائدة الميدانيّة؟

190
00:11:13,500 --> 00:11:16,670
لا، ستكون أيديتا المسؤولة عن ذلك

191
00:11:16,670 --> 00:11:18,010
لا مانع، صحيح؟

192
00:11:18,010 --> 00:11:19,720
حسناً، عُلِم

193
00:11:20,040 --> 00:11:22,080
إليكن الخطّة إذاً

194
00:11:22,460 --> 00:11:26,890
استناداً إلى هجوم البارحة وتقارير فريق رصد المنطِقة

195
00:11:27,340 --> 00:11:30,870
يستطيعُ العدوّ شنّ هجمات قويّة من الأمام

196
00:11:30,870 --> 00:11:33,140
لكن ليس بمثل قوّة هجماته من الخلف

197
00:11:33,640 --> 00:11:37,120
لهذا سننفصل إلى مجموعتين ونهاجم

198
00:11:37,370 --> 00:11:39,840
شيموهارا-سان وجورجيت-سان وأنا

199
00:11:39,840 --> 00:11:42,610
سنتوجّه إلى الأمام ونصرف انتباه النيوروي

200
00:11:42,610 --> 00:11:47,940
خلال تلك الفترة، ستقترب كانّو-سان ونيبّا-سان
وهيكاري-سان من الخلف

201
00:11:47,940 --> 00:11:50,290
وتدمّرن النواة في المركز

202
00:11:51,910 --> 00:11:54,480
!شوهِدَ نيوروي على بُعد 30 كيلومتراً أمامنا

203
00:11:54,480 --> 00:11:56,290
لم يُلاحظنا بعد

204
00:11:56,790 --> 00:11:58,110
لننفصل هنا

205
00:11:58,110 --> 00:11:59,320
!عُلِم

206
00:12:01,470 --> 00:12:03,230
،نيبّا، كاريبوتشي

207
00:12:03,230 --> 00:12:05,080
لنحرص على حسمِ هذا الأمر

208
00:12:05,080 --> 00:12:05,700
!نعم

209
00:12:05,700 --> 00:12:06,380
!حسناً

210
00:12:10,180 --> 00:12:11,540
!لنبدأ الهجوم

211
00:12:21,540 --> 00:12:24,350
أعتمد عليكن يا فتيات

212
00:12:27,860 --> 00:12:28,950
بدأت

213
00:12:28,950 --> 00:12:29,950
هيّا بنا

214
00:12:29,950 --> 00:12:30,690
!نعم

215
00:12:33,690 --> 00:12:34,690
كان كلامهن صحيحاً

216
00:12:34,690 --> 00:12:36,100
إنّه لا يُهاجم إطلاقاً

217
00:12:37,650 --> 00:12:39,000
!يمكننا فعلها

218
00:12:39,000 --> 00:12:40,680
نعم، لنفعل هذا بسرعة

219
00:12:48,960 --> 00:12:49,930
ماذا؟

220
00:12:54,090 --> 00:12:55,540
انشطر؟

221
00:12:58,810 --> 00:13:00,240
تغيير الخطّة

222
00:13:00,240 --> 00:13:02,400
اعترضن النيوروي المنشطِر

223
00:13:02,810 --> 00:13:04,500
!كشفَ خطّتنا

224
00:13:04,500 --> 00:13:05,570
!ابقي هادئة

225
00:13:05,570 --> 00:13:07,690
!إذا دمّرنا النواة سنربح

226
00:13:13,390 --> 00:13:14,390
!غيّرَ شكله

227
00:13:14,390 --> 00:13:15,250
!اللّعنة

228
00:13:15,250 --> 00:13:16,770
!لا نعلم أين تقعُ النواة

229
00:13:16,770 --> 00:13:17,940
!هذا ليس عدلاً

230
00:13:20,750 --> 00:13:22,840
!كدنا نفعلها

231
00:13:23,750 --> 00:13:24,830
ماذا؟

232
00:13:26,850 --> 00:13:28,050
!إنّه يجري

233
00:13:28,050 --> 00:13:29,060
!كانّو-سان

234
00:13:29,060 --> 00:13:30,000
!النواة

235
00:13:30,000 --> 00:13:31,750
...ما دمنا قادرين على إيجادِ النواة

236
00:13:48,420 --> 00:13:50,770
ما لم ندمّر النواة، فلن ننتهي أبداً

237
00:13:50,770 --> 00:13:53,150
!قوّتنا السحريّة وذخيرتنا تنفدان

238
00:13:53,150 --> 00:13:54,160
...قائدة الطيران

239
00:13:54,590 --> 00:13:56,630
لا خيار آخر. انسحاب

240
00:13:56,950 --> 00:13:58,310
!انتظري

241
00:13:58,310 --> 00:14:00,000
ماذا عن إمداداتنا؟

242
00:14:00,000 --> 00:14:02,490
نحن مضطرّات للاستسلام حالياً

243
00:14:02,490 --> 00:14:04,210
...لا

244
00:14:08,470 --> 00:14:12,230
القائدة رال، اسمحي لي باستخدام عين الاحتكاك

245
00:14:12,230 --> 00:14:13,560
!الرّقيب كاريبوتشي

246
00:14:13,560 --> 00:14:14,880
عين الاحتكاك؟

247
00:14:14,880 --> 00:14:15,940
ما هو هذا؟

248
00:14:15,940 --> 00:14:17,880
توقّفي يا رقيبة كاريبوتشي

249
00:14:17,880 --> 00:14:18,880
!أرجوكِ

250
00:14:18,880 --> 00:14:21,220
إن لم أستخدمها الآن فمتى أستخدمها؟

251
00:14:21,220 --> 00:14:22,550
!قائدة الطيران رال

252
00:14:23,650 --> 00:14:26,150
ماذا تقولين؟

253
00:14:26,150 --> 00:14:27,770
عمّاذا تتكلّمين يا هيكاري؟

254
00:14:31,660 --> 00:14:33,240
إذا لمستِه؟

255
00:14:33,240 --> 00:14:35,240
إذا لمستِه... هل أنتِ غبيّة؟

256
00:14:35,240 --> 00:14:37,620
هذا خطيرٌ جدّاً، هذا غير مفيد إطلاقاً

257
00:14:37,620 --> 00:14:38,680
!بل هو مفيد

258
00:14:38,680 --> 00:14:39,640
!سأجعله مفيداً

259
00:14:39,640 --> 00:14:40,520
!هذا مستحيل

260
00:14:40,520 --> 00:14:41,760
هل تسمعينني؟

261
00:14:43,550 --> 00:14:44,600
حسناً

262
00:14:45,310 --> 00:14:47,540
كانّو، وفّري الدعم لكاريبوتشي

263
00:14:47,540 --> 00:14:49,250
أوصليها إلى النيوروي

264
00:14:50,130 --> 00:14:51,590
ستسمحين لها بالقيامِ بذلك؟

265
00:14:51,590 --> 00:14:52,340
قائدة الطيران؟

266
00:14:52,790 --> 00:14:55,140
هذا أمر يا ضابطة الطيران كانّو

267
00:14:57,670 --> 00:14:59,310
وستدمّرها كانّو

268
00:15:00,150 --> 00:15:02,090
هل تسمعينني يا ضابطة الطيران كانّو؟

269
00:15:02,090 --> 00:15:03,190
!عُلِم

270
00:15:03,190 --> 00:15:05,100
عليّ إيصالها إلى هناك فحسب، صحيح؟

271
00:15:05,100 --> 00:15:05,860
!كانّو

272
00:15:05,860 --> 00:15:08,250
!حريّ بكِ ألّا تخطئي في القيام بهذا

273
00:15:08,250 --> 00:15:09,110
!مفهوم

274
00:15:10,180 --> 00:15:11,070
!هيّا بنا

275
00:15:11,070 --> 00:15:11,990
!حاضر

276
00:15:15,830 --> 00:15:19,110
هل تنوي لمس نيوروي حقّاً؟

277
00:15:21,820 --> 00:15:23,830
!كانّو

278
00:15:25,110 --> 00:15:25,830
!نيبّا

279
00:15:28,830 --> 00:15:31,080
!ابقي متيقّظة

280
00:15:42,850 --> 00:15:43,930
كانّو؟

281
00:15:43,930 --> 00:15:44,780
كانّو-سان؟

282
00:15:45,300 --> 00:15:46,480
هذا سيّئ

283
00:15:46,480 --> 00:15:48,680
هذه الخطّة غبيّة

284
00:15:49,030 --> 00:15:50,630
ستفشل

285
00:15:51,570 --> 00:15:53,230
أُلغيَت المهمّة

286
00:15:54,390 --> 00:15:55,580
!كانّو-سان

287
00:15:56,350 --> 00:15:57,490
ماذا؟

288
00:15:57,490 --> 00:15:59,190
تتصرّفين بغرابة

289
00:15:59,190 --> 00:16:00,640
ما الذي أصابكِ؟

290
00:16:01,920 --> 00:16:04,750
...لا أستطيع فعلها

291
00:16:05,060 --> 00:16:09,160
لا أستطيعُ حمايتكِ كما فعلت كروبينسكي أو ساشا

292
00:16:09,160 --> 00:16:10,890
ماذا تقولين؟

293
00:16:10,890 --> 00:16:12,910
!هذا ليس طبعكِ

294
00:16:12,910 --> 00:16:14,750
...إذا غادرنا الآن فخطوط إمدادنا

295
00:16:14,750 --> 00:16:16,680
ماذا سيحلُّ بالجناح 502؟

296
00:16:16,680 --> 00:16:18,130
!أعلم

297
00:16:18,230 --> 00:16:19,570
!أعلم ذلك

298
00:16:19,570 --> 00:16:22,530
،بعينِ الاحتكاك خاصّتي وقدرتكِ على اختراق دفاعه

299
00:16:22,530 --> 00:16:23,840
يمكننا أن نربح

300
00:16:23,840 --> 00:16:24,770
!اصمتي

301
00:16:24,770 --> 00:16:26,870
!أنتِ لا تعرفين شيئاً أيّتها الجديدة

302
00:16:26,870 --> 00:16:30,750
!لماذا جُرِحَتْ كروبينسكي-سان وساشا-سان إذاً؟

303
00:16:30,750 --> 00:16:32,890
ألم يكن ذلك لحماية خطوط إمدادنا؟

304
00:16:32,890 --> 00:16:35,390
ألم يكن ذلك لحماية النّاس في القاعدة؟

305
00:16:35,390 --> 00:16:37,810
هل ستدعين معارككِ تذهب سدى؟

306
00:16:37,810 --> 00:16:39,640
!أرفضُ ذلك

307
00:16:39,640 --> 00:16:42,150
...اهدآ

308
00:16:42,150 --> 00:16:46,140
!سنهزمُ ذلك النيوروي هنا

309
00:16:46,140 --> 00:16:47,900
!لا بدّ أن نفعل ذلك

310
00:16:47,900 --> 00:16:49,990
!لن نقف مكتوفي الأيدي هنا

311
00:16:49,990 --> 00:16:53,810
!لذا خذيني إلى ذلك النيوروي

312
00:16:53,810 --> 00:16:54,970
!أرجوكِ

313
00:16:54,970 --> 00:16:58,140
!لا تقولي أنّكِ لا تستطيعين فعلها قبل أن تحاولي حتّى

314
00:16:58,880 --> 00:17:00,440
!أرجوكِ

315
00:17:01,290 --> 00:17:03,930
كانّو-سان، أتذكرين ما قلتِه؟

316
00:17:03,930 --> 00:17:07,180
!قلتِ أنّنا سنهزم ذلك النيوروي هذه المرّة

317
00:17:07,180 --> 00:17:10,360
فلماذا تخافين الآن؟

318
00:17:10,360 --> 00:17:14,290
!مُحال أن تكوني شريكة أختي بهذا الشكل

319
00:17:14,680 --> 00:17:15,960
هل تستطيعين حقّاً أن تقولي

320
00:17:16,580 --> 00:17:18,640
!أنّكِ إحدى السّاحرات الكاسِرات؟

321
00:17:28,700 --> 00:17:30,040
!موافقة، سأفعلها

322
00:17:30,040 --> 00:17:31,220
!سأفعلها

323
00:17:31,930 --> 00:17:33,150
...كانّو-سان

324
00:17:33,150 --> 00:17:34,310
لا تبكي

325
00:17:34,310 --> 00:17:36,340
أتعتقدين أنّكِ قادرة على لمسِ نيوروي هكذا؟

326
00:17:37,220 --> 00:17:38,540
!أنا لا أبكي

327
00:17:38,540 --> 00:17:39,970
هيّا بنا يا كاريبوتشي

328
00:17:39,970 --> 00:17:42,550
ابقي خلفي مباشرة

329
00:17:42,550 --> 00:17:43,770
!حاضر

330
00:17:46,570 --> 00:17:47,890
ما الخطّة؟

331
00:17:47,890 --> 00:17:50,090
سأندفع نحوه

332
00:17:50,090 --> 00:17:52,200
وعليكِ أن تتبعيني

333
00:17:52,200 --> 00:17:53,450
!عُلِم

334
00:17:53,450 --> 00:17:56,020
نيبّا، احميها من الخلف

335
00:17:56,020 --> 00:17:58,270
!حاضر

336
00:18:02,250 --> 00:18:03,450
هذا صحيح

337
00:18:03,450 --> 00:18:05,970
لماذا تخافين يا كانّو ناوي؟

338
00:18:06,360 --> 00:18:09,360
!لا يجوز أن تتوقّفي عند هذا الحدّ

339
00:18:10,780 --> 00:18:13,070
!كانّو، ثمّة شيء ضخم قادم

340
00:18:13,070 --> 00:18:14,800
!لنتابع التقدّم

341
00:18:29,200 --> 00:18:31,770
!والآن! انطلقي يا كاريبوتشي

342
00:18:41,750 --> 00:18:42,740
!هناك

343
00:18:49,820 --> 00:18:50,740
إنّها هناك

344
00:18:50,740 --> 00:18:51,710
!إنّها هناك بالفعل

345
00:18:54,960 --> 00:18:56,520
!انشطر من جديد

346
00:18:58,400 --> 00:19:00,450
إذا عرفنا مكانها فهو فريستنا

347
00:19:11,320 --> 00:19:13,340
!مُت

348
00:19:13,340 --> 00:19:16,490
!تسوروغي إيسّين

349
00:19:33,230 --> 00:19:34,300
ماذا؟

350
00:19:34,300 --> 00:19:36,630
دمّرنَ النواة

351
00:19:41,990 --> 00:19:43,290
!نجحنا

352
00:19:43,290 --> 00:19:44,630
!نجحنا يا كانّو-سان

353
00:19:45,700 --> 00:19:48,360
!نعم، نجحنا يا شريكتي

354
00:19:49,410 --> 00:19:51,310
ماذا قلتِ؟

355
00:19:51,620 --> 00:19:53,630
!لا شيء

356
00:19:53,630 --> 00:19:55,340
!لقد قلتِها

357
00:19:55,340 --> 00:19:56,780
!قلتِ أنّني شريكتكِ

358
00:19:56,780 --> 00:19:58,160
!مستحيل

359
00:19:58,160 --> 00:20:00,170
!لا يمكن أن تكوني شريكتي

360
00:20:00,170 --> 00:20:02,590
!لقد قلتِها

361
00:20:02,590 --> 00:20:03,590
!لم أقلها

362
00:20:03,590 --> 00:20:04,650
!بل فعلتِ

363
00:20:05,260 --> 00:20:06,660
قالَتْها

364
00:20:06,660 --> 00:20:08,040
نعم

365
00:20:09,740 --> 00:20:11,070
أيديتا تتكلّم

366
00:20:11,340 --> 00:20:13,350
قضينا على النيوروي

367
00:20:13,350 --> 00:20:14,350
هكذا إذاً

368
00:20:14,350 --> 00:20:15,200
فعلتنّها

369
00:20:16,450 --> 00:20:17,930
لديكِ تلاميذ بارعات

370
00:20:18,210 --> 00:20:19,790
يُسبِّبن مغصاً في معدتي

371
00:20:24,960 --> 00:20:25,860
ماذا؟

372
00:20:27,080 --> 00:20:27,970
مستحيل

373
00:20:36,790 --> 00:20:38,830
كانّو-سان، نيبّا-سان، هيكاري-سان

374
00:20:38,830 --> 00:20:40,030
!اجلسن على ركبكن

375
00:20:41,510 --> 00:20:45,780
والآن هيكاري-تشان أصبحت عضوة حقيقيّة في الجناح 502

376
00:20:45,780 --> 00:20:48,690
وكذلك ساحرة من السّاحرات الكاسِرات

377
00:20:48,690 --> 00:20:49,900
حقّاً؟

378
00:20:49,900 --> 00:20:52,270
!حسناً! مرحى! مرحى

379
00:20:52,270 --> 00:20:54,460
لماذا أنتِ متحمِّسة جدّاً يا هيكاري-سان؟

380
00:20:55,250 --> 00:20:57,550
اجلسي على ركبتيكِ أيضاً يا كروبينسكي-سان

381
00:20:58,700 --> 00:21:00,590
!لماذا؟

382
00:24:26,720 --> 00:24:30,800
هيكاري وتاكامي تسيئان فهم بعضهما
الآخر لأنّهما تحبّان بعضهما

383
00:24:31,090 --> 00:24:34,160
كلتاهما لا تجيدان التعبير عمّا يجول في خاطرهما

384
00:24:34,410 --> 00:24:38,040
:الحلقة القادمة من ساحرات شُجاعات
أخت كبرى وأخت صغرى