1
00:00:00,620 --> 00:00:03,800
وبهذا أختتمُ تقريري يا حضرة المُشير مانّيرهيم

2
00:00:05,080 --> 00:00:06,330
سأدخلُ صلبَ الموضوع إذاً

3
00:00:06,330 --> 00:00:10,440
ستتشكّل جماعة مُسلّحة جديدة في بطرسبرغ

4
00:00:10,440 --> 00:00:12,380
جماعة مُسلّحة في بطرسبرغ؟

5
00:00:12,380 --> 00:00:17,920
قرّرنا الزجّ بالقوّات المُسلَّحة في وجه عشّ غريغوري

6
00:00:17,920 --> 00:00:19,990
وبالتالي، نحتاجُ لجماعة مُسلّحة جديدة

7
00:00:19,990 --> 00:00:21,860
هل حانَ الوقتُ لهجوم مُضادّ أخيراً إذاً؟

8
00:00:22,110 --> 00:00:24,250
ستُعيننا سوميس كذلك

9
00:00:24,250 --> 00:00:29,020
لكن أنتم، الجناح 502، ستكونون القوّة المركزيّة

10
00:00:29,020 --> 00:00:30,010
جناحنا؟

11
00:00:30,350 --> 00:00:31,400
أجل

12
00:00:31,400 --> 00:00:33,880
سأوافيكن بالتفاصيل في وقتٍ لاحق

13
00:00:33,880 --> 00:00:34,780
عُلِم

14
00:00:35,270 --> 00:00:39,030
...بالمناسبة، تلك السّاحرة الشُجاعة من فوسو

15
00:00:39,200 --> 00:00:41,260
تقصد كاريبوتشي؟

16
00:00:41,410 --> 00:00:43,580
المُلازمة كاريبوتشي تاكامي

17
00:02:19,650 --> 00:02:22,940
هل أنتِ متأكّدة أنّكِ لا تريدين أن تخبريهم عن كاريبتوشي-سان؟

18
00:02:23,270 --> 00:02:26,230
تقصدين بأنّها ليسَتْ معنا بل أختها؟

19
00:02:26,940 --> 00:02:30,560
إذا أخبرتُهم فستُقطَعُ عنّا إمدادات فوسو، صحيح؟

20
00:02:30,970 --> 00:02:32,410
ماكرة جدّاً

21
00:02:32,670 --> 00:02:34,530
أطلِق على هذا بالتخطيط

22
00:02:40,750 --> 00:02:42,660
أحان الوقتُ أخيراً لهجوم مُضادّ؟

23
00:02:42,930 --> 00:02:45,140
علمنا أنّنا نستطيعُ تدمير عشّ

24
00:02:45,390 --> 00:02:46,400
بالطبع

25
00:02:46,540 --> 00:02:52,550
لكن ما زلنا لا نعلم كيف قام الجناح 501
بتدمير العشّ، أليس كذلك؟

26
00:02:52,810 --> 00:02:56,920
كوربينسكي يرسل رسالةً إلى هارتمان
في الجناح 501 الآن

27
00:02:56,920 --> 00:02:58,580
لمزيد من المعلومات

28
00:02:59,080 --> 00:03:00,790
والباقي يعتمدُ على قوّتنا

29
00:03:04,530 --> 00:03:05,370
!حسناً

30
00:03:12,360 --> 00:03:13,320
واحد

31
00:03:13,720 --> 00:03:14,490
اثنان

32
00:03:14,910 --> 00:03:15,830
!ثلاثة

33
00:03:18,900 --> 00:03:19,900
!نعم

34
00:03:19,900 --> 00:03:21,800
تفعلين شيئاً مثيراً

35
00:03:21,800 --> 00:03:22,620
!نعم

36
00:03:22,620 --> 00:03:25,270
إنّه تمرين تدريبيّ كانت أختي تمارسه طوال الوقت

37
00:03:35,020 --> 00:03:37,730
لكن لا تفعلين ذلك بطريقة أنيقة

38
00:03:37,970 --> 00:03:40,820
،لو كان لديكِ سيطرة أفضل على سحركِ

39
00:03:40,820 --> 00:03:42,770
لاستطعتِ العبور بهذا الشكل أيضاً

40
00:03:43,650 --> 00:03:45,850
أخبريني كيف أفعلُ هذا من فضلكِ يا روسمان-سان

41
00:03:45,850 --> 00:03:50,160
أولاً، عليّ أن أختبركِ لأرى ما إن كنتِ تستحقّين
تلقّي تدريبي

42
00:03:50,160 --> 00:03:51,020
اختباري؟

43
00:03:51,020 --> 00:03:53,150
!حاضرة يا روسمان-سينسي

44
00:03:53,150 --> 00:03:56,670
،لكن إن لم تنجحي في غضون أسبوع

45
00:03:56,670 --> 00:03:58,280
ستعودين إلى الديار

46
00:03:59,940 --> 00:04:01,460
أسبوع واحد؟

47
00:04:03,450 --> 00:04:04,880
!استيقظي يا كانّو

48
00:04:04,880 --> 00:04:05,870
!هاجمنا العدوّ؟

49
00:04:05,870 --> 00:04:07,380
...لا! إنّ هيكاري

50
00:04:09,140 --> 00:04:10,850
أسبوع؟

51
00:04:11,360 --> 00:04:14,920
لكن ماذا سيكون اختبار روسمان-سينسي بالضبط؟

52
00:04:15,250 --> 00:04:16,680
والآن، دوّريه

53
00:04:16,680 --> 00:04:17,510
!حاضرة

54
00:04:17,650 --> 00:04:19,810
حافظي على 1500 دورة في الدقيقة

55
00:04:19,810 --> 00:04:20,510
!حاضرة

56
00:04:31,480 --> 00:04:33,800
جهازكِ مُمتعض

57
00:04:34,170 --> 00:04:35,290
تشيدوري ليس سعيداً؟

58
00:04:35,290 --> 00:04:39,490
لا، لا يستطيع استخدام كامل قوّته بسببكِ

59
00:04:40,910 --> 00:04:42,370
بسببي؟

60
00:04:48,560 --> 00:04:50,170
كما توقّعت

61
00:04:50,670 --> 00:04:54,430
سنتناولُ اليوم زاكوسكي على طريقة أوروشيا

62
00:04:54,510 --> 00:04:55,670
!تبدو لذيذة للغاية

63
00:04:55,670 --> 00:04:58,000
!لم أتناول شيئاً كهذا من قبل

64
00:04:59,390 --> 00:05:00,980
...سمعتُ

65
00:05:01,390 --> 00:05:03,790
أنّه بقي لديكِ أسبوع

66
00:05:03,790 --> 00:05:05,100
!لا تقولي ذلك

67
00:05:05,200 --> 00:05:06,550
لم آتِ إلى هنا لقضاءِ أسبوع

68
00:05:06,550 --> 00:05:07,620
!سأبقى هنا للأبد

69
00:05:07,620 --> 00:05:09,330
هل سيتمُّ إعادتكِ عن طريقِ الشحن إذاً؟

70
00:05:13,010 --> 00:05:16,430
حسناً، عيّريه بعيار شبه أوتوماتيكي وأصيبي ذلك الهدف

71
00:05:16,690 --> 00:05:17,900
...إنّه صغير جدّاً

72
00:05:17,900 --> 00:05:18,670
استعداد

73
00:05:18,670 --> 00:05:19,730
!حـ-حاضرة

74
00:05:19,940 --> 00:05:23,470
ضمّي السِّلاح نحوكِ واسنديه بكتفكِ

75
00:05:23,470 --> 00:05:25,300
واضغطي الزناد بهدوء

76
00:05:25,580 --> 00:05:26,290
!وسدّدي

77
00:05:28,090 --> 00:05:29,690
طاقتكِ السحريّة ضعيفة

78
00:05:30,150 --> 00:05:32,400
لا تستطيعين امتصاص الارتداد، أليس كذلك؟

79
00:05:33,660 --> 00:05:35,270
اخطي خمس خطوات للأمام

80
00:05:35,890 --> 00:05:37,190
!حـ-حاضرة

81
00:05:39,920 --> 00:05:40,910
استعداد

82
00:05:42,520 --> 00:05:43,260
إطلاق

83
00:05:44,520 --> 00:05:45,600
خمس خطوات إضافيّة

84
00:05:45,600 --> 00:05:46,330
حاضرة

85
00:05:47,720 --> 00:05:48,720
خمس خطوات إضافيّة

86
00:05:48,720 --> 00:05:49,460
!حاضرة

87
00:05:50,880 --> 00:05:51,870
خمس خطوات إضافيّة

88
00:05:51,870 --> 00:05:52,600
!حاضرة

89
00:05:53,540 --> 00:05:54,660
!فعلتُها

90
00:05:54,800 --> 00:05:56,420
لم أتوقّع أن يكون بهذا السوء

91
00:05:57,220 --> 00:06:00,440
تفتقرين للقوّة السحريّة بشكل كبير

92
00:06:00,650 --> 00:06:03,790
أنتِ بعيدة كلّ البُعد عن المُستوى
الأدنى الذي يخوّلكِ للخضوعِ لتدريبي

93
00:06:03,790 --> 00:06:05,620
...إذاً الاختبار

94
00:06:05,620 --> 00:06:06,580
رسبتِ

95
00:06:06,580 --> 00:06:09,910
في هذه الحالة، سأركضُ ضعفي المسافة
التي ركضتُها في الصّباح

96
00:06:09,910 --> 00:06:11,970
—وقوّتي السحريّة سوف

97
00:06:11,970 --> 00:06:13,200
لا، غير صحيح

98
00:06:13,410 --> 00:06:15,630
القوّة السحريّة هي شيء فطريّ يُولَد معكِ

99
00:06:15,630 --> 00:06:17,570
إنّه ليس شيئاً تستطيعين تغييره لاحقاً

100
00:06:17,570 --> 00:06:19,920
لكن ما زال أمامي أسبوع، أليس كذلك؟

101
00:06:19,920 --> 00:06:21,860
!دعيني أتابع الاختبار أرجوكِ

102
00:06:23,150 --> 00:06:24,380
تعالي معي إذاً

103
00:06:24,650 --> 00:06:25,400
!حاضرة

104
00:06:25,740 --> 00:06:27,600
...قد يكون هذا مستحيلاً في نهاية المطاف

105
00:06:27,600 --> 00:06:28,470
أرأيتِ؟

106
00:06:28,720 --> 00:06:30,090
كما قلتُ تماماً

107
00:06:30,090 --> 00:06:31,980
كانّو، متى وصلتِ إلى هنا؟

108
00:06:35,510 --> 00:06:37,290
!يا له من ارتفاع شاهق

109
00:06:43,140 --> 00:06:44,400
اذهبي واجلبيها

110
00:06:44,860 --> 00:06:45,890
حاضرة

111
00:06:45,890 --> 00:06:47,280
سأذهبُ لإحضار جهازي

112
00:06:47,280 --> 00:06:48,520
من دون طيران

113
00:06:49,590 --> 00:06:51,160
كيف إذاً؟

114
00:06:51,160 --> 00:06:52,880
سأريكِ

115
00:06:54,650 --> 00:06:56,730
،أعيدي توزيع قوّتكِ السحريّة إلى مقدّمتكِ

116
00:06:56,730 --> 00:06:58,830
ومن ثمّ وزّعيها بالتساوي إلى يديكِ وقدميكِ

117
00:06:59,060 --> 00:07:02,280
إذا استطعتِ التحكُّم جيّداً بالأجزاء التي تلمس
الجدار، يمكنكِ التسلُّق

118
00:07:02,830 --> 00:07:06,220
!لـ-لم نتعلّم ذلك في المدرسة

119
00:07:08,890 --> 00:07:10,780
إن لم تستطيعي فعل ذلك فعودي إلى المنزل

120
00:07:10,970 --> 00:07:14,630
إن لم تستطيعي تخطّي هذا الاختبار فأرفضُ
مُشاركتكِ في الهجوم

121
00:07:15,660 --> 00:07:16,660
ماذا ستفعلين؟

122
00:07:16,660 --> 00:07:17,400
!سأفعلها

123
00:07:17,780 --> 00:07:18,820
أجل

124
00:07:18,820 --> 00:07:20,540
عليّ المُحاولة

125
00:07:20,540 --> 00:07:22,580
!لن أستسلم قبل أن أحاول

126
00:07:28,110 --> 00:07:29,990
...مؤلم

127
00:07:32,060 --> 00:07:33,500
إن حصلتِ عليها فأحضريها إليّ

128
00:07:36,880 --> 00:07:39,730
أهذا اختبارٌ حقّاً؟

129
00:07:39,730 --> 00:07:42,050
هذا غير مهمّ. إن فشِلَتْ، انتهى أمرها

130
00:07:45,620 --> 00:07:47,650
هذه فكرةٌ مثيرةٌ للاهتمام

131
00:07:47,940 --> 00:07:50,040
لكن أيمكنُها إحضارها؟

132
00:07:50,040 --> 00:07:51,100
ربّما لا

133
00:07:51,300 --> 00:07:55,860
لكن هذا أفضل لها كي تُدرِك حدود إمكانياتها

134
00:07:56,330 --> 00:07:58,220
هذا أقلّ ما يمكنكِ فعله، صحيح؟

135
00:07:58,850 --> 00:08:00,030
ما رأيكِ يا حضرة المُلازمة الطيّارة؟

136
00:08:00,220 --> 00:08:04,500
...على الأقلّ، تتمتّعُ بأكثر من مجرّد جرأة وحماس

137
00:08:04,500 --> 00:08:07,050
لكن قوّتها السحريّة ضعيفة للغاية

138
00:08:07,210 --> 00:08:11,030
لياقتها عالية جدّاً، لكنّها غير مؤهّلة للقتال

139
00:08:11,210 --> 00:08:13,670
أيعني هذا أنّها ضعيفة في خطوط الجبهة؟

140
00:08:14,020 --> 00:08:14,850
أجل

141
00:08:16,630 --> 00:08:18,550
...يدايّ مُخدّرتان

142
00:08:18,750 --> 00:08:20,080
ما مُشكلتك؟

143
00:08:20,500 --> 00:08:22,510
إن لم تأكليه فسآكله أنا

144
00:08:23,020 --> 00:08:24,470
!سآكل

145
00:08:27,740 --> 00:08:28,900
!ساخن

146
00:08:28,900 --> 00:08:30,330
!أنا آسفة

147
00:08:32,100 --> 00:08:34,580
هل تبلي بلاء حسناً أكثر من البارحة؟

148
00:08:34,790 --> 00:08:37,780
من الطبيعي أن يتحسّن المرء بعد يوم كامل من العمل

149
00:08:37,780 --> 00:08:38,820
أأنتِ قلقةٌ عليها؟

150
00:08:38,820 --> 00:08:39,740
أبداً

151
00:08:42,580 --> 00:08:43,420
ماذا؟

152
00:08:46,470 --> 00:08:48,060
...مُؤلم

153
00:08:48,060 --> 00:08:48,940
هيكاري؟

154
00:08:48,940 --> 00:08:49,980
هل أنتِ بخير؟

155
00:08:49,980 --> 00:08:52,450
!ثمّة عشّ طائر هناك

156
00:08:52,450 --> 00:08:53,710
إنّه تشيدوري

157
00:08:53,710 --> 00:08:55,820
الفِراخ تستعدُّ لمُغادرة العشّ

158
00:08:55,820 --> 00:08:56,840
تشيدوري؟

159
00:08:59,800 --> 00:09:01,680
ألا تفهمين؟

160
00:09:01,970 --> 00:09:04,750
تقولُ لكِ روسمان-سينسي أن تستسلمي

161
00:09:04,750 --> 00:09:07,190
...لكن إذا أحضرتُ القلنسوة من القمّة

162
00:09:07,190 --> 00:09:10,170
!غبيّة! من المستحيل أن تتمكّني من إحضار القلنسوة

163
00:09:10,170 --> 00:09:11,680
أيمكنُكِ فعلها؟

164
00:09:12,010 --> 00:09:13,460
هذا سهل

165
00:09:18,990 --> 00:09:20,540
!رائع

166
00:09:20,540 --> 00:09:21,350
ماذا؟

167
00:09:24,970 --> 00:09:28,020
!حتّى لو استطعت فعل هذا، لا جدوى

168
00:09:28,540 --> 00:09:31,700
لكن لا بدّ أن أفعلها

169
00:09:33,070 --> 00:09:34,500
!افعليها بنفسكِ

170
00:09:34,720 --> 00:09:36,980
!استطاعت روسمان-سينسي فعل ذلك

171
00:09:44,340 --> 00:09:46,750
هذا يكفي لليوم، صحيح؟

172
00:09:46,750 --> 00:09:47,690
تبدين مُتعبة

173
00:09:47,690 --> 00:09:49,040
لنستحمّ في حمّام الساونا

174
00:09:49,230 --> 00:09:50,580
ساونا؟

175
00:09:50,580 --> 00:09:52,790
عند التّعب، فالمكان الأمثل هو الساونا

176
00:09:52,890 --> 00:09:54,280
!أغلقي الباب

177
00:09:54,280 --> 00:09:55,910
!أنتِ تُخفضين درجة الحرارة

178
00:09:55,910 --> 00:09:57,030
!حاضرة

179
00:09:57,030 --> 00:10:01,200
سمعتُ أنّ سينسي تُتعبكِ كثيراً

180
00:10:01,200 --> 00:10:04,030
ناو-تشان قلقة عليكِ

181
00:10:04,030 --> 00:10:05,280
!لستُ كذلك

182
00:10:05,280 --> 00:10:06,480
كاريبوتشي

183
00:10:08,630 --> 00:10:09,370
!حاضرة

184
00:10:14,880 --> 00:10:16,450
!هذا بارد للغاية

185
00:10:16,450 --> 00:10:17,960
كان ذلك متعمّداً، أليس كذلك؟

186
00:10:17,960 --> 00:10:19,000
!لا

187
00:10:24,010 --> 00:10:26,260
اليوم الثّالث

188
00:10:25,100 --> 00:10:26,250
...أنا آسفة

189
00:10:26,250 --> 00:10:28,500
سأبقى بعيدة عنكِ

190
00:10:38,340 --> 00:10:39,780
إنّها لا تتعلّم

191
00:10:40,190 --> 00:10:41,760
ما زالَتْ تفعل ذلك

192
00:10:41,940 --> 00:10:44,100
وصلَتْ إلى نقطةٍ أبعد من البارحة

193
00:10:44,340 --> 00:10:46,460
ماذا ستفعلين إذا نجحَتْ؟

194
00:10:48,640 --> 00:10:49,630
سقطَتْ

195
00:10:50,120 --> 00:10:51,870
اليوم الرّابع

196
00:10:52,830 --> 00:10:53,740
!وجدتُها

197
00:10:56,790 --> 00:10:58,160
أتِلك هي خطّتها إذاً؟

198
00:10:58,940 --> 00:10:59,950
سقطَتْ

199
00:11:01,840 --> 00:11:03,490
ما الخطب يا هيكاري؟

200
00:11:03,490 --> 00:11:04,890
لماذا لا تأكلين؟

201
00:11:05,710 --> 00:11:08,010
قلتُ لنفسي لو كنتُ أخفّ، لاستطعتُ الصعود لارتفاعٍ أعلى

202
00:11:08,230 --> 00:11:10,740
حجمُ غبائكِ بحجم بارجة بحريّة

203
00:11:10,900 --> 00:11:12,260
...هذا سيّئ

204
00:11:12,980 --> 00:11:16,830
...أنا جائعة جدّاً ولا أقوى على ذلك

205
00:11:16,810 --> 00:11:18,320
اليوم السّادس

206
00:11:18,520 --> 00:11:20,710
!عليّ أن آكل كثيراً

207
00:11:22,200 --> 00:11:24,410
إنّها تتعبُ شيئاً فشيئاً

208
00:11:24,410 --> 00:11:27,530
استهلكَتْ كلّ قوّتها السحريّة لأيّام

209
00:11:27,530 --> 00:11:28,280
هذا ليس عادياً

210
00:11:28,280 --> 00:11:29,510
توقّفَتْ

211
00:11:34,160 --> 00:11:35,860
!هيكاري

212
00:11:38,810 --> 00:11:40,300
نامَتْ

213
00:11:42,650 --> 00:11:45,060
وها هي تُجبرنا على العمل

214
00:11:46,370 --> 00:11:48,750
ما الغاية من الاختبار؟

215
00:11:48,750 --> 00:11:50,440
هل أنتِ قلقة عليها؟

216
00:11:50,440 --> 00:11:52,350
...لا، لكن

217
00:11:53,540 --> 00:11:54,550
ماذا؟

218
00:11:54,760 --> 00:11:57,030
وعدتُها أنّها إذا استطاعَتْ إحضار القلنسوة من أعلى البرج

219
00:11:57,030 --> 00:11:58,820
سيكونُ بمقدورها مُشاركتنا في الهجوم

220
00:11:59,090 --> 00:12:02,350
إن كانَتْ لا تستطيعُ حتّى فعل ذلك فستموت
أثناء المعركة لو انضمَّتْ

221
00:12:17,560 --> 00:12:18,470
ماذا؟

222
00:12:19,520 --> 00:12:20,910
ماذا أفعلُ في غرفتي؟

223
00:12:22,570 --> 00:12:24,310
هل ستبدئين في هذه السّاعة؟

224
00:12:24,460 --> 00:12:25,900
!روسمان-سينسي

225
00:12:25,900 --> 00:12:27,330
تعالي معي

226
00:12:30,410 --> 00:12:33,800
هيكاري-سان، أي ساحرة تُريدين أن تكوني؟

227
00:12:33,800 --> 00:12:34,660
أي ساحرة؟

228
00:12:34,850 --> 00:12:38,300
أريدُ أن أكون ساحرة عظيمة تُساعدُ الجميع مثل أختي الكبيرة

229
00:12:38,530 --> 00:12:39,290
هذا مُستحيل

230
00:12:40,540 --> 00:12:41,710
لماذا؟

231
00:12:41,880 --> 00:12:44,440
،علّمتُ ذات مرّة فتاةً مثلكِ

232
00:12:44,440 --> 00:12:47,380
أرادَتْ أن تُقاتِل مهما كلّفَ الأمر

233
00:12:47,620 --> 00:12:50,650
...كانَتْ جادّة جدّاً ومُفعمة بالحيويّة، لكن

234
00:12:51,310 --> 00:12:53,720
كانَتْ قوّتها السحريّة ضعيفة؟

235
00:12:53,870 --> 00:12:54,680
أجل

236
00:12:54,870 --> 00:12:57,750
أدركَتْ أنّها لم تكُن مؤهّلة للقتال

237
00:12:57,860 --> 00:13:01,590
لكن استسلمتُ لحماستها، وسمحتُ لها بمُقاتلة النيوروي

238
00:13:01,970 --> 00:13:04,620
ماذا حلَّ بها؟

239
00:13:06,150 --> 00:13:07,860
لم تعُد قادرة على التّحليقِ مجدّداً

240
00:13:08,620 --> 00:13:11,400
في ساحةِ المعركة، النّاس الذين يفتقِرون لقدرة القتال

241
00:13:11,400 --> 00:13:14,210
لا يسبِّبون سوى الأحزان لأنفسهم ولمن حولهم

242
00:13:15,220 --> 00:13:17,790
لكن هل كانَتْ حزينة حقّاً؟

243
00:13:18,450 --> 00:13:22,980
سينسي، إذا كنتُ سأسبّبُ المتاعب للآخرين فسأعودُ إلى فوسو

244
00:13:22,980 --> 00:13:26,150
لكن إذا كانَ بمقدوري تقديم المُساعدة ولو قليلاً

245
00:13:26,150 --> 00:13:27,420
!فأريدُ البقاء هُنا

246
00:13:27,600 --> 00:13:28,470
...إذاً

247
00:13:28,470 --> 00:13:29,330
!أعلم

248
00:13:29,560 --> 00:13:30,850
عليّ إحضار القلنسوة، صحيح؟

249
00:13:31,080 --> 00:13:33,130
!دعيني أحاول حتّى اللّحظة الأخيرة

250
00:13:35,150 --> 00:13:36,830
افعلي ما تشائين

251
00:13:36,830 --> 00:13:37,590
!حسناً

252
00:13:40,620 --> 00:13:42,390
الرّياح شديدة

253
00:13:42,390 --> 00:13:43,870
واليوم هو يومها الأخير

254
00:13:43,870 --> 00:13:45,680
يا لحظّها السيّئ

255
00:13:53,270 --> 00:13:54,290
!هيكاري

256
00:13:59,280 --> 00:14:00,280
ماذا؟

257
00:14:01,760 --> 00:14:04,400
...يسرُّني أنّني لم أصِب العشّ

258
00:14:04,400 --> 00:14:06,280
هل أنتِ بخير؟

259
00:14:06,280 --> 00:14:08,310
!العشّ بخير

260
00:14:08,310 --> 00:14:09,390
تبّاً

261
00:14:16,760 --> 00:14:18,200
...مؤلم

262
00:14:18,570 --> 00:14:20,760
كلّما ارتفعت، تزداد شدّة الرّياح

263
00:14:20,760 --> 00:14:21,750
...هيكاري

264
00:14:21,750 --> 00:14:23,880
لا يمكنكِ فعلها وسط هذا الرّياح

265
00:14:23,880 --> 00:14:25,820
—اطلبي من روسمان-سينسي يوماً إضافياً

266
00:14:25,820 --> 00:14:28,550
لا، لن يكون هناك تمديداً

267
00:14:28,550 --> 00:14:29,690
...روسمان-سينسي

268
00:14:29,930 --> 00:14:31,690
الوقتُ يُداهمكِ

269
00:14:31,900 --> 00:14:32,770
!حاضرة

270
00:14:34,910 --> 00:14:35,850
توقّفي

271
00:14:35,850 --> 00:14:37,250
دعي ساقيكِ تتدلّيان من مكانكِ

272
00:14:37,590 --> 00:14:38,690
!سأسقط

273
00:14:38,690 --> 00:14:39,490
افعليها فحسب

274
00:14:39,490 --> 00:14:42,580
ركّزي القوّة السحريّة التي كانت قدماكِ تستخدمها
في يديكِ

275
00:14:43,160 --> 00:14:44,230
!حسناً

276
00:14:44,810 --> 00:14:46,560
هل هذا مُمكن؟

277
00:14:46,560 --> 00:14:48,330
ما الذي تفكِّرين به يا سينسي؟

278
00:14:48,330 --> 00:14:50,110
...أركّز على يديّ

279
00:14:53,010 --> 00:14:55,690
!فعلتُها! فعلتُها

280
00:14:55,690 --> 00:14:57,690
والآن أفلتي يدكِ اليُسرى

281
00:14:58,810 --> 00:15:01,820
لا تمتلكين القوّة السحريّة لتوزيعها
إلى كلّ أنحاء جسدكِ

282
00:15:01,820 --> 00:15:04,840
لكن يمكنُكِ تركيزها على نقطةٍ واحدة

283
00:15:05,280 --> 00:15:06,170
!حاضرة

284
00:15:10,650 --> 00:15:12,560
رائع، أتستخدم يداً واحدة فقط؟

285
00:15:12,560 --> 00:15:16,300
ضعي قوّتكِ السحريّة في يدكِ اليُسرى
ومن ثمّ بدّلي قبل أن تسقطي

286
00:15:16,300 --> 00:15:17,810
لا تستخدمي سوى يديكِ للتسلُّق

287
00:15:17,810 --> 00:15:18,840
!حسناً

288
00:15:20,230 --> 00:15:21,360
...إنّها

289
00:15:21,360 --> 00:15:22,390
والآن، اليمنى

290
00:15:22,390 --> 00:15:25,440
!حسناً

291
00:15:23,050 --> 00:15:23,660
يسار

292
00:15:24,330 --> 00:15:24,890
يُمنى

293
00:15:25,440 --> 00:15:26,470
رائع

294
00:15:27,260 --> 00:15:29,230
!إنّها تتسلّق... إنّها تتسلّق

295
00:15:29,400 --> 00:15:31,340
تستخدمُ يديها فحسب

296
00:15:35,330 --> 00:15:36,320
ماذا؟

297
00:15:36,320 --> 00:15:38,490
ألم تكوني ستدعينها تستسلم؟

298
00:15:39,340 --> 00:15:42,950
صحيح، نظراً لافتقارِها للسحر، هذا كُل ما لديها

299
00:15:43,170 --> 00:15:46,580
لكن حتّى لو استخدمَتْ هذه الطريقة
لتخطِّي اختباركِ، سيكون الأمر عسيراً من الآن فصاعداً

300
00:15:48,310 --> 00:15:50,560
الأمر يكمنُ في إصرارِها على عدمِ الاستسلام

301
00:15:51,480 --> 00:15:52,660
...هكذا إذاً

302
00:15:52,660 --> 00:15:54,140
وهل يُعجبكِ هذا في تلميذة؟

303
00:16:02,680 --> 00:16:04,400
!يمكنُكِ فعلها يا هيكاري

304
00:16:04,730 --> 00:16:08,110
هذا باردٌ جدّاً، يدايّ تتخدّران

305
00:16:11,370 --> 00:16:13,610
قاعدة سويارفي، شمال بُحيرة لادوغا

306
00:16:13,610 --> 00:16:16,910
تمّ رصد نيوروي متوسّط الحجم قادم من الشرق

307
00:16:17,060 --> 00:16:18,900
إلى كافّة السّاحرات، استعددن للهجوم

308
00:16:18,900 --> 00:16:19,800
!نيوروي؟

309
00:16:23,490 --> 00:16:25,200
ليتني استطعتُ الذهاب معها

310
00:16:27,770 --> 00:16:29,430
...أنا قريبة جدّاً

311
00:16:31,120 --> 00:16:32,780
نسيتُ شيئاً

312
00:16:32,780 --> 00:16:34,450
!كانّو

313
00:16:36,340 --> 00:16:38,350
...نفدت طاقتي

314
00:16:40,380 --> 00:16:41,780
!أنتِ

315
00:16:43,190 --> 00:16:44,360
كانّو-سان؟

316
00:16:44,360 --> 00:16:46,490
إلى متى ستبقين في القاعدة؟

317
00:16:46,490 --> 00:16:47,660
!أنتِ تثيرين غضبي

318
00:16:48,400 --> 00:16:52,180
تعلمين أنّه من المُستحيل أن تتمكّني من البقاء
في الجناح 502

319
00:16:52,180 --> 00:16:53,760
!لا نعلم ما لم نُحاول

320
00:16:53,760 --> 00:16:55,000
بل نعلم

321
00:16:55,000 --> 00:16:57,700
إذا حاولتِ جاهدة وفشلتِ فستفشلين
طوال حياتكِ

322
00:16:57,700 --> 00:16:59,200
!لستُ فاشلة

323
00:16:59,200 --> 00:17:01,050
!قلتُ أنّكِ فاشلة

324
00:17:01,050 --> 00:17:02,340
!لستُ فاشلة

325
00:17:02,340 --> 00:17:03,210
!بل أنتِ كذلك

326
00:17:03,210 --> 00:17:04,460
!لستُ كذلك

327
00:17:04,460 --> 00:17:07,080
!استسلمي وعودي إلى فوسو يا فاشلة

328
00:17:07,080 --> 00:17:15,290
!لستُ فاشلة

329
00:17:08,210 --> 00:17:11,940
!أنتِ فاشلة

330
00:17:15,290 --> 00:17:17,700
!لستُ فاشلة! لستُ فاشلة! لستُ فاشلة

331
00:17:17,750 --> 00:17:18,900
!لستُ فاشلة

332
00:17:18,900 --> 00:17:20,800
!لستُ... فاشلة

333
00:17:25,700 --> 00:17:27,140
فعلتِها في نهاية المطاف

334
00:17:31,920 --> 00:17:33,330
...كانّو-سان

335
00:17:33,770 --> 00:17:34,910
نجحتِ

336
00:17:35,590 --> 00:17:36,820
!سينسي

337
00:17:36,820 --> 00:17:38,710
سنُهاجم، استعدّي

338
00:17:41,650 --> 00:17:42,550
!حاضرة

339
00:17:46,390 --> 00:17:47,190
!إقلاع

340
00:17:51,290 --> 00:17:53,520
تشيدوري مختلف تماماً عن السّابق

341
00:17:53,520 --> 00:17:55,130
!يبدو سعيداً

342
00:17:55,310 --> 00:17:57,740
هذا هو الشّكل الحقيقي لنوع شيدين

343
00:17:57,740 --> 00:17:58,690
!سينسي

344
00:17:58,690 --> 00:17:59,640
هيّا بنا

345
00:17:59,640 --> 00:18:00,150
!حاضرة

346
00:18:02,080 --> 00:18:03,260
تمّ رصد نيوروي

347
00:18:03,260 --> 00:18:05,040
!كانّو، انطلقي أوّلاً

348
00:18:05,840 --> 00:18:07,370
!إلى الأمام أيّها الهجوم

349
00:18:07,370 --> 00:18:08,630
!الضابطة الطيّارة، سانديهن

350
00:18:08,630 --> 00:18:09,640
!عُلِم

351
00:18:10,150 --> 00:18:12,540
!حسناً... هيّا بنا

352
00:18:17,650 --> 00:18:19,500
!أنت تتقدّم كثيراً

353
00:18:25,440 --> 00:18:26,180
أين النُواة؟

354
00:18:29,350 --> 00:18:31,260
هذا سيّئ، لا أستطيعُ رؤيتها

355
00:18:31,260 --> 00:18:31,880
ماذا؟

356
00:18:32,730 --> 00:18:33,630
!إنّها هيكاري

357
00:18:33,740 --> 00:18:35,310
!فعلَتْها

358
00:18:36,450 --> 00:18:37,930
تأخّرتِ

359
00:18:41,600 --> 00:18:42,610
...هيكاري-سان

360
00:18:43,300 --> 00:18:45,460
لا يمكنُكِ أن تكوني مثل أختكِ

361
00:18:46,580 --> 00:18:50,440
استمرّي في مُراوغة الهجمات إلى أن تصبحي
قريبة بما يكفي لإصابة العدوّ

362
00:18:51,480 --> 00:18:53,520
كوني على طبيعتكِ أنتِ

363
00:18:54,520 --> 00:18:55,380
!حاضرة

364
00:18:59,800 --> 00:19:00,710
!يمين

365
00:19:02,310 --> 00:19:03,210
!يسار

366
00:19:05,250 --> 00:19:07,190
جسدي يتحرّكُ كيفما أشاء

367
00:19:07,380 --> 00:19:10,250
!أصبحتُ كتلة واحدة مع تشيدوري

368
00:19:12,990 --> 00:19:13,980
!رائع

369
00:19:13,980 --> 00:19:15,140
!إنّها تُراوغ هجماته

370
00:19:15,340 --> 00:19:17,560
نوع شيدين يدورُ كما ينبغي له

371
00:19:17,560 --> 00:19:19,990
إنّها تركّزُ قوّتها في الجهاز

372
00:19:19,990 --> 00:19:21,550
هل يعزو الفضلُ لتدريبها؟

373
00:19:21,550 --> 00:19:23,230
هذه روسمان-سينسي التي عهِدناها

374
00:19:37,810 --> 00:19:39,690
!أستطيعُ رؤية النُواة

375
00:19:45,410 --> 00:19:46,410
النُواة؟

376
00:19:46,410 --> 00:19:47,870
!وجدت هيكاري النُواة

377
00:20:05,280 --> 00:20:07,070
!رائع يا هيكاري

378
00:20:07,070 --> 00:20:09,110
إنّه حظّ مُبتدئة على ما أعتقد

379
00:20:09,110 --> 00:20:10,300
رأيتِ النواة؟

380
00:20:10,300 --> 00:20:11,730
أجل، رأيتها

381
00:20:11,730 --> 00:20:14,290
رأيتُها عندما تصادمنا كما آخر مرّة

382
00:20:14,480 --> 00:20:15,930
عندما تصادمتُما؟

383
00:20:19,020 --> 00:20:20,070
أأنتِ متأكّدة؟

384
00:20:20,070 --> 00:20:20,810
أجل

385
00:20:20,810 --> 00:20:24,230
يبدو أنّها لا تستطيع رُؤية النُواة
إلّا عند الاحتكاك بالنيوروي

386
00:20:24,230 --> 00:20:25,860
سمعتُ إشاعات حول هذا الأمر

387
00:20:26,120 --> 00:20:30,400
كاريبوتشي هيكاري، يبدو أنّكِ تتمتّعين
بسحر عين الاحتكاك الفريد من نوعه

388
00:20:30,400 --> 00:20:31,680
عين الاحتكاك؟

389
00:20:31,680 --> 00:20:33,050
لكن لا تستخدميه أبداً

390
00:20:34,020 --> 00:20:35,160
لماذا؟

391
00:20:35,160 --> 00:20:35,770
—إذا كنتُ أمتلك عينين سحريّتين

392
00:20:35,770 --> 00:20:37,340
لا ترمي بحياتكِ إلى التّهلكة

393
00:20:37,600 --> 00:20:40,720
لماذا برأيكِ استخدمَتْ تاكامي تلك التقنيّة؟

394
00:20:40,720 --> 00:20:41,660
أي تقنيّة؟

395
00:20:41,660 --> 00:20:44,280
العين المُطلَقة، ألم تسمعي بها؟

396
00:20:44,420 --> 00:20:45,790
العين المُطلَقة؟

397
00:20:46,060 --> 00:20:48,340
لم ترد أن تُثير قلقكِ إذاً؟

398
00:20:48,340 --> 00:20:50,480
سمعتُ القصّة خلال معركة ليباو

399
00:20:50,950 --> 00:20:55,850
إنّها تقنيّة قويّة تدعكِ ترين أكثر نُوى نيوروي متعدِّدة

400
00:20:55,850 --> 00:20:58,390
أو نُوى ذات نوعيّة خاصّة في طرفة عين

401
00:20:58,390 --> 00:21:01,670
،لكنّها تشكّلُ إجهاداً كبيراً على العقل والجسم

402
00:21:01,670 --> 00:21:04,760
وتُضعِف دروعكِ كثيراً

403
00:21:04,760 --> 00:21:07,910
لِذا استخدامها من دون مُساندة هو بمثابة انتحار

404
00:21:07,910 --> 00:21:12,100
لا تهدري التضحية التي ضحّتْها تاكامي
لحمايتكِ وحماية الأسطول

405
00:21:12,450 --> 00:21:13,740
...أختي

406
00:21:14,350 --> 00:21:16,260
هذا ما فعلَتْه إذاً

407
00:21:16,380 --> 00:21:17,210
اسمعي

408
00:21:17,210 --> 00:21:18,960
ممنوع استخدام عين الاحتكاك

409
00:21:18,960 --> 00:21:19,930
مفهوم؟

410
00:21:20,820 --> 00:21:22,200
مفهوم

411
00:21:24,050 --> 00:21:26,390
...أختي... تشيدوري

412
00:21:26,390 --> 00:21:28,700
استطعتُ البقاء في الجناح 502

413
00:21:33,890 --> 00:21:36,560
!هيكاري، مبروك

414
00:21:36,560 --> 00:21:40,110
خاب أملي لأنّني لم أستطع
إحضار نوع شيدين

415
00:21:40,530 --> 00:21:42,570
!سوف أصبح أقوى

416
00:21:45,810 --> 00:21:47,930
عليكِ أن تستمرّي في التّحليق

417
00:21:48,080 --> 00:21:51,270
وأن تصنعي هويّة خاصّة بكِ

418
00:21:51,970 --> 00:21:54,970
يتبع

419
00:23:26,470 --> 00:23:28,330
!تستمرُّ درجة الحرارة في الانخفاض

420
00:23:28,330 --> 00:23:30,040
...‏-20... -30

421
00:23:30,040 --> 00:23:32,080
كيف يُصبحُ برداً بهذه السّرعة؟

422
00:23:32,610 --> 00:23:33,910
هل هو نيوروي؟

423
00:23:33,920 --> 00:23:36,720
:الحلقة القادمة من ساحِرات شُجاعات
معركة مُميتة في البردِ القارس

424
00:23:36,730 --> 00:23:38,910
!ابقي على قيدِ الحياة مهما جرى حولكِ