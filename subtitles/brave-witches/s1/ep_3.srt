1
00:00:01,340 --> 00:00:05,360
بُعِثَتْ كاريبوتشي تاكامي من فوسو

2
00:00:05,360 --> 00:00:09,320
إلى الجناح القتالي المُشترَك 502، السّاحرات الشُجاعات

3
00:00:09,580 --> 00:00:13,800
لكن أثناء هجوم نيوروي على الأسطول، تعرّضَتْ لجروح

4
00:00:14,270 --> 00:00:18,720
تطوّعَتْ أختها هيكاري للانضمام بدلاً منها

5
00:00:19,140 --> 00:00:22,080
إذا أردتِ القتال فعليكِ أن تصبحي أقوى

6
00:01:58,470 --> 00:02:02,720
الأخت الصّغرى لمُساعدة المُلازم كاريبوتشي
تاكامي من فوسو

7
00:02:02,720 --> 00:02:05,210
ستنضمُّ إلينا بالنيابة عنها

8
00:02:05,210 --> 00:02:06,660
اسمي كاريبوتشي هيكاري

9
00:02:07,760 --> 00:02:09,780
سأفعلُ ما بوسعي بالنيابةِ عن أختي

10
00:02:11,510 --> 00:02:14,340
اسمي غوندولا رال، قائدة الجناح 502

11
00:02:14,560 --> 00:02:16,050
رتبتي هي قائدة طيران

12
00:02:16,310 --> 00:02:22,100
وأنا المُلازمة الطيّارة ألكساندرا إيفانوفنا بوكريشكين

13
00:02:22,100 --> 00:02:25,090
وأنا ضابطة الطيران والترود كروبينسكي

14
00:02:25,310 --> 00:02:27,170
هلّا ناديتِني بـالـ"كونتيسة"؟

15
00:02:27,320 --> 00:02:30,030
كونتيسة؟ هل أنتِ مهمّةٌ حقّاً؟

16
00:02:30,030 --> 00:02:32,930
يمكنكِ تجاهل دعاباتها

17
00:02:33,700 --> 00:02:35,260
هذا فظيع يا سينسي

18
00:02:35,450 --> 00:02:36,770
سينسي؟

19
00:02:36,770 --> 00:02:39,650
أنا الرّقيبة الطيّارة إديتا روسمان

20
00:02:39,650 --> 00:02:42,120
وأنا مدرّبة الجناح

21
00:02:42,820 --> 00:02:46,000
جورجيت ليماري، أنا ضابطة طيّارة

22
00:02:46,000 --> 00:02:48,430
شيموهارا ساداكو، أنا ضابطة طيّارة

23
00:02:49,920 --> 00:02:51,740
حان دوركِ يا كانّو

24
00:02:51,740 --> 00:02:52,950
لا يهمّني

25
00:02:55,580 --> 00:02:59,230
وبجانبي الضابطة الطيّارة كانّو ناوي

26
00:02:59,230 --> 00:03:02,380
وأنا الرّقيبة الطيّارة نيكّا إدفاردين كاتاياينين

27
00:03:02,380 --> 00:03:03,690
"ناديني "نيبّا

28
00:03:04,020 --> 00:03:05,970
حسناً، انتهينا من التعارُف

29
00:03:05,970 --> 00:03:07,350
لنأكل

30
00:03:08,740 --> 00:03:10,330
كاريبوتشي-سان

31
00:03:10,330 --> 00:03:12,430
هل يمكنُني أن أناديكِ هيكاري-تشان؟

32
00:03:12,600 --> 00:03:13,320
ماذا؟

33
00:03:16,310 --> 00:03:18,020
...نامَتْ

34
00:03:18,020 --> 00:03:20,780
لا بدّ وأنّ الهرّة الصغيرة مُتعبة

35
00:03:22,840 --> 00:03:24,650
ما المضحك في الأمر؟

36
00:03:26,040 --> 00:03:26,800
نُواة؟

37
00:03:29,960 --> 00:03:33,300
...أنا متأكّدة أنني رأيتُ نواة

38
00:03:33,550 --> 00:03:35,850
ماذا كان ذلك؟

39
00:03:38,830 --> 00:03:40,690
صباح الخير يا أختي

40
00:03:40,900 --> 00:03:42,870
سأفعلُ ما بوسعي، حسناً؟

41
00:03:45,560 --> 00:03:46,410
!حسناً

42
00:03:53,210 --> 00:03:55,090
أصبح الطقس بارداً جدّاً

43
00:03:55,090 --> 00:03:56,540
حقّاً؟

44
00:03:57,160 --> 00:03:59,500
لا يجدر بي أن أسأل سوميسيّة

45
00:03:59,500 --> 00:04:00,300
ماذا؟

46
00:04:00,300 --> 00:04:01,950
أحدهم يركض أمامنا

47
00:04:03,070 --> 00:04:04,640
إنّها كاريبوتشي-سان

48
00:04:04,810 --> 00:04:05,750
لنتخطّاها

49
00:04:10,010 --> 00:04:11,270
!صباح الخير

50
00:04:11,270 --> 00:04:12,180
!صباح النّور

51
00:04:12,180 --> 00:04:13,240
أتتدرّبين؟

52
00:04:13,240 --> 00:04:13,720
نعم

53
00:04:13,720 --> 00:04:15,270
!أنتِ بطيئة يا نيبّا

54
00:04:15,270 --> 00:04:17,050
ما مُشكلتك؟ تبّاً

55
00:04:21,600 --> 00:04:23,730
كاريبوتشي-سان تتبعنا

56
00:04:24,380 --> 00:04:27,610
لا تستطيع مُبتدئة أن تجاري سرعتنا

57
00:04:30,660 --> 00:04:31,870
كاريبوتشي؟

58
00:04:31,870 --> 00:04:32,610
نعم

59
00:04:34,500 --> 00:04:36,290
...لا أستطيع المتابعة

60
00:04:36,970 --> 00:04:38,050
!تبّاً

61
00:04:40,620 --> 00:04:42,660
!أنتِ

62
00:04:44,350 --> 00:04:46,420
!لا أقبل بهذا

63
00:04:46,420 --> 00:04:49,010
!لا يجوز أن تحلّي مكان تاكامي

64
00:04:50,450 --> 00:04:53,680
!كنتُ أنا وإيّاها سندمّر عشَّ النيوروي

65
00:04:53,680 --> 00:04:56,230
...لكن لأنّكِ كنتِ ضعيفة

66
00:04:56,540 --> 00:04:57,670
معكِ حقّ

67
00:04:57,910 --> 00:04:59,140
هذه غلطتي

68
00:04:59,430 --> 00:05:01,540
حدثَ ما حدثَ لأختي لأنّني كنتُ ضعيفة

69
00:05:01,780 --> 00:05:04,820
لكن سأضاعفُ جهودي وأصبح أقوى

70
00:05:04,950 --> 00:05:07,950
إذا كانت مُضاعفة الجهود هي كُل ما يتطلّبه
الأمر لتصبحي أقوى فسيكون ذلك سهلاً

71
00:05:08,230 --> 00:05:10,230
نحتاجُ الآن لشخصٍ جاهز للقتال

72
00:05:10,230 --> 00:05:12,070
!لا نعلم ما لم نحاول

73
00:05:12,410 --> 00:05:14,540
أنتما

74
00:05:14,540 --> 00:05:16,160
لا تتشاجرا

75
00:05:16,160 --> 00:05:17,250
كلّنا رفيقات

76
00:05:17,250 --> 00:05:18,150
!لسنا كذلك

77
00:05:18,820 --> 00:05:21,650
فالضعيف يعرّض الآخرين للخطر أيضاً

78
00:05:21,790 --> 00:05:24,680
!إذا أردتِ أن تصادقي أحداً فعودي إلى فوسو فوراً

79
00:05:24,680 --> 00:05:26,330
!كانّو

80
00:05:27,190 --> 00:05:28,690
أنا آسفة

81
00:05:28,690 --> 00:05:32,150
قد تكون قاسية، لكنّها ليسَتْ سيّئة

82
00:05:32,150 --> 00:05:35,640
كلّ ما في الأمر... أنّها تكافح بطريقتها الخاصّة

83
00:05:35,640 --> 00:05:36,920
أعلم هذا

84
00:05:37,130 --> 00:05:39,310
...لو كنتُ أقوى فقط

85
00:05:41,820 --> 00:05:45,320
بالمناسبة يا كاريبوتشي-سان، هل أنتِ عدّاءة
ماراثون أو ما شابه؟

86
00:05:45,460 --> 00:05:46,640
لا

87
00:05:46,640 --> 00:05:50,180
!كنتُ أركضُ فقط لأحضر الغداءَ لوالدي

88
00:05:50,670 --> 00:05:51,750
غداء؟

89
00:05:51,880 --> 00:05:52,900
نعم

90
00:05:54,090 --> 00:05:55,380
هذا مضحك

91
00:05:57,730 --> 00:06:00,020
نمتِ أثناء تناولكِ الطعام البارحة، صحيح؟

92
00:06:00,020 --> 00:06:01,990
اقتربَ موعد الفطور، هيّا بنا نعود

93
00:06:01,990 --> 00:06:03,770
...المعذرة يا نيبّا-سان

94
00:06:04,560 --> 00:06:07,950
شكراً لكِ لأنّكِ قلتِ أنّنا رفيقات

95
00:06:09,210 --> 00:06:10,260
هيّا بنا

96
00:06:12,130 --> 00:06:14,240
يبدو أنّها تتمتّع ببذرة لياقة

97
00:06:20,750 --> 00:06:22,350
تأكلين بشراهة

98
00:06:22,560 --> 00:06:25,080
عليّ أن آكل كثيراً وأصبح قويّة

99
00:06:25,080 --> 00:06:26,830
هل يُعجبكِ المذاق؟

100
00:06:27,040 --> 00:06:28,580
إنّه لذيذ

101
00:06:28,580 --> 00:06:30,400
هل أنتِ من أعددتِه يا شيموهارا-سان؟

102
00:06:30,630 --> 00:06:31,390
أجل

103
00:06:31,390 --> 00:06:33,120
،هنالك طاقم للطبخ

104
00:06:33,120 --> 00:06:35,270
لكن أحبُّ أن أطبخ

105
00:06:35,270 --> 00:06:38,910
هذا فطر البوليط المأكول يتناغمُ مع الزبدة، أليس كذلك؟

106
00:06:39,250 --> 00:06:43,490
قطفَتْه نيبا-سان في حديقة شوفالوف

107
00:06:44,380 --> 00:06:47,080
ربّما سنتناول فطر الشانتريل أو الكمأة في المرّة المقبلة

108
00:06:47,360 --> 00:06:48,530
...فطر الكمأة

109
00:06:48,530 --> 00:06:52,930
لكن إذا حطّمتِ جهازاً آخر فسأحرمكِ
من صيد الفطور

110
00:06:53,420 --> 00:06:54,880
!هذا ليس منصِفاً

111
00:06:55,150 --> 00:06:57,460
المعذرة، هل هناك طبقٌ ثانٍ؟

112
00:06:57,460 --> 00:06:59,630
أجل، هناك الكثير

113
00:07:00,440 --> 00:07:03,300
الفتيات اللّاتي يأكلن كثيراً ظريفات

114
00:07:04,120 --> 00:07:05,790
ظريفات؟

115
00:07:07,370 --> 00:07:12,680
،نحن ننظرُ حالياً إلى أهدافنا الرئيسيّة السّابقة

116
00:07:12,890 --> 00:07:14,740
عشّا النيوروي آنّا وفاسيليج

117
00:07:15,120 --> 00:07:18,410
...وهنالك أيضاً العشّ الجديد في البحر الأبيض

118
00:07:18,610 --> 00:07:20,400
...بقعة سيّئة أخرى

119
00:07:20,540 --> 00:07:24,990
"حسناً، سنُسمّي العشّ الجديد "غريغوري

120
00:07:24,990 --> 00:07:29,140
المنطِقة المتأثّرة بواسطة النيوروي الذين ينبثقون
من غريغوري تتوسّع بسرعة كبيرة

121
00:07:29,140 --> 00:07:31,910
وتُهدِّد بقطع خطوط إمدادنا

122
00:07:32,810 --> 00:07:36,740
إذا قُطِعَتْ خطوط إمدادنا، سنُجبَرُ جميعاً
على الانسحابِ من هذه القاعدة

123
00:07:36,890 --> 00:07:38,880
هذا سيّئ للغاية

124
00:07:38,880 --> 00:07:41,040
هذه أنباءٌ مخيفةٌ جدّاً

125
00:07:41,040 --> 00:07:46,810
هذا يعني أنّنا علينا تحييد غريغوري فوراً

126
00:07:47,030 --> 00:07:48,040
...عفواً

127
00:07:48,390 --> 00:07:50,840
هل هزيمة عشّ نيوروي أمر مُمكن؟

128
00:07:51,220 --> 00:07:55,390
قيلَ لكِ أنّ الجناح 501 قد أبادَ عشّ غاليا

129
00:07:55,650 --> 00:07:58,000
لكن كيف؟

130
00:07:58,000 --> 00:08:00,150
من المفترض أن يكون هذا سرّياً للغاية

131
00:08:00,360 --> 00:08:01,610
اللّعنة

132
00:08:01,950 --> 00:08:05,860
لكن بما أنّ الـ501 فعلوها، نستطيعُ فعلها أيضاً

133
00:08:06,350 --> 00:08:07,860
سأسحقُه

134
00:08:08,510 --> 00:08:09,830
معنويات عالية يا كانّو

135
00:08:10,070 --> 00:08:10,830
...كاريبوتشي

136
00:08:10,830 --> 00:08:12,200
!حـ-حاضرة

137
00:08:12,200 --> 00:08:13,990
ابدئي بالتدريب بعد ظهر اليوم

138
00:08:14,230 --> 00:08:16,650
إلى أن يحين ذلك، دعي إحداهنّ تأخذكِ
في جولةٍ حول القاعدة

139
00:08:16,650 --> 00:08:17,340
!حاضرة

140
00:08:17,910 --> 00:08:19,090
...المعذرة

141
00:08:19,250 --> 00:08:21,870
جورجيت-سان، هل يمكنكِ فعلها؟

142
00:08:22,560 --> 00:08:26,390
الـ-المعذرة، لديّ عمل أقوم به

143
00:08:26,390 --> 00:08:27,280
هكذا إذاً

144
00:08:27,280 --> 00:08:29,100
نيبا-سان إذاً

145
00:08:29,100 --> 00:08:29,960
بالتأكيد

146
00:08:30,820 --> 00:08:31,760
جيّد

147
00:08:31,760 --> 00:08:34,190
اتّبعن جدول الواجبات جميعاً

148
00:08:55,530 --> 00:08:57,200
!يا لها من إطلالة

149
00:08:57,200 --> 00:09:00,090
هذا هو البناء الأطول في المنطقة

150
00:09:00,090 --> 00:09:02,510
!يا لها من بلدة كبيرة

151
00:09:02,510 --> 00:09:06,870
قبل مجيء النيوروي، عاش مليونا نسمة في بطرسبرغ

152
00:09:06,870 --> 00:09:08,440
كلّ هذا العدد؟

153
00:09:08,440 --> 00:09:13,460
لكن أخلى الجميعُ الآن باستثناء الجنود
المطلوبين لحماية هذه القاعدة

154
00:09:13,660 --> 00:09:16,640
هذه قاعدة جبهة أماميّة ضدّ النيوروي

155
00:09:16,890 --> 00:09:19,100
...بلدة ضخمة كهذه

156
00:09:19,100 --> 00:09:20,220
إنّها كانّو

157
00:09:23,750 --> 00:09:24,870
...كانّو-سان

158
00:09:24,870 --> 00:09:28,380
لا بدّ وأنّها كانت غاضبة لأنّ
...كاريبوتشي-سان قد تخطّتها

159
00:09:29,600 --> 00:09:30,450
لا يهمّ

160
00:09:30,590 --> 00:09:32,760
لا ينبغي أن تحاولي تقليدها

161
00:09:32,760 --> 00:09:36,690
روسمان-سينسي قد طلبَتْ منّا تجنُّب العمل المُجهِد

162
00:09:52,010 --> 00:09:54,650
تشيدوري، أنا على وشك البدء بالتدريب

163
00:09:54,650 --> 00:09:56,270
!لنفعل ما بوسعنا معاً

164
00:09:56,790 --> 00:09:58,600
!سأفعلُ ما بوسعي أيضاً

165
00:09:58,600 --> 00:10:00,170
أهكذا كانت لتتكلّم؟

166
00:10:00,290 --> 00:10:01,670
ماذا تفعلين؟

167
00:10:01,670 --> 00:10:05,510
أخبرَتْني أختي أن أستمع لصوت جهازي

168
00:10:05,640 --> 00:10:07,700
يبدو أنّكِ تتحلّين بكثير من الصبر

169
00:10:09,880 --> 00:10:12,530
أتممتِ التدريب الأساسي والتدريب المتوسّط

170
00:10:12,530 --> 00:10:14,000
علامتكِ هي برتبة ف

171
00:10:14,320 --> 00:10:16,530
هذه الوثيقة لا جدوى منها

172
00:10:16,970 --> 00:10:18,380
ارتدي جهازكِ

173
00:10:18,510 --> 00:10:19,350
!حاضرة

174
00:10:24,660 --> 00:10:25,700
شغّلي المحرّك

175
00:10:27,450 --> 00:10:29,910
تمازُج القوّة السحريّة عند 9:1

176
00:10:29,910 --> 00:10:31,840
حافظي على سرعة الدوران في الدقيقة عند 1.500

177
00:10:32,100 --> 00:10:32,700
!حاضرة

178
00:10:34,500 --> 00:10:37,770
الفرق بين السرعة الدُّنيا وبين القصوى لدورانكِ
في الدقيقة هو 1.000

179
00:10:37,770 --> 00:10:39,500
ركّزي أكثر على التدريب

180
00:10:39,500 --> 00:10:40,660
هذا سيّئ للغاية

181
00:10:40,660 --> 00:10:41,830
عزّزيه إلى 2.000

182
00:10:41,830 --> 00:10:42,470
!حاضرة

183
00:10:44,820 --> 00:10:46,280
هذا أحدث نموذج لفوسو

184
00:10:46,280 --> 00:10:48,800
بقوّة حصانيّة 2.000 وسرعة قصوى 600 كم في السّاعة

185
00:10:49,100 --> 00:10:51,170
مسافته الفعّالة تنحصر ضمن فئة
الـ2.000 كم

186
00:10:51,310 --> 00:10:53,780
أنا متحمّسة لرؤيته يحلّق

187
00:10:53,780 --> 00:10:54,470
!إقلاع

188
00:11:03,710 --> 00:11:05,650
ظننتُها عزّزَتْها إلى 2.000

189
00:11:05,940 --> 00:11:07,760
إنّها لا تتسارع بشكل جيّد

190
00:11:08,140 --> 00:11:12,230
اصعدي لارتفاع 300 وقومي بدورة حول
الهيكل الخارجي للقاعدة

191
00:11:12,230 --> 00:11:14,500
ومن ثمّ تخطِّي المجال الجوّي للمُدرّج بسرعة قُصوى

192
00:11:14,670 --> 00:11:15,280
!حاضرة

193
00:11:20,860 --> 00:11:23,520
هل جهاز فوسو الجديد مَعيب؟

194
00:11:23,520 --> 00:11:25,530
