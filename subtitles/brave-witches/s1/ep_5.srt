198
00:12:23,710 --> 00:12:27,280
جورجيت، إذا تابعتِ فستعرّضين نفسكِ لخطر

199
00:12:28,210 --> 00:12:31,780
...أنتما، لباسكما

200
00:12:33,950 --> 00:12:35,380
!أنا أيضاً؟

201
00:12:35,380 --> 00:12:39,200
لتتشارك أجسامنا الحرارة بشكلٍ مباشر
خلعنا ملابسنا

202
00:12:42,240 --> 00:12:46,320
استخدمَتْ جورجيت الحرارة من سحرِها الشّفائي
لتدفئتكِ طوال اللّيل

203
00:12:46,850 --> 00:12:48,280
...أنا آسفة

204
00:12:48,280 --> 00:12:51,790
اندفعتُ للأمام دون الإصغاء إليكما

205
00:12:52,080 --> 00:12:53,160
...لا

206
00:12:53,690 --> 00:12:56,600
أنا من ينبغي أن يعتذر

207
00:12:57,990 --> 00:13:00,480
النظر إليكِ يؤلمني

208
00:13:02,210 --> 00:13:04,450
لأنّني لم أستطع مُعالجة تاكامي-سان

209
00:13:04,570 --> 00:13:05,620
...جورجيت-سان

210
00:13:06,360 --> 00:13:10,400
كان ينبغي أن أعتذر من البداية، لكن افتقرتُ للشجاعة

211
00:13:11,070 --> 00:13:12,870
كنتُ أتهرّبُ منكِ

212
00:13:14,560 --> 00:13:17,500
...لا أعتقد أنّ هذا كافٍ لتسامحيني، لكن

213
00:13:18,060 --> 00:13:19,230
!أنا آسفة

214
00:13:19,980 --> 00:13:24,210
لا، نجَتْ أختي فقط بفضل وجودك إلى جانبها

215
00:13:24,380 --> 00:13:27,150
!أنا ممتنّةٌ للغاية

216
00:13:28,410 --> 00:13:29,720
...كاريبوتشي-سان

217
00:13:33,670 --> 00:13:36,330
كلتاكما صديقان الآن، أليس كذلك؟

218
00:13:49,190 --> 00:13:51,610
ألا يمكننا أن نضرم ناراً؟

219
00:13:51,850 --> 00:13:54,010
...لم نجد شيئاً قابلاً للحرق

220
00:13:54,150 --> 00:13:55,120
هل أنتِ بردانة؟

221
00:13:55,120 --> 00:13:57,030
—لا، أنا بخير

222
00:13:57,970 --> 00:13:59,610
...وجدتُ سلاحكِ، لكن

223
00:13:59,740 --> 00:14:00,920
...السّبطانة

224
00:14:00,920 --> 00:14:02,630
لا أستطيع أن أطلق هكذا، صحيح؟

225
00:14:02,750 --> 00:14:03,890
ماذا عن النيوروي؟

226
00:14:04,200 --> 00:14:06,070
يبدو أنّهم ابتعدوا

227
00:14:06,410 --> 00:14:08,460
لم يتوجّه نحو القاعدة، صحيح؟

228
00:14:08,700 --> 00:14:10,290
!علينا أن نسرع ونبلغهم

229
00:14:10,370 --> 00:14:12,800
...لكن الرّاديو لا يستجيب

230
00:14:13,080 --> 00:14:15,350
ولا يمكننا التحرّك وسط هذه العاصفة الثلجيّة

231
00:14:17,180 --> 00:14:21,790
!علينا أن ننجو بأنفسنا فحسب ونخبر القاعدة عن النيوروي

232
00:14:22,290 --> 00:14:24,610
وجدتُ شيئاً مثيراً على مقربة من هنا

233
00:14:24,610 --> 00:14:25,990
لنذهب إلى هناك

234
00:14:26,520 --> 00:14:27,840
دبّابة؟

235
00:14:27,840 --> 00:14:30,310
هل تدمّرت أثناء المعركة ضدّ النيوروي؟

236
00:14:33,100 --> 00:14:34,940
...لكنّها باردة جدّاً

237
00:14:34,940 --> 00:14:37,070
عثرتُ على هذه فحسب

238
00:14:37,770 --> 00:14:39,370
لحاء شجرة القضبان البيضاء

239
00:14:39,590 --> 00:14:42,980
تحتوي على زيت لذا ستحترق ولو كانت مبتلّة

240
00:14:49,140 --> 00:14:50,890
!إنّها دافئة للغاية

241
00:14:50,890 --> 00:14:53,860
شيموهارا-سان، أيمكنُكِ أن تضرمي ناراً حتّى؟

242
00:14:53,860 --> 00:14:57,420
كان أبي عالِماً، لهذا كنّا كثيراً ما نذهب للتخييم

243
00:14:57,880 --> 00:14:59,600
تعلّمتُ الكثير

244
00:15:02,820 --> 00:15:06,210
بالمناسبة، لم نأكل منذُ البارحة، صحيح؟

245
00:15:06,210 --> 00:15:07,200
!هذا صحيح

246
00:15:07,640 --> 00:15:09,310
!لديّ بعض البسكويت

247
00:15:09,310 --> 00:15:10,640
لنتشاطرها

248
00:15:10,640 --> 00:15:11,870
حقّاً؟

249
00:15:11,870 --> 00:15:13,550
!نعم، بالطبع

250
00:15:14,410 --> 00:15:15,760
ما هذا؟

251
00:15:16,120 --> 00:15:18,480
إنّه حساء، صحيح؟ ربّما

252
00:15:22,160 --> 00:15:24,260
ما رأيكن؟ لذيذ، أليس كذلك؟

253
00:15:24,260 --> 00:15:28,530
أعددتُه بكلِّ مشاعر الحبّ، ومن خيرة
المكوّنات التي وجدتها سينسي

254
00:15:28,530 --> 00:15:29,980
!ماذا؟

255
00:15:35,060 --> 00:15:39,990
...الكافيار الأوروشي النّادر الذي قضيتُ عاماً أجمعه

256
00:15:40,930 --> 00:15:43,220
!تبّاً لكِ أيّتها الكونتيسة المزيّفة

257
00:15:43,370 --> 00:15:44,220
ما هذا؟

258
00:15:44,220 --> 00:15:46,820
...نحتاجُ لطبخ شيموهارا حقّاً

259
00:15:47,720 --> 00:15:49,500
ر-رائعة يا قائدة الطيران

260
00:15:49,500 --> 00:15:51,550
أنتِ هادئة حتّى في وقتٍ كهذا

261
00:15:52,960 --> 00:15:54,060
هذا فظيع

262
00:15:56,500 --> 00:15:58,730
ألا تتوقّف إطلاقاً؟

263
00:15:59,190 --> 00:16:02,360
من كان يتوقّع أن يبعث النيوروي هواءً بارداً؟

264
00:16:02,490 --> 00:16:06,970
إنّه يستخدمُ الهواءَ البارد لتحفيز الجبهة الباردة
مسبّباً عاصفة ثلجيّة

265
00:16:07,490 --> 00:16:10,260
ينبغي أن تكون العاصفة الثلجيّة قد هبّت
على بطرسبرغ الآن أيضاً

266
00:16:10,260 --> 00:16:13,620
هل تعلمُ القاعدة بأنّ العاصفة الثلجيّة
هي من صنيعِ نيوروي؟

267
00:16:13,740 --> 00:16:15,620
أشكُّ في أنّهن سيتوقّعن ذلك

268
00:16:15,620 --> 00:16:17,510
!إذاً ينبغي أن نسرع ونخبرهن

269
00:16:17,510 --> 00:16:19,020
لكن كيف؟

270
00:16:19,590 --> 00:16:22,300
علينا حالياً أن ننتظر حتّى تتوقّف
العاصفة الثلجيّة

271
00:16:26,240 --> 00:16:28,720
هل من أنباء عن فرق البحث البرّية؟

272
00:16:28,720 --> 00:16:29,920
ليس بعد

273
00:16:30,090 --> 00:16:34,430
هل تعتقدان حقّاً أنّ هذه العاصفة الثلجيّة
لها ارتباط بالنيوروي؟

274
00:16:35,860 --> 00:16:38,540
يبدو الهواء غريباً

275
00:16:44,310 --> 00:16:46,230
كاريبوتشي-سان، انهضي

276
00:16:47,190 --> 00:16:48,750
!توقّفت العاصفة الثلجيّة

277
00:16:55,940 --> 00:16:58,130
بطرسبرغ حالكة السّواد

278
00:16:58,350 --> 00:17:00,710
يبدو أنّ عاصفة ثلجيّة رهيبة تحيطُ بها

279
00:17:00,880 --> 00:17:03,240
...إذا توقّفت العاصفة الثلجيّة في هذه الأوساط فهذا يعني

280
00:17:03,620 --> 00:17:05,100
النيوروي تحرّك، صحيح؟

281
00:17:05,250 --> 00:17:08,970
إذاً أنا متأكّدة أنّ القاعدة قد أدركَتْ
ذلك وشنّت هجومها

282
00:17:09,230 --> 00:17:10,900
لا أجزم في ذلك

283
00:17:11,780 --> 00:17:13,640
النيوروي مختبئ في الغيوم

284
00:17:13,800 --> 00:17:15,630
...لا يمكن رؤيته من القاعدة

285
00:17:15,900 --> 00:17:18,460
قد لا يظهر أيضاً في الرّادار

286
00:17:18,460 --> 00:17:21,280
وهُنّ لا يستطعن التّحليق وسطَ عاصفة
ثلجيّة بتلك الشدّة

287
00:17:21,840 --> 00:17:26,520
ما يعني أنّنا قد نكون الوحيدات اللّاتي نعلم
بشأن النيوروي

288
00:17:26,520 --> 00:17:28,830
!لنهزمه سوية إذاً

289
00:17:28,830 --> 00:17:31,760
لكن إذا كنّا قريبين فسيُجمّدنا الهواء البارد مجدّداً

290
00:17:34,340 --> 00:17:36,050
لا شيء مُستحيل بالنسبة لساحرة

291
00:17:37,180 --> 00:17:39,340
كانت قائدتي تقول ذلك كثيراً

292
00:17:39,760 --> 00:17:42,370
!أليس كذلك؟ لنحاول

293
00:17:43,670 --> 00:17:46,090
إذا دفّأنا أجهزتنا، نستطيع الطيران حينئذ

294
00:17:46,090 --> 00:17:47,920
لكن لا نمتلك أسلحة صالحة للاستعمال

295
00:17:47,920 --> 00:17:49,060
ماذا نفعل؟

296
00:17:49,390 --> 00:17:50,930
استخدما الحرارة لكسرها

297
00:17:51,380 --> 00:17:52,640
حرارة؟

298
00:17:52,640 --> 00:17:55,230
،إذا وضعتُما ماءً ساخناً في زُجاجٍ بارد

299
00:17:55,230 --> 00:17:57,360
فإنّ الفارق في درجة الحرارة يسهّلُ عمليّة الكسر

300
00:17:57,560 --> 00:18:02,150
بعبارة أخرى، إذا دفأناه بسرعة فسيغدو
كسره أسهل؟

301
00:18:02,150 --> 00:18:04,390
نعم، سنستخدمُ الوقود لفعل ذلك بسرعة

302
00:18:04,390 --> 00:18:05,360
!رائع

303
00:18:05,360 --> 00:18:07,460
لكن أين يمكننا العثور على وقود؟

304
00:18:08,620 --> 00:18:09,470
نعم

305
00:18:10,390 --> 00:18:11,310
هنا

306
00:18:11,650 --> 00:18:13,720
لكن ماذا عن النُّواة؟

307
00:18:14,190 --> 00:18:17,200
!لنلكمها فحسب مثل كانّو-سان

308
00:18:17,200 --> 00:18:19,480
لا يمكننا فعل ذلك

309
00:18:19,480 --> 00:18:20,340
...لكن

310
00:18:21,380 --> 00:18:22,990
لديّ فكرة سديدة

311
00:18:38,790 --> 00:18:41,260
هذا سيجعلُ البرد مقبولاً أكثر

312
00:18:41,260 --> 00:18:44,750
وضعتُ قطعَ ألمنيوم صغيرة في وقود
المحرّكات الذي جمعناه

313
00:18:44,890 --> 00:18:47,300
سيحوّله هذا إلى عامِل احتراق بسيط

314
00:18:47,300 --> 00:18:48,060
!نعم

315
00:18:48,390 --> 00:18:50,040
حسناً، هيّا بنا

316
00:18:50,040 --> 00:18:50,980
!حاضرة

317
00:18:55,760 --> 00:18:56,990
انظرا

318
00:18:57,830 --> 00:18:58,990
...إنّ بحيرة لادوغا

319
00:18:59,120 --> 00:19:00,780
!متجمّدة

320
00:19:01,980 --> 00:19:03,760
...يزداد الطقس برودة

321
00:19:04,110 --> 00:19:05,430
لا شكّ في ذلك

322
00:19:05,430 --> 00:19:07,370
النيوروي داخل تلك الغيوم

323
00:19:07,910 --> 00:19:09,920
!لندخل الغيوم

324
00:19:14,990 --> 00:19:17,080
!بـ-برد

325
00:19:18,240 --> 00:19:20,260
!سادا-تشان، علينا أن نسرع

326
00:19:22,560 --> 00:19:23,770
!ابدآ بالهجوم

327
00:19:28,490 --> 00:19:29,930
!احترق

328
00:19:40,860 --> 00:19:42,040
!النّواة هناك

329
00:19:42,040 --> 00:19:42,760
!نعم

330
00:19:47,860 --> 00:19:50,140
!لا! بدأ يتجمّد بهذه السّرعة

331
00:19:50,460 --> 00:19:52,450
!سأدعم شيموهارا-سان

332
00:19:52,590 --> 00:19:54,930
!دفّئي جهازكِ أنتِ

333
00:19:54,930 --> 00:19:58,660
هذا سيّئ! لا أستطيعُ استخدام السّحر
الشّفائي ما لم يكن هنالك شخصاً جريحاً

334
00:19:59,280 --> 00:20:00,140
...إذاً

335
00:20:01,050 --> 00:20:02,450
!كاريبوتشي-سان؟

336
00:20:04,140 --> 00:20:05,750
هل سيَفي هذا بالغرض؟

337
00:20:06,310 --> 00:20:07,030
نعم

338
00:20:13,220 --> 00:20:15,300
والآن يمكننا الطيران لفترةٍ أطول

339
00:20:15,420 --> 00:20:17,220
شكراً لكما

340
00:20:18,020 --> 00:20:20,170
!انطلق

341
00:20:31,150 --> 00:20:32,640
!نجحنا

342
00:20:32,640 --> 00:20:33,920
!نجحنا يا فتيات

343
00:20:33,920 --> 00:20:35,440
!نجحنا يا سادا-تشان

344
00:20:35,440 --> 00:20:37,140
!شكراً لكما

345
00:20:37,140 --> 00:20:40,180
والآن لنعد إلى القاعدة، أنا جائعة

346
00:20:40,600 --> 00:20:41,380
نعم

347
00:20:44,420 --> 00:20:47,470
يسرُّني أنّكن أنتنّ الثّلاثة بأمان

348
00:20:47,470 --> 00:20:50,830
إذا كانت عاصفة ثلجيّة كتلك كافية لقتلكن
فهذا مثيرٌ للشفقة

349
00:20:50,830 --> 00:20:54,280
...يا لكِ من كاذبة فظيعة يا ناو-تشان

350
00:20:54,470 --> 00:20:58,220
مع هذا، من كان يتوقّع وجود نيوروي
خلف العاصفة الثلجيّة؟

351
00:20:58,220 --> 00:21:01,640
كان عملاً ممتازاً يا فتيات

352
00:21:02,000 --> 00:21:03,840
لا، قمنا بعملنا فحسب

353
00:21:05,370 --> 00:21:06,990
!يبدو لذيذاً

354
00:21:06,990 --> 00:21:09,340
اليوم، جرّبتُ إعداد طعام
على طريقة فوسو

355
00:21:11,930 --> 00:21:15,380
إنّ طبخ شيموهارا-سان مذهل حقّاً، أليس كذلك؟

356
00:21:17,670 --> 00:21:19,310
...هذه التشاوانموشي

357
00:21:19,710 --> 00:21:22,900
نعم، وجدتُ بعضاً من الكافيار المتبقّي
في أسفل العُلَب

358
00:21:22,900 --> 00:21:24,020
فاستخدمتُه

359
00:21:24,020 --> 00:21:26,980
!تجيدين استخدام الكافيار حقّاً

360
00:21:26,980 --> 00:21:30,020
بشكلٍ مختلفٍ تماماً عن كونتيسة مزيّفة معيّنة

361
00:21:30,020 --> 00:21:33,160
الكافيار مالح وحارّ، لا أدري ما الذي
يُعجبكن فيه

362
00:21:33,160 --> 00:21:35,400
!لهذا أنتِ كونتيسة مزيّفة

363
00:21:35,600 --> 00:21:37,000
هذا من دواعي سروري

364
00:21:37,110 --> 00:21:39,940
،من الرّائع الفوز في ساحة المعركة

365
00:21:39,940 --> 00:21:41,990
لكن هذا رائع أيضاً، أليس كذلك؟

366
00:21:47,040 --> 00:21:49,620
قوّة الطعام مذهلة، أليس كذلك؟

367
00:21:51,970 --> 00:21:54,970
يتبع

368
00:21:52,370 --> 00:21:53,290
إنّه شهيّ

369
00:22:26,090 --> 00:22:28,740
بطرسبرغ صامتة وفارغة

370
00:22:29,250 --> 00:22:31,720
...عندما ذهبتُ بحثاً عن النيوروي، وجدت

371
00:22:31,860 --> 00:22:35,000
ذكريات زمن ضائع؟ أم وهم؟

372
00:22:35,670 --> 00:22:38,840
الحلقة القادمة من ساحرات شُجاعات: حظّاً سعيداً