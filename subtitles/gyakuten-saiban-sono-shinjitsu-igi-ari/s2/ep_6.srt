1
00:00:00,660 --> 00:00:03,400
.سوف أنطق بالحكم

2
00:00:03,400 --> 00:00:05,480
!أعلن المدّعى عليه مذنبًا

3
00:00:05,830 --> 00:00:08,720
!كلاّ! ليته كان هنا

4
00:00:08,720 --> 00:00:09,570
!أعترض

5
00:00:10,410 --> 00:00:11,980
!ذلك الصّوت

6
00:00:11,980 --> 00:00:15,910
.أنا أؤمن بموكّليّ وأقطّع الأشرار

7
00:00:17,160 --> 00:00:21,590
المحامي السّاموراي ناروهودو ريويتشي
!يدخل غمار المعركة

8
00:00:22,390 --> 00:00:24,350
...إن وجدتم أنفسكم في ضائقة قضائيّة

9
00:00:24,350 --> 00:00:26,660
!اتّصلوا بمكتب ناروهودو وشركائه للمحاماة

10
00:00:32,380 --> 00:00:35,510
!ليس جيّدًا! لنعد تصويره يا ناروهودو-كُن

11
00:00:35,510 --> 00:00:37,470
ماذا؟ مرّة ثانية؟

12
00:00:37,470 --> 00:00:41,170
...بالطّبع! إلى أن نصوّر اللّقطة المثلى

13
00:00:41,970 --> 00:00:44,490
!حسنًا، لنأخذ استراحة

14
00:00:44,980 --> 00:00:47,020
.نلت كفايتي

15
00:02:18,450 --> 00:02:20,910
ماذا؟ اكتفيت؟

16
00:02:22,440 --> 00:02:25,620
.اسمعي، هناك طرق عديدة للتّرويج لمكتبنا

17
00:02:25,620 --> 00:02:29,650
.فهمت. أنت لا تحبّ كونك المحامي السّاموراي

18
00:02:30,130 --> 00:02:33,880
.لا بأس. يمكنك أن تكون المحامي الجنرال

19
00:02:33,880 --> 00:02:36,570
.هذه ليست المشكلة

20
00:02:38,130 --> 00:02:39,350
!هذه الأغنية

21
00:02:39,350 --> 00:02:40,890
.إنّها ساموراي الإشارات

22
00:02:41,240 --> 00:02:45,720
.يعيد هذا الذّكريات لي
كنت تحبّ هذا العرض، صحيح؟

23
00:02:45,720 --> 00:02:48,020
المذياع؟

24
00:02:49,210 --> 00:02:50,230
ما الخطب؟

25
00:02:50,230 --> 00:02:53,300
.لا شيء. للمذياع مكانة مميّزة في قلبي

26
00:02:53,300 --> 00:02:56,200
!ماذا؟ ماذا؟ أخبرني بالمزيد

27
00:02:59,250 --> 00:03:01,720
.أعتقد أنّ الأمر حدث عندما كنّا في الإعداديّة

28
00:03:04,790 --> 00:03:07,090
.انتظر يا ناروهودو

29
00:03:08,870 --> 00:03:10,830
.ياهاري

30
00:03:10,830 --> 00:03:12,640
.كم أنا نعسان

31
00:03:12,640 --> 00:03:16,050
أخبرني، هل شاهدت حلقة
ساموراي قوس قزح البارحة؟

32
00:03:16,420 --> 00:03:18,630
!"الإطاحة بالشّر باسم العدالة الملوّنة"

33
00:03:18,630 --> 00:03:23,770
لقد أخبرتك أنّني ما عدت أشاهد
.ساموراي الإشارات وما شابه

34
00:03:23,770 --> 00:03:25,220
ما بالك؟

35
00:03:26,090 --> 00:03:30,620
،أنا الآن مهتمّ بالكامل بالمذياع
!إنّه تسلية الكبار

36
00:03:30,620 --> 00:03:32,140
المذياع؟

37
00:03:32,930 --> 00:03:35,480
،ها أنا ذي أرسل لكم أطيب المشاعر

38
00:03:35,480 --> 00:03:38,190
!معكم رفيقة غدائكم تومورينا

39
00:03:38,190 --> 00:03:41,240
!تومورينا-تشان

40
00:03:41,240 --> 00:03:44,250
.حان وقت أوّل أغنية لدينا
.إنّها حماسيّة وجدّ شيّقة

41
00:03:44,250 --> 00:03:46,050
ألديكم ما يكفي من الفلفل في طعامكم؟

42
00:03:46,050 --> 00:03:47,590
!أجل

43
00:03:47,590 --> 00:03:50,160
تسلية الكبار"؟"

44
00:03:52,460 --> 00:03:54,630
.أوقعت شيئًا ما

45
00:03:56,660 --> 00:03:59,580
ما زلت تحمل ذلك الشّيء؟

46
00:03:59,580 --> 00:04:00,690
...ولكن

47
00:04:00,690 --> 00:04:04,370
.أراهن أنّ ميتسوروغي قد رمى خاصّته الآن

48
00:04:07,030 --> 00:04:09,230
.ذلك الفتى غير معقول

49
00:04:09,230 --> 00:04:12,120
.لقد انتقل دون إخبارنا كيف نتّصل به

50
00:04:12,120 --> 00:04:14,560
لكن هل يمكننا لومه؟

51
00:04:14,560 --> 00:04:16,330
...تعرف ما حدث

52
00:04:16,330 --> 00:04:18,190
...أعلم ولكن

53
00:04:19,090 --> 00:04:23,280
قبل ثلاث سنوات، وقعت جريمة
،قتل شنيعة في المحكمة

54
00:04:23,280 --> 00:04:27,740
.وفقد ميتسوروغي والده الّذي كان محامي دفاع

55
00:04:28,150 --> 00:04:31,950
كان عليه الانتقال خارج هذه البلدة
.بعدما لم يعد يوجد له عائلة هنا

56
00:04:32,320 --> 00:04:35,000
.ولم يتّصل بنا مذّاك الحين

57
00:04:36,600 --> 00:04:42,550
.ما زلنا لا نعرف من كان القاتل
.لكنّنا نعرف أنّه بقي وحيدًا

58
00:04:42,920 --> 00:04:45,590
.أتمنّى أن يكون على ما يرام

59
00:04:45,590 --> 00:04:49,640
.من يدري؟ أتساءل كيف حال كلبه الصّغير أيضًا

60
00:05:07,370 --> 00:05:08,370
...أنت

61
00:05:09,720 --> 00:05:11,740
ألا يبدو مثل أبي؟

62
00:05:12,290 --> 00:05:13,620
لماذا ألبسته هذه الملابس؟

63
00:05:15,130 --> 00:05:17,580
.لأنّك لا تبتسم أبدًا

64
00:05:19,960 --> 00:05:21,880
.سيبدو هذا الوشاح أفضل في الحقيقة

65
00:05:24,340 --> 00:05:26,590
!انتظر! عد إلى هنا

66
00:05:37,810 --> 00:05:39,940
!يو، يو، يو

67
00:05:39,940 --> 00:05:42,360
،سيوف العدالة السّبعة
!كلّ بلونه الخاصّ

68
00:05:42,750 --> 00:05:46,450
!نحن ساموراي قوس قزح

69
00:05:48,990 --> 00:05:50,330
.كم هذا سخيف

70
00:06:04,870 --> 00:06:06,220
.أهلاً بعودتك يا أبي

71
00:06:07,170 --> 00:06:08,220
.أهلاً بعودتك

72
00:06:17,570 --> 00:06:21,180
أخبرني يا أبي. هل فزت بمحاكمة اليوم؟

73
00:06:21,180 --> 00:06:22,060
.بالطّبع

74
00:06:22,430 --> 00:06:24,220
.هذا هو المتوقّع من أبي

75
00:06:24,220 --> 00:06:26,900
.سوف أصبح مدّعية عامّة عندما أكبر

76
00:06:28,150 --> 00:06:29,190
فعلاً؟

77
00:06:29,770 --> 00:06:31,620
أستتّبع خطوات والدك أيضًا؟

78
00:06:33,810 --> 00:06:35,370
...كلاّ، لست أدري بعد

79
00:06:35,720 --> 00:06:39,640
صحيح. خذ ريجي إلى إحدى
.محاكماتك يا أبي

80
00:06:41,000 --> 00:06:42,160
...لكنّني

81
00:06:42,160 --> 00:06:43,460
.لا بأس

82
00:06:43,480 --> 00:06:44,810
!أجل

83
00:06:44,810 --> 00:06:49,050
وأيضًا، هنالك مكان أريد الذّهاب
.إليه بعد المحاكمة

84
00:07:00,820 --> 00:07:01,890
...أبي

85
00:07:03,590 --> 00:07:05,610
.فلتبدأ مسألة الميتم

86
00:07:05,920 --> 00:07:07,480
.قرّرت إرسال ريجي إلى هناك

87
00:07:11,540 --> 00:07:18,000
إنّه ذلك الألم ثانية... ما زلت عائقًا
في طريقي يا ميتسوروغي شين؟

88
00:07:27,250 --> 00:07:30,970
!أطلق سراح أبي

89
00:07:47,110 --> 00:07:48,790
ما الّذي سيتناوله الجميع على الغداء اليوم؟

90
00:07:48,790 --> 00:07:51,530
!لديّ كعك قواقع مشويّة

91
00:07:51,530 --> 00:07:53,780
!يبدو هذا لذيذًا

92
00:07:56,570 --> 00:07:58,360
فوّتّ الفصول اليوم؟

93
00:08:00,230 --> 00:08:02,710
!لننتقل للطّلبات الآن

94
00:08:02,710 --> 00:08:04,170
!أجل

95
00:08:04,690 --> 00:08:07,790
!وجدت طريقة للاتّصال بميتسوروغي

96
00:08:11,550 --> 00:08:15,250
!لـ-لماذا لم يتمّ إطلاعي على هذا الدّليل؟

97
00:08:15,250 --> 00:08:18,140
.لم نفسك لأنّك لم تكن متعمّقًا في تحقيقك

98
00:08:18,530 --> 00:08:21,140
.كاروما مثاليّ

99
00:08:21,140 --> 00:08:23,490
لكن هل كنت جاهزًا لتكون كذلك؟

100
00:08:23,490 --> 00:08:26,610
.سل قلبك هذا وفكّر في أخطائك

101
00:08:28,870 --> 00:08:30,230
!مذنب

102
00:08:34,230 --> 00:08:36,370
.هنالك شخص مذهل في مكتب المدّعي العامّ

103
00:08:36,890 --> 00:08:39,400
أليس المدّعون العامّون هم أعداؤك؟

104
00:08:39,400 --> 00:08:40,950
.ذلك ليس صحيحًا تمامًا يا ريجي

105
00:08:41,390 --> 00:08:45,000
.إنّنا نتقاتل لإيجاد الحقيقة

106
00:08:45,410 --> 00:08:47,920
لا نغضّ الطّرف عن أيّ تناقض
.ونحرص على أن يُعاقب الشّرّ

107
00:08:48,630 --> 00:08:51,130
.أو على الأقلّ ذلك ما أريد أن نكونه

108
00:08:56,600 --> 00:08:59,380
.نصر ساحق آخر أيّها المدّعي العام كاروما

109
00:08:59,380 --> 00:09:01,520
.فوز آخر يُضاف لسجلّك المثاليّ

110
00:09:01,870 --> 00:09:03,960
.لا يعني سجلّي أيّ شيء

111
00:09:03,960 --> 00:09:06,980
أنا أقاتل ببساطة لأحرص أن تُحقّق
.العدالة في هذه الجرائم

112
00:09:07,290 --> 00:09:10,650
.لا يترك أبي أيّ مجرم يفلت بلا عقاب

113
00:09:10,650 --> 00:09:13,360
.إنّه يسحقهم دائمًا

114
00:09:13,720 --> 00:09:18,820
أريد أن أصبح مدّعية عامّة مثل أبي
.بسرعة وأقاتل إلى جانبه

115
00:09:20,020 --> 00:09:21,240
!أبي

116
00:09:22,550 --> 00:09:24,730
.كنتَ مثاليًّا ثانية اليوم

117
00:09:24,730 --> 00:09:25,770
.بالطّبع

118
00:09:26,450 --> 00:09:27,790
.كان تحقيقًا باهرًا

119
00:09:28,160 --> 00:09:32,500
،ليس والدك كان خصمي
.لكنتُ قد استمتعت حينها قليلاً

120
00:09:35,330 --> 00:09:37,370
.اذهبا وانتظراني في السّيّارة

121
00:09:37,800 --> 00:09:38,930
.حسنًا

122
00:09:49,900 --> 00:09:53,750
!تبرّعوا رجاءً لمساعدة الكلاب المتخلّى عنها

123
00:09:55,770 --> 00:09:57,400
.لنذهب يا ريجي

124
00:09:57,400 --> 00:09:58,500
.حسنًا

125
00:10:01,570 --> 00:10:04,410
.إنّ الفرع الرّئيسيّ لهذا المتجر موجود في أمريكا

126
00:10:04,410 --> 00:10:06,010
.هذا هو الفرع الوحيد في اليابان

127
00:10:07,310 --> 00:10:09,420
أيّ هاتين الدّميتين تفضّل في رأيك؟

128
00:10:09,420 --> 00:10:11,040
.لا-لا أدري

129
00:10:11,040 --> 00:10:12,540
!صحيح

130
00:10:12,890 --> 00:10:14,500
.سآخذ الدّمية الحمراء

131
00:10:14,870 --> 00:10:17,090
.إنّها ترتدي الأحمر مثلك يا ريجي

132
00:10:18,090 --> 00:10:20,550
!أبي! نحن هنا

133
00:10:23,100 --> 00:10:24,850
!عد إلى هنا

134
00:10:25,220 --> 00:10:26,560
!سأعيده أنا

135
00:10:27,110 --> 00:10:29,190
!مهلاً يا ريجي

136
00:10:33,350 --> 00:10:34,680
أين أنت؟

137
00:10:40,250 --> 00:10:41,700
.أ-أنا آسف

138
00:10:45,250 --> 00:10:46,790
.يا لك من فتى فظّ

139
00:10:54,760 --> 00:10:57,020
.إليكم بعض الأخبار المقلقة

140
00:10:57,020 --> 00:11:00,400
.ضاع كلب صغير في مركز تاكابيشيا للتّسّوق

141
00:11:00,760 --> 00:11:02,840
تاكابيشيا؟ إنّه هذا المكان؟

142
00:11:03,170 --> 00:11:07,400
اسمها نابالم-تشان، وهي كلبة بومرانيان
.بيضاء ترتدي شريط رأس ظريفًا

143
00:11:07,400 --> 00:11:10,190
يمكن تمييزها عن طريق البقعة
.الّتي على شكل قلب على بطنها

144
00:11:10,190 --> 00:11:12,690
...إن وجدتموها، فصاحبتها سوف

145
00:11:13,050 --> 00:11:16,270
!تـ-تعطيكم مكافأة تبلغ 500 ألف ينّ

146
00:11:17,640 --> 00:11:20,570
.أعتقد أنّ كلبي ليس المشاكس الوحيد هنا

147
00:11:20,570 --> 00:11:22,990
.لننتقل للأغنية التّالية

148
00:11:26,330 --> 00:11:27,790
ساموراي الإشارات؟

149
00:11:33,570 --> 00:11:36,630
.أريد أن أصبح محامي دفاع كوالدي

150
00:11:39,570 --> 00:11:42,760
!أنا واثق أنّك ستصبح محاميًا رائعًا يا ميتسوروغي-كن

151
00:11:47,350 --> 00:11:51,850
أريد أن أصبح مدّعية عامّة مثل أبي
.بسرعة وأقاتل إلى جانبه

152
00:11:53,560 --> 00:11:58,320
،ليت والدك كان خصمي
.لكنتُ قد استمتعت حينها قليلاً

153
00:12:00,930 --> 00:12:04,470
أبي، ماذا عليّ أن أفعل؟

154
00:12:05,120 --> 00:12:07,260
أليست هذه هي الأغنية الأروع؟

155
00:12:07,260 --> 00:12:10,410
.إنّها طلب خاصّ من محارب الإشارات الزّرقاء

156
00:12:10,950 --> 00:12:13,720
.حتّى أنّه بعث رسالة لصديقه

157
00:12:13,720 --> 00:12:18,040
،إنّها تقول... "يا محارب الإشارات الحمراء
هل أنت على ما يرام؟

158
00:12:18,040 --> 00:12:20,140
.أتمنّى أن يكون كلبك بخير أيضًا

159
00:12:20,140 --> 00:12:23,880
.أفتقد لعبنا نحن الثّلاثة بساموراي الإشارات معًا

160
00:12:24,270 --> 00:12:26,740
،لقد انتقلت بشكل مفاجئ

161
00:12:26,740 --> 00:12:30,310
لكن لا يهمّ أين تكون، فسأشجّعك
.دائمًا لتحقّق حلمك

162
00:12:30,870 --> 00:12:32,400
.لنلتقِ ثانية يومًا ما

163
00:12:32,400 --> 00:12:33,810
".سأكون في انتظار سماع أخبارك

164
00:12:35,110 --> 00:12:36,400
ناروهودو؟

165
00:12:36,400 --> 00:12:39,180
.أتمنّى أن يلتقي المحاربان الأحمر والأزرق

166
00:12:39,180 --> 00:12:40,860
!إنّ تومورينا تشجّعكما

167
00:12:41,570 --> 00:12:43,990
أنت لا تتغيّر، صحيح؟

168
00:12:52,330 --> 00:12:54,900
ماذا؟ هل كنت تطاردها؟

169
00:12:56,770 --> 00:12:59,540
...كلبة بومرانيان بيضاء ترتدي شريطًا

170
00:13:00,180 --> 00:13:02,510
هل أنت نابالم؟

171
00:13:03,540 --> 00:13:05,000
ماذا؟

172
00:13:05,000 --> 00:13:07,590
كنتِ هنا؟

173
00:13:08,290 --> 00:13:12,970
.بحثت عنك في كلّ مكان يا نابالم-تشان

174
00:13:20,950 --> 00:13:22,150
ما الخطب؟

175
00:13:22,150 --> 00:13:25,210
ألم ترغبي في تناول الكعك المقليّ؟

176
00:13:25,830 --> 00:13:26,660
...ولكن

177
00:13:30,260 --> 00:13:32,240
ما الّذي سأفعله حياله؟

178
00:13:32,870 --> 00:13:36,290
.أنا أشكرك على إيجادك لها

179
00:13:36,290 --> 00:13:39,960
.أنا مالكتها جوروسو

180
00:13:39,960 --> 00:13:43,090
.مالكتها؟ حمدًا لله على ذلك

181
00:13:43,090 --> 00:13:46,300
.لقد كنتُ قلقة للغاية

182
00:13:48,640 --> 00:13:53,450
.يا إلهي. لا بدّ أنّها غاضبة لأنّني تركتها وحدها

183
00:13:53,450 --> 00:13:54,810
.ذلك ما يبدو

184
00:13:55,250 --> 00:14:00,650
.ليس لديّ أبناء. إنّها عائلتي الوحيدة

185
00:14:01,150 --> 00:14:04,030
!تعالي لوالدتك

186
00:14:04,030 --> 00:14:05,940
!تعالي إلى هنا

187
00:14:06,360 --> 00:14:10,970
.يا إلهي، إنّها صعبة المراس أحيانًا

188
00:14:12,450 --> 00:14:14,820
.تعالي الآن

189
00:14:16,260 --> 00:14:18,420
.لا أظنّ أنّ عليك إجبارها

190
00:14:18,420 --> 00:14:22,760
فعلاً؟ ستأمرني أنا مالكتها بما عليّ فعله؟

191
00:14:22,760 --> 00:14:27,090
،أعلم أنّ هذا قد يبدو فظًّا
لكن هل أنت مالكتها من الأساس؟

192
00:14:27,090 --> 00:14:29,320
.بالطّبع

193
00:14:29,320 --> 00:14:32,680
أنا آسف، لكنّني غير واثق أنّ عليّ
.تسليمها لك ببساطة هكذا

194
00:14:33,050 --> 00:14:37,890
ماذا؟ تريد أخذها لنفسك، صحيح؟

195
00:14:38,600 --> 00:14:40,040
ماذا؟

196
00:14:43,400 --> 00:14:44,570
...ري

197
00:14:46,900 --> 00:14:50,820
.لسوء حظّك، إنّها لي

198
00:14:50,820 --> 00:14:53,870
.خذ كلبك البنّيّ وغادر

199
00:14:53,870 --> 00:14:55,450
هل لديك دليل؟

200
00:14:56,650 --> 00:15:00,620
.دليل؟ بالطّبع

201
00:15:00,620 --> 00:15:05,380
.أعرف كلّ شيء عنها

202
00:15:05,860 --> 00:15:10,890
.لديها شكل قلب جميل على بطنها

203
00:15:13,890 --> 00:15:18,350
!إنّه سرّ نابالم-تشان وسرّي أيضًا

204
00:15:20,120 --> 00:15:24,370
والآن، هل اقتنعت أنّني مالكتها؟

205
00:15:28,120 --> 00:15:29,210
.لا بأس

206
00:15:31,430 --> 00:15:35,540
.تعالي يا نابالم-تشان. لنعد للمنزل

207
00:15:42,520 --> 00:15:45,250
!ستصبح المكافأة لي الآن

208
00:15:45,250 --> 00:15:48,920
!أو-أو-أو... أويدو

209
00:15:48,920 --> 00:15:50,380
!مهلاً

210
00:15:52,280 --> 00:15:55,930
جوروسو-سان، هل تحبّين تلك الأغنية؟

211
00:15:55,930 --> 00:15:57,950
ما-ما-ماذا تقصد؟

212
00:15:57,950 --> 00:16:00,210
أتعرفين ما تلك الأغنية؟

213
00:16:00,210 --> 00:16:03,640
!ما أدراني! لقد خطرت على بالي فجأة

214
00:16:05,270 --> 00:16:08,000
...إليك شيئًا سمعتُه مؤخّرًا

215
00:16:08,000 --> 00:16:12,040
.لا يختار النّاس الأشياء بلا سبب

216
00:16:12,040 --> 00:16:13,860
ما-ما الّذي تتحدّث عنه؟

217
00:16:14,200 --> 00:16:16,750
،حتّى إن اعتقدوا أنّهم اختاروا بشكل عشوائيّ

218
00:16:16,750 --> 00:16:18,700
.هنالك دائمًا سبب ما خلف ذلك الخيار

219
00:16:18,700 --> 00:16:21,330
.إنّها ترتدي الأحمر مثلك يا ريجي

220
00:16:21,820 --> 00:16:23,330
.نفس الشّيء ينطبق على تلك الأغنية

221
00:16:23,930 --> 00:16:26,170
قد تعتقدين أنّها قد خطرت
،على بالك ببساطة

222
00:16:26,170 --> 00:16:29,130
لكن قد يكون هنالك سبب خفيّ
.أنت غير مدركة له

223
00:16:29,770 --> 00:16:32,550
.مثلاً، ربّما تكونين قد سمعتِها مؤخّرًا

224
00:16:32,970 --> 00:16:35,300
.لننتقل للأغنية التّالية

225
00:16:37,510 --> 00:16:40,520
.سمعتُ تلك الأغنية مؤخّرًا أيضًا

226
00:16:40,520 --> 00:16:41,980
.على المذياع

227
00:16:42,580 --> 00:16:46,200
بالمناسبة، تمّ ذكر خبر مثير
.للاهتمام في ذلك العرض

228
00:16:46,760 --> 00:16:50,070
،يبدو أنّ من يجد تلك الكلبة
.سيحصل على مكافأة سخيّة

229
00:16:50,440 --> 00:16:52,650
.حتّى أنّه تمّ ذكر البقعة الّتي على شكل قلب

230
00:16:52,650 --> 00:16:56,450
!لا أعلم بأمر أيّ عرض إذاعيّ
.لم أسمع له

231
00:16:56,450 --> 00:16:57,820
أين سمعتِ تلك الأغنية إذًا؟

232
00:16:58,260 --> 00:17:01,800
.تذكّرت الآن. سمعتها على التّلفاز

233
00:17:00,650 --> 00:17:02,870
.إنّها أغنية برنامج للأطفال

234
00:17:03,430 --> 00:17:05,830
ألم تقولي إنّ لا أطفال لديك؟

235
00:17:05,830 --> 00:17:09,290
.إ-إنّها أغنية شائعة هذه الأيّام
—لا بدّ أنّني سمعتها في

236
00:17:09,340 --> 00:17:10,200
!أعترض

237
00:17:12,300 --> 00:17:16,260
.ذلك مستحيل للأسف

238
00:17:16,260 --> 00:17:18,530
كـ-كيف ذلك؟

239
00:17:18,530 --> 00:17:20,220
،برنامج ساموراي الإشارات ذاك

240
00:17:20,220 --> 00:17:22,560
!انتهى عرضه قبل ثلاث سنوات

241
00:17:26,870 --> 00:17:30,020
جوروسو-سان، سمعتِها
على المذياع بالفعل، صحيح؟

242
00:17:30,870 --> 00:17:33,290
من تظنّ نفسك أيّها الشّقيّ؟

243
00:17:33,290 --> 00:17:35,360
!أنا المالكة وانتهى الموضوع

244
00:17:35,840 --> 00:17:39,200
.إن كنتِ المالكة، فهنالك شيء قد نسيتِه

245
00:17:39,200 --> 00:17:41,850
ماذا؟ وما هو؟

246
00:17:41,850 --> 00:17:43,200
.المكافأة

247
00:17:44,280 --> 00:17:46,100
.أنا وجدتها

248
00:17:46,100 --> 00:17:49,320
كانت المكافأة هي 500 ألف ينّ، صحيح؟

249
00:17:51,570 --> 00:17:52,920
،إن أردتِ أخذها معك

250
00:17:54,890 --> 00:17:56,510
.فسلّميني المكافأة أوّلاً

251
00:18:04,410 --> 00:18:07,480
.لا تملِ أوامرك على الكبار يا شقيّ

252
00:18:07,800 --> 00:18:10,940
!أعطني تلك الكلبة في الحال

253
00:18:10,940 --> 00:18:12,900
.يكفي

254
00:18:13,860 --> 00:18:17,200
.سبق وخسرتِ. ارحلي

255
00:18:17,200 --> 00:18:20,430
...و-ومن تكون أنت؟ أنا

256
00:18:20,430 --> 00:18:22,950
أم أنّك تودّين الاستئناف؟

257
00:18:23,330 --> 00:18:24,980
.أعني في المحكمة

258
00:18:32,340 --> 00:18:35,480
!أ-أنا آسفة

259
00:18:36,570 --> 00:18:37,510
...ريجي

260
00:18:38,680 --> 00:18:41,000
.بحثنا عنك في كلّ مكان

261
00:18:41,000 --> 00:18:42,820
.أعتذر لتسبّبي بأيّ متاعب

262
00:18:46,090 --> 00:18:46,810
.لنذهب

263
00:18:47,140 --> 00:18:50,140
.لا بدّ أنّ الكعك المقليّ قد جهز الآن

264
00:18:50,140 --> 00:18:53,110
!أجل! هيّا لنذهب

265
00:19:00,040 --> 00:19:02,120
.لقد استمتعت كثيرًا اليوم

266
00:19:02,120 --> 00:19:03,280
!أرجوكم

267
00:19:03,280 --> 00:19:04,700
!ساعدونا أرجوكم

268
00:19:04,700 --> 00:19:06,200
!نحن نقدّر أيّ تبرّع

269
00:19:07,060 --> 00:19:08,410
...المعذرة

270
00:19:08,410 --> 00:19:13,280
هل يمكنني التّبرّع بالمكافأة لهم
إن حصلتُ عليها؟

271
00:19:13,280 --> 00:19:14,130
تتبرّع بها؟

272
00:19:14,130 --> 00:19:16,230
!تبرّعوا لإنقاذ كلب

273
00:19:16,230 --> 00:19:20,340
.أرجوكم

274
00:19:16,490 --> 00:19:17,650
.رجاءً

275
00:19:20,760 --> 00:19:22,180
.أنت من وجد الكلبة

276
00:19:22,590 --> 00:19:24,090
.افعل ما يحلو لك

277
00:19:25,130 --> 00:19:26,450
!شكرًا لك

278
00:19:31,890 --> 00:19:33,400
...بشأن مسألة الميتم

279
00:19:34,340 --> 00:19:35,860
.انسوا أمرها

280
00:19:38,370 --> 00:19:44,950
لم أعرف أنا أيضًا لماذا قرّرت تبنّي
.ذلك الفتى قبل ثلاث سنوات

281
00:19:45,490 --> 00:19:49,810
لكن أعتقد أنّني حصلت على لمحة
.عن السّبب اليوم

282
00:19:51,670 --> 00:19:53,880
.لم يكن بدافع الذّنب

283
00:19:53,880 --> 00:19:59,170
أردت ببساطة أن أرى أيّ طريق
.سيسلكه الألم الّذي عانيتُه

284
00:19:59,560 --> 00:20:02,210
.تلك عاقبة أفعالي

285
00:20:03,590 --> 00:20:05,690
.ارتدِ هذه من الآن فصاعدًا

286
00:20:10,230 --> 00:20:11,480
!حاضر

287
00:20:23,210 --> 00:20:26,600
.لقد ساعدتني ثانية يا ناروهودو

288
00:20:33,620 --> 00:20:36,680
.لماذا تقف هناك؟ هيّا بنا

289
00:20:36,680 --> 00:20:38,150
...حـ-حسنًا

290
00:22:10,730 --> 00:22:11,470
وماذا بعد؟

291
00:22:11,840 --> 00:22:14,980
هل سمعها المدّعي العامّ ميتسوروغي؟

292
00:22:14,980 --> 00:22:16,110
من يدري؟

293
00:22:16,110 --> 00:22:18,280
!أنا واثقة أنّه سمعها

294
00:22:18,280 --> 00:22:21,190
!أتمنّى أن يصل إعلاننا للجميع أيضًا

295
00:22:21,570 --> 00:22:25,510
،على أيّ حال، لقد صوٍّرناه وما إلى ذلك
لكن ما الّذي سنفعل به؟

296
00:22:25,510 --> 00:22:30,280
سوف ننشره على ذلك الشّيء الجديد
."الّذي يُدعى "الإنترنت

297
00:22:30,280 --> 00:22:32,790
.هيّا، هيّا يا ناروهودو-كُن. قم بذلك

298
00:22:32,790 --> 00:22:36,950
.لا، لا، لا أعرف كيف
.لست جيّدًا مع التّكنولوجيا

299
00:22:41,030 --> 00:22:42,040
أهذا هو؟

300
00:22:42,040 --> 00:22:42,750
!مهلاً

301
00:22:42,750 --> 00:22:44,390
!لنبدأ

302
00:22:47,150 --> 00:22:48,240
ما هذا؟

303
00:22:48,820 --> 00:22:52,220
لحظة، المحامون اليابانيّون مجانين، صحيح؟

304
00:23:20,730 --> 00:23:21,870
!أعترض

305
00:23:21,870 --> 00:23:24,770
!تعود ملكة سوء الحظّ ماكو-تشان من جديد

306
00:23:24,770 --> 00:23:28,460
.وهي متّهمة بالقتل ثانية

307
00:23:28,460 --> 00:23:30,430
.وقعت الجريمة في مطعم فرنسيّ

308
00:23:31,150 --> 00:23:34,050
.لا أحد يصدّق ما لدى ماكو-تشان لتقوله

309
00:23:34,440 --> 00:23:36,610
،لكن حتّى إن لم يصدّقها أحد
!فأنا أقف إلى جانبها

310
00:23:36,610 --> 00:23:38,430
!ثقي بي يا ماكو-تشان

311
00:23:38,980 --> 00:23:39,930
!سأعثر على المتناقضات

312
00:23:39,930 --> 00:23:41,310
!وأكتشف الحقيقة

313
00:23:41,310 --> 00:23:45,280
،الحلقة القادمة: "وصفة تغيّر الأحداث
!"المحاكمة الأولى

314
00:23:45,280 --> 00:23:45,960
!خذ هذه