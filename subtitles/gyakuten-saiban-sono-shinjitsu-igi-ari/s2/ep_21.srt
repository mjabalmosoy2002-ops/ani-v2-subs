00:10:56,180 --> 00:10:58,050
!كذبة واضحة وضوح الشّمس

181
00:11:02,800 --> 00:11:06,390
.تحاول أيامي-سان تلفيق التّهمة لمايوي-تشان

182
00:11:07,030 --> 00:11:08,840
!لكن لماذا؟

183
00:11:13,400 --> 00:11:14,500
!أيّتها الشّاهدة

184
00:11:14,500 --> 00:11:19,170
يعتبر الكذب تحت القسم
!تهمة بازدراء المحكمة

185
00:11:19,670 --> 00:11:22,740
توقّف تساقط الثّلج بعد خمس
دقائق من صاعقة البرق؟

186
00:11:24,270 --> 00:11:25,700
.كم هذا مضحك

187
00:11:26,330 --> 00:11:29,670
.الطّقس في الجبال متقلّب كقلب امرأة

188
00:11:29,670 --> 00:11:32,860
.إنّه يتغيّر بشكل غير متوقّع طوال الوقت

189
00:11:32,860 --> 00:11:34,370
!صحيح

190
00:11:34,370 --> 00:11:35,820
!إنّه كقلب عذراء

191
00:11:35,820 --> 00:11:37,860
هل أنتما جادّان؟

192
00:11:37,860 --> 00:11:38,770
.اسمع

193
00:11:39,400 --> 00:11:43,620
في تلك اللّيلة، نُقلت جثّة الضّحيّة
.إلى معبد هازاكورا

194
00:11:43,620 --> 00:11:45,980
.وهذه حقيقة قائمة

195
00:11:45,980 --> 00:11:49,680
هل يمكنك توفير تفسير أفضل لذلك؟

196
00:11:49,680 --> 00:11:51,130
!صحيح

197
00:11:51,130 --> 00:11:55,350
هل تحاول القول إنّ الجثّة قفزت
فوق الجسر المحترق؟

198
00:11:55,800 --> 00:11:56,910
.صحيح

199
00:11:56,910 --> 00:12:01,570
.لقد عبرت الجثّة الجسر المحترق بطريقة ما

200
00:12:01,990 --> 00:12:03,160
...ناروهودو-كُن

201
00:12:03,660 --> 00:12:07,740
.لقد احترق بالكامل

202
00:12:07,740 --> 00:12:09,700
.وأحد حبال تعليق الجسر قد اختفى

203
00:12:10,450 --> 00:12:11,330
فعلاً؟

204
00:12:13,100 --> 00:12:14,710
!أهذا ما حدث؟

205
00:12:15,380 --> 00:12:18,760
.يبدو أنّ لا تفسير آخر لديك

206
00:12:18,760 --> 00:12:23,260
هذا يعني أنّه لا يحقّ لك
.وصف الشّاهدة بالكاذبة

207
00:12:23,710 --> 00:12:25,110
!أعترض

208
00:12:28,570 --> 00:12:31,350
جثّة قفزت فوق جسر محترق"؟"

209
00:12:31,780 --> 00:12:34,270
.صدّقوا أم لا، ذلك ليس مستحيلاً بالكامل

210
00:12:35,460 --> 00:12:38,450
ليس مستحيلاً بالكامل؟

211
00:12:38,450 --> 00:12:41,620
لكن يبدو أنّه من المستحيل أن تستطيع
.دعم ذلك الادّعاء

212
00:12:41,620 --> 00:12:42,940
.لا أدري بشأن ذلك

213
00:12:43,880 --> 00:12:47,120
.فبل كلّ شيء، كان هنالك شاهد

214
00:12:47,560 --> 00:12:48,370
ماذا؟

215
00:12:48,820 --> 00:12:51,910
.عليّ فتح طريقي بالقوّة

216
00:12:52,850 --> 00:12:54,610
!إنّه تينريوساي ماثيس

217
00:12:54,610 --> 00:12:57,920
!مؤلّف كتب مصوّرة واعد عبقريّ

218
00:12:58,310 --> 00:12:59,170
...عبقريّ

219
00:12:59,170 --> 00:13:00,630
...مؤلّف كتب مصوّرة

220
00:13:00,990 --> 00:13:02,590
واعد؟

221
00:13:02,760 --> 00:13:04,680
من يكون؟

222
00:13:03,320 --> 00:13:04,680
.لم أسمع به من قبل

223
00:13:05,700 --> 00:13:09,180
.كان في كوخ قريب في ليلة وقوع الجريمة

224
00:13:09,810 --> 00:13:13,440
.وحينها شهد على اللّحظة الّتي نحن بصددها

225
00:13:13,440 --> 00:13:15,510
اللّحظة الّتي نحن بصددها؟

226
00:13:16,660 --> 00:13:22,440
.هذه الرّسمة توضّح تمامًا ما حدث

227
00:13:23,080 --> 00:13:26,400
هل ستقوم بهذا بالفعل؟

228
00:13:26,760 --> 00:13:30,960
هل ستستعمل تلك الرّسومات لتدّعي
أنّ الضّحيّة قد طارت في الهواء؟

229
00:13:30,960 --> 00:13:31,620
!نعم

230
00:13:32,690 --> 00:13:36,630
،بما أنّك فتحت الموضوع الآن
.فلا تحاول إغلاقه ثانية

231
00:13:36,630 --> 00:13:37,980
!بالطّبع لا

232
00:13:37,980 --> 00:13:40,750
!تختبئ الحقيقة في هذه الرّسمة

233
00:13:42,290 --> 00:13:43,700
.دعني أسألك إذًا

234
00:13:44,080 --> 00:13:46,170
ما الّذي تحاول إثباته بتلك الرّسمة؟

235
00:13:46,870 --> 00:13:50,010
هذه الرّسمة الّتي رسمها تينريوساي ماثيس

236
00:13:50,010 --> 00:13:51,850
!تعتبر تناقضًا واضحًا

237
00:13:53,390 --> 00:13:55,060
!نعلم ذلك سلفًا

238
00:13:55,400 --> 00:13:58,360
.لا، لا. ذلك ليس ما قصدتُه

239
00:13:58,360 --> 00:13:59,810
.ألقوا نظرة على هذه الصّورة

240
00:14:00,690 --> 00:14:03,860
.توجد حبال التّعليق تحت الجسر

241
00:14:04,220 --> 00:14:06,380
،لكن في هذه الرّسمة

242
00:14:06,380 --> 00:14:09,240
.تبدو الحبال فوق حبال السّلامة

243
00:14:11,750 --> 00:14:13,700
ربّما يكون الرّسّام قد رأى الأمر بشكل خاطئ؟

244
00:14:14,230 --> 00:14:16,330
.أو ربّما رسم الجسر بشكل خاطئ

245
00:14:16,330 --> 00:14:18,960
.أم أنّ هنالك خطأ ما في رأسك

246
00:14:18,960 --> 00:14:20,990
.لقد رسم ما رآه

247
00:14:20,990 --> 00:14:24,460
.لا بدّ من وجود سبب خلف هذا الاختلاف

248
00:14:25,240 --> 00:14:26,640
،حسب سجلاّت المحكمة

249
00:14:26,640 --> 00:14:30,930
كان تينريوساي ماثيس يرسم
.في أحلامه" حينها"

250
00:14:31,320 --> 00:14:32,760
في أحلامه"؟"

251
00:14:34,110 --> 00:14:35,140
،وحينها

252
00:14:35,760 --> 00:14:38,790
.ضربت صاعقة من السّماء وأشعلت الجسر

253
00:14:38,790 --> 00:14:42,790
...لقد شهد على تلك اللّحظة

254
00:14:43,260 --> 00:14:44,520
!وهو مستلقٍ على ظهره

255
00:14:45,150 --> 00:14:45,900
!مستحيل

256
00:14:47,080 --> 00:14:51,700
!ما رآه كان مقلوبًا رأسًا على عقب

257
00:14:53,030 --> 00:14:56,580
.هكذا يجب أن تكون الرّسمة إذًا

258
00:14:57,190 --> 00:15:01,340
.لم تطر جثّة الضّحيّة فوق الجسر

259
00:15:01,800 --> 00:15:03,500
!بل تأرجحت تحته في الحقيقة

260
00:15:03,950 --> 00:15:05,090
!هذا صحيح

261
00:15:05,600 --> 00:15:07,240
!مثل رقّاص ساعة

262
00:15:08,880 --> 00:15:10,050
!أعترض

263
00:15:11,000 --> 00:15:13,220
!طول الجسر 20 مترًا

264
00:15:13,760 --> 00:15:18,000
أين يمكن العثور على حبل لأرجحة جثّة عبره؟

265
00:15:18,000 --> 00:15:19,180
.إنّه هنا تمامًا

266
00:15:19,180 --> 00:15:19,890
ماذا؟

267
00:15:20,250 --> 00:15:21,650
ألا تراه؟

268
00:15:22,070 --> 00:15:24,110
!حـ-حبل التّعليق المقطوع؟

269
00:15:24,990 --> 00:15:26,730
،عندما ضربت الصّاعقة الجسر

270
00:15:27,380 --> 00:15:31,530
.كان أحد حبال التّعليق منفلتًا من مكانه

271
00:15:32,040 --> 00:15:34,780
ربط الجاني الجثّة به في تلك اللّحظة

272
00:15:35,190 --> 00:15:36,830
.وأرجحها إلى الجانب الآخر

273
00:15:37,770 --> 00:15:42,080
كان عليه نقل الجثّة
.إلى معبد هازاكورا بأيّ ثمن

274
00:15:42,430 --> 00:15:45,840
.لكن لم يستطع عبور الجسر المحترق

275
00:15:45,840 --> 00:15:49,390
!كانت هذه الطّريقة الوحيدة لنقل الجثّة

276
00:15:56,870 --> 00:15:59,520
!نظام! نظام في المحكمة

277
00:15:59,520 --> 00:16:00,600
!ناروهودو-ساما

278
00:16:01,090 --> 00:16:05,450
هل لديك أيّ دليل يثبت فعل
الجاني لما تقوله؟

279
00:16:05,450 --> 00:16:07,110
.بالطّبع

280
00:16:07,900 --> 00:16:12,610
كان لجثة الضّحية كدمات تتّسق
.مع سقوطها من مبنى من طابقين

281
00:16:13,180 --> 00:16:15,990
،بعد تأرجحها من الجسر
.ارتطمت الجثّة بالأرض

282
00:16:16,780 --> 00:16:21,290
.وذلك السّقوط قد أوقع الكرة الكريستاليّة

283
00:16:21,670 --> 00:16:26,420
.يبدو أنّ الدّفاع قد أثبت كيف نُقلت الجثّة

284
00:16:26,670 --> 00:16:27,460
!أعترض

285
00:16:32,830 --> 00:16:36,340
.استعمل هذه القهوة الباردة لتهدئة نفسك

286
00:16:36,340 --> 00:16:38,430
أ-أيّها المدّعي العامّ غودو؟

287
00:16:38,980 --> 00:16:42,890
.كان ذلك تفانيًا غنيًّا ومرًّا يا ماروهودو

288
00:16:43,320 --> 00:16:45,400
.لكنّك نسيت أمرًا واحدًا

289
00:16:46,370 --> 00:16:47,350
وما هو؟

290
00:16:47,780 --> 00:16:50,680
إن كان الجاني قد أرسل الجثّة
،للجانب الآخر كما تقول

291
00:16:51,290 --> 00:16:55,110
فمن الطّبيعيّ أنّه قد كان هنالك
.شخص في الجهة الأخرى ليمسكها

292
00:16:55,500 --> 00:16:56,870
.شريك في الجريمة

293
00:16:57,750 --> 00:17:02,110
هل يمكنك إخبارنا من أمسك
بالجثّة في الجانب الآخر؟

294
00:17:02,580 --> 00:17:04,460
...واضح أنّ ذلك

295
00:17:05,580 --> 00:17:07,390
.كان أيامي-سان دون غيرها

296
00:17:07,390 --> 00:17:08,500
أ-أنا؟

297
00:17:09,060 --> 00:17:13,470
الطّريقة الوحيدة لنقل الجثّة من الجسر
.هي عن طريق مركبة الثّلج

298
00:17:14,020 --> 00:17:14,920
!أعترض

299
00:17:15,400 --> 00:17:17,390
هل كنت تستمع للشّهادة من الأساس؟

300
00:17:17,390 --> 00:17:21,870
كانت هذه الظّريفة الصّغيرة تتستّر
.على فعلة أياساتو مايوي في المعبد الدّاخليّ

301
00:17:21,870 --> 00:17:26,100
بعبارات أخرى، كانت هي من أرسلت
.الجثّة حسب قولك

302
00:17:26,670 --> 00:17:28,910
لم أنس ذلك، لكن هل نسيت أنت؟

303
00:17:28,910 --> 00:17:32,380
شوهدت أيامي-سان في معبد هازاكورا

304
00:17:32,950 --> 00:17:37,310
تأخذ جثّة الضّحيّة إلى السّاحة
!وتمويهها هناك

305
00:17:40,200 --> 00:17:41,850
.هذا مشوِّش بالكامل

306
00:17:41,850 --> 00:17:46,500
الأمر أشبه بوجود المدّعى عليها
.في مكانين مختلفين في نفس الوقت

307
00:17:48,540 --> 00:17:49,890
!لا اعتراض

308
00:17:51,190 --> 00:17:53,390
لا-لا اعتراض؟

309
00:17:53,390 --> 00:17:53,840
.نعم

310
00:17:54,320 --> 00:17:57,970
كان هنالك اثنان من أيامي-سان
.في ليلة ارتكاب الجريمة

311
00:17:57,970 --> 00:18:00,050
اثنان من المدّعى عليها؟

312
00:18:00,480 --> 00:18:03,640
.لأكون أكثر دقّة، كان هنالك توأمان متطابقان

313
00:18:03,640 --> 00:18:04,960
!سيّدي القاضي

314
00:18:04,960 --> 00:18:08,730
.أنا واثق أنّك تتذكّرها أيضًا

315
00:18:15,340 --> 00:18:17,030
...مـ-مهلاً، أنت هي

316
00:18:17,340 --> 00:18:18,240
.صحيح

317
00:18:18,240 --> 00:18:22,580
.مياناغي تشينامي، أخت أيامي-سان التّوأم

318
00:18:23,070 --> 00:18:23,790
!أعترض

319
00:18:24,540 --> 00:18:28,920
.هل نسيت؟ مياناغي تشينامي ميتة سلفًا

320
00:18:28,920 --> 00:18:32,820
.نعم. سمعتُ أنّها قد أُعدمت الشّهر الماضي

321
00:18:32,820 --> 00:18:34,070
ما-ماذا؟

322
00:18:34,070 --> 00:18:35,600
!هذا صحيح

323
00:18:35,600 --> 00:18:38,080
!ما عاد هنالك وجود لأختي في هذا العالم

324
00:18:38,080 --> 00:18:39,090
.أنت مخطئة

325
00:18:40,510 --> 00:18:43,750
.أنت من بين الجميع عليك أن تكوني مدركة لهذا

326
00:18:44,270 --> 00:18:49,230
فقبل كلّ شيء، فإنّ دماء مدرسة كوراين
.لوساطة الأرواح يسري في ذلك الجسد

327
00:18:50,480 --> 00:18:52,420
و-وساطة الأرواح؟

328
00:18:52,420 --> 00:18:53,620
،بالمناسبة

329
00:18:53,620 --> 00:18:55,940
لماذا لم تذكري الأمر؟

330
00:18:56,250 --> 00:18:58,720
أقصد أنّ الجثّة قد نُقلت كرقّاص ساعة؟

331
00:18:58,720 --> 00:19:03,110
.ذ-ذلك لأنّه لم تكن لي أدنى فكرة

332
00:19:03,110 --> 00:19:05,750
.لم أكن أعلم أيّ شيء عن ذلك

333
00:19:05,750 --> 00:19:07,700
.كان من المستحيل أن تعرفي ذلك

334
00:19:07,950 --> 00:19:10,790
.فأنت من تلقّى الجثّة

335
00:19:12,460 --> 00:19:16,340
.كنت أشعر بوجود خطب ما في محاكمة اليوم

336
00:19:16,700 --> 00:19:18,510
،بدأت تعترفين فجأة

337
00:19:18,920 --> 00:19:22,340
...محاولة تلفيق التّهمة لمايوي-تشان بشهادتك

338
00:19:23,310 --> 00:19:25,690
.أنت لست هازاكوراين أيامي

339
00:19:26,290 --> 00:19:30,500
لم أتوقّع أبدًا أن يأتي اليوم
،الّذي أقابلك فيه ثانية

340
00:19:31,580 --> 00:19:32,980
.مياناغي تشينامي-سان

341
00:19:34,500 --> 00:19:38,700
لـ-لكن ألم تمت سلفًا؟

342
00:19:38,700 --> 00:19:42,360
هذا صحيح. إنّها ليست مياناغي
.تشينامي بشحمها ولحمها

343
00:19:43,260 --> 00:19:44,910
...إنّ هذه الشّاهدة

344
00:19:45,860 --> 00:19:48,910
عبارة عن روح تسكن جسد وسيطة
!أرواح في الوقت الحاليّ

345
00:19:48,910 --> 00:19:51,690
!ر-روح؟

346
00:19:53,160 --> 00:19:56,380
.كلّ شيء مكتوب في هذه الإرشادات

347
00:19:56,790 --> 00:20:00,840
كان يُفترض أن تُستدعى مياناغي
!تشينامي في ليلة الجريمة

348
00:20:01,180 --> 00:20:02,500
...هذا

349
00:20:02,500 --> 00:20:06,260
!كُتب هذا من طرف أمّك أياساتو كيميكو

350
00:20:07,080 --> 00:20:08,720
كـ-كيف يُعقل هذا؟

351
00:20:09,330 --> 00:20:14,700
هنالك دليل على ظهور هازاكوراين
.أيامي ثانية تلك اللّيلة

352
00:20:14,700 --> 00:20:19,800
حينها، أعطتني غطاء الرّأس هذا
.في معبد هازاكورا

353
00:20:19,800 --> 00:20:20,440
...لكن

354
00:20:20,810 --> 00:20:24,970
هازاكوراين أيامي الّتي ظهرت
في المعبد الدّاخليّ بعد ذلك

355
00:20:24,970 --> 00:20:28,230
كانت ترتدي غطاء رأس كانت
.قد منحته لي سلفًا

356
00:20:28,230 --> 00:20:30,160
وهذا تناقص، أليس كذلك؟

357
00:20:30,160 --> 00:20:31,250
!أعترض

358
00:20:31,990 --> 00:20:36,230
لكنّ هازاكوراين أيامي كانت محجوزة
!من طرف الشّرطة طوال الوقت

359
00:20:36,230 --> 00:20:39,510
متى استبدلت الأماكن مع مياناغي تشينامي؟

360
00:20:39,970 --> 00:20:42,420
.كانت هنالك فرصة دامت لوهلة وجيزة

361
00:20:43,090 --> 00:20:47,100
.البارحة، كان مكانه مجهولاً لبضعة دقائق

362
00:20:47,900 --> 00:20:50,080
.حدث ذلك وقت حدوث الزّلزال

363
00:20:50,080 --> 00:20:50,810
الزّلزال؟

364
00:20:51,270 --> 00:20:53,810
.حينها، ركضت إلى المعبد الدّاخليّ

365
00:20:54,480 --> 00:20:57,080
.وذهبنا خلفها

366
00:20:57,080 --> 00:21:00,350
.لكنّهما كانتا قد تبادلتا الأماكن قبيل لقائنا

367
00:21:01,130 --> 00:21:04,200
،لـ-لكن إن كنّا سنتقبّل أنّ استدعاء الأرواح حقيقة

368
00:21:04,200 --> 00:21:07,010
—فلن يكون هنالك من داعٍ لهذه المحاكـ

369
00:21:07,010 --> 00:21:09,240
.صمتًا

370
00:21:09,830 --> 00:21:11,450
...مرّ وقت طويل، أليس كذلك

371
00:21:12,820 --> 00:21:13,750
أيّها العمّ؟

372
00:21:14,180 --> 00:21:17,580
!أذكر هذا السّلوك

373
00:21:17,970 --> 00:21:21,460
.أظنّ أنّه سيكون عليّ أن أسأل ثانية

374
00:21:22,130 --> 00:21:24,840
،عند مقابلة فتاة جميلة
.نسأل أوّلاً عن اسمها ومهنتها

375
00:21:24,840 --> 00:21:27,490
.هذه واحدة من قواعدي

376
00:21:27,490 --> 00:21:29,860
.مياناغي تشينامي

377
00:21:29,860 --> 00:21:31,810
.أنا متقاعدة حاليًّا

378
00:21:35,090 --> 00:21:36,480
،لم أرك منذ مدّة

379
00:21:36,870 --> 00:21:37,850
.يا ريو-تشان

380
00:21:39,700 --> 00:21:41,110
!مياناغي تشينامي

381
00:21:42,780 --> 00:21:45,490
...حان الوقت أخيرًا لقلب هذه الصّفحة

382
00:21:46,020 --> 00:21:48,620
!عنها وعنّي في الماضي

383
00:23:20,360 --> 00:23:21,500
!أعترض

384
00:23:21,500 --> 00:23:26,140
لا أصدّق أنّ مياناغي تشينامي ظهرت
...في جسد أيامي-سان

385
00:23:26,140 --> 00:23:31,510
لقد ماتت سلفًا، لكنّ خطّتها
.وأياساتو كيميكو المرعبة كُشفت أخيرًا

386
00:23:32,140 --> 00:23:35,720
،بهدف إنقاذ مايوي-تشان
.وصلت لاستنتاج واحد

387
00:23:35,720 --> 00:23:38,100
.تبلغ المحاكمة مراحلها الأخيرة

388
00:23:38,520 --> 00:23:40,810
.ستُكشف الحقيقة قريبًا

389
00:23:40,810 --> 00:23:41,960
!سأعثر على المتناقضات

390
00:23:41,960 --> 00:23:43,200
!وأكتشف الحقيقة

391
00:23:43,200 --> 00:23:46,630
،في الحلقة القادمة: "جسر إلى تغيّر الأحداث
!"المحاكمة السّادسة

392
00:23:46,630 --> 00:23:47,550
!خذ هذه