1
00:00:00,690 --> 00:00:02,690
!ا-ابتعدي

2
00:00:05,710 --> 00:00:07,440
...دع الفتاة

3
00:00:07,890 --> 00:00:09,230
!دع الرّهينة تذهب

4
00:00:10,490 --> 00:00:11,540
!اخرسي

5
00:00:11,540 --> 00:00:13,530
،ا-اقتربي أكثر

6
00:00:13,530 --> 00:00:15,490
!وسأقتلها

7
00:00:16,490 --> 00:00:18,080
.هذا مؤسف

8
00:00:18,080 --> 00:00:20,620
.هذه هي نهاية طريقك

9
00:00:31,490 --> 00:00:34,110
.اسمي أياساتو تشيهيرو

10
00:00:34,590 --> 00:00:39,640
.هذه قصّة محاكمتي الأولى كمحامية دفاع

11
00:00:40,060 --> 00:00:43,770
وقعت أحداثها قبل سنة من
.لقائي لناروهودو-كُن

12
00:00:44,500 --> 00:00:48,700
.كان موكّلي الأوّل هاربًا محكومًا عليه بالإعدام

13
00:00:54,240 --> 00:00:58,490
سوف تكشف تلك المحاكمة حقيقة صادمة

14
00:00:59,080 --> 00:01:03,050
.وستصبح شيئًا لن أنساه لبقيّة حياتي

15
00:02:36,590 --> 00:02:38,420
.يكاد التّوتّر يقتلني

16
00:02:38,740 --> 00:02:40,670
.لا تفزعي يا تشيهيرو

17
00:02:40,670 --> 00:02:42,260
!تشجّعي وادخلي

18
00:02:43,020 --> 00:02:43,850
!صباح الخير

19
00:02:46,520 --> 00:02:49,740
!أنا آسفة! أنا جدّ آسفة

20
00:02:48,130 --> 00:02:50,480
!لم أفعل شيئًا

21
00:02:50,480 --> 00:02:52,480
!لم أقتل أحدًا

22
00:02:59,150 --> 00:03:00,860
،أوناميدا ميتشيرو

23
00:03:00,860 --> 00:03:03,300
.موكّلي الأوّل

24
00:03:03,300 --> 00:03:06,700
حُكم عليه بالإعدام قبل خمس
...سنوات، والآن

25
00:03:06,700 --> 00:03:07,830
.إنّه هارب من السّجن

26
00:03:08,930 --> 00:03:10,540
!لم أفعل شيئًا

27
00:03:10,540 --> 00:03:11,480
!أقسم

28
00:03:11,480 --> 00:03:15,020
نعم، لكنّك هربت بعد اعتقالك، صحيح؟

29
00:03:16,980 --> 00:03:18,380
!أنا آسفة! أنا آسفة

30
00:03:19,710 --> 00:03:23,910
قبل يومين، هرب من شاحنة شرطة
.عندما تعرّضت لحادث

31
00:03:24,470 --> 00:03:26,910
،تمّ اعتقاله ثانية بعد ثمان ساعات

32
00:03:26,910 --> 00:03:30,810
.لكن في ذلك الوقت، قُتلت شرطيّة

33
00:03:31,250 --> 00:03:34,300
.تعتقد الشّرطة أنّ أوناميدا-سان هو الفاعل

34
00:03:34,300 --> 00:03:35,520
...قبل خمس سنوات

35
00:03:36,570 --> 00:03:38,400
!تمّ تلفيق التّهمة لي

36
00:03:38,400 --> 00:03:40,860
!كذبت تلك المرأة في شهادتها

37
00:03:40,860 --> 00:03:43,300
...لذلك أنا

38
00:03:43,300 --> 00:03:46,960
هربت وقابلت الشّرطيّة؟

39
00:03:46,960 --> 00:03:49,450
.نعم، صحيح

40
00:03:49,790 --> 00:03:52,230
.إنّها سبب هروبي

41
00:03:52,870 --> 00:03:54,290
...لكن

42
00:03:54,290 --> 00:03:56,380
!لم أقتلها

43
00:03:56,380 --> 00:03:57,590
!أبدًا

44
00:04:00,090 --> 00:04:01,880
،يمكنني أن أثق بك

45
00:04:01,880 --> 00:04:03,290
صحيح يا أوناميدا-سان؟

46
00:04:04,470 --> 00:04:08,600
.لن تكتشفي الحقيقة بالتّحديق به فحسب

47
00:04:09,340 --> 00:04:12,690
كيف ستُبلي هرّتنا الصّغيرة وحدها
في عرين الأسد الكبير والمخيف؟

48
00:04:13,610 --> 00:04:15,150
.دعيني ألقي نظرة

49
00:04:15,150 --> 00:04:16,650
!كامينوغي-سينباي

50
00:04:17,040 --> 00:04:19,540
.أنت شجاعة حقًّا

51
00:04:20,190 --> 00:04:24,150
هارب محكوم عليه بالإعدام
هو أوّل موكّليك؟

52
00:04:24,150 --> 00:04:26,020
.لا أدري كيف وصلت إلى هنا أيضًا

53
00:04:26,020 --> 00:04:27,410
.حسنًا

54
00:04:27,410 --> 00:04:31,200
.ربّما تريدين شخصًا تلعبين معه

55
00:04:32,690 --> 00:04:35,890
هل كامينوغي سويو جيّد كفاية لك؟

56
00:04:35,890 --> 00:04:37,410
...مـ-مستحيل

57
00:04:37,410 --> 00:04:41,270
المحامي الأوّل في الوكالة معي هنا؟

58
00:04:42,550 --> 00:04:46,180
.في هذا اليوم، أنت هي المحامية الأولى

59
00:04:49,970 --> 00:04:52,270
لا شكّ في أنّ صديقنا هذا

60
00:04:52,270 --> 00:04:54,650
.قابل الضّحيّة قبل يومين

61
00:04:55,670 --> 00:04:58,730
.عُثر على هذه الملاحظة في مكتبها

62
00:05:00,510 --> 00:05:02,320
.لقد اتّصل بها وطلب لقاءها

63
00:05:02,320 --> 00:05:05,860
.تمّ تحديد الزّمان والمكان وطريقة التّعرّف إليها

64
00:05:05,860 --> 00:05:08,070
وشاح أبيض؟

65
00:05:08,070 --> 00:05:11,660
يمكن لمظهر الشّخص أن يتغيّر
.كثيرًا خلال خمس سنوات

66
00:05:12,390 --> 00:05:14,870
.الأدلّة الظّرفية موجودة بأكملها

67
00:05:14,870 --> 00:05:17,330
هل يمكنني حلّ هذه القضيّة بالفعل؟

68
00:05:17,330 --> 00:05:19,000
.ارتاحي

69
00:05:19,000 --> 00:05:23,180
.الادّعاء اليوم حديث العهد بالمهنة مثلك

70
00:05:23,180 --> 00:05:25,130
فـ-فعلاً؟

71
00:05:25,130 --> 00:05:26,660
...ولكن

72
00:05:26,660 --> 00:05:30,100
يبدو أنّه أعظم عبقريّ سبق وعرفه
.مكتب الادّعاء العامّ

73
00:05:30,100 --> 00:05:31,530
عبقريّ؟

74
00:05:31,530 --> 00:05:33,750
.حسنًا، جهّزي نفسك

75
00:05:33,750 --> 00:05:35,140
.حان الوقت

76
00:05:41,290 --> 00:05:45,190
.ستُفتتح جلسة محاكمة أوناميدا ميتشيرو

77
00:05:45,190 --> 00:05:47,780
.الدّفاع جاهز يا سيّدي القاضي

78
00:05:47,780 --> 00:05:50,200
.الادّعاء العامّ جاهز أيضًا

79
00:05:51,330 --> 00:05:56,490
أرى أنّ كلا الطّرفين حديثا العهد بمهنتهما؟

80
00:05:56,490 --> 00:05:59,120
.نـ-نعم. اسمي أياساتو تشيهيرو

81
00:05:59,970 --> 00:06:02,210
.وأنا اسمي ميتسوروغي ريجي

82
00:06:02,210 --> 00:06:06,220
أنت هو المدّعي العامّ الجديد
الّذي يتحدّث عنه الجميع؟

83
00:06:06,220 --> 00:06:09,420
.يُقال أنّك أصغر مدّعٍ عام في التّاريخ

84
00:06:09,420 --> 00:06:10,390
.أنا في العشرين

85
00:06:10,390 --> 00:06:12,920
!إنّه أصغر منّي؟

86
00:06:12,920 --> 00:06:17,220
أعتقد أنّ هرّتنا الصّغيرة ليست
لديها سمعة كبيرة بعد؟

87
00:06:20,350 --> 00:06:23,980
.حسنًا أيّها المدّعي العامّ ميتسوروغي
.قدّم مرافعتك الافتتاحيّة رجاءً

88
00:06:24,950 --> 00:06:26,280
،قبل خمس سنوات

89
00:06:26,930 --> 00:06:30,320
.حُكم على المدّعى عليه أوناميدا ميتشيرو بالإعدام

90
00:06:31,230 --> 00:06:34,410
.كانت جرائمه هي الاختطاف والابتزاز والقتل

91
00:06:34,410 --> 00:06:38,960
الفتاة الّتي ألقاها من الجسر كانت
.في الرّابعة عشر من عمرها فحسب

92
00:06:39,570 --> 00:06:44,820
.النّهر الّذي تحت الجسر معروف بتيّاره القويّ

93
00:06:44,820 --> 00:06:48,800
.يصعب استعادة معظم الجثث الّتي تسقط فيه

94
00:06:49,150 --> 00:06:51,180
.جريمة شنعاء بالفعل

95
00:06:51,570 --> 00:06:53,180
ما حسم هذه القضيّة

96
00:06:53,180 --> 00:06:55,350
.كانت شهادة شاهدة معيّنة

97
00:06:57,690 --> 00:07:00,730
.شهادة شرطيّة واجهت المجرم

98
00:07:00,730 --> 00:07:02,810
اعتقلت أوناميدا في مكان الحادث

99
00:07:02,810 --> 00:07:06,150
.وشهدت لاحقًا ضدّه

100
00:07:06,150 --> 00:07:09,400
،أخذ ذلك الرّجل الفتاة رهينة
،وبعد أن انتهى منها

101
00:07:09,400 --> 00:07:11,240
!رماها في النّهر

102
00:07:14,420 --> 00:07:19,090
تلك الشّهادة هي الّتي أنزلت
.عليه الحكم بالإعدام

103
00:07:19,090 --> 00:07:21,120
وتلك الشّرطيّة نفسها

104
00:07:21,120 --> 00:07:23,710
،هي الضّحيّة في هذه القضيّة

105
00:07:24,050 --> 00:07:26,170
.رقيب الشّرطة مياناغي يوكي

106
00:07:26,700 --> 00:07:30,560
الرّجل الّذي حُكم عليه بالإعدام
استنادًا على شهادتها

107
00:07:30,560 --> 00:07:32,590
هرب قبل يومين

108
00:07:34,410 --> 00:07:36,640
!وحصل أخيرًا على انتقامه

109
00:07:37,470 --> 00:07:40,620
.واضح تمامًا أنّ المدّعى عليه مذنب

110
00:07:41,180 --> 00:07:42,940
!مـ-مهلاً لحظة

111
00:07:42,940 --> 00:07:47,770
.إنّ الدّفاع، لحظة... يطالب باستجواب الشّهود

112
00:07:48,270 --> 00:07:52,030
ماذا؟ ألا يعرف يافعو هذه الأيّام
متى يستسلمون؟

113
00:07:52,030 --> 00:07:55,350
يمكن لروح الشّباب أن تكون مثيرة
.للشفقة أحيانًا

114
00:07:55,350 --> 00:07:58,300
ماذا تقول؟ أنت أصغر سنًّا
!منّي أيّها المنافق

115
00:07:58,300 --> 00:07:59,320
.لا بأس

116
00:07:59,320 --> 00:08:04,460
.أستدعي المحقّق الّذي كان مسؤولاً عن التّحقيق

117
00:08:04,950 --> 00:08:07,060
.أيّها الشّاهد، أطلعنا على اسمك ومهنتك

118
00:08:07,060 --> 00:08:12,970
،حاضر! اسمي إيتونوكوغيري كيسكي
!محقّق جرائم قتل في دائرة الشّرطة

119
00:08:12,970 --> 00:08:19,100
لقد ترقّيت أخيرًا لمنصب المحقّق
!قبل نصف سنة

120
00:08:19,530 --> 00:08:21,200
.لا أظنّ أنّ أحدًا قد سألك عن ذلك

121
00:08:21,200 --> 00:08:22,060
.والآن أيّها المحقّق

122
00:08:22,490 --> 00:08:24,310
.قدّم شهادتك رجاءً

123
00:08:24,310 --> 00:08:25,400
!حاضر

124
00:08:25,750 --> 00:08:27,870
!ها قد بدأنا

125
00:08:27,870 --> 00:08:29,860
.أيّها الهرّة

126
00:08:29,860 --> 00:08:32,440
.من الأفضل أن تنتبهي جيّدًا

127
00:08:32,440 --> 00:08:34,820
...وإلاّ فسيفوتك الكثير

128
00:08:35,490 --> 00:08:37,410
.من طرف إله العدالة

129
00:08:40,950 --> 00:08:43,960
في يوم الحادثة، اتّصل المدّعى عليه
.بمياناغي يوكي وطلب لقاءها

130
00:08:43,960 --> 00:08:49,000
ذهبت إلى الجسر المكفهرّ
.في الوقت الّذي حُدّد للّقاء

131
00:08:49,400 --> 00:08:52,210
.هذه هي الملاحظة الّتي دوّنتها خلال المكالمة

132
00:08:52,210 --> 00:08:54,800
إنّها الملاحظة الّتي رأيتها
.في القاعة قبل المحاكمة

133
00:08:55,340 --> 00:08:59,670
قابل المدّعى عليه الضّحيّة هناك
.وطعنها في الظّهر بسكّين

134
00:08:59,670 --> 00:09:02,130
.واتّضح أنّ الإصابة كانت قاتلة

135
00:09:02,700 --> 00:09:06,940
ثمّ قام بوضع جثّتها في صندوق
.سيّارته وحاول الهرب

136
00:09:06,940 --> 00:09:10,150
.لكن تمّ اعتقاله في إحدى نقاط تفتيش الشّرطة

137
00:09:10,900 --> 00:09:12,860
.هذه صورة من صندوق سيّارته

138
00:09:12,860 --> 00:09:16,950
يمكنكم  رؤية السّكّين الّذي ما زال
.مغروسًا في ظهر الضّحيّة

139
00:09:16,950 --> 00:09:19,320
!لا شيء غريب في هذا

140
00:09:19,320 --> 00:09:20,680
.حسنًا

141
00:09:20,680 --> 00:09:23,340
.وقت الاستجواب أيّها الدّفاع

142
00:09:23,980 --> 00:09:24,780
أيّها الدّفاع؟

143
00:09:24,780 --> 00:09:25,970
!حا-حاضرة

144
00:09:25,970 --> 00:09:27,500
!سـ-سأقوم بالاستجواب في الحال

145
00:09:27,500 --> 00:09:32,550
،مهلاً، مهلاً. إن واصلت الارتعاش هكذا
.فستجعلينني أسكب قهوتي

146
00:09:33,150 --> 00:09:35,070
!أ-أنا أرتعش من شدّة الحماس

147
00:09:36,800 --> 00:09:40,140
كان لأوناميدا-سان سيّارة؟

148
00:09:40,140 --> 00:09:43,640
.نعم. وقعت الجريمة على جسر في الجبال

149
00:09:43,960 --> 00:09:46,690
.كانت سيّارة مسروقة بالطّبع

150
00:09:46,690 --> 00:09:48,820
جسر في الجبال؟

151
00:09:48,820 --> 00:09:50,230
لماذا التقى بها هناك؟

152
00:09:50,670 --> 00:09:54,400
.لأنّه مكان مهمّ للغاية للمدّعى عليه

153
00:09:54,820 --> 00:09:56,600
ماذا تقصد بذلك؟

154
00:09:56,600 --> 00:10:00,530
إنّه المكان الّذي قتل فيه رهينته
،قبل خمس سنوات

155
00:10:01,000 --> 00:10:04,460
واعتقلته فيه الرّقيب مياناغي؟

156
00:10:04,460 --> 00:10:06,500
.كان نفس الجسر المكفهرّ

157
00:10:07,700 --> 00:10:11,130
لقاء مصيريّ في مكان مميّز؟

158
00:10:12,210 --> 00:10:15,620
.إليكم صورة تمّ التقاطها لحظة الجريمة

159
00:10:15,620 --> 00:10:18,970
يمكننا رؤيتهما يواجهان بعضهما
.على الجسر بوضوح

160
00:10:20,090 --> 00:10:22,550
هذا حاسم للغاية، صحيح؟

161
00:10:23,770 --> 00:10:27,200
.يا له من دليل ساخن ومرّ

162
00:10:27,200 --> 00:10:28,330
...لكن

163
00:10:29,450 --> 00:10:33,550
.للأسف، طعمه الغريب ظاهر للعيان

164
00:10:33,550 --> 00:10:35,540
طـ-طعمه الغريب؟

165
00:10:38,460 --> 00:10:40,110
...أ-أهذا

166
00:10:40,110 --> 00:10:44,120
بالضّبط. هكذا يجب أن يكون
.مذاق القهوة الحقيقيّ

167
00:10:44,620 --> 00:10:45,330
!أيّها المحقّق

168
00:10:45,330 --> 00:10:47,070
نـ-نعم؟

169
00:10:47,070 --> 00:10:50,910
هل قلتَ أنّه لا يوجد شيء
غريب في الصّورة؟

170
00:10:50,910 --> 00:10:52,680
!نعم، ذلك ما قلتُه

171
00:10:52,680 --> 00:10:55,340
ألق نظرة أخرى على الملاحظة
.الّتي تركتها الضّحيّة

172
00:10:55,340 --> 00:10:57,880
".ارتدي وشاحًا أبيض ليتعرّف عليك"

173
00:10:57,880 --> 00:11:01,430
هذا يعني أنّ الضّحيّة كانت
.ترتدي وشاحًا أبيض

174
00:11:01,430 --> 00:11:03,900
.لكن ألق نظرة على الصّورة

175
00:11:05,150 --> 00:11:07,600
!لا يوجد... وشاح

176
00:11:07,600 --> 00:11:09,560
...بالضّبط! وهذا

177
00:11:12,340 --> 00:11:13,860
...لـ-لحظة

178
00:11:13,860 --> 00:11:15,360
!غريب بشكل واضح

179
00:11:18,740 --> 00:11:21,360
."الكلمة المناسبة هي "تناقض

180
00:11:22,180 --> 00:11:25,080
هل هذا هو الوشاح الّذي تبحثين عنه؟

181
00:11:25,500 --> 00:11:27,330
!أين وجدته؟

182
00:11:27,700 --> 00:11:31,340
.على الجسر المكفهرّ. تحقّقت منه أوّلاً

183
00:11:31,340 --> 00:11:34,340
لماذا لم تخبرني؟

184
00:11:34,340 --> 00:11:37,800
هل أخفاه ذلك المدّعي العامّ عمدًا؟

185
00:11:39,010 --> 00:11:42,410
،إنّه ليس أبيض تمامًا
،كما طلب المدّعى عليه

186
00:11:42,410 --> 00:11:44,880
لكن لا بدّ أنّ الضّحيّة استعملته
.بما أنّ لونه كان قريبًا كفاية

187
00:11:44,880 --> 00:11:47,140
.وهو واضح في الصّورة

188
00:11:47,790 --> 00:11:50,850
لقد سقط منها عندما كانت
.تحاول مقاومة القاتل

189
00:11:51,900 --> 00:11:54,520
!كيف للدّفاع أن يغفل عن هذا؟

190
00:11:58,940 --> 00:12:00,930
كان فخًّا؟

191
00:12:00,930 --> 00:12:02,410
ما قولك؟

192
00:12:02,410 --> 00:12:06,490
أما زلت ستؤمنين بهذا المحكوم
عليه بالإعدام؟

193
00:12:09,290 --> 00:12:10,510
!بالطّبع

194
00:12:10,510 --> 00:12:15,510
.علينا أن نركّز أكثر ونستمع لشهادة جديدة

195
00:12:15,510 --> 00:12:19,000
ماذا؟ شهادة جديدة؟

196
00:12:19,000 --> 00:12:22,720
.أحضري ذلك الشّاهد

197
00:12:24,090 --> 00:12:25,840
!أيّها المحقّق

198
00:12:25,840 --> 00:12:29,450
من التقط تلك الصّورة؟

199
00:12:29,450 --> 00:12:31,560
...ماذا؟ إ-إنّه

200
00:12:31,990 --> 00:12:35,060
.يمكنك القول أنّه طرف ثالث بنوايا حسنة

201
00:12:35,370 --> 00:12:37,620
إنّه شاهد عيان إذًا؟

202
00:12:37,620 --> 00:12:39,880
لماذا لم يتمّ استدعاؤه؟

203
00:12:39,880 --> 00:12:41,650
،إن كان هنالك شاهد عيان

204
00:12:42,160 --> 00:12:44,860
!فإنّ الدّفاع يطلب أن يقدّم شهادته

205
00:12:47,490 --> 00:12:50,930
لا ينوي الادّعاء العامّ إخفاء
.أيّ شاهد من المحكمة

206
00:12:50,930 --> 00:12:53,870
.نحن جاهزون لتقديم شاهدنا في أيّ وقت

207
00:12:53,870 --> 00:12:55,960
.كم هذا شجاع

208
00:12:55,960 --> 00:12:58,620
سيستدعي الادّعاء العامّ إذًا

209
00:12:59,170 --> 00:13:04,800
المرأة الّتي شهدت على هذه الأحداث
!المأساويّة في ذلك اليوم بأمّ عينيها

210
00:13:13,390 --> 00:13:16,650
.أيّتها الشّاهدة، أطلعينا على اسمك ومهنتك

211
00:13:17,230 --> 00:13:21,090
.اسمي موكوي ساتوكو

212
00:13:21,090 --> 00:13:22,980
.أنا طالبة جامعيّة

213
00:13:23,190 --> 00:13:25,280
.سررت بلقائكم جميعًا

214
00:13:26,010 --> 00:13:30,050
!يجعلني النظر إليك أشعر براحة كبيرة

215
00:13:30,050 --> 00:13:33,750
!أريد تقديم حكم رحيم في الحال

216
00:13:33,750 --> 00:13:36,210
!لا تكن غبيًّا

217
00:13:36,700 --> 00:13:39,570
.يبدو أنّ هنالك ملاكًا مشاكسًا قد نزل علينا

218
00:13:40,260 --> 00:13:44,380
كنتِ على مقربة من مكان
الحادث الأليم، صحيح؟

219
00:13:46,090 --> 00:13:48,800
والتقطتِ هذه الصّورة؟ أهذا صحيح؟

220
00:13:50,510 --> 00:13:54,020
عفوًا... من أنت؟

221
00:13:54,020 --> 00:13:56,100
.أ-أنا محامية الدّفاع

222
00:13:56,100 --> 00:13:58,280
.اسمي أياساتو تشيهيرو

223
00:13:58,280 --> 00:13:59,930
أياساتو"؟"

224
00:13:59,930 --> 00:14:01,670
...أنت إذًا

225
00:14:03,220 --> 00:14:04,650
.حسنًا أيّتها الآنسة

226
00:14:05,120 --> 00:14:07,470
هلاّ قدّمتِ شهادتك رجاءً؟

227
00:14:07,470 --> 00:14:08,110
.بالطّبع

228
00:14:08,460 --> 00:14:09,820
.سأبذل جهدي

229
00:14:12,370 --> 00:14:19,270
أخذت آلة التّصوير ومسندها ثلاثيّ
.القوائم إلى سهل قرب الجسر

230
00:14:19,270 --> 00:14:25,340
تمكّنت من التقاط الكثير من الصّور
.الجميلة بالمؤقّت الّذي في آلة التّصوير

231
00:14:29,980 --> 00:14:34,440
.ثمّ لاحظت وجود شخصين على الجسر

232
00:14:34,440 --> 00:14:36,120
،وعندما كنت أشاهدهما

233
00:14:36,120 --> 00:14:39,550
!بدأ كلاهما في مقاومة الآخر فجأة

234
00:14:39,980 --> 00:14:44,960
،حاولت الضّحيّة الهرب من القاتل

235
00:14:44,960 --> 00:14:47,780
!لكنّه لحق بها وطعنها من الخلف

236
00:14:47,780 --> 00:14:49,490
!كلاّ

237
00:14:49,490 --> 00:14:55,470
في النّهاية، حملها القاتل الجثّة
.وابتعد عن الجسر

238
00:14:56,310 --> 00:15:02,070
.سمعتُ أنّه أخفاها في سيّارته وهرب

239
00:15:02,070 --> 00:15:04,810
،وعندما عدتُ لرشدي أخيرًا

240
00:15:04,810 --> 00:15:07,030
.اتّصلت بالشّرطة في الحال

241
00:15:07,870 --> 00:15:10,470
لا بدّ أنّ مشاهدتك لعنف كهذا
.قد كان صعبًا عليك يا مسكينة

242
00:15:10,940 --> 00:15:13,070
!كنتُ مصدومة للغاية

243
00:15:13,070 --> 00:15:15,610
!لقد جعل ذلك قلبي ينبض بشدّة

244
00:15:15,610 --> 00:15:17,680
.نعم، نعم، هذا مؤسف

245
00:15:17,680 --> 00:15:21,180
.لقد قُضي عليها إن اعتُمدت هذه الشّهادة

246
00:15:21,180 --> 00:15:22,190
!مستحيل

247
00:15:22,890 --> 00:15:26,020
!استعدّي للقتال يا تشيهيرو

248
00:15:26,450 --> 00:15:29,990
.حمل القاتل جثّة الضّحيّة وترك الجسر

249
00:15:29,990 --> 00:15:31,810
هل أنت واثقة؟

250
00:15:31,810 --> 00:15:32,850
.نعم

251
00:15:32,850 --> 00:15:36,200
.لكنّ ذلك غريب جدًّا

252
00:15:36,980 --> 00:15:40,170
.هنالك نهر تحت الجسر مباشرة

253
00:15:40,170 --> 00:15:43,290
إن كان يريد إخفاء الجثّة، فكلّ ما
.كان عليه فعله هو رميها في الماء

254
00:15:44,420 --> 00:15:49,630
في الحقيقة، ألا يفترض أنّ هذا الرّجل
قد قام بنفس الشّيء قبل خمس سنوات؟

255
00:15:50,580 --> 00:15:54,670
إذًا لماذا اختار حملها إلى سيّارته هذه المرّة؟

256
00:15:54,670 --> 00:15:56,420
!تبدو تصرّفاته متناقضة بالكامل

257
00:15:57,070 --> 00:15:58,540
!مستحيل

258
00:15:58,540 --> 00:16:00,490
،مهما بدت غريبة

259
00:16:00,490 --> 00:16:02,900
لكنّ حقيقة أنّها من صنيع
.القاتل تظلّ قائمة

260
00:16:03,380 --> 00:16:07,100
!لا علاقة لأسبابه بما رأته الشّاهدة

261
00:16:07,530 --> 00:16:09,990
!صحيح! ذلك ما رأيته

262
00:16:10,350 --> 00:16:15,160
لقد فتح القاتل صندوق السّيّارة
!عنوة وأخفى الجثّة هناك

263
00:16:16,010 --> 00:16:17,370
!هذا مستحيل

264
00:16:17,370 --> 00:16:19,370
ما-ماذا تقولين؟

265
00:16:19,790 --> 00:16:23,250
.انظري للصّورة الّتي التقطتها

266
00:16:23,630 --> 00:16:26,920
كما ترين، نهاية الجسر متوارية
.خلف تلك الصّخور البارجة

267
00:16:26,920 --> 00:16:29,920
،ممّا يعني أنّه من مكان وقوفك ذلك

268
00:16:30,300 --> 00:16:32,550
ما كنتِ لتستطيعي رؤيته يفتح
!صندوق السّيّارة عنوة

269
00:16:34,290 --> 00:16:38,300
إذًا كيف تعرفين بهذا الأمر؟

270
00:16:38,300 --> 00:16:41,390
!هنالك إجابة واحدة فقط

271
00:16:42,290 --> 00:16:45,060
لأنّ من أخفى الجثّة في صندوق السّيّارة ذاك

272
00:16:45,060 --> 00:16:48,860
!هو أنت

273
00:16:49,410 --> 00:16:52,320
ماذا؟ الشّاهدة هي من أخفت الجثّة؟

274
00:16:52,570 --> 00:16:53,570
!أعترض

275
00:16:54,540 --> 00:16:58,720
من المستحيل أن تكون الشّاهدة
!في مكان الجريمة عندما وقعت

276
00:16:58,720 --> 00:17:02,620
!أنسيتِ أنّها التقطت الصّورة وقتها؟

277
00:17:03,110 --> 00:17:05,150
هل نسيت أنت؟

278
00:17:05,150 --> 00:17:09,010
كان لآلة تصوير الشّاهدة
.حاملاً ثلاثيّ القوائم ومؤقّتًا

279
00:17:09,710 --> 00:17:14,380
بعبارات أخرى، كان بإمكانها التقاط
.الصّورة حتّى بدون وجودها هناك

280
00:17:15,490 --> 00:17:18,790
لكن لماذا قد تفعل هذا من الأساس؟

281
00:17:21,870 --> 00:17:25,570
لقد قتلت مياناغي يوكي وأخفت الجثّة
.في صندوق السّيّارة

282
00:17:25,570 --> 00:17:27,100
ما-ماذا؟

283
00:17:27,430 --> 00:17:30,820
.لهذا السّبب اختارت ألاّ ترميها في النّهر

284
00:17:30,820 --> 00:17:33,320
!كلّ ذلك لتلفيق التّهمة بأوناميدا-سان

285
00:17:37,240 --> 00:17:39,070
ما-ماذا؟

286
00:17:39,070 --> 00:17:40,740
الشّاهدة هي القاتلة الحقيقيّة؟

287
00:17:40,740 --> 00:17:42,620
!لكنّ هذا غريب

288
00:17:43,030 --> 00:17:44,350
أوناميدا-سان؟

289
00:17:44,350 --> 00:17:49,000
لقد ركبت السّيّارة وهربت في الحال
.بعد لقائي بتلك المرأة

290
00:17:49,000 --> 00:17:52,130
لم يكن هنالك وقت كافٍ لقتلها
.وإخفاء جثّتها في صندوق السّيّارة

291
00:17:52,530 --> 00:17:56,620
ذلك يعني أنّ القاتل قد أخفى جثّة
الضّحيّة في صندوق السّيّارة

292
00:17:57,180 --> 00:18:01,260
.قبل أن تلتقي بها في الجسر

293
00:18:01,260 --> 00:18:02,510
!أعترض

294
00:18:03,220 --> 00:18:05,310
!ما-ما هذا الغباء؟

295
00:18:05,310 --> 00:18:08,310
!واضح أنّ الضّحيّة ظاهرة في الصّورة

296
00:18:08,310 --> 00:18:11,900
!مياناغي يوكي كانت حيّة عندما التُقطت

297
00:18:12,890 --> 00:18:13,690
!أعترض

298
00:18:15,830 --> 00:18:18,660
ما زلت لا تفهم أيّها المدّعي العامّ ميتسوروغي؟

299
00:18:19,750 --> 00:18:25,200
في الوقت الّتي وصل فيها أوناميدا-سان
.للجسر، كانت الضّحيّة ميتة سلفًا

300
00:18:25,200 --> 00:18:29,040
بعبارات أخرى، الشّخص الّذي في
.الصّورة لم يكن مياناغي يوكي

301
00:18:29,440 --> 00:18:32,750
!ماذا؟ من قد يكون غيرها؟

302
00:18:32,750 --> 00:18:34,650
أليس ذلك واضحًا؟

303
00:18:35,900 --> 00:18:39,180
!كانت شاهدتك موكوي ساتوكو

304
00:18:39,180 --> 00:18:41,550
!ما-ماذا؟

305
00:18:45,850 --> 00:18:48,110
...ا-الضّحيّة في هذه الصّورة

306
00:18:48,110 --> 00:18:50,350
الشّخص الّذي التقاه أوناميدا-سان على الجسر

307
00:18:50,740 --> 00:18:52,250
كان أنت، صحيح؟

308
00:18:53,620 --> 00:18:57,240
شكرًا على كوب القهوة هذا

309
00:18:57,240 --> 00:18:58,440
.مستحيل

310
00:18:58,440 --> 00:19:00,090
!هذا سخيف

311
00:19:00,090 --> 00:19:03,070
!أنا؟ أنتحل دور الضّحيّة؟

312
00:19:03,790 --> 00:19:06,840
لا يتذكّر أوناميدا-سان كيف تبدو
.الضّحيّة بالضّبط

313
00:19:06,840 --> 00:19:09,960
لهذا السّبب طلب منها ارتداء
.الوشاح ليتعرّف عليها

314
00:19:09,960 --> 00:19:11,580
أليس كذلك؟

315
00:19:11,580 --> 00:19:14,920
.لم أكن واثقًا بأنّني سأعرفها

316
00:19:14,920 --> 00:19:17,160
كـ-كيف هذا؟

317
00:19:17,160 --> 00:19:20,050
بعبارات أخرى، ما دامت ترتدي
،وشاحًا كما طلب

318
00:19:20,470 --> 00:19:23,760
!يمكن لأيّ امرأة التّظاهر بأنّها مياناغي يوكي

319
00:19:28,310 --> 00:19:29,640
!هذا قاسٍ

320
00:19:30,040 --> 00:19:33,690
!كنت ألتقط صورًا هناك فحسب

321
00:19:33,690 --> 00:19:36,450
!لا صلة لي بالضّحيّة أو السّجين

322
00:19:36,450 --> 00:19:38,940
ومع ذلك تنعتينني بالقاتلة؟

323
00:19:39,340 --> 00:19:44,450
!هذا عبء ثقيل ليحمله أيّ أحد

324
00:19:44,880 --> 00:19:46,270
!بالضّبط

325
00:19:46,270 --> 00:19:50,370
لا تملك الشّاهدة أيّ دافع لقتل
!مياناغي يوكي

326
00:19:50,370 --> 00:19:52,920
!نعم! لا دافع لديّ

327
00:19:53,860 --> 00:19:57,050
ما قول الدّفاع؟ ما هو دافعها؟

328
00:19:57,050 --> 00:19:58,630
...حـ-حسنًا

329
00:20:00,270 --> 00:20:02,590
!القاتل هو ذلك السّجين هناك

330
00:20:03,030 --> 00:20:07,570
لقد سلب حياة الضّحيّة كما
!فعل قبل خمس سنوات

331
00:20:08,010 --> 00:20:09,060
قبل خمس سنوات؟

332
00:20:09,890 --> 00:20:12,890
أتقصدين عندما سلب حياة مياناغي تشينامي؟

333
00:20:14,810 --> 00:20:17,210
مياناغي... تشينامي؟

334
00:20:17,210 --> 00:20:17,900
.نعم

335
00:20:18,300 --> 00:20:22,530
ذلك هو اسم الفتاة الّتي اختُطفت
.وقُتلت قبل خمس سنوات

336
00:20:24,360 --> 00:20:26,580
!مـ-مهلاً لحظة

337
00:20:26,580 --> 00:20:27,910
...هل مياناغي

338
00:20:27,910 --> 00:20:32,350
بالضّبط. الضّحيّة في هذه
.القضيّة هي مياناغي يوكي

339
00:20:32,350 --> 00:20:35,710
.مياناغي تشينامي كانت أختها الصّغرى

340
00:20:35,710 --> 00:20:36,820
ماذا؟

341
00:20:36,820 --> 00:20:37,790
أختها؟

342
00:20:38,730 --> 00:20:43,300
أعتقد فعلاً أنّ طريقة إطلاقها للنّار على الخاطف
.وهو يمسك بالضّحيّة كانت بها مخاطرة كبيرة

343
00:20:43,300 --> 00:20:45,070
كانت أختها الصّغرى؟

344
00:20:46,460 --> 00:20:49,020
...سينباي، هل ذلك

345
00:20:49,020 --> 00:20:55,280
نعم. الملف المتعلّق بالاختطاف
.منذ خمس سنوات

346
00:20:55,280 --> 00:21:00,320
أدركت أنّ مفتاح حلّ هذه القضيّة
.يكمن في اكتشاف ما حدث حينها

347
00:21:00,320 --> 00:21:01,400
!أعترض

348
00:21:01,770 --> 00:21:06,530
اسم الفتاة الّتي ماتت قبل خمس سنوات
!لا علاقة له بهذه القضيّة

349
00:21:06,530 --> 00:21:08,490
الفتاة الّتي ماتت"؟"

350
00:21:08,490 --> 00:21:10,210
هل ماتت فعلاً؟

351
00:21:10,210 --> 00:21:11,410
ماذا تعني؟

352
00:21:12,090 --> 00:21:16,260
قبل خمس سنوات، سقطت مياناغي تشينامي
الّتي كانت في الرّابعة عشر من عمرها حينها

353
00:21:16,260 --> 00:21:19,260
،في النّهر الّذي أسفل الجسر

354
00:21:19,260 --> 00:21:21,840
.ولم يتمّ العثور على جثّتها

355
00:21:22,610 --> 00:21:23,590
ماذا؟

356
00:21:23,590 --> 00:21:28,150
.صحيح. اختفت من العالم بدون أيّ أثر

357
00:21:31,230 --> 00:21:33,140
.مستحيل... غير ممكن

358
00:21:33,560 --> 00:21:35,930
كانت في الرّابعة عشر حينها؟

359
00:21:35,930 --> 00:21:38,100
،إن كانت على قيد الحياة الآن

360
00:21:38,430 --> 00:21:40,190
.فستكون في نفس عمرك

361
00:21:42,810 --> 00:21:43,950
...أنت

362
00:21:43,950 --> 00:21:46,860
من أنت بالضّبط؟

363
00:23:20,430 --> 00:23:21,500
!أعترض

364
00:23:21,500 --> 00:23:24,840
،لإثبات أنّ المدّعى عليه أوناميدا بريء

365
00:23:24,840 --> 00:23:30,390
كان من الضّروريّ الكشف عن اللّغز
.خلف القضيّة الّتي أدين بها

366
00:23:30,830 --> 00:23:33,130
من هذا الرّجل الغامض ساتوكو؟

367
00:23:33,130 --> 00:23:37,760
وما الّذي حدث بين الشّرطيّة وأوناميدا؟

368
00:23:37,760 --> 00:23:41,600
.سوف نحدّق في الهاوية في ظلال هذه القضيّة

369
00:23:41,910 --> 00:23:42,940
!سأعثر على المتناقضات

370
00:23:42,940 --> 00:23:44,080
!وأكتشف الحقيقة

371
00:23:44,080 --> 00:23:47,230
في الحلقة القادمة: "بدايات تغيّر
!"الأحداث، المحاكمة الأخيرة

372
00:23:47,230 --> 00:23:48,250
!خذ هذه