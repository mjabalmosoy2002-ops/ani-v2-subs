1
00:00:00,850 --> 00:00:03,650
.أنا محامٍ واسمي ناروهودو ريويتشي

2
00:00:03,650 --> 00:00:05,510
مسرح أحدث معاركي

3
00:00:05,510 --> 00:00:08,760
هو قطار سريع خاصّ يتّجه شمالاً
،عبر السّهول مغطّاة بالثّلوج

4
00:00:08,760 --> 00:00:10,280
.ويدعى النّجم الفضّيّ

5
00:00:10,280 --> 00:00:13,700
.ستُجرى محاكمة في غرفة العشاء خاصّته

6
00:00:14,550 --> 00:00:20,040
وفي هذا الوضع العبَثيّ، سيكون عليّ
.الدّفاع عن وكيل غير معقول

7
00:00:23,450 --> 00:00:30,000
ستُفتتح الآن جلسة محاكمة
!الهارب هابلي ريتشناندي

8
00:02:03,640 --> 00:02:06,940
‫31 ديسمبر، عشيّة رأس السّنة.

9
00:02:06,940 --> 00:02:12,190
تمت دعوتي لأشارك في الرّحلة الأولى
.للقطار السّريع المسمّى النّجم الفضّيّ

10
00:02:12,190 --> 00:02:14,800
.لقد جعلناكم تنتظرون كثيرًا

11
00:02:14,800 --> 00:02:20,290
اليوم هو اليوم الّذي سينطلق فيه القطار
.السّريع الفاخر المسمّى النّجم الفضّيّ

12
00:02:20,290 --> 00:02:24,700
المليونير من جمهوريّة ناريكين
،المحبّ جدًّا لليابان والسّكك الحديديّة

13
00:02:24,700 --> 00:02:30,010
هابلي ريتشناندي، قد منح من ماله الخاصّ
.لتحقيق حلم خطّ سكّة حديد خاصّ

14
00:02:30,010 --> 00:02:32,380
.إنّه النّجم الفضّيّ

15
00:02:32,760 --> 00:02:38,010
لسوء الحظّ، لم يستطع السّيّد ريتشناندي
،التّواجد معنا اليوم

16
00:02:38,010 --> 00:02:41,780
.لكن رغم ذلك، سننطلق في وقت وشيك

17
00:02:41,780 --> 00:02:43,720
أليس رائعًا؟

18
00:02:43,720 --> 00:02:45,830
.لقد بنوه كقطار بخاريّ عمدًا

19
00:02:45,830 --> 00:02:47,800
.يُشعر هذا بالخنين

20
00:02:47,800 --> 00:02:49,390
.تقصدين الحنين

21
00:02:53,450 --> 00:02:54,840
.حسنًا

22
00:02:54,840 --> 00:02:56,710
.لنصعد يا ناروهودو-كُن

23
00:02:56,710 --> 00:02:58,780
!ماذا؟ أنتما هنا

24
00:02:59,330 --> 00:03:00,890
المحقّق إيتونوكو؟

25
00:03:00,890 --> 00:03:02,850
!والقاضي أيضًا

26
00:03:02,850 --> 00:03:04,330
.مرحبًا بكما

27
00:03:04,660 --> 00:03:07,490
.لقد دخلنا مسابقة البطاقات البريديّة وفزنا

28
00:03:07,490 --> 00:03:11,960
أنا ذاهب في رحلة إلى الينابيع السّاخنة
.في الشّمال على متن قطار بخاريّ

29
00:03:11,960 --> 00:03:13,410
!انظرا

30
00:03:13,410 --> 00:03:16,420
!أمّا نحن فقد دُعينا

31
00:03:16,750 --> 00:03:19,130
ماذا؟ دُعيتما؟

32
00:03:19,130 --> 00:03:22,360
.في أيّ مقطورة أنتما؟ نحن في المقطورة الأولى

33
00:03:22,360 --> 00:03:24,360
.نحن في الثّالثة

34
00:03:24,360 --> 00:03:26,140
!لنلتقِ لاحقًا

35
00:03:29,210 --> 00:03:29,860
.تفضّل

36
00:03:30,420 --> 00:03:31,690
.شكرًا جزيلاً

37
00:03:32,530 --> 00:03:36,010
ناروهودو ريويتشي-ساما وأياساتو مايوي-ساما؟

38
00:03:36,520 --> 00:03:38,380
.مرحبًا بكما على متن النّجم الفضّيّ

39
00:03:38,380 --> 00:03:41,250
.أنا ريك، وسأكون مرافقكما

40
00:03:41,250 --> 00:03:43,050
.سررنا بلقائك يا ريك-سان

41
00:03:43,050 --> 00:03:45,200
أنتما في غرفة ساكورا، صحيح؟

42
00:03:45,200 --> 00:03:47,230
غرفة ساكورا"؟"

43
00:03:47,230 --> 00:03:49,790
!يبدو هذا كفندق تقليديّ

44
00:03:51,730 --> 00:03:53,720
!مكتوب ساكورا بالفعل

45
00:03:57,060 --> 00:03:59,180
!لم أر شيئًا كهذا من قبل

46
00:03:59,180 --> 00:04:00,920
إنّها مقصورة؟

47
00:04:02,490 --> 00:04:03,380
!مذهل

48
00:04:03,740 --> 00:04:05,220
!وكأنّها غرفة فندق

49
00:04:05,220 --> 00:04:07,610
.نعم، هذا رائع

50
00:04:07,610 --> 00:04:09,180
.شكرًا جزيلاً

51
00:04:09,180 --> 00:04:15,570
النّجم الفضّيّ خدمة خاصّة بناها ريتشناندي
.عن طريق شراء خطّ سكّة حديد قديمة

52
00:04:16,010 --> 00:04:21,240
مظهره قديم الطّراز مُصَمّم تيمّنًا بالقطارات
.ذات المحرّك البخاريّ من الخمسينيّات

53
00:04:21,980 --> 00:04:24,730
.حتّى الدّيكور صُمّم بشكل دقيق

54
00:04:24,730 --> 00:04:31,250
وفي الوقت نفسه، فإنّ محرّكات القطار ونظام
.الدّفع من آخر ما وصلت إليه التّكنولوجيا

55
00:04:32,210 --> 00:04:37,880
بالمناسبة، يتكوّن الطّاقم العامل بأكمله
.من أشخاص تبعوا السّيّد ريتشناندي من بلاده

56
00:04:37,880 --> 00:04:39,810
أنت أيضًا يا ريك-سان؟

57
00:04:39,810 --> 00:04:42,630
.نعم، أنا من جمهوريّة ناريكين

58
00:04:43,080 --> 00:04:48,260
سمعت أنّ السّيّد ريتشناندي يحبّ اليابان
.كثيرًا وحصل مؤخّرًا على الجنسيّة

59
00:04:48,260 --> 00:04:48,930
.صحيح

60
00:04:48,930 --> 00:04:51,600
.هذا هو السّبب وراء وجود غرفة ساكورا وما شابه

61
00:04:52,150 --> 00:04:55,740
،السّكّة الحديديّة الأمثل
...التّجسيد لحلمه ومُثُله

62
00:04:55,740 --> 00:04:56,740
.إنّه النّجم الفضّيّ

63
00:04:57,370 --> 00:04:58,810
.نتمنّى أن تستمتعا برحلتكما

64
00:05:00,520 --> 00:05:05,720
.لكن لا أصدّق أنّك دُعيت لهذا

65
00:05:05,720 --> 00:05:09,320
متى أصبحت شخصًا معروفًا هكذا يا ناروهودو-كُن؟

66
00:05:09,320 --> 00:05:11,080
.إنّها قصّة غريبة

67
00:05:11,400 --> 00:05:14,070
.أنا لا أعرف السّيّد ريتشناندي على الإطلاق

68
00:05:14,070 --> 00:05:17,070
.لا فكرة لي لماذا دُعيت

69
00:05:17,070 --> 00:05:20,120
.ناروهودو-كُن، أنت لست شخصًا بتلك الأهمّيّة

70
00:05:21,090 --> 00:05:23,960
!على أيّ حال، لنكتشف المكان

71
00:05:25,960 --> 00:05:27,800
!هيّا، هيّا

72
00:05:34,360 --> 00:05:35,060
.المعذرة

73
00:05:35,060 --> 00:05:37,280
أين هي غرفة الأقحوان؟

74
00:05:37,280 --> 00:05:38,400
.سأصطحبك إليها إن سمحت

75
00:05:40,730 --> 00:05:41,940
.لم أرك منذ مدّة

76
00:05:42,690 --> 00:05:43,570
أنت هنا أيضًا؟

77
00:05:44,130 --> 00:05:45,380
ستغادران الغرفة؟

78
00:05:45,380 --> 00:05:46,890
!سنكتشف القطار

79
00:05:46,890 --> 00:05:48,450
.استمتعا بوقتكما

80
00:05:50,010 --> 00:05:51,290
.ها هي ذي يا سيّدي

81
00:05:51,290 --> 00:05:52,160
.شكرًا لك

82
00:06:02,120 --> 00:06:03,920
.نشر قوّات طارئ

83
00:06:03,920 --> 00:06:07,170
لم يُعثر بعد على الهارب
.الّذي فرّ بمجرّد أن هبطت الطّائرة

84
00:06:07,510 --> 00:06:10,470
.قوموا بمحاصرة أيّ نظام نقل في المنطقة

85
00:06:10,470 --> 00:06:15,800
،العثور على الهارب له الأولويّة
.لكن احرصوا على سلامة المواطنين

86
00:06:17,750 --> 00:06:20,310
.هذا سيّئ. هنالك عاصفة قادمة اللّيلة

87
00:06:20,310 --> 00:06:24,130
.ستغرب الشّمس قريبًا أيضًا
.من المستحيل أن نجده

88
00:06:24,130 --> 00:06:26,400
.قد ينتهي المطاف بهذا كمشكلة دبلوماسيّة

89
00:06:26,900 --> 00:06:29,190
نحن قرب مقطورة العشاء، صحيح؟

90
00:06:29,190 --> 00:06:30,770
.من الجيّد أنّها قريبة

91
00:06:33,240 --> 00:06:36,670
!إنّها فخمة لدرجة قد تدفعني للبكاء

92
00:06:36,670 --> 00:06:37,790
.لم يتمّ إعلامي بهذا

93
00:06:37,790 --> 00:06:39,050
.آسفة، لا نستطيع

94
00:06:39,050 --> 00:06:42,320
،لكنّه طلب من أحد المسافرين

95
00:06:42,320 --> 00:06:45,090
.وقد أخبرنا ريتشناندي-ساما أن نلبّي كلّ طلباته

96
00:06:45,090 --> 00:06:46,130
هذا ما قاله الملك؟

97
00:06:48,850 --> 00:06:49,760
.حسنًا إذًا

98
00:06:50,200 --> 00:06:51,570
.من هنا رجاءً

99
00:06:52,680 --> 00:06:55,050
أهنالك مشاكل؟

100
00:06:58,360 --> 00:07:00,500
!سنغادر

101
00:07:22,430 --> 00:07:26,920
كان الغروب جميلاً، أليس كذلك يا ناروهودو-كُن؟

102
00:07:28,270 --> 00:07:33,090
بعد أن تلقّيت الدّعوة، حاولت أن أعرف
.أشياءً عن السّيّد هابلي ريتشناندي

103
00:07:33,450 --> 00:07:36,810
،عندما حصل على الجنسيّة اليابانيّة
،وبما أنّه مليونير مشهور

104
00:07:36,810 --> 00:07:41,140
،واشترى سكّة حديديّة بأكملها
.وصلت أخباره إليّ أنا أيضًا

105
00:07:44,740 --> 00:07:46,060
ما هذا؟

106
00:07:46,060 --> 00:07:47,570
.إنّها دمية ساموراي فولاذيّ مرحّبة

107
00:07:47,570 --> 00:07:49,490
مرحّبة؟

108
00:07:50,070 --> 00:07:52,660
.صدّق أو لا، إنّها جهاز استقبال

109
00:07:52,660 --> 00:07:53,860
.لنلعب بهما

110
00:07:53,860 --> 00:07:56,630
ما الّذي يمكننا فعله بأجهزة استقبال من الأساس؟

111
00:07:56,630 --> 00:07:58,080
أليس هذا واضحًا؟

112
00:07:58,080 --> 00:08:00,000
.نلعب لعبة فرقة القنابل

113
00:08:00,000 --> 00:08:01,500
فـ-فرقة القنابل؟

114
00:08:02,170 --> 00:08:05,090
تونغاري، هل حدّدتم مكان القنبلة؟

115
00:08:05,090 --> 00:08:05,500
.حوّل

116
00:08:05,500 --> 00:08:07,210
!نعم، وجدناها

117
00:08:07,210 --> 00:08:10,590
!لديها سلك أحمر وسلك أخضر

118
00:08:10,590 --> 00:08:12,790
!سُحقًا! هذا مزعج

119
00:08:12,790 --> 00:08:15,690
!قصّوهما كليهما

120
00:08:18,740 --> 00:08:19,840
ما كان هذا؟

121
00:08:19,840 --> 00:08:23,530
لا شيء يدلّ على مغامرة في قطار
!كالهاربين وتهديدات القنابل

122
00:08:23,530 --> 00:08:25,720
.أنت تشاهدين الكثير من الأفلام

123
00:08:27,350 --> 00:08:29,290
!أتيت لأمضي الوقت معكما

124
00:08:29,290 --> 00:08:30,900
!إيتونوكو-سان

125
00:08:30,900 --> 00:08:34,310
.ريجينا-سان، شكرًا على إحضاري إلى هنا

126
00:08:34,740 --> 00:08:36,130
.على الرّحب والسّعة

127
00:08:36,130 --> 00:08:37,490
.أستأذن الآن

128
00:08:43,010 --> 00:08:46,010
.بدأت العمليّة. يمكننا تأمين ملكنا

129
00:08:46,010 --> 00:08:48,690
...حسنًا. وأيضًا، في مقطورة العشاء قبل قليل

130
00:08:48,690 --> 00:08:49,590
.سمعت بذلك

131
00:08:50,440 --> 00:08:52,520
.إنّه طلب من مسافر قيّم

132
00:08:52,520 --> 00:08:54,630
،لم يكن ذلك ضمن خططنا
.لكن علينا تنفيذه رغم ذلك

133
00:08:55,330 --> 00:08:55,840
.مفهوم

134
00:08:56,190 --> 00:08:59,330
،لا تقلقي. إن احترمنا الخطّة
.فسيسير كلّ شيء على ما يرام

135
00:08:59,330 --> 00:09:00,100
.نعم

136
00:09:07,650 --> 00:09:09,470
هل يمكنني مساعدتك في شيء ما؟

137
00:09:09,470 --> 00:09:10,900
.أريد كوب سكوتش

138
00:09:11,460 --> 00:09:13,850
.بالتّأكيد. سأحضره في الحال

139
00:09:18,390 --> 00:09:19,910
كتاب عن القطارات؟

140
00:09:19,910 --> 00:09:22,450
.نعم. أردت توسيع معرفتي عن القطارات

141
00:09:23,060 --> 00:09:25,280
،كان في البداية خطّ سكّة حديديّة محليًّا قصيرًا

142
00:09:25,280 --> 00:09:29,460
.وقد كبر بشكل تدريجيّ لينقل المحلّيّين عبر البلاد

143
00:09:30,380 --> 00:09:31,820
.لكن هنالك المزيد

144
00:09:31,820 --> 00:09:35,310
.اسمعا. كفاكما حديثًا عن القطارات

145
00:09:35,310 --> 00:09:37,210
!لنلعب بهذه

146
00:09:38,010 --> 00:09:39,340
!دمية السّاموراي الفولاذيّ المرحّبة

147
00:09:39,340 --> 00:09:42,970
لكن ماذا يمكننا فعله بها؟

148
00:09:43,360 --> 00:09:45,110
أليس ذلك واضحًا؟

149
00:09:45,110 --> 00:09:47,350
.نلعب لعبة فرقة القنابل

150
00:09:47,350 --> 00:09:50,180
!هذا رائع

151
00:09:51,080 --> 00:09:55,790
لا شيء يدلّ على مغامرة في قطار
!كالهاربين وتهديدات القنابل

152
00:09:55,790 --> 00:09:58,320
!توقّعت أن تكون ملمًّا بهذا

153
00:10:02,570 --> 00:10:03,980
.معك القائد

154
00:10:03,980 --> 00:10:06,350
.أجب يا تونغاري

155
00:10:06,350 --> 00:10:07,120
.حوّل

156
00:10:07,470 --> 00:10:10,210
.أنا أتجوّل في المقطورة 2، مقطورة العشاء

157
00:10:11,850 --> 00:10:13,920
.وصلت للتّوّ للمقطورة 3

158
00:10:15,290 --> 00:10:17,720
.البدء في البحث عن القنبلة

159
00:10:17,720 --> 00:10:19,220
!أيّها الغبيّ

160
00:10:19,220 --> 00:10:22,680
!أرواح المسافرين بين أيدينا

161
00:10:23,080 --> 00:10:25,590
.أتوقّع نتائج عظيمة

162
00:10:26,040 --> 00:10:27,020
...عـ-عفوًا

163
00:10:27,370 --> 00:10:29,850
لماذا صرختِ قائلة "أيّها الغبيّ"؟

164
00:10:30,210 --> 00:10:32,280
.لا تركّز على التّفاصيل

165
00:10:32,280 --> 00:10:33,480
.حوّل

166
00:10:33,810 --> 00:10:35,280
.إنّهما ثنائيّ ممتاز

167
00:10:36,050 --> 00:10:37,240
!معك تونغاري

168
00:10:37,240 --> 00:10:38,860
!وجدتها

169
00:10:38,860 --> 00:10:40,820
.إنّها قنبلة خطيرة

170
00:10:40,820 --> 00:10:45,330
!لديها خمسة أسلاك! لم أرَ مثلها من قبل

171
00:10:45,330 --> 00:10:46,800
ماذا؟

172
00:10:46,800 --> 00:10:49,080
!سُحقًا! قصّها كلّها

173
00:10:49,080 --> 00:10:52,980
!ستنفجر هكذا بكلّ تأكيد أيّها القائد

174
00:10:52,980 --> 00:10:54,460
يا سيّدي؟

175
00:10:55,130 --> 00:10:56,690
ر-ريجينا-سان؟

176
00:10:56,690 --> 00:10:59,320
ما هذا الحديث عن وجود قنبلة؟

177
00:11:00,430 --> 00:11:02,810
.إنّها لعبة. كانت مجرّد لعبة

178
00:11:02,810 --> 00:11:05,140
.تحتاج القطارات الفاخرة إلى الغموض دائمًا

179
00:11:05,140 --> 00:11:06,900
...فـ-فهمت

180
00:11:07,540 --> 00:11:11,590
.سيبدأ عشاء مسافري المقطورة 3 في السّادسة مساءً

181
00:11:11,590 --> 00:11:13,900
.حسنًا، هكذا إذًا

182
00:11:13,900 --> 00:11:15,820
هنالك أوقات عشاء محدّدة؟

183
00:11:18,820 --> 00:11:21,780
.حسنًا، سأذهب لأتعشّى أوّلاً

184
00:11:27,880 --> 00:11:28,830
.أهلاً

185
00:11:29,480 --> 00:11:31,010
.رجاءً

186
00:11:31,010 --> 00:11:33,170
أحضرت مطرقتك معك أيضًا؟

187
00:11:34,680 --> 00:11:36,800
.أشعر أنّه ينقصني شيء ما بدونها

188
00:11:47,190 --> 00:11:48,810
تكاد السّاعة تبلغ الثّامنة؟

189
00:11:48,810 --> 00:11:51,590
هل تجهّز أنفسنا للعشاء؟

190
00:11:51,590 --> 00:11:52,390
!العشاء

191
00:12:16,200 --> 00:12:18,180
.هذه رحلة ممتازة

192
00:12:18,180 --> 00:12:19,760
.أشعر أنّني محظوظ

193
00:12:21,780 --> 00:12:22,800
ما الخطب؟

194
00:12:23,270 --> 00:12:26,130
.نسيت شيئًا في مقطورة العشاء

195
00:12:27,620 --> 00:12:29,560
!لذيذ جدًّا

196
00:12:29,560 --> 00:12:31,300
القاضي؟

197
00:12:31,300 --> 00:12:34,500
.ماذا؟ إنّه هو بالفعل

198
00:12:41,320 --> 00:12:42,860
ماذا يحدث؟

199
00:12:44,530 --> 00:12:46,200
!بدأ العرض

200
00:12:48,410 --> 00:12:52,520
.كلاّ. يا لها من عاصفة مفاجئة

201
00:12:53,380 --> 00:12:55,540
ما هذا؟ ماذا حدث؟

202
00:13:03,590 --> 00:13:06,090
!لا-لا بدّ أنّها روح إنسان ما

203
00:13:11,210 --> 00:13:13,030
توقّفنا؟

204
00:13:19,000 --> 00:13:20,730
ماذا الآن؟

205
00:13:37,420 --> 00:13:39,330
.نحن نتحرّك ثانية

206
00:13:40,090 --> 00:13:41,920
.لقد فاجأني ذلك

207
00:13:41,920 --> 00:13:44,050
المعذرة، هل أنت بخير؟

208
00:13:44,050 --> 00:13:48,290
.نعم. آسفة لأنّني أقلقتك

209
00:13:49,410 --> 00:13:51,370
ما كان ذلك؟

210
00:13:51,370 --> 00:13:53,480
...وما كانت تلك الرّوح

211
00:13:53,480 --> 00:13:54,440
.سيّدي

212
00:13:59,910 --> 00:14:00,690
.اصمت

213
00:14:01,850 --> 00:14:03,530
...أ-أنت

214
00:14:03,530 --> 00:14:06,870
.لقد استوليت على النّجم الفضّيّ

215
00:14:06,870 --> 00:14:07,780
!استوليت؟

216
00:14:12,980 --> 00:14:13,950
.سآخذ هذا

217
00:14:13,950 --> 00:14:17,050
.سنصادر كلّ أجهزة الاتّصال

218
00:14:17,050 --> 00:14:20,460
.لكن اطمئنّ، إنّنا نضمن سلامتك

219
00:14:21,290 --> 00:14:22,820
مهلاً، ما هذا؟

220
00:14:24,290 --> 00:14:25,720
.ادخل رجاءً

221
00:14:29,490 --> 00:14:31,180
.هذه مشكلة كبيرة

222
00:14:31,680 --> 00:14:37,020
،القاضي في مقطورة العشاء
وذلكما الاثنان أيضًا. هل هم بخير؟

223
00:14:46,190 --> 00:14:50,090
،أنا كبير عائلة ريتشناندي من جمهوريّة ناريكين

224
00:14:50,090 --> 00:14:52,390
.هابلي ريتشناندي

225
00:14:52,390 --> 00:14:54,530
.أنا مالك النّجم الفضّيّ هذا

226
00:14:54,850 --> 00:14:56,120
...ريتشناندي

227
00:14:56,120 --> 00:14:59,410
.أعتذر بشدّة على إخافتكم

228
00:14:59,410 --> 00:15:04,790
.الغرض من هذه الأسلحة ليس إشعاركم بالخوف

229
00:15:04,790 --> 00:15:08,300
.إنّها رمز لتصميمي نحو على ما نوشك أن نخوضه

230
00:15:08,300 --> 00:15:10,550
.أودّ منكم جميعًا أن تفهموا هذا

231
00:15:10,550 --> 00:15:12,220
تصميم؟

232
00:15:13,360 --> 00:15:16,170
.لنأخذ الأمر برويّة

233
00:15:16,170 --> 00:15:18,530
أوّلاً، نحتاج منكم جميعًا

234
00:15:19,230 --> 00:15:23,230
.أن تسلّمونا كلّ وأيّ وسائل تواصل تملكونها

235
00:15:25,860 --> 00:15:27,060
ما هذه؟

236
00:15:27,060 --> 00:15:28,690
.دمية السّاموراي الفولاذيّ المرحّبة

237
00:15:28,690 --> 00:15:30,270
مرحّبة"؟"

238
00:15:30,270 --> 00:15:31,970
.إنّها مجرّد دمية

239
00:15:31,970 --> 00:15:33,700
.اتركها

240
00:15:33,700 --> 00:15:36,950
.أظنّني أخبرتك ألا تُكره أحدًا على أيّ شيء

241
00:15:36,950 --> 00:15:38,920
.آسف يا سيّدي

242
00:15:38,920 --> 00:15:40,840
.أنا أعتذر على طيشه

243
00:15:40,840 --> 00:15:42,310
.لا-لا بأس

244
00:15:42,310 --> 00:15:44,330
هابلي ريتشناندي؟

245
00:15:44,330 --> 00:15:47,110
.مرّ وقت طويل يا سيّدتي

246
00:15:47,110 --> 00:15:51,970
أ-ألم يُحكم عليك بالموت في أمريكا؟

247
00:15:51,970 --> 00:15:53,730
!الموت؟

248
00:15:53,730 --> 00:15:54,920
.نعم

249
00:15:54,920 --> 00:16:00,770
.قبل سنة، حوكمت بتهمة القتل

250
00:16:00,770 --> 00:16:02,550
.وقد تمّت إدانتي

251
00:16:02,550 --> 00:16:04,790
لماذا أنت في اليابان إذًا؟

252
00:16:04,790 --> 00:16:07,730
.كان يتمّ نقلي إلى سجن يابانيّ

253
00:16:07,730 --> 00:16:11,960
.صحيح. لقد حصلت على الجنسيّة

254
00:16:11,960 --> 00:16:14,010
.أنت مواطن يابانيّ الآن

255
00:16:14,010 --> 00:16:15,490
.بالضّبط

256
00:16:15,490 --> 00:16:18,330
.ولهذا تمّ إحضاري لليابان

257
00:16:18,330 --> 00:16:23,210
هربت من المطار وها أنا الآن
.أقف أمامكم على متن النّجم الفضّي

258
00:16:23,210 --> 00:16:25,830
.كما خطّطت تمامًا

259
00:16:25,830 --> 00:16:28,090
كـ-كما خطّطت؟

260
00:16:28,090 --> 00:16:29,370
.نعم

261
00:16:29,370 --> 00:16:33,230
.قضيت وقتًا طويلاً أحضّر خطّة هروبي

262
00:16:33,230 --> 00:16:36,720
.وطبعًا ما كنت لأنجح وحدي

263
00:16:36,720 --> 00:16:40,220
.لكن وقف رفاقي الّذين أثق بهم إلى جانبي

264
00:16:40,220 --> 00:16:44,640
.جميعهم من جمهوريّة ناريكين

265
00:16:45,150 --> 00:16:47,320
إنّهم يؤمنون ببراءتي

266
00:16:47,320 --> 00:16:51,940
.وساعدوني بشتّى الطّرق أثناء هروبي وفراري إلى هنا

267
00:16:51,940 --> 00:16:53,990
.أشكرهم من أعماق قلبي

268
00:16:53,990 --> 00:16:57,620
.أي أنّهم شركاؤكم الشّرفاء في الجريمة

269
00:16:57,620 --> 00:16:59,420
لكن ما هي غايتك؟

270
00:16:59,420 --> 00:17:02,430
،حتّى ولو اختبأت في قطارك

271
00:17:02,430 --> 00:17:04,620
.فسيصل إلى وجهته عند صباح الغد

272
00:17:04,620 --> 00:17:07,460
.وستنتهي اللّعبة حينها

273
00:17:07,950 --> 00:17:10,340
.لديّ هدف واحد

274
00:17:10,340 --> 00:17:12,050
.إعادة المحاكمة

275
00:17:15,720 --> 00:17:18,990
ماذا؟ إعادة المحاكمة؟

276
00:17:18,990 --> 00:17:25,520
كلّ الأدلّة والشّهادات الّتي قُدّمت
!في المحاكمة قبل سنة كانت زائفة

277
00:17:25,520 --> 00:17:29,060
!أتيتُ إلى هنا لأثبت ذلك

278
00:17:29,060 --> 00:17:31,690
وكيف ستثبت ذلك؟

279
00:17:31,690 --> 00:17:34,780
.سيبدأ الأمر هنا والآن

280
00:17:34,780 --> 00:17:40,490
!ستتمّ محاكمتي ثانية

281
00:17:43,860 --> 00:17:47,570
.لكنّنا على متن قطار متحرّك

282
00:17:47,570 --> 00:17:50,210
ماذا يمكنك فعله هنا؟

283
00:17:50,210 --> 00:17:53,460
...يوجد في هذه المقطورة كلّ ما نحتاجه

284
00:17:53,460 --> 00:17:56,340
!بما في ذلك المحكمة وكلّ الشهود

285
00:18:06,640 --> 00:18:11,650
.لهذا دعوتكم جميعًا

286
00:18:15,060 --> 00:18:17,610
.لدينا قنبلة مؤقّتة فعليّة الآن

287
00:18:25,700 --> 00:18:29,090
.عد إلى الدّاخل رجاءً

288
00:18:30,590 --> 00:18:34,620
ماذا تعني بقول إنّ كلّ الشّهود هنا؟

289
00:18:34,620 --> 00:18:40,920
كلّ من دعوتهم للسّفر في المقطورة 1
.لهم علاقة بتلك القضيّة

290
00:18:40,920 --> 00:18:43,640
أليس ذلك صحيحًا؟

291
00:18:44,720 --> 00:18:46,720
لكن ماذا عن محاميك؟

292
00:18:46,720 --> 00:18:48,980
.لديّ واحد بالطّبع

293
00:18:48,980 --> 00:18:52,480
!إنّه أنت يا سيّد ناروهودو

294
00:18:52,480 --> 00:18:56,950
.دعوتك إلى هنا تقديرًا لمواهبك

295
00:18:56,950 --> 00:18:58,530
من هو المدّعي العامّ إذًا؟

296
00:18:59,700 --> 00:19:01,800
.أفترض أنّه أنا

297
00:19:01,800 --> 00:19:03,950
.بالضّبط يا سيّد سايغا

298
00:19:03,950 --> 00:19:06,040
سايغا؟

299
00:19:06,040 --> 00:19:10,750
أنا سايغا يوسابورو من مكتب
.الادّعاء العامّ للولايات المتّحدة

300
00:19:11,370 --> 00:19:12,900
من هناك؟

301
00:19:15,920 --> 00:19:17,530
!القاضي

302
00:19:17,530 --> 00:19:19,090
!كنتَ هناك إذًا

303
00:19:19,090 --> 00:19:21,050
قاضي؟

304
00:19:21,050 --> 00:19:25,010
.لاحظت أنّني تركت مطرقتي هنا سابقًا

305
00:19:25,010 --> 00:19:28,520
،إن كنت أعرف أنّ مآلي سينتهي هنا
!أتمنّى لو لم أدرك ذلك أبدًا

306
00:19:28,520 --> 00:19:30,570
.هذا مناسب تمامًا

307
00:19:30,570 --> 00:19:34,230
نحن محظوظون لوجود قاض
.حقيقيّ ليترأس المحاكمة

308
00:19:34,230 --> 00:19:36,150
.أرجو منك القيام بذلك

309
00:19:36,150 --> 00:19:39,610
.ماذا؟ حـ... حسنًا

310
00:19:39,610 --> 00:19:44,490
لكن ما الّذي ستجنيه من إقامتك
لمحاكمة إجباريّة هنا؟

311
00:19:44,490 --> 00:19:48,410
.ستُبثّ هذه المحاكمة بأكملها في مكان معيّن

312
00:19:48,410 --> 00:19:53,500
!في النّهاية، أريد أن أظهر الحقيقة لهم

313
00:19:53,500 --> 00:19:55,000
في النّهاية"؟"

314
00:19:55,000 --> 00:19:59,740
يفترض أن يصل النّجم الفضّيّ
،إلى وجهته عند السّابعة صباحًا

315
00:19:59,740 --> 00:20:01,820
.ومعه أوّل شروق شمس للسّنة الجديدة

316
00:20:01,820 --> 00:20:04,510
.أودّ أن أكشف عن الحقيقة حينها

317
00:20:04,820 --> 00:20:09,390
وماذا إن تمّت إدانتك في هذه المحاكمة أيضًا؟

318
00:20:10,980 --> 00:20:13,220
.سأقبل بذلك الحكم إذًا

319
00:20:13,220 --> 00:20:15,360
،ولكن، لن يحدث ذلك

320
00:20:15,360 --> 00:20:19,360
!وهذا ما دمتم ستقيمون محاكمة عادلة منصفة

321
00:20:20,750 --> 00:20:23,580
.لا يقترف نظام عدالتنا الأخطاء

322
00:20:24,060 --> 00:20:25,070
.مفهوم

323
00:20:25,760 --> 00:20:27,620
.سأدافع عنك

324
00:20:28,690 --> 00:20:32,040
!أنا ممتنّ لك يا سيّد ناروهودو

325
00:20:32,040 --> 00:20:33,250
.أعطني عشرين دقيقة

326
00:20:33,250 --> 00:20:34,710
.أحتاج لأجهّز نفسي

327
00:20:38,040 --> 00:20:40,310
.لحظة، المعذرة

328
00:20:40,310 --> 00:20:42,370
.يبدو أنّني بالغت في الأكل

329
00:20:42,370 --> 00:20:44,130
هل يمكنني الذّهاب للحمّام؟

330
00:20:44,130 --> 00:20:44,970
.طبعًا

331
00:20:44,970 --> 00:20:46,010
!شكرًا لك

332
00:20:50,800 --> 00:20:52,530
.إيتونوكو-سان

333
00:20:53,490 --> 00:20:55,390
!إيتونوكو-سان

334
00:20:57,490 --> 00:21:00,230
معك إيتونوكوغيري. هل أنت بخير؟

335
00:21:02,030 --> 00:21:03,190
.نعم

336
00:21:03,190 --> 00:21:05,080
.هذه هي القصّة بالكامل

337
00:21:05,080 --> 00:21:07,530
!ساعد ناروهودو-كُن رجاءً

338
00:21:07,530 --> 00:21:09,200
.مفهوم

339
00:21:09,200 --> 00:21:13,830
.أنا في المقطورة 3 الآن
.مقطورة العشاء هي المقطورة المجاورة

340
00:21:13,830 --> 00:21:15,420
.سأرى إن أمكنني الدّخول إليها

341
00:21:21,330 --> 00:21:22,740
!مهلاً

342
00:21:27,180 --> 00:21:28,640
!هل أنت جادّة؟

343
00:21:33,930 --> 00:21:35,890
...ما... ما... ما

344
00:21:35,890 --> 00:21:38,860
!ما هذا؟

345
00:21:38,860 --> 00:21:42,320
!أين مقطورة العشاء؟

346
00:21:42,320 --> 00:21:47,500
!أين ذهبت المقطورة 1؟

347
00:23:20,540 --> 00:23:21,830
!أعترض

348
00:23:21,830 --> 00:23:26,230
هل الهارب هابلي ريتشناندي بريء فعلاً؟

349
00:23:26,230 --> 00:23:29,560
سايغا هو المدّعي العامّ الّذي
.سيواجهني أنا محامي الدّفاع

350
00:23:29,560 --> 00:23:34,020
.إنّه يقدّم دليلاً تلو الآخر يثبت إدانة ريتشناندي

351
00:23:34,020 --> 00:23:34,890
،والأسوأ من ذلك

352
00:23:34,890 --> 00:23:38,770
تمّ العثور على شاهد أساسيّ
.مقتول على متن القطار

353
00:23:39,350 --> 00:23:41,460
من القاتل؟

354
00:23:41,460 --> 00:23:42,690
!سأعثر على المتناقضات

355
00:23:42,690 --> 00:23:43,970
!وأكتشف الحقيقة

356
00:23:43,970 --> 00:23:47,840
الحلقة القادمة: "تغيّر أحداث القطار
!"المتّجه شمالاً، المحاكمة الثّانية

357
00:23:47,840 --> 00:23:49,140
!خذ هذه