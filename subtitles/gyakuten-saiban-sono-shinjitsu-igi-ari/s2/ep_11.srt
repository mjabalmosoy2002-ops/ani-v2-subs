1
00:00:03,960 --> 00:00:06,660
.في 31 ديسمبر، عشيّة رأس السّنة

2
00:00:07,080 --> 00:00:12,150
دُعيت للذّهاب في الرّحلة الأولى للقطار
."السّريع المميّز المسّمى "النّجم الفضّيّ

3
00:00:12,500 --> 00:00:14,930
.لقد جعلناكم تنتظرون كثيرًا

4
00:00:14,930 --> 00:00:20,350
اليوم هو اليوم الّذي سينطلق فيه القطار
.السّريع الفاخر المسمّى النّجم الفضّيّ

5
00:00:20,350 --> 00:00:24,670
المليونير من جمهوريّة ناريكين
،المحبّ جدًّا لليابان والسّكك الحديديّة

6
00:00:24,670 --> 00:00:30,070
هابلي ريتشناندي، قد منح من ماله الخاصّ
.لتحقيق حلم خطّ سكّة حديد خاصّ

7
00:00:30,070 --> 00:00:32,420
.إنّه النّجم الفضّيّ

8
00:00:32,810 --> 00:00:38,070
لسوء الحظّ، لم يستطع السّيّد ريتشناندي
،التّواجد معنا اليوم

9
00:00:38,070 --> 00:00:41,750
.لكن رغم ذلك، سننطلق في وقت وشيك

10
00:00:41,750 --> 00:00:43,680
أليس رائعًا؟

11
00:00:43,680 --> 00:00:45,930
.لقد بنوه كقطار بخاريّ عمدًا

12
00:00:45,930 --> 00:00:47,790
.يُشعر هذا بالخنين

13
00:00:47,790 --> 00:00:49,360
.تقصدين الحنين

14
00:00:53,410 --> 00:00:54,850
.حسنًا

15
00:00:54,850 --> 00:00:56,710
.لنصعد يا ناروهودو-كُن

16
00:00:56,710 --> 00:00:58,740
!ماذا؟ أنتما هنا

17
00:00:59,330 --> 00:01:00,970
المحقّق إيتونوكو؟

18
00:01:00,970 --> 00:01:02,870
!والقاضي أيضًا

19
00:01:02,870 --> 00:01:04,290
.مرحبًا بكما

20
00:01:04,690 --> 00:01:07,250
.لقد دخلنا مسابقة البطاقات البريديّة وفزنا

21
00:01:07,250 --> 00:01:11,920
أنا ذاهب في رحلة إلى الينابيع السّاخنة
.في الشّمال على متن قطار بخاريّ

22
00:01:11,920 --> 00:01:13,270
!انظرا

23
00:01:13,270 --> 00:01:16,380
!أمّا نحن فقد دُعينا

24
00:01:16,850 --> 00:01:19,030
!سوف نغادر

25
00:01:27,490 --> 00:01:30,730
ووسط رحلتنا على القطار الفاخر
،المسمّى النّجم الفضّيّ

26
00:01:30,730 --> 00:01:36,200
تمّت السّيطرة على القطار على يد
الهارب هابلي ريتشناندي

27
00:01:36,200 --> 00:01:37,030
ومطالبه؟

28
00:01:37,530 --> 00:01:43,370
إعادة محاكمة قضيّة قتل تمّت
.إدانته فيها قبل سنة في أمريكا

29
00:01:43,370 --> 00:01:46,390
،اتّصلت مايوي-تشان بالمحقّق إيتونوكو للمساعدة

30
00:01:46,390 --> 00:01:50,420
لكن اتّضح أنّ المقطورة الّتي كنّا
.فيها قد اختفت بلا أثر

31
00:01:50,900 --> 00:01:54,810
والآن، تحوّل النّجم الفضّيّ
،إلى محكمة على سكّة حديديّة

32
00:01:54,810 --> 00:01:57,380
.كاشفًا السّتار على محاكمة لم يسبق لها مثيل

33
00:03:36,650 --> 00:03:43,030
افتُتحت الآن جلسة محاكمة
!الهارب هابلي ريتشناندي

34
00:03:44,490 --> 00:03:46,140
هل أنت بخير يا مايوي-تشان؟

35
00:03:46,140 --> 00:03:49,050
.نعم، لقد أعلمتُ إيتونوكو-سان بما يجري هنا

36
00:03:50,290 --> 00:03:54,680
،أيّها المدّعي العام سايغا
.أدلِ بمرافعتك الافتتاحيّة رجاءً

37
00:03:57,110 --> 00:03:59,000
.دعوني أوضّح موقفي تمامًا

38
00:03:59,700 --> 00:04:01,930
.نظام الولايات المتّحدة القضائيّ مثاليّ

39
00:04:01,930 --> 00:04:04,260
.إعادة المحاكمة هذه مضيعة للوقت فحسب

40
00:04:05,720 --> 00:04:07,430
،إن كان ذلك صحيحًا

41
00:04:07,430 --> 00:04:11,480
.ما كنتُ لألجأ إلى هذه الإجراءات القصوى

42
00:04:12,180 --> 00:04:16,610
.المعذرة. نحن لا نعرف أيّ شيء عن هذه القضيّة

43
00:04:17,230 --> 00:04:19,320
.ذلك صحيح تمامًا

44
00:04:21,730 --> 00:04:24,440
،لم أكن المدّعي العامّ لهذه القضيّة

45
00:04:24,440 --> 00:04:27,840
لكن بصفتي عضوًا في مكتب
،وكيل وزارة العمل الأمريكيّة

46
00:04:27,840 --> 00:04:31,140
.فلديّ قاعدة بيانات عن قضايا مهمّة معي دائمًا

47
00:04:31,910 --> 00:04:33,210
.سأقوم بإعلامكم عنها

48
00:04:33,890 --> 00:04:38,600
قبل سنة، في مراسم ختام السّنة
،لاتّحاد التّجارة الأمريكيّ

49
00:04:38,600 --> 00:04:41,550
.قُتل أمينه العامّ إندول كانيسكي

50
00:04:42,680 --> 00:04:46,850
رأى السّيّد كانيسكي قوّة
جمهوريّة ناريكين الماليّة كتهديد

51
00:04:46,850 --> 00:04:49,720
.وكان يحاول تخليص الاقتصاد الأمريكيّ منها

52
00:04:51,250 --> 00:04:54,180
رفض المدّعى عليه هابلي ريتشناندي ذلك

53
00:04:56,370 --> 00:04:59,700
.ممّا أدّى إلى وقوع الحادثة خلال المراسم

54
00:05:05,380 --> 00:05:07,990
.كان الضّحيّة واقفًا هنا

55
00:05:08,450 --> 00:05:11,140
.مُنح شرف إلقاء خطاب ختام السّنة

56
00:05:11,740 --> 00:05:14,200
.ومن هنا تمّ إطلاق النّار عليه

57
00:05:15,620 --> 00:05:18,970
،وبمجرّد سماع الطّلق النّاري
نظر جميع من كان حاضرًا إلى ذلك الاتّجاه

58
00:05:18,970 --> 00:05:23,170
ووجدوا المدّعى عليه
.هابلي ريتشناندي واقفًا هناك

59
00:05:23,810 --> 00:05:27,290
.اعتقله شرطيّ كان قريبًا منه

60
00:05:27,290 --> 00:05:32,120
،وعند تفتيشه، عثروا على المسدّس معه
.سلاح الجريمة

61
00:05:32,570 --> 00:05:35,550
كانت فوهته ساخنة ممّا دلّ
،على أنّه قد استُعمل حديثًا

62
00:05:35,550 --> 00:05:37,730
.ولم يُعثر إلاّ على بصماته عليه

63
00:05:37,730 --> 00:05:40,270
!لم أكن أحمل أيّ مسدّس حينها

64
00:05:40,270 --> 00:05:45,040
عُثر على المسدّس في جيب
.معطف المدّعى عليه الدّاخليّ

65
00:05:45,040 --> 00:05:47,740
.هذه حقيقة واضحة وضوح الشّمس

66
00:05:49,010 --> 00:05:54,280
يبدو أنّ كلّ شيء يدلّ على
.إنّ المدّعى عليه مذنب

67
00:05:54,280 --> 00:05:55,160
.بالطّبع

68
00:05:55,850 --> 00:06:00,630
.لا عجب أنّ محكمة أمريكيّة قد وجدته مذنبًا

69
00:06:01,730 --> 00:06:04,900
أيّها الدّفاع؟ ماذا لديك لتضيفه؟

70
00:06:04,900 --> 00:06:07,810
.لديّ شكوكي بشأن المسدّس

71
00:06:07,810 --> 00:06:11,350
صحيح! قال ريتشناندي-سان أنّه لم
!يكن يحمل مسدّسًا

72
00:06:11,350 --> 00:06:15,080
نعم. من المستحيل أن أدخل واحدًا
.خلسة لمكان الحدث في كلّ الأحوال

73
00:06:15,080 --> 00:06:17,520
،بصفتك ضيف شرف للمراسم

74
00:06:17,520 --> 00:06:20,520
.تمّ إعفاؤك من التّفتيش الرّوتينيّ

75
00:06:21,110 --> 00:06:21,770
...إضافة لذلك

76
00:06:22,610 --> 00:06:26,440
لا شكّ أنّ سلاح الجريمة ذلك
.ينتمي للمدّعى عليه

77
00:06:26,440 --> 00:06:29,580
.وقد أثبتت أوراق تسجيله ذلك

78
00:06:29,580 --> 00:06:32,150
.صحيح، كان ذلك مسدّسي

79
00:06:32,150 --> 00:06:35,190
!ولكن... أجل! لا بدّ أنّ هنالك من سرقه

80
00:06:35,190 --> 00:06:36,950
!كانت الغاية هي تلفيق التّهمة لي

81
00:06:36,950 --> 00:06:38,210
هل لديك دليل؟

82
00:06:38,210 --> 00:06:39,460
...ذلـ

83
00:06:39,770 --> 00:06:40,890
...ذلك

84
00:06:43,130 --> 00:06:45,420
!إنّه يحاصرنا من كلّ جهة

85
00:06:45,420 --> 00:06:49,380
يبدو أنّه ما من داعٍ لإلغاء
.الحكم في نهاية المطاف

86
00:06:49,380 --> 00:06:51,010
.تمهّل لحظة

87
00:06:51,010 --> 00:06:53,640
!علينا سماع ما لدى الشّهود ليقولوه أوّلاً

88
00:06:54,710 --> 00:06:55,830
.يا إلهي

89
00:06:55,830 --> 00:06:58,020
.أنتم اليابانيّون لا تعرفون متى تستسلمون

90
00:06:58,330 --> 00:07:00,270
!أنت يابانيّ أيضًا

91
00:07:01,030 --> 00:07:04,470
كنت أحد الحاضرين خلال تلك المراسم، صحيح؟

92
00:07:04,470 --> 00:07:05,490
.نعم

93
00:07:05,490 --> 00:07:08,780
.أنا إدغار بيستون من مؤسّسة "كراي" الأمريكيّة

94
00:07:08,780 --> 00:07:11,130
.حتّى أصغر التّفاصيل ستفي بالغرض

95
00:07:11,130 --> 00:07:14,500
هل لاحظت أيّ شيء عند وقوع الحادثة؟

96
00:07:14,500 --> 00:07:16,960
،لقد ذكرتُ هذا قبل سنة

97
00:07:16,960 --> 00:07:21,110
لكنّ السّيّد كانيسكي توقّف عن إلقاء
.خطابه قبيل تعرّضه للطّلق النّاريّ

98
00:07:21,110 --> 00:07:23,210
.بدا شاردًا قليلاً بسبب شيء ما

99
00:07:23,210 --> 00:07:26,150
خطابه؟ لكن لماذا؟

100
00:07:26,150 --> 00:07:27,750
.الصّينيّة

101
00:07:28,130 --> 00:07:29,410
.لا بدّ أنّها الصّينيّة

102
00:07:29,410 --> 00:07:30,220
من أنت؟

103
00:07:30,570 --> 00:07:33,890
.أنا ألان سيليندر من المجلس

104
00:07:33,890 --> 00:07:38,560
لقد أوقع نادل صينيّة على الأرض
.أصدرت صوتًا عاليًا

105
00:07:39,540 --> 00:07:40,560
صينيّة؟

106
00:07:43,640 --> 00:07:45,970
،تشتّت انتباه السّيّد كانيسكي بسبب الصّوت

107
00:07:45,970 --> 00:07:47,450
...وبعد ذلك مباشرة

108
00:07:49,860 --> 00:07:53,960
.نعم، لقد أوقع نادل صينيّة أمامي

109
00:07:53,960 --> 00:07:56,100
.وانطلق الطّلق النّاريّ بعد ذلك مباشرة

110
00:07:56,100 --> 00:07:58,090
ما كان مصدر صوت الطّلق النّاريّ؟

111
00:07:58,090 --> 00:08:01,400
كان قريبًا جدًّا منّي لكنّني
.لا أدري تمامًا من أين صدر

112
00:08:01,400 --> 00:08:03,850
.صحيح، كنت قريبًا أيضًا

113
00:08:03,850 --> 00:08:07,640
من يوقع صينيّة في وقت كذاك؟

114
00:08:07,640 --> 00:08:10,550
.قال نادل في فندق خمس نجوم قال

115
00:08:10,930 --> 00:08:15,030
.حسنًا، يمكن تفهّم ذلك. لقد كان مصابًا

116
00:08:15,030 --> 00:08:17,330
مصابًا؟

117
00:08:17,330 --> 00:08:21,740
.كانت هنالك ضمادة على يده اليمنى
...لذلك السّبب كنتُ

118
00:08:21,740 --> 00:08:23,020
.هذا يكفي

119
00:08:23,020 --> 00:08:24,650
.لا علاقة للأمر بالجريمة

120
00:08:25,180 --> 00:08:29,590
.حسنًا، ما زلت لا أرى أيّ مشاكل في شهادتهما

121
00:08:29,590 --> 00:08:34,320
يبدو أنّ إعادة المحاكمة هذه
.ستنتهي قبل الفجر

122
00:08:34,320 --> 00:08:35,940
...ناروهودو-كُن

123
00:08:41,350 --> 00:08:43,530
...يا سيّد ريتشناندي-سان

124
00:08:43,530 --> 00:08:44,120
نعم؟

125
00:08:44,640 --> 00:08:47,510
كنتَ ضيف شرف المراسم، صحيح؟

126
00:08:47,510 --> 00:08:49,210
.نعم، هذا صحيح

127
00:08:49,210 --> 00:08:52,980
إذًا لماذا كنت تقف في ذلك
الرّكن البعيد من قاعة؟

128
00:08:52,980 --> 00:08:54,130
...ذلك بسبب

129
00:08:54,130 --> 00:08:56,190
.لا فائدة. كفّ عن المماطلة

130
00:08:56,190 --> 00:08:59,100
.كان هناك من أجلي

131
00:08:59,510 --> 00:09:01,180
السّيّدة بانتابرونو؟

132
00:09:01,180 --> 00:09:03,090
.ما زلتُ أتذكّر

133
00:09:03,090 --> 00:09:06,370
.كان السّيّد ريتشناندي لطيفًا جدًّا

134
00:09:06,370 --> 00:09:08,800
ماذا تعنين؟

135
00:09:08,800 --> 00:09:09,860
،في ذلك الوقت

136
00:09:09,860 --> 00:09:13,320
.كنت أستمع للخطاب

137
00:09:15,270 --> 00:09:16,280
!يا إلهي

138
00:09:16,280 --> 00:09:18,610
.سأحضر لك بعض المناديل

139
00:09:20,440 --> 00:09:23,620
كانت المناديل على الطّاولة
.في نهاية قاعة الولائم

140
00:09:24,040 --> 00:09:27,220
.لذلك السّبب كنت موجودًا هناك

141
00:09:27,220 --> 00:09:30,480
وحينها انطلق الطّلق النّاري؟

142
00:09:30,480 --> 00:09:34,690
.نعم. لقد جعلني الصّوت الرّهيب أفقد وعيي

143
00:09:34,690 --> 00:09:37,370
من قد يسكب مشروبًا على الضّيوف؟

144
00:09:37,370 --> 00:09:40,390
.قال نادل في فندق خمس نجوم قال

145
00:09:40,720 --> 00:09:43,850
.لكنّ يمكن تفهّم ذلك

146
00:09:44,190 --> 00:09:45,480
ماذا تقصدين؟

147
00:09:45,890 --> 00:09:50,450
.كان ذلك النّادل مصابًا في يده

148
00:09:50,450 --> 00:09:52,990
ماذا تقصدين بمصاب أيّتها الجدّة؟

149
00:09:52,990 --> 00:09:55,940
...كانت لديه ضمادة

150
00:09:55,940 --> 00:09:58,410
.على يده اليمنى

151
00:09:58,810 --> 00:10:01,620
نادل بضمادة على يده اليمنى؟

152
00:10:01,620 --> 00:10:03,580
.كما رأيت أنا أيضًا

153
00:10:04,890 --> 00:10:07,210
!كفانا من هذا الاستجواب العقيم

154
00:10:07,210 --> 00:10:07,960
!أعترض

155
00:10:10,880 --> 00:10:13,110
...نفس اليد ذات الضّمادة

156
00:10:13,110 --> 00:10:16,630
.ممّا يعني أنّ كلاهما رأى نفس النّادل

157
00:10:17,290 --> 00:10:19,640
.ذلك هو الافتراض الطّبيعيّ

158
00:10:19,640 --> 00:10:23,180
!وهذا يجعل تصرّفه مثيرًا للشّبهة

159
00:10:23,180 --> 00:10:26,100
،بعد أن سكب المشروب على السّيّدة بانتابرونو مباشرة

160
00:10:26,650 --> 00:10:31,610
،أوقع الصّينيّة أمام ريتشناندي-سان
.الّذي ذهب لإحضار المناديل

161
00:10:33,610 --> 00:10:37,840
.إنّ الأمر يبدو وكأنّه تبعه إلى هناك

162
00:10:37,840 --> 00:10:38,950
.معك حقّ

163
00:10:39,260 --> 00:10:43,950
،وبعد أن أوقع الصّينيّة مباشرة
،جذب انتباه الجميع إليه

164
00:10:43,950 --> 00:10:46,450
.وتمّ إطلاق النّار من نفس الجهة

165
00:10:48,290 --> 00:10:50,420
ما اسم هذا النّادل؟

166
00:10:52,790 --> 00:10:55,550
.حسب السّجلّ، فاسمه غيل

167
00:10:56,190 --> 00:10:57,050
!غيل-سان

168
00:10:57,590 --> 00:11:01,010
هل يعرف أيّ أحد هنا غيل-سان؟

169
00:11:01,690 --> 00:11:05,940
بالتّفكير في الأمر، كانت هنالك طاولة
.شاغرة خلال العشاء

170
00:11:05,940 --> 00:11:08,730
...صحيح، بعد أن ذكرت الأمر

171
00:11:11,440 --> 00:11:13,900
!مهلاً! لا أحد منكم يتحرّك

172
