1
00:00:00,470 --> 00:00:02,100
،طوال خمسة عشر عامًا

2
00:00:02,350 --> 00:00:04,600
.راودني حلم مرارًا وتكرارًا

3
00:00:05,770 --> 00:00:08,480
أجد نفسي في مكان مظلم
...وأواجه صعوبة في التّنفّس

4
00:00:09,860 --> 00:00:13,990
ثمّ أسمع طلقًا ناريًّا في النّهاية
.مصحوبًا بصرخة عالية

5
00:00:14,860 --> 00:00:17,490
صرخة تجمّد الدّم في العروق
.لا زلت أسمعها حتّى يومنا هذا

6
00:00:18,450 --> 00:00:19,740
".إنّه كابوس"

7
00:00:19,740 --> 00:00:22,200
.ذلك ما كنتُ أخبر نفسي به

8
00:00:22,200 --> 00:00:26,210
،لكنّ هايني لم يقتل والدي في الحقيقة

9
00:00:26,210 --> 00:00:29,000
.إنّ ذلك الكابوس يشير إلى حقيقة مريعة

10
00:00:29,750 --> 00:00:34,260
!في ذلك اليوم، كنتُ أنا من قتل والدي

11
00:00:39,470 --> 00:00:42,390
.أرغب بأخذ استراحة لربع ساعة

12
00:00:42,390 --> 00:00:46,190
وخلال هذا الوقت، سأفكّر بالطّريقة
!المناسبة للتّعامل مع هذا الوضع

13
00:02:30,040 --> 00:02:31,130
...أعتذر

14
00:02:31,130 --> 00:02:33,250
.لقد ضربتُ بكلّ جهودك عرض الحائط للتّوّ

15
00:02:41,930 --> 00:02:44,180
أيّها المدّعي العامّ ميتسوروغي؟

16
00:02:44,600 --> 00:02:47,890
هل تعرف لماذا أصبح ناروهودو-كُن محاميَ دفاع؟

17
00:02:49,640 --> 00:02:53,520
يبدو أنّ ذلك كان ليتمكّن من رؤيتك
.ثانية ويسألك عمّا حدث

18
00:02:53,520 --> 00:02:54,650
أنا؟

19
00:02:56,610 --> 00:03:01,570
أراد ميتسوروغي ريجي الّذي كنتُ أعرفه
.أن يصبح محاميَ دفاع كوالده

20
00:03:02,030 --> 00:03:04,870
.لكنّك أصبحتَ مدّعيًا عامًّا
.أردتُ معرفة السّبب

21
00:03:04,870 --> 00:03:06,490
...ناروهودو

22
00:03:10,410 --> 00:03:13,130
.كان أبي مصدر فخري وفرحتي

23
00:03:13,130 --> 00:03:17,550
لكنّه كان محامي دفاع أراد العدالة
.للمدّعى عليه والجاني معًا

24
00:03:17,550 --> 00:03:20,880
،لكن بعد أن قُتل والدي

25
00:03:20,880 --> 00:03:25,220
أجبر ناماكورا القاضي على تبرئة
،موكّله بطرق مشبوهة

26
00:03:25,220 --> 00:03:27,220
.وواجهت القضيّة طريقًا مسدودًا

27
00:03:27,640 --> 00:03:32,350
غيّر ذلك رأيي. بدأت أكره
.المجرمين ومحامو الدّفاع

28
00:03:34,060 --> 00:03:38,150
في ذلك الوقت، المدّعي العامّ كاروما
.كان الوحيد الّذي سأل عن أحوالي

29
00:03:38,150 --> 00:03:39,570
المدّعي العامّ كاروما؟

30
00:03:39,860 --> 00:03:44,280
لقد علّمني أنّ على العدالة
.أن تكون مثاليّة وقاسية القلب

31
00:03:44,620 --> 00:03:48,370
!وأن تكون مطرقة رحمة تطبّق على الجميع

32
00:03:48,370 --> 00:03:49,750
...مستحيل

33
00:03:49,750 --> 00:03:51,370
.اتّخذت قراري

34
00:03:52,000 --> 00:03:56,130
قرّرتُ أن أصبح مدّعيًا عامًّا وأدفع بأكبر
.عدد من المجرمين ليكفّروا عن جرائمهم

35
00:03:56,540 --> 00:03:58,130
،لكن ربّما

36
00:03:58,420 --> 00:04:03,180
فعلتُ ذلك ببساطة لأهرب
.من خطيئة اقترفتُها أنا بنفسي

37
00:04:03,180 --> 00:04:04,970
...أيّها المدّعي العامّ ميتسوروغي

38
00:04:05,890 --> 00:04:07,760
ملف القضيّة دي-إل-6

39
00:04:06,090 --> 00:04:07,470
ناروهودو-كُن؟

40
00:04:07,470 --> 00:04:08,760
.لا بأس

41
00:04:08,760 --> 00:04:12,850
.سأثبت براءة موكّلي بكلّ تأكيد

42
00:04:12,850 --> 00:04:15,190
!لكنّي اعترفت

43
00:04:15,190 --> 00:04:19,480
!اعترفتُ أنّني من قتل والدي ميتسوروغي شين

44
00:04:19,780 --> 00:04:23,490
.أنا آسف، لكنّي لا أؤمن بكابوسك

45
00:04:23,490 --> 00:04:25,240
ما-ماذا؟

46
00:04:25,240 --> 00:04:28,080
.أنا أؤمن ببراءتك

47
00:04:28,080 --> 00:04:32,870
!حتّى إن لم تؤمن بذلك بنفسك، فسأثبته لك

48
00:04:33,870 --> 00:04:35,370
!ناروهودو-كُن

49
00:04:37,830 --> 00:04:38,790
ما هذا؟

50
00:04:42,840 --> 00:04:45,050
.إذًا، أرغب أن نتابع محاكمتنا

51
00:04:45,050 --> 00:04:48,390
.لقد اعترف ميتسوروغي ريجي بذنبه

52
00:04:48,390 --> 00:04:52,180
.انطق بالحكم في الحال وخلّصه من عذابه

53
00:04:52,180 --> 00:04:55,020
.كلّ ما فعله المدّعى عليه هو مناقشة حلم يراوده

54
00:04:55,020 --> 00:04:57,270
!يملك الدّفاع الحقّ في استجوابه

55
00:04:57,520 --> 00:04:59,860
.يستطيع الدّفاع أن يبدأ في استجوابه

56
00:05:04,650 --> 00:05:07,530
،في يوم حادثة دي-إل-6 قبل خمسة عشر عامًا

57
00:05:07,530 --> 00:05:09,240
لماذا كنتَ في قاعة المحكمة؟

58
00:05:09,530 --> 00:05:12,490
.كنت هنا لأشاهد واحدة من محاكمات والدي

59
00:05:12,490 --> 00:05:14,250
وما الّذي تضمّنته تلك المحاكمة؟

60
00:05:14,660 --> 00:05:18,210
كلّ ما أتذكّره أنّه كان في مواجهة
.المدّعي العامّ كاروما

61
00:05:18,210 --> 00:05:21,170
بالفعل. وقد هُزم ميتسوروغي شين

62
00:05:21,170 --> 00:05:23,630
.أمام الادّعاء المثاليّ الّذي قدّمتُه

63
00:05:23,840 --> 00:05:26,050
،كان هنالك انقطاع هائل للكهرباء يومها

64
00:05:26,050 --> 00:05:28,720
.وحُجزتم أنتم الثّلاثة في المصعد

65
00:05:28,720 --> 00:05:31,810
.لم تصلنا المساعدة إلاّ بعد ساعات

66
00:05:31,810 --> 00:05:34,470
،بدأ الهواء في المصعد يقلّ بشكل تدريجيّ

67
00:05:34,470 --> 00:05:37,940
.فأُصيب هايني بالذّعر وهاجم والدي

68
00:05:37,940 --> 00:05:39,400
!اترك أبي

69
00:05:40,400 --> 00:05:43,110
.لا أذكر بشكل واضح ما حدث بعدها

70
00:05:43,110 --> 00:05:45,820
.سمعتُ طلقة ناريّة وصرخة عالية

71
00:05:46,450 --> 00:05:47,860
.ثمّ فقدت وعيي

72
00:05:47,860 --> 00:05:49,870
.وجدتُ نفسي في المستشفى عندما استعدتُ وعيي

73
00:05:49,870 --> 00:05:51,530
.لا مجال للشّكّ

74
00:05:51,870 --> 00:05:53,120
أهذا ما تظنّه؟

75
00:05:56,160 --> 00:05:58,080
.هذه صورة لساحة الجريمة

76
00:05:58,080 --> 00:06:01,880
.وهي تناقض تمامًا ما جاء في شهادة المدّعى عليه

77
00:06:02,250 --> 00:06:03,500
تُناقضها؟

78
00:06:03,960 --> 00:06:05,420
.أمعنوا النّظر رجاءً

79
00:06:05,960 --> 00:06:08,090
.هنالك ثقب رصاصة في الباب

80
00:06:08,090 --> 00:06:10,550
،قال الشّاهد أنّه كانت هنالك طلقة واحدة

81
00:06:10,550 --> 00:06:14,770
.لكنّ هذه الصّورة تظهر وجود ثقبين
.واحد في الجثّة وآخر في الباب

82
00:06:17,560 --> 00:06:22,610
كان بمقدور الرّصاصة الّتي قتلت الضّحيّة
.أن تخترق جسده وتصيب الباب

83
00:06:22,610 --> 00:06:23,900
.لا أظنّ ذلك

84
00:06:23,900 --> 00:06:24,690
ماذا؟

85
00:06:24,690 --> 00:06:26,530
.انظروا إلى تحليل السّلاح

86
00:06:27,190 --> 00:06:29,860
.إنّه يقول أنّ المسدّس أطلق رصاصتين

87
00:06:30,320 --> 00:06:33,490
إنّ الدّليل يناقض بالفعل ما جاء
!في شهادة ميتسوروغي

88
00:06:33,490 --> 00:06:37,870
لكن لا يوجد أيّ دليل يثبت أنّ الطّلقة الثّانية
.أُطلقت في ساعة الجريمة

89
00:06:37,870 --> 00:06:40,460
!تمّ إطلاق النّار من سلاح الجريمة مرّتين

90
00:06:40,750 --> 00:06:43,000
.وكان هنالك ثُقبا رصاصتين في ساحة الجريمة

91
00:06:43,000 --> 00:06:45,340
.من الطّبيعيّ أن نفترض أنّ هذه الحقائق مترابطة

92
00:06:46,460 --> 00:06:47,300
.صحيح

93
00:06:47,300 --> 00:06:51,720
،المدّعى عليه الّذي كان طفلاً حينها
.فقد وعيه بعد الطّلقة الأولى

94
00:06:51,970 --> 00:06:54,430
.أُطلقت الطّلقة الثّانية بعد ذلك

95
00:06:54,430 --> 00:06:57,350
بعبارات أخرى، كان هنالك شخص
.آخر في ساحة الجريمة

96
00:06:57,350 --> 00:06:58,480
!القاتل الحقيقيّ

97
00:06:58,810 --> 00:07:00,310
القاتل الحقيقيّ؟

98
00:07:00,310 --> 00:07:01,440
!أعترض

99
00:07:01,440 --> 00:07:05,400
.لسوء الحظّ، يبدو أنّه قد غفلت عن شيء مهمّ

100
00:07:05,400 --> 00:07:06,400
ما هو؟

101
00:07:06,400 --> 00:07:08,110
.انظر إلى ملفّ القضيّة

102
00:07:08,110 --> 00:07:11,070
!لم يُعثر إلاّ على رصاصة واحدة في ساحة الجريمة

103
00:07:12,110 --> 00:07:15,870
إنّها الرّصاصة الّتي سلبت حياة الضّحيّة
.الّتي كانت داخل جسمه

104
00:07:15,870 --> 00:07:18,830
!لم يُعثر على رصاصة أخرى في ساحة الجريمة

105
00:07:18,830 --> 00:07:22,540
.هذا يعني أنّ الطّلقة الثّانية لم تحدث أبدًا

106
00:07:23,380 --> 00:07:25,880
.إذًا، ادّعاءاتك لا أساس لها

107
00:07:27,840 --> 00:07:30,010
،إن لم يتمّ إطلاق الطّلقة الثّانية

108
00:07:30,010 --> 00:07:31,800
!فكلّ تخميناتي ستكون بلا فائدة

109
00:07:31,800 --> 00:07:33,890
.يبدو أنّنا وصلنا إلى نهايتنا

110
00:07:33,890 --> 00:07:36,350
.دعني أسأل مرّة أخيرة

111
00:07:36,350 --> 00:07:40,980
أيّها المدّعى عليه، لقد رميتَ المسدّس
.بغرض إنقاذ والدك

112
00:07:40,980 --> 00:07:43,730
.لكنّ ذلك تسبّب في مأساة غير متوقّعة

113
00:07:43,730 --> 00:07:45,270
أهذا صحيح؟

114
00:07:45,270 --> 00:07:46,060
!مهلاً يا ميتسوروغي

115
00:07:46,060 --> 00:07:47,110
.بدون شكّ

116
00:07:49,480 --> 00:07:50,190
.جيّد جدًّا

117
00:07:50,190 --> 00:07:51,820
!بهذا ينتهي استجواب الشّاهد

118
00:07:53,030 --> 00:07:55,620
،أعلم أنّه يجب عليّ أن أقول أشياء كثيرة

119
00:07:55,620 --> 00:07:57,280
!لكنّي لا أجد الكلمات المناسبة

120
00:08:01,460 --> 00:08:02,830
.لا تستسلم

121
00:08:05,080 --> 00:08:07,630
.أنت على الطّريق الصّحيح

122
00:08:07,630 --> 00:08:10,510
كانت هنالك بالفعل رصاصة أخرى
.في ساحة الجريمة

123
00:08:10,760 --> 00:08:13,220
.اضحك يا ناروهودو-كُن

124
00:08:13,510 --> 00:08:17,930
يستطيع المحامي أن يضحك فقط
!في أوقات الشّدّة

125
00:08:18,970 --> 00:08:21,680
—سوف أنطق بالحكم في حقّ ميتسوروغي ريجي

126
00:08:21,680 --> 00:08:22,640
!أعترض

127
00:08:22,640 --> 00:08:26,020
لقد تمّ إطلاق طلقة ثانية بالفعل
!في ذلك اليوم في ساحة الجريمة

128
00:08:26,770 --> 00:08:27,480
!يكفي

129
00:08:27,940 --> 00:08:30,150
.لقد اختفت الرّصاصة الأخرى

130
00:08:30,150 --> 00:08:32,490
.وهنالك سبب وجيه واحد وراء ذلك

131
00:08:32,690 --> 00:08:33,990
وما هو؟

132
00:08:34,320 --> 00:08:36,160
!أخذ القاتل الرّصاصة من ساحة الجريمة

133
00:08:36,160 --> 00:08:37,410
.أعترض

134
00:08:37,410 --> 00:08:40,700
لماذا يقوم بشيء بلا فائدة كهذا؟

135
00:08:40,700 --> 00:08:42,000
...حسنًا

136
00:08:42,000 --> 00:08:44,920
.لا فائدة. لا أستطيع التّفكير في أيّ سبب لأخذها

137
00:08:44,920 --> 00:08:46,710
.غيّر طريقة تفكيرك

138
00:08:46,710 --> 00:08:47,460
تشيهيرو-سان؟

139
00:08:48,630 --> 00:08:51,130
.لا تسأل لماذا أخذ القاتل الرّصاصة

140
00:08:51,130 --> 00:08:53,220
.اسأل لماذا كان عليه أن يأخذها

141
00:08:53,220 --> 00:08:54,420
...فهمت

142
00:08:54,880 --> 00:08:58,390
!وجب على القاتل أخذ الرّصاصة لسبب وجيه

143
00:08:58,680 --> 00:09:00,060
ماذا؟

144
00:09:00,060 --> 00:09:03,270
!لقد أصابت الرّصاصة الأخرى القاتل

145
00:09:03,270 --> 00:09:05,270
أ-أصابت الرّصاصة الأخرى القاتل؟

146
00:09:05,270 --> 00:09:08,150
،إن أُصيب القاتل أيضًا في لحظة الجريمة

147
00:09:09,060 --> 00:09:11,230
.لوجب عليه حينها أن يأخذ الرّصاصة

148
00:09:11,230 --> 00:09:14,030
!لهذا السّبب لم يُعثر عليها في ساحة الجريمة

149
00:09:14,030 --> 00:09:15,240
!أعترض

150
00:09:15,240 --> 00:09:19,490
لا يوجد أيّ سجلّ يوضّح إصابة شخص
!آخر بطلق ناريّ في المحكمة يومها

151
00:09:19,780 --> 00:09:24,450
لا بدّ من وجود شخص آخر أُصيب
.وغادر المحكمة يومها

152
00:09:25,250 --> 00:09:27,790
.حتّى أنّه أخذ إجازة اليوم التّالي

153
00:09:28,000 --> 00:09:29,000
!مستحيل

154
00:09:31,130 --> 00:09:36,010
.بما أنّنا لا نملك مشتبهًا به، فعملنا انتهى هنا

155
00:09:36,630 --> 00:09:37,760
!أعترض

156
00:09:38,590 --> 00:09:41,720
.هنالك مشتبه به... مشتبه واحد لا ثاني له

157
00:09:43,470 --> 00:09:45,930
—لا تصغوا إليه! أسرع و

158
00:09:46,230 --> 00:09:47,390
!أيّها المدّعي العامّ كاروما

159
00:09:48,350 --> 00:09:52,360
قبل خمسة عشر عامًا، القاتل الّذي أُصيب
برصاصة قبل أن يقتل الضّحيّة

160
00:09:52,730 --> 00:09:54,610
...واختفى من ساحة الجريمة

161
00:09:54,610 --> 00:09:57,110
!هو أنت

162
00:10:00,410 --> 00:10:01,240
ماذا؟

163
00:10:09,290 --> 00:10:12,290
المدّعي العامّ كاروما قتل والد
المدّعي العامّ ميتسوروغي؟

164
00:10:12,290 --> 00:10:16,970
كيف تجرؤ؟ أتعتقد أنّك ستفلت بعد
تلفيقك لادّعاءات شنيعة كهذه؟

165
00:10:16,970 --> 00:10:18,510
.هذه هي الحقيقة

166
00:10:18,510 --> 00:10:24,850
،في ذلك اليوم قبل خمسة عشر عامًا
.واجهتَ ميتسوروغي شين في المحكمة

167
00:10:26,140 --> 00:10:29,140
.لكنّ نصرك لم يكن كاملاً

168
00:10:29,600 --> 00:10:32,060
.لقد قدّمتَ دليلاً مزيّفًا

169
00:10:32,060 --> 00:10:33,060
!هذه حماقة

170
00:10:33,060 --> 00:10:36,070
ما علاقة هذا بجريمة القتل؟

171
00:10:36,610 --> 00:10:39,400
.أنت مدّعٍ عامّ يسعى للكمال

172
00:10:39,990 --> 00:10:43,200
.ولكنّ ميتسوروغي شين قد لطّخ سجلّك

173
00:10:44,330 --> 00:10:46,700
!يمكن لهذا أن يكون هو دافع الجريمة

174
00:10:46,700 --> 00:10:50,250
أيّها القاضي، أوقفه عن تقديم المزيد
.من الاتّهامات الّتي لا أساس لها

175
00:10:50,500 --> 00:10:52,080
سمعتُ أنّك أخذت إجازة؟

176
00:10:52,080 --> 00:10:54,000
ما-ماذا؟

177
00:10:54,000 --> 00:10:57,050
،اليوم الّذي يلي يوم مقتل ميتسوروغي شين

178
00:10:57,050 --> 00:11:00,800
أخذتَ فيه إجازة ليوم واحد طوال مسيرتك
.المهنيّة الّتي دامت أربعين سنة

179
00:11:02,090 --> 00:11:05,760
أليس من الطّبيعيّ أن يكون
في حالة صدمة جرّاء الجريمة؟

180
00:11:05,760 --> 00:11:07,680
.ربّما

181
00:11:07,680 --> 00:11:11,770
.لكن ربّما أُجبر على أخذ الإجازة ذلك اليوم

182
00:11:12,810 --> 00:11:16,980
مثلاً، ليقوم باستخراج الرّصاصة
!الّتي أصابته أثناء الجريمة

183
00:11:17,230 --> 00:11:22,610
لكنّ فترة النّقاهة بعد عملية استخراج
.الرّصاصة من المستحيل أن تكون يومًا واحدًا

184
00:11:24,240 --> 00:11:26,410
...إن كانت الجراحة بعيدة عن الحسبان

185
00:11:28,580 --> 00:11:30,790
.مايوي-تشان، أعيريني هذا

186
00:11:33,460 --> 00:11:35,090
أهذا جهاز كشف معادن؟

187
00:11:35,460 --> 00:11:36,710
.هذا صحيح

188
00:11:36,710 --> 00:11:40,590
!يطلب الدّفاع الإذن بفحص جسد المدّعي العامّ كاروما

189
00:11:41,550 --> 00:11:43,180
.هذا سخيف... أنا أرفض

190
00:11:43,180 --> 00:11:48,060
.لكن إن كنتَ بريئًا، فلن يكون لديك سبب لترفض

191
00:11:58,230 --> 00:11:58,980
!جيّد

192
00:12:00,490 --> 00:12:02,200
!يوضّح هذا كلّ شيء

193
00:12:02,200 --> 00:12:07,160
الرّصاصة الّتي أُطلقت قبل خمسة عشر عامًا
!لا تزال في كتف المدّعي العامّ كاروما

194
00:12:12,290 --> 00:12:15,500
.هنالك بالفعل رصاصة في كتفي

195
00:12:15,500 --> 00:12:17,380
...سأعترف بذلك

196
00:12:17,380 --> 00:12:20,550
.لكن لا علاقة لها بهذه الحادثة

197
00:12:20,800 --> 00:12:22,090
ماذا تعني؟

198
00:12:22,340 --> 00:12:25,340
قبل عدّة سنوات بينما كنتُ أفحص
،مسدّسًا كان سيُستخدم كدليل

199
00:12:25,340 --> 00:12:27,430
—أطلقت النّار على نفسي بالخطأ

200
00:12:27,430 --> 00:12:28,100
!أعترض

201
00:12:28,100 --> 00:12:29,180
!أكاذيب

202
00:12:29,180 --> 00:12:32,770
أُصبت بتلك الرّصاصة خلال حادثة القتل
!قبل خمسة عشر سنة

203
00:12:32,770 --> 00:12:34,520
أيمكنك إثبات ذلك؟

204
00:12:34,940 --> 00:12:36,150
.الأمر بسيط

205
00:12:36,150 --> 00:12:39,230
.علينا فقط أن نقارن تقرير فحص المقذوفات للرّصاصتين

206
00:12:40,730 --> 00:12:41,780
!اختفت الرّصاصة؟

207
00:12:43,490 --> 00:12:44,780
ما الأمر؟

208
00:12:45,160 --> 00:12:46,910
لقد تخلّص من التّقرير الجنائيّ؟

209
00:12:47,450 --> 00:12:50,030
.هذه هي نهاية أوهامك على ما أظنّ

210
00:12:51,660 --> 00:12:52,910
...ناروهودو

211
00:12:52,910 --> 00:12:55,920
!والآن، أنهِ هذه المحاكمة

212
00:12:56,290 --> 00:12:57,790
...حا-حاضر

213
00:12:58,080 --> 00:12:59,630
ما العمل؟

214
00:13:00,170 --> 00:13:01,340
ناروهودو-كُن؟

215
00:13:03,920 --> 00:13:04,920
ميتسوروغي؟

216
00:13:04,920 --> 00:13:06,130
أيّها المدّعي العامّ ميتسوروغي؟

217
00:13:04,920 --> 00:13:06,130
ميتسوروغي-سان؟

218
00:13:06,510 --> 00:13:08,220
!استدعوا المسعف

219
00:13:09,260 --> 00:13:11,470
ماذا؟ تظاهرت أنّك ستفقد وعيك؟

220
00:13:11,810 --> 00:13:14,230
.كانت تلك الطّريقة الوحيدة لإيقاف النّطق بالحكم

221
00:13:14,230 --> 00:13:16,480
...كان ذلك خطيرًا

222
00:13:16,480 --> 00:13:20,230
!كنتَ دائمًا شخصًا طائشًا نوعًا ما

223
00:13:20,230 --> 00:13:21,780
.لا تصفني بذلك

224
00:13:21,780 --> 00:13:23,030
.على أيّ حال، الوقت يداهمنا

225
00:13:23,030 --> 00:13:23,990
...أيّها المحقّق إيتونوكوغيري

226
00:13:23,990 --> 00:13:26,360
!حاضر! لا أسمع شيئًا

227
00:13:27,070 --> 00:13:30,530
إن كان التّقرير قد اختفى، بوسعنا
.القيام بشيء واحد لا غير

228
00:13:38,880 --> 00:13:41,250
...هذا هو مكتب المدّعي العامّ إذًا

229
00:13:41,250 --> 00:13:43,510
.نعم، ابقي قريبة

230
00:13:43,800 --> 00:13:45,970
سنتسلّل لمكتب كاروما؟

231
00:13:46,300 --> 00:13:49,640
إنّه يخفي دائمًا الدّلائل الّتي لا تصبّ
.في مصلحته في مكتبه

232
00:13:49,640 --> 00:13:51,260
...ميتسوروغي، أنت

233
00:13:51,890 --> 00:13:55,480
...إنّ سماعي لدفاعك جعلني أخيرًا أدرك أمرًا

234
00:13:55,890 --> 00:13:57,690
.أريد أن أؤمن بنفسي

235
00:13:58,390 --> 00:13:59,900
.سأذهب أنا

236
00:13:59,900 --> 00:14:00,770
مايوي-تشان؟

237
00:14:01,150 --> 00:14:03,650
.حسنًا. سأرافقك بعض الطّريق

238
00:14:04,070 --> 00:14:05,570
ماذا؟ ستأتي معي؟

239
00:14:05,940 --> 00:14:08,740
.يستطيع فقط المدّعون العامّون دخول المكتب

240
00:14:08,740 --> 00:14:10,740
.الأبواب محميّة بأداة تعريف ببصمةِ شبكيّةِ العين

241
00:14:10,740 --> 00:14:11,910
...يا-يا للعجب

242
00:14:12,330 --> 00:14:15,910
!لكنّك نجم هذه المحاكمة

243
00:14:15,910 --> 00:14:18,870
.سوف يغضبون بالفعل إن لم تكن حاضرًا

244
00:14:18,870 --> 00:14:20,630
.سأعود بعد عشر دقائق

245
00:14:20,630 --> 00:14:21,920
عشر دقائق؟

246
00:14:21,920 --> 00:14:23,960
.لكنّ الاستراحة تدوم خمس دقائق فحسب

247
00:14:23,960 --> 00:14:25,420
...خمسة دقائق

248
00:14:25,420 --> 00:14:28,340
...علينا أن نخدعهم بطريقة ما

249
00:14:30,010 --> 00:14:31,180
ماذا؟

250
00:14:33,300 --> 00:14:34,680
.تمّ منح الإذن

251
00:14:35,810 --> 00:14:39,100
.اترك الباقي لي وعد إلى قاعة المحاكمة

252
00:14:39,100 --> 00:14:41,100
.آسف لجعلي إيّاك تقومين بهذا

253
00:14:41,100 --> 00:14:42,020
.لا بأس

254
00:14:42,020 --> 00:14:43,650
!أريد أن أساعد أيضًا

255
00:14:45,020 --> 00:14:45,980
.هيّا أسرع

256
00:14:45,980 --> 00:14:47,570
.أنا قلقة بشأن ياهاري-سان

257
00:14:51,820 --> 00:14:53,780
.هذا أنا، ميتسوروغي ريجي

258
00:14:54,240 --> 00:14:55,200
من أنت؟

259
00:14:55,660 --> 00:14:56,950
من أنا؟

260
00:14:56,950 --> 00:14:59,960
.ميتسوروغي ريجي بالطّبع

261
00:15:00,250 --> 00:15:02,960
!يا حُجّاب المحكمة
!ألقوا بهذا المحتال إلى الخارج في الحال

262
00:15:02,960 --> 00:15:05,380
—مهلاً لحظة! أمعن النّظر وسترى أنّي

263
00:15:05,380 --> 00:15:06,840
.إنّ أمرك واضح تمامًا

264
00:15:07,210 --> 00:15:09,340
.كان عليّ أن أعرف أنّ الأمر لن ينجح

265
00:15:09,590 --> 00:15:13,470
هل سبق وسمعت بمصطلح "إهانة المحكمة"؟

266
00:15:13,470 --> 00:15:14,640
.بالطّبع سمعت به

267
00:15:14,640 --> 00:15:17,140
!إن اتّضح أنّك مذنب، فسوف تُعدم

268
00:15:17,970 --> 00:15:19,270
!يا ناروهودو

269
00:15:19,270 --> 00:15:22,810
!هل سأموت؟

270
00:15:21,140 --> 00:15:22,810
هل أنا في الجحيم؟

271
00:15:23,150 --> 00:15:24,730
...ها هي ذي

272
00:15:26,690 --> 00:15:27,730
!وجدته

273
00:15:30,360 --> 00:15:32,990
أيّها الدّفاع، هل لديك تفسير؟

274
00:15:32,990 --> 00:15:35,450
.يا سعادة القاضي، المدّعى عليه لا يشعر بتحسّن

275
00:15:35,450 --> 00:15:36,200
لقد هرب، صحيح؟

276
00:15:37,370 --> 00:15:40,160
!أغلقوا كلّ مخارج المحكمة

277
00:15:40,160 --> 00:15:41,870
!لن يكون ذلك ضروريًّا

278
00:15:43,460 --> 00:15:44,460
...ميتسوروغي

279
00:15:44,830 --> 00:15:47,210
.أعتذر على تأخّري

280
00:15:51,260 --> 00:15:54,090
.لقد عثرتُ على المتطفّل كما توقّع المدّعي العامّ كاروما

281
00:15:54,390 --> 00:15:56,510
.لقد ألقيتُ القبض عليها

282
00:15:58,100 --> 00:15:59,060
!مهلاً، انتظري

283
00:16:00,220 --> 00:16:04,980
لا يوجد دليل ليربط الرّصاصة
.الّتي في كتفي بحادثة دي-إل-6

284
00:16:05,360 --> 00:16:07,980
،آمل أنّك جاهز لسماع الحكم

285
00:16:07,980 --> 00:16:09,440
!يا ميتسوروغي ريجي

286
00:16:09,440 --> 00:16:13,150
ناروهودو-كُن، أرجّح أنّك لا تملك أيّ دليل جديد لتقدّمه؟

287
00:16:13,150 --> 00:16:14,950
...حـ-حسنًا

288
00:16:15,950 --> 00:16:18,620
—إذًا، سوف أنطق بالحكم هذه المرّة

289
00:16:18,620 --> 00:16:19,620
!أعترض

290
00:16:22,460 --> 00:16:23,500
!مايوي-تشان

291
00:16:25,960 --> 00:16:29,750
!دليل الدّفاع الجديد معي

292
00:16:31,130 --> 00:16:32,590
...مستحيل! كيف

293
00:16:32,970 --> 00:16:35,970
هذه هي الرّصاصة الّتي سلبت حياة
.والد المدّعي العامّ ميتسوروغي

294
00:16:36,390 --> 00:16:38,180
لقد عثرتُ عليها

295
00:16:38,180 --> 00:16:39,600
!مخبّأة في مكتبك

296
00:16:41,470 --> 00:16:44,310
...أ-أيّتها الحقيرة

297
00:16:44,310 --> 00:16:47,770
استخرجوا الرّصاصة الّتي في كتف
!المدّعي العامّ كاروما في الحال

298
00:16:47,770 --> 00:16:50,570
!وقارنوا تقرير المقذوفات للرّصاصتين

299
00:16:50,570 --> 00:16:56,780
إن تطابق التّقريران، فسيعني ذلك أنّهما
...قد أُطلقا من نفس المسدّس

300
00:16:56,780 --> 00:17:01,040
وسيُثبت ذلك أنّك كنتَ في ساحة الجريمة

301
00:17:01,040 --> 00:17:02,080
!بدون شكّ

302
00:17:04,040 --> 00:17:06,460
،ما الّذي لديك لتقوله

303
00:17:06,460 --> 00:17:07,290
!أيّها المدّعي العامّ كاروما؟

304
00:17:11,460 --> 00:17:12,960
...تلك هي الصّرخة الّتي سمعتُها

305
00:17:13,760 --> 00:17:14,920
!كنتَ أنت صاحبها

306
00:17:15,760 --> 00:17:17,680
،ميتسوروغي ريجي

307
00:17:17,680 --> 00:17:22,220
!أنت ووالدك شوكة في حلقي
!كيف تجرآن كلاكما على تحدّيّ؟

308
00:17:22,520 --> 00:17:25,270
.سوف يُطبّق عليك القانون

309
00:17:25,730 --> 00:17:26,980
.هذا كلّ ما هنالك

310
00:17:29,770 --> 00:17:32,190
،في ذلك اليوم قبل خمسة عشر سنة

311
00:17:32,190 --> 00:17:34,490
.كنتُ في غرفة سجلاّت المحكمة

312
00:17:35,190 --> 00:17:38,990
.توقّف المصعد عن العمل بسبب انقطاع الكهرباء

313
00:17:39,820 --> 00:17:40,830
...حينها

314
00:17:41,830 --> 00:17:43,450
.شعرتُ بألم فظيع في كتفي

315
00:17:44,000 --> 00:17:47,120
.وفُتح باب المصعد أمام عينيّ

316
00:17:47,790 --> 00:17:50,130
.رأيتُ ثلاثة أشخاص قد فقدوا الوعي بداخله

317
00:17:50,130 --> 00:17:52,840
،كان أحدهم هو ميتسوروغي شين

318
00:17:53,300 --> 00:17:56,010
.المحامي الّذي لطّخ سجلّي المثاليّ

319
00:17:56,880 --> 00:17:58,840
.ومسدّس أمام قدمي

320
00:17:59,340 --> 00:18:03,100
.عرفتُ أنّ ذلك كان قدري

321
00:18:05,310 --> 00:18:06,560
،أجل... لقد مات

322
00:18:06,560 --> 00:18:09,850
.دون أن يعرف من قتله

323
00:18:10,100 --> 00:18:14,230
لذلك السّبب قالت روحه أن هايني-سان
.من أطلق عليه النّار

324
00:18:14,230 --> 00:18:18,280
ربّما كان يحاول حماية ميتسوروغي
.الصّغير بصفته والده

325
00:18:19,610 --> 00:18:23,580
لم أتصوّر أبدًا أنّ رصاصة من الماضي
.ستخترقني للمرّة الثّانية

326
00:18:23,580 --> 00:18:25,290
أهذا من صنيع القدر أيضًا؟

327
00:18:25,790 --> 00:18:28,580
...لم تكن الرّصاصة ما سحقك

328
00:18:29,790 --> 00:18:31,330
!بل كانت الحقيقة

329
00:18:36,340 --> 00:18:37,420
!أيّها الحُجّاب

330
00:18:39,260 --> 00:18:41,510
!نجحنا يا تشيهيرو-سان

331
00:18:45,930 --> 00:18:47,600
!أنا مصدوم تمامًا

332
00:18:47,930 --> 00:18:50,560
!أنتما هما الأفضل بكلّ تأكيد

333
00:18:50,560 --> 00:18:54,400
!عرفتُ دائمًا أنّك بريء أيّها المدّعي العامّ ميتسوروغي

334
00:18:54,400 --> 00:18:56,030
!نجحنا يا ناروهودو-كُن

335
00:18:56,030 --> 00:18:57,110
!تهانيّ

336
00:18:57,110 --> 00:18:58,490
.وشكرًا لك

337
00:18:58,490 --> 00:19:00,280
.كان ذلك من أختي

338
00:19:00,660 --> 00:19:01,950
...مايوي-تشان

339
00:19:01,950 --> 00:19:03,030
...ناروهودو

340
00:19:08,000 --> 00:19:09,870
.انتهى الأمر أخيرًا يا ميتسوروغي

341
00:19:10,410 --> 00:19:12,630
...أنا ممتنّ لك

342
00:19:13,460 --> 00:19:15,590
.شكرًا لك على مساعدتك لي

343
00:19:18,420 --> 00:19:20,300
تبدو مهذّبًا اليوم؟

344
00:19:20,300 --> 00:19:21,760
...أحسنت

345
00:19:21,760 --> 00:19:24,260
.آمل أن أكون قد رددت لك الجميل بهذا

346
00:19:24,260 --> 00:19:24,970
رددت الجميل؟

347
00:19:24,970 --> 00:19:26,850
مهلاً، ماذا تقصدان؟

348
00:19:26,850 --> 00:19:28,430
!أنا أعرف

349
00:19:28,430 --> 00:19:30,140
قضيّة مال الغداء المسروق، صحيح؟

350
00:19:30,140 --> 00:19:31,140
قضيّة؟

351
00:19:31,140 --> 00:19:32,400
مال الغداء؟

352
00:19:32,850 --> 00:19:37,190
.لقد دافعتَ عنّي خلال محاكمة الفصل تلك

353
00:19:37,190 --> 00:19:40,190
.ذلك ما دفعني لأكون ما أنا عليه الآن
.لذلك السّبب أنا هنا اليوم

354
00:19:40,190 --> 00:19:41,570
...ناروهودو

355
00:19:41,570 --> 00:19:43,740
أتتذكّر هذه؟

356
00:19:43,740 --> 00:19:44,910
لا زلت تحتفظ بها؟

357
00:19:45,160 --> 00:19:46,030
.بالطّبع

358
00:19:46,030 --> 00:19:47,660
لا زلت تحتفظ بها أنت أيضًا، صحيح؟

359
00:19:47,910 --> 00:19:49,910
مـ-من يدري؟

360
00:19:50,450 --> 00:19:52,040
.لا فكرة لي أين هي

361
00:19:53,170 --> 00:19:55,290
.أتساءل من سرق مال الغداء

362
00:19:55,290 --> 00:19:56,630
...أريد أن أعرف أيضًا

363
00:19:58,750 --> 00:20:02,010
كان مال الغداء هو ثلاثة آلاف ينّ، صحيح؟

364
00:20:02,340 --> 00:20:04,010
كان أنت يا ياهاري-سان؟

365
00:20:04,010 --> 00:20:05,470
...أنت لم

366
00:20:05,890 --> 00:20:09,890
!ياهاري، كنتَ أنت؟

367
00:20:09,270 --> 00:20:11,850
!فـ-فهمت الأمر بشكل خاطئ

368
00:20:11,850 --> 00:20:14,150
!كان لدي ّسبب وجيه لِما فعلت

369
00:20:13,480 --> 00:20:15,270
!سوف أقاضيك وسأضعك في قاعة المحكمة

370
00:20:15,270 --> 00:20:17,820
سوف أصبح مدّعيًا عامًّا لأحرص
!تمام الحرص أن تُعاقب

371
00:20:17,820 --> 00:20:20,740
!إذًا ستُدافع أنت عنّي يا ميتسوروغي

372
00:20:20,740 --> 00:20:22,150
.أفترض أنّ لا خيار آخر أمامي

373
00:20:22,490 --> 00:20:25,110
.هيّا، لا تتقاتلا

374
00:20:22,490 --> 00:20:25,740
!أنت الضّحيّة! لماذا قد تدافع عن الجاني؟

375
00:20:25,740 --> 00:20:26,620
...مايوي

376
00:20:27,280 --> 00:20:29,580
.أحسنتِ صنعًا يا مايوي

377
00:20:31,870 --> 00:20:32,750
!أختي

378
00:20:37,630 --> 00:20:38,290
.شكرًا

379
00:20:38,290 --> 00:20:42,590
!أنا بريء، صدّقني

380
00:20:39,550 --> 00:20:42,590
!مرحى! سنحتفل هذه اللّيلة

381
00:20:42,590 --> 00:20:43,930
أليس كذلك؟

382
00:20:43,930 --> 00:20:44,550
!أجل

383
00:20:44,550 --> 00:20:45,970
!سنحتفل بالتّأكيد

384
00:20:51,220 --> 00:20:52,770
".صباح الخير يا ناروهودو-كُن"

385
00:20:53,180 --> 00:20:55,770
".كنتَ مثيرًا للإعجاب بالفعل البارحة"

386
00:20:55,770 --> 00:21:00,270
"...جعلتني مشاهدتك أدرك ما أقوم به هنا"

387
00:21:00,900 --> 00:21:03,950
".أنا أيضًا أردتُ مساعدة المدّعي العامّ ميتسوروغي"

388
00:21:03,950 --> 00:21:06,110
".أردتُ مساعدتك"

389
00:21:06,990 --> 00:21:09,200
".لكن لم أستطع"

390
00:21:09,870 --> 00:21:13,290
"،لذلك كبداية"

391
00:21:13,290 --> 00:21:15,750
".قرّرتُ أن أعود لأباشر تدريبي"

392
00:21:15,960 --> 00:21:19,670
اعتقدتُ أنّي لن أستطيع أن أقول لك هذا"
".وجهًا لوجه، لذلك تكبتُ هذه الرّسالة

393
00:21:20,420 --> 00:21:22,760
".مع السّلامة يا ناروهودو-كُن"

394
00:21:22,760 --> 00:21:23,920
!مايوي-تشان

395
00:21:25,260 --> 00:21:26,380
...ناروهودو-كُن

396
00:21:26,840 --> 00:21:28,550
لا أستطيع تغيير رأيك بالبقاء هنا؟

397
00:21:28,550 --> 00:21:29,300
.نعم

398
00:21:31,100 --> 00:21:34,310
.بدون مساعدتك، ما كنتُ لأنتقم لتشيهيرو-سان

399
00:21:37,520 --> 00:21:38,350
.شكرًا لك

400
00:21:39,480 --> 00:21:40,860
—ناروهودو-كُن، أنا

401
00:21:52,700 --> 00:21:53,700
...أنا واثق

402
00:21:54,450 --> 00:21:56,460
.أنا واثق أنّنا سنتقابل ثانية

403
00:21:56,960 --> 00:21:57,830
.يا مايوي-تشان

404
00:23:30,260 --> 00:23:31,630
!أعترض

405
00:23:31,630 --> 00:23:33,180
.دعوني أخبركم بقصّة ذلك اليوم

406
00:23:33,180 --> 00:23:35,930
.اليوم الموعود لنا، يوم محاكمة الفصل

407
00:23:36,430 --> 00:23:42,140
إنّها قصّة مغامرة جمعت بيني
.وبين ميتسوروغي وياهاري وجرو صغير

408
00:23:42,480 --> 00:23:46,360
.قصّة لقائنا وفراقنا المفاجئ بعد تلك الحادثة

409
00:23:46,360 --> 00:23:48,730
.كما أنّ قصّتنا تتقدّم في الحاضر أيضًا

410
00:23:49,190 --> 00:23:53,700
ميتسوروغي، هل ستتركنا ثانية؟

411
00:23:54,160 --> 00:23:54,910
!سأعثر على المتناقضات

412
00:23:54,910 --> 00:23:56,200
!وأكتشف الحقيقة

413
00:23:56,200 --> 00:23:58,120
!في الحلقة القادمة: تغيّر الوعد

414
00:23:58,120 --> 00:23:58,790
!خذ هذه