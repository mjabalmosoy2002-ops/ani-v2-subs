1
00:00:02,270 --> 00:00:05,600
!ما كان لبطل أن يقتل أيّ أحد

2
00:00:06,310 --> 00:00:08,940
،بما أنّي أملك فكرة عن هويّة الجاني

3
00:00:08,940 --> 00:00:11,150
!سأستعملها لكشف كلّ المتناقضات

4
00:01:46,000 --> 00:01:48,870
.سمعتُ أنّ مسلسل سامرواي الفولاذ سيُلغى

5
00:01:48,870 --> 00:01:51,090
!ماذا؟ مستحيل

6
00:01:56,720 --> 00:01:58,470
...هذ فظيع

7
00:01:58,470 --> 00:02:02,600
الأطفال في جميع أنحاء البلاد يحبّون
!المسلسل ويرغبون بمشاهدة المزيد

8
00:02:02,600 --> 00:02:03,890
.أنا آسف

9
00:02:04,310 --> 00:02:05,770
.إنّها غلطتي أنا

10
00:02:05,770 --> 00:02:07,890
.أنت لم تقترف أيّ خطأ

11
00:02:09,310 --> 00:02:12,520
!المُلام هو قاتل إيبوكورو-سان

12
00:02:18,780 --> 00:02:21,160
.افتُتحت الجلسة

13
00:02:21,160 --> 00:02:23,870
.الادّعاء جاهز يا سعادة القاضي

14
00:02:24,580 --> 00:02:26,700
.الدّفاع جاهز يا سعادة القاضي

15
00:02:27,370 --> 00:02:30,670
.قدّم شهادتك الافتتاحيّة أيّها المدّعي العامّ ميتسوروغي

16
00:02:32,710 --> 00:02:34,290
،خلال الجلسة الماضية

17
00:02:34,290 --> 00:02:38,840
عرفنا أنّه كان هنالك آخرون
.في الاستوديو يوم ارتكاب الجريمة

18
00:02:38,840 --> 00:02:42,760
واليوم، سنطلب منهم أن يشهدوا
.لترسيخ حقائق القضيّة

19
00:02:43,680 --> 00:02:48,060
،شاهدتنا كانت في اجتماع في مقطورة الاستوديو 2

20
00:02:48,060 --> 00:02:50,140
.المنتجة هيميغامي ساكورا

21
00:02:51,100 --> 00:02:53,230
.سوف ألحق بها

22
00:02:57,990 --> 00:03:02,990
عقدنا اجتماعًا في مقطورة
.الاستوديو 2 في ذلك اليوم

23
00:03:03,660 --> 00:03:05,030
.انتهى الاجتماع عند السّاعة الرّابعة مساءً

24
00:03:05,530 --> 00:03:07,490
،كان هنالك تدريب السّاعة الخامسة مساءً

25
00:03:07,490 --> 00:03:09,500
،لذلك ذهبنا إلى الاستوديو 1

26
00:03:09,500 --> 00:03:12,250
.حيث وجد العاملون جثّة إيبوكورو

27
00:03:13,420 --> 00:03:14,750
،بالمناسبة

28
00:03:14,750 --> 00:03:18,960
.قُدّر وقت الوفاة على السّاعة الثّانية والنّصف بعد الظّهر

29
00:03:18,960 --> 00:03:21,260
.أي عندما كنّا في الاجتماع

30
00:03:24,390 --> 00:03:26,890
،حسب أحد الحاضرين في الاجتماع

31
00:03:26,890 --> 00:03:30,680
أخذتِ استراحة دامت ربع ساعة حوالي
الثّانية والنّصف بعد الظّهر، صحيح؟

32
00:03:31,140 --> 00:03:31,890
.نعم

33
00:03:32,440 --> 00:03:34,060
.انظري إلى هذه الصّورة

34
00:03:35,110 --> 00:03:38,070
.لقد التُقطت قبل الجريمة

35
00:03:39,230 --> 00:03:41,990
.وهي تُظهر بشكل واضح بوابة الاستوديو 2

36
00:03:42,650 --> 00:03:44,990
كما أنّ الفتى الّذي التقطها

37
00:03:44,990 --> 00:03:49,200
شهد أنّه قد رأى ساموراي الفولاذ
.يُقتل على يد الشّرّير بعد هذا

38
00:03:49,200 --> 00:03:50,500
ماذا؟

39
00:03:50,500 --> 00:03:52,040
يُقتل؟

40
00:03:52,830 --> 00:03:57,670
كان الضّحيّة إيبوكورو تاكيشي
.من يرتدي زيّ ساموراي الفولاذ

41
00:03:57,670 --> 00:04:00,760
.وقد قُتل في الاستوديو 2

42
00:04:01,260 --> 00:04:03,180
!يؤمن الدّفاع أنّ هذه القصة حقيقيّة بشدّة

43
00:04:05,430 --> 00:04:07,890
.سأقدّم الصّورة كدليل للمحكمة

44
00:04:10,270 --> 00:04:13,560
.تمّ أخذ استراحة في الثّانية والنّصف من الاجتماع

45
00:04:14,020 --> 00:04:16,270
.وحينها وصل إيبوكورو-سان

46
00:04:16,940 --> 00:04:20,230
.هذا يعني أنّ أيّ أحد منكم قادر على قتله

47
00:04:20,230 --> 00:04:21,610
!اعتراض

48
00:04:21,610 --> 00:04:23,200
هل نسيت؟

49
00:04:23,200 --> 00:04:28,080
عُثر على الضّحيّة في الاستوديو 1
.وهو يرتدي زيّ قاضي الشّرّ

50
00:04:29,030 --> 00:04:30,910
...إنّ هذا

51
00:04:31,330 --> 00:04:35,080
!أراهن أنّ القاتل جعل الأمر يبدو كذلك

52
00:04:35,290 --> 00:04:37,790
تراهن"؟"

53
00:04:39,460 --> 00:04:40,420
.اسمحوا لي

54
00:04:40,710 --> 00:04:44,130
أتقول أنّي الجانية؟

55
00:04:45,840 --> 00:04:47,140
...حسنًا إذًا

56
00:04:47,140 --> 00:04:51,970
.لنخض معركة ذكاء أنا وأنت

57
00:04:52,520 --> 00:04:53,890
.كيفما تشائين

58
00:04:54,310 --> 00:04:55,520
...لنرَ

59
00:04:55,520 --> 00:04:57,940
كان سلاح الجريمة هو رمح السّاموراي، صحيح؟

60
00:04:59,520 --> 00:05:01,570
.عُثر عليه مغروسًا في صدر الضّحيّة

61
00:05:02,110 --> 00:05:03,360
.وها هو ذا

62
00:05:03,360 --> 00:05:05,450
.إنّه يزن خمسة عشر كيلوغرامًا

63
00:05:05,450 --> 00:05:08,780
هل تؤمن فعلاً أنّي قادرة على استعماله كسلاح؟

64
00:05:08,780 --> 00:05:11,370
لماذا لا تتأكّد بنفسك؟

65
00:05:13,370 --> 00:05:16,330
.طُعن إيبوكورو في الصّدر من الأمام

66
00:05:16,330 --> 00:05:18,960
...وهذا يعني أنّه كان على علم بوجود القاتل

67
00:05:20,000 --> 00:05:22,800
.انتزع القاتل السّلاح من الممثّل وطعنه

68
00:05:23,590 --> 00:05:27,130
ألا يبدو لك هذا أنّه يفوق قدرات البشر العاديّين؟

69
00:05:27,680 --> 00:05:31,430
صحيح. من المؤكّد أنّ هذه الشّاهدة
.ما كانت لترتكب الجريمة

70
00:05:31,430 --> 00:05:32,350
!اعتراض

71
00:05:33,100 --> 00:05:35,680
احتمال إمكانية حملها للسّلاح أم لا

72
00:05:35,680 --> 00:05:38,150
!لا علاقة لها بهذه القضيّة

73
00:05:38,150 --> 00:05:39,650
ماذا تعني؟

74
00:05:39,650 --> 00:05:42,980
!لم يكن رمح السّاموراي هو سلاح الجريمة

75
00:05:44,440 --> 00:05:49,660
!لأنّه كُسر قبل أن تحدث الجريمة

76
00:05:50,660 --> 00:05:55,410
طَعنُ رجل يرتدي زيًّا قاسيًا
!بهذا سيكون مستحيلاً

77
00:05:55,410 --> 00:05:56,580
!اعتراض

78
00:05:57,790 --> 00:06:02,340
يطالب الادّعاء أن يقدّم الدّفاع
.دليلاً يدعم مزاعمعه هذه

79
00:06:03,050 --> 00:06:04,500
هيّا أرنا

80
00:06:05,130 --> 00:06:07,130
.سلاح الجريمة الحقيقيّ

81
00:06:07,130 --> 00:06:08,720
...هـ-هذا

82
00:06:09,260 --> 00:06:11,930
،إن لم يكن لديك أيّ دليل
.فسيتمّ إسقاط مزاعمك

83
00:06:11,930 --> 00:06:13,510
.هذه هي قاعدة المحكمة

84
00:06:18,390 --> 00:06:22,860
.عليّ أن أعترف أنّ المدّعي العامّ على حقّ

85
00:06:23,110 --> 00:06:25,320
.مـ-مستحيل

86
00:06:26,230 --> 00:06:30,160
...عليك أن تتعلّم قواعد مجتمع الكبار يا فتى

87
00:06:41,290 --> 00:06:42,250
!مهلاً

88
00:06:43,340 --> 00:06:45,630
!ما هو هراء "مجتمع الكبار" هذا؟

89
00:06:45,960 --> 00:06:49,170
حتّى طفل في الابتدائيّة يمكنه
!أن يجد هذا مشوّشًا

90
00:06:49,670 --> 00:06:50,930
.صوتك مرتفع للغاية

91
00:06:50,930 --> 00:06:52,590
.أخرجوه من هنا في الحال

92
00:06:56,260 --> 00:06:59,270
"!أقاتل الشّرّ من أجل عدالة أعظم"

93
00:06:59,270 --> 00:07:01,520
!أليس هذا هو ما يفعله البطل؟

94
00:07:02,810 --> 00:07:04,230
...إذًا

95
00:07:05,070 --> 00:07:07,530
...اهزم الشّرّير

96
00:07:07,530 --> 00:07:10,530
!وأنقذ ساموراي الفولاذ

97
00:07:11,990 --> 00:07:15,030
!ما كان ساموراي الفولاذ ليقتل أحدًا

98
00:07:15,660 --> 00:07:19,000
!إنّه بطل يقاتل من أجل ما هو صائب

99
00:07:19,410 --> 00:07:20,580
...كيوتا-كُن

100
00:07:21,670 --> 00:07:24,250
!نظام في المحكمة! نظام في المحكمة

101
00:07:24,250 --> 00:07:27,250
!أخرجوا هذا الفتى من القاعة في الحال

102
00:07:27,670 --> 00:07:30,220
!توقّفوا! سوف أقطّعكم حيث تقفون

103
00:07:30,840 --> 00:07:32,010
!اسمعا أنتما

104
00:07:32,010 --> 00:07:32,880
أوبا-تشان؟

105
00:07:32,880 --> 00:07:35,550
.صه... خذا هذه فحسب

106
00:07:37,180 --> 00:07:38,810
ما-ما هذه؟

107
00:07:38,810 --> 00:07:40,810
.صورة للحادثة الّتي وقعت قبل خمس سنوات

108
00:07:41,390 --> 00:07:46,190
تسبّب إيبوكورو-تشان بموت زميل له
...عن طريق الخطأ أثناء التّصوير

109
00:07:46,190 --> 00:07:49,360
.والأسوأ من ذلك أنّ مصوّرًا تمكّن من تصوير ذلك

110
00:07:49,730 --> 00:07:52,240
.حرصت تلك المرأة على إخراس المصوّر

111
00:07:52,700 --> 00:07:54,110
هيميغامي-سان؟

112
00:07:54,110 --> 00:07:57,410
مذّاك الحين وهي تستعمل الحادثة

113
00:07:57,780 --> 00:08:00,410
.لتهديد إيبوكورو-تشان للقيام بما تطلبه منه

114
00:08:00,950 --> 00:08:02,620
.لقد كان يعمل مقابل أجر ضئيل

115
00:08:01,660 --> 00:08:02,620
!أفلتني

116
00:08:02,620 --> 00:08:03,960
.هذا فظيع

117
00:08:03,960 --> 00:08:06,590
.فظيع، صحيح؟ لكنّها الحقيقة

118
00:08:06,880 --> 00:08:08,170
...إيبوكورو-سان

119
00:08:08,170 --> 00:08:10,300
.أفهمت؟ الباقي بين يديك الآن

120
00:08:11,090 --> 00:08:13,590
!أفلتاني

121
00:08:11,760 --> 00:08:13,590
!نظام، نظام

122
00:08:15,260 --> 00:08:17,970
.دعونا نكمل المحاكمة الآن

123
00:08:17,970 --> 00:08:20,720
أين كنّا؟

124
00:08:21,310 --> 00:08:25,440
انتهينا من مناقشة مسألة "سلاح الجريمة
.الحقيقيّ" الّتي ألّفها الدّفاع

125
00:08:25,440 --> 00:08:26,440
!اعتراض

126
00:08:26,940 --> 00:08:28,940
.لم ننتهِ بعد

127
00:08:28,940 --> 00:08:30,360
ماذا؟

128
00:08:30,360 --> 00:08:33,490
.أعتقد أنّي بدأتُ أكشف عن الحقيقة الكاملة

129
00:08:34,200 --> 00:08:36,660
بما في ذلك سلاح الجريمة
.الّذي سلب حياة إيبوكورو-سان

130
00:08:36,660 --> 00:08:38,120
!ناروهودو-كُن

131
00:08:38,450 --> 00:08:41,950
!يودّ الدّفاع أن يقدّم دليلاً جديدًا للمحكمة

132
00:08:45,960 --> 00:08:48,590
ما-ما هذه الصّورة؟

133
00:08:49,500 --> 00:08:53,670
وقعت حادثة مؤسفة في الاستوديو 2
.قبل خمس سنوات

134
00:08:53,670 --> 00:08:55,630
.التُقطت هذه الصّورة أثناء ذلك

135
00:08:55,630 --> 00:08:58,220
—كم هذا محزن

136
00:08:58,220 --> 00:08:59,180
!اعتراض

137
00:08:59,180 --> 00:09:02,560
ظننتُ أنّنا نتحدّث عن سلاح الجريمة
!الّذي قتل الضّحيّة

138
00:09:03,560 --> 00:09:07,650
!لكنّكم تستطيعون رؤيته هنا في الصّورة

139
00:09:08,400 --> 00:09:09,440
...اتحاول القول

140
00:09:09,730 --> 00:09:12,780
ما الّذي قد يحدث إن سقط أحدهم من هذا الدّرج؟

141
00:09:12,780 --> 00:09:14,740
!تطلعنا هذه الصّورة على القصّة بأكملها

142
00:09:16,150 --> 00:09:21,280
إ-إذًا فقد دفع القاتل الضّحيّة على السّياج؟

143
00:09:21,540 --> 00:09:23,080
!مـ-مستحيل

144
00:09:27,960 --> 00:09:30,540
.لقد بحثت في حادثة قديمة بالفعل

145
00:09:31,210 --> 00:09:34,760
إذًا دعني أسألك شيئًا. لماذا قد أفعل ذلك؟

146
00:09:34,760 --> 00:09:35,970
لماذا؟

147
00:09:35,970 --> 00:09:38,510
لماذا قد أرغب بقتل إيبوكورو؟

148
00:09:38,760 --> 00:09:41,390
!بالفعل! تفتقر الشّاهدة للدّافع

149
00:09:43,390 --> 00:09:45,770
.دعونا نغيّر تفكيرنا

150
00:09:46,180 --> 00:09:48,600
ما-ما الّذي تعنيه؟

151
00:09:48,900 --> 00:09:53,150
هيميغامي-سان، لقد حرصت على ألاّ
.تُكتشف هذه الحادثة منذ خمس سنوات

152
00:09:53,650 --> 00:09:56,440
،وبما أنّك أصبحت تملكين شيئًا ضدّ إيبوكورو-سان

153
00:09:56,440 --> 00:09:59,610
.أرغمته أن يعمل من أجلك مقابل القليل من المال

154
00:09:59,610 --> 00:10:02,490
أنا حرّة في استعمال الممثّلين كما
.يحلو لي بصفتي المنتجة

155
00:10:02,490 --> 00:10:04,330
.لا بدّ أن ذلك كان مُهينًا للغاية

156
00:10:04,330 --> 00:10:07,580
!لا عجب أنّ إيبوكورو-سان أراد قتلكِ

157
00:10:07,580 --> 00:10:10,080
.لـ-لحظة رجاءً

158
00:10:10,080 --> 00:10:16,050
أنت تجعل الأمر يبدو وكأنّ الضّحيّة
.حاول أن يقتل الشّاهدة

159
00:10:16,840 --> 00:10:18,170
!بالضّبط

160
00:10:18,170 --> 00:10:20,890
!لقد تعاملنا مع هذه القضيّة بشكل خاطئ

161
00:10:20,890 --> 00:10:22,300
بشكل خاطئ؟

162
00:10:23,930 --> 00:10:26,730
.سرق إيبوكورو-سان زيّ ساموراي الفولاذ

163
00:10:27,140 --> 00:10:29,440
.ارتداه للذّهاب للاستوديو 2

164
00:10:30,150 --> 00:10:31,860
ولأيّ سبب؟

165
00:10:31,860 --> 00:10:34,900
لأنّ هيميغامي ساكورا كانت
،تستغلّه طوال هذه السّنوات

166
00:10:34,900 --> 00:10:36,530
!وكان هدفه هو القتل

167
00:10:47,290 --> 00:10:53,710
وبعدها مات الضّحيّة بنفس الطّريقة الّتي مات بها زميله

168
00:10:53,710 --> 00:10:58,260
عن طريق الخطأ قبل خمس سنوات. أهذا ما تعنيه؟

169
00:10:58,260 --> 00:10:59,630
.نعم يا حضرة القاضي

170
00:11:00,760 --> 00:11:02,590
.يا لها من قصة مبتكرة

171
00:11:03,430 --> 00:11:07,970
.قد يلزمني رجل مثلك في فريق التّأليف لديّ

172
00:11:07,970 --> 00:11:09,140
أتنكرين هذا؟

173
00:11:12,060 --> 00:11:15,570
قتلتُه ثمّ حملتُه إلى الاستوديو 1
وزيّفتُ ساحة الجريمة؟

174
00:11:15,770 --> 00:11:19,820
لكن كيف يمكنني القيام بكلّ هذا
خلال استراحة الرّبع ساعة؟

175
00:11:19,820 --> 00:11:24,030
إنّ نقل الجثّة وحده سيكون
.مستحيلاً من الأساس

176
00:11:24,030 --> 00:11:28,950
.لأنّ الطّريق إلى الاستوديو 1 كان مغلقًا

177
00:11:28,950 --> 00:11:31,290
!مغلقًا بواسطة رأس "قزم الباحة" المقطوع

178
00:11:38,670 --> 00:11:40,800
."لكنّ اسمه هو "قزم الغابة

179
00:11:40,800 --> 00:11:42,720
.لا أشعر برغبة بتصحيح كلامه

180
00:11:42,970 --> 00:11:46,720
.نعم، يبدو ذلك مستحيلاً بالنّظر للوقت

181
00:11:46,970 --> 00:11:48,140
!اعتراض

182
00:11:48,140 --> 00:11:51,140
.لم تكن هنالك حاجة للقيام بكلّ شيء مرّة واحدة

183
00:11:51,140 --> 00:11:52,850
.كانت قادرة على القيام بذلك على مراحل

184
00:11:52,850 --> 00:11:55,150
ارتكاب الجريمة على مراحل؟

185
00:11:55,770 --> 00:11:58,610
.لقد خبّأت الجثّة بشكل مؤقّت  وعادت للاجتماع

186
00:11:58,610 --> 00:12:00,360
،وبمجرّد أن انتهى

187
00:12:00,360 --> 00:12:04,070
.حملت الجثّة إلى الشّاحنة وأخذتها للاستوديو 1

188
00:12:04,820 --> 00:12:07,990
.كان الطّريق حينها قد أصبح سالكًا أيضًا

189
00:12:10,700 --> 00:12:12,870
...أنت أذكى ممّا يبدو عليك يا فتى

190
00:12:12,870 --> 00:12:16,670
.أنا أعترف بهذا

191
00:12:18,000 --> 00:12:23,590
إ-إذًا، أنت تعترفين أنّك من قتل إيبوكورو-سان؟

192
00:12:23,590 --> 00:12:26,760
.يبدو أنّك أسأت فهمي أيّها الصّغير

193
00:12:26,760 --> 00:12:27,970
صـ-صغير؟

194
00:12:28,300 --> 00:12:31,430
،لقد أثبتّ أنّي قد أكون قد قتلتُ إيبوكورو

195
00:12:31,810 --> 00:12:33,980
.وأنا أعترف لك بذلك

196
00:12:33,980 --> 00:12:35,150
.هذا كلّ شيء

197
00:12:35,560 --> 00:12:38,520
!لكنّك أنتِ من قتل إيبوكورو-سان

198
00:12:39,230 --> 00:12:43,240
كيف لم تتعلّم قواعد الكبار بعد؟

199
00:12:43,240 --> 00:12:45,410
.أنت هناك. اشرح له

200
00:12:46,160 --> 00:12:49,080
.في قاعة المحكمة، الدّليل هو كلّ شيء

201
00:12:49,080 --> 00:12:52,000
.إن لم يكن لديك دليل، سيتمّ إسقاط مزاعمك

202
00:12:52,000 --> 00:12:54,580
هذا هو القانون هنا، أليس كذلك؟

203
00:12:55,080 --> 00:12:57,710
.لقد لعبتَ بكلّ أوراقك وخسرت

204
00:12:57,710 --> 00:13:00,130
.والآن، انتهت اللّعبة

205
00:13:01,090 --> 00:13:03,970
.سوف أغادر إذًا

206
00:13:08,180 --> 00:13:13,220
هل يستطيع الدّفاع تقديم دليل يدعم مزاعمه؟

207
00:13:13,220 --> 00:13:14,560
!ناروهودو-كُن

208
00:13:16,980 --> 00:13:19,270
.إذًا، انتهى استجوابك لشاهدة الخصم

209
00:13:19,690 --> 00:13:21,070
.كان هذا ممتعًا

210
00:13:22,400 --> 00:13:23,360
.مع السّلامة

211
00:13:24,530 --> 00:13:25,530
...لا أستطيع

212
00:13:25,530 --> 00:13:28,820
!لا أستطيع إبقاءها على منصّة الشّهود أكثر من هذا

213
00:13:29,620 --> 00:13:30,580
!مهلاً

214
00:13:35,210 --> 00:13:36,210
ميتسوروغي؟

215
00:13:37,500 --> 00:13:40,630
ما-ماذا هنالك أيّها المدّعي العامّ ميتسوروغي؟

216
00:13:40,630 --> 00:13:44,420
.أطلب أن تستمرّ الشّاهدة بتقديم شهادتها

217
00:13:45,970 --> 00:13:47,470
المدّعي العامّ ميتسوروغي؟

218
00:13:48,470 --> 00:13:51,390
!أطلب ذلك بالفعل. نعم

219
00:13:51,390 --> 00:13:54,180
.أريد أن أسمع ما حدث بعد أن عثروا على الجثّة

220
00:13:54,180 --> 00:13:57,480
،إن أراد الادّعاء أن يقدّم شاهد ما شهادته
.فلا يمكنه أن يرفض

221
00:13:57,480 --> 00:13:59,560
.هذا هو قانون المحكمة

222
00:13:59,560 --> 00:14:00,900
.حسنًا

223
00:14:00,900 --> 00:14:02,940
.قدّمي شهادتك أيّتها الشّاهدة

224
00:14:05,740 --> 00:14:09,200
.اتّصلنا بالشّرطة بمجرّد أن عثرنا على إيبوكورو ميتًا

225
00:14:09,490 --> 00:14:13,660
،عدتُ إلى المقطورة لإحضار نصّي
.وبعدها عدت للمنزل

226
00:14:14,080 --> 00:14:15,250
هل أنت راضٍ الآن؟

227
00:14:15,250 --> 00:14:16,370
.نعم

228
00:14:16,370 --> 00:14:18,160
.يستطيع الدّفاع استجواب الشّاهدة الآن

229
00:14:19,170 --> 00:14:20,630
!حا-حاضر

230
00:14:21,580 --> 00:14:24,170
ما الّذي يفترض بي القيام به بشهادة كهذه؟

231
00:14:24,920 --> 00:14:26,010
...عفوًا

232
00:14:26,510 --> 00:14:30,180
عدتِ للاستوديو 1 من أجل التّدريب، صحيح؟

233
00:14:30,180 --> 00:14:30,640
.نعم

234
00:14:30,930 --> 00:14:34,720
لماذا لم تحضري نصّك معك؟

235
00:14:34,720 --> 00:14:37,930
.كنتُ أعتقد أنّنا لن نكون قادرين على أن نتدرّب

236
00:14:37,930 --> 00:14:39,350
لماذا؟

237
00:14:39,350 --> 00:14:41,940
.كانت هنالك جريمة قتل

238
00:14:41,940 --> 00:14:43,400
من قد يفكّر في التّدريب بعد معرفته بذلك؟

239
00:14:43,400 --> 00:14:44,520
!اعتراض

240
00:14:46,990 --> 00:14:50,700
تركتِ نصّك لأنّك افترضت أنّه لن يكون هنالك تدريب؟

241
00:14:51,870 --> 00:14:57,580
يبدو لي هذا وكأنّك كنتِ تعرفين بوجود
.جثّة قبل مغادرتك للمقطورة

242
00:14:59,870 --> 00:15:01,120
!نظام

243
00:15:01,120 --> 00:15:05,000
.هذه ملاحظة معقولة أيّها المدّعي العامّ ميتسوروغي

244
00:15:05,750 --> 00:15:08,720
لكنّك المدّعي العامّ، لماذا تشير لملاحظة كهذه؟

245
00:15:08,720 --> 00:15:10,170
...المدّعي العامّ ميتسوروغي

246
00:15:10,170 --> 00:15:14,640
.ربّما أدرك من هو الجاني الحقيقيّ أيضًا

247
00:15:14,640 --> 00:15:19,430
.حضرة القاضي، سوف أتصرّف بأيّ طريقة أجدها مناسبة

248
00:15:20,480 --> 00:15:22,980
والآن أيّتها الشّاهدة، هلاّ فسّرت لنا الأمر؟

249
00:15:22,980 --> 00:15:25,770
يتعاون الادّعاء مع الدّفاع؟

250
00:15:26,150 --> 00:15:27,650
.هذا لا يهمّ

251
00:15:27,650 --> 00:15:32,530
كان لديّ سبب وجيه للغاية لأعتقد
.أنّه لن يكون هنالك تدريب

252
00:15:32,530 --> 00:15:33,820
وما كان ذلك السّبب؟

253
00:15:33,820 --> 00:15:40,080
كنتُ أعرف أنّ إيبوكورو كان مصابًا وغير
.قادر على القيام بمشاهد حركة

254
00:15:40,370 --> 00:15:42,960
.وجهة نظر وجيهة

255
00:15:44,830 --> 00:15:47,840
هل أستطيع أن أفترض
أنّ هذا الصّمت يعني الاستسلام؟

256
00:15:49,050 --> 00:15:49,880
!اعتراض

257
00:15:49,880 --> 00:15:52,340
ماذا أيّها المدّعي العامّ ميتسوروغي؟

258
00:15:54,390 --> 00:15:58,930
كنتُ آمُل أن أفكّر بسؤال بينما
.أقدّم اعتراضي يا حضرة القاضي

259
00:15:58,930 --> 00:16:00,600
.لكنّي لا أملك أيّ أسئلة

260
00:16:03,690 --> 00:16:05,560
!لكنّي أعترض في كلّ الأحوال

261
00:16:05,560 --> 00:16:06,940
.اعتراضك مرفوض

262
00:16:06,940 --> 00:16:09,230
...مـ-ميتسوروغي

263
00:16:09,230 --> 00:16:10,690
.يا ناروهودو-كُن

264
00:16:11,280 --> 00:16:13,490
،إن كانت أختي هنا الآن

265
00:16:14,160 --> 00:16:15,620
،أراهن أنّها كانت لتقول

266
00:16:16,070 --> 00:16:20,620
".عندما تسوء الأمور، ابتسم"

267
00:16:22,750 --> 00:16:25,000
.عندما تسوء الأمور، علينا أن نبتسم

268
00:16:25,000 --> 00:16:26,380
...فهمت

269
00:16:26,380 --> 00:16:30,960
!لا بدّ أنّ هيميغامي ساكورا تقف على الحافّة الآن

270
00:16:32,340 --> 00:16:37,100
كنتُ أعرف أنّ إيبوكورو كان مصابًا وغير
.قادر على القيام بمشاهد حركة

271
00:16:47,060 --> 00:16:48,020
!اعتراض

272
00:16:54,820 --> 00:17:00,370
هيميغامي-سان، هل قلتِ للتّوّ أنّك
عرفتِ أنّ إيبوكورو كان مصابًا؟

273
00:17:02,660 --> 00:17:04,040
نعم، وماذا في ذلك؟

274
00:17:04,540 --> 00:17:07,290
.لم يكن إيبوكورو-سان المصاب ذلك اليوم

275
00:17:07,920 --> 00:17:10,250
!بل كان المدّعى عليه نيبوشي-سان

276
00:17:11,880 --> 00:17:13,170
عمّاذا تتحدّث؟

277
00:17:13,670 --> 00:17:18,640
،أجل، عندما أتى إيبوكورو إلى المقطورة
.كان يجرّ رجله

278
00:17:18,640 --> 00:17:21,970
لكنّ ذلك كان لأنّه كان يتظاهر
.أنّه نيبوشي سابورو

279
00:17:22,180 --> 00:17:24,390
ما-ماذا؟

280
00:17:24,390 --> 00:17:28,270
.كما لم تكوني حاضرة في تدريب الصّباح

281
00:17:28,270 --> 00:17:30,360
كيف عرفتِ بشأن الإصابة؟

282
00:17:30,360 --> 00:17:32,190
...حـ-حسنًا

283
00:17:32,820 --> 00:17:36,400
.أجل، أخبرني أوزاي. أوزاي هو من أخبرني

284
00:17:36,400 --> 00:17:37,240
—إنّه

285
00:17:37,240 --> 00:17:38,740
.لا أظنّ ذلك

286
00:17:39,280 --> 00:17:44,080
في ذلك اليوم، رأى المخرج أوزاي نيبوشي-سان
.وهو يتعرّض للإصابة أمام عينيه

287
00:17:44,080 --> 00:17:45,960
!من المستحيل أن يكون قد أخطأ

288
00:17:46,710 --> 00:17:51,210
!في ذلك اليوم، رأيتِ إيبوكورو-سان يعرج بأمّ عينيك

289
00:17:51,920 --> 00:17:55,210
ومتى كان ذلك؟

290
00:17:55,210 --> 00:17:56,380
...حسنًا

291
00:17:56,380 --> 00:18:01,390
عندما ارتدى زيّ ساموراي الفولاذ
.واتّجه إلى مقطورة الاستوديو 2

292
00:18:01,390 --> 00:18:05,480
!عندما أخذتِ استراحة الرّبع ساعة في المقطورة

293
00:18:05,480 --> 00:18:10,310
!وذلك الوقت يناسب وقت موت الضّحيّة بالضّبط

294
00:18:28,000 --> 00:18:31,500
أنتِ الجانية، أليس كذلك يا هيميغامي ساكورا-سان؟

295
00:18:34,420 --> 00:18:35,170
.نعم

296
00:18:36,010 --> 00:18:38,130
.أنا القاتلة

297
00:18:40,930 --> 00:18:43,140
.لقد خسرت وأنت فزت

298
00:18:47,430 --> 00:18:52,360
.يبدو أنّك قد حقّقتَ معجزة أخرى يا ناروهودو-كُن

299
00:18:53,060 --> 00:18:54,440
.لا أعتقد ذلك يا حضرة القاضي

300
00:18:55,690 --> 00:18:58,150
.كان نيبوشي سابورو بريئًا

301
00:18:58,150 --> 00:19:02,280
كان على براءته أن تُثبت
.في الأوضاع العاديّة وليس بمعجزة

302
00:19:02,990 --> 00:19:04,080
...ميتسوروغي

303
00:19:04,950 --> 00:19:05,830
.حسنًا

304
00:19:05,830 --> 00:19:09,870
!سوف أنطق بالحكم في حقّ نيبوشي سابورو

305
00:19:13,880 --> 00:19:14,710
!ليس مذنبًا

306
00:19:23,340 --> 00:19:25,220
!مرحى

307
00:19:28,390 --> 00:19:30,140
!أجل

308
00:19:30,140 --> 00:19:33,100
!هذا كلّ شيء. رُفعت الجلسة

309
00:19:35,610 --> 00:19:38,150
.لا أدري ماذا أقول

310
00:19:38,150 --> 00:19:40,490
!شكرًا جزيلاً لك

311
00:19:40,490 --> 00:19:43,320
.كلاّ، حالفنا الحظّ فحسب

312
00:19:43,320 --> 00:19:44,910
!معك حقّ في ذلك

313
00:19:44,910 --> 00:19:47,030
.لحسن الحظّ أنّنا أنهينا الأمر اليوم

314
00:19:47,030 --> 00:19:50,120
من كان ليقول أنّ الحظّ سيحالفنا غدًا؟

315
00:19:49,290 --> 00:19:50,870
...اخرسي

316
00:19:50,870 --> 00:19:53,580
!أنا سعيدة من أجلك يا نيبوشي-سان

317
00:19:53,580 --> 00:19:55,170
!أ-أنا ممتنّ للغاية

318
00:19:59,210 --> 00:20:01,090
!إنّه المدّعي العامّ ميتسوروغي

319
00:20:02,010 --> 00:20:05,600
.اسمح لي أن أهنّئك على انتصارك

320
00:20:07,720 --> 00:20:11,270
.أنا معجب كبير بك ولا أفوّت حلقة من مسلسلك

321
00:20:12,560 --> 00:20:13,520
.كاذب

322
00:20:14,270 --> 00:20:15,980
.شـ-شكرًا

323
00:20:17,770 --> 00:20:19,150
.شكرًا لك يا مستوروغي

324
00:20:20,570 --> 00:20:24,410
كانت هيميغامي-سان لتنجو بفعلتها
.إن لم تتدخّل أنت

325
00:20:26,320 --> 00:20:27,240
،ناروهودو

326
00:20:27,910 --> 00:20:30,750
.بعد كلّ هذه السّنوات، لم أتوقّع رؤيتك ثانية

327
00:20:31,370 --> 00:20:34,580
.ولكن، كان من الأفضل لو لم نتقابل

328
00:20:35,580 --> 00:20:38,840
.تخالجني الآن مشاعر غير ضروريّة بفضلك أنت

329
00:20:39,630 --> 00:20:42,470
.قلق وحيرة

330
00:20:42,470 --> 00:20:45,800
أليسا إحساسان ضروريّان؟

331
00:20:46,050 --> 00:20:47,890
.استمع لي يا ناروهودو ريويتشي

332
00:20:47,890 --> 00:20:51,060
.لا تُظهر وجهك أمامي مرّة أخرى

333
00:20:51,930 --> 00:20:52,770
.هذا كلّ شيء

334
00:20:52,770 --> 00:20:55,190
هل أنت صديق للمدّعي العامّ؟

335
00:20:55,190 --> 00:20:56,150
!مستحيل

336
00:20:56,150 --> 00:20:57,900
!إنّهما متنافسين! متنافسين

337
00:20:57,900 --> 00:20:59,440
أليس كذلك يا ناروهودو-كُن؟

338
00:21:00,780 --> 00:21:01,650
.في الوقت الحاليّ على ما أظنّ

339
00:21:02,610 --> 00:21:05,110
ما قصّة هذه الإجابة الغامضة؟

340
00:21:05,110 --> 00:21:08,700
!لا أستطيع التّوقّف عن التّفكير بالأمر الآن! أخبرني

341
00:21:06,610 --> 00:21:08,700
.وهكذا أُسدل السّتار على محاكمة أخرى

342
00:21:12,250 --> 00:21:15,080
!ناروهودو-كُن! أسرع، سيبدأ المسلسل

343
00:21:19,000 --> 00:21:20,840
لم تكن تعرف يا ناروهودو-كُن؟

344
00:21:20,840 --> 00:21:22,920
!هذا معروف للجميع

345
00:21:23,340 --> 00:21:25,680
.لم أعتقد أنّهم فكّروا بجدّيّة بتقديمها

346
00:21:29,350 --> 00:21:33,180
يراودني شعور أنّ القضيّة
.قد غيّرت شيئًا ما في داخلي

347
00:21:34,230 --> 00:21:37,480
.ربّما حدث نفس الشّيء معه

348
00:21:39,440 --> 00:21:42,780
،وبعد بضعة شهور

349
00:21:42,780 --> 00:21:47,490
.سنتواجه مع قضيّة كبيرة ستدخل تاريخ القانون

350
00:23:20,710 --> 00:23:21,870
!اعتراض

351
00:23:22,120 --> 00:23:23,790
.صدى طلق ناريّ يتردّد في سماء اللّيل

352
00:23:23,790 --> 00:23:27,460
.تورّط جانٍ غير متوقّع في حادثة تلك اللّيلة المقدّسة

353
00:23:27,460 --> 00:23:29,630
.اسمه هو ميتسوروغي ريجي

354
00:23:29,630 --> 00:23:34,050
وستتضمّن تلك القضيّة ميتسوروغي
.وأنا وحتّى مايوي-تشان

355
00:23:34,050 --> 00:23:36,640
ما الّذي حدث قبل خمسة عشر سنة؟

356
00:23:36,640 --> 00:23:38,720
.هنالك شيء واحد أستطيع القيام به

357
00:23:38,720 --> 00:23:42,650
.سوف أدافع عنك يا ميتسوروغي

