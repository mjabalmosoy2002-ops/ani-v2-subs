1
00:00:06,230 --> 00:00:08,730
.لقد كانت حادثة

2
00:00:11,070 --> 00:00:13,990
.لقد قتلني ذلك الشّخص

3
00:00:26,670 --> 00:00:28,920
.لذلك السّبب انتقمتُ منه

4
00:00:28,920 --> 00:00:30,300
...هذا منصف، أليس كذلك

5
00:00:32,300 --> 00:00:33,220
يا نودوكا؟

6
00:02:09,900 --> 00:02:10,810
...كما تعلم

7
00:02:11,190 --> 00:02:13,270
.أجد هذا الموضوع مزعجًا بشكل كامل

8
00:02:13,650 --> 00:02:16,990
إنّ من قتلت أولئك المرضى الأربعة
عشر في مستشفاي

9
00:02:16,990 --> 00:02:19,030
.كانت الممرّضة الّتي أخطأت في الأدوية

10
00:02:19,610 --> 00:02:22,490
،ومع ذلك، قبل أن تستطيع الاعتراف بذنبها

11
00:02:22,490 --> 00:02:24,160
!ماتت في حادثة سير

12
00:02:24,660 --> 00:02:26,660
وبسبب ذلك، دارت إشاعات

13
00:02:26,660 --> 00:02:30,120
.حولي أنا المدير عن تسّببي بالحادثة الّتي قتلتها

14
00:02:30,500 --> 00:02:34,630
لهذا السّبب قرّرتَ أن تطلب
المساعدة من وسيطة روحيّة؟

15
00:02:34,630 --> 00:02:35,960
!بالضّبط

16
00:02:35,960 --> 00:02:37,920
سوف أستدعي تلك الممرّضة

17
00:02:37,920 --> 00:02:42,180
الّتي تسبّبت بقتل نفسها وأرغمها على توقيع
!اعتراف موقّع تثبت فيه أنّ كلّ ذلك كان خطأها

18
00:02:43,100 --> 00:02:46,970
الرّئيسة الممثّلة لمدرسة كوراين
...لاستدعاء الأرواح، أياساتو مايوي

19
00:02:46,970 --> 00:02:49,100
.سمعتُ أنّها مشهورة في تلك الأوساط

20
00:02:49,100 --> 00:02:51,980
.تعرف أحد معارفي الكثير عن الظّواهر الخارقة

21
00:02:51,980 --> 00:02:54,270
.لقد رشّحتها لي عندما تحدّثتُ معها

22
00:02:54,610 --> 00:02:58,150
هل كان شرط حضوري لجلسة
الاستدعاء صادرًا منها هي؟

23
00:02:58,440 --> 00:03:01,490
!نعم. لقد طلبت حضورك بالاسم

24
00:03:01,490 --> 00:03:03,740
."قالت "سأفعل ذلك بحضور ناروهودو-كُن فقط

25
00:03:03,740 --> 00:03:05,330
فهمت يا ناروهود-سان؟

26
00:03:05,330 --> 00:03:07,410
.هنالك حرف "واو" ناقص في آخر اسمي

27
00:03:11,500 --> 00:03:13,330
إنّها مستدعية أرواح مقتدرة الآن؟

28
00:03:29,060 --> 00:03:30,680
...قرية كوراين

29
00:03:30,680 --> 00:03:32,980
هذه هي بلدة مايوي-تشان إذًا؟

30
00:03:37,360 --> 00:03:38,820
.دعنا نكمل طريقنا إذًا

31
00:03:38,820 --> 00:03:40,740
.سوف تبدأ المراسم قريبًا

32
00:03:40,940 --> 00:03:41,780
.حسنًا

33
00:03:58,090 --> 00:03:59,420
!مرحبًا

34
00:04:05,510 --> 00:04:06,760
فتاة؟

35
00:04:06,760 --> 00:04:08,310
هارومي-تشان؟

36
00:04:08,310 --> 00:04:10,060
.فتاة سيّئة

37
00:04:10,640 --> 00:04:15,060
كم مرّة أخبرتُك فيها ألاّ تتبعي الغرباء المشبوهين؟

38
00:04:15,060 --> 00:04:16,860
مـ-مشبوهين؟

39
00:04:17,940 --> 00:04:19,860
.آسفة يا أمّي

40
00:04:19,860 --> 00:04:22,690
يا إلهي. ماذا إن وقعتِ وآذيتِ نفسك؟

41
00:04:23,030 --> 00:04:26,320
...تشبه هذه الفتاة مايوي-تشان بطريقة ما

42
00:04:26,530 --> 00:04:29,080
حسنًا، من أنتما يا سيّداي؟

43
00:04:29,370 --> 00:04:34,040
أنا كيريساكي. لقد طلبتُ جلسة
.استدعاء أرواح اليوم

44
00:04:34,040 --> 00:04:36,790
.وأنا ناروهودو ريويتشي، محامي دفاع

45
00:04:38,340 --> 00:04:39,630
محامٍ؟

46
00:04:39,630 --> 00:04:41,710
.هذا أنت إذًا

47
00:04:41,710 --> 00:04:44,050
.لقد حدّثتني عنك مايوي-ساما

48
00:04:44,260 --> 00:04:46,220
مايوي-ساما؟

49
00:04:46,430 --> 00:04:50,600
.أنا أياساتو كيميكو، خالة مايوي-تشان

50
00:04:50,890 --> 00:04:54,020
.وهذه ابنتي هارومي

51
00:04:54,230 --> 00:04:56,400
إذًا فهي ابنة خالة مايوي-تشان؟

52
00:04:56,900 --> 00:04:57,850
.مرحبًا

53
00:04:59,270 --> 00:05:00,610
.تفضّلا رجاءً

54
00:05:00,610 --> 00:05:02,690
.كلّ شيء جاهز

55
00:05:06,820 --> 00:05:09,030
!هذا أنت يا ناروهودو

56
00:05:09,030 --> 00:05:09,830
...نا

57
00:05:09,830 --> 00:05:11,160
ناتسومي-سان؟

58
00:05:11,160 --> 00:05:13,120
!لم أرك منذ مدّة

59
00:05:14,370 --> 00:05:15,960
.يعيد هذا لي الكثير من الذّكريات

60
00:05:15,960 --> 00:05:17,580
هل أصبحتَ أكثر طولاً؟

61
00:05:17,580 --> 00:05:19,380
من تظنّين نفسكِ؟ عمّتي؟

62
00:05:19,840 --> 00:05:21,840
ما الّذي تفعلينه هنا؟

63
00:05:22,500 --> 00:05:23,960
.يجب أن يكون هذا واضحًا

64
00:05:23,960 --> 00:05:25,510
!أنا هنا من أجل السّبق الصّحفيّ الكبير

65
00:05:25,510 --> 00:05:28,340
لا زلت على حالك؟
.أقصد كونك مصوّرة فوتوغرافيّة

66
00:05:28,340 --> 00:05:29,640
.بالطّبع

67
00:05:29,640 --> 00:05:30,850
.لن أنسى ذلك أبدًا

68
00:05:30,850 --> 00:05:33,390
،منذ أن تلاعبتَ بي في المحكمة قبل ستّة أشهر

69
00:05:33,390 --> 00:05:38,020
وأنا أطارد كلّ سبق صحفيّ أستطيع العثور
!عليه... أنا المصوّرة الفاسدة ناتسومي-سان

70
00:05:38,020 --> 00:05:40,400
ألم تكوني أنتِ من تلاعبت بي في المحكمة؟

71
00:05:42,440 --> 00:05:43,610
...الموعد وشيك

72
00:05:43,610 --> 00:05:45,690
!الموعد وشيك يا ناروهودو-سان

73
00:05:45,690 --> 00:05:48,490
،حتّى وإن ظهرت تلك الممرّضة كروح شرّيرة

74
00:05:48,490 --> 00:05:50,990
!فأنا جاهز لأقاتلها بكلّ ما لديّ

75
00:05:51,280 --> 00:05:52,620
...وهذا واضح أمامك

76
00:05:52,830 --> 00:05:54,750
ما-ما هو هذا؟

77
00:05:54,750 --> 00:05:56,370
هذا ليس مسدّسًا حقيقيًّا، صحيح؟

78
00:05:57,960 --> 00:05:59,670
ماذا تظنّ؟

79
00:05:59,670 --> 00:06:03,630
أعتقد أنّ هذا الشّخص لديه فكرة
.خاطئة عن استدعاء الأرواح

80
00:06:09,680 --> 00:06:13,100
.سيّدايَ وسيّدتي، اجلسوا بشكل ملائم رجاءً

81
00:06:13,350 --> 00:06:15,350
أستطيع أخيرًا رؤية مايوي-تشان، صحيح؟

82
00:06:15,600 --> 00:06:16,600
!يا للوقاحة

83
00:06:16,600 --> 00:06:18,980
!نادها مايوي-ساما

84
00:06:18,980 --> 00:06:22,610
،إنّها آخر سليلة للعائلة الرّئيسيّة

85
00:06:22,610 --> 00:06:26,070
.الخليفة الشّرعيّة لمدرسة كوراين لاستدعاء الأرواح

86
00:06:26,070 --> 00:06:28,860
.هذه هي مايوي-ساما

87
00:06:28,860 --> 00:06:32,450
.الرّئيسة جاهزة

88
00:06:32,450 --> 00:06:34,870
.لنبدأ إذًا

89
00:06:44,000 --> 00:06:45,500
...مايوي-تشان

90
00:06:56,890 --> 00:07:02,560
.سنبدأ الآن الاستدعاء على طريقة مدرسة كوراين

91
00:07:27,090 --> 00:07:32,180
خلال هذه المراسم، لا يستطيع
أحد دخول غرفة التّأمّل

92
00:07:32,180 --> 00:07:35,550
.أو غرفة الاستدعاء في الخلف

93
00:07:35,550 --> 00:07:37,890
.تذكّروا هذا رجاءً

94
00:07:45,190 --> 00:07:49,230
والآن، أصبحت غرفة الاستدعاء
.منعزلة تمامًا عن هذا العالم

95
00:07:50,280 --> 00:07:54,160
.لننتظر بكلّ صبر في القاعة الرّئيسيّة

96
00:07:54,870 --> 00:07:56,450
.تمهّلي أيّتها الجدّة

97
00:07:56,870 --> 00:07:58,120
الجدّة"؟"

98
00:07:58,120 --> 00:08:00,750
لماذا لا يُسمح لنا بدخول تلك الغرفة؟

99
00:08:00,750 --> 00:08:03,290
!أنا هنا للعمل! أنا صحفيّة

100
00:08:03,290 --> 00:08:05,250
!لا أستطيع العمل هكذا

101
00:08:05,250 --> 00:08:08,130
أنت غريبة عنّا؟

102
00:08:08,130 --> 00:08:10,460
.لديك اطّلاع واسع باللّغة اليابانيّة

103
00:08:10,460 --> 00:08:14,130
!أنا يابانيّة أبًا عن جدّ

104
00:08:14,130 --> 00:08:16,930
.إذًا فأنا أنصحك أن تعودي إلى أبيك وجدّك هذين

105
00:08:17,760 --> 00:08:19,510
.هذه قرية كوراين

106
00:08:19,510 --> 00:08:21,480
،إن لم تستطيعي اتّباع تقاليدنا وقوانيننا

107
00:08:21,480 --> 00:08:23,730
.نطلب منك المغادرة

108
00:08:24,100 --> 00:08:28,360
فـ-فهمت، لذلك هلا نظرت في اتّجاه آخر عداي؟

109
00:08:28,360 --> 00:08:30,320
إنّها لا تتعلّم، صحيح؟

110
00:08:30,690 --> 00:08:31,940
ما الأمر يا ناروهودو؟

111
00:08:31,940 --> 00:08:34,780
ما بال تلك النّظرة الّتي تقول
"إنّها لا تتعلّم، صحيح؟"

112
00:08:34,780 --> 00:08:36,280
—في البداية، أنت

113
00:08:38,330 --> 00:08:40,040
ما تلك الضّجّة؟

114
00:08:40,040 --> 00:08:41,240
!إنّها صادرة من غرفة الاستدعاء؟

115
00:08:42,370 --> 00:08:44,500
!ناروهودو! هذا طلق ناريّ

116
00:08:52,420 --> 00:08:53,970
!كيميكو-سان! المفتاح

117
00:08:53,970 --> 00:08:57,260
.هنالك مفتاح واحد فقط، وهو مع مايوي-ساما

118
00:08:57,260 --> 00:08:58,350
ماذا؟

119
00:08:58,350 --> 00:09:00,680
!سوف نكسر الباب يا ناروهودو

120
00:09:01,260 --> 00:09:02,310
!مفهوم

121
00:09:07,310 --> 00:09:08,810
كيريساكي-سينسي؟

122
00:09:09,270 --> 00:09:10,270
ما هذا؟

123
00:09:10,980 --> 00:09:12,150
...أنا

124
00:09:12,400 --> 00:09:15,610
...لقد قُتلت

125
00:09:15,900 --> 00:09:17,820
ما... مايوي-تشان؟

126
00:09:18,530 --> 00:09:21,830
.لقد قتلني ذلك الرّجل

127
00:09:22,870 --> 00:09:24,700
.لذلك قتلتُه أنا

128
00:09:25,500 --> 00:09:26,670
ماذا؟

129
00:09:27,210 --> 00:09:28,330
!هذا هو

130
00:09:28,330 --> 00:09:30,290
!ناتسومي-سان... هذا ليس وقتًا مناسبًا

131
00:09:30,290 --> 00:09:31,960
!بل هو الوقت المناسب

132
00:09:31,960 --> 00:09:33,260
!غادرا

133
00:09:33,260 --> 00:09:35,340
!دعا هذا الأمر لي رجاءً

134
00:09:35,340 --> 00:09:37,470
!اذهبا بسرعة وأبلغا الشّرطة

135
00:09:37,470 --> 00:09:38,470
...لـ-لكن

136
00:09:38,470 --> 00:09:39,260
...بسرعة

137
00:09:39,260 --> 00:09:41,050
!هنالك هاتف في القاعة الرّئيسيّة

138
00:09:41,050 --> 00:09:42,010
—لكن

139
00:09:42,010 --> 00:09:43,010
!لنذهب يا ناروهودو

140
00:09:43,010 --> 00:09:44,470
!لندع الجدّة تهتمّ بهذا

141
00:09:44,770 --> 00:09:45,980
...مايوي-تشان

142
00:09:53,150 --> 00:09:56,030
!آسف لجعلكم تنتظرون! لقد وصلت الشّرطة

143
00:09:56,030 --> 00:09:57,320
من اتّصل بنا؟

144
00:09:57,860 --> 00:10:00,370
ماذا؟ أنت ثانية؟

145
00:10:00,370 --> 00:10:02,580
.أنا من عليه قول ذلك

146
00:10:02,580 --> 00:10:04,580
ما الّذي تفعله في مكان بعيد
كهذا أيّها المحقّق إيتونوكو؟

147
00:10:04,580 --> 00:10:06,830
.كنتُ في المنطقة في رحلة عمل

148
00:10:06,830 --> 00:10:08,790
.وبعدها أرسلوني إلى هنا للمساعدة

149
00:10:09,330 --> 00:10:12,090
أهذا هو المحقّق الوحيد في هذا العالم؟

150
00:10:12,460 --> 00:10:13,670
ماذا؟

151
00:10:13,670 --> 00:10:16,590
.وصلتَ بشكل أسرع ممّا توقّعنا

152
00:10:17,590 --> 00:10:19,590
.أنا إيتونوكوغيري، من قسم شرطة العاصمة

153
00:10:19,590 --> 00:10:20,470
!كيميكو-سان

154
00:10:20,470 --> 00:10:22,930
كيف حال مايوي-ساما؟

155
00:10:22,930 --> 00:10:25,220
.نجحت تقنية فصل الاستدعاء الرّوحيّ

156
00:10:25,220 --> 00:10:28,390
.لقد عادت إلى هذا العالم

157
00:10:28,850 --> 00:10:30,190
!دعيني أراها رجاءً

158
00:10:30,190 --> 00:10:32,440
.إنّها فاقدة الوعي الآن

159
00:10:32,440 --> 00:10:34,270
.أخشى أنّك لا تستطيع رؤيتها

160
00:10:34,610 --> 00:10:38,740
هل لدينا هنا كلّ من كانوا في القصر أثناء الحادثة؟

161
00:10:38,740 --> 00:10:40,450
.ذلك ما يبدو

162
00:10:40,450 --> 00:10:42,370
.كانت ابنتي هارومي هنا

163
00:10:42,370 --> 00:10:46,750
.وكانت هنالك ضيفة في الغرفة الجانبيّة للملحق

164
00:10:46,750 --> 00:10:47,790
الملحق؟

165
00:10:47,790 --> 00:10:49,910
هل هي خلف القصر؟

166
00:10:49,910 --> 00:10:52,380
.اذهب لإحضارها يا فتى

167
00:10:53,710 --> 00:10:54,420
.حسنًا

168
00:10:56,960 --> 00:10:58,590
...لحظة

169
00:10:58,590 --> 00:11:00,470
.الغرفة الجانبيّة من هنا

170
00:11:04,300 --> 00:11:05,510
.المعذرة

171
00:11:08,560 --> 00:11:09,850
.مرحبًا

172
00:11:10,190 --> 00:11:14,860
إذًا... هل حان الوقت لنبدأ؟

173
00:11:14,860 --> 00:11:16,070
.الاستدعاء

174
00:11:16,070 --> 00:11:17,280
—الاستد

175
00:11:17,280 --> 00:11:20,780
!كلاّ، لقد تغيّر الوضع! لقد حدثت جريمة قتل

176
00:11:20,780 --> 00:11:21,990
ماذا؟

177
00:11:21,990 --> 00:11:24,660
.هذا مؤسف للغاية

178
00:11:24,910 --> 00:11:26,490
المعذرة، من أنتِ؟

179
00:11:26,910 --> 00:11:28,910
.آسفة، نسيت تقديم نفسي

180
00:11:28,910 --> 00:11:32,170
.اسمي هو هاناكا نودوكا

181
00:11:32,170 --> 00:11:37,420
أنا... أقوم ببحث عن التّخاطر
.في علم النّفس في الجامعة

182
00:11:37,800 --> 00:11:39,420
الظّواهر الخارقة؟

183
00:11:40,130 --> 00:11:42,760
.تعرف أحد معارفي الكثير عن الظّواهر الخارقة

184
00:11:42,760 --> 00:11:47,010
مهلاً، هل أنت من نصح كيريساكي-سينسي
بالمجيء إلى قرية كوراين؟

185
00:11:47,310 --> 00:11:50,390
!نعم! سررت بلقائك

186
00:11:51,230 --> 00:11:55,810
إذًا فقد كنتِ في الغرفة الجانبيّة طوال
الوقت، ولم تعلمي بالجريمة؟

187
00:11:55,810 --> 00:11:57,150
.هذا صحيح

188
00:11:57,150 --> 00:12:00,110
،شعرتُ بالإعياء بعد الغداء

189
00:12:00,110 --> 00:12:03,660
!لذلك أخذتُ قيلولة في الغرفة الجانبيّة طوال الوقت

190
00:12:03,990 --> 00:12:05,620
...قيلولة

191
00:12:05,620 --> 00:12:07,830
اسمك المحقّق إيتونوكو، صحيح؟

192
00:12:07,830 --> 00:12:10,500
هل أستطيع أخذك لساحة الجريمة؟

193
00:12:10,500 --> 00:12:12,160
.من فضلك

194
00:12:12,160 --> 00:12:15,290
."كما أنّ اسمي ليس "إيتونوكو" بل "إيتونوكوغيري

195
00:12:15,710 --> 00:12:16,880
.لنذهب في الحال

196
00:12:17,960 --> 00:12:19,550
!حا-حاضر

197
00:12:20,210 --> 00:12:23,630
،عليّ أن أستجوب كلّ الحاضرين هنا لاحقًا

198
00:12:23,630 --> 00:12:26,300
لا تغادروا المكان، مفهوم؟

199
00:12:26,300 --> 00:12:27,550
!كفاك ثرثرة

200
00:12:27,550 --> 00:12:28,510
!حاضر

201
00:12:35,650 --> 00:12:37,860
هل تعلم يا ناروهودو؟

202
00:12:37,860 --> 00:12:38,570
ماذا؟

203
00:12:39,110 --> 00:12:41,610
إنّها الأخت الصّغرى

204
00:12:42,150 --> 00:12:44,900
.للرّوح الّتي استدعاها كيريساكي-سينسي

205
00:12:46,280 --> 00:12:48,070
للرّوح؟

206
00:12:48,070 --> 00:12:51,700
.أقصد الممرّضة الّتي قتلت أولئك المرضى الأربعة عشر

207
00:12:51,700 --> 00:12:52,370
—ما

208
00:12:53,960 --> 00:12:56,290
.اسمها هو هاناكا ميمي

209
00:12:56,290 --> 00:13:00,130
بعد أن وجّهت ضربة قاضية لمستشفى
،كيريساكي كما تعلم

210
00:13:00,130 --> 00:13:01,460
.ماتت في حادثة سير

211
00:13:01,960 --> 00:13:04,420
.وهذه الفتاة هي أختها الصّغرى

212
00:13:04,420 --> 00:13:09,430
لكنّها نصحت كيريساكي-سينسي
.بالمجيء إلى قرية كوراين

213
00:13:09,800 --> 00:13:13,680
.وقد رافقته كلّ هذه المسافة إلى هنا

214
00:13:14,140 --> 00:13:17,060
هنالك شيء ما ليس في محلّه، صحيح؟

215
00:13:21,940 --> 00:13:24,820
.يبدو أنّ تحقيقهم في ساحة الجريمة قد انتهى

216
00:13:24,820 --> 00:13:25,650
!لحظة

217
00:13:26,110 --> 00:13:29,870
.أعتقد أنّي سآخذ نظرة بما أنّ الفرصة سانحة

218
00:13:29,870 --> 00:13:32,370
.أنت أشجع ممّا يبدو عليك

219
00:13:37,790 --> 00:13:41,340
أصيب كيريساكي-سينسي
في رأسه برصاصة  مسدّس؟

220
00:13:41,340 --> 00:13:43,800
.هذا ما قاله المحقّق إيتونوكو

221
00:13:43,800 --> 00:13:47,380
.قبل ذلك، تمّ طعنه أيضًا بسكّين في صدره

222
00:13:47,380 --> 00:13:49,720
.كان يجب إنهاء الأمر بهجمة واحدة

223
00:13:53,470 --> 00:13:54,640
...ثقب

224
00:13:54,640 --> 00:13:55,730
أهو ثقب رصاصة؟

225
00:13:56,430 --> 00:13:58,940
.حينها، سمعنا طلقتين ناريّتين

226
00:13:59,440 --> 00:14:01,150
هل أصابت رصاصة طائشة الجدار؟

227
00:14:01,150 --> 00:14:02,690
.طُعن بسكّين

228
00:14:02,690 --> 00:14:04,110
.وأُردي قتيلاً بمسدّس

229
00:14:04,530 --> 00:14:05,990
.هذا فظيع بالفعل

230
00:14:06,400 --> 00:14:09,450
.ما كانت مايوي-تشان لتفعل هذا

231
00:14:09,450 --> 00:14:11,740
!نادها مايوي-ساما

232
00:14:11,740 --> 00:14:13,450
،عندما حدثت الجريمة

233
00:14:13,450 --> 00:14:16,500
.لم تكن مايوي-ساما هي مايوي-ساما

234
00:14:16,790 --> 00:14:18,830
ما-ما الّذي تعنينه؟

235
00:14:18,830 --> 00:14:23,040
عندما استدعاء روح ما، تفقد
.الوسيطة الرّوحيّة وعيها

236
00:14:23,040 --> 00:14:26,840
.بشكل أساسيّ، فإنّ الوسيطة تعير جسدها للرّوح

237
00:14:27,170 --> 00:14:32,260
لذلك إن استدعت وسيطة
،غير خبيرة روحًا قويّة الإرادة

238
00:14:32,260 --> 00:14:35,720
.فقد يتسبّب ذلك بحوادث مأساويّة كهذه

239
00:14:36,020 --> 00:14:39,270
إذًا، فروح هاناكا ميمي هي من فعلت هذا؟

240
00:14:39,270 --> 00:14:40,350
ماذا؟

241
00:14:40,350 --> 00:14:41,350
!هذا سخيف

242
00:14:41,350 --> 00:14:45,230
.بغضّ النّظر عن ذلك، لا طائل يُرجى من هذا

243
00:14:45,230 --> 00:14:50,320
أنوي تقديم المساعدة الّتي تحتاجها مايوي-ساما
.قدر الإمكان لتقليل عقابها ولو قليلاً

244
00:14:50,320 --> 00:14:53,870
.لسنا واثقين بعد أنّ مايوي-ساما هي القاتلة

245
00:14:55,080 --> 00:14:59,410
هذه جريمة قتل غير مسبوقة جرت
.خلال عملية استدعاء روح

246
00:14:59,960 --> 00:15:02,710
هل الرّوح الّتي استُدعيت هي من ارتكبت الجريمة؟

247
00:15:02,710 --> 00:15:07,260
أم أنّ هنالك حقيقة مظلمة أخرى خلف هذا؟

248
00:15:07,260 --> 00:15:08,880
.سوف أسبر أغوار هذا اللّغز بكلّ تأكيد

249
00:15:09,800 --> 00:15:12,140
.لك كامل الحرّيّة لتحاول ذلك

250
00:15:12,140 --> 00:15:15,760
أنت محامي دفاع قبل كلّ شيء، صحيح؟

251
00:15:17,560 --> 00:15:18,390
.إلى اللّقاء

252
00:15:19,980 --> 00:15:21,810
!يا لها من جدّة غريبة

253
00:15:25,320 --> 00:15:26,270
!مهلاً

254
00:15:27,230 --> 00:15:28,570
ما المشكلة؟

255
00:15:28,570 --> 00:15:30,450
شعري الشّائك؟

256
00:15:33,200 --> 00:15:34,870
ما هذه الجرّة؟

257
00:15:37,700 --> 00:15:38,950
!مهلاً يا هارومي-تشان

258
00:15:38,950 --> 00:15:41,500
هل يمكننا التّحدّث إن لم تمانعي؟

259
00:15:43,880 --> 00:15:46,210
.أنا صديق لمايوي-تشان

260
00:15:46,210 --> 00:15:48,590
.اسمي هو ناروهودو ريويتشي، وأنا محامي دفاع

261
00:15:49,090 --> 00:15:50,630
...ناروهودو

262
00:15:50,630 --> 00:15:54,300
إذًا فأنت هو ناروهودو-كُن الّذي سمعتُ عنه بالفعل؟

263
00:15:54,300 --> 00:15:56,300
نا... ناروهودو-كُن؟

264
00:15:56,300 --> 00:15:59,060
.نعم. بالطّبع أنا أعرفك

265
00:15:59,350 --> 00:16:02,230
!أنت شخص مميّز لمايوي-ساما

266
00:16:02,230 --> 00:16:04,480
!ما-ما-ماذا؟

267
00:16:04,730 --> 00:16:06,810
.سمعتُ الكثير عنك

268
00:16:06,810 --> 00:16:10,110
سمعت أنّك أفضل محامٍ في العالم
!فيما يخصّ الانهيار بسبب القلق

269
00:16:11,190 --> 00:16:12,650
أيّ نوع من المحامين هو ذاك؟

270
00:16:12,650 --> 00:16:16,870
سوف تقوم بالدّفاع عن مايوي-ساما، صحيح؟

271
00:16:17,490 --> 00:16:19,330
!بالطّبع ستدافع عنها

272
00:16:19,330 --> 00:16:20,870
.هذا أشبه بقصّة خياليّة جميلة

273
00:16:20,870 --> 00:16:23,250
.يا لتلك النّظرة الجدّيّة والعينان اللاّمعتان

274
00:16:23,250 --> 00:16:24,210
...لا بدّ أنّه حبّ حقيقيّ

275
00:16:24,210 --> 00:16:25,920
!تـ-توقّفي

276
00:16:25,920 --> 00:16:27,090
!أكاد أموت من شدّة الإحراج

277
00:16:29,000 --> 00:16:32,130
.أنا أياساتو هارومي

278
00:16:32,130 --> 00:16:33,840
.سعيدة بالتّعرّف إليك

279
00:16:34,340 --> 00:16:35,340
.وأنا أيضًا

280
00:16:35,840 --> 00:16:38,810
أنت ابنة خالة مايوي-تشان، صحيح؟

281
00:16:38,810 --> 00:16:39,930
هل أنتما صديقتين؟

282
00:16:39,930 --> 00:16:42,430
!صديقتين"؟ لا أجرؤ على قول ذلك أبدًا"

283
00:16:42,430 --> 00:16:45,690
.أريد أن أكون مثلها عندما أكبر
.إنّها قدوتي

284
00:16:46,020 --> 00:16:48,560
مثل مايوي-تشان؟

285
00:16:48,820 --> 00:16:51,900
هل ناديتَها "مايوي-تشان" بالفعل؟

286
00:16:51,900 --> 00:16:54,950
.كنتُ لأضربك في العادة

287
00:16:54,950 --> 00:16:57,030
...آ-آسف على ذلك

288
00:16:57,030 --> 00:17:00,080
.لكن لا بأس إن كان أنت يا ناروهودو-كُن

289
00:17:00,080 --> 00:17:03,960
.لأنّك شخص مميّز بالنّسبة لها

290
00:17:03,960 --> 00:17:06,120
...رويدكِ عليّ

291
00:17:06,120 --> 00:17:07,420
.حسنًا

292
00:17:07,420 --> 00:17:11,340
.سوف أساعدك من أجل مايوي-ساما

293
00:17:11,340 --> 00:17:15,380
...لحظة، آمُل أن يساعدك هذا

294
00:17:15,380 --> 00:17:17,800
.لا داعي للقيام بشيء قد يزعجكِ

295
00:17:17,800 --> 00:17:19,760
.لا بأس بمجرّد التّحدّث معي

296
00:17:24,480 --> 00:17:26,730
هاورمي-تشان، من أين حصلتِ على هذا؟

297
00:17:26,730 --> 00:17:29,610
.وجدتُه في محرقة الحديقة

298
00:17:29,610 --> 00:17:30,900
المحرقة؟

299
00:17:30,900 --> 00:17:31,650
.نعم

300
00:17:31,980 --> 00:17:32,900
.هناك

301
00:17:34,360 --> 00:17:36,400
لماذا كان في المحرقة؟

302
00:17:36,400 --> 00:17:39,320
.إن كان سيساعدك، فسأعطيك إيّاه بكلّ سرور

303
00:17:39,320 --> 00:17:40,830
.خذه رجاءً

304
00:17:40,830 --> 00:17:42,330
.شكرًا لك يا هارومي-تشان

305
00:17:43,410 --> 00:17:46,040
!ناروهودو

306
00:17:47,830 --> 00:17:50,290
!إنّ الشّرطة تأخذ مايوي-هان

307
00:17:53,250 --> 00:17:54,510
!مايوي-تشان

308
00:17:53,250 --> 00:17:54,510
!مايوي-ساما

309
00:17:55,090 --> 00:17:56,880
...هامي-تشان... ناروهودو-كُن

310
00:17:59,640 --> 00:18:02,430
لا أصدّق أنّه قد خرجت مجرمة
...من رحم عائلة أياساتو الرئيسيّة

311
00:18:02,430 --> 00:18:05,520
كيف سنشرح هذا لأسلافنا؟

312
00:18:05,520 --> 00:18:07,440
.اخرسا انتما الاثنتان

313
00:18:07,440 --> 00:18:10,860
.مايوي-ساما هي ممثّلة للعائلة الرّئيسيّة في كوراين

314
00:18:10,860 --> 00:18:13,690
.لكنّها كانت تفتقر للخبرة قليلاً

315
00:18:13,690 --> 00:18:15,940
.هذا كلّ شيء

316
00:18:20,780 --> 00:18:22,450
!مايوي-ساما

317
00:18:24,540 --> 00:18:25,870
...ناروهودو-كُن

318
00:18:37,470 --> 00:18:38,470
!ناروهودو-كُن

319
00:18:38,470 --> 00:18:40,720
.وأخيرًا تسنّت لي رؤيتك يا مايوي-تشان

320
00:18:40,720 --> 00:18:41,800
ما العمل؟

321
00:18:41,800 --> 00:18:44,890
!لم أتخيّل أبدًا أن ينتهي المطاف هكذا

322
00:18:44,890 --> 00:18:46,140
.اهدئي في الوقت الحاليّ

323
00:18:46,600 --> 00:18:47,390
.اجلسي

324
00:18:50,390 --> 00:18:54,570
لقد عدنا حيث بدأنا، صحيح؟

325
00:18:56,360 --> 00:18:58,690
أتتذكّرين حين تقابلنا هنا أوّل مرّة؟

326
00:19:00,450 --> 00:19:02,200
.كان ذلك في غرفة الزّيارة هذه أيضًا

327
00:19:02,530 --> 00:19:07,120
.نعم، وقد أنقذت حياتي

328
00:19:09,580 --> 00:19:13,250
.وعدت أنا وتسبّبت بالحزن لهامي-تشان وخالتي

329
00:19:13,540 --> 00:19:14,840
هامي-تشان؟

330
00:19:14,840 --> 00:19:16,380
تقصدين هارومي-تشان؟

331
00:19:16,750 --> 00:19:18,420
.إنّها طفلة جيّدة

332
00:19:18,420 --> 00:19:21,590
.وعلى عكسي، فهي ذكيّة أيضًا

333
00:19:21,590 --> 00:19:22,800
.ربمّا معك حقّ

334
00:19:24,220 --> 00:19:26,390
...أنا خائفة يا ناروهودو-كُن

335
00:19:26,760 --> 00:19:28,470
،عندما تتلبّسني روح ما

336
00:19:28,930 --> 00:19:31,310
،أفقد وعيي

337
00:19:31,310 --> 00:19:33,190
...لذلك لا أعرف أيّ شيء

338
00:19:33,190 --> 00:19:36,860
!مات ذلك الرّجل بسببي

339
00:19:38,280 --> 00:19:39,900
.لم تكن غلطتك

340
00:19:39,900 --> 00:19:42,200
.روح ميمي-سان هي الفاعلة

341
00:19:42,530 --> 00:19:45,240
.ذلك لا يهمّ. كانت أنا في كلّ الأحوال

342
00:19:45,240 --> 00:19:47,160
على أيّ حال، متى المحاكمة؟

343
00:19:48,370 --> 00:19:49,910
غدًا، لماذا؟

344
00:19:49,910 --> 00:19:52,670
.إذًا فسأجهّز طلب الدّفاع في الحال

345
00:19:52,670 --> 00:19:55,000
!لكنّي المتّهمة

346
00:19:56,170 --> 00:19:57,130
—أنا قاتلة

347
00:19:57,130 --> 00:19:57,630
!توقّفي

348
00:19:59,170 --> 00:20:01,130
.أنتِ لم تقتلي أيّ أحد

349
00:20:01,630 --> 00:20:02,930
.لذلك ستكونين على ما يرام

350
00:20:04,140 --> 00:20:06,390
...ساعدني يا ناروهودو-كُن

351
00:20:07,680 --> 00:20:08,760
.دعي الأمر لي

352
00:20:16,810 --> 00:20:18,520
!ناروهودو-كُن

353
00:20:19,980 --> 00:20:21,360
هارومي-تشان؟

354
00:20:23,150 --> 00:20:27,580
.أتيتُ لأنّي كنتُ قلقة

355
00:20:27,580 --> 00:20:29,410
أتيتِ إلى هنا وحدكِ؟

356
00:20:29,870 --> 00:20:30,750
.نعم

357
00:20:30,750 --> 00:20:33,710
!أريد مساعدة مايوي-ساما أيضًا

358
00:20:33,710 --> 00:20:34,580
...لذلك

359
00:20:35,630 --> 00:20:36,580
.فهمت

360
00:20:37,040 --> 00:20:39,880
.لنبذل جهدنا نحن الإثنين من أجل مايوي-تشان

361
00:20:39,880 --> 00:20:40,710
.أجل

362
00:20:42,470 --> 00:20:43,670
...المحقّق إيتونوكو

363
00:20:43,670 --> 00:20:45,550
!لا تكرهني رجاءً يا فتى

364
00:20:45,550 --> 00:20:48,050
!فلا خيار أمامي بصفتي محقّقًا

365
00:20:48,050 --> 00:20:49,310
.أعلم ذلك

366
00:20:49,890 --> 00:20:53,430
.مهما كان الأمر، فسأثبت براءة مايوي-تشان

367
00:20:53,430 --> 00:20:55,310
...لن يكون الأمر بتلك السّهولة

368
00:20:55,310 --> 00:20:59,570
.فالمدّعي العامّ كاروما من سيُجري محاكمة اليوم

369
00:20:59,570 --> 00:21:00,730
المدّعي العام كاروما؟

370
00:21:00,730 --> 00:21:04,030
...لـ-لكن ألم يتمّ إيقافه

371
00:21:04,030 --> 00:21:06,360
.ستواجه اليوم خليفته

372
00:21:08,240 --> 00:21:10,030
،إنّها ابنة المدّعي العامّ كاروما

373
00:21:10,030 --> 00:21:13,160
،وقد أصبحت مدّعٍ عامّ في سنّ صغيرة
.ولم تخسر أيّ قضيّة أبدًا

374
00:21:13,160 --> 00:21:15,540
.إنّها ما يمكن تسميته بالأعجوبة

375
00:21:16,370 --> 00:21:17,420
...كاروما

376
00:21:17,960 --> 00:21:20,420
المدّعي العامّ الأسطوريّ الّذي
،لم يُهزم لأربعين عامًا

377
00:21:20,800 --> 00:21:22,960
.الرّجل الّذي قاتلتُه بكلّ ما لديّ

378
00:21:24,260 --> 00:21:25,510
.لإنقاذه

379
00:21:30,180 --> 00:21:32,100
.توقّف... عليّ أن أنسى هذا

380
00:21:32,390 --> 00:21:34,430
!لقد مات

381
00:21:41,820 --> 00:21:43,940
...ناروهودو ريويتشي

382
00:23:20,210 --> 00:23:21,250
!أعترض

383
00:23:21,250 --> 00:23:23,920
.مايوي-تشان متّهمة بالقتل ثانية

384
00:23:24,130 --> 00:23:25,540
.لكنّها ليست الجانية

385
00:23:25,540 --> 00:23:27,510
!أعرف ذلك خير المعرفة

386
00:23:27,510 --> 00:23:30,050
.وها قد ظهر عدوّ جديد

387
00:23:30,050 --> 00:23:32,090
في مقعد المدّعي العامّ لهذه المحاكمة

388
00:23:32,090 --> 00:23:33,800
.يجلس سوط رشيق

389
00:23:33,800 --> 00:23:36,220
.أتت كاروما مي كلّ هذه المسافة لهزيمتي

390
00:23:36,510 --> 00:23:38,520
.إنّها ابنة المدّعي العامّ

391
00:23:38,520 --> 00:23:40,850
.في هذه المحاكمة، لا أستطيع أن أتهاون ولو لثانية

392
00:23:40,850 --> 00:23:43,060
!سأنقذ مايوي-تشان مهما كلّف الأمر

393
00:23:43,060 --> 00:23:44,150
!سأعثر على المتناقضات

394
00:23:44,150 --> 00:23:45,310
!وأكتشف الحقيقة

395
00:23:45,310 --> 00:23:48,650
!"في الحلقة القادمة: "لقاء وتغيّر — المحاكمة الثّانية

396
00:23:48,650 --> 00:23:49,690
!خذ هذه