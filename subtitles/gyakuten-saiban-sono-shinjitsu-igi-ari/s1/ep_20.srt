1
00:00:00,660 --> 00:00:02,920
تأخذ ميريكا الطّعام كلّ يوم

2
00:00:02,920 --> 00:00:04,940
.إلى البهلوانيّ المقعد أكرو

3
00:00:05,210 --> 00:00:07,230
،بعد حادثة وقعت قبل ستّة أشهر
،فإنّ شقيقه الصّغير بات

4
00:00:07,470 --> 00:00:08,650
.ما زال لم يستعد وعيه بعد

5
00:00:09,030 --> 00:00:11,150
ما كان دافع القاتل الحقيقيّ؟

6
00:00:11,150 --> 00:00:13,450
وهم قاعة المحكمة الّذي سيكشف عن كلّ شيء

7
00:00:13,440 --> 00:00:14,580
!سيبدأ الآن

8
00:01:45,870 --> 00:01:46,750
!أعترض

9
00:01:46,960 --> 00:01:49,670
.سينتهي خداعك هنا يا ناروهودو ريويتشي

10
00:01:51,190 --> 00:01:52,760
.انظر إلى الشّاهد فحسب

11
00:01:52,760 --> 00:01:54,640
،إنّه غير قادر حتّى على استعمال الدّرج بمفرده

12
00:01:54,640 --> 00:01:56,370
.ناهيك عن مغادرة المسكن

13
00:01:56,370 --> 00:01:58,130
!ما كان ليستطيع ارتكاب هذه الجريمة

14
00:01:58,600 --> 00:02:00,090
.نعم، هذا أكيد

15
00:02:00,450 --> 00:02:03,020
.أنا لستُ ساحرًا

16
00:02:03,020 --> 00:02:06,120
هل ستقول أنّ لديّ شريكًا في الجريمة؟

17
00:02:06,120 --> 00:02:07,390
.كلاّ

18
00:02:07,390 --> 00:02:10,450
!ارتكبتَ الجريمة بنفسك

19
00:02:11,400 --> 00:02:12,750
!كلّ هذا غباء

20
00:02:12,750 --> 00:02:15,660
هل لديك أيّ دليل إذًا؟

21
00:02:16,190 --> 00:02:20,450
أخبرنا كيف يستطيع هذا الشّاهد
ارتكاب الجريمة بالضّبط؟

22
00:02:20,780 --> 00:02:22,660
.حسنًا، بكلّ تأكيد

23
00:02:23,530 --> 00:02:26,620
.يبدو أنّك جادّ في هذا يا سيّدي المحاميّ

24
00:02:27,370 --> 00:02:31,470
.سيعرف جميع من هنا كيف فعلتَها

25
00:02:31,460 --> 00:02:34,630
.لكنّهم لن يسمعوا ذلك منّي أنا فقط

26
00:02:34,630 --> 00:02:35,750
ماذا؟

27
00:02:39,120 --> 00:02:42,280
في تلك اللّيلة، اتّجه مدير الحلبة إلى السّاحة

28
00:02:42,280 --> 00:02:44,200
.بعد أن تلقّى دعوة من ملاحظة

29
00:02:44,720 --> 00:02:47,770
.كان يوجد صندوق خشبيّ كبير بانتظاره هناك

30
00:02:47,770 --> 00:02:51,910
.ما أراده هو الغرض الّذي داخل الصّندوق

31
00:02:52,440 --> 00:02:56,460
.لكنّ الصّندوق كان مغلقًا ولم يستطع فتحه

32
00:02:57,230 --> 00:03:01,030
فحاول مدير الحلبة أخذ الصّندوق بأكمله
.معه بعد أن نفدت منه خيارات فتحه

33
00:03:05,770 --> 00:03:06,540
،وفي تلك اللّحظة

34
00:03:07,280 --> 00:03:11,870
.نزل سلاح مميت مندفعًا نحو رأسه

35
00:03:13,920 --> 00:03:14,810
—ما

36
00:03:14,810 --> 00:03:15,670
!يا إلهي

37
00:03:15,960 --> 00:03:18,170
ماكس غالاكتيكا؟

38
00:03:18,170 --> 00:03:19,090
.بالضّبط

39
00:03:19,090 --> 00:03:21,770
الشّيء الّذي وقع على رأس مدير الحلبة

40
00:03:21,770 --> 00:03:25,280
كانت الجائزة الّتي فاز بها المدّعى عليه
،في مسابقة السّحر الكبرى

41
00:03:25,280 --> 00:03:27,180
!تمثال نصفيّ له بحجم حقيقيّ

42
00:03:30,180 --> 00:03:33,440
!وهنا بدأت الخدعة السّحريّة العجيبة

43
00:03:34,300 --> 00:03:37,070
!خذوا نظرة بالعرض البطيء للحظة المعجزة

44
00:03:44,070 --> 00:03:46,740
!ماذا؟! إنّه ماكس
!ماكس الطّائر

45
00:03:53,910 --> 00:03:57,930
هذه هي الحقيقة بأكملها
.وراء ما حدث في السّاحة تلك اللّيلة

46
00:03:57,930 --> 00:04:00,760
والوحيد القادر على فعلها

47
00:04:00,760 --> 00:04:03,290
هو الرّجل الّذي يعيش في الغرفة
،فوق ساحة الجريمة

48
00:04:03,290 --> 00:04:04,720
!أكرو-سان

49
00:04:07,750 --> 00:04:09,220
ما هذا؟

50
00:04:12,850 --> 00:04:15,060
!مهلاً لحظة يا ناروهودو ريويتشي

51
00:04:15,060 --> 00:04:18,000
أتقترح أنّ هذا ما حدث بالفعل؟

52
00:04:18,440 --> 00:04:22,360
كيف أمكنه استخدام الكرسيّ المتحرّك
وهو يحمل تمثالاً نصفيًّا ثقيلاً؟

53
00:04:22,700 --> 00:04:25,280
.لم يكن هنالك أيّ داعٍ لذلك

54
00:04:25,280 --> 00:04:28,870
.كلّ ما احتاجه أكرو-سان هو إسقاطه من النّافذة

55
00:04:28,870 --> 00:04:30,240
...لـ-لكن

56
00:04:30,240 --> 00:04:33,760
كيف أمكنه إسقاطه على رأس الضّحيّة بدقّة؟

57
00:04:33,760 --> 00:04:34,540
—من المستحيل أن

58
00:04:34,540 --> 00:04:36,250
.هنا يحين دور الصّندوق الخشبيّ

59
00:04:37,400 --> 00:04:41,130
إذا أسقط التّمثال في اللّحظة الّتي سيحاول
،فيها الضّحيّة حمل الصّندوق

60
00:04:41,130 --> 00:04:43,260
!فلا يمكن أن يخطئ الهدف

61
00:04:43,760 --> 00:04:46,210
وكيف أخذ ذلك الصّندوق إلى ساحة الجريمة؟

62
00:04:46,210 --> 00:04:47,730
.الأمر بسيط

63
00:04:47,730 --> 00:04:51,070
.ربطه بالحبال وأنزله من النّافذة

64
00:04:51,070 --> 00:04:52,320
ماذا عن التّمثال إذًا؟

65
00:04:52,320 --> 00:04:54,490
.لا يستطيع الشّاهد صعود الدّرج بمفرده

66
00:04:54,490 --> 00:04:56,150
كيف أخذه إلى غرفته؟

67
00:04:56,500 --> 00:04:58,060
...على الأرجح أنّه

68
00:04:59,150 --> 00:05:00,640
قـ-قرد؟

69
00:05:00,640 --> 00:05:01,700
.نعم

70
00:05:01,700 --> 00:05:04,850
.هذا روسا القرد، وهو يعيش في غرفة أكرو-سان

71
00:05:04,850 --> 00:05:09,940
إنّه يحبّ الأشياء اللاّمعة ولديه عادة
.أخذها معه إلى مسكنه

72
00:05:09,940 --> 00:05:15,630
ربّما فكّر أكرو-سان في هذه الخطّة
.بعد أن رأى روسا وهو يحضر التّمثال

73
00:05:16,580 --> 00:05:20,460
كلّ هذا يثبت أنّ أكرو-سان
!يستطيع ارتكاب هذه الجريمة

74
00:05:20,460 --> 00:05:21,920
!مستحيل

75
00:05:21,920 --> 00:05:23,560
!نظام

76
00:05:23,560 --> 00:05:26,740
.ادّعاء الدّفاع استثنائيّ بالفعل

77
00:05:26,740 --> 00:05:28,810
.ولكنّه يبدو منطقيًّا أيضًا

78
00:05:28,810 --> 00:05:30,400
!لا تسمح له بخداعك

79
00:05:30,400 --> 00:05:32,930
هل نسيت أمر شهادة المهرّج؟

80
00:05:33,420 --> 00:05:36,440
.رأى المدّعى عليه يطير بعيدًا من ساحة الجريمة

81
00:05:36,440 --> 00:05:38,870
.كلّ شيء يبدو كما نراه

82
00:05:38,870 --> 00:05:40,110
...ما رآه تومي-سان هو

83
00:05:40,550 --> 00:05:44,280
!تمثال ماكس ورداءه المعلّق به

84
00:05:54,070 --> 00:05:56,290
!روعة

85
00:06:00,340 --> 00:06:02,820
!روعة

86
00:06:05,210 --> 00:06:09,180
!ها أنا أطير وأطفو وأحلّق

87
00:06:10,610 --> 00:06:12,890
!تبًّا لك يا ناروهودو ريويتشي

88
00:06:12,890 --> 00:06:16,100
كيف استطعتَ اكتشاف سرّ الخدعة السحريّة؟

89
00:06:16,110 --> 00:06:18,550
.لم أكن من كشفها

90
00:06:18,550 --> 00:06:20,560
.لقد حصلتُ على بعض المساعدة من خبير

91
00:06:21,290 --> 00:06:23,450
تعيد إنشاء الخدعة؟

92
00:06:23,450 --> 00:06:24,320
هل تمازحني؟

93
00:06:24,520 --> 00:06:26,070
.كلاّ، أنا أرجوك

94
00:06:26,480 --> 00:06:30,380
.من المستحيل أن يتعاونوا

95
00:06:30,380 --> 00:06:31,420
،ماكس-سان

96
00:06:31,420 --> 00:06:35,830
أعتقد أنّ جميع من في سيرك تاتشيمي
.عليهم أن يمرّوا بهذه المحنة معًا

97
00:06:36,150 --> 00:06:38,080
جميع من في السّيرك؟

98
00:06:38,470 --> 00:06:43,010
أخذ ماكس-سان الأدلّة الموجودة حتّى
،الآن وكشف عن السّحر

99
00:06:43,010 --> 00:06:45,370
.الخدعة وراء هذه القضيّة بأكملها

100
00:06:45,890 --> 00:06:48,890
،وبمساعدة أشخاص من السّيرك

101
00:06:48,550 --> 00:06:49,670
.لقد عدت

102
00:06:48,890 --> 00:06:51,010
.استطعنا إعادة إنشائها في قاعة المحكمة هذه

103
00:06:51,230 --> 00:06:52,140
!لماذا؟

104
00:06:52,140 --> 00:06:55,260
ألم تشهدا ضدّ المدّعى عليه؟

105
00:06:55,720 --> 00:06:59,730
نعم، لقد شكّ الجميع في أمر
.ماكس-سان في بادئ الأمر

106
00:07:00,690 --> 00:07:02,560
تريدنا أن نساعد ماكس؟

107
00:07:02,950 --> 00:07:05,640
لماذا قد نساعده؟

108
00:07:05,640 --> 00:07:09,570
.هذه هي وثائق مفاوضات راتبه مع مدير الحلبة

109
00:07:10,030 --> 00:07:15,080
لقد طلب أن يتمّ توزيع الزّيادة
.على الرّاتب عليكم جميعًا بالتّساوي

110
00:07:15,330 --> 00:07:16,330
ماذا؟

111
00:07:16,990 --> 00:07:20,870
ربّما اعتقد أنّ تلك الزّيادة
.ستقوم بتحفيزكم جميعًا

112
00:07:21,440 --> 00:07:25,090
أعتقد أنّ هذا دليل على أنّه يهتمّ
.لأمر هذا السّيرك بطريقته الخاصّة

113
00:07:27,380 --> 00:07:29,720
الرّغبة في معرفة الحقيقة

114
00:07:29,720 --> 00:07:31,630
.جمعتهم معًا

115
00:07:31,630 --> 00:07:32,930
.روعة

116
00:07:33,340 --> 00:07:34,930
ما رأيك يا أكرو-سان؟

117
00:07:35,750 --> 00:07:37,690
.هذا متوقّع من ماكس

118
00:07:37,690 --> 00:07:40,160
.كان هذا عرض سيرك ممتع

119
00:07:40,160 --> 00:07:42,600
.لكنّه كان مجرّد عرض

120
00:07:43,770 --> 00:07:46,020
.أنت ساذج يا ناروهودو ريويتشي

121
00:07:46,790 --> 00:07:49,400
.ما زال عليك إثبات شيء مهمّ للغاية

122
00:07:49,840 --> 00:07:54,110
لماذا قد أرغب في سلب حياة مدير الحلبة؟

123
00:07:54,110 --> 00:07:55,120
...هذا

124
00:07:55,440 --> 00:07:57,810
.بالضّبط. الدّافع

125
00:07:57,810 --> 00:08:00,310
.كان الضّحيّة بمثابة الأب للشّاهد

126
00:08:00,310 --> 00:08:02,160
.كان مدينًا له بشدّة

127
00:08:02,160 --> 00:08:03,870
لماذا قد يقتله إذًا؟

128
00:08:04,130 --> 00:08:06,340
هل لدى الدّفاع ما يضيفه؟

129
00:08:11,740 --> 00:08:14,800
ألا تعرف كيف تنهي ما تبدأه يا ناروهودو ريويتشي؟

130
00:08:15,530 --> 00:08:19,260
هل أنا مضطرّ بالفعل لإخبار المحكمة بالأمر؟

131
00:08:20,090 --> 00:08:22,230
.لا تقلق بشأن ذلك يا فتى

132
00:08:22,520 --> 00:08:24,440
.أرها أرجوك

133
00:08:24,910 --> 00:08:26,940
.أرها الحقيقة خلف هذه الحادثة

134
00:08:27,360 --> 00:08:28,360
.ناروهودو-كُن

135
00:08:33,050 --> 00:08:33,950
...أكرو-سان

136
00:08:34,440 --> 00:08:36,450
هل تعرف هذه الملاحظة؟

137
00:08:36,880 --> 00:08:38,610
.لقد عُثر عليها في غرفة مدير الحلبة

138
00:08:39,450 --> 00:08:40,660
غرفة مدير الحلبة؟

139
00:08:51,310 --> 00:08:53,130
ما-ما هذه؟

140
00:08:53,130 --> 00:08:55,130
،يبدو أنّه في صباح الجريمة

141
00:08:55,130 --> 00:08:57,890
.وُضعت هذه الملاحظة على لوحة إعلانات السّيرك

142
00:08:57,890 --> 00:09:01,100
ذهب الضّحيّة لساحة الجريمة بناءً
...على هذه الملاحظة

143
00:09:01,100 --> 00:09:02,220
وثُمّ قُتل؟

144
00:09:02,220 --> 00:09:05,190
:إلى القاتل
لم تنسَ ما حدث منذ ستّة أشهر، أليس كذلك؟
.بحوزتي دليل قاطع هنا
،تعال إلى الميدان أمام المسكن
في السّاعة العاشرة من هذه اللّيلة

145
00:09:02,510 --> 00:09:05,190
الحادثة الّتي وقعت قبل ستّة أشهر
المذكورة في الملاحظة

146
00:09:05,570 --> 00:09:10,080
.هي المفتاح الأخير لحلّ هذا اللّغز

147
00:09:12,900 --> 00:09:14,190
!نظام

148
00:09:14,580 --> 00:09:16,600
.كان هذا ممتعًا يا تومي

149
00:09:16,600 --> 00:09:20,030
لكن ما الّذي يعنيه بالحادثة
الّتي وقعت قبل ستّة أشهر؟

150
00:09:20,340 --> 00:09:22,620
.ميريكا، استمعي جيّدًا لما سيقوله الآن

151
00:09:22,620 --> 00:09:24,290
.إنّه مهمّ للغاية

152
00:09:24,500 --> 00:09:26,040
.حـ-حسنًا

153
00:09:26,940 --> 00:09:31,170
أيّها الدّفاع، ما الّذي حدث قبل ستّة
أشهر في سيرك تاتشيمي؟

154
00:09:31,440 --> 00:09:35,310
هذا شقيق أكرو-سان
،كينوشيتا إيبّي-سان المعروف بلقب بات

155
00:09:35,310 --> 00:09:38,890
.وقد تعرّض لهجوم أسد السّيرك في حادثة مروّعة

156
00:09:39,250 --> 00:09:40,890
!ها-هاجمه أسد؟

157
00:09:41,600 --> 00:09:45,990
.لقد نجا بات-سان وهو الآن في حالة غيبوبة

158
00:09:45,990 --> 00:09:48,670
.الادّعاء على علم تامّ بهذه الحادثة

159
00:09:48,670 --> 00:09:50,360
.كانت حادثة مؤسفة

160
00:09:52,180 --> 00:09:53,860
.إنّها لم تكن حادثة

161
00:09:54,090 --> 00:09:55,850
ما-ماذا؟

162
00:09:56,290 --> 00:10:00,570
هذا هو الوشاح الّذي قدّمته مدرّبة
.الحيوانات ميريكا-سان لبات-سان

163
00:10:01,370 --> 00:10:04,870
.يبدو أنّه قد ارتداه حول عنقه ذلك اليوم

164
00:10:04,870 --> 00:10:09,750
.فتح فم الأسد وحاول تأدية إحدى خدعها

165
00:10:10,560 --> 00:10:14,000
.وهناك وقعت حادثة مأساويّة

166
00:10:15,420 --> 00:10:17,740
،تمّ تدريب ذلك الأسد بشكل جيّد

167
00:10:17,740 --> 00:10:20,510
.وكان من غير الممكن التّفكير بأنّه سيهاجم أحدًا ما

168
00:10:20,510 --> 00:10:22,990
إذًا لماذا فعلها...؟

169
00:10:22,990 --> 00:10:26,370
.سمعتُ أنّ الأسد قد ابتسم قبل أن يعضّ ضحيّته

170
00:10:26,370 --> 00:10:27,020
ماذا؟

171
00:10:27,020 --> 00:10:31,020
ا-ابتسم؟ هل تبتسم الأسود؟

172
00:10:31,360 --> 00:10:32,520
!لم أسمع بهذا من قبل

173
00:10:33,110 --> 00:10:36,820
بعد أن تمّ تحليل وشاح بات-سان
،الّذي ارتداه ذلك اليوم

174
00:10:36,820 --> 00:10:38,530
.عثرنا على آثار لشيء ما عليه

175
00:10:38,830 --> 00:10:39,740
آثار ماذا؟

176
00:10:40,200 --> 00:10:40,950
.فلفل

177
00:10:41,320 --> 00:10:42,390
فلفل؟

178
00:10:43,210 --> 00:10:43,950
!هذا مستحيل

179
00:10:44,520 --> 00:10:46,910
.الأسد لم يبتسم

180
00:10:47,280 --> 00:10:49,270
أليس كذلك يا أكرو-سان؟

181
00:10:50,120 --> 00:10:54,290
،نعم. لقد عطس الأسد بكلّ بساطة حينها

182
00:10:54,290 --> 00:10:57,190
.بسبب الفلفل الّذي كان يغطّي الوشاح

183
00:10:57,190 --> 00:10:58,050
فلفل؟

184
00:10:58,050 --> 00:11:01,000
تقصد كالفلفل الّذي كان في الصّندوق الخشبيّ؟

185
00:11:01,000 --> 00:11:01,940
.بالضّبط

186
00:11:01,930 --> 00:11:05,510
.الدّليل القاطع" الّذي ذُكر في الملاحظة هو الفلفل"

187
00:11:05,510 --> 00:11:07,080
.يا إلهي

188
00:11:07,080 --> 00:11:09,140
.هذه هي النّتائج للتّحاليل المجراة على الوشاح

189
00:11:09,490 --> 00:11:10,890
.إنّ المحكمة تقبل بها كدليل

190
00:11:11,680 --> 00:11:13,210
عطس بسبب الفلفل؟

191
00:11:13,210 --> 00:11:16,150
أيّ نوع من النّكات هي هذه يا ناروهودو ريويتشي؟

192
00:11:16,600 --> 00:11:19,960
.لسوء الحظّ، هذه هي الحقيقة

193
00:11:19,960 --> 00:11:22,980
،وبمجرّد أن عرف أكرو-سان بالحقيقة

194
00:11:22,980 --> 00:11:24,780
...خطّط لانتقامه

195
00:11:25,390 --> 00:11:28,700
.ضدّ الشّخص الّذي أهدى الوشاح لشقيقه

196
00:11:29,090 --> 00:11:30,620
أ-أنا؟

197
00:11:30,940 --> 00:11:33,630
...إذًا، الهدف الحقيقي كان

198
00:11:34,000 --> 00:11:34,850
.نعم

199
00:11:34,850 --> 00:11:37,340
،لم يكن مدير الحلبة بل ابنته

200
00:11:37,760 --> 00:11:40,250
!مدرّبة الحيوانات ميريكا-سان

201
00:11:43,600 --> 00:11:47,930
لقد وضعتَ الملاحظة خلسة في جيبها
.عندما أحضرت لك الفطور

202
00:11:47,930 --> 00:11:51,230
،ولكنّها لم تكن تعلم ماذا تعني

203
00:11:51,230 --> 00:11:53,600
.لذلك وضعتْها على لوحة إعلانات المطعم

204
00:11:54,300 --> 00:11:57,230
وعثر عليها مدير الحلبة تاتشيمي؟

205
00:11:57,510 --> 00:12:00,750
.على الأرجح أنّه عرف حقيقة الحادثة

206
00:12:00,750 --> 00:12:03,660
،ولذلك وبغرض حماية ابنته

207
00:12:04,060 --> 00:12:05,530
.ذهب بمفرده إلى ساحة الجريمة

208
00:12:06,810 --> 00:12:09,750
ذ-ذهب بابا بدلاً عنّي؟

209
00:12:10,100 --> 00:12:12,520
،لا يستطيع أكرو-سان مغادرة كرسيّه المتحرّك

210
00:12:12,520 --> 00:12:16,720
وبالتّالي لم يدرك أنّ الشّخص الّذي أسفل
.النّافذة ليس ميريكا-سان

211
00:12:17,340 --> 00:12:20,550
.لذلك استمرّ في ما خطّط له وقتله دون علم

212
00:12:20,550 --> 00:12:22,550
!ما-ما هذا؟

213
00:12:22,860 --> 00:12:26,520
أكرو-سان، ظننتَ أنّك تنتقم من ميريكا-سان

214
00:12:26,520 --> 00:12:30,470
لكنّك قتلتَ مدير الحلبة تاتشيمي
!الّذي تدين له بحياتك في النهاية

215
00:12:30,780 --> 00:12:32,730
ما قولك أيّها الشّاهد؟

216
00:12:34,180 --> 00:12:35,690
هل لديك دليل؟

217
00:12:36,850 --> 00:12:37,900
أكرو-سان؟

218
00:12:38,630 --> 00:12:42,400
هل لديك دليل أنّي رميتُ ذلك
التّمثال عليه تلك اللّيلة؟

219
00:12:43,780 --> 00:12:47,780
قامت الشّرطة ببحث عميق
.في سيرك تاتشيمي البارحة

220
00:12:47,780 --> 00:12:52,580
لكنّهم لم يعثروا على تمثال
.ماكس غالاكتيكا في غرفة الشّاهد هذه

221
00:12:52,840 --> 00:12:54,410
ما-ماذا؟

222
00:12:54,860 --> 00:12:59,610
في تلك الحالة، أين التّمثال؟

223
00:12:59,610 --> 00:13:03,580
لقد جهّزنا لائحة بكلّ الأشياء
.الّتي عثرنا عليها في السّيرك

224
00:13:03,580 --> 00:13:05,630
!لكنّنا لم نعثر على التّمثال في أيّ مكان

225
00:13:06,200 --> 00:13:07,600
لم تعثروا عليه؟

226
00:13:07,600 --> 00:13:12,140
أي أنّك لا تملك أيّ دليل يربطني بسلاح الجريمة؟

227
00:13:13,930 --> 00:13:15,830
،أنا آسف يا سيّدي المحاميّ

228
00:13:15,830 --> 00:13:18,180
.لكن لا يمكن اعتقالي

229
00:13:18,180 --> 00:13:20,610
!كفّ عن المقاومة يا أكرو

230
00:13:20,610 --> 00:13:22,270
!قل الحقيقة

231
00:13:23,370 --> 00:13:24,530
...أكرو

232
00:13:25,520 --> 00:13:26,610
!نظام

233
00:13:27,030 --> 00:13:31,990
.عليّ رفض ادّعاءات الدّفاع لعدم وجود أدلّة

234
00:13:31,980 --> 00:13:33,160
.أيّتها المدّعية العامّة كاروما

235
00:13:33,470 --> 00:13:37,420
.بهذا يكون استجواب الشّاهد قد انتهى

236
00:13:37,680 --> 00:13:39,270
سُحقًا. أهذه النّهاية؟

237
00:13:39,270 --> 00:13:40,120
!أعترض

238
00:13:41,120 --> 00:13:43,570
!لا تستسلم يا ناروهودو-كُن

239
00:13:43,570 --> 00:13:45,880
!تذكّر الرّسالة الّتي أعطاك إيّاها إيتونوكو-سان

240
00:13:46,400 --> 00:13:48,010
المحقّق إيتونوكو؟

241
00:13:49,170 --> 00:13:51,040
.كما أنّي أملك رسالة لك

242
00:13:51,040 --> 00:13:54,100
".سيتمّ البوح بالحكم في آخر ثانية بكلّ تأكيد"

243
00:13:54,400 --> 00:13:55,830
آخر ثانية؟

244
00:13:55,830 --> 00:13:57,290
!أي الآن

245
00:13:57,270 --> 00:13:59,770
يعيش البهلوانيّون حياةً على المحكّ
دائمًا، أليس كذلك؟

246
00:13:59,770 --> 00:14:02,320
.وهكذا عاش أكرو-سان حياته حتّى الآن

247
00:14:02,320 --> 00:14:06,820
لكنّك سرتَ على حبال مشدودة
!مثله يا ناروهودو-كُن

248
00:14:06,820 --> 00:14:07,820
مايوي-تشان؟

249
00:14:08,110 --> 00:14:09,690
!والآن، لنسر معًا

250
00:14:09,690 --> 00:14:11,580
!فوق أكثر الحبال المشدودة الّتي سبق وسرنا عليها

251
00:14:12,020 --> 00:14:13,790
.فهمت يا مايوي-تشان

252
00:14:14,490 --> 00:14:15,590
!سعادة القاضي

253
00:14:15,590 --> 00:14:19,500
!سيريك الدّفاع أين سلاح الجريمة بالضّبط

254
00:14:19,770 --> 00:14:20,750
!ماذا؟

255
00:14:21,090 --> 00:14:23,170
.مستحيل. هذا غير ممكن

256
00:14:23,170 --> 00:14:25,040
!هذه ثرثرة غبيّ لا غير

257
00:14:25,040 --> 00:14:26,960
!أجبني في هذه اللّحظة الآن

258
00:14:26,960 --> 00:14:28,850
أين التّمثال؟

259
00:14:28,850 --> 00:14:31,670
.سيتمّ البوح بالحكم في آخر ثانية بكلّ تأكيد

260
00:14:31,680 --> 00:14:35,520
بعبارات أخرى، مكان التّمثال سيصبح
.واضحًا الآن، في هذه اللّحظة بالذّات

261
00:14:35,890 --> 00:14:39,480
.كان في غرفة أكرو-سان في أوّل يوم من التّحقيق

262
00:14:39,480 --> 00:14:41,480
.لكنّه لم يكن هنالك في اليوم الثّاني

263
00:14:41,480 --> 00:14:42,690
.هذا صحيح

264
00:14:42,690 --> 00:14:44,360
.كان هنالك بحث معمّق البارحة

265
00:14:44,360 --> 00:14:47,690
أُجبر أكرو-سان على إخفائه

266
00:14:47,690 --> 00:14:49,990
.قبل أن تفتّش الشرطة غرفته

267
00:14:50,660 --> 00:14:51,870
!هكذا الأمر إذًا

268
00:14:52,460 --> 00:14:54,860
.لديّ طلب يا أكرو-سان

269
00:14:54,860 --> 00:14:56,030
ما هو؟

270
00:14:56,580 --> 00:14:58,620
.أزل البطّانيّة الّتي على كرسيّك رجاءً

271
00:15:00,560 --> 00:15:02,040
ما معنى هذا؟

272
00:15:02,430 --> 00:15:06,110
لم تستطع الشّرطة العثور على التّمثال
.في أيّ مكان البارحة

273
00:15:06,110 --> 00:15:09,410
.وهذا يعني أنّ التّمثال قد خرج من السّيرك

274
00:15:09,410 --> 00:15:10,420
!هذا سخيف

275
00:15:10,420 --> 00:15:12,340
!لقد بحثنا في كلّ مكان

276
00:15:12,340 --> 00:15:13,770
!لم نخرج أيّ شيء

277
00:15:13,770 --> 00:15:14,830
.لقد أخطأتِ

278
00:15:14,830 --> 00:15:18,180
.هنالك ما غادر السّيرك

279
00:15:18,970 --> 00:15:20,920
.كان أنت يا أكرو-سان

280
00:15:22,100 --> 00:15:27,070
.حينها، كنتَ قد خبّأتَ التّمثال حيث لن يُعثر عليه

281
00:15:27,470 --> 00:15:28,900
.مـ-مستحيل

282
00:15:30,570 --> 00:15:33,410
في تلك الحالة، يجب أن يكون ما يزال مخفيًّا

283
00:15:33,410 --> 00:15:36,080
!هنا وفي هذه اللّحظة

284
00:15:36,470 --> 00:15:39,410
!إنّه تحت البطّانيّة على كرسيّك المتحرّك

285
00:15:51,850 --> 00:15:52,880
.أحسنتَ عملاً

286
00:15:52,880 --> 00:15:54,010
!ماذا؟

287
00:15:54,010 --> 00:15:55,260
!كيف يعقل هذا؟

288
00:15:55,260 --> 00:15:56,140
!مستحيل

289
00:15:57,400 --> 00:16:01,770
لا توجد أيّ فرصة للأعذار عندما يُعثر على سلاح
الجريمة بحوزة المرء في قاعة المحكمة، صحيح؟

290
00:16:02,530 --> 00:16:03,550
.يا سعادة القاضي

291
00:16:03,550 --> 00:16:05,620
.أنا من قتل مدير الحلبة

292
00:16:05,620 --> 00:16:08,530
.كلّ ما قاله ناروهودو-سان حقيقة

293
00:16:09,630 --> 00:16:10,790
،بالتّفكير بالأمر

294
00:16:10,780 --> 00:16:15,370
فإني حكمت على مصيري بالهلاك في اللّحظة
.الّتي تمّ إصدار أمر التّفتيش ذاك

295
00:16:15,800 --> 00:16:17,360
.لقد نلت منّي

296
00:16:18,130 --> 00:16:21,450
هل بحثتم في كلّ مكان بالفعل البارحة
أيّتها المدّعية العامّة؟

297
00:16:21,450 --> 00:16:23,290
...ماذا؟ أ-أنا

298
00:16:23,530 --> 00:16:24,260
!أجل

299
00:16:24,260 --> 00:16:25,860
!يا لذا اللّحية ذاك

300
00:16:25,860 --> 00:16:27,780
،كما قال ناروهودو-سان

301
00:16:27,780 --> 00:16:31,720
.حاولت الانتقام من ميريكا لإبعادها أخي عنّي

302
00:16:32,130 --> 00:16:35,220
.في ذلك اليوم، رشّ بعض الفلفل عليها

303
00:16:35,720 --> 00:16:38,430
.وقد ضحك الجميع عندما بدأت بالعطس

304
00:16:38,920 --> 00:16:40,650
.كانت خدعة غير مؤذية

305
00:16:41,100 --> 00:16:43,810
.لقد أحبّها أخي كثيرًا

306
00:16:44,730 --> 00:16:46,850
.وما كانت تريد أن يحدث أيّ شيء سيّئ

307
00:16:46,850 --> 00:16:49,520
.أرادت أن تجعل أخي يعطس فحسب أيضًا

308
00:16:50,020 --> 00:16:51,770
.كنت أعرف ذلك

309
00:16:51,770 --> 00:16:56,240
!لكنّها لم تدرك ما فعلتْه

310
00:16:57,300 --> 00:17:00,410
،أخبرني، إن أصبح بات نجمة أيضًا

311
00:17:00,410 --> 00:17:03,750
فهل سيبتسم لي من السّماء؟

312
00:17:05,190 --> 00:17:08,730
،لم أطق ضحكتها البريئة تلك
.مهما حاولت

313
00:17:10,550 --> 00:17:11,800
...لهذا السّبب أنا

314
00:17:12,740 --> 00:17:13,760
...أكرو-سان

315
00:17:14,050 --> 00:17:15,770
.لم أرد أن يلقى عليّ القبض

316
00:17:15,770 --> 00:17:19,600
.ظننتُ أنّه لا يمكنني المغادرة بعد

317
00:17:19,600 --> 00:17:22,420
.لكنّ هذا للأفضل

318
00:17:22,420 --> 00:17:25,260
.لقد كنتَ ضحيّة أيضًا بطريقة ما

319
00:17:25,260 --> 00:17:26,430
.كلاّ

320
00:17:26,430 --> 00:17:27,410
...أنا

321
00:17:28,720 --> 00:17:30,670
.مجرم فحسب

322
00:17:31,740 --> 00:17:37,450
.يا حاجب المحكمة، اعتقل هذا الرّجل وخذه للحجز

323
00:17:37,450 --> 00:17:38,410
!مهلاً

324
00:17:40,000 --> 00:17:41,040
ميريكا؟

325
00:17:41,030 --> 00:17:43,660
!لم أعتذر لأكرو بعد

326
00:17:44,410 --> 00:17:45,460
...ميريكا-تشان

327
00:17:46,490 --> 00:17:47,370
.ميريكا

328
00:17:47,650 --> 00:17:49,540
.أنا آسفة يا أكرو

329
00:17:49,540 --> 00:17:54,800
!لقد ابتعد كلّ من بات وبابا وليون بسببي

330
00:17:55,150 --> 00:17:56,500
!وليس بسبب أكرو

331
00:17:56,500 --> 00:17:58,940
!إنّها... إنّها غلطتي أنا

332
00:17:58,930 --> 00:18:01,050
!إن كنتم ستعتقلون أحدًا ما، فاعتقلوني أنا

333
00:18:01,430 --> 00:18:02,560
!أرجوكم

334
00:18:05,360 --> 00:18:06,760
.أنت مخطئة

335
00:18:06,760 --> 00:18:09,190
.أنا من ارتكب الجريمة

336
00:18:09,710 --> 00:18:10,840
...أكرو

337
00:18:11,290 --> 00:18:12,270
.ميريكا

338
00:18:12,270 --> 00:18:15,150
هل تفهمين لماذا حاول أكرو التّملّص من الجريمة؟

339
00:18:15,150 --> 00:18:18,360
!لم يستطع الرّحيل بالتأكيد

340
00:18:19,200 --> 00:18:20,030
بات؟

341
00:18:20,360 --> 00:18:21,450
!هذا صحيح

342
00:18:21,450 --> 00:18:23,950
!ما زال بات في غيبوبة

343
00:18:23,940 --> 00:18:28,270
أراد أكرو أن يكون إلى جانبه
!عندما يستيقظ يومًا ما

344
00:18:28,270 --> 00:18:31,620
!لذلك السّبب ارتكب خطيئة أخرى

345
00:18:31,620 --> 00:18:33,880
!هذا هو مقدار أهمّيّة حياة النّاس

346
00:18:35,010 --> 00:18:37,500
.سأكون إلى جانبه دائمًا من الآن فصاعدًا

347
00:18:37,500 --> 00:18:40,560
،إلى أن تعود، إلى أن يستيقظ بات

348
00:18:40,560 --> 00:18:42,300
!سأظلّ إلى جانبه طوال الوقت

349
00:18:53,770 --> 00:18:56,610
.سوف أنطق بالحكم الآن

350
00:18:56,610 --> 00:18:59,770
،أعلن أنّ المدّعى عليه ماكس غالاكتيكا

351
00:19:01,660 --> 00:19:02,320
!غير مذنب

352
00:19:19,010 --> 00:19:21,150
،ثمّ قلت

353
00:19:21,150 --> 00:19:23,090
!"أنا لا أحبّ المزاح أبدًا"

354
00:19:26,060 --> 00:19:28,060
.أرى أنّ ذلك الجزء لم يتغيّر

355
00:19:28,590 --> 00:19:34,350
.شكرًا "هزيلاً" لكم لزيارتكم لسيرك تاتشيمي اليوم

356
00:19:35,240 --> 00:19:39,420
من الآن فصاعدًا، سأكون أنا، المهرّج
الضّاحك، هو مدير الحلبة

357
00:19:39,420 --> 00:19:40,990
!وسأبذل جهدي لإدارة هذا السّيرك

358
00:19:41,370 --> 00:19:43,640
،هدفنا هو أن نصبح السّيرك الأفضل في العالم

359
00:19:43,640 --> 00:19:46,410
!استمرّوا في منحنا دعمكم

360
00:19:48,330 --> 00:19:49,410
ماذا؟ ماذا يحدث؟

361
00:19:49,410 --> 00:19:50,570
.ها قد بدأنا

362
00:19:50,570 --> 00:19:51,580
ماذا؟

363
00:19:52,000 --> 00:19:53,690
!روعة

364
00:19:53,690 --> 00:19:55,250
!سمعتُ كلّ شيء

365
00:19:55,550 --> 00:19:57,000
...هـ-هذا الصّوت

366
00:19:59,020 --> 00:20:02,970
هنالك شيء واحد لا يستطيع أفضل سيرك
.في العالم الاستغناء عنه

367
00:20:02,970 --> 00:20:04,390
أليس كذلك يا أعزائي؟

368
00:20:04,390 --> 00:20:07,280
!بالفعل، أفضل سحرة العالم

369
00:20:07,280 --> 00:20:09,220
!ماكس

370
00:20:09,510 --> 00:20:10,570
لماذا؟

371
00:20:10,570 --> 00:20:13,530
ألم تسأم منّا وغادرتَنا؟

372
00:20:15,060 --> 00:20:16,360
.روعة

373
00:20:16,870 --> 00:20:20,430
الأمر مختلف إن كان هذا السّيرك يسعى
.ليكون الأفضل في العالم

374
00:20:20,430 --> 00:20:23,520
،بالطّبع، هذا ممكن فقط

375
00:20:23,520 --> 00:20:26,700
.إن سامحتموني يا رفاق

376
00:20:27,530 --> 00:20:28,410
...ماكس

377
00:20:28,670 --> 00:20:30,500
ما قولك يا مدير الحلبة؟

378
00:20:33,600 --> 00:20:34,950
!شكرًا لك

379
00:20:34,950 --> 00:20:36,020
،ما دمت إلى جانبنا

380
00:20:36,020 --> 00:20:37,920
!سوف ننتصر على الجميع أينما ذهبنا

381
00:20:37,920 --> 00:20:38,560
...كلاّ

382
00:20:38,560 --> 00:20:40,980
!سوف نسحر الجميع أينما ذهبنا

383
00:20:42,810 --> 00:20:44,800
!قدّموا لنا أفضل سيرك في العالم

384
00:20:44,800 --> 00:20:46,570
!ابذلوا جهدكم

385
00:20:49,220 --> 00:20:50,910
هل ظنّوا أنّي مضحك بالفعل؟

386
00:20:51,330 --> 00:20:53,140
.كان ذلك تلاعبًا جيّدًا بالكلمات

387
00:20:54,020 --> 00:20:57,900
لنُرِ مدير الحلبة تاتشيمي
!أفضل سيرك في العالم يومًا ما

388
00:20:57,900 --> 00:21:00,090
!أجل

389
00:21:01,820 --> 00:21:03,820
كنتَ تعرف بشأن هذا يا ناروهودو-كُن؟

390
00:21:05,830 --> 00:21:07,280
!روعة

391
00:21:13,480 --> 00:21:15,540
...إذًا فالنّقطة الفاصلة كانت

392
00:21:15,540 --> 00:21:18,460
.البحث الّذي أمرتَ به أدّى دوره بالفعل

393
00:21:18,900 --> 00:21:21,710
هل كنت تعرف الحقيقة حينها؟

394
00:21:22,080 --> 00:21:23,020
.كلاّ

395
00:21:23,020 --> 00:21:26,050
.ظننتُ فقط أنّه لو كان في الدّفاع، فسيجده

396
00:21:26,480 --> 00:21:28,260
ناروهودو ريويتشي؟

397
00:21:28,710 --> 00:21:30,260
.حان الوقت

398
00:21:30,740 --> 00:21:35,780
سأتّصل برئيس المدّعين العامّين وأطلب
.ألاّ يُعامل أكرو بطريقة سيّئة

399
00:21:35,770 --> 00:21:36,560
!حاضر

400
00:21:36,560 --> 00:21:38,060
،سوف نكون بانتظارك إذًا

401
00:21:38,060 --> 00:21:40,060
!أيّها المدّعي العامّ ميتسوروغي

402
00:23:20,250 --> 00:23:21,710
!أعترض

403
00:23:21,710 --> 00:23:26,270
،دعانا نيبوشي-سان إلى عرض بطوليّ
.لكن وقعت حادثة في ذلك المكان

404
00:23:26,270 --> 00:23:29,420
ومرّة أخرى، يُتّهم الممثّل الّذي يؤدّي
.دور ساموراي الفولاذ بجريمة القتل

405
00:23:29,420 --> 00:23:34,470
،الجاني الّذي يسمّي نفسه السّفّاح
.يأخذ مايوي-تشان كرهينة ليقدّم طلباته لي

406
00:23:34,470 --> 00:23:37,160
إنّه شيء أستطيع أنا وحدي القيام به
.بصفتي محامي دفاع

407
00:23:37,160 --> 00:23:38,350
...ولكن

408
00:23:38,350 --> 00:23:40,390
،عندما أجد نفسي في وضع ميؤوس منه

409
00:23:40,390 --> 00:23:42,340
!سيعود ذلك المدّعي العامّ

410
00:23:42,340 --> 00:23:43,410
!سأعثر على المتناقضات

411
00:23:43,410 --> 00:23:44,690
!وأكتشف الحقيقة

412
00:23:44,690 --> 00:23:47,690
!"في الحلقة القادمة: "وداعًا يا تغيّري — المحاكمة الأولى

413
00:23:47,690 --> 00:23:48,440
!خذوا هذه