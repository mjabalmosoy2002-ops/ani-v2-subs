1
00:00:08,070 --> 00:00:09,820
!نانجا النّينجا

2
00:00:15,450 --> 00:00:17,030
!القائد سايبان

3
00:00:22,660 --> 00:00:25,250
!أكاديميّة العدالة، الفصل 4-2

4
00:00:29,590 --> 00:00:31,210
!أونيانكوبون

5
00:00:35,340 --> 00:00:36,930
!اللّحظة الّتي انتظرتموها جميعًا

6
00:00:36,930 --> 00:00:41,430
حان الوقت للإعلان عن الفائز بجائزة
.أبطالِ الأبطال الكبرى لهذه السّنة

7
00:00:41,430 --> 00:00:45,230
من هو البطل المحظوظ لهذه اللّيلة؟

8
00:00:45,600 --> 00:00:47,230
...والآن

9
00:00:47,230 --> 00:00:51,190
الفائز بجائزة أبطالِ الأبطال الكبرى
...الخامسة عشر هو

10
00:01:01,120 --> 00:01:05,000
!إنّه أنا

11
00:02:35,500 --> 00:02:37,840
،لقد ظهر البطل الحقيقيّ لهذه اللّيلة بيننا

12
00:02:37,840 --> 00:02:40,510
!محارب أويدو، ساموراي النّيكل

13
00:02:40,510 --> 00:02:43,720
يبدو أنّ اللّقب لم يكن لصالح
.نانجا النّينجا هذه السّنة أيضًا

14
00:02:43,930 --> 00:02:44,930
!ممتاز

15
00:02:44,930 --> 00:02:48,060
!أسمعتَ ذلك؟ لقد نجح ساموراي النّيكل

16
00:02:48,060 --> 00:02:50,480
.أنا سعيد لأنّه يوفي المسلسل حقّه

17
00:02:50,480 --> 00:02:51,770
!أجل

18
00:02:53,560 --> 00:02:56,320
...واضح أنّها مسابقة مزوّرة

19
00:02:56,730 --> 00:03:01,110
إذًا فالشّخصيّة الّتي كنتم تشجّعونها
جميعًا هي الّتي فازت؟

20
00:03:01,110 --> 00:03:02,110
.نعم

21
00:03:02,110 --> 00:03:04,950
!ألا تعرفين ساموراي النّيكل؟

22
00:03:04,950 --> 00:03:05,870
.كلاّ

23
00:03:05,870 --> 00:03:10,250
.أنا أشاهد "مسرحيّة تحف الأطفال" يوم السّبت

24
00:03:10,250 --> 00:03:11,620
.هذا ليس جيّدًا

25
00:03:11,620 --> 00:03:13,920
.كلّ الصّغار يحبّون ساموراي النّيكل

26
00:03:13,920 --> 00:03:17,630
إذًا هل يحبّ ناروهودو-كُن ساموراي النّيكل أيضًا؟

27
00:03:17,630 --> 00:03:21,260
.كلاّ، كلاّ... أصبح ناروهودو-كُن عجوزًا الآن

28
00:03:21,260 --> 00:03:22,840
ما هذا الكلام؟

29
00:03:22,840 --> 00:03:26,050
لكنّك تحمل هذه في حقيبتك دائمًا، صحيح؟

30
00:03:26,050 --> 00:03:27,100
ما هذه؟

31
00:03:27,100 --> 00:03:32,560
ساموراي الإشارة، الأبطال الأسطوريّون
.الّذين أظهروا تألّقهم في أوّل مسابقة كبرى

32
00:03:32,560 --> 00:03:34,150
.هذا يعيد لي الذّكريات بالفعل

33
00:03:34,150 --> 00:03:37,730
!لقد كانت موضوعة على مكتبه مؤخّرًا، لذلك أخذتُها

34
00:03:37,730 --> 00:03:40,110
.كلاّ، كنتُ أحتفظ بها هناك

35
00:03:42,110 --> 00:03:44,780
!هذا أنا ساموراي النّيكل، ولقد جنّ جنوني

36
00:03:46,070 --> 00:03:48,290
!مـ-مذهل يا ساموراي النّيكل

37
00:03:49,040 --> 00:03:50,160
.شكرًا لك

38
00:03:51,410 --> 00:03:54,000
.مصافحة شغوفة بين بطلين متنافسين

39
00:03:54,000 --> 00:03:57,210
.نانجا النّينجا يهنّئ ساموراي النّيكل على فوزه

40
00:03:57,210 --> 00:03:59,500
!صفّقوا له بحرارة رجاءً أيضًا

41
00:04:08,810 --> 00:04:11,640
!يدفعني هذا للبكاء

42
00:04:12,180 --> 00:04:13,520
!مهلاً، مهلاً

43
00:04:13,520 --> 00:04:15,400
!واحدة أخرى أيضًا

44
00:04:16,190 --> 00:04:17,690
ياهاري؟

45
00:04:18,940 --> 00:04:20,360
ماذا تريد؟

46
00:04:20,360 --> 00:04:21,990
!أنا أعمل الآن

47
00:04:22,650 --> 00:04:23,570
صحافة؟

48
00:04:23,820 --> 00:04:26,870
.أنا أعمل كصحفيّ الآن

49
00:04:26,870 --> 00:04:30,910
صحفيّ؟ لا أذكر أنّ لديّ ذكريات
.عزيزة عن تلك الكلمة

50
00:04:30,910 --> 00:04:31,870
.ألقِ نظرة

51
00:04:31,870 --> 00:04:33,120
أرض النّميمة؟

52
00:04:33,370 --> 00:04:35,330
ما هذه؟

53
00:04:35,330 --> 00:04:36,670
!ما هذا؟

54
00:04:36,670 --> 00:04:39,840
...تبدو المرأة الّتي في هذه الصّورة عارية نوعًا ما

55
00:04:40,460 --> 00:04:42,170
!لا-لا تنظري

56
00:04:42,710 --> 00:04:44,090
.لكنّي أريد المشاهدة

57
00:04:47,140 --> 00:04:48,050
!يا لظرافتها

58
00:04:48,050 --> 00:04:49,640
من هذه؟

59
00:04:49,640 --> 00:04:52,060
.هذه ابنة خالتي هامي-تشان

60
00:04:52,060 --> 00:04:54,020
.تشرّفت بلقائك

61
00:04:54,850 --> 00:04:56,400
!الشّرف لي

62
00:04:56,400 --> 00:04:58,060
هلاّ ذهبنا؟

63
00:04:58,060 --> 00:05:00,110
.فهذا الرّجل يعمل الآن

64
00:05:00,110 --> 00:05:02,480
ماذا؟! أستغادرون بهذه السّرعة؟

65
00:05:02,480 --> 00:05:04,700
.لم يبدأ الحدث الرّئيسيّ بعد

66
00:05:04,700 --> 00:05:09,280
صحيح، سيقدّم البطل الفائز عرضًا
احتفاليًّا على المسرح، صحيح؟

67
00:05:10,330 --> 00:05:11,830
!عرض مسرحيّ! أجل

68
00:05:11,830 --> 00:05:13,540
.كلاّ، أقصد ما بعد ذلك

69
00:05:13,540 --> 00:05:16,250
.يبدو أنّ ساموراي النّيكل سيُقدّم اعترافًا ما

70
00:05:16,250 --> 00:05:17,290
اعتراف؟

71
00:05:25,340 --> 00:05:27,430
.اطلبي منهم تنظيف هذه الأطباق

72
00:05:27,430 --> 00:05:28,840
.في الحال

73
00:05:28,840 --> 00:05:30,850
.سأرتاح قليلاً قبل العرض

74
00:05:30,850 --> 00:05:33,180
.أيقظيني عندما يحين الوقت

75
00:05:33,680 --> 00:05:34,810
.مفهوم

76
00:05:37,140 --> 00:05:41,020
أنت لا تعرف أيّ شيء عن اعتراف ساموراي
النّيكل، أليس كذلك يا نيبوشي-سان؟

77
00:05:41,020 --> 00:05:43,190
صحيح، كلّ ما سمعتُه

78
00:05:43,980 --> 00:05:47,780
.هو أنّه سيعقد المؤتمر الصّحفيّ وهو متنكّر

79
00:05:49,410 --> 00:05:51,370
.سيكون ذلك مؤتمرًا صحفيًّا غريبًا

80
00:05:51,370 --> 00:05:54,160
.أرجو الانتباه لو سمحتم

81
00:05:54,160 --> 00:05:57,460
عرض ساموراي النّيكل المسرحيّ الاحتفاليّ

82
00:05:57,460 --> 00:06:01,590
.لنُ يُعرض اللّيلة بسبب ظروف غير متوقّعة

83
00:06:01,590 --> 00:06:04,340
ماذا؟ لماذا؟

84
00:06:04,340 --> 00:06:06,210
!هذا مؤلم! لا تقرصيني

85
00:06:06,550 --> 00:06:09,720
.نطلب من الجميع أن يتعاونوا في وقت كهذا

86
00:06:09,720 --> 00:06:13,640
.لا تغادروا المكان رجاءً والزموا أماكنكم

87
00:06:13,640 --> 00:06:15,390
.هذا طلب خاصّ من الشّرطة

88
00:06:15,720 --> 00:06:16,640
الشّرطة؟

89
00:06:16,640 --> 00:06:17,730
.أعيد

90
00:06:16,890 --> 00:06:19,060
هل طرأ أمر ما؟

91
00:06:17,730 --> 00:06:21,610
.لا تغادروا المكان رجاءً والزموا أماكنكم

92
00:06:19,060 --> 00:06:20,400
.لنذهب ونلقي نظرة

93
00:06:20,400 --> 00:06:22,310
!مكانكم يا هؤلاء

94
00:06:27,030 --> 00:06:29,860
!إ-إنّه فضائيّ يا ناروهودو-كُن

95
00:06:29,860 --> 00:06:31,620
ألم تسمعوا الإعلان؟

96
00:06:31,620 --> 00:06:33,830
!لقد أخبركم أن تلزموا أماكنكم للتّوّ

97
00:06:34,160 --> 00:06:35,580
...هـ-هذا الصّوت

98
00:06:35,910 --> 00:06:37,000
...مستحيل

99
00:06:39,620 --> 00:06:40,580
أوبا-تشان؟

100
00:06:40,580 --> 00:06:41,790
ما الّذي تفعلينه هنا؟

101
00:06:42,210 --> 00:06:43,710
أليس هذا واضحًا؟

102
00:06:43,710 --> 00:06:45,750
!أنا عضوة ظريفة وناضجة من قوّات الأمن

103
00:06:45,750 --> 00:06:48,260
!إنّ شباب هذه الأيّام لا يستمعون للآخرين

104
00:06:48,260 --> 00:06:50,720
هنالك جسر يحمل لافتة مؤخّرًا تقول

105
00:06:50,720 --> 00:06:51,510
"!احذروا! جسر غير مكتمل"

106
00:06:51,510 --> 00:06:53,470
.لكنّ طفلاً صغيرًا قد تجاهل ذلك وعبر الجسر

107
00:06:53,470 --> 00:06:55,640
،حاولتُ إخباره أنّ الأمر خطير لأنّ الجسر غير مكتمل

108
00:06:55,640 --> 00:06:57,140
.لكنّه قال أنّه سيكون حذرًا وقطع الجسر

109
00:06:57,140 --> 00:06:58,850
!سمحت له بالمرور حينها بالفعل

110
00:06:58,850 --> 00:07:02,980
فعلتُ ذلك لكي لا يعبر أيّ جسر
...آخر في حياته أبدًا، ثمّ

111
00:07:00,520 --> 00:07:02,190
!دعوا هذا لي

112
00:07:02,980 --> 00:07:03,860
!خذ هذه

113
00:07:06,020 --> 00:07:07,690
...يا إلهي

114
00:07:07,690 --> 00:07:09,360
.لا يمكن فهمها على الإطلاق

115
00:07:09,360 --> 00:07:11,740
.هذا واضح. إنّها فضائيّ

116
00:07:11,740 --> 00:07:13,820
ماذا؟ أهذا حقيقيّ؟

117
00:07:13,030 --> 00:07:17,740
.أياساتو مايوي-ساما. أياساتو مايوي-ساما

118
00:07:17,740 --> 00:07:21,120
.لديك مكالمة في مكتب الاستقبال

119
00:07:19,790 --> 00:07:20,710
ما الأمر يا ترى؟

120
00:07:21,120 --> 00:07:22,370
!سأذهب لأرى

121
00:07:22,370 --> 00:07:25,210
.حسنًا، سنكون في انتظارك بالرّدهة

122
00:07:26,290 --> 00:07:28,760
أنت هي أياساتو مايوي-ساما، صحيح؟

123
00:07:29,460 --> 00:07:30,630
...نعم

124
00:07:30,630 --> 00:07:32,470
.دعيني أدلّك على الطّريق

125
00:07:32,470 --> 00:07:34,010
.من هنا رجاءً

126
00:07:34,010 --> 00:07:35,510
...سبق وأخبرتُك

127
00:07:35,510 --> 00:07:37,470
!أنا أقدّم المعلومات الّتي يحتاجها النّاس

128
00:07:37,470 --> 00:07:39,270
!ممّا يعني أنّ لي الحقّ بمعرفة ما يجري

129
00:07:39,270 --> 00:07:41,810
!لا فائدة! لا زال التّحقيق جاريًا

130
00:07:41,810 --> 00:07:42,730
ياهاري؟

131
00:07:43,350 --> 00:07:44,440
!ناروهودو

132
00:07:44,440 --> 00:07:48,070
أخبر هذا الشّرطيّ أنّي أقوم بعملي
...فحسب، ولديّ الحقّ في

133
00:07:48,400 --> 00:07:50,320
...ساعدني يا صديقي

134
00:07:50,320 --> 00:07:52,200
!فهذه جريمة قتل قبل كلّ شيء

135
00:07:52,820 --> 00:07:54,870
جـ-جريمة قتل؟

136
00:07:55,950 --> 00:07:57,410
!يا لفمي الثّرثار الكبير

137
00:07:57,620 --> 00:07:59,580
...لقد أُلغي العرض المسرحيّ

138
00:07:59,580 --> 00:08:01,750
هل هذا يعني أنّ الضّحيّة هو ساموراي النّيكل؟

139
00:08:02,040 --> 00:08:05,380
.كلاّ، اتُّهم السّاموراي من جديد

140
00:08:05,380 --> 00:08:05,920
ماذا؟

141
00:08:05,920 --> 00:08:07,250
إذًا فمن هو الضّحيّة؟

142
00:08:07,590 --> 00:08:09,000
!إنّه نانجا النّينجا

143
00:08:10,840 --> 00:08:15,050
بعبارات أخرى، الضّحيّة هو الممثّل
فوجيمينو إيساو، صحيح؟

144
00:08:15,300 --> 00:08:16,510
.هذا صحيح

145
00:08:16,510 --> 00:08:20,680
بطل أفلام الحركة الّتي تعادل شعبيّته
.شعبيّة ساموراي النّيكل أوتورو شينغو

146
00:08:20,680 --> 00:08:22,890
.إنّه منافسه قبل كلّ شيء

147
00:08:22,890 --> 00:08:27,270
وتقول الشّائعات أنّ أوتورو قد اعتُقل قبل قليل

148
00:08:27,270 --> 00:08:30,480
!بتهمة قتل فوجيمينو إيساو

149
00:08:31,690 --> 00:08:35,110
لماذا يتمّ اعتقال السّاموراي دائمًا؟

150
00:08:35,860 --> 00:08:38,160
...وأوتورو شينغو

151
00:08:41,290 --> 00:08:44,540
نجم كبير يُعرف أيضًا بلقب "ذلك الرّجل
!"المنعش كنسيم الرّبيع

152
00:08:44,750 --> 00:08:48,590
!هذه أكبر فضيحة في القرن العشرين

153
00:08:48,590 --> 00:08:53,090
سبق وأخبرتك يا ياهاري، لقد انتهى
.القرن العشرون منذ وقت طويل

154
00:08:53,090 --> 00:08:56,050
.على أيّ حال، أنت تعيق التّحقيق

155
00:08:56,050 --> 00:08:57,640
.عد إلى الرّدهة في الحال

156
00:08:57,640 --> 00:08:59,970
...إن سمعت مايوي-ساما بما حدث

157
00:08:59,970 --> 00:09:00,890
.صحيح

158
00:09:00,890 --> 00:09:04,230
.ستجعلني أتولّى القضيّة بكلّ تأكيد

159
00:09:04,230 --> 00:09:07,980
.بالمناسبة، طُلب منّي أن أعطيك هذا

160
00:09:07,980 --> 00:09:08,940
من طلب ذلك؟

161
00:09:08,940 --> 00:09:11,860
عامل في الفندق على ما أظنّ؟

162
00:09:15,110 --> 00:09:18,200
هل هذا هو المحامي ناروهودو ريويتشي-ساما؟

163
00:09:18,530 --> 00:09:20,700
نعم، ومن أنت؟

164
00:09:20,700 --> 00:09:23,200
.أعتقد أنّ بحوزتي شيء مهمّ بالنّسبة لك

165
00:09:23,200 --> 00:09:24,200
شيء مهمّ؟

166
00:09:24,200 --> 00:09:26,250
!النّجدة يا ناروهودو-كُن

167
00:09:26,250 --> 00:09:27,250
مايوي-ساما؟

168
00:09:27,250 --> 00:09:29,000
ما معنى هذا؟

169
00:09:29,290 --> 00:09:32,090
.هذا ما يمكن وصفه بالاختطاف

170
00:09:32,090 --> 00:09:32,380
—اختطـ

171
00:09:32,710 --> 00:09:33,920
!اختطاف؟

172
00:09:35,220 --> 00:09:36,800
ما الّذي تريده؟

173
00:09:36,800 --> 00:09:38,180
كم تريد من المال؟

174
00:09:38,180 --> 00:09:41,600
.غايتي ليست المال، بل إريد حُكمًا معيّنًا

175
00:09:41,600 --> 00:09:42,970
.تبرئة كاملة

176
00:09:42,970 --> 00:09:43,930
ماذا؟

177
00:09:44,180 --> 00:09:47,770
.أعتقد أنّ هنالك جريمة قد حدثت للتّوّ

178
00:09:47,770 --> 00:09:52,440
.وقد اعتُقل شابّ يافع يدعى أوتورو شينغو

179
00:09:52,440 --> 00:09:53,900
كيف عرفتَ ذلك؟

180
00:09:53,900 --> 00:09:55,900
.إنّه لم يقتل أيّ أحد

181
00:09:55,900 --> 00:09:58,070
.أستطيع أن أشهد بذلك

182
00:09:58,070 --> 00:10:00,030
.ستُعقد المحاكمة بعد يومين

183
00:10:00,030 --> 00:10:02,660
."وفي تلك المحاكمة، سوف تحصل على حكم "غير مذنب

184
00:10:02,950 --> 00:10:04,660
.لديك فرصة واحدة

185
00:10:04,660 --> 00:10:06,710
تبرئة كاملة في جلسة واحدة؟

186
00:10:06,710 --> 00:10:07,460
.نعم

187
00:10:07,460 --> 00:10:09,830
،وبما أنّي ألعب دور المختطِف

188
00:10:09,830 --> 00:10:12,380
لا يمكنني أن أفوّت هذه الفرصة لأقول لك

189
00:10:12,920 --> 00:10:15,170
".إيّاك حتّى أن تفكّر في الاتّصال بالشّرطة"

190
00:10:15,170 --> 00:10:17,010
من تكون يا هذا؟

191
00:10:17,010 --> 00:10:18,590
...اسمي هو

192
00:10:19,050 --> 00:10:20,180
.كوروشيا

193
00:10:21,600 --> 00:10:22,510
كوروشيا؟

194
00:10:22,510 --> 00:10:25,100
...نا-ناروهودو

195
00:10:27,520 --> 00:10:28,440
محامٍ؟

196
00:10:28,810 --> 00:10:29,600
.نعم

197
00:10:29,600 --> 00:10:30,600
.مهلاً لحظة

198
00:10:31,770 --> 00:10:33,360
سأسأل مدير وكالتي، موافق؟

199
00:10:41,280 --> 00:10:43,240
.اعذرني. لقد قالوا لا

200
00:10:43,910 --> 00:10:47,620
.أنا آسف، يبدو أنّهم قد عيّنوا محاميًا مشهورًا

201
00:10:47,620 --> 00:10:49,660
—أخبرني عن الحادثة على الأقلّ

202
00:10:50,080 --> 00:10:51,460
.مهلاً

203
00:10:51,960 --> 00:10:53,380
.دعني أسأل مدير وكالتي

204
00:10:53,380 --> 00:10:55,130
...إنّ... هذا

205
00:10:55,130 --> 00:10:57,630
،آسف، لكن من أجل عقد مقابلة
—عليك أن تتّصل بوكالتي

206
00:10:57,880 --> 00:10:58,970
!أوتورو-سان

207
00:10:59,590 --> 00:11:00,800
!أرجوك

208
00:11:01,260 --> 00:11:04,350
!دعني أدافع عنك

209
00:11:05,060 --> 00:11:06,560
ما الخطب؟

210
00:11:06,560 --> 00:11:08,640
لماذا هذا الوجه المخيف؟

211
00:11:12,400 --> 00:11:13,560
!أتوسّل إليك

212
00:11:14,020 --> 00:11:17,280
...إن لم أستطع الدّفاع عنك، فإنّ كوروشيا سوف

213
00:11:18,860 --> 00:11:20,280
ماذا قلتَ للتّوّ؟

214
00:11:21,110 --> 00:11:22,200
كوروشيا؟

215
00:11:22,410 --> 00:11:23,870
...نـ-نعم

216
00:11:31,460 --> 00:11:32,580
.مفهوم

217
00:11:33,120 --> 00:11:35,880
.دافع عنّي في المحكمة رجاءً

218
00:11:35,880 --> 00:11:37,960
فـ-فعلاً؟

219
00:11:37,960 --> 00:11:41,760
.أتوقّع حُكمًا منعشًا كنسيم الرّبيع

220
00:11:41,760 --> 00:11:43,590
!شكرًا جزيلاً لك

221
00:11:43,590 --> 00:11:45,180
!شكرًا جزيلاً

222
00:11:45,890 --> 00:11:47,510
.حسنًا، يمكنكما الجلوس

223
00:11:48,390 --> 00:11:52,390
.أوتورو-سان، أرغب سؤالك عن شيء أوّلاً

224
00:11:53,560 --> 00:11:56,400
هل قتلتَ فوجيمينو إيساو-سان؟

225
00:12:01,190 --> 00:12:02,650
،ناروهودو-سان

226
00:12:02,650 --> 00:12:07,160
.يُقال أنّي مغرور وغالبًا ما يسيئ النّاس فهمي

227
00:12:07,870 --> 00:12:11,160
.لكنّي وفوجيمينو-كُن كنّا متنافسين شريفين

228
00:12:11,540 --> 00:12:14,420
.لم أقتل أيّ أحد

229
00:12:14,960 --> 00:12:15,920
.هذه هي الحقيقة

230
00:12:16,580 --> 00:12:17,790
هل يمكنني أن أصدّق كلامك؟

231
00:12:18,590 --> 00:12:19,960
.صدّقني رجاءً

232
00:12:19,960 --> 00:12:21,590
...أنا منزعج بشدّة من هذا

233
00:12:22,420 --> 00:12:27,050
.من المفترض أن أكون بطلاً، لكنّي سمحتُ بموته

234
00:12:30,520 --> 00:12:31,730
.حسنًا

235
00:12:31,730 --> 00:12:33,230
.سوف أثق بك

236
00:12:34,020 --> 00:12:36,900
ممتاز. المحاكمة في الغد، صحيح؟

237
00:12:37,400 --> 00:12:38,770
.أنا أعتمد عليك

238
00:12:39,150 --> 00:12:40,320
.من الجيّد العمل معك

239
00:12:40,730 --> 00:12:42,530
...بالمناسبة

240
00:12:43,820 --> 00:12:48,160
سمعتُ أنّك كنت ستقدّم مؤتمرًا صحفيًّا
.لآخر مرّة بعد العرض

241
00:12:49,030 --> 00:12:49,910
،أعني

242
00:12:50,330 --> 00:12:53,830
.أمر ما بشأن تقديم ساموراي النّيكل لاعتراف ما

243
00:12:53,830 --> 00:12:55,710
.لا فكرة لي عن ذلك

244
00:12:55,710 --> 00:12:58,590
.مديرة أعمالي هي الّتي تهتمّ بكلّ أموري

245
00:12:58,590 --> 00:13:00,460
هكذا إذًا؟

246
00:13:04,260 --> 00:13:07,470
هل سيكون كلّ شيء
على ما يرام يا ناروهودو-كُن؟

247
00:13:07,470 --> 00:13:10,640
استطعنا على الأقلّ إقناع
.أوتورو-سان ليصبح موكّلنا

248
00:13:10,640 --> 00:13:14,270
كلّ ما عليّ فعله هو أن أثبت
!أنّه غير مذنب في المحكمة غدًا

249
00:13:14,270 --> 00:13:14,980
.أجل

250
00:13:21,570 --> 00:13:25,360
.أنا مديرة أعمال أوتورو شينغو، كاميا كيريو

251
00:13:25,740 --> 00:13:27,780
.مرحبًا

252
00:13:27,780 --> 00:13:32,330
سمعتُ أنّك من عثر على جثّة
فوجيمينو إيساو-سان البارحة ليلاً؟

253
00:13:32,330 --> 00:13:33,290
.هذا صحيح

254
00:13:33,290 --> 00:13:36,000
وأين كان ذلك؟

255
00:13:36,500 --> 00:13:38,080
.في غرفة ملابس فوجيمينو-سان

256
00:13:38,330 --> 00:13:42,550
لكن ألست مديرة أعمال أوتورو-سان؟

257
00:13:42,550 --> 00:13:44,630
لماذا كنت في غرفة فوجيمينو-سان؟

258
00:13:44,630 --> 00:13:47,550
،كان موعد العرض المسرحيّ قد اقترب

259
00:13:47,550 --> 00:13:49,760
.لذلك ذهبتُ لأطمئنّ عليه

260
00:13:49,760 --> 00:13:52,720
.ما كان أوتورو ليستطيع تقديم العرض بمفرده

261
00:13:52,720 --> 00:13:54,520
.فـ-فهمت

262
00:13:55,890 --> 00:13:58,850
.لا بدّ أنّ كيريو-ساما شخص طموح بالفعل

263
00:14:01,980 --> 00:14:03,980
أوباتشان

264
00:14:02,440 --> 00:14:03,980
!أوبا-تشان

265
00:14:03,980 --> 00:14:05,240
...إنّها أوبا-تشان

266
00:14:05,570 --> 00:14:07,030
.تعال معي للحظة

267
00:14:07,030 --> 00:14:08,400
ماذا تريدين؟

268
00:14:08,820 --> 00:14:11,660
.من المفترض بي أن أراقبها أيضًا

269
00:14:12,030 --> 00:14:15,040
.تلك المرأة طموحة بالفعل

270
00:14:15,040 --> 00:14:17,330
ما خطب كيريو-سان؟

271
00:14:17,330 --> 00:14:19,500
.إنّها حقيرة بالفعل

272
00:14:19,750 --> 00:14:22,040
،تنفيذًا لأوامر أوتورو

273
00:14:22,040 --> 00:14:26,710
قامت بالتّقرّب إلى إيساو-تشان، وأخرجته عن
!الطّريق الصّواب باستعمال حيلها القذرة

274
00:14:26,710 --> 00:14:27,130
.انظر

275
00:14:27,420 --> 00:14:30,090
".موعد نانجا النّينجا المتؤخّر"

276
00:14:30,090 --> 00:14:32,600
"رفيقته هي مديرة أعمال منافسه ك. ك.؟"

277
00:14:33,100 --> 00:14:34,350
ك. ك.؟

278
00:14:34,350 --> 00:14:35,720
كاميا كيريو؟

279
00:14:35,720 --> 00:14:37,520
المعذرة يا ناروهودو-كُن؟

280
00:14:37,520 --> 00:14:40,060
ماذا تعني "الحيل القذرة"؟

281
00:14:40,850 --> 00:14:44,270
.لنتحدّث عن ذلك لاحقًا

282
00:14:44,270 --> 00:14:49,200
.تسبّب أوتورو بفضيحة ليخسر منافسه اعتباره

283
00:14:49,950 --> 00:14:54,580
...لقد تلاعبا بإيساو-تشان المسكين

284
00:14:54,580 --> 00:14:56,290
...مهلاً يا أوبا-تشان

285
00:14:56,290 --> 00:14:58,750
أأنت معجبة بفوجيمينو إيساو-سان؟

286
00:14:59,160 --> 00:15:02,290
!نانجا النّينجا

287
00:15:03,750 --> 00:15:05,550
ستدافع عن أوتورو؟

288
00:15:05,800 --> 00:15:07,380
.حسنًا، نعم

289
00:15:08,840 --> 00:15:11,180
!هنالك دببة في كلّ مكان

290
00:15:11,180 --> 00:15:13,220
.يبدو أنّ معجبيه قد أرسلوا هذه

291
00:15:13,220 --> 00:15:14,930
أكان يحبّ الدّببة؟

292
00:15:15,310 --> 00:15:19,060
لقد اعتكف في الجبال لثلاث سنوات
.وهو يقاتل الدّببة في الماضي

293
00:15:19,060 --> 00:15:21,230
.لقد عزّز ذلك من قوّته الجسديّة والذّهنيّة

294
00:15:21,230 --> 00:15:22,940
.لا بدّ أنّه كان قويًّا للغاية

295
00:15:25,320 --> 00:15:26,690
هل عُثر على الجثّة هنا؟

296
00:15:26,690 --> 00:15:27,820
.هذا صحيح

297
00:15:27,820 --> 00:15:29,320
.كان هنالك سكّين مغروس في صدره

298
00:15:29,650 --> 00:15:33,410
سمعتُ أنّ بصمات أوتورو كانت
.على سلاح الجريمة

299
00:15:33,410 --> 00:15:35,780
،لم يصدر تقرير الطّبّ الشّرعي النّهائيّ بعد

300
00:15:35,780 --> 00:15:38,410
.لكن نعم، هذا ما دفعنا لاعتقاله

301
00:15:38,410 --> 00:15:40,910
.كما أنّ لدينا شهادة شاهد عيان

302
00:15:40,910 --> 00:15:44,330
.في الحقيقة، لا فرصة أمامك هذه المرّة

303
00:15:44,710 --> 00:15:46,420
هنالك شاهد؟

304
00:15:48,760 --> 00:15:51,930
!أظهرتَ معدنك الحقيقيّ أخيرًا يا ناروهودو ريويتشي

305
00:15:52,970 --> 00:15:54,470
كاروما مي؟

306
00:15:54,470 --> 00:15:56,800
!إذًا أنت من النّوع الّذي يسرق المعلومات من المحقّقين

307
00:15:56,800 --> 00:15:58,350
!كم هذا مخزٍ

308
00:16:02,440 --> 00:16:04,100
،ناروهودو ريويتشي

309
00:16:04,100 --> 00:16:07,520
!لقد لطّختَ سجلّي المثاليّ كمدّعية عامّة

310
00:16:07,730 --> 00:16:09,030
...إنّها غلطتك بالكامل

311
00:16:09,030 --> 00:16:10,490
!غلطتك بالكامل

312
00:16:10,490 --> 00:16:12,570
!سيكون الفوز لي هذه المرّة

313
00:16:12,570 --> 00:16:14,990
!أقسم على ذلك باسم عائلتي

314
00:16:14,990 --> 00:16:16,410
...هذه العزيمة

315
00:16:16,410 --> 00:16:18,620
!تبدو المدّعية العامّة كاروما شخصًا مختلفًا

316
00:16:18,910 --> 00:16:20,870
.إضافة لذلك يا كاميا كيريو

317
00:16:20,870 --> 00:16:21,750
ما-ماذا؟

318
00:16:22,080 --> 00:16:24,830
.فكّري فيما أخبرتك

319
00:16:26,710 --> 00:16:27,460
.حسنًا

320
00:16:30,800 --> 00:16:31,300
!اخرس

321
00:16:31,630 --> 00:16:34,050
ستهزمينني؟

322
00:16:34,050 --> 00:16:36,340
.هذا كلّ ما تتحدّثين عنه

323
00:16:39,310 --> 00:16:40,890
!تعال يا صاحب اللّحية الخفيفة

324
00:16:40,890 --> 00:16:41,890
...حاضر

325
00:16:43,560 --> 00:16:45,060
...ناروهودو-كُن

326
00:16:45,690 --> 00:16:46,350
!أهلاً

327
00:16:46,350 --> 00:16:47,560
...ياهاري

328
00:16:49,980 --> 00:16:52,990
ألديك فكرة عن مكان آلة تصويري يا رفيقي؟

329
00:16:52,990 --> 00:16:53,740
آلة تصويرك؟

330
00:16:53,740 --> 00:16:58,030
أواثق أنّك لم تسرقها وتبعها على غفلة منّي؟

331
00:16:58,030 --> 00:16:59,240
.لا أدري أين هي

332
00:16:59,240 --> 00:17:01,490
.الآن هو الوقت المناسب للاعتراف

333
00:17:01,490 --> 00:17:03,500
!لا تشتبه بصديقك هكذا

334
00:17:03,500 --> 00:17:05,670
.لا بدّ أنّك نسيتها في مكان ما

335
00:17:06,290 --> 00:17:09,630
!كما أنّي التقطتُ صورة لسبق صحفيّ كبير

336
00:17:09,630 --> 00:17:12,170
.تفضّلا، اشرباه بينما لا يزال ساخنًا

337
00:17:12,170 --> 00:17:15,130
!هامي-تشان! شكرًا لك

338
00:17:15,680 --> 00:17:16,550
أهذا هو؟

339
00:17:16,550 --> 00:17:18,510
كيف حالك في هذا اليوم الجميل؟

340
00:17:20,180 --> 00:17:22,140
!من الأفضل أن تكون مايوي-تشان سالمة

341
00:17:23,270 --> 00:17:26,980
.ما عليك أن تقلق بشأنه هو محاكمة الغد

342
00:17:26,980 --> 00:17:30,060
.لقد جهّزتُ هديّة لك

343
00:17:30,060 --> 00:17:31,900
أقال "هديّة"؟

344
00:17:31,900 --> 00:17:36,320
.أريدك أن تفوز بشدّة

345
00:17:36,320 --> 00:17:37,740
عمّاذا تتحدّث؟

346
00:17:37,740 --> 00:17:40,990
.سترى عندما ستشارك في المحاكمة غدًا

347
00:17:40,990 --> 00:17:43,370
.مع السّلامة. حظًّا سعيدًا

348
00:17:44,870 --> 00:17:46,290
!مايوي-ساما

349
00:17:51,590 --> 00:17:54,210
لا بأس بهذا. صحيح يا أختاه؟

350
00:18:20,410 --> 00:18:22,080
!المدّعية العامّة كاروما

351
00:18:39,630 --> 00:18:42,550
.المدّعية العامّة صاحبة السّوط قد تأخّرت

352
00:18:42,550 --> 00:18:43,430
.أجل

353
00:18:44,430 --> 00:18:45,890
!أمر فظيع

354
00:18:45,890 --> 00:18:47,180
ما الخطب أيّها المحقّق؟

355
00:18:47,560 --> 00:18:49,140
!المحاكمة على وشك أن تبدأ

356
00:18:49,140 --> 00:18:53,020
!أصاب قنّاص ما المدّعية العامّة كاروما

357
00:18:53,020 --> 00:18:54,320
ماذا؟

358
00:18:54,730 --> 00:18:56,650
قـ-قنّاص؟

359
00:18:58,990 --> 00:19:00,280
مرحبًا؟

360
00:19:00,280 --> 00:19:01,780
...ناروهودو-كُن

361
00:19:01,780 --> 00:19:05,870
.يبدو أنّ هديّتي قد وصلتك

362
00:19:05,870 --> 00:19:07,120
هديّة؟

363
00:19:07,120 --> 00:19:09,040
هل أطلقت النّار على المدّعية العامّة كاروما؟

364
00:19:09,370 --> 00:19:12,000
.لا تقلق. لن تموت جرّاء ذلك

365
00:19:12,000 --> 00:19:15,380
لكنّها لن تكون قادرة على الوقوف
.في المحكمة لفترة طويلة

366
00:19:15,380 --> 00:19:16,250
...أنت

367
00:19:16,250 --> 00:19:18,590
.كانت مجرّد طلقة قمعيّة فحسب

368
00:19:18,800 --> 00:19:22,510
.والآن، احصل على حكم "غير مذنب" رجاءً

369
00:19:22,510 --> 00:19:23,340
!انتظر

370
00:19:24,010 --> 00:19:26,720
هل ستكون المدّعية صاحبة السّوط بخير؟

371
00:19:28,310 --> 00:19:32,810
في كلّ الأحوال، يبدو أنّ لا خيار أمامنا
.سوى تأجيل محاكمة اليوم

372
00:19:32,810 --> 00:19:33,560
!مهلاً

373
00:19:51,410 --> 00:19:53,170
...أ-أنت

374
00:20:00,130 --> 00:20:04,510
!سوف آخذ مكان كاروما مي

375
00:20:08,680 --> 00:20:09,520
!ميتسوروغي

376
00:20:09,720 --> 00:20:12,350
لقد تلقّت رصاصة في كتفها الأيمن

377
00:20:12,350 --> 00:20:14,230
.وهي في غرفة العمليّات الآن

378
00:20:14,230 --> 00:20:16,770
.لحسن الحظّ، حياتها ليست في خطر

379
00:20:16,770 --> 00:20:19,780
.لقد حفظتُ كلّ معلومات القضيّة

380
00:20:21,190 --> 00:20:26,450
سوف أثبت إدانة أوتورو شينغو
.بطُرقي الخاصّة

381
00:20:27,160 --> 00:20:30,750
ماذا حدث لـ"اختار المدّعي العامّ
ميتسوروغي ريجي الموت"؟

382
00:20:31,080 --> 00:20:35,210
.صحيح، أنا الّذي عرفتَه في الماضي قد مات

383
00:20:35,580 --> 00:20:38,210
لماذا عدت إذًا؟

384
00:20:38,210 --> 00:20:39,500
لماذا الآن؟

385
00:20:39,500 --> 00:20:41,170
،بعد سنة من المحاكمة

386
00:20:42,260 --> 00:20:44,380
.بحثتُ عن أجوبة لأسئلتي

387
00:20:44,840 --> 00:20:46,470
"من هو المدّعي العامّ؟"

388
00:20:46,470 --> 00:20:48,800
"ما الّذي أدافع عنه في المحكمة؟"

389
00:20:50,310 --> 00:20:53,060
ماذا عنك يا ناروهودو؟

390
00:20:53,560 --> 00:20:56,350
لماذا أنت واقف هناك؟

391
00:20:56,980 --> 00:20:58,980
...هـ-هذا

392
00:20:59,270 --> 00:21:01,150
لماذا أقف في المحكمة؟

393
00:21:01,400 --> 00:21:02,900
...ناروهودو-كُن

394
00:21:02,900 --> 00:21:05,660
الأجوبة الّتي عثرتُ عليها ستكون واضحة

395
00:21:10,330 --> 00:21:14,410
!في الوقت الّذي ستنتهي فيه هذه المحاكمة

396
00:21:19,710 --> 00:21:24,550
.ستُفتتح الجلسة الآن لمحاكمة أوتورو شينغو

397
00:21:24,550 --> 00:21:27,470
.ليقدّم المدّعي العامّ شهادته الافتتاحيّة رجاءً

398
00:21:35,100 --> 00:21:37,270
.أنا أتضوّر جوعًا

399
00:21:37,900 --> 00:21:39,400
...ناروهودو-كُن

400
00:21:40,560 --> 00:21:44,780
سوف أحصل على حكم بالبراءة في هذه
.المحاكمة مهما كان الثّمن

401
00:21:45,990 --> 00:21:48,030
!انتظريني يا مايوي-تشان

402
00:23:20,330 --> 00:23:21,370
!أعترض

403
00:23:21,870 --> 00:23:24,540
...حياة مايوي-تشان، وبراءة موكّلي

404
00:23:24,540 --> 00:23:26,800
،بهدف حماية هذه الأشياء العزيزة

405
00:23:26,800 --> 00:23:28,420
.سأقف في المحكمة

406
00:23:28,420 --> 00:23:31,220
.والمدّعي العامّ الّذي سيواجهني هو ميتسوروغي

407
00:23:31,220 --> 00:23:33,720
.أطلق وابلاً من الهجمات بعد عودته بوقت قصير

408
00:23:34,100 --> 00:23:38,220
.لكنّي أدركتُ شيئًا وأنا أنظر للدّليل

409
00:23:38,220 --> 00:23:41,730
من كان ساموراي النّيكل الّذي هرب من مكان الحادثة؟

410
00:23:42,310 --> 00:23:43,310
!سأعثر على المتناقضات

411
00:23:43,310 --> 00:23:44,440
!وأكتشف الحقيقة

412
00:23:44,440 --> 00:23:47,480
!"في الحلقة القادمة: "وداعًا يا تغيّري — المحامة الثّانية

413
00:23:47,480 --> 00:23:48,320
!خذوا هذه