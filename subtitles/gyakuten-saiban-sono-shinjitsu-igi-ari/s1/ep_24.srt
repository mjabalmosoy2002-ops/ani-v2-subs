1
00:00:00,470 --> 00:00:03,140
.قُتل بطل على يد بطل آخر

2
00:00:03,140 --> 00:00:04,690
،وفي محاكمة أوتورو شينغو

3
00:00:04,940 --> 00:00:08,440
.وقف كوروشيا بنفسه على منصّة الشّهود

4
00:00:08,690 --> 00:00:11,110
وبالتّالي ستبدأ عملية استجواب
،شاهد لم يسبق لها مثيل

5
00:00:11,110 --> 00:00:13,740
والوقت الّذي سيحدّد موت أو حياة
.مايوي-تشان يكاد ينفد منّا

6
00:00:14,360 --> 00:00:16,660
وبدون وجود أيّ أمل بوصول
،آخر جزء من الدّليل للمحكمة

7
00:01:59,220 --> 00:02:01,390
أيّها الشّاهد، هل يمكنك رؤيتنا؟

8
00:02:02,260 --> 00:02:02,970
.نعم

9
00:02:03,260 --> 00:02:05,100
.لنبدأ في الحال

10
00:02:05,470 --> 00:02:08,230
.إذًا أخبرنا باسمك ومهنتك

11
00:02:08,230 --> 00:02:12,690
اسمي كوروشيا سازايمون
.وأنا قاتل مأجور محترف

12
00:02:12,980 --> 00:02:15,730
ماذا؟ ما كان هذا؟

13
00:02:15,730 --> 00:02:18,200
.إنّه جهاز مذياع وصلنا قبل قليل

14
00:02:18,200 --> 00:02:21,620
سيدلي كوروشيا بشهادته في هذه
.المحكمة ما دمنا لن نتقفّى أثره

15
00:02:21,620 --> 00:02:25,830
لكنّنا لا نستطيع التّحقّق إن كان هذا
.هو كوروشيا بهذه الطّريقة

16
00:02:25,830 --> 00:02:28,410
.حسنًا، انتظروا لحظة رجاءً

17
00:02:28,410 --> 00:02:30,290
.أريد تناول بعض الياكيسوبا

18
00:02:29,620 --> 00:02:30,290
!مايوي؟

19
00:02:29,620 --> 00:02:30,290
!مايوي-تشان؟

20
00:02:31,580 --> 00:02:33,040
ما كان هذا؟

21
00:02:33,040 --> 00:02:33,840
!لا اعتراضات من جانبنا

22
00:02:33,840 --> 00:02:36,340
!يقبل الدّفاع أن الشّاهد هو كوروشيا بنفسه

23
00:02:36,340 --> 00:02:36,880
ماذا؟

24
00:02:37,210 --> 00:02:39,380
،بما أنّ الدّفاع لا يملك أيّ اعتراضات

25
00:02:39,380 --> 00:02:41,050
.فلا أرى أي مشكلة إذًا

26
00:02:43,050 --> 00:02:44,300
.حسنًا

27
00:02:44,300 --> 00:02:46,220
.سأبدأ بالاستجواب إذًا

28
00:02:46,220 --> 00:02:49,690
هل قتلت فوجيمينو إيساو
نزولاً لرغبة زبونك؟

29
00:02:50,640 --> 00:02:51,560
.نعم

30
00:02:51,560 --> 00:02:54,060
.أديّت عملي وقتلتُه

31
00:02:54,060 --> 00:02:55,190
ماذا؟

32
00:02:55,610 --> 00:02:58,440
ما اسم ذلك الزّبون؟

33
00:02:58,440 --> 00:03:01,950
.قبل أن أجيب، هنالك شيء واحد أودّ توضيحه

34
00:03:01,950 --> 00:03:02,910
ما هو؟

35
00:03:03,320 --> 00:03:08,120
،بالنّسبة لنا نحن القتلة المأجورون
!الثّقة بيننا وبين زبائننا هي الأهمّ

36
00:03:08,120 --> 00:03:11,710
وهذا هو السّبب الّذي أتى بي
.إلى هنا اليوم لأشهد

37
00:03:11,710 --> 00:03:12,750
ماذا تقصد؟

38
00:03:13,000 --> 00:03:16,670
.أقوم بعملي بكلّ دقّة وأحافظ على سرّيّة الزّبائن

39
00:03:16,670 --> 00:03:20,840
في المقابل، أثق أنّ زبائني سيلتزمون
.الصّمت بشأني وبشأن هويّتي

40
00:03:20,840 --> 00:03:22,220
.هذا ما أقصده

41
00:03:22,220 --> 00:03:24,140
...الثّقة

42
00:03:24,140 --> 00:03:26,430
ألم يخنك أحد من قبل؟

43
00:03:26,430 --> 00:03:28,060
،إن حدث ذلك

44
00:03:28,060 --> 00:03:30,600
!فلن أظهر أي رحمة سواء كانت لزبوني أم لا

45
00:03:30,600 --> 00:03:34,270
.أكره الخونة أكثر من أيّ شيء آخر

46
00:03:34,610 --> 00:03:39,030
.لكنّك على وشك أن تقول لنا اسم زبونك

47
00:03:39,030 --> 00:03:40,650
،أتمنّى لو لم أضطرّ لهذا

48
00:03:40,650 --> 00:03:44,410
.لكنّ هذا الزّبون قد خرق قانوني

49
00:03:44,740 --> 00:03:45,660
قانونك؟

50
00:03:46,030 --> 00:03:49,700
.لقد حاول توريط شخص آخر لإنقاذ نفسه

51
00:03:49,700 --> 00:03:51,370
.وهذا تعدٍّ لا أستطيع أن أغفر عنه

52
00:03:51,620 --> 00:03:53,870
.لقد أوضحت وجهة نظرك تمامًا

53
00:03:53,870 --> 00:03:59,960
والآن، اشهد لنا بشأن من عيّنك
.لتقتل فوجيمينو إيساو

54
00:03:59,960 --> 00:04:00,420
.حاضر

55
00:04:00,920 --> 00:04:02,670
...زبوني هو

56
00:04:05,140 --> 00:04:07,640
.كاميا كيريو-ساما

57
00:04:08,970 --> 00:04:10,770
!إنّه يكذب

58
00:04:10,770 --> 00:04:12,270
!لم تكن أنا

59
00:04:12,640 --> 00:04:14,520
!لقد خدعتني أيّها الشّاهد؟

60
00:04:14,520 --> 00:04:16,360
ماذا يحدث؟

61
00:04:16,360 --> 00:04:18,820
.لقد خان كوروشيا المدّعي العامّ

62
00:04:18,820 --> 00:04:21,610
.أظنّ أنّه كان من المفترض به أن يشهد ضدّ أوتورو

63
00:04:21,610 --> 00:04:23,740
إنّه يحاول حماية زبونه؟

64
00:04:25,570 --> 00:04:30,040
وبالتّالي، أرغب بأن يتمّ إعلان براءة
.المدّعى عليه أوتورو شينغو-ساما

65
00:04:31,540 --> 00:04:32,540
!أعترض

66
00:04:32,750 --> 00:04:36,170
!قبل ذلك، ما زلت لم أستجوب الشّاهد

67
00:04:36,630 --> 00:04:39,420
.تشيهيرو-سان، أنا محامي الدّفاع

68
00:04:39,840 --> 00:04:43,550
.لكنّي لا أستطيع قبول تبرئة كهذه

69
00:04:45,220 --> 00:04:49,220
.لكنّه كشف عن اسم زبونه للتّوّ

70
00:04:49,220 --> 00:04:51,720
عمّاذا تنوي أن تستجوبه؟

71
00:04:51,720 --> 00:04:52,810
.بالفعل

72
00:04:52,810 --> 00:04:57,230
.أظنّ أنّ شهادتي مفيدة للغاية في حالتك

73
00:05:00,770 --> 00:05:06,490
قبل قليل، قلت أنّ الثّقة بينك
.وبين زبائنك هي أهمّ شيء

74
00:05:06,490 --> 00:05:07,240
.نعم

75
00:05:07,240 --> 00:05:11,160
لكن كيف تعرف أنّ زبونك يستحقّ الثّقة؟

76
00:05:11,370 --> 00:05:16,120
أنا أقابل زبائني شخصيًّا دائمًا قبل
.أن أبرم العقد معهم

77
00:05:16,670 --> 00:05:19,210
،أتحدّث إليهم بينما أنظر إلى أعينهم

78
00:05:19,210 --> 00:05:22,800
.وهو أمر ضروريّ لبناء الثّقة بيننا

79
00:05:22,800 --> 00:05:26,340
إذًا، قابلتَ هذا الزّبون بشكل شخصيّ أيضًا؟

80
00:05:26,340 --> 00:05:27,300
.نعم

81
00:05:27,300 --> 00:05:30,140
قابلتُ كاميا-ساما في مكان حدّدناه مسبقًا

82
00:05:30,140 --> 00:05:32,180
.وقرّرتُ أنه يستحقّ الثّقة

83
00:05:34,180 --> 00:05:35,430
.نلت منه

84
00:05:36,060 --> 00:05:39,060
قابلت كاميا كيريو-سان، صحيح؟

85
00:05:39,060 --> 00:05:40,650
.صحيح

86
00:05:40,650 --> 00:05:43,940
وظننتَ أنّه يستحقّ ثقتك؟

87
00:05:43,940 --> 00:05:44,860
.بالفعل

88
00:05:45,440 --> 00:05:47,900
.أنا آسف، لكنّ هذه رواية مستحيلة

89
00:05:47,900 --> 00:05:49,160
لماذا؟

90
00:05:49,160 --> 00:05:53,330
!كوروشيا سازايمون، أنت لم تقابل كاميا كيريو أبدًا

91
00:05:53,330 --> 00:05:55,290
لِـ-لِم قد تقول ذلك؟

92
00:05:55,750 --> 00:05:59,170
...يبدو أنّك أسأت الفهم بشكل كبير

93
00:05:59,170 --> 00:06:00,380
.بشأنها

94
00:06:03,170 --> 00:06:04,500
ماذا قلتَ للتّوّ؟

95
00:06:04,760 --> 00:06:05,840
بشأنها؟

96
00:06:06,260 --> 00:06:10,800
،إن كنتَ قد قابلتَ كيريو-سان شخصيًّا
لكانت نظرة واحدة كافية

97
00:06:10,800 --> 00:06:12,890
!أن تبيّن لك أنّها امرأة

98
00:06:12,890 --> 00:06:14,010
ماذا؟

99
00:06:14,010 --> 00:06:17,480
لـ-لكن لماذا قد يقترف خطأ بسيطًا كهذا؟

100
00:06:17,480 --> 00:06:19,190
.أعتقد أنّ للأمر علاقة باسمها

101
00:06:19,690 --> 00:06:21,230
.كاميا كيريو

102
00:06:21,230 --> 00:06:23,570
.إنه يبدو كاسم رجل

103
00:06:24,020 --> 00:06:30,450
،الشّاهد الّذي يقابل كلّ زبائنه شخصيًّا
.لم يقابل كاميا كيريو من قبل

104
00:06:30,450 --> 00:06:34,830
!وهذا ما يعني أنّ زبونه ليس كاميا كيريو

105
00:06:35,950 --> 00:06:38,290
!غير ممكن

106
00:06:38,500 --> 00:06:41,960
والآن، هل تمانع لو أعطيتنا تفسيرًا
عن هذا التّناقض؟

107
00:06:42,960 --> 00:06:46,590
.اعذرني على قول هذا، لكن أنت المتناقض هنا

108
00:06:48,010 --> 00:06:52,140
لقد كنت أشهد لصالح أوتورو-ساما
.طوال هذا الوقت

109
00:06:52,340 --> 00:06:56,350
لذلك لماذا تحاول أن تعرقل طريقي؟

110
00:06:56,350 --> 00:06:57,640
...هـ-هذا

111
00:06:57,930 --> 00:07:02,600
.أظنّ أنّي أخبرتك أنّي أكره الخونة أكثر من أيّ شيء

112
00:07:02,600 --> 00:07:05,230
تفهم ما أرمي له، صحيح؟

113
00:07:06,320 --> 00:07:07,570
.حسنًا

114
00:07:07,570 --> 00:07:09,780
.سوف أذهب الآن

115
00:07:09,780 --> 00:07:13,070
.هنالك "غرض" أحتاج لأتخلّص منه

116
00:07:13,070 --> 00:07:14,120
!مايوي

117
00:07:13,070 --> 00:07:14,620
!انتظر! لا تفعل ذلك

118
00:07:14,620 --> 00:07:18,200
!أنهِ هذه المحاكمة في الحال إذًا

119
00:07:19,330 --> 00:07:23,500
ماذا يحدث أيّها المدّعي العامّ ميتسوروغي؟

120
00:07:26,630 --> 00:07:27,750
.لا يمكننا فعل هذا

121
00:07:27,750 --> 00:07:29,970
.ستموت مايوي-تشان إن استمررنا هكذا

122
00:07:29,970 --> 00:07:31,130
.تذكّرت شيئًا

123
00:07:31,470 --> 00:07:35,220
لقد قبلت بطلب كاميا-ساما
.عن طريق البريد كحالة خاصّة

124
00:07:35,220 --> 00:07:37,430
.يحدث هذا من وقت لآخر

125
00:07:37,640 --> 00:07:39,220
أليس كذلك أيّها المدّعي العامّ؟

126
00:07:39,770 --> 00:07:43,060
.لا يملك الادّعاء أيّ أسئلة أخرى

127
00:07:43,060 --> 00:07:44,440
.انتهى استجواب الشّاهد

128
00:07:46,150 --> 00:07:51,780
،إذًا، كما صدر في هذه الشّهادة
فإن زبون القاتل هي كاميا كيريو؟

129
00:07:52,070 --> 00:07:54,610
...على هذا المعدّل، كيريو-سان سوف

130
00:07:54,610 --> 00:07:57,870
.حسنًا. تقدّم أيّها المدّعى عليه أوتورو شينغو

131
00:07:59,120 --> 00:08:00,540
.كم هذا مريح

132
00:08:00,540 --> 00:08:01,870
سيصدر الحكم أخيرًا؟

133
00:08:02,290 --> 00:08:04,880
.لا أستطيع أن أعتبرك بريئًا بالكامل

134
00:08:04,880 --> 00:08:08,210
.لقد اقترفت شرورًا كافية لتدفع بامرأة للانتحار

135
00:08:09,550 --> 00:08:14,010
.لكن يبدو أنّك بريء من تهمة القتل على الأقلّ

136
00:08:14,010 --> 00:08:15,840
.بالطّبع أنا كذلك

137
00:08:15,840 --> 00:08:19,010
.لكنّ محاميّ كاد يوقعني في ورطة

138
00:08:19,930 --> 00:08:25,150
.رغم أنّي الرّجل المنعش مثل نسيم الرّبيع

139
00:08:26,310 --> 00:08:31,780
على أيّ حال، أسرع وانطق بالحكم
.يا سيّدي القاضي

140
00:08:32,940 --> 00:08:36,450
!ستتغلّب على ذلك الوغد وتضمن إدانته، مفهوم؟

141
00:08:36,450 --> 00:08:39,200
.سوف تموتين إن فعلتُ ذلك

142
00:08:39,200 --> 00:08:43,410
،لكن إن ساعدتُ في تبرئته
!ستُتّهم كيريو-سان بتهمة القتل

143
00:08:44,540 --> 00:08:49,290
سواء كان خياري الإدانة أم التّبرئة، فهنالك
!حياة شخص على المحكّ في كلتا الحالتين

144
00:08:50,050 --> 00:08:51,300
...ناروهودو-كُن

145
00:08:52,170 --> 00:08:53,220
.أيّها الدّفاع

146
00:08:53,220 --> 00:08:57,050
.لنستمع لشهادتك الأخيرة في هذه المسألة

147
00:08:58,350 --> 00:09:01,260
...المدّعى عليه أوتورو شينغو

148
00:09:01,260 --> 00:09:02,890
ما الأمر؟

149
00:09:04,640 --> 00:09:06,650
.آسف يا مايوي-تشان

150
00:09:06,650 --> 00:09:09,110
...أنا... أنا

151
00:09:09,650 --> 00:09:10,520
!...أنا

152
00:09:16,400 --> 00:09:17,410
!مهلاً

153
00:09:20,700 --> 00:09:22,660
!الـ-المدّعية العامّة كاروما؟

154
00:09:22,660 --> 00:09:25,120
لـ-لماذا أنت هنا؟

155
00:09:26,410 --> 00:09:28,460
هنالك شيء واحد يجب القيام به
.قبل النّطق بالحكم

156
00:09:29,710 --> 00:09:31,000
!ناروهودو ريويتشي

157
00:09:33,760 --> 00:09:34,760
.اطمئنّ

158
00:09:35,380 --> 00:09:37,630
.كنت أراقب مذياع الشّرطة

159
00:09:37,630 --> 00:09:38,840
.إصابة ذو اللّحية الخفيفة طفيفة

160
00:09:40,100 --> 00:09:40,850
!سعادة القاضي

161
00:09:41,350 --> 00:09:45,480
الجزء الأخير من الدّليل في هذه المحاكمة
!وصل إلى المحكمة للتّوّ

162
00:09:45,480 --> 00:09:46,640
ماذا تقول؟

163
00:09:46,640 --> 00:09:48,520
!انتهت المحاكمة سلفًا

164
00:09:48,520 --> 00:09:50,360
.لا يملك الادّعاء أيّ اعتراضات

165
00:09:50,360 --> 00:09:53,110
.من واجبنا أن نفحص كلّ دليل يقدّم لنا

166
00:09:55,320 --> 00:09:57,030
هل ذلك قرص شريط مصوّر؟

167
00:09:57,030 --> 00:09:59,240
ماذا يوجد به؟

168
00:09:59,780 --> 00:10:02,030
.لقد تحقّقتُ منه في طريقي إلى هنا

169
00:10:02,030 --> 00:10:07,750
إنّه يحتوي على لحظة قتل كوروشيا سازايمون
.لفوجيمينو إيساو في تلك اللّيلة

170
00:10:08,290 --> 00:10:09,580
!نظام

171
00:10:09,580 --> 00:10:12,420
.ترفض المحكمة الدّليل

172
00:10:12,420 --> 00:10:13,750
!لكن لماذا؟

173
00:10:13,750 --> 00:10:17,010
.لقد سبق وحدّدنا أنّ كوروشيا هو مرتكب الجريمة

174
00:10:17,010 --> 00:10:19,260
.في هذه المرحلة، لا فائدة لذلك الشّريط

175
00:10:19,260 --> 00:10:20,340
!مستحيل

176
00:10:21,680 --> 00:10:24,720
.أجل، لا فائدة منه أيّها المحامي البارع

177
00:10:24,720 --> 00:10:25,680
!سُحقًا

178
00:10:25,680 --> 00:10:27,140
!أهذه النّهاية؟

179
00:10:27,560 --> 00:10:29,520
.لا زال الوقت باكرًا على الاستسلام

180
00:10:29,980 --> 00:10:32,360
.هذا هو الوقت المناسب لتغيّر طريقة تفكيرك

181
00:10:32,360 --> 00:10:33,400
أغيّرها؟

182
00:10:33,860 --> 00:10:36,860
.قال القاضي أنّه لا يحتاج للدّليل

183
00:10:36,860 --> 00:10:39,030
في تلك الحالة، من يحتاجه؟

184
00:10:40,490 --> 00:10:41,820
...هذا الدّليل

185
00:10:41,820 --> 00:10:44,700
.سيوفّر لنا هذا معجزة أخيرة

186
00:10:49,410 --> 00:10:54,250
المعذرة. ما الّذي كنتم تتحدّثون بشأنه؟

187
00:10:54,790 --> 00:10:58,720
يا كوروشيا سازايمون، عليك
.أن تلقي نظرة على هذا الشّريط

188
00:10:58,720 --> 00:10:59,510
!الآن

189
00:11:00,220 --> 00:11:01,220
ماذا؟

190
00:11:05,350 --> 00:11:06,680
.توقّف

191
00:11:07,560 --> 00:11:09,060
.لديّ سوال واحد

192
00:11:09,060 --> 00:11:12,020
من صوّر هذا؟

193
00:11:12,020 --> 00:11:14,400
.كان هنالك من يتجسّس على ساحة الجريمة

194
00:11:14,400 --> 00:11:15,940
الشّخص الّذي وضع آلة التّصوير هناك

195
00:11:16,570 --> 00:11:18,230
!هو أوتورو شينغو

196
00:11:18,650 --> 00:11:19,610
!توقّف

197
00:11:19,610 --> 00:11:24,870
تمّ نقل التّصوير إلى منزله وحُفظ
.في قرص شريط مسجّل

198
00:11:24,870 --> 00:11:26,530
.هذا مثير للاهتمام

199
00:11:26,910 --> 00:11:31,620
.أخبرني الزّبون أن أحمي قرصًا

200
00:11:31,920 --> 00:11:33,420
.إنّه معي هنا

201
00:11:33,420 --> 00:11:38,380
،لقد تمّ إخباري ألاّ أراه بكلّ صرامة
.حتّى شاهدتُه الآن

202
00:11:38,380 --> 00:11:39,670
...سُحقًا

203
00:11:40,420 --> 00:11:43,590
.نفس الشّريط سيكون على ذلك القرص أيضًا

204
00:11:43,590 --> 00:11:45,010
.الموجود هنا مجرّد نسخة

205
00:11:45,260 --> 00:11:46,300
نسخة؟

206
00:11:46,300 --> 00:11:47,890
من جهّزه؟

207
00:11:47,890 --> 00:11:48,720
.مايوي بالطّبع

208
00:11:49,270 --> 00:11:52,690
.لم تكن جالسة هناك تعاني الجوع فحسب

209
00:11:53,230 --> 00:11:54,850
!هذا كلّه هراء

210
00:11:54,850 --> 00:11:55,860
—أنتم

211
00:11:56,480 --> 00:11:59,280
...قال لي زبونك هذا مرّة

212
00:11:59,980 --> 00:12:01,280
.إنّها ضمانة لي

213
00:12:01,610 --> 00:12:03,990
.أنا لا أثق بأيّ أحد ومن بينهم القتلة المأجورين

214
00:12:03,990 --> 00:12:06,830
،إن حاول أن يبتزّني في المستقبل

215
00:12:06,830 --> 00:12:08,620
.فسأذيقه من نفس الكأس

216
00:12:08,620 --> 00:12:12,710
.يبدو أنّ هنالك من خانني منذ البداية

217
00:12:12,710 --> 00:12:13,790
.نعم

218
00:12:13,790 --> 00:12:16,580
.هذه هي حقيقة زبونك

219
00:12:16,580 --> 00:12:17,210
!وغد

220
00:12:17,210 --> 00:12:18,710
ماذا الآن يا كوروشيا؟

221
00:12:19,210 --> 00:12:23,170
.أذكر أنّك قلتَ أنّك تكره الخونة أكثر من أيّ شيء آخر

222
00:12:24,180 --> 00:12:27,350
.عقدي مع زبوني ملغيّ منذ هذه اللّحظة

223
00:12:27,350 --> 00:12:30,220
.يبدو أنّ لديّ هدفًا جديدًا بين يديّ

224
00:12:30,220 --> 00:12:31,770
هدفًا جديدًا؟

225
00:12:31,770 --> 00:12:34,810
.الزّبون الغبيّ الّذي خانني

226
00:12:34,810 --> 00:12:36,690
!كـ-كلاّ! لا تفعل رجاءً

227
00:12:36,690 --> 00:12:41,650
.ناروهودو-ساما، أعد أن أعيد لك غرضك

228
00:12:41,650 --> 00:12:42,280
.المعذرة

229
00:12:42,280 --> 00:12:44,150
!ماذا؟ أنا لستُ غرضًا

230
00:12:46,950 --> 00:12:49,490
.والآن، إنّه الوقت المناسب للنّطق بالحكم

231
00:12:49,780 --> 00:12:51,370
!لستَ مذنبًا

232
00:12:51,370 --> 00:12:52,410
!أنت حرّ طليق الآن

233
00:12:52,660 --> 00:12:55,420
،ومع ذلك، في أوّل ليلة تمضيها حرًّا طليقًا

234
00:12:55,420 --> 00:12:59,040
.سيزورك فيها قاتل مأجور بارع في عمله

235
00:13:00,550 --> 00:13:02,960
،سواء كنت مذنبًا أم بريئًا

236
00:13:02,960 --> 00:13:04,720
!انتهى أمرك الآن

237
00:13:12,270 --> 00:13:14,230
،إذًا في هذه المرّة وبكلّ تأكيد

238
00:13:14,230 --> 00:13:16,480
.سوف أنطق بالحكم

239
00:13:16,480 --> 00:13:19,190
...أعلن أنّ المدّعى عليه أوتورو شينغو

240
00:13:19,190 --> 00:13:21,150
!مهلاً رجاءً

241
00:13:22,030 --> 00:13:22,860
.لقد كان أنا

242
00:13:23,280 --> 00:13:24,530
.أنا فعلتُها

243
00:13:24,740 --> 00:13:26,740
ماذا تعني؟

244
00:13:26,740 --> 00:13:30,870
!أنا طلبتُ منه قتل فوجيمينو

245
00:13:30,870 --> 00:13:33,200
!سوف يقتلني

246
00:13:33,200 --> 00:13:35,960
!سوف يقتلني إن خرجت من هنا حرًّا

247
00:13:35,960 --> 00:13:36,920
!أنا مذنب

248
00:13:36,920 --> 00:13:40,080
!ليكن حكمك أنّي مذنبًا رجاءً

249
00:13:42,800 --> 00:13:47,630
.يبدو أنّنا وصلنا لنهاية أكيدة

250
00:13:51,970 --> 00:13:53,140
.إليكم الحكم

251
00:13:53,140 --> 00:13:56,100
...أعلن أنّ المدّعى عليه أوتورو شينغو

252
00:13:57,640 --> 00:13:58,980
.مذنب

253
00:14:22,090 --> 00:14:23,040
.كيريو-سان

254
00:14:34,430 --> 00:14:36,470
.يبدو أنّها في سلام الآن

255
00:14:36,470 --> 00:14:37,310
.أجل

256
00:14:37,310 --> 00:14:37,850
!هذا مؤلم

257
00:14:38,140 --> 00:14:39,190
!لماذا تبتسم؟

258
00:14:40,140 --> 00:14:41,730
.كان الحكم بالإدانة

259
00:14:41,730 --> 00:14:43,520
!لقد خسرت

260
00:14:43,520 --> 00:14:45,690
لماذا أنت سعيد هكذا؟

261
00:14:45,690 --> 00:14:47,650
.ما كنتِ لتفهمي

262
00:14:48,400 --> 00:14:49,740
.ميتسوروغي

263
00:14:49,740 --> 00:14:50,990
ماذا تعني؟

264
00:14:51,240 --> 00:14:53,200
.كنت هكذا أنا أيضًا

265
00:14:55,120 --> 00:14:56,700
فعلتُ أيّ شيء لأفوز

266
00:14:57,120 --> 00:14:59,210
.وأضفت انتصاراتٍ على انتصاراتي

267
00:14:59,210 --> 00:15:01,000
.إلى أن ظهر رجل أمامي

268
00:15:02,000 --> 00:15:05,460
،عندما خسرت لأوّل مرّة أمامك

269
00:15:07,130 --> 00:15:11,380
.شعرتُ أنّي خسرت كلّ شيء

270
00:15:11,720 --> 00:15:14,600
.ولاحقًا، جلست في مكان المدّعى عليهم

271
00:15:16,060 --> 00:15:19,930
وهناك، شاهدتُ كلّ ما آمتُ
.به يتحطّم أمامي

272
00:15:19,930 --> 00:15:23,480
لذلك السّبب لم يكن لي خيار آخر
.سوى مغادرة مكتب الادّعاء العامّ

273
00:15:24,360 --> 00:15:27,650
المدّعي العامّ الّذي لا يستطيع
!أن يفوز خيرٌ له أن يموت

274
00:15:27,650 --> 00:15:29,440
لا بدّ أنّك أدركت

275
00:15:29,440 --> 00:15:32,160
.أنّ تلك الهزيمة كانت بداية جديدة

276
00:15:32,160 --> 00:15:34,030
!ما-ما هذا الهراء؟

277
00:15:34,030 --> 00:15:35,780
،مهما حاولنا إخفاءها

278
00:15:35,780 --> 00:15:37,620
.سوف تجد الحقيقة دائمًا طريقها للنّور

279
00:15:37,990 --> 00:15:43,000
الشّي الوحيد الّذي يمكننا فعله هو أن نثق
.ببعضنا ونقاتل بكلّ ما لدينا

280
00:15:43,370 --> 00:15:44,830
نثق ببعضنا؟

281
00:15:45,130 --> 00:15:46,090
.بالفعل

282
00:15:46,090 --> 00:15:49,380
.لهذا السّبب وُجد المدّعون العامّون والمحامون

283
00:15:49,380 --> 00:15:50,920
.أنت تعرف ذلك سلفًا

284
00:15:51,550 --> 00:15:55,390
لذلك السّبب لم تستطع أن تسامحني، صحيح؟

285
00:15:55,970 --> 00:15:59,720
.شعرتُ بالخيانة عندما سمعتُ أنّك اختفيت

286
00:16:00,480 --> 00:16:03,480
السّبب الّذي جعلني أصبح محاميًا

287
00:16:03,480 --> 00:16:06,020
.هو أنّي آمنت بالأشياء الّتي قلتَها لي قبل سنوات

288
00:16:06,020 --> 00:16:08,860
.وخنتَ كلماتك أنت

289
00:16:09,780 --> 00:16:13,660
.لذلك السّبب ختمتُ على رمز صداقتنا

290
00:16:16,200 --> 00:16:17,780
.لكنّي كنتُ مخطئًا

291
00:16:18,080 --> 00:16:21,790
لقد دفعتَ نفسك حتّى حافّة الهاوية
.ووجدت الجواب الحقيقيّ

292
00:16:22,500 --> 00:16:24,710
وجدتَ أنّ الثّقة في النّاس والاعتماد عليهم

293
00:16:24,710 --> 00:16:28,040
!هي الطّريقة الوحيدة لبلوغ الحقيقة

294
00:16:33,630 --> 00:16:34,880
.لقد أنقذتني ثانية

295
00:16:35,390 --> 00:16:36,890
.ميتسوروغي، شكرًا لك

296
00:16:38,180 --> 00:16:40,850
.أقوم بعملي فحسب

297
00:16:44,100 --> 00:16:45,400
!هذه حماقة

298
00:16:45,400 --> 00:16:47,810
!كلّ ما تفعلونه هو مواساة بعضكم كخاسرين

299
00:16:58,240 --> 00:16:58,950
.مي

300
00:17:13,670 --> 00:17:14,920
!مايوي-تشان

301
00:17:15,510 --> 00:17:16,720
!ناروهودو-كُن

302
00:17:16,720 --> 00:17:17,640
!مايوي— هذا ساخن

303
00:17:17,640 --> 00:17:18,850
.آسفة

304
00:17:20,390 --> 00:17:21,760
!ناروهودو-كُن

305
00:17:21,760 --> 00:17:23,270
!أنا سعيد لأنّك بخير

306
00:17:23,270 --> 00:17:25,560
!كم هذا مريح

307
00:17:25,560 --> 00:17:26,440
.تفضّلي

308
00:17:26,440 --> 00:17:28,650
.شكرًا لك يا ياهاري-سان

309
00:17:28,650 --> 00:17:29,360
.مايوي

310
00:17:29,610 --> 00:17:30,980
!أختي

311
00:17:33,480 --> 00:17:35,900
.أبليت حسنًا يا مايوي

312
00:17:35,900 --> 00:17:38,240
.أجل، لقد بذلت جهدي بالفعل

313
00:17:38,240 --> 00:17:39,530
.فتاة جيّدة

314
00:17:39,530 --> 00:17:41,830
.نعم، كنت فتاة جيّدة

315
00:17:42,370 --> 00:17:44,290
!أختي

316
00:17:44,290 --> 00:17:47,460
هذا يبعث على البكاء، صحيح يا ناروهودو؟

317
00:17:47,460 --> 00:17:48,710
!هذا صحيح

318
00:17:48,920 --> 00:17:50,080
.ناروهودو-كُن

319
00:17:50,080 --> 00:17:50,790
نعم؟

320
00:17:51,380 --> 00:17:53,300
استمرّ في الاعتناء بمايوي، مفهوم؟

321
00:17:53,500 --> 00:17:54,710
.بالطّبع

322
00:17:55,260 --> 00:17:57,930
.سأكون إلى جانبك دائمًا

323
00:17:57,930 --> 00:17:58,930
.أعلم

324
00:17:59,390 --> 00:18:00,930
لا تتهاوني في تدريبك، مفهوم؟

325
00:18:00,930 --> 00:18:01,720
.حسنًا

326
00:18:05,180 --> 00:18:09,690
!مايوي-ساما

327
00:18:06,600 --> 00:18:07,560
!هامي-تشان

328
00:18:09,690 --> 00:18:13,150
هذا يبعث على البكاء، صحيح يا ناروهودو؟

329
00:18:13,150 --> 00:18:14,820
!هذا صحيح

330
00:18:14,820 --> 00:18:18,780
لقد عاقبتم ذلك البطل الشّرير، صحيح؟

331
00:18:18,780 --> 00:18:21,700
نعم. أنا واثق أنّ كوروشيا سيقع
.في يد العدالة قريبًا أيضًا

332
00:18:22,160 --> 00:18:24,240
!بالحديث عن الأبطال، لقد فقدتُ بطل الإشارة الزّرقاء

333
00:18:25,700 --> 00:18:29,120
!يمكنك دائمًا الاعتماد على إيتونوكوغيري

334
00:18:29,120 --> 00:18:31,500
!شكرًا لك أيّها المحقّق إيتونوكو

335
00:18:32,090 --> 00:18:33,500
.أنا آسفة

336
00:18:33,500 --> 00:18:35,090
.لا، أنا بخير

337
00:18:35,090 --> 00:18:36,960
.لم يكن إلاّ جرحًا في الجسد

338
00:18:40,260 --> 00:18:42,600
.شكرًا لك يا ناروهودو-كُن

339
00:18:43,760 --> 00:18:46,810
.لقد تمكّنت من الاستمرار في القتال بسبب هذا

340
00:18:46,810 --> 00:18:50,020
.وأنا استمررت في القتال لأنّك معي

341
00:18:50,770 --> 00:18:53,110
هذا يبعث على البكاء، صحيح يا ناروهودو؟

342
00:18:53,110 --> 00:18:55,530
!هذا صحيح

343
00:18:55,530 --> 00:18:58,650
.صحيح، كنتُ جائعة

344
00:18:58,650 --> 00:19:00,610
.هيّا. لنأكل جميعًا

345
00:19:00,610 --> 00:19:03,280
.تفضّلي يا هامي-تشان. إليك زبديّة تيمبورا

346
00:19:03,280 --> 00:19:05,240
هل يمكنني أكلها بالفعل؟

347
00:19:05,240 --> 00:19:07,330
.ياهارا-سان، إليك بعض أضلاع الخنزير

348
00:19:07,330 --> 00:19:09,540
!هذا ما أرغب بسماعه الآن

349
00:19:09,540 --> 00:19:11,120
.إيتونوكو، إليك شريحة لحم

350
00:19:11,120 --> 00:19:12,250
.شكرًا لك

351
00:19:12,250 --> 00:19:14,250
.ناروهودو-كُن، إليك لفت الدّايكون المخلّل

352
00:19:14,250 --> 00:19:15,800
أليس معك ياكيسوبا؟

353
00:19:27,560 --> 00:19:28,980
إلى أين تذهبي؟

354
00:19:31,060 --> 00:19:32,100
هل ستهربين؟

355
00:19:32,100 --> 00:19:33,230
!اخرس

356
00:19:34,810 --> 00:19:39,030
!أنت لن تفهم أبدًا ما يعنيه أن تكون من عائلة كاروما

357
00:19:39,240 --> 00:19:40,110
...مي

358
00:19:40,610 --> 00:19:44,070
.كان أبي عبقريًّا، أمّا أنا فلا

359
00:19:44,070 --> 00:19:48,040
.لطالما عرفتُ هذا لكن لم أستطع الاعتراف به

360
00:19:48,490 --> 00:19:51,210
.المدّعون العامّون لا يقاتلون من أجل الشّهرة والمجد

361
00:19:51,210 --> 00:19:53,040
.من الأفضل أن تعرفي ذلك أيضًا

362
00:19:53,040 --> 00:19:54,540
!أنت هكذا دائمًا

363
00:19:54,540 --> 00:19:57,380
.تتركني خلفك دائمًا وتستمرّ في التّقدّم بمفردك

364
00:19:57,670 --> 00:19:58,960
.أنا أكرهك

365
00:19:59,710 --> 00:20:02,760
.لهذا السّبب أردت أن أهزم ذلك الرّجل

366
00:20:03,470 --> 00:20:05,180
.ناروهودو ريويتشي

367
00:20:05,760 --> 00:20:08,220
.كنت أريد هزيمة الرّجل الّذي هزمك

368
00:20:08,220 --> 00:20:10,220
.كان من المفترض أن يكون ذلك انتقامي

369
00:20:10,810 --> 00:20:11,930
.فهمت

370
00:20:12,850 --> 00:20:14,650
.لا أستطيع فعل ذلك

371
00:20:14,650 --> 00:20:16,810
.لا يمكنني أن أتجاهل ما كنتُ عليه حتّى اليوم

372
00:20:17,520 --> 00:20:18,650
.بل يمكنك

373
00:20:18,650 --> 00:20:20,650
،وجب أن تكوني قد أدركتِ ذلك اليوم

374
00:20:20,650 --> 00:20:23,200
.بعد أن رأيتِه يقاتل

375
00:20:26,240 --> 00:20:28,330
.لا نيّة لي للوقوف حيث أنا

376
00:20:28,830 --> 00:20:32,370
،إن كنت ستتوقّفين عن المسير
.فهنا سنفترق

377
00:20:36,380 --> 00:20:38,880
.أنا كاروما مي

378
00:20:39,420 --> 00:20:42,380
إيّاك أن تفكّر للحظة واحدة

379
00:20:42,670 --> 00:20:45,340
!أنّي سأسير في ظلّك للأبد

380
00:20:45,340 --> 00:20:47,260
،بدأت معركتنا الآن

381
00:20:47,260 --> 00:20:48,550
!يا ميتسوروغي ريجي

382
00:20:57,730 --> 00:20:59,400
،عندما رأيتُ هذا حينها

383
00:20:59,860 --> 00:21:02,570
.راودني إحساس غريب بأنّه عليّ أن أحضره لك

384
00:21:05,280 --> 00:21:06,910
،ناروهودو ريويتشي

385
00:21:07,700 --> 00:21:09,580
.دعنا نلتقي ثانية في المحكمة يومًا ما

386
00:21:10,280 --> 00:21:12,580
.سأحتفظ بهذه حتّى ذلك الحين

387
00:21:16,580 --> 00:21:18,880
.بهذا، وصلت قصّتي لنهايتها

388
00:21:19,380 --> 00:21:22,260
،إنّ بتوديعي لناروهودو المحامي المبتدئ ذاك

389
00:21:22,260 --> 00:21:27,510
قلبتُ صفحة جديدة وها أنا أعيش
...فصلاً جديدًا من حياتي

390
00:21:27,840 --> 00:21:29,680
.رفقة كلّ تلك الوجوه المألوفة

391
00:21:30,260 --> 00:21:31,680
!أعترض

392
00:21:32,270 --> 00:21:33,890
!ساذج! ساذج كثيرًا

393
00:21:33,890 --> 00:21:35,350
!أنت هاوٍ

394
00:21:35,350 --> 00:21:39,190
.أيّها الدّفاع، أعد التّفكير في ذلك مرّة أخرى

395
00:21:39,400 --> 00:21:41,110
.مفهوم

396
00:21:41,110 --> 00:21:43,570
...سأقبل عرضك وثمّ

397
00:21:44,860 --> 00:21:45,990
!أعترض