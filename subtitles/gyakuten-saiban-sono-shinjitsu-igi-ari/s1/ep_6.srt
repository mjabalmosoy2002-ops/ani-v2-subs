1
00:00:01,100 --> 00:00:05,350
كانت القضيّة الّتي اختارتها مايوي-تشان
.لتكون الأولى لنا جريمة قتل تتعلّق ببطل

2
00:00:05,850 --> 00:00:07,900
،بعد أن حاصرتني الأدلّة من كلّ جهة

3
00:00:07,900 --> 00:00:10,400
.اتّهمتُ الشّاهدة أوبا-تشان بالجريمة

4
00:00:11,280 --> 00:00:14,570
لكنّها كشفت عن حقيقة صادمة
!في المحكمة بعد أن اعتراها الغضب

5
00:01:46,210 --> 00:01:49,630
.في الواقع، هنالك شيء قيل لي ألاّ أذكره

6
00:01:49,880 --> 00:01:51,420
قـ-قيل لك ألاّ تذكريه؟

7
00:01:51,880 --> 00:01:52,840
ما هو؟

8
00:01:53,090 --> 00:01:54,250
!بالضّبط

9
00:01:54,250 --> 00:01:56,220
.استمعوا جيّدًا لكلامي

10
00:01:56,220 --> 00:02:00,760
كان هنالك أشخاص آخرون
!في الاستوديو يوم ارتكاب الجريمة

11
00:02:03,890 --> 00:02:04,890
!مستحيل

12
00:02:04,890 --> 00:02:06,390
لماذا لم أسمع بهذا من قبل؟

13
00:02:06,730 --> 00:02:10,690
أيّتها الشّاهدة، لماذا أخفيتِ بهذه
المعلومة  المهمّة عن المحكمة؟

14
00:02:10,690 --> 00:02:12,480
ألم تكن تستمع لي؟

15
00:02:12,480 --> 00:02:15,150
ماذا كان عليّ أن أفعل؟
!لقد أخبروني ألاّ أقول شيئًا

16
00:02:15,150 --> 00:02:17,400
.قالوا أنّ لا علاقة لهم بالأمر

17
00:02:17,400 --> 00:02:19,950
.قالوا أن أتظاهر أنّهم لم يكونوا في الاستوديوهات

18
00:02:20,410 --> 00:02:22,320
من كان هؤلاء الأشخاص؟

19
00:02:22,320 --> 00:02:26,580
كان هنالك اجتماع لأشخاص مهمّين
.في القناة والمخرج والمنتجة

20
00:02:26,580 --> 00:02:29,250
وأين أقيم هذا الاجتماع؟

21
00:02:29,250 --> 00:02:31,670
.في مقطورة الاستوديو 2

22
00:02:31,670 --> 00:02:33,250
الاستوديو 2؟

23
00:02:33,250 --> 00:02:35,170
.هذه أوّل مرّة نسمع فيها عن هذا

24
00:02:35,500 --> 00:02:40,220
سعادة القاضي، عرفنا أنّه كان هنالك
.أشخاص آخرون في الاستوديو ذلك اليوم

25
00:02:40,220 --> 00:02:42,430
.لم يتمّ حتّى استجوابهم بينما نحن نترافع هنا

26
00:02:42,930 --> 00:02:45,640
!أرى أنّه من المستحيل النّطق بالحكم في هذه الحالة

27
00:02:46,180 --> 00:02:49,390
ما قولك أيّها المدّعي العامّ ميتسوروغي؟

28
00:02:50,640 --> 00:02:51,850
.لا خيار أمامي سوى الموافقة

29
00:02:52,730 --> 00:02:56,280
يا ويلي يا مي-تشان... لا تنظر إليّ
.بهذه النّظرة الشّغوفة

30
00:02:57,610 --> 00:02:58,570
.حسنًا

31
00:02:58,570 --> 00:03:01,950
.بهذا تنتهي محاكمة اليوم

32
00:03:06,990 --> 00:03:10,660
كنتَ تعرف بوجود أشخاص آخرين هناك؟

33
00:03:10,660 --> 00:03:14,710
.آ-آسف. لقد طُلب منّي أن ألتزم الصّمت أيضًا

34
00:03:14,710 --> 00:03:18,880
،عليك أن تخبرنا بأشياء كهذه
.وإلاّ سنخسر القضيّة

35
00:03:18,880 --> 00:03:22,720
...ناروهودو-كُن محامٍ جديد
!إنّه لا يزال في بداية طريقه

36
00:03:22,720 --> 00:03:23,890
.ما كان عليك قول ذلك

37
00:03:24,090 --> 00:03:26,260
.أ... أنا أقدّر تحذيركما هذا

38
00:03:26,260 --> 00:03:29,180
.على  أيّ حال، سنعود إلى الاستوديو ثانية

39
00:03:29,180 --> 00:03:32,100
!آمُل أن نقابل ذلك الفتى

40
00:03:32,100 --> 00:03:34,020
.علينا أن نعيد هذا إليه

41
00:03:34,980 --> 00:03:36,940
تقصدين الفتى صاحب آلة التّصوير؟

42
00:03:37,360 --> 00:03:38,690
أتعرفه؟

43
00:03:38,940 --> 00:03:42,650
.نعم، يبدو أنّه كان يتسلّل للاستوديو كثيرًا

44
00:03:42,650 --> 00:03:44,200
.لقد قابلته عدّة مرّات

45
00:03:49,290 --> 00:03:50,450
!شبح؟

46
00:03:50,450 --> 00:03:52,120
شبح؟ هل أنت جادّ؟

47
00:03:53,920 --> 00:03:56,210
كيف يمكن لرجل راشد أن يكون خائفًا هكذا؟

48
00:03:58,130 --> 00:03:58,840
!أنت

49
00:04:00,760 --> 00:04:03,630
.عليك أن تتعلّم من ساموراي الفولاذ

50
00:04:03,630 --> 00:04:06,600
!أسلوب حياته رائع

51
00:04:07,970 --> 00:04:09,390
أسلوب حياته؟

52
00:04:09,390 --> 00:04:12,560
.كان حريًّا بك أن تخبره أنّك ساموراي الفولاذ فحسب

53
00:04:12,560 --> 00:04:17,610
لكنّ معرفته أنّ هذا الرّجل الرّثّ
.والعجوز هو بطله كانت لتُخيّب أمله

54
00:04:17,610 --> 00:04:19,650
...وأنا لا أمانع ذلك

55
00:04:19,650 --> 00:04:22,110
.ما دام الأطفال سيستمرّون بحبّ ساموراي الفولاذ

56
00:04:22,440 --> 00:04:24,030
.عرفتُ أنّ ذلك غير ممكن

57
00:04:24,030 --> 00:04:27,620
لا يمكن أبدًا لرجل لطيف مثله
.أن يلطّخ اسم ساموراي الفولاذ

58
00:04:28,830 --> 00:04:32,330
.إذًا فهنالك شخص آخر ارتكب الجريمة

59
00:04:32,790 --> 00:04:34,080
.علينا أن نعرف من كان

60
00:04:39,500 --> 00:04:41,380
.ماذا؟ لا أحد هنا

61
00:04:41,630 --> 00:04:43,800
.لكنّ رجل الأمن قال أنّ المخرج هنا

62
00:04:47,590 --> 00:04:49,470
!ها أنت هنا

63
00:04:49,850 --> 00:04:50,930
.وجدتُك

64
00:04:52,640 --> 00:04:54,060
!من أنت؟

65
00:04:54,310 --> 00:04:55,850
!أيّها الغبيّان

66
00:04:55,850 --> 00:04:57,980
ألا تعرفان أوزاي تاكويا العظيم؟

67
00:04:57,980 --> 00:05:01,320
!أنا المخرج الأبرع! أنا صانع ساموراي الفولاذ

68
00:05:01,610 --> 00:05:03,570
!هل أنت جادّ؟

69
00:05:09,410 --> 00:05:11,330
.هذا رائع

70
00:05:11,330 --> 00:05:13,370
...هيّا

71
00:05:12,080 --> 00:05:15,620
.رائع للغاية

72
00:05:13,790 --> 00:05:16,710
!ساموراي

73
00:05:18,750 --> 00:05:23,880
!هذا كثير... لقد أيقظتِ قواي الإبداعيّة

74
00:05:24,550 --> 00:05:28,470
!الإلهام يستحوذ عليّ. الجزء الثّاني لساموراي الفولاذ

75
00:05:29,140 --> 00:05:32,010
!محاربة كويدو، الأميرة الورديّة

76
00:05:32,310 --> 00:05:34,140
الأميرة الورديّة؟

77
00:05:35,020 --> 00:05:37,940
لماذا العنوان هو "كويدو" وليس "أويدو"؟

78
00:05:37,940 --> 00:05:39,980
لماذا تأخذينه على محمل الجدّ؟

79
00:05:41,150 --> 00:05:44,940
إذًا فأنتما تدافعان عن نيبوشي-تشان؟

80
00:05:44,940 --> 00:05:49,110
أنت المخرِج، ومع ذلك عليك توصيل
النّصّ إلى المنتجة؟

81
00:05:49,110 --> 00:05:50,120
.يبدو هذا قاسيًا

82
00:05:50,120 --> 00:05:50,910
،خلال التّدريبات

83
00:05:50,910 --> 00:05:55,950
تقوم بإصدار الأوامر، وفي يدها النّصّ
.الّذي يحتوي شرحًا مفصّلاً

84
00:05:55,950 --> 00:05:59,880
!سوف تتمّ معاقبتي إن لم آخذه لها بسرعة

85
00:06:00,130 --> 00:06:02,090
تضيف ملاحظات للنّصّ؟

86
00:06:02,090 --> 00:06:04,840
.يبدو أنّ تلك المنتجة تفرض نفسها جيّدًا

87
00:06:05,460 --> 00:06:07,840
كنتَ في الاجتماع أثناء وقوع الجريمة، صحيح؟

88
00:06:07,840 --> 00:06:10,890
.نعم، كان لدينا تدريب على مشهد حركة في الصّباح

89
00:06:10,890 --> 00:06:12,970
.وبعدها اجتماع استمرّ حتّى الرّابعة عصرًا

90
00:06:12,970 --> 00:06:14,510
تدريب على مشهد حركة؟

91
00:06:17,020 --> 00:06:21,560
.إذًا فقد كان المخرج هناك عندما أُصيب نيبوشي-سان

92
00:06:24,570 --> 00:06:27,030
لحظة، ما هو هذا؟

93
00:06:27,030 --> 00:06:29,860
ألا تعرف قزم الغابة؟

94
00:06:29,860 --> 00:06:32,370
.إنّه الدّمية جالبة الحظّ للاستوديو

95
00:06:32,370 --> 00:06:34,870
...ليس ذلك ما قصدتُه

96
00:06:34,870 --> 00:06:37,160
هل سقط رأسه؟

97
00:06:37,160 --> 00:06:39,160
،إنّه قديم جدًّا

98
00:06:39,160 --> 00:06:42,210
.وكانت هنالك رياح قويّة في يوم ارتكاب الجريمة

99
00:06:47,130 --> 00:06:49,090
.هذا هو الاستوديو 2

100
00:06:49,090 --> 00:06:51,550
هنالك استوديو بعيد كلّ هذه المسافة؟

101
00:06:51,550 --> 00:06:54,350
.أجل، لكنّه لا يُستعمل لأكثر من خمس سنوات

102
00:06:54,350 --> 00:06:55,560
لماذا ذلك؟

103
00:06:55,560 --> 00:06:57,060
!لا أدري

104
00:06:57,060 --> 00:06:59,140
.وقعت حادثة ما كما يبدو

105
00:06:59,140 --> 00:07:01,690
.ربّما تعرف الحارسة العجوز بالأمر

106
00:07:01,690 --> 00:07:03,730
.لقد كانت موجودة أثناء حدوثها

107
00:07:16,370 --> 00:07:18,870
كيف هي هذه المنتجة؟

108
00:07:18,870 --> 00:07:20,580
أ-أنت لا تعرف؟

109
00:07:20,870 --> 00:07:22,080
...هيميغامي ساكورا

110
00:07:22,460 --> 00:07:25,540
.لقد اشترت الاستوديو عندما كان على شفير الدّمار

111
00:07:25,540 --> 00:07:27,420
!لا يستطيع أحد معارضتها

112
00:07:36,510 --> 00:07:39,560
أنتِ هي المنتجة هيميغامي، صحيح؟

113
00:07:40,430 --> 00:07:42,890
.نحن ندافع عن نيبوشي-سان

114
00:07:43,980 --> 00:07:47,570
.كنتُ أتساءل إن كان بإمكانك إخبارنا عن الجريمة

115
00:07:47,570 --> 00:07:48,820
.صمتًا رجاءً

116
00:07:50,320 --> 00:07:52,990
.أنا أقرأ النّصّ

117
00:07:52,990 --> 00:07:55,200
أ-أتريد أن تعاقبك؟

118
00:07:55,530 --> 00:07:56,870
.لن نحرز تقدّمًا سريعًا

119
00:07:57,580 --> 00:07:58,490
...هناك، هناك

120
00:07:58,830 --> 00:08:01,160
!انظر يا ناروهودو-كُن

121
00:08:01,160 --> 00:08:05,250
كلّ هذه أفلام مثّل فيها الضّحيّة إيبوكورو-سان؟

122
00:08:06,040 --> 00:08:08,040
!"ساموراي الدّيناميت"

123
00:08:08,040 --> 00:08:10,130
كذبة السّاموراي السّاخر"؟"

124
00:08:10,130 --> 00:08:11,170
.هذا يبعث على البكاء

125
00:08:11,170 --> 00:08:14,680
!"سلسلة "القائد الملتحي
!أنا أتذكّرها

126
00:08:14,680 --> 00:08:16,140
ساموراي الصّيف؟

127
00:08:16,140 --> 00:08:17,800
!هذا يعيد لي ذكريات الصّيف

128
00:08:17,800 --> 00:08:22,140
،كانت قصّة رومانسيّة مناسبة للصّيف
.لكنّها كانت في حقبة قديمة

129
00:08:22,390 --> 00:08:25,690
مذهل، أعتقد أنّ إيبوكورو تاكيشي
.كان نجمًا ساطعًا

130
00:08:28,480 --> 00:08:30,110
محامي نيبوشي؟

131
00:08:30,440 --> 00:08:32,990
تريد أن تعرف ما حدث يوم ارتكاب الجريمة؟

132
00:08:32,990 --> 00:08:34,530
.نـ-نعم

133
00:08:35,160 --> 00:08:37,320
،أكره إخبارك بهذا، لكن في وقت ارتكاب الجريمة

134
00:08:37,320 --> 00:08:41,700
.ما كان الحاضرون هنا ليستطيعوا الذّهاب للاستوديو 1

135
00:08:41,700 --> 00:08:43,660
ما كانوا يستطيعون؟ كيف؟

136
00:08:48,040 --> 00:08:49,790
.كان الطّريق مغلقًا

137
00:08:51,380 --> 00:08:55,430
رأيتَ قزم الغابة في طريقك إلى هنا، صحيح؟

138
00:08:55,680 --> 00:08:57,090
قزم الغابة؟

139
00:08:57,090 --> 00:08:59,350
.القرد ذو الرّأس المكسور

140
00:09:03,480 --> 00:09:07,310
،كسرت الرّياح رأسه الكبير والغبيّ في ذلك اليوم

141
00:09:07,310 --> 00:09:09,400
.وأدّت إلى سدّ الطّريق

142
00:09:09,400 --> 00:09:14,320
لم تحضر الرّافعة لإزاحته
.عن الطّريق إلاّ بعد الثّالثة عصرًا

143
00:09:14,570 --> 00:09:17,660
.أخذ الأمر ساعة لفتح الطّريق

144
00:09:19,700 --> 00:09:23,080
كلّ من كان في هذه المقطورة
.كان عالقًا حتّى ذلك الحين

145
00:09:23,080 --> 00:09:25,000
.ما كان بمقدور أحد منّا قتل إيبوكورو

146
00:09:25,000 --> 00:09:28,290
لكن ماذا إن كان الرّأس قد وقع بعد الثّانية والنّصف؟

147
00:09:28,290 --> 00:09:30,040
.سيكون بمقدوركم حينها الذّهاب للاستوديو 1

148
00:09:32,210 --> 00:09:35,670
.يعلن قزم الغابة عن الوقت في كلّ ساعة

149
00:09:35,670 --> 00:09:37,430
."يعلن الوقت قائلاً، "أعتقد أنها الرّابعة عصرًا

150
00:09:37,760 --> 00:09:39,430
.تحقّق ما يوجد خلف رأسه

151
00:09:39,930 --> 00:09:42,350
.توقّفت السّاعة عندما انكسر

152
00:09:42,970 --> 00:09:46,810
.‫2:15... أي قبل مَقتل إيبوكورو-سان

153
00:09:46,810 --> 00:09:51,360
إذًا فمن كانوا في المقطورة لا علاقة لهم بالجريمة؟

154
00:09:56,530 --> 00:09:58,860
!أيّها المبتدئ الخائن

155
00:09:58,860 --> 00:10:02,830
على رسلك! لقد قلتُ أنّه من المرجّح
...أن تكوني الجانية فحسب

156
00:10:02,830 --> 00:10:05,540
.بالمناسبة، لقد عدتِ لعملكِ بسرعة

157
00:10:05,540 --> 00:10:07,080
!لقد أخذتني الشّرطة

158
00:10:07,080 --> 00:10:09,750
كان لديهم زيّ إضافيّ لساموراي
!الفولاذ وطلبوا منّي ارتداءه

159
00:10:09,750 --> 00:10:12,090
كيف لسيّدة لطيفة مثلي
!أن ترتدي زيًّا ضخمًا كذاك؟

160
00:10:12,090 --> 00:10:13,460
.تركوني أذهب عندما رأوا أنّي لا أستطيع ارتداءه

161
00:10:13,460 --> 00:10:14,670
من يظنّون أنفسهم؟

162
00:10:14,670 --> 00:10:16,800
.اعلم أنّ أوبا-تشان لا تنسى الإهانة وقلّة الاحترام

163
00:10:16,800 --> 00:10:18,010
.لن أتحدّث إليك ثانية

164
00:10:18,010 --> 00:10:19,720
!لا تأتِ إليّ عندما تشعر بالوحدة. فمي سيظل مغلقًا

165
00:10:19,720 --> 00:10:21,600
إنّك تتكلّمين كثيرًا بالنّسبة
.لشخص فمه سيظلّ مغلقًا

166
00:10:21,600 --> 00:10:22,930
!اخرسي أيّتها التّافهة! سأبدأ من الآن

167
00:10:22,930 --> 00:10:24,600
!واحد، اثنان، ثلاث، الآن

168
00:10:24,600 --> 00:10:28,060
لكنّ إيبوكورو-سان كان رائعًا، صحيح؟

169
00:10:29,230 --> 00:10:30,400
.نعم، نعم

170
00:10:30,400 --> 00:10:33,860
صورة إعلان فيلم "ساموراي الدّيناميت" تجعل
من يشاهدها يشعر بالقشعريرة، صحيح؟

171
00:10:35,860 --> 00:10:38,110
."أنا أفضّل "القائد الملتحي

172
00:10:38,110 --> 00:10:40,030
لا يمكن نسيان سلسلة "القائد الملتحي"، صحيح؟

173
00:10:40,030 --> 00:10:41,700
.إيبوكورو-تشان نجم سيعيش للأبد

174
00:10:41,700 --> 00:10:43,740
.لقد كان جزءًا كبيرًا من شبابي

175
00:10:43,740 --> 00:10:46,830
.ليت تلك الحادثة لم تقع

176
00:10:47,330 --> 00:10:49,500
حادثة؟ تقصدين الّتي وقعت قبل خمس سنوات؟

177
00:10:49,870 --> 00:10:51,920
!أخبرينا عنها يا أوبا-تشان

178
00:10:51,920 --> 00:10:53,590
.كلاّ، لن أخبركما

179
00:10:53,590 --> 00:10:58,130
بالتّفكير بالأمر، تمّ هجر الاستوديو 2
.قبل خمس سنوات أيضًا

180
00:10:58,380 --> 00:10:59,470
...اخرس

181
00:10:59,470 --> 00:11:01,840
!سبق وأخبرتكما أنّ فمي سيظلّ مغلقًا

182
00:11:01,840 --> 00:11:04,180
إنّك تتكلّمين كثيرًا بالنّسبة
.لشخص فمه سيظلّ مغلقًا

183
00:11:04,180 --> 00:11:05,310
.كما سبق وقلت، سأبدأ من الآن

184
00:11:05,310 --> 00:11:07,350
!واحد، اثنان، ثلاثة، الآن

185
00:11:07,350 --> 00:11:08,600
!ذلك الفتى

186
00:11:10,480 --> 00:11:11,900
—انتظر مكانك

187
00:11:14,610 --> 00:11:16,980
!أيّها الفتى... انتظر

188
00:11:17,980 --> 00:11:20,860
!اسمي كيوتا! أوتاكي كيوتا

189
00:11:20,860 --> 00:11:24,570
نادني "فتى" ثانية، وسأقطعك
!حيث تقف الآن أيّها العجوز

190
00:11:24,820 --> 00:11:27,040
!الـ-العجوز؟

191
00:11:27,040 --> 00:11:30,330
على أيّ حال، لقد أوقعتَ هذا في ذلك اليوم، صحيح؟

192
00:11:30,330 --> 00:11:31,080
.تفضّل

193
00:11:31,920 --> 00:11:34,630
!إنّها مجموعة رائعة

194
00:11:34,630 --> 00:11:36,630
هل التقطتَ كلّ تلك الصّور بنفسك؟

195
00:11:37,880 --> 00:11:39,340
.بإمكانك الاحتفاظ به

196
00:11:39,340 --> 00:11:40,590
.لا زلت أحتفظ بالصّور الأصليّة

197
00:11:40,590 --> 00:11:41,970
!أنت جادّ؟

198
00:11:41,970 --> 00:11:44,050
!مرحى! أنت الأفضل

199
00:11:44,720 --> 00:11:46,180
أنت تحبّ ساموراي الفولاذ، صحيح؟

200
00:11:46,510 --> 00:11:48,180
!أوليس ذلك واضحًا؟

201
00:11:48,720 --> 00:11:52,600
.لقد حضرتُ كلّ عرض مباشر له

202
00:11:54,810 --> 00:12:00,150
أنا ألتقط الصّور دائمًا لساموراي الفولاذ
!وهو ينفّذ ضربته القاضية

203
00:12:00,150 --> 00:12:02,450
.جميعها بحوزتي. المجموعة المثاليّة

204
00:12:02,450 --> 00:12:05,740
!لم أفوّت ولا واحدة منها

205
00:12:05,740 --> 00:12:10,200
صحيح... هل رأيتَ أيّ شيء هنا في يوم الحادثة؟

206
00:12:10,200 --> 00:12:11,160
كنتَ هنا، صحيح؟

207
00:12:14,620 --> 00:12:15,630
كيوتا-كُن؟

208
00:12:16,290 --> 00:12:18,840
.لقد... لقد رأيتُ كلّ شيء

209
00:12:20,000 --> 00:12:22,720
ماذا رأيتَ بالضّبط؟

210
00:12:23,760 --> 00:12:28,390
!ساموراي الفولاذ... وهو يقتل الشّرّير بالطّبع

211
00:12:28,390 --> 00:12:29,060
!مهلاً

212
00:12:30,350 --> 00:12:31,560
!كيوتا-كُن

213
00:12:31,560 --> 00:12:33,520
!تماسك يا ناروهودو-كُن

214
00:12:33,520 --> 00:12:35,150
!كفّي عن دفعي! اسحبيني

215
00:12:35,150 --> 00:12:36,650
!اسحبيني يا مايوي-تشان

216
00:12:42,190 --> 00:12:45,740
كان هنالك أشخاص آخرون
.في الاستوديو يوم ارتكاب الجريمة

217
00:12:45,740 --> 00:12:47,820
.لكن ما كانوا ليستطيعوا ارتكابها

218
00:12:48,620 --> 00:12:50,030
...نفدت منّي الأفكار

219
00:12:51,700 --> 00:12:53,910
!ناروهودو-كُن

220
00:12:53,910 --> 00:12:56,120
!هيّا، لنشاهد هذه معًا

221
00:12:56,620 --> 00:12:58,750
.آسف، لكن ليس لديّ وقت

222
00:12:58,750 --> 00:12:59,960
ماذا تقول؟

223
00:12:59,960 --> 00:13:01,920
.هذه قضيّة ساموراي الفولاذ

224
00:13:02,260 --> 00:13:05,430
.قد يحتوي هذا على تلميح لتغيير مجريات القضيّة

225
00:13:05,880 --> 00:13:07,430
تلميح لتغيير مجريات القضيّة؟

226
00:13:22,030 --> 00:13:24,650
...أنقذني يا ساموراي الفولاذ

227
00:13:28,320 --> 00:13:30,580
.لقد شاهدتُه بالكامل

228
00:13:30,830 --> 00:13:34,660
.على أيّ حال، عليّ أن أتحدّث مع كيوتا-كُن ثانية

229
00:13:45,800 --> 00:13:47,470
...ماذا؟ هذا

230
00:13:47,720 --> 00:13:49,590
!أنا ألتقط الصّور دائمًا

231
00:13:49,590 --> 00:13:51,810
.جميعها بحوزتي. المجموعة المثاليّة

232
00:13:51,810 --> 00:13:54,850
!لم أفوّت ولا واحدة منها

233
00:13:55,270 --> 00:13:57,730
.لقد... لقد رأيتُ كلّ شيء

234
00:13:57,940 --> 00:14:02,480
!ساموراي الفولاذ... وهو يقتل الشّرّير بالطّبع

235
00:14:03,020 --> 00:14:06,400
.إن كان الأمر هكذا، فهذا غريب بالفعل

236
00:14:09,450 --> 00:14:10,870
!فولاذ

237
00:14:11,120 --> 00:14:14,580
"!أقاتل الشّرّ من أجل عدالة أعظم"

238
00:14:14,910 --> 00:14:18,540
"—لقد ألحقتَ بي العار لآخر مرّة يا ساموراي الفولاذ"

239
00:14:18,540 --> 00:14:19,460
!هيّا

240
00:14:19,790 --> 00:14:21,250
.قم بهذا من أعماق قلبك

241
00:14:21,250 --> 00:14:23,210
.هذه هي لحظة قاضي الشّرّ

242
00:14:23,210 --> 00:14:25,090
ماذا كانت الجملة؟

243
00:14:25,090 --> 00:14:26,880
"...إنّ القمر الشّاحب في السّماء"

244
00:14:26,880 --> 00:14:29,050
أنت الشّاحب في السّماء؟

245
00:14:29,050 --> 00:14:32,350
".إنّ القمر الشّاحب في السّماء يتوق لدمائك"

246
00:14:32,350 --> 00:14:33,720
!هذه هي

247
00:14:33,720 --> 00:14:35,560
أفهمت يا ناروهودو-كُن؟

248
00:14:35,560 --> 00:14:37,680
أليس هذا معروفًا للجميع؟

249
00:14:37,930 --> 00:14:40,270
...حسنًا، سأحفظها

250
00:14:40,270 --> 00:14:43,190
هلا أخبرتني عن هذه يا كيوتا-كُن؟

251
00:14:43,820 --> 00:14:48,190
رأيتَ ساموراي الفولاذ يقتل الشّرّير، صحيح؟

252
00:14:48,190 --> 00:14:49,950
أين هي الصّورة الّتي التقطتها أثناء ذلك؟

253
00:14:51,110 --> 00:14:54,700
ألم تقل أنّك تلتقط الصّور دائمًا؟
وأنّك لا تفوّت ولا واحدة؟

254
00:14:54,990 --> 00:14:58,750
.لكن ولا صورة من هذه التُقطت ذلك اليوم

255
00:14:59,660 --> 00:15:00,750
.لقد حذفتُها

256
00:15:01,170 --> 00:15:03,330
ماذا؟ حذفتَها؟

257
00:15:03,330 --> 00:15:05,750
لكنّك تكبّدت كلّ ذلك العناء، لماذا؟

258
00:15:05,750 --> 00:15:06,460
...أنا

259
00:15:06,880 --> 00:15:08,210
...حـ-حسنًا

260
00:15:08,460 --> 00:15:10,680
!عناء؟ ألا أستطيع أن أفعل بها ما يحلو لي؟

261
00:15:11,220 --> 00:15:13,050
.عرفتُ أنّ الأمر غريب

262
00:15:13,050 --> 00:15:15,010
...أخبرني يا كيوتا-كُن

263
00:15:15,010 --> 00:15:18,270
!أخبرنا المزيد عمّا حدث مع ساموراي الفولاذ حينها

264
00:15:18,270 --> 00:15:20,310
!أ... أكيد

265
00:15:20,310 --> 00:15:22,350
.أتذكّر ذلك بكلّ وضوح

266
00:15:22,350 --> 00:15:25,060
!لا بدّ أنّ رؤية ساموراي الفولاذ مباشرة كانت رائعة

267
00:15:25,060 --> 00:15:27,900
.لقد ناديتُه في الواقع

268
00:15:27,900 --> 00:15:32,860
!بدا متفاجئًا، لكنّه وقف لأصوّره

269
00:15:32,860 --> 00:15:35,160
ماذا؟ وقف ساموراي الفولاذ بشحمه ولحمه لتصوّره؟

270
00:15:35,160 --> 00:15:36,910
ما الوقفة الّتي اتّخذها؟

271
00:15:37,290 --> 00:15:39,160
.وقف هكذا

272
00:15:42,290 --> 00:15:44,040
...رائع جدًّا

273
00:15:44,040 --> 00:15:44,830
!مهلاً

274
00:15:45,250 --> 00:15:49,710
كيوتا-كُن، أتستطيع القيام بتلك الوقفة ثانية؟

275
00:15:49,710 --> 00:15:52,430
.ماذا؟ وقف هكذا

276
00:15:52,430 --> 00:15:53,720
.عرفتُ هذا

277
00:15:53,720 --> 00:15:55,510
.لم يكن ذاك هو ساموراي الفولاذ

278
00:15:55,510 --> 00:15:57,260
.هذه وقفة قاضي الشّرّ

279
00:15:59,560 --> 00:16:02,020
.ماذا؟ مـ-معك حقّ

280
00:16:02,440 --> 00:16:06,940
...وجدتُ الأمر غريبًا أنا أيضًا

281
00:16:10,190 --> 00:16:11,400
.فهمت

282
00:16:11,860 --> 00:16:13,570
ما الأمر يا ناروهودو-كُن؟

283
00:16:14,450 --> 00:16:15,620
.هذا لا يُعقل

284
00:16:15,620 --> 00:16:17,910
.لكن لا أستطيع التّفكير بأيّ احتمال آخر

285
00:16:18,370 --> 00:16:19,290
،كيوتا-كُن

286
00:16:19,290 --> 00:16:23,040
.أعرف لماذا حذفتَ تلك الصّور الّتي التقطتها ذلك اليوم

287
00:16:24,210 --> 00:16:28,750
.قلتَ أنّك رأيتَ ساموراي الفولاذ يقتل الشّرّير

288
00:16:28,750 --> 00:16:31,130
.لكنّك في الواقع رأيت العكس

289
00:16:32,840 --> 00:16:34,260
ما الّذي تقصده؟

290
00:16:34,260 --> 00:16:37,890
.الشّرّير هزم ساموراي الفولاذ

291
00:16:39,600 --> 00:16:41,350
.لقد هُزم ساموراي الفولاذ

292
00:16:41,350 --> 00:16:43,390
.لهذا السّبب حذفت الصّور

293
00:16:49,150 --> 00:16:52,280
لكنّ ساموراي الفولاذ هُزم؟

294
00:16:52,280 --> 00:16:53,360
.هذا ليس مقصدي

295
00:16:54,360 --> 00:16:56,990
الشّخص الّذي كان يرتدي زيّ ساموراي الفولاذ حينها

296
00:16:56,990 --> 00:17:00,030
.كان قاضي الشّرّ إيبوكورو-سان

297
00:17:03,330 --> 00:17:07,960
سرق إيبوكورو-سان زيّ ساموراي الفولاذ
،عندما كان نيبوشي-سان نائمًا

298
00:17:07,960 --> 00:17:10,460
.وبعدها عبر البوّابة في طريقه للاستوديو

299
00:17:11,000 --> 00:17:14,130
،كان يعرف بالطّبع بأمر إصابة نيبوشي-سان

300
00:17:14,130 --> 00:17:16,430
.لذلك كان قادرًا على أن يتظاهر أنّه هو

301
00:17:17,010 --> 00:17:20,140
،عندما ناداه كيوتا-كُن

302
00:17:20,140 --> 00:17:22,390
.قام بالوقوف ليصوّره لأنّه تفاجأ

303
00:17:22,390 --> 00:17:25,440
.لكنّه قام بوفقة قاضي الشّرّ لأنّه اعتاد عليها

304
00:17:26,730 --> 00:17:29,110
.وبعدها حدث الأمر

305
00:17:29,730 --> 00:17:33,900
قتل الشّرّير إيبوكورو-سان الّذي كان
.يرتدي زيّ ساموراي الفولاذ

306
00:17:35,610 --> 00:17:38,030
رأيتَ ما حدث، صحيح؟

307
00:17:38,030 --> 00:17:40,370
.رأيتَ بطلك المحبوب يُهزم

308
00:17:41,160 --> 00:17:43,950
.لهذا السّبب حذفتَ الصّور وكذبت

309
00:17:44,370 --> 00:17:45,120
هل أنا مخطئ؟

310
00:17:45,120 --> 00:17:47,710
ما-ما الّذي تقوله؟

311
00:17:47,710 --> 00:17:51,040
...لا يُهزم ساموراي الفولاذ أبدًا

312
00:17:51,040 --> 00:17:53,460
!لا يُهزم أمام أحد! أبدًا

313
00:17:53,460 --> 00:17:54,050
...كيوتا-كُن

314
00:17:56,010 --> 00:17:58,680
لماذا تعتقد أنّ ساموراي الفولاذ لا يُهزم أبدًا؟

315
00:17:58,680 --> 00:18:01,390
.هذا لأنّه قويّ بالطّبع

316
00:18:01,390 --> 00:18:02,600
.كلاّ، أنت مخطئ

317
00:18:03,560 --> 00:18:06,480
أخبرني ما هي جملتُه الشّهيرة؟

318
00:18:08,310 --> 00:18:10,900
".أقاتل الشّرّ من أجل عدالة أعظم"

319
00:18:11,190 --> 00:18:12,070
.بالضّبط

320
00:18:12,070 --> 00:18:13,900
.إنّه لا يفوز لأنّه قويّ

321
00:18:13,900 --> 00:18:15,150
.بل يفوز لأنّه على صواب

322
00:18:17,240 --> 00:18:20,740
.إنّه يخاطر بحياته ليقاتل من أجل ما هو صائب

323
00:18:20,740 --> 00:18:22,910
.هذا هو أسلوب حياة ساموراي الفولاذ

324
00:18:23,490 --> 00:18:27,160
لذلك لا تستطيع أن تغضّ نظرك عمّا
!هو صواب أيضًا بصفتك واحدًا من معجبيه

325
00:18:34,300 --> 00:18:35,840
.معك حقّ

326
00:18:35,840 --> 00:18:37,920
...في ذلك اليوم

327
00:18:40,130 --> 00:18:43,720
.تبعتُ ساموراي الفولاذ سرًّا بعد أن وقف لأصوّره

328
00:18:43,720 --> 00:18:45,640
.ورأيتُ بعض الأشرار بعد ذلك

329
00:18:47,140 --> 00:18:49,350
.لقد أطاحوا بساموراي الفولاذ

330
00:18:50,140 --> 00:18:52,480
...و-وتوقّف عن الحركة

331
00:18:55,900 --> 00:18:57,490
.شكرًا لإخبارنا بهذا

332
00:18:58,530 --> 00:19:01,280
إذًا فالصّور قد ضاعت الآن، صحيح؟

333
00:19:02,820 --> 00:19:04,280
.ما زالت هنالك واحدة

334
00:19:05,200 --> 00:19:08,200
.هنالك صورة لم أحذفها هنا

335
00:19:08,580 --> 00:19:09,750
فعلاً؟

336
00:19:09,750 --> 00:19:11,370
.نعم، هذه هي

337
00:19:16,460 --> 00:19:18,090
ما-ما هذا؟

338
00:19:20,170 --> 00:19:22,550
..."ما هو صائب"

339
00:19:38,530 --> 00:19:39,900
ألا تدري متى تستسلم؟

340
00:19:39,900 --> 00:19:40,820
ماذا تريد الآن؟

341
00:19:41,450 --> 00:19:43,820
.هذه صورة التُقطت يوم الجريمة

342
00:19:44,620 --> 00:19:48,580
أتى إيبوروكو-سان إلى هنا
.وهو يرتدي زيّ ساموراي الفولاذ

343
00:19:50,500 --> 00:19:54,000
،نعم، قُتل إيبوكورو-سان هنا

344
00:19:54,000 --> 00:19:55,840
!في الاستوديو 2

345
00:19:56,540 --> 00:20:01,130
هذا يعني أنّه كان بإمكانكم جميعًا
.أن تقتلوه يا هيميغامي-سان

346
00:20:01,720 --> 00:20:05,930
ماذا؟ أتقول أنّه أتى إلى هنا ليموت؟

347
00:20:05,930 --> 00:20:08,140
...حـ-حسنًا

348
00:20:10,850 --> 00:20:13,100
ما الغرض من هذا؟

349
00:20:13,520 --> 00:20:19,780
،استمرّ في قول تلك الحماقات
...وستفوّت على نفسك محاكمة الغد

350
00:20:20,070 --> 00:20:22,200
...نا-ناروهودو-كُن

351
00:20:22,200 --> 00:20:24,450
!انتظروا لحظة

352
00:20:24,660 --> 00:20:26,410
المحقّق إيتونوكو؟

353
00:20:26,410 --> 00:20:27,700
،هيميغامي ساكورا

354
00:20:27,700 --> 00:20:31,200
...أتيتُ لأسلّمك اسستدعاءً لحضور محاكمة الغد

355
00:20:31,620 --> 00:20:33,870
لكن ما الّذي يحدث هنا؟

356
00:20:34,080 --> 00:20:35,080
...لا تسألني أنا

357
00:20:35,080 --> 00:20:37,880
.سَل الفتى الواقف هناك
.هو من اقتحم المكان وبدأ هذا

358
00:20:39,090 --> 00:20:40,210
الفتى؟

359
00:20:40,880 --> 00:20:43,800
،اسمع... لا يهمّ أين وقعت الجريمة

360
00:20:43,800 --> 00:20:46,720
.ما كنتُ أنا على وجه الخصوص أن أرتكبها

361
00:20:46,930 --> 00:20:48,720
لـ-لماذا؟

362
00:20:49,390 --> 00:20:52,520
.قُتل إيبوروكو باستعمال رمح السّاموراي

363
00:20:52,520 --> 00:20:57,730
من سيصدّق أنّ امرأة رقيقة مثلي
استعملت ذلك الرّمح الثّقيل كسلاح؟

364
00:20:58,980 --> 00:21:00,520
...صحيح

365
00:21:00,520 --> 00:21:03,280
.يزن سلاح الجريمة خمسة عشر كيلوغرامًا

366
00:21:03,280 --> 00:21:04,820
.إنّه ثقيل للغاية

367
00:21:05,240 --> 00:21:09,120
.كما أنّ إيبوروكو هو نجم كان يذرّ عليّ الكثير من المال

368
00:21:09,120 --> 00:21:11,240
فلماذا أرغب بقتله إذًا؟

369
00:21:11,490 --> 00:21:13,450
...هـ-هذا

370
00:21:14,790 --> 00:21:17,040
،إذا كنتَ تريد اتّهام شخص ما بالجريمة

371
00:21:17,040 --> 00:21:18,880
.تحلّ على الأقلّ بالاحترام لتقديم دليل

372
00:21:25,470 --> 00:21:28,430
لا يمكن غضّ النّظر عن الأمر بصفته أحد معجبيه"؟"

373
00:21:29,260 --> 00:21:30,680
...إيبوروكو-تشان

374
00:21:33,640 --> 00:21:36,520
هل من شيء آخر أيّها المحامي؟

375
00:21:39,360 --> 00:21:43,440
.سأراك في المحاكمة غدًا يا هيميغامي-سان

376
00:23:20,540 --> 00:23:21,620
!اعتراض

377
00:23:21,620 --> 00:23:26,130
.يستمرّ الجاني الحقيقيّ في الابتسام حتّى في المحكمة

378
00:23:26,130 --> 00:23:29,470
.تتحدّث بكلّ ثقة وشجاعة وجرأة

379
00:23:29,470 --> 00:23:32,010
أأستطيع محو تلك الابتسامة عن محيّاها؟

380
00:23:32,010 --> 00:23:34,180
ما كان سلاح الجريمة الحقيقيّ؟

381
00:23:34,180 --> 00:23:37,180
ولماذا حدثت الجريمة؟

382
00:23:37,180 --> 00:23:39,390
هل كانت جريمة متعمّدة بالفعل؟

383
00:23:39,390 --> 00:23:42,520
.تصل قضيّة ساموراي الفولاذ لنهايتها الفظيعة

384
00:23:42,520 --> 00:23:43,560
!سأعثر على المتناقضات

385
00:23:43,560 --> 00:23:44,810
!وأكتشف الحقيقة

386
00:23:44,810 --> 00:23:48,070
!في الحلقة القادمة: تغيّر السّاموراي — المحاكمة الأخيرة

387
00:23:48,070 --> 00:23:48,780
!خذ هذه