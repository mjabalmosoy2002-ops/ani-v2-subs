1
00:00:00,930 --> 00:00:02,320
!هنالك مشكلة يا حضرة القاضي

2
00:00:02,310 --> 00:00:04,810
!لقد اختفى الشّاهد الّذي شهد للتّوّ

3
00:00:04,810 --> 00:00:05,850
!ماذا؟

4
00:00:05,850 --> 00:00:07,900
!يبدو أنّه قد هرب

5
00:00:08,770 --> 00:00:12,030
.لا أستطيع النّطق بحكم تحت هذه الظّروف

6
00:00:12,570 --> 00:00:15,950
.بالتّالي، سأقوم بتأجيل المحاكمة للغد

7
00:00:15,950 --> 00:00:17,490
!رُفعت الجلسة

8
00:01:56,260 --> 00:02:02,260
لماذا قام ذلك العجوز بتوريط
المدّعي العامّ ميتسوروغي؟

9
00:02:02,930 --> 00:02:06,890
لا أدري، لكنّي واثق أنّ للأمر
.علاقة ما بحادثة دي-إل-6

10
00:02:06,890 --> 00:02:10,150
لكن ألم يكن المدّعي العامّ ميتسوروغي
ضحية في تلك الحادثة أيضًا؟

11
00:02:10,150 --> 00:02:11,900
.لقد قُتل والده

12
00:02:12,710 --> 00:02:16,360
.لقد عانى لأزيد من خمسة عشر عامًا

13
00:02:17,080 --> 00:02:18,320
.أريد مساعدته بطريقة ما

14
00:02:18,860 --> 00:02:21,450
.أنت لطيف للغاية يا ناروهودو-كُن

15
00:02:22,310 --> 00:02:25,160
،إنّه صديق لم تقابله منذ سنوات

16
00:02:25,160 --> 00:02:27,750
.ومع ذلك أنت عازم على مساعدته لهذه الدّرجة

17
00:02:29,600 --> 00:02:30,950
.هنالك سبب وجيه لذلك

18
00:02:31,780 --> 00:02:33,790
،في صيف سنتنا الرّابعة

19
00:02:33,790 --> 00:02:35,940
.أصبح فصلنا ساحة جريمة

20
00:02:38,010 --> 00:02:40,430
أنت السّارق، صحيح؟

21
00:02:38,420 --> 00:02:42,140
.سُرق مال غداء أحد التّلاميذ خلال فصل التّربية البدنيّة

22
00:02:40,430 --> 00:02:42,140
!لصّ! لصّ

23
00:02:42,340 --> 00:02:44,720
.والآن، اعتذر للفصل

24
00:02:45,060 --> 00:02:47,140
أصبحتُ مشتبهًا به لأنّي لم أحضر
.فصل التّربية البدنيّة

25
00:02:48,640 --> 00:02:52,480
،تعلّمتُ ما يعنيه أن أكون وحيدًا بالفعل
.دون وجود أيّ أحد إلى جانبي

26
00:02:52,480 --> 00:02:53,520
.وكم كان ذلك مؤلمًا

27
00:02:54,650 --> 00:02:57,650
.لم يكن أمامي خيار آخر، فاعتذرت لشيء لم أفعله

28
00:02:58,150 --> 00:02:59,190
...لكن حينها

29
00:02:59,190 --> 00:03:00,360
!أعترض

30
00:03:01,860 --> 00:03:03,570
!لن يكون ذلك ضروريًّا

31
00:03:04,120 --> 00:03:05,530
ميتسوروغي-كُن؟

32
00:03:05,530 --> 00:03:09,410
لم تكن أنت من سرق مالي، صحيح؟

33
00:03:10,710 --> 00:03:11,330
...لا

34
00:03:14,670 --> 00:03:18,920
،يقول الجميع أنّك السّارق
.لكن لم يقدّم أحد أيّ دليل

35
00:03:18,920 --> 00:03:20,050
ما الّذي تقوله؟

36
00:03:20,050 --> 00:03:22,630
!فمالك أنت الّذي سُرق

37
00:03:22,630 --> 00:03:24,470
!لا نحتاج لدليل

38
00:03:25,050 --> 00:03:27,760
.في ساحة المحكمة، يطلعنا الدّليل على كلّ شيء

39
00:03:28,430 --> 00:03:32,640
اعلموا هذا على الأقلّ قبل أن تكون لديكم
!نوايا بفتح جلسة محاكمة في الفصل

40
00:03:34,310 --> 00:03:35,690
!صحيح، صحيح

41
00:03:36,020 --> 00:03:39,780
الوضع هكذا طوال الوقت، يتّحد
.الجميع ويضايقون شخصًا واحدًا

42
00:03:39,780 --> 00:03:41,650
ألستم تخجلون من أنفسكم؟

43
00:03:42,150 --> 00:03:43,450
...ياهاري-كُن

44
00:03:44,110 --> 00:03:47,580
،طالما لا يوجد دليل أو شهادة شاهد تثبت إدانته

45
00:03:47,870 --> 00:03:49,370
!فهذا الفتى بريء

46
00:03:49,950 --> 00:03:51,040
.هذا ما لديّ

47
00:03:51,620 --> 00:03:54,120
.انتهت هذه المحاكمة. رُفعت الجلسة

48
00:03:54,120 --> 00:03:57,460
!ارحلوا! رُفعت الجلسة

49
00:03:58,170 --> 00:04:02,300
.بعد ذلك، أصبح ثلاثتنا أصدقاءً

50
00:04:03,260 --> 00:04:07,930
لا زلت لا أستطيع نسيان دفاعه
.الحماسيّ عنّي ذلك اليوم

51
00:04:08,510 --> 00:04:10,890
دفاع؟

52
00:04:11,680 --> 00:04:12,810
،بالتّفكير بالأمر

53
00:04:12,810 --> 00:04:16,900
والد المدّعي العامّ ميتسوروغي
كان محامي دفاع موهوب، صحيح؟

54
00:04:17,190 --> 00:04:18,070
.نعم

55
00:04:18,070 --> 00:04:19,570
،كان يقول دائمًا

56
00:04:20,780 --> 00:04:24,490
"!سأصبح محامي دفاع كوالدي تمامًا"

57
00:04:25,110 --> 00:04:26,160
.وكانت عيناه تلمعان

58
00:04:27,160 --> 00:04:29,330
لهذا السّبب تفاجأت كثيرًا

59
00:04:30,040 --> 00:04:33,000
.عندما سمعنا أنّ والده قد مات

60
00:04:33,750 --> 00:04:36,420
...حادثة دي-إل-6

61
00:04:36,420 --> 00:04:39,720
.لم نفهم بشكل جيّد الأمر حينها

62
00:04:39,720 --> 00:04:42,300
،لقد بعد الحادثة بوقت قليل

63
00:04:42,800 --> 00:04:44,690
.انتقل ميتسوروغي بعيدًا

64
00:04:48,850 --> 00:04:53,930
.أنا أؤمن أنّ الصّداقة لا تتلاشى أبدًا، حتّى إن افترقنا

65
00:04:55,270 --> 00:04:56,850
ساموراي الإشارة؟

66
00:04:57,420 --> 00:05:03,030
كانت قد مرّت سنوات عديدة
.عندما رأيتُ اسمه ثانية

67
00:05:03,360 --> 00:05:05,990
"شبهات مظلمة تحيط بالمدّعي العامّ العبقريّ؟"

68
00:05:06,360 --> 00:05:10,580
"...الحقيقة خلف سجلّ مثاليّ"

69
00:05:11,230 --> 00:05:12,770
.لقد تغيّر

70
00:05:13,550 --> 00:05:15,370
...حاولت الاتّصال به مرّات عديدة

71
00:05:15,890 --> 00:05:18,790
.لكنّه رفض مقابلتي

72
00:05:19,500 --> 00:05:23,050
.لذلك قرّرتُ أن أدخل مجاله

73
00:05:23,550 --> 00:05:24,380
.في المحكمة

74
00:05:25,420 --> 00:05:28,430
.أنا أؤمن بميتسوروغي الّذي آمن بي

75
00:05:29,220 --> 00:05:31,680
.وأنا محامي دفاع الآن

76
00:05:32,260 --> 00:05:35,850
.لذلك أريد أن أقاتل من أجله حتّى النّهاية

77
00:05:35,850 --> 00:05:37,270
...ناروهودو-كُن

78
00:05:39,060 --> 00:05:39,940
.مرحبًا

79
00:05:41,520 --> 00:05:42,480
!عثرتَ عليه؟

80
00:05:42,820 --> 00:05:45,900
.أمسكناه وهو يحاول الهرب

81
00:05:46,320 --> 00:05:49,240
.سوف نفتّش كوخ تأجير القوارب الآن

82
00:05:49,240 --> 00:05:51,160
أتريدان أن تأتيا؟

83
00:05:52,870 --> 00:05:54,620
،حسب استنتاجنا

84
00:05:54,620 --> 00:05:59,500
لم يتمّ إطلاق النّار على الضّحيّة
.في القارب تلك اللّيلة

85
00:05:59,500 --> 00:06:04,800
.أعتقد أنّ هذا الكوخ هو ساحة الجريمة الحقيقيّة

86
00:06:12,010 --> 00:06:15,470
،عند التّفكير أنّ جريمة وقعت هنا
!يصبح المكان مخيفًا للغاية

87
00:06:15,470 --> 00:06:17,560
.صباح الخير. صباح الخير

88
00:06:19,100 --> 00:06:20,230
.إنّه ذلك الطّائر فحسب

89
00:06:20,730 --> 00:06:22,190
!سايُري-سان

90
00:06:22,520 --> 00:06:26,990
.كان هذا الببّغاء برفقة العجوز عندما اعتقلناه

91
00:06:26,990 --> 00:06:29,400
.أتخيّل أنّ ذلك كان ليكون واضحًا وضوح الشّمس

92
00:06:29,400 --> 00:06:31,200
.لهذا السّبب تمكّنّا من الإمساك به

93
00:06:31,200 --> 00:06:33,030
.أخبريني يا سايُري-سان

94
00:06:33,030 --> 00:06:37,410
!هل تعرفين من هو العجوز في الحقيقة؟ أخبرينا

95
00:06:37,410 --> 00:06:40,420
.سايُري... أنا أحبّك

96
00:06:46,630 --> 00:06:49,670
.لا توجد أيّ أدلّة هنا على الإطلاق

97
00:06:50,340 --> 00:06:53,550
الشّيء الوحيد المتبقّي هو حرارة
.هذه الطّاولة المسخِّنة

98
00:06:53,540 --> 00:06:56,060
إنّها تبعث بالدّفء، صحيح؟

99
00:06:56,690 --> 00:07:00,110
،نحن في كوخ قريب من بحيرة
.مع ذلك فهذه أسماك مياه مالحة

100
00:07:00,110 --> 00:07:01,790
.ربّما يكون هذا طرف خيط

101
00:07:01,790 --> 00:07:04,190
.سأقوم بالتّبليغ عن هذا كاحتياط

102
00:07:04,450 --> 00:07:08,690
.الشّيء الآخر الّذي يثير الفضول هو هذه الخزنة

103
00:07:08,940 --> 00:07:11,160
!نعم، هذا واضح

104
00:07:14,140 --> 00:07:17,800
.إنّها مقفلة ونحتاج لأربعة أرقام بفتحها

105
00:07:17,800 --> 00:07:20,030
!أنا أعرفها

106
00:07:20,030 --> 00:07:21,710
ماذا؟ تعرفينها؟

107
00:07:21,990 --> 00:07:23,690
.أخبريني يا سايُري-سان

108
00:07:23,690 --> 00:07:25,810
ما هي أرقام الخزنة؟

109
00:07:25,810 --> 00:07:27,400
...أرقام الخزنة

110
00:07:27,400 --> 00:07:30,420
.1228 .1228

111
00:07:30,770 --> 00:07:32,320
أهذا معقول؟

112
00:07:32,320 --> 00:07:33,430
.معقول تمامًا

113
00:07:39,810 --> 00:07:41,180
!هنالك شيء بداخلها

114
00:07:41,190 --> 00:07:42,960
.رسالة

115
00:07:42,940 --> 00:07:46,230
.لا يوجد اسم المرسِل عليها

116
00:07:48,400 --> 00:07:51,240
".انتقم من ميتسوروغي ريجي"

117
00:07:52,780 --> 00:07:55,320
".انتقم من ميتسوروغي ريجي"

118
00:07:55,320 --> 00:07:57,450
".هذه هي فرصتك الأخيرة"

119
00:07:57,660 --> 00:08:04,120
هذا هو الوقت المناسب لتحقّق انتقامك"
"!من الرّجلين اللّذين أفسدا حياتك

120
00:08:04,120 --> 00:08:05,830
!كلّ شيء موصوف هنا بالتّفاصيل

121
00:08:05,830 --> 00:08:10,550
!الخطّة لقتل ناماكورا وتوريط ميتسوروغي بها

122
00:08:11,340 --> 00:08:12,670
ما معنى هذا؟

123
00:08:12,920 --> 00:08:16,140
باختصار، كان هنالك عقل مدبّر يدير
!كلّ شيء من وراء ظهورنا

124
00:08:16,510 --> 00:08:20,220
سأحاول وأعثر على كلّ شيء
!عن ماضي ذلك العجوز

125
00:08:20,520 --> 00:08:23,690
مَن يكون يا ترى قد أرسل رسالة كهذه؟

126
00:08:24,140 --> 00:08:26,900
!أيعقل أن يكون هذا متعلّقًا بالحادثة أيضًا؟

127
00:08:31,210 --> 00:08:32,380
!هوشيكاغي-سينسي

128
00:08:33,300 --> 00:08:34,470
...أنت

129
00:08:34,470 --> 00:08:35,950
ناروهودو-كُن؟

130
00:08:36,640 --> 00:08:38,370
.لديّ طلب لأطلبه منك

131
00:08:41,100 --> 00:08:43,540
.يبدو أنّ الوقت قد حان أخيرًا

132
00:08:47,180 --> 00:08:49,790
!أخرجني من هنا

133
00:08:49,790 --> 00:08:50,960
.اهدأ

134
00:08:51,420 --> 00:08:53,240
!لا أستطيع التّنفّس

135
00:08:53,240 --> 00:08:55,890
...الهواء... لا يوجد هواء

136
00:08:56,350 --> 00:08:59,120
!أنت! كفّ عن التّنفّس

137
00:08:59,100 --> 00:09:00,350
.قلت لك أن تهدأ

138
00:09:00,930 --> 00:09:04,180
!كفّ عن تنفّس هوائي

139
00:09:04,180 --> 00:09:04,850
!توقّف

140
00:09:05,190 --> 00:09:06,310
...كلاّ

141
00:09:06,850 --> 00:09:09,650
!دع أبي وشأنه

142
00:09:09,650 --> 00:09:12,110
!مُت

143
00:09:28,460 --> 00:09:31,800
.افتُتحت جلسة محاكمة ميتسوروغي ريجي الآن

144
00:09:32,420 --> 00:09:35,550
.قدّم شهادتك الافتتاحيّة أيّها المدّعي العامّ كاروما

145
00:09:35,550 --> 00:09:37,630
،في محاكمة البارحة

146
00:09:37,630 --> 00:09:41,760
وجّه الدّفاع أصابع الاتّهام إلى القائم
.على كوخ تأجير القوارب

147
00:09:41,760 --> 00:09:44,100
.لكنّه ينكر اقترافه لأيّ جرم

148
00:09:44,100 --> 00:09:50,060
.لذلك استدعيتُه للشّهادة ثانية لتبرئة ساحته

149
00:09:50,440 --> 00:09:51,570
.حسنًا

150
00:09:51,570 --> 00:09:53,820
.قدّم شهادتك رجاءً

151
00:09:55,780 --> 00:09:59,700
.أنا جدّ آسف على مغادرتي البارحة دون إذن

152
00:10:00,160 --> 00:10:04,620
...لقد ذهبتُ لشراء بعض الطّعام لسايُري-سان

153
00:10:04,620 --> 00:10:06,660
سايُري-سان؟

154
00:10:06,660 --> 00:10:08,710
...شريكتي نوعًا ما

155
00:10:09,710 --> 00:10:10,710
.إنّها طائر ببّغاء

156
00:10:11,000 --> 00:10:12,590
ذهب لشراء طعام لببّغائه؟

157
00:10:12,590 --> 00:10:15,840
.لم يكن يحاول الهرب أو ما شابه

158
00:10:15,840 --> 00:10:17,470
.هذه هي الحقيقة

159
00:10:17,470 --> 00:10:18,760
.فهمت

160
00:10:19,260 --> 00:10:20,550
.استجوب الشّاهد أيّها الدّفاع

161
00:10:21,640 --> 00:10:25,430
.ادّعيتَ البارحة أنّك فقدت ذكرياتك

162
00:10:26,100 --> 00:10:27,600
أهذا صحيح؟

163
00:10:27,600 --> 00:10:31,100
لماذا هذا الوجه المخيف يا يوكيهيرو؟

164
00:10:31,100 --> 00:10:32,860
.أنت تجعل والدك حزينًا للغاية

165
00:10:33,320 --> 00:10:36,650
،إذا اعتبرنا أنّك قتلت ناماكورا

166
00:10:36,860 --> 00:10:39,700
!فعليك تذكّر ارتكابك للجريمة

167
00:10:39,700 --> 00:10:40,860
!أعترض

168
00:10:41,450 --> 00:10:43,530
!هذا اتّهام لا أساس له

169
00:10:43,530 --> 00:10:48,750
.ما كنتُ حتّى لأحلم بارتكاب جريمة شنيعة، أجل

170
00:10:49,000 --> 00:10:52,580
،إذا قلتَ أنّ الشّاهد يتذكّر ماضيه بالفعل

171
00:10:52,580 --> 00:10:54,840
.أرنا دليلاً ما يثبت ذلك

172
00:10:54,840 --> 00:10:56,380
.هذا ما ننتظره

173
00:10:56,380 --> 00:10:58,760
.أعطني ذلك يا مايوي-تشان

174
00:10:58,760 --> 00:10:59,340
.أكيد

175
00:10:59,920 --> 00:11:01,510
!إليك الدّليل

176
00:11:04,220 --> 00:11:07,930
!هذه رسالة عُثر عليها في الخزنة الّتي في غرفته

177
00:11:09,310 --> 00:11:12,400
".انتقم من ميتسوروغي ريجي"

178
00:11:12,400 --> 00:11:14,190
ما-ما هذه؟

179
00:11:14,650 --> 00:11:20,280
تضمّ خذه الرّسالة تعليمات مفصّلة
.لكيفية تنفيذ ذلك الانتقام

180
00:11:20,280 --> 00:11:21,360
.يا إلهي

181
00:11:21,360 --> 00:11:26,370
إنّها تضمّ العمليّة الّتي شرحها
.الدّفاع البارحة بالتّفصيل

182
00:11:26,870 --> 00:11:29,110
لقد أنجز الشّاهد هذه الخطّة

183
00:11:29,110 --> 00:11:31,650
.وحاول تلفيق الجريمة لموكّلي

184
00:11:32,160 --> 00:11:35,920
.هذا يعني أنّ لديه أسبابًا ليسعى للانتقام

185
00:11:36,760 --> 00:11:41,290
