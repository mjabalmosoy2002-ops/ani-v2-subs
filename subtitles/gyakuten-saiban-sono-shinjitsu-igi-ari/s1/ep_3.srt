1
00:00:01,850 --> 00:00:05,270
.كانت تشيهيرو-سان إلى حانبي في آخر مرّة

2
00:00:06,150 --> 00:00:10,610
!لكن اليوم، عليّ أن أقاتل وحدي لإنقاذ مايوي-تشان

3
00:00:12,860 --> 00:00:13,900
!اعتراض

4
00:02:01,140 --> 00:02:03,390
،سوف أواجه ميتسوروغي ريجي المشهور

5
00:02:03,390 --> 00:02:06,600
...مدّعٍ عامّ عبقريّ لا نظير له

6
00:02:19,780 --> 00:02:23,080
.ستُفتتح جلسة محاكمة أياساتو مايوي الآن

7
00:02:23,280 --> 00:02:25,700
.الادّعاء جاهز يا سيادة القاضي

8
00:02:25,990 --> 00:02:28,330
.الدّفاع جاهز يا سيادة القاضي

9
00:02:29,580 --> 00:02:32,960
أيّها المدّعى العامّ ميتسوروغي، قدّم
.شهادتك الافتتاحيّة للمحكمة لو سمحت

10
00:02:34,590 --> 00:02:35,840
.في الحال يا سيادة القاضي

11
00:02:41,260 --> 00:02:43,390
.الضّحية هي أياساتو تشيهيرو

12
00:02:43,390 --> 00:02:45,310
.والمشتبه بها هي أياساتو مايوي

13
00:02:45,310 --> 00:02:47,100
.إنّهما أختان

14
00:02:47,100 --> 00:02:50,560
يملك الادّعاء دليلاً يثبت ارتكاب
،المدّعى عليها لجريمة القتل

15
00:02:50,560 --> 00:02:52,860
.ولدينا شاهدة رأتها تقوم بذلك

16
00:02:52,860 --> 00:02:55,940
لا يجد الادّعاء أيّ عذر للشّكّ
.في إدانتها يا سعادة القاضي

17
00:02:56,650 --> 00:02:59,360
بالتّالي، لنطلب من الشّاهد الأوّل
.أن يتقدّم لمنصّة الشّهود

18
00:03:00,320 --> 00:03:02,740
.أيّها الشّاهد، أطلعنا على اسمك ومهنتك

19
00:03:02,740 --> 00:03:05,780
.حاضر! اسمي إتونوكوغيري كِيْسكي

20
00:03:05,780 --> 00:03:09,120
!أنا المحقّق المسؤول عن جرائم القتل في قسم الشّرطة

21
00:03:09,450 --> 00:03:11,830
،أيّها المحقّق، أظنّك على اطّلاع بهذا الأمر سلفًا

22
00:03:11,830 --> 00:03:14,330
لكن سأطلب منك أن تقدّم شهادة
.مختصرة وفي صلب الموضوع

23
00:03:14,330 --> 00:03:17,170
!حا-حا-حاضر

24
00:03:20,260 --> 00:03:22,890
.أوّلاً، صف لنا تفاصيل هذه الجريمة

25
00:03:22,890 --> 00:03:25,550
حسنًا، سوف أشرح بالاستعانة
.بمخطّط الطّابق هذا للمكتب

26
00:03:27,600 --> 00:03:30,680
.تمّ العثور على الجثّة قرب هذه النّافذة هنا

27
00:03:30,680 --> 00:03:31,560
وسبب الوفاة؟

28
00:03:32,060 --> 00:03:34,440
!ماتت في الحال جرّاء ضربة قويّة بغرضٍ صلب

29
00:03:34,440 --> 00:03:37,610
كان سلاح الجريمة هو تمثال "المفكّر"، صحيح؟

30
00:03:37,610 --> 00:03:40,360
.صحيح. عُثر عليه ملقى على الأرض أمام الجثّة

31
00:03:40,990 --> 00:03:44,910
لقد اعتقلتَ أياساتو مايوي الّتي عثرتَ
.عليها في مسرح الجريمة في الحال

32
00:03:44,910 --> 00:03:46,200
أتستطيع إخبارنا عن السّبب؟

33
00:03:46,200 --> 00:03:48,370
.كان لديّ دليل دامغ لإدانتها

34
00:03:48,870 --> 00:03:52,410
!كتبت الضّحية اسم القاتل قبل أن تموت

35
00:03:52,620 --> 00:03:55,290
!كانت عبارة "مايوي" مكتوبة بوضوح بالدّم

36
00:03:55,290 --> 00:03:56,420
!كما ترون هناك

37
00:03:55,630 --> 00:03:57,710
مايوي

38
00:03:59,920 --> 00:04:03,050
أظهرت نتائج فحوصات المختبر
.أنّ الدّماء المستعملة تعود للضّحيّة

39
00:04:03,050 --> 00:04:05,050
!هذا دليل دامغ

40
00:04:05,340 --> 00:04:09,100
إذًا فقد حدّدت الضّحيّة هويّة قاتلها قبل أن تموت؟

41
00:04:09,100 --> 00:04:10,100
—نعم! هذا بالضّبط ما

42
00:04:10,100 --> 00:04:11,180
!اعتراض

43
00:04:11,770 --> 00:04:13,560
!مهلاً لحظة رجاءً

44
00:04:13,560 --> 00:04:16,860
من المستحيل أن تكون الضّحيّة
!قد استطاعت كتابة تلك الرّسالة

45
00:04:17,270 --> 00:04:19,150
.يجب على المبتدئين أن يلتزموا بالصّمت يا فتى

46
00:04:19,940 --> 00:04:22,440
.هذا تقرير الطّبّ الشّرعيّ من قسمكم أيّها المحقّق

47
00:04:22,440 --> 00:04:25,910
ومذكور هنا أنّ الضّحيّة "ماتت في الحال
."جرّاء ضربة قويّة بغرضٍ صلب

48
00:04:25,910 --> 00:04:26,820
.هذا صحيح

49
00:04:26,820 --> 00:04:30,700
،وبعد أن تسبّب الضّربة بموتها في الحال
—استعملت آخر ما لديها من قوّة لكي

50
00:04:30,700 --> 00:04:34,210
لا يمكنها أن تستعمل لا آخر
!ولا أوّل قوّة لديها! لقد كانت ميتة

51
00:04:34,210 --> 00:04:34,830
ما...؟

52
00:04:36,630 --> 00:04:37,380
...لكن

53
00:04:37,380 --> 00:04:39,460
!لا يوجد ما قد يغيّر ذلك

54
00:04:39,460 --> 00:04:41,880
...هذا... غريب بالتّأكيد

55
00:04:42,970 --> 00:04:46,260
!دليل الادّعاء فيه تناقض

56
00:04:48,800 --> 00:04:50,640
!هذا قد ينفع

57
00:04:53,310 --> 00:04:54,940
ما المضحك في الأمر؟

58
00:04:54,940 --> 00:04:56,400
.يا إلهي

59
00:04:56,400 --> 00:04:57,940
.لن ينفع هذا يا محامي الدّفاع

60
00:04:59,150 --> 00:05:01,400
.تقرير الطّبّ الشّرعي ذاك قديم

61
00:05:01,650 --> 00:05:03,320
ما-ماذا؟

62
00:05:03,320 --> 00:05:07,240
،تمّ إجراء تشريح ثانٍ البارحة
.لذلك تغيّر التّقرير

63
00:05:08,070 --> 00:05:09,530
..."تغيّر مِن "ماتت في الحال

64
00:05:10,330 --> 00:05:11,740
!"إلى "ماتت في الحال تقريبًا

65
00:05:12,120 --> 00:05:13,540
—تـ-تـ

66
00:05:13,540 --> 00:05:16,250
تـ-تـ-تقريبًا؟

67
00:05:16,250 --> 00:05:20,250
.ممّا يعني أنّ الضّحية قد تكون قادرة على كتابة الرّسالة

68
00:05:21,040 --> 00:05:23,760
...فقبل كلّ شيء، إنّها لم تمت في الحال

69
00:05:23,760 --> 00:05:27,470
.بالفعل. على الدّفاع التّمعّن جيّدًا في الدّليل سلفًا

70
00:05:27,760 --> 00:05:29,930
!مـ-مهلاً لحظة رجاءً

71
00:05:29,930 --> 00:05:31,850
!لم أسمع بشأن أيّ تقرير طبّ شرعيّ ثانٍ

72
00:05:32,310 --> 00:05:36,230
.حسنًا، وصلتني هذه النّتائج هذا الصّباح بالفعل

73
00:05:37,060 --> 00:05:39,770
.يبدو أنّه قد حدث خطأ في المعاملات الورقيّة

74
00:05:39,770 --> 00:05:41,730
أليس كذلك أيّها المحقّق إتونوكوغيري؟

75
00:05:41,730 --> 00:05:43,440
...ماذا؟ لكنّي لم

76
00:05:44,150 --> 00:05:48,070
.في كلّ الأحوال، حفر الدّفاع قبره بيده

77
00:05:48,950 --> 00:05:51,950
إنّك لا تتصرّف بشكل منصف
!أيّها المدّعي العامّ ميتسوروغي

78
00:05:52,280 --> 00:05:54,240
.دعني أقدّم لك نصيحة

79
00:05:54,240 --> 00:05:58,420
.الدّليل هو كلّ شيء في قاعة المحكمة
!وبدونه أنت لا شيء أيّها الهاوي

80
00:06:00,290 --> 00:06:02,340
يبدو أنّ نهاية محامي الدّفاع الصّاعد هذا

81
00:06:03,340 --> 00:06:05,380
.أصبحت وشيكة تقريبًا

82
00:06:05,840 --> 00:06:07,470
...لقد كان فخًّا إذًا

83
00:06:09,180 --> 00:06:10,340
...سيّدي المحامي

84
00:06:10,340 --> 00:06:14,770
.يرغب الادّعاء في استدعاء شاهده التّالي

85
00:06:14,770 --> 00:06:18,890
!لقد رأت هذه الآنسة المسكينة البريئة الجريمة بأمّ عينيها

86
00:06:24,570 --> 00:06:26,860
!آسفة لجعلكم تنتظرون

87
00:06:28,990 --> 00:06:30,530
.أطلعينا على اسمك أيّتها الشّاهدة

88
00:06:30,530 --> 00:06:32,820
!شوتشيكو أوميو

89
00:06:32,820 --> 00:06:35,040
!أنا في خدمتكم

90
00:06:36,500 --> 00:06:39,120
.على الشّاهدة أنّ تتوقّف عن الغمز

91
00:06:39,330 --> 00:06:40,080
!حاضرة

92
00:06:40,370 --> 00:06:43,840
.لقد أسرت قلب كلّ رجل في المحكمة سلفًا

93
00:06:44,170 --> 00:06:49,220
أخبري كلّ من في المحكمة عمّا رأيتِه
.ليلة الجريمة في الثّالث من أبريل

94
00:06:49,220 --> 00:06:50,380
.في الحال

95
00:06:52,590 --> 00:06:54,890
...رأيت الأمر كلّه بأمّ عينيّ

96
00:06:54,890 --> 00:06:57,640
.كنتُ أطلّ من النّافذة تلك اللّيلة فحسب

97
00:06:57,640 --> 00:06:59,430
،وبعدها

98
00:06:59,770 --> 00:07:03,230
رأيتُ امرأة بشعر طويل تتعرّض للهجوم
!في البناية المقابلة في الجهة الأخرى للشّارع

99
00:07:03,560 --> 00:07:05,940
ومن هاجمها هي تلك الفتاة ضئيلة الحجم

100
00:07:07,900 --> 00:07:09,690
!الجالسة في كرسيّ المدّعى عليها

101
00:07:09,690 --> 00:07:11,320
!كـ-كلاّ

102
00:07:11,320 --> 00:07:12,030
...أنا لم

103
00:07:12,030 --> 00:07:14,780
أيّتها الشّاهدة، أتتذكّرين الوقت بالضّبط؟

104
00:07:15,030 --> 00:07:16,200
.نعم

105
00:07:16,200 --> 00:07:18,700
.فلقد سمعتُ صوتًا نوعًا ما

106
00:07:19,000 --> 00:07:22,120
...إنّها 8:50، على ما أظنّ

107
00:07:22,960 --> 00:07:24,290
تحدّث سلاح الجريمة؟

108
00:07:24,290 --> 00:07:27,170
.بالفعل. لا يبدو هذا كساعة عند الوهلة الأولى

109
00:07:28,710 --> 00:07:33,050
ما كانت الشّاهدة أن تعرف بهذا لو لم
.ترى ما حدث لحظة الجريمة

110
00:07:33,050 --> 00:07:37,310
.نعم. سوف نعتبر شهادتها صحيحة

111
00:07:38,140 --> 00:07:40,640
بوجود الرّسالة المكتوبة بالدّم الّتي تركتها الضّحيّة

112
00:07:40,640 --> 00:07:43,400
،وشهادة شاهد عيان للجريمة لحظة وقوعها

113
00:07:44,440 --> 00:07:48,070
فإنّ الادّعاء يظنّ أنّ إدانة المدّعى عليها
.قد تمّ إثباتها بشكل دامغ

114
00:07:48,070 --> 00:07:50,440
!أُثبتت بشكل دامغ

115
00:07:50,860 --> 00:07:51,700
ما العمل؟

116
00:07:51,700 --> 00:07:52,490
!مهلاً

117
00:07:54,740 --> 00:07:56,320
!مهلاً لحظة

118
00:07:56,530 --> 00:07:58,200
ما الأمر أيّتها المدّعى عليها؟

119
00:07:58,200 --> 00:08:00,540
—ما كانت تلك السّاعة أن تصدر صوتًا

120
00:08:00,790 --> 00:08:02,790
من قال أنّ بإمكانك التّكلّم أيّتها المدّعى عليها؟

121
00:08:03,290 --> 00:08:05,250
...هـ-هذا صحيح

122
00:08:05,540 --> 00:08:06,630
!اعتراض

123
00:08:07,090 --> 00:08:11,010
تحقّق من الجزء الدّاخليّ لتمثال
!المفكّر" رجاءً يا حضرة القاضي"

124
00:08:11,010 --> 00:08:12,510
الجزء الدّاخليّ؟

125
00:08:15,050 --> 00:08:16,760
...إنّه فارغ

126
00:08:17,140 --> 00:08:20,930
لم يكن هيكل السّاعة داخل السّاعة
—في ليلة الجريمة، لذلك

127
00:08:20,930 --> 00:08:23,060
ما كانت السّاعة لتصدر أيّ صوت، صحيح؟

128
00:08:24,480 --> 00:08:26,310
.إنّها فارغة من الدّاخل

129
00:08:26,310 --> 00:08:28,110
.كان بمقدور أيّ أحد الوصول لذلك الاستنتاج

130
00:08:28,110 --> 00:08:30,360
.حسنًا، أنا لم أستنتج ذلك

131
00:08:30,690 --> 00:08:35,320
.السّؤال هو متى وقعت السّاعة

132
00:08:35,660 --> 00:08:36,870
وقعت؟

133
00:08:36,870 --> 00:08:40,580
نعم. أعلنت هذه السّاعة عن الوقت
.عندما استُعملت لمهاجمة الضّحيّة

134
00:08:40,580 --> 00:08:43,500
...إنّها 8:50، على ما أظنّ

135
00:08:43,750 --> 00:08:48,590
ومن ثمّ تسبّب ارتطامها بكسر
.قاعدتها وسقوط هيكل السّاعة

136
00:08:48,590 --> 00:08:50,960
لـ-لكن ماذا عن هيكل السّاعة؟

137
00:08:51,460 --> 00:08:54,260
.تمّ العثور عليه على أرض ساحة الجريمة

138
00:08:55,010 --> 00:08:55,680
ماذا هنالك؟

139
00:08:57,300 --> 00:09:00,260
.حسنًا... يبدو هذا منطقيًّا بالفعل

140
00:09:00,260 --> 00:09:02,640
.لا فائدة يا محامي الدّفاع المبتدئ

141
00:09:02,640 --> 00:09:07,270
أنا أستعمل كلّ دليل تعثر عليه
.الشّرطة للوصول لاستنتاجاتي

142
00:09:08,860 --> 00:09:10,360
!أنا لا أتجاهل أيّ شيء

143
00:09:10,360 --> 00:09:12,070
ما-ماذا؟

144
00:09:12,440 --> 00:09:14,490
الطّريقة الوحيدة لتثبت أنّي على خطأ

145
00:09:14,490 --> 00:09:20,410
.هي بإثبات كيف ومتى تمّت إزالة هيكل السّاعة

146
00:09:20,410 --> 00:09:24,830
.لكنّي أستطيع أن أقول وبلا شكّ أنّ ذلك مستحيل

147
00:09:24,830 --> 00:09:26,790
.مستحيل. وبلا أشكّ

148
00:09:27,210 --> 00:09:29,250
متى تمّت إزالة هيكل السّاعة؟

149
00:09:29,500 --> 00:09:31,550
ما الدّليل الّذي يستطيع إثبات ذلك؟

150
00:09:32,050 --> 00:09:35,220
.دليلٌ ما لا علم للمدّعي العامّ ميتسوروغي به

151
00:09:35,800 --> 00:09:36,720
!أجل

152
00:09:38,180 --> 00:09:39,090
!اعتراض

153
00:09:40,800 --> 00:09:43,850
ما قصّة الهاتف المحمول الظّريف؟

154
00:09:45,140 --> 00:09:48,060
هذا هو هاتف المدّعى عليها الّذي
!تمّ العثور عليه في ساحة الجريمة

155
00:09:48,060 --> 00:09:49,350
!ماذا؟

156
00:09:49,730 --> 00:09:51,940
إنّه يحتوي على تسجيل

157
00:09:51,940 --> 00:09:54,860
للمحادثة الّتي دارت بينها وبين الضّحيّة
!في اليوم الّذي وقعت فيه الجريمة

158
00:09:56,490 --> 00:09:57,650
!لم يتمّ إعلامي بهذا

159
00:09:57,650 --> 00:09:59,780
...حسنًا، أنا... لم

160
00:10:00,030 --> 00:10:05,620
لن تجد في تقييمك للشّهر القادم ما يسرّك
.أيّها المحقّق إتونوكوغيري

161
00:10:06,410 --> 00:10:08,670
!نظام! نظام

162
00:10:13,420 --> 00:10:17,130
.مهلاً. السّاعة لا تتحدّث الآن

163
00:10:17,130 --> 00:10:19,180
.توجّب عليّ إخراج هيكل السّاعة

164
00:10:19,180 --> 00:10:21,090
.وضعتُ ورقًا بداخلها بدل ذلك

165
00:10:22,010 --> 00:10:23,930
هل ذلك هو الدّليل إذًا؟

166
00:10:24,350 --> 00:10:24,930
.ذكيّة كعادتك

167
00:10:25,390 --> 00:10:31,480
.محادثة مسجّلة. الثّالث من أبريل، 9:27 صباحًا

168
00:10:32,440 --> 00:10:37,490
بعبارات أخرى، تمّت إزالة هيكل السّاعة
.سلفًا في صباح يوم وقوع الجريمة

169
00:10:38,650 --> 00:10:42,120
.لذلك ما كانت لتصدر صوتًا تلك اللّيلة

170
00:10:42,570 --> 00:10:43,280
...أوميو-سان

171
00:10:44,030 --> 00:10:47,950
!هنالك تناقض واضح في شهادتك

172
00:10:49,870 --> 00:10:51,080
.مـ-مستحيل

173
00:10:51,080 --> 00:10:53,340
تمّ تسجيل تلك المحادثة؟

174
00:10:54,710 --> 00:10:55,840
ما الّذي قلتِه للتّوّ؟

175
00:10:55,840 --> 00:10:57,760
"قالت "تمّ تسجيل تلك المحادثة؟

176
00:10:58,920 --> 00:11:01,510
—أكنتِ تعرفين بشأن محادثتهما

177
00:11:01,510 --> 00:11:02,260
!اعتراض

178
00:11:02,930 --> 00:11:05,100
.لا علاقة لهذا بالقضيّة

179
00:11:05,100 --> 00:11:07,060
.لا يوجد داعٍ للاستمرار في طرح هذه الأسئلة

180
00:11:07,060 --> 00:11:08,430
!بل أظنّ العكس تمامًا

181
00:11:09,230 --> 00:11:12,350
...إذًا فهذا هو الهدف من كلّ هذا

182
00:11:12,350 --> 00:11:17,030
أوميو-سان، كنتِ تتنصّتين على المحادثات
!الهاتفيّة لمكتب أياساتو وشركائها للمحاماة

183
00:11:18,320 --> 00:11:19,150
!باستعمال هذا

184
00:11:19,860 --> 00:11:22,450
هـ-هل هذا جهاز تنصّت؟

185
00:11:24,490 --> 00:11:27,080
.عثرتُ عليه في سلّة مهملات غرفتها في الفندق

186
00:11:27,080 --> 00:11:30,040
ما قولك في هذا يا أوميو-سان؟

187
00:11:30,460 --> 00:11:33,290
.كنتِ تتنصّتين على الهاتف في مسرح الجريمة

188
00:11:33,290 --> 00:11:34,920
!هذه جريمة يعاقب عليها القانون

189
00:11:39,130 --> 00:11:42,180
!اخرس يا ذا الشّعر الشّائك

190
00:11:42,180 --> 00:11:44,760
!من يأبه لجهاز التّنصّت ذلك، بئسًا لك؟

191
00:11:44,760 --> 00:11:46,390
.تلك الفتاة هي الجانية

192
00:11:46,390 --> 00:11:48,640
!ألقوا بها في السّجن بسرعة، بئسًا لكم

193
00:11:48,640 --> 00:11:49,930
!بئسًا لنا؟

194
00:11:49,930 --> 00:11:54,100
.لقد أُمرتُ أنّ أنتصّت إلى محادثتهما فحسب

195
00:11:54,100 --> 00:11:56,900
!لا علاقة لي بالجريمة، بئسًا لكم

196
00:11:57,480 --> 00:11:59,480
أُمرتِ أن تتنصّتي على محادثاتها الهاتفيّة؟

197
00:11:59,480 --> 00:12:00,900
من أمركِ؟

198
00:12:04,660 --> 00:12:07,780
هل الشّخص الّذي أمركِ أن تتنصّتي على الهاتف

199
00:12:07,780 --> 00:12:09,660
هو صاحب زرّ الكُمّ هذا؟

200
00:12:09,910 --> 00:12:11,250
—كـ-كيف

201
00:12:11,250 --> 00:12:12,120
!هذا يكفي

202
00:12:12,660 --> 00:12:13,920
...يا سعادة القاضي

203
00:12:13,920 --> 00:12:16,380
ما الأمر أيّها المدّعي العامّ متسوروغي؟

204
00:12:16,380 --> 00:12:20,590
كما ترى، تمّ تسليط الضّوء على بعض
.الحقائق غير المتوقّعة في هذه القضيّة

205
00:12:20,590 --> 00:12:22,420
،وبغرض التّحقيق أكثر فيها

206
00:12:22,420 --> 00:12:25,340
.يرغب الادّعاء بتأجيل المحاكمة حتّى الغد

207
00:12:26,930 --> 00:12:29,390
.قبلت المحكمة طلب الادّعاء

208
00:12:29,390 --> 00:12:32,930
يُرجى من الادّعاء والدّفاع النّظر
.في هذه المسألة بشكل شامل

209
00:12:35,650 --> 00:12:36,350
.حا-حاضر

210
00:12:38,060 --> 00:12:40,230
.انتهت محاكمة أياساتو مايوي لهذا اليوم

211
00:12:40,230 --> 00:12:41,990
.تمّ تأجيل المحاكمة

212
00:12:49,030 --> 00:12:50,660
...سيّدي المحامي

213
00:12:50,910 --> 00:12:53,370
!كنتَ رائعًا في المحاكمة

214
00:12:54,460 --> 00:12:56,670
.أبليتِ حسنًا هناك أيضًا

215
00:12:56,670 --> 00:12:58,630
!أعتقد أنّي قد أكون أولى معجبيك

216
00:12:58,630 --> 00:13:00,500
!كنتَ في غاية الرّوعة

217
00:13:00,500 --> 00:13:01,460
...لا، لا

218
00:13:01,460 --> 00:13:05,090
.كان جميع الحرّاس يتحدّثون عنك كذلك

219
00:13:05,090 --> 00:13:06,340
فـ-فعلاً؟

220
00:13:06,340 --> 00:13:08,600
!يقولون أنّك جيّد بالنّسبة لشخص بشعر شائك

221
00:13:08,930 --> 00:13:11,350
وما علاقة شعري بالأمر؟

222
00:13:11,350 --> 00:13:14,060
.أنا في غاية السّعادة

223
00:13:14,060 --> 00:13:15,600
!أنا أطير من السّعادة

224
00:13:15,600 --> 00:13:19,150
.أدين بكلّ هذا لزلّة لسان أوميو-سان

225
00:13:19,150 --> 00:13:22,190
.شكرًا جزيلاً لك يا سيّدي المحامي

226
00:13:22,190 --> 00:13:23,530
.لا شكر على واجب

227
00:13:24,360 --> 00:13:27,200
.حسنًا، سأذهب لأحقّق أكثر في الأمر

228
00:13:27,200 --> 00:13:29,530
.عليّ أن أعثر على دلائل قبل الغد

229
00:13:29,530 --> 00:13:30,200
.حسنًا

230
00:13:30,200 --> 00:13:32,700
!سأكون إلى مركز الاحتجاز إن احتجتَ لي

231
00:13:39,460 --> 00:13:43,340
حسنًا، من أين لي أن آتي بتلك الأدلّة؟

232
00:13:46,090 --> 00:13:47,970
!هوشيكاغي-سينسي

233
00:13:48,720 --> 00:13:51,430
أتيتَ لترى المحاكمة؟

234
00:13:52,350 --> 00:13:57,520
من المذهل أنّك قررّت مواجهة ميتسوروغي
.واستطعتَ إطالة المحاكمة لجلسة أخرى

235
00:13:58,060 --> 00:13:59,810
.شكرًا لك

236
00:13:59,810 --> 00:14:02,150
ما الّذي أتى بك إلى هنا على أيّة حال؟

237
00:14:03,780 --> 00:14:04,780
هوشيكاغي-سينسي؟

238
00:14:05,110 --> 00:14:07,360
...أنا في غاية الأسف يا بُنيّ

239
00:14:07,360 --> 00:14:11,120
.أنت تقاتل بكلّ ما لديك رغم أنّك لا تزال في مبتدئًا

240
00:14:11,120 --> 00:14:12,740
.بينما هربتُ أنا

241
00:14:12,950 --> 00:14:15,700
جعلتني رؤية دفاعك الشّجاع أدرك

242
00:14:16,370 --> 00:14:18,620
.أنّ الوقت قد حان لأقوّي عزيمتي

243
00:14:18,620 --> 00:14:19,580
عزيمتك؟

244
00:14:24,090 --> 00:14:26,590
.تحرّى أمر هذا الرّجل

245
00:14:29,470 --> 00:14:30,680
من هذا؟

246
00:14:30,680 --> 00:14:32,180
،كوناكا ماسارو

247
00:14:32,180 --> 00:14:34,810
."رئيس شركة تسمّى "ثقافة كوناكا

248
00:14:35,560 --> 00:14:37,560
...كوناكا ماسارو

249
00:14:38,730 --> 00:14:40,190
!مهلاً، زرّ الكُمّ ذاك

250
00:14:40,810 --> 00:14:44,440
"من الخارج، تبدو شركة "ثقافة كوناكا
.كشركة لجمع المعلومات

251
00:14:44,440 --> 00:14:46,320
،لكن في الحقيقة

252
00:14:46,320 --> 00:14:50,240
،إنّها تبحث في أمور النّاس الشّخصيّة
.وتجبرهم على دفع الأموال مقابل عدم كشفها

253
00:14:50,240 --> 00:14:51,610
مهلاً، ماذا؟

254
00:14:51,610 --> 00:14:53,780
!هذا ابتزاز

255
00:14:54,080 --> 00:14:58,250
،رغم أنّي محرج من اعترافي بهذا الأمر

256
00:15:00,080 --> 00:15:04,420
.لم أستطع الوقوف في وجه ذلك الرّجل أيضًا

257
00:15:06,460 --> 00:15:09,720
ألهذا السّبب رفضتَ الدّفاع عن مايوي-تشان؟

258
00:15:10,010 --> 00:15:11,050
.نعم

259
00:15:11,050 --> 00:15:12,470
...يا لي من محامٍ

260
00:15:12,720 --> 00:15:16,060
لكن لماذا لم يتمّ اعتقاله؟

261
00:15:16,060 --> 00:15:18,350
!الابتزاز جريمة

262
00:15:18,930 --> 00:15:24,150
.إنّه يتحكّم في رجال الأعمال والسّياسيّين ورجال الشّرطة والقضاء

263
00:15:24,150 --> 00:15:27,360
.إنّه الرّجل الأكثر خطورة في البلاد

264
00:15:27,610 --> 00:15:29,610
...هـ-هذا لا يُصدّق

265
00:15:29,610 --> 00:15:33,820
.وكانت تشيهيرو-كُن تلاحق كلّ تحرّكاته لسنوات عديدة

266
00:15:34,240 --> 00:15:36,530
تـ-تشيهيرو-سان كانت...؟

267
00:15:38,910 --> 00:15:42,170
.كا. كي. كُ. كِ

268
00:15:42,170 --> 00:15:45,080
...كو... كو... كونوكا

269
00:15:45,080 --> 00:15:45,630
ماذا؟

270
00:15:46,090 --> 00:15:48,090
.لقد اختفى. ملفّ "كو" مفقود

271
00:15:48,090 --> 00:15:51,880
.وكانت تشيهيرو-كُن تلاحق كلّ تحرّكاته لسنوات عديدة

272
00:15:52,180 --> 00:15:55,140
...إن كان كونوكا هو من سرق الملف

273
00:15:57,810 --> 00:15:59,560
فندق باندو

274
00:15:59,140 --> 00:16:01,520
.نعم، كان هو

275
00:16:01,520 --> 00:16:05,400
هل أنت واثق تمامًا أنّ شوتشيكو أوميو
دخلت الفندق مع هذا الرّجل؟

276
00:16:05,650 --> 00:16:06,730
...نعم

277
00:16:06,730 --> 00:16:11,360
إنّها آنسة جميلة، شعرتُ بالغيرة
.من الرّجل الّذي كان برفقتها

278
00:16:15,370 --> 00:16:19,040
...إذًا، من أمر بالتّنصّت على المحادثات الهاتفيّة كان

279
00:16:24,790 --> 00:16:26,130
!كوناكا ماسارو

280
00:16:47,190 --> 00:16:49,730
ما قصّة هذا الدّيكور السّيرياليّ؟

281
00:16:50,900 --> 00:16:52,740
ما هو اسمك؟

282
00:16:52,740 --> 00:16:53,570
...ما هو

283
00:17:03,200 --> 00:17:05,460
.مـ-مرحبًا

284
00:17:05,460 --> 00:17:07,710
اسمك! ما هو اسمك؟

285
00:17:07,710 --> 00:17:10,880
!أطلعني على الاسم الّذي ينادونك به

286
00:17:10,880 --> 00:17:12,260
ما هو اسمك؟

287
00:17:12,260 --> 00:17:15,010
...أ-أنا ناروهودو

288
00:17:15,010 --> 00:17:18,430
،عشتُ لمدّة طويلة في الولايات المتّحدة

289
00:17:18,430 --> 00:17:21,220
.لذلك أواجه صعوبة مع اليابانيّة

290
00:17:21,220 --> 00:17:22,680
فعلاً؟

291
00:17:25,770 --> 00:17:30,610
،أنا كونوكا ماسارو... الرّئيس
.بل "البريزيدينت" لهذه الشّركة

292
00:17:30,610 --> 00:17:34,690
،بالمناسبة، أنت مجرّد محامٍ
لا تزال في بدايتك، صحيح؟

293
00:17:34,990 --> 00:17:36,650
.حسنًا، أنت محقّ

294
00:17:36,900 --> 00:17:38,700
.سمعتُ بالأمر من سكرتيرتي

295
00:17:38,700 --> 00:17:40,160
...حسنًا أيّها المحامي القويّ

296
00:17:41,450 --> 00:17:42,910
ما الأمر؟

297
00:17:44,370 --> 00:17:46,290
ما الأمر الّذي قد يجمعنا؟

298
00:17:47,210 --> 00:17:48,750
...شوتشيكو أوميو-سان

299
00:17:49,380 --> 00:17:50,710
أنت تعرفها، صحيح؟

300
00:17:50,710 --> 00:17:52,050
!نعم، أعرفها

301
00:17:52,050 --> 00:17:53,550
.كانت سكرتيرتي

302
00:17:53,550 --> 00:17:56,380
،كانت صدمة كبيرة لي
...أقصد بعد سماعي لما فعلتْه

303
00:17:56,380 --> 00:17:58,430
ما فعلتْه." تقصد التّنصّت على الهاتف؟"

304
00:17:59,050 --> 00:18:00,640
!أجل، يمكننا ذلك

305
00:18:00,640 --> 00:18:02,260
.بالطّبع

306
00:18:02,680 --> 00:18:06,480
.نعم، جمع المعلومات هو ما تفعله هذه الشّركة

307
00:18:06,480 --> 00:18:11,610
لكنّي أضمن لك أنّنا ما كنّا أبدًا لنلجأ لطُرق
.غير قانونيّة كالتّنصّت على الهاتف

308
00:18:11,610 --> 00:18:15,440
.قالت أوميو-سان أنّها كانت تنفّذ الأوامر فحسب

309
00:18:15,740 --> 00:18:18,570
تلقي اللّوم على غيرها؟

310
00:18:18,570 --> 00:18:20,950
...يا لها من قطّة سيّئة

311
00:18:20,950 --> 00:18:23,910
،في اليوم الّذي شهدتْ فيه على الجريمة

312
00:18:23,910 --> 00:18:27,080
دخلتَ معها إلى ذلك الفندق، صحيح؟

313
00:18:27,330 --> 00:18:28,290
من يدري؟

314
00:18:28,290 --> 00:18:31,290
.نادرًا ما أعير التّفاصيل الصّغيرة، كالزّمان والمكان، اهتمامي

315
00:18:31,290 --> 00:18:34,840
"!شعاري في الحياة هو "لا تقلق، كُن سعيدًا

316
00:18:34,840 --> 00:18:37,880
.لكنّ ساعي البهو في الفندق يتذكّرك بوضوح

317
00:18:38,340 --> 00:18:40,840
".لا تثق بسُعاة البهو والمحامين"

318
00:18:40,840 --> 00:18:43,180
!هذه هي قاعدتي في الحياة

319
00:18:45,560 --> 00:18:47,520
.عثرتُ على هذا في الغرفة

320
00:18:47,520 --> 00:18:50,980
"أعتقد أنّ "لا تقلق، كُن سعيدًا
. لن تخرجك من هذه الورطة

321
00:18:54,480 --> 00:18:56,980
ما الّذي يجب عليك أن تفعله الآن؟

322
00:18:56,980 --> 00:18:59,070
تتحرّى أمري؟

323
00:18:59,070 --> 00:19:01,240
.لا، لا، لا. لا أظنّ ذلك

324
00:19:01,610 --> 00:19:04,660
.يجدر بك أن تبحث عن قاتل الآنسة تشيهيرو

325
00:19:04,660 --> 00:19:05,740
أهذا صحيح؟

326
00:19:06,450 --> 00:19:07,700
.أنت على حقّ تمامًا

327
00:19:08,160 --> 00:19:10,830
.ولهذا السّبب أنا هنا

328
00:19:11,460 --> 00:19:13,170
ما الّذي ترمي إليه؟

329
00:19:13,170 --> 00:19:15,290
.كانت تشيهيرو-سان تشتبه بأمرك
.كانت تلاحقك

330
00:19:15,670 --> 00:19:19,760
لهذا السّبب جعلتَ شوتشيكو أوميو
.تتنصّت على هاتفها

331
00:19:20,840 --> 00:19:22,760
،وبعد ذلك تعرّضت تشيهرو-سان للقتل

332
00:19:23,180 --> 00:19:26,720
.واختفت كلّ الوثائق عنك بشكل غامض

333
00:19:26,720 --> 00:19:28,220
إذًا من برأيك الجاني؟

334
00:19:31,600 --> 00:19:33,350
!حتّى الطّفل الصّغير يستطيع استنتاج هذا

335
00:19:34,520 --> 00:19:36,730
ما رأيك يا كوناكا-سان؟

336
00:19:43,410 --> 00:19:45,530
.مرحبًا، مكتب السّكرتيرة

337
00:19:45,530 --> 00:19:47,830
أخبري المدّعي العامّ

338
00:19:47,830 --> 00:19:51,660
أنّي سأقدّم شهادتي في محاكمة
.مقتل أياساتو تشيهيرو في الغد

339
00:19:51,660 --> 00:19:54,330
.سأقدّم لهم معلومات جديدة تمامًا

340
00:19:54,330 --> 00:19:55,670
.في الحال

341
00:19:55,670 --> 00:19:59,010
!واتّصلي بالشّرطة في الحال رجاءً

342
00:19:59,010 --> 00:20:00,260
.في الحال

343
00:20:01,920 --> 00:20:03,300
ما الّذي تخطّط له؟

344
00:20:03,680 --> 00:20:05,640
ألم أخبرك من قبل يا ناروهودو؟

345
00:20:05,640 --> 00:20:07,640
.أنت مجرّد محامٍ

346
00:20:07,970 --> 00:20:09,520
...تمامًا مثل الآنسة تشيهيرو

347
00:20:09,520 --> 00:20:12,190
!إذًا أنت من قتلها بالفعل؟

348
00:20:12,190 --> 00:20:15,100
.كلاّ، بل أنت من قتلها

349
00:20:15,860 --> 00:20:18,190
سوف أوجّه أصابع الاتّهام لك

350
00:20:18,190 --> 00:20:21,440
!فأنت هو قاتل الآنسة تشيهيرو الحقيقيّ

351
00:20:21,440 --> 00:20:22,860
!ما-ماذا؟

352
00:20:26,870 --> 00:20:27,910
!مكانك

353
00:20:27,910 --> 00:20:29,290
!هذه الشّرطة يا فتى

354
00:20:29,290 --> 00:20:31,370
.أحسنت أيّها المحقّق

355
00:20:31,370 --> 00:20:34,540
.أقدّم لك الرّجل الّذي قتل أياساتو تشيهيرو

356
00:20:34,540 --> 00:20:36,170
ما-ماذا؟

357
00:20:36,170 --> 00:20:37,250
كان أنت؟

358
00:20:37,250 --> 00:20:39,710
—صدّقني أيّها المحقّق! أنا لم

359
00:20:39,710 --> 00:20:44,510
.وفّر كلامك هذا إلى أن تغرب عن ناظري رجاءً

360
00:20:44,510 --> 00:20:46,760
!ماذا؟

361
00:20:46,760 --> 00:20:47,970
!اذهب معه

362
00:20:47,970 --> 00:20:49,470
.خذه بعيدًا

363
00:20:49,470 --> 00:20:50,890
.مع السّلامة يا ناروهودو

364
00:20:50,890 --> 00:20:52,100
—كوناكا

365
00:21:01,900 --> 00:21:02,900
.معكم ميتسوروغي

366
00:21:04,450 --> 00:21:05,110
ماذا؟

367
00:21:05,910 --> 00:21:07,030
محامي الدّفاع؟

368
00:21:20,960 --> 00:21:22,090
.تمّ إطلاق سراحك

369
00:21:23,300 --> 00:21:25,340
.اخرجي، بسرعة

370
00:21:25,340 --> 00:21:26,510
!حا-حاضرة

371
00:21:33,310 --> 00:21:34,640
.حسنًا... ادخل

372
00:21:38,060 --> 00:21:39,520
!سـ-سيّدي المحامي

373
00:23:17,290 --> 00:23:18,500
!اعتراض

374
00:23:18,500 --> 00:23:20,620
!أعترض على اعتقالي

375
00:23:20,620 --> 00:23:22,290
.كوناكا مخيف بالفعل

376
00:23:22,290 --> 00:23:24,290
إلى أيّ مدى يصل نفوذه؟

377
00:23:24,290 --> 00:23:27,090
.أنا لم أقتل تشيهيرو-سان بالطّبع

378
00:23:27,510 --> 00:23:32,220
،ولكي أساعد مايوي-تشان والرّاحلة تشيهيرو-سان
...عليّ أن آخذ في حسباني كلّ الشّهادات

379
00:23:32,220 --> 00:23:33,840
!وأعيد فحص الأدلّة

380
00:23:34,100 --> 00:23:36,890
.سوف أكشف الجاني الحقيقيّ

381
00:23:36,890 --> 00:23:39,430
!ميتسوروغي، هذا هو دفاعي

382
00:23:40,020 --> 00:23:41,100
!سأعثر على المتناقضات

383
00:23:41,100 --> 00:23:42,440
!وأكتشف الحقيقة

384
00:23:42,440 --> 00:23:45,360
!في الحلقة القادمة: تغيّر الأختان — المحاكمة الأخيرة

385
00:23:45,360 --> 00:23:46,190
!خذ هذا