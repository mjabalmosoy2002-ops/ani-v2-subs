1
00:00:01,970 --> 00:00:04,240
،ما دام الخير موجوداً في هذا العالم

2
00:00:04,240 --> 00:00:05,720
سيتواجد الشرّ أيضاً

3
00:00:06,690 --> 00:00:09,500
،لكن خلف هذا الصّراع الأبدي بين الخير والشرّ

4
00:00:09,500 --> 00:00:12,050
هناك معركة أخرى غير مرئيّة تندلع

5
00:00:17,850 --> 00:00:20,590
!والآن استعدّ للموت يا بليدر

6
00:00:20,590 --> 00:00:24,800
!ارتعد أمام الوابل الهائل من هجمات هيدرا المُميتة

7
00:00:26,350 --> 00:00:28,250
الوحش التجديديّ هيدرا

8
00:00:28,600 --> 00:00:30,600
مخلوق بثمانية رؤوس طرفيّة

9
00:00:31,040 --> 00:00:32,660
...أو هكذا كان المُقترح

10
00:00:32,660 --> 00:00:34,860
تمّ إنقاص عدد الرّؤوس لأسباب تتعلّق بالميزانيّة

11
00:00:35,220 --> 00:00:37,850
!تمتلك سمّاً فتّاكاً أيضاً

12
00:00:38,240 --> 00:00:39,560
...أو هكذا كان المُقترح

13
00:00:39,560 --> 00:00:42,020
لم يتمّ إضافة السمّ لأسباب تتعلّق بالميزانيّة

14
00:00:44,700 --> 00:00:47,950
أتتوقّعون أن يجعلني هذا الوحش الهزيل أتردّد؟

15
00:00:47,950 --> 00:00:50,360
!سأستخدم كامل قوّتي من البداية

16
00:00:52,020 --> 00:00:53,450
!يا له من ضغط

17
00:00:53,450 --> 00:00:56,530
!لم يكن بليدر بهذه الحدّة من قبل

18
00:00:56,890 --> 00:00:58,550
...إن لم أسرع

19
00:00:58,550 --> 00:01:00,810
...إن لم أهزم هذا المخلوق في أسرع وقت

20
00:01:01,270 --> 00:01:03,090
!سأتأخّر عن عملي

21
00:01:03,590 --> 00:01:05,030
السيّاف القدسيّ بليدر

22
00:01:05,030 --> 00:01:08,870
يعمل في مُناوبات مسائيّة في يومَي الأربعاء والسّبت

23
00:02:57,240 --> 00:02:58,400
مرحباً؟

24
00:02:58,400 --> 00:03:00,110
هل ميزوكي معي؟

25
00:03:00,110 --> 00:03:01,840
!معكِ ماتسوياما

26
00:03:01,840 --> 00:03:04,750
من العمل ذي المسافة البعيدة؟

27
00:03:09,040 --> 00:03:10,890
أجل، تذكّرت

28
00:03:10,890 --> 00:03:12,890
هل أنتِ متفرّغة غداً يا ميزوكي؟

29
00:03:12,890 --> 00:03:15,370
...تنقصنا يد عاملة، لذا

30
00:03:15,370 --> 00:03:18,550
هل هو نفس العمل السّابق؟

31
00:03:18,790 --> 00:03:21,070
ماذا؟ هل واجهتِ مشكلات؟

32
00:03:21,070 --> 00:03:23,050
ليس هذا ما أقصده

33
00:03:23,320 --> 00:03:27,050
لكن لا أظنّني مؤهّلة لمثل هذا العمل

34
00:03:27,050 --> 00:03:29,300
أتفهّم شعوركِ هذا

35
00:03:29,300 --> 00:03:32,120
لم يتلاءم ذلك من نقاط قوّتكِ، أليس كذلك؟

36
00:03:32,120 --> 00:03:33,840
!أتّفق كليّاً

37
00:03:33,840 --> 00:03:35,210
صحيح؟

38
00:03:35,210 --> 00:03:38,140
!لكن العمل التّالي مختلف تماماً

39
00:03:38,140 --> 00:03:39,900
!إنّه عمل خفيف بصراحة

40
00:03:39,900 --> 00:03:42,610
!سوف نقدّم غداء أيضاً

41
00:03:42,610 --> 00:03:45,000
!طعام بحريّ عالي الجودة

42
00:03:47,510 --> 00:03:48,720
هل يمكنكِ القدوم؟

43
00:03:54,820 --> 00:03:55,980
أنا مُتعَب

44
00:03:56,840 --> 00:04:00,710
وصلتُ إلى مناوبتي في الوقت على الأقلّ

45
00:04:00,710 --> 00:04:03,340
لكن لن أحظى بساعات إضافيّة هكذا

46
00:04:03,570 --> 00:04:08,090
قد تكون الموازنة ما بين العمل البطوليّ
والعمل بدوام جزئي أصعب ممّا توقّعت

47
00:04:08,690 --> 00:04:11,600
أنقذتُما الوضع ثانية

48
00:04:11,600 --> 00:04:13,000
!بالتأكيد

49
00:04:13,000 --> 00:04:17,600
لا تملك قوّات الشرّ فرصة أمام الفتيات
!السحريّات: بيليا ماجيا

50
00:04:17,600 --> 00:04:21,360
!نعِدُ بأنّنا سنحافظ على المدينة آمنة

51
00:04:20,260 --> 00:04:23,110
ثنائي فتيات سحريّات مُرخّص؟

52
00:04:23,330 --> 00:04:24,500
إنّهما محظوظتان للغاية

53
00:04:24,500 --> 00:04:26,980
يستطيع الأبطال ب دوام كامل أن يُدرِجوا
،العمل في سيرتهم الذاتيّة

54
00:04:26,980 --> 00:04:28,780
...وحتّى أنّهم يحصلون على دعم مالي

55
00:04:29,130 --> 00:04:30,570
،واقتباس أنمي

56
00:04:30,570 --> 00:04:32,090
،وسلع خاصّة

57
00:04:32,090 --> 00:04:33,810
،وآلات باتشينكو

58
00:04:33,810 --> 00:04:35,690
...وعروض مسرح حيّة

59
00:04:35,690 --> 00:04:37,170
!هذا رائع حقّاً

60
00:04:39,530 --> 00:04:42,930
لكن كلّ شيء عبارة عن فتيات سحريّات مؤخّراً

61
00:04:43,330 --> 00:04:45,650
هل الأبطال المُتحوّلون لم يعودوا رائجين؟

62
00:04:46,310 --> 00:04:50,390
هل المواظبة على بليدر هذا فكرة سديدة بالنسبة لي؟

63
00:04:51,220 --> 00:04:52,420
!مرحباً

64
00:04:56,500 --> 00:04:58,490
هلّا حضّرت لي زبدية من لحم الخنزير على أرزّ

65
00:04:58,490 --> 00:05:01,440
مع قطعتين من الزنجبيل المخلّل؟

66
00:05:01,440 --> 00:05:03,060
!لحم خنزير على أرزّ

67
00:05:03,800 --> 00:05:05,500
في طريقكِ إلى المنزل؟

68
00:05:05,500 --> 00:05:07,620
تبدين مُرهَقة جدّاً

69
00:05:08,290 --> 00:05:11,940
أجل... كان يومي سيّئاً في العمل

70
00:05:12,220 --> 00:05:13,950
يومكِ سيّئ؟

71
00:05:13,950 --> 00:05:16,450
!في العمل الّذي لا تستطيع مُناقشته؟

72
00:05:20,450 --> 00:05:22,980
أهذا كلّ ما حصلتِ عليه؟

73
00:05:22,980 --> 00:05:24,100
أنا آسفة

74
00:05:24,100 --> 00:05:26,470
لم أتلقّ عروضاً كثيرة في الأمس

75
00:05:26,870 --> 00:05:28,710
!أرجوك! أحتاج هذه لفاتورة الكهرباء

76
00:05:28,710 --> 00:05:31,810
!اصمتي! تريدين مالاً أكثر، اكسبي أكثر

77
00:05:34,530 --> 00:05:36,720
!يا له من رجل فظيع

78
00:05:36,720 --> 00:05:38,670
،عملتُ جاهدة على هذا المشروع

79
00:05:38,670 --> 00:05:42,270
لكن اضطررتُ لتقديمه ناقصاً بسبب
الميزانيّة وموعد التّسليم

80
00:05:42,760 --> 00:05:43,970
ناقص؟

81
00:05:43,970 --> 00:05:46,490
،السيّاف القدسيّ بليدر، كينجي ساداماكي

82
00:05:46,490 --> 00:05:48,740
يأخذ فكرة خاطئة تماماً عن عمل كورويتسو

83
00:05:48,740 --> 00:05:52,590
،ظننتُ حقّاً أنّ المفهوم كان سليماً

84
00:05:52,590 --> 00:05:54,490
لكن لم يفلح ذلك فحسب

85
00:05:54,490 --> 00:05:56,890
أظنّني فهمت

86
00:05:56,890 --> 00:06:01,370
كانت لديّ بضعة مخاوف... متعلّقة بالعمل بحدّ ذاتي

87
00:06:01,990 --> 00:06:05,260
أتساءل فيما إذا كان الأسلوب
الذي أعتمده خاطئاً

88
00:06:05,260 --> 00:06:08,420
،لا أستطيع تخمين ما تمرّ به حتّى

89
00:06:08,420 --> 00:06:11,000
لكن أنا متأكّدة بأنّ الأمر صعب

90
00:06:11,000 --> 00:06:11,880
أجل

91
00:06:11,880 --> 00:06:14,880
،لكن كان فعل ما أفعله قراري

92
00:06:14,880 --> 00:06:17,000
لذا لا ينبغي أن أتنازل فيه غالباً

93
00:06:17,380 --> 00:06:18,780
تتنازل؟

94
00:06:18,780 --> 00:06:20,240
هذا صحيح

95
00:06:20,240 --> 00:06:25,060
كنتُ أركّز على تسليم مُنتَج كنتُ أتنازل
!عن أمور كثيرة فيه بلا إدراك

96
00:06:25,060 --> 00:06:26,270
تفضّلي

97
00:06:26,270 --> 00:06:28,280
لحم خنزير مع أرزّ

98
00:06:28,280 --> 00:06:31,740
شكراً لك على النّصيحة الرّائعة يا سيّدي الموظّف

99
00:06:32,820 --> 00:06:35,670
!سوف أعاود المحاولة

100
00:06:35,670 --> 00:06:37,850
يسرّني سماع ذلك

101
00:06:37,850 --> 00:06:39,040
ابذلي قصارى جهدكِ

102
00:06:39,880 --> 00:06:42,070
!استعدّ للموت يا بليدر

103
00:06:42,070 --> 00:06:46,250
فلتشهد الهيدرا المُعاد تصميمها
!خاصّتنا، بوقع مُضاعَف

104
00:06:46,250 --> 00:06:49,030
الوحش التجديديّ المُعاد تجديده هيدرا 2

105
00:06:49,030 --> 00:06:52,600
هو وحش تجديديّ برأسين طرفيّين

106
00:06:52,600 --> 00:06:54,810
—تمّ التّخطيط لإضافة السمّ، لكن

107
00:06:53,390 --> 00:06:54,810
!بليدر كراش

108
00:06:58,590 --> 00:07:01,310
...تبّاً، أتباع أغاستيا الخسيسون أولئك

109
00:07:01,310 --> 00:07:04,170
لماذا يأتون دوماً في يوم السّبت؟

110
00:07:04,170 --> 00:07:06,810
!كادوا يؤخّرونني عن العمل ثانية

111
00:07:09,690 --> 00:07:13,270
ربّما لا أستطيع تولّي عملي الثّاني فحسب

112
00:07:13,270 --> 00:07:15,330
!مستحيل

113
00:07:15,330 --> 00:07:18,070
!هذه المدينة تحت حمايتنا

114
00:07:18,680 --> 00:07:21,320
!الآن يمكنك أن تصبح ماجياروز أيضاً

115
00:07:21,780 --> 00:07:24,580
!ماجيازوارت لن تستسلم أبداً

116
00:07:25,530 --> 00:07:28,850
!عصا أماجيا الممتازة! علبة تجميل ماجيا الممتازة

117
00:07:29,080 --> 00:07:31,230
!الآن في الأسواق من بابينيا

118
00:07:32,440 --> 00:07:35,590
ربّما لستُ مؤهّلاً لهذا

119
00:07:40,050 --> 00:07:41,610
...طبق صغير من لحم الخنزير مع الأرزّ

120
00:07:42,140 --> 00:07:44,920
وثلاث قطع من الزنجبيل المخلّل

121
00:07:45,350 --> 00:07:48,850
!تـ-تبدين مُرهقة أكثر من المرّة السّابقة حتّى

122
00:07:48,850 --> 00:07:51,620
،قرّرتُ مراجعة بعض المستندات القديمة

123
00:07:51,620 --> 00:07:54,200
...لكن الأقدم كانت تناظريّة فقط

124
00:07:55,110 --> 00:07:58,290
،استسلمتُ للميزانيّة وموعد التّسليم ثانية

125
00:07:58,290 --> 00:08:00,620
وفشلتُ في جعل مفهومي يُثمِر

126
00:08:01,210 --> 00:08:05,360
لا أزال غير راضية عن وضع هيدرا الحاليّ

127
00:08:05,860 --> 00:08:07,870
أنا آسفة يا آنسة كورويتسو

128
00:08:07,870 --> 00:08:10,560
خسارتي أمام السيّد بليدر هي غلطتي

129
00:08:10,560 --> 00:08:14,230
!أجل، وقد سحقَنا أيضاً

130
00:08:14,230 --> 00:08:19,270
"هل تعرفين كم من المُهين مُناداتنا بـ"هيدرا
ونحن لا نملك سوى ثلاثة رؤوس؟

131
00:08:19,680 --> 00:08:21,530
!أختي واحد وأختي اثنان

132
00:08:21,530 --> 00:08:22,810
...رجاء، هذا يكفي

133
00:08:22,810 --> 00:08:27,090
الآن بعد أن انتهى العمل، بمقدوركِ أن
!تعزمينا على شيء لذيذ في مقهى

134
00:08:27,090 --> 00:08:30,530
!أفضّل جعّة في غينزا أو أكاساكا

135
00:08:30,800 --> 00:08:34,320
هل ستلصقين مزيداً من الرّؤوس عليها حقّاً؟

136
00:08:34,320 --> 00:08:36,110
!إنّها مُزعجة للغاية وهي بهذا الوضع سلفاً

137
00:08:36,110 --> 00:08:38,330
!اصمت يا حيوان الفتاة الصبيانية

138
00:08:38,330 --> 00:08:39,370
!ماذا قلت؟

139
00:08:39,370 --> 00:08:42,040
!أختي واحد، أختي اثنان

140
00:08:43,180 --> 00:08:44,980
عليّ أن أحسّن من جودة عملي

141
00:08:46,550 --> 00:08:48,540
كان ذلك مفهوم تصميمي الأصليّ

142
00:08:50,520 --> 00:08:53,280
،تبصق سمّاً لتثبيت بليدر في مكانه

143
00:08:53,280 --> 00:08:55,830
ثمّ تشنّ هجمات متتالية من رؤوس عديدة

144
00:08:56,780 --> 00:08:58,970
وهجمات مُركّزة من كافّة الأطراف

145
00:08:59,670 --> 00:09:02,170
رأسان فحسب لن يكفيا

146
00:09:02,820 --> 00:09:07,180
...عليّ إيجاد طريقة... لتوفير دعمٍ ماليّ أكبر

147
00:09:10,190 --> 00:09:11,620
هل أنتِ بخير؟

148
00:09:14,180 --> 00:09:16,480
أنا آسفة. أنا بخير حقّاً

149
00:09:17,760 --> 00:09:20,450
إنّها ثقيلة جدّاً! هل ستأخذينها معكِ للمنزل؟

150
00:09:20,450 --> 00:09:23,450
أجل. أحتاجها حقّاً

151
00:09:23,770 --> 00:09:26,570
يبدو عملك صعباً للغاية

152
00:09:26,570 --> 00:09:27,380
أجل

153
00:09:27,720 --> 00:09:30,330
وبالطبع، إنّه عملي

154
00:09:30,330 --> 00:09:34,470
لكن أؤمن به أيضاً على مستوى شخصيّ

155
00:09:35,460 --> 00:09:38,720
لا يمكنني نسيان سبب بدئي بالقيام بما أفعله

156
00:09:39,690 --> 00:09:40,860
...سبب بدئكِ

157
00:09:41,510 --> 00:09:42,800
...بالطبع

158
00:09:42,800 --> 00:09:47,510
ألم أصبح بليدر لمساعدة المحتاجين من الأساس؟

159
00:09:47,510 --> 00:09:50,430
!كيف لي أن أفقد الإيمان بنفسي؟

160
00:09:52,510 --> 00:09:55,890
!شكراً على النّصيحة الرّائعة يا آنسة

161
00:09:56,970 --> 00:10:00,270
أظنّني نسيتُ سبب بدئي بفعل ما أفعله

162
00:10:01,070 --> 00:10:04,360
!ساعدتِني على استرجاع شيء هامّ جدّاً

163
00:10:04,640 --> 00:10:06,370
يسرّني سماع ذلك

164
00:10:06,730 --> 00:10:08,460
!لنبذل قصارى جهدنا

165
00:10:09,740 --> 00:10:11,310
!شكراً لمجيئك

166
00:10:11,980 --> 00:10:14,150
هذا الموظّف صادق جدّاً

167
00:10:14,990 --> 00:10:18,470
عليّ أن أعمل من جديد على مُقترحي
بنفس درجة المصداقيّة

168
00:10:18,470 --> 00:10:22,150
أجل... هدفنا هو من الأساس هزيمة
!السيّاف القدسيّ بليدر

169
00:10:22,150 --> 00:10:25,560
!لن أتوقّف حتّى أبيده

170
00:10:27,240 --> 00:10:31,040
!إنّها نهايتك أخيراً

171
00:10:34,550 --> 00:10:37,890
الوحش التجديديّ المُجدَّد من جديد
وحش الهيدرا الجديد

172
00:10:37,890 --> 00:10:41,570
هو وحش تجديديّ بضعفَي عدد الرّؤوس
الطرفيّة مرّة أخرى

173
00:10:41,860 --> 00:10:43,910
،أنفِقَ آخر ما تبقّى من ميزانيّة على الرّؤوس

174
00:10:43,910 --> 00:10:47,070
لذا مع الأسف، لم تتمّ إضافة السمّ مرّة أخرى

175
00:10:47,410 --> 00:10:49,580
!اللّعنة عليكم يا أغاستيا

176
00:10:49,580 --> 00:10:52,090
!لماذا لا تُهاجمون إلّا في أيّام السّبت؟

177
00:10:52,480 --> 00:10:54,110
!قاتل يا بليدر

178
00:10:54,110 --> 00:10:55,980
!فخصمك يشاركك كفاحك

179
00:11:01,310 --> 00:11:02,840
أترك الباقي لكم

180
00:11:06,580 --> 00:11:09,850
!لحظة، هذا نفس العمل السّابق

181
00:11:09,850 --> 00:11:11,190
!غير صحيح

182
00:11:11,190 --> 00:11:15,370
كان ذلك العمل في كيوشو، ضمن
مُجتمع الشرّ السرّي المدمج

183
00:11:15,730 --> 00:11:18,130
،هذا العمل في هوكّايدو

184
00:11:18,130 --> 00:11:19,890
،لتيفيدورف، جزء من أومبرا

185
00:11:19,890 --> 00:11:21,870
تحت حكم ملك غابة الظّلام

186
00:11:21,870 --> 00:11:24,030
منظّمتان مختلفتان تماماً

187
00:11:27,370 --> 00:11:28,310
!لقد جاء

188
00:11:30,510 --> 00:11:32,320
!الفارس القادم من غابات الشّمال

189
00:11:32,880 --> 00:11:35,180
!يطرد الظّلام بنور القمر

190
00:11:35,180 --> 00:11:37,050
!فارس البوم، كانت

191
00:11:38,950 --> 00:11:41,290
!حان وقت إعادتكم إلى الظّلام

192
00:11:45,030 --> 00:11:46,340
!ها نحن ذا

193
00:11:47,340 --> 00:11:48,540
...هذا

194
00:11:50,070 --> 00:11:53,230
!هذا ليس عملاً خفيفاً إطلاقاً

195
00:11:59,030 --> 00:12:02,520
حسناً، هذا سؤالي الأوّل

196
00:12:02,520 --> 00:12:06,280
سبب إجرائنا مُقابلات دون فحص للسيرة الذاتيّة

197
00:12:06,280 --> 00:12:11,010
هو لأنّ رئيسنا يثمّن اللّقاءات وجهاً لوجه

198
00:12:11,990 --> 00:12:13,480
...لذا، هل يمكنني أن أفترض

199
00:12:14,260 --> 00:12:20,650
هو أنّك تعتقد بأنّ زيّ الحيوان ملائم لمقابلة؟

200
00:12:20,650 --> 00:12:23,450
!هـ-هذا ليس زيّاً

201
00:12:23,450 --> 00:12:25,050
!إنّه جسدي الحقيقيّ

202
00:12:25,050 --> 00:12:26,620
أنت عارٍ إذاً؟

203
00:12:26,620 --> 00:12:28,800
!و-وضعتُ ربطة عنق

204
00:12:28,800 --> 00:12:31,570
فهمت. عارٍ بالإضافة إلى ربطة عنق إذاً

205
00:12:33,110 --> 00:12:37,550
هل تعي بأنّ تركيز شركتنا يتمحور
حول الابتكار التقنيّ؟

206
00:12:37,550 --> 00:12:39,420
!أجل! أعي تماماً

207
00:12:39,420 --> 00:12:43,810
!أنا مُعجب جداً بالمُساهمات التي قدّمتموها للمجتمع

208
00:12:43,810 --> 00:12:48,870
وما المهارات التي ستأتي بها إلى شركتنا؟

209
00:12:48,870 --> 00:12:50,840
تتضمّن مهاراتي الرئيسيّة

210
00:12:50,840 --> 00:12:53,060
!إبادة الأبطال ومهارات القنص

211
00:12:53,370 --> 00:12:56,820
بمعنى... القتل إذاً؟

212
00:12:58,190 --> 00:13:00,770
!إذا أردت إيجاز الأمر، فأجل إذاً

213
00:13:00,770 --> 00:13:02,580
!أقضي على أهدافي دون فشل

214
00:13:05,020 --> 00:13:06,360
هكذا إذاً

215
00:13:10,340 --> 00:13:12,720
إشعار بالرّفض؟

216
00:13:13,290 --> 00:13:15,320
حسناً، توقعتُ ذلك

217
00:13:15,940 --> 00:13:21,110
وحتّى لو غيّرتُ عملي، سأبقى وحشاً دوماً

218
00:13:21,790 --> 00:13:25,620
،أعلم بأنّها معركة خاسرة

219
00:13:26,080 --> 00:13:29,780
لكن عندما أفكّر في احتماليّة كوني
جزءاً من هذه المنظّمة

220
00:13:26,130 --> 00:13:27,830
هل تريد بالوناً؟

221
00:13:28,720 --> 00:13:30,740
!هذا يجعل اليوم كلّه أكثر مرحاً

222
00:13:29,780 --> 00:13:33,060
،في السّنوات العشر أو العشرين التّالية
يبدأ القلق ينتابني

223
00:13:32,140 --> 00:13:34,810
!طاب يومك

224
00:13:33,060 --> 00:13:34,990
أهكذا أريد قضاء حياتي حقّاً؟

225
00:13:34,810 --> 00:13:35,890
!مرحى

226
00:13:36,130 --> 00:13:38,520
!شكراً على المجيء اليوم

227
00:13:37,650 --> 00:13:39,130
،لكن في الوقت الحالي

228
00:13:39,490 --> 00:13:43,440
أعتقد أنّ خياري الوحيد هو التّركيز على
عملي كعضو في الطاقم

229
00:13:43,440 --> 00:13:47,630
في مدينة ملاهٍ تديرها شركة غطاء لأغاستيا

230
00:13:49,050 --> 00:13:50,350
!مرحباً يا آنسة

231
00:13:50,350 --> 00:13:51,380
!تفضّلي بالوناً

232
00:13:51,380 --> 00:13:53,630
!شكراً جزيلاً لك

233
00:13:53,630 --> 00:13:56,140
!أحبّ اللّون الورديّ

234
00:13:56,470 --> 00:13:57,520
حقّاً؟

235
00:13:57,520 --> 00:13:59,600
!يسرّني أنّه يعجبكِ

236
00:13:59,600 --> 00:14:01,850
!وداعاً أيّها الطير الظريف

237
00:14:01,850 --> 00:14:02,890
شكراً لكِ

238
00:14:07,000 --> 00:14:09,020
ألم يكن ذلك لطيفاً يا ريو؟

239
00:14:09,020 --> 00:14:11,280
!أبداً

240
00:14:11,280 --> 00:14:15,800
هل اعتقد ذلك الطّائر أنّني طفلة
تحبّ البالونات فحسب؟

241
00:14:16,620 --> 00:14:18,710
!كذلك أنت يا يوتو

242
00:14:18,710 --> 00:14:22,030
أما زلت تعتقد بأنّني ما زلتُ من
الأطفال الّذين يحبّون البالونات؟

243
00:14:22,030 --> 00:14:24,180
بالطبع لا يا ريو

244
00:14:24,180 --> 00:14:28,040
،أعتقد أنّ الدّمية كانت طويلة فحسب
فبدوتِ قصيرة بالمقارنة

245
00:14:28,040 --> 00:14:29,340
ماذا؟

246
00:14:29,340 --> 00:14:32,300
تبدو لا تزال تلمّح بأنّني أبدو كطفلة

247
00:14:32,980 --> 00:14:36,070
!ليتني أكون طويلة مثلك يا يوتو

248
00:14:36,290 --> 00:14:40,170
ريو... ربّما لا ينبغي أن تتمسّكي بي هكذا

249
00:14:40,170 --> 00:14:43,560
قد يرانا أحد من الصفّ ويسيء الفهم

250
00:14:43,960 --> 00:14:45,590
ماذا تريد منّي؟

251
00:14:45,590 --> 00:14:48,830
طلب منّا المقرّ أن نبقى مُتلاصقين

252
00:14:48,830 --> 00:14:50,740
...أعلم ذلك، لكن

253
00:14:50,740 --> 00:14:52,330
هذا لا يعني أن تتشبّثي بي

254
00:14:58,610 --> 00:15:01,800
!تمّ رصد مانا وحش
!تمّ رصد مانا وحش

255
00:15:01,800 --> 00:15:02,570
!يوتو

256
00:15:02,570 --> 00:15:03,280
!حسناً

257
00:15:05,510 --> 00:15:07,160
!ماجيا بريك

258
00:15:07,720 --> 00:15:11,940
ريو شيكيشيما ويوتو هيغايا ليسا
فتيات مدارس

259
00:15:12,410 --> 00:15:17,730
،إنّهما بطلان خارقان رُخِّصا رسميّاً لحماية المدينة

260
00:15:17,730 --> 00:15:20,380
!الفتيات السحريّات: بيليا ماجيا

261
00:16:02,200 --> 00:16:04,790
!الفتاة السحريّة ماجياروز

262
00:16:10,390 --> 00:16:13,090
!الفتاة السحريّة ماجيازوارت

263
00:16:18,830 --> 00:16:21,290
...في الواقع، كنتُ أقول لنفسي

264
00:16:21,290 --> 00:16:25,060
هل تصبح أقصر منّي عند تحوّلنا؟

265
00:16:25,060 --> 00:16:26,980
!ربّما كذلك

266
00:16:26,980 --> 00:16:29,440
...يبدو كلّ ما يحيط بي أكبر قليلاً

267
00:16:32,390 --> 00:16:33,750
ماذا الآن؟

268
00:16:33,750 --> 00:16:36,480
...أصبحت أقصر ومع ذلك

269
00:16:37,320 --> 00:16:40,090
!لماذا هذان الشّيئان كبيران جدّاً؟

270
00:16:40,560 --> 00:16:44,570
تتصرّف وكأنّ ذلك لا يهمّك، لكن
!في باطنك، تحبّ الأثداء

271
00:16:44,570 --> 00:16:48,210
!لم أختر قوامي بعد التحوّل

272
00:16:46,430 --> 00:16:49,580
!يوتو الأحمق! يوتو الأحمق

273
00:16:57,580 --> 00:16:59,940
!حسناً، أنا متحمّسة تماماً

274
00:16:59,940 --> 00:17:01,270
!هيّا بنا يا يوتو

275
00:17:01,270 --> 00:17:03,760
!ثمّة وحش هناك، لنبحث عنه وندمّره

276
00:17:03,760 --> 00:17:06,080
!بحث وتدمير

277
00:17:06,080 --> 00:17:09,590
لا أحد يتقلّب مزاجه مثلك يا ريو

278
00:17:10,200 --> 00:17:14,090
أختي واحد، أختي اثنان. لا تتشاجرا رجاء

279
00:17:14,090 --> 00:17:16,840
!قولي لها أن تكفّ عن هرائها إذاً

280
00:17:16,840 --> 00:17:21,590
أنتِ من قال بأنّ أيّ شخص يمكنه أن يكون
نجم أكشن إذا كان وسيماً

281
00:17:21,590 --> 00:17:23,770
!حسناً، أين الخطأ في كلامي؟

282
00:17:23,770 --> 00:17:26,160
!يتولّون الأعمال الصّعبة برجال مُجازفين ورسوم حاسوبيّة

283
00:17:26,160 --> 00:17:27,400
!هراء

284
00:17:27,400 --> 00:17:30,440
أتعتقدين أنّ أيّ وجه حسن يستطيع
!أن يتدلّى من طائرة حمولات هابطة؟

285
00:17:30,440 --> 00:17:32,560
!كلتاكما بسيطتا التّفكير

286
00:17:32,560 --> 00:17:35,820
!الأفلام قمامة دون نصّ جيّد على أيّ حال

287
00:17:35,820 --> 00:17:39,610
رجل الثّلج الجديد ذاك يغنّي ببراعة عالية، صحيح؟

288
00:17:39,610 --> 00:17:40,980
!اصمتي أنتِ

289
00:17:41,210 --> 00:17:46,250
!أخواتي، أرجوكن! قد يرانا بطلٌ إذا لم تهدأن

290
00:17:46,530 --> 00:17:47,810
...تمّ تحديد

291
00:17:48,280 --> 00:17:49,500
!وحش...

292
00:17:49,850 --> 00:17:52,020
!زوارت، لننهِ هذا بهجمة واحدة

293
00:17:52,020 --> 00:17:53,970
!أجل! اتّبعي خطواتي يا روز

294
00:17:56,150 --> 00:17:58,240
!ماجيا فول بريك

295
00:18:00,020 --> 00:18:02,420
وُلِدتُ كوحش

296
00:18:02,420 --> 00:18:05,250
لا أعرف أن أكون شيئاً آخر

297
00:18:05,550 --> 00:18:09,900
هل هناك أيّ كبرياء وفخر تتمتّع بهما هويّتي إذاً؟

298
00:18:22,910 --> 00:18:24,140
!أخفقنا في إصابة الصّميم

299
00:18:24,140 --> 00:18:26,280
!أيّتها الطفلة الشقيّة المُراوغة

300
00:18:29,730 --> 00:18:31,540
هل أنتُن بخير يا أخواتي؟

301
00:18:31,540 --> 00:18:33,400
!ماتسو! اهربي

302
00:18:33,400 --> 00:18:35,210
!إنّهما مقاتلتان من مسافات بعيدة

303
00:18:35,210 --> 00:18:37,300
هذا لا يلائم أسلوبنا

304
00:18:37,300 --> 00:18:38,040
!حسناً

305
00:18:39,980 --> 00:18:41,310
!لن أسمح لها بالهرب

306
00:18:41,680 --> 00:18:43,570
!الوردة الثّاقبة

307
00:18:47,990 --> 00:18:50,950
الوحوش هي مخلوقات غير مرنة في العادة

308
00:18:50,950 --> 00:18:55,200
هذا لأنّها مُصمّمة بهدف واحد فقط

309
00:18:55,200 --> 00:18:59,830
لكن الآنسة كورويتسو تمنح وحوشها
،مساحة أكبر في تصميمها

310
00:18:59,830 --> 00:19:02,050
ما يعطي تنوّعاً أكبر

311
00:19:02,280 --> 00:19:05,430
—ولذلك، حيرتي

312
00:19:05,430 --> 00:19:08,760
—أجل، حيرتي، متبوعة بقدرتي على اتّخاذ القرار

313
00:19:08,760 --> 00:19:10,600
قد تكون شيئاً أنا مَدين لها به

314
00:19:10,970 --> 00:19:13,690
إن صحَّ ذلك، فكلّ ما أحتاج فعله إذاً

315
00:19:13,690 --> 00:19:16,090
!هو اختيار طريقي واتّباعه

316
00:19:23,080 --> 00:19:24,530
ماتسو! هل أنتِ بخير؟

317
00:19:24,530 --> 00:19:25,590
!استيقظي

318
00:19:27,230 --> 00:19:29,560
!حسناً! لنقضِ عليها

319
00:19:38,600 --> 00:19:40,100
ما هذا الشّيء؟

320
00:19:40,100 --> 00:19:41,600
هذه ليست دُمية

321
00:19:41,600 --> 00:19:43,170
!إنّها وحش

322
00:19:44,110 --> 00:19:46,620
!نحن مجرّد زميلين

323
00:19:50,120 --> 00:19:51,260
!إنّه سريع

324
00:19:51,880 --> 00:19:55,370
!لن تفلت منّي أيّها الطّائر السّمين

325
00:19:58,200 --> 00:20:00,710
—الوردة الثّاقبـ

326
00:20:08,520 --> 00:20:09,400
!روز

327
00:20:12,520 --> 00:20:14,140
!هل أنتِ بخير يا روز؟

328
00:20:19,190 --> 00:20:23,150
!نظام استدعاء البرق، تفعّلي أيّتها الرّوح العظيمة

329
00:20:23,150 --> 00:20:24,130
!هذا سيّئ

330
00:20:31,520 --> 00:20:33,400
هل أنتِ بخير يا روز؟

331
00:20:39,810 --> 00:20:43,770
هل... خسرت؟

332
00:20:48,050 --> 00:20:49,200
...روز

333
00:20:53,360 --> 00:20:56,800
!لماذا يمتلك هذا الطائر الضّخم الغريب حركة كهذه؟

334
00:20:56,800 --> 00:20:58,620
!هذا مستحيل

335
00:21:02,700 --> 00:21:03,880
ستكونين بخير

336
00:21:03,880 --> 00:21:05,740
أنتِ قويّة يا روز

337
00:21:06,060 --> 00:21:10,350
فشلتِ في هذه المرّة، لكن
ما زلتُ أؤمن بقوّتك

338
00:21:12,130 --> 00:21:13,970
!يوتو

339
00:21:14,410 --> 00:21:16,010
أنا آسفة يا يوتو

340
00:21:16,010 --> 00:21:18,210
...لو كنتُ أكثر حذراً وحسب

341
00:21:18,210 --> 00:21:20,470
يسرّني أنّكِ بخير فحسب يا روز

342
00:21:20,470 --> 00:21:24,930
لكن هلّا توقّفتِ عن مناداتي باسمي
الحقيقي أثناء تحوّلي؟

343
00:22:59,910 --> 00:23:03,510
هل تودّ أن تشاركني وجبة يا سيّد كانون؟

344
00:23:03,510 --> 00:23:05,520
!أعددتُ غداءً

345
00:23:07,530 --> 00:23:10,130
!استيقظت ماتسو باكراً حقّاً لإعداد هذا

346
00:23:10,130 --> 00:23:13,450
!ستكون غبيّاً ساذجاً إذا رفضتَ إهداءها

347
00:23:13,450 --> 00:23:15,790
أنت رجل بما يكفي لتفهم ذلك، صحيح؟

348
00:23:15,790 --> 00:23:19,030
!لا تقلق! كلّها أشياء طبيعيّة صدّقني

349
00:23:20,130 --> 00:23:24,190
أعتقد أنّ هذا طريقاً آخراً اخترتُه

350
00:23:27,540 --> 00:23:28,310
،الحلقة القادمة

351
00:23:28,310 --> 00:23:32,900
"روح شيطان تشرب حتّى الغيبوبة"