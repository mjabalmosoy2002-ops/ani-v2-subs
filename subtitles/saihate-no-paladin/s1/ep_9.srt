1
00:00:01,980 --> 00:00:04,310
!وصلنا إلى وايتسيلز

2
00:00:04,310 --> 00:00:06,150
.لم آتِ إلى هنا منذ مدّةٍ طويلة

3
00:00:06,570 --> 00:00:07,490
ويل؟

4
00:00:09,720 --> 00:00:11,140
...إنها مذهلة

5
00:01:44,970 --> 00:01:47,600
ليس هناك تفتيشٌ أو تعرفةٌ عند الدخول؟

6
00:01:47,600 --> 00:01:48,920
.هذا صحيح

7
00:01:48,920 --> 00:01:52,410
.إنها سياسة صاحب الفخامة إثيل حاكم المدينة

8
00:01:52,410 --> 00:01:55,950
،تدخل البضائع إلى هذه المدينة عن طريق السفن بكميات هائلة

9
00:01:55,950 --> 00:02:00,300
.ومن ثم تُوزّع في جميع أنحاء ساوثمارك عن طريق برّاً وبحراً

10
00:02:00,300 --> 00:02:04,280
ألا يعني ذلك مرور كمية هائلة من البضائع من هنا؟

11
00:02:04,280 --> 00:02:06,840
،نعم ، وإذا فُتِّشت كلّها عند البوابة

12
00:02:06,840 --> 00:02:09,810
،فستصبح مرتعاً لتهريب البضائع والبشر

13
00:02:09,810 --> 00:02:11,060
...فهمت

14
00:02:11,060 --> 00:02:13,600
لذا فرض إيثيل رسوماً لرسوّ السفن ورسوماً للإيجار

15
00:02:13,600 --> 00:02:17,360
،للشركات التي تُقيم متاجراً هنا لجني الأموال للمدينة

16
00:02:17,360 --> 00:02:21,700
.حفاظاً على جعل حركة الناس والبضائع غير مقيّدةٍ قدر الإمكان

17
00:02:23,300 --> 00:02:26,940
.يبدو أن الاقتصاد هو أقصى أولوياتهم

18
00:02:26,940 --> 00:02:29,780
.إنها مدينةٌ متقدّمةٌ جدّاً، وتتمتّع بحريّةٍ حقيقيّة

19
00:02:30,370 --> 00:02:33,100
!يكفي كلاماً عن كلّ تلك الأمور المملّة

20
00:02:33,100 --> 00:02:35,520
!إنها أوّل زيارةً لـويل إلى هنا! دعونا نستمتع

21
00:02:35,520 --> 00:02:37,010
!هيّا، من هذا الطريق

22
00:02:39,430 --> 00:02:42,900
،هذا أكبر سوقٍ في المدينة يا ويل

23
00:02:42,900 --> 00:02:44,880
...مذهل... الناس

24
00:02:44,880 --> 00:02:46,270
لمَ هذا مفاجئٌ لك؟

25
00:02:46,270 --> 00:02:47,890
!هناك

26
00:02:47,890 --> 00:02:51,310
!انظر! هذه الأكسسوارات رائجةٌ الآن

27
00:02:51,310 --> 00:02:52,380
رائجة؟

28
00:02:52,380 --> 00:02:53,820
!أجل

29
00:02:53,820 --> 00:02:55,890
!هناك أشياءٌ "رائجةٌ" هنا؟

30
00:02:54,240 --> 00:02:55,890
هل هذا الحجر قيمته كبيرة؟

31
00:02:55,890 --> 00:02:58,110
...بجديّة يا مينيل

32
00:02:55,890 --> 00:02:59,930
!هذا يعني أن هؤلاء الناس يتمتّعون برفاهيّةٍ كافيةٍ للتفكير بالموضة

33
00:03:01,220 --> 00:03:04,450
،إنها صدمةٌ تلوى الأخرى

34
00:03:05,600 --> 00:03:06,700
...أهذا

35
00:03:06,700 --> 00:03:08,170
.ضوء شارع

36
00:03:08,170 --> 00:03:09,060
!ضوء شارع؟

37
00:03:09,060 --> 00:03:10,550
ألا تعرف ما هذه؟

38
00:03:10,550 --> 00:03:12,780
!بجديّة، أنتَ متخلّفٌ جدّاً

39
00:03:12,780 --> 00:03:15,320
المتدرّبون من أكاديمية الحكماء

40
00:03:15,320 --> 00:03:17,840
يأتون في العشيّة لإشعال الأعمدة

41
00:03:17,840 --> 00:03:21,090
.التي نُقشت عليها كلماتٌ من نور

42
00:03:21,090 --> 00:03:23,730
!لكي يحظى الناس هنا بالضوء حتّى في الليل

43
00:03:23,730 --> 00:03:26,230
،إنه بمثابة تدريبٍ للسحرة المبتدئين

44
00:03:26,230 --> 00:03:29,390
.كما أنهم يجنون القليل من المال أيضاً

45
00:03:29,390 --> 00:03:34,140
.ذلك الذي هناك أيضاً مصدرٌ كبيرٌ من الدخل للسحرة المبتدئين

46
00:03:34,140 --> 00:03:35,240
ما ذلك؟

47
00:03:36,060 --> 00:03:38,960
!حتّى أنتَ يجب أن تعرف ما يكون

48
00:03:39,350 --> 00:03:42,120
!إنه الحَمّام العام بالنيا

49
00:03:42,120 --> 00:03:43,470
بالنيا؟

50
00:03:45,180 --> 00:03:46,080
ماذا هناك؟

51
00:03:46,080 --> 00:03:49,030
!حمّامٌ عام؟ لديهم حمّامات؟

52
00:03:50,790 --> 00:03:53,710
.الماء نظيفٌ للغاية، يمكنكَ الرؤية من خلاله

53
00:03:53,710 --> 00:03:57,130
.أجل، هذا تأثير كلمات التطهير

54
00:03:57,470 --> 00:04:00,420
،عوضاً عن الكمّيات الهائلة المتطلّبة لتسخين الحمّامات

55
00:04:00,420 --> 00:04:02,670
.يستخدمون كلمات الحرارة

56
00:04:02,670 --> 00:04:04,000
.فهمت

57
00:04:04,000 --> 00:04:08,430
،إذاً إنه ساونا مع مسبح ماءٍ بارد أكثر من كونه حمّام

58
00:04:08,430 --> 00:04:09,890
!لكنه ما زال مذهلاً

59
00:04:13,890 --> 00:04:15,950
.النسيم عليلٌ أيضاً

60
00:04:16,280 --> 00:04:20,550
،استخدمتُ كلمات تطهير للحفاظ على النظافة على الطريق

61
00:04:20,550 --> 00:04:23,180
.لكن من الرائع وجود حمّاماتٍ حقيقيّة

62
00:04:23,780 --> 00:04:26,710
.الاستحمام بعد وقتٍ طويلٍ منعشُ للغاية

63
00:04:26,710 --> 00:04:27,870
.هذا أكيد

64
00:04:27,870 --> 00:04:30,680
.آمل ألا تسوء الأمور الآن

65
00:04:31,130 --> 00:04:32,660
ما الذي سنفعله تالياً؟

66
00:04:33,600 --> 00:04:35,340
...التالي هو

67
00:04:36,690 --> 00:04:40,330
!دائماً ما أجوع بعد الاستحمام

68
00:04:41,710 --> 00:04:44,510
لا بدّ أنكما كنتما تتضوّران جوعاً، صحيح؟

69
00:04:44,510 --> 00:04:46,290
.الطعام لذيذٌ للغاية

70
00:04:46,290 --> 00:04:47,440
.أجل

71
00:04:47,440 --> 00:04:50,640
.لكنّي أعتقد أنه يحتاج للمرق أكثر قليلاً

72
00:04:50,640 --> 00:04:53,160
،لقد امتصّت نكهة السمك جيّداً

73
00:04:53,160 --> 00:04:54,650
.والملوحة مناسبةٌ تماماً

74
00:04:54,900 --> 00:04:57,770
!لم آكل أيّ شيءٍ كهذا منذ أن غادرتُ المعبد

75
00:04:57,770 --> 00:05:00,670
!مذاقه... حضاري

76
00:05:02,870 --> 00:05:04,290
،كلّ شيءٍ شهي

77
00:05:04,290 --> 00:05:07,090
.لدرجة أنّا نسينا محادثتنا

78
00:05:10,290 --> 00:05:11,610
!هذا لذيذٌ أيضاً

79
00:05:11,610 --> 00:05:13,470
هلّ سكبتِ لي كأساً آخر؟

80
00:05:13,470 --> 00:05:14,700
!أنا أيضاً

81
00:05:14,700 --> 00:05:16,160
،في الحال

82
00:05:16,160 --> 00:05:19,180
.عندما ننتهي من الأكل، سنتوجّه إلى المعبد

83
00:05:19,180 --> 00:05:22,680
بما أنكَ كاهنٌ يا ويل، فيجب أن تقدّم احترامك، صحيح؟

84
00:05:22,680 --> 00:05:24,870
.أجل، أنتَ محق

85
00:05:27,570 --> 00:05:28,540
...مذهل

86
00:05:28,890 --> 00:05:30,630
.أنفقوا الكثير من المال على هذا

87
00:05:30,630 --> 00:05:32,710
...بجديّة يا مينيل

88
00:05:32,710 --> 00:05:34,770
.سأعود حالما أنتهي

89
00:05:34,770 --> 00:05:36,380
.انتظروا هنا قليلاً من فضلكم

90
00:05:39,230 --> 00:05:42,100
هل المعابد في المدينة دائماً ما تكون كبيرةً هكذا؟

91
00:05:42,100 --> 00:05:45,070
.تبدو جميعها وكأنها أعمالٌ فنيّة

92
00:05:45,070 --> 00:05:47,350
.وكأنها وجهةٌ سياحيّة

93
00:05:48,130 --> 00:05:49,810
.المعذرة

94
00:05:49,810 --> 00:05:51,640
نعم، كيف يمكنني مساعدتك؟

95
00:05:51,640 --> 00:05:54,580
هل يوجد كاهنٌ رفيع المرتبة هنا؟

96
00:05:54,580 --> 00:05:57,460
،تلقّيتُ حمايةً إلهيّة وأصبحتُ كاهناً

97
00:05:57,460 --> 00:05:59,020
.لذا أردتُ تقديم احترامي

98
00:05:59,020 --> 00:06:03,010
المعذرة على السؤال، لكن أيّ إلهٍ تخدمه؟

99
00:06:03,010 --> 00:06:05,600
.غريسفيل، إلهة النور

100
00:06:06,030 --> 00:06:09,810
...إلهة النور؟ هذه مشكلة

101
00:06:09,810 --> 00:06:11,010
لماذا؟

102
00:06:11,010 --> 00:06:13,230
،كهنة إلهة النور نادرون جدّاً

103
00:06:13,230 --> 00:06:16,730
.لذا تُلزمني القواعد استخدام صلاة كشف الإيمان

104
00:06:16,730 --> 00:06:18,470
.حسناً، لا بأس

105
00:06:18,820 --> 00:06:20,580
.أعتقد أن هذا طبيعي

106
00:06:20,580 --> 00:06:23,080
من المحتّم أن يشكّ الناس

107
00:06:23,080 --> 00:06:24,760
.بكاهنٍ يخدم إلهاً ثانويّاً

108
00:06:24,760 --> 00:06:27,530
.قد أكون كاهناً لإلهٍ شرّيرٍ متنكّر

109
00:06:27,860 --> 00:06:31,310
في الواقع... كلّ الأشخاص الذين يمتلكون حمايةً إلهيّة

110
00:06:31,310 --> 00:06:34,940
.تؤهّلهم لتحديد إيمان الآخرين موجودون في الخارج الآن

111
00:06:34,940 --> 00:06:36,470
جميعهم في الخارج؟

112
00:06:36,470 --> 00:06:41,370
.أجل. ازدادت هجمات الوحوش الشيطانيّة في كلّ مكانٍ مؤخّراً

113
00:06:41,370 --> 00:06:44,960
.جميعهم باستثناء الأسقف النائب مشغولون جدّاً الآن

114
00:06:44,960 --> 00:06:46,030
النائب...؟

115
00:06:46,030 --> 00:06:48,750
ما الذي تفعله في وسط الممر؟

116
00:06:48,750 --> 00:06:50,290
!الأسقف باغلي

117
00:06:50,550 --> 00:06:52,760
!سألتُكَ ما الذي تفعله

118
00:06:52,760 --> 00:06:54,790
...في الواقع... أ-أنا

119
00:06:54,790 --> 00:06:56,570
.يشرّفني الالتقاء بك

120
00:06:56,570 --> 00:06:59,180
!اسمي ويليام ج. ماريبلود

121
00:06:59,530 --> 00:07:03,040
،اكتسبتُ الحماية الإلهية لـغريسفيل، إلهة النور

122
00:07:03,040 --> 00:07:06,430
.وأتيتُ إلى معبد وايتسيلز لأقدّم احترامي

123
00:07:09,280 --> 00:07:12,700
،بارت باغلي، المسؤول عن هذا المعبد

124
00:07:12,700 --> 00:07:14,480
...غريسفيل

125
00:07:14,480 --> 00:07:17,930
إلهة النور، الإلهة التي كانت مفقودة؟

126
00:07:17,930 --> 00:07:21,400
وكيف لي أن أعرف أنّكَ لستَ شخصاً مريباً يستخدم اسمها

127
00:07:21,400 --> 00:07:23,570
من أجل مؤامرةٍ خبيثة؟

128
00:07:23,570 --> 00:07:25,880
.لديكَ كلّ الحق في التشكيك

129
00:07:25,880 --> 00:07:28,500
أهناك أيّ شيءٍ يمكنني مباركته لأثبتَ نفسي؟

130
00:07:28,500 --> 00:07:32,770
!أنتم المبتدؤون سريعون للغاية في الاعتماد على حمايتكم الإلهيّة

131
00:07:33,220 --> 00:07:38,110
،اسمعني، ليست الحماية الإلهية شيئاً يُستخدم بهذا الاستخفاف

132
00:07:38,110 --> 00:07:40,470
.ولا هي شيءٌ يُستخدم للتباهي

133
00:07:41,690 --> 00:07:43,110
.معه حق

134
00:07:43,110 --> 00:07:46,040
.قال غاس نفس الشيء عن استخدام السحر

135
00:07:46,040 --> 00:07:49,500
...كنتُ أستخدم بركتي من دون اهتمام بما أنها تشكّل مخاطرةً صغيرة، ولكن

136
00:07:50,360 --> 00:07:52,310
.أنتَ محقٌ بالطبع

137
00:07:52,310 --> 00:07:55,340
...أشكركَ حقّاً لتذكيري بقلّة خبـ

138
00:07:56,070 --> 00:07:59,440
ما هي تعاليم إلهة النور بالنسبة لك؟

139
00:07:59,740 --> 00:08:01,670
،لا يتواجد النور إلا حيث يتواجد الظلام

140
00:08:01,670 --> 00:08:03,730
،لا تتواجد الكلمات إلا حيث يتواجد الصمت

141
00:08:03,730 --> 00:08:06,460
.ولا تتواجد الحياة إلا حيث يتواجد الموت

142
00:08:08,470 --> 00:08:12,330
.أنتَ. دوّن اسمه في السجل وأطلعه على أرجاء المعبد

143
00:08:12,330 --> 00:08:13,100
ماذا؟

144
00:08:13,100 --> 00:08:17,100
...لكنّنا لم نُجرِ صلاة كشف الإيمان أو صلاة كشف الكذب

145
00:08:17,100 --> 00:08:17,750
!أحمق

146
00:08:17,750 --> 00:08:20,220
!ما الذي قلتُه للتوّ أيها الأبله؟

147
00:08:20,510 --> 00:08:24,850
.يجب أن أحضر في مأدبة نقابة الحائكين

148
00:08:24,850 --> 00:08:28,270
.اقضِ وقتك كما تشاء، لكن لا تتسبّب بأيّ مشكلة

149
00:08:28,270 --> 00:08:30,610
.وتبرّع ببعض المال

150
00:08:31,950 --> 00:08:34,360
.حـ-حسناً إذاً، من هذا الطريق

151
00:08:34,360 --> 00:08:35,440
.حـ-حسناً

152
00:08:36,400 --> 00:08:40,910
.يا لسوء حظّكَ لأنكَ التقيتَ بالأسقف باغلي

153
00:08:40,910 --> 00:08:42,900
.لكنكَ تدبّرتَ أمركَ بعناية

154
00:08:43,700 --> 00:08:47,840
.حسناً، يفقد رئيس المعبد السيطرة على نفسه في الحفلات والملذات

155
00:08:47,840 --> 00:08:49,670
.إنه سريع الغضب والشكوى على الدوام

156
00:08:49,670 --> 00:08:52,530
.رغم كلّ ما يقوله، إنه لا يستخدم بركته إطلاقاً

157
00:08:52,850 --> 00:08:56,340
.نائب الأسقف من الناحية الأخرى، شخصٌ رائعٌ وفاضل

158
00:08:56,340 --> 00:08:56,920
...المعذرة

159
00:08:58,020 --> 00:09:00,680
!آسف! لا تخبر أحداً أنّي قلتُ ذلك

160
00:09:00,680 --> 00:09:01,660
...بالطبع

161
00:09:02,760 --> 00:09:05,680
ماذا تعرفان عن رئيس المعبد؟

162
00:09:05,680 --> 00:09:09,180
.لم أسمع عنه الكثير من الأشياء الجيّدة

163
00:09:09,180 --> 00:09:10,720
.يُقال أنه خشن التعامل

164
00:09:10,720 --> 00:09:12,900
يبدو أن له بعض النفوذ من وراء الكواليس

165
00:09:12,900 --> 00:09:16,080
.في نقابات المدينة التجاريّة والصناعيّة كذلك

166
00:09:16,310 --> 00:09:18,520
هكذا ينظر الناس إليه إذاً؟

167
00:09:18,520 --> 00:09:20,560
!رغم ذلك، بالحديث عن الملذات

168
00:09:20,560 --> 00:09:23,090
!لا أصدّق أنه سمح لنا باستخدام غرفة ضيوف المعبد

169
00:09:23,090 --> 00:09:24,700
!واثنتين منها أيضاً

170
00:09:24,700 --> 00:09:27,080
على أيّ حال، ماذا سنفعل تالياً؟

171
00:09:27,080 --> 00:09:30,250
...يمكننا الاستمتاع بالمناظر، أو زيارة بعض النقابات

172
00:09:30,250 --> 00:09:33,190
...إذا كنّا سنفعل ذلك، فأقترح أن

173
00:09:33,190 --> 00:09:35,420
.مهلاً. شيءٌ ما يجري في الخارج

174
00:09:35,420 --> 00:09:37,850
...هذا ليس الجرس الذي يُعلمنا بالوقت الذي يقرعونه

175
00:09:37,850 --> 00:09:39,160
أهناك حريقٌ أو ما شابه؟

176
00:09:39,160 --> 00:09:41,420
.إنه إنذار طوارئ

177
00:09:41,760 --> 00:09:44,110
!إنه وايفرن! اهربوا جميعاً

178
00:09:44,110 --> 00:09:45,000
ماذا؟

179
00:10:01,430 --> 00:10:03,570
!تحرّكوا! استعدّوا لأيّ شيء

180
00:10:03,570 --> 00:10:06,280
!فليأتي أحدٌ لمساعدتنا! شخصٌ عالقٌ تحت الأنقاض

181
00:10:06,280 --> 00:10:07,920
!مؤلم

182
00:10:07,920 --> 00:10:09,350
!ما الذي يجري؟

183
00:10:08,300 --> 00:10:10,080
!لا تتدافعوا! توقّفوا عن التدافع رجاءً

184
00:10:10,080 --> 00:10:11,950
!هل رأى أحدٌ طفلي؟

185
00:10:11,950 --> 00:10:13,250
...أيتها الآلهة

186
00:10:21,560 --> 00:10:23,720
!ويل، انتظر يا ويل

187
00:10:30,200 --> 00:10:31,930
لماذا يوجد وايفرن هنا

188
00:10:33,930 --> 00:10:34,950
!أطلقوا

189
00:10:37,360 --> 00:10:40,540
...لقد قال إن كلّ رجال الدين أصحاب المرتبة الرفيعة في الخارج الآن

190
00:10:46,150 --> 00:10:48,530
...حضارتهم... مدينتهم

191
00:10:48,950 --> 00:10:51,230
...كلّ شيءٍ حماه أولئك الثلاثة

192
00:10:51,230 --> 00:10:53,540
...المكان الذي يستطيع الناس العيش فيه بحريّة

193
00:10:56,560 --> 00:10:57,380
!فيربا

194
00:10:57,380 --> 00:10:58,210
!فولانتو

195
00:10:58,210 --> 00:10:59,400
!تونيتروس

196
00:11:01,100 --> 00:11:02,280
!أخطأت

197
00:11:02,590 --> 00:11:06,590
!لكن هذه أبعد كلماتٍ يمكنني استخدامها

198
00:11:06,840 --> 00:11:09,590
!إذاً يجب أن أستمرّ في الإطلاق حتّى أصيبه

199
00:11:09,590 --> 00:11:11,660
!أيها الغبي! ما الذي تفعله؟

200
00:11:11,660 --> 00:11:14,920
!لماذا تطلق مثل هذا السحر الرفيع وأنتَ حالة غضبٍ شديد؟

201
00:11:14,920 --> 00:11:16,070
!ستَقتل نفسك

202
00:11:16,070 --> 00:11:16,720
...لكن

203
00:11:16,720 --> 00:11:17,560
!من دون لكن

204
00:11:17,560 --> 00:11:21,110
!أنتَ تقاتل وايفرن! أقول لك أن تكون اكثر كفاءةً

205
00:11:21,110 --> 00:11:23,690
!تمتلك ذكاءً، لذا استخدمه أيها الأحمق

206
00:11:23,690 --> 00:11:25,340
!لا تتسرّع

207
00:11:25,700 --> 00:11:31,030
.ستبدأ بتعلّم كيفيّة استخدام سحرٍ ثانوي بمهارةٍ ودقّة

208
00:11:32,620 --> 00:11:33,770
.صحيح

209
00:11:33,770 --> 00:11:34,790
.جيّد

210
00:11:35,160 --> 00:11:39,700
فكّر، ماذا يمكنني أن أفعل حيال هذا الوايفرن باستخدام ما أعرفه؟

211
00:11:41,310 --> 00:11:43,440
هلّا ساعدتني يا مينيل؟

212
00:11:43,440 --> 00:11:45,460
.أحتاجكَ أنتَ وجنّياتك

213
00:11:45,460 --> 00:11:46,190
.بالطبع

214
00:11:46,900 --> 00:11:48,400
!بي، طونيو

215
00:11:48,400 --> 00:11:52,610
!اعملوا مع الناس القريبين لإخراج الجميع من الحديقة الأماميّة للمعبد

216
00:11:52,610 --> 00:11:54,760
!سأجلب الوايفرن إلى الأسفل هناك

217
00:11:54,760 --> 00:11:55,690
!صاحب الفخامة

218
00:11:55,690 --> 00:11:57,910
!يجب أن تحتمي في الأسفل بسرعة

219
00:11:57,910 --> 00:11:59,440
كيف حدث هذا؟

220
00:11:59,440 --> 00:12:02,790
.عشرات الأشخاص... مئات الأشخاص... سيموتون

221
00:12:04,360 --> 00:12:05,940
...حسناً إذاً

222
00:12:05,940 --> 00:12:09,000
.أيتها الشيلف، أيتها الشيلف، يا عذارى الرياح

223
00:12:09,000 --> 00:12:11,170
.خطواتكِ هي خطوات الرياح

224
00:12:11,170 --> 00:12:13,020
.أغنيتكِ هي أغنية الرياح

225
00:12:13,450 --> 00:12:16,930
.غنّي في جوقة، غنّي في مجموعات، اهتفي وصفّقي

226
00:12:17,320 --> 00:12:21,640
.ستنشر نغماتكِ كلمات الأصل في عشرة اتجاهات

227
00:12:21,890 --> 00:12:22,780
.فيربا

228
00:12:22,780 --> 00:12:23,770
.فولانتو

229
00:12:23,770 --> 00:12:24,830
كونكيليات

230
00:12:24,830 --> 00:12:25,630
.سيكيتور

231
00:12:25,890 --> 00:12:26,870
...تونيتروس

232
00:12:26,870 --> 00:12:27,770
!أرانيوم

233
00:12:37,820 --> 00:12:40,140
أذلك... سحر؟

234
00:12:40,140 --> 00:12:43,260
!هناك مستخدم جنّياتٍ أيضاً؟ يا لنا من محظوظين

235
00:12:43,260 --> 00:12:45,520
!يمكننا فعلها! نستطيع فعلها! أسرعوا

236
00:12:50,290 --> 00:12:52,380
.أنا لا أصيبه بجروحٍ بليغةٍ على الأرجح

237
00:12:54,600 --> 00:12:55,650
.لكن لا بأس

238
00:12:56,060 --> 00:12:58,620
.طالما يتعرّف علينا الوايفرن كأعداءٍ له

239
00:12:58,620 --> 00:13:01,550
.تقريباً كلّ الوحوش من هذا النوع عدوانيون جدّاً

240
00:13:01,550 --> 00:13:03,650
،حتّى في الظروف التي تسمح لهم بالهروب

241
00:13:03,650 --> 00:13:05,530
.سيختارون الهجوم على ذلك

242
00:13:05,840 --> 00:13:06,750
.ها هو قادم

243
00:13:06,750 --> 00:13:07,390
.صحيح

244
00:13:09,230 --> 00:13:14,470
.يعتمد الباقي على مدى اقتراب مستوى مهاراتي من مستوى مهاراتهم

245
00:13:14,910 --> 00:13:18,440
.يا إلهتي، أقاتل الآن من أجل قسمي

246
00:13:18,440 --> 00:13:21,760
.لدحر الشر وإنقاذ المعذّبين

247
00:13:21,760 --> 00:13:23,850
!صلِّ! صلِّ

248
00:13:23,850 --> 00:13:25,860
!كن صلباً لا تُكسر

249
00:13:25,860 --> 00:13:28,460
...إلى الأبد... إلى أبد الآبدين

250
00:13:29,160 --> 00:13:31,200
!ارفض كلّ ما هو شرّير

251
00:13:31,200 --> 00:13:33,780
!على نار غريسفيل

252
00:13:43,660 --> 00:13:45,560
!ما ذلك بالضبط؟

253
00:13:51,310 --> 00:13:54,820
!أيتها الشيلف! يا عذارى الرياح الحسناوات، أيتها الراقصات في العاصفة

254
00:13:54,820 --> 00:13:57,810
أظهرن لأولئك الحمقى بما يكفي ليتوهّموا أنفسهم

255
00:13:57,810 --> 00:14:00,100
!راقصين أمهر من مذاق الأرض المرير

256
00:14:05,280 --> 00:14:06,310
!ليغاتور

257
00:14:06,310 --> 00:14:07,030
!نودوس

258
00:14:07,030 --> 00:14:08,470
!أوبليغاتو

259
00:14:11,000 --> 00:14:12,130
!إنها قيود

260
00:14:12,130 --> 00:14:15,300
!لا، إنه يحاول تمزيقها! تبّاً، إنه قوي

261
00:14:15,900 --> 00:14:17,210
!أكسيلراتيو

262
00:14:20,790 --> 00:14:22,000
!مرحى

263
00:14:25,290 --> 00:14:26,590
...مستحيل

264
00:14:26,910 --> 00:14:28,470
!ذلك لم يُنهِ أمره؟

265
00:14:29,420 --> 00:14:31,380
!اهربوا! سيستخدم نفثه

266
00:14:31,700 --> 00:14:33,520
.ما زال يوجد أناسٌ في الخلف هناك

267
00:14:33,520 --> 00:14:35,890
!ماذا أفعل؟ ماذا يمكنني أن أفعل؟

268
00:14:38,440 --> 00:14:39,400
!اقضِ عليه

269
00:14:40,000 --> 00:14:41,220
!أكسيلراتيو

270
00:14:44,610 --> 00:14:46,440
!إذا كنتَ لا تعلم، فاستخدم عضلاتك

271
00:14:46,440 --> 00:14:48,990
!كن عنيفاً، اقضِ عليه

272
00:14:56,740 --> 00:14:57,870
!ر-رمية عنق؟

273
00:15:01,880 --> 00:15:03,530
!لن تهرب

274
00:15:06,620 --> 00:15:11,560
!لن تؤذي أنيابكَ ومخالبكَ أحداً

275
00:15:29,780 --> 00:15:32,150
!أحسنت! عملٌ ممتاز

276
00:15:32,150 --> 00:15:38,160
!أشكر كلّ الآلهة على السماح لي بخدمة بطلٍ مثلك

277
00:15:38,160 --> 00:15:42,790
!إنه ميلاد قاتل وايفرن جديد! بطلٌ جديدٌ تماماً

278
00:15:42,790 --> 00:15:45,420
!أثنوا عليه بتصفيقكم

279
00:15:49,620 --> 00:15:53,960
!شكراً لك

280
00:15:57,690 --> 00:15:59,630
أعتقد أنّنا تأخّرنا جدّاً، أليس كذلك؟

281
00:16:00,220 --> 00:16:02,770
رغم ذلك، لم أكن أعلم أن العديد من مستخدمي السحر

282
00:16:02,770 --> 00:16:05,980
!ومحاربٌ قويٌّ بما يكفي لقتل وايفرن متواجدون هنا

283
00:16:05,980 --> 00:16:08,030
!إنها عنايةٌ إلهيّةٌ حقّاً

284
00:16:15,340 --> 00:16:18,050
أعتقد أنّكَ تنجح بكلّ شيءٍ حقّاً، أليس كذلك؟

285
00:16:18,050 --> 00:16:19,210
أأنتَ متفاجئ؟

286
00:16:19,210 --> 00:16:21,180
.أنا معتادٌ على الطريقة التي تتحدّى فيها المنطق

287
00:16:22,940 --> 00:16:26,310
.لقد تذكّرتُ كم أفتقد للخبرة

288
00:16:26,310 --> 00:16:26,800
ماذا؟

289
00:16:26,800 --> 00:16:29,000
،كان ذلك عظيماً كمحاولةٍ أولى

290
00:16:29,000 --> 00:16:31,180
.لكنّي كنتُ محظوظاً فحسب لتوجيه ضربةٍ مفاجئة

291
00:16:31,180 --> 00:16:34,330
وماذا كان ذلك الدخّان الأسود المحيط به؟

292
00:16:34,330 --> 00:16:35,000
!أنت

293
00:16:35,000 --> 00:16:36,850
!أسقطتَ وحشاً حقيقيّاً

294
00:16:36,850 --> 00:16:39,130
.انتقد نفسكَ كما تشاء، لكن كن سعيداً قليلاً على الأقل

295
00:16:39,130 --> 00:16:41,430
.من الصعب أن أكون سعيداً إذا لم تكن أنتَ كذلك

296
00:16:41,860 --> 00:16:42,690
.حسناً

297
00:16:43,350 --> 00:16:44,970
...عندما يصوغ الأمر بتلك الطريقة

298
00:16:44,970 --> 00:16:46,840
،هناك الكثير من الأمور التي كان بإمكاني فعلها بشكلٍ أفضل

299
00:16:46,840 --> 00:16:49,520
.لكنّي الآن قاتل وايفرت مثل ثلاثتهم

300
00:16:49,910 --> 00:16:51,970
.هذا يجعلني سعيداً

301
00:16:52,190 --> 00:16:53,880
.نعم... نعم

302
00:16:53,880 --> 00:16:56,940
!شكراً يا مينيل! أدين لكَ بالكثير

303
00:16:56,940 --> 00:16:58,790
.أجل. لقد فعلناها يا صاح

304
00:17:00,280 --> 00:17:04,170
!وأيضاً، تعلم تماماً أن ذلكَ كلّه كان من فعلكَ لوحدكَ تقريباً أيها الغبي

305
00:17:05,870 --> 00:17:07,370
!قاتل الوايفرن

306
00:17:08,190 --> 00:17:10,480
هذا أنا! ماذا تحتاج؟

307
00:17:10,480 --> 00:17:12,380
!تعال معي بسرعةٍ من فضلك

308
00:17:13,790 --> 00:17:17,600
.يريد وليّ العهد رؤيتك

309
00:17:18,720 --> 00:17:22,240
.أهلاً بكَ في قصري أيها البطل

310
00:17:22,590 --> 00:17:27,730
،إذاً هذا هو وليّ العهد لمملكة فارتايل، حاكم وايتسيلز

311
00:17:27,730 --> 00:17:29,800
...وحاكم ساوثمارك

312
00:17:31,400 --> 00:17:35,730
.إنه لشرفٌ أعظم ممّا أستحق لأقف أمام حضرة فخامتك

313
00:17:35,730 --> 00:17:38,630
.أتيتُ إلى هنا بناءً على طلبك

314
00:17:38,630 --> 00:17:41,020
.اسمي هو ويليام ج. ماريبلود

315
00:17:41,020 --> 00:17:44,290
.ماذا؟ أنتَ ضليعٌ في آداب السلوك القديمة

316
00:17:44,290 --> 00:17:46,370
أفترض أنكَ ذو نسبٍ رفيع؟

317
00:17:46,370 --> 00:17:48,180
...كلا

318
00:17:48,180 --> 00:17:51,330
...حبّذا لو بإمكان فخامتكَ الامتناع عن السؤال عن أصولي

319
00:17:52,370 --> 00:17:55,470
.لديكَ ظروفك، أتفهّم ذلك إذاً

320
00:17:57,660 --> 00:17:59,400
.اجلس من فضلك

321
00:17:59,400 --> 00:18:00,290
.شكراً لك

322
00:18:14,280 --> 00:18:18,120
هناك أربعة أو خمسة أشخاصٍ في مجموعتك، أليس كذلك؟

323
00:18:18,120 --> 00:18:19,660
.أجل، نحن أربعة

324
00:18:19,660 --> 00:18:23,990
ممّا يجعلكم مستخدم سحرٍ وكاهنٍ ومستخدم جنّياتٍ ومحارب؟

325
00:18:26,240 --> 00:18:31,060
.كاهنٌ مسافر وصيّادٌ وتاجرٌ وشاعرةٌ، في الواقع

326
00:18:32,010 --> 00:18:35,780
،شخصٌ أطلق برقاً على الوايفرن وشخصٌ صنع جداراً من الضوء

327
00:18:35,780 --> 00:18:39,390
.وشخصٌ تحكّم بتيّارات الهواء وشخصٌ كسر عنقه

328
00:18:39,390 --> 00:18:40,640
صاروا أربعة أشخاص، صحيح؟

329
00:18:40,640 --> 00:18:44,550
.إذا كان ذلك ما تقصده، فنحن بالفعل شخصين منهم

330
00:18:45,250 --> 00:18:46,540
ما الذي يعنيه ذلك؟

331
00:18:46,540 --> 00:18:48,820
،صديقي الواقف هنا مينيلدور، استدعى الجنّيات

332
00:18:48,820 --> 00:18:51,560
ونشر الكلمات وتلاعب بتيّارات الهواء

333
00:18:51,560 --> 00:18:54,930
.لإسقاط الوايفرن إلى الأرض

334
00:18:54,930 --> 00:18:58,050
إنه مستخدم جنّياتٍ إذاً؟

335
00:18:58,050 --> 00:18:59,030
والباقي؟

336
00:18:59,030 --> 00:19:00,660
.كان أنا

337
00:19:03,030 --> 00:19:06,790
آسف، لكن هلّا أخبرتني ما الذي فعلتَه؟

338
00:19:09,600 --> 00:19:12,870
.استخدمتُ قوّةً خالصةً لكسر عنقه

339
00:19:12,870 --> 00:19:15,790
قتلتَ وايفرن ولا تشعر بالفخر؟

340
00:19:15,790 --> 00:19:18,380
.أنتَ محاربٌ بشجاعةٍ لا نظير لها حقّاً

341
00:19:18,380 --> 00:19:19,450
...المعذرة

342
00:19:20,330 --> 00:19:23,420
أيمكن فعل أيّ شيءٍ لإصلاح الضرر الذي تسبّبب فيه الوايفرن؟

343
00:19:23,740 --> 00:19:27,050
.بالطبع، أُنجز العمل بالفعل، والمزيد قادمٌ أيضاً

344
00:19:27,310 --> 00:19:30,760
.لكن هناك شيءٌ أكثر أهميّةٍ يجب أن يتمّ فعله

345
00:19:30,990 --> 00:19:35,420
.أجل، تقديم امتناني للبطل على سبيل المثال

346
00:19:35,420 --> 00:19:36,780
...كلا، أنا

347
00:19:36,780 --> 00:19:38,520
.لا تكن متواضعاً

348
00:19:38,520 --> 00:19:41,820
.لا أريد أن يراني شعبي كرجلٍ جاحد

349
00:19:42,890 --> 00:19:48,510
.أنا، إيثيلبالد، أشكركما نيابةً عن شعب وايتسيلز

350
00:19:49,150 --> 00:19:53,960
.أحسنتما عملاً بتقليل الأضرار الناجمة عن هجوم وايفرن مفاجئ

351
00:19:53,960 --> 00:19:56,620
.لا أستحقّ مثل هذا الإطراء

352
00:19:57,460 --> 00:20:01,550
أودّ أن أقدّم لكما مكافأة. أهناك ما تريدانه؟

353
00:20:03,900 --> 00:20:08,730
.سافرتُ إلى هنا اليوم عن طريق غابة الوحوش إلى الجنوب

354
00:20:09,090 --> 00:20:11,480
القرى في تلك المنطقة تحت الخطر حاليّاً

355
00:20:11,480 --> 00:20:15,390
.من قبل جيشٍ من الشياطين يقود وحوشاً شيطانيّةً همجيّة

356
00:20:17,900 --> 00:20:19,220
...إن كان يحقّ لي أن أطلب

357
00:20:19,480 --> 00:20:21,730
فهل من الممكن لفخامتك

358
00:20:21,730 --> 00:20:24,890
أن ترسل جنوداً لاصطياد تلك الشياطين؟

359
00:20:24,890 --> 00:20:26,690
،هذا ليس مستحيلاً

360
00:20:26,690 --> 00:20:28,500
.لكنّه سيكون صعباً

361
00:20:28,500 --> 00:20:30,500
.رأيتَ ذلك الوايفرن

362
00:20:30,500 --> 00:20:32,740
وحوشٌ شيطانيّةٌ مثله تسبّبت بحوادث متكرّرة

363
00:20:32,740 --> 00:20:35,330
.ضمن أجزاء ساوثمارك التي أحكمها

364
00:20:35,330 --> 00:20:36,700
...تقصد

365
00:20:36,700 --> 00:20:39,290
.أجل، ذلك الدخّان السام

366
00:20:39,730 --> 00:20:42,710
.أيّ كائنٍ يلمسها يُفسده السمّ ويصبح همجيّاً

367
00:20:43,230 --> 00:20:45,800
أأنتَ واثقٌ أنكَ بخيرٍ بحدّ ذاتكَ يا ويليام؟

368
00:20:46,130 --> 00:20:48,380
.أنا مقاومٌ للسموم في طبيعتي

369
00:20:48,380 --> 00:20:50,020
.من الجيّد سماع ذلك

370
00:20:50,500 --> 00:20:52,310
،تحت سياسات الملك السابق

371
00:20:52,310 --> 00:20:54,390
.وسّعنا نطاقنا كثيراً

372
00:20:54,390 --> 00:20:59,270
.لا يمكننا حتّى حماية القرى التي نحكمها بشكلٍ مباشرٍ بما يكفي

373
00:20:59,580 --> 00:21:01,680
هل تفهم مقصدي؟

374
00:21:04,270 --> 00:21:07,150
إذاً... هلّا منحتني الإذن

375
00:21:07,150 --> 00:21:09,360
لاستئجار مغامرين ومرتزقةٍ من مالي الخاص

376
00:21:09,360 --> 00:21:12,030
وتنظيم جيشٍ لطرد الشياطين؟

377
00:21:14,050 --> 00:21:19,080
أتعلم ما قد يعنيه ذلك يا ويليام؟

378
00:21:19,080 --> 00:21:23,520
.أتفهّم أنّي أطلب منكَ شيئاً كبيراً

379
00:21:23,520 --> 00:21:25,670
رغم ذلكَ ما زلتَ متمسّكاً بطلبك؟

380
00:21:26,020 --> 00:21:26,770
.أجل

381
00:21:27,290 --> 00:21:28,820
.إذا لم أكن كذلك

382
00:21:28,820 --> 00:21:32,820
فكم عدد المآسي التي سنضطرّ للتغاضي عنها ببساطة؟

383
00:21:32,820 --> 00:21:37,680
.لكن إنقاذ الجميع مهمّةٌ لا تستطيع حتّى الآلهة تحقيقها

384
00:21:42,560 --> 00:21:44,180
...بجديّة

385
00:21:44,180 --> 00:21:48,540
...فقط لو كنتَ مجرّد رجلٍ نكرةٍ تطلب منّي مثل هذا الطلب

386
00:21:48,540 --> 00:21:49,940
.أنتَ محق

387
00:21:49,940 --> 00:21:52,580
،لكن، لو أنّني لم أقتل الوايفرن

388
00:21:52,580 --> 00:21:55,090
.ما كنتُ لأحظى بفرصةٍ للحديث مع فخامتك

389
00:21:55,090 --> 00:21:56,970
.هذا صحيحٌ أيضاً

390
00:21:57,300 --> 00:21:58,250
...لكن

391
00:21:59,070 --> 00:22:03,030
.يجب أن أضع خيار قتلكَ في عين الاعتبار أيضاً