1
00:00:08,210 --> 00:00:09,340
...دمار

2
00:00:09,340 --> 00:00:10,010
...خلق

3
00:00:10,550 --> 00:00:11,550
!العينان الشّيطانيّتان

4
00:00:14,550 --> 00:00:15,680
التّالي هناك، صحيح؟

5
00:01:54,820 --> 00:01:59,570
هذا غريب. ما كان ليخطّط بغزو
السّطح بهذا المستوى

6
00:01:59,950 --> 00:02:01,370
ما هو هدفه؟

7
00:02:01,370 --> 00:02:02,830
!تومو

8
00:02:07,660 --> 00:02:09,830
!تومو، لا يجوز أن تفعل ذلك

9
00:02:09,830 --> 00:02:10,790
نايا

10
00:02:11,630 --> 00:02:15,090
.قد تصبح هذه ساحة معركة
ابقي داخل القلعة

11
00:02:15,260 --> 00:02:19,050
!آ-آنوس-ساما! سـ-سامحني أرجوك

12
00:02:19,050 --> 00:02:23,510
يظلّ هذا الصّغير يحاول مغادرة القلعة
وذلك كي يلتهم التّنانين

13
00:02:34,980 --> 00:02:37,940
تـ-تومو؟ ماذا أكلت للتو؟

14
00:02:37,940 --> 00:02:39,990
توقّف التنّين الإلهيّ عن الغناء

15
00:02:39,990 --> 00:02:42,030
...بالفعل

16
00:02:42,030 --> 00:02:42,910
ماذا؟ تومو؟

17
00:02:45,370 --> 00:02:46,040
ماذا؟

18
00:02:46,450 --> 00:02:47,660
هكذا إذاً

19
00:02:48,120 --> 00:02:52,250
يبدو أنّه يستطيع اتّخاذ خصائص أي تنّين يلتهمه

20
00:02:52,250 --> 00:02:55,250
...ماذا؟ لكن لا أرى تنانين في أيّ مكان

21
00:02:55,250 --> 00:02:57,340
هل تتذكّرين ما قاله أركانا؟

22
00:02:57,920 --> 00:03:00,220
،التّنانين الإلهيّة هي تنانين الصّوت

23
00:03:00,220 --> 00:03:04,100
وغناؤها يتردّد صداه دوماً في كلّ أنحاء
البلاد منذ تأسيسها

24
00:03:04,550 --> 00:03:10,350
،لكن لا أحد يستطيع رؤيتها باستثناء البابا
والآلهة الّذين عقد ميثاقاً معهم

25
00:03:10,560 --> 00:03:14,440
،تومو، الّذي يستطيع أكل التّنانين فقط
التهمَ هذه الأغنية للتو

26
00:03:14,440 --> 00:03:15,360
...ما يعني

27
00:03:15,730 --> 00:03:18,190
أنَّ التنّين الإلهيّ هو الأغنية بحدِّ ذاتها

28
00:03:18,190 --> 00:03:21,700
وُجِد هذا البلد داخل جسد تنّين صوت

29
00:03:22,160 --> 00:03:24,990
المكان خطير في الخارج. يجدر بكِ
أن تعودي إلى قلعة ملِك الشّياطين

30
00:03:24,990 --> 00:03:26,580
!حـ-حسناً

31
00:03:43,340 --> 00:03:47,510
عقدت ميثاقاً مع إله الأطلال إذاً؟

32
00:03:47,510 --> 00:03:52,730
أجل. كلّ الباباوات قد ورثوه كحامي جيوردال

33
00:03:53,020 --> 00:03:55,730
صوت التنّين الإلهيّ هو تنّين الصّوت

34
00:03:56,190 --> 00:04:00,030
بالنّظر إلى عمق الهاوية، أرى أنّه ليس أكثر
!من دائرة سحريّة صوتيّة من الماضي

35
00:04:00,610 --> 00:04:04,950
هذا ما كان التنّين الإلهيّ يبعثه دوماً
بأمر من إله الأطلال

36
00:04:05,450 --> 00:04:09,200
كنتُم تُشغِّلون هذه الدّائرة السّحريّة
الصّوتيّة عبر العصور

37
00:04:09,580 --> 00:04:13,290
من أجل إطلاق عنان تعويذة كبرى الآن

38
00:04:13,290 --> 00:04:15,630
يسير كلّ شيء وفق تعاليم الآلهة

39
00:04:15,630 --> 00:04:20,800
مجيئك إلى هنا هو شيء غير مُسجّل
في النّصوص المُقدّسة

40
00:04:21,260 --> 00:04:22,920
تستهدف السّطح، أليس كذلك؟

41
00:04:23,260 --> 00:04:27,300
بإدخال العالم إلى رحمنا، سوف
نبنيه ثانية من الصّفر

42
00:04:27,930 --> 00:04:31,720
.مُحوِّلين تلك القبّة نحو السّماء
أي التنّين الإلهيّ

43
00:04:32,060 --> 00:04:35,100
إذاً سوف تقذف بالسّطح بعيداً؟

44
00:04:35,100 --> 00:04:40,020
أنا متأكّد بأنّك تُدرِك أزمتنا هنا
في العالم تحت الأرض

45
00:04:40,440 --> 00:04:44,530
معظم الأرض مقفرة، ولسنا مُنعمين بالمطر حتّى

46
00:04:44,530 --> 00:04:48,450
تلك القبّة هي فاصل رئيسيّ يعزل
بين السّطح وتحت الأرض

47
00:04:48,780 --> 00:04:52,200
فلِمَ لا نستخدم التنّين الإلهيّ
لجعل كلّ ما هو حيّ مُتساوٍ؟

48
00:04:52,200 --> 00:04:55,710
لإزالة كافّة الحدود، وبناء عالم خالٍ من التّمييز

49
00:04:56,040 --> 00:04:58,540
،حتّى لو كانت هذه مُساواة صحيحة

50
00:04:58,540 --> 00:05:01,710
إنّها ليست إلّا مسألة سرقة من قِبَل
طرف على حساب طرف آخر

51
00:05:01,710 --> 00:05:06,130
هل نوي أن تقيّد شعبك بدورة
ألف عام من الثّأر؟

52
00:05:07,010 --> 00:05:10,970
إذا رغبت في تغيير العالم، فالطّريقة
الوحيدة هي بفعل ذلك تدريجيّاً

53
00:05:10,970 --> 00:05:12,560
لا توجد طُرُق مختصرة

54
00:05:13,180 --> 00:05:16,690
،إذا كنتَ تسعى لتحقيق عالم مثاليّ
،فتوقّف عن الصّلاة للآلهة

55
00:05:16,690 --> 00:05:18,020
وأمسك بهذه اليد

56
00:05:18,480 --> 00:05:22,650
يجدر بك أن تتمكّن من بلوغ مستقبل أفضل
نوعاً ما من خيارك الغبيّ هذا

57
00:05:22,980 --> 00:05:28,200
اليوم هو اليوم الوحيد الّذي سيُحلِّق فيه
التنّينُ الإلهيّ نحو السّماء الحقيقيّة

58
00:05:28,570 --> 00:05:30,240
لن نحظى بفُرصة ثانية

59
00:05:30,830 --> 00:05:34,290
...أبي وجدّي ووالد جدّي

60
00:05:34,290 --> 00:05:37,370
جميعهم صلّوا من أجل الخلاص
وماتوا هنا في هذه البلاد

61
00:05:38,330 --> 00:05:39,630
...لا أستطيع السّماح لما ائتمننا عليه الباباوات

62
00:05:39,630 --> 00:05:44,920
بما صلّوا لأجله على مدار 1500 عام
بأن يذهب هباء منثوراً

63
00:05:45,340 --> 00:05:48,680
صحيح، هذه فترة زمنيّة طويلة
لا يستطيع المرء تعويضها بسهولة

64
00:05:49,010 --> 00:05:53,770
رغم ذلك، لا تملك خياراً سوى التحلّي
بالشّجاعة والاعتراف بأنّكم كنتم مخطئين

65
00:05:54,430 --> 00:05:57,850
،سوف أدمِّر هذه الصّلوات مع آلهتكم

66
00:05:57,850 --> 00:05:59,600
وأُري هذه الدّولة النُّور

67
00:06:00,310 --> 00:06:03,360
كان سنواتكم الـ 1500 جهداً مهدوراً

68
00:06:13,700 --> 00:06:18,660
هذه أرض الأطلال، حيث تُعلَّم
كافّة آثار الماضي

69
00:06:19,830 --> 00:06:25,340
،السّيف الوحيد الّذي يستطيع تدميرك
...الفنّ الخفيّ الّذي يمتلكه البطل كانون

70
00:06:25,340 --> 00:06:26,840
سيف النّاب السّماويّ الكاسر

71
00:06:28,590 --> 00:06:31,260
صحيح. هذا هو سيف لاي

72
00:06:32,220 --> 00:06:35,310
وفي نفس الوقت، ليس سيف لاي

73
00:06:36,680 --> 00:06:39,770
تستطيع إعادة صنع أي ماضٍ، صحيح؟

74
00:06:40,060 --> 00:06:44,570
لكن سيف لاي هو سيف المستقبل
والّذي ينضج كلّما حُمِل

75
00:06:46,320 --> 00:06:51,070
هل حسبتَ أنّ ضربة واحدة من بطل
مُزيّف بوسعها فعل شيء لي؟

76
00:06:51,070 --> 00:06:52,410
ديغزيغد

77
00:06:56,990 --> 00:07:00,670
حتّى لو دمّرتني الآن، لا تستطيع تدمير الماضي

78
00:07:02,420 --> 00:07:06,050
،لذا ما دامت أطلال الماضي موجودة
سوف نبقى خالدين

79
00:07:06,300 --> 00:07:07,510
هكذا إذاً

80
00:07:10,260 --> 00:07:16,180
من أجل تدميرك، يجب أن أدمِّر
أرض الأطلال هذه أوّلاً

81
00:07:17,180 --> 00:07:19,270
!إغيل غروني أنغدروا

82
00:07:19,980 --> 00:07:22,850
كافّة الأطلال الموجودة هي حليفي

83
00:07:22,850 --> 00:07:26,900
،سحر الأصل ذاك، بطاقتك الرّابحة
!لا يمكن استخدامها هنا

84
00:07:30,570 --> 00:07:37,490
يا عديم الأهليّة! أنت على وشك أن تخضع
لأقوى دمار في هذا العالم

85
00:07:37,490 --> 00:07:41,210
!كِتاب الأطلال، الفصل السّادس... أزائيل

86
00:07:47,500 --> 00:07:48,460
ماذا؟

87
00:07:49,800 --> 00:07:53,130
قدِّم صلواتك للآلهة وتُب

88
00:07:53,130 --> 00:07:57,430
وإلّا ستتلقّى دمار العالم بكامله

89
00:07:57,640 --> 00:07:59,100
هل أنت متأكّد من هذا؟

90
00:07:59,100 --> 00:08:03,390
قد تختفي أرض الأطلال هذه قبل أن تدمّرني

91
00:08:03,730 --> 00:08:06,610
هذه الأرض أيضاً حصينة

92
00:08:06,610 --> 00:08:10,860
أطلال الدّمار، إيغيل غروني أنغدروا

93
00:08:23,960 --> 00:08:28,790
...لماذا... لم يتجنّب الموت فحسب
...بل قوّته السّحريّة تتزايد

94
00:08:28,790 --> 00:08:31,420
...كشمعة قبل أن تنضب

95
00:08:31,670 --> 00:08:35,220
المصدر الّذي يوشك أن يموت
يصبح أكثر بريقاً حتّى

96
00:08:35,220 --> 00:08:38,510
هل ينوي أن يتغلّب حتّى على فنائه؟

97
00:08:38,510 --> 00:08:42,930
مـ-مستحيل... مُحال أن يتمكّن من التغلُّب
...على دمار العالم

98
00:08:43,230 --> 00:08:45,770
،إذا كنت أنت وهذه البلاد حصينة

99
00:08:45,770 --> 00:08:49,820
،فهذا لأنّه من الماضي. بصيغة أخرى
لأنّ هناك أطلال بمختلف الأشكال

100
00:08:59,330 --> 00:09:04,370
قد يترك المرء آثار خطواته في هذه
الأرض، لكن لا يمكن محوها

101
00:09:06,330 --> 00:09:09,250
في هذه الحالة، كيف سنُدمّرها؟

102
00:09:10,380 --> 00:09:11,670
إليك الإجابة

103
00:09:16,300 --> 00:09:19,050
كلّ ما عليك هو أن تترك آثار خُطوات أكبر حتّى

104
00:09:19,260 --> 00:09:20,600
هذا غير ممكن

105
00:09:20,600 --> 00:09:24,890
مضى 700 مليون سنة منذ بداية
الزّمان حتّى الآن

106
00:09:25,100 --> 00:09:27,400
،لا توجد أطلال أعظم من هذه البلاد الواسعة

107
00:09:27,400 --> 00:09:32,110
!والّتي تستطيع احتواءها حتّى لو كرّرتها مئة مرّة

108
00:09:32,360 --> 00:09:34,860
ما زلت تتحدّث عن الماضي، صحيح؟

109
00:09:34,860 --> 00:09:37,530
آسف، لكنّني متوجّه نحو المستقبل

110
00:09:38,410 --> 00:09:43,120
هذه تعويذة ابتكرتُها للتو ولم تُسجَّل
بعد من بين أطلالك

111
00:09:43,870 --> 00:09:45,370
غيليريام نافييم

112
00:10:00,430 --> 00:10:00,970
—ماذا

113
00:10:08,480 --> 00:10:12,020
!لا... بلاد الآلهة... حصينة

114
00:10:18,490 --> 00:10:20,740
!مستحيل! أيّتها الآلهة

115
00:10:30,040 --> 00:10:33,420
!أ-أيّتها الآلهة! احميني... أتوسّل إليكِ

116
00:10:47,640 --> 00:10:51,270
!أرجوكِ... أرجوكِ... أرجوكِ... أرجوكِ

117
00:10:51,270 --> 00:10:55,400
...أيّتها الآلهة، أيّتها الآلهة، أيّتها الآلهة

118
00:11:00,860 --> 00:11:03,530
لماذا لا تحميني؟

119
00:11:10,410 --> 00:11:16,840
صنعتُ هذه التّعويذة من أجل إبادة
حتّى بلاد الأطلال باتّخاذ سبع خطوات

120
00:11:17,550 --> 00:11:19,720
لكن لسبب ما، فشلتُ

121
00:11:20,050 --> 00:11:22,720
مشيتُ سبع خُطوات فتمَّ تجاهلي

122
00:11:22,930 --> 00:11:26,350
...لـ-لكن، لا... الأرض الّتي صنعتها الآلهة

123
00:11:26,560 --> 00:11:31,100
هذه الأرض الّتي عمرها 70 مليار سنة
لا تستطيع تحمُّل خُطواتي السّبعة على ما يبدو

124
00:11:33,060 --> 00:11:39,110
غولروانا، هل يمكنك القول بإيمان بأنّه لا توجد
حدود 1500 عام في عقلك؟

125
00:11:39,610 --> 00:11:44,070
ترفض الاعتراف بأخطائك... ماذا تقصد
بـ"عالم خالٍ من التّمييز"؟

126
00:11:44,370 --> 00:11:48,620
قبل أن تزيل القبّة، خلِّص نفسك
من الحدود الّتي بداخلك

127
00:11:49,950 --> 00:11:57,040
أنت ابن الدّمار... لكن فات الأوان الآن

128
00:11:57,670 --> 00:12:01,010
ليبارشيند قد أدّى عمله بالفعل

129
00:12:01,920 --> 00:12:04,680
،أغنية التنّين الإلهيّ تصعد نحو السّماوات

130
00:12:04,680 --> 00:12:07,140
وتنّين الآلهة سيضع القبّة داخل رحمه

131
00:12:07,510 --> 00:12:11,100
سيتحرّر العالمُ من التّمييز ويولد من جديد

132
00:12:11,100 --> 00:12:14,730
!الحركة الأخيرة لكتاب الإنجيل، بيهيروم

133
00:12:24,070 --> 00:12:28,740
حالما تُدمَّر قوّتك، لا وسيلة لك لإيقافي

134
00:12:29,160 --> 00:12:31,290
أجل، هذا إن كانت قوّتي وحدي

135
00:12:31,830 --> 00:12:33,790
أركانا، سمعتِ ذلك، صحيح؟

136
00:12:34,210 --> 00:12:36,000
ماذا يجدر بي أن أفعل؟

137
00:12:36,000 --> 00:12:38,790
،استخدمي سيف العظيم، ليفيانغيلما

138
00:12:38,790 --> 00:12:41,460
لتحويل القبّة إلى أرض من الدّيمومة الخالدة

139
00:12:41,880 --> 00:12:48,220
الوحيدون الّذين يستطيع ليفيانغيلما أن يُصيّرهم
بالدّيمومة الخالدة هم الّذين عقدوا ميثاقاً معي

140
00:12:48,220 --> 00:12:50,060
لا أحد آخر

141
00:12:50,220 --> 00:12:53,600
إذاً دعيني أدمِّر هذا القانون

142
00:12:57,400 --> 00:12:58,980
ديلسغيد

143
00:13:03,150 --> 00:13:07,950
،ادمجي سيف الشّيطان مع قمر الخلق
وحوّليه إلى ليفيانغيلما

144
00:13:08,950 --> 00:13:15,040
حسناً إذاً يا غولروانا. إذا ساعدتها على استرجاع
ذاكرتها. فلن أمسّك بضرّ

145
00:13:15,460 --> 00:13:18,130
ما الذّكريات الّتي ترغب في معرفتها؟

146
00:13:18,960 --> 00:13:21,670
الذّكريات الّتي ما زالت لا تستطيع تذكّرها؟

147
00:13:21,670 --> 00:13:25,880
أم ربّما الذّكريات الّتي استعادتها
في ليغاروندورول؟

148
00:13:26,470 --> 00:13:27,840
ماذا تقصد بذلك؟

149
00:13:28,260 --> 00:13:30,890
هذه حقيقة صرّح عنها إله الأطلال

150
00:13:30,890 --> 00:13:36,350
إذا تبيّن بأنّها كذبة، فأقسم
بأن أُعيد حياتي للآلهة

151
00:13:36,350 --> 00:13:37,440
زيكت

152
00:13:39,270 --> 00:13:40,480
ينبغي لهذا أن يفي بالغرض، صحيح؟

153
00:13:41,270 --> 00:13:45,950
أتيتم ذات مرّة إلى ليغاروندورول

154
00:13:46,200 --> 00:13:48,910
أركانا، هل تمكّنتِ من استعادة ذاكرتكِ؟

155
00:13:49,780 --> 00:13:53,790
لم... لم أستطع تذكّر شيء

156
00:13:54,660 --> 00:13:57,000
لماذا كذبتْ عليك؟

157
00:13:57,500 --> 00:14:00,920
عندما عثرَتْ على جزء من ذاكرتها في ذلك اليوم؟

158
00:14:02,840 --> 00:14:05,260
أحلام الذّاكرة الّتي رأيتها معها

159
00:14:05,550 --> 00:14:07,840
لكن كلّ واحدة منها كانت كذبة صارخة

160
00:14:08,550 --> 00:14:11,390
لم يكن لديك أخت غير شقيقة
صغرى تُدعى أركانا

161
00:14:12,760 --> 00:14:19,440
،رغم حقيقة أنّها تذكّرَتْ هذا
لماذا حاولتْ أن تستمرّ كأختك الصّغرى؟

162
00:14:19,850 --> 00:14:23,770
كان كلّ ذلك من أجل خيانتك في هذه اللّحظة

163
00:14:23,770 --> 00:14:26,820
...والسّبب؟ لأنّ هويّتها الحقيقيّة

164
00:14:26,820 --> 00:14:28,280
كما يقول تماماً

165
00:14:30,410 --> 00:14:36,500
...الحقيقة هي بأنّني تذكّرتُ بأنّني
إلَهة العبثيّة، غينيدونوف

166
00:14:36,500 --> 00:14:38,830
إلَهة الأكاذيب والخيانة

167
00:14:39,330 --> 00:14:44,090
آنوس، مهما حدث، يجب ألّا تصدّقني أبداً

168
00:14:47,970 --> 00:14:54,220
،في ذلك اليوم، في حلم إله الأطلال
وجدتُ ذكرياتي الخاصّة

169
00:14:54,220 --> 00:14:56,560
كانت التّنانين تُلاحقني

170
00:14:57,140 --> 00:15:03,810
،والدراكونيد. كان الجميع أعدائي
ولم يكن هناك أحدٌ يحميني

171
00:15:03,810 --> 00:15:06,860
ولهذا تمنّيتُ أن يكون لديّ أخ أكبر

172
00:15:07,280 --> 00:15:10,990
أخ أكبر ينقذني من هذا الجحيم

173
00:15:13,950 --> 00:15:19,330
،نتيجة عجزي عن النّظر مباشرة نحو ذكرياتي
انتهى المطاف بتجاهلي لها

174
00:15:19,750 --> 00:15:21,580
...الشّيء الوحيد الّذي أنا متيقّنة منه

175
00:15:21,580 --> 00:15:26,340
هو أنّ ما يحفّزني كان غضب حارِق

176
00:15:26,750 --> 00:15:29,340
لم أستطع حمل نفسي على إخبارك

177
00:15:29,340 --> 00:15:33,930
أردتُ الاستمرار في رؤية ذلك الحلم
المُسالم ولو فترة أطول قليلاً

178
00:15:34,430 --> 00:15:38,930
كان كلّ ذلك كذبة. حتّى مشاعر
رغبتي في إنقاذ النّاس

179
00:15:39,350 --> 00:15:43,230
لأنّني مجرّد مزيّفة تمّ صنعها
بواسطة قمر الخلق

180
00:15:43,770 --> 00:15:47,780
عندما يحين الوقت، وأسترجع
...كافّة ذكرياتي وروحي

181
00:15:48,150 --> 00:15:52,400
سأخون حتّى نفسي، ثمّ أحقّق هدفي

182
00:15:52,400 --> 00:15:55,990
،قبل أن أتمكّن من فعل ذلك
أريدك أن تدمّرني

183
00:15:56,780 --> 00:15:59,910
لم أكن أختك الصّغرى

184
00:15:59,910 --> 00:16:03,330
أنا مجرّد إلَهة وحيدة حمقاء عنيدة

185
00:16:04,250 --> 00:16:08,050
كنتُ... دورا الكاذبة

186
00:16:13,300 --> 00:16:15,260
ما هذا بالتّحديد؟

187
00:16:15,260 --> 00:16:17,550
لا يبدو هذا مجرّد زلزال

188
00:16:17,550 --> 00:16:19,260
إيميليا! ماذا نفعل؟

189
00:16:20,180 --> 00:16:23,980
!سأنصب حاجزاً فوق بُحيرة النُّور المُقدّس
!أرشدوا النّاس في البلدة رجاء

190
00:16:26,400 --> 00:16:28,070
!من هنا جميعاً

191
00:16:28,070 --> 00:16:29,730
ابقوا هادئين وأخلوا المكان من فضلكم

192
00:16:31,860 --> 00:16:33,400
!صغيري آنوس

193
00:16:33,400 --> 00:16:35,360
أنا متأكّد بأنّه بخير

194
00:16:36,280 --> 00:16:38,370
هذا هو الخلاص الّذي أقدّمه لك

195
00:16:39,200 --> 00:16:42,960
بما أنّك لم تعُد مخدوعاً بواسطة
تلك الإلَهة الغدّارة

196
00:16:43,210 --> 00:16:45,790
لماذا تصرِّح عمّا هو واضح؟

197
00:16:46,130 --> 00:16:49,250
ما كانت أختي الصّغرى لتخونني أبداً

198
00:16:50,250 --> 00:16:52,630
ما زلتَ لم تفهم؟

199
00:16:53,090 --> 00:16:55,720
إنّها ليست أختك الصّغرى

200
00:16:55,720 --> 00:16:58,050
!كان كلّ ذلك حلماً عابراً

201
00:16:58,260 --> 00:17:01,680
أجل، هذا صحيح. لهذا السّبب يمكنني تحقيقه

202
00:17:02,430 --> 00:17:05,020
كان ذلك، بلا شكّ، حلمها

203
00:17:05,520 --> 00:17:08,060
تلهّفَتْ أركانا لأخ أكبر

204
00:17:08,060 --> 00:17:13,070
...تلك الوحدة، أطلال ذلك الحزن
ليست ظاهرة بالنّسبة لك؟

205
00:17:13,070 --> 00:17:16,570
ماذا؟-
هل تتذكّرين الوعد الّذي قطعتِه يا أركانا؟-

206
00:17:17,200 --> 00:17:19,700
قلتُ لكِ أن تتذكّريه مهما حدث

207
00:17:19,700 --> 00:17:24,660
،الأيّام الّتي قضيتُها معك كانت كذبة
...وكذلك كان الوعد

208
00:17:24,660 --> 00:17:30,210
رغم ذلك، حقيقة بأنّني رأيتُ ذلك الحلم
معكِ لم يكن كذبة من كافّة النّواحي

209
00:17:31,550 --> 00:17:34,130
ستصبحين أقوى عندما يُعاد خلقكِ، صحيح؟

210
00:17:34,130 --> 00:17:37,800
في ذلك الحلم، قلتِ لي بأنّها
لم تكن كذبة هذه المرّة

211
00:17:38,260 --> 00:17:41,850
،هل حسبتِ حقّاً أنّه إذا كان حلماً
فلا يمكن تحويله إلى حقيقة؟

212
00:17:44,560 --> 00:17:47,350
كائناً من تكونين، لا أبالي

213
00:17:47,730 --> 00:17:49,940
—أنا سوف

214
00:17:49,940 --> 00:17:55,490
لن تخونيني. مهما حدث، سأستخدم
كامل قوّتي لمنعكِ من خيانتي

215
00:17:55,940 --> 00:17:59,320
...أؤمن بكلمات الإله الّذي اخترتُه

216
00:17:59,320 --> 00:18:03,080
حتّى النّهاية، سأظلّ أؤمن بالأمنية
الّتي تمنّتْها أختي الصّغرى

217
00:18:03,620 --> 00:18:06,750
إن كان هذا لا يُرضيكِ، فدعيني أقول هذا إذاً

218
00:18:07,330 --> 00:18:09,290
أريدكِ أن تصبحي أختي الصّغرى

219
00:18:13,460 --> 00:18:17,470
!أخي

220
00:18:37,570 --> 00:18:39,780
يؤمن بإلَهة العبثيّة؟

221
00:18:39,780 --> 00:18:43,160
!أسحق هذا الرّجل الآثم يا ليبارشيند

222
00:18:44,740 --> 00:18:48,120
!سيف الأطلال، سيف النّاب السّماويّ الكاسر

223
00:18:48,540 --> 00:18:50,170
!فينيزيارا

224
00:18:55,250 --> 00:19:00,220
...البابا الخاص بي... سأترك صلواتك هنا

225
00:19:03,350 --> 00:19:06,720
...كافّة صلوات الـ 1500 سنة الماضية

226
00:19:41,260 --> 00:19:43,340
يمكنك البدء من جديد

227
00:19:43,680 --> 00:19:46,180
كنتَ تفعلها بالطّريقة الخاطئة فحسب

228
00:19:47,010 --> 00:19:49,890
إذا أردت الاستمرار في تمنّي
،الخلاص لعالم تحت الأرض

229
00:19:49,890 --> 00:19:51,560
فيجدر بك أن تبحث عن طريق جديد

230
00:19:53,940 --> 00:19:58,360
أعتقد سيأتي ذلك اليوم عندما
نضع أيدينا بأيديكم

231
00:20:12,830 --> 00:20:15,960
حسناً، ما كنتُ لأجزم بشأن ذلك

232
00:20:17,840 --> 00:20:19,710
أهلاً بعودتك يا آنوس

233
00:20:19,710 --> 00:20:21,130
!أحسنت صنعاً

234
00:20:21,130 --> 00:20:23,970
وصلنا إلى هنا أوّلاً

235
00:20:23,970 --> 00:20:25,300
أحسنتم عملاً

236
00:20:25,550 --> 00:20:28,850
يبدو أنّ السّطح تلقّى ضرراً أقل من المُتوقّع

237
00:20:30,390 --> 00:20:33,600
تسرّني رؤيتك سالماً يا مولايّ

238
00:20:33,600 --> 00:20:35,980
أجل. كيف الأمور عندكم؟

239
00:20:35,980 --> 00:20:37,360
الجميع بأمان

240
00:20:37,360 --> 00:20:39,320
غايراديت بخير كذلك

241
00:20:39,690 --> 00:20:41,740
،نحن نتفقّد الأضرار

242
00:20:41,740 --> 00:20:44,360
لكن لا أعتقد بأنّ السّطح قد تضرّر كثيراً

243
00:20:45,160 --> 00:20:47,030
!لينو

244
00:20:47,030 --> 00:20:48,240
هل أنتِ بخير؟

245
00:20:48,410 --> 00:20:50,740
أجل! هل أنتن بخير أيضاً؟

246
00:20:50,740 --> 00:20:51,700
!بالتّأكيد

247
00:20:51,700 --> 00:20:52,910
!ميسا أيضاً

248
00:20:52,910 --> 00:20:54,330
!أجل

249
00:20:54,670 --> 00:20:57,920
!ا-المعذرة... أنا بخير

250
00:20:59,170 --> 00:21:01,880
!جميعكم، عودوا إلى هنا سالمين

251
00:21:02,090 --> 00:21:03,130
!حسناً

252
00:21:03,130 --> 00:21:04,260
!أنت أيضاً يا شين

253
00:21:04,630 --> 00:21:05,720
بالتّأكيد

254
00:21:05,970 --> 00:21:09,180
والداك غير حاضرين على ما يبدو
يا ملِك الشّياطين

255
00:21:09,180 --> 00:21:12,100
خرجا للتسوُّق غالباً

256
00:21:13,430 --> 00:21:16,310
على ذكر الأمر، أين أركانا؟

257
00:21:16,310 --> 00:21:17,650
إنّها هناك

258
00:21:18,940 --> 00:21:21,730
لماذا لا تعود؟

259
00:21:22,650 --> 00:21:23,990
هل من مشكلة؟

260
00:21:25,030 --> 00:21:29,780
لا بدّ أنّ هذا ما يعنيه عدم القدرة
على النّظر في وجه شخص مباشرة

261
00:21:32,120 --> 00:21:35,040
أرى بأنّكِ عرفتِ الكثير
عن نقاط ضعف البشر

262
00:21:35,040 --> 00:21:38,580
في هذه الحالة، خطوتكِ التّالية
هي التغلُّب على ذلك

263
00:21:39,000 --> 00:21:41,040
غوالا ناتيه فورتيوس

264
00:21:45,510 --> 00:21:47,680
أنا آسفة جميعاً

265
00:21:48,010 --> 00:21:50,140
لا تلقي بالاً للأمر

266
00:21:50,550 --> 00:21:53,100
الجميع يخطئون

267
00:21:53,560 --> 00:21:56,810
...قد تبدو كتابعة مُوالية الآن

268
00:21:57,190 --> 00:22:00,190
لكن ساشا قاتلتني حالما التقينا

269
00:22:00,650 --> 00:22:03,610
!مـ-مهلاً! كان ذلك قبل مدّة طويلة

270
00:22:03,940 --> 00:22:08,410
،حتّى لو كنتِ إلَهة العبثيّة
فهذا لا يهمّني إطلاقاً

271
00:22:08,410 --> 00:22:10,200
...ثمّة أمر مهمّ واحد

272
00:22:11,240 --> 00:22:15,410
وهو أنّني أخوكِ الأكبر، وأنتِ أختي الصّغرى

273
00:22:18,540 --> 00:22:22,130
حتّى لو كان قلبي بحدِّ ذاته مُزيّفاً؟

274
00:22:26,090 --> 00:22:29,430
أهتمّ حتّى بنسختكِ المُزيّفة

275
00:22:31,970 --> 00:22:33,390
!أخي

276
00:22:45,690 --> 00:22:47,940
آنوس! أهذا أنت يا آنوس؟

277
00:22:47,940 --> 00:22:49,860
آنوس! هل أنت بخير؟

278
00:22:49,860 --> 00:22:53,910
—هذا مُطمئن! ظننتُ أنّك

279
00:22:55,540 --> 00:22:58,250
!آنوس يعانق إحداهن

280
00:22:58,500 --> 00:23:02,880
!ا-ا-اهدئي! لسنا متأكّدين من ذلك بعد

281
00:23:02,880 --> 00:23:04,840
...أركانا تبكي

282
00:23:04,840 --> 00:23:05,800
—هل هذا يعني

283
00:23:05,800 --> 00:23:06,760
!مستحيل

284
00:23:06,760 --> 00:23:10,050
أيُّهما أهمّ بالنّسبة لك، أمّك
أم عملك كملِك شياطين؟

285
00:23:10,050 --> 00:23:13,220
هل ظننت حقّاً أنّه حتّى أنت
لا تستطيع حماية هذا البلد؟

286
00:23:13,260 --> 00:23:18,140
يا للعجب! صغيري آنوس... صغيري آنوس
،لا يزال عمره ستّة أشهر فقط

287
00:23:18,140 --> 00:23:20,810
!لكن انظر كم يبدو خبيراً الآن

288
00:23:20,810 --> 00:23:24,270
هل ارتكبتُ خطأ آخر؟

289
00:23:24,270 --> 00:23:26,190
ما الّذي تقولينه؟ إنّه خطأ جميل

290
00:23:26,480 --> 00:23:30,280
ماذا؟ تقصد بأنّكما ارتكبتما خطأ أيضاً؟

291
00:23:30,280 --> 00:23:34,320
!حتّى أنا لم أفعل ذلك من قبل

292
00:23:34,910 --> 00:23:39,540
هل ظننتما حقّاً بأنّني فقط لكوني ملِك
الشّياطين، لا أرتكب أخطاء أبداً؟