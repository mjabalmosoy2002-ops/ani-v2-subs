1
00:00:02,460 --> 00:00:04,920
هل ستستمرّ في الصّلاة للأبد؟

2
00:00:04,920 --> 00:00:07,380
من المؤكّد أنّك لا تنوي القتال جلوساً

3
00:00:07,790 --> 00:00:10,130
أنا البابا الخاصّ بجيوردال

4
00:00:10,550 --> 00:00:15,390
،ما لم يعُد السّلامُ إلى العالم تحت الأرض
لا أستطيع التوقُّف عن الصّلاة لأيّ سبب

5
00:00:16,800 --> 00:00:21,600
لمعلوماتك. مهما كانت الهجمة الّتي
،توجّهها نحوي مُدمِّرة

6
00:00:21,600 --> 00:00:24,850
لن تتمكّن أبداً من كسر هاتين
اليدين اللّتين تُصلّيان

7
00:00:26,350 --> 00:00:27,690
هذا مُثير

8
00:02:00,410 --> 00:02:02,580
حسناً إذاً، لن أتحفّظ أبداً

9
00:02:03,120 --> 00:02:04,580
زورا إيديبت

10
00:02:09,920 --> 00:02:12,380
ستعرف ماهيّة الخوف

11
00:02:12,380 --> 00:02:15,090
لا يستطيع أحدٌ كبح إله

12
00:02:18,130 --> 00:02:21,970
اخرج أيّها الإنجيل... أزيبت دولدريد

13
00:02:24,850 --> 00:02:28,020
،إله الاختيار الخاصّ بغولروانا
دولدريد

14
00:02:28,430 --> 00:02:31,650
،إنّه لا يتحكّم بالصّوت فحسب
إنّه الصّوت بنفسه

15
00:02:36,820 --> 00:02:39,610
هذا نادر. دائرة سحر صوتيّ؟

16
00:02:40,110 --> 00:02:43,950
الحركة الأولى لكتاب الإنجيل، إيغريد

17
00:02:46,410 --> 00:02:51,000
،هؤلاء الباباوات السّابقون من الزّمن الغابر
والّذين عادوا من بلاد الموتى

18
00:02:51,210 --> 00:02:53,420
—إذاً أريد أن أسألك

19
00:02:53,880 --> 00:02:57,340
هل السّلام الّذي يسعى له هذا
البلد هو مع ديلهيد أم بدونها؟

20
00:02:57,670 --> 00:03:02,300
بما أنّهم موتى، فلا يمكن تحريكهم
إلّا بواسطة أُمنية على فِراش الموت

21
00:03:02,510 --> 00:03:04,930
سيرفرف الثّلج ويتحوّل إلى أجنحة

22
00:03:07,100 --> 00:03:11,140
الحركة الثّانية لكتاب الإنجيل، زابيوز

23
00:03:12,100 --> 00:03:15,020
يبدون باباوات تُقاة

24
00:03:15,320 --> 00:03:18,610
لكن هل قدّموا كلّ شيء للآلهة فعلاً؟

25
00:03:18,780 --> 00:03:21,240
لا تسأل عمّا هو واضح

26
00:03:21,240 --> 00:03:24,950
الباباوات الّذين يهتمّون لأمر بلادهم
خالون تماماً من الجشع

27
00:03:25,410 --> 00:03:28,330
ما رأيك برِهان إذاً؟ أُمنيتك ضدّ أُمنيتي؟

28
00:03:28,790 --> 00:03:30,210
—لن أنخدع بواسطة

29
00:03:30,370 --> 00:03:33,750
أرغب في مقاتلتك مُسلّحاً فقط
بشيء له صِلة بالتّرنيمة

30
00:03:34,170 --> 00:03:35,840
أقسِم بالآلهة

31
00:03:35,840 --> 00:03:37,750
سأقسِم بأركانا إذاً

32
00:03:39,340 --> 00:03:40,380
غولدروس

33
00:03:43,720 --> 00:03:47,470
تحطيم الصّوت بالصّوت هو الوسيلة الوحيدة

34
00:03:48,010 --> 00:03:52,520
قالوا. "كيف تستطيع الاستمرار
"في الصّلاة لفترة طويلة؟

35
00:03:52,980 --> 00:04:00,820
.أجاب المُنقِذ. "لطالما آمنتُ بالآلهة
"أنا جسد واحد مع الصّلاة

36
00:04:06,120 --> 00:04:09,620
خير تجربة للموسيقى هي عندما
تُغنَّى بشكل جماعيّ

37
00:04:09,620 --> 00:04:11,500
أتّفق مع ذلك تماماً

38
00:04:12,540 --> 00:04:14,710
هل تسمعونني يا جوقة ملِك الشّياطين؟

39
00:04:15,000 --> 00:04:15,960
آنوس-ساما؟

40
00:04:15,960 --> 00:04:18,170
!أ-أجل، نسمعك

41
00:04:18,460 --> 00:04:23,840
لننتهز هذه الفُرصة لنختبر مقدار
تأثير الحُبّ على الآلهة

42
00:04:23,840 --> 00:04:27,510
غنّوا. امنحوني حبّكم

43
00:04:27,760 --> 00:04:30,140
!عُلِم يا آنوس-ساما

44
00:04:30,140 --> 00:04:31,520
غارد آسكي

45
00:04:32,430 --> 00:04:36,270
الحركة الثّالثة من كتاب الإنجيل، لانريز

46
00:04:38,940 --> 00:04:42,610
ترتيلة ملك الشّيطان رقم 6: جيران

47
00:04:53,200 --> 00:04:55,830
سينحني الجميع أمام الآلهة

48
00:04:58,880 --> 00:05:06,180
يا إلهي، لم أكن أعلم بوجود هذا العالم

49
00:05:08,850 --> 00:05:12,350
ما-ما الأمر؟ لماذا توقّفتم عن الغناء؟

50
00:05:13,350 --> 00:05:17,730
من المؤكَّد أنّ هذه الأغنية لم تقهر الباباوات السّابقين
لدرجة أنّهم نسوا الصّلاة والغناء؟

51
00:05:17,730 --> 00:05:20,110
ترتيلتكم ليست سيّئة أيضاً

52
00:05:19,230 --> 00:05:22,480
كو-إيكّو. كو-إيكّو

53
00:05:20,610 --> 00:05:25,700
.لكن مجرّد الصّلاة لا يكفي
فهناك الرّقصة كذلك

54
00:05:22,480 --> 00:05:25,700
كو-إيكّو

55
00:05:25,700 --> 00:05:28,610
لا تفتحها، لا تفتحها

56
00:05:28,910 --> 00:05:32,080
لا تفتحها... إنّها بوّابة مُحرّمة

57
00:05:32,080 --> 00:05:35,290
انصحنا يا إله

58
00:05:35,290 --> 00:05:38,460
ما هذا؟ ما هذا؟

59
00:05:38,420 --> 00:05:44,760
كو-إيكّو. كو-إيكّو
!كو-إيكّو

60
00:05:38,460 --> 00:05:41,670
عليك أن تبدأ بالطّرق، النّقر برفق

61
00:05:41,670 --> 00:05:44,760
!لا، لا، هذا لن ينفع

62
00:05:45,970 --> 00:05:51,260
إنّهم موتى بالفعل، فكيف قُتِلوا ثانية؟

63
00:05:51,260 --> 00:05:53,180
لا يُحيَون؟ لماذا؟

64
00:05:53,430 --> 00:05:54,810
ألم تفهم؟

65
00:05:54,810 --> 00:05:59,440
كو-إيكّو. كو-إيكّو
!كو-إيكّو

66
00:05:59,440 --> 00:06:01,690
هذا هو السّبب -
ماذا؟ -

67
00:06:01,690 --> 00:06:04,190
،هذا غير منطقيّ، لكنّه ممتع
لذا هو مقبول

68
00:06:04,650 --> 00:06:09,910
،هذه الأغنية قد فتحتْ بوّابتهم المُحرّمة
وأيقظتْ مشاعرهم الحقيقيّة

69
00:06:09,910 --> 00:06:10,530
ماذا؟

70
00:06:10,740 --> 00:06:12,740
غادروا بسلام

71
00:06:13,330 --> 00:06:14,660
...غادروا

72
00:06:16,450 --> 00:06:18,370
لكلّ شخص روح

73
00:06:18,370 --> 00:06:22,790
أن ينسى إمتاع نفسه، ويصبح شخصاً
...لا يفعل شيئاً سوى الصّلاة

74
00:06:22,790 --> 00:06:24,710
أيّ حياة هي هذه؟

75
00:06:24,710 --> 00:06:26,130
...لا، قطعاً لا

76
00:06:24,920 --> 00:06:31,300
كو-إيكّو. كو-إيكّو
!كو-إيكّو

77
00:06:26,460 --> 00:06:31,300
حضّر نفسك. سوف أدخِل المفتاح
المُحرّم في روحك تالياً

78
00:06:31,300 --> 00:06:34,470
!لا تضعه! لا تضعه

79
00:06:34,470 --> 00:06:37,640
!هذا هو المفتاح المُحرّم

80
00:06:37,640 --> 00:06:40,900
!علّمنا يا ملِك الشّياطين

81
00:06:40,900 --> 00:06:44,110
ما هذا؟ ما هذا؟

82
00:06:44,110 --> 00:06:47,280
عليك أن تبدأ باللّمس، اللّمس برفق

83
00:06:47,280 --> 00:06:50,820
!لا، لا، هذا لا ينفع

84
00:06:48,780 --> 00:06:55,200
سواء كان إنجيلاً أم لا... هل ظننت حقّاً بأنّ أغنية
بلا رقصة سوف تتناغم معي؟

85
00:06:57,700 --> 00:07:00,540
أنت لا تتوقّف عن الصّلاة أبداً مهما كان السّبب

86
00:07:01,000 --> 00:07:03,330
يبدو أنّ ذلك لم يكن مجرّد اهتمام ظاهريّ

87
00:07:05,800 --> 00:07:13,260
الأمر كما قلتَ تماماً. يبدو وكأنّ الباباوات السّابقين
لم يُقدّموا كلّ شيء للآلهة في صلواتهم

88
00:07:14,100 --> 00:07:16,260
حسناً إذاً يا غولروانا

89
00:07:16,890 --> 00:07:22,060
قيل بأنّ ليبارشيند، إله الأطلال، نائم
في الأطلال تحت الأرض، ليغاروندورول

90
00:07:22,810 --> 00:07:27,190
أثناء اللّيالي البيضاء، حيث تُسمَع التّنانين
...الإلهيّة تغنّي غِناء كانون دائم

91
00:07:27,190 --> 00:07:29,740
هناك ينبغي أن يكون المدخل

92
00:07:29,940 --> 00:07:32,740
فهمت. والآن، الجواب الآخر

93
00:07:33,450 --> 00:07:37,620
إذا أردت تقديم النّظام الخاصّ بإلهي
هِبةً لإلهة الاختيار الخاصّة بك

94
00:07:37,620 --> 00:07:39,790
فاقتلني أوّلاً من فضلك

95
00:07:40,160 --> 00:07:41,460
هِبة؟

96
00:07:50,260 --> 00:07:51,920
لستُ بحاجة شيء كهذا

97
00:07:51,920 --> 00:07:52,880
لِمَ لا؟

98
00:07:52,880 --> 00:07:56,600
هدفي هو إنهاء اختيار الحُكم

99
00:07:56,930 --> 00:08:00,020
ولا داعي لأقول بأنّني غير مهتمّ بحياتك أيضاً

100
00:08:00,730 --> 00:08:03,480
،لو كنتَ طاغية، لاختلفت الحكاية

101
00:08:03,480 --> 00:08:06,610
لكن على الأقلّ، أنت تحكم هذا البلاد بسلام

102
00:08:07,320 --> 00:08:09,610
فإذا مُتَّ، سينهار البلد

103
00:08:10,110 --> 00:08:13,280
لا علاقة لهذا ببلد على السّطح

104
00:08:13,530 --> 00:08:18,620
إنَّ برَكة سُكّان جيوردال مُهمّة جدّاً
حتّى تقول بأنّنا لا علاقة لنا

105
00:08:18,870 --> 00:08:22,660
هل يقول شخصٌ دمّرَ إلَهي للتو
كلاماً كهذا حقّاً؟

106
00:08:24,330 --> 00:08:27,340
لا جدوى من التفوُّه بمثاليّات

107
00:08:27,340 --> 00:08:31,260
السّبب الوحيد الّذي يجعلنا نجري هذه
...المُحادثة هو لأنّك أدركت

108
00:08:31,260 --> 00:08:33,760
بأنّك لست ندّاً لي مهما حاولت أن تفعل

109
00:08:34,050 --> 00:08:35,590
...يا لك من مغرور

110
00:08:36,140 --> 00:08:39,220
أرى بأنّك فهمت شيئاً واحداً على الأقلّ

111
00:08:39,220 --> 00:08:43,940
أنا مغرور. مُجرّد إبادة دولة عدوّ لا يُرضيني

112
00:08:43,940 --> 00:08:47,020
ما أريده هو السّلام. سلام حقيقيّ

113
00:08:47,810 --> 00:08:49,610
وما الّذي تريدني أن أفعله؟

114
00:08:49,610 --> 00:08:53,650
استسلم. سأحترم إيمانك

115
00:08:53,650 --> 00:08:56,360
لكن لا تُعرِّض ديلهيد لخطر

116
00:08:57,280 --> 00:09:01,830
لنُمسِك بأيدي بعضنا الآخر، ونعقد
ميثاقاً بين بلدينا

117
00:09:02,290 --> 00:09:05,370
،أنا متأكّد بأنّك كونك من السّطح المزدهر
...فإنّك لن تفهمني

118
00:09:06,710 --> 00:09:10,710
لكن يدينا الاثنتين هي لأداء الصّلوات

119
00:09:11,000 --> 00:09:15,170
،لأنّ في عالم تحت الأرض القاسي هذا
كان إيماننا خلاصنا الوحيد

120
00:09:15,630 --> 00:09:18,220
بعض الأشياء لا يمكن تحقيقها بالصّلاة وحدها

121
00:09:18,220 --> 00:09:24,560
سيأتي الوقت الّذي تضطرّ فيه لمدّ
يديك من أجل الإمساك بشيء

122
00:09:25,430 --> 00:09:31,650
ما لم تستنزف كافّة مواردك، سأبقى
معك قدر ما تشاء من مرّات

123
00:09:34,860 --> 00:09:37,110
هلّا طرحتُ عليك سؤالاً؟

124
00:09:37,660 --> 00:09:42,580
تريد السّلام. ومع ذلك عفوت عن غولروانا

125
00:09:42,580 --> 00:09:44,580
هناك وعد قديم قطعتُه

126
00:09:45,000 --> 00:09:51,920
يجب أن أثبت بأنّ هذا العالم دافئ
ومليء بالحُبّ والأمل

127
00:09:54,130 --> 00:09:59,760
،كنتُ وحيدة تماماً. لكن للمرّة الأولى
،رأيتُ نفس الأشياء الّتي رآها شخصٌ آخر

128
00:09:59,760 --> 00:10:03,510
،وأكافح لتحقيق نفس الأشياء
بوضع نفس الأهداف في الحسبان

129
00:10:03,850 --> 00:10:05,470
جنباً إلى جنب

130
00:10:06,600 --> 00:10:10,770
،إذا أردنا تسمية هذا الشّعور
فماذا سنُسمّيه؟

131
00:10:11,900 --> 00:10:13,270
ما رأيكِ؟

132
00:10:13,770 --> 00:10:15,150
...أنا

133
00:10:15,690 --> 00:10:18,400
أعتقد بأنّني سعيدة

134
00:10:18,400 --> 00:10:22,240
أعتقد بأنّني نجوتُ عندما التقيتُ بك

135
00:10:22,240 --> 00:10:24,580
هذا أصغر من أن يُدعى بالخلاص

136
00:10:24,990 --> 00:10:28,040
ينبغي أن تسعي وتتمنّي ذلك
بحماسة أكبر

137
00:10:28,040 --> 00:10:29,920
اسعي وراء خلاصكِ

138
00:10:30,290 --> 00:10:32,080
...بحماسة أكبر

139
00:10:35,130 --> 00:10:40,300
بقيّة ذلك الحلم... أتمنّى رؤيتها

140
00:10:41,640 --> 00:10:46,180
أنا في الحلم... كان بجانبها أخ أكبر

141
00:10:46,890 --> 00:10:51,400
بالنّسبة لأنا الحاليّة، كان ذلك الخلاص المُطلَق

142
00:10:51,770 --> 00:10:53,400
تريدين أخاً أكبر؟

143
00:10:54,440 --> 00:10:57,150
هل أنا طمّاعة برغبتي؟

144
00:10:57,570 --> 00:11:01,240
عمّاذا تتكلّمين؟ أمنية هزيلة
كهذه تُثير دموعي

145
00:11:01,570 --> 00:11:06,990
...أريد أن أعرف. عن نفسي... وعنك

146
00:11:08,000 --> 00:11:13,290
إذا كنتُ أختك الصّغرى، فهناك
شيء أريد قوله لك

147
00:11:13,290 --> 00:11:14,000
ما هو؟

148
00:11:15,590 --> 00:11:17,460
أخي الكبير... هذا ما أردتُ قوله

149
00:11:17,880 --> 00:11:21,880
إذاً تعالي معي. لنرَ بقيّة ذلك الحلم اللّيلة

150
00:11:28,680 --> 00:11:32,190
أ-أنت! هل نسيت بأنّنا هنا؟

151
00:11:32,190 --> 00:11:33,400
عمّاذا تتكلّمين؟

152
00:11:33,770 --> 00:11:35,610
اقتربن إلى هنا جميعكن

153
00:11:36,070 --> 00:11:39,360
ماذا تفعل بالضّبط يا آنوس؟

154
00:11:39,360 --> 00:11:41,490
...عارٍ تماماً

155
00:11:41,900 --> 00:11:46,780
أستعين بمساعدة إله الأحلام
الحامي لاسترجاع ذكرياتي

156
00:11:47,160 --> 00:11:51,830
وجدتُها! خير وسيلة لتعزيز تأثيرات
!تعويذة هي التعرّي

157
00:11:51,830 --> 00:11:53,790
سأراه... معك

158
00:11:53,790 --> 00:11:57,630
لكن مهلاً، أين يُفترض أن ننام جميعاً؟

159
00:11:58,750 --> 00:12:02,340
حسناً، هناك تعويذة رائعة يمكن
!استخدامها لمُناسبات كهذه

160
00:12:02,340 --> 00:12:03,130
!ريلايمي

161
00:12:06,930 --> 00:12:08,850
ماذا؟ ماذا؟ ما هذا؟

162
00:12:09,220 --> 00:12:12,020
نعوم هنا ثمّ ننام كالقتلى

163
00:12:14,850 --> 00:12:17,860
لا يمكننا دخول نفس الحلم ما لم نتلامس

164
00:12:17,860 --> 00:12:19,610
!لا يتردّد أحدٌ منكن

165
00:12:19,860 --> 00:12:22,030
حـ-حقّاً؟

166
00:12:23,820 --> 00:12:25,410
والآن فلنبدأ

167
00:12:45,010 --> 00:12:48,220
دعوة من قلعة ميدهيز؟

168
00:13:04,610 --> 00:13:06,110
مرحباً يا أركانا

169
00:13:08,370 --> 00:13:10,790
ليس عليكِ أن تخافي

170
00:13:10,790 --> 00:13:13,750
لن أؤذيكِ

171
00:13:14,830 --> 00:13:16,870
من أنت؟

172
00:13:16,870 --> 00:13:22,340
اسمي سيريس. أركانا، أريد
أن أطلب معروفاً منكِ

173
00:13:22,760 --> 00:13:23,630
ما الأمر؟

174
00:13:24,670 --> 00:13:26,590
أريدكِ أن تعطي هذه لآنوس

175
00:13:28,590 --> 00:13:30,470
...رسالة دعوة أخرى

176
00:13:30,810 --> 00:13:33,810
آنوس هو شخص سيكون ملِك
هذا البلد يوماً ما

177
00:13:34,020 --> 00:13:38,440
أريده أن يقترب أكثر إلى الهاوية السّحريّة
قدرما يريد، في المكان الصّحيح

178
00:13:38,440 --> 00:13:40,560
لكن لم ألقَ ردّاً منه

179
00:13:40,560 --> 00:13:45,440
،أخي مُستهدَف بواسطة التّنانين
لذا يقول بأنّه لا يستطيع دخول البلدة

180
00:13:45,820 --> 00:13:49,030
فهمت. هذا هو السّبب إذاً؟

181
00:13:49,780 --> 00:13:54,200
أركانا، ما قولكِ؟ هل ستقنعينه بذلك؟

182
00:13:54,200 --> 00:13:57,210
إذا فعلتِ ذلك، فسوف أحقِّق أمنيتكِ

183
00:13:57,500 --> 00:13:59,120
أُمنيتي؟

184
00:13:59,120 --> 00:14:01,630
أجل. ماذا تريدين؟

185
00:14:02,210 --> 00:14:06,800
هل تعتقد بأنّني أستطيع استخدام
سحر كأخي الكبير يوماً؟

186
00:14:06,800 --> 00:14:10,050
سأُسقِط التّنانين بالنّيابة عن أخي الكبير

187
00:14:10,300 --> 00:14:13,180
فهمت. أنتِ فتاةٌ لطيفة، أليس كذلك؟

188
00:14:14,770 --> 00:14:20,190
،غالباً لا تستطيعين استخدام السّحر لأنّه مختوم
وذلك كي لا تتسرّب قوّتُكِ السّحريّة

189
00:14:21,230 --> 00:14:22,270
مختوم؟

190
00:14:22,730 --> 00:14:28,360
يمكنني إلغاء ختمه لأجلك. ثمّ سأُعلّمك
تعويذة إسقاط أولئك التّنانين

191
00:14:28,360 --> 00:14:30,030
!حقّاً؟ شكراً لك

192
00:14:30,740 --> 00:14:34,990
حسناً، سأعود إلى هنا غداً في نفس الوقت
بعد أن أقوم بالتّحضير

193
00:14:36,830 --> 00:14:38,210
قبل أن أنسى

194
00:14:39,000 --> 00:14:43,920
تحتوي تلك الدّعوة على سرّ
مهمّ جدّاً بالنّسبة لآنوس

195
00:14:44,300 --> 00:14:46,880
لذا يجب ألّا تقرئيها مهما كلّف الأمر

196
00:14:47,340 --> 00:14:48,010
ماذا؟

197
00:14:48,510 --> 00:14:49,800
تفهمين، صحيح؟

198
00:15:09,280 --> 00:15:11,910
هل هذا هو المكان الّذي حدّثنا عنه غولروانا؟

199
00:15:12,360 --> 00:15:14,450
حيث يُغنّى كانون دائم

200
00:15:14,830 --> 00:15:17,750
ما مُشكلة هذا المكان؟

201
00:15:17,750 --> 00:15:19,710
هل هناك كثير من التّنانين الإلهيّة؟

202
00:15:20,080 --> 00:15:23,420
لكن لا أرى شيئاً يُشبه الأطلال تحت الأرض

203
00:15:23,710 --> 00:15:28,170
،بسبب نِظام إله الأطلال، الغير موجود اليوم

204
00:15:28,170 --> 00:15:31,800
لا بدّ أنّ مزار الماضي يؤدّي إلى اليوم

205
00:15:31,800 --> 00:15:35,180
تقصد أنّ ليغاروندورول موجود في الماضي؟

206
00:15:35,180 --> 00:15:35,930
أجل

207
00:15:36,760 --> 00:15:40,310
ستتجمّد الأرض، وسيبدأ الجليد بالذّوبان

208
00:15:45,610 --> 00:15:46,690
ريفايد

209
00:15:52,990 --> 00:15:55,240
!يا لها من أطلال ضخمة

210
00:15:55,240 --> 00:15:57,660
يبدو كمزار

211
00:15:58,200 --> 00:16:01,330
هذه غالباً أبعد نقطة يمكنني
الرّجوع بالزّمن إليها

212
00:16:02,960 --> 00:16:04,880
كيف يُفترَض بنا أن ندخل؟

213
00:16:06,670 --> 00:16:07,800
ما الخطب؟

214
00:16:08,130 --> 00:16:09,380
انظرنَ هناك

215
00:16:10,420 --> 00:16:11,970
ما زالت حديثة العهد

216
00:16:11,970 --> 00:16:15,390
...إمّا دخل شخصٌ قبلنا... أو

217
00:16:16,220 --> 00:16:16,970
ماذا تريدون؟

218
00:16:19,390 --> 00:16:21,350
رأيتُهم مرّةً من قبل

219
00:16:21,770 --> 00:16:24,440
إنّهم فُرسان غاديشيولا المجهولون

220
00:16:24,440 --> 00:16:28,320
في فترة ما، أصبحوا يُعرَفون بفُرسان الطّيف

221
00:16:28,320 --> 00:16:34,360
،غاديشيولا؟ يعِظون بالهرطَقة
وكانوا هُم من أعانوا آهيدي

222
00:16:35,320 --> 00:16:37,530
هل هدفكم إله الأطلال أيضاً؟

223
00:16:39,330 --> 00:16:40,660
"الجواب "أجل

224
00:16:40,660 --> 00:16:43,660
حسناً، سوف نتعامل معهم حالياً

225
00:16:47,130 --> 00:16:48,670
لذا اسبقونا من فضلكم

226
00:16:48,670 --> 00:16:49,550
حسناً، أعتمد عليكما

227
00:17:05,520 --> 00:17:07,400
هل كانت تلك محاولتك في مُباغتتي؟

228
00:17:10,400 --> 00:17:10,980
—أنت

229
00:17:12,570 --> 00:17:16,070
إنّه قويٌّ جدّاً كونه استطاع
أن يخدشني بهذا الشّكل

230
00:17:16,450 --> 00:17:18,570
لكن جيو غريزي؟

231
00:17:19,120 --> 00:17:22,040
يبدو أنّهم شياطين، لا دراكونيد

232
00:17:27,670 --> 00:17:30,460
هناك آثار لشخص قد مرّ من هنا بالفعل

233
00:17:30,460 --> 00:17:32,670
هل هو أحد زملائهم يا تُرى؟

234
00:17:32,670 --> 00:17:34,010
هذا احتمال وارد

235
00:17:34,210 --> 00:17:36,840
!لا أصدِّق بأنّه يوجد شياطين تحت الأرض

236
00:17:37,220 --> 00:17:39,720
إنّهم غالباً من العصر الأسطوريّ

237
00:17:40,260 --> 00:17:44,430
حسبما أذكر، في غاديشيولا يعبدون
الآلهة الّذين لا يستسلمون، صحيح؟

238
00:17:44,640 --> 00:17:48,560
أجل، إلَاهة العبثيّة جينيدونوف أحدهم

239
00:17:48,900 --> 00:17:51,150
،أولئك الّذين يتجاهلون الآلهة
الّذين يُمثِّلون النِّظام

240
00:17:51,520 --> 00:17:56,360
لا يتفاعلون مع البلدان الأخرى، وحالما
تدخل بلدهم، لا يمكنك المغادرة أبداً

241
00:17:56,360 --> 00:17:58,200
إلّا في حالات خاصّة

242
00:17:58,200 --> 00:18:01,660
ما خطبه؟ لا يبدو بلداً عاديّاً

243
00:18:03,620 --> 00:18:05,620
هذا هو الجزء الأعمق؟

244
00:18:05,620 --> 00:18:07,620
مقدار هائل من القوّة السّحريّة

245
00:18:07,620 --> 00:18:09,830
مصدر هذه القوّة موجود هناك

246
00:18:15,760 --> 00:18:21,220
.إذاً التقينا من جديد في مكان غير مألوف
ما الّذي تريده؟

247
00:18:21,470 --> 00:18:23,260
وما أدراني؟

248
00:18:23,260 --> 00:18:27,730
.سوف أدمّر إله الأطلال هنا
قبل أن يستيقظ

249
00:18:27,730 --> 00:18:31,690
كذلك أنت يا كايهيلام؟
أم أنّك جيستي؟

250
00:18:31,690 --> 00:18:35,110
جيستي. آسفة يا آنوس-ساما

251
00:18:35,110 --> 00:18:37,990
...أعلم بأنّك أنقذتني قبل أيّام

252
00:18:37,990 --> 00:18:42,160
ارحل يا ملِك الشّياطين. إذا
،استهنت بالآلهة

253
00:18:42,160 --> 00:18:44,080
فسينتشر آفوس ديلهيفيا من جديد
في كلّ مكان

254
00:18:44,330 --> 00:18:48,620
في هذه اللّحظة، إنّها تتّخذ شكل فُرسان
الطّيف أو أيّاً كان اسمهم

255
00:18:48,620 --> 00:18:51,250
يا له من سؤال عديم الجدوى كالعادة

256
00:18:53,040 --> 00:18:54,670
!تيو تراياس

257
00:18:56,090 --> 00:18:57,380
إذا تحرّكت، ستموت

258
00:18:57,760 --> 00:19:00,220
قفص الجليد... آنوس

259
00:19:00,550 --> 00:19:04,350
هيّا يا أركانا. سوف نُخضِع إله الأطلال أوّلاً

260
00:19:08,230 --> 00:19:10,850
ستُخاطرين بحياتكِ لكسب الوقت؟

261
00:19:10,850 --> 00:19:14,190
أنا لا أخاطر بحياتي، لكن أكسب الوقت فعلاً

262
00:19:15,020 --> 00:19:19,570
لا أعرف حجم قوّتك، لكنّني أخدم ملِك الشّياطين

263
00:19:21,950 --> 00:19:28,040
يمكنني الشُّعور بقوّة إله. لا بدَّ أنّ هذا
هو إله الأطلال، ليبارشيند

264
00:19:28,450 --> 00:19:31,670
كلّ هذا الماء إذاً هو إله الأطلال؟

265
00:19:31,960 --> 00:19:35,170
إنّه لا يتّخذ أي شكل عندما يكون نائماً

266
00:19:35,790 --> 00:19:39,090
قلتَ بأنّك سوف توقظه بعد أن اقتنعت

267
00:19:39,090 --> 00:19:41,840
،أجل. إذا فعلتُ الشّيء المعتاد ذاته

268
00:19:41,840 --> 00:19:44,300
فأعتقد بأنّني سأتمكّن من التكلّم
معه دون إيقاظه

269
00:19:50,350 --> 00:19:53,400
يُخيّم اللّيل، ويدعونا للنّوم

270
00:19:54,060 --> 00:19:58,150
الذّكريات المُتذبذبة، مع كلّ حلم
مُضاف، تعوم فوق سطح الماء

271
00:20:06,200 --> 00:20:09,620
هل نحن... داخل حلم إله الأطلال؟

272
00:20:10,290 --> 00:20:14,080
إنّه حلمي، وكذلك حلمها

273
00:20:15,460 --> 00:20:18,630
أنا ليبارشيند، إله الأطلال

274
00:20:18,630 --> 00:20:24,550
أنا النّظام الّذي ينقش في جسدي كلّ سجلّات
وذكريات هذا العالم

275
00:20:26,760 --> 00:20:32,350
،ماذا تريد يا عديم الأهليّة؟ وأنتِ
الإلهة أركانا، الّتي لا اسم لها؟

276
00:20:32,350 --> 00:20:35,730
أريد أن أسترجع ذكرياتي المفقودة
واسمي الإلهيّ

277
00:20:36,270 --> 00:20:40,570
الذّكريات ألم، والنّسيان خلاص

278
00:20:41,110 --> 00:20:46,660
الذّكريات الّتي تسترجعينها سوف تعذّبك
وتسبّب لكِ حزناً وتجرحكِ

279
00:20:46,950 --> 00:20:49,740
الخطيئة الّتي ارتكبتُها تنتمي لي

280
00:20:49,740 --> 00:20:54,620
إذا قلت لي بأنّها جرح، فأريد إذاً
أن أحفره في جسدي مرّة أخرى

281
00:20:54,920 --> 00:21:01,170
،حسناً. إذا كنتِ تتمنّين هذا بصدق هنا
فسوف يتحقّق إذاً

282
00:21:18,860 --> 00:21:21,730
اللّعنة. هل أنتم حمقى غاديشيولا؟

283
00:21:21,980 --> 00:21:24,070
كانوا ينتظرونه حتّى يتشتّت انتباهه إذاً؟

284
00:21:24,070 --> 00:21:25,650
سأذهب لإيقافهم

285
00:21:25,650 --> 00:21:28,870
ابحثي أنتِ عن ذكرياتكِ قدر استطاعتكِ

286
00:21:34,290 --> 00:21:35,460
وجدتُك

287
00:21:36,330 --> 00:21:39,460
آسف، لكن لا أستطيع السّماح
لك بالهيَجان الآن

288
00:21:49,090 --> 00:21:51,100
من أنت؟

289
00:21:52,390 --> 00:21:55,810
أعلم بأنّك نسيت، لكن هذ فظّ يا آنوس

290
00:21:57,690 --> 00:22:02,150
أنا قائد فُرسان الطّيف، سيريس فولديغود

291
00:22:02,650 --> 00:22:05,070
أنا والدك

292
00:23:37,200 --> 00:23:39,370
الوعد الّذي قُطِع في حلم