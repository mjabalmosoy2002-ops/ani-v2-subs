1
00:00:04,040 --> 00:00:06,040
!هذا مُمتع

2
00:00:09,130 --> 00:00:11,260
سندخل المجال الجوّي لجيوردال قريباً

3
00:00:11,260 --> 00:00:13,510
سنتوجّه إلى العاصمة جيورهيز

4
00:00:13,680 --> 00:00:17,390
ألم تكن جيوردال البلد الّتي هاجمتْ آزيشيون؟

5
00:00:17,720 --> 00:00:19,930
هل سنكون بخير بلفتِنا للأنظار هكذا؟

6
00:00:19,930 --> 00:00:24,060
كانت تلك الهجمة قراراً اعتباطيّاً بواسطة آهيدي

7
00:00:24,060 --> 00:00:26,810
أجل. التنّين الملكيّ الّذي استخدمه
،ينتمي لآغاثا أيضاً

8
00:00:26,810 --> 00:00:29,900
إحدى العوالم التحأرضيّة الرّئيسيّة الثّلاثة

9
00:00:30,400 --> 00:00:34,030
في العادة، يُعارض التّنانين الملكيّون
تعاليم جيوردال

10
00:00:34,030 --> 00:00:37,950
لكن آهيدي سرق واحداً، وأعطاه لملِك بشريّ

11
00:00:38,160 --> 00:00:41,370
إذاً كبلد، هم غير مُعاديين؟

12
00:00:41,370 --> 00:00:47,630
،لا أعلم. لكن البابا، غولروانا ديلو جيوردال
هو أحد المختارين الثّمانية

13
00:00:47,630 --> 00:00:50,630
قد لا يكون عدائيّاً، لكن يبقى عدوّ آنوس

14
00:00:50,630 --> 00:00:53,300
ماذا عن ليبارشيند، إله الأطلال؟

15
00:00:56,550 --> 00:01:01,680
كي نتعقّب ذكرياتنا، سوف يترتّب علينا
اللّقاء مع البابا، صحيح؟

16
00:01:01,680 --> 00:01:06,020
أجل. في هذه الفترة من العام، سيكون
هناك الكثير من الحجّاج

17
00:01:06,020 --> 00:01:08,150
سيكون من الأكثر أماناً شقّ
طريقنا إلى هناك علناً

18
00:01:10,360 --> 00:01:11,230
ماذا؟

19
00:01:11,230 --> 00:01:12,860
...يمكنني سماع شيء

20
00:01:13,190 --> 00:01:15,320
إنّه صوت تنّين إلهيّ

21
00:01:15,320 --> 00:01:19,160
تنّين إلهيّ؟! تقصدين غناء تنّ؟

22
00:01:19,160 --> 00:01:21,490
،التّنانين الإلهيّة هي تنانين صوت

23
00:01:21,490 --> 00:01:25,370
ولطالما صدح غنائها في كلّ أرجاء البلد
منذ تأسيسها

24
00:01:25,790 --> 00:01:31,340
لكن لا يستطيع أحد رؤيتهم ما عدا
البابا، والآلهة الّذين أجرى ميثاقاً معهم

25
00:01:31,340 --> 00:01:33,000
ماذا؟

26
00:01:33,460 --> 00:01:36,590
وصلنا. هذه جيورهيز

27
00:03:11,190 --> 00:03:13,480
—حسناً، ما هي محطّتنا الأولـ

28
00:03:13,480 --> 00:03:15,440
ما هذا الصّوت بالضّبط؟

29
00:03:16,400 --> 00:03:18,070
القبّة تسقط

30
00:03:18,400 --> 00:03:19,320
ماذا؟

31
00:03:20,990 --> 00:03:25,280
.سماء تحت الأرض تهتزّ وتصدح
"هذا ما نُسمّيه بـ"السّماوات المهتزّة

32
00:03:25,580 --> 00:03:29,370
لكن على هذا المُعدّل، سيُدمَّر العالم
تحت الأرض في نهاية المطاف

33
00:03:29,370 --> 00:03:32,750
العمود الإلهيّ سيسند القبّة السّاقِطة

34
00:03:33,170 --> 00:03:35,920
عمود النِّظام خفيّ لا يراه النّاس العاديّون

35
00:03:35,920 --> 00:03:38,460
هذا نادرٌ جدّاً

36
00:03:38,840 --> 00:03:40,510
سآخذكم في جولة حول البلدة

37
00:03:41,300 --> 00:03:45,800
كنيسة جيوردال تحكم هذا البلد
باسم الآلهة

38
00:03:46,260 --> 00:03:49,720
إنّهم رجال دين وفُرسان الكنيسة المُقدّسون

39
00:03:51,480 --> 00:03:54,480
أليس مصدر الأغنية من هناك؟

40
00:03:55,190 --> 00:03:56,440
!أسمعها! أسمعها

41
00:03:56,980 --> 00:03:59,980
آنوس-ساما، هل سيكون من المُناسب
أن نذهب للاستماع لها؟

42
00:03:59,980 --> 00:04:04,780
.لنتحرّك جميعنا بحرّية الآن
اذهبوا ووسِّعوا آفاقكم

43
00:04:05,370 --> 00:04:06,910
!شكراً جزيلاً لك

44
00:04:06,910 --> 00:04:08,660
!سنتعلّم تلك الأغنية أيضاً

45
00:04:10,410 --> 00:04:11,790
أتريدين الذّهاب أيضاً؟

46
00:04:11,790 --> 00:04:12,620
!أجل

47
00:04:13,210 --> 00:04:14,330
سينسي؟

48
00:04:16,580 --> 00:04:18,460
إلى أين أنت مُتوجِّه؟

49
00:04:18,460 --> 00:04:23,680
إلى الكنيسة، سمعتُ بأنّ رجال الدّين هنا
يستطيعون استدعاء التّنانين والآلهة

50
00:04:23,680 --> 00:04:25,760
!هذا مُثير جدّاً للاهتمام

51
00:04:25,760 --> 00:04:28,180
هل تريدين المجيء معي يا عثّة الكتُب؟

52
00:04:28,180 --> 00:04:31,270
...لكن قد أكون عائقاً في وجهك

53
00:04:32,350 --> 00:04:36,190
تعلمين بأنّني لن أدع تلميذاً
!يكون عائقاً في وجهي

54
00:04:41,860 --> 00:04:45,200
لم أرك في الأرجاء من قبل. ما الأمر؟

55
00:04:45,200 --> 00:04:47,740
أريد الانضمام لدينك. وكذلك هي

56
00:04:48,030 --> 00:04:49,990
ماذا؟

57
00:04:51,830 --> 00:04:58,630
،حقّاً؟ لكن إن أردتُما التحوُّل إلى هذا الدّين
فهناك قواعد صارمة وتدريب مُجهِد

58
00:04:58,840 --> 00:05:00,170
لا مانع لديّ

59
00:05:00,170 --> 00:05:02,420
اسمح لي أن أسألك إذاً

60
00:05:02,420 --> 00:05:07,340
هناك طريق من الأشواك وطريق
من السّلام أمامك

61
00:05:07,340 --> 00:05:09,510
أيّ طريق تسلك؟

62
00:05:11,470 --> 00:05:14,140
،سأختار طريق الفوضى دون أدنى شكّ

63
00:05:14,140 --> 00:05:15,940
،تتناثر فيه بذور الخطر

64
00:05:15,940 --> 00:05:18,980
طريق شائك تمّ إطلاق عنان الوحوش
!البرّية والعقارب فيه

65
00:05:19,190 --> 00:05:20,770
هـ-هل أنت جادّ يا سيّد؟

66
00:05:20,770 --> 00:05:23,150
إذاً ماذا تختارين أنتِ؟

67
00:05:23,150 --> 00:05:26,990
طريق الأشواك أم طريق السّلام؟

68
00:05:28,530 --> 00:05:31,910
—ا-المعذرة، في الواقع، سأختار طريق السّـ

69
00:05:31,910 --> 00:05:35,540
المعذرة... طـ... طريق الأشواك؟

70
00:05:35,750 --> 00:05:41,920
حسناً. سنمدُّ يد العون حتماً لأولئك
المستعدّين لتقديم أرواحهم للآلهة

71
00:05:41,920 --> 00:05:43,130
تفضّلا بالدّخول

72
00:05:46,300 --> 00:05:47,430
تعالوا معي

73
00:05:47,430 --> 00:05:48,430
—ماذا؟ لحظة

74
00:05:54,060 --> 00:05:55,680
—نعم؟ ما الأمر؟

75
00:05:55,680 --> 00:05:56,810
أرغب في الانضمام لدينك

76
00:05:57,140 --> 00:05:58,600
—إذاً -
الشّائك -

77
00:06:03,400 --> 00:06:05,740
آ-آنوس-ساما، ماذا تفعل هنا؟

78
00:06:05,740 --> 00:06:10,870
يا للعجب! أتيتَ لأنّك شككتَ بأنّني
لا أنوي خيراً مجدّداً، صحيح؟

79
00:06:10,870 --> 00:06:11,530
هذا صحيح

80
00:06:11,950 --> 00:06:13,910
تعرفان بعضكما؟

81
00:06:13,910 --> 00:06:18,210
أكثر من مجرّد معرفة. هذا الرّجل
!هو ملِك شياطين بلدنا

82
00:06:18,210 --> 00:06:19,000
ملِك شياطين؟

83
00:06:19,540 --> 00:06:21,380
من أيّ بلد أنت؟

84
00:06:21,380 --> 00:06:22,670
ديلهيد

85
00:06:22,670 --> 00:06:24,380
عجباً، قلتَها بلا تردُّد

86
00:06:24,590 --> 00:06:29,720
.لم أسمع بهذا البلد من قبل
لا بدّ أنّ هذا توجيه الآلهة أيضاً

87
00:06:30,220 --> 00:06:35,220
...حسناً إذاً، سنُقيم مراسم الانضمام
التّعميد بواسطة جوهرة العهد

88
00:06:35,560 --> 00:06:38,850
إنّه الحرق الإلهيّ

89
00:06:39,560 --> 00:06:46,820
وحدهم أولئك الّذين يقبلون جوهرة العهد
دون أن يحترِقوا سيُختارون بواسطة الآلهة

90
00:06:50,660 --> 00:06:52,870
ليتيلد ديرو

91
00:06:56,330 --> 00:06:59,910
،كما ترون، بفضل جوهرة العهد وتعويذة ليتيلد

92
00:06:59,910 --> 00:07:04,710
رجال الدّين التُّقاة قادرون على استدعاء
التّنانين، رُسُل الآلهة

93
00:07:04,710 --> 00:07:10,510
لكن يُقال بأنّه واحد فقط من أصل مئة
—ينجح أثناء تعميده الأوّل

94
00:07:10,930 --> 00:07:12,760
—ماذا؟ ما الّذي

95
00:07:13,010 --> 00:07:14,640
ليتيلد ديرو

96
00:07:15,600 --> 00:07:18,100
!ماذا؟ -
ليتيلد ديرو -

97
00:07:19,640 --> 00:07:21,270
ليتيلد ديرو

98
00:07:26,400 --> 00:07:28,400
أي مُعجزة هي هذه؟

99
00:07:28,730 --> 00:07:31,950
يا آنوس، أليس تنّينك كبيراً زيادة عن اللُّزوم؟

100
00:07:31,950 --> 00:07:33,360
لا يمكننا سوى رؤية ساقيه

101
00:07:42,960 --> 00:07:47,420
إ-إنّه ضئيل، لكن تمكّنتُ من ذلك

102
00:08:02,480 --> 00:08:07,270
هل أكلَ التّنانين؟ لا، لم أسمع أبداً
...بتنانين يأكلون تنانينَ أخرى

103
00:08:07,610 --> 00:08:11,610
.هذا تنّين مُثير للاهتمام استدعيتِه
هل تأكل الشّياطينَ أيضاً؟

104
00:08:15,070 --> 00:08:19,240
فهمت. الشّياطين لا يروقونك؟ وإلّا
ستكون لاحِماً حينئذ

105
00:08:19,660 --> 00:08:22,750
لـ-لاحم... أهذا اسمه؟

106
00:08:22,750 --> 00:08:27,420
يا عثّة الكُتُب، لِمَ لا تحاولين
استدعاء إله هذه المرّة؟

107
00:08:27,420 --> 00:08:28,960
ماذا؟ إله؟

108
00:08:29,300 --> 00:08:30,960
ا-انتظر لحظة رجاء

109
00:08:30,960 --> 00:08:34,470
لا يمكن للإله أن يُستدعى إلّا
بواسطة الأتباع المختارين

110
00:08:34,470 --> 00:08:38,350
في هذه المرحلة، لا يُسمَح لكم
حتّى بمعرفة ماهيّة هذه الطّقوس

111
00:08:38,350 --> 00:08:41,270
إذاً سيترتّب علينا صنع واحد من الصّفر

112
00:08:41,270 --> 00:08:43,180
...سيكون من المستحيل فعل شيء كهذا

113
00:08:43,180 --> 00:08:46,940
إنّه مستحيل بالطّبع! بالنّسبة لملِك
!الموت المُتوهِّج

114
00:08:49,230 --> 00:08:51,820
هذه تعويذة سحر لاستدعاء آلهة

115
00:08:52,280 --> 00:08:57,570
ماذا؟، لا، لكن ما لم تكن مُتعاقِداً
...مع إله، لا يمكنك حتّى استدعاء

116
00:08:59,120 --> 00:09:00,790
—آ-آنوس-ساما! كيف

117
00:09:02,750 --> 00:09:04,540
اهدئي يا عثّة الكُتُب

118
00:09:04,540 --> 00:09:06,540
أنتم الحمقى يا من تمقتون السّماوات

119
00:09:06,540 --> 00:09:10,670
!اقبلوا جزاء رفضكم للنِّظام. اشهدوا شكل إله

120
00:09:20,600 --> 00:09:24,100
—سينسي، لديك أجنحة

121
00:09:24,100 --> 00:09:27,190
اختلستُ قِوى إله مُعيّن كما ترين

122
00:09:27,190 --> 00:09:30,480
لا أستطيع تفعيلها ما لم يكن
النِّظام في خطر

123
00:09:30,480 --> 00:09:33,610
،بصيغة أخرى، أنا ملِك الموت المُتوهِّج
بحدِّ ذاتي بمثابة إله

124
00:09:33,820 --> 00:09:36,700
سيّد ملِك الموت المُتوهِّج، إله؟

125
00:09:36,700 --> 00:09:38,570
دعيني أُريكِ الدّليل

126
00:09:41,370 --> 00:09:43,080
،بموجب نِظام الإله الأب السّماويّ

127
00:09:43,080 --> 00:09:45,540
ملِك الموت المُتوهِّج أيردوميد يأمرك

128
00:09:45,540 --> 00:09:50,590
أن تُولَد أيّها الإله الحارِس الّذي
يحمي هذه الأنظمة والقوانين الأربعة

129
00:09:52,750 --> 00:09:55,840
...أ-أهذا حقّاً الإله الأب السّماويّ

130
00:09:57,170 --> 00:09:58,760
حسناً إذاً يا عثّة الكُتُب

131
00:09:59,390 --> 00:10:04,680
حاولي الدّخول في ميثاق. صلِّي بأن
يُصبح إلَهكِ المُستدعى الخاصّ

132
00:10:04,680 --> 00:10:06,180
مـ-ميثاق؟

133
00:10:06,770 --> 00:10:08,100
بهذا؟

134
00:10:10,190 --> 00:10:13,320
...لـ-لا أعتقد أنّ هذا ممكن

135
00:10:13,320 --> 00:10:14,480
يمكنكِ فعلها

136
00:10:15,230 --> 00:10:17,820
هؤلاء الآلهة الحُماة إن جاز
التّعبير هم أبنائي

137
00:10:17,820 --> 00:10:22,370
وأنتِ تلميذتي في نهاية المطاف

138
00:10:22,370 --> 00:10:25,200
عُـ-عُلِم

139
00:10:27,500 --> 00:10:34,630
سـ-سأفعل أيّ شيء تقولونه، لذا
من فضلكم هلّا أصبحتُم إلَهي المُستدعى؟

140
00:10:44,720 --> 00:10:46,470
استدعيهم الآن

141
00:10:47,640 --> 00:10:49,730
!لـ-ليتيلد

142
00:10:55,190 --> 00:11:00,700
ما-ما هذا؟ ينبغي أن تكوني قادرة على استدعاء
!إله واحد فقط بجوهرة العهد تلك

143
00:11:00,950 --> 00:11:04,700
فهمت. فهمت، فهمت، فهمت، فهمت

144
00:11:05,200 --> 00:11:06,330
!فهمتُ الآن يا عثّة الكُتُب

145
00:11:07,910 --> 00:11:09,750
لديكِ قوّة سحريّة ضئيلة

146
00:11:09,750 --> 00:11:14,130
إذا كان المصدر مُضيفاً، والقوّة السّحريّة
...ماء، فإنّ مُضيفك

147
00:11:14,130 --> 00:11:17,050
!فارغ بعض الشّيء...

148
00:11:17,050 --> 00:11:18,050
...أجل

149
00:11:20,300 --> 00:11:25,550
لكن هذا المُضيف هو أوسع وأكبر
وذو جودة أعلى من الآخرين

150
00:11:25,550 --> 00:11:29,100
لدرجة أنّه حتّى بعد استدعاء أربعة
آلهة، ما زالت هناك مساحة مُتبقّية

151
00:11:30,020 --> 00:11:33,190
نايا، شكّلي ميثاقاً معي أنا
ملِك الموت المُتوهِّج

152
00:11:33,190 --> 00:11:36,690
سوف أصبح إلَهكِ، وألبِّي لكِ أُمنياتكِ

153
00:11:36,940 --> 00:11:40,440
هذا تحدٍّ فاتن حقّاً يا ملِك الموت المُتوهِّج

154
00:11:40,820 --> 00:11:44,280
هذا سيجعل نِظام الإله الأب السّماويّ
نِظام نايا

155
00:11:44,280 --> 00:11:48,870
تحت أوامرها، بوسعك مُخالَفة
الزّيكت الّذي صنعته معي

156
00:11:49,410 --> 00:11:54,630
هل تلمّح إلى أنّني أنوي تربية نايا
بحيث تصبح عدوّاً لملِك الشّياطين؟

157
00:11:55,710 --> 00:11:56,500
نايا

158
00:11:56,500 --> 00:11:57,800
نـ-نعم؟

159
00:11:57,800 --> 00:12:00,050
ما رأيكِ بملِك الموت المُتوهِّج؟

160
00:12:01,760 --> 00:12:03,760
إنّه مُعلّمٌ جيّد جدّاً

161
00:12:03,760 --> 00:12:05,760
،إنّه يعلّمني بأنّني إذا بقيتُ معه

162
00:12:05,760 --> 00:12:10,560
فذات يوم، حتّى أنا قد أفعل
شيئاً مُفيداً لديلهيد

163
00:12:10,930 --> 00:12:15,190
معكِ حقّ. إذا وثقتِ به، وشعرتِ
،بأنّكِ مَدينة لهل

164
00:12:15,190 --> 00:12:17,770
فينبغي أن تشكريه إذاً مع إحرازِ تقدُّماً

165
00:12:19,020 --> 00:12:19,820
...أجل

166
00:12:21,030 --> 00:12:22,900
،من كان يتوقّع أن تُشجِّع ملِك الموت المُتوهِّج

167
00:12:22,900 --> 00:12:25,570
!ناهيك عن مُعاملتي بلِين

168
00:12:25,570 --> 00:12:28,530
مُواجِهاً كلّ شيء بشكل مُباشَر، تثنيهم
!وفق إرادتك وتفوز

169
00:12:28,530 --> 00:12:31,540
!هذا استبداديّ بحقّ. أنتَ فعلاً ملِك شياطين

170
00:12:32,120 --> 00:12:36,670
وهكذا أنا، ملِك الموت المُتوهِّج، سوف
!أرتقي لتوقُّعاتك بكلّ ما أملك

171
00:12:36,670 --> 00:12:38,420
حسناً إذاً، أخبريني ما هي أُمنيتكِ

172
00:12:38,840 --> 00:12:41,590
!لنُشكِّل ميثاقاً مع بعضنا الآخر

173
00:12:41,590 --> 00:12:45,180
...أ-أمنية؟ المعذرة... لنرَ

174
00:12:46,590 --> 00:12:50,890
هلّا بقيت... مُعلّمي للأبد؟

175
00:12:51,930 --> 00:12:56,940
...أقبل. من كلّ حقيقة في الوجود، إلى توافه الأمور

176
00:12:56,940 --> 00:13:03,860
سوف أزرعها كلّها في عقلكِ وجسدكِ
!وروحكِ اللّينة

177
00:13:07,240 --> 00:13:08,570
...حسناً إذاً

178
00:13:08,990 --> 00:13:14,000
...أيّها الإله الأب السّماويّ العظيم
...وقدّيسك المختار

179
00:13:14,000 --> 00:13:18,040
ألا تنحني للشّخص الخطأ؟

180
00:13:18,040 --> 00:13:20,540
ملِك الشّياطين هناك هو الوحيد
القادر على أن يحكمني

181
00:13:20,880 --> 00:13:24,970
لـ-لـ-لكن الإله هو كائن رفيع
...يعلو على كلّ ملِك

182
00:13:24,970 --> 00:13:29,010
إذاً تذكّر هذا. ملِك الشّياطين هو
كائن يعلو أكثر حتّى

183
00:13:29,180 --> 00:13:33,970
هذا الرّجل هو من منحني نِظام
الإله الأب السّماويّ

184
00:13:33,970 --> 00:13:39,230
ماذا؟ في هذه الحالة، فلا بدّ أنّك المُشِع
العظيم إكويس إذاً، أليس كذلك؟

185
00:13:39,560 --> 00:13:42,690
لا تكُن رسميّاً. هذا ليس أنا

186
00:13:42,690 --> 00:13:47,110
لا أعرف ما يكمن في قلبك، لكن سأثِق بقولك

187
00:13:47,110 --> 00:13:50,370
بالمناسبة، كيف يستطيع المرء لِقاء
البابا في هذا البلد؟

188
00:13:51,530 --> 00:13:54,500
...سأذهب لأرتِّب لك الأمر. لكن

189
00:13:54,870 --> 00:14:01,170
قبل أن أفعل ذلك، هل يمكن لقلبِك أن يصغي
لهذا التّابع البائس؟

190
00:14:01,170 --> 00:14:02,550
يمكنك التكلُّم

191
00:14:03,550 --> 00:14:07,800
في هذا البلد، هناك أحمق
استسلم للهرطَقة

192
00:14:07,800 --> 00:14:13,430
يشتم الآلهة ويرفض وجود المُشِعّ
العظيم إكويس

193
00:14:14,520 --> 00:14:15,890
ما اسم هذا الرّجل؟

194
00:14:16,230 --> 00:14:18,390
الكاردينال السّابق، آهيدي

195
00:14:18,390 --> 00:14:20,350
،في فترة ما زُجَّ في السّجن

196
00:14:20,350 --> 00:14:25,320
،لكن هرب بمُساعدة غاديشيولا الهرطقيّة
حيث يُعبَد الآلهة الوثنيّون

197
00:14:26,820 --> 00:14:29,570
غداً، سيُقام مهرجان تراتيليّ

198
00:14:29,570 --> 00:14:32,240
...سيظهر ذلك الأحمق الملعون من جديد

199
00:14:32,870 --> 00:14:38,540
فهمت. إذاً لنأخذ آهيدي معنا كهديّة للبابا

200
00:14:43,790 --> 00:14:45,880
كانت أصواتكن جميلة جدّاً

201
00:14:46,300 --> 00:14:48,550
!شكراً جزيلاً لكِ يا آنسة إيرينا

202
00:14:48,840 --> 00:14:54,260
لو أتيتن أبكر قليلاً، لطلبتُ منكن
غِناء ترنيمة الزّائر المُؤقّت

203
00:14:54,600 --> 00:14:56,270
ترنيمة الزّائر المُؤقّت؟

204
00:14:56,270 --> 00:15:01,600
إنّها طقوس يغنّي فيها الحجّاج من العالم
الخارجيّ أغنيةً جديدة كهِبة

205
00:15:01,600 --> 00:15:03,690
يمكنكن المجيء والمشاهدة إن أردتن

206
00:15:04,060 --> 00:15:05,070
!حسناً

207
00:15:09,280 --> 00:15:12,990
هذا هو نُزُل اللّيلة. يمكنكم استخدامها
بالشّكل الّذي ترونه مناسباً

208
00:15:16,490 --> 00:15:19,040
هل يُفترَض لهذه الغرفة أن تعني شيئاً؟

209
00:15:19,040 --> 00:15:21,710
إنّها للتّرفيه فقط. دعيني أدلّكِ

210
00:15:29,670 --> 00:15:30,880
هل هذا...؟

211
00:15:30,880 --> 00:15:32,430
،في ذلك الحلم الّذي رأيتُه في تلك اللّيلة

212
00:15:32,430 --> 00:15:35,220
رأيتُ أيضاً المنزل حيث عشتُ مع أختي الصُّغرى

213
00:15:35,220 --> 00:15:36,720
حاولتُ إعادة إنشائه

214
00:15:39,600 --> 00:15:42,600
لا أعرف السّبب، لكن يبدو مألوفاً

215
00:15:42,600 --> 00:15:46,190
على ذكرِ الأمر، لم أخبرك باسم
أختي بعد، أليس كذلك؟

216
00:15:46,860 --> 00:15:47,940
إنّه أركانا

217
00:15:48,230 --> 00:15:49,820
نفس اسمي

218
00:15:50,150 --> 00:15:54,660
أو قبل ألفَي عام، لعلّكِ كنتِ أختي الصُّغرى

219
00:15:56,410 --> 00:16:00,120
أركانا، هل تريدين استرجاع ذاكرتكِ؟

220
00:16:01,160 --> 00:16:06,710
ربّما تمنّيتِ أيضاً أن تتخلّصي
من ذكرياتكِ كذلك

221
00:16:06,710 --> 00:16:08,880
ليس فَرْضاً أن تتمكّني من نسيانهم ثانية

222
00:16:10,050 --> 00:16:13,130
كان التخلِّي عن اسمي خطيئتي حتماً

223
00:16:14,090 --> 00:16:17,180
سبّبتُ له اليأس في النّهاية

224
00:16:17,430 --> 00:16:22,230
مهما كان قد حدث في الماضي، لا أعتقد
بأنّه يُفترَض أن أنساه

225
00:16:22,850 --> 00:16:24,600
كنت أنت من علّمني ذلك

226
00:16:25,650 --> 00:16:27,900
لا بدّ من وجود طريقة لاستعادة
،اسمي الإلهيّ وذكرياتي

227
00:16:27,900 --> 00:16:30,900
دون خسارة عواطفي أيضاً

228
00:16:30,900 --> 00:16:36,030
ثمّ الاستمرار في مساعدة النّاس
ينبغي أن يكون تكفيراً لي

229
00:16:36,030 --> 00:16:39,160
إذا اتّخذتِ قراركِ، فهذا جيّد إذاً

230
00:16:43,210 --> 00:16:47,170
،الذّكريات المُضطربة، مع إضافة كلّ حلم
تطفو فوق سطح الماء

231
00:16:47,170 --> 00:16:48,130
ما معنى هذا؟

232
00:16:48,460 --> 00:16:51,130
...لو كنتُ أختك الصّغرى

233
00:16:53,510 --> 00:16:57,640
فمع إضافة أحلام إذاً، قد أتمكّن
من استرجاع ذكرياتي

234
00:16:58,050 --> 00:17:00,140
!لحظة واحدة فقط أيّتها الإلاهة البذيئة

235
00:17:00,140 --> 00:17:02,520
ما دمتُ موجودة، لنل أسمح لكِ
!بالقيام بعمل فاضح

236
00:17:02,810 --> 00:17:06,850
يا ابنة الشّياطين. هذا ضروريّ
لاسترجاع الذّكريات

237
00:17:07,020 --> 00:17:08,810
!مسكينة

238
00:17:08,810 --> 00:17:12,570
هل خلتِ حقّاً أنّه يترتّب عليكِ النّوم"
"معه من أجل استرجاع ذاكرتكِ؟

239
00:17:12,570 --> 00:17:13,860
!هذا ما يقوله آنوس

240
00:17:14,610 --> 00:17:16,740
لا سبب يدفع لتجنُّب النّوم أيضاً

241
00:17:18,070 --> 00:17:20,410
ساشا قلِقة عليك يا آنوس

242
00:17:20,410 --> 00:17:22,660
قلِقة من أن تفعل أركانا شيئاً لي؟

243
00:17:24,410 --> 00:17:27,790
أركانا فتاة طيّبة. لكن نبقى قلِقتين

244
00:17:28,210 --> 00:17:29,630
إذاً ينبغي أن تُراقباها

245
00:17:30,130 --> 00:17:31,130
ماذا؟

246
00:17:31,380 --> 00:17:33,460
دعاها تُريكما حلماً معي

247
00:17:33,460 --> 00:17:38,050
،إذا لمستُما حارِس النّظام بشكل مُباشر
فستعرفان عندما يحدث شيء

248
00:17:38,260 --> 00:17:40,890
...لـ-لكن هذا يعني

249
00:17:40,890 --> 00:17:42,180
النّوم معك أيضاً؟

250
00:17:43,020 --> 00:17:46,230
بوجودكما بجانبي، يمكنني الاطمئنان

251
00:17:46,890 --> 00:17:48,230
هكذا إذاً

252
00:17:48,230 --> 00:17:53,360
...فهمت... إن كان هذا ما تقوله يا آنوس
—فأعتقد سنكون مضطرّتين لـ

253
00:17:57,320 --> 00:17:57,990
ما الخطب؟

254
00:17:58,740 --> 00:17:59,870
نحن بمثابة عائلة

255
00:17:59,870 --> 00:18:01,330
أهذا ما يبدو؟

256
00:18:01,330 --> 00:18:01,990
أجل

257
00:18:04,540 --> 00:18:07,660
دون تمييز، دون حدود

258
00:18:08,210 --> 00:18:12,290
لـ-لحظة... هل هذه هي اللّحظة
الّتي نتعرّى فيها؟

259
00:18:18,300 --> 00:18:19,130
من أنتم؟

260
00:18:19,380 --> 00:18:21,720
وجدناها. الطّفلة القربان

261
00:18:21,720 --> 00:18:24,220
حسناً إذاً. قدِّمي نفسكِ للآلهة

262
00:18:24,470 --> 00:18:26,560
!لـ-لا! أخي

263
00:18:30,600 --> 00:18:32,730
هل أردتُم شيئاً من أختي؟

264
00:18:32,730 --> 00:18:33,860
!أخي

265
00:18:33,980 --> 00:18:38,070
لأنّكما اختطفتُما ابنتي، التّنانين
!هائجة في كلّ مكان

266
00:18:38,400 --> 00:18:44,030
...أنتم البالغون جلستُم مكتوفي الأيدي
!لذا لا تلوموني وتلوموا أختي بلا سبب

267
00:18:44,740 --> 00:18:47,750
تعلّمتُ هذه التّعويذة للتو. ينبغي أن تُجرّبوها

268
00:18:54,550 --> 00:18:57,710
آسف لإخافتكِ. أنتِ بأمان الآن

269
00:18:59,680 --> 00:19:04,720
.اسمع... لم أكن خائفة إطلاقاً
...لأنّ... لأنّ

270
00:19:04,720 --> 00:19:07,810
!لأنّني عرفتُ بأنّك ستنقذني يا أخي

271
00:19:09,600 --> 00:19:10,940
لنتناول العشاء الآن

272
00:19:16,900 --> 00:19:20,740
اسمع يا أخي، أريدك أن تقرأ لي قصّة ثانية

273
00:19:20,740 --> 00:19:21,410
هل يمكنك؟

274
00:19:21,780 --> 00:19:23,780
القصّة المعتادة؟ -
أجل -

275
00:19:30,960 --> 00:19:34,500
كانت هناك فتاة تُدعى دورا
في قرية نائية بعيدة

276
00:19:35,090 --> 00:19:38,670
كانت ابنة رجل نبيل، وساحر قويّ

277
00:19:38,670 --> 00:19:43,590
مُختبِئة من الأشرار، كانت تُشفي
الأمراض المُميتة سرّاً

278
00:19:43,590 --> 00:19:46,810
وهي كذبة تمّ تلفيقها بواسطة دورا

279
00:19:46,810 --> 00:19:49,980
،احتار القرويّون من كذبة دورا

280
00:19:49,980 --> 00:19:54,480
لكن ذات يوم، كشفَ صبيٌّ كذبتها
فوجدَتْ نفسها وحيدة تماماً

281
00:19:54,980 --> 00:19:57,520
،لكن استمرّتْ دورا مع ذلك في الكذِب

282
00:19:57,520 --> 00:20:01,150
حتّى جاء يوم وصدّقَتْ بأنّ
أكاذيبها كانت الحقيقة

283
00:20:01,150 --> 00:20:04,950
،وهكذا، وصلَتْ إلى لحظاتها الأخيرة

284
00:20:04,950 --> 00:20:06,780
دون أن يُصدِّقها أحد على الإطلاق

285
00:20:09,240 --> 00:20:12,040
كالعادة، لا أفهم ما المُثير في هذه القصّة

286
00:20:12,040 --> 00:20:13,870
ما الّذي يُعجبكِ فيها؟

287
00:20:13,870 --> 00:20:18,050
!في الواقع... تبدو دورا مستمتعة وهي تكذب

288
00:20:18,050 --> 00:20:22,050
إذا ظللتِ تقولين كلاماً كهذا، فسوف
ينتهي المطاف بكِ مثل دورا

289
00:20:22,880 --> 00:20:28,720
لـ-لا أريد ذلك! أحبُّ دورا، لكن
!لا أريد أن أعيش وحيدة

290
00:20:29,390 --> 00:20:33,230
هيّا يا أخي. أريدك الآن أن تقرأ
!لي تلك الجزئيّة

291
00:20:33,230 --> 00:20:34,140
أي جزء؟

292
00:20:34,140 --> 00:20:35,480
!خمِّن بنفسك

293
00:20:40,530 --> 00:20:41,440
ما الأمر؟

294
00:20:41,440 --> 00:20:43,150
...المعذرة

295
00:20:44,030 --> 00:20:48,580
!أكلتُ خبزتي بلقمة واحدة، كدتُ أختنق

296
00:20:48,580 --> 00:20:51,120
وجدتُها. تريدني أن أعطيك لمحة؟

297
00:20:51,580 --> 00:20:52,620
أركانا

298
00:20:54,710 --> 00:20:55,670
ماذا؟

299
00:20:55,670 --> 00:20:59,750
كنتِ تعاملينني بلطف لأنّكِ ظننتِ بأنّني
سأخرج للصّيد وتوفير الطّعام ثانية، صحيح؟

300
00:20:59,750 --> 00:21:05,300
،في الواقع، نظراً للبرد في الخارج
وسأشعر بالشّفقة عليك يا أخي

301
00:21:06,800 --> 00:21:09,100
هذا النّوع من الكذِب لن يضرّ أحداً

302
00:21:09,430 --> 00:21:12,350
لن ينتهي المطاف بكِ مثل دورا أبداً

303
00:21:15,890 --> 00:21:16,980
آنوس

304
00:21:18,020 --> 00:21:19,560
هل يمكنك النُّهوض؟

305
00:21:19,560 --> 00:21:20,320
هل طلع الصّباح؟

306
00:21:21,650 --> 00:21:23,820
رأيتُ نفس حلمك

307
00:21:24,190 --> 00:21:29,240
غريب، أليس كذلك؟ لا ينبغي أن يكون هناك
أي دراكونيد قبل ألفَي عام

308
00:21:29,530 --> 00:21:33,870
شاهدتُ حلماً كنتَ فيه صغيراً وظريفاً يا آنوس

309
00:21:33,870 --> 00:21:34,870
هل من شيء آخر؟

310
00:21:34,870 --> 00:21:37,290
...آخر؟ ممممم

311
00:21:37,580 --> 00:21:38,750
لم أرَ شيئاً

312
00:21:38,750 --> 00:21:44,550
بمعزل عن حلمنا، رأيتُ هاتين الاثنتين يريان
حلماً قبل أن يُعاد تجسيدهما

313
00:21:44,760 --> 00:21:47,180
لكن لم تريا شيئاً، صحيح؟

314
00:21:47,880 --> 00:21:49,890
!مـ-مهلاً يا آنوس

315
00:21:49,890 --> 00:21:51,970
!بما أنّك مستيقظ، فارتدِ بعض الملابس

316
00:21:58,480 --> 00:22:00,810
مُذهل! هذا هو المهرجان؟

317
00:22:01,150 --> 00:22:03,280
!لا أطيق انتظار الاستماع لها
!ترنيمة الزّائر المُؤقَّت

318
00:22:07,570 --> 00:22:08,820
لِمَ تنظرين إليّ هكذا؟

319
00:22:08,820 --> 00:22:12,700
أنت لا تؤمن بالآلهة وتمقتهم، أليس كذلك؟

320
00:22:13,160 --> 00:22:17,160
لا أنكر ذلك. رغم ذلك، الدّين مُختلِف
بالنّسبة للجميع

321
00:22:17,160 --> 00:22:22,540
إن حضرتِه، فإقامة صلاة لأجلهم
هو تصرُّف ملائم ومُهذَّب

322
00:22:22,920 --> 00:22:26,130
أنت ملِك شياطين، وتبدو كشخص
يمتلِك منطِقاً شائعاً

323
00:22:26,130 --> 00:22:31,300
آنوس قلِق بشأن مُحاولة آهيدي
إفساد المهرجان

324
00:22:31,300 --> 00:22:34,600
لكن ليس وكأنّها غلطته

325
00:22:34,600 --> 00:22:38,270
لو لم يكن تحت نيدنيلياز، لما كان
مُضطرّباً. النّاس سيموتون

326
00:22:40,810 --> 00:22:42,730
لـ-لِمَ تضحك؟

327
00:22:42,730 --> 00:22:46,740
لا شيء. كنتُ أقول لنفسي فقط
بأنّ لديّ بعض الأتباع طيّبي القلب

328
00:22:47,860 --> 00:22:50,410
ثمّة شيء على وشك أن يبدأ

329
00:22:52,620 --> 00:22:57,450
مولايّ، نحن مُمتنّون لأنّنا استطعنا
أن نشهد على هذا اليوم من جديد

330
00:23:00,370 --> 00:23:06,250
ترنيمة الزّائر المُؤقَّت. ستكون أغنية اليوم
إلهيّة من جديد، وتصبح لحناً مُقدّساً

331
00:23:06,250 --> 00:23:08,220
استمعوا إليها لبعض الوقت

332
00:23:08,220 --> 00:23:10,720
يا مُواطِنو جيوردال، اسمعوني

333
00:23:10,720 --> 00:23:11,720
ماذا؟

334
00:23:11,720 --> 00:23:13,640
ما هذا فجأة؟

335
00:23:13,640 --> 00:23:20,020
الإله غير موجود. المُشِعّ العظيم إكويس
هو كذبة لفّقَها البابا الأوّل

336
00:23:20,020 --> 00:23:23,560
كدليل، ستتوقّف ترنيمة الزّائر
المُؤقَّت عن الوجود هنا

337
00:23:23,560 --> 00:23:24,560
...هذا الصّوت

338
00:23:26,440 --> 00:23:30,650
أنا كاردينال جيوردال، آهيدي آلوبو أغاتزي

339
00:23:30,650 --> 00:23:34,660
أتيتُ لنقل الحقيقة لكم جميعاً

340
00:23:35,660 --> 00:23:40,000
"ترتيلة ملِك الشّياطين رقم 6 "جيران