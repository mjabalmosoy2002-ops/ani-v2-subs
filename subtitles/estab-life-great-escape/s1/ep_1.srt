1
00:00:03,210 --> 00:00:09,680
فلتهبهم الراحة الأبديّة يا رب

2
00:00:09,680 --> 00:00:13,240
وتنرهم بنورك الدائم

3
00:00:13,600 --> 00:00:16,040
فليرقدوا في أمان

4
00:00:16,040 --> 00:00:21,000
...أدعوك باكياً من الأعماق يا رب

5
00:00:18,170 --> 00:00:20,070
كلّ شيءٍ جاهز

6
00:00:20,070 --> 00:00:20,990
حسناً

7
00:00:21,410 --> 00:00:25,260
الموت مُحزن، لكنّه شافٍ أيضاً

8
00:00:25,870 --> 00:00:29,110
من الطبيعيّ أن يُصاب
،المتروكون بالأسى

9
00:00:29,110 --> 00:00:32,800
لكنّ الموت بداية الأبديّة أيضاً

10
00:00:32,800 --> 00:00:36,140
عندما يغفر إلهنا خطايا الراحلين

11
00:00:36,140 --> 00:00:39,930
ويجعل أرواحهم دائمة

12
00:00:40,330 --> 00:00:45,240
باسم الأب والابن والروح
المقدّسة، آمين

13
00:01:19,990 --> 00:01:22,380
تمّ التحقّق، يمكنكم المرور

14
00:01:23,750 --> 00:01:24,470
!مهلك

15
00:01:25,560 --> 00:01:26,930
!فات الأوان

16
00:01:27,130 --> 00:01:29,570
حسناً، سنشقّ طريقنا بالقوّة إذاً

17
00:01:38,650 --> 00:01:39,820
...مؤلم

18
00:01:43,260 --> 00:01:44,550
كيف الحمولة؟

19
00:01:44,550 --> 00:01:45,450
سليمة

20
00:01:45,450 --> 00:01:46,940
حمداً لله

21
00:01:46,940 --> 00:01:48,310
ما الذي يجري؟

22
00:01:48,310 --> 00:01:50,020
ماذا تظنّين نفسك فاعلة؟

23
00:01:50,020 --> 00:01:52,660
قلتِ أنّ كلّ ما عليّ
!فعله هو الاستلقاء

24
00:01:53,050 --> 00:01:55,080
طرأ تغيير بسيطٌ على الجدول

25
00:01:55,080 --> 00:01:56,840
بسبب عطاسك

26
00:01:56,840 --> 00:01:59,180
ألا يُفترض أنّكم مُستخرجون محترفون؟

27
00:01:59,180 --> 00:02:00,840
!يجدر بكم أن تمكّنوني من الهروب

28
00:02:00,840 --> 00:02:03,110
أجل، سنفعل بلا شكّ

29
00:02:03,680 --> 00:02:05,110
ها هم

30
00:02:07,160 --> 00:02:08,910
اتّجه للبوابة الأخرى

31
00:02:18,940 --> 00:02:20,640
لا نهاية لهم

32
00:02:22,180 --> 00:02:24,150
من أين يظهرون؟

33
00:02:25,600 --> 00:02:27,950
كفّي عن الكلام
!واقضي عليهم وحسب

34
00:02:28,240 --> 00:02:30,930
أأنت جاهزٌ يا آلغا-سان؟

35
00:02:30,930 --> 00:02:32,110
في أيّ وقت

36
00:02:32,810 --> 00:02:35,700
إنّني أراها، بوّابة أكيهابارا

37
00:02:45,300 --> 00:02:46,870
كم سيستغرق الأمر؟

38
00:02:46,870 --> 00:02:49,910
،ثلاث ثوانٍ على الأقل
وثلاثة أشهر بحدٍّ أقصى

39
00:02:49,910 --> 00:02:54,280
هذه طريقةٌ أخرى لقول
أنّك لا تعرف، صحيح؟

40
00:03:06,890 --> 00:03:08,470
...مؤلم

41
00:03:08,470 --> 00:03:12,630
خسرتُ قرابة 5% من وزن
جسدي بسبب ذلك

42
00:03:12,630 --> 00:03:14,650
جسدكِ مفيدٌ فعلاً

43
00:03:18,290 --> 00:03:20,300
لا نهاية لهم بحقّ

44
00:03:21,340 --> 00:03:22,290
نجحت

45
00:03:22,920 --> 00:03:25,990
إذا قطعت السلك الصحيح، ستُفتح البوّابة

46
00:03:25,990 --> 00:03:27,940
كالعادة إذاً

47
00:03:28,420 --> 00:03:30,160
وإذا قطعنا السلك الخطأ؟

48
00:03:30,160 --> 00:03:33,160
إقفالٌ شامل، لن يكون لنا مهرب

49
00:03:33,160 --> 00:03:35,660
ذلك كالمعتاد

50
00:03:45,350 --> 00:03:47,060
!افعليها أيّتها القائدة

51
00:03:47,970 --> 00:03:49,150
!أجل

52
00:05:30,830 --> 00:05:32,760
أراكم لاحقاً إذاً

53
00:05:33,770 --> 00:05:34,600
أجل

54
00:05:47,990 --> 00:05:49,720
أليس الطقس جميلاً؟

55
00:05:51,530 --> 00:05:55,880
قالت النشرة أنّ المطر سيهطل
ظهيرة اليوم، لكنّه غالباً لن يفعل

56
00:05:55,880 --> 00:06:01,320
حلمتُ أنّنا ذهبنا نحن الاثنتان
في تمشية ظهيرةٍ جميلة

57
00:06:01,320 --> 00:06:04,870
ابتعدي عني، سيعتقد الناس أنّنا صديقتان

58
00:06:05,060 --> 00:06:06,920
لكنّنا كذلك

59
00:06:06,920 --> 00:06:11,180
!أخبرتِني أنّ عمل الأمس سيكون آمناً

60
00:06:11,180 --> 00:06:12,850
كدتُ ألقى حتفي

61
00:06:12,850 --> 00:06:14,090
...أيعني ذلك

62
00:06:14,520 --> 00:06:16,120
أنّنا لم نعد صديقتين؟

63
00:06:18,230 --> 00:06:20,690
!لا أستطيع احتمال انتهاء صداقتنا

64
00:06:20,690 --> 00:06:24,410
أخبرتكِ أن تتوقّفي! كانت علاقتنا
!محض علاقة عملٍ من الأصل

65
00:06:24,410 --> 00:06:25,540
نحن صديقتان

66
00:06:25,540 --> 00:06:26,760
!ابتعدي! لا تقتربي مني

67
00:06:26,760 --> 00:06:27,610
!اذهبي

68
00:06:28,250 --> 00:06:30,730
!صباح الخير

69
00:06:31,200 --> 00:06:32,970
مارتيس-سان

70
00:06:33,450 --> 00:06:36,830
إيكوا-سينباي، أنتِ جميلةٌ
ورائعةٌ اليوم كالمعتاد

71
00:06:37,900 --> 00:06:39,460
...فيليس-سينباي، أنتِ

72
00:06:40,590 --> 00:06:42,760
حسناً، لا بأس بكِ كما أظنّ

73
00:06:44,000 --> 00:06:49,450
!هيّا يا إيكوا-سينباي، انسي أمرها وعانقيني

74
00:06:49,450 --> 00:06:52,250
!لنشدّد أواصر رابطتنا بعصرٍ حميميّ

75
00:06:52,250 --> 00:06:54,420
حسناً، عصر عصر

76
00:06:54,420 --> 00:06:55,960
عصر عصر

77
00:06:56,890 --> 00:06:58,960
أنتِ أيضاً يا فيليس-سان، عصر عصر

78
00:06:58,960 --> 00:07:00,750
!أخبرتكِ بأن تتوقّفي

79
00:07:00,750 --> 00:07:01,930
يا إلهي

80
00:07:01,930 --> 00:07:04,620
أجل، توقّفي، اذهبي بعيداً

81
00:07:04,620 --> 00:07:07,410
عصر عصر

82
00:07:11,080 --> 00:07:14,920
هذه فقرةٌ من زرادشت لنيتشه

83
00:07:15,370 --> 00:07:21,330
"...لا تتوقّف يدي عن مدّي بالفقر"

84
00:07:21,330 --> 00:07:24,280
...فيليس-سان، بشأن ما حصل بالأمس

85
00:07:24,280 --> 00:07:26,170
يكفي من ذلكٍ

86
00:07:26,170 --> 00:07:28,900
أعتذر على زلّتي

87
00:07:37,510 --> 00:07:38,630
!فيليس-سان

88
00:07:39,920 --> 00:07:41,960
سأتوخَّ الحذر من الآن فصاعداً

89
00:07:41,960 --> 00:07:43,220
لا تتبعيني

90
00:07:48,230 --> 00:07:49,440
أتودّين مساعدةً في خلع الثياب؟

91
00:07:49,440 --> 00:07:50,940
!كأنّني

92
00:07:52,490 --> 00:07:54,780
إذاً؟ هل رفضتك؟

93
00:07:55,740 --> 00:07:58,070
انسي أمرها وحسب

94
00:07:58,430 --> 00:08:02,290
إنّها مغرمةٌ بك بالأصل سرّاً

95
00:08:02,290 --> 00:08:03,940
أحقّاً ذلك؟

96
00:08:03,940 --> 00:08:06,720
إنّها غير مُخلصة لرغباتها

97
00:08:06,720 --> 00:08:08,490
ذلك مُثيرٌ للاشمئزاز

98
00:08:08,490 --> 00:08:11,340
مُثير للاشمئزاز؟ عليكِ ألّا
تنعتِ الآخرين بهذه العبارات

99
00:08:11,340 --> 00:08:13,130
...ماذا؟ لكن

100
00:08:13,130 --> 00:08:15,250
لا يصحّ ذلك

101
00:08:19,780 --> 00:08:22,210
شكراً لك على كلّ شيء
يا يامادا-سينسي

102
00:08:23,120 --> 00:08:25,970
...أنتِ... حسناً

103
00:08:25,970 --> 00:08:28,600
إيكوا، طالبة في السنة
الثانية، الفصل أ

104
00:08:28,820 --> 00:08:31,470
الدرس على وشك البدء

105
00:08:31,470 --> 00:08:33,630
أسرعي لفصلك

106
00:08:36,990 --> 00:08:39,060
سينسي؟ أأنت بخير؟

107
00:08:42,030 --> 00:08:45,540
،مجرّد آثار ثمالة بسيطة
لا تبالي بي

108
00:08:48,540 --> 00:08:52,740
يعرف الجميع تزمّت يامادا-سينسي

109
00:08:53,270 --> 00:08:57,600
أيتوقّع منّا تصديق أنّه
يعاني آثار ثمالةٍ حقّاً؟

110
00:08:57,600 --> 00:09:00,470
قد تكون هنالك ظروف خفيّة

111
00:09:00,820 --> 00:09:03,360
لعلّه يعاني مرضاَ خطيراً

112
00:09:03,360 --> 00:09:08,420
مثل الزهريّ أو السيلان
أو المتدثرة التراخومية

113
00:09:11,840 --> 00:09:13,470
إنّها من إم-سان

114
00:09:13,760 --> 00:09:16,430
عملٌ آخرٌ بهذه السرعة؟

115
00:09:20,520 --> 00:09:24,960
يبدو أنّه رُفع للتو، وبه شفرة مدمجة

116
00:09:25,350 --> 00:09:28,340
لا بدّ أنّ ذاك المعلّم
جادٌ حيال هذا

117
00:09:28,690 --> 00:09:31,320
اختراق نقطة تفتيش
قد يعرّضه للقتل

118
00:09:32,700 --> 00:09:34,800
...لذا يحتاج

119
00:09:36,190 --> 00:09:38,550
مُستخرجين مثلنا

120
00:09:42,550 --> 00:09:44,370
كلا، مستحيل

121
00:09:44,830 --> 00:09:46,250
أرفق قطعاً

122
00:09:46,250 --> 00:09:48,020
حسناً، إلى اللقاء

123
00:09:48,020 --> 00:09:52,130
فيليس-سان، ألا ترين أنّ العمل
أكثر تسليةً عندما نقوم به سويّةً؟

124
00:09:52,130 --> 00:09:53,750
تظنّين تلك المشكلة؟

125
00:09:53,750 --> 00:09:55,180
أجل

126
00:09:55,180 --> 00:09:59,870
ليست كذلك، أخبركِ أنّي
سئمت من المخاطرة بحياتي

127
00:10:00,060 --> 00:10:02,140
سيمضي الأمر بخيرٍ
هذه المرّة حتماً

128
00:10:02,340 --> 00:10:04,950
لا يمكنني الوثوق بـ "حتماً" منك

129
00:10:05,260 --> 00:10:09,520
ولا تلحّي لهذا الحدّ، أليس ما تقصدينه
هو "قريبٌ جدّاً من حتماً"؟

130
00:10:09,520 --> 00:10:10,420
أجل

131
00:10:10,420 --> 00:10:12,000
لن ألحّ حتماً

132
00:10:16,830 --> 00:10:20,100
ها أنتِ مجدّداً، أنتِ هكذا دوماً

133
00:10:20,680 --> 00:10:21,880
!لا تدفعي

134
00:10:21,880 --> 00:10:23,340
لم أستطع منع نفسي

135
00:10:32,670 --> 00:10:34,900
لا تأتي إذا لم تريدي

136
00:10:35,590 --> 00:10:38,190
،يا لعلاقتهنّ الوطيدة
ألا تتّفق يا أولولا؟

137
00:10:39,770 --> 00:10:42,140
أأنتم جاهزون جميعاً؟

138
00:10:43,490 --> 00:10:46,510
عميلنا هذه المرّة
هو إيتشيرو يامادا-سان

139
00:10:46,510 --> 00:10:49,960
ويُصادف أنّه معلّمٌ
في مدرستنا

140
00:10:50,330 --> 00:10:54,470
يبدو أنّ التعليم أرهقه
بحيث يشعر برغبةٍ بالهرب

141
00:10:54,470 --> 00:10:57,510
أزمة مُنتصف عمر؟ بائس

142
00:10:58,250 --> 00:11:01,590
ماذا؟ أأنت في صفّه؟
لأنّك مُسنّ؟

143
00:11:04,000 --> 00:11:05,940
أيّة أسئلة؟

144
00:11:05,940 --> 00:11:08,670
أجل، لأين سنستخرجه؟

145
00:11:08,910 --> 00:11:13,590
،يبدو أنّه لا يملك تفضيلاً
لذا سنقرّر بالطريقة المعتادة

146
00:11:13,590 --> 00:11:15,890
أيمكن أن يكون فخّاً؟

147
00:11:15,890 --> 00:11:18,550
أنا أؤيد التخلّي عن
العملاء المزعجين

148
00:11:18,550 --> 00:11:20,020
لن نتخلّى عن أحد

149
00:11:20,020 --> 00:11:20,980
...لكن

150
00:11:21,580 --> 00:11:23,710
لن نتخلّى عن أحدٍ أبداً

151
00:11:39,290 --> 00:11:40,490
يامادا-سينسي

152
00:11:40,490 --> 00:11:41,410
سيّدتي

153
00:11:41,720 --> 00:11:43,390
أتشعّر بتوعّكٍ من جديد؟

154
00:11:43,390 --> 00:11:45,180
آسف

155
00:11:45,180 --> 00:11:47,630
لا تضغط على نفسك
كثيراً من فضلك

156
00:11:47,630 --> 00:11:52,160
فأنت ستدرّس هنا
لبقيّة حياتك

157
00:11:52,460 --> 00:11:55,940
لبقيّة... حياتي؟

158
00:11:55,940 --> 00:12:00,030
أجل، بالطبع. فقد وُلِدتَ
هنا في أوتشانوميزو

159
00:12:00,410 --> 00:12:04,510
لكن إذا كنت مرهقاً، فربما
عليك أخذ عطلة

160
00:12:05,730 --> 00:12:07,150
...وبعدها

161
00:12:08,700 --> 00:12:11,520
وبعد عطلتي، سأعود للتدريس؟

162
00:12:11,520 --> 00:12:15,190
بالطبع، درّس ملأ قلبك

163
00:12:15,190 --> 00:12:18,650
...انغمس في بهجة تعليم تلامذتك

164
00:12:19,870 --> 00:12:20,590
ماذا؟

165
00:12:24,790 --> 00:12:26,130
سيّدتي؟

166
00:12:26,130 --> 00:12:28,370
جعلتها تغفو قليلاً لا أكثر

167
00:12:28,850 --> 00:12:32,240
ألستِ... أحد تلامذتي؟

168
00:12:32,650 --> 00:12:33,640
بلى

169
00:12:35,040 --> 00:12:37,500
أ-أنتِ مُستخرِجة؟

170
00:12:37,870 --> 00:12:40,060
أتيتُ لتأكيد نواياك

171
00:12:40,650 --> 00:12:45,640
هربك من المنطقة التي تعيش فيها
سيعني تخلّيك عن كلّ شيء

172
00:12:45,900 --> 00:12:48,880
ستفقد مقامك الاجتماعيّ وثروتك

173
00:12:49,290 --> 00:12:51,520
لن تمتلك ضماناً لحياتك المستقبليّة

174
00:12:53,830 --> 00:12:58,960
ولا يُبدي مشرف هذا التجمّع
أي شفقةٍ للهاربين

175
00:12:59,390 --> 00:13:01,500
ستكون حياتك في خطر

176
00:13:02,040 --> 00:13:03,980
...إذا كنت لا تزال موافقاً

177
00:13:04,370 --> 00:13:05,650
فضع بصمتك هنا رجاءً

178
00:13:13,550 --> 00:13:15,620
لم أعد أهتم

179
00:13:15,620 --> 00:13:18,820
أريد الخروج من هنا، من هذا التجمّع

180
00:13:19,390 --> 00:13:22,520
لا يستمع أحدٌ لدروسي

181
00:13:22,520 --> 00:13:24,240
كلّهم ضجرون

182
00:13:24,660 --> 00:13:29,200
،لا تساعد فلسفتي أحداً
ولا أنا حتّى

183
00:13:30,760 --> 00:13:35,570
،لا أحد يشكّك في الأمر
لكنّ الاستمرار هذا كلّ يوم

184
00:13:37,300 --> 00:13:39,160
يفوق طاقتي

185
00:13:40,540 --> 00:13:41,850
أريد الموت

186
00:13:42,420 --> 00:13:48,410
لكن مع خزيي من اعترافي
بالأمر، فالموت يخيفني

187
00:13:49,800 --> 00:13:51,060
أشعر بالخوف

188
00:13:54,960 --> 00:13:57,250
يُبهرني تقديمك للطلب

189
00:13:57,250 --> 00:13:59,380
تطلّب ذلك قدراً كبيراً
من الشجاعة بحدّ ذاته

190
00:13:59,870 --> 00:14:03,690
شـ-شكراً لك

191
00:14:03,690 --> 00:14:06,210
لن يكون الموت جيّداً، أليس كذلك؟

192
00:14:06,600 --> 00:14:08,820
الهرب أفضل خيارٍ
لك في هذه الحالة

193
00:14:13,440 --> 00:14:16,270
علينا تحديد وجهتنا الآن إذاً

194
00:14:18,460 --> 00:14:20,440
فلترمِ هذا النرد من فضلك

195
00:14:24,620 --> 00:14:26,300
حسناً، حُسِم الأمر

196
00:14:26,750 --> 00:14:29,810
سنغادر الليلة، أيناسبك ذلك؟

197
00:14:29,810 --> 00:14:31,300
ماذا؟ الليلة؟

198
00:14:31,300 --> 00:14:33,670
خير البرّ عاجله كما يُقال

199
00:14:43,100 --> 00:14:46,180
،ارتدِ هذه من فضلك
رغم أنّها لن تساعد بالكثير

200
00:14:46,810 --> 00:14:50,040
خذ هذا، وأنهِ كلّ شيءٍ
إن تطلّب الأمر

201
00:14:50,040 --> 00:14:50,770
ماذا؟

202
00:14:50,770 --> 00:14:52,790
سيكون بلا ألم وفورياً

203
00:14:53,100 --> 00:14:55,130
...لكن، أنا

204
00:14:55,130 --> 00:14:56,630
لا تقلق

205
00:14:57,270 --> 00:14:59,820
لن تحتاج لقتل نفسك

206
00:15:00,290 --> 00:15:02,930
إذاً لن أحتاج لهذا، صحيح؟

207
00:15:03,880 --> 00:15:06,720
دعه معك تحسّباً

208
00:15:06,720 --> 00:15:07,890
ماذا؟

209
00:15:10,170 --> 00:15:12,630
!غبيّ

210
00:15:12,630 --> 00:15:16,340
!تاكيشي! لا تهجرني

211
00:15:15,400 --> 00:15:16,880
يا إلهي

212
00:15:16,340 --> 00:15:18,840
!أحبّك

213
00:15:19,280 --> 00:15:23,710
ألا يمكنك أن تعرف أنّي
أحبّك ما لم أفصح عن ذلك؟

214
00:15:23,710 --> 00:15:27,900
!يُفترض أن يكون ذلك جليّاً
...انظر لي وحسب أيّها

215
00:15:25,540 --> 00:15:28,870
أين تعيشين يا آنسة؟
هل عليّ طلب الشرطة؟

216
00:15:28,870 --> 00:15:30,970
!فلتفعل! اطلبهم

217
00:15:30,970 --> 00:15:33,010
!واطلب تاكيشي أثناء فعلك ذلك أيضاً

218
00:15:33,010 --> 00:15:35,180
لا نعرف من يكون حتّى

219
00:15:35,180 --> 00:15:36,810
ماذا نفعل حيال هذا؟

220
00:15:43,760 --> 00:15:46,470
استوليتُ على جزءٍ
من نظام الأمان

221
00:15:46,470 --> 00:15:47,860
سأفتح البوّابة

222
00:15:47,860 --> 00:15:49,060
من فضلك

223
00:16:02,580 --> 00:16:04,940
سنهرب من السطح

224
00:16:04,940 --> 00:16:08,020
،إذا لم نواجه أيّة مشاكل
فسيمضي الأمر بلمح البصر

225
00:16:08,300 --> 00:16:11,240
ذلك إن لم نواجهها

226
00:16:12,250 --> 00:16:13,770
...لحظة، ما الذي

227
00:16:13,770 --> 00:16:16,390
قمتُ بفحص تصويريّ لها للتوّ

228
00:16:16,390 --> 00:16:19,640
،هذه الفتاة نصف بشريّة
وحمأة فوق ذلك

229
00:16:19,640 --> 00:16:20,270
ماذا؟

230
00:16:20,270 --> 00:16:23,470
الكحول خطرةٌ عليها، لا يمكن أنّها ثملة

231
00:16:23,470 --> 00:16:24,960
هذا محض تمثيل

232
00:16:27,350 --> 00:16:31,880
مهلك، لا تُقدم على شيءٍ وإلّا سأصنع
فتحة مؤخرة أخرى لهذا الشخص

233
00:16:31,880 --> 00:16:33,880
افعل ما أقول وألقِ سلاحك

234
00:16:33,880 --> 00:16:34,630
...لحظة

235
00:16:38,690 --> 00:16:40,000
دخيل مشبوه به

236
00:16:40,000 --> 00:16:43,560
قد يكون هناك آخرون، شدّدوا الحراسة

237
00:16:50,450 --> 00:16:51,360
ماذا؟

238
00:16:51,360 --> 00:16:53,310
تبّاً، رُفِض الولوج

239
00:16:56,080 --> 00:16:57,390
يا إلهي

240
00:16:56,750 --> 00:16:58,200
ما الذي يجري؟

241
00:16:58,540 --> 00:16:59,840
وقعت مشكلة

242
00:17:12,870 --> 00:17:14,410
لنغادر من هناك

243
00:17:14,410 --> 00:17:16,020
لمَ يحصل هذا لي؟

244
00:17:16,020 --> 00:17:16,910
مارتيس-سان؟

245
00:17:16,910 --> 00:17:17,850
آلغا-سان؟

246
00:17:17,850 --> 00:17:20,720
!إيكوا-سينباي

247
00:17:20,720 --> 00:17:24,200
أهنالك وقتٌ لذلك؟! اصبحي سائلةً
!من جديد، وبسرعة

248
00:17:24,200 --> 00:17:28,010
لا يمكنني اليوم! لا أملك
!أحماضاً أمينية كافية

249
00:17:36,970 --> 00:17:38,150
ها هم

250
00:17:45,400 --> 00:17:46,410
!أولولا

251
00:17:54,380 --> 00:17:55,740
...أولولا-سان

252
00:17:56,090 --> 00:17:57,700
أيّاً يكن، علينا الصعود للأعلى

253
00:17:58,120 --> 00:17:59,180
لقد رجعوا

254
00:17:59,500 --> 00:18:01,350
استعملوا الفجوة التي
!أحدثها أولولا واصعدوا

255
00:18:01,350 --> 00:18:02,150
!أجل

256
00:18:03,230 --> 00:18:04,900
ماذا؟

257
00:18:13,340 --> 00:18:15,520
ألا يمكننا الهرب عبر الرواق؟

258
00:18:15,520 --> 00:18:17,470
الخروج من النافذة أكثر أماناً

259
00:18:18,260 --> 00:18:19,350
لمَ؟

260
00:18:19,350 --> 00:18:20,150
!وجدتها

261
00:18:37,240 --> 00:18:39,220
فيليس-سان، كما أتوقّع منك

262
00:18:39,220 --> 00:18:41,140
هذا لهذه المرّة فحسب

263
00:18:41,140 --> 00:18:43,920
لن أنضمّ لكم مجدّداً، أعني كلامي

264
00:18:43,920 --> 00:18:45,800
أتتقدّمين لي؟

265
00:18:45,800 --> 00:18:47,510
!فلتذهبا سريعاً وحسب

266
00:19:02,530 --> 00:19:04,550
هل لي أن أسألك عن شيء؟

267
00:19:04,550 --> 00:19:05,120
أجل

268
00:19:06,150 --> 00:19:09,940
لمَ تقومين بعملٍ خطرٍ كهذا؟

269
00:19:10,880 --> 00:19:14,830
،إذا أراد الناس الهرب جدّياً
فعلينا أن نبدي الجدّية نفسها

270
00:19:16,170 --> 00:19:21,530
كما قال أحدهم سابقاً: "حيث
"... يصبح المرء عاجزاً عن الحُب

271
00:19:21,530 --> 00:19:25,800
"يُفترض أن يوجد هناك عابر"
من نيتشه، صحيح؟

272
00:19:27,180 --> 00:19:28,310
...أنتِ

273
00:19:28,640 --> 00:19:31,360
تعلّمتُ ذلك في درسك

274
00:19:32,080 --> 00:19:34,460
كنتِ تنتبهين؟

275
00:19:34,970 --> 00:19:36,050
أجل

276
00:19:36,360 --> 00:19:39,510
إذا لم تستطع الحُب، فلتعبر

277
00:19:39,510 --> 00:19:44,250
ونحن المُستخرجون نساعد
الناس في فعل ذلك

278
00:19:46,640 --> 00:19:48,100
وصلنا

279
00:19:58,490 --> 00:19:59,710
من هنا

280
00:19:59,710 --> 00:20:01,420
...ماذا؟ لكن

281
00:20:03,850 --> 00:20:05,810
سينقلك هذا هناك

282
00:20:05,810 --> 00:20:08,030
ماذا؟ من هنا؟

283
00:20:08,030 --> 00:20:08,710
...سينسي

284
00:20:09,110 --> 00:20:09,960
اعتنِ بنفسك

285
00:20:09,960 --> 00:20:11,160
...لحظة

286
00:21:56,940 --> 00:21:58,370
إلى خبرنا التالي

287
00:21:58,980 --> 00:22:02,420
لا تزال المجموعة التي هاجمت
برج سولا مفقودة

288
00:22:02,420 --> 00:22:04,560
كذلك المعلّم يامادا إيتشيرو

289
00:22:04,560 --> 00:22:08,390
يتوقّع البعض تورّط جماعة
عنيفة من المُستخرجين

290
00:22:08,390 --> 00:22:11,220
،مشرفنا دايغاكو نو كامي ساما

291
00:22:11,220 --> 00:22:14,340
أعلن تأسيس مجلسٍ تمهيدي

292
00:22:14,340 --> 00:22:17,130
لتشكيل فريق بحثٍ
مخصّص لهذا الموضوع

293
00:22:17,340 --> 00:22:20,940
"توخَّ الحذر من الصغار"

294
00:22:21,890 --> 00:22:25,490
،اهرب يا صديقي، إلى وحدتك"
،إلى هناك

295
00:22:25,490 --> 00:22:27,890
"حيث يهبّ نسيمٌ قويّ

296
00:22:27,890 --> 00:22:29,800
حسناً، فلتفتحوا كتبكم
إلى الصفحة التالية

297
00:22:27,990 --> 00:22:28,950
أهذا هو؟

298
00:22:28,950 --> 00:22:30,710
يبدو سعيداً