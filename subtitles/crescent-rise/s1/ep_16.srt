1
00:00:00,920 --> 00:00:04,610
الترشّح لجائزة الفنّان الجديد هو إنجاز مذهل

2
00:00:05,090 --> 00:00:09,160
وصلتُ أخيراً إلى هذه المرحلة، فلماذا لستُ سعيداً؟

3
00:00:10,290 --> 00:00:12,660
ربما لم يعد حلمي بعد الآن

4
00:00:14,040 --> 00:00:15,450
...حلبة زيرو

5
00:00:16,620 --> 00:00:19,460
زيرو، هل حدث الشيء ذاته لك؟

6
00:00:19,990 --> 00:00:22,470
ألم يعد الغناء حلمك؟

7
00:00:26,290 --> 00:00:27,290
!تين-ني

8
00:00:27,960 --> 00:00:29,210
ريكو

9
00:00:32,980 --> 00:00:34,180
...حُلَّت الفرقة

10
00:00:36,090 --> 00:00:38,360
حقّقتُ حلمي أخيراً

11
00:00:39,010 --> 00:00:40,740
ينبغي أن أكون سعيداً

12
00:00:41,210 --> 00:00:42,420
فلماذا إذاً؟

13
00:00:44,340 --> 00:00:48,160
ألم أرد أن أصبح مثل زيرو؟

14
00:00:48,160 --> 00:00:49,940
ميتسكي

15
00:00:51,150 --> 00:00:53,770
ناغي، سوغو

16
00:00:53,770 --> 00:00:56,450
سلكتُ هذا الطريق بلا وعي

17
00:00:56,450 --> 00:00:57,950
أنا أيضاً

18
00:01:00,470 --> 00:01:04,650
كان هذا حيث بكى إيوري بعد ميوزيك فيستا

19
00:01:04,650 --> 00:01:06,810
قلبي يعتصِر

20
00:01:06,810 --> 00:01:08,160
معك حقّ

21
00:01:08,160 --> 00:01:12,380
كان ذلك صعباً، لكن آمنّا بأننا سنتدبّر
الأمر ما دمنا معاً

22
00:01:13,400 --> 00:01:14,630
معك حقّ

23
00:01:14,950 --> 00:01:19,260
ألا يمكننا العودة؟

24
00:01:20,150 --> 00:01:25,640
هل ما يُسعدنا وما هو مهمّ لنا
قد تغيّر؟

25
00:01:26,790 --> 00:01:30,170
لم أكن أحاول أن أصبح نجم جماهير في البداية

26
00:01:30,650 --> 00:01:33,480
أردتُ فقط أن يتحقّق حلم أخي

27
00:01:34,050 --> 00:01:43,240
لكن عندما ساعدتُ في إدارة المجموعة
بشكل سرّي، بدأتُ أحبّ هذا العمل وآيدوليش 7

28
00:01:43,630 --> 00:01:45,090
معك حقّ

29
00:01:45,090 --> 00:01:48,370
،عندما شارفتُ على المغادرة أثناء تجربة الأداء

30
00:01:48,370 --> 00:01:55,240
لم أتخيّل أبداً أنني سأحبّكم
وأحبّ الغناء كثيراً

31
00:01:56,210 --> 00:01:59,780
فلماذا لا أستمتع بذلك؟

32
00:02:00,390 --> 00:02:05,550
لم أهتمّ أبداً بالشهرة أو القواعد

33
00:02:05,550 --> 00:02:08,380
فأساساً، كان لديّ هدف

34
00:02:08,380 --> 00:02:13,780
لكن رؤيتكم تعملون بشكلٍ دؤوب جعلَني
أرغب في المحاولة أيضاً

35
00:02:13,780 --> 00:02:18,390
عندما جرحتُهم، ندمتُ على ذلك
من أعماق قلبي

36
00:02:19,160 --> 00:02:25,090
عندما رأيتُ روعتَهم، غضبتُ ومن ثمّ شعرتُ
بإحباط، لكنني الآن مُعجب بهم

37
00:02:25,090 --> 00:02:26,200
أفهم ما تعنيه

38
00:02:26,200 --> 00:02:28,740
ما كنتُم لتفهموني

39
00:02:28,740 --> 00:02:30,920
لطالما كنتُم فائزين

40
00:02:30,920 --> 00:02:33,160
أنا أتظاهر فحسب

41
00:02:33,700 --> 00:02:37,170
أنا سخيفٌ وجبان ومثير للشفقة

42
00:02:37,610 --> 00:02:41,010
لكن لا أتظاهر بالسّعادة

43
00:02:41,880 --> 00:02:43,390
هذا لأجلِ حلم اللّحظة

44
00:02:44,210 --> 00:02:47,620
أحياناً تنتابني رغبة في الاعتراف

45
00:02:48,390 --> 00:02:51,670
لكن في ذات الوقت، لا أريد أحداً
أن يرى نقطةَ الضعف تلك

46
00:02:52,370 --> 00:02:54,060
هذا ما أشعر به

47
00:02:54,060 --> 00:02:55,230
لماذا؟

48
00:02:56,310 --> 00:02:59,630
ليسَتْ مسألة أنني أريد أن أكون محبوباً

49
00:02:59,630 --> 00:03:04,070
أريد لغنائي ورقصي أن يكونا محبوبين
كجزء من تريغر

50
00:03:05,060 --> 00:03:07,720
يمدحونني عندما أفشل لأنّهم يحبّونني

51
00:03:07,720 --> 00:03:10,110
يهينونني عندما أنجح لأنهم يكرهونني

52
00:03:10,110 --> 00:03:14,130
أريد من الناس أن يتجاوزوا هذه المشاعر
ويحبّوا غنائي ورقصي

53
00:03:14,130 --> 00:03:18,280
آمل دوماً أن يحدث ذلك كي أفتخر
بهذه القوّة

54
00:03:18,280 --> 00:03:20,580
عملتُ جاهداً للإنجاز

55
00:03:24,020 --> 00:03:27,350
المعذرة، ماذا كنت تفعل هنا؟

56
00:03:31,570 --> 00:03:33,520
هل أنت في طريقِ عودتك من العمل؟

57
00:03:33,520 --> 00:03:37,520
ستضرّر حنجرتك من نزلة البرد إذا
مشيت ليلاً

58
00:03:38,530 --> 00:03:40,630
لقد تحسّنت كثيراً

59
00:03:40,630 --> 00:03:42,070
نوباتي باتَتْ أقلّ

60
00:03:43,410 --> 00:03:44,320
هكذا إذاً

61
00:03:44,760 --> 00:03:49,240
من المؤسف جداً ألّا تتمكّن تريغر
من الأداء في ذلك اليوم

62
00:03:49,750 --> 00:03:54,330
بما أنني غنّيتُ بشكلٍ أفضل
من المعتاد، أردتُك أن ترى ذلك

63
00:03:59,240 --> 00:04:03,970
أردتُ أن أغنّي مثلك، لكن ليس
لتقليدِك فقط

64
00:04:05,640 --> 00:04:13,350
،ولأنّني لم أستطع الركض والجري في الخارج
كنتَ تغنّي وتقفز كي تسلّيني

65
00:04:14,340 --> 00:04:18,110
وكلّما رأيتك تبتسم، أبتسم

66
00:04:19,110 --> 00:04:21,360
أردتك أن تبتسم أيضاً

67
00:04:25,510 --> 00:04:26,440
...الجميع

68
00:04:30,520 --> 00:04:31,690
غاكو-سان؟

69
00:04:33,090 --> 00:04:34,500
أنتِ هنا أيضاً إذاً؟

70
00:04:39,840 --> 00:04:42,760
كلّهم يريدون الشيء ذاته

71
00:04:43,730 --> 00:04:44,800
هناك

72
00:04:51,800 --> 00:04:52,730
!أنتم

73
00:04:53,320 --> 00:04:56,840
هل سبق ورأيتِنا نؤدّي؟

74
00:04:57,800 --> 00:04:58,730
نعم

75
00:04:58,730 --> 00:05:00,100
ما رأيكِ؟

76
00:05:00,530 --> 00:05:03,930
كان تريغر رائعين وممتازين

77
00:05:03,930 --> 00:05:07,110
الهالة القاهِرة التي بعثتموها كانت مدهشة

78
00:05:07,830 --> 00:05:11,020
شعرتُ باحترامٍ وعاطفة نقيّين

79
00:05:11,020 --> 00:05:14,620
ظننتُ نفسي محظوظة لرؤيتي شيء
،مذهل كهذا

80
00:05:14,620 --> 00:05:17,120
والآن يمكنني قول ذلك بكلّ اعتزاز

81
00:05:17,120 --> 00:05:19,380
الأمر كالنظر إلى قوس قزح

82
00:05:20,540 --> 00:05:25,670
حلمي هو أن تتخطّى آيدوليش 7 قوسَ قزح ذاك

83
00:05:27,140 --> 00:05:28,170
...أنتِ

84
00:05:28,770 --> 00:05:36,400
ستتفوّق آيدوليش 7 على تريغر، لذا أرجوكم
ابقوا قريبين من منالنا كي نتغلّب عليكم

85
00:05:36,400 --> 00:05:37,810
هذا كلام رهيب تقولينه

86
00:05:39,100 --> 00:05:41,200
لن نخسر أيضاً

87
00:05:41,200 --> 00:05:43,160
فنحن تريغر

88
00:05:43,160 --> 00:05:44,990
نحن جاهزون للقائكم

89
00:05:47,480 --> 00:05:52,320
لن أسأل عن سبب تركك لنا بعد الآن

90
00:05:52,320 --> 00:05:55,810
،خسرتُ نجمي الشخصي

91
00:05:55,810 --> 00:06:00,000
لكن اكتسبتُ منافساً مدهشاً أستطيع
التبجّح به أمام العالم

92
00:06:00,000 --> 00:06:02,130
كوجو تين، هذا هو أنت

93
00:06:03,300 --> 00:06:06,640
أحياناً، الإعجاب بشيء ليس كافياً
لإحراز تقدُّم

94
00:06:06,640 --> 00:06:09,110
بعض الأشياء لا يمكن تخطّيها باللطف والحنان

95
00:06:09,940 --> 00:06:12,620
!لكن أريد الاستمرار في الغناء

96
00:06:12,620 --> 00:06:14,320
فهذا هو سلاحي

97
00:06:14,320 --> 00:06:19,170
ما دام سلاحي وأصدقائي معي، أريد
الاستمرار في القتال ما دمتُ أستطيع

98
00:06:19,880 --> 00:06:20,830
...ريكو

99
00:06:21,110 --> 00:06:23,570
سأركض نحوك بأسرع ما أستطيع

100
00:06:23,570 --> 00:06:25,650
سأستمرّ في الركض حتّى أعجز
!عن التنفُّس

101
00:06:27,970 --> 00:06:30,930
بالتأكيد. تعال إليّ بكل ما أوتيت من قوّة

102
00:06:31,370 --> 00:06:34,330
سأنسى أنّه كان لي أخ لم يستطع الركض

103
00:06:34,710 --> 00:06:37,960
سُرِرت بلقائك يا ناناسي ريكو من آيدوليش 7

104
00:06:42,420 --> 00:06:45,500
سُرِرت بلقائك يا كوجو تين-سان من تريغر

105
00:06:46,390 --> 00:06:47,420
جيّد جداً

106
00:06:52,050 --> 00:06:53,860
وداعاً

107
00:06:57,020 --> 00:07:00,230
أنتم... والمدير

108
00:07:00,660 --> 00:07:01,980
ماذا تفعلون؟

109
00:07:01,980 --> 00:07:03,850
صدفَ مرورنا فحسب

110
00:07:04,950 --> 00:07:06,780
أتينا لنأخذكما

111
00:07:08,020 --> 00:07:09,250
لماذا؟

112
00:07:09,250 --> 00:07:11,490
انتظروا لحظة، هل سمعتُم الحديث كلّه؟

113
00:07:15,580 --> 00:07:18,120
،بما أننا جميعنا هنا

114
00:07:18,120 --> 00:07:21,960
لمَ لا نفكّر في طرق نطلب فيها السماح
من الرّئيس وندعوه لتناول الرامن؟

115
00:07:23,530 --> 00:07:24,330
أتّفق

116
00:07:24,330 --> 00:07:26,470
أريد مرقة عظام اللّحم

117
00:07:26,470 --> 00:07:28,370
أريد مرقة بونيتو

118
00:07:28,370 --> 00:07:30,010
سأنفقه سرّاً

119
00:07:30,010 --> 00:07:33,190
إذاً أظننا سنزور سلسلة مطاعم ومقاهٍ مجدّداً

120
00:07:33,190 --> 00:07:35,550
لكن ألن نتجاوز الحدّ الطبيعي للسعرات
الحراريّة في هذه الحالة؟

121
00:07:35,550 --> 00:07:37,770
علينا أن نتمرّن فحسب للتعويض عن ذلك

122
00:07:39,160 --> 00:07:40,550
!تشاشو رامن

123
00:07:40,550 --> 00:07:42,250
!مع طبق أرزّ مقلي جانبي

124
00:07:42,250 --> 00:07:43,380
بيض مسلوق

125
00:07:43,380 --> 00:07:44,680
!أريد غيوزا

126
00:07:44,680 --> 00:07:46,680
لا يمكنك تناول غيوزا بلا بيرة

127
00:07:47,170 --> 00:07:49,650
ربّما أطلب تانتينمان حارّة جداً

128
00:08:02,970 --> 00:08:05,740
أتعتقدون أن الرئيس سيسامحنا؟

129
00:08:05,740 --> 00:08:08,300
كان غاضباً جداً

130
00:08:08,300 --> 00:08:13,050
على الأرجح حلّ المجموعة لأنّه رأى

131
00:08:13,050 --> 00:08:15,590
أننا لا نستحقّ الغناء الآن

132
00:08:15,590 --> 00:08:16,660
ماذا يعني ذلك؟

133
00:08:16,660 --> 00:08:21,640
أعتقد أنّ هذا يعني أنّه يثمّن أغانينا كثيراً

134
00:08:21,640 --> 00:08:23,640
...أغاني آيدوليش 7

135
00:08:24,010 --> 00:08:26,370
لم نعلم أبداً من كان يؤلّفها

136
00:08:27,350 --> 00:08:28,980
أعلم

137
00:08:28,980 --> 00:08:32,930
أعلم من ألّف أغانينا

138
00:08:32,930 --> 00:08:33,740
!ماذا؟

139
00:08:39,160 --> 00:08:40,470
!أنت؟

140
00:08:40,470 --> 00:08:43,040
ناغيتشي، أنت من ألّفها؟

141
00:08:43,040 --> 00:08:47,240
لا، ألّفها صديقي

142
00:08:47,240 --> 00:08:48,670
صديقك؟

143
00:08:51,030 --> 00:08:54,970
صديقي ألّفَ أغانٍ لشخص معيّن

144
00:08:55,450 --> 00:09:00,100
أتى إلى بلدي بحثاً عن ذلك الشخص

145
00:09:00,660 --> 00:09:04,230
اسم صديقي هو ساكورا هاروكي

146
00:09:04,940 --> 00:09:07,150
...ساكورا هاروكي؟ تقصد

147
00:09:07,150 --> 00:09:10,610
أجل. الشّخص الذي ألّف أغاني زيرو

148
00:09:10,970 --> 00:09:11,860
أغاني زيرو؟

149
00:09:11,860 --> 00:09:16,330
إذاً كنّا نغنّي أغانيَ مؤلّفة بواسطة
مؤلِّف زيرو؟

150
00:09:17,300 --> 00:09:18,620
...مذهل

151
00:09:19,100 --> 00:09:22,910
كتبَ هاروكي الكثير والكثير من الأغاني لي

152
00:09:22,910 --> 00:09:25,990
لكن مرضَ هاروكي

153
00:09:25,990 --> 00:09:29,960
...أردتُ أن يتحسّن هاروكي، لكن

154
00:09:30,970 --> 00:09:35,670
رغبةً منه في عدم إزعاجي، تركَ رسالة
وتلك الأغاني

155
00:09:36,230 --> 00:09:42,850
في رسالتِه طلبَ منّي أن أعطي الأغاني
لشخصٍ يغنّيها بعناية

156
00:09:43,640 --> 00:09:49,130
أردتُها أن تُغنَّى بواسطة نجم جماهير
ياباني مثل زيرو

157
00:09:49,130 --> 00:09:51,650
لكن لا يوجد نجم جماهير كهذا

158
00:09:52,000 --> 00:09:56,930
لذا دون قول كلمة، أرسلتُ الأغاني
إلى رئيس شركة كان هاروكي قد مدحه

159
00:09:56,930 --> 00:09:58,910
مدحَ والدي؟

160
00:09:59,450 --> 00:10:02,040
قال أنّه يثمّن الأشخاص والأغاني

161
00:10:02,520 --> 00:10:05,830
بعد إرسال الأغاني، أردتُ رؤية
،شكل الرّئيس

162
00:10:05,830 --> 00:10:07,280
لهذا أتيتُ إلى اليابان

163
00:10:07,280 --> 00:10:10,080
ومن ثمّ تمّ اكتشاف فجأة

164
00:10:10,080 --> 00:10:14,000
كان اكتشافه لنا مفاجئاً

165
00:10:14,000 --> 00:10:15,930
شعرتُ أنّ ذلك كان قدري

166
00:10:15,930 --> 00:10:18,610
هكذا أصبحتُ نجم جماهير

167
00:10:18,610 --> 00:10:22,900
ما زال الرئيس لا يعرف بأنّك
أنت من أرسل الأغاني؟

168
00:10:22,900 --> 00:10:31,150
نعم. إذا أخبرناه بأننا سنغنّي أغاني
هاروكي بعناية، فأنا متأكّد أنه سيسامحنا

169
00:10:31,580 --> 00:10:32,770
معك حقّ

170
00:10:33,110 --> 00:10:36,440
إن لم يسامحنا فسأطلب منه إعادتها

171
00:10:36,440 --> 00:10:39,280
لا تُفسِد لحظةً عاطفيّةً كهذه

172
00:10:39,600 --> 00:10:44,610
لنعتذر ونطلب منه مسامحتنا لعدم سعادتنا
حيال الترشُّح

173
00:10:44,610 --> 00:10:45,910
لجائزةِ الفنّان الجديد

174
00:10:45,910 --> 00:10:49,330
هل ينبغي أن نتمرّن على التصرّفِ بسعادة؟

175
00:10:49,330 --> 00:10:52,210
ليس هذا ما هو غاضب بشأنه

176
00:10:52,210 --> 00:10:53,380
نعم؟

177
00:10:54,460 --> 00:10:56,000
!سيّدي

178
00:10:56,820 --> 00:10:59,320
هلّا أتيتم معي؟

179
00:11:01,320 --> 00:11:02,880
...هذا المكان

180
00:11:02,880 --> 00:11:06,010
إنه حيث أدّينا أوّل أداء لنا في الشّوارع

181
00:11:10,450 --> 00:11:12,310
هل يمكنني الحصول على أسطوانة؟

182
00:11:13,860 --> 00:11:15,730
نعم. شكراً لك

183
00:11:16,120 --> 00:11:17,110
تفضّل

184
00:11:18,390 --> 00:11:19,770
أنا من داعميك

185
00:11:19,770 --> 00:11:20,900
هل يمكنني مصافحتك؟

186
00:11:20,900 --> 00:11:22,720
نـ-نعم

187
00:11:22,720 --> 00:11:23,850
شكراً لك

188
00:11:27,210 --> 00:11:29,850
هناك الكثير هنا لم يحقّقوا

189
00:11:29,850 --> 00:11:31,960
أحلامهم بعد، كما حدث معكم في السّابق

190
00:11:32,680 --> 00:11:37,710
أنتم تقفون على المسرح الذي يستميتون
للوقوف عليه

191
00:11:37,710 --> 00:11:41,820
يجب ألّا تنسوا هذه النعمة

192
00:11:41,820 --> 00:11:42,840
حاضر

193
00:11:43,170 --> 00:11:50,930
ينبغي أن تولّوا اهتماماً أكبر بأنفسكم
وبالحلم الذي كنتم تحلمونه

194
00:11:52,040 --> 00:11:56,520
ينبغي أن تتكاتفوا لتحقيق ذلك الحلم

195
00:11:57,300 --> 00:12:01,810
سأخبركم مرّة أخرى: لقد تمّ ترشيحكم
لجائزةِ الفنّان الجديد

196
00:12:02,290 --> 00:12:04,780
كيف هو شعورك الآن يا ناناسي ريكو-كن؟

197
00:12:04,780 --> 00:12:06,030
أنا سعيد

198
00:12:06,030 --> 00:12:07,660
نيكايدو ياماتو-كن

199
00:12:08,730 --> 00:12:11,120
حقّقنا شيئاً مذهلاً

200
00:12:11,440 --> 00:12:15,330
هذا صحيح. فعلتُم شيئاً مذهلاً

201
00:12:15,330 --> 00:12:18,800
أنتم تؤدّون عملاً مذهلاً لا يمكن
لكلمات غير لطيفة أن تمحوه

202
00:12:18,800 --> 00:12:21,020
أو سوء فهم حزين

203
00:12:21,020 --> 00:12:21,920
سيّدي

204
00:12:21,920 --> 00:12:27,330
لا داعي لتشكّكوا بالعملِ الدؤوب الذي بذلتموه
منذ أشهر إلى الآن

205
00:12:27,330 --> 00:12:28,220
نعم

206
00:12:28,220 --> 00:12:30,700
أنا فخور بكم

207
00:12:30,700 --> 00:12:32,480
ينبغي أن تفخروا بأنفسكم

208
00:12:32,480 --> 00:12:33,480
نعم

209
00:12:34,900 --> 00:12:35,520
حاضر

210
00:12:36,680 --> 00:12:40,150
مبروك. سيكون هذا كل ما لدي لأقوله

211
00:12:42,610 --> 00:12:44,070
...مستحيل

212
00:12:44,410 --> 00:12:46,950
آيدوليش 7؟

213
00:12:49,030 --> 00:12:49,940
—المعذرة

214
00:12:51,040 --> 00:12:54,290
نعم، هذا نحن

215
00:12:55,780 --> 00:12:58,380
تـ-تمّ ترشيحكم لجائزةِ الفنّان الجديد جايما

216
00:12:58,380 --> 00:12:59,800
!مبروك

217
00:12:59,800 --> 00:13:00,710
...نعم

218
00:13:01,730 --> 00:13:03,340
!نعم، شكراً

219
00:13:03,340 --> 00:13:05,350
!نأمل أن تربحوا الجائزة

220
00:13:05,350 --> 00:13:07,410
!وتؤدّوا في أسود أو أبيض

221
00:13:07,410 --> 00:13:13,340
اشترت أمّي قرصاً صلباً جديداً بما أنّكِ ستظهرين
في التلفزيون كثيراً في نهاية العام

222
00:13:13,340 --> 00:13:16,390
!وأمّي أيضاً! سنسجّل كلّ أعمالكم الدؤوبة

223
00:13:18,710 --> 00:13:20,990
!أنا آسفة لقول هذا الكلام فجأة

224
00:13:20,990 --> 00:13:22,530
!آسفة لإخباركم بما يجب فعله

225
00:13:22,530 --> 00:13:25,200
شكراً. سنفعل ما بوسعنا

226
00:13:25,200 --> 00:13:28,070
لا نريد للأقراص الصّلبة تلك أن تذهب سُدى

227
00:13:28,070 --> 00:13:32,660
سنربح جائزةَ الفنّان الجديد جايما
لكُن أيتها السيّدات الجميلات

228
00:13:32,660 --> 00:13:36,710
وسنقضي على تريغر في أبيض أو أسود

229
00:13:36,710 --> 00:13:39,040
نأمل أن تستمرّا في دعمِنا

230
00:13:39,040 --> 00:13:40,210
!سنفعل

231
00:13:40,210 --> 00:13:41,570
أنا مسرور

232
00:13:41,570 --> 00:13:45,670
مسرور لأنّنا رُشِّحنا وحظينا بدعمِ معجبينا

233
00:13:46,150 --> 00:13:48,720
مسرور لكوني جزءاً من آيدوليش 7

234
00:13:51,810 --> 00:13:53,950
بالتوفيق

235
00:13:53,950 --> 00:13:56,580
بدوتا سعيدتين

236
00:13:56,580 --> 00:14:00,360
نعم، لكن نحن السّعداء حقّاً

237
00:14:01,910 --> 00:14:03,720
حسناً. أعتمد عليك يا ريو

238
00:14:03,720 --> 00:14:05,010
لا تقلق

239
00:14:05,010 --> 00:14:07,640
إذا بدا وكأنّك ستضربه، سأوقفك

240
00:14:07,640 --> 00:14:13,030
لا يهمّني إذا تحوّل الأمر إلى ملاكمة، لكن
دعوني أقول ما أريد قوله أولاً

241
00:14:13,030 --> 00:14:16,250
تستغرق محاضراتك ساعتين

242
00:14:21,560 --> 00:14:23,380
ماذا تظنّ أنك تفعل؟

243
00:14:23,380 --> 00:14:26,500
ماذا نفعل؟ نحن مُضرِبون

244
00:14:26,500 --> 00:14:29,140
عِدنا أنّك ستكفّ عن استخدام طرُقٍ خبيثة

245
00:14:29,140 --> 00:14:31,220
لن ندعك تغادر حتّى تفعل

246
00:14:31,930 --> 00:14:33,080
!أغبياء

247
00:14:33,750 --> 00:14:36,330
!الأمن

248
00:14:36,330 --> 00:14:40,150
كنتُ ألعب بالمقصّ فقطعتُ سلك الهاتف

249
00:14:41,060 --> 00:14:41,900
!النجدة

250
00:14:41,900 --> 00:14:43,960
لا أحد في المكتب

251
00:14:43,960 --> 00:14:46,840
أقمنا لهم حفلة شكر بمصروفنا الشخصي

252
00:14:46,840 --> 00:14:49,210
إنهم يستمتعون الآن بالشكوى منك الآن

253
00:14:49,210 --> 00:14:50,740
!لا تغترّوا بأنفسكم

254
00:14:50,740 --> 00:14:52,800
!لستَ ابني

255
00:14:52,800 --> 00:14:54,830
!بمقدوري استبدالك في طرفةِ عين

256
00:14:54,830 --> 00:14:57,700
!سأقتلع فروة رأسك الفارغ يا أخرق

257
00:14:58,170 --> 00:14:59,000
ماذا؟

258
00:14:59,000 --> 00:14:59,920
ماذا قال؟

259
00:15:02,440 --> 00:15:05,000
المعذرة. تابع من فضفلك

260
00:15:05,000 --> 00:15:08,510
شركة هيغوراشي الكيماوية تجعل يومكم مريحاً

261
00:15:09,510 --> 00:15:10,260
ماذا؟

262
00:15:11,350 --> 00:15:13,210
أذِب الثّلج المُجمِّد

263
00:15:13,210 --> 00:15:14,510
بحرارة ملتهبة

264
00:15:17,080 --> 00:15:18,180
تريغر

265
00:15:20,010 --> 00:15:24,070
ياوتومي-سان بارع حقّاً في الترويج للمواهب

266
00:15:24,070 --> 00:15:25,110
أوغامي-سان

267
00:15:25,110 --> 00:15:29,860
يتوقّف الجميع عن الحركة عندما
يبدأ تشغيل هذا الإعلان

268
00:15:30,360 --> 00:15:32,700
انا متأكّد أن أغنيتهم الجديدة ستنجح

269
00:15:32,700 --> 00:15:37,800
اقتربَتْ تقريباً من أغنية ري:فالي الفرديّة
في الطلبات المُسبَقة لوحدها

270
00:15:37,800 --> 00:15:40,500
بدأتْ رسميّاً

271
00:15:40,500 --> 00:15:42,360
لن ندعهم يهزموننا

272
00:15:42,360 --> 00:15:45,630
يسرّني أن السيّد شيموكا-سان سامحنا

273
00:15:45,630 --> 00:15:48,310
نعم. وعدوا أن يؤدّوا حفلة مصغّرة

274
00:15:48,310 --> 00:15:50,800
في حفلةِ نهاية العام التي سيقيمها في منزله

275
00:15:50,800 --> 00:15:56,220
حفلات نهاية العام خاصّته أشبه بحدَث
نجوم صناعة التّرفيه

276
00:15:56,220 --> 00:15:59,790
يحبُّ الفتياتَ حقّاً؟

277
00:15:59,790 --> 00:16:01,350
ما هذه الصّورة؟

278
00:16:02,820 --> 00:16:06,170
إنّه فيديو حفلتهم الأولى الكارثيّة

279
00:16:07,430 --> 00:16:09,410
...ماذا؟ المشاهدات

280
00:16:09,410 --> 00:16:12,950
نعم. لسبب ما، إنه مشهور في بلاد الخارج

281
00:16:12,950 --> 00:16:14,260
حقّاً؟

282
00:16:15,350 --> 00:16:17,730
بالمناسبة، أين الجميع اليوم؟

283
00:16:18,580 --> 00:16:23,210
ما المجموعة التي ستفوز جائزةَ الفنّان الجديد؟

284
00:16:23,210 --> 00:16:29,000
الفائز في جائزة الفنّان الجديد لنجم الجماهير
...الياباني السنويّة الثانية عشر هو

285
00:16:29,000 --> 00:16:30,210
!تريغر

286
00:16:32,730 --> 00:16:35,230
كوجو-سان، أخبرنا بشعورك

287
00:16:35,230 --> 00:16:38,270
أنا سعيدٌ للغاية. نشكر معجبينا على هذا

288
00:16:38,270 --> 00:16:40,140
!شكراً جزيلاً لكم

289
00:16:40,140 --> 00:16:43,770
تسوناشي-سان، من أكثر من تريد أن تخبره
بهذا الفوز؟

290
00:16:44,220 --> 00:16:48,410
عائلتي. أشقائي الذين دعموني دوماً

291
00:16:48,410 --> 00:16:50,310
ياوتومي-سان، كيف هو شعورك؟

292
00:16:50,310 --> 00:16:51,610
شعور مذهل

293
00:16:51,610 --> 00:16:56,290
أنا الأسعد لاكتسابي حقّ الأداء
في أسود أو أبيض

294
00:16:56,290 --> 00:16:59,700
!سنربح هناك كما فعلنا هنا اليوم

295
00:17:01,010 --> 00:17:04,230
في وقتٍ لاحق، ربِحت تريغر كما قالوا تماماً

296
00:17:04,230 --> 00:17:06,770
كما لو أنّهم في دراما

297
00:17:06,770 --> 00:17:09,480
لكن تقدّموا بشكلٍ مذهل

298
00:17:09,480 --> 00:17:10,800
!بالطبع

299
00:17:10,800 --> 00:17:15,690
حصدوا جائزةَ الفنّان الجديد الأكثر روعة
والتي لا تُمنَح إلّا لفرقة واحدة في العام

300
00:17:15,690 --> 00:17:22,140
ظننتُ أنّهم كانوا ثابتين في مكانهم
الحالي دون السّعي لما هو أفضل من ذلك

301
00:17:22,610 --> 00:17:25,390
شاهدتُ هذا في المنزل العام الماضي

302
00:17:25,890 --> 00:17:30,400
انتابتني مشاعر مختلطة، بما أنّني خلتُ
أنّ تين-ني قد تخلّى عنّي

303
00:17:30,810 --> 00:17:34,150
لكن أنا سعيدٌ حقّاً لأجله الىن

304
00:17:34,150 --> 00:17:38,160
أتفهّم كم كان من الصعب الوصول
إلى هذه المرحلة

305
00:17:39,380 --> 00:17:42,100
أريد جائزةَ الفنّان الجديد

306
00:17:42,100 --> 00:17:45,410
أريد أن أربح الجائزة وأتحدّاهم

307
00:17:45,410 --> 00:17:48,920
أريد أن أتحدّاهم في معركة منصفة وأهزمهم

308
00:17:55,000 --> 00:17:57,020
وبالطبع، أنا متوتّر

309
00:17:57,020 --> 00:18:01,260
لا تفعل أرجوك. تحديداً هنا

310
00:18:01,260 --> 00:18:03,470
فهمت! لا داعي لتخبرني في كلّ مرّة

311
00:18:03,470 --> 00:18:07,170
لا داعي للقلق. ريكو-كن، احرص على ألّا
تُصاب حنجرتك بنزلةِ برد

312
00:18:07,170 --> 00:18:09,540
الغرفة مليئةٌ بالزهور

313
00:18:09,540 --> 00:18:11,270
...سيّد شيموكا-سان

314
00:18:11,270 --> 00:18:13,560
كلارا أرسلَتْ بعضاً أيضاً

315
00:18:14,440 --> 00:18:16,280
أرسلَتْ تريغر زهوراً

316
00:18:16,670 --> 00:18:20,820
هل يمكننا أن نفترض مطمئنّين بأن تريغر تدعمنا؟

317
00:18:20,820 --> 00:18:22,830
نعم. حريّ بنا أن نعمل بجدّ

318
00:18:25,300 --> 00:18:26,370
هذه بلا اسم

319
00:18:26,850 --> 00:18:27,830
ممَّن يا تُرى؟

320
00:18:27,830 --> 00:18:29,330
إنها زهور جميلة

321
00:18:29,330 --> 00:18:34,440
أكره ذكر السّعر، لكن أعتقد أنّ هذه
الزهور باهظة الثمن نسبياً

322
00:18:34,440 --> 00:18:36,210
أوساكا-سان، هل يُعقَل أن تكون من عائلتك؟

323
00:18:36,210 --> 00:18:37,820
مستحيل

324
00:18:37,820 --> 00:18:39,840
لا يمكن أن يكونوا سعداء بهذا

325
00:18:40,150 --> 00:18:43,970
ادّعِ أنهم كذلك حتّى لو لم يكونوا كذلك

326
00:18:43,970 --> 00:18:45,320
ياماتو-سان

327
00:18:45,320 --> 00:18:48,940
إذاً سأدّعي بأنها زهور من أيا

328
00:18:48,940 --> 00:18:51,400
سأتظاهر بأنها من زيرو

329
00:18:51,400 --> 00:18:53,820
إنه يشجّعني

330
00:18:53,820 --> 00:18:56,550
سأتظاهر بأنها من هاروكي

331
00:18:56,550 --> 00:19:02,450
هاروكي المعافى أرسل هديّة لنا
نحن، الأشخاص الذين نغنّي أغانيه

332
00:19:02,450 --> 00:19:06,460
سأدّعي بأنّ تين-ني أرسل لي
هديّةً شخصياً

333
00:19:06,460 --> 00:19:08,290
هذا سيجعلني لا أُقهَر

334
00:19:08,290 --> 00:19:09,040
وأنت يا إيوري؟

335
00:19:09,040 --> 00:19:14,750
سأتخيّل أنها من نفسي في الماضي
والذي نسيَ أن يغنّي في ميوزيك فيستا

336
00:19:14,750 --> 00:19:16,000
...إيوري

337
00:19:16,360 --> 00:19:18,760
ما زلتَ متضايقاً من ذلك؟

338
00:19:19,380 --> 00:19:24,970
الخطأ الذي ارتكبتُه في ذلك اليوم أخّرَنا

339
00:19:25,540 --> 00:19:26,570
لكن لا بأس الآن

340
00:19:26,570 --> 00:19:28,980
ما زال بمقدورنا الوصول إلى وجهتِنا

341
00:19:30,040 --> 00:19:33,830
ما زال بمقدوري التّعويض عن الخطأ
في ذلك اليوم

342
00:19:34,730 --> 00:19:38,360
أيّها الأبله، لقد عوّضتَ عن ذلك بالفعل

343
00:19:38,360 --> 00:19:39,890
نعم يا إيوري

344
00:19:39,890 --> 00:19:45,730
لقد تعلّمتَ من خطأك وفكّرتَ فيه مليّاً
وسعيتَ جاهداً

345
00:19:45,730 --> 00:19:48,970
الجميع هنا يعلمون ذلك

346
00:19:49,670 --> 00:19:50,620
ني-سان

347
00:19:51,110 --> 00:19:52,950
لا أحد يلومك

348
00:19:52,950 --> 00:19:55,380
أنت الوحيد من يلوم نفسه

349
00:19:55,380 --> 00:19:58,970
الإطلالة الأولى لـ"ميتزو" تسير على قدمٍ وساق

350
00:19:58,970 --> 00:20:03,380
لن تصمد إذا قلقتَ على كلّ خطأ
بسيط ترتكبه يا إيورين

351
00:20:03,380 --> 00:20:06,050
آمل أن تقلق بشأن أخطائك أكثر قليلاً

352
00:20:06,050 --> 00:20:06,990
...أنتم

353
00:20:06,990 --> 00:20:09,100
الجميع يخشون ارتكاب أخطاء

354
00:20:09,100 --> 00:20:15,310
ظلال أخطائنا توخز قلوبَنا كما الأشواك

355
00:20:15,310 --> 00:20:21,400
لكن مع الوقت، هذه الأشواك ذابَتْ
في داخلنا على مهل

356
00:20:21,400 --> 00:20:25,320
اللّيلة سنربح جائزةَ الفنّان الجديد
وحيث كانت تلك الأشواك، مرحباً

357
00:20:25,320 --> 00:20:27,240
ستحلُّ مكانَها الثِّقة

358
00:20:27,600 --> 00:20:28,280
نعم

359
00:20:28,280 --> 00:20:30,360
سأغنّي بشكل جيد الليلة

360
00:20:30,360 --> 00:20:34,710
كما قلت، لن أتوتّر. سأغنّي بأفضل أداء لصوتي

361
00:20:34,710 --> 00:20:37,250
!لنحصد جائزةَ الفنّان الجديد تلك

362
00:20:37,250 --> 00:20:37,960
نعم

363
00:20:37,960 --> 00:20:41,890
!حسناً يا شباب، لنحضن إيوري جميعاً

364
00:20:41,890 --> 00:20:42,710
!مهلاً

365
00:20:43,590 --> 00:20:44,990
!توقّفوا أرجوكم

366
00:20:44,990 --> 00:20:47,770
!لا تعاملوني كطفل

367
00:20:48,600 --> 00:20:49,940
—شارف الوقتُ على

368
00:20:52,200 --> 00:20:53,600
!هيّا بنا

369
00:20:54,870 --> 00:20:56,610
!نعم

370
00:20:57,700 --> 00:21:02,650
ستغنّي آيدوليش 7 أغنيتها الجديدة
"الآن "جيل الوحش

