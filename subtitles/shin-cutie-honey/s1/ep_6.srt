!أشعر كأن قبضتي يمكنها أن تحيط بالأرض

203
00:14:03,920 --> 00:14:08,580
.أوه! هربتِ من مطاردِيَّ ووصلتِ إلى هنا

204
00:14:08,690 --> 00:14:10,160
.أنا مندهشة

205
00:14:10,830 --> 00:14:15,420
.العم ينهي الآن أمرهم بينما نتحدث

206
00:14:17,870 --> 00:14:19,200
.هكذا إذاً

207
00:14:20,330 --> 00:14:23,630
!ستكون مهمتي إذاً أن أنهي أمرك

208
00:14:23,740 --> 00:14:25,770
لماذا هاجمتِنا؟

209
00:14:25,770 --> 00:14:28,070
عم تتحدثين، أيتها الجميلة النائمة؟

210
00:14:28,180 --> 00:14:30,470
.أنا لم أهاجمك أنت فقط

211
00:14:34,110 --> 00:14:36,640
!أنظري! لاحظي نطاق قدرتي

212
00:14:41,420 --> 00:14:42,620
ماذا؟ ماذا؟

213
00:14:44,830 --> 00:14:47,790
!ساموراي سقط من السماء

214
00:14:55,370 --> 00:14:58,270
!إسحقوهم كالحشرات

215
00:14:58,270 --> 00:15:00,270
!أقتلوهم! أقتلوهم جميعاً

216
00:15:00,270 --> 00:15:05,340
!ثأرنا سيحول عالم هؤلاء البشر إلى محرقة ملتهبة

217
00:15:21,930 --> 00:15:23,490
لِمَ تفعلين هذا؟

218
00:15:25,170 --> 00:15:28,400
!لأنه لا أحد يستطيع إيقافي

219
00:15:41,820 --> 00:15:45,810
!ممنوع اختلاس النظر إلى الكواليس، أيها الزبون المشاغب

220
00:15:46,450 --> 00:15:49,980
.أتمنى لو استطعت اختلاس النظر إلى دماغك

221
00:15:50,090 --> 00:15:52,850
!أنا متأكدة أن هناك بضع تروسٍ مفقودة

222
00:15:53,630 --> 00:15:55,690
أقترح أن تقلقي حيال صحتك

223
00:15:55,800 --> 00:15:58,490
.قبل أن تشغلي بالك بصالح الآخرين

224
00:16:13,350 --> 00:16:17,080
!احترس! ستأتي إلى حتفك

225
00:16:17,890 --> 00:16:20,320
!أتمنى حقا لو أن هاني هنا

226
00:16:21,260 --> 00:16:22,220
!هاني

227
00:16:26,930 --> 00:16:28,550
إنها عابرة، أليس كذلك؟

228
00:16:29,030 --> 00:16:33,130
.حياة البشر مجرد حلم، سراب

229
00:16:39,570 --> 00:16:44,880
!إنتباه رجاءاً! مسرحية ياشا الكبرى قد بدأت

230
00:16:45,410 --> 00:16:48,110
!أرقص، أرقص وارقص

231
00:16:49,220 --> 00:16:51,740
.لن أسدل الستار بعد

232
00:16:55,390 --> 00:16:56,150
!هذا كل شيء

233
00:17:03,730 --> 00:17:04,560
من أنت؟

234
00:17:05,400 --> 00:17:10,270
،أميرة إيدو قد تكون مخيفة

235
00:17:13,770 --> 00:17:16,210
،لكن طالما هاني في البلدة

236
00:17:16,310 --> 00:17:18,470
!لن تفلتي بهذا أبداً

237
00:17:19,250 --> 00:17:20,370
!أيتها الـ

238
00:17:21,080 --> 00:17:23,070
!نذلة! خسيسة

239
00:17:27,020 --> 00:17:29,220
!لا أصدق أنك ما زلتِ حية

240
00:17:31,830 --> 00:17:37,020
.الشخصية الرئيسية ليست ميتة حتى تري جثتها

241
00:17:37,130 --> 00:17:39,530
ألا تعلمين ذلك؟

242
00:17:41,070 --> 00:17:43,040
ماذا تعنين بالشخصية الرئيسية؟

243
00:17:43,400 --> 00:17:44,870
من أنت بحق الجحيم؟

244
00:17:46,140 --> 00:17:49,040
.إذا كنت لا تعرفين، سوف أقول لك

245
00:17:49,710 --> 00:17:51,870
.أحياناً أنا غايشا جميلة

246
00:17:52,180 --> 00:17:54,040
.أحياناً، ساكاموتو ريوما

247
00:17:54,680 --> 00:17:58,080
.ومرَّةً كنتُ نيزومي كوزو الرائعة

248
00:17:58,320 --> 00:18:02,520
.ومرة أخرى كنتُ سباحةً مدرسية

249
00:18:03,220 --> 00:18:05,450
لكن هل تعلمين حقيقتي؟

250
00:18:06,690 --> 00:18:07,520
!هاني فلاش

251
00:18:17,570 --> 00:18:20,200
!فارسة الحب، كيوتي هاني

252
00:18:21,280 --> 00:18:24,680
!حسناً، ياشا! أوقفي دُماكِ الآن

253
00:18:25,650 --> 00:18:27,280
عم تتحدثين بحق الجحيم؟

254
00:18:27,280 --> 00:18:28,910
!لا تمزحي بذلك حتى

255
00:18:29,720 --> 00:18:33,450
!الشخصية الرئيسية في هذا العالم هي أنا

256
00:18:41,860 --> 00:18:43,160
!لا يمكن؟

257
00:18:48,670 --> 00:18:50,500
ما رأيك بهذا، أيتها الصغيرة؟

258
00:18:50,500 --> 00:18:52,670
!هذه هي إمكانيتي الكاملة

259
00:18:52,670 --> 00:18:54,680
!أنا النجم

260
00:18:54,680 --> 00:18:56,510
!أنا الملك

261
00:18:56,510 --> 00:19:00,340
!أنا سيد هذا العالم

262
00:19:00,750 --> 00:19:04,080
!ياشا، لدي إسمٌ أكثر ملائمةً لك

263
00:19:04,180 --> 00:19:05,150
ماذا؟

264
00:19:06,250 --> 00:19:07,690
.مفارقة تاريخية

265
00:19:07,690 --> 00:19:09,490
!أيتها الـ

266
00:19:13,730 --> 00:19:14,790
أمستعدة؟

267
00:19:16,460 --> 00:19:17,660
!ما أقسى جلدها

268
00:19:19,300 --> 00:19:21,170
!جسدي بالكامل مغطى بحراشف من الفولاذ

269
00:19:21,170 --> 00:19:24,070
!لا يمكنك حتى أن تخدشيني بذلك السيف البائس

270
00:19:24,810 --> 00:19:26,900
!يبدو أنك توفرين مبلغاً كبيراً على العناية بالبشرة

271
00:19:38,620 --> 00:19:39,710
!أنظر

272
00:19:39,820 --> 00:19:41,050
...هاي، تلك

273
00:19:41,160 --> 00:19:42,320
!هاني

274
00:19:42,420 --> 00:19:43,820
أتلك هاني حقا؟

275
00:19:44,860 --> 00:19:46,160
!هاني

276
00:19:51,200 --> 00:19:54,430
!أنظري لتلك الوجوه الغبية التي تشبه البقر

277
00:19:55,040 --> 00:19:57,970
.سينسون أمرك بسرعة

278
00:19:58,070 --> 00:20:00,740
!إنهم يهتفون لك فقط بسبب ما هم فيه من خطر

279
00:20:00,740 --> 00:20:01,880
!هذا غير صحيح

280
00:20:01,880 --> 00:20:02,710
!إخرسي

281
00:20:06,210 --> 00:20:07,180
!هاني

282
00:20:08,080 --> 00:20:11,050
.علي الذهاب. علي أن أهب لنجدة هاني

283
00:20:11,490 --> 00:20:12,880
!تبا

284
00:20:12,990 --> 00:20:14,280
!تشوكاي

285
00:20:14,390 --> 00:20:16,980
!هاني، انتظريني! أنا آتٍ

286
00:20:17,090 --> 00:20:19,850
!الجميع! قاتلوا حتى آخر نَفَس

287
00:20:19,990 --> 00:20:22,550
!هاني! انتظريني

288
00:20:24,460 --> 00:20:28,070
.أنا أسمعُ أصوات من أحبهم

289
00:20:28,070 --> 00:20:30,660
!إنهم مجرد وهم. إنسي أمرهم

290
00:20:31,370 --> 00:20:33,740
.يمكنني أن أسمع، يمكنني سماعهم

291
00:20:33,740 --> 00:20:37,230
.أسمع أصواتهم عميقاً بداخلي، أشعر باهتمامهم

292
00:20:37,340 --> 00:20:41,580
!حتى وأنا في مأزق، حتى وأنا حزينة، أشعر بهم

293
00:20:42,720 --> 00:20:46,980
.إنهم مصدرُ قوتي

294
00:20:47,090 --> 00:20:49,850
!لن أنساهم أبداً

295
00:20:52,260 --> 00:20:53,160
!تبا

296
00:20:54,130 --> 00:20:55,920
!سيلفر فلوريت

297
00:20:57,730 --> 00:20:59,130
!لقد قلتُ لك أن ذلك لا طائل منه

298
00:20:59,230 --> 00:21:00,790
!لن يؤذيني إطلاقاً

299
00:21:06,810 --> 00:21:08,740
!ما زلتِ لم تفهمي؟ حمقاء

300
00:21:09,880 --> 00:21:11,740
حسناً إذاً، ماذا عن هذا؟

301
00:21:11,850 --> 00:21:13,840
!هاني فلاش

302
00:21:20,920 --> 00:21:21,950
!فعلتها

303
00:21:24,260 --> 00:21:27,560
!أنتِ لا تعرفين معنى الطيبة أو مفهوم الحب

304
00:21:27,660 --> 00:21:30,060
!أنت عدوة كل ما هو جميل في هذا العالم

305
00:21:30,060 --> 00:21:32,460
.كيوتي هاني لن تسامح شرك

306
00:21:44,410 --> 00:21:47,870
...جسـ... جسدي

307
00:21:48,720 --> 00:21:51,620
.جسدك لا يمكن أن يُخدش، لكن يمكن أن يتمزق

308
00:21:51,820 --> 00:21:55,120
!ياشا، لقد أُسدل الستار عليك

309
00:21:56,590 --> 00:21:58,180
!...أيتها الـ

310
00:22:22,850 --> 00:22:26,090
.يبدو أن كل الدمى كان يتحكم بها هذا الوحش

311
00:22:26,090 --> 00:22:28,750
ماذا كانت بحق الجحيم؟

312
00:22:29,920 --> 00:22:34,830
وأين نحن بحق الجحيم؟
!هذه لم تكن مزحة

313
00:22:38,430 --> 00:22:40,920
.هذا المكان كان يدعى ساموراي بارك

314
00:22:41,030 --> 00:22:42,330
ساموراي بارك؟

315
00:22:42,800 --> 00:22:45,000
.قرأتُ مقالاتٍ عن هذا المكان

316
00:22:45,770 --> 00:22:49,230
.هذا المكان كان حديقة ملاهي، منذ زمنٍ بعيدٍ جدًّا

317
00:22:49,380 --> 00:22:54,340
،أجل! أتذكر ذلك
.من زمنٍ بعيدٍ جدًّا

318
00:22:54,450 --> 00:22:57,540
هذا مستحيل. كيف لشيءٍ بهذا القِدَم أن يظهر الآن مجدداً؟

319
00:22:57,650 --> 00:23:02,550
.ربما الدمى التي نُسيَت أتت ساعيةً للثأر

320
00:23:02,660 --> 00:23:05,450
.زعيمتهم كانت تلك المرأة

321
00:23:07,230 --> 00:23:10,130
وجوههم تبدو حزينة، صح؟

322
00:23:11,330 --> 00:23:13,860
.لا شك أنها كانت تعاني وحدةً قاتلة

323
00:23:17,600 --> 00:23:22,770
ربما كنتُ أتخيل فقط، لكن أقسم
.أنني رأيتُ دمعةً في عين هاني

324
00:23:43,000 --> 00:23:46,900
.مرحباً في مسرحنا للقديم والبعيد جدًّا

325
00:23:47,900 --> 00:23:52,700
.أنا ياشا، مديرة هذا المسرح

326
00:23:53,510 --> 00:24:01,510
تعالوا، سيداتي سادتي، واستمتعوا
.برقص السيف خاصتي الليلة

327
00:24:06,860 --> 00:24:14,230
أن ألتقيك في هذا العالم الواسع

328
00:24:14,340 --> 00:24:18,830
أنا ممتن لذلك من أعماق قلبي

329
00:24:21,680 --> 00:24:34,250
كنتُ أعلم أنه سيكون صعباً الوقوع
في حب شخصٍ مثلك

330
00:24:37,330 --> 00:24:51,140
قلبي يوجعني لأنني أفقد من يفهمني بلا كلمات

331
00:24:52,170 --> 00:24:55,110
هذا ليس الوداع

332
00:24:55,740 --> 00:24:59,210
الوداع هو وعد اللقاء

333
00:24:59,210 --> 00:25:04,780
سأقع في حبك مجدداً

334
00:25:07,190 --> 00:25:10,720
كوننا قريبين ومفترقين وملتقين مجدداً

335
00:25:10,830 --> 00:25:14,090
إذا كانت هناك أسطورة

336
00:25:14,200 --> 00:25:17,870
أنت وأنا

337
00:25:17,870 --> 00:25:23,390
نجمان يجذبان بعضهما البعض