1
00:00:03,480 --> 00:00:05,230
انهض يا كيزوكي

2
00:00:05,570 --> 00:00:09,990
إن كنت لا تزال تُحبّ ميزوهو، فعليك
أن تنهض مرّة أُخرى

3
00:00:12,990 --> 00:00:14,250
هذا صحيح

4
00:00:14,630 --> 00:00:19,370
آنذاك، وقعتُ في حُبّ كيزوكي
الّذي لم يمضِ إلّا قُدماً

5
00:01:53,990 --> 00:01:55,560
!أهلاً وسهلاً

6
00:01:56,050 --> 00:02:01,560
،واحد بيبيرونتشينو، واحد كاربونارا
،وعصير فاكهة العنب

7
00:02:01,560 --> 00:02:03,600
—وواحد شاي مُثلّج من فضلك

8
00:02:03,600 --> 00:02:04,410
المعذرة

9
00:02:04,410 --> 00:02:06,540
بير... بير فافوري؟

10
00:02:06,950 --> 00:02:08,440
سي، غراتزي

11
00:02:08,440 --> 00:02:10,200
ما نوع الشّاي المُثلّج يا ميزوهو؟

12
00:02:10,200 --> 00:02:12,350
حليب؟ ليمون؟ سادة؟

13
00:02:12,350 --> 00:02:13,460
!بئساً

14
00:02:13,460 --> 00:02:14,780
!نسيتُ أن أسأل

15
00:02:14,780 --> 00:02:15,930
!سأذهب وأسأل حالاً

16
00:02:18,450 --> 00:02:20,390
مئزركِ فضفاض

17
00:02:20,390 --> 00:02:21,950
عجزتُ معكِ

18
00:02:21,950 --> 00:02:23,310
شكراً

19
00:02:24,820 --> 00:02:27,050
!يا للشّباب

20
00:02:27,050 --> 00:02:27,960
ميزوهو-تشان؟

21
00:02:27,960 --> 00:02:28,710
نعم؟

22
00:02:28,710 --> 00:02:32,690
تعلمين بأنّكِ تستطيعين العمل بدوام
جزئيّ هنا خارج المواسم أيضاً، صحيح؟

23
00:02:32,690 --> 00:02:33,840
!أبي

24
00:02:33,840 --> 00:02:37,120
عزيزي! كُفّ عن الابتسام كالأحمق
!وابدأ بالطّبخ

25
00:02:37,120 --> 00:02:38,710
حسناً

26
00:02:38,710 --> 00:02:42,050
سأطبخ وجبتك المجّانيّة بعد
قليل يا ميزوهو-تشان

27
00:02:42,050 --> 00:02:44,480
يمكنكِ العودة إلى المنزل بعد
أكلها مع سيوغو

28
00:02:44,480 --> 00:02:48,330
!مرحى! أعشق المارغريتا خاصّتك

29
00:02:48,330 --> 00:02:50,580
عليك أن تعملي بما يتكافأ مع أجركِ

30
00:02:50,580 --> 00:02:51,860
!يمكنك الاعتماد عليّ

31
00:02:58,240 --> 00:03:01,750
لم أدرك أنّ مهرجان شاطئ ميتسوشيما
للألعاب النّاريّة كان اليوم

32
00:03:01,750 --> 00:03:02,940
أجل

33
00:03:02,940 --> 00:03:05,090
بالمناسبة، أنتِ تعملين في مُناوبات كثيرة

34
00:03:05,090 --> 00:03:06,260
لا تضغطي على نفسكِ، مفهوم؟

35
00:03:06,260 --> 00:03:07,880
أجل. أنا بخير

36
00:03:07,880 --> 00:03:11,080
كيزوكي يبذل قصارى جهده لأجل مُنافساته

37
00:03:11,080 --> 00:03:14,140
عليّ توفير طاقة كافية لتشجيعه
!خارج المُحافظة

38
00:03:14,870 --> 00:03:16,990
لا أُصدّق بأنّه العام الأخير

39
00:03:16,990 --> 00:03:20,040
آمل أن يتأهّل للثّانويّات الدّاخليّة

40
00:03:24,430 --> 00:03:26,020
!أجل

41
00:03:26,020 --> 00:03:28,620
ربّما سأذهب لزيارة كيزوكي
كونه كثير البُكاء

42
00:03:28,620 --> 00:03:31,630
عندما لا يكسر الأرقام القياسيّة

43
00:03:31,630 --> 00:03:34,030
!أنا متأكّدة بأنّه سيفعلها هذا العام

44
00:03:39,530 --> 00:03:42,060
!مُذهل

45
00:03:42,060 --> 00:03:43,540
!يمكن رؤيتهم بوضوح شديد

46
00:03:43,540 --> 00:03:46,060
كيف عرفت بهذا المكان؟

47
00:03:47,800 --> 00:03:48,670
تويا

48
00:03:51,170 --> 00:03:55,170
لماذا استدعيتني للخروج اليوم؟

49
00:03:55,170 --> 00:03:58,260
لأنّني أخبرتُك بأنّني رُفِضت
بواسطة كيزوكي؟

50
00:04:00,680 --> 00:04:02,370
كما قلت يا تويا

51
00:04:02,370 --> 00:04:05,930
قَبِلَ كيزوكي كلّ شيء عنّي

52
00:04:07,560 --> 00:04:10,360
إنّه شخصٌ عظيم في نهاية المطاف

53
00:04:15,080 --> 00:04:18,450
أحبّ نفسي حقّاً الآن

54
00:04:19,710 --> 00:04:21,450
شكراً يا تويا

55
00:04:22,080 --> 00:04:24,470
لا أستحقّ امتنانك

56
00:04:36,680 --> 00:04:37,860
آسف

57
00:04:38,280 --> 00:04:40,920
أعلم بأنّني قلتُ بأنّني لن أمسّك

58
00:04:40,920 --> 00:04:41,970
لكن أسحب كلامي

59
00:04:42,930 --> 00:04:45,050
انسَ ذلك الشّخص

60
00:04:46,520 --> 00:04:47,890
أحبّك

61
00:04:51,690 --> 00:04:55,650
لا أعلم ما إن كنتُ أستطيع
نسيان كيزوكي يوماً

62
00:04:56,120 --> 00:04:57,690
هذا لا يهمّ

63
00:05:10,240 --> 00:05:12,370
كيزوكي. انتظر لحظة

64
00:05:12,710 --> 00:05:13,730
ماذا؟

65
00:05:13,730 --> 00:05:15,310
لن يستغرق هذا وقتاً طويلاً

66
00:05:15,310 --> 00:05:17,220
ينبغي أن يصل الآخرون
إلى هنا قريباً أيضاً

67
00:05:18,850 --> 00:05:20,470
كيزوكي؟ أنت هنا؟

68
00:05:20,860 --> 00:05:22,810
أحضرنا شيئاً جيّداً لك

69
00:05:23,470 --> 00:05:24,660
تفضّل

70
00:05:24,660 --> 00:05:26,470
شيء بسيط منّا جميعاً

71
00:05:27,970 --> 00:05:32,480
كنّا نتحدّث حول رغبتنا في تشجيعك
لعملك الجادّ والدّؤوب

72
00:05:32,980 --> 00:05:35,510
شكراً لكم! أنا سعيدٌ للغاية

73
00:05:35,510 --> 00:05:36,680
ماذا يوجد في الدّاخل؟

74
00:05:36,680 --> 00:05:38,670
شيء تُحبّه

75
00:05:38,670 --> 00:05:40,990
إنّها مُفاجأة

76
00:05:40,990 --> 00:05:43,380
ما قد تكون؟

77
00:05:43,380 --> 00:05:47,330
هل أنت بخير؟ كنتَ تُكثّف من تمرينك مؤخّراً

78
00:05:47,330 --> 00:05:48,240
أجل

79
00:05:48,240 --> 00:05:51,230
هذا كثير، لكن تمكّنتُ من إحراز
زمن أقصر بفضل ذلك

80
00:05:51,230 --> 00:05:54,510
وحتّى أنّني سأجري مُقابلة
لمجلّة سباحة قريباً

81
00:05:54,510 --> 00:05:56,340
!بجدّية؟ رائع

82
00:05:56,340 --> 00:05:59,590
كنتَ تعمل بجدّ يا كيزوكي

83
00:05:59,920 --> 00:06:03,090
أجل. أريد حقّاً التأهُّل للثّانويّات الدّاخليّة

84
00:06:03,090 --> 00:06:05,000
وستفعل

85
00:06:05,000 --> 00:06:06,010
!شكراً

86
00:06:06,010 --> 00:06:08,860
!حسناً، سأُغادر الآن

87
00:06:08,860 --> 00:06:09,890
أجل

88
00:06:12,220 --> 00:06:16,810
لقاؤنا المُقبل سيكون بعد حسم
الثّانويّات الدّاخليّة

89
00:06:17,370 --> 00:06:18,710
معك حقّ

90
00:06:19,750 --> 00:06:22,070
ما رأيكم بأكل شيء في مكان ما
قبل العودة إلى المنزل؟

91
00:06:22,440 --> 00:06:23,770
!خطّة سديدة

92
00:06:23,770 --> 00:06:25,600
شين، ستأتي أيضاً، صحيح؟

93
00:06:26,110 --> 00:06:28,200
سأُرافقكم لبعض الوقت

94
00:06:28,200 --> 00:06:30,580
ماذا عنك يا آيرو؟

95
00:06:30,580 --> 00:06:32,620
!آسف. أنا مُضطرّ للرّفض

96
00:06:32,620 --> 00:06:35,460
ماذا؟! هل لديك جلسة تصوير اليوم؟

97
00:06:35,740 --> 00:06:36,640
لا

98
00:06:36,640 --> 00:06:39,710
لكن عليّ زيارة مكان ما عقب هذا

99
00:06:47,180 --> 00:06:49,130
!حسناً! انتهيت

100
00:06:52,130 --> 00:06:53,060
ما رأيك؟

101
00:06:53,060 --> 00:06:56,350
استغرق ذلك وقتاً، لكن أعتقد
بأنّني أبليتُ حسناً

102
00:06:57,980 --> 00:07:00,360
!هيّا! كُل

103
00:07:04,620 --> 00:07:05,360
هل هو لذيذ؟

104
00:07:05,360 --> 00:07:07,020
هيّا. ما هو تقييمك؟

105
00:07:07,020 --> 00:07:08,240
هل أعجبك؟

106
00:07:08,240 --> 00:07:09,340
أجل

107
00:07:09,760 --> 00:07:11,410
!مرحى

108
00:07:11,410 --> 00:07:12,570
سوف آكل أيضاً

109
00:07:13,150 --> 00:07:15,000
!هنيئاً مريئاً

110
00:07:18,250 --> 00:07:22,180
!ثمّ أخبرنا كيزوكي بأنّه سيُعرَض في مجلّة

111
00:07:22,180 --> 00:07:23,760
أليس هذا رائعاً؟

112
00:07:23,760 --> 00:07:26,180
كلّ العيون تركّز عليه كرياضيّ

113
00:07:28,770 --> 00:07:29,760
!تفضّل

114
00:07:30,120 --> 00:07:32,510
عيد ميلاد سعيد يا تويا

115
00:07:32,510 --> 00:07:33,730
شكراً

116
00:07:34,300 --> 00:07:36,620
هل تستطيع قضاء الوقت معي
في عطلة هذا الأسبوع أيضاً؟

117
00:07:37,550 --> 00:07:40,750
أجل. ليس لديّ أي مخطّطات
—في عطل الأسبوع، لذا

118
00:07:42,110 --> 00:07:43,350
آسف، عليّ الردّ

119
00:07:44,290 --> 00:07:45,280
مرحباً؟

120
00:07:46,150 --> 00:07:47,910
شكر" على الهديّة؟"

121
00:07:48,340 --> 00:07:50,030
ليس عليك فعل ذلك

122
00:07:50,850 --> 00:07:52,470
ماذا؟ في عطلة هذا الأسبوع؟

123
00:07:52,470 --> 00:07:54,600
أنت مُتفرّغ ليوم كامل يا كيزوكي؟

124
00:07:55,040 --> 00:07:56,300
!ينبغي أن نخرج حتماً

125
00:07:56,300 --> 00:07:57,540
هل من مكان تريد الذّهاب إليه؟

126
00:07:57,910 --> 00:07:59,830
حسناً. يمكننا تخطيط المزيد في المدرسة

127
00:07:59,830 --> 00:08:00,880
إلى اللّقاء

128
00:08:06,650 --> 00:08:09,990
ألا تدرك حتّى بأنّ في اللّحظة
،الّتي تخرج فيها معي

129
00:08:09,990 --> 00:08:11,550
كلّ ما تفعله هو الحديث عنه؟

130
00:08:11,550 --> 00:08:13,790
...آسف، لا إراديّاً

131
00:08:14,330 --> 00:08:16,270
لا إراديّاً؟

132
00:08:24,840 --> 00:08:27,320
يا لي من أحمق

133
00:08:27,320 --> 00:08:32,180
مُحال أن أنسى أمر كيزوكي

134
00:08:34,640 --> 00:08:36,210
يا له من وجه مُثير للشّفقة

135
00:08:37,120 --> 00:08:39,500
رغم أنّني أنا من جرحتُه

136
00:08:46,210 --> 00:08:49,230
كنتُ مُحرِجاً جدّاً آنذاك

137
00:08:49,230 --> 00:08:50,500
آيرو

138
00:08:52,090 --> 00:08:54,800
إنّه جاهز. تعال لتقديم المُساعدة

139
00:08:54,800 --> 00:08:55,820
!أجل

140
00:08:56,100 --> 00:08:58,350
!حسناً إذاً

141
00:08:58,350 --> 00:09:02,350
للاحتفال بلمّ الشّمل المُنتظر طويلاً
...لطاقم مُرتفعات كويغاهاما

142
00:09:02,350 --> 00:09:04,220
!بصحّتكما

143
00:09:04,220 --> 00:09:07,360
!مهلاً! لماذا أنتما فقط؟

144
00:09:07,360 --> 00:09:08,970
شين في العمل

145
00:09:08,970 --> 00:09:10,360
لا أعلم بخصوص كيزوكي

146
00:09:10,360 --> 00:09:13,070
هل ما زلت تتشاجر مع كيزوكي؟

147
00:09:13,070 --> 00:09:14,370
!يا لك من ذي نظّارة عنيد

148
00:09:16,370 --> 00:09:19,540
سأعود إلى إنجلترا ابتداء من
الأسبوع المُقبل أيضاً

149
00:09:19,540 --> 00:09:21,430
!ماذا؟ ابقَ فترة أطول

150
00:09:21,430 --> 00:09:22,550
عودي إلى هناك فحسب

151
00:09:22,870 --> 00:09:26,990
أردتُ قول شيء للجميع قبل أن أُسافر

152
00:09:26,990 --> 00:09:28,880
ما هو؟

153
00:09:29,520 --> 00:09:31,630
سوف أتزوّج

154
00:09:31,960 --> 00:09:34,520
تـ... تتزوّج؟

155
00:09:34,890 --> 00:09:35,990
أجل

156
00:09:38,140 --> 00:09:41,890
حسناً، بما أنّ حبيبي وأنا
،لدينا جنسيّة يابانيّة

157
00:09:42,350 --> 00:09:45,620
لا يمكننا "الزّواج" فعليّاً

158
00:09:46,220 --> 00:09:50,970
أردتُكم أن تعترفوا به كشريك لي
الآن بعد أن صرنا نُقيم معاً

159
00:09:51,330 --> 00:09:54,660
!هذا مُذهل! تهانينا يا آيرو

160
00:09:54,660 --> 00:09:58,660
شكراً. عرفتُ بأنّكِ ستُوافقين يا ميزوهو

161
00:09:58,660 --> 00:10:00,290
كيف هو؟

162
00:10:00,290 --> 00:10:01,700
عرّفنا في المرّة المُقبلة

163
00:10:01,700 --> 00:10:02,570
حسناً

164
00:10:03,170 --> 00:10:05,520
إنّه مُذهل من كلّ النّواحي

165
00:10:05,520 --> 00:10:08,780
يعرف كلّ شيء عنّا نحن الخمسة

166
00:10:08,780 --> 00:10:10,610
وأتحدّث عن أنفسنا كثيراً

167
00:10:11,420 --> 00:10:17,960
لكن أتمنّى ذات يوم أن نتمكّن من الزّواج
كما الجميع في اليابان

168
00:10:21,850 --> 00:10:24,360
انتهى المطاف بنا نشرب حتّى الصّباح

169
00:10:24,360 --> 00:10:25,820
إنّه احتفال

170
00:10:25,820 --> 00:10:30,110
لكن من كان يتوقّع أن يصدر حديث
الزّواج عن واحد منّا؟

171
00:10:30,110 --> 00:10:33,310
نحن بالغون فعلاً الآن

172
00:10:40,700 --> 00:10:42,620
!لذيذ

173
00:10:42,620 --> 00:10:46,010
!البيتزا خاصّتك هي الأروع

174
00:10:46,010 --> 00:10:47,130
!غراتزي

175
00:10:48,800 --> 00:10:49,980
ماذا؟

176
00:10:49,980 --> 00:10:53,630
يجب أن تُسرع وتتعلّم كيفيّة
إعداد بيتزا رائعة مثلي

177
00:10:54,340 --> 00:10:56,810
لِمَ يجدر بي ذلك؟ أنت هنا لتفعلها

178
00:10:59,150 --> 00:11:01,530
ما زلت طفلاً يا سيوغو

179
00:11:01,890 --> 00:11:04,120
،إذا كسبت معدة ميزوهو-تشان

180
00:11:04,120 --> 00:11:07,590
فهناك احتمال أن تكون عروستك كما تعلم

181
00:11:07,590 --> 00:11:08,900
ماذا؟

182
00:11:09,340 --> 00:11:12,150
إن كنت تُحبّها، فابذل جهداً

183
00:11:12,150 --> 00:11:14,710
لن ينجح شيء إذا لم تُبادر بخطوة

184
00:11:17,560 --> 00:11:18,910
...ميزوهو

185
00:11:19,250 --> 00:11:21,410
ماذا؟ هل ناديتني؟

186
00:11:23,020 --> 00:11:26,170
لا، انسي الأمر

187
00:11:27,360 --> 00:11:28,690
أنت غريب أطوار يا سيوغو

188
00:11:41,060 --> 00:11:42,850
!رائع للغاية

189
00:11:42,850 --> 00:11:44,260
!يا له من طويل

190
00:11:44,810 --> 00:11:49,830
أنا حزين حقّاً لأنّني لم أستطع
الوصول إلى الثّانويّات الدّاخليّة

191
00:11:50,310 --> 00:11:52,830
سوف أعوّض عن خيبة الأمل هذه

192
00:11:52,830 --> 00:11:54,300
عندما ألتحق بالجامعة

193
00:11:54,900 --> 00:11:57,820
!رغم ذلك، يا له من أداء مُبهر

194
00:11:57,820 --> 00:11:58,410
...حسناً إذاً

195
00:11:58,270 --> 00:12:01,270
وصلت الأنباء أخيراً إلى محطّة
التّلفزيون المحلّية

196
00:12:01,580 --> 00:12:03,670
ذو شعبية كبيرة

197
00:12:03,670 --> 00:12:05,970
إنّه نجم جوهريّاً. نجم

198
00:12:05,970 --> 00:12:08,830
بدأ العالم يعرف كيزوكي

199
00:12:11,110 --> 00:12:14,010
مُستقبله مضمون تماماً الآن

200
00:12:15,090 --> 00:12:17,870
"سبّاح المُستقبل المُتألّق"

201
00:12:17,870 --> 00:12:19,640
يا له من فتى

202
00:12:20,180 --> 00:12:22,390
إلى أي جامعة ستلتحق يا سيوغو؟

203
00:12:24,760 --> 00:12:28,710
،سألتحق بمدرسة أنا مُؤهَّل لها فحسب
،وأختار اختصاصاً عشوائيّاً

204
00:12:28,710 --> 00:12:31,100
وأصبح موظّفاً طبيعيّاً براتب أو ما شابه

205
00:12:31,540 --> 00:12:33,940
ليس لديّ ما أريد فعله فعليّاً

206
00:12:33,940 --> 00:12:37,800
.أنت مُستمتع بوقتك يا آيرو
نظراً إلى شهرتك

207
00:12:38,170 --> 00:12:40,320
هذا مُجرّد وهم

208
00:12:40,320 --> 00:12:43,420
يجب أن أبحث عن شيء
أشعر بالشّغف تجاهه

209
00:12:43,730 --> 00:12:46,080
ماذا عنكِ ياتشيكا-تشان؟

210
00:12:46,680 --> 00:12:49,830
سأذهب إلى مدرسة صيدلة وأصبح صيدلانيّة

211
00:12:49,830 --> 00:12:52,190
سيمنحني ذلك أفضليّة في تلك
المهنة بتلك المُؤهّلات

212
00:12:52,730 --> 00:12:55,310
!لديّ شخص واقعيّ هنا

213
00:12:55,310 --> 00:12:57,030
!المعذرة

214
00:12:57,340 --> 00:13:02,440
هل تعلمنَ ما إن كان كيزوكي هازاوا-كن
في نادي السّباحة لديه حبيبة؟

215
00:13:02,440 --> 00:13:04,100
...في الواقع، بخصوص ذلك

216
00:13:07,380 --> 00:13:09,930
لا تنظري. لنذهب

217
00:13:09,930 --> 00:13:11,350
حـ-حسناً

218
00:13:12,020 --> 00:13:14,360
شين-تشان رائع للغاية

219
00:13:17,210 --> 00:13:19,120
!توغو

220
00:13:19,610 --> 00:13:21,040
مرحباً

221
00:13:21,040 --> 00:13:23,490
هوشيكاوا-سينسي، أنت لا تُدرّس هنا حتّى

222
00:13:23,490 --> 00:13:26,120
ماذا تفعل هنا في منتصف النّهار؟

223
00:13:26,120 --> 00:13:28,470
هل طُرِدت يا ترى؟

224
00:13:28,470 --> 00:13:29,620
اِخرس

225
00:13:29,980 --> 00:13:32,590
أقوم ببعض الأعمال. تعال معي يا سيوغو

226
00:13:32,590 --> 00:13:36,020
ماذا؟ أبي يجعلنا نقوم بمهام ثانية؟

227
00:13:37,400 --> 00:13:39,100
!ألقاك يا سيوغو

228
00:13:42,130 --> 00:13:45,090
بئساً. أنت سيّئ في التّفاعل الاجتماعيّ

229
00:13:45,090 --> 00:13:47,140
تعلم بأنّني مشغول بالامتحانات

230
00:13:53,140 --> 00:13:55,820
سيوغو، أريدك أن تصغي إليّ بهدوء

231
00:14:00,180 --> 00:14:01,750
أبي قد مات

232
00:14:17,230 --> 00:14:18,890
شكراً جزيلاً

233
00:14:18,890 --> 00:14:22,140
...أنا آسف جدّاً. أنتم أكثر من يُعاني

234
00:14:22,540 --> 00:14:23,860
...سيّدي

235
00:14:24,570 --> 00:14:28,430
شكراً على تحمُّل أبي

236
00:14:37,820 --> 00:14:40,150
...سيوغو لم يبكِ حتّى

237
00:14:40,600 --> 00:14:41,820
...أجل

238
00:14:42,440 --> 00:14:45,200
...هل كنتُ قادراً على فعل شيء

239
00:14:45,950 --> 00:14:47,920
أيّ شيء لأجلك؟ عندما تُوفّيت أمُّك؟

240
00:14:47,920 --> 00:14:49,450
!فعلتَ بالطّبع

241
00:14:49,450 --> 00:14:52,450
...لأنّكم ظللتُم بجانبي كالمعتاد

242
00:14:52,450 --> 00:14:53,920
كنتُ قادرة على أن أكون سعيدة

243
00:15:01,020 --> 00:15:02,070
...لكن

244
00:15:03,920 --> 00:15:05,190
...أمّي

245
00:15:05,930 --> 00:15:09,620
ما الّذي يمكنني فعله لأجل سيوغو؟

246
00:15:13,180 --> 00:15:16,250
منذ متى كان هذا المكان
في طور العمل؟

247
00:15:16,250 --> 00:15:18,690
منذ حوالي 20 سنة؟

248
00:15:18,690 --> 00:15:24,320
أنا متأكّد بأنّ أمّي تريد لهذا
المكان أن يستمرّ

249
00:15:27,590 --> 00:15:28,820
...أنا

250
00:15:28,820 --> 00:15:33,690
"آخر شيء قلتُه لأبي كان: "لا أحتاج فطوراً

251
00:15:34,830 --> 00:15:38,250
بذل جهداً لإعداد بيض عيون الخاص به لأجلي

252
00:15:38,700 --> 00:15:41,510
...لا أصدّق بأنّ تلك كانت كلماتي الأخيرة له

253
00:15:44,730 --> 00:15:45,890
هكذا إذاً

254
00:15:48,320 --> 00:15:50,350
...توغو، أنا

255
00:15:50,350 --> 00:15:52,100
لن ألتحق لأي جامعة بعد الآن

256
00:15:53,640 --> 00:15:57,350
سألتحق بمدرسة طهو وأتولّى العمل

257
00:15:57,740 --> 00:15:58,870
...سيوغو

258
00:16:00,320 --> 00:16:03,110
لا. التحق بالكلّية

259
00:16:08,450 --> 00:16:09,850
لا تقلق بشأن ذلك

260
00:16:09,850 --> 00:16:10,870
سأتولّى المطعم

261
00:16:10,870 --> 00:16:12,110
ماذا؟

262
00:16:12,110 --> 00:16:15,200
قدّمتُ طلب استقالتي بالفعل في المدرسة

263
00:16:15,980 --> 00:16:17,820
!ما-ماذا قلت؟

264
00:16:17,820 --> 00:16:21,300
،تمكّنت أخيراً من أن تصبح مُعلّماً
!كما تمنّيتَ دوماً

265
00:16:21,300 --> 00:16:23,340
!لماذا تستسلم؟

266
00:16:23,340 --> 00:16:25,010
!سأتولّى المطعم

267
00:16:25,010 --> 00:16:28,330
...ليس وكأنّ لديّ طموح مثل كيزوكي والآخرين

268
00:16:28,330 --> 00:16:30,270
لا مُشكلة يا سيوغو

269
00:16:31,700 --> 00:16:33,220
أنا الوحيد القادر على فعل ذلك

270
00:16:33,830 --> 00:16:37,350
الآن، أنا الشّخص الّذي يستطيع
تولّي مطعم أبي وأمّي

271
00:16:38,110 --> 00:16:40,500
ستفهم عندما تكبر قليلاً

272
00:16:42,330 --> 00:16:44,870
يمكننا تدبّر أمرنا بتنظيف طبّاخ لبعض الوقت

273
00:16:45,360 --> 00:16:47,810
ركّز أنت على نفسك فقط

274
00:16:48,330 --> 00:16:49,940
اذهب إلى الكلّية

275
00:16:50,360 --> 00:16:51,690
لا تقلق

276
00:16:51,690 --> 00:16:53,870
ستجد ما تريد فعله يوماً ما

277
00:17:11,800 --> 00:17:13,260
مرحباً يا ميزوهو

278
00:17:13,260 --> 00:17:14,800
هل انتهيت من المدرسة؟

279
00:17:14,800 --> 00:17:16,660
أجل. ماذا عنك يا سيوغو؟

280
00:17:17,280 --> 00:17:19,180
انتهينا من تنظيف المتجر

281
00:17:19,180 --> 00:17:22,070
لكن أردتُ إنهاء الأمر في وقت أبكر

282
00:17:22,560 --> 00:17:26,480
أعتقد ما زلنا أطفالاً في نهاية المطاف

283
00:17:26,830 --> 00:17:27,820
ماذا؟

284
00:17:27,820 --> 00:17:32,490
أخبرتُ توغو بأنّني سأتوقّف عن التقدُّم
لامتحانات وذلك كي أتولّى المطعم

285
00:17:32,490 --> 00:17:35,820
ثمّ قال بأنّ عليّ الذّهاب إلى المدرسة وطردَني

286
00:17:36,330 --> 00:17:41,410
لطالما أحبَّ اللّهو، لكن عندما تتعلّق
الأمور بهذا، يغدو ناضجاً جدّاً

287
00:17:43,080 --> 00:17:46,590
لديك ميول للتّركيز على الأشياء
المُحيطة حولك يا سيوغو

288
00:17:46,590 --> 00:17:48,730
لهذا السّبب ينتهي المطاف بك بالنّظر
إلى قلوب الآخرين

289
00:17:48,730 --> 00:17:51,040
"بدلاً من التّفكير بـ"ماذا أريد أن أفعل؟

290
00:17:51,340 --> 00:17:58,150
أعتقد أنّ توغو يفهم جيّداً بأنّك
تهتمّ بعائلتك كثيراً

291
00:17:59,360 --> 00:18:02,210
على الأقلّ هذا ما أنا، الفتاة الّتي
،لطالما فهمتَها وأدركتَها

292
00:18:02,210 --> 00:18:03,970
تعتقده بشأن هذا

293
00:18:05,110 --> 00:18:06,360
ما هذا الكلام الشّديد؟

294
00:18:10,230 --> 00:18:11,930
الطّقس جميل

295
00:18:13,540 --> 00:18:14,500
ميزوهو

296
00:18:14,500 --> 00:18:15,980
...هل الجنّة

297
00:18:17,000 --> 00:18:20,410
موجودة في مكان ما حقّاً؟

298
00:18:25,990 --> 00:18:27,630
!أمّي

299
00:18:27,630 --> 00:18:30,630
!اعتني بوالد سيوغو

300
00:18:30,630 --> 00:18:32,390
!والد سيوغو

301
00:18:32,390 --> 00:18:35,050
!أعدّ بيتزا لأمّي من فضلك

302
00:18:35,050 --> 00:18:37,640
!بيتزا مارغريتّا مع طماطم إضافيّة

303
00:18:39,580 --> 00:18:42,640
هل تعتقد بأنّ أباك سمعني؟

304
00:18:44,810 --> 00:18:46,660
هل أنتِ حمقاء؟

305
00:18:47,150 --> 00:18:48,470
!بالمناسبة

306
00:18:54,900 --> 00:18:57,170
!أعددتُ هذا لأجلك

307
00:18:58,580 --> 00:18:59,870
ما الأمر؟

308
00:19:00,810 --> 00:19:01,860
حِلية حظّ سعيد

309
00:19:02,500 --> 00:19:06,610
وذلك كي تحدث لك الكثير من الأمور
الجيّدة من الآن فصاعداً

310
00:19:07,670 --> 00:19:11,190
فأنت طبّاخي العزيز ذي النّجوم الثّلاثة

311
00:19:14,210 --> 00:19:17,190
...أنت حقّاً

312
00:19:25,440 --> 00:19:27,820
احتفظي بهذا سرّاً عن كيزوكي

313
00:19:28,860 --> 00:19:30,570
لبعض الوقت فقط

314
00:19:30,920 --> 00:19:31,940
أجل

315
00:19:39,450 --> 00:19:40,980
سيوغو

316
00:19:41,470 --> 00:19:43,230
تعلم كيف يقولون في الرّوايات

317
00:19:43,670 --> 00:19:47,840
"حتّى إذا ماتوا، يعيشون في قلوب النّاس؟"

318
00:19:48,210 --> 00:19:50,710
،كلّما رسمت

319
00:19:50,710 --> 00:19:56,700
أستطيع سماع صوت أمّي في رأسي
"!وهي تقول "رسمكِ جميل يا ميزوهو

320
00:19:57,740 --> 00:20:00,620
لأنّني أردتُ سماع ذلك الصّوت
...مراراً وتكراراً

321
00:20:00,620 --> 00:20:05,480
حتّى بعد فترة الحِداد، لم أذهب
إلى المدرسة وظللتُ أرسم في المنزل

322
00:20:06,410 --> 00:20:09,870
هل يمكنك سماعه أيضاً يا سيوغو؟
صوت والدك؟

323
00:20:11,670 --> 00:20:12,950
!سيوغو

324
00:20:14,260 --> 00:20:15,810
!تناول بعض الفطور

325
00:20:15,810 --> 00:20:17,360
!تفضّل، بيض عيون

326
00:20:17,750 --> 00:20:20,870
!يمكنك فعلها يا ابني العزيز

327
00:20:20,870 --> 00:20:22,780
...نكهاتك

328
00:20:22,780 --> 00:20:25,050
إنّها جريئة. هذا لذيذ

329
00:20:32,490 --> 00:20:34,010
يمكنني سماعه

330
00:20:43,710 --> 00:20:47,400
—آسف، قدّمنا طلباتنا الأخيرة بالفعل

331
00:20:52,480 --> 00:20:55,480
لماذا أنت هنا؟ غادر

332
00:20:55,480 --> 00:20:56,840
...سيوغو

333
00:20:57,330 --> 00:20:59,460
أنا مشغول حاليّاً

334
00:21:04,650 --> 00:21:06,240
—بخصوص ما سبق... أنا آسـ

335
00:21:06,240 --> 00:21:07,740
كنتُ مُخطئاً

336
00:21:09,680 --> 00:21:12,960
بانيني بالطّماطم الجافّة المُفضّلة لديك

337
00:21:12,960 --> 00:21:14,750
من دون بروكولي

338
00:21:15,150 --> 00:21:16,630
أنا آسف لأنّني ضربتُك

339
00:21:22,670 --> 00:21:25,010
كان ذلك شهيّاً. شكراً لك

340
00:21:25,900 --> 00:21:27,220
سأساعدك في الصّحون

341
00:21:27,590 --> 00:21:28,520
حسناً

342
00:21:31,020 --> 00:21:34,860
يسرّني أنّني أتيتُ إلى هنا
وتكلّمتُ معك يا سيوغو

343
00:21:35,370 --> 00:21:38,780
بالتّوفيق لك في مُباراة العودة يا كيزوكي

344
00:21:38,780 --> 00:21:42,360
حتّى لو مررت بنكسة، لا تختفِ
عن أنظارنا ثانية

345
00:21:42,360 --> 00:21:43,290
أجل

346
00:21:43,610 --> 00:21:47,090
إن لم يفلح الأمر، فسأعود كما
كنتُ أفعل في الماضي

347
00:21:47,090 --> 00:21:50,410
سأكون كأخيك الصّغير وآتي للبُكاء أمامك

348
00:21:51,530 --> 00:21:54,920
أنت مُبهر حقّاً لدرجة تُثير اشمئزازي

349
00:21:55,350 --> 00:21:56,290
خُذ

350
00:21:56,290 --> 00:21:58,750
مهلاً، مهلاً لا تبكِ

351
00:21:58,750 --> 00:22:01,130
أنا لا أبكي بعد

352
00:22:06,240 --> 00:22:07,640
...أتعلم؟ أنا

353
00:22:07,640 --> 00:22:12,140
قرّرتُ منذ زمن بعيد أن أُعتني بك أنت وميزوهو

354
00:22:18,750 --> 00:22:20,150
...لكن

355
00:22:20,150 --> 00:22:22,990
هل يمكنني الإفصاح لميزوهو عن مشاعري؟

356
00:22:25,620 --> 00:22:29,040
،كيزوكي، رغم أنّني مُنافس ثانويّ
أريدك أن تُواجهني

357
00:22:31,970 --> 00:22:36,600
لم أعتبرك مُنافساً ثانويّاً يوماً يا سيوغو

358
00:22:37,340 --> 00:22:38,780
قبِلت