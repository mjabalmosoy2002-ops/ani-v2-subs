1
00:00:05,650 --> 00:00:10,990
أتتذكّرين ما أخبرتكِ به عندما
صعدنا ذلك الجندول معاً؟

2
00:00:13,090 --> 00:00:17,440
عقدتُ عزمي على البقاء بجانبكِ بالفعل

3
00:00:18,750 --> 00:00:22,190
لذا عندما تكونين جاهزة أيضاً، أخبريني

4
00:00:24,500 --> 00:00:27,250
أجل. كنتُ قد تفاجأتُ حقّاً

5
00:00:28,180 --> 00:00:30,730
حتّى عندما علمتُ بمشاعر
...كيزوكي تجاهكِ

6
00:00:31,940 --> 00:00:34,120
...وعندما بدأتُما تتواعدان

7
00:00:35,590 --> 00:00:37,800
قرّرت الخروج مع كيزوكي

8
00:00:40,480 --> 00:00:43,840
لم أستطع فقدان الأمل منكِ يا ميزوهو

9
00:00:44,220 --> 00:00:47,030
لا أتخيّل حياة من دونكِ

10
00:00:47,440 --> 00:00:48,940
أحبّكِ يا ميزوهو

11
00:00:49,540 --> 00:00:53,870
أعيش لأجلكِ، وأريد أن أستمرّ
في العَيش لأجلكِ

12
00:00:54,420 --> 00:00:57,510
أريد أن أكون سعيداً معكِ

13
00:01:04,420 --> 00:01:07,520
هلّا تزوّجتِني؟

14
00:02:56,580 --> 00:02:59,200
هيّا بنا. تحرّكي أيّتها البلهاء

15
00:03:02,450 --> 00:03:04,420
نحلّ هذا الجزء هكذا

16
00:03:07,170 --> 00:03:11,760
الرّجاء السّماح لنا بإقامة مهرجان
!ثانويّة أو مع الجميع هنا

17
00:03:15,680 --> 00:03:16,720
!شين

18
00:03:17,640 --> 00:03:19,760
أتيتُ لأخبركِ بأنّ العمليّة الجراحيّة اكتملت

19
00:03:20,220 --> 00:03:21,540
لقد نجحتْ

20
00:03:24,990 --> 00:03:26,540
...هذا مُطمئن

21
00:03:34,760 --> 00:03:36,070
شكراً لك

22
00:03:37,380 --> 00:03:40,980
...طوال فترة معرفتي لك ونحو المُستقبل

23
00:03:40,980 --> 00:03:44,100
ستبقى دوماً شخصاً عزيزاً عليّ

24
00:03:45,370 --> 00:03:49,300
لكن لا أستطيع الزّواج منك يا شين

25
00:03:50,590 --> 00:03:54,270
هذه المشاعر الّتي أكنّها لك ليست حُبّاً

26
00:03:55,810 --> 00:03:56,880
هكذا إذاً

27
00:03:57,360 --> 00:04:00,350
أعتقد بأنّني صديقكِ للأبد فحسب؟

28
00:04:00,350 --> 00:04:01,510
أنا آسفة

29
00:04:01,510 --> 00:04:03,160
لا تعتذري

30
00:04:03,160 --> 00:04:06,390
لم أتقدّم لخطبتكِ وذلك كي
أرى وجهكِ بهذا الشّكل

31
00:04:07,520 --> 00:04:08,520
...شين

32
00:04:15,010 --> 00:04:18,780
تمكّنتُ أخيراً من قول كلام كنتُ
أكتمه لعشر سنوات

33
00:04:25,820 --> 00:04:27,340
ماذا عنكِ؟

34
00:04:28,980 --> 00:04:31,540
لا تخافي من جرح المشاعر

35
00:04:32,670 --> 00:04:33,970
أيّتها البلهاء

36
00:04:36,410 --> 00:04:37,590
...شين

37
00:04:57,100 --> 00:04:58,900
ماذا؟ شين-كن؟

38
00:04:59,940 --> 00:05:02,460
كيف حالك يا سيّدي؟

39
00:05:03,160 --> 00:05:05,410
لا مشاكل على الإطلاق

40
00:05:05,410 --> 00:05:08,910
هل ستغضب منّي لو أخبرتُك بأنّني
أريد تخريجي باكراً؟

41
00:05:09,810 --> 00:05:12,170
ستتمكّن من العودة خلال وقت قصير

42
00:05:14,550 --> 00:05:15,810
...سيّدي

43
00:05:15,810 --> 00:05:17,920
ماذا؟ ما الأمر؟

44
00:05:17,920 --> 00:05:22,430
تقدّمتُ لخطبة ميزوهو في اللّيلة
الماضية ورفضَتْني

45
00:05:24,540 --> 00:05:25,530
!ماذا؟

46
00:05:25,530 --> 00:05:30,080
!تـ-تـ-تـ-تقدّمت لخطبتها؟

47
00:05:30,080 --> 00:05:31,690
!هذا مؤلم

48
00:05:31,690 --> 00:05:34,290
هل أنت بخير؟! اهدأ أرجوك

49
00:05:35,060 --> 00:05:36,590
أنا بخير

50
00:05:36,590 --> 00:05:38,580
انصدمتُ قليلاً فحسب

51
00:05:38,580 --> 00:05:40,200
آسف على الأنباء المُفاجئة

52
00:05:42,850 --> 00:05:47,330
بعد أن التقيتُ بميزوهو، وجدتُ
هدفي وهو أن أصبح طبيباً

53
00:05:47,330 --> 00:05:50,200
وأصبحتُ شخصاً يمكنه أن يكون نافعاً
للآخرين ولو قليلاً فقط

54
00:05:50,200 --> 00:05:52,440
أنا مسرور حقّاً لأنّني وقعتُ في حُبّ ميزوهو

55
00:05:52,440 --> 00:05:54,280
من أعماق قلبي

56
00:05:55,160 --> 00:05:56,460
هكذا إذاً

57
00:05:57,130 --> 00:05:58,460
أجل

58
00:06:00,460 --> 00:06:03,220
شكراً لك على قول ذلك

59
00:06:03,590 --> 00:06:06,720
لطالما كنت مُذهلاً يا شين-كن

60
00:06:07,430 --> 00:06:09,560
مضى عشر سنوات منذ ذلك الحين

61
00:06:14,100 --> 00:06:15,520
!مُذهل

62
00:06:15,520 --> 00:06:17,100
!رائع

63
00:06:18,970 --> 00:06:21,520
...اذهب وعِش المُراهقة

64
00:06:22,990 --> 00:06:24,640
الّتي لا يُمكن لأحد مُنافستها

65
00:06:33,240 --> 00:06:39,080
كانت ميزوهو... مُراهقتي

66
00:06:45,100 --> 00:06:46,280
حسناً

67
00:06:46,280 --> 00:06:48,140
!لنشرب بهذه المُناسبة

68
00:06:49,460 --> 00:06:51,140
ليس قبل أن تتعافى

69
00:06:54,310 --> 00:06:56,650
توقّعتُ ذلك

70
00:07:03,220 --> 00:07:05,530
سأبقى في منزلنا اليوم أيضاً

71
00:07:05,530 --> 00:07:07,680
لذا أخبرني إذا أردتني أن أحضر
لك شيئاً من هناك

72
00:07:07,680 --> 00:07:10,250
لا يخطر على ذهني شيء. لكن شكراً

73
00:07:10,250 --> 00:07:11,910
استرح

74
00:07:18,140 --> 00:07:20,420
...لديّ رسائل مُتراكمة كثيرة

75
00:07:28,270 --> 00:07:29,600
هذا مُطمئن

76
00:07:29,600 --> 00:07:31,040
هل تشعرين بالغيرة؟

77
00:07:37,450 --> 00:07:40,440
لم تتمكّني من أن تصبحي رسّامة
مانغا في نهاية المطاف

78
00:07:40,440 --> 00:07:42,040
هل تشعرين بالغيرة؟

79
00:07:43,260 --> 00:07:44,320
لا

80
00:07:45,320 --> 00:07:50,560
حتّى لو شعرتُ بالغيرة، لن أتمكّن من العودة
إلى تلك الأيّام البرّاقة على أيّ حال

81
00:07:55,650 --> 00:07:56,810
أنتِ مُخطئة

82
00:07:56,810 --> 00:07:57,830
ماذا؟

83
00:07:57,830 --> 00:08:00,580
"ليست "لن أتمكّن من العودة

84
00:08:00,940 --> 00:08:03,840
كان ذلك قائماً منذ تلك الأيّام

85
00:08:04,480 --> 00:08:06,720
!إذا كان هذا ما قرّرتِه، فاستمرّي وافعلي ذلك

86
00:08:07,090 --> 00:08:09,840
هل أنتِ متأكّدة من أنّكِ تريدين
البقاء هنا يا ميزوهو؟

87
00:08:10,700 --> 00:08:13,170
لا تخافي من جرح المشاعر

88
00:08:17,570 --> 00:08:18,840
ظللتِ تتقدّمين للأمام

89
00:08:18,840 --> 00:08:21,720
مهما تعثّرتِ من مرّات آنذاك في نهاية المطاف

90
00:08:21,720 --> 00:08:24,980
تفهمين مشاعركِ الخاصّة الآن، صحيح؟

91
00:08:25,480 --> 00:08:26,610
أجل

92
00:08:26,900 --> 00:08:29,840
هيّا! كفاكِ جبناً

93
00:08:29,840 --> 00:08:31,320
!أنتِ بالغة

94
00:08:31,320 --> 00:08:33,620
!أخبرتُكِ بأنّني فهمت

95
00:08:33,620 --> 00:08:36,560
أحسنتِ يا أنا

96
00:08:46,980 --> 00:08:48,300
عليّ أن أذهب

97
00:09:45,150 --> 00:09:46,360
!كيزوكي

98
00:09:52,500 --> 00:09:53,570
!كيزوكي

99
00:09:54,230 --> 00:09:55,820
!ميزوهو؟

100
00:09:58,640 --> 00:10:01,200
ميزوهو؟ ماذا تفعلين؟

101
00:10:03,400 --> 00:10:06,460
...كيزوكي... توقّعتُ بأنّك لا تزال في التّمرين

102
00:10:06,460 --> 00:10:08,010
كنتُ على حقّ

103
00:10:08,910 --> 00:10:10,710
!ما الّذي تُفكّرين فيه؟

104
00:10:11,100 --> 00:10:12,030
ماذا؟

105
00:10:12,030 --> 00:10:15,470
تأتين إلى هنا بمفردكِ في هذا
!الوقت المُتأخّر من اللّيل؟

106
00:10:16,830 --> 00:10:18,470
...في المدرسة الثّانويّة

107
00:10:18,950 --> 00:10:20,750
كنتَ قلقاً عليّ

108
00:10:20,750 --> 00:10:23,380
آنذاك عندما رحتُ لأقدّم لك
شوكولاتة عيد الحُبّ

109
00:10:23,380 --> 00:10:26,730
بينما كنتَ في مُعسكر تدريبك
ووبّختني بسبب ذلك

110
00:10:26,730 --> 00:10:30,980
"قلتَ "لا أعلم ماذا أفعل لو أصابكِ مكروه

111
00:10:31,990 --> 00:10:34,960
...وحتّى الآن، إذا كنت لا تزال تقلق بشأني

112
00:10:34,960 --> 00:10:36,390
لماذا؟

113
00:10:36,390 --> 00:10:38,990
لماذا اختفيت؟

114
00:10:39,640 --> 00:10:40,860
لماذا؟

115
00:10:41,750 --> 00:10:44,120
!لماذا لم تبقَ بجانبي؟

116
00:10:44,120 --> 00:10:46,040
!لأنّني لم أعد أستطيع السّباحة

117
00:10:48,220 --> 00:10:51,550
!كانت السّباحة الشّيء الوحيد الّذي أمتلكه

118
00:10:53,540 --> 00:10:54,550
...كيزوكي

119
00:10:54,550 --> 00:11:00,650
الطّريقة الوحيدة الّتي أستطيع بها
!جعلكِ تنظرين إليّ باستمرار كانت السّباحة

120
00:11:01,980 --> 00:11:03,740
!كيزوكي؟ هل أنت بخير؟

121
00:11:07,190 --> 00:11:11,460
لديّ ثغرة في سُمعتي. يجب
أن أضاعف جهودي أكثر من الجميع

122
00:11:15,320 --> 00:11:16,950
!كيزوكي

123
00:11:20,690 --> 00:11:21,950
...ميزوهو

124
00:11:29,070 --> 00:11:30,840
ماذا تفعلين يا ميزوهو؟

125
00:11:30,840 --> 00:11:32,510
!كفّي عن إثارة قلقي

126
00:11:32,510 --> 00:11:33,520
ماذا؟

127
00:11:34,470 --> 00:11:39,650
استقلتَ من عملك بتهوُّر وعدتَ للسّباحة ثانية

128
00:11:39,650 --> 00:11:43,640
وتسبح في هذه السّاعة رغم
...أنّ كتفك يتألّم

129
00:11:43,640 --> 00:11:45,540
،أنت بالغ ناضج

130
00:11:45,540 --> 00:11:50,470
تندفع بشكل خطير لدرجة أنّك
لا تُلاحظ ما يُحيط بك

131
00:11:50,470 --> 00:11:53,650
ولا أستطيع الإشاحة بنظري
عنك أكثر من أيّ وقت مضى

132
00:11:54,720 --> 00:11:55,900
...أنا

133
00:11:56,280 --> 00:12:01,660
،أريد أن أكون بجانبك بعد عشر
!أو عشرين سنة من الآن

134
00:12:05,220 --> 00:12:08,870
ظللتُ أفكّرِ فيكِ أيضاً يا ميزوهو

135
00:12:09,670 --> 00:12:12,490
لم أنسَ أمركِ يوماً

136
00:12:12,920 --> 00:12:17,420
كنتِ كلّ شيء بالنّسبة لي
منذ كنّا صغيرين

137
00:12:23,560 --> 00:12:25,930
كيزوكي... أُحبّك

138
00:12:49,580 --> 00:12:51,630
ميزوهو؟

139
00:12:51,630 --> 00:12:52,730
ما الأمر؟

140
00:12:53,120 --> 00:12:54,500
لأجل مُباراتي القادمة

141
00:12:54,950 --> 00:12:55,960
نعم؟

142
00:12:56,300 --> 00:12:59,710
،مهما بدوتُ أخرق أو غليظاً

143
00:12:59,710 --> 00:13:01,450
أريدكِ أن تنظري إليّ فحسب

144
00:13:01,450 --> 00:13:02,470
حسناً

145
00:13:02,470 --> 00:13:06,750
حتّى في وضعي الرّاهن، أشعر
وكأنّني أستطيع فعل أيّ شيء

146
00:13:06,750 --> 00:13:08,700
ما دمتِ تنظرين إليّ

147
00:13:09,300 --> 00:13:10,370
حسناً

148
00:13:12,320 --> 00:13:14,150
هل يمكنني قولها أيضاً؟

149
00:13:15,870 --> 00:13:19,990
...بعد عشر، أو عشرين سنة من الآن

150
00:13:21,250 --> 00:13:22,850
!لنكُن معاً للأبد

151
00:13:23,840 --> 00:13:24,990
!حسناً

152
00:13:27,110 --> 00:13:29,530
أحبّكِ يا ميزوهو

153
00:13:37,500 --> 00:13:42,760
كافّة المُنافسين في نهائي السّباحة
!الحُرّة 100 متر للرّجال... تأهّبوا رجاء

154
00:13:53,830 --> 00:13:55,610
حان الوقت أخيراً

155
00:13:55,610 --> 00:13:58,510
لا تجهش بالبُكاء إذا خسرت يا كيزوكي

156
00:13:58,510 --> 00:14:01,790
مهلاً، مهلاً. إنّه سِباق إعادة إحياء
صديقك المُقرّب

157
00:14:01,790 --> 00:14:04,070
شجّعه من أعماق قلبك

158
00:14:04,070 --> 00:14:07,200
هذه هي الطّريقة الوحيدة الّتي
أستطيع تشجيعه من خلالها

159
00:14:08,530 --> 00:14:10,080
أظنّك على حقّ

160
00:14:10,080 --> 00:14:13,080
وبعد؟ عمّاذا أردت أن نتحدّث؟

161
00:14:13,770 --> 00:14:18,000
أفكّر في دراسة الطّبخ في جنوب إيطاليا

162
00:14:18,340 --> 00:14:22,430
في الوضع الرّاهن، بالكاد تُحافظ
المطاعم على وضعها الرّاهن

163
00:14:22,430 --> 00:14:23,590
...والأهمّ من أيّ شيء

164
00:14:23,590 --> 00:14:29,610
أخشى ألّا أصل لمستوى أبي
في الطّبخ إذا بقيتُ هنا

165
00:14:30,090 --> 00:14:31,770
...أخي العزيز

166
00:14:31,770 --> 00:14:33,440
!سونو كومّوسو

167
00:14:34,160 --> 00:14:36,350
!أفلتني! الحرّ شديد جدّاً على ذلك

168
00:14:38,480 --> 00:14:41,130
لديك وجه طبّاخ حقيقيّ

169
00:14:41,130 --> 00:14:42,390
أخبرتُك

170
00:14:42,390 --> 00:14:44,740
بأنّ هذا هو الشّيء الّذي أريد فعله

171
00:14:44,740 --> 00:14:46,670
ألم تُصدّقني؟

172
00:14:48,490 --> 00:14:51,430
آسفة لتأخُّري

173
00:14:52,000 --> 00:14:53,920
!لا عليكِ

174
00:14:53,920 --> 00:14:56,310
!المُنافسة لم تبدأ بعد

175
00:14:56,780 --> 00:14:59,000
!لم أركِ منذ وقت يا كوراشيكي-سان

176
00:14:59,000 --> 00:15:01,970
مرحباً يا هوشيكاوا-سينسي

177
00:15:10,750 --> 00:15:12,520
لا أصدّق بأنّ لديك عمليّة اليوم

178
00:15:13,260 --> 00:15:15,740
أردتَ في الواقع الذّهاب لدعمه، أليس كذلك؟

179
00:15:17,140 --> 00:15:18,340
لا مُشكلة

180
00:15:18,340 --> 00:15:20,660
فهذا هو الطّريق الّذي اخترتُه

181
00:15:21,270 --> 00:15:22,310
إلى اللّقاء

182
00:15:31,580 --> 00:15:33,230
!اقترب الوقت

183
00:15:35,690 --> 00:15:36,770
!تويا؟

184
00:15:38,140 --> 00:15:39,290
آيرو؟

185
00:15:40,310 --> 00:15:41,750
هكذا إذاً

186
00:15:41,750 --> 00:15:44,300
إذاً أنت هنا لالتقاط صور للمجلّة الرّياضيّة

187
00:15:44,630 --> 00:15:47,260
أجل. تسرّني رؤيتك على ما خير ما يُرام

188
00:15:47,260 --> 00:15:48,390
أنت أيضاً يا تويا

189
00:15:50,230 --> 00:15:51,220
تفضّل

190
00:15:51,220 --> 00:15:52,650
كيزوكي هازاوا

191
00:15:53,630 --> 00:15:55,540
!يبدو رائعاً للغاية

192
00:15:55,980 --> 00:16:02,140
أشعر الآن بأنّني أعرف سبب
حُبّك لهذا الشّخص آنذاك

193
00:16:04,570 --> 00:16:07,190
ما الّذي تفعله مؤخّراً؟

194
00:16:09,480 --> 00:16:13,330
وقعتُ في حُبّ شخص من أعماق قلبي

195
00:16:13,870 --> 00:16:16,730
أعيش حاليّاً مع زميلي في الصّفّ
من المدرسة الإعداديّة

196
00:16:16,730 --> 00:16:18,620
التقيتُ معه في لندن

197
00:16:18,620 --> 00:16:19,690
هكذا إذاً

198
00:16:20,700 --> 00:16:24,570
لم أكن أعلم بحدّ ذاتي عندما
التقيتُ بك يا تويا

199
00:16:24,920 --> 00:16:26,510
أنا آسف لأنّني جرحتُك بسبب ذلك

200
00:16:28,640 --> 00:16:33,100
نجوتُ من وحدتي وتمكّنتُ
من إيجاد ذاتي الحقيقيّة

201
00:16:33,100 --> 00:16:37,600
أعتقد بأنّني سعيد الآن لأنّني تمكّنتُ
من اللّقاء بك يا تويا

202
00:16:38,340 --> 00:16:41,600
لذا... شكراً لك

203
00:16:41,970 --> 00:16:43,360
أجل

204
00:16:43,360 --> 00:16:46,070
أنا مسرور لأجلك يا آيرو

205
00:16:46,070 --> 00:16:47,080
شكراً

206
00:16:50,930 --> 00:16:53,420
حسناً، سأعود إلى العمل

207
00:16:56,880 --> 00:16:57,870
!تويا

208
00:17:01,190 --> 00:17:03,430
أريدك أن تجد السّعادة أيضاً يا تويا

209
00:17:05,250 --> 00:17:06,310
حسناً

210
00:17:08,510 --> 00:17:10,770
وداعاً يا تويا

211
00:17:11,380 --> 00:17:12,510
آيرو

212
00:17:12,510 --> 00:17:13,550
أمون

213
00:17:17,360 --> 00:17:19,520
هل كان هو؟

214
00:17:19,520 --> 00:17:21,940
أجل. مُنقِذي

215
00:17:21,940 --> 00:17:24,510
تمكّنتُ أخيراً من شكره

216
00:17:26,350 --> 00:17:27,450
يسرّني ذلك

217
00:17:27,450 --> 00:17:29,400
إذاً لنعُد لتشجيعه

218
00:17:38,410 --> 00:17:40,410
كاشيواغي-سينسي

219
00:17:41,370 --> 00:17:43,100
أنا خائف

220
00:17:43,100 --> 00:17:47,110
سأكون معك طوال فترة العمليّة الجراحيّة

221
00:17:47,110 --> 00:17:48,420
لذا سيكون كلّ شيء على ما يُرام

222
00:17:48,420 --> 00:17:50,630
إذاً لم أعُد خائفاً كثيراً

223
00:17:51,670 --> 00:17:56,410
،عندما ينتهي كلّ شيء وتتعافى
لنذهب ونلعب بالطّائرات الورقيّة ثانية

224
00:17:56,410 --> 00:17:58,530
!أجل! هذا وعد

225
00:17:59,180 --> 00:18:04,720
سوف نبدأ الآن بالسّباق الأخير من السّباحة
الحُرّة 100 متر للرّجال

226
00:18:02,940 --> 00:18:04,720
حان وقت السّباق

227
00:18:04,720 --> 00:18:06,690
سيدخل السّبّاحون الآن

228
00:18:06,690 --> 00:18:09,590
ابذل قصارى جهدك أيضاً يا كيزوكي

229
00:18:10,400 --> 00:18:12,350
حسناً إذاً. هيّا بنا

230
00:18:12,700 --> 00:18:13,790
!حسناً

231
00:18:17,450 --> 00:18:18,460
!يمكنك فعلها

232
00:18:18,460 --> 00:18:19,510
!ابذل قصارى جهدك

233
00:18:19,510 --> 00:18:20,950
!افعل ما بوسعك

234
00:18:31,340 --> 00:18:32,970
كيزوكي هازاوا

235
00:18:43,980 --> 00:18:47,140
،مهما بدوتُ أخرق أو غليظاً

236
00:18:47,140 --> 00:18:49,350
أريدكِ أن تنظري إليّ فحسب

237
00:18:49,350 --> 00:18:50,230
حسناً

238
00:18:50,230 --> 00:18:54,500
حتّى بوضعي الرّاهن، أشعر وكأنّني
أستطيع فعل أيّ شيء

239
00:18:54,500 --> 00:18:56,480
ما دمتِ تنظرين إليّ

240
00:18:56,870 --> 00:18:57,700
حسناً

241
00:19:07,110 --> 00:19:08,280
!...كيزوكي

242
00:19:13,590 --> 00:19:15,570
إعلان النّصر ذاك ثانية؟

243
00:19:15,570 --> 00:19:16,720
!يا للشّغب

244
00:19:16,720 --> 00:19:21,230
أنا مُندهش من أنّ قدرة كيزوكي
على العودة إلى هناك مُجدّداً

245
00:19:21,230 --> 00:19:24,290
كنتَ قادراً على العودة إلى التّدريس
يا هوشيكاوا-سينسي

246
00:19:24,290 --> 00:19:26,000
هذا ما أعتقده

247
00:19:26,310 --> 00:19:28,280
كلام واقعيّ

248
00:19:28,280 --> 00:19:33,320
أعتقد بأنّ المدارس تحتاج مُعلّمين
مثلك يا هوشيكاوا-سينسي

249
00:19:33,320 --> 00:19:35,320
مُعلّمون مثلي؟

250
00:19:35,320 --> 00:19:38,670
لأنّ التّلاميذ يشعرون بأمان أكبر

251
00:19:38,670 --> 00:19:40,980
بوجود مُعلّم مُثير للاهتمام مثلك

252
00:19:40,980 --> 00:19:43,150
هل هذا مديح؟

253
00:19:44,780 --> 00:19:46,460
أجل، هو كذلك

254
00:19:47,370 --> 00:19:48,510
كوراشيكي-سان

255
00:19:48,510 --> 00:19:49,540
نعم؟

256
00:19:49,540 --> 00:19:50,740
شكراً لكِ

257
00:19:50,740 --> 00:19:51,710
مُقرف

258
00:19:56,100 --> 00:19:58,470
كيزوكي. ميزوهو

259
00:19:58,470 --> 00:20:00,530
حظّاً طيّباً لكما

260
00:20:22,440 --> 00:20:25,250
ميزوهو. راقبيني

261
00:20:25,890 --> 00:20:27,500
في مواقعكم

262
00:20:30,010 --> 00:20:32,170
...حتّى ولو كان هناك أسواراً

263
00:20:32,170 --> 00:20:34,460
...إذا جرحك شيء بشكل عميق

264
00:20:34,820 --> 00:20:38,370
فسنكون بخير بما أنّنا تمكنّا من تجاوُز
أيّام المُراهقة تلك

265
00:20:38,780 --> 00:20:42,110
أنا متأكّدة بأنّنا نستطيع التغلُّب
عليها بشكل أقوى حتّى

266
00:20:42,530 --> 00:20:46,520
يمكننا الاستمرار في السّباحة
تحت ذلك الضّوء الأزرق

267
00:20:48,890 --> 00:20:52,270
!يمكنك فعلها يا كيزوكي

268
00:22:54,350 --> 00:22:56,600
!صباح الخير يا ميزوهو

269
00:22:58,030 --> 00:22:59,360
!صباح الخير

270
00:23:03,030 --> 00:23:04,370
...من جديد

271
00:23:05,700 --> 00:23:07,970
...لو أستطيع العودة إلى ذلك اليوم

272
00:23:08,620 --> 00:23:14,070
،أنا متأكّدة بأنّه ستكون أحلامي نفسها
،وأتعثّر في نفس الأماكن

273
00:23:14,070 --> 00:23:17,130
وأضحك وأبكي في نفس الأوقات

274
00:23:17,650 --> 00:23:20,430
وسأقف

275
00:23:22,720 --> 00:23:24,630
مع نفس هؤلاء الأصدقاء

276
00:23:27,140 --> 00:23:32,280
وسنقضي هذه الأيّام الّتي لا تُعوَّض بثمن
ولا يمكن أن تتكرّر ثانية

277
00:23:35,810 --> 00:23:37,100
...ثمّ

278
00:23:37,900 --> 00:23:41,920
سأقع في الحُبّ بنفس الطّريقة من جديد