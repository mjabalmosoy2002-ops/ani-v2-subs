1
00:00:01,980 --> 00:00:04,980
هل ما زلتُ أخاً صغيراً بالنّسبة لك؟

2
00:00:06,740 --> 00:00:08,050
ميزوهو؟

3
00:00:08,050 --> 00:00:09,420
لا

4
00:00:09,420 --> 00:00:10,610
أنت حبيبي

5
00:00:11,050 --> 00:00:14,120
!اعتباراً من هذه اللّحظة، أنت حبيبي

6
00:00:14,120 --> 00:00:17,250
تتدفّق السّعادة منك

7
00:00:17,750 --> 00:00:21,760
هذا لأنّ ميزوهو دائماً ما تنظر نحوي

8
00:00:22,830 --> 00:00:26,630
لهذا السّبب أنا سعيد جدّاً لأنّ مشاعري
!كانت قادرة على بلوغها

9
00:00:26,920 --> 00:00:29,630
—أريد رؤية ميزوهو فجأة

10
00:00:34,660 --> 00:00:39,160
ميزوهو ليست الوحيدة الّتي كانت
تنظر نحوك يا كيزوكي

11
00:01:02,420 --> 00:01:03,670
مرحباً؟

12
00:01:03,670 --> 00:01:05,450
ميزوهو

13
00:01:07,180 --> 00:01:09,730
هل دعاكِ شين لتناول طعام لذيذ ما؟

14
00:01:10,670 --> 00:01:14,810
آسف لأنّني جعلتُكِ تحضرين مهرجان
الألعاب النّاريّة بمفردكِ

15
00:01:14,810 --> 00:01:17,230
سأعوّضكِ بطريقة ما

16
00:01:18,660 --> 00:01:20,610
هذا ليس بالأمر الجلل

17
00:01:22,080 --> 00:01:24,380
هل حدث شيء يا ميزوهو؟

18
00:01:25,230 --> 00:01:27,190
يبدو وكأنّكِ تضغطين على نفسكِ

19
00:01:28,600 --> 00:01:31,920
رأيتُ كيزوكي في يوم مهرجان
الألعاب النّاريّة

20
00:01:33,000 --> 00:01:34,420
هل أنتِ بخير؟

21
00:01:34,420 --> 00:01:35,450
أجل

22
00:01:35,790 --> 00:01:37,180
هذا غريب، أليس كذلك؟

23
00:01:37,560 --> 00:01:39,450
...كان من المُفترض أن ينتهي الأمر، لكن

24
00:01:41,550 --> 00:01:44,970
أنا في منزلنا السّرّي الآن

25
00:01:44,970 --> 00:01:46,090
ماذا؟

26
00:01:46,090 --> 00:01:47,600
أخبرتُكِ من قبل، صحيح؟

27
00:01:47,600 --> 00:01:50,310
،مهما كان القرار الّذي تختارينه

28
00:01:50,710 --> 00:01:53,340
سأكون حليفكِ للأبد

29
00:01:54,330 --> 00:01:55,850
سأكون بجانبكِ

30
00:01:56,420 --> 00:01:58,700
ماذا؟ هل تبكين من شدّة لطفي؟

31
00:01:58,700 --> 00:02:00,350
!لستُ كذلك

32
00:02:01,890 --> 00:02:03,980
لكن أشكرك

33
00:02:07,060 --> 00:02:11,280
كانت تلك الكلمات الّتي أخبرتِني
بها عندما أنقذتني

34
00:03:54,390 --> 00:03:58,550
ميزوهو ليست الوحيدة الّتي كانت
تنظر نحوك يا كيزوكي

35
00:03:59,360 --> 00:04:01,580
أصبح ذلك الإدراك واضحاً لي

36
00:04:01,580 --> 00:04:04,680
عندما خضنا رحلة الصّفّ السّادس آنذاك

37
00:04:07,040 --> 00:04:08,810
وأنت تعتقد ذلك أيضاً، أليس
كذلك يا أيرو؟

38
00:04:08,810 --> 00:04:09,880
ماذا؟

39
00:04:09,880 --> 00:04:12,430
كوباياشي من الصّفّ 3! إنّها ظريفة، صحيح؟

40
00:04:12,790 --> 00:04:16,210
أجل. إنّها أظرف فتاة في سنتنا الدّراسيّة

41
00:04:16,210 --> 00:04:18,880
!إذا أردتُ الخروج مع أحد، فستكون كوباياشي

42
00:04:18,880 --> 00:04:21,250
لا. ماذا عن مياموتو من الصّفّ 2؟

43
00:04:21,250 --> 00:04:24,540
في الواقع... أجل

44
00:04:25,100 --> 00:04:28,030
!أنتم! نحن في فترة حظر التجوُّل

45
00:04:28,030 --> 00:04:29,390
!بئساً! لنتظاهر بالنّوم

46
00:04:28,030 --> 00:04:29,390
!اختبئوا

47
00:04:29,830 --> 00:04:32,540
!تبّاً. ناموا بسرعة

48
00:04:43,910 --> 00:04:45,820
!أ-أنت قريبٌ جدّاً

49
00:04:45,820 --> 00:04:47,570
!اذهب إلى هناك يا كيزوكي

50
00:04:49,610 --> 00:04:52,530
الآخرون جميعهم يحبّون الفتيات

51
00:04:52,530 --> 00:04:54,560
...لكن كنتُ مهتمّاً بـ

52
00:05:02,950 --> 00:05:05,210
أمّي؟

53
00:05:05,210 --> 00:05:07,440
تحبّين أبي، أليس كذلك؟

54
00:05:09,130 --> 00:05:10,870
لكن لماذا أبي؟

55
00:05:12,500 --> 00:05:13,920
ماذا؟

56
00:05:13,920 --> 00:05:16,250
معك حقّ. لماذا هو؟

57
00:05:16,250 --> 00:05:19,350
إنّه ضعيف في القتال وحديثه مُملّ

58
00:05:19,350 --> 00:05:22,230
يستفزّني شعوره الكبير بالمسؤوليّة ولطفه

59
00:05:22,230 --> 00:05:23,420
...لكن

60
00:05:25,020 --> 00:05:28,650
ربّما لأنّه لم يكن مُنحازاً لي رغم أنّني غيارو

61
00:05:29,760 --> 00:05:31,770
لحظة، ما سبب السّؤال يا أيرو؟

62
00:05:32,170 --> 00:05:33,530
هل يجول شيء في خاطرك؟

63
00:05:35,890 --> 00:05:37,130
!لا شيء

64
00:05:45,780 --> 00:05:50,790
لم أستطع إخبار أحد بأنّني أحبّ كيزوكي

65
00:05:56,540 --> 00:05:58,790
هل فهمت كلّ شيء يا كيزوكي؟

66
00:05:58,790 --> 00:06:00,690
لا أدري

67
00:06:00,000 --> 00:06:05,010
لأنّني عرفتُ بأنّ كيزوكي يضع
نُصب عينيه دوماً على ميزوهو

68
00:06:00,690 --> 00:06:01,760
متأكّد؟

69
00:06:01,760 --> 00:06:03,370
ماذا عن لِباس التّربية البدنيّة خاصّتك؟

70
00:06:03,370 --> 00:06:05,410
ماذا؟ تفقّدي لأجلي يا ميزوهو

71
00:06:05,410 --> 00:06:07,410
...بربّك

72
00:06:10,060 --> 00:06:12,680
أيرو-كن؟ لا أدري

73
00:06:13,010 --> 00:06:14,840
لم يأتِ إلى هنا منذ الحصّة الأولى

74
00:06:14,840 --> 00:06:17,070
هكذا إذاً. شكراً

75
00:06:17,960 --> 00:06:19,660
يتغيّب من جديد؟

76
00:06:19,660 --> 00:06:22,000
هل أنا أتوهّم أم أنّه يتصرّف
بغرابة في الآونة الأخيرة

77
00:06:22,800 --> 00:06:25,220
لم يأتِ إلى منزل ميزوهو أيضاً

78
00:06:26,200 --> 00:06:29,330
ماذا يفعل أيرو، وأين هو؟

79
00:06:34,130 --> 00:06:35,450
هل انتهيت؟

80
00:06:35,450 --> 00:06:37,750
أنت من بدأ القتال من الأساس

81
00:06:39,120 --> 00:06:42,150
لنلعب أكثر أيّها الضّخام

82
00:06:44,470 --> 00:06:47,110
!هذا الشّخص فظيع! إنّه مجنون

83
00:06:53,620 --> 00:06:54,950
قد تكون مُحقّاً

84
00:06:59,730 --> 00:07:01,380
"أنا "مجنون

85
00:07:03,380 --> 00:07:07,610
من أكون بالضّبط؟

86
00:07:20,110 --> 00:07:21,630
كم هذا مُزعج

87
00:07:26,140 --> 00:07:27,780
يا لها من صدفة

88
00:07:27,780 --> 00:07:30,190
رئيس صفّنا دون سِواه، أمون-كن

89
00:07:30,190 --> 00:07:31,390
ذهبتَ إلى مدرسة الحشو؟

90
00:07:31,390 --> 00:07:33,600
...إ-إيزومي-كن

91
00:07:33,600 --> 00:07:35,920
ماذا تفعل؟ أتتغيّب عن الدّرس ثانية؟

92
00:07:35,920 --> 00:07:37,630
كفى إلحاحاً

93
00:07:37,630 --> 00:07:39,460
هلّا أقرضتني بعض المال؟

94
00:07:39,460 --> 00:07:41,270
أنفقتُ كلّ مالي

95
00:07:41,270 --> 00:07:43,480
ماذا؟ مستحيل

96
00:07:43,480 --> 00:07:45,020
!أفلتني

97
00:07:45,020 --> 00:07:47,530
—هيّا. قليلاً فقط

98
00:07:47,530 --> 00:07:48,530
!أيرو

99
00:07:49,940 --> 00:07:52,190
!آسف! آسف جدّاً

100
00:07:52,660 --> 00:07:53,680
!أيرو

101
00:07:58,330 --> 00:08:00,080
أ-أمون-كن

102
00:08:00,080 --> 00:08:03,090
هل تعرف إلى أين ذهب أيرو؟

103
00:08:04,860 --> 00:08:05,940
...إنّه

104
00:08:11,960 --> 00:08:13,990
هازاوا-كن رحل الآن

105
00:08:16,190 --> 00:08:17,980
هل يمكنني قول شيء؟

106
00:08:19,780 --> 00:08:22,990
أعلم بأنّك وأنا نعيش في عالمين
مُختلفين كلّياً

107
00:08:22,990 --> 00:08:26,460
وأنّنا لا نملك شيئاً نفعله مع بعضنا
...الآخر لبقيّة حياتنا

108
00:08:27,460 --> 00:08:31,370
لكن عرفتُ فوراً بأنّك تُخفي شخصيّتك الحقيقيّة

109
00:08:33,720 --> 00:08:35,620
اصمت يا أمون

110
00:08:36,830 --> 00:08:39,870
ما هذا الهراء الّذي تتفوّه به؟

111
00:08:40,970 --> 00:08:43,630
...أعتذر. لكن

112
00:08:44,150 --> 00:08:45,870
أنا مثلك فحسب

113
00:08:45,870 --> 00:08:48,130
شخص عليه أن يخفي شخصيّته حاليّاً

114
00:09:00,700 --> 00:09:04,580
لكن عرفتُ فوراً بأنّك تُخفي شخصيّتك الحقيقيّة

115
00:09:04,580 --> 00:09:05,940
اصمت

116
00:09:06,400 --> 00:09:09,340
!اصمت. اصمت

117
00:09:09,650 --> 00:09:12,290
شخصيّتي الحقيقيّة؟ لا يهمّ

118
00:09:12,970 --> 00:09:14,720
!اغرب عن وجهي

119
00:09:26,750 --> 00:09:28,010
عُد إلى المنزل

120
00:09:28,010 --> 00:09:29,380
!تويا-سان

121
00:09:29,760 --> 00:09:34,010
هذا ليس مكاناً ليلعب فيه مُغفّلون أمثالك

122
00:09:37,010 --> 00:09:38,400
!هذا الطّفل الوقح

123
00:09:38,400 --> 00:09:40,520
!ماذا تفعل لتويا-سان؟

124
00:09:41,440 --> 00:09:42,960
لن أعود إلى المنزل

125
00:09:44,360 --> 00:09:47,270
إذ لا يوجد لي منزل

126
00:09:50,530 --> 00:09:54,730
أريد الذّهاب إلى مكان ليس هنا

127
00:10:04,040 --> 00:10:06,910
اخلع قميصك واجلس هناك

128
00:10:15,270 --> 00:10:17,490
هل أنت في المدرسة الثّانويّة؟

129
00:10:17,490 --> 00:10:18,440
أجل

130
00:10:19,430 --> 00:10:22,310
تعيش في هذا المكان الواسع بمفردك؟

131
00:10:23,120 --> 00:10:26,060
غادرتْ أمّي مع رجل ما

132
00:10:26,620 --> 00:10:29,600
طلب منّي أبي أن أتخرّج من الثّانويّة
وهذا كلّ شيء

133
00:10:29,600 --> 00:10:31,310
نادراً ما يأتي إلى المنزل بسبب العمل

134
00:10:35,800 --> 00:10:37,110
هل أنت أحمق أم ماذا؟

135
00:10:38,780 --> 00:10:42,520
من الغريب أن تدعو شخصاً التقيتَه
للتو إلى منزلك

136
00:10:42,520 --> 00:10:43,830
وحتّى أنّك داويت جروحي

137
00:10:44,400 --> 00:10:46,830
بوسعي سرقتك والمُغادرة

138
00:10:46,830 --> 00:10:50,090
مُحال أن تفعل ذلك

139
00:10:52,360 --> 00:10:55,050
...التقرُّب من شخص لأخذ ماله

140
00:10:55,050 --> 00:10:58,200
...الاستخفاف بشخص للتحكُّم به

141
00:10:58,200 --> 00:11:01,140
...التخلّص من العقبات للعيش بحرّية

142
00:11:01,870 --> 00:11:03,600
أستطيع تمييز النّاس بهذا الشّكل

143
00:11:04,240 --> 00:11:05,260
ارتدِ هذا ونَم

144
00:11:05,260 --> 00:11:06,260
ماذا؟

145
00:11:07,410 --> 00:11:09,730
يمكنك الاستحمام إذا أردت

146
00:11:10,370 --> 00:11:11,230
اسمع

147
00:11:13,230 --> 00:11:15,430
يمكنك قراءة أفكار النّاس
بالنّظر إليهم، صحيح؟

148
00:11:16,050 --> 00:11:17,920
هل هذا يشملني؟

149
00:11:22,540 --> 00:11:27,240
يبدو... أنّني أنجذب للرّجال

150
00:11:31,870 --> 00:11:33,260
هذا غريب، أليس كذلك؟

151
00:11:33,660 --> 00:11:35,010
مُثير للضّحك

152
00:11:37,590 --> 00:11:40,010
لستَ غريباً

153
00:11:41,440 --> 00:11:44,450
شعرتُ بأنّك تبدو وكأنّك تتألّم
عندما كنتُما تتشاجران

154
00:11:44,450 --> 00:11:45,390
لهذا السّبب

155
00:11:47,080 --> 00:11:48,900
لم أستطع تجاهلك

156
00:11:49,240 --> 00:11:50,560
اخلد إلى النّوم بسرعة

157
00:12:01,850 --> 00:12:04,330
لستَ غريباً

158
00:12:07,410 --> 00:12:10,000
بدلاً من الجروح الّتي تلقّيتُها
،عندما كنتُ ألكم الآخرين

159
00:12:10,000 --> 00:12:12,910
تغلغل صوت تويا إلى داخل جسدي كلّه

160
00:12:13,370 --> 00:12:17,280
في تلك اللّيلة، نمتُ بعمق كلّ
الوقت حتّى الصّباح

161
00:12:41,870 --> 00:12:44,660
أولئك الأشخاص يتعذّر فهمهم حقّاً

162
00:12:44,660 --> 00:12:46,290
إنّهم يعبثون معنا

163
00:12:46,290 --> 00:12:49,400
لنقضِ على أولئك الأشخاص من كينزاكي للأبد

164
00:12:52,540 --> 00:12:54,670
لا تُقحموا أنفسكم معهم

165
00:12:55,370 --> 00:12:56,550
...لكن

166
00:13:00,590 --> 00:13:02,300
أيرو

167
00:13:03,050 --> 00:13:06,800
هاتفك مُزعج جدّاً. حتّى في مُنتصف اللّيل

168
00:13:07,720 --> 00:13:09,060
أجب عليه

169
00:13:09,060 --> 00:13:11,250
لا بُدّ أنّ والديكِ قلقان

170
00:13:12,320 --> 00:13:13,970
!على أيّ حال

171
00:13:16,090 --> 00:13:18,070
ما رأيك بهذه؟

172
00:13:18,070 --> 00:13:20,130
!مُفاجأة! أقراط أذن

173
00:13:21,710 --> 00:13:24,910
،أحببتُ أقراط أذنك يا تويا
لذا قرّرتُ تقليدك

174
00:13:25,280 --> 00:13:26,570
نحن الآن مُتطابقان

175
00:13:34,820 --> 00:13:35,920
اصعد

176
00:13:36,350 --> 00:13:37,350
!حسناً

177
00:13:53,450 --> 00:13:55,940
!مرحى

178
00:14:00,190 --> 00:14:04,200
!أجل! هذا رائع

179
00:14:28,690 --> 00:14:30,830
لا تتحمّس كثيراً يا أيرو

180
00:14:37,380 --> 00:14:42,030
كفاك وقاحة فقط لأنّ تويا-سان
قد أُعجِب بك

181
00:14:46,060 --> 00:14:50,990
لم نعتبرك واحداً منّا يوماً

182
00:14:50,990 --> 00:14:54,290
أنت لا تنتمي لهذا المكان

183
00:14:55,270 --> 00:14:59,310
لكن أعتقد بأنّ لا منزل لك تذهب
إليه على أيّ حال

184
00:15:00,580 --> 00:15:01,800
هيّا بنا

185
00:15:02,940 --> 00:15:04,720
مغرور جدّاً

186
00:15:25,530 --> 00:15:27,560
كيف أجعل ذلك يختفي؟

187
00:16:00,140 --> 00:16:01,400
!أيرو

188
00:16:03,410 --> 00:16:05,150
يسرّني أنّك أتيت

189
00:16:09,200 --> 00:16:12,330
ما مُشكلة هذه الجروح؟ هل أنت بخير؟

190
00:16:13,190 --> 00:16:14,660
!لنذهب إلى المشفى

191
00:16:14,660 --> 00:16:17,170
!أمّك والجميع قلقون عليك

192
00:16:24,100 --> 00:16:25,290
ميزوهو

193
00:16:25,890 --> 00:16:27,220
اخرجي معي

194
00:16:27,220 --> 00:16:28,320
ماذا؟

195
00:16:29,190 --> 00:16:33,220
أكره نفسي كثيراً الآن

196
00:16:34,120 --> 00:16:36,280
لا أنتمي إلى أيّ مكان

197
00:16:39,670 --> 00:16:40,900
...لكن

198
00:16:42,710 --> 00:16:46,740
أشعر وكأنّني أستطيع أن أتغيّر
إذا خرجتُ معكِ

199
00:16:47,690 --> 00:16:52,130
إذا وقعتُ في حُبّ ميزوهو، مثل
...كيزوكي، فرُبّما أستطيع

200
00:16:54,750 --> 00:16:55,990
لن أخرج معك

201
00:16:58,160 --> 00:17:02,670
أنت لا تحبّني عاطفيّاً، أليس كذلك يا أيرو؟

202
00:17:12,200 --> 00:17:14,340
...حتّى لو لم أكن حبيبتك

203
00:17:15,310 --> 00:17:17,450
سأبقى بجانبك يا أيرو

204
00:17:21,600 --> 00:17:23,380
سأبقى حليفتك دوماً

205
00:17:24,090 --> 00:17:26,900
فأنت تنتمي إلى هذا المكان يا أيرو

206
00:17:29,230 --> 00:17:30,320
...ميزوهو

207
00:17:32,110 --> 00:17:33,580
أريد الذّهاب إلى المنزل

208
00:17:34,390 --> 00:17:38,230
لكن لا أعرف ماذا أفعل

209
00:17:41,790 --> 00:17:44,680
كان ذلك الوجه مُضحكاً للغاية

210
00:17:46,860 --> 00:17:48,040
أين هو؟

211
00:17:48,930 --> 00:17:49,800
لا أدري

212
00:17:50,980 --> 00:17:52,490
من أنتم؟

213
00:17:56,210 --> 00:17:57,400
المعذرة

214
00:17:57,400 --> 00:17:59,270
هل تعرفون أيرو إيزومي؟

215
00:17:59,610 --> 00:18:02,530
أحدهم قال بأنّه رآه هنا، ونحن نبحث عنه

216
00:18:02,530 --> 00:18:04,270
أصدقاؤه؟

217
00:18:04,270 --> 00:18:06,490
!أخبرونا إن كنتم تعلمون رجاء

218
00:18:06,490 --> 00:18:09,050
...لم يعُد أيرو إلى المنزل منذ فترة طويلة

219
00:18:10,460 --> 00:18:12,030
وما شأننا نحن؟

220
00:18:12,030 --> 00:18:15,450
إنّه لا يخبرنا عن سبب عدم
...عودته إلى المنزل

221
00:18:15,450 --> 00:18:17,850
لا نعلم ماذا نفعل بعد الآن

222
00:18:17,850 --> 00:18:18,960
...إذا

223
00:18:17,850 --> 00:18:19,640
—كيزوكي

224
00:18:19,640 --> 00:18:20,650
أنتم

225
00:18:21,240 --> 00:18:22,290
!نعم

226
00:18:22,590 --> 00:18:25,040
ما أنتم بالنّسبة له؟

227
00:18:25,040 --> 00:18:28,840
إنّ أيرو... صديق طفولة هامّ جدّاً بالنّسبة لي

228
00:18:35,380 --> 00:18:36,580
هكذا إذاً

229
00:18:37,800 --> 00:18:39,180
!المعذرة

230
00:18:39,180 --> 00:18:40,790
لا أدري

231
00:18:40,790 --> 00:18:42,930
لم أسمع منه شيئاً

232
00:18:43,440 --> 00:18:46,010
لكن بالنّظر إليكم أنتم الثّلاثة، فهمتُ الفحوى

233
00:18:46,440 --> 00:18:48,090
إنّه خائف

234
00:18:48,090 --> 00:18:52,940
،إنّه يحبّكم ويهتمّ لأمركم كثيراً
وهذا ما يُخيفه

235
00:19:17,840 --> 00:19:19,610
معركة بين عدد من الشّباب

236
00:19:19,610 --> 00:19:21,850
العديد منهم هربوا من مسرح الحدث

237
00:19:22,210 --> 00:19:24,030
!أنت! توقّف مكانك

238
00:19:39,730 --> 00:19:41,130
من أين ذهب؟

239
00:19:43,230 --> 00:19:44,980
هل فهمت؟

240
00:19:44,980 --> 00:19:47,900
أنت تعيش في عالم مُختلف عن عالمنا

241
00:19:50,270 --> 00:19:51,850
لذا كُفّ عن الضّغط على نفسك

242
00:19:52,310 --> 00:19:54,430
عُد إلى أصدقائك، إلى منزلك

243
00:19:55,850 --> 00:19:57,440
ماذا تقول؟

244
00:19:57,440 --> 00:20:00,890
هم من قرّروا القتال مع أولئك
الأشخاص من كينزاكي

245
00:20:01,150 --> 00:20:03,280
أردتُ فقط أن أستدعيك يا تويا

246
00:20:03,280 --> 00:20:04,890
والآن جاءت الشّرطة

247
00:20:04,890 --> 00:20:07,810
لستَ جزءاً من كلّ هذا

248
00:20:08,710 --> 00:20:10,360
!بل أنا كذلك

249
00:20:10,360 --> 00:20:11,650
!سأذهب أيضاً

250
00:20:18,390 --> 00:20:21,140
هل ما زال بمقدورك قول نفس
الكلام بعد هذا؟

251
00:20:29,210 --> 00:20:30,710
لن أفعل شيئاً

252
00:20:30,710 --> 00:20:34,300
لا تقلق. لن أمسّك

253
00:20:35,860 --> 00:20:38,690
تحبّ ذلك الشّخص، كيزوكي، أليس كذلك؟

254
00:20:39,830 --> 00:20:41,710
واجه الأمر إذاً

255
00:20:42,660 --> 00:20:46,520
إنّه من النّوع الّذي لا يهرب
عند المُجابهة، صحيح؟

256
00:20:47,330 --> 00:20:50,090
كفّ عن مُحاولة إخفاء مخاوفك

257
00:20:53,720 --> 00:20:55,450
!انتظر! تويا

258
00:20:59,780 --> 00:21:02,150
لا تقترب منّا ثانية أبداً

259
00:21:06,330 --> 00:21:10,160
إنّه من النّوع الّذي لا يهرب
عند المُجابهة، صحيح؟

260
00:21:22,530 --> 00:21:26,680
ميزوهو ليست الوحيدة الّتي كانت
تنظر نحوك يا كيزوكي

261
00:21:26,680 --> 00:21:28,830
أحبّك يا كيزوكي

262
00:21:41,470 --> 00:21:43,150
آسف لأنّني صدمتُك

263
00:21:43,150 --> 00:21:44,180
أيرو؟

264
00:21:44,180 --> 00:21:45,180
انسَ الأمر

265
00:21:45,180 --> 00:21:46,450
لا تقل شيئاً

266
00:21:50,360 --> 00:21:52,790
لا أستطيع الخروج معك يا أيرو

267
00:21:53,310 --> 00:21:54,960
لأنّني أحبّ ميزوهو

268
00:21:56,450 --> 00:21:57,710
...لكن

269
00:21:58,110 --> 00:22:00,350
أنت شخص مهمّ جدّاً بالنّسبة لي يا أيرو

270
00:22:01,080 --> 00:22:04,610
أريد أن أستمرّ في الذّهاب
معك إلى المدرسة غداً

271
00:22:04,610 --> 00:22:06,600
والذّهاب إلى الشّاطئ معك ثانية

272
00:22:06,600 --> 00:22:08,970
والحديث عن مجموعة أشياء والضّحك معك

273
00:22:09,310 --> 00:22:11,510
هل يمكنني الاستمرار في أن
أكون بجانبك؟

274
00:22:17,820 --> 00:22:19,930
سأبقى بجانبك دوماً يا أيرو

275
00:22:21,540 --> 00:22:23,620
أ-أيرو؟

276
00:22:27,600 --> 00:22:28,620
أجل

277
00:22:30,650 --> 00:22:33,320
لن أفكّر في طمسها

278
00:22:35,400 --> 00:22:37,140
"ذاتي الحقيقيّة"