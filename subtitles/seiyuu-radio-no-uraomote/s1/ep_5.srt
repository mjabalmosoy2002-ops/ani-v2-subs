1
00:00:00,700 --> 00:00:03,340
.ها قد فعلتِها يا يوميكو

2
00:00:03,770 --> 00:00:07,980
ماتت معبودةُ الجماهيرِ مؤدّيةُ
.الأصواتِ أوتاتاني ياسومي البارحة

3
00:00:07,980 --> 00:00:12,820
هل لديك أيّ فكرة عن مقدار المال
والطّاقة الّذي أنفقناه أنا والوكالة عليك؟

4
00:00:12,820 --> 00:00:15,680
.وكلّ ذلك ذهب هباءً البارحة

5
00:00:15,680 --> 00:00:16,470
.أعلم

6
00:00:16,470 --> 00:00:17,540
!أنا جدّ آسفة

7
00:00:17,540 --> 00:00:20,440
.سنذهب إلى بلو كراون للاعتذار

8
00:00:20,440 --> 00:00:23,300
.حجزت لنا موعدًا، لذلك سنذهب الآن

9
00:00:40,890 --> 00:00:47,560
الجوانب المتعدّدة
لإذاعة مؤدّي الأصوات

10
00:01:55,550 --> 00:01:59,510
‫#05 يوهي وياسومي سيواصلان الأمر بالتّأكيد؟

11
00:01:59,890 --> 00:02:02,910
.كاغاساكي-سان. من اللّطيف رؤيتك

12
00:02:02,910 --> 00:02:05,590
آسفة لأنّنا لم نلتقِ منذ وقت
.طويل أيّها الرّئيس كاشيما

13
00:02:05,590 --> 00:02:07,110
!الرّئيس؟

14
00:02:07,400 --> 00:02:08,960
.سررت بلقائك

15
00:02:08,960 --> 00:02:13,740
.أنا رئيس وكالة بلو كراون واسمي كاشيما

16
00:02:13,740 --> 00:02:15,730
.سـ-سررت بلقائك

17
00:02:16,490 --> 00:02:20,230
اسمي أوتاتاني ياسومي
.وأنا أعمل لدى تشوكو براوني

18
00:02:20,230 --> 00:02:22,270
...أيّها الرّئيس كاشيما، أتينا اليوم

19
00:02:22,270 --> 00:02:24,540
.عفوًا، لا بأس بالأمر

20
00:02:24,870 --> 00:02:27,290
لماذا لا تجلسان أوّلاً؟

21
00:02:29,710 --> 00:02:33,310
.ما فعلتِه كان بلا ضرورة بكلّ تأكيد

22
00:02:33,870 --> 00:02:36,780
كانت وكالتنا تستعدّ لشرح كلّ شيء

23
00:02:36,780 --> 00:02:39,580
.بالطّريقة الصّحيحة لتبديد سوء التّفاهم

24
00:02:39,580 --> 00:02:42,280
كانت يوغوري يوهي لتواصل العمل

25
00:02:42,280 --> 00:02:45,690
.كمعبودةِ جماهيرَ مؤدّيةِ أصواتٍ بدون أن تتأثّر

26
00:02:46,220 --> 00:02:48,780
.أفهم أنّ ما فعلتُه كان تصرّفًا متسرّعًا

27
00:02:48,780 --> 00:02:50,890
.لم أفكّر في الأمر مليًّا

28
00:02:51,330 --> 00:02:53,520
.أنا جدّ آسفة بالفعل

29
00:02:53,850 --> 00:02:59,790
أعتقد أنّ النّدم هو أهمّ شيء
.عندما يرتكب المرء خطأ ما

30
00:02:59,790 --> 00:03:03,690
إنّ التّعلّم من التّجارب المريرة
.هو ما يمنحها معنى

31
00:03:03,690 --> 00:03:07,730
هل أنت نادمة حقًّا وصدقًا على ما فعلتِه؟

32
00:03:08,330 --> 00:03:09,600
نادمة؟

33
00:03:11,420 --> 00:03:14,220
.لستُ... نادمة

34
00:03:14,730 --> 00:03:16,790
.أنا جدّ آسفة بسبب ما حدث

35
00:03:16,790 --> 00:03:18,390
.فكّرتُ كثيرًا في أفعالي

36
00:03:18,390 --> 00:03:21,950
.لكنّي لستُ نادمة على ما فعلتُه

37
00:03:22,320 --> 00:03:24,540
،حتّى إن استطعت العودة بالزّمن للوراء

38
00:03:24,540 --> 00:03:27,450
.كنتُ لأفعل نفس الشّيء ثانية على الأرجح

39
00:03:27,450 --> 00:03:29,730
وعلى الأقلّ، لا أعتقد أنّي كنتُ مخطئة

40
00:03:29,730 --> 00:03:32,230
.عندما حاولت القيام بشيء لأجل واتانابي

41
00:03:35,350 --> 00:03:36,940
...اسمعي

42
00:03:37,740 --> 00:03:39,690
!الزمي حدودك أيّتها الشّقيّة الصّغيرة

43
00:03:39,690 --> 00:03:41,860
!ألديك أدنى فكرة عمّا تقولينه؟

44
00:03:41,860 --> 00:03:44,080
—هنالك حدود للتّشرّفات الغبـ

45
00:03:44,730 --> 00:03:45,740
...لقد تلعثم

46
00:03:54,000 --> 00:03:57,160
.يا إلهي، أنا جدّ آسف يا كاغاساكي-سان

47
00:03:57,160 --> 00:03:59,160
.لم أستطع تمالك نفسي

48
00:03:59,160 --> 00:04:01,210
.لقد أفسدتُ ما عليّ قوله

49
00:04:01,210 --> 00:04:02,570
.لا تقلق أيّها الرّئيس

50
00:04:02,570 --> 00:04:03,810
.كان ذلك أكثر من كافٍ

51
00:04:03,810 --> 00:04:06,480
.آسفة لأنّي أقحمتك في هذا

52
00:04:06,480 --> 00:04:08,380
ما-ما الّذي يحدث؟

53
00:04:08,380 --> 00:04:11,850
ماذا؟ إنّك تشهدين على حبّ
.كاغاساكي-سان الأبويّ

54
00:04:12,200 --> 00:04:14,830
.كان كلّ هذا لدفعك لتحمّل المسؤوليّة

55
00:04:14,830 --> 00:04:17,290
.لقد سوّينا كلّ شيء البارحة في الحقيقة

56
00:04:17,290 --> 00:04:18,110
ماذا؟

57
00:04:18,110 --> 00:04:20,770
،بما أنّ هذا كان بيننا وبين تشوكو براوني

58
00:04:20,770 --> 00:04:22,850
.استطعنا تسوية الأمور بشكل ودّيّ

59
00:04:22,850 --> 00:04:25,820
ولكن كان هناك الكثير ممّا كان
.يمكن أن نتشاجر بشأنه

60
00:04:25,820 --> 00:04:28,430
،أردتُك أن تُدركي فداحة الوضع

61
00:04:28,430 --> 00:04:31,220
.لذلك خاطرتُ وطلبتُ منه تأدية دور معيّن

62
00:04:31,650 --> 00:04:34,240
وكيف لي أن أقول لا بعد أن طلبتِ منّي ذلك؟

63
00:04:34,660 --> 00:04:38,960
ناهيك عن ذكر أنّه من واجب
.المسؤول الكبير أن يغضب

64
00:04:38,960 --> 00:04:40,760
!حمدًا على هذا

65
00:04:40,760 --> 00:04:42,290
!كنتُ خائفة جدًّا

66
00:04:42,290 --> 00:04:44,180
!حمدًا على هذا

67
00:04:44,180 --> 00:04:47,230
.آسف لأنّي تصرّفت بعدوانيّة

68
00:04:47,230 --> 00:04:48,910
.لكن لديّ ما أودّ قوله بالفعل

69
00:04:48,910 --> 00:04:52,630
أنا مدين باعتذار لكاغاساكي-سان
،على هذا لأنّها تحاول جعلك تركّزين

70
00:04:52,630 --> 00:04:54,950
.لكن هنالك أمر عليّ إخبارك به

71
00:04:56,550 --> 00:05:02,180
أوتاتاني ياسومي-سان، شكرًا
.لمحاولتك مساعدة يوغوري-سان

72
00:05:02,180 --> 00:05:04,440
ماذا؟ ماذا تقصد؟

73
00:05:04,790 --> 00:05:09,470
.صحيح أنّنا كنّا نخطّط سلفًا لعودة يوغوري-سان

74
00:05:09,950 --> 00:05:12,370
مأساة: تأكيد قيام يوهيمي لخدمات جنسيّة مقابل الأدوار

75
00:05:09,950 --> 00:05:12,370
[يوغوري يوهي] [الجنديّ الآلي الطّيفيّ فانتوم] [خدمات جنسيّة]

76
00:05:09,950 --> 00:05:12,370
(682) تعليقات

77
00:05:09,950 --> 00:05:12,370
مجهول بلا صوت
مأساة] خبر مؤكّد: مؤدّية الأصوات يوغوري يوهي، الّتي حصلت بشكل غير متوقّع]
على الدّور الرّئيسيّ لساكورابا في "الجنديّ الآليّ الطّيفيّ فانتوم" كان مقابل خدمات جنسيّة هههه

78
00:05:10,280 --> 00:05:14,450
.ولكن بصراحة، كنتُ قد استسلمت سلفًا

79
00:05:12,370 --> 00:05:14,460
فارس يوغوري

80
00:05:12,370 --> 00:05:14,460
مأساة] تنبيه بمسألة الخدمات الجنسيّة مقابل الأدوار ليوغوري يوهي]

81
00:05:14,740 --> 00:05:20,160
في العادة، لا يقف أيّ شخص كُسرت
.روحه بتلك الطّريقة على قدميه ثانية

82
00:05:20,470 --> 00:05:24,690
وأنت هي سبب وقوف يوغوري-سان
.على قدميها ثانية

83
00:05:25,940 --> 00:05:30,180
لأنّك مددت يدك إليها رغم
،أنّ ذلك تطلّب التّضحية بنفسك

84
00:05:30,690 --> 00:05:33,440
استطاعت يوغوري يوهي الوقوف
.على قدميها ثانية

85
00:05:33,740 --> 00:05:35,750
.أنا أشكرك من كلّ قلبي

86
00:05:37,760 --> 00:05:41,340
كاغاساكي-سان، علينا الخروج
.جميعًا لتناول شيء ما لاحقًا

87
00:05:41,340 --> 00:05:42,440
!بكلّ تأكيد

88
00:05:42,440 --> 00:05:44,340
.خذنا إلى مكان لطيف

89
00:05:44,340 --> 00:05:45,820
!سيّدي

90
00:05:45,820 --> 00:05:48,480
هل انتهى اجتماعك؟

91
00:05:48,480 --> 00:05:50,140
!كاغاساكي-سان

92
00:05:50,140 --> 00:05:51,270
—لم أرك منذ مدّة

93
00:05:51,270 --> 00:05:53,400
!كلاّ، بل رأينا بعضنا البارحة

94
00:05:53,400 --> 00:05:55,150
.أرى أنّك تعملين بجدّ كالعادة

95
00:05:55,150 --> 00:05:56,900
!هذه أوتاتاني-سان

96
00:05:56,900 --> 00:05:59,470
هذا أوّل لقاء بيننا، صحيح؟

97
00:06:02,510 --> 00:06:03,450
.تفضّلي

98
00:06:03,450 --> 00:06:05,630
!شكرًا لك

99
00:06:05,960 --> 00:06:12,150
أنا هي مديرة أعمال يوغوري يوهي
!واسمي ناروسي شوري

100
00:06:12,150 --> 00:06:13,880
.سـ-سررت بلقائك

101
00:06:13,880 --> 00:06:16,940
!شكرًا جزيلاً على ما فعلتِه

102
00:06:17,210 --> 00:06:21,680
لا أدري حتّى ما كان ليحدث مع
!يوهي-تشان لو لم تكوني إلى جانبها

103
00:06:21,680 --> 00:06:26,110
!أنا حقًّا، حقًّا شاكرة لك

104
00:06:27,330 --> 00:06:30,450
...بدت مشوّشة بالتّأكيد

105
00:06:30,450 --> 00:06:33,310
هل بإمكانها فعلاً القيام بعملها كمديرة؟

106
00:06:33,310 --> 00:06:34,650
.لا تتصرّفي بغباء

107
00:06:34,650 --> 00:06:36,530
.تلك المرأة بارعة

108
00:06:36,530 --> 00:06:41,200
.استطاعت يوغوري أن تتألّق بفضلها

109
00:06:41,200 --> 00:06:43,330
.إنّها تدير أعمال فتيات محبوبات أخريات أيضًا

110
00:06:44,030 --> 00:06:46,510
...ظننتُ أنّها جديدة هنا

111
00:06:46,510 --> 00:06:49,100
.إنّها أكبر سنًّا منّي

112
00:06:49,100 --> 00:06:50,250
!تكذبين

113
00:06:50,250 --> 00:06:51,420
.بل هي الحقيقة

114
00:06:54,050 --> 00:06:56,090
...أخبريني يا كاغاساكي-سان

115
00:06:56,090 --> 00:06:57,880
كيف تشعرين بالفعل؟

116
00:06:57,880 --> 00:06:59,420
هل كان كلّ ذلك مجرّد عرض؟

117
00:06:59,420 --> 00:07:01,650
أم أنّك غاضبة بالفعل؟

118
00:07:01,650 --> 00:07:03,060
ماذا؟

119
00:07:03,060 --> 00:07:04,960
.بل أنا أستشيط غضبًا

120
00:07:04,960 --> 00:07:06,410
...ويحي

121
00:07:06,410 --> 00:07:08,240
،من وجهة نظري كمديرة أعمال

122
00:07:08,240 --> 00:07:11,140
فأنا لا أهتمّ أبدًا بشأن المواهب
.من وكالات أخرى

123
00:07:11,140 --> 00:07:14,280
تمنّيتُ لو تستطيعين أن تقلقي
.حيال نفسك فقط

124
00:07:14,850 --> 00:07:15,900
...ولكن

125
00:07:16,610 --> 00:07:21,170
ولكن كرينغو-تشان العاديّة
،والأكبر سنًّا وغير الإداريّة

126
00:07:21,170 --> 00:07:24,450
.فأنا أجد ما فعلتِه أمرًا مذهلاً للغاية

127
00:07:25,060 --> 00:07:30,000
إنّ تلقّي ضربة كهذه لمساعدة الآخرين
.لا يستطيع أيّ كان القيام به

128
00:07:31,170 --> 00:07:32,280
.أبليتِ حسنًا

129
00:07:33,010 --> 00:07:34,780
...كاغاساكي-سان

130
00:07:35,430 --> 00:07:39,560
إنّ التّصرّف بلطف بعد معاملةٍ لئيمة
.هو ما يفعله الحبيب التّعسّفيّ

131
00:07:39,560 --> 00:07:41,480
!كيف تجرئين؟

132
00:07:41,480 --> 00:07:42,280
!يا إلهي

133
00:07:42,280 --> 00:07:43,920
كاغاساكي-سان؟

134
00:07:45,060 --> 00:07:46,840
!إنّها ميكورون

135
00:07:48,180 --> 00:07:52,670
معبودةُ الجماهيرِ مؤدّيةُ الأصواتِ المغنّية
!والرّاقصة الّتي بدأت مع أوتومي-نيسان

136
00:07:52,670 --> 00:07:55,520
.لم أتوقّع أن أقابلك هنا

137
00:07:55,520 --> 00:07:58,870
نسيت أنّك تعملين في بلو كلاون
.أيضًا يا يوبيساكي-سان

138
00:07:58,870 --> 00:08:02,990
أنت هي أوتاتامي ياسومي-سان، صحيح؟

139
00:08:02,990 --> 00:08:05,280
.نعم! سررت بلقائك

140
00:08:05,280 --> 00:08:07,830
.أنا أوتاتامي ياسومي من تشوكو براوني

141
00:08:08,160 --> 00:08:09,700
.تشرّفت بالتّعرّف إليك

142
00:08:09,700 --> 00:08:12,750
.أنا يوبيساكي ميكورو من بلو كراون

143
00:08:12,750 --> 00:08:15,170
أعتقد أنّك هنا بخصوص مسألة يوغوري، صحيح؟

144
00:08:15,170 --> 00:08:18,630
.أردتُ شكرك على ذلك

145
00:08:18,910 --> 00:08:22,000
...أنا ممتنّة لك بشدّة يا أوتاتاني-سان

146
00:08:23,650 --> 00:08:28,480
.لأنّك سحبتِ نجمتنا الصّغيرة السّخيفة للجحيم

147
00:08:29,440 --> 00:08:31,610
اتّهامات خدمات جنسيّة؟

148
00:08:31,610 --> 00:08:36,150
إنّه بالفعل أسوأ خطأ قد تقترفه
.معبودة جماهير مؤدّية للأصوات

149
00:08:36,150 --> 00:08:37,820
.يا للتّهوّر

150
00:08:37,820 --> 00:08:39,560
.واضح تمامًا أنّها ليست جادّة حيال عملها

151
00:08:39,560 --> 00:08:41,710
.كان ذلك فظيعًا بكلّ تأكيد

152
00:08:42,180 --> 00:08:45,240
.وتستّر الوكالة عليها أكثر سوءًا من ذلك

153
00:08:45,240 --> 00:08:48,480
.في العادة، كان ذلك الإخفاق لينتهي بالطّرد

154
00:08:49,090 --> 00:08:53,260
لكن عندما أفكّر في التّأثير السّيّئ
الّذي سيقوم به شخص مثلها

155
00:08:53,260 --> 00:08:59,050
يميل إلى إفساد الأمور، عند عودتها كأنّ
.شيئًا لم يكن، أشعر برغبة في التّدخّل

156
00:08:59,380 --> 00:09:03,210
،بعد أن كشفتِ كلّ شيء عنها

157
00:09:03,210 --> 00:09:07,180
فإنّ معبودة الجماهير مؤدّية الأصوات
.يوغوري يوهي بمثابة الميتة الآن

158
00:09:07,440 --> 00:09:12,830
شكرًا لإصدارك عقوبة مناسبة
.على تلك الفتاة الغبيّة

159
00:09:13,500 --> 00:09:17,480
.يوبيساكي-سان، ما حدث لها كان حادثًا مؤسفًا

160
00:09:18,860 --> 00:09:23,130
إنّ التّفكير في الأمر بتلك الطّريقة هو ما
.يجعلك مؤدّية أصوات من الدّرجة الثّالثة

161
00:09:23,130 --> 00:09:25,990
،إن كنت تريدين عقد صداقات
.افعلي ذلك في مكان آخر

162
00:09:27,450 --> 00:09:30,810
لماذا تتصرّفين هكذا؟

163
00:09:30,810 --> 00:09:32,130
.لا يتعلّق الأمر بك

164
00:09:32,130 --> 00:09:34,340
.بالطّبع إنّه يتعلّق بي

165
00:09:34,830 --> 00:09:37,340
،لأنّكما أعلنتما بكلّ وقاحة

166
00:09:37,340 --> 00:09:39,420
"!مؤدّيات الأصوات مختلفات في الحياة الحقيقيّة"

167
00:09:39,420 --> 00:09:44,690
وها قد نُقش في ذهن المعجبين في كلّ مكان

168
00:09:44,690 --> 00:09:47,400
أنّ مؤدّيات الأصوات المفضّلات
.لديهم قد يكنّ مزيّفات أيضًا

169
00:09:48,990 --> 00:09:52,890
في كلّ مرّة تقول فيها مؤدّية أصوات
.شيئًا ظريفًا، سيشكّ فيها النّاس

170
00:09:52,890 --> 00:09:56,060
حتّى إن كانت تتكلّم من أعماق
،قلبها أو ربّما بحكم العادة

171
00:09:56,060 --> 00:09:58,310
.فلن يأخذ أحد أيّ شيء على محمل الجدّ الآن

172
00:09:58,690 --> 00:10:00,130
تعتقدين أنّ ذلك لا يتعلّق بي؟

173
00:10:00,130 --> 00:10:01,730
كيف تجرئين على قول ذلك؟

174
00:10:02,040 --> 00:10:05,450
.يوبيساكي-سان، لننهِ هذا الحديث هنا رجاءً

175
00:10:05,800 --> 00:10:08,680
.لا أستطيع السّماح لك بالتّنمّر لها أكثر

176
00:10:08,680 --> 00:10:12,530
.وصف ذلك بالتّنمّر هو تنمّر لي أنا

177
00:10:12,530 --> 00:10:17,860
ولكن لأنّني أودّ مواصلة العمل
،معك في المستقبل

178
00:10:17,860 --> 00:10:20,270
!فلنظلّ على اتّصال يا كاغاساكي-سان

179
00:10:20,790 --> 00:10:21,990
!إلى اللّقاء

180
00:10:24,470 --> 00:10:26,280
!ما كان ذلك؟

181
00:10:26,280 --> 00:10:28,300
!لم يكن عليها أن تكون لئيمة هكذا

182
00:10:28,300 --> 00:10:31,530
!مع أنّها ربّما تكون محقّة

183
00:10:31,530 --> 00:10:33,020
.معك حقّ

184
00:10:33,020 --> 00:10:34,940
.كانت قاسية نوعًا ما بشأن الأمر

185
00:10:34,940 --> 00:10:36,500
!نوعًا ما؟

186
00:10:36,500 --> 00:10:39,560
!ولكن لماذا أنت في مزاج جيّد؟

187
00:10:39,560 --> 00:10:42,400
من المضحك نوعًا ما أن ينتهي الأمر بيوبيساكي

188
00:10:42,400 --> 00:10:45,650
بقول كلّ ما كنت أفكّر
.في أنّه يجب عليّ توضيحه لك

189
00:10:46,910 --> 00:10:49,850
أي أنّك تتّفقين معها؟

190
00:10:49,850 --> 00:10:53,630
.أنا أفهم، لكنّ ذلك أغضبني في كلّ الأحوال

191
00:10:53,630 --> 00:10:55,900
...ولكن يا يوميكو

192
00:10:55,900 --> 00:10:57,640
،أعلم أنّك لا تريدين سماع هذا

193
00:10:57,640 --> 00:11:00,750
ولكن عليك على الأغلب
.أن تحذين حذو يوبيساكي

194
00:11:00,750 --> 00:11:01,770
!ماذا؟

195
00:11:04,880 --> 00:11:07,210
!يا رفاق، لنبدأ

196
00:11:04,890 --> 00:11:12,600
دوّامة خيل يوبيساكي ميكورو الحلقة 212

197
00:11:07,210 --> 00:11:10,320
!حان الوقت لدوامة خيل يوبيساكي ميكورو

198
00:11:10,320 --> 00:11:12,600
.لدينا ضيفة اليوم

199
00:11:12,920 --> 00:11:14,280
!مرحبًا

200
00:11:14,280 --> 00:11:16,230
.أنا ساكوراناميكي أوتومي

201
00:11:16,230 --> 00:11:19,310
!أوتومي-تشان! سرّني جدًّا تواجدك معنا

202
00:11:16,230 --> 00:11:27,870
دوّامة خيل يوبيساكي ميكورو الحلقة 212

203
00:11:19,310 --> 00:11:22,010
،لم تحضري اليوم لأنّ لديك إعلانًا

204
00:11:22,010 --> 00:11:24,890
بل حضرت فقط لأنّك أردت رؤيتي، صحيح؟

205
00:11:24,890 --> 00:11:26,390
.لا، بل لديّ إعلان

206
00:11:26,390 --> 00:11:27,870
!ماذا؟ فعلاً؟

207
00:11:27,870 --> 00:11:29,860
أتمانعين إن تشاركتُه الآن؟

208
00:11:28,320 --> 00:11:30,820
كانت افتتاحيّتها جيّدة، صحيح؟

209
00:11:31,350 --> 00:11:36,370
عفوًا، إذًا فأحداث الفيلم تقع بعد
الحلقة الأخيرة من الأنمي، صحيح؟

210
00:11:36,940 --> 00:11:39,280
.تسير المحادثة بخُطى مثاليّة

211
00:11:39,280 --> 00:11:40,900
.والأسئلة جيّدة

212
00:11:40,900 --> 00:11:44,950
إنّ طريقة إدارتها للبرنامج تجعل
.حتّى من لا يُتابع يواكب ما يحدث

213
00:11:45,940 --> 00:11:46,910
.إنّها جيّدة

214
00:11:47,350 --> 00:11:49,300
.أفضل منّي بكثير

215
00:11:49,300 --> 00:11:52,410
كان لدى يوبيساكي-سان ثلاثة
برامج منتظمة طويلة الأمد

216
00:11:52,410 --> 00:11:55,940
.تجاوز كلّ واحد منها 200 حلقة

217
00:11:56,560 --> 00:11:59,900
،إن كان هنالك عرض خاصّ أو حدث ما
.فهناك احتمال كبير أن يتمّ الاتّصال بها

218
00:12:00,190 --> 00:12:02,190
.لإنّها موهوبة في الكلام

219
00:12:02,190 --> 00:12:05,250
يمكنك رؤية ما يجذب الآخرين إليها، صحيح؟

220
00:12:06,870 --> 00:12:10,250
بما أنّك فقدتِ عامل جذبك
،كمعبودة جماهير مؤدّية للأصوات

221
00:12:10,250 --> 00:12:12,200
.عليك إيجاد شيء آخر

222
00:12:12,460 --> 00:12:17,540
وفي تلك النّاحية، على يوبيساكي ميكورو
.أن تكون مرجعًا عظيمًا

223
00:12:17,540 --> 00:12:20,210
...أدرك ذلك، لكن

224
00:12:20,210 --> 00:12:23,770
.يمكنك تعلّم الكثير من برامجها الأخرى أيضًا

225
00:12:23,770 --> 00:12:28,250
على سبيل المثال، "تعلمين أنّنا بدأنا في نفس
!السّنة، صحيح؟" مع ميكورو وهانابي

226
00:12:28,550 --> 00:12:33,060
واضح أنّ الأشخاص الّذين يمتلكون شخصيّة
.جاذبة يتمتّعون بالكثير من السّحر والجاذبيّة

227
00:12:33,340 --> 00:12:37,230
.سيكون ذلك مثاليًّا لـ"إذاعة الثّانويّة" بالطّبع

228
00:12:38,560 --> 00:12:41,490
...أشخاص بشخصيّة جاذبة

229
00:12:47,870 --> 00:12:50,770
مرّت عدّة أسابيع منذ حادثة
.الخدمات الجنسيّة

230
00:12:50,770 --> 00:12:54,950
قاعدة مُستمعي "إذاعة الثّانويّة
.مع يوهي وياسومي" اتّسعت كثيرًا

231
00:12:55,320 --> 00:12:59,360
بعد أن تخلّينا عن الشّخصيّات الّتي
.كنّا نؤدّيها، ازدادت شعبيّة أحاديثنا

232
00:12:59,930 --> 00:13:04,030
.لكن لم يسر كلّ شيء بسلاسة دائمًا

233
00:13:05,200 --> 00:13:08,510
كان ردّ الفعل عنيفًا جدًّا ضدّ الفتّى
.الّذي عرض فصلنا الدّراسيّ في بثّ مباشر

234
00:13:08,970 --> 00:13:14,080
،تمّ تسريب اسمه وعنوانه
.وانتهى به الأمر بترك مدرستنا

235
00:13:14,080 --> 00:13:16,300
...كان ذلك مريحًا، لكن

236
00:13:16,820 --> 00:13:19,890
،بما أن مدرستنا صارت معروفة للعلن الآن

237
00:13:20,320 --> 00:13:22,870
.بدأت تجلب لها الكثير من النّاس

238
00:13:23,580 --> 00:13:25,000
!يوميكو

239
00:13:25,000 --> 00:13:27,990
.يبدو أنّهم قاموا بإصلاح طريق هروبنا السّرّيّ

240
00:13:27,990 --> 00:13:30,430
.نعم، سمعتُ بذلك

241
00:13:30,430 --> 00:13:33,540
سمعتُ أنّ هنالك العديد
.من النّاس عند بوّابة المدرسة

242
00:13:33,540 --> 00:13:34,570
ما الّذي ستفعلينه؟

243
00:13:34,570 --> 00:13:35,640
.لا داعي للقلق

244
00:13:35,640 --> 00:13:37,560
.لديّ خطّة سرّيّة جاهزة لهذا

245
00:13:37,560 --> 00:13:39,140
.شكرًا يا واكانا

246
00:13:39,140 --> 00:13:40,500
لديك عمل اليوم، صحيح؟

247
00:13:40,500 --> 00:13:41,400
.يمكنك الذّهاب

248
00:13:41,400 --> 00:13:43,690
.حسنًا. مفهوم

249
00:13:43,690 --> 00:13:44,700
.إلى اللّقاء

250
00:13:46,010 --> 00:13:47,940
ما هذه الخطّة السّرّيّة؟

251
00:13:52,050 --> 00:13:53,550
...حسنًا

252
00:13:58,590 --> 00:14:00,230
ما رأيك؟

253
00:14:00,700 --> 00:14:03,390
.تبدين مثل تلميذة مجتهدة جدًّا

254
00:14:03,390 --> 00:14:04,860
.كأنّك شخص مختلف تمامًا

255
00:14:04,860 --> 00:14:06,410
فعلاً؟

256
00:14:06,410 --> 00:14:10,650
يمكنك أن تنجحي بهذا فقط
.بسبب مظهرك الاعتياديّ

257
00:14:10,650 --> 00:14:12,820
.ربّما عليّ أن أجرّب تنكّرًا ما أيضًا

258
00:14:13,720 --> 00:14:15,890
ما رأيك أن تتركي ذلك لي؟

259
00:14:15,890 --> 00:14:18,630
.سأقوم بشيء لن يخطر على بالهم أبدًا

260
00:14:19,350 --> 00:14:21,660
.لا تتصرّفين بهذا الكرم في العادة

261
00:14:21,660 --> 00:14:23,200
ماذا يحدث؟

262
00:14:23,620 --> 00:14:27,380
لطالما أردتُ وضع مكياج
!على وجه يوغوري يوهي الجميل

263
00:14:27,380 --> 00:14:29,510
...لكنّي لا أستطيع قول ذلك

264
00:14:29,510 --> 00:14:33,130
لـ-لن أشعر بارتياح إن كنتُ
.الوحيدة القادرة على المغادرة

265
00:14:33,780 --> 00:14:34,970
.فهمت

266
00:14:34,970 --> 00:14:37,010
.إذًا أمنحك الإذن بذلك

267
00:14:40,650 --> 00:14:44,430
.لا تشوبُ وجهُها أيّ شائبة
...ولكنّ كلّ شيء آخر

268
00:14:45,420 --> 00:14:48,020
كيف العمل هذه الأيّام؟

269
00:14:48,020 --> 00:14:49,520
هل هنالك أيّ اختلاف؟

270
00:14:50,720 --> 00:14:53,590
.في الحقيقة، أنا متفاجئة من حجم الاختلاف

271
00:14:53,590 --> 00:14:56,290
.أحصل على عروض أقلّ الآن

272
00:14:56,590 --> 00:14:59,410
وطبعًا قلّت عروض العمل
،كمعبودة جماهير مؤدّية للأصوات

273
00:14:59,410 --> 00:15:01,570
.وعروض الأنمي والألعاب قلّت أيضًا

274
00:15:02,030 --> 00:15:05,490
كما طُردتُ من الكثير من المشاريع
.الّتي لم يُعلن عنها بعد

275
00:15:06,960 --> 00:15:08,410
ماذا عن "فانتوم"؟

276
00:15:08,410 --> 00:15:10,180
.ما زال ذلك العرض قائمًا

277
00:15:10,180 --> 00:15:14,450
.بل أظنّ أنّ استبدالي سيزيد الطّين بلّة فحسب

278
00:15:17,910 --> 00:15:21,760
لطالما كانت لديّ شكوك بخصوص
.جانب العمل كمعبودة جماهير

279
00:15:21,760 --> 00:15:25,160
أردتُ أن أركّز على أعمال
،تركّز أكثر على صوتي فحسب

280
00:15:25,160 --> 00:15:30,370
لكنّ هذا أجبرني على إدراك كم
.ساعدني عملي كمعبودة جماهير

281
00:15:32,120 --> 00:15:33,190
ساتو؟

282
00:15:33,190 --> 00:15:34,170
!آسفة

283
00:15:34,170 --> 00:15:35,100
.لقد انتهيت

284
00:15:35,100 --> 00:15:37,650
.ناوليني المرآة لأرى النّتيجة

285
00:15:37,650 --> 00:15:38,990
.تمهّلي

286
00:15:38,990 --> 00:15:40,900
.واتانابي، قفي

287
00:15:44,750 --> 00:15:48,950
تعرفين أنّ التّحرّش الجنسي بين
نفس الجنس ممكن أيضًا، صحيح؟

288
00:15:48,950 --> 00:15:50,840
.قفي بلا حراك فحسب

289
00:15:50,840 --> 00:15:53,480
.لا بأس. افعلي ما يحلو لك

290
00:15:56,410 --> 00:15:58,310
ماذا؟ ما هذا؟

291
00:15:58,310 --> 00:16:02,310
.أستطيع الشّعور بصدرك على ظهري

292
00:16:02,580 --> 00:16:03,850
.إنّه ناعم

293
00:16:03,850 --> 00:16:04,750
.مذهل

294
00:16:04,750 --> 00:16:10,200
اسمعي يا فتاة، تعلمين أنّ التّحرّش الجنسي
بين نفس الجنس ممكن أيضًا، صحيح؟

295
00:16:12,190 --> 00:16:14,400
...إنّك لا تتهاونين أبدًا بالفعل

296
00:16:15,030 --> 00:16:17,040
.اللّمسة الأخيرة

297
00:16:17,370 --> 00:16:19,710
!ونكون قد انتهينا

298
00:16:21,450 --> 00:16:23,410
!يا للظّرافة! يا للظّرافة

299
00:16:26,170 --> 00:16:27,470
.هذا هو الأسوأ

300
00:16:27,470 --> 00:16:29,610
.أبدو غير متحضّرة مثلما تبدين في العادة

301
00:16:29,610 --> 00:16:31,030
هل صرتُ أغبى؟

302
00:16:31,030 --> 00:16:33,800
!وكأنّ بإمكان المكياج فعل ذلك

303
00:16:33,800 --> 00:16:36,120
ولكن هل يمكننا هذا بالفعل؟

304
00:16:36,120 --> 00:16:38,860
.أبدو وكأنّني فقدت عقلي فحسب

305
00:16:38,860 --> 00:16:40,500
.لا بأس، لا بأس

306
00:16:51,170 --> 00:16:52,140
...انظر

307
00:16:52,140 --> 00:16:54,740
تلك الشّبيهة بالغيارو تبدو ظريفة، صحيح؟

308
00:16:54,740 --> 00:16:57,370
.أعجبتني الفتاة المجتهدة الّتي إلى جانبها أكثر

309
00:17:06,000 --> 00:17:08,140
أرأيت؟ ألم أقل لك؟

310
00:17:08,140 --> 00:17:09,420
.كنتِ محقّة

311
00:17:11,450 --> 00:17:12,680
مرحبًا؟

312
00:17:12,680 --> 00:17:13,750
كاغاساكي-سان؟

313
00:17:13,750 --> 00:17:16,070
نعم يا ناروسي-سان؟

314
00:17:18,980 --> 00:17:21,550
هل تشربين الكحول يا ناروسي-سان؟

315
00:17:21,550 --> 00:17:23,730
.أحبّ الشّرب

316
00:17:23,730 --> 00:17:27,060
.لكنّي أحبّ الخفيفة منها، مثل المزيج الحامض

317
00:17:27,380 --> 00:17:31,320
.أعتقد أنّك تفضّلين المشروبات الأكثر نضجًا

318
00:17:31,320 --> 00:17:34,350
.ربّما علينا الخروج للشّرب أحيانًا

319
00:17:34,350 --> 00:17:35,950
.أعرف مكانًا جيّدًا

320
00:17:35,210 --> 00:17:39,630
مهلاً. كاغاساكي-سان، هل تقومين
بإغراء امرأة من وكالة أخرى؟

321
00:17:39,630 --> 00:17:40,710
يوميكو؟

322
00:17:41,200 --> 00:17:42,630
أهذا تنكّر؟

323
00:17:42,630 --> 00:17:43,790
.إنّه ممتاز

324
00:17:43,790 --> 00:17:47,700
،إنّه ليس تنكّرًا جيّدًا فحسب
.لكنّه ظريف أيضًا

325
00:17:47,700 --> 00:17:48,830
.إنّه يناسبك

326
00:17:49,570 --> 00:17:51,760
ما الّذي يحدث يا يوهي-تشان؟

327
00:17:51,760 --> 00:17:53,070
!تبدين ظريفة

328
00:17:55,650 --> 00:17:58,550
ما الغاية من هذا الاجتماع إذًا؟

329
00:17:58,840 --> 00:18:00,450
.إنّنا نناقش بعض الاستراتيجيّات

330
00:18:00,450 --> 00:18:03,750
،إنّ بلو كراون منافسة لنا في العادة

331
00:18:03,750 --> 00:18:06,850
.ولكنّنا الآن قرّرنا أن نوحّد صفوفنا

332
00:18:06,850 --> 00:18:10,110
.تلقّت يوغوري ضربة قويّة

333
00:18:10,110 --> 00:18:13,540
كنتُ أفكّر في طرق لقلب
هذا الانخفاض الحاليّ

334
00:18:13,540 --> 00:18:17,980
.في سمعتها عندما اتّصلت بي كاغاساكي-سان

335
00:18:18,290 --> 00:18:21,490
.كما أنّ أوتاتاني في نفس الوضع أيضًا تقريبًا

336
00:18:21,490 --> 00:18:24,810
لذلك كنّا نحاول اكتشاف كيف
.يمكنكما التّعاون معًا

337
00:18:24,810 --> 00:18:27,730
التّعاون؟ نحن الاثنتان؟

338
00:18:27,730 --> 00:18:29,880
ألا يعني ذلك دفعنا إلى هلاك مشترك؟

339
00:18:29,880 --> 00:18:33,740
.مهلاً! إنّ جدلك أنت هو ما جرفني معك

340
00:18:33,740 --> 00:18:37,500
.أنت من قرّر القفز إلى النّيران بملء إرادتك

341
00:18:37,870 --> 00:18:40,120
مهلاً، مهلاً، انظري لنفسك وأنت
!تقولين كلامًا كبيرًا

342
00:18:40,120 --> 00:18:45,640
،لا تنسي من كانت تبكي قائلة
"!سأترك تأدية الأصوات"

343
00:18:45,640 --> 00:18:46,670
.ها هو ذا

344
00:18:46,670 --> 00:18:49,350
!أكره بشدّة هذا الجانب منك

345
00:18:49,350 --> 00:18:53,430
نحن بحاجة لتعملا معًا
.إن كنّا نريد لهذا أن ينجح

346
00:18:53,430 --> 00:18:58,650
.لديكما حليف في صفّكما حتّى وسط كلّ هذا

347
00:18:59,490 --> 00:19:00,990
أفهمتما قصدي؟

348
00:19:00,990 --> 00:19:02,360
.إنّه البرنامج الإذاعيّ

349
00:19:02,360 --> 00:19:05,480
إنّ أحاديثكما لها شعبيّة كبيرة
،لأنّكما تتكلّمان بشكل مباشر

350
00:19:05,480 --> 00:19:08,490
كما أنّ أسلوبكما الجديد يكسبكما
.شعبيّة أكثر فأكثر

351
00:19:08,790 --> 00:19:11,510
.إنّهم بدؤوا يقبلون بكما، وسنركب نحن تلك الموجة

352
00:19:12,160 --> 00:19:15,280
.أوتاتاني ياسومي كغيارو اجتماعيّة

353
00:19:15,280 --> 00:19:17,870
.ويوغوري يوهي كفتاة متحفّظة

354
00:19:17,870 --> 00:19:19,460
.سنقوم بالتّسويق لكما هكذا

355
00:19:19,460 --> 00:19:22,020
سنجعل النّاس ينسون شخصيّتاكما السّابقة

356
00:19:22,020 --> 00:19:24,820
.ويعيدون الاعتراف بكما كما أنتما

357
00:19:24,820 --> 00:19:26,660
.مهلاً رجاءً

358
00:19:26,660 --> 00:19:29,320
هل هذا يعني أنّكما تريدان منّا
إنشاء شخصيّات جديدة بالكامل؟

359
00:19:29,320 --> 00:19:32,120
،إن كان الأمر كذلك
ألن نواجه نفس المشكلة ثانية؟

360
00:19:32,120 --> 00:19:34,810
،ولكن أوتاتاني-سان غيارو بالفعل

361
00:19:34,810 --> 00:19:38,110
وأنت يا يوهي-تشان فتاة حسنة
التّصرّف بكلّ تأكيد، صحيح؟

362
00:19:38,110 --> 00:19:42,100
هناك الكثير من مؤدّي الأصوات
.الّذين يعملون بشخصيّاتهم الحقيقيّ

363
00:19:42,100 --> 00:19:44,710
.هذه هي الزّاوية الّتي نودّ العمل منها

364
00:19:44,710 --> 00:19:48,720
وهكذا، يمكنكما الحديث بشأن
.ما تحبّانه بقدر ما تشاءان

365
00:19:48,720 --> 00:19:51,110
."مثل "الغوندولا الحديديّ

366
00:19:51,110 --> 00:19:54,290
وربّما مثل الأصوات الصّاخبة
الّتي يصدرها الرّوبوتات عندما تتحرّك؟

367
00:19:54,290 --> 00:19:56,790
.إنّه ليس "غوندولا"، بل غولدرا

368
00:19:56,790 --> 00:19:59,430
وربّما أكون قد ذكرتُ كم
،أنّ تلك الأصوات رائعة

369
00:19:59,430 --> 00:20:02,550
لكنّ ذلك ليس الشّيء الوحيد
.الّذي يجعله مذهلاً

370
00:20:01,050 --> 00:20:04,540
ما الّذي يفترض بنا فعله بالضّبط؟

371
00:20:04,540 --> 00:20:10,140
استعملنا أنا وناروسي-سان علاقاتنا للحصول
.على عدّة ضيوف في فقرة الضّيوف في البرنامج

372
00:20:04,550 --> 00:20:10,140
الخميس 21
لقاء ترينيتي في 10 صباحًا
الجمعة 22
مُشاهد الأنمي نسخة نوفمبر/تشرين الثّاني
مراجعة النّص
اجتماع داخليّ في 10 صباحًا

373
00:20:04,550 --> 00:20:10,140
جدول سبتمبر/أيلول

374
00:20:10,430 --> 00:20:15,600
سنظهر أكثر من المعتاد ونجعل المستمعين
.يعتادون على شخصيّتاكما الجديدتين

375
00:20:15,600 --> 00:20:17,720
.وبعد ذلك، سنقوم باحتفاليّات

376
00:20:18,070 --> 00:20:21,570
،سأتشارك معك الجدول لاحقًا
.لذلك كوني بانتظاره

377
00:20:21,570 --> 00:20:23,030
—على أيّ حال، مواجهة المعجبين ستكون

378
00:20:23,030 --> 00:20:24,890
!مـ-مهلاً لحظة

379
00:20:24,890 --> 00:20:28,770
إنّ معجبينا يكرهوننا أنا وواتانابي
."لأنّنا "خدعناهم

380
00:20:28,770 --> 00:20:31,710
.إن خرجنا للعلن الآن، فسيزيد ذلك الطّين بلّة

381
00:20:31,710 --> 00:20:36,790
،إضافة لذلك، حتّى إن أقمنا احتفاليّات
.فلن يحضرها أيّ أحد

382
00:20:36,790 --> 00:20:39,780
.وهنا يحين دوري

383
00:20:41,060 --> 00:20:42,750
!أوتومي-نيسان

384
00:20:42,750 --> 00:20:46,640
.آسفات على الاتّصال بك وأنت مشغولة

385
00:20:46,640 --> 00:20:47,740
!لا مشكلة

386
00:20:47,740 --> 00:20:50,300
.سأفعل أيّ شيء لزميلتَيّ الصّغيرتين

387
00:20:50,300 --> 00:20:52,770
!إنّ شكلكما الجديد رائع

388
00:20:52,770 --> 00:20:54,110
!تبدوان ظريفتين

389
00:20:54,110 --> 00:20:55,350
...عفوًا

390
00:20:55,810 --> 00:21:00,060
من الآن فصاعدًا، سنعتمد
."كثيرًا على فرقة "تارت القلب

391
00:21:00,670 --> 00:21:04,210
لحسن الحظّ أنّ إطلاق أغنيتكنّ
.الفرديّة الثّانية وشيك

392
00:21:04,580 --> 00:21:09,460
كلّ قلقكما حيال الاحتفاليّات سيُحلّ
.بوجود ساكوراناميكي-سان هناك

393
00:21:09,460 --> 00:21:13,040
.لا يحبّ أحد أن يكرهه شخص يحبّونه

394
00:21:13,040 --> 00:21:14,710
،بوجود ساكوراناميكي هناك

395
00:21:15,100 --> 00:21:19,100
أشكّ بشدّة أنّ يقوم أيّ أحد
.بإظهار كرهه لكما

396
00:21:19,100 --> 00:21:21,660
.إنّك تمدحينني أكثر ممّا أستحقّ

397
00:21:21,660 --> 00:21:23,580
.هذا هو ما سنقوم به

398
00:21:23,580 --> 00:21:26,570
سنُجري برنامجًا حواريًّا قبل إطلاق
.الأغنية واحتفاليّة إطلاق خاصّة

399
00:21:26,570 --> 00:21:30,050
هناك أيضًا بعض البرامج الإذاعيّة
."المستعدّة لاستضافة "تارت القلب

400
00:21:30,050 --> 00:21:32,820
أوتومي-نيسان، هل لديك وقت
من الأساس لهذا؟

401
00:21:32,820 --> 00:21:34,140
.لا داعي للقلق

402
00:21:34,140 --> 00:21:35,730
.هذا لأجلكما قبل كلّ شيء

403
00:21:36,100 --> 00:21:40,220
،بهدف التّقليل من الضّغط على ساكوراناميكي

404
00:21:40,220 --> 00:21:42,520
ستقومان أنتما بحضور معظم
.فقرات البرامج الإذاعيّة

405
00:21:42,520 --> 00:21:44,730
،ستكونان ضيفتان في برامج مختلفة

406
00:21:44,730 --> 00:21:49,070
.لذلك احرصا أن تقرآ عنها كي لا ترتبكا

407
00:21:49,340 --> 00:21:52,450
...سيكون ظهوركما الأوّل في

408
00:21:52,450 --> 00:21:53,740
.هذا البرنامج

409
00:21:54,910 --> 00:21:55,790
!كلاّ

410
00:21:55,790 --> 00:22:00,710
دوّامة خيل يوبيساكي ميكورو

411
00:21:55,790 --> 00:22:00,710
الحلقة 216

412
00:21:56,420 --> 00:21:58,510
.فهمت الآن

413
00:21:58,510 --> 00:22:00,710
!إنّه برنامج ميكورو-تشان

414
00:22:00,710 --> 00:22:03,340
أهذا معقول؟

415
00:23:35,060 --> 00:23:40,050
‫#06 يوهي وياسومي هالكتان بكلّ تأكيد؟

416
00:23:36,490 --> 00:23:39,160
"يوهي وياسومي هالكتان بكلّ تأكيد؟"