1
00:00:00,770 --> 00:00:03,260
!سندور وندور أيّها المستمعون

2
00:00:03,260 --> 00:00:06,170
.دعوني أقدّم لكم ضيوف اليوم

3
00:00:06,170 --> 00:00:07,280
!تفضّلا

4
00:00:07,680 --> 00:00:09,540
!سندور وندور أيّها المستمعون

5
00:00:09,540 --> 00:00:11,520
.مرحبًا. معكم أوتاتاني ياسومي

6
00:00:11,800 --> 00:00:13,820
!سندور وندور أيّها المستمعون

7
00:00:13,820 --> 00:00:15,540
.أنا يوغوري يوهي

8
00:00:15,540 --> 00:00:18,490
!مرحبًا، شكرًا لقدومكما

9
00:00:17,870 --> 00:00:19,280
.مرحبًا

10
00:00:18,490 --> 00:00:21,650
نستضيف اليوم الثّنائيّ المشهور
من البرنامج الإذاعيّ

11
00:00:19,650 --> 00:00:20,960
.شكرًا لك

12
00:00:21,650 --> 00:00:25,040
!إذاعة الثّانويّة مع يوغوري وياسومي

13
00:00:25,040 --> 00:00:29,010
مرحبًا يا أوتاتاني ياسومي-تشان
!ويوغوري يوهي-تشان

14
00:00:29,010 --> 00:00:32,950
.هذه المقدّمة كثيرة جدًّا عليّ

15
00:00:29,760 --> 00:00:33,250
.لا بدّ أنّ ياسومي-تشان تعمل بجدّ

16
00:00:32,950 --> 00:00:34,190
الثّنائيّ المشهور"؟"

17
00:00:33,250 --> 00:00:35,540
.آمل أنّ يشجّعها الجميع

18
00:00:34,190 --> 00:00:37,390
.تصادف أنّنا نرتاد نفس المدرسة فحسب

19
00:00:37,390 --> 00:00:39,480
!الذّهاب لنفس المدرسة مذهل

20
00:00:39,480 --> 00:00:41,010
كيف ذلك؟

21
00:00:56,860 --> 00:01:03,540
الجوانب المتعدّدة
لإذاعة مؤدّي الأصوات

22
00:02:11,480 --> 00:02:15,480
‫#06 يوهي وياسومي هالكتان بكلّ تأكيد؟

23
00:02:11,900 --> 00:02:13,650
.صباح الخير

24
00:02:20,160 --> 00:02:22,860
لم أتوقّع أنّي سأضطرّ لتنظيف فوضاكما

25
00:02:22,860 --> 00:02:25,840
.فقط لأنّك زميلتي في الوكالة

26
00:02:26,120 --> 00:02:29,990
سمعتُ أنّكما ستذهبان لإزعاج
.العديد من البرامج الإذاعيّة أيضًا

27
00:02:29,990 --> 00:02:32,170
هل عرفت ذلك من ناروسي-سان؟

28
00:02:32,170 --> 00:02:35,900
عمّ تتكلّمين؟ إنّكما تتحدّثان عن
.ذلك طوال الوقت في برنامجكما

29
00:02:36,180 --> 00:02:38,640
إنّها تستمع لبرنامجنا؟

30
00:02:39,110 --> 00:02:41,600
،لقد كشفتما عن نفسيكما

31
00:02:41,600 --> 00:02:44,070
لكن إن تجرّأتما على كشفي أنا
،أو أيّ مؤدّية أخرى

32
00:02:44,070 --> 00:02:45,470
.فسأوسعكما ضربًا

33
00:02:45,920 --> 00:02:48,200
.ما كنّا لنفعل ذلك

34
00:02:48,590 --> 00:02:52,070
لماذا تتصرّفين بهذه العدوانيّة معنا؟

35
00:02:52,070 --> 00:02:57,240
لأنّي لا أطيق الأشخاص أمثالكما
.ممّن لا يبذلون كلّ جهدهم في عملهم

36
00:02:57,520 --> 00:03:03,480
ما يغضبني أكثر من غيره
.هو أنّكما تعتقدان أنّكما الضّحيّة هنا

37
00:03:03,480 --> 00:03:05,030
،انسي أمري أنا

38
00:03:05,030 --> 00:03:06,960
.لكنّ يوكي ضحيّة هنا بكلّ تأكيد

39
00:03:06,960 --> 00:03:09,350
.أنتما من قمتما بالأذيّة

40
00:03:09,350 --> 00:03:11,790
.أذيّة معجبيكما على الأقلّ

41
00:03:11,790 --> 00:03:14,820
يجب حماية تخيّلاتهم بشأن حياتكما
.كمعبوداتِ جماهيرَ مؤدّياتِ أصوات

42
00:03:15,080 --> 00:03:19,370
كانت الوكالة لتُبقيك على طريق
.المعبودة مؤدّية الأصوات أيضًا

43
00:03:19,370 --> 00:03:23,820
لكنّنا الآن نرى نتائج ما يحدث عندما
.تختاران الحلول الأسهل بكلّ تهوّر

44
00:03:23,820 --> 00:03:25,310
...ذلك

45
00:03:25,310 --> 00:03:30,440
وفي هذا السّياق، أنت الأكثر
.سذاجة يا أوتاتاني ياسومي

46
00:03:30,810 --> 00:03:33,340
،بذلت يوغوري جهدًا إضافيًّا لحمايتك

47
00:03:33,340 --> 00:03:35,400
.ومع ذلك أراك تقوّضين الأمر على نفسك

48
00:03:35,400 --> 00:03:39,730
،صعّبتِ حياة الكثير من الأشخاص
.فقط لتكوني راضية عن نفسك

49
00:03:39,730 --> 00:03:42,930
.حتّى أنّك جعلت معجبيك ينقلبون عليك

50
00:03:45,820 --> 00:03:48,540
...تركّزين على الافتراضات والشّماتة

51
00:03:48,540 --> 00:03:50,970
.يا له من تصرّف فظّ

52
00:03:50,970 --> 00:03:53,400
غاضبة لأنّي آلمتُك بالحقيقة؟

53
00:03:53,400 --> 00:03:56,320
.لا تظنّي ولو لوهلة أنّ تحديقك بي سيزعزع موقفي

54
00:03:56,660 --> 00:04:00,960
.يا إلهي، تخوضان في النّقاشات الحامية أينما كنتما

55
00:04:00,960 --> 00:04:02,190
!أساكا-تشان؟

56
00:04:02,190 --> 00:04:03,560
لماذا أنت هنا؟

57
00:04:03,560 --> 00:04:06,030
.أنا كاتبة هذا البرنامج

58
00:04:06,420 --> 00:04:09,250
حسنًا، هل نبدأ؟

59
00:04:11,400 --> 00:04:13,070
.لقد انتهينا

60
00:04:13,390 --> 00:04:15,200
!قدّمتم عملاً ممتازًا

61
00:04:15,580 --> 00:04:18,320
يوهي-تشان، هل يمكنني الحصول
على توقيعك على هذه الهدايا؟

62
00:04:16,110 --> 00:04:19,080
!إنّها بارعة جدًّا

63
00:04:18,330 --> 00:04:19,080
.أكيد

64
00:04:19,500 --> 00:04:25,280
حافظت على وتيرة سريعة مع الحرص
.على الضّحك لجعل البرنامج ممتعًا

65
00:04:25,280 --> 00:04:30,020
،كانت الأمور بشعة قبل التّسجيل
.لكن حتّى أنا وجدت نفس أضحك معها

66
00:04:30,020 --> 00:04:33,420
كما أنّ معرفتها واسعة بشأن
.الأداء الصّوتي والمشاريع الفنّيّة

67
00:04:33,780 --> 00:04:35,820
.عفوًا يا يوبيساكي-سان

68
00:04:35,820 --> 00:04:39,280
هل تحفظين كلّ تلك المعلومات عن ضيوفك؟

69
00:04:39,280 --> 00:04:41,990
.اخرسي. لا تُبدي اهتمامك بي

70
00:04:41,990 --> 00:04:44,100
.عرفتِ الكثير عنّا أيضًا

71
00:04:44,100 --> 00:04:46,090
هل يعني هذا أنّك تتبعين مسيرتنا؟

72
00:04:48,420 --> 00:04:49,900
.ربّما

73
00:04:49,900 --> 00:04:54,110
كيف أصير مُحادِثة كالّتي عليها أنت الآن؟

74
00:04:54,110 --> 00:04:55,020
من يدري؟

75
00:04:55,320 --> 00:04:57,640
!حسنًا، سأستأذن بالمغادرة الآن

76
00:04:57,640 --> 00:04:59,150
!يوبيساكي-سان

77
00:04:59,150 --> 00:05:01,410
هل يمكننا الخروج للأكل معًا؟

78
00:05:05,340 --> 00:05:07,900
الخروج للأكل مع شقيّة لا يمكنها حتّى الشّرب بعد؟

79
00:05:07,900 --> 00:05:09,070
.لا بدّ أنّك تمزحين

80
00:05:09,070 --> 00:05:12,500
إذًا إذا كنت كبيرة بما يكفي
للشّرب، كنتِ لتخرجي معي؟

81
00:05:16,430 --> 00:05:20,250
لا أصدّق أنّك قد تطلبين ذلك
.بعد أن مسحت بك الأرض

82
00:05:20,250 --> 00:05:21,210
أتفضّلين مثل تلك الأمور؟

83
00:05:21,640 --> 00:05:23,190
،حتّى إن كنت لا أحبّ شخصًا ما

84
00:05:23,190 --> 00:05:26,060
.فلن أفهمه أبدًا إن لم أحدّثه

85
00:05:26,060 --> 00:05:26,880
...هكذا إذًا

86
00:05:26,880 --> 00:05:30,220
.أساكا-تشان، كان بإمكانك مساعدتي قليلاً

87
00:05:30,220 --> 00:05:31,980
.أنا آسفة

88
00:05:31,980 --> 00:05:34,730
.لا يمكنني إرغامها على أيّ شيء لا تريده

89
00:05:35,750 --> 00:05:38,460
إذًا تعتقدين فعلاً أنّها لم ترغب في ذلك؟

90
00:05:38,460 --> 00:05:40,100
.ذلك كان واضحًا

91
00:05:40,100 --> 00:05:42,830
هل فقدت القدرة على ملاحظة
ما يشعر به الآخرون؟

92
00:05:43,990 --> 00:05:49,330
أشعر أنّ يوبيساكي-سان تضع
.ذلك الحاجز عن قصد

93
00:05:49,330 --> 00:05:51,740
.ذلك ما شعرتُ به

94
00:05:52,500 --> 00:05:56,080
هل تتصرّف يوبيساكي-سان بتلك
الفظاظة مع مؤدّيات أخريات أيضًا؟

95
00:05:56,080 --> 00:05:57,590
.لا، على الإطلاق

96
00:05:57,590 --> 00:06:00,530
.بل إنّها تكون هادئة ومحترفة في العادة

97
00:06:00,820 --> 00:06:04,220
لكنّها ودودة بما يكفي بحيث
.لا يكون ذلك أمرًا سيّئًا

98
00:06:04,490 --> 00:06:07,780
ذلك هو الانطباع الّذي كان لديّ
.عندما التقيتها في الوكالة أيضًا

99
00:06:09,680 --> 00:06:14,390
بعد بضعة أيّام

100
00:06:10,510 --> 00:06:14,390
،بالنّسبة للأنمي الّذي سيبدأ في الخريف
..."تحت السّماء الأرجوانيّة"

101
00:06:14,920 --> 00:06:16,680
!مرحبًا بالجميع

102
00:06:17,080 --> 00:06:21,200
كنتُ قلقة أنّ فضيحة تتعلّق

103
00:06:21,200 --> 00:06:25,400
بعضوتين من الطّاقم الرّئيسيّ
،ستؤثّر سلبًا على العرض

104
00:06:25,400 --> 00:06:30,210
لكنّ طاقم العمل وبقيّة مؤدّي الأصوات
.كانوا جميعًا ودودين ومشجّعين

105
00:06:31,100 --> 00:06:33,120
،استمرّت الأمور بدون أيّ عقبة

106
00:06:32,510 --> 00:06:37,680
.كم أودّ تقديم حلقة أخرى خاصّة أو ما شابه

107
00:06:33,120 --> 00:06:35,530
.وسننهي التّسجيل للحلقة الأخيرة قريبًا

108
00:06:37,680 --> 00:06:38,910
.نعم

109
00:06:38,910 --> 00:06:41,820
.لدينا ساكوراناميكي-سان معنا قبل كلّ شيء

110
00:06:41,820 --> 00:06:43,430
.لا أمانع ذلك أبدًا

111
00:06:43,430 --> 00:06:47,000
بإمكاننا القيام بحلقة مراجعة خاصّة حيث
.يقوم مؤدّو الأصوات بالحديث أم ما شابه

112
00:06:47,000 --> 00:06:50,470
...لكنّ أوتاتاني-سان ويوغوري-سان

113
00:06:50,470 --> 00:06:51,250
.أنت تعلم

114
00:06:51,530 --> 00:06:56,850
أعلم. لكنّ استعمال ساكوراناميكي-سان
وحدها سيكون واضحًا جدًّا، صحيح؟

115
00:06:56,850 --> 00:07:01,400
قبل كلّ شيء، طلبت منّا
.وكالاتهما استعمالهما بقدر المستطاع

116
00:07:01,400 --> 00:07:05,920
...أريد ذلك، ولكن إن تحدّثنا بشكل واقعيّ

117
00:07:11,980 --> 00:07:14,470
ساتو؟ ما الخطب؟

118
00:07:15,090 --> 00:07:16,190
لماذا؟

119
00:07:16,630 --> 00:07:18,030
لماذا ماذا؟

120
00:07:18,030 --> 00:07:20,070
هل نبدأ؟

121
00:07:20,650 --> 00:07:24,710
.هارو-تشان! أنا أعدّ القهوة
أتريدين كوبًا؟

122
00:07:24,710 --> 00:07:26,590
فعلاً؟

123
00:07:26,590 --> 00:07:27,880
!شكرًا لك

124
00:07:27,880 --> 00:07:29,080
.أريد كوبًا أيضًا

125
00:07:29,390 --> 00:07:30,680
...عرفتُ ذلك

126
00:07:30,680 --> 00:07:33,500
.أداء واتانابي يحبس الأنفاس

127
00:07:33,500 --> 00:07:37,060
.لا فرصة لي أمام يوغوري يوهي بمستواي الحاليّ

128
00:07:37,510 --> 00:07:39,830
.إنّ أداءها جيّد جدًّا

129
00:07:39,830 --> 00:07:42,070
.صوتها جيّد جدًّا

130
00:07:42,070 --> 00:07:46,540
لا أطيقها، ولكن عندما أرخي
.دفاعاتي، أجد نفسي معجبة بها

131
00:07:46,520 --> 00:07:48,570
مأساة: تأكيد قيام يوهيمي لخدمات جنسيّة مقابل الأدوار

132
00:07:46,900 --> 00:07:48,020
لذلك لماذا...؟

133
00:07:48,020 --> 00:07:52,190
لماذا على شيء غبيّ لهذه الدّرجة
أن يحرمنا من فرص عملنا؟

134
00:07:59,020 --> 00:08:00,170
ياسومي-تشان؟

135
00:08:02,110 --> 00:08:03,360
هل أنت بخير؟

136
00:08:03,360 --> 00:08:04,680
هل حدث أمر ما؟

137
00:08:05,590 --> 00:08:07,630
...لا-لا شيء

138
00:08:08,290 --> 00:08:12,390
.إنّ مسألة الفضيحة بأكملها كانت صعبة

139
00:08:13,610 --> 00:08:17,730
ني-سان، إنّهم يقولون أشياء عنك
على الإنترنيت أيضًا، صحيح؟

140
00:08:17,730 --> 00:08:23,030
يقولون أنّك قد تكونين مثيرة للشّبهات
...لأنّك في مجموعة معنا

141
00:08:23,030 --> 00:08:25,320
هل يُقال هذا عنّي بالفعل؟

142
00:08:25,320 --> 00:08:28,180
.لكنّها مجرّد أحاديث على الإنترنيت

143
00:08:28,180 --> 00:08:30,070
.ليس عليك القلق حيال الأمر

144
00:08:31,230 --> 00:08:33,680
،منذ المرّة الأولى الّتي عملنا فيها معًا

145
00:08:33,680 --> 00:08:37,090
،"كنتُ أسعد كثيرًا دائمًا في كلّ مرّة تناديني "ني-سان

146
00:08:37,090 --> 00:08:39,100
.مثلما فعلتِ عندما كنّا نؤدّي الأصوات

147
00:08:39,100 --> 00:08:43,670
،أعتقد أنّه كأخت كبيرة لك
.كزميلة أكبر، فعليّ أن أتحلّى بالقوّة

148
00:08:44,270 --> 00:08:47,500
.لذلك بإمكانك الحديث معي عن أيّ شيء

149
00:08:47,810 --> 00:08:50,450
.فقبل كلّ شيء، أنا أختك الكبرى

150
00:08:50,450 --> 00:08:52,400
...أوتومي-نيسان

151
00:08:53,180 --> 00:08:56,430
.وهناك أمر مهمّ آخر

152
00:08:56,430 --> 00:09:01,770
يوجد الكثير من الأشخاص حولك
.يريدون مساعدتك إضافة لي أنا

153
00:09:01,770 --> 00:09:05,180
لكن عليك أن تعلمي أنّه ليس
من الجيّد كبت مشاعرك

154
00:09:05,180 --> 00:09:08,190
.لأنّك قلقة من أن تكوني مصدر إزعاج للآخرين

155
00:09:08,190 --> 00:09:12,160
.عليك أن تعطي الأولويّة لما ترغبين فيه بشدّة

156
00:09:13,800 --> 00:09:17,120
هكذا إذًا. هذا ما قالته ساكوراناميكي-سان؟

157
00:09:17,500 --> 00:09:19,830
،لا أريد ركوب الموجة دون التّفكير مسبقًا

158
00:09:19,830 --> 00:09:21,560
.لكنّي أدرك ما الّذي تعنيه

159
00:09:22,040 --> 00:09:25,330
.شعرتُ أيضًا أنّ هنالك شيئًا ليس في محلّه

160
00:09:25,330 --> 00:09:26,880
حتّى وتانابي؟

161
00:09:27,290 --> 00:09:29,250
على الهواء

162
00:09:27,650 --> 00:09:28,940
...حسنًا

163
00:09:29,250 --> 00:09:30,250
استعداد

164
00:09:30,600 --> 00:09:32,120
...أخبريني يا أساكا-تشان

165
00:09:32,120 --> 00:09:32,540
ماذا؟

166
00:09:32,850 --> 00:09:37,070
هل برنامجنا الإذاعيّ على ما يرام كما هو؟

167
00:09:37,430 --> 00:09:39,590
.أعتقد أنّه بخير

168
00:09:39,590 --> 00:09:42,840
.إنّ تعداد مستمعيكما وصندوق الرّسائل في ارتفاع

169
00:09:42,840 --> 00:09:45,700
على الرّغم من أنّنا نتحدّث على طبيعتنا؟

170
00:09:45,700 --> 00:09:47,660
.لكنّ الأمر ينجح

171
00:09:48,180 --> 00:09:50,370
لماذا تسألين؟

172
00:09:50,940 --> 00:09:54,160
.إنّ الأمر يزعجني منذ مدّة

173
00:09:54,160 --> 00:09:56,850
،تقولين أنّ لبرنامجنا شعبيّة

174
00:09:56,850 --> 00:09:59,080
ولكن أليست بعض تلك الرّسائل سلبيّة؟

175
00:09:59,080 --> 00:10:02,050
.يحصل كلّ برنامج على رسائل سلبيّة

176
00:10:02,050 --> 00:10:05,190
.إنّها مجرّد نقطة في بحر مقارنة ببقيّة الرّسائل

177
00:10:05,190 --> 00:10:07,600
.أريد معرفة المزيد عن تلك النّقطة

178
00:10:07,600 --> 00:10:10,310
.لا أعتقد أنّ عليكما أن تشغلا بالكما بذلك

179
00:10:12,900 --> 00:10:17,210
تعبّر معظمها عن اندهاش المستمعين من
.استمرار هذا بعد ما اعتبروه خداعًا لهم

180
00:10:17,210 --> 00:10:20,060
.أو أنّكما تتظاهران فقط أنّكما لا تحبّان بعضكما

181
00:10:20,060 --> 00:10:22,190
.أو أنّهم أحبّوا البرنامج كما كان سابقًا

182
00:10:22,670 --> 00:10:25,300
هل تريدان فعلاً سماع كلّ ذلك؟

183
00:10:25,300 --> 00:10:26,130
.لا

184
00:10:26,130 --> 00:10:28,030
.آسفتان لجعلك تقولين ذلك

185
00:10:28,310 --> 00:10:29,910
.لا بأس

186
00:10:29,910 --> 00:10:34,180
مع أنّي ظننتُ أنّكما ستسألان عن
.كيفية الاستعداد لدوريكما أو ما شابه

187
00:10:34,180 --> 00:10:36,650
الاستعداد لدورينا؟

188
00:10:36,650 --> 00:10:41,460
لقد تمّ إخباركما أن تركّزا أكثر على
شخصيّتاكما الحقيقيّة، صحيح؟

189
00:10:41,460 --> 00:10:44,540
كنتُ أفكّر أنّه ربّما أثقل ذلك
.كاهلكما أكثر من اللاّزم

190
00:10:44,540 --> 00:10:48,770
،قد يكون الأمر خانقًا بعض الشّيء بالطّبع

191
00:10:48,770 --> 00:10:51,570
.ولكنّنا لا نؤدّي شخصيّات أشخاص آخرين

192
00:10:51,570 --> 00:10:54,920
إضافة لذلك، أليس من السّيّئ
التّفكير بتلك الطّريقة؟

193
00:10:54,920 --> 00:10:56,750
،بغضّ النّظر عن الوضع

194
00:10:56,750 --> 00:11:00,830
ليس من الخطأ أن تفكّرا أنّ لعب
.تلك الشّخصيّة أمر صعب

195
00:11:00,830 --> 00:11:02,410
،من وجهة نظري

196
00:11:02,410 --> 00:11:05,390
.يبدو أنّكما تعانيان وقتًا أصعب من ذي قبل

197
00:11:05,720 --> 00:11:09,300
هناك الكثير من مؤدّي الأصوات الّذين
،يختارون التّصرّف بشخصيّاتهم الحقيقيّة

198
00:11:09,300 --> 00:11:14,780
ولكنّ التّمثيل بشخصيّتك ولكن ليس
.بشكل كامل قد يكون مرهقًا حقًّا

199
00:11:15,170 --> 00:11:20,020
إذًا ما الّذي تفعلينه عندما تواجهين تلك المشكلة؟

200
00:11:20,680 --> 00:11:24,100
إمّا أن تعيشي بذلك الشّعور الخانق لبقيّة حياتك

201
00:11:24,100 --> 00:11:26,660
.أو تتوقّفين عن تأدية تلك الشّخصيّة

202
00:11:33,470 --> 00:11:34,740
ماذا هنالك؟

203
00:11:35,460 --> 00:11:36,720
.إنّها أمّي

204
00:11:37,030 --> 00:11:40,130
.إنّها تنتظر في الوكالة

205
00:11:40,130 --> 00:11:44,140
.تريدني أن أحضر للحديث عن مستقبلي

206
00:12:00,400 --> 00:12:03,640
.ما الّذي تفعلانه هنا؟ هذا لا يعنيكما

207
00:12:03,930 --> 00:12:06,840
،بما أنّي أقدّم برنامجًا إذاعيًّا مع تشيكا-سان

208
00:12:06,840 --> 00:12:09,430
.فأظنّ أنّ الأمر يعنيني بالفعل

209
00:12:09,430 --> 00:12:11,530
.وأنا طلبتُ من أبي أن يأتي

210
00:12:11,530 --> 00:12:13,610
،لا أمانع وجود يوميكو-تشان

211
00:12:13,610 --> 00:12:17,050
.أمّا أنت فلا يحقّ لك قول أيّ شيء
.ستكون عقبة في الطّريق لا غير

212
00:12:17,050 --> 00:12:21,920
.أنا هنا فقط لأنّ تشيكا طلبت منّي التّواجد معها

213
00:12:22,260 --> 00:12:24,470
،حسنًا يا واتانابي-سان

214
00:12:24,470 --> 00:12:26,710
ما الّذي أردت أن نتحدّث بشأنه؟

215
00:12:26,720 --> 00:12:29,350
خبر عاجل] وجدنا أين تعيش يوغوري يوهي]
‫1. المجهول بلا صوت
،تبعتُها بعد المدرسة، ويا إلهي
إنّها شقّة رائعة ههه
‫2. مجهول بلا صوت
ما رقم شقّتها؟
‫3. مجهول بلا صوت
هذه جريمة بمعنى الكلمة

216
00:12:27,150 --> 00:12:29,050
.ألقوا نظرة على هذا

217
00:12:29,600 --> 00:12:34,150
هنالك صورة للمبنى الّذي نعيش
.فيه أنا وتشيكا على الإنترنيت

218
00:12:35,190 --> 00:12:37,520
!هل يعني ذلك أنّهم عرفوا العنوان؟

219
00:12:37,520 --> 00:12:41,890
،نعم. لم يستطيعوا معرفة رقم الشّقّة بالتّحديد

220
00:12:42,440 --> 00:12:45,550
.لكنّ هذا يضع تشيكا في وضع خطير جدًّا

221
00:12:45,550 --> 00:12:47,860
.لن أسمح بهذا أكثر

222
00:12:48,200 --> 00:12:50,320
.أودّ منها أن تترك أداء الأصوات

223
00:12:50,320 --> 00:12:51,580
!أمّي

224
00:12:51,580 --> 00:12:52,630
...لكن

225
00:12:53,770 --> 00:12:58,260
.إنّها غلطة الوكالة لأنّ الأمور تمادت لهذا الحدّ

226
00:12:58,260 --> 00:13:00,430
.أنا جدّ آسف على هذا

227
00:13:00,430 --> 00:13:01,680
—ولكن يا واتانابي-سان

228
00:13:01,680 --> 00:13:02,690
!أمّي

229
00:13:02,690 --> 00:13:05,000
!لم نتحدّث عن هذا إطلاقًا

230
00:13:05,000 --> 00:13:07,440
.رأيك غير مهمّ

231
00:13:07,440 --> 00:13:09,440
.سيكون الأوان قد فات إن حدث شيء ما

232
00:13:09,440 --> 00:13:13,110
رغم ذلك، من القسوة أن تطلبي
.منها ترك العمل في الحال

233
00:13:13,370 --> 00:13:18,270
ألا تهتمّ حتّى بأنّ ابنتك تواجه خطرًا وشيكًا؟

234
00:13:18,530 --> 00:13:21,650
.أوافقك الرّأي أنّه يجب اتّخاذ بعض الاحتياطات

235
00:13:21,650 --> 00:13:25,420
لكنّ قصدي هو أنّ ترك أداء الأصوات
.حلّ جذريّ أكثر من اللاّزم

236
00:13:25,420 --> 00:13:27,830
،إن كنّا نهتمّ لسلامة تشيكا

237
00:13:27,830 --> 00:13:29,960
.فمن الأفضل استئصال المشكلة من جذورها

238
00:13:29,960 --> 00:13:34,210
أداء الأصوات لا يستحقّ أن تضع
.حياتها في خطر لأجله

239
00:13:34,530 --> 00:13:38,700
لكنّ تشيكا موهوبة. حتّى أنّها حصلت
.على الدّور الرّئيسيّ في أنمي

240
00:13:39,210 --> 00:13:42,040
إن توقّفت الآن، فسيسبّب ذلك
.المشاكل للكثير من الأشخاص

241
00:13:42,310 --> 00:13:45,220
!كيف لك أن تقول هذا رغم أنّك والدها؟

242
00:13:45,220 --> 00:13:48,040
.كم أكره هذا فيك بالفعل

243
00:13:48,040 --> 00:13:49,570
!يكفي

244
00:13:49,570 --> 00:13:52,620
!إن كنتِ تعارضين الأمر، فسأنتقل

245
00:13:52,620 --> 00:13:54,750
!سأذهب للعيش مع أبي

246
00:13:54,750 --> 00:13:57,050
.لديّ الحضانة الكاملة

247
00:13:57,350 --> 00:14:01,810
ليس هناك مانع من قيام وليّ أمرك
بفسخ عقدك كقاصر، أليس كذلك؟

248
00:14:02,250 --> 00:14:05,130
،إن كنت مصرّة فعلاً أن تصيري مؤدية أصوات

249
00:14:05,130 --> 00:14:07,650
.فانتظري على الأقل حتّى تتخرّجي من الثّانويّة

250
00:14:07,650 --> 00:14:09,920
سـ-سنة ونصف؟

251
00:14:09,920 --> 00:14:11,660
...هذه مدّة طويلة بالفعل

252
00:14:11,660 --> 00:14:13,750
.مـ-مهلاً لحظة

253
00:14:13,750 --> 00:14:16,500
.سيكون توقّف يوغوري يوهي سيّئًا لمسيرتها

254
00:14:16,500 --> 00:14:19,380
.بدأ برنامجنا الإذاعيّ يحقّق النّجاح للتّوّ

255
00:14:19,380 --> 00:14:21,920
،أنا فعلاً متأسّفة جدًّا لحدوث هذا

256
00:14:21,920 --> 00:14:23,860
.ولكن سيكون عليكم إنهاؤه

257
00:14:23,860 --> 00:14:28,870
.لا-لا أريد... أن تترك واتانابي العمل

258
00:14:29,160 --> 00:14:31,840
.لا علاقة لمشاعرك بهذا الأمر

259
00:14:31,840 --> 00:14:35,590
المشكلة هي أنّ هنالك أشخاصًا
.بنوايا سيّئة يحيطون بكما

260
00:14:35,960 --> 00:14:40,130
...إذًا، سأخبر هؤلاء النّاس

261
00:14:40,460 --> 00:14:41,310
ماذا؟

262
00:14:41,710 --> 00:14:47,020
سأخبرهم أنّ هذا أمر مؤذٍ للغاية
!وأطلب منهم التّوقّف

263
00:14:47,270 --> 00:14:51,420
وتظنّين أنّهم سيتراجعون إن طلبت منهم ذلك؟

264
00:14:51,420 --> 00:14:53,070
.ذلك ما أؤمن به

265
00:14:54,840 --> 00:14:56,970
ما رأيك بهذا؟

266
00:14:57,440 --> 00:14:59,270
،انشري هذا مع تاريخ ووقت محدّدين

267
00:14:59,270 --> 00:15:03,740
بعد المدرسة، سأذهب إلى"
.المحطّة عبر شارع التّسوّق

268
00:15:03,740 --> 00:15:06,340
.ولكن رجاءً، لا تحضروا جميعًا

269
00:15:06,880 --> 00:15:12,480
".إن تحدّث أيّ أحد معي، فسأترك أداء الأصوات

270
00:15:13,440 --> 00:15:16,880
،إن لم يزعجك أيّ أحد بالفعل

271
00:15:16,880 --> 00:15:19,800
.فسأنسى مسالة توقّف تشيكا عن العمل

272
00:15:20,070 --> 00:15:21,840
...ذلك مستحيل

273
00:15:21,840 --> 00:15:22,560
.سأقوم بذلك

274
00:15:23,250 --> 00:15:25,430
،إن كان عليّ أخذ فترة توقّف في كلّ الأحوال

275
00:15:25,430 --> 00:15:28,530
فيمكنني تقبّل الأمر إن كانت
.الكلمة الأخير لمعجبيّ

276
00:15:28,530 --> 00:15:32,080
ماذا؟ لماذا كلّ هذه الجدّيّة؟

277
00:15:32,080 --> 00:15:34,540
.واضح أنّي كنت أمزح

278
00:15:34,540 --> 00:15:36,160
.ما كنت لأسمح لك بالقيام بذلك

279
00:15:37,040 --> 00:15:40,550
.سيّدتي، اسمحي لنا بالتّفكير في خطّة رجاءً

280
00:15:40,550 --> 00:15:43,900
،أجد هذا قاسيًا نوعًا ما

281
00:15:43,900 --> 00:15:48,180
ولكن رجاءً، سنفعل أيّ شيء
!لتواصل أداء الأصوات

282
00:15:48,180 --> 00:15:54,040
سأقوم بكلّ ما في وسعي للمساعدة
!إن استطاعت واتانابي المواصلة أيضًا

283
00:15:56,580 --> 00:15:58,360
.لنقم بالأمر هكذا إذًا

284
00:15:58,840 --> 00:16:04,360
يوميكو-تشان، ستضعين أنت أيضًا مسيرتك الفنّيّة
.كمؤدّية أصوات على المحكّ وستقبلين بمزحتي

285
00:16:04,360 --> 00:16:05,310
ماذا؟

286
00:16:05,690 --> 00:16:09,480
إن تحدّث أيّ أحد معك في طريقك
.للمنزل، فستأخذين فترة توقّف أيضًا

287
00:16:09,840 --> 00:16:11,480
هذا مثاليّ، صحيح؟

288
00:16:11,480 --> 00:16:13,730
أنت تؤمنين بمعجبيك، صحيح؟

289
00:16:32,010 --> 00:16:35,800
.آسفة لمبيتي هنا فجأة بلا إذن مسبق

290
00:16:35,800 --> 00:16:38,010
...لا أمانع ذلك

291
00:16:38,290 --> 00:16:40,490
!ولكن لماذا أنت هنا معي؟

292
00:16:40,490 --> 00:16:42,880
إنّه صغير لتواجد كلتينا فيه معًا، صحيح؟

293
00:16:42,880 --> 00:16:45,280
!سبق وأخبرتك

294
00:16:47,010 --> 00:16:48,210
.لنفكّر معًا

295
00:16:48,560 --> 00:16:51,180
.لنجد طريقة نواصل فيها أداء الأصوات

296
00:16:51,180 --> 00:16:53,880
.إنّ أخذ فترة توقّف ليس خيارًا من الأساس

297
00:16:53,880 --> 00:16:55,030
صحيح؟

298
00:16:55,030 --> 00:16:58,230
.بالطّبع، هذا ما أشعر به أيضًا

299
00:16:58,590 --> 00:17:01,760
لكنّ أمّي ترفض الاستماع عندما
.تكون في تلك الحالة

300
00:17:03,560 --> 00:17:07,750
اسمعي، أيمكنني أن أتحدّث
عن شيء مختلف تمامًا؟

301
00:17:08,190 --> 00:17:11,080
.أكيد. أودّ ذلك في الحقيقة

302
00:17:11,080 --> 00:17:16,060
.يوبيساكي-سان في نفس طولي تقريبًا

303
00:17:16,060 --> 00:17:18,500
.نعم، معك حقّ

304
00:17:18,500 --> 00:17:22,980
.ورغم ذلك، لديها صدر محترم للغاية

305
00:17:24,090 --> 00:17:27,060
ساتو، هل يمكنني أن أطلب منك خدمة؟

306
00:17:27,550 --> 00:17:29,530
!لا يمكنك لمس صدري

307
00:17:29,530 --> 00:17:31,370
.لم أقل ذلك من الأساس

308
00:17:32,210 --> 00:17:36,400
،ذلك الحديث مع أمّي كان محبطًا للغاية

309
00:17:36,720 --> 00:17:38,330
...لذلك فأنا منزعجة جدًّا

310
00:17:42,020 --> 00:17:44,160
.هذا ليس عدلاً يا أوين-تشان

311
00:17:44,620 --> 00:17:46,850
،إن كنت منزعجة لذلك الحدّ

312
00:17:46,850 --> 00:17:48,430
.بإمكانك لمسه

313
00:17:49,120 --> 00:17:51,160
!شكرًا يا ساتو

314
00:17:51,160 --> 00:17:53,480
.عرفتُ أنّك سترحمينني

315
00:17:53,480 --> 00:17:56,100
.تفكيرك منحرف بالفعل

316
00:18:02,270 --> 00:18:07,460
هل عليّ الجلوس مكتوفة الأيدي بينما
يتمّ إجبار واتانابي على أخذ فترة توقّف؟

317
00:18:07,900 --> 00:18:09,890
.لا يمكنني ذلك

318
00:18:09,890 --> 00:18:10,910
...لكن

319
00:18:11,400 --> 00:18:15,620
،حتّى إن وافقت على الرّهان
.فمن المستحيل أن ينجح

320
00:18:16,030 --> 00:18:19,530
.ثمّ سآخذ فترة توقّف أيضًا

321
00:18:21,660 --> 00:18:24,220
هل كنتُ لأترك أداء الأصوات؟

322
00:18:24,690 --> 00:18:29,160
.مستحيل! حقّقت حلمّي للتّوّ
.عملت بجدّ للوصول إلى هنا

323
00:18:30,150 --> 00:18:33,780
لم أستطع حتّى أن أحصل على
...تجربة أداء لبريتيا

324
00:18:34,930 --> 00:18:37,710
.يو-تشان فتاة لطيفة للغاية

325
00:18:37,710 --> 00:18:38,640
.نعم

326
00:18:38,640 --> 00:18:41,160
هل ستأتي إلى زيارتنا ثانية؟

327
00:18:41,520 --> 00:18:42,480
.نعم

328
00:18:49,020 --> 00:18:51,940
ما الّذي يجب القيام به في رأيك؟

329
00:18:51,940 --> 00:18:53,360
.لا أدري

330
00:18:54,020 --> 00:18:55,770
ما الّذي تريدين فعله؟

331
00:18:56,570 --> 00:18:57,900
.لا أدري

332
00:18:58,690 --> 00:19:02,420
آسفة. هذه ليست الطّريقة
.الصّحيحة للتّعامل مع هذا

333
00:19:02,420 --> 00:19:05,630
.هذا ليس أمرًا على الأطفال مثلكما القلق حياله

334
00:19:06,450 --> 00:19:09,560
.لديّ ما أقوله في الحقيقة

335
00:19:09,560 --> 00:19:14,250
هل يمكنك الجمع بين مديرتا أعملاكما
ويو-تشان ووالدتها معًا؟

336
00:19:14,560 --> 00:19:15,270
ماذا؟

337
00:19:17,130 --> 00:19:21,040
آسفة لأنّي طلبت منكم الحضور
.إلى هنا جميعًا رغم انشغالكم

338
00:19:21,040 --> 00:19:26,050
حسنًا، ما الّذي أردت الحديث عنه يا سيّدتي؟

339
00:19:26,050 --> 00:19:29,050
.يخصّ هذا مسألة البارحة

340
00:19:29,360 --> 00:19:33,070
.أنا أفهم تمامًا ما تشعر به والدة تشيكا-تشان

341
00:19:33,070 --> 00:19:36,930
.هناك الكثير من الأشياء المثيرة للقلق

342
00:19:37,550 --> 00:19:38,730
.نعم

343
00:19:38,730 --> 00:19:42,800
...سمعتُ بشأن ما حدث أيضًا، لذلك

344
00:19:42,800 --> 00:19:48,530
نعم. كنتُ أفكّر أيضًا في جعل يوميكو
.تأخذ فترة توقّف حتّى تتخرّج

345
00:19:49,290 --> 00:19:50,370
!أمّي؟

346
00:19:50,370 --> 00:19:54,560
.أعني أنّ يوميكو في نفس الكفّة مع تشيكا-تشان

347
00:19:54,560 --> 00:19:57,830
.لكنّي لا أستطيع إخبارها أن تتوقّف

348
00:19:58,120 --> 00:20:01,640
،عندما سمعتُ أنّك قمت بذلك بالفعل

349
00:20:01,640 --> 00:20:03,590
.منحني ذلك الشّجاعة لأحذو حذوك

350
00:20:04,920 --> 00:20:08,710
يا سيّدتي، ماذا عن مشاعر يوميكو؟

351
00:20:08,710 --> 00:20:10,090
.هذا قرار من جانب واحد

352
00:20:10,090 --> 00:20:14,550
،سمعتُ أنّ من حقّ الوالد تجاهل ذلك

353
00:20:14,550 --> 00:20:16,950
.لذلك احتفظي برأيك لنفسك رجاءً

354
00:20:18,430 --> 00:20:23,350
لكنّي سمعتُ أيضًا أنّ والدة
.تشيكا-شان اقترحت رهانًا صغيرًا

355
00:20:23,350 --> 00:20:27,440
إن أثبتت الفتاتان أنّ معجبيهما لا يملكون أيّ نيّة
.ناقصة، فستسمح لتشيكا-تشان بمواصلة العمل

356
00:20:28,110 --> 00:20:31,360
.أعتقد أنّ ذلك أمر يستحقّ المحاولة

357
00:20:32,130 --> 00:20:35,990
.رجاءً! لا يمكنك فعل هذا لأجلي

358
00:20:35,990 --> 00:20:37,370
!إنّه أمر مزعج

359
00:20:37,680 --> 00:20:40,750
.أنا آسفة، لكنّ هذه مسألة عائليّة

360
00:20:41,120 --> 00:20:43,710
هل تحاولين الحصول على استحساني؟

361
00:20:44,050 --> 00:20:48,060
.لن يُجدي التّأثير عليّ عاطفيًّا
.لن أتراجع عمّا قلته

362
00:20:48,330 --> 00:20:49,800
.أعلم ذلك

363
00:20:49,800 --> 00:20:52,880
.لكنّي أريدك أن ترتقي لكلماتك

364
00:20:52,880 --> 00:20:57,770
إن فازت الفتاتان بالرّهان، باستطاعة
كلتيهما مواصلة العمل، صحيح؟

365
00:20:57,770 --> 00:21:00,410
هل تقترحين فعلاً أنّ ذلك ممكن؟

366
00:21:00,410 --> 00:21:03,370
.لديهما فرصة وإن كانت صغيرة

367
00:21:03,970 --> 00:21:05,930
.افعلي ما يحلو لك

368
00:21:05,930 --> 00:21:10,340
بل إنّني أعتقد أنّ أخذ يوميكو-تشان
.لفترة توقّف سيكون أمرًا جيّدًا

369
00:21:10,340 --> 00:21:12,710
.إنّها في نفس الوضع في كلّ الأحوال

370
00:21:15,020 --> 00:21:18,920
هل تعرفين "السّاحرة بريتيا"؟

371
00:21:19,210 --> 00:21:20,110
.لا

372
00:21:20,460 --> 00:21:24,060
.إنّه أنمي صباحيّ للأطفال يتمّ بثّه منذ وقت طويل

373
00:21:24,060 --> 00:21:28,340
تطمح العديد من مؤدّيات
.الأصوات للحصول على دور فيه

374
00:21:28,630 --> 00:21:31,650
،وبالتّالي، فإنّ المنافسة شرسة

375
00:21:31,650 --> 00:21:35,350
.والحصول على دور صعب للغاية

376
00:21:35,350 --> 00:21:39,610
حتّى أنّ بعض النّاس يرون
.أنّ الانضمام لـ"بريتيا" كرمز لمكانتهم

377
00:21:40,090 --> 00:21:43,910
.قلتِ أنّ أخذ يوميكو لفترة توقّف سيكون جيّدًا

378
00:21:44,730 --> 00:21:46,570
.لكنّها لن تفعل ذلك

379
00:21:47,000 --> 00:21:50,010
.لا تستخفّي بعزيمة ابنتي

380
00:21:50,010 --> 00:21:53,850
أوتاتاني ياسومي مؤدّية أصوات
.ستحصل على دور في "بريتيا" يومًا ما

381
00:21:55,240 --> 00:21:58,080
.بالكاد لدينا أيّ فرص للنّجاح

382
00:21:58,080 --> 00:22:00,820
،ولكن بهدف الاستمرار

383
00:22:00,820 --> 00:22:03,600
علينا وضع كلّ شيء على المحكّ
!في هذا الرّهان المتهوّر

384
00:23:34,970 --> 00:23:39,970
‫#07 يوهي وياسومي لا يمكنهما الاستسلام ببساطة

385
00:23:36,460 --> 00:23:39,060
"يوهي وياسومي لا يمكنهما الاستسلام ببساطة"