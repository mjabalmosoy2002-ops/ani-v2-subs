1
00:00:00,000 --> 00:00:02,440
على الهواء

2
00:00:04,430 --> 00:00:05,320
...معكم يوهي

3
00:00:05,320 --> 00:00:06,400
...وياسومي

4
00:00:06,640 --> 00:00:08,190
!في إذاعة الثّانويّة

5
00:00:08,630 --> 00:00:14,200
،وضعتنا الصُّدف معًا في نفس الثّانويّة والفصل

6
00:00:14,200 --> 00:00:17,860
وهذا البرنامجُ برنامجٌ نقرّبكم جميعًا
!فيه من جوّ الأقسام الدّراسيّة

7
00:00:18,400 --> 00:00:19,910
!ممتاز يا يو-تشان

8
00:00:20,160 --> 00:00:22,960
!صرتِ بارعة في أداء الجملة الافتتاحيّة

9
00:00:22,960 --> 00:00:24,820
.على الإطلاق

10
00:00:24,820 --> 00:00:26,420
.إنّني أعاني كلّ مرّة وأنا أؤدّيها

11
00:00:26,850 --> 00:00:27,940
ماذا عنك يا ياتشان؟

12
00:00:27,940 --> 00:00:29,840
هل اعتدت على الإذاعة بعد؟

13
00:00:29,840 --> 00:00:31,670
!على الإطلاق

14
00:00:31,960 --> 00:00:34,890
!أنا أعاني لأنّ الأمر ما زال يبدو غريبًا

15
00:00:35,220 --> 00:00:36,850
.من الصّعب التّعوّد عليه

16
00:00:39,410 --> 00:00:40,890
.حسنًا إذًا، لنبدأ ثانية

17
00:00:41,900 --> 00:00:46,160
.أنا وياتشان في نفس الفصل والمدرسة

18
00:00:46,940 --> 00:00:47,850
!صحيح

19
00:00:47,850 --> 00:00:50,980
كانت محض صدفة بالفعل أن نكون
!مؤدّيتا أصوات في نفس الفصل

20
00:00:52,260 --> 00:00:53,660
أليس هذا رائعًا؟

21
00:00:53,920 --> 00:00:55,650
.بالطّبع

22
00:00:55,650 --> 00:00:58,820
.آه يا ياتشان، أشعر أنّ القدر جمع بيننا

23
00:00:58,980 --> 00:01:00,370
!إنّه القدر

24
00:01:01,950 --> 00:01:03,970
قبل حوالي شهر واحد

25
00:01:03,160 --> 00:01:06,590
مرحبًا بكم في "الأمر أقرب لمشاهدة
."براعم الكرز لساكوراناميكي أوتومي

26
00:01:06,590 --> 00:01:09,350
!دعوني أقدّمكم لضيفة اليوم

27
00:01:09,930 --> 00:01:11,620
!مـ-مساء الخير

28
00:01:12,060 --> 00:01:13,510
!اسمي أوتاتاني ياسومي

29
00:01:32,560 --> 00:01:35,440
...حسنًا، أظنّ ذلك

30
00:01:37,770 --> 00:01:38,780
.نعم، نعم

31
00:01:39,080 --> 00:01:43,240
هذه أوتاتاني ياسومي بالفعل وتؤدّي
."دور ماريغولد في "بلاستيك غيرلز

32
00:01:43,990 --> 00:01:47,150
من المحزن قليلاً أنّهم لن يطلقوا
.المزيد من الشّخصيّات

33
00:01:48,930 --> 00:01:50,920
،لو كانت أوتومي-نيسان

34
00:01:50,920 --> 00:01:54,420
.لكانوا أضافوا العديد إلى أن تنفجر الشّاشة

35
00:01:56,650 --> 00:01:58,630
...أحتاج ليتعرّف المزيد على اسمي

36
00:01:58,770 --> 00:02:02,040
!مذهل، هذا البسكويت لذيذ

37
00:02:04,840 --> 00:02:07,140
أنا معبودةُ الجماهيرِ مؤدّية
.الأصواتِ أوتاتاني ياسومي

38
00:02:07,610 --> 00:02:10,310
"أعمل لدى "تشوكو براوني
.وتواجدت في المجال لثلاث سنوات

39
00:02:13,360 --> 00:02:15,560
.تلك هي صورتي العامّة

40
00:02:20,490 --> 00:02:22,740
.وهذا هو الجانب الآخر لي

41
00:02:23,050 --> 00:02:24,760
.الاسم الحقيقيّ هو ساتو يوميكو

42
00:02:25,330 --> 00:02:27,410
.كما ترون، أنا غيارو

43
00:02:29,580 --> 00:02:31,890
،عندما أخرج للعلن كمؤدّية أصوات

44
00:02:31,890 --> 00:02:33,690
.أخفي هذا الجانب من نفسي

45
00:02:34,350 --> 00:02:38,700
لأنّ ما يريده النّاس من معبوداتِ الجماهيرِ
.مؤدّياتِ الأصواتِ هو البراءة والنّقاء

46
00:02:39,470 --> 00:02:42,550
ورغم تظاهري أنّي هذه الشّخصيّة
،الّتي ليست أنا في الحقيقة

47
00:02:42,550 --> 00:02:44,930
.بالكاد يعرف أيّ أحد أوتاتاني ياسومي

48
00:02:45,450 --> 00:02:47,290
،كما أنّي مررت بتجارب أداء فاشلة كثيرة

49
00:02:47,290 --> 00:02:48,890
.وبصراحة، أنا في وضع سيّئ

50
00:02:50,190 --> 00:02:52,390
!صباح الخير

51
00:02:52,390 --> 00:02:54,100
.صباح الخير يا واكانا

52
00:02:54,100 --> 00:02:56,060
.إنّك مليئة بالحيويّة من الصّباح الباكر

53
00:02:57,390 --> 00:02:58,820
ماذا هنالك يا يوميكو؟

54
00:02:59,110 --> 00:03:00,600
.تبدين محبطة قليلاً

55
00:03:00,860 --> 00:03:03,590
.نعم، نوعًا ما

56
00:03:03,590 --> 00:03:06,370
.تريّثي على نفسك واشربي من هذا

57
00:03:10,760 --> 00:03:11,870
.إنّه لذيذ

58
00:03:12,340 --> 00:03:13,340
!شكرًا لك

59
00:03:13,340 --> 00:03:15,830
،لا داعي للقلق، ففي أوقات كهذه

60
00:03:15,830 --> 00:03:18,010
.الأشياء الحلوة هي أفضل علاج

61
00:03:18,150 --> 00:03:20,450
،فيما عدى عائلتي وأساتذتي

62
00:03:20,450 --> 00:03:23,020
.لا يعلم أحد أنّي مؤدّية أصوات

63
00:03:23,440 --> 00:03:27,420
كما أصرّت مديرة أعمالي أيضًا
.على ألاّ أذكر الأمر لأحد

64
00:03:29,470 --> 00:03:30,520
ماذا هنالك؟

65
00:03:30,520 --> 00:03:34,650
.لا شيء، قلتُ لنفسي أنّك ظريفة اليوم أيضًا

66
00:03:34,980 --> 00:03:36,150
فعلاً؟

67
00:03:36,150 --> 00:03:38,800
!كنت أفكّر في نفس الشّيء أيضًا

68
00:03:40,940 --> 00:03:43,490
أخبرني يا كيمورا، من هذه؟

69
00:03:43,740 --> 00:03:44,770
.إنّها ظريفة

70
00:03:44,770 --> 00:03:46,400
...ما... أنا

71
00:03:46,700 --> 00:03:48,450
ظـ-ظريفة؟

72
00:03:50,440 --> 00:03:52,010
أهي معبودة جماهير؟

73
00:03:52,340 --> 00:03:54,240
يوميكو، أتعرفينها؟

74
00:03:58,290 --> 00:03:59,920
...يوغوري يوهي

75
00:04:03,050 --> 00:04:03,740
!هذا صحيح

76
00:04:03,740 --> 00:04:05,470
!اسمها يوغوري يوهي

77
00:04:05,470 --> 00:04:06,860
!"والمعروفة بـ"يوهيمي

78
00:04:06,860 --> 00:04:10,270
إنّها سنتها الثّانية فحسب، لكنّها نجمة
!واعدة حقيقيّة في عالم أداء الأصوات

79
00:04:10,270 --> 00:04:12,850
أُفضّل الفتيات مثلها اللاّتي ما زلن في البداية

80
00:04:12,850 --> 00:04:15,730
بدل مؤدّيات الأصوات الكبيرات
!مثل ساكوراناميكي أوتومي

81
00:04:15,730 --> 00:04:17,960
أنا لستُ ممّن يصيرون من المعجبين
.عندما تزداد شعبيّة فنّان ما

82
00:04:15,730 --> 00:04:17,960
.لديك ما تقوله بالفعل

83
00:04:17,960 --> 00:04:18,800
...أعني

84
00:04:21,520 --> 00:04:23,880
كيمورا، هل يمكنني رؤية ذلك لوهلة؟

85
00:04:23,880 --> 00:04:25,320
.أريد أن أمعن النّظر إليها

86
00:04:25,990 --> 00:04:26,450
...آسفة

87
00:04:31,570 --> 00:04:32,790
!أنا جدّ آسفة

88
00:04:32,790 --> 00:04:34,710
.أتساءل إن كان ذلك سيترك بقعة

89
00:04:34,710 --> 00:04:35,960
.أنا فعلاً جدًّا آسفة

90
00:04:36,480 --> 00:04:39,550
عفوًا، ما كان اسمك؟

91
00:04:40,600 --> 00:04:43,030
.واتانابي. واتانابي تشيكا

92
00:04:48,930 --> 00:04:50,340
.واتانابي تشيكا

93
00:04:50,950 --> 00:04:53,270
،إنّها فتاة عاديّة جدًّا
،من النّوع الّذي يدعك تقول

94
00:04:53,560 --> 00:04:55,800
."صحيح، أظنّها في فصلنا أيضًا"

95
00:04:56,370 --> 00:05:00,480
إنّها وحيدة دائمًا، ولم أرها
.تتحدّث مع أيّ شخص

96
00:05:03,020 --> 00:05:06,220
.آسفة يا واتانابي-سان، سأنظّف هذا حالاً

97
00:05:10,970 --> 00:05:12,330
!يا واتانابي-سان

98
00:05:17,950 --> 00:05:18,920
!تمهّلي

99
00:05:20,970 --> 00:05:22,300
!تمهّلي لحظة

100
00:05:26,060 --> 00:05:29,200
.أعلم أنّ ذلك كان خطأ واكانا بالكامل

101
00:05:29,200 --> 00:05:32,600
لكنّي لا أعتقد أنّ تصرّفك هذا
.مع شخص يعتذر قد يكون مقبولاً

102
00:05:34,240 --> 00:05:35,390
.هذا مزعج

103
00:05:35,710 --> 00:05:36,310
ماذا؟

104
00:05:36,310 --> 00:05:38,690
،لا أدري إن كانت مؤدّية أصوات أو ما شابه

105
00:05:38,690 --> 00:05:40,730
.لكن من الغباء جدًّا التّحمّس حيال أمر كهذا

106
00:05:41,320 --> 00:05:43,730
.لا أفهم حتّى ما الحماسيّ هكذا فشأنها

107
00:05:44,330 --> 00:05:47,150
عمّ تتحدّثين؟

108
00:05:47,470 --> 00:05:52,050
يفترض أنّها مؤدّية أصوات، لكنّها تغنّي
.وترقص وتتظاهر أنّها معبودة جماهير

109
00:05:55,380 --> 00:05:57,750
.من المزعج مشاهدة هذا في كلّ الأحوال

110
00:05:58,140 --> 00:05:58,980
.هذا كلّ شيء

111
00:06:02,260 --> 00:06:04,790
لن أسمح لك بقول أشياء كهذه
.بينما تجهلين تمامًا عمّ تتحدّثين

112
00:06:05,690 --> 00:06:07,680
!يوغوري يوهي ظريفة

113
00:06:08,630 --> 00:06:10,660
وأجل، يُعتبر مظهرها عاملاً
،في نشر صورتها

114
00:06:10,660 --> 00:06:12,190
!ولكن ما الضّرر من ذلك؟

115
00:06:12,650 --> 00:06:15,390
!ولمعلوماتك، مظهرها ليس نقطة قوّتها الوحيد

116
00:06:15,530 --> 00:06:18,810
تمثيل وغناء يوغوري يوهي
،من الدّرجة الرّفيعة

117
00:06:18,810 --> 00:06:21,420
،وهي جميلة المظهر فوق ذلك
!لهذا السّبب تحظى بالشّعبيّة

118
00:06:21,420 --> 00:06:22,270
أفهمت؟

119
00:06:22,560 --> 00:06:24,170
!ما الّذي تريدينه؟

120
00:06:25,330 --> 00:06:29,660
أنت من ليس عليها الكلام
!وأنت تجهلين عمّ تحدّثين عنه

121
00:06:35,760 --> 00:06:37,760
يا إلهي، ما مشكلتها؟

122
00:06:38,910 --> 00:06:40,960
...لا أريد التّعامل معها ثانية

123
00:06:48,290 --> 00:06:50,840
.كاغاساكي-سان، شكرًا على الاتّصال

124
00:06:51,300 --> 00:06:53,720
.يوميكو، لقد حصلتِ على عمل

125
00:06:55,530 --> 00:06:56,890
!ما العمل الّذي حصلت عليه؟

126
00:06:57,150 --> 00:07:00,390
.حسنًا، إنّه ليس في أنمي

127
00:07:02,650 --> 00:07:04,370
برنامج إذاعيّ؟

128
00:07:10,420 --> 00:07:12,390
!مرحبًا بالجميع

129
00:07:12,700 --> 00:07:14,470
مساء... الخير؟

130
00:07:12,700 --> 00:07:23,580
أوتونوما

131
00:07:12,700 --> 00:07:23,580
محطّة إذاعيّة على الإنترنيت

132
00:07:12,700 --> 00:07:23,580
إذاعة التّسامي

133
00:07:12,700 --> 00:07:23,580
ماريمو-تشان

134
00:07:12,700 --> 00:07:23,580
إذاعة التّسامي ماريمو-تشان

135
00:07:14,910 --> 00:07:16,860
إنّه المساء، صحيح؟

136
00:07:18,220 --> 00:07:20,130
.نعم، إنّه كذلك

137
00:07:20,130 --> 00:07:23,280
،اسمي يوغوري يوهي
.أؤدّي دور ريوكيو ماريمو

138
00:07:23,830 --> 00:07:28,500
يوغوري يوهي معبودة جماهير مؤدّية للأصوات
.وتلميذة في السّنة الثّانية من الثّانويّة مثلي

139
00:07:24,440 --> 00:07:31,050
نسخة خاصّة

140
00:07:24,440 --> 00:07:31,050
يوغوري يوهي

141
00:07:28,990 --> 00:07:30,820
.لكنّ تلك هي أوجه التّشابه الوحيدة بيننا

142
00:07:31,280 --> 00:07:34,420
،وبينما كانت تحصل على أعمال بشكل دوريّ

143
00:07:34,420 --> 00:07:36,450
.أجد نفسي أتراجع أكثر فأكثر

144
00:07:37,950 --> 00:07:40,240
...أتساءل إن كنّا سننسجم معًا

145
00:07:41,190 --> 00:07:43,150
.على الأرجح لا

146
00:07:44,220 --> 00:07:47,020
.آسف على الاتّصال بك فجأة هكذا

147
00:07:47,250 --> 00:07:48,410
،في الحقيقة

148
00:07:48,410 --> 00:07:51,490
انهارت شعبيّة برنامج أبريل
.الجديد خاصّتنا دون سابق إنذار

149
00:07:51,740 --> 00:07:54,930
.لذلك جهّزت هذا في أسرع ما يمكن

150
00:07:55,180 --> 00:07:55,970
.حسنًا

151
00:07:56,370 --> 00:07:59,830
إذاعة الثّانويّة مع
يوهي وياسومي

152
00:07:56,370 --> 00:07:59,830
(تقديم: يوغوري يوهي (بلو كراون
(أوتاتاني ياسومي (تشوكو براوني

153
00:07:56,790 --> 00:07:59,590
ولكن تريدني أنا أن أعمل مع يوغوري-سان؟

154
00:08:00,180 --> 00:08:03,710
،لم تلتقي بعد بيوغوري-سان
صحيح يا أوتاتاني-سان؟

155
00:08:03,950 --> 00:08:05,770
.نعم، هذا صحيح

156
00:08:06,220 --> 00:08:08,460
.لم أتعامل في أيّ مشروع معها

157
00:08:09,120 --> 00:08:09,960
.هكذا إذًا

158
00:08:10,370 --> 00:08:13,450
.يملك هذا البرنامج الإذاعيّ سرًّا

159
00:08:13,450 --> 00:08:16,680
.هناك شيء ضخم تتشاركانه معًا

160
00:08:16,880 --> 00:08:18,010
وما هو؟

161
00:08:18,280 --> 00:08:22,910
،عندما اكتشفتُ الأمر
!فاجأني بشكل لا يُصدّق

162
00:08:22,910 --> 00:08:26,690
لدرجة أنّني جهّزتُ مشروع هذا
!البرنامج في الحال

163
00:08:27,210 --> 00:08:28,170
لا تدرين، صحيح؟

164
00:08:29,860 --> 00:08:32,860
ماذا أفعل يا ترى؟

165
00:08:33,460 --> 00:08:36,320
!ما باليد حيلة، سأخبرك

166
00:08:36,320 --> 00:08:40,220
اكتشفتُ صدفة عندما كنتُ
،أكلّم مديرة أعمالك

167
00:08:40,220 --> 00:08:41,260
...أنّكما في الواقع

168
00:08:41,260 --> 00:08:42,380
.صباح الخير

169
00:08:42,380 --> 00:08:43,700
.أنا يوغوري يوهي

170
00:08:45,820 --> 00:08:48,370
...سررت بالتّعرّف... إليك

171
00:08:50,240 --> 00:08:50,820
ماذا؟

172
00:08:51,300 --> 00:08:54,170
!ما-ما الّذي تفعلينه هنا؟

173
00:08:55,190 --> 00:08:57,150
!أنا من عليها قول ذلك

174
00:08:57,150 --> 00:08:59,390
!ما الّذي يفعله شخص مثلك هنا؟

175
00:08:59,660 --> 00:09:04,190
صحيح، إذًا فأنتما تعرفان بعضكما
.بالفعل في حياتكما الحقيقيّة

176
00:09:04,190 --> 00:09:05,560
الحقيقيّة"؟"

177
00:09:05,840 --> 00:09:07,860
!حان الوقت للكشف عن السّرّ

178
00:09:08,610 --> 00:09:09,590
!هذا صحيح

179
00:09:09,590 --> 00:09:13,190
!أوتاتاني ياسومي ويوغوري يوهي زميلتا فصل

180
00:09:13,190 --> 00:09:16,120
،وأنتما لستما تلميذتا ثانويّة فحسب
!بل ترتادان نفس المدرسة

181
00:09:16,120 --> 00:09:20,580
إنّ فكرة برنامج إذاعيّ لمؤدّيات
!أصوات كهذه ستنجح نجاحًا باهرًا

182
00:09:20,790 --> 00:09:27,330
،إ-إذًا فأنت هي يوغوري يوهي
وشريكتي في البرنامج الإذاعيّ؟

183
00:09:27,600 --> 00:09:32,510
أنت هي أوتاتاني ياسومي
الّتي سأعمل معها في هذا المشروع؟

184
00:09:33,360 --> 00:09:36,010
(تقديم: يوغوري يوهي (بلو كراون
(أوتاتاني ياسومي (تشوكو براوني

185
00:09:55,250 --> 00:09:58,020
هل أنت بالفعل هي يوغوري يوهي؟

186
00:09:58,020 --> 00:10:01,150
.تصوُّري عنك بعيد كلّ البعد عن الحقيقة

187
00:10:01,150 --> 00:10:04,060
.أنت أيضًا شخص مختلف تمامًا

188
00:10:04,060 --> 00:10:07,580
.لا أصدّق أنّك هي أوتاتاني ياسومي

189
00:10:08,350 --> 00:10:12,860
كانت ماريغولد شخصيّتي المفضّلة
.من "بلاستيك غيرلز" أيضًا

190
00:10:12,860 --> 00:10:15,590
لا أصدّق أنّ شخصًا غير لبق
.مثلك أدّى دورها

191
00:10:16,770 --> 00:10:22,620
."صحيح، وأنا كنتُ أحبّ "النّظر لأطراف أصابعي

192
00:10:22,620 --> 00:10:26,310
ولكنّ اكتشاف أنّ شخصًا سلبيًّا
مثلك أدّى دور بطلة نقيّة مثلها

193
00:10:26,310 --> 00:10:28,520
.كافٍ ليخيّب ظنّي

194
00:10:28,890 --> 00:10:30,470
،حسب ذلك المنطق

195
00:10:30,470 --> 00:10:33,730
!لا يمكنك على الإطلاق لعب دور بطلة نقيّة

196
00:10:34,060 --> 00:10:36,510
تمهّلي! ألستُ أقدم منك في هذا المجال؟

197
00:10:36,510 --> 00:10:40,190
،إنّني أقوم بهذا لثلاث سنوات
.وأنت لسنتين فحسب

198
00:10:40,190 --> 00:10:43,740
هل تريدين أن أعلّمك كيف
تتحدّثين لزملائك الأقدم بلباقة؟

199
00:10:43,960 --> 00:10:46,270
،هذه سنتي الثّانية في الأداء الصّوتي فقط

200
00:10:46,270 --> 00:10:48,240
،لكنّي كنت في فرقة مسرحيّة في البداية

201
00:10:48,240 --> 00:10:50,330
وهذا يجعلني فنّانة مخضرمة
.عملت أربع سنوات

202
00:10:50,460 --> 00:10:54,960
لذلك سأردّ كلامك عليك مباشرة
.يا زميلتي الأحدث

203
00:10:56,820 --> 00:10:59,470
.مرحبًا، صباح الخير

204
00:11:00,160 --> 00:11:02,490
.آسفة على التّأخير

205
00:11:02,490 --> 00:11:03,800
!أساكا-تشان

206
00:11:04,110 --> 00:11:07,910
مرّ وقت طويل مذ عملنا معًا
.على برنامج ما يا ياسومي-تشان

207
00:11:07,910 --> 00:11:10,060
.عليك القدوم للطّبخ لنا مرّة أخرى

208
00:11:10,060 --> 00:11:13,380
.لا أمانع، لكنّ منزلك متّسخ جدًّا

209
00:11:13,380 --> 00:11:15,720
.اتّصلي بي بمجرّد أن يُنظّف

210
00:11:16,150 --> 00:11:18,780
!لكنّي لن أستقبلك بعد ذلك أبدًا هكذا

211
00:11:19,590 --> 00:11:20,990
.حسنًا، لنبدأ

212
00:11:20,990 --> 00:11:26,310
.أنا أساكا ميري وعُيّنتُ ككاتبة لهذا البرنامج

213
00:11:26,770 --> 00:11:30,330
.سررت بلقائك. أتطلّع قدمًا للعمل معك

214
00:11:31,320 --> 00:11:33,080
.هذا هو النّصّ

215
00:11:33,320 --> 00:11:37,500
.سنقوم بشيء مختلف في الحلقة الأولى

216
00:11:37,900 --> 00:11:41,840
"!لنتعرّف على بعضنا! سؤال وجواب"

217
00:11:42,980 --> 00:11:45,540
.السّؤال الأوّل هو الأنمي المفضّل لديكما

218
00:11:46,220 --> 00:11:47,470
.ابدئي يا ياسومي-تشان

219
00:11:47,990 --> 00:11:49,890
!"إنّه "السّاحرة بريتيا

220
00:11:50,170 --> 00:11:52,810
!أحبّه كثيرًا لدرجة أنّي حلمت بالمشاركة فيه

221
00:11:53,910 --> 00:11:55,770
ساتو تؤدّي دور بريتيا؟

222
00:11:56,580 --> 00:11:58,780
.سيكون ذلك من سابع المستحيلات

223
00:11:58,780 --> 00:12:00,190
!لم يسأل أحد رأيك

224
00:12:00,190 --> 00:12:01,670
ماذا عنك يا واتانابي؟

225
00:12:01,670 --> 00:12:04,640
.أراهن أنّك تحبّين أنمي بارزًا أو ما شابه

226
00:12:08,400 --> 00:12:10,450
...أنميات الميكا والرّوبوتات

227
00:12:10,450 --> 00:12:14,020
.أنا أحبّ كلّ شيء أخرجه كاميشيرو

228
00:12:14,020 --> 00:12:15,920
.مثل "غولدرا الحديديّ" وما شابه

229
00:12:15,920 --> 00:12:20,300
يا إلهي، إنّ هذا غير متوقّع
.لدرجة أنّه يجعلك محبوبة أكثر

230
00:12:20,300 --> 00:12:21,890
.هذا مزعج نوعًا ما

231
00:12:21,890 --> 00:12:24,080
.لهذا السّبب لا أحبّ الحديث عن هذا

232
00:12:24,080 --> 00:12:25,930
.سيقول النّاس أنّي مزيّفة

233
00:12:25,930 --> 00:12:30,610
.ممتاز، واصلا الحديث على هذا الشّكل

234
00:12:30,610 --> 00:12:33,190
يوهي-تشان، ما الّذي تحبّين في ذلك الأنمي؟

235
00:12:35,800 --> 00:12:36,610
...حسنًا

236
00:12:36,610 --> 00:12:40,370
،"إن كان عليّ اختيار شيء في "غولدرا الحديديّ

237
00:12:40,820 --> 00:12:45,350
!فسيكون التّعقيد المستعمل في تصاميم الميكا

238
00:12:45,350 --> 00:12:48,320
إنّ توايلات، الوحدة الّتي يستعملها
،الشّخصيّة الرّئيسيّة حتّى الحلقة الرّابعة

239
00:12:48,320 --> 00:12:50,280
.جميلة جدًّا لدرجة أنّي أتنهّد كلّما رأيتها

240
00:12:50,280 --> 00:12:52,300
...وكبداية، إنّ شكل المحرّك

241
00:12:51,370 --> 00:12:57,740
وهكذا، إذاعة الأداء الصّوتيّ
.بدأت بعد أن جمع القدر بيننا

242
00:12:57,310 --> 00:13:01,000
يوهي وياسومي
في إذاعة الثّانويّة
!الحلقة 3

243
00:12:59,400 --> 00:13:04,670
.آه يا ياتشان، أشعر أنّ القدر جمع بيننا

244
00:13:04,670 --> 00:13:06,380
!إنّه القدر

245
00:13:06,380 --> 00:13:11,350
ستتواصل "إذاعة الثّانويّة مع
.يوهي وياسومي" بفقرتنا المعتادة

246
00:13:12,180 --> 00:13:14,900
ماذا؟ هل من خطب ما؟

247
00:13:16,170 --> 00:13:18,310
.يبدو أنّنا توصّلنا برسالة

248
00:13:18,310 --> 00:13:21,140
أهو إعلان كبير؟

249
00:13:21,670 --> 00:13:23,210
!أتساءل ما هو

250
00:13:23,210 --> 00:13:25,530
ربّما إطلاق قرص لبرنامجنا؟

251
00:13:26,050 --> 00:13:27,940
!ما زال الوقت باكرًا على ذلك

252
00:13:27,940 --> 00:13:30,320
.لم نقم إلاّ بثلاث حلقات حتّى الآن

253
00:13:32,660 --> 00:13:33,840
يو-تشان؟

254
00:13:34,490 --> 00:13:36,000
!يا يو-تشان

255
00:13:36,000 --> 00:13:38,260
.أنا آسفة

256
00:13:38,260 --> 00:13:40,490
.تفاجأت قليلاً فحسب

257
00:13:40,490 --> 00:13:42,650
ما الأمر يا يو-تشان؟

258
00:13:42,650 --> 00:13:45,320
أهو أمر لا يُصدّق لهذه الدّرجة؟

259
00:13:45,320 --> 00:13:48,400
.حسنًا، سأقرأ الرّسالة

260
00:13:48,400 --> 00:13:50,180
أ-أتتخيّلين؟

261
00:13:50,660 --> 00:13:56,960
ستقوم "إذاعة الثّانويّة مع
!يوهي وياسومي" بتسجيل علنيّ

262
00:13:57,700 --> 00:13:58,380
ماذا؟

263
00:13:58,850 --> 00:14:01,310
استعداد

264
00:14:00,450 --> 00:14:01,860
.لم أسمع بهذا من قبل

265
00:14:02,500 --> 00:14:04,390
لماذا لم تخبريني من قبل

266
00:14:04,390 --> 00:14:07,350
أنّنا سنقوم بتسجيل علنيّ؟

267
00:14:07,350 --> 00:14:10,980
ليس من غير المألوف أن تكون هناك
إعلانات مفاجئة حول المشروع

268
00:14:10,980 --> 00:14:13,290
.أثناء جلسة التّسجيل

269
00:14:13,650 --> 00:14:16,140
انتهى التّسجيل لهذا اليوم، صحيح؟

270
00:14:16,590 --> 00:14:17,970
...سأستأذن بالذّهاب

271
00:14:21,600 --> 00:14:23,810
ما خطب يوهي-تشان؟

272
00:14:24,240 --> 00:14:25,290
.لا أدري

273
00:14:25,290 --> 00:14:27,770
.لا فكرة لديّ على الإطلاق

274
00:14:28,250 --> 00:14:30,970
.لا يمكنني معرفة ما تفكّر فيه أبدًا

275
00:14:30,970 --> 00:14:36,270
أخبريني، كيف هي يوهي-تشان في المدرسة؟

276
00:14:36,270 --> 00:14:37,430
ماذا؟

277
00:14:38,070 --> 00:14:39,630
.أتساءل عن ذلك

278
00:14:39,630 --> 00:14:44,640
إنّها لا تتحدّث إطلاقًا وتجلس
.بهدوء في زاوية الفصل

279
00:14:44,640 --> 00:14:46,650
.كئيبة كعادتها

280
00:14:46,650 --> 00:14:49,870
إنّ المحادثات الّتي تدور بينكما أثناء التّسجيل

281
00:14:49,870 --> 00:14:52,940
.لا تُشعر المرء أنّكما زميلتا دراسة بالفعل

282
00:14:52,940 --> 00:14:55,040
.أنا أفتقر لشيء ما

283
00:14:55,990 --> 00:14:58,920
.لن أتمادى كثيرًا وأقول لكما أن تصيرا صديقتين

284
00:14:59,590 --> 00:15:03,810
ولكن ربّما يمكنك أن تحاولي
.التّعرّف أكثر لشريكتك

285
00:15:11,370 --> 00:15:13,680
!استراحة الغداء أخيرًا

286
00:15:14,190 --> 00:15:16,220
.أنا أتضوّر جوعًا

287
00:15:16,950 --> 00:15:18,680
ما الأمر يا يوميكو؟

288
00:15:18,910 --> 00:15:22,230
.آسفة يا واكانا. عليّ القيام بأمر ما

289
00:15:33,650 --> 00:15:35,750
.ماذا؟ هذه أنت فحسب

290
00:15:36,140 --> 00:15:38,930
،لا تهتمّين في العادة لرأي الآخرين

291
00:15:38,930 --> 00:15:41,730
ولكن أعتقد أنّه حتّى أنت لا تريدين
.أن يراك الآخرون تأكلين وحدك

292
00:15:41,730 --> 00:15:42,540
.صحيح

293
00:15:42,890 --> 00:15:45,170
.اضحكي إن أردت

294
00:15:45,170 --> 00:15:47,050
،إن ضحكت الآن

295
00:15:47,050 --> 00:15:50,170
فسيبدأ ذلك نقاشًا عن مكانتي
.في التّمثيل الصّوتي فحسب

296
00:15:50,910 --> 00:15:53,450
...ربّما عليّ مراجعة النّصوص في المدرسة أيضًا

297
00:15:53,830 --> 00:15:56,790
.لديك أصدقاء، لذلك ليس عليك ذلك

298
00:15:57,730 --> 00:16:02,350
أستعمل وقت فراغي هكذا فقط لأنّه ليس
.لديّ ما هو أفضل لأقوم به في المدرسة

299
00:16:02,810 --> 00:16:05,770
أعتقد أنّه من الأفضل إن استطعتِ
أن تكوني ممثّلة صوتيّة

300
00:16:05,770 --> 00:16:07,980
.وتلميذة عاديّة في نفس الوقت

301
00:16:15,060 --> 00:16:18,660
لماذا أتيت كلّ هذه المسافة إلى هنا؟

302
00:16:18,660 --> 00:16:23,710
.افترضتُ أنّه عليّ التّعرّف عليك أكثر

303
00:16:23,710 --> 00:16:27,850
إنّ برنامجنا لا يبدو وكأنّه عن
زميلتَيْ فصل تتحدّثان، صحيح؟

304
00:16:27,850 --> 00:16:30,920
قالت أساكا-سان هذا، صحيح؟

305
00:16:31,800 --> 00:16:36,260
أفترض أنّه سيكون من الجيّد
.الحديث عن اليوم في البرنامج

306
00:16:36,650 --> 00:16:39,280
تقصدين كيف تناولتِ غداءك وحدك؟

307
00:16:40,980 --> 00:16:42,810
.بالطّبع لا

308
00:16:42,810 --> 00:16:43,740
.يا لغبائك

309
00:16:44,130 --> 00:16:47,290
.أقصد الحديث عن تناولنا الغداء معًا

310
00:16:52,940 --> 00:16:55,160
!إذاعة الثّانويّة مع يوهي وياسومي

311
00:16:52,940 --> 00:16:55,160
تسجيل علنيّ

312
00:17:04,290 --> 00:17:06,710
.هذه أنت يا واتانابي

313
00:17:06,990 --> 00:17:08,990
.تبدين مختلف تمامًا

314
00:17:09,340 --> 00:17:11,430
.يمكنني قول نفس الشّيء عنك

315
00:17:11,430 --> 00:17:14,570
.إنّ هذا النّوع من التّحوّل سخيف

316
00:17:17,200 --> 00:17:19,170
...هذا بشأن يوهي-تشان

317
00:17:19,530 --> 00:17:22,890
.يبدو أنّها قلقة جدًّا لسبب ما

318
00:17:24,400 --> 00:17:27,580
أهذا أوّ تسجيل علنيّ لك أو ما شابه؟

319
00:17:27,580 --> 00:17:28,630
!وماذا في ذلك؟

320
00:17:28,980 --> 00:17:31,530
!أتحاولين التّباهي بخبرتك؟

321
00:17:31,530 --> 00:17:36,450
سبق وقلت هذا، عندما يتعلّق
.الأمر بالتّمثيل، فأنا أفوقك خبرة

322
00:17:37,180 --> 00:17:39,360
،وسأقولها أنا ثانية

323
00:17:39,360 --> 00:17:42,410
.في الأداء الصّوتيّ، أنا أفوقك خبرة

324
00:17:42,410 --> 00:17:44,730
.وخاصّة بكوني معبودة جماهيرَ مؤدّية للأصوات

325
00:17:44,730 --> 00:17:46,880
.لديّ خبرة أكثير

326
00:17:47,330 --> 00:17:49,740
.يمكنك الحديث معي إن كان هنالك ما يقلقك

327
00:17:49,740 --> 00:17:53,110
.كم أكره تصرّفك هذا

328
00:17:56,130 --> 00:18:00,570
.لا أفهم أبدًا جاذبيّة يوغوري يوهي

329
00:18:01,110 --> 00:18:01,600
ماذا؟

330
00:18:02,110 --> 00:18:07,080
،لا يمكنني الغناء ولا أظهر مواهبي في التّمثيل

331
00:18:07,080 --> 00:18:09,100
.لذلك لا أرى كيف يمكن أن تكون لي قيمة

332
00:18:09,100 --> 00:18:10,940
.مهلاً لحظة

333
00:18:10,940 --> 00:18:13,070
ماذا عن برنامجك الإذاعيّ؟

334
00:18:13,880 --> 00:18:16,090
.أعرف ما عليّ فعله

335
00:18:16,090 --> 00:18:19,320
كنتُ أقدّم للمعجبين نسخة
.مزيّفة عنّي طوال الوقت

336
00:18:20,160 --> 00:18:22,690
.أكره هذه الشّخصيّة

337
00:18:22,690 --> 00:18:27,040
معبودة الجماهيرِ مؤدّية الأصوات
...يوغوري يوهي المزيّفة

338
00:18:27,850 --> 00:18:30,220
.لكنّها ما يريده المستمعون

339
00:18:30,540 --> 00:18:34,020
.لا أدري ما الّذي يفترض بي فعله

340
00:18:37,260 --> 00:18:38,530
.واتانابي

341
00:18:41,080 --> 00:18:42,760
...ما تقلقين حياله

342
00:18:44,300 --> 00:18:46,430
.لا معنى له على الإطلاق

343
00:18:47,740 --> 00:18:48,450
—لا معنى

344
00:18:49,440 --> 00:18:50,490
!تماديتِ

345
00:18:50,490 --> 00:18:52,890
!أنا أكره كيفية تصرّفك بالفعل

346
00:18:52,890 --> 00:18:54,900
.ذلك لا يهمّ

347
00:18:54,900 --> 00:18:59,520
.لا يهتمّ الجمهور إن كان لديك شكوك حيال نفسك

348
00:18:59,520 --> 00:19:01,230
أنت محترفة، صحيح؟

349
00:19:01,230 --> 00:19:07,540
وبصفتك محترفة، ألا يكفي أن تقلقي فقط
،على جمهورك الّذي سيدور في باله هذا

350
00:19:07,540 --> 00:19:11,620
.كانت يوهيمي رائعة اليوم"
"استمتعت بوقتي كثيرًا؟

351
00:19:12,740 --> 00:19:19,340
،وإن كنتِ قلقة جدًّا بالفعل
.شاهديني وأنا أقف إلى جانبك

352
00:19:21,880 --> 00:19:25,510
،عندما تدركين أنّك لست وحدك
.تصير الأمور أسهل بكثير

353
00:19:25,510 --> 00:19:28,470
!لكن ربّما لا يُعتمد عليّ بما يكفي في نظرك

354
00:19:28,860 --> 00:19:30,330
!حسنًا، لنذهب

355
00:19:35,840 --> 00:19:37,400
.انظري يا واتانابي

356
00:19:37,780 --> 00:19:42,860
ما الّذي قد يقلقك بوجود
هذا الجمهور الودود هنا؟

357
00:19:43,510 --> 00:19:45,450
.كـ-كلّ شيء بخير

358
00:19:45,770 --> 00:19:47,700
.كما قلتِ تمامًا

359
00:19:47,700 --> 00:19:49,990
.هذا رائع للغاية

360
00:19:49,990 --> 00:19:51,830
.لا، هذا سيّئ

361
00:19:53,670 --> 00:19:55,120
.ما باليد حيلة

362
00:20:04,610 --> 00:20:06,140
ما كان ذلك؟

363
00:20:06,140 --> 00:20:08,010
.انظري يا واتانابي

364
00:20:08,410 --> 00:20:10,850
.إنّ الجمهور ليس شيئًا يدعو للخوف

365
00:20:10,850 --> 00:20:13,640
.إنّهم هم من يمنحونك الشّجاعة

366
00:20:14,020 --> 00:20:16,840
!مرحبًا بالجميع

367
00:20:16,840 --> 00:20:18,570
،قبل حتّى أن نبدأ

368
00:20:18,570 --> 00:20:21,710
!كانت يو-تشان متوتّرة جدًّا وتعثّرت

369
00:20:22,230 --> 00:20:26,660
!شجّعوها جميعًا رجاءً

370
00:20:26,660 --> 00:20:29,400
!يوهيمي، لا يوجد ما يدعو للتّوتّر

371
00:20:29,400 --> 00:20:31,620
!خذي وقتك –
بدا ذلك مؤلمًا. هل أنت بخير؟ –

372
00:20:35,130 --> 00:20:37,420
!مرحبًا بالجميع

373
00:20:37,420 --> 00:20:39,410
.شكرًا جزيلاً لكم

374
00:20:39,410 --> 00:20:41,140
،كنتُ متوتّرة

375
00:20:41,140 --> 00:20:43,720
!ولكن بفضلكم جميعًا صرت أفضل بكثير

376
00:20:44,220 --> 00:20:46,840
والآن، لنبدأ في الحال

377
00:20:46,840 --> 00:20:51,060
بهذا التّسجيل العلنيّ لـ"إذاعة
!"الثّانويّة مع يوهي وياسومي

378
00:20:51,060 --> 00:20:53,730
!شكرًا على قدومكم اليوم

379
00:22:37,860 --> 00:22:39,230
ما الخطب؟

380
00:22:40,010 --> 00:22:42,850
.أعتقد أنّ نجاح الحدث جعل عواطفها تغمرها

381
00:22:42,850 --> 00:22:44,720
.إذًا لديها جانب ظريف بالفعل

382
00:22:45,540 --> 00:22:49,010
أنت من "تشوكو براوني"، صحيح؟

383
00:22:49,010 --> 00:22:51,540
ماذا؟ صحيح، لماذا؟

384
00:22:52,050 --> 00:22:54,920
."سأقدّم شكوى رسميّة عبر "بلو كراون

385
00:22:54,920 --> 00:23:00,320
يجب أن يعرفوا أنّ أحد العاملين لديهم
.استخدم العنف لإحراج موهبتنا

386
00:23:00,320 --> 00:23:01,180
!مهلاً، مهلاً

387
00:23:01,180 --> 00:23:03,150
كيف وصلتِ لهذا الاستنتاج؟

388
00:23:05,690 --> 00:23:07,900
...اسمعي يا واتانابي

389
00:23:07,900 --> 00:23:10,390
.إيّاك وأن تحاولي القيام بذلك ثانية

390
00:23:11,850 --> 00:23:14,120
!سأحرص على ألاّ تضطرّين لذلك

391
00:23:22,720 --> 00:23:25,090
يو-تشان، أكان ذلك شكرًا منك؟

392
00:23:25,090 --> 00:23:27,960
!شكرًا جزيلاً لك! لقد أنقذتني

393
00:23:36,410 --> 00:23:38,650
!"يوهي وياتسومي والمجموعة و"