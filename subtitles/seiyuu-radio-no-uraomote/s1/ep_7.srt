1
00:00:09,790 --> 00:00:11,620
!أوني-تشان

2
00:00:11,620 --> 00:00:13,240
!أنا هنا

3
00:00:14,390 --> 00:00:17,600
اعتقدت أنّه ربّما يمكنني إبهاج
،واتانابي بدعوتها للخروج

4
00:00:17,600 --> 00:00:20,450
.لكنّي لم أعتقد أبدًا أنّها ستأتي بالفعل

5
00:00:20,900 --> 00:00:24,040
يمكنني رؤية كيف يمكن لكلّ هذا
...أن يكون محبطًا

6
00:00:35,130 --> 00:00:38,970
واتانابي، هل هنالك أيّ شيء
آخر تريدينه غير الفطائر؟

7
00:00:39,440 --> 00:00:40,720
...لحظة لأفكّر

8
00:00:41,280 --> 00:00:46,220
الطّريقة الوحيدة لنستمرّ في كوننا
.مؤدّيات أصوات هي بقبول الرّهان

9
00:00:46,220 --> 00:00:50,420
،لكن بالنّظر إلى جنون الإنترنيت حيال الموضوع

10
00:00:50,420 --> 00:00:52,100
.من المستحيل أن ينجح الأمر

11
00:00:52,870 --> 00:00:53,560
.كلاّ

12
00:02:31,080 --> 00:02:33,180
.مرحبًا

13
00:02:33,180 --> 00:02:37,500
.التقيت بآخر شخصين أريد أن أراهما في هذا العالم

14
00:02:37,500 --> 00:02:39,810
هل أنت في طريقك للعمل يا يوبيساكي-سان؟

15
00:02:39,810 --> 00:02:40,470
.نعم

16
00:02:40,470 --> 00:02:42,440
.حدثٌ خاصّ بلعبة هواتف

17
00:02:42,440 --> 00:02:43,940
ماذا؟

18
00:02:43,940 --> 00:02:47,500
ما كنت لأتخيّل أبدًا أنّ مؤدّية الأصوات المشهورة

19
00:02:47,500 --> 00:02:50,810
.يوغوري يوهي تضيّع الوقت هكذا في أيّام راحتها

20
00:02:52,660 --> 00:02:53,730
...يوبيساكي-سان

21
00:02:53,730 --> 00:02:54,110
.سلام

22
00:02:54,110 --> 00:02:57,240
.بعضنا يأخذ مسيرتنا الفنّيّة على محمل الجدّ

23
00:02:58,750 --> 00:03:00,940
.يا لفظاعتها

24
00:03:03,330 --> 00:03:04,450
.هيّا بنا

25
00:03:09,370 --> 00:03:10,680
.حسنًا، إلى اللّقاء

26
00:03:11,160 --> 00:03:12,270
.ساتو

27
00:03:13,080 --> 00:03:14,170
ماذا؟

28
00:03:14,430 --> 00:03:17,380
،إن اضطررنا لترك أداء الأصوات

29
00:03:17,380 --> 00:03:19,860
هل تعتقدين أنّ كلّ يوم سيكون هكذا؟

30
00:03:19,860 --> 00:03:20,620
ماذا؟

31
00:03:20,960 --> 00:03:23,560
،إن توقّفت عن العمل لسنة ونصف

32
00:03:23,560 --> 00:03:26,540
.فسينسى الجميع من أكون

33
00:03:27,100 --> 00:03:33,200
لن يرغب بي أيّ أحد، ولن أستطيع
.العمل كمؤدّية أصوات

34
00:03:34,320 --> 00:03:38,520
عندما أتخيّل ذلك، أشعر بخوف
.شديد لا يمكنني تحمّله

35
00:03:39,110 --> 00:03:40,410
.إنّه يؤلم

36
00:03:40,410 --> 00:03:42,110
...يؤلم بشدّة

37
00:03:42,620 --> 00:03:46,580
.وكأنّ فراغًا عميقًا حالكَ الظّلمةِ يملأ صدري

38
00:03:47,230 --> 00:03:51,870
لم تكن لي أدنى فكرة أنّ خسارة رؤيتي
.للمستقبل قد تكون فظيع هكذا

39
00:03:52,350 --> 00:03:53,580
.أتفهّم ذلك

40
00:03:53,580 --> 00:03:56,810
.هذا ما كنتُ أشعر به طوال الوقت

41
00:03:56,810 --> 00:03:58,110
هل أدركتِ الأمر أخيرًا؟

42
00:03:58,450 --> 00:04:01,180
،كنتِ محبوبة جدًّا منذ بدايتك

43
00:04:01,180 --> 00:04:05,180
.أعتقد أنّك لم تشعري بأيّ شيء كهذا من قبل

44
00:04:06,020 --> 00:04:08,560
.شكرًا على دعوتي للخروج اليوم

45
00:04:08,560 --> 00:04:10,900
.حسّن ذلك من حالي قليلاً

46
00:04:11,240 --> 00:04:14,320
كيف أمكنني التّفكير بذلك...؟

47
00:04:15,750 --> 00:04:18,960
.لا شيء مؤكّد بخصوص توقّفنا عن العمل

48
00:04:19,350 --> 00:04:20,850
،أمامنا الكثير لنفكّر فيه

49
00:04:20,850 --> 00:04:23,860
.مثل كيفية إعلاننا عن اتّفاقنا وما شابه

50
00:04:24,140 --> 00:04:27,680
ولكن حتّى ذلك الحين، لنركّز فقط
.على العمل الّذي أمامنا الآن

51
00:04:30,410 --> 00:04:31,640
.معك حقّ

52
00:04:42,390 --> 00:04:44,390
!أنا جدّ سعيدة

53
00:04:44,390 --> 00:04:46,900
.معنويّاتك مرتفعة يا ني-سان

54
00:04:46,900 --> 00:04:48,620
!بالطّبع

55
00:04:48,620 --> 00:04:52,110
!لا يتسنّى لنا مقابلة المعجبين كلّ يوم

56
00:04:52,890 --> 00:04:55,560
.لا أطيق الانتظار حتّى ألتقي بهم

57
00:04:55,840 --> 00:04:58,370
...ني-سان، بريقك يُعمي

58
00:04:59,040 --> 00:05:00,110
.يوميكو

59
00:05:00,890 --> 00:05:03,110
.لا داعي للتّوتّر

60
00:05:03,110 --> 00:05:05,750
.قومي بما تفعلينه دائمًا، ما تفعلينه دائمًا فحسب

61
00:05:06,050 --> 00:05:08,940
!سـ-سنكون هنا أيضًا

62
00:05:08,940 --> 00:05:11,990
.لذلك لا داعي للقلق. التقيا بمعجبيكما

63
00:05:12,990 --> 00:05:16,000
.هذا أوّل حدث لنا بعد الحادثة

64
00:05:16,450 --> 00:05:20,080
هناك عاملون أكثر من المعتاد
.اليوم بالنّسبة لحدثِ لقاء كهذا

65
00:05:20,680 --> 00:05:23,950
ووجود أوتومي-نيسان كعامل جذب
.رئيسيّ كان استراتيجيًّا أيضًا

66
00:05:23,950 --> 00:05:27,890
إنّهم يأملون أنّ لا أحد سيقدّم تعليقًا دون المستوى

67
00:05:27,890 --> 00:05:30,150
.أمام ساكوراناميكي أوتومي

68
00:05:31,020 --> 00:05:33,390
.لكنّي ما زلت متوتّرة

69
00:05:33,390 --> 00:05:34,660
...إضافة لذلك

70
00:05:34,660 --> 00:05:35,820
.كاغاساكي-سان

71
00:05:36,140 --> 00:05:40,340
ألا تعتقدين أنّه علينا أن نرتدي
أزياء كما اعتدنا أن نفعل؟

72
00:05:40,340 --> 00:05:42,100
.لا أعتقد ذلك

73
00:05:42,100 --> 00:05:44,240
.هذه هي شخصيّتاكما الآن، لذلك لا بأس

74
00:05:44,780 --> 00:05:46,970
.أعتقد أنّك تبدين كما يجب أن تبدو يوميكو

75
00:05:48,490 --> 00:05:53,050
أعتقد أنّه إن كان علينا التّركيز على
.هذه الشّخصيّات، فهذا هو أفضل خيار

76
00:05:54,790 --> 00:05:57,670
!كا-كان حفلك قبل قليل مذهلاً

77
00:05:57,670 --> 00:05:59,170
حفلي؟

78
00:05:59,170 --> 00:06:00,600
أتيت لرؤيته؟

79
00:06:00,600 --> 00:06:02,370
.شكرًا لك! أسعدني هذا كثيرًا

80
00:06:02,370 --> 00:06:04,390
.استمتعت كثيرًا به

81
00:06:03,080 --> 00:06:05,840
.تسير الاستراتيجيّة كما خطّطنا تمامًا

82
00:06:05,840 --> 00:06:07,350
!أتمنّى لك حظًّا سعيدًا

83
00:06:07,350 --> 00:06:09,170
...شكرًا لك

84
00:06:10,260 --> 00:06:12,370
.أ-أنا أشجّعك

85
00:06:12,850 --> 00:06:14,240
.سأبذل جهدي

86
00:06:14,240 --> 00:06:16,140
...شكرًا على قدومكم اليوم

87
00:06:16,140 --> 00:06:18,980
!مهلاً، أتيت آخر مرّة أيضًا

88
00:06:18,980 --> 00:06:20,880
!أنا أذكرك، أذكرك

89
00:06:20,880 --> 00:06:21,890
!شكرًا جزيلاً

90
00:06:21,890 --> 00:06:23,720
.ا-العفو

91
00:06:23,720 --> 00:06:25,050
!تعال ثانية

92
00:06:27,760 --> 00:06:30,160
،أتصرّف على طبيعتي فحسب

93
00:06:30,160 --> 00:06:32,420
لذلك لماذا هذا صعب كثيرًا؟

94
00:06:32,790 --> 00:06:36,510
لا يتوقّع منّي أحد أن أكون مبتهجة
.على وجه الخصوص

95
00:06:36,970 --> 00:06:39,840
حتّى أنّي أستطيع معرفة مَن
...مِن المعجبين يريد ذلك

96
00:06:40,200 --> 00:06:43,400
لكن إن كنّا أنا وواتانابي نريد تنمية
،هاتين الشّخصيّتين

97
00:06:43,400 --> 00:06:44,660
.فلا يمكننا تغيير تصرّفاتنا

98
00:06:45,290 --> 00:06:49,070
لم تكن هذه مشكلة أبدًا
.لـ"أوتاتاني ياسومي" السّابقة

99
00:06:52,140 --> 00:06:53,680
!شكرًا على قدومك اليوم

100
00:06:54,610 --> 00:06:56,850
فتاة وحدها؟

101
00:06:56,850 --> 00:06:58,300
.هذا نادر

102
00:07:00,610 --> 00:07:02,240
!ساكو-تشان، أنا أحبّك

103
00:07:02,240 --> 00:07:03,810
!أحبّ برنامجك الإذاعيّ وأستمع له أسبوعيًّا

104
00:07:03,810 --> 00:07:05,600
،إن فزتُ بقرعة حضور التّسجيل الحيّ
!فسأكون هناك بكلّ تأكيد

105
00:07:05,600 --> 00:07:08,820
أعلم أنّك مشغولة جدًّا، لذلك فأنا
!أقدّر قيامك بالتّسجيلات الحيّة

106
00:07:08,820 --> 00:07:10,370
!سأحضر حفلك التّالي أيضًا

107
00:07:10,370 --> 00:07:12,720
!أنا أشجّعك! أحبّك! أنت حياتي

108
00:07:12,720 --> 00:07:15,360
!شكرًا على كلّ شيء

109
00:07:16,470 --> 00:07:17,750
!كم أسعدني هذا

110
00:07:17,750 --> 00:07:19,260
!شكرًا جزيلاً لك

111
00:07:21,370 --> 00:07:23,090
.شكرًا جزيلاً لك

112
00:07:23,780 --> 00:07:26,770
!أحبّ غناءك جدًّا! إنّه ممتاز
!إنّه كنز قوميّ

113
00:07:26,770 --> 00:07:29,780
وأداؤك الصّوتيّ مذهل للغاية
!ويأسرني دائمًا! إنّه الأفضل

114
00:07:29,780 --> 00:07:32,480
...هذه الفتاة شغوفة للغاية

115
00:07:32,480 --> 00:07:36,080
أنا مندهشة لأنّي أستطيع فهم ما
.تقوله مع أنّها تتحدّث بسرعة

116
00:07:36,590 --> 00:07:38,550
!حظًّا سعيدًا! أحبّك

117
00:07:41,700 --> 00:07:43,690
!شكرًا على قدومك

118
00:07:47,890 --> 00:07:50,660
!ياسو-ياسو، أنا جدّ سعيدة لأنّي التقيتك

119
00:07:50,660 --> 00:07:52,310
!"أحببتك منذ عملك في "بلاستيك غيرلز

120
00:07:52,310 --> 00:07:54,860
!كانت ماري-تشان المفضّلة عندي
!اشتريت الكثير من بضائعها

121
00:07:54,860 --> 00:07:56,400
!أحبّ غناءك أيضًا

122
00:07:56,400 --> 00:07:58,320
!أستمع لكلّ أغنيات شخصيّتك

123
00:07:58,320 --> 00:08:01,030
أنا جدّ سعيدة لأنّي استطعتُ
!سماعك مع تارت القلب

124
00:08:01,030 --> 00:08:03,930
!كان أداؤك ممتازًا في "تحت السّماء الأرجوانيّة" أيضًا

125
00:08:03,930 --> 00:08:05,290
!أنا أحبّك

126
00:08:05,290 --> 00:08:07,450
!شكرًا جزيلاً لك

127
00:08:07,450 --> 00:08:09,040
!أسعدني ذلك كثيرًا

128
00:08:10,680 --> 00:08:13,670
.أتمنّى أن تستمرّي في دعمي

129
00:08:13,960 --> 00:08:16,080
.تعالي لرؤيتي ثانية إن استطعت

130
00:08:16,770 --> 00:08:18,220
.سأكون في انتظارك

131
00:08:20,150 --> 00:08:22,930
...ياسو-ياسو، أنا أحبّك جدًّا

132
00:08:23,500 --> 00:08:24,600
...لكن

133
00:08:25,550 --> 00:08:31,160
أنا حزينة لأنّي لن أستطيع رؤية
.ياسو-ياسو القديمة ثانية

134
00:08:32,720 --> 00:08:34,360
!أ-أنا جدّ آسفة

135
00:08:34,360 --> 00:08:35,990
!لم أقصد قول ذلك

136
00:08:35,990 --> 00:08:37,000
!سـ-سأذهب الآن

137
00:08:37,000 --> 00:08:38,030
!مهلاً

138
00:08:38,030 --> 00:08:42,000
أقلتِ أنّك حزينة لأنّك لن تستطيعي رؤيتي؟

139
00:08:43,450 --> 00:08:46,190
.لا يمكنني تجاهل هذا

140
00:08:46,190 --> 00:08:48,750
.أشعر أنّي أوشك على القيام باكتشاف كبير هنا

141
00:08:49,010 --> 00:08:51,630
!عفوًا، لم أقصد ذلك

142
00:08:53,240 --> 00:08:54,720
.أنا جدّ آسفة

143
00:08:56,510 --> 00:08:58,770
يوبيساكي-سان؟

144
00:08:59,260 --> 00:09:01,000
!ا-اتركيني

145
00:09:01,000 --> 00:09:03,090
.أريد أن أسألك عن شيء ما فحسب

146
00:09:03,610 --> 00:09:07,050
هناك مقهى في الطّابق العلويّ
.لهذا المبنى. انتظرينا هناك رجاءً

147
00:09:07,050 --> 00:09:08,100
لماذا؟

148
00:09:08,100 --> 00:09:10,740
هل تريدين أن يعرف الجميع بهذا؟

149
00:09:13,450 --> 00:09:14,770
!أنا جدّ آسفة

150
00:09:14,770 --> 00:09:16,650
،أحببت قبّعتها كثيرًا

151
00:09:16,650 --> 00:09:18,340
.لذلك كنت أسألها عن العلامة التّجاريّة

152
00:09:22,490 --> 00:09:24,190
.لم أكن أتوقّع هذا

153
00:09:24,190 --> 00:09:24,960
.نعم

154
00:09:25,540 --> 00:09:28,780
.يوبيساكي-سان غارقة في دموعها

155
00:09:29,250 --> 00:09:30,040
...نعم

156
00:09:30,730 --> 00:09:33,030
لماذا تبكين هكذا؟

157
00:09:33,420 --> 00:09:35,180
!لأنّ هذا فظيع

158
00:09:35,180 --> 00:09:37,280
،لم أرد أن يعلم أيّ أحد

159
00:09:37,280 --> 00:09:39,830
!ومع ذلك أنت من اكتشفت الأمر

160
00:09:39,830 --> 00:09:41,580
!يا للخزي الّذي أنا فيه

161
00:09:41,580 --> 00:09:43,380
!أفضّل الموت

162
00:09:45,180 --> 00:09:48,940
إن توسّلتُ وتضرّعت، فهل ستسامحانني؟

163
00:09:48,940 --> 00:09:51,160
إن اعتذرتُ على كلّ شيء حتّى الآن

164
00:09:51,160 --> 00:09:54,520
،وتذلّلت عارية عند أقدامكما
فهل ستحفظان سرّي؟

165
00:09:54,520 --> 00:09:55,290
.مهلاً

166
00:09:55,290 --> 00:09:57,740
هل تعتقدين أنّنا وحوش؟

167
00:09:57,740 --> 00:09:59,150
.نعم

168
00:09:59,150 --> 00:10:01,840
.حسنًا إذًا، أرى أنّ التّذلّل عارية سيكون جيّدًا

169
00:10:02,210 --> 00:10:06,260
،ما زلتُ لا أعرف موقفي من هذا

170
00:10:06,260 --> 00:10:09,780
لكن هل أنت بالفعل من معجبينا؟

171
00:10:09,780 --> 00:10:12,950
.نعم. أحبّكما بشكل غير مثير للسّخريّة

172
00:10:12,950 --> 00:10:16,450
.هذا يفسّر لماذا عرفتِ كلّ شيء عنّا

173
00:10:16,450 --> 00:10:20,910
سررت كثيرًا عندما فزت بالقرعة
.لحدث اللّقاء احتفالاً بالإصدار

174
00:10:20,910 --> 00:10:23,700
.كان لديّ عمل، لكنّي استطعتُ الحضور بأعجوبة

175
00:10:23,700 --> 00:10:25,580
!مـ-مهلاً لحظة

176
00:10:25,580 --> 00:10:29,890
.لكنّك كنت غاضبة جدًّا علينا من قبل

177
00:10:29,890 --> 00:10:31,680
ما كان كلّ ذلك؟

178
00:10:31,680 --> 00:10:33,970
.ذلك صحيح بالكامل أيضًا

179
00:10:34,880 --> 00:10:36,990
،أنا من معجبيكما بالفعل

180
00:10:36,990 --> 00:10:38,790
.وصحيح أيضًا أنّني غاضبة

181
00:10:38,790 --> 00:10:42,410
،بصفتي زميلة أكبر لكما
.أجد تصرّفكما غير مقبول تمامًا

182
00:10:42,970 --> 00:10:45,110
.لذلك السّبب كان عليّ قول ما يدور في ذهني

183
00:10:45,110 --> 00:10:48,760
إضافة لذلك، كان من المزعج جدًّا
.أنّي اضطررت لتنظيف فوضاكما أيضًا

184
00:10:49,200 --> 00:10:51,810
بإمكانك فعلاً الفصل بين الأمرين؟

185
00:10:51,810 --> 00:10:55,540
،إنّك تحبّيننا كثيرًا في الحياة الحقيقيّة
ولكنّك تكرهيننا في العمل؟

186
00:10:55,540 --> 00:10:56,960
.أنت مثلي تمامًا

187
00:10:56,960 --> 00:11:00,170
،رغم أنّك لا تحبّين شريكتك
.إلاّ أنّك لا تسمحين بظهور ذلك عليك

188
00:11:00,170 --> 00:11:02,000
.الأمر هكذا، ولكنّه معكوس

189
00:11:02,490 --> 00:11:05,050
.لا أريد لعملي أن يتعدّى إلى حياة الخاصّة

190
00:11:05,050 --> 00:11:07,550
.أنا أكثر صرامة حيال ذلك من الكثيرين غيري

191
00:11:08,160 --> 00:11:11,150
لا تخفين شيئًا ما، صحيح؟

192
00:11:12,460 --> 00:11:15,940
أنا أفهم أنّك تريدين إبقاء
.حياتك الخاصّة والعمليّة منفصلتان

193
00:11:15,940 --> 00:11:17,850
.لكنّ هذا مبالغ فيه

194
00:11:17,850 --> 00:11:21,320
.تبدين وكأنّك تحاولين وضع جدار فاصل

195
00:11:20,120 --> 00:11:25,230
أنا من النّوع الّذي قرّر أن يصير مؤدّية
.أصوات لأنّي أحبّ مؤدّي الأصوات كثيرًا

196
00:11:25,230 --> 00:11:27,770
.أنا مجرّد معجبة مهووسة في أعماقي

197
00:11:27,770 --> 00:11:30,800
...في الحقيقة، ما زلت كذلك

198
00:11:31,720 --> 00:11:34,020
!لا أزال مجرّد معجبة في داخلي، مفهوم؟

199
00:11:34,020 --> 00:11:35,900
!أحبّكم جميعًا كثيرًا لدرجة أنّي لا أتحمّل ذلك

200
00:11:35,900 --> 00:11:38,580
هل تعتقدان فعلاً أنّ بإمكاني الحفاظ
!على هدوئي أثناء لقائكما شخصيًّا؟

201
00:11:38,900 --> 00:11:41,580
،لقد تحدّثتما معي بالفعل لأنّنا نعمل معًا

202
00:11:41,580 --> 00:11:42,600
!لكنّ ذلك أكثر ممّا أتحمّل

203
00:11:42,600 --> 00:11:45,360
!ما كنتُ لأستطيع التّحمّل لو لم أضع ذلك الجدار

204
00:11:48,450 --> 00:11:51,950
إذًا فأنت تحبّيننا بالفعل، صحيح يا ميكورو-تشان؟

205
00:11:51,950 --> 00:11:53,600
!لا تناديني ميكورو-تشان

206
00:11:54,100 --> 00:11:57,990
."أحببت ياسو-ياسو منذ "بلاستيك غيرلز

207
00:11:58,280 --> 00:12:00,470
.ماري-تشان كانت المفضّلة عندي على الإطلاق

208
00:12:00,470 --> 00:12:05,330
أحببت أداءك ومزجك لصوتك
.الحقيقيّ مع الشّخصيّة

209
00:12:05,770 --> 00:12:07,820
!كلاّ! أنا أموت

210
00:12:07,820 --> 00:12:09,690
!إنّك تحبّينني بالفعل؟

211
00:12:10,010 --> 00:12:11,960
!نعم

212
00:12:11,960 --> 00:12:14,020
.أنا أتابع كلّ حساباتك وبرنامجك الإذاعيّ

213
00:12:14,020 --> 00:12:15,100
.وأحضر كلّ احتفاليّاتك

214
00:12:15,100 --> 00:12:17,150
.حتّى أنّي ذهبت لحفل "بلاستيك غيرلز" أيضًا

215
00:12:17,150 --> 00:12:20,610
بعد أغنية ماري-تشان المنفردة، بكيت كثيرًا
.عند سماع جملة الشّهيرة على مكبّرات الصّوت

216
00:12:17,240 --> 00:12:20,300
إذًا فهي تحبّني بالفعل؟

217
00:12:20,610 --> 00:12:22,620
.أبكي أيضًا بمجرّد تذكّر ذلك

218
00:12:25,460 --> 00:12:26,960
"!مكانك"

219
00:12:26,960 --> 00:12:28,880
"!لن أتغاضى عن هذا أبدًا"

220
00:12:30,810 --> 00:12:32,700
!لا تفعلي هذا بي

221
00:12:32,700 --> 00:12:33,810
!هذه قسوة

222
00:12:33,810 --> 00:12:36,010
...ساتو، نحن هنا لسبب وجيه

223
00:12:36,010 --> 00:12:37,890
.صحيح

224
00:12:38,750 --> 00:12:42,220
.دعوتك إلى هنا لأنّ لديّ ما أسألك عنه

225
00:12:42,870 --> 00:12:45,610
،في حدث اللّقاء

226
00:12:45,610 --> 00:12:49,700
قلتِ أنّك حزينة لأنّك لن تري
.شخصيّتي القديمة بعد الآن

227
00:12:49,960 --> 00:12:51,870
.أريد معرفة ما قصدته بذلك

228
00:12:52,320 --> 00:12:54,540
.قصدتُ ما قلتُه تمامًا

229
00:12:55,720 --> 00:13:00,660
.أحببتك منذ بدايتك يا ياسو-ياسو
.وأنت أيضًا يا يوهيمي

230
00:13:01,000 --> 00:13:06,330
لكنّ ما جعلني أقع في حبّ أوتاتاني ياسومي
.هي الطّريقة الظّريفة والمبتهجة الّتي تحدّثت بها

231
00:13:06,330 --> 00:13:09,940
.وأحببت في يوغوري يوهي سلوكها اللّطيف والمهذّب

232
00:13:09,940 --> 00:13:11,480
.وذلك لا يشبه ما أنتما عليه الآن

233
00:13:11,840 --> 00:13:13,360
،لكن يا يوبيساكي-سان

234
00:13:13,360 --> 00:13:16,570
.لا بدّ أنّك رأيت شخصيّتي الحقيقيّة في المكتب

235
00:13:16,570 --> 00:13:19,990
ومع ذلك أحببتِ الشّخصيّة الّتي أدّيتُها؟

236
00:13:20,490 --> 00:13:22,830
من يهتمّ ما هي شخصيّتك الحقيقيّة؟

237
00:13:22,830 --> 00:13:27,060
إنّ كلّ مؤدّية أصوات تمثّل
.إلى درجة معيّنة أمام العموم

238
00:13:27,060 --> 00:13:28,430
.وأنا لستُ استثناءً

239
00:13:28,430 --> 00:13:31,240
لم أحبّك كنجمة وكالتنا الصّغيرة

240
00:13:31,240 --> 00:13:34,080
.بل كيوغوري يوهي الّتي رأيت على الشّاشة

241
00:13:35,330 --> 00:13:37,710
،بعد إشاعة الخدمات الجنسيّة تلك

242
00:13:37,710 --> 00:13:41,460
قرّرتما أن تتبنّيا شخصيّتاكما
.الحقيقيّتان منذ ذلك الوقت فصاعدًا

243
00:13:41,460 --> 00:13:45,340
،كان ذلك جيّدًا لبرنامجكما الإذاعيّ
.ووافقت عليه وكالتاكما

244
00:13:45,710 --> 00:13:48,650
.غيّرتما علامتكما التّجاريّة

245
00:13:48,650 --> 00:13:51,170
!ولكن... ما كان ذلك؟

246
00:13:51,470 --> 00:13:54,140
ماذا عن الأشخاص الّذين أحبّوكما
!كيفما كنتما في السّابق؟

247
00:13:54,140 --> 00:13:56,400
ماذا عن مشاعري؟

248
00:13:56,400 --> 00:13:59,220
!أعلم أنّكما تكيّفتما مع الوضع

249
00:13:59,220 --> 00:14:00,780
!لكنّ هذا لا يتعلّق بالمنطق

250
00:14:00,780 --> 00:14:03,780
اختفت اثنتان من أفضل مؤدّيات
،الأصوات عندي فجأة

251
00:14:03,780 --> 00:14:05,950
!وظهرت بدلهما شخصيّتان مختلفتان تمامًا

252
00:14:05,950 --> 00:14:08,980
!كيف لا أكون منزعجة من ذلك؟

253
00:14:08,980 --> 00:14:12,060
...كمؤدّية أصوات وكمعجبة

254
00:14:12,750 --> 00:14:15,370
.أكرهكما بشدّة

255
00:14:16,460 --> 00:14:19,870
.أعتقد أنّ هذا بالضّبط ما كان يقلقني

256
00:14:20,420 --> 00:14:23,010
هل يمكننا فعلاً البقاء هكذا؟

257
00:14:23,010 --> 00:14:25,690
هل قبول هذه الشّخصيّات الجديدة كافٍ؟

258
00:14:25,690 --> 00:14:33,260
كنّا نشكّك في أنفسنا لترك معجبين
مثل يوبيساكي-سان خلفنا

259
00:14:33,260 --> 00:14:35,340
.ممّن أحبّونا من قبل

260
00:14:42,640 --> 00:14:45,490
.آسفة على الاتّصال بك فجأة يا أساكا-تشان

261
00:14:45,490 --> 00:14:47,500
.لا بأس

262
00:14:47,500 --> 00:14:49,710
لكن ما هذه الخدمة الّتي تريدانها؟

263
00:14:49,710 --> 00:14:51,460
.نودّ تصوير فيديو

264
00:14:51,460 --> 00:14:55,210
.نريد إرسال رسالة لمعجبينا

265
00:14:55,210 --> 00:14:58,090
مثل ما فعلت سابقًا؟

266
00:14:58,090 --> 00:15:00,710
.انزعجت وكالتاكما من ذلك كثيرًا

267
00:15:00,710 --> 00:15:02,720
ربّما لا يجب عليكما فعل ذلك؟

268
00:15:02,720 --> 00:15:04,040
.سنكون بخير

269
00:15:04,040 --> 00:15:06,700
،لن يكون بثًّا مباشرًا هذه المرّة
.بل مجرّد فيديو

270
00:15:06,700 --> 00:15:11,300
.لن ننشره حتّى توافق عليه وكالتانا

271
00:15:11,640 --> 00:15:13,680
...في تلك الحالة

272
00:15:16,910 --> 00:15:18,480
.أنا يوغوري يوهي

273
00:15:18,480 --> 00:15:20,270
.وأنا أوتاتاني ياسومي

274
00:15:20,270 --> 00:15:27,130
إنّنا نصوّر هذا الفيديو لأنّنا أردنا
.التّواصل مع معجبينا القدامى

275
00:15:27,940 --> 00:15:30,820
...مؤخّرًا، قالت لنا معجبة سابقة

276
00:15:30,820 --> 00:15:33,660
،أنّها أحبّت ما كنّا عليه من قبل

277
00:15:33,660 --> 00:15:35,650
.وليس ما نحن عليه الآن

278
00:15:35,650 --> 00:15:37,370
،وأنّها عندما ترانا الآن

279
00:15:37,370 --> 00:15:40,820
فإنّ ذلك يحزنها لأنّها تشعر
.أنّ شخصيّتانا القديمتين قد رحلتا

280
00:15:40,820 --> 00:15:43,600
.لم نفكّر في الأمر مليًّا

281
00:15:44,280 --> 00:15:48,650
أعتقد أنّنا آذينا بعض معجبينا
.الّذين دعمونا لوقت طويل

282
00:15:48,650 --> 00:15:52,450
،رغم أنّكم كنتم تدعموننا منذ مدّة
.تصرّفنا وكأنّ ذلك لا يعني شيئًا

283
00:15:53,030 --> 00:15:55,410
.إنّنا آسفتان جدًّا على ذلك

284
00:15:56,600 --> 00:16:02,430
والسّبب الثّاني من هذا الفيديو
.هو أنّ لدينا شيئًا آخر نودّ إطلاعكم عليه

285
00:16:04,370 --> 00:16:08,580
،ستسيران من هنا إلى المحطّة
.وستعبران شارع التّسوّق

286
00:16:08,890 --> 00:16:13,800
،إن لم يتحدّث معكم أيّ أحد
.فستفوزان، ولن أفتح الموضوع ثانية

287
00:16:14,190 --> 00:16:19,340
.وإلاّ، ستتوقّفان عن العمل حتّى تتخرّجان

288
00:16:19,340 --> 00:16:20,570
.لا بأس

289
00:16:24,690 --> 00:16:27,320
.لا بدّ أنّهم هنا بسبب الفيديو

290
00:16:28,460 --> 00:16:31,360
.أعلم سلفًا كيف سينتهي هذا

291
00:16:31,360 --> 00:16:33,330
...تشيكا، إن حاولت أن

292
00:16:33,330 --> 00:16:34,850
.لنذهب بسرعة

293
00:16:34,850 --> 00:16:36,340
.نحن نضيّع الوقت

294
00:16:36,340 --> 00:16:38,820
.سأتبعكما وأراقبك إذًا

295
00:16:40,370 --> 00:16:45,980
أعلم أنّ طلب المسامحة منكم
.جميعًا هو أكثر ممّا نستحقّه

296
00:16:48,170 --> 00:16:50,580
،ربّما قد يكون هذا أنانيّة منّي

297
00:16:50,580 --> 00:16:54,350
.لكنّي أريد مواجهة كلّ من دعمونا

298
00:16:55,130 --> 00:16:59,050
.لكن بعدما حان وقت هذا، أشعر بخوف شديد

299
00:16:59,780 --> 00:17:02,290
.لا أريد أن نتوقّف عن العمل

300
00:17:04,120 --> 00:17:05,660
وا-واتانابي؟

301
00:17:05,660 --> 00:17:09,890
.إن كنتِ قلقة، انظري إليّ وأنا إلى جانبك فحسب

302
00:17:09,890 --> 00:17:13,720
،عندما تدركين أنّك لست وحدك
.تصير الأمور أسهل بكثير

303
00:17:16,630 --> 00:17:20,340
،عندما تدركين أنّك لست وحدك
.تصير الأمور أسهل بكثير

304
00:17:20,630 --> 00:17:23,850
يمكن الاعتماد عليّ بما يكفي، صحيح؟

305
00:17:25,210 --> 00:17:26,670
.صحيح

306
00:17:26,670 --> 00:17:30,130
.لديّ يوغوري يوهي إلى جانبي

307
00:17:30,130 --> 00:17:32,180
.أشعر بتحسّن أكبر بالتّفكير بالأمر كذلك

308
00:17:32,650 --> 00:17:36,280
.أكره هذا الجانب فيك جدًّا

309
00:17:50,680 --> 00:17:52,920
،ظننتُ أنّ هذا سينتهي في الحال

310
00:17:53,530 --> 00:17:57,720
...لكن ربّما كلّ هؤلاء الأشخاص هنا للمشاهدة

311
00:17:58,180 --> 00:18:01,060
،في تلك الحالة

312
00:18:01,060 --> 00:18:04,140
...ربّما بإمكاننا الخروج من هنا سالمتان

313
00:18:10,580 --> 00:18:13,520
الـ-المعذرة! هل يمكنك أن توجّهني لمكان ما؟

314
00:18:13,520 --> 00:18:14,330
ماذا؟

315
00:18:14,330 --> 00:18:15,650
.أنا مشغول الآن

316
00:18:15,650 --> 00:18:16,750
!أحتاج مساعدتك كثيرًا

317
00:18:16,750 --> 00:18:18,530
.عليّ القيام بهذا الآن

318
00:18:18,530 --> 00:18:20,180
!وكذلك أنا

319
00:18:20,180 --> 00:18:21,920
!هل تحاول الدّفاع عنهما؟

320
00:18:22,360 --> 00:18:24,130
!لقد كانتا تخدعاننا

321
00:18:24,130 --> 00:18:25,080
لا تمانع ذلك؟

322
00:18:25,080 --> 00:18:26,220
!لا تمانع ذلك على الإطلاق؟

323
00:18:26,220 --> 00:18:27,960
!لذلك سأقول ما أظنّه فحسب

324
00:18:27,960 --> 00:18:31,120
،وإن عنى ذلك اعتزالهما
!فستكونان تحصدان ما زرعتا فحسب

325
00:18:31,120 --> 00:18:32,750
!لا أوافق على ذلك أبدًا

326
00:18:32,750 --> 00:18:34,840
!أحببت يوهيمي كثيرًا

327
00:18:34,840 --> 00:18:36,630
لماذا إذًا تحاول إيقافي؟

328
00:18:36,630 --> 00:18:40,050
!لأنّي... لأنّي ما زلت أحبّها

329
00:18:40,050 --> 00:18:42,180
!أريد أن أواصل دعمها

330
00:18:42,180 --> 00:18:44,570
!لا أريدها أن تختفي من السّاحة

331
00:18:45,320 --> 00:18:46,960
!واصلا السّير بسرعة رجاءً

332
00:18:47,340 --> 00:18:50,380
!حسنًا! إن كان لم يتحدّث، فسأتحدّث أنا

333
00:18:49,600 --> 00:18:51,590
!لن أسمح لك بالتّقدّم

334
00:18:52,150 --> 00:18:53,950
!تـ-توقّف رجاءً

335
00:18:53,950 --> 00:18:55,360
.ابتعدي عن طريقي

336
00:18:55,360 --> 00:18:57,960
!ياسو-ياسو الّتي أحببت كانت مزيّفة

337
00:18:57,960 --> 00:19:00,060
!لن أسامحها أبدًا

338
00:19:00,060 --> 00:19:04,240
.أحزنتني معرفة أنّ ياسو-ياسو كذبت علينا أيضًا

339
00:19:04,240 --> 00:19:07,480
!لكنّي لا أريدها أن تتوقّف عن العمل

340
00:19:07,480 --> 00:19:09,400
،حتّى عندما كانت تحدث أمور سيّئة في المدرسة

341
00:19:09,400 --> 00:19:12,200
.كان سماع صوت ياسو-ياسو يبهجني دائمًا

342
00:19:12,200 --> 00:19:14,420
!ساعدتني على تجاوز أوقات صعبة

343
00:19:14,420 --> 00:19:16,630
!واصلا فحسب

344
00:19:17,080 --> 00:19:18,980
!لا-لا تتوقّفا

345
00:19:19,300 --> 00:19:22,370
!مهما حدث، لا تتوقّفا عن أداء الأصوات

346
00:19:23,090 --> 00:19:24,870
!أنا أكلّم نفسي فحسب

347
00:19:24,870 --> 00:19:26,820
،أنا لا أحبّ ما أنتما عليه الآن

348
00:19:26,820 --> 00:19:29,810
!لكن ما زلت لا أريد أن تتوقّفا عن أداء الأصوات

