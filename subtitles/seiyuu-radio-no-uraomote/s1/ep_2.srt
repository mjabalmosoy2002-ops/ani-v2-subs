ترتيب
متدنّي

207
00:11:24,950 --> 00:11:29,660
التّرتيب
الأعلى

208
00:11:24,950 --> 00:11:29,660
ترتيب
مرتفع

209
00:11:25,340 --> 00:11:27,190
،في السّنوات الثّلاثة الأولى

210
00:11:27,190 --> 00:11:29,670
يمكن الحصول على عمل
.بسهولة بسبب الرّسوم المنخفضة

211
00:11:29,910 --> 00:11:33,180
لديّ سنة واحد أخرى قبل
.أن أفقد تلك الميزة

212
00:11:35,120 --> 00:11:37,260
.سيكون عليّ بذل جهدي

213
00:11:47,550 --> 00:11:48,810
.صباح الخير

214
00:11:50,080 --> 00:11:53,430
لماذا ترتدين زيّك المدرسيّ يوم الأحد؟

215
00:11:54,010 --> 00:11:55,960
.لأنّ هذا يترك انطباعًا

216
00:11:55,960 --> 00:11:57,900
،سيتمّ تذكّري أكثر هكذا

217
00:11:57,900 --> 00:11:59,870
.كما يساعد على بدأ المحادثات

218
00:11:59,870 --> 00:12:01,200
.هكذا إذًا

219
00:12:10,920 --> 00:12:12,660
.سررت بلقائكنّ

220
00:12:12,660 --> 00:12:14,320
!سررنا بلقائك

221
00:12:15,750 --> 00:12:17,800
.سررت بلقائكنّ

222
00:12:17,800 --> 00:12:19,410
!سررنا بلقائك

223
00:12:20,910 --> 00:12:23,870
.مهلاً، عليك الجلوس هنا

224
00:12:23,870 --> 00:12:27,380
.لا، يجلس هناك من لديهم الكثير من الجُمل

225
00:12:27,380 --> 00:12:29,810
.أنت لديك الكثير من الجُمل

226
00:12:30,120 --> 00:12:33,010
.نعم، هذا صحيح

227
00:12:36,270 --> 00:12:38,130
.صباح الخير

228
00:12:38,770 --> 00:12:40,480
!صباح الخير

229
00:12:40,480 --> 00:12:41,810
!أوتومي-نيسان

230
00:12:42,460 --> 00:12:43,960
!صباح الخير يا ياسومي-تشان

231
00:12:43,960 --> 00:12:45,730
.مرّ وقت طويل مذ عملنا معًا

232
00:12:46,050 --> 00:12:48,000
!نعم، معك حقّ

233
00:12:48,000 --> 00:12:51,000
.لم نرَ بعضنا حتّى أثناء تسجيل الألبوم أيضًا

234
00:12:51,000 --> 00:12:53,200
لكن بما أنّه ستكون هنالك
،احتفاليّات وما إلى ذلك

235
00:12:53,200 --> 00:12:55,740
.فسنرى بعضنا كثيرًا

236
00:12:55,740 --> 00:12:56,780
.كم يسعدني هذا

237
00:12:56,780 --> 00:12:58,520
!وأنا أيضًا، وأنا أيضًا

238
00:12:58,520 --> 00:13:00,700
—اسمعي، هل نذهب إلى

239
00:13:00,700 --> 00:13:03,480
هل أتخيّل أم أنّك تبدين متعبة؟

240
00:13:03,480 --> 00:13:05,860
هل تعملين كثيرًا؟

241
00:13:05,860 --> 00:13:08,810
.لا، لم أنم جيّدًا فحسب

242
00:13:08,810 --> 00:13:10,210
.أنا بخير، أنا بخير

243
00:13:10,550 --> 00:13:13,120
.ساكوراناميكي-سان، سررت بلقائك

244
00:13:13,120 --> 00:13:14,940
يوهي-تشان! كيف حالك؟

245
00:13:15,210 --> 00:13:18,100
عفوًا، هل تعرفان بعضكما؟

246
00:13:18,100 --> 00:13:22,270
صحيح. إنّنا نعمل على مشاريع
.كثيرًا معًا هذه الأيّام

247
00:13:23,710 --> 00:13:25,120
.هكذا إذًا

248
00:13:25,400 --> 00:13:29,960
لكنّي متحمّسة جدًّا لأنّ زميلتَيّ الأصغر
.ستؤدّيان أصوات أختيّ الصّغيرتين

249
00:13:29,960 --> 00:13:32,160
.أمّا أنا فتراودني مشاعر مختلطة

250
00:13:32,160 --> 00:13:35,600
أعني كيف تكون هذه الفتاة العاديّة أختًا أكبر؟

251
00:13:35,600 --> 00:13:38,140
.يا إلهي، من النّادر أن نتشارك نفس الرّأي

252
00:13:38,140 --> 00:13:40,910
.لا أهتمّ لكونك أختًا أصغر أيضًا

253
00:13:41,170 --> 00:13:42,450
...أيّتها الـ

254
00:13:44,500 --> 00:13:48,200
!هارو-تشان! أوني-تشان
!هذا هو حالك دائمًا

255
00:13:48,200 --> 00:13:51,720
!تواجهين الأمور بالضّحك فحسب كلّ مرّة

256
00:13:51,720 --> 00:13:53,840
!تأخذين كلّ ما هو جيّد

257
00:13:53,840 --> 00:13:56,740
!وتتركيني عالقة مع كلّ هذه البقايا

258
00:13:57,010 --> 00:13:59,670
...اكتفيت

259
00:13:59,670 --> 00:14:02,930
لماذا عليك أن تكوني أختي الكبرى؟

260
00:14:02,930 --> 00:14:05,650
...نعم، معك حقّ

261
00:14:05,650 --> 00:14:07,960
لماذا وُلدتُ كأخت كبرى؟

262
00:14:15,860 --> 00:14:17,550
.أحسنتنّ عملاً

263
00:14:17,550 --> 00:14:19,220
!شكرًا جزيلاً

264
00:14:19,490 --> 00:14:21,010
!أحسنتنّ عملاً

265
00:14:21,570 --> 00:14:24,260
!المعذرة، ليس لديّ وقت وعليّ المغادرة

266
00:14:26,050 --> 00:14:28,480
.كان ذلك تمثيلاً ممتازًا

267
00:14:29,040 --> 00:14:31,710
تقصدين أوتومي-نيسان؟

268
00:14:31,710 --> 00:14:34,500
إنّها ممتازة، صحيح؟

269
00:14:34,500 --> 00:14:36,380
.إنّها مذهل ببساطة

270
00:14:36,890 --> 00:14:39,400
.لستُ بارعة مثلها

271
00:14:39,400 --> 00:14:43,370
أتمنّى لو يمكنني تقديم عرض مثل
.أوتومي-نيسان بدل البكاء المزيّف

272
00:14:43,910 --> 00:14:45,980
...أو مثل واتانابي

273
00:14:47,220 --> 00:14:52,930
يا إلهي، كنت متحمّسة كثيرًا
.لحصولي على دور كبير ثانية

274
00:14:52,930 --> 00:14:55,090
.لكنّ أدائي كان متوسّطًا بالكامل

275
00:14:56,500 --> 00:14:57,690
.ساتو

276
00:14:58,380 --> 00:15:01,880
.أكره هذا فيك بشدّة

277
00:15:02,260 --> 00:15:03,210
ماذا؟

278
00:15:09,620 --> 00:15:14,110
.ما أقوله هو أنّ أداءك كان جيّدًا

279
00:15:16,350 --> 00:15:18,720
آسفة، هلاّ كرّرت ذلك؟

280
00:15:19,810 --> 00:15:21,440
.لن أكرّر ما قلتُه أبدًا

281
00:15:24,480 --> 00:15:27,420
!رجاءً يا أوني-تشان

282
00:15:27,420 --> 00:15:28,730
.توقّفي

283
00:15:28,730 --> 00:15:30,760
.لا أريد أن أخسر في مواجهة واتانابي

284
00:15:31,390 --> 00:15:32,530
!أريد اللّحاق بها

285
00:15:33,160 --> 00:15:38,870
تارت القلب
،"أداء الأغنية الرّئيسيّة للأنمي التّلفزيّ "تحت السّماء الأرجوانيّة
أغنيتهنّ الفرديّة الأولى الحبّ المرتجف

286
00:15:33,480 --> 00:15:35,960
،إن كان لديّ وقت للتّكفير في أشياء تافهة

287
00:15:35,960 --> 00:15:38,300
!فعليّ التّركيز أكثر على ما يمكنني تغييره

288
00:15:40,370 --> 00:15:41,800
،وهكذا

289
00:15:41,800 --> 00:15:46,840
شكّلنا نحن الثّلاثة، أوتاتاني ياسومي
،ويوهيرو يوهي وساكوراناميكي أوتومي

290
00:15:46,840 --> 00:15:49,430
!"مجموعة تدعى "تارت القلب

291
00:15:49,420 --> 00:15:55,640
سيُعرض في الثّامن من أكتوبر

292
00:15:49,420 --> 00:15:55,640
تحت السّماء
الأرجوانيّة

293
00:15:49,420 --> 00:15:55,640
تارت القلب
،"أداء الأغنية الرّئيسيّة للأنمي التّلفزيّ "تحت السّماء الأرجوانيّة
أغنيتهنّ الفرديّة الأولى الحبّ المرتجف

294
00:15:49,690 --> 00:15:52,070
،"أغنيتنا المنفردة الأولى "الحبّ المرتجف

295
00:15:52,070 --> 00:15:55,630
ستكون أغنية البداية للأنمي التّلفزيّ
،"تحت السّماء الأرجوانيّة"

296
00:15:55,630 --> 00:15:58,730
،الّذي سيُعرض هذا الخريف
!فاحرصوا على متابعته

297
00:15:55,640 --> 00:16:00,140
الحبّ المرتجف

298
00:15:55,640 --> 00:16:00,140
تارت القلب

299
00:15:55,640 --> 00:16:00,140
إصدار خاصّ نسخة أ

300
00:15:55,640 --> 00:16:00,140
إصدار خاصّ نسخة ب

301
00:15:55,640 --> 00:16:00,140
إصدار عاديّ

302
00:15:58,730 --> 00:16:00,150
وهل تصدّقون هذا؟

303
00:16:00,150 --> 00:16:03,810
يمكننا أيضًا أنّ نؤكّد
!أنّه ستُقام احتفاليّة للألبوم

304
00:16:03,810 --> 00:16:06,870
!مرحى! تصفيق، تصفيق، تصفيق

305
00:16:09,200 --> 00:16:12,300
أتكرهين الأداء معي لهذا الحدّ؟

306
00:16:12,700 --> 00:16:14,990
.لا، الأمر ليس كذلك

307
00:16:16,670 --> 00:16:20,360
.بالطّبع أكره التّواجد معك

308
00:16:20,360 --> 00:16:21,030
.عيب

309
00:16:21,030 --> 00:16:23,950
.لكنّي لا أحبّ مثل هذه الاحتفاليّات

310
00:16:23,950 --> 00:16:26,880
...الغناء والرّقص أمام النّاس

311
00:16:26,880 --> 00:16:28,070
.صحيح

312
00:16:28,070 --> 00:16:32,290
أنت من تكرهين نفسك لعملك
.كمعبودة جماهير مؤدّية للأصوات

313
00:16:32,750 --> 00:16:35,920
.إنّه ليس أداءَ أصواتٍ حقيقيّ

314
00:16:36,640 --> 00:16:39,120
.ما قلتِه الآن أمر غير مقبول بتاتًا

315
00:16:40,240 --> 00:16:44,480
،نحن هنا بفضل ذلك النّوع من العمل

316
00:16:44,480 --> 00:16:47,310
.وهنالك أشخاص يدعمون ما نقوم به

317
00:16:47,670 --> 00:16:50,070
.لن أسمح لك بالتّقليل من شأن ذلك

318
00:16:51,050 --> 00:16:57,120
إضافة لهذا، أظنّ أنّه من الرّائع
.جعل كلّ هؤلاء النّاس متحمّسين

319
00:16:57,120 --> 00:17:00,570
كما أنّ لديّ الكثير من معبودي
.الجماهير قبلي أتطلّع إليهم

320
00:17:00,570 --> 00:17:04,040
،إن أشرتِ لهم وأخبرتهم أنّ ذلك ليس حقيقيًّا

321
00:17:04,670 --> 00:17:06,550
.فسأكرهك من أعماق قلبي

322
00:17:08,810 --> 00:17:11,710
.آسفة. تجاوزت حدودي

323
00:17:12,140 --> 00:17:15,520
هل تحبّين عملك كمعبودة جماهير
مؤدّية للأصوات؟

324
00:17:16,380 --> 00:17:17,810
.نعم، أحبه

325
00:17:18,160 --> 00:17:20,000
.أحبّ الغناء والرّقص أيضًا

326
00:17:25,080 --> 00:17:26,680
!حسنًا

327
00:17:26,680 --> 00:17:28,400
.كان ذلك جيّدًا

328
00:17:28,670 --> 00:17:31,020
هلاّ نزلتنّ للحظة رجاءً؟

329
00:17:33,510 --> 00:17:37,900
.أوتومي-نيسان، كانت حركاتك ممتازة كالمعتاد

330
00:17:44,190 --> 00:17:45,540
أوتومي-نيسان؟

331
00:17:50,070 --> 00:17:51,330
!ني-سان

332
00:17:54,590 --> 00:17:57,520
.هذا ليس جيّدًا يا ساكوراناميكي-سان

333
00:17:57,880 --> 00:18:01,110
عليك الاعتذار عن هذه الاحتفاليّة
.والذّهاب للمستشفى

334
00:18:01,110 --> 00:18:03,760
!أنا بخير أيّها المخرج

335
00:18:03,760 --> 00:18:05,400
!انظر. يمكنني القيام بهذا

336
00:18:06,330 --> 00:18:07,550
!ني-سان

337
00:18:08,380 --> 00:18:10,350
.ليس عليك العمل بالفعل

338
00:18:10,350 --> 00:18:13,260
...هذا مؤسف بالنّسبة للاحتفاليّة، ولكن

339
00:18:13,260 --> 00:18:15,270
.مهلاً يا ياسومي-تشان

340
00:18:15,270 --> 00:18:16,810
.ما زال بإمكاني فعل هذا

341
00:18:17,900 --> 00:18:19,610
تفهمين، صحيح؟

342
00:18:19,610 --> 00:18:21,820
.معجبِيّ في انتظاري هناك

343
00:18:21,820 --> 00:18:26,010
أيمكنك المغادرة ببساطة إن كنت مكاني؟

344
00:18:31,340 --> 00:18:36,770
أسيكون من الممكن لها القيام بفقرة
الحديث مع الجمهور على الأقلّ؟

345
00:18:37,170 --> 00:18:38,460
...لا أدري

346
00:18:38,460 --> 00:18:41,410
.أطلب منك رجاءً إعادة التّفكير أيضًا

347
00:18:41,410 --> 00:18:42,300
.رجاءً

348
00:18:43,860 --> 00:18:47,990
...شكرًا لكما يا ياسومي-تشان ويوهي-تشان

349
00:18:49,320 --> 00:18:51,360
تفهمين، صحيح يا واتانابي؟

350
00:18:51,660 --> 00:18:54,720
...معظم الضّيوف في هذه الاحتفاليّة

351
00:18:54,720 --> 00:18:56,940
.موجودون هنا لأجل ساكوراناميكي-سان

352
00:18:56,940 --> 00:18:58,720
.أنا مدركة تمامًا

353
00:18:58,720 --> 00:19:01,920
.سأقدّم أداءً ممتازًا حتّى بدونها

354
00:19:02,380 --> 00:19:05,800
.أنا مؤدّية أصوات أيضًا. أنا محترفة

355
00:19:06,090 --> 00:19:08,450
.من واجبي التّرفيه عنهم

356
00:19:09,360 --> 00:19:11,490
ألا تشعرين كذلك أيضًا؟

357
00:19:12,430 --> 00:19:13,920
...يا لك من

358
00:19:14,510 --> 00:19:17,610
.لن أتساهل. سأقدّم كلّ جهدي أيضًا

359
00:19:17,610 --> 00:19:19,120
.أرني ما لديك

360
00:19:29,120 --> 00:19:31,010
!ياسو-سايو

361
00:19:35,090 --> 00:19:36,730
!يوهيمي

362
00:19:43,350 --> 00:19:45,420
!ساكورا-تشان

363
00:19:49,880 --> 00:19:51,440
!مرحبًا

364
00:19:51,440 --> 00:19:53,800
!نحن تارت القلب

365
00:20:03,730 --> 00:20:07,600
.في البداية، أنا مدينة لكم باعتذار

366
00:20:19,930 --> 00:20:22,450
.أنا بخير. فعلاً بخير

367
00:20:22,450 --> 00:20:26,180
.أنا الآن أرقص مع يوغوري يوهي

368
00:20:29,000 --> 00:20:31,530
.سوف ننجح بكلّ تأكيد

369
00:20:32,270 --> 00:20:33,840
.هذا حفل ممتاز

370
00:20:33,840 --> 00:20:35,940
.الجمهور متحمّس بالكامل

371
00:20:40,990 --> 00:20:45,300
ولكن بسبب كونهم صريحين
،جدًّا بشأن شغفهم

372
00:20:45,300 --> 00:20:46,680
...بإمكاني الشّعور به

373
00:20:53,990 --> 00:20:57,370
...إحساس خيبة الأمل

374
00:20:57,370 --> 00:21:01,950
لأنّهم أتوا لسماع ساكوراناميكي
.أوتومي، ولم يستطيعوا ذلك

375
00:21:05,790 --> 00:21:09,790
.ساتو... آسفة لتوريطك في هذا

376
00:21:09,790 --> 00:21:15,350
.تفاخرتُ وتملّقتك وانظري ما النّتيجة

377
00:21:15,950 --> 00:21:18,160
.أكاد أموت من الإحراج

378
00:21:18,460 --> 00:21:20,680
.لديّ اعتذار أيضًا

379
00:21:21,190 --> 00:21:22,820
.لم أكن جيّدة بما يكفي

380
00:21:22,820 --> 00:21:26,130
.وبالطّبع لم تكوني جيّدة كفاية أيضًا

381
00:21:27,160 --> 00:21:29,240
.لا تعتذري رجاءً

382
00:21:30,830 --> 00:21:35,300
أريد أن أصير مؤدّية أصوات
!مذهلة مثل أوتومي-نيسان

383
00:21:35,300 --> 00:21:37,640
.لا، بل أفضل حتّى منها

384
00:21:38,050 --> 00:21:39,030
...يومًا ما

385
00:21:39,640 --> 00:21:41,590
سأعمل وأعمل بجدّ

386
00:21:41,590 --> 00:21:44,610
.وأصير بارعة في كلّ هذه الأشياء

387
00:21:44,870 --> 00:21:46,990
.لنسع لتجاوز أوتومي-نيسان

388
00:21:46,990 --> 00:21:49,010
.بكلّ جدّيّة هذه المرّة

389
00:21:52,080 --> 00:21:53,610
.بالطّبع

390
00:21:53,610 --> 00:21:55,790
.لن أسمح لهذا أن يكون النّهاية

391
00:21:56,080 --> 00:21:57,520
.سنبدأ من جديد

392
00:21:57,520 --> 00:21:59,700
.ابتداءً من اليوم، لنا بداية جديدة

393
00:22:00,650 --> 00:22:02,940
.أنا وأنت

394
00:23:35,060 --> 00:23:40,010
‫#03 يوهي وياسومي وحفل مبيت و

395
00:23:36,660 --> 00:23:39,060
!"يوهي وياسومي وحفل مبيت و"