1
00:00:01,850 --> 00:00:03,770
...تانجيرو

2
00:00:11,610 --> 00:00:14,820
.هنالك شيء عليك قطعه

3
00:00:25,120 --> 00:00:26,960
...هنالك شيء

4
00:00:28,170 --> 00:00:29,460
.عليّ قطعه

5
00:00:31,300 --> 00:00:32,920
...هنالك شيء عليّ قطعه

6
00:00:33,340 --> 00:00:34,970
!لأستيقظ

7
00:00:36,640 --> 00:00:38,300
.أظنّني أعلم ما هو

8
00:00:43,390 --> 00:00:45,480
!لا تتردّد! قم بذلك

9
00:00:45,850 --> 00:00:47,100
!بإمكانك القيام بذلك

10
00:00:47,350 --> 00:00:50,400
!موتي في هذا الحلم سيقودني لواقعي

11
00:00:50,400 --> 00:00:51,690
...بتعبير آخر

12
00:00:53,030 --> 00:00:54,820
...ما عليّ قطعه

13
00:00:57,360 --> 00:00:59,830
!هو عنقي

14
00:01:13,130 --> 00:01:16,630
.لا بدّ أنّكم تجسيد روح هذا الفتى

15
00:01:20,180 --> 00:01:23,390
.الهواء هنا نقيّ جدًّا، ومطمئن

16
00:01:30,940 --> 00:01:36,400
أهذا هو جوهره الرّوحيّ؟
لماذا أرشدتموني إليه؟

17
00:01:40,530 --> 00:01:44,790
هل أحضرتموني إلى هنا لأنّني كنت أبحث عنه؟

18
00:01:50,250 --> 00:01:51,880
!مستحيل

19
00:01:52,500 --> 00:01:55,380
رغم أنّني كنت أنوي تدميره؟

20
00:01:56,010 --> 00:01:57,680
...لماذا قد

21
00:03:58,170 --> 00:04:01,800
أين يوجد جوهره الرّوحيّ؟

22
00:04:03,340 --> 00:04:07,300
ما قصّة هذا النّطاق من اللاّوعي؟

23
00:04:08,810 --> 00:04:12,560
...وذلك الخنزير البرّيّ العاري المريب

24
00:04:12,890 --> 00:04:15,480
.هذا جنونيّ بكلّ المقاييس

25
00:04:21,440 --> 00:04:23,900
ما الّذي تفعله في نطاق اللاّوعي؟

26
00:04:23,900 --> 00:04:26,570
!يا لك من خنزير برّيّ عار غبيّ

27
00:04:37,590 --> 00:04:39,340
.الظّلام حالك

28
00:04:40,920 --> 00:04:45,090
.الظّلام حالك ولا يمكنني رؤية أيّ شيء. سُحقًا

29
00:04:45,090 --> 00:04:48,850
ما قصّة نطاق اللاّوعي الخاصّ بذلك الأشقر؟

30
00:04:49,310 --> 00:04:54,020
هل سيكون عليّ تحسّس المكان بحثًا
عن جوهره الرّوحيّ؟

31
00:04:54,350 --> 00:04:56,100
.هذا لا يعقل

32
00:04:58,770 --> 00:04:59,820
ما كان ذلك؟

33
00:05:09,990 --> 00:05:14,040
!ما الّذي يفعله رجل هنا؟ تبًّا لك أيّها المتطفّل

34
00:05:14,370 --> 00:05:17,790
.لا يسمح بأيّ أحد هنا سوى نيزوكو

35
00:05:20,000 --> 00:05:21,750
.سوف أقتلك

36
00:05:23,840 --> 00:05:25,550
أين نيزوكو؟

37
00:05:25,550 --> 00:05:27,050
و-وما أدراني؟

38
00:05:27,050 --> 00:05:30,050
!حسنًا، الموت... لك

39
00:05:33,270 --> 00:05:36,730
!كلاّ

40
00:05:50,570 --> 00:05:51,950
...استيقظ

41
00:05:52,790 --> 00:05:54,370
...عليّ أن أستيقظ

42
00:05:54,790 --> 00:05:56,120
!بسرعة

43
00:06:06,800 --> 00:06:09,720
!نيزوكو

44
00:06:28,070 --> 00:06:30,780
.أنا بخير. أنا حيّ

45
00:06:35,660 --> 00:06:37,330
نيزوكو! هل أنت بخير؟

46
00:06:40,460 --> 00:06:41,880
...نيزوكو

47
00:06:43,540 --> 00:06:44,960
...زنيتسو

48
00:06:45,460 --> 00:06:46,760
...إينوسكي

49
00:06:47,260 --> 00:06:48,670
...رنغوكو-سان

50
00:06:52,720 --> 00:06:54,850
من هؤلاء الأشخاص؟

51
00:06:55,430 --> 00:06:58,350
.جميعهم متّصلون بحبال حول المعصم

52
00:06:59,440 --> 00:07:01,020
...حبل

53
00:07:03,400 --> 00:07:04,690
ما هذا؟

54
00:07:04,980 --> 00:07:06,400
.لقد احترق

55
00:07:06,730 --> 00:07:08,860
أهذا من صنيع دماء نيزوكو المحترقة؟

56
00:07:09,450 --> 00:07:12,200
!أشمّ رائحة شيطان أيضًا وإن كانت خافتة

57
00:07:13,950 --> 00:07:16,040
!هذه الرّائحة... التّذكرة

58
00:07:17,330 --> 00:07:21,080
.عرفت ذلك. تفوح منها راحة خافتة لشيطان أيضًا

59
00:07:21,620 --> 00:07:24,340
.غلبَنا النّوم عندما ثُقبت بطاقاتنا

60
00:07:24,920 --> 00:07:27,090
!لا بدّ أنّ هذا من صنيع شيطان

61
00:07:27,590 --> 00:07:33,090
هل أطلق فنّ دماء شيطان قويّ كهذا
باستعمال هذه الرّائحة الخافتة فحسب؟

62
00:07:35,180 --> 00:07:36,600
...لا اعرف السّبب

63
00:07:37,140 --> 00:07:41,520
لكن يراودني شعور بأنّه ليس علي قطع
.هذه الحبال بسيف نيتشيرين خاصّتي

64
00:07:43,650 --> 00:07:45,310
!نيزوكو! ساعديني

65
00:07:45,900 --> 00:07:48,030
!أريدك أن تحرقي حبال الجميع

66
00:07:55,490 --> 00:07:57,660
!زنيتسو! استيقظ

67
00:07:57,910 --> 00:08:00,910
!استيقظ يا زنيتسو! استيقظ

68
00:08:03,420 --> 00:08:05,790
!استيقظ يا إينوسكي! أرجوك

69
00:08:06,920 --> 00:08:08,460
...إينوسكي

70
00:08:10,920 --> 00:08:13,300
.لا بأس، لا بأس... أنا آسف

71
00:08:13,880 --> 00:08:14,930
.شكرًا لك

72
00:08:15,220 --> 00:08:16,800
.أبليت حسنًا يا نيزوكو

73
00:08:20,220 --> 00:08:22,810
.لا فائدة. لن يستيقظ هذان الاثنان

74
00:08:23,690 --> 00:08:25,560
ماذا باستطاعتي أن أفعل؟

75
00:08:28,070 --> 00:08:28,860
—رنغوكو-سا

76
00:08:32,610 --> 00:08:33,490
ما الّذي تفعله؟

77
00:08:36,410 --> 00:08:39,490
هل يتحكّم بها شيطان ما؟

78
00:08:39,790 --> 00:08:41,620
!ابتعد عن طريقي

79
00:08:41,620 --> 00:08:45,370
!لن نتمكّن من أن نحلم بسببكم أنتم

80
00:08:47,920 --> 00:08:49,670
إنّها تتصرّف بمحض إرادتها؟

81
00:08:51,590 --> 00:08:53,300
هذا الرّجل أيضًا؟

82
00:08:56,430 --> 00:08:58,260
ما الّذي تظنّ نفسك فاعلاً؟

83
00:08:58,260 --> 00:09:00,850
!من الأفضل أن تساعدنا إن كنتَ مستيقظًا

84
00:09:01,140 --> 00:09:04,890
،قد تكون مصابًا بالسّلّ أو ما إلى ذلك
،لكن إن لم تقم بعملك

85
00:09:04,890 --> 00:09:09,480
فسأخبره، وحينها لن يسمح لك
برؤية أيّة أحلام، أسمعتني؟

86
00:09:12,030 --> 00:09:14,740
أهو من كان متّصلاً بي؟

87
00:09:15,280 --> 00:09:16,950
...داء السّلّ

88
00:09:16,950 --> 00:09:18,410
.إنّه مريض

89
00:09:18,780 --> 00:09:20,240
.يا له من مسكين

90
00:09:21,290 --> 00:09:23,250
.ما فعله هذا الشّيطان لا يغتفر

91
00:09:23,750 --> 00:09:26,330
!لقد استغلّ قلوبهم الضّعيفة

92
00:09:28,500 --> 00:09:29,420
.آسف

93
00:09:30,250 --> 00:09:32,920
.عليّ الذّهاب للقتال

94
00:09:48,650 --> 00:09:51,690
تريدون البقاء داخل حلم سعيد، صحيح؟

95
00:09:52,440 --> 00:09:53,860
.أفهم ذلك

96
00:09:54,940 --> 00:09:58,110
.أردت البقاء داخل حلمي أيضًا

97
00:10:03,450 --> 00:10:06,330
...ليت هذا كان حلمًا

98
00:10:20,640 --> 00:10:23,430
...حتّى اللّحظة الّتي لمستُ فيها قلبه

99
00:10:23,430 --> 00:10:26,140
...كنتُ عازمًا على أذيّة الآخرين

100
00:10:26,930 --> 00:10:30,520
إن عنى ذلك مقدرتي على الهرب
.من ألم هذا المرض

101
00:10:31,610 --> 00:10:33,070
...لكن الآن

102
00:10:33,820 --> 00:10:35,400
هل أنت بخير؟

103
00:10:37,950 --> 00:10:39,660
.شكرًا لك

104
00:10:41,160 --> 00:10:42,530
.كن حذرًا

105
00:10:46,500 --> 00:10:47,620
!أكيد

106
00:10:47,910 --> 00:10:49,040
!نيزوكو

107
00:11:00,840 --> 00:11:02,850
!الرّائحة شديدة

108
00:11:03,180 --> 00:11:04,100
!كثيفة

109
00:11:04,600 --> 00:11:08,100
رائحة هذا الشّيطان قويّة جدًّا
!حتّى خلال هذه الرّياح العاتية

110
00:11:08,770 --> 00:11:11,270
هل نمت بوجود رائحة فظيعة كهذه؟

111
00:11:12,270 --> 00:11:15,070
،حتّى إن كانت كلّ مقطورة مقفلة بإحكام

112
00:11:15,070 --> 00:11:16,610
!فلا أصدّق حدوث ذلك

113
00:11:17,230 --> 00:11:18,440
!كنت بلا فائدة

114
00:11:19,490 --> 00:11:21,030
...الشّيطان عكس اتّجاه الرّياح

115
00:11:21,360 --> 00:11:23,200
أهو في المقطورة الأولى؟

116
00:11:26,580 --> 00:11:27,750
!لا تأتي يا نيزوكو

117
00:11:28,200 --> 00:11:29,750
!ابقي في الدّاخل وانتظريني

118
00:11:30,290 --> 00:11:31,920
!أيقظي الجميع

119
00:11:39,920 --> 00:11:42,010
ماذا؟ استيقظت؟

120
00:11:42,430 --> 00:11:43,840
!صباح الخير

121
00:11:44,180 --> 00:11:47,930
.كان بإمكانك البقاء نائمًا

122
00:11:48,970 --> 00:11:50,940
!كان هو

123
00:12:07,410 --> 00:12:08,950
لماذا استيقظت؟

124
00:12:09,500 --> 00:12:13,460
ألم أرك حلمًا جميلاً؟

125
00:12:13,790 --> 00:12:19,460
.كان بإمكاني أن أريك حلمًا تُذبح فيه عائلتك

126
00:12:19,760 --> 00:12:22,260
أكنت لتفضّل ذلك أكثر؟

127
00:12:22,260 --> 00:12:24,890
لا، بالطّبع لا. ذلك مفجع للغاية، صحيح؟

128
00:12:28,100 --> 00:12:29,680
...حسنًا، ماذا عن

129
00:12:30,270 --> 00:12:33,940
لماذا لا أريك حلمًا يعود فيه والدك للحياة؟

130
00:12:43,860 --> 00:12:45,200
...ما أحبّ فعلاً

131
00:12:45,740 --> 00:12:52,200
.هو أن أري النّاس كوابيس بُعيد حلم سعيد

132
00:12:52,750 --> 00:12:56,960
.كم أحبّ رؤية التّعابير المعذَّبة على وجوههم

133
00:12:57,790 --> 00:12:59,710
!يمنحني ذلك نشوة عظيمة

134
00:13:00,250 --> 00:13:08,970
كم أنّ التّحديق في وجه شخص حطّمه
.سوء الحظّ والمعاناة والألم يأسر النّاظر له

135
00:13:09,760 --> 00:13:12,810
.لكنّني لا أرخي دفاعاتي في العادة

136
00:13:12,810 --> 00:13:17,480
،لذلك قد يأخذ الأمر وقتًا أطول
.لكنّني سأحرص على قتل قاتلي الشّياطين

137
00:13:18,110 --> 00:13:21,030
.مزجت دمائي بالحبر في البطاقات

138
00:13:21,030 --> 00:13:27,240
،بمجرّد قيام عامل القطار بثقبها
...محدثًا علامات المشبك

139
00:13:28,280 --> 00:13:30,530
.فستتفعّل التّعويذة

140
00:13:32,830 --> 00:13:35,120
.إنّه فنٌّ عن بعد

141
00:13:35,120 --> 00:13:39,250
يتطلّب الكثير من الجهد، لكنّها كانت
.الطّريقة الفضلى لتفادي اكتشافهم لي

142
00:13:39,710 --> 00:13:42,920
.بقائي متواريًا خطوة مهمّة

143
00:13:42,920 --> 00:13:46,760
يكون الوضع واقعًا في نظرهم
.إلى أن يدركوا أنّه حلم

144
00:13:49,430 --> 00:13:51,390
...ومع ذلك

145
00:13:51,720 --> 00:13:54,890
كيف تمكّن هذا من الاستيقاظ؟

146
00:13:55,390 --> 00:13:59,020
.وقد وجد الطّريقة للاستيقاظ في وقت وجيز

147
00:13:59,440 --> 00:14:06,200
،رغم أنّ البشر يرغبون بأحلام سعيدة
...بأحلام تخدمهم

148
00:14:07,610 --> 00:14:10,820
!لا حصر لها

149
00:14:12,950 --> 00:14:16,040
!كيف تجرؤ على التّطفّل على قلبي

150
00:14:16,710 --> 00:14:18,710
...لن أسمح لك

151
00:14:19,120 --> 00:14:20,500
!بالإفلات بفعلتك

152
00:14:23,050 --> 00:14:26,510
.ماذا؟ أرى أنّه يرتدي أقراط الأذن تلك

153
00:14:29,890 --> 00:14:32,050
!يا لحظّي

154
00:14:32,050 --> 00:14:35,270
!إذًا فقد أتى إليّ على قدميه

155
00:14:35,770 --> 00:14:37,980
!وكأنّه حلم

156
00:14:37,980 --> 00:14:42,520
أستطيع الآن الحصول على المزيد
!من دماء موزان-ساما

157
00:14:43,150 --> 00:14:46,650
،وبمجرّد أن تزداد قوّتي أكثر

158
00:14:46,650 --> 00:14:51,530
سأتحدّى شيطانًا من الرّتب العليا
!لنزال وآخذ مكانه

159
00:14:54,160 --> 00:14:55,830
...تنفّس الماء

160
00:14:57,160 --> 00:14:58,500
...الشّكل العاشر

161
00:14:59,040 --> 00:15:01,000
!التّدفّق الثّابت

162
00:15:05,960 --> 00:15:07,210
!فنّ دماء الشّيطان

163
00:15:10,090 --> 00:15:13,970
.همسات تنويم إفقاد الوعي القسريّ

164
00:15:14,470 --> 00:15:17,980
!اخلد للنّوم

165
00:15:26,780 --> 00:15:28,030
.إنّه لا يستسلم للنّوم

166
00:15:33,740 --> 00:15:34,660
.نم

167
00:15:42,250 --> 00:15:43,170
.نم

168
00:15:46,250 --> 00:15:48,550
!نم

169
00:15:52,300 --> 00:15:58,020
!فلتنم

170
00:15:59,560 --> 00:16:01,310
لا تعمل التّعويذة. ما السّبب؟

171
00:16:02,140 --> 00:16:03,940
.كلاّ، الأمر ليس كذلك

172
00:16:04,690 --> 00:16:08,360
!إنّه يقع ضحيّة لهذه التّعويذة مرارًا وتكرارًا

173
00:16:15,070 --> 00:16:18,290
.إنّه مدرك أنّه ضحيّة للتّعويذة في الحال

174
00:16:21,540 --> 00:16:24,540
!يقوم بقتل نفسه بهدف الاستيقاظ

175
00:16:30,260 --> 00:16:34,050
،حتّى إن كان في خضمّ حلم
...فإنّ قتل النّفس

176
00:16:34,050 --> 00:16:36,930
...وأن يجرم في حقّ نفسه بيديه

177
00:16:37,470 --> 00:16:39,680
!أمر يتطلّب قوّة إرادة مذهلة

178
00:16:40,100 --> 00:16:41,600
...هذا الشّقيّ

179
00:16:44,060 --> 00:16:45,520
!مجنون تمامًا

180
00:16:54,490 --> 00:16:58,990
لماذا لم تنفذنا؟

181
00:17:03,000 --> 00:17:06,880
ما الّذي كنت تفعله بينما كنّا نُقتل؟

182
00:17:09,420 --> 00:17:13,630
كيف أمكنك أن تكون النّاجي الوحيد؟

183
00:17:21,310 --> 00:17:24,230
لماذا تظنّ أنّك كنت هنا؟

184
00:17:24,560 --> 00:17:26,650
!لا فائدة منك

185
00:17:34,570 --> 00:17:37,360
.أنت من وجب أن يموت

186
00:17:38,200 --> 00:17:41,740
كيف تجرؤ على مواصلة العيش بدون أيّ اهتمام؟

187
00:17:49,080 --> 00:17:53,510
!من المستحيل أن يقولوا ذلك
!على الإطلاق! ليس من شيم عائلتي

188
00:17:54,090 --> 00:17:55,880
...إيّاك أن تجرؤ

189
00:17:56,510 --> 00:17:57,840
...على إهانة

190
00:17:57,840 --> 00:18:00,970
!عائلتي

191
00:18:25,790 --> 00:18:27,670
.كان الأمر سهلاً للغاية

192
00:18:29,080 --> 00:18:31,250
أيعقل أنّ هذا حلم أيضًا؟

193
00:18:31,670 --> 00:18:35,630
أم أنّ هذا الشّيطان كان أضعف منه؟

194
00:18:36,720 --> 00:18:38,630
...أرى السّبب بوضوح

195
00:18:39,220 --> 00:18:44,220
،أمرني أن أقتلك أنت يا فتى الأقراط

196
00:18:45,770 --> 00:18:48,560
!إلى جانب الهاشيرا

197
00:18:49,060 --> 00:18:51,900
...إنّ وجودك بحدّ ذاته

198
00:18:52,400 --> 00:18:56,240
!ما كان ليكون أكثر إزعاجًا من هذا

199
00:18:56,780 --> 00:18:57,990
لا يموت؟

200
00:18:58,530 --> 00:19:01,160
!تلك النّظرة على وجهك تبهج القلب

201
00:19:01,490 --> 00:19:04,870
!تلك هي النّظرة الّتي كنت أبتغي رؤيتها

202
00:19:06,250 --> 00:19:11,330
تريد أن تعلم لماذا أنا لست ميتًا
بعد أن قطعت عنقي، صحيح؟

203
00:19:11,830 --> 00:19:15,920
.لا بأس، سأخبرك بما أنّي أشعر بنشوة فرح الآن

204
00:19:16,510 --> 00:19:20,800
.الأمر سهل حتّى الأطفال سيفهمونه

205
00:19:22,550 --> 00:19:26,430
هذا لأنّ الجسد الّتي تراه هناك
.لم يعد جسدي الأساسيّ

206
00:19:27,020 --> 00:19:30,270
والأمر نفسه ينطبق على هذا الشّيء
.الّذي يتحدّث إليك الآن

207
00:19:30,270 --> 00:19:33,940
.إنّه يشبه رأسي فحسب، لكنه ليس كذلك

208
00:19:34,360 --> 00:19:37,440
...بينما كنت تغطّ في النّوم

209
00:19:38,110 --> 00:19:41,320
!لقد اندمجت مع هذا القطار

210
00:19:42,740 --> 00:19:49,460
صار كلّ شبر من هذا القطار
!دمائي ولحمي وعظامي

211
00:19:50,500 --> 00:19:52,330
.انظر لوجهك

212
00:19:52,330 --> 00:19:55,210
...هل تدرك الأمر الآن؟ بتعبير آخر

213
00:19:56,000 --> 00:19:59,340
...الرّكّاب الأزيد من 200 الّذين على متن القطار

214
00:19:59,340 --> 00:20:03,260
...عبارة عن طعام سيقوّي جسدي أكثر

215
00:20:03,720 --> 00:20:05,720
.إضافة لكونهم رهائني

216
00:20:06,310 --> 00:20:10,270
لذلك، أتظنّ أنّ بإمكانك حمايتهم وحدك؟

217
00:20:10,270 --> 00:20:16,480
كلّ هؤلاء النّاس الّذين يملؤون
...هذا القطار أوّله إلى آخره

218
00:20:17,190 --> 00:20:20,320
أيمكنك منعي وحدك من التهامهم؟

219
00:20:27,620 --> 00:20:29,790
ما العمل؟ ما العمل؟

220
00:20:30,330 --> 00:20:33,500
!أكثر ما يمكنني حمايته وحدي هما مقطورتان

221
00:20:33,500 --> 00:20:36,210
!ولن أستطيع ضمان سلامة ما هو أكثر من ذلك

222
00:20:36,960 --> 00:20:40,670
!رنغوكو-سان! زنيتسو! إينوسكي

223
00:20:41,010 --> 00:20:45,050
!هذا ليس وقتًا مناسبًا للنّوم
!استيقظوا! أرجوكم

224
00:20:45,590 --> 00:20:47,300
!نيزوكو

225
00:20:47,300 --> 00:20:49,810
!احمي الرّكّاب النّيام

226
00:21:01,860 --> 00:21:04,160
!خلفي أيّها الأتباع الملاعين

227
00:21:04,160 --> 00:21:05,610
!هيّا

228
00:21:05,610 --> 00:21:07,830
!الإيقاظ المتفجّر

229
00:21:08,740 --> 00:21:10,620
!افتحوا الطّريق

230
00:21:11,330 --> 00:21:13,910
!افتحوا الطّريق لإينوسكي-ساما

231
00:21:15,330 --> 00:21:18,210
...تنفّس الوحش، النّاب الخامس

232
00:21:19,000 --> 00:21:20,710
!التّقطيع المجنون

233
00:21:24,130 --> 00:21:29,970
!هاشيبارا إينوسكي-ساما قادم

234
00:23:02,190 --> 00:23:04,150
!إينوسكي، أنا سعيد لتواجدك هنا

235
00:23:04,150 --> 00:23:07,240
!بالطّبع أتيت! أنا الزّعيم كما تعلم

236
00:23:07,240 --> 00:23:09,700
!حسنًا، حان وقت سرّ من حقبة تايشو

237
00:23:10,110 --> 00:23:13,370
غراب كاسوغاي الخاصّ بإينوسكي
.يُدعى دونغوريمارو

238
00:23:13,370 --> 00:23:18,080
،إنّه إلى جانب إينوسكي دائمًا
،لكنّه كاد يأكله

239
00:23:18,080 --> 00:23:21,080
!لذلك سمعت أنّه يظلّ متخفّيًا الآن

240
00:23:21,540 --> 00:23:23,630
!إينوسكي، أنا أعتمد عليك بالفعل

241
00:23:23,630 --> 00:23:25,710
!لا تتصرّف بزعامة! أنت مجرّد تابع

242
00:23:26,010 --> 00:23:29,130
إنّك تشعرني بأمان شديد عندما
!تكون قربي يا إينوسكي

243
00:23:30,930 --> 00:23:33,140
!لا تجعل عواطفي تغلبني

244
00:23:33,140 --> 00:23:34,470
!هيّا بنا يا مونجيرو

245
00:23:35,060 --> 00:23:36,020
!حاضر

246
00:23:36,020 --> 00:23:38,270
!"لاحقًا في الحلقة 5: "إلى الأمام