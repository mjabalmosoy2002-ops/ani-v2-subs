1
00:00:00,680 --> 00:00:01,890
...الشّكل الثّالث

2
00:00:02,140 --> 00:00:03,600
!كون مشتعل

3
00:00:04,980 --> 00:00:06,060
...الشّكل الرّابع

4
00:00:06,360 --> 00:00:08,440
!تموّج اللّهب المتفتّح

5
00:00:10,650 --> 00:00:12,570
...موت مدمّر

6
00:00:13,820 --> 00:00:15,160
...الشّكل الخامس

7
00:00:15,870 --> 00:00:16,870
!نمر اللّهب

8
00:00:20,370 --> 00:00:21,950
!فوضى

9
00:00:25,830 --> 00:00:27,590
!كيوجورو

10
00:00:44,270 --> 00:00:46,690
هل فعلها؟ هل فاز؟

11
00:01:27,560 --> 00:01:30,270
.إيّاك أن تموت يا كيوجورو

12
00:01:42,870 --> 00:01:44,660
...رنغوكو-سان

13
00:01:45,120 --> 00:01:46,830
!رنغوكو-سان

14
00:01:48,960 --> 00:01:50,750
!رنغوكو-سان

15
00:01:55,420 --> 00:02:01,720
لا يمكنك الفوز يا كيوجورو حتّى
.إن قاتلتَ حتّى الموت

16
00:02:02,850 --> 00:02:09,190
سبق وشُفيت هذه الجروح المثيرة
.للدّهشة الّتي أصبتني بها

17
00:02:09,440 --> 00:02:11,520
لكن ماذا عنك؟

18
00:02:11,520 --> 00:02:16,490
عين يسرى مفقوعة وأضلاع مكسورة
...وأعضاء داخليّة متضرّرة

19
00:02:16,490 --> 00:02:18,700
.لا أمل من شفاء أيّ منها

20
00:02:18,990 --> 00:02:22,160
كنتَ لتشفى من ذلك في لمح
.البصر إن كنتَ شيطانًا

21
00:02:22,160 --> 00:02:25,580
.لكانت تلك مجرّد خدوش بالنّسبة لشيطان

22
00:02:25,870 --> 00:02:29,790
،بإمكانك أن تعاني قدر ما تشاء
.لكن محال لبشريّ أن يهزم شيطانًا

23
00:02:32,210 --> 00:02:34,300
!أريد الذّهاب لمساعدته

24
00:02:37,010 --> 00:02:39,800
.لكن لا قوّة في ذراعيّ أو ساقيّ

25
00:02:39,800 --> 00:02:41,890
،يعود السّبب في ذلك لإصابتي جُزئيًّا

26
00:02:41,890 --> 00:02:44,930
لكنّ هذا يحدث دائمًا عندما
!أستعمل تقنية هينوكامي كاغورا

27
00:02:58,440 --> 00:03:01,240
...كيوجورو، إنّك

28
00:03:02,410 --> 00:03:03,240
...أنا

29
00:03:05,080 --> 00:03:07,660
!لديّ واجب لأقوم به

30
00:03:07,660 --> 00:03:11,290
!لن أسمح بموت أيّ أحد هنا

31
00:03:12,580 --> 00:03:16,130
!سألحق الضّرر بجسده بقدر ما أستطيع في لحظة

32
00:03:16,420 --> 00:03:18,130
...تنفّس اللّهب

33
00:03:18,130 --> 00:03:19,380
!الفنّ السّرّيّ

34
00:03:25,350 --> 00:03:27,720
!يا لها من روح قتاليّة مذهلة

35
00:03:27,720 --> 00:03:30,640
!هالته مذهلة رغم كلّ تلك الإصابات

36
00:03:30,640 --> 00:03:32,650
!يا لها من قوّة ذهنيّة

37
00:03:32,900 --> 00:03:35,650
!تلك الوقفة المُحكمة

38
00:03:38,030 --> 00:03:41,650
!عليك أن تصير شيطانًا في النّهاية يا كيوجورو

39
00:03:41,950 --> 00:03:44,910
!لنقاتل بعضنا إلى الأبد

40
00:03:45,240 --> 00:03:46,910
.أجّج النّار في قلبك

41
00:03:47,740 --> 00:03:49,500
!تجاوز حدودك

42
00:03:50,700 --> 00:03:52,710
...أنا هاشيرا اللّهب

43
00:03:53,040 --> 00:03:54,830
!رنغوكو كيوجورو

44
00:03:55,460 --> 00:03:56,670
...الشّكل الخامس

45
00:03:57,420 --> 00:03:59,130
!المُطهّر

46
00:03:59,380 --> 00:04:00,630
...موت مدمّر

47
00:04:00,920 --> 00:04:02,260
!أسلوب الإبادة

48
00:04:19,320 --> 00:04:20,650
!رنغوكو-سان

49
00:04:53,890 --> 00:04:55,230
!رنغوكو-سان

50
00:05:00,320 --> 00:05:01,980
!رنغوكو-سان

51
00:05:04,280 --> 00:05:05,490
—أنا أرا

52
00:05:05,740 --> 00:05:06,570
...رن

53
00:05:06,910 --> 00:05:07,950
...غوكو

54
00:05:18,710 --> 00:05:22,170
!ستموت! سيؤدّي هذا لمقتلك يا كيوجورو

55
00:05:22,170 --> 00:05:23,920
!أصبح شيطانًا

56
00:05:23,920 --> 00:05:25,930
!قل أنّك ستصبح شيطانًا

57
00:05:25,930 --> 00:05:27,180
...أنت

58
00:05:27,550 --> 00:05:30,760
!قويّ وأحد المختارين

59
00:05:43,530 --> 00:05:44,690
...كيوجورو

60
00:05:44,690 --> 00:05:46,450
!نعم يا أمّاه

61
00:05:47,490 --> 00:05:49,490
...أريدك أن تفكّر مليًّا

62
00:05:49,820 --> 00:05:52,450
.بشأن ما سأخبرك به

63
00:05:52,830 --> 00:05:58,080
أتعرف لماذا وُلدتَ أقوى من الآخرين؟

64
00:06:02,000 --> 00:06:03,340
!لا أعرف

65
00:06:04,090 --> 00:06:06,840
.لتستطيع إنقاذ الضّعيف

66
00:06:08,300 --> 00:06:13,430
إنّ من وُلدوا بنعم أكثر من البقيّة

67
00:06:13,430 --> 00:06:19,350
مُلزمون باستخدام هذه النّعم
.من أجل العالم وبقيّة النّاس

68
00:06:20,230 --> 00:06:28,110
لا يجب أن تستعمل تلك القوّة الّتي منحها
.لك الإله لأذيّة النّاس أو لمكسب شخصيّ

69
00:06:29,200 --> 00:06:34,700
.مِن واجب مَن وُلدوا أقوياءَ نصرةَ الضّعيف

70
00:06:35,040 --> 00:06:39,460
.إنّها مهمّة عليهم إنجازها بشكل مسؤول

71
00:06:39,920 --> 00:06:43,840
.ضع هذا حلقة في أذنك ولا تنساه

72
00:06:43,840 --> 00:06:45,380
!حاضر

73
00:07:01,980 --> 00:07:06,110
.ما عاد لي الكثير من الوقت لأعيشه

74
00:07:06,940 --> 00:07:11,820
.لقد بُوركتُ بكوني أمّ طفل قويّ ولطيف مثلك

75
00:07:13,660 --> 00:07:15,910
.سأعهد لك بكلّ شيء

76
00:07:28,630 --> 00:07:29,800
...أمّاه

77
00:07:30,130 --> 00:07:35,800
!كان شرفًا لي أن أولد ابنًا لامرأة مثلك

78
00:07:43,230 --> 00:07:44,360
أوقف هجومي؟

79
00:07:44,770 --> 00:07:47,150
!يا لها من قوّة لا تصدّق

80
00:07:47,150 --> 00:07:50,360
!لقد اخترقتُ ضفيرته البطنيّة بذراعي اليمنى

81
00:07:52,030 --> 00:07:53,490
!مصيبة

82
00:07:53,780 --> 00:07:55,740
!الفجر وشيك

83
00:07:56,030 --> 00:07:58,660
!عليّ قتله والهرب من هنا

84
00:07:59,950 --> 00:08:00,960
...لا يمكنني

85
00:08:00,960 --> 00:08:02,710
!انتزاع ذراعي

86
00:08:04,580 --> 00:08:06,710
!لن أسمح لك بالهرب

87
00:08:13,590 --> 00:08:16,800
...مهما كان ما قاله رنغوكو-سان

88
00:08:18,350 --> 00:08:19,520
...عليّ أن

89
00:08:19,850 --> 00:08:21,230
!القيام بهذا الآن

90
00:08:22,060 --> 00:08:25,520
!عليّ قطع رأس الشّيطان

91
00:08:25,520 --> 00:08:26,940
!بسرعة

92
00:08:29,570 --> 00:08:31,280
!الشّمس تشرق

93
00:08:31,570 --> 00:08:34,030
!سينتشر نورها إلى هنا قريبًا

94
00:08:34,360 --> 00:08:37,530
!عليّ الهرب

95
00:08:46,960 --> 00:08:49,040
!من المستحيل أن أتركك

96
00:08:49,040 --> 00:08:52,050
!ليس قبل أن أقطع رأسك

97
00:08:55,010 --> 00:08:57,220
!ابتعد عن طريقي

98
00:09:01,720 --> 00:09:03,640
!تحرّك يا إينوسكي

99
00:09:04,350 --> 00:09:07,310
!حرّك جسدك من أجل رنغوكو-سان

100
00:09:10,770 --> 00:09:13,400
...تنفّس الوحش، النّاب الأوّل

101
00:09:13,860 --> 00:09:15,530
!اختراق

102
00:09:36,130 --> 00:09:39,260
!عليّ إيجاد ملاذ من نور الشّمس

103
00:09:49,440 --> 00:09:51,020
!أخذ ذلك وقتًا طويلاً

104
00:09:51,020 --> 00:09:53,190
!عليّ الهرب من الشّمس

105
00:10:00,280 --> 00:10:01,910
!لا تهرب

106
00:10:02,490 --> 00:10:04,330
!لا تهرب أيّها الجبان

107
00:10:04,330 --> 00:10:06,460
!لا تهرب

108
00:10:08,790 --> 00:10:12,090
ما الّذي يتحدّث عنه ذلك الشّقيّ؟

109
00:10:12,090 --> 00:10:14,710
ألا دماغ داخل رأسه ذاك؟

110
00:10:14,710 --> 00:10:17,380
!أنا لا أهرب منكم

111
00:10:17,720 --> 00:10:19,970
!بل أهرب من الشّمس

112
00:10:19,970 --> 00:10:23,220
!كما أنّ المعركة قد حُسمت سلفًا

113
00:10:23,510 --> 00:10:26,890
!ستخور قواه وسيموت قريبًا

114
00:10:29,440 --> 00:10:31,150
...فيلق قتلة الشّياطين

115
00:10:31,520 --> 00:10:35,690
يقاتلكم دائمًا أيّها الشّياطين في ظُلمة
!اللّيل حيث الأفضليّة لكم

116
00:10:35,690 --> 00:10:37,820
!هذا صحيح، نحن البشر من لحم ودم

117
00:10:38,110 --> 00:10:40,240
!لا تندمل جراحنا بسهولة

118
00:10:40,490 --> 00:10:43,080
!لا يمكننا أن نجدّد أطرافنا إن فقدناها

119
00:10:44,080 --> 00:10:45,910
!فلا تهرب أيّها الوغد

120
00:10:46,370 --> 00:10:49,670
!أيّها الوغد! أيّها الجبان

121
00:10:49,920 --> 00:10:54,250
!رنغوكو-سان أكثر روعة منك بكثير

122
00:10:54,250 --> 00:10:55,960
!إنّه أقوى

123
00:10:56,210 --> 00:10:58,130
!لم يخسر رنغوكو-سان

124
00:10:58,130 --> 00:11:00,180
!لم يسمح بموت أيّ أحد

125
00:11:00,180 --> 00:11:03,800
!قاتَل حتّى النّهاية! حمانا حتّى النّهاية

126
00:11:03,800 --> 00:11:05,930
!أنت من خسر

127
00:11:05,930 --> 00:11:10,140
!أمّا رنغوكو-سان فقد فاز

128
00:11:44,430 --> 00:11:46,680
.كفاك صراخًا الآن

129
00:11:52,480 --> 00:11:54,520
.ستعيد فتح جرح بطنك

130
00:11:55,020 --> 00:11:57,230
إصابتك بليغة، أنسيت؟

131
00:11:58,280 --> 00:12:00,530
،إن متّ أيّها الفتى كامادو

132
00:12:00,900 --> 00:12:03,160
.فسيعني ذلك أنّني خسرت

133
00:12:05,030 --> 00:12:06,780
...رنغوكو-سان

134
00:12:07,830 --> 00:12:09,250
.تعال إلى هنا

135
00:12:09,660 --> 00:12:12,330
.لنتحدّث قليلاً لآخر مرّة

136
00:12:40,030 --> 00:12:42,110
...ثمّة أمر تذكّرته

137
00:12:43,570 --> 00:12:45,910
.بينما كنتُ أحلم

138
00:12:47,030 --> 00:12:52,000
،يجدر بك الذّهاب لمنزل عائلتي
.منزل رنغوكو

139
00:12:52,960 --> 00:12:56,830
.ستجد هناك ملاحظات تركها هاشيرا اللّهب السّابقين

140
00:12:58,250 --> 00:13:00,670
،يقرؤها والدي أحيانًا

141
00:13:01,300 --> 00:13:05,130
.لكن بما أنّني لم أقرأها، فلا أعرف فحواها

142
00:13:06,840 --> 00:13:15,270
قد تكون هنالك سجلاّت عن تقنية
.هينوكامي كاغورا الّتي ذكرتَ سابقًا

143
00:13:16,270 --> 00:13:19,860
.ر-رنغوكو-سان، كفّ عن الكلام رجاءً

144
00:13:19,860 --> 00:13:22,230
!أوقف نزيفك بتقنية التّنفّس

145
00:13:22,230 --> 00:13:24,530
ألا توجد طريقة لإغلاق جرحك؟

146
00:13:25,280 --> 00:13:26,490
.لا

147
00:13:26,490 --> 00:13:29,160
.سأموت قريبًا

148
00:13:31,120 --> 00:13:34,830
سأخبرك بكلّ ما أستطيع بينما ما زلت
قادرًا على الكلام، فهلاّ استمعت لي؟

149
00:13:36,670 --> 00:13:38,920
...أخبر أخي الصّغير سنجورو

150
00:13:39,590 --> 00:13:41,670
...أن يجعل من قلبه دليلاً له

151
00:13:42,050 --> 00:13:46,590
.وأن يسير على الدّرب الّذي يراه مناسبًا له

152
00:13:48,930 --> 00:13:50,850
...أخبر والدي

153
00:13:51,140 --> 00:13:53,810
.أنّني أريد منه أن يهتمّ بنفسه

154
00:13:55,940 --> 00:13:57,270
.وهناك أمر أخير

155
00:13:58,230 --> 00:13:59,610
...أيّها الفتى كامادو

156
00:14:01,940 --> 00:14:04,360
.أنا أؤمن بأختك الصّغيرة

157
00:14:05,320 --> 00:14:08,110
.أنا أقبلها كعضوة في فيلق قتلة الشّياطين

158
00:14:10,280 --> 00:14:15,660
.رأيتها تنزف وهي تحمي البشر داخل القطار

159
00:14:16,580 --> 00:14:20,380
إنّ كلّ من يخاطر بحياته مقاتلاً
...الشّياطين لحماية البشر

160
00:14:20,750 --> 00:14:24,510
هو شخص له كلّ الحقّ ليكون عضوًا في فيلق
.قتلة الشّياطين مهما كان ما يقوله الجميع

161
00:14:25,340 --> 00:14:27,590
!واصل حياتك ورأسك مرفوعًا

162
00:14:32,600 --> 00:14:38,100
وبغضّ النّظر عن الدّمار الّذي قد يسبّبه لك
...ضعفك وقلّة حيلتك

163
00:14:39,520 --> 00:14:41,360
.أجّج النّار في قلبك

164
00:14:44,280 --> 00:14:46,900
.تحمّل على مضض وانظر للأمام مباشرة

165
00:14:48,070 --> 00:14:50,820
،حتّى إن توقّفت وجثوتَ أرضًا

166
00:14:51,160 --> 00:14:54,120
...فلن ينتظرك الزّمن

167
00:14:54,120 --> 00:14:58,250
.أو يحتضنك ويحزن معك

168
00:14:59,710 --> 00:15:02,540
.لا تشعر بالسّوء لأنّني سأقضي نحبي هنا

169
00:15:03,000 --> 00:15:04,420
،بصفتي هاشيرا

170
00:15:04,750 --> 00:15:07,630
.فمن الطّبيعيّ أن أحمي زملائي الأصغر

171
00:15:08,170 --> 00:15:12,340
.كان أيّ هاشيرا آخر ليقوم بالمثل

172
00:15:13,010 --> 00:15:15,140
.لا نسمح أبدًا أن تُقطف البراعم باكرًا

173
00:15:16,430 --> 00:15:18,390
...أيّها الفتى كامادو

174
00:15:19,440 --> 00:15:21,020
...يا فتى رأس الخنزير

175
00:15:22,020 --> 00:15:23,310
...والفتى الأصفر

176
00:15:24,940 --> 00:15:27,110
.واصلوا التّعلّم والنّموّ

177
00:15:27,740 --> 00:15:29,400
...وثمّ

178
00:15:29,740 --> 00:15:33,450
اغدوا الهاشيرا التّاليين الّذين يدعمون
.فيلق قتلة الشّياطين

179
00:15:34,620 --> 00:15:36,790
.أنا أؤمن بك

180
00:15:37,080 --> 00:15:40,040
.أؤمن بكم جميعًا

181
00:16:05,310 --> 00:16:06,730
...أمّاه

182
00:16:11,360 --> 00:16:13,740
أتظنّين أنّني أبليت حسنًا؟

183
00:16:15,870 --> 00:16:19,370
...هل حقّقت ما كان عليّ تحقيقه

184
00:16:20,000 --> 00:16:21,960
وقمت بواجبي؟

185
00:16:31,170 --> 00:16:33,630
.ما كنت لأفخر أكثر ممّا أنا فخورة الآن

186
00:17:10,000 --> 00:17:12,260
،عندما خرج القطار عن السّكّة

187
00:17:12,670 --> 00:17:15,970
.أطلق رنغوكو-سان كلّ تقنياته

188
00:17:15,970 --> 00:17:20,260
.لا بدّ أنّه حرص على ألاّ تتضرّر المقطورات

189
00:17:22,180 --> 00:17:23,810
.ذلك من شيمه

190
00:17:25,230 --> 00:17:27,610
.لا أصدّق أنّه رحل

191
00:17:28,230 --> 00:17:30,900
هل ظهر شيطان من الرّتب العليا بالفعل؟

192
00:17:31,190 --> 00:17:32,400
.نعم

193
00:17:32,940 --> 00:17:35,530
لماذا قد يأتي شيطان من الرّتب العليا إلى هنا؟

194
00:17:35,950 --> 00:17:39,030
...أكان بتلك القوّة؟ أعني

195
00:17:39,370 --> 00:17:40,580
.نعم

196
00:17:42,950 --> 00:17:45,120
!كم أنا محبط

197
00:17:46,460 --> 00:17:49,380
،بمجرّد أن أتقنت شيئًا واحدًا

198
00:17:50,170 --> 00:17:55,010
...وجدت أمامي جدارًا عاليًا آخر

199
00:17:56,220 --> 00:18:01,260
بينما يقاتل المزيد من الأشخاص
.الأقوياء خلفه أبعد بكثير

200
00:18:02,010 --> 00:18:04,640
!لا أستطيع الوصول إلى هناك بعد

201
00:18:06,020 --> 00:18:09,610
إن كنتُ لا أزال أتعثّر في مكاني
...هذا، فهل يمكنني

202
00:18:10,520 --> 00:18:12,440
...هل يمكنني

203
00:18:14,690 --> 00:18:18,950
أن أصبح مثل رنغوكو-سان يومًا؟

204
00:18:29,210 --> 00:18:31,710
!كفّ عن النّواح

205
00:18:33,460 --> 00:18:37,720
كفاك تفوّهًا بكلام غبيّ مثل
"هل يمكنني أن أصير مثله أم لا؟"

206
00:18:37,720 --> 00:18:42,970
قال أنّه يؤمن بك، لذلك فكّر كيف
!سترتقي لذلك فحسب

207
00:18:42,970 --> 00:18:46,730
!تعود كلّ المخلوقات الحيّة للأرض عندما تموت

208
00:18:47,020 --> 00:18:50,230
!لا يعيدهم البكاء والنّحيب للحياة ثانية

209
00:18:50,520 --> 00:18:52,980
!إيّاك حتّى أن تبكي إن كنت نادمًا على أيّ شيء

210
00:18:53,320 --> 00:18:56,610
،بغضّ النّظر عن الإذلال والشّفقة اللّتان تشعر بهما

211
00:18:56,610 --> 00:18:58,990
!ما زال عليك أن تواصل العيش

212
00:18:59,280 --> 00:19:01,120
.لكنّك تبكي أيضًا

213
00:19:01,450 --> 00:19:04,620
.هنالك دموع تتدفّق من قناعك

214
00:19:05,490 --> 00:19:07,000
!لستُ أبكي

215
00:19:18,170 --> 00:19:20,890
!تعال معي! سنتدرّب

216
00:20:04,930 --> 00:20:06,600
...هكذا إذًا

217
00:20:06,970 --> 00:20:08,930
...رنغوكو-سان قد

218
00:20:28,910 --> 00:20:33,710
إذًا فحتّى رنغوكو لم يستطع
هزيمة شيطان من الرّتب العليا؟

219
00:20:38,750 --> 00:20:40,760
.لا أصدّق هذا

220
00:20:47,560 --> 00:20:49,850
.نامو أميدا بوتسو

221
00:20:56,060 --> 00:21:00,690
!سأقضي على أولئك الشّياطين القذرين

222
00:21:08,410 --> 00:21:09,790
.فهمت

223
00:21:19,300 --> 00:21:24,470
لم يفقد أيّ واحد من الرّكّاب المائتين حياته؟

224
00:21:24,800 --> 00:21:27,510
.أبلى كيوجورو بلاءً حسنًا إذًا

225
00:21:27,510 --> 00:21:29,430
.يا له من فتى مذهل

226
00:21:30,760 --> 00:21:32,680
.لستُ حزينًا

227
00:21:33,100 --> 00:21:36,270
.أيّامي في هذه الحياة معدودة أيضًا

228
00:21:38,810 --> 00:21:42,190
سأنضمّ قريبًا إلى كيوجورو والآخرين

229
00:21:42,610 --> 00:21:45,570
.في أرض الأموات

230
00:21:57,000 --> 00:22:01,750
...رنغوكو-سان

231
00:22:04,260 --> 00:22:06,510
!رنغوكو-سان