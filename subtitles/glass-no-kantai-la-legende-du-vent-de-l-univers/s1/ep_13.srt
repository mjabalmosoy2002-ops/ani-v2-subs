1
00:00:19,830 --> 00:00:23,430
،عندما نفكر بالأمر
إلى متى قُدّر لنا أن نهيم؟

2
00:00:24,310 --> 00:00:29,770
يتملكنا اليأس ثم نجد الأمل مجددًا
.ونستمر في المُضي

3
00:00:31,270 --> 00:00:32,620
،وعندما نُفكر فيما مضى

4
00:00:33,200 --> 00:00:39,670
نجده مجرد ومضة لحظية
.في التدفق الغزير للزمن

5
00:02:04,960 --> 00:02:07,120
.آسف يا جان

6
00:02:07,120 --> 00:02:12,810
.لا تقولي أي شيء رجاءً
.لقد وهبتُ حياتي بأكملها لعائلة فولبان

7
00:02:12,810 --> 00:02:16,460
.أعرف فيما تفكرين يا سيدتي

8
00:02:16,460 --> 00:02:19,570
.اسمحي للألم أن يأتي من يدي على الأقل

9
00:02:24,250 --> 00:02:25,410
...سيدتي

10
00:02:25,410 --> 00:02:29,390
.بل ميشيل-ساما، تبدو جسورًا

11
00:02:29,390 --> 00:02:32,420
.هذا صحيح. كأن أخاكِ قد عاد للحياة

12
00:02:33,170 --> 00:02:35,930
،من هذه اللحظة

13
00:02:35,930 --> 00:02:40,090
سأتخلى عن اسم راسين
.وسأعيش بصفتي ميشيل فولبان

14
00:02:40,590 --> 00:02:43,600
...صمتًا! أنا

15
00:02:44,790 --> 00:02:47,220
!ميشيل فولبان من الجيش الشعبي

16
00:02:49,480 --> 00:02:52,730
!امنحيني القوة يا فيرجينيا القرمزية

17
00:03:00,200 --> 00:03:02,110
ما هذا؟

18
00:03:02,110 --> 00:03:05,450
!هذا سيء
!يقترب أسطول من قوات الإمبراطور المقدس

19
00:03:05,450 --> 00:03:06,860
ماذا؟

20
00:03:15,670 --> 00:03:19,260
لماذا؟ لماذا لا يستهدفون سفينتي؟

21
00:03:19,260 --> 00:03:22,680
يحاول أسطول الأعداء
.تطويق سفينتنا

22
00:03:23,400 --> 00:03:24,740
...هذه هي النهاية إذًا

23
00:03:25,800 --> 00:03:29,510
.يحتاج الجيش الشعبي لمنقذ حقًا

24
00:03:30,470 --> 00:03:33,980
.ليس أنا، بل منقذ حقيقي

25
00:03:48,060 --> 00:03:49,200
!ميشيل-ساما

26
00:03:49,200 --> 00:03:51,420
!هل أصبت يا ميشيل-ساما

27
00:03:51,420 --> 00:03:54,000
،الأهم من هذا
هل بوسعنا الاقتراب من تلك السفينة؟

28
00:03:54,380 --> 00:03:56,750
!عثرنا على منقذنا أخيرًا

29
00:03:58,050 --> 00:04:00,800
لماذا تحمل هذه السفينة شعار
العائلة الملكية؟

30
00:04:01,260 --> 00:04:03,800
لأنني دماء العائلة الملكية
.تجري بعروقي

31
00:04:03,800 --> 00:04:05,230
أنت؟

32
00:04:05,230 --> 00:04:06,410
أهذا غريب؟

33
00:04:08,040 --> 00:04:11,120
من المفترض أن العائلة الملكية
.قد اندثرت منذ 20 عامًا

34
00:04:11,120 --> 00:04:13,480
.لهذا سأعيدها للوجود

35
00:04:13,480 --> 00:04:14,770
تعيدها للوجود؟

36
00:04:14,770 --> 00:04:18,570
أليس الأمر واضحًا؟
.سأسيطر على العالم

37
00:04:18,570 --> 00:04:20,780
هل أنت جاد؟

38
00:04:21,130 --> 00:04:24,280
هلا تتوقف عن مناداتي بـ"أنت"؟

39
00:04:24,640 --> 00:04:26,450
!هذا لأنك ترفض إخباري باسمك

40
00:04:26,880 --> 00:04:29,020
.كان هذا فظًا مني

41
00:04:29,490 --> 00:04:32,120
...تذكر اسمي. اسمي هو

42
00:04:33,910 --> 00:04:35,330
.كليو الرياح

43
00:04:36,690 --> 00:04:38,520
.هناك صمت لحظي

44
00:04:39,340 --> 00:04:42,020
،لكن بعد ذلك مباشرة
.سنجد عاصفة في انتظارنا

45
00:04:42,840 --> 00:04:46,940
مع ذلك، أريد حاليًا
.تكريس نفسي للصمت

46
00:04:47,390 --> 00:04:52,440
سأطبع الحقيقة الموجودة بالصمت
.داخل قلبي

47
00:04:58,110 --> 00:05:01,780
هل الورد هو المفضل لديك
يا فيتي-ساما؟

48
00:05:01,780 --> 00:05:04,720
ماذا عنك يا رالف؟

49
00:05:04,720 --> 00:05:10,370
.أراها جميلة لكنني أكره أشواكها

50
00:05:10,770 --> 00:05:11,660
حقًا؟

51
00:05:13,950 --> 00:05:15,290
!فيتي-ساما

52
00:05:16,020 --> 00:05:19,750
.الألم هو أمرٌ يلازم الحب

53
00:05:20,390 --> 00:05:26,130
كنّا جميعًا مدركين لذلك
.عندما أتينا هنا، أليس كذلك؟ أنا وأنت معًا

54
00:05:26,130 --> 00:05:31,640
لا يُمكن إخفاء الجمال الحقيقي
.ولو خلف قناع. هذا ما ظننته

55
00:05:31,950 --> 00:05:36,520
قلتَ منذ قليل أن هذا العالم
.مليء بالكذب

56
00:05:38,200 --> 00:05:42,070
.يُصبح الكذب حقيقة أحيانًا

57
00:05:42,440 --> 00:05:46,070
يُصبح... الكذب الحقيقة؟

58
00:05:48,260 --> 00:05:49,800
.يمكننا رؤيتها

59
00:05:50,360 --> 00:05:51,400
ما هي؟

60
00:05:52,190 --> 00:05:54,520
.قلعة المتنبئة غيلدي

61
00:05:54,520 --> 00:05:55,830
المتنبئة؟

62
00:05:56,120 --> 00:06:00,280
،عندما تحين النهاية
.سيولد نسر برأسين

63
00:06:00,790 --> 00:06:07,660
سيكون أحدهما مرتديًا ذرعًا حديديًا
.بينما سيُصبح الآخر إله حب

64
00:06:08,760 --> 00:06:15,770
،عندما يحين الوقت
.سيتحدان وسيوحدان المجرة

65
00:06:16,470 --> 00:06:19,770
.كان جزء مني ينتظر هذه الرياح

66
00:06:20,290 --> 00:06:23,450
ماذا تعني تلك النبوءة؟

67
00:06:23,450 --> 00:06:24,970
ألا تعرف؟

68
00:06:24,970 --> 00:06:26,350
.كلا

69
00:06:26,350 --> 00:06:28,780
.صرتُ أرى الدرب الذي يجب أن أسلكه

70
00:06:29,980 --> 00:06:33,900
يبدو أنه من المقدر لي
.الزواج من ابنة غورنا

71
00:06:33,900 --> 00:06:36,680
لكن لماذا؟
!لا أريدك أن تفعل ذلك

72
00:06:38,290 --> 00:06:41,950
،عندما تحين النهاية
.سيولد نسر برأسين

73
00:06:41,950 --> 00:06:44,990
.أحدهما يرتدي درعًا حديديًا، هذا أنا

74
00:06:44,990 --> 00:06:47,040
،والآخر سيصبح إله حب

75
00:06:47,040 --> 00:06:52,430
ابنة البابا غورنا
.من ديانة الصليب النجمي، ريتشل

76
00:07:07,570 --> 00:07:08,860
لماذا أشهرتَ سيفك؟

77
00:07:08,860 --> 00:07:11,700
لماذا لا تسأل سيفك؟

78
00:07:40,150 --> 00:07:42,440
هل تريدك أن أضع به أيضًا؟

79
00:07:43,440 --> 00:07:44,900
بجيبي؟

80
00:08:01,570 --> 00:08:02,970
...من

81
00:08:04,160 --> 00:08:05,430
أنت؟

82
00:08:10,460 --> 00:08:12,220
!انهض يا كليو

83
00:08:13,140 --> 00:08:15,300
هل أنت بخير يا كليو؟

84
00:08:17,800 --> 00:08:19,720
!مت

85
00:08:27,480 --> 00:08:29,230
بحيرة متجمدة؟

86
00:08:29,230 --> 00:08:30,690
.أنزلينا

87
00:08:31,160 --> 00:08:32,960
ما الذي تنوي فعله؟

88
00:08:32,960 --> 00:08:34,740
.اصمت وراقب فحسب

89
00:08:37,330 --> 00:08:39,450
.استعدوا للصدمة جميعًا

90
00:08:42,890 --> 00:08:44,210
!استديري بنا

91
00:08:44,210 --> 00:08:45,750
!جاري الاستدارة

92
00:08:50,210 --> 00:08:51,660
!إطلاق

93
00:08:54,760 --> 00:08:56,890
!هيا

94
00:09:02,470 --> 00:09:04,060
.اخترقي قلبهم

95
00:09:04,400 --> 00:09:06,400
!تغيير الهيئة

96
00:09:23,620 --> 00:09:24,500
!إطلاق

97
00:09:28,790 --> 00:09:30,340
ماذا؟

98
00:09:47,830 --> 00:09:51,930
لماذا أشهرتُ سيفي بوجهه فجأة؟

99
00:09:54,150 --> 00:09:58,760
ما الذي استفزني؟

100
00:10:00,240 --> 00:10:05,580
قال الطفل: "سأقطعك إلى نصفيت
".أيتها الزهرة الصغيرة التي تنمو بالحقل

101
00:10:06,720 --> 00:10:13,510
:ردت عليه الزهرة الصغيرة
".سأخزك كي لا تنسني أبدًا"

102
00:10:25,050 --> 00:10:26,250
هل تتألم؟

103
00:10:27,810 --> 00:10:30,080
.يجب أن تغادر السفينة

104
00:10:30,080 --> 00:10:30,980
ماذا؟

105
00:10:31,720 --> 00:10:34,270
.عد إلى الجيش الشعبي بنفسك

106
00:10:34,270 --> 00:10:36,530
.وعدتَ أن تأخذني برفقتك

107
00:10:38,210 --> 00:10:40,740
.لا أتذكر وعدًا كهذا

108
00:10:42,160 --> 00:10:43,950
.تنوي مطاردة فيتي

109
00:10:44,380 --> 00:10:48,210
.إنه ينتظرني أيضًا
.لا يمكنني المواصلة هكذا

110
00:10:48,580 --> 00:10:49,580
هو؟

111
00:10:49,580 --> 00:10:51,920
.وغد يُدعى كليو

112
00:10:51,920 --> 00:10:54,590
صاحب السفينة الزجاجية
.التي جعلت ماكونيس ينسحب

113
00:10:55,110 --> 00:10:58,180
.سأشتت تلك الرياح يومًا ما

114
00:10:58,180 --> 00:11:01,180
.انسَ أمره

115
00:11:01,180 --> 00:11:05,150
عدني يا فيتي-ساما
،أنك حتى لو تزوجت

116
00:11:05,150 --> 00:11:07,910
.فسأكون الشخص الوحيد بقلبك

117
00:11:10,950 --> 00:11:11,980
فيتي-ساما؟

118
00:11:13,670 --> 00:11:18,540
ما الخطب يا فيتي-ساما؟
!اصمد يا فيتي-ساما

119
00:11:19,190 --> 00:11:20,660
...فيتي-ساما

120
00:11:21,070 --> 00:11:25,580
.شاركني ألمك رجاءً يا فيتي-ساما

121
00:11:35,510 --> 00:11:36,760
...فيتي-ساما

122
00:11:39,820 --> 00:11:41,970
.سأخبرك بهذا أنت وحدك

123
00:11:43,060 --> 00:11:45,350
.ستنتهي حياتي قريبًا

124
00:11:46,420 --> 00:11:49,350
!كلا! لا تقل شيئًا فظيعًا كهذا

125
00:11:49,800 --> 00:11:55,590
سبب محاولتي الزواج من ريتشل
.ليس سببًا سياسيًا بحتًا

126
00:11:56,820 --> 00:12:01,680
،في قديم الزمان
.كانت هناك سفينة هائلة الحجم

127
00:12:01,680 --> 00:12:02,860
سفينة؟

128
00:12:03,230 --> 00:12:08,360
يُقال أن هذه السفينة قد استخدمت
...تقنية مجهولة قد فقدناها

129
00:12:08,360 --> 00:12:11,750
.سمحت لها بالتلاعب حتى بالزمن

130
00:12:12,260 --> 00:12:14,640
،لكن في مرحلة ما

131
00:12:14,640 --> 00:12:17,610
تحطمت تلك السفينة الضخمة
.إلى قطع صغيرة

132
00:12:18,690 --> 00:12:23,390
إن استطعت استرجاع
،تلك السفينة الضخمة

133
00:12:23,390 --> 00:12:27,140
فسوف نستطيع الحصول
.على تلك التقنية مجددًا

134
00:12:27,840 --> 00:12:30,850
لفعل ذلك، من الضروري
.توحيد المجرة تحت حاكم واحد

135
00:12:31,330 --> 00:12:34,520
إن استطعت الحصول
،على تلك التقنية يا فيتي-ساما

136
00:12:34,520 --> 00:12:35,850
فلن تموت عندها، أليس كذلك؟

137
00:12:36,790 --> 00:12:41,610
ريتشل أداة لا غنى عنها
.لتوحيد المجرة

138
00:12:42,920 --> 00:12:44,490
هلا تشرح هذا؟

139
00:12:45,780 --> 00:12:49,160
.يملك ميشيل-ساما أخًا أكبر

140
00:12:49,160 --> 00:12:55,000
لكن أخاه قد فُقد
،خلال معركة ضد قوات فيتي

141
00:12:55,000 --> 00:12:56,790
واستسلم الجميع لفكرة أنه

142
00:12:56,790 --> 00:12:58,620
.قد لقي حتفه... -

143
00:12:57,830 --> 00:12:59,040
...أخي -

144
00:12:59,040 --> 00:13:02,240
لماذا؟ لِم قد تفعل هذا؟

145
00:13:02,240 --> 00:13:04,550
أهناك سبب يمنعك من التعريف بنفسك؟

146
00:13:12,020 --> 00:13:14,600
!إنه أخي حقًا
!لا شك أنه أخي

147
00:13:17,770 --> 00:13:19,730
.اتلُ صلاتك بسرعة

148
00:13:20,420 --> 00:13:21,320
!توقف

149
00:13:21,680 --> 00:13:22,690
!لا تفعل ذلك رجاءً

150
00:13:22,950 --> 00:13:24,740
ما الذي تفعله؟

151
00:13:50,710 --> 00:13:54,740
،مهما حدقنا
.فهناك حقائق خفيّة

152
00:13:56,360 --> 00:14:00,170
.توجد الأجوبة بالجانب الآخر للزمن

153
00:14:12,200 --> 00:14:16,160
!ميشيل! ميشيل! ميشيل! ميشيل -

154
00:14:16,160 --> 00:14:18,110
.يحظى بشعبية طاغية

155
00:14:18,110 --> 00:14:19,540
.إنه بطل بعد كل شيء

156
00:14:24,550 --> 00:14:27,050
امرأة؟

157
00:14:29,620 --> 00:14:31,580
تلك أجنحة ملاك، أليست كذلك؟

158
00:14:32,050 --> 00:14:33,870
!المنشفة بسرعة يا سيلوا

159
00:14:33,870 --> 00:14:34,970
!حاضر

160
00:14:40,350 --> 00:14:43,780
!والآن لتولد تحت ضوء النجوم

161
00:14:48,050 --> 00:14:51,200
،افتحي عينيك يا ريتشل

162
00:14:51,200 --> 00:14:56,970
وتحدثي إلى الأشخاص
،الذي كفّرتِ عن خطاياهم وأنقذتهم

163
00:14:56,970 --> 00:14:57,950
.من وراء قناعك

164
00:14:59,250 --> 00:15:01,530
.حاضر يا أبي

165
00:15:15,730 --> 00:15:18,020
.يسرني لقاؤك يا ريتشل-ساما

166
00:15:18,020 --> 00:15:21,020
أن يقف الإمبراطور المقدس
بنفس المستوى الذي تقف عليه

167
00:15:21,020 --> 00:15:24,060
،عاميّة مثلي

168
00:15:24,060 --> 00:15:26,440
...ناهيك عن أن يجثو أمامي

169
00:15:26,930 --> 00:15:30,270
،أنا مجرد شخص مثل الجميع

170
00:15:30,270 --> 00:15:35,880
وأتيتُ إلى هنا بصفتي
.المهرج الذي يحبك، حتى في أحلامي

171
00:15:40,080 --> 00:15:41,080
!إطلاق

172
00:16:02,890 --> 00:16:07,110
!السفينة الزجاجية مرعبة

173
00:16:07,110 --> 00:16:10,120
!غادر فورًا يا صاحب السعادة

174
00:16:10,120 --> 00:16:11,320
!سيدي -

175
00:16:11,000 --> 00:16:12,780
!بسرعة يا سيدي -

176
00:16:16,440 --> 00:16:19,450
.سمعتُ أن فيتي قد تخلى عنك

177
00:16:22,910 --> 00:16:24,670
،تبدين ملامح جادة

178
00:16:24,670 --> 00:16:26,830
لكنكِ في النهاية
قد هُجرتِ من طرف رجل، أليس كذلك؟

179
00:16:26,830 --> 00:16:27,690
!كليو

180
00:16:27,690 --> 00:16:30,630
!ليس هذا الوقت المناسب لذكر ذلك

181
00:16:31,060 --> 00:16:34,510
التحكم بكل حقوق وعائدات
.المناطق التجارية

182
00:16:37,080 --> 00:16:40,500
تريدون هزيمة
قوات الإمبراطور المقدس، أليس كذلك؟

183
00:16:41,270 --> 00:16:42,730
هل توافقون على ذلك؟

184
00:16:43,350 --> 00:16:48,220
ربما الشراب التالي
.الذي ستتناولينه هو نبيذ الدماء

185
00:16:50,480 --> 00:16:57,160
،أتطلع لذلك
.لكنه لن يُضاهي نبيذ باردو

186
00:17:07,460 --> 00:17:09,460
.إنهم ماكرون حقًا

187
00:17:14,930 --> 00:17:21,220
أنا الوحيد القادر على توحيد المجرة
.وإنقاذ شعوبها

188
00:17:21,920 --> 00:17:24,980
.سيجعل تعاونك هذا ممكنًا

189
00:17:25,720 --> 00:17:28,860
،منذ أن ولدتُ كابنة البابا

190
00:17:28,860 --> 00:17:31,610
.وأنا أسير على دربٍ محتوم

191
00:17:32,310 --> 00:17:37,260
أشعر الآن كأنك تريني
.نورًا في آخر ذلك الدرب

192
00:17:38,440 --> 00:17:42,680
إن قلتَ أنه يجب علينا
،السير معًا على هذا الطريق الوعر للوصول لذلك النور

193
00:17:43,140 --> 00:17:45,320
.فسأسير عليه برفقتك إذًا

194
00:17:45,320 --> 00:17:46,330
...ريتشل

195
00:17:46,330 --> 00:17:47,340
...لكن

196
00:17:49,400 --> 00:17:50,920
.لن يكون بيننا حب

197
00:17:51,490 --> 00:17:56,680
.يا لك من سيدة صادقة
،لكن كما قلتُ سابقًا

198
00:17:57,170 --> 00:18:00,680
.تصبح الكذبة حقيقة أحيانًا

199
00:18:00,680 --> 00:18:05,820
سأحوّل حبك المزيّف
.إلى حب حقيقي يومًا ما

200
00:18:11,600 --> 00:18:16,420
.إنه يستخدمها كأداة حقًا
...مجرد أداة

201
00:18:17,830 --> 00:18:22,380
.يمكنني تحمل الندم لاحقًا
.لا وقت لديّ لاسترجاع الذكريات

202
00:18:23,140 --> 00:18:28,340
،مهما بلغ بي الرعب
.سأجدف بقاربي عبر الظلام

203
00:18:36,090 --> 00:18:36,840
!فيتي-ساما

204
00:18:37,680 --> 00:18:40,510
.كنتُ بانتظار هذا يا كليو

205
00:18:48,760 --> 00:18:50,060
...هذا سيء

206
00:19:01,240 --> 00:19:05,030
ذلك الوغد... يعلم كيف يقاتل
ببراعة، أليس كذلك؟

207
00:19:05,590 --> 00:19:09,030
اعثروا على طريقة لتحرير السفينة
.برفقة ميشيل

208
00:19:10,290 --> 00:19:11,700
إلى أين أنت ذاهب؟

209
00:19:12,610 --> 00:19:14,420
.ذاهب لتسوية الأمر

210
00:19:25,710 --> 00:19:27,310
.التقينا مجددًا أخيرًا

211
00:19:27,690 --> 00:19:28,980
.آسف على التأخير

212
00:19:36,950 --> 00:19:39,590
!تستدعي الرياح العاصفة مع مرور الوقت

213
00:19:40,580 --> 00:19:44,410
!قتالنا هكذا هو قدر المجرة

214
00:19:44,760 --> 00:19:47,280
،هناك أمور في هذه المجرة يا فيتي

215
00:19:47,280 --> 00:19:50,910
.ستجدها غير قابلة للتصديق بفلسفتك

216
00:20:02,830 --> 00:20:05,260
.خسرتَ يا فيتي

217
00:20:06,960 --> 00:20:09,600
.سأقطع رأسك الآن

218
00:20:09,950 --> 00:20:11,850
!أنا رقم واحد

219
00:20:15,060 --> 00:20:17,610
.القدر قاسٍ

220
00:20:18,020 --> 00:20:20,400
،يختار الفائز والخاسر

221
00:20:20,760 --> 00:20:24,320
.ومن يكون السيد ومن لا يكون

222
00:20:24,950 --> 00:20:28,580
.لن تستطيع هزيمتي أبدًا

223
00:20:32,960 --> 00:20:36,330
.يبدو أن الرياح لم تستدعِ العاصفة

224
00:20:42,770 --> 00:20:43,970
!ميشيل

225
00:20:49,110 --> 00:20:54,350
.اندثرت الرياح وحصلتُ عليك
.يجعل هذا اليوم مميزًا

226
00:20:55,060 --> 00:20:58,250
!اصمد
!سننقذك! كن واثقًا من هذا

227
00:20:59,240 --> 00:20:59,860
!ها هم

228
00:21:29,860 --> 00:21:34,300
.نعيش عبر مجرى الزمن

229
00:21:36,190 --> 00:21:39,730
.إلى أن تنتهي رحلتنا عبر المجرة

230
00:21:39,730 --> 00:21:42,480
مثل متاهة

231
00:23:14,490 --> 00:23:18,120
.استيقاظ في وكر للمجرمين

232
00:23:18,120 --> 00:23:20,120
يسطع شعاع أمل واحد
وسط الظلام

233
00:23:20,120 --> 00:23:22,290
.ويثير مجددًا ريحًا وسط المجرة

234
00:23:22,770 --> 00:23:26,090
في الحلقة القادمة من السفينة الزجاجية
"الفجر"

235
00:23:26,090 --> 00:23:29,510
مثل الفجر

236
00:23:26,360 --> 00:23:28,940
.تعيش المجرّة ثورة. عصر نهضة