1
00:00:00,760 --> 00:00:03,970
...وعندما يصل هذا القرنُ إلى نهايته

2
00:00:03,970 --> 00:00:06,560
...في مدينةٍ صغيرة مسالمة

3
00:00:06,560 --> 00:00:09,470
.قد ولدت الأسطورة

4
00:00:22,240 --> 00:00:25,290
.لقد نسيَ أحدهم محفظةَ نقوده

5
00:00:28,960 --> 00:00:33,460
إن كانَ كيتانو هنا
.فلا يوجدُ شيءٌ لنخاف منه

6
00:00:34,460 --> 00:00:36,960
!من الذي كنتَ تصفهُ بالمثيرِ للشفقة؟

7
00:00:36,960 --> 00:00:37,960
ماذا؟

8
00:00:38,260 --> 00:00:41,470
!لا أستطيعُ تجاهل ما قد سمعتهُ منكم

9
00:00:41,800 --> 00:00:42,970
كورودا؟

10
00:00:43,180 --> 00:00:45,470
ماذا؟
!إنه كورودا

11
00:00:45,470 --> 00:00:48,980
أتحاولونَ افتعال شجار مع ثانويةِ هاكّون؟

12
00:00:48,980 --> 00:00:50,350
.شيءٌ من هذا القبيل

13
00:00:50,350 --> 00:00:53,400
...إن كنتَ تسخرُ من ثانوية هييكو لتلكَ الدرجة

14
00:00:53,400 --> 00:00:56,980
!فكيتانو لن يبقى صامتًا

15
00:00:57,480 --> 00:00:58,990
كيتانو؟

16
00:01:00,450 --> 00:01:01,490
!كورودا

17
00:01:01,490 --> 00:01:03,490
!كيتانو ليسَ موجودًا هنا

18
00:01:11,250 --> 00:01:12,460
!كيتانو؟

19
00:01:12,960 --> 00:01:16,460
هل تستخفونَ بثانوية هاكّون؟

20
00:01:25,470 --> 00:01:27,970
.كوجيما تاكيشي، عمره سبعة عشرَ عامًا

21
00:01:28,770 --> 00:01:31,180
.سأعيدها له عند الخروج من المدرسة

22
00:01:37,480 --> 00:01:38,940
!الحـ... الحافلة

23
00:01:52,790 --> 00:01:55,500
!ستفوتني الحافلة

24
00:02:14,020 --> 00:02:15,310
.كما هوَ متوقعٌ من كيتانو

25
00:02:15,310 --> 00:02:20,280
!لقد أرعبَ فتية هاكّون بنظراته وحسب
!إنهُ مذهلٌ حقًا

26
00:02:20,280 --> 00:02:22,490
.كوجيما تاكيشي

27
00:02:23,700 --> 00:02:24,990
هل تعرفه؟

28
00:02:25,780 --> 00:02:27,450
...كوجيما هو

29
00:02:27,450 --> 00:02:28,950
!زعيمُ هاكّون

30
00:02:29,450 --> 00:02:31,450
ثانوية هاكّون؟

31
00:02:32,500 --> 00:02:33,660
...كيتانو

32
00:02:33,660 --> 00:02:36,000
!ألم تكتفِ بإخافتهم؟

33
00:02:36,000 --> 00:02:37,670
هل تُخطِّط للهجوم على ثانوية هاكّون؟

34
00:02:42,960 --> 00:02:44,470
...يومٌ آخر

35
00:02:44,470 --> 00:02:47,470
...طلابي الأعزاء

36
00:02:47,510 --> 00:02:49,470
...يبدو عليهم النشاط كما هم دائمًا

37
00:02:50,470 --> 00:02:52,520
...رؤيتُهم هكذا

38
00:02:52,520 --> 00:02:56,520
.تذكرني بحظي العظيم لكوني المدير في المدرسة

39
00:03:03,280 --> 00:03:04,990
!لقد نسيت

40
00:03:04,990 --> 00:03:06,990
!ذلكَ الفتى ما زالَ هنا

41
00:03:07,030 --> 00:03:09,490
!كيتانو سيتشيرو ما زالَ هنا

42
00:03:18,460 --> 00:03:22,460
وأنتم يا رفاق، فررتم راكضينَ إلى هنا؟

43
00:03:24,300 --> 00:03:25,510
!مثيرونَ للشفقة

44
00:03:26,510 --> 00:03:27,510
!هايامي

45
00:03:27,510 --> 00:03:31,010
هل صحيحٌ بأنَّ لدى ثانويةِ هييكو زعيمٌ جديد؟

46
00:03:31,010 --> 00:03:32,010
.هذا صحيح

47
00:03:32,010 --> 00:03:33,970
...ذلكَ هو طبعُ

48
00:03:34,970 --> 00:03:35,980
.فتيةِ هييكو

49
00:03:36,980 --> 00:03:38,480
..بمجرد وجودِ زعيمٍ جديد

50
00:03:38,480 --> 00:03:39,980
أليسوا واثقينَ جدًا من أنفسهم؟..

51
00:03:42,980 --> 00:03:45,530
هل ستذهبُ إليهم يا تاكيشي؟

52
00:03:45,530 --> 00:03:50,030
.سوف أري أولئكَ الضِّعاف بأنهُم ليسوا أقوياء

53
00:03:59,500 --> 00:04:04,000
.ثانوية هاكّون كبيرةٌ حقًا

54
00:04:05,000 --> 00:04:08,010
سيكونُ من الجيد لو وجدتُ شخصًا
.يعرفُ السيد كوجيما

55
00:04:12,970 --> 00:04:14,100
من تكونُ يا هذا؟

56
00:04:15,470 --> 00:04:16,980
.أنتَ لستَ من مدرستنا

57
00:04:19,520 --> 00:04:22,020
ما الذي تفعلهُ في مكان كهذا؟

58
00:04:22,020 --> 00:04:25,320
...أنا آسف، لديَّ سؤالٌ لو سمحت

59
00:04:25,320 --> 00:04:29,030
أتعرفُ شخصًا يدعى كوجيما تاكيشي؟

60
00:04:29,700 --> 00:04:30,700
ماذا؟

61
00:04:39,500 --> 00:04:41,500
ما الذي تريدهُ من تاكيشي؟

62
00:04:41,500 --> 00:04:43,500
!أيها اللعين، من تكون؟

63
00:04:43,500 --> 00:04:48,510
أنا طالبُ سنة أولى من ثانوية هييكو
.وأدعى كيتانو سيتشيرو

64
00:04:48,510 --> 00:04:49,670
كيتانو؟

65
00:04:50,680 --> 00:04:51,680
!ذلكَ الفتى؟

66
00:04:51,680 --> 00:04:55,720
!أهو الوحش الذي سحق كورودا في اليوم الأول؟

67
00:04:56,600 --> 00:04:59,680
أتعرفُ أين هو كوجيما الآن؟

68
00:05:01,520 --> 00:05:03,520
"تستمرُّ بقول "كوجيما، كوجيما
!أنت مزعج حقًا

69
00:05:03,520 --> 00:05:06,730
!تاكيشي ليسَ الفتى الوحيد الموجودُ في هاكّون

70
00:05:06,730 --> 00:05:08,990
!الرقم اثنان في هاكّون هو هايامي

71
00:05:08,990 --> 00:05:10,490
!سأطيح بك

72
00:05:12,990 --> 00:05:16,030
"!يطيحُ بي؟"
!ما الذي يعنيه؟

73
00:05:16,030 --> 00:05:19,540
ربما يقصد أنهُ سيقودني إلى كوجيما؟

74
00:05:20,000 --> 00:05:21,000
!ما الخطب؟

75
00:05:21,000 --> 00:05:22,750
!لمَ تقفُ دون حراك؟

76
00:05:22,750 --> 00:05:25,750
!كما توقعت، سيقودني إليهِ إذًا

77
00:05:26,960 --> 00:05:28,130
!ماذا؟

78
00:05:33,010 --> 00:05:34,510
!ما أمرُ هذا الفتى؟

79
00:05:34,510 --> 00:05:37,510
!إنهُ يخطو نحوي دونَ تردد

80
00:05:38,010 --> 00:05:39,520
...الذينَ يقاتلونَ بهذه الطريقة

81
00:05:39,520 --> 00:05:42,520
!ليسوا سوى متهورينَ أو خبراءٌ في القتال..

82
00:05:43,940 --> 00:05:47,020
.تحركات هذا الفتى غريبةٌ بعضَ الشيء

83
00:05:53,990 --> 00:05:56,830
!يا لها من طريقة مضحكة في المشي

84
00:05:59,490 --> 00:06:00,540
!إنهُ يهاجم

85
00:06:10,550 --> 00:06:12,550
!تبًا، ما خطبُ هذا الفتى؟

86
00:06:12,550 --> 00:06:14,510
!مجردُ غبي إذًا؟

87
00:06:16,010 --> 00:06:17,510
...لقد أخافني كثيرًا

88
00:06:25,020 --> 00:06:28,520
!أنا مجردُ أحمق

89
00:06:28,520 --> 00:06:30,730
...لاستهزائي على طريقةِ مشي شخصٍ آخر

90
00:06:30,730 --> 00:06:33,030
!أنا شخصٌ سيئ حقًا

91
00:06:33,030 --> 00:06:35,030
!لابدَّ وأنني سأضرَب

92
00:06:35,030 --> 00:06:39,030
!هيا تقدَّم واضربني حتى يُشفى غليلُك
!أنا أستحقُّ هذا

93
00:06:46,120 --> 00:06:48,000
!كوجيما

94
00:06:57,010 --> 00:06:59,010
.لا أملكُ الوقت مع الرقم اثنان

95
00:06:59,010 --> 00:07:01,470
!أينَ هو زعيمُك؟

96
00:07:03,980 --> 00:07:06,980
ألست واثقًا من نفسك كثيرًا، يا كوجيما؟

97
00:07:07,980 --> 00:07:10,980
هل أنت زعيمُ هييكو الجديد؟

98
00:07:21,990 --> 00:07:27,040
!هل أنتَ بخير؟

99
00:07:51,020 --> 00:07:55,030
...لقد سمعت بأنَّك كُنت تلاكِم، ولكن

100
00:08:03,990 --> 00:08:06,500
.أي شيءٍ تقومُ به لا فائدة منه

101
00:08:07,040 --> 00:08:08,500
!سأسألكَ مرة أخرى

102
00:08:08,500 --> 00:08:10,500
!نادِ زعيمكَ حالاً

103
00:08:13,210 --> 00:08:14,920
...كما قلتُ لك

104
00:08:14,920 --> 00:08:18,930
.أنا بمفردي أكثر من كافٍ للإطاحة بك

105
00:08:22,430 --> 00:08:23,430
.لقد فهمت

106
00:08:36,940 --> 00:08:37,940
!كوجيما

107
00:08:40,150 --> 00:08:42,530
!كوجيما، لدينا مشكلة

108
00:08:47,910 --> 00:08:49,410
ماذا؟

109
00:08:49,410 --> 00:08:50,750
هايامي؟

110
00:08:50,750 --> 00:08:53,250
...يبدو أنهُ ليس هنا

111
00:08:53,460 --> 00:08:55,460
.الفتى الذي باستطاعته هزيمتي

112
00:09:00,680 --> 00:09:01,970
!كورودا

113
00:09:01,970 --> 00:09:02,970
!نعم؟

114
00:09:03,970 --> 00:09:07,430
:أخبر زعيمكَ كيتانو بالتالي

115
00:09:07,770 --> 00:09:10,440
.غدًا صباحًا، فليقابلني في حديقة سيوشي

116
00:09:10,440 --> 00:09:12,480
.لا يهمني كم من الأعوان ستحضرون

117
00:09:13,480 --> 00:09:14,480
...وأيضًا

118
00:09:20,950 --> 00:09:22,490
...إن فر هاربًا

119
00:09:22,490 --> 00:09:25,450
.فسأجعلهُ عاجزًا عن الحراك

120
00:09:25,450 --> 00:09:27,240
.أو شيءٍ من هذا القبيل

121
00:09:27,290 --> 00:09:30,460
...كيتانو لم يكن يعلم

122
00:09:30,460 --> 00:09:33,420
...بالمعركة الكبيرة بينَ هييكو وهاكّون

123
00:09:33,420 --> 00:09:35,420
.التي جُرَّ فيها

124
00:09:43,930 --> 00:09:44,930
...أيتها القطة

125
00:09:44,930 --> 00:09:45,930
!صباحُ الخير

126
00:09:45,930 --> 00:09:47,930
...الطقس سيئ اليوم

127
00:09:47,930 --> 00:09:50,930
.لكن يجب عليَّ إرجاعُ محفظة كوجيما

128
00:09:56,730 --> 00:09:58,440
!صباحُ الخيرِ يا كيتانو

129
00:09:58,940 --> 00:10:01,440
!صباحُ الخير يا كورودا

130
00:10:03,910 --> 00:10:06,450
أأنتَ ذاهبٌ لمقابلة كوجيما يا كيتانو؟

131
00:10:07,910 --> 00:10:10,450
!كيف علمَ بأمرِ المحفظة؟

132
00:10:10,450 --> 00:10:13,410
.كوجيما ليسَ في ثانويةِ هاكّون

133
00:10:13,410 --> 00:10:17,250
.لقد أخبرني بأنهُ سينتظرك في حديقة سيوشي

134
00:10:18,960 --> 00:10:22,470
إذًا، يمكنني مقابلتهُ في حديقة سيوشي؟

135
00:10:23,420 --> 00:10:24,430
.شكرًا لك

136
00:10:31,930 --> 00:10:33,430
!هل أنتَ ذاهِب يا كيتانو؟

137
00:10:33,430 --> 00:10:35,980
!قد يحضر معه الكثير من الأعوان كما تعلم

138
00:10:38,980 --> 00:10:41,360
.حتى ولو
...إن كانَ كوجيما ينتظر

139
00:10:41,360 --> 00:10:43,070
.فيجب عليَّ الذهاب

140
00:10:46,700 --> 00:10:47,740
ما الخطب؟

141
00:10:47,740 --> 00:10:48,740
!كورودا

142
00:10:51,240 --> 00:10:52,660
!أيها اللعينان

143
00:10:53,450 --> 00:10:56,580
!ألا يمكنكما فهمُ مشاعر كيتانو؟

144
00:10:56,960 --> 00:11:01,550
!كيتانو ذاهبٌ لحمايتنا من استهدافِ هاكّون لنا

145
00:11:01,550 --> 00:11:05,470
!حتى وإن خسرَ في قتاله معه

146
00:11:05,470 --> 00:11:09,430
...ورغمَ ذلك، وجههُ يبدو غير مبال بأيِّ شيء

147
00:11:09,430 --> 00:11:12,720
.لكن في الحقيقة، لقد كانَ يفكرُ في مصلحتنا

148
00:11:12,810 --> 00:11:14,640
.مرحبًا أيها الأغبياءُ الثلاثة

149
00:11:14,640 --> 00:11:15,480
!ماذا؟

150
00:11:15,480 --> 00:11:18,730
مهما جلبوا من أعوان
.سيقفون عثرةً في الطريق وحسب

151
00:11:18,730 --> 00:11:21,150
.لذا لا تفكروا في المجيء رجاءً

152
00:11:21,150 --> 00:11:22,150
!ماذا تقول؟

153
00:11:24,440 --> 00:11:26,150
!تاكيهيسا

154
00:11:26,450 --> 00:11:30,160
ما هذا الهراء الذي تتفوه به
!ووجهك مُدمًى بالجروح هكذا؟

155
00:11:30,160 --> 00:11:32,450
.صباحُ الخيرِ يا كيتانو

156
00:11:36,960 --> 00:11:37,960
ماذا؟

157
00:11:37,960 --> 00:11:40,960
!ما الذي حدثَ لوجه تاكيهيسا؟

158
00:11:40,960 --> 00:11:45,170
أيعقل أنه حاول الانتحارَ مجددًا بعدما ذهبت عنه؟

159
00:12:11,990 --> 00:12:14,450
.تاكيشي، إنهم هنا

160
00:12:14,450 --> 00:12:16,450
.ذلكَ هو زعيم هييكو الجديد

161
00:12:30,470 --> 00:12:33,350
.إنهُم واثقون جدًا بأنفسهم

162
00:12:38,430 --> 00:12:40,440
!لقد حضر الكثيرُ منهم

163
00:12:40,440 --> 00:12:44,480
إن كنتم خائفين
...فلترجعوا إلى منازلكم حالاً

164
00:12:44,480 --> 00:12:46,280
.أيها الأغبياءُ الثلاثة

165
00:12:46,280 --> 00:12:47,280
!ماذا؟

166
00:12:48,490 --> 00:12:49,990
من سيكونُ خائفًًا في موقف كهذا؟

167
00:12:50,490 --> 00:12:51,450
...هؤلاء جميعهم

168
00:12:51,450 --> 00:12:53,450
!نحن الثلاثة يمكننا تولي أمرهم

169
00:12:53,450 --> 00:12:55,450
.ماذا؟ يعتمدُ عليكم حقًا

170
00:12:55,870 --> 00:12:57,950
.لنفعلها إذًا

171
00:12:59,460 --> 00:13:03,000
.سأطيحُ أنا بالرقم اثنان لديهم

172
00:13:06,500 --> 00:13:07,590
.كيتانو

173
00:13:07,590 --> 00:13:10,590
...لابدَّ وأن كوجيما يشعرُ بالوحدة كثيرًا

174
00:13:10,590 --> 00:13:14,970
مع أننا هنا لإعادة محفظته وحسب
!إلا أنه جلبَ هذا الحشد معه

175
00:13:15,470 --> 00:13:16,470
.كيتانو

176
00:13:17,430 --> 00:13:21,480
.أنا والأغبياءُ الثلاثة سنشغلُ قليلي الشأن

177
00:13:21,480 --> 00:13:24,980
!لقد أخبرتكَ بالتوقف عن منادتنا بذلك

178
00:13:27,480 --> 00:13:30,440
...بالأمس، لقد عرفتُ مكانتي

179
00:13:31,950 --> 00:13:33,950
.أنا أعتمدُ عليك بالإطاحة بكوجيما

180
00:13:37,990 --> 00:13:39,500
...حـ... حسنًا

181
00:13:39,500 --> 00:13:43,000
في نهاية الأمر
أنا الوحيد الذي يملكُ مُبتغى كوجيما

182
00:13:48,960 --> 00:13:50,460
!هيا بنا أيها الأغبياءُ الثلاثة

183
00:13:50,460 --> 00:13:52,970
!أيها اللعين، توقف عن هذا

184
00:13:54,180 --> 00:13:55,510
!هل سيقاتلونا حقًا؟

185
00:13:55,510 --> 00:13:56,800
!عددهُم خمسة فقط

186
00:14:02,270 --> 00:14:03,980
!لقد فعلتها أيها النذل

187
00:14:03,980 --> 00:14:06,940
!أيها الوضيع، لا تستخفف بثانوية هاكّون

188
00:14:10,990 --> 00:14:12,070
!ذلكَ الأحمق

189
00:14:12,490 --> 00:14:14,490
!يجبُ علينا قتالهم الآن

190
00:14:23,500 --> 00:14:25,880
!ماذا؟! ما الذي يحصل؟

191
00:14:27,500 --> 00:14:29,880
!على أيِّ حال، يجبُ علي إيقافهم

192
00:14:42,480 --> 00:14:45,480
.سأردُّ لك دين البارحة

193
00:14:45,980 --> 00:14:46,980
!ترد؟

194
00:14:48,980 --> 00:14:51,780
!لقد فهمت، إنهُ يقصد المحفظة

195
00:14:51,780 --> 00:14:53,990
!لابدَّ أنه كوجيما

196
00:15:05,000 --> 00:15:06,000
.أنا آسف

197
00:15:07,830 --> 00:15:10,500
.يبدو أنني نسيتُ وضعها في حقيبتي

198
00:15:20,180 --> 00:15:21,470
!انهض أيها الوضيع

199
00:15:21,470 --> 00:15:24,310
!حتى وإن توسلتَ الآن، لن أسامحك

200
00:15:29,980 --> 00:15:33,280
!تشكلية المثلث ألفا

201
00:15:36,400 --> 00:15:37,320
!واحد

202
00:15:37,610 --> 00:15:38,780
!اثنان

203
00:15:39,620 --> 00:15:40,410
!ثلاثة

204
00:15:40,910 --> 00:15:41,910
!حسنًا

205
00:15:45,910 --> 00:15:47,420
.ليسوا بسيئين

206
00:16:01,890 --> 00:16:03,390
...لا تقف في طريقي

207
00:16:03,390 --> 00:16:04,390
!أيها حثالة

208
00:16:05,890 --> 00:16:07,390
...انظر من يتكلم

209
00:16:07,390 --> 00:16:08,390
.الرقمُ اثنان

210
00:16:17,400 --> 00:16:18,610
.ابتعد عن طريقي

211
00:16:19,110 --> 00:16:20,700
...إن لم تفعل

212
00:16:20,700 --> 00:16:22,410
!سوفَ أقطعك

213
00:16:22,910 --> 00:16:23,620
.يا الهي

214
00:16:23,620 --> 00:16:24,910
.إنكَ أحمق

215
00:16:25,620 --> 00:16:27,910
!أنتَ لستَ الوحيد الذي يمتلكُ ذلك

216
00:16:28,410 --> 00:16:30,920
.أنتَ من أخرجها أولاً

217
00:16:31,420 --> 00:16:33,920
.فلتتحمَّل مسؤولية ذلك

218
00:16:39,130 --> 00:16:40,430
ما خطبُ هذا الفتى؟

219
00:16:40,430 --> 00:16:41,930
...لم يقم بمهاجمتي ولو لمرة

220
00:16:41,930 --> 00:16:43,930
هل يخطط لشيء ما؟

221
00:16:46,890 --> 00:16:49,640
.لقد فهمت، لقد نسيتُ محفظته

222
00:16:49,640 --> 00:16:51,940
.من الواضحِ أنه يلكمني بسبب نسياني لها

223
00:17:01,950 --> 00:17:03,450
دم ينزفُ من رسغه؟

224
00:17:13,420 --> 00:17:14,420
!ماذا؟

225
00:17:17,420 --> 00:17:19,420
!ندبة على وجهه؟

226
00:17:19,420 --> 00:17:21,970
!من يكون هذا الرجل بالضبط؟

227
00:17:24,600 --> 00:17:27,390
...الندبة على وجهِ كيتانو

228
00:17:27,390 --> 00:17:29,600
.كانت غير ملحوظة بتاتاً..

229
00:17:29,600 --> 00:17:34,400
لكن في بعضِ أوقات الشدائد
.تكونُ الندبة واضحة للعيان

230
00:17:36,940 --> 00:17:40,440
!تاكيهيسا يحاول قتل نفسه مجددًا

231
00:17:51,250 --> 00:17:52,410
!أتحاول الهرب؟

232
00:17:59,460 --> 00:18:01,420
!ذلكَ النزيف

233
00:18:01,880 --> 00:18:05,430
لا تفعل ذلك يا تاكيهيسا
!لا تقتل نفسك

234
00:18:05,590 --> 00:18:08,430
!يجبُ أن تثمِّن حياتك

235
00:18:08,600 --> 00:18:11,890
!إنها حياتكَ الوحيدة المعطاة لك من والديك

236
00:18:11,890 --> 00:18:13,440
!تاكيهيسا

237
00:18:23,900 --> 00:18:28,950
!لا تمُت

238
00:18:25,410 --> 00:18:26,910
!تاكيهيسا

239
00:18:43,380 --> 00:18:44,430
!تاكيشي

240
00:18:45,720 --> 00:18:47,930
!تاكيشي، استيقظ هيا

241
00:18:48,970 --> 00:18:51,970
!تاكيشي، تاكيشي

242
00:18:55,770 --> 00:18:56,980
.لقد خسرنا

243
00:18:56,980 --> 00:18:59,150
.زعيمهم قد طرح زعيمنا

244
00:18:59,150 --> 00:19:05,950
!هذا القتال... قد خسرناه... نحن الهاكّون قد خسرنا

245
00:19:15,500 --> 00:19:16,500
المحفظة؟

246
00:19:16,500 --> 00:19:21,460
هذا صحيح
!لقد وضعتُ المحفظة في جيب سترتي

247
00:19:21,960 --> 00:19:22,960
!كيتانو

248
00:19:23,460 --> 00:19:24,970
!هل أنتَ بخير؟

249
00:19:24,970 --> 00:19:25,970
تاكيهيسا، رسغك؟

250
00:19:26,380 --> 00:19:29,970
...جرحي ليس مهمًا، الأهم من هذا

251
00:19:29,970 --> 00:19:32,010
!حمدًا لله

252
00:19:34,480 --> 00:19:35,980
كيتانو؟

253
00:19:41,940 --> 00:19:46,990
حتى وإن كان ذلك لمصلحة تاكيشي
!أنا آسفٌ لأنني ضربتك

254
00:19:48,990 --> 00:19:55,950
.عندما نتقابلُ ثانية؛ سوف نبدأ من جديد

255
00:20:08,470 --> 00:20:10,680
!ما هذا الوغد اللعين؟

256
00:20:11,970 --> 00:20:15,930
أيحاول القول بأن قتال اليوم لم يكن كافيًا؟

257
00:20:17,980 --> 00:20:18,980
...ذلكَ الفتى

258
00:20:19,480 --> 00:20:21,980
.ليس عاديًا

259
00:20:31,780 --> 00:20:34,280
...لأنهُ أراد إعادة محفظة ضائعة

260
00:20:35,790 --> 00:20:37,790
...من أجل شيء صغير كهذا

261
00:20:37,790 --> 00:20:43,790
.رهبة أسطورة كيتانو سيتشرو ازدادت أكثر

262
00:20:47,550 --> 00:20:48,760
...ساعدونا رجاءً

263
00:20:48,760 --> 00:20:50,260
...إن مدرستي

264
00:20:50,300 --> 00:20:53,260
!ثانويةُ هييكو

265
00:20:54,260 --> 00:20:55,260
.لقد فهمنا

266
00:20:55,970 --> 00:21:00,770
.سوف أهتم بأمر الطالب كما طلبت

267
00:21:00,770 --> 00:21:01,770
.إلى اللقاء

268
00:23:51,360 --> 00:23:53,070
.كويسو ريوكو

269
00:23:53,070 --> 00:23:55,070
.تدربت على أسلوب كوبودو

270
00:23:55,070 --> 00:23:57,070
.فتاة متقنة للفنون القتالية