1
00:00:02,230 --> 00:00:04,350
محلّ عقاقير كيريو

2
00:00:03,250 --> 00:00:04,350
.أيّها المدير

3
00:00:04,680 --> 00:00:06,310
هل يمكنني أخذ جرعات الطّاقة لهذا الأسبوع؟

4
00:00:06,680 --> 00:00:08,020
.أكيد، ها هو طلبك المعتاد

5
00:00:08,020 --> 00:00:08,880
.تفضّلي

6
00:00:08,880 --> 00:00:10,450
.شكرًا أيّها المدير

7
00:00:10,450 --> 00:00:12,660
.سأعود الأسبوع القادم. إلى اللّقاء

8
00:00:12,660 --> 00:00:13,390
.نعم

9
00:00:14,670 --> 00:00:17,280
.أيّها المدير، لديك زبون

10
00:00:19,320 --> 00:00:23,000
هل أنت هو السّيّد ريجي؟

11
00:00:23,320 --> 00:00:26,440
.نعم، إنّه أنا

12
00:00:26,440 --> 00:00:27,330
رو؟

13
00:01:58,570 --> 00:02:01,160
.أُدعى رين

14
00:02:01,160 --> 00:02:06,350
أنا الخادم الّذي يعمل لدى
.السّيّد كاستي فن دران فالغاس

15
00:02:06,350 --> 00:02:07,400
.حسنًا

16
00:02:07,400 --> 00:02:09,880
كاس-إن-ترا؟

17
00:02:09,880 --> 00:02:12,890
.يا آنسة نويلا، لنلتزم الصّمت الآن

18
00:02:12,890 --> 00:02:13,520
...رو

19
00:02:13,520 --> 00:02:17,650
وصلتني تعليمات بدعوتك إلى القصر
،من طرف سيّدتي فلام

20
00:02:17,650 --> 00:02:22,490
.زوجة كبير عائلة فالغاس

21
00:02:22,490 --> 00:02:23,230
ماذا؟

22
00:02:23,230 --> 00:02:27,210
يا سيّد ريجي، لا فكرة لديّ أنّك صرت
.مقرّبًا لهذا الحدّ من امرأة أخرى

23
00:02:27,210 --> 00:02:31,710
.ليس ذلك فحسب، لكنّها زوجة أحد ما
.إنّها امرأة متزوّجة

24
00:02:31,710 --> 00:02:33,880
أيّها المدير، ما هي المرأة المتزوّجة؟

25
00:02:33,880 --> 00:02:35,650
.لا تقلقي حيال ذلك يا نويلا

26
00:02:35,650 --> 00:02:38,860
.ولا تسمحي لخيالك أن يجمح كثيرًا يا مينا

27
00:02:38,860 --> 00:02:41,840
أنا آسف، لكن من أنت؟

28
00:02:42,190 --> 00:02:44,010
ألا تعلم أيّها المدير؟

29
00:02:44,010 --> 00:02:49,890
الكونت كاستي فن دران فالغاس
.هو السّيّد الّذي يحكم كالتا وقريتنا

30
00:02:49,890 --> 00:02:50,390
.تمامًا

31
00:02:50,730 --> 00:02:52,940
أتعني أنّه من النّبلاء؟

32
00:02:52,940 --> 00:02:54,150
.بالضّبط

33
00:02:54,150 --> 00:02:56,110
وما حاجة أشخاص مثلهم بي أنا؟

34
00:02:56,110 --> 00:03:01,570
قالت سيّدتي فلام أنّها ستخبرك
.عن الأمر عندما تلتقيان شخصيًّا

35
00:03:01,570 --> 00:03:06,830
يا سيّد ريجي، عليك أن توضّح الأمور
.معها قبل أن تصير أكثر جدّيّة

36
00:03:06,830 --> 00:03:07,370
ماذا؟

37
00:03:07,370 --> 00:03:08,580
.من هنا رجاءً

38
00:03:08,580 --> 00:03:09,700
عربة؟

39
00:03:09,700 --> 00:03:10,430
!إنّها سريعة

40
00:03:10,430 --> 00:03:11,370
!هذا ضخم

41
00:03:12,010 --> 00:03:15,340
أنت هو الخيميائيّ العبقريّ
الّذي يتحدّث الجميع عنه؟

42
00:03:15,340 --> 00:03:20,300
.ليس تمامًا، ولكن أظنّني من يقصدونه

43
00:03:20,750 --> 00:03:23,280
ماذا بإمكاني فعله مع أجلك؟

44
00:03:23,280 --> 00:03:26,010
.قال خادمك أنّك ستخبريني مباشرة

45
00:03:26,480 --> 00:03:29,080
.اسمح لي أن أكون صريحة

46
00:03:29,080 --> 00:03:31,930
.أريدك أن تجهّز مرهمًا لإعادة الشّباب

47
00:03:31,930 --> 00:03:34,050
مرهم لإعادة الشّباب؟

48
00:03:34,050 --> 00:03:35,230
أتقدر على ذلك؟

49
00:03:35,230 --> 00:03:38,890
نعم. كم من الوقت لديّ لأطوّره؟

50
00:03:38,890 --> 00:03:39,620
.خمسة أيّام

51
00:03:39,620 --> 00:03:40,280
خمسة؟

52
00:03:40,280 --> 00:03:43,550
،لا، بما أنّ حفلة العشاء بعد خمسة أيّام

53
00:03:43,550 --> 00:03:46,870
فهلاّ أحضرته إلى هنا في الظّهيرة
بعد خمسة أيّام؟

54
00:03:48,220 --> 00:03:50,010
.هذه ليست مدّة كافية

55
00:03:50,010 --> 00:03:53,190
هل تقول أنّ عليّ تحمّل نميمة الأسياد

56
00:03:53,190 --> 00:03:56,000
حيال كم أبدو عجوزًا من وراء ظهري ثانية؟

57
00:03:57,080 --> 00:04:01,920
.إنّهم مخطئون. إنّك يافعة وجميلة يا سيّدة فلام

58
00:04:02,280 --> 00:04:04,010
فعلاً؟

59
00:04:04,330 --> 00:04:08,430
.نعم. إنّك فائقة الجمال تمامًا كما أنت

60
00:04:10,040 --> 00:04:15,650
لكن لا فائدة من ذلك. يظلّ هذا
.رأيك أنت وليس رأيهم أيضًا

61
00:04:16,190 --> 00:04:20,840
فهمت. بمجرّد أن ينشر أحدهم نميمة
.سيّئة عنها، تفقد ثقتها بنفسها

62
00:04:21,440 --> 00:04:24,860
كان هذا يحدث معي أيضًا طوال
.الوقت في العالم الآخر

63
00:04:24,860 --> 00:04:28,600
رجاءً أيّها الخيميائيّ. ألا تستطيع فعل أيّ شيء؟

64
00:04:28,600 --> 00:04:30,080
.سأدفع لك قدر ما تشاء بسخاء

65
00:04:30,080 --> 00:04:35,670
أطلب فقط أن تدفعي مقابل عملي
.بإنصاف بمجرّد تطوير مرهمك

66
00:04:35,670 --> 00:04:37,960
هذا يعني أنّك ستصنعه؟

67
00:04:37,960 --> 00:04:38,620
...إنّ

68
00:04:39,310 --> 00:04:41,070
ما الّذي فعلت؟

69
00:04:42,330 --> 00:04:46,390
.حسنًا. سأبذل ما بوسعي

70
00:04:46,390 --> 00:04:47,970
،حتّى إن لم أستطع تجديد شبابك

71
00:04:47,970 --> 00:04:50,430
.بإمكاني تطوير دواء يجعلك تبدين يافعة أكثر

72
00:04:50,430 --> 00:04:54,850
.أجل، أجل. سيقاوم تأثيرات التّقدّم في العمر

73
00:04:54,850 --> 00:04:56,560
.لن يكون شيئًا إعجازيًّا هكذا

74
00:04:56,910 --> 00:05:01,080
.إنّك خيميائيّ عبقريّ بالفعل بتحدّيك لتدابير الإله

75
00:05:04,570 --> 00:05:06,280
محلّ عقاقير كيريو

76
00:05:06,670 --> 00:05:07,990
.حسنًا

77
00:05:07,990 --> 00:05:09,780
.جمعت كلّ المكوّنات

78
00:05:10,630 --> 00:05:15,410
يبدو أنّه قد طُلب من السّيّد ريجي
.إعداد دواء ما كتعويض

79
00:05:15,410 --> 00:05:16,480
تعويض؟

80
00:05:16,480 --> 00:05:20,290
أنا آسفة. لستِ بحاجة لمعرفة
.تلك الكلمة يا آنسة نويلا

81
00:05:20,290 --> 00:05:21,500
رو؟

82
00:05:41,310 --> 00:05:42,820
.انتهيت

83
00:05:42,820 --> 00:05:44,860
.هلام الجميلة لبشرة جميلة

84
00:05:44,860 --> 00:05:47,470
.إنّه يرطّب البشرة ويُجمّلها

85
00:05:47,470 --> 00:05:50,910
.يحبس الرّطوبة في الدّاخل ويجعل البشرة نضرة

86
00:05:52,060 --> 00:05:53,910
.أتيتُ لأوصل الدّواء

87
00:05:55,140 --> 00:05:56,120
هذا هو؟

88
00:05:56,120 --> 00:05:59,830
.نعم. ضعيه على وجهك كلّ يوم بعد الاستحمام رجاءً

89
00:05:59,830 --> 00:06:01,050
وجهي؟

90
00:06:01,580 --> 00:06:06,260
هل تحاول خداعي أيّها الخيميائيّ؟

91
00:06:07,350 --> 00:06:10,420
.إذًا تظاهري أنّك وقعتِ ضحيّة لخدعتي وجرّبيه

92
00:06:10,420 --> 00:06:12,680
.لست بحاجة لتدفعي لي إن لم ينجح

93
00:06:17,290 --> 00:06:18,480
.رائحته زكيّة

94
00:06:18,480 --> 00:06:21,620
.إنّه يحتوي زهورًا وفواكه

95
00:06:21,620 --> 00:06:23,800
.جرّبيه على ظهر يدك

96
00:06:28,200 --> 00:06:31,730
.إنّ بشرتي امتصّته بسهولة

97
00:06:32,830 --> 00:06:35,200
.لكنّي متردّدة قليلاً من وضعه على وجهي

98
00:06:35,770 --> 00:06:40,860
ليس أنا من سيعاني من الإحباط
.والحزن خلال حفل العشاء، بل أنت

99
00:06:41,330 --> 00:06:44,840
.لا بأس إن كنتِ لا تريدين استعماله

100
00:06:46,360 --> 00:06:49,080
.سأجرّبه إذًا بما أنّك مصرّ هكذا

101
00:06:49,700 --> 00:06:54,390
.سئمت كوني محطّ سخريتهم

102
00:06:54,390 --> 00:06:58,310
.هذا صحيح. نالي ممّن سخروا منك

103
00:06:58,310 --> 00:06:59,280
.نعم

104
00:07:00,650 --> 00:07:03,350
.أنا متحمّسة لحفل العشاء سلفًا

105
00:07:12,750 --> 00:07:17,060
محلّ العقاقير كيريو

106
00:07:12,750 --> 00:07:17,060
يا سيّد ريجي، هل اهتممتَ بتلك المسألة سلفًا؟

107
00:07:17,060 --> 00:07:18,290
أيّ مسألة؟

108
00:07:18,290 --> 00:07:22,620
.تلك المسألة مع المرأة النّبيلة

109
00:07:23,000 --> 00:07:26,000
.علاقتك الغراميّة يا سيّدي ريجي

110
00:07:26,000 --> 00:07:29,710
...لم تذهب لقصرها مؤخّرًا، لذلك

111
00:07:29,710 --> 00:07:32,510
ماذا؟ ما زالت تعتقد أنّ ذلك ما حدث؟

112
00:07:32,950 --> 00:07:34,470
.رو. وصل أحد ما

113
00:07:36,930 --> 00:07:39,270
.رو. لقد أعطوني هذا أيّها المدير

114
00:07:39,270 --> 00:07:40,850
أعطوك ماذا؟

115
00:07:40,850 --> 00:07:44,060
.مذهل، يبدو هذا الكعك غاليًا

116
00:07:44,380 --> 00:07:48,990
بفضلك أيّها الخيميائيّ، تمكّنت
.من النّيل من أولئك الأسياد

117
00:07:48,990 --> 00:07:49,950
.شكرًا لك

118
00:07:49,950 --> 00:07:52,520
.هكذا إذًا. سار الأمر على خير

119
00:07:52,520 --> 00:07:54,070
.أسعدني هذا

120
00:07:54,870 --> 00:07:57,340
.إنّه لذيذ، لذيذ

121
00:07:57,340 --> 00:07:59,710
.يا لها من نكهات نبيلة

122
00:07:59,710 --> 00:08:02,120
،يبدو أنّ النّاس ما زالوا مرتبكين

123
00:08:02,720 --> 00:08:06,380
.لكن إن كانوا راضين، فأنا راضٍ

124
00:08:06,380 --> 00:08:08,040
.يا لها من بشرة جميلة

125
00:08:17,050 --> 00:08:20,220
.أيّها المدير، أيّها المدير. لفائف هنا

126
00:08:20,220 --> 00:08:21,280
لفائف؟

127
00:08:21,280 --> 00:08:24,330
.نعم. الآنسة ذات الشّعر الملولب تبحث عنك

128
00:08:25,020 --> 00:08:26,730
شعر ملولب؟

129
00:08:26,730 --> 00:08:28,140
كيف حالك؟

130
00:08:28,140 --> 00:08:31,820
.أنا إلين فن دران فالغاس

131
00:08:32,700 --> 00:08:35,350
.أظنّني سمعت اسمك مؤخّرًا

132
00:08:35,350 --> 00:08:37,500
.إنّها من تلك العائلة النّبيلة يا سيّد ريجي

133
00:08:37,500 --> 00:08:39,050
.نعم، صحيح

134
00:08:39,050 --> 00:08:44,060
يا سيّد ريجي، ما زلت لم تحلّ
مسألتك مع تلك المرأة بعد؟

135
00:08:44,060 --> 00:08:46,540
وها قد ورّطت ابنتها في الأمر؟

136
00:08:46,540 --> 00:08:48,250
!أخبرتك أنّ الأمر ليس هكذا

137
00:08:48,250 --> 00:08:48,590
.رو

138
00:08:49,170 --> 00:08:53,830
هلا أظهرتم احترامًا أكثر؟

139
00:08:53,830 --> 00:08:58,250
قطعتُ مسافة بعيدة إلى هذا المكان
.النّائي وحدي لأشرّفكم بحضوري

140
00:08:58,250 --> 00:08:59,740
تشرّفينا بحضورك؟

141
00:08:59,740 --> 00:09:02,010
.لم يطلب أيّ أحد منك المجيء

142
00:09:02,010 --> 00:09:04,690
.حسنًا يا آنسة نويلا. تعالي معي

143
00:09:04,690 --> 00:09:06,610
،اسمعي يا آنستي

144
00:09:06,610 --> 00:09:11,330
،إن كنت تريدين أن تُعاملي باحترام
.فعليك أن تظهريه أنت أوّلاً

145
00:09:11,330 --> 00:09:13,320
.تلك أوّل خطوة نحو الرّشد

146
00:09:13,920 --> 00:09:15,820
!لا تعاملني وكأنّي طفلة

147
00:09:15,820 --> 00:09:16,690
ماذا؟

148
00:09:16,690 --> 00:09:20,600
سنحضر أنا وأبي حفل عشاء معًا
.في اليوم ما بعد الغد

149
00:09:20,600 --> 00:09:22,710
.أنا سيّدة حقيقيّة

150
00:09:22,710 --> 00:09:24,290
.فـ-فهمت

151
00:09:25,260 --> 00:09:27,640
حسنًا، هل أتيتِ إلى هنا لشراء شيء ما؟

152
00:09:27,640 --> 00:09:29,140
هل ادّخرتِ ما يكفي من مصروفك؟

153
00:09:29,140 --> 00:09:31,130
أم أنّ أمّك طلبت منك شراء شيء ما؟

154
00:09:31,130 --> 00:09:33,770
.لستُ هنا لأشتري أغراضًا لأمّي

155
00:09:33,770 --> 00:09:39,680
.أتيتُ إلى هنا لأطلب منك صناعة دواء لي

156
00:09:39,680 --> 00:09:41,180
لديك طلب لي؟

157
00:09:41,620 --> 00:09:47,440
ساعد الدّواء الّذي صنعتَه على
.تجديد شباب أمّي لدرجة كبيرة

158
00:09:47,440 --> 00:09:51,720
لذلك بطبيعة الحال، ستكون قادرًا
.على صناعة شيء ما لي أيضًا

159
00:09:51,720 --> 00:09:54,300
.يعتمد ذلك على الوقت وطبيعة الدّواء

160
00:09:54,300 --> 00:09:56,780
—في اليوم ما بعد الغد، أريد جرعة قد

161
00:09:56,780 --> 00:09:58,890
.مستحيل. لا يمكنني القيام بذلك من أجلك

162
00:09:58,890 --> 00:10:03,530
لماذا؟ أتقول أنّ بإمكانك تلبية
طلبات أمّي وطلباتي أنا لا؟

163
00:10:03,530 --> 00:10:05,200
—اسمعي، إنّك

164
00:10:05,200 --> 00:10:06,370
.اسمي إلين

165
00:10:07,640 --> 00:10:09,980
—اسمعي يا إلين

166
00:10:09,980 --> 00:10:11,790
.بل آنسة إلين لو سمحت

167
00:10:12,240 --> 00:10:17,340
.يا آنسة إلين، لا تحتاجين جرعة حبّ لتكوني ظريفة

168
00:10:17,340 --> 00:10:19,210
.أنت آنسة جذّابة بالفعل

169
00:10:19,210 --> 00:10:20,970
.أعلم ذلك

170
00:10:20,970 --> 00:10:22,850
.لم تحاول حتّى نكران ذلك

171
00:10:24,170 --> 00:10:31,660
لكنّ السّيّد لارس من عائلة غالارد
.سيحضر حفل العشاء

172
00:10:32,100 --> 00:10:34,780
...لكن... أنا

173
00:10:34,780 --> 00:10:37,990
فهمت. لهذا السّبب تريدين جرعة حبّ؟

174
00:10:37,990 --> 00:10:41,630
.نعم. الأمر ليس كما تظنّ

175
00:10:41,630 --> 00:10:44,740
.السّيّد لارس هو الابن الثّاني لكونت

176
00:10:44,740 --> 00:10:48,180
.إنّ عائلتينا من نفس المستوى

177
00:10:48,180 --> 00:10:56,050
،إن كان الأمر متعلّقًا بي
.بإمكاني الحصول على رجل أفضل

178
00:10:56,370 --> 00:11:00,760
.فهمت. أنت آنسة جذّابة قبل كلّ شيء

179
00:11:01,110 --> 00:11:03,400
أنت تسخر منّي، صحيح؟

180
00:11:03,400 --> 00:11:04,590
ألاحظتِ؟

181
00:11:04,590 --> 00:11:06,220
!كن محترمًا أكثر وانكر الأمر

182
00:11:07,360 --> 00:11:08,580
.آسف، آسف

183
00:11:08,580 --> 00:11:12,030
مهلاً، عليك أخذ النّاس على محمل
!الجدّ أكثر وهم يتكلّمون

184
00:11:12,030 --> 00:11:14,290
.يبدو أنّها مستمتعة بوقتها

185
00:11:14,890 --> 00:11:15,880
رو؟

186
00:11:17,680 --> 00:11:23,660
لنفترض أنّك استعملت جرعة حبّ
.ووقع السّيّد لارس في هواك

187
00:11:23,660 --> 00:11:24,490
.حسنًا

188
00:11:24,490 --> 00:11:30,130
.تفضّلي. إنّها هديّة من أمّك في الحقيقة

189
00:11:30,130 --> 00:11:31,420
.رو

190
00:11:30,990 --> 00:11:31,830
.آنسة نويلا

191
00:11:32,610 --> 00:11:33,380
...رو

192
00:11:34,980 --> 00:11:39,480
حسنًا، لنفترض أنّه أحبّك. فماذا بعد؟

193
00:11:40,140 --> 00:11:45,060
لن يظلّ واقعًا في حبّك ما لم
.تواصلي شرب جرعة الحبّ

194
00:11:45,930 --> 00:11:49,870
ألا توجد طريقة أخرى بإمكانك العمل
عليها بدل الحصول على جرعة حبّ؟

195
00:11:51,210 --> 00:11:55,060
ماذا بإمكاني فعله لجذب انتباه السّيّد لارس؟

196
00:11:55,450 --> 00:11:56,160
ماذا؟

197
00:11:57,890 --> 00:12:00,870
.لا خبرة لديّ في هذا المجال

198
00:12:00,870 --> 00:12:02,620
.لكن عليّ إخبارها بأمر ما

199
00:12:04,810 --> 00:12:10,020
.حسنًا... إنّ ذلك... صحيح

200
00:12:10,020 --> 00:12:11,690
،لا يمكنني صناعة جرعة حبّ

201
00:12:11,690 --> 00:12:16,290
لكن قد يكون بمقدوري صناعة
.دواء سيجعلك أكثر جاذبيّة

202
00:12:16,620 --> 00:12:18,880
فعلاً؟ أبإمكانك ذلك؟

203
00:12:19,230 --> 00:12:20,650
.نـ-نعم

204
00:12:22,910 --> 00:12:28,170
ربّما لا أملك مهارات رومانسيّة، لكن لديّ
.مهارات في صناعة الأدوية في هذا العالم

205
00:12:28,170 --> 00:12:33,460
.كم هذا مذهل. بإمكانك تحريك أذنيك وذيلك

206
00:12:33,460 --> 00:12:35,810
.هذه أوّل مرّة أرى فيها وحشًا صغيرًا

207
00:12:35,810 --> 00:12:37,710
!أنا لستُ وحشًا

208
00:12:38,420 --> 00:12:40,440
وكيف يمكن ألاّ تكوني سوى وحش؟

209
00:12:40,440 --> 00:12:42,240
!أنا مستذئبة

210
00:12:42,990 --> 00:12:44,240
وأين الفرق؟

211
00:12:44,240 --> 00:12:45,770
!بل هناك فرق

212
00:12:45,770 --> 00:12:47,200
.مهلاً، مهلاً

213
00:12:47,810 --> 00:12:50,620
!أيّها المدير، أنا لا أحبّها

214
00:12:51,440 --> 00:12:54,290
.لديك كرامة مستذئب

215
00:12:54,290 --> 00:12:56,840
ماذا عنّي يا آنسة نويلا؟

216
00:12:56,840 --> 00:12:58,810
.أنا أحبّك

217
00:12:58,810 --> 00:13:00,300
.مرحى

218
00:13:01,200 --> 00:13:03,240
.حسنًا. أحتاج لإضافة اللّمسات الأخيرة فقط

219
00:13:13,550 --> 00:13:14,490
.انتهيت

220
00:13:14,490 --> 00:13:16,170
.عطر السّحر

221
00:13:16,170 --> 00:13:19,230
.إنّه عطر برائحة فواكه منعشة

222
00:13:20,900 --> 00:13:22,190
.رائحته جيّدة

223
00:13:23,900 --> 00:13:26,840
هل انتهيت من جرعة الحبّ؟

224
00:13:26,840 --> 00:13:30,460
.لمعلوماتك فحسب، إنّها ليست جرعة حبّ

225
00:13:30,460 --> 00:13:31,660
.إليك تأثيراته

226
00:13:33,300 --> 00:13:36,580
ماذا؟ "عطر عاديّ ذو رائحة جيّدة"؟

227
00:13:36,580 --> 00:13:38,850
،نعم. قد يكون عطرًا عاديًّا

228
00:13:38,850 --> 00:13:42,050
،لكن إن استعملتِه حسب الإرشادات
.فسترتقين كسيّدة

229
00:13:43,220 --> 00:13:44,860
...أرتقي

230
00:13:45,470 --> 00:13:49,000
ولكن، من الممكن أن تسوء تأثيراته

231
00:13:49,000 --> 00:13:51,180
.حسب سلوكك وتعابيرك وتصرّفاتك

232
00:13:51,180 --> 00:13:53,890
.أ-أعلم ذلك

233
00:13:55,290 --> 00:13:58,250
.هذا الجانب منها ظريف ومطيع

234
00:14:00,190 --> 00:14:03,380
.والآن امسحي معصميك معًا

235
00:14:03,380 --> 00:14:06,770
حسنًا. أتقصد هكذا؟

236
00:14:06,770 --> 00:14:08,770
.يا لها من رائحة عطِرة

237
00:14:08,770 --> 00:14:11,470
.لكن يبدو أنّ هذا ليس كافيًا

238
00:14:11,470 --> 00:14:13,830
.إن وضع الكثير منه سيكون مزعجًا

239
00:14:13,830 --> 00:14:17,580
فهمت. أنت واسع المعرفة، صحيح؟

240
00:14:17,990 --> 00:14:19,750
.ما زالت معرفتك قليلة فحسب

241
00:14:19,750 --> 00:14:23,750
.واثقة أنّ هنالك طريقة ألطف لقول ذلك

242
00:14:23,750 --> 00:14:28,060
.أنا ابنة عائلة فالغاس الّتي تحكم هذه البلدة

243
00:14:28,060 --> 00:14:30,520
.أعلم ذلك. والآن دور عنقك

244
00:14:32,170 --> 00:14:36,210
.أرى أنّ تذكيري لك بمكانتي لا يؤثّر عليك

245
00:14:36,210 --> 00:14:37,430
.يا لك من شخص غريب

246
00:14:37,430 --> 00:14:39,390
.سيفي هذا بالغرض

247
00:14:39,390 --> 00:14:41,830
.صار وجه ذات اللّفائف ألطف

248
00:14:39,390 --> 00:14:42,060
.رائحته رائعة

249
00:14:43,380 --> 00:14:46,860
.بإمكان العطر أن يغيّر قلب النّاس

250
00:14:46,860 --> 00:14:48,610
.عمل مذهل يا سيّد ريجي

251
00:14:48,610 --> 00:14:49,990
...مرحبًا

252
00:14:49,990 --> 00:14:54,090
!سمعتُ أنّ سيّدتي— إنّها هنا فعلاً

253
00:14:54,090 --> 00:14:56,240
!يا سيّدتي الصّغيرة، كنتُ أبحث عنك

254
00:14:56,240 --> 00:14:58,560
.ماذا؟ ها قد وجدتني

255
00:14:58,560 --> 00:15:01,020
ماذا؟ لم تخبري خادمك أنّك قادمة إلى هنا؟

256
00:15:02,270 --> 00:15:06,800
.حسنًا يا سيّد ريجي، شكرًا لك. مع السّلامة

257
00:15:06,800 --> 00:15:08,850
.حظًّا موفّقًا في حفل العشاء

258
00:15:10,190 --> 00:15:12,380
لماذا قلتَ ذلك؟

259
00:15:12,380 --> 00:15:17,100
.لا أحتاج لتشجيعك. أنا سيّدة أفيض سحرًا

260
00:15:17,100 --> 00:15:19,890
.لا-لا تقلق حيالي

261
00:15:21,140 --> 00:15:23,540
ربّما هي في سنّ يكون المرء فيه
.عاشقًا للعشق بحدّ ذاته

262
00:15:24,200 --> 00:15:26,340
،واثق أنّ أمورًا كثيرة لن تجري على هواها

263
00:15:26,860 --> 00:15:29,740
.لكن آمل أن يساعدها ذلك العطر ولو قليلاً

264
00:15:31,090 --> 00:15:33,760
.ذلك ما ظننتُ على الأقلّ

265
00:15:35,720 --> 00:15:37,140
كيف حالك؟

266
00:15:37,140 --> 00:15:40,220
.مرحبًا... هذه أنت يا إلين

267
00:15:40,220 --> 00:15:42,460
ماذا هنالك؟ أليس حفل العشاء اليوم؟

268
00:15:42,460 --> 00:15:46,350
.في الحقيقة، قرّرت عدم الذّهاب

269
00:15:46,350 --> 00:15:47,100
ماذا؟

270
00:15:47,100 --> 00:15:49,380
،عندما فكّرت في الأمر

271
00:15:49,380 --> 00:15:56,820
.فكّرتُ أنّ الرّجل الصّريح سيكون مناسبًا أكثر لي

272
00:15:56,820 --> 00:15:57,890
.حسنًا

273
00:15:57,890 --> 00:16:03,560
.إضافة إلى أنّني أحبّ الرّجال الموهوبين

274
00:16:04,030 --> 00:16:07,520
إنّها الآنسة إلين، ماذا تفعلين هنا؟

275
00:16:08,120 --> 00:16:14,860
.أتيتُ لأساعد في المحلّ

276
00:16:14,860 --> 00:16:15,980
تساعدينا؟

277
00:16:15,980 --> 00:16:16,530
رو؟

278
00:16:17,920 --> 00:16:20,070
.لا أدري ماذا بإمكانك فعله للمساعدة

279
00:16:20,070 --> 00:16:24,190
واثقة أنّ بمقدوري فعل كلّ ما
.قد تفعله تلك الوحش

280
00:16:24,190 --> 00:16:26,920
.لستُ وحشًا، أنا مستذئبة

281
00:16:27,280 --> 00:16:29,380
ماذا؟ هل تضعين ذلك العطر؟

282
00:16:29,380 --> 00:16:34,090
.نعم. وضعته اليوم

283
00:16:34,560 --> 00:16:36,220
هل رائحته مزعجة؟

284
00:16:36,220 --> 00:16:38,980
.لا، رائحته جيّدة

285
00:16:38,980 --> 00:16:40,930
لكن لماذا وضعتِ منه؟

286
00:16:40,930 --> 00:16:44,010
.لأنّني سيّدة

287
00:16:44,010 --> 00:16:46,810
.وسأتواجد هنا ليومين

288
00:16:46,810 --> 00:16:47,900
يومين؟

289
00:16:47,900 --> 00:16:52,110
.حصلت على إذن بالعمل هنا من والداي

290
00:16:52,110 --> 00:16:53,570
.ومن خادمي أيضًا

291
00:16:53,570 --> 00:16:55,910
.لكنّك لم تحصلي على إذني أبدًا

292
00:16:55,910 --> 00:16:58,070
.رو. المدير محقّ

293
00:16:58,070 --> 00:17:02,260
.حتّى أبي قال أنّ بإمكاني العمل ليومين

294
00:17:02,260 --> 00:17:05,150
.قال أنّها ستكون فرصة جيّدة لأختبر العالم

295
00:17:05,150 --> 00:17:08,040
ألا تحتاجين إلى إذني أوّلاً
بما أنّني صاحب المحلّ؟

296
00:17:08,040 --> 00:17:10,300
.رو. المدير محقّ

297
00:17:10,300 --> 00:17:12,800
يا سيّد ريجي، أستسمح بهذا؟

298
00:17:12,800 --> 00:17:15,020
.أيّها المدير، لا لذات اللّفائف

299
00:17:16,650 --> 00:17:18,030
ما رأيكم في هذا؟

300
00:17:18,030 --> 00:17:21,100
.بإمكانها مساعدة الآنسة نويلا

301
00:17:21,810 --> 00:17:23,400
.تبدو فكرة جيّدة

302
00:17:23,400 --> 00:17:26,260
.رو. سأعلّم ذات اللّفائف

303
00:17:26,260 --> 00:17:29,130
ستعلّمينني يا آنسة نويلا؟

304
00:17:29,130 --> 00:17:31,740
.لستُ الآنسة نويلا، بل الأستاذة نويلا

305
00:17:31,740 --> 00:17:34,150
.الأستاذة نويلا. كم هذا رائع

306
00:17:34,540 --> 00:17:41,040
.أفضّل أن أتعلّم من السّيّد ريجي

307
00:17:41,040 --> 00:17:44,160
.المدير مشغول. لا وقت لديه لك

308
00:17:45,480 --> 00:17:47,210
.حظًّا سعيدًا معًا إذًا

309
00:17:47,210 --> 00:17:49,810
ماذا؟ ماذا؟

310
00:17:50,390 --> 00:17:54,000
.رو. عليك الإصغاء لي

311
00:17:54,000 --> 00:17:54,810
.حسنًا

312
00:17:54,810 --> 00:17:56,980
.في البداية، التّحيّة. مرحبًا

313
00:17:56,980 --> 00:17:58,010
.مرحبًا

314
00:17:58,010 --> 00:18:00,010
محلّ عقاقير كيريو

315
00:18:00,010 --> 00:18:02,220
رو. أتستمعين يا ذات اللّفائف؟

316
00:18:02,220 --> 00:18:03,170
.مرحبًا

317
00:18:03,170 --> 00:18:03,840
.مرحبًا بك

318
00:18:03,840 --> 00:18:05,430
.مرحبًا بك في محلّنا

319
00:18:05,430 --> 00:18:09,160
ما الّذي تبحثين عنه اليوم؟

320
00:18:09,160 --> 00:18:12,570
.أنا أعرض عليك مساعدتي بكلّ لطف

321
00:18:13,530 --> 00:18:17,450
أيّها المدير، ماذا يحدث هنا؟

322
00:18:16,280 --> 00:18:18,400
.آسف

323
00:18:19,660 --> 00:18:20,910
.أنا حقًّا آسف

324
00:18:21,390 --> 00:18:24,180
.لا داعي للقلق. الأمر ممتع، لذلك لا بأس

325
00:18:24,180 --> 00:18:25,370
.إلى اللّقاء

326
00:18:25,720 --> 00:18:28,800
.محظوظون لأنّ الآنسة ميكوتو كانت زبونتنا

327
00:18:28,800 --> 00:18:35,090
،يا إلين، إن تفاعلت مع الزّبائن هكذا
.فسيتوقّفون عن المجيء. كان ذلك مريبًا

328
00:18:35,490 --> 00:18:37,670
مفهوم أيّتها السّيّدة الصّغيرة إلين؟

329
00:18:37,670 --> 00:18:42,550
ماذا؟ هلاّ قلتَ ذلك ثانية؟

330
00:18:42,550 --> 00:18:46,040
—قلتُ إن تفاعلتِ مع الزّبائن هكذا

331
00:18:44,980 --> 00:18:49,240
.ليس هذا. بل قولك السّيّدة الصّغيرة إلين

332
00:18:50,320 --> 00:18:52,480
السّيّدة الصّغيرة إلين؟

333
00:18:54,060 --> 00:19:01,850
.بإمكاني أن أتخيّل التّسلّل ليلاً من قصري لمقابلتك سرًّا

334
00:19:01,850 --> 00:19:05,310
.لكنّنا سيّدة نبيلة ورجل من العامّة

335
00:19:05,310 --> 00:19:06,960
.منزلتانا مختلفتان كثيرًا

336
00:19:06,960 --> 00:19:08,910
.لستُ واثقًا حيال هذا، لذلك سأتجاهل الأمر

337
00:19:09,410 --> 00:19:13,380
محلّ العقاقير كيريو

338
00:19:10,060 --> 00:19:15,380
وهكذا، عملت معنا السّيّدة إلين
.وشعرها الملولب في المحلّ ليومين

339
00:19:16,400 --> 00:19:18,850
.يا آنسة نويلا، تفضّلي

340
00:19:18,850 --> 00:19:19,960
من أجلي؟

341
00:19:19,960 --> 00:19:23,240
.نعم. صنعت هذا العطر بنفسي

342
00:19:23,240 --> 00:19:25,390
.علّمني السّيّد ريجي كيف أصنعه

343
00:19:26,780 --> 00:19:31,620
.شكرًا يا ذات اللّفائف. خذي هذا

344
00:19:31,620 --> 00:19:34,930
.يا إلهي. يبدو مثلك ذيلك تمامًا

345
00:19:34,930 --> 00:19:36,110
.إنّه بديل نويلا

346
00:19:36,830 --> 00:19:41,070
يا آنسة نويلا، ألا بأس إن عدتُ ثانية؟

347
00:19:43,770 --> 00:19:45,030
.أكيد

348
00:19:45,030 --> 00:19:48,000
.شكرًا لك يا آنسة نويلا

349
00:19:50,190 --> 00:19:52,030
.أصبحتا صديقتين

350
00:19:52,030 --> 00:19:53,660
.لم أتوقّع ذلك أبدًا

351
00:19:56,710 --> 00:19:59,670
.الجوّ ساخن

352
00:19:59,670 --> 00:20:02,970
لماذا الجوّ ساخن اليوم؟

353
00:20:03,890 --> 00:20:06,380
.سأعصرك أيّها المدير

354
00:20:06,380 --> 00:20:08,970
!ابتعدي عنّي يا كرة الفرو

355
00:20:08,970 --> 00:20:11,590
.الجوّ ساخن في السّقف أيضًا

356
00:20:11,590 --> 00:20:12,810
كيف حالكم؟

357
00:20:13,150 --> 00:20:14,520
.لقد وصلت

358
00:20:14,520 --> 00:20:15,550
.ذات اللّفائف

359
00:20:15,550 --> 00:20:19,920
.آسفة. لم آتي اليوم للّعب معك يا آنسة نويلا

360
00:20:19,920 --> 00:20:23,420
بما أنّ الجوّ ساخن، أخبرني أبي
أن أطلب من السّيّد ريجي

361
00:20:23,420 --> 00:20:26,030
.أن يعدّ دواءً سيجلب لنا الشّتاء

362
00:20:26,030 --> 00:20:28,120
!ذلك مستحيل

363
00:20:28,120 --> 00:20:29,230
ألا يمكنكم؟

364
00:20:29,230 --> 00:20:32,000
...السّحر والدّواء ليسا نفس الـ

365
00:20:32,820 --> 00:20:36,640
.في الحقيقة، قد ينجح هذا. حسنًا

366
00:20:37,580 --> 00:20:38,380
.انتهيت

367
00:20:38,380 --> 00:20:40,090
.هلام الحبّ المبرّد

368
00:20:40,090 --> 00:20:43,970
.إنّه هلام يتبخّر ويبعد الحرارة

369
00:20:43,970 --> 00:20:45,730
.سأجرّبه على نفسي أوّلاً

370
00:20:48,680 --> 00:20:51,460
.أنا أختبر شتاءً في منطقة محدودة

371
00:20:51,460 --> 00:20:53,860
.بارد، بارد

372
00:20:51,900 --> 00:20:53,860
.أهو بارد لهذا الحدّ؟ أريد تجربته

373
00:20:53,860 --> 00:20:54,930
.أنا أيضًا

374
00:20:54,330 --> 00:20:55,660
.وكذلك أنا

375
00:20:58,520 --> 00:21:00,980
!بارد، بارد، بارد

376
00:21:00,980 --> 00:21:03,530
.حلّ الشّتاء. شتاء في منتصف الصّيف

377
00:21:03,530 --> 00:21:06,630
.أنت محقّة. أدوية السّيّد ريجي تبهرني دائمًا

378
00:21:07,100 --> 00:21:09,200
...هذا بارد

379
00:21:09,930 --> 00:21:12,350
...أشعر بالنّعاس

380
00:21:11,540 --> 00:21:14,360
!لا تنامي يا آنسة نويلا

381
00:21:15,260 --> 00:21:18,640
.أشعر بالبرد والنّعاس

382
00:21:19,210 --> 00:21:23,900
...أحبّك يا سيّد ريجي

383
00:21:25,450 --> 00:21:27,840
هل تتجمّدن حتّى الموت في الجبال؟

384
00:21:28,210 --> 00:21:29,870
استعملتنّه كلّه؟

385
00:21:29,870 --> 00:21:32,310
!ستشعرن ببرد شديد إن استعملتنّ الكثير

386
00:21:34,430 --> 00:21:35,440
.محلّ عقاقير كيريو

387
00:21:35,440 --> 00:21:36,600
شكرًا لكم

388
00:21:36,600 --> 00:21:38,560
على الزّيارة

389
00:21:38,560 --> 00:21:40,950
.ثانية اليوم

390
00:21:40,950 --> 00:21:42,400
.رو

391
00:21:48,800 --> 00:21:51,980
.مذهل. هذا مذهل بالفعل

392
00:22:01,370 --> 00:22:04,020
.هذه هي حانة الأرنب إذًا