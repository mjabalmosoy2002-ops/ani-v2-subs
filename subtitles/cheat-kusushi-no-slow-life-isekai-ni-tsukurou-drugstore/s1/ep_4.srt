1
00:00:13,380 --> 00:00:15,290
ما بالك؟

2
00:00:15,830 --> 00:00:16,750
!نويلا؟

3
00:00:21,780 --> 00:00:23,120
.لقد هاجمني

4
00:00:23,120 --> 00:00:26,580
هاجمك؟ من؟

5
00:00:28,970 --> 00:00:30,170
.ذلك السّنجاب

6
00:00:35,080 --> 00:00:36,670
.سيفي هذا بالغرض

7
00:00:38,990 --> 00:00:40,530
.اختفِ أيّها السّمّ

8
00:00:40,530 --> 00:00:45,350
.إضافة لكونه مسكّنًا، فهو يزيل الموادّ السّامّة أيضًا

9
00:00:45,600 --> 00:00:48,310
.أيّها المدير، كان السّنجاب يتألّم

10
00:00:48,780 --> 00:00:52,500
.ربّما أكل مكسّرات سامّة بالخطأ

11
00:00:52,500 --> 00:00:53,930
.هذا ممكن

12
00:00:58,880 --> 00:01:01,610
،بمجرّد أن يقدّم الدّواء مفعوله
.فسيعود إلى جحره

13
00:01:01,610 --> 00:01:02,920
.علينا الذّهاب للمنزل أيضًا

14
00:01:02,920 --> 00:01:03,910
!رو

15
00:01:10,630 --> 00:01:12,590
محلّ عقاقير كيريو

16
00:01:14,220 --> 00:01:16,260
يا له من صباح مذهل... ماذا؟

17
00:01:25,320 --> 00:01:27,310
!يا سيّد ريجي

18
00:01:27,700 --> 00:01:29,150
.انظر لهذه

19
00:01:29,150 --> 00:01:30,700
.أحضرها سنجاب

20
00:01:30,700 --> 00:01:31,700
سنجاب؟

21
00:01:32,440 --> 00:01:33,780
.مكسّرات روكوشو

22
00:01:33,780 --> 00:01:36,200
.مكسّرات برائحة عطِرة جدًّا

23
00:01:36,200 --> 00:01:40,780
مكسّرات روكوشو؟ أهي مثل التّوابل؟

24
00:01:42,800 --> 00:01:45,040
!لذيذة! لذيذة

25
00:01:45,040 --> 00:01:48,080
هل من المناسب أكلها نيئة؟

26
00:01:48,080 --> 00:01:50,210
.أودّ أن أؤمن بغريزة نويلا الحيوانيّة

27
00:01:50,740 --> 00:01:53,420
لكن لماذا أحضر سنجاب هذه إلى هنا؟

28
00:01:53,770 --> 00:01:55,880
!أنقذ المدير سنجابًا

29
00:01:55,880 --> 00:01:57,340
!يا إلهي

30
00:01:57,340 --> 00:01:59,460
صحيح، ذلك السّنجاب؟

31
00:01:59,460 --> 00:02:02,160
.ربّما كان يحاول شكرك

32
00:02:02,160 --> 00:02:03,850
.كان يردّ لك الجميل

33
00:02:04,090 --> 00:02:06,660
يردّ الجميل؟

34
00:02:07,630 --> 00:02:10,090
.ستكون وجبة خفيفة جيّدة لنويلا

35
00:03:41,960 --> 00:03:45,790
صار السّنجاب يحضر لنا مكسّرات
.روكوشو كلّ يوم مذّاك الحين

36
00:03:45,790 --> 00:03:47,910
.أعطانا الكثير اليوم أيضًا

37
00:03:47,910 --> 00:03:51,160
.لكنّي لا أعرف كيف أطبخها

38
00:03:51,160 --> 00:03:54,380
.وليس لدينا مكوّنات لنطبخها بها على أيّ حال

39
00:03:55,580 --> 00:03:58,550
.آسف، نسيت الذّهاب للتّسوّق

40
00:03:58,850 --> 00:04:01,610
.سأحضر الغداء من حانة الأرنب

41
00:03:59,710 --> 00:04:04,510
.رو، رو. طعام الأرنب، طعام الأرنب

42
00:04:05,030 --> 00:04:06,720
.قد يكونون مشغولين بما أنّه وقت الغداء

43
00:04:06,720 --> 00:04:08,140
!غادر المكان

44
00:04:08,670 --> 00:04:11,560
أليس هذا صوت الرّجل الّذي يدير حانة الأرنب؟

45
00:04:11,560 --> 00:04:13,890
.لن أبيع هذا المحلّ لك

46
00:04:14,140 --> 00:04:15,880
.غادر المكان في الحال

47
00:04:15,880 --> 00:04:18,860
.لن أتحدّث عن ذلك بعد الآن

48
00:04:19,350 --> 00:04:23,700
.لكنّني أقدّر مهاراتك في الطّبخ

49
00:04:23,700 --> 00:04:25,160
ما قولك؟

50
00:04:25,430 --> 00:04:28,080
لماذا لا تعمل لديّ؟

51
00:04:28,080 --> 00:04:32,010
.كلاّ! هذا المحلّ مليء بذكرياتنا

52
00:04:32,010 --> 00:04:34,000
.لن أسمح بإغلاقه بسهولة

53
00:04:34,360 --> 00:04:35,710
!غادر في الحال

54
00:04:37,130 --> 00:04:39,920
.حسنًا، حظًّا سعيدًا لك

55
00:04:40,280 --> 00:04:45,380
أنا متحمّس سلفًا لليوم
.الّذي ستأتي فيه باكيًا لي

56
00:04:47,340 --> 00:04:50,180
.سأغادر الآن

57
00:04:52,910 --> 00:04:54,100
ما هذا؟

58
00:04:54,380 --> 00:04:59,820
أرى أنّه لا يزال لديك زبناء غريبو الأطوار
.يأتون إلى متجرك الصّغير القذر

59
00:04:59,820 --> 00:05:01,280
.المعذرة

60
00:05:10,330 --> 00:05:11,770
ما مشكلته؟

61
00:05:11,770 --> 00:05:13,740
!رو

62
00:05:12,110 --> 00:05:14,170
!سيّدي العطّار والذّئبة الصّغيرة

63
00:05:18,260 --> 00:05:20,420
.آسفان لأنّكما شهدتما على ذلك

64
00:05:20,420 --> 00:05:24,880
لا بأس. من كان ذلك الرّجل
الّذي بدا وكأنّ اسمه بيير؟

65
00:05:24,880 --> 00:05:26,480
بيير؟

66
00:05:26,970 --> 00:05:29,680
.إنّه مالك كومديل

67
00:05:30,070 --> 00:05:35,140
إنّه مطعم يقدّم أطباق لحم لذيذة
.فتح مؤخّرًا في الجوار

68
00:05:35,600 --> 00:05:37,600
يريدكما أن تبيعاه محلّكما؟

69
00:05:38,280 --> 00:05:42,190
.إنّه يحاول شراء كلّ منافسيه

70
00:05:42,480 --> 00:05:45,400
.هذا يعني أنّه يضايقكما

71
00:05:46,570 --> 00:05:49,680
.إنّنا ندير هذا المحلّ منذ زمن بعيد

72
00:05:49,680 --> 00:05:54,750
.لا يمكننا أن نسلّمه إيّاه بسهولة

73
00:05:54,750 --> 00:05:56,890
.الأمر لا علاقة له بالمال

74
00:05:57,310 --> 00:06:00,350
.أشكّ في أنّني قد أتخلّى عن محلّي أيضًا

75
00:06:01,020 --> 00:06:04,960
يا سيّدي العطّار، ماذا نفعل؟

76
00:06:04,960 --> 00:06:06,170
.رينا

77
00:06:06,460 --> 00:06:07,380
.يمكنك أخذ هذه

78
00:06:07,940 --> 00:06:09,360
.ستبهجك

79
00:06:10,620 --> 00:06:12,110
...الذّئبة الصّغيرة

80
00:06:12,470 --> 00:06:15,180
.أنا أحبّ طعام الأرنب

81
00:06:17,020 --> 00:06:19,400
!شكرًا لك أيّتها الذّئبة الصّغيرة

82
00:06:19,400 --> 00:06:20,650
...رو

83
00:06:24,080 --> 00:06:25,280
...هذه الرّائحة

84
00:06:25,280 --> 00:06:27,450
هل هذه مكسّرات روكوشو؟

85
00:06:27,450 --> 00:06:28,650
.نعم، إنّها هي

86
00:06:28,650 --> 00:06:30,850
من أين حصلت عليها؟

87
00:06:30,850 --> 00:06:32,200
.من سنجاب

88
00:06:32,200 --> 00:06:33,390
سنجاب؟

89
00:06:33,390 --> 00:06:34,350
.رو

90
00:06:34,350 --> 00:06:37,580
.إنّها قصّة طويلة. سأخبركما عنها في وقت لاحق

91
00:06:37,580 --> 00:06:41,330
مكسّرات روكوشو مكوّنات عالية
.الجودة ويصعب جدًّا العثور عليها

92
00:06:41,330 --> 00:06:43,670
هذه مكوّنات عالية الجودة؟

93
00:06:44,150 --> 00:06:46,830
حتّى أعظم الطّبّاخين هنا

94
00:06:46,830 --> 00:06:49,960
،لا يستطيعون الحصول عليها
.مهما بذلوا من جهد في البحث

95
00:06:49,960 --> 00:06:52,890
.وفوق ذلك، يصعب الطّبخ بها أيضًا

96
00:06:53,430 --> 00:06:55,340
،عندما قُدّم بعضها في قصر الملك

97
00:06:55,340 --> 00:07:00,110
يبدو أنّ طاهيًا أسطوريًّا نجح
.في صناعة صلصة منها

98
00:07:00,600 --> 00:07:04,310
.هذا رائع. لنعدّ شيئًا بناء على تلك الوصفة

99
00:07:05,210 --> 00:07:06,230
...إنّ الأمر

100
00:07:07,120 --> 00:07:10,980
،قبل أن يتمكّن من تمرير الوصفة لأيّ أحد

101
00:07:10,980 --> 00:07:15,320
مات ذلك الطّاهي بعد تناوله للكثير
.من الصّلصة لأنّها كانت لذيذة جدًّا

102
00:07:15,320 --> 00:07:16,780
...مستحيل

103
00:07:17,340 --> 00:07:21,660
فهمت. إن استطعنا إعداد تلك
...الصّلصة النّادرة بهذه

104
00:07:23,100 --> 00:07:26,300
هلاّ سمحت لي بتولّي هذا الأمر؟

105
00:07:26,810 --> 00:07:28,260
مع أنّك عطّار؟

106
00:07:28,830 --> 00:07:30,390
.لدين المكوّنات

107
00:07:30,390 --> 00:07:33,290
.نحتاج لإعداد صلصة روكوشو خاصّة بنا فحسب

108
00:07:33,290 --> 00:07:35,720
.وهكذا سنتمكّن من مواجهة ذلك المطعم

109
00:07:35,720 --> 00:07:38,900
!سأحمي طعام الأرنب

110
00:07:41,240 --> 00:07:44,610
.لكنّني أكلت كلّ مكسّرات روكوشو

111
00:07:44,610 --> 00:07:45,520
...ما

112
00:07:46,050 --> 00:07:48,720
!ماذا؟

113
00:07:53,420 --> 00:07:57,500
،بما أنّنا قابلنا السّنجاب هنا

114
00:07:57,980 --> 00:08:01,910
ظننتُ أنّنا قد نستطيع العثور
...عليها هنا، لكن

115
00:08:03,010 --> 00:08:04,370
.ليست هنا

116
00:08:04,910 --> 00:08:06,830
.سبق وقال لنا أنّها نادرة جدًّا

117
00:08:06,830 --> 00:08:10,060
.الغابة عميقة. ربّما تكون أبعد من هنا

118
00:08:10,060 --> 00:08:15,430
فهمت. لا بدّ أنّ السّنجاب تكبّد
.الكثير من العناء لإحضارها لنا

119
00:08:15,430 --> 00:08:18,850
.رو. إنّ السّنجاب جادّ بشأن شكرك

120
00:08:19,200 --> 00:08:21,580
.حان دورنا الآن لنشكره

121
00:08:23,510 --> 00:08:25,810
.ربّما سأترك له جرعة طاقة

122
00:08:26,180 --> 00:08:28,770
.رو. واثقة أنّه سيحبّها

123
00:08:31,980 --> 00:08:34,690
حسنًا. هل نعود للمنزل؟

124
00:08:34,690 --> 00:08:36,070
!رو

125
00:08:40,910 --> 00:08:45,820
.أفترض أنّ إيجادها صعب بقدر ما هي مكسّرات نادرة

126
00:08:47,110 --> 00:08:51,350
.أيّها المدير، أنا آسفة لأنّني أكلتها

127
00:08:51,350 --> 00:08:52,970
.لا بأس

128
00:08:53,300 --> 00:08:56,390
.لم تستطيعي المقاومة. لقد كانت لذيذة

129
00:08:56,640 --> 00:08:59,850
نعم. لكن ما الّذي سنفعله؟

130
00:08:59,850 --> 00:09:02,650
...مكسّرات روكوشو هي الأساس. وبدونها

131
00:09:02,650 --> 00:09:03,350
رو؟

132
00:09:03,940 --> 00:09:04,980
مطر؟

133
00:09:06,730 --> 00:09:08,480
!ماذا؟

134
00:09:08,940 --> 00:09:11,820
أهذه مقابل جرعة الطّاقة؟

135
00:09:13,000 --> 00:09:16,660
.سيساعدنا هذا كثيرًا. بإمكاننا الآن إعداد الصّلصة

136
00:09:16,660 --> 00:09:18,630
.شكرًا لك أيّها السّنجاب

137
00:09:18,630 --> 00:09:19,780
!رو

138
00:09:41,810 --> 00:09:42,940
!انتهيت

139
00:09:43,440 --> 00:09:45,140
.صلصلة روكوشو

140
00:09:45,140 --> 00:09:47,930
.تتميّز برائحتها المصقولة والرّاقية

141
00:09:47,930 --> 00:09:50,790
.إنّها حمضيّة بطعم منعش يعلق في الفم

142
00:09:50,790 --> 00:09:53,280
.حتّى الملك لا يتذوّق منها كثيرًا

143
00:09:55,020 --> 00:09:59,220
رائحتها جيّدة. حسنًا، خطوتنا
.التّالية هي حانة الأرنب

144
00:09:59,220 --> 00:10:00,870
!أجل

145
00:10:01,140 --> 00:10:03,630
.شمّ، شمّ، شمّ. شمّ، شمّ

146
00:10:03,630 --> 00:10:06,730
!ما هذه الرّائحة؟ أنا أتعرّف إليها

147
00:10:08,000 --> 00:10:09,760
.أعرف ما هي

148
00:10:09,760 --> 00:10:15,300
.تمّ تقديم هذا في حفل عشاء في قصر الملك

149
00:10:20,260 --> 00:10:23,010
من كان؟ من الّذي حضّرها؟

150
00:10:25,260 --> 00:10:26,930
...الأرنب

151
00:10:26,930 --> 00:10:28,140
.رو

152
00:10:29,380 --> 00:10:30,770
.مرحبًا

153
00:10:32,380 --> 00:10:36,150
،أيّها السّيّد بيير، إن كنتَ تريد بعضها
.فعليك الوقوف في الصّفّ

154
00:10:36,150 --> 00:10:37,880
لقد تخطّيت الصّفّ عندما دخلت، صحيح؟

155
00:10:38,670 --> 00:10:41,950
!لستُ بيير! اسمي فيرناندو

156
00:10:44,230 --> 00:10:45,900
أأنت سعيد الآن؟

157
00:10:47,020 --> 00:10:49,080
هلّي بأخذ طلبك يا سيّد بيير؟

158
00:10:49,320 --> 00:10:51,790
من الّذي تنادينه ببيير؟

159
00:10:52,550 --> 00:10:54,830
لديكم صلصة روكوشو، صحيح؟

160
00:10:54,830 --> 00:10:57,090
.أودّ طبقًا يحتوي عليها

161
00:10:57,330 --> 00:10:58,910
.حسنًا

162
00:11:00,660 --> 00:11:02,590
.شكرًا على الانتظار

163
00:11:03,070 --> 00:11:05,990
.سأسكب الصّلصة الآن. لحظة من فضلك

164
00:11:09,230 --> 00:11:11,560
.كلها بينما هي ساخنة

165
00:11:12,540 --> 00:11:13,720
.شمّ، شمّ

166
00:11:13,720 --> 00:11:18,530
هذه الرّائحة الغنيّة... إنّها تنفجر
.في طرف أنفي بالفعل

167
00:11:18,920 --> 00:11:20,240
.سأجرّبها الآن

168
00:11:25,710 --> 00:11:30,120
!تنتشر الرّائحة الغنيّة مع كلّ قضمة

169
00:11:30,430 --> 00:11:31,960
.قضمة أخرى

170
00:11:32,780 --> 00:11:39,410
حتّى بعد بلعها، فإنّها تعلق
...في مؤخّرة أنفي، لكن

171
00:11:40,690 --> 00:11:44,970
ما هذا الشّعور المنعش كأنّه نهر صافٍ متدفّق؟

172
00:11:44,970 --> 00:11:50,570
!تجعلني هذه النّكهة أتمنّى أن أواصل الأكل للأبد

173
00:11:51,360 --> 00:11:55,410
ليس ذلك فحسب، لكنّ طبقًا واحدًا
منها يقدّر بـ500 رين؟

174
00:11:55,410 --> 00:11:59,790
هذا الطّبق الّذي يتناسب مع النّبيذ
!كما يتناسب أيضًا مع الخبز؟

175
00:12:01,990 --> 00:12:04,220
.أكلت ذلك في رمشة عين

176
00:12:04,220 --> 00:12:06,680
لم تختنق، صحيح؟

177
00:12:07,850 --> 00:12:10,700
من أعدّ صلصة روكوشو هذه؟

178
00:12:10,700 --> 00:12:14,020
لا ينبغي لأحد أن يكون قادرًا
على ذلك! هل كان المالك؟

179
00:12:14,020 --> 00:12:16,440
فعلاً؟ من يدري؟

180
00:12:16,800 --> 00:12:18,940
.لدينا زبناء ينتظرون

181
00:12:18,940 --> 00:12:20,920
هلاّ أخليت طاولتك رجاءً؟

182
00:12:22,900 --> 00:12:25,480
.سنحمي حانة الأرنب

183
00:12:29,050 --> 00:12:30,990
.لم يكن المالك

184
00:12:30,990 --> 00:12:33,560
،لو كان باستطاعته إعداد ذلك
.لفعلها من قبل

185
00:12:33,800 --> 00:12:36,370
.ولم تكن الابنة أيضًا لنفس السّبب

186
00:12:36,370 --> 00:12:38,020
...ممّا يعني

187
00:12:38,020 --> 00:12:39,700
!هل يعقل هذا؟

188
00:12:39,700 --> 00:12:41,400
.تفضّلوا

189
00:12:41,830 --> 00:12:44,030
.ما زال لدينا الكثير من الطّعام والصّلصة

190
00:12:44,380 --> 00:12:45,950
.قفوا في الصّفّ رجاءً

191
00:12:46,990 --> 00:12:47,820
.أنت

192
00:12:47,820 --> 00:12:48,500
ماذا؟

193
00:12:49,410 --> 00:12:51,950
مهلاً، مهلاً، مهلاً... ماذا تفعل؟

194
00:12:52,440 --> 00:12:54,970
أنت من أعددت الصّلصة، صحيح؟

195
00:12:54,970 --> 00:12:57,920
.سأشتري كلّ حصّة بـ500 ألف رين

196
00:12:58,260 --> 00:13:03,080
.أعددت الصّلصة لتُستعمل في حانة الأرنب فقط

197
00:13:03,460 --> 00:13:05,630
.إن أردتها، فعليك التّحدّث مع المالك

198
00:13:05,630 --> 00:13:06,860
...أيّها الـ

199
00:13:06,860 --> 00:13:09,050
ما رأيك في 600 ألف؟

200
00:13:11,490 --> 00:13:13,630
.بل 700 ألف

201
00:13:14,610 --> 00:13:16,820
‪‫800 ألف!

202
00:13:16,820 --> 00:13:20,820
.المال ليس حافز الجميع

203
00:13:23,550 --> 00:13:24,610
...في تلك الحالة

204
00:13:25,320 --> 00:13:28,230
!بعني إيّاها رجاءً! أتوسّل إليك

205
00:13:28,830 --> 00:13:30,010
.تريليون رين

206
00:13:30,010 --> 00:13:30,740
—تريـ

207
00:13:31,050 --> 00:13:35,960
إ-إن أخبرتني فقط من أين حصلتَ
...على مكسّرات روكوشو

208
00:13:37,420 --> 00:13:40,290
.يحضرها لي أحد معارفي إلى منزلي

209
00:13:40,290 --> 00:13:42,730
من يكون؟

210
00:13:42,730 --> 00:13:43,550
.سنجاب

211
00:13:44,570 --> 00:13:48,240
!سنجاب؟ أيّها المتنمّر

212
00:13:48,240 --> 00:13:50,680
ألا تظنّ أنّك كبير على البكاء؟

213
00:13:51,560 --> 00:13:53,820
.بيير، يمكنك أخذ هذا

214
00:13:54,330 --> 00:13:56,700
.لذلك ابتهج

215
00:13:56,700 --> 00:13:58,970
.أيّها المدير، مينا تنتظر

216
00:13:58,970 --> 00:14:01,110
.صحيح. لنعد إذًا

217
00:14:04,090 --> 00:14:04,690
ماذا؟

218
00:14:06,030 --> 00:14:07,990
!تبًّا

219
00:14:08,300 --> 00:14:09,710
!لقد خسرت

220
00:14:10,230 --> 00:14:12,700
!لكنّ هذا لذيذ جدًّا

221
00:14:13,950 --> 00:14:18,160
محلّ عقاقير كيريو

222
00:14:16,890 --> 00:14:18,160
.مرحبًا

223
00:14:18,850 --> 00:14:20,600
.الآنسة فيريس

224
00:14:20,600 --> 00:14:23,130
...عفوًا أيّها السّيّد الخيميائيّ

225
00:14:23,460 --> 00:14:24,590
ماذا؟

226
00:14:24,590 --> 00:14:26,050
!لديّ طلب

227
00:14:26,050 --> 00:14:26,720
!احترمي المساحة الشّخصيّة

228
00:14:27,030 --> 00:14:31,640
!حسنًا... أريد إنجاب طفل من زيرال

229
00:14:35,050 --> 00:14:42,310
.ومؤخّرًا، لم نقم أنا وزيرال بالأمر كثيرًا

230
00:14:42,540 --> 00:14:43,930
تقوما بالأمر"؟"

231
00:14:44,550 --> 00:14:51,060
لا أدري إن كان هنالك خطب ما بي أو به
...أو إن كان يملك عشيقة، ولكن

232
00:14:48,480 --> 00:14:49,520
.هذا سيّئ

233
00:14:51,060 --> 00:14:55,200
—لكنّني قلقة وقلقة وقلقة أنّني

234
00:14:52,490 --> 00:14:55,200
...مهلاً، مهلاً، مهلاً

235
00:14:55,200 --> 00:14:58,870
.مهلاً لحظة. اشربي بعض الشّاي

236
00:15:05,050 --> 00:15:07,500
.أنا قلقة جدًّا وأعجز عن النّوم ليلاً

237
00:15:07,500 --> 00:15:11,350
.ولسبب ما، أنام جيّدًا عندما أشرب هذا الشّاي

238
00:15:11,350 --> 00:15:12,890
.هذا أمر جيّد

239
00:15:13,260 --> 00:15:23,900
يا سيّدي الخيميائيّ، هـ-هل بإمكانك إعداد
منشّط جنسيّ لإدخال زيرال في الجوّ؟

240
00:15:27,460 --> 00:15:29,800
!حسنًا! سأفكّر في الأمر

241
00:15:30,590 --> 00:15:34,110
.مع أنّي قلت ذلك، عليّ أن أسأله أوّلاً

242
00:15:38,690 --> 00:15:41,040
كيف هي الأمور بينك وبين الآنسة فيريس مؤخّرًا؟

243
00:15:41,040 --> 00:15:43,020
هل واجهتما أيّ مشاكل؟

244
00:15:43,020 --> 00:15:47,460
ماذا؟ لا، لماذا؟ هل من خطب ما؟

245
00:15:47,770 --> 00:15:50,740
...عفوًا

246
00:15:51,180 --> 00:15:56,560
هل بإمكاني إخباره أنّ الآنسة فيريس
طلبت منّي إعداد منشّط جنسيّ؟

247
00:15:56,560 --> 00:15:59,680
.واثق أنّ هذا أمر عليّ التزام الخصوصيّة فيه

248
00:16:00,060 --> 00:16:01,140
يا سيّد ريجي؟

249
00:16:01,370 --> 00:16:04,300
.لا شيء، أسعدني سماع هذا

250
00:16:04,300 --> 00:16:08,940
هل تفكّران في الزّواج مستقبلاً؟

251
00:16:09,270 --> 00:16:10,510
الزّواج؟

252
00:16:11,060 --> 00:16:13,570
.نعم، كنتُ أفكّر في ذلك

253
00:16:13,570 --> 00:16:16,410
.إنّها من عائلة تجّار ثريّة من بلدة مجاورة

254
00:16:16,410 --> 00:16:17,370
.فهمت

255
00:16:17,810 --> 00:16:21,000
.يوافق كلّ من آبائنا على علاقتنا

256
00:16:21,640 --> 00:16:23,250
لكن ما سبب سؤالك؟

257
00:16:23,550 --> 00:16:28,120
في العادة، أشعر أنّ هنالك نظامًا
،معيّنًا يجب أن نتّبعه

258
00:16:28,710 --> 00:16:31,460
لكن إن كنتما تحبّان بعضكما
،وكنتما تفكّران في المستقبل معًا

259
00:16:31,460 --> 00:16:32,650
.فلا بأس بهذا إذًا

260
00:16:32,960 --> 00:16:34,880
.كما أنّ كلاكما من عائلة ثريّة

261
00:16:38,790 --> 00:16:40,740
.منشّط عاطفيّ

262
00:16:40,740 --> 00:16:43,610
.دواء يقوّي العواطف

263
00:16:44,270 --> 00:16:47,290
.يمكن أن يشير هذا الاسم لشيء آخر

264
00:16:47,290 --> 00:16:51,850
،لستُ واثقًا من أنّه سينجح
.لكنّي سأقدّمه لزيرال غدًا

265
00:16:51,850 --> 00:16:53,950
.يا سيّد ريجي، لديك زبون

266
00:16:53,950 --> 00:16:55,710
.سآتي في الحال

267
00:17:02,110 --> 00:17:03,790
.شكرًا جزيلاً لك

268
00:17:05,010 --> 00:17:08,310
.يا إلهي، عملت كثيرًا اليوم

269
00:17:08,770 --> 00:17:12,380
.مينا، هذه نكهة لذيذة جديدة

270
00:17:12,380 --> 00:17:15,010
.شكرًا لك

271
00:17:18,550 --> 00:17:21,780
!مـ-مينا، لا تشربي من ذلك

272
00:17:22,900 --> 00:17:26,770
.آسفة. لم أستطع منع نفسي

273
00:17:27,950 --> 00:17:30,820
ماذا؟ ماذا؟

274
00:17:31,210 --> 00:17:34,780
سيّد ريجي، ما-ماذا أفعل؟

275
00:17:39,710 --> 00:17:45,920
.سيّد ريجي، أشعر بشقاوة على غير العادة

276
00:17:48,140 --> 00:17:49,660
.على الأقلّ أنت صادقة

277
00:17:49,660 --> 00:17:52,090
كلاّ! مصيبة... هل لديّ أيّ شيء ليساعدها؟

278
00:17:52,090 --> 00:17:55,010
!صحيح! لديّ ذلك التّرياق الّذي أعطيته للسّنجاب

279
00:17:57,470 --> 00:18:00,310
يا سيّد ريجي، إلى أين تذهب؟

280
00:18:00,310 --> 00:18:01,390
أين أذهب؟

281
00:18:01,390 --> 00:18:04,540
.أنت من فعل هذا بي

282
00:18:03,100 --> 00:18:04,540
!كلاّ، توقّفي

283
00:18:04,540 --> 00:18:07,480
.لا تلوميني إن كنت تريدين الموت خجلاً لاحقًا

284
00:18:07,480 --> 00:18:09,290
.أنا ميتة سلفًا

285
00:18:09,620 --> 00:18:11,670
!لا مجال للجدال في ذلك

286
00:18:11,670 --> 00:18:14,780
أعني أنّك ستندمين على ما فعلت
.بمجرّد أن تعودي إلى رشدك

287
00:18:15,900 --> 00:18:17,360
،مذ أن متّ

288
00:18:17,790 --> 00:18:21,780
.كنتُ أندم على أشياء عدّة

289
00:18:21,780 --> 00:18:24,110
.لن يؤلمني شيء آخر أندم عليه

290
00:18:24,110 --> 00:18:25,500
.يا إلهي، هذا جدّيّ جدًّا

291
00:18:25,500 --> 00:18:27,000
ماذا؟ نويلا؟

292
00:18:27,000 --> 00:18:29,460
.مذاقه كالطّاقة. الطّاقة مهمّة

293
00:18:29,460 --> 00:18:32,540
.كنتُ أشعر بالتّعب مؤخّرًا

294
00:18:32,540 --> 00:18:33,920
—كلاّ! إن شربت منه

295
00:18:36,650 --> 00:18:41,890
.الآنسة نويلا ثانية؟ أعرني انتباهًا أكثر رجاءً

296
00:18:41,890 --> 00:18:45,760
.وإلاّ، قد أتلبّسك

297
00:18:45,760 --> 00:18:48,230
!لا تجعلي ذلك يبدو مبهجًا

298
00:18:51,620 --> 00:18:52,890
!رو

299
00:18:59,820 --> 00:19:05,820
.أيّها العطّار، يراودني شعور غريب

300
00:19:06,670 --> 00:19:08,340
.عرفتُ ذلك

301
00:19:08,340 --> 00:19:09,790
عرفتَ ذلك؟

302
00:19:10,510 --> 00:19:11,750
.مستحيل

303
00:19:12,790 --> 00:19:14,960
!قائدتنا الخشنة تظهر جانبها الأنثويّ

304
00:19:14,960 --> 00:19:16,460
!يا لظرافتها

305
00:19:16,460 --> 00:19:17,770
.قوموا بعملكم

306
00:19:18,230 --> 00:19:20,220
.السّيّد ريجي مشغول

307
00:19:20,220 --> 00:19:23,370
.عليه القيام بأمور شقيّة معي

308
00:19:23,370 --> 00:19:24,640
!ماذا؟

309
00:19:25,510 --> 00:19:28,300
لا تمانعان إن انضممت لكما، صحيح؟

310
00:19:29,220 --> 00:19:30,890
.يا لها من فكرة جيّدة

311
00:19:30,890 --> 00:19:32,780
!بل إنّها فظيعة

312
00:19:33,100 --> 00:19:34,900
.تشعر مينا بتحسّن

313
00:19:34,900 --> 00:19:38,570
.تصلح جرعات المدير اللّذيذة كلّ شيء
.الطّاقة مهمّة

314
00:19:38,570 --> 00:19:40,500
!نويلا

315
00:19:40,500 --> 00:19:43,820
!صحيح! أحضري لي التّرياق

316
00:19:43,820 --> 00:19:46,060
.حسنًا أيّها المدير. اعتمد عليّ

317
00:19:53,530 --> 00:19:56,840
.أيّها المدير، تذكّرت أنّ عليّ القيام بأمر ما

318
00:19:58,170 --> 00:19:59,760
.أيّها العطّار

319
00:20:00,990 --> 00:20:02,720
.سيّد ريجي

320
00:20:04,690 --> 00:20:08,730
!كفاكما

321
00:20:16,750 --> 00:20:19,530
لماذا فعلتُ ذلك؟

322
00:20:20,160 --> 00:20:24,240
.أخبرتك أنّها ليست مشكلتي إن ندمت على ذلك

323
00:20:24,750 --> 00:20:27,850
.كنت محظوظة لأنّك أخذت التّرياق

324
00:20:27,850 --> 00:20:29,860
...أ-أيّها المدير

325
00:20:30,520 --> 00:20:33,290
.لقد كسرت أدويتك

326
00:20:33,290 --> 00:20:34,180
...رو

327
00:20:35,130 --> 00:20:36,710
.حسنًا، حسنًا

328
00:20:37,170 --> 00:20:39,550
.سبق واعتذرت. لا بأس

329
00:20:40,250 --> 00:20:41,550
...أيّها المدير

330
00:20:42,470 --> 00:20:45,370
.يا سيّد ريجي، استمع لي

331
00:20:45,370 --> 00:20:46,620
.تمهّل

332
00:20:48,530 --> 00:20:49,260
ما هذا؟

333
00:20:49,740 --> 00:20:53,180
.أفترض أنّه بإمكانك تسميته بدواء منشّط

334
00:20:53,180 --> 00:20:54,730
.فهمت

335
00:21:06,640 --> 00:21:12,680
.يا سيّد ريجي، أشعر بحرارة شديدة لسبب ما

336
00:21:12,680 --> 00:21:15,900
.تمّ إثبات تأثير المنشّط العاطفيّ

337
00:21:15,900 --> 00:21:17,160
...وثمّ

338
00:21:17,160 --> 00:21:18,860
.فيريس، كم أحبّك

339
00:21:18,860 --> 00:21:20,600
.أحبّك أيضًا

340
00:21:20,600 --> 00:21:23,920
.حسنًا، أحبّك مليونَ ضِعف

341
00:21:21,470 --> 00:21:24,860
.أنا سعيد فقط لأنّ زبائني راضون

342
00:21:23,920 --> 00:21:26,180
...وأنا أحبّك أكثر

343
00:21:25,320 --> 00:21:26,180
.نعم

344
00:21:26,510 --> 00:21:27,620
.ممتاز

345
00:21:29,390 --> 00:21:31,350
.تزوّجا وأريحانا

346
00:21:34,040 --> 00:21:34,980
.محلّ عقاقير كيريو

347
00:21:35,340 --> 00:21:36,140
شكرًا لكم

348
00:21:36,140 --> 00:21:38,100
على الزّيارة

349
00:21:38,450 --> 00:21:40,580
.ثانية اليوم

350
00:21:40,580 --> 00:21:41,940
.رو

351
00:21:48,600 --> 00:21:49,780
.واحدة أخرى

352
00:21:51,740 --> 00:21:55,540
.يا-يا ملك الشّياطين، سيزعج ذلك معدتك

353
00:22:01,410 --> 00:22:02,350
...أخي

354
00:22:03,480 --> 00:22:04,960
الزّبون التّالي