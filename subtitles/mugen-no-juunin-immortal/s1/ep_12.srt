1
00:00:04,140 --> 00:00:05,400
...أنتِ

2
00:00:07,600 --> 00:00:08,750
—أنا

3
00:00:08,750 --> 00:00:09,570
.لا تتكلّمي

4
00:00:11,520 --> 00:00:15,620
...(أنتم من دوجو (شينغيوتو-ريو

5
00:00:15,950 --> 00:00:18,870
...(زعيم الـ(إيتّو-ريو)، (أنوتسو كاغيهيسا

6
00:00:19,330 --> 00:00:21,890
.سوف أسلبك حياتك

7
00:00:21,890 --> 00:00:23,120
أأنت واثق؟

8
00:00:23,670 --> 00:00:26,110
،من يعرفون اسمي ويشهرون سيوفهم في وجهي

9
00:00:26,110 --> 00:00:29,790
.يشهرون سيوفهم في وجوه أتباعي الألف أيضًا

10
00:00:30,510 --> 00:00:38,100
.سأعتبركم كالذين هم مستعدّون لعرقلة درب جدّي الرّاحل وكذا مستقبلي

11
00:00:38,100 --> 00:00:40,860
،فلتصبحوا غبارًا على جانب الدّرب

12
00:00:40,860 --> 00:00:43,780
.ولتعلموا مقدار وزن نصلي

13
00:02:23,930 --> 00:02:26,380
!اسمع! تريّث

14
00:02:49,150 --> 00:02:49,940
.أحجمي

15
00:02:52,810 --> 00:02:55,970
.يجدر بالسّيّاف أن يعرف مقدار قوّته

16
00:03:01,410 --> 00:03:04,070
لماذا كانوا يلاحقونك؟

17
00:03:04,070 --> 00:03:07,390
ولماذا عليّ أن أجيب على سؤالك؟

18
00:03:07,390 --> 00:03:09,950
...الأمر متعلّق بالـ(إيتّو-ريو) لذا

19
00:03:09,950 --> 00:03:12,670
.أنا واثقة أنّك كنتَ تنوي تدمير أحد الدّوجو

20
00:03:12,670 --> 00:03:15,370
.الموضوع ليس بهذه البساطة

21
00:03:15,860 --> 00:03:21,680
.(بدأ الأمر بطلب أحد الدّوجو في (كاغا) الانضمام إلى الـ(إيتّو-ريو

22
00:03:21,680 --> 00:03:25,180
.ولسوء الحظّ قرّرت السّلطات التّدخّل

23
00:03:25,180 --> 00:03:28,690
.ذلك الدّوجو... دمّرته السّلطات

24
00:03:29,150 --> 00:03:31,780
.انتحر قائد الدّوجو وابنته

25
00:03:31,780 --> 00:03:37,840
.اتّفق أتباعهما على أنّني أصل هذا الشّر وأتوا سعيًا في طلب رأسي

26
00:03:38,310 --> 00:03:41,040
.بعبارة أخرى، كان الأمر كلّه فخًّا

27
00:03:41,040 --> 00:03:42,320
.معهم حقّ

28
00:03:42,320 --> 00:03:44,830
.أنتَ أصل هذا الشّر

29
00:03:45,760 --> 00:03:47,190
.هذا صحيح

30
00:03:47,190 --> 00:03:49,390
.نعم، الذّنب ذنبي

31
00:03:49,780 --> 00:03:53,300
،)في مطلق الأحوال، باتّخاذهم التّدابير طول الطّريق إلى (كاغا

32
00:03:53,300 --> 00:03:56,480
.(لن أُفَاجأ إن حدث خطب ما في (إيدو

33
00:03:56,480 --> 00:03:57,810
.عليّ بالاستعجال

34
00:03:57,810 --> 00:03:59,980
...السّلطات

35
00:03:59,980 --> 00:04:02,510
.بالغنا في الفوز قليلاً

36
00:04:02,510 --> 00:04:06,080
.لعلّني بالغت في تقدير قوّتنا

37
00:04:08,540 --> 00:04:11,340
ما سبب إرادتك في الغدوّ أقوى؟

38
00:04:11,340 --> 00:04:12,740
!أنت

39
00:04:12,740 --> 00:04:15,150
!بُغيَة قتلك أنت بالطّبع

40
00:04:15,150 --> 00:04:17,040
!لا تطرح عليّ أسئلة عبثيّة

41
00:04:17,040 --> 00:04:19,850
بقتلك لي، ماذا ستفعلين بعدها؟

42
00:04:19,850 --> 00:04:21,800
ماذا سأفعل بعدها؟

43
00:04:21,800 --> 00:04:23,910
...بعدها... سوف

44
00:04:23,910 --> 00:04:27,150
.حسنٌ، لا بأس بذلك

45
00:04:27,150 --> 00:04:29,760
.احرصي على ألاّ تبالغي في الأمر

46
00:04:29,760 --> 00:04:32,120
،مهما كان الهدف الذي تسعين إليه

47
00:04:32,120 --> 00:04:34,590
.إن تقدّمتِ فلن يكون بوسعك العودة

48
00:04:34,590 --> 00:04:39,950
،إن عشتِ، فستتزوّجين أنتِ أيضًا في النّهاية برجل ما وتحظين بذرّيّة

49
00:04:39,950 --> 00:04:45,130
حتّى لو كنتِ مخطئة فلا تدعي أطفالك يسلكون نفس الدّرب الذي سَلَكتِه، أفهمتِ؟

50
00:04:45,130 --> 00:04:47,020
وكيف لي أن أفهم؟

51
00:04:47,430 --> 00:04:51,290
!من أجبرني على اختيار هذا الدّرب هو أنت

52
00:04:51,290 --> 00:04:54,570
.ما كنتُ لأستمع إلى منطقك

53
00:04:54,570 --> 00:05:00,190
لماذا كان من المحتوم أن تقتلوا أبي وأمّي؟

54
00:05:00,190 --> 00:05:03,570
...لو أنّ... لو أنّ ذلك لم يحدث

55
00:05:04,660 --> 00:05:07,030
.يبدو أنّني ظلمتك

56
00:05:08,900 --> 00:05:11,040
ماذا قلت؟

57
00:05:12,270 --> 00:05:13,500
...أنت

58
00:05:13,500 --> 00:05:16,160
!(أنوتسو كاغيهيسا)

59
00:05:20,460 --> 00:05:22,170
!لا تستهزئ بي

60
00:05:22,170 --> 00:05:25,220
...لو أنّك اعتذرت، فمن البداية

61
00:05:32,200 --> 00:05:35,360
.سنغادر هذا المكان بمجرّد توقّف المطر

62
00:05:35,360 --> 00:05:38,290
.إن فرغتِ، فيجدر بك أن تنامي

63
00:05:52,610 --> 00:05:54,080
.مهلاً

64
00:05:56,910 --> 00:05:59,360
ما الأمر؟ أأنتِ مُرهَقة؟

65
00:05:59,360 --> 00:06:02,410
.حتّى لو كنتُ مُرهَقَة فلن أخبرك

66
00:06:02,410 --> 00:06:04,140
...والأهمّ من ذلك

67
00:06:04,140 --> 00:06:07,840
.يبدو وجهُك أكثر شحوبًا من البارحة

68
00:06:07,840 --> 00:06:11,180
.حقًّا؟ لا بُدّ أنّ هذا من نسج خيالك

69
00:06:23,390 --> 00:06:25,390
هلاّ استرحنا؟

70
00:06:26,150 --> 00:06:28,160
.قطعنا مسافة طويلة

71
00:06:29,780 --> 00:06:32,700
.لديّ بعض الأعمال في هذه القرية

72
00:06:32,700 --> 00:06:36,510
.اذهبي واشتري بعض البطاطا الحلوة المجفّفة بذلك المال

73
00:06:36,510 --> 00:06:40,290
وهل تتوقّع منّي تصديق عدم هروبك وحدك؟

74
00:06:40,830 --> 00:06:42,800
.سأترك ذاك بعُهدَتِك

75
00:06:42,800 --> 00:06:45,470
...لا أظنّهم سيلاحقونني إلى هذه القرية ولكن

76
00:06:45,470 --> 00:06:47,970
.بقاؤك عزلاء سيثير أعصابك

77
00:06:47,970 --> 00:06:49,090
.عن إذنك

78
00:06:49,700 --> 00:06:50,930
...مهلاً

79
00:06:51,320 --> 00:06:53,250
!تمهّل

80
00:06:55,500 --> 00:06:58,930
.بلغتني إشاعة أنّكِ في هذا المكان

81
00:07:05,890 --> 00:07:07,650
.لم أرَكِ منذ مدّة

82
00:07:08,420 --> 00:07:10,410
هل نقُصَ وزنك قليلاً؟

83
00:07:11,150 --> 00:07:12,870
.وكذلك أنت

84
00:07:12,870 --> 00:07:17,220
.لا، بل أصبحتُ هزيلاً بسبب السّفر ببساطة

85
00:07:17,220 --> 00:07:20,200
ألن تأخذ استراحة لبعض الوقت؟

86
00:07:20,640 --> 00:07:24,640
.ثمّة ما رغبت بإعطائك إيّاه لو تجدّد لقائي بك

87
00:07:27,650 --> 00:07:33,150
.إنّه المال المتبقّي الذي عجزتُ عن سداده عندما حرّرتني من العبوديّة

88
00:07:34,130 --> 00:07:36,160
ما الذي تفعلينه حاليًّا؟

89
00:07:38,480 --> 00:07:41,940
.المواصلات هي ما يدعم العيش في هذه القرية

90
00:07:41,940 --> 00:07:45,280
.كنتُ أصنع حاملات لكي يستخدمها النّاقلون

91
00:07:45,280 --> 00:07:47,990
.أكسب رزقي ببيع تلك الحاملات

92
00:07:47,990 --> 00:07:49,770
وبعد؟

93
00:07:49,770 --> 00:07:53,370
.حرفة كتلك لا تدرّ عليك بهذا القدر من المال

94
00:07:53,370 --> 00:07:55,120
.أخبريني بما يحدث رجاءً

95
00:07:56,900 --> 00:08:03,710
.كنتُ أبيع جسدي لأولئك النّاقلين وكذا المزارعين من أجل كسب المزيد من المال

96
00:08:05,000 --> 00:08:06,730
وما خطب يدك؟

97
00:08:07,360 --> 00:08:09,910
...حاولت المساعدة في الزّراعة المتنقّلة ولكن

98
00:08:09,910 --> 00:08:11,130
...لم أستطع تحمّل ذلك

99
00:08:15,120 --> 00:08:16,540
...(ماكيي)

100
00:08:23,350 --> 00:08:26,030
!هل اعتراكِ بعض الجنون؟

101
00:08:26,030 --> 00:08:28,590
ما الفائدة من الإقدام على شيء كهذا؟

102
00:08:28,590 --> 00:08:30,880
—إن أصابك الأُكَال بسبب هذا، فلن

103
00:08:30,880 --> 00:08:32,720
.سأكون راضية بذلك

104
00:08:32,720 --> 00:08:35,650
.لا، بل يُستَحسَن حدوث ذلك

105
00:08:36,110 --> 00:08:37,600
...(كاغيهيسا-ساما)

106
00:08:38,130 --> 00:08:42,400
.لقد... فشلتُ في العيش وكذلك في الموت

107
00:08:42,400 --> 00:08:46,880
...في العيش، في القتل، في الكراهية، في التّسامح... كلّ ذلك

108
00:09:17,650 --> 00:09:19,080
هل تغذّيتِ؟

109
00:09:19,080 --> 00:09:20,120
.تغذّيت

110
00:09:22,070 --> 00:09:24,550
ها هي حصّتك، أتريدها؟

111
00:09:33,050 --> 00:09:35,910
أما آن... أن نستريح؟

112
00:09:35,910 --> 00:09:38,640
.ليس بسؤال أصلاً

113
00:09:39,170 --> 00:09:41,360
.(سنهرول إلى (تاكاياما

114
00:09:43,970 --> 00:09:47,700
!مـ-مهلاً! ما خطبُك؟

115
00:09:51,150 --> 00:09:52,480
الكزاز؟

116
00:09:52,990 --> 00:09:54,490
كيف؟

117
00:09:54,840 --> 00:09:57,360
.لا يسعني القول إنّي لا أمتلك حدسًا

118
00:09:57,360 --> 00:10:00,010
ماذا؟ تقصد منذ يومين؟

119
00:10:00,010 --> 00:10:02,620
.لكنّك خُدِشتَ فحسب

120
00:10:02,620 --> 00:10:05,880
...السّيف أو الرّمح المغموس في الرّوث طول اللّيل

121
00:10:05,880 --> 00:10:11,630
.يصبح سلاحًا مرعبًا يمكنه حمل أيّ عدد من الأمراض إلى جسد الهدف بمجرّد خدش

122
00:10:11,630 --> 00:10:13,390
...أرادوا أن يحرصوا

123
00:10:13,390 --> 00:10:15,840
.على تأخيري مهما كلّف الأمر

124
00:10:15,840 --> 00:10:18,750
ما العمل؟ أنعود القهقرى لـ(شيراكاوا)؟

125
00:10:19,800 --> 00:10:21,820
!لا تكوني حمقاء

126
00:10:21,820 --> 00:10:23,940
.ينتابني شعور سيّء

127
00:10:23,940 --> 00:10:26,980
.عليّ العودة بسرعة ولو أسرع بيوم واحد

128
00:10:26,980 --> 00:10:30,940
ثمّ أليس هذا جيّدًا... بالنّسبة لك؟

129
00:10:30,940 --> 00:10:33,490
.إنّها فرصة لن تنعمي بها مجدّدًا

130
00:10:34,350 --> 00:10:36,000
.لا تقلق

131
00:10:36,000 --> 00:10:39,910
.عندما أريد قتلك، سأحرص على فعلها بالشّكل اللّائق بيديّ

132
00:10:39,910 --> 00:10:43,390
.أنا من سأقرّر متى وكيف سأقتلك

133
00:10:48,850 --> 00:10:50,510
أأنت بخير؟

134
00:10:51,690 --> 00:10:56,070
.قلقك عليّ يجعلني أشعر بعدم جدواي بالخصوص

135
00:10:56,070 --> 00:10:58,770
.أجل، أنا واثقة من ذلك

136
00:10:59,360 --> 00:11:01,300
...اسمع، أخبرني

137
00:11:01,300 --> 00:11:03,820
أيُمكن أن يستعصي عليك حتّى الكلام؟

138
00:11:03,820 --> 00:11:05,100
أأدركتِ ذلك؟

139
00:11:05,590 --> 00:11:09,560
.مع تفاقم الكزاز، يعجز الفم واللّسان

140
00:11:09,560 --> 00:11:12,970
.في النّهاية، سأعجز عن خوض محادثة

141
00:11:14,540 --> 00:11:15,780
—ما الذي

142
00:11:15,780 --> 00:11:18,430
.أخفضي جسدك وألقي نظرة هناك

143
00:11:21,360 --> 00:11:23,240
أنختبئ وندعهم يمرّون؟

144
00:11:23,240 --> 00:11:25,040
.لا، لا فائدة

145
00:11:25,040 --> 00:11:30,930
.(على الأرجح أنّهم أرسلوا رجالاً إلى كلّ الطّرق مستعدّين لمطاردتي طول الطّريق إلى (إيدو

146
00:11:30,930 --> 00:11:34,000
،إن كان سينتهي الأمر بقتال في النّهاية

147
00:11:34,000 --> 00:11:37,250
.فليكُن الآن بينما ما زلتُ قادرًا على تحريك جسدي

148
00:11:37,250 --> 00:11:38,960
أيُمكنك الانتصار الآن؟

149
00:11:39,340 --> 00:11:41,150
.لستُ واثقًا

150
00:11:41,150 --> 00:11:43,910
.ولكن، ثمّة سبيل للنّصر

151
00:11:50,800 --> 00:11:52,640
ما خطبك يا فتاة؟

152
00:11:53,200 --> 00:11:56,080
!حلّقي أيّتها الدّبابير الذّهبيّة

153
00:12:00,650 --> 00:12:01,780
مـ-ماذا حدث؟

154
00:12:02,320 --> 00:12:03,600
!انعطَفَ من هناك

155
00:12:03,600 --> 00:12:04,120
!مهلاً

156
00:12:11,410 --> 00:12:12,730
.لنذهب

157
00:12:13,630 --> 00:12:16,030
!(أنوتسو كاغيهيسا)

158
00:12:16,030 --> 00:12:18,380
...لولاك أنت

159
00:12:18,380 --> 00:12:25,450
لماذا تحتّم على الـ(شينغيوتو-ريو) أن تتورّط في خطّة السّلطات؟

160
00:12:25,450 --> 00:12:27,150
لماذا؟

161
00:12:27,150 --> 00:12:30,170
...(أجبني يا (أنوتسو كاغيهيسا

162
00:12:32,260 --> 00:12:34,000
.يا لها من مفاجأة

163
00:12:34,000 --> 00:12:34,770
ماذا؟

164
00:12:34,770 --> 00:12:39,550
.أقصد موافقتك على أسلوب القتال هذا ذي الحيل الرّخيصة

165
00:12:39,550 --> 00:12:42,370
،لو أنّي قُتِلتُ بواسطتهم

166
00:12:42,370 --> 00:12:45,160
.لما تورّطتِ في أيّ مشكلة

167
00:12:45,630 --> 00:12:47,480
.الأمر صحيح حقًّا

168
00:12:47,480 --> 00:12:48,880
لماذا؟

169
00:12:49,410 --> 00:12:51,040
...ولكن ربّما

170
00:12:51,040 --> 00:12:55,250
،لو أنّك قُتلتَ بطريقة لا علاقة لها بوضعي على الإطلاق

171
00:12:55,250 --> 00:12:58,050
.لأثار ذلك استيائي بطريقة ما

172
00:12:58,050 --> 00:12:59,840
.يا لك من فتاة لعينة

173
00:13:02,030 --> 00:13:04,800
.والآن، مرحبًا بالحضور

174
00:13:04,800 --> 00:13:09,930
.وبكم خصوصًا يا أعضاء الـ(إيتّو-ريو)، سُررتُ بحضوركم حقّ المسرّة

175
00:13:09,930 --> 00:13:11,950
،أنا الزّعيم الجديد

176
00:13:11,950 --> 00:13:15,150
.(هاواكي كاغيمورا)

177
00:13:15,150 --> 00:13:18,460
في هذه المناسبة، الحرس الإمبراطوري في مُجمَلِه

178
00:13:18,460 --> 00:13:21,750
مدين لكم حقًّا على دعمكم الكريم

179
00:13:21,750 --> 00:13:26,610
.من أجل تأسيس أكاديميّة السّيّافين الرّسميّة هذه

180
00:13:26,990 --> 00:13:30,030
.أرجو أن تقبلوا بمأدبتنا كآية على امتناننا

181
00:13:30,030 --> 00:13:36,740
.يُشَرّفني أن تشربوا وتأكلوا مِلءَ بطونكم وتدعّموا إرادة وجسد السّيّاف الضّاري

182
00:13:36,740 --> 00:13:38,090
.هذا وكفى

183
00:13:38,540 --> 00:13:40,420
.مرحبًا أيّها الغنيّ

184
00:13:40,420 --> 00:13:43,510
...أباياما-دونو)، المال مهمّ ولكن)

