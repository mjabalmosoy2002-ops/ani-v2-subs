1
00:00:00,880 --> 00:00:01,940
،لو سمحت

2
00:00:02,330 --> 00:00:04,810
أيُمكنني مُقابلة الدوق؟

3
00:00:05,560 --> 00:00:08,020
.الأمر ضروري لأجل صُنع حلوى السُكر

4
00:00:08,440 --> 00:00:12,040
.لو كان مُمكنًا أودُّ مقابلة سموّه بمُفرده

5
00:01:45,080 --> 00:01:48,840
.يوجدُ شيءٌ أرغبُ بسؤالك عنه لأجل صُنع حلوى السُكر

6
00:01:50,850 --> 00:01:54,210
.أخبرني باسم السيدة الّتي في اللوحة من فضلك

7
00:01:56,870 --> 00:01:58,720
لماذا تحتاجين إلى اسمُها؟

8
00:01:59,150 --> 00:02:01,180
.من أجل صنع شكلُها المناسب

9
00:02:01,690 --> 00:02:06,680
.أعتقدُ أنّي بحاجة حتّى لمعرفة الأشياء الّتي لا تُبينها اللوحة

10
00:02:07,470 --> 00:02:09,100
ومن ثُمَّ ستتمكنين من صُنعها؟

11
00:02:10,470 --> 00:02:11,560
.لا أعلم

12
00:02:13,300 --> 00:02:16,490
.سؤالك هذا يعتبرُ تطفّلًا على ذكرياتي

13
00:02:17,890 --> 00:02:20,360
..إذا تجرأتِ على الدخول إلى هُناك وتحفيزها

14
00:02:20,360 --> 00:02:22,220
،وما زلتِ غير قادرة على صُنعها

15
00:02:22,220 --> 00:02:24,260
.سأجعلكِ تدفعين ثمن ذلك بموتكِ

16
00:02:24,700 --> 00:02:26,540
هل أنتِ مستعدة لقبول ذلك؟

17
00:02:28,560 --> 00:02:30,500
.لا أستطيع الاستعداد للموت

18
00:02:31,050 --> 00:02:33,500
.لقد قطعتُ وعدًا لصديقي المُقرب

19
00:02:33,800 --> 00:02:36,210
.ويوجد شيءٌ يجبُ عليَّ قولهُ أيضًا

20
00:02:36,900 --> 00:02:38,220
!ولهذا السبب لن أموت

21
00:02:38,380 --> 00:02:39,880
،ولأنني مصممةٌ على ذلك

22
00:02:40,060 --> 00:02:42,760
!لن أفشل بصنع تمثال الحلوى

23
00:02:45,640 --> 00:02:47,140
.[كريستينا]

24
00:02:47,780 --> 00:02:50,350
أهذا هو اسمُها؟

25
00:02:50,620 --> 00:02:51,560
.أجل

26
00:02:52,180 --> 00:02:54,230
ما هو اسمُها الحقيقي؟

27
00:02:55,040 --> 00:02:56,820
.[ليالس شيل إيرل]

28
00:02:57,610 --> 00:03:00,570
لمّا لا تُناديها باسمُها الحقيقي؟

29
00:03:01,600 --> 00:03:03,500
.لأنها هي من رغبت بذلك

30
00:03:04,090 --> 00:03:06,600
،أرادت أنّ تُسمى باسم بشري

31
00:03:07,080 --> 00:03:08,570
.وطلبت مني أن أمنحُها واحدًا

32
00:03:09,830 --> 00:03:13,020
.كان ذلك في اللحظة الّتي وُلدت فيها

33
00:03:16,000 --> 00:03:19,700
.ظلت شاردة وتحدقُ بالموجات المرتفعة التّي ولدت منها

34
00:03:20,580 --> 00:03:25,320
,كان من المُحزن أن تتأذى ويقبض عليها من قبل البشر

35
00:03:25,320 --> 00:03:26,890
.لذا أعدتُها إلى القلعة

36
00:03:27,590 --> 00:03:29,890
أين هي [كريستينا-ساما] الآن؟

37
00:03:31,030 --> 00:03:32,350
.ماتت وتلاشت

38
00:03:33,720 --> 00:03:35,520
.قبل عام ونصف من الآن

39
00:03:36,820 --> 00:03:38,320
.لقد كان واقعًا بحبّها

40
00:03:39,300 --> 00:03:41,650
،وأيضًا حتّى الآن

41
00:03:42,420 --> 00:03:45,990
.لا زال مكانٌ ما بقلبه يُنادي باسمُها

42
00:03:47,170 --> 00:03:51,210
.لقد سمعتُ إنّهُ كان يتصرف بغرابة، لكني لم أدرك أن الأمر بهذا السوء

43
00:03:51,640 --> 00:03:55,130
.ولا يسعني إلا أن أتساءلُ عن حقيقة أن [كريستينا-ساما] ليست معه

44
00:03:55,450 --> 00:03:56,520
حبيبته؟

45
00:03:59,510 --> 00:04:00,590
.حبيبتهُ الجنّية

46
00:04:02,020 --> 00:04:03,300
ذات شعرٌ أزرق؟

47
00:04:03,600 --> 00:04:05,850
أجل، هل رأيتُها في القلعة؟

48
00:04:06,160 --> 00:04:07,560
.رأيت صورةٌ لها

49
00:04:07,850 --> 00:04:11,770
.لقد أمر الفتاة بأن تصنع تمثال سُكر لها

50
00:04:12,090 --> 00:04:14,010
ليست السيدة بنفسِها؟

51
00:04:15,700 --> 00:04:16,610
.[شال]

52
00:04:16,730 --> 00:04:19,230
كم الفترة الّتي تعيشُها الجنّيات الّتي تولدُ من البحر؟

53
00:04:19,630 --> 00:04:23,360
.حياة جنّيات الماء غير مستقرة، لذا فهي متفاوتة

54
00:04:23,360 --> 00:04:27,240
.بعضهم يعيشُ لمئات السنين، والبعض الآخر يتلاشى بعد بضع سنوات فحسب

55
00:04:27,610 --> 00:04:28,800
ماذا عن حلوى السُكر؟

56
00:04:28,800 --> 00:04:31,620
إن تناولها يُطيلُ من حياة الجنّية، أليس كذلك؟

57
00:04:32,030 --> 00:04:35,130
.لا توجد الكثير من حلوى السُكر بهذا النوع من القوة

58
00:04:35,690 --> 00:04:38,420
..بشيء تقوم أنت بصنعه، سيكون ممكنًا

59
00:04:38,670 --> 00:04:41,130
.لكنهُ سيكون لبضعة أسابيع أو أشهر فحسب

60
00:04:41,570 --> 00:04:42,910
..فهمت

61
00:04:43,660 --> 00:04:45,840
.لقد تلاشت

62
00:04:47,330 --> 00:04:48,930
..لهذا السبب الدوق

63
00:04:50,050 --> 00:04:52,770
لماذا يُزعج بشريٌ نفسهُ بأمرٍ كهذا؟

64
00:04:52,960 --> 00:04:56,860
.يُمكنهُ شراء جنّيٌ مُرافق وإرضاء نفسهُ حينها

65
00:04:59,750 --> 00:05:02,110
.لم تكن مجرد جنّية مُرافقة

66
00:05:03,160 --> 00:05:06,150
.على الأرجح لا أحد بإمكانه أخذ مكانها

67
00:05:07,240 --> 00:05:12,450
.كانت تقول دائمًا أن جنّيات الماء لا تعلم  أبدًا المدة الّتي ستعيشها

68
00:05:16,180 --> 00:05:18,760
.أنا لا أفهمُ مُطلقًا

69
00:05:19,260 --> 00:05:21,760
..ما  الّذي يرغبُ بهِ الدوق حقًّا

70
00:05:22,800 --> 00:05:25,590
أيُمكنني جلب أدواتي هُنا؟

71
00:05:26,040 --> 00:05:28,720
.سأقوم بعملي بوجودك

72
00:05:29,280 --> 00:05:33,060
!بينما أطرح عليك أسئلة حول [كريستينا-ساما]، سأمنحُها الشكل المناسب

73
00:05:35,320 --> 00:05:39,100
.من المستحيل فهم الحمل الّذي كان يتحملهُ الدوق لوحده

74
00:05:39,840 --> 00:05:43,480
.[لم تتمرد عائلة [ألبرن] ضدَّ عائلة [مليسلاند

75
00:05:43,630 --> 00:05:46,320
.لقد قاتلوا من أجل جلالة الملك، [إدموند الثّاني]

76
00:05:46,860 --> 00:05:48,240
ورغم ذلك، ماذا حدث تاليًا؟

77
00:05:48,520 --> 00:05:51,450
،استحوذت العائلة المالكة على جميع المكاسب التجارية

78
00:05:51,920 --> 00:05:55,120
.وأجبروا على القيام بزيارة من باب المجاملة كلّ شهر

79
00:05:55,630 --> 00:05:59,460
كم يجب أنّ يكونوا قد أمتعضوا من المعاملة الّتي تلقوها؟

80
00:06:00,080 --> 00:06:01,960
.كانت هي من هدأت ذلك الغضب

81
00:06:02,240 --> 00:06:03,750
.لوحدها فقط

82
00:06:06,480 --> 00:06:08,840
شخصٌ تحملَ كلّ ذلك الاستياء والمرارة؟

83
00:06:08,880 --> 00:06:11,680
.لا بدَّ أن تلك الجنّية كانت سعيدة من دون شك

84
00:06:11,740 --> 00:06:14,430
.أجل، أعتقدُ أنّها كانت سعيدة

85
00:06:15,560 --> 00:06:18,730
.لقد أعددتُ الكثير من حلوى السُكر لأجل الدوق

86
00:06:19,300 --> 00:06:22,440
.سمعتُ بأن جميعُها أُعطيت لها

87
00:06:23,290 --> 00:06:25,190
.وهي قالت ذلك بنفسِها

88
00:06:25,450 --> 00:06:29,490
.قالت بأنّها تودٌّ أن تعيش لوقتٍ أطول قليلًا من أجل الدوق

89
00:06:30,790 --> 00:06:32,370
من أجل الدوق؟

90
00:06:33,320 --> 00:06:37,460
.رُبما كانت قلقة من أن الأمور ستؤول إلى هذا

91
00:06:40,880 --> 00:06:41,670
ما الّذي يجري؟

92
00:06:43,140 --> 00:06:46,630
.أيُّها الفيكونت، قوات الإيرل على الطريق أمامنا

93
00:06:47,510 --> 00:06:48,970
..ذلك العجوز

94
00:06:50,440 --> 00:06:51,640
!أيُّها الإيرل [داونينغ]

95
00:06:51,950 --> 00:06:53,640
أهذا أنت [ميركوري]؟

96
00:06:53,850 --> 00:06:56,880
.كما أرى فأن محاولتك لإقناعه كانت مضيعةٌ للوقت

97
00:06:56,880 --> 00:06:58,300
كنتَ على دراية بذلك؟

98
00:06:59,140 --> 00:07:02,590
علمنا بعلاقتك مع عائلة [ألبرن] حتى قبلَ

99
00:07:02,590 --> 00:07:04,480
.أن تُصبح فيكونت السُكر الفضّي

100
00:07:05,170 --> 00:07:08,190
!مع ذلك، لن نسمح بمزيد من التدخل

101
00:07:08,340 --> 00:07:11,070
.يجبُ إخماد آخر شرارات التمرد في المملكة

102
00:07:11,390 --> 00:07:12,660
.لن أتدخل

103
00:07:13,000 --> 00:07:15,660
.لكن [آن هالفورد] متواجدةٌ في القلعة

104
00:07:15,660 --> 00:07:17,580
حقًّا؟ تلك الفتاة؟

105
00:07:18,080 --> 00:07:19,370
.هذا مؤسف

106
00:07:19,930 --> 00:07:22,940
.كل ما يُمكننا فعله هو التمني بأن تخفي نفسها جيدًا

107
00:07:22,940 --> 00:07:23,710
..لكن

108
00:07:30,000 --> 00:07:31,160
..تلك الفتاة

109
00:07:32,230 --> 00:07:32,890
.أنت

110
00:07:33,390 --> 00:07:35,430
هل هذا أحد معارفك؟

111
00:07:36,640 --> 00:07:38,970
.على ما يبدو أن أحد الفرسان قد أمسك به

112
00:07:38,970 --> 00:07:39,850
.أفتحهُ

113
00:07:44,780 --> 00:07:46,570
.[ميثريل ليد بود]

114
00:07:46,570 --> 00:07:50,120
.لقد تناول الحساء بأكمله بينما هو في الداخل

115
00:07:50,120 --> 00:07:53,710
!ليس كذلك! أعني فعلت ذلك.. لكن الأمر ليس كما يبدو

116
00:07:53,710 --> 00:07:57,330
.كنتُ أُحاول إنجاز مهمتي، لكني شعرتُ بالجوع بعد ذلك

117
00:07:57,470 --> 00:07:58,490
ما الّذي حدث لها؟

118
00:07:59,220 --> 00:08:03,080
!صحيح! أتيتُ للبحث عنك من أجلِها

119
00:08:03,790 --> 00:08:04,580
تبحثُ عني؟

120
00:08:05,120 --> 00:08:07,190
.لأنّ [آن] تستدعيك

121
00:08:07,600 --> 00:08:10,550
.إنّها تريدُ منك أن تعود

122
00:08:10,550 --> 00:08:13,440
.هل أنت أحمق؟ هي من طلبت مني الرحيل

123
00:08:13,440 --> 00:08:16,510
أتعتقدُ حقًّا بأن [آن] ستطلبُ منك المُغادرة؟

124
00:08:15,800 --> 00:08:16,510
..أيُّها

125
00:08:16,840 --> 00:08:20,730
!حدث ذلك لأن [جوناس] هددَ [آن] وجعلها تقول ذلك

126
00:08:20,800 --> 00:08:21,520
ماذا؟

127
00:08:21,550 --> 00:08:25,500
!قام [جوناس] بسرقة جناحي وأبعدك عن [آن]

128
00:08:25,500 --> 00:08:28,070
!واستخدم ذلك ليسمح لنفسه بالهرب

129
00:08:28,110 --> 00:08:31,190
!كانت [آن] تُنادي باسمك طوال الوقت

130
00:08:33,320 --> 00:08:36,870
.بقيت [آن] في القلعة ولقد كانت تعمل على صُنع حلوى السُكر

131
00:08:36,960 --> 00:08:41,450
.لن يسمح الدوق [لآن] بالمُغادرة إلى أن تصنع شيئًا ينال رضاه

132
00:08:41,710 --> 00:08:44,210
.وأصبحت [آن] جادةٌ بشأن ذلك

133
00:08:45,270 --> 00:08:46,540
.تلك الحمقاء

134
00:08:46,570 --> 00:08:48,010
!هيه؟ أنت

135
00:08:48,010 --> 00:08:49,500
!لماذا تفعل هذا؟

136
00:08:49,500 --> 00:08:52,760
!أنت! ما خطبك، دعني أخرج

137
00:08:49,980 --> 00:08:51,300
!سأعود لأجله

138
00:08:53,000 --> 00:08:54,810
لماذا يجبُ أن أهتم بشيءٍ كهذا؟

139
00:08:54,810 --> 00:08:56,800
ما الّذي تعنيه بفعلتك هذه؟

140
00:08:56,800 --> 00:08:58,720
..أنا [ميثريل ليد بود سا

141
00:08:59,890 --> 00:09:02,680
أيّتُها الحرفية، ما الّذي تُحاولين فعله؟

142
00:09:03,100 --> 00:09:05,350
.سأصنعُ تمثالًا يشبهُ [كريستينا-ساما] تمامًا

143
00:09:05,720 --> 00:09:09,850
.طولها، وجهها، تعابيرُها، وكلّ شيء

144
00:09:10,560 --> 00:09:17,030
سموّك، عندما تُفكر في [كريستينا-ساما] فكيف تبدو لكَ غالبًا؟

145
00:09:18,800 --> 00:09:21,040
..عندما أفكرُ بشخصٍ مُعين

146
00:09:22,980 --> 00:09:26,670
.لسببٍ ما، أتذكرهُ وهو ينظرُ إليَّ بمزاج سيء

147
00:09:29,640 --> 00:09:32,980
.أتصورها مسترخية، متكئةٌ على الحائط

148
00:09:33,640 --> 00:09:35,880
.وتبتسمُ أيضًا

149
00:09:36,520 --> 00:09:37,690
.فهمت

150
00:09:41,890 --> 00:09:42,940
.سموّك

151
00:09:44,790 --> 00:09:45,560
ما الأمر؟

152
00:09:45,560 --> 00:09:48,900
.أكثرُ من 300 جندي قاموا بمُحاصرة القلعة

153
00:09:49,240 --> 00:09:51,070
.إنّهم رجال الإيرل [داونينغ]

154
00:09:51,870 --> 00:09:52,610
ماذا يريدون؟

155
00:09:53,070 --> 00:09:55,070
،لقد أتوا للمطالبة بالتخلي عن القلعة

156
00:09:55,310 --> 00:09:58,610
.وأيضًا للقبض على سموّك

157
00:09:58,860 --> 00:09:59,820
.دعهم ينتظرون

158
00:10:00,610 --> 00:10:02,280
.أرغبُ برؤية هذا

159
00:10:03,830 --> 00:10:06,620
لمّا يقوم الإيرل [داونينغ] بالقبض عليك، سموّك؟

160
00:10:07,360 --> 00:10:09,880
.لم أقم بزيارة [لويستون] منذُ عام ونصف

161
00:10:10,160 --> 00:10:14,580
.يقول بأني أفتقرُ إلى الولاء، يجبُ أن يجهز العذر المناسب للهجوم عليّ

162
00:10:15,010 --> 00:10:17,510
..لكن لماذا؟ القيام بشيءٍ كهذا

163
00:10:17,610 --> 00:10:20,760
.أصمتي أيّتها الحرفية، عملُكِ هو صنع هذهِ فحسب

164
00:10:20,760 --> 00:10:22,470
..لكن لمّا

165
00:10:23,260 --> 00:10:25,220
.لا يُمكنكِ فهم ذلك

166
00:10:25,440 --> 00:10:27,640
..أنّ تُنتزع كلّ ذرة من كرامتك

167
00:10:27,760 --> 00:10:30,730
!والإجبار على التصرف بخضوع، ما شعوركِ حيال ذلك

168
00:10:31,140 --> 00:10:33,030
!الشخص الوحيد الّذي فهم كانت هي

169
00:10:43,910 --> 00:10:48,040
..بالنسبة للدوق [كريستينا-ساما] كانت الوحيدة الّتي

170
00:10:48,780 --> 00:10:51,750
.لكنها أختفت الآن

171
00:10:52,820 --> 00:10:55,550
.وهذا الشخص لوحدهِ حاليًا

172
00:10:56,230 --> 00:10:57,690
.هذا ما يعتقدهُ

173
00:11:00,520 --> 00:11:01,470
.أرغبُ بصنعها

174
00:11:04,150 --> 00:11:07,100
.أرغبُ بصنع الشيء الّذي يرغبُ بهِ الدوق

175
00:11:09,420 --> 00:11:12,900
.وأريدُ أن أصوّر مشاعر ذلك الشخص كما يجب

176
00:11:17,650 --> 00:11:18,860
.سأُساندها

177
00:11:20,480 --> 00:11:21,410
شال]؟]

178
00:11:22,810 --> 00:11:23,530
هيه؟

179
00:11:30,550 --> 00:11:32,040
..[شال]

180
00:11:32,340 --> 00:11:33,420
أهذا أنت حقًّا؟

181
00:11:34,740 --> 00:11:36,630
.حماقتكِ لا مثيل لها

182
00:11:40,400 --> 00:11:41,340
..[شال]

183
00:11:42,080 --> 00:11:44,890
.لقد أخبرني [ميثريل ليد بود] بكلّ شيء

184
00:11:45,640 --> 00:11:47,530
لقد أخبرك إذن؟

185
00:11:48,550 --> 00:11:52,480
..شال]، آسفة في ذلك الوقت أنا]

186
00:11:52,680 --> 00:11:54,060
.لا داعي لأن تعتذري

187
00:11:54,840 --> 00:11:57,230
.الأهم من ذلك هو أننا سنغادر القلعة الآن

188
00:11:58,160 --> 00:12:00,600
..لكن حلوى السُكر

189
00:12:02,750 --> 00:12:05,370
.لن أسمح لهذهِ الحرفية بالرحيل

190
00:12:05,550 --> 00:12:09,950
.ستبقى هُنا إلى أن تصنع ما أسعى إليه

191
00:12:09,950 --> 00:12:12,620
.إذن يجب عليَّ أن أقضي عليك الآن

192
00:12:12,620 --> 00:12:13,460
!مهلًا، [شال]

193
00:12:13,840 --> 00:12:15,670
.وأنت أيضًا تمهل قليلًا سموّك

194
00:12:15,850 --> 00:12:18,570
..سأستمرُ بعملي لذا

195
00:12:18,570 --> 00:12:19,460
هل أنتِ مدركة لمّا تقولينه؟

196
00:12:19,930 --> 00:12:23,850
.أنا جادة! أرغب بصنع تمثال حلوى لهذهِ الجنّية

197
00:12:24,160 --> 00:12:25,610
ما الّذي تُحاولين فعله؟

198
00:12:25,610 --> 00:12:27,680
..لقد توليت هذا العمل، لهذا

199
00:12:28,880 --> 00:12:31,390
!هذهِ القلعة محاصرة من قِبل الجنود

200
00:12:31,390 --> 00:12:33,140
..إذا هاجموا هذا المكان

201
00:12:33,310 --> 00:12:34,330
.أعلمُ ذلك

202
00:12:34,330 --> 00:12:35,470
!هذا خطير

203
00:12:35,470 --> 00:12:36,770
!أدركُ ذلك أيضًا

204
00:12:37,080 --> 00:12:40,320
!لا يُمكنني التخلي عن عملي الّذي لم أنتهِ منه

205
00:12:46,180 --> 00:12:47,240
.أنت مُستفزة

206
00:12:52,000 --> 00:12:55,290
.قومي بصنعها إذن، لكني سأبقى هُنا أيضًا

207
00:12:58,690 --> 00:13:00,170
أسيكون هذا مناسبًا؟

208
00:13:01,810 --> 00:13:02,840
.لا بأس

209
00:13:03,810 --> 00:13:04,780
.باشري بعملك

210
00:13:16,600 --> 00:13:19,270
.إنّها تبدو مثلها للغاية

211
00:13:20,160 --> 00:13:22,320
.لكن لون عينيها ليس كذلك

212
00:13:23,150 --> 00:13:24,030
.لونهما فضّي

213
00:13:24,460 --> 00:13:27,280
..وتمتلكان إحساسٌ بالشفافية، مثل إنعكاس ضوء أخّاذ

214
00:13:27,920 --> 00:13:30,580
..لو كانت تمتلك تلك العينان، فحينها هي

215
00:13:33,650 --> 00:13:35,160
.هذا هو تمثال حلوى

216
00:13:35,680 --> 00:13:37,960
ما المغزى من صنع شيءٍ يشبهُ ذلك؟

217
00:13:38,540 --> 00:13:44,380
.تولد الجنّيات نتيجة لتحديق الكائنات الحية في جسمٍ ما وتكثف الطاقة من خلاله

218
00:13:44,380 --> 00:13:46,800
،إذا ما حدقت بهذه

219
00:13:46,800 --> 00:13:48,700
فهل سيولدُ شيئًا ما؟

220
00:13:49,310 --> 00:13:51,100
ألا تعتقدُ أن ذلك مُمكنًا؟

221
00:13:51,100 --> 00:13:52,390
..أيُعقل

222
00:13:52,750 --> 00:13:56,810
أنك تظنُّ أن [كريستينا-ساما] ستولدُ مُجدّدًا من خلال هذه؟

223
00:13:57,260 --> 00:14:00,270
هل سبق لكِ وأن شاهدت لحظة اختفاء جنّية سابقًا؟

224
00:14:01,870 --> 00:14:07,780
.عندما تتحول هيئتُها إلى ذرات ضوءٍ صغيرة وتتلاشى في الجوّ

225
00:14:10,770 --> 00:14:16,060
.إذن كلّ ما يجب أن يحدث هو تشكيل تلك الهيئة الّتي تلاشت في الجوّ مرةً أُخرى

226
00:14:17,410 --> 00:14:18,460
.هذا ليس مُمكنًا

227
00:14:19,120 --> 00:14:21,310
.ما فُقد لا يُمكن إحيائه

228
00:14:21,310 --> 00:14:23,960
.مهما بكيت أو رغبت بذلك

229
00:14:24,520 --> 00:14:26,350
,حتّى لو استمريت بالتحديق بهذا الشيء

230
00:14:26,350 --> 00:14:30,180
!ستولدُ جنّيةٌ غريبة ومشوّهة منها، وستكون هذهِ نهاية الأمر

231
00:14:30,180 --> 00:14:32,010
!لن أسمح لك بقول المزيد

232
00:14:32,010 --> 00:14:32,890
!هذهِ هي الحقيقة

233
00:14:32,890 --> 00:14:34,420
!توقف [شال]

234
00:14:39,520 --> 00:14:41,110
.لم نقدر على صنعها بالوقت المناسب

235
00:14:42,190 --> 00:14:43,460
..سموّك

236
00:14:46,030 --> 00:14:47,000
ما الّذي تفعلينه؟

237
00:14:47,000 --> 00:14:48,950
!قد أكون قادرةٌ على صنع لونٌ فضّي

238
00:14:49,320 --> 00:14:51,490
ما زلتِ تفكرين بالعمل في الوقت الّذي يحدث بهِ كلّ هذا؟

239
00:14:52,280 --> 00:14:55,200
!لا داعي لأن تقومي بمسايرة أوهام هذا الرجل

240
00:14:55,530 --> 00:14:58,870
!أنا لا أُساير أحدًا! هذا هو عملي

241
00:14:59,130 --> 00:15:02,890
.إنّهُ الأمر الوحيد الّذي يُمكنني فعله، وهو ما أفخرُ به

242
00:15:07,030 --> 00:15:08,420
.إنكِ حمقاء

243
00:15:08,940 --> 00:15:13,350
!أظنُّ إني كذلك، لكني أرغبُ القيام بهذا

244
00:15:13,980 --> 00:15:15,310
،إذا كان هذا ما ترغبين به

245
00:15:16,710 --> 00:15:19,600
.فلتعملي إذن حتّى تشعرين بالرضا تمامًا

246
00:15:23,320 --> 00:15:25,400
!دوق (فيلاكس) في الغرفة الّتي أمامنا

247
00:15:25,420 --> 00:15:26,360
.توقفوا

248
00:15:28,320 --> 00:15:30,330
.لا يُمكنني السماح لكم بالعبور

249
00:15:45,910 --> 00:15:48,380
الجنّي المُقاتل لدوق (فيلاكس)؟

250
00:15:48,540 --> 00:15:49,970
!أنتم! توقفوا عن ذلك

251
00:15:50,820 --> 00:15:51,930
فيكونت السُكر الفضّي؟

252
00:15:52,250 --> 00:15:54,760
.منحنا الإيرل [داونينغ] الإذن

253
00:15:54,970 --> 00:15:58,630
،]شال]، سمعتُ أنك ذهبت دون سابق إنذار لإنقاذ [آن]

254
00:15:59,040 --> 00:16:01,230
لكن لماذا تقوم بحماية [ألبرن]؟

255
00:16:01,230 --> 00:16:03,440
.أنا لا أقوم بحمايته

256
00:16:03,700 --> 00:16:05,940
.ومع ذلك، في الوقت الراهن لن أسمح لأي أحد بالمرور

257
00:16:07,830 --> 00:16:09,030
.فلتفهم من فضلك

258
00:16:09,210 --> 00:16:13,000
.كلما مرَّ المزيد من الوقت، سيُظهر ذلك أن [ألبرن] يُقاوم

259
00:16:13,000 --> 00:16:13,910
.وهذا سيءٌ بالنسبة له

260
00:16:14,330 --> 00:16:17,490
.أنا آسف، ولكن هذا ما تتمناهُ هي

261
00:16:23,870 --> 00:16:27,290
.هُنا، في تمثال السكر الفضّي هذا

262
00:16:30,800 --> 00:16:33,260
!أترجاكِ، فلتظهري

263
00:16:41,600 --> 00:16:42,750
..هذه

264
00:16:58,740 --> 00:16:59,960
.إنّها هي

265
00:17:06,720 --> 00:17:07,500
.أيّتُها الحرفية

266
00:17:08,200 --> 00:17:10,010
.لم أسألكِ عن اسمك

267
00:17:10,930 --> 00:17:13,840
.إنهُ [هالفورد] [آن هالفورد]

268
00:17:14,430 --> 00:17:18,150
.هذا هو ما أردتهُ، [هالفورد]

269
00:17:19,740 --> 00:17:23,130
.مهما كانت رغبتي حمقاء، لكني أردتُ هذه

270
00:17:23,940 --> 00:17:25,340
.ببساطة أردتهُ فحسب

271
00:17:28,180 --> 00:17:30,150
.أردتُ رؤيتها مرة أخرى

272
00:17:30,880 --> 00:17:33,030
.لم يُثبت أحدٌ ذلك

273
00:17:33,720 --> 00:17:37,410
،إذا استمريت سموّك بالتفكير في [كريستينا-ساما] وواصلت التحديق بهذا

274
00:17:37,790 --> 00:17:40,080
.فحينها رُبما سيحدث شيءٌ يومًا ما

275
00:17:40,490 --> 00:17:43,540
!لم يُثبت أحدٌ بأن ذلك لن يحدث

276
00:17:46,560 --> 00:17:49,540
.حتّى لو كانت هذهِ مُجرد كلمات لمواساتي، فإنّها تجعلُني أشعرُ بالسعادة

277
00:17:50,640 --> 00:17:52,130
.كما وعدتكِ

278
00:17:52,620 --> 00:17:55,670
.خُذي هذهِ وعودي إلى جنّيك

279
00:17:55,860 --> 00:17:56,780
.أذهبي

280
00:18:00,030 --> 00:18:00,930
.[هالفورد]

281
00:18:03,560 --> 00:18:06,980
.إنكِ حرفية سُكر رائعة

282
00:18:09,430 --> 00:18:10,440
![شال]

283
00:18:12,870 --> 00:18:13,830
![شال]

284
00:18:29,910 --> 00:18:32,540
.شال]، ش-شكرًا لك]

285
00:18:34,000 --> 00:18:35,840
لم تتأذِ، أليس كذلك [آن]؟

286
00:18:35,840 --> 00:18:36,910
هيو]؟]

287
00:18:36,910 --> 00:18:38,760
لمّا أنت هُنا؟

288
00:18:38,890 --> 00:18:40,760
.كانت توجدُ بعض الظروف المعينة

289
00:18:40,970 --> 00:18:43,260
.لقد جئتُ للقبض على دوق (فيلاكس)

290
00:18:43,560 --> 00:18:44,600
هل هو في الأعلى؟

291
00:18:45,400 --> 00:18:48,060
.أجل، إنّهُ برفقة تمثال السُكر

292
00:18:49,320 --> 00:18:50,360
.فهمت

293
00:18:51,310 --> 00:18:52,170
.لنذهب

294
00:19:00,200 --> 00:19:01,530
شال]؟]

295
00:19:01,530 --> 00:19:03,200
.في الوقت الحالي، لا تتحركي

296
00:19:03,440 --> 00:19:05,070
..لكن

297
00:19:06,040 --> 00:19:07,800
.لا تجعليني أقلقُ كثيرًا

298
00:19:08,230 --> 00:19:09,270
.آسفة

299
00:19:09,980 --> 00:19:12,750
..لكني حرفية سُكر لذا

300
00:19:13,110 --> 00:19:13,960
.[آن]

301
00:19:15,960 --> 00:19:19,980
.هذهِ المرة الثّانية الّتي تُناديني باسمي

302
00:19:21,350 --> 00:19:23,470
هل تتذكرين كم مرة ناديتكِ به؟

303
00:19:23,470 --> 00:19:24,970
.حسنٌ، لأن ذلك يجعلُني سعيدة

304
00:19:28,900 --> 00:19:29,810
.[شال]

305
00:19:31,320 --> 00:19:34,440
.أريدُ منك أن تبقى معي من الآن فصاعدًا

306
00:19:35,120 --> 00:19:36,070
ألا بأس بذلك؟

307
00:19:48,370 --> 00:19:49,910
!مرحبًا سيّدتي

308
00:19:49,910 --> 00:19:52,810
!لقد سمعتُ بكلّ شيء! يا لهُ من أمر رائع

309
00:19:52,810 --> 00:19:53,960
رائع؟

310
00:19:53,960 --> 00:19:55,960
.تمثال السُكر الخاص بدوق (فيلاكس)

311
00:19:56,450 --> 00:20:00,000
.لقد صُدمت عندما سمعت بأنه تمَّ القبض على الدوق

312
00:20:00,000 --> 00:20:03,310
.قال الجميع بأنهُ لن يكون من الغريب على الإطلاق معاقبته بقسوة

313
00:20:03,310 --> 00:20:06,200
لكنهُ يعيشُ منعزلًا فحسب تحت إشراف الإيرل [داونينغ]، أليس كذلك؟

314
00:20:06,200 --> 00:20:09,390
كانت تلك طريقةٌ نبيلة للتعامل معه، ألّا تعتقدين ذلك؟

315
00:20:09,390 --> 00:20:14,330
!وحسب الشائعات فأن كل ذلك بسبب حلوى السُكر التّي صنعتيها له، أيّتُهاالسيدة الصغيرة

316
00:20:16,440 --> 00:20:20,730
!أفترضُ أن ما يُقال صحيح بأن حلوى السُكر تجلبُ الحظ السعيد

317
00:20:31,200 --> 00:20:32,870
هل انتهيتِ من أداء صلواتك؟

318
00:20:34,480 --> 00:20:35,380
.أجل

319
00:20:37,090 --> 00:20:39,740
.على أمل أن نتقبل موت من نحبّهم

320
00:20:40,770 --> 00:20:45,450
.ولأولئك الّذين بقوا منا بأن لا يُحاصروا بالحزن دائمًا

321
00:20:46,040 --> 00:20:47,720
![آن]

322
00:20:47,930 --> 00:20:51,790
!يوجدُ في موقف الطعام هُناك العديد من الأطعمة اللذيذة المظهر

323
00:20:51,790 --> 00:20:53,850
!لنذهب ثلاثتنا للأكل

324
00:20:53,850 --> 00:20:56,020
!مــرحــى

325
00:20:56,270 --> 00:20:57,060
هل نذهب؟

326
00:20:57,580 --> 00:20:58,360
.أجل

327
00:20:59,360 --> 00:21:04,900
إذا واصــلتُ الــتــحــديــق فــيــكِ

328
00:22:36,040 --> 00:22:39,960
ورشــة عــمــل رادكـــلــيــف