1
00:01:01,580 --> 00:01:03,380
♪ غير راغب في سماع الآخرين ♪

2
00:01:03,880 --> 00:01:09,210
♪ تهبُّ الرّياح. نمشي في الثّلج معاً ♪

3
00:01:09,210 --> 00:01:11,170
♪ الخير سيتفتّح ♪

4
00:01:11,500 --> 00:01:15,210
♪ اِنسَ الألم ♪

5
00:01:16,880 --> 00:01:18,920
♪ ألقِ اللّوم على الجرس ♪

6
00:01:19,210 --> 00:01:24,460
♪ لم يستطع إيقاظ الرُّوح المُبهمة ♪

7
00:01:24,460 --> 00:01:26,790
♪ انتظر حتّى الفجر ♪

8
00:01:26,790 --> 00:01:31,580
♪ أسود وأبيض صافيان ♪

9
00:01:32,250 --> 00:01:37,040
♪ الآلهة عُميٌ عندما يتعلّق الأمر بالمواجهة بين العدل والشرّ♪

10
00:01:37,040 --> 00:01:39,630
♪ اِنسَ الحزن والبهجة ♪

11
00:01:39,880 --> 00:01:44,750
♪ البيادق في اللّعبة تربط ما بين الصّواب والخطأ ♪

12
00:01:44,750 --> 00:01:48,420
♪ من سيكسر الطّريق المسدود ♪

13
00:01:49,580 --> 00:01:56,630
♪ من الصّعب معالجة العقل، على الأقلّ هناك قلب ♪

14
00:01:57,250 --> 00:02:04,500
♪ التّرنيمة مفقودة في عزاء كسب السّلام ♪

15
00:02:04,880 --> 00:02:14,460
♪ أتحمّل فترة عاصفة مقابل السّكينة لحياتي ♪

16
00:02:16,420 --> 00:02:26,130
♪ بدعمك، لن تتغيّر إرادتي أبداً ♪

17
00:02:23,130 --> 00:02:27,080
مذكّرات الجنّيات الموسم 1

18
00:02:37,750 --> 00:02:39,580
!تعالوا وانظروا

19
00:02:39,580 --> 00:02:41,540
!راهنوا على هذا

20
00:02:41,540 --> 00:02:42,710
!هيّا. هذه

21
00:02:42,710 --> 00:02:43,580
ماذا تفعل؟

22
00:02:43,580 --> 00:02:44,540
هل تغشّ؟

23
00:02:44,540 --> 00:02:45,880
!تعال إلى هنا

24
00:02:45,880 --> 00:02:46,540
!لم أفعل

25
00:02:46,540 --> 00:02:47,670
ما الّذي يجري؟

26
00:02:47,670 --> 00:02:48,630
جولة أخرى

27
00:02:49,210 --> 00:02:50,380
!مرّة أخرى فحسب

28
00:02:50,380 --> 00:02:51,170
!كبير من جديد

29
00:02:51,170 --> 00:02:51,750
أيُعقَل هذا؟

30
00:02:51,750 --> 00:02:53,580
كبير

31
00:02:52,170 --> 00:02:52,670
كشف

32
00:02:52,670 --> 00:02:53,130
أنا أيضاً

33
00:02:53,580 --> 00:02:54,920
أراهن على كبير

34
00:02:56,210 --> 00:02:57,380
ما الاحتمال؟

35
00:02:57,380 --> 00:02:58,710
...لنرَ

36
00:02:58,710 --> 00:02:59,420
!صغير

37
00:02:59,420 --> 00:03:00,460
!هيّا

38
00:03:02,380 --> 00:03:03,710
اللّعنة

39
00:03:03,710 --> 00:03:05,290
!الهزيمة الخامسة على التّوالي

40
00:03:05,290 --> 00:03:06,630
معقول؟

41
00:03:07,290 --> 00:03:08,880
!جولة أخرى

42
00:03:12,330 --> 00:03:13,210
أيّتها الصّغيرة

43
00:03:13,540 --> 00:03:14,960
ما إن يُرمَى النّرد ينتهي الأمر

44
00:03:17,630 --> 00:03:19,040
خسرتِ خمس جولات

45
00:03:19,250 --> 00:03:20,920
وأنتِ مَدينة لنا بكثير من المال

46
00:03:31,170 --> 00:03:33,380
هل يمكنكم أخذ الرّاهب والثّعلب كمقابل؟

47
00:03:33,540 --> 00:03:34,710
كلاهما نباتيّان ومُجِدّان في العمل

48
00:03:34,710 --> 00:03:35,540
ويسهل الحِفاظ عليهما

49
00:03:35,790 --> 00:03:36,880
هل يمكنك أخذهما كتعويض؟

50
00:03:37,130 --> 00:03:37,830
!أنتِ

51
00:03:37,830 --> 00:03:39,540
هل تعامليننا كسلعة؟

52
00:03:40,460 --> 00:03:41,830
يؤسفني أن أرفض

53
00:03:42,000 --> 00:03:43,250
لا يُسمَح لكِ بالمغادرة من هنا اليوم

54
00:03:43,460 --> 00:03:45,080
،إن لم تسدّدي ديونكِ

55
00:03:45,420 --> 00:03:47,920
ناهيكِ عن جولة أخرى

56
00:03:50,790 --> 00:03:52,500
لا أملك مالاً أرجوك

57
00:03:52,500 --> 00:03:55,380
هل يمكنك أن تعفو عنّي يا سيّدي؟

58
00:03:58,000 --> 00:03:59,750
رأيتُ كثيراً من المتسوّلين أمثالكِ

59
00:04:00,170 --> 00:04:00,920
كحلٍّ بديل

60
00:04:01,500 --> 00:04:03,790
يمكنكِ العمل لصالحي

61
00:04:04,250 --> 00:04:05,250
انظري

62
00:04:05,670 --> 00:04:07,000
طلب من المطعم الشّهيّ

63
00:04:07,420 --> 00:04:10,210
اغسلي الأطباق لـ 3 أيّام في المطعم
الشّهيّ قرب البحيرة المُشمسة

64
00:04:10,540 --> 00:04:12,460
سأشطب ديونكِ

65
00:04:14,130 --> 00:04:15,290
غسل الأطباق؟

66
00:04:15,290 --> 00:04:16,880
المطعم الشّهيّ؟

67
00:04:17,330 --> 00:04:17,880
تماماً

68
00:04:18,080 --> 00:04:20,960
يبحث المالك لانغ عن مُساعد

69
00:04:22,750 --> 00:04:25,630
!أتريدني أن أغسل الأطباق؟ مستحيل

70
00:04:26,960 --> 00:04:28,040
!إذاً سدِّدي دَينكِ

71
00:04:29,080 --> 00:04:29,580
...في الواقع

72
00:04:36,960 --> 00:04:37,790
لانغ؟

73
00:04:52,880 --> 00:04:54,080
،آنسة تاو ياو

74
00:04:54,420 --> 00:04:55,580
،إذا ظللتِ تراهنين هكذا

75
00:04:55,790 --> 00:04:57,290
ستخسرين نفسكِ عاجلاً أم آجلاً

76
00:04:57,580 --> 00:04:58,960
لا يهمّ كيف يكون شكلكِ

77
00:04:59,170 --> 00:05:01,290
لكن من الفظيع أن تكوني قبيحة
وبعادات سيّئة

78
00:05:06,210 --> 00:05:07,080
...أنت

79
00:05:07,880 --> 00:05:09,000
،كراهب

80
00:05:09,000 --> 00:05:11,380
هل تعتقد أنّه من الملائم

81
00:05:11,540 --> 00:05:12,330
أن تركّز على شكلي؟

82
00:05:12,500 --> 00:05:13,920
وأنا أبدو جميلة

83
00:05:14,080 --> 00:05:16,290
!كنتُ أجمل فتاة في مدينة تاو

84
00:05:16,420 --> 00:05:17,290
هل أنت أعمى؟

85
00:05:17,290 --> 00:05:18,670
هل تحتاج لقطرة عين؟

86
00:05:20,210 --> 00:05:21,830
مدينة الدُّرّاق مليئة بالقبيحات

87
00:05:21,830 --> 00:05:23,130
من الطبيعيّ أن تُعتبَري الأجمل

88
00:05:23,960 --> 00:05:25,460
!كرّر كلامك بصوتٍ عالٍ

89
00:05:25,460 --> 00:05:26,670
لن أفعل

90
00:05:28,250 --> 00:05:29,210
،بالإضافة إلى ذلك

91
00:05:29,420 --> 00:05:31,040
،إذا لم أسافر معك

92
00:05:31,040 --> 00:05:32,880
!فلن أحتاج لبذل جهد من أجل جني المال

93
00:05:33,130 --> 00:05:34,330
،قد نموت من الجوع يوماً ما

94
00:05:34,330 --> 00:05:35,710
إذا اعتمدنا على التسوُّل

95
00:05:37,330 --> 00:05:39,040
أميتافا

96
00:05:39,460 --> 00:05:41,670
هذا استجداء، لا تسوُّل

97
00:05:42,080 --> 00:05:44,080
بالإضافة إلى ذلك، التّرحال هو مهنتي

98
00:05:44,290 --> 00:05:45,330
،إن كنتِ لا ترغبين

99
00:05:45,330 --> 00:05:47,210
فيمكنكِ البقاء مسترخية في مدينة تاو

100
00:05:47,380 --> 00:05:48,790
لا حاجة لتعذيب نفسكِ

101
00:05:50,880 --> 00:05:51,790
أتعلم؟

102
00:05:52,080 --> 00:05:53,290
أكثر ما أندم عليه هو

103
00:05:53,290 --> 00:05:55,580
أنّني أنقذتُك في معبد بوذا الذّهبيّ

104
00:05:55,790 --> 00:05:57,920
ربّيتُك كأمّ لك

105
00:05:57,920 --> 00:05:59,710
لكنّك جاحد تماماً

106
00:06:00,040 --> 00:06:01,080
اِنسَ الأمر

107
00:06:01,330 --> 00:06:03,170
اتّفقتُ مع ليو

108
00:06:03,460 --> 00:06:05,380
،عندما يفعل 100 شيء لي

109
00:06:05,500 --> 00:06:06,830
سأقدّمك له كطعام

110
00:06:07,420 --> 00:06:10,000
حينئذ لن نهدر وقتنا على بعضنا الآخر

111
00:06:10,330 --> 00:06:12,040
،لكن قبل ذلك

112
00:06:12,040 --> 00:06:13,250
أنا مضطرّة للحِفاظ على حياتك

113
00:06:13,710 --> 00:06:15,380
رغم أنّني لا أستمتع

114
00:06:15,380 --> 00:06:16,630
بالسّفر عديم الجدوى

115
00:06:16,790 --> 00:06:18,250
لكن سأستمرّ في صحبتك

116
00:06:18,540 --> 00:06:19,500
،لذا

117
00:06:19,670 --> 00:06:21,380
،إذا تجرّأت على الفُراق عنّي

118
00:06:21,380 --> 00:06:22,830
سأحلق لغونغون

119
00:06:22,830 --> 00:06:24,000
!وأبيعه للجزّار

120
00:06:27,080 --> 00:06:27,830
معها حقّ

121
00:06:27,830 --> 00:06:28,500
،أيُّها الرّاهب الصّغير

122
00:06:28,960 --> 00:06:30,580
،قبل أن آكلك

123
00:06:30,710 --> 00:06:32,500
افعل ما تشاء

124
00:06:32,790 --> 00:06:34,460
لا تتحسّر على شيء

125
00:06:35,330 --> 00:06:36,380
أوّل شيء في قائمة إنجازاتي

126
00:06:36,540 --> 00:06:38,750
هو التخلُّص من خطيئتكِ

127
00:06:39,080 --> 00:06:40,580
أنا مستعدّ حتّى لدخول الجحيم

128
00:06:40,790 --> 00:06:41,670
من أجل ذلك

129
00:06:44,130 --> 00:06:45,460
ليس عليك الذّهاب إلى الجحيم

130
00:06:45,460 --> 00:06:46,380
اصمت وانطلق

131
00:06:50,630 --> 00:06:51,290
...أنتِ

132
00:06:51,500 --> 00:06:53,750
هل أنتِ جادّة بشأن غسل الأطباق
في ذلك المطعم؟

133
00:06:53,920 --> 00:06:56,380
ما زال لديّ شيء آخر أفعله بالتّأكيد

134
00:07:16,210 --> 00:07:17,420
الجنّي الّذي سوف أعالجه

135
00:07:18,040 --> 00:07:19,040
موجود هنا كذلك

136
00:07:23,580 --> 00:07:25,710
عزيزي، إلى أين أنت ذاهب؟

137
00:07:25,710 --> 00:07:26,960
للتمشِّي

138
00:07:26,960 --> 00:07:28,540
أحتاج لتنفُّس بعض الهواء النّقيّ

139
00:07:33,130 --> 00:07:35,250
ظننتُ أنّ الطبيب الشّبح

140
00:07:35,250 --> 00:07:36,630
هو عجوز مثلي

141
00:07:37,500 --> 00:07:39,380
لم أتوقّعكِ أن تكوني بهذا الصِّغَر

142
00:07:41,040 --> 00:07:43,420
ظننتُ أنّ الجنّيين الّذين يلجؤون إليّ
ميؤوس من علاجهم

143
00:07:43,750 --> 00:07:45,290
لم أتوقّعك أن تكون بهذه الصحّة السّليمة

144
00:07:46,460 --> 00:07:47,920
أنا أحتضر

145
00:07:47,920 --> 00:07:48,710
لستَ مريضاً

146
00:07:51,830 --> 00:07:53,830
لستَ بحاجة طبيب، سأغادر

147
00:07:55,380 --> 00:07:56,250
انتظري

148
00:08:05,040 --> 00:08:05,830
!يا إلهي

149
00:08:05,830 --> 00:08:07,080
!يا له من ذئب ضخم

150
00:08:07,920 --> 00:08:09,540
!لا يمكنك المُغادرة دون تقديم تشخيص

151
00:08:11,460 --> 00:08:12,960
كُفّ عن العبث

152
00:08:12,960 --> 00:08:14,000
اهتمّ بشؤونك

153
00:08:14,250 --> 00:08:15,500
قالت الطّبيبة بأنّك لستَ مريضاً

154
00:08:15,500 --> 00:08:16,750
ماذا تتوقّع غير ذلك؟

155
00:08:21,460 --> 00:08:23,540
يا آنسة، سامحيه رجاء

156
00:08:23,540 --> 00:08:24,880
إنّه مختلّ عقليّاً

157
00:08:26,170 --> 00:08:28,460
هلّا سألتُ من تكون هذه الشُّجاعة؟

158
00:08:28,580 --> 00:08:30,290
زوجتي، تشون هوا

159
00:08:31,130 --> 00:08:32,000
،يا سيّدة

160
00:08:32,250 --> 00:08:33,250
...تعلمين أنّ

161
00:08:34,540 --> 00:08:35,790
أعلم بأنّه جنِّي

162
00:08:35,960 --> 00:08:37,670
مستذئب

163
00:08:46,500 --> 00:08:47,170
،يا آنسة

164
00:08:47,170 --> 00:08:48,460
هلّا تناولتُما الطّعام معنا؟

165
00:08:48,580 --> 00:08:49,960
اعتبريه كنوع من الاعتذار

166
00:09:12,210 --> 00:09:13,880
خذا وقتكما في الاستمتاع

167
00:09:13,880 --> 00:09:15,040
لدينا المزيد

168
00:09:16,040 --> 00:09:17,460
قال مالك القمار

169
00:09:17,580 --> 00:09:18,880
بأنّكما تبحثان عن عامل غسل أطباق

170
00:09:19,670 --> 00:09:20,460
أجل

171
00:09:20,670 --> 00:09:21,790
ما أدراك؟

172
00:09:22,380 --> 00:09:23,500
كانت صدفة

173
00:09:23,500 --> 00:09:25,420
وافق مو يا على غسل الأطباق هنا

174
00:09:26,130 --> 00:09:28,210
لا، لم أوافق

175
00:09:30,250 --> 00:09:32,210
السيّد مو يا أصرّ على ذلك

176
00:09:32,710 --> 00:09:33,750
صحيح؟

177
00:09:34,210 --> 00:09:35,790
أجل، سأفعلها

178
00:09:36,750 --> 00:09:38,460
أشكرك على ذلك

179
00:09:38,750 --> 00:09:39,420
انتظر من فضلك

180
00:09:39,420 --> 00:09:40,710
سأحضر لك مئزراً

181
00:09:41,920 --> 00:09:42,710
،سيّدة لانغ

182
00:09:43,000 --> 00:09:44,630
تعلمين أنّ السيّد لانغ جنّي

183
00:09:44,830 --> 00:09:45,580
ألستِ خائفة؟

184
00:09:46,710 --> 00:09:47,790
عشنا معاً لسنوات

185
00:09:47,790 --> 00:09:49,040
لا شيء يدعو للخوف

186
00:09:49,580 --> 00:09:51,380
لكنّه مَرِض

187
00:09:51,380 --> 00:09:53,210
ثمّة شيء في الدّاخل قد أزعجه

188
00:09:53,670 --> 00:09:54,960
،آنسة تاو ياو

189
00:09:54,960 --> 00:09:57,750
هل يمكنكِ مساعدته، من أجل هذه الوجبة؟

190
00:10:04,460 --> 00:10:06,920
أيّها الرّاهب الصّغير، دعني آخذك إلى المطبخ

191
00:10:09,580 --> 00:10:11,750
إنّه ناعم ولذيذ حقّاً

192
00:10:15,420 --> 00:10:17,830
أرزّ ورق الشّجر الّذي تطبخه فريد حقّاً

193
00:10:20,380 --> 00:10:22,330
عندما كنتُ طفلاً، صادفَ أن وجدتُ

194
00:10:22,630 --> 00:10:25,040
أرزّاً ملفوفاً بورق شجر
وكان بمثابة تحلية خاصّة

195
00:10:25,580 --> 00:10:27,960
يمكنك أن تأخذي بعضاً منه

196
00:10:36,420 --> 00:10:38,330
هل تعرف قواعدي عندما أوصف شيئاً؟

197
00:10:40,000 --> 00:10:41,250
ستساعدينني؟

198
00:10:41,540 --> 00:10:43,540
أجل، مقابل هذه الوجبة

199
00:10:44,080 --> 00:10:45,330
،لكن إذا عالجتُك

200
00:10:45,580 --> 00:10:47,630
ستكون دوائي في المستقبل

201
00:10:48,330 --> 00:10:49,420
حسناً

202
00:10:49,920 --> 00:10:52,330
...لكن أنا عجوز

203
00:10:52,330 --> 00:10:53,580
تبقى القواعد قواعد

204
00:10:54,130 --> 00:10:54,880
أخبرني الآن

205
00:10:55,080 --> 00:10:56,000
عن مرضك

206
00:11:01,580 --> 00:11:02,960
،آنسة تاو ياو

207
00:11:03,580 --> 00:11:06,880
هل سبقَ وواجهتِ وقتاً صعباً جدّاً؟

208
00:11:09,630 --> 00:11:12,670
أمطرتْ بغزارة في ذلك العام

209
00:11:13,250 --> 00:11:15,130
لم يكن هناك أي طعام في الغابة

210
00:11:16,130 --> 00:11:19,330
نحن المستذئبون كان علينا الانتقال
إلى أماكن أخرى

211
00:11:21,130 --> 00:11:22,710
إنّها رحلة طويلة

212
00:11:22,960 --> 00:11:24,170
،إنّه أعرج

213
00:11:24,500 --> 00:11:25,500
،سيموت عاجلاً أم آجلاً

214
00:11:26,210 --> 00:11:28,330
دعه لمصيره فحسب

215
00:11:28,500 --> 00:11:29,540
...لكن

216
00:11:29,540 --> 00:11:30,330
هيّا بنا

217
00:11:30,750 --> 00:11:32,080
البقاء للأقوى فقط

218
00:11:32,380 --> 00:11:33,710
هذا قدره

219
00:11:43,830 --> 00:11:45,250
عائلتي تخلَّتْ عنّي

220
00:11:46,290 --> 00:11:48,040
دون أن تفكِّر في حياتي

221
00:12:27,290 --> 00:12:28,500
لكن أريد أن أعيش

222
00:12:29,460 --> 00:12:30,380
لا أريد أن أموت

223
00:12:31,710 --> 00:12:32,580
من أجل البقاء

224
00:12:33,170 --> 00:12:34,500
يجب أن أوفّر قوت يومي

225
00:12:52,040 --> 00:12:53,080
،أيُّها الصّغير

226
00:12:53,380 --> 00:12:54,880
نحتاج شخصاً حِرفيّاً هنا

227
00:12:56,830 --> 00:12:58,000
هل تريد المحاولة؟

228
00:12:59,000 --> 00:12:59,670
!أجل

229
00:13:17,330 --> 00:13:18,290
...لكن

230
00:13:18,790 --> 00:13:20,040
العالم البشريّ مُعقَّد

231
00:13:21,000 --> 00:13:23,460
لا أعرف ما يكفي عنه

232
00:13:26,630 --> 00:13:28,130
!كيف تجرؤ على السّرقة منّي؟ انقلع

233
00:13:28,630 --> 00:13:30,420
!أيّها الأعرج الفاشل! وتريد أجرك أيضاً؟

234
00:13:30,420 --> 00:13:32,080
!اغرب عن وجهي حالاً

235
00:13:33,080 --> 00:13:35,250
...أنا

236
00:13:34,000 --> 00:13:34,830
...لم أسرق

237
00:13:35,250 --> 00:13:35,880
!يا إلهي

238
00:13:36,290 --> 00:13:37,880
!كم هو بخيل

239
00:13:38,210 --> 00:13:39,750
!لا يدفع لحِرفيّ

240
00:13:40,250 --> 00:13:42,330
كم مسكيناً قد خدع؟

241
00:13:44,880 --> 00:13:45,830
هو المُلام على ذلك

242
00:13:46,170 --> 00:13:47,750
ما كان ليعمل لصالح ليو إذا كان مقتدراً بما يكفي

243
00:13:48,380 --> 00:13:49,710
معك حقّ

244
00:13:53,790 --> 00:13:54,960
توفير قوت اليوم

245
00:13:55,670 --> 00:13:56,750
صعب حقّاً

246
00:14:07,830 --> 00:14:08,670
أيّها الشّابّ

247
00:14:08,830 --> 00:14:10,080
أنت عاجز

248
00:14:10,420 --> 00:14:11,500
حصلنا على بديل

249
00:14:11,710 --> 00:14:12,380
والآن غادر

250
00:14:34,500 --> 00:14:35,250
!انقلع

251
00:14:41,210 --> 00:14:42,920
منذ متى

252
00:14:43,880 --> 00:14:45,330
لم أتمكّن من الحصول

253
00:14:46,080 --> 00:14:47,250
على عمل بسيط؟

254
00:15:22,170 --> 00:15:23,500
وضعتُ المال هنا

255
00:15:23,670 --> 00:15:24,420
حسناً

256
00:15:26,290 --> 00:15:27,290
!اللّعنة عليك

257
00:15:27,580 --> 00:15:29,170
أعرج لعين! كيف تجرؤ على السّرقة؟

258
00:15:29,380 --> 00:15:30,210
!اذهب إلى الجحيم

259
00:15:34,500 --> 00:15:36,380
،شابّ بهذا العمر

260
00:15:37,000 --> 00:15:38,540
يستطيع الحصول على دجاج مشويّ

261
00:15:38,540 --> 00:15:40,080
إذا حَظي بعمل جيّد

262
00:15:41,920 --> 00:15:42,750
هيّا بنا

263
00:15:49,000 --> 00:15:50,790
ربّما كانت عائلتي على حقّ

264
00:15:53,500 --> 00:15:55,460
الموت هو قدري

265
00:16:20,920 --> 00:16:22,330
لقد سئمت

266
00:16:23,920 --> 00:16:28,170
هذه هي. انتهى الأمر

267
00:16:32,710 --> 00:16:33,330
أنت

268
00:16:33,670 --> 00:16:35,790
اذهب إلى مكان آخر لإنهاء حياتك

269
00:16:35,920 --> 00:16:37,830
اصطدمت بي وآلمني ذلك

270
00:16:50,920 --> 00:16:58,540
♪ هناك مئات الوحوش ♪

271
00:16:59,290 --> 00:17:06,380
♪ الجميع يستطيعون التّمييز بين الخير والشرّ ♪

272
00:17:07,420 --> 00:17:15,380
♪ ليس للبشر إلّا قلب واحد ♪

273
00:17:15,790 --> 00:17:24,420
♪ لكنّه غير مُتوقَّع ♪