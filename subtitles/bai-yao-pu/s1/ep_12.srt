،بعد أن اتّخذتُ قراري

219
00:13:09,360 --> 00:13:10,570
نمتُ

220
00:13:11,320 --> 00:13:12,690
،في الصّباح التّالي

221
00:13:12,860 --> 00:13:15,690
أضفتُ الأمَّ السّامّة إلى عصيدته

222
00:13:16,320 --> 00:13:18,070
أكلها وقال لي

223
00:13:18,440 --> 00:13:20,440
بأنّه وجد اسماً متجري

224
00:13:21,320 --> 00:13:23,900
ثمّ بقي

225
00:13:24,940 --> 00:13:26,650
الأمّ السّامّة مختلفة عن السّمّ الفرعيّ

226
00:13:27,070 --> 00:13:29,860
المُضيف لن يموت من لدغ القلب

227
00:13:30,610 --> 00:13:32,980
لن يتركني أبداً

228
00:13:33,440 --> 00:13:35,820
حتّى الممات

229
00:13:36,980 --> 00:13:41,110
لكنّها الحسرة الكبرى في حياتي

230
00:13:41,650 --> 00:13:44,900
كلّما مضى الوقت، ازداد شعوري بالذّنب

231
00:13:45,900 --> 00:13:47,270
أبذل قصارى جهدي لقتل السّموم

232
00:13:47,650 --> 00:13:50,900
وذلك حتّى لا أحظى بوقت للتّفكير في ذلك

233
00:13:52,190 --> 00:13:54,230
هذا ما يؤرقكِ

234
00:13:58,110 --> 00:13:59,900
شكراً لكِ يا آنسة تاوزي

235
00:14:00,570 --> 00:14:03,400
أشعر براحة أكبر الآن

236
00:14:09,360 --> 00:14:10,270
،سيّدة زانغ

237
00:14:13,270 --> 00:14:14,480
هل تعتقدين حقّاً بأنّ

238
00:14:14,940 --> 00:14:17,150
الأمّ السّامة تستطيع جعل شخص
يريد المغادرة

239
00:14:17,610 --> 00:14:19,360
يبقى معكِ لسنوات طِوال؟

240
00:14:35,570 --> 00:14:36,610
أين السيّدة زانغ؟

241
00:14:37,270 --> 00:14:39,610
إنّها تشعر بوعكة وترتاح في المنزل

242
00:14:40,020 --> 00:14:43,110
.سُمّ الإضافة يخشى الضّوء
لا تفتحيه إلّا بعد ثلاثة أيّام

243
00:14:43,440 --> 00:14:44,320
هكذا إذاً

244
00:14:44,520 --> 00:14:46,900
استخدم ورقة الطّبيب قبل
أن تساور شينغ جي الشّكوك

245
00:14:48,400 --> 00:14:49,480
بالتّوفيق

246
00:14:50,610 --> 00:14:51,900
ألن تعود إلى كونلون حقّاً؟

247
00:14:52,610 --> 00:14:55,570
ثمّة مريضة تنتظرك

248
00:14:56,480 --> 00:14:57,440
كيف عرفتِ ذلك؟

249
00:14:58,480 --> 00:15:00,190
ماذا قالَتْ لكِ؟

250
00:15:00,190 --> 00:15:02,570
إنّه ماضيك فحسب

251
00:15:03,190 --> 00:15:05,520
كنتَ على وشك الذّهاب، ثمّ قرّرتَ البقاء

252
00:15:05,940 --> 00:15:07,900
تحاول كسب الوقت فحسب

253
00:15:15,440 --> 00:15:17,730
فكّرتُ في الأمر طوال اللّيل

254
00:15:18,360 --> 00:15:20,320
ومع ذلك لم أستطع تركها لوحدها

255
00:15:35,070 --> 00:15:37,900
يوم في كونلون يساوي عشر سنوات في عالم البشر

256
00:15:38,360 --> 00:15:41,570
بالنّسبة لشينغ جي، سأتأخّر بضعة أيّام فحسب

257
00:15:42,020 --> 00:15:44,900
لكن بالنّسبة لها، إنّه عمر طويل

258
00:15:45,320 --> 00:15:46,900
عليّ فقط البحث عن عذر جيّد

259
00:15:46,900 --> 00:15:48,730
للتأخُّر

260
00:15:49,400 --> 00:15:51,820
لنساعد بعضنا الآخر

261
00:15:52,020 --> 00:15:54,520
رغبة شينغ جي هي ألّا يكون
هناك سموم في عالم البشر

262
00:15:54,730 --> 00:15:56,690
النّتيجة الجيّدة كافية

263
00:15:57,190 --> 00:15:59,650
فضلاً عن ذلك، فكّرتُ في طُرُق أخرى

264
00:16:00,150 --> 00:16:03,270
إذاً لا حاجة لأخبرك عن مكان الأمّ السّامّة

265
00:16:04,110 --> 00:16:04,820
ماذا؟

266
00:16:15,900 --> 00:16:17,650
،استخدام ورقة الطّبيب هذه من عدمه

267
00:16:18,070 --> 00:16:19,820
عائد لك

268
00:16:25,770 --> 00:16:26,730
!وداعاً

269
00:16:36,690 --> 00:16:38,770
السيّد زانغ سيقتلها

270
00:16:38,770 --> 00:16:40,070
!إذا استخدمَتِ السُّمّ

271
00:16:40,570 --> 00:16:42,480
لماذا قلتِ الحقيقة للسيّد زانغ؟

272
00:16:42,730 --> 00:16:44,650
!تحاولين قتلهما معاً

273
00:16:50,900 --> 00:16:52,150
قتل عصفورين بحجر واحد

274
00:16:52,650 --> 00:16:53,690
أنتِ أقسى منّي

275
00:16:54,980 --> 00:16:56,190
لديه حقّ في أن يعلم

276
00:17:27,520 --> 00:17:28,820
إلى أين أنتِ ذاهبة؟

277
00:17:39,270 --> 00:17:40,360
ماذا تفعل؟

278
00:17:40,360 --> 00:17:41,570
!هذه ليست مزحة

279
00:17:41,860 --> 00:17:43,400
السيّدة زانغ تحبّ السيّد زانغ حبّاً جمّاً

280
00:17:43,400 --> 00:17:45,070
لن تكون الأمّ السّامّة مُضرّة للسيّد زانغ

281
00:17:45,270 --> 00:17:46,770
كان من اللّطف الاحتفاظ بالسّرّ؟

282
00:17:47,360 --> 00:17:49,360
هل تعلم لماذا لا يمكن القضاء على السّمّ؟

283
00:17:50,820 --> 00:17:51,690
لماذا؟

284
00:17:52,150 --> 00:17:54,730
لأنّ النّاس يخشون رؤية أشياء لا يريدون رؤيتها

285
00:17:55,480 --> 00:17:58,360
ستشعر بتأنيب الضّمير طوال الوقت
إذا لم نقل الحقيقة

286
00:17:58,980 --> 00:18:02,020
!كفى! تريدين أن تتسلّي فحسب

287
00:18:02,480 --> 00:18:04,900
!السيّدة زانغ سوف تُقتَل. لنعُد وننقذها

288
00:18:05,320 --> 00:18:07,570
هل سيقتل السيّدة زانغ حقّاً؟

289
00:18:08,020 --> 00:18:09,570
!المخلوقات الخرافيّة لا تكذب

290
00:18:10,150 --> 00:18:12,150
،بما أنّ تينغ غين يتغذّى على السّموم

291
00:18:12,570 --> 00:18:14,650
فإنّ الأمّ السّامّة لا تؤثّر عليه إطلاقاً

292
00:18:16,730 --> 00:18:17,400
أجل

293
00:18:18,730 --> 00:18:20,690
...إذاً السيّد زانغ سوف

294
00:18:32,570 --> 00:18:33,980
سمعتُ

295
00:18:34,190 --> 00:18:35,730
أنّه يوجد سُمّ في أماكن أخرى

296
00:18:35,820 --> 00:18:37,150
سأضطرّ لإلقاء نظرة

297
00:18:37,730 --> 00:18:38,610
سأذهب معكِ

298
00:18:39,270 --> 00:18:39,650
...أنا

299
00:18:40,400 --> 00:18:41,690
أستطيع الذّهاب بمفردي

300
00:18:42,070 --> 00:18:43,400
ابقَ هنا واهتمّ بعملنا

301
00:18:43,940 --> 00:18:45,770
حينها لن تعودي أبداً

302
00:18:46,190 --> 00:18:46,860
!مستحيل

303
00:18:51,110 --> 00:18:52,770
...هذا فقط لأنّك

304
00:18:53,020 --> 00:18:54,570
زرعتِ السُّمَ بي

305
00:18:56,900 --> 00:18:58,820
أخبرَتْك الآنسة تاوزي بالفعل

306
00:19:00,770 --> 00:19:04,150
يا للسخرية. أعتقد بأنّني مختلفة عن قبيلتي

307
00:19:04,570 --> 00:19:06,860
وأطالب بزوال السُّموم في العالم

308
00:19:06,980 --> 00:19:07,900
...لكن في نهاية المطاف

309
00:19:08,480 --> 00:19:10,570
لا فرق بيني وبينهن

310
00:19:11,650 --> 00:19:14,730
إليك الحقيقة. ليس عليك اللّحاق بي بعد الآن

311
00:19:16,150 --> 00:19:17,650
لم تستطيعي التخلّص منّي في المرّة السّابقة

312
00:19:17,730 --> 00:19:18,860
ولا في هذه المرّة

313
00:19:19,150 --> 00:19:22,270
!الأمّ السّامّة هي ما جعلَتْك تعتقد ذلك

314
00:19:24,400 --> 00:19:26,020
أنتِ ساحرة سامّة

315
00:19:26,520 --> 00:19:28,150
أنتِ مرتبطة بالسّمّ الّذي زرعتِه

316
00:19:29,690 --> 00:19:30,610
يمكنكِ أن تجرّبي الآن

317
00:19:31,270 --> 00:19:32,480
هل يمكنكِ الشّعور به؟

318
00:19:42,690 --> 00:19:43,860
ما الّذي يجري؟

319
00:19:44,190 --> 00:19:46,440
الأمّ السّامّة لم تستجب إطلاقاً

320
00:19:47,320 --> 00:19:48,440
،لأسباب فسيولوجيّة

321
00:19:48,770 --> 00:19:50,440
لا تؤثّر السّموم بي

322
00:19:52,770 --> 00:19:53,860
ألا تفهمين؟

323
00:19:54,650 --> 00:19:57,730
لا يستطيع السّمّ التحكّم بعقل النّاس

324
00:20:06,570 --> 00:20:08,650
آسف. لديّ أسبابي الخاصّة

325
00:20:09,190 --> 00:20:10,440
أخفي عنكِ أمورَ كثيرة

326
00:20:11,150 --> 00:20:12,900
لكن هذا أكثر قرار جادّ لي

327
00:20:13,110 --> 00:20:14,860
للبقاء معكِ

328
00:20:41,480 --> 00:20:43,860
ماذا يجدر بنا أن نفعل؟ تاو ياو فقدت صوابها

329
00:20:44,980 --> 00:20:46,440
لا جدوى. مهما تفقّدتِه من مرّات

330
00:20:46,730 --> 00:20:47,900
،لا يوجد سُمّ الإضافة في الصّندوق

331
00:20:48,440 --> 00:20:50,480
فقط ورقة لكِ من تينغ غين

332
00:20:55,570 --> 00:20:57,820
هذه غلطتك! قال لك تينغ غين
بأنّ سُمّ الإضافة يكره الضّوء

333
00:20:57,820 --> 00:20:59,150
!لا تفتحه إلّا بعد ثلاثة أيّام

334
00:20:59,360 --> 00:21:01,020
قتلت سُمّ الإضافة الخاصّ بي

335
00:21:05,360 --> 00:21:07,360
انهضي واقرئي الورقة ثانية

336
00:21:07,730 --> 00:21:09,190
أي ورقة؟ لا أستطيع رؤيتها

337
00:21:20,360 --> 00:21:21,900
لا مكسب بلا ألم

338
00:21:21,980 --> 00:21:23,520
لا يوجد غداء مجّاني في الحياة

339
00:21:23,940 --> 00:21:26,150
انهضي وواجهي الحقائق

340
00:21:26,650 --> 00:21:28,690
ما الّذي يأكله تينغ غين؟

341
00:21:29,150 --> 00:21:31,360
يتغذّى على السّموم. لن يترك لكِ شيئاً

342
00:21:32,570 --> 00:21:34,190
!زانغ، أنت كاذب

343
00:21:34,480 --> 00:21:36,230
!انتظر وسترى

344
00:21:36,610 --> 00:21:37,690
!ليو، ساعدني

345
00:21:38,110 --> 00:21:39,980
لا أستطيع تثبيتها

346
00:21:42,940 --> 00:21:44,570
العربة قادمة. دعها تركبها

347
00:21:56,320 --> 00:21:58,440
!زانغ! اللّعنة عليك

348
00:21:58,980 --> 00:22:00,770
لم ينتهِ الأمر

349
00:22:06,770 --> 00:22:08,570
يستحقّون ذلك

350
00:22:09,480 --> 00:22:10,980
ثمن الخطيئة هو الموت

351
00:22:12,820 --> 00:22:14,480
هل تلك الآنسة زين ذات الوجه المحترق؟

352
00:22:15,860 --> 00:22:17,730
!غادرَتْ منزلها من دون سِتار

353
00:22:18,320 --> 00:22:20,820
يا آنسة، من الأفضل أن تضعي ستاركِ

354
00:22:21,570 --> 00:22:22,940
لا مشكلة

355
00:22:29,440 --> 00:22:31,770
سمعتُ بأنّ خطيبها السّابق كان في ورطة

356
00:22:31,900 --> 00:22:33,770
وأراد العودة مع الآنسة زين مقابل المال

357
00:22:33,900 --> 00:22:34,650
لكنّها رفضَتْ

358
00:22:35,110 --> 00:22:35,770
!عمل ممتاز

359
00:22:36,020 --> 00:22:36,900
الحياة طريق طويل

360
00:22:37,070 --> 00:22:37,940
ستلتقين بالشّخص المناسب

361
00:22:38,020 --> 00:22:38,900
أجل

362
00:22:39,070 --> 00:22:41,110
أعتقد بأنّ زانغ شخص جيّد

363
00:22:53,400 --> 00:22:55,690
هل سنفعل هذا حقّاً؟

364
00:22:55,900 --> 00:22:56,730
هل سيأتي أحد؟

365
00:22:57,360 --> 00:22:58,980
كانت الآنسة زين هنا للتو

366
00:22:59,270 --> 00:23:00,770
سيأتي المزيد

367
00:23:01,270 --> 00:23:03,900
يلجأ النّاس للسُّمّ طلباً للمساعدة
لأنّهم يخشون مواجهة أنفسهم

368
00:23:04,360 --> 00:23:06,980
كلّ ما علينا فعله هو مدّهم بالشّجاعة

369
00:23:11,230 --> 00:23:12,900
كيف سنقتل كلّ السُّموم في العالم؟

370
00:23:13,270 --> 00:23:15,190
هذه هي الطريقة الّتي ابتكرتُها

371
00:23:18,110 --> 00:23:20,270
فضلاً عن ذلك، مدينة وتشينغ عظيمة

372
00:23:20,520 --> 00:23:22,070
كنّا هائمين مُعظم عمرنا

373
00:23:22,400 --> 00:23:23,820
ما رأيكِ أن نستقرّ هنا؟

374
00:23:26,440 --> 00:23:28,360
بالمناسبة، لم تخبرني بعد

375
00:23:28,480 --> 00:23:29,650
ما هي الأسباب الفسيولوجيّة؟

376
00:23:30,020 --> 00:23:31,440
لماذا لا تؤثّر بك السُّموم؟

377
00:23:32,480 --> 00:23:33,270
...في الواقع

378
00:23:33,860 --> 00:23:35,520
لم أغسل الصُّحون بعد

379
00:23:35,520 --> 00:23:36,820
سأخبركِ لاحقاً

380
00:23:37,270 --> 00:23:38,770
هذا ما قلتَه في الأمس

381
00:23:39,820 --> 00:23:40,820
!انتظر

382
00:23:52,230 --> 00:23:53,230
لان هويغو"؟"

383
00:23:54,110 --> 00:23:55,320
إذا أنجزنا الأمور

384
00:23:55,730 --> 00:23:56,520
،وافتتحنا متجراً

385
00:23:56,900 --> 00:23:57,730
فسيكون هذا هو اسم المتجر

386
00:23:58,480 --> 00:23:59,770
لماذا؟

387
00:24:01,110 --> 00:24:02,360
...في الواقع

388
00:24:07,980 --> 00:24:10,110
"لا ماء يكفي عندما تعبر البحر"

389
00:24:10,650 --> 00:24:12,520
"لا غيمة جميلة سوى تلك الّتي تُتوّج القمّة"

390
00:24:12,940 --> 00:24:14,860
أمرُّ من جانب الزُّهور الّتي تفشل"
"في جذبي أنا المسكين

391
00:24:15,320 --> 00:24:18,110
"نصف لأجلك ونصف للطاويّة"

392
00:24:19,440 --> 00:24:21,690
!يا لها من قصيدة رائعة

393
00:24:23,270 --> 00:24:26,230
!كم هذا مُثير للشّفقة

394
00:24:27,820 --> 00:24:29,270
يمكنكِ مُجادلتي الآن

395
00:24:29,480 --> 00:24:30,820
هل أنتِ بخير؟

396
00:24:31,400 --> 00:24:33,230
على أيّ حال، أعرف سرَّه

397
00:24:33,480 --> 00:24:35,320
سوف أذهب إليه

398
00:24:35,610 --> 00:24:37,440
عندما أنتهي من المرضى الّذين ينتظرون

399
00:24:38,320 --> 00:24:39,820
كنتِ كسولة

400
00:24:40,070 --> 00:24:41,820
لكن مجتهدة جدّاً في هذه الأيّام

401
00:24:42,520 --> 00:24:44,270
هل تخفين عنّي شيئاً؟

402
00:24:45,770 --> 00:24:47,730
لا شيء

403
00:24:48,360 --> 00:24:49,360
،أخبريني بالحقيقة فحسب

404
00:24:49,730 --> 00:24:51,230
لماذا غادرتِ مدينة تاو؟

405
00:24:51,690 --> 00:24:55,320
كان ذلك اليوم عاصفاً وغائماً

406
00:24:55,320 --> 00:24:56,440
،إن لم تقولي الحقيقة

407
00:24:56,650 --> 00:24:58,520
فسوف أخبره

408
00:25:05,570 --> 00:25:08,190
لا تغضب

409
00:25:08,440 --> 00:25:09,570
إذا أخبرتُك

410
00:25:10,320 --> 00:25:11,070
تفضّلي

411
00:25:12,980 --> 00:25:14,110
مُذكّرات الجنّيات

412
00:25:14,730 --> 00:25:15,730
هل فيها مشكلة ما؟

413
00:25:18,320 --> 00:25:19,320
أجل

414
00:25:20,020 --> 00:25:21,020
ماذا فعلتِ؟

415
00:25:21,020 --> 00:25:22,690
هل غيّرتِ أي اسم فيه؟

416
00:25:24,820 --> 00:25:26,730
الأمر أخطر من ذلك

417
00:25:27,900 --> 00:25:31,360
ماذا إذاً؟ مسحتِ اسم عائلة شخص

418
00:25:35,230 --> 00:25:37,360
!مذكّرات الجنّيات هو شريان الحياة بالنّسبة لنا

419
00:25:37,650 --> 00:25:38,650
،أي اسم تمحينه

420
00:25:38,770 --> 00:25:40,730
!فسيختفي جنسه بالكامل

421
00:25:41,940 --> 00:25:42,480
...الأمر

422
00:25:42,900 --> 00:25:45,190
الأمر أخطر من ذلك

423
00:25:47,190 --> 00:25:48,270
ماذا فعلتِ بالضّبط؟

424
00:25:48,730 --> 00:25:51,020
!جنسي في المذكّرات أيضاً

425
00:25:52,860 --> 00:25:55,150
أضعتُ مذكّرات الجنّيات

426
00:25:57,270 --> 00:25:58,770
أضعتِ مذكّرات الجنّيات

427
00:25:59,110 --> 00:26:01,480
ظننتُ أنّ الأمر أخطر من ذلك

428
00:26:02,650 --> 00:26:03,610
عمّاذا تتكلّمين؟

429
00:26:04,400 --> 00:26:06,400
أضعتُ مذكّرات الجنّيات

430
00:26:17,190 --> 00:26:18,610
ماذا أستطيع أن أفعل؟

431
00:26:18,900 --> 00:26:20,860
ذهبتُ للمراهنة قبل مهرجان الرّبيع

432
00:26:21,230 --> 00:26:22,650
كان قد اختفى عندما عدتُ

433
00:26:23,400 --> 00:26:25,230
خرجتُ بحثاً عنه

434
00:26:25,360 --> 00:26:27,440
من شو إلى بيانجينغ

435
00:26:27,610 --> 00:26:29,900
!يوجد جنّيون كُثُر هناك. لا بدّ من وجود طرف خيط

436
00:26:34,650 --> 00:26:36,230
هل يعلم حتّى؟

437
00:26:36,650 --> 00:26:39,570
سأموت إذا عَلِمَ بذلك

438
00:26:40,770 --> 00:26:42,570
عمّاذا تتكلّمان؟

439
00:26:43,770 --> 00:26:45,440
من سيموت؟

440
00:26:46,020 --> 00:26:47,520
!هذا ليس من شأنك

441
00:26:47,730 --> 00:26:49,020
هل أنهيت تمرينك؟

442
00:26:49,020 --> 00:26:50,230
هل أنهيت المانترا خاصّتك ووجبتك؟

443
00:26:51,150 --> 00:26:54,190
تاو ياو، أنتِ تهتمّين لأمري كثيراً

444
00:26:54,570 --> 00:26:57,900
ظننتُكِ لن تتكلّمي معي بعد الآن

445
00:26:58,940 --> 00:27:00,230
يجدر بك أن تكون ممتنّاً

446
00:27:00,650 --> 00:27:03,150
سدِّد ديوني

447
00:27:03,400 --> 00:27:06,110
واحمِني. مفهوم؟

448
00:27:06,320 --> 00:27:07,900
!دعني وشأني فحسب

449
00:27:08,770 --> 00:27:10,070
!اصمت

450
00:27:14,960 --> 00:27:19,080
مذكّرات الجنّيات الموسم 1

451
00:27:34,610 --> 00:27:36,570
♪ غير راغب في سماع الآخرين ♪

452
00:27:36,730 --> 00:27:41,860
♪ تهبُّ الرّياح. نمشي في الثّلج معاً ♪

453
00:27:42,020 --> 00:27:44,190
♪ الخير سيتفتّح ♪

454
00:27:44,400 --> 00:27:48,400
♪ اِنسَ الألم ♪

455
00:27:49,480 --> 00:27:51,650
♪ ألقِ اللّوم على الجرس ♪

456
00:27:51,900 --> 00:27:56,860
♪ لم يستطع إيقاظ الرُّوح المُبهمة ♪

457
00:27:56,980 --> 00:27:59,150
♪ انتظر حتّى الفجر ♪

458
00:27:59,360 --> 00:28:04,230
♪ أسود وأبيض صافيان ♪

459
00:28:04,480 --> 00:28:09,150
♪ الآلهة عُميٌ عندما يتعلّق الأمر بالمواجهة بين العدل والشرّ♪

460
00:28:09,320 --> 00:28:11,770
♪ اِنسَ الحزن والبهجة ♪

461
00:28:12,070 --> 00:28:16,610
♪ البيادق في اللّعبة تربط ما بين الصّواب والخطأ ♪

462
00:28:16,730 --> 00:28:21,110
♪ من سيكسر الطّريق المسدود ♪

463
00:28:21,270 --> 00:28:27,900
♪ من الصّعب معالجة العقل، على الأقلّ هناك قلب ♪

464
00:28:28,860 --> 00:28:36,020
♪ التّرنيمة مفقودة في عزاء كسب السّلام ♪

465
00:28:36,400 --> 00:28:43,570
♪ أتحمّل فترة عاصفة مقابل السّكينة لحياتي ♪

466
00:28:43,940 --> 00:28:51,110
♪ بدعمك، لن تتغيّر إرادتي أبداً ♪

467
00:28:51,440 --> 00:28:58,650
♪ الحكيمون يرفضون العلاج دوماً ♪

468
00:28:58,980 --> 00:29:06,110
♪ قليل من الإحساس سيقضي على الشّيطان في داخلك ♪

469
00:29:06,440 --> 00:29:15,150
♪ تحمّل فترة عاصفة مقابل سَكينة حياتي ♪

470
00:29:17,610 --> 00:29:27,610
♪ بدعمك، لن تتغيّر إرادتي أبداً ♪