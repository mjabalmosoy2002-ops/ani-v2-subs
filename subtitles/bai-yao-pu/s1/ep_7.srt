1
00:00:01,580 --> 00:00:03,420
♪ غير راغب في سماع الآخرين ♪

2
00:00:03,960 --> 00:00:09,000
♪ تهبُّ الرّياح. نمشي في الثّلج معاً ♪

3
00:00:09,250 --> 00:00:11,040
♪ الخير سيتفتّح ♪

4
00:00:11,500 --> 00:00:15,080
♪ اِنسَ الألم ♪

5
00:00:16,920 --> 00:00:18,880
♪ ألقِ اللّوم على الجرس ♪

6
00:00:19,250 --> 00:00:24,420
♪ لم يستطع إيقاظ الرُّوح المُبهمة ♪

7
00:00:24,580 --> 00:00:26,630
♪ انتظر حتّى الفجر ♪

8
00:00:27,000 --> 00:00:31,380
♪ أسود وأبيض صافيان ♪

9
00:00:32,290 --> 00:00:37,040
♪ الآلهة عُميٌ عندما يتعلّق الأمر بالمواجهة بين العدل والشرّ♪

10
00:00:37,040 --> 00:00:39,540
♪ اِنسَ الحزن والبهجة ♪

11
00:00:39,540 --> 00:00:44,670
♪ البيادق في اللّعبة تربط ما بين الصّواب والخطأ ♪

12
00:00:44,670 --> 00:00:48,420
♪ من سيكسر الطّريق المسدود ♪

13
00:00:49,630 --> 00:00:55,920
♪ من الصّعب معالجة العقل، على الأقلّ هناك قلب ♪

14
00:00:57,210 --> 00:01:04,420
♪ التّرنيمة مفقودة في عزاء كسب السّلام ♪

15
00:01:04,880 --> 00:01:13,540
♪ أتحمّل فترة عاصفة مقابل السّكينة لحياتي ♪

16
00:01:16,380 --> 00:01:25,580
♪ بدعمك، لن تتغيّر إرادتي أبداً ♪

17
00:01:23,130 --> 00:01:27,000
مذكّرات الجنّيات الموسم 1

18
00:01:43,580 --> 00:01:46,880
يا آنسة

19
00:01:54,500 --> 00:01:57,290
يا آنسة

20
00:01:57,460 --> 00:01:58,500
الأسماك ليست للبيع

21
00:01:59,080 --> 00:01:59,500
ماذا؟

22
00:01:59,790 --> 00:02:00,830
!أيّها الطّفل الشّقيّ

23
00:02:00,830 --> 00:02:02,290
لِمَ لا تراعي مشاعر الآخرين؟

24
00:02:02,790 --> 00:02:04,250
أتينا من مكان بعيد إلى مدينة ليزو

25
00:02:04,330 --> 00:02:06,250
كلّ ما نريده هو تذوّق السّمك في مستنقع جينغا

26
00:02:11,000 --> 00:02:13,130
"اسمي وانغ شاونيو، لستُ "الطّفل الشّقيّ

27
00:02:13,130 --> 00:02:15,000
والأسماك ليست من مستنقع جينغا

28
00:02:15,000 --> 00:02:16,040
حصلتُ عليها من نهر

29
00:02:16,460 --> 00:02:18,080
السيّد مياو قادم لأجلها قريباً

30
00:02:18,750 --> 00:02:19,880
السيّد مياو؟

31
00:02:27,080 --> 00:02:28,210
أعلم بوضوح أنّ

32
00:02:28,630 --> 00:02:31,670
مستنقع جينغا مشهور بزهور
الدُّرّاق وسمك الدّوع الأحمر

33
00:02:31,920 --> 00:02:33,670
إنَّ أكل السّمك في المعرض اللّيليّ
والتمتّع بزهور الدُّرّاق

34
00:02:33,880 --> 00:02:35,710
سيكون مُمتعاً للغاية

35
00:02:35,710 --> 00:02:36,580
!توقّفي

36
00:02:38,880 --> 00:02:41,790
آنسة تاو ياو، أحسني السُّلوك رجاء

37
00:02:41,790 --> 00:02:43,710
يعتني الربُّ بكلّ الكائنات الحيّة

38
00:02:43,710 --> 00:02:45,040
يجدر بنا تجنُّب أكل اللّحم والسّمك

39
00:02:45,040 --> 00:02:45,670
!كفّ عن ذلك

40
00:02:45,880 --> 00:02:48,040
أنت وغونغون كلاكما تشتهيان السّمك

41
00:02:48,040 --> 00:02:49,710
والآن تذرف دموع التّماسيح؟

42
00:02:55,170 --> 00:02:56,330
،إذا كنتم جائعين

43
00:02:56,330 --> 00:02:58,170
فسأشارك معكم بعض كعك الأرزّ

44
00:02:59,540 --> 00:03:01,500
شاونيو -

45
00:02:59,540 --> 00:03:01,500
أميتافا -

46
00:03:04,250 --> 00:03:05,920
أعتقد بأنّكِ لا تعرفين

47
00:03:06,210 --> 00:03:08,080
لا توجد أسماك في مستنقع جينغا إطلاقاً

48
00:03:08,540 --> 00:03:10,460
معرض زهور الدُّرّاق اللّيل مُغلَق

49
00:03:10,750 --> 00:03:12,210
،كلّ ما لدينا هو السّبخة

50
00:03:12,500 --> 00:03:13,500
مجرّد خراب

51
00:03:15,080 --> 00:03:16,630
ماذا؟ أتمزح معي؟

52
00:03:17,040 --> 00:03:18,130
لا، أنا لا أمزح

53
00:03:18,290 --> 00:03:18,920
...أيّها الصّغـ

54
00:03:18,920 --> 00:03:19,460
ماذا؟

55
00:03:22,630 --> 00:03:23,880
شاونيو

56
00:03:24,080 --> 00:03:26,170
هلّا أخبرتني

57
00:03:26,420 --> 00:03:27,630
كيف أستطيع الوصول إلى مستنقع جينغا؟

58
00:03:38,290 --> 00:03:41,420
تاو ياو، هل أنتِ متأكّدة بأنّنا
في المكان الصّحيح؟

59
00:03:45,630 --> 00:03:48,670
،إذا لم يكن وانغ شاونيو يخدعني
فأعتقد بأنّ هذا هو المكان

60
00:03:49,040 --> 00:03:51,290
توجّهي إلى أعماق الغابة

61
00:03:51,420 --> 00:03:53,500
ستستغرقين نصف يوم للوصول إلى هناك

62
00:04:03,790 --> 00:04:05,710
ماذا حدث للمستنقع الأسطوريّ؟

63
00:04:06,830 --> 00:04:08,460
أميتافا

64
00:04:08,460 --> 00:04:11,500
...المعرض اللّيليّ... زهور الدُّرّاق

65
00:04:11,790 --> 00:04:13,330
...والسّمك

66
00:04:14,500 --> 00:04:16,540
...كلّها اختفت

67
00:04:17,330 --> 00:04:18,920
!أصبحت مهجورة

68
00:04:19,540 --> 00:04:23,290
تاو ياو، هل انتقل مريضك؟

69
00:04:24,080 --> 00:04:26,080
،إذا غدر بي

70
00:04:26,330 --> 00:04:28,290
!فسأجعله يندم طيلة حياته

71
00:04:38,790 --> 00:04:43,750
!جنّي المستنقع

72
00:04:46,130 --> 00:04:47,710
!جنّي المستنقع

73
00:05:24,000 --> 00:05:25,500
،أتيتِ أخيراً

74
00:05:26,630 --> 00:05:27,710
!يا آنسة تاو ياو

75
00:05:30,500 --> 00:05:32,670
ألم تكن أصفر اللّون؟

76
00:05:33,040 --> 00:05:34,500
لماذا أصبحت أخضر؟

77
00:05:34,500 --> 00:05:36,170
!وحتّى أنّك ترتدي قبّعة خضراء الآن

78
00:05:38,000 --> 00:05:40,380
إنّها قصّة طويلة يا آنسة تاو ياو

79
00:05:46,210 --> 00:05:47,210
...أخي

80
00:05:48,290 --> 00:05:50,460
...لم أرد أن أصبح أخضر

81
00:05:50,710 --> 00:05:53,290
،لكن تسمّمتُ في مستنقع جينغا

82
00:05:53,960 --> 00:05:56,420
وأخشى أن أموت قريباً

83
00:05:57,040 --> 00:05:59,130
تسمّمت؟ أيّ سمّ؟

84
00:06:00,500 --> 00:06:01,330
...كان

85
00:06:01,790 --> 00:06:03,920
حاكم الخريف من السّبخة هو من وضع السُّمّ

86
00:06:04,500 --> 00:06:07,880
آنذاك، لم يجفّ مستنقع جينغا كلّياً

87
00:06:08,210 --> 00:06:10,630
كنتُ لا أزال أعيش في بركة المستنقع

88
00:06:11,460 --> 00:06:13,460
،رغم أنّه بدأ يجفّ رويداً

89
00:06:13,460 --> 00:06:17,420
استطعنا نحن جنّيّو المستنقع الحفاظ
على حياتنا بالتشمُّس

90
00:06:17,540 --> 00:06:20,080
كان كلّ شيء على ما يُرام في ذلك الوقت

91
00:06:24,460 --> 00:06:25,500
،لكن في وقت لاحق

92
00:06:25,500 --> 00:06:28,330
ظهرَ حاكم الخريف فجأة

93
00:06:28,670 --> 00:06:30,750
زعم بأنّ مستنقع جينغا هو منطقته

94
00:06:31,210 --> 00:06:34,000
وأنّه سيأكل أي شخص لا يطيعه

95
00:06:39,330 --> 00:06:41,750
لم يستطع الجنّيون والأرواح في المستنقع هزيمته

96
00:06:41,920 --> 00:06:44,710
توفّي بعضنا وهرب البعض الآخر

97
00:06:44,790 --> 00:06:49,630
الحاكم خريف قويّ

98
00:06:49,630 --> 00:06:51,420
،لم يكن أمامي سوى مهرب ضيّق

99
00:06:51,540 --> 00:06:53,130
لكن سُمِّمتُ بواسطة حاكم الخريف

100
00:06:53,420 --> 00:06:54,630
،من شدّة الاستماتة

101
00:06:54,630 --> 00:06:56,880
اختبأتُ هنا وانتظرتُ حتّى أتجدّد

102
00:06:57,380 --> 00:06:59,040
لهذا طلبت منّي المساعدة

103
00:06:59,250 --> 00:06:59,880
أجل

104
00:07:00,290 --> 00:07:02,130
أنتِ أفضل طبيبة أشباح في العالم

105
00:07:02,460 --> 00:07:04,000
تمّ تركيب السّمّ على مدى فترة طويلة

106
00:07:04,000 --> 00:07:06,250
لا أعتقد بأنّ هناك أي طبيب
آخر يستطيع معالجتي

107
00:07:06,540 --> 00:07:09,080
لذا طلبتُ من شخص شراء
،طلاسم ورقيّة في قاعة السّبائك

108
00:07:09,080 --> 00:07:10,540
على أمل أن ينجح شيء ما

109
00:07:12,130 --> 00:07:14,170
انتظرتُك لنصف عام لكن لم تأتي أبداً

110
00:07:14,500 --> 00:07:16,500
ظننتُكِ لن تأتي أبداً

111
00:07:17,330 --> 00:07:18,710
أميتافا

112
00:07:19,000 --> 00:07:20,880
يؤمن بوذا بأنّ كلّ الكائنات الحيّة خُلِقت بمساواة

113
00:07:21,170 --> 00:07:22,210
،كروح بحدِّ ذاته

114
00:07:22,500 --> 00:07:24,710
كيف أمكن حاكم الخريف التنمُّر
على الآخرين بهذا الشّكل؟

115
00:07:24,920 --> 00:07:25,920
هذا كثير جدّاً

116
00:07:26,420 --> 00:07:27,920
أظنُّك عانيت كثيراً

117
00:07:27,920 --> 00:07:29,630
عند العيش على الضفّة

118
00:07:30,250 --> 00:07:31,630
لا مشكلة

119
00:07:31,630 --> 00:07:33,420
لا يهتمّ حاكم الخريف بِمَن يعيش على الضفّة

120
00:07:33,420 --> 00:07:35,710
إنّه يأخذ بعض الحيوانات فقط

121
00:07:37,000 --> 00:07:37,920
انظرا، بهذا الشّكل تماماً

122
00:07:39,040 --> 00:07:39,920
!غونغون

123
00:07:41,000 --> 00:07:43,080
!اصمد يا غونغون! أنا قادم لأجلك

124
00:07:43,080 --> 00:07:44,250
!عُد

125
00:07:44,250 --> 00:07:45,830
مستنقع جينغا عميق

126
00:07:45,830 --> 00:07:47,790
ما إن يسقط المرء فيه فلا أمل من نجاته

127
00:07:53,080 --> 00:07:54,080
،آنسة تاو ياو

128
00:07:54,080 --> 00:07:56,040
أليس الرّاهب صديقكِ؟

129
00:07:56,040 --> 00:07:57,580
لِمَ لا تساعدينه؟

130
00:07:59,880 --> 00:08:00,540
سأفعل

131
00:08:01,040 --> 00:08:02,040
سأفعل بكلّ تأكيد

132
00:08:03,830 --> 00:08:04,630
...لحظة

133
00:08:08,500 --> 00:08:10,830
لكن أحدهم سيفعل ذلك لأجلي

134
00:08:27,670 --> 00:08:28,290
!مرحباً

135
00:08:30,040 --> 00:08:32,000
تاو ياو، كيف تعامليننا بهذا الشّكل؟

136
00:08:32,000 --> 00:08:34,630
!ربّما كنتِ ستخسرين غونغون وتخسرينني للأبد

137
00:08:56,540 --> 00:08:59,040
لا تنظر إليّ هكذا. تصرّفتَ بشكل منفرد

138
00:08:59,040 --> 00:09:00,500
لم يكن شيئاً ساعدتني في فعله

139
00:09:01,250 --> 00:09:01,750
من يأبه؟

140
00:09:02,170 --> 00:09:03,500
!فتاة لئيمة

141
00:09:04,790 --> 00:09:05,500
!أيّها الرّاهب الصّغير

142
00:09:05,880 --> 00:09:07,380
،إذا تصرّفت بتهوّر ثانية

143
00:09:07,670 --> 00:09:08,710
فسأدعك تعاني

144
00:09:08,710 --> 00:09:10,130
!حتّى الموت

145
00:09:24,790 --> 00:09:26,080
أميتافا

146
00:09:26,330 --> 00:09:29,380
دائماً ما يأتي السيّد ليو ويرحل مستعجلاً

147
00:09:29,540 --> 00:09:31,580
لم تسنح لي فُرصة حتّى لشكره

148
00:09:33,290 --> 00:09:35,080
أهذا هو حاكم الخريف؟

149
00:09:36,420 --> 00:09:37,670
أجل، إنّه هو

150
00:09:38,170 --> 00:09:39,710
،لكنّه كان أضخم وأقسى من قبل

151
00:09:39,710 --> 00:09:40,960
ويعضّ كلّ من يقابله

152
00:09:41,880 --> 00:09:43,460
إنّه مجرّد روح سمك اللّوتش

153
00:09:43,580 --> 00:09:46,170
فقدَ كلّ ما تعلّمَه ولم يعد يستطيع
فعل أمور سيّئة بعد الآن

154
00:09:46,540 --> 00:09:48,130
لكنّك أخطأت

155
00:09:48,290 --> 00:09:49,330
أنت جنّي

156
00:09:49,330 --> 00:09:51,580
لماذا تمّ التنمُّر عليك بواسطة روح أدنى منك؟

157
00:09:52,000 --> 00:09:53,830
ما الخيارات الّتي كانت لديّ؟

158
00:09:53,830 --> 00:09:55,750
جنّيو المستنقع يتنقّلون بسرعة فقط

159
00:09:55,750 --> 00:09:57,420
نحن عاجزون عن فعل أي شيء آخر

160
00:09:58,080 --> 00:10:00,790
،إذاً لماذا لم تغادر إلى مكان آخر

161
00:10:00,790 --> 00:10:03,000
مكان أفضل وأجمل؟

162
00:10:05,290 --> 00:10:07,540
أنتظر شخصاً

163
00:10:17,460 --> 00:10:19,380
أعرف الفتى

164
00:10:19,380 --> 00:10:20,710
لفترة طويلة

165
00:10:22,790 --> 00:10:24,670
كان كثيراً ما يزورني في مستنقع جينغا

166
00:10:24,670 --> 00:10:26,080
كان أعزّ صديق لي

167
00:10:29,210 --> 00:10:30,540
...لكن

168
00:10:35,170 --> 00:10:36,250
خذي مزيداً من الملابس معكِ

169
00:10:36,830 --> 00:10:37,710
الجوّ بارد في الشّمال

170
00:10:38,290 --> 00:10:39,420
أمّي صنعت السّترة المُبطّنة باليدّ

171
00:10:39,750 --> 00:10:40,500
إنّها دافئة

172
00:10:40,960 --> 00:10:41,710
خذيها معكِ

173
00:10:49,290 --> 00:10:51,380
أخبرني أبي

174
00:10:51,830 --> 00:10:53,500
بأنّني قد لا أعود إلى مدينة ليزو في المستقبل

175
00:10:54,330 --> 00:10:57,500
عمّي الثّاني يدير عملاً جيّداً هناك

176
00:10:57,790 --> 00:11:00,210
لذا يريد من والدَي وأنا أن نعيش هناك أيضاً

177
00:11:02,920 --> 00:11:03,670
هذا ممتاز

178
00:11:10,290 --> 00:11:11,830
قال عمّي في رسالته

179
00:11:12,250 --> 00:11:13,290
بأنّه رتّب أمور الزواج

180
00:11:13,790 --> 00:11:15,710
لي هناك

181
00:11:19,420 --> 00:11:20,290
جيّد

182
00:11:25,750 --> 00:11:26,290
...لذا

183
00:11:27,420 --> 00:11:28,420
إلى اللِّقاء

184
00:11:31,000 --> 00:11:32,880
هل لديك شيء تقوله لي؟

185
00:11:51,670 --> 00:11:52,420
بالتّوفيق

186
00:12:19,710 --> 00:12:20,830
،في أيّ وقت

187
00:12:21,290 --> 00:12:22,670
،إذا أردتني أن أعود

188
00:12:23,250 --> 00:12:24,830
فسوف أعود مهما كنتُ بعيدة

189
00:13:10,040 --> 00:13:12,420
كانت آخر مرّة يرى فيها شاو يو

190
00:13:13,210 --> 00:13:14,960
كان يبتسم للآخرين كثيراً

191
00:13:15,540 --> 00:13:16,920
،بعد مغادرة شاو يو

192
00:13:17,380 --> 00:13:18,880
أصبح شخصاً مختلفاً

193
00:13:26,250 --> 00:13:27,710
أليس لديك موعد اليوم؟

194
00:13:28,130 --> 00:13:29,210
أين الآنسة الصّغيرة؟

195
00:13:31,790 --> 00:13:32,790
لم تعد تعيش هنا

196
00:13:34,290 --> 00:13:35,040
انتقلَتْ إذاً

197
00:13:36,500 --> 00:13:38,670
ظننتُك ستشتري أحدث سِوار في متجري

198
00:13:39,420 --> 00:13:40,290
!هذا مؤسف

199
00:13:40,290 --> 00:13:42,460
قد أحتاج لإغلاق المتجر باكراً من الآن فصاعداً

200
00:14:08,710 --> 00:14:09,380
...هذا

201
00:14:09,830 --> 00:14:10,630
لأجلك

202
00:14:11,880 --> 00:14:13,750
،رغم أنّه رخيص

203
00:14:14,130 --> 00:14:15,710
آمل أن يعجبك

204
00:14:17,880 --> 00:14:18,880
شكراً لك

205
00:14:19,630 --> 00:14:21,380
سأقدّره

206
00:14:28,710 --> 00:14:29,670
آسف

207
00:14:30,460 --> 00:14:32,170
!انظروا! مُفرقعات

208
00:14:52,380 --> 00:14:53,540
!ما أجمله

209
00:14:54,330 --> 00:14:55,500
مستنقع جينغا

210
00:14:56,130 --> 00:14:57,540
قد يكون المكان الأجمل

211
00:14:57,830 --> 00:14:59,420
في مدينة ليزو

212
00:15:00,460 --> 00:15:01,880
لستُ متأكّداً

213
00:15:02,080 --> 00:15:04,290
ما إن كنتُ أستطيع رؤية
الإطلالة معك في المستقبل

214
00:15:06,040 --> 00:15:07,670
لماذا لم تطلب منها البقاء؟

215
00:15:09,540 --> 00:15:10,920
من الصّعب لك أن ترى شاو يو ثانية

216
00:15:10,920 --> 00:15:12,540
بعد أن رحلَتْ

217
00:15:13,210 --> 00:15:14,000
...جنّي المستنقع

218
00:15:14,920 --> 00:15:15,710
لماذا؟

219
00:15:15,960 --> 00:15:17,580
أنت تحبّها حبّاً جمّاً

220
00:15:17,790 --> 00:15:19,420
لماذا لم تطلب منها البقاء؟

221
00:15:22,130 --> 00:15:23,500
لا أستطيع منحها

222
00:15:23,750 --> 00:15:24,670
أكثر شيء تحتاجه

223
00:15:25,420 --> 00:15:26,830
لِمَ أعرقل حياتها؟

224
00:15:28,040 --> 00:15:29,210
قد تجد سعادتها

225
00:15:29,540 --> 00:15:31,040
في المكان الجديد

226
00:15:31,290 --> 00:15:33,130
هل هذا لأنّك لست ثريّاً؟

227
00:15:35,380 --> 00:15:36,790
حسناً، أنت مُعدَم

228
00:15:38,170 --> 00:15:39,210
المسألة لا تتعلّق بالمال

229
00:15:39,630 --> 00:15:41,750
أنتم الجنّيون لن تفهموا

230
00:15:42,170 --> 00:15:42,880
،لذا

231
00:15:43,250 --> 00:15:44,080
لا تسأل

232
00:15:44,420 --> 00:15:45,130
...لكن

233
00:15:45,580 --> 00:15:47,460
ماذا لو ندمتَ على ذلك يوماً ما؟

234
00:15:50,460 --> 00:15:51,420
قالت شاو يو

235
00:15:52,330 --> 00:15:53,330
،أنّني إذا طلبتُ منها العودة

236
00:15:54,130 --> 00:15:55,500
فسوف تعود

237
00:15:56,080 --> 00:15:57,460
مهما كانت

238
00:15:58,040 --> 00:15:59,000
بعيدة

239
00:16:00,130 --> 00:16:01,380
!هذا رائع

240
00:16:01,580 --> 00:16:02,710
أخبرتُك بأنّ

241
00:16:02,880 --> 00:16:05,210
جنّيو المستنقع يستطيعون قطع
مسافة 1000 ميل في يوم واحد

242
00:16:06,630 --> 00:16:07,630
أعلم

243
00:16:08,130 --> 00:16:09,170
شكراً لك على عرضك اللّطيف

244
00:16:09,880 --> 00:16:11,670
،إذا افتقدتُها يوماً ما

245
00:16:12,290 --> 00:16:13,750
فسأطلب منك أن ترسل رسالة لها

246
00:16:15,040 --> 00:16:16,290
جيّد

247
00:16:16,580 --> 00:16:17,630
اتّفقنا إذاً الآن

248
00:16:17,880 --> 00:16:19,670
تعال والتقِ بي في مستنقع جينغا

249
00:16:20,080 --> 00:16:20,830
سوف أنتظرك

250
00:16:25,290 --> 00:16:25,830
حسناً

251
00:16:30,080 --> 00:16:33,500
في تلك اللّيلة، جلسَ في مستنقع
جينغا لفترة طويلة

252
00:16:34,630 --> 00:16:36,210
قال بأنّه سوف ينتقل إلى مكان آخر

253
00:16:36,710 --> 00:16:38,880
لكن كان كلّ ما يتحدّث عنه هي شاو يو

254
00:16:40,540 --> 00:16:41,250
عرفتُ بأنّه

255
00:16:41,500 --> 00:16:43,420
اشتاق لها كثيراً

256
00:16:43,960 --> 00:16:45,290
لذا سأبقى هنا أنتظره

257
00:16:46,210 --> 00:16:48,040
حتّى تأتي اللّحظة الّتي يرغب
فيها بالتّواصل معها مجدّداً

258
00:16:48,920 --> 00:16:50,130
سوف أسلّم رسالته لها

259
00:16:50,130 --> 00:16:52,130
أريد أن أراه يؤسّس عائلة مع شاو يو

260
00:16:52,420 --> 00:16:54,210
ويعيشا بسعادة بعد ذلك

261
00:16:56,670 --> 00:16:57,540
...ربّما

262
00:16:58,040 --> 00:17:00,080
هذه الغاية من وجودي

263
00:17:02,670 --> 00:17:05,000
لكن مرّت سنوات طِوال

264
00:17:05,330 --> 00:17:08,830
لم يعُد

265
00:17:11,580 --> 00:17:13,630
والآن جفّ مستنقع جينغا

266
00:17:14,420 --> 00:17:16,420
ولا يأتي أحدٌ إلى هنا للاستمتاع بالزّهور

267
00:17:17,420 --> 00:17:18,710
لكن ما زلتُ أنتظره

268
00:17:20,750 --> 00:17:23,170
انتظرتَ أكثر من 10 سنوات لهذا السّبب؟

269
00:17:23,670 --> 00:17:25,000
بل أطول من ذلك

270
00:17:25,380 --> 00:17:26,710
إنّها بضعة عقود

271
00:17:27,750 --> 00:17:29,250
أميتافا

272
00:17:29,420 --> 00:17:31,210
حصلتَ على حكمة زين الآن

273
00:17:31,290 --> 00:17:33,630
ألم تفكّر في المغادرة أبداً؟

274
00:17:36,540 --> 00:17:38,170
،إذا غادرتُ هذا المكان

275
00:17:38,170 --> 00:17:39,080
فلا أحد يستطيع إيصال الرّسائل له

276
00:17:39,080 --> 00:17:41,210
عندما يعود

277
00:17:44,540 --> 00:17:46,330
!لهذا يجب أن أعيش حياة أطول

278
00:17:46,330 --> 00:17:49,250
!آنسة تاو ياو، ساعديني أرجوكِ

279
00:17:51,670 --> 00:17:53,500
أيّها الجنّيون الصِّغار

280
00:17:53,500 --> 00:17:55,670
هل فقدتُم صوابكم؟

281
00:17:55,960 --> 00:17:58,790
ربّما لن يعود مجدّداً أبداً

282
00:17:59,420 --> 00:18:00,670
فكّرتُ في الأمر

283
00:18:00,670 --> 00:18:02,540
لكن ماذا لو عاد يوماً ما؟

284
00:18:05,750 --> 00:18:06,540
اِنسَ الأمر

285
00:18:06,920 --> 00:18:09,750
سأجنّ إذا سألتُك أكثر عن الأمر

286
00:18:12,000 --> 00:18:12,830
يمكنني مساعدتك

287
00:18:13,210 --> 00:18:15,250
لكن هناك قواعد

288
00:18:15,710 --> 00:18:17,210
وقِّع هنا بإبهامك

289
00:18:24,000 --> 00:18:25,080
،من الآن فصاعداً

290
00:18:25,080 --> 00:18:26,330
أنت دواء من أدويتي

291
00:18:26,710 --> 00:18:27,330
مفهوم؟

292
00:18:27,790 --> 00:18:28,380
أجل

293
00:18:31,830 --> 00:18:33,330
قرية وانغ

294
00:18:34,170 --> 00:18:35,880
الصّبيّ الّذي ينتظره جنّي المستنقع

295
00:18:35,880 --> 00:18:37,080
يعيش هنا، صحيح؟

296
00:18:38,750 --> 00:18:39,670
يا آنسة

297
00:18:40,080 --> 00:18:41,710
ألم تذهبي إلى مستنقع جينغا؟

298
00:18:41,880 --> 00:18:43,210
ما الّذي جاء بكِ إلى هنا؟

299
00:18:43,330 --> 00:18:44,920
كنّا هناك. والآن عدنا

300
00:18:45,330 --> 00:18:46,880
أخبرتُكِ بأنّ المكان كان معزولاً

301
00:18:47,330 --> 00:18:49,420
مستنقع جينغا قد جفّ

302
00:18:49,630 --> 00:18:51,540
منذ بناء بيت للصّباغة أعلى الجدول

303
00:18:52,670 --> 00:18:54,000
!خسارة

304
00:18:54,210 --> 00:18:57,420
لا توجد أسماك فيه إطلاقاً الآن

305
00:18:58,210 --> 00:19:00,250
هل ما زلتِ تفتقدين لأسماكي؟

306
00:19:00,250 --> 00:19:02,130
أخذها السيّد مياو إلى المنزل

307
00:19:02,920 --> 00:19:04,380
هل لدى السيّد مياو

308
00:19:04,380 --> 00:19:06,130
نمش في وجهه

309
00:19:06,130 --> 00:19:07,380
ويعشق أكل السّمك؟

310
00:19:07,710 --> 00:19:08,380
أجل

311
00:19:08,630 --> 00:19:10,250
وقعتُ في بئر قبل ثلاث سنوات

312
00:19:10,250 --> 00:19:11,960
وأنقذني السيّد مياو

313
00:19:12,250 --> 00:19:13,460
هذا غريب

314
00:19:13,710 --> 00:19:15,080
"لم يقبل "هديّة شكر

315
00:19:15,080 --> 00:19:16,880
لكن طلب منّي تقديم أسماك في كلّ شهر

316
00:19:17,380 --> 00:19:18,250
لثلاث سنوات؟

317
00:19:18,580 --> 00:19:19,790
!أي 36 شهراً

318
00:19:20,040 --> 00:19:21,670
كنتَ تفعل هذا طوال الوقت؟

319
00:19:21,670 --> 00:19:22,290
أجل

320
00:19:22,830 --> 00:19:24,710
تنصحني جدّتي أن أكون شخصاً صادقاً

321
00:19:24,920 --> 00:19:26,420
ينبغي أن أوفي بوعودي

322
00:19:27,960 --> 00:19:29,880
لم أتوقّع أبداً أن ألتقي بشخص
سخيف جدّاً هنا

323
00:19:30,290 --> 00:19:31,710
يا آنسة، ماذا قلتِ؟

324
00:19:32,330 --> 00:19:33,330
لا شيء

325
00:19:34,040 --> 00:19:35,540
نريد زيارة القرية

326
00:19:35,540 --> 00:19:36,880
هلّا دللتنا إليها؟

327
00:19:37,710 --> 00:19:38,330
بالتّأكيد

328
00:19:38,420 --> 00:19:40,210
ستكون جدّتي سعيدة برؤيتكما

329
00:19:40,580 --> 00:19:41,920
من هنا لو سمحتُما

330
00:19:43,210 --> 00:19:44,040
،تاو ياو

331
00:19:44,210 --> 00:19:45,960
لقد حللتِ المشكلة

332
00:19:46,210 --> 00:19:48,210
فلماذا سنزور القرية؟

333
00:19:49,290 --> 00:19:50,380
تمهّل

334
00:19:50,920 --> 00:19:53,750
لم أدوّن الوصفة الحقيقيّة بعد

335
00:19:57,500 --> 00:20:02,710
♪ هناك مئات الوحوش ♪

336
00:20:04,080 --> 00:20:10,880
♪ الجميع يستطيعون التّمييز بين الخير والشرّ ♪

337
00:20:12,290 --> 00:20:20,080
♪ ليس للبشر إلّا قلب واحد ♪

338
00:20:20,290 --> 00:20:28,790
♪ لكنّه غير مُتوقَّع ♪