1
00:00:14,680 --> 00:00:16,470
♪ غير راغب في سماع الآخرين ♪

2
00:00:16,810 --> 00:00:22,220
♪ تهبُّ الرّياح. نمشي في الثّلج معاً ♪

3
00:00:22,270 --> 00:00:24,140
♪ الخير سيتفتّح ♪

4
00:00:24,560 --> 00:00:28,350
♪ اِنسَ الألم ♪

5
00:00:29,890 --> 00:00:31,930
♪ ألقِ اللّوم على الجرس ♪

6
00:00:32,270 --> 00:00:37,310
♪ لم يستطع إيقاظ الرُّوح المُبهمة ♪

7
00:00:37,640 --> 00:00:40,020
♪ انتظر حتّى الفجر ♪

8
00:00:40,060 --> 00:00:44,350
♪ أسود وأبيض صافيان ♪

9
00:00:45,270 --> 00:00:49,930
♪ الآلهة عُميٌ عندما يتعلّق الأمر بالمواجهة بين العدل والشرّ♪

10
00:00:50,100 --> 00:00:52,470
♪ اِنسَ الحزن والبهجة ♪

11
00:00:52,770 --> 00:00:57,720
♪ البيادق في اللّعبة تربط ما بين الصّواب والخطأ ♪

12
00:00:57,770 --> 00:01:01,310
♪ من سيكسر الطّريق المسدود ♪

13
00:01:02,560 --> 00:01:09,020
♪ من الصّعب معالجة العقل، على الأقلّ هناك قلب ♪

14
00:01:10,270 --> 00:01:17,890
♪ التّرنيمة مفقودة في عزاء كسب السّلام ♪

15
00:01:17,930 --> 00:01:28,060
♪ أتحمّل فترة عاصفة مقابل السّكينة لحياتي ♪

16
00:01:29,430 --> 00:01:36,060
♪ بدعمك، لن تتغيّر إرادتي أبداً ♪

17
00:01:36,130 --> 00:01:39,770
مذكّرات الجنّيات

18
00:01:43,970 --> 00:01:49,350
الحلقة 10: التنّين اللّطيف
الجزء 2

19
00:01:54,390 --> 00:01:56,390
عند مُمارسة براجنا باراميتا البليغة

20
00:01:56,600 --> 00:01:58,100
وتصوّر أنّ السكاندا الخمسة فارغة

21
00:01:58,310 --> 00:01:59,430
وبالتّالي التحرّر من كلّ المعاناة

22
00:02:00,350 --> 00:02:01,520
أفالوكيتيسفارا بوديساتفا

23
00:02:01,680 --> 00:02:02,140
عند مُمارسة براجنا باراميتا البليغة

24
00:02:02,140 --> 00:02:03,890
!توقّف. هذا مزعج للغاية

25
00:02:05,140 --> 00:02:06,390
!تأذّى أذيّة شديدة

26
00:02:06,520 --> 00:02:08,100
يجب أن أصلّي له

27
00:02:10,520 --> 00:02:11,470
،حتّى لو استمررتَ في الصّلاة

28
00:02:11,640 --> 00:02:12,850
!لا يمكنك إنقاذه

29
00:02:15,600 --> 00:02:17,100
سيبدأ الظّهر قريباً

30
00:02:17,390 --> 00:02:19,350
ماذا حدث للسيّد ليو يا تُرى؟

31
00:02:20,970 --> 00:02:22,850
يمكنني الذّهاب للبحث عن جنّي الجفاف

32
00:02:23,390 --> 00:02:25,350
لكن ستكونين مَدينة لي بمعروف ثلاث مرّات

33
00:02:25,350 --> 00:02:26,930
!هذا ابتزاز

34
00:02:27,220 --> 00:02:28,520
هذا ليس لأجلي

35
00:02:28,770 --> 00:02:30,140
هذا لأجل سكّان قرية السّمك الطّائر

36
00:02:31,470 --> 00:02:33,060
معروفان على الأقلّ

37
00:02:34,430 --> 00:02:35,020
واحد ونصف

38
00:02:35,430 --> 00:02:38,140
أو سأحرص على ألّا تحصل على مو يا أبداً

39
00:02:39,770 --> 00:02:40,430
!أنتِ

40
00:02:40,520 --> 00:02:42,390
!إنّكِ قاسية جدّاً

41
00:02:48,430 --> 00:02:49,310
لا تقلق

42
00:02:50,390 --> 00:02:51,470
،الآن بعد أن وعد

43
00:02:51,560 --> 00:02:52,600
سوف يفعلها

44
00:02:55,970 --> 00:02:57,770
حسناً، ينبغي أن يكون هذا جيّداً

45
00:03:05,100 --> 00:03:05,810
استيقظت

46
00:03:07,060 --> 00:03:09,430
...جنّي الجفاف

47
00:03:10,060 --> 00:03:10,890
جنّي الجفاف قد هرب

48
00:03:15,720 --> 00:03:17,810
في أيّ وقت نحن الآن؟

49
00:03:18,350 --> 00:03:19,770
سأبحث عن جنّي الجفاف

50
00:03:20,180 --> 00:03:21,640
يجب أن أجده قبل الظّهر

51
00:03:24,600 --> 00:03:25,220
انتظر

52
00:03:25,470 --> 00:03:26,470
أخبرني بالحقيقة أوّلاً

53
00:03:27,220 --> 00:03:28,060
لا تلمسيني

54
00:03:28,640 --> 00:03:29,350
!مهلك

55
00:03:29,520 --> 00:03:30,470
لا يمكنك حتّى المشي

56
00:03:30,470 --> 00:03:31,560
كيف تستطيع إيجاد جنّي الجفاف؟

57
00:03:31,930 --> 00:03:33,020
!دعيني

58
00:03:33,930 --> 00:03:35,350
،حتّى لو فقدتُ حياتي

59
00:03:35,810 --> 00:03:37,810
لن أدع جنّي الجفاف ينجح

60
00:03:39,100 --> 00:03:41,020
النّاس يقولون دوماً بأنّ التنّين
،اللّطيف كسول فطريّاً

61
00:03:41,020 --> 00:03:42,890
إنّه الجنّي الأفشل في السّماء

62
00:03:43,270 --> 00:03:46,060
لكن عملتَ بجدٍّ لأجل هذه القرية

63
00:03:46,430 --> 00:03:47,430
لماذا؟

64
00:03:49,680 --> 00:03:51,890
هل للأمر علاقة بآمانغ؟

65
00:03:53,770 --> 00:03:55,350
ما أدراك بآمانغ؟

66
00:03:56,140 --> 00:03:57,770
!أخبرني أوّلاً

67
00:04:02,220 --> 00:04:02,930
لا؟

68
00:04:03,310 --> 00:04:04,180
حسناً. سنغادر

69
00:04:04,890 --> 00:04:06,390
لا يمكنك التحرّك الآن

70
00:04:06,520 --> 00:04:08,930
لا أحد يستطيع مساعدتك لإنقاذ
قرية السّمك الطّائر سوانا

71
00:04:21,350 --> 00:04:22,430
مو يا، هيّا بنا

72
00:04:24,930 --> 00:04:25,600
انتظري

73
00:04:27,850 --> 00:04:28,640
آمانغ

74
00:04:29,850 --> 00:04:31,310
إنّه صديقي

75
00:04:32,890 --> 00:04:34,640
إنّه أيضاً أوّل شخص يحتاجني

76
00:04:37,390 --> 00:04:38,930
،عندما كنتُ في السّماء

77
00:04:39,770 --> 00:04:41,560
الجميع ظنّني عديم الجدوى

78
00:04:42,720 --> 00:04:43,720
لستُ مستعدّاً لقبول الأمر

79
00:04:45,020 --> 00:04:46,680
رغم أنّني لستُ قويّاً مثل أولئك الجنّيين الرّسميّين

80
00:04:47,180 --> 00:04:49,180
الّذين يستطيعون صنع نهر أو بحر
في غضون يوم أو يومين

81
00:04:49,720 --> 00:04:52,810
لكن أعمل أيضاً بجدّ لإنزال أمطار
من أجل إخماد نيران

82
00:04:53,640 --> 00:04:55,470
أحياناً أستطيع إنقاذ حياة أو اثنتين

83
00:04:56,270 --> 00:04:57,350
لِمَ ينعتونني بعديم الجدوى؟

84
00:05:18,180 --> 00:05:18,970
،ينبغي أن تعلمي جيّداً

85
00:05:20,180 --> 00:05:21,640
بأنّنا ننهض باكراً أكثر من الدّجاج يوميّاً

86
00:05:22,020 --> 00:05:22,890
وعملنا مُرهِق أكثر من بقرة

87
00:05:23,890 --> 00:05:25,520
،لولا جهودنا الطّفيفة

88
00:05:26,060 --> 00:05:27,720
حتّى أولئك الجنّيين الرّسميّين الّذين
،يمتلكون قوّة هائلة

89
00:05:28,430 --> 00:05:30,020
لا يستطيعون الاعتناء بالنّاس في كلّ أنحاء العالم

90
00:05:48,890 --> 00:05:49,770
،لكن

91
00:05:50,270 --> 00:05:51,220
،انظري إلى العالم فحسب

92
00:05:51,390 --> 00:05:53,390
النّاس يُقدّمون إكراميّات لإله النّهر
وإله الماء وملك التّنانين

93
00:05:53,680 --> 00:05:54,970
،يعبدون كلّ أنواع الآلهة والبوذا

94
00:05:55,520 --> 00:05:56,970
باستثنائي أنا

95
00:06:00,020 --> 00:06:01,680
!لذا، استسلمت

96
00:06:02,390 --> 00:06:03,520
!لم تعُد السّماء تعنيني

97
00:06:04,060 --> 00:06:05,930
فليخمدوا الحرائق ويُنزِلوا المطر بأنفسهم

98
00:06:11,560 --> 00:06:12,600
،بعد نزولي إلى الأرض

99
00:06:13,310 --> 00:06:14,640
صرتُ أتمشّى وألعب كلّ يوم

100
00:06:15,350 --> 00:06:16,930
،أستمتع بحياتي المترفة

101
00:06:18,100 --> 00:06:19,680
باستثناء أنّه عليّ تجنُّب ثور بين الحين والآخر

102
00:06:20,600 --> 00:06:22,060
فضلاً عن ذلك، كلّ شيء آخر على ما يُرام

103
00:06:46,100 --> 00:06:46,850
،لكن

104
00:06:48,180 --> 00:06:49,390
وجدتُ أنّ هذا النّمط من الحياة

105
00:06:49,390 --> 00:06:50,890
ليس مُمتعاً كما ظننتُ

106
00:06:52,100 --> 00:06:53,810
ثمّة شيء ناقص في حياتي

107
00:07:02,810 --> 00:07:03,770
لا أفهم ما هو

108
00:07:04,640 --> 00:07:06,390
حصلتُ بالفعل على ما أردتُ

109
00:07:07,140 --> 00:07:07,970
لكن لماذا؟

110
00:07:08,520 --> 00:07:09,890
لماذا ما زلتُ غير سعيد؟

111
00:07:12,600 --> 00:07:13,970
،ثمّ

112
00:07:15,350 --> 00:07:16,560
التقيتُ بآمانغ

113
00:07:40,930 --> 00:07:43,430
!آمانغ، اسمع

114
00:07:43,770 --> 00:07:46,520
هل يوجد أحدٌ هناك؟

115
00:07:46,520 --> 00:07:47,600
أجل

116
00:07:48,060 --> 00:07:49,220
ربّما شخص يلتجئ من المطر

117
00:07:49,470 --> 00:07:50,270
سأفتح الباب

118
00:08:04,140 --> 00:08:06,810
هل أنت هنا للالتجاء من المطر؟

119
00:08:09,390 --> 00:08:10,560
لا أستطيع الرّؤية

120
00:08:10,930 --> 00:08:12,850
من فضلك أخبرني إن كنت كذلك

121
00:08:16,970 --> 00:08:19,060
لا أحد في الخارج يا جدّتي

122
00:08:37,310 --> 00:08:38,520
لاحقاً، اكتشفتُ

123
00:08:39,310 --> 00:08:41,350
أنّه لا يوجد سوى جدّة وحفيدها في هذه العائلة

124
00:08:42,310 --> 00:08:44,640
كانت الجدّة كبيرة جدّاً تعجز
عن أداء الأعمال الشاقّة

125
00:08:45,720 --> 00:08:48,140
بينما الطّفل آمانغ أعمى

126
00:08:48,470 --> 00:08:49,680
لكنّه كان رشيقاً

127
00:08:51,310 --> 00:08:52,680
عاشا

128
00:08:53,100 --> 00:08:54,350
حياة بسيطة في هذا المكان

129
00:08:56,430 --> 00:08:58,140
إنّه مكانٌ جميلٌ حقّاً

130
00:08:58,720 --> 00:09:00,430
لذا قرّرتُ العيش في فنائهما

131
00:09:01,270 --> 00:09:02,680
بدا أنَّ ثور قد نسي أمري

132
00:09:03,390 --> 00:09:04,470
بقيتُ هناك لنصف شهر

133
00:09:04,930 --> 00:09:06,720
لم يحدث شيء

134
00:09:14,520 --> 00:09:15,310
،حسناً

135
00:09:15,560 --> 00:09:17,020
جدّتك تكبر

136
00:09:17,220 --> 00:09:18,560
الآن بعد أن أُصيبَتْ بالحُمّى التّيفوئيديّة

137
00:09:18,970 --> 00:09:20,270
،إذا لم ترتح كما ينبغي

138
00:09:20,470 --> 00:09:22,020
فستتعرّض حياتها لخطر

139
00:09:22,470 --> 00:09:24,020
سيُسلَّم الدّواء ظهراً

140
00:09:24,350 --> 00:09:25,310
يجب أن يؤخذ الدّواء ثلاث مرّات في اليوم

141
00:09:25,810 --> 00:09:26,680
لا تنسَ

142
00:09:28,390 --> 00:09:29,350
شكراً لك يا طبيب

143
00:09:56,350 --> 00:09:57,270
،عزيزي جنّي الأرض

144
00:09:57,680 --> 00:09:59,970
من فضلك أنعِم على جدّتي بحيث تتعافى قريباً

145
00:10:00,560 --> 00:10:03,520
أعِدُك أن أقدّم لك إكراميّات يوميّاً

146
00:10:19,270 --> 00:10:21,970
من؟ من هناك؟

147
00:10:24,220 --> 00:10:26,930
هل أنت جنّي أرض؟

148
00:10:31,060 --> 00:10:33,770
أجل، أنا جنّي أرض

149
00:10:37,560 --> 00:10:38,890
!هذا أنت فعلاً

150
00:10:39,220 --> 00:10:40,640
!سمعتني

151
00:10:41,970 --> 00:10:42,930
!صه، أخفض صوتك

152
00:10:43,470 --> 00:10:46,060
أتيتُ لأراك لأنّك ابن بارّ

153
00:10:46,640 --> 00:10:49,180
إذا صرختَ ثانية، فسوف أرحل

154
00:10:49,970 --> 00:10:51,970
حسناً، حسناً، لن أصرخ

155
00:10:55,810 --> 00:10:57,810
لا تذهب أرجوك يا جنّي الأرض

156
00:10:59,430 --> 00:11:00,640
ممتاز

157
00:11:04,970 --> 00:11:07,600
جنّي الأرض، جدّتي مريضة

158
00:11:07,890 --> 00:11:09,520
تناولت دواء لبضعة أيّام ولم تتحسّن بعد

159
00:11:10,020 --> 00:11:12,310
هل يمكنك إعادة صحّة جدّتي؟

160
00:11:13,390 --> 00:11:15,060
من أين لي قدرة كهذه؟

161
00:11:15,720 --> 00:11:16,680
ماذا قلت؟

162
00:11:18,850 --> 00:11:20,890
لقد باركتُ بجدّتك

163
00:11:21,310 --> 00:11:22,520
ستكون بخير

164
00:11:23,520 --> 00:11:24,310
شكراً لك

165
00:11:25,140 --> 00:11:25,930
،عزيزي جنّي الأرض

166
00:11:26,140 --> 00:11:28,180
أعِدُك، سوف أعبدك كلّ يوم

167
00:11:34,020 --> 00:11:34,720
لا

168
00:11:34,970 --> 00:11:36,180
أفضّل الهدوء

169
00:11:36,680 --> 00:11:38,270
لا تزعجني أكثر من ذلك

170
00:11:39,850 --> 00:11:41,060
...حسناً. إذاً، أنا

171
00:11:41,850 --> 00:11:44,430
إذاً لن أزعجك أكثر من ذلك

172
00:11:45,430 --> 00:11:47,680
،رغم أنّني استخدمتُ اسم جنّي الأرض

173
00:11:48,100 --> 00:11:49,430
كنتُ مع ذلك سعيداً

174
00:11:50,520 --> 00:11:51,560
يبدو أنّ من يُعبَد

175
00:11:52,220 --> 00:11:53,770
هذا ما يشعر به

176
00:12:04,390 --> 00:12:05,390
،منذ ذلك اليوم

177
00:12:06,390 --> 00:12:08,430
لم يأتِ آمانغ للعبادة

178
00:12:09,220 --> 00:12:10,770
،لكن كنتُ كلّما استيقظت

179
00:12:11,560 --> 00:12:13,430
أرى بعض الإكراميّات دوماً

180
00:12:23,390 --> 00:12:24,350
،إلى اللّقاء

181
00:12:24,970 --> 00:12:26,720
تعافتْ جدّتُه من المرض

182
00:12:27,470 --> 00:12:28,520
كان آمانغ سعيداً جدّاً

183
00:12:29,220 --> 00:12:30,060
ظنَّ بأنّني أنا

184
00:12:30,390 --> 00:12:31,430
من ساعدتُه

185
00:12:35,850 --> 00:12:37,680
!جنّي الأرض، قوّتك عظيمة

186
00:12:38,140 --> 00:12:39,770
شكراً لك على إنقاذ جدّتي

187
00:12:44,890 --> 00:12:45,770
كلّ هذا

188
00:12:46,350 --> 00:12:48,180
يجعلني أشعر بالرّضا

189
00:13:13,060 --> 00:13:14,220
أدركتُ فجأة

190
00:13:15,140 --> 00:13:16,470
بأنّ ما أردتُه دوماً

191
00:13:16,930 --> 00:13:18,310
،لم يكن حياة ترف

192
00:13:19,350 --> 00:13:22,060
إنّما الشّعور بأن أكون مرغوباً ومُعترَفاً بي

193
00:13:24,220 --> 00:13:26,270
بدأتُ أحبّه

194
00:13:37,850 --> 00:13:38,970
أيُّها الصّغير

195
00:13:39,430 --> 00:13:40,390
ماذا تفعل؟

196
00:13:41,930 --> 00:13:43,390
جنّي الأرض؟

197
00:13:43,680 --> 00:13:44,640
لماذا أنت هنا؟

198
00:13:46,070 --> 00:13:47,140
مررتُ بالقرب من منزلك

199
00:13:47,560 --> 00:13:48,890
فقلتُ لنفسي أن أزورك

200
00:13:51,890 --> 00:13:53,470
ماذا تزرع؟

201
00:13:54,620 --> 00:13:55,390
قصب سكّر

202
00:13:55,790 --> 00:13:57,430
شراب جدّتي المُفضّل هو عصير قصب السكّر

203
00:13:57,810 --> 00:13:58,640
قصب السكّر

204
00:13:59,520 --> 00:14:01,560
هناك حقل قصب سكّر خلف قريتك

205
00:14:02,100 --> 00:14:03,220
لماذا تزرعه في المنزل؟

206
00:14:04,560 --> 00:14:05,890
إنّه بعيد جدّاً

207
00:14:06,330 --> 00:14:08,140
أرغب في زرع بعض منه في فنائنا

208
00:14:08,470 --> 00:14:10,640
وذلك كي تستطيع جدّتي شرب
عصير قصب السكّر كلّ يوم

209
00:14:11,670 --> 00:14:12,470
هذا جيّد

210
00:14:13,470 --> 00:14:14,670
هل مذاق قصب السكّر لذيذ؟

211
00:14:15,140 --> 00:14:16,140
!لذيذ جدّاً

212
00:14:16,450 --> 00:14:17,680
إنّه حلوٌ جدّاً

213
00:14:18,060 --> 00:14:19,100
حلو؟

214
00:14:20,390 --> 00:14:21,100
هذا صحيح

215
00:14:21,270 --> 00:14:23,270
ألم تتذوّق عصير قصب السكّر من قبل؟

216
00:14:25,470 --> 00:14:26,770
جرّبتُه من قبل بالطّبع

217
00:14:27,180 --> 00:14:28,720
أريد أن أختبرك فحسب

218
00:14:29,850 --> 00:14:30,850
فهمت

219
00:14:32,100 --> 00:14:33,020
ما الّذي فهمته؟

220
00:14:33,890 --> 00:14:34,890
،عندما ينضج قصب السكّر

221
00:14:35,220 --> 00:14:37,680
فسأقدّم لك أكثر عصير قصب سكّر طازج

222
00:14:40,770 --> 00:14:43,000
قصب سكّر طازج

223
00:14:44,770 --> 00:14:45,770
،لذا

224
00:14:46,100 --> 00:14:49,020
هل يمكنك أن تُبارك بقصب السكّر
الخاصّ بي كي ينمو سليماً؟

225
00:14:51,350 --> 00:14:52,640
لم أقل شيئاً

226
00:14:53,310 --> 00:14:54,430
جفلتُ فحسب

227
00:14:55,350 --> 00:14:57,350
فأساساً، لم أملك القدرة على مُبارَكة أحد

228
00:14:58,090 --> 00:14:59,560
في المرّة السّابقة، حالفني الحظُّ فحسب

229
00:15:00,020 --> 00:15:01,310
،إذا لم يفلح الأمر هذه المرّة

230
00:15:01,890 --> 00:15:03,600
فقد يُصاب بخيبة شديدة

231
00:15:04,340 --> 00:15:05,680
قد يعتقد بأنّني عديم الجدوى

232
00:15:07,140 --> 00:15:08,250
،عندما فكّرتُ في هذا

233
00:15:08,970 --> 00:15:10,220
خفتُ كثيراً

234
00:15:11,650 --> 00:15:13,210
لحسن الحظّ، سار كلُّ شيء على ما يُرام

235
00:15:13,930 --> 00:15:15,390
،حتّى من دون أي مساعدة

236
00:15:15,760 --> 00:15:18,680
اعتنى جيّداً بحقل قصب السكّر

237
00:15:21,100 --> 00:15:22,890
يزداد قصب السّر طولاً يوماً بعد يوم

238
00:15:23,770 --> 00:15:27,720
أنا متأكّد بأنّه سيكون هناك حقلاً وافراً
بالسكّر في العام المقبل

239
00:15:38,270 --> 00:15:39,770
،لكن ما فاجأني

240
00:15:40,060 --> 00:15:43,220
هو أنّ جنّي الجفاف قد جاء في تلك اللّحظة

241
00:15:59,770 --> 00:16:00,560
ماذا يجدر بي أن أفعل؟

242
00:16:01,350 --> 00:16:02,890
هل ينبغي أن أعود إلى السّماء لأبلغ عنه؟

243
00:16:03,470 --> 00:16:04,140
لا

244
00:16:04,610 --> 00:16:06,140
هذا سيفضحني

245
00:16:07,140 --> 00:16:08,390
،لكن إذا تركتُه

246
00:16:08,770 --> 00:16:09,640
فماذا سيحدث لآمانغ؟

247
00:16:10,560 --> 00:16:11,850
ماذا عن حقل قصب السكّر الخاص به؟

248
00:16:13,640 --> 00:16:14,640
،عزيزي جنّي الأرض

249
00:16:15,130 --> 00:16:17,930
أرجوك حافِظ على سلامة حقل
قصب السكّر الخاص بي

250
00:16:18,890 --> 00:16:20,720
لم أعد أتزحزح من بعدها

251
00:16:26,310 --> 00:16:27,270
لكنّك فشلت

252
00:16:27,770 --> 00:16:29,270
،لم تفشل في إيقاف جنّي الجفاف فحسب

253
00:16:29,640 --> 00:16:31,350
بل تعرّضت لجروح أيضاً

254
00:16:33,600 --> 00:16:35,430
!قد تعتقدين بأنّني غبيّ كذلك

255
00:16:36,140 --> 00:16:37,430
أميتافا

256
00:16:37,660 --> 00:16:39,890
،بما أنّ لديك سبب جيّد كهذا

257
00:16:40,140 --> 00:16:41,560
لماذا لا تخبرنا فحسب؟

258
00:16:43,270 --> 00:16:44,560
وماذا يعني؟

259
00:16:45,310 --> 00:16:46,850
،على أيّ حال، في ذهن الجميع

260
00:16:47,430 --> 00:16:50,350
التنّين اللّطيف هو دوماً جنّي كسول

261
00:16:50,810 --> 00:16:52,710
وما هي خطوتك التّالية؟

262
00:16:57,660 --> 00:16:59,600
أريد إنقاذ حقل قصب السكّر الخاصّ بآمانغ

263
00:17:00,430 --> 00:17:02,180
أريد إنقاذ قرية السّمك الطّائر

264
00:17:04,140 --> 00:17:05,850
التنّين اللّطيف، ماذا تفعل؟

265
00:17:07,600 --> 00:17:09,220
أنا عديم الجدوى

266
00:17:09,770 --> 00:17:10,930
لا أستطيع فعل شيء

267
00:17:11,350 --> 00:17:12,560
أحبّ حتّى أن أتباهى

268
00:17:13,600 --> 00:17:15,020
لم أتوسّل أحداً في حياتي

269
00:17:15,890 --> 00:17:16,770
،لكن هذه المرّة

270
00:17:17,270 --> 00:17:18,310
أطلب مساعدتكما

271
00:17:18,600 --> 00:17:19,560
أرجوكما أنقذا القرية

272
00:17:19,720 --> 00:17:20,810
أرجوكما أنقذا آمانغ

273
00:17:21,470 --> 00:17:22,180
أنا حقّاً

274
00:17:23,310 --> 00:17:24,890
لا أريد أن أخذله

275
00:17:25,520 --> 00:17:27,100
لا تفعل من فضلك أيُّها التنّين اللّطيف

276
00:17:27,470 --> 00:17:28,140
...في الواقع

277
00:17:28,140 --> 00:17:29,640
في الواقع، مضى الظّهر منذ فترة طويلة

278
00:17:31,880 --> 00:17:33,390
استغرقتَ وقتاً طويلاً في سرد الرّوايات

279
00:17:33,710 --> 00:17:35,100
لهذا الظّهر قد ولّى منذ فترة طويلة

280
00:17:42,060 --> 00:17:43,560
ما الّذي يجري؟

281
00:17:45,560 --> 00:17:46,390
!اخرج

282
00:17:58,640 --> 00:18:00,270
فقدَ هذا الشرّير قوّتَه

283
00:18:00,640 --> 00:18:02,020
لا يستطيع حتّى الكلام

284
00:18:10,060 --> 00:18:12,390
عندما وجدتُه، كان على وشك
أن يستخدم تعويذة

285
00:18:12,810 --> 00:18:15,810
لحسن الحظّ، استخدمتُ دمَك لختم معظم قوّته

286
00:18:18,620 --> 00:18:20,890
وإلّا فلن أتمكّن من التحكّم بالوضع

287
00:18:22,890 --> 00:18:23,770
حقّاً؟

288
00:18:24,270 --> 00:18:26,310
قبضتَ عليه بفضل دمائي؟

289
00:18:26,600 --> 00:18:27,270
!أجل

290
00:18:27,270 --> 00:18:29,970
نُسِبَ الإنجاز لك إذاً

291
00:18:31,600 --> 00:18:33,220
،من دون قيادتي الحكيمة

292
00:18:33,470 --> 00:18:34,930
كيف ستتمكّن من إنقاذ قرية السّمك الطّائر؟

293
00:18:35,350 --> 00:18:37,520
!أجل، أجل، أنتِ الأفضل

294
00:18:39,890 --> 00:18:41,020
،مولاتي تاو ياو

295
00:18:41,520 --> 00:18:43,340
!أعتذر على وقاحتي

296
00:18:49,640 --> 00:18:50,560
،مولاتي تاو ياو

297
00:18:50,810 --> 00:18:52,770
أنتِ جميلةٌ جدّاً وطيّبة القلب وماهرة في الطبّ

298
00:18:53,060 --> 00:18:55,560
تستحقّين اسم الشّافية الرّوحيّة العظمى

299
00:18:58,140 --> 00:18:59,770
شكراً لكِ على إنقاذ حياتي

300
00:19:00,720 --> 00:19:02,810
وشكراً لكِ على إنقاذنا جميعاً

301
00:19:04,520 --> 00:19:07,520
حسناً. ينشأ المرض من القلب

302
00:19:08,220 --> 00:19:09,930
،بما أنّني وعدتُ أن أعالجك

303
00:19:10,220 --> 00:19:12,140
فسوف أعالجك للأبد

304
00:19:16,640 --> 00:19:18,180
لكن لديّ قاعدة

305
00:19:18,640 --> 00:19:19,720
،إذا عالجتُك

306
00:19:20,020 --> 00:19:21,020
ستكون دوائي

307
00:19:21,680 --> 00:19:22,610
أرِني كفّك واختم

308
00:19:37,680 --> 00:19:38,970
الفكرة الخالدة

309
00:19:39,310 --> 00:19:40,810
تشبك كلّ شيء

310
00:19:45,270 --> 00:19:46,560
،باسم الجرس الذّهبيّ

311
00:19:47,390 --> 00:19:49,020
نمهّد لأعمال الخير

312
00:20:07,770 --> 00:20:09,930
آمانغ، كن حذراً

313
00:20:09,930 --> 00:20:11,350
لا تتأذّ

314
00:20:11,850 --> 00:20:13,020
لا تقلقي يا جدّتي

315
00:20:13,430 --> 00:20:14,840
قصب السّكّر ينمو بشكل جيّد

316
00:20:15,020 --> 00:20:17,720
في العام المقبل سوف تحصلين على عصير
قصب السّكّر الخاصّ بك

317
00:20:20,560 --> 00:20:22,890
حسناً

318
00:20:27,180 --> 00:20:28,850
حسناً. رأيتَ ما تريد رؤيته

319
00:20:29,520 --> 00:20:30,890
سيأتي ثور إلى هنا قريباً

320
00:20:33,970 --> 00:20:35,350
أميتافا

321
00:20:36,040 --> 00:20:37,600
انظري إليهما

322
00:20:37,890 --> 00:20:40,680
أظنّني أتفهّم مشاعر التنّين اللّطيف

323
00:20:41,220 --> 00:20:44,310
لكن لم أتوقّع أبداً أن تختار العودة إلى ثور

324
00:20:44,810 --> 00:20:45,560
يبدو أنّك توصّلتما إلى اتّفاق

325
00:20:46,230 --> 00:20:46,680
أجل

326
00:20:47,390 --> 00:20:48,270
اتّفقنا

327
00:21:05,680 --> 00:21:06,470
هيّا بنا

328
00:21:14,560 --> 00:21:15,560
ثور

329
00:21:17,270 --> 00:21:18,270
ماذا تريدين؟

330
00:21:20,770 --> 00:21:21,850
أنا تاو ياو من مدينة تاو

331
00:21:23,470 --> 00:21:25,060
إذاً أنتِ الطّبيبة الرُّوحيّة تاو ياو

332
00:21:25,810 --> 00:21:27,060
سمعتُ عنكِ

333
00:21:27,520 --> 00:21:28,930
،دعيني أحذّركِ

334
00:21:29,600 --> 00:21:32,270
يجدر بكِ أن تطيعي قواعد العالم البشريّ

335
00:21:33,020 --> 00:21:34,350
،وإلّا إذا عاقبتِكِ

336
00:21:35,060 --> 00:21:36,540
فلن تكون نهايتكِ سعيدة

337
00:21:37,890 --> 00:21:40,140
لستُ بحاجة لتنبيهك

338
00:21:40,770 --> 00:21:43,020
،دعني أحذّرك أنا

339
00:21:43,670 --> 00:21:45,140
حتّى لو كنتُم أنتم الجنّيون الرّسميّون
،تمتلكون قوّة عظيمة

340
00:21:45,330 --> 00:21:46,970
لا تستهينوا بالجنّيين الّذين تحت قيادتكم

341
00:21:47,560 --> 00:21:49,770
لا يمكنكم فعل شيء من دونهم

342
00:21:53,870 --> 00:21:54,470
،وثمّة أمر آخر

343
00:21:55,430 --> 00:21:56,680
،إذا أردت أن تطلق برقاً

344
00:21:56,890 --> 00:21:59,060
من فضلك انظر جيّداً. لا تؤذِ الأبرياء

345
00:22:00,070 --> 00:22:00,930
هل تعتقدين حقّاً

346
00:22:01,520 --> 00:22:03,100
بأنّ التنّين اللّطيف يستطيع الإفلات

347
00:22:03,600 --> 00:22:05,720
مراراً وتكراراً دون إذني؟

348
00:22:06,520 --> 00:22:07,390
هل تعتقدين حقّاً

349
00:22:07,850 --> 00:22:09,470
بأنّ التنّين اللّطيف يمكن أن يتأذّى

350
00:22:10,020 --> 00:22:11,720
متى أراد رغم إرادتي؟

351
00:22:12,470 --> 00:22:13,270
هل تعتقدين حقّاً

352
00:22:13,810 --> 00:22:15,520
بأنّني لا أعرف شيئاً؟

353
00:22:17,120 --> 00:22:18,520
،إله كان أم بشريّاً

354
00:22:19,100 --> 00:22:22,180
هناك دوماً وقت يكون فيه النموّ مطلوباً

355
00:22:22,850 --> 00:22:23,720
!تجاوزي الأمر فحسب

356
00:22:26,020 --> 00:22:27,970
لا تقسُ كثيراً على التنّين اللّطيف

357
00:22:28,220 --> 00:22:30,890
إنّه لطيفٌ جدّاً. إله أكثر اقتدارً من أيّ شخص آخر

358
00:22:31,720 --> 00:22:32,470
عودوا فحسب

359
00:22:32,680 --> 00:22:33,560
لا تقلقوا بشأني

360
00:22:33,860 --> 00:22:34,770
لستُ لطيفاً

361
00:22:52,640 --> 00:22:54,520
حسناً، دعني أسألك

362
00:22:55,450 --> 00:22:57,110
،لا تستطيع الرّؤية

363
00:22:57,600 --> 00:22:58,970
ولم تزرع قصبَ سكّر أبداً

364
00:22:59,720 --> 00:23:01,110
لماذا تحاول جاهداً؟

365
00:23:03,030 --> 00:23:05,310
كبرتُ دون أن أفعل أيّ شيء بصورة صائبة

366
00:23:05,870 --> 00:23:07,020
الجميع يقولون بأنّني عديم الجدوى

367
00:23:07,770 --> 00:23:09,020
،لكن أخبرَتْني جدّتي

368
00:23:09,430 --> 00:23:11,930
الجميع مفيدون في هذا العالم

369
00:23:12,680 --> 00:23:15,600
،لذا ارتأيتُ بأنّني إذا استطعتُ زراعة قصب سكّر

370
00:23:15,960 --> 00:23:18,470
فقد أثبت بأنّني مُفيد

371
00:23:21,220 --> 00:23:22,270
قد أكون أيضاً

372
00:23:23,140 --> 00:23:24,180
مفيداً

373
00:23:30,870 --> 00:23:31,600
،على الأقلّ

374
00:23:33,350 --> 00:23:35,680
حميتُ حقلَ قصب سكّر يعود لطفل

375
00:23:45,060 --> 00:23:52,850
♪ هناك مئات الوحوش ♪

376
00:23:53,350 --> 00:24:00,180
♪ الجميع يستطيعون التّمييز بين الخير والشرّ ♪

377
00:24:01,810 --> 00:24:09,470
♪ ليس للبشر إلّا قلب واحد ♪

378
00:24:10,060 --> 00:24:15,710
♪ لكنّه غير مُتوقَّع ♪

379
00:25:22,890 --> 00:25:24,560
أميتافا

380
00:25:24,930 --> 00:25:27,470
تعتمد البرَكة على فيما إذا كانت هناك عطايا

381
00:25:27,640 --> 00:25:30,640
إنّه مجرّد عمل

382
00:25:30,640 --> 00:25:33,520
من دون عاطفة، لا يمكنك أن تكون بوذا المُقدّس

383
00:25:34,100 --> 00:25:35,970
وجدَ التنّينُ اللّطيفُ الطّريقَ الصّواب

384
00:25:36,520 --> 00:25:38,640
غونغون، ما زلت بحاجة للعمل بجدّ

385
00:25:40,310 --> 00:25:43,560
حسناً، التنّين اللّطيف وثور غادرا

386
00:25:43,680 --> 00:25:44,430
هيّا بنا

387
00:25:50,470 --> 00:25:52,640
تاو ياو، لستِ على طبيعتكِ اليوم

388
00:25:53,930 --> 00:25:54,520
أنا؟

389
00:25:55,020 --> 00:25:57,930
أجل. نادراً ما تكشفي عن هويّتكِ

390
00:25:58,470 --> 00:26:00,060
بالإضافة إلى ذلك، أنتِ لطيفةٌ جدّاً هذه المرّة

391
00:26:00,520 --> 00:26:01,600
ما نيّتك؟

392
00:26:02,970 --> 00:26:05,310
!التنّين اللّطيف يعمل بجانب ثور

393
00:26:05,520 --> 00:26:06,970
ثور ذاك

394
00:26:07,130 --> 00:26:09,520
إنّه واحد من بين أوسم خمسة رجال في السّماء

395
00:26:09,810 --> 00:26:11,140
كيف لي أن أفوّت هذه الفُرصة؟

396
00:26:12,770 --> 00:26:16,390
إذاً تحاولين فعليّاً الإيقاع بثور؟

397
00:26:17,680 --> 00:26:19,180
إنّه ظريفٌ حقّاً

398
00:26:19,310 --> 00:26:22,310
!نظرته وقوامه ومشيته

399
00:26:22,680 --> 00:26:24,270
إنّه جذّاب جدّاً

400
00:26:24,270 --> 00:26:25,890
ماذا لو كان لا يحبّ النّساء؟

401
00:26:28,810 --> 00:26:29,810
لا فُرصة لديك أيضاً

402
00:26:29,810 --> 00:26:31,100
لستُ مهتمّاً بالرّجال

403
00:26:31,270 --> 00:26:32,270
اصمت

404
00:26:33,020 --> 00:26:35,140
هل تعلم ما إن كان لدى ثور حبيبة؟

405
00:26:35,770 --> 00:26:36,930
هل حفظَ اسمي؟

406
00:26:37,290 --> 00:26:38,720
الخالدون قد يتزوّجون أيضاً، صحيح؟

407
00:26:38,890 --> 00:26:40,140
أميتافا

408
00:26:40,560 --> 00:26:43,020
آنسة تاو ياو، عليكِ أن تتناولي دواء