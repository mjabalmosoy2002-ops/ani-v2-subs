1
00:00:49,160 --> 00:00:50,250
يبدو هذا مزعجاً

2
00:01:04,500 --> 00:01:07,620
ظننتُ بأنّنا سنترعرع ونكبر هكذا

3
00:01:18,290 --> 00:01:22,000
انظروا. يجب أن يكون هو الشّخص
التّالي الّذي يجب القضاء عليه

4
00:01:22,500 --> 00:01:24,040
يبدو هذا ضعيفاً جدّاً

5
00:01:25,000 --> 00:01:26,910
هل يجدر بنا أن نقضي عليه الآن؟

6
00:01:29,950 --> 00:01:32,160
لكنّني كبرتُ

7
00:01:37,540 --> 00:01:38,500
إنّما أخي لم يكبر

8
00:01:43,250 --> 00:01:46,040
يبدو وكأنّ زمنه قد توقّف

9
00:01:59,870 --> 00:02:03,580
لكن هذا غير مهمّ. سوف أحميه

10
00:02:05,450 --> 00:02:08,480
لكن محاربة مصير عشيرة شو هو

11
00:02:08,500 --> 00:02:12,160
أصعب بكثير ممّا توقّعت

12
00:02:16,330 --> 00:02:21,200
سوف أصبح أقوى وأحميه دون تردُّد

13
00:02:22,500 --> 00:02:28,120
،حتّى لو عنى ذلك التّضحية بحياتي
...لن أمانع، لأنّ

14
00:03:24,290 --> 00:03:26,040
صنع هذا القرار ليس سهلاً، صحيح؟

15
00:03:28,160 --> 00:03:29,540
مولاتي تاو ياو

16
00:03:29,870 --> 00:03:31,200
هيّا بنا. لنصعد البرج

17
00:03:50,120 --> 00:03:52,900
أيّتها الصّغيرة، إذا أردتِ تسلّق
البرج، فعودي في غضون أيّام قليلة

18
00:03:52,920 --> 00:03:55,700
لدينا عمل رسميّ هنا

19
00:03:59,040 --> 00:04:01,340
لم أركِ منذ وقت طويل يا مولاتي لينغشينغ

20
00:04:01,370 --> 00:04:03,620
هل العمل في قسم بيان الخاص بك
هو القبض على الوحوش؟

21
00:04:04,950 --> 00:04:06,450
أيُّها السيّد الصّغير، لم أرك منذ وقت

22
00:04:06,870 --> 00:04:09,190
الأمر من القائد هو تجهيز تشكيل
لإبادة الشّياطين

23
00:04:09,210 --> 00:04:11,080
في برج السّماء بعد ثلاثة أيّام

24
00:04:11,620 --> 00:04:15,540
،والآن تمّ تجهيز تشكيل متاهة
ولا أحد يستطيع الدّخول أو المغادرة

25
00:04:16,000 --> 00:04:19,700
كنتُ مُتمركِزة هنا ولا يُسمَح لأحد بالدّخول

26
00:04:20,410 --> 00:04:23,700
تشكيل متاهة؟ هل تستخدمين
برج السّماء كطعم؟

27
00:04:25,080 --> 00:04:27,360
،إذا كنتِ عليمة إلى هذا الحدّ
فلا بدّ أنّكِ تعلمين

28
00:04:27,380 --> 00:04:29,660
كيف مات أولئك في المدينة العاصمة

29
00:04:30,580 --> 00:04:33,300
،رفضتِ التدخُّل ومنعه من أذيّة مزيد من النّاس

30
00:04:33,320 --> 00:04:36,040
لكن ظللتِ تستخمينه لجذب مزيد من الوحوش

31
00:04:36,910 --> 00:04:39,950
يمكن إنقاذ الكثير من الأرواح
بالقضاء على وحش واحد

32
00:04:39,970 --> 00:04:42,700
على المدى الطّويل، قرارنا ليس خاطئاً

33
00:04:43,700 --> 00:04:47,120
،وبالنّسبة لأولئك الّذين ماتوا
كانوا مجرّد قرابين ضروريّة فحسب

34
00:04:48,830 --> 00:04:51,090
قسم بيان ماهر في الحسابات

35
00:04:51,110 --> 00:04:53,370
ماذا لو أصررتُ على تسلُّق البرج الآن؟

36
00:05:08,160 --> 00:05:08,790
احذري

37
00:05:20,540 --> 00:05:23,450
حلو كالعسل، سامّ كالزّرنيخ

38
00:05:24,750 --> 00:05:28,500
قدرتك على صنع سِهام من ماء
السكّر لا تزال لا نظير لها

39
00:05:29,410 --> 00:05:30,160
مولايّ

40
00:05:31,120 --> 00:05:35,580
يمكنك الدّخول. بوجودي هنا، يمكنك
الدّخول والذّهاب بحرّية

41
00:05:38,950 --> 00:05:41,160
...ينبغي أن تعلم قواعدنا يا مولايّ

42
00:05:41,870 --> 00:05:44,350
مولايّ الصّغير الثّاني، تعلم بأنّ أيّ شخص
يعرقل عملنا الرّسميّ

43
00:05:44,370 --> 00:05:47,370
يمكن التّعامل معه أوّلاً ثمّ الإبلاغ لاحقاً

44
00:05:49,000 --> 00:05:53,080
يبقى أسلوب قسم بيان نفسه

45
00:06:24,410 --> 00:06:25,200
أخي الأصغر

46
00:06:25,950 --> 00:06:29,870
.لا يمكنك القتال وأنت عديم الفائدة
لماذا عدت؟

47
00:06:30,330 --> 00:06:33,290
أردتُ... أردتُ فقط إنقاذك

48
00:06:34,290 --> 00:06:37,000
لستَ عديم الجدوى، لكنّك غبيّ أيضاً

49
00:06:38,160 --> 00:06:40,250
لا يستطيع تشكيل المتاهة حبسي هنا

50
00:06:40,280 --> 00:06:42,370
أحتاج بضعة أيّام فقط للرّاحة

51
00:06:43,250 --> 00:06:47,080
بضعة أيّام؟ تبدو واثقاً جدّاً

52
00:06:48,120 --> 00:06:51,450
من تعتقدين نفسكِ؟ كيف
تجرئين على توبيخي؟

53
00:06:53,450 --> 00:06:54,540
أنا من مدينة تاو

54
00:06:56,540 --> 00:06:58,120
الطّبيبة الرّوحيّة تاو ياو

55
00:06:58,790 --> 00:07:03,450
أجل. أتى أخوك إليّ وتوسّلني
من أجل علاج مرضك

56
00:07:05,700 --> 00:07:08,500
مرضك وهو قتل النّاس بجنون

57
00:07:11,620 --> 00:07:16,750
.خذي أخي عديم الجدوى بعيداً
أريد أن أتحادث معكِ

58
00:08:22,870 --> 00:08:25,180
مولايّ الصّغير الثّاني، من واجبنا
القضاء على الشّياطين

59
00:08:25,200 --> 00:08:27,950
لماذا تتدخّل؟

60
00:08:28,750 --> 00:08:30,940
قيل بأنّ بيان هو الابن السّابع للتنّين

61
00:08:30,970 --> 00:08:33,160
يبدو كنمر ذي مظهر مهيب

62
00:08:33,620 --> 00:08:35,900
،يقف خارج بوّابة السّجن

63
00:08:35,930 --> 00:08:38,160
،يطبّق العدالة ويقضي على الشرّ
دون تحيُّز أو انغماس

64
00:08:39,160 --> 00:08:42,110
،رغم أنّه يحمل نفس الاسم

65
00:08:42,130 --> 00:08:45,080
قسم بيان لا يمتلك نفس وقار
هذا المخلوق الإلهيّ

66
00:08:46,000 --> 00:08:48,280
،تعلمين بأنّه سيتمّ التّضحية بأرواح بريئة

67
00:08:48,300 --> 00:08:50,580
مع ذلك ما زلتِ تجذبين الشّياطين بواسطة البرج

68
00:08:51,080 --> 00:08:57,160
هل ما فعلتِه أفضل ممّا فعله المجنون شو هو؟

69
00:08:59,200 --> 00:09:04,120
غادرتَ قسم بيان سلفاً، فلماذا
تُزعج نفسك بهذه المسائل؟

70
00:09:07,250 --> 00:09:09,410
كُفّ عن إحداث جلبة. لا يمكنك
تقديم المساعدة على أي حال

71
00:09:09,950 --> 00:09:14,620
!اتركني. اتركني. أنت. اتركني

72
00:09:26,000 --> 00:09:27,830
أنتما فقط. أين تاو ياوياو؟

73
00:09:38,200 --> 00:09:41,390
يمكننا الآن التكلّم كما ينبغي

74
00:09:41,410 --> 00:09:44,450
،لكن بما أنّك لا تستطيع هزيمتي
يجب عليّ تشخيص حالتك أوّلاً

75
00:09:46,040 --> 00:09:48,370
أخبرني عن خطاياك

76
00:09:52,700 --> 00:09:54,330
عشتُ لخمسمئة عام

77
00:09:55,040 --> 00:09:57,580
،حملتُ ملايين الصّخور الثّقيلة

78
00:09:57,610 --> 00:10:00,580
لكن ولا واحدة منها ثقيلة كثِقَل الحياة

79
00:10:03,660 --> 00:10:07,500
أسقطتُ 42 شخصاً من السّماء

80
00:10:08,120 --> 00:10:12,290
مات عشرون شخصاً على حجر
دُمية ين حتّى اليوم

81
00:10:12,910 --> 00:10:16,150
لأنّني أتحمّل كلّ هذا تمكّنتُ من

82
00:10:16,170 --> 00:10:19,410
أن أصبح أقوى وأحمي حياة ذلك النّكرة

83
00:10:21,040 --> 00:10:23,120
هناك ما مُجمله 62 شخصاً، وقد سجّلتهم جميعاً

84
00:10:24,950 --> 00:10:27,550
عندما يقرع الجرس الذهبيّ، لن يبقى شيء

85
00:10:27,570 --> 00:10:30,160
لماذا لم تقرع الجرس؟

86
00:10:31,370 --> 00:10:34,660
أنت مستعجل على الموت. لا بدّ أنّك شُجاع

87
00:10:34,680 --> 00:10:36,490
قال أخوك بأنّك كنتَ أقوى

88
00:10:36,520 --> 00:10:38,330
منذ الطّفولة ولا تخشى شيئاً

89
00:10:44,080 --> 00:10:45,250
أخشى العواصف الرّعديّة

90
00:10:47,950 --> 00:10:49,630
،عندما كنّا صغيرين

91
00:10:49,660 --> 00:10:51,340
كان كلّ صيف في جبل وانجي
مليئاً بالعواصف الرّعديّة

92
00:10:51,360 --> 00:10:54,750
كنتُ خائفاً من ليالي العواصف الرّعديّة

93
00:10:56,080 --> 00:10:59,080
لكن كان يغنّي لي ويرافقني

94
00:11:03,000 --> 00:11:04,660
كنتُ خائفاً من الموت بعد ذلك

95
00:11:06,250 --> 00:11:11,790
كما تعلمين، بعد إنجابنا، غادرت أمّي جبل وانجي

96
00:11:12,620 --> 00:11:16,330
وتوأمان أمثالنا نادرون جدّاً

97
00:11:17,370 --> 00:11:20,750
بين الوحوش، نحن شو هو عشيرة بدائيّة

98
00:11:21,790 --> 00:11:26,290
لا نمتلك جمالاً أخّاذاً ولا نمتلك مهارات قويّة

99
00:11:27,450 --> 00:11:32,120
في التّحليل الأخير، لا نمتلك سوى
القوّة الخالصة والعمر المديد

100
00:11:32,950 --> 00:11:36,340
نحمل الأشياء ونراكم القوّة ونتجنّب
تصنيفنا في المركز الأخير

101
00:11:36,360 --> 00:11:39,750
تتكرّر الدّورة مراراً

102
00:11:41,200 --> 00:11:45,500
معظم الوقت، نعيش في عزلة شديدة

103
00:11:46,870 --> 00:11:48,910
شو هو هو وحش انعزاليّ بعض الشّيء

104
00:11:49,790 --> 00:11:53,910
وُلِدَ هذا الشّخص معي في هذا العالم

105
00:11:54,700 --> 00:11:58,830
نلعب معاً في النّهار وننام
جنباً إلى جنب في اللّيل

106
00:12:01,410 --> 00:12:06,580
عندما يكون حيّاً، لا تستطيع الوحدة هزيمتي

107
00:12:08,120 --> 00:12:12,620
الزّمن طويل جدّاً، لذا يجب عليّ حمايته

108
00:12:13,750 --> 00:12:15,450
حماية أخي الوحيد

109
00:12:16,330 --> 00:12:18,540
لذلك قتلتَ كثيراً من النّاس

110
00:12:18,830 --> 00:12:22,040
يجب عليّ تعزيز قوّتي لمقاتلة لجنة الحكم

111
00:12:22,410 --> 00:12:24,940
،حتّى لو قتلتُ كلّ النّاس في هذه المدينة

112
00:12:24,960 --> 00:12:27,830
أو كلّ النّاس في العالم، فلن أتردّد

113
00:12:28,450 --> 00:12:31,290
يمكنني فعلها تماماً الآن

114
00:12:32,620 --> 00:12:33,870
لكنّه لا يحتاج ذلك

115
00:12:34,620 --> 00:12:40,120
لماذا لا يحتاج؟ إنّه صغير وضعيف
وعديم الجدوى أيضاً

116
00:12:42,410 --> 00:12:45,290
إنّه أقوى بكثير ممّا تعتقد

117
00:12:45,950 --> 00:12:50,700
في غيابك، رتّبَ كلّ شيء ونظّمه سلفاً

118
00:12:51,790 --> 00:12:54,620
حتّى حجر دُمية ين على ظهرك غير مستثنى

119
00:12:55,950 --> 00:12:57,040
...ما

120
00:13:04,750 --> 00:13:07,530
هذا مُزعج. حتّى لو قتلت أخاه

121
00:13:07,550 --> 00:13:10,330
،وأخرجت حجر دُمية ين من جسده

122
00:13:10,830 --> 00:13:12,980
،ستختفي قوّةُ الحجر لبعض الوقت كأقصى حدّ

123
00:13:13,010 --> 00:13:15,160
وسرعان ما سوف تُسترجَع بعدها

124
00:13:16,000 --> 00:13:19,320
هذا الحجر عنيد بالفطرة. لا يمكن كسره أو حرقه

125
00:13:19,340 --> 00:13:22,660
كم شخصاً إضافيّاً يجب أن يموت إذا
بقي الحجر في برج السّماء؟

126
00:13:27,000 --> 00:13:29,250
أما... أما من طريقة لحلّه؟

127
00:13:29,950 --> 00:13:33,190
،بلى. هناك طريقة وحيدة لإيقاف قوّته الشرّيرة

128
00:13:33,210 --> 00:13:36,250
وهي إعادته إلى جبل وانجي

129
00:13:43,160 --> 00:13:45,810
من يستطيع إعادته إلى جبل وانجي؟

130
00:13:45,830 --> 00:13:48,290
،حالما يلمسك هذا الشّيء الشّبحيّ
لا يمكن أن تتفرّقا ثانية أبداً

131
00:13:49,000 --> 00:13:52,250
يجب على الشّخص الّذي يعيد الحجر
أن يلزم مكانه طيلة العمر

132
00:13:52,280 --> 00:13:55,540
حينئذ يمكن حلّ هذه المسألة فقط

133
00:13:58,040 --> 00:13:58,750
سوف أفعلها أنا

134
00:13:59,830 --> 00:14:04,290
شو هو، أيمكنك فعلها؟ وهل ما زلت
تستطيع الطّيران بمثل هذه الجروح الخطيرة؟

135
00:14:04,870 --> 00:14:07,120
بالطّبع أستطيع. انظر إليّ

136
00:14:10,080 --> 00:14:11,980
دواء تاو ياو فعّال جدّاً

137
00:14:12,000 --> 00:14:14,200
في غضون سويعات، أستطيع التّحليق ثانية

138
00:14:18,410 --> 00:14:19,540
شو هو

139
00:14:20,000 --> 00:14:22,950
جبل وانجي ذاك بعيد جدّاً. هل أنت
متأكّد من أنّك تريد الذّهاب؟

140
00:14:23,410 --> 00:14:26,950
أريد الذّهاب. هناك وُلِدتُ والمكان مألوف لديّ

141
00:14:27,200 --> 00:14:30,910
فضلاً عن ذلك، أستطيع حمل ذلك الحجر
والتّحليق لأطول مسافة ممكنة

142
00:14:32,160 --> 00:14:37,120
مولانا الصّغير يقصد أنّك حالما تصل
إلى هناك، لن تتمكّن من المغادرة أبداً

143
00:14:38,620 --> 00:14:41,740
أعي ذلك، لكن ما زلتُ أريد الذّهاب

144
00:14:41,770 --> 00:14:44,830
فأساساً، لم أحظَ بفُرصة لحمل
شيء ثقيل جدّاً من قبل

145
00:14:54,500 --> 00:14:58,040
في هذه الحالة، لن أشعر بالدّونيّة أمام نظرائي

146
00:15:00,540 --> 00:15:04,410
حسناً، سأعالج مرضَ أخيك

147
00:15:14,160 --> 00:15:17,790
لا تقلق. أخوك أقوى بكثير ممّا تعتقد

148
00:15:21,700 --> 00:15:24,310
،القدرة على رؤيتها من جديد

149
00:15:24,340 --> 00:15:27,500
،برؤيتها سعيدة وبصحّة سليمة
أكون قد حقّقتُ أمنيتي

150
00:15:28,040 --> 00:15:30,790
شكراً لك أيُّها الوحش النّبيل

151
00:15:38,620 --> 00:15:41,150
،رغم أنّه حملَ أرواحَ مثلك

152
00:15:41,170 --> 00:15:43,700
يستطيع جعل الميّت يبتسم هكذا

153
00:15:44,790 --> 00:15:47,620
إنّه يحمل عبئاً ثقيلاً، ليس خفيفاً على الإطلاق

154
00:15:53,830 --> 00:15:55,450
هل سمعتِ تلك الأغنية؟

155
00:15:56,410 --> 00:16:01,910
قال أخي بأنّها أغنية قديمة جدّاً

156
00:16:03,540 --> 00:16:08,580
سمعتُها. إنّها أغنية عن الأخوّة

157
00:16:30,120 --> 00:16:31,910
منحتني الإكسير هكذا

158
00:16:32,370 --> 00:16:35,950
إذا متُّ، سيزول الإكسير أيضاً

159
00:16:36,580 --> 00:16:40,410
من الأفضل أن أبصقه الآن وتعطيه إيّاه

160
00:16:41,790 --> 00:16:47,160
إذا أكل خُلاصتي، ربّما يستطيع
كسب بعض القوّة

161
00:16:47,950 --> 00:16:51,110
بهذه الخُلاصة، حتّى لو متّ، على الأقلّ
،روحك لن تتفرّق

162
00:16:51,140 --> 00:16:54,660
وقد تكون هناك فُرصة لإعادة الولادة

163
00:16:55,910 --> 00:16:57,250
...لكن إذا فقدتها

164
00:17:01,040 --> 00:17:02,700
لم يفت الأوان على ابتلاعها من جديد الآن

165
00:17:04,540 --> 00:17:11,450
.وحش مثلي شارف على نهايته
ينبغي أن تصفّقي

166
00:17:14,080 --> 00:17:16,860
،بالطّبع، لا أتعاطف معك إطلاقاً

167
00:17:16,880 --> 00:17:19,660
لكنّني لا أكرهك أيضاً

168
00:17:20,540 --> 00:17:23,520
أشعر فقط بأنّك لست أذكى من أخيك بكثير

169
00:17:23,540 --> 00:17:27,000
كلاكما أخوان حقيقيّان بالفعل

170
00:17:31,040 --> 00:17:32,830
هل تريد أن توجّه كلمة لأخيك؟

171
00:17:33,620 --> 00:17:39,000
لا حاجة. عالجتِ مرضي، لكن لا أستطيع
أن أصبح دواءكِ

172
00:17:40,160 --> 00:17:42,750
خسرتِ قليلاً

173
00:18:11,830 --> 00:18:13,370
أردت قتله؟

174
00:18:17,250 --> 00:18:18,910
سأقتلك أوّلاً

175
00:18:52,080 --> 00:18:55,080
تاو ياو. شكراً لكِ. قوّة حجر
دُمية ين قد زالت الآن

176
00:18:55,100 --> 00:18:58,450
سوف أعيدها إلى جبل وانجي في أسرع وقت

177
00:18:59,540 --> 00:19:02,870
ابتلع الخُلاصة وذلك كي تتمكّن
من التّحليق وتوفّر بعض الجهد

178
00:19:05,120 --> 00:19:06,660
هذا أخي الأصغر

179
00:19:11,250 --> 00:19:13,920
،على الرّغم من ذلك

180
00:19:13,940 --> 00:19:16,950
ساهمتُ أيضاً في معالجة جروحك
وحرقتَ المال لأجلي

181
00:19:17,450 --> 00:19:21,450
لذا ما زال عليك اتّباع قواعدي. اختم

182
00:19:22,450 --> 00:19:26,830
شكراً لكِ، سأعيش وأصمد حتّى
يأتي اليوم الّذي تحتاجينه فيه

183
00:19:33,870 --> 00:19:36,280
حسناً، حُسِم الأمر. ربّما عندما
،أحظى بوقت ذات يوم

184
00:19:36,300 --> 00:19:38,700
سأذهب إلى ذلك المكان وأُخرجك

185
00:19:40,080 --> 00:19:42,830
حسناً، سوف أكون بانتظاركِ
يا مولاتي تاو ياو

186
00:19:49,700 --> 00:19:52,500
أتمنّى لك رحلة موفّقة يا شو هو

187
00:20:10,120 --> 00:20:13,370
تدمير التّشكيل. تحرير الشّيطان

188
00:20:13,400 --> 00:20:16,580
عرّضتَ قسم بيان لمُعضلة

189
00:20:18,660 --> 00:20:21,250
ما زال قصر سي في نهر تشينمينغ

190
00:20:21,280 --> 00:20:23,870
إذا كانت هناك أي حسابات تحتاج
للتّسوية، فسأنتظر وصولك

191
00:20:36,290 --> 00:20:37,580
...قسم بيان

192
00:20:38,000 --> 00:20:40,570
ما الّذي تفكّرين فيه؟ عودي بسرعة

193
00:20:40,590 --> 00:20:43,160
من الأفضل تناول الوجبة باكراً. أتضوّر جوعاً

194
00:20:46,370 --> 00:20:49,500
لانلان، أنا جائع. لم أعد قادراً على المشي

195
00:20:49,530 --> 00:20:52,660
لِمَ لا نستأجر عربة للذّهاب إلى الدّيار؟
طريق العودة طويل جدّاً

196
00:20:53,950 --> 00:20:57,360
أرى بأنّ جميعكم بمعنويات عالية

197
00:20:57,380 --> 00:21:00,790
ولديكم متّسع من الوقت لمساعدة
الآخرين. لذا يمكنكم التروّي في العودة

198
00:21:01,660 --> 00:21:02,620
...هذا

199
00:21:05,540 --> 00:21:08,680
بالمناسبة، لماذا ساعدت شو هو؟

200
00:21:08,710 --> 00:21:11,790
لا تبدو من النّوع الّذي يتعاطف مع وحوش

201
00:21:19,750 --> 00:21:21,660
لأنّ لديّ أيضاً أخ غير مؤتمن

202
00:21:35,200 --> 00:21:38,620
من كان يتوقّع أن تُحمَى هذه الحياة
اليوميّة الهادئة والحيويّة

203
00:21:39,370 --> 00:21:42,290
بواسطة وحش صغير ضعيف؟

204
00:21:44,750 --> 00:21:47,190
،حتّى لو كنّا لن نلتقي ثانية

205
00:21:47,220 --> 00:21:49,660
أشكرك بالنّيابة عن سكّان هذه المدينة