1
00:00:39,410 --> 00:00:43,160
بضع قطع من المشويّات. متى
أصبحتْ عديمة المنال؟

2
00:00:43,410 --> 00:00:47,330
،لا ينبغي طبخ المشويّات قبل شيّها
والتّوابل ينبغي أن تكون معقولة

3
00:00:48,040 --> 00:00:51,450
إذا لمسته بعيدان طعامك، سوف تفسده

4
00:00:55,700 --> 00:00:58,160
سيّدي الصّغير الثّاني، أعتقد
بأنّ اللّحم جاهز

5
00:00:58,910 --> 00:01:00,080
ننتظر عشر ثوانٍ أخرى

6
00:01:22,410 --> 00:01:24,910
دعني أريك كم أنا مذهلة

7
00:01:57,040 --> 00:01:59,040
ماذا؟ لم تعودي ترغبين الأكل؟

8
00:02:04,540 --> 00:02:05,330
حسناً

9
00:02:11,080 --> 00:02:13,040
إنّها حقّاً أطعمة شهيّة

10
00:02:14,910 --> 00:02:15,700
اسكب لي

11
00:02:16,910 --> 00:02:19,420
كيف لي أنا، بمكانة كهذه، أن أتشاجر
على قطعة لحم مشويّ؟

12
00:02:19,440 --> 00:02:21,950
ستتشوّه سمعتي إذا عَلِمَ الآخرون

13
00:02:24,040 --> 00:02:24,910
أنتم

14
00:02:31,790 --> 00:02:33,660
لا تلوموني على وقاحتي

15
00:02:34,790 --> 00:02:38,290
اهدئي. لا تتشاجري على مجرّد
قطعة لحم مشويّة

16
00:02:38,290 --> 00:02:39,040
ابتعد عن وجهي

17
00:02:51,160 --> 00:02:54,210
،موظّفون عديمو الضّمير يسيئون معاملة الآخرين

18
00:02:54,240 --> 00:02:57,290
لا يمنحونهم ما يكفي من طعام حتّى

19
00:02:59,080 --> 00:03:02,410
مأساة كهذه تحدث في عصر سعيد كهذا

20
00:03:02,950 --> 00:03:07,040
هذا يُغضب السّماوات. هذا مؤثِّر حقّاً

21
00:03:08,080 --> 00:03:10,830
لكن "مؤثّر" ليست كلمة مناسبة هنا

22
00:03:10,830 --> 00:03:15,660
أيّاً يكن! يا إلهي، أنا تعيسة الحظّ

23
00:03:16,330 --> 00:03:20,160
سي كانغلان يبدو كبشريّ لكن
لا يتصرّف مثل البشر

24
00:03:21,790 --> 00:03:24,270
هذه الطّفلة. تاو ياوياو، انهضي أوّلاً

25
00:03:24,300 --> 00:03:26,790
الأرض باردة. احرصي على ألّا تُصابي بنزلة برد

26
00:03:30,160 --> 00:03:32,960
المُضيف مياو، لا لحم، لا نهوض

27
00:03:32,990 --> 00:03:35,790
لا اعتذار من سي كوانغلان، لا نهوض

28
00:03:36,410 --> 00:03:38,950
طعام عائلة سي ليس مجّانيّاً

29
00:03:40,160 --> 00:03:44,040
.سؤال واحد، قطعة واحدة من اللّحم
أسأل، فتُجيبين

30
00:03:44,660 --> 00:03:45,450
تسأل؟

31
00:03:46,660 --> 00:03:53,580
لا تتستّري. لا تلفّقي. من أنتِ؟

32
00:04:02,330 --> 00:04:05,160
هل تعلم مع من تتحدّث؟

33
00:05:06,660 --> 00:05:09,910
المُضيف مياو، لماذا تهتمّ بغابة الخوخ هذه؟

34
00:05:11,290 --> 00:05:15,950
لكلّ شيء مشاعر. السيّد السّابق
وزوجته قد زرعاها

35
00:05:16,790 --> 00:05:20,040
أشجار الخوخ هنا أكبر عمراً من السيّدين الصّغيرين

36
00:05:22,040 --> 00:05:27,450
يبدو أنّ والديهما كانا يحبّان أزهار الكرز
،حقّاً، لكن لا أحبّها

37
00:05:27,910 --> 00:05:30,590
لا سيّما عند المقامرة مع الآخرين

38
00:05:30,610 --> 00:05:33,290
أزهار الخوخ تمثّل فقدان المال

39
00:05:33,290 --> 00:05:35,910
أنتِ ثرثارة يا فتاة

40
00:05:36,290 --> 00:05:39,670
المُضيف مياو، كشفتُ سلفاً عن هويّتي

41
00:05:39,690 --> 00:05:42,790
ألستَ خائفاً؟ ربّما نكون وحوشاً

42
00:05:44,290 --> 00:05:46,540
الوحوش ليست الأكثر رُعباً

43
00:05:46,790 --> 00:05:51,660
،أعرف فقط بأنّكِ عندما تكونين في قصر سي
تكون تاو ياوياو الّتي عهِدتُها

44
00:05:52,080 --> 00:05:54,660
سأترك كلّ الطّعام اللّذيذ والمرح لكِ

45
00:05:56,540 --> 00:05:59,210
المُضيف مياو، أنت لطيف

46
00:05:59,240 --> 00:06:01,910
،قد يبدو بعض النّاس لطيفين
لكن لماذا هم لئيمون جدّاً؟

47
00:06:05,290 --> 00:06:07,160
هل تعرف مع من تتكلّم؟

48
00:06:09,580 --> 00:06:12,540
الفتاة تُطعم خيولي. ما الأمر؟

49
00:06:12,540 --> 00:06:13,290
!أنت

50
00:06:19,830 --> 00:06:20,660
...أنا

51
00:06:22,450 --> 00:06:27,500
نادراً ما أرى شابّاً يكسر غطرسة تاو ياو

52
00:06:28,000 --> 00:06:31,010
يا إلهي. ظننتُ أنّ ذاك الشّخص
هو الوحيد الّذي يستطيع فعل ذلك

53
00:06:31,040 --> 00:06:34,500
كبير قصر سي رهيب حقّاً

54
00:06:38,540 --> 00:06:40,370
ماذا يجدر بي أن أفعل؟ أعترف؟

55
00:06:40,540 --> 00:06:45,410
حمقاء. هل نسيتِ سبب مجيئكِ إلى العاصمة؟
!مذكّرات الجنّيات

56
00:06:46,000 --> 00:06:47,040
ما خطب مذكّرات الجنّيات؟

57
00:06:47,040 --> 00:06:52,370
أضاعَتْها؟ لذا لِمَ لا تعترف لعائلة سي الآن؟

58
00:06:52,540 --> 00:06:56,250
،إذا أرادوا تقديم المساعدة مستقبلاً
ستزداد فُرص نجاحكِ كثيراً

59
00:06:56,910 --> 00:07:00,750
يستطيع قصرُ سي تصحيح الأمور. ربّما
يمكنهم حلّ مُعضلتكِ الكبيرة

60
00:07:01,410 --> 00:07:03,870
لِمَ أبدو حمقاء فجأة؟

61
00:07:09,120 --> 00:07:11,630
أنا تاو ياو من مدينة تاو

62
00:07:11,650 --> 00:07:14,160
أمارس الطبّ لمعالجة الشّياطين، لا البشر

63
00:07:15,040 --> 00:07:16,000
مدينة تاو؟

64
00:07:17,410 --> 00:07:19,660
لم أسمع بها من قبل

65
00:07:21,250 --> 00:07:24,480
العالم الإلهيّ فوق العالم البشريّ

66
00:07:24,510 --> 00:07:27,750
،يحتوي على العالم السّماويّ وجماعة كونلون
يتعاونون على حماية سلام العالم

67
00:07:28,540 --> 00:07:31,710
مدينة تاو كائنة في مكان مستقلّ
خارج العوالم الثّلاثة

68
00:07:31,740 --> 00:07:34,910
تحكم الوحوشَ فقط، دون سؤال عن أمور أخرى

69
00:07:38,330 --> 00:07:41,410
إنّها حتماً غير موجودة في أيّ مكان تعرفه

70
00:07:42,250 --> 00:07:46,870
لستُ موهوبة، لكن ينادينني الوحوش
بطبيبة مدينة تاو

71
00:07:50,620 --> 00:07:53,620
لذا شرف عظيم لك أن تستضيفنا في قصرك

72
00:07:54,120 --> 00:07:57,750
من فضلك احترمني واعجب بي
في المستقبل، مفهوم؟

73
00:08:01,290 --> 00:08:05,750
لم أرَ الشّرف، لكن رأيتُ شهيّتك المفتوحة

74
00:08:06,790 --> 00:08:07,620
!أنت

75
00:08:08,370 --> 00:08:10,650
في قلبي، لا فرق بين

76
00:08:10,670 --> 00:08:12,790
الآلهة والخالدين والشّياطين والوحوش

77
00:08:13,250 --> 00:08:17,250
،سلالة سي لا يحكمون بالخلفيّات
بل بالصّواب والخطأ

78
00:08:19,410 --> 00:08:21,620
سأقبل إجابتكِ هذه حاليّاً

79
00:08:22,250 --> 00:08:26,790
إن كنتِ تخفين حقيقةً أخرى، فمن
فضلكِ ابحثي عن مكان آخر

80
00:08:29,500 --> 00:08:34,410
هل تفهمين؟ تفهمين؟

81
00:08:39,620 --> 00:08:41,120
هذا الرّجل الكريه

82
00:08:42,370 --> 00:08:44,500
المُضيف. المُضيف مياو

83
00:08:45,540 --> 00:08:46,910
لِمَ الهلع؟

84
00:08:46,910 --> 00:08:49,130
المُضيف مياو، في هذا الصّباح، كانت
هناك فتاة غريبة

85
00:08:49,150 --> 00:08:51,370
أرادت رؤية سيّدينا الصّغيرين

86
00:08:51,370 --> 00:08:54,910
رفضنا السّماح لها بالدّخول، لكن
أوسعَتْنا ضرباً ودخلَتْ عنوة

87
00:08:55,620 --> 00:08:59,120
طاردناها إلى غابة الخوخ، لكن
اختفَتْ دون أثر

88
00:08:59,870 --> 00:09:01,120
أوسعتكم ضرباً؟

89
00:09:03,620 --> 00:09:07,070
كيف تعجزون عن إيقاف فتاة صغيرة؟
اجمعوا مزيداً من الرّجال

90
00:09:07,090 --> 00:09:10,540
.فتّشوا كلّ زاوية من زوايا القصر
لا تتركوا مكاناً بلا تفتيش

91
00:09:11,000 --> 00:09:11,790
حاضر

92
00:09:13,870 --> 00:09:16,500
المُضيف مياو، لا تستهن بالفتاة الصّغيرة

93
00:09:18,750 --> 00:09:23,370
تاو ياوياو، رغم أنّكِ تبدين كفتاة
...صغيرة، في الواقع

94
00:09:24,620 --> 00:09:27,620
أعلم بأنّك تعتقد بأنّني وحش عجوز

95
00:09:28,750 --> 00:09:34,250
حسناً، حسناً. ستبقين دوماً فتاة صغيرة حلوة

96
00:09:34,870 --> 00:09:36,120
سأذهب وأبحث في مكان آخر

97
00:09:36,540 --> 00:09:42,750
.انتظر لحظة يا حضرة المُضيف مياو
هل تزرع أشجار خوخ فقط في الغابة؟

98
00:09:43,370 --> 00:09:46,040
بما أنّها غابة خوخ، فمن الطبيعيّ
أن تُزرَع أشجار خوخ فقط

99
00:09:46,790 --> 00:09:47,750
ما هذا إذاً؟

100
00:09:48,660 --> 00:09:49,660
شجرة قيقب؟

101
00:09:51,000 --> 00:09:54,500
قبيحة وقرعاء. لم يبقَ منها
سوى ورقتين أو ثلاث

102
00:09:55,000 --> 00:09:56,660
أنتِ قبيحة. أنتِ الأقبح

103
00:09:59,120 --> 00:10:01,910
،على أيّ حال، أنتِ شبه قرعاء
لذا دعيني أساعدكِ

104
00:10:11,060 --> 00:10:13,000
...هذا... هذا

105
00:10:20,370 --> 00:10:24,120
تاو ياوياو، لم تكوني غاضبة للتو، صحيح؟

106
00:10:25,370 --> 00:10:27,790
اهربي. لنرَ إلى أي مدى يمكنكِ الهرب

107
00:10:37,700 --> 00:10:42,870
،أنتِ... من تكونين؟ حرّريني بسرعة
وإلّا فلن أعفو عنكِ

108
00:10:45,620 --> 00:10:46,750
من أكون؟

109
00:10:47,750 --> 00:10:52,000
لا أعرف من تكونين. قطعتُ كلّ الطّريق
إلى هنا كي لا أراكِ

110
00:10:53,290 --> 00:10:55,040
لا تعلمين حقّاً من أكون؟

111
00:10:55,250 --> 00:10:57,300
وما أدراني بكِ؟

112
00:10:57,320 --> 00:10:59,370
أخرجيني بسرعة. أريد رؤية السيّد سي

113
00:11:01,750 --> 00:11:03,750
إنّها صغيرة جدّاً. لم ترَ العالم

114
00:11:03,870 --> 00:11:05,370
حسناً، فهمت

115
00:11:05,870 --> 00:11:08,540
أخرجيني بسرعة. لديّ سؤال أطرحه

116
00:11:09,410 --> 00:11:12,020
لكن يا فتاة، يجب أن تسلّمي بطاقة

117
00:11:12,040 --> 00:11:15,160
تصرّح عن خلفيّتكِ وأصولكِ

118
00:11:15,250 --> 00:11:17,750
حينئذ يستطيع أن يقرّر فيما إذا كان يستطيع رؤيتكِ

119
00:11:18,790 --> 00:11:21,570
بطاقة؟ لم يخبرني أحدٌ عن الأمر

120
00:11:21,590 --> 00:11:24,370
لا أعرف كيف أقرأ أو أكتب أي بطاقة

121
00:11:25,660 --> 00:11:28,880
هذه غلطتي. غلطتي هي عدم الاستعلام بوضوح

122
00:11:28,900 --> 00:11:32,120
ماذا يجدر بي أن أفعل إذا لم أستطع
رؤية السيّد سي؟

123
00:11:33,160 --> 00:11:36,250
هم... جميع النّاس في قريتي سيموتون

124
00:11:45,250 --> 00:11:50,500
.شين فينغ؟ أنتِ حقّاً لا تُجيدين القراءة
ما هو طلبكِ؟

125
00:11:51,790 --> 00:11:55,250
شكراً على قبولي هنا. أنا من قرية
هويلونغ من موزو

126
00:11:55,750 --> 00:11:58,790
تعتمد قريتنا على نهر جينلين

127
00:11:58,810 --> 00:12:01,750
بسبب الجفاف الشّديد، كاد نهر
جينلين يجفّ في العام الماضي

128
00:12:02,620 --> 00:12:05,440
،أردتُ ماء من نهر بايتشي القريب

129
00:12:05,470 --> 00:12:08,290
لكن الوحوش فيه أصابوني بجروح بليغة

130
00:12:08,660 --> 00:12:12,370
فاضطررتُ لطلب مساعدتك. أرجوك أنقذ الجميع

131
00:12:14,000 --> 00:12:16,820
عرفتُ أنّ هذا الوحش الصّغير

132
00:12:16,850 --> 00:12:20,160
لن يطلب طلباً جللاً، لكنّها عاجزة تماماً

133
00:12:21,370 --> 00:12:23,670
أي وحش يرغب في العمل

134
00:12:23,700 --> 00:12:26,000
لصالح أهل القرية هو وحش جيّد

135
00:12:28,410 --> 00:12:29,370
سيّدي الصّغير الثّاني؟

136
00:12:43,500 --> 00:12:46,000
أريدك فقط إخضاع شيطان النّهر ذاك

137
00:12:46,030 --> 00:12:48,540
هل أنت غير راغب في التدخُّل
بمسألة تافهة كهذه؟

138
00:12:48,910 --> 00:12:52,190
ضع نفسك مكاننا. كيف تتحمّل

139
00:12:52,220 --> 00:12:55,500
رؤيتنا نعاني بينما عائلتك تعيش بسعادة؟

140
00:12:55,870 --> 00:13:00,120
أنتِ، الوحش، تقاتلين ضدّ وحوش
أخرى لأجل البشريّة

141
00:13:00,870 --> 00:13:02,870
لكن جميعهم عائلتي

142
00:13:06,620 --> 00:13:09,160
تتساقط الثّلوج بالفعل في موزو، أليس كذلك؟

143
00:13:12,290 --> 00:13:15,010
الطقس بارد جدّاً. ينبغي أن أبقى في مكان دافئ

144
00:13:15,030 --> 00:13:17,620
أثناء الشّتاء. آسف، لا أستطيع مساعدتكِ

145
00:13:19,410 --> 00:13:21,910
أنت! ما سببك بالضّبط؟

146
00:13:22,540 --> 00:13:24,500
المُضيف مياو، من فضلك أوصل الضّيفة للخارج

147
00:13:27,250 --> 00:13:29,120
يا آنسة، تفضّلي لو سمحتِ

148
00:13:31,000 --> 00:13:34,250
لم يعد أحدٌ قادراً على مساعدتي يا سيّد سي

149
00:13:34,660 --> 00:13:37,650
،إذا لم أستطع هزيمة ذلك الوحش

150
00:13:37,670 --> 00:13:41,120
سيجفّ النّهر كلّياً وستموت كافّة أفراد عائلتي

151
00:13:41,500 --> 00:13:43,640
إنَّ حفر قناة لحرف الماء من أجل الريّ

152
00:13:43,670 --> 00:13:45,620
هو ما ينبغي أن تفعله الحكومة المحلّية

153
00:13:46,120 --> 00:13:48,870
حريّ بكِ أن تعودي وتفكّري في طريقة أخرى

154
00:13:50,290 --> 00:13:51,250
سيّدي الصّغير سي

155
00:13:51,410 --> 00:13:53,370
الآنسة شين، عودي

156
00:14:32,370 --> 00:14:38,660
دعني. لن أدعهم يموتون. أنقذهم، أنقذهم

157
00:15:02,620 --> 00:15:07,410
أرجوكِ، أرجوكِ، أرجوكِ أنقذي أخي

158
00:15:08,870 --> 00:15:14,000
اذهبي فحسب. إنّه عنيد كالحمار وكلامه قاسٍ

159
00:15:14,410 --> 00:15:16,190
،حتّى لو شنقتِ نفسكِ أمامه

160
00:15:16,220 --> 00:15:18,000
غالباً سيستدعي شخصاً ليشنقكِ

161
00:15:21,790 --> 00:15:25,540
المُضيف مياو، هل تعتقد بأنّها ستُمطر اليوم؟

162
00:15:27,200 --> 00:15:29,910
تبدّدت غيوم المطر. غالباً لن تُمطِر

163
00:15:49,250 --> 00:15:51,940
هذا غريب. لماذا هذه الأمطار لا تهطل
إلّا في قصر سي؟

164
00:15:51,970 --> 00:15:54,660
لا يوجد غيوم في أي مكان آخر

165
00:15:55,000 --> 00:15:57,870
لعلّ السيّد الصّغير الثّاني يحلّ مشكلة ثانية

166
00:16:05,500 --> 00:16:08,360
لولا شخص عديم الرّحمة، لما تبلّلت

167
00:16:08,380 --> 00:16:11,250
فواكهي المُجفّفة في فناء المطبخ الخلفيّ

168
00:16:12,370 --> 00:16:14,000
هذا يفطر القلب

169
00:16:14,750 --> 00:16:19,790
قالت الفتاة الصّغيرة بأنّنا إن لم نقدّم
المساعدة، فلن تتوقّف هذه الأمطار

170
00:16:20,410 --> 00:16:23,660
استخدمَتْ قصرَ سي لتهديدي، لذا
هل عليّ موافقتها؟

171
00:16:24,540 --> 00:16:26,750
.عليك الذّهاب، يمكنني الذّهاب
إنّها مجرّد مسألة تافهة

172
00:16:26,780 --> 00:16:29,000
لِمَ تعقّد الأمور عليها؟

173
00:16:29,250 --> 00:16:31,870
حتّى لو كانت وحشاً، تبقى فتاة صغيرة

174
00:16:33,620 --> 00:16:34,080
كُل

175
00:16:34,080 --> 00:16:34,410
...هذا

176
00:16:34,410 --> 00:16:35,500
أسرع وكُل

177
00:16:37,160 --> 00:16:38,160
أنتِ من حرّض على ذلك؟

178
00:16:38,660 --> 00:16:42,540
كيف أجرؤ؟ دردشتُ معها حول خلفيّتها فقط

179
00:16:43,250 --> 00:16:44,040
من تكون؟

180
00:16:44,410 --> 00:16:48,750
كتُب الجنّيات... أقصد ورد في الكتُب
القديمة بأنّ أشجار القيقب

181
00:16:49,040 --> 00:16:51,190
الّتي يزيد عمرها عن 100 سنة
ستكسب جوهر العالم

182
00:16:51,220 --> 00:16:53,370
تحتها، لا بدّ من وجود كائن قيقبيّ

183
00:16:54,000 --> 00:16:56,360
الكائنات القيقبيّة شكلها كالبشر
وتنقسم إلى ذكر وأنثى

184
00:16:56,380 --> 00:16:58,750
يمكنها المشي بعد سبع سنوات من تشكّلها

185
00:16:59,120 --> 00:17:02,710
بعد أن ترى النّاس، تتحوّل إلى أشجار
قصيرة تُدعى بأشجار القيقب

186
00:17:02,730 --> 00:17:06,120
وحرقها يمكن أن يُنزل الأمطار

187
00:17:07,410 --> 00:17:09,500
هل ستحرق نفسها؟

188
00:17:10,120 --> 00:17:14,410
كلّما كان الكائن القيقبيّ أشبه
البشر، كان أقرب إلى الموت

189
00:17:14,660 --> 00:17:18,160
،شعرها رماديّ الآن. بعد ساعات قليلة

190
00:17:18,190 --> 00:17:21,620
.سيصبح جسدها أسود كالفحم
انتشلوا جثّتها حينئذ

191
00:17:26,000 --> 00:17:29,410
كانت تُمطر بغزارة في ذلك اليوم

192
00:17:31,410 --> 00:17:32,790
أخي

193
00:17:36,000 --> 00:17:39,250
قال أخوتي بأنّهم أرادوا مضايقة
،البشر هذه المرّة

194
00:17:39,280 --> 00:17:42,540
لكن متى سيعودون؟

195
00:17:46,500 --> 00:17:49,910
من الآن فصاعداً، سأكون أخاكِ، حسناً؟

196
00:17:57,120 --> 00:18:00,790
هل أنتِ مستعدّة للتّضحية بنفسكِ
من أجل النّهر في موطنكِ؟

197
00:18:02,540 --> 00:18:06,370
أرجوك... أرجوك أنقذ أخي

198
00:18:07,750 --> 00:18:10,540
دعها تدخل. لا حاجة لاستمرار المطر

199
00:18:28,040 --> 00:18:30,660
حسناً، يتطلّب الوصول إلى موزو أيّام عديدة

200
00:18:30,680 --> 00:18:33,750
كفّي عن فتح السّتار. تهبّ رياح باردة

201
00:18:39,160 --> 00:18:41,830
سيّدي الصّغير الثّاني، أنت حكيم وشجاع

202
00:18:41,850 --> 00:18:44,870
.إنّه مجرّد وحش صغير في النّهر
بمجرّد أن تدوس قدمك الأرض سيرتعد خوفاً

203
00:18:45,120 --> 00:18:46,540
فلِماذا تستدعيني لمرافقتك؟

204
00:18:47,120 --> 00:18:52,370
مرافقة كبير العائلة وخدمته ينبغي
أن يكون واجبكِ، صحيح؟

205
00:18:53,370 --> 00:18:55,480
الجوّ بارد جدّاً في موزو، ولم تعطِني مشويّات

206
00:18:55,510 --> 00:18:57,620
من الواضح أنّك تستفزّني عمداً

207
00:19:06,870 --> 00:19:10,660
أخبريني. كيف اختُطِفتِ ونُقِلتِ إلى قرية هويلونغ؟

208
00:19:15,120 --> 00:19:16,160
إنّها قذرة

209
00:19:19,250 --> 00:19:21,910
كيف عرفتُ بأنّه تمّ اختطافي؟

210
00:19:22,370 --> 00:19:25,670
يحتاج الكائنات القيقبيّة جوهرَ العالم
وبيئة طبيعيّة صالحة

211
00:19:25,700 --> 00:19:29,000
لا تستطيع أي شجرة قيقب الحصول
على ذلك، لذا تمّ اختطافكِ بالطّبع

212
00:19:32,370 --> 00:19:33,790
تمّ اختطافي فعلاً

213
00:19:42,620 --> 00:19:46,250
أبي، غبت لمدّة شهر، لكن أحضرت
هذا إلى المنزل

214
00:19:46,750 --> 00:19:50,500
هذا شيء كثير من النّاس يحلمون
به لكن لا يستطيعون الحصول عليه

215
00:19:51,160 --> 00:19:53,380
ركّز جيّداً. إذا تمكّنت من تعلّم
،نسبة 30 بالمئة من ماهراتي

216
00:19:53,400 --> 00:19:55,620
فلن تكون وصمة عار في جبين العائلة

217
00:19:59,370 --> 00:20:03,620
أبي، يبدو أنّها لا تزال شجرة

218
00:20:04,290 --> 00:20:05,370
...هذا وهذا وهذا

219
00:20:08,000 --> 00:20:11,910
إذا تظاهرتِ بموتكِ ثانية، فسأحرق يديكِ وقدميكِ

220
00:20:11,910 --> 00:20:12,910
لا تشعلها

221
00:20:15,410 --> 00:20:20,120
لا تحرقني. لا تحرقني

222
00:20:28,370 --> 00:20:33,450
تمّ الإمساك بي، لكن في النّهاية
أنا سعيدة للغاية