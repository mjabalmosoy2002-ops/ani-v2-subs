1
00:00:28,410 --> 00:00:33,540
مضت خمسمئة عام. اقضوا على الأضعف

2
00:00:34,870 --> 00:00:35,790
هيّا بنا

3
00:00:57,200 --> 00:01:00,160
إذا أردتم قتله، فسوف أقتله أوّلاً

4
00:02:05,750 --> 00:02:07,410
...لن تكون هذه القوّة

5
00:02:18,080 --> 00:02:19,580
اهرب! اهرب بسرعة

6
00:02:20,120 --> 00:02:22,790
اختلط بين الجمهور. من الأفضل
الذّهاب إلى المدينة العاصمة

7
00:02:23,750 --> 00:02:28,080
إذا استطعتُ الهرب، فسأذهب حتماً
إلى العاصمة من أجل لقائك

8
00:02:38,000 --> 00:02:39,790
العاصمة. العاصمة

9
00:04:11,040 --> 00:04:16,540
.تُوفِّيت السيّدة لو والمُضيف مياو بجانبها
إنّه الحظّ الأسعد على الإطلاق

10
00:04:17,250 --> 00:04:18,910
أميتافا

11
00:04:29,080 --> 00:04:32,200
موكب جنازة آخر؟ ألم نصادف المزيد؟

12
00:04:32,870 --> 00:04:36,330
هذا هو الخامس؟ يبدو العدد كبيراً جدّاً

13
00:04:37,080 --> 00:04:40,380
ليس كبيراً جدّاً فحسب، بل إنّه
أكبر من اللّزوم

14
00:04:40,400 --> 00:04:42,040
،يبدو أنّ سكّان العاصمة كُثُر

15
00:04:42,070 --> 00:04:43,700
نادراً ما نشهد خمسة مواكب جنازة
في نصف يوم فحسب

16
00:04:44,500 --> 00:04:46,000
أمر غير معتاد

17
00:04:46,080 --> 00:04:47,860
،هل يُعقَل أنّ السّبب هو برودة الطّقس

18
00:04:47,880 --> 00:04:49,870
فلا يستطيع الشّيوخ تحمُّل البرد
ويموتون الواحد تلو الآخر؟

19
00:04:54,000 --> 00:04:57,620
يبدو أنّ وباء خطيراً على وشك أن يتفشّى

20
00:04:57,910 --> 00:05:01,120
وباء خطير؟ ماذا تعني سيّدي؟

21
00:05:01,910 --> 00:05:05,020
لا تعرفين الرّواية

22
00:05:05,040 --> 00:05:08,790
أولئك الّذين ماتوا في هذه الأيّام
في البداية كانوا مُصابين بأمراض ثانويّة

23
00:05:09,250 --> 00:05:14,120
بعد أيّام قليلة، ساء وضعهم فجأة
وفقدوا حياتهم

24
00:05:16,950 --> 00:05:23,000
الموت لا يعرف عمراً. الموت لا يعرف عمراً

25
00:05:37,830 --> 00:05:38,790
هل تمَّ كلُّ شيء؟

26
00:05:40,450 --> 00:05:43,420
مولايّ الصّغير الثّاني، كلّ شيء جاهز

27
00:05:43,440 --> 00:05:46,410
آسف لأنّ شاجينغ سبّبَتْ بعض
المتاعب لقصر سي

28
00:05:50,250 --> 00:05:51,580
تحقّقون بعض التقدُّم أخيراً

29
00:05:53,080 --> 00:05:59,120
.انظروا، التّوفة مطبوخ بحساء الخضار
قلتُ بأنّني سأصبح إلهل الطّبخ

30
00:06:00,040 --> 00:06:06,660
أميتافا. عندما تصبح إلَهاً، سنكون
غالباً قد متنا ولم نعُد بحاجة للأكل

31
00:06:07,040 --> 00:06:08,200
هل كلامي صحيح يا تاو ياو؟

32
00:06:12,080 --> 00:06:13,870
هل كلامي صحيح يا غونغون؟

33
00:06:14,830 --> 00:06:17,900
تأكل من الطّعام الّذي طبختُه
وتقول كلاماً يستفزّني

34
00:06:17,920 --> 00:06:21,000
أكلَ الثّعلبُ لطفَك

35
00:06:21,160 --> 00:06:25,040
هل ما زلت تريد أكل التّوفو خاصّتي؟
هل تعرف كم من الصّعب شراء التّوفو الآن؟

36
00:06:27,000 --> 00:06:27,330
!أنت

37
00:06:28,200 --> 00:06:31,250
لِمَ من الصّعب شراء توفو وهو طعام شائع؟

38
00:06:32,080 --> 00:06:35,700
في أماكن كثيرة، هناك قاعدة تنصّ
على أنّ التّوفو يجب أن يُقدَّم في الجنائز

39
00:06:36,200 --> 00:06:37,040
حسناً، حسناً

40
00:06:37,040 --> 00:06:37,830
أميتافا

41
00:06:37,830 --> 00:06:38,750
توقّف

42
00:06:39,080 --> 00:06:41,330
تُقام كثير من الجنائز مؤخّراً

43
00:06:41,330 --> 00:06:41,790
توقّف

44
00:06:49,950 --> 00:06:52,250
هذا ليس بسيطاً كما يبدو حتماً

45
00:06:52,450 --> 00:06:53,540
توقّف

46
00:06:59,660 --> 00:07:01,540
تاو ياو، أنتِ تدخّنين

47
00:07:13,120 --> 00:07:15,410
هل هذا من يي فينغجون؟

48
00:07:16,790 --> 00:07:19,400
تاو ياوياو، هل بدأتِ تحترقين بينما تأكلين؟

49
00:07:19,420 --> 00:07:22,410
هل أنت حادّة الطّبع مؤخّراً؟

50
00:07:22,580 --> 00:07:24,540
هل السّبب هو التّوفو؟

51
00:07:29,290 --> 00:07:32,330
ذلك الرّجل. انتظرني فحسب

52
00:07:33,250 --> 00:07:33,950
تاو ياوياو

53
00:08:14,000 --> 00:08:16,950
هل صنعتَ ثروة؟ هل تحتاج
حقّاً لحرق كثير من الورق؟

54
00:08:17,200 --> 00:08:20,110
قلتُ بأنّ قامتك القصيرة بسبب
،خلل التنسّج الخلقيّ

55
00:08:20,140 --> 00:08:22,660
ليس مرضاً. ليس باليد حيلة

56
00:08:23,500 --> 00:08:26,950
،شو هو، أين تختبئ؟ أنا هنا
لذا اخرج حالاً

57
00:08:27,080 --> 00:08:29,080
مولاتي تاو ياو

58
00:08:37,910 --> 00:08:41,040
مولاتي تاو ياو، وصلت أخيراً

59
00:08:50,120 --> 00:08:52,800
،أنت محظوظ لأنّني وصلتُ في الوقت من العاصمة

60
00:08:52,820 --> 00:08:56,250
وإلّا لما صمدت ليومين

61
00:08:58,500 --> 00:09:01,790
جروح سِهام؟ يا لها من رائحة حلوة غريبة

62
00:09:18,540 --> 00:09:21,090
،من الشّائع أن يُجرَح المرء بواسطة أعضاء العشيرة

63
00:09:21,110 --> 00:09:23,660
لكن ماذا عن جرح السّهم الخطير
الّذي أُصبت به هذا؟

64
00:09:25,700 --> 00:09:29,330
في الحقيقة، هربتُ كلّ الطريق إلى هنا

65
00:09:31,580 --> 00:09:38,000
،استُهدِفتُ في تشينزو، ولحسن الحظّ
تمكّنتُ من الاختباء هنا

66
00:09:38,910 --> 00:09:41,670
،رائحة العاصمة فوضويّة

67
00:09:41,690 --> 00:09:44,450
،ممّا يصعّب على العدوّ تعقُّبي
ما يضمن سلامتي لبعض الوقت

68
00:09:44,950 --> 00:09:48,830
أحضرتُ بعض الورق لحرقِه من أجلك
وذلك لاختبار حظّي

69
00:09:50,410 --> 00:09:54,580
هذا غريب. لمئات السّنين، لطالما كنت
صادقاً ومُطيعاً دوماً

70
00:09:55,330 --> 00:09:57,450
ما الشّيء العظيم الّذي فعلته
حتّى يتمّ اصطيادك؟

71
00:09:58,750 --> 00:10:03,290
مولاتي تاو ياو، هل سمعتِ بقواعد
عشيرتنا شو هو؟

72
00:10:04,870 --> 00:10:09,540
،في أعلى نقطة من الجبل، وانجي
هناك العديد من الأحجار المنقوشة في الأرض

73
00:10:10,500 --> 00:10:15,000
منذ يوم الولادة، كلّ عضو من شو هو
في جبل وانجي

74
00:10:15,410 --> 00:10:21,620
يحمل وزناً إجماليّاً على مدى
خمسمئة عام يتمّ تسجيله

75
00:10:22,540 --> 00:10:24,670
في كلّ خمسمئة عام، ستُقام مُنافسة تصنيف

76
00:10:24,700 --> 00:10:26,750
للقضاء على الضّعيف والحِفاظ على القويّ

77
00:10:27,370 --> 00:10:31,000
صاحب التّصنيف الأدنى يجب التخلُّص منه

78
00:10:34,000 --> 00:10:37,400
،خمسمئة عام هي مدّة طويلة بالفعل

79
00:10:37,420 --> 00:10:40,830
تكفيني لخوض حياة كاملة في هذا العالم

80
00:10:44,080 --> 00:10:45,330
...لكن

81
00:10:54,540 --> 00:10:57,540
لِمَ على أخي الأصغر أن يقاوم

82
00:10:57,560 --> 00:11:01,540
جزاء خمسمئة عام بسبب
شخص ضعيف وعديم الفائدة مثلي؟

83
00:11:19,080 --> 00:11:22,910
تمّت إزالة خمسة من السّبعة

84
00:11:36,870 --> 00:11:40,580
لا تطلب منّي إنقاذك، بل تطلب
منّي إنقاذ أخيك الصّغير

85
00:11:43,620 --> 00:11:49,000
لكن أنتم جماعة شو هو تقاتلون بالقوّة
الخالصة مثل العضّ والدّعس والسّحق والاصطدام

86
00:11:49,870 --> 00:11:52,350
لكن من أين أتت جروح السِّهام؟

87
00:11:52,370 --> 00:11:55,290
ويبدو أخوك الأصغر قويّاً جدّاً

88
00:11:56,160 --> 00:11:58,620
هل لا يزال هذا الوحش يحتاجني لإنقاذه؟

89
00:11:59,660 --> 00:12:03,500
تاو ياو، إنّه الآن داخل برج تشونغشاو

90
00:12:03,950 --> 00:12:06,950
اذهبي واكتشفي أيّاً كان ما تريدين معرفته

91
00:12:12,580 --> 00:12:14,100
سمعتُم ما يكفي لذا اخرجوا وقدِّموا المساعدة

92
00:12:14,120 --> 00:12:15,910
هل تريدونني أن أتولّى الأمر بنفسي؟

93
00:12:22,080 --> 00:12:27,910
يبدو هذا الوحش فريداً من نوعه، ككلب
صغير بأجنحة ووجه مليء

94
00:12:29,290 --> 00:12:32,120
إنّه جريح، ألا يبدو هذا واضحاً؟

95
00:12:33,120 --> 00:12:34,200
هل هو وحشٌ حقّاً؟

96
00:12:44,290 --> 00:12:46,660
جُرِحَ بواسطة سهم في العاصمة

97
00:12:50,290 --> 00:12:51,330
أين السّهم الّذي جرحك؟

98
00:12:52,040 --> 00:12:54,250
اختفى من تلقاء نفسه

99
00:13:01,450 --> 00:13:03,040
مولايّ الصّغير الثّاني، إلى أين أنت ذاهب؟

100
00:13:03,330 --> 00:13:07,450
،تأخّر الوقت. بما أنّكِ لم تشعلي ناراً
فمن الطّبيعي أن أذهب للمنزل للرّاحة

101
00:13:10,580 --> 00:13:13,200
حسناً، حسناً. مولايّ الصّغير والمُضيف
مياو، عودا كذلك

102
00:13:13,410 --> 00:13:17,830
لِمَ نعود؟ ألن نذهب إلى برج
تشونغشاو؟ سوف أحمله بنفسي

103
00:13:19,500 --> 00:13:22,370
في نهاية المطاف، إنّه وحش يا مولايّ الصّغير

104
00:13:23,870 --> 00:13:26,950
هل التقينا بالكثير من المخلوقات والأشياء الغريبة؟

105
00:13:26,980 --> 00:13:30,540
.فضلاً عن ذلك، تاو ياوياو من قصر سي
عملها مرتبط بقصر سي

106
00:13:30,830 --> 00:13:33,540
اِنسَ ذلك يا مولايّ الصّغير، لا يمكنك
تقديم المساعدة

107
00:13:35,540 --> 00:13:38,550
إيّاكِ والتّفكير في تَركي والرّحيل
يا مولاتي تاو ياو

108
00:13:38,570 --> 00:13:41,580
ما هي مكانتكِ بالضّبط في نظر الوحوش؟

109
00:13:42,580 --> 00:13:44,700
بما أنّ علينا الذّهاب، فكُفّ
عن المُماطلة ولنذهب

110
00:13:50,370 --> 00:13:51,200
أخي الصّغير

111
00:14:13,500 --> 00:14:17,660
هل أنت بخير؟ أنا السّبب كوني
ضعيفاً وعاجزاً عن الصُّمود

112
00:14:19,080 --> 00:14:24,040
أنا ممتنٌّ جدّاً لك. فأنت تسمح
لي برؤيتها من جديد

113
00:14:24,450 --> 00:14:27,330
أنا ممتنٌّ بالفعل

114
00:14:30,250 --> 00:14:32,000
انظر، أهي هناك؟

115
00:14:42,160 --> 00:14:43,080
جدّتي

116
00:14:43,790 --> 00:14:47,660
مضَتْ سِنوات طِوال، لكن شاو
هونغ لم تتغيّر إطلاقاً

117
00:14:48,330 --> 00:14:50,960
،لأنّني تمكّنتُ من رؤيتها ثانية

118
00:14:50,990 --> 00:14:54,040
وبكامل صحّتها وسعادتها، فقد حقّقتُ أُمنيتي

119
00:14:54,540 --> 00:14:57,250
شكراً لك أيُّها الوحش النّبيل

120
00:15:13,250 --> 00:15:16,000
أليس هذه القمامة عديمة الفائدة
الّتي لا تستطيع سوى حمل أرواح؟

121
00:15:21,040 --> 00:15:22,750
حمل الأرواح لا يكفي

122
00:15:23,410 --> 00:15:28,080
ينبغي أن تعلم بأنّ قوّتنا تنبع
من خلال ما نحمله

123
00:15:28,370 --> 00:15:31,410
كلّما حملت أكثر وأثقل، أصبحت أقوى

124
00:15:32,250 --> 00:15:34,910
،ما رأيك بهذا؟ دعني أعلّمك كيف تصبح أقوى

125
00:15:34,930 --> 00:15:37,410
كحمل هذه على ظهرك

126
00:15:38,910 --> 00:15:41,330
لكن سوف أُسحَق حتّى الموت

127
00:15:45,080 --> 00:15:46,750
وما أدراك من دون تجربة؟

128
00:15:56,040 --> 00:15:57,500
من يجرؤ على لمسه؟

129
00:16:18,500 --> 00:16:21,160
كيف يمتلك هذه القمامة أخاً أصغر بهذه القوّة؟

130
00:16:21,580 --> 00:16:24,060
لندعهما يلعبان هذه الحيلة الأخويّة

131
00:16:24,080 --> 00:16:26,330
على أيّ حال، في النّهاية
سوف تموت هذه القمامة أيضاً

132
00:16:26,410 --> 00:16:27,450
هيّا بنا. هيّا

133
00:16:30,160 --> 00:16:34,750
شكراً لك يا... يا... يا أخي

134
00:16:40,160 --> 00:16:45,080
ذات يوم سوف أصبح أقوى أيضاً
ولن أدعك تحميني

135
00:16:56,910 --> 00:16:59,040
أنت... ماذا تفعل؟

136
00:17:06,410 --> 00:17:10,290
أنت أقوى من السّابق، على الأقلّ
يمكنك تعقّب رائحتي لإيجادي

137
00:17:10,750 --> 00:17:15,870
هل جُنِنت؟ لماذا... لماذا قتلت هذا
العدد الكبير من النّاس بلا سبب؟ لماذا؟

138
00:17:16,450 --> 00:17:20,290
إنَّ وزن شخص حيّ أقلّ بكثير من وزن الحياة

139
00:17:20,620 --> 00:17:25,080
كلّما حظيتُ بحيوات أكثر، ازدادت قوّتي

140
00:17:25,370 --> 00:17:28,360
لكن لا يجوز أن تؤذي النّاس. أنت قويٌّ سلفاً

141
00:17:28,380 --> 00:17:31,370
لِمَ تحتاج لكلّ هذه القوّة؟

142
00:17:34,830 --> 00:17:36,500
أوشكوا على الوصول إلى هنا

143
00:17:57,700 --> 00:18:04,250
إذاً تحتاج لكثير من القوّة من أجل
الاستمرار في حمايتي

144
00:18:11,120 --> 00:18:13,910
أخي الصّغير، استيقظ بسرعة

145
00:18:17,000 --> 00:18:19,000
تعافيت بسرعة من جراحك

146
00:18:23,040 --> 00:18:28,950
...هذا... إذاً، قوّتك

147
00:18:45,700 --> 00:18:46,580
بسرعة، يجب أن تغادر

148
00:18:55,410 --> 00:18:59,370
سوف أنقذك. أعرف عمّن أبحث لإنقاذك

149
00:19:00,000 --> 00:19:02,790
اصبر فحسب. يجب أن تصبر  قليلاً

150
00:19:06,910 --> 00:19:13,080
حجر دُمية ين. الكثير من الأرواح
الشرّيرة تنجذب إلى هنا

151
00:19:13,660 --> 00:19:17,250
لهذا مات كثير من الأبرياء في المدينة

152
00:19:18,330 --> 00:19:21,410
تعطُّش أخيك الأصغر للقوّة هائل

153
00:19:23,120 --> 00:19:25,580
ما ذلك الحجر بالضّبط؟

154
00:19:26,540 --> 00:19:28,190
،البرتقال هو برتقال في مكان

155
00:19:28,220 --> 00:19:29,870
لكنّه ليس كذلك في مكان آخر

156
00:19:30,910 --> 00:19:33,170
حجر دُمية ين في شمال جبل وانجي

157
00:19:33,190 --> 00:19:35,450
غير مضرّ بالبشر في الأصل

158
00:19:36,370 --> 00:19:39,210
لكن إذا تمّ إخراجه، سواء كانوا
،بشراً عاديّين أو طيوراً أو وحوشاً

159
00:19:39,240 --> 00:19:42,080
كلّ الكائنات الحيّة سوف تتضرّر بواسطته

160
00:19:43,200 --> 00:19:45,730
سمعت أيضاً بأنّ كثيراً من النّاس

161
00:19:45,760 --> 00:19:48,290
في هذه المدينة مُصابون بأمراض وجروح ثانويّة

162
00:19:48,750 --> 00:19:51,910
تلك الجروح والأمراض سوف تسوء بسرعة
وتقود قريباً إلى الموت

163
00:19:53,000 --> 00:19:55,500
هذه هي قوّة حجر دُمية ين

164
00:19:56,330 --> 00:20:01,200
،إن لم يتمّ إيقافها، ففي غضون نصف عام
نصف السكّان سيموتون على الأقلّ

165
00:20:01,950 --> 00:20:04,330
في هذه الحالة، يجب علينا أن نسرع ونسترجعه

166
00:20:04,330 --> 00:20:05,790
لا، لا جدوى من ذلك

167
00:20:07,040 --> 00:20:09,000
،حالما يُلمَس شخص بواسطة حجر دُمية ين

168
00:20:09,030 --> 00:20:11,000
سواء كانوا بشراً أو ماشية أو طيوراً
أو وحوشاً، لا يمكن عكس الأمر أبداً

169
00:20:11,750 --> 00:20:15,200
سيندمجون معه حتّى الموت

170
00:20:20,500 --> 00:20:25,910
وأخوه امتصَّ وزن الوحوش والبشر في قمّة البرج

171
00:20:26,410 --> 00:20:29,950
أمسى قويّاً جدّاً، لا يختلف عن شيطان

172
00:20:30,870 --> 00:20:34,040
هل ستنقذه أم تقتله؟

173
00:20:37,040 --> 00:20:37,950
...هذا

174
00:20:42,200 --> 00:20:43,000
لا تلمسه

175
00:20:45,700 --> 00:20:47,120
أهذا هو حجر دمية ين؟

176
00:20:50,160 --> 00:20:52,500
حالما تحمله، لن تتمكّن من إنزاله ثانية

177
00:20:53,080 --> 00:20:56,180
أليس هذا رائعاً؟ إذا أتت العشيرة
،بأكملها للقضاء عليّ

178
00:20:56,200 --> 00:20:59,950
فهو قادر على حمايتي كُلّياً

179
00:21:00,700 --> 00:21:05,450
لكنّه مُميت. حياتك وحياة جميع
المخلوقات المُحيطة على المحكّ

180
00:21:05,830 --> 00:21:06,950
وماذا يعني؟

181
00:21:14,790 --> 00:21:18,160
أم أنّك تقول بأنّهم كانوا
في الأصل سواسية؟

182
00:21:21,000 --> 00:21:22,080
...أخي الصّغير