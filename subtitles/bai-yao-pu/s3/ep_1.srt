1
00:00:27,870 --> 00:00:28,910
!تعالوا وانظروا

2
00:00:28,910 --> 00:00:31,870
!خوخ، برتقال، برسيمون، وأجاص

3
00:00:33,540 --> 00:00:35,950
أحمر الشّفاه وبودرة ودبّوس شعر
،وزيت عناية بالشّعر

4
00:00:35,930 --> 00:00:37,430
!ألقوا نظرة

5
00:00:35,950 --> 00:00:38,620
يا آنسة، هل تريدين لفافة حرير ممتاز؟

6
00:00:38,620 --> 00:00:39,910
أو بضعة أقدام منه؟

7
00:00:39,910 --> 00:00:41,240
،باغودا من السّيراميك ونحوت صلصاليّة

8
00:00:41,250 --> 00:00:43,370
عجلات مغزليّة خاصّة بالخيول، ولوالب سوطيّة

9
00:00:43,370 --> 00:00:44,370
انظروا

10
00:00:46,500 --> 00:00:48,330
!سمك طازج! سمك حيّ

11
00:00:48,330 --> 00:00:50,790
تعالوا وانظروا

12
00:00:50,950 --> 00:00:51,620
تعالوا

13
00:00:51,620 --> 00:00:53,450
وألقوا نظرة

14
00:00:53,450 --> 00:00:56,450
يمكنكم إيجاد أيّ شيء هنا بأسعار جيّدة

15
00:00:58,040 --> 00:00:59,540
العاصمة

16
00:00:59,540 --> 00:01:00,700
مزدهرة جدّاً

17
00:01:03,250 --> 00:01:03,910
،لحظة

18
00:01:03,910 --> 00:01:04,700
أين تاو ياو؟

19
00:01:18,580 --> 00:01:19,740
!لا يا تاو ياو

20
00:01:19,750 --> 00:01:20,660
سوف تندمين حتماً

21
00:01:20,660 --> 00:01:21,740
!إذا دخلتِ

22
00:01:25,450 --> 00:01:26,830
!سأندم إذا لم أفعل

23
00:01:26,830 --> 00:01:28,580
!أنت نحس. لا تتبعني، وإلّا فقدتُ المال

24
00:01:28,580 --> 00:01:29,160
!انقلع

25
00:01:29,500 --> 00:01:31,330
!ستفقدينه بي أو بدوني

26
00:01:37,750 --> 00:01:39,160
تقبّل قدرك

27
00:01:39,160 --> 00:01:40,740
سوف تبيعك بفلوس قليلة

28
00:01:40,750 --> 00:01:42,540
!عندما تفقد كلّ مالها

29
00:01:43,200 --> 00:01:44,990
إذاً ستُباع ويُطبَخ منك حساء أفعى أيضاً؟

30
00:01:45,540 --> 00:01:46,740
أنا؟

31
00:01:47,040 --> 00:01:47,620
،أجل

32
00:01:47,830 --> 00:01:48,870
،من حيث الوزن

33
00:01:48,870 --> 00:01:50,450
!يمكن بيعك بثروة كبيرة

34
00:01:51,950 --> 00:01:55,040
أخشى أنّهم لن يجدوا قِدراً بذلك الحجم الكبير

35
00:01:55,370 --> 00:01:57,120
حاول بيع جسدي الشّبيه بجسد الإنسان ربّما

36
00:01:57,120 --> 00:01:59,160
،بجمالي ومواهبي

37
00:01:59,160 --> 00:02:00,950
لا بدّ أنّي المخلوق الأندر

38
00:02:05,250 --> 00:02:06,490
...سيّد ليو

39
00:02:06,790 --> 00:02:07,370
توقّف

40
00:02:07,790 --> 00:02:09,740
من واجب تاو ياو إطعامك

41
00:02:10,040 --> 00:02:11,540
!أريد بانكيك

42
00:02:12,080 --> 00:02:12,990
!اذهب وتوسّل تاو ياو

43
00:02:13,330 --> 00:02:14,700
!أريد فطائر بالخضار

44
00:02:14,950 --> 00:02:16,200
ماذا قلتُ لك؟

45
00:02:16,450 --> 00:02:18,080
!أريد كعكاً زهريّ الشّكل

46
00:02:18,080 --> 00:02:19,370
هل رأيت أيّ كعك زهريّ الشّكل هنا؟

47
00:02:20,370 --> 00:02:21,330
لا؟

48
00:02:22,910 --> 00:02:25,620
...لماذا أشتمّ رائحة حلوة وعطرة

49
00:02:25,620 --> 00:02:26,370
رائحة ورد؟

50
00:02:27,200 --> 00:02:28,370
!هيّا! افتح

51
00:02:44,120 --> 00:02:45,160
غريب

52
00:02:45,580 --> 00:02:47,120
لا يوجد ماكينة بيع للكعك زهريّ الشّكل

53
00:02:50,450 --> 00:02:52,330
لحظة، أعرف هذه الرّائحة

54
00:02:57,000 --> 00:02:59,660
!مويا! سيّد ليو

55
00:03:03,000 --> 00:03:04,240
!اهرب يا رولي

56
00:03:04,250 --> 00:03:05,830
يجب أن نفترق هنا

57
00:03:06,160 --> 00:03:07,240
لا تنظر خلفك

58
00:03:07,250 --> 00:03:09,040
...وحذارِ من أن يُمسَك بك، وإلّا سوف

59
00:03:10,000 --> 00:03:11,740
عمّاذا تتكلّم؟

60
00:03:11,750 --> 00:03:13,410
!ربحتُ مالاً

61
00:03:13,410 --> 00:03:14,160
ماذا؟

62
00:03:16,160 --> 00:03:17,290
...أنا

63
00:03:17,290 --> 00:03:18,890
!ربحتُ مالاً

64
00:03:20,950 --> 00:03:22,330
كم هذا فظيع

65
00:03:22,330 --> 00:03:24,080
!حتّى تاو ياو تستطيع ربح المال

66
00:03:25,500 --> 00:03:28,080
لا بدّ من وجود خطأ ما

67
00:03:28,410 --> 00:03:29,160
،اسمع

68
00:03:29,160 --> 00:03:30,950
لا تسخر من حظّي السيّئ ثانية

69
00:03:31,370 --> 00:03:33,240
...تعال، لنذهب إلى مطعم

70
00:03:33,250 --> 00:03:33,870
فاخر...

71
00:03:38,080 --> 00:03:38,700
!المال

72
00:03:38,790 --> 00:03:40,120
!لقد سُرِقتِ

73
00:03:46,660 --> 00:03:51,540
!اقبضوا على اللصّ

74
00:03:48,410 --> 00:03:49,830
!مالي

75
00:03:52,920 --> 00:03:55,170
الحلقة 1: نيان هوا الخفيّة

76
00:04:02,830 --> 00:04:04,040
!أعتقد لا يسعني فعل شيء

77
00:04:18,450 --> 00:04:19,240
...سيّد

78
00:04:19,250 --> 00:04:20,490
،ليو

79
00:04:20,500 --> 00:04:22,410
!الوقت ليس مناسباً للبقاء متخفّياً

80
00:04:22,410 --> 00:04:23,830
!ساهم في القبض على اللصّ

81
00:04:23,830 --> 00:04:24,910
!ليس شأني

82
00:04:25,330 --> 00:04:26,870
المكان أغبر أمامنا

83
00:04:26,870 --> 00:04:27,540
مقرف

84
00:04:31,330 --> 00:04:31,830
...اقبضوا

85
00:04:32,080 --> 00:04:33,200
!اقبضوا على اللصّ

86
00:04:54,580 --> 00:04:55,490
أنت

87
00:05:24,290 --> 00:05:24,950
من هذا؟

88
00:05:30,120 --> 00:05:30,790
...مال

89
00:05:31,120 --> 00:05:32,490
...هو... سرقَ مالي

90
00:05:32,790 --> 00:05:34,160
!كيف تجرؤ؟

91
00:05:34,450 --> 00:05:35,830
!أنت تقف في وجه أعظم سارق

92
00:05:47,000 --> 00:05:49,120
لم أسمع بذلك

93
00:05:52,720 --> 00:05:53,990
!يا لها من مؤخّرة قبيحة

94
00:05:58,660 --> 00:05:59,740
!ابقَ مكانك

95
00:05:59,750 --> 00:06:01,240
!سأستدعي أخوتي ليأتوا وليقّنونك درساً

96
00:06:01,660 --> 00:06:02,450
بسرعة

97
00:06:03,120 --> 00:06:04,410
لديّ موعد اللّيلة

98
00:06:06,370 --> 00:06:07,330
!شكراً

99
00:06:07,330 --> 00:06:09,160
ظننتُ أنّ سكّان العاصمة لا مُبالين

100
00:06:09,160 --> 00:06:10,580
...ولا أحد يرغب في تقديم المساعدة

101
00:06:18,250 --> 00:06:19,790
العاصمة رائعة حقّاً

102
00:06:20,160 --> 00:06:22,160
حتّى عابر سبيل بهذه الوسامة

103
00:06:24,750 --> 00:06:26,120
الآنسة الفاضلة

104
00:06:26,120 --> 00:06:26,950
لا تذهب إلى بيت قمار

105
00:06:28,290 --> 00:06:29,700
وما أدراك بأنّني دخلتُ بيت القمار؟

106
00:06:30,040 --> 00:06:31,330
خمس مرّات فوز على التّوالي

107
00:06:31,330 --> 00:06:33,200
كاد صراخك يُسقِط السّقف

108
00:06:33,580 --> 00:06:35,120
من السّهل مُلاحظتكِ

109
00:06:35,450 --> 00:06:36,990
لكن لم أرك

110
00:06:37,450 --> 00:06:39,830
عادة لا ينتبه المُقامرون لغير المُقامرين

111
00:06:40,370 --> 00:06:41,410
لماذا تذهب إلى بيت القمار

112
00:06:41,660 --> 00:06:42,740
وأنت لا تُقامر؟

113
00:06:43,120 --> 00:06:43,910
ليس شأنكِ

114
00:06:47,410 --> 00:06:48,200
لا تسئ فهمي

115
00:06:48,450 --> 00:06:49,870
لستُ مُتطفّلة

116
00:06:50,790 --> 00:06:52,200
سنلتقي إذا سنحت لنا فرصة

117
00:06:52,790 --> 00:06:54,540
،قد أكون فتاة سيّئة

118
00:06:54,950 --> 00:06:56,160
لذا انس أمري

119
00:07:05,870 --> 00:07:06,490
،سيّدي، إن كان لديك الوقت

120
00:07:06,700 --> 00:07:08,080
زُر طبيباً

121
00:07:08,540 --> 00:07:10,040
يمكنني أن أعرف بأنّك مريض

122
00:07:10,200 --> 00:07:11,410
أخشى أن يؤدّي إلى مقتلك قريباً

123
00:07:20,250 --> 00:07:21,120
،تاو ياو

124
00:07:21,410 --> 00:07:23,950
هذه أطيب فطائر بالخضار أكلتُها

125
00:07:24,950 --> 00:07:26,080
!أخبرتُك

126
00:07:26,370 --> 00:07:28,580
!يمكنك الاستمتاع بالطعام الفاخر معي

127
00:07:29,200 --> 00:07:30,910
،أخيراً أكلنا وجبة جيّدة

128
00:07:31,450 --> 00:07:32,910
وكأن فأر حقل مشويّ

129
00:07:33,250 --> 00:07:34,240
ليكون أفضل حتّى

130
00:07:35,200 --> 00:07:37,240
،أنت روح عاشت لألف عام

131
00:07:37,250 --> 00:07:39,660
هلّا جرّبت من فضلك

132
00:07:39,660 --> 00:07:40,160
شيئاً يناسب وضعك؟

133
00:07:40,370 --> 00:07:41,040
،حمقاء

134
00:07:41,200 --> 00:07:42,790
تتغذّى الأفاعي على فئران الحقول

135
00:07:43,410 --> 00:07:44,990
،أيّها الجرذ الكبير

136
00:07:45,000 --> 00:07:46,330
!لا تأكل مزيداً من ذُراي البيضاء

137
00:07:47,790 --> 00:07:49,540
...اللّحم الطازج والطريّ

138
00:07:49,540 --> 00:07:50,990
...هذه القرمشة

139
00:07:51,500 --> 00:07:52,160
،توقّف

140
00:07:52,160 --> 00:07:53,910
لستُ أفعى. أشعر بالغثيان

141
00:07:54,000 --> 00:07:55,720
،إذا أكلتَ مزيداً من الفئران

142
00:07:56,040 --> 00:07:58,990
!لا تجلس معي على نفس الطاولة

143
00:08:00,290 --> 00:08:01,290
،انسيا الأمر

144
00:08:01,290 --> 00:08:03,200
أنتم الفانون

145
00:08:03,200 --> 00:08:05,540
لن تشعروا بنعمة تذوّق فأر حقول في حياتكم

146
00:08:06,330 --> 00:08:08,370
لذا لنتكلّم عن شيء آخر

147
00:08:08,370 --> 00:08:10,290
...ونتطرّق لصلب الموضوع

148
00:08:10,290 --> 00:08:12,080
مضى وقت طويل

149
00:08:12,080 --> 00:08:13,370
منذ غادرنا مدينة تاو

150
00:08:16,160 --> 00:08:17,450
،لديك حيواناتك الأليفة

151
00:08:17,450 --> 00:08:18,540
،وتناولت الدّواء السحريّ

152
00:08:18,790 --> 00:08:19,950
،والتقيت بأصدقائك

153
00:08:19,950 --> 00:08:20,990
وغازلت إله الرّعد

154
00:08:21,500 --> 00:08:22,740
حتّى مويا

155
00:08:22,750 --> 00:08:24,240
قد خُطِب

156
00:08:25,700 --> 00:08:27,330
تـ-تمّ اختطافي

157
00:08:27,620 --> 00:08:28,160
،لا

158
00:08:28,160 --> 00:08:29,290
...باعتني تاو ياو

159
00:08:30,580 --> 00:08:31,620
،على أيّ حال

160
00:08:31,620 --> 00:08:33,080
ثمّة فتاة تنتظرك

161
00:08:33,790 --> 00:08:34,450
...أنا

162
00:08:36,910 --> 00:08:39,120
لكن ماذا عن ذلك الشيء؟

163
00:08:41,160 --> 00:08:43,080
أيّ شيء؟

164
00:08:43,500 --> 00:08:44,620
عمّاذا تتكلّم؟

165
00:08:45,040 --> 00:08:46,120
دع البالغين يتكلّمون

166
00:08:46,120 --> 00:08:46,910
!كُل طعامك

167
00:08:48,830 --> 00:08:50,290
!هذه كُرات الخضار خاصّتي

168
00:08:50,540 --> 00:08:51,370
!لا تدّعي البراءة

169
00:08:51,580 --> 00:08:52,790
هذا الشيء

170
00:08:52,790 --> 00:08:57,950
!ضروريّ جدّاً لبقاء كافّة الأرواح

171
00:08:59,750 --> 00:09:02,120
تقصد ألبومات الجنّيات الموجود في مكان ما؟

172
00:09:03,500 --> 00:09:04,540
!الحقيقة هي أنّكِ أضعتِها

173
00:09:09,830 --> 00:09:10,700
!أخفض صوتك

174
00:09:11,250 --> 00:09:12,580
!نتحدّث عن ألبومات الجنّيات

175
00:09:13,160 --> 00:09:14,740
سجلّات كلّ عشائر الرّوح في العالم

176
00:09:15,160 --> 00:09:16,950
،إذا مُسِح اسم عشيرة

177
00:09:16,950 --> 00:09:19,700
!ستختفي

178
00:09:20,450 --> 00:09:21,540
أعلم، اهدأ

179
00:09:21,790 --> 00:09:23,120
،لأنّكِ أضعتِها

180
00:09:23,500 --> 00:09:26,370
،أنا، سليل نسل نبيل

181
00:09:26,750 --> 00:09:29,950
!ينتهي المطاف بي تحت رحمة الآخرين

182
00:09:30,660 --> 00:09:31,580
لماذا؟

183
00:09:32,870 --> 00:09:35,620
أتظنّني كنتُ أعالج الأرواح فقط لإيجاد الدواء؟

184
00:09:36,040 --> 00:09:36,450
...في الواقع

185
00:09:38,540 --> 00:09:39,290
،حسناً

186
00:09:39,540 --> 00:09:40,540
كلّ الكائنات سواسية

187
00:09:41,080 --> 00:09:42,080
!أميتابا

188
00:09:44,040 --> 00:09:45,040
...لذا

189
00:09:45,250 --> 00:09:47,120
علينا البقاء في العاصمة لفترة طويلة

190
00:09:47,580 --> 00:09:48,910
هذا هو قلب الأغنية العظيمة

191
00:09:49,160 --> 00:09:50,660
من الأسرع حتماً إيجاد ألبومات الجنّيات
مقارنة بأماكن أخرى

192
00:09:50,790 --> 00:09:51,490
حقّاً؟

193
00:09:51,910 --> 00:09:53,990
!إذاً يمكننا أكل كُرات بالخضار يوميّاً

194
00:09:54,390 --> 00:09:55,000
!في أحلامك

195
00:09:55,370 --> 00:09:57,120
!غداً سوف تتوسّلني

196
00:10:00,580 --> 00:10:01,370
حسناً

197
00:10:01,700 --> 00:10:02,580
،في هذه الحالة

198
00:10:02,950 --> 00:10:05,700
يمكنني التّركيز على القصائد والأغاني

199
00:10:05,910 --> 00:10:07,620
سيأتي اليوم قريباً

200
00:10:07,620 --> 00:10:09,080
عندما أشتهر في كلّ أنحاء العالم

201
00:10:09,080 --> 00:10:10,620
قد يأتي ذلك اليوم لاحقاً

202
00:10:10,620 --> 00:10:11,950
ثمّ سأستأنف الحياة الدنيويّة

203
00:10:12,750 --> 00:10:14,540
!سمعتُ بذلك

204
00:10:17,450 --> 00:10:18,950
!وأنت

205
00:10:19,290 --> 00:10:21,370
أنت ثعلب لا يقرأ حتّى

206
00:10:21,370 --> 00:10:22,990
!لا تتدخّل في هذا

207
00:10:27,290 --> 00:10:28,700
أتريد مقاتلتي؟

208
00:10:28,700 --> 00:10:30,490
حاول بجدٍّ أكبر

209
00:10:40,790 --> 00:10:42,020
،ماء

210
00:10:42,040 --> 00:10:42,830
!أريد ماء

211
00:10:44,160 --> 00:10:44,910
!خزّان الماء هناك

212
00:10:46,950 --> 00:10:47,950
أميتابا

213
00:10:48,500 --> 00:10:49,830
!رولي، كان ذلك مُدهشاً

214
00:10:59,080 --> 00:11:00,450
جيّد أنّنا فرّغنا كلّ الصّحون

215
00:11:00,620 --> 00:11:01,700
يمكنكما أن تتشاجرا على راحتكما

216
00:11:01,700 --> 00:11:02,410
،تاو ياو

217
00:11:02,580 --> 00:11:03,830
!أنتِ غير عاطفيّة بالمرّة

218
00:11:06,410 --> 00:11:07,990
تعويض لباب غرفتك والأدراج

219
00:11:19,330 --> 00:11:20,540
إنّه هو

220
00:11:23,120 --> 00:11:24,450
ماذا تريد بالضبط؟

221
00:11:24,750 --> 00:11:26,370
!تمّ ردّ مالك بشكل كامل

222
00:11:26,370 --> 00:11:28,290
!ليس شأني ألّا تجد ذلك الشيء

223
00:11:29,330 --> 00:11:30,740
لا يعنيني المال

224
00:11:31,250 --> 00:11:32,790
أكره الكاذبين فحسب

225
00:11:33,700 --> 00:11:34,870
متى كذبتُ عليك؟

226
00:11:35,200 --> 00:11:36,240
،أخبرتُك بالطريقة

227
00:11:36,250 --> 00:11:37,290
لكن لا تعرف كيفيّة تنفيذ ذلك

228
00:11:37,620 --> 00:11:39,240
فلماذا تلومني؟

229
00:11:39,700 --> 00:11:40,910
أخبرتُك سابقاً

230
00:11:41,370 --> 00:11:42,700
،بأنّني أطلب المساعدة بثِقة كاملة

231
00:11:43,290 --> 00:11:44,910
،إذا خدعتني

232
00:11:45,290 --> 00:11:47,450
فسوف أقتلع لسانك

233
00:11:47,450 --> 00:11:49,910
...صـ-صدّقني لم أكذب عليك

234
00:11:59,370 --> 00:12:00,370
هذا أنت ثانية

235
00:12:04,540 --> 00:12:05,330
!لا تقترب أكثر

236
00:12:05,330 --> 00:12:06,330
،إذا فعلت

237
00:12:06,330 --> 00:12:07,870
!سأقتل هذه الفتاة

238
00:12:08,330 --> 00:12:08,910
!تاو ياو

239
00:12:10,930 --> 00:12:11,830
هذا أنت؟

240
00:12:12,120 --> 00:12:14,160
يا سيّد، أنقذني

241
00:12:15,080 --> 00:12:16,370
تعرفان بعضكما إذاً؟

242
00:12:17,250 --> 00:12:18,330
هذا أفضل

243
00:12:18,580 --> 00:12:19,660
،أيّتها الصّغيرة

244
00:12:19,660 --> 00:12:21,450
آسف لأخذكِ كرهينة

245
00:12:22,250 --> 00:12:23,370
!تمهّل

246
00:12:23,370 --> 00:12:25,200
!القتل هو خطيئة كبيرة

247
00:12:25,950 --> 00:12:26,620
!انقلع

248
00:12:26,870 --> 00:12:28,330
!سأقتلها إذا تجرأ أحد على المجيء

249
00:12:34,830 --> 00:12:37,200
أتكلّم مع تاو ياو

250
00:13:05,750 --> 00:13:06,790
،أيّتها الصّغيرة

251
00:13:06,790 --> 00:13:08,120
كوني مهذّبة

252
00:13:08,290 --> 00:13:09,620
سأطلق سراحكِ بعد الفجر

253
00:13:09,830 --> 00:13:12,620
عندما أشفي جراحي

254
00:13:12,910 --> 00:13:14,370
،إذا حاولتِ الهرب

255
00:13:14,370 --> 00:13:16,490
سأقتلكِ بحجر

256
00:13:22,580 --> 00:13:23,830
،لن أهرب

257
00:13:23,830 --> 00:13:25,160
ولا أعرف إلى أين أذهب

258
00:13:25,160 --> 00:13:26,910
لكن أعتقد بأنّ ذلك الرّجل سيلحق بنا

259
00:13:27,200 --> 00:13:28,540
هل أنتِ متأكّد بأنّك لا تريد الهرب؟

260
00:13:29,540 --> 00:13:31,410
أنا عدّاء سريع

261
00:13:31,410 --> 00:13:33,410
قلّة من يستطيعون اللّحاق بي

262
00:13:37,660 --> 00:13:39,370
بدوتَ فقيراً جدّاً

263
00:13:39,370 --> 00:13:40,830
بكم من المال احتلتَ عليه؟

264
00:13:41,250 --> 00:13:43,450
!أنا مُعالِج

265
00:13:43,750 --> 00:13:46,330
!وأيضاً لم أقم بالاحتيال عليه أبداً

266
00:13:46,330 --> 00:13:46,990
حقّاً؟

267
00:13:48,870 --> 00:13:52,790
،أسافر حول العالم لعشرات السّنين

268
00:13:52,790 --> 00:13:55,660
وأنا قادر على الاتّصال الروحانيّ بالآلهة والأرواح

269
00:13:55,660 --> 00:13:58,790
كيف يُعاملني كمُحتال؟

270
00:14:00,660 --> 00:14:02,240
أنت نفسانيّ إذاً

271
00:14:02,580 --> 00:14:04,080
ينبغي أن تساعد النّاس في تفقّد الفينغشوي

272
00:14:04,080 --> 00:14:05,160
أو إيجاد أماكن دفن ملائمة

273
00:14:05,540 --> 00:14:07,040
لماذا تعبث مع أشخاص كذلك الرّجل؟

274
00:14:08,080 --> 00:14:09,700
توسّلني أن أساعده

275
00:14:09,950 --> 00:14:11,790
!لم أعبث معه

276
00:14:13,160 --> 00:14:14,370
،أيّتها الصّغيرة

277
00:14:14,370 --> 00:14:16,620
تعرفين الفينغشوي فقط

278
00:14:16,620 --> 00:14:19,660
،لكن في تلك الأماكن الخفيّة للعين البشريّة

279
00:14:19,660 --> 00:14:23,200
هناك أرواح ذات قوى سحريّة

280
00:14:24,950 --> 00:14:26,240
يمكنك رؤية الأرواح؟

281
00:14:27,040 --> 00:14:28,410
هذا

282
00:14:28,410 --> 00:14:30,040
!ما توسّلني لأجله

283
00:14:31,830 --> 00:14:32,870
،سيّد شوغو

284
00:14:33,140 --> 00:14:34,990
،إذا ساعدتني في إيجاد هذه الرّوح

285
00:14:35,290 --> 00:14:36,700
سأخصّص مكافآت جيّدة أخرى لك

286
00:14:39,000 --> 00:14:41,620
أنت السيّاف الأفضل في العالم

287
00:14:41,620 --> 00:14:43,870
سأبذل قصارى جهدي للمساعدة

288
00:14:46,580 --> 00:14:48,490
ليس من الصّعب إيجاد هذه الرّوح

289
00:14:48,500 --> 00:14:50,540
،عليك فقط أن تتبع طريقتي

290
00:14:50,540 --> 00:14:51,700
،اكتب رسالة

291
00:14:51,700 --> 00:14:53,370
،واربطها بخيط أسد

292
00:14:53,370 --> 00:14:54,830
واحتفظ بها داخل ورقة الطلاسم

293
00:14:55,080 --> 00:14:58,040
لفّ الخيط الأسود 99 مرّة

294
00:14:58,040 --> 00:14:59,870
حول الرّسالة على ورقة صفراء

295
00:15:00,580 --> 00:15:01,540
هل هو

296
00:15:01,950 --> 00:15:03,790
يبحث عن

297
00:15:03,790 --> 00:15:04,540
نيان هوا؟

298
00:15:05,870 --> 00:15:06,870
ما أدراكِ؟

299
00:15:07,410 --> 00:15:09,450
لستِ بشريّة

300
00:15:09,450 --> 00:15:12,200
أهوى القصص فحسب

301
00:15:12,540 --> 00:15:13,410
ماذا حدث لاحقاً؟

302
00:15:15,120 --> 00:15:16,580
هذا غريب

303
00:15:17,000 --> 00:15:19,120
،علّمتُه كيفيّة استدعائها

304
00:15:19,450 --> 00:15:21,580
لكنّه فشل لسبب ما

305
00:15:21,580 --> 00:15:22,830
لا يستطيع رؤية الرّوح فحسب

306
00:15:22,830 --> 00:15:24,330
ماذا عسايّ أفعل؟

307
00:15:24,330 --> 00:15:25,700
لا يستطيع رؤيتها؟

308
00:15:28,410 --> 00:15:29,870
يبدو أنّك كاذب فعلاً

309
00:15:30,200 --> 00:15:30,870
!كلام فارغ

310
00:15:31,040 --> 00:15:31,580
...أنا

311
00:15:32,000 --> 00:15:34,490
،لستُ قادراً حقّاً على رؤية الأرواح

312
00:15:34,500 --> 00:15:36,950
!لكن طريقة الاستدعاء صحيحة

313
00:15:36,950 --> 00:15:38,080
،فضلاً عن ذلك

314
00:15:38,080 --> 00:15:39,910
،حتّى لو أردتُ الاحتيال لأجل المال

315
00:15:39,910 --> 00:15:41,990
!لن أجرؤ على الاحتيال على فينغ وول

316
00:15:42,540 --> 00:15:44,370
اسمه فينغ وول؟

317
00:15:44,370 --> 00:15:45,990
ألا تعرفينه؟

318
00:15:47,120 --> 00:15:48,240
...لقد

319
00:15:48,250 --> 00:15:49,330
التقينا مرّة

320
00:15:51,370 --> 00:15:54,080
حريّ بكِ أن تبقي بعيدة عنه

321
00:15:55,500 --> 00:15:56,660
،فينغ وول

322
00:15:56,660 --> 00:15:59,080
السيّاف رقم واحد في العالم

323
00:15:59,080 --> 00:16:00,330
يستطيع قطع رأس أيّ شخص

324
00:16:00,330 --> 00:16:01,660
متى أراد

325
00:16:02,160 --> 00:16:03,410
كيف أجرؤ

326
00:16:03,410 --> 00:16:05,370
!وأكذب على السيّاف الأفضل

327
00:16:05,870 --> 00:16:09,540
لكن رغم ذلك، يريد قتلي

328
00:16:09,540 --> 00:16:12,990
في النّهاية، اضطررتُ للاعتماد على
فتاة صغيرة كي أهرب

329
00:16:24,870 --> 00:16:25,740
،في الواقع

330
00:16:25,750 --> 00:16:27,290
أخبرتُك بأنّه سيأتي ويقبض علينا

331
00:16:27,290 --> 00:16:28,990
...فينغ وول... أنت

332
00:16:30,950 --> 00:16:32,240
لم أتوقّع أن تلحق بي

333
00:16:32,250 --> 00:16:34,080
!حسناً إذاً

334
00:16:34,500 --> 00:16:35,740
،إذا أردت قتلي

335
00:16:35,750 --> 00:16:36,540
...فأنا

336
00:16:36,540 --> 00:16:38,240
!سأدع هذه الفتاة تموت معي

337
00:16:39,370 --> 00:16:40,990
على مهلك

338
00:16:41,000 --> 00:16:41,870
،إذا شوّهتني

339
00:16:41,870 --> 00:16:43,200
فلن أملك فرصة للقاء بالرّجل الّذي أحبّه

340
00:16:43,750 --> 00:16:45,290
،فضلاً عن أنّ حنجرتي هنا

341
00:16:45,290 --> 00:16:46,660
أمسكت للتو بالمكان الخطأ

342
00:16:46,660 --> 00:16:47,490
!اصمتي

343
00:16:47,830 --> 00:16:50,620
يبدو أنّكِ تستمتعين بقضاء وقتكِ كرهينة

344
00:16:51,370 --> 00:16:52,830
لأنّك سوف تنقذني

345
00:16:55,870 --> 00:16:57,580
أنا هنا لحصد لسانه

346
00:16:58,580 --> 00:17:00,790
،قلتُ لم أكذب عليك! فينغ وول

347
00:17:00,790 --> 00:17:02,830
!أنت غير منطقي

348
00:17:03,500 --> 00:17:05,830
أنا من عليه قول ذلك

349
00:17:05,830 --> 00:17:07,200
...النّجدة! لا ت قتلني

350
00:17:13,410 --> 00:17:14,290
كنتَ سريعاً

351
00:17:15,120 --> 00:17:16,330
،لو لم أتحفّظ في سحب سيفي

352
00:17:17,160 --> 00:17:18,660
لاخترقَ سيفي دماغك

353
00:17:21,660 --> 00:17:22,580
!جرس ذهبيّ؟

354
00:17:22,910 --> 00:17:25,040
أنتِ... الآنسة تاو ياو

355
00:17:25,040 --> 00:17:26,370
...من مدينة تاو

356
00:17:28,160 --> 00:17:29,410
ماذا قال للتو؟

357
00:17:30,080 --> 00:17:31,290
لا شيء، كلام فارغ

358
00:17:32,040 --> 00:17:33,080
عقاقيري

359
00:17:33,080 --> 00:17:34,450
تستطيع أن تنوّمه لثلاثة أيّام

360
00:17:38,200 --> 00:17:39,540
إنّ الشّخص الجيّد

361
00:17:39,870 --> 00:17:41,040
لا يحمل عقاقيرَ معه

362
00:17:41,700 --> 00:17:43,450
أو يساعد مُحتالين

363
00:17:44,910 --> 00:17:46,740
السيّاف الأفضل في العالم

364
00:17:46,750 --> 00:17:48,990
لا ينبغي أن يقتل عجوزاً لا يعرف سوى الهرب

365
00:17:49,370 --> 00:17:50,660
تعلّمَ درسه

366
00:17:51,950 --> 00:17:53,240
كلّ من يحتالون عليّ

367
00:17:53,750 --> 00:17:54,790
يجب أن يموتوا

368
00:17:55,620 --> 00:17:56,950
،أجل، هو محتال

369
00:17:57,660 --> 00:17:58,990
لكن لا يجرؤ على الاحتيال عليك

370
00:18:04,200 --> 00:18:05,060
،يا سيّد

371
00:18:05,290 --> 00:18:06,870
،غير نبضات قلبك المتضرّر

372
00:18:07,160 --> 00:18:08,620
هل تعاني أيضاً من التهاب مُخاطيّة الأنف؟

373
00:18:08,620 --> 00:18:10,080
ألم تشتمّ شيئاً؟

374
00:18:13,040 --> 00:18:14,490
ركّز على الرّائحة

375
00:18:15,160 --> 00:18:17,370
هل تشتمّ رائحة خفيفة

376
00:18:17,370 --> 00:18:18,660
لعطر زهور؟

377
00:18:19,370 --> 00:18:19,990
أجل

378
00:18:21,330 --> 00:18:22,490
عقاقيرك؟

379
00:18:24,750 --> 00:18:25,830
نيان هوا

380
00:18:26,080 --> 00:18:27,120
وُلِد

381
00:18:27,700 --> 00:18:28,740
من توبة البشر

382
00:18:29,540 --> 00:18:31,660
ووحده رجل التّوبة من يستطيع استدعاءها

383
00:18:32,830 --> 00:18:34,240
استدعيتها أنت

384
00:18:37,000 --> 00:18:37,990
ماذا قلتِ؟

385
00:18:38,830 --> 00:18:39,620
نيان هوا

386
00:18:39,950 --> 00:18:40,830
موجودة هناك

387
00:18:47,450 --> 00:18:48,040
،هراء

388
00:18:48,500 --> 00:18:49,870
،إذا كانت تلك الرّوح بجانبي حقّاً

389
00:18:50,450 --> 00:18:51,450
فلماذا لا أستطيع رؤيتها؟

390
00:18:52,660 --> 00:18:53,910
...يبدو أنّه

391
00:18:53,910 --> 00:18:54,950
عالِق؟

392
00:18:55,330 --> 00:18:57,330
في الواقع، استدعيتها منذ مدّة طويلة

393
00:18:58,200 --> 00:19:00,490
،هناك خيط خفيّ يربطكما معاً

394
00:19:01,040 --> 00:19:01,950
،وأينما ذهبت

395
00:19:01,950 --> 00:19:02,790
تتبعك

396
00:19:09,000 --> 00:19:09,830
أين هو ذلك الخيط؟

397
00:19:10,410 --> 00:19:11,330
كيف لي أن أراه؟

398
00:19:11,790 --> 00:19:12,830
،يمكنني مساعدتك

399
00:19:13,290 --> 00:19:14,370
لكن عليك أن تخبرني

400
00:19:14,700 --> 00:19:15,700
لماذا تريد رؤيته

401
00:19:16,160 --> 00:19:17,290
وما شأنكِ أنتِ؟

402
00:19:18,040 --> 00:19:18,870
أيّاً يكن

403
00:19:19,290 --> 00:19:20,620
ليس هناك ما أتحسّر عليه بخلافك

404
00:19:20,950 --> 00:19:22,580
بالمناسبة، هناك حدّ زمنيّ للاستدعاء

405
00:19:22,950 --> 00:19:24,740
أهدرتَ كثيراً من الوقت

406
00:19:26,040 --> 00:19:27,660
الآن

407
00:19:29,000 --> 00:19:30,290
بقي أقلّ من أربع ساعات

408
00:19:30,290 --> 00:19:31,200
!سوف تختفي نيان هوا

409
00:19:32,080 --> 00:19:32,580
...هل

410
00:19:32,870 --> 00:19:33,450
...تقصدين

411
00:19:34,040 --> 00:19:36,580
لن تتمكّن من استدعاء نيان هوا ثانية

412
00:19:37,950 --> 00:19:38,950
الوقت يُدركك

413
00:19:39,290 --> 00:19:41,370
أنا جهة الاتّصال الوحيدة بينك وبين نيان هوا

414
00:19:41,700 --> 00:19:43,080
وحدي من يستطيع مساعدتك في تحقيق أمنيتك

415
00:19:43,500 --> 00:19:44,620
كفّ عن التردّد

416
00:19:45,540 --> 00:19:47,660
لمَ تتجسّسين على خصوصيّتي؟

417
00:19:48,620 --> 00:19:49,870
لا داعي لتعرف

418
00:19:50,080 --> 00:19:50,910
لديّ أسبابي

419
00:19:52,660 --> 00:19:53,450
،أيّتها الصّغيرة

420
00:19:54,160 --> 00:19:55,240
،إذا كذبتِ عليّ

421
00:19:55,700 --> 00:19:57,910
فلن أرحمكِ

422
00:20:22,290 --> 00:20:23,240
!!أخي الصّغير

423
00:20:27,450 --> 00:20:28,160
...أنا

424
00:20:29,930 --> 00:20:31,180
خنتُ شخصاً