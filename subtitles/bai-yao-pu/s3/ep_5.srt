1
00:00:23,710 --> 00:00:24,920
،واحد

2
00:00:25,420 --> 00:00:26,810
،اثنان

3
00:00:26,810 --> 00:00:28,160
،ثلاثة

4
00:00:28,160 --> 00:00:28,880
...أربعة

5
00:00:32,710 --> 00:00:33,880
،ستّة عشر

6
00:00:34,360 --> 00:00:35,650
...سبعة عشر

7
00:00:36,600 --> 00:00:37,830
،لديك الوقت لتسرحي في التفكير

8
00:00:37,830 --> 00:00:38,890
لكن ليس لإطعام الدجاج

9
00:00:39,500 --> 00:00:41,390
كانت هي من أرادت تربيتكم في المقام الأوّل

10
00:00:46,580 --> 00:00:48,170
سيّد ليو، عُدت

11
00:00:48,170 --> 00:00:49,120
حامل التجفيف قد تعطّل

12
00:00:49,120 --> 00:00:50,080
،هل يمكنك إصلاحه سريعاً

13
00:00:50,080 --> 00:00:51,400
وإلّا لا نستطيع تعليق ملابسنا للتجفيف

14
00:00:51,960 --> 00:00:54,210
لا تملكين مالاً لشراء ملابس، فما
هو الشيء الّذي يحتاج للتجفيف؟

15
00:00:55,230 --> 00:00:56,410
الثّعلب يسرق الدّجاج من جديد

16
00:01:14,800 --> 00:01:17,250
رولي، ألم تكن ستصبح نباتيّاً؟

17
00:01:17,250 --> 00:01:18,930
لمَ لا تستطيع ضبط نفسك؟

18
00:01:20,180 --> 00:01:21,320
لا جدوى من ادّعاء الموت

19
00:01:21,320 --> 00:01:24,000
لنتكلّم عن قيمة الحياة

20
00:01:24,000 --> 00:01:25,140
كفّا عن الجدال

21
00:01:25,140 --> 00:01:26,330
أنا أحصي

22
00:01:28,000 --> 00:01:29,900
تحصين كم بقي لدينا من مال؟

23
00:01:30,170 --> 00:01:33,650
أحصي كم روحاً عالجتُ حتّى الآن

24
00:01:33,650 --> 00:01:35,080
كم أنتِ رخيّة البال

25
00:01:35,080 --> 00:01:36,420
،عوضاً عن إحصاء الأرواح

26
00:01:36,420 --> 00:01:37,910
لمَ لا تقلقين بشأن ألبوم الجنّيات؟

27
00:01:38,250 --> 00:01:40,390
لمَ أراكِ غير مستعجلة على الإطلاق؟

28
00:01:41,120 --> 00:01:41,910
أنا كذلك

29
00:01:42,210 --> 00:01:43,750
،أتوتّر وأكتئب كلّ يوم

30
00:01:43,750 --> 00:01:44,910
ولا أستطيع النّوم ليلاً

31
00:01:44,910 --> 00:01:47,410
انظر إلى الهالات السّوداء تحت عينيّ

32
00:01:48,210 --> 00:01:50,380
لا يمكنكِ النوم ومع ذلك تشخرين بصوتٍ عال

33
00:01:51,420 --> 00:01:52,920
،جسدي نائم

34
00:01:52,920 --> 00:01:54,050
لكن روحي ما زالت تفكّر

35
00:01:55,040 --> 00:01:57,010
وهل أفضى هذا التفكير إلى حلّ؟

36
00:01:58,080 --> 00:01:59,920
ولا حتّى فكرة

37
00:01:59,920 --> 00:02:03,120
فقط أنّ ألبوم الجنّيات خُتِمَ عليه منذ زمن
بعيد، ويحبّ الحركة والتنقّل من مكان لآخر

38
00:02:03,120 --> 00:02:04,420
لا بدّ أنّه في العاصمة

39
00:02:04,420 --> 00:02:05,810
لنستغرق وقتنا في إيجاده فحسب

40
00:02:05,810 --> 00:02:07,630
حسناً، يمكنك استغراق وقتكِ في إيجاده

41
00:02:08,080 --> 00:02:10,520
لكن لا نستطيع حتّى تسديد إيجار الشّهر المقبل

42
00:02:11,290 --> 00:02:13,770
لا أملك مالاً، لذا لا جدوى من إخباري

43
00:02:14,130 --> 00:02:17,210
إذا علمَ الشّخص في مدينة تاو بأنّ
،ألبوم الجنّيات كان مفقوداً

44
00:02:17,210 --> 00:02:18,150
ماذا سيحدث

45
00:02:18,830 --> 00:02:19,660
--لن تجرؤ

46
00:02:21,960 --> 00:02:23,160
جرّبيني

47
00:02:23,480 --> 00:02:24,180
--أنت

48
00:02:27,830 --> 00:02:30,790
سأبحث عن عمل غداً، حسناً؟

49
00:02:31,540 --> 00:02:32,760
هذا أفضل

50
00:02:33,580 --> 00:02:34,670
مكافأة لكِ

51
00:02:35,870 --> 00:02:39,380
رأيتُ نُزُلاً في السّوق يُدعى تينغفينغلو قبل مدّة

52
00:02:39,670 --> 00:02:41,680
كان هناك الكثير من إعلانات العمل المُلصقة في الدّاخل

53
00:02:41,680 --> 00:02:43,180
يمكنكِ تفقّدها

54
00:02:43,560 --> 00:02:44,900
أنا أراقبكِ

55
00:02:48,020 --> 00:02:49,640
تينغينغلو

56
00:02:56,170 --> 00:02:57,490
!رولي

57
00:03:34,670 --> 00:03:35,920
سيّد لي من البوّابة الجنوبيّة

58
00:03:35,920 --> 00:03:37,420
مطلوب حجّار

59
00:03:37,420 --> 00:03:38,800
الرّاتب قابل للتفاوض

60
00:03:39,400 --> 00:03:40,620
سيّد وانغ من البوّابة الشرقيّة

61
00:03:40,620 --> 00:03:41,960
مطلوب متدرّبين

62
00:03:41,960 --> 00:03:43,140
يشمل غرفة ومأكل

63
00:03:43,800 --> 00:03:45,090
المعذرة، المعذرة

64
00:03:52,040 --> 00:03:53,440
بيت سي يطلب عمّالاً أيضاً

65
00:03:54,170 --> 00:03:56,990
أجل. نادراً ما أرى لافتتهم

66
00:03:56,990 --> 00:03:57,790
لنجرّب ذلك

67
00:03:57,790 --> 00:03:58,500
لا أريد

68
00:03:58,500 --> 00:04:00,380
الأخوان في عائلة سي سيّئان

69
00:04:00,380 --> 00:04:02,170
هناك شياطين أحياء حقّاً وليس مزحة

70
00:04:02,500 --> 00:04:03,660
هذا صحيح

71
00:04:04,170 --> 00:04:05,170
لنتفقّد الطلبات الأخرى

72
00:04:06,390 --> 00:04:08,870
عائلة سي تطلب حِرفيّاً

73
00:04:08,870 --> 00:04:09,890
رجل أو امرأة

74
00:04:10,370 --> 00:04:12,250
،يُفضّل من لديهم خبرة في الإطعام

75
00:04:12,250 --> 00:04:13,690
براتب مُغرٍ

76
00:04:13,690 --> 00:04:17,840
من لديه اهتمام، فليذهب إلى بيت سي في نهر
شينغمينغ ويبحث عن ربّ المنزل مياو

77
00:04:17,840 --> 00:04:18,900
،يا سيّد

78
00:04:20,580 --> 00:04:21,900
من تكون عائلة سي؟

79
00:04:21,900 --> 00:04:24,290
لماذا لا تريدون العمل هناك؟

80
00:04:24,290 --> 00:04:26,410
يا آنسة، لستِ من هذه الأرجاء، صحيح؟

81
00:04:27,680 --> 00:04:29,170
لم يمضِ على وجودي هنا طويلاً

82
00:04:29,170 --> 00:04:30,500
،لا أملك مالاً كثيراً

83
00:04:30,500 --> 00:04:32,340
وأردتُ البحث عن عمل جيّد

84
00:04:33,370 --> 00:04:36,080
بيت سي ذاك ليس مكاناً جيّداً

85
00:04:36,080 --> 00:04:37,500
ينبغي أن تذهبي إلى مكان آخر

86
00:04:37,500 --> 00:04:39,080
...ليس مكاناً جيّداً

87
00:04:39,080 --> 00:04:41,090
هل يبتزّون النّاس مثلاً؟

88
00:04:42,000 --> 00:04:43,750
يوجد شيطانان حيّان هناك

89
00:04:43,750 --> 00:04:45,330
هل تعتقدينه مكاناً جيّداً؟

90
00:04:45,330 --> 00:04:46,430
...شيطانان حيّان

91
00:04:46,830 --> 00:04:48,800
ماذا تفعل عائلة سي هذه بالضبط؟

92
00:04:53,710 --> 00:04:56,460
الناس هنا لا يجرؤون على التكلّم عن عائلة سي

93
00:04:56,460 --> 00:04:59,150
لكن نظراً إلى أنّكِ جديدة هنا، سأخبركِ

94
00:04:59,650 --> 00:05:02,290
يُقال بأنّ الأخوين المسؤولين عن بيت سي

95
00:05:02,290 --> 00:05:04,330
لا يمارسان عملاً لائقاً

96
00:05:04,330 --> 00:05:07,370
أشخاص متعطّشون للدماء يدخلون ويخرجون من البيت

97
00:05:07,370 --> 00:05:08,730
هذا مخيف جدّاً

98
00:05:08,730 --> 00:05:10,910
إذا كانت لديك مشكلة مستعصية، فإنّ
بيت سي سوف يحلّها

99
00:05:10,910 --> 00:05:14,330
بالطبع، هناك كثير من الأعمال المُريبة
الّتي تشمل القتال والقتل

100
00:05:14,330 --> 00:05:16,920
حتّى السّلطات تخاف منهم قليلاً

101
00:05:17,670 --> 00:05:20,580
ختاماً، أنصحكِ بألّا تفكّري في الأمر حتّى

102
00:05:20,580 --> 00:05:22,580
ضغائن المُنافسة هي الأكثر رُعباً

103
00:05:22,580 --> 00:05:24,330
لا تعلمين متى قد يظهر عدوّ

104
00:05:24,330 --> 00:05:25,670
!هذا يجلب الكوارث

105
00:05:25,930 --> 00:05:26,880
هكذا إذاً

106
00:05:26,880 --> 00:05:28,180
هل العائلة ثريّة؟

107
00:05:28,710 --> 00:05:29,960
أجل، هي كذلك

108
00:05:30,750 --> 00:05:32,120
أنا مُطمئنّة إذاً

109
00:05:32,120 --> 00:05:33,520
كيف أصل إلى نهر شينغمينغ؟

110
00:05:34,330 --> 00:05:35,540
ستذهبين؟

111
00:05:35,540 --> 00:05:37,370
هل تدركين مدى خطورة ذلك المكان؟

112
00:05:37,370 --> 00:05:38,580
سيناديكِ الشّيطان إلى الموت في منتصف اللّيل

113
00:05:38,580 --> 00:05:40,210
لن تعيشي لتري النّور

114
00:05:40,210 --> 00:05:42,170
بيت سي هو الجحيم بعينه

115
00:05:42,170 --> 00:05:43,290
،تدخلين حيّة

116
00:05:43,290 --> 00:05:45,030
لكن تخرجين زاحفة على شفير الموت

117
00:05:45,420 --> 00:05:46,170
هذا صحيح

118
00:05:46,170 --> 00:05:47,540
كيف تجرؤ على الذّهاب؟

119
00:05:47,540 --> 00:05:48,840
!أجل، أجل

120
00:05:49,330 --> 00:05:51,780
يا سيّد، أنا فقيرة جدّاً

121
00:05:52,210 --> 00:05:53,870
،أخي لا يعاملني بشكل جيّد

122
00:05:53,870 --> 00:05:55,910
ولا يعطيني طعاماً ولا لباساً

123
00:05:55,910 --> 00:05:59,290
وحتّى أنّه قال بأنّني إذا لم أستطع
،إيجاد عمل اليوم وكسب المال

124
00:05:59,290 --> 00:06:01,960
!فسوف يطردني من المنزل حينها

125
00:06:03,550 --> 00:06:04,740
حسناً

126
00:06:05,460 --> 00:06:06,980
،تخرجين من وانشينغمين

127
00:06:06,980 --> 00:06:08,590
،وتتوجّهين غرباً لسبعة أو ثمانية أميال

128
00:06:08,590 --> 00:06:11,540
"وسترين حجراً حدوديّاً نُقِش عليه "نهر شينغمينغ

129
00:06:11,540 --> 00:06:12,860
،ثمّ تعبرين جسراً حجريّاً

130
00:06:12,860 --> 00:06:14,010
،وتجتازين غابة من أشجار الخيزران

131
00:06:14,430 --> 00:06:15,950
ثمّ سترين بيت سي

132
00:06:40,870 --> 00:06:42,170
إنّه هادئ جدّاً

133
00:06:51,670 --> 00:06:53,210
من هناك؟

134
00:06:55,080 --> 00:06:56,540
أبحث عن ربّ المنزل مياو

135
00:06:56,540 --> 00:06:58,710
قرأتُ بأنّكم طلبتم حِرفيّاً في تينغفينغلو

136
00:06:58,710 --> 00:06:59,690
!أنا هنا للتقدّم

137
00:07:07,500 --> 00:07:09,330
أنا ربّ المنزل مياو

138
00:07:09,330 --> 00:07:11,280
أنتِ هنا للتقدّم لوظيفة الحِرفيّ يا آنسة؟

139
00:07:12,250 --> 00:07:13,780
ألم يرِد أنّه قد يكون رجلاً أو امرأة؟

140
00:07:14,580 --> 00:07:15,280
هذا صحيح

141
00:07:15,720 --> 00:07:16,620
تفضّلي بالدخول

142
00:07:40,580 --> 00:07:43,150
هذا... هو الجحيم؟

143
00:07:53,750 --> 00:07:54,590
من فضلك

144
00:08:14,460 --> 00:08:15,680
سانسي

145
00:08:17,960 --> 00:08:18,980
أين أبوك؟

146
00:08:26,080 --> 00:08:27,910
خرجَ للتسوّق إذاً

147
00:08:27,910 --> 00:08:29,650
حسناً. تابعي من فضلكِ

148
00:08:39,200 --> 00:08:41,660
هذه إسطبلاتنا

149
00:08:41,660 --> 00:08:46,330
الخيول في الدّاخل هي كنوز جمعها مولايّ
الصّغير من حول العالم

150
00:08:46,330 --> 00:08:47,670
نحن نوظّف حرفيّاً في هذه الفترة

151
00:08:47,960 --> 00:08:49,500
فقط لإطعام الخيول

152
00:08:50,420 --> 00:08:54,000
المعذرة، لم أسألكِ عن اسمكِ أو عمركِ بعد

153
00:08:54,000 --> 00:08:55,380
من أين أنتِ؟

154
00:08:57,750 --> 00:08:58,920
...حسناً

155
00:08:58,920 --> 00:09:00,040
كنيتي هي تاو

156
00:09:00,040 --> 00:09:01,170
"تاو كما في "خوخ

157
00:09:01,170 --> 00:09:02,290
...اسمي

158
00:09:03,270 --> 00:09:05,020
ياوياو. تاو ياوياو

159
00:09:06,650 --> 00:09:08,040
سأبلغ الـ17 هذا العام

160
00:09:08,040 --> 00:09:09,150
أنا من إقليم سيتشان

161
00:09:09,150 --> 00:09:11,530
سأعيش في العاصمة في المستقبل

162
00:09:11,960 --> 00:09:13,510
تاو ياوياو

163
00:09:14,620 --> 00:09:18,060
يبدو أنّ الآنسة تاو هي الابنة الأصغر في العائلة

164
00:09:19,720 --> 00:09:21,040
أجل، أجل

165
00:09:21,040 --> 00:09:22,040
هذا صحيح

166
00:09:22,040 --> 00:09:24,660
هل تحتاج الحِرفيّ لإطعام الخيول فقط؟

167
00:09:25,540 --> 00:09:27,500
لكن لا تستهيني بهذا العمل

168
00:09:27,500 --> 00:09:30,830
هذه الخيول هي المُفضّلة لدى مولايّ

169
00:09:30,830 --> 00:09:32,500
تحتاج لإطعام بعناية

170
00:09:32,500 --> 00:09:34,380
لا يجوز أن ترتكبي خطأ

171
00:09:35,670 --> 00:09:38,480
هل كانت هذه الفتاة تُطعم الخيول من قبل؟

172
00:09:38,480 --> 00:09:39,390
أجل

173
00:09:39,660 --> 00:09:41,120
اسمها دينغ سانسي

174
00:09:41,120 --> 00:09:43,710
هي وأبوها كانا في بيت سي
لأزيد من عشر سنوات

175
00:09:43,710 --> 00:09:47,710
ولا خيل من الخيول الّتي اعتنوا بها
قد واجه مشكلة

176
00:09:47,710 --> 00:09:51,500
قبل سنوات، رتّبَ أبوها لزواجها في ديارهم

177
00:09:51,500 --> 00:09:53,750
كلاهما قرّرا الاستقالة والعودة إلى الدّيار

178
00:09:53,750 --> 00:09:55,690
لا يمكننا إجبارهما على البقاء

179
00:09:55,690 --> 00:09:59,490
لهذا وضعنا إعلاناً في تينغفينغلو
بحثاً عن بديل

180
00:09:59,830 --> 00:10:02,550
إنّها صمّاء، مع ذلك تستطيع الاعتناء
بكثير من الخيول

181
00:10:02,550 --> 00:10:04,240
إنّها مذهلة

182
00:10:04,560 --> 00:10:07,290
ربّ المنزل مياو، أخبرتني بأمور كثيرة

183
00:10:07,290 --> 00:10:08,620
هل قرّرت أن أتولّى عنها؟

184
00:10:08,960 --> 00:10:10,670
،بعد وضع الإعلان

185
00:10:10,670 --> 00:10:12,870
أنتِ الوحيدة الّتي تقدّم للوظيفة

186
00:10:12,870 --> 00:10:14,380
لا يوجد غيركِ

187
00:10:14,790 --> 00:10:16,380
هل أنا الوحيدة حقّاً؟

188
00:10:17,710 --> 00:10:21,170
لعلّ الآخرين خائفون من مولايّ الصّغير

189
00:10:21,170 --> 00:10:24,500
،آنسة تاو، إن كنتِ مستعدّة للعمل هنا

190
00:10:24,500 --> 00:10:27,210
لنوقّع العقد حالاً

191
00:10:30,020 --> 00:10:32,310
إذاً لماذا يخشون مولاك الصّغير؟

192
00:10:32,310 --> 00:10:34,510
لديه مزاج سيّئ

193
00:10:35,210 --> 00:10:36,790
،لكن لا تقلقي

194
00:10:36,790 --> 00:10:40,160
عادة لا تحظين بفُرص كثيرة لِلّقاء بمولايّ الصّغير

195
00:10:44,250 --> 00:10:46,710
...أنا فقط لا أعرف الرّاتب

196
00:10:46,710 --> 00:10:48,920
ليس عليكِ القلق بشأن ذلك أيضاً

197
00:10:48,920 --> 00:10:51,880
لم يقصّر مولايّ الصّغير يوماً بشأن الأجور

198
00:10:55,880 --> 00:10:56,790
!أجل، أجل

199
00:10:56,790 --> 00:10:58,050
يُسعدني إطعام الخيول

200
00:10:58,670 --> 00:11:00,210
،وفقاً لقواعد عائلة سي

201
00:11:00,210 --> 00:11:02,000
العقد الأوّلي هو لنصف عام

202
00:11:02,000 --> 00:11:03,210
اعملي لعشرة أيّام واحصلي على يوم إجازة

203
00:11:03,210 --> 00:11:04,750
يشمل ذلك ثلاث وجبات ومكان إقامة

204
00:11:04,750 --> 00:11:06,670
،عادة إن لم تكن هناك أسباب خاصّة

205
00:11:06,670 --> 00:11:08,640
لا يمكنكِ مغادرة بيت سي

206
00:11:09,080 --> 00:11:12,400
إذا انتهت مدّة العقد، فهو قابل للتمديد بموافقة الطرفين

207
00:11:12,400 --> 00:11:14,620
حسناً. سأعود وأحزم أمتعتي

208
00:11:14,620 --> 00:11:16,000
سأعود في صباح الغد للعمل

209
00:11:17,750 --> 00:11:19,830
وجدتُ عملاً لكسب المال في غضون يوم

210
00:11:19,830 --> 00:11:21,750
،ليس عليّ مواصلة العيش في ذلك المنزل المهترئ

211
00:11:21,750 --> 00:11:24,120
وليس عليّ أكل طبخ السيّد ليو

212
00:11:24,120 --> 00:11:26,400
!تبدو الحياة مُشرقة فجأة

213
00:11:55,500 --> 00:11:56,630
روح

214
00:12:09,500 --> 00:12:12,070
بيت سي هذا مُثير جدّاً للاهتمام

215
00:12:21,380 --> 00:12:22,870
!عزيزي زوجي

216
00:12:22,870 --> 00:12:25,500
من الآن فصاعداً، ستعتمد عائلتنا عليك للدعم

217
00:12:25,500 --> 00:12:27,180
!عُد في الوقت

218
00:12:27,180 --> 00:12:29,170
...سنفتقد

219
00:12:29,170 --> 00:12:30,890
راتبك...

220
00:12:32,870 --> 00:12:34,170
...أيّها الوحش الخرف

221
00:12:34,170 --> 00:12:35,400
!عسى أن يصعقك الرّعد

222
00:12:37,030 --> 00:12:38,900
التقيت بسانسي بالفعل

223
00:12:38,900 --> 00:12:40,460
أنا والدها، دينغ الأكبر

224
00:12:40,460 --> 00:12:41,620
تعلّمي جيّداً

225
00:12:41,620 --> 00:12:43,400
في وقت لاحق، ستعتمد الإسطبلات عليكِ

226
00:12:53,250 --> 00:12:55,420
كما يقول المثل، لا يمكنك إرضاء الجميع

227
00:12:55,760 --> 00:12:57,880
كذلك الخيول في بيت سي

228
00:12:58,190 --> 00:13:00,720
لديهم طِباع وأذواق مختلفة

229
00:13:01,170 --> 00:13:02,380
فهذا يحبّ الطعام الجافّ

230
00:13:02,670 --> 00:13:04,380
وهذا يأكل الطعام الحلو

231
00:13:04,380 --> 00:13:05,870
وذاك يحبّ المالح

232
00:13:05,870 --> 00:13:08,390
!ومِلعقتا ملح لذلك الّذي هناك

233
00:13:43,000 --> 00:13:44,250
!بسرعة

234
00:13:44,250 --> 00:13:45,880
شارف وقت الإطعام على الانتهاء

235
00:13:47,000 --> 00:13:48,390
!كوني أسرع

236
00:13:48,390 --> 00:13:49,670
هناك خيول أخرى تحتاج للطعام

237
00:13:49,670 --> 00:13:51,040
!لا تتأخّري

238
00:13:56,500 --> 00:13:58,340
أتعرّض للإجهاد في العمل

239
00:13:58,870 --> 00:14:00,910
!وكأنّني حصان

240
00:14:09,710 --> 00:14:12,380
لطالما كان أبي صارماً جدّاً

241
00:14:12,380 --> 00:14:13,800
هذا مُرهِق لك

242
00:14:14,750 --> 00:14:15,750
أنا بخير، أنا بخير

243
00:14:15,750 --> 00:14:18,160
أنا جديدة وينبغي أن أتمرّن أكثر

244
00:14:19,200 --> 00:14:20,290
هذا صحيح

245
00:14:20,290 --> 00:14:22,280
عادة تكونين أنتِ ووالدكِ هنا فقط

246
00:14:23,170 --> 00:14:25,960
سمعتُ ربّ المنزل يقول بأنّكِ
هنا منذ عشر سنوات

247
00:14:25,960 --> 00:14:28,170
إذاً ألم تكوني في السّابعة أو الثّامنة
عندما أتيتِ إلى بيت سي؟

248
00:14:30,250 --> 00:14:33,040
هل بيت سي هذا مخيف كما تفيد الإشاعات؟

249
00:14:39,620 --> 00:14:41,620
تكونين عادة في الإسطبلات

250
00:14:41,620 --> 00:14:42,810
لذا لا تخرجين وتتسلّين؟

251
00:14:46,170 --> 00:14:48,170
،عليكِ العناية بالخيول

252
00:14:48,170 --> 00:14:50,160
وإلّا فلن يكون مولاكِ الصّغير سعيداً

253
00:14:50,580 --> 00:14:52,960
بالتأكيد ليس عليكِ مراقبتهم طوال الوقت

254
00:14:52,960 --> 00:14:54,340
السيّد الصّغير غير منطقيّ حقّاً

255
00:15:00,960 --> 00:15:02,210
حسناً، حسناً

256
00:15:02,210 --> 00:15:03,500
أسأتُ فهمه

257
00:15:03,500 --> 00:15:05,460
لدى السيّد الصّغير قليل من الأصدقاء ويحبّ الخيول

258
00:15:05,460 --> 00:15:07,370
إنّه أقرب إلى خيول منه إلى بشر، صحيح؟

259
00:15:08,460 --> 00:15:09,510
...على ذكر الأمر

260
00:15:09,960 --> 00:15:12,010
تفهمين سيّدكِ الصّغير جيّداً

261
00:15:33,080 --> 00:15:34,580
الأمر هكذا إذاً

262
00:15:34,580 --> 00:15:36,200
إنّه وسيم حقّاً

263
00:16:24,750 --> 00:16:26,920
نظراً إلى أنّ السيّد الصّغير الأكبر
،لم يعد من رحلته

264
00:16:26,920 --> 00:16:28,670
أعتقد بأنّ هذا هو السيّد الصّغير الثّاني

265
00:16:31,870 --> 00:16:33,040
،بفضلك

266
00:16:33,040 --> 00:16:35,240
التقيتُ أخيراً بقائدنا النّائب

267
00:16:35,240 --> 00:16:37,890
إنّه أنيق ولبق وراقٍ

268
00:16:38,320 --> 00:16:40,730
إنّه ليس كالشّيطان المُشاع عنه الّذي يبتزّ النّاس

269
00:16:42,750 --> 00:16:43,640
هل تحبّينه؟

270
00:16:49,000 --> 00:16:49,940
ماذا؟

271
00:16:52,040 --> 00:16:53,750
إذا كنتِ تحبّينه فهذا يعني أنّكِ تحبّينه

272
00:16:53,750 --> 00:16:55,030
ما المُحرج في ذلك؟

273
00:17:01,210 --> 00:17:02,250
حسناً، حسناً

274
00:17:02,250 --> 00:17:03,670
لن أقول مزيداً من الكلام

275
00:17:05,370 --> 00:17:07,380
لكن ما اسمه؟

276
00:17:28,870 --> 00:17:30,150
الاسم لا يتطابق مع الشخص

277
00:17:30,500 --> 00:17:32,650
إنّه أهدأ من صخرة

278
00:17:41,620 --> 00:17:43,010
أنتِ تكتفين بالنظر فقط

279
00:17:43,540 --> 00:17:44,790
ينبغي أن تُعلميه على الأقلّ

280
00:17:49,500 --> 00:17:52,550
سأغادر للزواج

281
00:17:53,290 --> 00:17:55,750
،لستُ مناسبة لمولايّ الصّغير

282
00:17:55,750 --> 00:17:57,680
لذا لن أفكّر بأيّ أفكار غير لائقة

283
00:17:58,000 --> 00:17:59,680
...القدرة على لقائه

284
00:18:00,460 --> 00:18:01,540
كافية...

285
00:18:08,790 --> 00:18:09,710
...إذاً

286
00:18:10,120 --> 00:18:12,710
هل الشّخص في دياركِ جيّد؟

287
00:18:18,670 --> 00:18:19,660
عظيم إذاً

288
00:18:21,670 --> 00:18:22,580
،بما أنّ الأمر كذلك

289
00:18:22,580 --> 00:18:23,790
لنتابع حتّى النهاية

290
00:19:11,060 --> 00:19:13,370
ما الّذي يدعو للإحراج؟

291
00:19:13,370 --> 00:19:15,330
أنتِ تلقين نظرة فحسب

292
00:19:15,330 --> 00:19:17,300
كما يُقال، من الفظاظة عدم المعاملة بالمثل

293
00:19:17,300 --> 00:19:18,290
ساعدتني كثيراً

294
00:19:18,290 --> 00:19:19,880
سأساعدك حتماً

295
00:19:19,880 --> 00:19:20,870
أصغي إليّ

296
00:19:20,870 --> 00:19:23,460
فكّرتُ في طريقة لجعل حجر الأساس أكثر ثباتاً

297
00:19:23,460 --> 00:19:24,300
تعالي لنجرّبها

298
00:19:31,870 --> 00:19:32,810
باختصار

299
00:19:32,810 --> 00:19:34,650
السيّد الصّغير مُتعة للناظرين حقّاً

300
00:19:34,650 --> 00:19:36,580
،يمكنني أن أقارن بثلاثة أطباق

301
00:19:36,580 --> 00:19:38,650
لا بل بثلاثين طبق من الأرزّ

302
00:20:30,170 --> 00:20:31,450
إنّه لطيف ودافئ حقّاً

303
00:21:14,250 --> 00:21:15,420
هل من الممتع التعرّض للضرب كلّ يوم؟

304
00:21:15,870 --> 00:21:16,870
ما شأنكِ أنتِ؟

305
00:21:16,870 --> 00:21:18,670
أنت تؤرق نومي

306
00:21:18,670 --> 00:21:20,760
لحظة، هل يمكنك رؤيتي؟

307
00:21:21,620 --> 00:21:23,670
وهل تعتقدني أتكلّم مع شجرة؟

308
00:21:24,080 --> 00:21:26,670
عاداتكم أنتم يون يانغ لا تتغيّر أبداً

309
00:21:26,670 --> 00:21:28,390
تحبّون العيش في الأشجّار أينما حللتُم

310
00:21:37,330 --> 00:21:38,540
تعرفينني فعلاً

311
00:21:38,540 --> 00:21:39,400
من تكونين؟

312
00:21:46,420 --> 00:21:47,660
كنيتي هي تاو

313
00:21:47,660 --> 00:21:48,990
...تاو

314
00:21:49,920 --> 00:21:51,160
--أنتِ تاو من مدينة تاو

315
00:21:51,160 --> 00:21:53,420
لا توقظ النّاس النّائمين

316
00:21:55,040 --> 00:21:56,660
ساعديني على استعادة جناحي

317
00:21:56,660 --> 00:21:58,540
أحتاج جناحاً آخر بشكل عاجل

318
00:21:58,540 --> 00:22:00,710
أخبرني أوّلاً إلى أين ذهبَ جناحُك

319
00:22:03,040 --> 00:22:06,250
في الخريف، من السّهل لنا نحن
،اليون يانغ أن نخسر ريشاً

320
00:22:06,250 --> 00:22:07,880
كما تخسر الشّجرة أوراقها

321
00:22:08,150 --> 00:22:09,370
أعلم

322
00:22:09,370 --> 00:22:11,890
لكن السّؤال هو: هل فقدت جناحيك حقّاً؟

323
00:22:13,290 --> 00:22:14,960
،أردتُ التمرّن سابقاً

324
00:22:14,960 --> 00:22:17,710
وقرّرتُ التّحليق عشر دورات حول
الإسطبلات كلّ يوم

325
00:22:17,710 --> 00:22:20,900
ذات يوم حلّقتُ بعنف، فسقطَ جناح

326
00:22:25,650 --> 00:22:27,110
!أنتِ طبيبة

327
00:22:27,110 --> 00:22:28,570
!هل ينبغي أن تضحكي على مريض؟

328
00:22:29,200 --> 00:22:30,210
حسناً، حسناً

329
00:22:30,210 --> 00:22:31,340
لن أضحك

330
00:22:32,710 --> 00:22:33,950
إذاً أين سقط جناحك؟

331
00:22:34,250 --> 00:22:36,790
أُخِذَ بواسطة روح فأر لصنع عشّ

332
00:22:36,790 --> 00:22:38,870
،أسألها كلّ يوم لكنّها لا تعيده

333
00:22:38,870 --> 00:22:40,820
لذا أذهب وأزعجها بشكل يوميّ

334
00:22:41,330 --> 00:22:42,790
،هل سوف تزعجها

335
00:22:42,790 --> 00:22:44,050
أم تتلقّى الضرب؟

336
00:22:45,340 --> 00:22:47,870
،لو لم أخسر جناحاً وأفقد قوايّ

337
00:22:47,870 --> 00:22:49,340
لما كانت ندّاً لي

338
00:22:49,600 --> 00:22:52,080
انتظر حتّى الرّبيع وسينمو جناحك الجديد

339
00:22:52,080 --> 00:22:53,870
لمَ تهمّ نفسك بمقاتلة فأر؟

340
00:22:53,870 --> 00:22:55,500
سيكون الأوان قد فات

341
00:22:55,500 --> 00:22:57,560
،إن لم أستعد جناحي مع بداية الشّهر المقبل

342
00:22:57,560 --> 00:23:01,000
فلن تحظى دينغ سانسي بفرصة التكلّم
مع السيّد الصّغير الثّاني

343
00:23:01,000 --> 00:23:04,070
أنت على عجلةٍ لاستعادة جناحك لأجلها؟

344
00:23:06,540 --> 00:23:09,450
في الواقع، تبعتُها إلى هنا

345
00:23:09,820 --> 00:23:11,620
كانت هنا لعشر سنوات

346
00:23:11,620 --> 00:23:13,420
كنتُ هنا لعشر سنوات أيضاً

347
00:23:14,870 --> 00:23:16,420
...في ذلك اليوم

348
00:23:20,670 --> 00:23:22,720
ظننتُني سأموت