1
00:00:26,630 --> 00:00:29,790
،عندما تُوضع هذه الفاوانيا على رأس مولاتي

2
00:00:29,790 --> 00:00:32,020
!يصبح جميلاً حقّاً

3
00:00:32,020 --> 00:00:33,290
ليس تماماً

4
00:00:33,290 --> 00:00:35,890
الزهرة الجميلة تلائم الشّخص الجميل

5
00:00:37,790 --> 00:00:39,390
وُلِدت مولاتي حسناء

6
00:00:39,670 --> 00:00:42,580
في المستقبل، ستجد زوجاً جيّداً حتماً

7
00:00:42,580 --> 00:00:44,220
هذا صحيح

8
00:01:43,500 --> 00:01:45,290
كعكة حلوة، كعكة حلوة

9
00:01:45,290 --> 00:01:48,890
متى سأتمكّن من الانسجام مع إله الرّعد؟

10
00:01:50,580 --> 00:01:51,380
تابعوا

11
00:01:51,380 --> 00:01:53,300
على مهلكم مع النقّالة

12
00:02:05,170 --> 00:02:05,920
بسرعة

13
00:02:05,920 --> 00:02:06,880
انقلوها للداخل

14
00:02:09,880 --> 00:02:12,230
مولايّ الصّغير الثّاني، لماذا خرجت؟

15
00:02:33,080 --> 00:02:34,710
أسرعوا وخذوا مولايّ الصّغير الأكبر إلى المنزل

16
00:02:39,880 --> 00:02:40,880
،مولايّ الصّغير الثّاني

17
00:02:40,880 --> 00:02:42,850
طلب منّي مولايّ يوي أن أخبرك

18
00:02:43,100 --> 00:02:46,440
بأنّ مولايّ الصّغير الأكبر قد تعرّض
لحادث في تشانغداومين

19
00:02:46,440 --> 00:02:49,880
مولايّ يوي سيحضر هديّة معه كاعتذار في المستقبل

20
00:02:51,500 --> 00:02:54,460
،يأمل بأن يكون كلا السيّدين الشابّين كريمين

21
00:02:54,460 --> 00:02:56,660
وألّا يغضبا من تشانغداومين

22
00:02:56,660 --> 00:03:00,040
السيّد يوي قد اختطف تقريباً كلّ الأطبّاء
الشّهيرين في لويانغ

23
00:03:00,040 --> 00:03:01,530
لا شيء آخر يمكن فعله

24
00:03:01,800 --> 00:03:03,420
،كنّا خائفين من التّغيّرات في الطريق

25
00:03:03,420 --> 00:03:06,870
لذا كان علينا السّفر ليلاً ونهاراً لإعادة
السيّد الأكبر إلى منزلك

26
00:03:06,870 --> 00:03:07,670
شكراً لكم

27
00:03:08,630 --> 00:03:10,040
،بما أنّ أخي عاد إلى المنزل

28
00:03:10,040 --> 00:03:11,800
سأعتني به من الآن فصاعداً

29
00:03:11,800 --> 00:03:13,420
آسف لأنّنا لا نستطيع التّرحيب بكم في المنزل

30
00:03:13,420 --> 00:03:14,900
نظراً لقلّة عدد العاملين

31
00:03:14,900 --> 00:03:16,300
عُد من فضلك يا سيّد جين

32
00:03:18,500 --> 00:03:20,420
إذاً سأعود وأبلغ عن أنّ المهمّة قد اكتملت

33
00:03:20,420 --> 00:03:21,870
لن أزعجك أكثر من ذلك

34
00:03:21,870 --> 00:03:23,360
،إذا احتجت للمساعدة في المستقبل

35
00:03:23,360 --> 00:03:24,510
فأبلغني رجاء

36
00:03:28,750 --> 00:03:30,580
يا له من طفل جاهل

37
00:03:30,580 --> 00:03:32,300
لا يقدّم لك حتّى كأس من الشّاي يا مولايّ

38
00:03:33,000 --> 00:03:34,330
،إنّه في ريعان شبابه

39
00:03:34,330 --> 00:03:36,020
لذا أمر محتوم

40
00:03:36,540 --> 00:03:40,720
أخشى أن تسبّب طبيعة السيّد الصّغير الثّاني
مشكلات له في المستقبل

41
00:03:42,330 --> 00:03:45,040
لا أعتقد أنّ لعائلة سي هذه نفوذ كبير

42
00:03:45,040 --> 00:03:47,830
نحن تشانغداومين نُعَدُّ إحدى أفضل
الجماعات في لويانغ

43
00:03:47,830 --> 00:03:49,660
لمَ نكترث لآرائهم؟

44
00:03:49,660 --> 00:03:51,290
لا تتكلّم بطيش

45
00:03:51,290 --> 00:03:53,130
يُقال بأنّ الشّيطان يحدّد الحياة أو الموت

46
00:03:53,130 --> 00:03:54,880
عائلة سي تحلّ النّزاعات

47
00:03:55,330 --> 00:03:57,040
،رغم أنّها ليست جماعة

48
00:03:57,040 --> 00:03:59,370
،ولا يطلبون مالاً أو نفوذاً

49
00:03:59,370 --> 00:04:01,270
ومع ذلك يقبلون كلّ طلب

50
00:04:01,270 --> 00:04:05,460
لذا عندما يواجه النّاس مشكلة
،لا يستطيعون حلّها

51
00:04:05,460 --> 00:04:07,020
يلجؤون إليهم

52
00:04:08,250 --> 00:04:13,610
على المدى الطويل، أصبح معظم النّاس أصدقاءهم

53
00:04:13,610 --> 00:04:15,040
...لكن

54
00:04:15,040 --> 00:04:16,270
...لا تتفوّه بالمزيد

55
00:04:16,270 --> 00:04:18,380
ربّما يطلب الزعيم طلباً منهم في المستقبل

56
00:04:18,380 --> 00:04:20,230
لا يمكننا أن نكون عدوانيّين كثيراً

57
00:04:26,130 --> 00:04:27,220
الآنسة تاو

58
00:04:28,000 --> 00:04:29,660
ماذا تفعلين هنا؟

59
00:04:30,510 --> 00:04:31,660
ربّ المنزل مياو

60
00:04:31,990 --> 00:04:34,420
يبدو أنّكِ تتبلّلين، ولا تحملين مظلّة

61
00:04:36,210 --> 00:04:39,550
قبل قليل، كان السيّد الصّغير الأكبر
مستلقياً على النقّالة

62
00:04:39,860 --> 00:04:40,950
هذا صحيح

63
00:04:40,950 --> 00:04:44,210
وقعَ مكروه للسيّد الصّغير الأكبر
،وكان يُحمل عبر النقّالة

64
00:04:44,210 --> 00:04:45,490
لذا ألا ينبغي أن نحقّق في الأمر؟

65
00:04:50,170 --> 00:04:52,180
من الصّعب تجنّب الخطر عندما تتعلّق
الأمور بالجماعات

66
00:04:52,610 --> 00:04:54,670
السيّد الصّغير الأكبر ليس يقظاً
مثل السيّد الصّغير الثّاني

67
00:04:54,670 --> 00:04:56,910
وهذه ليست المرّة الأولى الّتي يُحمَل فيها

68
00:04:56,910 --> 00:04:57,830
لا تقلقي

69
00:04:57,830 --> 00:04:59,480
السيّد الصّغير الثّاني لديه طريقته الخاصّة

70
00:05:00,210 --> 00:05:01,790
،من نبرة صوتك

71
00:05:01,790 --> 00:05:03,840
الأخ الأكبر أسوأ من الأخ الأصغر

72
00:05:05,380 --> 00:05:06,790
ليس عليكِ السّؤال حول ذلك

73
00:05:06,790 --> 00:05:08,540
اعتني بالخيول فحسب

74
00:05:08,540 --> 00:05:11,290
حالما يمضي على وجودكِ هنا بعض
الوقت، ستعرفين طبيعة السيّد

75
00:05:13,460 --> 00:05:14,460
--لكن سمعتُ أنّه

76
00:05:14,460 --> 00:05:15,500
تأخّر الوقت

77
00:05:15,500 --> 00:05:17,660
سأذهب إلى المطبخ لأطلب من الطبّاخ
أن يغيّر القائمة

78
00:05:17,660 --> 00:05:18,900
اذهبي وقومي بعملكِ فحسب

79
00:07:12,880 --> 00:07:13,660
...هل يُعقَل أنّه

80
00:07:27,520 --> 00:07:28,550
السيّد الصّغير الثّاني

81
00:07:30,340 --> 00:07:31,680
إصبعك تنزف

82
00:07:36,830 --> 00:07:38,180
كفّ عن مقاتلتي

83
00:07:38,180 --> 00:07:40,550
أنت تدمّر الخيزران الجميل

84
00:07:49,790 --> 00:07:50,900
كفّ عن عزفها

85
00:07:50,900 --> 00:07:51,970
غادري

86
00:07:52,920 --> 00:07:55,960
هذه الموسيقى التي بلا أوتار تخترق
السّماء والأرض لتستدعي أرواحاً هائمة

87
00:07:55,960 --> 00:07:58,160
ولا واحد من مليون يستطيع عزف مثل هذه الموسيقى

88
00:07:58,500 --> 00:08:00,700
وحدها الأجساد التي بلا روح
يمكنها استدعاء الأرواح

89
00:08:00,700 --> 00:08:02,520
،بما أنّ السيّد الصّغير الثّاني الأكبر لديه روح

90
00:08:02,520 --> 00:08:05,170
لن تنجح حتّى لو عزفت بما يكفي
لكسر أصابعك

91
00:08:11,380 --> 00:08:13,080
ظننتُك خبيراً

92
00:08:13,080 --> 00:08:14,890
لا أصدّق بأنّك لا تستطيع حتّى رؤية هذا

93
00:08:17,020 --> 00:08:18,290
لن أكذب عليك

94
00:08:18,290 --> 00:08:19,180
انظر إلى هذا

95
00:08:21,040 --> 00:08:24,510
الجسد بلا روح سيكون لديه ثقب بين حاجبيه

96
00:08:24,510 --> 00:08:26,900
لكن لا يوجد شيء كهذا هنا

97
00:08:27,210 --> 00:08:28,350
ثقب؟

98
00:08:29,750 --> 00:08:31,230
ليس ثقباً فعليّاً

99
00:08:31,230 --> 00:08:33,150
...كيف أشرح

100
00:08:34,670 --> 00:08:36,590
،كما يُقال في الطبّ

101
00:08:36,590 --> 00:08:37,630
بشرة سيّئة

102
00:08:38,290 --> 00:08:39,580
،عندما تملأ الرّوح الجسد

103
00:08:39,580 --> 00:08:41,410
فإنّ الفراغ بين الحاجبين يبدو ممتلئاً

104
00:08:41,410 --> 00:08:43,790
خلاف ذلك، سيكون الفراغ غائراً

105
00:08:43,790 --> 00:08:45,420
،يبدو السيّد الصّغير الأكبر هكذا

106
00:08:45,420 --> 00:08:47,170
لذا هو حتماً ليس بلا روح

107
00:08:48,380 --> 00:08:49,880
...لكنّكِ لا تُطعمين سوى الخيول

108
00:08:49,880 --> 00:08:51,880
وهل هذا يعني بأنّني لا أطالع
الكتُب الطبّية؟

109
00:08:52,190 --> 00:08:54,060
،رغم أنّني حِرفيّة

110
00:08:54,060 --> 00:08:55,710
أبقى عضوة في عائلة سي

111
00:08:55,710 --> 00:08:58,500
لا أريد أن أرى كلا السيّدين الصّغيرين يواجهان مشكلة

112
00:08:58,500 --> 00:09:01,390
وإلّا من سيسدّد أجري؟

113
00:09:03,500 --> 00:09:05,310
،إذا استطعتِ قول كلام نافع

114
00:09:05,310 --> 00:09:06,880
فسأدفع لكِ عشرة أضعاف

115
00:09:07,420 --> 00:09:08,810
،لكن إذا تفوّهتِ بكلام فارغ

116
00:09:09,790 --> 00:09:11,530
فلن أسامحكِ بسهولة

117
00:09:12,540 --> 00:09:15,170
هذه أوّل مرّة يتكلّم معي السيّد
الصّغير الثّاني فيها كثيراً هكذا

118
00:09:15,170 --> 00:09:16,910
أنا حقّاً غير معتادة على ذلك

119
00:09:17,710 --> 00:09:20,200
بما أنّ هناك روح، فلماذا لا يستيقظ؟

120
00:09:25,910 --> 00:09:27,330
نبضه ضعيف

121
00:09:27,330 --> 00:09:29,220
تناول كثيراً من المُهدِّئات

122
00:09:29,220 --> 00:09:31,040
كلّ ما عليك فعله هو إيجاد طبيب

123
00:09:31,040 --> 00:09:32,880
لوصف بعض المُحفِّزات

124
00:09:33,140 --> 00:09:35,170
ألا يمكنك وصفها بنفسك؟

125
00:09:35,170 --> 00:09:38,390
رغم ذلك، أخشى أن يقتله هراؤكِ

126
00:09:38,990 --> 00:09:40,690
...أنا لا أعالج النّاس

127
00:09:41,170 --> 00:09:43,580
،أعني بأنّ للسيّد الصّغير الأكبر مكانة نبيلة

128
00:09:43,580 --> 00:09:44,580
وليس شخصاً عاديّاً

129
00:09:44,580 --> 00:09:46,630
من الأفضل البحث عن طبيب مشهور

130
00:09:49,500 --> 00:09:50,710
اذهبي وأحضري ربّ المنزل مياو

131
00:09:50,710 --> 00:09:51,430
حاضرة

132
00:09:53,710 --> 00:09:55,130
هل تريد دواء ليديك؟

133
00:09:55,130 --> 00:09:56,150
لا تقلقي بشأن ذلك

134
00:09:56,150 --> 00:09:56,920
اذهبي

135
00:10:13,380 --> 00:10:15,540
لا أعرف من تكونون

136
00:10:15,540 --> 00:10:17,510
لا أريد أن أعرف أيضاً

137
00:10:17,510 --> 00:10:20,930
عـ-على أيّ حال، لن يحبّني أحد

138
00:10:23,000 --> 00:10:25,170
لماذا لا تقتلونني فحسب؟

139
00:10:25,170 --> 00:10:28,390
إن كنتُ ميّتاً، سأعيش بسلام

140
00:10:28,390 --> 00:10:30,250
!لا تفعل يا سيّدي الصّغير الاكبر

141
00:10:30,250 --> 00:10:31,630
!لا تلمسني

142
00:10:31,630 --> 00:10:34,270
لستُ سيّدك الصّغير الأكبر

143
00:10:32,060 --> 00:10:33,230
السيّد الصّغير الأكبر؟

144
00:10:33,230 --> 00:10:34,270
ماذا تفعل؟

145
00:10:34,270 --> 00:10:35,880
!لا يمكنك

146
00:10:35,880 --> 00:10:38,290
أنتِ الابنة الكبرى من عائلة يوي؟

147
00:10:38,290 --> 00:10:39,430
يوي بينغتشان

148
00:10:40,750 --> 00:10:42,510
أجل، لكن ماذا يعني؟

149
00:10:42,920 --> 00:10:45,290
لا جدوى من الشّرح أكثر

150
00:10:45,290 --> 00:10:46,460
دعني

151
00:10:46,460 --> 00:10:49,160
دعني أحرّر نفسي

152
00:10:50,540 --> 00:10:51,640
،سيّدي الصّغير الثّاني

153
00:10:51,640 --> 00:10:53,920
أخشى أنَّ السيّد الصّغير الأكبر تبادل
روحيّاً مع الآنسة يوي

154
00:10:53,920 --> 00:10:55,060
إنّه في الجسد الخطأ

155
00:10:55,630 --> 00:10:57,080
،إن كنتِ الآنسة يوي

156
00:10:57,080 --> 00:10:58,800
فلماذا أنتِ في جسد أخي؟

157
00:10:59,670 --> 00:11:00,930
لا أعلم

158
00:11:01,920 --> 00:11:03,970
،بعد أن دختُ وغلبني النّعاس

159
00:11:04,460 --> 00:11:05,680
...شعرتُ فقط أنّ

160
00:11:07,890 --> 00:11:11,360
!أحدهم قبّلني...

161
00:11:11,360 --> 00:11:14,010
لكن لم أرَ من يكون

162
00:11:15,440 --> 00:11:19,800
ثمّ تمّ الاستحواذ عليّ ورُميت في الخارج

163
00:11:19,800 --> 00:11:20,900
...عندما استيقظت

164
00:11:23,290 --> 00:11:25,160
!دعوني أموت فحسب

165
00:11:25,160 --> 00:11:26,060
!سيّدي الصّغير الأكبر

166
00:11:33,670 --> 00:11:35,880
آنسة تاو، ساعديني هنا

167
00:11:45,380 --> 00:11:47,750
سيّدي الصّغير الثّاني، هذا جسد أخيك

168
00:11:47,750 --> 00:11:49,290
لماذا لم توقفه؟

169
00:11:49,290 --> 00:11:50,810
إذا مات، فسيعمّ الهدوء

170
00:11:50,810 --> 00:11:53,080
سيّدي الصّغير الثّاني، لا تكن هكذا

171
00:11:53,080 --> 00:11:55,170
تعرف طبع سيّدي الصّغير الأكبر

172
00:11:55,170 --> 00:11:56,830
،من الوضع الحالي

173
00:11:56,830 --> 00:11:59,530
ألا تعتقد بأنّ عليك الذّهاب إلى لويانغ؟

174
00:12:00,830 --> 00:12:02,530
أحضر السجلّ

175
00:12:02,530 --> 00:12:04,930
لا داعي، أستطيع تذكّره

176
00:12:06,080 --> 00:12:09,040
في أوائل الشّهر الماضي، أتى السيّد
يوي شخصيّاً لتقديم طلب

177
00:12:09,390 --> 00:12:12,440
قال بأنّ ابنته الوحيدة، يوي بينغتشان، كانت
في الأصل ذات شخصيّة مبتهجة

178
00:12:12,440 --> 00:12:15,590
،لكنّها أمست مكتئبة منذ وفاة حبيبها

179
00:12:16,630 --> 00:12:18,500
لم تبتسم لعامين

180
00:12:18,500 --> 00:12:21,430
تمكث في غرفتها وتبكي طوال اليوم

181
00:12:21,830 --> 00:12:24,510
هذا الجسد يضعف تدريجيّاً

182
00:12:25,500 --> 00:12:27,300
،جرّب السيّد يوي وصفات كثيرة

183
00:12:27,300 --> 00:12:28,980
لكن بلا فائدة

184
00:12:28,980 --> 00:12:32,040
،في النّهاية، اعتُقِد بأنّ الميّت لديه امتعاض شديد

185
00:12:32,040 --> 00:12:33,710
ليزعج الابنة ويرفض المغادرة

186
00:12:33,710 --> 00:12:35,840
لذا طلب منه المساعدة

187
00:12:38,170 --> 00:12:39,790
في ذلك اليوم، لم يكن السيّد
الصّغير الثّاني هناك

188
00:12:39,790 --> 00:12:42,380
يحتاج السيّد الصّغير الأكبر بيانات
ولادة الآنسة يوي

189
00:12:42,380 --> 00:12:43,530
،قال بأنّه لن يتأخّر

190
00:12:43,530 --> 00:12:45,590
وكان يتجوّل في أرجاء بيت يوي

191
00:12:46,630 --> 00:12:48,670
،في الماضي، كان الأخ الأكبر يتسكّع في الخارج

192
00:12:48,670 --> 00:12:51,010
ولم يعد إلى المنزل لنصف عام

193
00:12:51,010 --> 00:12:52,790
...من كان يتوقّع أنّ في هذا الوقت

194
00:12:52,790 --> 00:12:54,740
حضّر الحصان الأسرع

195
00:12:54,740 --> 00:12:55,510
حسناً

196
00:12:58,160 --> 00:12:59,670
لماذا ما زال يتصرّف على هواه؟

197
00:12:59,670 --> 00:13:00,900
اذهبي وأحضري "ظلّ" إلى هنا

198
00:13:00,900 --> 00:13:02,300
حاضرة

199
00:13:09,750 --> 00:13:11,190
أنتِ تطعمين الخيول؟

200
00:13:11,190 --> 00:13:12,020
لماذا أتيتِ؟

201
00:13:12,020 --> 00:13:13,420
،إن لم آتِ

202
00:13:13,420 --> 00:13:14,810
فمن سيعتني بـ"ظلّ"؟

203
00:13:16,790 --> 00:13:18,220
لا تقولي كلاماً دون أن تقصديه

204
00:13:18,630 --> 00:13:20,320
هل لديكِ هدف آخر؟

205
00:13:20,580 --> 00:13:21,910
أقول كلاماً دون أن أقصده؟

206
00:13:23,000 --> 00:13:25,880
قلتَ أنّ موت السيّد الصّغير الأكبر سيحقّق الهدوء

207
00:13:25,880 --> 00:13:28,790
في النّهاية، ألم تختر الحصان الأسرع
للوصول إلى لويانغ؟

208
00:13:28,790 --> 00:13:30,780
الرّجال أيضاً لا يقولون ما يقصدونه

209
00:13:30,780 --> 00:13:31,790
--أنت

210
00:13:31,790 --> 00:13:33,660
حسناً، حسناً

211
00:13:33,660 --> 00:13:35,540
أتيتُ لمساعدتك

212
00:13:35,860 --> 00:13:36,800
لا حاجة لذلك

213
00:13:37,170 --> 00:13:39,630
رغم أنّ لديك القدرة على العزف على
،الآلة خالية الأوتار

214
00:13:39,630 --> 00:13:42,170
لا يمكنك رؤية هالة الرّوح المُلوّثة
على جسد السيّد الصّغير الأكبر

215
00:13:42,670 --> 00:13:43,880
هالة الرّوح؟

216
00:13:46,130 --> 00:13:47,790
،يبدو أنّ في هذه الزيارة إلى لويانغ

217
00:13:47,790 --> 00:13:50,890
عليّ أن أفعل أكثر من مجرّد إطعام الحصان

218
00:13:54,960 --> 00:13:56,170
،عندما نصل إلى تشانغداومين

219
00:13:56,170 --> 00:13:57,650
،ما لم أومئ برأسي

220
00:13:57,650 --> 00:13:59,580
لا تتكلّمي مع أيّ شخص آخر

221
00:13:59,580 --> 00:14:01,080
،إذا استطعتِ تقديم المساعدة

222
00:14:01,080 --> 00:14:03,210
فسأدفع لكِ مئة ضعف أجركِ

223
00:14:03,210 --> 00:14:04,900
...لكن إذا سبّبتِ المتاعب لي

224
00:14:05,250 --> 00:14:07,400
لن تسامحني بسهولة، صحيح؟

225
00:14:09,410 --> 00:14:12,170
لكن لستُ بحاجة لأجور مئة ضعف

226
00:14:12,170 --> 00:14:15,630
أريدك فقط أن تلبّي لي طلباً صغيراً

227
00:14:23,500 --> 00:14:25,670
أيّها السيّد الصّغير الثّاني، احتسِ الشّاي من فضلك

228
00:14:28,680 --> 00:14:31,540
كيف حال السيّد الصّغير الأكبر؟

229
00:14:31,540 --> 00:14:33,010
أخي يبلي حسناً

230
00:14:33,380 --> 00:14:36,700
أنا في زيارة هذه المرّة لرؤية الآنسة يوي

231
00:14:37,170 --> 00:14:38,890
من فضلك رتّب الأمور بسرعة

232
00:14:40,830 --> 00:14:41,930
،في هذه الحالة

233
00:14:42,420 --> 00:14:43,560
تفضّل معي من هنا رجاء

234
00:14:50,920 --> 00:14:51,880
،السيّد الصّغير الثّاني

235
00:14:51,880 --> 00:14:53,250
...هذه الفتاة هي

236
00:14:53,250 --> 00:14:54,680
حِرفيّة في بيت سي

237
00:14:54,680 --> 00:14:56,000
،الخيول في البيت ثمينون

238
00:14:56,000 --> 00:14:57,410
ويحتاجونها للاعتناء بهم

239
00:15:00,580 --> 00:15:02,190
،يؤسفني القول بأنّها لم ترَ العالم

240
00:15:02,190 --> 00:15:03,860
ستكون أضحوكة في تشانغداومين

241
00:15:03,860 --> 00:15:05,650
لذا أحضرتُها معي لتتعلّم

242
00:15:12,880 --> 00:15:13,720
المعذرة

243
00:15:16,960 --> 00:15:17,750
آسف

244
00:15:17,750 --> 00:15:20,470
ابنتي تخشى الأضواء، ولا سيّما المصابيح

245
00:15:20,470 --> 00:15:22,540
نستخدم اللّآلئ للإضاءة

246
00:15:30,920 --> 00:15:32,410
مضى عامان

247
00:15:32,750 --> 00:15:35,410
وحتّى أنّني شككتُ بأنّ هذه ابنتي

248
00:15:35,880 --> 00:15:38,920
،في السّابق، كانت تثرثر باستمرار كطائر

249
00:15:38,920 --> 00:15:40,880
وتضحك بلا توقّف من النّهار إلى اللّيل

250
00:15:40,880 --> 00:15:42,010
...لكن الآن

251
00:15:43,290 --> 00:15:45,830
،حتّى لو كانت لا تزال منزعجة بشأن الفتى

252
00:15:45,830 --> 00:15:47,800
لا داعي لتكون هكذا

253
00:15:48,880 --> 00:15:50,790
،كان أخي في لويانغ لأكثر من شهر

254
00:15:50,790 --> 00:15:52,300
لكن لطالما بقي هنا

255
00:15:54,000 --> 00:15:56,230
أجل، هذه غلطتي

256
00:15:56,230 --> 00:15:58,460
ليتني لم ألجأ إلى السيّد الصّغير الأكبر
طلباً للمساعدة

257
00:15:58,460 --> 00:15:59,830
لا داعي لقول المزيد

258
00:15:59,830 --> 00:16:02,020
،أريد فقط معرفة الرّوتين اليومي لأخي هنا

259
00:16:02,390 --> 00:16:04,130
لا سيّما قبل الغيبوبة

260
00:16:08,130 --> 00:16:09,530
،بعد وصول السيّد الصّغير الأكبر

261
00:16:09,790 --> 00:16:11,520
لم يرَ بينغتشان إلّا مرّة واحدة

262
00:16:11,520 --> 00:16:13,790
،بعد ذلك، أخذ يستمتع كلّ يوم

263
00:16:13,790 --> 00:16:15,960
ولم يصطد حشرات اللّيل داخل المنزل

264
00:16:15,960 --> 00:16:20,240
خرجَ واشترى مجموعة من الأشياء
وجعلني أدفع الفاتورة

265
00:16:22,580 --> 00:16:24,370
هل حدث شيء غريب قبل هذا؟

266
00:16:25,290 --> 00:16:28,020
،رأيتُ بأنّه لم يكن ينوي القلق بشأن بينغتشان

267
00:16:28,020 --> 00:16:29,710
وسألتُه عن مخطّطاته

268
00:16:29,710 --> 00:16:30,960
،قال لي ألّا أقلق

269
00:16:30,960 --> 00:16:33,070
وبأنّ الأداة التي احتاجها ستصل إلى هنا قريباً

270
00:16:33,070 --> 00:16:34,080
،بوجوده هنا

271
00:16:34,080 --> 00:16:36,010
ستتحسّن بينغتشان حتماً

272
00:16:37,000 --> 00:16:38,210
،بعد يومين

273
00:16:38,210 --> 00:16:40,330
،دخلَ غرفة بينغتشان

274
00:16:40,330 --> 00:16:42,190
وأخبرنا جميعاً ألّا ندخل

275
00:16:42,190 --> 00:16:44,140
لم يبقَ إلّا شا وي في الدّاخل لتقديم الخدمة

276
00:16:44,470 --> 00:16:45,560
شا وي؟

277
00:16:54,000 --> 00:16:55,500
هذه شا وي

278
00:17:00,290 --> 00:17:01,540
تحيّاتي يا زعيم

279
00:17:02,290 --> 00:17:03,910
كيف كانت مؤخّراً؟

280
00:17:04,180 --> 00:17:06,750
كما العادة يا زعيم

281
00:17:06,750 --> 00:17:08,880
لا يمكنها إلّا شرب السّوائل ولا تستطيع أن تبتلع

282
00:17:10,500 --> 00:17:11,920
ضعي الأشياء هنا

283
00:17:11,920 --> 00:17:13,170
،لا شيء لنفعله اليوم

284
00:17:13,170 --> 00:17:14,380
لذا لا حاجة للمجيء

285
00:17:15,330 --> 00:17:16,270
حاضرة

286
00:17:16,270 --> 00:17:17,440
أستأذن بالانصراف

287
00:17:22,500 --> 00:17:24,890
شا وي هي خادمة بينغتشان الشخصيّة

288
00:17:25,170 --> 00:17:27,920
في ذلك اليوم، السيّد الصّغير الأكبر
جعلَها تبقى داخل الغرفة فقط

289
00:17:27,920 --> 00:17:30,170
انتظرنا حتّى الفجر، لكن لم يخرج أحد

290
00:17:30,170 --> 00:17:31,400
دخلنا لإلقاء نظرة

291
00:17:31,400 --> 00:17:32,920
،كانت بينغتشان تبكي بلا توقّف

292
00:17:32,920 --> 00:17:35,900
وكان كلّ من السيّد الصّغير الأكبر
وشا وي غائبين عن الوعي

293
00:17:37,080 --> 00:17:39,530
وهل قالت شا وي ما حدث بعد الاستيقاظ؟

294
00:17:40,540 --> 00:17:41,470
...في الواقع

295
00:17:41,920 --> 00:17:44,540
...شا وي رأت السيّد الصّغير الأكبر

296
00:17:48,920 --> 00:17:51,880
يقبّل بينغتشان من الفم

297
00:17:51,880 --> 00:17:54,300
بعد ذلك، وقع في غيبوبة

298
00:17:57,380 --> 00:17:59,330
كان أخي لا يتقيّد بأيّ حدود

299
00:17:59,330 --> 00:18:00,250
،إذا كان قد سبّب إهانة

300
00:18:00,250 --> 00:18:01,910
فالرّجاء أن تعذره

301
00:18:02,380 --> 00:18:03,520
،لكن في هذه الحالة

302
00:18:04,140 --> 00:18:06,100
تعرّض أخي للحادثة في الشّهر الماضي

303
00:18:06,100 --> 00:18:08,140
لماذا هو الوحيد الّذي أعيد إلى
بيت سي مؤخّراً؟

304
00:18:09,380 --> 00:18:10,810
هذه غلطتي

305
00:18:10,810 --> 00:18:14,000
ظننتُ بأنّ السيّد الصّغير الأكبر
سوف يستيقظ مثل شا وي

306
00:18:14,000 --> 00:18:17,180
لكن حتّى بعد ثلاثة أيّام، لم يفتح عينيه أبداً

307
00:18:22,920 --> 00:18:24,540
،كنتُ أخشى من أن يلومني السيّد الصّغير الثّاني

308
00:18:24,540 --> 00:18:26,080
لذا بحثتُ عن علاج طبّي في لويانغ

309
00:18:26,080 --> 00:18:27,550
في النّهاية، لم يستطع أحد علاجه

310
00:18:27,920 --> 00:18:29,330
،كنتُ خائفاً من أيّ تغيُّرات إضافيّة

311
00:18:29,330 --> 00:18:32,170
لذا طلبتُ من السيّد جين أن يعيده إلى منزلكم

312
00:18:34,380 --> 00:18:36,630
تعرّض السيّد الصّغير الأكبر لحادث
هنا في تشانغداومين

313
00:18:36,630 --> 00:18:38,290
،إذا أردت أن تقطع رأسي

314
00:18:38,290 --> 00:18:39,300
فلن أقاوم

315
00:18:40,250 --> 00:18:41,670
ليس إلى هذه الدّرجة

316
00:18:41,670 --> 00:18:43,750
لسنا هنا لمعاقبتك

317
00:18:43,750 --> 00:18:46,310
ركوعك يجعل عائلة سي تبدو تافهة

318
00:18:46,710 --> 00:18:48,310
أليس كذلك أيّها السيّد الصّغير الثّاني؟

319
00:18:51,310 --> 00:18:53,670
رأسك لن يتمكّن من شفاء أخي

320
00:18:53,670 --> 00:18:54,770
فما حاجتي له؟

321
00:18:54,770 --> 00:18:56,460
حسناً، حسناً

322
00:18:56,460 --> 00:18:58,460
سيّدنا الصّغير الثّاني منفتح العقل عادة

323
00:18:58,460 --> 00:18:59,540
،بما أنّه قال هذا سلفاً

324
00:18:59,540 --> 00:19:01,260
فليس عليك القلق

325
00:19:02,960 --> 00:19:05,290
شكراً على كرمك

326
00:19:05,670 --> 00:19:08,300
ألم تقل بأنّ الآنسة يوي منزعجة وتبكي طوال اليوم؟

327
00:19:08,300 --> 00:19:09,830
،بالنظر إليها اليوم

328
00:19:09,830 --> 00:19:11,380
تبدو كجثّة حيّة

329
00:19:12,790 --> 00:19:14,880
بعد ثلاثة أو أربعة أيّام من دخول
،السيّد الصّغير الأكبر في غيبوبة

330
00:19:14,880 --> 00:19:18,160
،أصبحت بينغتشان لسبب ما مُنطوية فجأة

331
00:19:18,160 --> 00:19:20,180
وتوقّفت عن الاستجابة للعالم الخارجي

332
00:19:20,830 --> 00:19:22,180
ماذا قالت الخادمة؟

333
00:19:22,600 --> 00:19:26,290
قالت شا وي بأنّ بينغتشان تستطيع
،أن تأكل كثيراً في العادة

334
00:19:26,290 --> 00:19:27,460
،لكن بين ليلة وضحاها

335
00:19:27,460 --> 00:19:28,880
،غير المشي أو الكلام

336
00:19:28,880 --> 00:19:31,130
لم تستطع حتّى الابتلاع

337
00:19:31,130 --> 00:19:33,900
لا يمكنها سوى شرب السّوائل

338
00:19:34,790 --> 00:19:37,500
لا يسعني فعل شيء تجاه ذلك

339
00:19:37,500 --> 00:19:38,880
،إذا استمرّ الأمر هكذا

340
00:19:38,880 --> 00:19:41,650
أخشى ألّا تنجو

341
00:19:42,630 --> 00:19:43,660
،زعيم

342
00:19:43,660 --> 00:19:46,470
ماذا اشترى سيّدنا الصّغير الأكبر وجعلك تسدّد فاتورته؟

343
00:19:47,540 --> 00:19:50,670
كحول ولحم ومستحضرات تجميل

344
00:19:50,670 --> 00:19:53,370
ومصابيح وخيوط قطنيّة وشموع

345
00:19:53,760 --> 00:19:56,040
تذكّر أكثر

346
00:19:57,960 --> 00:19:58,910
هذا صحيح

347
00:19:58,910 --> 00:20:01,010
كان هناك شخص أيضاً أراد أن يتلقّى
الأجر على عمله الدّؤوب

348
00:20:01,010 --> 00:20:02,750
قال بأنّ السيّد الصّغير الأكبر استخدم اسمي

349
00:20:02,750 --> 00:20:05,300
وجمعَ زيت مصابيح من مئة عائلة في المدينة

350
00:20:05,700 --> 00:20:07,180
أين الأغراض الآن؟

351
00:20:07,960 --> 00:20:09,970
ينبغي أن تكون في غرفة المتجر

352
00:20:11,130 --> 00:20:12,880
،ما دام يستطيع إنقاذ ابنتي

353
00:20:12,880 --> 00:20:14,630
،حتّى لو أاراد مدينة لويانغ برمّتها

354
00:20:14,630 --> 00:20:16,520
سأفكّر بطريقة لشرائها

355
00:20:17,290 --> 00:20:18,750
الزعيم شخص سخيّ حقّاً

356
00:20:18,750 --> 00:20:19,670
لا تقلق

357
00:20:19,670 --> 00:20:21,080
ما لم يستطع السيّد الصّغير الأكبر إكماله

358
00:20:21,080 --> 00:20:23,400
سيكتمل بواسطة السيّد الصّغير الثّاني

359
00:20:26,210 --> 00:20:27,160
بجدّية؟

360
00:20:27,720 --> 00:20:29,460
،ما رأيك بهذا؟ اذهب وقُم بعملك

361
00:20:29,460 --> 00:20:30,480
ودعنا نتولّى الباقي

362
00:20:30,480 --> 00:20:31,580
،قبل أن نخرج

363
00:20:31,580 --> 00:20:32,910
لا تسمح لأحد بالدّخول

364
00:20:33,790 --> 00:20:35,380
اترك هذه اللّؤلؤة خلفك فحسب

365
00:20:36,420 --> 00:20:38,170
أليس علينا فعل شيء آخر؟

366
00:20:38,750 --> 00:20:39,670
لا داعي

367
00:20:41,460 --> 00:20:42,920
انتظر الأنباء السارّة فحسب

368
00:20:45,290 --> 00:20:46,550
هل لديكِ فكرة سلفاً عمّا يجب فعله؟

369
00:20:47,380 --> 00:20:49,180
لا تنسَ ما وعدتني به

370
00:20:49,600 --> 00:20:50,980
،أنا لا أنكث بالوعود

371
00:20:50,980 --> 00:20:53,310
ما لم تتفوّهي بكلام فارغ

372
00:20:54,330 --> 00:20:56,310
،إذا كان تخميني صحيحاً

373
00:20:58,330 --> 00:21:00,720
فإنّ روح السيّد الصّغير الأكبر موجودة هناك

374
00:21:09,540 --> 00:21:12,490
لكن الآن، لا يمكنهم الخروج

375
00:21:12,490 --> 00:21:13,440
لا يمكنهم؟

