1
00:00:35,890 --> 00:00:36,970
أنت هنا أخيراً

2
00:00:36,970 --> 00:00:38,180
كنتُ أنتظرك منذ مدّة

3
00:00:39,180 --> 00:00:41,320
،إنّ وادي المئة عشبة بعيد نوعاً ما

4
00:00:41,320 --> 00:00:43,390
لذا تعطّلتُ قليلاً

5
00:00:46,570 --> 00:00:47,650
ادخلي

6
00:00:48,320 --> 00:00:49,240
انظري

7
00:00:49,240 --> 00:00:51,150
ربحتُ كثيراً من منافسات الطبخ

8
00:00:51,150 --> 00:00:53,140
علّمني المُعلّم كلّ شيء

9
00:00:53,140 --> 00:00:55,580
هناك مطاعم كثيرة تريد استئجاري الآن

10
00:00:57,820 --> 00:00:58,910
!أنتِ مذهلة

11
00:00:59,430 --> 00:01:01,470
بفضل "عشبة خروف السّمكة" الّتي أعطيتني إيّاها

12
00:01:01,470 --> 00:01:02,540
!شكراً لكِ

13
00:01:03,780 --> 00:01:08,380
يسرّني أنّكِ أتيتِ في الوقت إلى وادي
المئة عشبة في ذلك اليوم

14
00:01:09,320 --> 00:01:11,170
وضعتُها في ذهني

15
00:01:11,570 --> 00:01:12,520
تعالي

16
00:01:15,880 --> 00:01:17,490
قلتُ بأنّني سأطبخ لكِ

17
00:01:17,490 --> 00:01:18,390
هل يعجبكِ؟

18
00:01:19,820 --> 00:01:20,790
!أجل

19
00:01:24,530 --> 00:01:25,440
ما الأمر؟

20
00:01:27,490 --> 00:01:30,820
أشعر دوماً بأنّني أحلم

21
00:01:33,640 --> 00:01:35,070
وردَ في ألبوم الجنّيات

22
00:01:35,070 --> 00:01:36,860
أنّ هناك شي نانغ في الجبال

23
00:01:36,860 --> 00:01:39,040
،وُلِدَتْ بإحساس وحدة وعزلة السّماء والأرض

24
00:01:39,530 --> 00:01:41,280
يمكن رؤية واحدة في كلّ مئة عام

25
00:01:41,280 --> 00:01:43,410
،برداء أبيض كطفل

26
00:01:43,410 --> 00:01:45,070
،تستطيع شي نانغ النطق

27
00:01:45,070 --> 00:01:46,320
،ولديها لحم ودم

28
00:01:46,320 --> 00:01:47,930
مثل البشر تماماً

29
00:01:47,930 --> 00:01:49,220
،إنّهم طيّبون

30
00:01:49,220 --> 00:01:50,710
ويحبّون الإمساك بأيدي النّاس

31
00:01:51,140 --> 00:01:53,880
،لكن لا يمكنهم الابتعاد عن موطنهم

32
00:01:53,880 --> 00:01:55,360
وإلّا ماتوا

33
00:01:56,530 --> 00:01:58,680
لا أملك القدرة على إعادة الموتى

34
00:01:59,490 --> 00:02:01,680
لا بدّ أنّ خطأ ما قد حدث

35
00:02:01,680 --> 00:02:02,680
ما هو الخطأ؟

36
00:02:02,680 --> 00:02:04,570
هذه أكثر روح عديمة القيمة في العالم

37
00:02:04,570 --> 00:02:05,820
،إنّها واهنة جدّاً

38
00:02:05,820 --> 00:02:07,390
ولا تؤمن بالشرّ

39
00:02:07,390 --> 00:02:09,400
ألم تمُت بينما كانت تمشي؟

40
00:02:09,930 --> 00:02:11,680
لماذا يحدث هذا؟

41
00:02:12,720 --> 00:02:15,810
كلّ ما أرادته الرّوح هو إعطاء تلك
"الفتاة كيس "عشبة خروف السّمكة

42
00:02:21,570 --> 00:02:23,080
عشبة خروف السّمكة"؟"

43
00:02:24,930 --> 00:02:26,410
هذا ليس مستحيلاً

44
00:02:27,660 --> 00:02:29,530
،هذه الرّوح الصّغيرة ميّتة بالفعل

45
00:02:29,530 --> 00:02:31,640
ولا يمكننا أن ندعه يطوف في العالم للأبد

46
00:02:31,640 --> 00:02:33,010
،إذا وجدنا لو شي شي

47
00:02:33,010 --> 00:02:34,720
،يمكننا حينها إنهاء هوَسه

48
00:02:34,720 --> 00:02:36,170
والسّماح له بالمغادرة بسلام

49
00:02:36,970 --> 00:02:37,860
!أجل

50
00:02:37,860 --> 00:02:40,180
!ربّما لو شي شي تبحث عنه أيضاً

51
00:02:40,180 --> 00:02:41,330
!اهدأ

52
00:02:41,930 --> 00:02:44,390
لكن أتّفق مع ما قالته تاو ياو

53
00:02:45,390 --> 00:02:46,310
،أنت ماهر جدّاً

54
00:02:46,310 --> 00:02:47,510
وتعرف كلّ شيء

55
00:02:47,510 --> 00:02:50,370
أرجوك ابحث عن لو شي شي

56
00:02:53,030 --> 00:02:55,220
هذه العاصمة ليست كبيرة جدّاً

57
00:02:55,220 --> 00:02:57,650
ليس من الصّعب لي إيجاد شخص

58
00:02:58,470 --> 00:02:59,780
حقّاً؟

59
00:03:00,930 --> 00:03:03,170
سأحصل على معلومات في غضون يوم

60
00:03:38,180 --> 00:03:39,150
!تعالوا

61
00:03:39,150 --> 00:03:41,150
قال الرّاهب الصّغير

62
00:03:41,150 --> 00:03:44,030
بأنّ منزلي نظيف جدّاً

63
00:03:44,030 --> 00:03:45,910
ماذا لديكم لتقولوا غير ذلك؟

64
00:03:45,910 --> 00:03:47,640
أميتابا. أميتابا

65
00:03:47,640 --> 00:03:48,660
التّناغم والانسجام قيّمان

66
00:03:51,380 --> 00:03:54,180
،الآن بعد أن انكشفت الحقيقة

67
00:03:54,180 --> 00:03:55,470
لن أُحرِجك

68
00:03:55,470 --> 00:03:57,140
فليتراجع الجميع

69
00:03:57,140 --> 00:03:59,470
لن أفرض أجر هذا الشّهر

70
00:03:59,470 --> 00:04:01,900
لا ينبغي أن تُحدِثوا مزيداً من الجلبة

71
00:04:01,900 --> 00:04:03,180
ما رأيك؟

72
00:04:09,140 --> 00:04:10,020
موافق

73
00:04:10,890 --> 00:04:12,320
يا له من حلّ جيّد

74
00:04:12,320 --> 00:04:13,280
أجل

75
00:04:13,280 --> 00:04:14,520
التّناغم والانسجام قيّمان

76
00:04:15,150 --> 00:04:16,890
ما الأمر أيّها الرّاهب الصّغير؟

77
00:04:16,890 --> 00:04:17,640
...عمّتي

78
00:04:17,640 --> 00:04:19,400
!لا، يا آنسة

79
00:04:19,680 --> 00:04:21,470
،لدى غرفتك فينغ شوي جيّد

80
00:04:21,470 --> 00:04:22,570
ومُريحة للإقامة

81
00:04:22,570 --> 00:04:24,910
هل يمكنني المبيت ليوم آخر؟

82
00:04:25,640 --> 00:04:27,430
،كلّما كنتَ أسعد

83
00:04:27,430 --> 00:04:29,570
كان المنزل أفضل

84
00:04:29,570 --> 00:04:30,640
،ليس ليوم واحد فقط

85
00:04:30,640 --> 00:04:32,410
يمكنك المبيت لثلاثة أيّام أُخَر

86
00:04:32,410 --> 00:04:34,220
--شكراً لكِ يا عمـ

87
00:04:34,220 --> 00:04:35,540
يا آنسة

88
00:04:38,530 --> 00:04:40,230
!مُعجّنات

89
00:04:43,640 --> 00:04:45,970
...المُعجّنات الخمسون الّتي وعدتِ بها في الأمس

90
00:04:45,970 --> 00:04:49,310
!ستحصل بالتأكيد على ما وعدتُك به

91
00:04:59,740 --> 00:05:01,820
...هذه

92
00:05:01,820 --> 00:05:03,780
هذه صديقتي تاو ياو

93
00:05:03,780 --> 00:05:05,280
