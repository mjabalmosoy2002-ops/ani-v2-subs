94
00:05:05,280 --> 00:05:06,650
وأتت للاطمئنان عليّ

95
00:05:07,930 --> 00:05:09,160
!مرحباً

96
00:05:09,890 --> 00:05:11,290
مرحباً

97
00:05:11,290 --> 00:05:13,220
بالمُصادَفة، تاو ياو هي طبيبة

98
00:05:13,220 --> 00:05:15,030
أخبرتُها عن مرضك

99
00:05:15,030 --> 00:05:16,170
ترغب في مساعدتك

100
00:05:17,220 --> 00:05:18,180
حقّاً؟

101
00:05:19,530 --> 00:05:21,010
!تذكّرتُ للتو

102
00:05:21,010 --> 00:05:22,680
الرّهبان لا يموتون

103
00:05:22,680 --> 00:05:24,300
أنت راهب جيّد

104
00:05:26,260 --> 00:05:29,120
اقتربي ودعيني ألقي نظرة

105
00:05:32,390 --> 00:05:34,140
نقص في اليانغ

106
00:05:34,470 --> 00:05:36,140
فائض من الين في الدّاخل

107
00:05:36,680 --> 00:05:38,150
يدان وقدمان باردة

108
00:05:38,890 --> 00:05:40,030
مرض مُفزِع

109
00:05:40,490 --> 00:05:41,640
،تطوّر المرض لسنوات كثيرة

110
00:05:41,640 --> 00:05:42,650
وهو راسخ في الأعماق

111
00:05:46,720 --> 00:05:48,410
لكن لا أس، يمكنني علاجك

112
00:05:49,470 --> 00:05:50,890
سأرخي عضلاتك

113
00:05:50,890 --> 00:05:52,160
قد يوقف هذا أعراضك

114
00:05:57,470 --> 00:05:58,670
حسناً

115
00:06:00,240 --> 00:06:01,490
هذه هي الوصفة

116
00:06:01,490 --> 00:06:02,680
،خذ الدواء الموصوف

117
00:06:02,680 --> 00:06:04,120
وستتعافى في غضون شهر

118
00:06:05,220 --> 00:06:06,670
بهذا الشّكل فقط؟

119
00:06:06,930 --> 00:06:09,010
بـ-بالطبع

120
00:06:14,820 --> 00:06:16,570
!شكراً لك أيّها الرّاهب الطيّب

121
00:06:16,570 --> 00:06:18,570
،حالما أعطي "عشبة خروف السّمكة" لـ لو شي شي

122
00:06:18,570 --> 00:06:20,310
يمكنني العودة إلى الدّيار

123
00:06:25,030 --> 00:06:26,220
،على ذكر ذلك

124
00:06:26,220 --> 00:06:29,180
طلبتُ من صديق آخر مساعدتك
،في البحث عن لو شي شي

125
00:06:29,180 --> 00:06:31,160
يستطيع إيجاد أيّ شخص في العالم

126
00:06:32,820 --> 00:06:36,160
أنت حقّاً راهب طيّب

127
00:06:39,240 --> 00:06:41,770
!أتى ما إن ذكرناه

128
00:06:44,890 --> 00:06:45,800
ها هي

129
00:06:49,930 --> 00:06:50,800
تمّ العثور عليها

130
00:06:51,140 --> 00:06:52,240
قالت لو شي شي بأنّها

131
00:06:52,240 --> 00:06:53,680
ستأتي لرؤيتك بعد قليل

132
00:06:54,570 --> 00:06:55,860
!ممتاز

133
00:06:57,680 --> 00:06:58,820
،الرّاهب الصّغير

134
00:06:58,820 --> 00:07:01,430
يعجز لساني عن شكرك حقّاً

135
00:07:01,430 --> 00:07:03,400
لـ-لا شكر على واجب

136
00:07:05,070 --> 00:07:07,150
هل فكّرت بما ستقوله لها؟

137
00:07:08,490 --> 00:07:11,530
لـ-لديّ الكثير لأخبرها به

138
00:07:11,530 --> 00:07:14,910
لا أعرف من أين أبدأ

139
00:07:15,890 --> 00:07:18,410
لنفكّر في الأمر الآن

140
00:07:25,390 --> 00:07:27,180
يا إلهي

141
00:07:27,180 --> 00:07:28,800
يسرّني بأنّها وُجِدَتْ

142
00:07:29,030 --> 00:07:33,260
آمل أن يتذكّر هو ولو شي شي الماضي قريباً

143
00:07:33,260 --> 00:07:36,180
تاو ياو، شكراً لكِ وللسيّد ليو هذه المرّة

144
00:07:36,720 --> 00:07:39,140
!هناك "عشبة خروف السّمكة"، بكلّ سرور

145
00:07:41,770 --> 00:07:42,660
انسَ الأمر

146
00:07:43,140 --> 00:07:45,310
ما دامت النتيجة جيّدة، فكلّ شيء على ما يُرام

147
00:07:45,990 --> 00:07:47,140
ماذا بعد؟

148
00:07:47,140 --> 00:07:48,030
إلى أين سنذهب؟

149
00:07:49,530 --> 00:07:53,580
أتذكّر بأنّنا موعودون من جين سانيانغ
بخمسين من تلك الأشياء

150
00:08:03,140 --> 00:08:04,170
!ادخلي

151
00:08:10,430 --> 00:08:13,010
لـ-لو شي شي

152
00:08:16,800 --> 00:08:19,690
لماذا شكلك لم يتغيّر يا فتى؟

153
00:08:21,030 --> 00:08:22,490
لم تتغيّري البتّة أيضاً

154
00:08:22,490 --> 00:08:24,020
عرفتُكِ فوراً

155
00:08:25,030 --> 00:08:26,320
،عندما سمعتُ بأنّك هنا

156
00:08:26,320 --> 00:08:27,790
لم أصدّق ذلك

157
00:08:28,990 --> 00:08:30,650
انتظرتني فعلاً

158
00:08:31,570 --> 00:08:34,040
عرفتُ بأنّكِ سوف تأتين

159
00:08:34,890 --> 00:08:35,910
!ادخلي

160
00:08:40,660 --> 00:08:43,440
كيف حالك طوال هذه السّنين؟

161
00:08:44,220 --> 00:08:45,420
كنتُ على وشك أن أخبرك

162
00:08:45,890 --> 00:08:47,490
،أصبحتُ طبّاخة

163
00:08:47,490 --> 00:08:49,320
وأعمل في نهر شينغ مينغ

164
00:08:49,320 --> 00:08:51,300
يوميّاً، يأتي الزبائن وفوداً

165
00:08:51,300 --> 00:08:52,970
،بعضهم نيّقون

166
00:08:52,970 --> 00:08:54,230
لكن يمكنني تلبية طلباتهم

167
00:08:56,070 --> 00:08:56,890
ماذا عنك؟

168
00:08:57,760 --> 00:09:00,240
بغضّ النّظر عن مرضي الطفيف، كلّ شيء بخير

169
00:09:00,240 --> 00:09:01,430
،لكن فحصَتني الطبيبة

170
00:09:01,430 --> 00:09:02,810
وقالت بأنّني سأكون بخير قريباً

171
00:09:03,970 --> 00:09:04,810
جيّد

172
00:09:04,810 --> 00:09:06,520
جيّد، هذا جيّد

173
00:09:07,310 --> 00:09:08,720
آنذاك، ألم أقل

174
00:09:08,720 --> 00:09:10,400
بأنّني سأدعوك لتناول وجبة لذيذة؟

175
00:09:10,680 --> 00:09:12,400
تعال وتذوّق طبخي

176
00:09:16,280 --> 00:09:18,020
!يبدو شهيّاً

177
00:09:21,640 --> 00:09:22,540
ما رأيك؟

178
00:09:23,220 --> 00:09:24,030
!شهيّ

179
00:09:24,030 --> 00:09:25,440
شهيّ جدّاً

180
00:09:26,140 --> 00:09:30,120
حلمتُ من قبل بأنّنا تناولنا العشاء معاً

181
00:09:30,640 --> 00:09:32,320
،أصبحتِ طبّاخة شهيرة

182
00:09:32,320 --> 00:09:35,010
وحضّرتِ مائدة من الطعام اللّذيذ

183
00:09:35,010 --> 00:09:38,390
اليوم، تحقّق ذلك أخيراً

184
00:09:50,220 --> 00:09:53,280
وعاء حساء السّمك هذا أفضل
من الأكلات الغريبة

185
00:09:54,220 --> 00:09:55,430
هذا جيّد

186
00:09:55,430 --> 00:09:57,330
كُل! سآكل أيضاً

187
00:10:03,440 --> 00:10:04,530
،بالمناسبة

188
00:10:04,530 --> 00:10:07,290
كان ينبغي أن أعطيكِ هذا مسبقاً

189
00:10:08,240 --> 00:10:11,880
لا أعلم ما إن كان لا يزال مفيداً لكِ

190
00:10:13,490 --> 00:10:16,050
أجل، أجل، سيفيدني بالتأكيد

191
00:10:19,780 --> 00:10:22,030
شكراً لك على إعطائي هذا

192
00:10:22,030 --> 00:10:23,690
سوف أنتفع منه

193
00:10:24,720 --> 00:10:25,720
أجل

194
00:10:25,720 --> 00:10:30,040
هذا الطعام الشهيّ سيجعل كلَّ من يأكله سعيداً

195
00:10:31,280 --> 00:10:32,560
حسناً

196
00:10:37,990 --> 00:10:38,720
تعال

197
00:10:40,410 --> 00:10:42,280
ليس من السّهل أن تدخل المدينة

198
00:10:42,280 --> 00:10:43,070
!هيّا

199
00:10:43,070 --> 00:10:44,660
سآخذك في جولة

200
00:10:45,640 --> 00:10:48,290
لكن لا أستطيع الخروج

201
00:10:49,030 --> 00:10:50,430
،سأمسك بيدك

202
00:10:50,430 --> 00:10:51,380
حينها يمكنك الخروج

203
00:10:52,570 --> 00:10:53,540
حسناً

204
00:11:04,390 --> 00:11:05,180
!تعالوا

205
00:11:05,180 --> 00:11:06,490
!تعالوا واجلسوا

206
00:11:06,490 --> 00:11:07,640
ماذا تريدون أن تأكلوا؟

207
00:11:10,140 --> 00:11:11,570
!‏15 نقداً، 15 نقداً

208
00:11:11,570 --> 00:11:13,150
!كلّ شيء بـ 15 نقداً

209
00:11:17,900 --> 00:11:20,400
!عظيم

210
00:11:22,030 --> 00:11:22,990
!ثانية

211
00:11:25,720 --> 00:11:26,580
!جيّد

212
00:11:28,510 --> 00:11:30,040
إنّه نابض بالحياة

213
00:11:31,930 --> 00:11:34,380
هذه أوّل مرّة آتي فيها إلى مكان نابض بالحياة

214
00:11:35,470 --> 00:11:37,720
عادة آتي إلى هنا عندما يكون لديّ وقت

215
00:11:37,720 --> 00:11:39,680
هناك الكثير لأفعله وآكله هنا

216
00:11:39,680 --> 00:11:42,230
يؤسفني أن تكوني معدتي وعينايّ صغيرتين جدّاً

217
00:11:49,390 --> 00:11:52,890
رؤيتكِ قد حقّقتِ حلمكِ وبلغتِ السّعادة

218
00:11:52,890 --> 00:11:54,400
تعني بأنّني أستطيع العودة إلى
الدّيار دون قلق

219
00:11:55,570 --> 00:11:56,900
هل تريد العودة؟

220
00:11:58,140 --> 00:11:59,530
،رغم أنّ العاصمة حيويّة

221
00:11:59,530 --> 00:12:01,650
لكن وادي المئة عشبة هو موطني

222
00:12:01,890 --> 00:12:03,180
،تواجدتُ في الخارج لفترة طويلة جدّاً

223
00:12:03,180 --> 00:12:04,580
لذا ينبغي أن أعود

224
00:12:08,390 --> 00:12:09,910
حسناً. سأوصلك وأودّعك

225
00:12:10,990 --> 00:12:11,910
حسناً

226
00:12:20,970 --> 00:12:22,390
،كما هو مُتوقّع من العاصمة

227
00:12:22,390 --> 00:12:23,880
حيويّة حتّى في اللّيل

228
00:12:24,570 --> 00:12:25,490
حيويّة؟

229
00:12:25,490 --> 00:12:27,240
لا بدّ من وجود أكشاك مُقامرة كثيرة أيضاً

230
00:12:27,240 --> 00:12:28,680
لا يمكنك الذّهاب

231
00:12:29,720 --> 00:12:30,930
،أتحتُ لك المجال للخروج والاستمتاع

232
00:12:30,930 --> 00:12:32,020
مع ذلك لا أستطيع الاستمتاع؟

233
00:12:32,020 --> 00:12:34,140
انتهينا للتو من الأكل

234
00:12:34,140 --> 00:12:35,520
لا أريدكِ أن تخسري ثانية

235
00:12:38,140 --> 00:12:39,140
انسَ الأمر

236
00:12:39,140 --> 00:12:40,730
لن أجادلك اليوم

237
00:12:42,180 --> 00:12:43,150
إلى أين أنتِ ذاهبة؟

238
00:12:43,150 --> 00:12:44,520
لا أستطيع الذّهاب إلى أكشاك المقامرة

239
00:12:44,520 --> 00:12:45,990
هل يمكنني شراء ملابس جديدة؟

240
00:12:45,990 --> 00:12:49,280
!لا تسرفي مالك

241
00:12:50,390 --> 00:12:51,140
!تعالوا

242
00:12:51,140 --> 00:12:52,470
سنفتتح فرعنا اليوم

243
00:12:52,470 --> 00:12:54,160
!شكراً لدعمكم

244
00:12:54,160 --> 00:12:55,930
يسرّنا وجودكم في محلّنا

245
00:12:55,930 --> 00:12:57,380
!تعالوا! تفضّلوا بالدّخول

246
00:12:57,380 --> 00:12:59,510
!جرّبوا ما تشاؤون

247
00:12:58,010 --> 00:12:59,510
افتتحتْ فرعاً بسرعة

248
00:12:59,510 --> 00:13:00,680
تُجيد إدارة الأعمال حقّاً

249
00:13:00,680 --> 00:13:03,030
!أجل، يا لهما من زوجين رائعين

250
00:13:00,970 --> 00:13:02,290
!أتيت

251
00:13:03,030 --> 00:13:04,430
أريد زوجة كهذه

252
00:13:03,030 --> 00:13:04,670
شكراً، تفضّل بالدّخول

253
00:13:04,430 --> 00:13:06,120
!سيكون كحلم وتحقّق

254
00:13:08,140 --> 00:13:09,680
يبدو هذا المتجر باهظاً جدّاً

255
00:13:09,680 --> 00:13:11,280
!لنعُد

256
00:13:11,280 --> 00:13:12,740
،إن لم أتأنّق جيّداً

257
00:13:12,740 --> 00:13:14,640
ستكون مسؤولاً بالنيابة عن إله الرّعد
عن عدم زواجي في المستقبل

258
00:13:16,650 --> 00:13:17,890
طُرِحت البضاعة الجيّدة بالفعل

259
00:13:17,890 --> 00:13:19,080
!تفضّلوا بالدّخول

260
00:13:22,740 --> 00:13:23,930
تبدين غير مألوفة

261
00:13:23,930 --> 00:13:25,150
أهذه زيارتكِ الأولى هنا؟

262
00:13:25,970 --> 00:13:30,720
هذا اللّون الجديد ملائم لمزاجكِ
الهادئ وقوامكِ الرّشيق

263
00:13:30,720 --> 00:13:31,660
!تفقّديه

264
00:13:32,640 --> 00:13:35,180
هادئ؟ رشيق؟

265
00:13:35,180 --> 00:13:36,620
عمّن تتكلّمين؟

266
00:13:38,930 --> 00:13:40,770
لديكِ عين ثاقبة يا مديرة

267
00:13:41,240 --> 00:13:43,550
لنرَ كيف ستبدو عليكِ هذه المصنوعة النسيجيّة

268
00:13:44,530 --> 00:13:45,550
،إذا اشتريتِ هذا

269
00:13:45,550 --> 00:13:47,390
يمكنكِ صنع العديد من الفساتين

270
00:13:47,390 --> 00:13:50,010
إنّه ليس باهظاً جدّاً، ثمنه 500

271
00:13:50,720 --> 00:13:52,050
خمسمئة؟

272
00:13:56,220 --> 00:13:58,970
كلّ ما تهتمّ له هذه المُديرة هو المال

273
00:13:58,970 --> 00:14:00,810
حتّى لو بعتِني، لن تسدّدي ثمنها

274
00:14:00,810 --> 00:14:01,930
،إن لم نبعك

275
00:14:01,930 --> 00:14:03,830
فكيف نعلم بأنّك لا تساوي 500؟

276
00:14:05,780 --> 00:14:06,680
هذه القُماشة باهظة جدّاً

277
00:14:06,680 --> 00:14:07,900
لن نشتريها

278
00:14:10,200 --> 00:14:11,930
أيُّها الرّاهب الصّغير

279
00:14:11,930 --> 00:14:14,030
حتّى ألف قطعة هبيّة لا يمكنها
شراء قلب طيّب

280
00:14:14,030 --> 00:14:15,740
تعاملك أختك معاملة حسنة

281
00:14:15,740 --> 00:14:17,540
لمَ لا يمكنها إنفاق بعض المال؟

282
00:14:18,140 --> 00:14:18,920
هذا صحيح

283
00:14:19,240 --> 00:14:21,140
عند أداء عمل، من الطبيعي كسب المال

284
00:14:21,140 --> 00:14:23,030
لا يمكن أكل العواطف على العشاء

285
00:14:23,030 --> 00:14:24,880
أليس كذلك يا لو شي شي؟

286
00:14:27,990 --> 00:14:29,380
لو شي شي؟

287
00:14:30,430 --> 00:14:32,680
تعرفينني؟

288
00:14:32,890 --> 00:14:33,970
بالطبع

289
00:14:33,970 --> 00:14:35,820
الزوجة الطيّبة من تجارة القماش
،الممتاز في العاصمة

290
00:14:35,820 --> 00:14:38,180
،في عائلة سعيدة لديها ابنة وابنة

291
00:14:38,180 --> 00:14:40,400
أنتِ مُقدّسة بواسطة الكثير من الفتيات

292
00:14:42,140 --> 00:14:43,820
لسانكِ معسول حقّاً

293
00:14:43,820 --> 00:14:44,890
أحرجتِني

294
00:14:44,890 --> 00:14:46,460
لكن ماذا عن حلمكِ؟

295
00:14:47,240 --> 00:14:48,280
ماذا؟

296
00:14:48,280 --> 00:14:50,070
،حلمكِ لتصبحي طبّاخة شهيرة

297
00:14:50,070 --> 00:14:53,530
لإعداد أطباق ترسم البسمة في وجه الجميع، صحيح؟

298
00:14:56,470 --> 00:14:57,530
وادي المئة عشبة

299
00:14:57,530 --> 00:14:58,820
"عشبة خروف السّمكة"

300
00:14:58,820 --> 00:15:00,680
،رتّبتِ موعداً مع طفل

301
00:15:00,680 --> 00:15:02,970
وطلبتِ منه المجيء إلى العاصمة لرؤيتك

302
00:15:02,970 --> 00:15:05,320
أيُّها الرّاهب الصّغير، عمّاذا تتكلّم؟

303
00:15:05,320 --> 00:15:06,830
لستُ أفهمك إطلاقاً

304
00:15:07,820 --> 00:15:08,690
...أنتِ

305
00:15:09,570 --> 00:15:11,680
هل أنتِ لو شي شي حقّاً؟

306
00:15:12,680 --> 00:15:13,120
...أنت

307
00:15:13,120 --> 00:15:15,010
ألست الرّاهب الصّغير؟

308
00:15:15,430 --> 00:15:17,020
أتيت لشراء نسيج لصنع ملابس؟

309
00:15:20,010 --> 00:15:22,070
!المُديرة جين

310
00:15:22,070 --> 00:15:24,240
يا آنسة، لديّ زبائن آخرون للاهتمام بهم

311
00:15:24,240 --> 00:15:25,740
تجوّلي واختاري ما يحلو لكِ

312
00:15:25,740 --> 00:15:26,780
،بما أنّنا افتتحنا اليوم

313
00:15:26,780 --> 00:15:28,060
سأمنحكِ حسماً

314
00:15:28,780 --> 00:15:30,680
المديرة جين، أتيتِ في الوقت المناسب

315
00:15:30,680 --> 00:15:32,680
لدينا ألوان جديدة عديدة هذه المرّة

316
00:15:32,680 --> 00:15:34,540
تعالي وألقي نظرة

317
00:15:33,370 --> 00:15:35,640
!تعال وأقِم في منزلي عندما تتفرّغ

318
00:15:35,640 --> 00:15:36,410
!تعالي

319
00:15:38,030 --> 00:15:39,540
كيف حدث هذا؟

320
00:15:40,140 --> 00:15:42,870
كما ترى، لو شي شي هنا

321
00:15:43,390 --> 00:15:45,070
،وكأنّ ثعلباً قد عضّها

322
00:15:45,070 --> 00:15:48,550
نسيَتْ تماماً أمنيتها كطفلة

323
00:15:48,930 --> 00:15:51,530
والآن لم تعد تهتمّ سوى بالمال

324
00:15:51,530 --> 00:15:53,430
،تفكّر في كيفيّة شراء المزيد من الأقمشة

325
00:15:53,430 --> 00:15:54,500
وبيعها بسعر أغلى

326
00:15:55,640 --> 00:15:59,520
!لكن ما زال ينتظرها

327
00:16:01,030 --> 00:16:03,310
غادرَتْ بالفعل

328
00:16:05,530 --> 00:16:07,030
لو شي شي

329
00:16:07,030 --> 00:16:09,140
أجل، أنا هنا

330
00:16:09,140 --> 00:16:10,280
،بعد أن أعود

331
00:16:10,280 --> 00:16:12,570
سأحرص على إخبار روح شجرة زهرة العنقود

332
00:16:12,570 --> 00:16:14,530
عن جمال العاصمة

333
00:16:14,530 --> 00:16:17,320
في السّابق، كان يتباهى بكمّ المعلومات التي يعرفها

334
00:16:17,320 --> 00:16:18,280
روح شجرة زهرة العنقود؟

335
00:16:20,030 --> 00:16:21,290
...أعني

336
00:16:22,640 --> 00:16:25,290
أعلم بأنّك روح

337
00:16:26,470 --> 00:16:28,290
ألستِ خائفة منّي؟

338
00:16:29,810 --> 00:16:31,120
لا

339
00:16:31,120 --> 00:16:33,860
الأشياء الّتي أخافتني وأذتني

340
00:16:33,860 --> 00:16:35,300
لم تكن روحاً أبداً

341
00:16:36,430 --> 00:16:37,800
هذا جيّد

342
00:16:38,390 --> 00:16:39,570
،بالمناسبة

343
00:16:39,570 --> 00:16:42,830
"أنا مرتاح جدّاً بعدما أعطيتُك "عشبة خروف السّمكة

344
00:16:43,640 --> 00:16:45,520
في الواقع، لا حاجة لتكون متوتّراً بشأن ذلك

345
00:16:46,280 --> 00:16:48,530
في نهاية المطاف، رتّبنا موعداً

346
00:16:48,530 --> 00:16:52,030
لكن هل تعرفين كيفيّة استخدام
عشبة خروف السّمكة"؟"

347
00:16:52,530 --> 00:16:55,120
لا تقلق، أعرف ذلك

348
00:16:55,610 --> 00:16:58,280
بالمناسبة، وادي المئة عشبة بعيد

349
00:16:58,280 --> 00:17:01,040
يمكنكِ وداعي في نهاية ذلك الشّارع فحسب

350
00:17:01,040 --> 00:17:02,680
،قلتُ بأنّني سأوصلك وأودّعك

351
00:17:02,680 --> 00:17:04,090
أي سأرافقك طوال الطريق

352
00:17:05,180 --> 00:17:06,290
حسناً

353
00:17:07,320 --> 00:17:11,080
بالمناسبة، لم تسأليني من أكون

354
00:17:13,320 --> 00:17:14,540
أعرف

355
00:17:15,180 --> 00:17:16,620
أنت شي نانغ

356
00:17:17,800 --> 00:17:20,010
قصدتُ اسمي

357
00:17:21,030 --> 00:17:22,310
هل لديك اسم؟

358
00:17:25,010 --> 00:17:27,820
يبدو... أنّني لا أملك

359
00:17:29,490 --> 00:17:31,870
سأناديك شي شي إذاً

360
00:17:32,240 --> 00:17:34,030
أنا شي شي

361
00:17:34,030 --> 00:17:35,980
أنت شي شي

362
00:17:43,430 --> 00:17:44,780
!رائع

363
00:17:44,780 --> 00:17:46,540
!لدينا نفس الاسم

364
00:17:48,030 --> 00:17:48,790
!انتظر

365
00:17:48,790 --> 00:17:50,290
أنت ذاهب للعاصمة؟

366
00:17:50,290 --> 00:17:52,490
عطّلَها شيء ما ولم تأتِ

367
00:17:52,490 --> 00:17:54,300
"عليّ إعطاؤها "عشبة خروف السّمكة

368
00:17:54,300 --> 00:17:55,530
!أنت غبيّ

369
00:17:55,530 --> 00:17:57,390
لم تغادر وادي المئة عشبة يوماً

370
00:17:57,390 --> 00:17:59,510
هل يمكنك التأقلم مع العالم الخارجي؟

371
00:18:00,180 --> 00:18:01,180
لا مشكلة

372
00:18:01,180 --> 00:18:02,140
،حالما أراها

373
00:18:02,140 --> 00:18:03,390
سأعود مباشرة

374
00:18:04,490 --> 00:18:07,570
هل تعلم لماذا أنت شي نانغ المتبقّي
الوحيد في وادي المئة عشبة؟

375
00:18:07,570 --> 00:18:09,740
--حالما يغادر شي نانغ

376
00:18:10,320 --> 00:18:11,390
!لا تذهب

377
00:18:11,390 --> 00:18:13,130
!اسمعني

378
00:18:15,180 --> 00:18:17,290
يا له من طفل غبيّ

379
00:18:21,220 --> 00:18:22,140
كيف الأمور؟

380
00:18:23,220 --> 00:18:24,410
هل يمكنك المشي؟

381
00:18:24,740 --> 00:18:25,490
لماذا أنت شارد؟

382
00:18:25,490 --> 00:18:26,540
سأوصلك إلى الدّيار

383
00:18:28,070 --> 00:18:29,230
حسناً

384
00:18:30,570 --> 00:18:31,870
شي شي

385
00:18:32,540 --> 00:18:37,300
القدرة على الإمساك بيدكِ هي
اللّحظة الأسعد في حياتي

386
00:18:37,890 --> 00:18:39,180
عجباً لك

387
00:18:39,180 --> 00:18:40,340
أنا أيضاً

388
00:19:20,180 --> 00:19:21,060
رحل

389
00:19:21,600 --> 00:19:22,940
تحقّقَتْ أمنيته

390
00:19:24,640 --> 00:19:26,740
،رغم أنّه حدثت بعض التقلُّبات أثناء ذلك

391
00:19:26,740 --> 00:19:28,070
،إلّا أنّ النتيجة جيّدة

392
00:19:28,070 --> 00:19:29,390
لذا كلّ شيء على ما يُرام

393
00:19:29,820 --> 00:19:30,610
صحيح؟

394
00:19:32,640 --> 00:19:34,390
،تُولَد الشي نانغ في عُزلة

395
00:19:34,390 --> 00:19:36,270
لذا تُحِبُّ الإمساك بأيدي النّاس

396
00:19:36,820 --> 00:19:39,240
،وحتّى أنّهم يغادرون مسقط رأسهم لهذا السّبب

397
00:19:39,240 --> 00:19:40,780
حتّى لو فقدوا حياتهم

398
00:19:41,640 --> 00:19:43,010
لهذا قلتُ بأنّ هذا النّوع

399
00:19:43,010 --> 00:19:44,930
من الأرواح عديم الجدوى

400
00:19:44,930 --> 00:19:46,280
،من أجل التمسّك بقليل من الدفء

401
00:19:46,510 --> 00:19:48,120
يضحّون بحياتهم

402
00:19:52,990 --> 00:19:57,800
ينسى بعض النّاس بأنّ دماء الشّباب
الّذي يغلي يصبح فاتراً مع الوقت

403
00:19:58,260 --> 00:20:00,030
بعض النّاس أغبياء حقّاً

404
00:20:00,030 --> 00:20:01,820
،بعضهم أفضل قليلاً

405
00:20:01,820 --> 00:20:03,300
وسيتذكّرون ذلك مدى الحياة

406
00:20:03,670 --> 00:20:05,280
،رغم معرفتهم بالنتيجة الحزينة

407
00:20:05,280 --> 00:20:06,800
يبقون لطيفين بصورة غبيّة مع النّاس

408
00:20:07,240 --> 00:20:08,810
لا يمكن وصف هذه الأرواح

409
00:20:09,070 --> 00:20:10,380
إلّا بأنّها غبيّة جدّاً

410
00:20:10,820 --> 00:20:12,390
...لكن هذه الأرواح

411
00:20:12,930 --> 00:20:14,370
ليس لديها ما تتحسّر عليه

412
00:20:16,720 --> 00:20:18,900
لا جدوى من مناقشة هذا الأمر الآن

413
00:20:19,320 --> 00:20:21,280
بعد أن حقّق شي نانغ أمنيته

414
00:20:21,280 --> 00:20:23,420
