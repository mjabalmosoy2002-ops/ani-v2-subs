1
00:00:36,510 --> 00:00:38,280
لماذا أحضر هذا الفتى ساطوراً بشكل عشوائي؟

2
00:00:38,280 --> 00:00:39,890
!أنا عالق حقّاً

3
00:00:50,490 --> 00:00:51,650
اهدأ، اهدأ

4
00:00:51,650 --> 00:00:53,210
،رغم أنّهم لا يستطيعون رؤيتي

5
00:00:53,210 --> 00:00:55,150
،لكن إذا اكتشفوا بأنّ السّاطور يستطيع التحرّك

6
00:00:55,150 --> 00:00:57,040
!سيُذيبونني فوراً

7
00:00:58,410 --> 00:01:00,910
لا! يجب أن أجد طريقة للخروج من هذا

8
00:01:01,530 --> 00:01:02,540
هذا صحيح

9
00:01:02,540 --> 00:01:05,960
أسرع طريقة هي أن يموت مالك السكّينة

10
00:01:17,010 --> 00:01:18,390
!الآن

11
00:01:20,660 --> 00:01:21,180
!آلونغ

12
00:01:22,180 --> 00:01:23,360
!آلونغ، هذا سيّئ

13
00:01:24,490 --> 00:01:25,890
ضُرِب وا بيان

14
00:01:26,840 --> 00:01:28,020
!مُتنمّرون من جديد

15
00:02:09,760 --> 00:02:12,020
!أيّها الطفل الشقيّ، لا تختبر صبري

16
00:02:12,020 --> 00:02:14,010
حصلتُ على ذلك البيض من العشّ

17
00:02:14,010 --> 00:02:14,860
!إنّه لي

18
00:02:14,860 --> 00:02:16,300
!أتجرؤ على طلب البيض؟

19
00:02:16,300 --> 00:02:17,410
هل مللت من الحياة؟

20
00:02:17,410 --> 00:02:18,400
!توقّفوا

21
00:02:22,780 --> 00:02:23,950
إنّه آلونغ

22
00:02:23,950 --> 00:02:24,760
!لنهرب

23
00:02:24,760 --> 00:02:25,790
أحضر ذلك السّاطور المكسور ثانية

24
00:02:25,790 --> 00:02:26,910
ساطور مكسور؟

25
00:02:27,790 --> 00:02:29,910
!أنت السّاطور المكسور

26
00:02:33,550 --> 00:02:35,130
!أنا لونغ شي

27
00:02:47,200 --> 00:02:48,520
!أعيدوا البيض

28
00:02:49,990 --> 00:02:52,020
!تذوّقت سكّين آلونغ طعم الدّماء من قبل

29
00:02:52,020 --> 00:02:53,340
،في المرّة المقبلة التي تتنمّرون فيها على النّاس

30
00:02:53,340 --> 00:02:54,400
!سيُكشَف أمركم

31
00:02:54,950 --> 00:02:56,030
هـ-هيّا بنا

32
00:03:00,090 --> 00:03:04,280
البيض الّذي حاولتُ جاهداً إيجاده قد كُسِر كلّه

33
00:03:04,740 --> 00:03:05,760
لماذا تبكي؟

34
00:03:05,760 --> 00:03:07,050
اصطدتُ سمكاً اليوم

35
00:03:07,050 --> 00:03:08,530
لنعُد ونتناول وجبة لذيذة

36
00:03:08,530 --> 00:03:10,160
هيّا، كُلا هذه أوّلاً

37
00:03:16,590 --> 00:03:17,470
!شهيّة

38
00:03:22,680 --> 00:03:24,550
أشتاق لأمّي

39
00:03:24,550 --> 00:03:26,710
أنا أيضاً

40
00:03:27,590 --> 00:03:29,250
...آلونغ

41
00:03:29,760 --> 00:03:31,450
مهلاً، لماذا تبكيان؟

42
00:03:31,450 --> 00:03:32,990
،ما دمنا نحن الثّلاثة معاً

43
00:03:32,990 --> 00:03:34,150
لا شيء يدعو للخوف

44
00:03:36,760 --> 00:03:38,200
،حتّى لو ضاعفت جهودك

45
00:03:38,200 --> 00:03:41,150
ما الجدوى من البقاء كقطط ضالّة أو كلاب شاردة؟

46
00:03:41,410 --> 00:03:44,160
لمَ لا تحرّرني في وقت أبكر؟

47
00:03:53,340 --> 00:03:54,880
!يبعث هذا على شعور رائع

48
00:03:54,880 --> 00:03:58,600
!يبدو أنّ التعرُّض للشحذ يعطي شعوراً ممتعاً

49
00:03:59,950 --> 00:04:02,740
وا بيان، هل قتلت هذه السكّين شخصاً حقّاً؟

50
00:04:02,740 --> 00:04:03,380
بالطبع

51
00:04:03,780 --> 00:04:05,590
تركَها والد آلونغ

52
00:04:05,590 --> 00:04:07,280
بعد عام واحد، هاجمنا قطّاع طرق

53
00:04:07,280 --> 00:04:09,780
،استخدم سكّينته لإيجاد مخرج لنفسه

54
00:04:09,780 --> 00:04:11,640
من أجل أن ينقذ حياة آلونغ

55
00:04:11,990 --> 00:04:14,310
آنذاك، لم أكن أستطيع تحريك هذه
،السكّينة إلّا بكلتا اليدين

56
00:04:14,550 --> 00:04:16,150
لكن لم يعد الأمر كذلك الآن

57
00:04:16,910 --> 00:04:18,090
،ما دمتُ أملك هذا

58
00:04:18,090 --> 00:04:19,650
،سأكون مثل أبي حتماً

59
00:04:19,650 --> 00:04:21,330
أحمي النّاس المُحيطين بي

60
00:04:26,990 --> 00:04:29,160
!قبضتُ عليك مُتلبّساً بالسرقة أيّها اللصّ

61
00:04:29,160 --> 00:04:30,410
اقطعوا يده

62
00:04:32,590 --> 00:04:33,410
!وا بيان

63
00:04:38,300 --> 00:04:40,170
لدى هذا اللصّ الوضع شركاء

64
00:04:41,200 --> 00:04:42,170
لصّ؟

65
00:04:51,050 --> 00:04:53,530
يا سادتي، ارتكب أخي خطأ

66
00:04:53,530 --> 00:04:54,640
أرغب في تلقّي العقاب بالنيابة عنه

67
00:04:54,640 --> 00:04:56,590
ترغب في تلقّي العقاب؟

68
00:04:56,590 --> 00:04:57,650
حسناً

69
00:05:01,450 --> 00:05:02,400
--ماذا

70
00:05:03,280 --> 00:05:06,410
قبل قليل، من الواضح أنّ ذلك اللصّ
الصّغير أخذ كيس ذهب منّي

71
00:05:06,410 --> 00:05:08,160
لكن تحوّل إلى صخرة الآن

72
00:05:08,160 --> 00:05:10,390
أخبرني كيف ينبغي أن تُعاقَب؟

73
00:05:11,800 --> 00:05:13,160
!خدعتنا

74
00:05:14,410 --> 00:05:16,280
رددت علينا بالرغم من سرقة الذّهب؟

75
00:05:16,280 --> 00:05:17,670
!أشقياء مُشاغبين

76
00:05:27,590 --> 00:05:29,470
،السّرقة هي ذنب أخي

77
00:05:29,470 --> 00:05:30,850
،لكنّكم تبتزّون النّاس

78
00:05:30,850 --> 00:05:32,330
!لذا أنتم سيّئون أيضاً

79
00:05:38,900 --> 00:05:41,900
كيف يجرؤ أولئك الأوغاد على استخدام
!الحجارة لخِداعي

80
00:05:42,700 --> 00:05:43,400
!اصمت

81
00:05:45,160 --> 00:05:46,300
تذكّر هذا

82
00:05:46,300 --> 00:05:49,160
مهما كان ما تسرقه، تبقى السّرقة سرقة

83
00:05:56,490 --> 00:05:57,660
،آلونغ

84
00:05:58,200 --> 00:05:59,250
أ-أنا آسف

85
00:05:59,840 --> 00:06:00,880
كنتُ أتضوّر جوعاً

86
00:06:01,160 --> 00:06:03,890
لذا أردتُ الحصول على بعض المال لإطعامكم

87
00:06:05,300 --> 00:06:06,410
هذه غلطتي

88
00:06:06,410 --> 00:06:07,880
ما كان ينبغي أن أورّطكم

89
00:06:08,340 --> 00:06:09,550
لا تكن هكذا يا وا بيان

90
00:06:09,550 --> 00:06:11,180
،أعتذر

91
00:06:11,840 --> 00:06:13,530
لعدم قدرتي على الاعتناء بكم

92
00:06:15,950 --> 00:06:17,040
...آلونغ

93
00:06:17,590 --> 00:06:20,020
لمَ لا تتمرّنان على الفنون القتاليّة معي؟

94
00:06:20,300 --> 00:06:21,600
،ما دمنا سنصبح أكثر قوّة

95
00:06:21,600 --> 00:06:23,240
،إذاً لسنا بحاجة للعيش هكذا

96
00:06:23,240 --> 00:06:24,660
ولن يتنمّر علينا أحد ثانية

97
00:06:24,660 --> 00:06:25,590
!أجل، أجل

98
00:06:25,590 --> 00:06:27,410
أريد التمرّن على تقنيّتك السّريعة في استخدام السكّين

99
00:06:27,410 --> 00:06:28,530
لا مشكلة

100
00:06:28,530 --> 00:06:30,990
ليست مسألة أنّه سريع

101
00:06:30,990 --> 00:06:32,530
أنا من قدّم المساعدة

102
00:06:59,890 --> 00:07:01,900
،نظراً إلى أنّ آلونغ يحمّمني

103
00:07:01,900 --> 00:07:02,740
--لا عفواً

104
00:07:02,740 --> 00:07:04,820
،نظراً إلى مهاراته الجيّدة في شحذ السكّين

105
00:07:05,240 --> 00:07:07,350
قرّرتُ الانتظار لسنوات قليلة قبل أن أقدم على أيّ تحرّك

106
00:07:08,160 --> 00:07:12,280
لم أتوقّع أن يدوم الانتظار سنوات طِوال

107
00:07:29,880 --> 00:07:31,490
عبثتم مع عصبة الماء الأسود

108
00:07:31,490 --> 00:07:32,160
سوف نتولّى أمركم

109
00:07:32,160 --> 00:07:33,490
!انتظروا وسترون! انتظروا وسترون

110
00:07:33,490 --> 00:07:34,180
!انتظروا وسترون

111
00:07:36,180 --> 00:07:38,020
!سنقتل كلّ الأرواح الشرّيرة في العالم

112
00:07:38,020 --> 00:07:39,890
!حتّى البشريّة منها

113
00:07:41,140 --> 00:07:43,590
،خطّطوا للقضاء على عصبة الشرّ

114
00:07:43,590 --> 00:07:46,230
،ولا سيّما قتل قطّاع الطرق واللّصوص

115
00:07:46,230 --> 00:07:48,010
للسرقة من الغنيّ وإعطاء الفقير

116
00:07:48,010 --> 00:07:52,220
لمدّة من الزمن، أصبح الأبطال الصّغار مشهورين

117
00:07:52,990 --> 00:07:56,400
تلك كانت أسعد سنواتهم أيضاً

118
00:07:58,800 --> 00:07:59,910
ما رأيك؟

119
00:07:59,910 --> 00:08:01,490
القرمُز والزُجاج المُلوّن متطابقان

120
00:08:01,490 --> 00:08:03,000
يمكننا بيع المزيّف على أنّه أصليّ

121
00:08:03,670 --> 00:08:05,410
هذا ما اكتشفتُه

122
00:08:05,410 --> 00:08:07,310
لن يخطر هذا على ذهن أحد

123
00:08:08,260 --> 00:08:10,160
لماذا تراودك أفكار كهذه ثانية؟

124
00:08:10,160 --> 00:08:11,880
احذر أن يكشف آلونغ الأمر

125
00:08:13,030 --> 00:08:15,090
كيف سيكتشف إذا لم تخبره أنت؟

126
00:08:24,160 --> 00:08:25,310
عُد

127
00:08:28,280 --> 00:08:30,530
هل تنوي شرّاً ثانية؟

128
00:08:36,550 --> 00:08:38,700
كفاك عِناداً يا آلونغ

129
00:08:38,700 --> 00:08:40,910
قد يكون هذا مستقبل معيشتنا

130
00:08:40,910 --> 00:08:41,990
معيشتنا؟

131
00:08:41,990 --> 00:08:43,050
أجل

132
00:08:43,050 --> 00:08:44,760
لا تريد أن تفهم آليّة سير هذا العالم

133
00:08:44,760 --> 00:08:46,750
مَن هم النّاس الّذين يعيشون برغد؟

134
00:08:47,450 --> 00:08:49,300
،في السّنوات الأخيرة، فعلنا الكثير من الأمور العظيمة

135
00:08:49,300 --> 00:08:50,700
،وشكّلنا علاقات عديدة

136
00:08:50,700 --> 00:08:53,050
لكن في النّهاية، لم نكسب إلّا اليسير من المال

137
00:08:53,050 --> 00:08:54,910
،كان ينبغي أن أغيّر مهنتي منذ زمن بعيد

138
00:08:54,910 --> 00:08:56,330
وأقوم بأداء عمل ما

139
00:08:57,700 --> 00:08:59,740
حتّى لو أدّيت عملاً ما، لا يجوز
أن تبيع قطعاً مُزيّفة

140
00:08:59,740 --> 00:09:02,100
لا ينبغي لمُتقني الفنون القتاليّة
أن تراودهم أفكار شرّيرة

141
00:09:03,990 --> 00:09:05,590
آلونغ، لا تغضب

142
00:09:05,590 --> 00:09:07,410
وا بيان يفكّر بنا أيضاً

143
00:09:07,410 --> 00:09:09,740
لكن يا وا بيان، آلونغ على حقّ

144
00:09:09,740 --> 00:09:11,090
لا يجوز أن تغشّ النّاس

145
00:09:12,800 --> 00:09:14,340
أنتما غبيّان

146
00:09:14,340 --> 00:09:16,030
غشّ النّاس يدرّ لنا المال

147
00:09:16,030 --> 00:09:17,260
،إن كنت بارعاً في هذا

148
00:09:17,260 --> 00:09:18,530
فيداك نظيفتان

149
00:09:18,910 --> 00:09:23,040
،إذا كنتُما نيّقين بشأن ما تريدان فعله

150
00:09:23,040 --> 00:09:25,220
عاجلاً أم آجلاً، سوف نُقتَل

151
00:09:25,700 --> 00:09:28,410
آلونغ، ما كنتَ تُلحُّ عليه

152
00:09:28,410 --> 00:09:30,670
يراه العالم شيئاً سيّئاً

153
00:09:30,670 --> 00:09:31,800
!كلام فارغ

154
00:09:56,760 --> 00:09:58,910
لا فائدة مع ذلك؟

155
00:09:59,660 --> 00:10:00,910
الوتر مكسور

156
00:10:00,910 --> 00:10:03,840
ينبغي أن تفرح لأنّ هذه السّاق ما زالت تتحرّك

157
00:10:03,840 --> 00:10:07,450
لـ-لكن يا طبيب، فكّر في طريقة أخرى من فضلك

158
00:10:07,450 --> 00:10:09,170
ابحث عن شخص أفضل منّي

159
00:10:09,170 --> 00:10:11,310
!لكنّك الطبيب الشّهير

160
00:10:11,780 --> 00:10:13,350
!يا طبيب، يا طبيب

161
00:10:14,040 --> 00:10:14,960
انسَ الأمر

162
00:10:15,380 --> 00:10:17,050
لا جدوى من إجباره

163
00:10:17,050 --> 00:10:18,180
هذا لا يُعقَل

164
00:10:20,450 --> 00:10:22,660
،زرنا الكثير من الأطبّاء

165
00:10:22,660 --> 00:10:23,830
مع ذلك ما زلت غير مُقتنع

166
00:10:24,550 --> 00:10:27,520
لا أمل من شفاء ساقي

167
00:10:28,010 --> 00:10:28,880
وا بيان

168
00:10:31,050 --> 00:10:33,010
ألم أخبرك مسبقاً؟

169
00:10:33,010 --> 00:10:35,020
أستحقّ هذا

170
00:10:35,020 --> 00:10:37,750
آلونغ، لا داعي للقلق بشأن ذلك

171
00:10:38,530 --> 00:10:40,450
لم أكن مقاتلاً جيّداً على أيّ حال

172
00:10:40,450 --> 00:10:44,410
لا يهمّ إن أصبحت هذه السّاق كسيحة

173
00:10:45,300 --> 00:10:46,340
لا

174
00:10:46,340 --> 00:10:47,800
نبحث عن طبيب شهير آخر

175
00:10:47,800 --> 00:10:49,310
لنذهب إلى لويانغ

176
00:10:50,540 --> 00:10:51,620
!آلونغ

177
00:10:52,790 --> 00:10:53,660
هذا سيّئ

178
00:10:57,990 --> 00:10:59,880
سمعتُ أنّ جيش شي جينغتانغ قد دمّر لويانغ

179
00:11:00,230 --> 00:11:01,590
حُرِقَ الإمبراطور أيضاً حتّى الموت

180
00:11:01,590 --> 00:11:03,010
،في هذا الاضطراب وفوضى الحرب

181
00:11:03,280 --> 00:11:05,030
،حشدت عصبة الماء الأسود كثيراً من الناس

182
00:11:05,030 --> 00:11:06,390
قائلين بأنّهم يريدون إبادتنا

183
00:11:07,160 --> 00:11:09,300
يريدون استغلال الفوضى للانتقام

184
00:11:09,300 --> 00:11:10,520
لا يمكننا أن نكون متهوّرين

185
00:11:10,910 --> 00:11:13,550
أتوا مُتحضّرين بأعداد كبيرة

186
00:11:13,550 --> 00:11:16,400
والآن أنا بهذا الوضع

187
00:11:17,950 --> 00:11:19,810
أخشى أن أعرقلكما

188
00:11:22,050 --> 00:11:24,780
لمَ لا نغادر عن طريق المعبر السرّي؟

189
00:11:25,010 --> 00:11:27,760
أجل. يؤدّي المعبر السرّي إلى الجبل
خارج المدينة

190
00:11:27,760 --> 00:11:29,500
لا أحد غيرنا نحن الثّلاثة يعلم بذلك

191
00:11:30,050 --> 00:11:31,300
وا بيان ذكيّ في نهاية المطاف

192
00:11:31,300 --> 00:11:32,200
،تحضيراً ليوم ماطر

193
00:11:32,200 --> 00:11:34,040
جعلنا نحفر معبراً سرّياً منذ مدّة طويلة

194
00:11:35,450 --> 00:11:37,800
ألستُ مختصّاً في الأمور السيّئة؟

195
00:11:39,800 --> 00:11:42,880
حسناً، لنحزم أمتعتنا بسرعة وندخل المعبر السرّي

196
00:11:58,760 --> 00:11:59,550
يمكنني رؤيته

197
00:11:59,550 --> 00:12:00,780
المخرج أمامنا فحسب

198
00:12:01,410 --> 00:12:02,340
بسرعة يا وا بيان

199
00:12:02,340 --> 00:12:03,290
ابذل مزيداً من الجهود

200
00:12:09,300 --> 00:12:10,100
وا بيان

201
00:12:10,950 --> 00:12:12,040
!آلونغ

202
00:12:15,990 --> 00:12:17,180
آلونغ

203
00:12:40,340 --> 00:12:42,110
!آلونغ

204
00:12:42,840 --> 00:12:45,360
اهرب! لا يمكنك البقاء

205
00:13:05,950 --> 00:13:06,840
آلونغ

206
00:13:10,850 --> 00:13:12,470
!انتظرني عند القصر القديم

207
00:13:16,450 --> 00:13:18,480
!آلونغ

208
00:13:24,780 --> 00:13:26,450
لا تقلق يا أخي

209
00:13:26,450 --> 00:13:28,160
سأحميكما

210
00:13:29,910 --> 00:13:30,660
!آلونغ

211
00:13:38,530 --> 00:13:40,170
آلونغ

212
00:14:02,910 --> 00:14:03,880
!آلونغ

213
00:14:21,700 --> 00:14:24,360
أعرف ما هو أهمّ شيء بالنسبة لآلونغ

214
00:14:25,000 --> 00:14:27,290
سأستمرّ في الدّفاع عنه

215
00:14:32,410 --> 00:14:33,990
،لكن مقارنة بالقتال والقتل

216
00:14:33,990 --> 00:14:36,020
شاو تيان يفضّل الطبخ

217
00:14:36,020 --> 00:14:37,780
،لذا من الآن فصاعداً

218
00:14:37,780 --> 00:14:41,650
بين يديه، أصبح السّاطور ساطوراً حقيقيّاً

219
00:14:41,650 --> 00:14:45,730
لكن هناك شخص آخر يجب قتله، صحيح؟

220
00:14:47,160 --> 00:14:48,510
،غيرهم هم الثّلاثة

221
00:14:48,510 --> 00:14:50,740
لا أحد كان يعلم مخرج المعبر السرّي

222
00:14:50,740 --> 00:14:53,770
لذا كنّا نبحث عن ذلك الشّخص لـ 40 عاماً

223
00:14:54,950 --> 00:14:56,800
إنّه حذِر حقّاً أيضاً

224
00:14:56,800 --> 00:14:59,590
وجدَ خبيراً ليساعده في التنكّر

225
00:14:59,590 --> 00:15:04,040
مررنا ببوّابة شينغشانغزاي عدّة مرّات
على مرّ السّنين دون معرفته

226
00:15:05,530 --> 00:15:07,800
كيف عرفته هذه المرّة؟

227
00:15:07,800 --> 00:15:10,510
،لأنّ الآنسة تاو اشترت تلك المزهريّة المزيّفة

228
00:15:10,510 --> 00:15:12,620
استطاع زانغ العجوز معرفته

229
00:15:13,950 --> 00:15:17,060
ا-البطل، إن كان لديك ما تقوله، فقُله إذاً

230
00:15:18,490 --> 00:15:21,050
خُذ ما تشاء من هنا

231
00:15:21,050 --> 00:15:22,900
اصفح عنّي أرجوك

232
00:15:27,800 --> 00:15:29,050
،إن لم يكن هناك ما تحبّه هنا

233
00:15:29,050 --> 00:15:31,400
فلديّ كنز في غرفتي السرّية

234
00:15:32,130 --> 00:15:35,640
حتّى الآن، ما زالت لديك عادة
التنقيب عن غرف سرّية

235
00:15:36,200 --> 00:15:38,530
،بالرغم من تغيير اسمك ومظهرك

236
00:15:39,410 --> 00:15:42,010
ما زلت على طبيعتك القديمة

237
00:15:42,010 --> 00:15:42,870
وا بيان

238
00:15:43,340 --> 00:15:44,130
!أنت

239
00:15:44,550 --> 00:15:47,700
هل يُعقَل أنّك... شاو تيان؟

240
00:15:47,700 --> 00:15:49,130
ما زلت حيّاً

241
00:15:49,130 --> 00:15:51,700
،كنتَ خائفاً جدّاً آنذاك

242
00:15:51,700 --> 00:15:54,640
لا تجرؤ حتّى على العودة للتحقّق من جثثنا

243
00:15:55,700 --> 00:15:57,200
أسأت فهمي

244
00:15:57,200 --> 00:15:59,640
شاو تيان، لم أقصد إيذاءك أبداً

245
00:15:59,950 --> 00:16:01,890
نحن أخوان

246
00:16:01,890 --> 00:16:04,240
ألم يكن آلونغ أخاً؟

247
00:16:04,240 --> 00:16:05,910
من أنقذك آنذاك؟

248
00:16:05,910 --> 00:16:07,340
،كان ليفضّل أن يجوّع نفسه

249
00:16:07,340 --> 00:16:08,730
ويُطعمك أوّلاً

250
00:16:08,730 --> 00:16:11,860
من كان يقف أمامك وذلك كي
لا يتنمّر الناس عليك؟

251
00:16:13,450 --> 00:16:15,370
لم أرد أن يموت آلونغ أيضاً

252
00:16:16,490 --> 00:16:18,200
كنتُ غاضباً فحسب

253
00:16:18,200 --> 00:16:20,410
كان بمقدورنا أن نعيش حياة سعيدة

254
00:16:20,410 --> 00:16:22,340
كان عنيداً فحسب

255
00:16:22,340 --> 00:16:23,500
...و

256
00:16:23,910 --> 00:16:27,170
كان السّبب أيضاً فيما حصل لهذه السّاق

257
00:16:27,170 --> 00:16:28,840
،عندما ضربني

258
00:16:28,840 --> 00:16:30,880
لم يعتبرني أخاً

259
00:16:31,280 --> 00:16:32,700
دعني أخبرك

260
00:16:32,700 --> 00:16:35,150
،منذ أصبحت ساقي كسيحة

261
00:16:35,150 --> 00:16:38,160
،أقسمتُ أنّني يوماً ما

262
00:16:38,160 --> 00:16:40,410
سأدع آلونغ يتركني كلّياً

263
00:16:40,410 --> 00:16:43,640
لم أستطع السّماح له بالتحكّم بحياتي بعد الآن

264
00:16:45,340 --> 00:16:47,100
لم أتصوّر أبداً

265
00:16:47,900 --> 00:16:51,390
أن تكون كراهيّة شخص دفينة إلى هذا العمق

266
00:16:51,910 --> 00:16:53,650
لكن هذا ليس السّبب الوحيد، صحيح؟

267
00:16:53,650 --> 00:16:55,450
،آنذاك، قبل الحادثة

268
00:16:55,450 --> 00:16:58,660
تقرّب زعيم عصبة الماء الأسود
منك بشكل خاص، صحيح؟

269
00:16:59,590 --> 00:17:00,410
!لا، لا، لا

270
00:17:00,410 --> 00:17:02,160
--لم يحدث شيء كهذا، أنا

271
00:17:02,410 --> 00:17:04,040
!كنتُ أبحث عنك لـ 40 عاماً

272
00:17:04,040 --> 00:17:06,170
!تعرف طبيعتي

273
00:17:06,450 --> 00:17:07,660
!حسناً

274
00:17:07,660 --> 00:17:09,240
هذه غلطتي

275
00:17:09,240 --> 00:17:11,050
هيّا يا شاو تيان

276
00:17:11,280 --> 00:17:12,910
،بما أنّك وجدتني

277
00:17:12,910 --> 00:17:15,460
!اقتلني إذا أردت

278
00:17:27,800 --> 00:17:28,890
وا بيان

279
00:17:29,800 --> 00:17:31,190
...كنّا ذات يوم

280
00:17:32,300 --> 00:17:34,120
أخوة...

281
00:17:36,010 --> 00:17:37,690
سلّم نفسك للسُلطات

282
00:17:38,450 --> 00:17:42,160
اعترف بقتلِك لأخيك آنذاك

283
00:17:43,050 --> 00:17:44,700
سأمهلك ثلاثة أيّام

284
00:17:44,700 --> 00:17:47,050
،إن لم تستسلم بعد ثلاثة أيّام

285
00:17:47,050 --> 00:17:48,670
سأعود لحسم الأمور معك

286
00:17:49,780 --> 00:17:51,660
حسناً، حسناً

287
00:17:51,660 --> 00:17:53,050
سأصغي إليك

288
00:17:53,990 --> 00:17:56,590
حدثَ كلّ هذا بسبب خطايايّ

289
00:17:56,590 --> 00:17:59,010
أستحقّ دخول السّجن

290
00:17:59,010 --> 00:18:00,800
،لا عجب في أنّ خلال هذه الأيّام

291
00:18:00,800 --> 00:18:02,680
أحلم دوماً بالماضي

292
00:18:03,090 --> 00:18:05,540
أحلم بأنّنا نمارس تمارين الفنون
،القتاليّة في الجبال

293
00:18:05,950 --> 00:18:07,820
حاملين خزّان الماء معاً

294
00:18:08,260 --> 00:18:09,650
،شاو تيان

295
00:18:10,350 --> 00:18:11,640
...أنا أيضاً

296
00:18:12,050 --> 00:18:13,780
لا أتحمّل ذلك...

297
00:18:25,220 --> 00:18:27,340
،إذاً القاتل هو أنت في الواقع

298
00:18:27,340 --> 00:18:28,290
أو زانغ العجوز؟

299
00:18:29,050 --> 00:18:30,240
هل هناك فرق؟

300
00:18:30,240 --> 00:18:31,040
أجل

301
00:18:31,040 --> 00:18:33,050
،طبقاً لأُذنَي وعينَي

302
00:18:33,050 --> 00:18:35,530
السُّلطات في طريقها إلى هنا

303
00:18:35,530 --> 00:18:36,910
،هل ينبغي أن يعتقلوا شخصاً

304
00:18:36,910 --> 00:18:37,840
أم يقبضوا على روح؟

305
00:18:38,910 --> 00:18:40,680
يبدو أنّك قلق علينا

306
00:18:41,340 --> 00:18:42,300
لا، لا، لا

307
00:18:42,300 --> 00:18:43,340
لا أتحمّل فقط حقيقة أنّ

308
00:18:43,340 --> 00:18:45,890
سكّيناً قطع رأس شخص يتجوّل
في المطبخ كلّ يوم

309
00:18:46,910 --> 00:18:48,810
أنت قلق بشأننا

310
00:18:50,310 --> 00:18:53,820
لا تكن أنانيّاً أيّتها الرّوح الصّغيرة

311
00:18:54,660 --> 00:18:56,300
أنت تأكل في الواقع مُعجّنات باردة

312
00:18:56,300 --> 00:18:57,530
أيّ نوع من الأرواح أنت؟

313
00:18:58,550 --> 00:19:00,410
!روح كبيرة تستطيع التهامك

314
00:19:10,300 --> 00:19:11,910
من أخرجكِ؟

315
00:19:11,910 --> 00:19:13,290
يوجد لونغ شي هناك

316
00:19:14,090 --> 00:19:15,510
ماذا يعني؟

317
00:19:15,510 --> 00:19:16,990
خسرتُ الكثير هذه المرّة

318
00:19:16,990 --> 00:19:18,450
الجاني قد مات

319
00:19:18,450 --> 00:19:20,010
عليّ إيجاد تعويض ما

320
00:19:20,240 --> 00:19:22,010
ألا تعي كم لونغ شي نادر؟

321
00:19:22,010 --> 00:19:23,700
أمسِك به واختمه داخل سلاح ذي نصل

322
00:19:23,700 --> 00:19:25,490
،سيصبح سلاحاً إلهيّاً

323
00:19:25,490 --> 00:19:27,090
ويمكن بيعه بأموال طائلة

324
00:19:28,310 --> 00:19:29,990
،إذا لمسته

325
00:19:29,990 --> 00:19:31,680
سيُفسِد وجه سي كانغ لان

326
00:19:31,680 --> 00:19:35,020
كيف ظهرَ سي كانغ لان في محادثتنا؟

327
00:19:36,240 --> 00:19:38,240
يسيل لعابكِ كلّما رأيتِه

328
00:19:38,240 --> 00:19:40,030
هل تعتقدينني أعمى؟

329
00:19:41,590 --> 00:19:43,840
تهرب سريعاً؟ مَن تعتقد أنّك تخبره بذلك؟

330
00:19:43,840 --> 00:19:45,910
النّاس الّذين لا يعلمون سيعتقدون
بأنّك ترغب في قضاء حاجتك

331
00:19:47,240 --> 00:19:50,340
هل الأمر بذلك الوضوح حقّاً؟

332
00:19:50,340 --> 00:19:52,670
حرصتُ على إخفاء ذلك

333
00:19:54,170 --> 00:19:57,380
لا يمكن اعتقال أفراد عائلة سي
فقط لأنّك تريد ذلك

334
00:19:58,030 --> 00:20:00,780
السيّد الصّغير الثّاني، طبّاخك زانغ تيان

335
00:20:00,780 --> 00:20:03,910
هو المُشتبه الأكبر في قضيّة شينغشيانغزاي

336
00:20:03,910 --> 00:20:05,680
لا تعقّد الأمور علينا من فضلك

337
00:20:06,010 --> 00:20:07,260
الأمر ليس معقّداً

338
00:20:07,260 --> 00:20:09,450
كلّ ما في المسألة أنّ زانغ تيان استقال وغادر

339
00:20:09,450 --> 00:20:11,030
،حتّى لو أردتُ مُساعدتكم

340
00:20:11,030 --> 00:20:12,390
لا يسعني فعل شيء

341
00:20:13,340 --> 00:20:14,150
غادر؟

342
00:20:14,150 --> 00:20:16,400
كيف يُعقَل هذا؟

343
00:20:16,700 --> 00:20:18,590
،مولايّ شين، إن لم تصدّقني

344
00:20:18,590 --> 00:20:20,400
يمكنك تفتيش منزلي

345
00:20:20,400 --> 00:20:22,700
،إذا كذبت

346
00:20:22,700 --> 00:20:24,660
فسأعود معك لتلقّي العقاب

347
00:20:31,410 --> 00:20:33,410
،بما أنّك قلتَ هذا

348
00:20:33,410 --> 00:20:35,170
فلا داعي للتفتيش

349
00:20:35,800 --> 00:20:36,860
المعذرة

350
00:20:39,700 --> 00:20:40,880
لا داعي لوداعي

351
00:20:41,590 --> 00:20:42,990
إلى أين تنوي الذهاب؟

352
00:20:42,990 --> 00:20:44,380
سأذهب حيث أذهب

353
00:20:45,340 --> 00:20:46,910
إذاً أتمنّى لك التوفيق في الطريق

354
00:20:46,910 --> 00:20:48,390
لا تدع أحداً يمسك بك

355
00:20:50,340 --> 00:20:52,710
حسناً، شكراً لك

356
00:20:56,950 --> 00:20:58,800
،رغم أنّنا لم نعرف بعضنا لمدّة طويلة

357
00:20:58,800 --> 00:21:00,160
،علّمتُك الطبخ

358
00:21:00,160 --> 00:21:02,160
لذا هناك علاقة معلّم وتلميذ

359
00:21:02,160 --> 00:21:06,390
بمشروب، لنعتبر قدرنا قد تحقّق

360
00:21:09,280 --> 00:21:11,910
،أقترح أن تتناول مشروباً آخر

361
00:21:11,910 --> 00:21:14,960
وذلك كي لا يكون هناك أيّ شخص يشرب
معك عندما تسافر بعيداً

362
00:21:18,490 --> 00:21:20,300
ينبغي أن نتناول مشروباً

363
00:21:20,800 --> 00:21:22,590
،هذه المرّة غادرتُ بعُجالة

364
00:21:22,590 --> 00:21:25,100
ولا وقت لتعليمك الأطباق الّتي كنتُ سأعدّها

365
00:21:25,760 --> 00:21:27,300
هذه وصفاتي

366
00:21:27,300 --> 00:21:29,100
كلّ التفاصيل مُدوّنة هنا

367
00:21:29,450 --> 00:21:31,510
من الواضح بأنّك فتى ذكيّ

368
00:21:32,160 --> 00:21:35,790
ذات يوم، ستتمكّن من طبخ
أفضل الأطباق في العالم

369
00:21:45,010 --> 00:21:46,180
شكراً لك

370
00:21:53,740 --> 00:21:54,410
بالمناسبة

371
00:21:54,410 --> 00:21:57,160
ألم يمت آلونغ قبل 40 عاماً؟

372
00:21:57,160 --> 00:21:59,290
ألم يكن بوسعك ترك هذا السّاطور
منذ مدّة بعيدة؟

373
00:22:00,950 --> 00:22:03,670
أجل، كنتُ أستطيع المغادرة منذ مدّة طويلة

374
00:22:05,050 --> 00:22:08,800
لكن لا أستطيع نسيان الأيّام
التي قضيتُها معهم

375
00:22:09,950 --> 00:22:11,990
شبابهم

376
00:22:11,990 --> 00:22:13,680
وحزنهم وأفراحهم

377
00:22:14,200 --> 00:22:16,390
يبدو أنّها أصبحت لي أيضاً

378
00:22:17,030 --> 00:22:19,330
أريد الاستمرار في الدّفاع هكذا

379
00:22:20,340 --> 00:22:22,240
إذاً استمرّ في الدّفاع

380
00:22:22,240 --> 00:22:23,590
،في هذه الحالة

381
00:22:23,590 --> 00:22:26,350
ستجد شخصاً حتّى لو سافرتَ بعيداً جدّاً

382
00:22:27,010 --> 00:22:28,400
يسجّل ألبوم الجنّيات

383
00:22:28,400 --> 00:22:29,950
،أنّ في الغرب توجد غيوم

384
00:22:29,950 --> 00:22:32,200
وخلف الغيوم، هناك لونغ شي

385
00:22:32,200 --> 00:22:33,550
،كطائر وكما الرّياح

386
00:22:33,550 --> 00:22:35,490
قيل بأنّها وُلِدت من الرّياح الأولى

387
00:22:35,490 --> 00:22:36,700
،رغم أنّها أصبحت أرواحاً

388
00:22:36,700 --> 00:22:38,550
لديها طبيعة هادئة

389
00:22:38,550 --> 00:22:40,990
نصل يوجد لونغ شي داخله

390
00:22:40,990 --> 00:22:42,950
،سيكون بسرعة الرّياح

391
00:22:42,950 --> 00:22:44,040
ويصبح سلاحاً شهيراً

392
00:22:44,950 --> 00:22:47,160
مع الأسف، لم يسجّل ألبوم الجنّيات أنّه

393
00:22:47,160 --> 00:22:50,390
،يوجد لونغ شي في العالم

394
00:22:50,390 --> 00:22:53,680
يرغب في التخلّي عن الحرّية لمرافقة عجوز

395
00:22:56,390 --> 00:22:57,990
!ممتاز

396
00:22:57,990 --> 00:23:00,400
،اعتباراً من اليوم

397
00:23:00,400 --> 00:23:04,340
!المطبخ هو ساحة معركتي لوحدي