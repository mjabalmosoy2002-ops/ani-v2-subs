1
00:00:22,340 --> 00:00:25,170
،غداء اليوم هو حساء سمك طازج مع زنجبيل

2
00:00:25,520 --> 00:00:30,000
مطبوخ مع زنجبيل عمره ثلاث سنوات
وسمك عمره عشر سنوات

3
00:00:33,380 --> 00:00:34,650
سيّدي الصّغير الأكبر

4
00:00:34,650 --> 00:00:36,170
أيّ سمّ هذا؟

5
00:00:36,170 --> 00:00:37,890
هل أنت مَدين لزانغ العجوز بالمال؟

6
00:00:38,310 --> 00:00:39,600
خرجتَ للتو

7
00:00:39,600 --> 00:00:41,390
لم أحظَ بالوقت لأخبرك

8
00:00:41,390 --> 00:00:43,600
زانغ العجوز قد استقال بالفعل

9
00:00:43,600 --> 00:00:45,900
من الآن فصاعداً، المطبخ يُديره السيّد ليو

10
00:00:45,900 --> 00:00:46,880
ماذا؟

11
00:00:46,880 --> 00:00:48,330
المطبخ أشبه بساحة معركة

12
00:00:48,330 --> 00:00:50,020
كيف لك أن تدع شخصاً آخر يديره بهذه السّهولة؟

13
00:00:50,250 --> 00:00:52,450
،لمَ لا آكل في الخارج كلّ يوم

14
00:00:52,450 --> 00:00:54,540
وأدعكم تنتظرون في المنزل كالأرامل؟

15
00:00:56,060 --> 00:00:59,020
سيّدي الصّغير الأكبر، لا تقل ذلك

16
00:01:00,030 --> 00:01:01,040
هل انتهيت؟

17
00:01:09,520 --> 00:01:10,290
لتاو ياو

18
00:01:10,890 --> 00:01:12,170
للراهب الصّغير

19
00:01:12,710 --> 00:01:13,800
للثعلب الصّغير

20
00:01:22,840 --> 00:01:23,580
أنت

21
00:01:31,750 --> 00:01:32,540
هل هناك مشكلة

22
00:01:33,500 --> 00:01:36,810
سيّدي الصّغير الثّاني، هذا هو المطبخ

23
00:01:37,960 --> 00:01:38,920
أعلم

24
00:01:42,910 --> 00:01:45,500
المطبخ هو اختصاصي

25
00:01:45,500 --> 00:01:46,810
أنا المسؤول اليوم

26
00:01:46,810 --> 00:01:48,810
إن بقيت، راقب وتعلّم

27
00:01:48,810 --> 00:01:49,750
لا تثِر جلبة

28
00:01:50,240 --> 00:01:51,420
لن أذهب

29
00:02:05,170 --> 00:02:06,770
القدرة على الجلوس والأكل معاً

30
00:02:06,770 --> 00:02:08,890
يعني بأنّنا إمّا عائلة أو أصدقاء

31
00:02:09,140 --> 00:02:10,500
،مهما كان عدد المُكوّنات

32
00:02:10,500 --> 00:02:11,770
،يجب توخّي الحذر

33
00:02:11,770 --> 00:02:13,470
كما لو أنّك تتعامل مع حبيبة

34
00:02:18,360 --> 00:02:19,910
لا بدّ أنّك لم تحبّ أحداً من قبل

35
00:02:20,850 --> 00:02:22,530
لديّ حبّ أوّل

36
00:02:23,540 --> 00:02:25,540
هل يُعقل أن تكون تاو ياو المُتيّمة بي؟

37
00:02:26,600 --> 00:02:28,560
!وهل تحسبها فتاة؟

38
00:02:28,560 --> 00:02:31,270
،إذا أردت، يمكنني ترتيب الأمور بينك وبينها

39
00:02:31,270 --> 00:02:33,540
لأحلّ مشكلات عزوبيّتك

40
00:02:40,720 --> 00:02:42,010
لماذا لم يجهز بعد؟

41
00:02:42,300 --> 00:02:43,620
أنا أتضوّر جوعاً

42
00:02:44,520 --> 00:02:45,810
سيّدي الصّغير الثّاني

43
00:02:46,080 --> 00:02:47,020
ماذا تفعلين هنا؟

44
00:02:47,300 --> 00:02:48,760
لمَ آتي إلى المطبخ برأيك؟

45
00:02:48,760 --> 00:02:49,640
أبحث عن طعام

46
00:02:49,900 --> 00:02:52,150
عظيم. خذي الطعام إلى غرفة المائدة

47
00:02:57,850 --> 00:03:01,640
سيّدي الصّغير الثّاني، هل يمكنني مرافقتك
إلى غرفة المائدة لتجربته؟

48
00:03:01,640 --> 00:03:03,410
حصّتكِ موجودة هنا

49
00:03:04,910 --> 00:03:06,520
اتركها لمويا ورولي

50
00:03:06,520 --> 00:03:07,820
يحبّانها

51
00:03:08,270 --> 00:03:09,210
لن يُشاركانا؟

52
00:03:09,210 --> 00:03:10,560
أجل

53
00:03:10,560 --> 00:03:12,750
،كانا سعداء حقّاً بعد أكل عصيدتك في هذا الصّباح

54
00:03:12,750 --> 00:03:13,880
وخرجا للّعب

55
00:03:44,850 --> 00:03:46,910
،بما أنّني لستُ مضطراً لأكل طعام السيّد ليو

56
00:03:47,210 --> 00:03:49,310
،ويمكنني أن أتمهّل وأهنأ بعيشي

57
00:03:49,310 --> 00:03:51,020
لا يوجد ما أتحسّر عليه في الحياة

58
00:03:51,940 --> 00:03:53,350
،وفقاً لتاو ياو

59
00:03:53,350 --> 00:03:56,260
أمنيتك الأخيرة هي رؤية هذا العالم المُزدهر

60
00:03:56,920 --> 00:03:58,360
!لنتفقّد ذلك الآن

61
00:04:06,920 --> 00:04:07,680
حسناً، حسناً

62
00:04:08,350 --> 00:04:10,180
يا سيّد، عجينتا خضراوات اثنتان لو سمحت

63
00:04:10,850 --> 00:04:12,140
،كما هو مُتوقّع من العاصمة

64
00:04:12,420 --> 00:04:14,000
حتّى المُعجّنات كبيرة وبيضاء

65
00:04:14,000 --> 00:04:14,900
لنأكل معاً

66
00:04:22,650 --> 00:04:25,380
أيّتها الحقيرة، كيف تجرئين على تلويثي بماء أقدامك؟

67
00:04:30,980 --> 00:04:33,850
اتّفقنا على وديعة شهر وإيجار لثلاثة
أشهر مُقدّماً في العقد

68
00:04:33,850 --> 00:04:35,270
،إذا تجرأت على الإهمال في تسديد الإيجار

69
00:04:35,270 --> 00:04:37,130
!فتذوّق ماء قدمي

70
00:04:40,020 --> 00:04:41,800
رولي، لا يمكنك أكله

71
00:04:43,880 --> 00:04:46,710
غرفتك مسكونة وأخافتني كثيراً في منتصف اللّيل

72
00:04:46,710 --> 00:04:47,670
،لا أطلب التّعويض

73
00:04:47,670 --> 00:04:48,800
!ومع ذلك تطلبين إيجاراً؟

74
00:04:49,810 --> 00:04:51,290
،اشتريتُ المنزل للتو

75
00:04:51,290 --> 00:04:53,600
وحتّى أنّني طلبتُ من مُعلّم فينغ
شوي أن يلقي نظرة إليه

76
00:04:53,600 --> 00:04:56,150
أعتقد يوجد شبح في قلبك

77
00:04:57,460 --> 00:04:59,510
المُعجّنات هي مجرّد مُمتلكات دنيويّة

78
00:05:14,160 --> 00:05:14,880
--أنت

79
00:05:15,750 --> 00:05:16,850
ساندوني يا جماعة

80
00:05:16,850 --> 00:05:18,380
من يجرؤ على العيش في بيت مسكون؟

81
00:05:18,850 --> 00:05:20,670
إنّه هو من لا يملك مالاً ويريد أن يقصّر

82
00:05:20,670 --> 00:05:21,920
،إن لم يكن نظيفاً حقّاً

83
00:05:21,920 --> 00:05:22,880
فما كنتُ لأعيش هناك أيضاً

84
00:05:22,880 --> 00:05:23,350
أجل

85
00:05:23,350 --> 00:05:24,560
الحياة أهمّ بكثير من المال

86
00:05:24,560 --> 00:05:25,800
هذا صحيح

87
00:05:28,600 --> 00:05:29,850
أميتابا

88
00:05:29,850 --> 00:05:31,170
سأشتري لك عجينة أخرى في المرّة المقبلة

89
00:05:31,170 --> 00:05:32,010
!أنت

90
00:05:32,810 --> 00:05:36,250
جميعكم، سأدعو هذا الرّاهب الصّغير
للمبيت لليلة واحدة

91
00:05:36,250 --> 00:05:37,960
،إذا قال بأنّه مسكون أيضاً

92
00:05:37,960 --> 00:05:39,710
فسأعيد لك إيجار شهر واحد

93
00:05:39,710 --> 00:05:40,900
هل لديكم اعتراض؟

94
00:05:41,600 --> 00:05:43,280
!إذاً عليكِ أن تلتزمي بكلامكِ

95
00:05:44,210 --> 00:05:46,710
يا آنسة، تأخّر الوقت

96
00:05:46,710 --> 00:05:48,410
عائلتي تنتظرني

97
00:05:48,410 --> 00:05:50,750
الرّهبان يستمتعون بمساعدة الغير

98
00:05:50,750 --> 00:05:52,410
رأيتَ كيف تعرّضتُ للافتراء

99
00:05:52,710 --> 00:05:54,750
،إن لم يجرؤ أحد على العيش في بيت جميل

100
00:05:54,750 --> 00:05:56,410
فسأجوع حتّى الموت في الشّوارع

101
00:05:56,670 --> 00:05:58,360
يا إلهي

102
00:05:58,360 --> 00:06:00,350
أيّ شخص يمكن أن يكون شاهداً

103
00:06:00,350 --> 00:06:01,880
لماذا أنا بالتّحديد؟

104
00:06:02,770 --> 00:06:04,790
الرّهبان لا يكذبون

105
00:06:04,790 --> 00:06:07,060
سيصدّق الناس ما تقوله

106
00:06:07,060 --> 00:06:08,680
أليس كذلك جميعاً؟

107
00:06:09,670 --> 00:06:11,180
...هذا صحيح

108
00:06:12,210 --> 00:06:14,100
لكن ما زال عليّ العودة لأجل العشاء

109
00:06:14,100 --> 00:06:15,350
سأتولّى أمر العشاء

110
00:06:15,350 --> 00:06:16,060
...لكن

111
00:06:16,060 --> 00:06:17,640
،سأعطيك خمسين عجينة

112
00:06:17,640 --> 00:06:18,980
!كلّها على حسابي

113
00:06:25,460 --> 00:06:26,650
...إذاً

114
00:06:26,960 --> 00:06:30,770
سيّدي الصّغير، عاملي قد أرسل
رسالة إلى منزلك سلفاً

115
00:06:30,770 --> 00:06:33,160
سنُعدّ عشاء نباتيّاً

116
00:06:33,160 --> 00:06:37,170
دعني أخبرك، من الصّعب أداء العمل
في هذه الأيّام

117
00:06:37,170 --> 00:06:40,170
أنفقتُ كلّ مدّخراتي وأنا أشتري هذا البيت

118
00:06:40,500 --> 00:06:42,500
،إذا أفسدَ ذلك العالِم سُمعتي

119
00:06:42,500 --> 00:06:44,460
ستهلك عائلتي

120
00:06:44,460 --> 00:06:46,550
عليك مُساعدتي

121
00:06:48,790 --> 00:06:52,000
لقد أكلت، لذا حان وقت المساعدة

122
00:06:52,000 --> 00:06:54,500
من الطبيعي أن أستمتع بمساعدة الآخرين

123
00:06:56,210 --> 00:06:57,520
،ببوذا في قلبي

124
00:06:57,520 --> 00:06:59,140
لا حاجة للخوف من الأشباح

125
00:07:02,210 --> 00:07:04,400
أرى أنّ هذا البيت جميل

126
00:07:04,670 --> 00:07:07,400
رغم أنّه قديم، إلّا أنّه نُظِّف بشكل جيّد

127
00:07:09,650 --> 00:07:11,100
لنَنم

128
00:07:11,100 --> 00:07:12,410
،سنعود غداً إلى جينسانيانغ

129
00:07:12,410 --> 00:07:13,800
حينها يمكننا الذّهاب إلى المنزل

130
00:07:23,970 --> 00:07:26,300
الطقس بارد

131
00:07:27,060 --> 00:07:28,880
إنّه بارد

132
00:07:30,420 --> 00:07:34,390
إنّه بارد

133
00:07:55,410 --> 00:07:57,210
!أميتابا! أميتابا

134
00:07:57,210 --> 00:07:59,820
يا آنسة، لا تؤرقي أحلامي من فضلك

135
00:08:03,810 --> 00:08:06,670
يا آنسة، أتكلّم معك

136
00:08:07,850 --> 00:08:09,300
يمكنك رؤيتي؟

137
00:08:15,840 --> 00:08:17,470
!ثعلب

138
00:08:22,560 --> 00:08:23,980
...ثعلب

139
00:08:25,020 --> 00:08:26,710
من أنتِ؟

140
00:08:26,710 --> 00:08:29,070
لماذا أتيتِ لإخافتي في منتصف اللّيل؟

141
00:08:31,520 --> 00:08:33,670
لماذا يوجد ثعلب؟

142
00:08:33,670 --> 00:08:35,700
لا تعضّني، أخاف من الالم

143
00:08:36,210 --> 00:08:37,290
لا تخافي

144
00:08:37,290 --> 00:08:38,460
هذا الثّعلب لا يعضّ النّاس

145
00:08:38,460 --> 00:08:39,700
إنّه لا يأكل الدّجاج حتّى

146
00:08:40,670 --> 00:08:41,830
حقّاً؟

147
00:08:41,830 --> 00:08:43,500
أميتابا

148
00:08:43,500 --> 00:08:45,080
الرّهبان لا يحبّون ذلك

149
00:08:46,560 --> 00:08:48,390
أنا مُطمئنّة إذاً

150
00:08:49,670 --> 00:08:51,710
أليست قدماك باردتين؟

151
00:08:51,710 --> 00:08:53,560
ارتدِ حذاء

152
00:08:53,560 --> 00:08:57,890
البرد هو أكثر شعور لا يُحتمل في العالم

153
00:08:58,750 --> 00:09:02,010
يا آنسة، لم تجيبي عن سؤالي

154
00:09:02,560 --> 00:09:03,670
،إن كانت ديك مشكلة

155
00:09:03,670 --> 00:09:05,390
فيمكنكِ الجلوس والتكلّم عن الأمر

156
00:09:05,390 --> 00:09:06,400
حسناً

157
00:09:14,420 --> 00:09:15,650
،اللّيالي الخريفيّة باردة

158
00:09:15,650 --> 00:09:17,350
ولا ترتدين ثياباً دافئاً

159
00:09:17,350 --> 00:09:18,780
هذه لكِ

160
00:09:20,020 --> 00:09:21,310
لا داعي

161
00:09:21,310 --> 00:09:24,560
،حتّى لو لففتني بكلّ الأغطية في العالم

162
00:09:24,560 --> 00:09:26,420
سأظلّ بردانة

163
00:09:27,020 --> 00:09:29,170
هل أنتِ مُصابة بمرض غريب ما؟

164
00:09:29,170 --> 00:09:31,110
غالباً

165
00:09:37,510 --> 00:09:40,140
إذا استمررت، سأطعمك من طعام
السيّد ليو يوميّاً

166
00:09:41,460 --> 00:09:43,100
يتمتّع هذا بحاسّة شمّ حادّة

167
00:09:43,100 --> 00:09:45,020
هل أحضرتِ طعاماً شهيّاً ما؟

168
00:09:49,210 --> 00:09:50,550
هذا فقط

169
00:09:55,750 --> 00:09:57,110
...هذا

170
00:09:57,850 --> 00:09:59,320
أخمد الضّوء

171
00:10:08,810 --> 00:10:10,240
إنّه جميل

172
00:10:11,000 --> 00:10:12,790
"هذه "عشبة خروف السّمك

173
00:10:12,790 --> 00:10:14,550
أحضرتُها لأعطيها لشخص

174
00:10:14,550 --> 00:10:16,840
لِمَن؟

175
00:10:18,000 --> 00:10:19,840
لو شي شي

176
00:10:21,850 --> 00:10:24,790
هل يمكنني الإمساك بيدك؟

177
00:10:38,210 --> 00:10:43,820
لماذا أنتم الأرواح تتصرّفون كأطفال
تائهين وتمسكون بأيدي النّاس؟

178
00:10:44,540 --> 00:10:49,250
لا، أنتم أرواح الشّجر تحتاجون لأاشعّة
الشّمس والمطر للنموّ جيّداً

179
00:10:49,250 --> 00:10:53,360
نحن لا نستمدّ القوّة إلّا من أيدي البشر

180
00:10:55,670 --> 00:10:57,930
هل يمكنني الإمساك بيدك؟

181
00:11:04,210 --> 00:11:06,720
لم أستطع الإمساك بأيّ يد مجدّداً اليوم

182
00:11:10,390 --> 00:11:11,760
البرد قارس

183
00:11:20,030 --> 00:11:22,030
هل تريد أن تمسك بيدي؟

184
00:11:53,520 --> 00:11:54,650
هل أنتِ بخير؟

185
00:12:00,460 --> 00:12:02,030
والداكِ لا يخافان

186
00:12:02,030 --> 00:12:03,800
كيف يتركانكِ تتجوّلين بمفردكِ؟

187
00:12:10,060 --> 00:12:11,040
أين منزلكِ؟

188
00:12:18,460 --> 00:12:19,710
لماذا لا تتكلّمين؟

189
00:12:19,710 --> 00:12:20,880
هل أنتِ مصعوقة؟

190
00:12:21,770 --> 00:12:24,380
منزلي... هناك

191
00:12:25,250 --> 00:12:25,890
جيّد

192
00:12:26,170 --> 00:12:28,180
ستتعافى قريباً هكذا

193
00:12:31,100 --> 00:12:32,140
هل يمكنكِ المشي؟

194
00:12:33,810 --> 00:12:34,710
لماذا تشردين؟

195
00:12:34,710 --> 00:12:35,980
سأوصلكِ إلى المنزل

196
00:12:38,500 --> 00:12:39,520
حسناً

197
00:12:46,500 --> 00:12:47,780
شكراً لك على اليوم

198
00:12:48,170 --> 00:12:51,410
لكن لا يحبّ والدايّ رؤية غرباء

199
00:12:51,410 --> 00:12:52,770
لا مانع من تَركي هنا

200
00:12:52,770 --> 00:12:55,210
حسناً. احرصي على عدم التجوّل
في العراء بمفردكِ في المستقبل

201
00:12:55,210 --> 00:12:55,900
حسناً

