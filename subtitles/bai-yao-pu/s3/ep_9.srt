1
00:00:29,050 --> 00:00:29,880
سيّدي الصّغير الثّاني

2
00:00:29,880 --> 00:00:31,170
أحضرتُهم إلى هنا

3
00:00:38,280 --> 00:00:39,700
!أهلاً، أهلاً

4
00:00:39,700 --> 00:00:41,320
سيكون المنزل حيويّاً الآن

5
00:00:42,850 --> 00:00:44,160
هل هو ثعلب أم كلب؟

6
00:00:44,160 --> 00:00:45,810
!نصف أبيض ونصف أسود، كم هذا مُثير

7
00:00:46,510 --> 00:00:48,020
رولي ثعلب رماديّ

8
00:00:49,480 --> 00:00:51,910
أيّها الصّغير، ما اسمك؟

9
00:00:51,910 --> 00:00:54,530
اسمي سي جينغ يان، السيّد
الصّغير لمنزل سي

10
00:00:55,840 --> 00:00:57,910
،ذاك الكتلة الخشبيّة التي هناك هو أخي الصّغير

11
00:00:57,910 --> 00:00:59,130
سي كانغ لان

12
00:01:11,240 --> 00:01:13,380
أحضر لي السّاطور

13
00:01:13,970 --> 00:01:15,560
!لا يجوز أن تفعل ذلك

14
00:01:15,560 --> 00:01:16,930
هذا مجرّد تبوّل

15
00:01:16,930 --> 00:01:18,600
أعتذر بالنيابة عن رولي

16
00:01:19,300 --> 00:01:21,010
،التبوّل عليّ ونحن لم نلتقِ إلّا الآن

17
00:01:21,010 --> 00:01:22,890
من الواضح بأنّ هذا لاستفزاز سيّد المنزل

18
00:01:22,890 --> 00:01:24,660
لم يفعل ذلك عن نيّة خبيثة

19
00:01:24,660 --> 00:01:27,390
يفعل ذلك فقط عندما يلتقي بشيء يحبّه

20
00:01:27,390 --> 00:01:30,400
إنّه يعاملك من الآن كواحد منّا

21
00:01:30,950 --> 00:01:33,330
يسرّني كثيراً سماع ذلك

22
00:01:34,320 --> 00:01:38,550
آنسة تاو، هذان هما القرويّان اللّذان
كنتِ تتحدّثين عنهما، صحيح؟

23
00:01:38,550 --> 00:01:40,280
أمتعتهما هنا أيضاً

24
00:01:41,170 --> 00:01:42,990
أجل، إنّهما كذلك

25
00:01:42,990 --> 00:01:44,410
قال السيّد الصّغير الثّاني لي

26
00:01:44,410 --> 00:01:45,800
،أنّه حالما تُحَلّ المسألة

27
00:01:45,800 --> 00:01:47,250
يمكنهما العيش هنا أيضاً

28
00:01:48,160 --> 00:01:49,650
حسناً، حسناً

29
00:01:50,360 --> 00:01:53,090
ما رأيكِ أن تعرّفيهما لنا؟

30
00:01:53,090 --> 00:01:55,150
...هذا من قريتنا

31
00:01:56,590 --> 00:01:57,890
الطبّاخ ليو...

32
00:01:58,780 --> 00:02:00,330
وهذا الرّاهب الصّغير مويا

33
00:02:02,660 --> 00:02:04,830
نحن من نفس القرية

34
00:02:04,830 --> 00:02:06,200
،للهرب من مجاعة

35
00:02:06,200 --> 00:02:08,390
تكبّدنا عناء كبير في الطريق

36
00:02:10,160 --> 00:02:12,650
لا يبدوان مثيرين للشفقة كما قلتِ

37
00:02:14,900 --> 00:02:16,150
،ربّ المنزل مياو

38
00:02:16,150 --> 00:02:17,900
خذهما وعيّنهما في عمل

39
00:02:18,160 --> 00:02:19,580
تعيين في عمل؟

40
00:02:19,580 --> 00:02:23,030
هل من الممكن أنّك تريد من شخص
مثلي أن يطعم الخيول لأجلك؟

41
00:02:23,280 --> 00:02:24,850
هناك ما يكفي من أشخاص لإطعام الخيول

42
00:02:25,200 --> 00:02:26,960
هل يمكنكما أداء أيّ أعمال أخرى؟

43
00:02:26,960 --> 00:02:28,540
منزل سي لا يدعم الأشخاص الكسولين

44
00:02:29,090 --> 00:02:30,290
!كيف تجرؤ؟

45
00:02:30,910 --> 00:02:32,040
توقّف

46
00:02:32,040 --> 00:02:34,540
أليست هذه فرصة لإثبات نفسك؟

47
00:02:34,880 --> 00:02:36,880
أيّها الطبّاخ... ليو

48
00:02:39,740 --> 00:02:41,180
ما المطعم الّذي تختصّ فيه؟

49
00:02:41,450 --> 00:02:44,390
من الصّعب جدّاً أن أقدّم طعاماً يرضي
أخي الصّغير النيّق

50
00:02:44,700 --> 00:02:46,200
ما علاقة هذا بك؟

51
00:02:46,200 --> 00:02:47,640
لمَ لا تعود إلى غرفتك وتتأمّل أفعالك؟

52
00:02:47,880 --> 00:02:49,410
هناك وافدان جديدان للمنزل

53
00:02:49,410 --> 00:02:51,760
خرجتُ للترحيب بهما

54
00:02:51,760 --> 00:02:54,320
فأساساً، هذا هو السّلوك الّذي ينبغي
لعائلة ثريّة أن تتّبعه

55
00:02:54,700 --> 00:02:56,010
عُد إلى غرفتك

56
00:02:56,010 --> 00:02:58,150
عشرة أيّام من الحبس هي العقوبة الأخفّ

57
00:02:58,370 --> 00:02:59,640
لماذا تعاقبني؟

58
00:02:59,640 --> 00:03:02,660
هل تعتقد بأنّني أنقذتُ ابنة الزعيم
يوي لأنّ أمره يهمّني؟

59
00:03:02,860 --> 00:03:04,320
أيُعقَل هذا؟

60
00:03:04,320 --> 00:03:06,410
،رأيتُ أنّ قراءة بختها كان جيّداً

61
00:03:06,410 --> 00:03:07,740
وتعيش حياة رغيدة

62
00:03:07,740 --> 00:03:11,290
،إنّها ملائمة جدّاً لك

63
00:03:11,290 --> 00:03:13,040
لذا أردتُ تنسيق الأمر بينكما

64
00:03:13,620 --> 00:03:15,800
فأساساً، أنا أخوك الأكبر

65
00:03:15,800 --> 00:03:18,800
من المؤسف أن أراك تعيش عازباً

66
00:03:19,230 --> 00:03:20,050
!أيُّها الخدم

67
00:03:20,050 --> 00:03:21,720
أعيدوه إلى غرفته

68
00:03:21,720 --> 00:03:24,510
لا تسمحوا له بالخروج دون إذن منّي

69
00:03:24,510 --> 00:03:27,850
إذا تجرّأ على الطاعة، اضربوه حتّى الموت

70
00:03:27,850 --> 00:03:28,840
لا تقلقوا بشأن ذلك

71
00:03:28,840 --> 00:03:29,520
حاضر

72
00:03:29,520 --> 00:03:30,760
!أعترض

73
00:03:30,760 --> 00:03:32,520
!كيف تجرؤ على مُعاملة سيّد المنزل هكذا؟

74
00:03:32,520 --> 00:03:34,740
!أنا السيّد الصّغير الأكبر لعائلة سي

75
00:03:34,740 --> 00:03:35,800
!سي كانغ لان

76
00:03:35,800 --> 00:03:36,520
!لان لان

77
00:03:36,520 --> 00:03:38,420
هذه غلطتي لأنّني دلّلتُك

78
00:03:38,420 --> 00:03:40,050
أنت لا تحترم الأكبر منك سنّاً

79
00:03:40,050 --> 00:03:41,900
!يا لوقاحتك

80
00:03:41,900 --> 00:03:42,870
!انتظروني

81
00:03:42,870 --> 00:03:44,650
!سأخرج معكم بعد عشرة أيّام

82
00:03:44,650 --> 00:03:46,160
!حسناً

83
00:04:33,160 --> 00:04:35,100
!حريق، حريق

84
00:04:46,740 --> 00:04:48,490
أميتابا

85
00:04:48,490 --> 00:04:51,890
سيّد ليو، كيف تسبّبت بفوضة كهذه أثناء الطبخ؟

86
00:04:52,780 --> 00:04:55,140
هذا لأنّ هذا السّمك غير مؤهّل ليكون طعاماً جيّداً

87
00:05:15,800 --> 00:05:20,580
زانغ العجوز، هل هذا هو بصل الرّبيع الّذي كنتُ
أنوي وضعه في كونغي المختلطة مع الفاكهة المحلّاة؟

88
00:05:21,740 --> 00:05:24,050
،لا أظنّه ملائماً ليُوضَع في تحلية

89
00:05:24,050 --> 00:05:25,250
لذا استخدمتُه لغرض آخر

90
00:05:33,880 --> 00:05:34,640
!شكراً

91
00:05:35,160 --> 00:05:37,600
!كلّ ما يعدّه زانغ العجوز شهيّ

92
00:05:38,390 --> 00:05:39,650
كُل أكثر

93
00:05:40,090 --> 00:05:41,410
،في سنّك

94
00:05:41,410 --> 00:05:43,390
ينبغي أن تكون أسمن

95
00:05:44,410 --> 00:05:47,700
يا عجوز، لمَ لا يمكنك أن تكون أكثر رومانسيّة؟

96
00:05:47,700 --> 00:05:50,410
لمَ لا يمكن إضافة بصل الرّبيع إلى الأشياء الحلوة؟

97
00:05:50,410 --> 00:05:53,740
يتمحور الطّبخ حول استخدام مخيّلتك لأقصى حدّ

98
00:05:55,840 --> 00:06:01,880
سيّد ليو، التّعامل مع الطعام لا يختلف
كثيراً عن التّعامل مع النّاس

99
00:06:03,050 --> 00:06:03,980
ماذا قلت؟

100
00:06:13,120 --> 00:06:17,550
،سيّد ليو، إذا أخذتَ شخصاً هادئاً إلى مكان ضوضائيّ

101
00:06:17,550 --> 00:06:19,450
فلن يكون سعيداً بالتأكيد

102
00:06:19,450 --> 00:06:22,950
،إذا حبستَ شخصاً نشطاً داخل غرفة

103
00:06:22,950 --> 00:06:24,600
فلن يكون سعيداً

104
00:06:25,090 --> 00:06:26,150
،لذلك

105
00:06:26,550 --> 00:06:29,740
إضافة بصل الرّبيع إلى كونغي حلو
،لن يجعل المذاق طيّباً

106
00:06:29,740 --> 00:06:31,300
،وسيكون هذا هدراً للمكوّنات

107
00:06:31,300 --> 00:06:32,960
لأنّهما غير متوافقين

108
00:06:33,660 --> 00:06:37,410
هذه هي القواعد في معظم الأمور في العالم

109
00:06:37,410 --> 00:06:39,390
إن لم تتّبعها، ستحدث أمور سيّئة

110
00:06:50,240 --> 00:06:52,480
هل أنت من يرعى هذه القطط؟

111
00:06:53,340 --> 00:06:54,760
إنّها قطط ضالّة

112
00:06:54,760 --> 00:06:55,910
لا أحد يكترث لأمرها

113
00:06:55,910 --> 00:06:57,640
عليها الاعتماد على أنفسها لتعيش

114
00:06:58,230 --> 00:07:00,390
،لذا أحضر بقايا طعام معي

115
00:07:00,660 --> 00:07:02,650
لأمنحها وجبة على الأقلّ

116
00:07:02,650 --> 00:07:05,650
لكن عادة لا تعيش القطط الضالّة طويلاً

117
00:07:06,660 --> 00:07:07,650
أجل

118
00:07:08,490 --> 00:07:10,650
طرأت تغييرات عديدة

119
00:07:10,650 --> 00:07:13,760
أولئك الّذين لم يأتوا ينبغي أن يكونوا قد رحلوا

120
00:07:13,760 --> 00:07:16,160
،قطع طريق دامٍ في هذا العالم

121
00:07:16,160 --> 00:07:18,240
،وذلك كي تبتعد لأقصى مسافة ممكنة

122
00:07:18,240 --> 00:07:19,790
أمر صعب للغاية

123
00:07:20,590 --> 00:07:22,370
،أنت مجرّد طبّاخ

124
00:07:22,370 --> 00:07:24,040
مع ذلك تقول كلاماً مثيراً للاهتمام

125
00:07:25,950 --> 00:07:28,050
أنا طبّاخ مثير للاهتمام

126
00:07:30,950 --> 00:07:32,700
،إن لم أعد موجوداً في المستقبل

127
00:07:32,700 --> 00:07:34,300
فيجب أن تتعلّم هذا

128
00:07:34,800 --> 00:07:36,310
القطط تحبّ السّمك المجفّف الصّغير

129
00:07:36,740 --> 00:07:38,710
،وكبد الدّجاج وكبد البطّ والأرزّ مناسب أيضاً

130
00:07:42,660 --> 00:07:44,520
لكن قطعاً لا تضِف بصل الرّبيع

131
00:07:46,090 --> 00:07:47,650
!يا لك من عجوز مزعج

132
00:07:47,950 --> 00:07:50,410
،لا تتذكّر مظهري الوسيم ولا طبخي العبقريّ

133
00:07:50,410 --> 00:07:52,740
!لكن تتذكّر بصل الرّبيع فقط

134
00:07:52,740 --> 00:07:55,200
ما الغريب في وجه وسيم؟

135
00:07:55,200 --> 00:07:57,660
لم أبدُ أسوأ منك عندما كنتُ شابّاً

136
00:07:57,990 --> 00:07:59,320
!مستحيل

137
00:08:00,990 --> 00:08:03,790
...دعني أخرج

138
00:08:04,240 --> 00:08:06,380
...لان لان

139
00:08:11,430 --> 00:08:12,200
!آنسة تاو

140
00:08:12,200 --> 00:08:13,180
إلى أين أنتِ ذاهبة؟

141
00:08:13,180 --> 00:08:14,300
!أخبريني

142
00:08:14,300 --> 00:08:16,390
أو ساعديني في طلب الصّفح من أخي

143
00:08:20,740 --> 00:08:21,840
!تاو ياو

144
00:08:21,840 --> 00:08:23,800
سمعتُ بأنّكِ خرجتِ للعمل اليوم

145
00:08:23,800 --> 00:08:25,590
أجل، مشيتُ كثيراً لدرجة أنّني أتضوّر جوعاً

146
00:08:25,590 --> 00:08:27,650
سأبحث عن زانغ العجوز للحصول على طعام

147
00:08:28,050 --> 00:08:29,650
ماذا تحملين؟

148
00:08:30,490 --> 00:08:31,950
هذا كنز

149
00:08:31,950 --> 00:08:33,150
لا أستطيع الكشف عنه عشوائيّاً

150
00:08:33,150 --> 00:08:34,490
أيّ كنز؟

151
00:08:34,490 --> 00:08:35,410
!دعيني ألقي نظرة

152
00:08:35,410 --> 00:08:36,660
لا

153
00:08:37,010 --> 00:08:38,200
!نظرة فقط

154
00:08:38,200 --> 00:08:39,160
!نظرة

155
00:08:48,240 --> 00:08:49,170
...هذه

156
00:08:54,050 --> 00:08:55,740
،عمرها مئة عام

157
00:08:55,740 --> 00:08:57,240
،تمنع الزهور من الموت

158
00:08:57,240 --> 00:08:58,760
وتُبقي الزهور متفتّحة لعشرة آلاف سنة

159
00:08:58,760 --> 00:09:00,390
!المزهريّة المُلمّعة القرمزيّة

160
00:09:00,390 --> 00:09:02,300
إنّها كنز حقيقيّ

161
00:09:02,300 --> 00:09:03,810
لا بدّ أنّها تساوي الكثير من المال

162
00:09:04,210 --> 00:09:05,800
بالطبع

163
00:09:05,800 --> 00:09:07,300
،هذه المرّة اتّخذتُ قراراً بلمح البصر

164
00:09:07,300 --> 00:09:08,740
وفرّغتُ جيبي لأجلها

165
00:09:08,740 --> 00:09:10,840
نادراً ما تسنح لنا فرصة كهذه

166
00:09:10,840 --> 00:09:13,820
مُحال ألّا أنتهزها

167
00:09:19,740 --> 00:09:22,260
ذوقك يستدعي القلق حقّاً

168
00:09:22,260 --> 00:09:23,590
أعتقد أنّ 80% منها مزيّفة

169
00:09:23,590 --> 00:09:24,790
أعطِني إيّاها

170
00:09:24,790 --> 00:09:25,910
أبعد يديك القذرتين عنها

171
00:09:26,590 --> 00:09:28,040
كلامك فارغ

172
00:09:28,840 --> 00:09:32,010
هل تعلم بأنّ هذه اشتُريت من شينغشانغزاي؟

173
00:09:32,010 --> 00:09:34,780
إنّه متجر ضخم في الشّارع الشّمالي يختصّ
في التّحف العتيقة والكنوز

174
00:09:39,700 --> 00:09:40,410
رأيت؟

175
00:09:40,410 --> 00:09:42,180
أحدهم يقدّرها

176
00:09:42,180 --> 00:09:46,060
إنّها حتماً... مُزيّفة

177
00:09:49,660 --> 00:09:51,570
عـ-عمّاذا تتكلّم أيّها العجوز زانغ؟

178
00:09:51,570 --> 00:09:53,340
لا بدّ أنّك تغار منّي

179
00:09:53,340 --> 00:09:56,070
يمكنك أن تعرف ومن النّظرة الأولى
بأنّها مزهريّة جميلة لا تُقدّر بثمن

180
00:09:56,800 --> 00:09:58,640
أيُعقَل هذا؟

181
00:10:02,230 --> 00:10:03,160
طعام طازج

182
00:10:05,390 --> 00:10:07,660
لن يستغرق أكثر من نصف شهر لصنع نسخة

183
00:10:09,300 --> 00:10:10,910
!مـ-مستحيل

184
00:10:10,910 --> 00:10:12,910
اشتُريت في شينغشانغزاي

185
00:10:12,910 --> 00:10:14,760
!شينغشانزاي في الشّارع الشّمالي

186
00:10:14,760 --> 00:10:15,510
انظر ثانية

187
00:10:15,510 --> 00:10:16,670
!أمعِن النّظر فيها ثانية

188
00:10:17,770 --> 00:10:20,160
زعيم شينغشانغزاي، يانغ، خبير جدّاً

189
00:10:20,160 --> 00:10:21,390
إنّه لا يقوم بعمله بنزاهة

190
00:10:21,840 --> 00:10:24,910
غالباً ما يبيع بضاعة رديئة ويخدع الزبائن الجدُد

191
00:10:24,910 --> 00:10:26,490
حتّى ربّ المنزل مياو وقع ضحيّة ذلك

192
00:10:26,490 --> 00:10:27,660
،إذا كان استغلاليّاً هكذا

193
00:10:27,660 --> 00:10:29,260
فلمَ لا تتدخّل السّلطات؟

194
00:10:29,840 --> 00:10:32,510
التّحف القديمة لا تُقدَّر بثمن

195
00:10:32,510 --> 00:10:35,700
حيث يرغب المُشترون والبائعون بمنافسة بعضهم

196
00:10:35,700 --> 00:10:37,290
كيف ستتعامل السّلطات مع ذلك؟

197
00:10:37,760 --> 00:10:39,530
...لـ-لكن

198
00:10:41,030 --> 00:10:42,410
...تاو ياو

199
00:10:42,410 --> 00:10:43,700
هل أنتِ بخير؟

200
00:10:43,700 --> 00:10:46,300
آنسة تاو، اهدئي أوّلاً

201
00:10:46,300 --> 00:10:48,160
كم أنفقتِ من المال؟

202
00:10:48,410 --> 00:10:49,660
لقد اختفى

203
00:10:49,660 --> 00:10:51,200
كلّه اختفى

204
00:10:51,660 --> 00:10:56,880
المال الّذي عملتُ جاهدة لادّخاره
لفترة طويلة قد أُنفِقَ على هذه

205
00:10:58,740 --> 00:11:01,680
!لم أعد أستطيع العيش

206
00:11:05,400 --> 00:11:06,840
،بما أنّه لا أحد يبالي

207
00:11:06,840 --> 00:11:08,340
سآخذ حقّي بيدي

208
00:11:09,280 --> 00:11:10,910
!تـ-تاو ياو

209
00:11:10,910 --> 00:11:12,020
!آنسة تاو

210
00:11:15,760 --> 00:11:16,910
!لا تمنعاني

211
00:11:16,910 --> 00:11:18,280
!كيف تجرؤ على النّصب عليّ؟

212
00:11:18,280 --> 00:11:19,550
!سوف أقتلك

213
00:11:19,550 --> 00:11:20,650
سيّدي الصّغير الثّاني

214
00:11:20,650 --> 00:11:22,660
تأخّر الوقت اليوم

215
00:11:22,660 --> 00:11:23,950
،في صباح الغد

216
00:11:23,950 --> 00:11:26,030
ما رأيك أن أذهب إلى شينغشانغزاي؟

217
00:11:26,950 --> 00:11:27,770
حسناً

218
00:11:28,300 --> 00:11:29,790
سأدع الأمر لك إذاً

219
00:11:32,660 --> 00:11:35,390
آنسة تاو

220
00:11:39,340 --> 00:11:41,490
أعلم بأنّكِ كنتِ محبوسة أيضاً

221
00:11:41,490 --> 00:11:43,160
تحدّثي معي قليلاً

222
00:11:43,160 --> 00:11:44,840
مللتُ للغاية

223
00:11:44,840 --> 00:11:45,990
،عجباً

224
00:11:45,990 --> 00:11:48,780
لماذا أنا حبيسة بجانب هذا الثّرثار؟

225
00:11:48,780 --> 00:11:52,910
آنسة تاو، أخبريني إذا حدث أيّ شيء
مُثير في الخارج مؤخّراً

226
00:11:52,910 --> 00:11:54,310
تغدو الأمور مُملّة هنا

227
00:11:54,810 --> 00:11:57,020
لماذا لا تحاول أن تكون أخاً أكبر يُحتذى به؟

228
00:11:58,660 --> 00:12:01,130
وُلِدتُ مع روح حرّة ومُستهترة

229
00:12:01,130 --> 00:12:03,140
لا أحتمل ألّا أخرج ولو ليوم واحد

230
00:12:04,660 --> 00:12:06,090
لان لان سيّئ للغاية

231
00:12:06,090 --> 00:12:07,760
،لأنّه يعرف نقطة ضعفي

232
00:12:07,760 --> 00:12:09,250
لهذا يحبسني دوماً

233
00:12:10,010 --> 00:12:11,590
لماذا تدّعي الحماقة؟

234
00:12:11,590 --> 00:12:14,040
بقدرتك، كيف لا يمكنك الخروج من هذه الغرفة؟

235
00:12:15,010 --> 00:12:17,700
لا أريد إزعاج لان لان

236
00:12:17,700 --> 00:12:19,490
،لو كان لديكِ أخ صغير كهذا

237
00:12:19,490 --> 00:12:20,880
لكنتِ مثلي أيضاً

238
00:12:21,910 --> 00:12:23,700
لا أجرؤ على امتلاك أخ صغير كهذا

239
00:12:23,700 --> 00:12:24,590
!تاو ياو

240
00:12:24,590 --> 00:12:25,880
السيّد الصّغير الأكبر

241
00:12:25,880 --> 00:12:27,030
!وقت العشاء

242
00:12:27,030 --> 00:12:28,680
لماذا تأخّرت؟

243
00:12:28,680 --> 00:12:29,960
أنا أتضوّر جوعاً

244
00:12:30,550 --> 00:12:31,910
!ساق دجاج لليوم

245
00:12:31,910 --> 00:12:32,640
لا تنافسني

246
00:12:32,640 --> 00:12:33,350
إنّها لي

247
00:12:36,490 --> 00:12:37,550
أيّ ساق دجاج هي هذه؟

248
00:12:37,550 --> 00:12:39,030
هل نُقِعت بالسمّ؟

249
00:12:39,030 --> 00:12:40,340
ما خطب زانغ العجوز اليوم؟

250
00:12:40,340 --> 00:12:41,650
هل هو بمزاج سيّئ؟

251
00:12:43,050 --> 00:12:44,470
العجوز زانغ ليس هنا اليوم

252
00:12:44,470 --> 00:12:46,530
السيّد ليو هو من يطبخ اليوم

253
00:12:46,530 --> 00:12:47,600
!خذها بعيداً، خذها بعيداً

254
00:12:47,600 --> 00:12:48,990
انتظر يا سيّد مويا

255
00:12:48,990 --> 00:12:50,630
هل لديك أيّ بقايا أكلات خفيفة؟

256
00:12:52,310 --> 00:12:53,660
لديّ فطيرة خضار متبقّية

257
00:12:53,660 --> 00:12:54,660
!سآخذها

258
00:12:55,670 --> 00:12:58,450
يا فتاة، أنا سيّدك الصّغير الأكبر

259
00:12:58,450 --> 00:12:59,950
كيف تتنافسين مع سيّدكِ على طعام؟

260
00:12:59,950 --> 00:13:02,010
أنا مسؤولة عن إطعام الخيول، لا أنت

261
00:13:02,010 --> 00:13:04,580
كُن ممتنّاً لأنّني لا أتنافس على
الطعام مع الخيول

262
00:13:11,780 --> 00:13:17,550
!أعطيني إيّاها

263
00:13:15,800 --> 00:13:17,550
أميتابا

264
00:13:17,550 --> 00:13:19,400
أخذها رولي

265
00:13:25,240 --> 00:13:26,340
ربّ المنزل مياو

266
00:13:26,910 --> 00:13:28,910
عدتَ من شينغشانغزاي سريعاً

267
00:13:28,910 --> 00:13:30,460
كيف سارت المفاوضات؟

268
00:13:31,280 --> 00:13:32,410
حدث أمر سيّئ

269
00:13:34,910 --> 00:13:39,430
وُجِد الزعيم يانغ في غرفة نومه مقطوع الرأس

270
00:13:39,880 --> 00:13:41,300
لم تكن هناك آثار لمقاومة

271
00:13:41,300 --> 00:13:43,550
بُتِر رأسه بقَطْعَة واحدة

272
00:13:43,550 --> 00:13:45,170
لم يبقَ أيّ دليل في مسرح الجريمة

273
00:13:45,510 --> 00:13:49,050
لم أرَ تقطيعاً نظيفاً كهذا في حياتي

274
00:13:49,050 --> 00:13:52,360
يمكن أن تُعَدّ مهارات القاتل بالسكّين
الأفضل على الإطلاق

275
00:13:54,800 --> 00:13:58,200
شهدتُ في الماضي حالة مشابهة

276
00:13:58,200 --> 00:14:03,660
قيل بأنّه قبل أربعين عاماً، عندما دُمِّرت
،مدينة لويانغ بواسطة شي جينغتانغ

277
00:14:03,660 --> 00:14:06,300
وقعت جريمة قتل أيضاً

278
00:14:06,300 --> 00:14:09,660
،قُتِل 67 شخصاً في الرّيف

279
00:14:09,990 --> 00:14:11,740
وذلك بواسطة تلويحة واحدة بأداة حادّة

280
00:14:11,740 --> 00:14:14,410
كانت عمليات التّقطيع ملساء كما المرآة

281
00:14:14,410 --> 00:14:17,650
لم يُعثَر على القاتل وظلّ ذلك لغزاً إلى يومنا هذا

282
00:14:18,260 --> 00:14:19,670
مضى 40 عاماً

283
00:14:19,670 --> 00:14:22,080
لا يمكن أن يكون القاتل نفس الشّخص

284
00:14:23,550 --> 00:14:26,170
زعيم، وصلت رسالة على الباب للتو

285
00:14:33,660 --> 00:14:34,390
...هذا

286
00:14:47,030 --> 00:14:48,490
اجمعوا الجميع

287
00:14:48,490 --> 00:14:50,780
سنغادر اللّيلة بحثاً عن القاتل

288
00:14:51,300 --> 00:14:52,280
!أجل

289
00:15:14,260 --> 00:15:16,310
هل أتيت لسرقة الطعام أيضاً؟

290
00:15:27,530 --> 00:15:29,990
يا له من يوم غير عاديّ

291
00:15:29,990 --> 00:15:31,780
حتّى السّاطور يمكن أن يصبح روحاً

292
00:15:35,590 --> 00:15:38,010
يا مُحارب، هل يمكنك مساعدتي؟

293
00:15:38,010 --> 00:15:39,340
لستُ أضمر نيّة خبيثة

294
00:15:39,340 --> 00:15:41,040
أفزعتَني للتو فحسب

295
00:15:42,240 --> 00:15:44,160
ما أنت بالضبط؟

296
00:15:44,160 --> 00:15:48,670
لا بدّ أنّ الرّوح الّتي تعلق رأسها بالجدار
ولا تستطيع سحبها عبقريّة

297
00:16:03,400 --> 00:16:05,400
أخبرني! من تكون؟

298
00:16:06,200 --> 00:16:07,800
!هذا أنت إذاً

299
00:16:07,800 --> 00:16:10,150
كدتَ تدمّر المطبخ في اليومين الماضيّين

300
00:16:12,550 --> 00:16:14,240
لا أظنّك بشريّاً

301
00:16:14,240 --> 00:16:15,660
لدى جسدك هالة روح

302
00:16:16,530 --> 00:16:17,990
،لو كنتُ شخصاً عاديّاً

303
00:16:17,990 --> 00:16:19,410
لكنتُ ميّتاً الآن

304
00:16:19,910 --> 00:16:21,550
تقول بأنّك روح

305
00:16:21,550 --> 00:16:24,030
لماذا تأتي إلى المطبخ في منتصف
اللّيل لسرقة طعام؟

306
00:16:24,030 --> 00:16:25,800
ألم تنمُ بما يكفي؟

307
00:16:25,800 --> 00:16:27,290
ألا ينبغي أن تتعطّش للنصوص المُقدّسة؟

308
00:16:28,280 --> 00:16:30,590
ألا تأتي إلى هنا أيضاً وتسرق
الكثير من الأطعمة في اليوم؟

309
00:16:30,590 --> 00:16:32,050
رأيتُ كلّ شيء

310
00:16:32,740 --> 00:16:33,880
لماذا لم أرك إذاً؟

311
00:16:34,160 --> 00:16:35,890
لأنّني كنتُ في السّاطور

312
00:16:36,950 --> 00:16:38,680
!أنت حقّاً روح متحوّلة إلى ساطور

313
00:16:39,840 --> 00:16:40,990
بالطبع لا

314
00:16:40,990 --> 00:16:42,700
،أنا أبيت هنا بشكل مؤقّت فقط

315
00:16:42,700 --> 00:16:44,240
،لأنّني قتلتُ شخصاً

316
00:16:44,240 --> 00:16:45,700
وأهدرتُ كثيراً من الطاقة

317
00:16:45,700 --> 00:16:47,310
لذا عليّ أن أتعافى

318
00:16:47,660 --> 00:16:48,820
من قتلت؟

319
00:16:49,160 --> 00:16:51,230
زعيم شينغشانغزاي، يانغ

320
00:16:51,950 --> 00:16:53,660
زعيم شينغشانغزاي، يانغ؟

321
00:16:53,660 --> 00:16:54,780
بائع التّحف القديمة؟

322
00:16:55,080 --> 00:16:55,950
هذا صحيح

323
00:16:55,950 --> 00:16:57,030
تعرفه أيضاً؟

324
00:16:57,440 --> 00:16:58,910
هل تكنّ ضغينة تجاهه؟

325
00:16:58,910 --> 00:16:59,910
لا، لا، لا

326
00:16:59,910 --> 00:17:01,740
الشّخص الّذي احتجزني يكنّ ضغينة تجاهه

327
00:17:01,740 --> 00:17:03,260
الشّخص الّذي احتجزك؟

328
00:17:03,960 --> 00:17:05,090
زانغ العجوز؟

329
00:17:05,090 --> 00:17:06,740
لا عجب في أنّك تبدو مألوفاً

330
00:17:06,740 --> 00:17:09,470
عادة يستخدمك زانغ العجوز لمساعدتي
في تقطيع الخضراوات

331
00:17:10,160 --> 00:17:11,020
...هذا يعني أنّ

332
00:17:11,700 --> 00:17:12,710
مهلاً

333
00:17:13,240 --> 00:17:16,240
تقصد إذاً أنّ العجوز زانغ يستخدمك
،لتقطيع الخضراوات والطبخ أثناء النّهار

334
00:17:16,240 --> 00:17:18,220
!ويستخدمك لقطع رؤوس النّاس في اللّيل؟

335
00:17:22,220 --> 00:17:23,910
لا

336
00:17:23,910 --> 00:17:26,200
لم أذق دماء البشر لقرابة الأربعين عاماً

337
00:17:26,200 --> 00:17:28,230
يستخدمني العجوز زانغ للطبخ دوماً

338
00:17:28,590 --> 00:17:30,910
،لكن قبل أربعين عاماً

339
00:17:30,910 --> 00:17:33,940
قتلتُ قرابة المئة شخص في ليلة واحدة

340
00:17:37,660 --> 00:17:39,240
لا تخبر العجوز زانغ

341
00:17:39,240 --> 00:17:41,050
لا يعلم بأنّ ساطوره هو أنا

342
00:17:41,050 --> 00:17:42,450
،إذا عَلِمَ بذلك

343
00:17:42,450 --> 00:17:44,550
فلن يشعر بالرّاحة في استخدامي للطبخ

344
00:17:44,950 --> 00:17:46,200
ما زلت تطبخ؟

345
00:17:46,200 --> 00:17:48,170
ما أنت بالتّحديد؟

346
00:17:50,530 --> 00:17:51,950
،تبدو وسيماً

347
00:17:51,950 --> 00:17:53,670
وصادفَ أنّنا نسرق الطعام معاً

348
00:17:53,950 --> 00:17:55,220
سأخبرك

349
00:18:02,590 --> 00:18:04,390
،أنا لونغ شي

350
00:18:04,390 --> 00:18:06,940
وُلِدتُ في الرّياح الأولى من العالم

351
00:18:07,390 --> 00:18:09,110
،مُحلِّقاً في السّماء

352
00:18:09,110 --> 00:18:11,400
فوق الجبال والأنهار بحرّية

353
00:18:11,400 --> 00:18:14,600
يمكننا أن نتحكّم بجهة الرّياح وقوّتها كيفما نشاء

354
00:18:14,600 --> 00:18:16,300
،رغم أنّني روح

355
00:18:16,300 --> 00:18:18,800
أُعرَفُ أيضاً بأنّني تجسيد إله الرّياح

356
00:18:19,410 --> 00:18:23,090
حذّرنا شيوخ العشيرة بأنّنا نستطيع
،الذّهاب إلى أيّ مكان

357
00:18:23,090 --> 00:18:24,950
،باستثناء عالم البشر

358
00:18:24,950 --> 00:18:27,160
لأنّه يحتوي على ذهب وفضّة ونحااس وحديد

359
00:18:27,160 --> 00:18:28,780
إنّهم خطيرون جدّاً

360
00:18:29,700 --> 00:18:31,990
،حالما نمرّ نحن، لونغ شي، بهذه الأشياء

361
00:18:31,990 --> 00:18:33,640
نعلق في كمين مُحكَم

362
00:18:34,080 --> 00:18:37,010
كان هناك العديد من الزملاء سيّئي
الحظّ ضمن العشيرة

363
00:18:37,010 --> 00:18:38,450
،قُبِضَ عليهم بواسطة البشر

364
00:18:38,450 --> 00:18:40,120
،وخُتِم عليهم في سيوف

365
00:18:40,120 --> 00:18:42,350
ليصبحوا السّيوف الأسطوريّة المزعومة

366
00:18:43,010 --> 00:18:47,140
أشهرهم هو داشيا لونغ شي

367
00:18:48,410 --> 00:18:50,240
،لكن لا أبالي

368
00:18:50,240 --> 00:18:52,730
!فرائحة طعام البشر زكيّة جدّاً

369
00:18:52,730 --> 00:18:54,740
بالإضافة إلى ذلك، كلّ رائحة مختلفة

370
00:18:55,230 --> 00:18:57,740
يمكنني تذوّق الكثير من الأذواق كلّ يوم

371
00:18:57,740 --> 00:18:59,580
!سعادة بالغة

372
00:19:01,400 --> 00:19:02,340
،بلطبع

373
00:19:02,340 --> 00:19:04,610
تذكّرتُ أيضاً ما قاله العجوز

374
00:19:04,610 --> 00:19:07,860
تجنّبتُ بحذر كلّ الذّهب والفضّة والنّحاس والحديد

375
00:19:08,700 --> 00:19:09,500
،لكن

376
00:19:10,050 --> 00:19:12,670
لم أكن محظوظاً كما ظننت