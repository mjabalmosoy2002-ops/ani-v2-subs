إذاً ماذا تفعلين هنا بدلاً من رعاية الخيول؟

215
00:11:56,750 --> 00:11:58,560
وأيضاً، كيف دخلتِ؟

216
00:11:58,560 --> 00:12:00,230
هذا ليس مكاناً يدخل إليه أشخاص عاديّون

217
00:12:00,230 --> 00:12:01,150
،أيّها السيّد الصّغير الأكبر

218
00:12:01,150 --> 00:12:03,000
هذه الأمور غير مهمّة

219
00:12:03,000 --> 00:12:04,660
ما يهمّ هو كيفيّة التّعامل مع هذا الشيء

220
00:12:04,660 --> 00:12:05,580
صحيح؟

221
00:12:06,020 --> 00:12:07,030
--لكنّك

222
00:12:10,410 --> 00:12:13,290
جسد يوي بينغتشان يضعف أكثر فأكثر

223
00:12:13,290 --> 00:12:15,170
،حالما تستهلك آخر جزئيّة من الحياة

224
00:12:15,170 --> 00:12:17,170
سنموت معاً هنا

225
00:12:17,420 --> 00:12:20,350
على أيّ حال، استعدتَ بهجة يوي بينغتشان

226
00:12:20,350 --> 00:12:21,380
لمَ لا تدعني وشأني فحسب؟

227
00:12:21,380 --> 00:12:22,500
سنذهب جميعاً إلى الدّيار

228
00:12:22,500 --> 00:12:23,710
ليس على أحد أن يموت

229
00:12:23,710 --> 00:12:25,070
!ولا في أحلامك

230
00:12:26,110 --> 00:12:28,160
تنتهي الرّوح الحيّة بالبؤس

231
00:12:28,160 --> 00:12:30,310
عندما تلتقي بشرّ آخر، تتحوّل إلى فراغ

232
00:12:30,310 --> 00:12:31,540
،بشخصيّة خسيسة

233
00:12:31,540 --> 00:12:34,400
غالباً ما تتسلّل إلى داخل جسد
،شخص حزين لسرقة البهجة

234
00:12:34,400 --> 00:12:35,650
لتفرّغها تماماً

235
00:12:37,810 --> 00:12:39,020
،كنتَ لتغادر

236
00:12:39,020 --> 00:12:40,780
،لكن بسبب رائحة المستحضرات

237
00:12:40,780 --> 00:12:42,600
،ظننتَ بأنّك لم تأخذ كلّ البهجة

238
00:12:42,600 --> 00:12:43,970
فعُدت

239
00:12:45,490 --> 00:12:47,410
انتهاؤك بهذا الوضع

240
00:12:47,410 --> 00:12:49,230
هو غلطتك أنت

241
00:12:53,100 --> 00:12:56,090
يا فتاة، هل ترعين الخيول في منزلي حقّاً؟

242
00:12:56,810 --> 00:12:57,670
أيّها السيّد الصّغير الأكبر

243
00:12:57,960 --> 00:12:59,380
لماذا أنت مثل أخيك؟

244
00:12:59,770 --> 00:13:01,880
ألا يمكن لراعية خيول أن تكون مُثقّفة؟

245
00:13:07,150 --> 00:13:08,100
بالتأكيد

246
00:13:09,120 --> 00:13:11,480
،الآن، يجب علينا إيجاد شا وي فوراً

247
00:13:11,480 --> 00:13:12,770
واستعادة مصباح المئة عائلة

248
00:13:12,770 --> 00:13:14,290
،يا راعية الخيول المُثقّفة

249
00:13:14,290 --> 00:13:16,390
هل يمكنكِ الخروج

250
00:13:16,650 --> 00:13:18,650
وإرسال رسالة لأخي؟

251
00:13:29,910 --> 00:13:31,040
لا داعي لإخفائه

252
00:13:32,410 --> 00:13:34,000
سلّمي مصباح المئة عائلة

253
00:14:54,060 --> 00:14:56,830
!رقيق جدّاً ومريح جدّاً

254
00:15:04,420 --> 00:15:06,170
!لان لان، هذا أنت

255
00:15:10,170 --> 00:15:11,250
إلى أين أنت ذاهب؟

256
00:15:11,250 --> 00:15:12,920
أسرع وأحضر لي شيئاً للأكل

257
00:15:12,920 --> 00:15:14,260
أنا أاتضوّر جوعاً

258
00:15:15,960 --> 00:15:17,750
تجرؤ على تبادل الرّوح مع شخص آخر

259
00:15:17,750 --> 00:15:19,350
،كان من الممكن أن تخسر حياتك

260
00:15:19,350 --> 00:15:20,640
مع ذلك تقلق بشأن الطعام؟

261
00:15:31,800 --> 00:15:33,040
!لان لان

262
00:15:33,040 --> 00:15:35,420
لان لان، هذه غلطتي، مفهوم؟

263
00:15:35,420 --> 00:15:37,210
أسرع وجِد طعاماً لي

264
00:15:37,210 --> 00:15:39,660
أنت قريبي الوحيد

265
00:15:40,100 --> 00:15:42,850
لان لان، لا تخجل

266
00:15:42,850 --> 00:15:45,300
أسرع وحضّر شيئاً لي لآكله

267
00:15:44,240 --> 00:15:45,300
!اغرب عن وجهي

268
00:15:45,840 --> 00:15:49,150
لان لان، أنا جائع حقّاً

269
00:15:51,720 --> 00:15:53,200
!آسفة، آسفة

270
00:15:53,200 --> 00:15:54,380
!لان لان

271
00:15:57,440 --> 00:15:58,420
!لان لان، لان لان

272
00:15:58,420 --> 00:15:59,920
لماذا أنت خجل؟

273
00:15:59,920 --> 00:16:01,890
فأنت أخي الصّغير الظريف

274
00:16:02,470 --> 00:16:03,650
هل لديك منديل حريريّ؟

275
00:16:14,440 --> 00:16:15,560
ما الأمر يا لان لان؟

276
00:16:15,560 --> 00:16:16,800
هل وجهي وسخ؟

277
00:16:20,420 --> 00:16:21,750
،قبل أن تتمّ عمليّة عكس تبادُل الرّوح

278
00:16:21,750 --> 00:16:23,210
،إذا تجرأت على التفوّه بكلام فارغ ثانية

279
00:16:23,210 --> 00:16:24,040
فسأذهب إلى المنزل فوراً

280
00:16:24,040 --> 00:16:26,170
وأدع صدرك ينسحق بصخرة

281
00:16:29,760 --> 00:16:30,960
،السيّد الصّغير الثّاني

282
00:16:30,960 --> 00:16:32,820
أخوك الأكبر أكثر مرحاً منك

283
00:16:33,960 --> 00:16:36,460
هذا الفراغ هو فأر في الواقع

284
00:16:37,010 --> 00:16:38,560
لهذا هو جشع

285
00:16:38,560 --> 00:16:40,520
وإلّا كيف سقط في فخّ السيّد الصّغير الأكبر؟

286
00:16:50,350 --> 00:16:51,530
...فأر

287
00:16:51,920 --> 00:16:54,580
من المؤسف أنّه كان فأرأً مثيراً
للشفقة بينما كان حيّاً

288
00:17:01,500 --> 00:17:03,200
ينبغي أن تصغي لأخيك

289
00:17:05,310 --> 00:17:06,830
أنا أصغي لما يقوله لان لان بالطبع

290
00:17:07,100 --> 00:17:09,710
وأيضاً، هل تعرفين القواعد يا فتاة إطعام الخيول؟

291
00:17:09,710 --> 00:17:11,220
كيف تتكلّمين مع سيّدنا هكذا؟

292
00:17:11,220 --> 00:17:12,420
وقحة

293
00:17:12,420 --> 00:17:13,550
من أين انتشلتها؟

294
00:17:14,100 --> 00:17:15,500
أنت الأوقح

295
00:17:15,500 --> 00:17:18,050
سي جينغ يان، هل تدرك عواقب أفعالك؟

296
00:17:18,420 --> 00:17:20,500
أعيد جسدك إلى بيت سي ليلاً

297
00:17:20,500 --> 00:17:22,060
حتّى الآلهة لا تستطيع إنقاذك

298
00:17:22,670 --> 00:17:24,900
لان لان، لان لان، لان لان

299
00:17:24,900 --> 00:17:26,500
لا تغضب

300
00:17:26,500 --> 00:17:28,000
أعلم بأنّ قلبينا متّصلان

301
00:17:28,000 --> 00:17:29,210
سوف تأتي لإنقاذي حتماً

302
00:17:29,210 --> 00:17:30,190
!انقلع

303
00:17:35,350 --> 00:17:36,200
!سي جينغ يان

304
00:17:48,100 --> 00:17:50,350
شكراً للسيّدين الصّغيرين على المساعدة

305
00:17:50,350 --> 00:17:52,350
لن أستطيع ردّ هذا الجميل مهما فعلت

306
00:17:52,350 --> 00:17:56,100
سأرسل هديّة متواضعة إلى منزلكما
وبشكل شخصيّ لاحقاً

307
00:17:56,100 --> 00:17:57,180
لا حاجة لذلك

308
00:17:58,540 --> 00:18:01,040
كنتُ أتخلّص من روح شرّيرة فحسب

309
00:18:01,040 --> 00:18:02,810
ما زال جسد الآنسة يوي واهناً

310
00:18:02,810 --> 00:18:04,180
لا أنصح بالتكلّم

311
00:18:08,620 --> 00:18:10,310
قد تموت لبضعة أيّام أخرى

312
00:18:10,310 --> 00:18:11,820
بعد ذلك، ستكون بخير

313
00:18:12,670 --> 00:18:13,920
،بفضل بركة عائلة سي

314
00:18:13,920 --> 00:18:15,770
تمكّنت ابنتي من استعادة حياتها

315
00:18:15,770 --> 00:18:20,090
لكن بتزعزع حياة السيّد الصّغير الأكبر، لستُ مرتاحاً حقّاً

316
00:18:20,090 --> 00:18:21,810
لا تقلق يا زعيم

317
00:18:21,810 --> 00:18:24,420
،إذا كانت الآنسة الرّقيقة قد نجت من المحنة

318
00:18:24,420 --> 00:18:27,140
،فالسيّد الصّغير الأكبر محظوظ
لذا سيكون بخير بالطبع

319
00:18:33,310 --> 00:18:36,560
لم أتوقّع أن تكون شا وي بغيضة إلى هذا الحدّ

320
00:18:36,560 --> 00:18:38,270
،لم تلفّق تهمة بابنتي بينغتشان فحسب

321
00:18:38,270 --> 00:18:40,270
بل ورّطت السيّد الصّغير الأكبر أيضاً

322
00:18:40,270 --> 00:18:42,890
قد نعرف الآخرين لفترة طويلة دون أن
نفهم طبيعتهم الحقيقيّة

323
00:18:44,100 --> 00:18:46,460
بالمناسبة، أين شا وي؟

324
00:18:57,170 --> 00:18:58,780
آنستك بخير

325
00:19:02,310 --> 00:19:03,650
غريب جدّاً

326
00:19:04,350 --> 00:19:05,660
لماذا تكرهينها؟

327
00:19:05,920 --> 00:19:07,660
ألستُما أختين منسجمتين؟

328
00:19:07,920 --> 00:19:09,660
الجميع يقولون هذا

329
00:19:12,500 --> 00:19:14,250
أختان مُنسجمتان؟

330
00:19:14,250 --> 00:19:17,300
كيف لخادمة وسيّدة أن تكونا أختين مُنسجمتين؟

331
00:19:17,520 --> 00:19:18,960
،لكن حتّى لو ماتت

332
00:19:18,960 --> 00:19:20,730
لن تصبحي ابنة عائلة يوي

333
00:19:20,730 --> 00:19:21,760
وما أدراكِ؟

334
00:19:22,770 --> 00:19:24,310
،إذا ماتت

335
00:19:24,310 --> 00:19:28,110
سيكون لدى السيّد شي شريكاً في العالم السّفلي

336
00:19:28,920 --> 00:19:29,610
--أنت

337
00:19:30,170 --> 00:19:32,520
هل تحبّين السيّد شي؟

338
00:19:34,100 --> 00:19:35,520
الأشياء الّتي أحبّها

339
00:19:36,250 --> 00:19:38,400
لا تنتمي لي أبداً

340
00:19:39,500 --> 00:19:42,670
،عندما تُوضع هذه الفاوانيا على رأس مولاتي

341
00:19:42,670 --> 00:19:44,420
!يصبح جميلاً حقّاً

342
00:19:44,420 --> 00:19:45,770
ليس تماماً

343
00:19:45,770 --> 00:19:48,310
الزهرة الجميلة تلائم الشّخص الجميل

344
00:19:48,310 --> 00:19:50,210
وُلِدت مولاتي حسناء

345
00:19:50,210 --> 00:19:52,920
في المستقبل، ستجد زوجاً جيّداً حتماً

346
00:19:52,920 --> 00:19:54,250
هذا صحيح

347
00:19:55,670 --> 00:19:58,910
عندما كنتُ صغيرة، كنتُ أحبّ الفاونيا الحمراء

348
00:19:59,350 --> 00:20:01,260
لكن زهوري الّتي تمّ الاعتناء بها جيّداً

349
00:20:01,770 --> 00:20:03,680
،تمّ قطفها بدون سابق إنذار

350
00:20:03,680 --> 00:20:05,610
وُوضِعت على رأس بينغتشان

351
00:20:12,350 --> 00:20:16,310
كخادمة لها، لم يكن لديّ الحقّ
في أن أحبّ شيئاً

352
00:20:20,750 --> 00:20:22,550
،تحصل على ما تريد

353
00:20:22,900 --> 00:20:25,020
بينما لا أستطيع الحصول على أيّ شيء

354
00:20:25,020 --> 00:20:27,910
،سواء كان لباساً أو مستحضرات

355
00:20:28,350 --> 00:20:30,920
يمتدح النّاس أيّ شيء ترتديه أو تستعمله

356
00:20:30,920 --> 00:20:34,390
بينما يُسخَر منّي لعدم إدراكي لمكانتي

357
00:20:34,890 --> 00:20:36,740
ما خطب هذه الخادمة؟

358
00:20:34,890 --> 00:20:36,740
هذا صحيح

359
00:20:35,450 --> 00:20:37,060
!أجل، كم هذا مُخزٍ

360
00:20:37,060 --> 00:20:38,420
لماذا ترتدي لباس الآنسة؟

361
00:20:38,420 --> 00:20:39,670
لا يمكن أن تبقى في هذا المنزل

362
00:20:39,670 --> 00:20:41,600
ما زالت تعتقد بأنّ علاقتها حميمة مع الآنسة

363
00:20:41,600 --> 00:20:43,380
إنّها لا تفهم معنى الأهمّية

364
00:20:43,380 --> 00:20:45,970
ستبقى الخادمة خادمة دوماً

365
00:20:52,810 --> 00:20:55,110
،رغم أنّني التقيتُ السيّد شوي أوّلاً

366
00:20:55,960 --> 00:20:59,010
في النّهاية، الفتاة التي أراد الزواج
منها هي يوي بينغتشان

367
00:20:59,900 --> 00:21:01,960
لدرجة أنّه سافر إلى بلاد الخارج للعمل

368
00:21:01,960 --> 00:21:04,570
لأنّه أراد شراء فاونيا جميلة ليوي بينغتشان

369
00:21:07,410 --> 00:21:09,350
،بما أنّهما يحبّان بعضهما الآخر حبّاً جمّاً

370
00:21:09,350 --> 00:21:12,350
لمَ لا أرسل يوي بينغتشان إليه لتصبح معه؟

371
00:21:12,350 --> 00:21:13,810
كم عمركِ في هذا العام؟

372
00:21:15,100 --> 00:21:16,820
سألتُ كم عمركِ

373
00:21:17,600 --> 00:21:18,640
ثمانية عشر

374
00:21:18,640 --> 00:21:20,010
ثمانية عشر من الآن؟

375
00:21:20,420 --> 00:21:25,050
إذاً ألم تهدري 18 عاماً مثاليّاً على الغيرة والكراهيّة؟

376
00:21:29,800 --> 00:21:33,390
في هذا العالم، من الشّائع الانتقال
ما بين الحزن والبهجة

377
00:21:39,650 --> 00:21:43,010
تبيّن بأنّ الفراغ ليس بالضرورة روحاً شرّيرة

378
00:24:00,850 --> 00:24:02,880
تحلّيت بالجرأة حقّاً على التكلّم مع الزعيم يوي

379
00:24:03,600 --> 00:24:05,210
عمّاذا تتكلّم؟

380
00:24:05,210 --> 00:24:06,710
أعدتُه للزعيم بالطبع

381
00:24:06,710 --> 00:24:08,420
أصرّ على إعطائه إيّاه

382
00:24:08,420 --> 00:24:09,380
وقحة

383
00:24:14,060 --> 00:24:15,180
ماذا تفعلين؟

384
00:24:15,180 --> 00:24:16,850
وعدك

385
00:24:16,850 --> 00:24:18,180
،الآن بعد أن انتهت هذه المسألة

386
00:24:18,180 --> 00:24:21,010
لا يمكنك التّراجع عن وعدك

387
00:24:21,560 --> 00:24:22,890
كما تشائين

388
00:24:23,410 --> 00:24:25,150
حقّاً؟ هذا ممتاز

389
00:24:25,150 --> 00:24:29,000
بالمناسبة، ألم تتبادل روحا الآنسة يوي
والسيّد الصّغير الأكبر بعد؟

390
00:24:29,000 --> 00:24:31,400
هل يريد الزعيم يوي قتل شا وي؟

391
00:24:31,400 --> 00:24:33,170
،أنتِ حِرفيّة عائلة سي

392
00:24:33,170 --> 00:24:34,410
لا عائلة يوي

393
00:24:34,760 --> 00:24:36,900
أنا أسأل فحسب

394
00:24:37,500 --> 00:24:39,560
يستطيع السيّد الصّغير الأكبر
مُبادلة الأرواح فعلاً

395
00:24:39,560 --> 00:24:41,410
هذا ليس شيئاً يستطيع شخص عاديّ فعله

396
00:24:41,920 --> 00:24:44,670
أنتِ ترعين الخيول، لكن ألا تستطيع
روحكِ مغادرة جسدكِ أيضاً؟

397
00:24:45,240 --> 00:24:47,350
لماذا تستهين بمُطعمي الخيول ثانية؟

398
00:24:47,350 --> 00:24:48,880
ألا يمكن لمُطعمي الخيول أن يكونوا موهوبين؟

399
00:24:49,270 --> 00:24:51,350
لا يهمّني سوى أن ترعي الخيول جيّداً

400
00:24:51,350 --> 00:24:52,900
لستُ مهتمّاً بأيّ شيء آخر

401
00:24:54,100 --> 00:24:56,000
،إن لم تكترث لي

402
00:24:56,000 --> 00:24:57,670
فإذاً عندما غادرت روحي جسدي

403
00:24:57,670 --> 00:24:58,960
لماذا تركتني أستند عليك؟

404
00:24:58,960 --> 00:25:00,810
كان ليكون تركي في الأرض مناسباً لك

405
00:25:00,810 --> 00:25:02,600
تركتُكِ مرّتين

406
00:25:02,600 --> 00:25:04,530
