1
00:00:13,250 --> 00:00:19,990
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

2
00:00:20,040 --> 00:00:25,620
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

3
00:00:27,770 --> 00:00:33,760
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

4
00:00:34,040 --> 00:00:39,670
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

5
00:00:41,140 --> 00:00:47,120
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

6
00:00:48,200 --> 00:00:54,120
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

7
00:00:55,920 --> 00:01:02,340
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

8
00:01:02,900 --> 00:01:08,700
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

9
00:01:09,320 --> 00:01:16,300
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

10
00:01:16,600 --> 00:01:22,170
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

11
00:01:23,420 --> 00:01:29,350
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

12
00:01:29,670 --> 00:01:36,780
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

13
00:01:59,910 --> 00:02:03,420
،لن تخرجَ مِن هُنا أبدًا
.استسِلم فحسب

14
00:02:05,490 --> 00:02:08,190
...قدركَ أن تبقى عالقًا معي

15
00:02:08,860 --> 00:02:11,110
.في هذا الجحيم للأبد

16
00:02:12,420 --> 00:02:15,880
هل تُصدّق أنّ تلك الثّعلبة
الصّغيرة لا تزالُ تنتظركَ؟

17
00:02:19,620 --> 00:02:22,630
هل تتذكّر حتّى وجوه
الّذين قتلتهم؟

18
00:02:24,030 --> 00:02:27,600
هل تظنّ أنّ خطاياكَ يُمكن
أن تُغفر يومًا؟

19
00:02:29,510 --> 00:02:31,370
.لا تُفكّر حتّى في الابتعاد عنّي

20
00:02:31,380 --> 00:02:32,310
...جُوان جُوان

21
00:02:34,760 --> 00:02:37,150
.كلا، لا تذهَب

22
00:02:38,540 --> 00:02:41,910
!أنت مِلكي، مِلكي وحدي

23
00:03:13,100 --> 00:03:16,550
بلدة لُويِي

24
00:03:17,370 --> 00:03:18,700
بلدة لُويِي؟

25
00:03:19,870 --> 00:03:22,400
إذًا هذا هُو المكان الّذي
كُنت تُحاول أخذي إليه؟

26
00:03:38,350 --> 00:03:41,010
أتذكّر أنّ بلدة لُويِي كانت
.صاخبةً على الدّوام

27
00:03:41,030 --> 00:03:42,540
هل فاتَ الأوان الآن؟

28
00:03:42,560 --> 00:03:43,820
لماذا هِي هادئةٌ هكذا؟

29
00:03:49,170 --> 00:03:56,890
،اصطَد يراعةً ♪
♪ .واحصُل على قِطعة حلوى

30
00:04:00,220 --> 00:04:02,150
أخيرًا، هُناك ضوءٌ خافت
.في الأمام

31
00:04:02,640 --> 00:04:04,240
.لنَدخل ونستكشِف

32
00:04:23,080 --> 00:04:24,860
لماذا أنت جبانٌ هكذا؟

33
00:04:25,400 --> 00:04:26,540
.اخفِضي صوتكِ

34
00:04:30,000 --> 00:04:31,200
.أبقِي صوتكِ مُنخفضًا

35
00:04:31,360 --> 00:04:33,090
.أخفتِ اليراع وجعلتِه يهرب

36
00:04:37,580 --> 00:04:38,540
،أيّها الطّفل

37
00:04:38,560 --> 00:04:40,690
الوقت متأخّرٌ، ألا يجب أن
...تكون في منزلكَ

38
00:04:40,790 --> 00:04:43,320
نائمًا بدلًا مِن التسلّل
وإخافة النّاس في الشّارع؟

39
00:04:53,190 --> 00:04:53,830
!أمسكتُ بك

40
00:04:55,610 --> 00:04:56,870
لماذا قُمتَ باصطِيادهم؟

41
00:05:01,320 --> 00:05:03,250
هل تبحثين عن مكانٍ للإقامة؟

42
00:05:03,290 --> 00:05:05,600
...كلا، أنا -
.أرجوكِ تعالي معي -

43
00:05:05,840 --> 00:05:07,380
.هذا نُزل عمّي

44
00:05:08,110 --> 00:05:10,210
...ذهبوا لزيارة الأقارب

45
00:05:10,610 --> 00:05:12,560
.وتركوني مسؤولًا عن النّزل

46
00:05:13,070 --> 00:05:14,870
نُزل الجَبل المَوشيّ

47
00:05:18,650 --> 00:05:19,650
ما اسمُك؟

48
00:05:21,450 --> 00:05:22,180
.لُو شِياوتَان

49
00:05:24,160 --> 00:05:27,070
هل هُناك نُزلاء آخرون
يُقيمون في النّزل؟

50
00:05:28,020 --> 00:05:29,690
العمل لم يكن جيّدًا في
.الآونة الأخيرة

51
00:05:29,700 --> 00:05:31,160
.لا يُوجد نُزلاء على الإطلاق

52
00:05:31,250 --> 00:05:34,650
لهذا السّبب ذهبَ عمّي
.وعائلته لزِيارة الأقارب

53
00:05:34,740 --> 00:05:35,420
،آنستِي

54
00:05:35,800 --> 00:05:38,500
غُرفتكِ هِي الأخيرة على الجانب
.الشّرقي مِن الطّابق الثّاني

55
00:05:38,510 --> 00:05:39,760
هل أنتَ خارجٌ في هذه السّاعة؟

56
00:05:39,770 --> 00:05:40,800
...سأذهبُ لاصطياد اليراع

57
00:05:40,810 --> 00:05:42,870
.لأُقايضه بالحلوى مع يُو آن

58
00:05:43,060 --> 00:05:44,860
.تفضّلي ودوّني اسمكِ بنفسكِ

59
00:05:48,390 --> 00:05:49,390
،كُرة الفحم الصّغيرة

60
00:05:49,570 --> 00:05:51,400
أَلا تشعرُ أنّ هُناك ما يُثير الرّيبة؟

61
00:05:52,850 --> 00:05:54,300
،مُنذ أن وطِئت قدمي بلدة لُويِي

62
00:05:54,310 --> 00:05:56,060
.وأنا أشعرُ بعدم الارتياح

63
00:05:56,880 --> 00:05:58,940
لكنّي لا أستطيع تحديدَ
.السّبب بيقينٍ

64
00:05:59,280 --> 00:06:01,320
عندما كُنت أتحدّث إلى
،ذلك الطّفل

65
00:06:01,680 --> 00:06:03,340
.بدا شيءٌ ما غريبًا

66
00:06:42,970 --> 00:06:46,100
يبدو أنّ أحدهم يُخطّط
.لإقامة حفلة استقبالٍ لنا

67
00:06:47,310 --> 00:06:49,880
هل كان ذلك مِن فِعل الطّفل؟

68
00:06:56,710 --> 00:06:58,120
هذه البِذرة الغريبة مُجدّدًا؟

69
00:06:59,230 --> 00:07:02,560
،إذًا هذا هُو مصدر عُشب الشّيطان
.يا كُرة الفحم الصّغيرة

70
00:07:02,730 --> 00:07:04,190
.لهذا السّبب قُدتني إلى هُنا

71
00:07:04,450 --> 00:07:12,290
،اصطَد يراعةً ♪
♪ .واحصُل على قِطعة حلوى

72
00:07:13,780 --> 00:07:14,420
.لنَنطلق

73
00:07:50,100 --> 00:07:52,310
،عزيزي، لا بُدّ أنّك متعبٌ
.تفضّل بالجُلوس

74
00:07:53,110 --> 00:07:53,810
.حسنًا

75
00:07:54,270 --> 00:07:56,380
.العشاء جاهزٌ

76
00:07:56,530 --> 00:07:58,490
،حسنًا، قادمٌ
.العشاء جاهزٌ

77
00:07:58,670 --> 00:08:00,000
...ما الّذي حدث

78
00:08:00,460 --> 00:08:02,100
...ليُغادر الجميع فجأةً

79
00:08:02,110 --> 00:08:03,640
ويختفوا دُون أثرٍ؟

80
00:08:04,740 --> 00:08:08,600
،حين قام تَشانغ إر بجولته التفقديّة
كيف لم يستشعِر وجود أمرٍ غير طبيعيّ؟

81
00:08:10,600 --> 00:08:12,240
.لا أستطيعُ استدعاء رُوح الأرض

82
00:08:12,250 --> 00:08:14,580
ماذا تفعل طَوائف الخالدين المُجاورة؟

83
00:08:14,810 --> 00:08:17,610
أَلم يلحظوا خطبًا جسيمًا كهذا؟

84
00:08:18,560 --> 00:08:20,370
إذًا؟ لا شيء؟

85
00:08:21,250 --> 00:08:23,250
.يبدو أنّ هذه ليست مسألةً طبيعيّة

86
00:08:24,420 --> 00:08:27,590
،جيّدٌ أنّك أحضرتني إلى هُنا
.سأمنحكَ الفضل في ذلك

87
00:08:27,600 --> 00:08:31,080
،اصطَد يراعةً ♪
♪ .واحصُل على قِطعة حلوى

88
00:08:31,090 --> 00:08:33,980
.واحدٌ، اثنان، ثلاثةٌ، أربعةٌ، خمسةٌ -
!هذا غريبٌ -

89
00:08:34,090 --> 00:08:36,950
.هكذا صاروا خمسةً -
كيف لم يبقَ سِوى الأطفال؟ -

90
00:08:38,470 --> 00:08:39,490
!اصطدتُ مجموعةً أيضًا

91
00:08:39,500 --> 00:08:40,730
يبدو أنّه تمّ اصطياد كُلّ
.ما في هذه المنطقة

92
00:08:40,740 --> 00:08:43,210
لنَذهب لمُقايضة اليراع
.بالحلوى مع يُو آن

93
00:08:43,240 --> 00:08:43,870
.حسنًا

94
00:08:47,600 --> 00:08:49,830
لماذا يبدو هؤلاء الأطفال
غرِيبي الأطوار هكذا؟

95
00:08:50,150 --> 00:08:51,610
.تمّ التحكّم بهم أيضًا

96
00:08:52,230 --> 00:08:53,000
.اتبعهُم

97
00:08:53,600 --> 00:08:55,770
.نحن بحاجةٍ لمُقابلة المدعو يُو آن

98
00:08:59,410 --> 00:09:03,410
قَصر هُوا

99
00:09:04,310 --> 00:09:06,840
،كُلّما اقترَبنا
.زادَ انتشار عُشب الشّيطان

100
00:09:07,670 --> 00:09:09,870
.يبدو أنّنا وجدنا المكان المَنشود

101
00:09:10,450 --> 00:09:12,780
،هُناك الكثير منه
.ولا يُمكن حرقهُ دفعةً واحدة

102
00:09:13,160 --> 00:09:14,620
،إذا استمرّ في الانتشار

103
00:09:14,650 --> 00:09:16,450
.فقد تَسوء الأمور للغاية

104
00:09:22,960 --> 00:09:24,840
...الحاجز يُمكنه منعهُ مِن

105
00:09:24,850 --> 00:09:26,250
،مُغادرة بلدة لُويِي مُؤقّتًا

106
00:09:26,810 --> 00:09:28,810
...لكن لا يزالُ علينا إيجاد طريقةٍ

107
00:09:28,960 --> 00:09:31,560
للتّعامل مع الأعشاب الّتي
.خرجت بالفِعل

108
00:09:32,750 --> 00:09:35,250
لكنّي قُلت إنّي لن أطلُب
.مُساعدته مجدّدًا

109
00:09:35,260 --> 00:09:35,950
،لا بأس

110
00:09:36,530 --> 00:09:39,130
فليَست هذه المرّة الأولى الّتي
.أتصرّف فيها بلا خجلٍ

111
00:09:43,060 --> 00:09:45,260
،حسنًا، يا كُرة الفحم الصّغيرة
.لنَدخل

112
00:09:46,290 --> 00:09:48,700
.ابقَ قريبًا منّي ولا تبتعِد

113
00:10:00,080 --> 00:10:02,580
!حان دوري الآن

114
00:10:05,920 --> 00:10:08,040
،سيَحصُل الجميع على نصِيبهم
.تعالوا واحدًا تِلو الآخر

115
00:10:25,660 --> 00:10:27,660
.تفضّل، هذه حلواكَ

116
00:10:27,680 --> 00:10:28,710
!شُكرًا لك، يُو آن

117
00:10:29,320 --> 00:10:30,730
!دوري

118
00:10:33,890 --> 00:10:35,980
!شِياوتَان، اصطدتَ الكثير -
.أجل، بالطّبع -

119
00:10:35,990 --> 00:10:37,340
.تفضّل

120
00:10:44,320 --> 00:10:45,630
!حسنًا، التّالي

121
00:10:47,450 --> 00:10:49,800
،كُرة الفحم الصّغيرة
ماذا تفعل؟

122
00:11:11,350 --> 00:11:12,750
...مهلًا... لا تَقُل لي

123
00:11:13,660 --> 00:11:17,050
...تحت هذه الأزهَار

124
00:11:18,140 --> 00:11:20,690
أنا... لم أستطع سِوى
.اصطيادِ واحدةٍ فحسب

125
00:11:20,700 --> 00:11:21,800
.لا تبكي يا نَان نَان

126
00:11:21,830 --> 00:11:23,820
.أعلمُ أنّكِ بذلتِ قُصارى جُهدكِ

127
00:11:23,830 --> 00:11:25,630
لا مزيدَ مِن الدّموع، اتّفقنا؟
.كُوني فتاةً طيّبةً

128
00:11:25,840 --> 00:11:28,040
ما رأيكِ أن أُعطيكِ قِطعتين
مِن الحلوى بدلًا مِن واحدةٍ؟

129
00:11:28,050 --> 00:11:29,850
...استخدامُ أجساد البشر كسمادٍ -
.حسنًا -

130
00:11:29,860 --> 00:11:31,590
.لإحياءِ جُنود السّراب

131
00:11:32,580 --> 00:11:34,440
لا عجبَ أنّي شعرتُ
...بأُلفةٍ غريبة ونُفورٍ

132
00:11:34,450 --> 00:11:36,510
في آنٍ واحد لحظة
.دُخولي بلدة لُويِي

133
00:11:37,130 --> 00:11:38,120
...إنّه حقًا

134
00:11:39,100 --> 00:11:40,330
.عُشب الأشباح

135
00:11:43,030 --> 00:11:45,920
اختفى الكثير مِن النّاس
.بين ليلةٍ وضُحاها

136
00:11:47,070 --> 00:11:49,800
.وتبيّن أنّك حوّلتهم إلى سمادٍ

137
00:11:50,490 --> 00:11:51,680
.شيطانُ السّراب

138
00:11:56,880 --> 00:11:59,150
.لا أتذكّر أنّي رأيتكِ مِن قبل

139
00:11:59,190 --> 00:12:01,120
،لستِ مِن هذه البلدة
أَليس كذلك؟

140
00:12:02,630 --> 00:12:04,960
هل جِئتِ إلى هُنا لتُقايضي
اليراع بالحلوى أيضًا؟

141
00:12:05,810 --> 00:12:07,040
هل تتظاهرُ بالجهل؟

142
00:12:12,990 --> 00:12:14,450
!النّجدة

143
00:12:14,480 --> 00:12:17,660
،شيطانُ السّراب
!اخرُج مِن ذلك الجسد الآن

144
00:12:18,140 --> 00:12:20,650
!أنا... لا أعلمُ عمّ تتحدّثين

145
00:12:21,120 --> 00:12:22,660
.ليس بيننا ضغينةٌ

146
00:12:22,690 --> 00:12:24,790
لماذا تفعلينَ هذا بي؟ -
.كفاكَ تمثيلًا -

147
00:12:24,800 --> 00:12:27,420
أخبرنِي، مِن أين حصلت على
عُشب الأشباح؟

148
00:12:27,430 --> 00:12:28,530
وكيف عرفتَ طريقة استِخدامه؟

149
00:12:28,540 --> 00:12:29,940
...آنِستي، أنا لا أعلمُ

150
00:12:29,950 --> 00:12:31,250
.عمّ تتحدّثين صِدقًا

151
00:12:31,260 --> 00:12:33,520
لنَرى إلى متى ستَستمرّ
.في هذا التّمثيل

152
00:12:41,190 --> 00:12:42,340
!شيطانُ السّراب

153
00:12:42,990 --> 00:12:45,800
،استمرّ في المُقاومة
!وسأًحوّلكَ إلى رمادٍ

154
00:12:47,500 --> 00:12:50,170
.أنا... قادمٌ

155
00:12:50,680 --> 00:12:51,830
.تسَاي تشِينغ

156
00:12:52,880 --> 00:12:55,140
كان خاضعًا لسيطرةِ عُشب
.الأشباح لا غير

157
00:12:55,270 --> 00:12:57,830
،شيطانُ السّراب ليس بداخله
أين هُو إذًا؟

158
00:12:58,430 --> 00:13:01,050
مَن؟ في جسدِ مَن يختبئ؟

159
00:13:02,730 --> 00:13:12,850
.خمّنِي

160
00:13:12,860 --> 00:13:13,990
هل ترغبُ في الموت؟

161
00:13:21,990 --> 00:13:23,830
!تسَاي تشِينغ

162
00:13:26,640 --> 00:13:28,570
...هذا... هذا هُو

163
00:13:29,860 --> 00:13:31,970
!تسَاي تشِينغ

164
00:13:32,960 --> 00:13:35,300
!تسَاي تشِينغ
!أعيدِي لي تسَاي تشِينغ

165
00:13:48,630 --> 00:13:50,570
.تسَاي تشِينغ

166
00:13:51,000 --> 00:13:54,120
مَن الّذي يتحدّث؟

167
00:13:55,240 --> 00:13:56,150
ومَن هِي تسَاي تشِينغ؟

168
00:13:56,160 --> 00:13:57,800
لماذا تقفين هُناك فحسب؟

169
00:13:57,810 --> 00:13:59,080
...خُذِي مرطبان المُخلّل هذا

170
00:13:59,090 --> 00:14:00,670
.إلى ذلك المُشاكس

171
00:14:00,680 --> 00:14:02,880
هل... هل تتحدّث معي؟

172
00:14:02,900 --> 00:14:05,090
هل جاء دوركِ لتسليم
المُطرّزات اليوم؟

173
00:14:05,100 --> 00:14:06,760
مُطرّزات؟ -
.لا أظنّ ذلك -

174
00:14:06,770 --> 00:14:08,250
.أنتِ ترتدينَ حذاءً جديدًا

175
00:14:10,340 --> 00:14:12,540
.أُراهن أنّكِ هُنا لمُقابلة حبيبكِ

176
00:14:12,550 --> 00:14:15,110
.هذا... قصر هُوا

177
00:14:15,130 --> 00:14:16,860
لماذا تسلّل ذلك الكلب مرّةً أُخرى؟

178
00:14:17,260 --> 00:14:18,490
.أبقِينَ أعينكُنّ عليه

179
00:14:18,520 --> 00:14:21,320
تأكّدن مِن أنّه لا يُخيف
.السيّدة أو الآنسات

180
00:14:21,330 --> 00:14:22,290
...أنت

181
00:14:24,790 --> 00:14:25,470
!احذر

182
00:14:27,000 --> 00:14:28,640
...مِن أين أتى هذا الكلب الضّال

183
00:14:28,650 --> 00:14:29,710
ليَتجرّأ على اعتراض
طريق السيّد الشّاب؟

184
00:14:29,720 --> 00:14:31,980
كيف لكَ أن تُطلقَ السّهام
بهذا التهوّر؟

185
00:14:32,750 --> 00:14:35,320
،تشَاو جِين
هل تتحدّث عنّي؟

186
00:14:36,140 --> 00:14:36,910
!أيّتها الجارية

187
00:14:37,300 --> 00:14:39,220
سيّدنا الشّاب يتدرّبُ في
.فنائه الخاصّ

188
00:14:39,230 --> 00:14:40,760
!هذا ليس مِن شأنكِ

189
00:14:40,810 --> 00:14:42,480
،حتّى لو أُصِبتِ

190
00:14:42,580 --> 00:14:44,290
!فهذا خطؤُكِ لأنّكِ عمياء

191
00:14:44,300 --> 00:14:46,810
!يا لوقاحتك! سأُلقّنك درسًا

192
00:14:47,080 --> 00:14:49,150
هل تظنّين أنّكِ ستَرحلين
هكذا بعد إهانة سيّدنا الشّاب؟

193
00:14:49,160 --> 00:14:51,840
.اركعِي واعتذِري الآن

194
00:14:52,940 --> 00:14:54,870
قبل أيّامٍ قليلة، توسّلتُ إلى
.والدي ليأخُذني لصيدِ الغِزلان

195
00:14:54,880 --> 00:14:56,340
.لكن شيئًا ما شغلهُ

196
00:14:56,430 --> 00:14:57,380
...لذا، لماذا لا

197
00:14:57,410 --> 00:14:59,820
أستخدمُ هذا الكلب للتّدريب على الرّماية اليوم؟ -
!تمهّل، كلا -

198
00:14:59,830 --> 00:15:00,540
!احذر

199
00:15:06,550 --> 00:15:08,760
.سيّدي الشّاب، لقد ماتت

200
00:15:09,570 --> 00:15:12,420
أنا... لم أقصِد سِوى
.إصابة الكلب

201
00:15:12,710 --> 00:15:14,710
.لم أتوقّع أن تعترضَ طريقي

202
00:15:14,820 --> 00:15:17,090
ماذا عليّ أن أفعل؟
...أنا

203
00:15:18,370 --> 00:15:19,360
!أيّها السيّد الشّاب

204
00:15:19,540 --> 00:15:21,230
!تشَاو جِين، ساعِدني

205
00:15:22,100 --> 00:15:25,830
!لا تصرُخ يا سيّدي الشّاب -
.عضّةٌ مؤلمة -

206
00:15:26,120 --> 00:15:28,210
هل يبكي وِي؟
ما الخطب؟

207
00:15:30,700 --> 00:15:31,370
.إنّها تسَاي تشِينغ

208
00:15:31,380 --> 00:15:34,470
...استدعُوا الطّبيب
!رُبّما تتمكّن مِن النّجاة

209
00:15:34,940 --> 00:15:37,330
لماذا تقفُون هكذا؟
!أنقذُوها

210
00:15:37,340 --> 00:15:38,170
!صمتًا

211
00:15:38,450 --> 00:15:39,520
...عزيزي

212
00:15:39,660 --> 00:15:40,980
.أغلقُوا الأبواب

213
00:15:41,010 --> 00:15:42,670
.لا أحدَ يدخلُ أو يخرج

214
00:15:44,590 --> 00:15:46,550
!أبي، ساعِدني

215
00:15:48,600 --> 00:15:51,240
.أبي، لم أكُن أقصد

216
00:15:52,060 --> 00:15:53,000
!أيّها الوغد

217
00:15:53,020 --> 00:15:54,750
!انظُر كيف أفسَدته

218
00:15:54,760 --> 00:15:57,190
،سيّدي، أخطأتُ
.كُلّ ذلك كان خطئِي

219
00:15:57,210 --> 00:15:58,740
.أرجوكَ اعفُ عنّي يا سيّدي

220
00:16:00,080 --> 00:16:02,210
،قبل قليلٍ
قُلتِ إنّ اسمها تسَاي تشِينغ؟

221
00:16:02,420 --> 00:16:05,120
،أجل، إنّها ابنةُ السيّدة سُون

222
00:16:05,290 --> 00:16:08,100
.وعشيقة يُو آن البُستانيّ

223
00:16:09,210 --> 00:16:10,080
يُو آن؟

224
00:16:10,560 --> 00:16:11,820
.أنت، تعالَ إلى هُنا

225
00:16:12,790 --> 00:16:14,300
...سـ-سيّدي

226
00:16:19,930 --> 00:16:21,200
...لكن... لكن يا سيّدي

227
00:16:21,210 --> 00:16:23,350
.لا تزالُ تتنفّس

228
00:16:23,830 --> 00:16:27,120
هل يُمكنها النّجاة مِن إصابةٍ كهذه؟

229
00:16:27,580 --> 00:16:30,180
عمّ... عمّ تتحدّثان؟

230
00:16:31,700 --> 00:16:34,870
...ساعدُوها -
.السيّد الشّاب خارجَ المنزل اليوم -

231
00:16:35,400 --> 00:16:36,460
هل تفهمُون؟

232
00:16:37,050 --> 00:16:39,710
...ساعدُوها

233
00:16:41,130 --> 00:16:41,930
.أسرعُوا

234
00:16:45,430 --> 00:16:46,950
.إنّه مؤلمٌ

235
00:16:48,180 --> 00:16:50,410
!ليُنقذني أحدكُم

236
00:16:50,970 --> 00:16:54,210
.أُمّي، يُو آن

237
00:16:57,040 --> 00:16:58,000
،سيّد تشَاو

238
00:16:58,370 --> 00:16:59,750
...إلى أين تذهبُ

239
00:16:59,770 --> 00:17:01,230
بهذا الشّيء الثّقيل؟

240
00:17:03,620 --> 00:17:04,590
.يُو آن

241
00:17:05,510 --> 00:17:06,940
.مرحبًا يا يُو آن

242
00:17:07,080 --> 00:17:08,390
،طلبت السيّدة دُفعةً مِن الشّتلات

243
00:17:08,400 --> 00:17:10,800
.وكُلّفت بإيصالها إلى مشتلِ النّباتات

244
00:17:10,890 --> 00:17:12,660
.لا داعي لذلك، سأَتولّى أنا هذه المُهمّة -
!يُو آن -

245
00:17:12,670 --> 00:17:13,110
.لا بأس

246
00:17:13,110 --> 00:17:15,380
يُو آن، كُنت أبحثُ عنكَ
.في كُلّ مكانٍ

247
00:17:15,480 --> 00:17:17,600
،تعالَ بسُرعةٍ
!السيّد يُريد رُؤيتك

248
00:17:17,600 --> 00:17:18,820
.يُو آن، أنا هُنا

249
00:17:19,770 --> 00:17:22,090
.يُو آن، ساعِدني -
السيّد يُريد رُؤيتي؟ -

250
00:17:22,140 --> 00:17:23,140
،بما أن السيّد يُريد رُؤيتكَ

251
00:17:23,150 --> 00:17:24,280
.فمِن الأفضل أن تذهبَ الآن

252
00:17:25,310 --> 00:17:27,570
،حسنًا، شُكرًا لك إذًا
.يا سيّد تشَاو

253
00:17:27,570 --> 00:17:28,820
.لا مُشكلة

254
00:17:28,830 --> 00:17:30,080
.يُو آن

255
00:17:30,360 --> 00:17:31,680
.يُو آن، لا تذهب

256
00:17:32,950 --> 00:17:35,670
.لا تترُكني، يا يُو آن

257
00:17:50,020 --> 00:17:51,270
.لا تلُومينِي

258
00:17:51,430 --> 00:17:52,680
.لم أكُن أقصِد ذلك

259
00:17:52,700 --> 00:17:54,120
.كانت فِكرة السيّد

260
00:18:07,900 --> 00:18:09,190
.أرجوكِ أغمضِي عينيكِ

261
00:18:09,200 --> 00:18:10,650
،السيّد الشّاب هُو مَن قتلكِ

262
00:18:10,660 --> 00:18:12,000
.والسيّد هُو مَن أمر بدفنكِ حيّةً

263
00:18:12,010 --> 00:18:13,660
.لم يكُن بيدي حِيلةٌ

264
00:18:14,610 --> 00:18:15,560
!لا تكرهِيني

265
00:18:15,680 --> 00:18:17,360
!اكرهِيهما

266
00:18:23,450 --> 00:18:24,730
هل تكرهِينهُما؟

267
00:18:24,750 --> 00:18:27,540
مَن؟ مَن الّذي يتحدّث؟

268
00:18:27,850 --> 00:18:31,430
ما قولكِ أن أُساعدكِ في الانتقام؟

269
00:18:31,460 --> 00:18:32,850
مَن أنت؟

270
00:18:34,350 --> 00:18:37,920
...لا تقلقي، لن ينفذَ

271
00:18:38,410 --> 00:18:40,600
.أيّ مِن الّذين آذوكِ بفعلتِه

272
00:18:44,730 --> 00:18:47,840
.كلا

273
00:18:48,610 --> 00:18:49,590
!كلا

274
00:18:51,920 --> 00:18:53,860
.جُوان جوُان

275
00:18:54,280 --> 00:18:59,660
!استيقِظي

276
00:19:03,410 --> 00:19:10,460
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

277
00:19:10,470 --> 00:19:18,770
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

278
00:19:20,850 --> 00:19:25,130
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

279
00:19:25,600 --> 00:19:28,540
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

280
00:19:30,220 --> 00:19:34,080
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

281
00:19:34,110 --> 00:19:37,970
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

282
00:19:38,530 --> 00:19:42,850
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

283
00:19:43,260 --> 00:19:47,490
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

284
00:19:47,980 --> 00:19:53,160
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

285
00:19:53,190 --> 00:19:56,880
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

286
00:19:57,250 --> 00:20:02,390
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

287
00:20:02,410 --> 00:20:06,700
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

288
00:20:06,820 --> 00:20:11,790
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

289
00:20:11,910 --> 00:20:16,240
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

290
00:20:21,400 --> 00:20:26,580
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟