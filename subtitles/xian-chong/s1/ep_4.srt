1
00:00:45,610 --> 00:00:49,540
مرّت عشر سنواتٍ مُنذ آخر مرّةٍ شعرتُ
.فيها بما يعنيه أن أعيشَ كبشرٍ

2
00:00:50,890 --> 00:00:53,030
ما زالَ العيشُ كإنسانٍ يبعثُ
.فيَّ سُرورًا

3
00:01:02,830 --> 00:01:09,640
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

4
00:01:09,810 --> 00:01:15,030
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

5
00:01:17,360 --> 00:01:23,240
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

6
00:01:23,780 --> 00:01:29,420
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

7
00:01:30,830 --> 00:01:36,880
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

8
00:01:38,050 --> 00:01:43,780
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

9
00:01:45,650 --> 00:01:51,890
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

10
00:01:52,570 --> 00:01:58,140
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

11
00:01:58,910 --> 00:02:05,840
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

12
00:02:06,240 --> 00:02:11,640
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

13
00:02:12,970 --> 00:02:19,070
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

14
00:02:19,160 --> 00:02:26,630
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

15
00:02:40,950 --> 00:02:42,750
،أنت حيوانٌ أليف في قصر بَانيو

16
00:02:42,780 --> 00:02:44,500
ومع ذلك تسمّمت بعُشبة
.الشّبح بسُهولةٍ

17
00:02:44,510 --> 00:02:46,050
.يا للإحراج

18
00:02:46,070 --> 00:02:47,070
.كُونِي لطيفةً

19
00:02:47,180 --> 00:02:49,070
.أُذناي هُما الأكثر حساسيّةً

20
00:02:49,610 --> 00:02:51,670
.عُشب سمّاعة الأذن لا يُستهان به

21
00:02:51,680 --> 00:02:54,330
أردتُ إبلاغَ الخالدة عن
،الوضع في بلدة لُويِي

22
00:02:54,340 --> 00:02:56,730
لكن هُناك صوتًا في أُذني
.كان يمنعني دائمًا

23
00:02:56,740 --> 00:02:58,870
،ولسببٍ ما
.لم أستطِع قول شيءٍ

24
00:02:59,250 --> 00:03:01,110
إذن، ما الفائدة مِن تربيتكَ؟

25
00:03:01,570 --> 00:03:05,220
،يا مِيان مِيان
.هذا ليس عدلًا

26
00:03:05,500 --> 00:03:07,280
.ساعدتُكِ كثيرًا

27
00:03:07,700 --> 00:03:08,970
فِيمَ ساعدتنِي؟

28
00:03:11,260 --> 00:03:13,020
،وبعد أن طبختِ
.أكلتُ في الموعد

29
00:03:18,550 --> 00:03:21,160
ظلّ كُرة الفحم الصّغيرة نائمًا
.مُنذ عودته

30
00:03:21,170 --> 00:03:23,170
لا بُدّ أنّه كان مُرهقًا
.للغاية مِن قبل

31
00:03:23,400 --> 00:03:26,070
يا جُوان جُوان، إنّه يعرفُ
.الكثير عن عُشبة الشّبح

32
00:03:26,110 --> 00:03:27,440
ما هي حقيقتُه؟

33
00:03:30,470 --> 00:03:32,470
،سيّدي مُروّض الوُحوش
.مِن هُنا فضلًا

34
00:03:32,590 --> 00:03:33,220
.وصل

35
00:03:39,970 --> 00:03:41,180
،أيّتها الخالدة

36
00:03:41,280 --> 00:03:43,500
مِن أين أتيتِ بهذا الطّائر؟

37
00:03:43,610 --> 00:03:45,620
وجدتهُ بمحض الصّدفة
.في عالم البشر

38
00:03:45,630 --> 00:03:46,630
...هل يُعقل أن

39
00:03:46,650 --> 00:03:49,960
يكون الطّائر الرّوحاني
الأسطوريّ لِيكسيَاو؟

40
00:03:49,990 --> 00:03:52,500
لِيكسيَاو؟
.الاسم يبدو رائعًا

41
00:03:52,720 --> 00:03:54,110
هل حالفنِي الحظّ؟

42
00:03:56,060 --> 00:03:57,580
،بناءً على حكايا الكائنات

43
00:03:57,590 --> 00:04:00,190
قليلونَ في العوالم الثّلاثة
.مَن يُمكنهم تغيير أقدارِهم

44
00:04:00,560 --> 00:04:02,620
.لِيكسيَاو واحدٌ منهم

45
00:04:03,940 --> 00:04:07,460
وُلِد بعد أن صقلتهُ نِيران
.الكون التّسعة

46
00:04:07,470 --> 00:04:09,550
.إنّه طائرٌ رُوحانيّ نادر

47
00:04:09,830 --> 00:04:13,800
تزعمُ الأُسطورة أنّ قدرَ لِيكسيَاو
.في ماضيه كان صراعًا داميًا

48
00:04:13,820 --> 00:04:17,680
وما نقلَ ذكرياته لحياته
...الحاضرة إلّا لأجل

49
00:04:18,830 --> 00:04:20,890
.لأجل الانتِقام لا غير

50
00:04:21,690 --> 00:04:22,850
...تقصد

51
00:04:22,870 --> 00:04:25,140
أنّني رُبّما آويتُ... عدوًا؟

52
00:04:26,760 --> 00:04:28,420
.لكنّها أسطورةٌ في النّهاية

53
00:04:28,450 --> 00:04:30,450
،لا تأخُذيها على محمل الجدّ
.أيّتها الخالدة

54
00:04:30,480 --> 00:04:32,660
وهل ذكرت الأُسطورة أنّه
...يملكُ مهاراتٍ طبيّةً

55
00:04:32,670 --> 00:04:33,510
أو معرفةً بالأعشاب؟

56
00:04:35,480 --> 00:04:37,400
.لم أسمع بذلك قطّ

57
00:04:37,560 --> 00:04:40,090
.لكن لِيكسيَاو نادرٌ حقًا

58
00:04:40,500 --> 00:04:41,560
،أيّتها الخالدة

59
00:04:41,780 --> 00:04:43,840
هل أنتِ مستعدّةٌ لإعارتي
...هذا الطّائر الرُوحانيّ

60
00:04:43,850 --> 00:04:45,680
لأرصدهُ عن كثبٍ؟

61
00:04:45,690 --> 00:04:47,240
...بكُلّ تأكيدٍ

62
00:04:47,260 --> 00:04:49,740
سأدرسهُ مِن رأسه إلى
.أخمصِ قدميه

63
00:04:51,450 --> 00:04:52,190
.ودّعيه إلى الخارج

64
00:04:53,950 --> 00:04:56,150
.سيّدي مُروض الوُحوش، تفضّل

65
00:04:56,700 --> 00:04:59,120
...لو تمكّنتُ مِن إكمال الأجزاء النّاقصة

66
00:04:59,150 --> 00:05:00,340
،في حكايا الكائنات

67
00:05:00,350 --> 00:05:02,560
!لكانَ ذلك إنجازًا عظيمًا

68
00:05:02,980 --> 00:05:04,910
!أيّتها الخالدة! أيّتها الخالدة

69
00:05:06,240 --> 00:05:09,370
،لستَ هُنا لتُطالبني بدينٍ
أَليس كذلك؟

70
00:05:12,030 --> 00:05:12,790
،يا جُوان جُوان

71
00:05:14,420 --> 00:05:17,150
أرسلَ عالم هُونغ مِينغ
.السّماوي دعوةً

72
00:05:25,900 --> 00:05:28,720
،إنّهم يقفونَ أمام بُوذا بوقارٍ

73
00:05:28,750 --> 00:05:31,130
ويمكثُ برعمهُم ثلاثة آلاف
.عامٍ ليُزهر

74
00:05:31,400 --> 00:05:33,450
ماذا تعني هذه الكلمات المُنمّقة؟

75
00:05:33,460 --> 00:05:34,570
،إنّها زهرة ملكة اللّيل

76
00:05:34,590 --> 00:05:37,360
،تنبتُ مرّةً كُلّ ألف عامٍ
،وتُبرعِم كُلّ ألفين

77
00:05:37,370 --> 00:05:39,100
وتُزهر مرّةً واحدة كُلّ
.ثلاثة آلاف عامٍ

78
00:05:39,510 --> 00:05:40,800
لا تتفتّح هذه الزّهور
.إلّا لليلةٍ واحدة

79
00:05:40,810 --> 00:05:43,660
وفي اللّحظة الّتي يبزغُ فيها
.ضُوء الصّباح، تذبلُ فورًا

80
00:05:43,670 --> 00:05:45,290
حتّى أُولئك الّذين يعيشونَ
...أعمار الخالدين

81
00:05:45,300 --> 00:05:47,500
قد لا يحظونَ أبدًا بنظرةٍ
.على جمالها

82
00:05:47,770 --> 00:05:49,680
،مهرجان مُنتصف الخريف غدًا

83
00:05:49,690 --> 00:05:51,690
وهُو اليوم الّذي تُزهر فيه
.ملكة اللّيل

84
00:05:52,000 --> 00:05:55,330
إذن، هل تُقيم الملكة مأدبةً
للاستمتاع بالزّهور غدًا؟

85
00:05:57,090 --> 00:05:58,570
...أخيرًا، نِلتُ فُرصةً لأُلبسكِ

86
00:05:58,580 --> 00:06:00,420
.ذلك الرّداء المُفضّل لديّ

87
00:06:00,740 --> 00:06:02,800
،وهذه المرّة
.سأُبرز جمالكِ كما ينبغي

88
00:06:02,810 --> 00:06:04,050
—الثّياب الّتي أعددتُها لكِ سابقًا

89
00:06:04,060 --> 00:06:05,580
.لم تُتح لكِ فُرصة ارتدائِها

90
00:06:05,590 --> 00:06:07,170
.يا للخسارة

91
00:06:07,510 --> 00:06:09,980
...أمّا الآن... فسأجعلكِ

92
00:07:00,580 --> 00:07:01,640
.أيّها الأخ الأكبر

93
00:07:15,490 --> 00:07:17,850
!ارتداءُ مثل هذه الملابس مزعجٌ للغاية

94
00:07:18,080 --> 00:07:19,590
وما المُزعج في ذلك؟

95
00:07:19,600 --> 00:07:20,980
سيَكون هُناك الكثير مِن
.الضّيوف في المأدبة

96
00:07:20,990 --> 00:07:23,210
،جُوان جُوان
.أنتِ جمالٌ لا مثيلَ له

97
00:07:23,470 --> 00:07:25,290
ويجب أن يراكِ الجميع
.ويُعجبوا بكِ

98
00:07:25,320 --> 00:07:27,660
.رُبّما تلتقين بشخصٍ مُميّز

99
00:07:29,310 --> 00:07:31,510
ستُقابلين اللّورد جِينغ شُون
اليوم، صحيحٌ؟

100
00:07:32,280 --> 00:07:33,540
وما المُميّز في مُقابلته؟

101
00:07:33,550 --> 00:07:36,470
إنّه أقوى إله حربٍ في
،العالم السّماوي

102
00:07:36,680 --> 00:07:38,400
.كما أنّه أنيقٌ ووسيم

103
00:07:38,490 --> 00:07:41,150
حيثُما يذهب، يبدو وكأنّه
.منسوجٌ مِن ضوء القمر

104
00:07:41,150 --> 00:07:42,290
.إنّه متكبّرٌ جدًا

105
00:07:42,310 --> 00:07:44,580
يتباهى على الدّوام بوَحشي
.الكِيلين اللّذين يملكهُما

106
00:07:44,600 --> 00:07:46,130
.بالضّبط

107
00:07:46,530 --> 00:07:48,110
،دائمًا ما يعبسُ في وجوه النّاس

108
00:07:48,140 --> 00:07:49,930
.وكأنّ الجميع مدينونَ له بالمال

109
00:07:50,280 --> 00:07:52,710
يومًا ما، سأجدُ طائرًا
،عملاقًا ليكونَ مركبي

110
00:07:52,920 --> 00:07:54,830
كي أطغى به على وَحشي
.الكِيلين اللّذين يملكهُما

111
00:07:59,440 --> 00:08:00,360
هل لا زالَ كُرة الفحم الصّغيرة نائمًا؟

112
00:08:00,370 --> 00:08:01,480
،استيقظَ هذا الصّباح

113
00:08:01,490 --> 00:08:02,650
.وأكلَ كثيرًا

114
00:08:02,670 --> 00:08:03,910
.لذا يُفترض أن يكون بخيرٍ

115
00:08:04,330 --> 00:08:06,780
،رُبّما ذهبَ للّعب في مكانٍ ما

116
00:08:07,850 --> 00:08:09,670
.فهُو لا يزالُ طيرًا صغيرًا

117
00:08:09,680 --> 00:08:11,540
،أنا راحلةٌ
.اعتَني به جيدًا

118
00:08:11,690 --> 00:08:12,630
،لا تقلقِي

119
00:08:26,500 --> 00:08:27,470
!مِيان مِيان

120
00:08:30,770 --> 00:08:33,620
،مِيان مِيان! تَشانغ إير
.السيّد قطّ، عُدت

121
00:08:33,730 --> 00:08:34,540
!سِي

122
00:08:35,450 --> 00:08:36,980
،أيّتها الخالدة
.تفضّلي مِن هُنا

123
00:08:47,630 --> 00:08:49,630
،لم تُزهِر ملكة اللّيل بعد

124
00:08:49,670 --> 00:08:51,400
،وبعد مأدبة اللّيلة

125
00:08:51,430 --> 00:08:53,240
...سيَقود العاهل والملكة

126
00:08:53,260 --> 00:08:57,060
جميع الحُضور إلى هُنا للاستمتاع
.بمشهدِ تفتّح الزّهور معًا

127
00:09:07,760 --> 00:09:09,230
مَن هِي؟

128
00:09:09,260 --> 00:09:10,980
.إنّها مذهلةٌ

129
00:09:11,000 --> 00:09:11,990
هل رأيتَها أنت أيضًا؟

130
00:09:12,130 --> 00:09:13,430
،لاحظتُها لتوّي

131
00:09:14,150 --> 00:09:16,270
.تبدو مألوفةً نوعًا ما

132
00:09:17,040 --> 00:09:19,170
...منطقيًا، لا ينبغي لي أن أنسى

133
00:09:19,240 --> 00:09:20,710
.سيّدةً بهذا الجمال

134
00:09:21,590 --> 00:09:23,980
.أنتما جاهِلان بالفِعل

135
00:09:24,310 --> 00:09:26,170
،إنّها تِيان كُوان
...تلك الّتي قتلت

136
00:09:26,180 --> 00:09:29,020
ملك السّراب في معركة
.أرض السّراب

137
00:09:30,370 --> 00:09:33,200
تلك هِي إلهةُ الحرب؟

138
00:09:33,220 --> 00:09:34,780
.إنّ وراءَ مظهرِها ما لا تراهُ العين

139
00:09:34,790 --> 00:09:36,770
،سمعتُ أنّه بعد تلك المعركة

140
00:09:36,800 --> 00:09:38,610
،جرّدها العاهل مِن سُلطتها العسكريّة

141
00:09:38,620 --> 00:09:41,620
ونفاها إلى عالم البشر
.لتكونَ إلهةً للأرض

142
00:09:42,150 --> 00:09:43,920
.انتبِه لكلامكَ عن العاهل

143
00:09:43,930 --> 00:09:45,860
وكُن حذرًا كي لا تزلّ
.بقولٍ في غير موضعِه

144
00:09:46,140 --> 00:09:48,550
إذن تلك هِي الخالدة
.تِيان كُوان الشّهيرة

145
00:09:48,940 --> 00:09:51,750
...لا عجبَ، فشعرُها المُجعّد

146
00:09:53,180 --> 00:09:54,540
...لافتٌ للأَنظار

147
00:10:04,430 --> 00:10:05,590
.أنا... أنا آسفةٌ

148
00:10:10,570 --> 00:10:11,440
.شُكرًا لك

149
00:10:11,460 --> 00:10:12,840
،لا تغضبي أيّتها الخالدة

150
00:10:12,850 --> 00:10:13,910
...شعركِ المُجعّد

151
00:10:14,320 --> 00:10:15,380
.جميلٌ للغاية

152
00:10:26,100 --> 00:10:26,800
.أيّتها الخالدة

153
00:10:31,340 --> 00:10:33,940
حسنًا؟
.غِبت لما يقربُ العام هذه المرّة

154
00:10:33,950 --> 00:10:35,450
هل مِن أخبارٍ عن السيّد شَاو؟

155
00:10:38,130 --> 00:10:39,120
.لا شيءَ على الإطلاق

156
00:10:40,110 --> 00:10:42,420
هل يُعقل أنّ حاسّة شمّك
قد ضعُفت؟

157
00:10:44,840 --> 00:10:46,870
!سِي هُو سليل كلب السّماء

158
00:10:46,880 --> 00:10:48,060
،في تتبّع الرّوائح وتمييز الأشخاص

159
00:10:48,070 --> 00:10:49,390
إذا لم يكُن الأفضل في
،كُلّ العوالم

160
00:10:49,400 --> 00:10:50,610
فلا يتجرّأ أحدٌ غيره
!على ادّعاء هذا اللّقب

161
00:10:50,620 --> 00:10:52,530
!ليس الجميع عدِيمي الفائدة مثلكَ

162
00:10:56,090 --> 00:10:57,390
.أنا عديمُ الفائدة

163
00:10:57,890 --> 00:10:59,390
،أَنقذت الخالدة حياتي

164
00:10:59,790 --> 00:11:01,720
لكنّني لا أستطيعُ مُساعدتها
.في هذه المسألة

165
00:11:01,840 --> 00:11:03,100
.لا تلُم نفسكَ

166
00:11:03,220 --> 00:11:06,170
طوال هذه السّنوات، فتّشتَ أرض تَشانغ
.شُو شبرًا بشبرٍ مُستعينًا بحاسّة شمّكَ

167
00:11:06,180 --> 00:11:07,670
...الفشل في العُثور على السيّد شاو

168
00:11:07,690 --> 00:11:09,000
.ليس خطأكَ

169
00:11:09,610 --> 00:11:12,940
ليس هُناك ما يشغلُ بال
،جُوان جُوان في هذه الحياة سِواه

170
00:11:13,300 --> 00:11:16,360
لذا أخشى أنّها لن تتمكّن
.مِن نسيانِه مهما حدث

171
00:11:27,080 --> 00:11:29,210
،اليوم هُو مهرجان مُنتصف الخريف

172
00:11:29,220 --> 00:11:31,400
.ويُصادف تفتّح ملكة اللّيل

173
00:11:31,410 --> 00:11:33,710
.إنّه يومٌ مُبارك ونادر

174
00:11:34,370 --> 00:11:36,190
،وبوُجودكم جميعًا

175
00:11:36,380 --> 00:11:37,580
.أنا سعيدٌ حقًا

176
00:11:37,960 --> 00:11:40,290
يجب أن تستمتِعوا بوقتكُم
.لأقصى حدّ

177
00:11:41,450 --> 00:11:42,850
.شُكرًا لك، جلالة العاهل

178
00:11:45,350 --> 00:11:47,750
مضى وقتٌ طويل مُنذ آخر
.مرّةٍ رأيتُ فيها تِيان كُوان

179
00:11:48,900 --> 00:11:51,440
قدّمتِ مُساهماتٍ عظيمة في
.معركة أرض السّراب

180
00:11:51,450 --> 00:11:53,180
،كان يجب أن تُرقّي

181
00:11:53,450 --> 00:11:54,610
لكنّكِ أصررتِ على الذّهاب
،إلى عالم البشر

182
00:11:54,620 --> 00:11:56,300
.لتولّي منصب إلهة الأرض

183
00:11:56,310 --> 00:11:59,260
قُلتِ إنّكِ تُفضّلين الأجواء
.الحيويّة في عالم البشر

184
00:11:59,270 --> 00:12:00,340
،ومُنذ رحيلكِ

185
00:12:00,660 --> 00:12:02,790
أصبحَ عالم هُونغ مِينغ
.مهجورًا نوعًا ما

186
00:12:04,650 --> 00:12:05,830
،كُنت جامحةً دومًا

187
00:12:05,840 --> 00:12:07,400
.ولا أطيقُ الرّسميات

188
00:12:07,410 --> 00:12:08,860
...إنّ كونِي إلهة أرضٍ حُرّة

189
00:12:08,870 --> 00:12:12,200
،أحمي النّاس خدمةً للعاهل
.يُناسبني تمامًا

190
00:12:13,530 --> 00:12:14,330
...أنتِ بالفِعل

191
00:12:16,450 --> 00:12:17,250
،جلالة العاهل

192
00:12:17,300 --> 00:12:19,650
بما يتعلّق بحادثة بلدة لُويِي
،الّتي أبلغتُ عنها سابقًا

193
00:12:19,660 --> 00:12:20,470
...أتساءل

194
00:12:20,820 --> 00:12:21,930
،تِيان كُوان

195
00:12:22,580 --> 00:12:25,410
اليوم وقتٌ مثاليّ لتأمّل
.الزّهور وضياء القمر

196
00:12:25,730 --> 00:12:28,010
.لنتحدّث عن العمل غدًا

197
00:12:28,430 --> 00:12:30,630
.لا تُفسدي مزاجَ الخالدين الآخرين

198
00:12:36,190 --> 00:12:37,450
.حاضرٌ، يا جلالة العاهل

199
00:12:38,980 --> 00:12:40,120
...تِيان كُوان، أنتِ

200
00:12:40,400 --> 00:12:42,200
تُركّزين على العمل أكثر
.مِن اللّازم

201
00:12:42,530 --> 00:12:44,330
.لهذا السّبب لا تزالينَ عزباء

202
00:12:44,460 --> 00:12:46,810
!يا لضياعِ سنوات شبابكِ

203
00:12:50,640 --> 00:12:52,200
.هِي محقّةٌ

204
00:12:52,540 --> 00:12:53,530
،تِيان كُوان

205
00:12:54,010 --> 00:12:55,470
.لم تعودِي صغيرةً بعد الآن

206
00:12:55,850 --> 00:12:57,580
هل هُناك شخصٌ تُحبّينه؟

207
00:12:57,690 --> 00:12:59,020
يُمكنني أن أقومَ بالتّرتيبات
.اللّازمة لأجلكِ

208
00:13:01,110 --> 00:13:03,730
،ما زِلتُ شابّةً
.لا داعي للعجلة

209
00:13:04,610 --> 00:13:05,460
حقًا؟

210
00:13:05,630 --> 00:13:07,610
.حتّى أنا قلقةٌ أكثر منكِ

211
00:13:08,370 --> 00:13:10,780
،بما أنّ جميع الخالدين هُنا اليوم

212
00:13:10,800 --> 00:13:12,110
.ألقِي نظرةً فاحصة

213
00:13:12,310 --> 00:13:13,520
.رُبّما تجِدين شخصًا مُناسبًا

214
00:13:13,530 --> 00:13:14,500
.كلا... لا داعِي، يا مولاتي

215
00:13:14,510 --> 00:13:16,810
...الخالدة تِيان كُوان شهيرةٌ

216
00:13:17,420 --> 00:13:18,960
.وجميلة

217
00:13:19,250 --> 00:13:21,060
.والرّجال العاديّون لا يستحقّونها

218
00:13:22,080 --> 00:13:25,390
،يجب أن يكون نبيلًا، ومُستقيمًا

219
00:13:26,180 --> 00:13:28,010
.وحكيمًا، وشُجاعًا

220
00:13:32,360 --> 00:13:33,550
.مثل اللّورد جِينغ شُون

221
00:13:34,040 --> 00:13:35,700
كيف لم أُفكّر بك؟

222
00:13:36,870 --> 00:13:39,230
جلالة العاهل، انظُر كم يبدو
...اللّورد جِينغ شُون

223
00:13:39,320 --> 00:13:41,120
وتِيان كُوان مُتناغِمين
!ومُناسبين لبعضهِما

224
00:13:42,130 --> 00:13:42,970
.بالطّبع

225
00:13:43,410 --> 00:13:45,810
قاتلتُما جنبًا إلى جنبٍ
.في ساحة المعركة

226
00:13:45,970 --> 00:13:48,830
وبالتّأكيد يُمكنكما الاعتناء
.ببعضكُما في الحياة اليوميّة

227
00:13:48,870 --> 00:13:49,810
...لماذا لا تقُومان بـ

228
00:13:50,100 --> 00:13:51,600
...اللّورد جِينغ شُون

229
00:13:51,630 --> 00:13:52,880
...باسلٌ

230
00:13:53,150 --> 00:13:54,410
.ومُتميّز

231
00:13:54,420 --> 00:13:56,710
...لكنّني... أنا

232
00:13:56,970 --> 00:13:58,300
.لديّ حساسيّةٌ مِن فراء الثّعالب

233
00:14:01,360 --> 00:14:02,220
...وخُصوصًا

234
00:14:03,080 --> 00:14:03,950
.الفراء المُجعّد

235
00:14:07,070 --> 00:14:09,070
.لديكَ حسّ دُعابةٍ دُون شكّ

236
00:14:13,830 --> 00:14:16,030
،لُورد جِينغ شُون
،أنت لستَ مُهتمًا

237
00:14:16,860 --> 00:14:19,510
...لكن عينِي كانت على

238
00:14:24,540 --> 00:14:26,760
...التّلميذ الوسيم خلفكَ

239
00:14:27,710 --> 00:14:28,840
.مُنذ فترةٍ ليست بقصيرةٍ

240
00:14:29,660 --> 00:14:32,510
أيّها السيّد، ما رأيكَ بي؟

241
00:14:34,220 --> 00:14:35,230
ما الّذي يحدث؟

242
00:14:35,250 --> 00:14:36,730
هل هِي تخطفُ صغار السّن؟

243
00:14:37,060 --> 00:14:39,000
.هذه المأدبة تستحقّ الحُضور

244
00:14:39,670 --> 00:14:41,360
هل تفعلُ هذا عمدًا لإغضاب
...اللّورد جِينغ شُون

245
00:14:41,370 --> 00:14:42,640
بعد شجارِهما؟

246
00:14:48,190 --> 00:14:49,400
...حسنًا... أنا

247
00:14:52,200 --> 00:14:53,770
ماذا تفعلُ الآن؟

248
00:14:59,650 --> 00:15:00,690
ماذا حدث؟

249
00:15:00,800 --> 00:15:01,800
،يا مولاتي

250
00:15:01,980 --> 00:15:04,130
...مركب أحدهم يُثير جلبةً

251
00:15:04,150 --> 00:15:04,970
.في الخارج

252
00:15:04,980 --> 00:15:06,990
.لعلّ الخدم لم يُحسنوا الاهتمام به

253
00:15:07,000 --> 00:15:08,200
سأتولّى التّعامل مع الموقف
.بنفسي الآن

254
00:15:08,960 --> 00:15:09,760
،جلالة العاهل

255
00:15:10,100 --> 00:15:11,470
.تذكّرتُ أنّ لديّ مهمّةٌ في القصر

256
00:15:11,480 --> 00:15:12,540
.سأستأذنُ بالرّحيل

257
00:15:13,550 --> 00:15:15,930
تِيان كُوان، زهرة ملكة اللّيل
.على وشكِ أن تُزهر

258
00:15:15,940 --> 00:15:17,080
أَلن تبقي لرُؤيتها؟

259
00:15:17,090 --> 00:15:18,020
.لا حاجةَ لذلك

260
00:15:18,040 --> 00:15:19,500
.طبعُها العَجول لم يتبدّل

261
00:15:19,890 --> 00:15:21,170
.دَعيها وشأنها

262
00:15:34,820 --> 00:15:36,210
.أيّتها الخالدة، أرجوكِ انتظِري

263
00:15:38,500 --> 00:15:39,730
.أيّتها الخالدة

264
00:15:39,870 --> 00:15:41,950
إنّه أنت، ما الأمر؟

265
00:15:43,770 --> 00:15:45,650
...في الحقيقة... قبل قليلٍ

266
00:15:48,390 --> 00:15:50,310
.كان مُجرّد مزاحٍ

267
00:15:50,460 --> 00:15:52,160
.لا تأخذ الموضوع على محملِ الجدّ

268
00:15:54,220 --> 00:15:54,960
.صحيحٌ

269
00:15:55,750 --> 00:15:57,010
.بالطّبع كان مزاحًا

270
00:15:57,450 --> 00:15:58,850
كيف لي أن أكونَ جديرًا بكِ؟

271
00:16:00,090 --> 00:16:00,950
...لكنّني أُقسم

272
00:16:01,140 --> 00:16:02,340
،أنّني سأتدرّب بجدٍ

273
00:16:02,770 --> 00:16:04,100
.ولن أتراخى قطعًا

274
00:16:04,220 --> 00:16:05,180
...يومًا ما

275
00:16:05,210 --> 00:16:06,270
.أحسنتَ، يا يُونغ جِيانغ

276
00:16:06,620 --> 00:16:08,880
مِن الجيّد أن يكونَ لدى
.الشّباب طموحٌ

277
00:16:08,890 --> 00:16:09,540
.استمرّ في ذلك

278
00:16:15,000 --> 00:16:17,330
،أيّتها الخالدة
.أنتِ صريحةٌ ونقيّة للغاية

279
00:16:17,910 --> 00:16:20,440
لا عجبَ أن أُختي الصّغرى
.تُحبّكِ كثيرًا

280
00:16:20,530 --> 00:16:21,730
أُختك الصّغرى؟

281
00:16:22,050 --> 00:16:22,710
.أجل

282
00:16:23,820 --> 00:16:24,880
،بمُناسبة الحديث

283
00:16:25,330 --> 00:16:27,060
...لم أشكركِ بعد بما يليقُ

284
00:16:27,320 --> 00:16:28,610
.لإنقاذكِ لها

285
00:16:30,480 --> 00:16:31,680
...هل لا تزالينَ تتذكّرين

286
00:16:32,410 --> 00:16:35,730
يُون زُو؟

287
00:16:38,810 --> 00:16:40,820
.بِي يُون زُو، بِي يُون جِيانغ

288
00:16:41,440 --> 00:16:42,460
.فهمتُ الآن

289
00:16:43,930 --> 00:16:45,400
كيف حال يُون زُو؟

290
00:16:46,140 --> 00:16:48,000
.سلبَ شيطان السّراب رُوحها حينها

291
00:16:48,010 --> 00:16:49,700
.وقد سبّب ذلك لها أمراضًا مُزمنة

292
00:16:49,710 --> 00:16:50,790
،إنّها ضعيفةٌ بعض الشّيء

293
00:16:52,150 --> 00:16:53,480
.لكنّها قنوعةٌ جدًا

294
00:16:53,810 --> 00:16:54,850
...أرادت دعوتكِ إلى عالم

295
00:16:54,860 --> 00:16:55,950
.يَاو غُوانغ صدقًا

296
00:16:58,310 --> 00:17:00,000
.حسنًا، سأقومُ بزيارتها

297
00:17:01,090 --> 00:17:03,160
رائعٌ، ستكونُ يُون زُو
.سعيدةً للغاية

298
00:17:03,530 --> 00:17:05,770
زهرة ملكة اللّيل على وشكِ
.أن تُزهر

299
00:17:06,160 --> 00:17:07,740
...أتساءل إن كُنتِ ستَمنحينِي شرفَ

300
00:17:08,100 --> 00:17:09,650
الاستمتاع برُؤيتها معكِ؟

301
00:17:12,060 --> 00:17:14,990
...في الواقع

302
00:17:22,280 --> 00:17:24,330
.سيّدتي ستَعودُ إلى القصر

303
00:17:24,470 --> 00:17:25,930
،إذا كان هُناك أيّ شيءٍ آخر

304
00:17:26,210 --> 00:17:28,130
.فأَرجو إرسال دعوةٍ في يومٍ آخر

305
00:17:28,140 --> 00:17:31,540
قصر بَان يُوي سيَستقبلُك
.بكُلّ حفاوةٍ، وداعًا

306
00:17:40,170 --> 00:17:42,520
...ألم تقُل إنّ طائرًا ضخمًا

307
00:17:42,550 --> 00:17:44,010
كان يُثير المشاكل هُنا؟

308
00:17:44,130 --> 00:17:45,130
أين الطّائر؟

309
00:17:47,560 --> 00:17:48,930
.كان هُنا قبل لحظاتٍ

310
00:17:50,150 --> 00:17:51,390
.طائرٌ ضخم جدًا

311
00:17:51,410 --> 00:17:53,260
كيف لي أن أُخطئ؟

312
00:18:11,660 --> 00:18:13,140
!مَن أنت؟ أفلتنِي

313
00:18:16,950 --> 00:18:18,080
.ها أنت إذن

314
00:18:19,490 --> 00:18:20,860
جِئتَ مُستعدًا، أَليس كذلك؟

315
00:18:20,870 --> 00:18:23,930
اسمع، تعاملتُ مع رجالٍ
.مُتهوّرين مثلكَ

316
00:18:23,940 --> 00:18:25,540
وكُلّ واحدٍ منهم نالَ
.نصيبهُ مِن الضّرب

317
00:18:25,550 --> 00:18:26,750
.ارحل إن كُنت حكيمًا

318
00:18:29,470 --> 00:18:31,000
.يبدو أنّك أحمق

319
00:18:31,800 --> 00:18:33,800
،حسنًا. إن كُنت لن ترحل
.فسأَرحل أنا

320
00:18:35,590 --> 00:18:36,150
.واحدٌ

321
00:18:36,610 --> 00:18:37,280
.اثنان

322
00:18:38,360 --> 00:18:39,390
.ثلاثةٌ

323
00:18:46,870 --> 00:18:48,300
.جميلٌ جدًا

324
00:18:54,560 --> 00:18:55,490
...لم أتخيّل قطّ

325
00:18:56,730 --> 00:18:58,590
أنّ هذا العالم يُمكن أن
.يحوي مثل هذا المنظر

326
00:18:59,770 --> 00:19:00,370
،جُوان جُوان

327
00:19:01,390 --> 00:19:02,250
.جِئتُ لآخذكِ إلى القصر

328
00:19:02,260 --> 00:19:02,960
أنت؟

329
00:19:09,030 --> 00:19:12,430
كُرة... كُرة الفحم الصّغيرة؟
...كيف لكَ أن

330
00:19:12,440 --> 00:19:15,900
...مُنذ لحظةٍ... هذا
!هذا رائعٌ حقًا

331
00:19:35,840 --> 00:19:38,020
!يا للرّوعة! أنا أطِير

332
00:19:38,660 --> 00:19:39,980
!أسرِع أكثر -
!تمسّكي جيّدًا -

333
00:19:39,990 --> 00:19:41,180
!نحن عائِدان إلى قصر القمر -
!أسرِع -

334
00:19:41,190 --> 00:19:42,990
!نحن عائِدان إلى قصر القمر

335
00:19:48,030 --> 00:19:49,830
!نحن عائِدان إلى قصر القمر

336
00:20:04,050 --> 00:20:05,460
.أيّها الأخ الأكبر، عُدت

337
00:20:06,080 --> 00:20:06,850
.كُن حذرًا

338
00:20:07,440 --> 00:20:09,780
،أيّها الأخ الأكبر
إلى أين ذهبتَ؟

339
00:20:09,790 --> 00:20:10,990
كان المُعلّم يبحثُ عنكَ
.مُنذ بُرهةٍ

340
00:20:11,000 --> 00:20:12,300
.عُدت الآن

341
00:20:13,900 --> 00:20:15,830
.اليوم هُو مهرجان مُنتصف الخريف

342
00:20:15,910 --> 00:20:17,710
قدّموا المزيد مِن الطّعام
...وكعك القمر

343
00:20:17,840 --> 00:20:18,970
.إلى مقرّ التّبرعات

344
00:20:19,300 --> 00:20:20,060
،وأيضًا

345
00:20:20,320 --> 00:20:22,580
أيّ شخصٍ يزورُ عالم
،يَاو غُوانغ اليوم

346
00:20:22,640 --> 00:20:23,850
،وبغضّ النّظر عن مكانته

347
00:20:23,860 --> 00:20:25,600
يجب استقبالهُ بما يليق
.مِن الطّعام والمَبيت

348
00:20:25,610 --> 00:20:26,270
.حاضرٌ -
.حاضرٌ -

349
00:20:30,570 --> 00:20:32,330
.مُعلّمي، عُدت

350
00:20:32,640 --> 00:20:33,790
.أيّها الشّقي

351
00:20:33,820 --> 00:20:35,670
إلى أين ذهبت لتتكاسل مُجدّدًا؟

352
00:20:35,680 --> 00:20:37,190
...أَلا تعلمُ أنّ هُناك أشياءَ كثيرةً

353
00:20:37,200 --> 00:20:38,600
يجب الاهتمامُ بها اليوم؟

354
00:20:39,480 --> 00:20:40,880
ما هذا الّذي في يدكَ؟

355
00:20:41,070 --> 00:20:41,760
،أيّها الأخ الأكبر

356
00:20:42,820 --> 00:20:45,820
أيّها الأخ الأكبر، أين نبيذُ العُصفر
الّذي طلبت منكَ شراءه؟

357
00:20:47,050 --> 00:20:49,580
ما كُنت لأتجاهلَ طلبكِ
.الّذي عهدتِ به إليّ

358
00:20:50,250 --> 00:20:52,600
،يُون زُو
.صحّتكِ ليست على ما يُرام

359
00:20:52,610 --> 00:20:53,990
.لا تُكثري مِن الشّرب

360
00:20:54,070 --> 00:20:54,750
،أبي

361
00:20:55,150 --> 00:20:57,480
كُنت أتوقُ لهذا
.النّبيذ مُنذ عامٍ

362
00:20:57,490 --> 00:20:58,940
،إنّه مهرجان مُنتصف الخريف

363
00:20:58,950 --> 00:21:00,410
.دعنِي أرتشفُ بضع رشفاتٍ فحسب

364
00:21:03,160 --> 00:21:04,340
...أنتِ

365
00:21:15,910 --> 00:21:22,490
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

366
00:21:22,980 --> 00:21:31,550
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

367
00:21:33,550 --> 00:21:37,390
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

368
00:21:38,260 --> 00:21:41,100
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

369
00:21:42,910 --> 00:21:46,770
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

370
00:21:46,800 --> 00:21:50,430
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

371
00:21:51,210 --> 00:21:55,260
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

372
00:21:55,880 --> 00:22:00,070
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

373
00:22:00,610 --> 00:22:05,790
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

374
00:22:05,820 --> 00:22:09,210
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

375
00:22:09,940 --> 00:22:14,910
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

376
00:22:14,940 --> 00:22:19,410
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

377
00:22:19,430 --> 00:22:24,400
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

378
00:22:24,430 --> 00:22:28,890
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

379
00:22:34,050 --> 00:22:39,260
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟