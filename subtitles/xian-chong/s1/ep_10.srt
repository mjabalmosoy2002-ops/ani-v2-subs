1
00:00:15,180 --> 00:00:22,220
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

2
00:00:22,230 --> 00:00:29,800
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

3
00:00:29,810 --> 00:00:36,320
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

4
00:00:36,330 --> 00:00:41,950
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

5
00:00:43,290 --> 00:00:50,340
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

6
00:00:50,350 --> 00:00:58,060
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

7
00:00:58,070 --> 00:01:04,900
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

8
00:01:04,910 --> 00:01:11,310
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

9
00:01:11,320 --> 00:01:18,660
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

10
00:01:18,670 --> 00:01:25,380
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

11
00:01:25,390 --> 00:01:31,540
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

12
00:01:31,550 --> 00:01:38,810
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

13
00:01:54,680 --> 00:01:55,920
.أيّها الأخ الأكبر

14
00:01:55,930 --> 00:01:57,130
.زهرةُ لوتسٍ بشريّة أُخرى

15
00:02:01,510 --> 00:02:03,240
.أخشى أنّ حدسنا كان صائبًا

16
00:02:03,650 --> 00:02:06,450
هذه هِي الطّريقة الّتي حصلت بها دار
.شِينغ هَان على بُذور اللّوتس الحمراء

17
00:02:07,170 --> 00:02:08,020
...لكن

18
00:02:08,620 --> 00:02:11,010
لماذا أُلقيت الجُثّة هُنا
بهذا الإهمال؟

19
00:02:11,020 --> 00:02:13,210
...أَيُعقل أن يرتكبُوا مثل

20
00:02:13,240 --> 00:02:15,570
هذا الجُرم القاسي بحقّ
!أطفالٍ صغار

21
00:02:16,000 --> 00:02:18,210
!سأُدمّر هذه الدّار

22
00:02:19,840 --> 00:02:20,710
.اهدئِي

23
00:02:21,550 --> 00:02:23,880
.إنّ قلقِي يزدادُ على تلك الفتاة

24
00:02:24,180 --> 00:02:26,410
هِي في مثل عُمر
.الضّحايا الصّغار

25
00:02:26,810 --> 00:02:29,070
مِن الأفضل أن نجدها
.في أسرع وقتٍ مُمكن

26
00:02:39,480 --> 00:02:40,460
...هُناك

27
00:02:41,680 --> 00:02:43,070
.أظنّ أنّ أحدًا هُناك

28
00:02:53,950 --> 00:02:54,750
.أيّها السيّد الشّاب

29
00:03:00,550 --> 00:03:00,820
...أنا

30
00:03:00,840 --> 00:03:01,640
،أيّها السيّد الشّاب

31
00:03:01,850 --> 00:03:02,780
هل أنت بخيرٍ؟

32
00:03:03,920 --> 00:03:05,110
،بصفتكَ السيّد الشّاب

33
00:03:05,630 --> 00:03:06,890
لماذا نمتَ في هذا الموضع؟

34
00:03:07,470 --> 00:03:08,860
أنا... أنا نمتُ؟

35
00:03:09,900 --> 00:03:11,160
مَن قال إنّني نمتُ؟

36
00:03:15,790 --> 00:03:18,250
أنا... كُنت مُتعبًا قليلًا
.فاسترحتُ لبُرهةٍ

37
00:03:22,090 --> 00:03:23,820
هل تبحثُ عن شيءٍ ما؟

38
00:03:24,440 --> 00:03:25,300
.كلا... لا شيء

39
00:03:28,340 --> 00:03:29,870
.أعتذرُ منكُما

40
00:03:31,410 --> 00:03:33,370
...أرى أن
.تخلُدا إلى النّوم باكرًا

41
00:03:39,010 --> 00:03:39,850
،أيّها الأخ الأكبر

42
00:03:40,470 --> 00:03:41,600
هل ما رأيتهُ للتّو كان حقيقيًا؟

43
00:03:42,150 --> 00:03:43,290
...هَان بَاو يُوان

44
00:03:44,840 --> 00:03:46,370
،أصبحَ أصغر سنًا
أَليس كذلك؟

45
00:03:47,470 --> 00:03:49,270
.لنَتبعهُ ونُلقِ نظرةً

46
00:04:03,210 --> 00:04:04,030
!هَان بَاو رُونغ

47
00:04:04,340 --> 00:04:04,900
!أخبرينِي

48
00:04:07,730 --> 00:04:09,240
هل أنتِ مَن فعلَ ذلك؟

49
00:04:11,320 --> 00:04:12,380
ما الّذي فعلتهُ؟

50
00:04:19,870 --> 00:04:22,260
...هل دسستِ الدّواء في طعامي

51
00:04:22,280 --> 00:04:23,680
...وجعلتِني أنام

52
00:04:23,700 --> 00:04:25,960
حتّى أعودَ إلى سنّ
الثّانية عشرة بشكلٍ أسرع؟

53
00:04:27,490 --> 00:04:30,010
،إن كُنتَ تشكّ بي
فلماذا أكلتَ حتّى التّخمة؟

54
00:04:35,540 --> 00:04:37,690
هل سمحتِ لـ وَان زِي
ويُواليان بالرّحيل؟

55
00:04:38,290 --> 00:04:39,140
.أجل

56
00:04:40,090 --> 00:04:41,620
كيف لكِ أن تكونِي
بمثل هذه الحماقة؟

57
00:04:41,790 --> 00:04:43,850
كادا يعودَان إلى سنّ
.الثّانية عشرة

58
00:04:45,050 --> 00:04:46,310
مِن بين الأرواح الأربع
،والعِشرين المطلوبة

59
00:04:46,320 --> 00:04:48,110
.لم يتبقَ سوى ثلاثةٍ فحسب

60
00:04:48,430 --> 00:04:50,710
أوشكَ كلاهما أن يتحوّلا إلى
!لوتسٍ بشريّ لإتمام الشّعائر

61
00:04:50,720 --> 00:04:51,920
ما العمل الآن؟

62
00:04:59,710 --> 00:05:01,180
...ساقَ الرّب

63
00:05:01,200 --> 00:05:03,410
.إليكَ دخِيلين آخرين

64
00:05:04,890 --> 00:05:06,000
.يسهلُ عليكِ قول ذلك

65
00:05:06,480 --> 00:05:09,080
ذلك الرّجل لا يبدو ممّن نقدرُ
.على التّعامل معه بسُهولةٍ

66
00:05:09,090 --> 00:05:10,630
سمحتِ لـ وَان زِي
.ويُواليان بالرّحيل

67
00:05:10,860 --> 00:05:13,590
.سأُخبر والدي بهذا

68
00:05:15,270 --> 00:05:17,510
أخي، أنت تثقُ به
.أكثر مِن اللّازم

69
00:05:18,000 --> 00:05:19,660
أنت تشكّ في أنّني
.دسستُ لك الدّواء

70
00:05:19,900 --> 00:05:21,360
لماذا لا تشكّ فيه؟

71
00:05:21,420 --> 00:05:25,300
عليكَ أن تعِي أنّه الأقرب
.إلى سنّ الثّانية عشرة حاليًا

72
00:05:25,800 --> 00:05:28,100
.محالٌ! أنا ابنه

73
00:05:29,090 --> 00:05:30,640
...وابنك العزيز

74
00:05:30,660 --> 00:05:32,340
.كان حفيدهُ

75
00:05:33,450 --> 00:05:34,380
ما الّذي ترمينَ إليه؟

76
00:05:44,400 --> 00:05:45,400
...هل تزعمينَ

77
00:05:45,610 --> 00:05:48,390
أنّ شِيانغ لم يلقَ حتفه
،على يد الرّوح الشّريرة

78
00:05:48,960 --> 00:05:50,300
!بل قتلهُ أبي؟

79
00:05:50,980 --> 00:05:54,050
كلا، محالٌ! أبي لن
!يُقدم على فعلةٍ كهذه قطّ

80
00:05:55,170 --> 00:05:56,530
،سواءٌ صدّقت أم لم تُصدّق

81
00:05:57,210 --> 00:05:59,140
.لا نزالُ بحاجةٍ إلى ثلاثة أرواحٍ

82
00:05:59,630 --> 00:06:02,120
،حتّى مع التّضحية بحياة الضّيفين

83
00:06:02,290 --> 00:06:03,630
.سنظلّ بحاجةٍ إلى رُوحٍ إضافيّة

84
00:06:04,770 --> 00:06:06,330
هذا يعني أنّه مِن بين
،والدي، وبينكَ، وبيني

85
00:06:07,060 --> 00:06:08,740
.يجب أن يُضحّى بأحدنا

86
00:06:10,880 --> 00:06:12,080
...هل تظنّ أنّ

87
00:06:12,810 --> 00:06:15,630
والدي سيُضحّي بنفسه؟

88
00:06:17,920 --> 00:06:20,850
،أجل
!كُلّ ما حدثَ كان بسببه

89
00:06:21,700 --> 00:06:23,810
حذّرته مِن زراعة
!بُذور اللّوتس الحمراء

90
00:06:24,320 --> 00:06:25,090
.صدقتَ

91
00:06:25,560 --> 00:06:26,960
.الخطأُ يقع على عاتقِ أبي

92
00:06:27,360 --> 00:06:29,690
وإلّا، لما حلّت علينا
.هذه اللّعنة

93
00:06:31,090 --> 00:06:32,780
،وبما أنّ هذا خطؤه

94
00:06:33,450 --> 00:06:35,340
...ألا يُجدر به أن

95
00:06:36,620 --> 00:06:38,220
يدفعَ حياته ثمنًا؟

96
00:06:39,220 --> 00:06:40,450
،أنتِ محقّةٌ

97
00:06:41,430 --> 00:06:43,590
.هُو مَن يستحقّ اللّعنة

98
00:06:44,730 --> 00:06:46,010
...وهُو الجدير

99
00:06:46,400 --> 00:06:47,800
!بالموت دُون غيره

100
00:06:54,670 --> 00:06:57,200
كم مِن الأسرار تُخفيها
هذه الدّار بعد؟

101
00:06:57,880 --> 00:07:00,810
إنّهما يبغيان التّضحية
!برُوحَينا لسدّ العجز

102
00:07:01,290 --> 00:07:02,620
أيّ جُرأةٍ تلك الّتي يمتلكانِها؟

103
00:07:02,950 --> 00:07:05,750
حتّى مع رُوحَينا، لا يزالان
.يفتقِران إلى رُوحٍ ثالثة

104
00:07:06,770 --> 00:07:07,420
!تمهّل

105
00:07:07,610 --> 00:07:09,070
،عدا هؤلاء الثّلاثة

106
00:07:09,080 --> 00:07:10,390
...فقد أبصرنا شخصين آخرين

107
00:07:10,410 --> 00:07:11,850
.في هذه الدّار

108
00:07:14,670 --> 00:07:15,660
.تلكَ الفتاة

109
00:07:16,070 --> 00:07:18,740
.وابنُ هَان بَاو يُوان

110
00:07:22,740 --> 00:07:23,920
...قالا للتّو إنّ

111
00:07:23,940 --> 00:07:25,720
.ابن هَان بَاو يُوان قد ماتَ

112
00:07:26,350 --> 00:07:27,700
...عليك أن تعِي

113
00:07:27,720 --> 00:07:30,140
أنّه الأقرب إلى سنّ
.الثّانية عشرة حاليًا

114
00:07:31,090 --> 00:07:32,180
...ذلك الفتى

115
00:07:33,070 --> 00:07:34,050
هُو هَان شيَان؟

116
00:07:34,930 --> 00:07:35,710
.أبي

117
00:07:38,070 --> 00:07:41,090
هل أنت مَن قتل شيَانغ؟

118
00:07:43,530 --> 00:07:44,880
.اتبع أنت هَان بَاو يُوان

119
00:07:45,200 --> 00:07:48,600
سأرى إن كُنت سأتمكّن مِن استخلاص
.مزيدٍ مِن المعلومات مِن هَان بَاو رُونغ

120
00:07:49,300 --> 00:07:51,230
،اطمئنّ

121
00:07:51,590 --> 00:07:52,850
...كُلّ تلك السّنين مِن التّدريب

122
00:07:52,860 --> 00:07:53,990
،لم تكُن هباءً

123
00:07:54,200 --> 00:07:55,890
وبإمكاني التّعامل مع
!بضعة بشرٍ عاديّين

124
00:08:00,380 --> 00:08:01,330
.توخّي الحذر

125
00:08:01,920 --> 00:08:02,830
،إن وقعَ أيّ طارئٍ

126
00:08:02,840 --> 00:08:04,090
،فلا تتهوّري

127
00:08:04,920 --> 00:08:06,180
.وتريّثي حتّى عودتي

128
00:08:19,210 --> 00:08:22,010
لماذا لا تزالينَ مُستيقظةً
في مثل هذه السّاعة؟

129
00:08:24,070 --> 00:08:26,270
.سمعتُ حديثكما

130
00:08:26,930 --> 00:08:28,860
خيرٌ لكِ أن تبوحِي لي
.بما لديكِ

131
00:08:29,020 --> 00:08:31,290
فلَعلّي أستطيعُ إنقاذكِ
.مِن هذا المكان

132
00:08:33,170 --> 00:08:36,090
،في هذه المرحلة
،لا جدوى مِن الكتمان

133
00:08:37,210 --> 00:08:38,350
.كُلّ ما حدثَ كان محتومًا

134
00:08:40,020 --> 00:08:41,620
،إذا كُنتِ تُريدين معرفةَ الحقيقة

135
00:08:49,320 --> 00:08:50,460
.فاتبعينِي

136
00:08:56,790 --> 00:09:00,420
هل أخبرتكَ بَاو رُونغ
أنّني قتلتُ شيَانغ؟

137
00:09:01,190 --> 00:09:02,320
وهل فعلتَها؟

138
00:09:03,360 --> 00:09:05,130
...ألا تُدرك أنّ

139
00:09:05,470 --> 00:09:08,450
بَاو رُونغ تسعى إلى
تفريق شملِنا؟

140
00:09:10,040 --> 00:09:12,040
حتّى وإن برِئت يداكَ
،مِن دم شيَانغ

141
00:09:12,680 --> 00:09:15,220
فإنّ تمسّكك بزراعة بُذور
،اللّوتس الحمراء

142
00:09:15,230 --> 00:09:17,360
هُو ما جلبَ هذه اللّعنة
!على عائلتنا

143
00:09:17,820 --> 00:09:20,080
وهُو ما تسبّب في موت
!شيَانغ مِيتةً تُدمي القُلوب

144
00:09:20,490 --> 00:09:21,420
...أَتجرؤ على القول

145
00:09:21,500 --> 00:09:23,040
إنّ هذا ليس نتيجة أفعالكَ؟

146
00:09:23,050 --> 00:09:23,840
!اخرس

147
00:09:26,090 --> 00:09:28,260
...يُريد الجميع

148
00:09:28,290 --> 00:09:30,250
!أن يُلقوا باللّوم عليّ

149
00:09:31,320 --> 00:09:33,450
لولا أنّني جِئتُ ببُذور
،اللّوتس الحمراء

150
00:09:33,870 --> 00:09:37,800
لما نعِمت عائلة هَان
!بهذه الثّروة الطّائلة

151
00:09:38,390 --> 00:09:42,170
أم أنّك تُفضّل العودة إلى
طريقة عيشنا السّابقة؟

152
00:09:44,400 --> 00:09:47,530
كانت عائلة هَان تكسبُ
.قُوتها مِن جمع الأعشاب

153
00:09:47,810 --> 00:09:50,060
،كانت الحياة شاقّةً
.دُون شكّ

154
00:09:50,720 --> 00:09:54,050
لكن عائلتنا كانت تغمرها
.السّعادة والوئام

155
00:09:55,490 --> 00:09:57,970
.إلّا أنّ صفو الأيّام لا يدوم

156
00:09:58,350 --> 00:10:02,280
،ففِي إحدى السّنوات، هطلت أمطارٌ غزيرة
.وكان محصولُ الأعشاب شحيحًا للغاية

157
00:10:02,780 --> 00:10:04,840
،كُنّا نُكافح بالفِعل لنعيشَ

158
00:10:05,630 --> 00:10:07,490
،ثُمّ اشتدّ المرض على أُمّي

159
00:10:08,080 --> 00:10:10,160
.ولم تلبث أن فارقت الحياة

160
00:10:11,530 --> 00:10:13,730
.كان والدي مُكتئبًا لفترةٍ طويلة

161
00:10:14,660 --> 00:10:15,970
،وفي السّنة نفسها

162
00:10:16,490 --> 00:10:18,890
ضلّت ابنتي جِي طريقها
.في الجبال

163
00:10:19,770 --> 00:10:20,770
،وعندما وجدناها

164
00:10:21,480 --> 00:10:23,340
لم يكُن قد تبقّى منها
.سوى رداءٍ مُلطّخ بالدّماء

165
00:10:24,280 --> 00:10:27,140
وبينما كُنّا نعتقدُ أنّ عائلتنا
،بلغت أقصى درجات البُؤس

166
00:10:27,790 --> 00:10:29,420
...حتّى جاء أبي

167
00:10:30,640 --> 00:10:32,300
...بعد أيّامٍ معدودة

168
00:10:33,050 --> 00:10:34,730
.بزهرة لُوتسٍ حمراء بحُمرة الدّم

169
00:10:34,740 --> 00:10:37,320
.التقيتُ بكائنٍ مِن الخالدين الأجلّاء

170
00:10:37,720 --> 00:10:39,800
.وقد منحني هذه اللّوتس الحمراء

171
00:10:40,030 --> 00:10:42,290
يُمكن لبُذورها أن تُعيد
.الموتى إلى الحياة

172
00:10:42,340 --> 00:10:45,400
،ومع الاستخدام المُطوّل
.يُمكنها أن تمنحَ الشّباب الأبديّ

173
00:10:47,680 --> 00:10:48,880
،انشرُوا الخبر

174
00:10:48,910 --> 00:10:50,810
كُلّ بذرةٍ تُباع بألف تلٍ مِن
.الذّهب، ولا مجالَ للمُساومة

175
00:10:50,820 --> 00:10:52,150
ألف تلٍ مِن الذّهب؟

176
00:10:53,010 --> 00:10:54,070
.هذا صحيحٌ

177
00:10:54,240 --> 00:10:56,450
...أوشكت أيّام عائلة هَان

178
00:10:56,780 --> 00:10:58,820
.السّعيدة أن تبدأ

179
00:10:58,830 --> 00:10:59,650
،وما كان مُتوقّعًا حدث

180
00:11:00,180 --> 00:11:01,850
فمُنذ أن أنقذت بذرةُ
،اللّوتس الحمراء الأولى

181
00:11:01,870 --> 00:11:03,670
حياةَ رجلٍ طاعن في
،السّن مِن الأثرياء

182
00:11:04,180 --> 00:11:05,580
...تهافتَ النّبلاء وذُوو المناصب العُليا

183
00:11:05,590 --> 00:11:07,750
.على أعتابنا

184
00:11:09,170 --> 00:11:12,340
.ثُمّ بنينا دار شِينغ هَان

185
00:11:14,010 --> 00:11:17,250
قال والدي إنّ اللّوتس الحمراء
.مقدّسةٌ، ولا يجوزُ تدنيسها أبدًا

186
00:11:17,260 --> 00:11:20,120
كما أنّ المكان الّذي تُزرع فيه
.يجب أن يُشيّد بطريقةٍ خاصّة

187
00:11:25,630 --> 00:11:26,870
.معبد جُوهان

188
00:11:28,780 --> 00:11:31,780
إنّه المكان الّذي تقومُ فيه عائلة
.هَان بزراعة بُذور اللّوتس الحمراء

189
00:11:33,930 --> 00:11:35,040
،آنسة شُو

190
00:11:35,650 --> 00:11:38,590
إنّ الأجوبة الّتي تبحثينَ
.عنها تقبعُ كُلّها في الدّاخل

191
00:11:50,290 --> 00:11:54,150
هل شاركَ جميع أفراد عائلة هَان
في زراعة بُذور اللّوتس الحمراء؟

192
00:11:54,260 --> 00:11:55,550
،طيلة السّنوات الأولى

193
00:11:55,570 --> 00:11:58,060
لم يكُن يُسمح لأحدٍ بدُخول
.معبد جُوهان سوى أبي

194
00:11:58,950 --> 00:12:01,660
لكن لاحقًا، حينما
،احتجّ بَاو يُوان بقُوّةٍ

195
00:12:02,090 --> 00:12:04,690
استجابَ له أبي
.وأفضى إليه بالطّريقة

196
00:12:06,470 --> 00:12:07,950
...ما زلتُ أذكر

197
00:12:08,190 --> 00:12:10,520
ملامح بَاو يُوان المليئة
...بالتلهّف والاعتزاز

198
00:12:11,350 --> 00:12:13,750
.وهُو يعبرُ تلك البوّابة

199
00:12:21,590 --> 00:12:24,460
!آنسة بَاو رُونغ

200
00:12:33,210 --> 00:12:34,390
ماذا حدث؟

201
00:12:35,230 --> 00:12:36,390
...متى قُمت بـ

202
00:12:40,270 --> 00:12:41,430
.هيّا يا بُني

203
00:12:42,080 --> 00:12:43,350
.سأُعلّمك كيفيّة القيام بذلك

204
00:12:43,900 --> 00:12:45,100
.أنصِت إليّ جيّدًا

205
00:12:46,090 --> 00:12:47,340
هل يتملّككَ الرّعب؟

206
00:12:47,990 --> 00:12:50,920
أصررتَ على تعلّم
.كيفيّة زراعة اللّوتس

207
00:12:51,730 --> 00:12:53,670
.والآن تحقّقت أُمنيتك

208
00:12:53,700 --> 00:12:55,130
لماذا أنت خائفٌ؟

209
00:12:55,850 --> 00:12:58,050
إنّ... إنّ زراعة بُذور
...اللّوتس الحمراء

210
00:12:58,220 --> 00:12:59,920
.تتطلّب أرواحًا بشريّة

211
00:13:00,610 --> 00:13:04,140
طالما أنّنا نضع بُذور اللّوتس
،الحمراء في أُذنيها

212
00:13:04,150 --> 00:13:05,550
،ثُمّ ندفعها إلى أعماق الماء

213
00:13:06,310 --> 00:13:08,620
وما إن تتأصّل تلك
،البُذور وتنبت

214
00:13:08,930 --> 00:13:12,460
حتّى تنبثقَ زُهور اللّوتس
.الحمراء مِن محاجر عينيها

215
00:13:13,170 --> 00:13:15,000
!لكن... هذه جريمةُ قتلٍ

216
00:13:15,740 --> 00:13:17,180
أَلن تقوى على فِعل ذلك؟

217
00:13:17,850 --> 00:13:20,950
هل تُريد العودة لتحيا
كرجلٍ عاجزٍ نكرة؟

218
00:13:21,640 --> 00:13:23,040
.تأمّل حالَ أُمّك

219
00:13:23,790 --> 00:13:26,050
قضت عُمرها كُلّه في
،جمعِ الأعشاب

220
00:13:26,060 --> 00:13:27,350
،وفي النّهاية

221
00:13:27,450 --> 00:13:30,050
لم تتمكّن حتّى مِن
.تحمّل نفقات دوائها

222
00:13:31,090 --> 00:13:32,250
،لذلك

223
00:13:32,260 --> 00:13:34,370
،في تلك اللّحظة
.اتّخذتُ قراري

224
00:13:35,150 --> 00:13:38,020
لن أعيشَ مثل هذه
.الحياة قطعًا

225
00:13:39,580 --> 00:13:40,780
.لن أفعلَ أبدًا

226
00:13:42,640 --> 00:13:45,820
،بَاو يُوان
.إنّ أباكَ لن يُؤذيكَ إطلاقًا

227
00:13:46,550 --> 00:13:49,490
هذه المسألة أيسرُ
.ممّا تظنّ بكثيرٍ

228
00:13:51,240 --> 00:13:53,010
.ما عليكَ إلّا أن تفعلَ هذا

229
00:14:07,960 --> 00:14:10,800
...هذا... هذا هُو المكان الّذي

230
00:14:16,360 --> 00:14:17,630
رأيتِ ذلك، أَليس كذلك؟

231
00:14:23,780 --> 00:14:25,350
...هل ما شهدتهُ للتّو

232
00:14:25,630 --> 00:14:28,060
كان ذكريات الضّحية الّتي
تحوّلت إلى لوتسٍ بشريّ؟

233
00:14:28,070 --> 00:14:28,770
.أجل

234
00:14:29,770 --> 00:14:31,030
أَليس هذا مُثيرًا للسُخريّة؟

235
00:14:31,840 --> 00:14:34,210
بُذور اللّوتس الحمراء الّتي يتهافتُ
،عليها النّاس في هذا العالم

236
00:14:34,840 --> 00:14:37,830
لم تكُن لتنبتَ إلّا
.بتلك الطّريقة الشّنيعة

237
00:14:42,510 --> 00:14:44,270
أنت... أنت مَن
!أرغمنِي على هذا

238
00:14:44,580 --> 00:14:46,040
!لم أكُن أُريد إيذاءهم

239
00:14:46,190 --> 00:14:48,080
،تبتغِي الغِنى

240
00:14:48,320 --> 00:14:50,450
.لكنّك لا تُريد تلويثَ يديك

241
00:14:51,090 --> 00:14:52,440
،يا بُنيّ

242
00:14:52,810 --> 00:14:56,420
في هذه الدّنيا لا شيءَ
.يسيرُ وفق هواك

243
00:14:56,770 --> 00:14:57,570
،أبي

244
00:14:59,270 --> 00:15:00,190
...بدأَ هذا

245
00:15:01,330 --> 00:15:03,070
.البلاء بسببكَ

246
00:15:05,420 --> 00:15:06,660
،إذا مُتَّ

247
00:15:08,110 --> 00:15:09,280
...فرُبّما

248
00:15:09,770 --> 00:15:11,170
.تبطلُ اللّعنة

249
00:15:14,610 --> 00:15:17,340
!تبًا
!كيف أنجبتُ أحمقَ مثلك؟

250
00:15:17,950 --> 00:15:19,710
ألا تجدُ الأمر غريبًا؟

251
00:15:20,070 --> 00:15:21,620
لعنةُ الرّوح الشّريرة
...الّتي تُزهق النّفوس

252
00:15:21,630 --> 00:15:23,830
،تستهدفُ جميع أفراد عائلة هَان

253
00:15:23,920 --> 00:15:26,780
ولكن لماذا بَاو رُونغ وحدها
!بقيت في سنّ الثّلاثين؟

254
00:15:27,250 --> 00:15:29,310
هل يُعقل أنّها لا تنام؟

255
00:15:29,370 --> 00:15:33,590
إلّا إذا كانت مُتحالفةً
!مع تلك الرّوح الشّريرة

256
00:15:34,780 --> 00:15:35,650
!محالٌ

257
00:15:37,790 --> 00:15:39,070
...لماذا تُبدّد الثّراء والجاه

258
00:15:39,080 --> 00:15:42,540
اللّذين شقيت عائلة هَان لنيلهِما؟

259
00:15:48,400 --> 00:15:50,050
ثراءٌ وجاه؟

260
00:15:52,960 --> 00:15:56,750
بالفِعل، نالت عائلة هَان
،الثّراء والجاه

261
00:15:57,690 --> 00:15:59,560
.وعِشنا في نعيمٍ

262
00:16:00,590 --> 00:16:01,870
،ولكن لو استطعتُ

263
00:16:02,590 --> 00:16:04,230
...لاستبدلتُ هذا كُلّه

264
00:16:04,490 --> 00:16:06,830
لأسمعَ جِي وهِي تُناديني
.أُمّي مرّةً أُخرى

265
00:16:09,050 --> 00:16:12,900
طوال هذه الأعوام، كُلّما حانَ موعد
،زراعة البُذور في معبد جُوهان

266
00:16:13,770 --> 00:16:15,430
كُنت دائمًا أرى جِي
.في منامي

267
00:16:16,650 --> 00:16:18,200
بل إنّي كُنت أسمعُ
...صوتَ بُكائها

268
00:16:18,480 --> 00:16:20,210
.يصدح في جوف اللّيل

269
00:16:26,160 --> 00:16:27,010
،بَاو رُونغ

270
00:16:27,250 --> 00:16:28,050
ما الخطب؟

271
00:16:28,390 --> 00:16:31,010
،استمع
.إنّه صوتُ بُكاء جِي

272
00:16:33,500 --> 00:16:34,730
.ليس هُناك صوتُ بُكاءٍ

273
00:16:35,680 --> 00:16:36,810
.كان مُجرّد حُلمٍ

274
00:16:37,400 --> 00:16:38,410
.اخلُدي إلى النّوم

275
00:16:41,230 --> 00:16:42,750
.اخلُد إلى النّوم أنت أولًا

276
00:16:42,980 --> 00:16:44,970
.سأخرجُ لتنشّق نسيم الهواء النقيّ

277
00:17:03,650 --> 00:17:06,680
.جِي، جِي

278
00:17:07,330 --> 00:17:08,340
.أنا هُنا

279
00:17:09,550 --> 00:17:10,650
هل هذه أنتِ؟

280
00:17:13,470 --> 00:17:14,660
بَاو... بَاو رُونغ؟

281
00:17:14,900 --> 00:17:17,180
ما الّذي تفعلينه هُنا في
مثل هذه السّاعة؟

282
00:17:18,260 --> 00:17:20,850
.أخي، سمعتُ صوتَ جِي

283
00:17:21,670 --> 00:17:23,800
هل عادت جِي؟

284
00:17:25,650 --> 00:17:27,200
.بدأتِ تفقدينَ صوابكِ مُجدّدًا

285
00:17:27,340 --> 00:17:30,100
،جِي ماتت مُنذ زمنٍ طويل
كيف لها أن تعودَ؟

286
00:17:32,080 --> 00:17:34,380
.كلا، سمعتُ صوتها صدقًا

287
00:17:34,510 --> 00:17:36,180
.كانت جِي تبكي

288
00:17:36,270 --> 00:17:37,340
.كانت تلومُني

289
00:17:38,200 --> 00:17:40,140
.لأنّني لم أتمكّن مِن العُثور عليها

290
00:17:41,270 --> 00:17:42,800
!جِي

291
00:17:48,530 --> 00:17:49,990
.أنتِ تشتاقينَ إليها كثيرًا فحسب

292
00:17:50,280 --> 00:17:52,560
غدًا، سأرسلُ معكِ مَن يصحبكِ
...إلى ضريح شيَان تُونغ القريب

293
00:17:52,570 --> 00:17:53,770
.لإشعال البخور

294
00:17:54,080 --> 00:17:55,980
،ذلك الضّريح مباركٌ للغاية

295
00:17:58,910 --> 00:18:00,060
...وستُنجبينَ أنتِ وتشَاو تشِي

296
00:18:00,580 --> 00:18:02,240
.مولودًا آخر في القريب العاجل

297
00:18:06,480 --> 00:18:07,810
جِي؟

298
00:18:08,290 --> 00:18:10,090
ما علاقة هذا بـ جِي؟

299
00:18:10,920 --> 00:18:13,830
هل تتذكّر متى ماتت جِي؟

300
00:18:14,580 --> 00:18:15,460
.بالطّبع

301
00:18:16,170 --> 00:18:17,310
،قبل أربعةٍ وعشرينَ عامًا

302
00:18:17,630 --> 00:18:20,560
تسلّلت إلى الجبال للّعب
.في يوم ميلادها

303
00:18:20,850 --> 00:18:23,780
،وافترسها وحشٌ بريّ
.لم نجِد جُثّتها

304
00:18:24,070 --> 00:18:25,600
ولم نعثر سوى على
.رداءٍ مُلطّخ بالدّماء

305
00:18:26,610 --> 00:18:27,810
،ثُمّ بعد بضعة أيّامٍ

306
00:18:28,050 --> 00:18:30,600
،التقيتَ أنت بخالدٍ
.وأحضرتَ اللّوتس الحمراء

307
00:18:31,570 --> 00:18:32,640
،حينها

308
00:18:33,030 --> 00:18:36,520
قُلنا إنّ ذلك حدثَ لأنّ
...جِي تجلّت في رُوحٍ مُقدّسة

309
00:18:36,530 --> 00:18:38,200
.لتُباركنا

310
00:18:41,270 --> 00:18:42,070
...أَيُعقل

311
00:18:43,060 --> 00:18:43,860
...أَيُعقل أنّ

312
00:18:47,870 --> 00:18:49,290
...موت جِي

313
00:18:49,310 --> 00:18:49,940
...كان

314
00:18:54,150 --> 00:18:56,040
...لا بُدّ أنّ تضرّعي الصّادق

315
00:18:56,400 --> 00:18:58,020
.قد بلغَ عنان السّماء

316
00:18:58,450 --> 00:19:00,130
،نِلتُ مُرادي حقًا

317
00:19:04,600 --> 00:19:05,700
.أنتِ معي الآن

318
00:19:24,370 --> 00:19:25,060
.هيّا

319
00:19:25,990 --> 00:19:27,630
.ألقِي التّحية على الآنسة شُو

320
00:19:31,540 --> 00:19:32,930
.مرحبًا، آنسة شُو

321
00:19:34,320 --> 00:19:35,490
...أنا

322
00:19:35,610 --> 00:19:36,810
.جِي

323
00:19:44,410 --> 00:19:51,460
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

324
00:19:51,470 --> 00:19:59,980
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

325
00:20:02,040 --> 00:20:06,750
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

326
00:20:06,760 --> 00:20:11,390
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

327
00:20:11,400 --> 00:20:15,250
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

328
00:20:15,260 --> 00:20:19,720
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

329
00:20:19,730 --> 00:20:24,420
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

330
00:20:24,430 --> 00:20:29,120
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

331
00:20:29,130 --> 00:20:34,300
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

332
00:20:34,310 --> 00:20:38,320
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

333
00:20:38,330 --> 00:20:43,460
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

334
00:20:43,470 --> 00:20:47,930
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

335
00:20:47,940 --> 00:20:52,900
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

336
00:20:52,910 --> 00:20:57,360
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

337
00:21:02,480 --> 00:21:08,610
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟