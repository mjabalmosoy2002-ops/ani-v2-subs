1
00:01:00,140 --> 00:01:05,540
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

2
00:01:07,170 --> 00:01:12,830
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

3
00:01:14,780 --> 00:01:20,980
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

4
00:01:21,160 --> 00:01:26,530
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

5
00:01:28,190 --> 00:01:35,280
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

6
00:01:35,430 --> 00:01:43,160
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

7
00:01:43,170 --> 00:01:49,920
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

8
00:01:49,930 --> 00:01:55,320
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

9
00:01:56,390 --> 00:02:03,700
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

10
00:02:03,710 --> 00:02:10,420
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

11
00:02:10,430 --> 00:02:16,680
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

12
00:02:16,700 --> 00:02:23,570
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

13
00:02:42,320 --> 00:02:43,960
لِي... لِي شِياو؟

14
00:02:44,810 --> 00:02:45,600
جُوان جُوان؟

15
00:02:46,870 --> 00:02:48,660
لماذا... لماذا أنت هُنا؟

16
00:02:48,680 --> 00:02:49,540
،أيّها الصيدلانيّ لِي

17
00:02:50,010 --> 00:02:52,350
.أنا أعتذرُ لأنّني لطّخت ثيابكَ

18
00:02:52,380 --> 00:02:53,790
،غسلتُها
.وأصبحت نظيفةً الآن

19
00:02:53,800 --> 00:02:54,860
.سأضعُها هُنا

20
00:02:55,040 --> 00:02:57,890
بالمُناسبة، هل ملابسي تُناسبكَ؟

21
00:02:59,220 --> 00:03:01,400
،أجل، تُناسبني تمامًا
.شُكرًا لك

22
00:03:02,980 --> 00:03:03,580
...جوُان

23
00:03:04,780 --> 00:03:05,760
.جُوان جُوان

24
00:03:13,820 --> 00:03:15,480
ماذا سنَتناولُ في وجبة الغداء؟

25
00:03:16,370 --> 00:03:19,680
سمعتُ أنّ مطعم وَانغ الّذي افتُتحَ
.حديثًا يُقدّم أطباقًا مُذهلة

26
00:03:19,690 --> 00:03:20,950
.سمعتُ عن ذلك أيضًا

27
00:03:21,090 --> 00:03:24,210
،إنّهم يُقدّمون معجونَ لحم السّلطعان
،وكعك الخمِيرة، ولحمَ الخِنزير المطهوّ بلُطفٍ

28
00:03:24,220 --> 00:03:25,680
.وحساءَ الدّجاج الحارّ

29
00:03:27,350 --> 00:03:29,840
جُوان جُوان، لنَتناول الطّعام
.في الخارِج اليوم

30
00:03:31,550 --> 00:03:32,660
...ولكن

31
00:03:34,180 --> 00:03:38,180
ذلك المطعم يتطلّب
...حجزًا قبل يومٍ، أخشى

32
00:03:40,070 --> 00:03:42,450
إذا كُنتم ترغبون، بمَقدوري
.أن أذهبَ لأحجز طاولةً

33
00:03:42,600 --> 00:03:44,660
وسنكونُ قادرينَ على تناول
.الطّعام هُناك اليوم

34
00:03:44,970 --> 00:03:47,180
ما الّذي يجعلكَ تظنّ
أنّك ستحصلُ على حجزٍ؟

35
00:03:47,190 --> 00:03:49,250
عالجتُ السيّد وَانغ مِن
.آلام أسفل الظّهر

36
00:03:49,730 --> 00:03:52,140
وقد قالَ لي إنّني مرحّبٌ
.بي في أيّ وقتٍ

37
00:03:52,800 --> 00:03:56,090
حقًا؟
هل عالجتَ السيّد وَانغ؟

38
00:03:56,340 --> 00:03:57,470
تولّى السيّد قِطّ تدبيرَ
.ذلك اللّقاء

39
00:04:00,180 --> 00:04:02,340
ماذا ننتظرُ إذن؟
.لنَذهب حالًا

40
00:04:04,770 --> 00:04:05,910
.اذهبُوا أنتم

41
00:04:05,930 --> 00:04:09,060
تذكّرتُ فجأةً أنّ لديّ أشياءَ
.لأقوم بها، لذلك لن أذهب

42
00:04:11,820 --> 00:04:13,530
.جُوان جُوان، انتظِري

43
00:04:16,560 --> 00:04:18,260
...هل لاحظتُما أنّ

44
00:04:18,300 --> 00:04:21,480
تعامل جُوان جُوان مع الطّائر
الصّغير كان غريبًا هذه الأيّام؟

45
00:04:21,490 --> 00:04:22,110
هكذا إذن؟

46
00:04:22,720 --> 00:04:24,060
.أجل

47
00:04:34,070 --> 00:04:37,350
أشعرُ أنّ جُوان جُوان
.تتعمّدُ تجنّب لِي شِياو

48
00:04:37,370 --> 00:04:39,370
...إذا كان الحالُ كذلك

49
00:04:45,810 --> 00:04:46,750
!هذا غريبٌ

50
00:04:47,190 --> 00:04:50,290
هل فعلَ الطّائر الصّغير
شيئًا أزعجَ جُوان جُوان؟

51
00:04:51,500 --> 00:04:53,990
أخبرتكُما أنّ مكانتهُ عندها
.لن تدومَ كثيرًا

52
00:04:54,000 --> 00:04:55,540
.فهمتُ الآن

53
00:04:55,630 --> 00:04:58,190
لا بُدّ أنّ الخالدة تتصرّفُ
...هكذا لأنّ

54
00:04:58,900 --> 00:05:01,290
!لأنّني أنا المُفضّل عندها

55
00:05:04,420 --> 00:05:06,940
.هِي تُحبّني أنا أكثر، هذا واضحٌ! أنا -
!لا تقرُص أُذني -

56
00:05:06,950 --> 00:05:08,020
!بل أنا

57
00:05:08,470 --> 00:05:11,580
،أيّها الأبلهان
.أنتُما لا تفهمان فحسب

58
00:05:28,950 --> 00:05:31,830
،شُو جُوان جُوان
فيما تُمعنينَ التّفكير؟

59
00:05:32,400 --> 00:05:34,010
فيما تُفكّرين؟

60
00:05:36,350 --> 00:05:39,110
لماذا... لماذا أنت هُنا؟

61
00:05:46,760 --> 00:05:48,290
.جِئتُ لأسكبَ الشّاي لكِ

62
00:05:48,920 --> 00:05:52,000
،لا داعي لذلك
.بمَقدوري فِعلها بنفسي

63
00:05:52,030 --> 00:05:52,870
.اذهب لتدبّر شُؤونكَ

64
00:05:52,880 --> 00:05:53,490
،جُوان جُوان

65
00:05:54,240 --> 00:05:57,430
هل فعلتُ شيئًا أزعجكِ مُؤخّرًا؟

66
00:05:58,640 --> 00:06:00,680
،كلا
.أنت تُبالغ في التّفكير

67
00:06:01,750 --> 00:06:04,120
إذن لماذا تتعمّدين تجنّبي؟

68
00:06:04,220 --> 00:06:05,550
.لم أفعل

69
00:06:05,580 --> 00:06:07,240
.كُنت مشغولةً بالعمل فحسب

70
00:06:07,460 --> 00:06:08,690
...ولكن جليٌّ أنّكِ -
...المعذرة -

71
00:06:08,700 --> 00:06:12,300
ولكن، هل يستقبلُ الصيدلانيّ لِي
المرضى هُنا في معبد إله الأرض؟

72
00:06:13,620 --> 00:06:15,760
أجل، ولكنّه غير موجودٍ
.في الوقت الحاليّ

73
00:06:16,520 --> 00:06:18,440
إذن... متى سيَعود؟

74
00:06:18,740 --> 00:06:20,100
إنّ سيّدي الشّاب يُعاني
.مِن مرضٍ غريب

75
00:06:20,110 --> 00:06:22,090
.وحياتهُ مرهونةٌ بين يديه

76
00:06:22,100 --> 00:06:24,160
،لِي شِياو
.اذهب لتُلقي نظرةً

77
00:06:24,480 --> 00:06:27,480
إنّها مسألةُ حياةٍ أو
.موت، الأمر طارئٌ

78
00:06:40,440 --> 00:06:42,100
إنّ سيّدي الشّاب يُعاني
.مِن مرضٍ غريب

79
00:06:42,110 --> 00:06:44,130
،دعونا كُلّ طبيبٍ قريب

80
00:06:44,290 --> 00:06:46,320
.ولكن لم يتمكّن أحدٌ مِن تشخِيصه

81
00:06:47,190 --> 00:06:50,320
،إنّ السيّدة قلقةٌ للغاية
.تفضّل مِن هذا الطّريق، رجاءً

82
00:06:50,530 --> 00:06:53,230
دارُ نِينغ

83
00:06:54,800 --> 00:06:56,140
،هذا مبهجٌ

84
00:06:56,150 --> 00:06:59,150
حضرتَ، يُمكن إنقاذ السيّد
.الشّاب الآن

85
00:07:04,290 --> 00:07:05,280
...أودّ أن أسألَ

86
00:07:05,700 --> 00:07:08,550
إن كان سيّدك هُو
الزّعيم نِينغ كُوي؟

87
00:07:09,800 --> 00:07:12,400
أيّها الصيدلانيّ لِي، هل كُنتَ
أنت والسيّد تعرفان بعضكُما؟

88
00:07:12,710 --> 00:07:14,570
.سمعتُ عن إنجازات الزّعيم نِينغ

89
00:07:15,880 --> 00:07:18,340
.كان بطلًا في معركة أرض السّراب

90
00:07:18,990 --> 00:07:20,730
،بعد أن ماتَ السيّد في المعركة

91
00:07:20,740 --> 00:07:23,290
لم تُرِد السيّدة أن يسلُكَ
،السيّد الشّاب النّهج نفسه

92
00:07:23,300 --> 00:07:24,760
.لذلك حلّت الطّائفة

93
00:07:25,060 --> 00:07:27,320
كان السيّد الشّاب في الثّامنة مِن
.عُمره فحسب في ذلك الوقت

94
00:07:27,820 --> 00:07:30,840
ولحُسن الحظّ، فإنّ ملك
...الجنوب قد اعتنى بهما

95
00:07:31,070 --> 00:07:33,000
.بدافعِ صداقته مع السيّد

96
00:07:33,200 --> 00:07:35,200
ماتَ الزّعيم نِينغ مِن
.أجل الشّعب

97
00:07:35,620 --> 00:07:37,220
.سيذكُره النّاس دومًا

98
00:07:40,560 --> 00:07:42,420
،أيّها الصيدلانيّ لِي
هل أنت بخيرٍ؟

99
00:07:42,800 --> 00:07:43,780
.أنا بخيرٍ

100
00:07:49,560 --> 00:07:50,900
.ذلك الغُراب المُزعج

101
00:07:51,150 --> 00:07:53,990
،لا تمُت في الفناء أيضًا
.هذا نحسٌ شديد

102
00:07:54,250 --> 00:07:56,310
هل تسقطُ الغُربان في
الفناء كثيرًا؟

103
00:07:57,460 --> 00:07:58,580
.أجل، حدث ذلك مِرارًا

104
00:08:00,100 --> 00:08:02,050
،إذا حلّ سُوء الطّالع بهذه العائلة

105
00:08:02,130 --> 00:08:05,440
تجترئُ علينا حتّى هذه
.الطّيور لتَستضعِفنا

106
00:08:06,790 --> 00:08:09,870
علّقت السيّدة آمالها على
.السيّد الشّاب

107
00:08:10,240 --> 00:08:12,570
ولكن حاليًا، السيّد الشّاب
.قد وقعَ طريح الفِراش

108
00:08:14,790 --> 00:08:16,520
.أيّها الصيدلانيّ لِي، وصلنا

109
00:08:18,790 --> 00:08:19,390
،سيّدتي

110
00:08:20,130 --> 00:08:21,990
.أحضرتُ الصيدلانيّ لِي

111
00:08:24,670 --> 00:08:27,540
،أيّها الصيدلانيّ لِي
.أرجوكَ أنقِذ ابني

112
00:08:30,630 --> 00:08:32,810
إنّ ابني طريحُ الفِراش
.مُنذ شهرين

113
00:08:32,820 --> 00:08:34,400
.كان خائرَ القُوى في البداية

114
00:08:34,650 --> 00:08:36,640
،ظننتُ أنّه متعبٌ مِن الدّراسة

115
00:08:36,650 --> 00:08:38,550
.لذلك أعطيتهُ حساءً مُقوّيًا

116
00:08:39,400 --> 00:08:42,070
اعتقدتُ أنّه سيَكون بخيرٍ بعد
.نيلِ قسطٍ جيّد مِن الرّاحة

117
00:08:42,520 --> 00:08:44,960
،ولكن على غير المُتوقّع
.أصبحَ أكثر ضعفًا

118
00:08:45,710 --> 00:08:49,170
،والآن
.يكادُ لا يستيقظُ أبدًا

119
00:08:52,800 --> 00:08:55,520
هل تحتفظِين بسجلّ
لما يتناولهُ يوميًا؟

120
00:08:55,690 --> 00:08:57,060
.أودّ مُراجعته

121
00:08:58,570 --> 00:09:00,420
،أجل
.أرجوكَ انتظر لحظةً

122
00:09:10,900 --> 00:09:13,730
.هذه الرّسمة... نابضةٌ بالحياة

123
00:09:16,250 --> 00:09:17,680
.رسمها آن

124
00:09:18,140 --> 00:09:20,530
.لم يكُن يُركّز على دراستِه قطعًا

125
00:09:20,550 --> 00:09:22,610
كان يرسمُ دائمًا هذه
.الأشياء عديمةَ الفائدة

126
00:09:24,500 --> 00:09:25,360
،أيّها الصيدلانيّ لِي

127
00:09:28,600 --> 00:09:30,420
هل يُمكن شفاؤه؟

128
00:09:31,670 --> 00:09:34,910
،المسألة معقّدةٌ حقًا
.سأُعطيكِ وصفةً طبيّة أولًا

129
00:09:35,040 --> 00:09:37,190
حسنًا، تفضّل مِن هذا
.الاتّجاه رجاءً

130
00:09:47,860 --> 00:09:49,190
،إنّ ابنكِ يمتلكُ ذوقًا رفيعًا

131
00:09:49,660 --> 00:09:52,390
فأدوات الكتابة الّتي يستخدِمها
.مِن نوعيّةٍ مُمتازة

132
00:09:52,480 --> 00:09:56,010
،أهداها الصّديق المُقرّب لزوجي
.الزّعيم هُوا، لابني في العام الماضي

133
00:09:56,380 --> 00:09:57,970
.وقال إنّها قطعٌ نادرة

134
00:09:59,050 --> 00:10:00,730
،أنا لا أفقهُ في هذه الأمور

135
00:10:00,750 --> 00:10:02,380
.ولكن آن يُحبّها كثيرًا

136
00:10:03,360 --> 00:10:07,020
الزّعيم هُوا؟
هُوا فِينغ يُو، ملك الجنوب؟

137
00:10:07,120 --> 00:10:07,870
،أجل

138
00:10:08,430 --> 00:10:10,490
.ماتَ زوجي في ساحة المعركة

139
00:10:10,510 --> 00:10:13,380
وقد خاطرَ الزّعيم هُوا
.بحياته ليُعيد جُثمانه

140
00:10:14,540 --> 00:10:17,210
آنذاك، لم يكُن أمامي
.خيارٌ سِوى حلّ الطّائفة

141
00:10:17,220 --> 00:10:19,550
وكان هُو أيضًا مَن هدّأ
.مِن روع الجميع

142
00:10:19,870 --> 00:10:21,120
.فهمتُ

143
00:10:21,900 --> 00:10:23,430
.الوصفة الطبيّة جاهزةٌ

144
00:10:24,520 --> 00:10:26,790
...هل يُمكنني البقاء في الدّار اللّيلة

145
00:10:27,480 --> 00:10:29,610
لأتمكّن مِن فحص السيّد
نِينغ في أيّ وقتٍ؟

146
00:10:30,220 --> 00:10:31,970
.هذا شرفٌ لي

147
00:10:32,170 --> 00:10:35,010
يا قوم، أعدّوا غُرفة
.ضُيوفٍ للصيدلانيّ لِي

148
00:10:45,960 --> 00:10:48,030
لِي شِياو لم يعُد حتّى
.هذه السّاعة

149
00:10:48,990 --> 00:10:51,560
لماذا تقلقينَ عليه؟
.لنَأكل فحسب

150
00:10:53,650 --> 00:10:54,350
،جُوان جُوان

151
00:10:54,730 --> 00:10:57,060
أرسلِي رسالةً واسأليه إن
.كان سيَعودُ لتناولِ العشاء

152
00:10:57,070 --> 00:10:59,130
أنا... لا أعتقد أنّ
.ذلك ضروريٌّ

153
00:10:59,430 --> 00:11:01,370
،إنّه رجلٌ بالغ
.ولن يموتَ جُوعًا

154
00:11:01,550 --> 00:11:02,650
.هذا صحيحٌ

155
00:11:03,050 --> 00:11:06,150
،جُوان جُوان
،رُغم أنّه يبدو ناضجًا

156
00:11:06,350 --> 00:11:08,510
إلّا أنّه كان مُجرّد طائرٍ
.صغير قبل أيّامٍ قليلة

157
00:11:09,020 --> 00:11:11,990
إذا قامَ خالدٌ آخر باختطافِه
،واتّخذ منه مركبةً له

158
00:11:12,000 --> 00:11:13,510
.ستَندمين

159
00:11:13,800 --> 00:11:16,130
،راسلتهُ بالفِعل
.ولكنّه لم يردّ

160
00:11:16,580 --> 00:11:17,510
ماذا قُلتِ له؟

161
00:11:18,490 --> 00:11:21,150
،أشكّ في أنّه قد يُختطف
.إنّه ليس بهذا الغباء

162
00:11:21,560 --> 00:11:22,360
.أجل

163
00:11:22,800 --> 00:11:26,260
أنا قلقٌ مَن أن يكونَ قد
.واجهَ متاعب في دار المريض

164
00:11:27,410 --> 00:11:29,040
ما المتاعب الّتي قد تكون هُناك؟

165
00:11:30,090 --> 00:11:31,200
...علِمتُ لتوّي

166
00:11:31,820 --> 00:11:33,450
...أنّ السيّد نِينغ الّذي يزورهُ

167
00:11:34,130 --> 00:11:36,310
...هُو ابن الزّعيم نِينغ الّذي ماتَ

168
00:11:36,330 --> 00:11:38,790
في معركة أرض السّراب
.مُنذ عشر سنواتٍ

169
00:11:40,460 --> 00:11:43,060
وتناهى إلى مسامعِي أنّ مرض
.السيّد نِينغ ظهرَ مِن حيثُ لا يعلم

170
00:11:43,840 --> 00:11:46,100
كما أنّ شيطان السّراب باتَ
.نشطًا على غير العادة

171
00:11:46,110 --> 00:11:47,840
.وقد عاودت عُشبة الأشباح الظّهور

172
00:11:48,540 --> 00:11:50,990
لنأمل ألّا يتورّط مع
.شيطان السّراب مُجدّدًا

173
00:11:51,000 --> 00:11:52,820
،أيّتها الخالدة
إلى أين أنتِ ذاهبةٌ؟

174
00:11:53,500 --> 00:11:55,570
تذكّرت أنّ ثمّة
.شأنًا يستوجبُ خُروجي

175
00:11:55,580 --> 00:11:57,640
،تناولوا الطّعام أنتم أولًا
.لا تنتظِرونا

176
00:11:58,520 --> 00:11:59,770
تنتظِرونا؟

177
00:12:08,090 --> 00:12:09,530
.لا بُدّ أنّ هذا المكان

178
00:12:10,250 --> 00:12:11,380
.كانت مِيان مِيان على حقٍ

179
00:12:11,720 --> 00:12:13,120
.إنّه لا يزالُ طائرًا صغيرًا

180
00:12:13,640 --> 00:12:15,070
.وهُو غائبٌ حتّى هذه السّاعة

181
00:12:15,080 --> 00:12:16,880
مِن الطّبيعي أن أكونَ
.قلقةً بعض الشّيء

182
00:12:16,890 --> 00:12:19,720
علاوةً على ذلك، فإنّ
.شيطان السّراب باتَ نشطًا

183
00:12:19,810 --> 00:12:22,350
ومِن واجبي أن أقومَ
.بالدّوريات بشكلٍ أكبر

184
00:12:23,100 --> 00:12:24,200
،سأُلقِي نظرةً خاطفة فحسب

185
00:12:24,210 --> 00:12:26,270
.وسأُغادر إذا كان آمنًا

186
00:12:26,500 --> 00:12:28,160
.أجل، هذا ما سأفعله

187
00:12:30,850 --> 00:12:33,940
هالةٌ قاتِلة؟ هل هُناك خطبٌ
ما في هذا المكان؟

188
00:12:46,120 --> 00:12:47,570
.اختفت

189
00:12:48,260 --> 00:12:49,860
،أيّها الصيدلانيّ لِي
.تفضّل الشّاي

190
00:12:49,870 --> 00:12:50,870
.شُكرًا لكِ، سيّدتي

191
00:12:52,330 --> 00:12:55,290
.أنا أعتمدُ عليكَ لإنقاذ ابني

192
00:12:55,310 --> 00:12:57,940
،لا داعي لكُلّ هذه الرّسميات
.سيّدتي، سأبذلُ قُصارى جُهدي

193
00:13:03,850 --> 00:13:04,780
...هل يُمكن أن يكونَ

194
00:13:07,540 --> 00:13:08,200
!لِي شِياو

195
00:13:11,480 --> 00:13:12,370
.جُوان جُوان

196
00:13:15,470 --> 00:13:18,910
تأمّلي حالكِ، كم كُوبًا
كسرتِ هذا الشّهر؟

197
00:13:19,590 --> 00:13:22,190
.هذا يكفي، نظّفي المكان -
.أنتِ لا تتعلّمين إطلاقًا -

198
00:13:22,330 --> 00:13:24,660
.لا تُحرِجينا أمام الضّيفان

199
00:13:25,510 --> 00:13:27,040
.اعتذاري الشّديد لكُما

200
00:13:27,170 --> 00:13:29,440
،سيّدة لِي
.كان هذا سهوًا منّي

201
00:13:29,690 --> 00:13:31,430
نسيتُ أن أُرسل خطابًا
...إلى قصر لِي

202
00:13:31,440 --> 00:13:33,380
لأُخبركِ أنّ الصيدلانيّ لِي
.سيَبيتُ هُنا اللّيلة

203
00:13:33,390 --> 00:13:36,060
لذلك اضطُررتِ للمجيء إلى
.هُنا للبحث عنه لأنّكِ قلقةٌ

204
00:13:36,070 --> 00:13:38,200
لماذا أخبرتها أنّني زوجتكَ؟

205
00:13:38,370 --> 00:13:40,300
.اقتحمتِ المكان بهذا العُنف

206
00:13:40,580 --> 00:13:42,520
لم يكُن باستطاعتِي أن
...أقولَ لها إنّكِ سيّدتي

207
00:13:42,530 --> 00:13:45,330
وإنّكِ كُنتِ قلقةً مِن أن
يؤذينِي أحدٌ، أَليس كذلك؟

208
00:13:46,400 --> 00:13:49,330
تأخّرَ الوقت، لماذا لا تبقيان
في الدّار كلاكُما؟

209
00:13:49,830 --> 00:13:52,380
طلبتُ مِن أحدهم أن
.يُرتّب غُرفةً لكُما

210
00:13:52,390 --> 00:13:55,030
غرفةٌ... غرفةٌ واحدة؟
.كلا، كلا. لا داعي لذلك

211
00:13:55,060 --> 00:13:56,790
.لن أتشاركَ الغُرفة معه

212
00:13:56,850 --> 00:13:58,780
،مِن الطبيعيّ أن يتشاجر الزّوجان

213
00:13:58,950 --> 00:14:00,880
.خلافاتُ العُشّاق سُرعانَ ما تنتهِي

214
00:14:01,230 --> 00:14:03,700
لا شكّ أنّ الصيدلانيّ لِي
.شخصٌ مُخلِص

215
00:14:04,040 --> 00:14:06,570
،سيّدة لِي
.عليكِ أن تثقِي به أكثر

216
00:14:06,600 --> 00:14:08,110
.شُكرًا لاهتمامكِ، سيّدتي

217
00:14:08,120 --> 00:14:10,420
.الخللُ يكمن في تقصِيري

218
00:14:10,600 --> 00:14:11,930
.تفضّلا مِن هذا الاتّجاه، رجاءً

219
00:14:23,250 --> 00:14:26,400
...كان... أمرًا طارئًا، لذلك

220
00:14:26,820 --> 00:14:28,700
.أعلمُ، لا داعي لأن تشرح

221
00:14:34,320 --> 00:14:35,140
.تناولِي المأكولات الخَفيفة

222
00:14:35,150 --> 00:14:36,550
.كلا... كلا، شُكرًا لك

223
00:14:39,430 --> 00:14:41,360
.أتذكّر أنّكِ لا تُحبّين الجوز

224
00:14:41,630 --> 00:14:43,090
.سأُساعدكِ في إزالته

225
00:14:43,280 --> 00:14:44,520
.أنا لا أُريد جوزًا

226
00:14:44,980 --> 00:14:46,780
سأُساعدكِ في إزالته، حسنًا؟

227
00:14:53,850 --> 00:14:54,620
راضيةٌ الآن؟

228
00:14:58,830 --> 00:14:59,760
لماذا أنتِ هُنا؟

229
00:15:00,470 --> 00:15:04,550
حسنًا... أصرّت مِيان مِيان أن
.آتي لأُعيدكَ لتناول العشاء

230
00:15:05,260 --> 00:15:08,760
إذا كُنت لن تعود، كان
...عليكَ أن تُرسل لي رسالةً، أنا

231
00:15:08,770 --> 00:15:10,610
.كانت مِيان مِيان قلقةً عليك

232
00:15:10,790 --> 00:15:13,210
رسالةٌ؟ أيّ رسالةٍ؟

233
00:15:16,170 --> 00:15:19,170
نسيتُ أنّك طائرٌ صغير
.يجهلُ هذا

234
00:15:32,820 --> 00:15:34,620
.شعرتُ ببعض الحرارة قبل بُرهةٍ

235
00:15:35,110 --> 00:15:36,590
.إذن كانت تلك هِي الإشارة

236
00:15:41,970 --> 00:15:43,870
.بعد ذلك، هكذا

237
00:15:49,480 --> 00:15:50,660
.أنا آسفةٌ، لِي شِياو

238
00:15:53,660 --> 00:15:56,050
.لم يكُن عليّ أن أتجنّبك

239
00:15:59,530 --> 00:16:01,280
إذن لماذا تجنّبتني صدقًا؟

240
00:16:03,820 --> 00:16:07,460
...أنت
،تُذكّرني بصديقٍ قديم لي

241
00:16:08,950 --> 00:16:10,010
.وهذا مريبٌ جدًا

242
00:16:10,560 --> 00:16:13,280
أنت لا تُشبهه في الشّكل
،ولا في الصّوت

243
00:16:13,620 --> 00:16:16,280
.لكن رُؤيتكَ تُذكّرني به

244
00:16:17,090 --> 00:16:19,860
.لذلك لا أعرفُ كيف أواجهكَ

245
00:16:21,850 --> 00:16:25,590
هل تقصدينَ السيّد شَاو
الّذي يبحثُ عنه سِي؟

246
00:16:28,080 --> 00:16:29,410
،مرّت سنواتٌ طويلة

247
00:16:30,040 --> 00:16:31,440
هل فكّرتِ في أنّه
...رُبّما يكونُ قد

248
00:16:31,450 --> 00:16:32,280
!محالٌ

249
00:16:33,490 --> 00:16:34,590
.لن أستسلِم

250
00:16:39,250 --> 00:16:42,780
على أيّ حالٍ، ما المرض الّذي
يُعاني منه السيّد نِينغ؟

251
00:16:45,980 --> 00:16:47,110
،إنّه ليس مرضًا

252
00:16:47,580 --> 00:16:48,310
.بل سمٌّ

253
00:16:48,620 --> 00:16:49,280
سمٌّ؟

254
00:16:49,980 --> 00:16:51,510
.امتصّه جسدهُ عبر الجلد

255
00:16:53,170 --> 00:16:54,630
.إنّه سمٌّ خفيّ للغاية

256
00:16:55,300 --> 00:16:57,640
أظافرُ يد السيّد نِينغ اليُمنى
،مائلةٌ إلى الرّمادي والأزرق

257
00:16:57,650 --> 00:16:59,510
لكن أظافرَ يده اليُسرى
.ليست كذلك

258
00:16:59,830 --> 00:17:03,830
هذا يعني أنّ السُمّ تسلّل إلى جسده
.ببُطءٍ شديد عن طريق يده اليُمنى

259
00:17:04,180 --> 00:17:07,240
لذا، لا بُدّ أنّ السُمّ كان مخفيًا
.في شيءٍ كان يستخدمهُ كثيرًا

260
00:17:07,330 --> 00:17:10,530
السُمّ يُدمّر بنيةَ السيّد
،نِينغ ببُطءٍ

261
00:17:11,160 --> 00:17:12,790
،ولكن السُميّة ضعيفةٌ

262
00:17:12,810 --> 00:17:14,330
.كما أنّ هذا السُمّ نادرٌ

263
00:17:14,530 --> 00:17:15,810
.وفي العادة، يسهلُ إغفاله

264
00:17:15,810 --> 00:17:17,610
مَن يجرؤُ على فعلٍ
بهذه الدّناءة؟

265
00:17:17,610 --> 00:17:20,110
لا بُدّ أنّه شخصٌ مُقرّب
.مِن السيّد نِينغ

266
00:17:20,150 --> 00:17:21,180
كيف عرفتَ ذلك؟

267
00:17:21,450 --> 00:17:24,220
...مَن يعرفُ تفضيلاتِه ورُوتينَه اليوميّ

268
00:17:24,230 --> 00:17:26,820
هُو مَن ستُتاح له الفُرصة لدسّ
.مثل هذا السُمّ بطيء المفعول

269
00:17:26,990 --> 00:17:31,000
ومَن هُو مقرّبٌ منه سيحتاجُ إلى
.الحيطة وتوخّي الحذر إلى هذا الحدّ

270
00:17:31,840 --> 00:17:34,090
ليس هُناك الكثير مِن النّاس
.الّذين يتعاملونَ مع عائلة نِينغ

271
00:17:34,100 --> 00:17:35,730
وأعتقدُ أنّه ليس مِن الصّعب
.اكتشافُ الجاني الحقيقيّ

272
00:17:35,740 --> 00:17:37,670
هل يُمكنكَ إزالة السُمّ
مِن جسده؟

273
00:17:37,680 --> 00:17:40,270
السُمّ موجودٌ في جسده
.مُنذ فترةٍ ليست بالقصيرة

274
00:17:40,280 --> 00:17:41,680
.لستُ واثقًا تمامًا

275
00:17:42,670 --> 00:17:43,320
...وأيضًا

276
00:17:44,090 --> 00:17:44,670
ماذا؟

277
00:17:45,050 --> 00:17:47,150
.لاحظتُ ما يبعثُ على الرّيبة

278
00:17:48,250 --> 00:17:49,450
يبعثُ على الرّيبة؟

279
00:17:51,100 --> 00:17:53,430
.لهذا السّبب قرّرتُ البقاء هُنا

280
00:17:54,210 --> 00:17:55,260
،لننتظِر فحسب

281
00:17:55,820 --> 00:17:58,430
فقد نتمكّن اللّيلة مِن
.جمع الأدلّة

282
00:18:32,330 --> 00:18:33,070
!توقّفي

283
00:18:34,660 --> 00:18:36,060
،إليكِ ضربةُ سيفي
!أيّتها الشّيطانة

284
00:19:03,750 --> 00:19:05,210
!جُوان جُوان، لا تُؤذِيها

285
00:19:11,880 --> 00:19:13,990
كيف... كيف لك أن...؟

286
00:19:14,010 --> 00:19:15,630
.لا تُؤذي هُوي

287
00:19:16,650 --> 00:19:18,320
.كانت تُحاول إنقاذي فحسب

288
00:19:23,300 --> 00:19:30,360
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

289
00:19:30,450 --> 00:19:38,960
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

290
00:19:41,020 --> 00:19:45,730
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

291
00:19:45,740 --> 00:19:50,370
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

292
00:19:50,380 --> 00:19:54,230
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

293
00:19:54,240 --> 00:19:58,700
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

294
00:19:58,710 --> 00:20:03,400
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

295
00:20:03,410 --> 00:20:08,100
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

296
00:20:08,110 --> 00:20:13,280
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

297
00:20:13,290 --> 00:20:17,300
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

298
00:20:17,310 --> 00:20:22,440
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

299
00:20:22,450 --> 00:20:26,910
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

300
00:20:26,920 --> 00:20:31,880
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

301
00:20:31,890 --> 00:20:36,340
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

302
00:20:41,460 --> 00:20:47,590
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟