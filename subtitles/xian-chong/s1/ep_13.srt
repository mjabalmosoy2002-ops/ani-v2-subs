1
00:00:28,620 --> 00:00:29,570
،معشرَ الحُضور

2
00:00:31,790 --> 00:00:32,990
...لا يخفى عليكُم

3
00:00:33,020 --> 00:00:36,290
ما كابدهُ ابني هُوا كَانغ مِن
.مرضٍ مُزمنٍ مُنذ طُفولته

4
00:00:36,300 --> 00:00:38,880
،وبسببِ ذلك
.عشتُ في قلقٍ دائم

5
00:00:38,890 --> 00:00:40,560
لكن السّماء رحِمتنا
.ولم تُخيّب رجاءنا

6
00:00:40,570 --> 00:00:43,890
ففِي هذا اليوم بالذّات، يوم
،ميلادِ كَانغ السّادس عشر

7
00:00:44,510 --> 00:00:47,840
كُنت محظوظًا بما يكفي
.لأحصلَ على إكسيرٍ لعلاجه

8
00:00:48,220 --> 00:00:50,690
اليوم، أفرادُ عائلة هُوا
.مُجتمعونَ معًا

9
00:00:52,380 --> 00:00:54,740
.بولادةِ ابني الجديدة

10
00:00:55,840 --> 00:00:56,340
!نخبكُم

11
00:01:28,600 --> 00:01:35,200
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

12
00:01:35,560 --> 00:01:43,250
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

13
00:01:43,320 --> 00:01:49,710
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

14
00:01:49,720 --> 00:01:55,470
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

15
00:01:56,690 --> 00:02:03,770
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

16
00:02:03,780 --> 00:02:09,150
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

17
00:02:11,470 --> 00:02:18,290
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

18
00:02:18,300 --> 00:02:24,110
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

19
00:02:24,740 --> 00:02:32,050
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

20
00:02:32,060 --> 00:02:38,780
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

21
00:02:38,790 --> 00:02:45,030
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

22
00:02:45,040 --> 00:02:52,390
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

23
00:03:07,270 --> 00:03:09,060
،الطّائر الشيطانيّ لِي شِياو
...مشتبهٌ به

24
00:03:09,070 --> 00:03:11,700
في قتلِ جميع أهل بيت
.هُوا فِينغ يُو، ملكِ الجنوب

25
00:03:11,710 --> 00:03:13,110
!اقبضُوا عليه فورًا

26
00:03:14,860 --> 00:03:16,460
مَن ذا الّذي يتجرّأ
على مسّه بسُوءٍ؟

27
00:03:19,660 --> 00:03:21,460
.هذه القضيّة خطيرةٌ جدًا

28
00:03:21,470 --> 00:03:24,380
،أيّتها الخالدة
.أرجوكِ لا تقفِي في طريقنا

29
00:03:24,390 --> 00:03:26,370
قتلُ جميع أهلِ بيت
—ملكِ الجنوب

30
00:03:26,380 --> 00:03:28,190
.هذا ليس باتّهامٍ هيّن

31
00:03:28,600 --> 00:03:30,160
،وبدُون دليلٍ

32
00:03:30,180 --> 00:03:33,060
،حتّى أنت أيّها الأميرُ شيَان
.لا يحقّ لك أن تقبضَ عليه كما تشاء

33
00:03:33,070 --> 00:03:36,070
كيف لي أن أجرؤ على
مُطالبتكِ به دُون دليلٍ؟

34
00:03:42,900 --> 00:03:43,750
هل تعرفهُ؟

35
00:03:44,820 --> 00:03:46,560
إنّه الابن الوحيد
.لـ هُوا فِينغ يُو

36
00:03:46,760 --> 00:03:47,670
.وقد تولّيتُ علاجه

37
00:03:49,450 --> 00:03:52,880
،ذلك الجِينسينغ الأحمر
.هُو مَن أحضرهُ بنفسه

38
00:03:53,120 --> 00:03:54,690
أيّ جِينسينغٍ أحمر؟

39
00:03:54,710 --> 00:03:55,900
،الطّائر الشيطانيّ، لِي شِياو

40
00:03:55,910 --> 00:03:58,590
أحضرَ جِينسينغًا أحمر إلى
.عائلة هُوا قبل أيّامٍ قليلة

41
00:03:58,600 --> 00:04:00,260
،وقالَ إنّه إذا نُقع في النّبيذ

42
00:04:00,280 --> 00:04:02,540
فإنّه يُمكن أن يُخفّف
.مرض السيّد هُوا المُزمن

43
00:04:02,750 --> 00:04:04,670
ولكن في مأدبةِ عيد ميلاد
،السيّد هُوا بالأمس

44
00:04:04,680 --> 00:04:07,490
بعد أن شربَ الزّعيم هُوا
،والضّيوف ذلك النّبيذ

45
00:04:07,510 --> 00:04:09,400
.تحوّلوا إلى أطياف نارٍ

46
00:04:09,670 --> 00:04:12,680
وحاليًا، تحوّلت بُحيرة
.جِي يِي بأكملها إلى جحيمٍ

47
00:04:12,700 --> 00:04:15,160
لا شكّ في أنّ ذاك الجِينسينغ
!الأحمر ليس إلّا عُشب أشباحٍ

48
00:04:15,250 --> 00:04:16,640
،وأنّ لِي شِياو، الجاني

49
00:04:16,820 --> 00:04:19,480
يجبُ أن يكونَ له
!صلةٌ بشيطان السّراب

50
00:04:19,890 --> 00:04:21,520
لماذا؟

51
00:04:21,560 --> 00:04:23,020
ما السّبب حقًا؟

52
00:04:24,160 --> 00:04:26,890
لا يُوجد ضغينةٌ بين
.عائلة هُوا وبينكَ

53
00:04:27,780 --> 00:04:30,400
لماذا فعلتَ ذلك؟

54
00:04:35,970 --> 00:04:38,100
.لا بُدّ أنّ هُناك سُوء فهمٍ

55
00:04:38,180 --> 00:04:39,530
،دعنِي آخذهُ معي أولًا

56
00:04:39,540 --> 00:04:40,640
،وأمهلنِي ثلاثة أيّامٍ فحسب

57
00:04:41,090 --> 00:04:43,540
،سأُحقّق في تفاصيلِ القضيّة

58
00:04:43,900 --> 00:04:45,700
.وأُقدّم تفسيرًا للجميع

59
00:04:45,710 --> 00:04:47,510
،أصدرَ جلالتهُ مرسومًا

60
00:04:47,710 --> 00:04:49,330
.ولا يُسمح بتعديله تبعًا للأهواء

61
00:04:50,420 --> 00:04:52,090
.إنّه أليفي

62
00:04:53,200 --> 00:04:55,400
،إذا كُنت تُريد اعتقاله
!فاعتقِلني أنا أيضًا

63
00:05:04,980 --> 00:05:06,130
.اللّورد جِينغ شُون

64
00:05:10,450 --> 00:05:12,180
.ظهرَ عُشب الأشباح مُجدّدًا

65
00:05:12,580 --> 00:05:15,160
أعتقدُ أنّ جلالته يُفضّل
...تجنّب النّزاع

66
00:05:15,170 --> 00:05:18,170
،مع تِيان كوَان، إلهة الحرب
.في ظلّ هذه الظّروف

67
00:05:18,350 --> 00:05:19,410
.سأذهبُ لأتحدّث إليها

68
00:05:28,950 --> 00:05:29,570
ماذا؟

69
00:05:30,240 --> 00:05:31,770
هل ترغبينَ في التمرّد؟

70
00:05:32,700 --> 00:05:34,200
،طالما أنّك لا تتدخّل

71
00:05:34,210 --> 00:05:35,360
.فيُمكنني هزيمتهم

72
00:05:37,670 --> 00:05:38,440
وبعد ذلك؟

73
00:05:39,710 --> 00:05:40,900
...تأخذين هذا

74
00:05:41,540 --> 00:05:42,280
،الطّائر

75
00:05:42,620 --> 00:05:44,080
وتفرّينَ هاربةً إلى
أقصى الأرض؟

76
00:05:45,730 --> 00:05:49,130
،إنّه مُجرّد تحقيقٍ
.ولم تثبُت إدانته بعد

77
00:05:51,680 --> 00:05:52,280
،جُوان جُوان

78
00:05:54,300 --> 00:05:55,170
هل تثقينَ بي؟

79
00:05:56,450 --> 00:05:57,700
،بالطّبع

80
00:05:57,730 --> 00:05:59,860
أنا أثقُ بك مهما
!كانَ ما يقولونه

81
00:06:02,470 --> 00:06:03,330
.وأنا أثقُ بكِ أيضًا

82
00:06:04,610 --> 00:06:05,540
.سأُرافقك

83
00:06:06,770 --> 00:06:07,800
...لِي شِياو، أنت

84
00:06:15,890 --> 00:06:17,630
!لِي شِياو، لا تقلق

85
00:06:18,120 --> 00:06:19,630
،سأكشفُ الحقيقة قريبًا

86
00:06:19,640 --> 00:06:21,090
!وأُعيدكَ إلى الدّار

87
00:06:21,450 --> 00:06:22,000
،حسنًا

88
00:06:22,480 --> 00:06:23,480
.سأنتظركِ

89
00:06:33,450 --> 00:06:34,830
بُحيرة جِي يِي

90
00:06:48,820 --> 00:06:49,770
تَشانغ أر؟

91
00:06:58,200 --> 00:07:00,870
!أيّتها الخالدة

92
00:07:03,590 --> 00:07:04,920
ما الّذي حدثَ تحديدًا؟

93
00:07:05,360 --> 00:07:06,540
لماذا تتواجدُ هُنا؟

94
00:07:08,080 --> 00:07:10,610
بالأمس، كُنت أتفقّد الأحوال في
.هذه الأنحاء، فمررتُ بهذا المكان

95
00:07:10,620 --> 00:07:14,630
وصادفَ أنّ عائلة هُوا كانت تُقيم
.مأدبة ميلادٍ لسيّدهم الشّاب

96
00:07:14,640 --> 00:07:17,670
...لذلك أنا
.عرجتُ لتناول الطّعام

97
00:07:18,790 --> 00:07:20,050
...لكنّي لم أتوقّع

98
00:07:20,480 --> 00:07:22,340
ما الّذي حدثَ تحديدًا آنذاك؟

99
00:07:22,920 --> 00:07:24,570
!حدثَ كُلّ شيءٍ بسُرعةٍ خاطفة

100
00:07:26,490 --> 00:07:28,750
كان هُناك شخصٌ قد
.التهمتهُ ألسنة اللّهب بالفِعل

101
00:07:28,850 --> 00:07:30,460
،حسبتُ أنّه سيهوي صريعًا

102
00:07:30,470 --> 00:07:32,240
،لكنّه على العكس بدأَ يعدو

103
00:07:32,250 --> 00:07:33,900
مُتشبثًا بكُلّ مَن يقعُ
!عليه بصره

104
00:07:33,930 --> 00:07:35,640
،وفي لحظاتٍ
...اشتعلت النّار

105
00:07:35,650 --> 00:07:37,250
!في الجميع واحدًا بعد الآخر

106
00:07:38,880 --> 00:07:39,770
،أنا عديمُ الفائدة

107
00:07:40,260 --> 00:07:43,060
بذلتُ جُهدي، لكنّني لم أتمكّن
!سوى مِن إنقاذ ثلاثة أشخاصٍ

108
00:07:45,630 --> 00:07:47,610
أرواحُ الأرانب مجبولةٌ مُنذ
.الولادة على الخوف مِن النّار

109
00:07:47,620 --> 00:07:49,020
.فعلتَ ما بوسعكَ

110
00:07:50,980 --> 00:07:53,000
ما الّذي حوّلهم إلى ذلك حقًا؟

111
00:07:58,220 --> 00:07:59,210
...أظنّ

112
00:07:59,970 --> 00:08:01,830
أنّ البداية كانت
.مِن جرّة الخمر تلك

113
00:08:03,910 --> 00:08:04,560
،أجل

114
00:08:05,000 --> 00:08:07,330
ثمّة ما هُو مريبٌ
.في جرّة النّبيذ تلك

115
00:08:07,880 --> 00:08:09,090
هل قُلتَ نبيذًا لتوّك؟

116
00:08:09,620 --> 00:08:10,370
.أجل

117
00:08:10,390 --> 00:08:13,010
سمعتُ أنّه كان نبيذَ جِينسينغ
.أحمر مِن عند صيدلانيّ

118
00:08:13,020 --> 00:08:14,260
...أُولئك الّذين شربوا النّبيذ

119
00:08:14,270 --> 00:08:15,930
.تحوّلوا إلى أطياف نارٍ

120
00:08:16,590 --> 00:08:18,160
...والصيدلانيّ الّذي أشاروا إليه

121
00:08:18,170 --> 00:08:18,900
.هُو لِي شِياو

122
00:08:19,060 --> 00:08:19,740
ماذا؟

123
00:08:20,170 --> 00:08:21,140
لِي شِياو؟

124
00:08:22,670 --> 00:08:24,800
لا بُدّ أن أعثرَ على الجاني
.الحقيقيّ بأسرع ما يُمكن

125
00:08:32,540 --> 00:08:34,210
.أيّتها الخالدة، ثمّة حاجزٌ

126
00:08:41,190 --> 00:08:42,400
.هيّا بنا، لندخل

127
00:08:48,690 --> 00:08:50,690
مَن ذا الّذي يتجرأُ
على اقتحامِ الحاجز؟

128
00:09:08,320 --> 00:09:09,490
.أفزعتني

129
00:09:10,160 --> 00:09:11,050
مَن تكونُ؟

130
00:09:11,090 --> 00:09:13,200
!هاجمتنا دُون داعٍ

131
00:09:13,390 --> 00:09:14,580
...هل أنت

132
00:09:15,070 --> 00:09:16,800
تلميذٌ مِن عشيرة بِي؟

133
00:09:17,750 --> 00:09:19,620
،لم أكُن أعلمُ أنّها أنتِ
.أيّتها الخالدة تِيان كوَان

134
00:09:19,630 --> 00:09:21,020
.تقبّلي اعتذاري

135
00:09:21,380 --> 00:09:24,240
،أنا لِيانغ غُوانغ لِين
.تلميذٌ مِن عشيرة بِي

136
00:09:24,540 --> 00:09:26,220
ماذا؟ هل تعرفني؟

137
00:09:28,020 --> 00:09:29,930
،لم أُقابلكِ شخصيًا مِن قبل

138
00:09:30,420 --> 00:09:31,970
لكنّني كثيرًا ما سمعتُ
...الصّغيرة يُون جوُاو

139
00:09:31,980 --> 00:09:33,530
،تتحدّث عنكِ

140
00:09:33,760 --> 00:09:35,360
.لهذا السّبب تعرّفتُ عليكِ

141
00:09:36,750 --> 00:09:37,690
.فهمتُ

142
00:09:38,050 --> 00:09:39,300
كيف حالُ يُون جوُاو؟

143
00:09:39,840 --> 00:09:41,970
،شُكرًا لاهتمامكِ، أيّتها الخالدة

144
00:09:42,150 --> 00:09:43,240
.إنّها بخيرٍ

145
00:09:43,810 --> 00:09:44,610
.هذا جيّدٌ

146
00:09:44,950 --> 00:09:45,610
،حسنًا

147
00:09:46,400 --> 00:09:47,960
،لم تعُد هُناك حاجةٌ إليك هُنا

148
00:09:47,970 --> 00:09:49,360
.يُمكنني الدّخول بمُفردي

149
00:09:54,890 --> 00:09:57,750
هل لديكِ عِلمٌ بأنّ هُونغ مِينغ
قد أصدرَ مرسومًا رسميًا؟

150
00:09:58,160 --> 00:10:00,170
،أيّتها الخالدة
،نظرًا لعلاقتكِ بالمُشتبه به

151
00:10:00,180 --> 00:10:02,710
لا يُسمح لكِ بالتّدخل
.في هذه القضيّة

152
00:10:05,900 --> 00:10:07,990
أنت وحدكَ لن تقدرَ
.على منعي

153
00:10:09,580 --> 00:10:10,680
،لم أكُن لأجرؤَ

154
00:10:11,170 --> 00:10:13,070
.اسمحِي لي أن أتقدّم الطّريق

155
00:10:15,080 --> 00:10:17,140
،للتّحقيق في حريق عائلة هُوا

156
00:10:17,150 --> 00:10:19,730
أرسلَ قصر لِينغ شيَاو رجالًا
،مِن كُلّ العشائر النّبيلة

157
00:10:19,740 --> 00:10:22,240
ويتولّى عالم يَاو غُوانغ
.مسؤوليّةَ القاعة الرئيسيّة

158
00:10:23,420 --> 00:10:24,680
لماذا تُساعدنِي؟

159
00:10:25,330 --> 00:10:27,900
.أنقذتِ حياة الصّغيرة يُون جوُاو

160
00:10:28,340 --> 00:10:30,940
ويتعيّن على تلاميذ عالم
.يَاو غُوانغ أن يردّوا لكِ الفضل

161
00:10:32,690 --> 00:10:33,570
.أيّها الأخ الأكبر -
.أيّها الأخ الأكبر -

162
00:10:33,580 --> 00:10:35,290
وجّهني المُعلّم لأجلبَ
...هذين الخالدين

163
00:10:35,300 --> 00:10:36,860
.إلى هُنا لمُعاينة طيف النّار

164
00:10:37,410 --> 00:10:38,010
.أجل

165
00:10:39,770 --> 00:10:41,560
.تفضّلي، أيّتها الخالدة

166
00:10:47,450 --> 00:10:50,250
إنّه لا يبدو تمامًا كما
.شاهدتهُ بالأمس

167
00:10:51,920 --> 00:10:53,140
هل ما زالَ على قيد الحياة؟

168
00:11:08,990 --> 00:11:10,260
.اهدآ

169
00:11:10,590 --> 00:11:12,020
،فالمكان محميٌّ بتشكيلٍ سحريّ

170
00:11:12,030 --> 00:11:13,230
ولن يقدرَ على مسّ
.أحدٍ بسُوء

171
00:11:15,240 --> 00:11:17,300
في اللّيلة الماضية كان
،إنسانًا حيًا يتنفّس

172
00:11:17,310 --> 00:11:18,800
.بيدَ أنّه الآن باتَ هكذا

173
00:11:21,600 --> 00:11:24,360
يبدو كما لو أنّه قد جُرّع
.سمًا مِن عُشب الأشباح

174
00:11:24,370 --> 00:11:26,230
هل يُوجد أطياف نارٍ أُخرى؟

175
00:11:26,350 --> 00:11:28,080
هذا مَن قُبض عليه
.حيًا فحسب

176
00:11:28,190 --> 00:11:29,950
حينما وصلَ الأمير شيَان
،بصُحبة رجاله

177
00:11:29,960 --> 00:11:33,100
كانت أطيافُ النّار تشنّ هُجومًا على
.كُلّ مَن تقعُ عليه أعينُهم عند الضفّة

178
00:11:33,110 --> 00:11:34,520
،لكن بعد ذلك
،ولسببٍ ما

179
00:11:34,530 --> 00:11:36,730
ارتموا جميعًا بغتةً في
.جوفِ البُحيرة دُفعةً واحدة

180
00:11:36,740 --> 00:11:39,770
ومِن ثُمّ، استطاعَ الأمير
،شيَان ختمهُم في البُحيرة

181
00:11:39,900 --> 00:11:41,700
.ريثما نجدُ سبيلًا لعلاجهم

182
00:11:41,820 --> 00:11:43,640
بعد أن ارتمت أطيافُ
،النّار في الماء

183
00:11:43,650 --> 00:11:45,630
،انحبست النّيران في أجوافهم

184
00:11:45,640 --> 00:11:47,630
.مثل فُرنٍ لا يُمكن إطفاؤه

185
00:11:47,640 --> 00:11:48,770
!هذا غريبٌ للغاية

186
00:11:49,330 --> 00:11:51,020
،الحريقُ لم يترك شيئًا

187
00:11:51,030 --> 00:11:52,340
!تحوّل المكان كُلّه إلى رمادٍ

188
00:11:53,680 --> 00:11:55,870
لا مفرّ لي مِن الغوص تحت
.الماء بحثًا عن أدلّةٍ

189
00:11:55,880 --> 00:11:58,390
لكن البُحيرة محروسةٌ بواسطة
.تلاميذ العشائر النّبيلة

190
00:11:58,400 --> 00:12:00,660
.وهُناك حاجزٌ نصبهُ الأمير شيَان

191
00:12:10,610 --> 00:12:11,480
،وبطبيعة الحال

192
00:12:12,010 --> 00:12:13,830
،لن يستطيعَ صدّكِ
.أيّتها الخالدة

193
00:12:29,000 --> 00:12:32,330
كما هُو متوقّعٌ، ما زالَ ثمّة العديد
.مِن أطياف السّراب المُتبقّية هُنا

194
00:12:33,590 --> 00:12:36,520
وسيكونُ الأمر كارثيًا
!لو خرجت وأثارتِ الفوضى

195
00:13:23,800 --> 00:13:25,480
.الوضع باتَ محفوفًا بالمخاطر

196
00:13:26,750 --> 00:13:28,320
.هُوا فِينغ يُو

197
00:14:18,880 --> 00:14:19,840
ما الّذي يجري؟

198
00:14:22,280 --> 00:14:23,730
أعتقدُ أنّ أحدهم
.قد تسلّل للدّاخل

199
00:14:24,050 --> 00:14:26,580
!افتح الحاجز
!سأنزلُ للأسفل لأُلقي نظرةً

200
00:14:29,510 --> 00:14:32,170
،كلا، قام أحدٌ بتعديل الحاجز
!لا نستطيعُ الوُلوج

201
00:14:32,210 --> 00:14:32,940
ماذا؟

202
00:14:37,970 --> 00:14:39,770
هل ستكونُ الخالدة بخيرٍ؟

203
00:14:40,710 --> 00:14:42,970
،سيّدتي هِي تِيان كوَان
.إلهةُ الحرب

204
00:14:42,980 --> 00:14:45,180
وأطياف النّار هذه
،ليست ندًا لها

205
00:14:46,870 --> 00:14:48,230
أَليس كذلك؟

206
00:15:05,420 --> 00:15:07,820
،ملكُ الجنوب يستحقّ شُهرته

207
00:15:15,910 --> 00:15:18,170
فلولا أنّه سحبهُم إلى
،داخل البُحيرة

208
00:15:18,840 --> 00:15:22,840
لما استطاعَ الأمير شيَان السّيطرة
.على الوضع بهذه السُهولة

209
00:15:23,070 --> 00:15:27,400
ولكانت أطيافُ السّراب هذه قد
.أمست في قبضةِ شيطان السّراب

210
00:15:28,590 --> 00:15:29,430
،كُن مطمئنًا

211
00:15:30,240 --> 00:15:31,170
...واترك

212
00:15:32,020 --> 00:15:33,100
.لي تدبيرَ ما تبقّى

213
00:15:54,280 --> 00:15:55,800
،هُوا فِينغ يُو

214
00:15:56,070 --> 00:15:58,880
،تعاهدنا ألّا يُؤذي أحدنا الآخر

215
00:15:58,990 --> 00:16:00,160
،ولكن

216
00:16:00,180 --> 00:16:03,080
لماذا نكثتَ عهدكَ
وألحقتَ الأذى بعائلتي؟

217
00:16:03,090 --> 00:16:04,300
.الشيطانُ يبقى شيطانًا

218
00:16:04,780 --> 00:16:06,330
حتّى لو تواريتَ عن
،الأنظار للوقت الحاليّ

219
00:16:06,690 --> 00:16:08,690
.فستعيثُ فسادًا عاجلًا أو آجلًا

220
00:16:09,720 --> 00:16:11,020
،قتلُكَ اليوم

221
00:16:11,050 --> 00:16:14,050
سيمنحني مكانةً في
.عالم هُونغ مِينغ

222
00:16:14,420 --> 00:16:15,630
فلمَ لا أفعلُ؟

223
00:16:16,110 --> 00:16:19,270
سفكتَ الدّماء طمعًا في
!السّلطة والمكسب فحسب

224
00:16:19,280 --> 00:16:22,400
!سيأتي يومٌ تدفعُ فيه الثّمن

225
00:16:25,910 --> 00:16:26,690
،سيّد هُوا

226
00:16:26,940 --> 00:16:29,200
عددُ جُنود السّراب أكبرُ
،بكثيرٍ ممّا توقّعنا

227
00:16:29,210 --> 00:16:31,270
!علينا طلبُ الدّعم فورًا

228
00:16:33,940 --> 00:16:35,280
...هُوا فِينغ يُو، أنت

229
00:16:36,090 --> 00:16:37,470
،معذرةً يا نِينغ كُوي

230
00:16:37,720 --> 00:16:39,490
...لا بُدّ أن أكونَ أنا

231
00:16:39,600 --> 00:16:40,960
.ملكَ الجنوب

232
00:16:41,620 --> 00:16:43,440
سيُصيبكَ جزاءُ صنيعكَ
!يومًا ما

233
00:16:44,030 --> 00:16:44,880
جزاءُ صنيعي؟

234
00:16:46,280 --> 00:16:47,350
...فليأتِ

235
00:16:47,380 --> 00:16:48,530
!إذن

236
00:16:54,150 --> 00:16:55,780
،انظري يا عزيزتي

237
00:16:55,870 --> 00:16:57,570
.هذا الطّفل يُشبهني كثيرًا

238
00:16:57,600 --> 00:16:59,260
!بل عيناهُ تُشبهان عينيكِ تمامًا

239
00:16:59,270 --> 00:17:02,110
.لنُسمّه هُوا كَانغ

240
00:17:02,870 --> 00:17:05,150
،سينشأُ وافرَ الصّحة بالتّأكيد

241
00:17:05,850 --> 00:17:08,420
.ويرثُ عائلة هُوا

242
00:17:10,430 --> 00:17:11,010
.عزيزتي

243
00:17:11,780 --> 00:17:12,530
!عزيزتي

244
00:17:13,850 --> 00:17:15,050
.عزيزتي

245
00:17:16,790 --> 00:17:19,780
السيّد الصّغير مصابٌ
.بمرض هشاشة العظام

246
00:17:20,260 --> 00:17:22,920
،يبدأُ الأمر بالضّعف

247
00:17:22,940 --> 00:17:25,000
وتدريجيًا، لن يعودَ قادرًا
.على الوُقوف

248
00:17:25,430 --> 00:17:28,870
،وفي النّهاية
...حتّى التّنفس سيكونُ

249
00:17:30,420 --> 00:17:32,090
هل هُناك علاجٌ؟

250
00:17:32,440 --> 00:17:35,330
جُلّ ما أستطيعهُ أن أحافظ على
،حياته بصُعوبةٍ حتّى سنّ السّادس عشر

251
00:17:35,470 --> 00:17:36,620
،أمّا بعد ذلك

252
00:17:36,870 --> 00:17:38,480
.فمصيرهُ متروكٌ للقدر

253
00:17:39,320 --> 00:17:42,330
سفكتَ هذه الدّماء طمعًا في
!السّلطة والمكسب فحسب

254
00:17:42,340 --> 00:17:45,180
!سيأتي يومٌ تدفعُ فيه الثّمن

255
00:17:45,980 --> 00:17:49,630
سيُصيبكَ جزاءُ صنيعكَ
!يومًا ما

256
00:17:57,230 --> 00:17:57,860
،أيّها الزّعيم

257
00:17:58,750 --> 00:18:00,110
.انظُر ماذا وجدنا

258
00:18:06,610 --> 00:18:07,470
.كَانغ

259
00:18:08,770 --> 00:18:09,410
.أبي

260
00:18:09,440 --> 00:18:11,300
،تعالَ يا كَانغ
.لتلتقي بأخيكَ الأصغر

261
00:18:12,060 --> 00:18:14,180
أبي، ما اسمهُ؟

262
00:18:14,670 --> 00:18:16,400
.إنّه لا يحتاجُ اسمًا

263
00:18:18,150 --> 00:18:18,910
،أبي

264
00:18:19,230 --> 00:18:21,090
هل سأُشفى بالفِعل؟

265
00:18:22,590 --> 00:18:23,760
،ثِق بي

266
00:18:23,970 --> 00:18:25,100
.سوفَ تُشفى

267
00:18:25,700 --> 00:18:26,710
!هذا رائعٌ

268
00:18:27,410 --> 00:18:29,040
،حينها ستكونُ الدّنيا ملكًا لنا

269
00:18:29,050 --> 00:18:31,250
وسأتمكنُ أنا وأخي مِن
.الذّهاب أينما شِئنا

270
00:18:32,160 --> 00:18:34,560
،حينها ستكونُ الدّنيا ملكًا لكَ

271
00:18:35,180 --> 00:18:38,880
وستتمكّنُ مِن الذّهاب
.أينما شِئت

272
00:18:42,340 --> 00:18:44,420
.مكائدكَ قد آلت إلى العدم

273
00:18:45,840 --> 00:18:47,970
لم تكُن تُؤمن بالجزاء مِن
،جنسِ العمل آنذاك

274
00:18:48,280 --> 00:18:49,180
،أمّا الآن

275
00:18:50,220 --> 00:18:51,510
فهل تشعرُ بالنّدم؟

276
00:18:55,520 --> 00:18:57,140
مَن الّذي ألحقَ بكُم الأذى؟

277
00:18:59,160 --> 00:19:01,460
.سأُنصفكم وأُحاسبه

278
00:19:04,840 --> 00:19:05,570
.ليسَ هذا

279
00:19:06,640 --> 00:19:07,770
.ولا هذا أيضًا

280
00:19:08,130 --> 00:19:09,190
.لا بُدّ أنّ هُناك المزيد

281
00:19:09,490 --> 00:19:11,960
أين هُو؟ أين هُو؟

282
00:19:13,680 --> 00:19:14,600
!ساخنٌ جدًا

283
00:19:16,280 --> 00:19:17,200
!ساخنٌ جدًا

284
00:19:18,720 --> 00:19:19,870
.لا بُدّ أنّ هُناك المزيد

285
00:19:19,900 --> 00:19:21,890
أين هُو؟ أين هُو؟

286
00:19:28,400 --> 00:19:30,680
،تعالَ يا كَانغ
.لتلتقي بأخيكَ الأصغر

287
00:19:30,770 --> 00:19:31,970
...أنت

288
00:19:36,090 --> 00:19:38,670
لماذا هدأَ المكان فجأةً؟

289
00:19:38,680 --> 00:19:39,940
هل حدثَ خطبٌ ما؟

290
00:19:41,700 --> 00:19:43,560
مِن الأفضل أن أنزلَ
.لأُلقي نظرةً

291
00:19:44,340 --> 00:19:47,940
ألم تقُل إنّ البشر العاديّين
لا يُمكنهم كسرُ حاجز الخالدة؟

292
00:19:49,030 --> 00:19:50,300
أنا أملكُ ختمًا
!سحريًا أعطتهُ لي

293
00:19:50,310 --> 00:19:51,500
!أستطيعُ الوُلوج بالطّبع

294
00:19:51,760 --> 00:19:52,490
!لا تقلق

295
00:19:55,760 --> 00:19:57,210
...إذن

296
00:19:57,460 --> 00:19:58,730
.كُن حذرًا

297
00:20:06,030 --> 00:20:07,280
!أنـ-أنباءٌ مُفزعة

298
00:20:07,900 --> 00:20:09,500
...ثمّة خطبٌ... خطبٌ

299
00:20:10,430 --> 00:20:12,290
!خطبٌ ما قد أصابَ الخالدة

300
00:20:28,900 --> 00:20:29,630
،أيّها المُعلّم

301
00:20:35,990 --> 00:20:36,720
.تريّثوا

302
00:20:54,580 --> 00:20:55,380
...أصابها

303
00:20:55,640 --> 00:20:56,570
.مكروهٌ

304
00:21:03,790 --> 00:21:10,840
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

305
00:21:10,850 --> 00:21:19,360
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

306
00:21:21,420 --> 00:21:26,130
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

307
00:21:26,140 --> 00:21:30,770
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

308
00:21:30,780 --> 00:21:34,630
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

309
00:21:34,640 --> 00:21:39,100
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

310
00:21:39,110 --> 00:21:43,800
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

311
00:21:43,810 --> 00:21:48,500
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

312
00:21:48,510 --> 00:21:53,680
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

313
00:21:53,690 --> 00:21:57,700
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

314
00:21:57,710 --> 00:22:02,840
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

315
00:22:02,850 --> 00:22:07,310
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

316
00:22:07,320 --> 00:22:12,280
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

317
00:22:12,290 --> 00:22:16,740
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

318
00:22:21,860 --> 00:22:27,990
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟