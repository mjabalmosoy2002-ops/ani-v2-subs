1
00:00:15,330 --> 00:00:22,240
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

2
00:00:22,250 --> 00:00:29,820
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

3
00:00:29,830 --> 00:00:36,320
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

4
00:00:36,330 --> 00:00:42,540
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

5
00:00:43,290 --> 00:00:50,400
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

6
00:00:50,410 --> 00:00:58,110
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

7
00:00:58,120 --> 00:01:04,940
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

8
00:01:04,950 --> 00:01:10,530
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

9
00:01:11,370 --> 00:01:18,690
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

10
00:01:18,700 --> 00:01:25,360
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

11
00:01:25,370 --> 00:01:31,650
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

12
00:01:31,660 --> 00:01:39,000
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

13
00:01:54,300 --> 00:01:56,720
!ها نحنُ نلتقِي ثانيةً

14
00:01:58,000 --> 00:02:00,190
لم يكُن لقاؤُنا في بلدة
،لُويِي إلّا عابرًا

15
00:02:00,200 --> 00:02:02,260
.ولم أُعرّفكُم بنفسي بعد

16
00:02:06,370 --> 00:02:07,540
!هذا أنتَ إذن

17
00:02:08,030 --> 00:02:09,030
،أُدعى دُون

18
00:02:09,490 --> 00:02:11,320
.منحني بِي شِين هذا الاسم

19
00:02:11,830 --> 00:02:14,030
هل خُنتَ سيّدكَ حقًا؟

20
00:02:14,260 --> 00:02:15,140
سيّدي؟

21
00:02:15,790 --> 00:02:18,040
،نحنُ شياطين السّراب نكرهُ القُيود

22
00:02:18,460 --> 00:02:20,520
كيفَ لي أن أنصاعَ لهُ برضاي؟

23
00:02:21,290 --> 00:02:24,410
إذن تمثّلتَ في هيئة
،لُو شِياوتَان لتَستدرجني

24
00:02:24,420 --> 00:02:26,520
هل كانَ ذلك لأقضي
!على بِي شِين بدلًا منكَ؟

25
00:02:27,760 --> 00:02:30,820
،لو كانَ هلاكهُ مطلبي الوحيد
!لوجدتُ إليه سُبلًا لا تُحصى

26
00:02:31,450 --> 00:02:33,950
غيرَ أنّ مصرعهُ على
،هذا النّحو

27
00:02:34,370 --> 00:02:36,910
،كانَ يستلزمُ معاونتكِ
.أيّتها الخالدة

28
00:02:38,150 --> 00:02:41,350
راودتنِي فكرةُ الاستيلاء على جيش
،عُشب جِين تَاي التّابع لـ بِي شِين

29
00:02:42,980 --> 00:02:43,850
.ولكن يا للخسارة

30
00:02:45,370 --> 00:02:46,570
،ومع ذلك

31
00:02:47,570 --> 00:02:49,450
.نلتُ مسرّةً غير مُتوقّعةٍ

32
00:02:57,630 --> 00:02:58,370
بِي شِين؟

33
00:02:58,380 --> 00:03:00,940
رُغم أنّكما سحقتما جيش
،عُشب جِين تَاي

34
00:03:01,460 --> 00:03:03,860
فقد أبقيتما على
.أقوى جُنديّ سرابٍ

35
00:03:03,870 --> 00:03:04,870
.هذا فِعلٌ رائع بحقّ

36
00:03:05,450 --> 00:03:07,910
هل تحسبُ أنّك ستَخرجُ
مِن هُنا سالمًا؟

37
00:03:08,840 --> 00:03:11,720
،أيّتها الخالدة، لا تعجلِي
،أنصتِي إلى هذه القصّة أولًا

38
00:03:12,240 --> 00:03:14,820
فقد رواها لي ملكُ
.السّراب ذاتَ حينٍ

39
00:03:15,750 --> 00:03:18,110
في سالف الزّمن، كانَ
،هُناك متدرّبٌ شابّ مُبتدئ

40
00:03:18,120 --> 00:03:20,980
،وفي أرجاء دار شِينغ هَان
.تملّكَ جسدهُ شيطانُ سرابٍ

41
00:03:20,990 --> 00:03:22,880
لكن بفضلِ إتقانه لأُسلوب
،تناغُم العقل

42
00:03:22,890 --> 00:03:24,420
.لم يتمكّن منهُ الشّيطان بالكامل

43
00:03:26,760 --> 00:03:30,490
خدعَ الشّاب شيطان السّراب
.حتّى يصحبهُ عودةً إلى عشيرته

44
00:03:30,710 --> 00:03:33,060
كانَ يأملُ أن يعثرَ على طريقةٍ
.للتخلّص مِن شيطان السّراب

45
00:03:33,070 --> 00:03:34,130
،لكنّه اكتشفَ

46
00:03:34,290 --> 00:03:37,980
على نحوٍ مُفاجئ، أنّ
.عشيرتهُ قد أُبيدت عن آخرها

47
00:03:39,970 --> 00:03:41,240
...أيّتها الخالدة، خمّني

48
00:03:41,470 --> 00:03:43,140
ماذا جرى بعدها؟

49
00:03:45,510 --> 00:03:47,510
،جُوان جُوان
!لا تُصغِي إلى أكاذيبه

50
00:03:49,890 --> 00:03:50,750
!جُوان جُوان

51
00:03:50,760 --> 00:03:52,180
!لا تُصغِي إلى أكاذيبه

52
00:03:54,180 --> 00:03:57,440
حينما رأى رفاقهُ صرعى واحدًا
،تلو الآخر في بركٍ مِن الدّماء

53
00:03:57,450 --> 00:03:59,310
.اعتصرَ الحُزن فُؤاده

54
00:03:59,320 --> 00:04:01,370
.وثارت في نفسه ضغينةٌ جارفة

55
00:04:01,800 --> 00:04:05,190
وبشكلٍ غير مُتوقّعٍ، غدت تلك الضّغينة
.قُوتًا يُغذّي شيطان السّراب في داخله

56
00:04:05,200 --> 00:04:07,800
وفي طرفة عينٍ، هوى
.الشّاب إلى غياهبِ الظّلام

57
00:04:08,480 --> 00:04:11,510
،وهكذا وُلِد ملك السّراب

58
00:04:11,670 --> 00:04:14,460
الّذي أرعبَ اسمه قُلوب
.الأجيال لعُقودٍ طويلة

59
00:04:14,470 --> 00:04:15,290
،جُوان جُوان

60
00:04:15,910 --> 00:04:17,200
!لا تُصغِي إلى أكاذيبه

61
00:04:17,200 --> 00:04:18,950
،أيّتها الخالدة
...هل خطرَ ببالكِ يومًا

62
00:04:19,410 --> 00:04:21,980
أنّ ملكَ السّراب الّذي
،أرديتيهِ قتيلًا بيديكِ

63
00:04:21,990 --> 00:04:24,630
هُو ذاته شَاو وِي لِي
...الّذي أفنيتِ عُمركِ

64
00:04:25,020 --> 00:04:27,020
تبحثينَ عنه باستماتةٍ؟

65
00:04:27,420 --> 00:04:29,870
...أرديتُ شَاو وِي لِي

66
00:04:30,620 --> 00:04:32,150
قتيلًا بيديّ؟

67
00:04:35,770 --> 00:04:36,850
!كلا

68
00:04:36,860 --> 00:04:38,400
الّذي أردتيهِ قتيلًا
،كانَ ملكَ السّراب

69
00:04:38,400 --> 00:04:39,530
.وليس شَاو وِي لِي

70
00:04:47,480 --> 00:04:48,230
!لِي شِياو

71
00:04:48,470 --> 00:04:49,600
!لا تبرحي مكانكِ

72
00:04:51,320 --> 00:04:52,400
ما الخطب؟

73
00:04:54,290 --> 00:04:55,880
...جُوان جُوان

74
00:04:56,340 --> 00:04:59,630
لماذا تظنّينَ أنّني تركتُ
وهمَ سراب بِي يُون زُو هُنا؟

75
00:05:00,150 --> 00:05:02,250
في اللّحظة الّتي ولجتِ فيها
،إلى داخل وهم سرابها

76
00:05:02,260 --> 00:05:04,790
وأنتِ مقيّدةٌ بتعويذة
.الختم هذه

77
00:05:04,940 --> 00:05:05,940
،وأنا

78
00:05:06,430 --> 00:05:09,550
.كُنت أنتظر هذه الفُرصة

79
00:05:17,280 --> 00:05:18,240
!جُوان جُوان

80
00:05:22,230 --> 00:05:23,150
!جُوان جُوان

81
00:05:26,990 --> 00:05:28,570
!جُوان جُوان، اصمدِي

82
00:05:29,410 --> 00:05:32,480
حينها، خاضَ ملكُ السّراب معركةً
.ضدّكِ في قمّة فِينغ شُو، أيّتها الخالدة

83
00:05:32,490 --> 00:05:35,750
والجميع يعلمُ أنّه
،خسرَ في النّهاية

84
00:05:35,850 --> 00:05:39,680
وأُلقي في كهف النّار
.حتّى استحالَ رمادًا

85
00:05:40,850 --> 00:05:41,640
...ولكن

86
00:05:42,060 --> 00:05:44,790
هل مَحتهُ تلك النّيران حقًا؟

87
00:05:45,290 --> 00:05:46,320
!كلا

88
00:05:46,330 --> 00:05:49,770
.بل أبقى على جُزءٍ مِن رُوحه

89
00:05:52,630 --> 00:05:55,000
،لم تعُد قادرًا على إخفائها
أَليس كذلك؟

90
00:05:56,060 --> 00:05:58,760
،أجل
.كفاكَ كبتًا لنفسكَ

91
00:05:58,770 --> 00:06:00,680
.أطلِق عنانَ رغباتكَ

92
00:06:01,140 --> 00:06:04,040
كما جرى في قصر
.تِيان يُو قديمًا

93
00:06:04,050 --> 00:06:05,070
،لِي شِياو

94
00:06:05,730 --> 00:06:07,600
...أم أدعوكَ

95
00:06:08,460 --> 00:06:10,170
ملك السّراب؟

96
00:06:49,080 --> 00:06:49,960
...لِي

97
00:06:50,960 --> 00:06:52,750
.لِي شِياو

98
00:06:53,650 --> 00:06:55,120
.عشرونَ سنةً قد مضت

99
00:06:56,230 --> 00:06:59,720
والآن سأرثُ هذا
،الجُزء مِن الرّوح

100
00:06:59,730 --> 00:07:01,830
،لأحملَ إرادة ملك السّراب

101
00:07:01,840 --> 00:07:03,700
...وأقودَ شياطين السّراب

102
00:07:03,710 --> 00:07:06,640
لنقلِبَ هذا العالم
!رأسًا على عقبٍ مُجدّدًا

103
00:07:12,120 --> 00:07:13,370
أين هِي؟

104
00:07:14,570 --> 00:07:15,700
!هُناك تمامًا

105
00:07:16,210 --> 00:07:18,710
.أخيرًا وجدتُها

106
00:07:19,930 --> 00:07:21,530
.هذه قُوّة ملك السّراب

107
00:07:22,080 --> 00:07:25,790
...أنا
!أنا ملكُ السّراب الجديد

108
00:07:38,900 --> 00:07:39,870
!آنسة شُو

109
00:07:40,400 --> 00:07:42,110
!استيقظِي يا آنسة شُو

110
00:07:47,140 --> 00:07:48,150
!آنسة شُو

111
00:07:48,820 --> 00:07:51,430
،فقدنا وِي لِي مرّةً مِن قبل

112
00:07:51,840 --> 00:07:52,930
...فهل نقفُ الآن مكتوفي الأيدي

113
00:07:52,940 --> 00:07:55,800
ونتركُ شياطين السّراب
تختطفهُ ثانيةً؟

114
00:08:11,020 --> 00:08:12,650
،شَاو وِي لِي

115
00:08:26,710 --> 00:08:27,830
،هذه المرّة

116
00:08:28,620 --> 00:08:30,910
.لن يأخذوكَ قطعًا

117
00:08:41,720 --> 00:08:42,890
ماذا؟

118
00:08:43,660 --> 00:08:44,920
...هذا... هذا

119
00:08:45,770 --> 00:08:47,640
!محالٌ
كيف يحدثُ هذا؟

120
00:08:47,650 --> 00:08:50,130
!كلا... هذا لا يُعقل

121
00:09:12,840 --> 00:09:14,090
العنقاء العجوز؟

122
00:09:14,560 --> 00:09:15,650
لِمَ أنتَ هُنا؟

123
00:09:16,680 --> 00:09:18,290
،يا ذات الشّعر الأجعد

124
00:09:18,300 --> 00:09:21,080
ما زلتِ تجهلينَ أدبَ
!التّعامل مع مُعلّمكِ

125
00:09:22,680 --> 00:09:23,390
...هذا الصّوت

126
00:09:25,050 --> 00:09:26,320
أنت الشّخص الّذي أعاننِي
...على إبادة شيطان السّراب

127
00:09:26,330 --> 00:09:27,740
في قمّة فِينغ شُو؟

128
00:09:34,460 --> 00:09:37,970
آنذاك، كُنتَ مُقيّدًا مع شيطان
.السّراب في جسدٍ واحد

129
00:09:38,120 --> 00:09:39,590
وبعدما أثخنتكَ ذات
،الشّعر الأجعد جراحًا

130
00:09:39,600 --> 00:09:41,930
ألقيتَ بنفسكَ في كهف
.النّار عند قّمة فِينغ شُو

131
00:09:41,940 --> 00:09:44,440
في تلك اللّحظة كُنت
،ألفظُ أنفاسي الأخيرة

132
00:09:44,450 --> 00:09:45,870
،وكُنت قابعًا في قاع الحُفرة

133
00:09:45,880 --> 00:09:48,300
فسَخّرتُ آخر ما أملكُ
...مِن طاقةٍ

134
00:09:48,310 --> 00:09:50,250
كي أُعينكَ على إبادة
.ذلك الشّيطان وإحراقه

135
00:09:50,260 --> 00:09:51,580
،والآن، بعد ولادتكَ الجديدة

136
00:09:51,590 --> 00:09:54,180
لا مفرّ لك مِن خُضوعكَ لتأثير
!طاقة العنقاء الخاصّة بي

137
00:09:54,190 --> 00:09:55,740
،لذلك، يا وِي لِي

138
00:09:55,920 --> 00:09:57,650
.ينبغي أن تدعُوني بالمُعلّم أيضًا

139
00:09:58,270 --> 00:10:00,670
شُكرًا لك، يا مُعلّمي، لأنّك
.بذلتَ كُلّ ما لديكَ لمُساعدتي

140
00:10:00,760 --> 00:10:02,180
،أيّها العنقاء العجوز
...أنتَ

141
00:10:03,320 --> 00:10:05,240
،وأنتِ يا ذات الشّعر الأجعد

142
00:10:05,880 --> 00:10:07,070
!لا تزالينَ مُتهوّرةً كعادتكِ

143
00:10:07,080 --> 00:10:09,300
،تُضحّينَ برُوحكِ الخالدة
،وجسدكِ مثخنٌ بالجراح

144
00:10:09,310 --> 00:10:12,040
ثُمّ تُطلقين لهبَ النّيرفانا
!المُقدّس بطيشٍ

145
00:10:12,260 --> 00:10:15,510
.حالفكِ الحظّ هذه المرّة

146
00:10:15,980 --> 00:10:18,250
،في الماضي
...استهلكتُ كُلّ قُدراتي الرُوحيّة

147
00:10:18,260 --> 00:10:21,120
،ولم أقضِ على ملك السّراب نهائيًا

148
00:10:21,300 --> 00:10:23,250
...لكن هجمتكِ النّارية تلك

149
00:10:23,260 --> 00:10:26,100
...سحقت آخر أثرٍ

150
00:10:26,110 --> 00:10:27,830
.لرُوح ملك السّراب

151
00:10:28,410 --> 00:10:30,200
.إنّه القدر إذن

152
00:10:30,860 --> 00:10:34,240
سنواتٌ مِن التّدريب الشّاق
...منحت كُلّا منكُما

153
00:10:34,330 --> 00:10:39,330
.فُرصةً للحياة معًا مِن جديدٍ

154
00:10:43,030 --> 00:10:44,060
،حسنًا

155
00:10:44,070 --> 00:10:47,580
.الآن أستطيعُ الرّحيل بسكينةٍ

156
00:10:47,590 --> 00:10:48,370
!مُعلّمي

157
00:10:49,260 --> 00:10:52,300
هل لِي شِياو طائرٌ
رُوحيّ فائقُ الموهبة؟

158
00:10:55,200 --> 00:10:56,610
!أيّتها الحمقاء

159
00:10:59,160 --> 00:11:01,690
...إنّ ما يُنشئه العنقاء العجوز

160
00:11:01,920 --> 00:11:04,090
.لا يكونُ إلّا عنقاءَ مثله

161
00:11:27,360 --> 00:11:29,860
.أهلًا بعودتكَ يا شَاو وِي لِي

162
00:11:30,730 --> 00:11:32,570
،عُدت
.يا شُو جُوان جُوان

163
00:12:00,850 --> 00:12:01,640
،جُوان جُوان

164
00:12:01,890 --> 00:12:04,060
ألن يرجعَ لِي شِياو اليوم؟

165
00:12:05,170 --> 00:12:06,690
،تسبّب جِينغ شُون في تأخيره

166
00:12:06,700 --> 00:12:09,710
حين أخذهُ لتدوين
.موسوعة عُشب الأشباح

167
00:12:09,720 --> 00:12:11,170
!إنّه لم يتعافَ مِن جراحه بعد

168
00:12:11,180 --> 00:12:13,690
كما أنّ فوضى عالم يَاو غوَانغ
.لم تنتهِ إلّا مُنذ هُنيهةٍ

169
00:12:13,700 --> 00:12:16,630
لم أجدُ وقتًا لأُجالسه
.وأتحدّث معه

170
00:12:17,510 --> 00:12:19,240
لِمَ لا تزالين تُسمّينه لِي شِياو؟

171
00:12:19,250 --> 00:12:20,780
.إنّه الأخ شَاو بلا شكّ

172
00:12:22,180 --> 00:12:23,940
ومُنذ متى أصبحَ لكَ أخًا؟

173
00:12:23,950 --> 00:12:24,930
،لا بأس

174
00:12:25,060 --> 00:12:27,720
فهُو لا يزال يُفضّل أن
.يدعوهُ الجميع لِي شِياو

175
00:12:29,370 --> 00:12:30,920
.وأجدُ هذا مُناسبًا

176
00:12:32,250 --> 00:12:33,580
،بما أنّ لِي شِياو قد عادَ

177
00:12:33,780 --> 00:12:36,900
فلن يقضي سِي وقتهُ
.في الخارج بحثًا عنه

178
00:12:36,910 --> 00:12:39,370
ألا يجدرُ بنا إعدادُ
مأدبة عشاءٍ كبيرة؟

179
00:12:43,840 --> 00:12:45,790
مع استقرار الأوضاع
،في عالم يَاو غوَانغ

180
00:12:45,800 --> 00:12:47,730
فاضت أموالُ المكافآت
.عن الحاجة

181
00:12:47,930 --> 00:12:48,630
...لذا

182
00:12:48,930 --> 00:12:50,630
،عجبًا! هذا مدهشٌ

183
00:12:50,640 --> 00:12:52,910
حتّى أكثرُ النّاس شُحًا بدأ
!يُرخي جيوبه ويجودُ بماله

184
00:12:52,920 --> 00:12:55,310
هل يعني هذا أنّني
سأظفرُ بغُرفةٍ مُستقلّة؟

185
00:12:55,320 --> 00:12:57,570
لا أحتمل مُشاركة تشَانغ إر
.المضجع بعد اليوم

186
00:12:57,580 --> 00:12:59,060
أعياني التّعب في دوريّات
،الحراسة اليوميّة

187
00:12:59,070 --> 00:13:01,280
فهل لي بمركبٍ خاصّ؟

188
00:13:01,740 --> 00:13:03,020
،على ذكر الأمر

189
00:13:03,030 --> 00:13:05,110
.المطبخ يتطلّب إصلاحًا

190
00:13:11,930 --> 00:13:12,960
،جلالتكَ

191
00:13:12,970 --> 00:13:15,650
أحطنا بأرجاء عالم
،يَاو غوَانغ شبرًا شبرًا

192
00:13:15,660 --> 00:13:17,660
عُشب جِين تَاي قد
.تلاشى بالكامل

193
00:13:18,010 --> 00:13:21,140
كُنت أنوي نقلَ جُثمان الفتاة
،بِي يُون زُو إلى العالم السّماوي

194
00:13:21,250 --> 00:13:23,420
.لنسحقهُ بالصواعق السماويّة الرعديّة

195
00:13:23,430 --> 00:13:26,290
بيدَ أنّ اللّورد جِينغ شُون
،سبقنِي إليه

196
00:13:26,380 --> 00:13:28,420
.ورّد جُثمانها إلى ذويها

197
00:13:28,950 --> 00:13:29,930
،أيّها اللّورد جِينغ شُون

198
00:13:30,230 --> 00:13:33,670
لا يصحّ أن تنحازَ إليها لمُجرّد
...أنّ أخاها الأكبر بِي يُون جيَان

199
00:13:33,680 --> 00:13:35,170
!هُو تلميذكَ

200
00:13:35,180 --> 00:13:36,020
،جلالتكَ

201
00:13:36,280 --> 00:13:38,440
،سلكتُ نهجَ لِي شِياو

202
00:13:38,450 --> 00:13:42,170
فانتزعتُ جذر عُشب جِين تَاي
.مِن جسد بِي يُون زُو كُلّيًا

203
00:13:42,180 --> 00:13:43,130
...وأضمنُ لكَ

204
00:13:43,140 --> 00:13:44,960
أنّه لن تكونَ هُناك
.مشاكل مُستقبلًا

205
00:13:45,080 --> 00:13:46,800
،كانت رُوحًا بائسةً بالفِعل

206
00:13:46,810 --> 00:13:48,220
،دعوها تَرتح في سلامٍ

207
00:13:48,230 --> 00:13:49,860
ولتُحي عائلتها ذِكراها
،مع كُلّ موسمٍ

208
00:13:49,870 --> 00:13:51,330
.فإنّ في ذلك لثَوابًا

209
00:13:51,930 --> 00:13:53,190
،وفيما يخصّ بِي يُون جيَان

210
00:13:54,580 --> 00:13:57,180
.فقد جرّدَ نفسهُ مِن رُتبة الخُلود

211
00:13:57,190 --> 00:13:58,260
،وأنا أبتهلُ إلى جلالتكَ

212
00:13:58,270 --> 00:14:00,080
،أن تشملهُ برحمتكَ
،تقديرًا لعُقودٍ مِن وفائه

213
00:14:00,090 --> 00:14:01,270
...وجُهده الصّادق

214
00:14:01,280 --> 00:14:03,080
،لإعلاء شأن السّماء

215
00:14:03,090 --> 00:14:04,800
...ولجهله التّام

216
00:14:04,810 --> 00:14:06,210
،بما اقترفهُ والده

217
00:14:06,630 --> 00:14:07,930
.أن تُظهرَ اللّين معه

218
00:14:08,590 --> 00:14:10,880
حظِي ابنُ بِي شِين
...بمقام الخالدين

219
00:14:10,890 --> 00:14:12,610
،والتحقَ بمنصّة سِيُون

220
00:14:12,620 --> 00:14:14,130
...جزاءً لما قدّمه والدهُ مِن إنجازاتٍ

221
00:14:14,140 --> 00:14:15,970
.في حرب أرض السّراب

222
00:14:15,980 --> 00:14:18,210
والآن، بعد أن ارتكبَ
،والدهُ جريمةً نكراء

223
00:14:18,220 --> 00:14:19,730
،فإنّ إبطال مقام الخُلود لابنه

224
00:14:19,740 --> 00:14:21,320
.هُو الإجراء البديهيّ

225
00:14:21,790 --> 00:14:23,870
لكن ما أخشاه حقًا، أن يكونَ
،بِي شِين قد أعدّ خُطّةً سريّة

226
00:14:24,330 --> 00:14:26,580
وأورثَ ابنهُ بقايا مِن
،ذلك العُشب الشيطانيّ

227
00:14:26,930 --> 00:14:28,220
...فعندئذٍ سيكونُ

228
00:14:28,330 --> 00:14:29,790
،لذلك
...كانَ قرارُ جلالته حكيمًا

229
00:14:30,120 --> 00:14:31,730
حينما كلّف لِي شِياو
...بتدوين كُلّ أسرار

230
00:14:31,740 --> 00:14:33,370
!عُشب الأشباح في موسوعةٍ

231
00:14:33,870 --> 00:14:34,990
،فبفضلِها

232
00:14:35,000 --> 00:14:36,880
سنَنتقلُ مِن موقف
،الدّفاع إلى الهُجوم

233
00:14:37,030 --> 00:14:40,630
ولن تقدرَ قُوّتهم على تهديد
.العالم السّماوي بعد اليوم

234
00:14:40,640 --> 00:14:42,220
لكن أصل لِي شِياو
،يكتنفهُ الغُموض

235
00:14:42,230 --> 00:14:44,810
فما أدرانا أنّه أفضى
بكُلّ الأسرار؟

236
00:14:45,420 --> 00:14:47,060
...ماذا لو كانَ يكتبُ أكاذيبَ

237
00:14:47,070 --> 00:14:48,280
!هذا يكفِي

238
00:14:48,660 --> 00:14:51,530
ما الأخبار عن موسوعة
عُشب الأشباح؟

239
00:14:51,540 --> 00:14:52,890
.كُلّ شيءٍ يسيرُ بسلاسةٍ

240
00:14:52,900 --> 00:14:54,500
.سوف تنتهِي قريبًا

241
00:15:04,870 --> 00:15:06,460
.مُعلّمي، ها قد عُدتَ

242
00:15:09,040 --> 00:15:10,460
كيف حالُ لِي شِياو؟

243
00:15:11,010 --> 00:15:13,030
كلّفتُ رجالًا لحثّه على
،العمل ليلًا ونهارًا

244
00:15:13,040 --> 00:15:15,330
ليفرغَ مِن مُهمّته
.في غُضون أيّامٍ

245
00:15:16,930 --> 00:15:17,790
...كما جاءنا

246
00:15:17,800 --> 00:15:19,380
،السيّد قِطّ مِن قصر بَان يُوي

247
00:15:19,390 --> 00:15:21,380
مُستفسرًا عن موعد
.عودة لِي شِياو

248
00:15:21,530 --> 00:15:22,970
،حتّى إنّه أهدانا جرّةً مِن النّبيذ

249
00:15:22,980 --> 00:15:23,780
...كتعبيرٍ عن الشّكر

250
00:15:23,790 --> 00:15:26,350
لمعونتكَ الكبيرة في
.عالم يَاو غوَانغ

251
00:15:26,750 --> 00:15:28,450
،إنّ السيّد قِطّ ذاك لبِقٌ بحقّ

252
00:15:28,460 --> 00:15:30,520
إذ يعرفُ كيفَ يُحضر هديّةً
،للتّعبير عن الامتنان

253
00:15:30,950 --> 00:15:32,110
.على عكس سيّدته

254
00:15:32,120 --> 00:15:35,200
بعد كُلّ الجُهد الّذي بذلتهُ
،في شُؤون لِي شِياو

255
00:15:35,210 --> 00:15:37,430
!لم تنطِق حتّى بكلمة شُكرٍ

256
00:16:13,720 --> 00:16:16,690
مِن المُؤسف أنّه يجهلُ
.مدى دقّتكَ في انتقاء النّبيذ

257
00:16:16,700 --> 00:16:18,830
.فالأصنافُ العاديّة لن تروقَ لك

258
00:16:22,260 --> 00:16:25,470
!المُـ-المُعلّم تبسّم صدقًا

259
00:16:27,840 --> 00:16:28,530
.ضع الجرّة جانبًا

260
00:16:28,540 --> 00:16:29,450
.أمرُكَ

261
00:16:32,980 --> 00:16:34,390
،مُـ-مُعلّمي

262
00:16:34,690 --> 00:16:36,900
هل يُمكن لـ يُون جيَان
أن يعودَ يومًا؟

263
00:16:39,580 --> 00:16:41,120
.تعرّض للظّلم

264
00:16:41,440 --> 00:16:43,140
لم يكُن يعلمُ شيئًا
،على الإطلاق

265
00:16:43,150 --> 00:16:44,700
ومع ذلك يتعيّنُ عليه
.تحمّل اللّوم

266
00:16:45,640 --> 00:16:47,930
كيف يُمكنه مواجهة العالم مُجدّدًا؟

267
00:17:23,060 --> 00:17:24,550
،مرّت أيّامٌ كثيرة

268
00:17:24,560 --> 00:17:25,920
فلماذا لم يَرجع بعد؟

269
00:17:26,060 --> 00:17:28,120
.كما أنّني ممنوعةٌ مِن زيارته

270
00:17:28,130 --> 00:17:30,290
.جلالتهُ بغيضٌ حقًا -
!معشرَ النّاس -

271
00:17:30,300 --> 00:17:34,210
هذا التّرياق قد أعدّه
!الصيدلانيّ الشّهير لِي

272
00:17:34,220 --> 00:17:35,300
!فيه شفاءٌ مِن كُلّ داءٍ

273
00:17:35,310 --> 00:17:37,320
لا نملكُ اليوم سوى مئة
!قارورةٍ، فالكميّة محدودةٌ

274
00:17:37,330 --> 00:17:39,190
!لا تُفوّتوا الفُرصة

275
00:17:39,200 --> 00:17:40,700
!أقبِلوا لتَروا بأنفسكُم

276
00:17:42,170 --> 00:17:43,120
،يا سيّدة

277
00:17:43,130 --> 00:17:44,720
هل سمعتِ بالصيدلانيّ لِي؟

278
00:17:44,730 --> 00:17:45,560
،أجل

279
00:17:45,830 --> 00:17:48,700
هُو نفسهُ الّذي قضى على الوباء
.مُنذ مُدّةٍ ليست ببعيدةٍ

280
00:17:48,710 --> 00:17:49,780
هل مِن المعقول أن
يكونَ لِي شِياو؟

281
00:17:49,790 --> 00:17:52,280
!هذا التّرياق مِن صنيعه -
!لِي شِياو -

282
00:17:52,290 --> 00:17:54,400
!لجسدٍ قويّ وبلا أمراضٍ -
متى رجعتَ؟ -

283
00:17:54,410 --> 00:17:55,930
ولماذا لم تُبلّغني بذلك؟

284
00:17:55,940 --> 00:17:57,810
يا آنسة، هل جئتِ
...أنتِ أيضًا لشراء

285
00:18:00,370 --> 00:18:06,220
!النّجدة

286
00:18:06,500 --> 00:18:11,300
صرحُ يِيشَان التعليميّ

287
00:18:21,620 --> 00:18:24,480
صرحُ يِيشَان التعليميّ

288
00:18:27,980 --> 00:18:30,010
.تحيّاتي، يا سيّدي الشّاب

289
00:18:30,020 --> 00:18:32,320
،تزوّجني فحسب -
أيّتها الشّابة، ماذا تفعلينَ هُنا وحيدةً في مُنتصف اللّيل؟ -

290
00:18:32,330 --> 00:18:34,720
!وبذلك سنُصبح عائلةً -
مِن أينَ تعلّمتِ هذا الهُراء؟ -

291
00:18:34,730 --> 00:18:38,110
!خُلق البشر والشّياطين، وبينهم صدعٌ كبير -
.ظننتُ أنّك نسيتَني -

292
00:18:40,700 --> 00:18:42,580
!لا تترُكيني وحدي مُجدّدًا

293
00:18:49,010 --> 00:18:50,710
،أيّتها الشّابة
...ماذا تفعلينَ هُنا

294
00:18:50,720 --> 00:18:52,490
وحيدةً في مُنتصف اللّيل؟

295
00:19:02,640 --> 00:19:03,880
،أيّها الطّائر السّخيف

296
00:19:03,890 --> 00:19:05,700
.إذن ما زلتَ تعرفُ دربَ العودة

297
00:19:06,150 --> 00:19:06,800
...آسفٌ

298
00:19:06,810 --> 00:19:08,240
.لأنّني جعلتكِ تنتظرينَ

299
00:19:09,920 --> 00:19:11,200
،أنصِت

300
00:19:11,210 --> 00:19:13,000
ممنوعٌ عليكَ الذّهاب إلى
.أيّ مكانٍ هذه الأيّام

301
00:19:13,010 --> 00:19:15,250
،الزم قصرَ بَان يُوي
.وتصرّف بأدبٍ

302
00:19:15,260 --> 00:19:16,800
...أخبرنِي بما جرى معكَ

303
00:19:16,910 --> 00:19:18,700
.خلال تلك السّنوات

304
00:19:44,920 --> 00:19:51,950
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

305
00:19:51,960 --> 00:20:00,580
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

306
00:20:02,620 --> 00:20:07,320
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

307
00:20:07,330 --> 00:20:11,990
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

308
00:20:12,000 --> 00:20:15,820
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

309
00:20:15,830 --> 00:20:20,320
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

310
00:20:20,330 --> 00:20:24,990
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

311
00:20:25,000 --> 00:20:29,690
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

312
00:20:29,700 --> 00:20:34,860
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

313
00:20:34,870 --> 00:20:38,900
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

314
00:20:38,910 --> 00:20:44,030
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

315
00:20:44,040 --> 00:20:48,530
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

316
00:20:48,540 --> 00:20:53,490
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

317
00:20:53,500 --> 00:20:57,940
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

318
00:21:03,070 --> 00:21:08,200
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟