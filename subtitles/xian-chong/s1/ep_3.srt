175
00:13:38,900 --> 00:13:41,140
،إنّهم يتظاهرونَ دائمًا بالفضيلة

176
00:13:41,590 --> 00:13:43,320
.لكنّهم فاسدونَ حتّى النّخاع

177
00:13:45,350 --> 00:13:46,610
.احبسُوه في مخزن الحطب

178
00:13:46,620 --> 00:13:48,840
...لن يخرجَ حتّى يعترفَ بمكان

179
00:13:48,850 --> 00:13:50,050
.جُثّة تسَاي تشِينغ

180
00:13:50,100 --> 00:13:52,140
،تشَانغ شُون، تشَاو يِي
!يا رِفاق

181
00:13:52,180 --> 00:13:53,410
!أرجوكُما أخرِجاني

182
00:13:53,430 --> 00:13:54,740
!تلك الخادمة لفّقت لي التّهمة

183
00:13:55,680 --> 00:13:57,360
.لا بُدّ أنّ تسَاي تشِينغ في خطرٍ

184
00:13:57,390 --> 00:13:58,800
!يجبُ أن أجِدها

185
00:13:58,820 --> 00:14:00,350
!عمّي شُو! عمّي شُو

186
00:14:00,370 --> 00:14:01,790
!اتُّهِمت زُورًا

187
00:14:01,800 --> 00:14:03,730
.نشأتُ وأنا أعمل في حديقة هُواجِين

188
00:14:03,810 --> 00:14:04,880
.أنتم جميعًا تعرفون أيّ شخصٍ أنا

189
00:14:04,890 --> 00:14:06,880
!لم أفعلها يا عمّي شُو

190
00:14:07,410 --> 00:14:10,880
!أرجوكُم أخرِجوني -
...لم ينفكّوا يتحدّثون عن الأُخوّة -

191
00:14:10,910 --> 00:14:12,780
،ولكن عندما يمسّك الضّر

192
00:14:12,910 --> 00:14:14,970
مَن منهم سيقفُ فعلًا إلى جانبكَ؟

193
00:14:14,980 --> 00:14:16,490
!وِي

194
00:14:29,140 --> 00:14:30,550
.تسَاي تشِينغ المِسكينة

195
00:14:30,900 --> 00:14:32,360
،لن تتمكّن مُن مُحاربة الوحوش

196
00:14:32,600 --> 00:14:34,250
.إلّا إذا أصبحت هِي وحشًا مثلهم

197
00:14:46,530 --> 00:14:47,790
.أخيرًا، وصلت

198
00:15:13,630 --> 00:15:14,830
ما الّذي أخّركَ كُلّ هذا الوقت؟

199
00:15:15,830 --> 00:15:17,690
أذكرُ أنّ إحداهنّ قالت
...في المرّة السّابقة

200
00:15:17,750 --> 00:15:20,210
إنّها إن طلبت مُساعدتي
...مُجدّدًا، فستَكون

201
00:15:20,220 --> 00:15:21,220
ماذا كان قولُها؟

202
00:15:23,240 --> 00:15:25,700
،إن طلبتُ مُساعدتكَ ثانيةً"
"!فأنا كلبةٌ مُجعّدة الشّعر

203
00:15:25,710 --> 00:15:26,450
...أنت

204
00:15:27,620 --> 00:15:29,040
.اهدئِي أيّتها الخالدة

205
00:15:29,050 --> 00:15:30,370
،بمُجرّد أن تلقّى سيّدي رسالتكِ

206
00:15:30,380 --> 00:15:31,640
.هَرعنا إلى هُنا على الفور

207
00:15:32,830 --> 00:15:34,350
ومَن تكون أنت؟

208
00:15:35,450 --> 00:15:36,560
،بكُلّ احترامٍ أيّتها الخالدة

209
00:15:36,570 --> 00:15:37,970
،أنا بِي يُونجيانغ

210
00:15:38,280 --> 00:15:41,210
تلميذٌ لدى اللّورد جِينغ شُون
.مُنذ خمس سنواتٍ

211
00:15:41,510 --> 00:15:43,240
،أيّها الشّاب
...ليس مِن اليسير عليكَ

212
00:15:43,490 --> 00:15:45,490
أن تكون عالقًا مع سيّدٍ
.بمثل هذه القسوة

213
00:15:46,560 --> 00:15:49,340
،جِينغ شُون، إلهُ الحرب
،رُبّما امتلكَ الشّهرة فيما مضى

214
00:15:49,350 --> 00:15:52,530
لكنّه الآن مُجرّد خالدٍ صغير
.خامل ولا سُلطة له

215
00:15:52,560 --> 00:15:54,960
لماذا تُهدر وقتكَ مع شخصٍ مثله؟

216
00:15:55,540 --> 00:15:57,520
يبدو أنّ موظّفًا صغيرًا مثلي
،مسؤولًا عن الغُيوم

217
00:15:57,530 --> 00:16:00,280
،لا جدوى منهُ هُنا
.سأَستأذنُ بالانصراف

218
00:16:01,860 --> 00:16:02,760
.سيّدي

219
00:16:03,620 --> 00:16:05,100
.إنّكِ تُمازحينَنا أيّتها الخالدة

220
00:16:05,900 --> 00:16:07,610
سيّدي اختارَ الخدمة في
...قِسم الغُيوم

221
00:16:07,620 --> 00:16:09,550
.لأنّه لا يرغبُ في السّلطة

222
00:16:09,720 --> 00:16:12,190
أَلم تهبِطي أنتِ أيضاً
...إلى عالم البشر

223
00:16:12,200 --> 00:16:14,590
هربًا مِن فوضى البَلاط السماويّ؟

224
00:16:14,920 --> 00:16:16,170
،وبالتّالي

225
00:16:16,200 --> 00:16:18,800
.أنتِ وسيّدي مُتشابهان في الطّباع

226
00:16:18,990 --> 00:16:20,450
لا عجبَ أنّكما كُنتما
...الثّنائي الأكثر انسجامًا

227
00:16:20,460 --> 00:16:22,520
.خلال معركة أرض السّراب

228
00:16:25,270 --> 00:16:28,470
هل لي أن أسألَ ما الأمر المُلحّ
الّذي دفعكِ لطلب سيّدي؟

229
00:16:29,370 --> 00:16:30,090
...ظهرَ عُشب الأشباح

230
00:16:30,380 --> 00:16:31,310
.مِن جديدٍ

231
00:16:38,430 --> 00:16:42,230
عُشب الأشباح هذا لم يُحوّل
.الجُثث بالكامل إلى جُنود سرابٍ بعد

232
00:16:42,240 --> 00:16:44,020
.يجب أن نجدَ التّرياق بسُرعةٍ

233
00:16:44,030 --> 00:16:46,960
إذا أصبحت جُثث المدينة
...بأكملها جُنود سرابٍ

234
00:16:47,100 --> 00:16:49,240
.فستَكون العواقب كارثيّةً

235
00:16:49,250 --> 00:16:50,910
لكن هُناك أنواعًا عديدةً
،مِن عُشب الأشباح

236
00:16:50,920 --> 00:16:52,580
.ولكُلّ منها علاجٌ مُختلف

237
00:16:52,630 --> 00:16:54,310
،لم أسمع بهذا النّوع مِن قبل

238
00:16:54,320 --> 00:16:55,990
".عُشب سمّاعة الأذن"

239
00:16:56,010 --> 00:16:58,210
كيف لنا أن نجدَ التّرياق؟

240
00:17:01,870 --> 00:17:03,670
،كُرة الفحم الصّغيرة
ما الخَطب؟

241
00:17:05,790 --> 00:17:07,110
إلى أين تأخُذنا؟

242
00:17:08,990 --> 00:17:10,390
،كُنت أَنوي السّؤال

243
00:17:10,670 --> 00:17:11,490
...ما هذا

244
00:17:12,060 --> 00:17:12,940
الشّيء؟

245
00:17:14,520 --> 00:17:15,560
.حيوانٌ أليف جديد

246
00:17:16,180 --> 00:17:16,910
لطيفٌ، أَليس كذلك؟

247
00:17:22,570 --> 00:17:24,060
ما اللّطيف فيه؟

248
00:17:24,540 --> 00:17:26,280
!كُرة الفحم الصّغيرة، تمهّل

249
00:17:37,740 --> 00:17:40,000
،رأيتُ هذا المكان مِن قبل
.في طيفِ سراب تسَاي تشِينغ

250
00:17:40,010 --> 00:17:41,610
.هذا هُو المكان الّذي دُفنت فيه

251
00:17:41,900 --> 00:17:42,850
...إذن، لا بُدّ أنّ هذه

252
00:17:42,870 --> 00:17:45,070
هِي النّبتة الأُمّ
.لـ عُشب سمّاعة الأذن

253
00:17:45,420 --> 00:17:47,820
،كُرة الفحم الصّغيرة
عمّ تبحث؟

254
00:17:55,130 --> 00:17:55,920
ما هذه؟

255
00:18:05,910 --> 00:18:08,030
،كُرة الفحم الصّغيرة
!أنت مذهلٌ

256
00:18:12,240 --> 00:18:13,570
ما حقيقتكَ؟

257
00:18:13,980 --> 00:18:16,420
كيف تعرفُ تِرياق عُشب سمّاعة الأذن؟

258
00:18:16,430 --> 00:18:18,510
،إنّه طائرٌ رُوحانيّ
.وُلِد بمواهب استثنائيّةٍ

259
00:18:18,520 --> 00:18:20,180
ما الدّاعي لهذا الضّجيج؟

260
00:18:20,740 --> 00:18:21,370
،تِيان كوَان

261
00:18:22,330 --> 00:18:25,140
يجب أن تُدرِكي ما يعنيه امتلاكُ
.القُدرة على علاج سُمّ عُشب الأشباح

262
00:18:25,150 --> 00:18:26,530
...حاولنا بشتّى الطّرق

263
00:18:26,560 --> 00:18:28,720
جمعَ معلوماتٍ عن عُشب
.الأشباح وفشِلنا

264
00:18:28,730 --> 00:18:31,040
فكيف لطائرٍ غرّ أن يعرف؟

265
00:18:31,470 --> 00:18:33,870
هل يُمكن أن تكون مكيدةً
مِن شيطان السّراب؟

266
00:18:34,380 --> 00:18:36,310
،لو كان حليفًا لشيطان السّراب

267
00:18:36,490 --> 00:18:38,470
.لما خاطرَ بحياته لإنقاذي

268
00:18:38,480 --> 00:18:39,390
.أنا أثقُ به

269
00:18:41,390 --> 00:18:42,190
،وعلاوةً على ذلك

270
00:18:42,610 --> 00:18:44,300
.وَسمتُه بختمي الخاصّ

271
00:18:44,310 --> 00:18:46,230
إذا حدث أيّ شيءٍ، فإنّ قصر
.بَانيُوي يتحمّل المسؤوليّة

272
00:18:46,240 --> 00:18:46,880
...أنتِ

273
00:18:53,910 --> 00:18:54,860
!وِينيُوي

274
00:19:19,300 --> 00:19:21,700
،هذا خطيرٌ للغاية
.تعاملي معه بحكمةٍ

275
00:19:22,920 --> 00:19:24,820
لديّ رفاقٌ قُدامى في
.كتيبة القوس الإلهيّة

276
00:19:24,830 --> 00:19:27,110
.خُذ رمزي واذهب لطلبِ التّعزيزات

277
00:19:27,120 --> 00:19:28,050
.سأَسبقكَ إلى هُناك

278
00:19:28,890 --> 00:19:30,120
...سيّدي

279
00:19:38,300 --> 00:19:40,320
،بمُجرّد رشّ بعض السّكر في الماء

280
00:19:40,330 --> 00:19:41,440
تمكّنت هذه الخُنفساء
...طويلة القُرون

281
00:19:43,860 --> 00:19:46,400
،أيّتها الخالدة
!إنّ حيوانكِ السّماوي مذهلٌ

282
00:19:48,140 --> 00:19:49,050
.لا بأس به

283
00:19:50,470 --> 00:19:52,590
أرسِل شخصًا معه التّرياق
.إلى قرية شَانغشُوي

284
00:19:52,600 --> 00:19:55,410
فقد أُصيبَ بعض القرويّين هُناك
.بـ عُشب سمّاعة الأذن أيضًا

285
00:19:55,420 --> 00:19:56,720
.حاضرٌ، أيّتها الخالدة

286
00:20:02,620 --> 00:20:04,510
.هذا مؤلمٌ... مؤلمٌ جدًا

287
00:20:17,220 --> 00:20:18,290
.ليَرقدُوا بسلامٍ

288
00:20:18,630 --> 00:20:20,290
ولماذا يرقدُون في سلامٍ؟

289
00:20:20,790 --> 00:20:22,390
.نالوا ما استحقّوه

290
00:20:23,380 --> 00:20:25,630
فُقِدت أرواحٌ بريئة لا حصرَ لها
.في هذه بلدة

291
00:20:25,640 --> 00:20:27,100
هل استحقّوا ذلك أيضًا؟

292
00:20:27,370 --> 00:20:28,630
،قُلوب البشر قاسيةٌ

293
00:20:28,920 --> 00:20:30,500
.لم يكُن أحدٌ منهم بريئًا

294
00:20:30,510 --> 00:20:32,440
إذن، ماذا عن والدة تسَاي تشِينغ؟

295
00:20:33,900 --> 00:20:35,960
،مِن بين كُلّ هذه الأعشاب
...لا بُدّ أنّ

296
00:20:36,450 --> 00:20:38,340
.واحدةً منها مغروسةٌ في جُثّتها

297
00:20:39,900 --> 00:20:41,510
.كلا، توقّفي عن الكلام

298
00:20:41,530 --> 00:20:43,630
،كُنتَ تعلم
،كُنتَ تعلم دائمًا

299
00:20:44,040 --> 00:20:44,940
...لكنّك لم تجرؤ

300
00:20:45,180 --> 00:20:46,440
.على مُواجهة الحقيقة فحسب

301
00:20:47,590 --> 00:20:49,480
.كلا، أنتِ تكذِبين

302
00:20:49,930 --> 00:20:51,210
.تسَاي تشِينغ لن تفعل ذلك

303
00:20:51,220 --> 00:20:54,180
...تسَاي تشِينغ... عُودي

304
00:20:54,260 --> 00:20:56,140
.انتقمنا لكِ

305
00:20:56,170 --> 00:20:58,110
...أرجوكِ عُودي الآن

306
00:20:59,920 --> 00:21:02,580
روحٌ بائسة أُخرى استغلّها
.شيطان السّراب

307
00:21:03,730 --> 00:21:06,930
لا يرى العالم إلّا الكوارث
.الّتي يجلبها شياطين السّراب

308
00:21:06,940 --> 00:21:08,400
...لكنّهم لا يعلمونَ

309
00:21:08,900 --> 00:21:11,760
أنّ المصدر الحقيقيّ للكارثة
.يقبعُ في قلب البشر

310
00:21:20,580 --> 00:21:27,490
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

311
00:21:27,640 --> 00:21:36,150
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

312
00:21:38,030 --> 00:21:42,180
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

313
00:21:42,930 --> 00:21:45,980
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

314
00:21:47,460 --> 00:21:51,320
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

315
00:21:51,430 --> 00:21:55,340
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

316
00:21:55,710 --> 00:22:00,410
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

317
00:22:00,430 --> 00:22:04,830
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

318
00:22:05,160 --> 00:22:10,300
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

319
00:22:10,480 --> 00:22:13,980
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

320
00:22:14,500 --> 00:22:19,500
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

321
00:22:19,530 --> 00:22:24,000
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

322
00:22:24,020 --> 00:22:28,990
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

323
00:22:29,020 --> 00:22:33,400
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

324
00:22:38,650 --> 00:22:44,030
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟