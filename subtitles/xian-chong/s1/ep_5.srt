1
00:00:28,160 --> 00:00:30,300
.شـ-شُكرًا لك يا سيّدي

2
00:00:37,990 --> 00:00:44,980
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

3
00:00:44,990 --> 00:00:52,720
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

4
00:00:52,730 --> 00:00:59,110
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

5
00:00:59,120 --> 00:01:04,500
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

6
00:01:06,150 --> 00:01:13,240
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

7
00:01:13,250 --> 00:01:20,980
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

8
00:01:20,990 --> 00:01:27,740
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

9
00:01:27,750 --> 00:01:33,140
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

10
00:01:34,210 --> 00:01:41,520
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

11
00:01:41,530 --> 00:01:48,240
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

12
00:01:48,250 --> 00:01:54,490
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

13
00:01:54,500 --> 00:02:01,370
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

14
00:02:16,230 --> 00:02:20,370
،في معبدٍ مُتهالك غارِق في العتمة

15
00:02:20,880 --> 00:02:23,980
.أشعلت الشّابة شمعةً

16
00:02:25,290 --> 00:02:25,980
،وفجأةً

17
00:02:27,030 --> 00:02:28,210
.انطفأ اللّهب

18
00:02:28,820 --> 00:02:30,850
،أشعلتها مُجدّدًا

19
00:02:33,510 --> 00:02:35,910
.لكن اللّهب انطفأ ثانيةً

20
00:02:36,850 --> 00:02:38,470
،حاولت مرارًا وتكرارًا إشعالها

21
00:02:38,480 --> 00:02:40,680
.وفي كُلّ مرةٍ كان ينطفِئ

22
00:02:42,570 --> 00:02:45,180
.وأخيرًا، استقرّ اللّهب

23
00:02:45,750 --> 00:02:48,250
.اقتربت بحذرٍ مِن الجدار

24
00:02:48,860 --> 00:02:51,810
في البداية، لم يَبدُ أنّ هُناك
...شيئًا، ولكن مَن كان ليَظنّ

25
00:02:51,820 --> 00:02:54,470
،على ذلك الجدار
...كان هُناك

26
00:02:57,150 --> 00:02:58,000
ما الأمر؟

27
00:02:58,090 --> 00:02:59,370
.هُناك... هُناك

28
00:03:10,710 --> 00:03:11,540
،جُوان جُوان

29
00:03:11,560 --> 00:03:14,870
هل هذا... كُرة الفحم الصّغيرة؟

30
00:03:15,670 --> 00:03:19,220
كُرة الفحم الصّغيرة، لم أكُن
!أعلم أنّك يُمكن أن تكبرَ هكذا

31
00:03:19,250 --> 00:03:20,570
.لديه قدراتٌ أُخرى تتجاوز ذلك

32
00:03:27,620 --> 00:03:29,480
.مرحبًا بالجميع، أنا لِي شِياو

33
00:03:35,720 --> 00:03:38,880
أنت... كُنت مُجرّد فرخٍ
.لا يملكُ أيّ سحرٍ تقريبًا

34
00:03:39,610 --> 00:03:42,410
كيف تحوّلتَ مُباشرةً إلى
رجلٍ بالغ؟

35
00:03:42,680 --> 00:03:45,070
هل سكبتُ الكثير مِن الطّاقة
الرُوحيّة فيه؟

36
00:03:46,020 --> 00:03:48,060
!أعيدُوا لي كتكُوتِي الصّغير اللّطيف

37
00:03:48,090 --> 00:03:50,490
ما الرّائع في كونِه كتكُوتًا
على أيّ حالٍ؟

38
00:03:57,940 --> 00:03:58,840
!سِي

39
00:03:59,070 --> 00:04:02,420
!سيّدتي

40
00:04:20,950 --> 00:04:23,820
،فهمت، مرّ عامٌ آخر
.ولا شيءَ بعد

41
00:04:24,000 --> 00:04:25,840
،سيّدتي
.أرجوكِ لا تفقِدي الأمل

42
00:04:25,850 --> 00:04:26,890
.لن أستسلِم

43
00:04:27,120 --> 00:04:28,320
،أينما كانَ مكانُه

44
00:04:28,360 --> 00:04:30,160
.سأُعيد السيّد شَاو

45
00:04:32,260 --> 00:04:33,240
.عمِلتَ بجدٍ

46
00:04:33,250 --> 00:04:34,740
.ابقَ لبضعة أيّامٍ إضافيّة

47
00:04:34,750 --> 00:04:35,950
.نل قسطًا مِن الرّاحة

48
00:04:44,790 --> 00:04:45,850
ماذا تفعل؟

49
00:04:45,880 --> 00:04:47,320
،إن كانَ لديكَ ما تقوله
.قُله فحسب

50
00:04:47,330 --> 00:04:48,510
.لا داعِي للاقتراب منها هكذا

51
00:04:48,520 --> 00:04:52,040
وافدٌ جديد؟ أُسلوبكَ ينمّ
.عن غطرسةٍ واضحة

52
00:05:00,520 --> 00:05:03,380
مهرجان مُنتصف الخريف
.هذا العام حيويٌّ بالفِعل

53
00:05:04,470 --> 00:05:05,080
.صحيحٌ

54
00:05:25,980 --> 00:05:27,830
...جُوان جُوان، هذه

55
00:05:27,860 --> 00:05:30,340
عاد العاهل ليُمارس دورَ
،الخطّاب بطيشٍ

56
00:05:30,350 --> 00:05:35,080
...قطفتُ زُهور ملكة اللّيل كتعويضٍ
لا ضيرَ في هذا، أَليس كذلك؟

57
00:05:59,280 --> 00:05:59,870
.تفضّلي

58
00:06:14,020 --> 00:06:14,710
.شُكرًا

59
00:06:27,720 --> 00:06:28,970
،جُوان جُوان

60
00:06:29,210 --> 00:06:31,230
تعالي ولقّني هذا الأرنب
!الغبيّ درسًا

61
00:06:31,240 --> 00:06:32,860
!أكلَ الزّهور

62
00:06:33,850 --> 00:06:35,110
.مذاقُها ليس جيّدًا

63
00:06:56,480 --> 00:06:58,380
...سيّدي، أرجوكَ

64
00:06:58,480 --> 00:07:00,260
.أرجوكَ اعفُ عنّي

65
00:07:00,290 --> 00:07:03,460
أُمّي لا تزالُ في المنزل
!تنتظرُ دواءها

66
00:07:03,480 --> 00:07:06,290
...سيّدي، أرجوكَ

67
00:08:34,740 --> 00:08:35,580
.جُوان جُوان

68
00:08:43,910 --> 00:08:45,000
.أنا آسفةٌ

69
00:08:45,030 --> 00:08:47,510
.لم أعتَد وجهكَ بعد

70
00:08:52,130 --> 00:08:53,390
إلى أين نحن ذاهِبان الآن؟

71
00:08:54,730 --> 00:08:56,660
.يقعُ معبد إله الأرض في الأمام

72
00:08:56,850 --> 00:08:59,310
.وأنا حارسةُ الجنوب

73
00:08:59,900 --> 00:09:01,840
إنّ زيارة هذه الأماكن للتعرّف
...على مشقّات النّاس

74
00:09:01,850 --> 00:09:02,880
.جزءٌ مِن واجبي

75
00:09:04,370 --> 00:09:07,010
بالمُناسبة، ماذا كُنت تفعل
في الحديقة ليلةَ أمس؟

76
00:09:07,020 --> 00:09:07,880
.أيّتها الخالدة العظيمة

77
00:09:09,070 --> 00:09:10,330
السيّد قطّ، ماذا هُناك؟

78
00:09:15,750 --> 00:09:16,940
...هؤلاء النّاس

79
00:09:17,480 --> 00:09:19,590
.الوباء ينتشرُ بُسرعةٍ هذه المرّة

80
00:09:19,600 --> 00:09:22,330
وبلغَ سعر الدّواء في
.المدينة مبالغَ طائلةً

81
00:09:22,640 --> 00:09:24,490
،هؤلاء المرضى لا يملكونَ ثمنه

82
00:09:24,500 --> 00:09:26,960
لذا جاءوا إلى معبد
.الأسلاف للدّعاء

83
00:09:28,450 --> 00:09:29,660
...يا لهُم مِن مساكين

84
00:09:30,540 --> 00:09:32,800
أرجو تقديمَ المزيد مِن
.الدّواء والحساء

85
00:09:33,040 --> 00:09:33,650
.حاضرٌ

86
00:09:44,810 --> 00:09:46,330
.أُمّي، تجرّعي قليلًا

87
00:09:46,360 --> 00:09:48,440
!هذا هُو نبع السّماء الأسطوريّ

88
00:09:48,450 --> 00:09:49,030
...اشربِي منه

89
00:09:49,050 --> 00:09:50,560
.وستتعافينَ قريبًا

90
00:09:50,580 --> 00:09:51,570
.يَاو

91
00:09:52,150 --> 00:09:53,530
أيّ نبعٍ سماويّ؟

92
00:09:54,230 --> 00:09:56,050
.إنّه مُجرّد ماءٍ عاديّ مِن النّبع

93
00:09:56,370 --> 00:09:57,840
.لا يُمكنه شفاء أيّ علّةٍ

94
00:09:59,270 --> 00:10:01,200
!هراءٌ! إنّه نبعٌ سماويّ

95
00:10:01,360 --> 00:10:03,000
!هذا ما يُردّده الكبار دائمًا

96
00:10:03,010 --> 00:10:04,770
،لو كان هذا النّبع السماويّ فعالًا

97
00:10:04,780 --> 00:10:06,640
...لما كانت زوجتِي قد

98
00:10:10,080 --> 00:10:11,610
.أُمّي، لا تستمِعي إليه

99
00:10:11,620 --> 00:10:13,820
.ستُصبحينَ بخيرٍ بالتّأكيد

100
00:10:25,180 --> 00:10:27,500
ماء هذا النّبع لا يُمكنه
.شفاء والدتِك

101
00:10:27,510 --> 00:10:28,110
.لِي شِياو

102
00:10:36,230 --> 00:10:37,990
،لكن، إن كُنت تثقُ بي

103
00:10:38,630 --> 00:10:40,160
.فأنا مستعدٌّ للمُحاولة

104
00:10:43,180 --> 00:10:44,490
هل أنت مؤهّلٌ لذلك؟

105
00:10:44,500 --> 00:10:46,030
.إيّاك وإعطاءَ آمالٍ كاذبة

106
00:10:51,120 --> 00:10:52,050
...ما قولكَ

107
00:10:52,640 --> 00:10:54,250
أن نمنحه فُرصةً؟

108
00:11:09,140 --> 00:11:11,730
أُمّي، السيّدة شُو جلبت للتّو
.بعض الفطائر السّاخنة

109
00:11:11,740 --> 00:11:13,670
،لا تزالُ دافئةً
.تناولِي قضمةً

110
00:11:16,620 --> 00:11:17,550
.كُل أنت أيضًا

111
00:11:17,650 --> 00:11:19,780
.أنت تملكُ مهاراتٍ حقيقيّة بالفِعل

112
00:11:19,830 --> 00:11:20,790
...سمعتُ

113
00:11:20,820 --> 00:11:22,270
...أنّ حتّى أمهر الأطبّاء في المدينة

114
00:11:22,280 --> 00:11:24,230
لم يتمكّنوا مِن الوصول إلى
.علاجٍ فعّال

115
00:11:24,240 --> 00:11:26,900
لم أتوقّع أن يعمل
.دواؤكَ بهذه السّرعة

116
00:11:26,970 --> 00:11:29,430
في الواقع، الفضل يعودُ
.إلى جُوان جُوان

117
00:11:29,630 --> 00:11:30,410
أنا؟

118
00:11:31,030 --> 00:11:34,030
بفضل زُهور ملكة اللّيل
.الّتي أحضرتِها ليلةَ أمس

119
00:11:34,190 --> 00:11:36,650
إنّ ملكة اللّيل عشبةٌ سماويّة
.لا تظهر إلّا مرّةً كُلّ ألف عامٍ

120
00:11:36,660 --> 00:11:39,300
فهِي تُعزّز بشدّةٍ آثار
.الأعشاب العاديّة

121
00:11:39,310 --> 00:11:40,280
!مهلًا

122
00:11:40,670 --> 00:11:43,050
أَلا تذبلُ زُهور ملكة اللّيل
بعد ليلةٍ واحدة فحسب؟

123
00:11:43,060 --> 00:11:44,720
لكانَ مِن المُؤسف حقًا
.لو حدثَ ذلك

124
00:11:44,900 --> 00:11:46,020
...قُمت بمُعالجتها

125
00:11:46,040 --> 00:11:47,690
.كُلّها قبل الفجر

126
00:11:48,650 --> 00:11:51,310
لكنّني لم أتوقّع أن تكون
.مُفيدةً هذا اليوم

127
00:11:55,780 --> 00:11:56,390
ماذا؟

128
00:11:58,900 --> 00:12:01,850
أنت مُجرّد فرخٍ خرج للتّو
.مِن البيضة

129
00:12:02,200 --> 00:12:05,000
مِن أين تعلّمت هذه المهارات؟

130
00:12:11,380 --> 00:12:12,120
ماذا حدثَ؟

131
00:12:12,130 --> 00:12:13,720
.كانا بخيرٍ مُنذ بُرهةٍ

132
00:12:14,170 --> 00:12:15,480
.لا... لا أعلم

133
00:12:15,500 --> 00:12:16,640
...انقلبَ الحال بغمضةِ عينٍ

134
00:12:18,200 --> 00:12:20,060
لِمَ ساء الوضع بهذا الشّكل المُفاجئ؟

135
00:12:20,070 --> 00:12:20,890
.يَاو

136
00:12:49,350 --> 00:12:51,880
إنّ نبضهُ وأعراضه تتطابق
.تمامًا مع الوباء

137
00:12:52,190 --> 00:12:54,320
لكن لماذا لم تعُد هُناكَ
استجابةٌ للدّواء؟

138
00:12:55,440 --> 00:12:57,770
.كِلا العَرضين قد خفّا سابقًا

139
00:12:58,350 --> 00:13:00,150
لماذا ساءَ حالهُ فجأةً؟

140
00:13:01,130 --> 00:13:04,440
تعافت والدة يَاو وعشرةُ
.مرضى آخرون

141
00:13:04,450 --> 00:13:06,210
يجب أن تكونَ الوصفة
.الطبيّة صحيحةً

142
00:13:06,220 --> 00:13:06,850
ما الوضع؟

143
00:13:08,180 --> 00:13:09,830
.لا بُدّ أنّني أغفلتُ شيئًا ما

144
00:13:11,660 --> 00:13:12,590
ماذا يُمكن أن يكون؟

145
00:13:16,190 --> 00:13:18,570
.أُمّي، أنا عطشانٌ

146
00:13:18,870 --> 00:13:20,730
.حسنًا، سأُحضِر لك الماء

147
00:13:26,630 --> 00:13:27,400
!يَاو

148
00:13:34,030 --> 00:13:35,750
!يَاو

149
00:13:36,940 --> 00:13:39,430
يبدو القيء عرضًا مِن
،أعراض الوباء

150
00:13:39,440 --> 00:13:40,840
...لكنّني لم أرَ قطّ

151
00:13:40,880 --> 00:13:42,930
.جفافًا لحظيًا وشديدًا إلى هذا الحدّ

152
00:13:42,940 --> 00:13:45,400
...ماءٌ

153
00:13:46,410 --> 00:13:49,920
.أنا عطشانٌ -
!يَاو -

154
00:14:07,300 --> 00:14:07,980
!يَاو

155
00:14:11,020 --> 00:14:13,630
يَاو، ماذا يحدثُ لك؟

156
00:14:33,940 --> 00:14:36,070
ألقيتُ تعويذةً مُهدّئة على
.والدة يَاو

157
00:14:36,410 --> 00:14:37,810
.إنّها ترتاحُ في الغُرفة المُجاورة

158
00:14:38,980 --> 00:14:39,940
كيف حالُ يَاو؟

159
00:14:40,360 --> 00:14:41,560
...استخدمتُ الوخزَ بالإبر

160
00:14:41,570 --> 00:14:43,300
.ليستقرّ وضعه مُؤقتًا

161
00:14:43,430 --> 00:14:44,160
،ولكن قبل قليلٍ

162
00:14:44,440 --> 00:14:45,870
...ظهرت نفسُ الأعراض

163
00:14:46,080 --> 00:14:47,740
.على مرِيضين آخرين

164
00:14:50,190 --> 00:14:51,730
،أنت لم تَنم مُنذ ثلاثة أيّامٍ

165
00:14:51,740 --> 00:14:52,830
.اذهب لترتاحَ

166
00:14:55,840 --> 00:14:56,570
،أنا آسفٌ

167
00:14:57,310 --> 00:14:58,130
.خذلتكِ

168
00:14:58,850 --> 00:15:00,120
.ليس خطأكَ

169
00:15:00,250 --> 00:15:01,530
.اذهب ونَل قسطًا مِن الرّاحة

170
00:15:01,710 --> 00:15:03,570
.ربما تُفكّر في طريقةٍ ما

171
00:15:15,510 --> 00:15:16,310
ماذا؟

172
00:15:18,490 --> 00:15:19,200
،هذا هُو

173
00:15:19,530 --> 00:15:21,490
.هذا هُو الشّيء الّذي أغفلته

174
00:15:23,650 --> 00:15:24,440
.لِي شِياو

175
00:15:25,410 --> 00:15:27,050
،لِي شِياو
إلى أين أنت ذاهبٌ؟

176
00:15:38,010 --> 00:15:39,410
عمّ تبحث؟

177
00:15:39,940 --> 00:15:41,540
.أُريد التأكّد مِن أمرٍ ما

178
00:15:42,900 --> 00:15:43,570
ما هُو؟

179
00:15:45,320 --> 00:15:46,990
حالاتُ القيء العاديّة النّاتجة
...عن الوباء

180
00:15:47,000 --> 00:15:49,380
لا تجعلُ المريض يبدو وكأنّ
...كُلّ قطرة رُطوبةٍ

181
00:15:49,390 --> 00:15:52,190
قد سُحبت مِن جسده
.في لحظةٍ، مثل يَاو

182
00:15:52,830 --> 00:15:54,220
،جسده يُعاني مِن جفافٍ حادّ

183
00:15:54,230 --> 00:15:56,090
.ومع ذلك فهُو يرفضُ الماء تمامًا

184
00:15:57,280 --> 00:15:57,880
.وجدتُها

185
00:16:04,010 --> 00:16:06,060
الطّريقة الّتي حاولَ بها يَاو
...عضّ شخصٍ ما آنفًا

186
00:16:06,070 --> 00:16:08,250
لم تبدُ كأنّها تخبّطٌ ناتج
.عن مرضٍ شديد

187
00:16:08,260 --> 00:16:10,060
...بل بدا وكأنّه يُحاول

188
00:16:10,110 --> 00:16:11,470
.امتصاصَ السّوائل بطريقةٍ أُخرى

189
00:16:11,480 --> 00:16:13,550
هل تقصدُ التعطّش للدّماء؟

190
00:16:14,720 --> 00:16:16,250
هل خطرَت لكِ فكرةٌ؟

191
00:16:16,610 --> 00:16:17,600
.عُشبة الأشباح

192
00:16:18,660 --> 00:16:19,460
.هذا صحيحٌ

193
00:16:19,640 --> 00:16:22,570
ولكنّني لم أستَطع التيقّن مِن
...نوع عُشبة الأشباح تلك

194
00:16:23,050 --> 00:16:24,060
...إلّا بعدما رأيتُ

195
00:16:24,840 --> 00:16:25,960
.ذِراع جُوان جُوان

196
00:16:27,610 --> 00:16:29,500
.جُوان جُوان كائنٌ سماويّ حقيقيّ

197
00:16:29,510 --> 00:16:31,970
كيف للسَعاتِ البعُوض العاديّ
أن تُؤثّر فيها؟

198
00:16:33,050 --> 00:16:34,480
—عندها تذكّرت

199
00:16:34,490 --> 00:16:36,950
هُناكَ نوعٌ نادر للغاية
...مِن عُشبة الأشباح

200
00:16:37,060 --> 00:16:38,460
.يُسمّى زهرة أعماق الظّلام

201
00:16:42,080 --> 00:16:43,880
لِي شِياو، ماذا تفعل؟

202
00:16:56,790 --> 00:16:57,500
!لِي شِياو

203
00:16:59,590 --> 00:17:00,410
.أنا بخيرٍ

204
00:17:01,860 --> 00:17:03,850
تنمو زهرة أعماق الظّلام على
.ضفافِ نهر الجحيم

205
00:17:03,860 --> 00:17:05,830
وهِي تُشبه الياسمين البُرتقاليّ
.في مظهرها

206
00:17:05,830 --> 00:17:08,230
لا يُمكنها أن تُزهر إلّا
.إذا غُذّيت بدمِ عذراء

207
00:17:08,240 --> 00:17:09,570
ورُغم أنّ الزّهرة نفسها
،ليست سامّةً

208
00:17:09,570 --> 00:17:11,470
إلّا أنّ رائحتها القويّة والغريبة
،تجذبُ أسرابًا مِن البعُوض

209
00:17:11,480 --> 00:17:14,050
والّذي يتحوّر بعد ذلك
.ويُصبح سامًّا جدًا

210
00:17:14,060 --> 00:17:15,250
أيّ شخصٍ يلسعهُ هذا
...البعُوض السّام

211
00:17:15,260 --> 00:17:17,000
...سيَتحوّل في غُضون ثلاثة أيّامٍ

212
00:17:17,420 --> 00:17:20,340
،إلى جُثّةٍ هامدة، ذابِلة
.ومُتعطّشة للدّماء

213
00:17:20,560 --> 00:17:22,200
،ولإعدادِ التّرياق لزهرة أعماق الظّلام

214
00:17:22,210 --> 00:17:25,140
هذا البعُوض السّام ما نحتاجُ
.إليه تحديدًا

215
00:17:25,930 --> 00:17:26,660
،كما هُو متوقّعٌ

216
00:17:27,190 --> 00:17:28,750
فإنّ الياسمين البُرتقاليّ الّذي
،ابتلعتهُ قبل لحظةٍ

217
00:17:28,760 --> 00:17:29,890
،بعد امتزاجهِ بدمِي

218
00:17:30,150 --> 00:17:31,270
.قد جذبهم جميعًا إلى هُنا

219
00:17:33,130 --> 00:17:35,370
.هذه كُلّها موادّ طبيّةٌ ثمينة

220
00:17:35,380 --> 00:17:38,110
جُوان جُوان، إيّاكِ أن تُخطئي
.في تقدير التّوقيت المُناسب

221
00:17:40,410 --> 00:17:41,760
.اترُك المُهمّة لي

222
00:17:44,300 --> 00:17:46,120
!سيفُ السّحاب

223
00:17:47,330 --> 00:17:48,160
.هيّا

224
00:18:20,230 --> 00:18:21,430
.هذا هُو ما تُريده

225
00:18:22,910 --> 00:18:23,530
.شُكرًا لك

226
00:18:27,270 --> 00:18:30,070
إذن، هذا هُو البعُوض المُلوّث
.بعُشبة الأشباح

227
00:18:31,170 --> 00:18:33,830
بالطّبع، إنّه أكبرُ حجمًا
.بكثيرٍ مِن البعُوض العاديّ

228
00:18:35,950 --> 00:18:38,060
،نُطعم البعُوض السّام للضّفدع

229
00:18:38,070 --> 00:18:40,100
—ثُمّ نستخلصُ إفرازاته السّامة كدواءٍ

230
00:18:40,110 --> 00:18:43,040
عندها يُمكن الشّفاء مِن
.سُمّ زهرة أعماق الظّلام

231
00:18:45,100 --> 00:18:46,250
!أخبارٌ رائعة يا لِي شِياو

232
00:18:46,360 --> 00:18:48,360
!استيقظَ يَاو والآخرون جميعًا

233
00:18:56,770 --> 00:18:59,270
،لا بأس بكَ
.تملكُ مهاراتٍ حقيقيّة

234
00:19:00,480 --> 00:19:01,540
،وأنت كذلك
.لا تَقلّ عنّي كفاءةً

235
00:19:01,990 --> 00:19:02,860
...رتّبت لك

236
00:19:02,870 --> 00:19:04,870
زيارة بضع عائلاتٍ ثريّة في
.المدينة لتشخيصِ حالاتهم

237
00:19:04,880 --> 00:19:05,760
—في ذلك الوقت

238
00:19:05,790 --> 00:19:06,590
.لن أذهب

239
00:19:11,600 --> 00:19:12,330
ما هذا؟

240
00:19:13,520 --> 00:19:15,120
.كتبتهُ بنفسي، سأُعطيكَ نُسخةً

241
00:19:15,640 --> 00:19:16,470
.لا داعِي

242
00:19:17,990 --> 00:19:20,790
سيُثير اهتمامك بمُجرّد
.قراءة الصّفحة الأولى

243
00:19:32,170 --> 00:19:33,660
!حارٌ

244
00:19:39,150 --> 00:19:40,060
!إنّه حارٌ جدًا

245
00:19:58,030 --> 00:19:58,630
.سيّدي

246
00:20:04,580 --> 00:20:07,670
لماذا يتمّ إبطال مفعول عُشبة
الأشباح الخاصّة بك مرارًا وتكرارًا؟

247
00:20:08,240 --> 00:20:10,240
،سـ-سيّدي
.أرجوكَ اكبح جِماح غضبكَ

248
00:20:10,420 --> 00:20:13,020
،تكبّدتُ عناءً شديدًا لإعادتكَ

249
00:20:13,490 --> 00:20:16,650
جمعتُ شتات رُوح السّراب
،خاصّتكَ بمشقّةٍ

250
00:20:17,410 --> 00:20:19,910
—ومنحتُكَ جسدًا حيًا جديدًا

251
00:20:21,000 --> 00:20:22,960
،كُلّ ذلك لسببٍ واحد
...لأنّك وحدكَ

252
00:20:22,970 --> 00:20:27,370
مَن يملكُ آخر مُجلّدٍ باقٍ مِن
.موسوعة عُشبة الأشباح في العالم

253
00:20:28,160 --> 00:20:29,660
...إذا اكتشفتُ أنّ

254
00:20:29,840 --> 00:20:31,500
...شخصًا آخر غيركَ

255
00:20:31,590 --> 00:20:34,150
،يعرف كيفيّة استخدام عُشبة الأشباح

256
00:20:35,240 --> 00:20:38,200
.فلن تعودَ لك أيّ قيمةٍ

257
00:20:38,920 --> 00:20:40,150
هل تفهم؟

258
00:20:40,300 --> 00:20:42,220
.أجل، يا سيّدي

259
00:20:43,640 --> 00:20:45,100
...أحبطت تِيان كُوان

260
00:20:45,110 --> 00:20:46,790
.ما حدث في بلدة لُويِي

261
00:20:47,310 --> 00:20:49,230
...كُنت أنوِي استخدام هذا الوباء

262
00:20:49,260 --> 00:20:52,180
لتلفيقِ تُهمة التّقصير
.لـ هُوا فِينغ يُو

263
00:20:53,010 --> 00:20:56,590
ولكن ذلك الصيدليّ المُزعج
.لِي شِياو صنعَ ترياقًا بُغتةً

264
00:20:57,060 --> 00:20:58,150
...الصيدليّ لِي

265
00:20:58,560 --> 00:20:59,860
...كان الطّائر الأسود

266
00:20:59,880 --> 00:21:02,410
الّذي بقِي إلى جانب
.تِيان كُوان في بلدة لُويِي

267
00:21:02,690 --> 00:21:03,560
ماذا؟

268
00:21:05,390 --> 00:21:06,880
.راقبهُ عن كثبٍ

269
00:21:07,720 --> 00:21:09,730
.واكتشِف هويّته

270
00:21:10,340 --> 00:21:10,950
.حاضرٌ

271
00:21:26,270 --> 00:21:27,090
،لِي شِياو

272
00:21:27,250 --> 00:21:29,290
.قدّمتَ مُساهمةً كبيرة

273
00:21:29,300 --> 00:21:30,600
،لم تُعالج الوباء فحسب

274
00:21:30,610 --> 00:21:32,780
بل أبطلتَ مفعول سُمّ
.عُشبة الأشباح أيضًا

275
00:21:32,790 --> 00:21:35,340
حاليًا، ذاعَ صِيتُ الصيدليّ لِي
.في كُلّ مكانٍ

276
00:21:35,350 --> 00:21:37,160
...هُناك طابورٌ لا ينتهي مِن النّاس

277
00:21:37,170 --> 00:21:39,330
ينتظرونَ عند معبد إله الأرض
.للحُصول على الدّواء

278
00:21:39,340 --> 00:21:40,810
...لو لم

279
00:21:41,830 --> 00:21:43,610
،تُنقِذني آنذاك

280
00:21:45,330 --> 00:21:47,430
...أَلم تكُن لتُصبحَ اليوم

281
00:21:47,440 --> 00:21:50,010
مُعالجًا عظيمًا تعرفه البلاد؟

282
00:21:55,300 --> 00:21:55,900
،جُوان جُوان

283
00:21:56,620 --> 00:21:58,380
بما أنّ عُشبة الأشباح
،قد عاودت الظّهور

284
00:21:58,390 --> 00:21:59,640
هل يجبُ علينا أن...؟

285
00:22:09,210 --> 00:22:10,900
...أيّها الأخ الأكبر

286
00:22:29,950 --> 00:22:36,490
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

287
00:22:37,040 --> 00:22:45,550
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

288
00:22:47,520 --> 00:22:52,240
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

289
00:22:52,260 --> 00:22:55,180
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

290
00:22:56,870 --> 00:23:00,730
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

291
00:23:00,760 --> 00:23:04,510
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

292
00:23:05,180 --> 00:23:09,880
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

293
00:23:09,900 --> 00:23:13,970
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

294
00:23:14,540 --> 00:23:19,720
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

295
00:23:19,880 --> 00:23:23,230
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

296
00:23:23,900 --> 00:23:29,030
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

297
00:23:29,040 --> 00:23:33,500
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

298
00:23:33,510 --> 00:23:38,470
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

299
00:23:38,480 --> 00:23:42,930
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

300
00:23:48,050 --> 00:23:53,390
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟