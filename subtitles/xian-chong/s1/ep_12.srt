1
00:00:21,290 --> 00:00:21,960
.في ذلك الاتّجاه

2
00:00:30,080 --> 00:00:33,700
جُوان جُوان، أين أنتِ؟

3
00:00:36,770 --> 00:00:37,650
!جُوان جُوان

4
00:00:39,260 --> 00:00:42,340
!جُوان جُوان، استيقِظي

5
00:00:44,040 --> 00:00:45,710
...وِي لِي

6
00:00:45,730 --> 00:00:48,390
،آسفٌ، تأخّرتُ
هل أصابكِ مكروهٌ؟

7
00:00:48,700 --> 00:00:49,650
.أنا بخيرٍ

8
00:00:49,900 --> 00:00:50,830
.أنتِ مصابةٌ

9
00:00:51,500 --> 00:00:54,100
،إنّها مُجرّد إصابةٍ طفيفة
.لا داعي للقلق

10
00:00:54,670 --> 00:00:56,250
ما الّذي حدث؟

11
00:00:56,830 --> 00:00:59,030
...اكتشفتُ أنّ شيطانَ زهرة جُوهان

12
00:00:59,050 --> 00:01:01,100
،قد تلبّس بِي يُون جوُاو

13
00:01:01,280 --> 00:01:03,070
مُتنكّرًا في هيئةِ ابنة
،هَان بَاو رُونغ

14
00:01:03,080 --> 00:01:04,980
.ليُثير الفوضى

15
00:01:05,040 --> 00:01:05,950
شيطانُ زهرةٍ؟

16
00:01:07,080 --> 00:01:09,110
،قاتلتُ ذلك الشّيطان

17
00:01:09,130 --> 00:01:10,780
.وكدتُ أقبض عليه

18
00:01:11,280 --> 00:01:13,340
...لكنّه دفعَ

19
00:01:13,370 --> 00:01:15,340
يُون جوُاو في الماء
.ليتمكّن مِن الهرب

20
00:01:15,910 --> 00:01:18,390
قفزتُ خلفها مُحاولةً إنقاذها
،بكُلّ قُوّتي

21
00:01:18,400 --> 00:01:20,060
،ولكن حينما انتشلتُها

22
00:01:20,470 --> 00:01:22,230
.كانت قد فارقت الحياة

23
00:01:23,400 --> 00:01:26,690
،الذّنب ذنبي
...لو أنّني أسرعتُ قليلًا

24
00:01:28,530 --> 00:01:30,260
،لا تزالُ تتنفّس
!لم تمُت بعد

25
00:01:32,050 --> 00:01:33,140
،لحُسن الحظّ
،قبل أن أُغادر

26
00:01:33,150 --> 00:01:35,610
جعلني المُعلّم أحملُ معي
.حبّة دواءٍ مُنقذةً للحياة

27
00:01:36,640 --> 00:01:38,900
.حقًا؟ هذا رائعٌ

28
00:01:41,250 --> 00:01:43,310
،لا بأس
.جئنا لإنقاذكِ يا يُون جوُاو

29
00:01:45,930 --> 00:01:49,180
!يُون جوُاو، أخفتِني كثيرًا

30
00:01:49,210 --> 00:01:50,470
،لو أنّكِ مُتِّ بالفِعل

31
00:01:50,470 --> 00:01:53,160
لظللتُ أشعرُ بالذّنب
.طوال حياتي

32
00:01:53,460 --> 00:01:55,660
لا أعلم ما حالُ
.هَان شِيان وابنه الآن

33
00:01:56,840 --> 00:01:59,500
وهل سيُهاجمهما شيطانُ الزّهرة؟

34
00:01:59,530 --> 00:02:02,790
،وِي لِي
لماذا لا تعود وتتفقّد حالهُما؟

35
00:02:03,850 --> 00:02:06,350
.أنا سأعتني بـ يُون جوُاو

36
00:02:06,550 --> 00:02:07,880
،حسنًا
.سأمضي لأتفقّد حالهُما

37
00:02:07,890 --> 00:02:10,000
.انتظِريني هُنا، سأعودُ سريعًا

38
00:02:14,100 --> 00:02:16,320
،يُون جوُاو
هل تشعرينَ بالبرد؟

39
00:02:16,610 --> 00:02:18,470
.إيّاكِ أن تمرضي

40
00:02:18,630 --> 00:02:19,570
،لا بأس

41
00:02:19,870 --> 00:02:22,920
سأشعلُ نارًا بعد قليلٍ
.كي تدفئي

42
00:02:23,130 --> 00:02:25,660
وما إن تجفّ ثيابكِ
.حتّى يزولَ البرد

43
00:02:25,870 --> 00:02:27,360
،كفى خداعًا

44
00:02:28,300 --> 00:02:29,360
.يا شيطانَ السّراب

45
00:02:35,140 --> 00:02:42,060
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

46
00:02:42,120 --> 00:02:49,740
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

47
00:02:49,750 --> 00:02:56,240
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

48
00:02:56,250 --> 00:03:01,830
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

49
00:03:03,250 --> 00:03:10,280
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

50
00:03:10,290 --> 00:03:17,990
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

51
00:03:18,000 --> 00:03:24,820
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

52
00:03:24,820 --> 00:03:30,450
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

53
00:03:31,250 --> 00:03:38,610
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

54
00:03:38,620 --> 00:03:45,320
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

55
00:03:45,320 --> 00:03:51,530
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

56
00:03:51,540 --> 00:03:58,910
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

57
00:04:14,960 --> 00:04:17,920
.أنتِ... شيطانُ السّراب

58
00:04:17,950 --> 00:04:19,990
إيّاكِ أن تجرؤي على
!المساس بـ جِي

59
00:04:20,200 --> 00:04:21,270
!اخرسي

60
00:04:21,510 --> 00:04:22,210
!اغربي عن وجهي

61
00:04:26,390 --> 00:04:27,890
!لنكتفِ بهذا القدر مِن هذه المهزلة

62
00:04:28,280 --> 00:04:31,720
،حان الوقت لنتحدّث معًا بجديّةٍ
.يا رُوح الثّعلب

63
00:04:34,590 --> 00:04:35,840
هل قتلتِها؟

64
00:04:36,620 --> 00:04:37,620
،ليست هِي وحدها

65
00:04:38,460 --> 00:04:40,510
...بل إنّ أخاها وأباها العاجزين

66
00:04:40,530 --> 00:04:42,040
.يُزهران أيضًا

67
00:04:42,750 --> 00:04:44,510
.لا وُجود لأيّ لعنةٍ على الإطلاق

68
00:04:44,540 --> 00:04:45,750
.اختلقتِ ذلك

69
00:04:47,400 --> 00:04:50,210
إنّهم أغبياء للغاية، فهُم
.يُصدّقون كُلّ ما أقوله

70
00:04:50,970 --> 00:04:54,390
حتّى إنّهم يعتبرونَ هذه
.حبّةً سحريّة

71
00:04:55,200 --> 00:04:57,730
أتساءلُ مَن الّذي منحهم
.بذرة اللّوتس الحمراء هذه

72
00:04:58,300 --> 00:05:00,110
الشّخص الّذي منحَ بذرة
...اللّوتس الحمراء لـ هَان شيَان

73
00:05:00,120 --> 00:05:00,890
لم يكُن أنتِ؟

74
00:05:01,400 --> 00:05:03,310
،صادفَ أن مررتُ مِن هُنا

75
00:05:03,340 --> 00:05:05,130
،وعلمتُ بما كان يجري

76
00:05:05,150 --> 00:05:06,650
لذلك جئتُ لأُشاركَ في
.هذا المرح

77
00:05:06,660 --> 00:05:08,620
ما الّذي دفعكِ لفعل هذا؟

78
00:05:08,730 --> 00:05:09,690
!لماذا؟

79
00:05:12,870 --> 00:05:16,200
هل يُوجد في هذه الدّنيا
ما هُو أمتع مِن ذلك؟

80
00:05:17,630 --> 00:05:21,480
،بشرٌ يفيضونَ أنانيّةً
،وجشعًا، وقسوةً

81
00:05:21,700 --> 00:05:24,200
.لكنّهم يتظاهرونَ بالصّلاح والعدالة

82
00:05:24,840 --> 00:05:27,030
لهذا أُريد تجريدهُم مِن
،أقنعتهم المُنافقة

83
00:05:27,040 --> 00:05:28,720
،طبقةً تلو أُخرى

84
00:05:28,750 --> 00:05:31,270
ومُراقبتهم وهُم يهوونَ
،إلى الجحيم

85
00:05:31,290 --> 00:05:33,020
.بسبب أوهامهم وهواجسهم

86
00:05:34,650 --> 00:05:37,100
!يا لها مِن تسليةٍ مُبهجة

87
00:05:40,310 --> 00:05:42,480
.أُختاه، كُوني رفيقةً بي

88
00:05:42,970 --> 00:05:45,730
هذا الجسد لا يقوى
.على تعاملكِ الخشن

89
00:05:45,810 --> 00:05:48,440
،عندما يأتي وِي لِي
.سيجدُ طريقةً لإخضاعكِ

90
00:05:48,960 --> 00:05:50,750
هل تناهت إلى مسامعكِ
تلك الأسطورة؟

91
00:05:51,360 --> 00:05:53,960
حينما تشكّلت قارّة
،تشَانغ شُوي للمرّة الأولى

92
00:05:54,150 --> 00:05:56,480
.ظهرَ صدعٌ بين السّماء والأرض

93
00:05:56,820 --> 00:05:58,120
،وعلى مدى آلافِ السّنين

94
00:05:58,130 --> 00:06:01,320
تدفّقت شوائبُ العالم
،إلى هذا الصّدع

95
00:06:01,340 --> 00:06:03,090
...لتتجمّع في نهرٍ طويل

96
00:06:03,490 --> 00:06:04,820
.يُدعى نهر مِينغ

97
00:06:05,630 --> 00:06:09,120
وإنّ النّباتات الّتي تنمو
،على ضفافه فريدةٌ جدًا

98
00:06:09,480 --> 00:06:10,770
.وتُعرف باسم أعشاب الأشباح

99
00:06:11,260 --> 00:06:15,020
بل يُقال إنّ بعضها يمتلكُ
.القُدرة على تدميرِ العالم

100
00:06:15,340 --> 00:06:16,840
ولا يُمكن لأحدٍ دُخول
...هذا الصّدع

101
00:06:16,870 --> 00:06:18,610
.سوى شياطين السّراب

102
00:06:19,210 --> 00:06:21,500
بذرةُ اللّوتس الحمراء هِي
!عشبٌ مِن أعشاب الأشباح؟

103
00:06:21,520 --> 00:06:22,540
.أصبتِ

104
00:06:22,550 --> 00:06:24,100
بمُجرّد أن يتناولَ
،شخصٌ ما عُشب الأشباح

105
00:06:24,110 --> 00:06:27,780
نستطيعُ نحن شياطين السّراب
.تفعيلَ قُوّته في أيّ وقتٍ نشاء

106
00:06:28,280 --> 00:06:29,620
أَليس هذا مُسلّيًا؟

107
00:06:30,910 --> 00:06:31,910
،إذن خمّني مُجدّدًا

108
00:06:32,790 --> 00:06:34,220
...لماذا يُمكن لهذا العُشب الضّئيل

109
00:06:34,230 --> 00:06:36,370
أن يُدمّر العالم؟

110
00:06:50,220 --> 00:06:53,830
كم أرغبُ في أن أُريهم طريقةَ الاستخدام
.الحقيقيّة لبذرة اللّوتس الحمراء

111
00:07:39,400 --> 00:07:40,490
.يا لكِ مِن مُزعجةٍ

112
00:07:40,710 --> 00:07:43,420
.يا رُوح الثّعلب، لنعقِد صفقةً

113
00:07:43,440 --> 00:07:45,150
.أعيريني جسدكِ

114
00:07:45,600 --> 00:07:48,320
فلم يسبق لي أن حظيتُ بجسدٍ
.بمثل هذه القُوّة مِن قبل

115
00:07:48,900 --> 00:07:50,110
.سيكونُ هذا مُمتعًا

116
00:07:50,750 --> 00:07:52,000
!هذا بعيدٌ عن منالكِ

117
00:07:52,340 --> 00:07:53,590
!يا لكِ مِن شرسةٍ

118
00:08:14,550 --> 00:08:15,890
،كونوا حذرِين

119
00:08:15,910 --> 00:08:17,620
وإيّاكم أن تُحطّموا
!دُميتي الجديدة

120
00:08:18,800 --> 00:08:20,640
.غضبتُ حقًا

121
00:08:51,990 --> 00:08:53,990
!يا لكِ مِن بارعةٍ يا رُوح الثّعلب

122
00:08:54,710 --> 00:08:57,510
إنّ شغفي للاستحواذ
.على جسدكِ يتعاظم

123
00:08:59,110 --> 00:09:00,730
بمثل هذه المهارات
،الضّعيفة فحسب

124
00:09:00,750 --> 00:09:02,950
تُريدين تدميرَ العالم؟

125
00:09:02,970 --> 00:09:04,900
.أنتِ تُبالغين في تقدير نفسكِ

126
00:09:07,360 --> 00:09:08,860
لماذا لا تقومينَ بحسبةٍ بسيطة؟

127
00:09:08,880 --> 00:09:12,440
على مدى السّنوات الماضية، كم عدد بُذور
اللّوتس الحمراء الّتي نشرتها عائلة هَان؟

128
00:09:12,450 --> 00:09:13,700
وعلى مدى هذه السّنوات
،الأربع والعشرين

129
00:09:13,710 --> 00:09:17,320
كم عدد بُذور اللّوتس الحمراء
الجديدة الّتي نمت منها؟

130
00:09:18,090 --> 00:09:21,620
هل تقصدينَ أنّ عائلة هَان ليست
الوحيدة الّتي تزرعُ اللّوتس الأحمر؟

131
00:09:22,220 --> 00:09:25,250
أخبرتكِ سلفًا أنّ الشرّ
.متأصّلٌ في النّفوس بالفطرة

132
00:09:25,510 --> 00:09:28,110
كيف لعائلة هَان أن تكونَ
الوحيدة في هذا العالم؟

133
00:09:28,490 --> 00:09:31,890
انتشرت بُذور اللّوتس الحمراء بالفِعل
،في جميع أنحاء أرض تشَانغ شُوي

134
00:09:31,900 --> 00:09:32,830
...وما علينا الآن إلّا

135
00:09:33,310 --> 00:09:34,940
.انتظار لحظة تفتّح الزّهور

136
00:09:59,310 --> 00:10:01,940
!بِي يُون جوَاو، استيقِظي

137
00:10:03,930 --> 00:10:05,050
.أنا عديمةُ الفائدة

138
00:10:05,760 --> 00:10:07,690
،هوّني عليكِ

139
00:10:07,910 --> 00:10:10,570
أنا لا أزالُ راضيةً عن
.هذا الجسد

140
00:10:13,320 --> 00:10:16,370
...يا شيطان السّراب

141
00:10:31,510 --> 00:10:33,390
جُوان جُوان، أين أنتِ؟

142
00:10:39,800 --> 00:10:41,770
وِي لِي، عمّ تتحدّث؟

143
00:10:42,410 --> 00:10:44,110
كيف لي أن أكونَ
شيطانًا سرابيًا؟

144
00:10:44,430 --> 00:10:45,930
.أنا جُوان جُوان

145
00:10:46,800 --> 00:10:49,220
جُوان جُوان لم تكُن
!قطّ مُتصنّعةً هكذا

146
00:10:50,480 --> 00:10:52,900
،وعلاوةً على ذلك
،لو كُنتِ أنتِ جُوان جُوان

147
00:10:54,120 --> 00:10:55,920
فلماذا قد تكونُ خائفةً
منكِ إلى هذا الحدّ؟

148
00:10:56,570 --> 00:10:57,730
.إنّها شيطان السّراب

149
00:10:57,940 --> 00:11:00,400
استحوذت على جسد جُوان جُوان
!لأنّها كانت تُحاول إنقاذي

150
00:11:03,470 --> 00:11:05,390
،اخرجِي مِن جسد جُوان جُوان

151
00:11:05,410 --> 00:11:06,530
...وإلّا

152
00:11:07,400 --> 00:11:09,650
وإلّا ماذا؟

153
00:11:12,950 --> 00:11:15,160
هل تقوى على طعنِها؟

154
00:11:18,030 --> 00:11:21,010
هذه الثّعلبة الصّغيرة
.مفتونةٌ بك للغاية

155
00:11:21,320 --> 00:11:23,160
،أنت رجلٌ صالح

156
00:11:23,180 --> 00:11:25,510
ولن تخذلها، أَليس كذلك؟

157
00:11:29,130 --> 00:11:30,980
.وداعًا إذن

158
00:11:31,580 --> 00:11:33,130
،لا تحزن كثيرًا

159
00:11:33,610 --> 00:11:34,730
،فقد يأتي يومٌ أشعر فيه بالملل

160
00:11:34,740 --> 00:11:36,780
.وأُعيدها إليك

161
00:11:43,360 --> 00:11:46,110
بما أنكِ تستطيعينَ قراءة
...ذكرياتها، فلا بُدّ أنّكِ تعلمينَ

162
00:11:47,460 --> 00:11:50,900
أنّني وإيّاها لم نكُن سوى زميلي
.دراسةٍ لعامٍ واحد في طُفولتنا

163
00:11:50,910 --> 00:11:52,710
.والعلاقة بيننا لا تتعدّى ذلك

164
00:11:53,750 --> 00:11:55,210
فلو أنّني أخليتُ
،سبيلكِ مِن أجلها

165
00:11:55,650 --> 00:11:57,520
.سأخسرُ ثقة مُعلّمي

166
00:11:58,020 --> 00:11:59,620
ألن تكونَ هذه خسارةً فادحة؟

167
00:12:02,540 --> 00:12:04,200
إذن، إذا كُنتِ مُستعدّةً
،للخُروج بهُدوءٍ

168
00:12:04,210 --> 00:12:06,010
.فرُبّما أعفو عن حياتكِ

169
00:12:06,280 --> 00:12:07,480
،أمّا إذا قاومتِ

170
00:12:07,800 --> 00:12:10,010
،فسأُقطّعكِ إربًا وأعودُ بكِ

171
00:12:10,020 --> 00:12:12,150
وأنا واثقٌ أنّ مُعلّمي
.لن يُبالي بكيفيّة إحضاركِ

172
00:12:12,420 --> 00:12:15,210
لا أُصدّق أنّك ستتجرأُ
.على قتلي

173
00:12:42,220 --> 00:12:43,990
،بناءً على فهمكِ للطّبيعة البشريّة

174
00:12:44,000 --> 00:12:45,740
هل تظنينَ صدقًا أنّني
...سأُفوّت فُرصة القبض عليكِ

175
00:12:45,750 --> 00:12:47,500
ونيلَ الثّناء مِن أجلِ
رُوح ثعلبٍ صغيرة؟

176
00:12:49,800 --> 00:12:52,030
لا يُمكن لشيطان السّراب
،أن يتنقّل إلّا عبرَ الماء

177
00:12:52,040 --> 00:12:54,170
لذلك ليس عليّ سوى
...حصاره ودفعه نحو البركة

178
00:12:54,920 --> 00:12:56,410
،سأقولها للمرّة الأخيرة

179
00:12:56,910 --> 00:12:58,850
!اخرجي

180
00:13:03,660 --> 00:13:07,070
...أيّها الأخ الأكبر، وِي لِي

181
00:13:14,150 --> 00:13:17,440
شيطان السّراب لا يتنقّل
،عبرَ الماء فحسب

182
00:13:17,470 --> 00:13:19,860
!بل عبرَ الدّماء أيضًا

183
00:13:28,330 --> 00:13:32,210
.الآن، جسدكَ بات ملكي

184
00:13:40,390 --> 00:13:42,140
تمهّل، ما الّذي تفعلهُ؟

185
00:13:43,580 --> 00:13:47,040
إذن، لم يعُد لديكَ
.مكانٌ لتفرّ إليه

186
00:13:47,070 --> 00:13:49,070
هل تُضحّي بحياتكَ لتقضي عليّ؟

187
00:14:03,590 --> 00:14:06,050
،اسمعني يا شَاو وِي لِي

188
00:14:07,010 --> 00:14:08,480
!لن أدعكَ تموت

189
00:14:19,510 --> 00:14:23,310
شَاو وِي لِي، كسبتُ التحدّي
.في آخر المطاف

190
00:14:26,790 --> 00:14:27,630
.وِي لِي

191
00:14:29,080 --> 00:14:29,910
!وِي لِي

192
00:14:31,580 --> 00:14:33,660
.جُوان جُوان، أنا آسفٌ

193
00:14:33,690 --> 00:14:36,230
.ما قُلته للتّو كان كذبًا

194
00:14:37,950 --> 00:14:38,900
،أعلمُ ذلك

195
00:14:39,190 --> 00:14:40,570
،خُدعت مرّةً

196
00:14:41,120 --> 00:14:42,850
.ولن أُخدعَ مرّةً ثانية

197
00:14:50,420 --> 00:14:51,250
.وِي لِي

198
00:14:51,690 --> 00:14:52,890
.يجب أن أُغادر

199
00:14:53,140 --> 00:14:55,200
وُجودي بقُربكِ سيجلبُ
.لكِ الهلاك

200
00:14:55,870 --> 00:14:58,780
لا تقلقِي، سأجدُ
.طريقةً للتّعامل معه

201
00:14:59,490 --> 00:15:01,160
.اعتني بنفسكِ جيّدًا

202
00:15:03,950 --> 00:15:05,680
!سأبحثُ عنك

203
00:15:07,370 --> 00:15:09,370
أينما كُنت في هذا
.العالم الفَسيح

204
00:15:21,390 --> 00:15:22,490
،آنسة شُو

205
00:15:22,520 --> 00:15:24,720
،سيكونُ وِي لِي بخيرٍ
أَليس كذلك؟

206
00:15:28,140 --> 00:15:29,470
.سيكونُ على ما يُرام

207
00:15:37,080 --> 00:15:38,790
ما الّذي جعلك تُميّز
لِي شِياو؟

208
00:15:43,200 --> 00:15:44,890
...هل لِي شِياو بالفِعل

209
00:15:47,670 --> 00:15:49,470
أم أنّني أُفرط في التّفكير؟

210
00:15:57,000 --> 00:16:00,700
حينما
تُوقد
ربّة القمر
مصباحها
في اللّيل

211
00:15:57,000 --> 00:16:00,700
يتلهّف
المُغتربون
ليوم
العودة

212
00:15:59,590 --> 00:16:01,840
حينما تُوقد ربّة القمر
،مصباحها في اللّيل

213
00:16:03,250 --> 00:16:05,380
.يتلهّف المُغتربون ليوم العودة

214
00:16:06,540 --> 00:16:09,290
،إنّه هُو
!إنّه هُو حقًا

215
00:16:10,420 --> 00:16:12,330
،جُوان جُوان
إلى أين أنتِ ذاهبةٌ؟

216
00:16:13,050 --> 00:16:14,110
هل رأيتِ لِي شِياو؟

217
00:16:14,120 --> 00:16:15,030
لِي شِياو؟

218
00:16:15,500 --> 00:16:18,360
يبدو أنّ تَشانغ أر قد اصطحبهُ برفقة
.البقيّة إلى مهرجان الفوانيس

219
00:16:18,370 --> 00:16:19,240
.جُوان جُوان

220
00:16:41,810 --> 00:16:42,700
!بلاغٌ عاجل

221
00:16:42,810 --> 00:16:44,540
!سيّدي القائد
.وصلتنا الأنباءُ للتّو

222
00:16:44,560 --> 00:16:47,100
هُناك العديد مِن الموتى
.السّائرين في الجنوب أيضًا

223
00:16:47,130 --> 00:16:48,530
—أمرتنا القيادة العُليا بـ

224
00:16:52,740 --> 00:16:54,870
هل أنتَ القائد الأعلى هُنا؟

225
00:17:03,640 --> 00:17:05,270
يُمكنني الانضمام إلى
،جيشِ تشينغ جيَا

226
00:17:05,290 --> 00:17:07,220
لمُساعدتك في القضاء
،على شيطان السّراب

227
00:17:07,640 --> 00:17:09,040
.ولكن لديّ شرطٌ واحد

228
00:17:10,180 --> 00:17:11,220
ما هُو شرطكِ؟

229
00:17:11,740 --> 00:17:13,010
ساعدنِي في العُثور
،على شخصٍ ما

230
00:17:13,160 --> 00:17:15,070
—وعليكَ أن تعدني

231
00:17:16,170 --> 00:17:18,670
،مهما حدثَ
.إيّاك أن تقتله

232
00:17:25,150 --> 00:17:25,740
!يا مُعلّمي

233
00:17:26,100 --> 00:17:26,780
ما الخطب؟

234
00:17:28,800 --> 00:17:30,930
.وقعَ مكروهٌ لعائلة هُوا

235
00:18:38,240 --> 00:18:42,200
،يا أيّها القمر
!يا أيّها القمر

236
00:18:42,590 --> 00:18:47,680
،ها قد اجتمعَ شملُكَ

237
00:18:49,390 --> 00:18:58,050
لكن ماذا عساي أن أفعلَ؟

238
00:19:20,750 --> 00:19:23,820
أيّتها الشّابة، ماذا تفعلينَ هُنا
وحيدةً في مُنتصف اللّيل؟

239
00:19:28,970 --> 00:19:34,890
،عشِقتُ الكُتب والخطّ مُنذ صغري

240
00:19:36,750 --> 00:19:38,210
...وحين سمعتُ أنّك تدرسُ

241
00:19:39,780 --> 00:19:42,000
،هُنا بمُفردك

242
00:19:42,380 --> 00:19:43,840
.جِئتُ لأُؤنس وحدتكَ

243
00:19:44,260 --> 00:19:47,570
،نحن لسنا أقاربَ حتّى يا آنسة
أَليس هذا تصرفًا غير لائقٍ؟

244
00:19:47,580 --> 00:19:51,610
ماذا عساي أن أفعلَ إذن؟

245
00:19:53,340 --> 00:19:56,470
هل تقبلينَ بالزّواج منّي؟

246
00:19:57,530 --> 00:20:00,310
!وبذلك سنُصبح عائلةً

247
00:20:00,890 --> 00:20:04,050
!إنّه أنت
!إنّه أنت حقًا

248
00:20:09,620 --> 00:20:11,160
.وِي لِي، أيّها الأخ الأكبر

249
00:20:37,580 --> 00:20:38,960
أنتَ لِي شِياو؟

250
00:20:39,420 --> 00:20:40,260
.أجل

251
00:20:41,390 --> 00:20:42,720
،لِي شِياو مِن قصر بَان يُوي

252
00:20:42,930 --> 00:20:45,690
مشتبهٌ به في قتلِ الملك
.هُوا فِينغ يُو وجميع أهلِ بيته

253
00:20:45,700 --> 00:20:47,100
!اقبضُوا عليه فورًا

254
00:20:53,040 --> 00:21:00,070
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

255
00:21:00,080 --> 00:21:08,620
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

256
00:21:10,660 --> 00:21:15,360
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

257
00:21:15,370 --> 00:21:20,030
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

258
00:21:20,040 --> 00:21:23,860
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

259
00:21:23,870 --> 00:21:28,360
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

260
00:21:28,370 --> 00:21:33,030
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

261
00:21:33,040 --> 00:21:37,740
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

262
00:21:37,750 --> 00:21:42,940
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

263
00:21:42,950 --> 00:21:46,940
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

264
00:21:46,950 --> 00:21:52,070
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

265
00:21:52,080 --> 00:21:56,570
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

266
00:21:56,580 --> 00:22:01,530
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

267
00:22:01,540 --> 00:22:05,990
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

268
00:22:11,120 --> 00:22:17,200
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟