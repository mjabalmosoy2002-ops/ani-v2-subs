1
00:00:14,090 --> 00:00:15,280
،الطّائر الشيطانيّ لِي شِياو
...مشتبهٌ به

2
00:00:15,290 --> 00:00:17,980
في قتلِ جميع أهل بيت
.هُوا فِينغ يُو، ملكِ الجنوب

3
00:00:17,990 --> 00:00:19,070
!اقبضُوا عليه فورًا

4
00:00:19,200 --> 00:00:19,990
هل تعرفهُ؟

5
00:00:20,010 --> 00:00:22,600
إنّه الابن الوحيد
.لـ هُوا فِينغ يُو، وقد تولّيتُ علاجه

6
00:00:22,610 --> 00:00:25,660
،ذلك الجِينسينغ الأحمر
.هُو مَن أحضرهُ بنفسه

7
00:00:25,820 --> 00:00:26,500
.سأُرافقك

8
00:00:26,510 --> 00:00:28,030
،سأكشفُ الحقيقة قريبًا

9
00:00:28,040 --> 00:00:29,390
!وأُعيدكَ إلى الدّار

10
00:00:30,600 --> 00:00:32,020
...هُوا فِينغ يُو

11
00:00:32,140 --> 00:00:34,100
مَن الّذي ألحقَ بكُم الأذى؟

12
00:00:34,120 --> 00:00:36,160
.سأُنصفكم وأُحاسبه

13
00:00:36,360 --> 00:00:37,480
أين هُو؟

14
00:00:39,190 --> 00:00:40,020
!ساخنٌ جدًا

15
00:00:41,710 --> 00:00:42,640
!ساخنٌ جدًا

16
00:00:44,260 --> 00:00:45,740
،تعالَ يا كَانغ

17
00:00:45,830 --> 00:00:46,850
.لتلتقي بأخيكَ الأصغر

18
00:00:46,860 --> 00:00:48,060
...أنت

19
00:00:48,760 --> 00:00:50,290
.أصابها... مكروهٌ

20
00:00:54,290 --> 00:01:01,210
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

21
00:01:01,370 --> 00:01:08,990
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

22
00:01:09,000 --> 00:01:15,440
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

23
00:01:15,450 --> 00:01:21,200
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

24
00:01:22,410 --> 00:01:29,490
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

25
00:01:29,500 --> 00:01:37,190
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

26
00:01:37,200 --> 00:01:44,070
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

27
00:01:44,080 --> 00:01:49,750
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

28
00:01:50,450 --> 00:01:57,820
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

29
00:01:57,830 --> 00:02:04,530
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

30
00:02:04,540 --> 00:02:10,780
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

31
00:02:10,780 --> 00:02:18,120
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

32
00:02:46,140 --> 00:02:47,840
.أبي، عُدتَ

33
00:02:48,610 --> 00:02:50,940
،تعالَ يا كَانغ
.لتلتقي بأخيكَ الأصغر

34
00:02:56,010 --> 00:02:57,410
هل لي أخٌ أصغر؟

35
00:02:58,150 --> 00:03:00,300
،وُلِدتما توأمين

36
00:03:00,780 --> 00:03:02,370
.لكنّك كُنت هزيلًا عند الولادة

37
00:03:03,020 --> 00:03:06,220
وقد تنبّأَ أحدُ الخالدين بأنّ
.قدركُما أن تكونا عدوّين

38
00:03:06,690 --> 00:03:09,490
لذلك كانَ علينا تربيتكُما مُنفصلين
.حتّى تبلغا السّابعة مِن عُمركما

39
00:03:09,720 --> 00:03:11,180
...والآن حانَ الوقت

40
00:03:11,400 --> 00:03:13,060
.لتلتقِيا

41
00:03:15,530 --> 00:03:17,370
.مرحبًا، اسمي هُوا كَانغ

42
00:03:18,020 --> 00:03:21,320
:أضافَ الخالدُ قائلًا
،أنّ تعافيكَ التّام

43
00:03:21,630 --> 00:03:23,100
مشروطٌ بإقامة أخيكَ
،الصّغير معكَ

44
00:03:23,110 --> 00:03:25,110
في نفس المسكن
.حتّى تبلغَ السّادسة عشرة

45
00:03:25,320 --> 00:03:27,610
!لكن حذارِ أن يعلمَ أحدٌ بهذا

46
00:03:28,510 --> 00:03:30,510
كما لا يُسمح له بالخُروج
،مِن باحة الدّار

47
00:03:30,950 --> 00:03:32,150
،وإن زارنا غريبٌ

48
00:03:32,320 --> 00:03:33,760
.فعليه أن يختبئَ في غُرفتك

49
00:03:34,250 --> 00:03:36,750
ماذا؟ إنّني أشعرُ بالأسف
.مِن أجله

50
00:03:37,530 --> 00:03:40,320
أبي، ألا يُمكننا سؤال
الخالد عن طريقةٍ أُخرى؟

51
00:03:40,340 --> 00:03:40,940
!كفى كلامًا فارغًا

52
00:03:41,440 --> 00:03:44,150
كيف تجرؤُ على التّشكيك
في كلام الخالد؟

53
00:03:44,900 --> 00:03:45,850
...ثُمّ إنّ أخاكَ

54
00:03:46,090 --> 00:03:48,150
.قد وافق على هذا بنفسه

55
00:03:49,480 --> 00:03:51,900
،أجل
.اخترتُ هذا بطوعِ إرادتي

56
00:03:53,260 --> 00:03:54,920
إنّني أشعرُ بالأسف
.لأجلكَ يا أخي

57
00:03:56,540 --> 00:03:57,420
،عندما نبلغُ السّادسة عشرة

58
00:03:57,890 --> 00:03:59,820
.سأُرافقكَ إلى أي مكانٍ تختاره

59
00:04:04,470 --> 00:04:07,090
،أبي
.لم تُخبرني باسمهِ بعد

60
00:04:07,430 --> 00:04:08,830
،إنّه لن يُغادر هذه الدّار أبدًا

61
00:04:08,970 --> 00:04:10,370
.لذا فلا حاجةَ لهُ باسمٍ يُميّزه

62
00:04:12,690 --> 00:04:14,290
كيف يُمكنك قولُ ذلك يا أبي؟

63
00:04:15,260 --> 00:04:16,870
،طوال هذه السّنوات
.لم تكُن بجانب أبي

64
00:04:16,880 --> 00:04:19,330
هُو لا يعرفُ كيف يُظهر
.مشاعرهُ فحسب

65
00:04:24,440 --> 00:04:25,810
.كلا، لا تبكِ

66
00:04:27,260 --> 00:04:30,050
.أجل! سأمنحُكَ اسمًا

67
00:04:31,150 --> 00:04:31,980
...دعني أُفكّر

68
00:04:32,010 --> 00:04:33,180
،أنا اسمي هُوا كَانغ

69
00:04:33,200 --> 00:04:34,720
.وسيكونُ اسمكَ هُوا تُسونغ

70
00:04:36,490 --> 00:04:37,570
هُوا تُسونغ؟

71
00:04:39,200 --> 00:04:40,650
،حينما أبلغُ السّادسة عشرة

72
00:04:41,000 --> 00:04:42,980
،سأستعيدُ وافرَ عافيتي
،ومع رجاحةِ عقلك

73
00:04:42,990 --> 00:04:44,870
نحن سنَمتطي خُيولنا
،لنجوبَ عالم القتال

74
00:04:44,880 --> 00:04:46,170
.ونرى الجبال والأنهار

75
00:04:46,180 --> 00:04:47,180
فما قولُكَ؟

76
00:07:05,350 --> 00:07:07,680
.أصبحتَ مُقربًا للغاية مِن كَانغ

77
00:07:08,130 --> 00:07:10,450
أنت مَن ألزمني البقاء
،في هذه الدّار

78
00:07:10,460 --> 00:07:12,260
كيف لي ألا أُصبح مُقربًا منه؟

79
00:07:12,520 --> 00:07:15,190
،لا داعي لأيّ عواطفَ بينكَ وبينه

80
00:07:15,800 --> 00:07:17,800
.ما عليكَ إلّا أن تُؤدّي واجبكَ

81
00:07:18,650 --> 00:07:20,230
...وما ألزمتُكَ البقاء جواره

82
00:07:20,250 --> 00:07:22,110
،إلّا لتُقلّده

83
00:07:22,440 --> 00:07:23,980
.حتّى تحلّ محلّه يومًا

84
00:07:25,180 --> 00:07:26,890
!لم أجمعكُما معًا لتعيشا كإخوةٍ

85
00:07:28,310 --> 00:07:31,690
سيأتي يومٌ يفنى فيه
.أحدكُما ليبقى الآخر

86
00:07:38,740 --> 00:07:40,370
كَانغ، ما الخطب؟

87
00:07:44,300 --> 00:07:45,060
،أبي

88
00:07:45,270 --> 00:07:47,650
...ما الّذي تقصدهُ

89
00:07:47,680 --> 00:07:49,610
بأنّ أحدنا سيَفنى؟

90
00:07:50,040 --> 00:07:51,500
عمّ تتحدّث؟

91
00:07:51,510 --> 00:07:53,370
،كَانغ
.لا بُدّ أنّك لا تزالُ تحلم

92
00:07:54,030 --> 00:07:55,150
...ولكنّني أنا

93
00:07:55,500 --> 00:07:57,710
هيّا، دعنا نُعيدكَ
.إلى الفراش

94
00:08:15,300 --> 00:08:16,800
.كَانغ، أنت مستيقظٌ

95
00:08:26,170 --> 00:08:27,580
...جاء بكَ أبي إلى هُنا

96
00:08:28,080 --> 00:08:29,710
...لتحلّ محلّي

97
00:08:30,470 --> 00:08:31,930
بعد موتي، أَليس كذلك؟

98
00:08:33,190 --> 00:08:35,250
،سيُخبر الجميع أنّني تعافيتُ

99
00:08:36,080 --> 00:08:38,340
.وأنّ ابنه لم يعُد مريضًا هزيلًا

100
00:08:39,500 --> 00:08:42,290
هكذا إذن... كان أبي يشعرُ
.بالخزي منّي على الدّاوم

101
00:08:43,230 --> 00:08:44,600
.حسنًا، لا بأس بذلك

102
00:08:45,710 --> 00:08:48,170
في ذلك الحين، سيَحظى أبي
،بابنٍ موفور الصّحة

103
00:08:48,520 --> 00:08:51,520
وستحملُ أنت اسمًا
.تفتخرُ به بين النّاس

104
00:08:52,540 --> 00:08:54,340
هل تجدُ ذلك مقبولًا؟

105
00:08:56,290 --> 00:08:56,830
،أجل

106
00:08:58,010 --> 00:08:59,680
،فأيّامي معدودةٌ في هذه الدّنيا

107
00:09:01,830 --> 00:09:02,830
...لذا عِش حياةً طيّبة

108
00:09:03,770 --> 00:09:04,980
.مِن أجلي

109
00:09:05,950 --> 00:09:08,570
.عِش... مِن أجلي

110
00:09:10,760 --> 00:09:13,220
.عِش حياةً طيّبة

111
00:09:34,540 --> 00:09:35,470
هل بكَ خطبٌ؟

112
00:09:37,260 --> 00:09:39,190
إنّ أنفاس سيّدتي بدأت
.تضعفُ شيئًا فشيئًا

113
00:09:39,470 --> 00:09:41,350
لماذا لم يصل اللّورد
جِينغ شُون بعد؟

114
00:09:52,340 --> 00:09:53,760
!وصلَ أخيرًا

115
00:09:58,880 --> 00:10:00,000
!اللّورد جِينغ شُون

116
00:10:06,040 --> 00:10:06,880
لِي شِياو؟

117
00:10:10,810 --> 00:10:12,680
!لِي شِياو

118
00:10:14,970 --> 00:10:16,840
هل قدِمتَ لتُنقذ الخالدة؟

119
00:10:16,870 --> 00:10:17,980
—إنّها

120
00:10:18,000 --> 00:10:18,750
.أنا أعلمُ

121
00:10:18,780 --> 00:10:20,310
،لا تقلق
.اترُك المُهمّة لي

122
00:10:21,890 --> 00:10:23,550
...لِي شِياو

123
00:10:23,570 --> 00:10:24,820
.أخرِجها إلينا سالمةً

124
00:10:34,330 --> 00:10:35,990
كم مضى على احتجازِها
في الدّاخل؟

125
00:10:36,600 --> 00:10:38,150
.ساعتان تقريبًا

126
00:10:38,710 --> 00:10:41,040
لا يُمكن للنّاس العاديّين
،إبطالُ حاجزها

127
00:10:41,240 --> 00:10:42,610
،وإذا اقتحمناهُ قسرًا

128
00:10:42,630 --> 00:10:44,300
.فقد يُحدث ذلك صدمةً لها

129
00:10:44,730 --> 00:10:46,060
،إنّها مصابةٌ بالفِعل

130
00:10:46,370 --> 00:10:48,680
وقد مرّت عبر ذكريات
.الكثير مِن أطياف السّراب

131
00:10:48,690 --> 00:10:49,790
لن تكونَ قادرةً
.على تحمّل ذلك

132
00:10:49,800 --> 00:10:50,930
ما هِي خُطّتك؟

133
00:10:51,820 --> 00:10:53,250
لديّ الختم السحريّ
.الّذي منحتني إيّاه

134
00:10:53,260 --> 00:10:54,660
.يُمكنني الوُلوج وإنقاذها

135
00:10:55,510 --> 00:10:58,220
وما أدرانِي أنّك لا تنتهزُ
الفُرصة لتهرُب؟

136
00:10:59,260 --> 00:11:00,520
.لا يُمكنني المُجازفة

137
00:11:05,040 --> 00:11:07,770
مُنذ عشر سنين، بجانب
،كهف النّار في مُرتفع فِنغشو

138
00:11:08,810 --> 00:11:10,670
.قُلتَ لي كلامًا مُماثلًا

139
00:11:17,220 --> 00:11:18,350
،وها أنا ذا قد عُدت

140
00:11:18,900 --> 00:11:21,940
،فهل خذلتُ ثقتكَ بي
أيّها القائد الأعلى؟

141
00:11:24,640 --> 00:11:25,550
،شُو جُوان جُوان

142
00:11:27,210 --> 00:11:29,010
،انتظرتهِ طوال هذا الوقت

143
00:11:29,050 --> 00:11:30,430
.وها هُو قد عادَ صدقًا

144
00:12:11,970 --> 00:12:13,350
...هذه الهالة

145
00:12:14,910 --> 00:12:17,000
!اتّضحَ أنّهُ أنت

146
00:13:18,500 --> 00:13:19,900
!جُوان جُوان! أفقتِ

147
00:13:21,750 --> 00:13:22,770
كيف حالُكِ الآن؟

148
00:13:24,190 --> 00:13:25,690
هل ما زلتِ تشعرينَ بالتّوعك؟

149
00:13:32,500 --> 00:13:33,430
أين لِي شِياو؟

150
00:13:33,890 --> 00:13:34,970
.لم يعُد بعد

151
00:13:36,040 --> 00:13:37,040
لم يعُد بعد؟

152
00:13:37,960 --> 00:13:39,710
كيف عُدت أنا؟

153
00:13:39,920 --> 00:13:42,290
.أعادكِ اللّورد جِينغ شُون

154
00:13:45,170 --> 00:13:47,790
...لكنّني أتذكّر يقينًا

155
00:13:52,700 --> 00:13:53,610
أين هُو؟

156
00:13:54,390 --> 00:13:56,260
.اعترفَ لِي شِياو بكُلّ شيءٍ

157
00:13:56,270 --> 00:13:58,070
،واقتادوهُ إلى مُنحدر قِيان رِين

158
00:13:58,790 --> 00:13:59,670
.وسيُعدم قريبًا

159
00:13:59,680 --> 00:14:00,570
اعترفَ؟

160
00:14:01,240 --> 00:14:02,330
...لم يكُن لهُ علاقةٌ

161
00:14:02,350 --> 00:14:03,750
.بقضيّة هُوا فِينغ يُو

162
00:14:03,790 --> 00:14:05,050
!فما عساهُ أن يعترفَ به؟

163
00:14:05,670 --> 00:14:06,590
!أخبرنِي

164
00:14:06,820 --> 00:14:07,950
...آنذاك، بينما أنتِ

165
00:14:09,260 --> 00:14:11,930
ماذا؟ تِيان كوَان عالقةٌ
في قاع بُحيرة جِي يِي؟

166
00:14:12,550 --> 00:14:15,150
أَلم آمُر تِيان كوَان ألّا
تتدخّل في هذه القضيّة؟

167
00:14:15,480 --> 00:14:17,740
كيف سمحتَ لها بالذّهاب
لإثارة المشاكل هكذا؟

168
00:14:21,640 --> 00:14:24,260
كيف حالُ تِيان كوَان الآن؟

169
00:14:24,930 --> 00:14:27,460
،ضحّت بنفسها لوضع الحاجز

170
00:14:27,830 --> 00:14:29,860
.وهِي عالقةٌ داخله وفاقدةٌ للوعي

171
00:14:29,870 --> 00:14:31,070
!الوضعُ في غاية الخُطورة

172
00:14:31,930 --> 00:14:33,750
ولا يُمكن سوى لشخصٍ يحملُ
...ختم قصر بَان يُوي السحريّ

173
00:14:33,760 --> 00:14:34,960
.الوُلوج وإنقاذها

174
00:14:36,230 --> 00:14:37,410
،أنا، لِي شِياو

175
00:14:37,440 --> 00:14:39,370
.أتطوّع لإنقاذ الخالدة

176
00:14:40,010 --> 00:14:42,010
،قضيّتكَ لم تنتهِ بعد

177
00:14:42,030 --> 00:14:43,760
فكيفَ يُمكنك التّجول كما تشاء؟

178
00:14:44,530 --> 00:14:46,620
،وعلاوةً على ذلك
،أنت مُجرّد طائرٍ شيطانيّ

179
00:14:47,180 --> 00:14:50,470
فما القُدرة الّتي تملكُها لتحُلّ مُعضلةً
عجزت عنها تِيان كوَان، إلهةُ الحرب؟

180
00:14:51,410 --> 00:14:52,990
...أشكّ في أن هذه مُجرّد

181
00:14:53,300 --> 00:14:54,840
!حيلةٍ للفرار

182
00:14:55,220 --> 00:14:57,430
،جلالتك، المسألةُ طارئةٌ

183
00:14:57,930 --> 00:14:59,550
.لذا أنا أتطوّع لمُرافقته بنفسي

184
00:14:59,560 --> 00:15:02,340
،وإن وقعَ أيّ خللٍ
.سأتحمّل المسؤوليّة كاملةً

185
00:15:02,350 --> 00:15:03,510
،لُورد جِينغ شُون

186
00:15:03,760 --> 00:15:06,010
هذا الخطب يتعلّق
،بشيطان السّراب

187
00:15:06,170 --> 00:15:06,850
—وإن لم نكشف حقيقةَ هذا

188
00:15:06,860 --> 00:15:08,000
...تعرّض هُوا فِينغ يُو وأهلُ بيته

189
00:15:08,010 --> 00:15:09,920
،للتسمّم بـ لُبّ اللّهب
.وهُو نوعٌ مِن أعشاب الأشباح

190
00:15:09,930 --> 00:15:12,860
،إنّه يُشبه نباتَ الجِينسينغ
.بأوراقٍ وجُذور حمراء

191
00:15:13,440 --> 00:15:15,570
وإذا شربَ البشر
،نبيذًا مصنوعًا منه

192
00:15:15,940 --> 00:15:18,600
ستَسري في عظامهم
،حرارةٌ كالحديد المُنصهر

193
00:15:19,380 --> 00:15:21,840
لتلتهمَ أحشاءهُم ودماءهُم
،مِن الدّاخل

194
00:15:22,530 --> 00:15:26,490
حتّى ينتهي بهم المطاف بالتّحول
.إلى جُنودٍ موتى مِن أطياف النّار

195
00:15:27,510 --> 00:15:28,760
!أيقنتُ أنّك الجاني

196
00:15:29,640 --> 00:15:32,260
سأمنحُ جلالتك ترياقَ
.هذه العُشبة

197
00:15:32,740 --> 00:15:34,940
.أرجوكَ ائذن لي بإنقاذ الخالدة

198
00:15:35,140 --> 00:15:37,840
فلا أحدَ غيري يُمكنه
!إنقاذها في هذه اللّحظة

199
00:15:38,410 --> 00:15:41,870
هل تعترفُ بجُرمكَ؟

200
00:15:42,760 --> 00:15:45,820
وأيّ عقابٍ تستحقّ؟

201
00:15:47,140 --> 00:15:48,600
،بعد أن أنقذَ الخالدة

202
00:15:48,640 --> 00:15:51,180
لجلالتك مُطلق الحُريّة في
.أن تحكم عليّ بما تراهُ

203
00:15:53,340 --> 00:15:54,420
...تركته يتحمّل

204
00:15:54,740 --> 00:15:57,030
اللّوم هكذا فحسب؟

205
00:15:57,860 --> 00:16:00,860
كانت هذه الطّريقة
.الوحيدة لإنقاذكِ

206
00:16:03,840 --> 00:16:05,180
.خُذني إليه

207
00:16:45,970 --> 00:16:46,810
.لِي شِياو

208
00:16:48,080 --> 00:16:48,830
!لِي شِياو

209
00:16:51,570 --> 00:16:54,160
.جئتُ لأُخبركَ أنّني بخيرٍ

210
00:16:54,660 --> 00:16:56,690
.لا تقلق، وانتظرنِي

211
00:16:56,720 --> 00:16:58,580
سأعودُ لأصحبكَ معي
.في القريب العاجل

212
00:17:04,420 --> 00:17:07,100
أنتِ تعلمينَ أنّ جلالته كانَ
.دائم الحذر مِن عُشبة الأشباح

213
00:17:07,100 --> 00:17:09,770
والآن بعد أن كشفَ لِي شِياو الكثير
،مِن المعلومات عن هذا العُشب

214
00:17:10,220 --> 00:17:11,900
،حتّى وإن سقطت عنهُ التّهمة

215
00:17:11,910 --> 00:17:13,440
فإنّ رغبةَ جلالته
...في التّخلص منهُ

216
00:17:13,680 --> 00:17:14,910
.لن تتغيّر بسُهولةٍ

217
00:17:16,550 --> 00:17:17,590
،حينها

218
00:17:18,160 --> 00:17:19,560
أنا أعلمُ يقينًا أنّك
.لن تقفَ بجانبي

219
00:17:21,790 --> 00:17:22,710
،لكن على الأقلّ

220
00:17:23,440 --> 00:17:24,640
،أرجوكَ ألّا تعترض سبيلي

221
00:17:25,320 --> 00:17:26,930
.فلا رغبةَ لي في مُعاداتك

222
00:17:29,310 --> 00:17:30,230
،أيّتها الثّعلبة السّاذجة

223
00:17:31,600 --> 00:17:33,100
!أنتِ لا تعلمينَ قطعًا

224
00:17:36,580 --> 00:17:38,520
،طُويت قضيّة بُحيرة جِي يِي

225
00:17:38,530 --> 00:17:40,990
وقد أرسلتُ هُوا كَانغ
.خارجَ عالم هُونغ مِينغ

226
00:17:45,450 --> 00:17:47,260
!قفِي مكانكِ
!لا يُسمح بالدّخول

227
00:17:47,720 --> 00:17:48,380
!تنحّوا جانبًا

228
00:17:54,210 --> 00:17:55,220
،أنا، تِيان كوَان

229
00:17:55,690 --> 00:17:58,500
ألتمسُ مِن جلالتك أن تُعيد
.النّظر في قضيّة بُحيرة جِي يِي

230
00:17:59,290 --> 00:18:00,500
،أيّتها الخالدة تِيان كوَان

231
00:18:00,780 --> 00:18:02,910
زادَ تجاوزكِ للقوانين
!والأعراف عن الحُدود

232
00:18:03,100 --> 00:18:03,900
،جلالةَ الملك

233
00:18:04,730 --> 00:18:07,460
لديّ دليلٌ يُثبت أنّ
.لِي شِياو تعرّض للظّلم

234
00:18:07,760 --> 00:18:09,440
.والقاتلُ الحقيقيّ شخصٌ آخر

235
00:18:09,450 --> 00:18:10,760
،أرجو أن تحكمَ بالعدل
.يا جلالةَ الملك

236
00:18:10,770 --> 00:18:11,730
!هراءٌ

237
00:18:12,180 --> 00:18:14,510
،طُويت القضيّة، ولدينا الأدلّة

238
00:18:14,520 --> 00:18:16,320
،وأقرّ الجاني بجُرمه

239
00:18:16,660 --> 00:18:18,320
.لا حاجةَ لإعادة المُحاكمة

240
00:18:20,510 --> 00:18:22,710
قُلت إنّني أستطيعُ إثباتَ
،أنّ هذه قضيّةٌ غير عادلةٍ

241
00:18:23,290 --> 00:18:25,380
لكنّك يا سُموّ الأمير شِيان
،لم تُكلّف نفسكَ عناء السّؤال

242
00:18:25,390 --> 00:18:27,590
وتسعى لإغلاق القضيّة
!على عجلٍ

243
00:18:27,680 --> 00:18:29,050
مِمّ أنت خائفٌ؟

244
00:18:31,240 --> 00:18:33,780
لو أنّ كُلّ حُكمٍ أُعيد
،النّظر فيه تبعًا للأهواء

245
00:18:34,210 --> 00:18:36,470
فكيفَ نصونُ مهابة
هُونغ مِينغ إذن؟

246
00:18:38,390 --> 00:18:40,390
،إنّك لا تكترثُ بإقامة العدل

247
00:18:40,400 --> 00:18:41,930
!بل تهتمّ بالصّيت والمظاهر

248
00:18:43,190 --> 00:18:46,020
!إنّ ذلك لهُو الخزي الحقيقيّ

249
00:18:47,050 --> 00:18:47,850
!كيف تتجرّئين

250
00:19:00,760 --> 00:19:01,550
!كُفّي عن هذا

251
00:19:12,290 --> 00:19:13,670
،نجوتِ لتوّكِ مِن الموت

252
00:19:14,760 --> 00:19:16,960
هل تظنّين أنّكِ لا تُقهرين؟

253
00:19:17,370 --> 00:19:18,730
...حتّى لو حاولتَ منعي

254
00:19:18,740 --> 00:19:19,450
!تِيان كوَان

255
00:19:20,260 --> 00:19:24,060
،إنّكِ متغطرسةٌ للغاية
.تظنّين أنّ جلالته يُحابيكِ

256
00:19:24,360 --> 00:19:27,490
إنّ هُونغ مِينغ ما أُقيمت إلّا لنُصرة
.الحقّ ودفع الظّلم في العالم

257
00:19:28,060 --> 00:19:30,860
إذا كانَ هُناك شخصٌ
،بريء يتعرّض للظّلم

258
00:19:30,940 --> 00:19:33,610
فإنّ قوسَ القمر في يدي مسؤولٍ
...ضئيل عن السّحاب مثلي

259
00:19:33,620 --> 00:19:34,680
.لن يسمحَ بذلك

260
00:19:36,220 --> 00:19:38,480
!فما بالُكِ بملكنا العادل

261
00:19:42,170 --> 00:19:42,840
،أجل

262
00:19:43,590 --> 00:19:44,390
،جلالتك

263
00:19:45,580 --> 00:19:46,910
،كُنت طائشةً قبل هُنيهةٍ

264
00:19:47,300 --> 00:19:50,060
لشدّة رغبتي في تقديم الدّليل
،الجديد بأسرع وقتٍ مُمكن

265
00:19:50,070 --> 00:19:51,400
.فأنساني ذلك آدابي

266
00:19:51,530 --> 00:19:52,820
.أرجوكَ أن تُعاقبني

267
00:19:54,250 --> 00:19:56,040
ما عساهُ أن يكون هذا
الدّليل الجديد؟

268
00:19:56,770 --> 00:19:59,670
طيفُ السّراب للضحيّة الّتي
،وجدتها في قاع بُحيرة جِي يِي

269
00:19:59,680 --> 00:20:01,300
.وفي جوفه تنكشفُ الحقيقة

270
00:20:01,720 --> 00:20:03,360
سيَفهمُ جلالته بمُجرّد
.أن يقعَ نظرهُ عليه

271
00:20:03,370 --> 00:20:04,100
!كيف تتجرّئين

272
00:20:04,330 --> 00:20:06,660
إنّ استراقَ النّظر إلى مكنون
،السّراب يستنزفُ رُوح المرء

273
00:20:06,670 --> 00:20:08,730
هل تُريدين مِن جلالته
أن يُخاطر بحياته؟

274
00:20:08,750 --> 00:20:10,090
!هذا شنيعٌ

275
00:20:12,010 --> 00:20:13,250
.لكنّها مُجرّد لمحةٍ خاطفة

276
00:20:13,260 --> 00:20:14,990
—جلالةُ الملك، هل تتذكّر

277
00:20:15,390 --> 00:20:17,360
،بعد المعركة في أرض السّراب

278
00:20:17,370 --> 00:20:20,030
أنت منحتني بقايا
.رُوح شيطان السّراب

279
00:20:21,240 --> 00:20:23,310
...طوّرتُ تعويذةً

280
00:20:24,210 --> 00:20:25,380
...مِن تلك الرّوح

281
00:20:25,750 --> 00:20:28,260
لإظهار المشاهد الخفيّة
.داخل الطّيف

282
00:20:28,270 --> 00:20:30,320
متى قامَ بإعداد هذه؟

283
00:20:30,960 --> 00:20:33,750
.حسنًا، لنَنظُر إذن

284
00:20:34,890 --> 00:20:36,130
.شُكرًا لك، يا جلالةَ الملك

285
00:20:36,140 --> 00:20:37,790
،هذا المسألة تتعلّق بعائلة هُوا

286
00:20:37,800 --> 00:20:39,920
وأودّ أن أدعو الشّاهد الوحيد
،في هذه القضيّة، هُوا كَانغ

287
00:20:39,930 --> 00:20:41,130
.ليَرى المشهد معنا

288
00:20:41,440 --> 00:20:43,170
،أرجوكَ اسمح بذلك
.يا جلالةَ الملك

289
00:20:44,770 --> 00:20:46,630
أين ابنُ عائلة هُوا؟

290
00:20:46,890 --> 00:20:47,850
،جلالةُ الملك

291
00:20:48,390 --> 00:20:49,850
،مُنذ أن طُويت القضيّة

292
00:20:50,260 --> 00:20:52,280
أرسلتُ شخصًا لمُرافقته
.خارجَ القصر

293
00:20:52,290 --> 00:20:53,420
،وحسبَ تقديري

294
00:20:53,490 --> 00:20:55,000
فإنّه لم يتجاوز بوّابة
.السّماء الجنوبيّة بعد

295
00:20:55,010 --> 00:20:57,100
.إذن استدعِه للعودة

296
00:20:57,120 --> 00:20:57,620
.سمعًا وطاعة

297
00:21:04,010 --> 00:21:04,840
!رُويدك

298
00:21:05,950 --> 00:21:07,740
استدعى جلالةُ الملك هُوا كَانغ
.للعودة إلى القصر لاستجوابه

299
00:21:07,750 --> 00:21:08,720
.فليعُد معي سريعًا

300
00:21:08,730 --> 00:21:09,360
.حسنًا

301
00:21:10,260 --> 00:21:11,140
،سيّد هُوا

302
00:21:11,160 --> 00:21:13,090
—استدعاكَ جلالته للعودة

303
00:21:20,380 --> 00:21:22,240
ماذا حدث؟
أين هُوا كَانغ؟

304
00:21:23,040 --> 00:21:23,790
،أيّها الأمير شِيان

305
00:21:24,050 --> 00:21:25,140
...أُمرت باستقبال

306
00:21:25,160 --> 00:21:26,760
،عربة هُوا كَانغ

307
00:21:27,010 --> 00:21:29,450
،ولكن عندما فتحتُ الباب
—لم يكُن لـ هُوا كَانغ أيّ أثرٍ

308
00:21:29,460 --> 00:21:30,420
!ولم أجدُ سوى هذا الرّجل

309
00:21:31,380 --> 00:21:33,350
...رأيتهُ بنفسي

310
00:21:33,380 --> 00:21:35,510
وهُو يحملُ السيّد هُوا
.ويضعهُ في العربة

311
00:21:35,770 --> 00:21:37,690
...لماذا اختفى السيّد هُوا

312
00:21:37,720 --> 00:21:39,520
وأنت مَن في داخل العربة؟

313
00:21:39,530 --> 00:21:41,990
جلالتك، أنا حارسٌ في
.القاعة الجانبيّة

314
00:21:42,260 --> 00:21:44,690
بعد أن حملتُ السيّد
،هُوا إلى داخل العربة

315
00:21:44,700 --> 00:21:46,160
.باغتني أحدهُم وأفقدنِي الوعي

316
00:21:46,190 --> 00:21:47,780
ولما استفقتُ، وجدتُ
!نفسي داخل العربة

317
00:21:47,790 --> 00:21:49,530
،لا عِلم لي بما جرى بعد ذلك

318
00:21:49,560 --> 00:21:50,870
،أرجوكَ أن تحكُمَ بالعدل
!يا جلالةَ الملك

319
00:21:50,880 --> 00:21:52,540
!عديمُ الفائدة! أيّها الحراس

320
00:21:53,070 --> 00:21:54,230
!خُذوه بعيدًا

321
00:21:54,300 --> 00:21:55,050
.سمعًا وطاعة

322
00:21:56,780 --> 00:22:00,310
هل يُمكن أن تكونَ بقايا رُوح شيطان
السّراب هِي الّتي اختطفت هُوا كَانغ؟

323
00:22:00,680 --> 00:22:02,480
،أيّها الأمير شِيان
.بالغتَ في قلقِك

324
00:22:03,400 --> 00:22:05,510
ذلك السيّد الشّاب
...لعائلة هُوا سابقًا

325
00:22:05,520 --> 00:22:06,850
.لم يكُن هُوا كَانغ

326
00:22:07,600 --> 00:22:08,260
ماذا؟

327
00:22:08,740 --> 00:22:09,910
...مَن أحضرتهُ هُو

328
00:22:10,170 --> 00:22:12,910
،طيفُ سراب هُوا كَانغ
.السّيد الشّاب لعائلة هُوا

329
00:22:12,920 --> 00:22:13,780
،بمعنى آخر

330
00:22:14,310 --> 00:22:15,550
...فإنّ هُوا كَانغ الحقيقيّ

331
00:22:15,580 --> 00:22:18,310
قد تحوّل إلى طيف نارٍ
.في بُحيرة جِي يِي

332
00:22:18,410 --> 00:22:20,120
لا بُدّ أنّ شخصًا ما قد
...تنكّر بهيئة

333
00:22:20,130 --> 00:22:21,700
.شاهد هذه القضيّة

334
00:22:21,860 --> 00:22:23,200
ما الخطب؟

335
00:22:24,590 --> 00:22:25,590
كيف يُعقل هذا؟

336
00:22:27,250 --> 00:22:29,080
إنّه لم يتذوّق قطرةً
،مِن ذلك النّبيذ

337
00:22:30,080 --> 00:22:32,370
!أرسلتهُ بالفِعل إلى مكانٍ آمن

338
00:22:33,190 --> 00:22:35,680
!إنّه أنت حقًا -
كيف يُعقل هذا؟ -

339
00:22:35,710 --> 00:22:36,790
.هُوا تُسونغ

340
00:22:38,970 --> 00:22:40,470
...أم يجبُ أن أدعوكَ

341
00:22:41,330 --> 00:22:42,580
تَاي سُوي؟

342
00:22:49,190 --> 00:22:56,230
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

343
00:22:56,290 --> 00:23:04,830
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

344
00:23:06,870 --> 00:23:11,570
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

345
00:23:11,580 --> 00:23:16,240
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

346
00:23:16,250 --> 00:23:20,070
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

347
00:23:20,080 --> 00:23:24,570
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

348
00:23:24,580 --> 00:23:29,280
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

349
00:23:29,290 --> 00:23:33,940
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

350
00:23:33,950 --> 00:23:39,150
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

351
00:23:39,160 --> 00:23:43,150
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

352
00:23:43,160 --> 00:23:48,280
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

353
00:23:48,290 --> 00:23:52,780
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

354
00:23:52,790 --> 00:23:57,740
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

355
00:23:57,750 --> 00:24:02,190
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

356
00:24:07,330 --> 00:24:13,410
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟