1
00:00:15,330 --> 00:00:22,240
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

2
00:00:22,250 --> 00:00:29,820
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

3
00:00:29,830 --> 00:00:36,320
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

4
00:00:36,330 --> 00:00:42,080
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

5
00:00:43,290 --> 00:00:50,360
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

6
00:00:50,370 --> 00:00:58,070
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

7
00:00:58,080 --> 00:01:04,940
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

8
00:01:04,950 --> 00:01:10,620
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

9
00:01:11,330 --> 00:01:18,690
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

10
00:01:18,700 --> 00:01:25,400
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

11
00:01:25,410 --> 00:01:31,650
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

12
00:01:31,660 --> 00:01:39,000
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

13
00:01:55,080 --> 00:01:57,120
!إنّه أنت حقًا
.هُوا تُسونغ

14
00:01:58,160 --> 00:01:59,860
...أم يجبُ أن أدعوكَ

15
00:01:59,870 --> 00:02:00,870
تَاي سُوي؟

16
00:02:05,160 --> 00:02:06,560
ماذا قُلتِ للتّو؟

17
00:02:06,700 --> 00:02:08,620
،لا داعي للمُراوغة الآن

18
00:02:09,280 --> 00:02:11,620
أم أنّك ستَدفعُني
لأستخدم القُوّة معكَ؟

19
00:02:16,700 --> 00:02:17,950
إنّه مخلوقٌ مِن
،كيانات التّاي سُوي

20
00:02:18,820 --> 00:02:20,990
والمُتسبّب في كارثة
.بُحيرة جِي يِي

21
00:02:21,000 --> 00:02:24,110
وقد تنكّر في هيئة هُوا كَانغ
.ليُلقي باللّوم على لِي شِياو

22
00:02:24,120 --> 00:02:26,780
كان ينوي الاختفاء
،بعد تنفيذ خُطّته

23
00:02:26,790 --> 00:02:29,440
لكنّه علِمَ عند بوّابة السّماء
.الجنوبيّة أنّنا نطلبُ شهادته مُجدّدًا

24
00:02:29,450 --> 00:02:30,940
،وخشيةَ أن ينفضحَ أمرهُ

25
00:02:30,950 --> 00:02:34,010
وفي لحظة ذُعرٍ، حاولَ التّنكر
.في هيئة حارسٍ ليلوذَ بالفرار

26
00:02:34,370 --> 00:02:36,070
!تبًا، كاد يخدعُنا

27
00:02:38,200 --> 00:02:40,740
،زعمتِ أنّ هُوا كَانغ قد مات
ماذا تقصدينَ بذلك؟

28
00:02:40,750 --> 00:02:44,150
تسمّم بـ لُبّ اللّهب
.وتحوّل إلى طيف نارٍ

29
00:02:44,410 --> 00:02:47,440
.محالٌ! غادرَ سالمًا

30
00:02:47,450 --> 00:02:49,180
،أنتِ تكذبينَ عليّ
أَليس كذلك؟

31
00:02:49,200 --> 00:02:51,280
ما أحملهُ في يدي هُو
.طيفُ السّراب الخاصّ به

32
00:02:51,290 --> 00:02:54,160
ستَنجلي الحقيقة لنا
.بنظرةٍ واحدة

33
00:03:22,370 --> 00:03:24,770
هكذا إذن... كان أبي يشعرُ
.بالخزي منّي على الدّاوم

34
00:03:25,320 --> 00:03:27,000
.حسنًا، لا بأس بذلك

35
00:03:28,290 --> 00:03:30,690
في ذلك الحين، سيَحظى أبي
،بابنٍ موفور الصّحة

36
00:03:31,000 --> 00:03:33,060
وستحملُ أنت اسمًا
.تفتخرُ به بين النّاس

37
00:03:35,450 --> 00:03:37,250
هل تجدُ ذلك مقبولًا؟

38
00:03:37,870 --> 00:03:39,870
،أجل

39
00:03:40,790 --> 00:03:42,790
،فأيّامي معدودةٌ في هذه الدّنيا

40
00:03:43,070 --> 00:03:45,540
...لذا عِش حياةً طيّبة
.مِن أجلي

41
00:03:46,700 --> 00:03:47,570
...أنا

42
00:03:47,570 --> 00:03:48,710
.لستُ أخاكَ

43
00:03:52,450 --> 00:03:55,250
محالٌ! فأنتَ نسخةٌ طِبق
!الأصل منّي

44
00:03:59,070 --> 00:04:00,080
.أنا مخلوقُ تَاي سُوي

45
00:04:02,200 --> 00:04:03,290
مخلوقُ تَاي سُوي؟

46
00:04:05,330 --> 00:04:06,700
...ما زِلت أذكرُ ما جاء في الكُتب

47
00:04:07,250 --> 00:04:10,050
عن أنّ التّاي سُوي هُو شيطانٌ
.يتمثّل في هيئة شخصٍ ما

48
00:04:12,620 --> 00:04:13,950
!هكذا إذن

49
00:04:14,830 --> 00:04:16,150
،حينما ألفظُ أنفاسي

50
00:04:16,160 --> 00:04:17,900
...تقمّصتَ شخصيّتي

51
00:04:17,910 --> 00:04:19,620
.لتفرّ مِن هذا المُعتقل

52
00:04:20,410 --> 00:04:21,040
!كلا

53
00:04:22,750 --> 00:04:24,190
...بل أنت مَن سيُغادر

54
00:04:24,200 --> 00:04:26,250
.هذا المكان لا أنا

55
00:04:29,370 --> 00:04:31,240
في سالفِ الدّهر
،وقديم الزّمان

56
00:04:31,250 --> 00:04:34,240
أُصيبَ طفلُ أحد المُمارسين
.الرّوحيين بمرضٍ عُضال

57
00:04:34,250 --> 00:04:36,150
ومِن أجل أن
،يُنقذَ حياة ابنه

58
00:04:36,150 --> 00:04:38,020
قامَ ذلك المُمارس الرّوحي
،بأسر مخلوقٍ مِن التّاي سُوي

59
00:04:38,540 --> 00:04:41,190
وجعلهُ يعيشُ جوارَ الصّبي
،العليل لسنواتٍ طويلة

60
00:04:41,200 --> 00:04:43,000
حتّى امتزجت أنفاسهُما
.وطاقتاهُما معًا

61
00:04:43,870 --> 00:04:45,570
وما إن بلغَ الصّبي
،سنّ السّادسة عشرة

62
00:04:45,580 --> 00:04:49,280
حتّى أقامَ الوالد طقسًا سحريًا
،لنقل رُوح ابنه إلى جسد التّاي سُوي

63
00:04:49,290 --> 00:04:51,870
...ليَحظى الولد بجسدٍ بديعٍ

64
00:04:52,290 --> 00:04:53,540
.ويُبعث حيًا مِن جديدٍ

65
00:04:54,900 --> 00:04:57,750
بعد شهرين، ستبلغُ
.السّادسة عشرة مِن عُمرك

66
00:04:58,400 --> 00:05:00,370
...أبي
هل فعلَ هذا حقًا؟

67
00:05:01,540 --> 00:05:03,290
!كلا، هذا غير معقولٍ

68
00:05:03,660 --> 00:05:04,590
!عليكَ أن تنجو بنفسكَ وتفرّ

69
00:05:04,950 --> 00:05:05,950
،لا يُمكنني الفرار

70
00:05:10,660 --> 00:05:12,070
،فقد قيّدوني بلعنة حبسٍ

71
00:05:12,080 --> 00:05:13,490
وما إن تطأ قدمي
،خارجَ الباحة

72
00:05:13,500 --> 00:05:14,870
.سيَعلمُ والدكَ

73
00:05:17,080 --> 00:05:18,280
،مضت تسعةُ أعوامٍ

74
00:05:19,040 --> 00:05:20,900
كُنت فيها أُمثّل نُسختكَ
،في كُلّ لحظةٍ

75
00:05:21,500 --> 00:05:24,760
وأتهيّأ مع كُلّ شهيقٍ وزفير
.ليوم ميلادكَ السّادس عشر

76
00:05:25,410 --> 00:05:28,290
!إنّهم يسلبونكَ رُوحكَ
!لن أقبلَ بهذا أبدًا

77
00:05:29,750 --> 00:05:32,610
إنّ ما فعلهُ أبي يُخالف
،قانونَ السّماء دُون شكّ

78
00:05:32,700 --> 00:05:35,650
لماذا وافقتَ؟
لماذا لم تُقاوم؟

79
00:05:36,000 --> 00:05:38,700
،في مُستهلّ الأمر
،لم أكُن راضيًا بالفِعل

80
00:05:39,450 --> 00:05:40,710
وأضمرتُ لكَ في
.داخلي كُرهًا

81
00:05:41,700 --> 00:05:43,240
،بيدَ أنّني مع مُرور الوقت
،ودُون أن أشعرَ

82
00:05:43,250 --> 00:05:44,900
.بدأتُ أتقبّل مصيري

83
00:05:45,150 --> 00:05:47,450
!أجل، تذكّرتُ الآن

84
00:05:48,500 --> 00:05:51,070
،أوّلُ موقفٍ خفّف مِن كُرهي لك

85
00:05:51,080 --> 00:05:52,540
.كانَ حين منحتني اسمًا

86
00:05:54,120 --> 00:05:56,570
،رُغم أنّك عاجزٌ لا تملكُ حيلةً

87
00:05:56,580 --> 00:05:58,310
إلّا أنّك ماهرٌ في
.أسر قُلوب مَن حولك

88
00:05:59,290 --> 00:06:02,040
".تُناديني دائمًا: "أخي، أخي

89
00:06:02,620 --> 00:06:05,950
حتّى أنّني كدتُ أنسى الهدف
.الّذي جئتُ لأجله في المقام الأوّل

90
00:06:06,200 --> 00:06:07,460
،لكن عندما أتفكّرُ فيما جرى

91
00:06:08,080 --> 00:06:11,820
أرى أنّ رحلتكَ في هذا العالم
...وتقلّبك في البلاد بدلًا منّي

92
00:06:11,830 --> 00:06:12,610
.ليست بالفكرة السيّئة

93
00:06:12,620 --> 00:06:14,370
!كلا، كلا، كلا

94
00:06:15,580 --> 00:06:17,180
،هذا سِحرٌ مُظلِم وقاتل

95
00:06:17,450 --> 00:06:18,830
!لن أقبلَ به قطعًا

96
00:06:20,450 --> 00:06:21,750
.لن أقبلَ به

97
00:06:26,700 --> 00:06:29,740
إنّ استغلال مخلوق التّاي سُوي
...لتشكيل جسدٍ بشريّ وتمديد عُمر ابنه

98
00:06:29,750 --> 00:06:32,250
هُو جرمٌ شيطانيّ
!يهدمُ كُلّ قيم المُروءة

99
00:06:34,400 --> 00:06:35,540
هل هُو ميّتٌ؟

100
00:06:36,080 --> 00:06:37,700
هل ماتَ بالفِعل؟

101
00:06:38,250 --> 00:06:40,440
،كيف لـ هُوا فِينغ يُو
،ملك الجنوب

102
00:06:40,450 --> 00:06:42,120
أن يرتكبَ جُرمًا كهذا؟

103
00:06:43,580 --> 00:06:47,030
إذن، نشأت بينكَ وبين
،هُوا كَانغ روابطُ

104
00:06:47,040 --> 00:06:48,650
.رُغم اختلاف جنسكُما

105
00:06:49,120 --> 00:06:52,290
لكن بعد أن هلكت عائلة
،هُوا كُلّها وماتَ هُوا كَانغ

106
00:06:53,000 --> 00:06:55,690
هل تراجعَ عن وعدهِ
...ورفضَ تحريرك

107
00:06:55,700 --> 00:06:57,330
فانتقمت منهُم بالقتل؟

108
00:07:00,200 --> 00:07:01,910
.كلا، حرّرني بنفسه

109
00:07:08,080 --> 00:07:10,400
،رُغم جسدهِ الهزيل والمريض

110
00:07:10,410 --> 00:07:13,610
فقد كانَ يتسلّل سرًا إلى جناح الكُتب
،لـ هُوا فِينغ يُو ليتعلّم تقنيات السّحر

111
00:07:14,290 --> 00:07:16,350
.ويفُكّ عنّي لعنةَ الحبس

112
00:07:20,750 --> 00:07:22,950
كان ذلك في ليلةِ عيد
.ميلاده السّادس عشر

113
00:07:23,540 --> 00:07:25,470
.لم تكُن لديّ نيّةٌ في الهرب

114
00:07:25,910 --> 00:07:28,040
كُنت أتمنّى أن يبقى
.على قيد الحياة

115
00:07:29,330 --> 00:07:31,330
كُلّ ما في الأمر أنّني لم أعُد
،إلى عائلتي لسنواتٍ عديدة

116
00:07:31,830 --> 00:07:33,890
وأردتُ أن أذهبَ
،لأودّعهم للمرّة الأخيرة

117
00:07:34,580 --> 00:07:37,450
فقد لا نلتقِي مُجدّدًا
.في هذه الحياة

118
00:07:38,900 --> 00:07:41,040
...لكن لم يُخيّل لي قطّ

119
00:07:49,950 --> 00:07:51,790
!أُمّي، أُمّي

120
00:08:06,830 --> 00:08:10,500
كيف يُمكن أن يحدثَ هذا؟

121
00:08:11,080 --> 00:08:11,940
!أُمّي

122
00:08:11,950 --> 00:08:14,250
!شيَاو لِينغ! شيَاو بَانغ

123
00:08:26,870 --> 00:08:30,370
هل تبتغي أن تعرفَ
مِن تسبّب بهذا؟

124
00:08:32,650 --> 00:08:33,450
مَن أنت؟

125
00:08:34,620 --> 00:08:38,530
أنا مُجرّد عابرٍ قادتني إلى هُنا
.صرخاتُ الأرواح المظلومة

126
00:08:38,950 --> 00:08:40,580
هل تعلمُ هويّة القاتل؟

127
00:08:41,080 --> 00:08:44,750
لماذا لا تشهدُ الفاجعة بعينيكَ؟

128
00:08:51,000 --> 00:08:53,200
!نارٌ! هُناك حريقٌ يشتعل

129
00:08:56,330 --> 00:08:58,260
،أُمّي
!أنا خائفٌ جدًا يا أُمّي

130
00:08:58,270 --> 00:09:01,000
،وضعَ شخصٌ ما حاجزًا
.المخارجُ مسدودةٌ

131
00:09:01,500 --> 00:09:04,500
لم يكُن ينبغي لي أن
!أثقَ بأكاذيب البشر

132
00:09:06,330 --> 00:09:07,700
،هُوا فِينغ يُو

133
00:09:11,000 --> 00:09:13,490
!أنا ألعنُكَ

134
00:09:13,500 --> 00:09:16,830
!ألعنُكَ وألعنُ كُلّ مَن تُحبّ

135
00:09:26,500 --> 00:09:27,620
،يا صغاري

136
00:09:29,290 --> 00:09:30,290
!لا تذعرُوا

137
00:09:31,330 --> 00:09:33,250
.أُمّكم ستَحميكُم

138
00:09:36,660 --> 00:09:37,410
.أُمّي

139
00:09:39,250 --> 00:09:40,580
.أُمّي

140
00:09:55,200 --> 00:09:57,370
!أُمّي

141
00:10:08,830 --> 00:10:12,790
هذا عشبُ شبحٍ تشكّل
.مِن ضغينة أُمّك

142
00:10:13,370 --> 00:10:15,290
.يُدعى لُبّ اللّهب

143
00:10:16,000 --> 00:10:18,400
،عندما يُمزج بالنّبيذ
.يتحوّل إلى سُمّ قاتلٍ

144
00:10:18,410 --> 00:10:21,530
ومَن يتجرّعه يستحيلُ في
،لمحِ البصر إلى طيف نارٍ

145
00:10:21,540 --> 00:10:23,700
.ويحرقُ كُلّ ما تمسّه يداهُ

146
00:10:24,250 --> 00:10:27,790
هل تبتغِي الثّأر؟

147
00:10:33,410 --> 00:10:35,620
أبادَ هُوا فِينغ يُو
،عشيرتي بأكملها

148
00:10:36,370 --> 00:10:39,370
خوفًا مِن أن ينفضحَ أمرُ
.استبداله لجسدِ ابنه

149
00:10:39,540 --> 00:10:40,790
!لم يكُن هُناك سببٌ آخر

150
00:10:41,750 --> 00:10:43,570
!بسببِ هذا فحسب

151
00:10:43,580 --> 00:10:46,200
أُبيدت عشيرة التّاي سُوي عن
!بكرةِ أبيها واستحالت رمادًا

152
00:10:47,330 --> 00:10:50,330
أخبروني، ألا يجبُ
...أن أدعهُم يشعرونَ

153
00:10:51,200 --> 00:10:56,290
بعظامهم وهِي تذوبُ كالحديد
المُنصهر تحت لهيبِ النّار؟

154
00:10:58,700 --> 00:10:59,440
.أعلى قليلًا

155
00:10:59,450 --> 00:11:00,400
هكذا؟

156
00:11:00,410 --> 00:11:00,690
.أجل

157
00:11:00,700 --> 00:11:02,100
.حرّكهُ نحو اليمين قليلًا

158
00:11:02,250 --> 00:11:02,780
.على مهلِك

159
00:11:02,790 --> 00:11:03,530
.ناولنِي هذا

160
00:11:03,540 --> 00:11:03,860
!انتبِه

161
00:11:03,870 --> 00:11:04,580
.رُويدًا رُويدًا

162
00:11:06,160 --> 00:11:07,360
نحنُ بحاجةٍ إلى بعضٍ
.منها هُنا أيضًا

163
00:11:07,620 --> 00:11:08,620
.حسنًا، ها أنا قادمٌ

164
00:11:19,000 --> 00:11:22,070
،سيّدي الشّاب
...كلّف السيّد طبيبًا معروفًا

165
00:11:22,080 --> 00:11:25,140
ليبحثَ عن جذر جِينسينغ أحمر
.نادرٍ ليصنعَ لك منهُ نبيذًا علاجيًا

166
00:11:25,410 --> 00:11:27,690
وقد مضى عليه الوقت
.الكافي ليجهزَ

167
00:11:27,700 --> 00:11:28,700
فما رأيكَ الآن؟

168
00:11:30,950 --> 00:11:31,870
.ضعيه جانبًا

169
00:11:32,410 --> 00:11:33,470
.أجل، أيّها السيّد الشّاب

170
00:11:51,160 --> 00:11:52,150
لماذا؟

171
00:11:52,160 --> 00:11:53,250
لماذا عُدتَ؟

172
00:11:55,410 --> 00:11:56,200
...أحضرتُ

173
00:11:57,200 --> 00:11:58,700
.معي زهرةً

174
00:12:02,580 --> 00:12:03,950
ما الّذي حدثَ؟

175
00:12:05,580 --> 00:12:07,790
هل ارتكبتُ خطأً ما؟

176
00:12:08,250 --> 00:12:09,510
،أنت لم تفعل أيّ شيءٍ

177
00:12:09,950 --> 00:12:11,200
...لكنّك

178
00:12:12,120 --> 00:12:13,580
!تحملُ وِزرًا

179
00:12:16,790 --> 00:12:19,410
كيف يُمكن لأبي أن
يقترفَ هذا الفِعل؟

180
00:12:19,950 --> 00:12:21,400
كيف يُمكنه أن يعاملكَ
بهذه الطّريقة؟

181
00:12:21,410 --> 00:12:24,440
قالَ الخالدُ إنّ هذا
.يُدعى لُبّ اللّهب

182
00:12:24,450 --> 00:12:26,320
وما إن تتجرّع النّبيذ
،الممزوج به

183
00:12:26,330 --> 00:12:30,040
حتّى تذوبَ عظامكَ
.كالحديد المُستعر

184
00:12:31,000 --> 00:12:32,700
،العناء الّذي جرّعتموهُ لعائلتي

185
00:12:34,250 --> 00:12:36,290
.ستَتجرّعهُ أنت أيضًا

186
00:12:37,750 --> 00:12:39,950
.هلكت عشيرتِي بأكملها بسببكَ

187
00:12:40,750 --> 00:12:42,660
،فإن كانَ ضميركَ يُؤنبك

188
00:12:43,450 --> 00:12:46,790
.فاسقِ أباكَ مِن هذا النّبيذ

189
00:12:50,950 --> 00:12:52,870
،أمّا إذا حاولتَ فضحَ أمري

190
00:12:53,910 --> 00:12:55,500
!لأقتُلنّك في الحال

191
00:13:01,000 --> 00:13:01,870
.تنحّوا عن الطّريق

192
00:13:02,540 --> 00:13:04,820
في يومِ بهجة ابن
،عمّي الكُبرى

193
00:13:04,830 --> 00:13:06,870
ما الضّير في أن أقومَ بزيارته؟

194
00:13:07,370 --> 00:13:08,630
.تنحّوا جانبًا جميعكُم

195
00:13:16,200 --> 00:13:19,160
،يا ابنَ عمّي
.جئتُ لرُؤيتكَ

196
00:13:22,450 --> 00:13:26,370
هل هذا الجِينسينغ الأحمر العتيق الّذي
بعثهُ الصّيدلاني المعروف لِي شِياو؟

197
00:13:29,330 --> 00:13:29,940
!كلا

198
00:13:29,950 --> 00:13:32,080
لا يجبُ أن تحتكرَ
!النّفائس لنفسكَ

199
00:13:32,700 --> 00:13:34,540
.لكُلّ شخصٍ نصيبٌ منه

200
00:13:41,750 --> 00:13:43,290
.لعلّه القدر إذن

201
00:14:03,830 --> 00:14:05,860
لكن ثمّة سؤالٌ
،يدورُ في ذهني

202
00:14:05,870 --> 00:14:07,730
لم يكُن بينكَ وبين لِي شِياو
،أيّ ضغينةٍ أو عداوة

203
00:14:08,750 --> 00:14:09,950
فما الّذي دفعكَ لتُورّطه
في هذا الجُرم؟

204
00:14:10,370 --> 00:14:12,370
،نفّذتُ أوامرَ ذلك الخالد

205
00:14:13,000 --> 00:14:16,500
الّذي ادّعى مُساعدتي
.رحمةً بعشيرتي المنكوبة

206
00:14:17,370 --> 00:14:19,820
ما اشترطهُ عليّ أن
...أُلقيَ باللّوم على

207
00:14:19,830 --> 00:14:21,890
لِي شِياو وأجعلهُ المُجرم
.بعد تنفيذ الخُطّة

208
00:14:22,580 --> 00:14:24,440
كيف يبدو ذلكَ الخالد؟

209
00:14:24,950 --> 00:14:27,620
،كان يرتدي قناعًا
.فلم أُميّز وجههُ

210
00:14:29,000 --> 00:14:30,500
،لكنّني ما زلتُ حائرًا

211
00:14:31,410 --> 00:14:33,780
أنا واثقٌ أنّني نقلتهُ
،إلى مكانٍ آمن

212
00:14:33,790 --> 00:14:36,450
فكيفَ نالَ منه لُبّ اللّهب؟

213
00:14:37,870 --> 00:14:39,130
هل تحتاجُ حقًا إلى السّؤال؟

214
00:14:39,450 --> 00:14:41,070
،ذلك الّذي قابلتهُ لم يكُن خالدًا

215
00:14:41,080 --> 00:14:42,440
.بل كانَ شيطان السّراب حتمًا

216
00:14:42,450 --> 00:14:45,850
في وقتِ الحادثة، لا بُدّ أنّه
،كانَ بالقُرب يتربّص بكُم

217
00:14:46,450 --> 00:14:49,180
ثُمّ تصرّف خفيةً
.حينما انفردَ بـ هُوا كَانغ

218
00:14:50,200 --> 00:14:52,530
لكن هُوا كَانغ هُو مَن
،تجرّع النّبيذ بنفسه

219
00:14:53,870 --> 00:14:56,930
كانَ في مأزقٍ، فإن هُو فضحَ
،أمرُكَ كان ذلك بمثابة خيانةٍ لك

220
00:14:57,830 --> 00:15:01,490
وإن كتمَ سرّكَ خانَ
.أهلهُ وعائلته كُلّها

221
00:15:01,910 --> 00:15:03,400
،بسببِ طبيعة هُوا كَانغ

222
00:15:03,410 --> 00:15:06,110
كيفَ لهُ أن يختارَ الحياة
وحدهُ وسطَ هذه الحيرة؟

223
00:15:06,120 --> 00:15:08,190
لم يكُن أمامهُ سوى
،خيارٍ واحد

224
00:15:08,200 --> 00:15:09,790
.أن يُشاركَ عائلته المُعاناة

225
00:15:14,200 --> 00:15:17,060
جلالتكَ، الآن وقد
،اتّضحت الحقيقة

226
00:15:17,120 --> 00:15:19,450
أرجو مِن جلالتكَ
.إطلاق سراح لِي شِياو

227
00:15:20,950 --> 00:15:24,320
جلالتكَ، رُغم تراجع مخلوق
،التّاي سُوي عن أقواله

228
00:15:24,330 --> 00:15:28,200
إلّا أنّ لِي شِياو قد أقرّ بأنّه
،كانَ شريكًا لشيطان السّراب

229
00:15:29,000 --> 00:15:31,400
إنّ لُبّ اللّهب عُشب شبحٍ
،لم يُرَ مثله مِن قبل

230
00:15:31,410 --> 00:15:33,440
لكن لِي شِياو لم يكُن
،يعلم اسمُ العُشب فحسب

231
00:15:33,450 --> 00:15:35,650
بل كانَ يعرفُ أنّ ترياقهُ
!هُو منقوع النّعناع

232
00:15:35,660 --> 00:15:38,120
لو لم تكُن له صلةٌ
،بشيطان السّراب

233
00:15:38,160 --> 00:15:40,020
فكيفَ له أن يُحيط
بكُلّ هذه الأسرار؟

234
00:15:40,870 --> 00:15:43,700
سمعتُ أنّ لِي شِياو
.طائرٌ رُوحانيّ

235
00:15:44,750 --> 00:15:47,280
رُبّما مواهبهُ الاستثنائيّة
.تُفسّر ذلك

236
00:15:49,330 --> 00:15:50,490
!بالطّبع

237
00:15:50,500 --> 00:15:53,780
قال مُروّض الوُحوش إنّ لِي شِياو طائرٌ
.رُوحانيّ لا يظهرُ إلّا مرّةً كُلّ ألف عامٍ

238
00:15:53,790 --> 00:15:55,360
إذا كانَ قد وُلِد مع
،معرفةٍ تامّة بالأعشاب

239
00:15:55,370 --> 00:15:57,030
ويفهمُ طبيعتها وخصائصها
،المُتعارضة

240
00:15:57,040 --> 00:15:58,240
!فلا عجبَ في ذلك

241
00:15:58,540 --> 00:16:01,900
لكن هذا لا ينفي كونهُ
.شريكًا لشيطان السّراب

242
00:16:01,910 --> 00:16:05,160
ومع ذلك، فهُو بريءٌ
،لم يقترف ذنبًا حتّى الآن

243
00:16:05,540 --> 00:16:08,450
ومِن الإجحاف أن
!نُعاقبه دُون جُرمٍ

244
00:16:11,410 --> 00:16:13,440
إنّ لِي شِياو على معرفةٍ
،بأعشاب الأشباح

245
00:16:13,450 --> 00:16:16,400
لكن بالنّظر إلى أساليب شيطان
،السّراب في هذه القضيّة

246
00:16:16,410 --> 00:16:18,910
فمِن الجليّ أنّه أرادَ
.موت لِي شِياو

247
00:16:20,290 --> 00:16:23,070
إذا كانَ في عالم هُونغ مِينغ الآن
،مَن يفقهُ أسرار أعشاب الأشباح

248
00:16:23,080 --> 00:16:25,680
ويقفُ حائلًا دُون
...مطامع شيطان السّراب

249
00:16:29,040 --> 00:16:33,400
فهذا يعني أنّ الطّائر الروحيّ لِي شِياو
،بريءٌ تمامًا مِن جريمة قصر عائلة هُوا

250
00:16:33,410 --> 00:16:34,830
.ويُعلن بريئًا

251
00:16:35,620 --> 00:16:36,490
.تِيان كوَان

252
00:16:36,500 --> 00:16:37,430
.طوعُ أمركَ

253
00:16:37,790 --> 00:16:39,820
.خُذيه معكِ وأدّبيه

254
00:16:39,830 --> 00:16:40,410
!أجل

255
00:16:43,450 --> 00:16:44,450
،ولكن يا جلالةَ الملك

256
00:16:44,870 --> 00:16:47,360
إنّ موعدَ إعدام لِي شِياو
.قد حانَ تقريبًا

257
00:16:47,370 --> 00:16:49,290
لا أعلمُ إن كانت ستصلُ
!في الوقت المُناسب لإنقاذه

258
00:17:12,820 --> 00:17:15,490
.حانت اللّحظة

259
00:17:15,500 --> 00:17:17,660
.باشرُوا بالإعدام

260
00:17:59,790 --> 00:18:00,620
.جُوان جُوان

261
00:18:01,330 --> 00:18:02,910
،قدمتِ لإنقاذي

262
00:18:04,290 --> 00:18:05,370
.لنعُد إلى الدّار

263
00:18:16,540 --> 00:18:17,440
.جِينغ شُون

264
00:18:17,450 --> 00:18:18,870
.أجل، يا جلالةَ الملك

265
00:18:19,870 --> 00:18:23,200
،أبقينا على حياة لِي شِياو
...ومدى نفعهِ الآن

266
00:18:24,950 --> 00:18:26,700
.يقعُ على عاتقكَ أنت

267
00:18:28,660 --> 00:18:29,250
.طوعُ أمركَ

268
00:18:40,200 --> 00:18:41,450
،هكذا إذن

269
00:18:42,950 --> 00:18:45,210
يا للأسف، كانَ هُوا تُسونغ
.نفسًا بائسةً أيضًا

270
00:18:47,660 --> 00:18:49,870
،لفّقَ لك التّهمة
ومع ذلك أنت لا تكرههُ؟

271
00:18:52,370 --> 00:18:54,170
.إنّني أدركُ مرارة فُقدان العائلة

272
00:18:56,040 --> 00:18:59,450
وأعلمُ أنّ الكُره قد يُعمِي
.الأفئدة النّقية أحيانًا

273
00:19:00,750 --> 00:19:01,540
،وعلاوةً على ذلك

274
00:19:03,330 --> 00:19:05,130
إنّه يُقاسي عذابَ الجحيم
.مُنذ مُدّةٍ طويلة

275
00:19:07,750 --> 00:19:09,290
لماذا تركتني أرحلُ؟

276
00:19:10,250 --> 00:19:12,910
إنّ الحقّ الّذي كُنت أسعى
،إليه قد حصلتُ عليه بالفِعل

277
00:19:14,500 --> 00:19:17,740
مِن الآن فصاعدًا، سواءٌ في عالمِ
،البشر أو في عالمِ الأموات

278
00:19:17,750 --> 00:19:19,080
.دعنا لا نلتقي مُجدّدًا

279
00:19:30,660 --> 00:19:31,660
،إذن، يا أخي

280
00:19:33,830 --> 00:19:34,950
،بعد هذه اللّيلة

281
00:19:37,200 --> 00:19:38,870
.عِش حياةً طيّبة

282
00:19:39,700 --> 00:19:41,000
.عِش مِن أجل نفسكَ

283
00:19:58,700 --> 00:20:01,910
لم يعُد لأيّ منّا ملاذٌ
.نأوي إليه بعد الآن

284
00:20:05,450 --> 00:20:07,980
،ما إن أُنفّذ أمرَ ذلك الخالد

285
00:20:08,080 --> 00:20:09,500
.سأمنحكُ هذا الجسد

286
00:20:10,080 --> 00:20:11,680
،ومتى اكتملَ ثأري

287
00:20:11,870 --> 00:20:15,370
سأفِي لك بالوعد
.الّذي قطعتهُ على نفسي

288
00:20:32,080 --> 00:20:39,110
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

289
00:20:39,120 --> 00:20:47,660
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

290
00:20:49,700 --> 00:20:54,400
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

291
00:20:54,410 --> 00:20:59,070
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

292
00:20:59,080 --> 00:21:02,900
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

293
00:21:02,910 --> 00:21:07,400
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

294
00:21:07,410 --> 00:21:12,070
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

295
00:21:12,080 --> 00:21:16,780
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

296
00:21:16,790 --> 00:21:21,990
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

297
00:21:22,000 --> 00:21:25,990
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

298
00:21:26,000 --> 00:21:31,110
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

299
00:21:31,120 --> 00:21:35,610
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

300
00:21:35,620 --> 00:21:40,570
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

301
00:21:40,580 --> 00:21:45,030
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

302
00:21:50,160 --> 00:21:56,290
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟

303
00:22:58,200 --> 00:23:01,200
أيّتها الأخت الكُبرى، ألم تذهبي
للبحثِ عن الأخ الأكبر؟

304
00:23:01,540 --> 00:23:04,000
،لم أعثُر عليه
.فرجعتُ قبله

305
00:23:08,250 --> 00:23:09,080
!أبي

306
00:23:11,790 --> 00:23:12,720
.أيّها الأخ الأكبر

307
00:23:14,370 --> 00:23:15,570
هل عادَ المُعلّم؟

308
00:23:17,410 --> 00:23:18,700
.يبدو أنّه لم يعُد بعد

309
00:23:21,000 --> 00:23:23,000
.سأنتظرهُ في الدّاخل إذن

310
00:23:43,250 --> 00:23:44,120
.عُدت

311
00:23:44,580 --> 00:23:45,250
.يا سيّدي

312
00:23:48,370 --> 00:23:49,500
،حذّرتكَ سابقًا

313
00:23:50,410 --> 00:23:52,450
لا تُنادني بهذا اللّقب
.في هذا المكان

314
00:23:54,500 --> 00:23:56,950
.غلبنِي الحماس فنَسيتُ القواعد

315
00:24:01,660 --> 00:24:02,870
هل قُضي الأمر؟

316
00:24:03,540 --> 00:24:04,570
.تيسّرت المُهمّة وتمّت بنجاحٍ

317
00:24:04,580 --> 00:24:07,440
استحالت عائلة هُوا فِينغ يُو
.بأكملها إلى أطياف نارٍ

318
00:24:07,450 --> 00:24:10,310
ومخلوقُ التّاي سُوي في
.طريقه إلى قصر لِينغ شيَاو

319
00:24:11,370 --> 00:24:12,690
...وأعتقدُ أنّ عمليّة القبض

320
00:24:12,700 --> 00:24:14,760
.على لِي شِياو لن تتأخّر كثيرًا

321
00:24:16,120 --> 00:24:18,320
!لا تزالُ مُفيدًا نوعًا ما

322
00:24:19,370 --> 00:24:21,370
،شُكرًا لك، يا سيّدي
.على ثنائكَ

323
00:24:21,450 --> 00:24:22,650
...المُشكلة

324
00:24:22,660 --> 00:24:25,400
...أنّ جسدي هذا

325
00:24:25,410 --> 00:24:26,900
.بدأَ يتهالك تدريجيًا

326
00:24:26,910 --> 00:24:29,530
،أرجوكَ يا سيّدي
.هبنِي جسدًا بديلًا

327
00:24:29,540 --> 00:24:32,240
منحتُكَ جسد أفضل
،تلاميذي وأكثرهُم براعةً

328
00:24:32,250 --> 00:24:34,250
أفلا يكفيكَ هذا؟

329
00:24:34,700 --> 00:24:36,940
خلّصتُكَ مِن العقبة
...المُتمثّلة في هُوا فِينغ يُو

330
00:24:36,950 --> 00:24:39,290
دُون أن تخسرَ فردًا
.واحدًا مِن رجالك

331
00:24:39,700 --> 00:24:41,560
أفلا يستوجبُ صنيعي
هذا مُكافأةً؟

332
00:24:42,870 --> 00:24:45,740
لاحظتُ مُؤخّرًا أنّ صحّة
،الأخت الصّغرى ممتازةٌ ووجهها نضِرٌ

333
00:24:45,750 --> 00:24:47,030
...فهل يُمكن

334
00:24:47,040 --> 00:24:47,830
!كُفّ عن هذا

335
00:24:49,200 --> 00:24:51,200
.سأعثرُ لك على جسدٍ مُلائم

336
00:24:52,000 --> 00:24:53,250
.شُكرًا لك، يا سيّدي