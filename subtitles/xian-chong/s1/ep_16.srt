1
00:00:47,330 --> 00:00:54,240
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

2
00:00:54,250 --> 00:01:01,820
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

3
00:01:01,830 --> 00:01:08,320
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

4
00:01:08,330 --> 00:01:14,530
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

5
00:01:15,280 --> 00:01:22,400
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

6
00:01:22,410 --> 00:01:30,110
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

7
00:01:30,120 --> 00:01:36,940
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

8
00:01:36,950 --> 00:01:42,530
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

9
00:01:43,370 --> 00:01:50,690
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

10
00:01:50,700 --> 00:01:57,360
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

11
00:01:57,370 --> 00:02:03,650
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

12
00:02:03,660 --> 00:02:11,000
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

13
00:02:59,570 --> 00:03:00,190
،جُوان جُوان

14
00:03:02,000 --> 00:03:04,730
.وصفَ الطّبيب الدّواء ثُمّ مضى

15
00:03:04,840 --> 00:03:06,370
.عُودي إلى مضجعكِ لتَستريحي

16
00:03:09,170 --> 00:03:11,670
،جُرح صدره وإن بدا غائرًا

17
00:03:12,230 --> 00:03:14,100
.لكنّه لا يُهدّد حياته

18
00:03:15,180 --> 00:03:16,780
.خوفي عليكِ أنتِ أشدّ

19
00:03:16,790 --> 00:03:18,990
فالجِراح الّتي عانيتِ منها سابقًا
،في بُحيرة جِي يِي لم تُشفَ بعد

20
00:03:19,000 --> 00:03:21,000
.كما أنّكِ لم تنامي مُنذ أيّامٍ

21
00:03:23,380 --> 00:03:25,170
يجبُ أن تذهبي لنيلِ
.قسطٍ مِن الرّاحة

22
00:03:25,350 --> 00:03:26,680
.اتركي لي تدبيرَ ما تبقّى

23
00:03:43,790 --> 00:03:47,350
.شَاو وِي لِي

24
00:03:48,140 --> 00:03:50,050
.جُوان جُوان، أنا هُنا

25
00:03:50,070 --> 00:03:51,200
شَاو وِي لِي؟

26
00:03:51,970 --> 00:03:52,680
.جُوان جُوان

27
00:03:53,570 --> 00:03:54,650
.شَاو وِي لِي

28
00:03:56,300 --> 00:03:57,000
!جُوان جُوان

29
00:03:58,570 --> 00:03:59,220
!جُوان جُوان

30
00:03:59,420 --> 00:04:00,630
شَاو وِي لِي؟

31
00:04:01,990 --> 00:04:02,870
!جُوان جُوان

32
00:04:06,410 --> 00:04:07,990
.جُوان... جُوان

33
00:04:20,110 --> 00:04:21,890
.جُوان... جُوان

34
00:04:44,940 --> 00:04:45,770
.لِي شِياو

35
00:04:47,710 --> 00:04:48,940
.عُدت

36
00:05:09,090 --> 00:05:09,760
.جُوان جُوان

37
00:05:11,050 --> 00:05:13,430
،جُوان جُوان
لماذا لم تُطيلِي نومكِ؟

38
00:05:15,180 --> 00:05:17,580
هل ستُبدّلينَ ضمادة لِي شِياو؟

39
00:05:17,680 --> 00:05:20,080
،أجل
...أوصاني الطّبيب بالأمس

40
00:05:20,090 --> 00:05:22,120
.أن أُبدّل ضمادهُ هذا الصّباح

41
00:05:22,130 --> 00:05:23,800
.أنا... أنا سأفعلُ ذلك

42
00:05:25,060 --> 00:05:26,010
...أنا

43
00:05:26,320 --> 00:05:28,320
.أعتقدُ أن تشَانغ أر يبحثُ عنكِ

44
00:05:29,870 --> 00:05:32,130
ما الّذي يُريده ذلك الأرنب
الأبله هذه المرّة؟

45
00:05:33,880 --> 00:05:35,090
.شُكرًا لكِ، جُوان جُوان

46
00:05:35,450 --> 00:05:37,060
!لا... لا عليكِ

47
00:05:39,880 --> 00:05:40,880
.معذرةً، تشَانغ أر

48
00:05:51,640 --> 00:05:53,890
.كلا، الجُرح لا يلتئم

49
00:05:54,680 --> 00:05:56,430
كما أنّ طاقتهُ الروحيّة
.تزدادُ قُوّةً

50
00:05:57,140 --> 00:05:58,840
حسبتُ أنّ لهيبَ مُرتفع
...فِينغ شوي

51
00:05:58,850 --> 00:06:00,510
قد صهرهُ وأحاله رمادًا
.مُنذ أمدٍ بعيد

52
00:06:01,220 --> 00:06:04,220
لم يدُر بخُلدي أنّ شظيّةً
!مِن رُوحه لا تزال حيّةً

53
00:06:04,520 --> 00:06:07,180
هل يُعقل أنّ الموت نفسهُ
عاجزٌ عن تحريري مِن قبضته؟

54
00:06:12,410 --> 00:06:13,670
.استيقظتَ يا لِي شِياو

55
00:06:20,160 --> 00:06:22,450
كيفَ... كيفَ تشعرُ اليوم؟

56
00:06:22,930 --> 00:06:23,720
.أفضلُ بكثيرٍ

57
00:06:28,800 --> 00:06:30,400
.دعني أُبدّل لك الضّمادة

58
00:06:30,930 --> 00:06:32,840
،لا حاجةَ لذلك
.يُمكنني فعلُها بنفسي

59
00:06:33,720 --> 00:06:35,380
.ضعِي الدّواء هُنا فحسب

60
00:06:36,340 --> 00:06:37,830
كيف ستفعلُ هذا وحدكَ؟

61
00:06:37,840 --> 00:06:38,630
.دعني أُعاونكَ

62
00:06:52,190 --> 00:06:54,450
هل نسيتِ أنّني أُطبّب النّاس؟

63
00:06:54,800 --> 00:06:55,880
.يُمكنني فِعلُ ذلك بنفسي

64
00:06:57,090 --> 00:06:58,750
ليس الأمرُ وكأنّني
.لم أرهُ مِن قبل

65
00:06:58,760 --> 00:07:00,180
لماذا أنتَ خجولٌ هكذا؟

66
00:07:01,840 --> 00:07:03,630
!كلا... لا شيء

67
00:07:04,630 --> 00:07:05,930
.افعل ذلك بنفسكَ إذن

68
00:07:10,090 --> 00:07:11,060
...في

69
00:07:12,550 --> 00:07:14,480
،في مهرجان الفوانيس أسفل التّل

70
00:07:15,510 --> 00:07:17,120
هل كانَ هُناك شيءٌ
...أردتَ أن تُخبرني به

71
00:07:17,130 --> 00:07:18,370
لكنّك لم تفعل؟

72
00:07:21,880 --> 00:07:23,940
.لا أذكرُ أنّني كتمتُ قولًا

73
00:07:26,970 --> 00:07:29,340
!لا تتذكّر؟ فكّر مليًا

74
00:07:29,760 --> 00:07:31,540
في ذلك اليوم، أنت مَن
،دعوتنِي إلى مهرجان الفوانيس

75
00:07:31,550 --> 00:07:34,200
:وقُلت
".إنّ المُغتربين يتلهّفون ليوم الرّجوع"

76
00:07:34,210 --> 00:07:35,850
..."أَليس المقصود بـ "المُغتربين

77
00:07:35,860 --> 00:07:37,390
أَليس المقصود شَاو وِي لِي؟

78
00:07:39,880 --> 00:07:41,460
،في ذلك اليوم
...لاحظتُ أنّ الهمّ يُثقل صدركِ

79
00:07:41,470 --> 00:07:43,380
،بسبب قضيّة هُوي ونِينغ آن

80
00:07:43,800 --> 00:07:46,000
فأردتُ أن نخرجَ لنُروّح
،عن أنفسنا قليلًا

81
00:07:46,010 --> 00:07:48,470
وما جالَ في خاطِري
.مقصدٌ خفيّ

82
00:07:48,590 --> 00:07:50,170
،أيّتها الخالدة
.لا بُدّ أنّكِ قد أسأتِ الفهم

83
00:07:50,180 --> 00:07:51,610
أيّتها الخالدة؟

84
00:07:51,930 --> 00:07:52,970
أسأتُ الفهم؟

85
00:07:53,380 --> 00:07:54,730
...ولكن تلك الكلمات الّتي نطقتَ بها

86
00:07:54,740 --> 00:07:56,080
...أمامَ مسرح العرض يومها

87
00:07:56,110 --> 00:07:58,250
هِي ذات الكلمات الّتي
!خاطبتهُ بها فيما مضى

88
00:07:58,260 --> 00:07:59,920
حتّى سيفُ السّحاب
.قد تعرّف عليكَ

89
00:07:59,930 --> 00:08:00,770
،بعد كُلّ ما جرى

90
00:08:00,790 --> 00:08:02,390
لِمَ تُصرّ على الإنكار؟

91
00:08:06,510 --> 00:08:07,180
،أيّتها الخالدة

92
00:08:08,180 --> 00:08:09,180
،أنا لِي شِياو فحسب

93
00:08:09,690 --> 00:08:10,520
.أليفُكِ المُطيع وتابعكِ

94
00:08:13,340 --> 00:08:14,790
...توقّفي عن تقصّي ملامح

95
00:08:14,800 --> 00:08:16,200
.راحلٍ فيَّ

96
00:08:34,650 --> 00:08:35,610
!ترقّب إذن

97
00:08:35,880 --> 00:08:37,130
!سآتيكَ بالبُرهان

98
00:08:38,380 --> 00:08:40,330
ولا تحسب أنّ الإنكار
!سيَجعلني أُطلق سراحكَ

99
00:08:40,340 --> 00:08:41,040
،سيّدتي

100
00:08:41,420 --> 00:08:43,050
هل استشعرتِ أيضًا
خطبًا ما في لِي شِياو؟

101
00:08:43,050 --> 00:08:44,600
!بالطّبع هُناك خطبٌ ما فيه

102
00:08:44,610 --> 00:08:46,340
!بل أمرهُ مريبٌ للغاية

103
00:08:49,430 --> 00:08:50,690
ما الخطب فيه؟

104
00:08:52,090 --> 00:08:54,710
،تنبعثُ منه حاليًا رائحةٌ مألوفة

105
00:08:55,430 --> 00:08:56,890
.لم تكُن تفوحُ منه سابقًا

106
00:08:57,090 --> 00:08:58,010
عن أيّ رائحةٍ تتحدّث؟

107
00:08:58,930 --> 00:09:00,210
،حين التقيتُ بكِ أوّل مرّةٍ

108
00:09:00,380 --> 00:09:02,760
شممتُ هذه الرّائحة على
.سيف السّحاب الخاصّ بكِ

109
00:09:05,010 --> 00:09:06,740
هل يُمكن أن تكونَ
رائحة شَاو وِي لِي؟

110
00:09:07,070 --> 00:09:07,870
،كلا

111
00:09:08,930 --> 00:09:11,730
فرائحةُ السيّد شَاو على سيف
،السّحاب كانت أقوى بكثيرٍ

112
00:09:11,840 --> 00:09:13,240
.وتملأُ السّيف كُلّه

113
00:09:13,380 --> 00:09:16,460
،أمّا هذه الرّائحة
.فلا تلتصقُ إلّا بحدّ السّيف

114
00:09:16,680 --> 00:09:18,410
إنّها أقربُ لأن تكونَ
.رائحة شيطانٍ

115
00:09:20,260 --> 00:09:21,460
...أظنّ أنّها

116
00:09:21,720 --> 00:09:23,930
...رائحةُ شيطانٍ جُرح

117
00:09:24,220 --> 00:09:25,470
.بسيف السّحاب

118
00:09:27,720 --> 00:09:29,930
لِي شِياو يأبى الاعتراف
.بهويّته الحقيقيّة

119
00:09:30,630 --> 00:09:33,340
هل هذا بسبب الرّائحة
العالقة عليه؟

120
00:09:34,130 --> 00:09:37,330
ما الّذي جرى لهُ تحديدًا
بعد أن سُلبت رُوحه يومها؟

121
00:09:37,680 --> 00:09:41,080
إنّ الأدلّة الّتي أملكُها عن شيطان السّراب
.في قصر شِينغ هَان شحيحةٌ للغاية

122
00:09:41,800 --> 00:09:42,430
!سيّدتي

123
00:09:43,260 --> 00:09:44,500
...أنا ذاهبةٌ إلى عالم يَاو غُوانغ

124
00:09:44,510 --> 00:09:46,110
.أقتفِي أثرَ بِي يُون زُو

125
00:09:47,300 --> 00:09:49,360
فلا تنتظِرني على مائدة
.العشاء اللّيلة

126
00:09:56,260 --> 00:09:59,050
لا أعلمُ إن كانت بقايا
!رُوحه ستَفيقُ مرّةً أُخرى

127
00:09:59,060 --> 00:10:00,110
،قبل ذلك

128
00:10:01,010 --> 00:10:01,840
...عليّ مُعاونة جُوان جُوان

129
00:10:01,850 --> 00:10:04,250
لنَصل إلى المُدبّر الخفيّ
.لعُشب الأشباح

130
00:10:05,010 --> 00:10:07,790
فعائلة هُوا في بلدة لُويِي تربطها
،صلةُ قرابةً بـ هُوا فِينغ يُو

131
00:10:07,800 --> 00:10:09,460
.وتُعد مصدرَ ثروته الأساسيّ

132
00:10:10,220 --> 00:10:12,010
كما أنّ البُقعة الّتي تفشّت
...فيها زهرةُ أعماق الظّلام

133
00:10:12,020 --> 00:10:14,120
كانت خاضعةً لنُفوذ
.هُوا فِينغ يُو

134
00:10:14,130 --> 00:10:15,170
،ثُمّ زهرةُ لُبّ اللّهب

135
00:10:15,500 --> 00:10:17,710
لتقضي على حياة
.هُوا فِينغ يُو مُباشرةً

136
00:10:17,720 --> 00:10:19,090
...حتّى قضيّة نِينغ آن

137
00:10:19,110 --> 00:10:20,800
.مرتبطةٌ أيضًا بـ هُوا فِينغ يُو

138
00:10:21,630 --> 00:10:23,440
والآن، بعد أن أُبيدت تلك
،العائلة عند بُحيرة جِي يِي

139
00:10:23,670 --> 00:10:25,600
مَن عساهُ يكون المُستفيد الأوّل؟

140
00:10:29,720 --> 00:10:31,960
هل يُعقل أنّ المُتسبّب بما
...جرى في قصر شِينغ هَان

141
00:10:31,970 --> 00:10:32,880
هُو ذاته...؟

142
00:10:34,270 --> 00:10:35,600
لكن لو صدقت الشّكوك
،وكانَ هُو حقًا

143
00:10:35,900 --> 00:10:37,690
فما الّذي أتى بـ بِي يُون زُو
إلى ذلك المكان؟

144
00:11:16,900 --> 00:11:17,910
،يا أُمّ هُوا إر

145
00:11:17,940 --> 00:11:20,000
هل عُدتِ لتوّكِ مِن تسلّم المعونات؟

146
00:11:20,010 --> 00:11:22,750
أجل يا سيّدتي، فقد
.نلتُ خيرًا وفيرًا مِن الطّعام

147
00:11:22,760 --> 00:11:24,880
إنّ القائد بِي رجلٌ
!رحيم للغاية

148
00:11:25,630 --> 00:11:28,400
لجأتُم إلى هُنا هربًا مِن قرية
شَانغ شُوي، أَليس كذلك؟

149
00:11:28,410 --> 00:11:29,810
تناهى إلى مسامعي أنّ الجُنون
،قد اجتاحَ تلك الأرض

150
00:11:29,820 --> 00:11:31,030
.يا لهُ مِن شُؤمٍ

151
00:11:31,590 --> 00:11:32,850
!لا تذكُري ذلك حتّى

152
00:11:32,880 --> 00:11:35,000
فلولا أنّ القائد بِي قادَ
،رجالهُ لكبح جماح الفوضى

153
00:11:35,010 --> 00:11:36,420
،وأمّن لنا الملجأ

154
00:11:36,600 --> 00:11:38,130
.لكنّا الآن في عداد الموتى

155
00:11:39,510 --> 00:11:41,880
في الآونة الأخيرة، توالتِ
!المصائب على الجنوب

156
00:11:41,890 --> 00:11:43,780
.أولًا الجُنون ثُمّ الوباء

157
00:11:44,250 --> 00:11:45,680
،لحُسن الحظّ
...قامَ القائد بِي

158
00:11:45,700 --> 00:11:47,750
.بإيوائنا نحن اللّاجئين

159
00:11:49,090 --> 00:11:50,060
!يا أيّها النّاس

160
00:11:50,590 --> 00:11:52,250
وصلتُ لتوّي إلى
!عالم يَاو غُوانغ

161
00:11:52,260 --> 00:11:54,030
،وقد غمرني القائد بِي بجُوده

162
00:11:54,040 --> 00:11:55,390
وليس لديّ ما أُكافئه
،به على صنيعهِ

163
00:11:55,400 --> 00:11:57,290
غير أنّني أملكُ شيئًا
.مِن المعرفة بطُرق العلاج

164
00:11:57,300 --> 00:11:59,080
لذلك، سأَفتتحُ عيادةً
.مجانيّة هُنا اليوم

165
00:11:59,090 --> 00:12:01,690
لعلّي أُساهم بجُهدي
!في خيرِ القائد بِي

166
00:12:02,220 --> 00:12:05,130
،فمَن كانَ يشكو مرضًا
،أو عرضًا غريبًا

167
00:12:05,310 --> 00:12:06,840
!فليَقصدني للعلاج فورًا

168
00:12:10,560 --> 00:12:11,570
،أيّها السيّد

169
00:12:11,590 --> 00:12:13,520
ترغبُ في افتتاح عيادةٍ مجانيّة؟

170
00:12:13,720 --> 00:12:14,280
.أجل

171
00:12:14,770 --> 00:12:16,940
فهل تأذنُ لي باستعارة
طاولتكَ ومقاعدكَ؟

172
00:12:16,970 --> 00:12:18,760
.حسنًا، بالطّبع

173
00:12:27,060 --> 00:12:29,520
أيّها الطّبيب، هل يُمكنني أن
أطلبَ منك أن تقيسَ لي نبضي؟

174
00:12:29,760 --> 00:12:31,760
.بالتّأكيد، تفضّلي بالجُلوس

175
00:12:34,680 --> 00:12:36,980
عليّ أن آتي بـ أر غُو
،إلى هُنا لاحقًا

176
00:12:37,180 --> 00:12:40,240
فقد مرّت أيّامٌ
.وإصابة ساقهِ لا تلتئم

177
00:12:40,550 --> 00:12:41,750
!آهٍ مِن أر غُو هذا

178
00:12:41,980 --> 00:12:43,960
،تركَ طعام المعونة

179
00:12:43,970 --> 00:12:45,750
وذهبَ ليصطاد الطّيور
،في الجبال الخلفيّة

180
00:12:45,760 --> 00:12:47,760
ليجدَ نفسه وجهًا لوجهٍ
.مع ذلك الوحش الشيطانيّ

181
00:12:49,800 --> 00:12:51,800
،عائلة بِي تُقيم هُنا

182
00:12:51,940 --> 00:12:54,000
فكيفَ لوحشٍ شيطانيّ أن
يعيثَ في المكان فسادًا؟

183
00:12:54,010 --> 00:12:55,310
.هذا صحيحٌ

184
00:12:55,490 --> 00:12:57,410
إنّه يقبعُ في الجبال
،الشماليّة الخلفيّة

185
00:12:57,420 --> 00:12:59,580
.شاهدهُ أر غُو مع فتيانٍ آخرين

186
00:13:00,080 --> 00:13:02,210
كيف تبدو هيئةُ هذا
الوحش الشيطانيّ؟

187
00:13:03,880 --> 00:13:06,540
سمعتُ أنّ للوحش أنيابًا
.ضخمةً وذيلًا نحيلًا

188
00:13:06,570 --> 00:13:08,030
.ويُمكنه الوُقوف على قدمين

189
00:13:08,180 --> 00:13:10,170
كما أنّ جسده مُغطّى
.بفروٍ ذهبيّ

190
00:13:10,200 --> 00:13:11,540
!يا لهُ مِن مفزعٌ للغاية

191
00:13:11,930 --> 00:13:13,880
لم يعُد أحدٌ منّا يقوى
.على الاقتراب مِن هُناك

192
00:13:14,890 --> 00:13:17,300
أيّها الطّبيب، إيّاك أن تقتربَ
.مِن ذلك الموضع

193
00:13:17,940 --> 00:13:20,400
ألم تُرسل عائلة بِي
رجالًا للقبض عليه؟

194
00:13:21,670 --> 00:13:23,590
لعلّ ذلك الوحش الشيطانيّ
...يتمتّع بدهاءٍ

195
00:13:23,600 --> 00:13:25,530
حالَ دُون ظفرهم به
.حتّى السّاعة

196
00:13:46,220 --> 00:13:48,350
معذرةً لأنّني جعلتُكِ تنتظرينَ
.طويلًا أيّتها المبعوثة الخالدة

197
00:13:48,470 --> 00:13:50,330
قصدتُ غُرفة الأخت الكُبرى
،يُون زُو مُنذ قليلٍ

198
00:13:50,590 --> 00:13:52,000
.ولم أجدها

199
00:13:52,010 --> 00:13:54,420
كما استفسرتُ مِن عدّة أشخاصٍ
.لكن لا أحدَ يعرفُ أين هِي

200
00:13:54,430 --> 00:13:57,160
أخشى أنّكِ تكبّدتِ
.مشقّة السّفر دُون طائلٍ

201
00:13:59,520 --> 00:14:00,460
،غادرَ الزّعيم

202
00:14:00,660 --> 00:14:01,920
.لكنّه سيَعودُ قريبًا

203
00:14:02,480 --> 00:14:04,490
هل تتفضّلين بالانتظار
قليلًا بعد؟

204
00:14:04,500 --> 00:14:05,170
،لا داعي

205
00:14:05,550 --> 00:14:06,530
،ما دامت غائبةً

206
00:14:06,540 --> 00:14:08,140
.فلا أُريد إزعاجكم

207
00:14:08,290 --> 00:14:10,950
أرجو أن تُبلّغ الزّعيم بِي
.تحيّات سيّدي الخالد

208
00:14:11,260 --> 00:14:11,970
.وداعًا

209
00:14:16,790 --> 00:14:18,790
،أردتُ أن أُفاجئ يُون زُو

210
00:14:19,310 --> 00:14:21,510
ولم يخطر ببالي أنّها
.لن تكونَ هُنا

211
00:14:21,550 --> 00:14:22,380
!آنسة شُو

212
00:14:24,180 --> 00:14:25,350
لُو شِياوتَان؟

213
00:14:26,470 --> 00:14:27,430
ما الّذي أتى بكَ
إلى هُنا؟

214
00:14:29,220 --> 00:14:30,710
،بعد الحادثة في بلدة لُويي

215
00:14:30,720 --> 00:14:32,430
لم يكُن لدينا نحنُ الأيتام
،مكانٌ نذهبُ إليه

216
00:14:32,800 --> 00:14:35,130
لذلك أحضرنا يُونجِيانغ
.إلى عالم يَاو غوَانغ

217
00:14:36,760 --> 00:14:38,130
.فهمت

218
00:14:38,890 --> 00:14:39,880
!أيّها المُشاكس

219
00:14:40,050 --> 00:14:42,180
.تُرعبني دائمًا بظُهوركَ المُفاجئ

220
00:14:42,590 --> 00:14:43,990
كيف هِي حياتكَ هُنا؟

221
00:14:44,000 --> 00:14:44,800
،على خيرِ ما يُرام

222
00:14:45,290 --> 00:14:47,170
.فأنا أعملُ كمُعاونٍ حاليًا

223
00:14:48,080 --> 00:14:49,790
،آنسة شُو
!جئتِ في الوقت المُناسب

224
00:14:49,800 --> 00:14:51,530
كُنت أتساءل عن كيفيّة
.الوُصول إليكِ

225
00:14:52,530 --> 00:14:53,450
لماذا؟

226
00:14:56,010 --> 00:14:57,830
هل يُمكنكِ مُساعدتي في
العُثور على يُون زُو؟

227
00:14:57,840 --> 00:14:59,720
يُون زُو؟ ما الخطب؟

228
00:15:00,220 --> 00:15:02,780
.أظنّ أنّها قد تكونُ مفقودةً

229
00:15:11,720 --> 00:15:12,630
،أيّتها الأخت الكُبرى
!يُون زُو

230
00:15:16,410 --> 00:15:17,470
.شِياوتَان، هذا أنتَ

231
00:15:18,760 --> 00:15:21,010
،الأخت الكُبرى يُون زُو
هل أنتِ مهمومةٌ؟

232
00:15:22,630 --> 00:15:24,330
إن كانَ هُناك ما يشغلُ
،بالكِ فبُوحي لي به

233
00:15:24,340 --> 00:15:25,790
.فلعلّني أمدّ لكِ يد العون

234
00:15:28,630 --> 00:15:31,500
أرغبُ في النّزول مِن الجبل
.للبحث عن الخالدة تِيان كوَان

235
00:15:31,510 --> 00:15:32,460
فهل تُرافقني؟

236
00:15:32,470 --> 00:15:33,880
تبحثينَ عن الآنسة شُو؟

237
00:15:34,380 --> 00:15:35,960
!لكن بدنكِ عليلٌ

238
00:15:35,970 --> 00:15:38,050
ثُمّ هل سيُوافق الزّعيم
بِي على رحيلكِ؟

239
00:15:40,090 --> 00:15:42,220
!إيّاك أن يعلمَ أبي بهذا الخُصوص

240
00:15:43,130 --> 00:15:44,510
نهربُ خُفيةً مِن الجبل إذن؟

241
00:15:44,520 --> 00:15:45,150
...هذا

242
00:15:46,090 --> 00:15:47,760
،أنت تعرفُ الخالدة تِيان كوَان

243
00:15:48,180 --> 00:15:50,510
.ولديكَ درايةٌ بالعالم في الأسفل

244
00:15:50,800 --> 00:15:51,930
،وبعد طُول تدبّرٍ

245
00:15:52,210 --> 00:15:54,540
لم أجِد سواكَ ليُعينني
.يا شِياوتَان

246
00:15:58,720 --> 00:16:00,800
.كُنتِ لطيفةً معي على الدّوام

247
00:16:01,450 --> 00:16:03,280
.لكِ ما أردتِ

248
00:16:04,420 --> 00:16:06,290
،رائعٌ
.شُكرًا لك يا شِياوتَان

249
00:16:06,710 --> 00:16:08,590
،سأمضِي الآن لإعداد أمتعتي

250
00:16:08,610 --> 00:16:09,810
.ورحيلُنا سيَكونُ اللّيلة

251
00:16:10,260 --> 00:16:11,320
لِمَ العجلة؟

252
00:16:11,950 --> 00:16:13,350
!لا يُمكنني التأخّر أكثر مِن ذلك

253
00:16:14,430 --> 00:16:16,170
لا يُمكننا أن نسلكَ الدّرب
،الرّئيسي جنوبًا

254
00:16:16,180 --> 00:16:18,540
.فمنافذهُ محروسةٌ برجال عشيرتنا

255
00:16:18,550 --> 00:16:19,460
!هكذا سيُمسكونَ بنا حتمًا

256
00:16:22,180 --> 00:16:24,540
لكن بمقدورنا العُبور مِن
.خلال الجبال الشماليّة الخلفيّة

257
00:16:24,550 --> 00:16:26,850
،حسنًا
.لنلتقِ في التّاسعة ليلًا

258
00:16:27,090 --> 00:16:29,290
عند مُفترق الطّرق الثلاثيّ
.في الجبال الخلفيّة

259
00:16:31,260 --> 00:16:33,390
كانَ اتّفاقنا أن نلتقي في
،الجبال الخلفيّة

260
00:16:33,800 --> 00:16:35,000
،لنهربَ ليلتها

261
00:16:37,520 --> 00:16:38,580
.دُون أن تظهر

262
00:16:39,640 --> 00:16:40,540
،ومُذ ذلك اليوم

263
00:16:40,930 --> 00:16:42,840
.لم أُبصر يُون زُو مُجدّدًا

264
00:16:43,550 --> 00:16:44,680
كم انقضَى على غيابها؟

265
00:16:46,090 --> 00:16:48,080
.أكثرُ مِن عشرة أيّامٍ

266
00:16:48,090 --> 00:16:49,090
!كُلّ هذا الوقت؟

267
00:16:49,630 --> 00:16:51,040
،لو أنّها اختفت بالفِعل

268
00:16:51,050 --> 00:16:52,980
فكيفَ لـ بِي شِيون أن
يبقى دُون درايةٍ بحالها؟

269
00:16:53,010 --> 00:16:54,870
!مِن أجل ذلك شعرتُ بالرّيبة

270
00:16:55,300 --> 00:16:57,540
فلم ألحظ أيّ تغيّر في سُلوك
.الزّعيم بِي في الآونة الأخيرة

271
00:16:57,550 --> 00:16:59,790
.ولا يبدو أنّه قلقٌ بشأن ذلك

272
00:16:59,800 --> 00:17:02,840
لكنّني لا أملكُ الجُرأة
.لأستفسرَ منه

273
00:17:03,470 --> 00:17:05,930
هل أنتَ واثقٌ أنّ
يُون زُو لم تطأ دارها؟

274
00:17:06,890 --> 00:17:08,400
،تسلّلتُ إلى باحتها الخلفيّة

275
00:17:08,550 --> 00:17:09,550
!ولم أجِد لها أثرًا

276
00:17:13,330 --> 00:17:15,800
رافقنِي إلى الجبال
.الخلفيّة الّتي ذكرتها

277
00:17:21,880 --> 00:17:25,380
هذا محيّرٌ! يبدو أنّنا ندورُ في حلقةٍ
.مُفرغة ورجعنا إلى نفسِ المكان

278
00:17:25,630 --> 00:17:27,560
هل أنت متيقّنٌ أنّ
هذا الدّرب الصّحيح؟

279
00:17:27,910 --> 00:17:28,910
،لا شكّ في ذلك

280
00:17:29,080 --> 00:17:30,940
.فقد سلكتُ هذا الدّرب مرارًا

281
00:17:32,530 --> 00:17:33,590
...هذا الضّباب السّام

282
00:17:34,080 --> 00:17:36,410
.يبدو مألوفًا

283
00:17:37,590 --> 00:17:38,970
،سيفُ السّحاب

284
00:17:46,760 --> 00:17:47,290
!لننطلِق

285
00:17:56,500 --> 00:17:58,970
،عُذرًا أيّها السيّد
.انتظِر لوهلةٍ

286
00:18:01,800 --> 00:18:03,530
هل لي أن أطلبَ منكُما خدمةً؟

287
00:18:05,840 --> 00:18:07,790
أعددتُ وصفةً طبيّة
،لدفع الرّطوبة

288
00:18:07,800 --> 00:18:11,000
وأرغبُ بعد قليلٍ في توزيع
.دواءٍ مجانيّ لأهل القرية

289
00:18:11,220 --> 00:18:12,670
...فهل تتكرّمان بحشد

290
00:18:12,680 --> 00:18:14,930
مَن تستطيعان مِن سُكانها؟

291
00:18:16,920 --> 00:18:19,650
،أيّها الصيدلانيّ لِي
.أنت طيّبٌ بحقّ

292
00:18:19,680 --> 00:18:20,550
.أجل

293
00:18:21,130 --> 00:18:21,860
.لا عليكَ

294
00:18:21,880 --> 00:18:23,970
.دعِ المسألة لنا

295
00:18:24,650 --> 00:18:25,600
،سأمضي إلى عُمدة القرية

296
00:18:25,610 --> 00:18:27,010
.ليُساعدني في إبلاغ الجميع

297
00:18:27,680 --> 00:18:28,330
.ممتنٌّ لكُما

298
00:18:40,380 --> 00:18:41,630
،أنا بحاجةٍ إلى عونكِ

299
00:18:42,540 --> 00:18:43,340
.تعالي سريعًا

300
00:18:46,880 --> 00:18:49,080
.يبدو أنّنا تجاوزنا الضّباب السّام

301
00:18:56,270 --> 00:18:57,130
،آنسة شُو

302
00:18:57,160 --> 00:18:57,830
،انظرِي هُناك

303
00:18:57,840 --> 00:18:59,170
.يبدو أنّ ثمّة كهفًا

304
00:19:24,960 --> 00:19:25,770
...هذا

305
00:19:26,170 --> 00:19:26,960
.عُشب شبحٍ

306
00:19:37,340 --> 00:19:39,540
يُوجد وحشٌ شيطانيّ
.يقبعُ هُنا

307
00:19:39,880 --> 00:19:42,140
هل أصابَ يُون زُو مكروهٌ؟

308
00:19:44,220 --> 00:19:45,760
.لنمضِ ونتفقّد ذلك الكهف

309
00:19:59,300 --> 00:19:59,930
.هيّا بنا

310
00:20:12,890 --> 00:20:16,140
هذا المكان... يمتدّ ويتّسع في
.الدّاخل على نحوٍ غير مُتوقّع

311
00:20:16,260 --> 00:20:17,660
!آنسة شُو، انظرِي هُناك

312
00:20:24,460 --> 00:20:25,050
...هذه

313
00:20:31,720 --> 00:20:32,680
...هل يُمكن أن تكونَ

314
00:20:40,440 --> 00:20:41,810
،أيّتها الأخت الكُبرى
.يُون زُو

315
00:20:42,760 --> 00:20:47,010
!الأخت الكُبرى، يُون زُو
هل فارقت يُون زُو الحياة؟

316
00:20:50,580 --> 00:20:51,800
،أنا آسفةٌ يا يُون زُو

317
00:20:53,700 --> 00:20:55,260
.تأخّرتُ

318
00:21:19,120 --> 00:21:19,950
،شِياوتَان

319
00:21:20,730 --> 00:21:22,590
عليّ الوُلوج إلى وَهم
،السّراب لأُلقي نظرةً

320
00:21:22,600 --> 00:21:24,260
.وقد يغيبُ وعيي لوهلةٍ

321
00:21:25,350 --> 00:21:26,510
!آنسة شُو

322
00:21:27,520 --> 00:21:28,520
،لا تقلق

323
00:21:28,930 --> 00:21:30,930
لن يستغرقَ الأمر سوى
.لحظاتٍ معدودة

324
00:21:31,940 --> 00:21:33,140
،وإن حدثَ طارئٌ

325
00:21:33,910 --> 00:21:35,830
فإنّ سيفَ السّحاب
.سيَتكفّلُ بحمايتنا

326
00:22:16,720 --> 00:22:23,640
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

327
00:22:23,750 --> 00:22:34,280
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

328
00:22:34,310 --> 00:22:39,010
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

329
00:22:39,020 --> 00:22:42,090
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

330
00:22:43,690 --> 00:22:47,510
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

331
00:22:47,520 --> 00:22:51,420
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

332
00:22:52,020 --> 00:22:56,260
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

333
00:22:56,690 --> 00:23:01,390
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

334
00:23:01,400 --> 00:23:06,550
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

335
00:23:06,560 --> 00:23:10,590
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

336
00:23:10,600 --> 00:23:15,720
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

337
00:23:15,730 --> 00:23:20,220
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

338
