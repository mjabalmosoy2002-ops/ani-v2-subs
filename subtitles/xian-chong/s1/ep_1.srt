1
00:00:13,280 --> 00:00:19,740
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

2
00:00:20,000 --> 00:00:25,840
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

3
00:00:27,800 --> 00:00:33,800
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

4
00:00:34,190 --> 00:00:39,820
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

5
00:00:41,170 --> 00:00:47,330
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

6
00:00:48,210 --> 00:00:54,350
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

7
00:00:56,030 --> 00:01:02,780
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

8
00:01:02,810 --> 00:01:09,160
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

9
00:01:09,360 --> 00:01:16,310
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

10
00:01:16,690 --> 00:01:22,460
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

11
00:01:23,380 --> 00:01:29,480
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

12
00:01:29,600 --> 00:01:36,720
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

13
00:01:53,070 --> 00:01:54,720
.لم أَعُد أقوى على الشّرب أكثر

14
00:01:54,750 --> 00:01:57,920
يا كَاي، سأَشربُ معكم حتّى
.الثّمالة في يومٍ آخر

15
00:01:57,930 --> 00:01:59,800
،إنّ جِين يُحاول طردنا

16
00:01:59,810 --> 00:02:02,210
.لا بُدّ أنّ العَروس تنتظره بفارغ الصّبر

17
00:02:02,320 --> 00:02:05,000
...لو اشتكت إلى اللّورد لِين لاحقًا

18
00:02:05,030 --> 00:02:06,960
.فقد تتعرّض مسيرتنا المِهنيّة للخطر

19
00:02:07,740 --> 00:02:09,100
.لا بُدّ أنّك تمزح

20
00:02:09,440 --> 00:02:10,660
.اذهب إلى عَروسِك

21
00:02:30,890 --> 00:02:31,530
،يا زَوجتي

22
00:02:32,180 --> 00:02:34,660
إنّ زواجي بكِ لفَضلٌ نِلتهُ
.بعد مئة حياةٍ مِن السّعي

23
00:02:35,410 --> 00:02:37,770
.اطمئنّي، فسأَرعاكِ بكُلّ إحسانٍ

24
00:02:38,570 --> 00:02:40,650
أَلن تَخدعنِي؟

25
00:02:41,960 --> 00:02:43,050
...أُقسم

26
00:02:43,570 --> 00:02:44,990
،أنّني لن أكذبَ عليكِ أبدًا

27
00:02:45,030 --> 00:02:45,920
،وإن نكثتُ عَهدي هذا

28
00:02:45,930 --> 00:02:47,980
.فليكُن مَوتي شنيعًا

29
00:02:48,010 --> 00:02:50,070
...يا جِين
.أخذتَ حديثي على محمل الجِدّ

30
00:02:50,420 --> 00:02:52,130
.بالطّبع أنا أُصدّقك

31
00:02:53,750 --> 00:02:54,730
،ولكن يا جِين

32
00:02:55,390 --> 00:02:57,230
،مِنديل المَاندارِين الّذي طرّزته لكَ

33
00:02:57,240 --> 00:02:59,240
لماذا لا تَحمِله معكَ؟

34
00:03:00,490 --> 00:03:03,510
متى أَعطيتِني مِنديلًا مُطرزًا
بطير المَاندارِين؟

35
00:03:05,360 --> 00:03:08,550
،قُلتَ إنّه رمز حُبّنا
...وإنّكَ ستَحمل ما طرّزته يداي

36
00:03:08,560 --> 00:03:10,510
.كُلّ يومٍ

37
00:03:10,520 --> 00:03:11,780
أَنسيت الآن؟

38
00:03:12,900 --> 00:03:14,150
.لا شكّ أنّكِ تمزحين يا حَبيبتي

39
00:03:14,160 --> 00:03:15,560
...فالرّمز الّذي أَعطيتِني إيّاه

40
00:03:16,070 --> 00:03:17,400
.هُو قلادةٌ مِن اليَشب الأبيض

41
00:03:17,410 --> 00:03:18,940
.وأنا أَحملُها معي دومًا

42
00:03:19,150 --> 00:03:22,070
أَلا يُعجبكَ المِنديل إذن؟

43
00:03:22,610 --> 00:03:24,240
،إن كان لا يُعجبكَ

44
00:03:24,630 --> 00:03:26,850
فلماذا خَدعتني بقولكَ أنّه أعجبكَ؟

45
00:03:27,820 --> 00:03:31,820
ولماذا خَدعتني حِين قُلتَ إنّك ستَتزوّجني حِين يُدرج
اسمك في قائمة النّاجحين بالاختبارات الإمبراطوريّة؟

46
00:03:32,280 --> 00:03:35,320
...ولماذا كذبتَ بأنّه لا صِلة

47
00:03:36,290 --> 00:03:38,010
خفيّةً تجمعكَ بالآنسة لِين؟

48
00:03:39,130 --> 00:03:40,390
كيف... كيف لكِ أن...؟

49
00:03:41,380 --> 00:03:44,180
خَدعتني حِين طلبتَ منّي
...انتظارك عند

50
00:03:44,320 --> 00:03:46,310
.بُحيرة اللّوتس لنَهرب معًا

51
00:03:47,430 --> 00:03:49,850
!أنتِ شِيو... شِيو-أر

52
00:03:50,560 --> 00:03:52,160
يا جِين، أَلا تعرِفني؟

53
00:03:52,570 --> 00:03:53,380
.صحيحٌ

54
00:03:54,340 --> 00:03:57,120
كيف لـ شِيو-أر أن تملكَ
بشرةً نقيّة كهذه؟

55
00:03:58,740 --> 00:03:59,850
...وجه شِيو-أر

56
00:03:59,870 --> 00:04:01,130
.يجب أن يكون هكذا

57
00:04:01,790 --> 00:04:03,870
!هكذا يجب أن يكون

58
00:04:04,100 --> 00:04:07,010
انظُر... يُمكنكَ تمييز شِيو-أر
الآن؟ أَليس كذلك؟

59
00:04:11,210 --> 00:04:12,820
!لا تَقتربي أكثر

60
00:04:13,940 --> 00:04:15,470
.اهدأ يا جِين

61
00:04:15,500 --> 00:04:17,120
.كُنت أُمازحكَ فحسب

62
00:04:17,690 --> 00:04:19,270
.المِنديل لم يُفقد

63
00:04:19,270 --> 00:04:20,740
.إنّه هُناك تمامًا

64
00:04:27,370 --> 00:04:29,960
.شِيو... شِيو-أر، أخطأتُ

65
00:04:30,010 --> 00:04:33,390
،أسأتُ إليكِ، أرجوكِ
!اصفحِي عن حياتي

66
00:04:33,590 --> 00:04:36,780
.وعدتَ أن نكون معًا للأبد

67
00:04:38,120 --> 00:04:40,920
.أنا هُنا لآخذكَ معي

68
00:04:44,300 --> 00:04:45,210
!عجبًا

69
00:04:45,510 --> 00:04:47,130
،اللّيل طويلٌ

70
00:04:47,500 --> 00:04:49,580
فما الدّاعي للعَجلة؟

71
00:04:49,600 --> 00:04:50,380
مَن أنتِ؟

72
00:04:57,810 --> 00:05:00,370
.اخرُجي مِن جسد العَروس حالًا

73
00:05:11,570 --> 00:05:14,370
،إن كشفتِ عن نفسكِ طوعًا
...سأرحمكِ

74
00:05:14,690 --> 00:05:16,220
.وأمنحكِ موتًا سريعًا

75
00:05:16,240 --> 00:05:18,370
،إنّه خانَني

76
00:05:18,910 --> 00:05:20,370
.وقَتلني

77
00:05:20,650 --> 00:05:23,250
!إنّه يستحقّ الموت
!يستحقّ الموت

78
00:05:23,630 --> 00:05:25,620
كُفّي عن تمثيل دور الرّوح
.الّتي تنشدُ الثّأر

79
00:05:26,770 --> 00:05:28,700
،فلستِ شِيو-أر المِسكينة

80
00:05:28,780 --> 00:05:30,290
.ولا هذه العَروس سيّئة الحظّ

81
00:05:31,130 --> 00:05:33,450
...لستِ سِوى كُتلةٍ لزِجةٌ

82
00:05:33,820 --> 00:05:36,370
تهوى الاستحواذ على
.الأجساد والعبث بالقُلوب

83
00:05:36,380 --> 00:05:37,200
ألستُ مُحقةً؟

84
00:05:37,710 --> 00:05:39,010
.يا شيطان السّراب

85
00:05:40,010 --> 00:05:41,740
،أيّتها الخالدة
.إنّ بصيرتكِ ثاقبةٌ

86
00:05:42,210 --> 00:05:44,170
...إذن، هل تعلمين

87
00:05:44,200 --> 00:05:46,010
أنّ حياتي مربوطةٌ بهذا الجسد؟

88
00:05:46,690 --> 00:05:47,930
،إن مُتّ

89
00:05:48,820 --> 00:05:50,790
...ستَموت هذه

90
00:05:50,820 --> 00:05:51,750
.الشّابة معي

91
00:05:52,030 --> 00:05:53,020
.لنَختبر ذلك إذن

92
00:05:55,400 --> 00:05:56,350
شريطٌ أحمر؟

93
00:05:56,370 --> 00:05:57,490
شعرٌ مُجعّد؟

94
00:06:04,420 --> 00:06:06,910
،إن لم تخرجي مِن ذاك الجسد طوعًا
.فستَحترقين حتّى تَستحِيلي رمادًا

95
00:06:06,920 --> 00:06:10,520
أنتِ تِيان كوَان، آلهةُ الحرب
!وحاميةُ الأرض في الجنوب

96
00:06:22,290 --> 00:06:23,180
!سيفُ السّحاب

97
00:06:37,260 --> 00:06:40,700
شِيو-أر... شِيو-أر
!جاءت لتَقتصّ منّي

98
00:06:42,050 --> 00:06:43,180
.لم تكُن تلك شِيو-أر

99
00:06:43,900 --> 00:06:46,310
لم يكُن ذلك سِوى خُدعةٍ
.رخيصة مِن شيطان السّراب

100
00:06:46,390 --> 00:06:47,710
.شِيو-أر ماتت

101
00:06:48,060 --> 00:06:49,590
.ولن تعود إليكَ قطعًا

102
00:06:49,850 --> 00:06:52,600
!شِيو-أر عادت... شِيو-أر

103
00:06:54,700 --> 00:06:56,760
!تنحّوا جانبًا
!السّلطات تُباشر عملها

104
00:06:57,650 --> 00:07:00,030
أيّها المُحقّق، عُثر على
!جُثّة امرأةٍ في البُحيرة

105
00:07:04,880 --> 00:07:05,680
!لِي جِين هُنا

106
00:07:06,510 --> 00:07:07,080
،لِي جِين

107
00:07:07,450 --> 00:07:09,790
أنت مطلوبٌ للعدالة
.بتُهمة قتل شِيو-أر

108
00:07:10,160 --> 00:07:12,010
!هيّا، اصحبُه معنا

109
00:07:12,270 --> 00:07:12,840
!أجل

110
00:07:16,550 --> 00:07:20,350
أيّتها الخالدة، أشكركِ لأنّكِ سعيتِ
.في طلب الحقّ لحفيدتي المِسكينة

111
00:07:20,770 --> 00:07:24,890
يا للرّاحة، حُكم على ذاك
.الوحش بالموت

112
00:07:25,170 --> 00:07:27,040
،شيو-أر المِسكينة

113
00:07:27,260 --> 00:07:29,130
.حان لكِ الآن أن ترقُدي بسلامٍ

114
00:07:45,920 --> 00:07:49,010
.وهكذا، أُغلقت قضيّةٌ أُخرى

115
00:07:49,360 --> 00:07:52,270
،أمّا حاميةُ الأرض
...كلا، كلا

116
00:07:52,650 --> 00:07:53,980
،بل الخالدة تِيان كوَان

117
00:07:54,350 --> 00:07:57,750
فقد تَلاشت تحت ضوء القمر
.بحركةٍ خاطفة مِن شرائطها الحَمراء

118
00:07:59,210 --> 00:08:01,610
كُنت أحقّق في قضيّة
،شِيو-أر فحسب

119
00:08:01,700 --> 00:08:03,260
ولم أتوقّع أن أُوقع
.بشيطان السّراب

120
00:08:03,270 --> 00:08:05,230
لماذا استهدف ذاك الشّيطان
لِي جِين؟

121
00:08:05,570 --> 00:08:08,630
رُبّما كان شيطان السّراب
...يتخفّى في الماء

122
00:08:08,660 --> 00:08:10,460
حِين لقِيت شِيو-أر حتفها
.في بُحيرة اللّوتس

123
00:08:10,670 --> 00:08:13,480
ظنّ الشّيطان أنّ بمقدوره
.التسلّي قليلًا

124
00:08:13,670 --> 00:08:15,750
...لكن، أَلم يقُم لِي جِين برشوة

125
00:08:15,850 --> 00:08:17,050
الحُكومة للتّستر على جريمته؟

126
00:08:18,170 --> 00:08:19,550
كيف لهُم أن يَعتقلُوه إذن؟

127
00:08:22,390 --> 00:08:24,240
،ذلك الحاكم كان بليدًا

128
00:08:24,250 --> 00:08:26,680
.لذا، قُمت بـ تنبِيهه بلُطفٍ شديد

129
00:08:31,540 --> 00:08:34,100
!يا جُوان جُوان، النّار
.ستَنجح هذه المرّة

130
00:08:38,530 --> 00:08:39,300
.تمّ الأمر

131
00:08:41,050 --> 00:08:44,450
حصلتُ أخيرًا على الشّعر النّاعم
!المُسترسِل الّذي طالما حلمتُ به

132
00:08:50,310 --> 00:08:51,900
!سحقًا لهذا الشّعر المُجعّد

133
00:08:51,920 --> 00:08:54,420
لا يرغبُ في الاستقامة
مهما فعلتُ! لماذا؟

134
00:08:55,490 --> 00:08:56,570
ما خطب الشّعر المُجعّد؟

135
00:08:56,580 --> 00:08:58,480
.أرى أنّه يبدو رائعًا

136
00:08:58,590 --> 00:09:01,360
.أنتِ مفخرةُ عشيرة الثّعالب

137
00:09:01,950 --> 00:09:05,300
،في معركة أرض السّراب
.قتلتِ ملك السّراب بمُفردكِ

138
00:09:05,310 --> 00:09:06,860
.أنتِ محاربةٌ باسِلة

139
00:09:07,410 --> 00:09:10,180
ورُغم وجودكِ في عالم البشر
،لحماية السّلام

140
00:09:10,190 --> 00:09:12,860
لا تزالينَ رمز الجمال في
.هُونغ مِينغ السّماوية

141
00:09:12,870 --> 00:09:16,530
الجميع يقولون إنّ عشر سنواتٍ مِن
.الحرب جعلت أرض تَسانغ شُو رُكامًا

142
00:09:17,610 --> 00:09:20,000
.لكن شيطان السّراب ضعيفٌ

143
00:09:20,830 --> 00:09:22,990
كيف له أن يُسبّب كُلّ هذه الفوضى؟

144
00:09:23,850 --> 00:09:27,260
يا سيّدي القِطّ، أنت لم تبدأ تعلّمك إلّا
.مُنذ بعض سنواتٍ، فلا عجبَ أَلا تعرف

145
00:09:27,270 --> 00:09:30,100
،ذاك لأنّ ملك السّراب
،سيّد هذا الشّيطان

146
00:09:30,110 --> 00:09:33,040
.قد وقعَ في يده شيءٌ لا يُصدّق

147
00:09:34,360 --> 00:09:35,560
.إليكِ الدّواء

148
00:09:39,020 --> 00:09:41,390
يا تَشانغ-أر، أَلم يكُن مِن المُفترض
أن تقوم بدورياتٍ في الجنوب؟

149
00:09:41,400 --> 00:09:43,650
مع ذلك، يبدو أنّك تزور
.الصّيدلية الإمبراطوريّة كثيرًا

150
00:09:43,660 --> 00:09:45,390
هذا هّو الدّواء الجديد
...الّذي صنعهُ الخالد تُشو

151
00:09:45,400 --> 00:09:47,560
.خصيصًا لكِ بأمرٍ مِن العاهل

152
00:09:47,570 --> 00:09:50,170
إنّه يعمل بمثاليّةٍ على ترميم
.الأرواح الخالدة المُتضرّرة

153
00:09:50,960 --> 00:09:52,320
.مِيان مِيان، أنا جائعٌ

154
00:09:54,130 --> 00:09:55,420
.مِيان مِيان، ماءٌ

155
00:09:56,980 --> 00:10:00,220
،مِيان مِيان، ثيابي متّسخةٌ
.اغسِليها لي

156
00:10:00,230 --> 00:10:02,960
،الطّبخ، الغسِيل، الزّراعة
—إزالة الأعشاب

157
00:10:02,970 --> 00:10:05,300
أنا مَن أقوم بكُلّ هذه الأعمال
!الشّاقة والمُتعِبة دائمًا

158
00:10:05,310 --> 00:10:07,180
،بما أنّك لا تهتمّ بي

159
00:10:07,190 --> 00:10:08,760
!سأَجعلُك تُعاني اليوم

160
00:10:10,700 --> 00:10:13,570
قصر بَان يُوي يُعاني نقصًا في
الأيدي العاملة بالفِعل، أَليس كذلك؟

161
00:10:13,970 --> 00:10:15,880
...سيّدي القطّ، ما رأيك في

162
00:10:16,200 --> 00:10:17,440
،في اليوم السّابع مِن الشّهر الماضي

163
00:10:17,450 --> 00:10:20,390
ظننتِ أنّ صاحب جناح
.تِيان باو خاطفٌ

164
00:10:20,400 --> 00:10:23,590
فحطّمتِ مجموعةً مِن التّحف الّتي
.لا تُقدّر بثمنٍ أثناء عمليّة الإنقاذ

165
00:10:23,600 --> 00:10:24,890
وفي اليوم الثّالث مِن الشّهر
،الّذي سبقه

166
00:10:24,900 --> 00:10:28,120
أحرقتِ بُحيرة أسماك كُوي لعائلة وَانغ في
.الغرب عندما كُنتِ تُقاتلين شيطان الأفعى

167
00:10:28,130 --> 00:10:29,030
...وفي الشّهر الّذي سبقه

168
00:10:29,040 --> 00:10:30,590
!حسنًا، هذا يكفي

169
00:10:30,600 --> 00:10:32,280
،مُجرّد غسيلٍ وطبخ

170
00:10:32,290 --> 00:10:33,850
.سأَقوم بذلك بنفسي

171
00:10:34,180 --> 00:10:35,850
...إذا كُنتِ بحاجةٍ للمُساعدة حقًا

172
00:10:36,290 --> 00:10:39,610
،فحيواناتٌ مِثلنا، برواتب مُنخفضةٍ
—وعُقودٍ مُلزِمة

173
00:10:40,400 --> 00:10:41,520
.يُمكنكِ توظيفنا

174
00:10:43,010 --> 00:10:45,010
،ذكيٌّ بما يكفي لتبيعَ نفسك
أَليس كذلك؟

175
00:10:45,080 --> 00:10:47,420
،لكن هُناك معضلةٌ واحدة

176
00:10:48,110 --> 00:10:50,040
.قصرٌ واحد لا يسعُ قِطّين

177
00:10:51,910 --> 00:10:53,160
.حسنًا

178
00:10:54,950 --> 00:10:55,520
!تقريرٌ

179
00:10:56,600 --> 00:10:57,280
.تفضّلا

180
00:11:02,030 --> 00:11:06,430
أيّتها الخالدة، تناهى إلى مسامعي أنّ هُناك طائرًا
.شرّيرًا يُؤذي النّاس بالقُرب مِن قرية شَانغ شُوي

181
00:11:06,460 --> 00:11:07,290
طائرٌ شرّير؟

182
00:11:07,480 --> 00:11:11,140
،هذا الطّائر الشّرير أسودُ فاحمٌ
.وعلى رأسه ريشةٌ حمراء واحدة

183
00:11:17,330 --> 00:11:17,920
.لنَنطلق

184
00:11:19,810 --> 00:11:20,940
.لنَذهب ونُلقِ نظرةً

185
00:11:57,910 --> 00:11:58,580
.سيّدي

186
00:12:01,500 --> 00:12:02,200
،سيّدي

187
00:12:04,670 --> 00:12:06,000
هل لي أن أسألكَ شيئًا؟

188
00:12:06,560 --> 00:12:10,520
هل وقعت أيّ حادثةٍ لطائر شرّير
يُؤذي النّاس هُنا مُؤخّرًا؟

189
00:12:10,530 --> 00:12:13,130
رأيتُ توابيتَ موضوعةً
.في ساحات المنازل

190
00:12:13,200 --> 00:12:14,460
هل حدث شيءٌ ما؟

191
00:12:16,750 --> 00:12:17,410
ماذا؟

192
00:12:18,810 --> 00:12:20,550
.سيّدي، لا تدفعني

193
00:12:20,660 --> 00:12:22,260
.لا أقصدُ أيّ سوءٍ يا سيّدي

194
00:13:42,850 --> 00:13:45,950
سيّدي، ماذا تفعل؟

195
00:13:54,980 --> 00:13:56,980
لم أتوقّع أن يعرف شخصٌ
...في قريةٍ مغمورة كهذه

196
00:13:56,990 --> 00:13:59,320
.كيفيّة استخدام تعويذة تقيِيد العقل

197
00:14:00,260 --> 00:14:02,390
لماذا تتحكّم في هؤلاء النّاس؟

198
00:14:04,400 --> 00:14:06,220
،بما أنّك لا تستطيع التّفسير

199
00:14:06,230 --> 00:14:07,840
.فليُخبروني هُم

200
00:14:11,130 --> 00:14:13,390
،أنتَ بشريٌّ فانٍ
.ولا أُريد إيذاءكَ

201
00:14:13,650 --> 00:14:15,000
،ولكن مهما كانت ضغِينتك

202
00:14:15,010 --> 00:14:16,420
.أطلِق سراحهم أولًا

203
00:14:45,790 --> 00:14:47,520
.استهنتُ بهذا العجوز

204
00:14:47,840 --> 00:14:49,250
!يا لها مِن تعويذةٍ قويّة

205
00:14:54,220 --> 00:14:55,950
.إنّها مُجرّد بشريّةٍ عاديّة

206
00:14:56,370 --> 00:14:58,570
كيف لها أن تمتلكَ مِثل
هذه السّرعة والقُوّة؟

207
00:15:04,450 --> 00:15:06,100
.لا يُمكنني القتال بكامل قُوّتي

208
00:15:06,110 --> 00:15:07,180
.يا له مِن أمرٍ مُزعج

209
00:15:08,990 --> 00:15:12,120
،أنتِ لا تتوقّفين أبدًا
.لا تلُومِيني إذا صرتُ جادّةً

210
00:15:25,080 --> 00:15:27,540
.هذه ليست تعويذة تقيِيد عقلٍ عاديّةً

211
00:15:27,680 --> 00:15:29,370
.مَن رسمَها شخصٌ قويٌّ للغاية

212
00:15:29,380 --> 00:15:31,180
.وليس بمَقدور أمثالك رسمَها

213
00:15:51,350 --> 00:15:53,390
ماذا... ماذا تَفعلين؟

214
00:16:04,840 --> 00:16:06,570
.توقّفي... توقّفي عن الحفر

215
00:16:13,210 --> 00:16:14,920
!كسرت عِظامها حتّى

216
00:16:21,770 --> 00:16:23,570
.إنّها تُريد دفن نفسها حيّةً

217
00:16:27,420 --> 00:16:30,020
...كانت هذه التّميمة تهدفُ لإيقافها

218
00:16:30,820 --> 00:16:31,950
.وإنقاذها

219
00:16:33,390 --> 00:16:34,530
.أنا آسفةٌ

220
00:16:50,940 --> 00:16:52,130
!مهلًا، مهلًا، مهلًا

221
00:16:52,990 --> 00:16:55,430
!كيف تَجرؤ على قتلِها أمام ناظريَّ

222
00:16:56,160 --> 00:16:57,930
.إنّك تمتلكُ جُرأةً كبيرة

223
00:16:58,380 --> 00:16:59,960
.الطّائر الشرّير الأسود

224
00:17:10,460 --> 00:17:12,450
.سيفُ السّحاب

225
00:17:19,170 --> 00:17:20,230
أَما زالت على قيدِ الحياة؟

226
00:17:46,450 --> 00:17:47,330
ما خَطب القرية؟

227
00:17:47,350 --> 00:17:50,080
ماذا... ماذا حدث لي؟

228
00:17:50,100 --> 00:17:51,100
.يا كُرة الفحم الصّغيرة

229
00:17:51,200 --> 00:17:52,880
عالجتَ هذه العجوز؟

230
00:18:04,700 --> 00:18:06,740
ماذا فعلتَ بها؟

231
00:18:12,660 --> 00:18:13,900
ما هذا الشّيء؟

232
00:18:18,620 --> 00:18:20,790
...إذًا هذا ما ينبتُ في آذانهم

233
00:18:20,810 --> 00:18:22,070
ويدفعهم للجُنون؟

234
00:18:22,830 --> 00:18:24,970
تتردّد الشّائعات أنّ طائرًا
.أسود كان يُؤذي النّاس

235
00:18:24,980 --> 00:18:26,790
،لكنّك في الحقيقة كُنت تنقذهم
صحيحٌ؟

236
00:18:26,800 --> 00:18:28,130
مَن أنت حقًا؟

237
00:18:32,320 --> 00:18:35,350
آنستي، هل أنتِ مَن أنقذني؟

238
00:18:36,990 --> 00:18:37,600
،سيّدتي

239
00:18:37,920 --> 00:18:39,980
هل تتذكّرين ماذا حدث لكِ؟

240
00:18:40,220 --> 00:18:43,720
هل أُصبت أنا أيضًا
بهذا المرض الغريب؟

241
00:18:43,730 --> 00:18:44,440
مرضٌ غريب؟

242
00:18:44,450 --> 00:18:47,740
أجل، هُناك مرضٌ غريب
.ينتشر في القرية

243
00:18:47,750 --> 00:18:49,440
.وقد مات بسببِه الكثير مِن النّاس

244
00:18:49,450 --> 00:18:51,110
أيّ نوعٍ مِن الأمراض هذا؟

245
00:18:51,700 --> 00:18:54,970
...كان هُناك صوتٌ لا ينفكُّ

246
00:18:54,980 --> 00:18:56,530
.يأَمرُني بالحفر

247
00:18:56,850 --> 00:18:59,850
ثُمّ خرجت يدايَ عن سيطرتي
.وبدأتا بالحفر

248
00:19:00,050 --> 00:19:02,220
.في البِداية، استخدمتُ فأسًا

249
00:19:02,250 --> 00:19:04,090
.وعندما انكسَر، استعنتُ بعصًا

250
00:19:04,140 --> 00:19:06,980
،ولمّا انكسرت العصا
...استخدمتُ يديَّ حتّى

251
00:19:07,080 --> 00:19:08,850
.حتّى تدفِني نفسكِ حيّةً

252
00:19:10,700 --> 00:19:12,160
ماذا عن هذه التّميمة؟

253
00:19:12,630 --> 00:19:15,630
،قبل عشرين عامًا
.كان العالم يعيشُ في فوضى

254
00:19:16,000 --> 00:19:17,830
.والجُثث ملأى في كُلّ مكانٍ

255
00:19:19,340 --> 00:19:22,380
.أنقذَ زوجي كاهنًا طاويًا كان يحتضر

256
00:19:22,950 --> 00:19:25,300
،فأَعطاه هذه التّميمة

257
00:19:25,320 --> 00:19:27,340
،وقال له إنّ العالم في اضطرابٍ

258
00:19:27,360 --> 00:19:30,180
.وقد تُنقذ حياته في لحظةٍ حاسمة

259
00:19:30,350 --> 00:19:31,730
قبل عشرين عامًا؟

260
00:19:31,840 --> 00:19:33,510
.خلال المعركة على أرض السّراب

261
00:19:33,520 --> 00:19:36,850
قبل بضعةِ أيّامٍ، بدأ القرويّون
.يُصابون بمرضٍ غريب

262
00:19:36,860 --> 00:19:39,480
،جرّب زوجي التّميمة على أحدهم

263
00:19:39,490 --> 00:19:41,330
.وقد نجحت في تهدِئته بالفِعل

264
00:19:42,480 --> 00:19:44,580
،لذا صنع المزيد منها

265
00:19:44,600 --> 00:19:46,570
،بناءً على ذلك النّمط

266
00:19:46,580 --> 00:19:48,080
.لمُساعدتهم

267
00:19:48,290 --> 00:19:49,810
زوجكِ لم يُمارس التّعاليم
.الروحيّة قطّ

268
00:19:49,820 --> 00:19:50,660
،لذا منطقيًا

269
00:19:50,690 --> 00:19:53,950
لا يُفترض بالتّمائم الّتي رسمَها
.أن تكون بهذه الفعاليّة

270
00:19:55,150 --> 00:19:56,480
هل استَخدم دمهُ؟

271
00:19:56,690 --> 00:19:59,680
كان هُو الوحيد الّذي
.لم يُصب بالعدوى

272
00:19:59,840 --> 00:20:02,230
،طلبتُ منه الرّحيل
.لكنّه رفض

273
00:20:02,560 --> 00:20:05,690
وقال إنّه لو استطاع إنقاذ ولو شخصٍ
.واحد، فإنّ ذلك يستحقّ العناء

274
00:20:05,890 --> 00:20:07,950
...أعتقد أنّ هذا الشّيء الشبيه بالبُذور

275
00:20:07,960 --> 00:20:09,280
...يدخل آذانكُم

276
00:20:09,390 --> 00:20:11,250
.ويدفعكم لإيذاء أَنفسكم

277
00:20:11,360 --> 00:20:12,730
،زوجكِ أصمّ

278
00:20:12,740 --> 00:20:14,000
.لذا لم يتأثّر

279
00:20:15,620 --> 00:20:16,230
!مهلًا

280
00:20:16,740 --> 00:20:19,050
،إذا سحبنا جميع البُذور مِن آذانهِم

281
00:20:19,060 --> 00:20:21,060
فمِن المُفترض أن ينجو
القرويّون، صحيحٌ؟

282
00:20:32,730 --> 00:20:34,410
.يا كُرة الفحم الصّغيرة

283
00:20:34,510 --> 00:20:35,520
.انظُر إليهم

284
00:20:35,540 --> 00:20:37,270
هل لا يزال بمَقدورنا سحبُ البُذور؟

285
00:20:42,060 --> 00:20:44,310
التّميمة يُمكنها كبحهُم
.لفترةٍ وجيزة فحسب

286
00:20:44,320 --> 00:20:46,520
،علينا معرفة مصدر بُذور الشّيطان هذه

287
00:20:46,530 --> 00:20:47,930
.وكيفية التخلّص منها

288
00:20:48,730 --> 00:20:50,740
بما أنّك عرفت أنّ نقرَ
،آذانهم سيُساعِدهم

289
00:20:50,750 --> 00:20:53,010
فلا بُدّ أنّك تعرف شيئًا
آخر أيضًا، صحيحٌ؟

290
00:21:00,160 --> 00:21:02,630
القرويّون في الدّاخل لم يَعُد
.لديهم الكثير مِن الوقت

291
00:21:02,640 --> 00:21:03,740
.سأَذهب لأجدَ طريقةً لإنقاذهم

292
00:21:03,750 --> 00:21:04,820
،اعتنيا بأنفسكما

293
00:21:04,830 --> 00:21:06,680
.وسأُرسل مَن يُساعدكما قريبًا

294
00:21:06,690 --> 00:21:08,220
.لنَنطلق يا كُرة الفحم

295
00:21:18,180 --> 00:21:24,940
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

296
00:21:25,240 --> 00:21:33,750
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

297
00:21:35,700 --> 00:21:40,050
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

298
00:21:40,530 --> 00:21:43,630
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

299
00:21:45,070 --> 00:21:48,930
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

300
00:21:48,960 --> 00:21:52,730
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

301
00:21:53,410 --> 00:21:57,560
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

302
00:21:58,090 --> 00:22:02,270
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

303
00:22:02,800 --> 00:22:07,980
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

304
00:22:08,080 --> 00:22:11,340
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

305
00:22:12,100 --> 00:22:17,110
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

306
00:22:17,130 --> 00:22:21,600
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

307
00:22:21,710 --> 00:22:26,670
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

308
00:22:26,680 --> 00:22:31,130
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

309
00:22:36,250 --> 00:22:41,830
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟