1
00:00:24,700 --> 00:00:27,560
أبي، لا يُمكن لأُمّي أن
.تستمرّ على هذا الحال

2
00:00:27,890 --> 00:00:29,720
.نحنُ بحاجةٍ إلى إحضار طبيبٍ

3
00:00:30,640 --> 00:00:32,960
.كان الحصاد سيئًا هذا العام

4
00:00:33,160 --> 00:00:35,360
لماذا نُبذّر المال فيما
لا رجاءَ فيه؟

5
00:00:37,280 --> 00:00:38,210
...لكن أُمّي

6
00:00:40,740 --> 00:00:42,710
.سأذهبُ لأتفقّد الجبل مُجدّدًا

7
00:01:10,450 --> 00:01:11,820
لماذا؟

8
00:01:12,030 --> 00:01:17,030
يا إلهي، لم لا تهبُني فرجًا؟

9
00:01:18,570 --> 00:01:22,390
،في أقصى عتماتِ اليأس
.قد يُفتح باب الرّجاء

10
00:01:22,420 --> 00:01:23,150
مَن هُناك؟

11
00:01:23,770 --> 00:01:27,430
في عالمٍ بهذا الاتّساع، كيف
لا يكونُ هُناك دربٌ للمُضيّ قُدمًا؟

12
00:01:55,520 --> 00:01:57,910
.هذه بذرةُ لوتسٍ حمراء

13
00:01:58,330 --> 00:02:02,700
يُمكنها أن تُعيد الموتى إلى
.الحياة وتستردّ شبابهم

14
00:02:03,640 --> 00:02:06,560
يُمكنك استخدامُها لإنقاذ
،حياةٍ واحدة

15
00:02:06,580 --> 00:02:10,960
—أو زراعتها لتنمو أكثرَ

16
00:02:11,180 --> 00:02:13,140
.وتُنقذ الكثيرين

17
00:02:13,750 --> 00:02:14,770
...لكن

18
00:02:16,250 --> 00:02:19,480
!لها ثمنٌ

19
00:02:24,370 --> 00:02:27,660
أنت معتوهٌ! ما هذا الهُراء
الّذي تتفوّه به؟

20
00:02:33,010 --> 00:02:34,560
...هذا

21
00:02:41,730 --> 00:02:42,710
!أُمّي

22
00:02:46,050 --> 00:02:48,210
!أُمّي

23
00:02:48,960 --> 00:02:49,760
ما الخطب؟

24
00:02:50,160 --> 00:02:52,890
أبي، رُبّما لن تصمدَ
.أُمّي لوقتٍ أطول

25
00:02:52,920 --> 00:02:53,630
!أُمّي

26
00:02:56,610 --> 00:02:58,530
...اهدؤوا، أنا أملكُ

27
00:02:59,260 --> 00:03:01,960
يُمكنك استخدامها لإنقاذ
،حياةٍ واحدة

28
00:03:02,240 --> 00:03:06,830
—أو زراعتها لتنمو أكثرَ

29
00:03:06,850 --> 00:03:08,920
.وتُنقذ الكثيرين

30
00:03:09,060 --> 00:03:10,920
أبي، هل بمقدوركَ المُساعدة بأيّ طريقةٍ؟ -
...لكن -

31
00:03:10,930 --> 00:03:12,120
!أخبرنا -
...لها -

32
00:03:12,130 --> 00:03:15,170
.أبي، لا تقف هكذا فحسب -
!ثمنٌ -

33
00:03:16,590 --> 00:03:17,790
...القرارُ

34
00:03:18,150 --> 00:03:21,150
.لكَ وحدك

35
00:03:22,880 --> 00:03:23,460
.أُمّي

36
00:03:23,910 --> 00:03:25,040
!إنّنا نفقدُها

37
00:03:25,410 --> 00:03:27,570
!أبي، افعل شيئًا ما

38
00:03:27,930 --> 00:03:28,600
!أبي

39
00:03:30,070 --> 00:03:32,020
!أُمّي

40
00:03:33,460 --> 00:03:37,290
!أُمّي -
!أُمّي -

41
00:03:48,800 --> 00:03:50,660
.لا يزالُ أبي يرفض الخُروج

42
00:03:51,470 --> 00:03:52,710
.مرّت أيّامٌ

43
00:03:53,170 --> 00:03:55,390
أنا قلقةٌ مِن أنّه
.لا يقدرُ على الصّمود

44
00:04:12,420 --> 00:04:14,430
.جدّي، خرجتَ

45
00:04:16,740 --> 00:04:18,290
.جِي، أنتِ فتاةٌ صالحة

46
00:04:20,200 --> 00:04:23,500
دعينِي أصطحبكِ إلى
الجبل، اتّفقنا؟

47
00:04:43,850 --> 00:04:50,860
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

48
00:04:51,070 --> 00:04:56,690
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

49
00:04:58,820 --> 00:05:04,900
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

50
00:05:05,280 --> 00:05:11,070
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

51
00:05:12,240 --> 00:05:18,420
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

52
00:05:19,240 --> 00:05:24,990
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

53
00:05:27,120 --> 00:05:33,400
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

54
00:05:33,930 --> 00:05:39,420
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

55
00:05:40,460 --> 00:05:47,330
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

56
00:05:47,790 --> 00:05:53,340
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

57
00:05:54,440 --> 00:06:00,670
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

58
00:06:00,690 --> 00:06:08,070
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

59
00:06:28,410 --> 00:06:29,470
أنتِ جِي؟

60
00:06:30,430 --> 00:06:32,000
لكن ألم تمت جِي
مُنذ زمنٍ طويل؟

61
00:06:32,580 --> 00:06:33,540
،أُمّي

62
00:06:33,560 --> 00:06:34,510
...كُلّ ما حدثَ

63
00:06:34,750 --> 00:06:36,250
.كان بتدبيرٍ مِن الرّب

64
00:06:37,020 --> 00:06:39,470
،كُنت أحلمُ بـ جِي كثيرًا مُؤخّرًا

65
00:06:39,780 --> 00:06:41,440
.وهذا جعلني أشعرُ بالاضطراب

66
00:06:41,780 --> 00:06:43,640
،لذلك اتّبعتُ نصيحةَ أخي

67
00:06:43,820 --> 00:06:46,550
بالصّعود إلى الجبل
.والصّلاة في ضريح شيَان

68
00:06:43,820 --> 00:06:47,350
ضريح شيَان

69
00:07:04,740 --> 00:07:07,940
،يُواليان
...ألا يبدو ذلك التّمثال

70
00:07:08,630 --> 00:07:10,250
شبيهًا بـ جِي؟

71
00:07:10,590 --> 00:07:13,540
سيّدتي، أنا لم أُقابل
،الآنسة جِي قطّ

72
00:07:13,870 --> 00:07:16,360
...بيدَ أنّني موقنةٌ أنّها كانت

73
00:07:16,860 --> 00:07:18,530
.بمثلِ هذا الجمال

74
00:07:32,200 --> 00:07:34,000
.أسقطتُ صُرّة المال داخل المعبد

75
00:07:34,420 --> 00:07:36,140
،سيّدتي
.أرجو أن ترتاحي هُنا

76
00:07:36,150 --> 00:07:37,300
.سأعودُ سريعًا

77
00:08:12,140 --> 00:08:13,150
...هذا

78
00:08:13,150 --> 00:08:13,990
جِي

79
00:08:13,860 --> 00:08:15,500
!سِوار جِي

80
00:08:16,380 --> 00:08:19,040
جِي، هل هذه أنتِ؟

81
00:08:19,480 --> 00:08:20,940
هل عُدتِ لرُؤيتي؟

82
00:08:21,710 --> 00:08:22,590
!جِي

83
00:08:23,000 --> 00:08:25,090
أين أنتِ يا جِي؟

84
00:08:25,710 --> 00:08:28,240
.أُمّي، ها أنا ذا

85
00:08:28,500 --> 00:08:29,180
جِي؟

86
00:08:29,440 --> 00:08:30,230
.أُمّي

87
00:08:32,420 --> 00:08:34,850
،جِي
هل هذه أنتِ حقًا؟

88
00:08:35,250 --> 00:08:37,660
أُمّي، ما الّذي أخّركِ
كُلّ هذا الوقت لتأتي؟

89
00:08:37,660 --> 00:08:40,300
.أنا آسفةٌ يا جِي، تأخّرتُ

90
00:08:41,210 --> 00:08:43,760
،أُمّي
.إنّ الماء شديدُ البُرودة

91
00:08:44,250 --> 00:08:46,920
،أودّ أن أعودَ إلى الدّار
.إنّني أفتقدُ أبي

92
00:08:46,940 --> 00:08:48,310
.إذن لنعُد إلى الدّار

93
00:08:55,170 --> 00:08:56,500
.نحن ذاهبتان إلى الدّار الآن

94
00:08:56,880 --> 00:08:57,890
،لكن أُمّي

95
00:08:58,090 --> 00:09:00,750
ماذا لو غضبَ جدّي عندما يراني؟

96
00:09:00,780 --> 00:09:03,950
،أيّتها الفتاة السّخيفة
كيف لجدّكِ أن يغضب؟

97
00:09:04,290 --> 00:09:05,450
...سيكونُ سعيدًا للغاية

98
00:09:05,790 --> 00:09:07,330
.بعودتكِ

99
00:09:08,310 --> 00:09:10,600
،سيَغضبُ جدّي

100
00:09:12,460 --> 00:09:14,610
أمرني أن أظلّ قابعةً
،داخل الماء

101
00:09:15,040 --> 00:09:17,790
فذلك وحدهُ ما سيَجعلُ
.لعائلة هَان مُستقبلًا

102
00:09:18,930 --> 00:09:21,140
ماذا... ماذا قُلتِ؟

103
00:09:21,700 --> 00:09:24,390
...حينها، كان جدّي

104
00:09:24,970 --> 00:09:26,130
...هُو مَن

105
00:09:26,890 --> 00:09:29,620
.ألقى بي في أعماقِ الماء

106
00:09:36,420 --> 00:09:39,380
أنت مَن قتلَ جِي؟

107
00:09:41,700 --> 00:09:44,300
لا يُمكن لزهرة اللّوتس البشريّة
،الأولى أن تكونَ مِن خارج العائلة

108
00:09:44,560 --> 00:09:47,760
فلا يصلحُ لهذا إلّا طفلٌ بعُمر
.الثّانية عشرة مِن نسل عائلة هَان

109
00:09:49,000 --> 00:09:50,160
!كانت فعلتكَ إذًا

110
00:09:50,960 --> 00:09:52,450
!كان حَريًا بي أن أُدرك ذلك

111
00:09:52,460 --> 00:09:53,920
أَتحسب أنّني لم أتوجّع؟

112
00:09:54,230 --> 00:09:56,260
،إنّها حفيدتي
!مِن لحمي ودمي

113
00:09:58,590 --> 00:09:59,590
...لكن

114
00:10:00,710 --> 00:10:04,910
التّضحية بها كانت كفيلةً بأن تجلبَ
.لعائلة هَان مجدًا يدومُ لمائة جيلٍ

115
00:10:05,000 --> 00:10:06,070
،لو كُنت مكاني

116
00:10:06,670 --> 00:10:09,210
.لاتّخذتَ القرار نفسهُ دُون تردّدٍ

117
00:10:10,520 --> 00:10:13,260
.أنت... أنت مجنونٌ

118
00:10:19,180 --> 00:10:22,800
شيّدتُ معبد شيَان في
...البُقعة الّتي ماتت فيها جِي

119
00:10:23,250 --> 00:10:25,410
.لتهدئة رُوحها الهائمة

120
00:10:26,240 --> 00:10:28,840
لم أكُن أتوقّع قطعًا
.أنّها ستعودُ رُغم ذلك

121
00:10:29,680 --> 00:10:30,880
...بَاو رُونغ

122
00:10:31,880 --> 00:10:33,890
...لا بُدّ أنّ بَاو رُونغ مَن أحضرتها

123
00:10:33,900 --> 00:10:35,960
.للانتقام مِن عائلة هَان

124
00:10:38,490 --> 00:10:39,980
—هذا هُو هَان شيَان

125
00:10:40,410 --> 00:10:43,210
شيطانٌ يعيشُ على التغذّي
.بدماء البشر

126
00:10:43,800 --> 00:10:46,000
لكن بما أنّ جِي قد تحوّلت
،إلى لوتسٍ حمراء

127
00:10:46,200 --> 00:10:47,790
كيف انتهى بها المطاف هكذا؟

128
00:10:50,450 --> 00:10:52,960
لأجلِ ذلك، ينبغي
.لي أن أشكرَ أخي

129
00:11:01,740 --> 00:11:02,790
،جِي

130
00:11:03,120 --> 00:11:04,590
.هذه هِي داركِ الجديدة الآن

131
00:11:09,610 --> 00:11:10,860
ما الخطب يا جِي؟

132
00:11:11,460 --> 00:11:13,920
!طفلةٌ مسكينة أُخرى

133
00:11:15,590 --> 00:11:16,320
،هُنالك في ذلك المكان

134
00:11:16,830 --> 00:11:20,360
يحتجزونَ الضّحية التّالية الّتي
.ستتحوّل إلى لوتسٍ بشريّ

135
00:11:25,050 --> 00:11:27,590
هل أمسكَ بها أخي؟

136
00:11:29,220 --> 00:11:31,770
.أُمّي، لنُنقذها

137
00:11:57,960 --> 00:11:58,880
!أُمّي

138
00:12:00,140 --> 00:12:02,250
.هذه أنا، أنا جِي

139
00:12:03,240 --> 00:12:05,110
لماذا تبدو هيئتكِ هكذا؟

140
00:12:05,770 --> 00:12:07,930
.استعرتُ جسدَ هذه الفتاة

141
00:12:08,350 --> 00:12:11,310
هذه هِي الطّريقة الوحيدة الّتي
.تُمكّنني مِن عناقكِ مُجدّدًا، يا أُمّي

142
00:12:12,070 --> 00:12:13,160
!جِي

143
00:12:14,830 --> 00:12:18,120
...حانَ الوقت لأقومَ بزيارة

144
00:12:19,110 --> 00:12:21,480
.جدّي العزيز

145
00:12:25,870 --> 00:12:26,870
.جدّي

146
00:12:27,250 --> 00:12:28,050
مَن هُناك؟

147
00:12:29,060 --> 00:12:31,170
.جدّي، هذه أنا

148
00:12:31,400 --> 00:12:32,820
.أنا جِي

149
00:12:33,370 --> 00:12:34,540
جِي؟

150
00:12:35,640 --> 00:12:37,390
مَن يجرؤُ على خداعي؟

151
00:12:37,410 --> 00:12:38,380
!أظهِر نفسك

152
00:12:43,000 --> 00:12:43,670
!أيّها الحُرّاس

153
00:12:44,630 --> 00:12:46,540
.أيّها الحُرّاس! أسرعوا

154
00:12:54,960 --> 00:12:56,900
جدّي، كانت هذه الأعوامُ
...الأربعة والعشرون الماضية

155
00:12:56,920 --> 00:12:58,450
.زاهيةً بالمجد لك

156
00:12:59,470 --> 00:13:02,930
أما زِلتَ تذكرُ تضحيتي
لأجلِ عائلة هَان؟

157
00:13:04,270 --> 00:13:05,060
—أنتِ

158
00:13:05,380 --> 00:13:08,740
هل صرخاتُ الأرواح الأربع
...والعشرين مِن معبد جُوهان

159
00:13:09,100 --> 00:13:10,490
...تُساعدك

160
00:13:10,950 --> 00:13:12,580
على النّوم هنيئًا؟

161
00:13:13,010 --> 00:13:14,880
!إنّكِ الرّوح الثّائرة لـ جِي

162
00:13:15,770 --> 00:13:17,990
،ألقيتُ لعنةً على هذه الدّار

163
00:13:18,600 --> 00:13:21,000
ولن تُفكّ تلك اللّعنة
...إلّا حينما تُزهر فيها

164
00:13:21,560 --> 00:13:23,270
.أربعٌ وعشرون لوتسًا حمراء

165
00:13:24,460 --> 00:13:27,590
بذورُ اللّوتس الحمراء الّتي
،تجرّعتموها جميعًا

166
00:13:27,610 --> 00:13:29,470
آن لها أن تنبتَ داخلَ
.أحشائكم في هذه اللّحظة

167
00:13:49,100 --> 00:13:50,230
،آنذاك

168
00:13:50,500 --> 00:13:53,580
لم تُخبرنا إلّا أنّ هُناك رُوحًا
.خبيثة تُطارد عائلة هَان

169
00:13:53,590 --> 00:13:56,510
وقد ظننتُ أنّها الأرواح المُعذّبة
،لضحايا معبد جُوهان

170
00:13:56,520 --> 00:13:57,520
...ولم يُخيّل لي أبدًا

171
00:13:58,040 --> 00:14:00,160
.أن تكونَ الرّوح الثّائرة لـ جِي

172
00:14:00,620 --> 00:14:01,790
،في البداية

173
00:14:01,810 --> 00:14:04,350
حسبتُ أنّ جِي قد استحالت
.إلى رُوحٍ شرّيرة لتأخذَ ثأرها

174
00:14:04,670 --> 00:14:05,620
أمّا الآن، وبعد
،التمعّن في الأمر

175
00:14:06,410 --> 00:14:09,910
فلا بُدّ أنّ لـ بَاو رُونغ صلةً
.وثيقةً بهذه الرّوح الخبيثة

176
00:14:11,500 --> 00:14:12,760
!جُوان جُوان في خطرٍ

177
00:14:12,790 --> 00:14:14,340
...إنّ جِي

178
00:14:14,710 --> 00:14:17,750
تُريد إزهاقَ أربعٍ وعشرين
!رُوحًا بشريّة نابضة بالحياة

179
00:14:18,420 --> 00:14:19,950
وأنتِ تقفين هكذا دُون
!أن تهتزّ لكِ شعرةٌ؟

180
00:14:20,250 --> 00:14:22,550
.جِي ليست الآن سوى رُوحٍ تائهة

181
00:14:23,500 --> 00:14:25,330
،ولكي تعودَ إلى جانبي حقًا

182
00:14:26,210 --> 00:14:28,800
فلا بُدّ لها مِن قبض
.تلك الأرواح

183
00:14:29,750 --> 00:14:30,800
...لنعتبر ذلك

184
00:14:31,800 --> 00:14:33,540
دينًا على عائلة هَان
.وجبَ سداده

185
00:14:33,550 --> 00:14:34,790
...هل هِي مَن أخبرتكِ

186
00:14:35,340 --> 00:14:36,670
!بكُلّ هذا؟

187
00:14:39,710 --> 00:14:42,770
إذن، وقفتِ مكتوفةَ الأيدي
...تُشاهدين والدكِ وأخاكِ

188
00:14:43,300 --> 00:14:45,670
وهُما يُضحّيان بكُلّ
!مَن في هذه الدّار؟

189
00:14:46,500 --> 00:14:47,530
!شيَانغ

190
00:14:48,760 --> 00:14:50,650
كان مَن المُفترض أن
—يُراقبني شيَانغ

191
00:14:50,660 --> 00:14:52,910
...ليتأكّد أنّني لا أنام -
!شيَانغ -

192
00:14:52,920 --> 00:14:55,020
لكنّه هُو مَن غرقَ في
.النّوم دُون أن يدري

193
00:14:55,110 --> 00:14:56,320
لماذا شيَانغ؟

194
00:14:56,630 --> 00:14:58,570
ما ذنبهُ وهُو الّذي
!لم يقترف إثمًا قطّ

195
00:15:01,130 --> 00:15:02,740
هذه الرّوح الشرّيرة
،هائجةٌ وشرسة

196
00:15:02,750 --> 00:15:04,390
أنّى لها أن تحتكِم
إلى منطقٍ أو عقلٍ؟

197
00:15:04,920 --> 00:15:06,580
حتّى لو منعنا أنفسنا
،جميعًا عن النّوم

198
00:15:06,690 --> 00:15:08,490
فكم يومًا يُمكننا الصّمود؟

199
00:15:08,500 --> 00:15:09,960
...وحتّى لو قتلتنا جميعًا

200
00:15:10,090 --> 00:15:12,160
.فلن نبلغَ أربعًا وعشرين رُوحًا

201
00:15:12,170 --> 00:15:14,500
أَليس هُناك الكثير مِن الخدم؟

202
00:15:14,920 --> 00:15:15,790
...لكنّهم

203
00:15:15,820 --> 00:15:17,650
لكنّهم لم يسبق لهُم أن تجرّعوا
!بُذور اللّوتس الحمراء

204
00:15:17,880 --> 00:15:20,630
،إذن
!نُطعمهم إيّاها فحسب

205
00:15:21,250 --> 00:15:23,740
لم يتبقَّ سوى بذرةٍ واحدة
،مِن حصاد العام الماضي

206
00:15:23,750 --> 00:15:25,250
.وهِي لا تكفي

207
00:15:25,590 --> 00:15:26,880
!أيّها الأبله

208
00:15:27,000 --> 00:15:28,460
...بُذور اللّوتس الحمراء

209
00:15:29,050 --> 00:15:30,590
.أمامكَ مُباشرةً

210
00:15:31,840 --> 00:15:33,140
...لم يخطر ببالِ أحدٍ

211
00:15:33,750 --> 00:15:35,880
أن يُصبح شيَانغ
.الضحيّة الأولى

212
00:15:37,090 --> 00:15:40,250
ومُنذ ذلك الحين، انبعثَ
.ضبابٌ غريب خارج الدّار

213
00:15:40,740 --> 00:15:42,330
كان الخدم يخرجونَ
،لاستكشاف الطّريق

214
00:15:42,340 --> 00:15:43,900
لكن أيّا منهم لم يستطع
.مُغادرة المكان

215
00:15:44,800 --> 00:15:47,550
ولنتمكّن مِن بُلوغ عدد الأرواح
.المطلوبة، تحالفَ أبي وأخي معًا

216
00:15:47,800 --> 00:15:49,600
وقاموا بصفّ الخدم
.حسب أعمارهم

217
00:15:50,050 --> 00:15:51,710
ثُمّ أجبروهم على
،ابتلاع بُذور اللّوتس

218
00:15:52,630 --> 00:15:55,230
وكانوا يأخذونَ بُذور اللّوتس الحمراء
...النّابتة مِن جسد الشّخص السّابق

219
00:15:55,250 --> 00:15:56,870
.ليُطعموها للّذي يليه

220
00:15:56,880 --> 00:15:58,080
،وفي لمحِ البصر

221
00:15:58,210 --> 00:16:00,840
لم يتبقَّ في دار شِينغ هَان
.سوى القليل منّا

222
00:16:02,960 --> 00:16:04,540
إنّ إطلاقكِ لسراح
...وَان زِي ويُوليان

223
00:16:05,050 --> 00:16:07,410
لتُواجهي مصيرَ الموت
،مع أبيكِ وأخيكِ

224
00:16:07,420 --> 00:16:09,930
،لهُو دليلٌ على أنّ قلبكِ يفيضُ بالنّدم
.وأنّ حسّكِ الإنسانيّ لا يزالُ حيًا

225
00:16:09,940 --> 00:16:12,210
كما أنّكِ لم ترتكبي
.جُرمًا بحقّ أحدٍ

226
00:16:12,840 --> 00:16:14,900
لم يفُت الأوان بعد
.لتُغادري معي

227
00:16:14,980 --> 00:16:17,180
توقّفي عن كونكِ شريكةً
.للرّوح الشرّيرة

228
00:16:21,420 --> 00:16:23,100
لا يُمكنني أن أُخيّب
،أمل تشَاو تشِي

229
00:16:23,500 --> 00:16:25,480
.الّذي خاطرَ بحياته مِن أجلي

230
00:16:29,880 --> 00:16:30,790
،أعتذرُ منكِ

231
00:16:31,130 --> 00:16:32,000
.يا آنسة شُو

232
00:16:32,870 --> 00:16:34,000
—فقد حسمتُ مصيري

233
00:16:35,050 --> 00:16:36,630
.لا بُدّ أن أبقى على قيدِ الحياة

234
00:16:37,470 --> 00:16:40,090
،الهديّة الّتي أرسلتُها لأخي

235
00:16:40,500 --> 00:16:42,300
.لا شكّ أنّه قد استلمها الآن

236
00:16:44,170 --> 00:16:44,780
.جُوان جُوان

237
00:16:51,840 --> 00:16:52,630
.جُوان جُوان

238
00:16:57,150 --> 00:16:58,650
هل فهمتَ الآن؟

239
00:16:59,490 --> 00:17:01,940
بَاو رُونغ شريكةٌ لهذه
.الرّوح بالتّأكيد

240
00:17:02,220 --> 00:17:04,480
وعلينا أن نتعاونَ معًا
.للقضاء عليها

241
00:17:07,250 --> 00:17:09,340
،أنت ابني الوحيد

242
00:17:09,800 --> 00:17:11,760
!وأنا لن أخدعكَ إطلاقًا

243
00:17:13,910 --> 00:17:15,910
!أفلِت يدكَ -
لماذا لا تفهمُ؟ -

244
00:17:15,940 --> 00:17:17,090
!ضع الخنجر جانبًا

245
00:17:22,070 --> 00:17:24,000
...هذا

246
00:17:41,500 --> 00:17:42,920
!شيَانغ

247
00:17:43,090 --> 00:17:44,420
لماذا نمتَ؟

248
00:17:44,430 --> 00:17:44,980
—شيَانغ

249
00:17:46,100 --> 00:17:46,850
،جدّي

250
00:17:46,870 --> 00:17:48,730
،خشيتُ أن يغلبكَ النّعاس سهوًا

251
00:17:48,760 --> 00:17:50,890
لذا سأتولّى حراستكَ
.بنفسي هذه اللّيلة

252
00:17:52,050 --> 00:17:54,250
،ألقيتُ لعنةً على هذه الدّار

253
00:17:54,920 --> 00:17:57,550
ولن تُفكّ تلك اللّعنة
...إلّا حينما تُزهر فيها

254
00:17:57,880 --> 00:17:59,670
.أربعٌ وعشرون لوتسًا حمراء

255
00:18:01,380 --> 00:18:04,050
لم يتبقَّ مِن بُذور اللّوتس
.الحمراء سوى بذرةٍ واحدة

256
00:18:05,420 --> 00:18:07,810
...بذرةٌ واحدة فحسب

257
00:18:24,660 --> 00:18:25,540
.جدّي

258
00:18:26,380 --> 00:18:27,170
...أنا

259
00:18:27,670 --> 00:18:28,840
.أنا أشعرُ بالعطش قليلًا

260
00:18:29,710 --> 00:18:31,110
.يا لكَ مِن صبيّ صالحٍ يا شيَانغ

261
00:18:31,960 --> 00:18:33,380
.لا تلُم جدّكَ

262
00:18:33,880 --> 00:18:34,920
...كُلّ هذا كان

263
00:18:35,440 --> 00:18:37,570
.لصالح عائلة هَان

264
00:18:47,970 --> 00:18:49,180
!إنّه أنت

265
00:18:50,250 --> 00:18:51,820
!كان صنيعكَ أنت بالفِعل

266
00:18:56,840 --> 00:18:58,240
،هذه هِي حقيقتكَ

267
00:18:59,000 --> 00:19:01,270
!وهذا هُو حالكَ مُنذ البداية

268
00:19:09,410 --> 00:19:12,990
،مُت
!لتذهب إلى الجحيم

269
00:19:21,710 --> 00:19:23,650
كان ذلك العجوز الخرف
...يعتقدُ أنّ جرائمه

270
00:19:23,660 --> 00:19:25,400
.ستَمرّ دُون أن يدري بها أحدٌ

271
00:19:25,420 --> 00:19:27,740
وما علِم أنّ أرواح
...المظلومين الرّاحلين

272
00:19:27,960 --> 00:19:30,090
.كانت تُراقبه طوال الوقت

273
00:19:32,460 --> 00:19:35,130
،حسنًا
.بلغت القصّة نهايتها

274
00:19:36,000 --> 00:19:37,850
...وانتهى معها هذا

275
00:19:38,300 --> 00:19:39,760
!الكابوس الطّويل

276
00:19:40,850 --> 00:19:41,770
،إذن

277
00:19:42,210 --> 00:19:44,610
هل تُخطّطين لجعلي
الضحيّة الأخيرة؟

278
00:19:46,030 --> 00:19:49,090
أيّ فرقٍ بينكِ وبين
أبيكِ وأخيكِ؟

279
00:19:49,380 --> 00:19:50,780
.بالطّبع أنا مختلفةٌ

280
00:19:50,800 --> 00:19:52,720
.ما فعلتُ هذا إلّا لـ جِي

281
00:19:57,320 --> 00:19:58,860
!مثيرٌ للعجب

282
00:19:59,510 --> 00:20:00,550
...إنّ الطّبيعة البشريّة

283
00:20:01,000 --> 00:20:03,400
.ما انفكّت تُدهشني

284
00:20:04,380 --> 00:20:05,780
!هكذا إذن

285
00:20:06,140 --> 00:20:08,000
.تُريدين استخدامي كلوتسٍ بشريّ

286
00:20:08,250 --> 00:20:10,850
لكن بما في جُعبتكِ مِن بُذور
،اللّوتس الحمراء المعدُودة

287
00:20:10,960 --> 00:20:12,760
.أخشى أنّ هذا لن يكون كافيًا

288
00:20:14,130 --> 00:20:15,580
—سمعتُ مُعلّمي يقول يومًا

289
00:20:16,030 --> 00:20:17,780
إنّ هُناك نوعًا مِن الشّياطين
.الماكرة والعنيدة

290
00:20:18,670 --> 00:20:20,660
تتولّدُ وتنشأ مِن
،رحم أحقاد البشر

291
00:20:20,670 --> 00:20:22,300
.وأنفسهم الخبيثة

292
00:20:22,860 --> 00:20:25,360
،بارعةٌ في الاستحواذِ على الأجساد

293
00:20:25,370 --> 00:20:26,830
.ومتفوّقةٌ في التنكّر والتّمويه

294
00:20:27,630 --> 00:20:28,460
...أنتِ

295
00:20:29,420 --> 00:20:30,940
.شيطانُ السّراب

296
00:20:31,560 --> 00:20:32,770
!ما هذا الهُراء الّذي تتفوّهين به؟

297
00:20:33,800 --> 00:20:35,730
إيّاكِ أن تجرؤي على
!المساس بـ جِي

298
00:20:36,000 --> 00:20:37,130
،لا تخافي يا جِي

299
00:20:37,210 --> 00:20:38,200
،أُمّكِ معكِ

300
00:20:38,210 --> 00:20:39,330
.ولن أدعَ أحدًا يُؤذيكِ

301
00:20:39,340 --> 00:20:40,380
!اخرسي

302
00:20:40,820 --> 00:20:42,360
ضقتُ بكِ ذرعًا
.أيّتها المرأة العاجزة

303
00:20:43,300 --> 00:20:44,000
!اغربي عن وجهي

304
00:20:50,670 --> 00:20:51,870
كيف يكونُ هذا مُمكنًا؟

305
00:20:52,170 --> 00:20:53,700
...أنا لم

306
00:20:54,130 --> 00:20:55,050
...لم

307
00:20:55,590 --> 00:20:58,500
...جِي

308
00:21:05,800 --> 00:21:07,340
!لنكتفِ بهذا القدر مِن هذه المهزلة

309
00:21:08,440 --> 00:21:09,500
.فقد مللتُها أنا أيضًا

310
00:21:10,250 --> 00:21:11,280
،والآن

311
00:21:12,000 --> 00:21:13,710
،حان الوقت لنتحدّث معًا بجديّةٍ

312
00:21:14,790 --> 00:21:16,620
.يا رُوح الثّعلب

313
00:21:20,950 --> 00:21:27,780
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

314
00:21:27,800 --> 00:21:36,300
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

315
00:21:38,380 --> 00:21:43,080
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

316
00:21:43,090 --> 00:21:47,700
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

317
00:21:47,710 --> 00:21:51,580
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

318
00:21:51,590 --> 00:21:56,040
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

319
00:21:56,050 --> 00:22:00,740
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

320
00:22:00,750 --> 00:22:05,450
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

321
00:22:05,460 --> 00:22:10,620
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

322
00:22:10,630 --> 00:22:14,660
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

323
00:22:14,670 --> 00:22:19,790
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

324
00:22:19,800 --> 00:22:24,240
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

325
00:22:24,250 --> 00:22:29,240
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

326
00:22:29,250 --> 00:22:33,700
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

327
00:22:38,800 --> 00:22:44,920
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟