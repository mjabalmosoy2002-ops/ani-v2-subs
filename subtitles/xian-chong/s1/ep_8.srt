1
00:00:15,250 --> 00:00:22,240
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

2
00:00:22,250 --> 00:00:29,990
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

3
00:00:30,000 --> 00:00:36,400
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

4
00:00:36,410 --> 00:00:41,790
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

5
00:00:43,410 --> 00:00:50,530
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

6
00:00:50,540 --> 00:00:58,240
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

7
00:00:58,250 --> 00:01:05,030
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

8
00:01:05,040 --> 00:01:10,410
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

9
00:01:11,500 --> 00:01:18,780
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

10
00:01:18,780 --> 00:01:25,530
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

11
00:01:25,530 --> 00:01:31,780
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

12
00:01:31,810 --> 00:01:38,680
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

13
00:01:52,800 --> 00:01:53,880
.اسمي نِينغ آن

14
00:01:54,320 --> 00:01:56,490
.إنّه يرمزُ إلى السّلام طوال العُمر

15
00:01:57,080 --> 00:02:00,710
لكنّني لم أحظَ بالسّلام
.يومًا في حياتي

16
00:02:01,790 --> 00:02:04,460
،عندما كُنت صغيرًا
،كُنت أتّخذُ أبي قُدوةً لي

17
00:02:05,080 --> 00:02:07,610
.وأرغبُ في أن أكونَ بطلًا مثله

18
00:02:08,500 --> 00:02:09,330
،ومع ذلك

19
00:02:10,280 --> 00:02:12,550
،حينما استحالت عودةُ أبي

20
00:02:12,730 --> 00:02:13,590
...أدركتُ أنّ

21
00:02:14,460 --> 00:02:17,260
.أُمّي لن تتحمّل ألم خسارة ابنها

22
00:02:19,450 --> 00:02:20,420
...لذا وعدتُها

23
00:02:21,070 --> 00:02:24,660
أنّني سأتخلّى عن دوري كزعيمٍ
،لعائلة نِينغ لأُكرّس نفسي لدراستِي

24
00:02:24,670 --> 00:02:26,400
آملًا أن أُصبحَ مسؤولًا
...حُكوميًا ذات يومٍ

25
00:02:26,410 --> 00:02:28,270
.وأُغيّر مصيرَ عائلتنا

26
00:02:29,250 --> 00:02:30,650
كان هذا هُو الطّريق
.الّذي اخترتُه

27
00:02:31,290 --> 00:02:32,710
.ولست نادمًا

28
00:02:33,550 --> 00:02:36,340
،مُنذ ذلك الحين
.كُنت أدرسُ باجتهادٍ كُلّ يومٍ

29
00:02:37,320 --> 00:02:40,390
لم يكُن عالمي أكبرَ مِن هذه
.المساحة الصّغيرة الّتي أعيشُ فيها

30
00:02:40,890 --> 00:02:44,650
وتدريجيًا اعتدتُ على حماية
،أُمّي المُفرطة وتوقّعاتها العالية

31
00:02:44,660 --> 00:02:46,920
.وتعلّمتُ كبتَ مشاعري

32
00:02:47,570 --> 00:02:49,970
حسبتُ أنّ تلك هِي
.طبيعةُ الحياة لا غير

33
00:02:51,630 --> 00:02:52,510
...إلى أن

34
00:02:57,130 --> 00:02:58,960
أتى مهرجانُ قِيقياو في
.العام الماضي

35
00:03:03,250 --> 00:03:06,050
مَن قد يمكثُ في الدّار
والقمر ساطعٌ إلى هذا الحدّ؟

36
00:03:06,340 --> 00:03:09,470
مَن ذا الّذي لن يخرجَ عند
سماع صوتِ مهرجان الفوانِيس؟

37
00:03:43,730 --> 00:03:45,130
عمّ تبحث؟

38
00:03:45,170 --> 00:03:46,600
...أبحثُ عن

39
00:03:49,410 --> 00:03:51,410
.لا تُخبرني أنّك تبحثُ عنّي

40
00:03:51,460 --> 00:03:53,420
.دويُّ الألعاب الناريّة مزعجٌ

41
00:03:53,440 --> 00:03:55,360
إنّه يُشتّت ذهنَ آن
.ويمنعهُ مِن التّركيز

42
00:03:55,370 --> 00:03:56,100
!صمتًا

43
00:03:56,440 --> 00:03:58,000
آن، ما هذا الصّوت؟

44
00:03:58,570 --> 00:03:59,400
،لا شيء

45
00:03:59,460 --> 00:04:02,700
حاولتُ إغلاق النّافذة لكنّني
.أوقعتُ الكُرسيّ دُون قصدٍ

46
00:04:02,710 --> 00:04:03,830
.كُن حذرًا

47
00:04:03,850 --> 00:04:04,980
.حسنًا

48
00:04:07,320 --> 00:04:08,560
هل يُمكنني الخُروج الآن؟

49
00:04:11,580 --> 00:04:13,130
مَن أنتِ؟

50
00:04:13,850 --> 00:04:15,260
،رسمتني

51
00:04:15,280 --> 00:04:16,940
ومع ذلك لا تملكُ أدنى
فكرةٍ عمّن أكون؟

52
00:04:17,920 --> 00:04:20,540
لماذا لا تمنحُني اسمًا؟

53
00:04:22,060 --> 00:04:22,620
يَا؟

54
00:04:24,130 --> 00:04:24,810
هُونغ؟

55
00:04:28,420 --> 00:04:30,000
،أتيتِ مِن اللّوحة

56
00:04:30,830 --> 00:04:32,820
ما رأيكِ باسم هُوي؟

57
00:04:34,520 --> 00:04:36,940
،يبدو جيّدًا، أقبلُ به
.ولكن على مضضٍ

58
00:04:36,950 --> 00:04:38,560
،حسنًا يا هُوي

59
00:04:38,880 --> 00:04:40,060
ما خطبكِ؟

60
00:04:40,870 --> 00:04:42,600
.الفانوس الّذي رسمتهُ قبيحٌ جدًا

61
00:04:42,870 --> 00:04:43,820
.أُريد فانوسًا للمهرجان

62
00:04:43,830 --> 00:04:45,150
.ارسم لي واحدًا جديدًا

63
00:04:45,650 --> 00:04:48,030
لكنّني لم أرَ فانوسَ
.مهرجانٍ مِن قبل

64
00:04:48,040 --> 00:04:49,920
.لا أعرفُ كيف يبدو شكله

65
00:04:51,920 --> 00:04:53,680
.اليوم هُو مهرجان قِيقياو

66
00:04:53,960 --> 00:04:56,150
بما أنّك لم ترَ فانوس
،مهرجانٍ مِن قبل

67
00:04:56,150 --> 00:04:57,690
لماذا لا تذهب لتُلقي نظرةً؟

68
00:05:03,920 --> 00:05:05,230
...ستَقلقُ أُمّي

69
00:05:05,250 --> 00:05:06,570
إن خرجتُ في مثل
.هذا الوقت المُتأخّر

70
00:05:09,000 --> 00:05:09,980
،لا بأس

71
00:05:12,230 --> 00:05:13,480
.أنا سأَحميك

72
00:05:30,400 --> 00:05:31,140
!هُوي

73
00:05:31,790 --> 00:05:32,670
،اطمئنّ

74
00:05:33,010 --> 00:05:34,540
،حتّى لو أفلتّ يدي

75
00:05:34,630 --> 00:05:36,490
.سأعرفُ كيف أعودُ إليكَ

76
00:05:37,610 --> 00:05:38,960
ماذا تنتظِر؟

77
00:05:38,970 --> 00:05:41,140
.رأيتُ شيئًا مُبهجًا، هيّا

78
00:05:50,200 --> 00:05:51,470
ألفُ ميلٍ إلى جِيانغ لِينغ، أقطعُها في يومٍ واحد

79
00:05:51,640 --> 00:05:52,570
!صحيحٌ

80
00:05:52,600 --> 00:05:55,860
كيف يبدو شكلُ فانوس المهرجان
الّذي تُريديننِي أن أرسمهُ؟

81
00:06:02,480 --> 00:06:03,520
.كهذا

82
00:06:05,850 --> 00:06:06,870
...خِلتُ أنّني

83
00:06:07,010 --> 00:06:10,250
نسيتُ مُنذ أمدٍ بعيد لهيبَ
.الشّغف الّذي يشتعلُ في أعماقي

84
00:06:10,260 --> 00:06:11,520
،لكن في تلك اللّيلة

85
00:06:12,100 --> 00:06:15,450
كانت ابتسامةُ هُوي
،مثل أسطعِ فانوسٍ

86
00:06:16,350 --> 00:06:19,170
.يُنير الزّوايا المُظلمة في قلبي

87
00:06:45,200 --> 00:06:48,360
خُيّل إليّ أنّني قادرٌ على أن
.أُلازمها هكذا مدى الدّهر

88
00:06:49,120 --> 00:06:49,860
...ولكن

89
00:06:58,040 --> 00:07:00,080
نِينغ آن، ما خطبك؟

90
00:07:00,870 --> 00:07:03,260
،لا عليكِ
.أنا واهنُ الصّحة

91
00:07:03,400 --> 00:07:06,010
رُبّما أنا مجهدٌ مِن
.الدّراسة فحسب

92
00:07:06,650 --> 00:07:09,250
،لا داعي للقلق
.سأَستعيدُ عافيتي عمّا قريبٍ

93
00:07:11,670 --> 00:07:13,760
،آن
.نَل قسطًا مِن الرّاحة

94
00:07:13,920 --> 00:07:15,680
فقدتَ الكثير مِن وزنكَ
.هذه الأيّام

95
00:07:15,690 --> 00:07:17,030
ومع اقترابِ الامتحان
،الإمبراطوريّ في العام المُقبل

96
00:07:17,040 --> 00:07:18,580
.ليس هُناك مجالٌ للخطأ

97
00:07:18,590 --> 00:07:19,850
.أفهمُ ذلك يا أُمّي

98
00:07:30,330 --> 00:07:31,070
.هُوي

99
00:07:32,740 --> 00:07:34,050
.عُدتِ أخيرًا

100
00:07:35,080 --> 00:07:36,030
.أنا بخيرٍ

101
00:07:36,450 --> 00:07:37,570
.لطالما كُنت لعوبةً

102
00:07:37,580 --> 00:07:40,510
أنا مهملةٌ قليلًا لأنّني
.كُنت بمُفردي مُؤخّرًا

103
00:07:41,090 --> 00:07:43,080
.جروحٌ بسيطة وستَبرأُ سريعًا

104
00:07:44,740 --> 00:07:45,430
هل هِي لذيذةٌ؟

105
00:07:46,250 --> 00:07:47,120
ما هذه؟

106
00:07:47,500 --> 00:07:50,360
،جلبتُ لك حلوى جديدةً
!وهِي الأكثر شُهرةً في السّوق

107
00:07:50,470 --> 00:07:52,010
.مذاقُها غريبٌ

108
00:07:53,620 --> 00:07:55,030
.أحضرتُها خصيصًا مِن أجلك

109
00:07:55,040 --> 00:07:56,160
كيف تجرؤُ على القول
بأنّ مذاقُها غريبٌ؟

110
00:07:56,170 --> 00:07:58,800
بالطّبع أنا أعلمُ أنّ
.هُوي تُخفي شيئًا

111
00:07:59,990 --> 00:08:02,060
لكن ليس لي الحقّ
.في سُؤالها

112
00:08:25,170 --> 00:08:26,020
.نِينغ آن

113
00:08:29,370 --> 00:08:31,270
.نِينغ آن، استيقِظ

114
00:08:38,740 --> 00:08:39,520
!نِينغ آن

115
00:08:39,690 --> 00:08:40,520
.هُوي

116
00:08:42,840 --> 00:08:45,820
استيقظتَ أخيرًا، جُهدي في
.إحضارِ عُشب الإله لم يضع سُدىً

117
00:08:45,830 --> 00:08:46,320
عُشب الإله؟

118
00:08:46,330 --> 00:08:47,630
.لا عليك

119
00:08:49,990 --> 00:08:51,590
لماذا أنتِ مصابةٌ بجُروحٍ
عديدة هكذا؟

120
00:08:53,290 --> 00:08:55,390
هل تُؤلمكِ؟ -
.أنا بخيرٍ -

121
00:08:56,280 --> 00:08:58,570
،لا تذهبِي للبحث عن الأعشاب
.الأمرُ خطيرٌ للغاية

122
00:08:58,580 --> 00:08:59,640
،إذا أصابكِ مكروهٌ

123
00:08:59,650 --> 00:09:01,650
فما الفائدةُ مِن بقائي
على قيدِ الحياة؟

124
00:09:01,660 --> 00:09:03,560
.لا تقلق، أنا قويّةٌ

125
00:09:04,370 --> 00:09:06,470
.سأجدُ طريقةً لإنقاذك

126
00:09:14,430 --> 00:09:16,140
،يومًا بعد يومٍ
،أزدادُ ضعفًا

127
00:09:16,170 --> 00:09:18,570
وتقلّ الفترة الّتي
.أظلّ فيها واعيًا

128
00:09:18,880 --> 00:09:21,210
بذلت هُوي قُصارى جُهدها
.للعُثور على الإكسير

129
00:09:21,330 --> 00:09:23,730
وتزدادُ الرّحلة خُطورةً
.مُرورًا بالأيّام

130
00:09:23,900 --> 00:09:25,410
.لم أستطِع منعها

131
00:09:26,240 --> 00:09:27,890
...لم يكُن بمقدوري سِوى مُشاهدتها

132
00:09:28,380 --> 00:09:30,550
.وهِي تُصبح هكذا

133
00:09:38,820 --> 00:09:41,220
لم يكُن عُثوركَ على هُوي
مُصادفةً، أَليس كذلك؟

134
00:09:41,810 --> 00:09:43,830
كيف اكتشفتَ سرّها؟

135
00:09:44,830 --> 00:09:46,370
لاحظتُ اللّوحة المُعلّقة
...على الجدار

136
00:09:46,380 --> 00:09:47,930
.عندما كُنت أُعالجك

137
00:09:48,190 --> 00:09:50,240
كان هُناك فانوسٌ مُعلّق
،على القارب في اللّوحة

138
00:09:50,250 --> 00:09:51,540
.لكنّني لم أرَ أحدًا

139
00:09:51,550 --> 00:09:52,850
.لذا استشعرتُ نقصًا

140
00:09:53,600 --> 00:09:56,860
بالإضافة إلى أنّني شممتُ
.رائحةَ فِطر يُوهاي جانُودِيرما عليك

141
00:09:57,430 --> 00:09:58,430
فِطر يُوهاي جانُودِيرما؟

142
00:09:58,940 --> 00:09:59,870
.سمعتُ به

143
00:10:00,250 --> 00:10:02,490
إنّه عُشب الإله الّذي تحرسهُ
.الوحوش العتيقة

144
00:10:02,500 --> 00:10:04,590
محالٌ على البشر العاديّين
.الحُصول عليه

145
00:10:04,600 --> 00:10:05,660
.سألتُ السيّدة نِينغ

146
00:10:06,030 --> 00:10:08,320
وهِي لم تطلب هذا
.الدّواء لك أبدًا

147
00:10:08,330 --> 00:10:09,260
...لذا علمتُ أنّ

148
00:10:09,650 --> 00:10:11,650
.هُناك مَن يُعالجك سرًا

149
00:10:12,190 --> 00:10:14,920
لكنّني لم أتوقّع أن تكون
.شيطانة لوحةٍ كهذه

150
00:10:16,160 --> 00:10:17,910
.لا بُدّ أنّكِ عانيتِ كثيرًا

151
00:10:26,810 --> 00:10:27,520
،سيّد نِينغ

152
00:10:28,050 --> 00:10:30,050
.إنّ حِبركَ كنزٌ حقيقيّ

153
00:10:30,960 --> 00:10:32,180
،استخدمته للرّسم

154
00:10:32,740 --> 00:10:34,660
،وبطريقةٍ ما
...اندمجت الشخصيّة الّتي

155
00:10:34,670 --> 00:10:35,930
...في اللّوحة مع دمكَ

156
00:10:35,970 --> 00:10:39,080
.وتحوّلت إلى شيطانةٍ لتكونَ هُوي

157
00:10:41,850 --> 00:10:44,350
...تقصدُ أنّ -
!إذن أنتِ مَن ألحقَ الأذى بابني -

158
00:10:44,380 --> 00:10:45,050
.أُمّي

159
00:10:45,070 --> 00:10:45,820
!أيّتها الشّيطانة

160
00:10:46,290 --> 00:10:46,780
.سيّدتي

161
00:10:46,790 --> 00:10:47,990
!ابتعدِي عن ابني

162
00:10:48,000 --> 00:10:49,750
.كلا يا أُمّي، ليست هِي

163
00:10:50,080 --> 00:10:51,190
!سيّدتي -
!إنّها لن تُؤذينِي قطعًا -

164
00:10:51,200 --> 00:10:53,320
،سحرتكَ

165
00:10:53,330 --> 00:10:54,410
...لولاها

166
00:10:54,420 --> 00:10:56,610
.لما كُنت بهذا الضّعف

167
00:10:56,620 --> 00:10:57,300
،سيّدتي

168
00:10:57,790 --> 00:10:59,030
،لم أُكمل كلامي بعد

169
00:10:59,040 --> 00:11:00,120
،لا تقلقِي

170
00:11:00,410 --> 00:11:03,440
رُغم أنّ شيطانة اللّوحة هذه
،تعيشُ على دمِ السيّد نِينغ

171
00:11:03,450 --> 00:11:05,080
...إلّا أنّ فُقدان قليلٍ مِن الدّم

172
00:11:05,460 --> 00:11:07,260
.لن يجعلهُ مريضًا لهذه الدّرجة

173
00:11:07,530 --> 00:11:09,150
.لكنّه يُسبّب الاجهاد

174
00:11:09,570 --> 00:11:10,940
...إذن لماذا ابني

175
00:11:12,670 --> 00:11:14,420
.ابنكِ مسمومٌ

176
00:11:15,880 --> 00:11:18,130
مسمومٌ؟ كيف يُعقل هذا؟

177
00:11:18,150 --> 00:11:19,480
مَن ذا الّذي يُريد قتلَ ابني؟

178
00:11:19,510 --> 00:11:21,060
.الشّخص الّذي سمّمه كان حذرًا

179
00:11:21,070 --> 00:11:23,830
عبثَ بأحد مُقتنيات
...ابنكِ اليوميّة

180
00:11:23,840 --> 00:11:26,450
ليضمنَ أنّه سيَتعرّض لجُرعةٍ
.صغيرة مِن السمّ في كُلّ مرّةٍ

181
00:11:26,460 --> 00:11:28,730
وعندما تتراكمُ السّموم
،ببطءٍ في أعضائه

182
00:11:28,740 --> 00:11:30,540
.سيموتُ ابنكِ مِن الإرهاق

183
00:11:30,660 --> 00:11:33,370
وهكذا يُمكنه جعل
.الجريمة غيرَ ملحوظةٍ

184
00:11:33,400 --> 00:11:36,350
مُقتنيات يوميّة؟ أيّها تقصد؟

185
00:11:36,370 --> 00:11:38,530
.أنا المسؤولةُ عن حياته اليوميّة

186
00:11:38,830 --> 00:11:40,850
.بالإضافة إلى أنّنا نعيشُ بهُدوءٍ

187
00:11:40,860 --> 00:11:42,590
نحن نادرًا ما نتواصلُ
،مع العالم الخارجيّ

188
00:11:42,600 --> 00:11:44,610
.ناهيكَ عن وُجود أعداءٍ لنا

189
00:11:45,390 --> 00:11:47,860
.السُمّ وُضِع في هذه المِحبرة

190
00:11:49,800 --> 00:11:50,890
!محالٌ

191
00:11:50,990 --> 00:11:53,640
الزّعيم هُوا هُو مَن أهداها
...لابني، الزّعيم هُوا

192
00:11:55,440 --> 00:11:58,600
هُوا فِينغ يُو؟
...لماذا قامَ بـ

193
00:11:59,030 --> 00:12:00,680
...هل يُعقل أنّ

194
00:12:00,840 --> 00:12:02,010
،على حدّ علمي

195
00:12:02,040 --> 00:12:05,050
في بداية حرب السّراب، لم
.يكُن ملك الجنوب مُحدّدًا بعد

196
00:12:05,060 --> 00:12:07,210
كان كلٌّ مِن الزّعيم نِينغ
.والزّعيم هُوا مُرشّحين

197
00:12:07,220 --> 00:12:09,420
لكن الزّعيم نِينغ ماتَ
.في ساحة المعركة

198
00:12:10,580 --> 00:12:11,380
،وبعد الحرب

199
00:12:11,710 --> 00:12:13,550
...أصبحَ الزّعيم هُوا ملكَ الجنوب

200
00:12:13,560 --> 00:12:14,890
.بسبب صنيعهِ في القتال

201
00:12:17,310 --> 00:12:20,300
.أُمّي -
.ظننتُ أنّه يُساعدنا -

202
00:12:20,470 --> 00:12:22,730
.لأنّه كان الصّديق المُفضّل لزوجي

203
00:12:22,980 --> 00:12:25,900
استمعتُ إليه وقُمت
...بتفكيكِ عائلة نِينغ

204
00:12:25,930 --> 00:12:28,460
.لمُساعدته ليُصبح ملكَ الجنوب

205
00:12:28,530 --> 00:12:32,010
...ولكنّه
.أرادَ قتلنا في الحقيقة

206
00:12:33,110 --> 00:12:35,800
...هل كانت وفاةُ زوجي أيضًا

207
00:12:35,880 --> 00:12:38,290
...أُمّي، تقصدينَ أنّ وفاةَ أبي

208
00:12:38,620 --> 00:12:40,700
كانت مِن تدبيره؟

209
00:12:50,380 --> 00:12:52,090
آن، ما خطبك؟

210
00:12:52,120 --> 00:12:53,020
.دعنِي أرى

211
00:12:56,550 --> 00:12:58,840
كيف حالُ آن؟

212
00:13:00,770 --> 00:13:01,620
.فاتَ الأوان

213
00:13:02,190 --> 00:13:04,380
تطهيرُ جسدهِ مِن السمّ
.يستغرقُ ثلاثة أيّامٍ

214
00:13:04,800 --> 00:13:06,960
...لكن السيّد نِينغ

215
00:13:07,070 --> 00:13:09,160
.لن يصمدَ ولو لبضعِ دقائق

216
00:13:10,280 --> 00:13:11,150
.آن

217
00:13:12,000 --> 00:13:14,970
.يا عزيزي آن، هذا ذنبِي

218
00:13:15,550 --> 00:13:18,290
.ذنبِي أنا

219
00:13:36,760 --> 00:13:38,470
.هُوي

220
00:13:39,680 --> 00:13:40,700
...أنتِ

221
00:13:51,660 --> 00:13:52,540
.عُد إلى الغمد

222
00:13:53,300 --> 00:13:54,020
!لِي شِياو

223
00:13:56,040 --> 00:13:56,870
هل أنتما بخيرٍ؟

224
00:13:57,250 --> 00:13:59,110
...هل طاقةُ سيف السّحاب

225
00:14:01,600 --> 00:14:02,540
.أنا بخيرٍ

226
00:14:03,270 --> 00:14:04,120
...لكنّها هِي

227
00:14:09,020 --> 00:14:10,280
لماذا تفعلينَ هذا؟

228
00:14:10,480 --> 00:14:13,650
عليكِ أن تعلمِي كم الهالة الدمويّة الّتي جمعها
.سيفُ السّحاب خاصّتي في ساحة المعركة

229
00:14:13,660 --> 00:14:16,520
إنّ شيطانةً صغيرة مثلكِ
.ستَلقى حتفها بمُجرّد مُلامسته

230
00:14:18,670 --> 00:14:19,870
.هُوي

231
00:14:37,080 --> 00:14:38,470
.هُوي

232
00:14:44,970 --> 00:14:46,660
.نفِدت دماءُ نِينغ آن وطاقته

233
00:14:46,670 --> 00:14:49,790
...وهُوي تعلمُ أنّ دمها وحدهُ

234
00:14:50,850 --> 00:14:52,980
هُو ما يُمكنه مُساعدته على
.البقاء حيًا طوال هذه الأيّام الثّلاثة

235
00:14:54,330 --> 00:14:55,180
!أيّتها الغبيّة

236
00:14:55,990 --> 00:14:58,180
!يا لكِ مِن ساذجةٍ

237
00:14:59,910 --> 00:15:01,440
...هل تظنّين أنه سيَكون سعيدًا

238
00:15:01,620 --> 00:15:03,030
إذا مُتِّ مِن أجله؟

239
00:15:03,520 --> 00:15:05,610
.لن ينساكِ أبدًا

240
00:15:06,580 --> 00:15:08,980
...كيف ترتضينَ له

241
00:15:09,000 --> 00:15:10,600
أن يعيشَ في جحيمٍ؟

242
00:15:24,290 --> 00:15:25,860
...جُوان جُوان، أنتِ

243
00:15:38,420 --> 00:15:40,680
أبقيتُ لك على جُزءٍ مِن
،رُوحها الأصليّة

244
00:15:42,050 --> 00:15:43,320
،ومع ذلك

245
00:15:44,140 --> 00:15:46,010
فإنّ جمعَ شتات الرّوح
...لتعودَ كاملةً

246
00:15:46,020 --> 00:15:47,680
أمرٌ يتجاوز قُدرة
.البشر العاديّين

247
00:15:48,720 --> 00:15:50,080
...لكَ مُطلق الحُريّة

248
00:15:50,840 --> 00:15:52,440
.إن كُنت ستَمضي للبحث عنها

249
00:15:53,260 --> 00:15:55,560
،هُوي، يومًا ما

250
00:15:58,020 --> 00:15:59,690
.سنلتقِي مُجدّدًا

251
00:16:34,580 --> 00:16:37,000
...أجسادُ الطّيور والكِلاب

252
00:16:37,030 --> 00:16:38,160
.لا تتحمّل

253
00:16:38,610 --> 00:16:39,860
فما هِي إلّا لحظاتٍ
.حتّى تلفظ أنفاسها

254
00:16:40,830 --> 00:16:43,030
.إنّ صغارَ البشر هُم الأفضل

255
00:16:48,870 --> 00:16:49,590
.سيّدي

256
00:16:50,510 --> 00:16:51,590
.سيّدي المُوقّر

257
00:16:52,190 --> 00:16:54,030
.لِي شِياو أنقذَ نِينغ آن

258
00:16:54,300 --> 00:16:55,630
كما أنّ تِيان كوَان كانت
.حاضرةً أيضًا

259
00:16:57,110 --> 00:16:58,550
.حالفهُ الحظّ

260
00:16:59,030 --> 00:17:03,290
هذا يعني أنّ خُطّة استخدام شخصٍ
.مِن عائلة نِينغ كبذرةٍ قد فشلت

261
00:17:03,470 --> 00:17:06,010
لدينا ما يكفي مِن الطّرق
،للضّغط على هُوا فِينغ يُو

262
00:17:06,380 --> 00:17:07,850
.لا يهمّ ذلك

263
00:17:08,390 --> 00:17:09,830
...لكن لِي شِياو

264
00:17:09,850 --> 00:17:12,430
،يستمرّ في إفسادِ خُططنا
.إنّه مصدرُ إزعاجٍ

265
00:17:12,750 --> 00:17:14,830
طالما أنّه هُو مَن أفسدَ
،مسعانا هذه المرّة

266
00:17:14,850 --> 00:17:17,350
فعليه أن يُعوّض عن
.ذلك في المرّة المُقبلة

267
00:17:18,470 --> 00:17:20,180
.فهمتُ يا سيّدي

268
00:17:41,250 --> 00:17:42,310
،هذا تهوّرٌ شديد

269
00:17:42,980 --> 00:17:45,630
الاحتفاظ بالرّوح الأصليّة قسرًا
.سيُلحق أذىً بالغًا برُوحكِ الخالدة

270
00:17:45,640 --> 00:17:47,370
،رُوحكِ مُتضرّرةٌ سلفًا

271
00:17:48,500 --> 00:17:50,940
وليس لدينا سِوى شظيّةٍ
.هشّة مِن الرّوح الأصليّة

272
00:17:50,950 --> 00:17:53,490
.ليس مِن السّهل إعادة هُوي

273
00:17:53,580 --> 00:17:54,840
،أنت لا تفهم

274
00:17:57,920 --> 00:17:59,520
...فقد ظنّت هُوي أنّ هلاكها

275
00:17:59,780 --> 00:18:01,360
.سيَكونُ خلاصًا لـ نِينغ آن

276
00:18:02,250 --> 00:18:03,370
،لكن إن هِي ماتت

277
00:18:03,850 --> 00:18:05,650
.سيَنفطرُ قلب نِينغ آن

278
00:18:05,940 --> 00:18:09,020
كيف لمَن فقدَ الأمل
أن يُعتبر حيًا؟

279
00:18:10,050 --> 00:18:11,380
،حينما نبعثُ في نفسهِ الأمل

280
00:18:12,000 --> 00:18:13,930
ولو كان مِن خلال
.شظيّة رُوحٍ هشّة

281
00:18:14,160 --> 00:18:15,890
.سيَستمدّ منها الشّجاعة ليَعيش

282
00:18:17,310 --> 00:18:18,180
.جُوان جُوان

283
00:18:19,080 --> 00:18:19,940
...في الواقع

284
00:18:20,140 --> 00:18:22,110
أخبرني نِينغ آن عندما
...كُنت على وشك المُغادرة

285
00:18:22,120 --> 00:18:24,160
،أنّه سيَسيرُ على خُطى أبيه

286
00:18:24,170 --> 00:18:25,860
.ويتعلّم الفُنون القتاليّة في الجبال

287
00:18:25,870 --> 00:18:27,910
إنّه يُريد إعادة بناء
،كيان عائلة نِينغ

288
00:18:27,930 --> 00:18:30,340
.وكشف الحقيقة وراءَ موت أبيه

289
00:18:30,350 --> 00:18:32,520
إنّه يُؤمن بأنّه سيَستعيدُ
.هُوي يومًا

290
00:18:33,080 --> 00:18:34,920
.مهما طالَ به الزّمن

291
00:18:34,930 --> 00:18:36,130
وهل وافقت السيّدة
نِينغ على ذلك؟

292
00:18:36,590 --> 00:18:38,250
،بما أنّه قد عقدَ العزم

293
00:18:38,630 --> 00:18:40,250
.فلن يعجزَ عن إقناع أُمّه

294
00:18:41,550 --> 00:18:43,350
،بالحديثِ عن موت الزّعيم نِينغ

295
00:18:43,430 --> 00:18:45,030
،عندما دخلتُ دار عائلة نِينغ

296
00:18:45,040 --> 00:18:48,240
أبصرتُ أثرًا لطائرٍ تمّ الاستحواذ
.عليه بواسطة شيطان السّراب

297
00:18:48,440 --> 00:18:51,230
لا أعتقدُ أنّ الأمر
.بهذه البساطة

298
00:18:52,100 --> 00:18:54,760
استشعرتُ نيّة قتلٍ حينما
.وطئت قدمِي دار نِينغ

299
00:18:55,090 --> 00:18:56,980
لكن للأسف، لا أثرَ لشيطان
.السّراب في أيّ مكانٍ

300
00:18:56,990 --> 00:19:00,190
ولا يُمكننا العُثور على دليلٍ
.قاطع في الوقت الحاليّ

301
00:19:00,910 --> 00:19:02,010
.ظهرت عُشبة الأشباح

302
00:19:02,490 --> 00:19:04,750
أتمنّى ألّا تكونَ هُناك
.مشاكلَ أكبر

303
00:19:18,140 --> 00:19:18,830
،جُوان جُوان

304
00:19:20,410 --> 00:19:21,230
.أنتِ محقّةٌ

305
00:19:22,940 --> 00:19:24,740
،لا ينبغي له أن يهربَ بأنانيّةٍ

306
00:19:26,370 --> 00:19:28,770
،لعدم قُدرته على المُواجهة فحسب

307
00:19:29,580 --> 00:19:31,420
.تاركًا إياكِ وحدكِ في ألمٍ

308
00:19:32,850 --> 00:19:36,850
.أيّها الأخ الأكبر، تفضّل كعك القمر -
.أخلفَ وعدهُ لكِ -

309
00:19:37,010 --> 00:19:38,620
.كان عليه أن يثقَ بكِ أكثر

310
00:19:39,070 --> 00:19:43,410
،أيّها الأخ الأكبر
.سأُحافظ على سيفكَ

311
00:19:44,290 --> 00:19:45,830
.سيفُ السّحاب

312
00:19:46,510 --> 00:19:48,120
،مهما كان مظهرهُ

313
00:19:48,980 --> 00:19:50,400
.كان يجب أن يأتي إليكِ

314
00:19:51,650 --> 00:19:52,540
أَليس كذلك؟

315
00:19:52,650 --> 00:19:55,920
مهرجانُ
الفوانيس

316
00:20:03,030 --> 00:20:05,380
،أيّها الأخ الأكبر
هل تعلم؟

317
00:20:06,110 --> 00:20:07,780
...كادَ شخصٌ بريء أن يُقتل

318
00:20:07,790 --> 00:20:09,410
.بسيف السّحاب اليوم

319
00:20:10,020 --> 00:20:13,420
لحُسن الحظّ، خاطرتُ بحياتي
.للاحتفاظ بشظيّةٍ مِن رُوحها الأصليّة

320
00:20:14,800 --> 00:20:16,160
.توقّف عن توبيخِي

321
00:20:16,180 --> 00:20:17,400
.صُدمت أنا أيضًا

322
00:20:17,970 --> 00:20:21,300
لم أتوقّع أن تندفعَ هِي
.فجأةً وتُمسك بالسّيف

323
00:20:22,470 --> 00:20:25,900
حسنًا، سأَحمي سيف السّحاب
.الّذي تركتهُ لي

324
00:20:26,340 --> 00:20:28,650
،اليوم، وبفضل لِي شِياو

325
00:20:29,210 --> 00:20:31,580
أبعدها عن السّيف في
.الوقت المُناسب

326
00:20:31,720 --> 00:20:35,150
وإلّا لما تمكّنتُ مِن إبقاء شظيّة
.الرّوح، حتّى لو خاطرتُ بحياتي

327
00:20:35,160 --> 00:20:36,760
،لحُسن الحظّ
.أنّه لم يُصب بأذىً

328
00:20:44,950 --> 00:20:46,570
.وِي لِي

329
00:21:01,090 --> 00:21:02,190
...سيفُ السّحاب

330
00:21:03,470 --> 00:21:04,650
.يتعرّف على لِي شِياو

331
00:21:10,390 --> 00:21:17,280
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

332
00:21:17,500 --> 00:21:26,000
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

333
00:21:28,080 --> 00:21:32,780
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

334
00:21:32,790 --> 00:21:37,440
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

335
00:21:37,450 --> 00:21:41,280
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

336
00:21:41,290 --> 00:21:45,740
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

337
00:21:45,750 --> 00:21:50,440
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

338
00:21:50,450 --> 00:21:55,150
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

339
00:21:55,160 --> 00:22:00,320
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

340
00:22:00,330 --> 00:22:04,360
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

341
00:22:04,370 --> 00:22:09,490
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

342
00:22:09,500 --> 00:22:13,990
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

343
00:22:14,000 --> 00:22:18,940
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

344
00:22:18,950 --> 00:22:23,400
