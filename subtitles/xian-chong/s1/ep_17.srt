1
00:00:15,360 --> 00:00:22,260
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

2
00:00:22,270 --> 00:00:29,870
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

3
00:00:29,880 --> 00:00:36,360
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

4
00:00:36,370 --> 00:00:42,570
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

5
00:00:43,330 --> 00:00:50,380
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

6
00:00:50,390 --> 00:00:58,150
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

7
00:00:58,160 --> 00:01:04,970
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

8
00:01:04,980 --> 00:01:10,570
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

9
00:01:11,400 --> 00:01:18,720
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

10
00:01:18,730 --> 00:01:25,420
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

11
00:01:25,430 --> 00:01:31,650
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

12
00:01:31,660 --> 00:01:39,030
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

13
00:02:15,730 --> 00:02:16,710
.شِياوتَان

14
00:02:44,400 --> 00:02:45,160
.سيّدي

15
00:02:47,470 --> 00:02:48,670
.لنبدأَ

16
00:02:48,700 --> 00:02:49,460
.أجل

17
00:03:38,200 --> 00:03:40,050
.هذه الضّحية الخامسة بالفِعل

18
00:03:40,300 --> 00:03:41,510
...هل لديكَ درايةٌ

19
00:03:41,530 --> 00:03:43,570
بكيفيّة زراعة عُشب جِين تَاي؟

20
00:03:44,150 --> 00:03:47,500
لطالما عُرف عن هذا العُشب
.أنّه شديدُ الانتقاء لحاضنه

21
00:03:54,160 --> 00:03:55,420
مَن هُناك؟

22
00:04:09,370 --> 00:04:12,020
!الكهف مليءٌ بالفئران

23
00:04:23,490 --> 00:04:26,080
،يُون زُو
ما الّذي أتى بكِ إلى هُنا؟

24
00:04:27,400 --> 00:04:28,600
.أنتَ لستَ أخي الأكبر

25
00:04:29,060 --> 00:04:30,520
.ولا أنتَ بأبي

26
00:04:30,760 --> 00:04:32,050
!ما أنتُما إلّا شياطين سرابٍ

27
00:04:32,060 --> 00:04:33,950
!رُدّوا إليّ أبي وأخي الأكبر

28
00:04:36,070 --> 00:04:39,200
إذن، كُنتِ أنتِ مَن يختبئ
.في الخزانة ليلةَ أمس

29
00:04:39,420 --> 00:04:41,280
،لكنّكِ مخطئةٌ في أمرٍ واحد

30
00:04:41,370 --> 00:04:43,030
،رُغم أنّني لستُ أخاكِ الأكبر

31
00:04:43,190 --> 00:04:44,380
...إلّا أنّ هذا الرّجل

32
00:04:44,400 --> 00:04:47,370
.والدكِ حقًا

33
00:04:47,650 --> 00:04:49,530
!محالٌ! أنتَ تكذبُ

34
00:04:49,820 --> 00:04:51,940
،أبي رجلٌ شهم قويمُ الخُلق

35
00:04:52,090 --> 00:04:54,770
وليس بالوحش الّذي يسفكُ
!الدّماء دُون أن يطرفَ له جفنٌ

36
00:04:54,780 --> 00:04:56,330
،يُون زُو

37
00:04:56,350 --> 00:04:58,550
أنتِ لا تعرفينَ حقيقة
،والدكِ قطعًا

38
00:04:58,610 --> 00:05:00,270
،فلولا تدبيرهُ

39
00:05:00,280 --> 00:05:02,440
كيف لشياطين سرابٍ
...ضعيفة مثلنا

40
00:05:02,470 --> 00:05:05,100
أن تطأَ عالم يَاو غوَانغ
وتتحرّك فيه بحُريّةٍ؟

41
00:05:06,100 --> 00:05:07,120
...ثُمّ إنّه مع

42
00:05:07,700 --> 00:05:09,450
المرتبة الرُوحيّة العالية
،الّتي بلغها الزّعيم بِي

43
00:05:09,830 --> 00:05:12,730
كيف لهُ أن ينقادَ لشيطان
سرابٍ ليَستولي على جسده؟

44
00:05:16,110 --> 00:05:17,250
!كفى

45
00:05:18,070 --> 00:05:22,090
يُون زُو، كُلّ ما فعلتهُ كانَ
.لأجلِ مصلحة عائلة بِي

46
00:05:22,440 --> 00:05:24,670
!كلا، محالٌ

47
00:05:24,690 --> 00:05:25,940
،يا ابنتي العَزيزة

48
00:05:26,240 --> 00:05:28,170
،ما دُمنا سنَحظى بعُشب الأشباح

49
00:05:28,230 --> 00:05:29,440
...فسَتنالُ عائلتنا

50
00:05:29,470 --> 00:05:32,790
عمّا قريبٍ سُلطانًا
!يُزلزل أركانَ العالم

51
00:05:32,820 --> 00:05:34,120
عُشب الأشباح؟

52
00:05:34,420 --> 00:05:35,470
،أجل

53
00:05:35,600 --> 00:05:38,100
فمَوسوعة عُشب الأشباح
...الوحيدة في هذا العالم

54
00:05:38,120 --> 00:05:39,870
.محفوظةٌ داخلَ عقله

55
00:05:40,220 --> 00:05:41,890
،وبامتلاكنا لهذه المَوسوعة

56
00:05:41,900 --> 00:05:43,960
لن يكونَ ثمّة عائقٌ
!لتحقيق أيّ طُموحٍ عظيم

57
00:05:44,340 --> 00:05:45,090
،يا أبي

58
00:05:45,550 --> 00:05:47,550
آنذاك، حينما أُخِذت
،إلى دار شِينغ هَان

59
00:05:47,560 --> 00:05:49,760
أبصرتُ كيف أنّ عُشب الشّبح
...جُوهان وشيطان السّراب

60
00:05:49,770 --> 00:05:52,190
.قد دفعا بالنّاس إلى الهاوية

61
00:05:52,610 --> 00:05:55,170
،إنّ شياطين السّراب غادرةٌ وماكرة

62
00:05:55,200 --> 00:05:57,530
فكيفَ تُصدّق حرفًا
!واحدًا ممّا يقولونه؟

63
00:05:58,610 --> 00:06:00,420
...لم يُخيّل لي قطّ

64
00:06:00,440 --> 00:06:03,710
...أنّ بذرة لوتسٍ حمراء واحدةً

65
00:06:03,900 --> 00:06:07,140
كفيلةٌ بأن تخلُقَ جيشّا
!ضخمًا مِن جُنود السّراب

66
00:06:07,890 --> 00:06:11,200
تصوّري لو أنّني استحوذتُ على جميع
!أعشابِ الأشباح في العالم السُفليّ

67
00:06:11,210 --> 00:06:14,520
...هل أنتَ مَن منحَ عائلة هَان

68
00:06:14,940 --> 00:06:15,830
بذرة جُوهان؟

69
00:06:15,840 --> 00:06:16,990
،أجل

70
00:06:17,010 --> 00:06:19,490
،ظفرتُ بتلك البذرة صُدفةً

71
00:06:19,670 --> 00:06:22,800
فأردتُ اختبار قُوّة
،عُشب الأشباح الأسطوريّ

72
00:06:22,980 --> 00:06:26,600
.وقد برهنَ العُشب أنّه قويٌّ بحقّ

73
00:06:26,630 --> 00:06:29,600
...لولا تدخّل ملك السّراب

74
00:06:29,860 --> 00:06:30,990
،لا أفهمُ

75
00:06:31,050 --> 00:06:32,740
!لا أستوعبُ شيئًا

76
00:06:33,190 --> 00:06:36,200
كدتُ أن أُصبحَ
.سمادًا لعُشب الأشباح

77
00:06:36,540 --> 00:06:37,500
تلك الإصابة الّتي
...تعرّضتُ لها في الماضي

78
00:06:37,510 --> 00:06:39,830
.كانت تُعذّبني ليلَ نهار

79
00:06:40,570 --> 00:06:42,130
...ثُمّ تُخبرني الآن

80
00:06:42,580 --> 00:06:44,220
...إنّ مَن بدأَ هذا

81
00:06:44,230 --> 00:06:46,400
!هُو أبي الأعزّ

82
00:06:46,710 --> 00:06:50,150
كانَ اختطافكِ إلى دار
،شِينغ هَان مُجرّد حادثٍ

83
00:06:50,180 --> 00:06:51,640
.وما أردتهُ أن يحدثَ أبدًا

84
00:06:51,990 --> 00:06:53,200
،وتعويضًا لكِ

85
00:06:53,630 --> 00:06:56,100
بذلتُ كُلّ مطلبٍ
،طوال هذه السّنوات

86
00:06:56,680 --> 00:06:58,430
!فعليكِ أن ترضي

87
00:06:58,810 --> 00:07:01,940
وحينما أحشدُ القُوّة الكافية
،وأُشعل فتيلَ الحرب

88
00:07:02,300 --> 00:07:04,520
سأفرضُ سيطرتي على
!قارّة تشَانغ شُوي كُلّها

89
00:07:04,960 --> 00:07:07,030
،وأنتِ يا ابنتي

90
00:07:07,510 --> 00:07:09,410
...ما دُمتِ ستعودينَ

91
00:07:09,560 --> 00:07:11,860
،وتتظاهرينَ بأنّ شيئًا لم يكُن

92
00:07:12,620 --> 00:07:16,060
فسأمنحكِ ودّي
.كما كُنت أفعلُ دائمًا

93
00:07:24,780 --> 00:07:25,610
!تريّث

94
00:07:26,400 --> 00:07:27,130
،يا سيّدي

95
00:07:27,560 --> 00:07:28,990
...أخشى أنّ إخلاءَ سبيلها

96
00:07:29,000 --> 00:07:30,600
.ليس في مصلحتنا

97
00:07:31,670 --> 00:07:33,070
،مع كاملِ الاحترام

98
00:07:33,240 --> 00:07:34,790
،أمضيتَ وقتًا طويلًا في التّدبير

99
00:07:34,800 --> 00:07:36,620
،والآن اقتربنا مِن النّهاية

100
00:07:36,810 --> 00:07:38,810
.ولا مجالَ للمُخاطرة

101
00:07:41,770 --> 00:07:44,590
،يُون زُو فتاةٌ صالحة
—ولن تقومَ بـ

102
00:07:44,620 --> 00:07:45,540
،سيّدي

103
00:07:45,810 --> 00:07:48,020
...ما رأيكَ أن تدعنِي أقرأُ أفكارها

104
00:07:48,670 --> 00:07:51,120
لكي تطمئنّ؟

105
00:07:58,980 --> 00:07:59,840
!أبي

106
00:08:00,380 --> 00:08:02,230
مـ-ما الّذي تفعلهُ؟
!أبي

107
00:08:02,250 --> 00:08:04,130
،يُون زُو، لا تقلقي

108
00:08:04,360 --> 00:08:05,600
.فلن ينالكِ أذىً

109
00:08:18,720 --> 00:08:20,190
،فهمتُ

110
00:08:20,510 --> 00:08:22,540
...أنتِ هُنا لأنّكِ

111
00:08:22,560 --> 00:08:24,350
...تُريدين النّزول مِن الجبل

112
00:08:24,370 --> 00:08:26,500
!لتُخبري تِيان كوَان بما حدثَ

113
00:08:28,320 --> 00:08:31,040
رُغم معرفتكِ أنّ الفاعل
،ليس شيطان السّراب

114
00:08:31,070 --> 00:08:32,900
،وإنّما هُو والدكِ

115
00:08:33,260 --> 00:08:36,470
تُريدين مِن تِيان كوَان
أن تمنعَ هذا كُلّه؟

116
00:08:39,150 --> 00:08:40,530
،كُنت أعلمُ

117
00:08:41,040 --> 00:08:44,740
!كُنت متيقّنًا أنّكِ ستفعلينَ هذا

118
00:08:57,430 --> 00:08:58,440
،يا سيّدي

119
00:08:59,270 --> 00:09:01,170
،إذا كُنت لا تزالُ مُتردّدًا

120
00:09:01,540 --> 00:09:02,970
...فلديّ طريقةٌ

121
00:09:02,990 --> 00:09:06,040
.لتُحقّقَ يُون زُو أقصى غاياتها

122
00:09:10,180 --> 00:09:14,230
إنّ عُشب جِين تَاي ينمو ويزدهرُ
،على مشاعر العجز واليأس

123
00:09:14,260 --> 00:09:16,820
،وإذا استنبتّه فيها بيدكَ

124
00:09:17,570 --> 00:09:20,070
!فسَتنمو جُذوره لا محالة

125
00:09:27,200 --> 00:09:27,980
!أبي

126
00:09:28,730 --> 00:09:30,160
ما الّذي تقولهُ؟

127
00:09:34,160 --> 00:09:35,950
،يُون زُو
.صحّتكِ ليست على ما يُرام

128
00:09:35,960 --> 00:09:37,340
.لا تُكثري مِن الشّرب

129
00:09:37,370 --> 00:09:39,520
،أبي
،إنّه مهرجان مُنتصف الخريف

130
00:09:39,530 --> 00:09:40,990
.دعنِي أرتشفُ بضع رشفاتٍ فحسب

131
00:09:41,020 --> 00:09:41,970
...أنتِ

132
00:09:44,060 --> 00:09:45,650
،أنا آسفٌ يا يُون زُو

133
00:09:46,180 --> 00:09:47,990
!لا تلُومينِي

134
00:09:55,480 --> 00:09:56,470
!آنسة شُو

135
00:10:00,270 --> 00:10:02,680
مَن الّذي وطئت قدمهُ
أرض عائلة بِي المُحرّمة؟

136
00:10:05,100 --> 00:10:06,480
،ثمّة حاجزٌ في المكان

137
00:10:06,500 --> 00:10:07,610
،وضبابٌ يكتنفُ الخارج

138
00:10:08,120 --> 00:10:10,050
فكيفَ لأحدٍ أن ينفُذَ؟

139
00:10:27,460 --> 00:10:28,610
.يا بِي شِين

140
00:10:46,490 --> 00:10:48,210
،الخالدة تِيان كوَان

141
00:10:49,230 --> 00:10:52,170
.مرّت سنواتٌ، ويسرّني لقاؤكِ

142
00:10:52,590 --> 00:10:54,430
،أتساءل
...ما الّذي أتى بكِ إلى هُنا

143
00:10:54,460 --> 00:10:56,060
بهذا المظهر المَهيب؟

144
00:11:00,880 --> 00:11:02,140
،أمامَ يُون زُو

145
00:11:02,580 --> 00:11:04,300
.كُفّ عن التّظاهر

146
00:11:05,910 --> 00:11:08,940
جئتِ إلى هُنا للانتقام لابنتي؟

147
00:11:09,680 --> 00:11:10,940
...ليست يُون زُو وحدها

148
00:11:11,310 --> 00:11:13,170
!بل هُناك أرواحٌ لا تُحصى أهلكتها

149
00:11:13,830 --> 00:11:15,730
مِن قصر شِينغ هَان
.إلى بُحيرة جِي بِي

150
00:11:16,200 --> 00:11:17,880
.وجميعهُم يستحقّون الإنصاف

151
00:11:20,960 --> 00:11:22,660
،قد لا تُصدّقينني

152
00:11:23,130 --> 00:11:24,990
.لكنّني أحببتُ ابنتي حُبًا جمًا

153
00:11:25,900 --> 00:11:27,240
،قبل عشرينَ عامًا

154
00:11:27,480 --> 00:11:30,590
بعثتُ بشيطان سرابٍ
.ليَستبين خبر دار شِينغ هَان

155
00:11:31,030 --> 00:11:33,580
لكنّه خدعَ يُون زُو
.لتذهبَ معه

156
00:11:34,570 --> 00:11:35,840
،وحينما اكتشفتُ ما جرى

157
00:11:35,850 --> 00:11:38,110
،قتلتُ ذلك النّذل فورًا

158
00:11:38,570 --> 00:11:40,570
.لكن يُون زُو لم يكُن لها أثرٌ

159
00:11:40,850 --> 00:11:44,130
لم أكُن أعلمُ بأنّها أُخِذت
...إلى عائلة هَان

160
00:11:44,490 --> 00:11:47,070
.كقُربانٍ حتّى أعدتِها أنتِ

161
00:11:48,160 --> 00:11:50,200
فشعرتُ بذنبٍ عظيم
،تجاه يُون زُو

162
00:11:50,620 --> 00:11:52,750
.وأخذتُ أُدلّلها مُنذ ذلك الحين

163
00:11:53,140 --> 00:11:54,700
..."إنّ طريقتكَ في "حُبّها

164
00:11:55,350 --> 00:11:58,280
عبرَ تحويلها إلى سمادٍ
!لعُشب الأشباح

165
00:11:58,950 --> 00:12:01,310
هذا الخطأُ يقعُ على
.عاتقكِ يا تِيان كوَان

166
00:12:01,860 --> 00:12:03,390
...لولا إصرار يُون زُو

167
00:12:03,400 --> 00:12:05,130
،على إطلاعكِ بما حدثَ

168
00:12:05,530 --> 00:12:07,720
.لما أزهقتُ رُوحها

169
00:12:08,920 --> 00:12:10,260
،قبل عشرينَ عامًا

170
00:12:10,540 --> 00:12:13,550
نشرتُ بُذور اللّوتس الحمراء
.في أنحاء قارّة تشَانغ شُوي

171
00:12:13,560 --> 00:12:15,510
،وأوشكت أن تُزهر

172
00:12:15,920 --> 00:12:18,420
،لكن ملك السّراب ظهرَ فجأةً

173
00:12:18,760 --> 00:12:21,690
واستحوذَ على جُنود
.سراب اللّوتس الحمراء

174
00:12:21,730 --> 00:12:23,690
...جُهد عُقودٍ مِن الزّمن

175
00:12:24,110 --> 00:12:26,120
.تبدّد هباءً

176
00:12:26,440 --> 00:12:28,010
،ظللتُ مُختبئًا لسنواتٍ

177
00:12:28,030 --> 00:12:31,520
حتّى وضعت الحربُ أوزارها
.وأُلحقت الهزيمة بملك السّراب

178
00:12:31,530 --> 00:12:34,170
تعقّبت أيضًا شيطان السّراب الّذي
،يملكُ مَوسوعة عُشب الأشباح

179
00:12:34,180 --> 00:12:35,960
.وباتَ بمقدُوري العودة

180
00:12:36,080 --> 00:12:37,100
،لكنّكِ أنتِ

181
00:12:37,540 --> 00:12:39,950
،يا تِيان كوَان
،وذلك الطّائر الأسود

182
00:12:39,980 --> 00:12:41,420
،قد أفسدتُما الخُطّة

183
00:12:41,830 --> 00:12:43,840
...وأجبرتُماني

184
00:12:43,870 --> 00:12:45,780
!على إزهاق رُوح ابنتي

185
00:12:46,120 --> 00:12:47,600
...ما كانَ ينبغي لي أن

186
00:12:48,240 --> 00:12:49,890
،لو أنّي بكّرتُ في القُدوم

187
00:12:50,590 --> 00:12:53,990
لما غدت يُون زُو
.قُربانًا لطُموحكَ

188
00:12:54,990 --> 00:12:57,230
يبدو أنّنا سنخوضُ
.معركةً اليوم

189
00:12:57,800 --> 00:13:00,940
،لطالما سمعتُ أنّ تِيان كوَان
!إلهةُ الحرب، لا تُقهر

190
00:13:00,950 --> 00:13:03,440
،في غُضون عشرينَ عامًا فحسب
...بلغتِ القمّة مِن دُون جاهٍ

191
00:13:03,460 --> 00:13:06,140
لتُصبحي القائدة العسكريّة
!الأكثر قُوّةً

192
00:13:06,520 --> 00:13:07,500
،وما جئتُ اليوم

193
00:13:07,640 --> 00:13:11,130
.إلّا لأشهدَ على قُوّتكِ

194
00:14:50,430 --> 00:14:53,310
إنّ مكانتكَ الحاليّة جعلتكَ
،محطّ أنظار الآلاف

195
00:14:53,320 --> 00:14:54,940
فما بالُكَ لا تقنعُ؟

196
00:14:54,950 --> 00:14:57,550
ولِمَ كانَ عليك أن تُبيدَ
الكثير مِن الأبرياء؟

197
00:14:57,880 --> 00:14:59,280
مكانتي الحاليّة؟

198
00:14:59,760 --> 00:15:00,960
وأيّ مكانةٍ هذه؟

199
00:15:01,400 --> 00:15:03,510
مكانةٌ خاضعة لمشيئةِ
الحاكم وحدهُ؟

200
00:15:03,520 --> 00:15:04,280
!كيف تجرؤُ

201
00:15:06,630 --> 00:15:09,460
خُلِق البشر والخالدون
.وبينهُما فجوةٌ

202
00:15:10,070 --> 00:15:12,230
في العلياء حيثُ يمرح
...هؤلاء الخالدون

203
00:15:12,250 --> 00:15:14,110
...المُتعالون وتتعالى ضحكاتهُم

204
00:15:14,530 --> 00:15:15,950
،دُون عناءٍ

205
00:15:16,490 --> 00:15:19,270
ثمّة مكانةٌ شاهقة لا يملكُ
!بشريّ فانٍ أن يبلُغها

206
00:15:19,860 --> 00:15:22,000
عشتُ عُمري كُلّه
،في تدريب نفسي

207
00:15:22,010 --> 00:15:23,900
،ولم أتقاعس يومًا واحدًا

208
00:15:23,990 --> 00:15:26,500
ومع ذلك لم أقدِر على
!اختراق مرتبتي الرُوحيّة

209
00:15:26,510 --> 00:15:28,540
،أيّتها الخالدة
هل تعلمينَ لماذا؟

210
00:15:28,670 --> 00:15:30,810
.لأنّ قُوّتكَ لم تبلُغ المدى

211
00:15:30,820 --> 00:15:32,920
.كلا! بل لأنّني مِن البشر

212
00:15:32,950 --> 00:15:34,420
،ولأنّني مِن البشر فحسب

213
00:15:34,440 --> 00:15:35,610
...فلا مصيرَ لي

214
00:15:35,640 --> 00:15:38,360
سوى أن أُداسَ بأقدام هؤلاء
!الخالدين في هُونغ مِينغ

215
00:15:38,390 --> 00:15:41,390
وليس أمامي سوى اتّباع
.القوانين الّتي فرضُوها علينا

216
00:15:41,410 --> 00:15:42,760
!لستُ مُقتنعًا

217
00:15:43,290 --> 00:15:44,790
،لكَ ألّا تقتنعَ

218
00:15:44,800 --> 00:15:47,390
ولكَ أن تتمرّد على
!سُلطة هُونغ مِينغ

219
00:15:47,400 --> 00:15:49,020
...لكن لا حقّ لكَ في بُلوغ مآربكَ

220
00:15:49,030 --> 00:15:50,630
.بإزهاقِ أرواح الأبرياء

221
00:15:53,340 --> 00:15:55,940
إلى متى ستَقفُ مُتفرّجًا هكذا؟

222
00:15:57,350 --> 00:15:58,450
...أنتَ

223
00:16:00,240 --> 00:16:00,860
،سيّدي

224
00:16:01,540 --> 00:16:03,270
ما الّذي يُمكنني
فعلهُ مِن أجلكَ؟

225
00:16:06,020 --> 00:16:06,950
،تِيان كوَان

226
00:16:06,980 --> 00:16:09,700
هل تظنّينَ أنّني سأستسلمُ ببساطةٍ؟

227
00:16:09,720 --> 00:16:11,590
،إن لم أتمكّن مِن مُواجهتكِ

228
00:16:11,850 --> 00:16:14,490
فكيفَ لي أن أُعيد إرساء
نظام السّماوات والأرض؟

229
00:16:14,500 --> 00:16:17,210
،رُغم أنّ الأمر حدثَ قبل أوانه

230
00:16:17,600 --> 00:16:18,630
.لكن لا بأس

231
00:16:19,110 --> 00:16:22,000
يا دُون، فعّل
!عُشب جِين تَاي فورًا

232
00:16:22,320 --> 00:16:24,960
.أمرُكَ يا سيّدي

233
00:16:33,870 --> 00:16:34,890
ماذا فعلتَ؟

234
00:16:34,940 --> 00:16:37,290
...بذرتُ عُشب جِين تَاي

235
00:16:37,310 --> 00:16:39,430
.في أرجاء عالم يَاو غوَانغ كافّةً

236
00:16:39,680 --> 00:16:41,570
،جميع أتباعِي

237
00:16:41,590 --> 00:16:43,760
،وأهل يَاو غوَانغ

238
00:16:43,810 --> 00:16:46,710
وحُشود اللّاجئين الّذين
،آويتهُم طوال سنواتٍ

239
00:16:46,940 --> 00:16:50,110
استحالوا طوعَ أمري
.ضمن جيش السّراب

240
00:16:50,360 --> 00:16:53,840
،عمّا قريبٍ
.سوفَ يُطوّقون هذا الكهف

241
00:16:54,200 --> 00:16:56,480
،ومهما بلغت قُوّتكِ

242
00:16:56,500 --> 00:16:59,020
فلن تطأَ قدمكِ
!خارجَ هذا المكان

243
00:16:59,270 --> 00:17:01,420
هؤلاء النّاس يكنّون
،لكَ أعظم تقديرٍ

244
00:17:02,090 --> 00:17:04,280
وكان أحرى بكَ أن
.تحميهُم بحياتكَ

245
00:17:04,290 --> 00:17:06,060
،وأنا أحميهم بالفِعل

246
00:17:06,180 --> 00:17:08,410
—لهذا سأخُذهم معي

247
00:17:08,700 --> 00:17:11,250
لنُعيدَ صياغة نظام
.السّماوات والأرض

248
00:17:12,070 --> 00:17:13,890
!ها هُم قادمونَ

249
00:17:14,190 --> 00:17:15,580
...أشعرُ بهم يقتربونَ

250
00:17:17,460 --> 00:17:19,660
!أكثرَ فأكثر

251
00:17:21,030 --> 00:17:23,940
،أقبِل يا جيشي الأبديّ

252
00:17:24,200 --> 00:17:26,890
!وأدّ فُروض الطّاعة لسيّدكَ

253
00:17:43,830 --> 00:17:45,000
أنتَ؟

254
00:17:45,420 --> 00:17:47,420
لماذا تجاهلتِ رسائلي؟

255
00:17:49,450 --> 00:17:51,370
قطعتُ كُلّ هذه
،المسافة لأصلَ إليكِ

256
00:17:51,380 --> 00:17:52,780
!لكنّكِ لم تُجيبينِي قطّ

257
00:17:53,000 --> 00:17:54,600
هل تُدركين كم
تملّكني القلق عليكِ؟

258
00:17:57,060 --> 00:17:59,860
إنّ الجبال محجوبةٌ
،بالضّباب السّام والحواجز

259
00:17:59,900 --> 00:18:01,340
.كما أنّ الإشارة رديئةٌ للغاية

260
00:18:02,460 --> 00:18:03,600
.أنا... أنا آسفةٌ

261
00:18:04,380 --> 00:18:05,720
فرغتُما مِن حديثكُما؟

262
00:18:08,380 --> 00:18:11,110
أنتَ لِي شِياو الخبيرُ
،بأسرار عُشب الأشباح

263
00:18:13,020 --> 00:18:14,600
...إذن أنتَ أدرى النّاس

264
00:18:14,620 --> 00:18:15,920
...بأنّ قُوّة عُشب جِين تَاي

265
00:18:15,930 --> 00:18:18,620
هِي الأعظم بين جميع
.أنواع هذا العُشب

266
00:18:19,000 --> 00:18:20,440
سيَكونُ جيش السّراب
...التّابع لي

267
00:18:20,460 --> 00:18:23,320
.أقوى قُوّةٍ على الإطلاق

268
00:18:23,700 --> 00:18:24,450
—وبمُجرّد وصولهم

269
00:18:24,460 --> 00:18:25,400
،لا داعي لأن تنتظرَ

270
00:18:26,250 --> 00:18:28,000
!فجيشكَ لن يصلَ قطعًا

271
00:18:29,130 --> 00:18:31,930
استُؤصِلت بُذور عُشب
.جِين تَاي عن بكرةِ أبيها

272
00:18:32,230 --> 00:18:34,230
.بِي شِين، حبِطَ تدبيركَ

273
00:18:34,410 --> 00:18:35,640
ماذا قُلت؟

274
00:18:36,180 --> 00:18:37,510
ما الّذي حدثَ تحديدًا؟

275
00:18:38,350 --> 00:18:40,880
قدمتُ إلى هُنا للتّحقيق
،في قضيّة هُوا فِينغ يُو

276
00:18:41,020 --> 00:18:42,850
لكنّني اكتشفتُ بالصّدفة
...أنّ عُشب جِين تَاي قد زُرِعَ

277
00:18:42,860 --> 00:18:45,860
في أجساد حُشودٍ مِن
.البشر في عالم يَاو غوَانغ

278
00:18:45,870 --> 00:18:46,570
،لذا

279
00:18:46,600 --> 00:18:49,120
كلّفتُ السيّد قِطّ بالبحث
،عن التّرياق لعُشب جِين تَاي

280
00:18:49,130 --> 00:18:51,660
وهُو تلك السّمكة الفضيّة
.الّتي تعيشُ في نهر رُووشوِي

281
00:18:52,410 --> 00:18:54,550
كما طلبتُ مِن اللّورد
...جِينغ شُون والأمير شيَان

282
00:18:54,560 --> 00:18:56,540
،إرسالَ الجُنود السماويّين فورًا

283
00:18:56,550 --> 00:18:59,320
ليَستأصلُوا بُذور عُشب
،جِين تَاي مِن أجساد العامّة

284
00:18:59,350 --> 00:19:01,080
.قبل أن يبدأَ مفعول السّم

285
00:19:01,970 --> 00:19:04,750
محالٌ! أمضيتُ دهرًا
،أُخطّط لهذا

286
00:19:04,780 --> 00:19:07,080
فكيفَ لك أن تُدمّر
مسعاي بهذه البساطة؟

287
00:19:07,220 --> 00:19:08,070
!محالٌ

288
00:19:08,380 --> 00:19:11,190
!غايتي الكُبرى، جيشي

289
00:19:19,680 --> 00:19:21,650
كيفَ يُمكن أن يحدثَ هذا؟

290
00:19:22,580 --> 00:19:24,960
...دُون، أنتَ

291
00:19:25,540 --> 00:19:29,270
لا يُمكن! أنتَ خاضعٌ لتميمة
،السّيطرة الخاصّة بي

292
00:19:29,810 --> 00:19:32,380
!لن تقدرَ على قتلي

293
00:19:36,340 --> 00:19:38,930
أنا لم أغرِس البذرة
،في جسدكَ

294
00:19:39,610 --> 00:19:42,760
،بل فَعّلتُها فحسب
.امتثالًا لما أمرتنِي به

295
00:19:58,300 --> 00:19:59,550
...وأخيرًا

296
00:20:00,550 --> 00:20:01,850
!نلتُ حُريّتي

297
00:20:08,100 --> 00:20:15,160
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

298
00:20:15,200 --> 00:20:23,710
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

299
00:20:25,660 --> 00:20:30,380
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

300
00:20:30,410 --> 00:20:33,240
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

301
00:20:34,990 --> 00:20:38,850
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

302
00:20:38,880 --> 00:20:42,970
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

303
00:20:43,350 --> 00:20:47,720
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

304
00:20:48,070 --> 00:20:52,470
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

305
00:20:52,740 --> 00:20:57,920
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

306
00:20:57,940 --> 00:21:01,380
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

307
00:21:02,060 --> 00:21:07,020
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

308
00:21:07,050 --> 00:21:11,520
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

309
00:21:11,540 --> 00:21:16,510
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

310
00:21:16,540 --> 00:21:21,000
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

311
00:21:26,160 --> 00:21:31,290
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟