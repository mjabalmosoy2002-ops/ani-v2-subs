1
00:00:15,080 --> 00:00:22,060
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

2
00:00:22,150 --> 00:00:27,550
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

3
00:00:29,770 --> 00:00:35,770
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

4
00:00:36,300 --> 00:00:41,930
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

5
00:00:43,420 --> 00:00:49,300
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

6
00:00:50,480 --> 00:00:56,150
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

7
00:00:57,980 --> 00:01:04,650
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

8
00:01:04,950 --> 00:01:10,650
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

9
00:01:11,280 --> 00:01:18,610
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

10
00:01:18,640 --> 00:01:24,300
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

11
00:01:25,270 --> 00:01:31,500
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

12
00:01:31,520 --> 00:01:38,650
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

13
00:01:55,360 --> 00:01:57,520
...تحوّلت رُوح الثّعلب

14
00:01:58,750 --> 00:02:00,530
.إلى امرأةٍ برداءٍ أحمر

15
00:02:00,780 --> 00:02:03,480
.رآها الباحثُ فذُهل تمامًا

16
00:02:03,490 --> 00:02:05,260
،تقدّم نحوها وسألَ

17
00:02:05,270 --> 00:02:09,330
أيّتها الشّابة، ماذا تفعلينَ هُنا"
"وحيدةً في مُنتصف اللّيل؟

18
00:02:09,440 --> 00:02:11,490
،أجابت المرأة بعُذوبةٍ

19
00:02:11,590 --> 00:02:14,680
،عشِقتُ الكُتب والخطّ مُنذ صغري"

20
00:02:14,690 --> 00:02:17,770
وحين سمعتُ أنّك تدرسُ
...هُنا بمُفردك

21
00:02:17,800 --> 00:02:19,590
".جِئتُ لأُؤنس وحدتكَ

22
00:02:19,600 --> 00:02:23,660
،غمرت الباحث سعادةٌ غامرة
.ودعاها للدّخول للتحدّث على الفور

23
00:02:23,960 --> 00:02:25,910
،لمعرفة ما سيَحدثُ بعد ذلك

24
00:02:26,040 --> 00:02:28,920
.انتظِروا المرّة القادمِة

25
00:02:33,110 --> 00:02:33,900
،سيّدي

26
00:02:35,570 --> 00:02:37,980
لماذا تغوِي أرواحُ الثّعالب
الباحثين دائمًا؟

27
00:02:38,890 --> 00:02:41,490
في ثمانيةٍ مِن كُلّ عشرة كُتب
.قصصٍ، يكون المآل هكذا

28
00:02:41,790 --> 00:02:44,240
إغواءُ الباحثين هُو مصيرُ
.رُوح الثّعلب

29
00:02:44,250 --> 00:02:45,880
.أظنّ أنّ عليهم تحقِيقه

30
00:02:46,160 --> 00:02:49,400
إذن... ما الفائدة مِن
تحقِيق مصيرهم؟

31
00:02:50,650 --> 00:02:53,630
هُناك فائدةٌ واحدة! بمُجرّد أن
،تُحقّق رُوح الثّعلب مصيرها

32
00:02:53,640 --> 00:02:55,980
.تزدادُ قُواها بشكلٍ هائل

33
00:02:56,710 --> 00:02:57,800
وماذا عن الشَّعر؟

34
00:02:57,810 --> 00:03:00,790
هل يُمكن أن يُصبح ناعمًا
كما يرغبون؟

35
00:03:02,330 --> 00:03:04,120
رُبّما، بمُجرّد أن تُصبح
،قُواهم كافيةً

36
00:03:04,130 --> 00:03:05,750
.سيَغدو كُلّ شيءٍ سهلًا

37
00:03:07,070 --> 00:03:08,330
،إذن، يا سيّدي

38
00:03:08,340 --> 00:03:10,400
هل تعرفُ أين يُمكنني
أن أجِد باحثًا؟

39
00:03:19,200 --> 00:03:20,850
صرحُ يِيشَان التعليميّ

40
00:03:20,060 --> 00:03:21,060
.هذا هُو المكان

41
00:03:38,120 --> 00:03:39,570
.تحيّاتي، يا سيّدي الشّاب

42
00:03:42,480 --> 00:03:45,420
،عشِقتُ الكُتب والخطّ مُنذ صغري

43
00:03:45,430 --> 00:03:48,300
وحين سمعتُ أنّك تدرسُ
،هُنا بمُفردك

44
00:03:48,850 --> 00:03:50,320
.جِئتُ لأُؤنس وحدتكَ

45
00:03:52,320 --> 00:03:53,030
ماذا؟

46
00:03:53,340 --> 00:03:54,660
ماذا تقصدُ بـ "ماذا"؟

47
00:03:54,670 --> 00:03:56,060
يُفترض بكَ أن تكونَ
،مسرورًا الآن

48
00:03:56,070 --> 00:03:57,800
!وتدعُوني للدّخول للتحدّث

49
00:03:58,570 --> 00:04:00,330
ولماذا يجبُ أن أكونَ مسرورًا؟

50
00:04:01,280 --> 00:04:04,000
أَليس مِن المُفترض أن يبتهجَ
الباحثون دائمًا في هذه اللّحظة؟

51
00:04:04,010 --> 00:04:06,470
ولماذا يبتهجُ الباحث في
هذه اللّحظة؟

52
00:04:07,860 --> 00:04:08,920
...لماذا

53
00:04:09,350 --> 00:04:11,250
لماذا لا تتّبع النّص؟

54
00:04:11,260 --> 00:04:12,400
نصٌّ؟

55
00:04:13,250 --> 00:04:14,530
...هل أنتِ جائعةٌ

56
00:04:14,560 --> 00:04:16,220
ولكنّكِ تشعرينَ بالخجل
مِن قول ذلك؟

57
00:04:16,720 --> 00:04:17,640
!لستُ كذلك

58
00:04:21,250 --> 00:04:22,220
.تفضّلي بالدّخول

59
00:04:26,540 --> 00:04:29,340
،لم يعُد الطّعام ساخنًا
.لكن لا بأس به

60
00:04:30,350 --> 00:04:31,480
...لماذا أنتِ هُنا وحدكِ

61
00:04:31,490 --> 00:04:32,950
في مُنتصف اللّيل؟

62
00:04:34,900 --> 00:04:36,650
لأنّني عشِقتُ الكُتب والخطّ
...مُنذ صغري

63
00:04:36,650 --> 00:04:38,400
ماذا عن عائلتكِ؟

64
00:04:41,470 --> 00:04:42,590
.رحلوا جميعًا

65
00:04:43,780 --> 00:04:45,040
إذن، أينَ تعيشِين؟

66
00:04:45,680 --> 00:04:47,830
.في جبلٍ بعيد مع مُعلّمي

67
00:04:50,010 --> 00:04:51,020
،بعد أن تنتهِي مِن تناول الطّعام

68
00:04:51,030 --> 00:04:52,890
.سأُعيدكِ إلى مُعلّمكِ

69
00:04:53,390 --> 00:04:56,230
.كلا، كلا، هربتُ

70
00:04:56,490 --> 00:04:57,680
،إذا اكتشفَ مُعلّمي ذلك

71
00:04:57,690 --> 00:04:59,350
سيُرغمنِي على القيام بالأعمال
.المنزليّة مُجدّدًا

72
00:04:59,650 --> 00:05:01,320
هل يُعاملكِ مُعلّمكِ بشكلٍ سيّيء؟

73
00:05:01,980 --> 00:05:03,920
،وجدنِي أهيمُ وحيدةً

74
00:05:04,170 --> 00:05:05,960
.وأصرَّ على أن يتّخذني تلميذةً له

75
00:05:05,970 --> 00:05:09,600
يستمرّ في القول إنّني
،مُنحت مصيرًا عظيمًا

76
00:05:09,620 --> 00:05:11,640
،وإذا لم أتدرّب بجدٍ
.فسأتسبّب في كارثةٍ

77
00:05:11,650 --> 00:05:13,800
،لكنّه لا يُعلّمني أيّ شيءٍ إطلاقًا

78
00:05:14,720 --> 00:05:18,020
،يجعلُني أُقطّع الخشب فحسب
...وأغلِي الماء، وأطبخ، وأُنظّف

79
00:05:18,040 --> 00:05:19,580
.أنا أقومُ بكُلّ الأعمال الشّاقة

80
00:05:24,370 --> 00:05:26,230
لأنّني عشِقتُ الكُتب والخطّ
...مُنذ صغري

81
00:05:26,240 --> 00:05:28,160
.غدًا، سآخذكِ لمُقابلة المُعلّم

82
00:05:28,170 --> 00:05:29,400
حين سمعتُ أنّك تدرسُ
...هُنا بمُفردك

83
00:05:29,410 --> 00:05:30,810
.سنَسأله إن كان بإمكانكِ البقاء

84
00:05:30,820 --> 00:05:32,480
...جِئتُ لأُؤنس وحدتكَ...

85
00:05:33,600 --> 00:05:34,810
ولماذا أبقى؟

86
00:05:35,840 --> 00:05:38,040
أَلم تُخبرينِي أنّكِ جِئتِ
لتدرُسي معي؟

87
00:05:39,870 --> 00:05:42,530
،أكلتِ الطّعام بالفِعل
.فاتَ الأوان للتّراجع الآن

88
00:05:51,730 --> 00:05:53,650
،الصّرح لا يقبلُ الفتيات

89
00:05:54,080 --> 00:05:55,200
،عندما تُقابلين المُعلّم

90
00:05:55,210 --> 00:05:57,070
.سيَتعيّن عليكِ التّظاهر بأنّكِ فتىً

91
00:06:00,920 --> 00:06:01,620
.السيّد شُو

92
00:06:02,860 --> 00:06:04,610
.أخبرني وِي لِي بالتّفاصيل

93
00:06:04,630 --> 00:06:07,030
إذا لم يكُن لديكَ مكانٌ تذهب
.إليه، فيُمكنكَ البقاء هُنا

94
00:06:07,470 --> 00:06:08,980
.شـ-شُكرًا لك، يا سيّدي

95
00:06:09,410 --> 00:06:10,600
...أمّا بالنّسبة للرّسوم الدراسيّة

96
00:06:10,620 --> 00:06:12,680
.فمِن المُحتمل أنّكَ لا تملكُ ثمنها

97
00:06:12,710 --> 00:06:15,190
ساعِد في التّنظيف كُلّ يومٍ
.لتعويض ذلك فحسب

98
00:06:15,200 --> 00:06:17,160
ماذا؟ عليّ القيام بالأعمال
الشّاقة أيضًا؟

99
00:06:17,890 --> 00:06:19,650
!ليس هذا ما أخبرتنِي به

100
00:06:20,390 --> 00:06:21,830
.لا بأس، سأُساعدكِ

101
00:06:52,120 --> 00:06:54,240
،قال وِي لِي إنّكَ فقدتَ والديكَ

102
00:06:54,270 --> 00:06:56,400
.ولا تتذكّر حتّى اسم عائلتكَ

103
00:06:56,870 --> 00:06:59,500
هل ترغبُ في اتّخاذ
اسمي... شُو؟

104
00:06:59,530 --> 00:07:02,150
ماذا يعني شُو؟

105
00:07:02,170 --> 00:07:04,790
".إنّه يعني "الامتِداد أو الانبِساط

106
00:07:05,710 --> 00:07:08,770
مثل... الشّعر المُجعّد الّذي
!يُمكن فردُه؟ أنا أقبل

107
00:07:09,260 --> 00:07:10,010
.جيّدٌ

108
00:07:10,410 --> 00:07:14,540
مِن الآن فصاعدا، شُو جُوان جُوان
.تلميذٌ في صرح يِيشان التعليميّ

109
00:07:17,500 --> 00:07:21,500
،أن تتعلّمَ وتُمارسَ ما تعلّمته بانتظامٍ"
"أَليس ذلك مبعثًا للبهجة؟

110
00:07:21,630 --> 00:07:24,210
سيّدي، لماذا ندرُس؟

111
00:07:24,230 --> 00:07:29,700
،نحن ندرُس لتهذيبِ النّفس، وإرشادِ العائلة
.وحُكم البلاد، وإحلالِ السّلام في العالم

112
00:07:29,730 --> 00:07:31,410
إحلالُ السّلام في العالم؟

113
00:07:32,570 --> 00:07:35,570
هل يعني ذلك أنّنا سنُصبح
جنرالاتٍ بعد الدّراسة؟

114
00:07:37,040 --> 00:07:38,810
مَن يعلم، رُبّما
...يُصبح شُو جُوان جُوان

115
00:07:38,820 --> 00:07:40,900
.جنرالًا عظيمًا يومًا ما

116
00:07:49,550 --> 00:07:53,550
وِي لِي، أَلن تعودَ إلى منزلكَ لقضاء
مهرجان مُنتصف الخريف هذا العام أيضًا؟

117
00:07:53,890 --> 00:07:55,680
...المسافة بعيدةٌ
.لا نيّة لي في الذّهاب

118
00:07:56,670 --> 00:07:58,260
...عائلتكَ، حقًا

119
00:07:58,290 --> 00:07:59,600
في مثل هذه المُناسبة
...النّادرة للمّ الشّمل

120
00:07:59,610 --> 00:08:01,470
كان بإمكانهِم على الأقلّ
.إرسال رسالةٍ

121
00:08:01,960 --> 00:08:03,790
،إنّهم مشغولونَ
.ليس لديهم وقتٌ

122
00:08:03,800 --> 00:08:04,730
.اعتنِ بنفسكَ إذن

123
00:08:05,340 --> 00:08:08,340
سأُحضر لكَ التّفاح مِن
.منزلي عندما أعود

124
00:08:15,660 --> 00:08:16,570
،وِي لِي

125
00:08:22,580 --> 00:08:23,780
،لا تقلق

126
00:08:23,800 --> 00:08:26,600
،بمُجرّد وضع الدّواء
.سيَلتئمُ الجُرح سريعًا

127
00:08:27,390 --> 00:08:29,190
وِي لِي، هل تكتبُ رسالةً؟

128
00:08:29,670 --> 00:08:31,120
إلى عائلتكَ؟

129
00:08:32,710 --> 00:08:35,840
كُلّما فكّرتُ في الأمر، أجدُ أنّني
.لم أركَ تتواصل معهم أبدًا

130
00:08:37,210 --> 00:08:38,070
وماذا عنكِ؟

131
00:08:38,520 --> 00:08:41,650
مرّ عامٌ، أَما زلتِ لا تنوينَ
العودة إلى مُعلّمكِ؟

132
00:08:42,400 --> 00:08:44,840
...حسنًا
.لم أُنهِ دراستِي بعد

133
00:08:47,550 --> 00:08:48,150
.انتهيتُ

134
00:08:52,100 --> 00:08:52,630
.يا سيّدي

135
00:09:00,930 --> 00:09:02,230
.اليوم مهرجان مُنتصف الخريف

136
00:09:02,240 --> 00:09:04,140
.أحضرتُ لكُما كعك القمر

137
00:09:04,250 --> 00:09:05,140
.شُكرًا لك، يا سيّدي

138
00:09:11,870 --> 00:09:14,330
وِي لِي، تلك الّتي تناولتَها لتوّي
.كانت بمعجُون بُذور اللّوتس

139
00:09:14,790 --> 00:09:16,520
ما هِي الحشوة في هذه؟

140
00:09:18,940 --> 00:09:20,780
،إذن جُوان جُوان
.تفضّل بتذوّقها أولًا

141
00:09:26,510 --> 00:09:27,620
.خُذا وقتكما

142
00:09:27,960 --> 00:09:29,420
.سادت الفوضى مُؤخّرًا

143
00:09:30,030 --> 00:09:31,490
،ظهرَ الكثير مِن المُمارِسين

144
00:09:31,500 --> 00:09:34,140
قائلينَ إنّهم هُنا لاصطيادِ
.الشّياطين على الجبل

145
00:09:34,150 --> 00:09:35,220
.غدًا يوم راحةٍ

146
00:09:35,230 --> 00:09:37,900
.ابقيا في الصّرح ولا تتجوّلًا

147
00:09:38,180 --> 00:09:38,690
.حاضرٌ، يا سيّدي

148
00:09:38,700 --> 00:09:39,970
.رافقتكَ السّلامة، يا سيّدي

149
00:09:44,430 --> 00:09:46,530
هل تعرفينَ ما هُو مهرجان
مُنتصف الخريف؟

150
00:09:46,540 --> 00:09:47,230
!بالطّبع

151
00:09:47,470 --> 00:09:48,680
...إنّه اليوم

152
00:09:49,680 --> 00:09:51,470
!الّذي نأكلُ فيه كعك القمر

153
00:09:53,080 --> 00:09:54,680
،إنّه يوم اكتمالِ القمر

154
00:09:55,740 --> 00:09:57,270
.وقتُ لمّ شمل العائلة

155
00:09:58,380 --> 00:10:01,110
إذن أَلن تعودَ إلى منزلكَ
لتكونَ مع عائلتكَ؟

156
00:10:02,010 --> 00:10:03,010
...العائلة

157
00:10:06,230 --> 00:10:08,940
،رُبّما في أذهانِهم

158
00:10:09,560 --> 00:10:11,620
لم أعُد فردًا مِن العائلة
.مُنذ زمنٍ طويل

159
00:10:14,810 --> 00:10:16,810
.خُذ هذه، سأعودُ حالًا

160
00:10:24,990 --> 00:10:26,540
،أيّها الباحث الصّغير

161
00:10:28,080 --> 00:10:29,010
.سُررت بلقائكَ

162
00:10:37,750 --> 00:10:39,900
جُوان جُوان، ماذا تفعلين؟

163
00:10:41,630 --> 00:10:42,910
.ليس هذا هُو النّص

164
00:10:43,560 --> 00:10:44,690
،يُفترض أن تقول

165
00:10:45,630 --> 00:10:47,170
...أيّتها الشّابة، ماذا تفعلين"

166
00:10:48,820 --> 00:10:50,950
"هُنا في منتصف اللّيل؟

167
00:10:53,330 --> 00:10:57,060
إذن، أيّتها الشّابة، ماذا تفعلين
هُنا في منتصف اللّيل؟

168
00:10:57,880 --> 00:11:00,470
،أحببتُ الأماكن الصّاخبة دومًا

169
00:11:00,490 --> 00:11:03,350
وحين سمعتُ أنّكَ تقضي
،المهرجان وحيدًا

170
00:11:03,420 --> 00:11:05,190
.جِئتُ لأُؤنس وحدتكَ

171
00:11:10,300 --> 00:11:12,050
.نحن لسنا أقاربَ حتّى

172
00:11:12,320 --> 00:11:13,630
أَليس هذا تصرفًا غير لائقٍ؟

173
00:11:13,640 --> 00:11:14,700
،هذا سهلٌ

174
00:11:15,150 --> 00:11:16,360
،تزوّجني فحسب

175
00:11:16,800 --> 00:11:18,200
!وبذلك سنُصبح عائلةً

176
00:11:20,190 --> 00:11:21,660
...أنتِ

177
00:11:22,900 --> 00:11:25,280
مِن أينَ تعلّمتِ هذا الهُراء؟

178
00:11:29,520 --> 00:11:31,230
!كُلّ كُتب القصص تُؤكّد ذلك

179
00:11:31,530 --> 00:11:35,530
الرّجل والمرأة يُصبحان زوجًا
وزوجةً، أَلا يجعلهُما ذلك عائلةً؟

180
00:11:36,970 --> 00:11:38,570
.قبِلتُ الهديّة سلفًا

181
00:11:38,790 --> 00:11:39,990
!فاتَ أوان النّدم

182
00:11:41,880 --> 00:11:43,130
!وِي لِي

183
00:11:44,800 --> 00:11:47,660
سمعتُ أنّ هُناك سوقًا
.للمهرجان في المدينة غدًا

184
00:11:47,800 --> 00:11:48,860
!لنَذهب معًا

185
00:11:54,470 --> 00:11:55,150
!وِي لِي

186
00:12:45,680 --> 00:12:46,900
ماذا تفعلُون؟

187
00:12:49,410 --> 00:12:51,690
ماذا تعني بسُؤالكَ؟
.زادت هجماتُ الشّياطين مُؤخّرًا

188
00:12:51,700 --> 00:12:53,450
لا بُدّ أنّها رُوح الثّعلب
.الّتي تقفُ وراء ذلك

189
00:12:53,460 --> 00:12:55,700
،تنحَّ جانبًا
.نحن نُنفّذ العدالة

190
00:12:55,880 --> 00:12:57,280
.لن نُؤذي الأبرياء

191
00:12:58,410 --> 00:13:00,710
...إنّها ليست رُوح ثعلبّ
!إنّها جُوان جُوان

192
00:13:00,730 --> 00:13:01,730
.لا طائلَ مِن حديثكَ

193
00:13:02,010 --> 00:13:04,180
رُوح الثّعلب تبقى رُوح
!ثعلبٍ، والآن ابتعِد

194
00:13:05,760 --> 00:13:06,620
!وِي لِي

195
00:13:07,030 --> 00:13:07,840
.جُوان جُوان

196
00:13:08,460 --> 00:13:09,370
.ابقى مكانك

197
00:13:09,400 --> 00:13:10,470
!وِي لِي

198
00:13:18,110 --> 00:13:19,480
!استعدّي للموت

199
00:13:22,710 --> 00:13:24,000
!جُوان جُوان

200
00:13:30,810 --> 00:13:32,700
!وِي لِي

201
00:13:35,100 --> 00:13:36,300
.كفى يا رُوح الثّعلب

202
00:13:37,280 --> 00:13:38,510
هل مِن كلماتٍ أخيرة؟

203
00:13:38,530 --> 00:13:39,640
.انطقِي بها حالًا

204
00:13:39,670 --> 00:13:40,430
...أنتُم

205
00:13:42,760 --> 00:13:43,810
...أنتُم

206
00:13:45,260 --> 00:13:46,460
...أنتُم جميعًا

207
00:13:54,210 --> 00:13:56,290
...يا لها مِن طاقةٍ شيطانيّة هائلة

208
00:13:56,900 --> 00:13:59,790
،أيّها الرّفاق
!لنَقبِض عليها سويّةً

209
00:14:18,900 --> 00:14:20,030
...جُوان جُوان

210
00:14:20,360 --> 00:14:21,690
!اتّخذوا وضع الدّفاع، سريعًا

211
00:14:26,120 --> 00:14:29,050
!جُوان جُوان، لا تفعلِي

212
00:14:34,850 --> 00:14:37,350
!اهدئي، جُوان جُوان

213
00:14:40,780 --> 00:14:41,620
!جُوان جُوان

214
00:14:42,190 --> 00:14:43,950
!توقّفي، جُوان جُوان

215
00:14:46,230 --> 00:14:47,570
!كُفّي عن ذلك

216
00:14:48,530 --> 00:14:50,370
...جُوان جُوان

217
00:14:56,580 --> 00:14:59,220
...وِي لِي

218
00:14:59,250 --> 00:15:00,540
...جُوان جُوان

219
00:15:06,400 --> 00:15:06,990
.كلا

220
00:15:09,870 --> 00:15:12,890
!وِي لِي

221
00:15:32,720 --> 00:15:35,100
هل هذه قمّة فِينغ شُو؟

222
00:15:36,110 --> 00:15:37,270
هل عُدت؟

223
00:15:39,550 --> 00:15:40,150
.مُعلّمي

224
00:15:41,940 --> 00:15:43,070
أين شَاو وِي لِي؟

225
00:15:43,590 --> 00:15:47,190
ذلك الباحث لم يمسّه
.سوءٌ، عادَ إلى الصّرح

226
00:15:48,130 --> 00:15:50,060
شُكرًا لك يا مُعلّمي
.لأنّكَ أنقذته

227
00:15:50,540 --> 00:15:51,930
،أنا... آذيتهُ

228
00:15:52,740 --> 00:15:53,380
أَليس كذلك؟

229
00:15:54,700 --> 00:15:56,450
.لم يبدُر منّي أيّ أذىً لأحدٍ قطّ

230
00:15:56,700 --> 00:15:58,360
لماذا يُريدون القبض عليّ؟

231
00:15:58,710 --> 00:16:00,950
.كُلّ ما أردتهُ حماية وِي لِي

232
00:16:01,700 --> 00:16:03,340
لماذا آلتِ الأمور إلى
هذا الحال؟

233
00:16:04,070 --> 00:16:06,400
،نبّهتكِ مرارًا وتكرارًا أن تتدرّبي

234
00:16:06,610 --> 00:16:08,420
.وذلك لتجنّب مثل هذا اليوم

235
00:16:11,370 --> 00:16:13,180
كلا، عليّ الذّهاب
!للاطمِئنان عليه

236
00:16:13,190 --> 00:16:16,470
ما زلتِ لا تملكينَ السّيطرة
.على طاقتكِ الشيطانيّة

237
00:16:16,490 --> 00:16:20,620
،إذا ذهبتِ إليه هكذا
أَلا تخشينَ تكرار الخطأ ذاتِه؟

238
00:16:21,030 --> 00:16:24,480
خُلق البشر والشّياطين
،وبينهم صدعٌ كبير

239
00:16:24,760 --> 00:16:26,950
،ولن يتقلّص هذا الصّدع

240
00:16:27,370 --> 00:16:30,510
.إلّا بالمُثابرة على التّدريب

241
00:16:32,170 --> 00:16:33,670
.إلى وِي لِي

242
00:16:34,160 --> 00:16:36,590
اصفح عنّي لرحيلِي
.دُون كلمة وداعٍ

243
00:16:37,390 --> 00:16:41,320
عُدت إلى الجبل مع مُعلّمي
.لأُتمّ تدريبِي

244
00:16:41,440 --> 00:16:44,440
لا بُدّ أنّكَ أدركتَ الآن
.أنّني رُوح ثعلبٍ

245
00:16:45,050 --> 00:16:46,600
.ولا شكّ أنّكَ صُدمت

246
00:16:47,570 --> 00:16:50,120
قال مُعلّمي إنّني كُنت
.ضعيفةً للغاية

247
00:16:50,140 --> 00:16:53,060
وإنّني آذيتكَ لأنّني لم
.أستطِع السّيطرة على قُواي

248
00:16:53,070 --> 00:16:53,870
.أنا آسفةٌ

249
00:16:55,350 --> 00:16:56,980
،لا أعلم إن كُنتَ تلُومنِي

250
00:16:57,480 --> 00:16:59,650
أو إن كُنتَ لا تزالُ ترغب
.في أن نكونَ صديقين

251
00:17:00,850 --> 00:17:04,650
يقولُ مُعلّمي إنّ البشر والشّياطين
،خُلقوا وبينهم صدعٌ كبير

252
00:17:04,890 --> 00:17:07,950
ولن يتقلّص هذا الصّدع
.إلّا بالمُثابرة على التّدريب

253
00:17:08,720 --> 00:17:10,100
...سأعملُ بجدٍ

254
00:17:10,790 --> 00:17:13,600
.حتّى نلتقِي مُجدّدًا يومًا ما

255
00:17:17,720 --> 00:17:21,500
أزهرت براعمُ الرّبيع في
.الجبل، إنّها جميلةٌ

256
00:17:21,510 --> 00:17:24,640
أتساءل إن كانت الزّهور
.في الصّرح بذاتِ البهاء

257
00:17:24,810 --> 00:17:27,330
بدأ صيف هذا العام
.مُتأخّرًا عن العادة

258
00:17:27,810 --> 00:17:30,680
أتساءل إن كانَ النّسيم
.في الصّرح بذات الاعتدال

259
00:17:32,820 --> 00:17:34,390
،حلّ الخريف مرّةً أُخرى

260
00:17:35,080 --> 00:17:36,940
...أتساءل إن كانَ هُناك

261
00:17:37,270 --> 00:17:40,200
مَن لا يزالُ بجانبكَ ليَتناول معكَ كعك
.القمر في مهرجان مُنتصف الخريف هذا

262
00:17:42,590 --> 00:17:43,400
.وِي لِي

263
00:17:44,320 --> 00:17:45,950
،في الآونة الأخيرة
.أصبحتُ أُفكّر فيكَ كثيرًا

264
00:17:46,820 --> 00:17:49,750
،علَمتني كيفَ أكتب
،وساعدتني على حفظِ الكُتب

265
00:17:49,870 --> 00:17:51,620
بل وحتّى إنّك كُنت تمنحُني
.حصّتك مِن اللّحم والخُضراوات

266
00:17:52,940 --> 00:17:54,080
...أتساءل

267
00:17:54,990 --> 00:17:56,670
.إن كُنت تُفكّر فيَّ أيضًا

268
00:18:07,500 --> 00:18:11,050
صرحُ يِيشَان التعليميّ

269
00:18:25,590 --> 00:18:26,820
!شُو جُوان جُوان

270
00:18:29,080 --> 00:18:31,380
أيّتها الثّعلبة الصّغيرة
!عديمة الرّحمة

271
00:18:32,250 --> 00:18:34,250
!إذن قرّرتِ العودة أخيرًا

272
00:18:35,330 --> 00:18:38,680
هل... هل كُنت تعلم
أنّني فتاةٌ مُنذ البداية؟

273
00:18:40,270 --> 00:18:42,890
.بدوتِ كفتاةٍ قطعًا

274
00:18:43,090 --> 00:18:44,860
كيف لي ألّا أعلم؟

275
00:18:46,200 --> 00:18:49,610
إذن كيف عرفتَ أنّني...؟

276
00:18:50,380 --> 00:18:52,390
بذلَ وِي لِي جُهودًا
...مُضنية حينذاك

277
00:18:52,400 --> 00:18:54,020
.ليُخفي ذيلكِ

278
00:18:55,320 --> 00:18:57,210
إذن فقد كان وِي لِي
...يعلمُ طوال الوقت

279
00:18:57,820 --> 00:19:00,730
...إذا كان الحال كذلك
...فلماذا يا سيّدي

280
00:19:01,730 --> 00:19:03,730
لماذا لم أكشِف أمركِ؟

281
00:19:05,980 --> 00:19:08,370
...لأنّني رغبتُ في معرفة

282
00:19:08,390 --> 00:19:10,350
...ما إذا كانت تعاليمُ الحُكماء

283
00:19:10,500 --> 00:19:12,850
قادرةً على هداية نفسٍ شيطانيّة
.وإخراجها مِن الظّلمات

284
00:19:13,310 --> 00:19:15,830
هل نجحتُ في ذلك؟

285
00:19:19,530 --> 00:19:20,730
،إنّ تعاليمكَ يا سيّدي

286
00:19:21,430 --> 00:19:23,560
.سأذكُرها طوال حياتي

287
00:19:31,360 --> 00:19:33,250
.إنّه ليس هُنا

288
00:19:38,730 --> 00:19:40,660
،فبعدَ اختفائكِ

289
00:19:40,970 --> 00:19:43,030
بحثَ وِي لِي عنكِ
،في كُلّ مكانٍ

290
00:19:43,220 --> 00:19:45,420
،ليلَ نهار
.بلا راحةٍ أو نومٍ

291
00:19:45,840 --> 00:19:48,530
.حتّى جاء يومًا ليُودّعني

292
00:19:48,930 --> 00:19:50,780
،قال إنّه سيُغادر الصّرح

293
00:19:51,250 --> 00:19:52,860
،وإنّه مهما بعُدت المسافة

294
00:19:52,870 --> 00:19:54,430
.فسوفَ يجدكِ

295
00:19:55,410 --> 00:19:58,280
.وصلت رسالتكِ بعد أن غادر

296
00:19:59,420 --> 00:20:00,670
،ومُنذ ذلك الحين

297
00:20:00,850 --> 00:20:03,060
.لم أسمع عنه شيئًا

298
00:20:19,730 --> 00:20:22,700
صرحُ يِيشَان التعليميّ

299
00:20:31,300 --> 00:20:35,210
،أن يعودَ وِي لِي مِن مكانٍ بعيد"
".يا لها مِن بهجةٍ لا تُوصف

300
00:21:33,440 --> 00:21:34,610
.لِي شِياو

301
00:21:43,390 --> 00:21:50,030
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

302
00:21:50,400 --> 00:21:58,910
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

303
00:22:00,840 --> 00:22:05,560
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

304
00:22:05,590 --> 00:22:08,430
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

305
00:22:10,270 --> 00:22:14,130
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

306
00:22:14,150 --> 00:22:17,860
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

307
00:22:18,540 --> 00:22:22,700
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

308
00:22:23,250 --> 00:22:27,480
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

309
00:22:27,970 --> 00:22:33,150
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

310
00:22:33,180 --> 00:22:36,560
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

311
00:22:37,310 --> 00:22:42,290
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

312
00:22:42,320 --> 00:22:46,790
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

313
00:22:46,810 --> 00:22:51,780
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

314
00:22:51,810 --> 00:22:56,270
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

315
00:23:01,430 --> 00:23:06,980
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟