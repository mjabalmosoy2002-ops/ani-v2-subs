1
00:00:15,330 --> 00:00:22,320
،تتساقطُ الأزهار في أَحلامي ♪
♪ .ثُمّ تستحيلُ عدمًا

2
00:00:22,330 --> 00:00:30,030
بهاءُ العالم أَجمع، يفنى حين ♪
♪ .نَصحو، كما تفنى كُلّ الأشياء

3
00:00:30,040 --> 00:00:36,450
♪ ،بخُطىً مُثقلةٍ وعجولة ♪

4
00:00:36,460 --> 00:00:41,830
،نتوقُ إلى القُوّة والمجد ♪
♪ .دُون أن نتركَ مجالًا للتّراجع

5
00:00:43,500 --> 00:00:50,570
مَن ذا الّذي استسلمَ للأهواء ♪
♪ وجعلها تحجبُ بصيرته؟

6
00:00:50,580 --> 00:00:58,320
،نشعرُ بالرّضا ♪
♪ .لكنّنا نَضلّ الطّريق مُجدّدًا

7
00:00:58,330 --> 00:01:05,070
،إن تبسّمنا في الرّخاء والبلاء ♪
♪ .فلن نخشى الموت

8
00:01:05,080 --> 00:01:10,460
،تبقى الأمور على حالها ♪
♪ .بينما أرى حقيقةَ العالم

9
00:01:11,330 --> 00:01:18,620
،أنا أتمسّك بالعدالة ♪
♪ .رُغم أنّ القُلوب صعبة الانقياد

10
00:01:18,630 --> 00:01:25,370
،حتّى لو خسرتُ كُلّ شيءٍ ♪
♪ .سأَفعلُ كُلّ ما يلزم

11
00:01:25,380 --> 00:01:31,620
،أشقّ طريقي عبرَ العاصفة ♪
♪ .مُقدمًا الخلاص لنفسي وللآخرين

12
00:01:31,630 --> 00:01:38,500
،حتّى لو تِهتُ في الظّلام ♪
♪ .فلن أَتراجع أبدًا

13
00:01:59,070 --> 00:02:01,570
!دارُ شِينغ هَان

14
00:02:07,620 --> 00:02:08,880
!تبًا لك أيّها المُعلّم

15
00:02:08,910 --> 00:02:11,080
.دائمًا ما تُلقي بالمتاعب عليّ

16
00:02:12,330 --> 00:02:15,440
،يا ذات الشّعر الأجعد
.لديّ عملٌ رائع مِن أجلكِ

17
00:02:15,450 --> 00:02:18,150
،فقدت عائلةٌ فتاةً
،اعثُري عليها

18
00:02:18,160 --> 00:02:20,620
وحينها سيَبلغُ رصيد إنجازاتكِ
.السنويّ حدّ الكمال

19
00:02:27,540 --> 00:02:29,120
مَن ذا الّذي يُمكنه التعرّف عليها؟

20
00:02:29,660 --> 00:02:36,510
...ماءٌ

21
00:02:37,910 --> 00:02:38,770
.أيّها الفتى

22
00:02:38,790 --> 00:02:41,160
هل تعرفُ طريقَ دار شِينغ هَان؟

23
00:02:42,620 --> 00:02:46,820
...ماءٌ

24
00:02:46,840 --> 00:02:48,440
ماذا تفعل؟ لم أجلب معِي
.قِربة الماء الخاصّة بي

25
00:02:48,450 --> 00:02:51,570
.اهدأ، أنا أسألُ عن الطّريق فحسب -
.ماءٌ -

26
00:02:53,510 --> 00:02:55,360
.تأمّل ما فعلتهُ بي

27
00:02:55,370 --> 00:02:56,890
لولا أنّ المُعلّم حذّرني
...مرارًا وتكرارًا

28
00:02:56,900 --> 00:02:58,360
،ألّا أستخدم السّحر على البشر

29
00:02:58,370 --> 00:02:59,230
...لكنتُ قد

30
00:02:59,500 --> 00:03:03,290
!ماءٌ

31
00:03:04,170 --> 00:03:06,110
،أيّها الفتى
.كُفّ عن التّقدم

32
00:03:06,140 --> 00:03:07,330
!هذا خطِرٌ

33
00:03:09,990 --> 00:03:11,330
!توقّف

34
00:03:12,790 --> 00:03:13,750
!ماءٌ

35
00:03:18,500 --> 00:03:19,250
مَن هُناك؟

36
00:03:33,320 --> 00:03:36,070
أيّ مخلوقةٍ شرّيرة هذه الّتي
تتجرّأ على أذيّة النّاس في الجوار؟

37
00:03:37,370 --> 00:03:39,120
،أيّها الأخ
.أنا لم أقتل أحدًا

38
00:03:39,140 --> 00:03:41,000
.كُنت أسألُ عن الاتّجاهات فحسب

39
00:03:41,200 --> 00:03:42,320
كيف تتجرّأين على الإنكار؟

40
00:03:42,690 --> 00:03:44,120
.رأيتكِ تُهاجمينه

41
00:03:51,570 --> 00:03:52,000
...أنتِ

42
00:03:54,250 --> 00:03:55,750
.هُو مَن هاجمني أولًا

43
00:03:57,040 --> 00:03:58,200
.هُناك خطبٌ ما به

44
00:03:58,210 --> 00:03:59,620
.لا تعترِض طريقي

45
00:04:00,620 --> 00:04:02,630
هل رأيتَ ما حدث؟

46
00:04:28,820 --> 00:04:32,220
ألم يُعلّمكِ مُعلّمكِ كيفية استخدام
تعويذة الحِماية مِن الماء؟

47
00:04:37,000 --> 00:04:39,580
.شُكرًا لك

48
00:04:39,950 --> 00:04:41,010
.اتبعيِني بحذرٍ

49
00:04:45,400 --> 00:04:46,080
.إلى ذاك الاتّجاه

50
00:04:53,370 --> 00:04:56,080
ماذا يجري؟
لماذا لا يُمكننا سحبُه؟

51
00:04:56,500 --> 00:04:58,370
هل هُناك شيءٌ عالق؟

52
00:05:07,680 --> 00:05:09,480
.ليس ثمّة تشابكٌ ظاهر

53
00:05:16,700 --> 00:05:17,500
ما الخطب؟

54
00:05:21,000 --> 00:05:21,540
!لنَذهب

55
00:05:55,370 --> 00:05:58,700
لِمَ تظنّ أنّ الزّهور
تنبتُ في عينيه؟

56
00:06:01,080 --> 00:06:02,330
هل ما زالَ على قيدِ الحياة؟

57
00:06:02,870 --> 00:06:04,790
هل يُمكن أن يكونَ
شيطان زُهورٍ؟

58
00:06:11,450 --> 00:06:12,670
...حسنًا

59
00:06:12,700 --> 00:06:13,340
...أَتُراكَ

60
00:06:14,500 --> 00:06:15,740
أَتُراكَ تعرفني؟

61
00:06:19,950 --> 00:06:21,080
...هل هذا أنت

62
00:06:22,370 --> 00:06:23,420
يا وِي لِي؟

63
00:06:29,620 --> 00:06:31,790
.وِي لِي، إنّه أنت حقًا

64
00:06:32,040 --> 00:06:33,100
ألا تذكُرني؟

65
00:06:33,110 --> 00:06:34,570
.أنا شُو جُوان جُوان

66
00:06:34,830 --> 00:06:37,150
درسنا معًا في صرح يِيشان
.التعليميّ لمُدّة عامٍ

67
00:06:37,150 --> 00:06:38,290
هل نسيت؟

68
00:06:39,620 --> 00:06:42,020
أنا تلميذٌ مُبجّل في
.قصر تيَان يُو

69
00:06:42,080 --> 00:06:44,940
كيف لي أن أعرفَ شيطانة
ثعلبٍ صغيرة مثلكِ؟

70
00:06:44,950 --> 00:06:46,740
،حاول أن تتذكّر

71
00:06:46,830 --> 00:06:48,750
...أخبرني السيّد شُو

72
00:06:49,500 --> 00:06:51,230
،أنّك كُنت تبحث عنّي
...أنت

73
00:06:58,820 --> 00:06:59,560
،حسنًا

74
00:07:00,380 --> 00:07:01,440
.لن أُزعجك

75
00:07:05,120 --> 00:07:06,450
هل أنتِ راحلةٌ؟

76
00:07:06,460 --> 00:07:10,170
.قُلتَ إنّك لا تعرفني

77
00:07:11,160 --> 00:07:12,940
إذن، لأنّني قلتُ إنّني
لا أعرفكِ، ستَرحلين؟

78
00:07:12,950 --> 00:07:15,660
،شُو جُوان جُوان
!أيّتها الثّعلبة الغبيّة

79
00:07:16,290 --> 00:07:17,950
.أنا لستُ غبيّةً

80
00:07:19,660 --> 00:07:22,070
إذن لماذا لم تتعرّفي
عليّ مِن النّظرة الأولى؟

81
00:07:22,080 --> 00:07:24,010
حتّى أنّكِ سألتنِي
.إن كُنت أتذكّركِ

82
00:07:24,790 --> 00:07:26,910
.أصغِي إليّ جيّدًا

83
00:07:28,370 --> 00:07:30,160
.لا تترُكيني وحدي مُجدّدًا

84
00:07:40,060 --> 00:07:42,530
،جُوان جُوان
.أنا لا ألومكِ

85
00:07:42,750 --> 00:07:43,400
.لا تبكي

86
00:07:43,710 --> 00:07:48,750
.ظننتُ أنّك نسيتَني

87
00:07:50,080 --> 00:07:52,230
...هل تعلمُ كم اجتهدتُ في

88
00:07:52,260 --> 00:07:53,990
التّدريب لأراكَ؟

89
00:07:54,000 --> 00:07:57,850
هل تعلمُ كم كانت معيشتِي بائسةً
وأنا أُعذّب على يدِ ذلك العنقاء العجوز؟

90
00:07:55,920 --> 00:07:57,850
.حسنًا

91
00:07:58,870 --> 00:08:00,080
.أنا جائعةٌ

92
00:08:06,580 --> 00:08:07,360
.وِي لِي

93
00:08:07,710 --> 00:08:08,740
...هل نبتت زهرةُ

94
00:08:08,770 --> 00:08:11,500
اللّوتس الحمراء تلك
مِن عيني الفتى؟

95
00:08:12,540 --> 00:08:15,390
،جُوان جُوان
...هل حدثَ أيّ شيءٍ

96
00:08:15,620 --> 00:08:16,820
غير مُعتادٍ عندما قابلتِيه؟

97
00:08:17,400 --> 00:08:19,970
،كان يستمرّ في طلبِ الماء

98
00:08:20,200 --> 00:08:22,330
.لذا ظننتُ أنّه عطشانٌ

99
00:08:23,250 --> 00:08:24,040
ماءٌ؟

100
00:08:24,540 --> 00:08:25,340
...هل يُمكن أن يكون

101
00:08:27,080 --> 00:08:28,040
،قبل بضعة أيّامٍ

102
00:08:29,450 --> 00:08:31,950
اقتحم فتى في مثل
.عُمره قصر تيَان يُو

103
00:08:33,000 --> 00:08:35,000
،كان كفيفَ البصر
.مسلوبَ العقل

104
00:08:35,650 --> 00:08:38,120
لم يكن بمَقدوره سِوى القول
.إنّه مِن دار شِينغ هَان

105
00:08:38,400 --> 00:08:39,800
،حيثُ حلّت شُرور الشّياطين

106
00:08:40,150 --> 00:08:42,330
وأنّه ما نجا إلّا بعدَ
.أن فقأَ عينيه بيده

107
00:08:42,830 --> 00:08:44,170
...وطلبَ منّا الذّهاب إلى هُناك

108
00:08:44,200 --> 00:08:46,250
.لإنقاذ شخصٍ يُدعى بَاو رُونغ

109
00:08:47,120 --> 00:08:48,900
عندما كُنّا على وشك
،إرساله لتلقّي العلاج

110
00:08:48,910 --> 00:08:50,240
.جُنّ جُنونه فجأةً

111
00:08:50,600 --> 00:08:52,860
ولم يكفّ عن الصّياح
،طلبًا للماء

112
00:08:53,260 --> 00:08:54,980
.ثُمّ اندفعَ راكضًا نحو الشّلال

113
00:08:54,990 --> 00:08:56,650
لم نتمكّن مِن لحاقه
.في الوقت المُناسب

114
00:08:56,870 --> 00:08:59,070
.جرفهُ الماء أمام أعيُننا

115
00:09:00,290 --> 00:09:02,100
...ثُمّ لمحتُ زهرةً حمراء

116
00:09:02,110 --> 00:09:03,910
.ترتفعُ من بين الشّلال

117
00:09:05,000 --> 00:09:08,460
لكن التّيار كان قويًا
.جدًا، فانجرفت سريعًا

118
00:09:08,780 --> 00:09:10,440
،لم أُلقِ لها بالًا آنذاك

119
00:09:10,450 --> 00:09:13,440
واتّبعتُ الأوامر للمجيء
.والتّحقيق في دار شِينغ هَان

120
00:09:13,450 --> 00:09:14,450
،أمّا الآن

121
00:09:15,330 --> 00:09:17,390
فيَبدو أنّ كِلا الأمرين
.مُرتبطان حتمًا

122
00:09:18,040 --> 00:09:21,070
،بمُجرّد أن نعبرَ هذه الغابة
.سنَكون بالقُرب مِن دار شِينغ هَان

123
00:09:21,080 --> 00:09:23,080
ومِن المُرجّح أنّ ذلك الفتى
.قد جاء مِن هُناك أيضًا

124
00:09:23,910 --> 00:09:25,840
.أنا متّجهةٌ إلى دار شِينغ هَان

125
00:09:25,950 --> 00:09:28,810
أرسلنِي مُعلّمي لإنقاذ فتاةٍ
.تُدعى بِي يُون جوُاو

126
00:09:29,120 --> 00:09:31,580
ما طبيعةُ هذا المكان
الّذي يُدعى دار شِينغ هَان؟

127
00:09:31,790 --> 00:09:33,590
وما الّذي يجعلُ الجميع
يتهافتونَ عليه؟

128
00:09:34,040 --> 00:09:35,410
،فيما يخصّ دار شِينغ هَان

129
00:09:35,430 --> 00:09:37,080
.فلا علمَ لي بها سِوى الأقاويل

130
00:09:38,290 --> 00:09:39,780
يُقال إنّه قبل أربعةٍ
،وعشرين عامًا

131
00:09:40,370 --> 00:09:42,490
التقى سيّد الدّار العجوز
،هَان شيَان بخالدٍ مُصادفةً

132
00:09:42,500 --> 00:09:44,990
،وحصلَ منه على دواءٍ سحريّ
.وهُو بذرةُ اللّوتس الحمراء

133
00:09:45,000 --> 00:09:47,650
تُنتج اللّوتس الحمراء
.اثنتي عشرةَ بذرةً سنويًا

134
00:09:47,660 --> 00:09:49,490
،وفي كُلّ سنةٍ
...تحتفظُ عائلة هَان

135
00:09:49,500 --> 00:09:50,830
.بستّةٍ لأنفسها

136
00:09:51,560 --> 00:09:55,860
دارُ شِينغ هَان

137
00:09:51,750 --> 00:09:54,120
،ومُنذ ذلك الحين
.لم يبلغُوا مرحلةَ الشّيخوخة

138
00:09:55,140 --> 00:09:57,220
،أمّا الستّة الأخرى فتُباع

139
00:09:57,250 --> 00:09:58,490
.بألفِ قطعةٍ ذهبيّة للواحدة

140
00:09:58,500 --> 00:09:59,740
،في كُلّ سنةٍ بمثل هذا الوقت

141
00:09:59,750 --> 00:10:02,810
تتقاتلُ العائلات النّبيلة مِن جميع أنحاء
.تسَانغ شوُاو للحُصول على بذرةٍ واحدة

142
00:10:02,870 --> 00:10:04,720
...جِئتُ إلى دار شِينغ هَان

143
00:10:04,730 --> 00:10:06,540
آملًا في الحُصول على
،بذرةِ لوتسٍ حمراء

144
00:10:06,560 --> 00:10:07,530
مِن أجل كبيرٍ لنا
.يُعاني مِن مرضٍ عُضال

145
00:10:07,540 --> 00:10:10,410
...بذرةُ لوتسٍ حمراء
...زهرةٌ حمراء

146
00:10:10,660 --> 00:10:11,330
...هل يُمكن أن يكون

147
00:10:11,700 --> 00:10:13,250
،مِن السّابق لأوانه قولُ ذلك

148
00:10:13,910 --> 00:10:16,710
ولكن ثمّة خطبًا في
.دار شِينغ هَان

149
00:10:17,910 --> 00:10:19,570
.لنَرتح هُنا لهذه اللّيلة

150
00:10:19,870 --> 00:10:21,600
ومع إشراقة الصّباح
.الأولى، سنَنطلق

151
00:10:22,330 --> 00:10:24,590
هِمتُ في هذه الغابة
.طوالَ اليوم

152
00:10:24,830 --> 00:10:27,490
،لم يقشعِ الضّباب بعد
!وهُناك رائحةٌ غريبة

153
00:10:27,500 --> 00:10:30,560
مهما فعلتُ، لا يُمكنني العُثور
.على الطّريق إلى دار شِينغ هَان

154
00:10:30,660 --> 00:10:32,190
.لا تقلقِي، أنا معكِ

155
00:10:47,200 --> 00:10:48,730
.الضّباب يزدادُ كثافةً

156
00:10:49,040 --> 00:10:50,300
.هذا حاجزٌ ضبابيّ

157
00:10:50,660 --> 00:10:52,330
.يتعيّن علينا أن نتوخّى الحذر

158
00:10:52,790 --> 00:10:55,450
لا عجبَ أنّ تشَاو تشِي اضطرّ إلى
.إعماءِ نفسه ليَتمكّن مِن الهرب

159
00:10:55,830 --> 00:10:58,160
،وِي لِي
.أصبحتَ قويًا للغاية

160
00:10:58,540 --> 00:11:01,140
كيف صِرتَ تلميذًا
في قصر تيَان يُو؟

161
00:11:03,380 --> 00:11:05,460
...ألم يكُن سببُ ذلك
لأجل العُثور عليكِ؟

162
00:11:05,910 --> 00:11:07,120
للعُثور عليّ؟

163
00:11:08,160 --> 00:11:10,490
أتباعُ قصر تيَان يُو موجودونَ
.في كُلّ حدبٍ وصوب

164
00:11:10,910 --> 00:11:13,840
،فهُم يتعاملونَ مع الأرواح
.والشّياطين، والوحوش مرارًا

165
00:11:14,370 --> 00:11:16,580
،ظننتُ أنّني إذا انضممتُ إليهم

166
00:11:17,080 --> 00:11:18,140
...فرُبّما

167
00:11:18,580 --> 00:11:20,580
.تتيسّر لي معرفةُ أخباركِ

168
00:11:23,160 --> 00:11:25,040
،لذلك تعلّقتُ بمُعلّمي

169
00:11:25,370 --> 00:11:28,370
،سيّد القصر شيَاو يُوان شَان نفسه

170
00:11:28,870 --> 00:11:31,000
.ورجوتهُ حتّى قبِلني في النّهاية

171
00:11:32,950 --> 00:11:34,410
...وِي لِي

172
00:11:35,210 --> 00:11:37,890
...وِي لِي، في الحقيقة أنا

173
00:11:37,910 --> 00:11:39,910
جُوان جُوان، أعتقدُ أنّنا
.تمكنّا مِن الخُروج

174
00:11:54,370 --> 00:11:56,910
...ماءٌ... ماءٌ

175
00:11:59,830 --> 00:12:01,000
...يُواليَان

176
00:12:01,700 --> 00:12:02,960
.استمرّي في السّير بذلك الاتّجاه

177
00:12:03,000 --> 00:12:04,200
.هُناك ماءٌ

178
00:12:05,090 --> 00:12:08,090
.أمّا نجاتُكِ فتعتمدُ على قدركِ

179
00:12:11,180 --> 00:12:14,140
...ماءٌ... ماءٌ

180
00:12:21,110 --> 00:12:24,000
دارُ شِينغ هَان

181
00:12:24,580 --> 00:12:25,520
.هذا هُو المكان

182
00:12:27,210 --> 00:12:28,000
...أنتُما

183
00:12:28,690 --> 00:12:30,700
كيف عبرتُما مِن خلال الضّباب؟

184
00:12:32,230 --> 00:12:34,030
...نحنُ

185
00:12:34,040 --> 00:12:35,450
هل لي أن أسألَ مَن أنتِ؟

186
00:12:35,830 --> 00:12:38,360
عديمُ الفائدة! لا يُمكنكَ
.حتّى مُراقبة شخصٍ واحد

187
00:12:38,500 --> 00:12:40,650
،هربَ أحدهم بالأمس
.واليوم يهربُ آخر

188
00:12:40,660 --> 00:12:43,200
ألا تعلمُ أنّ هذا قد
يُفسد كُلّ شيءٍ؟

189
00:12:43,230 --> 00:12:44,710
،كما العادة
.يقعُ اللّوم عليّ في كُلّ مأزقٍ

190
00:12:44,720 --> 00:12:45,460
.لا تلتفِتا إلى جِدالهما

191
00:12:45,860 --> 00:12:47,100
.هذا المكان ملعونٌ

192
00:12:47,600 --> 00:12:49,330
مِن الأفضل لكُما أن
.ترحلاَ ما دُمتما قادِرين

193
00:12:52,870 --> 00:12:55,670
لا تظنّ أنّني أجهلُ
.ما تصبو إليه

194
00:12:55,920 --> 00:12:56,960
!كفانا جدالًا

195
00:12:56,990 --> 00:12:58,590
.رُبّما لم يبتعدا كثيرًا

196
00:12:59,540 --> 00:13:00,660
مَن تكُونان أنتُما؟

197
00:13:01,790 --> 00:13:02,530
.أنا شَاو وِي لِي

198
00:13:02,540 --> 00:13:04,000
.وأنا شُو جُوان جُوان

199
00:13:04,620 --> 00:13:06,880
قدِمنا إلى هُنا طلبًا
.لبذرة اللّوتس الحمراء الشّهيرة

200
00:13:07,330 --> 00:13:08,780
كيف تمكّنتما مِن عُبور الضّباب؟

201
00:13:08,790 --> 00:13:11,200
تمهّل، سأَتولى أنا
.زِمام هذه المسألة

202
00:13:11,230 --> 00:13:12,730
...ماذا؟ أنت تتجرّأ

203
00:13:13,020 --> 00:13:15,060
.لا تكُن فظًا أمام الضيفان

204
00:13:18,580 --> 00:13:19,940
.أنا هَان بَاو يُوان

205
00:13:19,950 --> 00:13:22,450
المعذرة، لم أُفلِح في
.تقويم سُلوك ابني

206
00:13:23,330 --> 00:13:25,400
إذن، أنت هُو السيّد
.الشّاب، يُسعدني لقاؤكَ

207
00:13:25,410 --> 00:13:27,070
.وصلتُما في الوقت المثاليّ

208
00:13:27,080 --> 00:13:28,470
...بذرة اللّوتس الحمراء لهذا العام

209
00:13:28,480 --> 00:13:30,150
.ستكونُ جاهزةً للحصاد غدًا

210
00:13:30,160 --> 00:13:32,500
لماذا لا تبيتانِ اللّيلة؟

211
00:13:34,290 --> 00:13:36,620
.ممتنٌّ لك -
.ممتنةٌّ لك -

212
00:13:38,290 --> 00:13:40,360
في العادة، كان والدي
.سيُرحّب بالضّيوف بنفسه

213
00:13:40,370 --> 00:13:42,900
،لكنّه ليس بخيرٍ
.ولا يُمكنه استقبالُ أحدٍ

214
00:13:43,700 --> 00:13:45,830
أرجو أن تنقلَ تحيّاتنا
.إلى السيّد هَان

215
00:13:46,070 --> 00:13:47,280
.بالطّبع، بالطّبع

216
00:13:50,850 --> 00:13:54,270
أيّها السيّد الشّاب، لاحظتُ أنّه
.لا يُوجد أيّ خدمٍ في الأرجاء

217
00:13:55,540 --> 00:13:57,120
هذا القصر يقعُ في
.وادٍ جبليّ

218
00:13:57,130 --> 00:13:59,070
،وفي كُلّ صيفٍ
.يرتفعُ الضّباب كثيفًا

219
00:13:59,080 --> 00:14:00,610
.ويُصبح السّفر صعبًا

220
00:14:00,850 --> 00:14:02,410
تخلو هذه الفترة مِن العام
.مِن أيّ أحداثٍ تُذكر

221
00:14:02,420 --> 00:14:04,600
.لذلكَ أرسلتُ الخدم إلى منازلهم

222
00:14:05,750 --> 00:14:08,350
قبل قليلٍ، سمعتُ أنّك كُنت
.تبحثُ عن شخصٍ ما

223
00:14:09,260 --> 00:14:10,960
...سرقت خادمةٌ بعض المُقتنيات

224
00:14:10,980 --> 00:14:12,240
.الثّمينة وهربت

225
00:14:12,250 --> 00:14:13,580
.أنا أبحثُ عنها الآن

226
00:14:13,660 --> 00:14:15,520
هل رأيتُما أيّ شخصٍ مشبوه؟

227
00:14:15,910 --> 00:14:16,750
.لم نرَ أحدًا

228
00:14:17,950 --> 00:14:19,710
...لكنّنا قابلنا

229
00:14:19,730 --> 00:14:21,290
.فتىً غريبًا في الغابة

230
00:14:22,550 --> 00:14:24,280
لعلّه مِن أتباعكُم؟

231
00:14:26,200 --> 00:14:27,080
كُم عُمره؟

232
00:14:28,700 --> 00:14:30,200
حوالي أحدَ عشر
.أو اثني عشرَ عامًا

233
00:14:30,790 --> 00:14:31,940
هل يُمكن أن يكونَ وَان زِي؟

234
00:14:33,370 --> 00:14:35,390
إنّه يُعاني مِن مرضٍ
.عقليّ وقد هرب

235
00:14:35,450 --> 00:14:37,980
،كُنت قلقًا
.ولا أعلمُ كيف حاله

236
00:14:39,370 --> 00:14:40,630
،وقعَ في النّهر

237
00:14:40,950 --> 00:14:42,300
.ولم نتمكّن مِن إنقاذه

238
00:14:45,060 --> 00:14:46,600
...يا لهُ مِن طفلٍ مسكين

239
00:14:47,290 --> 00:14:50,420
،أغفلنا مُراقبته
.وهذا خطأٌ فادح

240
00:14:54,620 --> 00:14:57,910
!بَاو رُونغ
!أقبِلي ورحّبي بالضّيفين

241
00:15:00,160 --> 00:15:02,540
،تلك الشقيّة
أين ذهبت يا تُرى؟

242
00:15:02,620 --> 00:15:04,830
،أيّها السيّد الشّاب
هل بَاو رُونغ هِي...؟

243
00:15:05,540 --> 00:15:06,600
،إنّها أُختي الصّغرى

244
00:15:06,740 --> 00:15:09,070
وهِي المسؤولةُ عن أماكن
.إقامة الضّيوف

245
00:15:17,330 --> 00:15:18,440
.سأذهبُ لأجدها

246
00:15:18,450 --> 00:15:19,590
.قطعتُما طريقًا طويلًا

247
00:15:19,600 --> 00:15:21,080
.أرجو أن ترتاحا وتستعِيدا نشاطكُما

248
00:15:34,770 --> 00:15:36,270
.أنا مرهقةٌ

249
00:15:38,620 --> 00:15:41,620
بعد سماعِ ما قاله
السيّد الشّاب، ما رأيكِ؟

250
00:15:42,380 --> 00:15:43,690
وماذا هُناك لنُفكّر فيه؟

251
00:15:43,700 --> 00:15:45,110
.حديثهُ محضُ أكاذيب

252
00:15:45,120 --> 00:15:47,250
.لا أعتقدُ أنّ ذلك كان مرضًا

253
00:15:48,080 --> 00:15:50,900
يبدو جليًا أنّه يسعى للتكتّم
.عن الخطب الّذي يحدثُ هُنا

254
00:15:50,910 --> 00:15:54,110
حتّى إنّه تظاهرَ بأنّ الحاجز
.الضبابيّ مُجرّد ضبابٍ موسميّ

255
00:15:55,000 --> 00:15:57,400
وعندما أخبرتهُ أنّ الفتى
،في الغابة قد ماتَ

256
00:15:57,910 --> 00:15:59,040
.بدا مُرتاحًا

257
00:15:59,190 --> 00:16:01,150
هل عساهُ يكون العقلَ
المُدبّر وراء هذا كُلّه؟

258
00:16:01,660 --> 00:16:03,580
.ليس بمَقدورنا الجزمُ بذلك الآن

259
00:16:04,140 --> 00:16:07,140
ذلك السيّد الشّاب يبدو في
،الثّلاثين مِن عُمره على الأكثر

260
00:16:07,620 --> 00:16:09,220
.لكنّه يتحدّث كرجلٍ عجوز

261
00:16:09,600 --> 00:16:11,150
.كما أنّ ابنه كان أكثرَ غرابةً

262
00:16:11,160 --> 00:16:13,150
كان كما لو أنّه هُو
،مَن يُوبّخ والده

263
00:16:13,160 --> 00:16:14,650
.وليس العكس

264
00:16:16,620 --> 00:16:19,350
تستخدمُ عائلة هَان بُذور اللّوتس
،الحمراء للحفاظ على الشّباب

265
00:16:19,620 --> 00:16:21,280
لذلك رُغم أنّ مظهرهُم
،يبدو شابًا

266
00:16:21,410 --> 00:16:22,960
إلّا أن تصرّفاتهم تبدو
.وكأنّها تعودُ لقُرونٍ مضت

267
00:16:23,280 --> 00:16:26,080
ومع ذلك، كانت
.بشرتهُم شاحبةً جدًا

268
00:16:26,900 --> 00:16:27,500
،بالمُناسبة

269
00:16:27,720 --> 00:16:29,820
مَن تلك الآنسة الّتي
قابلناها عند البوّابة؟

270
00:16:30,330 --> 00:16:31,460
،طلبت منّا الرّحيل

271
00:16:31,550 --> 00:16:33,410
لكن هَان بَاو يُوان
.أصرّ على بقائِنا

272
00:16:37,200 --> 00:16:38,330
.طعامكُما، أيّها الضّيفان

273
00:16:41,770 --> 00:16:43,810
،أيّتها الفتاة الصّغيرة
هل أنتِ بَاو رُونغ؟

274
00:16:48,660 --> 00:16:50,700
هل تعرفينَ فتىً
يُدعى تشَاو تشِي؟

275
00:16:51,370 --> 00:16:52,660
في مثل عُمركِ؟

276
00:16:53,990 --> 00:16:56,320
،أيّها الضّيفان المُوقّران
.أعددتُ النّبيذ الخفيف

277
00:16:56,330 --> 00:16:58,060
.أرجو المجيء إلى قاعة الزّهور

278
00:17:01,250 --> 00:17:02,850
،أيّها السيّد الشّاب
.هذا لطفٌ بالغ منك

279
00:17:03,660 --> 00:17:04,590
.مِن هذا الاتّجاه

280
00:17:05,610 --> 00:17:06,820
!أخيرًا، الطّعام

281
00:17:07,500 --> 00:17:09,820
،أيّتها الأُخت الصّغرى
...لنذهب معًا

282
00:17:09,990 --> 00:17:11,430
إلى أين ذهبت؟

283
00:17:20,910 --> 00:17:22,950
.تفضّلا بالجُلوس في أيّ مكانٍ

284
00:17:24,040 --> 00:17:25,640
،أيّها السيّد الشّاب
.أنت كريمٌ جدًا

285
00:17:36,290 --> 00:17:39,000
هذه الآنسة الّتي كانت
...هُنا مُنذ لحظةٍ

286
00:17:40,200 --> 00:17:42,370
،هِي أُختي التّوأم
.هَان بَاو رُونغ

287
00:17:43,040 --> 00:17:44,620
.ذكرتُها مِن قبل

288
00:17:44,910 --> 00:17:47,330
.هِي تُدير أماكن إقامة الضّيوف

289
00:17:47,950 --> 00:17:48,580
...أيّها الأخ الأكبر

290
00:17:49,200 --> 00:17:50,540
ما الخطب؟

291
00:17:51,870 --> 00:17:52,770
،لأكونَ صادقًا

292
00:17:53,040 --> 00:17:55,360
أحضرت فتاةٌ الوجبات
.الخَفيفة إلى غُرفتنا آنفًا

293
00:17:55,370 --> 00:17:57,170
وقد افترضنا أنّها
.الآنسة بَاو رُونغ

294
00:17:57,700 --> 00:17:59,360
.لكن لا بُدّ أنّنا كُنّا مُخطِئين

295
00:17:59,700 --> 00:18:01,150
!لا شكّ أنّك تمزح

296
00:18:01,370 --> 00:18:03,570
التقيتُما بكُلّ مَن يقطنُ
،هذه الدّار

297
00:18:03,580 --> 00:18:05,180
ولا وُجودَ لأيّ فتاةٍ
.شابّة غيرها

298
00:18:05,200 --> 00:18:06,400
.نحن على يقينٍ تامّ

299
00:18:06,620 --> 00:18:08,320
،كان طُولها تقريبًا هكذا

300
00:18:08,330 --> 00:18:10,160
،وترتدي ثيابًا ورديّة
.وتبدو في غاية اللّطافة

301
00:18:12,450 --> 00:18:15,330
رُبّما هِي طفلةٌ مِن القرية
.تسلّلت للّعب

302
00:18:16,270 --> 00:18:18,320
تذكّرتُ لتوّي شأنًا يتعيّن
.عليّ قضاؤُه

303
00:18:18,330 --> 00:18:20,860
،تمتّعا بالمائدة
.سأعودُ بعد هُنيهةٍ

304
00:18:24,220 --> 00:18:26,110
...لِمَ قد يُصيبه الذّعر

305
00:18:26,120 --> 00:18:27,750
مِن ذكر فتاةٍ صغيرة؟

306
00:18:28,250 --> 00:18:30,120
هل تظنّ أنّه مضى
يقتفِي أثرها؟

307
00:18:31,220 --> 00:18:31,930
.مِن المُحتمل ذلك

308
00:18:33,160 --> 00:18:33,830
،ثُمّ

309
00:18:34,290 --> 00:18:36,710
إنّه زعمَ أنّنا التقينا
،بجميع مِن في الدّار

310
00:18:37,330 --> 00:18:38,660
ألا تجدين ذلك مُريبًا؟

311
00:18:39,500 --> 00:18:42,400
،مُنذ وصولنا
،رأينا هَان بَاو يُوان

312
00:18:42,700 --> 00:18:43,910
،ومَن يُدعى ابنه

313
00:18:44,140 --> 00:18:45,830
،وأُخته هَان بَاو رُونغ

314
00:18:46,040 --> 00:18:47,970
.وفتاةٌ صغيرة واحدة مجهولةُ الهويّة

315
00:18:48,750 --> 00:18:50,010
...لكن هُناك شخصًا واحدًا

316
00:18:50,120 --> 00:18:51,620
.لم نرهُ على الإطلاق

317
00:18:52,330 --> 00:18:53,080
مَن؟

318
00:18:53,200 --> 00:18:54,710
...سيّد الدّار العليل

319
00:18:54,720 --> 00:18:56,230
الّذي لا يقدرُ على
،استقبال الضّيوف

320
00:18:56,750 --> 00:18:57,660
.هَان شيَان

321
00:18:59,830 --> 00:19:01,190
،أنتُما جريئانِ بالفِعل

322
00:19:01,580 --> 00:19:02,710
أَلم ترحلا بعد؟

323
00:19:04,830 --> 00:19:05,690
.الآنسة بَاو رُونغ

324
00:19:05,700 --> 00:19:07,360
لا يخفى عليّ أنّكما
.تملِكان قُدراتٍ خاصّة

325
00:19:07,700 --> 00:19:09,030
إن استطعتُما اختراقَ
،الحاجز الضبابيّ

326
00:19:09,040 --> 00:19:10,440
فالرّحيل أسلمُ لكُما
.ما دُمتما قادِرين

327
00:19:10,750 --> 00:19:12,620
.وإلّا فسوفَ تندمان

328
00:19:13,000 --> 00:19:13,830
،الآنسة بَاو رُونغ

329
00:19:14,250 --> 00:19:16,320
.نحن هُنا لإنقاذكِ

330
00:19:16,330 --> 00:19:17,330
إنقاذي؟

331
00:19:17,830 --> 00:19:19,830
أجل، طلبَ منّا
.تشَاو تشِي ذلك

332
00:19:21,790 --> 00:19:22,970
تشَاو تشِي؟

333
00:19:26,200 --> 00:19:27,690
.أنا متدرّبٌ مِن قصر تيَان يُو

334
00:19:26,200 --> 00:19:31,900
قصر
تيَان
يُو

335
00:19:27,700 --> 00:19:30,030
قبل بضعة أيّامٍ، جاءَ إلينا
.تشَاو تشِي طالبًا المُساعدة

336
00:19:30,040 --> 00:19:31,900
.وقد أرسلنِي مُعلّمي للتّحقيق

337
00:19:32,370 --> 00:19:33,370
...تشَاو تشِي

338
00:19:34,000 --> 00:19:35,440
.إذن، هُو لم يتخلّ عنّي

339
00:19:35,580 --> 00:19:36,790
...ذهبَ لإحضار المُساعدة

340
00:19:37,290 --> 00:19:39,820
...أسأتُ فهمه

341
00:19:39,830 --> 00:19:42,110
قالَ تشَاو تشِي إنّ هُناك
.شرًا في دار شِينغ هَان

342
00:19:42,120 --> 00:19:44,830
.أرجوكِ، أخبرِينا بما لديكِ

343
00:19:45,290 --> 00:19:47,370
.رُبّما لا يزالُ هُناك بصيصُ أملٍ

344
00:19:48,250 --> 00:19:49,330
...تشَاو تشِي

345
00:19:50,290 --> 00:19:51,660
هل هُو بخيرٍ الآن؟

346
00:19:53,700 --> 00:19:56,360
،عندما وصلَ
.كان قد فقأَ عينيه

347
00:19:57,190 --> 00:19:58,940
،وبعد فترةٍ وجيزة
.غرقَ في الماء

348
00:20:02,200 --> 00:20:05,270
!إذن، لهذا السّبب لاذَ بالفرار

349
00:20:05,540 --> 00:20:07,250
،ولكن... حتّى بعد فِراره

350
00:20:08,410 --> 00:20:10,830
.لم يستطِع النّجاة

351
00:20:12,540 --> 00:20:15,360
قابلنا فتىً آخر بالقُرب
.مِن النّهر قد غرقَ

352
00:20:15,370 --> 00:20:16,700
.هُو مِن الدّار أيضًا

353
00:20:18,120 --> 00:20:19,440
.لا بُدّ أنّه وَان زِي

354
00:20:19,450 --> 00:20:20,820
.فتىً مِن الخدم

355
00:20:21,450 --> 00:20:23,850
لماذا يُغرِق الأطفال أنفسهم؟

356
00:20:24,220 --> 00:20:25,950
ما الّذي يجري هُنا؟

357
00:20:26,620 --> 00:20:28,190
...ليسوا أطفالًا

358
00:20:29,620 --> 00:20:30,850
.مِن الأفضل أن ترحلا

359
00:20:31,160 --> 00:20:32,500
.أنا لا أحتاجُ إلى إنقاذٍ

360
00:20:32,870 --> 00:20:34,760
...كُلّ شخصٍ في دار شِينغ هَان

361
00:20:35,580 --> 00:20:37,750
.محتومٌ عليه أن يُقبرَ في الوحل

362
00:20:38,370 --> 00:20:39,830
،جِئنا لإنقاذها

363
00:20:40,500 --> 00:20:42,700
.لكنّها ترفضُ إخبارنا بالحقيقة

364
00:20:43,450 --> 00:20:45,580
.إنّ هذه الدّار تمتلئُ بالأسرار

365
00:20:45,590 --> 00:20:47,800
.على الأقلّ وجدنا بَاو رُونغ

366
00:20:48,160 --> 00:20:49,580
لكن أين هِي بِي يُون جوُاو؟

367
00:20:51,080 --> 00:20:52,900
هل يُمكن أن تكونَ تلك الفتاة
الصّغيرة الّتي رأيناها سابقًا؟

368
00:20:52,910 --> 00:20:55,120
انطلقَ هَان بَاو يُوان مُسرعًا
.وقد تملّكه هلعٌ شديد

369
00:20:56,150 --> 00:20:58,240
.أتساءلُ إن كانت في خطرٍ

370
00:20:59,160 --> 00:21:00,020
.لنَذهب ونتحقّق

371
00:21:06,660 --> 00:21:09,400
...تشَاو تشِي، أيّها الأبله

372
00:21:09,410 --> 00:21:10,020
.أُمّي

373
00:21:11,150 --> 00:21:13,820
،عمّا قريبٍ
.سنَكونُ معًا إلى الأبد

374
00:21:23,200 --> 00:21:25,870
إلى أين ذهبَ هَان بَاو يُوان؟

375
00:21:29,870 --> 00:21:30,500
ما الخطب؟

376
00:21:30,760 --> 00:21:32,650
!أعتقدُ أنّي... سمعتُ صوتًا

377
00:22:02,620 --> 00:22:09,650
يا آنسة، ما بالُكِ هُنا وحيدةً ♪
♪ في مُنتصف اللّيل؟

378
00:22:09,660 --> 00:22:18,200
،سمعتُ بوُجودكَ هُنا ♪
♪ .فجِئتُ لأُؤنس وحدتكَ

379
00:22:20,250 --> 00:22:24,940
،على متنِ جوادٍ أبيض أنسابُ ♪
♪ .حيثُ تمتدّ الزّهور رِحابًا

380
00:22:24,950 --> 00:22:29,610
،أعدُو بين شوارعَ طويلةٍ ♪
♪ .تصطفّ الأزهار على جانِبيها

381
00:22:29,620 --> 00:22:33,440
،البطّ يسبحُ في الأسفل ♪
♪ .والسّنونو يُحلّق في الأعالي

382
00:22:33,450 --> 00:22:37,940
،وعلى دُروب الأرض ♪
♪ .يعودُ الحبّ الحقيقيّ

383
00:22:37,950 --> 00:22:42,610
،رذاذُ المطر على تلالِ الجنوب ♪
♪ .خُضرة الخَيزرانِ وذهبُ البَرقوق

384
00:22:42,620 --> 00:22:47,320
،ثَمِلٌ عند جدول الدّراق ♪
♪ .سكرانٌ في نهار الرّبيع

385
00:22:47,330 --> 00:22:52,530
♪ .سحبُ الغُروب، ونسيمٌ عند الباب ♪

386
00:22:52,540 --> 00:22:56,530
♪ بضعةُ كُؤوسٍ، وإلى مَن أشتاقُ؟ ♪

387
00:22:56,540 --> 00:23:01,650
،عبرتُ حُقولًا صامتة ♪
♪ .ثُمّ بلداتٍ صاخبةً

388
00:23:01,660 --> 00:23:06,150
الماضي والحاضر يتلاشيان ♪
♪ .مع تتابعِ الكُؤوس

389
00:23:06,160 --> 00:23:11,110
،أودّ أن أواجهكِ ليلَ نهار ♪
♪ .وأبقى معكِ طُوال العُمر

390
00:23:11,120 --> 00:23:15,570
♪ .يمضي الزّمان في غمضةِ عينٍ ♪

391
00:23:20,700 --> 00:23:26,830
،مواسمُ كثيرةٌ مضت ♪
♪ كم باتَ عددُها الآن في ظنّكِ؟