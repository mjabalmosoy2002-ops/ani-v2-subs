...هذا -
!لن تفهم أبداً -

190
00:10:32,900 --> 00:10:36,340
لن تفهم شعور الوحدة! انتهى
!كلُّ شيء عندما متّ

191
00:10:36,500 --> 00:10:39,800
!خسرتُ كلّ شيء، كلّ شيء، كلّ شيء

192
00:10:42,700 --> 00:10:43,640
!هيكاري

193
00:10:44,630 --> 00:10:45,890
!تراجع

194
00:10:52,330 --> 00:10:56,110
سأدمّره هنا... سأدمّر كلّ شيء
يتعلّق بهذا القدر

195
00:10:56,300 --> 00:10:59,570
!سأستعيده كلّه... سأستعيد كلّ الوقت الّذي خسرتُه

196
00:11:00,000 --> 00:11:01,320
!إنّه دوري

197
00:11:04,960 --> 00:11:08,090
!أركب ليايل=أمورتا ركوب بيرسونا

198
00:11:08,800 --> 00:11:10,570
أستدعي تشيفالميا وساجيس

199
00:11:11,160 --> 00:11:14,550
!إمّا أنجح أو أموت. سأنجو حتّى الدّور المقبل

200
00:11:15,030 --> 00:11:17,550
!ثمّة ضرر آخر. سوف أسعى للفوز

201
00:11:17,960 --> 00:11:19,930
أُهاجم الفانغارد بواسطة آيديراس

202
00:11:20,830 --> 00:11:21,850
لا حِراسة

203
00:11:22,230 --> 00:11:23,440
تفقُّد الضّرر

204
00:11:23,730 --> 00:11:24,940
!زِناد حاسم

205
00:11:28,530 --> 00:11:32,150
!أتخيّل ألمكِ يا هيكاري

206
00:11:34,000 --> 00:11:37,370
!لكن ما دمتِ تتألّمين، لا أستطيع الخسارة

207
00:11:38,130 --> 00:11:40,980
علمتُ بمعجزة ريزايل

208
00:11:41,130 --> 00:11:44,460
لهذا نظرتَ إلى أعلى بطاقة من
مجموعة بطاقاتك بمهارته

209
00:11:45,300 --> 00:11:48,420
ريزايل أعطاني الوسيلة لتحقيق مُعجزة

210
00:11:48,930 --> 00:11:52,460
بالمقابل، سأحرص على إخراج
الأفضل من ريزايل

211
00:11:52,960 --> 00:11:56,010
!سوية سوف ننقذ الجميع

212
00:11:56,330 --> 00:11:58,720
!إنّها عودة... المعجزة

213
00:12:00,960 --> 00:12:05,730
،إذا تفقّدت وحدة زِناد في ضررك السّادس
!فإنّها تشفي 1 ضرر

214
00:12:08,330 --> 00:12:13,070
بسبب تأثيرات الزّناد الحاسم، يحصل
!ريزايل على قوّة +10000

215
00:12:13,760 --> 00:12:16,700
معجزة... أكره هذه الكلمة

216
00:12:16,860 --> 00:12:19,820
يمكنك أن تحلم بأشياء كهذه، لكن
الحقيقة لا تعرف الرّحمة

217
00:12:20,260 --> 00:12:22,910
لهذا سأدمّر تلك المعجزة

218
00:12:23,830 --> 00:12:25,370
!أُهاجم ريزايل بواسطة ليايل

219
00:12:26,000 --> 00:12:30,130
بمهارته، أقيّد آيديراس، وأستدعي
!آيديراس الآخر أيضاً

220
00:12:30,630 --> 00:12:32,920
بالإضافة إلى ذلك، يكسب ليايل قوّة +5000

221
00:12:33,360 --> 00:12:34,130
!حِراسة

222
00:12:34,500 --> 00:12:35,760
التفقُّد الأوّل

223
00:12:36,500 --> 00:12:37,760
التفقُّد الثّاني

224
00:12:38,060 --> 00:12:39,390
لا زِناد

225
00:12:40,230 --> 00:12:41,230
لم أنتهِ

226
00:12:41,300 --> 00:12:42,810
!مـ-مستحيل

227
00:12:43,100 --> 00:12:47,270
السّلاح السرّي للمُقدَّر الزّمنيّ هو
!قوّة القفز إلى الماضي

228
00:12:47,460 --> 00:12:51,690
!عسى أن يرجع الزّمن! تتفعّل مهارته الإلهيّة

229
00:12:53,730 --> 00:12:58,150
في نهاية المعركة، أركب ليايل=أمورتا
!الآخر في منطقة الإنزال

230
00:12:58,360 --> 00:12:59,860
!ناقص 1 درايف

231
00:13:00,200 --> 00:13:04,200
لذا يمكنها ركوب نفسها في الماضي
وتعزّز عدد الهجمات

232
00:13:04,700 --> 00:13:07,080
!سأكسر أجنحة ريزايل تلك

233
00:13:07,500 --> 00:13:09,210
!أُهاجم بواسطة آيديراس

234
00:13:10,330 --> 00:13:12,340
!لن أستسلم مهما كلّف الأمر

235
00:13:12,460 --> 00:13:14,840
!بليتز أوردر، السّطوع السّماويّ

236
00:13:15,900 --> 00:13:18,820
أنظر إلى البطاقة العليا في مجموعة
!بطاقاتي وأستعملها للحراسة

237
00:13:18,900 --> 00:13:20,300
!درع +10000

238
00:13:20,390 --> 00:13:21,800
!وحِراسة أخرى

239
00:13:23,000 --> 00:13:24,560
!لن ينقذك هذا

240
00:13:24,930 --> 00:13:27,850
أُهاجم بواسطة ساجيس! تتفعّل مهارته

241
00:13:28,100 --> 00:13:30,620
،بينما تتعزّز قوّة الفانغارد الخاصّ بالعدوّ

242
00:13:30,740 --> 00:13:34,150
!تتعزّز قوّته بقدر قوّة فانغارد العدوّ

243
00:13:35,500 --> 00:13:36,300
مذهل

244
00:13:36,400 --> 00:13:40,200
استخدمَتْ ساجيس وهي تعلم بأنّ قوّتها
ستتعزّز بمهارة ريزايل الإلهيّة

245
00:13:40,300 --> 00:13:42,240
وليس ذلك فحسب

246
00:13:42,400 --> 00:13:46,540
أجل، زِناد أوفر الّذي استخدمَتْه في الدّور
الماضي سوف يدخل حيّز التّنفيذ

247
00:13:47,130 --> 00:13:50,290
بالإضافة إلى ذلك، بإزالة زِناد أوفر
،في منطقة الإنزال

248
00:13:50,400 --> 00:13:52,630
!يحصل ليايل على قوّة +15000

249
00:13:54,160 --> 00:13:55,500
!حِراسة مثاليّة

250
00:13:55,930 --> 00:13:58,090
وبهذا تكون قد استهلكتَ بطاقات يدك

251
00:13:58,660 --> 00:14:00,050
!أُهاجم بواسطة ليايل

252
00:14:00,760 --> 00:14:02,590
تتفعّل قوّةُ الزّمن من جديد

253
00:14:03,300 --> 00:14:07,680
!أقيّد ساجيس وأستدعي ساجيس الآخرين

254
00:14:13,330 --> 00:14:17,230
!سأنهي الأمر كلّه. من أجل إنقاذك يا أخي

255
00:14:18,060 --> 00:14:20,780
!لن أدع الأمر ينتهي! من أجل إنقاذكِ يا هيكاري

256
00:14:21,030 --> 00:14:22,070
!حِراسة

257
00:14:24,330 --> 00:14:25,410
!سأصمد

258
00:14:25,800 --> 00:14:28,410
!سأحطّمه! تفقُّد درايف

259
00:14:29,100 --> 00:14:31,120
!أجل! زِناد سحب

260
00:14:31,500 --> 00:14:33,830
!يحصل ليايل على قوّة +10،000

261
00:14:40,860 --> 00:14:43,590
لم يعُد بمقدورك استخدام مهارة ريزايل الإلهيّة

262
00:14:44,030 --> 00:14:46,930
لكن لا ينتهي الأمر حتّى أكشف عن البطاقة الأخيرة

263
00:14:47,230 --> 00:14:49,140
المستقبل ليس بتلك السّهولة

264
00:14:50,000 --> 00:14:51,300
"،رغم أنّه مجرّد بصيص أمل"

265
00:14:51,420 --> 00:14:54,650
ستنزل مُعجزة على أولئك الّذين"
"يمدّون أيديهم للمساعدة

266
00:14:55,200 --> 00:14:59,030
إذا لم تنجح المعجزة الأولى، فإذاً
!سأسعى لها في مرّة ثانية

267
00:15:02,400 --> 00:15:05,200
تفقُّد... الضّرر

268
00:15:06,560 --> 00:15:08,660
!أجل! زِناد أوفر

269
00:15:10,230 --> 00:15:14,040
.زِناد أوفر يلغي الضّرر وتتمّ إزالته
!أسحب بطاقة

270
00:15:14,630 --> 00:15:17,500
!يحصل ريزايل أيضاً على قوّة +100 مليون

271
00:15:18,200 --> 00:15:22,920
!لماذا؟ لماذا الآن؟ لماذا حدث هذا الآن؟

272
00:15:23,460 --> 00:15:27,430
...هيكاري، يمكن تغيير المستقبل
!إلى المستقبل الّذي تريدينه

273
00:15:27,930 --> 00:15:31,430
إذا قطعتِ خطوة واحدة وأطلقتِ بطاقة
!واحدة، فيمكننا الوصول إلى هناك

274
00:15:33,200 --> 00:15:36,860
لو لم يستخدم السّطوع السّماويّ
...للتعمُّق في مجموعة بطاقاته

275
00:15:38,100 --> 00:15:40,980
ما كان ليسحب زِناد أوفر هذا

276
00:15:41,960 --> 00:15:46,570
إذا ربحتُ في الصّراع المُقدَّر، يمكنني
مُعالجتكِ ولن يموت أحد

277
00:15:46,960 --> 00:15:48,700
هذا هو المستقبل الّذي أريده

278
00:15:49,660 --> 00:15:52,790
في أعماقكِ، تعلمين بأنّ هذه هي
النّتيجة الفضلى يا هيكاري

279
00:15:54,360 --> 00:15:57,960
أريدكِ أن تمدّي يدكِ لي للحصول
على المستقبل الّذي نرغبه

280
00:15:58,760 --> 00:16:00,840
أرجوكِ، ثِقي بي

281
00:16:05,900 --> 00:16:08,510
تعتقد بأنّك ربحت إذاً يا أخي؟

282
00:16:09,600 --> 00:16:10,700
،أخبرتُك

283
00:16:11,120 --> 00:16:14,640
سأدمِّر تلك المعجزة. إذا لم تنجح
مرّة، فسأفعلها مرّتين

284
00:16:14,900 --> 00:16:18,730
.لهذا بنيتُ مجموعة البطاقات هذه
!هذه هي الغاية من قوّة الزّمن

285
00:16:19,400 --> 00:16:20,770
!أُهاجم بواسطة ساجيس

286
00:16:21,230 --> 00:16:26,360
!بمهارته، يعزّز قوّته بقدر قوّة فانغارد الخاصّ بالعدوّ

287
00:16:27,000 --> 00:16:30,160
تذكّرت، كان لديها ساجيس الثّانية تلك
!الّتي استدعَتْها بواسطة ليايل

288
00:16:30,260 --> 00:16:34,120
لا يهمّ مهما كانت القوّة الّتي
لديك في مواجهة تلك المهارة

289
00:16:34,330 --> 00:16:36,790
إذاً الأمر كلّه الآن بين يدَي آكي

290
00:16:37,500 --> 00:16:40,670
!سوف أقضي عليك

291
00:16:43,860 --> 00:16:45,420
!حِراسة مثاليّة

292
00:16:46,000 --> 00:16:47,800
!ما زالت لديك الحِراسة المثاليلّة؟

293
00:16:48,030 --> 00:16:50,640
أيُّها القدر... لماذا تفعل هذا لي أيُّها القدر؟

294
00:16:51,960 --> 00:16:53,430
انتهى دوري

295
00:16:54,060 --> 00:16:55,930
!آكينا، اصمد

296
00:16:56,000 --> 00:16:59,310
كلاهما استهلكا كلّ ما لديهما في ذلك الدّور

297
00:16:59,430 --> 00:17:00,530
يزداد الأمر متعة الآن

298
00:17:01,030 --> 00:17:03,190
إنّه تصادُم حقيقيّ للإرادات

299
00:17:03,900 --> 00:17:06,110
لماذا؟ متى فعلتُ كلّ هذا؟

300
00:17:06,230 --> 00:17:08,070
بالفعل، أنتِ قويّةٌ جدّاً

301
00:17:08,530 --> 00:17:11,660
يمكنني الشُّعور بعزيمتكِ حقّاً
من طريقة قتالكِ

302
00:17:12,330 --> 00:17:15,750
رغم ذلك، لن أفقد الأمل من
!محاولة إنقاذكِ يا هيكاري

303
00:17:16,460 --> 00:17:17,710
ماذا عنكِ؟

304
00:17:18,660 --> 00:17:20,250
أليس هذا واضحاً؟

305
00:17:20,730 --> 00:17:24,500
أنا، أيضاً، لا أستطيع فقدان الأمل
!من محاولة إنقاذ مستقبلك يا أخي

306
00:17:25,030 --> 00:17:28,220
إذا لم نستسلم كلانا، فهناك
شيء وحيد نفعله فقط

307
00:17:28,600 --> 00:17:30,570
أجل، أقبل تحدّيك

308
00:17:30,960 --> 00:17:32,930
!من الآن فصاعداً، سأفجّر كلّ قوّتي

309
00:17:33,100 --> 00:17:34,430
!لا تحفُّظات

310
00:17:34,700 --> 00:17:36,310
!قِتال شامل بين شقيقين

311
00:17:37,160 --> 00:17:39,810
!دوري! أستدعي نيلبيريس

312
00:17:40,230 --> 00:17:43,940
أنا أقدّم المساعدة، لذا اصمتي
!واقبلي مساعدتي أيّتها الجانحة

313
00:17:44,200 --> 00:17:44,980
!هجوم

314
00:17:45,920 --> 00:17:48,610
!من طلب منك المساعدة أيّها الأنانيّ؟

315
00:17:48,930 --> 00:17:49,700
!حِراسة

316
00:17:49,900 --> 00:17:52,780
!لم يطلب أحدٌ ذلك! أفعل هذا رغبةً منّي

317
00:17:52,930 --> 00:17:55,450
بمهارته، أنظر إلى البطاقة العليا في مجموعة
بطاقاتي وأضعها في الأسفل

318
00:17:56,030 --> 00:17:58,940
تتّخذ القرارات من دوني وتختفي بلا أثر

319
00:17:59,060 --> 00:18:00,330
!أنت سيّئ

320
00:18:00,730 --> 00:18:02,580
!لكن لم أختفِ

321
00:18:02,660 --> 00:18:04,960
!أخبرتُك، ستختفي قريباً

322
00:18:06,600 --> 00:18:07,980
تبّاً لذلك المستقبل

323
00:18:08,520 --> 00:18:10,550
!أُهاجم ليايل بواسطة ريزايل

324
00:18:10,800 --> 00:18:13,590
!بمهارته، أستدعي غيغانتيك وأيريال

325
00:18:16,630 --> 00:18:19,600
!أقدّم شكوى ضدّ ذلك المستقبل

326
00:18:20,130 --> 00:18:22,180
!أيُّها المُشتكي المزمن

327
00:18:22,360 --> 00:18:23,190
!حِراسة

328
00:18:26,730 --> 00:18:29,280
!ها أنا ذا! درايف التّوأم

329
00:18:29,860 --> 00:18:32,110
لا يستطيع ريزايل لهزيمة بلانغدماير

330
00:18:32,300 --> 00:18:34,000
لماذا لا تستطيعين تصديقي؟

331
00:18:34,060 --> 00:18:36,860
!إذاً أرِني دليلاً ما بدلاً من كلّ هذا الكلام

332
00:18:36,900 --> 00:18:39,370
!حقيقة وجودك هنا تعني أنّ المستقبل تغيّر

333
00:18:39,560 --> 00:18:41,750
!لا شيء نفعله بهذه المعركة يا غبيّ

334
00:18:41,860 --> 00:18:43,790
!ماذا لو كان كذلك يا غبيّة؟

335
00:18:46,300 --> 00:18:49,010
...أنت -
!بلهاء -

336
00:18:49,300 --> 00:18:51,720
!اصمت -
!اصمتي -

337
00:18:55,130 --> 00:18:57,220
!أجل! زِناد شفاء

338
00:19:06,430 --> 00:19:09,610
!صِل إليها

339
00:19:15,960 --> 00:19:17,330
هذا دافئ

340
00:19:21,130 --> 00:19:22,370
لا زِناد

341
00:19:25,760 --> 00:19:28,040
!مرحى، رَبِح آكينا

342
00:19:28,560 --> 00:19:30,760
لكن لم يبدأ الجزء الصّعب بعد

343
00:19:31,030 --> 00:19:33,300
!لكن انتصرت المُعجزة على المستقبل

344
00:19:34,130 --> 00:19:36,090
أنا مسرور لأنّكما تمكّنتُما من القتال

345
00:19:41,300 --> 00:19:42,520
...خسرتُ

346
00:19:43,630 --> 00:19:47,190
ألم تكن أوّل مرّة نتجادل فيها من دون
أدنى اهتمام لمشاعرنا؟

347
00:19:47,760 --> 00:19:48,980
معك حقّ

348
00:19:49,460 --> 00:19:53,740
الغريب أنّنا الآن بعد أن تقاتلنا وقلنا
،كلّ ما أردنا قوله

349
00:19:54,000 --> 00:19:55,450
أشعر براحة كبيرة

350
00:19:55,960 --> 00:19:56,910
أنا أيضاً

351
00:19:57,300 --> 00:19:59,240
أنت عنيد جدّاً يا أخي

352
00:19:59,530 --> 00:20:00,950
كذلك أنتِ

353
00:20:03,730 --> 00:20:05,830
يمكنني الإيمان بك، صحيح؟

354
00:20:06,200 --> 00:20:09,090
!دعي الأمر لي. أنا أخوكِ الكبير في النّهاية

355
00:20:09,530 --> 00:20:12,380
هذا سخيف جدّاً. هذا بالكاد يُقنعني

356
00:20:12,700 --> 00:20:15,010
لكن... أنا أؤمن بك

357
00:20:17,530 --> 00:20:20,760
شكراً... على سعيكِ الحثيث

358
00:20:27,530 --> 00:20:29,610
!أخي

359
00:20:29,930 --> 00:20:33,860
!كان ذلك مؤلماً جدّاً طوال الوقت
!كنتُ خائفة للغاية

360
00:20:34,030 --> 00:20:35,860
!كنتُ وحيدة

361
00:20:36,060 --> 00:20:38,870
أردتُ الذّهاب إلى المدرسة الثّانوية معك

362
00:20:38,960 --> 00:20:41,620
أردتُك أن تطبخ لي مزيداً من اليخنة

363
00:20:41,800 --> 00:20:45,620
"!أردتُك أن تقول "عدتُ إلى المنزل

364
00:20:51,530 --> 00:20:53,880
ماذا؟ سوف تتأخّر؟

365
00:20:54,200 --> 00:20:56,800
لا تسهر كثيراً، حسناً؟

366
00:20:57,530 --> 00:20:58,970
حسناً، فهمت

367
00:21:02,460 --> 00:21:04,970
سآكل بودينغ أخي

368
00:21:09,760 --> 00:21:11,310
ما أنا؟

369
00:21:11,900 --> 00:21:13,480
إلى أين أنا ذاهب؟

370
00:21:14,060 --> 00:21:17,700
هل الإجابة على ذلك... تنتظرني هناك؟

371
00:21:18,900 --> 00:21:22,660
هل تعلم يا بلانغدماير؟

372
00:21:28,600 --> 00:21:33,000
هل ستنزعجين إذا قلتُ لكِ بأنّني
ما زلتُ أريد أن أكون صديق سو؟

373
00:21:33,400 --> 00:21:36,840
ليس تماماً. توقّعتُك أن تقول ذلك يا أخي

374
00:21:37,160 --> 00:21:39,380
لكن سوف أكرهه للأبد

375
00:21:40,130 --> 00:21:41,430
لا ألومكِ

376
00:21:45,560 --> 00:21:46,600
انتصِر، حسناً؟

377
00:21:47,900 --> 00:21:49,060
مهما كلّف الأمر

378
00:21:49,830 --> 00:21:50,850
بالطّبع

379
00:21:54,930 --> 00:21:55,940
...سأحرص

380
00:21:57,430 --> 00:21:58,820
!على تحقيق مُعجزة

381
00:23:31,300 --> 00:23:33,330
أهلاً بكم في كوك ميليون

382
00:23:33,400 --> 00:23:35,790
إذاً هذا ما كنتَ تخطّط له، صحيح؟

383
00:23:35,900 --> 00:23:38,790
أريدك أن تعرّفي عن بطاقة هذه المرّة

384
00:23:39,460 --> 00:23:43,630
سأعرّف عن المُقدَّر الزّمنيّ، ليايل=أمورتا

385
00:23:43,800 --> 00:23:45,100
،بمهارتها الإلهيّة

386
00:23:45,180 --> 00:23:48,400
في نهاية المعركة، يمكنها ركوب
ليايل آخر في منطقة الإنزال

387
00:23:48,520 --> 00:23:49,900
وناقص 1 درايف

388
00:23:50,000 --> 00:23:54,060
،يمكنها أيضاً استخدام مهارتها الهجوميّة مرّتين
ممّا يسمح لها بتنفيذ هجمات متتاليّة

389
00:23:54,160 --> 00:23:57,190
!إنّه مُقدَّر لا أعرف عنه شيئاً. لنرَ ذلك عن كثب

390
00:23:57,300 --> 00:23:59,230
أتريدني أن أمزّقك؟ -
!لا تفعلي -