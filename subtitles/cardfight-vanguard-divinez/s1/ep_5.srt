192
00:12:14,250 --> 00:12:16,180
بمهارته، أشغِّل ماكسيمام مرّة أخرى

193
00:12:16,580 --> 00:12:20,120
!أعزل يويكا. آخذ قوّة 5،000 من كريسراين

194
00:12:21,020 --> 00:12:22,770
أخذ قوّتي من جديد

195
00:12:23,450 --> 00:12:25,240
...هذا صعب، لكن سأضطرّ لـ

196
00:12:25,720 --> 00:12:26,390
!حِراسة

197
00:12:27,690 --> 00:12:29,970
تتفعّل مهارة بوبالماين. أشحن شحنة كاونتر

198
00:12:30,540 --> 00:12:32,250
!ها هو الرّئيس التّنفيذيّ

199
00:12:32,790 --> 00:12:35,340
!أُهاجم بواسطة ويلسترا! تتفعّل مهارته

200
00:12:35,810 --> 00:12:37,760
يمنح نفسه قوّة +10،000

201
00:12:38,220 --> 00:12:40,440
!أعيد تشغيل ماكسيمام من جديد

202
00:12:40,900 --> 00:12:42,200
!هناك المزيد من الحركات؟

203
00:12:42,500 --> 00:12:43,670
أعزل إيلين

204
00:12:43,980 --> 00:12:46,240
!آخذ قوّة 5،000 من كريسراين

205
00:12:46,630 --> 00:12:48,380
!اقذف بعيداً يا ماكسيمام

206
00:12:49,760 --> 00:12:51,920
انتزع الكثير من القوّة منّي

207
00:12:52,880 --> 00:12:57,430
بإعادة ترولّي إلى يدي، يمكنني
!استدعاء ماكسيمام كوحدة

208
00:12:57,990 --> 00:12:59,140
!إنّه وقت الحرب

209
00:12:59,680 --> 00:13:01,740
!يمكن لذلك الشّيء أن يصبح وحدة؟

210
00:13:02,200 --> 00:13:04,360
!جاهزة؟ أُهاجم بواسطة ويلسترا

211
00:13:05,090 --> 00:13:05,910
لا حِراسة

212
00:13:06,580 --> 00:13:07,420
التفقُّد الأوّل

213
00:13:09,190 --> 00:13:11,430
التفقُّد الثّاني. زِناد الشِّفاء

214
00:13:12,300 --> 00:13:13,920
أعالج 1 ضرر

215
00:13:15,440 --> 00:13:18,810
!يكسب ماكسيمام... قوّة 10،000

216
00:13:24,150 --> 00:13:25,540
أُهاجم بواسطة كومباين

217
00:13:26,890 --> 00:13:29,160
لا حِراسة... تفقُّد الضّرر

218
00:13:30,100 --> 00:13:31,380
!زِناد حاسم

219
00:13:31,580 --> 00:13:33,670
!تكسب كريسراين قوّة 10،000

220
00:13:34,340 --> 00:13:36,300
هذه مجرّد نقطة من بحر

221
00:13:40,250 --> 00:13:42,200
!أُهاجم بواسطة... ماكسيمام

222
00:13:43,810 --> 00:13:47,640
!إطلاق

223
00:13:53,690 --> 00:13:56,580
!كسبتُ بعض القوّة، لكن ما زالت غير كافية

224
00:13:57,240 --> 00:13:58,240
لا حِراسة

225
00:13:59,340 --> 00:14:02,460
،يعود ماكسيمام إلى منطِقة الأوامر
انتهى دوري

226
00:14:02,950 --> 00:14:04,840
تلقّيتُ 3 ضرراً في هذا الدّور فقط

227
00:14:05,140 --> 00:14:07,540
علاوة على ذلك، خسرتُ كلّ حرَسي الخلفيّ

228
00:14:07,960 --> 00:14:10,000
...هذا ما يستطيع المحترفون النّخبة فعله

229
00:14:10,710 --> 00:14:14,080
إنّه بمستوى آخر. عرفتُ
بأنّني لم أكن جيّدة بما يكفي

230
00:14:14,530 --> 00:14:15,500
!لا تشعري بالإحباط

231
00:14:16,500 --> 00:14:20,200
،لا أعرف ما الّذي عانيتِ منه
لكن دعيني أخمّن

232
00:14:20,920 --> 00:14:23,340
بعض النّاس البغيضين قالوا
كلاماً قاسياً بحقّكِ

233
00:14:24,130 --> 00:14:26,550
بسبب عملي، عليّ التّعامل معهم أيضاً

234
00:14:26,900 --> 00:14:30,730
أعمل عملين ويبدو أنّ النّاس
لا يروقهم ذلك ويسيئون إليّ

235
00:14:31,760 --> 00:14:34,210
أتعرفين ماذا أفعل في أوقات كهذه؟

236
00:14:35,250 --> 00:14:40,250
أقول "اصمتوا" وأسخر من الأمر

237
00:14:41,660 --> 00:14:44,140
لا أصغي إلّا للنّاس الجادّين تماماً

238
00:14:44,620 --> 00:14:47,820
إذا هاجمتِهم بكلّ قوّتكِ، ستعرفين بأنّهم جادُّون

239
00:14:48,400 --> 00:14:50,200
بوضع هذا في الاعتبار، اسمحي لي أن أسألكِ

240
00:14:51,160 --> 00:14:52,760
ألا أبدو جادّاً في نظركِ؟

241
00:14:54,230 --> 00:14:57,530
!إذا تمنّيتِ التغيُّر، فافعلي ذلك هنا

242
00:14:58,000 --> 00:14:59,270
!هاجميني بشكل صريح

243
00:14:59,580 --> 00:15:00,260
...صريح

244
00:15:01,220 --> 00:15:02,890
أشجّعك

245
00:15:04,760 --> 00:15:05,560
...أريد

246
00:15:06,890 --> 00:15:09,010
أريد أن أصبح دائمة التغيُّر

247
00:15:09,660 --> 00:15:12,540
أريد أن أؤمن بأنّني أستطيع
التألُّق كائناً من أكون

248
00:15:13,400 --> 00:15:14,000
...لكن

249
00:15:19,040 --> 00:15:19,830
...أنا

250
00:15:21,460 --> 00:15:22,210
...أنا

251
00:15:26,010 --> 00:15:27,200
!أريد أن أتغيّر

252
00:15:36,650 --> 00:15:37,780
!إنّه دوري

253
00:15:38,850 --> 00:15:40,820
!أركب كريسراين... ركوب بيرسونا

254
00:15:41,400 --> 00:15:42,460
أستدعي أنّيس

255
00:15:42,680 --> 00:15:43,820
تتفعّل مهارتها

256
00:15:44,450 --> 00:15:46,460
أنظر إلى أعلى خمس بطاقات في مجموعتي

257
00:15:50,360 --> 00:15:51,540
!هذه هي

258
00:15:52,040 --> 00:15:53,740
!عرفتُ بأنّني أمتلك ذلك

259
00:15:54,150 --> 00:15:56,170
!أستدعي... كريستين

260
00:15:57,680 --> 00:15:59,240
استدعَتْ حِراسة مثاليّة؟

261
00:16:00,420 --> 00:16:01,980
أستدعي آلبينا وريسيوس

262
00:16:02,400 --> 00:16:04,760
!بمهارته، تكسب كريسراين قوّة 10,000

263
00:16:05,460 --> 00:16:06,720
!تتفعّل مهارة كريسراين

264
00:16:06,820 --> 00:16:10,470
تمنح نفسها قوّة 15،000 وحاسمة إضافيّة

265
00:16:11,060 --> 00:16:12,020
!أستدعي ويزماي

266
00:16:12,700 --> 00:16:14,330
!سوف أريك

267
00:16:14,460 --> 00:16:18,950
سأجعلك تندم على جعلي أتّخذ
!هذه المعركة بجدّية تامّة

268
00:16:19,220 --> 00:16:21,840
!تعالي إليّ! هاجميني بكلّ قوّتكِ

269
00:16:22,480 --> 00:16:25,720
!بتقوية كريسين. أُهاجم بواسطة ويزماي

270
00:16:26,150 --> 00:16:27,220
لا حِراسة

271
00:16:27,940 --> 00:16:29,270
!أُهاجم بواسطة أنّيس

272
00:16:29,760 --> 00:16:30,820
لا حِراسة

273
00:16:32,080 --> 00:16:36,050
!أُهاجم الفانغارد بواسطة كريسراين

274
00:16:47,560 --> 00:16:50,650
!هذه قوّة كبيرة بالنّسبة لوجه جميل

275
00:16:51,320 --> 00:16:53,940
!حسناً إذاً... سأطلق العنان

276
00:16:54,540 --> 00:16:55,220
!حِراسة

277
00:16:57,720 --> 00:17:00,360
!ستّ بطاقات؟ كم أنت كريم

278
00:17:00,570 --> 00:17:02,460
!حسناً، لا أحد يحبّ البُخلاء

279
00:17:03,960 --> 00:17:04,960
التفقُّد الأوّل

280
00:17:05,600 --> 00:17:06,580
لا زِناد

281
00:17:06,980 --> 00:17:08,100
التفقُّد الثّاني

282
00:17:08,620 --> 00:17:09,960
!زِناد حاسم

283
00:17:10,130 --> 00:17:14,260
!تكسب كريسراين قوّة 10،000 وحاسمة إضافيّة

284
00:17:33,280 --> 00:17:35,650
تمكّنتُ للتو من حراسته

285
00:17:36,410 --> 00:17:38,120
لكن أعلم بأنّكِ لم تنتهِ بعد

286
00:17:38,310 --> 00:17:42,450
!بالطّبع! أعلم بأنّني أستطيع التألُّق أكثر

287
00:17:43,890 --> 00:17:47,300
!الجمال دائم التغيُّر! تفعّل مهارتها الإلهيّة

288
00:17:49,400 --> 00:17:53,380
أنقل كلّ حرسي الخلفيّ إلى يدي
!وأستدعي أنّيس

289
00:17:53,460 --> 00:17:57,240
والآن، أجعل قوّة أنّيس وحسمها
!مثل قوّة وحسم كريسراين

290
00:17:57,430 --> 00:18:00,710
،علاوة على ذلك، بمهارة أنّيس
أستدعي فاوستينا

291
00:18:00,850 --> 00:18:03,570
!بجدّية؟ لا بدّ أنّكِ تمزحين معي

292
00:18:03,800 --> 00:18:06,220
!أمزح؟ لا أمزح معك

293
00:18:06,680 --> 00:18:09,240
!أُهاجم كومباين بواسطة فاوستينا

294
00:18:09,450 --> 00:18:10,370
لا حِراسة

295
00:18:11,600 --> 00:18:15,400
!أُهاجم الفانغارد بواسطة أنّيس

296
00:18:17,240 --> 00:18:18,550
!حِراسة مثاليّة

297
00:18:19,760 --> 00:18:20,630
انتهى دوري

298
00:18:21,740 --> 00:18:25,720
فهمت. افترضتِ بأنّها ستُصَدّ

299
00:18:26,440 --> 00:18:29,740
لهذا استدعيتِ حِراسة مثاليّة
وأعدتِها إلى يدك

300
00:18:30,400 --> 00:18:32,280
أمّنتِ دفاعكِ بشكل مُتقَن

301
00:18:32,820 --> 00:18:33,560
أحسنتِ

302
00:18:36,360 --> 00:18:38,220
جميل! هذه هي حقيقتكِ إذاً؟

303
00:18:38,790 --> 00:18:40,810
لكن أنا من سوف يفوز

304
00:18:41,540 --> 00:18:42,390
!دوري

305
00:18:43,200 --> 00:18:44,620
!أستدعي ترولّي وياغت

306
00:18:45,610 --> 00:18:48,840
أشهرَ يده بالكامل. يريد
إنهاء الأمر في هذا الدّور

307
00:18:49,580 --> 00:18:50,930
عليّ التصدّي لها

308
00:18:51,060 --> 00:18:52,660
!تأخّرُ عليكِ

309
00:18:52,760 --> 00:18:55,240
!سأريكِ قوّة سلاحنا الأحدث

310
00:18:55,840 --> 00:18:57,930
!أُهاجم الفانغارد بواسطة ويلسترا

311
00:18:58,180 --> 00:19:01,240
،بمهارته، يكسب قوّة 10،000

312
00:19:01,650 --> 00:19:03,090
!أُشغِّل يوريانتي

313
00:19:04,720 --> 00:19:07,340
!إنّه مُنَتج لم يتمّ تشغيله في الدّور الماضي

314
00:19:07,980 --> 00:19:10,420
لا يمكن تفعيل يوريانتي في الدّور
الّذي جُهِّزَتْ فيه

315
00:19:10,820 --> 00:19:13,120
...لكن حالما يتمّ التّفعيل

316
00:19:15,120 --> 00:19:16,200
!أترين هذا؟

317
00:19:16,520 --> 00:19:21,300
إنّه النّجم في أعالي السّماء
!الّذي يُرشد شركتنا

318
00:19:24,530 --> 00:19:26,180
،عندما أُشغِّل يوريانتي

319
00:19:26,340 --> 00:19:30,060
أعزل حارساً خلفيّاً وآخذ قوّة 10،000 من الطّليعة

320
00:19:32,060 --> 00:19:35,290
!علاوة على ذلك، تلحق بك 1 ضرر

321
00:19:36,290 --> 00:19:38,240
بئساً! بجدّية؟

322
00:19:39,240 --> 00:19:41,450
!افعليها يا يوريانتي

323
00:19:41,740 --> 00:19:45,410
!أطلقي المِدفع المُغيِّر للقدر

324
00:19:52,650 --> 00:19:54,450
لا أستطيع تحمُّل ضرر واحد الآن

325
00:19:54,920 --> 00:19:57,100
سيتمّ تشغيل ماكسيمام كذلك

326
00:19:57,840 --> 00:20:01,440
لديّ كلّ هذه البطاقات باليد، لكن ما زلتُ
لا أستطيع التصدّي لكلّ هجماته

327
00:20:04,180 --> 00:20:05,120
لا حِراسة

328
00:20:13,810 --> 00:20:14,770
تفقُّد الضّرر

329
00:20:16,140 --> 00:20:17,600
...لا زِناد

330
00:20:19,200 --> 00:20:22,680
!الرّابح هو... النّجم الهادي المُقدَّر

331
00:20:41,690 --> 00:20:44,160
مضى وقتٌ طويل منذ راودني هذا الشُّعور

332
00:20:45,860 --> 00:20:47,980
شعرتُ هذا الشُّعور بعد عرضي الأوّل

333
00:20:50,010 --> 00:20:50,900
تايزو

334
00:20:53,110 --> 00:20:54,440
شكراً جزيلاً لك

335
00:20:56,970 --> 00:20:58,760
!لقد استمتعتُ كثيراً

336
00:21:01,240 --> 00:21:02,500
كانت معركة جميلة

337
00:21:14,130 --> 00:21:17,360
أعتقد... هذا القدر إذاً؟

338
00:21:23,610 --> 00:21:27,170
ولهذا، قرّرتُ العودة كآيدول

339
00:21:27,560 --> 00:21:29,320
أسمع ما تقولينه يا ميكوتو

340
00:21:29,860 --> 00:21:33,180
لكن الكشف عن ذاتكِ الحقيقيّة
قد لا تكون فكرة جيّدة

341
00:21:33,750 --> 00:21:34,970
!لا تقلقي

342
00:21:35,240 --> 00:21:39,700
الكسولة في أيّام عطلتي والآيدول
...المثاليّة هناك في المسرح

343
00:21:40,220 --> 00:21:42,620
!كلتاهما أنا الحقيقيّة

344
00:21:44,850 --> 00:21:46,010
لا شكّ في ذلك

345
00:21:47,510 --> 00:21:50,890
لا أنوي البتّة خسارة معركتي المقبلة

346
00:21:53,020 --> 00:21:56,160
...يجب على أكينا ميودو أن يُستأصَل

347
00:21:57,480 --> 00:21:58,720
من الصِّراع المُقدَّر...

348
00:23:31,220 --> 00:23:33,120
أهلاً بكم في كوك ميليون

349
00:23:33,300 --> 00:23:35,770
أتريدني أن أرمّم هذا المكان
لأجعله بشكل أفضل؟

350
00:23:35,880 --> 00:23:38,040
!لا تفعل! سيلومونني على ذلك

351
00:23:39,040 --> 00:23:43,240
،هذه المرّة سأقدّم النّجم الهادي المُقدَّر
"ويلسترا "بليتز آرمز

352
00:23:43,750 --> 00:23:48,460
مهارته الإلهيّة تتيح لك تجهيز مُنتجَين
،في يدك بشكل غير مشروط

353
00:23:48,600 --> 00:23:50,280
وتشغيل واحد منهما

354
00:23:50,740 --> 00:23:54,390
نبني ونشغّل بسرعة فائقة لأنّنا عاملان دؤوبان

355
00:23:54,450 --> 00:23:56,520
لنأمل ألّا يكون مصنوعاً من الورق المُقوّى

356
00:23:56,650 --> 00:23:59,260
!لا تقلق بشأن ذلك! نحن لا نقتصد في النّفقات