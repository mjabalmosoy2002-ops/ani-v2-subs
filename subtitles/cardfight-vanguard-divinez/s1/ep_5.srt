1
00:00:19,760 --> 00:00:21,590
لستُ بخير

2
00:00:26,390 --> 00:00:28,260
ماذا؟ ما الأمر يا ميكوتو؟

3
00:02:08,850 --> 00:02:11,370
دورك في الصِّراع المُقدَّر تالياً

4
00:02:11,900 --> 00:02:14,940
أجل، خصمي هو النّجم الهادي المُقدَّر

5
00:02:16,000 --> 00:02:19,510
أتعلمين؟ عندما كنتُ أشاهدكِ
،وأنتِ تقاتلين ميغومي قبل أيّام

6
00:02:20,240 --> 00:02:22,840
!كنتِ مُبهرة حقّاً

7
00:02:22,970 --> 00:02:23,920
!ما-ماذا؟

8
00:02:24,000 --> 00:02:25,500
يجدر بكِ أن تثقي بنفسكِ أكثر

9
00:02:26,800 --> 00:02:28,240
سأشجّعكِ

10
00:02:29,770 --> 00:02:31,670
يا لك من شخص اجتماعيّ منفتح

11
00:02:32,330 --> 00:02:35,040
!لـ-لا شيء! لم تسمع ذلك

12
00:02:37,160 --> 00:02:40,640
كيف لك أن تكون صادقاً مع نفسك يا آكينا؟

13
00:02:41,060 --> 00:02:42,040
صادق؟

14
00:02:42,240 --> 00:02:46,550
التصرُّف الطبيعيّ هو ألّا تُواسي شخصاً
قد ينتهي المطاف بك بمواجهته

15
00:02:47,450 --> 00:02:49,080
نفس الأمر ينطبق على ميغومي

16
00:02:49,860 --> 00:02:51,780
كانت دافئة جدّاً وصادقة

17
00:02:53,420 --> 00:02:54,900
لا أستطيع العيش هكذا

18
00:02:55,600 --> 00:02:58,740
أجد أنّ مواجهة شخص بشكل
مُباشر أمرٌ مُخيف

19
00:03:00,010 --> 00:03:02,040
ماذا لو رفضني هذا الشّخص؟

20
00:03:03,370 --> 00:03:04,320
لا أستطيع تحمُّل ذلك

21
00:03:05,590 --> 00:03:08,340
يبدو هذا صعباً

22
00:03:08,860 --> 00:03:10,220
بالمناسبة يا ميكوتو؟

23
00:03:12,820 --> 00:03:14,130
هل أنتِ متفرّغة بعد الدّوام المدرسيّ؟

24
00:03:21,290 --> 00:03:23,730
أختك في المشفى؟

25
00:03:24,090 --> 00:03:25,730
إنّها واهنة قليلاً

26
00:03:26,160 --> 00:03:28,950
لكن في الآونة الأخيرة بدأتْ تتحسّن

27
00:03:33,660 --> 00:03:34,320
!هيكاري

28
00:03:35,380 --> 00:03:38,230
!هذه البودينغ شهيّة جدّاً

29
00:03:39,130 --> 00:03:41,160
!لذيذة! لذيذة

30
00:03:43,210 --> 00:03:44,690
أخي

31
00:03:45,380 --> 00:03:46,710
لا تُخيفيني هكذا

32
00:03:47,080 --> 00:03:47,770
مرحباً

33
00:03:49,880 --> 00:03:51,290
آكينا ميودو

34
00:03:55,120 --> 00:03:55,770
من؟

35
00:03:59,680 --> 00:04:01,830
!الشّخص الّذي خسر في نهائي ديلوكس

36
00:04:01,960 --> 00:04:04,550
"حبّذا لو تناديني بـ"الوصيف

37
00:04:05,420 --> 00:04:08,140
الرّئيس التنفيذيّ لمجموعة كيوكورا
!ومقاتل محترف

38
00:04:08,380 --> 00:04:12,600
لم تخبرني أبداً بأنّك صديق
تايزو كيوكورا يا أخي

39
00:04:13,820 --> 00:04:15,660
جمعنا القدرُ معاً

40
00:04:17,110 --> 00:04:17,750
أليس كذلك؟

41
00:04:18,520 --> 00:04:20,060
هل التقينا من قبل؟

42
00:04:20,170 --> 00:04:21,270
...آكينا

43
00:04:22,040 --> 00:04:24,460
كان حاضراً يراقب معركتك

44
00:04:25,970 --> 00:04:28,700
إنّه غالباً مُشارك في الصِّراع المُقدَّر

45
00:04:30,620 --> 00:04:31,740
ينبغي أن أذهب الآن

46
00:04:33,460 --> 00:04:34,760
بالتّوفيق يا هيكاري

47
00:04:34,870 --> 00:04:37,250
!أجل، وشكراً لك على البودينغ

48
00:04:41,830 --> 00:04:43,810
أتطلّع قدماً لمعركتنا المقبلة

49
00:04:50,700 --> 00:04:54,400
إذاً تايزو كيوكورا هو صاحب
النّجم الهادي المُقدَّر

50
00:04:54,760 --> 00:04:57,260
!مستحيل! إنّها مي-تان

51
00:04:57,640 --> 00:05:01,400
!يا إلهي! مي-تان الحقيقيّة ظريفة جدّاً

52
00:05:01,500 --> 00:05:04,770
لحظة، لا أصدِّق بأنّني ألتقي بهذا
!العدد من المشاهير اليوم

53
00:05:11,010 --> 00:05:13,180
حسناً، حريّ بي أن أغادر

54
00:05:20,060 --> 00:05:22,840
!إذاً كنتِ الأرنب بيري يا مي-تان

55
00:05:22,950 --> 00:05:25,260
!أحبّ التكلّم عن فانغارد معكِ

56
00:05:25,480 --> 00:05:28,860
.أحبّ التكلّم معكِ أيضاً
ليتنا التقينا في وقت أسبق

57
00:05:29,060 --> 00:05:31,700
!أجل! لكنّكِ لستِ كما تخيّلتُ

58
00:05:31,990 --> 00:05:33,660
هل خيّبتُ أملكِ؟

59
00:05:35,360 --> 00:05:38,560
!إطلاقاً! أحبّ مي-تان الاثنتين

60
00:05:44,820 --> 00:05:46,700
الاثنتان؟

61
00:06:06,210 --> 00:06:07,440
ميكوتو سايتو

62
00:06:08,010 --> 00:06:09,370
تايزو كيوكورا

63
00:06:16,410 --> 00:06:18,710
!أمسك القدر -
!بيدَي -

64
00:06:19,900 --> 00:06:20,690
!ديفاين

65
00:06:24,730 --> 00:06:25,940
لقد حان الوقت

66
00:06:26,960 --> 00:06:29,820
!فلتبدأ الجولة الثّانية لتغيير القدر

67
00:06:30,700 --> 00:06:32,060
هل أنتِ جاهزة نفسيّاً؟

68
00:06:32,450 --> 00:06:34,740
أجل. سأربح مهما كلّف الأمر

69
00:06:35,340 --> 00:06:37,130
مهما كنتَ قويّاً

70
00:06:37,920 --> 00:06:38,480
هكذا إذاً

71
00:06:39,320 --> 00:06:42,340
لكن أنا أيضاً لديّ أسبابي في عدم
الرّغبة في الخسارة

72
00:06:44,170 --> 00:06:44,800
جاهزة؟

73
00:06:46,550 --> 00:06:48,620
!نهوض، فانغارد

74
00:06:49,350 --> 00:06:51,300
!الخُزامى العجيبة، يورسول

75
00:06:51,600 --> 00:06:53,590
بليتز الرّئيس الميكانيكيّ، وارتون

76
00:06:53,980 --> 00:06:54,720
دوري

77
00:06:55,400 --> 00:06:56,540
أركب تيفاين

78
00:06:57,110 --> 00:07:00,520
أجهِّز مولِّدة الطّاقة. انتهى دوري

79
00:07:01,270 --> 00:07:05,100
...هذا هو الصِّراع المُقدَّر إذاً
يسرّني أنّني لعبتُ خارج الشّبكة مسبقاً

80
00:07:05,750 --> 00:07:07,300
يجب أن أشكر ميغومي

81
00:07:07,760 --> 00:07:08,480
دوري

82
00:07:09,160 --> 00:07:11,830
بليتز المُبرمِج الأفضل، سترازر

83
00:07:11,990 --> 00:07:13,400
بمهارته، أسحب بطاقة

84
00:07:14,140 --> 00:07:15,840
أجهّز مُولِّدة الطّاقة

85
00:07:16,120 --> 00:07:17,160
شحن الطّاقة

86
00:07:17,760 --> 00:07:18,890
أُهاجم بواسطة سترازر

87
00:07:19,600 --> 00:07:21,000
لا حِراسة

88
00:07:21,620 --> 00:07:22,550
انتهى دوري

89
00:07:22,640 --> 00:07:23,660
حان دوري

90
00:07:24,160 --> 00:07:25,330
أركب ميوزيت

91
00:07:25,490 --> 00:07:27,410
بمهارتها، أستدعي فاوستينا

92
00:07:27,520 --> 00:07:28,560
أستدعي يويكا

93
00:07:29,120 --> 00:07:30,580
!أُهاجم بواسطة ميوزيت

94
00:07:30,900 --> 00:07:32,010
لا حِراسة

95
00:07:33,030 --> 00:07:34,410
أُهاجم بواسطة فاوستينا

96
00:07:34,930 --> 00:07:35,450
حِراسة

97
00:07:36,530 --> 00:07:39,160
بمهارة يويكا، أعيد فاوستينا إلى يدي

98
00:07:39,340 --> 00:07:40,160
انتهى دوري

99
00:07:40,640 --> 00:07:42,140
هلّا سألتُك سؤالاً؟

100
00:07:42,840 --> 00:07:45,160
ما هي أمنيتكِ يا ميكوتو؟

101
00:07:45,380 --> 00:07:47,380
لـ-لماذا تسألني ذلك فجأة؟

102
00:07:47,540 --> 00:07:49,940
لا يوجد سببٌ شخصيّ. أريد أن أعرف فحسب

103
00:07:50,730 --> 00:07:53,840
أريد... تغيير نفسي

104
00:07:54,850 --> 00:07:56,500
لا تعجبكِ نفسكِ الحاليّة؟

105
00:07:56,630 --> 00:07:57,570
لا أعلم

106
00:07:58,060 --> 00:08:01,420
لكن لا أملك الشّجاعة للظّهور
علناً بحالتي الرّاهنة

107
00:08:02,610 --> 00:08:05,050
يبدو عمل الآيدول قاسياً

108
00:08:05,820 --> 00:08:07,300
لكن لن أتساهل معكِ

109
00:08:08,580 --> 00:08:09,340
!دوري

110
00:08:10,250 --> 00:08:12,560
أركب بليتز رئيس الباحثين، يوبر

111
00:08:13,510 --> 00:08:14,680
،بمهارة سترازر

112
00:08:14,760 --> 00:08:18,410
أضيف ناقلة طائرات الهجوم لوبيتزال
من مجموعة البطاقات إلى يدي

113
00:08:18,940 --> 00:08:20,490
!أجهّزها في منطقة الإنزال خاصّتي

114
00:08:20,850 --> 00:08:21,970
!ما هذا الشّيء؟

115
00:08:22,220 --> 00:08:23,560
إنّها بطاقة مُنتَج

116
00:08:24,520 --> 00:08:29,400
تتألّف مجموعة بطاقات تايزو كيوكورا من أسلحة
مُصنَّعة بواسطة شركة بليتز

117
00:08:29,540 --> 00:08:31,400
والّتي تستعرض تشكيلة مهارات

118
00:08:32,310 --> 00:08:35,240
بمهارته، أستدعي كومباين راشر
من منطقة الإنزال

119
00:08:35,820 --> 00:08:37,940
!أُهاجم بواسطة يوبر. تتفعّل مهارته

120
00:08:38,570 --> 00:08:40,180
سأشغِّل لوبيتزال

121
00:08:40,470 --> 00:08:41,350
وأسحب بطاقة

122
00:08:41,990 --> 00:08:42,900
لا حِراسة

123
00:08:43,620 --> 00:08:44,820
أُهاجم بواسطة كومباين

124
00:08:45,490 --> 00:08:46,290
