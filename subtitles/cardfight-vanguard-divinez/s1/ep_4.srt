264
00:16:36,700 --> 00:16:37,750
!أُهاجم بواسطة آلبين

265
00:16:38,140 --> 00:16:39,080
لا حِراسة

266
00:16:40,160 --> 00:16:41,210
انتهى دوري

267
00:16:41,800 --> 00:16:43,340
!إنّها قويّةٌ جدّاً

268
00:16:43,460 --> 00:16:45,630
!أقسم بأنّها الزّعيمة الأخيرة

269
00:16:46,220 --> 00:16:49,550
بقي 4 ضرر فقط. سيكون ذلك
...غاية في الصّعوبة

270
00:16:49,860 --> 00:16:51,100
!لكن يجب عليّ أن أفعلها

271
00:16:56,300 --> 00:16:58,310
أعلم بأنّني أستطيع

272
00:16:59,740 --> 00:17:01,020
!تغيّرَتْ هالتُها

273
00:17:03,020 --> 00:17:05,650
انظري إلى الصّورة بكاملها
وابحثي عن طريقة للفوز

274
00:17:05,820 --> 00:17:07,860
اغرفي قطرةَ الأمل الصّغيرة تلك

275
00:17:10,820 --> 00:17:12,780
!ركوب بيرسونا! كريسراين

276
00:17:13,340 --> 00:17:17,160
أستدعي أنيس. تتفعّل مهارته. أنظر
...إلى البطاقات الخمس العليا في مجموعتي

277
00:17:18,780 --> 00:17:19,420
!حصلتُ عليها

278
00:17:19,700 --> 00:17:21,040
!أحسنتِ يا أنا

279
00:17:21,480 --> 00:17:22,750
!أستدعي ويزماي

280
00:17:23,300 --> 00:17:25,050
تتصرّف بصورة طبيعيّة أكثر الآن

281
00:17:25,660 --> 00:17:26,800
تتفعّل مهارةُ كريسراين

282
00:17:27,200 --> 00:17:30,300
،لديّ خمس وحدات بأسماء مختلفة
لذا تتفعّل ثلاثة تأثيرات

283
00:17:30,780 --> 00:17:33,300
أسحب بطاقة وأشحن ثلاث بطاقات بالطّاقة

284
00:17:34,060 --> 00:17:37,810
تحصل كريسراين على قوّة 15،000
!وحاسمة إضافيّة

285
00:17:38,560 --> 00:17:39,730
!أستدعي تانموز

286
00:17:39,780 --> 00:17:40,940
!تعالي إليّ

287
00:17:41,020 --> 00:17:43,940
،أُهاجم بواسطة أنيس. بمهارته
!يكتسب قوّة 10،000

288
00:17:44,320 --> 00:17:45,110
!حِراسة

289
00:17:45,720 --> 00:17:47,860
إنّها تهاجم بالحرسِ الخلفيّ هذه المرّة؟

290
00:17:48,300 --> 00:17:50,820
لعلّها تُخفي هجوماً إضافيّاً في جعبتها

291
00:17:51,220 --> 00:17:54,580
أُهاجم بواسطة ويزماي! بمهارتها، تحصل
على قوّة قدرها 15،000

292
00:17:54,860 --> 00:17:55,790
لا حِراسة

293
00:17:56,840 --> 00:17:59,160
!أُهاجم الفانغارد بواسطة كريسراين

294
00:18:03,120 --> 00:18:04,920
!حِراسة واعتراض

295
00:18:08,820 --> 00:18:09,800
التفقُّد الأوّل

296
00:18:11,200 --> 00:18:12,260
التفقُّد الثّاني

297
00:18:13,700 --> 00:18:16,180
!سحب مِلحميّ! إنّه زِناد حاسم

298
00:18:16,260 --> 00:18:20,100
تحصل كريسراين على قوّة 10،000
وحاسِمة إضافيّة

299
00:18:20,460 --> 00:18:23,780
لكن ما زال ذلك غير كافٍ كي يخترق
الفانغارد الخاصّ بكِ حمايتي

300
00:18:23,900 --> 00:18:25,000
حاليّاً على الأقلّ

301
00:18:25,300 --> 00:18:28,360
!بالرُّغم من كلّ شيء، سوف أتألّق

302
00:18:29,880 --> 00:18:33,450
!الجمال دائم التغيُّر! تتفعّل مهارتُه الإلهيّة

303
00:18:35,480 --> 00:18:36,780
!مهارة إلهيّة؟

304
00:18:37,040 --> 00:18:39,540
لا يمكن استعمال المهارات الإلهيّة
إلّا مرّة في المعركة

305
00:18:40,220 --> 00:18:42,790
،أنقل كلّ حرَسي الخلفيّ إلى يدي

306
00:18:42,880 --> 00:18:45,000
!وأستدعي ويزماي من تلك اليد

307
00:18:45,320 --> 00:18:49,130
والآن أجعل قوّةَ ويزماي
!وحسمها مثل قوّة وحسم كريسراين

308
00:18:49,580 --> 00:18:51,050
...لحظة، هذا يعني

309
00:18:51,120 --> 00:18:53,890
!لديها قوّة 48،000 و 3 حاسِمة

310
00:18:53,940 --> 00:18:55,880
هذا ما كنتِ تخفينه في جعبتكِ؟

311
00:18:55,970 --> 00:18:57,510
!خذي هذه

312
00:18:57,980 --> 00:19:00,180
!أُهاجم الفانغارد بواسطة ويزماي

313
00:19:00,320 --> 00:19:02,640
!بمهارتها، تكسب قوّة 15،000

314
00:19:03,200 --> 00:19:04,270
لا حِراسة

315
00:19:05,420 --> 00:19:06,560
تفقُّد الضّرر

316
00:19:08,560 --> 00:19:09,780
لا زِناد

317
00:19:12,240 --> 00:19:16,240
!ربحتُ! خلتُ حقّاً بأنّني لن أفعلها

318
00:19:16,780 --> 00:19:20,540
هزمتِني! تحمّستِ كثيراً في النّهاية

319
00:19:20,860 --> 00:19:22,830
!حقّاً؟ أنا آسفة جدّاً

320
00:19:22,980 --> 00:19:27,040
!أظنّني تكلّمتُ بوقاحة بضع مرّات
...كنتُ أتكلّم وكأنّني عبر الإنترنت

321
00:19:27,120 --> 00:19:29,300
!كنتُ أحاول أن أكون حريصة، لكن نسيت

322
00:19:29,360 --> 00:19:31,300
لا عليكِ، لا أمانع

323
00:19:31,740 --> 00:19:33,300
!كان ذلك مُمتعاً حقّاً

324
00:19:34,180 --> 00:19:36,590
!أعجبتِني حقّاً كيف ركبتِ الموجة

325
00:19:37,980 --> 00:19:40,800
لا عجب في أنّها المُقدَّرة دائمة التغيُّر

326
00:19:41,440 --> 00:19:45,770
عرفتُ ذلك منذ البداية، لكن جميع
الّذين سأواجههم أقوياء

327
00:19:46,800 --> 00:19:50,940
بالرُّغم من كلّ الاحتمالات، يجب
عليّ أن أبقى صامداً حتّى النِّهاية

328
00:19:55,660 --> 00:19:57,950
شكراً جزيلاً لك على اليوم

329
00:19:58,560 --> 00:20:01,450
سأراك في المدرسة يا آكينا

330
00:20:02,760 --> 00:20:04,000
أجل، إلى اللِّقاء

331
00:20:04,640 --> 00:20:07,540
!أنت، أنت، أنت! آكينا

332
00:20:08,660 --> 00:20:10,420
!لماذا أنت مع الآنسة ميكوتو؟

333
00:20:10,620 --> 00:20:12,550
...في الواقع، لأنّ

334
00:20:13,260 --> 00:20:15,260
!ماذا تعني بهذه الابتسامة للتو؟

335
00:20:15,460 --> 00:20:19,180
!آكينا؟! أخبرني يا آكينا

336
00:20:20,460 --> 00:20:22,810
،إذا ظللتَ تستخدم المُقدَّر صفر

337
00:20:23,020 --> 00:20:25,020
فلن ينتظرك سوى الموت في دربك

338
00:20:25,360 --> 00:20:28,650
إذا كنت لا تريد الموت، فانسحب
إذاً من الصِّراع المُقدَّر

339
00:20:29,460 --> 00:20:34,190
هل لديك سببٌ للقتال في الصِّراع
المُقدَّر ولو كلّفَك ذلك حياتك؟

340
00:20:35,040 --> 00:20:35,950
لا

341
00:20:36,040 --> 00:20:36,900
...إذاً

342
00:20:37,240 --> 00:20:38,780
ليس لديّ شيء

343
00:20:39,060 --> 00:20:43,000
لا سبب ولا رغبات ولا مخاوف ولا أي شيء

344
00:20:44,100 --> 00:20:48,210
لستُ حتّى مهتمّاً بها، لكن اختارَني القدر

345
00:20:49,640 --> 00:20:51,170
هذا هو السّبب الوحيد؟

346
00:20:51,480 --> 00:20:54,260
ليس عليك أن تفهم. ليس عليّ أن أفهم أيضاً

347
00:20:54,400 --> 00:20:57,470
إن لم تقتنع، فلندع القدر يقرِّر من جديد

348
00:20:59,020 --> 00:21:00,340
ماذا تقول؟

349
00:21:00,860 --> 00:21:03,430
سأسحب بطاقةً من هذه البطاقات

350
00:21:03,800 --> 00:21:05,440
هناك بطاقة مُقدَّرة واحدة

351
00:21:05,540 --> 00:21:08,980
إذا سحبتُ بطاقةً أخرى، فسوف
أتراجع كما تريدني أن أفعل

352
00:21:09,820 --> 00:21:14,690
،لكن إذا سحبتُ البطاقةَ المُقدَّرة
سوف أشارك في الصِّراع المُقدَّر

353
00:21:16,340 --> 00:21:17,400
اخلطهم

354
00:21:17,740 --> 00:21:20,780
ستترك مصيرك بين يدي هذه البطاقات؟

355
00:21:21,040 --> 00:21:23,660
...إذا كان هناك ما ينتظرني

356
00:21:31,640 --> 00:21:33,040
فلدينا إجابة

357
00:21:56,220 --> 00:21:57,990
دوري من الآن؟

358
00:23:31,300 --> 00:23:33,220
أهلاً بكم في كوك ميليون

359
00:23:33,260 --> 00:23:35,120
إنّه ذلك الدّيناصور الغريب

360
00:23:35,220 --> 00:23:37,750
هل يجدر بكِ أن تتكلّمي هكذا؟
يُبَثُّ هذا حول العالم

361
00:23:39,060 --> 00:23:42,760
هذه المرّة سأعرِّفكم على المُقدَّرة
دائمة التغيُّر، كريسراين

362
00:23:43,200 --> 00:23:46,090
بعد هجمة، يمكنها إعادة كافّة
،الحرس الخلفيّ إلى يدك

363
00:23:46,260 --> 00:23:48,100
وتستدعي بطاقةً من يدك

364
00:23:48,320 --> 00:23:51,930
قوّة وحسم تلك الوحدة تصبح مثل كريسراين

365
00:23:52,200 --> 00:23:54,270
هذه هي مهارتها الإلهيّة

366
00:23:54,640 --> 00:23:56,650
إنّها وحدة دائمة التغيُّر حقّاً

367
00:23:56,700 --> 00:23:57,520
اصمت

368
00:23:57,560 --> 00:23:59,230
...أنتِ تتغيّرين بسرعة أيضاً