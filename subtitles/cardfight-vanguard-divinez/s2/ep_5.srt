1
00:00:03,360 --> 00:00:05,120
!مُحال أن أخسر

2
00:00:05,360 --> 00:00:06,330
!خذوا هذه

3
00:00:07,060 --> 00:00:09,420
!لا تسحب! لا تسحب

4
00:00:12,260 --> 00:00:14,170
!تبّاً

5
00:00:17,130 --> 00:00:19,800
!كيف تجرؤ أيُّها السّافل؟

6
00:00:23,260 --> 00:00:26,930
الفوز من نصيبك اليوم، لكن سأكون
الرّقم 1 في قائمة مُتصدّري هذا الشّهر

7
00:00:27,360 --> 00:00:29,100
تذكّر ذلك

8
00:00:34,600 --> 00:00:36,440
ماذا؟ يونا؟

9
00:00:40,400 --> 00:00:43,490
بئس الأمر، كتبتُ اسمي الحقيقيّ بالخطأ

10
00:00:45,430 --> 00:00:46,950
الأرنب بيري؟

11
00:00:47,600 --> 00:00:51,500
لا أصدِّق بأنّنا كنّا نتنافس على قائمة
المُتصدّرين منذ عام إلى الآن

12
00:00:53,430 --> 00:00:55,730
أتساءل كيف هو شكله؟

13
00:00:56,430 --> 00:00:59,470
حسناً، سأهزمه ثانية في المرّة
المقبلة بكلّ تأكيد

14
00:01:04,000 --> 00:01:07,680
شكراً على مشاهدتي ليوم آخر

15
00:01:08,760 --> 00:01:09,840
!مي-تان

16
00:02:49,430 --> 00:02:50,540
ميكوتو

17
00:02:51,260 --> 00:02:53,170
أكينا

18
00:02:53,500 --> 00:02:56,760
إذاً هل خصمك هو صديقك يا ميكوتو؟

19
00:02:57,100 --> 00:03:00,380
في الواقع، لا أملك فكرة من تكون

20
00:03:01,260 --> 00:03:04,600
حتّى لو كانت خصمك المصيريّ؟-
هذا مثلي تماماً-

21
00:03:05,130 --> 00:03:07,470
ربّما لا أتذكّر من تكون فحسب؟

22
00:03:07,960 --> 00:03:10,890
بصراحة، لا أملك أدنى فكرة عمّن تكون

23
00:03:11,730 --> 00:03:13,980
!لكن لا يمكنني أن أتجاهلها فحسب

24
00:03:15,060 --> 00:03:19,400
.سأسحقها بكلّ ما أوتيت من قوّة
لكن هذا لإنقاذها بالطّبع

25
00:03:26,630 --> 00:03:28,830
...المُقدَّر دائم التغيُّر

26
00:03:29,730 --> 00:03:32,960
!لـ-لحظة، لحظة، هل هذه ميكوتو سايتو؟

27
00:03:33,060 --> 00:03:34,380
!لماذا مي-تان هنا؟

28
00:03:34,460 --> 00:03:37,420
!هل هي خصم يونا؟ هل جمعنا القدر؟

29
00:03:37,500 --> 00:03:42,180
هل نحن مرتبطتان بخيط المصير؟
هل هذا يعني أنّه رُسِم لنا هذا المسار؟

30
00:03:42,530 --> 00:03:45,140
!لحظة، هل عليّ مقاتلة مي-تان؟

31
00:03:45,330 --> 00:03:47,890
!هذا ليس تحدّياً، هذه مُكافأة

32
00:03:49,760 --> 00:03:51,270
!يونا

33
00:03:51,830 --> 00:03:53,810
هل يمكنكِ أن تُريني وظيفة الرّياضيّات خاصّتكِ؟

34
00:03:54,060 --> 00:03:56,730
!سيتمّ سؤالي اليوم

35
00:03:57,030 --> 00:04:00,100
أجل، تلك المُعلّمة تسأل التّلاميذ
بحسب اليوم

36
00:04:00,220 --> 00:04:00,860
تفضّلي

37
00:04:01,200 --> 00:04:03,070
!يونا، أنتِ الأفضل

38
00:04:03,160 --> 00:04:05,200
أنتِ مُجِدّة حقيقيّة يا يونا

39
00:04:05,330 --> 00:04:07,880
لا عجب في أنّكِ طالبة السّنة الأولى
الوحيدة في مجلس الطّلبة

40
00:04:08,030 --> 00:04:12,340
مهلاً، هذا طبيعيّ. أنا في مجلس الطّلبة
بفضل مُعدّل درجاتي فقط

41
00:04:12,410 --> 00:04:13,960
هذا لأنّكِ مُجِدّة في العمل

42
00:04:14,330 --> 00:04:18,420
في اللّيلة الماضية، كنتُ أشاهد فيديوهات
للشخصيّة المُفضّلة لديّ ونسيتُ الواجب

43
00:04:18,500 --> 00:04:21,590
هل لديك أي مشاهير مُفضّلين يا يونا؟

44
00:04:21,660 --> 00:04:24,130
...أنا؟ في الواقع

45
00:04:25,120 --> 00:04:26,850
!بالتّأكيد، مي-تان

46
00:04:27,270 --> 00:04:31,520
!إنّها حسناء وذكيّة وموهوبة
!إلَهة بسِمات وجه مثاليّة

47
00:04:31,800 --> 00:04:36,150
!مي-تان هي الآيدول الرّفيعة العظمى

48
00:04:36,350 --> 00:04:38,520
!وهذا لا يقتصر على مظهرها فقط

49
00:04:39,030 --> 00:04:42,440
بل هي مُجِدّة في العمل حيث
!يتحسّن أداؤها في كلّ عرض

50
00:04:42,520 --> 00:04:45,110
!إنّها ملاك تمنح المُعجبين ما يشاؤون

51
00:04:45,760 --> 00:04:48,620
!إنّها كشخصيّة مُقدّسة تنشر حبّها الذّاتيّ

52
00:04:48,720 --> 00:04:51,870
!قلبُها النّقيّ يُطهِّر العالم

53
00:04:52,260 --> 00:04:54,620
ستبقى النّجمة الألمع بالنّسبة لي

54
00:04:54,700 --> 00:04:57,420
!مجرّد رؤية جمالها يُطيل عمري

55
00:04:57,630 --> 00:04:58,630
من هي هذه؟

56
00:05:00,300 --> 00:05:03,880
في الواقع، تُدعى ميكوتو سايتو

57
00:05:04,400 --> 00:05:06,840
بدأتْ في الظّهور التّلفزيونيّ من جديد

58
00:05:07,430 --> 00:05:10,220
ارتأيتُ بأنّها جميلة وظريفة

59
00:05:14,400 --> 00:05:16,150
عدتُ يا مي-تان

60
00:05:16,460 --> 00:05:19,150
أهلاً بعودتكِ. أعلم بأنّكِ عملتِ بجدّ اليوم

61
00:05:20,130 --> 00:05:22,360
كذبتُ كذبة غبيّة ثانية

62
00:05:23,230 --> 00:05:27,200
لكن لم أكن أتكتّم عنكِ. لا أمانع
أن يعلموا بأنّني مُعجَبة

63
00:05:27,330 --> 00:05:30,410
كلّ ما في الأمر هو أنّني قلقة
من أن أبدو مُريبة

64
00:05:30,800 --> 00:05:34,660
يونا، أنتِ ظريفة، ولا شيء مُريب فيكِ

65
00:05:35,030 --> 00:05:37,290
لستُ ظريفة مثلكِ

66
00:05:39,460 --> 00:05:41,420
،لا أقصد التبجُّح

67
00:05:42,230 --> 00:05:46,380
لكن أعتقد كنتُ تلميذة جادّة تماماً
مقارنة بنظيراتي

68
00:05:47,160 --> 00:05:51,310
،كنتُ جيّدة في الدّراسة والرّياضة
وكنتُ أجتهد حتّى بعد انتهاء دوام المدرسة

69
00:05:52,230 --> 00:05:53,020
...لكن

70
00:05:53,560 --> 00:05:57,640
تعبتُ في النّهاية من الارتقاء لتوقُّعات
والِدَي والمُعلِّمين

71
00:05:58,660 --> 00:06:02,360
ليس وكأنّه كان لدي حلم
أو جامعة أريد الالتحاق بها

72
00:06:03,000 --> 00:06:05,690
فجأة، وجدتُ نفسي تائهة

73
00:06:06,660 --> 00:06:08,910
لماذا كنتُ أحاول أصلاً؟

74
00:06:09,590 --> 00:06:12,080
ما الّذي أردتُ فعله حتّى؟

75
00:06:14,960 --> 00:06:17,330
حينئذ اكتشفتُ فانغارد

76
00:06:18,800 --> 00:06:23,920
حقيقة أنّني كنتُ أحاول لأجل نفسي
!لا لأحد آخر كانت نعمة حقيقيّة

77
00:06:25,230 --> 00:06:26,300
...ثمّ

78
00:06:27,660 --> 00:06:30,220
لنتطلّع إلى المستقبل مهما كلّف الأمر

79
00:06:30,630 --> 00:06:32,640
هذا ما تعبِّر عنه هذه الأغنية

80
00:06:33,500 --> 00:06:36,730
...حسناً، أغنيتي التّالية تُدعى
"جديد كلّياً"

81
00:06:39,360 --> 00:06:41,520
انفجر شيء في داخلي

82
00:06:42,330 --> 00:06:46,070
ما هذا الشّعور الّذي في داخلي؟
لماذا أنا مُتحمِّسة جدّاً؟

83
00:06:46,860 --> 00:06:48,860
!لا أعلم، لكن أحبّها

84
00:06:49,600 --> 00:06:50,920
...لم أكن أعرف

85
00:06:51,160 --> 00:06:55,200
شعور محبّة شخص يمنحنا
الطّاقة لمواصلة العيش

86
00:06:56,360 --> 00:06:59,750
هذه الفتاة مثاليّة. إنّها رفيعة

87
00:07:00,830 --> 00:07:03,290
...أريد أن أصبح مثلها فحسب

88
00:07:05,660 --> 00:07:07,460
أريد أن أصبح رفيعة

89
00:07:08,130 --> 00:07:09,930
أريد أن أكون مي-تان

90
00:07:11,660 --> 00:07:13,390
يا لها من أمنية

91
00:07:13,800 --> 00:07:17,310
لكن مهما كانت أمنيتك، سوف أدعمكِ

92
00:07:17,900 --> 00:07:19,140
يونا ستفوز

93
00:07:19,930 --> 00:07:21,190
سوف أفعلها

94
00:07:25,460 --> 00:07:26,610
...سيبيلت

95
00:07:27,230 --> 00:07:31,860
هناك احتمال كبير أن يكون قد استحوذ
على مُشارك في الصّراع المُقدّر

96
00:07:32,960 --> 00:07:36,410
هل تمّ الاستحواذ على شخصٍ هنا حقّاً؟

97
00:07:36,960 --> 00:07:39,000
هل ذلك الشّخص يخدعنا؟

98
00:07:39,230 --> 00:07:42,170
لا، ربّما لم يتمّ السّيطرة على وعيه

99
00:07:42,430 --> 00:07:45,790
إذا كان هذا السّبب بأنَّ سيبيلت
...لا يزال بهيئة دُمية

100
00:07:47,360 --> 00:07:48,210
ما الأمر؟

101
00:07:48,360 --> 00:07:50,050
لا، لا شيء

102
00:07:50,900 --> 00:07:52,680
كيف سارت الأمور منذ ذلك الحين؟

103
00:07:53,230 --> 00:07:54,510
أي أمور؟

104
00:07:54,960 --> 00:07:58,850
الأمور مع هيكاري بالطّبع! هل
تكلّمتُما عن الأمر كما ينبغي؟

105
00:07:59,060 --> 00:08:02,140
ليس بعد... من الصّعب التقرّب منها

106
00:08:02,540 --> 00:08:06,520
،لكن كن حذراً، لأنّه كلّما طال الأمر
كان من الصّعب إصلاح ذلك

107
00:08:06,960 --> 00:08:12,030
أجل، ليس وكأنّ الفوز بهذه المعركة
سوف يحلّ كافّة مشاكلنا

108
00:08:12,530 --> 00:08:14,200
ماذا ينبغي أن أفعل برأيك؟

109
00:08:14,330 --> 00:08:15,740
...لنرَ

110
00:08:15,960 --> 00:08:17,740
تعطيها مالاً؟-
مُحال-

111
00:08:17,930 --> 00:08:19,410
!بئساً

112
00:08:21,460 --> 00:08:24,000
يسرّني بأنّكِ لا تبدين مُتوتِّرة

113
00:08:24,100 --> 00:08:25,790
أنا مُتوتِّرة

114
00:08:25,900 --> 00:08:29,550
لكن كلّ ما يمكنني فعله هو أن أكون
على طبيعتي وأبذل جهدي

115
00:08:29,990 --> 00:08:32,760
فهمت... أصبحتِ شخصاً يُعتمَد عليه

116
00:08:33,030 --> 00:08:34,200
!راقبوني

117
00:08:34,540 --> 00:08:35,970
!سوف أقاتل

118
00:08:40,230 --> 00:08:41,730
!هيّا بنا يا ميكوتو

119
00:08:41,800 --> 00:08:43,440
!اقضي عليها بسرعة

120
00:08:43,560 --> 00:08:44,730
!حسناً

121
00:08:45,130 --> 00:08:46,940
،أنا، ميكوتو سايتو

122
00:08:47,200 --> 00:08:50,980
بقدر ما أنا ضعيفة، سوف أبذل
!قصارى جهدي لتحقيق النّصر

123
00:08:52,100 --> 00:08:54,280
!مي-تان تمزح مع أصدقائها

124
00:08:54,330 --> 00:08:57,490
هل هم أصدقاؤها من المدرسة؟
!كم أحسدهم

125
00:08:58,230 --> 00:09:00,580
اسمي ميكوتو سايتو، سررتُ بلقائكِ

126
00:09:00,660 --> 00:09:02,750
!ا-اسمي يونا سايونجي

127
00:09:03,100 --> 00:09:05,750
!شرف لي أن أقاتلكِ يا ميكوتو

128
00:09:06,100 --> 00:09:07,880
!أجل، أنا أيضاً

129
00:09:08,300 --> 00:09:12,460
هل هي أحد المُعجبين بي؟ ألهذا
السّبب هي خصمي المصيريّ؟

130
00:09:12,960 --> 00:09:17,010
.لكن لا أستطيع أن أسألها ذلك فحسب
سيكون من المُحرج جدّاً أن أكون مُخطِئة

131
00:09:17,460 --> 00:09:20,720
!أتكلّم مع مي-تان الحقيقيّة! يا إلهي

132
00:09:20,960 --> 00:09:24,100
ميكوتو سايتو، يونا سايونجي

133
00:09:25,800 --> 00:09:28,770
!واصرخا عالياً مُعلنتَين عن بدء هذه الحرب

134
00:09:29,230 --> 00:09:31,530
لنحسم مصيرنا

135
00:09:32,900 --> 00:09:34,150
!ديفاين

136
00:09:36,230 --> 00:09:37,490
حان الوقت

137
00:09:37,960 --> 00:09:41,740
فلنبدأ بالجولة الرّابعة من المواجهة المصيريّة

138
00:09:42,060 --> 00:09:44,410
!نهوض، فانغارد

139
00:09:48,100 --> 00:09:50,050
اللّافندر الأعجوبة، يوروسول

140
00:09:50,600 --> 00:09:52,550
الحُلوة السّاطعة، ميليز

141
00:09:53,260 --> 00:09:55,760
دوري. أركب تيفايني

142
00:09:56,100 --> 00:09:57,180
انتهى دوري

143
00:09:57,560 --> 00:10:01,190
إنّه دروي. أركب الشُّعاع الأروع، فيليا

144
00:10:01,630 --> 00:10:03,610
أستدعي يونيت وآيلين

145
00:10:04,000 --> 00:10:05,270
أُهاجم بواسطة آيلين

146
00:10:05,700 --> 00:10:06,400
حِراسة

147
00:10:06,830 --> 00:10:07,900
أُهاجم بواسطة فيليا

148
00:10:08,300 --> 00:10:09,280
بلا حِراسة

149
00:10:09,960 --> 00:10:11,150
أُهاجم بواسطة آيلين

150
00:10:11,600 --> 00:10:12,360
حِراسة

151
00:10:12,930 --> 00:10:13,990
انتهى دوري

152
00:10:14,330 --> 00:10:17,540
!يا إلهي! هاجمتُ مي-تان

153
00:10:17,650 --> 00:10:20,620
!لحظة، لا أصدِّق بأنّني أقاتلها فعلاً

154
00:10:21,230 --> 00:10:22,170
دوري

155
00:10:22,760 --> 00:10:24,080
أركب موزيت

156
00:10:24,560 --> 00:10:27,420
.بمهارتها، أستدعي روتشيل
أُهاجم بواسطة موزيت

157
00:10:27,900 --> 00:10:28,840
بلا حِراسة

158
00:10:29,230 --> 00:10:30,550
أُهاجم بواسطة روتشيل

159
00:10:30,860 --> 00:10:31,630
حِراسة

160
00:10:32,000 --> 00:10:32,970
انتهى دوري

161
00:10:33,260 --> 00:10:34,300
ما هذا؟

162
00:10:34,420 --> 00:10:37,010
ربّما لأنّني اعتدتُ على معارك
،البِطاقات الحقيقيّة

163
00:10:37,130 --> 00:10:39,640
لكن هذه المعركة تبدو أكثر
حقيقيّة من المعتاد

164
00:10:40,600 --> 00:10:41,770
دوري

165
00:10:42,100 --> 00:10:43,940
أركب الطُّعم النّاضج، لوتيكا

166
00:10:44,400 --> 00:10:47,940
بمهارتها، أسحب بطاقة وأضع بطاقة
من يدي في الصّول

167
00:10:48,130 --> 00:10:51,320
!تكسب لاتيكا قوّة 5000. أستدعي ميلتي

168
00:10:51,500 --> 00:10:54,490
بمهارتها، أستدعي ألبيلينا، وأسحب بطاقة

169
00:10:55,060 --> 00:10:56,200
أُهاجم بواسطة ألبيلينا

170
00:10:56,600 --> 00:10:57,280
حِراسة

171
00:10:57,530 --> 00:10:58,790
أُهاجم بواسطة لاتيكا

172
00:10:59,230 --> 00:11:00,200
بلا حِراسة

173
00:11:00,830 --> 00:11:01,960
أُهاجم بواسطة ميلتي

174
00:11:02,430 --> 00:11:03,420
بلا حِراسة

175
00:11:03,730 --> 00:11:04,670
انتهى دوري

176
00:11:05,060 --> 00:11:09,000
هذا مُمتع للغاية! يراودني شعور
!رائع وأنا أُقاتل شخصيّتي المُفضّلة

177
00:11:09,230 --> 00:11:11,510
!عسى أن يدوم هذا الوقت للأبد

178
00:11:11,900 --> 00:11:13,460
أتعلمين؟ هذا مُسلٍّ

179
00:11:13,630 --> 00:11:16,550
أنتِ أيضاً يا مي-تان؟ أقصد ميكوتو؟

180
00:11:16,800 --> 00:11:18,100
أجل، هذا مُسلٍّ

181
00:11:18,500 --> 00:11:20,140
تبدأ المعركة الحقيقيّة الآن

182
00:11:20,230 --> 00:11:22,480
أنتِ تواجهينني أنا، دائمة التغيُّر

183
00:11:22,930 --> 00:11:25,190
!حسناً، تابعي وهاجميني بلا توقُّف

184
00:11:25,460 --> 00:11:27,610
فأساساً، النّهوض والعودة
!تجعلان هذه اللّعبة رائعة

185
00:11:28,860 --> 00:11:30,980
أنا سمعتُ هذا من قبل؟

186
00:11:31,300 --> 00:11:34,740
المعذرة، هل قالت يونا كلاماً غريباً؟

187
00:11:34,960 --> 00:11:37,320
!ماذا؟ لا، أبداً

188
00:11:37,700 --> 00:11:38,530
يونا؟

189
00:11:39,060 --> 00:11:42,040
أجل، هذا الاسم مألوف بالنّسبة لي

190
00:11:43,160 --> 00:11:45,040
...يونا... يونا

191
00:11:47,360 --> 00:11:48,740
!يونا؟

192
00:11:49,260 --> 00:11:52,050
!لحظة، هل أنتِ رجل العودة؟

193
00:11:52,700 --> 00:11:54,880
!ما-ما أدراكِ بهذا الاسم؟

194
00:11:55,130 --> 00:11:56,930
لأنّني الأرنب بيري

195
00:11:57,000 --> 00:12:00,390
ماذا؟ الأرنب بيري كان أنتِ يا مي-تان؟

196
00:12:02,030 --> 00:12:06,310
يا لها من صدفة. لا عجب في أنّكِ
خصمي المصيريّ

197
00:12:06,730 --> 00:12:08,690
مستحيل، لا أصدِّق هذا

198
00:12:09,390 --> 00:12:14,110
الأرنب بيري الوقح والمغرور سليط
!اللّسان كان مي-تان؟

199
00:12:14,230 --> 00:12:15,660
!أنتِ تتمادين

200
00:12:15,740 --> 00:12:17,860
!هل سمعتِ صوتي الدّاخليّ؟

201
00:12:18,460 --> 00:12:21,740
يبدو أنّهما مستمتعتان-
لحظة، ألا تتجادلان؟-

202
00:12:22,200 --> 00:12:24,200
!أنا مُتحفِّزة حقّاً الآن

203
00:12:24,700 --> 00:12:26,540
!جاهزة؟ إنّه دوري

204
00:12:26,930 --> 00:12:30,250
!تألّق! أيُّها المِشكال العاكِس دائم التغيُّر

205
00:12:30,500 --> 00:12:35,170
!أركب المُقدَّر دائم التغيُّر، كريسراين

206
00:12:39,430 --> 00:12:41,180
بمهارته، أستدعي ويزماي

207
00:12:41,640 --> 00:12:42,970
أستدعي أنيس

208
00:12:43,200 --> 00:12:46,230
بمهارتها، أنظر إلى أعلى خمس بِطاقات
في مجموعتي، وأستدعي ألبينا

209
00:12:46,800 --> 00:12:48,560
تتفعّل مهارة كريسراين

210
00:12:48,930 --> 00:12:53,190
،لديّ خمسة أنواع من الوحدات
لذا تتفعّل ثلاثة تأثيرات

211
00:12:53,830 --> 00:12:57,400
أوّلاً، أسحب بطاقة وأشحن ثلاث
بِطاقات بالطّاقة

212
00:12:58,000 --> 00:13:01,280
ثانياً، تحصل أنيس على قوّة 15،000

213
00:13:01,790 --> 00:13:05,080
ثالثاً، تحصل كريسراين على حاسمة إضافيّة

214
00:13:06,200 --> 00:13:08,330
إذاً هذا هو المُقدَّر دائم التغيُّر

215
00:13:08,930 --> 00:13:10,210
أُهاجم بواسطة ويزماي

216
00:13:10,500 --> 00:13:11,630
بلا حِراسة

217
00:13:12,260 --> 00:13:13,590
أُهاجم بواسطة أنيس

218
00:13:13,960 --> 00:13:14,960
بلا حِراسة

219
00:13:15,600 --> 00:13:17,800
!أُهاجم الفانغارد بواسطة كريسراين

220
00:13:18,600 --> 00:13:20,340
تتفعّل مهارة روتشيل

221
00:13:20,960 --> 00:13:23,700
بوضع نفسها في الصُّول، أسحب بطاقة

222
00:13:23,760 --> 00:13:27,730
أضع أنيس في وضع الوقوف، الحرس
المُختارون بواسطة مهارة كريسراين

223
00:13:28,300 --> 00:13:30,100
!حِراسة! اعتراض

224
00:13:30,860 --> 00:13:32,060
التفقُّد الأوّل

225
00:13:32,560 --> 00:13:33,820
التفقُّد الثّاني

226
00:13:34,130 --> 00:13:35,230
!تريغا شفاء

227
00:13:35,860 --> 00:13:39,570
أشفي 1 ضرراً. تحصل أنيس
على قوّة 10،000

228
00:13:40,200 --> 00:13:41,490
!أُهاجم بواسطة أنيس

229
00:13:41,730 --> 00:13:42,740
بلا حِراسة

230
00:13:43,930 --> 00:13:45,040
انتهى دوري

231
00:13:46,480 --> 00:13:48,870
أنقصتْ بطاقات يدي وألحقتْ 4 ضرراً

232
00:13:49,400 --> 00:13:50,460
إنّها قويّة

233
00:13:50,960 --> 00:13:52,830
...إنّها حقّاً الأرنب بيري

234
00:13:53,430 --> 00:13:55,130
!رغم ظرافتها الشّديدة

235
00:13:55,560 --> 00:13:57,090
ماذا؟

236
00:13:58,200 --> 00:14:01,970
لا شيء... ارتأيتُ فقط بأنّ كريسراين بطاقة جميلة

237
00:14:02,430 --> 00:14:05,220
إنّها مثاليّة مثلكِ يا مي-تان

238
00:14:05,600 --> 00:14:08,680
أنا؟ أنا أبعد ما يمكن عن المثاليّة

239
00:14:09,000 --> 00:14:10,520
!أنتِ مثاليّة يا مي-تان

240
00:14:11,060 --> 00:14:14,650
شكراً، لكن أتعلمين ماذا؟
الأمر ليس كذلك

241
00:14:15,160 --> 00:14:16,980
ماذا كان رأيكِ بالأرنب بيري؟

242
00:14:17,800 --> 00:14:19,690
هذه حقيقتي أيضاً

243
00:14:20,460 --> 00:14:23,700
أنا أيضاً، كنتُ أريد أن أكون مثاليّة

244
00:14:24,130 --> 00:14:25,660
لكن حينئذ أدركت

245
00:14:26,030 --> 00:14:28,080
لم تكن هناك حاجة لأكون مثاليّة

246
00:14:30,000 --> 00:14:31,620
لا، أنتِ مُخطئة

247
00:14:32,700 --> 00:14:33,880
!لا تقولي ذلك

248
00:14:34,660 --> 00:14:36,250
قدّستُكِ

249
00:14:36,500 --> 00:14:40,470
مي-تان الّتي أريد أن أكون مثلها
باستماتة، هي كائن رفيع

250
00:14:41,030 --> 00:14:44,140
،حتّى لو استسلمتِ يا مي-تان
لن أستسلم أنا

251
00:14:45,000 --> 00:14:48,180
يونا سوف تصبح مي-تان
!الّتي حلمتُ بها

252
00:14:48,560 --> 00:14:49,640
!ماذا؟

253
00:14:51,060 --> 00:14:53,940
!الأرنب بيري، سوف أسقطكِ هنا والآن

254
00:14:54,730 --> 00:14:55,690
!دوري

255
00:14:56,160 --> 00:14:58,440
!أطمح لأصبح الحقيقيّة الوحيدة

256
00:14:58,930 --> 00:15:02,200
!أركب المصيريّ الرّفيع، ليشيافيل

257
00:15:09,330 --> 00:15:10,580
،بمهارة لوتيكا

258
00:15:11,030 --> 00:15:13,000
أسحب بطاقة وأشحن الصّول

259
00:15:13,730 --> 00:15:14,830
أستدعي آمفي

260
00:15:15,260 --> 00:15:18,000
بمهارتها، أسحب بطاقة. تكسب قوّة 5000

261
00:15:18,560 --> 00:15:20,510
أستدعي ألبيلينا وريشيوز

262
00:15:20,930 --> 00:15:23,500
بمهارتها، تحصل ليشيافيل على قوّة 10،000

263
00:15:23,600 --> 00:15:24,340
!ها هي ذي

264
00:15:25,000 --> 00:15:26,090
!أُهاجم بواسطة آمفي

265
00:15:26,360 --> 00:15:27,220
حِراسة

266
00:15:27,600 --> 00:15:28,970
أُهاجم بواسطة ألبيلينا

267
00:15:29,340 --> 00:15:30,180
حِراسة

268
00:15:30,500 --> 00:15:33,850
يونا ستهزم الأرنب بيري وتصبح
!مي-تان الحقيقيّة

269
00:15:34,500 --> 00:15:37,020
!أُهاجم الفانغارد بواسطة ليشيافيل

270
00:15:37,730 --> 00:15:38,770
تتفعّل مهارتها

271
00:15:39,100 --> 00:15:41,110
أضع آمفي وريشيوز في الصُّول

272
00:15:41,300 --> 00:15:45,910
أثناء هذا الدّور، تحصل ليشيافيل على
قوّة 10،000 ودرايف إضافيّ

273
00:15:46,100 --> 00:15:49,200
،بالإضافة إلى ذلك، بمهارة آمفي
تكسب قوّة 5000

274
00:15:49,600 --> 00:15:50,900
،بمهارة ألبيلينا

275
00:15:50,970 --> 00:15:53,660
تدخل في وضع الوقوف وتكسب قوّة 10،000

276
00:15:53,760 --> 00:15:54,790
بلا حِراسة

277
00:15:55,160 --> 00:15:56,340
!درايف ثُلاثيّ

278
00:15:56,580 --> 00:15:57,710
التفقُّد الأوّل

279
00:15:58,500 --> 00:15:59,710
التفقُّد الثّاني

280
00:16:00,550 --> 00:16:01,710
التفقُّد الثّالث

281
00:16:02,060 --> 00:16:03,010
!تريغا شِفاء

282
00:16:03,400 --> 00:16:07,180
أشفي 1 ضرراً. تحصل ألبيلينا
!على قوّة 10،000

283
00:16:09,000 --> 00:16:11,720
!يبلغ حفل يونا ذروته

284
00:16:12,100 --> 00:16:15,850
!تمّ اكتساب السّيادة! تتفعّل مهارتها الإلهيّة

285
00:16:16,830 --> 00:16:18,620
،عندما يكون هناك أكثر من ستّة في الصُّول

286
00:16:18,700 --> 00:16:21,480
يمكنني وضع ليشيافيل ودرايف ناقص 2

287
00:16:22,000 --> 00:16:25,900
علاوة على ذلك، تحصل ليشيافيل
،على قوّة 5000 في بقيّة هذه المعركة

288
00:16:26,100 --> 00:16:27,570
وحاسمة إضافيّة

289
00:16:27,900 --> 00:16:31,580
قوّة دائمة وتعزيز حاسم علاوة
!على الهجوم الإضافيّ؟

290
00:16:32,060 --> 00:16:35,500
يجب على الوجود الرّفيع أن يستمرّ
!في التألُّق في القمّة

291
00:16:36,500 --> 00:16:40,340
!مرّة أخرى، أُهاجم الفانغارد بواسطة ليشيافيل

292
00:16:41,530 --> 00:16:45,090
لن أتمكّن من الحِراسة إذا سحبَتْ
...تريغا. في هذه الحالة

293
00:16:45,730 --> 00:16:47,180
!استجمعي شجاعتك...

294
00:16:47,760 --> 00:16:49,800
بلا حِراسة-
!تفقُّد الدرايف-

295
00:16:50,730 --> 00:16:51,720
تريغا السّحب

296
00:16:52,530 --> 00:16:54,930
!تحصل ألبيلينا على قوّة 10،000

297
00:16:57,460 --> 00:16:59,020
أُهاجم بواسطة ألبيلينا

298
00:16:59,660 --> 00:17:00,530
حِراسة

299
00:17:00,900 --> 00:17:03,320
انتهى دوري. انقلبت الطّاولة الآن

300
00:17:03,900 --> 00:17:08,450
.سأقضي عليك في دوري المقبل
!يونا سوف تُحقِّق أمنيتها

301
00:17:10,400 --> 00:17:11,660
أتعلمين؟

302
00:17:12,260 --> 00:17:15,410
الأمنية الّتي أردتُ تحقيقها
...في الصِّراع المُقدَّر

303
00:17:15,830 --> 00:17:18,960
كانت أن أصبح شخصاً يستطيع
استجماع شجاعته

304
00:17:20,590 --> 00:17:24,550
أنا ضعيفة وخجولة وأبعد
ما يمكن عن المثاليّة

305
00:17:24,930 --> 00:17:27,720
لهذا أعلم بأنّه يجب عليّ
المُحاولة في كلّ يوم

306
00:17:28,100 --> 00:17:31,590
لكن خمِّني ما الّذي حقّقَ أمنيتي؟

307
00:17:31,800 --> 00:17:34,930
لم يكن الصّراع المُقدّر. كان مُعجبيّي

308
00:17:35,760 --> 00:17:37,730
،عندما خطوتُ الخطوة الأولى

309
00:17:38,160 --> 00:17:40,100
مدّني المُعجبون بي بكثير من الشّجاعة

310
00:17:40,660 --> 00:17:44,440
قالوا بأنّهم يحبّونني على حقيقتي

311
00:17:45,300 --> 00:17:48,360
،لهذا السّبب، مهما كنتُ بائسة أحياناً

312
00:17:48,560 --> 00:17:50,860
يمكنني مُواصلة المحاولة

313
00:17:52,060 --> 00:17:56,870
أشعر وكأنّني أستطيع مواجهة أيّ شيء
مع الأشخاص الّذين يدعمونني

314
00:17:57,930 --> 00:18:02,960
قد أكون خرقاء، وسيّئة أحياناً، وأسمح
،لعواطفي أن تسيطر عليّ

315
00:18:03,430 --> 00:18:05,250
!لكن هذا يمثِّل حقيقتي

316
00:18:05,900 --> 00:18:07,800
...مي-تان الحقيقيّة

317
00:18:08,000 --> 00:18:08,820
ماذا عنكِ؟

318
00:18:08,920 --> 00:18:10,470
ماذا؟ أنا؟

319
00:18:11,100 --> 00:18:14,600
،طوال الوقت الّذي كنّا فيه نتبارز على الإنترنت

320
00:18:14,790 --> 00:18:18,330
لطالما تخيّلتُكِ تشبهينني تماماً

321
00:18:18,560 --> 00:18:20,180
يونا تشبه مي-تان؟

322
00:18:21,560 --> 00:18:24,560
لكن تخطئين عندما تقولين بأنّكِ
تريدين أن تكوني أنا

323
00:18:24,630 --> 00:18:25,900
لن أسمح بذلك

324
00:18:26,200 --> 00:18:29,400
!عليكِ أن تكوني يونا سايونجي دون غيرها

325
00:18:30,900 --> 00:18:33,200
دوري. أستدعي واليس

326
00:18:33,760 --> 00:18:35,030
،بمهارة كريسراين

327
00:18:35,330 --> 00:18:37,490
أسحب بطاقة وأشحن بالطّاقة

328
00:18:37,930 --> 00:18:42,000
بالإضافة إلى ذلك، تكسب كريسراين
قوّة 15،000 وحاسمة إضافيّة

329
00:18:42,460 --> 00:18:43,540
أستدعي ألبينا

330
00:18:44,030 --> 00:18:45,170
!أُهاجم بواسطة أنيس

331
00:18:45,660 --> 00:18:46,670
بلا حِراسة

332
00:18:47,300 --> 00:18:48,630
!أُهاجم بواسطة ويزماي

333
00:18:49,130 --> 00:18:50,130
!بلا حِراسة

334
00:18:50,700 --> 00:18:53,510
!أُهاجم الفانغارد بواسطة كريسراين

335
00:18:54,460 --> 00:18:55,850
!حِراسة مثاليّة

336
00:18:58,530 --> 00:18:59,720
التفقُّد الأوّل

337
00:19:00,160 --> 00:19:01,270
التفقُّد الثّاني

338
00:19:01,660 --> 00:19:02,810
!تريغا السّحب

339
00:19:03,330 --> 00:19:05,440
!تحصل كريسراين على قوّة 10،000

340
00:19:06,900 --> 00:19:08,270
!الحسناء دائمة التغيُّر

341
00:19:08,360 --> 00:19:10,780
!تتفعّل مهارتها الإلهيّة

342
00:19:12,630 --> 00:19:15,620
،أعيد كافّة حرسي الخلفيّ إلى يدي

343
00:19:15,760 --> 00:19:17,620
!وأستدعي البرتقالة البريئة، أنيس

344
00:19:18,200 --> 00:19:21,580
!والآن، أجعل قوّتها مثل قوّة كريسراين

345
00:19:22,900 --> 00:19:24,710
!تغيّرتْ هالتُها

346
00:19:27,600 --> 00:19:30,590
انظري إلى الصّورة بكاملها
وابحثي عن طريقة للفوز

347
00:19:30,750 --> 00:19:32,840
اغرفي قطرةَ الأمل الصّغيرة تلك

348
00:19:34,760 --> 00:19:36,010
،بمهارة أنيس

349
00:19:36,260 --> 00:19:38,140
...أنظر إلى أعلى خمس بطاقات في مجموعتي

350
00:19:42,460 --> 00:19:45,270
!هذه أنتِ... أستدعي سيا

351
00:19:45,400 --> 00:19:46,270
!سيا؟

352
00:19:46,800 --> 00:19:51,480
تسمح لي مهارتها عند الظُّهور باستدعاء
حرس خلفيّ من قمّة مجموعة بطاقاتي

353
00:19:52,160 --> 00:19:55,060
لا أصدِّق بأنّكِ تُراهنين على مثل
هذه البطاقة غير المضمونة

354
00:19:55,230 --> 00:19:58,950
أريد النّظر إلى المستقبل مهما كان الظّرف صعباً

355
00:19:59,660 --> 00:20:03,160
!لن أتوقّف عن خوض تحدِّيات وتطوير نفسي

356
00:20:03,600 --> 00:20:05,670
...أنظر إلى أعلى بطاقة في مجموعتي

357
00:20:06,730 --> 00:20:09,460
!أجل، فهمت

358
