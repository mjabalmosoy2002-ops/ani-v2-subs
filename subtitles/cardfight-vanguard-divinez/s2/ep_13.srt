187
00:10:16,720 --> 00:10:18,360
!توقّف

188
00:10:21,160 --> 00:10:23,490
!أعِد إليّ ناو

189
00:10:24,930 --> 00:10:26,500
!إنّها قوّة الشّفاء

190
00:10:33,900 --> 00:10:35,010
!ناو

191
00:10:37,460 --> 00:10:38,500
!دع الأمر لي

192
00:10:39,040 --> 00:10:40,680
!تفعيل الاستدعاء

193
00:11:00,580 --> 00:11:02,620
البوّابة مُتّصلة

194
00:11:06,660 --> 00:11:08,080
غابويليوس

195
00:11:08,600 --> 00:11:11,420
سيبيلت، لنُنهِ هذا

196
00:11:11,930 --> 00:11:13,420
لا أستطيع أن أدع الأمر ينتهي

197
00:11:13,660 --> 00:11:17,550
ينبغي لكلّ الكائنات الحيّة أن تكون
أنانيّة وتعيش وفقاً لرغباتها

198
00:11:18,130 --> 00:11:22,050
هذا صحيح... كلّ الكائنات الحيّة لديها رغبات

199
00:11:22,830 --> 00:11:24,300
،لكن في نفس الوقت

200
00:11:24,860 --> 00:11:27,430
يمكنهم أيضاً الاهتمام بالآخرين

201
00:11:28,760 --> 00:11:33,810
كانت غلطتك تكمن في الافتراض بأنّ وجهاً
واحداً من الكائنات الحيّة يُمثِّل الحقيقة

202
00:11:34,800 --> 00:11:38,400
فقدت عقلانيّتك وجدسك، وأصبحت روحاً فقط

203
00:11:38,490 --> 00:11:40,320
ومع ذلك كرّرت المأساة

204
00:11:40,530 --> 00:11:42,860
،فعلتَ ما لا يُغتفَر

205
00:11:43,030 --> 00:11:45,370
يا تنّيني المُنسجم الوحيد

206
00:12:19,030 --> 00:12:20,320
هكذا إذاً

207
00:12:21,360 --> 00:12:25,370
يبدو... أنّني قطعتُ طريقاً طويلاً

208
00:12:26,900 --> 00:12:28,660
ينتظرك نوم أبديّ

209
00:12:35,630 --> 00:12:36,960
،سبيرود

210
00:12:37,660 --> 00:12:38,880
...أنا قد

211
00:12:46,260 --> 00:12:47,640
هل انتهى الأمر؟

212
00:12:47,960 --> 00:12:50,220
...أجل، الآن

213
00:12:53,260 --> 00:12:55,270
!سوف ينهار! اهربوا

214
00:12:58,400 --> 00:12:59,320
!بسرعة

215
00:13:02,560 --> 00:13:03,570
!أخي

216
00:13:03,660 --> 00:13:05,410
!المكان خطير هنا! بسرعة

217
00:13:05,930 --> 00:13:07,570
!تبّاً، ماذا أفعل؟

218
00:13:07,900 --> 00:13:09,120
أكينا ميودو

219
00:13:09,430 --> 00:13:10,790
تعال إليّ

220
00:13:41,300 --> 00:13:43,070
يجب أن أذهب

221
00:13:43,730 --> 00:13:45,400
اعتنِ بناو إينابي

222
00:13:45,730 --> 00:13:47,490
-انتظر لحـ

223
00:13:48,630 --> 00:13:50,370
وقد اختفى

224
00:13:51,930 --> 00:13:53,040
آكي؟

225
00:13:55,430 --> 00:13:58,060
ناو، هل أنتِ بخير؟

226
00:13:58,260 --> 00:14:00,500
هل تأذّيتِ؟

227
00:14:00,860 --> 00:14:02,050
أنا بخير

228
00:14:04,460 --> 00:14:06,260
انتهى الأمر، صحيح؟

229
00:14:06,730 --> 00:14:07,590
أجل

230
00:14:08,160 --> 00:14:10,300
سبّبتُ لك الكثير من المتاعب

231
00:14:11,200 --> 00:14:12,560
!إطلاقاً

232
00:14:15,530 --> 00:14:17,060
تذكّرتُ شيئاً

233
00:14:17,760 --> 00:14:19,480
كان أنتِ يا ناو

234
00:14:19,730 --> 00:14:22,270
،أنتِ من أنقذ هيكاري في ذلك الوقت

235
00:14:23,130 --> 00:14:25,190
ومن علّمني ذلك الاقتباس

236
00:14:26,300 --> 00:14:29,320
أجل، تذكّرتُه أيضاً

237
00:14:30,400 --> 00:14:34,740
تمكّنتُ من عدم الاستسلام بفضلكِ يا ناو

238
00:14:35,560 --> 00:14:39,330
لطالما أرشدتِني يا ناو

239
00:14:40,530 --> 00:14:41,750
أتعلم ماذا؟

240
00:14:42,860 --> 00:14:46,920
كنتُ صاحية بعض الشّيء بينما كان
سيبيلت يستحوذ عليّ

241
00:14:48,360 --> 00:14:50,590
شكراً على إنقاذي

242
00:14:50,900 --> 00:14:53,300
كنتَ رائعاً حقّاً يا أكينا

243
00:14:55,130 --> 00:14:56,270
!أخي

244
00:14:56,330 --> 00:14:59,440
!ناو إينابي، أين أنت؟ -
!أكينا -

245
00:15:00,560 --> 00:15:02,730
إنّهم يبحثون عنّا -
أجل -

246
00:15:06,100 --> 00:15:07,320
هل يمكنك النّهوض؟

247
00:15:08,080 --> 00:15:10,260
...أجل، هيّا بنا

248
00:15:10,880 --> 00:15:12,240
لرؤية الجميع...

249
00:15:15,360 --> 00:15:16,960
!أُهاجم بواسطة ليفيدراس

250
00:15:17,500 --> 00:15:18,590
انتهى دوري

251
00:15:18,960 --> 00:15:20,260
أنت قويّ حقّاً

252
00:15:20,630 --> 00:15:22,170
لن أخسر هذه المرّة

253
00:15:22,630 --> 00:15:25,430
أتعلم؟ يبدو هذا كالأيّام الخوالي

254
00:15:26,060 --> 00:15:29,180
ما زلتُ لم أتمكّن تذكُّر كلّ شيء

255
00:15:30,560 --> 00:15:32,850
لكن رغم ذلك، هذا ساخن

256
00:15:34,560 --> 00:15:35,850
...هذا الإحساس

257
00:15:36,430 --> 00:15:38,690
هذا يبعث على الحنين بطريقة ما

258
00:15:42,430 --> 00:15:44,400
جاهز؟ دوري

259
00:15:48,060 --> 00:15:49,580
اقترب الوقت

260
00:15:49,700 --> 00:15:52,200
لا أريد حقّاً حضور هذا الاجتماع التّالي

261
00:15:52,530 --> 00:15:54,290
حسناً، ساندني، اتّفقنا؟

262
00:15:54,530 --> 00:15:56,430
لا تنظر إليّ طلباً للمساعدة

263
00:15:56,500 --> 00:15:58,380
أين روح الفريق؟

264
00:15:58,700 --> 00:16:00,920
ساعدني في البطولة المقبلة أيضاً

265
00:16:01,400 --> 00:16:05,590
من جديد؟ أرسل إليّ بيانات الفريق
الخصم لاحقاً

266
00:16:09,200 --> 00:16:11,260
ما كان رأيك في ذلك؟

267
00:16:11,700 --> 00:16:16,020
في أنّ العالم مليء بالرّغبات الّتي
كان سيبيلت يحاول تحقيقها

268
00:16:16,400 --> 00:16:18,600
بصراحة، كان ذلك ليكون مُقزِّزاً

269
00:16:18,700 --> 00:16:21,930
ليست كذلك. تلك ليست نوعيّة
الرّغبات الّتي أحبّها

270
00:16:22,500 --> 00:16:25,400
ماسانوري، هل يمكنك مساعدتي ثانية؟

271
00:16:25,630 --> 00:16:29,200
هل أنت متأكّد من ذلك؟ قد أبدأ
بالتّخطيط للأمور ثانية

272
00:16:29,960 --> 00:16:31,780
ألست مهتمّاً بذلك؟

273
00:16:32,330 --> 00:16:35,410
معركة البِطاقات الّتي كافح شينغي موكاي لأجلها؟

274
00:16:36,760 --> 00:16:39,790
من كان يعلم بأنّنا كنّا قد التقينا في الماضي؟

275
00:16:40,300 --> 00:16:42,920
في الواقع، كان ذلك فقط عندما كنّا صغاراً

276
00:16:43,100 --> 00:16:45,970
سيكون من الغريب لو أنّك تذكّرته مثل كون

277
00:16:46,050 --> 00:16:47,930
إنّه عبقريّ بالفعل

278
00:16:48,100 --> 00:16:50,010
!هنا، هنا

279
00:16:52,660 --> 00:16:55,180
!مي-تان وهيكاري، صباح الخير

280
00:16:55,300 --> 00:16:58,230
يا له من يوم مناسب لنزهة
-في هذا الطّقس الجميل

281
00:16:58,300 --> 00:17:00,690
!يكفي! أنت رسميّة جدّاً يا يونا

282
00:17:01,730 --> 00:17:04,280
نحن صديقتان الآن، أتتذكّرين؟

283
00:17:06,600 --> 00:17:08,700
!مـ-مفهوم

284
00:17:09,560 --> 00:17:11,320
أُمنيتك الخاصّة؟

285
00:17:11,630 --> 00:17:15,040
أجل، أريد تجربة أمور كثيرة من الآن فصاعداً

286
00:17:15,660 --> 00:17:19,000
،أريد إيجاد أمنيتي الخاصّة
أو الأفضل بعد، حلمي الخاصّ

287
00:17:19,630 --> 00:17:20,460
هكذا إذاً

288
00:17:21,060 --> 00:17:23,800
إذاً سوف تُعين نفسك من الآن فصاعداً

289
00:17:24,200 --> 00:17:25,630
أجل، يروقني هذا

290
00:17:26,130 --> 00:17:29,470
بصيغة أخرى، بصِفتي مُعلّمتك، ينبغي
...لي أن أحقِّق حلمي أوّلاً

291
00:17:29,560 --> 00:17:31,720
وأكون مثالاً يُحتذى به بالنّسبة لك، صحيح؟

292
00:17:31,900 --> 00:17:33,640
!أكيد، حقّقي حلمكِ

293
00:17:34,730 --> 00:17:37,850
حسناً إذاً! إن كنت تقول ذلك، فسأفجّر
!كافّة طاقاتي

294
00:17:39,160 --> 00:17:41,850
ها أنتِ ذي. شارف وقت الاستراحة على الانتهاء

295
00:17:41,960 --> 00:17:42,770
انقلعي

296
00:17:43,600 --> 00:17:44,730
!ماذا تقولين؟

297
00:17:44,840 --> 00:17:48,900
حسناً، يجب عليّ الذّهاب الآن، أبّولو -
!أنتِ، لا تطرديني ككلب -

298
00:17:50,300 --> 00:17:52,220
أبّولو بعيد كلّ البُعد عن أكينا

299
00:18:10,660 --> 00:18:14,390
سيّد ميودو؟ كان المُدير يبحث عنك فحسب

300
00:18:14,930 --> 00:18:16,890
أجل، أنا قادم

301
00:18:20,060 --> 00:18:22,770
تمكنّا من استعادة حياتنا الطبيعيّة

302
00:18:24,100 --> 00:18:24,980
...لكن

303
00:18:28,760 --> 00:18:33,910
هيكاري من المستقبل لم تظهر
أبداً منذ ذلك الحين

304
00:18:36,260 --> 00:18:37,910
...أعلم بأنّني وعدتُك

305
00:18:39,400 --> 00:18:40,500
أنا آسف

306
00:18:43,160 --> 00:18:44,330
أخي

307
00:18:49,030 --> 00:18:49,960
هيكاري؟

308
00:18:50,530 --> 00:18:51,420
!هيكاري

309
00:18:51,560 --> 00:18:53,090
أجل، هذه أنا

310
00:18:53,400 --> 00:18:55,890
يسرّني أنّك بأمان

311
00:18:56,660 --> 00:18:58,970
...كنتُ قد بدأتُ أشكّ بأنّ

312
00:18:59,260 --> 00:19:01,560
أجل، هكذا يُفترض أن يسير الأمر

313
00:19:03,460 --> 00:19:07,070
كنتُ قد تقبّلتُ حقيقة بأنّني سأختفي لوحدي

314
00:19:09,630 --> 00:19:11,690
هذه أطول فترة يمكنني الصّمود فيها

315
00:19:14,560 --> 00:19:16,030
هيكاري ميودو

316
00:19:18,930 --> 00:19:20,240
غابويليوس

317
00:19:22,230 --> 00:19:26,710
سبب عدم اختفائكِ بعد كان لأنّكِ
كنتِ جزءاً واحداً مع سيبيلت

318
00:19:27,300 --> 00:19:30,170
كانت لدى ذلك المخلوق قوى
تتحدّى المنطق

319
00:19:30,900 --> 00:19:36,500
كان حضوراً قويّاً تحدّى العالم
مانعاً إيّاه من القضاء عليكِ

320
00:19:36,600 --> 00:19:37,640
هكذا إذاً

321
00:19:38,270 --> 00:19:41,520
إن كان الأمر كذلك، فيمكننا إذاً
خلق نفس الوضع

322
00:19:42,830 --> 00:19:45,900
أنا أيضاً مخلوق يمتلك قوى تتحدّى المنطق

323
00:19:46,630 --> 00:19:47,690
!...أيُعقَل

324
00:19:48,130 --> 00:19:51,400
اختميني بداخلكِ وذلك كي نصبح جزءاً واحداً

325
00:19:51,830 --> 00:19:56,780
بهذا الشّكل، ستتمكّنين من البقاء
مُتواجدة في هذا العالم

326
00:19:57,060 --> 00:19:59,530
!لكن... ستختفي أنت

327
00:19:59,960 --> 00:20:01,120
لا أمانع

328
00:20:01,630 --> 00:20:03,580
،رغم أنّ ذلك كان لهزيمة سيبيلت

329
00:20:03,860 --> 00:20:06,870
ورّطتُ كثيراً من النّاس في الأمر

330
00:20:07,260 --> 00:20:11,170
بسبب ذلك، انتهى المطاف بي
بتغيير حياتكِ جذرياً

331
00:20:12,060 --> 00:20:13,380
أنا آسف حقّاً

332
00:20:14,060 --> 00:20:17,390
هذه هي الطّريقة الوحيدة لي كأتوب

333
00:20:17,730 --> 00:20:18,640
...لكن

334
00:20:18,720 --> 00:20:22,890
عشتُ فترة طويلة فقط في مُحاولة هزيمته

335
00:20:23,130 --> 00:20:25,020
مهمّتي قد أُنجِزتْ

336
00:20:25,660 --> 00:20:27,900
لكن الأمر ليس كذلك بالنّسبة لكِ

337
00:20:28,830 --> 00:20:31,020
ماذا تريدين أن تحقّقي؟

338
00:20:37,830 --> 00:20:39,910
لا أريد أن... أختفي

339
00:20:40,830 --> 00:20:44,120
!أريد... أريد أن أعيش فترة أطول

340
00:20:46,300 --> 00:20:48,880
أريد أن تعيشي كذلك

341
00:20:57,330 --> 00:21:01,550
مهما ناديتُه من مرّات منذ ذلك الحين، لم يستجب

342
00:21:02,360 --> 00:21:05,220
لكن... أعلم بأنّه هنا

343
00:21:05,830 --> 00:21:08,190
أنا متأكّدة بأنّه سيستيقظ يوماً ما

344
00:21:08,730 --> 00:21:11,360
من الأفضل أن أشكره عندما يفعل

345
00:21:12,100 --> 00:21:14,070
أجل، يجدر بكِ ذلك

346
00:21:15,030 --> 00:21:17,740
لم تختفِ إذاً يا هيكاري

347
00:21:18,230 --> 00:21:20,320
أنتِ هنا فعليّاً

348
00:21:22,460 --> 00:21:24,580
أجل، أنا هنا فعليّاً

349
00:21:32,400 --> 00:21:34,590
لا تقل لي بأنّك تبكي؟

350
00:21:34,700 --> 00:21:36,260
بالطّبع لستُ كذلك

351
00:21:38,400 --> 00:21:41,430
أردتُ إنقاذكِ أيضاً

352
00:21:42,000 --> 00:21:44,680
...فلو اختفيتِ، لكنتُ

353
00:21:45,730 --> 00:21:47,850
أنا مُطمئنّ بصراحة

354
00:21:48,960 --> 00:21:52,150
ارتأيتُ أنّه لا مكان لي أعود إليه

355
00:21:53,030 --> 00:21:54,980
...لكن سوف

356
00:21:56,830 --> 00:21:59,030
!أستمرّ في العيش في هذا العالم

357
00:22:02,360 --> 00:22:04,280
!أهلاً بعودتكِ يا هيكاري

358
00:22:07,330 --> 00:22:08,450
!عُدت

359
00:23:36,800 --> 00:23:38,000
ماذا تفعلين؟

360
00:23:39,030 --> 00:23:41,210
كنتُ أفكّر في اسم جديد

361
00:23:41,600 --> 00:23:45,430
لا أستطيع تسمية نفسي هيكاري
ميودو في هذا العالم

362
00:23:47,830 --> 00:23:49,220
التّفكير باسم جيّد؟

363
00:23:50,160 --> 00:23:51,220
أجل

364
00:23:51,470 --> 00:23:52,480
جيّد

365
00:23:54,360 --> 00:23:55,560
إلى أين أنت ذاهب؟

366
00:23:55,860 --> 00:23:58,060
في الواقع... إلى مكان ما

367
00:23:59,060 --> 00:24:00,690
لمُقابلة صديق

368
00:24:03,260 --> 00:24:05,240
التجمُّع الثّالث للأقوى

369
00:24:06,760 --> 00:24:08,240
لا أطيق الانتظار

370
00:24:10,260 --> 00:24:13,000
المستقبل هنا