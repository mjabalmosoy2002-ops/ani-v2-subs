1
00:00:01,990 --> 00:00:05,240
لذا سمعتُ بأنّ صديقي قد بنى قاعدة سرّية

2
00:00:05,960 --> 00:00:10,460
،لكن بعد تلك العاصفة قبل أيّام
كان يصرخ غاضباً من دمارها

3
00:00:10,630 --> 00:00:13,340
لذا لم تعُد سرّية

4
00:00:13,460 --> 00:00:16,800
ألم ترد أن تبني القاعدة معه يا أخي؟

5
00:00:16,960 --> 00:00:18,760
لا، لا داعي

6
00:00:19,400 --> 00:00:22,010
أفضّل التكلّم معكِ بعد دوام
المدرسة يا هيكاري

7
00:00:28,060 --> 00:00:29,520
صباح الخير يا هيكاري

8
00:00:30,760 --> 00:00:32,770
حضّرتُ لك الفطور بالفعل

9
00:00:33,430 --> 00:00:36,280
أخي، هل نمتَ بما يكفي؟

10
00:00:36,400 --> 00:00:39,200
لو أخبرتني، لقدّمتُ المساعدة

11
00:00:39,300 --> 00:00:42,320
لا تقلقي، أنا من أراد فعل هذا

12
00:00:45,300 --> 00:00:46,910
قبلتُ عملاً بدوام جزئيّ

13
00:00:47,100 --> 00:00:48,870
ماذا؟ لكن لماذا؟

14
00:00:48,960 --> 00:00:51,170
،يعمل أبي بجدّ ليكسب المال

15
00:00:51,830 --> 00:00:54,670
،لكن عندما أفكّر في الكلّية ومستقبلكِ يا هيكاري

16
00:00:55,170 --> 00:00:57,960
أعتقد أنّه من الأكثر أماناً ادّخار المال

17
00:00:58,600 --> 00:01:00,510
ستكون خبرة جيّدة في الحياة

18
00:01:04,900 --> 00:01:07,310
أكرِّر الزّمن

19
00:01:08,080 --> 00:01:13,020
سوف أكفِّر عن خطيئتي. لاسترجاع
وقتي المشروع

20
00:01:14,600 --> 00:01:17,940
لن يأتي دورك بعد الآن

21
00:02:54,560 --> 00:02:56,710
دوري. أسحب

22
00:02:58,400 --> 00:03:01,090
لنغيّر الأمور معاً

23
00:03:01,790 --> 00:03:04,760
!أركب ليايل=أوديوم ركوب بيرسونا

24
00:03:05,960 --> 00:03:08,270
وأستخدم بِطاقة أمر

25
00:03:08,800 --> 00:03:10,520
!الآفة المُشوَّهة

26
00:03:11,130 --> 00:03:15,570
.أضع هذه البِطاقة كمقياس ارتداد خاصّ بي
تحصل ليايل على قوّة 10000

27
00:03:15,730 --> 00:03:17,150
أعتقد كان ذلك حتميّاً

28
00:03:17,460 --> 00:03:20,820
والآن سيُطلَق عنان قوّة الزّمن

29
00:03:21,330 --> 00:03:25,410
أستدعي المُتّقِد. بمهارته، أستدعي أناكرونوس

30
00:03:25,830 --> 00:03:30,210
،أُهاجم بواسطة أناكرونوس. بمهارته
أعزل التّسلسُل

31
00:03:30,660 --> 00:03:31,920
بلا حِراسة

32
00:03:32,560 --> 00:03:35,840
أُهاجم الفانغارد بواسطة ليايل=أوديوم

33
00:03:35,960 --> 00:03:37,380
تتفعّل مهارته

34
00:03:37,460 --> 00:03:39,420
أضع أناكرونوس كمقياس ارتداد لي

35
00:03:39,900 --> 00:03:42,380
ليايل يكسب درايف ثُلاثيّاً

36
00:03:44,140 --> 00:03:45,430
حِراسة مثاليّة

37
00:03:45,860 --> 00:03:47,260
التفقُّد الأوّل

38
00:03:48,200 --> 00:03:49,680
التفقُّد الثّاني

39
00:03:50,530 --> 00:03:51,810
التفقُّد الثّالث

40
00:03:52,030 --> 00:03:53,600
!تريغر حاسمة

41
00:03:54,000 --> 00:03:58,230
أناكرونوس تكسب قوّة 10000
وحاسمة إضافيّة

42
00:04:00,000 --> 00:04:01,860
تمّ استيفاء الشُّروط

43
00:04:03,700 --> 00:04:05,370
!عسى أن يتشوّه الزّمن

44
00:04:05,600 --> 00:04:07,950
!تتفعّل مهارته الإلهيّة

45
00:04:10,630 --> 00:04:14,580
عندما يكون مقياس الارتداد الخاصّ بي أكثر
من 5، فيمكنني طرح بطاقتين من يدي

46
00:04:15,360 --> 00:04:16,840
أُهاجم بواسطة أناكرونوس

47
00:04:17,330 --> 00:04:18,590
حِراسة مثاليّة

48
00:04:20,400 --> 00:04:21,880
انتهى دوري

49
00:04:22,530 --> 00:04:24,430
حان ذلك الوقت أخيراً

50
00:04:25,200 --> 00:04:26,100
ها هي ذي

51
00:04:26,560 --> 00:04:29,260
...الهالة الّتي تُحدِّد قوّة الزّمن

52
00:04:29,560 --> 00:04:32,230
تُشوِّه الزّمكان من أجل إدانة الخطيئة

53
00:04:32,750 --> 00:04:34,730
،نظراً للمهارة الإلهيّة

54
00:04:34,830 --> 00:04:38,360
!أتمكّن من تكرار دوري في نهاية هذا الدّور

55
00:04:39,530 --> 00:04:42,610
كلتانا سرقنا الكثير من زمن أخي

56
00:04:43,200 --> 00:04:45,860
!لهذا سنُعيد كلّ شيء من الصّفر

57
00:04:46,300 --> 00:04:50,080
!دوري... نهوض وسحب

58
00:04:50,530 --> 00:04:53,370
بمهارتها، أضع آمي ديتانا كمقياس ارتداد

59
00:04:53,660 --> 00:04:55,290
أستدعي أناكرونوس

60
00:04:55,900 --> 00:04:58,790
!أُهاجم الفانغارد بواسطة ليايل=أوديوم

61
00:04:59,260 --> 00:05:01,550
بمهارته، يحظى بدرايف ثُلاثيّ

62
00:05:02,000 --> 00:05:03,130
بلا حِراسة

63
00:05:03,300 --> 00:05:04,760
التفقُّد الأوّل

64
00:05:05,000 --> 00:05:08,760
تريغر سحب! يكسب أناكرونوس
!قوّة قدرها 10000

65
00:05:10,400 --> 00:05:11,640
!هذا لا يعني شيئاً

66
00:05:12,130 --> 00:05:13,480
التفقُّد الثّاني

67
00:05:13,900 --> 00:05:15,350
!تريغر شِفاء

68
00:05:15,960 --> 00:05:18,690
!يكسب أناكرونوس قوّة 10000

69
00:05:19,500 --> 00:05:21,900
!خذي هذه

70
00:05:25,130 --> 00:05:26,900
لم تستطيعي سحب حاسمة

71
00:05:27,230 --> 00:05:28,990
لم تنتهِ الهجمة بعد

72
00:05:29,500 --> 00:05:31,240
!أُهاجم بواسطة أناكرونوس

73
00:05:31,900 --> 00:05:32,740
حِراسة

74
00:05:33,200 --> 00:05:35,250
!اسقطي فحسب

75
00:05:35,430 --> 00:05:37,790
!أُهاجم بواسطة أناكرونوس الأخرى خاصّتي

76
00:05:38,850 --> 00:05:41,300
لا أقبل بالسّقوط هنا

77
00:05:42,330 --> 00:05:46,180
مهما كان الحاضر صعباً، يمكن
للمستقبل أن يتغيّر

78
00:05:46,830 --> 00:05:48,590
...إذا قطعت خطوة واحدة

79
00:05:48,760 --> 00:05:53,270
،أو مددت بطاقة واحدة للمستقبل الّذي تُريدينه
!فيمكنكِ دوماً الوصول إليه

80
00:05:54,000 --> 00:05:57,270
!أمر بليتز، البريق السّماويّ

81
00:05:58,500 --> 00:06:01,060
...هذه -
!البطاقة الّتي تستدعي مُعجزة -

82
00:06:01,730 --> 00:06:06,200
أنظر إلى أعلى بِطاقة في مجموعة
!بِطاقاتي وأستخدمها للحِراسة

83
00:06:06,430 --> 00:06:09,070
لكن هل هناك أمل في تلك البِطاقة؟

84
00:06:09,630 --> 00:06:12,080
لن تكون لديكِ قيمة درعيّة كافية مهما حدث

85
00:06:12,330 --> 00:06:16,290
تحتاجين باستماتة تريغر شِفاء
أو تريغر أوفر أو تريغر مثاليّة

86
00:06:16,430 --> 00:06:17,830
!لكن استهلكتِها جميعها

87
00:06:18,160 --> 00:06:20,710
!لا مُستقبل للبطاقة الّتي ستقلبينها

88
00:06:22,830 --> 00:06:26,760
،رغم أنّه مجرّد بصيص أمل"
"...ستنزل مُعجزة

89
00:06:27,330 --> 00:06:28,840
"!على أولئك الّذين يمدّون أيديهم..."

90
00:06:30,400 --> 00:06:31,930
ما زال يوجد أمل

91
00:06:32,330 --> 00:06:34,720
إنّها البِطاقة الّتي غيّرت مُستقبلَنا

92
00:06:34,960 --> 00:06:39,770
أكثر بِطاقة أثق بها

93
00:06:40,830 --> 00:06:44,360
المُقدَّر الزمنيّ، ليايل=أمورتا

94
00:06:45,800 --> 00:06:46,690
!ها هي ذي

95
00:06:46,800 --> 00:06:47,610
!أجل

96
00:06:48,170 --> 00:06:50,110
!المُقدَّر الزمنيّ؟

97
00:06:50,830 --> 00:06:55,330
،بمهارة حِراسة ليايل=أمورتا
لن تُحقّق هجمتك هدفها

98
00:06:55,960 --> 00:06:57,370
!هذا ليس عدلاً

99
00:06:57,800 --> 00:07:00,330
هذه هي القوّة الّتي تستطيع تغيير المُستقبل

100
00:07:01,960 --> 00:07:03,590
انتهى دوري

101
00:07:04,630 --> 00:07:05,550
!مرحى

102
00:07:05,600 --> 00:07:07,380
!تحمّلَتْ دورين

103
00:07:07,600 --> 00:07:10,130
لكن لم تنتهِ المعركة بعد

104
00:07:11,760 --> 00:07:14,300
السّؤال هو فيما إذا كانت تستطيع
إلحاق ضررين إضافيّين

105
00:07:14,960 --> 00:07:16,600
لم ينتهِ الأمر بعد

106
00:07:16,730 --> 00:07:19,020
تبدين مُستميتة -
!بالطّبع أنا كذلك -

107
00:07:20,100 --> 00:07:21,690
كنتُ هكذا أيضاً

108
00:07:21,860 --> 00:07:24,800
ما دمتُ أستطيع تغيير قدر
،موت أخي الكبير

109
00:07:24,940 --> 00:07:27,620
اتّخذتُ قراري بأنّه لا شيء آخر مهمّ

110
00:07:27,900 --> 00:07:29,530
كنتُ مهووسة بهذا الفكر

111
00:07:30,160 --> 00:07:32,820
لكن فكّر أخي الكبير خِلاف ذلك

112
00:07:33,900 --> 00:07:37,490
،سواء كان حول نفسه أو هيكاري ميودو

113
00:07:38,060 --> 00:07:43,040
أو حتّى سو يوبيتسوغي، آمن
بمُستقبل ينجو فيه جميعنا

114
00:07:43,630 --> 00:07:48,090
تمكّنتُ من فهم ذلك لأنّني
نافستُه بشكل صريح

115
00:07:49,000 --> 00:07:50,470
!فإذاً ماذا بالضّبط؟

116
00:07:50,860 --> 00:07:54,550
أنتِ أيضاً عليكِ مُواجهة نفسكِ
يا أكينا ميودو

117
00:07:54,900 --> 00:07:57,810
!لا حاجة لأفعل ذلك

118
00:07:58,160 --> 00:07:59,760
،لو لم يقع ذلك الحادث

119
00:07:59,860 --> 00:08:03,810
لتمكّن أخي الكبير من الاستمتاع بحياته
!بدلاً من الاعتناء بي

120
00:08:04,160 --> 00:08:08,570
من الواضح أنَّ هذا أفضل من الحياة
!البائسة الّتي ترتّب عليها تحمّلها

121
00:08:09,760 --> 00:08:12,110
بائسة؟ من قال ذلك؟

122
00:08:12,200 --> 00:08:14,110
...لكن -
!أنتِ من قلتِ -

123
00:08:14,760 --> 00:08:16,830
!أنتِ الوحيدة الّتي تعتقد ذلك

124
00:08:17,900 --> 00:08:21,540
أنا متأكّدة بأنّ أخي ما كان
ليقول بأنّه تعيس

125
00:08:21,600 --> 00:08:24,580
!كان أخي شديد الاهتمام

126
00:08:24,700 --> 00:08:27,210
!هل تعتقدين بأنّه كان يكذب علينا؟

127
00:08:27,600 --> 00:08:29,300
...هـ-هذا

128
00:08:29,360 --> 00:08:31,970
،بدلاً من إقناع نفسكِ بأنّكِ أخطأتِ

129
00:08:32,560 --> 00:08:36,680
عليكِ نقل مشاعركِ الحقيقيّة إلى أخيكِ
الأكبر بدلاً من إطلاق افتراضات

130
00:08:37,060 --> 00:08:37,970
...لأنّ

131
00:08:38,560 --> 00:08:41,850
!أخوكِ على الأقلّ ضمن منالكِ

132
00:08:43,360 --> 00:08:46,060
دوري. أستدعي تشيفالميا

133
00:08:46,530 --> 00:08:48,110
!أُهاجم بواسطة سالفار

134
00:08:48,430 --> 00:08:49,570
بلا حِراسة

135
00:08:50,230 --> 00:08:54,360
!أُهاجم ليايل=أوديوم بواسطة ليايل=أمورتا

136
00:08:54,730 --> 00:08:58,030
!لن أدعكِ تهربين إلى الماضي ببساطة

137
00:08:58,200 --> 00:09:00,660
!سأجرّكِ نحو المستقبل

138
00:09:03,230 --> 00:09:04,330
...أمنيتي

139
00:09:05,230 --> 00:09:07,170
...أمنيتي هي

140
00:09:11,630 --> 00:09:13,130
التفقُّد الأوّل

141
00:09:15,530 --> 00:09:16,970
التفقُّد الثّاني

142
00:09:18,630 --> 00:09:19,760
!حصلتُ عليها

143
00:09:20,430 --> 00:09:24,020
!تريغر حاسِمة

144
00:09:37,500 --> 00:09:38,910
لا تريغر

145
00:09:41,260 --> 00:09:44,450
!الرّابحة هي... المُقدَّرة الزمنيّة

146
00:09:46,700 --> 00:09:47,870
مستحيل

147
00:09:48,360 --> 00:09:51,170
المصيريّة خسرتْ؟

148
00:09:51,500 --> 00:09:52,800
!فعلَتْها

149
00:09:53,230 --> 00:09:54,670
كانت معركة رائعة

150
00:09:55,260 --> 00:09:58,830
!هذا يجعلها 3-4. نحن الرّابحون

151
00:09:58,960 --> 00:10:01,560
يا إلهي، كان ذلك وشيكاً

152
00:10:04,400 --> 00:10:05,730
أنا آسفة

153
00:10:06,900 --> 00:10:10,190
لم يكن من المُفترض أن يكون الأمر كذلك

154
00:10:10,500 --> 00:10:13,780
...أردتُ فقط أن يكون أخي الكبير

155
00:10:14,430 --> 00:10:16,740
ألا تتكلّمين مع الشّخص الخطأ؟

156
00:10:30,260 --> 00:10:33,210
اذهبي أيّتها الفتاة الطّفوليّة

157
00:10:44,800 --> 00:10:46,730
...أخي، أنا

158
00:10:46,810 --> 00:10:48,020
آسف يا هيكاري

159
00:10:49,130 --> 00:10:52,560
،ظللتُ أفعل أشياء لأجلكِ

160
00:10:52,800 --> 00:10:55,980
مُفترضاً بأنانيّة بأنّ ما سأفعله
سوف يُسعدكِ

161
00:10:56,200 --> 00:10:56,730
!آسف

162
00:10:56,830 --> 00:10:59,990
إ-إطلاقاً! أنا المُلامة

163
00:11:00,360 --> 00:11:05,990
كنتُ أنا من افترض بأنّك كنتَ تُعاني
وتُواجه وقتاً عصيباً

164
00:11:06,660 --> 00:11:09,920
،في كلّ مرّة كنت تفعل فيها شيئاً لأجلي

165
00:11:10,070 --> 00:11:14,380
لا أنفك أعتقد بأنّك محروم من الحرّية
لأنّه كان يترتّب عليك الاعتناءا بي دوماً

166
00:11:16,450 --> 00:11:21,430
لهذا أردتُك أن تعطي الأولويّة لنفسك أكثر

167
00:11:22,760 --> 00:11:26,470
أخي، أنا أحبّك حقّاً

168
00:11:27,000 --> 00:11:32,150
لكن لهذا السّبب أردتُ البقاء معك
بصورة مُتكافئة

169
00:11:35,800 --> 00:11:37,900
شكراً على مُشاركة مشاعركِ

170
00:11:40,230 --> 00:11:42,570
...بجدّية، ولا مرّة اعتقدتُ فيها

171
00:11:42,830 --> 00:11:46,700
أنّ قضاء الوقت معكِ كان عبئاً...

172
00:11:47,130 --> 00:11:50,040
فعلتُ كلّ تلك الأشياء لأجلك
لأنّني أردتُ ذلك

173
00:11:50,330 --> 00:11:52,420
لا أندم أو أتحسّر على شيء

174
00:11:53,260 --> 00:11:57,750
!أنا أيضاً أحبّ هيكاري مثلما تفعلين

175
00:11:59,400 --> 00:12:02,680
لهذا أنا متأكّد بأنّني سأظلّ
أخاً مُتطفِّلاً في نظركِ

176
00:12:03,760 --> 00:12:06,010
سامحيني على كوني كذلك

177
00:12:06,360 --> 00:12:08,430
بالطّبع أنا كذلك

178
00:12:08,860 --> 00:12:12,390
في الواقع، أنا من سبّب لك
كلّ هذا العناء

179
00:12:13,060 --> 00:12:15,400
حسناً، نحن مُتعادلان الآن إذاً

180
00:12:16,360 --> 00:12:19,650
...من الآن فصاعداً، لنتحدّث أكثر
عن أيّ موضوع كان

181
00:12:19,930 --> 00:12:21,150
أتّفق

182
00:12:21,530 --> 00:12:23,950
حول أمور سعيدة وحزينة في نفس الوقت

183
00:12:24,500 --> 00:12:25,950
حول الشّكاوى والانتقادات

184
00:12:26,430 --> 00:12:28,450
!عن الأحلام والأمنيات

185
00:12:30,230 --> 00:12:32,960
أتتذكّرين عندما سألتِني عن أُمنيتي؟

186
00:12:33,860 --> 00:12:38,250
لا أستطيع إجابتكِ بعد، لكن
سوف أستمرّ في التّفكير حول الأمر

187
00:12:38,460 --> 00:12:42,470
.أخبرني عندما تتوصّل إلى إجابة
!سوف أدعمك من أعماق قلبي

188
00:12:42,530 --> 00:12:46,600
أكيد، وأنتِ احرصي على إخباري
بأيّ شيء يؤرقكِ

189
00:12:46,700 --> 00:12:50,970
بالطّبع! سأعتمد عليك يا أخي

190
00:12:53,760 --> 00:12:58,610
والآن تنتهي المواجهة المصيريّة أخيراً

191
00:12:59,200 --> 00:13:03,080
في نهاية اليوم، كان المُقدّرون من حقّقوا النّصر

192
00:13:03,730 --> 00:13:06,750
حان الوقت الآن للإدلاء بأمنياتكم

193
00:13:19,100 --> 00:13:23,430
كلّ قوّة التّصميم الّتي عزّزَتْها
...المعارك المصيريّة

194
00:13:23,630 --> 00:13:25,560
قد اجتمعت هنا...

195
00:13:27,080 --> 00:13:28,060
...أخيراً -
!الآن -

196
00:13:28,260 --> 00:13:29,640
حسناً، حسناً

197
00:13:32,630 --> 00:13:35,190
ما هذا؟ ماذا فعلتم؟

198
00:13:35,500 --> 00:13:38,700
لحظة، هل أنت مُرتعد؟

199
00:13:39,060 --> 00:13:42,700
جوهريّاً، لن ندعك تفعل ما يحلو لك

200
00:13:43,330 --> 00:13:47,450
إيّاك والاعتقاد بأنّنا كنّا نقف
هنا مكتوفي الأيدي ببساطة

201
00:13:47,760 --> 00:13:51,460
توقّعتُ بأنّكم كنتم تخطِّطون
لمكيدة ما من وراء ظهري

202
00:13:51,700 --> 00:13:54,710
أجل، وكان كلّ ذلك لأجل هذه اللّحظة

203
00:13:56,060 --> 00:13:59,590
أعتقد بأنّ نتيجة المُواجهة المصيريّة غير مهمّة

204
00:14:00,030 --> 00:14:02,430
إذاً الأمر متعلّق أكثر بالمعركة نفسها؟

205
00:14:02,800 --> 00:14:06,930
لكن ما زال الصِّراع المُقدَّر مستمرّاً
بالرّغم من انسحاب أحدهم منه

206
00:14:07,200 --> 00:14:11,560
بالطّبع، الاستدعاء مُصمّم للاستمرار
حتّى لو رفض أحدهم

207
00:14:12,030 --> 00:14:16,070
لكن سينقص حينها مقدار قوّة
التّصميم الّذي يمكن جمعه

208
00:14:16,260 --> 00:14:17,610
هكذا إذاً

209
00:14:18,230 --> 00:14:22,240
لهذا السّبب منح سيبيلت كلا الفريقين
سبباً للقتال، صحيح؟

210
00:14:22,300 --> 00:14:23,360
هذا ما أفترضه

211
00:14:23,930 --> 00:14:27,360
...الوعد بتحقيق أُمنية الرّابح هو غالباً

212
00:14:27,560 --> 00:14:32,750
أجل، يجب أن تكون دُمية محشوّة حسنة
الأخلاق للوفاء بوعدٍ كهذا

213
00:14:34,530 --> 00:14:36,420
،إذا كانت النّتيجة غير مهمّة

214
00:14:36,520 --> 00:14:39,260
فغالباً سيحاول فعل شيء لاحقاً

215
00:14:39,360 --> 00:14:42,880
علينا أن نبحث عن إجراءات مُضادّة
مُمكنة إلى ذلك الحين

216
00:14:46,300 --> 00:14:47,140
!لا تفعل

217
00:14:48,430 --> 00:14:50,300
،إذا قُطِع الاستدعاء كُلّياً

218
00:14:50,400 --> 00:14:53,060
فلنل أتمكّن من إعادة قوّتي إلى الأرض

219
00:14:53,300 --> 00:14:55,650
لن تكون هناك وسيلة لتدمير سيبيلت

220
00:14:56,160 --> 00:15:00,570
لا تنسَ بأنّهم قالوا بأنّ استعادته
إلى مُستقبل آخر استغرق 3 سنوات

221
00:15:01,360 --> 00:15:03,660
هل يمكنني اقتراح شيء؟

222
00:15:04,260 --> 00:15:04,990
ما هو؟

223
00:15:05,060 --> 00:15:10,290
لحسن الحظّ، سبق ورأيتُ قوى
سيبيلت بشكل مُباشر

224
00:15:11,260 --> 00:15:13,260
،بتحليل البيانات من ذلك الوقت

225
00:15:13,580 --> 00:15:18,000
اكتشفتُ بأنّ القوّة الّتي يستخدمها سيبيلت
لها شكل موجة تذبذبيّة خاصّة

226
00:15:18,760 --> 00:15:22,920
...إذا حفّزنا طاقة تذبذبيّة بشكل موجة لديها

227
00:15:23,160 --> 00:15:25,970
...الطّور المُعاكِس لقوّته

228
00:15:26,430 --> 00:15:29,560
...فهمت. إذا تصادمَ شكلان موجيّان مُتعاكِسان تماماً

229
00:15:29,930 --> 00:15:33,180
فسيكون ذلك بمثابة إلغاء الصّوت

230
00:15:33,430 --> 00:15:35,810
سأفعل ما بوسعي فعله

231
00:15:36,960 --> 00:15:39,570
سيكون هذا جديراً بالتّجربة

232
00:15:40,730 --> 00:15:41,920
هل تعلمون؟

233
00:15:42,040 --> 00:15:45,320
كنّا نحن من بنينا ساحة القتال هذه

234
00:15:45,860 --> 00:15:47,450
كان العبث بها سهلاً

235
00:15:47,930 --> 00:15:51,240
لكن هذا لا يكفي لتدمير طريقة استدعائي

236
00:15:51,330 --> 00:15:55,210
معك حقّ. كان ذلك حدود ما استطعنا فعله

237
00:15:55,830 --> 00:15:59,590
لكن أخبرنا غاويليوس بأنّ ذلك
كان يكفي وأكثر

238
00:16:00,030 --> 00:16:01,960
!هذا صحيح. أحسنتم صُنعاً

239
00:16:02,860 --> 00:16:05,510
!أنا أكثر من فهم طريقة الاستدعاء هذه

240
00:16:05,900 --> 00:16:08,470
!احتجتُ لفُرصة للتدخُّل فحسب

241
00:16:08,760 --> 00:16:11,510
!لن أدعك يا غابويليوس

242
00:16:12,230 --> 00:16:15,230
!سأسترجع طريقة استدعائي

243
00:16:20,000 --> 00:16:21,110
!اللّعنة عليك

244
00:16:24,560 --> 00:16:26,570
هل انتهى الأمر؟

245
00:16:27,500 --> 00:16:28,490
ليس بعد

246
00:16:29,200 --> 00:16:33,200
سأستخدم طريقةَ الاستدعاء الّتي استرجعتُها
لنقل جسدي الحقيقيّ هنا

247
00:16:33,760 --> 00:16:38,170
،لا أعلم لماذا لم يظهر شخصيّاً
لكن كان ذلك مُلائماً جدّاً لي

248
00:16:38,460 --> 00:16:40,630
حان الوقت أخيراً

249
00:16:43,600 --> 00:16:44,380
!هيكاري؟

250
00:16:44,600 --> 00:16:45,590
!هيكاري

251
00:16:55,000 --> 00:16:57,060
!حصلتُ عليها أخيراً

252
00:17:02,400 --> 00:17:04,030
!أخيراً

253
00:17:14,060 --> 00:17:16,120
!كم هذا مَهيب

254
00:17:16,430 --> 00:17:19,460
عملتُم بجدٍّ لأجلي حقّاً

255
00:17:20,000 --> 00:17:24,420
في النّهاية، يبدو أنَّ القدر
وقف في صفّي

256
00:17:26,200 --> 00:17:28,510
،باكتساب القوّة الّتي تقتُ لها

257
00:17:29,060 --> 00:17:31,800
!تمّ تحريري

258
00:17:37,060 --> 00:17:38,230
...أليس هذا

259
00:17:38,330 --> 00:17:41,060
فهمت. هكذا إذاً

260
00:17:41,700 --> 00:17:46,070
كان سيبيلت داخل هيكاري
ميودو منذ البداية

261
00:17:46,930 --> 00:17:48,990
ماذا تقصد؟

262
00:17:49,960 --> 00:17:55,620
هيكاري ميودو، لم يكن جسدك ضعيفاً
بسبب مرض أو جرح

263
00:17:56,100 --> 00:18:00,500
كان سيبيلت يمتصّ طاقة حياتكِ من الدّاخل

264
00:18:02,060 --> 00:18:03,040
!بجدّية؟

265
00:18:03,460 --> 00:18:06,960
!مهلاً لحظة. إذاً سيبيلت بداخلي أيضاً؟

266
00:18:07,060 --> 00:18:10,170
لا، ربّما لم يعُد بداخلكِ

267
00:18:11,480 --> 00:18:14,260
ما الّذي تمنّاه أكينا ميودو في الصِّراع المُقدَّر؟

268
00:18:14,440 --> 00:18:16,970
أن تتعافى أخته

269
00:18:17,500 --> 00:18:22,060
المُقدَّر الإعجازيّ حقّقَ تلك الأُمنية فعلاً

270
00:18:22,660 --> 00:18:25,610
إذاً سيبيلت الّذي كان بداخل
...هيكاري في تلك المرّة

271
00:18:25,930 --> 00:18:29,070
،أجل، بما أنّ ذلك كان خطراً على حياتها

272
00:18:29,200 --> 00:18:32,490
المُقدّر الإعجازيّ أباده بقِواه

273
00:18:33,460 --> 00:18:37,790
لكن كان يوجد سيبيلت آخر
في هذا العالم

274
00:18:38,160 --> 00:18:42,750
بعد ثلاث سنوات في المُستقبل، في عالم
لم تتحقّق فيه أمنية أكينا ميودو

275
00:18:42,860 --> 00:18:44,630
!داخل هيكاري ميودو الأخرى

276
00:18:44,860 --> 00:18:46,590
هذا غير معقول

277
00:18:46,830 --> 00:18:48,300
أيُعقَل هذا؟

278
00:18:48,400 --> 00:18:50,090
هذا صحيح

279
00:18:50,400 --> 00:18:54,260
أنا موجود داخل هيكاري لفترة طويلة

280
00:18:54,660 --> 00:18:56,890
لكن يجب أن أثني عليكم

281
00:18:57,530 --> 00:18:59,560
...لم أتصوّر حتّى بأنّ

282
00:18:59,630 --> 00:19:03,440
مخلوقات هذا العالم سيمتلكون الوسيلة
للردّ على طريقة استدعائي

283
00:19:04,900 --> 00:19:09,440
كلّ قوّة التّصميم المُجمَّعة كان
من المُفترَض أن تُرسَل لي

284
00:19:09,760 --> 00:19:12,380
،لكن فقدتُ طريقة استدعائي بسببكم

285
00:19:12,540 --> 00:19:15,410
...وكان ينبغي أن تكون تلك نهاية الأمر، لكن

286
00:19:16,000 --> 00:19:19,330
لكم أن تتخيّلوا بأنّ هيكاري ميودو
كانت تمرّ بنوبة صرع

287
00:19:19,560 --> 00:19:23,040
في تلك اللّحظة، لم يستطع أحد
!إيقاف الجسد الّذي استحوذتُ عليه

288
00:19:24,560 --> 00:19:25,580
لكن لماذا؟

289
00:19:25,700 --> 00:19:28,880
ما كنتَ لتسيطر على وعي هيكاري ميودو أبداً

290
00:19:28,960 --> 00:19:32,930
لِمَ تفعلها بطريقة التفافيّة؟ -
كان خياري الوحيد -

291
00:19:33,000 --> 00:19:35,510
خيارك... الوحيد؟

292
00:19:35,630 --> 00:19:37,350
أجل، هذا صحيح

293
00:19:37,730 --> 00:19:41,020
هذه غلطتك يا ناو إينابي

294
00:19:42,030 --> 00:19:45,810
سأسترجع القوّة الّتي أخذتها منّي

295
00:19:46,230 --> 00:19:47,980
!وحتّى جسدكِ

296
00:19:49,240 --> 00:19:50,360
!سينباي

297
00:20:12,030 --> 00:20:14,920
!سيبيلت... أنت

298
00:20:16,300 --> 00:20:18,180
هذه قوّتي

299
00:20:22,100 --> 00:20:23,390
ما هذا؟

300
00:20:23,930 --> 00:20:28,600
هذه؟ هذه هي البطاقة الّتي تجمع قوّتي

301
00:20:29,130 --> 00:20:32,150
إنّها البطاقة الّتي استخدمتُها
لنقل نفسي إلى هنا من كراي

302
00:20:32,300 --> 00:20:35,360
يمكنكم القول بأنّها ذاتي الثّانية

303
00:20:35,660 --> 00:20:36,740
!ماذا؟

304
00:20:36,930 --> 00:20:40,070
ليس من السّهل العبور بين العالمين

305
00:20:40,400 --> 00:20:44,910
لكن لأنّني قضيتُ وقتاً طويلاً جدّاً
،كروح من دون جسد

306
00:20:45,000 --> 00:20:47,120
عرفتُ جيّداً كيفيّة استخدامه

307
00:20:48,030 --> 00:20:51,540
،فصلتُ بنجاح روحي عن قوايّ

308
00:20:51,760 --> 00:20:57,130
وطوّرتُ طريقة استدعاء لنقل قِوايّ
إلى الأرض عن طريق بِطاقة

309
00:20:57,800 --> 00:21:03,140
البِطاقات هي خير وسيلة
لربط كراي بالأرض

310
00:21:04,000 --> 00:21:06,020
لذا ماذا حدث لروحي؟

311
00:21:06,160 --> 00:21:11,690
أتت إلى هذا العالم بالانجذاب إلى هذه
البطاقة والّتي هي جزء منّي

312
00:21:12,660 --> 00:21:15,570
!إذاً لماذا تمتلك ناو إينابي تلك البطاقة؟

313
00:21:16,100 --> 00:21:19,910
تعرفون السّبب

314
00:21:20,460 --> 00:21:23,280
هيكاري ميودو وأكينا ميودو

315
00:21:25,130 --> 00:21:29,670
تلك الحادثة المُقرِفة الّتي
حدثت في تلك الأطلال

316
00:21:31,000 --> 00:21:33,590
هذا صحيح. تذكّرتُ الآن

317
00:21:34,930 --> 00:21:37,170
ما حدث قبل عشر سنوات

318
00:21:37,830 --> 00:21:40,970
...في ذلك المكان، أنا

319
00:21:52,730 --> 00:21:55,610
!أخي، أنا متحمّسة جدّاً للذّهاب إلى التّخييم

320
00:21:55,840 --> 00:21:59,280
أجل! لكن ابقي قريبة منّي، مفهوم؟

321
00:23:31,430 --> 00:23:33,370
أهلاً بكم في كوك ميليون

322
00:23:33,460 --> 00:23:33,980
مرحباً

323
00:23:34,080 --> 00:23:37,540
ما الّذي أصابكِ حتّى أردتِ رؤيتي فجأة؟

324
00:23:37,630 --> 00:23:38,460
ليس بالأمر الجلل

325
00:23:38,700 --> 00:23:41,460
هذه المرّة سأقدّم البريق السّماويّ

326
00:23:41,830 --> 00:23:44,430
يمكن استخدام أمر بليتز في دور خصمك

327
00:23:44,630 --> 00:23:47,800
يمكنك النّظر إلى أعلى بطاقة في مجموعة
بطاقاتك وتختار استخدامها للحِراسة

328
00:23:47,860 --> 00:23:50,100
أو إعادتها إلى المجموعة

329
00:23:50,200 --> 00:23:52,980
إذا حرست، فينبغي أن تتعزّز قيمة
درعك بمقدار 10000

330
00:23:53,060 --> 00:23:56,130
إذاً هي بِطاقة تصنع مُعجزة
بإخراجك من مأزق

331
00:23:56,230 --> 00:23:58,230
مُدّ يدك، حتّى لو كانت بطاقة واحدة فقط

332
00:23:58,350 --> 00:23:59,940
لكن لا تقلق إذا ارتكبت خطأ