1
00:00:03,100 --> 00:00:06,850
وجدتُ مطعمَ الجيلاتو الرّائع هذا
في الجوار، أتريد تجربته؟

2
00:00:06,850 --> 00:00:07,990
أرفُض

3
00:00:07,990 --> 00:00:09,490
أنت مُملّ

4
00:00:09,490 --> 00:00:13,130
،مهلاً يا راؤول. مهما جرّبناه من مرّات
إنّه رائع دوماً

5
00:00:28,130 --> 00:00:30,840
أمير التّنس الجزء الثّاني

6
00:00:28,130 --> 00:00:30,840
مُباراة اختيار العضو الأخير

7
00:01:47,640 --> 00:01:51,490
أجل، هذا سيّئ. إنّه صعبٌ
جدّاً علينا فحسب

8
00:01:47,870 --> 00:01:53,210
!إن تلقّيت ضربة، فرُدّها

9
00:01:51,490 --> 00:01:54,170
لنستمرّ في التّمرين. لا يمكننا
الاستسلام يا ريناتو

10
00:01:54,170 --> 00:01:56,220
سنفعلها في النّهاية، أنا واثق

11
00:01:56,220 --> 00:02:00,110
!أنتما! يا مُتعصِّبا التّنس الصّغيران

12
00:02:00,560 --> 00:02:03,100
إذا أردتما، يمكننا مُساعدتكما

13
00:02:05,310 --> 00:02:07,640
من أنتما؟

14
00:02:07,640 --> 00:02:12,390
تلميذا ثانويّة من إسبانيا يعشقان
التّنس مثلكما فحسب

15
00:02:12,710 --> 00:02:14,610
هل أنتما بارعان في التّنس؟

16
00:02:15,820 --> 00:02:16,910
لا بأس بنا

17
00:02:17,120 --> 00:02:19,670
إذاً هل يمكنكما ضرب الكُرة وتمريرها
عبر تلك الفتحة؟

18
00:02:19,670 --> 00:02:21,610
لديكما 50 مُحاولة

19
00:02:24,430 --> 00:02:25,450
لكَ ذلك

20
00:02:38,200 --> 00:02:41,940
حسناً؟ ما رأيكما برمياتي الدّقيقة؟

21
00:02:41,940 --> 00:02:44,210
أنتما مُذهلان

22
00:02:44,210 --> 00:02:47,750
أوقفَها بشكل بهلوانيّ من الوصول
إلى الشّارع

23
00:02:47,750 --> 00:02:49,140
أريد تجربة ذلك أيضاً

24
00:02:49,750 --> 00:02:54,270
تحتاج لتكون أكبر سنّاً قليلاً
لتؤدّي أسلوبي في التّنس

25
00:02:54,270 --> 00:02:58,630
لديّ فكرة. أرِني تلك الرّمية الّتي كنتُما
تتمرّنان عليها قبل قليل

26
00:02:58,630 --> 00:03:01,620
ما زلنا لا نستطيع فعلها إطلاقاً

27
00:03:01,620 --> 00:03:06,520
قبل مدّة قصيرة، علّمَنا إيّاها
رجلٌ ذو شعر طويل

28
00:03:06,520 --> 00:03:11,020
يعتقد الجميع بأنّنا لا نستطيع فعل
شيء بمفردنا بما أنّنا توأمان

29
00:03:11,410 --> 00:03:16,360
نريد أن نُثبت للجميع بأنّهم مُخطئون
بفوز أحدنا مُباراة يوماً ما

30
00:03:20,180 --> 00:03:22,720
في هذه الحالة، لديّ فكرة

31
00:03:31,530 --> 00:03:32,830
!حسناً

32
00:03:32,830 --> 00:03:34,610
شكراً لكما

33
00:03:34,610 --> 00:03:38,570
إذا لعبتُما مُباراة ثُنائيّة، فإنّ كافّة الكُرات
الّتي كانت تخرج ستبقى في الدّاخل

34
00:03:38,980 --> 00:03:42,020
والرّميات الّتي كنتُما تتمرّنان عليها
هي سِلاح عظيمٌ تمتلكانه

35
00:03:42,020 --> 00:03:46,410
بالمُناسبة. ذلك الرّجل ذو الشّعر الطّويل
كان يرتدي نفس كنزتكما

36
00:03:46,800 --> 00:03:49,660
ذو شعر طويل؟ تقصد ميدانوري؟

37
00:03:49,660 --> 00:03:52,850
أجل، هذا صحيح. قال بأنّ
اسمه كان ميدانوري

38
00:03:52,850 --> 00:03:54,990
لكن هذا غريب قليلاً

39
00:03:54,990 --> 00:03:59,650
عاد في اليوم التّالي، لكن بدا كشخص مُختلف

40
00:04:06,180 --> 00:04:08,940
!مارس! مارس

41
00:04:09,190 --> 00:04:10,810
!مارس

42
00:04:11,310 --> 00:04:14,100
!مارس! إلى أين ذهبت؟

43
00:04:15,090 --> 00:04:17,400
مرحباً يا صديقي. هل تحتاج شيئاً؟

44
00:04:17,810 --> 00:04:20,820
أنت من ملأ وجهَ رودريغو بالكدمات، أليس كذلك؟

45
00:04:20,820 --> 00:04:24,310
إذاً رودريغو وأولئك الأشخاص
أخبروك بذلك، صحيح؟

46
00:04:24,310 --> 00:04:25,160
لا، لم يفعلوا

47
00:04:25,160 --> 00:04:27,820
...ماذا؟ إذاً كيف

48
00:04:27,820 --> 00:04:30,280
عرفتُ بالنّظر إلى كدمته

49
00:04:30,280 --> 00:04:33,290
الرّمية طويلة المدى وحدها
ما يُخلِّف هذه العلامة

50
00:04:33,780 --> 00:04:38,330
اللّاعب الوحيد في فريق إسبانيا الّذي يستطيع
تسديد رمية كهذه هو أنت

51
00:04:39,040 --> 00:04:41,120
حميتَ ريوغا إتشيزن، أليس كذلك؟

52
00:04:41,120 --> 00:04:44,230
فرودريغو لا يُحبّه كثيراً

53
00:04:44,230 --> 00:04:47,220
لكن كلاكما ستُعاقبان على فعلتكما، مفهوم؟{?}

54
00:04:48,100 --> 00:04:51,300
أنت تكشف كُلَّ شيء، أليس
كذلك يا يوليو رومين؟

55
00:04:51,550 --> 00:04:52,930
!اسمي يوليو رومان

56
00:04:52,930 --> 00:04:55,610
وبعد؟ ماذا تنوي أن تفعل بي؟

57
00:04:55,610 --> 00:04:58,260
ستسحبني من التّشكيلة الرّئيسيّة
لنهائي الغد؟

58
00:04:58,260 --> 00:04:59,030
لا

59
00:04:59,780 --> 00:05:02,020
ستخضعان لمنهاج الصّداقة الخاصّ بي

60
00:05:02,020 --> 00:05:03,320
هذا غير مُمكن

61
00:05:03,320 --> 00:05:06,500
عليّ أن ألعب مُباراةً من سبعة أشواط
مع رودريغو الآن؟

62
00:05:06,500 --> 00:05:07,920
!إنّه الجحيم

63
00:05:07,920 --> 00:05:12,840
أجل. نحن فريق، لذا يجب على الجميع
أن ينسجموا معاً. حُبّ وسلام

64
00:05:14,420 --> 00:05:16,380
أنطونيو، هل أنت في الدّاخل؟

65
00:05:16,820 --> 00:05:20,210
كانت فوضى عارمة يا يوليو رومين

66
00:05:20,210 --> 00:05:22,330
!اسمي يوليو رومان

67
00:05:22,330 --> 00:05:24,130
وبعد؟ ما الأمر؟

68
00:05:24,610 --> 00:05:27,570
كان مارس من تسبّبَ بتلك الكدمة
البغيضة في وجهه

69
00:05:28,020 --> 00:05:30,000
اعترفَ بكُلّ شيء

70
00:05:30,000 --> 00:05:31,190
هكذا إذاً

71
00:05:31,590 --> 00:05:35,100
سأُخضِع مارس ورودريغو لمنهاج الصّداقة

72
00:05:35,380 --> 00:05:37,490
هل هذا مُناسب يا أنطونيو؟

73
00:05:37,490 --> 00:05:41,700
يمكنك أن تُميِّز ما يُفكِّر فيه شخص
بتعابير وجهه الدّقيقة

74
00:05:41,700 --> 00:05:44,640
لا أحد أكثر مهارة منك في قراءة العواطف

75
00:05:45,350 --> 00:05:48,380
أدع الأمر لحُكمك يا يوليو

76
00:05:49,180 --> 00:05:53,490
رغم ذلك، تبدو غرفتك وكأنّها الوحيدة
الفاخرة بعض الشّيء

77
00:05:54,150 --> 00:05:55,140
مُذكّرات؟

78
00:05:56,420 --> 00:06:00,010
حان الوقت لتوجّهنا إلى التّدريب
أيضاً يا نائب القائد يوليو

79
00:06:00,390 --> 00:06:03,140
،حالما تنتهي هذه البطولة

80
00:06:03,140 --> 00:06:07,260
سنفعل حتماً ذلك الشّيء الّذي وعدتَ به
في الأمس، يا صديقي العزيز

81
00:06:09,330 --> 00:06:11,390
أجل، بالطّبع

82
00:06:14,700 --> 00:06:17,800
حسناً إذاً. حان الوقتُ تقريباً

83
00:06:20,090 --> 00:06:25,810
خمسة. أربعة. ثلاثة. اثنان. واحد

84
00:06:29,400 --> 00:06:31,290
...أتيت في الوقت

85
00:06:31,290 --> 00:06:32,550
يا بامبيري

86
00:06:34,630 --> 00:06:36,670
هل حصلتَ على أي معلومات عن التّوأمين؟

87
00:06:36,910 --> 00:06:37,890
أجل

88
00:06:38,490 --> 00:06:40,880
حقّقتُ تقدُّماً أيضاً

89
00:06:40,880 --> 00:06:45,550
ميدانوري الّذي تكلّمتُ معه اليوم كان
مُختلفاً عنه في الأمس

90
00:06:45,550 --> 00:06:47,010
لا شكّ في ذلك

91
00:06:49,000 --> 00:06:50,650
يوليو

92
00:06:50,650 --> 00:06:54,370
لماذا أنت مُتحمّسٌ لمعرفة سرّ ميدانوري؟

93
00:06:55,330 --> 00:07:00,940
،إذا لم يُرِد ميدانوري إخبار أحد حقّاً
...فلن أتطفّل، لكن

94
00:07:01,260 --> 00:07:05,510
أحياناً، تبدو النّظر في وجهه مُتأسِّفة

95
00:07:06,760 --> 00:07:10,070
،إذا كان لديه شيء يريد قوله
ألا ينبغي أن نصغي له؟

96
00:07:10,570 --> 00:07:13,400
فنحن أصدقاؤه

97
00:07:13,400 --> 00:07:18,540
هذا شيء وحدها عينك الثّاقبة
للمشاعر هو ما سيفهمه

98
00:07:19,170 --> 00:07:23,560
على أيّ حال، يُراودني فضول حيال قِيام
شخص يقضي وقتَه يتجنّب النّاس

99
00:07:23,560 --> 00:07:26,710
بالخروج عن مساره والتكلُّم مع طفلين لا يعرفهما

100
00:07:28,410 --> 00:07:32,710
قال راؤول وريناتو كلاماً مُقلِقاً

101
00:07:33,340 --> 00:07:36,210
شكراً لك يا سيّد بامبي

102
00:07:36,210 --> 00:07:40,520
الحصول على فطائر توت أزرق هو
أشبه بحلم بالنّسبة لي

103
00:07:40,520 --> 00:07:43,890
علينا دوماً مُشاركة النّصف

104
00:07:44,120 --> 00:07:49,050
إن لم تُمانعا، هلّا أخبرتُماني بالمزيد
عن ميدانوري الّذي التقيتُما به قبل قليل؟

105
00:07:49,050 --> 00:07:51,540
غالباً لديه انفصام شخصيّة

106
00:07:51,540 --> 00:07:54,620
انفصام شخصيّة؟ لا، ليس كذلك

107
00:07:55,230 --> 00:07:57,390
هناك اثنان من ميدانوري

108
00:08:03,040 --> 00:08:06,280
اثنان من ميدانوري؟

109
00:08:43,450 --> 00:08:46,820
#نتائج المُباراة الفرديّة 3# والثُنائيّة 1
قد حُسِمتْ

110
00:08:46,820 --> 00:08:50,030
#كُلّ ما بقي هو الثُنائيّة 2

111
00:08:50,550 --> 00:08:54,590
يبدو أنّ اللّاعبين الّذين اجتازوها سئموا الانتظار

112
00:08:54,870 --> 00:08:59,260
هل هناك سبب جعلَك تُجدول الجولةَ المُقبلة
من المُباريات بحيث تبدأ في نفس الوقت؟

113
00:09:00,110 --> 00:09:04,310
هذه فُرصته الأخيرة

114
00:09:09,960 --> 00:09:12,690
الذّروة الخاصّة بك لن تفلح ضدّي بعد الآن

115
00:09:13,230 --> 00:09:15,910
!هذا صحيح. هذا مُذهل

116
00:09:15,910 --> 00:09:19,760
يوكيمورا ختمَ بالكامل على ذروة
الكمال الخاصّة بكينتارو

117
00:09:19,760 --> 00:09:21,400
بتنس الحسّ صفر الخاصّ به

118
00:09:24,830 --> 00:09:26,960
كينتارو

119
00:09:26,960 --> 00:09:28,160
نعم؟

120
00:09:28,680 --> 00:09:32,330
حتّى إن كان يوكيمورا يستطيع التّعامل
...مع ذروة الكمال الخاصّة بك

121
00:09:33,000 --> 00:09:38,130
رينجي ياناغاي لا يستطيع"، هو ما كان"
أوماغاري على وشك قوله

122
00:09:40,670 --> 00:09:42,280
لن أدعها تتجاوزنا

123
00:09:50,230 --> 00:09:53,660
انتهاء الشّوط. يوكيمورا وياناغي. 3-3

124
00:09:53,660 --> 00:09:57,890
ماذا؟ بئساً. ظننتُ بأنّني حقّقتُ نقطة رابحة

125
00:09:58,280 --> 00:10:01,910
على ذكر الأمر، ذلكما الشّخصان من نفس
المدرسة الإعداديّة، أليس كذلك؟

126
00:10:02,160 --> 00:10:04,560
التّعاون الجماعيّ بينهما رائع

127
00:10:05,630 --> 00:10:09,200
،قدرة يوكيمورا على تبديل المِضرب مُدهشة

128
00:10:09,200 --> 00:10:13,170
لكن ياناغي هو من يحوّلها
إلى طريقة للهجوم

129
00:10:14,090 --> 00:10:15,800
،بعد التقاط مِضرب

130
00:10:15,800 --> 00:10:19,950
استغرقَ إنتاج ذروة الكمال ستّة
أشهر فقط مع كينتارو

131
00:10:20,870 --> 00:10:24,060
،منذ ذلك الحين، غريزته الطّبيعيّة

132
00:10:24,060 --> 00:10:28,490
وكذلك سرعته وانفجاره وقوّته
كلّها قد تحسّنتْ بشكل ملحوظ

133
00:10:31,730 --> 00:10:33,580
،باستخدام أسلوبه غير التّقليديّ

134
00:10:33,580 --> 00:10:37,310
يردّ كُلَّ كُرة تمرُّ من فوق الشّبكة

135
00:10:37,310 --> 00:10:40,110
مع ذلك قلّة خبرته لا يمكن إنكارها

136
00:10:40,110 --> 00:10:41,000
!حسناً

137
00:10:44,600 --> 00:10:49,790
بعبارة أُخرى، إنّه غير معتاد على
مُواجهة لاعبين في آن واحد

138
00:10:49,790 --> 00:10:51,790
ما الأمر يا توياما؟

139
00:10:51,790 --> 00:10:53,960
كيف تنوي الحِفاظ على تبادُل
الكُرات السّريع هذا؟

140
00:10:55,450 --> 00:10:57,740
هذا تعاون جماعيّ مُدهش

141
00:10:57,740 --> 00:11:00,340
إنّهما يُعقِّدان عليه عمليّة كسب نقطة

142
00:11:00,340 --> 00:11:03,550
إن كنت لن تُسجّل نقطة رابحة، فسأفعل

143
00:11:04,170 --> 00:11:07,760
انتهاء الشّوط، يوكيمورا وياناغي. 3-4

144
00:11:09,090 --> 00:11:12,050
أيّها الصّديق ذو المِضرب الثّنائيّ

145
00:11:12,050 --> 00:11:14,440
هل نحن في مأزق هنا؟

146
00:11:14,440 --> 00:11:16,030
بربّك

147
00:11:16,310 --> 00:11:18,760
أنت من يتلقّى هزيمة نكراء

148
00:11:18,760 --> 00:11:21,220
إذا استمرّ هذا، فسوف نخسر

149
00:11:23,790 --> 00:11:28,330
إعداديّة شيتينهوجي\h\h\hقبل 8 أشهر

150
00:11:25,970 --> 00:11:28,660
بعض الأشخاص من إعداديّة تاكاناكا
أتوا إلى هنا للقتال؟

151
00:11:28,660 --> 00:11:31,400
هذا سيّئ. لِمَ لا تجمع الأصدقاء؟

152
00:11:31,400 --> 00:11:33,850
!لا تدعوهم يتخطّون بوّابةَ المدرسة

153
00:11:33,850 --> 00:11:35,420
!دافعوا عنها بأرواحكم

154
00:11:40,350 --> 00:11:43,780
إذا هزمتُ الأشرار، فسأحصل على
تاكوياكي، صحيح؟

155
00:11:46,220 --> 00:11:48,780
كينتارو، هذا عربون شكر على مُساعدتك

156
00:11:49,510 --> 00:11:51,490
هذا ما كنتُ أنتظره

157
00:11:51,490 --> 00:11:55,060
أستطيع أكل تاكوياكي طوال اليوم

158
00:11:55,540 --> 00:11:59,120
كينتارو، هل يمكنك المجيء واللّعب
في مُباراة كُرة القدم المُقبلة خاصّتنا؟

159
00:11:59,120 --> 00:12:01,180
إذا أعطيتني تاكوياكي، فسألعب

160
00:12:01,180 --> 00:12:02,690
أنت عبقريٌّ حقّاً يا رجل

161
00:12:03,060 --> 00:12:06,640
قبل أيّام، ساعدَ فريق البيسبول وحقّقَ
هوم ران في كلّ دور له في ضرب الكُرة

162
00:12:07,060 --> 00:12:09,640
أستطيع فعل أيّ شيء

163
00:12:09,640 --> 00:12:12,670
توقّف مكانك أيّها المُشاغب الهزيل

164
00:12:13,450 --> 00:12:16,860
تقول بأنّك تستطيع فعل أيّ شيء
أيُّها الغبيّ؟

165
00:12:16,860 --> 00:12:19,930
انزل إلى هنا حالاً أيّها الغبيّ

166
00:12:19,930 --> 00:12:22,750
هل تحتاجين شيئاً أيّتها العجوز ذات النظّارة؟

167
00:12:22,750 --> 00:12:26,380
لا تتكلّم معي بهذه العفويّة أيّها الغبيّ

168
00:12:27,350 --> 00:12:29,860
"قلتَ بأنّك تستطيع فعل "أيّ شيء

169
00:12:29,860 --> 00:12:32,640
إذاً أنت تكذب كثيراً أيّها الغبيّ الأحمق

170
00:12:33,090 --> 00:12:37,310
حاول أن تلعب التّنس ضدّي أيّها الغبيّ

171
00:12:41,320 --> 00:12:42,990
أمير التّنس الجزء الثّاني

172
00:12:41,320 --> 00:12:42,990
مُباراة اختيار العضو الأخير

173
00:12:46,320 --> 00:12:47,990
أمير التّنس الجزء الثّاني

174
00:12:46,320 --> 00:12:47,990
مُباراة اختيار العضو الأخير

175
00:12:56,940 --> 00:12:59,260
ما الخطب أيّها الغبيّ؟

176
00:12:59,830 --> 00:13:02,600
إن كنت مُحبَطاً، فحاول أن تردّها

177
00:13:05,590 --> 00:13:09,400
لا يستطيع كينتارو لمس الكُرة بمِضربه حتّى

178
00:13:09,400 --> 00:13:12,050
مـ-من هذه المرأة العجوز؟

179
00:13:13,890 --> 00:13:17,050
!أستسلم! التّنس مُملّة

180
00:13:17,050 --> 00:13:18,550
أتتهرّب؟

181
00:13:21,340 --> 00:13:24,740
!إن تلقّيت ضربة، فرُدّها

182
00:13:27,740 --> 00:13:29,340
هذا مُستحيل

183
00:13:29,710 --> 00:13:34,660
هذا الطّفل لن يقترب حتّى من كُرة
ضربتها يا سوغي

184
00:13:34,660 --> 00:13:39,250
كانت الجدّة أوسوغي لاعبة تنس
مُحترفة أسطوريّة

185
00:13:39,250 --> 00:13:42,640
ربحت مُباراة ثُنائيّة في ويمبلدون

186
00:13:44,510 --> 00:13:48,000
!هيّا! سأفعل المُستحيل

187
00:13:54,650 --> 00:13:56,280
!تبّاً

188
00:13:59,160 --> 00:14:00,690
تاكوياكي؟

189
00:14:01,430 --> 00:14:04,670
تعال ثانية غداً أيّها الغبيّ

190
00:14:08,440 --> 00:14:10,830
ما رأيك بذلك أيّها المُشاغب الهزيل؟

191
00:14:10,830 --> 00:14:13,950
!اصمتي! أكره التّنس

192
00:14:14,950 --> 00:14:18,110
حاول ردّ رميات العجوز هذه أيّها الغبيّ

193
00:14:18,110 --> 00:14:21,380
ألم أقل لكِ بأنّني أكره التّنس؟

194
00:14:33,930 --> 00:14:37,250
لم يعُد ذلك الفتى يأتي إلى هنا
مُؤخّراً، أليس كذلك؟

195
00:14:37,250 --> 00:14:41,380
قبل مدّة قصيرة، كانت الأجواء حيويّة
هنا في كلّ يوم

196
00:14:41,380 --> 00:14:43,170
كانت كذلك بالفعل

197
00:14:45,570 --> 00:14:51,390
أيّتها العجوز، قرّرتُ الانضمام لفريق
إعداديّة شينتينهوجي للتّنس

198
00:14:52,090 --> 00:14:53,610
هل فاجأتُكِ؟

199
00:14:54,750 --> 00:14:57,580
...بفضلكِ أيّتها العجوز، أنا

200
00:14:58,240 --> 00:15:01,120
أعشق التّنس حقّاً

201
00:15:01,670 --> 00:15:05,420
سوف أصبح أفضل لاعب تنس في اليابان

202
00:15:05,420 --> 00:15:08,670
بهذا المِضرب الّذي أعطيتِني إيّاه

203
00:15:09,350 --> 00:15:13,400
!هذا صحيح. إن تلقّيت ضربة، فرُدّها

204
00:15:13,400 --> 00:15:18,710
وعدتُ العجوز بأنّني سأصبح أفضل لاعب
تنس في اليابان

205
00:15:18,970 --> 00:15:23,230
ماذا؟ الأفضل في اليابان؟ ألا تقصد العالم؟

206
00:15:23,550 --> 00:15:26,560
!هذا صحيح! في العالم كُلّه

207
00:15:26,560 --> 00:15:31,070
،لكن يا كين، إذا خسرت هذه المُباراة
فلن تتمكّن من اللّعب في النّهائي

208
00:15:31,070 --> 00:15:35,060
لـ-لا، هذا سيّئ. ماذا يجدر بي أن
أفعل يا شيرايشي؟

209
00:15:37,450 --> 00:15:42,760
لا تذهب وتُقاتل لوحدك وتُورّط نفسك بمأزق

210
00:15:52,080 --> 00:15:54,260
أوماغاري يستخدم مِضربين

211
00:15:54,260 --> 00:15:58,980
حتّى غينيتشيرو قد اندهش بتغطيته
في الملعب وأسلوبه الخادع

212
00:16:00,460 --> 00:16:04,580
لكن إذا استطعت توقُّع المسار
،قبل أن يستعدّ للرّمي

213
00:16:04,970 --> 00:16:07,010
فستكون رمية قابلة للقراءة

214
00:16:07,410 --> 00:16:09,070
لن أدعك تقرأني

215
00:16:13,310 --> 00:16:16,280
،ظننتُ بأنّني أستطيع توقُّع المسار بطريقة ما

216
00:16:16,710 --> 00:16:18,190
لكن لا أستطيع قراءة أفكاره إطلاقاً

217
00:16:18,660 --> 00:16:22,370
إذا كان يستطيع التّبديل بين باطن اليد
،وظاهر اليد بحسب تحرُّكاتنا

218
00:16:22,370 --> 00:16:24,710
فستكون هزيمته صعبة للغاية

219
00:16:24,710 --> 00:16:28,740
أوّلاً، سأجرّدك من قدرتك في صنع الأحكام

220
00:16:35,350 --> 00:16:36,890
ويتبعها باطن اليد

221
00:16:38,870 --> 00:16:40,130
!أراشيكو

222
00:16:40,460 --> 00:16:44,170
إنّه قادر فوراً على توقُّع الاتِّجاه
الّذي سوف نسلكه

223
00:16:44,760 --> 00:16:49,020
لديه خبرة في الثّنائيّات أعلى من خبرتنا بكثير

224
00:16:50,060 --> 00:16:54,460
إذاً هذه هي القدرة الحقيقيّ للرّقم ستّة
،للعباقرة العشرة

225
00:16:54,460 --> 00:16:57,310
اختصاصي المِضرب الثّنائي، ريوجي أوماغاري

226
00:17:00,760 --> 00:17:01,660
باطن اليد؟

227
00:17:01,660 --> 00:17:02,780
ظاهر اليد؟

228
00:17:03,010 --> 00:17:05,080
!ستكون هذه من نصيبي

229
00:17:09,190 --> 00:17:10,390
ما رأيك؟

230
00:17:10,390 --> 00:17:12,390
حسناً، أعتقد بأنّها نجحت

231
00:17:12,660 --> 00:17:18,300
بفضل أوماغاري، يعتاد كينتارو تدريجيّاً
على لعب في مُباراة ثُنائيّة

232
00:17:18,300 --> 00:17:21,320
هذا صحيح يا كين. المُباريات الثُّنائيّة
تعتمد بالكامل على التّوقيت

233
00:17:21,810 --> 00:17:25,560
انتهاء الشّوط، أوماغاري وتوياما. 5-6

234
00:17:27,200 --> 00:17:30,320
بتشكيل فريق مع أوماغاري، الّذي
،يعتمد على التّقنيّة

235
00:17:30,320 --> 00:17:34,350
ستكتشف حتماً إمكانيّات جديدة غير القوّة

236
00:17:41,620 --> 00:17:42,780
كيف تسير الأمور يا ياناغي؟

237
00:17:43,030 --> 00:17:44,610
جمعتُ البيانات

238
00:17:44,950 --> 00:17:50,410
،بحسب أسلوب لعِبه السّابق وشخصيّته
حسبتُ نقاطَ ضعفه في الثُّنائيّات

239
00:17:50,990 --> 00:17:56,440
يمتلك أوماغاري خبرةً أكبر في الثُّنائيّات
ممّا نملك بالفعل

240
00:17:58,530 --> 00:18:00,080
15-40

241
00:18:00,710 --> 00:18:04,930
لكن الثُّنائيّات هي مُباراة استغلال
الرّابط الأضعف

242
00:18:06,150 --> 00:18:07,610
30-40

243
00:18:08,100 --> 00:18:10,490
...لسوء حظّهما، هذه المُباراة

244
00:18:11,090 --> 00:18:13,550
هي من نصيبنا...

245
00:18:13,970 --> 00:18:15,490
ماذا؟

246
00:18:15,490 --> 00:18:17,320
إنّهما ضمن خطّ مُستقيم؟

247
00:18:17,320 --> 00:18:20,790
أيّ اتِّجاه سيسلكان؟ الأمام؟ الجوانب؟

248
00:18:20,790 --> 00:18:22,660
إلى أيّ جهة ينبغي أن أضربها؟

249
00:18:22,920 --> 00:18:27,560
إذا ضربَها بشكل مُستقيم، فيستطيع ياناغي
ردّ ذروة الكمال

250
00:18:27,560 --> 00:18:29,350
،إذا صوّبها نحو أحد الاتّجاهين

251
00:18:29,350 --> 00:18:34,220
فيستطيع يوكيمورا التّعامل معها بسهولة
باستخدام مِرآة السّراب

252
00:18:35,550 --> 00:18:37,850
لا وقت للتردُّد

253
00:18:43,160 --> 00:18:46,460
%احتماليّة تجنّبك لسيتشي هي 100

254
00:18:54,600 --> 00:18:59,980
انتهاء المُباراة، أوماغاري وتوياما. 5-7

255
00:19:01,980 --> 00:19:03,490
كينتارو

256
00:19:03,860 --> 00:19:05,860
!لا تندهش يا رجل

257
00:19:05,860 --> 00:19:10,130
في الثّنائيّات، يجب عليك صنع القرارات بشكل
أسرع من المُباريات الفرديّة وإلّا ستبقى مُتأخّراً

258
00:19:10,510 --> 00:19:13,230
القدرة على صنع قرار بسرعة؟

259
00:19:13,230 --> 00:19:15,550
هذه قدرةٌ صعبةٌ حقّاً

260
00:19:16,930 --> 00:19:19,300
حسناً، لقد ربحنا، لذا الأمور بخير، صحيح؟

261
00:19:19,300 --> 00:19:22,110
أعتمد عليك في المُباراة المُقبلة أيضاً
يا صديقي ذو المِضرب الثّنائيّ

262
00:19:23,100 --> 00:19:25,270
يُحمّله العبء كُلّه

263
00:19:26,260 --> 00:19:28,090
كانت مُباراة مُمتعة

264
00:19:30,100 --> 00:19:34,770
كانت الخطّة هي التصدّي لذروة الكمال
...الخاصّة بتوياما معاً، لكن

265
00:19:34,770 --> 00:19:38,500
المُفاجئ، لا يكون الأمر سهلاً عند
مُواجهة تلميذ ثانويّة

266
00:19:40,720 --> 00:19:47,190
لكن إذا لعِبا هكذا، فهناك احتمال بنسبة
مئة بالمئة ألّا يربحا في المُباراة المُقبلة

267
00:19:49,140 --> 00:19:51,830
ستبدأ المُباريات الأخيرة الآن

268
00:19:51,830 --> 00:19:53,700
أيّها اللّاعبان، استعدّا رجاء

269
00:19:54,090 --> 00:19:56,690
أتطلّع بشوق لهذه المُباراة يا سيّد

270
00:19:57,440 --> 00:20:00,500
لن أتحفّظ أبداً

271
00:20:01,220 --> 00:20:03,520
هكذا إذاً

272
00:20:03,840 --> 00:20:07,440
إذاً كان توكوغاوا مُتورّطاً في إصابة
ميدانوري، صحيح؟

273
00:20:07,440 --> 00:20:11,470
رغم ذلك، أنت تستمتع بالاعتناء بالنّاس
حقّاً، أليس كذلك يا زعيم؟

274
00:20:11,470 --> 00:20:13,470
لا تكُن سخيفاً يا ديوك

275
00:20:13,470 --> 00:20:15,800
كُلّ هذا لأجل فريق اليابان

276
00:20:15,800 --> 00:20:18,490
ستكون مُشكلة إذا لم يربح بالنّيابة عنّي

277
00:20:18,950 --> 00:20:21,700
أصبح أقوى على مدى العام الماضي

278
00:20:21,700 --> 00:20:25,490
من المؤكّد أنّه اكتسبَ سمعته برسم
هدف وهو هزيمتي

279
00:20:26,160 --> 00:20:29,120
لكن اللّطف الّذي يُرافقه إحساس قويّ بالعدالة

280
00:20:29,120 --> 00:20:31,680
يمكن أن يكون نقطة ضعف قاتلة أحياناً

281
00:20:31,680 --> 00:20:36,480
،سيستغلّ المُحترف هذه الميزة حتماً
الأمر الّذي سيؤدّي إلى هزيمته

282
00:20:36,480 --> 00:20:40,160
إذاً تريدني أن أكون عقبته الأخيرة؟

283
00:20:41,070 --> 00:20:44,180
،حتّى لو طلبتَ ذلك يا زعيم
لا أستطيع قبول هذا

284
00:20:44,180 --> 00:20:48,120
هذه المُباراة هي بطولة العالم الضّخمة
الأخيرة لي كتلميذ

285
00:20:48,120 --> 00:20:53,020
،أخبرتُ أختي الصُّغرى، كلوي، بالفعل
بالمجيء لمُشاهدتي في النّهائي

286
00:20:53,020 --> 00:20:56,500
لا أقبل بالخسارة أبداً، حتّى أمام توكوغاوا

287
00:20:57,510 --> 00:20:58,900
لا عليك

288
00:20:58,900 --> 00:21:05,100
إذا خسرَ أمامك أيُّها المُدمِّر، فهذا
يعني بأنّ هذه هي قيمته

289
00:21:12,800 --> 00:21:16,110
حسناً إذاً، هل نبدأ يا أتوبي؟

290
00:21:20,460 --> 00:21:25,370
لم أتصوّر أبداً أن أتمكّن من مُواجهتك ثانية

291
00:21:26,990 --> 00:21:28,510
معك حقّ

292
00:21:28,510 --> 00:21:31,710
والآن، هل نبدأ بسرعة يا إتشيزن؟

293
00:21:32,970 --> 00:21:36,600
هذه المرّة، سأحرص على حسم هذا
الأمر بشكل نهائيّ يا فوجي

294
00:21:36,600 --> 00:21:38,730
وإكمال مُباراتنا منذ ذلك اليوم الماطر

295
00:23:18,620 --> 00:23:23,450
قبل أيّام، كان مومو يتساءل عن سبب
انسحاب الفريق الآخر

296
00:23:23,450 --> 00:23:28,140
فجأة من الجولة الأولى من البطولة

297
00:23:28,140 --> 00:23:31,880
لكن في الواقع، أنا وكينتارو نعرف السّبب

298
00:23:32,540 --> 00:23:34,900
"الحلقة القادمة: "الرّجل المُقنّع

299
00:23:32,590 --> 00:23:40,050
الرّجل المُقنَّع

300
00:23:36,100 --> 00:23:38,470
إيّاكم والاستهانة بالتّنس اليابانيّ