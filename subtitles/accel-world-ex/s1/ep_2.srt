1
00:00:07,140 --> 00:00:07,820
!إنّه سريع

2
00:00:13,970 --> 00:00:14,740
.إنّه قويّ

3
00:00:14,740 --> 00:00:17,940
!الأخضر الزّيتوني هو لون الجنود

4
00:00:17,940 --> 00:00:21,330
!لا يمكن للضّعفاء الزُّرق الحاق أيّ ضررٍ بي

5
00:00:21,330 --> 00:00:23,460
!أتحدّاك أن تتفوّه بذلك في إقليم ليونيدس

6
00:00:25,080 --> 00:00:26,000
بيل!؟

7
00:00:28,500 --> 00:00:29,940
!أنا بخير

8
00:00:29,940 --> 00:00:32,470
!لكنّ اثنين منهم قد هربوا

9
00:00:42,310 --> 00:00:44,670
!لا نتساهل مع ذوي الاحتياجات الخاصّة أيضًا

10
00:00:44,670 --> 00:00:47,190
!نحن مجنّدون عديمو الرّحمة

11
00:00:47,190 --> 00:00:52,110
.إن كنتم تحبّون لعبَ دور المجنّد، فينبغي عليكم الانضمام للجّيش في العالم الحقيقي

12
00:01:04,040 --> 00:01:05,150
.هذا جيّد

13
00:01:05,150 --> 00:01:05,950
.أجل

14
00:01:05,950 --> 00:01:09,960
.معارك الأقاليم اصبحت اسهل بكثير منذ انضمام رايكر-سان

15
00:01:09,960 --> 00:01:10,740
.أجل

16
00:01:10,740 --> 00:01:13,330
.وبفضل ذلك يمكننا شنّ هجوماتٍ كهذه

17
00:01:13,710 --> 00:01:15,880
.سينباي، أنتِ قريبةٌ جدًّا

18
00:01:16,520 --> 00:01:18,340
-لا داعٍ للحرج بشخصيّاتنا

19
00:01:23,770 --> 00:01:25,910
!سأتعامل مع مضادّ الطّيران

20
00:01:25,910 --> 00:01:26,640
!حسنًا

21
00:01:30,360 --> 00:01:33,180
!انطلاق

22
00:03:10,370 --> 00:03:12,170
!احسنتم جميعًا

23
00:03:12,170 --> 00:03:15,080
.%معدّل الفوز في معارك الأقاليم خاصّتنا يبلغ 75

24
00:03:15,080 --> 00:03:17,060
.إنّه رقمنا القياسيّ

25
00:03:17,060 --> 00:03:21,340
.تبدو حقًّا مرتاحًا حولَ فوكو-نيسان

26
00:03:21,340 --> 00:03:22,780
.أجل

27
00:03:22,780 --> 00:03:26,410
.رغم ذلك، لم توافق فوكو على المجيء إلى هنا

28
00:03:26,410 --> 00:03:27,900
.لا يمكننا لومها

29
00:03:27,900 --> 00:03:29,560
.شيبويا بعيدةٌ عن هنا

30
00:03:29,560 --> 00:03:30,590
.أجل

31
00:03:32,400 --> 00:03:34,020
هل تأكل مجدّدًا يا هارو!؟

32
00:03:34,020 --> 00:03:35,410
من يهتم؟

33
00:03:35,410 --> 00:03:38,530
.لقد قاتلنا في 6 معارك وأنا أتضوّر جوعًا

34
00:03:38,530 --> 00:03:43,400
.لكن لم تمرّ سوى 30 دقيقة في العالم الحقيقيّ منذ أن تناولتَ الّلازانيا الّتي اعدتها أمّي

35
00:03:43,400 --> 00:03:46,020
.لقد قاتلنا لنصف يوم في العالم الافتراضي

36
00:03:46,760 --> 00:03:49,750
.هارو، عليّ تفقّد شيء معك

37
00:03:49,750 --> 00:03:53,900
نتائج فحوصاتك الجسديّة من الأسبوع الماضي كانت جيّدة، أليس كذلك؟

38
00:03:54,720 --> 00:04:00,210
.أجل، تلقّيتُ رسالة تنصّ على حاجَتي لإعادة الفحوصات بعد اسبوعين

39
00:04:00,210 --> 00:04:01,240
ماذا؟

40
00:04:01,240 --> 00:04:02,680
حقًّا يا هارو!؟

41
00:04:02,680 --> 00:04:04,660
.أجل

42
00:04:04,660 --> 00:04:09,080
.ذلك قد يكون سيّئًا يا هارويوكي-كن

43
00:04:09,080 --> 00:04:10,520
لماذا؟

44
00:04:11,080 --> 00:04:14,850
.لقد أسّسوا نظامًا للنّقاط للاختبارات الجسديّة ابتداءًا من هذا العام

45
00:04:14,850 --> 00:04:21,660
.الطُلّاب الّذين لا ينجحون في الاختبارات عليهم المشاركة في برنامج لتحسين الصحّة

46
00:04:21,660 --> 00:04:22,610
إيه؟

47
00:04:22,610 --> 00:04:25,620
.لم تعرف ذلك؟ لقد كتبوها في الرّسالة يا هارو

48
00:04:36,660 --> 00:04:40,070
...أظنّني رأيتها

49
00:04:40,070 --> 00:04:42,000
.لقد قمتَ بتجاهلها على الأغلب

50
00:04:42,000 --> 00:04:45,610
.عندما تتلقّى تنويهًا لا يعجبك فأنت إمّا تتظاهر بعدم رؤيته أو تنسى أمره

51
00:04:45,610 --> 00:04:47,350
.هذا يحدث طول الوقت

52
00:04:47,350 --> 00:04:49,250
!كـ كلاّ

53
00:04:49,250 --> 00:04:52,870
.إنّها محقّة يا هارو

54
00:04:52,870 --> 00:04:54,440
أنت أيضًا يا تاكو!؟

55
00:04:54,960 --> 00:04:59,380
.يمكن لذلك أن يكون مشكلة لنا يا قائدة

56
00:04:59,380 --> 00:05:01,490
.أجل، أنت محق

57
00:05:01,490 --> 00:05:03,070
ما المقصود؟

58
00:05:03,070 --> 00:05:08,230
.موعد برنامج تحسين الصحّة هو كلّ سبتٍ من بعد الظهر حتّى الّليل

59
00:05:08,230 --> 00:05:11,990
.وعليك زيارة العيّادة المتواجدة في مقاطعتك

60
00:05:11,990 --> 00:05:14,900
.ستكون منعزلاً عن الشّبكة العالميّة

61
00:05:15,580 --> 00:05:17,000
...هذا يعني أنّ

62
00:05:17,000 --> 00:05:22,200
.لن تتمكّن من المشاركة في معارك الأقاليم إن انتهى بك الأمر مشاركًا في البرنامج

63
00:05:22,610 --> 00:05:24,840
!مـ مُحال

64
00:05:26,550 --> 00:05:28,890
مازلتَ تأكل!؟

65
00:05:28,890 --> 00:05:31,100
!ستكون خسارةً إن لم أفعل ذلك

66
00:05:31,100 --> 00:05:33,310
.هذه مشكلةٌ حقيقيّة يا هارو

67
00:05:33,910 --> 00:05:36,390
.لديك خيارين

68
00:05:36,390 --> 00:05:40,770
الحصول على نقاطٍ أعلى في إعادة الفحص بعد اسبوعين

69
00:05:40,770 --> 00:05:44,820
.أو الاستسلام والمشاركة في البرنامج

70
00:05:44,820 --> 00:05:47,490
هـ هل يمكن لكلّ شيءٍ أن يكون كما هو عليه؟

71
00:05:47,490 --> 00:05:49,950
.للأسف، لا

72
00:05:49,950 --> 00:05:57,250
ما الّذي عليّ فعله من أجل تحسين نقاطي بالاختبار الجسدي؟

73
00:05:57,770 --> 00:06:00,700
.أنا واثقٌ أنّك تعرف الاجابة يا هارو

74
00:06:03,130 --> 00:06:04,700
.لا خيار لك

75
00:06:04,700 --> 00:06:10,550
هارو، لماذا لا نتظاهر أنّه قد تمّ خداعك لجعلي أتعامل مع الأمر في الاسبوع المقبل؟

76
00:06:10,550 --> 00:06:12,440
.أكره أن يتمّ خداعي

77
00:06:12,440 --> 00:06:14,920
.تظاهر إنّ كلبًا قد عضّك بدلاً عن ذلك

78
00:06:14,920 --> 00:06:16,640
!ذلك أسوء

79
00:06:16,640 --> 00:06:20,950
إذًا، فلا مانع عندك من عدم المشاركة في معارك الأقاليم؟

80
00:06:20,950 --> 00:06:23,070
...طـ طبعًا لا

81
00:06:23,070 --> 00:06:25,530
!لا  خيار لديك إذًا

82
00:06:25,530 --> 00:06:28,040
!هيّا هارو! جهّز نفسك

83
00:06:28,600 --> 00:06:32,820
أنا، تشيوري-سان، الّذي حاولت جميع طرق التّخسيس تحت الشّمس

84
00:06:32,820 --> 00:06:37,050
!ستنجح في جعلك تفقد وزنًا لدرجة اندهاش سلفر كرو

85
00:06:47,180 --> 00:06:49,720
.سوف أكون صارمةً معك

86
00:06:49,720 --> 00:06:50,840
هل فهمت يا هارو؟

87
00:06:50,840 --> 00:06:52,560
.حسنًا

88
00:06:52,560 --> 00:06:54,670
.ابذل جهدك يا أوني-تشان

89
00:06:55,590 --> 00:06:58,020
لماذا أنتنّ هنا؟

90
00:06:58,020 --> 00:07:04,390
!كان عليّ المجيء بعد سماعي أنّك ستبذل جهدًا كبيرًا لتخسر وزنًا

91
00:07:05,650 --> 00:07:07,070
.حظٌّ سيّء

92
00:07:19,550 --> 00:07:21,330
!لا تحديق

93
00:07:22,080 --> 00:07:25,420
!جولتين في الحوض! هيّا

94
00:07:29,400 --> 00:07:31,050
ما الّذي تنظرين إليه؟

95
00:07:31,050 --> 00:07:34,430
.لا شيء، فقط فكّرت أنهم قد كبروا قليلاً

96
00:07:34,430 --> 00:07:37,140
.مقارنةً إلى حجمهم عندما استحممنا معًا

97
00:07:37,140 --> 00:07:39,770
!لـ لا علاقة لك في ذلك

98
00:07:40,240 --> 00:07:41,450
.أنتِ محقّة

99
00:07:41,450 --> 00:07:42,940
.قد أكون أتصوّر أشياء وحسب

100
00:07:42,940 --> 00:07:44,540
!هيّا

101
00:07:45,010 --> 00:07:52,570
على كلّ حال، إن سقط معدّل الفوز وقُدّر لـ سوغينامي أن تكون منطقة للشجارات

102
00:07:52,570 --> 00:07:54,910
.فسيسبّب ذلك لنا مشاكل أيضًا

103
00:07:54,910 --> 00:07:57,870
.احرصي على تدريبه جيّدًا

104
00:08:58,010 --> 00:09:00,270
.لقد مرّ اسبوع على بداية تدريبك

105
00:09:00,270 --> 00:09:02,790
وأنت لم تخسر سوى 300 غرام!؟

106
00:09:02,790 --> 00:09:04,640
!أودّ معرفة السّبب أيضًا

107
00:09:08,880 --> 00:09:11,190
فوكو-نيسان تّتصل

108
00:09:11,190 --> 00:09:13,420
هارو، هل يمكننا استخدام الخادم الخاصّ بك للردّ؟

109
00:09:13,420 --> 00:09:14,490
.حسنًا

110
00:09:15,320 --> 00:09:17,950
مرحبًا، هل هناك أيّ تطوّرات؟

111
00:09:17,950 --> 00:09:19,840
!كلّا

112
00:09:19,840 --> 00:09:22,950
!هارو لا يخسر وزنًا مهما حاولت

113
00:09:22,950 --> 00:09:26,110
.قد يكون ذلك متعلّقٌ بجسمه

114
00:09:26,110 --> 00:09:31,460
.بعض النّاس يزداد وزنهم حتّى إن صامو عن الأكل واكتفوا بشرب الماء

115
00:09:31,460 --> 00:09:32,780
!مُحال

116
00:09:32,780 --> 00:09:34,270
ماذا الأن ني-سان؟

117
00:09:34,270 --> 00:09:36,880
!تبقّى أسبوع على إعادة الفحوصات

118
00:09:36,880 --> 00:09:39,360
.لديّ خطّة

119
00:09:39,360 --> 00:09:42,060
هل يمكنك الاعتماد عليّ يا كرو-سان؟

120
00:09:42,060 --> 00:09:44,390
هيه؟ الاعتماد عليكِ يا معلّمة!؟

121
00:09:44,390 --> 00:09:50,370
.هناك ينبوع حارّ يمكنه تحسين حالتك الجسديّة

122
00:09:50,370 --> 00:09:56,640
ما رأيكم في الذّهاب إليه لخسارة الوزن بعد معركة الإقليم في نهاية الاسبوع؟

123
00:09:56,640 --> 00:09:58,610
ذلك "الينبوع الحار" يا فوكو؟

124
00:09:58,610 --> 00:10:00,910
."أجل، "ذلك

125
00:10:00,910 --> 00:10:03,040
هل سبقَ وأن زرتيهِ يا سينباي؟

126
00:10:03,040 --> 00:10:07,580
.أجل، في الواقع إنّه معروف بين الباست لينكرز

127
00:10:08,540 --> 00:10:10,080
.بالمناسبة، إنّه مختلط

128
00:10:10,080 --> 00:10:11,630
ماذا!؟

129
00:10:16,260 --> 00:10:19,030
!آه، الماء مريح

130
00:10:19,030 --> 00:10:20,090
أليس كذلك؟

131
00:10:20,090 --> 00:10:23,780
ما الّذي تفعلانه يا هارويوكي-كن و تاكومو-كن؟

132
00:10:23,780 --> 00:10:25,750
...إم

133
00:10:25,750 --> 00:10:26,630
.لا مشكلة

134
00:10:26,630 --> 00:10:29,100
.إنّه حمّام مختلط. لا داع للقلق

135
00:10:29,100 --> 00:10:30,760
!هذا صحيح أوني-تشان

136
00:10:30,760 --> 00:10:32,500
هل تريد أن أفرك ظهرك؟

137
00:10:32,500 --> 00:10:34,110
...كـ كلّا

138
00:10:34,110 --> 00:10:37,320
لماذا نستحمّ بشخصيّاتنا!؟

139
00:10:37,320 --> 00:10:38,930
!تمامًا

140
00:10:38,930 --> 00:10:41,800
!لا فائدة من فعل ذلك بشخصيّاتنا

141
00:10:41,800 --> 00:10:44,960
أوه؟ هل توقّعتَ شيئًا مختلفًا يا تاكّون؟

142
00:10:44,960 --> 00:10:47,640
هل أنت منحرف؟

143
00:10:47,640 --> 00:10:48,670
!كلّا

144
00:10:48,670 --> 00:10:52,540
!سؤالي هو ما إن كانت هناك فائدة من الاستحمام بشخصيّاتنا

145
00:10:52,540 --> 00:10:54,500
أوي، أوي

146
00:10:54,500 --> 00:10:58,170
!ركّز على جميع التّفاصيل وسوف تصبح أصلعًا، أيّها الأصلع

147
00:10:58,170 --> 00:11:00,160
!لستُ أصلعًا

148
00:11:00,160 --> 00:11:02,430
لماذا جئت إلى هنا يا أش-سان!؟

149
00:11:02,430 --> 00:11:04,100
.لقد طلبتُ منه المجيء

150
00:11:04,100 --> 00:11:08,520
.سمع أش أنّك تمرّ بوقتٍ عصيب، لذلك أراد تشجيعك

151
00:11:08,520 --> 00:11:12,260
!لم أقصد ذلك يا معلّمة

152
00:11:12,260 --> 00:11:14,450
حقًّا؟

153
00:11:14,450 --> 00:11:20,400
!لقد جئتُ لمشاهدتك تعاني وللضحك عليك

154
00:11:20,900 --> 00:11:23,870
!أتبجّح على كرو

155
00:11:24,870 --> 00:11:27,870
!رائع جدًّا

156
00:11:29,830 --> 00:11:35,250
.هذا الينبوع الحار معروف بامكيانته على اشفاء اعتلالات الحالة

157
00:11:36,090 --> 00:11:40,800
بعض اعتلالات الحالة لا تُزال حتّى بعد الموت واعادة الاحياء، صحيح؟

158
00:11:40,800 --> 00:11:45,260
...عادة ما يمكن ازالتهم بأدوية يتمّ شرائها من محلّات الأدوات، لكن

159
00:11:45,260 --> 00:11:48,460
.هذا الينبوع لديه نفس التأثير

160
00:11:48,460 --> 00:11:50,360
"نسمّيه "حمّام الشّفاء

161
00:11:50,360 --> 00:11:51,480
هكذا إذًا؟

162
00:11:56,070 --> 00:11:59,190
.وهذا الينبوع الحار موجود في العالم الحقيقي أيضًا

163
00:11:59,530 --> 00:12:04,710
.يُقال أنّه قادر على تنزيل الوزن وتجميل الجّسم

164
00:12:04,710 --> 00:12:07,700
.بالمناسبة، الجنسيْن مفصوليْن

165
00:12:07,700 --> 00:12:09,130
.لذلك لا تفكّرا في أشياء غريبة

166
00:12:09,130 --> 00:12:10,280
!لا أفعل ذلك

167
00:12:10,280 --> 00:12:11,740
أجل، لماذا!؟

168
00:12:11,740 --> 00:12:13,170
لا داع للقلق

169
00:12:13,170 --> 00:12:19,590
.سأدربّه بقسوةٍ حتّى لا تتبقّى له الطّاقة لفعلِ شيءٍ من هذا القبيل

170
00:12:21,220 --> 00:12:23,650
.تبًّا، يبدو ذلك مثيرًا

171
00:12:23,650 --> 00:12:27,560
.إن كنتُ أعرف، لأخذتُ إذنًا من المدرسة وجئتُ هنا في العالم الحقيقي

172
00:12:27,560 --> 00:12:30,100
.لنأتي المرّة القادمة مع كلّ من في فيلقنا

173
00:12:30,100 --> 00:12:31,260
.أجل

174
00:12:34,650 --> 00:12:39,730
.أوّلاً، سوف تصوم حتّى الغد

175
00:12:41,040 --> 00:12:44,630
...لكنّي لم أحضى بوجبةٍ محترمة الأسبوع كلّه

176
00:12:44,630 --> 00:12:49,240
.استغلّ هذه الفرصة لتجهّز جسمك من أجل تمارين الغد

177
00:12:49,240 --> 00:12:50,680
فهمت؟

178
00:12:50,680 --> 00:12:52,050
.حـ حسنًا

179
00:12:54,210 --> 00:12:56,080
...أنو، هارويوكي-كن

180
00:12:56,690 --> 00:12:57,750
نعم؟

181
00:12:59,480 --> 00:13:01,900
ابذل جهدك يا هارويوكي-كن.

182
00:13:01,900 --> 00:13:03,470
حسنًا

183
00:13:14,570 --> 00:13:17,840
...تاكو، لا أظنّني قادر على فعلها

184
00:13:17,840 --> 00:13:19,780
.تكفّل بالأمور في حين غيابي

185
00:13:19,780 --> 00:13:26,460
...ورجاءًا قم بحذف كلّ شيء مخزّن في الّلينكر وخادم البيت بلا النّظر فيهم

186
00:13:26,870 --> 00:13:29,780
.ستكون بخير. تحمَّل هذا الاسبوع

187
00:13:29,780 --> 00:13:32,020
ابذل جهدك يا هارو

188
00:13:39,250 --> 00:13:45,580
ما الّذي ستفعلينه غدًا لجعل هارو يخسر وزنًا؟

189
00:13:45,580 --> 00:13:49,800
.لقد جرّبتِ كلّ الطرق من غير نتيجة

190
00:13:49,800 --> 00:13:53,510
.لذلك فكّرتُ في محاولة إيجاد مصدر المشكلة

191
00:13:53,510 --> 00:13:54,840
المصدر؟

192
00:13:54,840 --> 00:14:00,000
كرو-سان لم يكن سمينًا في الرّوضة والمدرسة الابتدائيّة، صحيح؟

193
00:14:00,000 --> 00:14:01,070
.أجل

194
00:14:01,070 --> 00:14:04,950
.لقد كان وسيمًا وذا شعبيّةٍ خفيّة بين الفتيات

195
00:14:04,950 --> 00:14:07,990
كيف اصبح سمينًا؟

196
00:14:07,990 --> 00:14:12,410
.علينا النّظر في سبب حدوث ذلك

197
00:14:16,120 --> 00:14:19,950
يستحيل أن أنام اليوم.

198
00:14:24,270 --> 00:14:25,630
.آ آسف

199
00:14:45,320 --> 00:14:47,020
.كما متوقّع من المعلّمة

200
00:14:47,020 --> 00:14:48,970
.إنّها دقيقة حقًّا

201
00:14:51,590 --> 00:14:52,990
!إنّها تيكّن

202
00:14:54,540 --> 00:14:56,150
أهذه نسخة قديمة؟

203
00:14:56,150 --> 00:14:59,330
!لم أرى نسخة على جهاز لعب عام من قبل

204
00:14:59,330 --> 00:15:01,290
...أتسائل إن كانت ستعمل

205
00:15:07,760 --> 00:15:08,890
ماذا؟

206
00:15:09,470 --> 00:15:13,470
هذه مرَّتي الأولى... صحيح؟

207
00:15:25,730 --> 00:15:29,020
سبب ازدياد وزنه؟

208
00:15:30,730 --> 00:15:33,020
...ذلك يفكّرني

209
00:15:41,840 --> 00:15:43,250
.الماء بديع

210
00:15:43,250 --> 00:15:44,960
.استمتعي

211
00:15:49,180 --> 00:15:52,080
هل أردتِ قول شيء؟

212
00:15:52,080 --> 00:15:53,540
.أجل

213
00:15:53,540 --> 00:16:00,190
.لقد تذكّرت أنّ وزنَ هارو بدأ في الازدياد عندما تطلّق والديه

214
00:16:03,640 --> 00:16:05,290
.حان وقت التخرّج

215
00:16:05,290 --> 00:16:06,900
.مرّ الوقت بسرعة

216
00:16:06,900 --> 00:16:10,070
.لكنّ الرّابط الّذي بيننا لن يتغيّر

217
00:16:10,510 --> 00:16:12,590
صحيح يا هارويوكي-كن؟

218
00:16:12,590 --> 00:16:15,640
آه، هل كنتِ تتكلّمين معي يا سينباي؟

219
00:16:16,490 --> 00:16:19,600
هل هذا أنت يا هارويوكي-كن؟

220
00:16:19,600 --> 00:16:23,420
.آسف، لكنّي لم أعد بحاجةٍ للألعاب بعد الآن

221
00:16:23,420 --> 00:16:25,880
.يبدو أنّ نهاية علاقتنا قد حانت يا سينباي

222
00:16:25,880 --> 00:16:26,950
!هارويوكي-كن

223
00:16:26,950 --> 00:16:27,760
!أنت رائع جدًّا

224
00:16:27,760 --> 00:16:29,510
!أخرج معي في موعد

225
00:16:29,510 --> 00:16:31,440
...كيف هذا

226
00:16:31,440 --> 00:16:33,720
.مبارك لك التخرّج

227
00:16:34,250 --> 00:16:35,160
.الوداع

228
00:16:35,690 --> 00:16:37,260
!مهلاً يا هارويوكي-كن

229
00:16:37,260 --> 00:16:40,390
...أنا.. أحبّ

230
00:16:50,070 --> 00:16:52,030
سوف ننام أوًّلا

231
00:17:06,250 --> 00:17:07,780
.هذا صحيح

232
00:17:07,780 --> 00:17:11,310
.لقد لعبتُ تلك الّلعبة مع أبي من قبل

233
00:17:11,700 --> 00:17:13,310
لكن أين؟

234
00:17:13,720 --> 00:17:16,260
لكن، لماذا نسيتُ أمرها حتّى الآن؟

235
00:17:16,930 --> 00:17:22,220
.بالتّفكير في ذلك، يبدو أنّ ذكرياتي من تلك المدّة غير واضحة

236
00:17:34,830 --> 00:17:37,050
.مازلتُ غيرُ قادرٍ على التذكّر

237
00:17:37,050 --> 00:17:38,230
لا بأس

238
00:17:38,230 --> 00:17:41,570
.لابدّ إنّه أمرٌ غير مهم، لذلك نسيته

239
00:17:46,160 --> 00:17:47,710
من هذا؟

240
00:17:48,090 --> 00:17:49,000
تاكو؟

241
00:17:56,880 --> 00:17:58,770
سـ سينباي!؟

242
00:18:02,720 --> 00:18:04,190
!أنتِ مخطئة

243
00:18:04,190 --> 00:18:06,680
!مستحيل أن استرق النّظر على الفتيات

244
00:18:06,680 --> 00:18:10,940
!أ أعرف أنّك لستَ من ذلك النّوع

245
00:18:10,940 --> 00:18:12,750
.سـ سأخرج على كلّ حال

246
00:18:12,750 --> 00:18:14,740
.لـ لا داعٍ للقلق، لم أرى شيئًا

247
00:18:14,740 --> 00:18:16,030
!سأذهب الآن

248
00:18:17,650 --> 00:18:19,410
.انتظر يا هارويوكي-كن

249
00:18:20,990 --> 00:18:24,940
.يبدو إنّنا آخر من تبقّى

250
00:18:24,940 --> 00:18:29,710
.إن وعدتني بعدم الرؤية، فلا أمانع ببقائك

251
00:18:29,710 --> 00:18:31,920
!لكنّي أمانع

252
00:18:32,570 --> 00:18:34,420
.أرجوك. لمدّة قليلة وحسب

253
00:18:34,420 --> 00:18:36,890
عليّ اخبارك بشيء

254
00:18:37,530 --> 00:18:38,930
سينباي؟

255
00:18:41,090 --> 00:18:45,280
.أنا واثقة أنّك ستكون وسيمًا إن خسرت وزنًا

256
00:18:45,280 --> 00:18:48,300
.لن أوقفك إن قرّرت فعل ذلك

257
00:18:48,820 --> 00:18:50,890
...كلّا، ذلك غير ممكن

258
00:18:51,230 --> 00:18:53,550
.لكنّي سأكون صادقة

259
00:18:53,960 --> 00:18:55,480
.أخشى من حدوث ذلك

260
00:18:58,060 --> 00:19:02,080
.قوّة شخصيّتك المبارِزة ناتجة عن جرحك الذهني

261
00:19:02,710 --> 00:19:06,870
.الشعور بالنّقص أو الرّغبات الغير متحقّقة أثناء طفولتك اصبح قوّتك

262
00:19:07,860 --> 00:19:10,680
...إن حُلَّ ذلك

263
00:19:10,680 --> 00:19:14,460
..أو إذا رضيتَ بهم

264
00:19:15,020 --> 00:19:19,920
.في المستقبل، قد لا تكون قادرًا على التّسارع مرة أخرى

265
00:19:20,260 --> 00:19:23,790
.أظنّه شيءٌ يسعد المرء لأجله

266
00:19:24,190 --> 00:19:28,770
.لكنّ جزءًا مني لا يريد منك المغادرة

267
00:19:29,910 --> 00:19:33,790
.في الواقع أنا طمّاعة وأنانية

268
00:19:34,560 --> 00:19:35,780
.لابدّ إنّك متقزّز

269
00:19:41,820 --> 00:19:43,780
أعرف إنّ الجروح الذهنية هي القوّة

270
00:19:44,520 --> 00:19:47,280
.أفهم أنّ جروحي هي ما امددتني بالأجنحة

271
00:19:47,790 --> 00:19:51,580
.لكنّي لن أتغيّر حتّى إن خسرتُ وزنًا

272
00:19:51,580 --> 00:19:53,710
.سأستمرُّ لأقاتل من أجلك

273
00:19:57,640 --> 00:19:58,170
...لكن

274
00:19:58,170 --> 00:20:01,320
.رغباتكِ هي رغباتي

275
00:20:01,320 --> 00:20:05,300
.لقد اصبحتُ باست لينكر لتحقيقها

276
00:20:05,300 --> 00:20:11,550
لذلك، إلى أن تكوني راضية، إلى أن تقولين أن الأمر انتهى

277
00:20:11,550 --> 00:20:13,310
.فقتالي سيستمرّ

278
00:20:18,150 --> 00:20:21,710
على هذا الحال، هل لي أن أقول شيئًا أنانيًا؟

279
00:20:23,200 --> 00:20:25,740
مـ مـ ما هو!؟

280
00:20:26,280 --> 00:20:29,120
.سأحبّك مهما كان شكلك

281
00:20:29,720 --> 00:20:33,690
.لذلك لا تجبر نفسك على التّغيير يا هارويوكي-كن

282
00:20:36,380 --> 00:20:38,100
هارويوكي-كن؟

283
00:20:38,830 --> 00:20:40,720
مهلاً يا هارويوكي-كن؟

284
00:20:42,380 --> 00:20:45,390
!تماسك عندك يا هارويوكي-كن

285
00:20:47,200 --> 00:20:50,390
.فقدت الوعي فجأةً

286
00:20:51,410 --> 00:20:58,000
.لقد قضيتُ أسبوعًا طريح الفراش بسبب الاستحمام لمدّة طويلة جدًّا والمحاولة جاهدًا لخسارة الوزن

287
00:20:59,030 --> 00:21:04,890
لكن بفضل ذلك، نجحت في الفحوصات الجسديّة بلا مشاكل

288
00:21:07,640 --> 00:21:11,160
.بصراحة، لا أعرف ما مشكلة جسدك

289
00:21:11,160 --> 00:21:14,220
لقد أكلتَ قليلاً واصبحت سمينًا مجدّدًا

290
00:21:14,220 --> 00:21:15,820
.أشفق عليك

291
00:21:15,820 --> 00:21:17,890
.فكّرت في الكثير من التّمارين الشيّقة

292
00:21:17,890 --> 00:21:19,200
من يهتم؟

293
00:21:19,200 --> 00:21:21,170
!في النّهاية نجحت في الفحص

294
00:21:21,170 --> 00:21:22,400
.أجل

295
00:21:22,400 --> 00:21:25,710
.يصعب تخيّل هارو وهو غير سمين

296
00:21:26,930 --> 00:21:29,020
.هذا ليس لطيفًا منك يا تاكو

297
00:21:29,890 --> 00:21:31,060
.يا رفاق، إنّهم هنا

298
00:21:38,780 --> 00:21:41,070
.هيّا بنا، يا هارويوكي-كن

299
00:21:41,070 --> 00:21:43,280
.أجل يا سينباي

300
00:21:45,310 --> 00:21:48,360
!نيغا نيبولاس. هجوم