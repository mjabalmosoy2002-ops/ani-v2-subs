1
00:00:13,140 --> 00:00:15,490
!أجل! تفضّل

2
00:00:16,720 --> 00:00:18,030
لقد جاء إذاً

3
00:00:27,130 --> 00:00:29,880
!ضغط لم أشعر به من قبل

4
00:00:30,200 --> 00:00:32,540
لا يزال واقفاً؟

5
00:00:32,540 --> 00:00:34,130
لا بأس به

6
00:00:34,130 --> 00:00:36,590
!حتّى بعد أن عزّزنا الضّغط

7
00:00:36,590 --> 00:00:37,950
لديه عزيمة حقّاً

8
00:00:37,950 --> 00:00:39,260
أدهشني ذلك

9
00:00:39,890 --> 00:00:42,190
إنّهم يضغطون عليه من جديد

10
00:00:44,430 --> 00:00:45,660
!سيّد هاريما

11
00:00:46,330 --> 00:00:47,990
تفضّل بالدّخول

12
00:00:51,940 --> 00:00:55,450
اليوم، حتّى رأسي يبدو... ثـ-ثقيلاً

13
00:00:55,880 --> 00:00:57,700
انضمّ طائر-تشان أيضاً

14
00:00:58,170 --> 00:01:00,200
!ا-التفَّ شيء حول عنقي؟

15
00:01:01,720 --> 00:01:02,950
!ما هذا؟

16
00:02:39,510 --> 00:02:42,850
هل التّمائم ذات قوّة الإقصاء تنفعك؟

17
00:02:43,530 --> 00:02:48,170
،أ-أجل. يبدو تأثيرها لمدّة أطول
لذا هي مُفيدة حتماً

18
00:02:48,580 --> 00:02:49,310
...لكن

19
00:02:50,020 --> 00:02:54,400
مُؤخّراً، بدأت الأرواح الشّرّيرة
تظهر بشكل مُتكرّر في البلدة

20
00:02:54,770 --> 00:02:59,700
لا يمكننا مُجاراة ذلك، لذا نحن نُعالج الأمر
بتوزيع التّمائم في كلّ أرجاء البلدة

21
00:02:59,700 --> 00:03:05,330
نحن نستمرّ في نشرها، لكن ما زالت
الأرواح الشّرّيرة في ازدياد

22
00:03:06,030 --> 00:03:08,340
في ازدياد؟ لكن لماذا؟

23
00:03:08,660 --> 00:03:10,660
نحن نبحث حالياً حول السّبب

24
00:03:12,180 --> 00:03:15,420
حسناً، يسرّني أنّ تمائمي تنفع

25
00:03:16,010 --> 00:03:18,090
هذا عربون امتنان. اقبله من فضلك

26
00:03:18,380 --> 00:03:20,050
!كلّ هذا العدد؟

27
00:03:20,050 --> 00:03:22,090
من أخواتي وأبناء عمّي

28
00:03:22,360 --> 00:03:24,550
وأحمل رسالة منهم

29
00:03:24,550 --> 00:03:26,480
"بلّغ تحيّاتهم إلى اليشم الأوّل"

30
00:03:26,480 --> 00:03:27,970
اليشم الأوّل"؟"

31
00:03:27,970 --> 00:03:31,850
قوّة الإقصاء خاصّتك تبعث نوراً من اليشم

32
00:03:34,610 --> 00:03:36,340
لم أكن أعلم بذلك

33
00:03:36,690 --> 00:03:38,660
هذا ليس مرئيّاً لعينَي

34
00:03:43,840 --> 00:03:45,700
!رائحة لطيفة

35
00:03:46,330 --> 00:03:47,390
لنرَ

36
00:03:47,390 --> 00:03:48,680
!أنا مُتحمّس

37
00:03:49,920 --> 00:03:51,910
شكراً لكم على هذه الهدايا

38
00:03:52,210 --> 00:03:52,920
العفو

39
00:03:53,580 --> 00:03:54,830
،بالمناسبة

40
00:03:54,830 --> 00:03:58,260
هل حدثَ وأن اقتحم طاردا أرواح
منزلك قبل أيّام؟

41
00:03:58,260 --> 00:03:59,760
...في الواقع

42
00:03:59,760 --> 00:04:02,340
رُبّما ذلك الثّنائي الكريه؟

43
00:04:02,340 --> 00:04:04,800
كانا فظيعين حقّاً

44
00:04:04,800 --> 00:04:06,640
تصدّينا لهما

45
00:04:06,640 --> 00:04:09,240
ماذا؟ هل حدث ذلك فعلاً؟

46
00:04:09,240 --> 00:04:10,110
أجل

47
00:04:10,500 --> 00:04:13,640
هكذا يبدو، لكن تمّ طردهما

48
00:04:14,050 --> 00:04:17,940
إنّهما عنيدان، لذا قد يفعلان شيئاً ثانية

49
00:04:17,940 --> 00:04:19,840
من فضلك ابقَ يقِظاً

50
00:04:19,840 --> 00:04:21,010
عُلِم

51
00:04:32,600 --> 00:04:34,730
ما الأمر يا ياماغامي؟

52
00:04:35,050 --> 00:04:37,050
...إذاً بخصوص ما كان يقوله

53
00:04:37,410 --> 00:04:41,670
تقصد ما قاله السّيّدُ هاريما حول كيف أنّ هناك
كثيراً من الأرواح الشّرّيرة في البلدة؟

54
00:04:41,930 --> 00:04:46,460
أجل. أشعر بشيء خبيث يُمارَس

55
00:04:46,770 --> 00:04:48,360
شيء خبيث؟

56
00:04:49,060 --> 00:04:52,390
آمل ألّا يؤدّي ذلك إلى مشاكل أكبر

57
00:04:52,640 --> 00:04:55,650
أجل، آمل ألّا يحدث أمرٌ سيّئ

58
00:04:58,650 --> 00:05:01,370
شيء ما على وشك الحدوث

59
00:05:01,370 --> 00:05:02,080
ماذا؟

60
00:05:14,700 --> 00:05:16,110
سأدخل

61
00:05:18,420 --> 00:05:20,670
مـ-مرحباً، سررتُ بلقائك

62
00:05:24,060 --> 00:05:25,090
هذا أنت إذاً

63
00:05:25,350 --> 00:05:28,470
الشّخص الّذي كان يتلقّى قوى من الآلهة

64
00:05:29,130 --> 00:05:30,080
أجل...؟

65
00:05:30,460 --> 00:05:33,930
هل هو "الشّيء الخبيث" الّذي ذكرَه ياماغامي؟

66
00:05:38,700 --> 00:05:41,650
!لا، إنّه غير مهتمّ إطلاقاً

67
00:05:41,960 --> 00:05:44,780
حدّثتني أختي الكبرى عنك

68
00:05:45,110 --> 00:05:46,900
ماذا؟ أختك الكبرى؟

69
00:05:46,900 --> 00:05:49,580
كنتُ آمل أن يُثير إعجابي بشريّ

70
00:05:49,580 --> 00:05:51,990
ترغب أختي الكبرى بمنح قوّتها له

71
00:05:52,390 --> 00:05:54,450
لكنّك رجل

72
00:05:54,450 --> 00:05:56,660
إعطاء قوّتها لي...؟

73
00:06:00,710 --> 00:06:03,140
تقصد أماتيراسو-ساما؟

74
00:06:03,140 --> 00:06:04,080
هذا صحيح

75
00:06:04,490 --> 00:06:05,490
لحظة

76
00:06:05,840 --> 00:06:08,530
أفعى بثمانية رؤوس

77
00:06:08,530 --> 00:06:10,220
هل هذا ياماتا نو أوروتشي؟

78
00:06:11,920 --> 00:06:14,770
!هل هذا يعني بأنّك... سوسانو؟

79
00:06:15,390 --> 00:06:17,220
أصبت

80
00:06:18,820 --> 00:06:23,710
أعتني جيّداً بقوّة ختم الأشياء الّتي
حصلتُ عليها من أماتيراسو

81
00:06:23,710 --> 00:06:25,480
من فضلك بلّغها تحيّاتي

82
00:06:25,480 --> 00:06:28,080
حسناً. آسف لدخولي دون استئذان

83
00:06:28,080 --> 00:06:30,850
سأعطيك هذه كاعتذار

84
00:06:36,080 --> 00:06:38,060
خذه. إنّه لك

85
00:06:38,430 --> 00:06:40,690
شـ-شكراً لك

86
00:06:44,600 --> 00:06:45,960
سُلحفاة

87
00:06:45,960 --> 00:06:48,170
تلقّيتُ هديّةً من السّاكي

88
00:06:53,020 --> 00:06:54,430
!أوروتشي

89
00:06:54,430 --> 00:06:56,890
!هذا السّاكي ليس لك

90
00:06:59,390 --> 00:07:02,000
ماذا تقول؟ من تنعته بالطّفل الشّقيّ؟

91
00:07:02,000 --> 00:07:03,850
!تُناديني بأسماء دوماً

92
00:07:03,850 --> 00:07:05,760
!أتبحث عن شِجار؟

93
00:07:06,480 --> 00:07:09,990
!تعال إليّ، سأُقطّعك إرباً

94
00:07:09,990 --> 00:07:12,490
أتعتقد بأنّ فوزك مضمون؟ راقبني

95
00:07:10,380 --> 00:07:12,490
نقطة غليانه مُنخفضة جدّاً

96
00:07:15,600 --> 00:07:17,700
هل تريد أن تُوسَع ضرباً من جديد؟

97
00:07:19,460 --> 00:07:22,980
!سأقطع كلّ رأس من رؤوسك

98
00:07:25,130 --> 00:07:27,700
!هيّا! خذ هذه

99
00:07:27,700 --> 00:07:28,840
!عُد إلى هنا

100
00:07:29,180 --> 00:07:31,280
!لـ-لدينا مُشكلة يا ياماغامي

101
00:07:31,890 --> 00:07:33,300
!إنّه نائم تماماً؟

102
00:07:34,970 --> 00:07:36,010
!خذ هذه

103
00:07:36,230 --> 00:07:39,960
!من فضلك، لا إراقة دماء هنا

104
00:07:39,960 --> 00:07:41,100
لِمَ لا؟

105
00:07:41,100 --> 00:07:41,730
ماذا؟

106
00:07:42,090 --> 00:07:44,980
عندما تُقطّعهم، فإنّ سيفاً سيظهر من ذيلهم

107
00:07:44,980 --> 00:07:45,940
هذا مُسلٍّ

108
00:07:46,420 --> 00:07:48,650
تقصد كوساناغي نو تسوروغي؟

109
00:07:48,650 --> 00:07:50,250
كيف عرفت ذلك؟

110
00:07:50,250 --> 00:07:51,950
تريد رؤية ذلك على أرض الواقع، صحيح؟

111
00:07:52,360 --> 00:07:54,110
لا، شكراً لك

112
00:07:54,110 --> 00:07:55,420
!هذه كذبة

113
00:07:55,420 --> 00:07:57,990
!أنت رجل، وكلّ الرّجال يحبّون هذه الأشياء

114
00:07:57,990 --> 00:07:59,800
!لذا لا تُقاطعني

115
00:08:06,620 --> 00:08:09,250
أنت تستخدم قوّةَ الرّياح ببراعة

116
00:08:09,640 --> 00:08:11,330
ما زال لديّ الكثير لأتعلّمه

117
00:08:11,330 --> 00:08:12,870
تماماً

118
00:08:13,630 --> 00:08:15,590
لا تزال ضعيفاً

119
00:08:15,590 --> 00:08:16,650
!ضعيف؟

120
00:08:16,650 --> 00:08:19,060
لذا سأُدرّبك

121
00:08:19,060 --> 00:08:21,270
!لا، مُحال أن أحلم بذلك حتّى

122
00:08:21,510 --> 00:08:25,230
،يبدو أنّنا لا نستطيع فعلها هنا
لذا لنذهب إلى مكاني

123
00:08:25,230 --> 00:08:27,810
!أرفض العرض بكلّ احترام

124
00:08:27,810 --> 00:08:29,570
كُفّ عن المُماطلة وتعال

125
00:08:29,810 --> 00:08:32,070
!ماذا؟! ا-انتظر

126
00:08:33,320 --> 00:08:34,950
!مهلاً

127
00:08:38,510 --> 00:08:39,760
!ماذا تفعل؟

128
00:08:39,760 --> 00:08:41,390
تحمّلني لبعض الوقت فقط

129
00:08:41,390 --> 00:08:43,330
إنّه ليس بعيداً

130
00:08:43,330 --> 00:08:44,890
!ليس بعيداً؟

131
00:08:44,890 --> 00:08:47,300
!هل تعيش في الجوار؟

132
00:08:47,300 --> 00:08:49,320
لا. أنا أتّصل به الآن

133
00:08:49,320 --> 00:08:52,150
سينتهي السّير في السّماء
!خلال فترة قصيرة

134
00:08:53,840 --> 00:08:55,300
عالم كامي؟

135
00:08:55,300 --> 00:08:56,760
!ها نحن أولاء

136
00:08:59,380 --> 00:09:02,800
عجباً، عجباً. إنّه لا يعرف التحفُّظ

137
00:09:05,480 --> 00:09:08,020
كُفّ عن ذلك الطّفل الشّقيّ

138
00:09:08,020 --> 00:09:11,150
لم يحظَ برفيق يلعب معه منذ زمن بعيد

139
00:09:11,440 --> 00:09:13,230
هذا ما في الأمر

140
00:09:13,230 --> 00:09:15,000
حسناً إذاً، هل نذهب كذلك؟

141
00:09:15,000 --> 00:09:18,620
لا أستطيع ترك الطّفل الشّقيّ لوحده

142
00:09:31,570 --> 00:09:33,280
مُؤلم

143
00:09:33,280 --> 00:09:34,630
انظر، لقد وصلنا

144
00:09:35,660 --> 00:09:38,260
!هلّا كنتَ أكثر حرصاً في التّعامل معي؟

145
00:09:38,510 --> 00:09:43,740
لو كنتَ امرأة شابّة، لحملتُك برفق

146
00:09:43,740 --> 00:09:46,580
لكن لن أفعل ذلك لرجل

147
00:09:46,580 --> 00:09:48,620
أرفض قطعيّاً

148
00:09:48,620 --> 00:09:50,480
انسَ ذلك. انهض

149
00:09:52,400 --> 00:09:54,860
أهذا هو عالم الكامي الخاصّ بك؟

150
00:09:55,350 --> 00:09:58,510
أجل. لنبدأ بالعمل

151
00:09:58,510 --> 00:09:59,320
ماذا؟

152
00:10:01,570 --> 00:10:03,200
!ياماغامي

153
00:10:08,190 --> 00:10:11,300
يُعيدني هذا للذّكريات

154
00:10:11,300 --> 00:10:13,500
إطلالة لا بأس به

155
00:10:13,500 --> 00:10:14,780
أتعتقد ذلك؟

156
00:10:14,780 --> 00:10:19,380
أعتقد نحن لا نرى كثيراً من الخيول
من هذا النّوع في هذه الأيّام

157
00:10:19,380 --> 00:10:23,260
تستمرّ الأمور في التغيُّر في عالم
البشر، لذا الموضة تأتي وتذهب

158
00:10:23,550 --> 00:10:25,390
بالفعل

159
00:10:29,080 --> 00:10:30,730
...إنّه مُسترخٍ تماماً

160
00:10:30,730 --> 00:10:33,300
!أيّها الوغد! لا تتجاهلني

161
00:10:35,750 --> 00:10:37,460
أظنّني يجب أن أفعل هذا

162
00:10:38,380 --> 00:10:39,280
هل أنت جاهز؟

163
00:10:49,270 --> 00:10:50,460
!عُد إلى هنا

164
00:10:51,710 --> 00:10:53,840
!هيّا، هيّا، هيّا

165
00:10:56,130 --> 00:10:58,190
!أعتقد بأنّك تُبالغ في فعلها

166
00:10:58,190 --> 00:11:00,430
!ستُحطّم كلّ شيء هنا

167
00:11:00,430 --> 00:11:01,630
لا تقلق

168
00:11:01,630 --> 00:11:03,250
!حطّمه بملء قلبك

169
00:11:03,250 --> 00:11:05,480
!لا أحد يعيش هنا

170
00:11:16,200 --> 00:11:18,160
!لا أملك سلاحاً حتّى

171
00:11:18,160 --> 00:11:20,280
!ليس عدلاً أن تُلوّح نحوي بسيفك

172
00:11:20,580 --> 00:11:24,780
رياحك رديئة، لذا لم يكن بيدي حيلة

173
00:11:24,780 --> 00:11:26,850
لِمَ لا تحمل سلاحاً أيضاً؟

174
00:11:26,850 --> 00:11:29,410
لا أملك واحداً، ولا أنوي ذلك أيضاً

175
00:11:29,410 --> 00:11:31,650
أنت مُملّ

176
00:11:33,130 --> 00:11:37,210
هل أنت راضٍ عن قوى الرّياح الضّعيفة تلك؟

177
00:11:37,430 --> 00:11:40,810
حماية نفسي والمُحيطين بي يكفي

178
00:11:40,810 --> 00:11:43,180
لن أختار القتال

179
00:11:43,480 --> 00:11:48,140
ماذا؟ أتعتقد بأنّ نسيمك هذا يستطيع
حماية المُحيطين بك؟

180
00:11:48,140 --> 00:11:49,670
نسيم"؟"

181
00:11:49,670 --> 00:11:55,360
اسمع. أنت أوّل بشريّ أعطى فوجين قوّته له

182
00:11:55,680 --> 00:11:59,570
لذا إن كنت ضعيفاً، فهذا سيجعله يبدو سيّئاً

183
00:11:59,930 --> 00:12:01,530
أنا أوّل شخص؟

184
00:12:01,920 --> 00:12:04,030
ماذا؟ لم تكن تعلم؟

185
00:12:04,030 --> 00:12:06,630
،كنتُ في الأرجاء لمدّة طويلة

186
00:12:06,630 --> 00:12:10,560
لكن لم أرَ أبداً بشريّاً آخر تلقّى
قوّةً من فوجين

187
00:12:10,560 --> 00:12:12,150
لم أكن أدري

188
00:12:13,040 --> 00:12:14,690
،على ذكر الأمر

189
00:12:14,690 --> 00:12:18,580
تبيّن لي للتو بأنّ سوسانو بحدّ ذاته كان أيضاً
جزءاً من كامي عظيم أسطوريّ

190
00:12:19,120 --> 00:12:20,260
ا-المعذرة

191
00:12:20,260 --> 00:12:20,920
ماذا؟

192
00:12:21,930 --> 00:12:24,700
أنا آسف لكوني وقحاً معك

193
00:12:24,700 --> 00:12:25,620
ماذا؟

194
00:12:25,620 --> 00:12:28,010
لماذا تتملّق لي بشكل مُفاجئ؟

195
00:12:28,010 --> 00:12:32,180
هل لأنّني قلتُ بأنّني كنتُ
في الأرجاء منذ مدّة طويلة؟

196
00:12:35,630 --> 00:12:39,610
تعتقد بأنّني عجوز، أليس كذلك؟

197
00:12:39,610 --> 00:12:41,530
!مُحال أن أناديك بالعجوز

198
00:12:41,820 --> 00:12:43,160
!ما زلتُ صغيراً

199
00:12:43,160 --> 00:12:45,060
!لستُ عجوزاً أو خرِفاً

200
00:12:45,060 --> 00:12:46,930
!إيّاك وارتكاب هذا الخطأ

201
00:12:46,930 --> 00:12:47,750
حاضر

202
00:12:48,460 --> 00:12:49,700
هذا صحيح

203
00:12:49,700 --> 00:12:54,150
منذ مدّة طويلة، بكي بُكاء شديداً
بعد فقدان أمّه

204
00:12:54,150 --> 00:12:55,490
صحيح ذلك

205
00:12:55,490 --> 00:12:59,030
لم أصدّق كم كان صوته صاخباً

206
00:13:00,680 --> 00:13:02,740
!كفى ثرثرة

207
00:13:02,740 --> 00:13:03,470
ماذا؟

208
00:13:09,320 --> 00:13:11,150
هذا يكفي

209
00:13:11,150 --> 00:13:12,430
هل أنت متأكّد؟

210
00:13:12,430 --> 00:13:15,100
أصبح وزنك خفيفاً

211
00:13:15,510 --> 00:13:18,710
أجل. الآن كلّ ما أحتاجه هو لعقة
أو لعقتين من السّاكي

212
00:13:18,710 --> 00:13:21,690
لكن ما زلتُ مُولعاً بالحلويّات

213
00:13:21,690 --> 00:13:25,000
لم يتغيّر ذلك إذاً

214
00:13:27,490 --> 00:13:30,200
كأنّهما عجوزان في إيزاكايا

215
00:13:30,740 --> 00:13:33,100
!كُفّ عن الابتسام ابتسامة ماكرة

216
00:13:34,740 --> 00:13:36,250
هيّا بنا

217
00:13:47,730 --> 00:13:49,990
!أخي، هنا أيضاً

218
00:13:49,990 --> 00:13:54,770
أولئك الأونميوجي الأوغاد، يُلصقون
هذا الهُراء في كلّ أرجاء البلدة

219
00:13:54,770 --> 00:13:57,160
،الآن سيكون هناك المزيد من الأرواح الشّرّيرة

220
00:13:57,160 --> 00:14:00,270
!والأعمال لطردها ستنهال علينا

221
00:14:00,540 --> 00:14:04,200
تماماً! سوف ندرّ مالاً طائلاً

222
00:14:11,210 --> 00:14:12,490
ماذا كان ذلك؟

223
00:14:13,790 --> 00:14:15,000
...إنّه

224
00:14:15,220 --> 00:14:16,490
!أونميوجي

225
00:14:18,200 --> 00:14:19,250
!لنخرج من هنا

226
00:14:23,270 --> 00:14:24,880
أحسنت صنعاً

227
00:14:24,880 --> 00:14:26,490
هل أكلت حتّى الإشباع؟

228
00:14:27,160 --> 00:14:28,840
جيّد، جيّد

229
00:14:32,780 --> 00:14:34,160
ذلكما الرّجلان

230
00:14:38,060 --> 00:14:39,140
سيّد كاتسوراغي

231
00:14:39,680 --> 00:14:41,050
هاريما

232
00:14:41,470 --> 00:14:42,840
هل كلّ شيء على ما يُرام؟

233
00:14:43,490 --> 00:14:44,860
ألقِ نظرة إلى هذا

234
00:14:46,430 --> 00:14:48,070
تميمة قد مُزِّقَتْ

235
00:14:48,350 --> 00:14:49,740
ليس هنا فقط

236
00:14:49,740 --> 00:14:51,720
تمّ إزالة العشرات منها

237
00:14:51,720 --> 00:14:55,540
ألهذا السّبب لا يتناقص عدد الأرواح الشّرّيرة؟

238
00:14:55,760 --> 00:14:58,670
لا شكّ، إنّه من صنيع طاردَي الأرواح ذلكما

239
00:14:58,670 --> 00:15:00,620
!يجب علينا القبض عليهما

240
00:15:00,970 --> 00:15:03,520
لكن هذا غريب

241
00:15:03,520 --> 00:15:04,540
ما هو؟

242
00:15:04,960 --> 00:15:09,760
،أتفهّم سبب عدم نقصان الأرواح الشّرّيرة
لكن لماذا يستمرّان في الازدياد؟

243
00:15:09,760 --> 00:15:11,010
معك حقّ

244
00:15:11,010 --> 00:15:13,380
!سيّد كاتسوراغي، سيّد هاريما

245
00:15:14,460 --> 00:15:15,360
ما الأمر؟

246
00:15:15,780 --> 00:15:20,190
الأرواح الشّرّيرة تخرج من قطعة الأرض
الفارغة الّتي هناك

247
00:15:20,190 --> 00:15:21,340
ماذا؟

248
00:15:21,340 --> 00:15:23,940
تخرج؟ ما معنى ذلك؟

249
00:15:23,940 --> 00:15:27,150
لا أعرف السّبب، لكن المنطقة
مليئة بالهواء المُلوّث

250
00:15:27,550 --> 00:15:28,490
هاريما

251
00:15:33,110 --> 00:15:35,080
!هيّا، هيّا، هيّا، هيّا

252
00:15:37,150 --> 00:15:38,340
ماذا يُفترض بي أن أفعل؟

253
00:15:40,370 --> 00:15:42,210
إلى متى ستهرب؟

254
00:15:48,770 --> 00:15:50,960
هل أنت جاهزٌ أخيراً للقيام بهذا؟

255
00:15:50,960 --> 00:15:53,090
!لكن هذا رديء جدّاً! سهل للغاية

256
00:15:53,440 --> 00:15:55,800
تبّاً، يستطيع قراءة هجماتي

257
00:15:55,800 --> 00:15:58,110
!الآن حان دوري للهجوم

258
00:15:59,090 --> 00:16:01,330
يستطيع قراءة هجماتي بعيدة المدى

259
00:16:01,730 --> 00:16:03,410
!يجب أن أدعه يقترب

260
00:16:07,460 --> 00:16:08,110
...لا

261
00:16:09,570 --> 00:16:10,750
ليس بعد

262
00:16:10,750 --> 00:16:12,170
يجب أن أجذبه أكثر

263
00:16:13,490 --> 00:16:14,240
!الآن

264
00:16:23,840 --> 00:16:25,250
!فعلتُها

265
00:16:34,640 --> 00:16:37,120
لم تكن تلك الرّياح سيّئة للغاية

266
00:16:37,120 --> 00:16:39,830
يجذبني ثمّ يردّ الهجوم في اللّحظة الأخيرة؟

267
00:16:39,830 --> 00:16:42,190
أنت أجرأ ممّا توقّعت

268
00:16:42,190 --> 00:16:44,600
حسناً، أعتقد يمكننا الاكتفاء بهذا القدر

269
00:16:45,510 --> 00:16:47,060
هل مدحَني؟

270
00:16:47,330 --> 00:16:50,670
جعلتُك تُواجه وقتاً عصيباً، لكن من المُدهش حقّاً

271
00:16:50,670 --> 00:16:55,030
أن يستطيع مُجرّد زائل استخدام قوّة إله

272
00:16:55,310 --> 00:16:57,000
شـ-شكراً لك

273
00:17:03,840 --> 00:17:07,660
لكن ما زلت دون مُستوى فوجين بكثير

274
00:17:08,040 --> 00:17:10,170
وهل من داعٍ لتقول ذلك؟

275
00:17:21,070 --> 00:17:23,850
جعتُ بعد التّمرين

276
00:17:23,850 --> 00:17:25,300
وأنت؟

277
00:17:25,300 --> 00:17:26,300
أجل

278
00:17:30,880 --> 00:17:33,400
!كُل ما تشاء من فضلك

279
00:17:42,550 --> 00:17:43,720
!لذيذ للغاية

280
00:17:43,720 --> 00:17:46,180
!يروقني مذاق الدّجاج والخضار المغليّ

281
00:17:46,180 --> 00:17:49,110
وجذور اللّوتس المُقرمشة أثرت النّكهة

282
00:17:49,110 --> 00:17:50,170
!يروقني كثيراً

283
00:17:50,170 --> 00:17:51,710
شكراً

284
00:17:51,710 --> 00:17:54,330
إنّها مُجرّد بقايا من عشاء اللّيلة الماضية

285
00:17:54,910 --> 00:17:59,260
لكن الباذنجان المُدمّس ليس الأفضل

286
00:17:59,820 --> 00:18:02,320
ليس وكأنّ مذاقه سيّئ أو ما شابه

287
00:18:02,320 --> 00:18:04,220
أقول فقط بالنّسبة لي فحسب

288
00:18:04,550 --> 00:18:07,190
لا يهمّني ذلك، لذا استخدمتُ المرقة
الّتي تُباع في المتجر

289
00:18:07,190 --> 00:18:09,500
ماذا؟ لماذا تختصر؟

290
00:18:09,500 --> 00:18:12,820
لهذا أقول بأنّك تفتقر للانتباه للتّفاصيل

291
00:18:12,820 --> 00:18:14,460
أي تفاصيل؟

292
00:18:14,460 --> 00:18:16,940
أقصد ذلك الهجوم قبل قليل

293
00:18:16,940 --> 00:18:18,910
لكن أطريتَ عليّ

294
00:18:19,150 --> 00:18:22,070
!ماذا؟ لم أفعل شيئاً كهذا

295
00:18:22,070 --> 00:18:24,620
ارتأيتُ فقط بأنّك أصبحت أفضل قليلاً

296
00:18:29,360 --> 00:18:32,140
شخير أوروتشي عالٍ جدّاً

297
00:18:32,140 --> 00:18:33,960
يجعل مذاق السّاكي الخاص بي سيّئاً

298
00:18:34,400 --> 00:18:37,790
هل ترغب في تنظيف حلقك بخمري؟

299
00:18:37,790 --> 00:18:38,680
!لا، شكراً

300
00:18:38,970 --> 00:18:41,510
إذاً دعنا نحتفل بالبيرة

301
00:18:41,510 --> 00:18:44,480
—لديّ بعض الفواكه الأخّاذة للتّحلية بعد وجبتنا

302
00:18:44,480 --> 00:18:46,180
!قلتُ لا أُريد

303
00:18:46,470 --> 00:18:48,390
!كالعادة، الرّائحة كريهة

304
00:18:48,390 --> 00:18:51,600
أنتما أكولان يقِظان

305
00:18:52,080 --> 00:18:55,310
لكن أتعلم؟ أنت تأكل كثيراً رغم نحالتك

306
00:18:55,310 --> 00:18:56,590
وسريع في الأكل

307
00:18:56,590 --> 00:18:58,320
احرص على مضغ طعامك جيّداً، مفهوم؟

308
00:18:59,860 --> 00:19:01,780
يمكنني قول نفس الكلام عنك

309
00:19:01,780 --> 00:19:06,040
على أيّ حال، أعتقد لن تنمو أكثر
إذا حشوتَ نفسك الآن

310
00:19:06,040 --> 00:19:08,510
أنا ناضج في عمر مُناسب

311
00:19:08,510 --> 00:19:11,020
أنت بمثابة طفل رضيع، إن سألتني

312
00:19:11,450 --> 00:19:14,040
لا، لست بذلك الاختلاف عنّي

313
00:19:14,040 --> 00:19:15,500
فقط من حيث المظهر

314
00:19:15,920 --> 00:19:18,950
!كما قلت، لا تُعاملني وكأنّني عجوز

315
00:19:18,950 --> 00:19:21,060
!ما زلتُ صغيراً جدّاً، اتّفقنا؟

316
00:19:21,060 --> 00:19:22,110
أجل، حسناً

317
00:19:22,680 --> 00:19:26,920
على أيّ حال، يبقى طفل مثلك
أفضل من لا شيء

318
00:19:26,920 --> 00:19:27,640
ماذا؟

319
00:19:27,640 --> 00:19:31,380
إذا تُرِكَ لوحده، الجدّ ياماغامي يُفرط
في استخدام قوّته

320
00:19:31,380 --> 00:19:32,780
ويصبح أصغر طوال الوقت، صحيح؟

321
00:19:32,780 --> 00:19:33,740
أجل

322
00:19:33,740 --> 00:19:37,230
ويبدو أنّ المشاكل تستمرّ في الحدوث
،في هذه المنطقة

323
00:19:37,450 --> 00:19:39,480
مثل الأرواح الشّرّيرة وعوالم الكامي المهجورة

324
00:19:41,450 --> 00:19:46,730
!أقول بأنّك تحتاج لدعم ذلك العجوز بقوّتك

325
00:19:50,210 --> 00:19:53,670
سوسانو، ألهذا السّبب اخترتني؟

326
00:19:53,670 --> 00:19:54,960
ماذا؟

327
00:19:55,410 --> 00:19:58,080
ألهذا السّبب اخترت تدريبي؟

328
00:19:58,080 --> 00:19:59,550
!مُحال

329
00:19:59,880 --> 00:20:01,540
شكراً لك

330
00:20:01,540 --> 00:20:03,660
!أخبرتُك، لا

331
00:20:03,660 --> 00:20:06,510
من فضلك تفضّل وكُل المزيد

332
00:20:06,810 --> 00:20:11,020
تبّاً. المُهمّ، متى تريد القيام بهذا ثانية؟

333
00:20:11,320 --> 00:20:12,970
غداً؟ بعد غد؟

334
00:20:12,970 --> 00:20:14,480
!ألم تنتهِ بعد؟

335
00:20:16,800 --> 00:20:18,690
مهلاً يا سوسانو

336
00:20:20,990 --> 00:20:22,090
!أختي الكبرى

337
00:20:22,090 --> 00:20:23,530
أماتيراسو-ساما

338
00:20:23,870 --> 00:20:25,730
لم أرك منذ وقت

339
00:20:26,170 --> 00:20:27,510
!اسمع، أنت

340
00:20:27,510 --> 00:20:29,910
لماذا تتصرّف بعنف تجاه بشريّ؟

341
00:20:29,910 --> 00:20:32,280
ناهيك عن أنّك تجعله يُطعك

342
00:20:32,280 --> 00:20:35,380
ا-ارتأيتُ فقط بأنّني ينبغي
—أن أحاول تدريبه

343
00:20:35,620 --> 00:20:38,970
يجب أن تتوقّف عن إزعاج الرّجل المسكين

344
00:20:38,970 --> 00:20:41,260
،إذا انتهيتَ ممّا أتيتَ إلى هنا لأجله
فلنعد إلى الدّيار فحسب

345
00:20:42,820 --> 00:20:44,550
!انتظري، انتظري، انتظري

346
00:20:44,550 --> 00:20:47,120
!ما زلتُ آكل

347
00:20:47,120 --> 00:20:48,690
!كُفّ عن التّمايل

348
00:20:48,690 --> 00:20:50,170
!يا رِفاق

349
00:20:50,170 --> 00:20:53,050
ما رأيكم ببعض المُنتجات من الجبل
بعد وجبة طعامكم؟

350
00:20:53,050 --> 00:20:54,390
!محصودة طازجة

351
00:20:55,470 --> 00:20:58,020
هذا لطف منكم أيّها الأطفال

352
00:20:58,020 --> 00:20:58,400
!مهلاً

353
00:20:58,400 --> 00:20:59,970
ستعود إلى الدّيار

354
00:21:00,340 --> 00:21:02,110
!لا أريد

355
00:21:01,810 --> 00:21:03,180
لا أُبالي

356
00:21:02,110 --> 00:21:04,270
!لا أريد العودة إلى المنزل بعد

357
00:21:03,180 --> 00:21:05,440
لا يزال هذا طفلاً

358
00:21:05,090 --> 00:21:07,060
!احذري، قبضتكِ مُحكَمة جدّاً

359
00:21:05,440 --> 00:21:07,820
إنّه كذلك بالفعل

360
00:21:07,060 --> 00:21:08,850
هيّا، تأدّب

361
00:21:09,650 --> 00:21:11,140
!لا تسخروا منّي

362
00:21:12,800 --> 00:21:15,750
هنا مكان ظهور الأرواح الشّرّيرة

363
00:21:16,310 --> 00:21:18,030
...يا له من هواء مُلوّث كثيف

364
00:21:18,350 --> 00:21:19,960
لنُطهرها كلّها في آن واحد

365
00:21:25,950 --> 00:21:28,040
!ما هذا؟

366
00:21:31,540 --> 00:21:33,560
أذلك هو المكان الّذي تنبعث منه
!الأرواح الشّرّيرة؟

367
00:21:34,010 --> 00:21:38,230
فهمت! هذا هو إذاً سبب ازدياد
!ظهور الأرواح الشّرّيرة

368
00:21:39,350 --> 00:21:41,010
!إنّه يتحرّك

369
00:21:50,900 --> 00:21:52,620
...ذلك الشّيء

370
00:23:31,510 --> 00:23:36,810
الحلقة 11، "ضغينة الأرواح الشّرّيرة
"تُدنّس المهرجان