1
00:00:03,880 --> 00:00:06,740
طائر-سان لم يستيقظ بعد

2
00:00:08,380 --> 00:00:12,150
عاد إلى شكله الأصليّ للحصول
،على مُساعدة آنذاك

3
00:00:12,430 --> 00:00:14,670
لذا رُبّما استهلك كثيراً من قوّته

4
00:00:15,160 --> 00:00:19,410
أجل، لكن أنا متأكّد بأنّه سيستيقظ قريباً

5
00:00:19,710 --> 00:00:21,370
هذا جيّد

6
00:00:21,780 --> 00:00:25,870
هوو ليس من النّوع الّذي ينعق بسهولة

7
00:00:28,820 --> 00:00:29,530
صحيح

8
00:00:42,260 --> 00:00:47,400
أريد إتقان قوّة ختم الأشياء الّتي
أعطتني إيّاها الإلَهة

9
00:00:47,990 --> 00:00:54,400
إذا استطعتُ فعل ذلك، فقد ينفع
هذا السّيّدَ هاريما والآخرين

10
00:00:55,240 --> 00:00:59,390
يا لها من فكرة مُثيرة لاحتواء القوّة

11
00:00:59,390 --> 00:01:02,230
الّتي كنتَ تُنتجها

12
00:01:04,040 --> 00:01:08,520
أعتقد بأنّ أماتيراسو كان يستخدم
صندوقاً خشبيّاً كهذا

13
00:01:12,760 --> 00:01:13,590
هل نجح ذلك؟

14
00:01:17,400 --> 00:01:20,270
تفيض القوّة كما الدُّخان

15
00:01:21,180 --> 00:01:22,470
أحقّاً ذلك؟

16
00:01:22,720 --> 00:01:26,440
"أجل. لختمها، يجب أن ترى "الصّاورة

17
00:01:26,690 --> 00:01:29,400
أرى "الصّاورة"؟

18
00:01:29,650 --> 00:01:32,100
لِمَ لا تضحك؟

19
00:01:32,100 --> 00:01:33,640
أ-أنا لا أضحك

20
00:01:36,840 --> 00:01:41,960
،أخبرني توريكا بأنّ لفظي سيّئ
لذا أنا مُدرك لذلك

21
00:01:42,360 --> 00:01:44,430
تعلّم توريكا عدم التحفُّظ حقّاً

22
00:03:25,630 --> 00:03:26,720
تفضّل

23
00:03:27,610 --> 00:03:30,680
كيف حال تدريب قوّة ختم الأشياء؟

24
00:03:30,680 --> 00:03:32,600
ما زال الطّريق أمامي طويلاً

25
00:03:32,970 --> 00:03:35,830
بالمُناسبة، تلقّيتُ مُكالمة قبل قليل

26
00:03:35,830 --> 00:03:39,240
الشّخص الّذي كان مُهتمّاً بمُعاينة
المنزل قد ألغى الموعد من جديد

27
00:03:39,940 --> 00:03:43,610
أحقّاً ذلك؟

28
00:03:43,610 --> 00:03:48,230
هذه هي المرّة الثّالثة الّتي يُلغى
فيها في اللّحظة الأخيرة

29
00:03:48,230 --> 00:03:51,660
البشر مُتقلّبون كثيراً

30
00:03:51,660 --> 00:03:53,580
ما السّبب يا ترى؟

31
00:03:53,580 --> 00:03:55,870
غرفة نوم واحدة ريفيّة واحدة مع منطقة
مطبخ وطعام ومعيشة جميلة

32
00:03:55,870 --> 00:04:00,300
بالإضافة إلى حديقة جميلة وهادئة
مع ياماغامي

33
00:04:00,560 --> 00:04:02,510
مشمول بالعقار

34
00:04:02,510 --> 00:04:06,500
نظّفتُ تنظيفاً شاملاً بل وجهّزتُ
بعض الحلويّات اليابايّةن

35
00:04:07,250 --> 00:04:09,860
بفضل ذلك، أصبحت هذه لي الآن

36
00:04:09,860 --> 00:04:12,730
اشتريتُ خاصّتك بشكل مُنفصل

37
00:04:14,730 --> 00:04:19,550
لون الدُّخلة اليابانيّ، لون زهرة
الكرز الفاتح للمُعجّنات

38
00:04:19,550 --> 00:04:24,600
هذه الألوان الرّقيقة والنّاعمة
تُمثّل الرّبيع حقّاً

39
00:04:37,000 --> 00:04:39,130
!مُذهل! الحديقة

40
00:04:39,870 --> 00:04:43,710
لا يمكن أن يبدأ الرّبيع من دون أزهار كرز

41
00:04:44,770 --> 00:04:46,890
!يا إلهي! أصبحت صغيراً ثانية

42
00:04:47,230 --> 00:04:48,380
!منفوش

43
00:04:48,380 --> 00:04:49,890
هل جسدك بخير؟

44
00:04:50,840 --> 00:04:54,510
قد أستغرق بعض الوقت لأعود
إلى حجمي العاديّ

45
00:04:56,930 --> 00:04:59,270
كيف فعلتَ ذلك للتو؟

46
00:04:59,270 --> 00:05:02,230
استخدمتُ عينَي

47
00:05:02,550 --> 00:05:03,690
عيناك؟

48
00:05:03,950 --> 00:05:08,070
بالفعل. بالنّسبة لي، هذه أسهل طريقة

49
00:05:08,850 --> 00:05:12,330
إنّها أسهل طريقة بالنّسبة لك

50
00:05:12,730 --> 00:05:16,650
يمكنك إيجاد ما يُلائمك

51
00:05:17,670 --> 00:05:20,140
ما... يُلائمني

52
00:05:20,860 --> 00:05:21,670
!هكذا إذاً

53
00:05:22,800 --> 00:05:26,860
بمُفكّرتي الاعتياديّة، قد أتمكّن
!من ختم قوّتي للطّرد

54
00:05:27,320 --> 00:05:33,560
من الطّبيعيّ أن تكون هناك أشياء
تُلائمك وأشياء لا تُلائمك

55
00:05:44,190 --> 00:05:48,170
طيور الدُّخلة هؤلاء مثاليّون جدّاً
لحديقة الرّبيع هذه

56
00:05:48,170 --> 00:05:49,210
!يا للهدوء

57
00:05:57,410 --> 00:05:59,960
!مُعلّم! أنت مطلوب

58
00:06:23,160 --> 00:06:24,780
ينبغي أن أعمل بجدّ أيضاً

59
00:06:31,430 --> 00:06:34,350
!ميناتو! هيّا، بسرعة

60
00:06:34,350 --> 00:06:36,630
تمالك نفسك

61
00:06:38,660 --> 00:06:41,790
لماذا سنُنقّب عن قصبات خيزران الآن؟

62
00:06:41,790 --> 00:06:44,690
هل للأمر علاقة بقوّة ختم الأشياء؟

63
00:06:44,690 --> 00:06:47,920
هناك كثير من قصبات الخيزران
في جبل ياماغامي

64
00:06:48,200 --> 00:06:52,640
عندما تتذوّق بعضاً من تلك الأطايب الرّبيعيّة
الطّازجة، فقد تمدّك بمزيد من القوّة

65
00:06:53,220 --> 00:06:55,020
آمل أن يكون الأمر هكذا

66
00:07:01,580 --> 00:07:05,250
أولئك البشر الّذين كانوا مُهتمّين
،بشراء هذا المنزل

67
00:07:05,250 --> 00:07:09,030
رميتُهم داخل عالم كامي الخاصّ بي
لبعض الوقت قبل إطلاق سراحهم

68
00:07:09,260 --> 00:07:11,780
فهمت، كان ذلك من صنيعك إذاً

69
00:07:11,780 --> 00:07:14,180
كان فعلاً قاسياً بصراحة

70
00:07:14,180 --> 00:07:16,110
!المعذرة

71
00:07:16,110 --> 00:07:19,410
حبستَ ذلك الرّجل الّذي حاول
ركل البوّابة بنفسك

72
00:07:20,590 --> 00:07:22,710
كان يستحقّ ذلك

73
00:07:22,710 --> 00:07:25,540
أيّ بشريّ يجرؤ على ركل بوّابة
منزل الكامي

74
00:07:25,540 --> 00:07:29,460
ينبغي أن يتذلّل امتناناً للعفو عن حياته

75
00:07:29,460 --> 00:07:30,550
بالفعل

76
00:07:30,840 --> 00:07:33,820
!يا للعجب! كم أنت مُخيف

77
00:07:36,570 --> 00:07:38,430
عالم كامي مهجور آخر

78
00:07:40,090 --> 00:07:42,440
إنّه يتحرّك باتّجاه الجبل

79
00:07:42,440 --> 00:07:44,400
يبدو أنّ ميناتو يجذبه

80
00:07:44,670 --> 00:07:46,540
!عجباً لذلك الفتى

81
00:07:46,540 --> 00:07:47,770
!ها أنا ذا

82
00:07:50,260 --> 00:07:56,700
،أخيراً. رأيتُ كثيراً من البشر من قبل
لكن ليس من الطّبيعيّ جذب عوالم كامي

83
00:07:58,680 --> 00:08:00,940
بالرّغم من أنّه بشريّ، إلّا أنّه يعيش
،في عالم كامي ويُحيط بنا

84
00:08:00,940 --> 00:08:03,930
والّذي لا بُدّ أنّه خلّفَ بعضاً
من التّأثيرات الغريبة عليه

85
00:08:04,250 --> 00:08:06,440
لا عجب في أنّه أقرب إلى كامي

86
00:08:07,910 --> 00:08:12,190
أجل. وقد سُحِب نحو عالم
كامي قبل أيّام

87
00:08:12,190 --> 00:08:14,360
ربّما ينبغي أن أمنحه قوّة أكبر

88
00:08:14,360 --> 00:08:16,890
وذلك كي لا يتكرّر ذلك ثانية

89
00:08:16,890 --> 00:08:22,020
لا تفعل. إذا منحته المزيد، فلن يبقى بشريّاً

90
00:08:22,420 --> 00:08:26,520
ما يهمّ هو كيفيّة استخدامه قِواه
من الآن فصاعداً، صحيح؟

91
00:08:32,590 --> 00:08:34,490
ميناتو، اقتربنا على الوصول إلى هناك

92
00:08:34,730 --> 00:08:36,950
!بقي القليل للوصول إلى قصبات الخيزران

93
00:08:37,900 --> 00:08:41,630
!انظروا! هناك الكثير منها، استعدّوا للحفر

94
00:08:42,230 --> 00:08:43,880
!معك حقّ

95
00:08:43,880 --> 00:08:48,630
لكن كان الوقت يُداهمني لدرجة لم أحظَ
بفُرصة للحصول على مِجرفة

96
00:09:06,750 --> 00:09:08,920
!نظرتُ في عينيه مباشرة

97
00:09:11,110 --> 00:09:14,280
ماذا يجدر بي أن أفعل؟! هل
أتظاهر بالموت؟ في هذه اللّحظة؟

98
00:09:15,260 --> 00:09:16,820
لا تقلق

99
00:09:17,430 --> 00:09:19,600
لا شيء يدعو للخوف

100
00:09:19,600 --> 00:09:20,280
!ماذا؟

101
00:09:20,280 --> 00:09:24,480
هذا ما يُطلَق عليه بعملاق رقيق

102
00:09:24,480 --> 00:09:27,250
أهذا أنت يا ياماغامي؟

103
00:09:27,490 --> 00:09:28,630
بالفعل

104
00:09:28,630 --> 00:09:30,900
يمكنك أن تكون في جسد أوتسوغي؟

105
00:09:31,290 --> 00:09:35,130
أخبرتُك، هؤلاء أتباعي

106
00:09:35,130 --> 00:09:37,050
هذا سهلٌ للغاية

107
00:09:41,820 --> 00:09:45,250
"يقول "شكراً لك على الاهتمام برئيسنا

108
00:09:46,060 --> 00:09:47,850
رئيس؟

109
00:09:47,850 --> 00:09:49,310
يقصد كيرين

110
00:09:51,740 --> 00:09:53,780
"أودّ إظهار الامتنان"

111
00:09:54,120 --> 00:09:57,010
...في الواقع

112
00:10:04,910 --> 00:10:07,620
أنا مسرور حقّاً لأنّه في صفّنا

113
00:10:16,870 --> 00:10:19,550
هل يطلب منّي أخذ هذه؟

114
00:10:21,630 --> 00:10:24,890
أجل! يمكنك فهم الحيوانات الآن؟

115
00:10:24,890 --> 00:10:27,470
بعض الشّيء

116
00:10:28,230 --> 00:10:29,390
شكراً لك

117
00:10:31,700 --> 00:10:36,290
،يقول "كلّما كان طازجاً، كان أطيب
"لذا كُله الآن

118
00:10:36,820 --> 00:10:38,900
شـ-شكراً جزيلاً لك

119
00:10:38,900 --> 00:10:41,910
إذاً هل نستمتع بالقصبات الخيزرانيّة
المُنقّب عنها حديثاً؟

120
00:10:42,190 --> 00:10:43,680
هنا؟

121
00:10:43,680 --> 00:10:48,860
أكل الطّعام المحصود حديثاً هو بهجة
لا يمكن الاستعاضة عنها بأيّ شيء آخر

122
00:10:52,540 --> 00:10:54,390
من الصّعب حملها معك

123
00:10:54,730 --> 00:10:56,760
حسناً، أنا متأكّد بأنّني سأعتاد على ذلك

124
00:10:57,060 --> 00:10:59,130
شكراً لك يا دُبّ

125
00:11:01,980 --> 00:11:05,450
،إذا كنّا نأكل قصبات خيزرانيّة نيّئة
فهو سِباق ضدّ الزّمن إذاً

126
00:11:05,450 --> 00:11:07,620
لذا ماسورة واسابي ستَفي بالغرض

127
00:11:08,020 --> 00:11:10,010
تفضّل يا ياماغامي

128
00:11:10,360 --> 00:11:12,020
أشكرك

129
00:11:12,550 --> 00:11:13,520
ياماغامي

130
00:11:14,630 --> 00:11:18,150
ما علاقة التّنقيب عن قصبات خيزران بقوّتي؟

131
00:11:18,150 --> 00:11:20,460
من قال بأنّ له علاقة بذلك؟

132
00:11:20,770 --> 00:11:23,700
لا تقل لي بأنّك أردتَ أكل
!قصبات خيزران فحسب

133
00:11:25,210 --> 00:11:27,400
يبدو أنّك تضغط على نفسك كثيراً

134
00:11:27,400 --> 00:11:30,040
ارتأيتُ بأنّ هذا سيُغيّر النّمط
المعيشيّ بعض الشّيء

135
00:11:30,940 --> 00:11:34,670
أشعر باسترخاء أكبر بعد تواجدي
في مكان ذي هواء نظيف ونقيّ

136
00:11:35,270 --> 00:11:38,950
بالإضافة إلى ذلك، أعتقد بأنّني كنتُ قادراً
على التّواصل مع الحيوانات

137
00:11:39,350 --> 00:11:42,230
ينبغي أن تُجرّب قصبات الخيزران كذلك

138
00:11:43,140 --> 00:11:45,140
أجل، لنُجرّب بعضاً

139
00:11:46,810 --> 00:11:47,890
هذا استثنائيّ

140
00:11:48,160 --> 00:11:49,450
شكراً على الطّعام

141
00:11:53,460 --> 00:11:54,400
ما رأيك؟

142
00:11:54,400 --> 00:11:56,010
!هذا مُذهل

143
00:12:01,740 --> 00:12:03,160
ها أنا ذا

144
00:12:03,160 --> 00:12:04,390
ما الّذي ذكّرك بهذا؟

145
00:12:04,390 --> 00:12:07,080
من اللّطيف اللّعب بين الحين والآخر

146
00:12:07,080 --> 00:12:11,410
أعتقد ستتمكّن من لعب الجزء الأخير
من الشّوغي، لذا لنُجرّب ذلك

147
00:12:12,790 --> 00:12:14,670
سأريك

148
00:12:16,270 --> 00:12:17,060
جيّد

149
00:12:17,060 --> 00:12:20,180
كلّ ما عليك هو سحب قطعة هكذا

150
00:12:20,180 --> 00:12:23,190
لكن لا يجوز أن تصدر صوتاً

151
00:12:23,190 --> 00:12:25,090
إن فعلت، فسوف نتناوب

152
00:12:25,090 --> 00:12:26,220
هكذا إذاً

153
00:12:26,220 --> 00:12:29,070
الشّخص الّذي لديه أحجار أكثر
هو الرّابح في النّهاية

154
00:12:29,070 --> 00:12:30,360
هذا سهل بما يكفي

155
00:12:31,490 --> 00:12:33,690
لكنّها صعبة إلى حدّ مُفاجئ

156
00:12:37,330 --> 00:12:39,210
أيُعقَل هذا؟

157
00:12:39,210 --> 00:12:41,080
!يجب أن أُصرّ على جولة أُخرى

158
00:12:42,350 --> 00:12:44,620
!يا قطعة الخشب

159
00:12:44,620 --> 00:12:48,140
كيف تجرئين، مُجرّد قطعة، أن تعصيني؟

160
00:12:49,730 --> 00:12:52,750
!أنت! من أعطاكِ الإذن بإصدار صوت؟

161
00:12:52,750 --> 00:12:55,370
ياماغامي، لا تكسرها، اتّفقنا؟

162
00:12:55,370 --> 00:12:56,460
أعلم

163
00:13:00,940 --> 00:13:03,560
ياماغامي، لا ينبغي أن تغشّ

164
00:13:03,560 --> 00:13:04,930
استخدمتَ قوّتك، أليس كذلك؟

165
00:13:05,250 --> 00:13:06,310
ما الّذي تقوله؟

166
00:13:06,310 --> 00:13:08,060
هذا جزءٌ من تدريبك

167
00:13:08,060 --> 00:13:09,550
إنّه دوري الآن

168
00:13:09,930 --> 00:13:12,270
...إذا كنت تريد أن تلعبها هكذا

169
00:13:15,230 --> 00:13:17,730
ما هذا يا ياماغامي؟

170
00:13:17,730 --> 00:13:21,690
بعض الأشياء قد تتوه وتجد ضالّتها
هنا، لذا لا بُدّ أنّها إحداها

171
00:13:22,160 --> 00:13:24,130
هذه أوّل مرّة أسمع فيها بذلك

172
00:13:24,130 --> 00:13:25,820
لا ينبغي أن تكون مُشكلة

173
00:13:25,820 --> 00:13:27,460
هل أنت متأكّد؟

174
00:13:33,790 --> 00:13:36,250
ها نحن أولاء

175
00:13:36,250 --> 00:13:38,480
!آسف للمُقاطعة

176
00:13:38,480 --> 00:13:41,400
أعِد بأنّني لستُ شخصاً مُريباً

177
00:13:41,400 --> 00:13:43,050
أ-أجل

178
00:13:43,460 --> 00:13:48,390
غالباً لستُ بحاجة للشّرح، لكن
أُدعى إيبيسو

179
00:13:50,630 --> 00:13:53,930
لا بُدّ أنّك أنت من تلقّى القِوى

180
00:13:54,520 --> 00:13:58,650
ا-المعذرة... ماذا؟

181
00:13:59,700 --> 00:14:01,110
آسف

182
00:14:01,110 --> 00:14:04,980
يمكنك أن تُناديني إيبي

183
00:14:04,980 --> 00:14:07,440
سررتُ بلقائك يا إيبي

184
00:14:07,440 --> 00:14:09,780
المعذرة، من أين تعرفني؟

185
00:14:09,780 --> 00:14:15,310
سمعتُ إشاعة حول هذا الإنسان الغريب
الّذي كان يتلقّى قوى كامي

186
00:14:15,310 --> 00:14:17,250
لذا أردتُ اللّقاء به

187
00:14:17,250 --> 00:14:18,500
هذا شرفٌ لي

188
00:14:18,790 --> 00:14:23,410
على أيّ حال، هذه حديقة جميلة

189
00:14:23,410 --> 00:14:24,930
شكراً جزيلاً لك

190
00:14:27,230 --> 00:14:28,180
ماذا؟

191
00:14:35,130 --> 00:14:36,850
ما هذا الشّعور؟

192
00:14:36,850 --> 00:14:40,140
لا أريد الخسارة أمام هذا الشّيء
مهما كلّف الأمر

193
00:14:40,140 --> 00:14:43,190
!ما هذا الشّغف المُتّقد؟

194
00:14:43,800 --> 00:14:45,530
من يدري؟

195
00:14:46,230 --> 00:14:48,390
لـ-لحظة، هل يُعقَل أن يكون هذا...؟

196
00:14:49,800 --> 00:14:51,360
الحُبّ، أليس كذلك؟

197
00:14:51,750 --> 00:14:55,600
هل هذا يعني أنّ الرّبيع قادم إليّ أخيراً؟

198
00:14:55,600 --> 00:14:58,650
لا... أعتقد بأنّ هذا ما يعنيه ذلك

199
00:15:03,150 --> 00:15:05,380
يوجد نبع ساخن هنا أيضاً؟

200
00:15:05,380 --> 00:15:06,950
لطيف جدّاً

201
00:15:06,950 --> 00:15:09,420
إن أحببت، يمكنك استخدامه

202
00:15:09,420 --> 00:15:11,920
سأقبل بعرضك هذا

203
00:15:11,920 --> 00:15:14,970
إله الجبل، هل يمكنني ذلك؟

204
00:15:15,300 --> 00:15:16,860
افعل ما تشاء

205
00:15:16,860 --> 00:15:18,430
شكراً جزيلاً

206
00:15:18,760 --> 00:15:21,520
كتعبير عن شكري، سأعطيك هذه

207
00:15:21,520 --> 00:15:22,770
ما-ماذا؟

208
00:15:23,310 --> 00:15:24,870
إنّها تاياكي

209
00:15:24,870 --> 00:15:26,980
شاركها مع الجميع لاحقاً

210
00:15:27,850 --> 00:15:28,900
معجون ناعم؟

211
00:15:28,900 --> 00:15:30,930
أحضرتُ لك أنواع مُختلفة

212
00:15:30,930 --> 00:15:33,170
وبالطّبع هناك معجون ناعم أيضاً

213
00:15:33,170 --> 00:15:35,420
شكراً جزيلاً لك

214
00:15:35,420 --> 00:15:38,160
حسناً، إذاً دعني أغمر نفسي
في النّبع ا لسّاخن

215
00:15:38,160 --> 00:15:40,710
أجل، خُذ راحتك من فضلك

216
00:15:47,190 --> 00:15:48,760
هكذا إذاً

217
00:15:50,030 --> 00:15:52,760
الابتعاد عن المسار قليلاً

218
00:15:52,760 --> 00:15:56,740
ماذا؟ ابتعاد؟ عن ماذا؟

219
00:16:13,890 --> 00:16:18,870
أشعر وكأنّني بدأتُ أتأقلم مع قوّة
ختم الأشياء قليلاً

220
00:16:24,290 --> 00:16:26,940
زفاف الثّعلب، أو الأمطار الشّمسيّة قد توقّفت

221
00:16:26,940 --> 00:16:28,500
!مُحال

222
00:16:28,980 --> 00:16:32,380
نحن لا نهِبُ عروستنا بسبب الطّقس

223
00:16:32,730 --> 00:16:34,380
زائر آخر؟

224
00:16:34,630 --> 00:16:41,600
لم أكن أعلم... بأنّ نبعاً ساخناً رائعاً
!كهذا كان قريباً

225
00:16:42,230 --> 00:16:44,750
أهذا هو بناؤك؟

226
00:16:44,750 --> 00:16:47,270
لا، أنا الوصيّ الحاليّ لهذا المكان

227
00:16:47,270 --> 00:16:49,860
هكذا إذاً

228
00:16:51,620 --> 00:16:53,030
تريد أن تغمر نفسك بالنّبع السّاخن؟

229
00:16:53,370 --> 00:16:55,510
لـ-لا شيء من هذا القبيل

230
00:16:55,860 --> 00:16:59,490
أنا أعمل على أداء مهمّة هامّة

231
00:16:59,740 --> 00:17:01,030
هل هي عاجلة؟

232
00:17:01,030 --> 00:17:06,120
لا... أقول بأنّها عاجلة... إلى هذه الدّرجة

233
00:17:07,160 --> 00:17:09,380
لِمَ لا تكون صادقاً؟

234
00:17:09,690 --> 00:17:12,660
غداء اليوم هو إيناريزوشي

235
00:17:14,610 --> 00:17:16,070
هل ترغب في الانضمام لنا؟

236
00:17:16,070 --> 00:17:19,850
هل أنت متأكّد بأنّني أستطيع
!مُشاركة غداءك؟

237
00:17:19,850 --> 00:17:21,640
بالطّبع. تعال وكُل معنا

238
00:17:21,900 --> 00:17:23,690
!شكراً جزيلاً لك

239
00:17:24,750 --> 00:17:26,770
أنا خادم إله الجبل

240
00:17:26,770 --> 00:17:29,560
الّذي يقطن في الجبل المُجاور لهذا الجبل

241
00:17:29,800 --> 00:17:33,030
يوجد كامي في الجبل المُجاور؟

242
00:17:33,030 --> 00:17:37,080
أجل. اسمي تسوموغي

243
00:17:37,080 --> 00:17:39,280
سررتُ بالتعرّف عليك

244
00:17:39,280 --> 00:17:41,610
السّرور لي أنا بالتعرّف عليك

245
00:17:41,610 --> 00:17:45,060
...آمل ألّا أكون وقحاً بسؤالي

246
00:17:45,060 --> 00:17:47,440
هل الإيناريزوشي خاصّتك منزليّة الصّنع؟

247
00:17:47,440 --> 00:17:50,990
أقصد بأنّ الّتي تُباع في المتجر رائعة كذلك

248
00:17:50,990 --> 00:17:54,620
لكن أتعلم؟ لا شيء يتفوّق
على الإيناريزوشي المنزليّة

249
00:17:54,620 --> 00:17:57,780
،أعتقد يمكنني القول بأنّها منزليّة
مع خضراوات برّيّة

250
00:17:57,780 --> 00:17:59,400
!حقّاً؟

251
00:17:59,400 --> 00:18:01,850
لكن لا أضمن لك بأنّها ستُعجبك

252
00:18:01,850 --> 00:18:04,110
...مصنوعة بعناية بواسطة أيادٍ بشريّة

253
00:18:06,940 --> 00:18:07,690
هكذا إذاً

254
00:18:07,690 --> 00:18:10,150
والأفضل أن يكون شكلاً مُثلّثيّاً

255
00:18:12,460 --> 00:18:15,920
إله الجبل، من الرّائع رؤيتك

256
00:18:15,920 --> 00:18:19,400
أجل. كُل أوّلاً واغمر نفسك في
النّبع السّاخن لاحقاً

257
00:18:19,400 --> 00:18:20,610
افعل ما تشاء

258
00:18:20,610 --> 00:18:22,580
أشكرك جزيل الشّكر

259
00:18:23,060 --> 00:18:26,080
!ياماغامي... تبدو كإله

260
00:18:26,370 --> 00:18:27,640
!يا للوقاحة

261
00:18:27,640 --> 00:18:30,100
أنا إله جبل عظيم

262
00:18:30,100 --> 00:18:33,590
يجب أن تعلم بأنّه كامي ذو رتبة
رفيعة جدّاً

263
00:18:34,770 --> 00:18:36,300
!شكراً على الطّعام

264
00:18:41,560 --> 00:18:43,050
...هذه الإيناريزوشي

265
00:18:43,050 --> 00:18:46,380
اغرس أسنانك فيها لتنتشر العُصارة
من التّوفو المقليّة

266
00:18:46,380 --> 00:18:49,430
ليس بكمّية كبيرة، ولا قليلة، بل بكمّية مُناسبة

267
00:18:49,430 --> 00:18:51,990
!لذيذة للغاية

268
00:18:53,290 --> 00:18:54,990
!كان ذلك شهيّاً

269
00:18:54,990 --> 00:18:56,480
يسرّني أنّك استمتعت بها

270
00:18:56,480 --> 00:18:59,360
أن أكون مَديناً بمعروف لَهو أمر
يُنافي سياستي

271
00:18:59,620 --> 00:19:02,890
بالتّالي، يجب أن أصرّ على أن تقبل امتناني

272
00:19:02,890 --> 00:19:04,240
حـ-حسناً

273
00:19:04,620 --> 00:19:06,450
هذا دُرّاق حصدتُه في الدّيار

274
00:19:06,450 --> 00:19:07,800
إنّه لك

275
00:19:07,800 --> 00:19:09,460
حصدتُه في جبلك؟

276
00:19:09,730 --> 00:19:10,850
،من ناحية فنّيّة

277
00:19:10,850 --> 00:19:15,270
،حُصِد في الحديقة الّتي نفتخر بها
والّتي بمثل جودة هذه الحديقة

278
00:19:15,270 --> 00:19:19,170
هذه للكامي فقط، لذا ربّما لا يجدر بك أكلها

279
00:19:19,510 --> 00:19:21,380
أ-أحقّاً ذلك؟

280
00:19:21,380 --> 00:19:23,670
لن تفسد أبداً

281
00:19:23,670 --> 00:19:26,850
رائحتها عطِرة، لذا يمكنك وضعها كزينة

282
00:19:27,170 --> 00:19:30,560
المعذرة، هل أنت متأكّد من أنّني
أستطيع الحصول عليها؟

283
00:19:30,560 --> 00:19:34,440
أجل. سيّدي الكامي ائتمنني عليها بالفعل

284
00:19:34,440 --> 00:19:36,070
سيّدك الكامي؟

285
00:19:36,310 --> 00:19:39,540
قال بأنّ هذا سيُثبت بأنّ حديقتنا أفضل

286
00:19:40,940 --> 00:19:42,470
شكراً لك على هذا

287
00:19:42,470 --> 00:19:44,920
ياماغامي، ماذا يجدر بي أن أفعل؟

288
00:19:44,920 --> 00:19:46,530
سآكلها لاحقاً

289
00:19:46,840 --> 00:19:50,160
هل تعرف الكامي الّذي يكون
سيّداً لتسوموغي؟

290
00:19:50,500 --> 00:19:51,800
من يدري؟

291
00:19:59,260 --> 00:20:01,820
لِمَ لا تذهب وتستحمّ في النّبع السّاخن؟

292
00:20:01,820 --> 00:20:03,930
!أجل، شكراً جزيلاً لك

293
00:20:04,400 --> 00:20:07,640
المعذرة، هل تستحمّ هناك أيضاً؟

294
00:20:07,640 --> 00:20:09,460
أفعل ذلك كلّ يوم

295
00:20:09,460 --> 00:20:11,100
لا عجب إذاً

296
00:20:11,100 --> 00:20:13,520
لهذا السّبب لا تبدو كبشريّ

297
00:20:13,750 --> 00:20:14,410
ماذا؟

298
00:20:22,980 --> 00:20:24,970
!أراك ثانية

299
00:20:27,980 --> 00:20:32,310
ياماغامي، أعتقد بأنّني لستُ كالبشر

300
00:20:32,870 --> 00:20:35,790
...كنتُ مُدركاً لذلك بعض الشّيء، لكن

301
00:20:36,210 --> 00:20:38,880
الانحراف عن المسار قليلاً

302
00:20:39,100 --> 00:20:43,090
قصدَ بأنّني كنتُ أنحرف عن كوني
بشريّاً، أليس كذلك؟

303
00:20:43,770 --> 00:20:44,580
أجل

304
00:20:45,190 --> 00:20:50,570
أنا لستُ سوى مُجرّد زائل، لذا
كيف استطعتُ ألّا أتأثّر؟

305
00:20:53,370 --> 00:20:57,510
،أريد أن أتمكّن من إتقان قوّة ختم الأشياء

306
00:20:57,860 --> 00:21:01,560
لكنّني خائف من التغيُّر

307
00:21:02,040 --> 00:21:03,460
لا تخف

308
00:21:03,460 --> 00:21:06,810
حتّى بقِواك، ستبقى أنت

309
00:21:07,350 --> 00:21:08,890
أنا هو أنا

310
00:21:09,380 --> 00:21:11,710
هل سأتمكّن من الموت كبشريّ؟

311
00:21:12,300 --> 00:21:13,400
أعِدُك

312
00:21:14,620 --> 00:21:18,750
لذا ابذل جهدك في تدريبك وتعلّم
كيفيّة استخدام قِواك

313
00:21:19,790 --> 00:21:20,710
حسناً

314
00:21:21,030 --> 00:21:25,540
قد تكون اللّمحة وراء قوّة ختم
الأشياء موجودة في ماضيك

315
00:21:25,880 --> 00:21:27,290
ماضيّي؟

316
00:21:28,130 --> 00:21:30,910
كنتَ قادراً على رؤية أشياء
منذ صغرك، أليس كذلك؟

317
00:21:31,390 --> 00:21:33,020
أشياء ليست ببشريّة

318
00:21:45,490 --> 00:21:48,030
...أوّل مرّة رأيتُ فيها ذلك

319
00:21:50,270 --> 00:21:51,430
هل هذا...؟

320
00:21:54,810 --> 00:21:56,760
كنتُ في الخامسة حينها

321
00:23:32,180 --> 00:23:36,280
الحلقة 7، "مفتاح الكشف عن القوّة
"موجود في الذّكريات