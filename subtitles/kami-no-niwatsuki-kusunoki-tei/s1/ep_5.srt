1
00:00:05,750 --> 00:00:06,670
لذيذ

2
00:00:07,150 --> 00:00:09,690
ياماغامي، ما رأيك بمذاق هذا؟

3
00:00:11,400 --> 00:00:13,820
!يا له من لحم ريّان ومُمتلئ

4
00:00:13,820 --> 00:00:16,350
يا لها من نكهة مليئة بالخطايا

5
00:00:16,350 --> 00:00:19,790
هذا "التّمازج" بين معجون الفاصولياء
النّاعمة والفراولة لذيذ للغاية

6
00:00:20,020 --> 00:00:23,290
جعلك هذا تستخدم كلمة أجنبيّة لوصفه؟

7
00:00:23,620 --> 00:00:25,860
أحسنت يا هيزين-أن

8
00:00:34,230 --> 00:00:35,720
ما الّذي يجري؟

9
00:00:35,720 --> 00:00:38,300
درس هوو في الهواء الطّلق

10
00:00:38,570 --> 00:00:41,030
تعليم الطّيور اليابانيّة المُغرِّدة الزّقزقة؟

11
00:00:41,030 --> 00:00:42,020
بالفعل

12
00:00:43,540 --> 00:00:48,150
"ما يجدر بك فعله هو جعل أوّل "هو
لديك أكثر استرخاء

13
00:00:48,610 --> 00:00:50,200
!من جديد

14
00:00:52,850 --> 00:00:55,510
!أجل، هذا صحيح. التّالي

15
00:00:57,720 --> 00:01:00,650
صوت جميل. تستحقّ الإطراء

16
00:01:00,650 --> 00:01:01,980
!حسناً، الأخير

17
00:01:08,860 --> 00:01:10,000
بئساً

18
00:01:10,000 --> 00:01:12,710
!كلّ هذا خاطئ

19
00:01:13,010 --> 00:01:14,110
افعلها هكذا

20
00:01:18,420 --> 00:01:22,320
طائر-سان مشهور جدّاً. إنّه مُحاط
دوماً بواسطة الجميع

21
00:01:22,320 --> 00:01:24,810
!تماماً. يا للحيويّة

22
00:01:37,130 --> 00:01:39,100
جاء الرّبيع

23
00:03:28,740 --> 00:03:30,230
سيّد كاتسوراغي، ما وضعك؟

24
00:03:30,840 --> 00:03:32,140
ما زال يوجد الكثير هنا

25
00:03:32,140 --> 00:03:34,990
لهذا نُطلِق على هذا بمهرجان أرواح
الرّبيع الشّرّيرة

26
00:03:34,990 --> 00:03:36,310
أعدادهم كثيرة جدّاً

27
00:03:36,310 --> 00:03:39,110
هذا يستنزف قوانا الرّوحانيّة حقّاً

28
00:03:39,450 --> 00:03:40,690
هؤلاء ضُعفاء

29
00:03:40,690 --> 00:03:41,990
!دعهم لي

30
00:03:41,990 --> 00:03:44,580
!رقم واحد، كُل حتّى الإشباع

31
00:03:48,120 --> 00:03:49,320
سيّد كاتسوراغي

32
00:03:49,320 --> 00:03:52,830
!أعلم. أعتمد على دعمك يا رقم اِثنان

33
00:03:59,540 --> 00:04:01,170
اكتفيت؟

34
00:04:04,260 --> 00:04:06,090
ماذا؟ غير كافٍ؟

35
00:04:06,090 --> 00:04:08,390
لا تقلق. ستكون هناك مرّة مُقبلة

36
00:04:09,770 --> 00:04:11,160
روح شرّيرة أُخرى

37
00:04:10,210 --> 00:04:12,020
!اهدؤوا

38
00:04:12,020 --> 00:04:13,650
!رأسي ليس للأكل

39
00:04:13,650 --> 00:04:14,540
!مهلاً، هاريما

40
00:04:14,540 --> 00:04:17,360
!هيّا، أفلتني! مُؤلم

41
00:04:23,270 --> 00:04:28,120
حسناً، اشتريتُ هدايا تذكاريّة
للجميع، لذا لنعُد إلى المنزل

42
00:04:29,630 --> 00:04:31,000
أليس هذا...؟

43
00:04:31,000 --> 00:04:32,790
!مُدرِّب الطّيور

44
00:04:32,790 --> 00:04:34,580
!سمعتُ عنه الكثير

45
00:04:34,580 --> 00:04:36,430
مُدرّب الطّيور؟

46
00:04:39,750 --> 00:04:41,930
!مُذهل! يأتي المزيد من الطّيور

47
00:04:41,930 --> 00:04:43,970
!يا للهول! التقطوا صورة بسرعة

48
00:04:48,210 --> 00:04:52,070
هذا يحدث دوماً عندما نخرج معاً

49
00:04:55,490 --> 00:04:57,270
حسناً، تمّ الأمر

50
00:04:57,270 --> 00:04:59,120
سياجي النّباتيّ الصّلصاليّ
!الظّريف على شكل دُمى

51
00:04:59,120 --> 00:05:01,280
!هذا هو الصّنف رقم 25

52
00:05:01,660 --> 00:05:06,070
يبدو جميلاً. كدتُ أسمّيه السّيّد 25

53
00:05:06,070 --> 00:05:08,300
!ماذا؟ سيّد كوسونوكي

54
00:05:08,300 --> 00:05:09,670
تسرّني رؤيتك

55
00:05:09,990 --> 00:05:14,300
إنّه سِياج نباتيّ... فاخر جدّاً

56
00:05:14,300 --> 00:05:19,320
أجل. أخبرني مالك هذا المنزل بأنّني
أستطيع فعل ما أريد به

57
00:05:20,250 --> 00:05:25,540
أقصد بأنّني كنتُ أحقّق نجاحات مُتتالية
منذ عملتُ في حديقتك، انظر

58
00:05:27,470 --> 00:05:29,970
!مهلاً! لِمَ هذا العدد الكبير من الطّيور؟

59
00:05:29,970 --> 00:05:32,970
أ-أجل، ما السّبب يا ترى؟

60
00:05:33,300 --> 00:05:35,180
!أستأذن بالانصراف

61
00:05:35,450 --> 00:05:37,530
ماذا؟ سيّد كوسونوكي؟

62
00:05:42,350 --> 00:05:43,790
!ياماغامي

63
00:05:43,790 --> 00:05:45,070
!لدينا مُشكلة

64
00:05:45,370 --> 00:05:48,280
هناك مجموعة من عوالم كامي
!المهجورة في الجبل

65
00:05:48,280 --> 00:05:51,660
!وميناتو لم يعُد من التسوُّق

66
00:05:51,660 --> 00:05:52,950
ماذا نفعل؟

67
00:05:52,950 --> 00:05:54,210
لا تخافوا

68
00:05:56,620 --> 00:06:00,300
هناك الكثير. لا بُدّ أنّ العدد كبير
جدّاً لدرجة تفوق طاقتكم

69
00:06:00,300 --> 00:06:01,730
دعوني أتولّى الأمر

70
00:06:01,730 --> 00:06:03,660
ياماغامي بنفسه سوف...

71
00:06:03,660 --> 00:06:04,840
أجل

72
00:06:09,640 --> 00:06:10,740
تقفّوا أثره

73
00:06:10,740 --> 00:06:11,890
!حسناً

74
00:06:15,240 --> 00:06:18,050
ماذا؟ اختفت الطّيور

75
00:06:18,050 --> 00:06:19,210
هل حدث شيء؟

76
00:06:20,660 --> 00:06:22,380
!هنا

77
00:06:23,370 --> 00:06:25,590
فوجين، رايجين

78
00:06:25,590 --> 00:06:27,690
حريّ بك أن تعود إلى المنزل في أسرع وقت

79
00:06:28,020 --> 00:06:29,450
ما السّبب؟

80
00:06:29,450 --> 00:06:34,330
اليوم، هناك انتشار لعوالم كامي
المهجورة والأرواح الشّرّيرة

81
00:06:34,330 --> 00:06:35,910
عوالم كامي مهجورة؟

82
00:06:35,910 --> 00:06:38,660
،هناك الملايين من الكامي في هذا العالم

83
00:06:38,660 --> 00:06:40,570
"وعدد أكبر حتّى من "عوالم كامي
أو أراضي مُقدَّسة

84
00:06:40,570 --> 00:06:44,790
بعض عوالم الكامي ينتهي المطاف
بتركها بواسطة صانعها

85
00:06:44,790 --> 00:06:46,200
أحقّاً ذلك؟

86
00:06:48,790 --> 00:06:50,150
...على ذكر الأمر

87
00:06:55,150 --> 00:06:56,340
هل كان ذلك...؟

88
00:06:56,340 --> 00:06:58,380
عالم كامي مهجور

89
00:06:58,380 --> 00:07:00,350
يمكن أن تكون البوّابة المُؤدّية
إليه في أيّ مكان

90
00:07:00,350 --> 00:07:03,060
في البرّ، في الجوّ، أو حتّى في الماء

91
00:07:03,060 --> 00:07:06,580
،وهي تتحرّك من مكان لآخر
ما يُشكّل مُعضلة

92
00:07:06,580 --> 00:07:10,310
يمكن جذب البشر إلى داخلها
بين الحين والآخر

93
00:07:10,310 --> 00:07:12,420
يُدعى هذا بالاختطاف الرُّوحيّ

94
00:07:12,420 --> 00:07:15,580
إذاً لهذا السّبب لم تلحق بنا الطّيور

95
00:07:15,580 --> 00:07:17,080
،تبدو مرتاحاً بشكل فظيع حيال الأمر

96
00:07:17,370 --> 00:07:20,280
لكن ينبغي أن تكون الأكثر يقظة هنا

97
00:07:20,280 --> 00:07:20,790
ماذا؟

98
00:07:21,100 --> 00:07:24,790
تآلفك مع الكامي عالٍ جدّاً

99
00:07:25,100 --> 00:07:27,330
،هذا لأنّك لا تعيش في الأرض المُقدّسة فقط

100
00:07:27,330 --> 00:07:29,300
بل تستحمّ بنبع ياماغامي السّاخن أيضاً

101
00:07:30,920 --> 00:07:33,690
إذا تمّ سحبك إلى داخل
،عالم كامي بغيض

102
00:07:33,690 --> 00:07:35,820
فلن تتمكّن من الخروج حتّى

103
00:07:36,570 --> 00:07:38,430
سـ-سأتوخّى الحذر

104
00:07:39,740 --> 00:07:40,920
،على ذكر الأمر

105
00:07:41,250 --> 00:07:44,690
يبدو أنّ ياماغامي غادر لتدمير
عوالم كامي المهجورة أيضاً

106
00:07:44,960 --> 00:07:48,160
حقّاً؟ هل أنت جادّ؟

107
00:07:48,160 --> 00:07:49,810
كُن حذراً

108
00:07:49,810 --> 00:07:50,910
إلى اللّقاء

109
00:07:51,620 --> 00:07:53,980
طائر-سان، لنسلك طريقاً مُختصراً اليوم

110
00:08:10,090 --> 00:08:12,430
!يا للهول! أعدادهم كثيرة

111
00:08:12,430 --> 00:08:13,480
هذا سيّئ

112
00:08:13,480 --> 00:08:15,830
إنّه ينتشر نحو منزل ميناتو

113
00:08:15,830 --> 00:08:18,050
!يجب  علينا أن نطرده هنا وحالاً

114
00:08:18,360 --> 00:08:20,410
لنتفرّق

115
00:08:20,410 --> 00:08:21,220
!حاضر

116
00:08:21,570 --> 00:08:22,600
!دع الأمر لي

117
00:08:22,600 --> 00:08:23,850
!لنفعل هذا

118
00:08:36,090 --> 00:08:38,330
يبدو هذا المكان مُتقوِّضاً حقّاً

119
00:08:40,270 --> 00:08:43,000
!لا، لا! يجب أن تبتعد

120
00:08:44,180 --> 00:08:47,400
ماذا؟، هل قلت شيئاً؟

121
00:08:48,950 --> 00:08:51,350
بدا كصوت شخص آخر

122
00:08:51,350 --> 00:08:52,970
هل تخيّلتُه؟

123
00:08:54,590 --> 00:08:55,430
ماذا؟

124
00:08:55,980 --> 00:08:57,860
!مـ-مهلاً؟

125
00:08:59,530 --> 00:09:01,560
!جـ-جسدي ينجذب للدّاخل؟

126
00:09:10,910 --> 00:09:11,860
!طائر-سان؟

127
00:09:46,270 --> 00:09:47,850
طائر-سان، هل أنت بخير؟

128
00:09:51,070 --> 00:09:53,700
أين نحن؟

129
00:09:53,700 --> 00:09:57,320
يبدو هذا مثل المرّة الّتي دخلتُ
فيها عالمَ كامي سابقاً

130
00:09:57,610 --> 00:09:59,140
هل نحن في واحد الآن؟

131
00:10:00,140 --> 00:10:03,420
لا يهمّ ما يكون، من الصّعب
التنفُّس بعض الشّيء

132
00:10:03,420 --> 00:10:05,540
لنبحث عن المخرج بسرعة

133
00:10:15,020 --> 00:10:17,080
ما هذه الصّناديق الخشبيّة؟

134
00:10:17,080 --> 00:10:19,050
هناك الكثير منهم

135
00:10:19,570 --> 00:10:21,760
...ثمّة كلام قاله ياماغامي ذات مرّة

136
00:10:22,420 --> 00:10:27,020
عوالم كامي تعكس عقولَ صانعيها

137
00:10:27,870 --> 00:10:32,730
إنّها نسخة عن أكثر فضاء
يجدونه مُريحاً

138
00:10:33,090 --> 00:10:35,800
لا بُدّ أنّ هذا الصّانع يعشق
الصّناديق الخشبيّة حقّاً

139
00:10:38,550 --> 00:10:39,640
ما هذا؟

140
00:10:44,950 --> 00:10:47,330
الهواء خانق هنا

141
00:10:50,830 --> 00:10:52,010
هل من أحد هناك؟

142
00:10:55,180 --> 00:10:59,510
هل هذا هو الإله الّذي صنع عالم الكامي هذا؟

143
00:11:07,410 --> 00:11:11,740
أهذا هو الإله الّذي صنع عالمَ كامي هذا؟

144
00:11:17,290 --> 00:11:20,210
!هذا الهواء الكئيب

145
00:11:20,210 --> 00:11:22,980
!إنّه رطِب جدّاً لدرجة لا أستطيع النّوم

146
00:11:22,980 --> 00:11:24,610
يجب أن يتمّ تهويته

147
00:11:24,610 --> 00:11:26,150
لكن لا أريد أن أتكبّد العناء

148
00:11:26,650 --> 00:11:28,900
لا أريد أن أتحرّك

149
00:11:28,900 --> 00:11:31,620
أريد فقط أن أنام طوال اليوم

150
00:11:31,620 --> 00:11:32,730
المعذرة

151
00:11:33,910 --> 00:11:37,110
هل أنتِ صانعة عالم كامي هذا؟

152
00:11:37,110 --> 00:11:38,590
هذا صحيح

153
00:11:38,590 --> 00:11:41,130
من أنت؟ أنت بشريّ، صحيح؟

154
00:11:41,350 --> 00:11:42,360
أجل

155
00:11:42,360 --> 00:11:45,000
أهذا أنت يا هوو؟

156
00:11:48,380 --> 00:11:51,320
يبدو أنّ لديك كثير من الحماية

157
00:11:51,320 --> 00:11:52,610
لماذا أنت هنا؟

158
00:11:52,610 --> 00:11:54,400
لم أستدعك

159
00:11:54,400 --> 00:11:55,440
لا أدري

160
00:11:55,440 --> 00:11:57,330
هل أنت تائه؟

161
00:11:57,330 --> 00:12:01,700
هذا غريب، ينبغي أن تكون البوّابة
قد أُغلِقَتْ بالكامل

162
00:12:02,010 --> 00:12:03,630
،الآن

163
00:12:03,630 --> 00:12:06,910
تظهر كثير من البوّابات المُؤدّية إلى عوالم
كامي المهجورة في العالم الخارجيّ

164
00:12:06,910 --> 00:12:10,830
يا للوقاحة. لم أهجر هذا العالم

165
00:12:10,830 --> 00:12:14,790
لا. هل ضَعُفَتْ قوّتي؟

166
00:12:15,080 --> 00:12:18,500
المزار الّذي رأيتُه في الطّريق إلى هنا
بدا مُتقوّضاً جدّاً

167
00:12:18,500 --> 00:12:20,570
يا للهول! معك حقّ

168
00:12:20,570 --> 00:12:21,880
لكن متى؟

169
00:12:21,880 --> 00:12:23,740
كم قمراً قد مضى على ذلك؟

170
00:12:24,060 --> 00:12:25,220
حسناً، أيّاً يكن

171
00:12:25,220 --> 00:12:26,720
...ماذا؟ المعذرة

172
00:12:27,190 --> 00:12:30,790
اسمع، أنت مُتّصل بفوجين، صحيح؟

173
00:12:30,790 --> 00:12:33,100
لا أعلم إن كانت "مُتّصل" هي الكلمة الصّائبة

174
00:12:33,100 --> 00:12:36,550
لكن أنت تمتلك قوّته

175
00:12:36,550 --> 00:12:37,730
استطعتِ معرفة ذلك؟

176
00:12:37,970 --> 00:12:39,360
بالطّبع

177
00:12:39,360 --> 00:12:44,250
شخصيّة فطِنة مثله تمنح قوّتها
...لبشريّ فوق ذلك

178
00:12:46,940 --> 00:12:49,780
أودّ أن أطلب معروفاً

179
00:12:49,780 --> 00:12:54,260
هل يمكنك استخدام قوّة فوجين
وتهوية هذا المكان؟

180
00:12:54,260 --> 00:12:56,000
أتقولين تهوية؟

181
00:12:56,250 --> 00:12:58,820
الهواء هنا راكد

182
00:12:58,820 --> 00:13:00,220
هذا صحيح

183
00:13:00,220 --> 00:13:02,480
إن كان شيئاً أستطيع فعله، فدعيني أُحاول

184
00:13:02,480 --> 00:13:05,580
متى كانت آخر مرّة تمّت تهويته؟

185
00:13:05,580 --> 00:13:07,600
،بالزّمن البشريّ

186
00:13:07,600 --> 00:13:11,350
أعتقد بأنّ النّاس كانوا يتحدّثون عن إيقاف
مبعوثين مُتّجهين إلى سُلالة تانغ

187
00:13:12,570 --> 00:13:14,740
إذاً منذ أكثر من ألف عام

188
00:13:14,740 --> 00:13:15,810
حقّاً؟

189
00:13:15,810 --> 00:13:21,320
البشر يأتون ويذهبون بسرعة لدرجة
لا أستطيع تذكّر أسماءهم

190
00:13:21,700 --> 00:13:23,130
هكذا إذاً

191
00:13:23,130 --> 00:13:24,780
حسناً، شكراً على مُساعدتك

192
00:13:26,570 --> 00:13:29,380
عندما أنتهي من ذلك، هلّا ساعدتِني
في الخروج من هنا؟

193
00:13:29,380 --> 00:13:30,620
بكلّ تأكيد

194
00:13:30,620 --> 00:13:31,870
هل تعدينني؟

195
00:13:32,230 --> 00:13:33,770
هذا يكفي

196
00:13:33,770 --> 00:13:36,920
هل أبدو كإلَهة غير مسؤولة أمامك؟

197
00:13:36,920 --> 00:13:38,180
...تبدين كذلك بعض الشّيء

198
00:13:42,700 --> 00:13:43,550
!مهلاً

199
00:13:43,930 --> 00:13:44,900
ما هذه الفجوة؟

200
00:13:45,210 --> 00:13:50,280
في طريقك، ارمِ كلّ الصّناديق الخشبيّة
في هذه المنطقة هناك

201
00:13:50,630 --> 00:13:51,660
حسناً

202
00:14:08,730 --> 00:14:10,870
!يا له من مشهد

203
00:14:16,040 --> 00:14:17,370
!ها

204
00:14:18,050 --> 00:14:18,500
!يا

205
00:14:19,500 --> 00:14:20,500
!خذ هذه

206
00:14:23,950 --> 00:14:26,170
هل أنت بخير يا أوتسوغي؟

207
00:14:26,170 --> 00:14:28,590
ارتكبتُ خطأ

208
00:14:28,590 --> 00:14:31,850
بئس الأمر، جميعكم صاخبون للغاية

209
00:14:32,290 --> 00:14:33,530
!ياماغامي

210
00:14:33,910 --> 00:14:35,310
كيف سار الأمر؟

211
00:14:35,970 --> 00:14:38,820
تولّيتُ أمر الجهة الشّماليّة

212
00:14:38,820 --> 00:14:40,210
الجهة الغربيّة قد تمّت

213
00:14:40,210 --> 00:14:42,070
وأنا أنجزتُ الجانبَ الشّرقيّ

214
00:14:42,890 --> 00:14:46,640
أحسنتم صنعاً. والآن سنُنقذ ميناتو

215
00:14:46,640 --> 00:14:47,820
ميناتو؟

216
00:14:47,820 --> 00:14:49,280
ألا تشعرون بذلك؟

217
00:14:49,280 --> 00:14:51,380
إنّه عالق في عالم كامي

218
00:14:51,380 --> 00:14:52,570
!ماذا؟

219
00:14:52,570 --> 00:14:55,610
...إذاً صيحة هوو قبل مدّة

220
00:14:55,610 --> 00:14:57,410
!يجب أن نذهب حالاً

221
00:14:59,240 --> 00:15:01,000
!ثانية؟

222
00:15:01,000 --> 00:15:02,510
!لا نهاية لهذا

223
00:15:02,510 --> 00:15:05,250
!ناهيك عن توجّهها نحو منزل ميناتو

224
00:15:08,930 --> 00:15:10,590
يبدو أنّك في ورطة

225
00:15:10,590 --> 00:15:12,220
هل تريدنا أن نُقدّم المُساعدة؟

226
00:15:12,720 --> 00:15:14,010
أنا في غاية الامتنان

227
00:15:14,570 --> 00:15:16,010
دعوا هذا المكان لي

228
00:15:16,010 --> 00:15:17,470
غادروا جميعكم حالاً

229
00:15:17,470 --> 00:15:18,600
!حاضر

230
00:15:18,860 --> 00:15:21,050
حسناً، هل نحسم هذه المسألة؟

231
00:15:21,050 --> 00:15:23,610
بالتّأكيد. ياماغامي، لِمَ لا تأخذ استراحة؟

232
00:15:23,960 --> 00:15:25,260
مُحال

233
00:15:31,340 --> 00:15:33,140
جميل

234
00:15:33,140 --> 00:15:36,110
يُذكّرني هذا بأيّامه عندما كان
ثائراً وهائجاً طوال الوقت

235
00:15:36,110 --> 00:15:39,560
متى كانت آخر مرّة ثار فيها هذا الجبل ثانية؟

236
00:15:39,560 --> 00:15:41,160
قبل ألف سنة؟

237
00:15:41,160 --> 00:15:43,060
كفى كلاماً فارغاً

238
00:15:43,060 --> 00:15:44,880
كان ذلك قبل ألف وخمسمئة عام

239
00:15:47,130 --> 00:15:49,750
هذا هو الأخير. انتهيت

240
00:15:50,470 --> 00:15:52,230
ما رأيكِ بذلك؟

241
00:15:59,110 --> 00:16:00,810
!مُذهل

242
00:16:01,340 --> 00:16:03,800
!مُرتّب أخيراً

243
00:16:03,800 --> 00:16:06,910
لكن ما زال الهواء راكداً جدّاً

244
00:16:07,820 --> 00:16:08,980
...إذاً

245
00:16:09,660 --> 00:16:10,810
ما هذا؟

246
00:16:10,810 --> 00:16:13,950
الأوراق من الشّجرة المُقدّسة
في حديقتي، كوسونوكي

247
00:16:22,760 --> 00:16:24,750
لا باس

248
00:16:25,120 --> 00:16:28,110
صادفَ وجودها معك فحسب؟

249
00:16:28,110 --> 00:16:30,900
أُنقِذتُ بواسطتها قبل أيّام

250
00:16:30,900 --> 00:16:32,970
لذا أخذتُ معي بعضاً منها تحسُّباً فقط

251
00:16:34,390 --> 00:16:35,680
شكراً لعملكِ

252
00:16:37,070 --> 00:16:39,720
تبدو نظيفة حقّاً

253
00:16:39,720 --> 00:16:41,810
يسرّني أنّني استطعتُ تقديم المُساعدة

254
00:16:41,810 --> 00:16:46,080
اسمع، إن كان لديك المزيد من هذه
الأوراق، فهلّا حصلتُ عليها؟

255
00:16:46,080 --> 00:16:47,310
بالطّبع

256
00:16:50,230 --> 00:16:53,020
رائحتها لطيفة حقّاً

257
00:16:53,020 --> 00:16:56,600
أجل، الرّائحة فوّاحة جدّاً

258
00:16:56,600 --> 00:17:00,790
كتعبير شكر، سأدعك تحصل
على بعض من قوّتي

259
00:17:06,110 --> 00:17:07,800
أيّ نوع من القوى هي هذه؟

260
00:17:07,800 --> 00:17:09,580
قوّة ختم الأشياء

261
00:17:09,910 --> 00:17:12,590
ختم؟ ختم ماذا؟

262
00:17:12,810 --> 00:17:14,550
ما لا يمكن رؤيته

263
00:17:15,130 --> 00:17:18,940
،مشاعر النّاس، رغبات مُزعجة
...قوى خارقة

264
00:17:18,940 --> 00:17:22,870
يمكنك ختم أشياء كتلك في أيّ شيء تختاره

265
00:17:23,970 --> 00:17:25,310
...إذاً تلك الصّناديق

266
00:17:25,740 --> 00:17:30,040
،أجل. يصلّي البشر لي بشأنها
وذلك كي أختم عليها لأجلهم

267
00:17:30,470 --> 00:17:34,540
،أشياء كالأحلام لا يمكنهم التخلّي عنهم
،والغيرة والكراهية تجاه الآخرين

268
00:17:34,540 --> 00:17:36,780
وقوى خارقة لا يستطيعون التحكُّم بها

269
00:17:37,530 --> 00:17:40,390
ليس بالضّرورة أن يكون صندوقاً خشبيّاً

270
00:17:40,390 --> 00:17:44,250
يمكنك إيجاد ما يناسبك

271
00:17:44,950 --> 00:17:49,620
استخدام قوّتي من عدمها أمر عائد لك

272
00:17:50,380 --> 00:17:52,830
،لك الحرّية في الختم على القوّة هناك

273
00:17:52,830 --> 00:17:54,630
أو يمكنك تحريرها بشروط

274
00:17:55,380 --> 00:18:00,450
أيّ شيء مُمكن إذا... درّبت قوّتك

275
00:18:00,450 --> 00:18:03,610
!يا إلَهة، لا تنامي أرجوكِ

276
00:18:05,350 --> 00:18:07,390
!أين المخرج؟

277
00:18:07,390 --> 00:18:09,150
المخرج؟

278
00:18:09,460 --> 00:18:11,380
ماذا يعني مخرج؟

279
00:18:12,430 --> 00:18:14,010
لقد نامت

280
00:18:15,340 --> 00:18:17,580
لا أستطيع إجبارها على الاستيقاظ

281
00:18:17,580 --> 00:18:18,790
ماذا أفعل؟

282
00:18:19,830 --> 00:18:21,530
!ميناتو

283
00:18:21,530 --> 00:18:22,610
!الجميع

284
00:18:25,350 --> 00:18:26,580
هل أنت بخير؟

285
00:18:26,580 --> 00:18:29,370
أجل. شكراً لمجيئكم لأجلي

286
00:18:29,370 --> 00:18:31,290
نحن آسفون لتأخّرنا

287
00:18:31,290 --> 00:18:33,600
عرقلَتْنا كثير من عوالم كامي المهجورة

288
00:18:33,600 --> 00:18:35,340
وأنت واجهتَ وقتاً عصيباً أيضاً

289
00:18:35,590 --> 00:18:38,140
كانت إلَهة قديمة جدّاً

290
00:18:38,140 --> 00:18:40,460
إلَهة غير بلا همّة

291
00:18:40,460 --> 00:18:42,590
إلَهة بلا همّة؟

292
00:18:42,590 --> 00:18:44,560
مُنِحتُ قوّة ختم الأشياء

293
00:18:44,560 --> 00:18:47,320
لا بُدّ أنّها كانت أماتيراسو

294
00:18:47,320 --> 00:18:48,520
...أماتيراسو

295
00:18:48,860 --> 00:18:51,730
!تقصد "الأماتيراسو"؟

296
00:18:54,470 --> 00:18:57,060
لم أتخيّلها بهذا الشّكل

297
00:19:00,450 --> 00:19:03,120
كيف عرفتم مكاني؟

298
00:19:03,420 --> 00:19:06,860
أعطانا صوتُ هوو لمحة عن مكان تواجدك

299
00:19:06,860 --> 00:19:09,810
...فهمت. صياحه ذاك

300
00:19:13,350 --> 00:19:14,040
!عجباً

301
00:19:16,290 --> 00:19:18,010
يجب أن أشكره عندما يستيقظ

302
00:19:18,260 --> 00:19:21,310
يمكنك أيضاً شكر روح الرّياح

303
00:19:21,310 --> 00:19:22,470
روح الرّياح؟

304
00:19:22,710 --> 00:19:26,260
صوت الرّياح الّذي أرشدنا إلى هنا

305
00:19:26,260 --> 00:19:29,530
هل سمعت شيئاً قبل انجذابك للدّاخل؟

306
00:19:30,650 --> 00:19:33,390
!لا، لا! يجب أن تبتعد

307
00:19:34,230 --> 00:19:38,670
هذا الصّوت... حاول تحذيري من الخطر هناك؟

308
00:19:38,670 --> 00:19:42,500
لعلّه ما زال من الصّعب رؤيتهم وسماعهم

309
00:19:42,500 --> 00:19:44,570
أصغِ جيّداً

310
00:19:44,570 --> 00:19:46,120
ركِّز وحاول الإصغاء لهم

311
00:19:46,120 --> 00:19:48,240
هذا ما يهمّ

312
00:19:48,900 --> 00:19:49,950
...انتباهي

313
00:19:59,210 --> 00:20:00,680
يسرّني أنّك بخير

314
00:20:01,880 --> 00:20:03,210
هل كان ذلك...؟

315
00:20:03,640 --> 00:20:05,370
سمعتها

316
00:20:07,930 --> 00:20:10,450
شكراً لكِ يا أرواح الرّياح

317
00:20:15,510 --> 00:20:18,470
هاريما، لا تتركني

318
00:20:18,470 --> 00:20:21,110
لم أعُد أمتلك اللّياقة

319
00:20:21,570 --> 00:20:23,030
ما الأمر؟

320
00:20:23,580 --> 00:20:24,990
حسناً، حسناً

321
00:20:24,990 --> 00:20:28,450
تأخّرت أيّها الأونميوجي العزيز

322
00:20:29,030 --> 00:20:33,720
نحن طاردو الأرواح تولّينا أمر
البُخار العفِن هنا بالفعل

323
00:20:34,220 --> 00:20:36,580
أشكركما من القلب

324
00:20:36,580 --> 00:20:39,660
،وما الّذي جاء بكما إلى هنا
حدودنا الإداريّة؟

325
00:20:39,990 --> 00:20:42,630
عندما يتواجد طاردو أرواح
،مُتجذِّرون في المنطقة

326
00:20:42,630 --> 00:20:46,270
لا يستطيع الأونميوجي طرد الأرواح الشّرّيرة هناك

327
00:20:47,370 --> 00:20:49,160
هذه هي القاعدة الشّفهيّة، أليس كذلك؟

328
00:20:51,030 --> 00:20:54,730
حسناً، وقتنا يُداهمنا، لذا نستأذن بالانصراف

329
00:20:57,230 --> 00:20:58,890
من كان ذلك الرّجل؟

330
00:20:58,890 --> 00:21:03,110
هناك طاردو أرواح وقحون يقبلون
،قضايا مُقابل أجور خياليّة

331
00:21:03,430 --> 00:21:05,040
وهو قائدهم

332
00:21:05,040 --> 00:21:07,580
آمل ألّا يُخطّطوا لفعل شيء

333
00:21:09,510 --> 00:21:12,160
!ياماغامي، عُدت

334
00:21:12,410 --> 00:21:16,010
اشتريتُ لك شيئاً

335
00:21:16,010 --> 00:21:18,330
ماذا؟ ياماغامي؟

336
00:21:18,600 --> 00:21:19,930
!بئس الأمر

337
00:21:20,830 --> 00:21:21,980
—جميعكم

338
00:21:21,980 --> 00:21:23,220
!ياماغامي

339
00:21:24,570 --> 00:21:26,730
أصبحت أصغر ثانية؟

340
00:21:27,080 --> 00:21:30,010
أجل، يبدو أنّني أفرطتُ في استعمال قوّتي

341
00:21:30,510 --> 00:21:33,140
!من فضلك كُل جيّداً واكبر ثانية

342
00:21:33,140 --> 00:21:34,890
اشتريتُ لك حلويّات يابانيّة أيضاً

343
00:21:39,690 --> 00:21:40,730
ما رأيك؟

344
00:21:41,800 --> 00:21:44,250
ينبغي لهذا أن يُعيدني إلى طبيعتي
خلال وقت قصير

345
00:21:44,250 --> 00:21:46,050
آمل ذلك

346
00:21:46,710 --> 00:21:50,970
لكن هيئتك الصّغيرة ظريفة جدّاً

347
00:21:50,970 --> 00:21:54,720
إنّه حجم مثاليّ للّعب مع تنّين وكيرين

348
00:21:54,720 --> 00:21:56,350
!إيّاك والسّخرية منّي

349
00:21:56,730 --> 00:21:59,020
أنا إله جبل

350
00:23:31,330 --> 00:23:36,630
"الحلقة 6: "أهلاً بك في حديقة الرّبيع