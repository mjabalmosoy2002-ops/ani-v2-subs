1
00:00:20,300 --> 00:00:21,540
حسناً

2
00:00:24,120 --> 00:00:25,710
قوّة الرّياح خاصّتك

3
00:00:26,620 --> 00:00:29,630
تحسّنتَ في التحكُّم بها

4
00:00:30,530 --> 00:00:34,920
لكن ما كنتُ لأجرؤ على مُقارنة نفسي بفوجين

5
00:00:34,920 --> 00:00:37,140
لا، إنّها مُدهشة جدّاً حقّاً

6
00:00:38,180 --> 00:00:40,560
فوجين، رايجين

7
00:00:40,860 --> 00:00:43,810
أنت تجني ثِمار تدريبك على أرض الواقع

8
00:00:43,810 --> 00:00:45,570
يعزو كلّ الفضل لكما

9
00:00:45,570 --> 00:00:47,400
لكن عليّ أن أتدرّب أكثر

10
00:00:47,620 --> 00:00:48,740
ابذل قصارى جهدك

11
00:00:48,740 --> 00:00:50,910
وستكون قويّاً بما يكفي لتقطيع منزل

12
00:00:50,910 --> 00:00:53,720
شخص لا تُحبّه إلى نصفين

13
00:00:53,720 --> 00:00:55,410
!لستُ عدوانيّاً إلى هذه الدّرجة

14
00:00:55,800 --> 00:00:58,790
هل ينبغي أن أمنحك قوّتي تالياً؟

15
00:00:59,370 --> 00:01:01,620
لـ-لا، شكراً لك

16
00:01:02,370 --> 00:01:04,750
بالمُناسبة، أين أتباعك؟

17
00:01:05,360 --> 00:01:08,260
إنّهم يتدرّبون أيضاً بينما نتكلّم

18
00:01:09,560 --> 00:01:12,260
!ما نفتقر له هو الثّبات الذّهنيّ

19
00:01:12,260 --> 00:01:14,930
!يجب أن نتجاهل الإلهاءات ونُواجه أنفسنا

20
00:01:15,480 --> 00:01:17,640
نُواجه أنفسنا؟

21
00:01:17,640 --> 00:01:19,830
!لنبدأ بالتأمُّل

22
00:01:20,940 --> 00:01:23,000
لنُركّز

23
00:01:25,090 --> 00:01:30,400
،عندما واجَهوا دنَساً معك في الجبل
كانوا عديمي الحيلة

24
00:01:30,400 --> 00:01:32,980
لا بُدّ أنّ ذلك أزعجَهم

25
00:01:33,900 --> 00:01:36,780
فهمت. يبذلون قصارى جهدهم أيضاً

26
00:01:37,240 --> 00:01:39,500
...لنُركّز

27
00:03:27,740 --> 00:03:29,780
ياماغامي، تفضّل

28
00:03:34,420 --> 00:03:39,930
شِواء البطاطا الحُلوة في الحديقة
له جاذبيّته الخاصّة

29
00:03:39,930 --> 00:03:43,080
أليس كذلك؟ يا تنّين، ما رأيك؟

30
00:03:45,240 --> 00:03:47,320
يقول بأنّها لذيذة

31
00:03:47,320 --> 00:03:48,710
هذا جيّد

32
00:03:51,920 --> 00:03:55,670
سُلحفاة، أرى بأنّك تُفضّل شوتشو البطاطا
الحُلوى على البطاطا المشويّة

33
00:03:56,290 --> 00:03:59,390
فوجين، رايجين، من فضلكما تناولا معنا الطّعام

34
00:03:59,660 --> 00:04:03,470
يمكننا صنع بطاطا حُلوة مشويّة متى شئنا

35
00:04:03,470 --> 00:04:04,820
أحقّاً ذلك؟

36
00:04:04,820 --> 00:04:05,890
دعنا نُريك

37
00:04:08,520 --> 00:04:10,650
هل أنت مُستعدّ؟

38
00:04:13,050 --> 00:04:14,820
!الطّلب جاهز

39
00:04:14,820 --> 00:04:17,600
!المعذرة، لكنّها محروقة تماماً

40
00:04:17,600 --> 00:04:19,780
لا تُدقّق في التّفاصيل

41
00:04:21,880 --> 00:04:22,660
ماذا؟

42
00:04:25,620 --> 00:04:29,520
كيرين، عدت من الرّحلة حول العالم؟

43
00:04:31,220 --> 00:04:34,240
شكراً لك على إحضار فواكه
نادرة لي طوال الوقت

44
00:04:34,890 --> 00:04:37,180
هل ترغب في تناول بطاطا
حُلوة مشويّة معنا؟

45
00:04:39,050 --> 00:04:41,640
كان البشر يحرقون بَني جلدتهم
،على الوتد منذ القِدَم

46
00:04:41,640 --> 00:04:44,210
!يا لها من عادة مُرعبة

47
00:04:44,210 --> 00:04:47,310
هل ينوي مُعاملتي نفس المُعاملة؟

48
00:04:48,900 --> 00:04:50,520
ماذا؟

49
00:04:50,890 --> 00:04:53,730
يؤسفني أنّه لم ينفتح معي بعد

50
00:04:53,730 --> 00:04:56,030
سمعتُ بأنّ كيرين يُحبّ البيرة

51
00:04:56,440 --> 00:04:59,620
بيرة؟ سأجهّز بعضاً في المرّة المُقبلة

52
00:05:01,780 --> 00:05:03,350
!قادم

53
00:05:05,340 --> 00:05:06,860
سيّد هاريما؟

54
00:05:09,500 --> 00:05:10,410
!سيّد هاريما؟

55
00:05:10,880 --> 00:05:13,630
!هل أنت بخير يا سيّد هاريما؟

56
00:05:20,820 --> 00:05:23,050
تبدو مُرهَقاً

57
00:05:23,460 --> 00:05:25,460
أنا آسف

58
00:05:25,980 --> 00:05:32,320
بـ-بالمُناسبة، أشعر بضغط أكبر
من المعتاد اليوم

59
00:05:32,320 --> 00:05:35,520
حـ-حقّاً؟ ربّما أنت تتخيّل ذلك؟

60
00:05:35,520 --> 00:05:38,320
المُهمّ، ما الّذي جاء بك إلى هنا اليوم؟

61
00:05:38,660 --> 00:05:41,350
أودّ أن أطلب منك معروفاً خاصّاً

62
00:05:41,680 --> 00:05:43,360
على أن يكون ضمن إمكانيّاتي

63
00:05:43,800 --> 00:05:47,280
هناك روح شرّيرة قويّة جدّاً لدرجة أنّ كافّة
الأونميوجي لدينا لا يستطيعون هزيمتها

64
00:05:47,700 --> 00:05:50,700
أريدك أن تذهب إلى هناك وتطردها

65
00:05:52,100 --> 00:05:57,880
بدأ كلّ شيء بدُمية أُحضِرَتْ
إلى معبد للتّطهير

66
00:05:58,440 --> 00:06:00,580
صاحبُ قوّة التّطهير

67
00:06:00,580 --> 00:06:02,130
قد تُوفّي، لذا لم يتمّ تطهيرها

68
00:06:02,800 --> 00:06:06,760
وسرعان ما وجدوا أنّ الدُّمية
تحوّلتْ إلى روح شرّيرة

69
00:06:07,340 --> 00:06:11,640
لا بُدّ أنّ الهويّة الحقيقيّة للرُّوح
الشّرّيرة هي إله أو ما شابه

70
00:06:12,140 --> 00:06:14,040
الاضطراب الرّوحانيّ قاهر جدّاً

71
00:06:14,040 --> 00:06:16,950
لدرجة حتّى أونميوجي أمثالنا
لا يستطيعون الاقتراب

72
00:06:18,610 --> 00:06:20,820
لكن لماذا أنا؟

73
00:06:20,820 --> 00:06:26,300
،يتواجد المعبد في فضاء خاصّ
ليس من هذا العالم

74
00:06:26,700 --> 00:06:28,320
مكان يُشبه هذا المكان

75
00:06:28,660 --> 00:06:33,330
أنت قادر، أو بالأحرى، يُسمَح لك
...بالعيش هنا. ما يعني

76
00:06:33,330 --> 00:06:36,000
تعتقد بأنّني أستطيع دخول العالم الآخر؟

77
00:06:36,000 --> 00:06:36,580
أجل

78
00:06:37,220 --> 00:06:39,390
يمكنك رؤيتهم، صحيح؟

79
00:06:39,390 --> 00:06:43,920
أقصد... الآلهة والحيوانات القدسيّة
الّتي تعيش في هذا البناء

80
00:06:45,340 --> 00:06:47,970
أتعتمد على قِوايّ؟

81
00:06:48,260 --> 00:06:50,680
!أَدرِك حجمك أيُّها البشريّ

82
00:06:52,430 --> 00:06:53,930
!يـ-ياماغامي؟

83
00:06:54,760 --> 00:06:55,940
!ما... ماذا؟

84
00:06:59,330 --> 00:07:01,640
بالغتَ كثيراً يا ياماغامي

85
00:07:01,640 --> 00:07:03,560
إنّه مرعوب

86
00:07:03,560 --> 00:07:05,610
أشفق عليه

87
00:07:05,610 --> 00:07:07,320
!أنتم

88
00:07:12,260 --> 00:07:14,490
هل  أنت بخير يا سيّد هاريما؟

89
00:07:14,490 --> 00:07:16,270
أ-أجل

90
00:07:16,270 --> 00:07:17,960
ماذا كان ذلك للتو؟

91
00:07:18,200 --> 00:07:23,120
إذاً، هل يمكنني دخول
العالم الآخر بقوّتك؟

92
00:07:23,120 --> 00:07:24,480
بالطّبع

93
00:07:24,480 --> 00:07:26,490
أنا ياماغامي، إله جبل

94
00:07:26,490 --> 00:07:28,550
سوف تُساعدني إذاً

95
00:07:28,550 --> 00:07:29,790
!هذا رائع

96
00:07:30,200 --> 00:07:32,430
بشرط واحد

97
00:07:32,650 --> 00:07:33,990
شرط؟

98
00:07:40,810 --> 00:07:43,940
ما رأيك بالحلويّات من السّيّد هاريما؟

99
00:07:43,940 --> 00:07:47,780
كما هو مُتوقَّع من كعك أرزّ بمعجون
فاصولياء من سوروغا هونبو

100
00:07:47,780 --> 00:07:49,160
إنّه أخّاذ

101
00:07:51,020 --> 00:07:53,030
هل نذهب؟

102
00:07:53,030 --> 00:07:55,780
ماذا؟ لن أذهب

103
00:07:55,780 --> 00:07:59,690
ماذا؟ ألم نقل بأنّنا سنستخدم قوّتك
لدخول العالم الآخر؟

104
00:07:59,690 --> 00:08:01,670
ميناتو، لا تقلق

105
00:08:02,620 --> 00:08:06,300
!بدلاً من ياماغامي، سوف نُرافقك نحن

106
00:08:06,300 --> 00:08:08,980
هل أتممتُم تدريبكم؟

107
00:08:08,980 --> 00:08:12,360
أجل! لم نعُد كما كنّا في السّابق

108
00:08:12,360 --> 00:08:14,100
لنُساعد ميناتو

109
00:08:14,330 --> 00:08:16,490
هذا أدنى من مستوايّ

110
00:08:16,490 --> 00:08:19,500
يا أتباعي، أظهِروا ثِمار تدريبكم

111
00:08:19,500 --> 00:08:20,680
!أجل

112
00:08:20,680 --> 00:08:22,100
كم هذا مُؤتمَن

113
00:08:31,930 --> 00:08:33,950
من فضلكم احرسوا المنزل أثناء غيابي

114
00:08:34,340 --> 00:08:35,750
بالتّوفيق

115
00:08:37,700 --> 00:08:39,120
!سأُغادر

116
00:08:39,120 --> 00:08:43,670
!سنُغادر بمعنويّات عالية

117
00:09:04,890 --> 00:09:06,740
!ها نحن أولاء

118
00:09:08,700 --> 00:09:10,440
...لنرَ

119
00:09:10,440 --> 00:09:12,030
أعتقد بأنّه هناك

120
00:09:18,500 --> 00:09:22,900
أنا متأكّد بأنّ هناك أمامنا

121
00:09:22,900 --> 00:09:24,200
لحظة، ماذا؟

122
00:09:25,320 --> 00:09:26,500
أين أنتم؟

123
00:09:31,850 --> 00:09:34,150
!فطائر تُفّاح مخبوزة طازجة

124
00:09:34,460 --> 00:09:36,100
من الفرن مُباشرة

125
00:09:36,440 --> 00:09:38,900
!ميناتو

126
00:09:42,500 --> 00:09:44,880
!لنأكل

127
00:09:46,340 --> 00:09:48,640
!تُفّاح مُقرمش

128
00:09:48,640 --> 00:09:52,550
لم أكن أعلم بأنّ الفطائر
!مُقرمشة إلى هذا الحدّ

129
00:09:54,530 --> 00:09:57,330
أوتسوغي، أكمل المضغ قبل أن تتكلّم

130
00:09:57,720 --> 00:10:01,130
لنُنجز هذا العمل بسرعة ونشتري
المزيد لنأخذه إلى المنزل

131
00:10:01,130 --> 00:10:02,160
!مرحى

132
00:10:06,120 --> 00:10:07,650
...ذلك الغُراب

133
00:10:07,650 --> 00:10:10,590
يبدو أنّه يدلّنا على الطّريق

134
00:10:10,590 --> 00:10:12,220
لنُجرّب اللّحاق به

135
00:10:16,520 --> 00:10:18,140
من هناك على ما يبدو

136
00:10:18,380 --> 00:10:20,380
الدّنس فظيع بعد هذه النّقطة

137
00:10:20,380 --> 00:10:21,530
توخّوا الحذر

138
00:10:21,530 --> 00:10:23,000
سأذهب أوّلاً

139
00:10:29,210 --> 00:10:31,200
الغُربان تبتعد

140
00:10:31,200 --> 00:10:32,860
لا ألومهم

141
00:10:32,860 --> 00:10:35,140
إنّه دنَس لا يُعقَل

142
00:10:35,140 --> 00:10:36,820
حتّى أنا أستطيع رؤيته

143
00:10:39,030 --> 00:10:40,540
أجل، هاريما يتكلّم

144
00:10:40,540 --> 00:10:42,210
معك كوسونوكي

145
00:10:42,210 --> 00:10:43,790
وصلتُ للتو

146
00:10:43,790 --> 00:10:45,540
أين أنت؟

147
00:10:45,540 --> 00:10:46,800
عند البوّابة الخلفيّة

148
00:10:46,800 --> 00:10:48,390
هل أنت عند البوّابة الأماميّة؟

149
00:10:48,390 --> 00:10:49,740
هذا ما أعتقده

150
00:10:49,740 --> 00:10:51,760
هناك تُمثال لحارس نيو

151
00:10:52,770 --> 00:10:54,480
!ها أنا ذا

152
00:10:56,180 --> 00:10:58,900
!الدّنَس هنا جنونيّ

153
00:11:00,250 --> 00:11:02,600
لا نستطيع حتّى الاقتراب

154
00:11:02,880 --> 00:11:06,200
أعلم بأنّني أنا من طلب منك التّواجد
هنا، لكن لا تضغط على نفسك رجاء

155
00:11:06,720 --> 00:11:08,580
إن وقع مكروه، فينبغي أن تهرب

156
00:11:08,580 --> 00:11:09,730
عُلِم

157
00:11:09,730 --> 00:11:11,500
سأبذل قصارى جهدي

158
00:11:12,300 --> 00:11:13,310
حسناً

159
00:11:17,810 --> 00:11:19,930
ما وراء هذا يوجد العالم الآخر

160
00:11:19,930 --> 00:11:21,810
!سنشقُّ طريقاً للدّخول

161
00:11:21,810 --> 00:11:23,370
!أجل

162
00:11:32,600 --> 00:11:34,340
!ميناتو، هيّا بنا

163
00:11:34,340 --> 00:11:35,800
!حسناً

164
00:11:44,120 --> 00:11:45,480
إنّه هناك في الدّاخل

165
00:11:46,100 --> 00:11:48,380
هناك يتواجد الجاني الرّئيسيّ

166
00:11:50,010 --> 00:11:51,520
لا شكّ في ذلك

167
00:11:51,520 --> 00:11:52,420
هيّا بنا

168
00:11:54,360 --> 00:11:55,460
ما هذا؟

169
00:11:57,690 --> 00:11:58,510
ماذا؟

170
00:12:21,890 --> 00:12:23,850
!جميعكم! ابقوا خلفي

171
00:12:30,730 --> 00:12:33,860
هل هذه... دُمى؟

172
00:12:34,180 --> 00:12:35,160
!المزيد قادمون

173
00:12:35,160 --> 00:12:35,730
ماذا؟

174
00:12:38,020 --> 00:12:40,600
لندعم ميناتو! هل أنتما جاهزان؟

175
00:12:40,600 --> 00:12:41,280
!أجل

176
00:12:41,280 --> 00:12:42,450
!أنا جاهز تماماً

177
00:12:42,700 --> 00:12:46,120
!خذي هذه

178
00:12:43,660 --> 00:12:44,860
!وهذه

179
00:12:48,060 --> 00:12:50,030
ما رأيكما بذلك؟

180
00:12:50,030 --> 00:12:50,850
!أوتسوغي

181
00:12:50,850 --> 00:12:51,790
!لا ترخِ دِفاعك

182
00:12:53,750 --> 00:12:55,030
ماذا؟

183
00:13:00,660 --> 00:13:01,510
!أوتسوغي

184
00:13:10,890 --> 00:13:12,170
بئس الأمر

185
00:13:12,170 --> 00:13:14,050
قلنا لك ألّا تُرخي دفاعك

186
00:13:15,700 --> 00:13:17,240
هل الجميع بخير؟

187
00:13:17,240 --> 00:13:18,310
أجل

188
00:13:30,810 --> 00:13:32,170
ما هذا؟

189
00:13:32,170 --> 00:13:36,000
!مقدار الدّنَس غير عاديّ

190
00:13:36,000 --> 00:13:38,220
أهذه هي السّبب الرّئيسيّ وراء كلّ ذلك؟

191
00:13:42,430 --> 00:13:44,400
!إنّها غاضبة جدّاً

192
00:13:44,400 --> 00:13:45,770
!تبّاً، هذا صاخب جدّاً

193
00:13:45,770 --> 00:13:47,590
!لنُنجز هذا العمل بسرعة ونعُد إلى المنزل

194
00:13:47,590 --> 00:13:49,970
!وإلّا نفدت كمّية فطائر التفّاح

195
00:13:49,970 --> 00:13:50,890
!أجل

196
00:14:12,010 --> 00:14:13,210
!أنتم

197
00:14:15,090 --> 00:14:17,420
!ميناتو! احذر

198
00:14:19,890 --> 00:14:21,380
!ميناتو

199
00:14:31,200 --> 00:14:32,980
على هذا المُعدّل، سيُقضى عليّ

200
00:14:34,080 --> 00:14:35,190
!...ياماغامي

201
00:14:42,410 --> 00:14:44,380
!ميناتو، ميناتو

202
00:14:44,380 --> 00:14:45,800
!تمالك نفسك

203
00:14:47,500 --> 00:14:49,240
!نحن هنا لأجلك

204
00:15:16,650 --> 00:15:18,260
!هل أنت بخير يا ميناتو؟

205
00:15:18,260 --> 00:15:19,980
أجل، بالكاد

206
00:15:20,360 --> 00:15:22,030
أين الدُّمية؟

207
00:15:27,960 --> 00:15:29,450
لا بُدّ أنّ ذلك كان صعباً

208
00:15:40,120 --> 00:15:43,160
تحرّرتْ أخيراً من الدّنَس

209
00:15:44,730 --> 00:15:47,370
هل كان ذلك عِواء ياماغامي قبل قليل؟

210
00:15:47,370 --> 00:15:48,830
هذا صحيح

211
00:15:48,830 --> 00:15:51,500
أرسلَ لنا القوّة عن بُعد

212
00:15:51,500 --> 00:15:53,140
!رائع، أليس كذلك؟

213
00:15:55,300 --> 00:15:57,310
لم يتمّ طرد كلّ شيء بعد

214
00:16:06,370 --> 00:16:10,370
هذا... سبب كلّ شيء؟

215
00:16:10,370 --> 00:16:12,120
إله جبل سابق

216
00:16:12,370 --> 00:16:14,060
يبدو أنّه يتألّم

217
00:16:14,060 --> 00:16:16,650
يُنجَز الأمر حالما تُطهّر هذا

218
00:16:16,650 --> 00:16:18,750
سأُساعدك الآن

219
00:16:22,760 --> 00:16:24,500
نفدت المُذكّرات لديّ

220
00:16:25,380 --> 00:16:27,260
!لا... لم أنتهِ بعد

221
00:16:35,580 --> 00:16:36,660
!تمّ الأمر

222
00:16:49,940 --> 00:16:51,620
!لا أستطيع طرده؟

223
00:16:51,620 --> 00:16:53,480
هل من شيء آخر يمكنك الكتابة عليه؟

224
00:16:54,050 --> 00:16:55,430
...لنرَ

225
00:16:57,050 --> 00:16:59,220
!بدأ العالم الآخر يتحطّم

226
00:16:59,960 --> 00:17:01,920
!ميناتو، بسرعة

227
00:17:06,820 --> 00:17:09,720
!أوراق الشّجر! لديك أوراق شجر

228
00:17:09,720 --> 00:17:10,600
ماذا

229
00:17:11,050 --> 00:17:12,280
هل هذه...

230
00:17:12,280 --> 00:17:13,850
أوراق من شجرة كوسونوكي

231
00:17:16,320 --> 00:17:18,960
فهمت! تلك الشّجرة هي شجرة مُقدّسة

232
00:17:18,960 --> 00:17:20,740
!إذاً لا بُدّ أنّ أوراقها تتمتّع بقوّة

233
00:17:20,740 --> 00:17:23,000
!والآن يمكنك طردها للأبد

234
00:17:23,000 --> 00:17:24,580
ميناتو، هل تستطيع الكتابة؟

235
00:17:24,580 --> 00:17:25,480
!سأجرّب ذلك

236
00:17:28,020 --> 00:17:29,720
أنا على وشك الانهيار

237
00:17:29,720 --> 00:17:32,200
دوّنتُ الكثير بالفعل

238
00:17:33,050 --> 00:17:35,700
!لكن سأكمل هذا حتّى النّهاية

239
00:17:36,940 --> 00:17:38,410
!حسناً، لنُجرّب هذا

240
00:17:52,340 --> 00:17:53,680
هل هذا...؟

241
00:17:55,210 --> 00:17:56,720
!الوقت يُداهمنا

242
00:17:56,940 --> 00:17:58,060
!لنهرب

243
00:18:03,360 --> 00:18:05,270
!ما زال ميناتو كوسونوكي في الدّاخل

244
00:18:06,690 --> 00:18:09,100
سيتمّ امتصاصنا أيضاً

245
00:18:09,100 --> 00:18:10,510
!لا تفعلها يا هاريما

246
00:18:18,900 --> 00:18:22,320
على هذا المُعدّل، سنختفي
!مع هذا العالم الآخر

247
00:18:22,320 --> 00:18:23,160
!ماذا؟

248
00:18:23,160 --> 00:18:25,550
!بسرعة

249
00:18:26,680 --> 00:18:28,590
!المخرج هناك

250
00:18:58,960 --> 00:19:00,940
خرجنا من العالم الآخر

251
00:19:00,940 --> 00:19:02,450
!فعلناها

252
00:19:02,450 --> 00:19:04,290
لكن كيف؟

253
00:19:04,290 --> 00:19:07,080
بئساً، أنت تتطلّب الكثير من الرّعاية حقّاً

254
00:19:08,420 --> 00:19:10,560
!فوجين! رايجين

255
00:19:10,560 --> 00:19:12,090
أخبرتُك، أليس كذلك؟

256
00:19:12,090 --> 00:19:16,450
ستكون قويّاً بما يكفي لتقطيع منزل
شخص لا يروقك إلى نصفين

257
00:19:16,450 --> 00:19:20,050
أجل... لا أملك عذراً

258
00:19:20,340 --> 00:19:22,580
ما زال الطّريق أمامك طويلاً

259
00:19:25,900 --> 00:19:28,980
أنا مَدين لك بالكثير هذه المرّة

260
00:19:28,980 --> 00:19:29,880
أشكرك

261
00:19:29,880 --> 00:19:32,860
لا. يسرّني أن أكون مُفيداً

262
00:19:33,080 --> 00:19:35,240
من فضلك بلّغ الآلهة امتناني كذلك

263
00:19:35,240 --> 00:19:37,770
شكراً على لطفك كالمعتاد

264
00:19:37,770 --> 00:19:41,290
بالمُناسبة، هل ترغب في الشّواء معنا؟

265
00:19:41,290 --> 00:19:45,000
في الواقع، أنا على عجلةٍ
من أمري، لذا أرفُض

266
00:19:55,250 --> 00:19:59,040
مع الفطائر، معجون الفاصولياء النّاعم
هو الأوّل بلا مُنازع

267
00:19:59,040 --> 00:20:03,640
!يا جماعة! قدّم السّيّد هاريما لنا حلويّات

268
00:20:05,730 --> 00:20:07,960
!مرحى! ميناتو، إليّ بالمزيد

269
00:20:07,960 --> 00:20:10,600
أوتسوغي، أكمل طعامَك أوّلاً

270
00:20:10,600 --> 00:20:13,170
ميناتو، أنت تحرق اللّحم

271
00:20:13,170 --> 00:20:14,570
!ماذا؟! بئساً

272
00:20:18,720 --> 00:20:20,760
هذا حارّ، لكنّه لطيف

273
00:20:20,760 --> 00:20:23,200
لا يسعني سوى أن أغمر نفسي
لفترة أطول ممّا ينبغي

274
00:20:24,860 --> 00:20:26,620
هل تريدان بعض السّاكي البارد؟

275
00:20:28,280 --> 00:20:30,580
حسنٌ إن كنتَ مُصرّاً

276
00:20:33,640 --> 00:20:34,800
استمتعا

277
00:20:35,140 --> 00:20:36,210
ماذا؟

278
00:20:37,140 --> 00:20:38,590
!كيرين

279
00:20:39,220 --> 00:20:41,770
كيرين، لديّ بيرة

280
00:20:41,770 --> 00:20:43,180
ألن تنضمّ لنا؟

281
00:20:43,500 --> 00:20:45,030
ماذا؟ بيرة؟

282
00:20:54,820 --> 00:20:56,290
!أظنّني أخبرتُك

283
00:20:56,290 --> 00:20:59,280
!لا تُحضر قُمامة إلى داخل الحديقة المُقدّسة

284
00:20:59,280 --> 00:21:00,940
!وأنا أخبرتُك بأنّ هذه ليست قُمامة

285
00:21:00,940 --> 00:21:04,080
!هذه دوريان! فاكهة مُعتبَرة

286
00:21:04,800 --> 00:21:05,880
إنّها كريهة جدّاً

287
00:21:05,880 --> 00:21:08,410
!لا بُدّ أنّ أنفك لا يعمل بصورة صحيحة

288
00:21:08,410 --> 00:21:10,710
!ماذا؟ يا للوقاحة

289
00:21:12,000 --> 00:21:14,550
!لا أستطيع تحمُّل هذه الرّائحة الكريهة

290
00:21:16,090 --> 00:21:19,550
!رائحة القُمامة الكريهة عالقة في مخالبي

291
00:21:19,800 --> 00:21:21,920
!قلتُ لك ليست قُمامة

292
00:21:21,920 --> 00:21:23,930
لن يتوقّع أحدٌ بأن يكون شيء
كهذا قابلاً للأكل

293
00:21:23,930 --> 00:21:24,510
!أتّفق

294
00:21:24,510 --> 00:21:26,670
!قلتُ بأنّها فاكهة

295
00:21:25,450 --> 00:21:28,120
شكراً لكِ يا شجرة كوسونوكي

296
00:21:28,120 --> 00:21:30,060
!ميناتو، انظر

297
00:21:31,800 --> 00:21:33,480
الحجر الكريم يتغيّر

298
00:21:36,760 --> 00:21:38,310
صوص؟

299
00:21:38,310 --> 00:21:41,990
آخر الأرواح الأربعة، هوو

300
00:21:43,490 --> 00:21:45,740
...ظـ-ظريف

301
00:21:45,740 --> 00:21:49,880
هوو من كان ممسوساً بواسطة الرُّوح الشّرّيرة

302
00:21:49,880 --> 00:21:51,960
يسرّني أنّنا تمكنّا من مُساعدتك

303
00:21:51,960 --> 00:21:55,480
هوو، أهلاً بكم في بناء كوسونوكي

304
00:23:31,680 --> 00:23:36,270
الحلقة 5، "أرض الإلَهة المُقدّسة
"وقوّة ختم الأشياء