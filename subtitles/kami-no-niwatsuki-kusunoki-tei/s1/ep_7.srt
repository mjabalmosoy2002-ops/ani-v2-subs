1
00:00:08,510 --> 00:00:10,470
...أوّل مرّة رأيتُها كان

2
00:00:13,470 --> 00:00:14,630
هل هذا...؟

3
00:00:17,870 --> 00:00:19,730
كان ذلك عندما كنتُ في الخامسة

4
00:00:23,510 --> 00:00:26,210
!جدّي! جدّي

5
00:00:26,210 --> 00:00:27,370
!انظر، انظر

6
00:00:27,370 --> 00:00:30,570
!أعطتني واراشي-سان هذا النّفل رُباعي الأوراق

7
00:00:31,970 --> 00:00:34,770
أصبحت صديقاً لواراشي-سان

8
00:00:34,770 --> 00:00:35,710
!أجل

9
00:00:35,710 --> 00:00:40,070
تقول واراشي-سان بأنّ هذا
مُقابل الأطعمة الخفيفة

10
00:00:40,070 --> 00:00:40,930
ماذا؟

11
00:00:40,930 --> 00:00:46,930
كانت واراشي-سان يوكاي يعيش
في المنزل حتّى قبل ولادة جدّي

12
00:00:46,930 --> 00:00:48,440
لنأكل معاً

13
00:00:48,440 --> 00:00:49,880
واراشي-سان

14
00:02:26,250 --> 00:02:28,960
!قفزة! قفزة

15
00:02:29,230 --> 00:02:30,920
!قفزة، قفزة

16
00:02:31,800 --> 00:02:34,880
واراشي-سان، جرّبي ما فعلتُه للتو

17
00:02:35,270 --> 00:02:36,100
!حسناً

18
00:02:37,210 --> 00:02:40,150
قفزة، قفزة

19
00:02:40,610 --> 00:02:43,000
!قفزة، قفزة

20
00:02:43,330 --> 00:02:45,270
!أحسنت صنعاً

21
00:02:45,270 --> 00:02:46,390
!حقّاً؟

22
00:02:46,940 --> 00:02:49,160
واراشي-سان، لديّ شيء لطيف لكِ

23
00:02:49,160 --> 00:02:50,480
ما هو؟

24
00:02:50,480 --> 00:02:55,450
كان جدّي يستطيع رؤية الكثير
من اليوكاي الّذين لا أستطيع رؤيتهم

25
00:02:55,820 --> 00:02:56,400
ماذا؟

26
00:02:59,860 --> 00:03:03,070
!نوي! إذا سبّبت المتاعب، فسأطردك

27
00:03:03,810 --> 00:03:05,270
يا إلهي

28
00:03:07,490 --> 00:03:11,450
واراشي-سان، ويفر الموناكا هذا
كبير حقّاً، لذا لنتقاسمه

29
00:03:11,450 --> 00:03:12,660
شكراً لك

30
00:03:13,980 --> 00:03:18,670
ميناتو. إنّه يعتاد على التصرُّف كأخ كبير

31
00:03:26,220 --> 00:03:27,510
!عُدت

32
00:03:31,410 --> 00:03:32,440
...هذا الصّوت

33
00:03:33,020 --> 00:03:35,150
!عرفتُ بأنّك أنت

34
00:03:35,150 --> 00:03:38,340
!هيهي! أعد قُبّعتي

35
00:03:41,630 --> 00:03:42,730
—شكراً لـ

36
00:03:46,980 --> 00:03:48,410
!جدّي

37
00:03:48,410 --> 00:03:50,490
!اسمع يا جدّي

38
00:03:50,490 --> 00:03:52,890
!هيهي يُعاملني بقسوة

39
00:03:53,450 --> 00:03:55,580
إنّه ضجران تماماً

40
00:03:55,580 --> 00:03:58,130
لذا يلعب معك للتّسلية

41
00:03:58,480 --> 00:04:02,840
!ماذا؟! هذا لا يعني أن يُعاملني بقسوة

42
00:04:03,140 --> 00:04:06,800
سواء انسجمت معه أو لا هو أمر عائد لك

43
00:04:15,910 --> 00:04:16,940
حسناً

44
00:04:23,860 --> 00:04:24,920
!هيهي

45
00:04:25,470 --> 00:04:28,240
!أعد! لي! قُبّعتي

46
00:04:31,510 --> 00:04:34,450
عِدني بألّا تستخدم الحِيَل معي بعد الآن

47
00:04:34,450 --> 00:04:37,500
حينها سأعطيك هذه الكاستيلّا

48
00:04:38,190 --> 00:04:40,040
تحبّ الكاستيلّا، أليس كذلك؟

49
00:04:40,040 --> 00:04:43,060
رأيتُك تأخذ بعضاً من مذبح المنزل

50
00:04:44,070 --> 00:04:45,980
أعِد إليّ قُبّعتي أوّلاً

51
00:04:45,980 --> 00:04:47,220
وإلّا فلن تحصل على هذا

52
00:04:57,810 --> 00:04:59,050
بئساً

53
00:05:01,540 --> 00:05:05,150
منذ ذلك الحين، أصبحتُ أنا وهيهي
صديقين حميمين

54
00:05:08,420 --> 00:05:11,500
في النّهاية، تُوفِّي جدّي

55
00:05:14,770 --> 00:05:18,220
وذات يوم، عندما كنتُ في الصّفّ
...الخامس في المدرسة الابتدائيّة

56
00:05:19,950 --> 00:05:23,050
!يا للحرّ

57
00:05:23,380 --> 00:05:27,620
رانمارو، القول بأنّ الطّقس حارّ
يزيد الأمر سوءاً

58
00:05:27,620 --> 00:05:30,550
!لكنّه كذلك، ما باليد حيلة

59
00:05:31,060 --> 00:05:34,030
إذاً لنُفكّر في أمور تُشعرنا بالبرودة

60
00:05:34,030 --> 00:05:35,270
مثل ماذا؟

61
00:05:35,510 --> 00:05:38,850
طعامي الخفيف لليوم هو ثلج مبشور

62
00:05:38,850 --> 00:05:40,760
!أحسدك

63
00:05:40,760 --> 00:05:44,530
!أمزح فحسب! لديّ آيس كريم في المنزل

64
00:05:44,530 --> 00:05:45,490
مُذهل

65
00:05:48,390 --> 00:05:52,510
!هذا لا يُشعرنا بالبرودة إطلاقاً

66
00:06:12,440 --> 00:06:14,310
أصغِ جيّداً يا ميناتو

67
00:06:14,310 --> 00:06:18,770
،عندما تلتقي بيوكاي في الخارج
فاهرب قبل أن يُلاحظك

68
00:06:19,410 --> 00:06:22,230
ليس كلّ اليوكاي ودودين، فهمت؟

69
00:06:27,410 --> 00:06:29,780
!ر-رانمارو، لنذهب حالاً

70
00:06:30,300 --> 00:06:31,980
ما خطبك فجأة؟

71
00:06:33,330 --> 00:06:34,530
!ثـ-ثلج مبشور

72
00:06:34,530 --> 00:06:36,950
أجل، أريد تناول ثلجي المبشور حالاً

73
00:06:36,950 --> 00:06:39,380
!لذا لنذهب! اركض

74
00:06:39,380 --> 00:06:42,080
أتمزح معي؟ لا أستطيع الرّكض في هذا الحرّ

75
00:06:42,080 --> 00:06:44,550
!هيّا، إنّه ليس ببعيد

76
00:06:45,190 --> 00:06:47,460
!هذا سيّئ! لنذهب إلى المنزل

77
00:06:53,350 --> 00:06:54,980
يا صبيّان

78
00:06:56,280 --> 00:07:00,770
،إذا ظللتُما تلعبان تحت الشّمس الحارقة
فستُعانيان من ضربة حرّ

79
00:07:01,200 --> 00:07:02,750
حـ-حسناً

80
00:07:04,330 --> 00:07:05,660
اختفى؟

81
00:07:06,360 --> 00:07:11,540
بالمُناسبة، سمعتُ بوجود بلدة نبع
ساخن في هذه الأرجاء

82
00:07:15,710 --> 00:07:18,410
بلدة نبع ساخن قديمة وجميلة

83
00:07:18,410 --> 00:07:21,180
ألم تحجز غرفة للّيلة بعد؟

84
00:07:21,180 --> 00:07:21,930
لا

85
00:07:21,930 --> 00:07:24,680
إذاً لا بُدّ أنّ حظّك قد نفد

86
00:07:24,680 --> 00:07:26,040
أحقّاً ذلك؟

87
00:07:26,040 --> 00:07:29,790
في العادة الغرف محجوزة بالكامل
في هذه الأرجاء

88
00:07:29,790 --> 00:07:31,090
في هذه الفترة من السّنة؟

89
00:07:31,090 --> 00:07:33,690
إنّها مشهورة جدّاً على مدار العام

90
00:07:33,690 --> 00:07:36,590
!كُلّ نُزُل هنا مُريح ورائع

91
00:07:36,590 --> 00:07:40,060
هكذا إذاً. أبحث عن فُرصة للاستمتاع بذلك

92
00:07:40,900 --> 00:07:44,190
سأزور منزلك وأسأل عمّا إذا
كان هناك ما هو شاغر

93
00:07:44,410 --> 00:07:48,010
ماذا؟ كيف عرفت بأنّ منزلي هو نُزُل؟

94
00:07:48,010 --> 00:07:48,850
هيّا بنا

95
00:07:50,200 --> 00:07:56,450
انتهى المطاف بإقامة السّيّد الغامض في نُزُل
كوسونوكي، الّذي يُديره والدايّ

96
00:07:57,020 --> 00:07:59,410
،كان هناك إلغاء مُفاجئ في ذلك اليوم

97
00:07:59,410 --> 00:08:01,800
ولحسن الحظّ أنّه أُتيحت غرفة

98
00:08:02,370 --> 00:08:05,330
لسبب ما، تصرّفَ اليوكاي بقلق

99
00:08:05,330 --> 00:08:08,750
وابتعد عن الغرفة الّتي أقام فيها هذا السّيّد

100
00:08:18,580 --> 00:08:21,910
بئساً، الواجب المدرسيّ مُزعج للغاية

101
00:08:24,500 --> 00:08:26,060
جميل

102
00:08:26,390 --> 00:08:28,270
خطّ يدك سهل القراءة

103
00:08:28,580 --> 00:08:31,780
ماذا؟ شـ-شكراً لك

104
00:08:32,210 --> 00:08:37,160
وكأنّ قلبك الصّادق والنّقيّ موجود
ضمن هذه الأحرف

105
00:08:37,160 --> 00:08:39,380
قلبي؟

106
00:08:39,750 --> 00:08:42,840
أجل. احرص على تقدير موهبتك

107
00:08:44,780 --> 00:08:45,570
!حسناً

108
00:08:46,820 --> 00:08:52,150
حفرتُ ما قاله لي في قلبي، وكانت
لافتات الاسم ممتازة

109
00:08:54,570 --> 00:08:56,520
،بالتّفكير في الأمر الآن

110
00:08:56,870 --> 00:09:00,760
لا بُدّ أنّه كان يعلم بأنّ خطّ يدي
كان يملك قوّة الإقصاء

111
00:09:00,760 --> 00:09:06,370
كان غالباً ما نُطلِق عليه بطارد الأرواح الرحّال

112
00:09:06,370 --> 00:09:07,590
طارد الأرواح الرحّال؟

113
00:09:07,590 --> 00:09:10,950
بخلاف الأونميوجي، إنّهم أشخاص عاديّون

114
00:09:10,950 --> 00:09:13,740
لكن لا بُدّ أنّه كان يملك قوّة بالغة

115
00:09:13,740 --> 00:09:18,580
فهمت. لهذا ابتعد عنه اليوكاي

116
00:09:18,580 --> 00:09:19,590
صحيح

117
00:09:20,020 --> 00:09:24,500
في سياق آخر، كيف تدريبك لإتقان
قوّة ختم الأشياء؟

118
00:09:24,810 --> 00:09:26,780
نسيت

119
00:09:26,780 --> 00:09:30,380
كنتُ أتمرّن على ختم قوّة الإقصاء
داخل تميمة

120
00:09:30,820 --> 00:09:35,240
في ذكرياتك، كانت هناك لمحة حول ذلك

121
00:09:35,240 --> 00:09:35,900
ماذا؟

122
00:09:36,260 --> 00:09:40,870
طارد الأرواح ذاك... رأى جوهر قوّتك

123
00:09:42,690 --> 00:09:47,560
وكأنّ قلبك الصّادق والنّقيّ موجود
ضمن هذه الأحرف

124
00:09:48,690 --> 00:09:50,350
أظنّني فهمت

125
00:09:51,270 --> 00:09:54,850
قال ياماغامي بأنّ الصّورة مُهمّة، صحيح؟

126
00:09:55,610 --> 00:09:59,890
...التخيُّل بأنّني أختم قلبي داخل هذه التّميمة

127
00:10:04,610 --> 00:10:06,020
هذا جيّد

128
00:10:06,020 --> 00:10:07,620
حقّاً؟

129
00:10:07,620 --> 00:10:09,510
نجحتَ أخيراً

130
00:10:10,060 --> 00:10:11,160
!أجل

131
00:10:33,620 --> 00:10:35,740
!تسوباكي وفوجينو

132
00:10:37,100 --> 00:10:37,880
ما الوضع؟

133
00:10:38,200 --> 00:10:40,770
في الوقت المثاليّ يا أخي العزيز

134
00:10:40,770 --> 00:10:43,740
فعلنا كلّ ما يمكننا فعله بأسلحتنا
وقوّتنا الرّوحانيّة

135
00:10:43,740 --> 00:10:45,710
أعطِنا تمائم اليشم الأوّل

136
00:10:46,190 --> 00:10:47,200
حسناً

137
00:10:47,910 --> 00:10:48,750
استعملا هذه

138
00:10:51,190 --> 00:10:52,420
شكراً لك

139
00:10:52,420 --> 00:10:53,770
!سايغا-ساما

140
00:10:53,770 --> 00:10:55,170
!أعطِنا تمائم أيضاً

141
00:10:55,850 --> 00:10:56,860
!من فضلك

142
00:10:57,940 --> 00:11:00,130
مهلاً، هذا كثير

143
00:11:11,370 --> 00:11:12,610
نجونا

144
00:11:12,610 --> 00:11:14,420
أجل، بالفعل

145
00:11:14,420 --> 00:11:16,820
شكراً لك أيّها اليشم الأوّل

146
00:11:17,160 --> 00:11:19,550
...هؤلاء الفتيات في عائلتك

147
00:11:19,550 --> 00:11:21,470
!بعد انتهاء هذا، سأذهب في رحلة

148
00:11:21,470 --> 00:11:24,300
سأستحمّ حمّاماً طويلاً وأسرف
في مُشاهدة الأفلام

149
00:11:21,470 --> 00:11:25,670
إنّهن جميلات، لكن لسنَ هادئات ومُتحفّظات

150
00:11:24,300 --> 00:11:26,490
احرصي على شرب السّوائل

151
00:11:26,730 --> 00:11:30,640
قبل ذلك، يجب علينا القضاء
على الأرواح الشّرّيرة

152
00:11:30,640 --> 00:11:32,540
سايغا، التّمائم؟

153
00:11:32,540 --> 00:11:33,750
بقيت لديّ واحدة

154
00:11:34,420 --> 00:11:35,750
!اذهب إذاً

155
00:11:36,910 --> 00:11:37,670
!حسناً

156
00:11:39,590 --> 00:11:40,850
!سايغا-ساما

157
00:11:41,470 --> 00:11:44,090
سوف تلتقي باليشم الأوّل؟

158
00:11:44,550 --> 00:11:46,440
أتساءل كيف هو شكله

159
00:11:46,440 --> 00:11:48,600
إنّه رجل، صحيح؟ هل هو وسيم؟

160
00:11:48,600 --> 00:11:50,370
دعنَه وشأنه

161
00:11:50,370 --> 00:11:53,350
أخونا العزيز لا يفهم ما يجعل الرّجل وسيماً

162
00:12:13,420 --> 00:12:15,630
!أجل! إنّه مفتوح

163
00:12:20,760 --> 00:12:22,460
...هذا الضّغط

164
00:12:23,070 --> 00:12:25,750
هل هذا من الكامي المُتعدّدين؟

165
00:12:34,470 --> 00:12:36,120
هل أنت بخير؟

166
00:12:36,120 --> 00:12:37,220
أنا بخير

167
00:12:37,530 --> 00:12:40,500
...بخصوص التّمائم الّتي طلبتُها منك

168
00:12:43,470 --> 00:12:44,270
ما هذا؟

169
00:12:44,690 --> 00:12:48,190
هي الحيوانات الرّوحيّة تهيج غضباً؟

170
00:12:48,190 --> 00:12:50,890
...ماذا؟ لا، هذا فقط

171
00:12:59,100 --> 00:13:00,820
لا تقلق بشأن ذلك رجاء

172
00:13:02,010 --> 00:13:04,680
ولا ردّة فعل حتّى تجاه الحيوانات
الرّوحيّة الهائجة

173
00:13:05,380 --> 00:13:07,220
هذا هو ميناتو كوسونوكي المعهود

174
00:13:08,260 --> 00:13:10,200
تفضّل التّمائم

175
00:13:10,200 --> 00:13:13,930
في الواقع تلقّيتُ قوّةً جديدة قبل أيّام

176
00:13:14,460 --> 00:13:18,790
باستخدامها، ختمتُ قوّةَ الإقصاء داخل التّمائم

177
00:13:18,790 --> 00:13:19,730
هكذا إذاً

178
00:13:19,730 --> 00:13:23,400
القوّة لن تتسرّب، لذا ينبغي أن يدوم
تأثيره لمدّة أطول

179
00:13:23,910 --> 00:13:26,390
عُلِم. أنا مُمتنّ لك

180
00:13:28,780 --> 00:13:30,540
تبدو مُتعباً

181
00:13:30,890 --> 00:13:34,850
حدث تفشٍّ للأرواح الشّرّيرة مُؤخّراً

182
00:13:34,850 --> 00:13:36,040
سوف ندخل

183
00:13:36,260 --> 00:13:39,270
فوجين ورايجين

184
00:13:39,270 --> 00:13:40,950
مضى وقت طويل

185
00:13:41,400 --> 00:13:44,870
بالمُناسبة، يبدو هذا الرّجل مُرهَقاً

186
00:13:44,870 --> 00:13:47,590
بالفعل، أشفق عليه

187
00:13:48,330 --> 00:13:50,000
!وجدتُها

188
00:13:50,000 --> 00:13:52,310
لِمَ لا أمنحه صدمة كهربائيّة؟

189
00:13:52,650 --> 00:13:57,560
سيّد هاريما. يريد رايجين أن يمنحك
صدمة كهربائيّة

190
00:13:57,780 --> 00:13:58,550
ماذا؟

191
00:13:58,550 --> 00:14:00,270
هل أنت جاهز؟

192
00:14:09,340 --> 00:14:10,770
!الطّلب جاهز

193
00:14:12,990 --> 00:14:14,830
!سيّد هاريما؟

194
00:14:14,830 --> 00:14:15,420
ماذا؟

195
00:14:15,420 --> 00:14:17,330
هل كانت قويّة زيادة عن اللّزوم؟

196
00:14:17,650 --> 00:14:20,790
!سيّد هاريما؟ سيّد هاريما

197
00:14:23,060 --> 00:14:26,130
آمل أن يكون السّيّد هاريما بخير

198
00:14:26,380 --> 00:14:29,440
لا تقلق. سندع الباقي عليه

199
00:14:29,440 --> 00:14:30,280
أجل

200
00:14:30,280 --> 00:14:31,220
...المُهمّ

201
00:14:31,570 --> 00:14:35,180
أتطلّع قُدماً لساكورا موتشي الجديدة
من إتشيزين-تي

202
00:14:35,180 --> 00:14:37,890
معك حقّ. لنذهب إلى المنزل بسرعة

203
00:14:39,810 --> 00:14:43,110
ياماغامي، ألا تشعر بغرابة في هذه الأرجاء؟

204
00:14:43,360 --> 00:14:45,360
وكأنّ الهواء ثقيل

205
00:14:47,710 --> 00:14:49,020
!عالم كامي مهجور؟

206
00:14:49,020 --> 00:14:50,210
!مهلاً

207
00:14:59,710 --> 00:15:01,610
!مؤلم

208
00:15:01,610 --> 00:15:03,660
ما مُشكلتي؟

209
00:15:03,660 --> 00:15:05,880
تشتّت انتباهي بواسطة التّفكير
في ساكورا موتشي

210
00:15:07,030 --> 00:15:11,540
هذا هو عالم الكامي لإلَه مُنزَّل، صحيح؟

211
00:15:11,880 --> 00:15:12,900
صحيح

212
00:15:12,900 --> 00:15:16,310
صُنِع بواسطة شخص ليس بتلك القوّة

213
00:15:16,310 --> 00:15:18,750
وأين ذلك الكامي؟

214
00:15:18,750 --> 00:15:19,920
من يدري؟

215
00:15:19,920 --> 00:15:21,870
كيف نخرج؟

216
00:15:22,200 --> 00:15:25,770
مزِّق وافتح الفضاء بقوّة رياحك

217
00:15:26,070 --> 00:15:27,270
دعني أحاول

218
00:15:30,370 --> 00:15:31,370
ما الأمر؟

219
00:15:31,690 --> 00:15:36,010
إذا خرجنا من هنا، فماذا سيحدث
للكامي الّذي صنع هذا؟

220
00:15:36,470 --> 00:15:39,080
إذا تركته مهجوراً، سيتضخّم الدّنس

221
00:15:39,080 --> 00:15:41,960
في نهاية المطاف، سيبدأ بالتّأثير على مُحيطه

222
00:15:43,880 --> 00:15:45,970
لا تستطيع تركه بمُفرده، أليس كذلك؟

223
00:15:45,970 --> 00:15:47,950
أنت ألطف من أن ترفض

224
00:15:47,950 --> 00:15:49,210
رُبّما

225
00:15:49,880 --> 00:15:52,220
لكن هذا هو طبعك

226
00:15:54,520 --> 00:15:56,360
لنبحث عن ذلك الكامي

227
00:16:01,500 --> 00:16:03,940
هل هذا...؟

228
00:16:05,820 --> 00:16:07,890
هل هذا هو الكامي؟

229
00:16:08,420 --> 00:16:10,310
في الأصل، سيف

230
00:16:11,050 --> 00:16:13,580
تقصد إله السّيوف؟

231
00:16:13,580 --> 00:16:18,000
لا، الأشياء الّتي من صنع البشر ليست
مسكناً طبيعيّاً للأرواح القدسيّة

232
00:16:18,000 --> 00:16:22,170
هذه روح قدسيّة نُقِلت إلى داخل
سيف بواسطة البشر

233
00:16:23,340 --> 00:16:25,930
أشعر بضيقٍ في صدري

234
00:16:25,930 --> 00:16:27,250
هل هو غاضب؟

235
00:16:27,250 --> 00:16:28,510
هكذا يبدو

236
00:16:28,510 --> 00:16:31,070
إذاً، ماذا تريد أن تفعل؟ هل نقصيه؟

237
00:16:32,580 --> 00:16:37,000
هذا الكامي غاضب لأنّه لم ينلْ احتراماً، صحيح؟

238
00:16:37,540 --> 00:16:38,870
ما الّذي جعلك تقول ذلك؟

239
00:16:39,410 --> 00:16:41,390
انظر كيف هو صدئ

240
00:16:41,880 --> 00:16:46,090
،فلو كان يحظى بالتّقدير والتّقديس
لما بدا شكله هكذا

241
00:16:46,090 --> 00:16:46,900
أجل

242
00:16:47,490 --> 00:16:49,150
لا أريد إقصاءه

243
00:16:52,360 --> 00:16:55,260
سأحاول تطهيره بالتّميمة الجديدة

244
00:16:59,610 --> 00:17:01,240
!الدّنس رهيب

245
00:17:01,500 --> 00:17:02,530
ممتاز

246
00:17:02,530 --> 00:17:06,680
التّميمة العاديّة كانت لتفقد فعاليّتها الآن

247
00:17:10,850 --> 00:17:13,970
كانت قوّة ختم الأشياء نافعة

248
00:17:14,340 --> 00:17:15,290
بالفعل

249
00:17:15,290 --> 00:17:17,310
يمكنك ترك الباقي لي

250
00:17:17,630 --> 00:17:22,390
،لم أعتنِ بكامي آخر من قبل
لذا لا أحد يعلم ما سيحدث

251
00:17:22,390 --> 00:17:25,000
ماذا؟ هذا لا يجعلني أشعر بالاطمئنان

252
00:17:33,340 --> 00:17:34,550
!أين الكامي؟

253
00:17:34,550 --> 00:17:36,020
أنقذتُه

254
00:17:36,020 --> 00:17:37,690
كلّ شيء على ما يُرام

255
00:17:37,690 --> 00:17:39,110
يسرّني ذلك

256
00:17:46,540 --> 00:17:48,380
سيختفي هذا الفضاء

257
00:17:48,380 --> 00:17:49,230
!ماذا؟

258
00:17:49,230 --> 00:17:51,040
أسرع الآن. استخدم قوّة الرّياح

259
00:17:51,040 --> 00:17:52,420
!حسناً

260
00:17:54,630 --> 00:17:56,170
!أعتمد عليك يا رقم خمسة

261
00:18:01,160 --> 00:18:03,220
حسناً، أحسنت صنعاً

262
00:18:04,920 --> 00:18:07,050
مهلاً، هل شبعت من الآن؟

263
00:18:09,380 --> 00:18:12,520
بئساً! ما الّذي أخّر إتشيجو وهوريكاوا؟

264
00:18:23,190 --> 00:18:24,380
هل أنت بخير؟

265
00:18:24,380 --> 00:18:28,830
هوريكاوا! أنتِ بطيئة جدّاً في إنقاذي
!أيّتها البليدة

266
00:18:29,150 --> 00:18:31,390
—في هذه الأيّام، أنتِ ظريفة

267
00:18:31,390 --> 00:18:33,290
...لا، قصدتُ

268
00:18:33,290 --> 00:18:37,670
أقصد... ز-زدتِ وزناً، لذا لهذا السّبب
!كنتِ بطيئة في الوصول إلى هنا

269
00:18:39,880 --> 00:18:42,970
أنتِ تُعرقلينني أكثر من السّابق

270
00:18:44,890 --> 00:18:46,830
!صوت جرس؟

271
00:18:51,650 --> 00:18:53,800
هذا ينجح كالسّحر

272
00:18:58,660 --> 00:19:00,330
!الطّاقة الرّوحانيّة تنفد لدينا

273
00:19:00,330 --> 00:19:02,260
!وتنفد لدينا التّمائم

274
00:19:02,260 --> 00:19:03,960
...هذا وشيك جدّاً

275
00:19:03,960 --> 00:19:05,290
ماذا نفعل؟

276
00:19:05,600 --> 00:19:07,910
جميعكن، اهدأن

277
00:19:11,620 --> 00:19:13,130
!سايغا-ساما

278
00:19:13,700 --> 00:19:14,780
!أخي العزيز

279
00:19:14,780 --> 00:19:16,230
تفضّلن التّمائم الجديدة

280
00:19:16,230 --> 00:19:19,510
طردتَ الكثير بها، ومع ذلك ما زالت
تحتوي على القوّة؟

281
00:19:19,730 --> 00:19:23,010
إنّها تمائم جديدة خُتِمت بداخلها قوّة الإقصاء

282
00:19:23,010 --> 00:19:24,760
!هذا هو اليشم الأوّل الّذي عهِدناه

283
00:19:24,760 --> 00:19:25,710
!ممتاز

284
00:19:25,710 --> 00:19:28,020
ويحي، ليتني أستطيع اللّقاء به

285
00:19:31,940 --> 00:19:33,580
!نور اليشم؟

286
00:19:33,580 --> 00:19:34,900
هل يُعقَل أن يكون هو؟

287
00:19:35,390 --> 00:19:36,810
ميناتو كوسونوكي

288
00:19:38,520 --> 00:19:40,440
!هـ-هذا مُبهر جدّاً

289
00:19:40,440 --> 00:19:43,180
!لـ-لا أستطيع الرّؤية! عينايّ

290
00:19:43,180 --> 00:19:45,820
!لـ-لا أستطيع رؤية الرّجل نفسه

291
00:19:46,850 --> 00:19:49,540
اليشم الأوّل، نحن مُمتنّون لك

292
00:19:52,480 --> 00:19:55,690
لحظة، هل هذا... سيّد هاريما؟

293
00:19:56,460 --> 00:19:59,160
مُذهل، إنّه مُحاط بنساء حسناوات

294
00:19:59,160 --> 00:20:02,000
هل لديه نساؤه الخاصّة؟

295
00:20:02,000 --> 00:20:03,340
لا بُدّ أنّهن قريباته

296
00:20:03,740 --> 00:20:06,190
بعضهن يصرخن

297
00:20:06,610 --> 00:20:11,450
بالنّسبة لهم، ما تُمسكه بيدك برّاق
لدرجة تُبهر العيون

298
00:20:12,580 --> 00:20:13,320
هيّا بنا

299
00:20:13,320 --> 00:20:14,580
حـ-حسناً

300
00:20:19,110 --> 00:20:20,730
...تلك القُبّعة

301
00:20:24,070 --> 00:20:26,420
لا، لا يمكن أن يكون كذلك

302
00:20:27,780 --> 00:20:29,780
هل ذلك هو ميناتو كوسونوكي؟

303
00:20:29,780 --> 00:20:32,250
من كان يعلم بأنّه بهذه القوّة؟

304
00:20:33,450 --> 00:20:34,400
بئساً

305
00:20:34,400 --> 00:20:37,210
أنت تحبّ قُبّعتك هذه حقّاً

306
00:20:37,210 --> 00:20:41,800
أجل، هذه علامة أبي المُميّزة

307
00:20:42,330 --> 00:20:45,700
...حسبما أذكر، والدك

308
00:20:45,700 --> 00:20:46,950
طارد أرواح

309
00:20:49,310 --> 00:20:50,250
...هل هذا

310
00:20:51,500 --> 00:20:52,500
آنشو؟

311
00:20:53,420 --> 00:20:55,150
ماذا يفعلون هنا؟

312
00:21:01,550 --> 00:21:03,330
ما رأيك يا ياماغامي؟

313
00:21:04,730 --> 00:21:08,610
قوام ونكهة أخّاذتين مُختلفتان
!عن إتشيغو-يا

314
00:21:09,780 --> 00:21:11,640
هذا جيّد

315
00:21:12,900 --> 00:21:15,580
!أخيراً عدت إلى طبيعتك

316
00:21:15,580 --> 00:21:17,780
أجل

317
00:21:22,530 --> 00:21:23,250
ماذا؟

318
00:21:23,630 --> 00:21:25,380
ما هذا؟

319
00:21:25,640 --> 00:21:28,220
الرّوح القدسيّة الّتي كانت في السّيف

320
00:21:28,220 --> 00:21:29,690
أحضرتَها إلى المنزل

321
00:21:30,180 --> 00:21:32,270
وضعتُها داخل مُضيف

322
00:21:32,620 --> 00:21:35,100
وذلك كي أجعلها تابعي الخاصّ

323
00:21:35,320 --> 00:21:36,650
هكذا إذاً

324
00:21:36,650 --> 00:21:38,190
لكنّها لا تتحرّك

325
00:21:38,190 --> 00:21:39,760
هل نفدت طاقتها؟

326
00:21:39,760 --> 00:21:41,800
تقول بأنّها تريد الرّاحة

327
00:21:42,110 --> 00:21:43,950
ينبغي أن تتعافى قريباً

328
00:21:44,280 --> 00:21:45,510
حسناً

329
00:21:45,510 --> 00:21:47,070
تذكّرت

330
00:21:53,890 --> 00:21:57,040
تعافي بسرعة رجاء

331
00:23:31,400 --> 00:23:36,660
"الحلقة 8، "اتّصال قديم بالجبل المُجاور