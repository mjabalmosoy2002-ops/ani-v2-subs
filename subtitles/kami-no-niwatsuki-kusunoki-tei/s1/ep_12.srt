1
00:00:09,630 --> 00:00:10,840
!ياماغامي

2
00:00:19,000 --> 00:00:21,200
!ياماغامي! لا تضغط على نفسك

3
00:00:31,890 --> 00:00:33,730
!يـ-ياماغامي

4
00:00:35,590 --> 00:00:36,840
أيُّها الأحمق

5
00:00:39,390 --> 00:00:40,770
!تينكو؟

6
00:00:41,430 --> 00:00:42,730
ماذا تريدين؟

7
00:00:42,970 --> 00:00:44,340
ألم أُخبرك؟

8
00:00:44,340 --> 00:00:48,440
،إذا تفاعلتَ كثيراً مع البشر
فسيؤدّي ذلك إلى تدميرك

9
00:00:48,860 --> 00:00:51,760
اختياري مَن أريد استخدام
قوّتي عليه هو شأني أنا

10
00:00:51,760 --> 00:00:54,150
لا يحقّ لكِ أن تُخبريني بما يجب فعله

11
00:00:54,450 --> 00:00:59,470
الكثير من البشر في هذه البلدة
لا يؤمنون بوجودك

12
00:01:00,420 --> 00:01:04,290
،بعد أن نسوا أصل هذا المهرجان
أصبحوا يمرحون ببساطة

13
00:01:04,910 --> 00:01:06,500
هذا ليس كُلّ شيء

14
00:01:06,500 --> 00:01:09,460
هناك أولئك الّذين التُهِموا بواسطة الكارما
الّذين يتصرّفون بدافع ذاتيّ

15
00:01:09,460 --> 00:01:12,960
مجموعة فاسدة حقّاً أسوأ
من الأرواح الشّرّيرة

16
00:01:13,450 --> 00:01:16,930
أتقصد استخدام قوّتك لأجل
آفات مثلهم؟

17
00:01:17,630 --> 00:01:20,490
نصيحتي الأخيرة لك: استدر

18
00:01:22,420 --> 00:01:23,850
!ياماغامي

19
00:01:24,240 --> 00:01:25,210
تينكو

20
00:01:25,590 --> 00:01:28,310
الحلويّات الّتي يصنعها البشر شهيّة جدّاً

21
00:01:28,700 --> 00:01:30,020
!ياماغامي

22
00:01:45,620 --> 00:01:47,620
ما-ماذا كان ذلك للتو؟

23
00:01:53,890 --> 00:01:55,740
أزلتُ البوّابةَ المُؤدّية إلى عالم الكامي

24
00:01:55,740 --> 00:01:57,650
!فعلتَها يا ياماغامي

25
00:01:57,650 --> 00:02:00,160
لا، من المُبكّر جدّاً على إرخاء دفاعك

26
00:02:00,160 --> 00:02:01,010
ماذا؟

27
00:02:11,540 --> 00:02:12,510
ما هذا؟

28
00:02:12,870 --> 00:02:15,230
الرُّوح الشّرّيرة الّتي هي
السّبب الأصليّ لكلّ هذا

29
00:02:15,230 --> 00:02:17,240
ظننتُ بأنّك قد طردتها

30
00:02:17,240 --> 00:02:20,650
لا، ذلك الشّيء الّذي تجلّى في هذا
العالم قُبيل البوّابة المُؤدّية

31
00:02:20,650 --> 00:02:22,780
إلى عالم الكامي اختفى

32
00:02:22,780 --> 00:02:25,150
هذا هو السّبب الأصليّ؟

33
00:02:27,560 --> 00:02:31,510
ميناتو، لم أعد قادراً على استخدام
قوّة الإزالة

34
00:02:31,510 --> 00:02:32,250
ماذا؟

35
00:02:32,810 --> 00:02:36,070
يجب أن تطرد تلك الرُّوح الشّرّيرة
بقوّتك الخاصّة

36
00:02:46,660 --> 00:02:48,600
لكن هناك الكثير. كيف لي أن...؟

37
00:02:49,060 --> 00:02:50,110
لا تتردّد

38
00:02:50,110 --> 00:02:52,570
لديك قوّة الإزالة، أنسيت؟

39
00:02:53,730 --> 00:02:54,560
إنّهم قادمون

40
00:03:01,380 --> 00:03:04,010
...هذا صحيح. آنذاك

41
00:03:14,120 --> 00:03:15,100
!سيّد هاريما؟

42
00:03:15,700 --> 00:03:18,780
تمائمك موجودة دوماً لإنقاذي

43
00:03:19,220 --> 00:03:21,180
الآن، حان دوري لمُساعدتك

44
00:03:27,400 --> 00:03:28,440
!جدّي

45
00:03:28,440 --> 00:03:29,670
ما-ما هذا؟

46
00:03:29,670 --> 00:03:31,310
...فجأة، لا أستطيع التنفُّس

47
00:03:31,640 --> 00:03:35,020
لـ-لا أستطيع تحريك جسدي

48
00:03:36,540 --> 00:03:37,780
تمالك نفسك

49
00:03:38,200 --> 00:03:42,030
النّاس في البلدة يُعانون
بسبب الهواء المُلوَّث

50
00:03:42,030 --> 00:03:43,990
بسبب هذه الرُّوح الشّرّيرة؟

51
00:03:44,660 --> 00:03:49,450
في الوضع الرّاهن، سيصبح ياماغامي
قريباً عاجزاً عن الحِفاظ على شكله

52
00:03:49,450 --> 00:03:53,830
ماذا؟ هل تقصدين بأنّني لن أتمكّن
من رؤية ياماغامي بعد الآن؟

53
00:03:55,080 --> 00:03:56,190
...ياماغامي

54
00:03:58,470 --> 00:04:00,050
!سأنقذك مهما كلّف الأمر

55
00:04:01,150 --> 00:04:04,050
أجل. توخّ أقصى درجات الحذر

56
00:04:09,550 --> 00:04:12,270
أنا آسف. إنّني مُرهَق تماماً

57
00:04:12,270 --> 00:04:13,520
!سيّد هاريما

58
00:04:14,020 --> 00:04:17,550
صحيح، كافّة تمائمي قد بُدِّدَتْ

59
00:04:17,550 --> 00:04:19,580
!ماذا؟ بُدِّدَتْ؟

60
00:04:19,580 --> 00:04:21,080
أنا آسف

61
00:04:21,080 --> 00:04:22,150
!يا للعجب

62
00:04:25,530 --> 00:04:26,460
!ماذا؟

63
00:04:27,730 --> 00:04:30,090
!هذه... تمائم

64
00:04:30,400 --> 00:04:31,810
عجبتُ لأمرك

65
00:04:32,720 --> 00:04:34,690
!كم أنت مُتعِب

66
00:04:34,690 --> 00:04:36,910
!شكراً لك يا فوجين

67
00:04:36,910 --> 00:04:39,870
يمكنك أن تشكر أرواح الرّياح

68
00:04:39,870 --> 00:04:40,550
ماذا؟

69
00:04:43,490 --> 00:04:46,230
!بالتّوفيق! بالتّوفيق

70
00:04:45,550 --> 00:04:48,600
أنتم... شكراً لكم

71
00:04:46,600 --> 00:04:48,010
!بالتّوفيق

72
00:04:50,310 --> 00:04:51,520
!سيّد هاريما

73
00:04:57,810 --> 00:04:58,840
سيّد هاريما

74
00:04:58,840 --> 00:04:59,720
خذ هذه

75
00:05:01,130 --> 00:05:02,400
أنقذتني

76
00:05:02,730 --> 00:05:05,860
سنتولّى أمر الأرواح الشّرّيرة في البلدة

77
00:05:05,860 --> 00:05:10,080
ميناتو كوسونوكي، هل يمكنك تولّي
السّبب الرّئيسيّ بقوّتك؟

78
00:05:10,080 --> 00:05:10,950
ماذا؟

79
00:05:10,950 --> 00:05:14,160
أتريدني أن أتولّى ذلك؟ لكن كيف؟

80
00:05:14,700 --> 00:05:18,810
حسناً، إذا استطعتُ قذف تميمتي نحوها
...بقوّة الرّياح

81
00:05:19,350 --> 00:05:22,980
أجل. حان الوقت لتُظهِر ما تستطيع
قِوى الرّياح خاصّتك فعله

82
00:05:22,980 --> 00:05:25,350
حسناً، دعني أُجرّب

83
00:05:25,350 --> 00:05:27,360
!أشكرك. أعتمد عليك

84
00:05:28,390 --> 00:05:32,280
هذه فُرصتك لتُثبت ما تستطيع فعله
قوّةُ الرّياح الّتي منحتُك إيّاها

85
00:05:32,280 --> 00:05:33,930
لا تُخطئ، اتّفقنا؟

86
00:05:46,740 --> 00:05:47,990
تصدّى لي؟

87
00:05:50,740 --> 00:05:53,790
على هذا المُعدّل، لن تصل
إلى الرُّوح الشّرّيرة

88
00:05:53,790 --> 00:05:55,220
ماذا يجدر بي أن أفعل؟

89
00:05:57,880 --> 00:05:59,170
ما الّذي يمكنني...؟

90
00:05:59,170 --> 00:06:00,820
ميناتو، ها هو قادم

91
00:06:00,820 --> 00:06:01,170
ماذا؟

92
00:06:09,180 --> 00:06:10,650
...إن لم أفعل شيئاً

93
00:06:15,770 --> 00:06:16,950
!وجدتُها

94
00:06:18,800 --> 00:06:21,110
يبدو أنّه لمعتْ في ذهنه فكرة

95
00:06:27,780 --> 00:06:30,740
إنّ تدويرها سيُعزّز سرعة الرّياح

96
00:06:30,740 --> 00:06:33,630
بالفعل. كتدوير لولب

97
00:06:33,630 --> 00:06:34,700
تفكير ممتاز

98
00:06:41,380 --> 00:06:44,240
ردع الدّنَس بقوّة الرّياح

99
00:06:44,240 --> 00:06:45,250
!أحسنت صنعاً

100
00:06:52,980 --> 00:06:54,380
ماذا تفعل؟

101
00:06:55,530 --> 00:06:59,490
أعلنتَ بأنّك ستُنقذ ياماغامي، أليس كذلك؟

102
00:06:59,490 --> 00:07:01,230
!شكراً لكِ يا تينكو

103
00:07:29,580 --> 00:07:30,790
فعلَها حقّاً

104
00:07:31,690 --> 00:07:32,870
اليشم الأوّل

105
00:07:33,230 --> 00:07:34,800
نحن مُمتنّون لك

106
00:08:00,900 --> 00:08:02,480
انتهى الأمر

107
00:08:02,480 --> 00:08:04,080
عمل ممتاز

108
00:08:04,080 --> 00:08:05,770
شكراً جزيلاً لك

109
00:08:10,410 --> 00:08:11,530
مرحباً؟

110
00:08:11,530 --> 00:08:12,860
!ميناتو كوسونوكي

111
00:08:12,860 --> 00:08:13,640
!هل أنت بخير؟

112
00:08:14,000 --> 00:08:15,670
سيّد هاريما

113
00:08:16,000 --> 00:08:17,360
تدبّرتُ أمري

114
00:08:17,970 --> 00:08:20,360
الأهمّ، ماذا عن الأشخاص في البلدة؟

115
00:08:20,360 --> 00:08:22,640
...إنّهم

116
00:08:22,940 --> 00:08:25,040
جدّي، هل تشعر بتحسُّن؟

117
00:08:25,040 --> 00:08:28,770
أجل! والآن لنُسرع في التّحضير
!للكلب المُقدّس

118
00:08:28,770 --> 00:08:29,610
!أجل

119
00:08:29,610 --> 00:08:31,880
ماذا كان ذلك؟

120
00:08:31,880 --> 00:08:34,030
حضرة الرّئيس، تمالك نفسك لو سمحت

121
00:08:34,030 --> 00:08:35,680
مهرجان هوجو غداً

122
00:08:35,680 --> 00:08:37,420
!أجل، هذا صحيح

123
00:08:37,420 --> 00:08:39,830
!سنفعلها لأجل ياماغامي

124
00:08:40,320 --> 00:08:42,350
رحلت الأرواح الشّرّيرة عن البلدة

125
00:08:42,350 --> 00:08:44,270
شكراً لك على عملك الدّؤوب

126
00:08:44,270 --> 00:08:47,540
أنا من يشكرك على كلّ ما فعلتَه

127
00:08:50,090 --> 00:08:51,240
أنا مسرور

128
00:08:54,940 --> 00:08:57,630
!ياماغامي. عدتَ إلى طبيعتك

129
00:08:57,630 --> 00:08:59,220
كما ترى

130
00:08:59,220 --> 00:09:00,900
هل كلّ شيء على ما يُرام معك؟

131
00:09:00,900 --> 00:09:02,300
بالطّبع

132
00:09:02,790 --> 00:09:04,940
فأنا إله جبل

133
00:09:04,940 --> 00:09:09,150
أماني النّاس في البلدة استرجعَتْك

134
00:09:09,510 --> 00:09:10,590
أجل

135
00:09:13,480 --> 00:09:16,800
!أ-أنت برّاقٌ جدّاً يا ياماغامي

136
00:09:16,800 --> 00:09:18,520
من فضلك خفّف سطوعك قليلاً

137
00:09:22,140 --> 00:09:25,490
تينكو! شكراً لكِ على مُساعدتكِ

138
00:09:26,700 --> 00:09:28,830
يا لها من مجموعة غبيّة حقّاً

139
00:09:32,850 --> 00:09:38,340
لكن يا ياماغامي، يبدو أنّك التقيت
ببشريّ صالح

140
00:09:48,990 --> 00:09:50,640
كم كانت كارثة

141
00:09:50,640 --> 00:09:53,720
سئمتُ من هذه البلدة حقّاً

142
00:09:53,720 --> 00:09:55,060
تماماً

143
00:09:55,060 --> 00:09:56,560
لنخرج من هنا

144
00:09:57,860 --> 00:10:03,330
كطارد أرواح بحدِّ ذاتي، لا أستطيع تجاهل
سلسلة الأخطاء الّتي ارتكبتُماها

145
00:10:03,620 --> 00:10:05,300
حان وقت دفعكما للثّمن

146
00:10:20,090 --> 00:10:26,020
ومهرجان هوجو، الّذي يُقام في كلّ
ثلاث سنوات، أُقيمَ كما هو مُخطَّط

147
00:10:27,390 --> 00:10:28,830
!لذيذ

148
00:10:28,830 --> 00:10:31,170
!لذيذ لدرجة أنّ خدَّي سيهترئان

149
00:10:31,170 --> 00:10:34,230
أوتسوغي، ابتلع طعامك قبل الكلام

150
00:10:34,460 --> 00:10:36,400
!أريد تجربة هذا أيضاً

151
00:10:36,400 --> 00:10:38,580
!مهلاً! هذا مُعيب

152
00:10:37,450 --> 00:10:39,070
هذا ليس سيّئاً أيضاً

153
00:10:46,660 --> 00:10:48,870
!كان ذلك وشيكاً

154
00:10:53,360 --> 00:10:55,460
!ماذا؟

155
00:10:55,460 --> 00:10:58,600
!لا يمكنك فعل هذا يا ياماغامي
!هذا غشّ

156
00:10:58,600 --> 00:11:01,030
لا أملك فكرة عمّا تعنيه

157
00:11:03,500 --> 00:11:04,220
تفضّل

158
00:11:06,990 --> 00:11:09,930
ما رأيك بالفطائر الخاصّة يا ياماغامي؟

159
00:11:10,830 --> 00:11:14,190
لا شيء يفوق معجون الفاصولياء النّاعم
عندما يتعلّق الأمر بالفطائر

160
00:11:14,190 --> 00:11:18,280
،المُفضّلة لدى الكلب المُقدّس
!فطائرنا الخاصّة

161
00:11:18,280 --> 00:11:19,640
هل تريدون تجربتها؟

162
00:11:19,640 --> 00:11:21,180
إنّها المُفضّلة لدى الكلب المُقدّس

163
00:11:22,310 --> 00:11:24,150
أنا ذئب

164
00:11:33,700 --> 00:11:35,590
لِمَ لا نستمتع في يوم كهذا؟

165
00:11:38,610 --> 00:11:40,300
فقط اليوم

166
00:11:40,300 --> 00:11:42,400
هـ-هل تريدين واحدة؟

167
00:11:43,600 --> 00:11:44,510
ما رأيك؟

168
00:11:44,510 --> 00:11:45,860
!لذيذة

169
00:11:45,860 --> 00:11:46,970
!دعيني أُجرّب

170
00:11:47,370 --> 00:11:49,460
لننضمّ للآخرين بسرعة

171
00:11:49,460 --> 00:11:50,450
أجل

172
00:12:08,720 --> 00:12:10,120
!مُذهل

173
00:12:10,120 --> 00:12:11,930
هذا جميل

174
00:12:11,930 --> 00:12:13,580
!إنّه الأروع

175
00:12:19,160 --> 00:12:20,160
ما الأمر؟

176
00:12:20,980 --> 00:12:21,850
لا شيء

177
00:12:38,300 --> 00:12:40,820
سيّد كاتسوراغي، عُدت

178
00:12:40,820 --> 00:12:41,690
مرحباً

179
00:12:42,030 --> 00:12:44,530
حسناً، كيف حال طاردَي
الأرواح بعد ذلك؟

180
00:12:44,750 --> 00:12:48,380
لحسن الحظّ، إنّهما يتجنّبان المشاكل
في البلدة المُجاورة

181
00:12:48,380 --> 00:12:49,790
هذا هو الأفضل

182
00:12:50,100 --> 00:12:52,490
لكن هذا غامض جدّاً

183
00:12:53,810 --> 00:12:56,250
في ذلك اليوم، عندما سارعتُ إلى هناك
،بعد تلقّي المعلومة

184
00:12:56,580 --> 00:12:58,960
كان آنشو وإينّو قد قُبض
عليهما بالفعل

185
00:12:59,400 --> 00:13:03,360
قالا بأنّهما لم يتذكّرا من فعل ذلك

186
00:13:04,310 --> 00:13:05,800
مَن قد يكون؟

187
00:13:06,960 --> 00:13:08,150
هل تريد أن تعرف؟

188
00:13:08,150 --> 00:13:09,300
—كان ذلك

189
00:13:09,300 --> 00:13:10,200
!أنتما

190
00:13:11,060 --> 00:13:14,010
ظهرتْ روحٌ شرّيرة عند المقبرة

191
00:13:14,010 --> 00:13:15,020
ماذا؟

192
00:13:15,020 --> 00:13:18,580
هل ما زال علينا العمل؟

193
00:13:18,580 --> 00:13:20,490
هيّا بنا يا سيّد كاتسوراغي

194
00:13:20,490 --> 00:13:23,090
!أنت، انتظرني

195
00:13:23,090 --> 00:13:25,070
!لا تتركني يا هاريما

196
00:13:25,070 --> 00:13:26,450
!هوريكاوا

197
00:13:26,450 --> 00:13:30,370
بئساً، كُفّي عن التجوُّل دون
!إخباري إلى أين أنتِ ذاهبة

198
00:13:30,370 --> 00:13:32,160
!لـ-لقد قلقت، مفهوم؟

199
00:13:33,370 --> 00:13:36,420
—لهذا السّبب ستبقين مُزعجة دوماً

200
00:13:36,830 --> 00:13:40,540
!يا للهول! إلّا هذا الصّوت! توقّفي رجاء

201
00:13:41,440 --> 00:13:43,300
هل نذهب؟

202
00:13:51,780 --> 00:13:53,680
لطيف وساخن

203
00:13:54,080 --> 00:13:57,280
لا شيء يفوق نبعاً ساخناً في الشِّتاء

204
00:13:58,020 --> 00:14:00,020
!المعذرة. سأدخل

205
00:14:00,640 --> 00:14:02,930
هذا الصّوت... تسوموغي؟

206
00:14:02,930 --> 00:14:03,930
أجل

207
00:14:04,920 --> 00:14:06,820
ما الّذي جاء بك إلى هنا؟

208
00:14:06,820 --> 00:14:10,670
من فضلك اعذر سلوك سيّدتي قبل أيّام

209
00:14:10,670 --> 00:14:12,910
!لا داعي للاعتذار

210
00:14:13,420 --> 00:14:15,710
أنا مُمتنّ على مُساعدتها

211
00:14:16,310 --> 00:14:18,000
أتريد غمر نفسك في النّبع السّاخن؟

212
00:14:18,240 --> 00:14:19,960
!أيمكنني ذلك؟

213
00:14:19,960 --> 00:14:22,080
هذا عربون امتنان بسيط منّي

214
00:14:22,080 --> 00:14:24,380
ولديّ إيناريزوشي اليوم كذلك

215
00:14:24,380 --> 00:14:26,720
!أتمنّى هذا

216
00:14:27,110 --> 00:14:28,800
افعل ما يحلو لك

217
00:14:30,690 --> 00:14:31,860
!شكراً لك

218
00:14:35,530 --> 00:14:37,820
هذا أروع شعور

219
00:14:41,380 --> 00:14:42,460
تفضّلوا

220
00:14:45,490 --> 00:14:47,900
!هذا أروع شعور أيضاً

221
00:14:48,840 --> 00:14:50,360
هناك المزيد

222
00:14:51,070 --> 00:14:52,800
!مُذهل

223
00:14:52,800 --> 00:14:55,220
الحشوات مُختلفة جميعها اليوم

224
00:14:55,220 --> 00:14:56,950
يبدو هذا شهيّاً

225
00:14:59,050 --> 00:15:01,300
فوجين، رايجين

226
00:15:01,300 --> 00:15:03,390
هل يمكننا الانضمام أيضاً؟

227
00:15:03,390 --> 00:15:04,630
بكلّ تأكيد

228
00:15:05,150 --> 00:15:07,880
أنا مَدين لكما بالكثير كذلك

229
00:15:07,880 --> 00:15:10,590
ماذا؟ يبدو أنّه هنا ثانية

230
00:15:10,590 --> 00:15:12,840
...ماذا؟ هل يُعقَل

231
00:15:18,530 --> 00:15:20,270
...هذا

232
00:15:20,270 --> 00:15:23,500
مهلاً! أتقيمون حفلاً اليوم؟

233
00:15:23,500 --> 00:15:24,580
!إيبي

234
00:15:24,580 --> 00:15:27,440
مرحباً، لم أركم منذ وقت

235
00:15:27,440 --> 00:15:28,460
تسرّني رؤيتك

236
00:15:28,460 --> 00:15:33,680
...في الواقع، أتيتُ بقصّة قد تُعجبك

237
00:15:36,870 --> 00:15:38,580
ما-ما هذا؟

238
00:15:38,580 --> 00:15:40,040
من جديد، هذا الإحساس الغريب

239
00:15:40,040 --> 00:15:43,640
بأنّني لا أريد الخسارة أمام
هذا مهما كلّف الأمر

240
00:15:54,810 --> 00:15:57,390
!توابل اليوم ممتازة

241
00:15:57,390 --> 00:15:59,310
!متى وصلت إلى هنا يا سوسانو؟

242
00:15:59,590 --> 00:16:00,940
أجل، أنا هنا

243
00:16:00,940 --> 00:16:02,670
هل يمكنني مُساعدتك بشيء؟

244
00:16:02,670 --> 00:16:05,270
ارتأيتُ بأن أدرّبك أكثر

245
00:16:05,270 --> 00:16:07,450
!تُدرّبني؟ الآن؟

246
00:16:07,450 --> 00:16:11,530
سمعتُ بأنّ روحاً شرّيرة سبّبتْ
لك الكثير من المتاعب قبل أيّام

247
00:16:11,530 --> 00:16:13,860
لكن تمكّنتُ من طردها

248
00:16:14,100 --> 00:16:17,400
!ما زالت قوّة الرّياح خاصّتك ضعيفة

249
00:16:17,400 --> 00:16:19,560
أيّها العجوز، سأستعيره قليلاً، حسناً؟

250
00:16:19,560 --> 00:16:21,120
افعل ما يحلو لك

251
00:16:21,120 --> 00:16:22,580
!حقّاً؟

252
00:16:22,580 --> 00:16:25,580
!كُفّ عن الشّكوى! هيّا بنا

253
00:16:25,900 --> 00:16:27,670
لـ-لا، شكراً لك

254
00:16:27,670 --> 00:16:29,090
!ياماغامي

255
00:16:29,090 --> 00:16:31,470
!كُفّ عن المُماطلة

256
00:16:31,470 --> 00:16:32,660
!سوسانو

257
00:16:33,740 --> 00:16:35,300
كنتُ أبحث عنك

258
00:16:36,190 --> 00:16:37,390
...أختي الكبرى

259
00:16:37,680 --> 00:16:38,940
أماتيراسو

260
00:16:39,250 --> 00:16:41,850
خرجتَ خلسة من جديد

261
00:16:42,500 --> 00:16:45,920
ولماذا تستخدم العنف ضدّ البشر؟

262
00:16:45,920 --> 00:16:49,410
...لستُ كذلك! أفعل هذا لأجله

263
00:16:49,410 --> 00:16:52,130
يمكنك استخدام القوّة الّتي منحتُك
إيّاها للختم على هذا الطّفل الشّقيّ

264
00:16:52,130 --> 00:16:55,040
!داخل إحدى عوالم الكامي المهجورة تلك

265
00:16:58,700 --> 00:17:01,570
لن تفلت

266
00:17:01,570 --> 00:17:03,300
!هوّني عليّ يا أختي الكُبرى

267
00:17:03,300 --> 00:17:04,740
!لن أفعل

268
00:17:04,740 --> 00:17:06,060
!لا تضحك عليّ

269
00:17:06,060 --> 00:17:07,540
!لا تتكلّم بهذه الطّريقة

270
00:17:07,540 --> 00:17:09,040
!أنا آسف

271
00:17:09,300 --> 00:17:13,050
لكن يا رجل، أيّ كارثة هذه
قد مررتَ بها

272
00:17:13,340 --> 00:17:15,860
في الواقع، لم يكن بالأمر الجلل

273
00:17:15,860 --> 00:17:18,910
سنشرب نخب الاحتفال بعودتك إلى طبيعتك

274
00:17:18,910 --> 00:17:22,600
شكراً على العرض، لكن لديّ هذه

275
00:17:23,970 --> 00:17:26,310
يبدو أنّك تُحبّ الحلويّات، أليس كذلك؟

276
00:17:26,740 --> 00:17:28,180
ما رأيك بالتّجربة؟

277
00:17:28,180 --> 00:17:30,270
كطعام خفيف مع مشروبي؟

278
00:17:30,570 --> 00:17:32,830
هذا ممتاز

279
00:17:33,740 --> 00:17:35,130
تفضّل

280
00:17:35,130 --> 00:17:37,210
شكراً جزيلاً لك

281
00:17:37,540 --> 00:17:40,010
!إيّاك أن تُسبّب المشاكل للبشر

282
00:17:40,010 --> 00:17:43,850
!دائماً ما ترتكب الأخطاء

283
00:17:48,910 --> 00:17:51,590
مرحباً؟ أُمّي؟

284
00:17:51,820 --> 00:17:54,270
تلقّيتُ الطّرد. شكراً لكِ

285
00:17:54,270 --> 00:17:56,680
أنت لا تتّصل أبداً، ولا تُراسلني

286
00:17:56,680 --> 00:17:57,800
هل أنت بخير؟

287
00:17:58,110 --> 00:18:00,760
أجل، أنا بخير، لذا لا تقلقي عليّ

288
00:18:00,760 --> 00:18:01,510
ماذا عنكِ؟

289
00:18:01,750 --> 00:18:04,600
في الواقع، النّبع السّاخن مُزدحم

290
00:18:04,880 --> 00:18:08,310
لا بُدّ أنّ الفضل يعزو للافتات
الاسم الّتي صنعتَها

291
00:18:08,310 --> 00:18:11,960
ونحن نستمتع بالفطائر الّتي أرسلتها لنا

292
00:18:14,090 --> 00:18:15,990
لذيذ

293
00:18:15,990 --> 00:18:18,490
لا يمكن أن نُخطئ تمييز الحلويّات
الّتي يختارها ميناتو

294
00:18:18,780 --> 00:18:21,390
لِمَ لا تأتي إلى الدّيار
للزّيارة يوماً ما؟

295
00:18:21,390 --> 00:18:22,950
أتمنّى لو أستطيع

296
00:18:23,170 --> 00:18:27,600
،لكن كوني راعياً لهذا المكان يُشغلني
وأنا أستمتع بهذا حقّاً

297
00:18:27,600 --> 00:18:30,930
فهمت. إذاً واظب على العمل
الدّؤوب، اتّفقنا؟

298
00:18:30,930 --> 00:18:31,900
حسناً

299
00:18:31,900 --> 00:18:33,170
بالمُناسبة

300
00:18:33,170 --> 00:18:36,700
حزمتُ لك تشكيلة من الأطعمة الخفيفة
الّتي ربحتُها في اليانصيب

301
00:18:42,830 --> 00:18:44,350
ما رأيك بها يا ياماغامي؟

302
00:18:44,350 --> 00:18:46,780
قضمها يمنح شعوراً مُرضياً

303
00:18:46,780 --> 00:18:48,060
إنّها تُعجبني

304
00:18:48,280 --> 00:18:49,570
هذا جيّد

305
00:18:49,570 --> 00:18:52,900
أنا أمضغ العلكة المُخصّصة للكلاب الّتي
أرسلَتْها أُمّي لي بالخطأ

306
00:18:53,350 --> 00:18:54,500
!كِلاب؟

307
00:18:54,500 --> 00:18:56,360
أنا ذئب

308
00:18:56,660 --> 00:18:59,430
لم تُعجبك إذاً؟

309
00:19:02,250 --> 00:19:03,840
تفضّل ما طلبتَه

310
00:19:04,650 --> 00:19:06,190
كالعادة، أنا مُمتنٌّ لك

311
00:19:06,190 --> 00:19:08,740
جميعنا نحن الأونميوجي مُمتنّون

312
00:19:08,740 --> 00:19:09,960
لا مُشكلة

313
00:19:09,960 --> 00:19:11,920
تفضّل دوراياكي مع الزّبدة
ومعجون الفاصولياء

314
00:19:12,300 --> 00:19:14,140
!يبدو هذا لذيذاً

315
00:19:14,140 --> 00:19:16,670
بالمُناسبة، لِمَ لا تُشاركني
احتساء الشّاي؟

316
00:19:16,970 --> 00:19:19,290
ليتني أستطيع، لكن أخشى
بأنّني لا أملك الوقت

317
00:19:19,290 --> 00:19:21,260
شوهِدَتْ روح شرّيرة أُخرى

318
00:19:21,260 --> 00:19:24,470
حقّاً؟ كُن حذراً من فضلك

319
00:19:26,490 --> 00:19:28,210
إنّه لا يتغيّر أبداً

320
00:19:30,180 --> 00:19:31,900
!زبدة مالحة ومعجون فاصولياء ناعم

321
00:19:32,160 --> 00:19:33,310
!مُذهل

322
00:19:33,310 --> 00:19:34,770
الدّمج بين الأسلوب اليابانيّ والغربيّ

323
00:19:35,080 --> 00:19:40,770
،لماذا يحظى الأتباع بالبانكيك
بينما تُخصَّص لي علكة كِلاب؟

324
00:19:40,770 --> 00:19:42,460
أليس هذا ظالماً؟

325
00:19:42,460 --> 00:19:45,070
آسف، حصّتك هنا

326
00:19:45,600 --> 00:19:48,460
المعجون النّاعم كافٍ للبانكيك دوراياكي

327
00:19:48,460 --> 00:19:52,100
يبدو من الخطأ إضافة زبدة مالحة، أليس كذلك؟

328
00:19:53,000 --> 00:19:56,960
فهمت. إذاً رُبّما هذه ليست
لك يا ياماغامي

329
00:19:58,660 --> 00:20:00,130
!هذا رائع

330
00:20:01,670 --> 00:20:04,550
يسرّني أنّها ناسبتْ ذوقك

331
00:20:07,440 --> 00:20:09,930
لم أكن أعلم بأنّ مزيج معجون الفاصولياء
والزّبدة المالحة بهذه اللّذّة

332
00:20:10,250 --> 00:20:12,940
!لم أتناول دوراياكي كهذه من قبل

333
00:20:12,940 --> 00:20:15,900
!دورا... ياكي؟

334
00:20:16,540 --> 00:20:18,480
لماذا أنت مصدوم هكذا؟

335
00:20:18,480 --> 00:20:22,080
دورا" تعني طبل، أداة قرع معدنيّة"

336
00:20:22,080 --> 00:20:23,820
أن يخبزوا ويأكلوا شيئاً كهذا؟

337
00:20:23,820 --> 00:20:26,420
!البشر مُروِّعون فعلاً

338
00:20:27,200 --> 00:20:30,580
،عرفتُ بأنّهم لاحمون وعاشِبون
!لكن لم أتوقّع هذا

339
00:20:30,580 --> 00:20:32,010
!يا للعجب

340
00:20:32,010 --> 00:20:34,150
هُراء! أنت تجعل مذاق السّاكي
الخاصّ بي سيّئاً

341
00:20:37,600 --> 00:20:38,630
!نجحتُم

342
00:20:38,970 --> 00:20:41,350
!إذاً الأخيرة، دورك

343
00:20:42,380 --> 00:20:44,470
والآن، كرّروا بعدي

344
00:20:54,800 --> 00:20:56,050
!نجحت

345
00:20:56,050 --> 00:20:57,480
!أنا أثني عليك

346
00:20:58,500 --> 00:21:01,300
انتهى درس طائر-تشان في الهواء الطّلق؟

347
00:21:01,300 --> 00:21:02,780
هكذا يبدو

348
00:21:04,870 --> 00:21:06,890
طائر-تشان، أحسنت صنعاً

349
00:21:15,690 --> 00:21:16,960
ما الخطب؟

350
00:21:17,910 --> 00:21:22,030
لا شيء. كنتُ أُقول لنفسي
كم أنّ هذه الحياة مُمتعة

351
00:21:24,060 --> 00:21:28,300
أنا أستمتع بالأيّام الّتي قضيتُها
،في هذا المنزل معكم جميعاً

352
00:21:28,680 --> 00:21:32,550
لذا سأستمرّ في أن أكون
راعي منزل كوسونوكي

353
00:21:32,870 --> 00:21:33,720
أجل

354
00:21:36,600 --> 00:21:39,060
ماذا؟ ما هذا؟

355
00:21:43,180 --> 00:21:48,050
.الرُّوح القدسيّة الّتي ساعدتُها قبل مدّة
إنّها على وشك الاستيقاظ؟

356
00:21:52,570 --> 00:21:54,180
!يـ-ياماغامي

357
00:21:54,180 --> 00:21:55,220
هل هذا...؟

358
00:22:04,060 --> 00:22:07,340
!سنجاب طائر؟ كم هو ظريف

359
00:22:07,650 --> 00:22:10,710
ابتداء من اليوم، أنت أحد أتباعي

360
00:22:12,530 --> 00:22:14,350
اسمي ميناتو كوسونوكي

361
00:22:14,350 --> 00:22:15,770
أتطلّع قُدماً لمعرفتك

362
00:22:18,820 --> 00:22:21,290
أهلاً بك في منزل كوسونوكي