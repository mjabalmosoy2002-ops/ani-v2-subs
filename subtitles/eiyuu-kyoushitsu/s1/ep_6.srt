1
00:00:02,670 --> 00:00:05,000
!أشعر بالتخمة

2
00:00:05,000 --> 00:00:06,860
وما كان ذلك بأيّ حال؟

3
00:00:06,860 --> 00:00:09,780
كان طبقاً كبيراً بحجم دلو

4
00:00:09,780 --> 00:00:12,400
!إنّه بودينغ الدلو

5
00:00:12,400 --> 00:00:16,880
!مرحى! مرحى

6
00:00:14,660 --> 00:00:16,880
لا تزال لديكِ مساحة للمزيد، صحيح يا صوفي؟

7
00:00:16,880 --> 00:00:18,360
أجل، بالطبع

8
00:00:18,360 --> 00:00:20,280
ما قصدكِ بالطبع؟

9
00:00:22,580 --> 00:00:23,290
ما هذا؟

10
00:00:24,000 --> 00:00:26,290
الحمولة عالقةٌ هنا

11
00:00:26,600 --> 00:00:27,840
المعذرة

12
00:00:27,840 --> 00:00:29,600
لمن هذه العربة؟

13
00:00:29,600 --> 00:00:32,460
،إذا لم تستطيعوا العبور
فعليكم سلوك الطريق الرئيسيّ

14
00:00:32,460 --> 00:00:33,970
!حسناً، أنا آسفة

15
00:00:35,430 --> 00:00:37,240
!أنتِ قنطورة

16
00:00:37,240 --> 00:00:38,360
صحيح

17
00:00:38,970 --> 00:00:39,900
...اسمي

18
00:00:39,900 --> 00:00:41,720
ماذا؟ أليست هذه أنتِ يا ديوني؟

19
00:00:42,840 --> 00:00:43,980
...أنت البطل العظـ

20
00:00:46,730 --> 00:00:49,530
!كوني البطل العظيم سرّ

21
00:00:49,530 --> 00:00:50,460
!فهمتِ؟

22
00:00:51,840 --> 00:00:53,120
أتعرفان بعضكما؟

23
00:00:53,120 --> 00:00:53,560
ماذا؟

24
00:00:53,560 --> 00:00:56,490
...حسناً، ربما، وربما لا

25
00:00:56,490 --> 00:00:57,740
أيّهما؟

26
00:00:59,620 --> 00:01:03,890
أنا والبطل... أقصد أنا وبليد
نعرف بعضنا منذ مدّة طويلة

27
00:01:03,890 --> 00:01:06,250
!عندما كان بليد البطل.... لحظة، لا

28
00:01:06,250 --> 00:01:07,690
!ما أهمّ ذلك

29
00:01:07,690 --> 00:01:09,130
ماذا ستفعلين حيال هذه الحمولة؟

30
00:01:09,590 --> 00:01:11,070
صحيح

31
00:01:11,070 --> 00:01:13,750
إن أردتِ، سيسرّنا مساعدتك

32
00:01:13,750 --> 00:01:14,510
أجل

33
00:01:14,800 --> 00:01:16,400
!دعوا الأمر لي

34
00:01:16,400 --> 00:01:18,180
!نحن التنانين أقوياء

35
00:01:18,860 --> 00:01:20,430
أقدّر عونكم

36
00:01:21,260 --> 00:01:24,030
أكلّكم أعضاء من مجموعة بليد؟

37
00:01:24,030 --> 00:01:26,190
!كلّا! إنّهم أصدقائي

38
00:01:27,560 --> 00:01:29,190
فهمت

39
00:01:29,920 --> 00:01:32,320
إذاً؟ لأين نحمل هذه؟

40
00:01:32,320 --> 00:01:34,440
...حسناً، سيكون ذلك

41
00:01:34,440 --> 00:01:36,820
!كنتِ بانتظارك

42
00:01:37,430 --> 00:01:39,520
كانت حمولة المُسنّ؟

43
00:01:39,520 --> 00:01:41,080
هذه فظاظةٌ يا بليد

44
00:01:41,400 --> 00:01:42,870
جلالتك

45
00:01:42,870 --> 00:01:44,890
جلبتُها هنا كما أمرتني

46
00:01:44,890 --> 00:01:46,670
أحسنتِ البلاء

47
00:01:46,670 --> 00:01:50,480
بالمناسبة، جهّزتِ مهمّتك التالية سلفاً

48
00:01:50,480 --> 00:01:51,090
!أجل

49
00:01:51,690 --> 00:01:52,500
!سمعاً وطاعة

50
00:01:52,500 --> 00:01:53,760
نعم

51
00:01:53,760 --> 00:01:57,720
بدءاً من اليوم، ستقومين بالتدريس في
أكاديميّة روزوود كمعلّمة

52
00:01:57,720 --> 00:01:59,140
!ماذا؟

53
00:01:59,140 --> 00:02:01,780
!ذلك مُفاجئ

54
00:02:01,780 --> 00:02:04,850
بليد على إدراك تام بقدراتها

55
00:02:04,850 --> 00:02:07,100
يُفترض أن تمتلك كافّة المقوّمات
الأساسيّة لتكون معلّمتكم

56
00:02:07,100 --> 00:02:08,640
...حسناً، أجل

57
00:02:08,640 --> 00:02:11,020
!أتمنّى لك التوفيق إذاً

58
00:02:11,390 --> 00:02:12,100
!أجل

59
00:02:12,800 --> 00:02:14,230
أتطلّع لتدريسك

60
00:02:14,230 --> 00:02:15,820
!أيّها البطل... لحظة، لا

61
00:02:15,820 --> 00:02:16,970
!يا بليد-دونو

62
00:02:17,420 --> 00:02:19,160
هل سيمضي هذا على ما يرام؟

63
00:04:02,290 --> 00:04:03,680
ما الذي يجري هنا؟

64
00:04:03,680 --> 00:04:06,220
لحظة، من تلك؟

65
00:04:06,900 --> 00:04:08,800
أذلك حديدٌ إلهيّ؟

66
00:04:08,800 --> 00:04:09,720
صحيح

67
00:04:09,720 --> 00:04:12,160
في الماضي، كنّا نستعمل الصخور بدلاً عنه

68
00:04:29,820 --> 00:04:33,410
ظننتُ أنّ الحديد الإلهيّ لا يُحطّم

69
00:04:33,410 --> 00:04:35,540
أذلك الطبيعيّ؟

70
00:04:36,100 --> 00:04:38,850
ليس يتحطّم فحسب، بل يذوب

71
00:04:38,850 --> 00:04:40,250
...مٌذهل

72
00:04:51,890 --> 00:04:54,320
!أشعر أنّي قمت بالتحمية أخيراً

73
00:04:54,320 --> 00:04:56,100
!حسناً، لنبدأ الدرس

74
00:04:58,350 --> 00:05:00,100
!عرّفي بنفسك أوّلاً

75
00:05:00,100 --> 00:05:01,400
!معك حقّ

76
00:05:02,300 --> 00:05:04,080
!أنا ديوني

77
00:05:04,080 --> 00:05:06,160
!رمح الشيطان، ديوني

78
00:05:06,160 --> 00:05:10,060
،إذا شعر أيّ منكم بثقة كافية
!فيستلّ سيفه ويواجهني

79
00:05:10,060 --> 00:05:12,580
!لحظة، لسنا هنا لخوض مبارزة

80
00:05:12,580 --> 00:05:15,050
رمح الشيطان ديوني؟

81
00:05:15,050 --> 00:05:16,010
!ماذا؟

82
00:05:16,010 --> 00:05:19,210
،أأنتِ القائدة العسكريّة ديوني
!قائدة كتيبة الفرسان الأقوى؟

83
00:05:19,210 --> 00:05:20,920
!قائدة عسكريّة؟

84
00:05:21,920 --> 00:05:23,680
!بطلة حقيقيّة

85
00:05:23,680 --> 00:05:27,120
سيقوم شخص مُذهل مثلها بتدريسنا؟

86
00:05:27,120 --> 00:05:28,230
...لا

87
00:05:28,230 --> 00:05:30,320
...أمام البطل العظيم، فلست

88
00:05:30,910 --> 00:05:31,640
!أنتِ

89
00:05:32,840 --> 00:05:36,940
حظيتِ بفرصة رؤية قتال البطل
العظيم شخصيّاً إذاً يا ديوني-ساما؟

90
00:05:37,290 --> 00:05:40,610
...كـ-كـ-كان ذلك في الماضي

91
00:05:40,610 --> 00:05:44,840
لكن لمَ تعرف واحد مثلكِ بليد؟

92
00:05:46,530 --> 00:05:49,930
أتعتقدين أنّ ديوني-أونيساما تعرف بليد-كن؟

93
00:05:51,070 --> 00:05:53,160
ذلك يثير الاهتمام

94
00:05:54,840 --> 00:05:58,040
!يا والدي! ذلك يوخز

95
00:05:58,040 --> 00:06:00,030
!فلتبقي ساكنة

96
00:06:01,650 --> 00:06:03,390
!لا تصدري أصوات غريبة

97
00:06:07,730 --> 00:06:12,510
،دائماً ما أستحمّ في الماء البارد
لكنّ هذا رائعٌ أيضاً

98
00:06:11,280 --> 00:06:13,880
كيف شعوركِ يا أونيساما؟

99
00:06:13,880 --> 00:06:15,650
لنمسح العرق

100
00:06:15,650 --> 00:06:17,890
!أنا في الجنّة

101
00:06:17,890 --> 00:06:22,610
أكنتِ تعرفين بليد-كن منذ
وقتٍ طويل يا أونيساما؟

102
00:06:22,610 --> 00:06:26,470
!ا-ا-التقيتُ بليد في اليوم الفائت وحسب

103
00:06:26,470 --> 00:06:29,110
لكنّكِ قلتِ أنّكما تعرفان
بعضكما منذ مدّة طويلة

104
00:06:29,110 --> 00:06:31,210
...ذ-ذلك، في الواقع

105
00:06:31,210 --> 00:06:32,520
أخبرينا يا أونيساما

106
00:06:32,520 --> 00:06:36,120
نودّ أن نسمع قصصاً عن
طبيعة بليد-كن في الماضي

107
00:06:36,120 --> 00:06:38,750
!أنا مهتمّةٌ بذلك أيضاً

108
00:06:40,500 --> 00:06:43,340
!أخبرينا رجاءً يا أونيساما

109
00:06:43,340 --> 00:06:44,740
!أجل! هنا

110
00:06:44,740 --> 00:06:46,630
!واصلي من فضلك

111
00:06:48,310 --> 00:06:49,660
!شعورٌ رائع

112
00:06:48,310 --> 00:06:50,590
...إن أردتِ هنا

113
00:06:52,890 --> 00:06:53,720
!أنتنّ

114
00:06:53,720 --> 00:06:57,650
!ا-البطل... أقصد، بليد-دونو

115
00:06:57,650 --> 00:06:59,520
كنّا قريبات أيضاً

116
00:06:59,520 --> 00:07:01,340
!مهلاً يا بليد

117
00:07:01,340 --> 00:07:03,770
كيف أنت هنا وكأنّه أمر طبيعيّ؟

118
00:07:03,770 --> 00:07:06,940
من سيغسل شعر كو غيري؟

119
00:07:06,940 --> 00:07:08,300
اهدئي يا أنا

120
00:07:08,300 --> 00:07:11,720
عمر بليد-كن الذهنيّ كما
لو كان في الخامسة

121
00:07:11,720 --> 00:07:12,530
!انظر

122
00:07:13,010 --> 00:07:14,030
ماذا؟

123
00:07:14,030 --> 00:07:15,260
رأيتِ؟

124
00:07:15,260 --> 00:07:16,740
!لا تقولي ذلك

125
00:07:16,740 --> 00:07:18,830
!ما الذي تفعلينه يا يشيكا؟

126
00:07:19,580 --> 00:07:21,880
...قلتِ في الخامسة

127
00:07:21,880 --> 00:07:25,570
كان ذلك سنّ بليد تقريباً
عندما التقيتُه لأوّل مرة

128
00:07:25,570 --> 00:07:26,710
!أنتِ! يا ديوني

129
00:07:27,550 --> 00:07:28,480
ماذا؟

130
00:07:28,480 --> 00:07:31,680
عندما كان بقرابة سنّي؟

131
00:07:31,680 --> 00:07:33,840
أودّ سماع القصّة

132
00:07:36,930 --> 00:07:39,840
...عندما التقيتُ بليد لأوّل مرّة

133
00:07:39,840 --> 00:07:44,430
كان بغاية الشراسة، فظننتُه حيواناً برّياً

134
00:07:46,920 --> 00:07:51,200
كان بالكاد يتكلّم، وبدا أنّه يظنّني خيلاً

135
00:07:52,480 --> 00:07:54,530
فغرس أسنانه بمؤخرتي

136
00:07:56,580 --> 00:07:58,730
كنتُ لا أزال قليلة الخبرة وقتها

137
00:07:58,730 --> 00:08:01,220
وعلى وشك أن أصبح عشاءً حقّاً

138
00:08:01,220 --> 00:08:03,500
هذا يلائم طبيعة بليد-كن حقّاً

139
00:08:04,130 --> 00:08:08,380
،وبعدها ببضعة أعوام، بعد تمريني لذهني وجسدي

140
00:08:08,380 --> 00:08:11,710
أصبحتُ جديرة بالانضمام للقتال
!رفقة البطل العظيم نفسه

141
00:08:11,710 --> 00:08:16,240
أي أنّ شائعات قتالكِ مع البطل
العظيم صحيحة أيّتها القائدة؟

142
00:08:16,240 --> 00:08:17,760
!بالطبع

143
00:08:18,220 --> 00:08:19,410
استرخِ

144
00:08:19,410 --> 00:08:21,980
لا يستطيع أحد معرفة أنّها تقصدك

145
00:08:21,980 --> 00:08:22,680
ماذا؟

146
00:08:22,950 --> 00:08:27,130
!تركتُ البطل العظيم يصعد ظهري حتّى

147
00:08:27,130 --> 00:08:28,340
حقّاً؟

148
00:08:28,800 --> 00:08:34,300
لكنّه لم يسمح لي بالانضمام له
لقتال ملك الشياطين

149
00:08:34,300 --> 00:08:37,500
لم أستطع أن أحمله إلى النهاية

150
00:08:39,690 --> 00:08:43,410
،بلومي لذاتي، اعتبرتها علامة على ضعفي

151
00:08:44,090 --> 00:08:46,500
وأسعى الآن لتمرين نفسي أكثر

152
00:08:47,330 --> 00:08:49,290
أرى ذلك مُبهراً

153
00:08:51,380 --> 00:08:53,890
أأنتِ متأكّدة أنّ أحداً لم ينتبه؟

154
00:08:53,890 --> 00:08:54,960
أجل

155
00:08:54,960 --> 00:08:57,830
يظنّ الجميع أنّ البطل أكبر سنّاً

156
00:08:57,830 --> 00:08:59,180
!منطقيّ

157
00:08:59,610 --> 00:09:02,800
لذا هذا سرّنا الخاصّ

158
00:09:02,800 --> 00:09:04,690
...حسناً، بخصوص ذلك

159
00:09:06,770 --> 00:09:08,810
كُشِف أمري

160
00:09:13,160 --> 00:09:14,490
!بعد بضعة أيّام

161
00:09:15,460 --> 00:09:18,120
ماذا نجلب معنا هديّة لأونيساما؟

162
00:09:18,910 --> 00:09:19,980
ملفوف ربما؟

163
00:09:19,980 --> 00:09:21,240
فهي تأكله كاملاً

164
00:09:24,560 --> 00:09:25,920
أخبرني يا بليد

165
00:09:25,920 --> 00:09:28,470
ما طبيعة علاقتك معها بالضبط؟

166
00:09:28,470 --> 00:09:31,060
...حسناً، بخصوص ذلك

167
00:09:31,970 --> 00:09:32,630
!ماذا؟

168
00:09:34,070 --> 00:09:35,130
!سيمرغ؟

169
00:09:36,000 --> 00:09:38,490
ما كان السيمرغ؟

170
00:09:38,490 --> 00:09:40,390
!إنّه أحد طيور القارة الأربعة المُقدّسة

171
00:09:40,680 --> 00:09:44,940
أي أنّه مثل طير الرعد أو العنقاء؟

172
00:09:44,940 --> 00:09:47,890
لكن ما الذي يفعله سيمرغ في العاصمة الملكيّة؟

173
00:09:48,270 --> 00:09:53,090
حسناً، أنا متأكدٌ أنّه لن يهاجمنا
طالما لم نقم باستفزازه

174
00:09:53,090 --> 00:09:54,060
صحيح

175
00:09:54,060 --> 00:09:56,700
لا سجّلات عن حوادث مهاجمته للبشر

176
00:09:59,850 --> 00:10:00,820
!إيرنست

177
00:10:01,290 --> 00:10:02,330
ماذا؟

178
00:10:08,350 --> 00:10:10,080
!كلّا! علينا إيقافه

179
00:10:12,840 --> 00:10:14,380
!اضبطي روحكِ القتاليّة

180
00:10:14,380 --> 00:10:15,510
!حسناً! حسناً

181
00:10:22,010 --> 00:10:23,600
...اثنان

182
00:10:22,440 --> 00:10:23,600
!أأنت بخير؟

183
00:10:23,600 --> 00:10:25,560
أهما زوجا سيمرغ؟

184
00:10:25,560 --> 00:10:27,040
ولمَ؟

185
00:10:27,040 --> 00:10:29,140
ظننتها لا تهاجم البشر

186
00:10:29,140 --> 00:10:31,020
...بدا كأنّها

187
00:10:31,020 --> 00:10:33,210
تستهدف العربة وليس البشر

188
00:10:33,210 --> 00:10:34,110
العربة؟

189
00:10:34,450 --> 00:10:35,750
...أيمكن أنّها

190
00:10:36,740 --> 00:10:39,780
لا بدّ أنّ لذاك الوغد علاقة بهذا

191
00:10:52,140 --> 00:10:55,000
!الحمّام الدافئ شيءٌ جميل حقّاً

192
00:10:56,750 --> 00:11:00,260
!جلالتك! جلالتك! جلالتك

193
00:11:00,260 --> 00:11:01,760
!جلالتك

194
00:11:01,760 --> 00:11:03,300
!علينا الكلام

195
00:11:03,970 --> 00:11:05,300
ما الخطب؟

196
00:11:05,300 --> 00:11:06,390
تبدين مُستاءة

197
00:11:06,390 --> 00:11:09,640
!ما الذي كنت تخفيه عنّا بالضبط؟

198
00:11:10,890 --> 00:11:12,550
لا يُعتبر ذلك فظاظة إذاً؟

199
00:11:12,550 --> 00:11:14,400
!كانت البلدة تتعرّض للهجوم

200
00:11:14,400 --> 00:11:17,460
!وضّح ما يجري هنا رجاءً

201
00:11:18,120 --> 00:11:20,450
ما الذي يجعلكِ تظنّين أنّ
للأمر علاقة بي؟

202
00:11:20,880 --> 00:11:23,530
هاجم السيمرغ عربة شحن

203
00:11:24,130 --> 00:11:25,280
فهمت

204
00:11:25,590 --> 00:11:28,430
وكانت ديوني تجرّ عربة شحن أيضاً

205
00:11:28,430 --> 00:11:29,570
صحيح

206
00:11:29,570 --> 00:11:30,590
!جلالتك

207
00:11:30,590 --> 00:11:33,040
