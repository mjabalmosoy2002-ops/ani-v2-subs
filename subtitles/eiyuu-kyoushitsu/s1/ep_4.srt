1
00:00:19,840 --> 00:00:21,280
!ما الذي تفعلونه؟

2
00:00:21,280 --> 00:00:23,370
!تذكّروا التشكيلات من تمريننا

3
00:00:26,800 --> 00:00:28,130
!إمبراطورة

4
00:00:28,400 --> 00:00:30,590
!كتيبة كلي، اتبعوني

5
00:00:30,590 --> 00:00:32,630
!كتيبة كاسيم، تعالوا من الجانب الآخر

6
00:00:45,280 --> 00:00:46,150
!تفرّقوا

7
00:00:50,530 --> 00:00:51,420
!إنّها مكشوفة

8
00:00:51,420 --> 00:00:52,190
!صوّبوا

9
00:00:53,100 --> 00:00:53,780
!الآن

10
00:00:53,780 --> 00:00:54,650
!\أطلقوا

11
00:00:56,660 --> 00:00:57,760
!واصلوا

12
00:00:57,760 --> 00:00:59,450
!هذا يفلح كما فعلنا في التمرين

13
00:00:59,450 --> 00:01:00,570
!الآن

14
00:01:04,420 --> 00:01:05,620
فهمت

15
00:01:06,410 --> 00:01:10,090
شنّوا الهجمات بعيدة المدى بعد
!تأكّدكم من تراجع كتيبة كلي

16
00:01:14,630 --> 00:01:16,940
يستهدفون نقطتها العمياء باستمرار إذاً

17
00:01:16,940 --> 00:01:18,040
أجل

18
00:01:18,040 --> 00:01:21,470
استراتيجيّة ممتازة تسخّر طبيعتهم الجماعيّة

19
00:01:23,220 --> 00:01:25,770
لكن هناك مشكلة واحدة

20
00:01:34,760 --> 00:01:40,620
لن تلحق الهجمات العاديّة أيّ ضرر
بتنّين محصّن بالحراشف

21
00:01:41,270 --> 00:01:43,820
حسناً، ماذا ستصنعون الآن؟

22
00:03:27,280 --> 00:03:29,600
!اجلبوا المصابين هنا رجاءً

23
00:03:29,600 --> 00:03:31,100
!سأقوم بعلاجهم

24
00:03:38,650 --> 00:03:41,310
يبدو أنّك بانتظار شيء

25
00:03:41,310 --> 00:03:44,570
لكن ستحلّ نهاية المعركة قبله

26
00:03:46,450 --> 00:03:47,430
!تفادوها

27
00:03:48,790 --> 00:03:50,560
!حسناً، الآن فرصتكم

28
00:04:00,100 --> 00:04:01,300
!أسمودوس

29
00:04:06,970 --> 00:04:10,150
ربما تسبّب ذلك بضرر طفيف

30
00:04:10,150 --> 00:04:12,030
لكن يبدو أنّ خطّتكم فشلت

31
00:04:12,030 --> 00:04:13,690
لا، إنّه كافٍ

32
00:04:17,520 --> 00:04:19,730
لا تستطيع رؤية محيطها الآن

33
00:04:27,300 --> 00:04:28,660
حفرة؟

34
00:04:28,660 --> 00:04:31,650
ظننت أنّكم تقاتلون بعدل وإنصاف

35
00:04:31,650 --> 00:04:34,860
كان ليكون فخّاً جباناً
لو تمّ تجهيزه قبلاً

36
00:04:34,860 --> 00:04:36,300
لكن ليس الأمر كذلك

37
00:04:37,800 --> 00:04:39,130
قام بحفره

38
00:04:39,430 --> 00:04:41,650
بعد بدء المعركة

39
00:04:42,930 --> 00:04:45,340
أي كنت تماطلون حتّى الآن

40
00:04:45,340 --> 00:04:48,640
لكن لا يكفي هذا لهزيمتها

41
00:04:48,640 --> 00:04:49,810
أعرف ذلك

42
00:04:51,130 --> 00:04:53,380
تبدأ معركتنا الحقيقيّة الآن

43
00:04:58,860 --> 00:04:59,770
!انطلقوا

44
00:05:00,470 --> 00:05:02,150
سامحيني يا كو

45
00:05:04,950 --> 00:05:06,390
!أسمودوس

46
00:05:06,880 --> 00:05:08,640
...رغم قوّتي

47
00:05:09,120 --> 00:05:12,160
...استعمالي باستمرارٍ هكذا

48
00:05:12,160 --> 00:05:14,220
!لا تكن ضعيفاً

49
00:05:18,550 --> 00:05:20,300
ليونارد، أيمكنك مواصلة القتال؟

50
00:05:20,300 --> 00:05:21,670
!أجل سيّدتي

51
00:05:28,740 --> 00:05:29,640
!ليونارد

52
00:05:31,090 --> 00:05:33,420
لا تزال لديّ لياقة

53
00:05:33,420 --> 00:05:37,240
فلم أخفق في إنهاء ركض العشرة كيلومترات
التي طلبتها منّي كلّ صباح

54
00:05:38,150 --> 00:05:39,030
ما الذي طلبته؟

55
00:05:42,980 --> 00:05:44,110
!إنّها على وشك الطيران

56
00:05:45,460 --> 00:05:46,400
!إيرنست

57
00:05:47,400 --> 00:05:48,660
!ا-انتظري

58
00:05:48,660 --> 00:05:49,660
!لن أنتظر

59
00:05:53,410 --> 00:05:54,410
!صوفي

60
00:05:55,870 --> 00:05:59,420
قوّة البطل العظيم الاصطناعيّة: التلاعب بالجاذبيّة

61
00:06:06,950 --> 00:06:08,470
!الآن يا إيرنست

62
00:06:09,920 --> 00:06:12,930
...يا إلهي، تجعلنا نكدح

63
00:06:15,270 --> 00:06:18,960
!آمرك باسم إيرنست فليمنغ

64
00:06:18,960 --> 00:06:21,560
!أيّها السيف! اكشف قوّتك

65
00:06:21,560 --> 00:06:24,690
!لم أعد أستطيع... أرجوك

66
00:06:24,690 --> 00:06:27,570
!اصمت

67
00:06:31,160 --> 00:06:34,510
من كان يعلم امتلاكنا لتلميذة بهذه القدرة في مدرستنا؟

68
00:06:34,510 --> 00:06:36,460
ليست قوّتها وحدها

69
00:06:37,400 --> 00:06:41,710
حتّى في الصفوف المُتقدّمة، لا يوجد الكثيرون
ممن يستطيعون صقل روحهم القتاليّة

70
00:06:41,950 --> 00:06:42,980
...لكن

71
00:06:42,980 --> 00:06:45,250
...حتّى نحن التلامذة في الصفوف الدنيا

72
00:06:45,250 --> 00:06:47,630
...يمكننا أن نكون قنوات

73
00:06:47,630 --> 00:06:49,320
!لجمع القوّة من الجميع

74
00:06:49,320 --> 00:06:50,680
...نحن أيضاً نريد

75
00:06:50,680 --> 00:06:53,130
!أن نكون أصدقاء مع كو-تشان

76
00:06:55,360 --> 00:06:56,920
!أرجوكِ يا أنا

77
00:06:56,920 --> 00:06:58,560
!امنحوا القوّة لسيّدتي

78
00:06:58,560 --> 00:06:59,470
!إيرنست

79
00:06:59,470 --> 00:07:01,250
!الأمر بيديكِ يا إمبراطورة

80
00:07:01,250 --> 00:07:02,810
!نالي منها يا أنا

81
00:07:02,810 --> 00:07:04,150
أترك الباقي لك

82
00:07:12,160 --> 00:07:15,160
!انطلق

83
00:07:15,160 --> 00:07:16,990
أمعني النظر يا كو

84
00:07:17,490 --> 00:07:19,410
هذه قوّة البشر

85
00:07:45,400 --> 00:07:46,360
كو

86
00:07:47,370 --> 00:07:49,520
خسرت

87
00:07:50,000 --> 00:07:51,400
صحيح

88
00:07:51,400 --> 00:07:54,710
خيّبت أملك يا والدي

89
00:07:54,710 --> 00:07:57,380
يُتخلّى عن الأطفال الضعفاء، صحيح؟

90
00:07:57,380 --> 00:07:59,150
لن أفعل ذلك

91
00:08:00,620 --> 00:08:03,550
كما أنّكِ أخطأتِ في أمر

92
00:08:03,550 --> 00:08:05,430
،لم يكن أنّكِ ضعيفة

93
00:08:07,370 --> 00:08:09,160
بل كان البشر أقوى

94
00:08:11,630 --> 00:08:13,760
حسناً؟ هل تعترفين بالهزيمة؟

95
00:08:14,560 --> 00:08:15,330
أجل

96
00:08:15,810 --> 00:08:18,640
أيعني ذلك بإمكانكِ مصادقتهم؟

97
00:08:22,940 --> 00:08:26,060
ر-ربما سأفعل إن كنت مصرّاً

98
00:08:26,060 --> 00:08:27,930
...لا أمانع أن أصبح صديقتكم

99
00:08:27,930 --> 00:08:28,970
!أنت

100
00:08:28,970 --> 00:08:30,440
!ليس هكذا

101
00:08:32,430 --> 00:08:33,450
...أ

102
00:08:34,000 --> 00:08:35,860
...كـ-كونوا

103
00:08:38,950 --> 00:08:41,950
!أصدقائي رجاءً

104
00:08:46,800 --> 00:08:48,290
!بالطبع

105
00:08:54,640 --> 00:08:55,860
!لنكن على وفاقٍ يا كو-تشان

106
00:08:55,860 --> 00:08:57,570
!يا لظرافتها

107
00:08:58,990 --> 00:09:00,410
!توخّوا الحذر

108
00:09:03,940 --> 00:09:05,730
معنويّاتك عاليةٌ يا غيل

109
00:09:06,170 --> 00:09:08,660
ما الذي تخطّط له الآن؟

110
00:09:08,660 --> 00:09:11,420
يسرّني رؤية نموّ تلامذتي

111
00:09:11,420 --> 00:09:15,740
نظراً لقدرتهم على استعمال روحهم
،القتالية وطاقتهم الروحيّة الآن

112
00:09:15,740 --> 00:09:19,740
جهّزتُ طريقة تمرين ملموسة أكثر

113
00:09:19,740 --> 00:09:21,740
تقصد ذاك الجهاز؟

114
00:09:21,740 --> 00:09:22,880
أجل

115
00:09:22,880 --> 00:09:28,750
يُدعى بالواقع الافتراضيّ، وتمّ صنعه باستعمال
فرع مفقود من السحر يُدعى بالعلم

116
00:09:30,530 --> 00:09:33,040
!أتحرّق شوقاً لاكتماله

117
00:09:41,510 --> 00:09:43,560
كو-تشان، كو-تشان

118
00:09:43,560 --> 00:09:45,340
هاكِ، افتحي فمك

119
00:09:45,770 --> 00:09:48,900
!يـ-يمكنني إطعام نفسي بنفسي

120
00:09:48,900 --> 00:09:51,990
في تلك الحالة، هل ستجلسين بمفردك؟

121
00:09:53,300 --> 00:09:55,300
!هيّا، افتحي فمك

122
00:09:56,860 --> 00:09:58,820
فقط هذه المرّة

123
00:10:00,980 --> 00:10:02,750
!يا لظرافتها

124
00:10:03,370 --> 00:10:04,640
!تعالي

125
00:10:04,640 --> 00:10:05,790
!اجلسي هنا

126
00:10:05,790 --> 00:10:06,950
!هنا

127
00:10:06,950 --> 00:10:09,330
!أنتِ كثيرة الطلبات حقّاً

128
00:10:11,400 --> 00:10:13,180
!يا لظرافتك! يا لظرافتك

129
00:10:13,180 --> 00:10:14,710
!احتضان! احتضان

130
00:10:15,130 --> 00:10:18,400
!كلير! توقّفي

131
00:10:18,400 --> 00:10:19,800
...اسمعي يا إيرنست

132
00:10:21,140 --> 00:10:23,470
أهنالك أمرٌ مختلف فيك؟

133
00:10:26,640 --> 00:10:27,930
!بليد

134
00:10:27,930 --> 00:10:29,740
...ذلك ليس

135
00:10:30,640 --> 00:10:32,480
!لا يمكنك قول ذلك يا بليد-كن

136
00:10:32,480 --> 00:10:35,020
أنت فظيعٌ بحقّ

137
00:10:35,730 --> 00:10:39,080
حسناً... لم تتغيّري أبداً

138
00:10:39,080 --> 00:10:40,490
!بل تغيّرت

139
00:10:40,770 --> 00:10:42,370
!تغيّرت بالتأكيد

140
00:10:42,780 --> 00:10:45,140
لا تهتمّي لكلامه سيّدتي

141
00:10:45,610 --> 00:10:47,080
!أنتِ بنفس الجمال بعد بدانتك

142
00:10:47,080 --> 00:10:49,000
!لا تقل ذلك

143
00:10:49,000 --> 00:10:50,440
!أجل

144
00:10:50,440 --> 00:10:51,770
!كان وزنكِ

145
00:10:51,770 --> 00:10:53,290
!أصبحتِ بدينة

146
00:10:53,290 --> 00:10:56,300
!ظننتُ أنّكِ أصبحتِ أكبر

147
00:10:56,300 --> 00:10:58,040
!فـ-فهمت

148
00:10:58,040 --> 00:11:00,330
!أهنالك داعٍ للتركيز على الأمر؟

149
00:11:00,330 --> 00:11:02,930
!بليد، أيّها الأحمق

150
00:11:05,200 --> 00:11:06,680
مُذنب

151
00:11:08,800 --> 00:11:10,570
!كنتُ مخطئاً

152
00:11:10,570 --> 00:11:13,010
لن أستغرب لو انتهت علاقتكما كليّاً

153
00:11:13,010 --> 00:11:14,630
انتهت؟

154
00:11:18,980 --> 00:11:21,700
هوّن عليك يا والدي

155
00:11:22,400 --> 00:11:24,990
بليد-كن متأثّر بوطأة الأمر

156
00:11:24,990 --> 00:11:28,700
مضت ثلاثة أيّام مذ احتجزت
أنّا نفسها في غرفتها

157
00:11:30,190 --> 00:11:34,400
"من كان يعلم أنّ معنى "انتهت
هو أنّي لن ألتقيها من جديد؟

158
00:11:34,400 --> 00:11:35,500
ليس كذلك

159
00:11:36,360 --> 00:11:38,710
ما معنى "انتهت" إذاً؟

160
00:11:39,040 --> 00:11:44,220
"!إنّه "لم نعد صديقين، انتهت صداقتنا

161
00:11:44,220 --> 00:11:45,840
!ماذا؟

162
00:11:45,840 --> 00:11:48,340
!لا! لا أريد ذلك أبداً

163
00:11:48,340 --> 00:11:51,480
!أودّ البقاء صديقاً لإيرنست

164
00:11:51,480 --> 00:11:54,130
هل ستسامحني إن اعتذرت؟

165
00:11:54,130 --> 00:11:55,520
!سأذهب وأتأسف لها

166
00:11:55,520 --> 00:11:56,940
!انتظر

167
00:11:57,300 --> 00:12:01,220
بليد-كن، لا تعرب سبب
غضب أنّا منك، صحيح؟

168
00:12:02,000 --> 00:12:05,140
ستجعلها تغضب أكثر وحسب

169
00:12:06,720 --> 00:12:07,880
أجل

170
00:12:07,880 --> 00:12:10,490
لذا سنرافقك أيضاً

171
00:12:10,490 --> 00:12:13,670
أجل، أنا قلقةٌ على حال أنّا

172
00:12:13,670 --> 00:12:15,830
ولأنّنا أصدقاء بالطبع

173
00:12:15,830 --> 00:12:16,890
!أجل

174
00:12:18,750 --> 00:12:20,590
!شكراً لكنّ

175
00:12:23,730 --> 00:12:24,840
أأنتِ متفرّغة؟

176
00:12:25,350 --> 00:12:28,680
أتى بليد-كن للاعتذار عمَّ قاله

177
00:12:32,840 --> 00:12:34,850
أنّا، سأفتح الباب

178
00:12:46,350 --> 00:12:47,370
...أنّا

179
00:12:47,840 --> 00:12:49,340
أأنتِ تبكين؟

180
00:12:49,340 --> 00:12:50,510
أكلّ شيءٍ على ما يرام؟

181
00:12:51,030 --> 00:12:52,370
أيمكننا الدخول؟

182
00:12:56,370 --> 00:12:58,840
!تبدو لذيذة

183
00:12:59,220 --> 00:13:01,870
!دعيني أتناول منها أيضاً

184
00:13:01,870 --> 00:13:03,580
!لديكِ الكثير

185
00:13:01,870 --> 00:13:03,580
!لحظة، ماذا؟

186
00:13:03,580 --> 00:13:05,290
!يمكنكِ التنازل عن بعضها

187
00:13:03,580 --> 00:13:05,290
كو-تشان، يمكنكِ الرؤية هكذا؟

188
00:13:05,290 --> 00:13:06,340
!أعطني إيّاها

189
00:13:05,290 --> 00:13:06,340
!فليدر أحدٌ الأضواء

190
00:13:08,850 --> 00:13:10,740
!لا-لا تنظروا

191
00:13:10,740 --> 00:13:14,350
!لا تنظروا لي رجاءً

192
00:13:14,730 --> 00:13:16,230
!هذه الحلويات لذيذةٌ جدّاً

193
00:13:16,230 --> 00:13:17,410
...هذه الحلويّات

194
00:13:17,410 --> 00:13:19,360
ذلك السبب إذاً

195
00:13:19,360 --> 00:13:22,750
...مُذ قتالنا ضدّ كو-تشان

196
00:13:22,750 --> 00:13:25,350
بدأتُ أشعر بالجوع طوال الوقت

197
00:13:25,350 --> 00:13:26,680
...كما

198
00:13:27,130 --> 00:13:31,370
لم أدرك قبلاً تواجد كلّ
!هذا الطعام اللذيذ

199
00:13:32,000 --> 00:13:33,630
...اسمعي يا إيرنست

200
00:13:33,630 --> 00:13:35,420
دعيني أسألكِ عن شيء

201
00:13:35,420 --> 00:13:38,190
هل انتهت علاقتنا كصديقين؟

202
00:13:38,190 --> 00:13:39,380
!لا-لا

203
00:13:39,380 --> 00:13:43,640
لم أرد... أن تراني هكذا

204
00:13:43,640 --> 00:13:46,060
فلم أستطع الكلام معك

205
00:13:46,980 --> 00:13:48,360
!فهمت

206
00:13:48,360 --> 00:13:50,260
!أي أنّنا لم ننتهِ إذاً

207
00:13:50,260 --> 00:13:51,380
حمداً لله

208
00:13:51,380 --> 00:13:52,210
سأغادر إذاً

209
00:13:52,210 --> 00:13:53,730
!انتظر مكانك

210
00:13:53,730 --> 00:13:55,930
!لا يمكن أنّك جاد يا بليد-كن

211
00:13:55,930 --> 00:13:58,880
إن غادرت الآن، سيصبح حال
!أنّا ميؤوساً منه

212
00:13:58,880 --> 00:14:00,180
!شيء لطيف

213
00:14:00,180 --> 00:14:02,860
...عليك قول شيء لطيف، وإلّا

214
00:14:03,360 --> 00:14:04,820
شيء لطيف؟

215
