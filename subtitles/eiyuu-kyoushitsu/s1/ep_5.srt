1
00:00:01,420 --> 00:00:03,680
أنت تحقّق تقدّماً جيّداً

2
00:00:03,680 --> 00:00:06,150
أعتقد أنّك عند قرابة 30% الآن

3
00:00:06,470 --> 00:00:08,900
أيعني ذلك أنّ بإمكاني
أستعمال قواي من جديد؟

4
00:00:08,900 --> 00:00:10,000
كلّا

5
00:00:10,000 --> 00:00:14,320
%يعني أنّك ستموت إن استعملت 30
مما كانت قوّتك الكاملة

6
00:00:14,320 --> 00:00:15,590
!ماذا؟

7
00:00:17,250 --> 00:00:18,500
بليد-كن

8
00:00:19,990 --> 00:00:21,690
ما الخطب؟

9
00:00:23,910 --> 00:00:25,420
هذه ماريا

10
00:00:25,420 --> 00:00:26,940
...إنّها صديقتي، و

11
00:00:26,940 --> 00:00:28,380
!أتذكّرها

12
00:00:28,650 --> 00:00:31,340
كانت في كتيبة السحر عندما قاتلنا كو

13
00:00:31,720 --> 00:00:32,340
...أجل

14
00:00:32,340 --> 00:00:34,720
تعثّرت طوال الوقت أثناء التمرين

15
00:00:34,720 --> 00:00:38,100
وفي القتال الفعليّ، أعتقد أنّها
أطلقت كرة ناريّة في الاتّجاه الخاطئ

16
00:00:38,100 --> 00:00:39,810
!مهلاً! بليد-كن

17
00:00:39,810 --> 00:00:42,320
بمَ نطلق على الأشخاص مثلها من جديد؟

18
00:00:43,470 --> 00:00:44,480
!وجدتُها

19
00:00:44,480 --> 00:00:46,170
!خرقاء! أجل، خرقاء

20
00:00:47,070 --> 00:00:48,750
آسف

21
00:00:48,750 --> 00:00:50,270
...لا بأس

22
00:00:50,270 --> 00:00:52,150
من الصحيح أنّي خرقاء

23
00:00:52,150 --> 00:00:56,030
يبدو أنّ لديها معروفاً تودّ طلبه منك

24
00:00:56,480 --> 00:00:57,450
منّي؟

25
00:00:57,450 --> 00:00:59,170
أ-أجل

26
00:00:59,170 --> 00:01:00,360
...بليد-سان

27
00:01:00,360 --> 00:01:01,660
...هلّا

28
00:01:02,770 --> 00:01:04,550
قتلتني؟

29
00:01:05,440 --> 00:01:07,100
!لا

30
00:01:07,100 --> 00:01:11,080
أعني أنّي أودّ منك قتلي عندما
!أفقد السيطرة على نفسي

31
00:01:11,080 --> 00:01:12,920
ما قصدك بذلك؟

32
00:01:12,920 --> 00:01:17,380
أنا، في الواقع... لست بشريّة

33
00:01:17,380 --> 00:01:17,890
ماذا؟

34
00:01:18,120 --> 00:01:19,850
أجل، أنتِ شيطانة ليليّة، صحيح؟

35
00:01:20,150 --> 00:01:21,620
ذلك واضح لك؟

36
00:01:21,620 --> 00:01:22,810
حسناً، كان لديّ حدس

37
00:01:23,520 --> 00:01:27,120
يوجد شيءٌ آخر داخلي

38
00:01:27,120 --> 00:01:30,190
وحش سحريّ بقوّة مخيفة

39
00:01:31,250 --> 00:01:35,190
،حصل في مرّة واحدة في الماضي
...عندما كنتُ أمرّ بوقتٍ عصيب

40
00:01:37,710 --> 00:01:39,450
!آسفة! أسفة

41
00:01:39,450 --> 00:01:42,120
هذا ما يحصل عندما
!لا أستطيع التحكّم بقوّتي

42
00:01:42,600 --> 00:01:44,130
لا بأس يا ماريا

43
00:01:44,130 --> 00:01:45,430
اهدئي

44
00:01:45,430 --> 00:01:48,080
تمكّنتُ من قمعها حتّى الآن بشكلٍ ما

45
00:01:48,480 --> 00:01:52,040
لكن مُذ حينذاك، لم أعد قادرة
على قمعها كلّياً

46
00:01:52,040 --> 00:01:54,560
تقصدين مُذ قتالنا لكو؟د

47
00:01:54,560 --> 00:01:57,740
المساس بالروح القتاليّة التي تدفقت
عبر مسارات طاقتك السحريّة

48
00:01:57,740 --> 00:01:59,800
تسبّبت بفقدانك للسيطرة على قواك

49
00:01:59,800 --> 00:02:03,180
،تفصدين أنّه ما لم نفعل شيئاً
سيخرج الوحوش ويثير الخراب؟

50
00:02:03,600 --> 00:02:04,440
أجل

51
00:02:04,440 --> 00:02:08,690
لكن لا مكان آخر أذهب إليه
إن طُردت من الأكاديميّة

52
00:02:08,690 --> 00:02:12,360
كانت ماريا في مدرسة روزوود
الإعداديّة بالأصل مثلي

53
00:02:13,120 --> 00:02:16,860
اجتهدت كثيراً لمدّة طويلة
للالتحاق بهذه الأكاديميّة

54
00:02:17,230 --> 00:02:19,890
رحل أبي وأمّي

55
00:02:19,890 --> 00:02:21,820
لا أمتلك منزلاً أرجع له

56
00:02:22,120 --> 00:02:25,830
!لذا عليّ فعل شيءٍ حيال هذه القوّة

57
00:02:26,380 --> 00:02:27,550
فهمت

58
00:02:27,550 --> 00:02:30,260
أعرف شعور عدم امتلاك والدين أيضاً

59
00:02:30,260 --> 00:02:31,200
سأساعدكِ

60
00:02:31,200 --> 00:02:32,290
وأنا أيضاً

61
00:02:32,290 --> 00:02:33,920
لم أعرف أبي أو أمّي قطّ

62
00:02:33,920 --> 00:02:35,300
سأساعدك أيضاً

63
00:02:35,300 --> 00:02:36,200
!نحن كذلك

64
00:02:36,200 --> 00:02:37,340
وأنا أيضاً بالطبع

65
00:02:37,340 --> 00:02:39,830
!أنا صديقة ماريا الآن

66
00:02:39,830 --> 00:02:42,050
!من الطبيعيّ مساعدة الصديق

67
00:02:42,560 --> 00:02:43,880
!مـ-مهلاً

68
00:02:43,880 --> 00:02:45,890
!أودّ المساعدة بدوري

69
00:02:47,360 --> 00:02:49,770
!شكراً جزيلاً لكم جميعاً

70
00:02:52,190 --> 00:02:53,380
حاجز سحريّ؟

71
00:02:53,380 --> 00:02:55,520
لحظة، ما مقدار هذه القوّة؟

72
00:02:55,520 --> 00:02:58,450
طلبتُ من كلير ويشيكا تعديلها

73
00:02:58,450 --> 00:03:00,290
فيُفترض أن تكون للحدّ الأقصى

74
00:03:00,290 --> 00:03:01,360
!مرحى

75
00:03:01,360 --> 00:03:03,190
لم تطلب الإذن، صحيح؟

76
00:03:03,190 --> 00:03:05,280
حسناً، اكتملت التجهيزات

77
00:03:06,670 --> 00:03:08,880
،كنتِ تقمعين قواكِ طوال الوقت يا ماريا

78
00:03:08,880 --> 00:03:11,600
لذا رأيتُ أنّ بإمكانك محاولة
تحريرها لهذه المرّة

79
00:03:11,600 --> 00:03:12,230
!كلّا

80
00:03:12,230 --> 00:03:13,000
!لا أستطيع

81
00:03:13,000 --> 00:03:15,050
لذا حضّرنا لكلّ هذا

82
00:03:15,050 --> 00:03:17,790
إيرنست برهان حيّ على
إمكانيّة نجاح الأمر

83
00:03:17,790 --> 00:03:19,010
حسناً، ربما ذلك

84
00:03:19,010 --> 00:03:20,790
!لا يمكنني فعل ذلك قطعاً

85
00:03:20,790 --> 00:03:23,290
!عليّ ألّا أحرّر هذه القوّة

86
00:03:23,290 --> 00:03:26,310
...يجب أن أبقيها محتجزةً لبقيّة حياتي

87
00:03:27,890 --> 00:03:29,070
ماريا

88
00:03:29,070 --> 00:03:31,760
لمَ لا تتبعي اقتراح بليد؟

89
00:03:31,760 --> 00:03:34,150
أنقذني ذلك قبلاً

90
00:03:35,900 --> 00:03:38,100
لكنّها طريقة غبيّة نوعاً ما

91
00:03:38,100 --> 00:03:39,360
!لا تدعيها بالغبيّة

92
00:03:39,360 --> 00:03:41,770
!أيّ جزء منها ليس غبيّاً يا غبيّ؟

93
00:03:41,770 --> 00:03:43,530
!اصمتي يا غبيّة

94
00:03:46,340 --> 00:03:47,670
فهمت

95
00:03:47,670 --> 00:03:50,540
سأؤمن ببليد-سان والجميع

96
00:03:51,660 --> 00:03:54,200
سأعتمد عليكم إن ساءت الأمور

97
00:03:54,200 --> 00:03:55,930
أجل، نحن لها

98
00:03:55,930 --> 00:03:57,210
حسناً، ها أنا ذي

99
00:04:01,300 --> 00:04:04,590
تحصر كلّ من هذه قوّتي بالنصف

100
00:04:05,420 --> 00:04:06,510
واحدة أخرى

101
00:04:07,340 --> 00:04:08,390
أصبحت قوّتي أربعة أضعافٍ الآن

102
00:04:08,390 --> 00:04:09,810
وأخرى

103
00:04:10,550 --> 00:04:11,430
ثمان مرّات

104
00:04:11,950 --> 00:04:13,020
!ستّ عشرة مرّة؟

105
00:04:14,530 --> 00:04:15,480
...وأخيراً

106
00:04:16,030 --> 00:04:19,000
هذه أقوى أداة ختم

107
00:04:19,000 --> 00:04:21,690
والتي تقيّد قوّتي للعشر

108
00:04:22,630 --> 00:04:23,690
...مما يعني

109
00:04:23,690 --> 00:04:24,990
مئة وستّون مرّة

110
00:04:25,930 --> 00:04:26,870
!ماريا، انتظري

111
00:04:26,870 --> 00:04:27,720
ماذا؟

112
00:04:32,130 --> 00:04:33,090
...إنّها

113
00:04:33,500 --> 00:04:34,850
!إنّها على وشك الخروج

114
00:04:34,850 --> 00:04:36,880
!كلّا! لا أستطيع قمعها

115
00:04:37,180 --> 00:04:38,090
!لا تفعلي

116
00:04:38,460 --> 00:04:40,090
!سنتدبّر أمرها

117
00:04:40,400 --> 00:04:42,550
!ثقي بأصدقائكِ

118
00:05:00,890 --> 00:05:02,570
...بليد، ذلك

119
00:05:08,190 --> 00:05:09,490
...ملك الشياطين

120
00:05:17,460 --> 00:05:18,900
!انحنوا أمامي

121
00:05:18,900 --> 00:05:21,180
!هابوني! اعبدوني

122
00:05:21,180 --> 00:05:26,430
ابتهجوا بمولد ملك الشياطين
!بصيحات النواح والكراهيّة

123
00:05:26,840 --> 00:05:28,010
أهذه ملك الشياطين؟

124
00:05:28,010 --> 00:05:29,230
كلّا

125
00:05:29,230 --> 00:05:31,720
...لكن الشعار الشيطانيّ على جبهتها

126
00:05:31,720 --> 00:05:34,680
!التهم لحمي يا أسمودوس

127
00:05:43,650 --> 00:05:44,690
!سيّدتي

128
00:05:44,690 --> 00:05:46,980
!كيف تجرؤين؟

129
00:05:50,520 --> 00:05:51,870
أهذا كلّ سيء؟

130
00:06:01,500 --> 00:06:05,630
قوّة البطل العظيم الاصطناعيّة: الجاذبيّة المُطلقة

131
00:06:08,520 --> 00:06:11,320
لا يمكنني الحركة بعد ذلك

132
00:06:11,320 --> 00:06:13,060
...أترك الباقي لكم

133
00:06:13,500 --> 00:06:15,970
حسناً إذاً، أأنتم جاهزون؟

134
00:06:24,140 --> 00:06:25,150
حارّ جدّاً

135
00:06:28,640 --> 00:06:29,570
هاك

136
00:06:29,570 --> 00:06:30,660
سأعيدها لك

137
00:06:42,670 --> 00:06:44,610
أأنت الأخير؟

138
00:06:44,610 --> 00:06:45,360
حسناً

139
00:06:45,360 --> 00:06:48,800
بعدما أخرج من هنا، سأدمّر العاصمة الملكيّة

140
00:06:53,470 --> 00:06:55,220
ما معنى هذا؟

141
00:06:55,550 --> 00:06:58,530
لا تخبرني أنّك تحاول أخذ
ملك الشياطين على قيد الحياة؟

142
00:06:58,530 --> 00:06:59,580
كشفتِني؟

143
00:07:01,640 --> 00:07:03,190
أنت طريف

144
00:07:03,600 --> 00:07:05,040
قاتلني بجدّية

145
00:07:05,040 --> 00:07:06,320
وإلّا سأقتلك

146
00:07:08,620 --> 00:07:10,680
أنا هنا لقلتك

147
00:07:10,680 --> 00:07:13,990
إذا لم تنوِ قتلي، فسأحرص على موتك

148
00:07:15,180 --> 00:07:16,940
!لا تستسلم يا جسدي

149
00:07:25,000 --> 00:07:26,540
أهذا كلّ ما لديك؟

150
00:07:26,540 --> 00:07:28,710
في تلك الحالة، حان دوري

151
00:07:28,990 --> 00:07:30,920
لا تمت بضربة واحدة

152
00:07:30,920 --> 00:07:32,090
!لحظة، انتظري

153
00:07:32,090 --> 00:07:33,090
شعاع الشمس

154
00:07:44,140 --> 00:07:45,940
لا تزال حيّاً؟

155
00:07:47,090 --> 00:07:47,900
بليد

156
00:07:48,150 --> 00:07:50,110
!إيرنست! لا تضغطي على نفسك

157
00:07:50,760 --> 00:07:53,070
...خذ هذا

158
00:07:58,780 --> 00:08:00,290
أسمودوس

159
00:08:00,290 --> 00:08:02,250
،هذا يُخالف إرادتي

160
00:08:02,250 --> 00:08:04,080
لكنّها إرادة سيّدي

161
00:08:04,080 --> 00:08:06,540
سأعتبره عقداً محدوداً

162
00:08:06,540 --> 00:08:09,310
عجباً، ذلك سلاحٌ ممتاز

163
00:08:09,310 --> 00:08:12,170
يبدو أنّ بإمكاني توقّع قتال مسلٍّ

164
00:08:12,170 --> 00:08:15,270
آسف، لا أقاتل لتسلية أحد

165
00:08:16,090 --> 00:08:18,180
سأنهي الأمر بضربة واحدة

166
00:08:18,180 --> 00:08:20,970
تخال أنّ بإمكانك هزيمة ملك
الشياطين بضربة واحدة؟

167
00:08:20,970 --> 00:08:22,040
!مثير

168
00:08:22,040 --> 00:08:23,020
!فلترني إذاً

169
00:08:31,080 --> 00:08:32,160
!تـ-توقّف

170
00:08:32,160 --> 00:08:34,860
لستُ متأكداً ما إن كان بالإمكان
!تحمّل هذه القوّة، حتّى لي

171
00:08:34,860 --> 00:08:36,790
كفّ عن التذمّر

172
00:08:36,790 --> 00:08:39,790
أنت سيف إيرنست، فتحمّل الأمر بقوّة إرادتك

173
00:08:39,790 --> 00:08:40,370
!ها أنا ذا

174
00:08:40,960 --> 00:08:42,000
!سيف الشيطان المُقدّس

175
00:08:42,730 --> 00:08:43,790
!تعال

176
00:08:50,550 --> 00:08:52,340
مُبهر حقّاً

177
00:08:56,360 --> 00:08:57,890
!لا-لا يمكن

178
00:08:58,630 --> 00:09:00,660
!قوّة تفوق قوّتي؟

179
00:09:00,660 --> 00:09:01,790
!تبّاً لك

180
00:09:01,790 --> 00:09:03,930
!من تكون؟

181
00:09:04,400 --> 00:09:06,380
مجرّد شخص عاديّ

182
00:09:06,380 --> 00:09:07,560
!كذلك الآن على الأقلّ

183
00:09:29,940 --> 00:09:33,670
...يسرّني أنّه لم يمت أحد

184
00:09:34,750 --> 00:09:35,420
ماذا؟

185
00:09:45,080 --> 00:09:46,310
...أنا

186
00:09:50,730 --> 00:09:53,190
!أحمق

187
00:09:53,190 --> 00:09:54,860
!أحمق! أحمق! أحمق

188
00:09:54,860 --> 00:09:57,070
!لا داعي لتتهوّر بعد الآن

189
00:09:57,070 --> 00:09:59,460
!لمَ تجعلني أقلق هكذا دوماً؟

190
00:09:59,460 --> 00:10:00,490
...حسناً

191
00:10:00,490 --> 00:10:02,950
!لقد متّ

192
00:10:03,830 --> 00:10:07,500
!لو تأخرتُ ولو للحظات، لكان الأوان قد فان

193
00:10:07,500 --> 00:10:10,490
وعدتني في المرّة الأخيرة أنّك
!لن تجعلني أبكي من جديد

194
00:10:10,490 --> 00:10:11,460
!أيّها الكاذب

195
00:10:14,770 --> 00:10:15,850
آسف

196
00:10:15,850 --> 00:10:17,390
سأتوخّى الحذر من الآن فصاعداً

197
00:10:18,610 --> 00:10:19,260
كيف الجميع؟

198
00:10:19,710 --> 00:10:20,960
سيكونون بخير

199
00:10:20,960 --> 00:10:23,010
تقوم كلير بمعالجتهم الآن

200
00:10:23,010 --> 00:10:24,390
فهمت

201
00:10:25,710 --> 00:10:26,980
وماذا عنها؟

202
00:10:27,930 --> 00:10:29,010
إنّها على قيد الحياة

203
00:10:31,680 --> 00:10:34,980
!آسفة! آسفة! آسفة

204
00:10:32,740 --> 00:10:34,980
مُبهر حقّاً

205
00:10:35,830 --> 00:10:38,660
!صباح الخير

206
00:10:38,660 --> 00:10:39,910
!صـ-صباح الخير

207
00:10:41,730 --> 00:10:42,870
صباح الخير

208
00:10:43,750 --> 00:10:44,870
مرحباً، صباح الخير

209
00:10:44,870 --> 00:10:46,300
...صباح الخير أيّها البطل

210
00:10:48,320 --> 00:10:50,210
كنتُ محقّة إذاً

211
00:10:50,210 --> 00:10:53,040
لديّ ما أستغلّه ضدّك الآن

212
00:10:53,040 --> 00:10:55,050
توقّفي يا ماريا، جدّياً

213
00:10:55,300 --> 00:10:58,320
ماريا شخصيّة مختلفة

214
00:10:58,320 --> 00:10:59,580
من تكونين إذاً؟

215
00:10:59,580 --> 00:11:02,290
لا أمتلك... اسماً

216
00:11:03,040 --> 00:11:05,510
لم يسمّني أحد

217
00:11:05,960 --> 00:11:06,990
!ماوو-تشان

218
00:11:06,990 --> 00:11:08,720
!صباح الخير يا ماوو-تشان

219
00:11:08,720 --> 00:11:09,600
صباح الخير

220
00:11:10,690 --> 00:11:12,060
ماوو-تشان؟

221
00:11:12,960 --> 00:11:14,020
صحيح

222
00:11:14,480 --> 00:11:17,730
أنا من رحّب بانضمام ماريا-كن لهذه المدرسة

223
00:11:18,220 --> 00:11:20,220
أدرك هويّتها

224
00:11:21,730 --> 00:11:24,140
كانت أمّ ماريا-كن بشريّة

225
00:11:24,140 --> 00:11:27,200
فارقت الحياة للأسف

226
00:11:27,200 --> 00:11:28,330
ووالدها؟

227
00:11:28,540 --> 00:11:30,350
مصيره مجهول

228
00:11:30,350 --> 00:11:33,290
لكنّنا نعرف من يكون

229
00:11:35,500 --> 00:11:38,800
كان والدها يُعرف بملك الشياطين قبلاً

230
00:11:39,710 --> 00:11:44,220
مما يعني أنّها ابنة ملك الشياطين

231
00:11:51,500 --> 00:11:53,730
اعتادت على الحياة هنا حقّاً

232
00:11:53,730 --> 00:11:56,030
لكنّها خطرة، صحيح؟

233
00:11:56,030 --> 00:11:57,770
هل من الحسن تركها تحوم بحرّية هكذا؟

234
00:11:57,770 --> 00:11:59,340
...حسناً

235
00:11:59,340 --> 00:12:01,860
قرّر جلالة الملك تحريرها

236
00:12:01,860 --> 00:12:05,800
"!وقال "سأتحمّل كافّة المسؤولية

237
00:12:07,130 --> 00:12:10,500
بقمع قواي الآن، أنا محض فتاة عاديّة

238
00:12:10,920 --> 00:12:13,330
إن أخبرتموني بارتياد المدرسة، فسأفعل ذلك

239
00:12:13,650 --> 00:12:16,540
وإن أخبرتموني بارتداء رداء مكشكش، فسأفعل بطواعية

240
00:12:16,540 --> 00:12:20,930
تقولين ذلك، لكن ألستِ تريدين ارتداء
ثياب ظريفة في الواقع وحسب؟

241
00:12:20,930 --> 00:12:21,910
!توقّفي يا يشيكا

242
00:12:21,910 --> 00:12:23,050
!لا تغضبيها

243
00:12:24,560 --> 00:12:27,510
لأصارحكم، فهي تجعل قلبي يرفرف

244
00:12:28,040 --> 00:12:30,520
هذا الرداء المكشكش مميّز حقّاً

245
00:12:36,430 --> 00:12:37,430
!ماو

246
00:12:37,430 --> 00:12:39,940
!أرجعي الفتيات إلى فصولهن

247
00:12:40,200 --> 00:12:42,400
لم أطلب منهنّ القدوم هنا

248
00:12:42,700 --> 00:12:44,770
لمَ تنادونها بماو؟

249
00:12:44,770 --> 00:12:47,010
اعتبره لقباً

250
00:12:47,010 --> 00:12:50,120
يناديها الجميع بماوو-تشان، لكنّ ماو أقصر

251
00:12:50,120 --> 00:12:51,240
فهمت

252
00:12:51,240 --> 00:12:54,060
أجل، أنا قويّة، وكريمة أيضاً

253
00:12:54,060 --> 00:12:56,530
سأسمح لهذه الفتاة الصغيرة بمناداتي بماو

254
00:12:56,530 --> 00:12:58,760
!التنانين هي الأقوى

255
00:12:58,760 --> 00:13:00,130
ما الذي قلتِه يا هذه؟

256
00:13:00,130 --> 00:13:01,780
أتودّين إعادة النزال؟

257
00:13:02,490 --> 00:13:04,120
!والدي

258
00:13:06,460 --> 00:13:07,580
يكفي

259
00:13:07,580 --> 00:13:08,890
انتهى وقت الاستراحة

260
00:13:08,890 --> 00:13:11,760
أيّها البطل... أقصد، يا بليد

261
00:13:11,760 --> 00:13:14,770
سأرحّب بإعادة نزالنا
في أيّ وقت

262
00:13:15,460 --> 00:13:17,230
حسناً إذاً، هيّا بنا

263
00:13:19,690 --> 00:13:20,740
...المعذرة

264
00:13:20,740 --> 00:13:23,280
ماو وماريا شخصيّتان مختلفتان، صحيح؟

265
00:13:23,550 --> 00:13:24,300
أجل

266
00:13:24,790 --> 00:13:28,300
كيف لم تظهر ماريا نفسها
مذ آنذاك إذاً؟

267
00:13:28,300 --> 00:13:29,490
...معكِ حقّ

268
00:13:30,020 --> 00:13:31,950
أشعر بالخوف

269
00:13:31,950 --> 00:13:34,960
أخشى أنّنا لن نرى ماريا من جديد

270
00:13:48,650 --> 00:13:51,100
صباح الخير أيّها البطل العظيم بليد

271
00:13:51,580 --> 00:13:52,820
!ليس صحيحاً

272
00:13:52,820 --> 00:13:54,090
فهمت

273
00:13:54,090 --> 00:13:56,080
"ربما عليّ قول "طاب مساؤك

274
00:13:56,080 --> 00:13:58,060
إذاً؟ ما الذي تريدينه؟

275
00:13:58,060 --> 00:14:01,050
أجل، أتيتُ لدعوتك

276
00:14:01,050 --> 00:14:03,300
سمعتُ من إحدى الزميلات

277
00:14:03,300 --> 00:14:05,320
...أظنّها دعته بـ

278
00:14:05,320 --> 00:14:06,570
!أجل، موعد

279
00:14:06,570 --> 00:14:07,980
ماذا؟

280
00:14:07,980 --> 00:14:08,720
!اسمعي

281
00:14:08,720 --> 00:14:11,100
...تبدأ المواعيد عند الساعة 10:00

282
00:14:11,100 --> 00:14:12,280
!مـ-مهلاً

283
00:14:13,610 --> 00:14:14,780
انظر أيّها البطل العظيم

284
00:14:14,780 --> 00:14:16,500
القمران جميلان الليلة

285
00:14:16,730 --> 00:14:19,310
!أخبرتكِ، فلتتوقّفي عن مناداتي بالبطل

286
00:14:19,310 --> 00:14:21,710
!كما أنّ القمرين يظهران ليلاً دوماً

287
00:14:22,160 --> 00:14:25,460
أمضت ماريا معظم وقتها بالنظر للأرض

288
00:14:27,860 --> 00:14:30,780
بالمناسبة، كم عمركِ؟

289
00:14:30,780 --> 00:14:33,180
لا يبدو أنّكِ تعرفين الكثير

290
00:14:33,180 --> 00:14:37,680
بدأتُ باكتساب الوعيّ الذاتي
قبل قرابة خمسة أعوام

291
00:14:38,040 --> 00:14:39,550
ماذا؟ أنتِ في الخامسة؟

292
00:14:39,550 --> 00:14:42,150
لا يهمّ العمر لوحش سحريّ

293
00:14:42,640 --> 00:14:46,720
لكن كسيّدي، لا أٌقدّر معاملتي كطفلة

294
00:14:46,720 --> 00:14:48,110
أنتِ سيّدة الآن؟

295
00:14:49,590 --> 00:14:51,570
ألا ترى؟

296
00:14:54,320 --> 00:14:57,810
ها أنا ذي، بغاية التعلّق بك

297
00:14:57,810 --> 00:14:58,810
أحقّاً ذلك؟

298
00:14:58,810 --> 00:15:03,420
سبب بقائي في هذه المدرسة هو
أنت أيّها البطل العظيم

299
00:15:03,420 --> 00:15:06,880
بدا أنّكِ كنتِ مستمتعةً
بالحياة في الأكاديميّة

300
00:15:06,880 --> 00:15:09,040
أجل، لذلك دور

301
00:15:09,040 --> 00:15:11,150
أستمتع بذاك الرداء المكشكش

302
00:15:11,150 --> 00:15:14,800
لكنّ الوحش السحريّ يسعى للقوّة بطبيعته

303
00:15:14,800 --> 00:15:16,850
يمكنه التخلّي عن أيّ ما سواها
متى رأى ملاءمة ذلك

304
00:15:17,120 --> 00:15:21,960
ومع ذلك، أجد نفسي متعلّقةً بك
لا أسباب لا أفهمها كليّاً

305
00:15:21,960 --> 00:15:26,860
رغم أنّك أصبحت أضعف
منذ قتالنا السابق

306
00:15:26,860 --> 00:15:30,650
%أخبروني أنّي سأموت إن استعملت 15
من قوّتي المرّة القادمة

307
00:15:31,120 --> 00:15:34,320
بحالك الآن، لست خصماً جديراً بالقتل حتّى

308
00:15:34,320 --> 00:15:37,440
لكنّي عقدت عزيمتي

309
00:15:37,440 --> 00:15:40,210
لن أغادر هذا المكان حتّى أقتلك

310
00:15:40,710 --> 00:15:42,710
ذلك قاسٍ

311
00:15:43,380 --> 00:15:46,870
ليس من الحسن ألّا تدرك مشاعرك الشخصيّة

312
00:15:46,870 --> 00:15:50,630
فكّرتُ بالأمر وتوصّلت بفرضيّة

313
00:15:51,700 --> 00:15:53,090
...وهي

314
00:15:53,700 --> 00:15:58,010
لربما انجذبت لك

315
00:16:00,090 --> 00:16:01,020
!ماذا؟

316
00:16:01,020 --> 00:16:02,990
تلك محض نظريّة

317
00:16:02,990 --> 00:16:05,020
لذا أريد اختبارها

318
00:16:08,160 --> 00:16:10,350
ألن تكون شريكي؟

319
00:16:10,940 --> 00:16:15,070
...لا أفهم ما يتضمنه ذلك بالضبط

320
00:16:15,070 --> 00:16:17,040
ولا أنا

321
00:16:17,040 --> 00:16:18,480
تدرك أنّي في الخامسة

322
00:16:18,480 --> 00:16:20,950
،ألن يكون من الأسهل التوجّه لميدان اختبار

323
00:16:20,950 --> 00:16:24,600
والقتال حتّى تمتلئ رغباتنا؟

324
00:16:24,600 --> 00:16:27,440
أنت لست في حالٍ للقتال

325
00:16:27,440 --> 00:16:32,250
ناهيك عنّي لا أستطيع نزع هذه بإرادتي

326
00:16:32,250 --> 00:16:35,440
يقاوم وعي ماريا بداخلي ذلك

327
00:16:36,140 --> 00:16:38,430
إنّها بغاية الضعف، لكنّها تقاومني مع ذلك

328
00:16:40,110 --> 00:16:43,190
على الأقلّ، أفترض أنّها جلبتني لهذا العالم

329
00:16:43,190 --> 00:16:45,320
ما الذي حلّ بماريا؟

330
00:16:45,320 --> 00:16:47,710
هل كلير والبقيّة يشعرون بالقلق؟

331
00:16:47,710 --> 00:16:50,900
إنّها مختبئة في أقصى أعماق الذهن

332
00:16:53,120 --> 00:16:58,120
بخلاف ظاهرها، توجد ظلال سوداء
تنمو داخل قلب ماريا

333
00:16:58,540 --> 00:17:01,330
ازدراها وهابها البشر

334
00:17:02,030 --> 00:17:07,290
ندبت حظّها التعيش واضطرارها
للعيش في الخفاء مع أمّنا فحسب

335
00:17:08,130 --> 00:17:10,620
آمنت أمّنا بأبينا

336
00:17:10,620 --> 00:17:14,260
لكن لم تستطع ماريا الإيمان به

337
00:17:15,040 --> 00:17:19,720
بنهاية المطاف، ماتت أمّنا وغمر الشكّ ذهن ماريا

338
00:17:20,370 --> 00:17:23,650
أيمكن أنّ أبانا لم يحبّ أمّنا؟

339
00:17:23,650 --> 00:17:26,190
لمَ تخلّى عن عالم البشر؟

340
00:17:26,900 --> 00:17:30,670
أيمكن أنّ أبانا كان سبب كلّ معاناتها؟

341
00:17:31,980 --> 00:17:37,560
وُلِدت للهروب من ذاك الألم
الذي لا يُحتمل في ذهنها

342
00:17:38,080 --> 00:17:39,740
فهمت

343
00:17:39,740 --> 00:17:43,250
لذا ربما لن ترجع ماريا أبداً

344
00:17:43,250 --> 00:17:45,020
فذلك أهون عليها

345
00:17:46,410 --> 00:17:50,850
أخبرتك بكلّ هذا لأنّك أقرب
لجنسنا من البشر

346
00:17:50,850 --> 00:17:52,840
وهو أمرٌ آخر أحبّه فيك

347
00:17:53,920 --> 00:17:56,050
ذلك في الماضي الآن

348
00:17:58,820 --> 00:18:03,720
من بحثي، لا أستطيع فهم كيف تكون
تلك القلادة أداة ختم

349
00:18:04,000 --> 00:18:04,910
ماذا؟

350
00:18:04,910 --> 00:18:06,410
حسناً... من هذه؟

351
00:18:06,410 --> 00:18:07,640
...صديقة ماريا

352
00:18:07,640 --> 00:18:08,980
!إيلايزا

353
00:18:09,280 --> 00:18:11,900
أأنتِ متأكّدة أنّها ليست أداة ختم؟

354
00:18:11,900 --> 00:18:13,830
!أنا على يقين

355
00:18:13,830 --> 00:18:17,620
!إن كنتُ على خطأ، أقسم بشقّ معدتي

356
00:18:17,620 --> 00:18:19,360
!لا داعي لتبلغي ذاك الحدّ

357
00:18:19,930 --> 00:18:24,330
تقولين ذلك، لكنّي مقيّدة
من قِبل هذه الأداة بالتأكيد

358
00:18:24,820 --> 00:18:26,290
ما طبيعتها؟

359
00:18:26,520 --> 00:18:27,500
حسناً

360
00:18:27,500 --> 00:18:30,320
لم أستطع تحليلها كلّياً

361
00:18:30,320 --> 00:18:32,750
لكنّي أعتقد أنّها جهاز تسجيلٍ ما

362
00:18:33,040 --> 00:18:34,300
تسجيل؟

363
00:18:34,300 --> 00:18:36,460
يمكنكم اعتبارها مكعّب رسائل

364
00:18:36,790 --> 00:18:38,590
،هذا محض تخمين

365
00:18:38,590 --> 00:18:41,920
لكنّها قد تحتوي رسالة من الشخص
الذي أعطاكِ تلك القلادة

366
00:18:41,920 --> 00:18:45,430
وفق ذكريات ماريا، فقد كانت تذكاراً من أمّنا

367
00:18:46,710 --> 00:18:48,220
سأحذّركم بدايةً

368
00:18:48,720 --> 00:18:53,520
أعتقد أنّ ذاك التسجيل قد
يؤدي لإعادة ماريا

369
00:18:53,520 --> 00:18:55,230
...أي سيؤدي ذلك

370
00:18:55,230 --> 00:18:56,430
فهمت

371
00:18:56,430 --> 00:18:59,450
إلى هلاكي أنا، ملك الشياطين

372
00:19:00,860 --> 00:19:02,030
مثير للاهتمام

373
00:19:03,940 --> 00:19:05,990
لا تمانعين تشغيلنا له إذاً؟

374
00:19:09,250 --> 00:19:10,920
لا، تفضّلي

375
00:19:12,590 --> 00:19:14,040
في تلك الحالة، لنبدأ

376
00:19:19,240 --> 00:19:22,460
ربما كان بإمكاننا أن نصبح أصدقاء أيضاً

377
00:19:22,940 --> 00:19:24,930
...لو لم يقتضِ ذلك خسارة ماريا

378
00:19:24,930 --> 00:19:26,390
اطمئنّي

379
00:19:26,390 --> 00:19:29,770
يبدو أنّه مقدرٌ على إحدانا الاختفاء

380
00:19:29,770 --> 00:19:32,900
أنا متأكّدة أنّ المتبقيّة منّا
ستكون صديقة لكم جميعاً

381
00:19:33,750 --> 00:19:35,280
أنا جاهزةٌ الآن

382
00:19:35,760 --> 00:19:37,360
افتحي القلادة رجاءً

383
00:19:37,910 --> 00:19:38,810
حسناً

384
00:19:53,450 --> 00:19:54,520
ملك الشياطين

385
00:19:55,680 --> 00:19:57,460
هذا ملك الشياطين إذاً؟

386
00:19:57,460 --> 00:20:00,170
!ماذا؟ إنّه وسيمٌ جدّاً

387
00:20:04,560 --> 00:20:06,470
...عزيزتي إيميليا

388
00:20:06,760 --> 00:20:07,970
إيميليا؟

389
00:20:07,970 --> 00:20:09,200
ذلك اسم أمّنا

390
00:20:09,200 --> 00:20:13,080
...فلتسامحيني على تركي لكِ رجاءً

391
00:20:13,080 --> 00:20:15,000
لا، بل احقدي عليّ

392
00:20:15,440 --> 00:20:18,070
فهنالك خصمٌ عليّ قتاله

393
00:20:19,160 --> 00:20:23,510
لا أنوي جرّكِ لهذا الطريق الملطّخ بالدماء

394
00:20:23,510 --> 00:20:25,790
،قد ترينها أنانيّةً منّي

395
00:20:25,790 --> 00:20:27,510
لكن هنالك سببٌ لدعم استطاعتي

396
00:20:28,400 --> 00:20:31,620
،ربما لم تدركي بعد

397
00:20:31,620 --> 00:20:35,330
لكنّ جسدك يحوي حياة جديدة

398
00:20:35,330 --> 00:20:39,350
من كان ليعتقد أن ينجب وحش سحريّ
مثلي طفلاً من بشريّة

399
00:20:39,840 --> 00:20:43,330
سواءً كان ولداً أم بنتاً، فقد جهّزتُ اسمين

400
00:20:43,330 --> 00:20:45,340
أورتوس إن كان ولداً

401
00:20:45,340 --> 00:20:47,630
وماريا إن كان بنتاً

402
00:20:48,270 --> 00:20:52,620
بعدما يصبح الطفل قادراً
:على فهم الكلام، أخبريه بهذا

403
00:20:52,620 --> 00:20:54,020
مات والدك

404
00:21:00,640 --> 00:21:03,900
إلى متى ستختبئين هنا؟

405
00:21:04,400 --> 00:21:07,450
ليس من المسلّي هزيمة شخص
عديم الجدوى مثلك

406
00:21:08,460 --> 00:21:10,300
...أنا

407
00:21:14,090 --> 00:21:17,370
إيميليا، وطفلي الذي لم يُبصر بعد

408
00:21:17,370 --> 00:21:22,590
أقسم بشعاري الشيطانيّ بأن أواصل حبّكما

409
00:21:25,830 --> 00:21:29,840
للأبد، حتّى لو هلك جسدي

410
00:21:31,360 --> 00:21:33,200
...ماو، أنتِ

411
00:21:33,680 --> 00:21:34,450
أجل

412
00:21:34,980 --> 00:21:37,600
بالكاد بإمكاني التحكّم بجسدي الآن

413
00:21:38,310 --> 00:21:41,990
يبدو أنّ قوّة إرادتنا لها دور
في هذه المعركة أيضاً

414
00:21:42,480 --> 00:21:46,570
أثناء كلامنا، نتقاتل نحن الاثنتين
لرؤية من تظفر بالبقاء

415
00:21:51,390 --> 00:21:54,500
يبدو أنّي على وشك الهلاك بيد ماريا

416
00:21:54,500 --> 00:21:56,000
...مـ-مهلاً

417
00:21:56,000 --> 00:21:57,280
اقترب الوقت

418
00:21:58,480 --> 00:22:00,670
هيّا، نادوا باسمها

419
00:22:05,020 --> 00:22:06,340
لا أمانع

420
00:22:09,360 --> 00:22:10,350
!ماريا

421
00:22:41,580 --> 00:22:43,040
!بليد

422
00:22:43,040 --> 00:22:44,220
!لا تخسر أمامها

423
00:22:44,220 --> 00:22:45,710
!ماريا! أنتِ لها

424
00:22:45,710 --> 00:22:48,490
!ماريا! فلترينا المعتاد

425
00:22:48,490 --> 00:22:50,380
المعذرة... هل تمانع؟

426
00:22:50,380 --> 00:22:51,410
لا بأس

427
00:22:51,410 --> 00:22:52,180
...حسناً

428
00:22:57,310 --> 00:22:58,620
!هيّا يا بليد

429
00:22:58,620 --> 00:23:00,270
!ستنتهي حياتك هنا

430
00:23:01,240 --> 00:23:02,190
!هيّا بنا

431
00:23:08,820 --> 00:23:11,490
...لم تختفِ ماو، مما يعني

432
00:23:11,490 --> 00:23:14,530
لا بدّ أنّ السبب هو رغبة ماريا بالتواجد المشترك معها

433
00:23:15,030 --> 00:23:17,500
هذا المستقبل الذي أرادته

434
00:23:18,880 --> 00:23:20,040
!استسلمي

435
00:23:20,040 --> 00:23:23,130
...لن يستسلم ملك الشياطين

436
00:23:23,600 --> 00:23:24,660
!ماو

437
00:23:24,660 --> 00:23:27,090
!فلتنالي من بليد