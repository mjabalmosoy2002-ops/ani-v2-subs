1
00:00:00,600 --> 00:00:02,980
...ضربة التنّين

2
00:00:02,980 --> 00:00:05,480
!الساحقة

3
00:00:08,940 --> 00:00:10,650
!هذا مذهل

4
00:00:10,650 --> 00:00:11,900
!نجحت

5
00:00:12,160 --> 00:00:16,780
!عليك تخزين الروح وصقلها ثمّ قول "هياه" وإطلاقها

6
00:00:17,080 --> 00:00:19,930
يُدهشني تمكّنك من فعلها بناءً
على ذلك يا كلي

7
00:00:21,240 --> 00:00:22,530
!صوفي

8
00:00:22,530 --> 00:00:24,720
أتريدين تعلّم كيفيّة استعمالها أيضاً؟

9
00:00:25,670 --> 00:00:27,540
لا داعي للخجل

10
00:00:29,520 --> 00:00:30,240
أجل

11
00:00:30,240 --> 00:00:33,290
عليكِ تخزين الروح وصقلها ثم
قول "غياه" وإطلاقها

12
00:00:33,290 --> 00:00:33,870
ماذا؟

13
00:00:33,870 --> 00:00:35,010
هذا مختلف عمَّ قاله

14
00:00:35,010 --> 00:00:36,340
لحظة، حقّاً؟

15
00:00:40,690 --> 00:00:42,440
ضربة التنّين الساحقة

16
00:00:51,980 --> 00:00:53,290
!ما الذي يجري؟

17
00:00:53,290 --> 00:00:56,360
هذا ما يُفترض أن تكون عليه
ضربة التنّين الساحقة

18
00:00:56,360 --> 00:00:57,450
!جدّياً؟

19
00:00:57,450 --> 00:00:59,030
!ضربة كلي كانت هزيلة جدّاً

20
00:01:00,240 --> 00:01:02,310
أنتِ مذهلة بحقّ يا صوفي

21
00:01:02,310 --> 00:01:04,380
استغرقت أياماً عديدة لفعلها

22
00:01:04,380 --> 00:01:05,440
ابتعدوا من هنا جميعاً

23
00:01:05,440 --> 00:01:05,790
ماذا؟

24
00:01:12,340 --> 00:01:13,300
بليد

25
00:01:13,710 --> 00:01:15,810
هذه معركتي

26
00:01:16,280 --> 00:01:17,680
سأحميك

27
00:01:20,380 --> 00:01:23,100
!تـ-توجد اثنتان صوفي؟

28
00:01:23,990 --> 00:01:25,770
ما-ما الذي يجري؟

29
00:01:25,770 --> 00:01:27,100
تقنية نسخ؟

30
00:01:28,640 --> 00:01:30,110
ضربة التنّين الساحقة

31
00:01:36,090 --> 00:01:37,600
ما كان ذلك؟

32
00:01:37,600 --> 00:01:38,610
لا أدري

33
00:03:28,450 --> 00:03:29,680
رجعت

34
00:03:31,410 --> 00:03:34,060
لا بدّ أنّ "واحد" فشلت في مهمتها

35
00:03:34,480 --> 00:03:36,640
!هذا لا يُعقل

36
00:03:36,640 --> 00:03:40,800
يا للإزعاج، لنذهب مشهرين أسلحتنا
!ونقتل جميع من في مرآنا

37
00:03:40,800 --> 00:03:42,490
!هيّا، إنّه وقت القتل

38
00:03:44,380 --> 00:03:45,590
ني-سان

39
00:03:45,590 --> 00:03:48,080
هل وجدتِ أحداً ظريفاً جديراً بالقتل؟

40
00:03:48,670 --> 00:03:50,200
!تدمير! تدمير

41
00:03:50,650 --> 00:03:54,990
كانت هذه مهمة استكشاف سرّية لتقييم الوضع

42
00:03:54,990 --> 00:03:57,310
وقد نجحت من ذاك الخصوص

43
00:03:57,310 --> 00:03:59,260
فشلتِ بالفعل إذاً

44
00:03:59,610 --> 00:04:02,340
افتقاركِ للبرهان يثبت ذلك

45
00:04:02,340 --> 00:04:03,490
لا تستطيع "واحد" فعل شيء

46
00:04:03,490 --> 00:04:04,840
عديمة نفع

47
00:04:05,370 --> 00:04:06,050
"خمسة"

48
00:04:06,920 --> 00:04:08,350
لكِ إذن التدمير

49
00:04:09,040 --> 00:04:10,390
!تدمير! تدمير

50
00:04:12,350 --> 00:04:15,270
!"وقت تدمير "ثلاثة

51
00:04:17,130 --> 00:04:18,730
!تدمير! تدمير

52
00:04:18,730 --> 00:04:19,990
!هذا مؤلم

53
00:04:18,730 --> 00:04:20,920
كيف كانت النتيجة؟

54
00:04:21,730 --> 00:04:23,150
جعلتهم يعلّموني

55
00:04:23,570 --> 00:04:24,340
ماذا؟

56
00:04:24,340 --> 00:04:25,910
وضّحي أكثر

57
00:04:26,370 --> 00:04:28,610
يصعب الشرح بالكلمات فحسب

58
00:04:28,610 --> 00:04:30,310
...في تلك الحالة

59
00:04:33,710 --> 00:04:39,380
نقل البيانات التجريبيّة عبر الاتّصال
المخاطي مفيدٌ حقّاً

60
00:04:40,020 --> 00:04:40,880
"اثنان"

61
00:04:40,880 --> 00:04:41,630
ماذا؟

62
00:04:42,750 --> 00:04:43,760
!هذا مؤلم

63
00:04:43,760 --> 00:04:44,410
!تدمير

64
00:04:44,410 --> 00:04:46,140
!قلتُ أنّ هذا مؤلم أيّتها الحقيرة

65
00:04:48,620 --> 00:04:50,090
"تعالي هنا يا "ثلاثة

66
00:04:50,090 --> 00:04:50,890
"وأنتِ أيضاً يا "خمسة

67
00:05:00,070 --> 00:05:02,020
ماذا؟ ما كان هدفكِ هناك؟

68
00:05:02,020 --> 00:05:04,400
كما قلت، جعلتهم يعلّموني

69
00:05:04,400 --> 00:05:05,900
ضربة التنّين الساحقة

70
00:05:07,530 --> 00:05:09,360
!ضربة التنّين الساحقة

71
00:05:12,750 --> 00:05:15,520
تعرفين أنّ هذا ليس هدفنا

72
00:05:15,520 --> 00:05:16,870
ليس كذلك أبداً

73
00:05:16,870 --> 00:05:18,960
...ما أُمرِنا به كان

74
00:05:18,960 --> 00:05:20,790
!الاغتيال! الاغتيال

75
00:05:22,310 --> 00:05:24,310
أجل، أنتنّ محقّات

76
00:05:40,080 --> 00:05:41,590
ما الذي سترينا إيّاه؟

77
00:05:41,590 --> 00:05:43,440
!الزم الصمت وراقب رجاءً

78
00:05:43,690 --> 00:05:45,810
!ها أنا ذي

79
00:05:53,400 --> 00:05:55,540
!هذا مذهلٌ يا إيلايزا

80
00:05:55,820 --> 00:05:59,120
!لا يزال نموذجاً مبدئيّاً، لكن يبدو أنّه نجح

81
00:05:59,120 --> 00:06:01,280
ما كان المُذهل في ذلك؟

82
00:06:01,280 --> 00:06:04,050
كلّ ما فعلته هو إطلاق روح
مخزّنة توالياً

83
00:06:04,050 --> 00:06:06,390
لا أحتاج لرأي كائن خارق

84
00:06:06,390 --> 00:06:08,430
!يمكنه صقل وتخزين روحه بنفسه

85
00:06:08,690 --> 00:06:11,390
!هذا صعبٌ علينا نحن البشر العاديّون

86
00:06:11,390 --> 00:06:12,620
صعبٌ إذاً؟

87
00:06:12,620 --> 00:06:13,430
...لكن

88
00:06:13,670 --> 00:06:16,610
،عبر صقل الروح وشحنها في هذه الخراطيش

89
00:06:16,610 --> 00:06:19,750
يستطيع أيّ أحد الآن تفعيلها
في الوقت الذي يراه مناسباً

90
00:06:19,750 --> 00:06:20,940
فهمت

91
00:06:25,160 --> 00:06:25,760
بليد

92
00:06:25,760 --> 00:06:27,500
أتت إذاً

93
00:06:33,400 --> 00:06:35,350
ما الذي تريدين تعلّمه؟

94
00:06:39,840 --> 00:06:41,380
كيفيّة إنجاب الأطفال؟

95
00:06:43,280 --> 00:06:45,300
!ذلك غير ممكن أبداً

96
00:06:46,210 --> 00:06:47,620
...في تلك الحالة

97
00:06:47,620 --> 00:06:48,920
!كيف أقتلك

98
00:06:50,140 --> 00:06:51,430
لا أمانع

99
00:06:51,710 --> 00:06:53,180
حقّاً؟

100
00:06:53,680 --> 00:06:55,350
!فلتمت إذاً

101
00:06:55,350 --> 00:06:57,270
!أجل، تعالي إليّ

102
00:07:06,420 --> 00:07:07,790
لا أستطيع قتلك

103
00:07:07,790 --> 00:07:08,990
!فلتعلّمني بشكلٍ أفضل

104
00:07:08,990 --> 00:07:10,000
ماذا؟

105
00:07:10,000 --> 00:07:13,120
!لكن إن علّمتكِ حقّاً، فسأموت

106
00:07:13,120 --> 00:07:14,690
...إذاً

107
00:07:16,710 --> 00:07:18,540
اقتلني بالمقابل

108
00:07:18,910 --> 00:07:20,380
!مهلاً يا صوفي

109
00:07:22,950 --> 00:07:23,670
!ماذا؟

110
00:07:23,670 --> 00:07:24,460
...هـ-هذه

111
00:07:26,130 --> 00:07:27,860
!صـ-صوفي؟

112
00:07:28,720 --> 00:07:29,700
صوفي؟

113
00:07:29,700 --> 00:07:32,470
عندما وصلنا للجزء الجيّد

114
00:07:32,870 --> 00:07:35,300
أنا خصمكِ

115
00:07:36,950 --> 00:07:38,460
حسناً، إلى اللقاء

116
00:07:40,810 --> 00:07:42,700
كم مرّة الآن؟

117
00:07:42,700 --> 00:07:44,230
البداية كانت بسيف

118
00:07:44,230 --> 00:07:47,350
...ثمّ مضرب، وبعدها رمح

119
00:07:47,350 --> 00:07:48,480
أي أنّ هذه المرّة الرابعة؟

120
00:07:53,240 --> 00:07:54,740
هيّا، افتحي فمكِ

121
00:07:54,740 --> 00:07:56,780
!فتحته

122
00:07:57,780 --> 00:08:00,590
ما قصّة أولئك الفتيات برأيكم؟

123
00:08:00,590 --> 00:08:03,490
لستُ متأكداً، لكنّهن سريعات التعلّم

124
00:08:03,490 --> 00:08:06,700
صحيح، إنّهن شغوفات

125
00:08:06,700 --> 00:08:08,300
...لن أقول أنّه شغف

126
00:08:08,530 --> 00:08:10,720
أتعتقدون أنّهن أخوات صوفي؟

127
00:08:10,720 --> 00:08:13,200
عليهنّ أن يلتحقن بالأكاديميّة جميعاً

128
00:08:13,200 --> 00:08:14,590
لحظة يا أنّا

129
00:08:14,590 --> 00:08:16,190
لنفكّر بالأمر قليلاً

130
00:08:16,190 --> 00:08:18,630
ألا تجدينه غريباً؟

131
00:08:18,630 --> 00:08:19,140
ماذا؟

132
00:08:19,540 --> 00:08:22,480
أصبحتِ أشبه ببليد-كن مؤخراً

133
00:08:22,480 --> 00:08:25,440
من ناحية افتقاركِ للمنطق العام

134
00:08:26,760 --> 00:08:31,400
ألديكم أيّ ما تقولونه حيال الوضع
الغريب الذي يحيط بنا؟

135
00:08:31,400 --> 00:08:33,130
دخلت طور الإمبراطورة

136
00:08:33,130 --> 00:08:34,220
...المعذرة

137
00:08:34,660 --> 00:08:36,660
أتمانعين إن قلت شيئاً؟

138
00:08:36,930 --> 00:08:38,160
تفضّلي

139
00:08:38,160 --> 00:08:38,910
...حسناً

140
00:08:38,910 --> 00:08:41,250
...من منظور خارجيّ، يبدو جليّاً لي

141
00:08:41,250 --> 00:08:45,250
أنّ أولئك الفتيات يسعين
لقتل بليد-سان جدّياً

142
00:08:45,770 --> 00:08:49,000
أحمل الرغبة نفسها عندما
أهاجمه أثناء الدروس

143
00:08:49,000 --> 00:08:50,450
!وكذلك أنا

144
00:08:50,450 --> 00:08:52,420
بين كلّ شيء، أسعى للإنهاء عليه

145
00:08:52,420 --> 00:08:56,220
لا تنسي أنّي من ستقتله

146
00:08:56,220 --> 00:08:58,260
!ماذا؟! أنا آسفة

147
00:08:58,260 --> 00:08:59,990
!آسفة! آسفة! آسفة

148
00:08:59,990 --> 00:09:02,270
دعوها وشأنها، ألا ترون أنّها تشعر بالخوف؟

149
00:09:02,660 --> 00:09:05,770
!هل بليد يوبّخني؟

150
00:09:05,770 --> 00:09:08,970
لم أقصد بنفس أسلوبكم

151
00:09:08,970 --> 00:09:10,930
إنّهن يتظاهرن بأنّهن صوفي-سان للاقتراب منه

152
00:09:10,930 --> 00:09:12,580
ثمّ يهاجمنه بنية مشبّعة بالقتل

153
00:09:12,580 --> 00:09:13,530
...لا بدّ أنّ ذلك

154
00:09:13,980 --> 00:09:16,160
حسناً، امنحيني لحظة

155
00:09:16,160 --> 00:09:21,540
أكثر استنتاج معقول نصل إليه
...من هذه الحقائق هو

156
00:09:24,170 --> 00:09:26,960
!بليد يُستهدف من قِبل قتلة

157
00:09:28,870 --> 00:09:29,920
صوفي؟

158
00:09:30,580 --> 00:09:32,110
ما الخطب؟

159
00:09:32,110 --> 00:09:36,760
اكتشفتُ للتو أنّ لا أحداً منكم
أدرك أنّهن كنّ قاتلات

160
00:09:37,310 --> 00:09:39,120
!لحظة، لا-لا تقلقي

161
00:09:39,120 --> 00:09:41,640
!كنّا نعرف! نعرف بالطبع

162
00:09:41,640 --> 00:09:43,700
كنتُ أعرف ذلك منذ البداية

163
00:09:43,700 --> 00:09:45,670
!فلتبدِ خوفاً أكثر إذاً

164
00:09:45,670 --> 00:09:48,270
أهنالك من يستهدف حياتك يا والدي؟

165
00:09:48,590 --> 00:09:49,700
لا بأس

166
00:09:50,200 --> 00:09:52,270
سأحمي بليد

167
00:10:01,780 --> 00:10:03,260
!فشلتنّ جميعاً

168
00:10:03,260 --> 00:10:04,190
!حان دوري تالياً

169
00:10:04,190 --> 00:10:05,960
!سأدمّر! أدمّر

170
00:10:05,960 --> 00:10:06,810
أيمكنني تدميره؟

171
00:10:06,810 --> 00:10:07,860
اصمتي

172
00:10:07,860 --> 00:10:09,290
أنتِ تسبّبين لي الصداع

173
00:10:09,990 --> 00:10:12,310
لم أفشل بعد

174
00:10:12,310 --> 00:10:13,290
لا بدّ من ذلك

175
00:10:13,290 --> 00:10:15,800
غياب البرهان يثبت ذلك

176
00:10:16,020 --> 00:10:18,760
لم يستطع البطل العظيم قتلي

177
00:10:19,760 --> 00:10:23,660
مما يعني أنّ بإمكاني قتله
المرّة القادمة، صحيح؟

178
00:10:23,660 --> 00:10:24,860
!تدمير! تدمير

179
00:10:24,490 --> 00:10:25,810
اصمتي

180
00:10:24,860 --> 00:10:25,810
!تدمير كلّ شيء

181
00:10:26,530 --> 00:10:30,900
إهدار طاقة بلا معنى سيقلّص
فترة حياتك وحسب

182
00:10:31,400 --> 00:10:32,290
"واحد"

183
00:10:34,060 --> 00:10:36,270
"اثنان"، "ثلاثة"

184
00:10:36,690 --> 00:10:37,830
"أربعة"

185
00:10:39,530 --> 00:10:40,450
"خمسة"

186
00:10:42,580 --> 00:10:45,320
منوطٌ بكنّ جميعاً إظهار

187
00:10:45,320 --> 00:10:49,040
قدرة البطل العظيم الاصطناعيّ على
تجاوز البطل العظيم نفسه حتّى

188
00:10:49,640 --> 00:10:56,100
،اقتلن البطل العظيم بليد
وأثبتنّ صحّة بحثنا

189
00:10:56,970 --> 00:10:58,420
نحن نفهم ذلك

190
00:10:58,860 --> 00:11:03,060
هذا السبب الوحيد لجلبنا للحياة

191
00:11:06,870 --> 00:11:09,320
!نحن الأقوى

192
00:11:27,460 --> 00:11:29,130
أهذه أنتِ يا صوفي؟

193
00:11:29,130 --> 00:11:30,040
أجل

194
00:11:30,040 --> 00:11:31,990
ألغي تفعيل تخفيك رجاءً

195
00:11:31,990 --> 00:11:34,770
يصعّب ذلك تحديدكِ بمستشعراتي

196
00:11:34,770 --> 00:11:37,030
لا أريد إيقاظ بليد

197
00:11:37,030 --> 00:11:39,050
أأنتِ قلقةٌ على سيّدي؟

198
00:11:39,050 --> 00:11:40,050
لا حاجة لذلك

199
00:11:40,410 --> 00:11:42,480
فأنا بجواره دوماً

200
00:11:44,920 --> 00:11:47,060
هل تودّين النوم بجواره أيضاً؟

201
00:11:47,410 --> 00:11:49,840
الآن فرصتكِ لفعل ذلك ملء رغبتك

202
00:11:49,840 --> 00:11:51,060
لا، شكراً

203
00:11:51,060 --> 00:11:53,020
دعي الأمر لي رجاءً

204
00:11:53,020 --> 00:11:55,310
سأحمي سيّدي بحياتي

205
00:11:55,990 --> 00:11:59,100
سأفعل ما يسعني لحماية بليد أيضاً

206
00:11:59,650 --> 00:12:01,390
حتّى لو بالتضحية بحياتي

207
00:12:09,490 --> 00:12:10,510
استسلمي

208
00:12:10,510 --> 00:12:12,540
لا يمكنكِ قتل بليد

209
00:12:12,540 --> 00:12:14,460
لن نسمح لكِ

210
00:12:14,460 --> 00:12:16,000
كلّا، سنفعل

211
00:12:16,000 --> 00:12:20,210
فهذا ما أُمرنا به، والمغزى الوحيد لوجودنا

212
00:12:21,090 --> 00:12:25,440
،توقّف مشروع البطل العظيم الاصطناعيّ
وكنتُ العيّنة الأخيرة

213
00:12:25,440 --> 00:12:29,720
التعديلات التي طُبّقت عليكنّ لم
تتبع الإجراءات المطلوبة

214
00:12:29,720 --> 00:12:32,980
لا بدّ أنّ ذلك ألقى بثقله على أجسادكنّ

215
00:12:32,980 --> 00:12:34,290
أعرف ذلك

216
00:12:34,290 --> 00:12:36,890
فترة حياتنا قصيرة

217
00:12:36,890 --> 00:12:38,230
بخلافكِ

218
00:12:38,840 --> 00:12:42,660
بدل استعمال الوقت المحدود
،المتبقّي لكنّ لإطاعة الأوامر

219
00:12:42,660 --> 00:12:45,490
ألا يمكنكنّ العيش كبشر
وإمضاؤه في ضوء النهار؟

220
00:12:45,740 --> 00:12:47,200
أوامرنا مُطلقة

221
00:12:47,200 --> 00:12:49,120
...إن أردتِ إيقافنا

222
00:12:49,120 --> 00:12:50,740
فالطريقة واحدة

223
00:12:53,600 --> 00:12:55,580
أنا على يقين بأنّكِ تدركين
أيضاً في أعماقكِ

224
00:13:14,790 --> 00:13:16,060
سنكون بالانتظار

225
00:13:17,040 --> 00:13:19,730
في عالمنا، حيث لا يصل ضوء النهار

226
00:13:32,010 --> 00:13:34,040
!صوفي ضئيلة الحجم اليوم

227
00:13:35,310 --> 00:13:36,320
!"خمسة"

228
00:13:36,320 --> 00:13:36,740
ماذا؟

229
00:13:36,740 --> 00:13:38,210
!"اسمي "خمسة

230
00:13:38,210 --> 00:13:39,550
!ليس صوفي

231
00:13:39,550 --> 00:13:41,510
لديهنّ أسماء إذاً

232
00:13:41,510 --> 00:13:45,130
أعتقد أنّ "سينك" هي كلمة قديمة مفقودة

233
00:13:45,130 --> 00:13:47,340
تعني الرقم خمسة

234
00:13:47,940 --> 00:13:49,610
أمجموعكنّ خمسة؟

235
00:13:50,610 --> 00:13:52,260
لا مشكلة بإخباركِ لنا بذلك؟

236
00:13:52,870 --> 00:13:53,600
!أخطأت

237
00:13:53,600 --> 00:13:58,100
حسناً، لا أعتقد أنّ بإمكانها التظاهر
بأنّها صوفي ولو حاولت

238
00:13:58,100 --> 00:13:59,700
!انسوا ما قلته

239
00:13:59,700 --> 00:14:01,540
!وإلّا سأدمّركم

240
00:14:00,470 --> 00:14:01,540
!حسناً، حسناً

241
00:14:01,540 --> 00:14:02,230
!نسيت

242
00:14:02,230 --> 00:14:03,900
جيّد

243
00:14:03,900 --> 00:14:08,570
!لكنّي سأدمّركم مع ذلك

244
00:14:11,570 --> 00:14:12,740
!مهلاً يا بليد

245
00:14:12,740 --> 00:14:14,430
!اتّبع الخطّة

246
00:14:14,430 --> 00:14:15,950
!أعرف ذلك

247
00:14:18,520 --> 00:14:21,090
!تدمير! تدمير! تدمير

248
00:14:23,930 --> 00:14:27,510
...لا يستطيع حتّى الكائن الخارق تحمّل ذلك

249
00:14:28,760 --> 00:14:31,600
!تدمير! تدمير! تدمير

250
00:14:33,530 --> 00:14:34,510
بليد

251
00:14:34,510 --> 00:14:35,950
هيّا، استيقظ

252
00:14:35,950 --> 00:14:37,620
إلى متى ستتظاهر بالموت؟

253
00:14:38,040 --> 00:14:39,900
!استيقظ أخيراً

254
00:14:39,900 --> 00:14:43,360
فاز سيّدي بكلّ تمرين جرى
في الواقع الافتراضيّ

255
00:14:43,360 --> 00:14:45,280
إنّه غير معتاد على الموت

256
00:14:45,590 --> 00:14:47,120
أين تلك الفتاة؟ "خمسة"؟

257
00:14:47,120 --> 00:14:48,300
لقد غادرت

258
00:14:48,300 --> 00:14:50,280
وبمزاج عالٍ جدّاً

259
00:14:50,280 --> 00:14:54,310
لا أعتقد أنّها أدركت جرّها للواقع الافتراضيّ

260
00:14:54,310 --> 00:14:57,120
لذا إن كانت مُقتنعة بقتلها للكائن الخارق

261
00:14:57,120 --> 00:14:59,070
!فخطّتنا نجحت

262
00:14:59,070 --> 00:15:00,480
آمل ألّا تكتشف الحقيقة

263
00:15:00,480 --> 00:15:01,610
صحيح؟

264
00:15:01,610 --> 00:15:03,080
...إن فعلت

265
00:15:04,460 --> 00:15:06,870
!خدعتموني

266
00:15:06,870 --> 00:15:09,000
!تدمير! تدمير! تدمير! تدمير

267
00:15:09,000 --> 00:15:10,930
!دعوني أدمّركم

268
00:15:09,740 --> 00:15:11,570
!كنتُ أعرف أنّ هذه ستكون ردّة فعلها

269
00:15:11,570 --> 00:15:13,110
!تدمير! تدمير! تدمير

270
00:15:13,110 --> 00:15:14,470
!إنّها غاضبة

271
00:15:14,800 --> 00:15:17,900
تلقّى مبنى الأكاديميّة الثاني
%ضرراً بنسبة 30

272
00:15:17,900 --> 00:15:20,410
أيّ ضرر إضافيّ سيحمل معه خطر الانهيار

273
00:15:20,410 --> 00:15:23,690
لذا أقترح التوجّه إلى المبنى الثالث
الذي تمّ إخلاؤه كليّاً

274
00:15:23,690 --> 00:15:25,200
!فلتخبريها بذلك

275
00:15:25,200 --> 00:15:27,440
!مع أنّي متأكّد أنّها لن تستمع

276
00:15:30,130 --> 00:15:32,280
!يمكنني قتله، صحيح؟

277
00:15:32,280 --> 00:15:32,820
!صحيح؟

278
00:15:37,020 --> 00:15:39,120
!أتيتُ لقتلك، لذا كفّ عن الهرب

279
00:15:39,120 --> 00:15:41,250
!تدمير! تدمير! تدمير

280
00:15:41,250 --> 00:15:42,700
سأقوم بتوجيههما إذاً

281
00:15:42,700 --> 00:15:44,210
دع الأمر لي

282
00:15:47,600 --> 00:15:50,720
!أمّكما بارزة السرّة

283
00:15:51,150 --> 00:15:52,720
ما معنى ذلك؟

284
00:15:52,720 --> 00:15:55,770
إنّها عبارة استفزازيّة في لغة قديمة مفقودة

285
00:15:55,770 --> 00:15:58,640
للأسف، مُحي معناها من سجّلاتي

286
00:16:00,850 --> 00:16:02,580
!نجحت

287
00:16:04,720 --> 00:16:05,530
!ها هم

288
00:16:05,530 --> 00:16:06,900
!أعتمد عليكنّ جميعاً

289
00:16:06,900 --> 00:16:08,170
!مفهوم

290
00:16:08,680 --> 00:16:09,860
...لكن يا ألتيا

291
00:16:09,860 --> 00:16:12,610
أنحن قويّات بما يكفي لهزيمتهما حقّاً؟

292
00:16:12,610 --> 00:16:14,980
أخفقنا في اختبارنا الأخير

293
00:16:14,980 --> 00:16:16,490
أيمكننا فعلها؟

294
00:16:16,490 --> 00:16:17,940
...ذلك

295
00:16:18,400 --> 00:16:19,490
لا تقلقن

296
00:16:19,910 --> 00:16:21,970
لا بأس إذا لم تردن قتل أحد

297
00:16:21,970 --> 00:16:23,610
إنّهما بنفس مستوى صوفي

298
00:16:23,610 --> 00:16:25,490
!أطلقا تعويذاتكنّ عليهما بلا هوادة

299
00:16:25,490 --> 00:16:26,250
!أمرك

300
00:16:27,800 --> 00:16:28,750
!إنّهما لكنّ

301
00:16:33,050 --> 00:16:34,470
!إطلاق

302
00:16:52,630 --> 00:16:54,680
بليد، يمكنك استعمال السحر أيضاً؟

303
00:16:54,680 --> 00:16:56,320
أجل، بعض الشيء

304
00:16:56,630 --> 00:16:59,000
الآن فرصة أسرهما حيّتان

305
00:16:59,520 --> 00:17:01,730
!ماذا؟ لم يكن ذلك كافياً؟

306
00:17:05,200 --> 00:17:07,320
!قوّة البطل العظيم الاصطناعيّة

307
00:17:07,320 --> 00:17:08,580
عليكِ التراجع

308
00:17:12,580 --> 00:17:13,700
سيّدي

309
00:17:13,700 --> 00:17:15,390
هذا ثقبٌ أسود

310
00:17:15,390 --> 00:17:17,090
أقترح الانسحاب الفوريّ

311
00:17:17,440 --> 00:17:18,600
...وإلّا

312
00:17:26,710 --> 00:17:28,060
!اصمدوا لعشر ثوانٍ

313
00:17:34,570 --> 00:17:38,280
تظنّها النهاية؟ مستحيل

314
00:17:38,640 --> 00:17:40,790
!تدمير! تدمير! تدمير

315
00:17:40,790 --> 00:17:44,020
بعد تشكّل الثقب الأسود، لن يهلك من تلقاء نفسه

316
00:17:44,020 --> 00:17:44,910
!ماذا؟

317
00:17:45,660 --> 00:17:48,420
حسناً، ماذا نفعل الآن؟

318
00:17:50,120 --> 00:17:51,250
!ألتيا

319
00:18:00,160 --> 00:18:01,100
!صوفي

320
00:18:04,070 --> 00:18:06,100
قوّة البطل العظيم الاصطناعيّة

321
00:18:06,370 --> 00:18:09,100
عشرة، تسعة، ثمانية

322
00:18:09,440 --> 00:18:11,360
سبعة، ستّة

323
00:18:11,840 --> 00:18:13,610
خمسة، أربعة

324
00:18:14,200 --> 00:18:16,540
...ثلاثة... اثنان

325
00:18:17,400 --> 00:18:18,610
...واحد

326
00:18:28,880 --> 00:18:30,940
أحسنتِ البلاء يا صوفي

327
00:18:32,350 --> 00:18:33,550
...بليد

328
00:19:13,000 --> 00:19:14,270
أفقتِ؟

329
00:19:16,670 --> 00:19:19,220
يُفترض قطعها مثل الأرانب، صحيح؟

330
00:19:19,460 --> 00:19:20,640
هل نجحت؟

331
00:19:21,480 --> 00:19:23,220
نجحت في جعلها كالأرانب

332
00:19:23,520 --> 00:19:25,940
لكنّك أخطأت في كيفيّة قطعها

333
00:19:25,940 --> 00:19:28,220
ماذا؟ لا يُفترض بي استعمال هذا؟

334
00:19:31,300 --> 00:19:32,230
أيّة ضحايا؟

335
00:19:32,470 --> 00:19:34,630
لم يمت أحد

336
00:19:34,630 --> 00:19:36,250
أُصيب البعض

337
00:19:36,250 --> 00:19:38,660
لكن عالجتهم كلير في الوقت المناسب، لذا لا داعي للقلق

338
00:19:38,660 --> 00:19:40,540
وأصبت أنا ببعض الخدوش فحسب

339
00:19:41,020 --> 00:19:42,240
فهمت

340
00:19:42,240 --> 00:19:44,240
أعتذر على التسبّب بهذه المتاعب

341
00:19:44,240 --> 00:19:47,020
جميعنا بخير، لذا لا تقلقي

342
00:19:49,770 --> 00:19:52,140
أيمكنكِ إخباري عنهنّ؟

343
00:19:54,550 --> 00:19:57,380
أولئك الفتيات... هنّ أنا

344
00:19:57,910 --> 00:20:02,620
،عيّنات صُنعت بنفس تقنية النسخ
مع تعديلات إضافيّة

345
00:20:03,400 --> 00:20:06,100
وأظهرن بنجاح قوى البطل
العظيم الاصطناعيّة

346
00:20:06,100 --> 00:20:09,590
بعد تلقّي زراعات من المعدن النادر بطلنيوم

347
00:20:09,590 --> 00:20:13,100
مُنحن أرقاماً، فأعتقد أنّ ذلك ما حصل

348
00:20:13,560 --> 00:20:16,990
تقصدين مشروع البطل العظيم الاصطناعيّ؟

349
00:20:17,790 --> 00:20:20,390
أنا أُنقذت من قبل الملك

350
00:20:20,890 --> 00:20:24,610
لكن لم تمتلك الفتيات من يساعدهنّ

351
00:20:25,200 --> 00:20:29,820
التقيتك في الأكاديميّة، وكوّنت صداقات مع الجميع

352
00:20:30,560 --> 00:20:32,250
كنت منجاي

353
00:20:32,560 --> 00:20:34,830
أنتِ من أنجتني

354
00:20:35,310 --> 00:20:38,780
مررتِ بكل تلك المعاناة بسبب
قوى البطل العظيم

355
00:20:38,780 --> 00:20:41,630
لكنّكِ سامحتِني، البطل العظيم

356
00:20:42,030 --> 00:20:43,390
أخبرتك قبلاً

357
00:20:43,390 --> 00:20:45,870
أنا أفتخر بقوّتي هذه

358
00:20:45,870 --> 00:20:48,010
لم أحقد عليك قطّ

359
00:20:48,610 --> 00:20:51,310
أودّ مصادقتهنّ أيضاً

360
00:20:53,010 --> 00:20:56,560
اقترحت إيرنست أن يلتحقن
جميعاً الخمسة بالأكاديميّة

361
00:20:56,560 --> 00:20:57,780
ذلك مستحيل

362
00:20:59,000 --> 00:21:04,640
وُلِد الأبطال العظماء الاصطناعيّون لهزيمة
البطل العظيم... أي هزيمتك

363
00:21:04,640 --> 00:21:08,200
مغزى وجودهنّ الوحيد هو التفوّق عليك

364
00:21:08,780 --> 00:21:12,050
أُنقِذت قبل تلقّي أيّة تعديلات عصبيّة

365
00:21:12,050 --> 00:21:14,210
...لذا لم أُبرمج بذاك الشكل

366
00:21:14,480 --> 00:21:17,020
لكن لا يمكن لأولئك الفتيات معارضة أوامرهنّ

367
00:21:17,940 --> 00:21:19,040
...كما