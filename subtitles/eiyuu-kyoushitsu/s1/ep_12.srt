1
00:00:02,800 --> 00:00:05,490
تلقّيت هذا الإشعار بانسحابها من الأكاديميّة

2
00:00:08,210 --> 00:00:10,110
!لمَ لم تمنعها؟

3
00:00:10,320 --> 00:00:16,270
يمتلك التلامذة هنا حقّ تلقّي
التعليم ليصبحوا أبطالاً

4
00:00:16,270 --> 00:00:19,330
ولديهم الحرّية الكاملة بالتنازل
عن ذاك الحقّ أيضاً

5
00:00:20,920 --> 00:00:25,460
ليس واجبي منع من يختارون مغادرة الأكاديميّة

6
00:00:25,460 --> 00:00:27,170
!كيف لك إبداء هذه البرودة؟

7
00:00:27,810 --> 00:00:31,140
يغادر كلّ الأطفال عشّ والديهم يوماً ما

8
00:00:31,140 --> 00:00:33,500
وأنا أعتبر نفسي بالغاً

9
00:00:33,990 --> 00:00:36,090
لن أتجرّأ بفظاظة على منعها

10
00:00:36,350 --> 00:00:37,170
!جلالتك

11
00:00:37,170 --> 00:00:39,930
...لم أنهِ كلامي! كما

12
00:00:38,070 --> 00:00:39,930
اهدئي قليلاً

13
00:00:40,400 --> 00:00:41,520
أمعني النظر إليه

14
00:00:45,700 --> 00:00:46,590
جلالتك

15
00:00:47,120 --> 00:00:49,900
سنحرص على إعادة صوفي

16
00:00:51,420 --> 00:00:54,660
لكن أتعرفون أين توجّهت؟

17
00:00:54,660 --> 00:00:57,160
إلى حيث أخواتها الخمس غالباً

18
00:00:57,160 --> 00:00:58,620
،وفقاً لتحقيقي

19
00:00:59,050 --> 00:01:02,560
فيبدو أنّهن يترددن على
بضعة قواعد مختلفة

20
00:01:02,560 --> 00:01:04,790
هل نبدأ بالبحث في الأعلى احتمالاً؟

21
00:01:05,020 --> 00:01:05,850
!حسناً

22
00:01:05,850 --> 00:01:06,800
لنذهب إذاً

23
00:01:06,800 --> 00:01:08,060
انتظروا قليلاً

24
00:01:08,880 --> 00:01:13,950
هل فكّرتم بسبب ذهابها مفردها؟

25
00:01:14,550 --> 00:01:15,670
...ذلك

26
00:01:16,470 --> 00:01:20,700
لم ترد صوفي أن تلطّخوا أيديكم

27
00:01:21,510 --> 00:01:25,680
...السبيل الوحيد لإيقاف أولئك الفتيات الخمس

28
00:01:26,140 --> 00:01:27,190
هو قتلهنّ

29
00:01:27,870 --> 00:01:28,860
!لا يُعقل

30
00:01:28,860 --> 00:01:31,250
...لا بدّ من وجود طرق أخرى لإقناعهنّ

31
00:01:31,960 --> 00:01:34,600
لن تتوقّف أولئك الفتيات عند أيّ شيء

32
00:01:34,600 --> 00:01:39,320
ذهبت صوفي بمفردها لأنّها
أدركت ذلك تماماً

33
00:01:40,150 --> 00:01:43,080
يحوي العالم أكثر مما نراه
في وضح النهار

34
00:01:43,080 --> 00:01:49,170
وهي تعرف أنّها تواجدت
في الظلال بالأصل

35
00:01:49,400 --> 00:01:54,190
لذا تريد إنهاء الأمر بيديها

36
00:01:54,830 --> 00:01:57,130
كيلا تتسخ أيدي رفاقها

37
00:01:58,160 --> 00:02:02,650
عليكم التفكير مليّاً بالأمر إلى بزوغ الفجر

38
00:02:11,660 --> 00:02:13,480
!والدي

39
00:02:13,990 --> 00:02:16,910
سيّدي، ستذهب للبحث عن صوفي؟

40
00:02:16,910 --> 00:02:17,750
أجل

41
00:02:17,750 --> 00:02:19,270
!سأذهب أنا أيضاً

42
00:02:19,270 --> 00:02:21,490
!صوفي صديقتي

43
00:02:21,740 --> 00:02:24,780
!سأكون بجوارك أينما ذهبت سيّدي

44
00:02:24,780 --> 00:02:26,470
نحن الثلاثة فحسب إذاً؟

45
00:02:26,470 --> 00:02:29,250
سأذهب أنا كذلك

46
00:02:32,200 --> 00:02:33,870
هل وافقت ماريا على هذا أيضاً؟

47
00:02:33,870 --> 00:02:38,380
قالت تلك الباكية أنّها لا تستطيع
التخلّي عن صديقة لها

48
00:02:38,380 --> 00:02:39,750
فهمت

49
00:02:39,750 --> 00:02:41,570
أصبحنا خمسة إذاً

50
00:02:41,570 --> 00:02:43,560
هلّا ذهبنا أيّها البطل العظيم؟

51
00:02:43,560 --> 00:02:45,560
لم أعد البطل العظيم

52
00:02:58,070 --> 00:03:00,000
!بليد، تأخّرت

53
00:03:00,000 --> 00:03:01,810
ألم أخبركم؟

54
00:03:01,810 --> 00:03:06,080
توقّعت أنّ بليد-كن كان ينتظر
عند مدخل المهجع

55
00:03:06,080 --> 00:03:07,450
ماذا يا بليد؟

56
00:03:07,450 --> 00:03:09,010
أكنت متردداً؟

57
00:03:09,010 --> 00:03:11,890
يا للتلكؤ بالنسبة لكائن خارق

58
00:03:11,890 --> 00:03:14,340
!استغرقت خمس دقائق فحسب لأخذ قراري

59
00:03:15,990 --> 00:03:18,340
أعتذر على التأخّر

60
00:03:18,860 --> 00:03:20,780
حسناً، هيّا بنا

61
00:03:38,740 --> 00:03:39,570
!صوفي

62
00:03:41,770 --> 00:03:43,700
إيلايزا، وجدتُها

63
00:03:43,700 --> 00:03:44,750
حمداً لله

64
00:03:44,750 --> 00:03:46,330
سأرسل الجميع إليكِ

65
00:03:47,040 --> 00:03:47,870
!أرجوكِ

66
00:03:47,870 --> 00:03:49,220
!توقّفي عن الهرب

67
00:03:51,590 --> 00:03:54,180
لنتناقش في الأمر رجاءً

68
00:03:54,180 --> 00:03:56,360
لديّ طلبٌ أيضاً

69
00:03:56,930 --> 00:03:58,460
دعيني وشأني رجاءً

70
00:03:58,460 --> 00:03:59,950
صوفي

71
00:03:59,950 --> 00:04:06,220
نفهم جميعاً شعوركِ وما تحاولين فعله

72
00:04:07,530 --> 00:04:09,280
...فلا داعي للقلق

73
00:04:09,280 --> 00:04:10,220
أخطأتِ الفهم

74
00:04:10,480 --> 00:04:11,230
ماذا؟

75
00:04:12,080 --> 00:04:16,100
هنالك ما أخفيته عنكم جميعاً

76
00:04:20,780 --> 00:04:27,130
أنا بشريّة صُنِعت لمشروع
البطل العظيم الاصطناعيّ

77
00:04:27,130 --> 00:04:28,990
البطل العظيم... الاصطناعيّ؟

78
00:04:33,930 --> 00:04:37,140
يمتلك قوى تعادل أو تتجاوز
قوى البطل العظيم

79
00:04:37,140 --> 00:04:40,380
كنتُ عيّنة الاختبار الثانية عشرة

80
00:04:40,630 --> 00:04:45,190
،يُفترض أنّ كلّ من شاركوا في البحث قد اُعتقلوا

81
00:04:45,190 --> 00:04:48,990
لكنّي سمعت أنّ بعض العيّنات
وبيانات البحث قد سُرِقت

82
00:04:48,990 --> 00:04:51,640
والعيّنات كنّ الفتيات الخمس

83
00:04:51,640 --> 00:04:56,070
أكمل أحدهم البحث، وطوّرهنّ وأعطاهنّ الأوامر

84
00:04:56,570 --> 00:04:58,870
...سبب تواجدهن

85
00:04:58,870 --> 00:05:00,520
هو تجاوز البطل العظيم

86
00:05:00,760 --> 00:05:02,150
...البطل العظيم

87
00:05:02,150 --> 00:05:04,090
تقصدين نفسه؟

88
00:05:04,090 --> 00:05:07,160
لكن في تلك الحالة، لمَ تستهدفن حياة بليد؟

89
00:05:08,290 --> 00:05:09,580
...ذلك

90
00:05:09,580 --> 00:05:11,620
!فهمت

91
00:05:11,620 --> 00:05:14,330
!يردن اختبار قدراتهنّ على هذا الكائن الخارق

92
00:05:14,720 --> 00:05:17,170
إذا لم يستطعن هزيمة كائن خارق

93
00:05:17,170 --> 00:05:19,520
فلا أمل لهنّ أمام البطل العظيم

94
00:05:19,520 --> 00:05:20,630
هذا ما عليه الأمر

95
00:05:21,570 --> 00:05:23,380
...حـ-حسناً

96
00:05:23,380 --> 00:05:25,820
أجل، لا بدّ أنّ هذه هي

97
00:05:25,820 --> 00:05:28,660
إنّهم بليدون حقّاً

98
00:05:28,660 --> 00:05:33,170
سبّبتُ لكم الكثير من المتاعب بتوريطكم

99
00:05:33,170 --> 00:05:34,620
ليس صحيحاً

100
00:05:34,620 --> 00:05:37,830
لحق بي ماضيّ أخيراً

101
00:05:39,260 --> 00:05:44,680
لطالما تساءلتُ ما إن أمكنني الشعور
بكلّ هذه المتعة... والسعادة إلى الآن

102
00:05:45,200 --> 00:05:51,030
أممكن لمتنكّرة على هيئة بشريّة مثلي
العيش بسعادة كبشريّة حقّاً؟

103
00:05:51,760 --> 00:05:56,290
لذا سأرجع إلى حيث كنت

104
00:05:56,940 --> 00:05:59,230
سأحميكم جميعاً

105
00:05:59,230 --> 00:06:02,200
حتّى ولو بحياتي

106
00:06:03,660 --> 00:06:07,730
،ربما لم تكن مدّة طويلة
...لكن المشي معكم في الشمس

107
00:06:08,160 --> 00:06:09,300
أسعدني كثيراً

108
00:06:11,380 --> 00:06:12,490
مؤلم

109
00:06:13,680 --> 00:06:16,060
!مؤلم! مؤلم

110
00:06:16,360 --> 00:06:17,670
يا لسخافتك

111
00:06:17,670 --> 00:06:21,690
...إن كان المشي في الشمس يسعدك
فواصلي فعل ذلك

112
00:06:23,030 --> 00:06:24,940
...ألم أكن قبلاً

113
00:06:25,220 --> 00:06:26,850
أمتلك عينين كهذه

114
00:06:26,850 --> 00:06:29,700
ولم يبد أنّي سعيدة أو أستمتع أبداً، صحيح؟

115
00:06:29,700 --> 00:06:30,850
بالفعل

116
00:06:32,510 --> 00:06:36,850
لكن انظري، بفضل بليد
تمكّنت من التغيير

117
00:06:36,850 --> 00:06:39,710
لكنّكِ أصبحت ميؤوساً منك نوعاً ما

118
00:06:42,270 --> 00:06:49,970
...كما إن كان قتلهنّ هو الحلّ الوحيد، فنحن أيضاً

119
00:06:50,200 --> 00:06:52,340
لا، لن نفعل ذلك

120
00:06:52,340 --> 00:06:53,350
ماذا؟

121
00:06:53,350 --> 00:06:55,010
...لكن قال جلالته

122
00:06:55,010 --> 00:06:59,730
أعرف ما قاله الملك، لكنّ قتلهنّ ليس الإجابة

123
00:07:00,950 --> 00:07:02,280
ذلك مستحيل

124
00:07:02,280 --> 00:07:07,080
بسبب برمجتهنّ العصبيّة، أوامر صانعهنّ مُطلقة

125
00:07:07,080 --> 00:07:09,740
أليس هنالك ما يمكننا فعله؟

126
00:07:10,200 --> 00:07:12,180
...حتّى لو كانت هناك طريقة

127
00:07:12,180 --> 00:07:14,950
بسبب التعديلات القاسية التي مررن بها

128
00:07:14,950 --> 00:07:17,060
فليس أمامهنّ وقتٌ طويل للعيش

129
00:07:17,060 --> 00:07:18,500
...يا للفظاعة

130
00:07:18,970 --> 00:07:20,480
لديك خطّة، صحيح؟

131
00:07:20,480 --> 00:07:21,730
لا، البتّة

132
00:07:21,730 --> 00:07:22,730
!ماذا؟

133
00:07:23,330 --> 00:07:25,490
لكنّي أريد فعل شيءٍ مع ذلك

134
00:07:25,490 --> 00:07:27,990
أودّ إنقاذ أخوات صوفي

135
00:07:27,990 --> 00:07:29,340
...أخوات

136
00:07:30,100 --> 00:07:33,220
لذا أريد أن تساعدوني جميعاً

137
00:07:39,560 --> 00:07:42,000
صوفي، أأنتِ راضية بذلك؟

138
00:07:44,770 --> 00:07:45,760
صوفي

139
00:07:45,760 --> 00:07:48,040
أعطيني حياتكِ

140
00:07:48,040 --> 00:07:49,000
!ماذا؟

141
00:07:49,000 --> 00:07:49,680
حسناً

142
00:07:49,680 --> 00:07:51,240
!بهذه السرعة؟! أأنتِ مُتأكّدة؟

143
00:07:51,950 --> 00:07:54,190
...لكن... ذلك... ما قاله

144
00:07:52,300 --> 00:07:54,190
لمَ هذا الهلع يا إيرنست؟

145
00:07:54,190 --> 00:07:55,710
!فـ-فهمت

146
00:07:55,710 --> 00:07:58,700
تريد أن نصادق تلك الفتيات، صحيح؟

147
00:07:58,700 --> 00:08:00,370
حسناً، لنفعلها

148
00:08:02,820 --> 00:08:04,880
إذاً، ألديكِ أيّة أفكار جيّدة؟

149
00:08:05,130 --> 00:08:07,100
!ستُلقي بالأمر عليّ؟

150
00:08:07,520 --> 00:08:09,760
لكن حسناً، لا أمانع

151
00:08:09,760 --> 00:08:12,260
لديّ خطّة

152
00:08:19,520 --> 00:08:21,810
أعلماني متى أصبحتما
عاجزتين عن الحراك

153
00:08:21,810 --> 00:08:23,230
سأتخلّص منكما

154
00:08:23,230 --> 00:08:24,200
!ماذا؟

155
00:08:24,200 --> 00:08:25,840
!تعرفين أنّي لا أزال قادرة على المواجهة

156
00:08:25,840 --> 00:08:27,040
!سأسحقكِ

157
00:08:27,040 --> 00:08:29,260
!لا أزال أريد التدمير

158
00:08:29,260 --> 00:08:30,850
!تدمير! تدمير

159
00:08:32,990 --> 00:08:35,780
أجل، جيّد

160
00:08:37,170 --> 00:08:42,290
جوهر تواجدكنّ الوحيد هو التفوّق
على البطل العظيم

161
00:08:42,790 --> 00:08:44,930
اقتلن البطل العظيم

162
00:08:44,930 --> 00:08:48,290
اقتلنه، اقتلنه، اقتلنه

163
00:08:50,140 --> 00:08:51,420
"واحد"

164
00:08:51,420 --> 00:08:53,510
وجدت هذه في الخارج

165
00:08:53,960 --> 00:08:55,400
رسالة تحدّي

166
00:08:55,400 --> 00:08:56,640
لا بدّ أنّه فخّ

167
00:09:04,870 --> 00:09:06,620
سننهِ الأمر

168
00:09:17,850 --> 00:09:20,660
أتعتقدون أنّهن سيستجبن لذاك التحدّي حقّاً؟

169
00:09:21,040 --> 00:09:22,400
لا بأس

170
00:09:22,400 --> 00:09:24,520
كنتُ لأستجيب له بالتأكيد

171
00:09:24,520 --> 00:09:26,040
...فـ-فهمت

172
00:09:27,930 --> 00:09:30,290
!أشمّ رائحة مماثلة لرائحة صوفي

173
00:09:31,100 --> 00:09:32,050
أتين

174
00:09:34,990 --> 00:09:36,300
كنتُ بانتظاركنّ

175
00:09:37,390 --> 00:09:39,220
سنقتلك

176
00:09:39,220 --> 00:09:41,310
هذا مغزى تواجدنا

177
00:09:41,610 --> 00:09:42,970
فهمت

178
00:09:42,970 --> 00:09:45,810
كنتُ أتمنّى مصادقتكنّ جميعاً

179
00:09:46,480 --> 00:09:48,540
تفهم الخطّة، صحيح؟

180
00:09:48,540 --> 00:09:50,810
ستكون المُقاتل الوحيد

181
00:09:51,370 --> 00:09:54,680
إن هاجمنا كمجموعة، فسيهربن بالتأكيد

182
00:09:54,680 --> 00:09:57,150
،لكن بوجود هدف واحد فحسب

183
00:09:57,150 --> 00:10:00,320
فيُفترض أن يكملن القتال حتّى
بمعرفة أنّه فخّ

184
00:10:03,740 --> 00:10:04,960
...بليد

185
00:10:04,960 --> 00:10:08,000
...أعرف الخطّة، لكن عدم تمكّني من المساعدة

186
00:10:12,000 --> 00:10:13,040
!اسمعني بوضوح

187
00:10:13,040 --> 00:10:16,510
الهدف ليس هزيمتهنّ، بل استنزاف طاقتهنّ

188
00:10:13,750 --> 00:10:15,560
!فلتمت

189
00:10:15,560 --> 00:10:16,510
!الجسد الصلب

190
00:10:17,760 --> 00:10:20,840
تحمّل كلّ هجماتهنّ رجاءً

191
00:10:19,640 --> 00:10:20,840
!تدمير! تدمير

192
00:10:27,160 --> 00:10:29,360
!يسهل عليكِ الكلام

193
00:10:29,360 --> 00:10:31,190
!يمكنك الكائن الخارق فعلها

194
00:10:31,840 --> 00:10:33,940
...إن تمكّنت من استنزاف طاقتهنّ

195
00:10:33,940 --> 00:10:37,190
!واصل المراقبة، ولا تكسر الحصار

196
00:10:37,190 --> 00:10:40,850
لا بدّ من وجود من يوجّه لهنّ الأوامر

197
00:10:40,850 --> 00:10:42,200
اقبض عليه مهما حصل

198
00:10:43,920 --> 00:10:46,240
!هذا هو التمرين الفعليّ الحقيقيّ

199
00:10:46,240 --> 00:10:48,510
!لا، إنّه القتال الفعليّ

200
00:10:48,510 --> 00:10:50,710
سنعتقل الشخص الذي صنعهنّ

201
00:10:50,710 --> 00:10:54,590
ثمّ سنجبره على إخبارنا بمقاييس
