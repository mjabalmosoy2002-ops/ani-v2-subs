1
00:02:00,700 --> 00:02:04,830
في تلك المعركة الفرديّة، بعد نجاة
،القائد يوبا من الوابل

2
00:02:05,000 --> 00:02:08,330
أمطرَ عليه المزيد من الرّصاص

3
00:02:09,080 --> 00:02:13,710
أعتقد أنّ مجموعتين من رصاص كلب
الصّيد قد أطلِقَت من ارتفاعين مختلفين

4
00:02:13,840 --> 00:02:17,010
لجعل إحداها تسقط لاحقاً

5
00:02:17,760 --> 00:02:23,180
عدّلَ طلقات هيوستون المتأخّرة من الجولة 7
لتصبح مُخصّصة للاستعمال في الهواء الطلق

6
00:02:23,430 --> 00:02:24,640
!مدهش

7
00:02:24,890 --> 00:02:28,190
هذا يُثبِت مدى مهارة القائد نينوميا

8
00:02:28,390 --> 00:02:33,770
هذا يعني أنّ تقنيّاته تجاوزت قوّة
القائد يوبا الانفجاريّة؟

9
00:02:34,320 --> 00:02:38,240
كانت الأمور لتختلف ربّما لو كانت
،أوبيشيما-تشان هناك

10
00:02:38,860 --> 00:02:43,490
لكن بطبيعته، يوبا-تشان لا يرفض تحدّياً في نِزال

11
00:02:47,500 --> 00:02:50,790
لا توجد الآن أي تحرّكات ملحوظة في الميدان

12
00:02:51,080 --> 00:02:53,880
كلا الفرقتين تقضيان وقتاً بعيداً عن بعضهما الآخر

13
00:02:56,250 --> 00:02:58,760
،بخلاف تاماكوما الّتي تتحرّك خِلسة

14
00:02:58,920 --> 00:03:02,390
كلّ عملاء فرقة نينوميا يتحرّكون بجسارة على الملأ

15
00:03:02,590 --> 00:03:05,310
يبدو أنّهم يحثّون تاماكوما على التحرّك

16
00:03:13,480 --> 00:03:16,780
!فجّر نيزك الخاص بالقائد نينوميا بعض المباني

17
00:03:16,940 --> 00:03:19,740
هذا الفضاء المفتوح ربّما يكون لانتظار تاماكوما

18
00:03:19,900 --> 00:03:22,110
الفرقة التي تحتاج لنقطتين إضافيّتين

19
00:03:22,280 --> 00:03:25,910
معنى هذا بأنّه متيقّظ لحركات السّلك
القاتلة الخاصّة بيوما

20
00:03:26,660 --> 00:03:30,250
لكن قد يجعل هذا فرقة نينوميا هدفاً سهلاً

21
00:03:30,410 --> 00:03:32,830
لقنابل وقنص أماتوري

22
00:03:33,250 --> 00:03:36,630
أعتقد أنّ نينوميا-سان يفهم ذلك جيّداً

23
00:03:37,590 --> 00:03:40,380
بعيداً عن الأعداء الآخرين، فرقة نينوميا

24
00:03:40,510 --> 00:03:43,930
حذِرة  جدّاً من قنصها

25
00:03:44,850 --> 00:03:47,930
رغم ذلك، يجب عليها أن تحرص على إلحاق ضرر

26
00:03:50,730 --> 00:03:53,400
كما أشار أوجي، نينوميا-سان يريد غالباً

27
00:03:53,980 --> 00:03:57,320
أن يدعها تُطلق النّار ليجد مكانها

28
00:03:58,020 --> 00:04:03,990
لكن يبدو أنّ تاماكوما لا يملكون خياراً
غير طلقاتها الانفجاريّة

29
00:04:04,490 --> 00:04:08,370
ما طبيعة الاستراتيجيّة التي شرعوا بها؟

30
00:04:08,490 --> 00:04:13,750
معارك ناريّة بواسطة تشيكا وهيوسي
وحركات ثنائيّة بواسطة يوما وهيوسي

31
00:04:14,290 --> 00:04:16,380
لكن هيوسي قد رحل

32
00:04:16,710 --> 00:04:18,250
فماذا الآن؟

33
00:04:20,920 --> 00:04:23,550
سيلعب أوسامو دور هيوسي

34
00:04:24,340 --> 00:04:27,010
من الواضح أنّ ذلك سيكون صعباً

35
00:04:27,180 --> 00:04:31,140
استراتيجيّة الأسلاك خاصّته غير مفيدة
بما أنّ نينوميا-سان لديه نيزك

36
00:04:31,770 --> 00:04:34,980
لا يوجد اتّزان بين مهاراتهم واختصاصاتهم

37
00:04:36,190 --> 00:04:37,150
أجل

38
00:04:37,610 --> 00:04:40,360
أوسامو هو خير من يعرف ذلك

39
00:04:42,240 --> 00:04:45,450
يبدو أنّ الجمود سيدوم لبعض الوقت

40
00:04:45,780 --> 00:04:48,160
ليتني أحضرتُ شيئاً لأشربه

41
00:04:48,580 --> 00:04:51,410
،ريثما يعود رتم المُباراة

42
00:04:51,540 --> 00:04:54,500
هل يمكنني انتهاز هذا الوقت لطرح سؤال؟

43
00:04:54,830 --> 00:04:59,210
يستخدم القائد نينوميا رصاصاً مُركّباً نادراً جدّاً

44
00:04:59,670 --> 00:05:03,010
مزجَ رصاص كلب الصّيد لإنشاء دبّور

45
00:05:03,130 --> 00:05:04,670
!أجل، دبّور

46
00:05:05,130 --> 00:05:08,180
لعلّ الكثير منّا لم يروه من قبل

47
00:05:08,350 --> 00:05:11,390
العميل كوراوتشي، هل يمكنك أن تشرح؟

48
00:05:11,810 --> 00:05:13,680
...حسناً

49
00:05:13,890 --> 00:05:18,400
قبل الحديث عن دبّور، علينا أن نعلم
ما هو كلب الصّيد

50
00:05:18,810 --> 00:05:22,610
رصاص كلب الصّيد لا يطارد الهدف دوماً

51
00:05:22,730 --> 00:05:26,860
يمكن تعديل قوّة ميول كلّ رصاصة مُوجّهة

52
00:05:26,990 --> 00:05:29,490
،باستخدام إعدادات مختلفة

53
00:05:29,620 --> 00:05:33,660
يشكّل الرّصاص قَطعاً مكافئاً كما رأينا قبل قليل

54
00:05:34,870 --> 00:05:38,710
،إذا كان ميول رصاصك المُوجّه في ذروته

55
00:05:39,250 --> 00:05:42,630
فجميعها ستُصيب نقطة واحدة في آن واحد

56
00:05:42,750 --> 00:05:46,130
مجرّد ترس مُركَّز يكفي للتصدّي لها

57
00:05:46,470 --> 00:05:51,100
إنّ تغيير الميول التّوجيهي لخلق ضربات مُبعثَرة

58
00:05:51,260 --> 00:05:53,430
هو استخدام فعّال لكلب الصّيد

59
00:05:54,560 --> 00:05:56,940
القوّة الناريّة لنينوميا-سان كبيرة

60
00:05:57,190 --> 00:05:59,560
لذا فالعميل أوكي لم يستخدم ترسه

61
00:05:59,730 --> 00:06:03,070
إنّما حاول استدراج الرّصاص نحوه وراوغ

62
00:06:03,230 --> 00:06:05,820
لكن قابليّة توجيه أقوى تسمح

63
00:06:06,150 --> 00:06:11,780
لدبّور بأن يتعقّب الهدف وينحني بحدّة
أكبر ممّا يستطيع كلب الصّيد

64
00:06:12,160 --> 00:06:15,450
،عندما يعدّل نينوميا-سان الميول التّوجيهي لدبّور

65
00:06:15,580 --> 00:06:20,710
يصبح من الأصعب تفادي هجمته، مثلما
حوصِرَ العميل أوكي آنذاك

66
00:06:20,960 --> 00:06:23,920
ما يخيفني بشأن نينوميا-سان في هذه المرّة

67
00:06:24,050 --> 00:06:27,260
هو أنّ ذلك الرّصاص المُركّب هو مجرّد طعم

68
00:06:27,970 --> 00:06:32,180
بعد النّجاة من دبّور، يتربّص تسوجي-تشان لتنفيذ القتل

69
00:06:32,300 --> 00:06:35,970
يستخدم الرّصاص المُركّب للتحكّم بالأعداء

70
00:06:36,310 --> 00:06:40,190
يذكّرني هذا بتعليق القائدة كاكو في الجولة 4

71
00:06:40,310 --> 00:06:42,940
قالت كلاماً كهذا

72
00:06:43,520 --> 00:06:47,400
نيران كلب الصّيد تلك مُخصّصة لإجبار الخصم على التحرّك

73
00:06:49,650 --> 00:06:55,080
كان قويّاً آنذاك في الرّتبة-أ، حيث يشقّ
طريقه بالقوّة الناريّة

74
00:06:55,740 --> 00:06:57,330
،لكن بالنسبة لمعارك الفِرق

75
00:06:57,450 --> 00:07:02,580
أظنّه أصبح أقوى حتّى بعد الانخفاض للرتبة-ب

76
00:07:02,830 --> 00:07:03,590
أجل

77
00:07:03,920 --> 00:07:08,300
لكن من الصّعب استخدام كلب الصّيد
مثلما يفعل القائد نينوميا

78
00:07:08,720 --> 00:07:10,680
،لذا إذا أردتم استخدامه

79
00:07:10,800 --> 00:07:15,810
ابدؤوا بإيجاد إعداد التّوجيه الأمثل لكلّ ظرف

80
00:07:16,060 --> 00:07:19,310
إنّ الميول التّوجيهي الأقصى الّذي ذكرتُه

81
00:07:19,770 --> 00:07:25,020
يمكن له أن يكسر ترس العدوّ إذا
كان مقدار التريون لديك ممتازاً

82
00:07:25,360 --> 00:07:26,900
!صحيح

83
00:07:27,030 --> 00:07:28,780
...لكن إذا كان الأمر كذلك

84
00:07:29,440 --> 00:07:31,610
،إذا كان كذلك

85
00:07:31,740 --> 00:07:35,490
هل هذا يعني أنّ أماتوري-تشان لا تستطيع
حقّاً التّصويب على النّاس؟

86
00:07:36,700 --> 00:07:38,370
لماذا؟

87
00:07:38,750 --> 00:07:42,000
تذكّروا عندما أطلقتْ على تونوكا

88
00:07:42,210 --> 00:07:44,710
،لو كانت قد ركّزتْ رصاصها

89
00:07:44,830 --> 00:07:48,170
لتمكّنت من تحطيم ترسه لكسب نقطة

90
00:07:51,010 --> 00:07:54,470
لعلّ بعض المباني أعاقت خطّ نظرها

91
00:07:54,590 --> 00:07:57,430
أتحاول أن تدّعي الجهل؟

92
00:07:57,560 --> 00:07:59,020
هكذا إذاً

93
00:07:59,270 --> 00:08:01,770
بل أشعر براحة أكبر

94
00:08:02,770 --> 00:08:07,440
ظننتُ أنّ فشل قنبلتها الأولى كان ليؤثّر عليها

95
00:08:08,570 --> 00:08:12,700
لكن الآن أنا متأكّد بأنّ تشيكا ما زالت
ترغب في القتال

96
00:08:20,750 --> 00:08:22,870
إنّهم لا يقومون بأيّ تحرّك

97
00:08:23,960 --> 00:08:26,210
أيحاولون ترك الوقت ينفد؟

98
00:08:26,420 --> 00:08:27,880
لا أعتقد ذلك

99
00:08:28,340 --> 00:08:30,420
أنا متأكّد بأنّهم سيأتون

100
00:08:32,010 --> 00:08:34,550
ليس علينا إلّا الانتظار

101
00:08:38,760 --> 00:08:40,010
جيّد. وكوغا؟

102
00:08:40,140 --> 00:08:41,640
جاهز في أيّ وقت

103
00:08:43,810 --> 00:08:46,560
لنبدأ بمواجهتنا الأخيرة

104
00:08:59,330 --> 00:09:00,580
!انظروا

105
00:09:00,950 --> 00:09:05,290
كُل من العميل كوغا والقائد ميكومو
يتحرّكان للهجوم

106
00:09:05,830 --> 00:09:08,750
،لإحراز نقطتين أخرتين لأجل الفِرق الاستكشافيّة

107
00:09:09,170 --> 00:09:11,500
هل سيحسمون المُباراة؟

108
00:09:12,340 --> 00:09:16,260
فرقة نينوميا رقم 1 الرّتبة-ب تنتظرهم

109
00:09:16,470 --> 00:09:19,800
سيكون هذا الاشتباك الأخير على الأغلب

110
00:09:19,970 --> 00:09:22,520
!في الجولة 8 من حروب الرّتبة-ب

111
00:09:27,480 --> 00:09:28,060
لقد أتوا

112
00:09:30,190 --> 00:09:33,650
كبداية، رمى العميل كوغا عقربَه

113
00:09:33,860 --> 00:09:36,450
يردّ القائد نينوميا بكويكب

114
00:09:46,290 --> 00:09:48,920
بدلاً من مطاردة كوغا، فرقة نينوميا

115
00:09:49,040 --> 00:09:52,000
تدمّر نقاط الاختباء بنيزك

116
00:09:52,170 --> 00:09:55,050
هذا لإيقاف استراتيجيّة الأسلاك الخاصّة بتاماكوما

117
00:09:58,340 --> 00:10:00,510
،بعقبات أقلّ

118
00:10:00,680 --> 00:10:03,890
يغدو من الأصعب الاقتراب من فرقة نينوميا

119
00:10:07,690 --> 00:10:11,360
يهاجم القائد ميكومو من الطرف المُعاكس لكوغا

120
00:10:11,770 --> 00:10:13,480
مُستهدفاً القائد نينوميا؟

121
00:10:15,190 --> 00:10:17,700
هذا لمنع هجومه الشّامل

122
00:10:18,200 --> 00:10:20,820
،الهجوم الشّامل الخاص بالقائد نينوميا قويّ

123
00:10:20,990 --> 00:10:23,160
لكن هذا يجعله أعزل

124
00:10:23,330 --> 00:10:26,910
حتّى القوّة الناريّة للقائد ميكومو يمكن
أن تُلحِق به ضرراً كبيراً

125
00:10:27,370 --> 00:10:28,620
هكذا إذاً

126
00:10:28,750 --> 00:10:31,580
لكن... هل يمكنني أن أكون صريحة؟

127
00:10:31,710 --> 00:10:35,170
،إذا استهدفتْ فرقةُ نينوميا القائدَ ميكومو الآن

128
00:10:35,340 --> 00:10:37,340
ألن يُهزَم بسهولة؟

129
00:10:37,880 --> 00:10:40,840
إذا كنّا هكذا نرى الأمر، فرُبَّما

130
00:10:40,970 --> 00:10:44,010
هذا ما يريدنا أوسّامو أن نعتقده

131
00:10:44,890 --> 00:10:46,140
لا تلحقا بأحد

132
00:10:46,270 --> 00:10:49,690
بالطبع. فلا بدّ أنّ أماتوري-تشان تتربّص

133
00:10:50,270 --> 00:10:53,820
لن يلحقوا بالقائد ميكومو؟

134
00:10:54,110 --> 00:10:56,860
إنّهم مُتنبّهون للكمائن والقنص

135
00:10:57,030 --> 00:11:00,610
إنّ خسارة أيّ واحد منهم لهزيمة أوسّامو

136
00:11:00,740 --> 00:11:03,950
أمراً غير مُستحقّ بالنسبة لنينوميا

137
00:11:04,080 --> 00:11:06,290
!هذه وقاحة منك يا أوجي

138
00:11:06,620 --> 00:11:09,080
إذاً أليس من المنطقيّ التّركيز

139
00:11:09,250 --> 00:11:12,710
على العميل كوغا، عوضاً عن القائد ميكومو؟

140
00:11:12,880 --> 00:11:15,250
المسألة ليس بتلك البساطة أيضاً

141
00:11:15,420 --> 00:11:17,550
،بخلافنا نحن من نشاهد من هنا

142
00:11:17,710 --> 00:11:21,930
فرقة نينوميا لا تعرف أين العميل أماتوري

143
00:11:23,090 --> 00:11:25,680
،أثناء التّعامل مع ذلكما الاثنين

144
00:11:25,810 --> 00:11:29,980
يجب عليهم أن يحترسوا من هجومها
من كافّة في الاتّجاهات

145
00:11:30,140 --> 00:11:36,400
معنى هذا أنّ نينوميا-سان هو الوحيد الّذي
يستطيع الانتباه لكوغر بشكل كامل

146
00:11:42,280 --> 00:11:44,570
لن يحترسوا إلّا من جهة واحدة فقط

147
00:11:44,700 --> 00:11:47,660
ويستطيعون تكريس أنفسهم أكثر للهجوم

148
00:11:47,870 --> 00:11:51,250
ممّا سيضع ميكومو وكوغا في حالة حرجة

149
00:11:51,580 --> 00:11:56,090
إنّ النّجاة من هجومٍ منها سيمنحهم أفضليّة عظيمة

150
00:11:56,500 --> 00:12:00,420
ويريدون تلقّي ذلك الهجوم الحاسم

151
00:12:00,550 --> 00:12:05,760
عندما يكونون جميعهم معاً، لا مُفترقين
بواسطة ميكومو-كن، صحيح؟

152
00:12:07,560 --> 00:12:09,270
هذا ما أعتقده أيضاً

153
00:12:09,640 --> 00:12:12,310
ورقتهم الرّابحة أماتوريتشانا

154
00:12:12,480 --> 00:12:17,110
ظلّت مخفيّة لإشغال فرقة نينوميا في التّفكير

155
00:12:17,480 --> 00:12:19,940
إنّ رسم خطّة كهذه هو من طباع أوسّامو

156
00:12:20,490 --> 00:12:24,860
لكن هذه تُطبَّق فقط في حال وجود هيوستون

157
00:12:47,550 --> 00:12:48,300
!تبّاً

158
00:12:48,470 --> 00:12:51,640
!يشنّ القائد نينوميا هجومه الشّامل

159
00:12:51,810 --> 00:12:54,270
تكبّد كوغا ضرراً جسيماً

160
00:12:59,190 --> 00:13:04,150
لا يشكّل أوسامو خطراً عليهم مثلما
كان هيوستون ليفعل

161
00:13:05,740 --> 00:13:09,490
كوغا بأحسن حالاته تكبّد ضرراً من هجمة واحدة

162
00:13:09,660 --> 00:13:12,700
لا بدّ أنّ هذه ضربة قاسمة جدّاً لتاماكوما

163
00:13:13,040 --> 00:13:15,830
تزداد طلقات نينوميا-سان دقّة

164
00:13:16,000 --> 00:13:18,790
لن ينجو كوغا من هجوم شامل آخر

165
00:13:21,670 --> 00:13:23,010
...في النّهاية

166
00:13:24,130 --> 00:13:26,510
لا تستطيع أماتوري إطلاق النّار على الآخرين؟

167
00:13:27,680 --> 00:13:30,680
إن لم تكن كذلك، فقد انتهت هذه المُباراة

168
00:13:31,310 --> 00:13:33,270
،بغضّ النّظر عن التريون الخاص بها

169
00:13:34,520 --> 00:13:36,730
لا شيء يستطيع إسقاطنا

170
00:13:39,900 --> 00:13:42,440
آسف لأنّنا لا نستطيع تحقيق طلبكم

171
00:13:43,070 --> 00:13:46,280
لكن سيكون أوسامو من يهزمكم

172
00:13:50,370 --> 00:13:55,870
مع الأسف، إنّه بعيد كلّ البعد عن تشكيل خطر علينا

173
00:13:56,750 --> 00:13:59,000
...حقّاً؟ نينوميا-سان

174
00:14:04,420 --> 00:14:06,550
أنت تروي أغبى الأكاذيب

175
00:14:10,800 --> 00:14:12,390
!الدّافع، تشغيل

176
00:14:26,280 --> 00:14:28,360
رصاصة معدنيّة من جديد

177
00:14:28,530 --> 00:14:29,240
أجل

178
00:14:29,610 --> 00:14:30,570
نيزك

179
00:14:39,290 --> 00:14:40,670
تشيكا-تشان بخير

180
00:14:40,880 --> 00:14:42,420
إنّها تستخدم درعها

181
00:14:43,630 --> 00:14:45,920
اذهبا واقضيا على أماتوري

182
00:14:46,090 --> 00:14:47,760
عُلِم

183
00:14:49,220 --> 00:14:49,840
حقّاً؟

184
00:14:50,050 --> 00:14:53,760
إينوكاي وتسوجي انطلقا لاستهداف أماتوري

185
00:14:53,930 --> 00:14:55,640
بينما بقي القائد في مكانه

186
00:14:55,810 --> 00:14:58,310
هل سيواجه ثنائي تاماكوما بمفرده؟

187
00:14:58,640 --> 00:15:01,480
وكيف ستردّ فرقة تاماكوما؟

188
00:15:01,940 --> 00:15:02,690
...هذا

189
00:15:03,020 --> 00:15:06,610
ما أراده أوسامو، مواجهة شخصين ضدّ نينوميا-سان وحيداً

190
00:15:10,910 --> 00:15:13,950
تشيكا، احمي نفسكِ برصاص المعدن

191
00:15:14,080 --> 00:15:18,120
أوقفي إمّا إينوكاي-سينباي أو تسوجي-سينباي على الأقلّ

192
00:15:22,250 --> 00:15:25,800
!أنا وكوغا سنُسقِط نينوميا-سان

193
00:15:28,920 --> 00:15:31,010
خسِرَتْ فرصة مؤاتية

194
00:15:31,340 --> 00:15:36,720
كانت طلقة عاديّة من برق أو أبو منجل
لتهزم واحداً منهم

195
00:15:36,850 --> 00:15:39,640
لا تستطيع إطلاق النّار على الآخرين فعلاً إذاً؟

196
00:15:39,810 --> 00:15:41,980
من يصدر الأوامر هو ميكومو

197
00:15:42,600 --> 00:15:43,690
لا تلمها

198
00:15:44,480 --> 00:15:46,900
إنّه لا يمتلك العزيمة

199
00:15:47,530 --> 00:15:49,940
ليخبرها أن تطلق على أحد

200
00:15:52,530 --> 00:15:55,320
تشيكا، احمي نفسكِ برصاص المعدن

201
00:16:01,210 --> 00:16:05,080
معركتهم الأخيرة هي عبارة عن مواجهة
بين تاماكوما ونينوميا في اثنين ضدّ واحد

202
00:16:05,210 --> 00:16:07,670
إنّهما يركّزان على نينوميا

203
00:16:07,920 --> 00:16:10,840
هل ينوي تحطيمهما بمفرده؟

204
00:16:11,380 --> 00:16:14,510
...لو يشتّت أوسامو انتباه نينوميا-سان ولو قليلاً

205
00:16:15,180 --> 00:16:19,020
!فيستطيع يوما حينها انتهاز الفرصة وإسقاطه

206
00:16:19,390 --> 00:16:21,730
لماذا فرّق فريقه الآن؟

207
00:16:21,890 --> 00:16:25,520
...أتفهّم رغبته في إيجاد أماتوريتشيانا، لكن

208
00:16:25,900 --> 00:16:30,230
أجل، يحبّ نينوميا-سان قبول تحدٍّ من الآخرين

209
00:16:30,440 --> 00:16:33,650
لكن ميزته لا تنحصر ضمن القوّة فقط

210
00:16:49,170 --> 00:16:50,130
ها هو ذا

211
00:16:50,380 --> 00:16:51,510
الهجوم الشّامل

212
00:16:54,930 --> 00:17:00,060
سواء كان بالتقنيّات أو بالتكتيك، إنّه
يربح وفق قواعد العدوّ

213
00:17:00,310 --> 00:17:02,560
هكذا يقاتل في هذه الأيّام

214
00:17:04,520 --> 00:17:05,100
!لا

215
00:17:07,230 --> 00:17:08,060
كنتُ مُحقّاً

216
00:17:08,730 --> 00:17:09,940
...فرقة نينوميا

217
00:17:10,190 --> 00:17:11,610
تستهدف ميكومو-كن

218
00:17:15,490 --> 00:17:16,450
!أوسامو-كن

219
00:17:18,070 --> 00:17:18,780
الآن

220
00:17:22,120 --> 00:17:22,750
!تسوجي-تشان

221
00:17:31,670 --> 00:17:33,630
إنّها ليست رصاصة معدن

222
00:17:54,530 --> 00:17:56,280
كان ذلك وشيكاً يا أوسّامو

223
00:17:56,950 --> 00:18:02,450
كان المُطلِق المُخضرم ليبعثِر الرّصاص
...في هذه اللّحظة، لكن

224
00:18:13,250 --> 00:18:14,130
ربِحنا

225
00:18:21,760 --> 00:18:22,930
!كلب صيد؟

226
00:18:32,730 --> 00:18:35,320
كان يخفي كلب الصّيد؟

227
00:18:36,320 --> 00:18:39,820
لا، أطلقَ كلب الصّيد مع إغلاق التعقّب؟

228
00:18:40,360 --> 00:18:43,200
بالكاد لديه ما يكفي من تريون ليتدبّر أمره

229
00:18:43,910 --> 00:18:46,450
استغلَّ قلّة التريون نسبيّاً لديه

230
00:19:04,390 --> 00:19:07,810
تضرّر نظام التزويد بالتريون. مغادرة

231
00:19:22,740 --> 00:19:23,910
قتل مُتقَن

232
00:19:24,160 --> 00:19:25,700
أجل

233
00:19:26,120 --> 00:19:27,700
شكراً لك

234
00:19:43,550 --> 00:19:44,640
نينوميا-سان

235
00:19:45,140 --> 00:19:47,100
،مهما قد يحدث تالياً

236
00:19:47,220 --> 00:19:50,350
لن تؤثّر النتيجة على تصنيفنا الأخير

237
00:19:50,640 --> 00:19:52,310
هل نتابع؟

238
00:19:55,610 --> 00:19:57,730
لا، تراجع

239
00:19:58,690 --> 00:19:59,570
عُلِم

240
00:20:00,990 --> 00:20:04,410
!غادر العميل إينوكاي طوعاً

241
00:20:05,700 --> 00:20:07,410
!مرحى

242
00:20:07,700 --> 00:20:09,580
انتهت المباراة الآن

243
00:20:09,910 --> 00:20:14,420
الجولة 8 من حروب الرّتبة-ب، الفترة
الليليّة للمجموعات العليا

244
00:20:15,460 --> 00:20:17,590
!تاماكوما-2 هي الفرقة الرّابحة

245
00:20:22,380 --> 00:20:24,930
انتهت... المُباراة؟

246
00:20:25,340 --> 00:20:27,970
انتهت. فعلناها يا أوسامو

247
00:20:28,140 --> 00:20:31,310
كان ذلك إينوكاي-سينباي من غادر للتو

248
00:20:31,480 --> 00:20:33,770
وماذا عن تسوجي-سينباي؟

249
00:20:33,980 --> 00:20:37,270
أسقِطَ بواسطة أبو منجل الخاص بتشيكا

250
00:20:38,730 --> 00:20:39,860
!حقّاً؟

251
00:20:41,150 --> 00:20:42,740
لم أدرك ذلك

252
00:20:44,610 --> 00:20:46,990
...فهمت، إذاً تشيكا قد

253
00:20:51,160 --> 00:20:52,160
تشيكا-تشان

254
00:20:52,410 --> 00:20:55,290
كيف حالكِ؟ هل أنتِ بخير؟

255
00:20:55,540 --> 00:20:57,420
أظنّني بخير

256
00:20:58,040 --> 00:20:58,750
تشيكا

257
00:21:00,750 --> 00:21:01,960
أحسنتِ صنعاً

258
00:21:08,390 --> 00:21:09,890
لقد عدنا

259
00:21:10,100 --> 00:21:12,640
!يوما-كن، أوسامو-كن، أبليتما حسناً

260
00:21:12,810 --> 00:21:14,100
أنتِ أيضاً

261
00:21:21,820 --> 00:21:23,900
نجحت خطّتك البديلة بإتقان

262
00:21:24,320 --> 00:21:27,200
ما زلتُ لا أصدّق ذلك

263
00:21:33,830 --> 00:21:34,500
جيّد