1
00:00:13,550 --> 00:00:16,350
تمّ اختيار الخريطة

2
00:00:16,470 --> 00:00:18,890
...اختيار سوزوناري-1 هو

3
00:00:20,100 --> 00:00:23,640
منظر المدينة د. ستكون الخريطة منظر المدينة د

4
00:00:24,310 --> 00:00:26,690
بادِر بالهجوم الأوّل قبل أن يكتشفوا الأمر

5
00:00:26,980 --> 00:00:28,400
احرص على تحقيق الإصابة

6
00:00:29,440 --> 00:00:30,480
عُلِم

7
00:00:31,190 --> 00:00:36,530
مع ذلك، لماذا هذه الخريطة؟ هل هذه
استراتيجيّة مضادّة للقنّاصين حقّاً؟

8
00:00:37,070 --> 00:00:41,370
حسناً يا أوكوديرا، هل تشعر بدافع خفيّ؟

9
00:00:41,830 --> 00:00:42,500
أجل

10
00:00:43,000 --> 00:00:48,130
سوزوناري، في هذه الأيّام، بمستوى مختلف

11
00:00:52,670 --> 00:00:55,220
كوغيتسو أسود؟

12
00:02:28,890 --> 00:02:29,900
...هذا

13
00:02:30,350 --> 00:02:35,940
هل يُعقل أن يكون الكوغيتسو الأسود ذاك
مرتبطاً باستراتيجيّة سوزوناري الجديدة؟

14
00:02:36,150 --> 00:02:38,150
لا أعرف بصراحة

15
00:02:38,570 --> 00:02:40,030
لم أره أبداً

16
00:02:41,700 --> 00:02:44,740
يمكننا غالباً رؤية الاستراتيجيّة الجديدة قريباً

17
00:02:44,870 --> 00:02:46,620
استمرّي في التّعليق

18
00:02:56,550 --> 00:02:57,380
ترس

19
00:03:06,810 --> 00:03:10,480
قتال عن كثب بين فرقة كاغيورا وسوزوناري-1

20
00:03:10,600 --> 00:03:13,400
أفضل مُهاجمي بوردر يشتبكان بالسيوف

21
00:03:13,940 --> 00:03:16,020
،بعقرب المُزدوج متعدّد الاستعمالات الخاص بهم

22
00:03:16,150 --> 00:03:18,780
يمتلك كاغيورا وسائلَ مُتنوّعة للهجوم

23
00:03:19,400 --> 00:03:24,530
بينما دِفاع موراكامي الحصين وهجماته
الحادّة تجعل ردّات فعله لا تُقهر

24
00:03:25,330 --> 00:03:27,830
هذان الاثنان وكوغا من تاماكوما

25
00:03:27,950 --> 00:03:31,000
مُنافِسون في حروب الرّتبة الفرديّة

26
00:03:32,080 --> 00:03:35,840
إليكم مُعدّلات فوزهم في المعارك الفرديّة الأخيرة

27
00:03:35,960 --> 00:03:39,720
لدى كاغيورا أفضليّة طفيفة على الآخرَين

28
00:03:40,130 --> 00:03:42,300
،هذا ما تُشير إليه الأرقام

29
00:03:42,430 --> 00:03:45,510
لكن هذه معركة فِرق

30
00:03:46,180 --> 00:03:49,430
في الواقع، كوغا-كن هزم كو-كن في المرّة السّابقة

31
00:03:49,560 --> 00:03:52,310
وبعض النّاس يبلون حسناً عند الشّدائد

32
00:03:52,600 --> 00:03:53,940
هذا صحيح

33
00:03:54,060 --> 00:03:56,860
،فإذا كان في سجلّ مُهاجم قويّ من 4 إلى 6 فرديّات

34
00:03:56,980 --> 00:04:00,150
بعض الاستراتيجيّات المُستندة على فريق
قد تحقّق نجاحاً

35
00:04:00,570 --> 00:04:03,360
إذاً مفتاح النّصر يكمن

36
00:04:03,950 --> 00:04:08,330
في كيفيّة تحرّك الرُّماة لمساعدة مُهاجميهم؟

37
00:04:09,120 --> 00:04:12,120
لنرَ نقاط كلا الرّاميين الفرديّة

38
00:04:12,250 --> 00:04:18,630
القائد كوروما لديه 7.881، والعميل
كيتازوي لديه 9.728

39
00:04:19,050 --> 00:04:21,920
لديك ولعٌ بالأرقام يا يويتسكا-تشان

40
00:04:22,260 --> 00:04:27,100
من بين الرُّماة الّذين يؤدّون دور الدّاعم، العميل كيتازوي

41
00:04:27,220 --> 00:04:32,140
هو رامٍ شديد مُمتاز يمتلك كثافة
ناريّة كافية ليُحرز نقاطاً بمفرده

42
00:04:32,680 --> 00:04:38,190
والمفاجئ أنّ عيبه الوحيد هو بطئه وكونه هدفاً ضخماً

43
00:04:38,860 --> 00:04:40,780
تلك الفجوة في الكثافة النّارية

44
00:04:41,440 --> 00:04:44,200
تجعل سوزوناري-1 يركّزون على الدّفاع

45
00:04:44,320 --> 00:04:47,660
هجمات فرقة كاغيورا السّاحقة لا حدود لها

46
00:04:48,030 --> 00:04:51,290
إذا انكسرت تلك التّروس، ينتهي الأمر

47
00:05:00,710 --> 00:05:01,710
!مهلاً

48
00:05:02,710 --> 00:05:05,010
هجوم شامل بواسطة القائد كوروما؟

49
00:05:05,550 --> 00:05:06,800
!ها نحن ذا

50
00:05:07,300 --> 00:05:10,350
يحمل كوروما بندقيّتين بلا ترس

51
00:05:10,470 --> 00:05:13,560
لا، يتولّى موراكامي الدّفاع؟

52
00:05:14,140 --> 00:05:18,770
كويكب وكلب الصّيد من زوايا مختلفة
يجبران كيتازوي على التّراجع

53
00:05:23,570 --> 00:05:24,820
!تبّاً

54
00:05:25,320 --> 00:05:28,370
إذاً استراتيجيّة سوزوناري الجديدة هي البنادق المُزدوجة؟

55
00:05:28,620 --> 00:05:29,910
أصبتِ

56
00:05:30,030 --> 00:05:34,960
بالتّحديد القائد كوروما الّذي يتقدّم
أكثر بكثير عن المعتاد

57
00:05:35,120 --> 00:05:37,170
،وخلف ترس موراكامي

58
00:05:37,750 --> 00:05:40,670
ينخرط في الهجوم تماماً

59
00:05:40,790 --> 00:05:44,210
بمقدورهم أن يحظوا بتقوية فوريّة في تبادل النّيران

60
00:05:44,630 --> 00:05:49,970
سوزوناري، والّذي كانت استراتيجيّتها الرئيسيّة
،مُساندة المُهاجم في المُقدّمة

61
00:05:50,100 --> 00:05:53,560
لديها خيار جديد الآن وهو تبادل النّيران
من مدى مُتوسّط

62
00:05:54,060 --> 00:05:55,600
!زوي-كن، في اليسار العلويّ

63
00:05:56,020 --> 00:05:56,850
عُلِم

64
00:05:57,390 --> 00:06:01,400
من مخاطر هذا التّشكيل هي النّيران الصّديقة

65
00:06:01,520 --> 00:06:03,860
مع ذلك أتقنوها خلال وقتٍ قصير

66
00:06:04,400 --> 00:06:09,200
أعتقد يعزو الفضل لقدرة كو-كن في التعلّم
وتمرينات فريقهم

67
00:06:09,660 --> 00:06:12,490
يا للهول! هذا التّشكيل من جديد. هذا صعب

68
00:06:12,620 --> 00:06:15,040
من دون يوزورو، سيُقضى علينا

69
00:06:16,710 --> 00:06:19,000
لا نملك خياراً. لنتراجع

70
00:06:21,000 --> 00:06:22,210
لم أتوقّع ذلك

71
00:06:29,130 --> 00:06:31,050
كواراي، إلى الطابق العلويّ

72
00:06:31,260 --> 00:06:32,550
عُلم

73
00:06:43,770 --> 00:06:45,110
سيلحق بي أيضاً

74
00:06:46,780 --> 00:06:48,740
!دافِع، تشغيل

75
00:06:54,870 --> 00:06:55,580
!عليك به

76
00:07:01,580 --> 00:07:03,000
سأصيبكما معاً

77
00:07:03,340 --> 00:07:04,340
هذا سيّئ

78
00:07:15,970 --> 00:07:17,720
أنقذَ كواراي

79
00:07:18,100 --> 00:07:20,850
لمنع فِرقة كاغيورا من الإحراز؟

80
00:07:30,240 --> 00:07:31,860
لن أخفق في الإصابة ثانية

81
00:07:32,110 --> 00:07:34,870
ترتّب عليه الاقتراب قبل أن يُطلق

82
00:07:35,580 --> 00:07:39,250
الوضع فوضويّ في الأعلى، لذا يجب
أن أمسك به هنا

83
00:07:40,120 --> 00:07:42,620
...حسناً، ثلاثة، اثنان، واحد

84
00:07:42,790 --> 00:07:44,080
إطفاء

85
00:07:54,010 --> 00:07:55,010
انقطاع في التيّار؟

86
00:07:59,310 --> 00:08:00,350
!تبّاً

87
00:08:00,680 --> 00:08:02,640
صوّبَ نحو ضوء التريغا الخاص بي

88
00:08:09,570 --> 00:08:11,900
الطلقة التّالية ستُجهز عليك

89
00:08:25,960 --> 00:08:30,510
علينا أن نرسم استراتيجيّة جديدة
قبل المُباراة التّالية

90
00:08:30,760 --> 00:08:32,050
حقّاً؟

91
00:08:32,170 --> 00:08:35,840
لكنّنا نبلي حسناً ضدّ الفِرق العليا في الرّتبة-ب

92
00:08:36,260 --> 00:08:39,180
هذا لا يعني أنّنا لسنا ندّاً لهم

93
00:08:39,310 --> 00:08:42,310
لكن لم نستطع الصّمود في الأسبوع الماضي

94
00:08:42,600 --> 00:08:48,020
وأيضاً سيتصدّون لتشكيلنا الجديد المُعتمد
على إطلاق النّيران في النّهاية

95
00:08:48,360 --> 00:08:50,860
...استراتيجيّة جديدة... تقصد

96
00:08:50,980 --> 00:08:55,780
علينا إيجاد طريقة مُستحَبّة من قِبَلنا فقط، صحيح؟

97
00:08:55,910 --> 00:08:57,570
أجل، تماماً

98
00:08:59,240 --> 00:09:01,620
!لذيذ للغاية

99
00:09:01,870 --> 00:09:06,290
على سبيلِ المثال، تسميم مُشغّلي الفِرق الأخرى؟

100
00:09:06,540 --> 00:09:10,000
هذا صحيح منطقيّاً لكنّه جنون

101
00:09:10,550 --> 00:09:14,090
،لدينا حقّ اختيار الخريطة في المُباراة المقبلة أيضاً

102
00:09:14,220 --> 00:09:17,720
لذا ينبغي أن تكون الخريطة مُرتبطة بالتّضاريس

103
00:09:17,890 --> 00:09:19,390
التّضاريس، أجل

104
00:09:19,510 --> 00:09:24,730
لكن فِرقة كاغيورا وتاماكوما-2 لديهما
عناصر مُشابهة لعناصرنا

105
00:09:24,850 --> 00:09:27,940
يبدو أنّ الحصول على أفضليّة صعب

106
00:09:28,150 --> 00:09:29,860
لديّ فكرة

107
00:09:30,400 --> 00:09:34,150
ثمّة أمر كنتُ أرغب في تجربته

108
00:09:34,530 --> 00:09:35,240
ما هو؟

109
00:09:45,830 --> 00:09:49,880
فِرقة كاغيورا وسوزوناري-1 داخل مطعم الآن

110
00:09:50,000 --> 00:09:53,960
كيف ستؤثّر بهم المساحات الضيّقة والعقبات؟

111
00:09:57,970 --> 00:10:00,510
هجوم كاغيورا يتجاوز النقاط العمياء

112
00:10:03,060 --> 00:10:04,390
هكذا يبدو

113
00:10:04,890 --> 00:10:08,140
إنّ المساحات الضيّقة تقلّص تأثير

114
00:10:08,270 --> 00:10:12,860
هجمات "كلب الصّيد" المُزدوج مُتعدّدة
الاتّجاهات والخاصّة بالقائد كوروما

115
00:10:13,320 --> 00:10:17,950
من النّادر رؤية فرقة كاغيورا تقاتل بهذا الذّكاء

116
00:10:21,490 --> 00:10:22,990
،لاستعادة فرصتهما

117
00:10:23,410 --> 00:10:26,870
تُسيطر فرقة كاغيورا على مُجريات هذا الصّراع

118
00:10:27,660 --> 00:10:28,580
...ها نحن ذا

119
00:10:28,920 --> 00:10:29,620
!تايتشي

120
00:10:29,920 --> 00:10:31,250
عُلِم

121
00:10:31,670 --> 00:10:34,050
...حسناً، ثلاثة، اثنان، واحد

122
00:10:34,250 --> 00:10:35,510
الدّعم البصريّ، تشغيل

123
00:10:35,630 --> 00:10:36,880
إطفاء

124
00:10:41,760 --> 00:10:42,890
...الأضواء

125
00:10:49,560 --> 00:10:50,560
...هذا الشّخص

126
00:10:55,190 --> 00:10:56,780
انقطاع التيّار في مركز التسوّق؟

127
00:10:57,150 --> 00:10:59,950
فهمت، سوزوناري أرسلوا تايتشي-كن

128
00:11:00,280 --> 00:11:02,820
إلى غرفة الطاقة الكهربائيّة في الطّابق الأوّل

129
00:11:03,490 --> 00:11:07,870
ويضع عُملاء سوزوناري الآن ناظوراً ليليّاً

130
00:11:08,040 --> 00:11:10,370
،للحصول على أفضليّة في الظّلام

131
00:11:10,500 --> 00:11:14,250
كانوا جاهزين لإطفاء الأنوار مع المُشغِّلة

132
00:11:14,380 --> 00:11:15,500
هكذا إذاً

133
00:11:15,710 --> 00:11:21,680
إذاً كلّ هذا لتصعيب رؤية هجمات ذلك
الكوغيتسو الأسود في الظّلام؟

134
00:11:22,470 --> 00:11:26,140
!بئساً! ينبغي أن أؤمّن التّغطية لك يا كاغي
لكن قد أصيبك

135
00:11:26,510 --> 00:11:28,980
!هيكاري، امنحينا منظاراً ليليّاً حالاً

136
00:11:29,100 --> 00:11:30,520
أعمل على ذلك سلفاً

137
00:11:30,640 --> 00:11:33,560
لا يمكنكم فعل شيء من دوني

138
00:11:37,440 --> 00:11:40,110
حصلَتْ فِرقة كاغيورا على دعم بصريّ أيضاً

139
00:11:40,280 --> 00:11:43,030
تايتشي هو من يقوم بخدعة الأضواء هذه؟

140
00:11:43,160 --> 00:11:45,530
!يا لها من استراتيجيّة مُزعجة

141
00:11:45,910 --> 00:11:48,120
نحن الآن متكافئون

142
00:11:48,540 --> 00:11:49,830
تايتشي -
أجل -

143
00:11:50,660 --> 00:11:52,330
...ثلاثة، اثنان، واحد

144
00:11:52,500 --> 00:11:54,210
الدّعم البصريّ، إغلاق

145
00:11:54,420 --> 00:11:55,420
إشعال

146
00:12:00,760 --> 00:12:02,880
تلقّى القائد ضربة قويّة

147
00:12:03,010 --> 00:12:04,680
هل كانت إصابة قاتلة؟

148
00:12:08,390 --> 00:12:09,640
هذا عنيف

149
00:12:10,140 --> 00:12:12,350
...لم تُصَب أجزاؤه الحيويّة، لكن

150
00:12:12,480 --> 00:12:15,190
نظام التّوصيل في ذراعه قد قُطِع

151
00:12:15,310 --> 00:12:17,360
تسرّب التريون هائل

152
00:12:17,730 --> 00:12:22,150
كان ليُقتَل خمس مرّات لولا تأثيره الجانبي

153
00:12:22,610 --> 00:12:25,280
!أغلقي المنظار اللّيلي. هذا ساطع جدّاً

154
00:12:25,410 --> 00:12:27,160
أعمل على ذلك بالفعل

155
00:12:27,410 --> 00:12:30,700
سوزوناري-1 يتحكّمون بالمُجريات هنا

156
00:12:30,950 --> 00:12:35,120
يمكنهم خلق فُرص مراراً بالأضواء

157
00:12:35,420 --> 00:12:37,790
يوزورو، هل يمكنك أن تُطلق على تايتشي-كن؟

158
00:12:37,920 --> 00:12:41,210
لن أصيبه على الأغلب. إنّه ليس حتّى على الرّادار

159
00:12:41,800 --> 00:12:45,800
لكن يمكنني تحطيم صندوق القاطع
الكهربائي. هيكاري دُلّيني

160
00:12:45,930 --> 00:12:47,550
!أنتم تُشغلونني كثيراً

161
00:12:52,230 --> 00:12:54,230
يرمون نحوي من الآن؟

162
00:12:54,390 --> 00:12:56,560
إيسكودو بواسطة العميل بيتسوياكو؟

163
00:12:56,690 --> 00:12:58,770
كان مُستعدّاً للهجوم

164
00:12:59,150 --> 00:13:01,190
لا. يبدو بأنّه محميّ

165
00:13:01,360 --> 00:13:02,990
يجب أن نذهب إليه بشكل مُباشر

166
00:13:03,190 --> 00:13:05,530
تبّاً! يا له من مأزق

167
00:13:12,370 --> 00:13:15,750
حطّم كيتازوي قِطع إنارة المطعم

168
00:13:16,000 --> 00:13:19,710
فهمت، لا يمكنهم استخدام خدعة الأضواء تلك الآن

169
00:13:20,090 --> 00:13:21,960
فكرة بسيطة لكن مُفيدة

170
00:13:22,090 --> 00:13:24,670
هذا ما يُعجبني بزوي

171
00:13:25,010 --> 00:13:26,340
تصرّفوا سريعاً

172
00:13:26,590 --> 00:13:29,510
لا يمكننا الحفاظ على الأفضليّة هنا بعد الآن

173
00:13:29,640 --> 00:13:33,140
لكن كان ينبغي أن نقضي على كاغي من البداية

174
00:13:33,520 --> 00:13:36,520
!تعرّضتُ لإصابة حرجة. اللّعنة

175
00:13:36,640 --> 00:13:40,190
لا تقلق. لنُعد تنظيم أنفسنا

176
00:13:40,610 --> 00:13:43,530
تلقّت فِرقة كاغيورا ضرراً كبيراً

177
00:13:43,650 --> 00:13:45,320
ما هي تحرّكاتهم التّالية؟

178
00:13:46,110 --> 00:13:49,160
حسناً، في العادة كانوا ليستخدموا نيزك زوي

179
00:13:49,620 --> 00:13:54,120
لتحطيم الجدران للخروج من مركز التسوّق

180
00:13:54,250 --> 00:13:58,620
لكنّهم لا يعلمون أين يتربّص بهما القنّاصان

181
00:13:58,750 --> 00:14:02,170
لا يمكنهم التحرّك بشكل مُتهوّر هكذا

182
00:14:02,630 --> 00:14:03,550
صحيح

183
00:14:03,670 --> 00:14:08,010
الفِرق الأخرى لا تعلم أنّ أزوما داخل مركز التسوّق

184
00:14:08,470 --> 00:14:13,510
لعلّهم يعتقدون أنّهم سيُقنَصون خارج البناء

185
00:14:15,520 --> 00:14:20,190
هل إحدى الفِرق الأخرى تُشعل وتُطفئ الإنارة؟

186
00:14:20,610 --> 00:14:23,980
دعم أوسامي سينباي السّريع أنقذَ حياتي

187
00:14:25,150 --> 00:14:28,280
،خدعة الأضواء تلك حطّمت ذراعي اليُمنى

188
00:14:28,780 --> 00:14:31,530
لكنّها أيضاً ساعدتني على الهرب

189
00:14:35,200 --> 00:14:37,540
كانت الأمور لتكون أسوأ

190
00:14:38,370 --> 00:14:43,380
مع ذلك، يجب أن أفعل شيئاً بشأن الضّوء للتحرّك بحرّية

191
00:14:49,050 --> 00:14:49,800
!تايتشي

192
00:14:50,550 --> 00:14:52,300
هناك من يتوجّه نحوك

193
00:14:53,430 --> 00:14:55,180
لا يكشفهم الرّادار

194
00:14:55,310 --> 00:14:57,100
اخرج من مكانك حالاً

195
00:14:57,230 --> 00:14:57,850
عُلِم

196
00:14:59,100 --> 00:15:01,690
من الأفضل الانسحاب الآن

197
00:15:02,230 --> 00:15:03,270
إيسكودو

198
00:15:08,530 --> 00:15:11,530
بالفعل، كان هناك من يتحكّم بالأضواء

199
00:15:11,780 --> 00:15:13,870
لكن خرجنا عن المسارِ لأجلِ ذلك

200
00:15:13,990 --> 00:15:15,870
اضطررنا أن ننتظره هناك في الأعلى

201
00:15:16,450 --> 00:15:21,040
ما زلنا ننتظر أمره بالتجمّع من جديد. لا مُشكلة

202
00:15:22,630 --> 00:15:24,130
لنحرز النّقاط

203
00:15:24,630 --> 00:15:25,710
حسناً

204
00:15:36,100 --> 00:15:38,890
حدث شيء في الطّابق الأوّل

205
00:15:39,230 --> 00:15:41,190
العميل بيتسوياكو، مُغادرة

206
00:15:41,440 --> 00:15:43,940
النّقطة الأولى من نصيب تاماكوما-2

207
00:15:45,570 --> 00:15:49,570
وتنتهي تكتيكات سوزوناري البيئيّة

208
00:15:49,690 --> 00:15:51,530
كيف سيتصرّفون الآن؟

209
00:15:52,860 --> 00:15:57,330
هل الرّجلان من تاماكوما في الطّابق الأوّل
سيُسيطران على المُجريات المُقبلة؟

210
00:16:00,540 --> 00:16:02,250
يجب أن نسرع للطابق العلويّ

211
00:16:02,420 --> 00:16:04,540
أعلم. انتبه من القنّاصين

212
00:16:09,420 --> 00:16:12,260
اثنان من تاماكوما صعدا من خلال الفناء

213
00:16:12,720 --> 00:16:13,590
توخّوا الحذر

214
00:16:13,970 --> 00:16:14,800
عُلِم

215
00:16:30,530 --> 00:16:31,440
إنّهم تاماكوما

216
00:16:34,200 --> 00:16:37,700
قفزوا للأعلى مُباشرة وعطّلوا الباغوارم خاصّتهم

217
00:16:37,830 --> 00:16:40,450
ثلاث فِرق تُراقب بعضها الآخر بحذر

218
00:16:40,910 --> 00:16:43,500
،أي تصرّف عجول من شخص

219
00:16:43,620 --> 00:16:45,920
سيأتي العدوّ من الخلف

220
00:16:46,420 --> 00:16:48,630
تقدّم كاغي خطوة واحدة فقط

221
00:16:48,750 --> 00:16:51,920
لكنّه فقد كثيراً من التريون قبل قليل

222
00:16:52,630 --> 00:16:56,390
ولا نعرف الكثير عن الجديد من تاماكوما بعد

223
00:16:56,840 --> 00:17:00,390
أجل، هذه مُباراته الأولى في حروب الرّتبة-ب

224
00:17:00,510 --> 00:17:03,310
ما زالت عدّة التريغا خاصّته مجهولة

225
00:17:04,100 --> 00:17:07,190
الفِرق الأخرى تتريّث كي ترى

226
00:17:07,310 --> 00:17:09,820
ما الّذي يستطيع فعله

227
00:17:10,230 --> 00:17:15,030
قالوا أنّه مُستخدِم مُمتاز للكوغيتسو
في حروب الرّتبة الفرديّة

228
00:17:15,320 --> 00:17:18,870
هل هذا يعني أنّ مركزه هو مُهاجم؟

229
00:17:19,080 --> 00:17:22,290
في الواقع... لستُ متأكّداً من ذلك بعد

230
00:17:24,580 --> 00:17:26,920
أوسامو، كيف هي الأمور عندك في الأسفل؟

231
00:17:27,040 --> 00:17:28,790
هل ستصعد؟

232
00:17:29,170 --> 00:17:32,710
هناك إيما ومُهاجمان من فرقة أزوما هنا

233
00:17:33,340 --> 00:17:35,300
سأنتظر الفُرصة المُناسبة للانطلاق

234
00:17:35,880 --> 00:17:39,260
إذا صعدتُ للطابق العلويّ، سأُقتَل من مدى قريب

235
00:17:39,430 --> 00:17:41,970
هل يمكنني إصابة الأعداء في الأعلى من هنا؟

236
00:17:42,470 --> 00:17:45,020
إيما لوحده، لنشنّ هجمة كمّاشة

237
00:17:45,140 --> 00:17:47,100
كواراي، اصعد حالاً

238
00:17:47,350 --> 00:17:48,560
أوشكتُ على الوصول

239
00:17:48,690 --> 00:17:51,480
ميكومو مُتسلّل. ابقَ يقِظاً

240
00:17:51,610 --> 00:17:52,570
أعي هذا

241
00:17:53,280 --> 00:17:56,240
ستُحاول تاماكوما-2 الإحراز من فرقة كاغيورا

242
00:17:56,360 --> 00:17:59,870
بما أنّ أعضاءها يريدون الانضمام للبعثة

243
00:18:00,580 --> 00:18:02,830
حالما يبدؤون بتحرّكاتهم، لنُهاجم

244
00:18:02,950 --> 00:18:03,830
حسناً

245
00:18:04,080 --> 00:18:07,670
لدينا ثلاث مجموعات مُكوّنة من شخصين
في الطّابق السّادس

246
00:18:08,250 --> 00:18:10,330
أيُّ المجموعات ستُبادر بالتحرّك؟

247
00:18:10,460 --> 00:18:13,170
أم سينتظرون حتّى يصعد زملاؤهم؟

248
00:18:13,840 --> 00:18:15,510
تاماكوما قادمون نحونا

249
00:18:15,630 --> 00:18:16,470
حسناً

250
00:18:16,800 --> 00:18:17,840
فلنبدأ

251
00:18:18,050 --> 00:18:18,970
حسناً

252
00:18:19,680 --> 00:18:20,800
إيسكودو

253
00:18:28,020 --> 00:18:31,230
استخدمَ... إيسكودو لسدّ الرّواق؟

254
00:18:31,690 --> 00:18:36,530
معركة الـ 2-على-2-على-2 سرعان
ما تحوّلت إلى 2-على 1

255
00:18:40,780 --> 00:18:41,740
كوغيتسو؟

256
00:18:43,870 --> 00:18:44,740
ليس كذلك

257
00:18:46,450 --> 00:18:47,410
!رصاص

258
00:18:47,960 --> 00:18:48,870
ضخمة للغاية

259
00:18:53,420 --> 00:18:55,500
يستخدم رصاصاً لإعمائي؟

260
00:19:05,680 --> 00:19:07,600
عرفتُ أنّكما ستفعلان ذلك

261
00:19:13,810 --> 00:19:16,730
أتتأمّلان هزيمتي في معركة اثنين على واحد؟

262
00:19:16,940 --> 00:19:17,990
لا

263
00:19:28,450 --> 00:19:31,120
تلقّى القائد كاغيورا إصابة. لكن كيف؟

264
00:19:31,540 --> 00:19:35,340
نفّذَ هجوماً مُزدوَجاً مُؤخّراً من تلقاء نفسه

265
00:19:35,920 --> 00:19:38,960
،بإطلاقِ نصف رصاصه لاحقاً

266
00:19:39,090 --> 00:19:42,430
خلقَ ظرفاً يكون فيه ثلاثة على واحد

267
00:19:43,090 --> 00:19:47,060
كانت فكرة لتأمين هجوم هيوسي الأوّل

268
00:19:47,180 --> 00:19:50,730
باستغلال حقيقة وهي أنّ أسلوب قتاله مجهول

269
00:19:51,940 --> 00:19:54,860
كوغا وهيوسي أمسكا بكاغيورا سينباي

270
00:19:55,230 --> 00:19:57,320
الاثنان من سوزوناري مُتواجدان هناك

271
00:19:59,150 --> 00:20:04,570
لكن لماذا لا يستخدم هيوسي مسارات
التّفادي الخاصّة بأفعى؟

272
00:20:05,070 --> 00:20:08,080
تحذير. نزيف تريوني حرج

273
00:20:08,620 --> 00:20:12,920
من دون تريون كثير وساق، قد يُقضى على كاغي

274
00:20:14,630 --> 00:20:15,880
!أيّها الحقير

275
00:20:23,010 --> 00:20:24,970
انضمّ له كيتازوي سينباي؟

276
00:20:29,600 --> 00:20:31,350
ليس هذا من جديد

277
00:20:32,980 --> 00:20:34,400
!يا للهول

278
00:20:47,580 --> 00:20:50,080
نيزك لقتل مُتبادَل قبل الموت؟

279
00:20:50,200 --> 00:20:52,120
العميل كيتازوي، مُغادرة

280
00:20:52,660 --> 00:20:55,250
والعميل كوغا... توقّعَ ذلك؟

281
00:20:55,370 --> 00:20:56,670
استخدمَ ترسه

282
00:21:07,550 --> 00:21:10,140
سقطَ القائد كاغيورا للطابق السّفلي

283
00:21:15,390 --> 00:21:16,940
تبّاً

284
00:21:17,650 --> 00:21:20,400
نزيف تريوني شديد. مُغادرة

285
00:21:23,030 --> 00:21:25,320
!القائد كاغيورا يُغادر أيضاً

286
00:21:25,740 --> 00:21:27,780
تلقّى ضرراً جسيماً

287
00:21:27,910 --> 00:21:30,280
ولم يستطع التصدّي لتاماكوما

288
00:21:32,240 --> 00:21:33,120
لحظة

289
00:21:34,120 --> 00:21:37,170
الأمر ليس كذلك. سوزوناري-1 من أحرزوا هنا

290
00:21:37,420 --> 00:21:40,210
النّقاط من نصيب سوزوناري-1