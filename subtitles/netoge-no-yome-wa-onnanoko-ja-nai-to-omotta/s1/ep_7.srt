1
00:00:06,480 --> 00:00:08,520
يبدو أنكَ لم تأخذْ كفايّتكَ من النوم

2
00:00:08,520 --> 00:00:11,300
أُراهنُ أنكَ بقيّتَ حتى وقتٍ مُتأخرٍ و أنتَ تلعبْ ؟

3
00:00:12,070 --> 00:00:14,190
...حسناً ، أجل

4
00:00:15,060 --> 00:00:17,030
، لم تبلغِ حتى السادسةَ صباحاً بعد

5
00:00:17,190 --> 00:00:19,340
لكنَكِ يا سينسي ، تبدينَ مُستيّقضةً تماماً ؟

6
00:00:19,580 --> 00:00:21,600
، في أيّامِ الكليّة ، و في فريق المصارعة

7
00:00:21,660 --> 00:00:23,780
كُنا نتدربٌ صباحاً كل يّوم

8
00:00:23,920 --> 00:00:25,780
هوه ، يّبدو أنهم قد وصلوا

9
00:00:34,440 --> 00:00:35,420
صباحُ الخيّر

10
00:00:35,670 --> 00:00:39,150
صباحُ...الخيّر

11
00:00:39,840 --> 00:00:41,880
...هاه ؟ حسناً

12
00:00:50,520 --> 00:00:52,130
...هاه ؟ لا ، لقد كُنتُ فقط

13
00:00:52,300 --> 00:00:54,450
لا تقلق بشأنِ ذلك ، فأنا نعسةٌ و حسب

14
00:00:54,560 --> 00:00:55,480
...حـ-حسناً

15
00:00:56,560 --> 00:00:58,030
الجميع هنا ، صحيح ؟

16
00:01:00,110 --> 00:01:01,540
...حسناً إذن ، إعتباراً من الآن

17
00:01:01,760 --> 00:01:05,540
المُخيّمُ الصيّفيُّ لنادي الألعابِ الإلكترونيّة و الإتصالاتِ الحديثةِ قد بدأ

18
00:01:06,430 --> 00:01:10,770
الهدفُ من هذا المُخيّم هو تعزيزُ قوتنا من أجل ألعابِ الأنترنت

19
00:01:13,320 --> 00:01:17,230
على هذا النحو ، و طوال فترةِ المُخيّم ، الإتصالُ بشبكةِ الإنترنتْ سيّكون ممنوعاً

20
00:01:18,110 --> 00:01:18,830
هاه ؟

21
00:01:19,920 --> 00:01:20,840
: و سيُّطلقُ عليّه

22
00:01:21,620 --> 00:01:24,910
" مخيّمُ الـ 24 ساعة من دون الإتصالِ بالإنترنت "

23
00:03:14,410 --> 00:03:19,410
07. المستوى

24
00:03:14,410 --> 00:03:19,410
سأُصبحُ واقعياً لقد إعتقدتُ بأنه إن قُمتُ بالمبيت معه

25
00:03:21,880 --> 00:03:24,490
الإتصالُ بالإنترنتْ ممنوعٌ خلالَ المُخيّم ؟

26
00:03:24,890 --> 00:03:25,380
همم

27
00:03:25,790 --> 00:03:31,560
هل هذا لعزلها عن الإنترنت وجعلها تُدرك بأن
الزواج في اللعبة و الحيّاةِ الواقعيّةِ مُختلف ؟

28
00:03:32,120 --> 00:03:33,700
لا ، ليّس كذلك

29
00:03:34,340 --> 00:03:36,260
السبب في إنغماسِ أكـو في ألعابِ الإنترنت

30
00:03:36,530 --> 00:03:39,060
هو لإنها قد تعبتْ من الواقعِ الذي لا يّسير على الكفيّة التي تُريدها

31
00:03:40,000 --> 00:03:42,150
أليّس ذلكَ صحيحاً ، روسيان ؟

32
00:03:42,500 --> 00:03:44,120
أ-أجل

33
00:03:44,150 --> 00:03:45,650
، لكن إن تغيّر ذلك

34
00:03:45,950 --> 00:03:48,780
فستتطلعُ إلى أن تسيّر الأشيّاءُ الواقعيّةُ على النهجِ الذي تُريده

35
00:03:50,520 --> 00:03:52,590
، قد يكون ذلك صحيحاً

36
00:03:53,500 --> 00:03:54,320
، في هذه الحالة

37
00:03:54,560 --> 00:04:00,020
إذا قضتْ العطلة الصيّفيّة مع بقيّتنا ، مُستمتعةً بشبابها
بتمضيّةِ وقتها كفتاةِ مدرسةٍ ثانويّةٍ عاديّة

38
00:04:00,280 --> 00:04:03,350
، بما في ذلك إعترافُ حُـبٍ مُلائمٌ في ظلِ ظروفٍ مثاليّة

39
00:04:03,500 --> 00:04:05,010
فمن المُؤكدِ أن الأمورَ ستسيّر على ما يُّرام

40
00:04:05,340 --> 00:04:06,360
...لـ-لكن

41
00:04:06,440 --> 00:04:09,890
عن أيِّ إعترافٍ ملائمٍ في ظلِ ظروفٍ ملائمةٍ تقصدين ؟

42
00:04:10,550 --> 00:04:12,780
هل أثناءَ مُشاهدةِ غُروبِ الشمسِ بجانبِ البحر ؟

43
00:04:13,230 --> 00:04:16,010
أم لعله أثناء مُراقبةِ السماءِ المليئةِ بالنجوم ؟

44
00:04:16,710 --> 00:04:19,700
أيّنما سنذهبُ إلى المخيّم ، سيّكون هناكَ جوٌ من أجل أيِّ شيءِّ

45
00:04:20,250 --> 00:04:21,950
الباقي منوطٌ بك ، روسيان

46
00:04:24,550 --> 00:04:26,140
منوطٌ...بي

47
00:04:28,950 --> 00:04:32,050
ينبغي عليَّ أن أُظهر نفسي طبيعيّاً و حسب ، كطالبِ مدرسةٍ عاديِّ

48
00:04:32,100 --> 00:04:34,750
و أن أحصُلَ على " موافقةٍ " عاديّةٍ منها ، هذا كلُ شيء

49
00:05:00,490 --> 00:05:03,840
غوشيون-سان ، كم كان ثمنُ منزلِ العطلةِ هذا ؟

50
00:05:03,930 --> 00:05:05,840
هيا ، أخبريني ، كم كان ؟ أخبريني ؟

51
00:05:06,030 --> 00:05:09,510
عذراً ، أيُّمكنُكِ التوقفُ عن إستجوابِ طالِبتكِ عن ثمنِ منزل العطلةِ خاصتها ؟

52
00:05:10,080 --> 00:05:11,880
أ-أجل ، أنتَ مُحق-نيا

53
00:05:11,970 --> 00:05:13,780
هذا صحيحٌ-نيا

54
00:05:14,120 --> 00:05:15,930
إنه كفندقٍ ، أليّس كذلك ؟

55
00:05:16,250 --> 00:05:19,340
إذاً ، ماذا سنفعل ، بعد نقلِ أغراضنا ؟

56
00:05:19,530 --> 00:05:21,680
ننظف ؟ أم نُعرضُ الملائاتِ للهواء ؟

57
00:05:22,040 --> 00:05:23,940
لقد قيلَ لهم بأننا سنأتي اليّوم

58
00:05:24,790 --> 00:05:27,060
لابد أن المشرفيّن على المنزلِ قد بدؤوا بالتعاملِ مع ذلك بالفعل

59
00:05:27,320 --> 00:05:29,060
ماذا ؟ لقد كان ذلك سهلاً

60
00:05:29,790 --> 00:05:33,650
إسمعوا ، ليّس هذا ما يّفترضُ بنادي تخيّمٍ أن يّكون عليّه ؟

61
00:05:34,030 --> 00:05:39,410
أليّس التنظيف و إعدادُ السرير ، أموراً تُريدون القيّامَ بها عادةً !؟

62
00:05:39,430 --> 00:05:43,150
ذلكَ ما يّجعلهُ مُخيّماً قانونيّاً ؟ أليّس كذلك ؟

63
00:05:46,990 --> 00:05:49,740
شاطئٌ شخصيِّ ؟ بجديّة ؟

64
00:05:50,510 --> 00:05:52,410
روسيان ؟

65
00:06:00,840 --> 00:06:02,380
آسفةٌ لجعلكَ تنتظر

66
00:06:07,210 --> 00:06:11,880
...عـ-عُذراً ، إذا حدقتَ بي طويلاً

67
00:06:12,200 --> 00:06:13,520
...هـ-هاه ؟ آسف

68
00:06:14,290 --> 00:06:17,590
حسناً ، أيّن الآخرون ؟

69
00:06:17,940 --> 00:06:21,690
سيّستغرقون وقتاً أطول قليلاً ، لذا أتيّتُ أولاً

70
00:06:22,640 --> 00:06:25,140
إعتقدتُ بأنكَ ستكون وحيداً هنا بمفردك ، روسيان

71
00:06:26,280 --> 00:06:27,990
فـ-فهمت

72
00:06:33,840 --> 00:06:36,090
ليّس من الضروريِّ أن تكوني خجولة

73
00:06:37,620 --> 00:06:41,220
عندما إخترتُ ملابس السباحةِ هذه ، كان كل إهتمامي مُنصباً عليها

74
00:06:41,580 --> 00:06:46,830
لكن الآن ، رغم أنه الوقتُ المناسبُ لإرتدائها ، شعرتُ بالخجل فجأةً

75
00:06:48,180 --> 00:06:49,320
سيّكون كل شيِّ على ما يُّرام

76
00:06:49,550 --> 00:06:50,220
هاه ؟

77
00:06:51,030 --> 00:06:52,990
فأنتِ تبدين لطيفةً جداً

78
00:06:53,740 --> 00:06:54,800
يُّمكنُكِ أن تكوني فخورةً بنفسك

79
00:06:59,330 --> 00:07:01,510
شكراً لك

80
00:07:10,860 --> 00:07:13,280
إذاً فقد أتيّتِ أولاً بالفعل

81
00:07:17,160 --> 00:07:20,250
...هاه ! خطتي ليّظهر ثلاثتنا بملابسِ السباحةِ معاً

82
00:07:20,980 --> 00:07:22,950
...و إعطاءِ روسيان ، نزيفاً أنفياً حاداً

83
00:07:24,320 --> 00:07:26,590
و إرسالهِ ركضاً إلى الحمامِ قد باءتْ بالفشل

84
00:07:29,320 --> 00:07:32,270
لا ، لا رُعاف ، ولا ركض فجأةً

85
00:07:32,560 --> 00:07:35,950
بالمناسبةَ ، أكـو ، هل وضعتِ واقيَّ الشمس ؟

86
00:07:36,000 --> 00:07:36,750
هاه ؟

87
00:07:37,310 --> 00:07:40,930
، مع بشرةٍ شاحبةٍ و حساسةٍ كالتي لديّك

88
00:07:40,960 --> 00:07:42,740
إن أمضيّتِ اليّوم تحت أشعةِ الشمس ، فسيُّرافقُكِ الألم لأسبوع

89
00:07:43,020 --> 00:07:43,920
هاه ؟

90
00:07:44,170 --> 00:07:47,430
مع حروقِ شمسيّةٍ تزيد الألم و تمنعُكِ من الحركة حتى

91
00:07:55,370 --> 00:07:57,080
تحملي قليلاً فقط -

92
00:07:55,370 --> 00:07:57,080
هذا يُّدغدغ -

93
00:07:59,530 --> 00:08:02,530
أنتِ لعوبةٌ في كل مكانٍ حقاً

94
00:08:04,170 --> 00:08:04,880
هممم

95
00:08:04,890 --> 00:08:07,940
بالنظرِ إلى الأمر ، أنتَ لا تضعُ منه أيضاً ، روسيان

96
00:08:08,060 --> 00:08:10,230
...هاه ؟ لا ، أنا لستُ

97
00:08:10,240 --> 00:08:13,090
لا داعيَّ للخجل ، سأضعُ القليلَ عليّك

98
00:08:13,250 --> 00:08:14,060
لا

99
00:08:14,100 --> 00:08:16,540
سأُقدمُ يّد المساعدة

100
00:08:16,560 --> 00:08:17,170
تمهلي

101
00:08:17,180 --> 00:08:19,400
...أودُ أن أضع القليلَ منه أيضاً

102
00:08:19,450 --> 00:08:20,590
تمهلوا

103
00:08:24,090 --> 00:08:27,410
لا ، لا ، ليّس هناك ، ليّس هناك

104
00:08:30,420 --> 00:08:33,330
--لقد إكتفيّت--

105
00:08:35,830 --> 00:08:36,640
أنا ملوث

106
00:08:37,120 --> 00:08:39,210
أنا ملوثٌ جداً

107
00:08:39,790 --> 00:08:40,640
! هوه

108
00:08:41,230 --> 00:08:43,040
ذلك ليّس بالأمر الكبير ، روسيان

109
00:08:43,160 --> 00:08:45,320
ينبغي أن تكون شاكراً لنا ، بدلاً من ذلك

110
00:08:45,680 --> 00:08:47,900
يبدو أن الجميع مُستعد

111
00:08:49,640 --> 00:08:52,370
إذاً ، دعونا نذهب جميعاً

112
00:08:52,840 --> 00:08:54,240
أجل

113
00:08:54,260 --> 00:08:55,380
...أجل

114
00:09:33,350 --> 00:09:35,530
حسناً ، لقد كانتْ سباحةً رائعة

115
00:09:35,780 --> 00:09:37,420
لقد كان غوصاً رائعاً

116
00:09:37,510 --> 00:09:39,310
و أنا إستمتعُ بالطوفِ أيضاً

117
00:09:39,410 --> 00:09:41,300
لقد كان رائعاً حقاً

118
00:09:41,510 --> 00:09:45,890
يبدو أنكم قد إنتهيّتم جميعاً ، لكن النهار ما يزالُ في منتصفه

119
00:09:46,110 --> 00:09:46,890
هاه ؟

120
00:09:47,420 --> 00:09:50,860
و شيءٌ آخر ، لم لا تلعبون جميعكم معاً !؟

121
00:09:51,620 --> 00:09:52,360
هاه !؟

122
00:09:52,880 --> 00:09:54,460
...الأمر فقط

123
00:09:56,110 --> 00:09:57,390
أشبه بهذا

124
00:09:57,450 --> 00:10:01,950
خريطة جديدة

125
00:09:57,540 --> 00:10:00,700
تخيّلي أن هنالك لعبةَ إنترنت قد تم تنصيب خرطةٍ جديدةٍ بها

126
00:10:00,720 --> 00:10:01,990
...هـ-هاه ؟ أجل

127
00:10:02,090 --> 00:10:05,030
لذا بعد ذلك ، نذهبُ جميعاً إلى الخريطةِ الجديدةِ معاً

128
00:10:05,090 --> 00:10:07,560
لكن ما إن ندخلُ إليّها ، فإننا ننقسمُ على الفور

129
00:10:07,590 --> 00:10:08,700
لماذا ؟

130
00:10:08,750 --> 00:10:10,950
...الشيءُّ المهمُ في الخريطةِ الجديدةِ هو

131
00:10:12,490 --> 00:10:14,470
....كم ستكون نقاطُ الخبرةَ جيّدةٌ بالقتالِ الفرديِّ

132
00:10:16,330 --> 00:10:17,850
أو إن كانتْ هنالك أدواتٌ نادرةٌ أم لا

133
00:10:18,110 --> 00:10:20,650
و كم سيّكون مدى إرتفاعِ مُعدلِ الوفيات

134
00:10:21,520 --> 00:10:23,540
...هاه ؟ و بعد ذلك

135
00:10:23,590 --> 00:10:25,820
بعد القيّامِ بجولتنا ، نجتمعُ مُجدداً

136
00:10:25,880 --> 00:10:28,590
و في النهايّة ، نقوم بقياسِ مكاسبنا الجماعيّة

137
00:10:28,930 --> 00:10:31,660
و نقوم بما نُريدُ القيامَ به بشكلٍ فرديٍّ و من ثم نعود مُجدداً عند الإنتهاء

138
00:10:31,750 --> 00:10:32,990
هذا هو أُسلوبنا

139
00:10:33,080 --> 00:10:35,970
هل هذا الوضعُ الطبيعيُّ الجديد الآن بالنسبة لكم ؟

140
00:10:36,010 --> 00:10:39,160
أنا لا أعلم بشأن ذلك ، ما إن كان طبيعياً بالنسبة لنا

141
00:10:39,270 --> 00:10:40,530
أجل ، أجل

142
00:10:40,540 --> 00:10:43,910
و الآن بعد أن جعلتنا نقول ذلك ، أُريد أن ألعبَ بعض ألعاب الإنترنت

143
00:10:44,150 --> 00:10:46,090
الإنترنتْ ممنوعةٌ خلال مُخيّمنا

144
00:10:46,350 --> 00:10:47,930
...أجل ، أعلم ذلك ، لكن

145
00:10:47,950 --> 00:10:49,930
لقد فرغتُ من اللعبِ في البحر

146
00:10:49,950 --> 00:10:52,470
أودُ الذهاب و النومَ في المنزل

147
00:10:53,520 --> 00:10:54,820
لا يُّمكنني تصديقكم

148
00:10:55,180 --> 00:10:58,120
هذا مُخيّمٌ صيفيٌّ ، و نحن على الشاطئ

149
00:10:58,320 --> 00:11:02,860
كيّفَ لا يُّمكنكم اللعبُ معا ، و التلألؤ بعرق الشباب !؟

150
00:11:03,360 --> 00:11:04,860
عرق الشباب ؟

151
00:11:05,030 --> 00:11:06,950
نحن لسنا جيّدين في ذلك

152
00:11:07,110 --> 00:11:10,940
جيّداً أم لا ، إذا إستسلمتمْ ، فلن تُحرزوا أيَّ تقدم-نيا

153
00:11:10,960 --> 00:11:13,990
فلتُحاولوا القيام بذلك ، يُّمكنكم القيام بذلك إذا حاولتم-نيا

154
00:11:14,020 --> 00:11:16,950
لماذا لا تُعطون الأمر أفضل ما لديّكم !؟

155
00:11:17,370 --> 00:11:21,850
--هاه ، لكن ، إذا حاولنا لعبَ لعبة إنترنت ، و لم تَرقنا ، فإننا  ننتقل لـ -

156
00:11:21,660 --> 00:11:26,500
! الواقعُ و الألعابُ مُختلفيّن ، إفعلوها و حسب ! هيا إفعلوا ذلك -

157
00:11:26,730 --> 00:11:29,560
هذا أمرٌ من مُرشدتكم

158
00:11:31,980 --> 00:11:33,440
سيّدتي

159
00:11:44,390 --> 00:11:47,640
! أجل ! إذهب يساراً ! يميناً ! يساراً ! يميناً

160
00:11:47,720 --> 00:11:50,020
! و الآن فوق ! فوق ! أسفل ! أسفل

161
00:11:50,020 --> 00:11:51,820
! B ثم ! A و الآن إنتقل إلى

162
00:11:51,820 --> 00:11:54,330
أنتم ، هذا نمطُ سيّطرةِ الإله

163
00:11:57,280 --> 00:11:57,930
هاه ؟

164
00:12:04,930 --> 00:12:06,180
حسناً ، إنتهيّنا

165
00:12:07,080 --> 00:12:07,730
همم

166
00:12:13,380 --> 00:12:14,080
مهلا

167
00:12:14,330 --> 00:12:15,710
ما هذا ؟

168
00:12:25,010 --> 00:12:28,030
عرق الشباب يُّمكنُ أن يّكون رائعاً بين الحين و الآخر

169
00:12:29,980 --> 00:12:30,680
هذا صحيح

170
00:12:31,640 --> 00:12:34,230
...من المفترض أنا أتصرف كشابٍ عاديٍّ في هذا المخيّم

171
00:12:34,980 --> 00:12:35,830
...و أقول لأكـو

172
00:12:39,380 --> 00:12:40,180
روسيان

173
00:12:40,180 --> 00:12:41,480
مـ-مـ-ماذا ؟

174
00:12:41,480 --> 00:12:43,780
أنتَ لا تُمانعُ إذا إنضممتُ إليّك ، صحيح ؟

175
00:12:47,720 --> 00:12:50,180
تمهلي ، ماذا تعتقدين نفسك فاعلة ؟

176
00:12:50,270 --> 00:12:51,380
قليلاً فقط

177
00:12:51,530 --> 00:12:53,030
أطول قليلاً فقط

178
00:12:53,180 --> 00:12:54,910
كان ليُّصبح الأمر رائعاً للتو -

179
00:12:54,180 --> 00:12:55,880
قطعاً لن يكون كذلك -

180
00:12:55,140 --> 00:12:55,880
لقد رأتني -

181
00:12:55,880 --> 00:12:57,180
في ماذا تُفكرين ؟

182
00:13:06,120 --> 00:13:07,720
BBQ دعونا نقم بـ

183
00:13:06,250 --> 00:13:09,250
معناها حفل شواء و قد إنتشر هذا الإختصار في الإنترنت : BBQ

184
00:13:08,570 --> 00:13:09,670
أنتِ تقصدين حفل شواء ؟

185
00:13:12,430 --> 00:13:13,830
BBQ دعونا نقم بـ

186
00:13:14,330 --> 00:13:15,830
هوه ، إنها تُؤكد على طريقتها

187
00:13:16,530 --> 00:13:17,530
...عذراً

188
00:13:17,980 --> 00:13:21,380
لـ-لماذا لم يّتمَ تهيّأتُ هذه المكونات ؟

189
00:13:22,930 --> 00:13:24,630
مـا الذي....تعنيه بهذا ؟

190
00:13:27,930 --> 00:13:29,130
حسناً

191
00:13:29,680 --> 00:13:30,830
سأرى ما يُّمكنني القيام به

192
00:13:31,500 --> 00:13:33,000
أُريد المحاولة أيضاً

193
00:13:33,220 --> 00:13:34,880
....ليّس لديّنا وقتٌ كافٍ

194
00:13:36,600 --> 00:13:38,250
...أكو قامتْ بإهمالي

195
00:13:38,570 --> 00:13:40,480
...لقد أشارتْ بأني سأقف عقبةً في الطريق

196
00:13:41,280 --> 00:13:42,380
هوه -

197
00:13:41,630 --> 00:13:42,980
مدهش ؟ -

198
00:13:43,430 --> 00:13:44,730
يبدو لذيذاً -

199
00:13:44,310 --> 00:13:45,330
إنه لذيذٌ جداً -

200
00:13:46,410 --> 00:13:48,810
هاه ، لقد شبعت حقاً

201
00:13:49,020 --> 00:13:50,480
لقد كان لذيذاً ، صحيح ؟

202
00:13:51,220 --> 00:13:54,730
لكن ، لا يُّمكنُنني التصديق بأننا نخلو من أيِّ مهاراتِ طبخٍ عداك أنتِ ، أكو

203
00:13:56,040 --> 00:13:57,730
من الرائع أنكِ كُنتِ هنا لمساعدتنا

204
00:14:01,380 --> 00:14:04,380
فلتتذوقوا طعم نصلِ سيادتي المُحترق

205
00:14:04,610 --> 00:14:06,280
هل تقوم بمهارةِ السيّف العريض ؟

206
00:14:06,840 --> 00:14:08,330
إنها تُأرجحه في كل مكان ؟

207
00:14:08,930 --> 00:14:10,080
ذلك خطيرٌ جداً

208
00:14:10,260 --> 00:14:12,180
أنتِ

209
00:14:14,780 --> 00:14:16,480
هوه ، إنها تقوم بتدويرها

210
00:14:18,730 --> 00:14:20,280
إكتمل التدريب

211
00:14:28,060 --> 00:14:29,730
يبدو أنه قد حان الوقت

212
00:15:02,410 --> 00:15:03,820
ما الأمر ، أكو ؟

213
00:15:04,980 --> 00:15:05,700
هاه ؟

214
00:15:05,860 --> 00:15:06,480
ماذا..؟

215
00:15:07,400 --> 00:15:08,850
أ-أنا آسفة

216
00:15:09,010 --> 00:15:11,080
لم أقصد أن أبكي

217
00:15:12,040 --> 00:15:14,580
بطريقةٍ ما ، أنا سعيدةٌ جداً

218
00:15:15,640 --> 00:15:17,080
...لم أعتقد أبداً

219
00:15:18,040 --> 00:15:20,330
بأنني سأُمضي يوماً كهذا

220
00:15:21,190 --> 00:15:23,880
لذا فأنا سعيدةٌ جداً ، فهو لا يبدو حقيقياً

221
00:15:24,940 --> 00:15:27,330
لكن لسببٍ ما ، أشعر بالحزنِ أيضاً

222
00:15:29,410 --> 00:15:30,080
..أكو

223
00:15:31,750 --> 00:15:32,430
...عذراً

224
00:15:34,170 --> 00:15:35,630
شكراً لك

225
00:15:37,210 --> 00:15:38,410
على ماذا ؟

226
00:15:38,590 --> 00:15:40,930
أعني أنه ، إذا لم تكن أنتَ ، روسيان

227
00:15:41,100 --> 00:15:43,130
فما كُنتُ لأكون في مكانٍ كهذا أبداً

228
00:15:44,530 --> 00:15:47,830
و أنتِ أيضاً ، أكو ، لو لم تكوني أنتِ ، لما كنتُ هنا كذلك

229
00:15:48,720 --> 00:15:52,030
إذن فهو أمر رائعٌ أن كليّنا معاً ، صحيح ؟

230
00:15:53,980 --> 00:15:54,830
هذا صحيح

231
00:16:03,330 --> 00:16:03,930
...أكو

232
00:16:05,580 --> 00:16:06,930
...أكو ، أنا

233
00:16:08,280 --> 00:16:09,030
أُحبك

234
00:16:14,180 --> 00:16:15,130
و أنا

235
00:16:16,230 --> 00:16:20,230
و أنا...أُيضا ، روسيان ، أُحبـك

236
00:16:27,630 --> 00:16:29,080
...نحن نُشكلُ بالفعل

237
00:16:29,980 --> 00:16:31,430
زوجيّن رائعيّن ، أليّس كذلك ؟

238
00:16:43,890 --> 00:16:45,630
و بالرغم من كل ذلك ، لم ينجح الأمر

239
00:16:47,600 --> 00:16:51,880
لقد إعتقدتُ بأنه إذا قطعنا أنفسنا عن الإنترنت و حضيّنا بصيّفٍ عاديِّ ، فسيّنجحُ الأمر

240
00:16:52,430 --> 00:16:55,830
حسناً ، إنها تعتقد بأنكما زوجيّن بأتمِ معنى الكلمةَ في الحياةِ الواقعيّةِ أيضاً

241
00:16:56,380 --> 00:16:57,540
و شيءٌ آخر

242
00:16:58,090 --> 00:16:59,830
...بعد الوصول إلى هذا الحد ، لقد أدركتُ شيئاً

243
00:17:00,820 --> 00:17:03,530
الأزواج هي مراتب أعلى من الصديقة و الصديق

244
00:17:04,830 --> 00:17:08,430
لا يهم ما أقوم به ، فما من شيءِّ سيُّقنعُ أكو

245
00:17:11,050 --> 00:17:12,580
...يبدو أن مسعانا هذا

246
00:17:13,190 --> 00:17:14,480
قد فشل...

247
00:17:15,080 --> 00:17:16,630
هياً ، جميعاً

248
00:17:17,170 --> 00:17:18,990
لقد حان الوقتُ لإطفاء الأنوار

249
00:17:19,200 --> 00:17:20,280
أسرعوا و إذهبوا للنوم

250
00:17:23,550 --> 00:17:25,030
و الآن ، لنستعد للذهاب

251
00:17:26,860 --> 00:17:30,530
ماستر ، عندما تقولين " ذهاب " ، هل سنذهبُ لمكانٍ آخر ؟

252
00:17:32,090 --> 00:17:33,080
إلى مكانٍ رائع

253
00:17:35,350 --> 00:17:36,650
مُخيّم الزهور

254
00:17:37,230 --> 00:17:41,330
إبتداءً من الآن ، مُخيّم نادي الألعاب و الإتصالاتِ الحديثة سيبدأ

255
00:17:43,930 --> 00:17:44,830
ما هذا..؟

256
00:17:45,480 --> 00:17:49,180
" هذا الفندق يتعامل حالياً مع لعبة " العصر الأسطوري

257
00:17:50,120 --> 00:17:51,430
هل يقومون بذلك بفندق ؟

258
00:17:51,960 --> 00:17:54,380
لابد أن شخصاً ما قد إنقلبَ أخيراً على المجموعاتِ النهائيّة

259
00:17:54,090 --> 00:17:55,190
هاه ؟

260
00:17:55,230 --> 00:17:57,130
لديّهم الملك المدمدمُ أيضاً

261
00:18:00,330 --> 00:18:02,330
إنه ناعمٌ جداً

262
00:18:03,950 --> 00:18:06,530
سيغاوا ، أأنتِ واثقةٌ من أنكِ لا تُريدين الذهاب أيضاً ؟

263
00:18:07,170 --> 00:18:08,930
بـ-بالتأكيد ، لن أذهب

264
00:18:09,810 --> 00:18:11,380
لقد إنتهيّت من تسجيل أسمائنا في الفندق

265
00:18:12,290 --> 00:18:13,810
تفضل مفاتيحك

266
00:18:15,570 --> 00:18:16,390
ما هذا ؟

267
00:18:16,590 --> 00:18:18,480
رمزٌ لإستخدامهِ من أجل الحدث

268
00:18:19,800 --> 00:18:21,460
إنه رائعٌ جداً

269
00:18:21,650 --> 00:18:25,010
كنتيجةٍ لقطع أنفسنا عن الإنترنت ليومٍ واحد

270
00:18:25,140 --> 00:18:28,330
قوانا في ألعابِ الإنترنت قد إرتفعتْ إلى مستوى لم تصل إليّه من قبل

271
00:18:29,720 --> 00:18:31,380
...و بإستخدامِ رموزِ المرور هذه

272
00:18:34,040 --> 00:18:37,480
و بتسجيل الدخول هناك ، فسنبدأ الحدث الكبير الذي طال إنتظاره

273
00:18:38,500 --> 00:18:41,480
هكذا إذن ، إذا هذا ما تُستعمل من أجله مفاتيح المرور

274
00:18:44,920 --> 00:18:49,480
و كل ما تبقى هو أن ندخُلَ بإستخدام المعرفِ و كلمةِ السر الخاصةِ بنا كالمعتاد ؟

275
00:18:50,380 --> 00:18:51,040
هاه ؟

276
00:18:51,250 --> 00:18:52,640
هيا ، لا تختلسي النظر

277
00:18:52,820 --> 00:18:53,980
تلك ليّست عادةً جيّدة

278
00:18:54,140 --> 00:18:54,920
هاه ؟

279
00:18:54,930 --> 00:18:56,530
لما لا ؟

280
00:18:56,700 --> 00:18:59,240
كلمة سر الزوجِ هي كلمة سر الزوجة

281
00:18:59,410 --> 00:19:01,480
ما من أحد يعتقد ذلك

282
00:19:03,570 --> 00:19:04,050
ماذا ؟

283
00:19:04,730 --> 00:19:05,650
ما الخطب ؟

284
00:19:05,860 --> 00:19:08,430
لا ، يبدو أنها لم تقبل كلمة سري

285
00:19:09,100 --> 00:19:10,380
لابد أنكَ كتبته بشكل خاطئ

286
00:19:11,550 --> 00:19:13,630
ذلك بسببِ تدخل ، أكو

287
00:19:21,320 --> 00:19:22,410
دخلتُ هذه المرة

288
00:19:23,760 --> 00:19:27,130
هاه ، إنه مُعدٌ كالفندقِ في الحياةِ الواقعيّة

289
00:19:27,860 --> 00:19:31,130
إنها خريطةٌ لا يُّمكن لسوى مشاركي الحدثِ بالدخول إليها

290
00:19:32,680 --> 00:19:36,180
مرحباً بكم في " العصر الأسطوري " ، إختاروا الحدث التعاونيِّ

291
00:19:36,730 --> 00:19:40,880
هنالك العديد من المكافآةِ المُخصصةِ لجميع المشاركين

292
00:19:41,890 --> 00:19:45,030
إبدؤوا بالذهاب إلى مطعم الطابق الأول من فندق الزهور

293
00:19:49,830 --> 00:19:52,980
أسماء الأدواتِ مكتوبةٌ على جانبِ القوائمِ

294
00:19:53,960 --> 00:19:57,600
هل هذا يعني أنه إذا قُمتَ بأمرهم ، فستحصلُ على تلك الأداةِ في اللعبة ؟

295
00:19:57,780 --> 00:19:58,490
هذا صحيح

296
00:19:59,200 --> 00:20:00,200
هذا شنيع

297
00:20:00,410 --> 00:20:01,480
...إنه شنيعٌ ، لكن

298
00:20:02,580 --> 00:20:05,230
أُريد بعض الأدواتِ القويّة و المصقولة

299
00:20:06,790 --> 00:20:12,780
هاه ؟ إذاً إذا أدخلتَ الرمز الموجود في البطاقة
التي حصلتَ عليهت من التسجيل ، فستحصلُ على تلك الأداة

300
00:20:14,170 --> 00:20:15,480
هنالك شيءٌ مكتوبٌ على ظهرِ البطاقة

301
00:20:17,760 --> 00:20:22,780
" نفس المكافآتِ تنتظركم في محل الهدايا الموجود في الطابق الأول "

302
00:20:29,720 --> 00:20:33,430
أنتِ ، لماذا إشتريّتِ الكثير من صناديقِ كعكِ الزنجبيل ؟

303
00:20:34,100 --> 00:20:35,330
ما باليّد حيلة

304
00:20:35,970 --> 00:20:37,830
فقد كان لديّهم أدواتٌ أردتها

305
00:20:38,950 --> 00:20:43,830
لابد أن مشاركةَ طلابٍ في هذا الحدثِ ستعطيهم لمحةً صغيرةً عن مدى بلوغ العالم

306
00:20:44,550 --> 00:20:47,710
، لقد حصلنا على أكياسٍ كثيرةٍ الآن ، لذا دعونا نقتسمها

307
00:20:47,930 --> 00:20:49,530
و نأخذ قسطاً من الراحةٍ في غرفنا

308
00:20:50,590 --> 00:20:55,030
بذكر ذلك ، لقد قُمنا بالتسجيل للتو ، ولم نذهب إلى غرفنا بعد ؟

309
00:20:55,630 --> 00:20:58,100
الغرف المستخدمة لهذا الحدثِ الترويجيِّ المشترك

310
00:20:58,250 --> 00:21:00,930
مُجهزةٌ بحواسيب و وصلاتِ إنترنت

311
00:21:01,090 --> 00:21:01,530
هاه ؟

312
00:21:01,570 --> 00:21:03,430
إذن فذلك يعني بأن العناصر التي حصلنا عليها...؟

313
00:21:05,480 --> 00:21:06,480
هذا صحيح

314
00:21:13,730 --> 00:21:15,220
روسيان,
أنتِ متأخرة

315
00:21:15,780 --> 00:21:17,230
أيّن هي شو و ماستر ؟

316
00:21:17,230 --> 00:21:20,580
كلاهما قالا بأنهما سيذهبان لتجربة أدواتهما

317
00:21:21,130 --> 00:21:22,340
هكذا إذن

318
00:21:22,340 --> 00:21:23,860
إذاً ، يجب أن نذهب أيضاً

319
00:21:24,010 --> 00:21:25,680
...لا بأس بذلك ، لكن

320
00:21:27,190 --> 00:21:28,180
...إذا أحببت

321
00:21:28,950 --> 00:21:30,130
...ألا تُمانعُ بالقدومِ...

322
00:21:30,970 --> 00:21:32,180
إلى غرفتي ؟...

323
00:21:32,950 --> 00:21:33,480
هاه ؟

324
00:21:43,130 --> 00:21:44,780
هـ-هذا صحيح

325
00:21:45,370 --> 00:21:47,920
عندما قلتِ غرفتك ، فأنتِ تعنين غرفتك في العالم الإفتراضيِّ

326
00:21:48,080 --> 00:21:48,880
روسيان

327
00:21:51,330 --> 00:21:52,480
...نحن الآن

328
00:21:53,260 --> 00:21:55,430
بمفردنا في غرفةٍ في فندقٍ ، صحيح ؟

329
00:21:56,690 --> 00:21:57,580
...لقد

330
00:21:58,610 --> 00:22:01,280
كُنتُ أنتظر هذا منذُ وقتٍ طويل...

331
00:21:59,950 --> 00:22:06,950
لمزيد من الأنميات زورونا على مدونتنا

332
00:22:06,880 --> 00:22:07,680
روسيان...

333
00:22:09,770 --> 00:22:10,580
...حسناً

334
00:22:11,850 --> 00:22:12,730
ماذا ، الآن ؟

335
00:22:13,990 --> 00:22:16,830
نحن الآن مُختليّانِ بأنفسنا ، صحيح ؟

336
00:22:17,330 --> 00:22:18,500
...لذلك

337
00:22:18,670 --> 00:22:21,130
...أود أن نتبادل حديثَ الزوجيّن الآن...

338
00:22:21,950 --> 00:22:22,630
...هممم

339
00:22:23,430 --> 00:22:25,430
الزوجيّن ، إذن ؟

340
00:22:44,960 --> 00:22:56,970
دائماً ما تُريني مناظر جديدةٍ عندما نذهبُ في مغامراتٍ أنا و أنت

341
00:22:56,970 --> 00:22:59,870
لقد خرجتُ من هذه الأرض الواسعة

342
00:22:59,870 --> 00:23:02,730
و الرياح تهبّ

343
00:23:02,730 --> 00:23:09,500
شعرتُ بها في هذا المكان الذّي لا يمكننا التحرّكُ فيه

344
00:23:09,500 --> 00:23:14,670
و لكن يوجدُ شيءٌ واحدٌ مؤكّدٌ كنتُ قد شعرتُ به

345
00:23:14,670 --> 00:23:23,110
و هو الخاتم الذّي أبقيته في قلبي مخفيّاً بداخل اللحظات التّي قضيتها معك

346
00:23:23,110 --> 00:23:29,360
في عالم الصفر و الواحد ، اللطافة التّي شعرتُ بها

347
00:23:29,360 --> 00:23:35,440
و الدفء الملموس داخل قلبي كانا حقيقّيان

348
00:23:35,620 --> 00:23:41,020
الكلمات التّي أرغبُ بقولها لك تستمرُّ في التضاعف

349
00:23:41,440 --> 00:23:46,730
ستعبر مشاعرنا أيّ مسافة

350
00:23:46,740 --> 00:23:53,910
و في يومٍ ما سأكون بجانبك

351
00:23:59,940 --> 00:24:09,940
لقد إعتقدت بأنني قد إستسلمتُ

352
00:23:59,940 --> 00:24:09,940
لعبة إنترنت

353
00:23:59,940 --> 00:24:09,940
كوني زوج

354
00:24:00,380 --> 00:24:02,030
ما الأمر الكبير في ملابس السباحة ؟

355
00:24:02,030 --> 00:24:05,030
فقط بسببِ أنه الصيّف ، لا يعني هذا أنه ينبغي عليّنا إرتداء ملابس السباحة

356
00:24:05,030 --> 00:24:05,880
لا بأس

357
00:24:05,880 --> 00:24:07,530
الملابس التي ترتدينا من النوعِ الفاخر

358
00:24:07,530 --> 00:24:08,280
إنها أداةٌ جامعةَ

359
00:24:08,280 --> 00:24:09,940
سأقوم بركلك