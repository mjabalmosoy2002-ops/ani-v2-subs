1
00:00:00,000 --> 00:00:03,940
"أوجي-سان وعالم أحلامه"

2
00:00:04,950 --> 00:00:07,550
.تمكّنّا من الانتهاء في الوقت المحدّد

3
00:00:08,770 --> 00:00:10,180
.صحيح

4
00:00:11,580 --> 00:00:14,970
لا يزال أمامنا بضع دقائق
.قبل مغادرة القطار

5
00:00:14,970 --> 00:00:16,410
"هدايا تذكاريّة"

6
00:00:16,630 --> 00:00:18,540
سأحضر بعض الهدايا التّذكاريّة

7
00:00:18,540 --> 00:00:22,070
لموظّفْيَّ ولأقسام العمل الأخرى
.الّتي تقدّم لنا المساعدة

8
00:00:22,840 --> 00:00:24,900
هل سيعجبهم هذا؟

9
00:00:25,720 --> 00:00:27,910
!وأريد شيئًا لماسومي أيضًا

10
00:00:28,350 --> 00:00:29,380
مهلاً؟

11
00:00:30,350 --> 00:00:33,720
من النّادر أن أرى ناروتو
.مترّددًا إلى هذا الحدّ

12
00:00:34,520 --> 00:00:36,830
ما الّذي ينظر إليه؟

13
00:00:37,610 --> 00:00:40,510
!إنّه يحمل شيئًا ظريفًا للغاية

14
00:00:41,240 --> 00:00:43,130
.شكرًا لشرائكم

15
00:00:46,190 --> 00:00:48,760
أشياء ظريفة؟

16
00:00:47,910 --> 00:00:50,970
"ازدراء"

17
00:00:48,790 --> 00:00:51,400
!لا أهتمّ إلاّ بالقطط الحقيقيّة

18
00:00:51,400 --> 00:00:52,700
.هذا الأمر يحيّرني

19
00:00:52,700 --> 00:00:55,910
،إنّه ناروتو في النّهاية
فلماذا قد يشتري شيئًا كهذا؟

20
00:00:59,130 --> 00:01:00,360
هل من مشكلة؟

21
00:01:02,550 --> 00:01:03,530
.لا

22
00:01:04,260 --> 00:01:06,960
.ليس من شأني

23
00:01:20,150 --> 00:01:24,060
"هوس العمّ بالأشياء الظّريفة"

24
00:02:43,940 --> 00:02:44,930
.مساء الخير

25
00:02:47,780 --> 00:02:49,010
.مساء الخير لك أيضًا

26
00:02:49,280 --> 00:02:52,880
،في الآونة الأخيرة
.أصبح ناروتو يغادر أبكر قليلاً

27
00:02:56,040 --> 00:02:57,970
.سيعود ماسومي قريبًا

28
00:02:58,210 --> 00:02:59,600
.حان وقت انصرافي أنا أيضًا

29
00:03:04,590 --> 00:03:06,700
...تحقُّق... تحقُّق

30
00:03:07,300 --> 00:03:09,150
.لا، ليس هنا

31
00:03:09,590 --> 00:03:11,920
لكن من أنتظر أصلاً؟

32
00:03:11,920 --> 00:03:13,950
...بالطّبع، القطّ الصّغير أوّلاً

33
00:03:14,390 --> 00:03:15,550
!أجل

34
00:03:15,550 --> 00:03:18,630
!ولكنّ ماسومي ني أيضًا... منقذي

35
00:03:18,850 --> 00:03:22,550
،أثناء رحلة العمل الّتي قمت بها
اشتريت هديّة تذكاريّة

36
00:03:22,550 --> 00:03:27,290
بعلبة عليها قطّة ظريفة تحسّبًا
...لرؤيته هنا مجدّدًا

37
00:03:29,570 --> 00:03:33,690
"...آخ"

38
00:03:29,900 --> 00:03:32,020
أتُراني أبالغ؟

39
00:03:32,020 --> 00:03:33,690
!لا، هذا هو التّصرّف الصّحيح

40
00:03:33,690 --> 00:03:35,440
!لقد أحسنتُ التّدبير

41
00:03:35,440 --> 00:03:37,150
،رأيتُ هديّة مناسبة

42
00:03:37,150 --> 00:03:40,810
!فاشتريتها تحسّبًا فقط لرؤيته مجدّدًا

43
00:03:41,150 --> 00:03:44,030
.لا بأس إن لم أتمكّن من إعطائها له

44
00:03:44,030 --> 00:03:45,230
!لا بأس إطلاقًا

45
00:03:51,300 --> 00:03:52,460
.حسنًا، لنعد إلى المنزل

46
00:03:54,260 --> 00:03:56,360
ماذا؟ ناروتو-سان؟

47
00:03:58,640 --> 00:03:59,700
!مساء الخير

48
00:04:00,600 --> 00:04:03,010
!إنّه أنت يا ني-كُن

49
00:04:03,010 --> 00:04:06,310
هل ما زلت تبحث
عن قطّ المرّة الماضية؟

50
00:04:06,310 --> 00:04:07,930
!إنّه هنا فعلاً

51
00:04:08,360 --> 00:04:10,340
!لم أتوقّع أن أراه مجدّدًا

52
00:04:10,900 --> 00:04:12,980
.نعم، هذا صحيح

53
00:04:12,980 --> 00:04:15,760
.لكنّني لا أراه هنا هذا المساء

54
00:04:16,780 --> 00:04:19,900
.بالمناسبة يا ني-كُن، هذه لك

55
00:04:22,860 --> 00:04:28,410
كنتُ في رحلة عمل قبل أيّام
،ورأيت علبة عليها قطّة

56
00:04:28,410 --> 00:04:32,000
...فتذكّرتك واشتريتها تحسّبًا لأيّ طارئ

57
00:04:32,000 --> 00:04:33,290
.شكرًا جزيلاً لك

58
00:04:36,350 --> 00:04:39,340
هل تنتظر شخصًا مجدّدًا؟

59
00:04:39,340 --> 00:04:42,080
...نعم، هذا صحيح. أنتظر عمّي الّذي

60
00:04:44,150 --> 00:04:47,280
.عفوًا، هذه من عمّي

61
00:04:47,280 --> 00:04:52,050
"عمّ = أوجي"

62
00:04:47,610 --> 00:04:48,790
...عمّي

63
00:04:49,650 --> 00:04:51,090
...إنّه عمّي

64
00:04:51,900 --> 00:04:53,130
عمّه؟

65
00:04:53,320 --> 00:04:55,130
...مهلاً، هل يقصد

66
00:04:53,450 --> 00:04:55,210
"عمّي"

67
00:04:55,230 --> 00:04:56,730
"أوجي-سان"

68
00:04:55,680 --> 00:04:56,730
أوجي-سان؟

69
00:04:58,280 --> 00:04:59,590
!لا، مستحيل

70
00:04:59,700 --> 00:05:01,890
.حسنًا، سأذهب الآن

71
00:05:03,540 --> 00:05:04,600
.ناروتو-سان

72
00:05:05,530 --> 00:05:08,320
!شكرًا على الهديّة التّذكاريّة

73
00:05:11,740 --> 00:05:14,280
.لا داعي للشّكر، فالأمر بسيط

74
00:05:14,290 --> 00:05:16,110
!لا تقل ذلك

75
00:05:17,510 --> 00:05:21,240
،عندما تدخل جحيم الحياة المهنيّة

76
00:05:21,260 --> 00:05:23,950
!احرص على ألاّ تفقد براءتك يا ني-كُن

77
00:05:27,730 --> 00:05:30,000
.كان أكل مطعم هذا المساء لذيذًا

78
00:05:30,190 --> 00:05:32,880
.نعم، لقد استمتعنا بالطّعام

79
00:05:37,910 --> 00:05:40,130
...مهلاً؟ أليس هذا

80
00:05:40,610 --> 00:05:41,970
تتساءل عن هذه؟

81
00:05:42,410 --> 00:05:44,240
...إنّها هديّة من

82
00:05:44,250 --> 00:05:47,570
.الرّجل الّذي قابلتُه في الحديقة قبل أيّام

83
00:05:49,040 --> 00:05:50,780
.ذلك الرّجل الغامض الّذي أخبرني عنه

84
00:05:51,380 --> 00:05:56,070
يتسوّق معه، ثمّ يقدّم له ذلك الرّجل هديّة؟

85
00:05:56,880 --> 00:05:59,250
أليس هذا غريبًا بعض الشّيء؟

86
00:05:59,250 --> 00:06:01,860
على أيّ حال، نحن نعيش
.في عصر التّواصل الاجتماعيّ

87
00:06:01,880 --> 00:06:04,490
...أظنّ أنّ كلّ شيء ممكن، ولكن مع ذلك

88
00:06:04,810 --> 00:06:07,330
إنّها قطع بسكويت. هل نأكلها؟

89
00:06:08,650 --> 00:06:13,180
إنّها نفس العلبة تمامًا
!الّتي اشتراها ناروتو-كُن

90
00:06:14,650 --> 00:06:17,140
ما طبيعة علاقتك بهذا الشّخص؟

91
00:06:17,140 --> 00:06:21,090
علاقتي به؟
...حسنًا، لست متأكّدًا تمامًا

92
00:06:21,330 --> 00:06:22,470
.يصعب وصفها

93
00:06:22,580 --> 00:06:24,430
،كانت لديه مشكلة

94
00:06:24,440 --> 00:06:27,520
.لذا قدّمت له بعض المساعدة

95
00:06:28,110 --> 00:06:30,070
ماذا؟ ماذا؟ ماذا؟

96
00:06:30,920 --> 00:06:33,810
!فهمت! لا، لم أفهم شيئًا في الحقيقة

97
00:06:34,030 --> 00:06:38,030
.لكن يبدو أنّك لا تعرف عنه إلاّ القليل

98
00:06:38,040 --> 00:06:39,900
إنّ مرافَقة رجل غريب

99
00:06:39,930 --> 00:06:43,250
...وتلقّى الهدايا منه أمر مريب بعض الشّيء

100
00:06:43,250 --> 00:06:46,080
.نعم، أفهم ما تقصده

101
00:06:46,090 --> 00:06:48,370
.لكنّني لم أرافقه دون تفكير

102
00:06:48,380 --> 00:06:51,290
.في الواقع، أنا من دعوته للخروج

103
00:06:51,720 --> 00:06:53,880
!كلّما سمعت أكثر، ازداد الأمر غموضًا

104
00:06:54,300 --> 00:06:56,210
...حسنًا، لا بأس إذًا

105
00:06:56,230 --> 00:06:57,550
.ماسومي

106
00:06:57,560 --> 00:07:00,890
أيّ حياة جامعيّة تعيشها؟

107
00:07:00,890 --> 00:07:02,300
.عفوًا، شكرًا لك

108
00:07:02,320 --> 00:07:03,730
...بالمناسبة، هذا الرّجل

109
00:07:03,730 --> 00:07:05,190
.اسمه ناروتو-سان

110
00:07:07,080 --> 00:07:09,060
.ويرتدي نظّارة

111
00:07:09,650 --> 00:07:11,480
رجل يرتدي نظّارات؟

112
00:07:12,500 --> 00:07:14,490
...الهديّة التّذكاريّة

113
00:07:14,840 --> 00:07:16,810
...ويرتدي نظّارات أيضًا

114
00:07:17,490 --> 00:07:19,540
أيمكن أن يكون ناروتو-كُن ذاك؟

115
00:07:19,540 --> 00:07:21,070
.أنا ناروتو

116
00:07:21,180 --> 00:07:24,500
هل يعرف ماسومي ناروتو-كُن؟

117
00:07:24,500 --> 00:07:26,210
!لا، لا، لا، مستحيل

118
00:07:26,210 --> 00:07:31,470
لا بدّ أنّ هناك الكثير من الرّجال الّذين يرتدون
!نظّارات ويسافرون في رحلات عمل من هنا

119
00:07:33,730 --> 00:07:35,500
.أو ربّما لا

120
00:07:37,610 --> 00:07:39,840
هل هو قلق عليّ؟

121
00:07:50,120 --> 00:07:52,070
...باغ

122
00:07:52,070 --> 00:07:55,530
"بعد الاستحمام"

123
00:07:52,460 --> 00:07:55,020
!باغ

124
00:08:00,750 --> 00:08:04,820
حاولت ألاّ أفكر في الأمر
،كي لا أفرط في القلق

125
00:08:05,210 --> 00:08:10,170
!لكن ها قد حلّ الغد، يوم العرض الأوّل

126
00:08:10,390 --> 00:08:13,840
ماذا لو أرسلوا التّذاكر بالبريد؟

127
00:08:14,150 --> 00:08:17,640
كيف سأتمكّن من تفسير الأمر حينها؟

128
00:08:17,640 --> 00:08:21,300
!يجب ألاّ تقع عينا ماسومي عليها بأيّ ثمن

129
00:08:18,190 --> 00:08:20,350
"دعوة"

130
00:08:20,650 --> 00:08:22,250
"تذكرتان للبالغين"

131
00:08:22,250 --> 00:08:24,380
.حمدًا على هذا، تذاكر إلكترونيّة

132
00:08:33,620 --> 00:08:36,440
...قد يسبّب لي التّوتر أرقًا

133
00:08:42,090 --> 00:08:43,830
!لقد أتى اليوم المنتظر

134
00:08:44,140 --> 00:08:47,110
!ها أنا ذا في مدينة ألعاب كيتدلاند

135
00:08:48,640 --> 00:08:51,050
.فزتُ بتذكرة لشخصين

136
00:08:51,050 --> 00:08:53,870
.لذا لم آت وحدي

137
00:08:55,650 --> 00:08:57,540
.الطّقس جميل! هذا رائع

138
00:08:57,940 --> 00:08:59,670
.أحضرت ابن أختي معي

139
00:09:00,010 --> 00:09:02,170
!أمّي، أسرعي –
...حسنًا –

140
00:09:05,490 --> 00:09:06,760
.شخصان

141
00:09:09,240 --> 00:09:13,560
هل كانت التّذاكر الّتي أعطاك
إيّاها زميلك إلكترونيّة؟

142
00:09:15,420 --> 00:09:17,160
هذا عمليّ، أليس كذلك؟

143
00:09:18,090 --> 00:09:20,790
تردّدت كثيرًا بشأن الشّخص
،الّذي سأصطحبه

144
00:09:20,790 --> 00:09:23,690
.خصوصًا أنّ خياري الأوّل اعتذر عن الدّعوة

145
00:09:24,550 --> 00:09:26,250
!يبدو هذا رائعًا

146
00:09:26,250 --> 00:09:29,860
لكن لديّ موعد لتسليم عمل مهمّ
...في الشّركة في اليوم التّالي

147
00:09:31,770 --> 00:09:34,010
،فكّرت في الذّهاب وحدي

148
00:09:34,010 --> 00:09:36,220
.لكنّني فزت بهاتين التّذكرتين

149
00:09:36,220 --> 00:09:38,580
!ولم أرد إهدار إحداهما

150
00:09:38,940 --> 00:09:42,380
.وهكذا استغللت لطف ماسومي مرّة أخرى

151
00:09:43,930 --> 00:09:50,090
"خفقان"

152
00:09:44,240 --> 00:09:48,400
...حصلتُ على تذاكر إلى كيتدلاند

153
00:09:48,400 --> 00:09:50,640
هل تودّ مرافقتي؟ –
!حسنًا –

154
00:09:50,120 --> 00:09:51,650
"مباشر"

155
00:09:50,660 --> 00:09:51,650
!يا للرّوعة

156
00:09:51,870 --> 00:09:53,990
،كنت أخشى ردّة فعله

157
00:09:53,990 --> 00:09:56,220
.لكنّه لم يبدُ متفاجئًا

158
00:09:56,870 --> 00:09:59,310
.على أيّ حال، دخلنا دون أيّ مشكلة

159
00:10:00,420 --> 00:10:02,770
...يا له من شعور مذهل! أخيرًا

160
00:10:03,420 --> 00:10:06,000
.أصبحت في عالم باغتارو

161
00:10:08,260 --> 00:10:11,200
!مهلاً يا عمّي! انظر
!ثمّة دمى جالة للحظّ

162
00:10:13,890 --> 00:10:16,200
!يا لها من ظرافة

163
00:10:18,690 --> 00:10:20,040
أين باغتارو؟

164
00:10:21,690 --> 00:10:23,210
.لا أثر له هنا

165
00:10:23,600 --> 00:10:25,020
.كان هذا متوقّعًا

166
00:10:25,020 --> 00:10:28,510
لم أتوقّع أن أصادف باغتارو
.منذ اللّحظة الأولى

167
00:10:28,660 --> 00:10:31,380
،عمّي، ما دمنا هنا
ما رأيك أن نلتقط صورة؟

168
00:10:33,330 --> 00:10:34,930
!هيّا بنا

169
00:10:35,500 --> 00:10:38,820
!لنلتقط بعض الصّور

170
00:10:38,820 --> 00:10:41,580
!هيّا

171
00:10:41,580 --> 00:10:45,290
.لا، انتظر، انتظر
هل يحقّ لي فعل هذا حقًّا

172
00:10:45,290 --> 00:10:47,780
كأنّي طالب جامعيّ طائش؟

173
00:10:48,630 --> 00:10:51,250
ماذا؟ هل أخذت كلامي على محمل الجدّ؟

174
00:10:51,250 --> 00:10:52,710
.كنت أمزح فحسب، يا للإحراج

175
00:10:52,710 --> 00:10:54,530
ألن ينتهي الأمر عند هذا الحدّ؟

176
00:10:56,180 --> 00:10:59,220
!أريد صورة! هيّا

177
00:10:59,220 --> 00:11:00,660
.لا أريد

178
00:11:00,860 --> 00:11:02,140
أمتأكّد؟

179
00:11:02,140 --> 00:11:06,210
هل يختبرني ماسومي الآن؟

180
00:11:06,320 --> 00:11:08,390
حسنًا... صورة واحدة لن تضرّ، أليس كذلك؟

181
00:11:08,740 --> 00:11:09,850
...في الواقع، أنا

182
00:11:10,160 --> 00:11:12,320
.هناك الكثير من العائلات

183
00:11:12,320 --> 00:11:13,520
...نعم

184
00:11:13,520 --> 00:11:16,320
!أضعتُ فرصتي لالتقاط صورة

185
00:11:18,540 --> 00:11:21,240
،على أيّ حال، أينما نظرت، إلى اليمين

186
00:11:21,240 --> 00:11:22,890
...أو اليسار

187
00:11:23,570 --> 00:11:25,200
...أو أمامي

188
00:11:25,200 --> 00:11:27,580
!لا أرى سوى أشياء ظريفة

189
00:11:29,180 --> 00:11:30,420
،لو كنت أعيش بالقرب من هنا

190
00:11:30,420 --> 00:11:33,110
!لاشتريت اشتراكًا سنويًّا

191
00:11:36,750 --> 00:11:40,220
مهلاً، هناك المزيد من دمى
!كيتدلاند الجالبة للحظّ

192
00:11:40,220 --> 00:11:43,220
!كلّها لطيفة للغاية

193
00:11:45,860 --> 00:11:50,730
.هناك الكثير من الأطفال
.سأجد جنّتي أينما نظرت

194
00:11:51,570 --> 00:11:55,730
مع هذا العدد الهائل من الأطفال
،والأشياء الظّريفة

195
00:11:55,730 --> 00:11:58,680
.لما صمدتُ طويلاً لو أتيت وحدي

196
00:12:07,510 --> 00:12:08,900
!عمّي! عمّي

197
00:12:09,950 --> 00:12:14,450
"نظارات دمى"

198
00:12:10,340 --> 00:12:12,380
عمّي، هل نشتريها؟

199
00:12:12,380 --> 00:12:14,610
!ماسومي

200
00:12:14,890 --> 00:12:16,090
.انظر إلى هذه أيضًا

201
00:12:16,090 --> 00:12:19,330
ماذا عليّ أن أفعل؟

202
00:12:19,630 --> 00:12:21,550
هل نشتريها؟

203
00:12:21,550 --> 00:12:23,550
!بالطّبع أريد ذلك

204
00:12:23,550 --> 00:12:26,100
،أعلم أنّها لن تفيدني في حياتي اليوميّة

205
00:12:26,100 --> 00:12:27,640
!لكنّني أريدها

206
00:12:27,940 --> 00:12:31,810
كيف يُفترض بي أن أجيب بصفتي عمًّا؟

207
00:12:31,810 --> 00:12:32,920
يا عمّي؟

208
00:12:37,540 --> 00:12:38,640
!ولِمَ لا

209
00:12:39,790 --> 00:12:41,060
ما رأيك؟

210
00:12:41,750 --> 00:12:43,240
!حسنًا، لنجرّبها

211
00:12:43,240 --> 00:12:44,740
!هيّا

212
00:12:45,710 --> 00:12:47,270
ما رأيك؟

213
00:12:47,420 --> 00:12:48,990
.سآخذ هذه

214
00:12:48,990 --> 00:12:51,700
!نظّارات باغتارو بالطّبع

215
00:12:51,700 --> 00:12:53,710
!شكرًا جزيلاً لكم

216
00:12:53,710 --> 00:12:55,380
.هذا محرج قليلاً

217
00:12:55,380 --> 00:12:58,960
وأخيرًا أستطيع التّجوّل
!وأنا أتباهى بباغتارو بكلّ فخر

218
00:12:58,960 --> 00:13:00,840
!ظننتُ أنّ هذا لن يحدث أبدًا

219
00:13:00,840 --> 00:13:01,800
!باغ

220
00:13:03,230 --> 00:13:04,250
ماذا نفعل الآن؟

221
00:13:04,560 --> 00:13:06,910
هناك الكثير من الألعاب
ما رأيك أن نجرّب بعضها؟

222
00:13:08,650 --> 00:13:10,840
...ليس الأمر أنّني لا أريد

223
00:13:11,150 --> 00:13:13,630
ألا تحب ألعاب الملاهي؟

224
00:13:13,950 --> 00:13:16,100
.لا، ليس تمامًا

225
00:13:16,100 --> 00:13:18,590
.في الحقيقة، لم أنم جيّدًا

226
00:13:16,100 --> 00:13:21,260
"خفقان"

227
00:13:18,620 --> 00:13:21,490
!غدًا! كيتدلاند

228
00:13:21,490 --> 00:13:24,070
!سأرى باغتارو

229
00:13:24,070 --> 00:13:26,120
كدت أقضي اللّيل مستيقظًا

230
00:13:26,120 --> 00:13:28,330
...وما زال قلبي يخفق بسرعة

231
00:13:28,330 --> 00:13:31,900
.بل إنّني أفضّل تجنّب حتّى ألعاب الأطفال

232
00:13:32,260 --> 00:13:34,500
.فلنذهب لرؤية شيء آخر إذًا

233
00:13:35,510 --> 00:13:39,320
هل تريد أن تأكل شيئًا؟
هل أنت جائع؟

234
00:13:42,500 --> 00:13:45,800
.صحيح أنّي قلت ذلك، لكنّ التّوتّر أفقدني شهيّتي

235
00:13:45,800 --> 00:13:48,970
!لكن الغلاف ظريف للغاية

236
00:13:50,110 --> 00:13:52,680
.حسنًا، لقد اقترب الموعد

237
00:13:53,940 --> 00:13:55,050
.هيّا بنا

238
00:13:55,490 --> 00:13:59,260
.العرض السّنويّ في مدينة ألعاب كيتدلاند

239
00:14:00,150 --> 00:14:01,190
!لقد بدأ

240
00:14:01,190 --> 00:14:05,610
لطالما حلمت بأن أتمكّن
.من مشاهدته يومًا ما

241
00:14:05,610 --> 00:14:09,070
!وها قد حان ذلك اليوم أخيرًا

242
00:14:11,300 --> 00:14:14,610
.يبدو أنّ عمّي ليس على ما يرام اليوم

243
00:14:16,680 --> 00:14:19,500
.هذا هو المكان الّذي سيُقام فيه العرض

244
00:14:19,850 --> 00:14:21,740
.قالت السّيّدة شيئًا

245
00:14:22,850 --> 00:14:24,300
سيُصوَّر هذا العرض

246
00:14:24,300 --> 00:14:27,550
!ثمّ سيُنشر على مواقع التّواصل

247
00:14:27,900 --> 00:14:29,010
على مواقع التّواصل؟

248
00:14:29,010 --> 00:14:30,470
!لم أكن أعلم

249
00:14:30,470 --> 00:14:33,420
!لا! كان ذلك مكتوبًا في الدّعوة

250
00:14:31,730 --> 00:14:35,430
سيُصوَّر هذا العرض"
"ويُنشر على مواقع التّواصل

251
00:14:33,440 --> 00:14:35,430
!أنا من لم يقرأها كلّها

252
00:14:35,430 --> 00:14:37,940
!يجب أن أختبئ، وإلاّ انتهى أمري

253
00:14:37,940 --> 00:14:39,610
كيف أختبئ؟

254
00:14:39,610 --> 00:14:41,270
!بسرعة! أيّ شيء

255
00:14:43,320 --> 00:14:44,440
عمّي؟

256
00:14:44,440 --> 00:14:48,610
،حسنًا، بما أنّنا هنا
.أردت أن ألهو بما اشتريناه

257
00:14:48,610 --> 00:14:52,520
حسنًا... لكن هل تستطيع الرّؤية بهذا الشّكل؟

258
00:14:52,920 --> 00:14:54,730
.ليس تمامًا –
.توقّعت ذلك –

259
00:15:00,830 --> 00:15:04,380
!يبدو أنّ عمّي يحبّ اللّهو هو الآخر

260
00:15:04,380 --> 00:15:05,870
!سأفعل مثله

261
00:15:07,560 --> 00:15:09,340
.اهدأ، رويدك

262
00:15:09,340 --> 00:15:12,260
تصرفتُ بغرابة أمام ماسومي
.بسبب كلّ هذا

263
00:15:12,260 --> 00:15:15,640
،وفوق ذلك
!شاركتُ في السّحب بكل شجاعة

264
00:15:15,640 --> 00:15:17,490
،حتّى لو كانوا يصوّرون

265
00:15:17,490 --> 00:15:19,480
.فلن ينشروا التّسجيل كاملاً

266
00:15:19,480 --> 00:15:22,270
!احتمال ظهوري فيه ضئيل للغاية

267
00:15:22,270 --> 00:15:24,150
دعنا لا نفكّر في ذلك

268
00:15:24,150 --> 00:15:26,650
!ولنستمتع باللّحظة

269
00:15:26,650 --> 00:15:28,490
،أحاول إقناع نفسي بذلك

270
00:15:28,490 --> 00:15:32,430
لكنّ فكرة ظهور وجهي
!على مواقع التّواصل توتّرني بشدّة

271
00:15:37,590 --> 00:15:38,570
هل حان الوقت؟

272
00:15:42,050 --> 00:15:44,490
!لقد بدأ

273
00:15:46,020 --> 00:15:48,080
يا إلهي! من التّالي؟

274
00:15:52,150 --> 00:15:56,040
!باغتارو

275
00:15:58,030 --> 00:16:00,060
!هـ-هـ-هذا مذهل

276
00:16:00,360 --> 00:16:02,810
باغتارو الّذي طالما رأيته
،ساكنًا بلا حراك

277
00:16:02,810 --> 00:16:06,110
!يقف أمامي الآن ويتحرّك
!يا له من أمر مذهل

278
00:16:06,110 --> 00:16:08,800
...تنفّس... خذ نفسًا عميقًا

279
00:16:13,790 --> 00:16:15,240
عمّي، هل أنت بخير؟

280
00:16:15,240 --> 00:16:16,580
هل أنت مريض؟

281
00:16:16,580 --> 00:16:19,540
!لا، لا تقلق! استمتع بالعرض

282
00:16:19,540 --> 00:16:22,580
!يجب أن أتوقّف بسرعة عن فرط التّنفّس

283
00:16:22,580 --> 00:16:26,530
!تماسك! ولا تهتمّ بمواقع التّواصل

284
00:16:27,180 --> 00:16:29,340
!مرحبًا بالجميع

285
00:16:29,340 --> 00:16:32,720
كيف حالكم؟

286
00:16:32,720 --> 00:16:37,930
!أنا بخير

287
00:16:33,900 --> 00:16:35,710
"(صوت القلب)"

288
00:16:38,780 --> 00:16:43,300
!نحن هنا لنقدّم لكم عرضًا رائعًا

289
00:16:44,070 --> 00:16:45,480
!أنا متحمّسة

290
00:16:45,480 --> 00:16:47,610
!إنّهم يتكلّمون

291
00:16:48,040 --> 00:16:50,260
..كما ترون

292
00:16:51,290 --> 00:16:54,700
!لقد ارتدينا أبهى حللنا

293
00:16:54,700 --> 00:16:56,450
!باغ

294
00:16:56,450 --> 00:16:59,370
!يا لها من ظرافة

295
00:17:12,130 --> 00:17:13,760
!باغ

296
00:17:15,310 --> 00:17:18,080
!إنّهم يغنّون أيضًا

297
00:17:19,360 --> 00:17:21,850
معًا، برفقتك

298
00:17:21,850 --> 00:17:25,230
الفرح يعمّ المكان
ونمرح معًا بكلّ جنون

299
00:17:25,230 --> 00:17:28,270
!أحضان الكلاب! سنقضي وقتًا ممتعًا

300
00:17:29,650 --> 00:17:31,480
...ثلاثة، اثنان، واحد، و

301
00:17:34,450 --> 00:17:36,990
نرقص، ونرقص أيّها الجرو الصّغير
هيا نرقص معًا

302
00:17:36,990 --> 00:17:38,910
إنّهم يرقصون أيضًا؟

303
00:17:40,490 --> 00:17:42,200
جرو ظريف، ظريف

304
00:17:42,200 --> 00:17:45,440
ما رأيك يا باغتارو؟ –
!باغ –

305
00:17:47,420 --> 00:17:50,160
!آن ترقص بحماسة شديدة أيضًا

306
00:17:52,180 --> 00:17:55,130
!مرحٌ ما بعده مرح
ما الّذي يحدث لي؟

307
00:17:55,130 --> 00:17:57,720
هذه المدينة وهذا العرض
.مخصّصان للأطفال

308
00:17:57,720 --> 00:18:01,810
،لكنّ تصميم الرّقصات رائع
!وأشعر أنّني داخل عالم كيتدلاند

309
00:18:01,810 --> 00:18:04,810
!باغتارو موجود حقًّا

310
00:18:04,810 --> 00:18:07,400
!هذا هو الشّعور الّذي ينتابني
...وحتّى أنا

311
00:18:07,400 --> 00:18:10,260
!لا أعرف كيف أعبّر عمّا أشعر به

312
00:18:10,660 --> 00:18:12,890
لو كنت أعلم أنّني سأعيش
...هذه اللّحظة يومًا

313
00:18:14,250 --> 00:18:16,970
!أكاد أبكي من شدّة التّأثّر

314
00:18:20,590 --> 00:18:21,810
الأطفال؟

315
00:18:22,500 --> 00:18:23,790
هل فاتني شيء؟

316
00:18:29,420 --> 00:18:31,840
!إنّهم يمرّون لتحيّة الجمهور

317
00:18:32,350 --> 00:18:34,210
!يا له من إخراج مذهل

318
00:18:34,210 --> 00:18:36,300
،كان مكاني على الجانب جيّدًا

319
00:18:36,300 --> 00:18:38,450
!لكنّني أحسد الجالسين في الأمام

320
00:18:39,520 --> 00:18:42,880
أين باغتارو؟
...لقد اختفى من المسرح أيضًا

321
00:18:42,400 --> 00:18:43,710
"تربيت"

322
00:18:46,650 --> 00:18:47,710
!باغ

323
00:19:15,180 --> 00:19:16,910
!كان العرض رائعًا

324
00:19:19,140 --> 00:19:20,660
ماذا نفعل بعد ذلك؟

325
00:19:21,810 --> 00:19:23,370
...أ... أ

326
00:19:24,020 --> 00:19:25,850
مهلاً، هل انتهى العرض؟

327
00:19:25,850 --> 00:19:27,500
هل كنت أحلم؟

328
00:19:27,900 --> 00:19:31,130
.لا، قال ماسومي أنّ العرض كان رائعًا

329
00:19:31,820 --> 00:19:33,880
...ذاكرتي مشوّشة

330
00:19:34,660 --> 00:19:36,270
.لم يحدث لي هذا من قبل

331
00:19:36,490 --> 00:19:39,560
...مهما حاولتُ استرجاع التّفاصيل

332
00:19:40,120 --> 00:19:44,190
فكلّ ما أستطيع قوله
!هو أنّني استمتعت إلى أقصى حدّ

333
00:19:44,950 --> 00:19:48,790
،في البداية، حاولتُ كتم فرحتي

334
00:19:48,790 --> 00:19:51,580
،لكن بمجرّد أن اقترب منّي باغتارو
!انتهى الأمر

335
00:19:51,580 --> 00:19:54,170
لا بدّ أنّ ابتسامة عريضة
!ارتسمت على وجهي

336
00:19:54,640 --> 00:19:56,880
.على أيّ حال، فات الأوان الآن

337
00:19:56,880 --> 00:19:59,590
.لا بدّ أنّ ماسومي لاحظ ذلك أيضًا

338
00:19:59,590 --> 00:20:01,340
،حتّى لو رآني أستمتع

339
00:20:01,340 --> 00:20:04,620
،فنحن في مدينة ألعاب
!لذا لن يبدو الأمر غريبًا

340
00:20:05,570 --> 00:20:07,060
!أو ربّما لا

341
00:20:07,060 --> 00:20:09,290
قد يكتشف أنّني كذبت

342
00:20:07,070 --> 00:20:12,230
"قلق"

343
00:20:09,320 --> 00:20:12,230
!حين قلت أنّني حصلت على التّذاكر كهديّة

344
00:20:13,120 --> 00:20:17,010
عمّي، لنذهب لشراء بعض الهدايا
التّذكاريّة، لكن دون نتأخّر، موافق؟

345
00:20:19,000 --> 00:20:20,490
...نعم، بالطّبع

346
00:20:20,490 --> 00:20:23,240
،حتّى لو قال أنّه استمتع بالعرض

347
00:20:23,240 --> 00:20:27,650
فهذا ليس المكان الأنسب، لرجل
.وابن أخته ذي العشرين عامًا

348
00:20:28,260 --> 00:20:30,290
.يبدو أنّ عمّي متعب للغاية

349
00:20:30,290 --> 00:20:32,320
.من الأفضل أن يعود إلى المنزل ليستريح

350
00:20:32,660 --> 00:20:36,450
ربّما لم يكن عليّ أن أفرض
.عليه هذه النّزهة

351
00:20:36,970 --> 00:20:39,130
هل تريد شراء هدايا تذكاريّة لأصدقائك؟

352
00:20:39,130 --> 00:20:42,130
.ماذا؟ مهلاً... معك حقّ

353
00:20:42,130 --> 00:20:43,290
.سألقي نظرة

354
00:20:45,090 --> 00:20:47,550
...باغو-غو-غو

355
00:20:45,090 --> 00:20:47,550
"بعدها بقليل"

356
00:20:50,520 --> 00:20:54,100
.نعم، كان يومًا جميلاً

357
00:20:54,100 --> 00:20:56,820
،لم ألتقط أيّ صور، وفي النّهاية

358
00:20:56,820 --> 00:21:00,100
لم تسر الأمور مع باغتارو
.كما تخيّلتها تمامًا

359
00:21:00,480 --> 00:21:02,570
لكنّني تمكّنت من شراء

360
00:21:02,570 --> 00:21:06,950
،هدايا تذكاريّة لباغتارو لي ولكينتا
!إلى جانب النّظّارات

361
00:21:08,300 --> 00:21:11,480
.آمل أن يكون عمّي بخير

362
00:21:12,420 --> 00:21:14,070
ما رأيك أن نتوقّف لتناول الطّعام؟

363
00:21:14,130 --> 00:21:15,440
.حسنًا

364
00:21:21,060 --> 00:21:23,120
.عمّي، انظر

365
00:21:23,890 --> 00:21:24,950
ماذا؟

366
00:21:25,350 --> 00:21:26,330
.انظر

367
00:21:27,360 --> 00:21:28,620
.صورة اليوم

368
00:21:29,100 --> 00:21:31,480
!التقط ماسومي صورة

369
00:21:31,480 --> 00:21:35,060
!عجبًا، كان ينبغي أن ألتقط صورة أيضًا

370
00:21:35,060 --> 00:21:36,210
.لديّ صور أخرى

371
00:21:36,570 --> 00:21:37,600
ماذا؟

372
00:21:38,280 --> 00:21:39,260
.انظر

373
00:21:40,200 --> 00:21:41,300
.لديّ هذه

374
00:21:42,410 --> 00:21:43,720
!وهذه أيضًا –
ماذا؟ –

375
00:21:47,920 --> 00:21:51,080
...أثناء العرض غير المنشور

376
00:21:51,080 --> 00:21:52,750
ألم يكن التّصوير ممنوعًا؟

377
00:21:52,750 --> 00:21:56,330
لا؟ قالوا أنّه يمكننا التقاط
.الصّور في النّهاية

378
00:21:56,330 --> 00:21:57,750
حقًّا؟

379
00:21:57,750 --> 00:21:59,130
!أريدها بشدّة

380
00:21:59,130 --> 00:22:00,490
.سأرسلها إليك

381
00:22:04,640 --> 00:22:06,970
،شكرًا يا إلهي، شكرًا يا بوذا

382
00:22:06,970 --> 00:22:10,330
!شكرًا لك يا ماسومي

383
00:22:13,530 --> 00:22:16,190
!اليوم، سنأكل وليمة فاخرة

384
00:22:16,190 --> 00:22:17,560
!كُل ما تشتهيه

385
00:22:17,560 --> 00:22:19,770
ماذا؟ ألستَ مريضًا يا عمّي؟

386
00:22:19,770 --> 00:22:22,650
!مريض؟ لا، إطلاقًا

387
00:22:22,650 --> 00:22:25,940
!وبالمناسبة، لقد بلغتَ سنّ الرّشد
أتريد بعض السّاكي؟

388
00:22:25,940 --> 00:22:26,940
!باغ

389
00:22:31,840 --> 00:22:32,830
...يا له من مذاق شهيّ

390
00:22:32,830 --> 00:22:34,520
!إنّه لذيذ جدًّا

391
00:22:34,920 --> 00:22:37,860
!كان هذا اليوم استثنائيًّا حقًّا

392
00:22:38,500 --> 00:22:41,460
"في اليوم التّالي"

393
00:22:38,720 --> 00:22:40,900
!باغ

394
00:22:44,270 --> 00:22:47,830
.لقد بالغتُ قليلاً، فأصبت بالمرض

395
00:22:48,600 --> 00:22:51,180
!كان مريضًا فعلاً

396
00:22:51,180 --> 00:22:55,420
!آسف! أنا آسف

397
00:23:12,790 --> 00:23:16,060
!يا له منّ حمام دافئ رائع

398
00:23:16,670 --> 00:23:18,900
من أنتما؟

399
00:23:34,020 --> 00:23:36,040
.إذًا هكذا تبدوان عندما تبتلاّن