1
00:00:01,270 --> 00:00:05,780
...عادةً ما تبدأ مغامرة إيسيكاي هكذا

2
00:00:06,030 --> 00:00:07,700
.أو هكذا

3
00:00:08,050 --> 00:00:11,890
،تهب إلهة طيّبة البشريّ قوّةً بطوليّة

4
00:00:12,100 --> 00:00:14,530
،ومحاطًا بحبّ أهل العالم الآخر

5
00:00:14,790 --> 00:00:18,020
.يستمتع البطل بمغامرات مع البطلات الظّريفات

6
00:00:18,680 --> 00:00:21,480
.كنت أفكّر هكذا أيضًا

7
00:00:22,220 --> 00:00:24,710
.لكن هؤلاء هنّ بطلاتي

8
00:00:25,780 --> 00:00:28,610
.وهذه هي مغامراتي

9
00:00:29,280 --> 00:00:32,140
.فضلًا عن كلّ ذلك، أعاني من أقدار كهذه

10
00:00:32,930 --> 00:00:36,730
...ما تعلّمته مذ أتيت إلى عالم آخر هو

11
00:00:37,420 --> 00:00:41,510
.أنّي تعيس الحظّ تمامًا حينما يتعلّق الأمر بإيسيكاي

12
00:00:42,200 --> 00:00:45,190
.أنا ميسومي ماكوتو، وحياتي عبارة عن نكتة

13
00:02:17,910 --> 00:02:20,340
.كان يومًا عاديًّا

14
00:02:20,530 --> 00:02:22,780
.في الصّباح، أتناول وجبة الفطور مع عائلتي

15
00:02:22,780 --> 00:02:25,160
.بعد المدرسة، تدرّبتُ على الرّماية

16
00:02:25,470 --> 00:02:27,270
.عدتُ إلى البيت وتناولت العشاء

17
00:02:27,270 --> 00:02:29,640
.بعد الاستحمام، تصفّحتُ الإنترنت وقرأت بعض الأشياء

18
00:02:30,200 --> 00:02:32,940
.مهلًا، صدر كتاب أبي الجديد

19
00:02:34,380 --> 00:02:37,790
.كان يومًا عاديًّا ومسالمًا

20
00:02:38,770 --> 00:02:42,700
.لذا ينبغي أن أكون نائمًا في بيتي

21
00:02:43,400 --> 00:02:45,390
أين أنا؟

22
00:02:45,920 --> 00:02:48,160
.تبدو هادئًا للغاية

23
00:02:48,160 --> 00:02:48,930
من هناك؟

24
00:02:49,250 --> 00:02:51,870
هل ستصّدقني إن قلتُ لك أنّني إله؟

25
00:02:51,870 --> 00:02:52,930
.قطعًا لا

26
00:02:53,460 --> 00:02:56,340
.إنّك على وشك دخول عالم آخر

27
00:02:56,340 --> 00:02:58,440
.يرجى أن تقدّم توقيعك للإشارة إلى موافقتك

28
00:02:58,710 --> 00:03:02,230
.لا يمكنني أن أُنقَل فجأةً إلى إيسيكاي

29
00:03:02,230 --> 00:03:05,930
.هذا غريب. تمّ إخباري أنّهم أخبروك بالأمر سلفًا

30
00:03:05,930 --> 00:03:07,620
.اعذرني

31
00:03:08,810 --> 00:03:12,560
.أنا حاكم عالم اللّيل، تسوكويومي

32
00:03:12,560 --> 00:03:17,240
.لقد أتيت لجعلك بطلًا، ولتسليمك إلى إلهة من عالم آخر

33
00:03:17,240 --> 00:03:20,260
تسوكويومي؟ كما في تسوكويومي نو ميكوتو؟

34
00:03:20,260 --> 00:03:23,900
كما أحد الأبناء الثّلاثة النّبلاء من الأساطير اليابانيّة؟

35
00:03:23,900 --> 00:03:26,490
.عجبًا، أنت واسع الاطّلاع

36
00:03:26,810 --> 00:03:29,140
ما الّذي يفعله تسوكويومي هنا؟

37
00:03:29,380 --> 00:03:32,040
.لا تدري أيّ شيء حقًّا

38
00:03:32,410 --> 00:03:36,900
.أوّلًا، والداك من عالم آخر

39
00:03:38,190 --> 00:03:40,190
!ماذا؟

40
00:03:40,190 --> 00:03:44,160
.على ذكر الأمر، لم أقابل أيًّا من أقاربي قطّ

41
00:03:44,160 --> 00:03:45,700
لكن إيسيكاي؟

42
00:03:46,080 --> 00:03:47,880
،بسبب ظروف معيّنة

43
00:03:47,880 --> 00:03:52,050
.وقّع والداك عقدًا مع إلهة من عالم آخر وأتيا إلى اليابان

44
00:03:52,480 --> 00:03:57,520
.وافقا أن يمنحاها يومًا ما أعزّ ما يملكان

45
00:03:58,040 --> 00:04:03,380
تقصد أنّني إلّم أذهب، سيتمّ أخذ إحدى أخواتي، يوكيكو أو ماري؟

46
00:04:03,380 --> 00:04:04,540
.فعلًا

47
00:04:05,280 --> 00:04:09,250
...حسنًا، سأذهب. لكن

48
00:04:09,510 --> 00:04:12,260
.لا تقلق يا ماكوتو-دونو

49
00:04:12,800 --> 00:04:18,070
سأتخلّص من المنتجات العديدة
.الّتي تملكها والّتي تصوّر أحلام الرّجال

50
00:04:18,670 --> 00:04:21,740
!أنت إله حقًّا

51
00:04:24,220 --> 00:04:26,210
.يبدو العقد جيّدًا

52
00:04:26,210 --> 00:04:28,810
أواثق أنّ هذه الرّسالة هي الشّيء
الوحيد الّذي عليّ توصيله إلى عائلتك؟

53
00:04:28,810 --> 00:04:29,460
.أجل

54
00:04:30,360 --> 00:04:31,320
...في تلك الحالة

55
00:04:31,740 --> 00:04:33,110
ما هذا؟

56
00:04:33,110 --> 00:04:35,400
.عليك أن تلقي العالم الّذي عشت فيه حتّى الآن

57
00:04:35,900 --> 00:04:38,640
.سأهبك كلّ القوّة الّتي أستطيع منحها

58
00:04:38,640 --> 00:04:41,740
!شكرًا... لك؟

59
00:04:42,850 --> 00:04:46,420
أيّتها الإلهة، هل تنوين أخذه دون أن تلقي التّحيّة حتّى؟

60
00:04:47,120 --> 00:04:51,420
ماكوتو-دونو، الإلهة الّتي على وشك أن
.تلتقي بها تعاني من كثير من المشاكل

61
00:04:51,660 --> 00:04:54,690
.لكن حاول أن تكون صبورًا معها قدر الإمكان

62
00:04:55,630 --> 00:04:56,700
.سأفعل

63
00:04:56,700 --> 00:05:01,690
.إن كان هذا رأيك فسأقبلها، مهما كانت سخيفة

64
00:05:04,990 --> 00:05:06,190
!ساطع للغاية

65
00:05:06,450 --> 00:05:08,790
هل أتيت فعلًا؟

66
00:05:08,790 --> 00:05:12,610
.لا بدّ أنّ تسوكويومي العجوز قد أصبح ضعيفًا للغاية

67
00:05:12,960 --> 00:05:14,980
الإ-الإلهة؟

68
00:05:14,980 --> 00:05:20,130
.بدأت شياطين وأرواح هذا العالم بفعل ما يحلو لهم

69
00:05:20,130 --> 00:05:22,970
.بشري في مشكلة كبيرة

70
00:05:23,250 --> 00:05:25,900
...ارتأيت أن أستدعيك للمساعدة

71
00:05:28,730 --> 00:05:31,650
هل أنت ابنهما حقًّا؟

72
00:05:31,650 --> 00:05:33,790
.لكنّك قبيح جدًّا

73
00:05:34,260 --> 00:05:36,220
.لا توجد فيك ذرّة من الجمال

74
00:05:36,220 --> 00:05:38,440
ابن أيّ قبيح أنت؟

75
00:05:38,780 --> 00:05:40,900
.على أيّ حال، أظنّني سأستخدم قاعدة التّهدئة

76
00:05:40,900 --> 00:05:42,960
هلّا غربت عن وجهي رجاءً؟

77
00:05:42,960 --> 00:05:44,740
.وجودك يقرفني ويغضبني

78
00:05:45,000 --> 00:05:47,350
!أ-أنت من استدعاني

79
00:05:47,520 --> 00:05:50,890
!أيّها المتوحّش! حتّى صوتك قبيح

80
00:05:50,890 --> 00:05:54,760
.وجدت الأبطال المناسبين من أجل عالمي

81
00:05:54,760 --> 00:05:58,330
.لك أن تقف على هامش عالمي أيّها القذر

82
00:05:58,520 --> 00:05:59,440
ماذا؟

83
00:05:59,440 --> 00:06:02,910
،أكره وهبك أيّ قوّة

84
00:06:03,220 --> 00:06:06,390
،لكنّي سأتنازل وأمنحك القدرة على الفهم

85
00:06:06,390 --> 00:06:09,650
.والكلام والقراءة وكتابة لغات عدا لغات البشر

86
00:06:09,650 --> 00:06:11,390
.يا للإزعاج

87
00:06:13,490 --> 00:06:17,630
.استمتع بحياة رديئة مع الأورك والعفاريت الوضيعة

88
00:06:17,630 --> 00:06:22,110
.ولا تنشر بذرتك البشعة بين بشري مهما كان

89
00:06:22,720 --> 00:06:23,820
.انصرف الآن

90
00:06:24,890 --> 00:06:27,120
.أتساءل إن كان السّقوط سيقتله

91
00:06:27,400 --> 00:06:30,110
.لن أتحمّل عودته

92
00:06:30,110 --> 00:06:33,240
!لا بدّ أنّ هذه مزحة

93
00:06:33,240 --> 00:06:35,450
!لا يمكنك معاملتي كآفّة

94
00:06:35,450 --> 00:06:37,260
!سحقًا

95
00:06:38,400 --> 00:06:39,340
.ماكوتو-دونو

96
00:06:39,340 --> 00:06:41,120
!تسوكويومي-ساما

97
00:06:42,200 --> 00:06:45,260
.لم أتوقّع أنّ الإلهة ستلجأ لمثل هذا العنف

98
00:06:45,260 --> 00:06:48,580
.حسنًا، ينبغي أن تكون بخير لسقوطك من هذا الارتفاع

99
00:06:48,580 --> 00:06:49,140
ماذا؟

100
00:06:49,660 --> 00:06:55,170
.كان العالم الّذي كنت تعيش فيه قاسيًا وقاحلًا ولا نستطيع حمايته

101
00:06:55,170 --> 00:06:59,350
.كانت قواك السّحريّة وجسدك الماديّ تحت ضغط كبير

102
00:07:00,070 --> 00:07:04,020
بعد تحرّرك من هذا العبء، ينبغي
.أن تكون قويًّا للغاية في هذا العالم

103
00:07:04,020 --> 00:07:06,110
.كم هذا مريح

104
00:07:06,640 --> 00:07:09,860
.لكن ما زال يمكنك أن تموت. ها قد حذّرتك

105
00:07:10,740 --> 00:07:11,480
ماذا؟

106
00:07:12,060 --> 00:07:14,210
...تسوكويومي-ساما، جسدك

107
00:07:14,210 --> 00:07:17,120
.لقد استهلك هذا التّواصل قدرًا كبيرًا من قوّتي

108
00:07:17,440 --> 00:07:20,740
.عليّ أن أنام الآن لعدّة قرون

109
00:07:21,020 --> 00:07:22,470
...غير معقول

110
00:07:22,470 --> 00:07:27,450
.الإلهة نفسها جرّدتك من دورك كبطل

111
00:07:27,450 --> 00:07:29,010
.لا داعي لتكبح نفسك

112
00:07:29,450 --> 00:07:34,330
،ميسومي ماكوتو، باسم تسوكويومي

113
00:07:35,010 --> 00:07:37,680
.أمنحك الحرّيّة في عالمك الجديد

114
00:07:38,350 --> 00:07:42,130
.أتمنّى أن نلتقي ثانيةً في دورة الحياة والموت

115
00:07:45,300 --> 00:07:46,680
...تسوكويومي-ساما

116
00:07:51,400 --> 00:07:52,390
.مفهوم

117
00:08:00,660 --> 00:08:05,070
مضت ثلاثة أيّام بالفعل مذ وقعتُ في هذه الأرض

118
00:08:05,070 --> 00:08:08,180
.وبدأت السّير صوب ذلك الجبل الشّاهق

119
00:08:09,090 --> 00:08:12,280
.لم أجد أيّ ناس أو حيوانات أو طعام

120
00:08:12,880 --> 00:08:17,680
أما زلت قادرًا بالكاد على الحراك بعد
ثلاثة أيّام بلا طعام أو شراب لأنّني إنسان خارق؟

121
00:08:19,320 --> 00:08:21,280
.الحديث مع نفسي عقيمٌ للغاية

122
00:08:23,690 --> 00:08:28,690
.لثلاثة أيّام، لم أسمع سوى صوتي وخطواتي والرّيح

123
00:08:28,690 --> 00:08:32,700
!عادةً، ينبغي أنّ حدثًا ما وقع قبل وصولي إلى هذه النّقطة

124
00:08:36,190 --> 00:08:37,350
.أنا وحيد جدًّا

125
00:08:39,130 --> 00:08:41,310
.النّجدة

126
00:08:42,700 --> 00:08:44,450
أين؟ من أين أتى ذلك؟

127
00:08:45,630 --> 00:08:47,960
.النّجدة

128
00:08:47,960 --> 00:08:49,720
!من هنا

129
00:08:50,980 --> 00:08:53,420
.النّجدة

130
00:08:53,420 --> 00:08:55,410
!بكلّ سرور

131
00:08:56,210 --> 00:08:56,920
ماذا؟

132
00:08:57,170 --> 00:08:58,780
...كلب برأسين

133
00:08:59,050 --> 00:09:01,100
وخنزير يرتدي ملابس؟

134
00:09:01,730 --> 00:09:05,110
!لا يهمّ! هذا أفضل من الوحدة

135
00:09:05,110 --> 00:09:07,760
من أنت؟

136
00:09:08,580 --> 00:09:11,270
!مرحبًا! أنا ماكوتو الإنسان

137
00:09:11,530 --> 00:09:13,400
!ماذا؟ إنّه سريع للغاية

138
00:09:13,400 --> 00:09:15,960
!سعيد للقائك

139
00:09:27,330 --> 00:09:28,830
...مقرف

140
00:09:30,810 --> 00:09:32,990
.لـ-لقد تماديت

141
00:09:36,430 --> 00:09:38,080
...عذرًا

142
00:09:38,780 --> 00:09:40,230
.سعيد للقائك

143
00:09:40,230 --> 00:09:43,270
ماذا؟ كيف لإنسان أن يتحدّث إليّ؟

144
00:09:43,490 --> 00:09:45,660
كيف أتحدّث إلى خنزير؟

145
00:09:46,020 --> 00:09:48,020
.عـ-على أيّ حال، لا تقلقي

146
00:09:48,020 --> 00:09:50,080
.أنا شخص طيّب وعطوف

147
00:09:50,600 --> 00:09:52,690
...لستَ عطوفًا بالتّأكيد

148
00:09:53,320 --> 00:09:56,020
لكنّني أنقذتك، صحيح؟

149
00:09:56,020 --> 00:09:58,200
.أي أنّني إلى جانبك

150
00:10:03,240 --> 00:10:04,680
.حـ-حسنًا

151
00:10:04,680 --> 00:10:06,040
!ممتاز

152
00:10:06,630 --> 00:10:09,730
.لقد كنتُ تائهًا لثلاثة أيّام في الواقع

153
00:10:09,730 --> 00:10:12,090
هل تعرفين أيّ طريق أسلك لأجد أشخاصًا آخرين؟

154
00:10:12,990 --> 00:10:16,050
.لا توجد أيّ قرى للإنس في الجوار

155
00:10:16,050 --> 00:10:19,670
.هذا المكان القاحل، المعروف بالقفار، موجود على حافّة العالم

156
00:10:19,670 --> 00:10:23,790
.تلك الإلهة الحقيرة أرسلتني إلى أقاصي أرضها حقًّا

157
00:10:24,370 --> 00:10:28,180
.أ-أنا أروك المرتفعات. اسمي إيما

158
00:10:28,430 --> 00:10:30,630
.أنا ماكوتو

159
00:10:30,630 --> 00:10:33,960
أخبريني، هل قريتك في الجوار؟

160
00:10:34,590 --> 00:10:40,360
لا. كنتُ في طريقي إلى ذلك الجبل الإلهيّ

161
00:10:40,360 --> 00:10:44,420
.لأقدّم نفسي كقربان للشّين

162
00:10:44,420 --> 00:10:46,910
!إنّه حدث

163
00:10:46,910 --> 00:10:50,350
.للأعوام الفائتة، كان الضّباب يحيط بقريتي

164
00:10:52,530 --> 00:10:56,310
.تسبّب تقديم القرابين بانقشاع الضّباب قليلًا

165
00:10:56,310 --> 00:10:57,910
والآن دورك؟

166
00:10:58,370 --> 00:11:02,280
.يوجد في الأمام مكان حيث تستطيع تطهير نفسك

167
00:11:02,280 --> 00:11:04,770
،لشكرك على إنقاذي من الرّيسود

168
00:11:04,770 --> 00:11:07,550
.بإمكانك التخلّص من إرهاق سفرك هناك

169
00:11:07,550 --> 00:11:10,180
.إنّها ذكيّة وطيّبة أيضًا

170
00:11:10,180 --> 00:11:11,850
.أودّ إنقاذها إن كنت أستطيع

171
00:11:12,510 --> 00:11:13,850
ماكوتو-ساما؟

172
00:11:13,850 --> 00:11:17,100
.يا لها من رائحة زهريّة جميلة

173
00:11:17,310 --> 00:11:20,360
...إن أنقذت هذه المرأة الشّابة

174
00:11:20,810 --> 00:11:24,480
.ستصبح بطلتي بالتّأكيد

175
00:11:29,300 --> 00:11:31,340
.وجبتي الأولى في ثلاثة أيّام

176
00:11:31,650 --> 00:11:34,650
.سمعت أنّ البشر عنيفون ومريعون

177
00:11:34,650 --> 00:11:39,340
.ربّما يملك دمًا نصف بشريّ فيه. انظر إليه فحسب

178
00:11:39,340 --> 00:11:41,750
.آسف لأنّني قبيح جدًّا

179
00:11:43,070 --> 00:11:45,320
!محال! الأطباق تطفو

180
00:11:45,320 --> 00:11:48,520
.إنّه سحر النّقل العاديّ فحسب

181
00:11:48,950 --> 00:11:51,270
إيما-سان، أبإمكانك استخدام السّحر؟

182
00:11:51,470 --> 00:11:54,270
ماذا؟ ألا تستطيع أنت يا ماكوتو-ساما؟

183
00:11:54,270 --> 00:11:57,180
.لا. على الإطلاق في الواقع

184
00:11:57,180 --> 00:11:59,740
أيمكنك أن تعلّميني؟

185
00:12:01,600 --> 00:12:04,010
.لنبدأ بالأساسيّات

186
00:12:04,500 --> 00:12:07,550
...أستدعيك أيّها اللّهب وجوهر النّار

187
00:12:07,830 --> 00:12:08,710
.بريد

188
00:12:09,810 --> 00:12:11,630
!مذهل

189
00:12:12,340 --> 00:12:18,120
هذه التّعويذة مثل مفتاح السّحر الّذي
.يمنح المانا خصائصًا أو يغيّر طبيعتها

190
00:12:18,120 --> 00:12:21,500
.يصعب إلقاؤها قليلًا بما أنّها ليست بلغة الأورك

191
00:12:21,500 --> 00:12:23,920
.تبدو بنفس اللّغة بالنّسبة لي

192
00:12:25,740 --> 00:12:29,080
.أستدعيك أيّها اللّهب وجوهر النّار

193
00:12:29,920 --> 00:12:31,080
.بريد

194
00:12:32,000 --> 00:12:33,620
!عجبًا، فعلتها

195
00:12:33,620 --> 00:12:35,180
ماذا الآن؟

196
00:12:35,730 --> 00:12:39,280
.تـ-تخيّل كرةً من النّار وارمها على هدفك

197
00:12:39,630 --> 00:12:42,740
....أتخيّل إذًا؟ أتخيّل

198
00:12:43,080 --> 00:12:45,670
!ثمّ حلّقي

199
00:12:48,120 --> 00:12:49,230
!أجل

200
00:12:49,540 --> 00:12:51,320
أيعني هذا أنّني أتقنت هذه التّعويذة؟

201
00:12:51,660 --> 00:12:54,390
.لا أصدّق أنّك فعلتها بهذه السّهولة

202
00:12:54,710 --> 00:12:58,260
ماكوتو-ساما، ما مستواك الحاليّ؟

203
00:12:58,930 --> 00:13:01,450
أهناك مستويات؟

204
00:13:02,250 --> 00:13:03,470
ما الّذي يجري؟

205
00:13:03,470 --> 00:13:05,140
.إنّها تقيس مستواه

206
00:13:05,140 --> 00:13:06,020
.لنرَ

207
00:13:06,300 --> 00:13:10,280
.أنت بمستوى 200... لا، بل 300 على الأغلب

208
00:13:10,280 --> 00:13:12,160
.أمسك بهذا الورق رجاءً

209
00:13:12,160 --> 00:13:13,310
.حسنًا

210
00:13:14,740 --> 00:13:16,940
أيّ مستوى هذا؟

211
00:13:16,940 --> 00:13:18,310
...في الواقع

212
00:13:18,840 --> 00:13:20,700
.المستوى 1

213
00:13:21,410 --> 00:13:22,660
واحد؟

214
00:13:24,370 --> 00:13:28,660
عذرًا، هل أعلّمك تعاويذ أخرى أيضًا؟

215
00:13:28,960 --> 00:13:31,350
.أجل، شكرًا

216
00:13:35,720 --> 00:13:37,110
ماكوتو-ساما؟

217
00:13:38,790 --> 00:13:40,370
ماكوتو-ساما؟

218
00:13:41,880 --> 00:13:42,970
.عزيزتي إيما

219
00:13:43,540 --> 00:13:44,960
.شكرًا على الأمس

220
00:13:45,280 --> 00:13:49,630
.سآخذ لائحة التّعاويذ والمعدّات الّتي أعطيتني

221
00:13:49,630 --> 00:13:54,040
.هذا ليس بكثير لشكرك، لكن سأرى ما يمكنني فعله بشأن الشّين

222
00:13:54,040 --> 00:13:55,550
.لا أصدّق هذا

223
00:13:56,830 --> 00:13:59,720
.استطعتُ قراءة لائحة التّعاويذ تلك وكتابة رسالة

224
00:13:59,720 --> 00:14:02,080
.لا بدّ أنّها قوّة تلك الإلهة الحقيرة

225
00:14:03,800 --> 00:14:09,060
.إن اختفيت بعد هزيمة الشّين، ينبغي أن أستطيع تفادي حدث عرس

226
00:14:09,060 --> 00:14:11,600
،من ناحية مثاليّة، أودّ حلّ الأمر بالنقاش

227
00:14:11,600 --> 00:14:15,260
.لكن يجب أن أتدرّب في حال كان علينا أن نتقاتل

228
00:14:17,240 --> 00:14:17,950
.بريد

229
00:14:19,900 --> 00:14:23,100
.حسنًا. تعمل حتّى بدون نطق التّعويذة

230
00:14:23,100 --> 00:14:26,950
.إن كان بإمكاني تغيير شكل المانا خاصّتي، فسأقوم بهذا

231
00:14:27,480 --> 00:14:29,970
.سينفع ذلك كهدف

232
00:14:37,740 --> 00:14:39,860
.حسنًا. أفلح الأمر

233
00:14:41,300 --> 00:14:42,510
!ماذا؟

234
00:14:44,540 --> 00:14:46,090
...سحقًا

235
00:14:49,830 --> 00:14:51,410
!أنا آسف

236
00:14:51,780 --> 00:14:55,490
هل تعمل للأورك؟

237
00:14:56,940 --> 00:14:59,530
.يبدون كأشخاص سيّئين تمامًا

238
00:15:01,160 --> 00:15:06,250
.استخدمنا اسم الشّين لإخضاع الأورك

239
00:15:07,510 --> 00:15:09,300
.لكنّك تسرّعت

240
00:15:09,300 --> 00:15:11,510
.لقد خرّبت بيته

241
00:15:12,010 --> 00:15:15,300
.سيصبح غضب الشّين حقيقيًّا لا محالة الآن

242
00:15:15,510 --> 00:15:18,980
.هذا جزاؤك

243
00:15:19,930 --> 00:15:20,970
سحب؟

244
00:15:21,430 --> 00:15:23,030
لا، ضباب؟

245
00:15:29,620 --> 00:15:36,990
...وفقًا للفولكلور، يفترض أن يكون الشّين محّارًا عملاقًا ينتج السّراب

246
00:15:38,760 --> 00:15:43,210
.لكن ما هو طبيعيّ لي ليس طبيعيًّا في هذا الإيسيكاي

247
00:15:46,330 --> 00:15:48,200
هل يهاجم بهذه السّرعة؟

248
00:15:52,500 --> 00:15:54,430
!أنا بأمان. ما زلت حيًّا

249
00:15:57,110 --> 00:15:58,660
.الضّباب يحجب رؤيتي

250
00:15:58,660 --> 00:16:01,430
.وهذا ليس بضباب عاديّ

251
00:16:10,550 --> 00:16:12,070
.تفاديته

252
00:16:12,070 --> 00:16:13,740
...أكانت الغريزة؟ لا

253
00:16:21,690 --> 00:16:27,130
أهذه القوّة الّتي وهبني إيّاها تسوكويومي-ساما؟

254
00:16:28,550 --> 00:16:30,340
بريد النّار إذًا؟

255
00:16:30,740 --> 00:16:34,390
.إصابتي بتلك التّعويذة لن تدغدغني حتّى

256
00:16:37,650 --> 00:16:42,180
!إصابة؟ أُصبت؟! لكنّي مقاوم للنّار

257
00:16:42,180 --> 00:16:43,860
...لكمة

258
00:16:44,380 --> 00:16:46,320
!اليأس

259
00:16:46,320 --> 00:16:48,020
...إلى

260
00:16:48,020 --> 00:16:49,520
!ضربة ظاهر اليد

261
00:16:50,270 --> 00:16:52,510
من هذا المخلوق؟

262
00:16:52,510 --> 00:16:55,040
.ينبغي أن أكون منيعًا

263
00:16:55,040 --> 00:16:57,510
!والآن الضّربة القاضية

264
00:16:57,510 --> 00:16:59,950
!قفزة الضّفدع الخطافيّة

265
00:17:00,770 --> 00:17:03,090
...سحقًا

266
00:17:05,570 --> 00:17:07,840
!سحقًا لك

267
00:17:08,870 --> 00:17:10,570
مـ-ما الّذي يجري؟

268
00:17:11,180 --> 00:17:17,930
.انتهى الأمر الآن. ستغرق بسعادة داخل وهم ذاكرتي

269
00:17:22,740 --> 00:17:24,240
.أنا بمستوى ممتاز

270
00:17:24,760 --> 00:17:26,350
.ا-المعذرة

271
00:17:27,410 --> 00:17:30,350
هاسيغاوا. ما الأمر؟

272
00:17:30,350 --> 00:17:33,110
...حـ-حسنًا، أنا

273
00:17:33,110 --> 00:17:34,870
.جُرزة جانبيّة

274
00:17:34,870 --> 00:17:38,620
.كانت تقوم بتلك التّسريحة مذ أثنيت عليها قبل فترة

275
00:17:38,980 --> 00:17:41,310
ألا يؤلم ذلك رأسها؟

276
00:17:41,310 --> 00:17:42,600
...ميسومي-سينباي

277
00:17:43,370 --> 00:17:45,360
.لطالما تطلّعت لك

278
00:17:45,360 --> 00:17:49,040
أنا معجبة بك. هلّا خرجت معي؟

279
00:17:49,990 --> 00:17:51,050
ماذا؟

280
00:17:52,360 --> 00:17:55,050
.صدقًا، لستُ وسيمًا

281
00:17:56,080 --> 00:17:58,590
.أحبّ الدراسة، لكنّي لستُ ذكيًّا جدًّا

282
00:17:59,050 --> 00:18:00,090
...علاوة على ذلك

283
00:18:01,380 --> 00:18:03,050
سينباي؟

284
00:18:03,210 --> 00:18:05,530
.لا، مهلًا. مهلًا لحظة

285
00:18:05,790 --> 00:18:08,400
.هذا مفاجئ جدًا

286
00:18:10,930 --> 00:18:11,690
!انتظري

287
00:18:12,710 --> 00:18:14,290
.لا تبكي يا هاسيغاوا

288
00:18:14,560 --> 00:18:16,940
.إذًا بإمكاننا تجريب الأمر لفترة

289
00:18:17,380 --> 00:18:19,820
.يمكنك أن تقع في حبّي هكذا

290
00:18:21,410 --> 00:18:22,890
ألا يمكننا ذلك؟

291
00:18:22,890 --> 00:18:25,410
.لـ-لا أستطيع الرفض

292
00:18:26,930 --> 00:18:29,920
.إنّه زائر من عالم آخر

293
00:18:30,160 --> 00:18:32,670
...ماذا؟ هذه الذّاكرة

294
00:18:32,900 --> 00:18:35,660
.ما هذا؟ لم أرَ أيّ شيء كهذا قطّ

295
00:18:35,860 --> 00:18:38,950
!أريد أن أسأله عنه... أن أجعله يخبرني كلّ شيء

296
00:18:39,330 --> 00:18:43,840
.عندما رأيتك تسحب قوسك، لم أستطع إشاحة نظري عنك

297
00:18:44,350 --> 00:18:47,170
.ذلك هو سبب انضمامي إلى نادي الرّماية

298
00:18:47,810 --> 00:18:48,780
سينباي؟

299
00:18:49,540 --> 00:18:52,700
.فـ-فهمت. شكرًا يا هاسيغاوا

300
00:18:52,700 --> 00:18:54,620
.نادني باسمي رجاءً

301
00:18:54,980 --> 00:18:57,370
.إنّه نوكومي

302
00:18:57,370 --> 00:19:00,000
...حسنًا، لكن حاليًّا، ما زلنا

303
00:19:00,440 --> 00:19:03,500
.سينباي، لنتسكّع كثيرًا في العطلة الصّيفيّة

304
00:19:03,770 --> 00:19:07,000
.أ-أجل، أتطلّع لذلك

305
00:19:07,690 --> 00:19:10,750
.لا. هذا ليس حقيقيًّا

306
00:19:11,070 --> 00:19:12,810
...في النّهاية، ما حدث حقًّا

307
00:19:14,100 --> 00:19:16,120
.دفعتُ هاسيغاوا للبكاء

308
00:19:17,390 --> 00:19:21,430
.هاسيغاوا، آسف لجعلك تمثّلين في هذه المهزلة

309
00:19:23,440 --> 00:19:27,680
.بدأت أفهم القوّة الّتي مدّني بها تسوكويومي-ساما

310
00:19:28,040 --> 00:19:34,680
بإمكاني إنشاء منطقة نصف دائريّة من
.حولي وأتلاعب بالمساحة الموجودة داخلها

311
00:19:35,370 --> 00:19:39,960
،على سبيل المثال، بوسعي أن أبحث في المنطقة دون أن يتمّ ملاحظتي

312
00:19:40,440 --> 00:19:42,400
.وكذلك تقوية الأشياء

313
00:19:43,570 --> 00:19:48,280
.شين، شكرًا لأنّك علّمتني كم أنا مثير للشّفقة

314
00:19:49,450 --> 00:19:51,280
!يا لها من قوّة استثنائيّة

315
00:19:51,790 --> 00:19:54,630
.لكنّي ما عدتُ أشعر بأيّ عدائيّة تجاهه

316
00:19:55,510 --> 00:19:56,620
.اسمع

317
00:19:59,050 --> 00:20:01,220
.أنزل ذراعيك رجاءً

318
00:20:01,220 --> 00:20:03,650
،على الرّغم من أنّه كان مجرّد وهم يصوّر رغباتك

319
00:20:03,650 --> 00:20:07,230
.أعتذر على التّجربة غير السّارّة

320
00:20:07,230 --> 00:20:10,220
أكانت تلك رغبتي؟

321
00:20:10,660 --> 00:20:14,320
.أيّها الزّائر من عالم آخر، اسمي شين

322
00:20:14,320 --> 00:20:17,150
.بمثابتي تنّين أعظم، أُعتبر منيعًا

323
00:20:17,790 --> 00:20:19,880
.أنا ميسومي ماكوتو

324
00:20:19,880 --> 00:20:22,120
.كما قلتَ، أتيتُ من عالم آخر

325
00:20:22,340 --> 00:20:25,570
ماكوتو-دونو، هل تودّ إبرام عقد معي؟

326
00:20:25,570 --> 00:20:26,620
ماذا؟

327
00:20:26,810 --> 00:20:29,890
العقد هو نوع خاصّ من السّحر يمنح ميزات متعدّدة

328
00:20:29,890 --> 00:20:32,300
.عندما يقسم الطّرفان اليمين لبعضهما

329
00:20:32,300 --> 00:20:36,630
.كلا الطّرفين مفوّضين، اعتمادًا على قوّتيهما النّسبيّة

330
00:20:36,870 --> 00:20:37,860
بمعنى آخر؟

331
00:20:37,860 --> 00:20:41,040
.سأصبح رفيقك

332
00:20:41,040 --> 00:20:42,960
.أعدك أنّي لن أخيّب ظنّك

333
00:20:44,900 --> 00:20:47,990
.أنا مهتمّ كثيرًا بذكرياتك

334
00:20:47,990 --> 00:20:49,380
.أنتظر ردّك الإيجابيّ

335
00:20:49,560 --> 00:20:52,530
أنت، كم من ذكرياتي رأيت؟

336
00:20:52,530 --> 00:20:53,900
وأيّ أسرار كشفت؟

337
00:20:54,970 --> 00:20:59,120
.أتساءل. أعتقد أنّ العقد سيفيد كلينا

338
00:20:59,420 --> 00:21:00,890
...أيّها الماكر

339
00:21:01,580 --> 00:21:04,330
!حسنًا! أتطلّع للعمل معك

340
00:21:04,330 --> 00:21:06,140
.آمل أن تستمرّ علاقتنا لسنين عديدة

341
00:21:06,780 --> 00:21:10,490
.إذًا لنؤدّ طقوس العقد

342
00:21:11,570 --> 00:21:14,250
.سنبدأ باتّفاق 50-50

343
00:21:15,690 --> 00:21:17,510
تغلّب عليّ؟

344
00:21:17,740 --> 00:21:20,350
.إذًا لنجرّب 70-30

345
00:21:20,950 --> 00:21:22,820
!إنّه استثنائيّ للغاية

346
00:21:22,820 --> 00:21:26,000
!إذًا لنجرّب 80-20

347
00:21:27,810 --> 00:21:30,220
.إنّه يقترب أخيرًا من التّوازن الصحيح

348
00:21:30,500 --> 00:21:32,820
.لكنّي عبده عمليًّا

349
00:21:34,730 --> 00:21:37,350
...لا يهمّ. أنا متشوّق لأرى ما هو

350
00:21:37,350 --> 00:21:42,810
.لا، ما سيفعله مولاي من الآن فصاعدًا

351
00:21:43,670 --> 00:21:49,540
الوقت الّذي على وشك أن أمضيه مع مولاي
.سيكون أعظم فترة في حياتي دون أدنى شكّ

352
00:21:50,870 --> 00:21:55,320
.أتطلّع للعمل معك يا مولاي

353
00:21:55,320 --> 00:21:57,780
حسناء رائعة بملابس يابانيّة؟

354
00:21:57,780 --> 00:22:00,040
.أفضّل أن تناديني بالسّاموراي

355
00:22:00,040 --> 00:22:02,950
...أنت بطل أكثر منك بطلة

356
00:23:36,910 --> 00:23:39,840
".اللّيلة الثّانية: عنكبوت الكارثة الأسود"