1
00:00:02,170 --> 00:00:06,720
!كيف يجرؤون على دخول غابتنا بأحذيتهم القذرة

2
00:00:06,720 --> 00:00:08,470
.اللّصحقراء اللّعينين

3
00:00:08,730 --> 00:00:10,610
ما معنى لصحقراء؟

4
00:00:10,610 --> 00:00:12,980
.تركيب بين لص وحقير

5
00:00:13,470 --> 00:00:16,060
على أيّ حال يا أكوا، هل قتلتهم؟

6
00:00:16,060 --> 00:00:17,770
.إنّهم أحياء

7
00:00:17,770 --> 00:00:20,610
.لكن كنت لأقتلهم لو أنّهم لمسوا اللّوتس الأحمر

8
00:00:21,220 --> 00:00:22,880
.بيضبط

9
00:00:22,880 --> 00:00:23,610
بيض...؟

10
00:00:24,140 --> 00:00:27,300
.إريس، كنت تقول الكثير من الكلمات الغريبة مؤخّرًا

11
00:02:00,190 --> 00:02:03,680
.لا شيء خاطئ بشأني

12
00:02:03,680 --> 00:02:06,810
.يبدو أن نوبات إزالة تأثير الحالة غير فعّالة

13
00:02:06,810 --> 00:02:10,080
.مانا السّيّد الصّغير هائلة بذلك القدر

14
00:02:10,080 --> 00:02:11,530
!سيّدي الصّغير

15
00:02:12,260 --> 00:02:14,290
!نحن مستعدّات

16
00:02:14,510 --> 00:02:16,340
!سيّدي الصّغير

17
00:02:18,740 --> 00:02:22,380
شكرًا لكم لإقامة حفلة للاحتفال بتأسيس

18
00:02:22,380 --> 00:02:25,010
.شركتي التّجاريّة في العالم الخارجيّ

19
00:02:27,260 --> 00:02:30,040
توموي، ألست أفضل في مثل هذه الأمور؟

20
00:02:30,040 --> 00:02:32,790
.يريدون أن يسمعوك تتكلّم يا سيّدي الصّغير

21
00:02:33,100 --> 00:02:35,300
.سيّدي الصّغير، اشرب هذا

22
00:02:35,710 --> 00:02:38,100
.شكرًا يا شظيّة توموي

23
00:02:39,680 --> 00:02:40,740
ماذا؟

24
00:02:40,740 --> 00:02:45,030
،بما أنّني وشظيّتي متّصلتان

25
00:02:45,030 --> 00:02:47,080
...عندما تربّت على رأسها، أنا

26
00:02:47,080 --> 00:02:48,480
...أنا

27
00:02:48,480 --> 00:02:49,010
ماذا؟

28
00:02:50,350 --> 00:02:54,010
.سيّدي الصّغير، وجدتُ هذا الطّبق في تسيغي

29
00:02:55,450 --> 00:02:56,530
.رائحته شهيّة

30
00:02:57,430 --> 00:03:00,040
أليست هذه فرصة لكي أطعمه؟

31
00:03:00,610 --> 00:03:02,460
.لديه نكهة قويّة. إنّه لذيذ

32
00:03:03,530 --> 00:03:06,110
.إنّه وحشيّ بشكل رائع

33
00:03:06,110 --> 00:03:07,040
.آسف

34
00:03:07,250 --> 00:03:08,800
أكانت تلك فظاظة منّي؟

35
00:03:09,210 --> 00:03:10,410
.هيّا يا ميو

36
00:03:10,600 --> 00:03:14,610
دعونا نفسح مجالًا في جانب السّيّد
.الصّغير من أجل ساكنة شبه المجال اليوم

37
00:03:15,030 --> 00:03:17,600
...لـ-لكن

38
00:03:19,790 --> 00:03:21,370
.من الجيّد رؤيتك ثانيةً

39
00:03:21,370 --> 00:03:23,030
.أنا أكينا الألك

40
00:03:23,030 --> 00:03:25,870
.تعلّمتُ أن أظلّ متحوّلة لفترات طويلة من الوقت

41
00:03:25,870 --> 00:03:28,150
.عجبًا، أتقنت شكل الإنسان خاصّتك أحسن إتقان

42
00:03:29,120 --> 00:03:33,420
أيمكنني أن أبلّغ عن زيارتنا لغابة تيناراك قبل أيّام؟

43
00:03:33,420 --> 00:03:36,150
أكيد. هل وجدتم أيّ أمبروسيا؟

44
00:03:36,400 --> 00:03:39,640
.أجل. إليك إحداثيّات الزّهرة وتفاصيل ذات صلة

45
00:03:40,260 --> 00:03:43,180
،فكّرنا في الرّجوع بواحدة

46
00:03:43,180 --> 00:03:46,370
.لكن يبدو أنّ هناك نوعًا يرعى الغابة

47
00:03:46,370 --> 00:03:47,770
.لا بأس

48
00:03:47,770 --> 00:03:50,700
.يبدو أنّ حصدها بلا مبالاة سيتسبّب في المشاكل

49
00:03:51,430 --> 00:03:54,870
بالمناسبة، هل تعوّد الألك على الحياة في شبه المجال؟

50
00:03:55,560 --> 00:03:57,890
.أجل، شكرًا لك

51
00:03:58,430 --> 00:04:01,190
.يبدو أنّ هارونا تستمتع باستخدام الأسلحة

52
00:04:01,190 --> 00:04:04,020
.حتّى أنّها شاركت في تدريب القتال من حين لآخر

53
00:04:04,630 --> 00:04:08,900
.يبحث ميناتو في العديد من الموادّ، كما الحدادة والكيمياء

54
00:04:09,560 --> 00:04:12,430
.كرّس هوكوتو نفسه لأعمال البناء

55
00:04:12,430 --> 00:04:14,800
.وهو يساند الأورك حاليًّا

56
00:04:15,470 --> 00:04:18,510
.أرافق ميو-ساما عادةً

57
00:04:19,230 --> 00:04:24,280
بينما نبحث عن الأزهار في العالم
.الخارجيّ، قمنا بزيارة عد من أكشاك الطّعام

58
00:04:24,280 --> 00:04:27,200
.لا بدّ أنّ ذلك قاد إلى الوجبة الّتي وجدتها ميو

59
00:04:27,200 --> 00:04:30,650
.كلّ هذا بفضلك أيّها السّيّد الصّغير

60
00:04:31,190 --> 00:04:33,290
.عليّ الذّهاب

61
00:04:34,720 --> 00:04:35,940
...سيّدي الصّغير

62
00:04:35,940 --> 00:04:37,870
.قاتلتَ نيابةً عن السّحالي

63
00:04:37,870 --> 00:04:38,790
.اسمي ليدي

64
00:04:39,990 --> 00:04:43,690
مذّاك الحين، تحّصلت على تكتيكات جديدة
.من خلال جلساتنا التّدريبيّة المشتركة

65
00:04:43,690 --> 00:04:45,790
.هزمت أغاريس قبل أيّام

66
00:04:47,240 --> 00:04:48,790
.يبدو أنّ الأمر كان يستحقّ

67
00:04:49,480 --> 00:04:50,280
.حاضر

68
00:04:50,280 --> 00:04:52,630
مؤخّرًا، كنت أتدرّب في قتال غير مسلّح

69
00:04:52,630 --> 00:04:55,220
.لتحضير ترتيب شبه المجال في ثلاثة أشهر

70
00:04:55,660 --> 00:04:58,040
.يبدو شيئًا قد يفعله سيّاف

71
00:04:58,040 --> 00:04:59,240
هل يعقل؟

72
00:04:59,890 --> 00:05:02,220
.أجل. توموي-ساما تدرّبني

73
00:05:03,030 --> 00:05:07,470
.تأثير توموي يسيطر على شبه المجال

74
00:05:09,130 --> 00:05:12,890
ستظلّ في تسيغي يا سيّدي الصّغير؟

75
00:05:12,890 --> 00:05:15,180
كيف هي بلدة البشر؟

76
00:05:15,180 --> 00:05:17,260
.إنّه مكان جميل وحيويّ

77
00:05:17,260 --> 00:05:20,000
.توموي وميو تجذبان الانتباه مع ذلك

78
00:05:22,390 --> 00:05:27,120
.مع ذلك، أشعر بالغيرة أنّهما ترافقاك

79
00:05:27,120 --> 00:05:29,590
.أنا واثق أنّ كلّ يوم يكون شيّقًا

80
00:05:30,250 --> 00:05:34,160
لم تغادروا شبه المجال مذ أتيتم؟

81
00:05:34,160 --> 00:05:38,100
أدري أنّه أكبر قليلًا الآن، لكن هل تجده خانقًا أحيانًا؟

82
00:05:38,410 --> 00:05:40,100
ماذا؟

83
00:05:40,970 --> 00:05:46,630
سيّدي الصّغير، لا يمكن إيجاد أيّ
.شعور بالخنق والحصار في هذا العالم

84
00:05:46,630 --> 00:05:48,360
حـ-حقًّا؟

85
00:05:48,940 --> 00:05:52,900
.يبدو أنّ لا نهاية لهذه الأرض الوفيرة

86
00:05:53,170 --> 00:05:57,010
.هناك جبال بعيدة وأنهار تتدفّق من مصادر غير معروفة

87
00:05:57,010 --> 00:06:00,870
ماذا قد يتمنّاه المرؤ أكثر في هذا النّعيم؟

88
00:06:01,120 --> 00:06:04,620
.ليس ذلك فحسب، بل وبإمكاني أن أصنع لك أسلحة

89
00:06:04,620 --> 00:06:06,570
.بمثابتي حرفيًّا، هذا أكثر ما يسعدني

90
00:06:06,570 --> 00:06:08,630
.فهمت. يطمئنني سماع ذلك

91
00:06:09,420 --> 00:06:16,390
.لكنّي أشعر بالفضول لأعرف أيّ أسلحة ذات شعبيّة خارج شبه المجال

92
00:06:16,600 --> 00:06:20,990
في تلك الحالة، هل تودّ إدارة المتجر الّذي نستأجره في تسيغي؟

93
00:06:20,990 --> 00:06:22,400
من؟ أنا؟

94
00:06:22,630 --> 00:06:26,440
.الأقزام معروفين بكونهم حدّادة ممتازين

95
00:06:26,440 --> 00:06:29,150
.أنا واثق أنّ النّاس سيوظّفونك لصناعة الأسلحة من أجلهم

96
00:06:29,450 --> 00:06:31,390
هل ستسمح لي بفعل ذلك؟

97
00:06:31,390 --> 00:06:32,900
.أجل، أكيد

98
00:06:33,170 --> 00:06:37,030
.إذًا أتطلّع لذلك

99
00:06:38,700 --> 00:06:43,430
.سـ-سيّدي الصّغير، عالجت جراحي سابقًا

100
00:06:43,430 --> 00:06:45,620
.أجل، أثناء التّسجيل

101
00:06:45,620 --> 00:06:47,910
!لـ-لقد تذكّرت

102
00:06:48,400 --> 00:06:53,170
أنا مكلّف في الواقع في المناوبة القادمة
.لإرشاد المغامرين إلى المدينة الوهميّة

103
00:06:54,120 --> 00:06:55,670
.المدينة الوهميّة

104
00:06:55,670 --> 00:06:59,430
إنّها المدينة الخياليّة الّتي اخترعناها لتوزيع المنتجات

105
00:06:59,430 --> 00:07:03,680
.التي تتواجد فقط في شبه المجال عن طريق المغامرين

106
00:07:04,040 --> 00:07:08,210
.أعتذر على جعلك تفعل ذلك من أجل عملي

107
00:07:08,210 --> 00:07:08,940
.لا شيء

108
00:07:09,210 --> 00:07:13,240
.لطالما أردت أن أفعل شيئًا من أجلك يا سيّدي الصّغير

109
00:07:15,380 --> 00:07:17,450
!دعوني أتحدّث مع السّيّد الصّغير أيضًا

110
00:07:15,980 --> 00:07:17,450
!وأنا أيضًا

111
00:07:21,610 --> 00:07:24,340
أما زالوا يستغلّون السّيّد الصّغير لأنفسهم؟

112
00:07:24,340 --> 00:07:27,090
.لا تسأليني. جنيت على نفسك

113
00:07:27,490 --> 00:07:31,240
.أردت أن أبلّغه بشأن الأمبروسيا

114
00:07:31,240 --> 00:07:33,930
...المخلوقات الّتي تعتني بتلك الزّهرة على الأرجح

115
00:07:34,710 --> 00:07:38,510
.ميو، لا يجب أن تشملي تكهّنات في تقريرك

116
00:07:38,510 --> 00:07:42,260
.انقلي الحقائق فقط وثقي بحُكم السّيّد الصّغير

117
00:07:42,260 --> 00:07:45,730
.يجب أن نعرض اقتراحنا فقط عندما نُسأل

118
00:07:46,280 --> 00:07:47,980
.معك حقّ

119
00:07:48,840 --> 00:07:51,220
.هذا غريب. لا أشعر أنّ السّيّد الصّغير قريب

120
00:07:51,950 --> 00:07:53,730
هل عاد إلى قصره؟

121
00:07:54,060 --> 00:07:55,440
...لا، مهلًا

122
00:08:00,470 --> 00:08:03,220
!لا يا سيّدي الصّغير

123
00:08:03,220 --> 00:08:04,630
!ميو، اهدئي

124
00:08:05,000 --> 00:08:07,120
...لـ-لكن

125
00:08:07,120 --> 00:08:08,850
.لقد عاد حضوره

126
00:08:09,160 --> 00:08:10,140
...لكن

127
00:08:10,140 --> 00:08:14,290
.لنتّجه إلى هناك. بسرعة، دون أن يلاحظ أيّ أحد

128
00:08:21,590 --> 00:08:24,040
.لم ينكسر الهدف

129
00:08:24,040 --> 00:08:25,640
.تعلّمتُ أن أتحكّم بقوّتي

130
00:08:26,150 --> 00:08:27,240
!سيّدي الصّغير

131
00:08:27,240 --> 00:08:29,150
منذ متى تقفان هناك؟

132
00:08:29,420 --> 00:08:31,670
!سيّدي الصّغير

133
00:08:33,390 --> 00:08:34,210
!مهلًا

134
00:08:35,880 --> 00:08:38,430
!أنت حيّ! ما زلت حيًّا

135
00:08:38,720 --> 00:08:41,080
—أنت قـ-قريبة جدًا. عمّاذا تتحدّثين

136
00:08:42,660 --> 00:08:44,990
توموي، هل نتعرّض للهجوم؟

137
00:08:46,580 --> 00:08:47,500
.لا

138
00:08:48,960 --> 00:08:51,350
أكنت تتدرّب على الرّماية؟

139
00:08:51,350 --> 00:08:55,520
.أجل، بما أنّني جعلتهم يعدّون نطاقًا بسيطًا

140
00:08:55,810 --> 00:08:59,750
أكنت تتدرّب هكذا حتّى الآن؟

141
00:09:00,060 --> 00:09:02,270
أجل. ماذا الآن؟

142
00:09:02,790 --> 00:09:04,430
!لا بدّ أنّك تهزأ

143
00:09:04,660 --> 00:09:07,300
!لقد متّ مرّات لا تحصى

144
00:09:08,150 --> 00:09:09,230
ماذا؟

145
00:09:09,690 --> 00:09:11,320
.لكنّي حيّ

146
00:09:11,760 --> 00:09:14,930
هلّي أن أسألك كيف سحبت قوسك؟

147
00:09:14,930 --> 00:09:15,780
كيف؟

148
00:09:16,010 --> 00:09:21,130
أقوم بالرّماية عادةً بينما أقف، لكن
.عندما أريد أركّز بعمق أكثر، أجثو

149
00:09:21,130 --> 00:09:22,880
!تخطّ التّفاصيل

150
00:09:22,880 --> 00:09:24,620
!أنت من سأل

151
00:09:25,310 --> 00:09:28,320
قلت تركّز بعمق أكثر، أليس كذلك؟

152
00:09:29,580 --> 00:09:32,630
.تسبّبت أفعالك في تذبذب وعيك

153
00:09:32,630 --> 00:09:35,060
.بدا أنّك تمتزج مع محيطك

154
00:09:35,770 --> 00:09:38,420
،بعد أن أصفّي ذهني

155
00:09:38,420 --> 00:09:42,050
—أتخيّل نفسي مندمجًا مع كلّ شيء بيني وبين الهدف، و

156
00:09:42,050 --> 00:09:43,160
!سيّدي الصّغير

157
00:09:43,160 --> 00:09:44,050
!ماذا؟

158
00:09:44,300 --> 00:09:49,340
هل قمت بتوسيع إدراكك إلى هذا المدى وثمّ أعدت هيكلة نفسك؟

159
00:09:49,340 --> 00:09:50,580
!أجل

160
00:09:51,120 --> 00:09:53,070
،سـ-سيّدي الصّغير

161
00:09:54,270 --> 00:10:01,070
.يمكن للنّاس أن يشتّتوا ذهنهم فقط عندما يـ-يموتون

162
00:10:01,320 --> 00:10:02,270
ماذا؟

163
00:10:03,140 --> 00:10:08,130
!ما كنت تفعله بدا كالانـ-كالانتحار تمامًا

164
00:10:08,530 --> 00:10:09,320
!إنّها تبكي

165
00:10:10,230 --> 00:10:12,630
.لكن انظري، أنا حيّ في الواقع

166
00:10:12,630 --> 00:10:14,150
لا توجد مشكلة، صحيح؟

167
00:10:14,150 --> 00:10:15,340
.ثمّة مشكلة كبيرة

168
00:10:15,760 --> 00:10:18,830
.المانا خاصّتك ترتفع

169
00:10:19,090 --> 00:10:19,850
ماذا؟

170
00:10:21,260 --> 00:10:24,810
.عادةً هناك حدّ لكمّ المانا الّتي يمكن للمرء يملكها

171
00:10:24,810 --> 00:10:27,840
،لا يمكن لأيّ قدر من التّدريب الرّفع من المانا

172
00:10:27,840 --> 00:10:30,260
.لكنّ المانا خاصّتك تنمو بمعدّل مذهل

173
00:10:31,280 --> 00:10:32,650
!الدراوبنيرس خاصّتي

174
00:10:33,250 --> 00:10:35,390
!كما أنّني استبدلتها أيضًا

175
00:10:35,860 --> 00:10:38,920
تركيزك الشّديد—تصرّفك الشّبيه بالموت

176
00:10:38,920 --> 00:10:43,410
.وإعادة الولادة يسبّب في ارتفاع المانا خاصّتك على الأرجح

177
00:10:43,820 --> 00:10:46,820
.لكن كلّ ما فعلته كان رمي سهم

178
00:10:47,330 --> 00:10:49,970
.إنّك تختبر الموت وإعادة الحياة

179
00:10:49,970 --> 00:10:55,750
.سمعت الكثير من حالات ارتفاع مانا المرء بعد حدث عجيب

180
00:10:56,000 --> 00:10:58,290
ألا يمكنني أن أرمي سهمًا حتّى؟

181
00:10:58,290 --> 00:11:01,150
.ينبغي أن يكون ممكنًا لك أن ترمي دون أن تركّز

182
00:11:01,150 --> 00:11:04,350
.المشكل الأكبر هو مستوى المانا خاصّتك الحاليّة

183
00:11:04,350 --> 00:11:06,800
أتقصدين أنّني أفيض بملوك الشّياطين ثانيةً؟

184
00:11:07,110 --> 00:11:09,530
.ليس ملوك الشّياطين

185
00:11:09,530 --> 00:11:12,320
...قدر المانا الّتي تمتلكها حاليًّا

186
00:11:12,570 --> 00:11:14,520
.في مستوى الإلهة

187
00:11:15,600 --> 00:11:16,550
ماذا؟

188
00:11:17,100 --> 00:11:22,900
.فضلًا عن ذلك، بينما اكتسبت المانا، توسّع شبه المجال بدوره

189
00:11:22,900 --> 00:11:24,080
!شبه المجال ينمو؟

190
00:11:24,540 --> 00:11:31,080
أجل، لا بدّ أنّ السّبب يرجع لأنّ شبه
.المجال هذا هو نتاج تدخّل بين قوانا

191
00:11:32,170 --> 00:11:33,570
...لكن

192
00:11:33,830 --> 00:11:37,100
.على سبيل المثال، ابحث عن وضع النّجوم في السّماء

193
00:11:37,100 --> 00:11:39,540
.لا أعرف هذه

194
00:11:39,970 --> 00:11:41,090
...النّجوم

195
00:11:41,600 --> 00:11:44,460
.أجل، تلك كلّها أبراج أعرفها

196
00:11:44,460 --> 00:11:47,750
.طريقة اختلاط موضعها ومواسمها منطقيّة أيضًا

197
00:11:48,880 --> 00:11:51,290
.على أيّ حال، هذه أخبار سيّئة بالنّسبة لنا

198
00:11:51,290 --> 00:11:54,270
،إن عرفت تلك الإلهة بشأن هذا

199
00:11:54,270 --> 00:11:57,110
.ستعمل على إبادتك على الأرجح

200
00:11:57,370 --> 00:12:01,060
أهناك نجاسة في عالمي الجميل؟

201
00:12:01,060 --> 00:12:02,640
!فلتمت أيّها المخلوق القبيح

202
00:12:03,030 --> 00:12:05,000
.بإمكاني أن أتخيّل ذلك بسهولة

203
00:12:05,210 --> 00:12:09,210
.حاليًّا، سنواجه ذلك من خلال التحكّم بالمانا خاصّتك

204
00:12:09,750 --> 00:12:13,260
سنجعل الأقزام يعجّلون بإكمال
.بعض العتاد الحامي الممتصّ للمانا

205
00:12:14,220 --> 00:12:18,720
سأستخدم الكاي خاصّتي لإخفاء المانا
.خاصّتي بينما أزور العالم الخارجيّ لفترة

206
00:12:20,270 --> 00:12:23,230
.سأفكّر في بعض الإجراءات المضادّة قبل العودة

207
00:12:23,560 --> 00:12:26,190
.سيّدي الصّغير، ودّع ميو

208
00:12:26,940 --> 00:12:28,710
.سـ-سأفعل ذلك

209
00:12:29,500 --> 00:12:32,050
.كم هذا مرعب

210
00:12:33,530 --> 00:12:38,010
من كان يدري أنّ الرّجل الّذي اخترته
كسيّد لي سيدنو من مستوى الإله؟

211
00:12:33,870 --> 00:12:36,030
.ميو، أنا بخير

212
00:12:36,030 --> 00:12:37,960
...سيّدي الصّغير

213
00:12:38,700 --> 00:12:43,750
.يا إلهي. لا أملك الوقت لأشعر بالملل بينما أنا مع سيّدي الصّغير

214
00:12:44,260 --> 00:12:46,420
.أنا منهكة

215
00:12:46,420 --> 00:12:48,910
.أنا مصدومة ولا أستطيع الوقوف

216
00:12:54,690 --> 00:12:57,840
.هناك الكثير ممّا يجب فعله للاستعداد لفتح متجر

217
00:12:57,840 --> 00:12:59,510
.سأذهب للتسوّق تاليًا

218
00:13:00,740 --> 00:13:04,530
.أشعر بدوخة لأنّني لا أستطيع التّركيز بينما أرمي سهمًا

219
00:13:04,530 --> 00:13:07,380
.ما حدث البارحة كان سيّئًا كفايةً

220
00:13:08,170 --> 00:13:10,120
سيّدي الصّغير؟

221
00:13:10,380 --> 00:13:12,510
.ما الأمر؟ الوقت متأخّر

222
00:13:12,980 --> 00:13:16,510
.ارتأيت أن أعتني بك اللّيلة

223
00:13:16,760 --> 00:13:19,720
.ماذا؟ لا يوجد عمل أكثر نقوم به اليوم

224
00:13:19,720 --> 00:13:21,430
.سأنام قريبًا أيضًا

225
00:13:21,430 --> 00:13:22,780
...عـ-عذرًا

226
00:13:23,050 --> 00:13:25,910
.ميو، عليك أن ترتاحي أيضًا. ليلة هنيئة

227
00:13:26,770 --> 00:13:27,780
...حسنًا

228
00:13:31,190 --> 00:13:33,890
.كان ذلك سريعًا للغاية

229
00:13:33,890 --> 00:13:37,410
أنت من طلب منّي تهدئة السّيّد
.الصّغير، بما أنّه لا يستطيع رمي سهم

230
00:13:37,410 --> 00:13:39,880
الاعتناء به؟ تهدئته؟

231
00:13:40,150 --> 00:13:41,500
أكانت تتحدّث عن النّوم معي؟

232
00:13:41,500 --> 00:13:44,760
سحقًا يا توموي! لمَ عليك فعل ذلك؟

233
00:13:45,440 --> 00:13:48,130
.أعصابي متوتّر جدًّا

234
00:13:48,130 --> 00:13:51,630
.بما أنّني لستُ متعبًا جسديًّا، أنا منهك ذهنيًّا أكثر بكثير

235
00:13:53,370 --> 00:13:55,730
.حتّى أنّني أتوهّم حقيبةً تحلّق نحوي

236
00:13:55,940 --> 00:13:56,730
!لا، مهلًا

237
00:13:58,550 --> 00:14:01,180
!حـ-حقيبتي

238
00:14:01,580 --> 00:14:04,360
لا يتكلّم بالعامّيّة. أهو نصف بشريّ؟

239
00:14:05,340 --> 00:14:06,730
هل أنت بخير؟

240
00:14:07,050 --> 00:14:08,060
.أ-أجل

241
00:14:10,240 --> 00:14:12,170
.شكرًا لك

242
00:14:13,610 --> 00:14:14,920
بدأت أفهم

243
00:14:14,920 --> 00:14:16,560
لمَ يقول النّاس

244
00:14:16,560 --> 00:14:17,800
.أنّني أملك وجه نصف بشريّ

245
00:14:18,050 --> 00:14:20,300
.أنت شخص طيّب يا سيّدي

246
00:14:20,520 --> 00:14:21,990
ماذا؟

247
00:14:21,990 --> 00:14:24,390
.ما الأمر؟ تبدو متعبًا

248
00:14:24,610 --> 00:14:27,120
أهذه منطقة حمراء؟

249
00:14:27,370 --> 00:14:30,570
.لا أفعل أيّ شيء حاليًّا، بما أنّني لا أملك أيّ زبائن

250
00:14:30,570 --> 00:14:32,270
،بما أنّك طيّب

251
00:14:32,270 --> 00:14:36,510
.سأدعوك إلى خدمة خاصّة

252
00:14:37,780 --> 00:14:39,770
خدمة؟

253
00:14:41,620 --> 00:14:43,900
ماذا؟

254
00:14:45,890 --> 00:14:46,390
!مهلًا

255
00:14:46,650 --> 00:14:48,410
ما الّذي يجري؟

256
00:14:49,850 --> 00:14:54,400
لمَ لا تقولان أيّ شيء؟

257
00:14:55,960 --> 00:14:57,450
.يجب أن أهرب

258
00:15:01,390 --> 00:15:03,790
سيّدي الصّغير، إلى أين تظنّ نفسك ذاهبًا؟

259
00:15:04,110 --> 00:15:05,580
ماذا تفعلان برأيكما؟

260
00:15:05,580 --> 00:15:07,040
.لقد تماديتما كثيرًا بمقالبكما هذه المرّة

261
00:15:07,340 --> 00:15:08,790
مقالب؟

262
00:15:09,210 --> 00:15:11,120
،بما أنّك متأخّر التفتّح وقليل الخبرة

263
00:15:11,120 --> 00:15:14,270
،كنّا نبذل جهدنا لنكون حذرتين وحازمتين دون إلحاح كبير

264
00:15:14,270 --> 00:15:16,900
،لكنّك كنت تحاول أخذ مومسًا، لذا أوقفناك

265
00:15:16,900 --> 00:15:18,010
وتدعو ذلك مقلبًا؟

266
00:15:18,010 --> 00:15:20,300
لمَ تتحدّثين بسرعة فجأةً؟

267
00:15:20,300 --> 00:15:23,590
،أظنّني سمعت شيئًا لا يجب أن أتجاهله

268
00:15:23,590 --> 00:15:25,300
.لكن صدف وأن صادفت تلك المرأة

269
00:15:25,510 --> 00:15:26,990
مهلًا، ألم تكونا تشاهدان؟

270
00:15:26,990 --> 00:15:29,940
.أجل، كان مشهدًا لا يفوّت

271
00:15:29,940 --> 00:15:32,100
.ما كنت لأقول ذلك

272
00:15:32,100 --> 00:15:34,200
ألسنا جيّدتين بما يكفي لك؟

273
00:15:34,460 --> 00:15:36,680
.ا-الأمر ليس كذلك

274
00:15:36,680 --> 00:15:38,670
ما المشكل إذًا؟

275
00:15:38,670 --> 00:15:42,310
...أ-أنتما الاثنتان أ-أشبه

276
00:15:42,580 --> 00:15:43,410
أشبه؟

277
00:15:43,870 --> 00:15:48,650
.أ-أحبّهما كعائلة، لكن لا يمكنني أن أقول شيئًا بهذا الإحراج أبدًا

278
00:15:49,110 --> 00:15:51,430
.لـ-ليس من شأنكما

279
00:15:53,970 --> 00:15:55,240
ميو؟

280
00:15:55,240 --> 00:15:57,190
.أجل، توموي-سان

281
00:15:59,190 --> 00:16:02,190
.لا وقت للقلق بشأن من الأولى

282
00:16:02,190 --> 00:16:05,990
.ستقيم علاقة بين اثنتينا هنا والآن

283
00:16:05,990 --> 00:16:08,420
عـ-عمّاذا تتحدّثان؟

284
00:16:09,450 --> 00:16:11,950
...سيّدي الصّغير

285
00:16:15,170 --> 00:16:16,630
.هيّا

286
00:16:17,200 --> 00:16:21,160
!ا-انتظرا

287
00:16:21,430 --> 00:16:24,250
!هدّئا من روعكما

288
00:16:23,380 --> 00:16:24,450
ماذا؟

289
00:16:28,430 --> 00:16:30,390
.هرب من خلال بوّابة ضباب

290
00:16:30,390 --> 00:16:32,330
.ربّما كنّا ملحّتين أكثر من اللّازم

291
00:16:32,330 --> 00:16:35,420
هـ-هل أغضبنا السّيّد الصّغير؟

292
00:16:35,420 --> 00:16:37,980
...لا، لم يكن غاضبًا. بالأحرى

293
00:16:37,980 --> 00:16:41,050
!ربّما يفضّل الملابس الدّاخليّة الفاسقة

294
00:16:41,050 --> 00:16:43,690
!هذا لأنّنا كنّا نرتدي ضمّادات قماش غير مثيرة

295
00:16:43,690 --> 00:16:45,980
.لا أظنّ أنّ ذلك هو المشكل

296
00:16:44,290 --> 00:16:45,760
ما العمل؟

297
00:16:45,760 --> 00:16:47,790
!نحن بحاجة لإيجاد شيء يحبّه السّيّد الصّغير

298
00:16:46,180 --> 00:16:47,810
.لا تنصت

299
00:16:49,930 --> 00:16:51,200
!سيّدي الصّغير

300
00:16:51,630 --> 00:16:52,680
سيّدي الصّغير؟

301
00:16:52,680 --> 00:16:56,000
.بالتّفكير في الأمر، ذلك النّزل فيه طابقين

302
00:16:56,000 --> 00:16:59,340
مزّقت ثيابك إربًا. ماذا حدث؟

303
00:16:59,340 --> 00:17:01,420
...في الواقع

304
00:17:01,420 --> 00:17:04,500
...ضباب ورديّ وحرير عنكبوت

305
00:17:05,890 --> 00:17:09,250
.لا ينبغي أن تبقى مرتديًا تلك الملابس

306
00:17:09,250 --> 00:17:12,700
.أكمل روغوي-سان بعضًا من العتاد الواقي السحريّ

307
00:17:12,700 --> 00:17:14,650
ما رأيك أن تجرّبه؟

308
00:17:14,650 --> 00:17:18,290
.شكرًا لأنّك اكتشفت الأمر بنفسك يا إيما-سان

309
00:17:20,080 --> 00:17:24,160
.أخيرًا، اربط تلك السّلاسل بداخل معطفك

310
00:17:25,290 --> 00:17:28,640
.إنّها تعمل كما تمّ توضيحه مسبقًا

311
00:17:33,310 --> 00:17:35,310
.تبدو جيّدة

312
00:17:35,310 --> 00:17:36,780
.هذه للعمل

313
00:17:37,000 --> 00:17:40,510
.أنوي صنع واحدة من أجل المناسبات الاجتماعيّة والقتال أيضًا

314
00:17:41,960 --> 00:17:44,280
.المعذرة يا سيّدي الصّغير

315
00:17:44,920 --> 00:17:46,180
...ميو

316
00:17:47,430 --> 00:17:49,810
.أعتذر عن ليلة البارحة

317
00:17:49,810 --> 00:17:52,400
.أفهم لمَ أنت غاضب جدًّا علينا

318
00:17:52,400 --> 00:17:54,750
.لستُ غاضبًا

319
00:17:55,260 --> 00:17:59,550
.لكن من الآن فصاعدًا، ربّما لا يجب أن تفعلا ذلك

320
00:17:59,990 --> 00:18:02,070
.مفهوم

321
00:18:04,520 --> 00:18:05,750
.هذا محرج

322
00:18:06,820 --> 00:18:11,220
.بـ-بالمناسبة، سمعت أنّ هناك عرقًا يعتني بأزهار أمبروسيا

323
00:18:11,220 --> 00:18:12,660
.نعم

324
00:18:12,660 --> 00:18:16,580
.أفكّر في المفاوضة معهم من أجل زهرة

325
00:18:16,580 --> 00:18:17,570
.لا

326
00:18:17,920 --> 00:18:21,070
.لا يمكنني أن أستغرق وقتك في ذلك

327
00:18:21,540 --> 00:18:23,850
.دعني أتكفّل بالأمر

328
00:18:23,850 --> 00:18:25,850
.لا، لنذهب معًا

329
00:18:26,250 --> 00:18:27,350
معًا؟

330
00:18:27,600 --> 00:18:30,100
يمكننا الذّهاب إلى هناك سويًّا، حسنًا؟

331
00:18:30,960 --> 00:18:31,890
...لـ

332
00:18:32,170 --> 00:18:34,370
!لنذهب! ما كنت لأحلم بعدم الذّهاب

333
00:18:34,370 --> 00:18:36,080
ماذا يفترض بذلك أن يعني؟

334
00:18:40,520 --> 00:18:42,270
.إنّهم يتبعوننا

335
00:18:42,270 --> 00:18:43,100
.أجل

336
00:18:43,100 --> 00:18:45,320
،تركتهم وشأنهم لأنّهم كانوا نكرة

337
00:18:45,650 --> 00:18:48,110
.لكن إن أعطيتني إذنك، لن أترك أثرًا لهم

338
00:18:48,110 --> 00:18:50,310
.لست بحاجة لفعل ذلك

339
00:18:50,860 --> 00:18:55,270
.أشكّ أنّهم سيتسبّبون بأيّ ضرر، لكن ربّما من الأفضل أن نتوارى عنهم

340
00:18:55,460 --> 00:18:56,220
.حاضر يا سيّدي الصّغير

341
00:18:57,420 --> 00:18:59,010
مـ-ما هذه الخيوط؟

342
00:18:59,010 --> 00:19:01,500
!علقت بي ولا تزول

343
00:19:03,120 --> 00:19:04,530
!سحقًا

344
00:19:07,440 --> 00:19:10,300
.هنا تنمو الأمبروسيا

345
00:19:10,300 --> 00:19:12,580
.أحدهم يعتني بها بكلّ تأكيد

346
00:19:13,790 --> 00:19:14,710
.ويحي

347
00:19:15,580 --> 00:19:17,750
.سنقع إلّم نتوخّ الحذر

348
00:19:18,190 --> 00:19:20,620
.المكان زلق. لنمسك بأيدينا

349
00:19:23,320 --> 00:19:24,690
نمسك بأيدي بعضنا؟

350
00:19:25,510 --> 00:19:27,350
.زلّ لساني لأنّني فكّرت في أختي الصّغيرة

351
00:19:27,540 --> 00:19:29,520
.آسف، هذا ليس ما أقصد

352
00:19:29,520 --> 00:19:30,760
.على الإطلاق

353
00:19:31,040 --> 00:19:32,980
!سأتشبّث بيدك بإحكام

354
00:19:32,980 --> 00:19:34,390
!لا تفعلي ذلك

355
00:19:37,480 --> 00:19:39,280
...يد السّيّد الصّغير

356
00:19:39,680 --> 00:19:42,480
.إنّها أكبر من يدي قليلًا

357
00:19:43,010 --> 00:19:44,710
.أنا سعيدة حقًّا

358
00:19:44,710 --> 00:19:47,450
.يا ليت هذه اللّحظة تدوم إلى الأبد

359
00:19:47,450 --> 00:19:48,280
!توقّفا

360
00:19:49,310 --> 00:19:52,540
أيّها البشر، ماذا تفعلان في غابتنا؟

361
00:19:52,980 --> 00:19:55,040
هاتان هما حاميتا الغابة؟

362
00:19:57,390 --> 00:20:01,050
لا نريد أيّ ضرر. أيمكننا الحديث؟

363
00:20:01,380 --> 00:20:03,060
...واحد وثلاثون ثانية

364
00:20:03,780 --> 00:20:06,060
...محض واحد وثلاثين ثانية

365
00:20:06,530 --> 00:20:12,210
!كيف تجرؤان عن عرقلة لحظة سعادتي مع سيّدي الصّغير

366
00:20:10,700 --> 00:20:13,570
!شيء خبيث يصدر منك

367
00:20:13,950 --> 00:20:15,900
!أشعر بالمانا صادرة من هناك

368
00:20:16,250 --> 00:20:18,350
!تبًّا! إنّهم أولئك المغامرون

369
00:20:18,800 --> 00:20:21,680
أتلك أزهار أمبروسيا؟

370
00:20:22,170 --> 00:20:25,600
!إنّها تنتمي لنا! سنأخذها كلّها

371
00:20:25,600 --> 00:20:26,880
لمن لماذا؟

372
00:20:27,170 --> 00:20:29,530
!عرفتها! لصوص

373
00:20:29,530 --> 00:20:31,870
!مـ-مهلًا! اهدئي

374
00:20:32,120 --> 00:20:34,880
سيّدي الصّغير، بإمكاني أكلهم، صحيح؟

375
00:20:34,880 --> 00:20:37,560
لا تمانع إن قتلتهم جميعًا، أليس كذلك؟

376
00:20:36,170 --> 00:20:38,820
!لا تفعلي! أنت أكثر من عليه أن يهدأ

377
00:20:38,820 --> 00:20:40,140
.أنت يا امرأة

378
00:20:40,590 --> 00:20:42,670
.تفوح منك رائحة اللّوتس الحمراء

379
00:20:43,060 --> 00:20:44,420
رائحة؟

380
00:20:44,830 --> 00:20:49,060
.من آخر مرّة تحرّت بأمر الزّهور؟ لكنّ ذلك كان قبل أيّام

381
00:20:50,100 --> 00:20:50,860
.نباح

382
00:20:50,860 --> 00:20:52,020
لمَ نبحت؟

383
00:20:52,320 --> 00:20:54,790
.أخبرني وحي إلهيّ أن أنبح

384
00:20:54,790 --> 00:20:55,770
ممّن؟

385
00:20:56,200 --> 00:20:57,460
.من نفسي

386
00:20:57,760 --> 00:20:59,770
!لا يأتي الوحي الإلهيّ من نفسك

387
00:20:59,770 --> 00:21:01,280
.ردّ جيّد

388
00:21:01,570 --> 00:21:03,730
.لكن تظلّ الجريمة جريمة

389
00:21:03,730 --> 00:21:05,780
.أيًّا كنت، ستدفع الثّمن بحياتك

390
00:21:06,090 --> 00:21:07,280
أيًّا كنت؟

391
00:21:07,760 --> 00:21:09,290
!لا تهدري أنفاسك

392
00:21:09,800 --> 00:21:11,500
!الموت أو تلقى حتفك

393
00:21:12,620 --> 00:21:15,640
!سأموت في كلتا الأحوال

394
00:21:15,640 --> 00:21:19,710
!مهلًا، لمَ تهرب؟ اهزمهما

395
00:21:19,710 --> 00:21:20,670
لمَ تملي عليّ الأوامر؟

396
00:21:21,270 --> 00:21:25,460
مهلًا، ألم أصادفها البارحة؟

397
00:21:27,330 --> 00:21:29,560
.لقد صدّ سحر إيريس

398
00:21:29,830 --> 00:21:32,460
!في تلك الحالة، سنبدأ بالشّخص الضّعيف

399
00:21:40,180 --> 00:21:41,540
!الكاي الدّفاعيّ

400
00:21:44,440 --> 00:21:46,660
ماذا؟ هل صدّها؟

401
00:21:47,970 --> 00:21:51,670
حسنًا. استطعت استخدامها واستخدام
.الكاي المخفي للمانا خاصّتي في نفس الوقت

402
00:21:51,670 --> 00:21:53,990
.ينبغي بذلك أن يطوّر الوضع

403
00:21:53,990 --> 00:21:58,510
.قتل، قتل، قتل

404
00:21:55,380 --> 00:21:57,150
!إنّها على وشك أن تفيض

405
00:21:57,150 --> 00:22:00,230
!لم تتحسّن الأمور إطلاقًا

406
00:23:36,740 --> 00:23:39,720
".اللّيلة العاشرة: "قرية الغول المخفيّة