1
00:00:24,370 --> 00:00:25,540
!الآن

2
00:00:27,830 --> 00:00:30,630
!أفق أيّها الإمبليو خاصّتي

3
00:00:40,300 --> 00:00:41,560
أأنت بخير؟

4
00:00:43,060 --> 00:00:44,520
أ-أجل

5
00:00:47,850 --> 00:00:49,560
الوضع آمنٌ الآن

6
00:01:06,120 --> 00:01:10,130
كنتُ نبيلاً بحقٍّ اليوم

7
00:01:12,290 --> 00:01:15,510
يمكنك أن تقول "أبلينا حسناً" فحسب

8
00:01:16,630 --> 00:01:20,300
لا بأس، أنا أفي بأمنية جدّتي الأخيرة

9
00:01:23,390 --> 00:01:25,430
هاك أغراضك

10
00:01:26,600 --> 00:01:28,020
شكراً لك

11
00:01:28,850 --> 00:01:31,270
ربما ليس الأمر بذاك السوء

12
00:01:31,270 --> 00:01:32,690
أيّها النبيل

13
00:01:33,820 --> 00:01:36,150
!لا تناديني بذاك الشكل يا سيليا

14
00:01:36,150 --> 00:01:37,780
دائماً ما تردّدها

15
00:01:37,780 --> 00:01:40,320
سيبدأ الجميع بتقليدك -
ليو فوركارد -

16
00:01:40,990 --> 00:01:43,290
لمَ تهمل الانتباه؟

17
00:01:43,290 --> 00:01:45,330
!آسف يا معلّمة ليزيت

18
00:01:45,330 --> 00:01:46,750
وأنتِ أيضاً يا سيليا أرفير

19
00:01:46,750 --> 00:01:47,830
!أجل

20
00:01:47,830 --> 00:01:51,500
نحن جنود الاتّحاد، ابقيا يقظين

21
00:01:51,500 --> 00:01:52,830
!حاضر

22
00:02:00,550 --> 00:02:06,140
بالتفكير في الأمر، من الغريب رؤية
فيرونغا بهذا القرب من الطريق الأساسيّ

23
00:02:10,100 --> 00:02:12,900
لم تعد تمتلك أمكنةً للعيش

24
00:02:12,900 --> 00:02:14,860
بسبب تلك المدينة

25
00:02:16,690 --> 00:02:21,740
هيّا بنا، وجهتنا لونّ قريبة

26
00:02:33,710 --> 00:02:36,420
!اسمح لنا بالدخول رجاءً

27
00:02:36,420 --> 00:02:40,420
لا يمكن، وصلتنا أنباء بوجود
جواسيس للإمبراطوريّة في المنطقة

28
00:02:40,420 --> 00:02:44,050
!مُحال، لسنا جواسيساً -
أنا ليزيت ريغنر، معلّمة بليز في أكاديميّة فرسان إيديس

29
00:02:44,050 --> 00:02:44,760
...لكن -
أنا ليزيت ريغنر، معلّمة بليز في أكاديميّة فرسان إيديس

30
00:02:44,760 --> 00:02:45,100
...أرجوك، أتوسّل إليك -
أنا ليزيت ريغنر، معلّمة بليز في أكاديميّة فرسان إيديس

31
00:02:45,100 --> 00:02:47,350
...أرجوك، أتوسّل إليك -
أطلب مع اثنين معي الدخول -

32
00:02:47,350 --> 00:02:50,270
...أرجوك، لن أستغرق وقتاً -
مفهوم، انتظري التأكيد رجاءً -

33
00:02:50,270 --> 00:02:53,100
!عليّ شراء دواءٍ لابنتي

34
00:02:54,060 --> 00:02:56,730
لدينا أوامر بألّا نُدخل أحداً لفترة

35
00:02:56,730 --> 00:02:58,900
...لكن لم يعد لدينا

36
00:02:58,900 --> 00:03:03,450
لا نستطيع السماح لأحدٍ بالدخول
حتّى يُلغى الإنذار

37
00:03:03,450 --> 00:03:05,120
...كلا

38
00:03:07,660 --> 00:03:08,950
اسمعي

39
00:03:08,950 --> 00:03:10,290
سأذهب لشرائه لك

40
00:03:11,500 --> 00:03:12,620
...أنت

41
00:03:12,620 --> 00:03:15,460
أنا ليو فوركارد، فارس للاتّحاد قيد التمرين

42
00:03:15,460 --> 00:03:17,920
نحصل على تصريحٍ لدخول المدينة حالياً

43
00:03:17,920 --> 00:03:20,460
لن تكون هنالك مشكلة إن ذهبت
لشراء الدواء ورجعت، صحيح؟

44
00:03:20,460 --> 00:03:23,050
لا بأس

45
00:03:23,050 --> 00:03:25,930
كما سمعتِ، أيمكنك الانتظار؟

46
00:03:25,930 --> 00:03:28,560
هاك، يمكنك الاحتفاظ بحقيبة أدويتي

47
00:03:28,560 --> 00:03:31,560
استعمليها متى استدعت الحاجة

48
00:03:35,270 --> 00:03:37,560
هذا الدواء الذي نحتاجه

49
00:03:40,320 --> 00:03:42,780
حسناً، سأسرع

50
00:03:43,200 --> 00:03:46,240
لحظة، كيف لي أن أشكرك؟

51
00:03:46,240 --> 00:03:47,950
لا داعي

52
00:03:51,540 --> 00:03:56,460
علّمته جدّته أن يكون نبيلاً دوماً

53
00:03:56,460 --> 00:03:58,130
لطالما كان هكذا

54
00:04:02,590 --> 00:04:08,010
ظننتُ أنّي علّمتك أنّ الأولويّة للمهمّة دائماً

55
00:04:08,010 --> 00:04:12,060
لديك عادةٌ سيّئة في إقحام
أنفك في شؤون الآخرين

56
00:04:12,060 --> 00:04:13,230
يا ليو فوركارد

57
00:04:13,230 --> 00:04:16,350
سأقبل العقوبة لاحقاً

58
00:04:16,350 --> 00:04:20,230
لكن يجب أن أجلب دواءها الآن

59
00:04:22,940 --> 00:04:25,400
اجلب لأمّها أيضاً

60
00:04:26,950 --> 00:04:30,080
لكن أوصلاه غداً، مفهوم؟

61
00:04:30,080 --> 00:04:31,620
!أجل

62
00:04:31,620 --> 00:04:34,960
لديّ اجتماع في مقرّ القيادة

63
00:04:34,960 --> 00:04:39,000
تعالا صباحاً عند الحادية عشرة

64
00:04:39,000 --> 00:04:41,340
ابقيا يقظين

65
00:04:41,340 --> 00:04:42,800
!عُلِم

66
00:04:49,340 --> 00:04:51,530
تعال لأخذه عندما تفرغ الساعة الرمليّة

67
00:04:51,530 --> 00:04:52,680
حسناً

68
00:05:09,490 --> 00:05:11,950
أنت كثير الأكل بحقّ

69
00:05:11,950 --> 00:05:15,500
ما الذي تقولينه؟ لطالما كنت
هكذا مُذ صغري

70
00:05:17,040 --> 00:05:19,040
هذه على حسابنا

71
00:05:20,090 --> 00:05:21,420
!شكراً

72
00:05:21,420 --> 00:05:23,130
كُل كثيراً

73
00:05:24,630 --> 00:05:27,260
فراولة؟ في هذه المنطقة؟

74
00:05:27,260 --> 00:05:30,930
لا بدّ أنّهم يستعملون بيتاً زجاجياً، فهذه لونّ

75
00:05:30,930 --> 00:05:37,310
هل نسيت ما تعلّمناه عن هذه
المدينة من معلّمتنا يا ليو؟

76
00:05:40,980 --> 00:05:43,480
كلّ ذلك بفضل ذاك العمود

77
00:05:43,480 --> 00:05:47,320
شُيِّد عندما كانت لا تزال
المدينة جزءاً من الإمبراطوريّة

78
00:05:47,320 --> 00:05:50,280
يُوفّر مانا وفيرة للمدينة بأسرها

79
00:05:50,280 --> 00:05:53,330
...تقنية إمبراطوريّة

80
00:05:53,330 --> 00:05:55,450
لذا كانت توجد أنوار
نيون كثيرة هنا

81
00:05:55,450 --> 00:05:59,210
صحيح، يوفّر المُفاعل الطاقة
للبيوت الزجاجيّة

82
00:05:59,210 --> 00:06:01,290
التي تؤمن كميّةً لا متناهية
من الفواكه والخضروات

83
00:06:01,290 --> 00:06:04,380
بالإضافة لأعلى مستويات
العناية الطبيّة

84
00:06:04,380 --> 00:06:07,220
ليست كلّها محاسن مع ذلك

85
00:06:08,970 --> 00:06:12,470
توجد مشكلة جواسيس الإمبراطوريّة حالياً

86
00:06:12,470 --> 00:06:15,430
لكن يُفترض أن تستطيع تلك الأمّ
وابنتها الدخول قريباً

87
00:06:15,430 --> 00:06:17,850
أجل

88
00:06:17,850 --> 00:06:21,230
بعد انتهائنا من الأكل، يُفترض أنّ يحين
وقت جلبنا للدواء

89
00:06:21,230 --> 00:06:22,480
صحيح

90
00:06:48,800 --> 00:06:51,680
...سيليا، هذا الإنذار

91
00:06:51,680 --> 00:06:53,300
أهو قادم من الأسوار؟

92
00:06:57,510 --> 00:06:58,770
!هذا سيّئ

93
00:07:02,890 --> 00:07:04,400
!أمّي

94
00:07:08,440 --> 00:07:09,940
ما الوضع؟

95
00:07:09,940 --> 00:07:12,030
يتّجه سربٌ من الفيرونغا إلى هنا

96
00:07:12,950 --> 00:07:15,780
تبّاً، لا أستطيع حساب المسافة
!بسبب الظلام الحالك

97
00:07:17,080 --> 00:07:18,410
لنُدخل اللاجئين

98
00:07:18,410 --> 00:07:19,490
كلا

99
00:07:19,490 --> 00:07:23,000
طالما تبقى البوّابات مغلقة، ستحفظ
الحواجز الفنّية أمان المدينة

100
00:07:23,000 --> 00:07:24,830
لن نفتح البوّابات

101
00:07:24,830 --> 00:07:26,170
...لكن

102
00:07:27,170 --> 00:07:30,010
لا تقلقوا، أتينا للدعم

103
00:07:30,010 --> 00:07:33,510
ليو فوركارد، عضو في بليز، سأستسلم الطليعة

104
00:07:33,510 --> 00:07:34,890
بليز؟

105
00:07:34,890 --> 00:07:39,930
،وأنا سيليا ألفير، عضوة في بليز أيضاً
سأكون أعين رماتكم هنا

106
00:07:42,810 --> 00:07:45,150
أفق أيّها الإمبليو خاصّتي

107
00:07:46,980 --> 00:07:49,360
ثمانية منهم في اتّجاه الساعة الواحدة

108
00:07:49,360 --> 00:07:51,780
يبدو أنّ أحدهم هو الزعيم

109
00:07:51,780 --> 00:07:53,740
الهدف، 580

110
00:07:53,740 --> 00:07:55,860
!580

111
00:07:55,860 --> 00:07:58,490
عُلِم، شكراً لك

112
00:07:58,490 --> 00:08:02,700
!استهدفوا التي في الخطّين الثالث والرابع

113
00:08:02,700 --> 00:08:06,420
!أيّها الرماة، أقواسكم هي خطّ الدفاع الثاني

114
00:08:06,420 --> 00:08:08,040
بقت 300

115
00:08:08,040 --> 00:08:09,710
!استعداد

116
00:08:11,510 --> 00:08:16,340
!زمجر أيّها الإمبليو خاصّتي

117
00:08:16,340 --> 00:08:18,100
بقت 130

118
00:08:19,100 --> 00:08:20,560
!الآن

119
00:08:30,980 --> 00:08:32,730
!أراك

120
00:08:41,370 --> 00:08:42,950
هل الجميع بخير؟

121
00:08:42,950 --> 00:08:45,330
اصمدوا قليلاً فحسب

122
00:08:45,330 --> 00:08:46,710
!انتبه

123
00:09:04,680 --> 00:09:06,180
ماذا؟

124
00:09:12,690 --> 00:09:13,820
!تبّاً

125
00:09:42,680 --> 00:09:44,640
سأقضي عليه بهذه

126
00:10:15,590 --> 00:10:16,920
...هذا الشيء

127
00:10:25,310 --> 00:10:27,890
يجب أن تكون أكثر دقّة يا فوركارد

128
00:10:27,890 --> 00:10:29,730
!معلّمتي

129
00:10:29,730 --> 00:10:33,020
لكنّك أحسنت البلاء

130
00:10:34,480 --> 00:10:35,940
!أجل

131
00:10:40,240 --> 00:10:41,530
إبرة؟

132
00:10:55,250 --> 00:10:58,510
المُفاعل على الفيرونغا إذاً

133
00:11:02,720 --> 00:11:04,260
!ليو

134
00:11:05,550 --> 00:11:07,180
صحيح، الدواء

135
00:11:09,520 --> 00:11:10,980
شكراً جزيلاً لك

136
00:11:10,980 --> 00:11:12,230
!ليو

137
00:11:13,730 --> 00:11:15,480
أنت نبيلٌ جدّاً

138
00:11:17,400 --> 00:11:19,990
لم تتغيّر يا ليو

139
00:11:21,820 --> 00:11:23,280
ألستُ كذلك؟

140
00:11:30,750 --> 00:11:35,170
بلاءٌ حسن البارحة، لكنّ المهمة في بدايتها

141
00:11:35,170 --> 00:11:38,630
سأشرح لكما التفاصيل الآن

142
00:11:38,630 --> 00:11:44,090
هدفنا نحن الاتّحاد هو إيقاف ذاك العمود

143
00:11:44,090 --> 00:11:48,890
،سمعت أنّه إمبراطوريّ الأصل
لكن أهو بذاك السوء؟

144
00:11:50,180 --> 00:11:56,020
،رأيتما الأرض القاحلة خارج حدود لونّ
العمود هو سببها

145
00:11:56,900 --> 00:11:59,860
كما ظننت

146
00:11:59,860 --> 00:12:03,530
لا بدّ أنّ جهازاً بتلك القوة سيسبّب
اعوجاجاً في المانا داخل الأرض

147
00:12:09,240 --> 00:12:13,710
بدأ كلّ شيءٍ عندما شيّدت
الإمبراطوريّة ذاك العمود

148
00:12:13,710 --> 00:12:19,000
انهار توازن المانا، وفقدت الوحوش مواطنها

149
00:12:19,000 --> 00:12:22,380
وجفّت المحاصيل

150
00:12:22,380 --> 00:12:25,630
يجب إيقافه قطعاً

151
00:12:25,630 --> 00:12:28,350
مهمتنا هي حمايته

152
00:12:28,350 --> 00:12:31,310
أنا نيكولا من مختبرات أبحاث الجيش

153
00:12:34,600 --> 00:12:39,900
أصبح موطن السيّد نيكولا أرضاً
قاحلةً قبل عامين

154
00:12:39,900 --> 00:12:44,530
المنطقة حول لونّ الآن ليست
بمكان قد يعيش فيه أحد

155
00:12:50,280 --> 00:12:53,700
...أتى اللاجئان من هناك أيضاً -
في تلك الحالة، لمَ تركناه بحاله حتّى الآن؟ -

156
00:12:53,700 --> 00:12:57,420
تعتمد هذه المدينة على المانا
التي يوفّرها العمود

157
00:12:57,420 --> 00:13:00,000
لم نستطع تدميره

158
00:13:00,000 --> 00:13:03,010
ولم نملك سبيلاً لإيقافه أيضاً

159
00:13:03,010 --> 00:13:08,140
كانت تقنية الإمبراطوريّة
تفوق تقنيتنا بكثير

160
00:13:08,140 --> 00:13:11,850
لكنّنا تمكّنا من تطوير هذا أخيراً

161
00:13:19,350 --> 00:13:22,520
هذا هو المفتاح الذي يتحكّم بالعمود

162
00:13:22,520 --> 00:13:26,400
بعدما ندخله في جهاز التحكّم
،في الطابق العلويّ

163
00:13:26,400 --> 00:13:29,240
سنستطيع إيقاف المانا الصادرة من العمود

164
00:13:30,990 --> 00:13:32,580
...بامتلاكنا لهذا

165
00:13:32,580 --> 00:13:37,580
أجل، ستتعافى المنطقة المحيطة
بلونّ بشكلٍ طبيعيّ

166
00:13:37,580 --> 00:13:41,750
لكنّ الإمبراطوريّة بحاجةٍ لهذا المفتاح أيضاً

167
00:13:43,460 --> 00:13:48,800
كان غنيمةً حصلنا عليها من معركةٍ
سابقة، وقمنا بتعديلها

168
00:13:48,800 --> 00:13:54,390
،لمَ؟ إذا صنعته الإمبراطورية
فلمَ لا يصنعون مفتاحاً آخراً؟

169
00:13:54,390 --> 00:13:58,770
هنالك سببٌ لعدم تمكّنهم من ذلك

170
00:13:58,770 --> 00:14:00,270
سبب؟

171
00:14:02,940 --> 00:14:07,190
يستعمل معدناً خاصّاً لم يعد التنقيب
عنه ممكناً في الإمبراطوريّة

172
00:14:09,490 --> 00:14:12,780
أي لا يمكنهم صنع المزيد منه؟

173
00:14:14,240 --> 00:14:19,120
وذلك سبب عدم تعرّض هذه المدينة
للاستحواذ بعد على الأرجح

174
00:14:19,120 --> 00:14:25,210
قام الاتّحاد بكلّ ما يستطيع لإيقاف العمود

175
00:14:25,210 --> 00:14:28,090
أنهينا تحليلنا للمفتاح أخيراً

176
00:14:28,090 --> 00:14:32,680
لكن وصلت أنباء خططنا للإمبراطوريّة

177
00:14:32,680 --> 00:14:38,770
لكنّنا تعرّفنا في المقابل على خطّة
الإمبراطوريّة باستعادة المفتاح

178
00:14:38,770 --> 00:14:42,980
أي أنّ هذه المعركة حول
...من يتحكّم بالعمود

179
00:14:42,980 --> 00:14:47,030
أجل، سيصلون في أيّ لحظة

180
00:14:47,030 --> 00:14:49,280
علينا التوجّه للعمود فوراً

181
00:14:53,700 --> 00:14:56,450
المكان هادئ

182
00:14:59,660 --> 00:15:01,250
توخّوا الحذر

183
00:15:10,840 --> 00:15:12,340
أأنت من الإمبراطوريّة؟

184
00:15:14,590 --> 00:15:17,010
حواسٌ حادة كالمتوقّع

185
00:15:28,190 --> 00:15:29,900
!استعملا المصاعد العلويّة

186
00:15:33,740 --> 00:15:37,750
...أرسلوكِ أنتِ إذاً، لواء الذئب الأبيض للإمبراطوريّة

187
00:15:37,750 --> 00:15:40,290
!أليكسندرا فون سونّي

188
00:15:48,210 --> 00:15:50,130
يوجد آخر

189
00:15:50,130 --> 00:15:51,470
!لن أدعك

190
00:15:54,050 --> 00:15:55,890
!لن تمرّ

191
00:16:04,020 --> 00:16:06,480
!انتظري يا سيليا

192
00:16:06,480 --> 00:16:07,900
لا تطلقي

193
00:16:23,540 --> 00:16:25,000
...هيوغو

194
00:16:26,710 --> 00:16:28,960
مضى وقتٌ طويل

195
00:16:28,960 --> 00:16:31,250
يا ليو، وسيليا

196
00:16:34,220 --> 00:16:37,390
سنستعيد العمود من الاتّحاد

197
00:16:37,390 --> 00:16:40,470
...هيوغو، أنت

198
00:16:40,470 --> 00:16:44,020
...لمَ تتردّد؟ أنا الآن

199
00:16:44,020 --> 00:16:45,850
!عدوّكما

200
00:16:47,770 --> 00:16:50,320
!ليو! ركّز

201
00:16:50,320 --> 00:16:52,110
ما الذي ستفعلونه بالعمود؟

202
00:16:52,110 --> 00:16:56,150
!هذا سؤالي أنا، لن أسمح لكم بإيقافه

203
00:16:58,490 --> 00:17:00,660
!يُفسد العمود الأرض

204
00:17:00,660 --> 00:17:04,370
!ليس سبباً لتدمير حياة المواطنين

205
00:17:08,920 --> 00:17:10,090
سريعة

206
00:17:19,470 --> 00:17:22,850
أنتِ الوميض الفضّي كما يُقال عنك

207
00:17:27,850 --> 00:17:30,360
سيليا-سان، هذه فرصتي للذهاب للمصعد

208
00:17:30,360 --> 00:17:31,730
غطّي عليّ رجاءً

209
00:17:31,730 --> 00:17:33,190
...لحظة

210
00:18:01,260 --> 00:18:02,970
!هيوغو! المصعد

211
00:18:11,690 --> 00:18:13,900
!هذا سيّئ! أرفير

212
00:18:13,900 --> 00:18:16,400
...يا ضوء الحكمة

213
00:18:16,400 --> 00:18:18,070
!فلتنر دربي

214
00:18:28,250 --> 00:18:30,080
تمّ الاستحواذ على الهدف

215
00:18:30,080 --> 00:18:31,330
لننسحب

216
00:18:44,350 --> 00:18:45,890
!نيكولا-سان

217
00:18:57,480 --> 00:19:00,780
!انتظر! هيوغو

218
00:19:00,780 --> 00:19:02,780
!هيوغو

219
00:19:08,120 --> 00:19:09,620
!هيوغو

220
00:19:09,620 --> 00:19:12,540
سأذهب لاستعادة الأسلحة

221
00:19:16,750 --> 00:19:18,840
...سأرجع للبيت

222
00:19:18,840 --> 00:19:20,220
...البيت

223
00:19:21,880 --> 00:19:27,100
!سأرجع للبيت

224
00:19:36,400 --> 00:19:38,110
أأنت بخيرٍ يا هيوغو؟

225
00:19:40,780 --> 00:19:44,030
هل ما نقوم به هو الأمر الصائب؟

226
00:19:46,070 --> 00:19:52,870
لا أدري ما هو صحيح، وما هي العدالة

227
00:19:54,880 --> 00:19:56,590
...لكن حالياً

228
00:19:58,050 --> 00:20:03,130
العدالة بالنسبة لي هي حماية الأعزّاء عليّ

229
00:20:24,400 --> 00:20:27,280
يبدو أنّ ما يثقلك ليس الإعياء فحسب

230
00:20:29,620 --> 00:20:32,000
...آسف، أنا

231
00:20:34,460 --> 00:20:38,380
تلاحمت بالسيف مع صديق، لا ألومك

232
00:20:59,770 --> 00:21:02,570
يُفترض أن يُوازن هذا العمود

233
00:21:03,860 --> 00:21:06,860
أيمكنك قتالهم بجدّ؟

234
00:21:09,530 --> 00:21:12,950
قالت المعلّمة أنّ علينا البقاء حذرين

235
00:21:16,580 --> 00:21:22,340
أيمكنك دفع نفسك لقتال هيوغو يا ليو؟

236
00:21:25,800 --> 00:21:28,930
هذه هي المهمّة

237
00:21:28,930 --> 00:21:33,350
يمكنني، فأنا من أهل الإمبراطوريّة

238
00:21:33,350 --> 00:21:36,850
أنت تجيد قمع مشاعرك

239
00:21:36,850 --> 00:21:39,440
هذه مهارةٌ مناسبة للجنديّ

240
00:21:39,440 --> 00:21:41,940
لكنّها ليست طريقةً للعيش

241
00:21:44,110 --> 00:21:47,280
أأنتِ قلقةٌ عليّ؟

242
00:21:47,280 --> 00:21:53,160
أنت تابعي وحليفي الآن

243
00:21:53,160 --> 00:21:55,040
شكراً لك

244
00:21:56,790 --> 00:21:58,960
...أمرنا آوغوست

245
00:21:58,960 --> 00:22:04,380
أقصد أمرنا جلالة المستشار بمواصلة الخطّة

246
00:22:05,670 --> 00:22:07,220
أأنت مستعدّ؟

247
00:22:07,220 --> 00:22:08,680
أجل

248
00:22:08,680 --> 00:22:12,890
ذاك الشيء الوحيد الذي أملكه الآن

249
00:22:24,360 --> 00:22:27,070
!غطاء دخاني! كونوا حذرين

250
00:22:34,620 --> 00:22:36,210
أتوا بالفعل

251
00:22:36,450 --> 00:22:38,620
!أرفير، ابحثي في الأعلى

252
00:22:42,380 --> 00:22:43,630
أين؟

253
00:22:46,670 --> 00:22:48,170
أين؟

254
00:22:52,220 --> 00:22:53,430
!ها هو

255
00:22:57,560 --> 00:23:02,310
لا يمكن... يستحيل أن يقفز لتلك
المسافة، ولو استعمل إمبليو

256
00:23:14,240 --> 00:23:15,740
!هيوغو

257
00:23:15,740 --> 00:23:18,750
!فلتضئ أيّها الإمبليو خاصّتي

258
00:23:21,790 --> 00:23:24,330
متى تعلّم تلك التقنية؟

259
00:23:29,590 --> 00:23:32,380
كشفتِ تضليلنا

260
00:23:32,380 --> 00:23:35,720
كنتِ أكبر عقباتنا كما توقّعت

261
00:23:36,470 --> 00:23:40,980
يشرّفني سماع ذلك من لواء
الذئب الأبيض نفسها

262
00:23:42,270 --> 00:23:47,440
،لكن طالما نبقيك على منأى
فلا خطر آخر نخشاه في هذه المدينة

263
00:23:48,190 --> 00:23:52,610
أشكّ في ذلك، فتلميذاي مُشرّفان

264
00:23:52,610 --> 00:23:56,950
حسناً، لنتقاتل بجدّيةٍ الآن

265
00:23:56,950 --> 00:24:03,290
أجل، أيّتها الخصمة الجديرة، أتحدّاكِ لنزال

266
00:24:09,840 --> 00:24:11,920
كما قالت معلّمتي

267
00:24:14,390 --> 00:24:16,260
...المعلّمة

268
00:24:17,600 --> 00:24:19,810
!حراستكم متراخية جدّاً

269
00:24:19,810 --> 00:24:22,180
!يمكنني مواجهتك بنفسي

270
00:24:23,140 --> 00:24:26,560
مواجهتي؟ من الجليّ لي أنّك متردّد

271
00:24:26,560 --> 00:24:28,860
ماذا عنك إذاً؟

272
00:24:28,860 --> 00:24:30,690
!لا تردّد لديّ

273
00:24:30,690 --> 00:24:33,900
!عدالتي على هذا الدرب

274
00:24:34,950 --> 00:24:36,200
!انتظر

275
00:25:15,450 --> 00:25:17,490
...انتظر

276
00:25:17,490 --> 00:25:20,780
الآن، انتصرت الإمبراطوريّة

277
00:25:47,600 --> 00:25:49,900
ما الذي يجري؟

278
00:26:25,220 --> 00:26:29,060
كان هذا هدفك الحقيقيّ إذاً
يا آوغوست

279
00:27:04,930 --> 00:27:08,060
بلاءٌ حسن يا هيوغو-كن

280
00:27:09,180 --> 00:27:13,650
سنستعيد لونّ الآن

281
00:27:24,830 --> 00:27:26,910
ما هذا؟

282
00:27:26,910 --> 00:27:30,290
...إنّهم

283
00:27:30,290 --> 00:27:32,750
!هيوغو

284
00:27:32,750 --> 00:27:39,090
!هل قمت... هل قامت الإمبراطوريّة بهذا؟

285
00:27:40,090 --> 00:27:42,760
!أين العدالة في هذا؟

286
00:27:44,590 --> 00:27:47,970
!فلتجبني يا هيوغو