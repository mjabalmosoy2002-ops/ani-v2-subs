1
00:00:00,460 --> 00:00:04,000
...لقد بقيت يتيماً بعد ذلك الحادث قبل سنتين

2
00:00:04,000 --> 00:00:06,380
.صحيح أنّ فايت من تسبّب به

3
00:00:04,010 --> 00:00:06,010
لمزيد من الأنميات زورونا على مدونتنا

4
00:00:06,920 --> 00:00:10,960
.لكن لم يكن والداك من ماتا ذلك اليوم

5
00:00:12,670 --> 00:00:14,130
!مهلاً لحظة

6
00:00:14,130 --> 00:00:16,250
!ذلك يعني أنّ والديّ على قيد الحياة

7
00:00:16,250 --> 00:00:17,880
!أخشى أنّهما ليسا كذلك

8
00:00:17,880 --> 00:00:19,290
.أصغي توتا

9
00:00:19,960 --> 00:00:23,040
.أنت لم تولد كبقيّة البشر

10
00:00:24,580 --> 00:00:31,630
.لقد خلقت قبل سنتين باستخدام المعلومات الوراثيّة لنيغي سبرينغفيلد

11
00:00:32,830 --> 00:00:33,960
.إنّك مستنسخ

12
00:00:35,290 --> 00:00:37,710
مستنسخ؟ هل أنت جادّ؟

13
00:00:37,830 --> 00:00:40,960
.أجل، ذلك ما قالته يوكيهيمي

14
00:00:41,210 --> 00:00:45,080
.اعتقدت أنّ ذكرياتي عن عائلتي ممّا قبل الحادث قد اختفت، لكن

15
00:00:45,500 --> 00:00:46,920
.لم يكن ذلك صحيحاً

16
00:00:46,920 --> 00:00:49,380
.لم تكنّ لديّ ذكرياتٌ من البداية

17
00:00:49,380 --> 00:00:53,330
!لكنّك ما تزال أنت توتا كن

18
00:00:54,040 --> 00:00:55,460
.أجل أظنّ ذلك

19
00:00:55,670 --> 00:00:56,830
.شكراً لك

20
00:00:57,080 --> 00:00:58,790
...أ.أجل

21
00:00:58,790 --> 00:01:01,750
.لكنّي ما زلت أشعر بالإحباط من ذلك

22
00:01:02,080 --> 00:01:06,500
.وهنالك فوق ذلك حقيقة أنّ يوكيهيمي تحبّ جدّي

23
00:01:07,130 --> 00:01:16,380
.لا يسعني سوى التّفكير أنّ يوكيهيمي اعتنت بي لأنّها أحسّت بالواجب تجاهه

24
00:01:17,250 --> 00:01:19,670
!تمهّلي! لا يمكنك فعل هذا

25
00:01:19,670 --> 00:01:22,210
!لا يزال فايت يستهدفه

26
00:01:22,210 --> 00:01:23,670
!وماذا في ذلك إذن؟

27
00:01:23,670 --> 00:01:27,330
!سأحميه بنفسي حتّى لو هاجمته عصابةٌ من الأوغاد

28
00:01:27,330 --> 00:01:29,630
...ذلك مضحكٌ جدّاً

29
00:01:29,630 --> 00:01:30,750
!مهلاً! توقّفي

30
00:01:31,250 --> 00:01:32,420
!توتا ساما

31
00:01:32,420 --> 00:01:34,830
!لمَ تحبس نفسك بهذا الشكل؟

32
00:01:34,830 --> 00:01:36,000
!لنذهب

33
00:01:36,170 --> 00:01:38,000
ماذا؟ إلى أين سنذهب؟

34
00:01:38,460 --> 00:01:39,540
...بالطبع

35
00:01:39,540 --> 00:01:41,500
!إلى بطولة ماهورا لفنون القتال

36
00:01:42,170 --> 00:01:44,750
بطولة ماهورا لفنون القتال؟

37
00:03:15,040 --> 00:03:18,790
"مرحباً بكم في أكاديميّة ماهورا"

38
00:03:16,170 --> 00:03:17,290
.فهمت

39
00:03:17,290 --> 00:03:19,420
.أخبرت توتا كن إذن

40
00:03:19,790 --> 00:03:24,250
...أردت أن أكون من يخبره، لكنّي

41
00:03:24,710 --> 00:03:26,880
.أتساءل إن كان هذا الخيار الصحيح

42
00:03:26,880 --> 00:03:28,710
ما زلت غير واثقة

43
00:03:32,170 --> 00:03:34,670
!مذهل! هناك أناسٌ في كلّ مكان

44
00:03:35,250 --> 00:03:37,580
!يبدو هؤلاء الأشخاص أقوياء

45
00:03:37,580 --> 00:03:39,540
!هل هم المتنافسون؟

46
00:03:39,540 --> 00:03:40,630
.هذا صحيح

47
00:03:41,250 --> 00:03:43,670
.هذه هي بطولة ماهورا لفنون القتال إذن

48
00:03:51,380 --> 00:03:55,540
.هناك شتّى أنواع النّاس من مدارس مختلفة في القتال، السّحر والفنون السّوداء

49
00:03:55,540 --> 00:04:00,330
!كلّهم سيشارك في هذه البطولة الأولى من نوعها تاريخيّاً

50
00:04:01,080 --> 00:04:02,380
!ماذا؟ حقّاً؟

51
00:04:02,380 --> 00:04:06,710
.أجل، ستجري البطولة الرئيسيّة في أمانو ميهاشيرا

52
00:04:07,000 --> 00:04:10,670
!ويقال أنّ النهائيّات ستجري على قمّة البرج

53
00:04:10,670 --> 00:04:11,750
!لا يصدّق

54
00:04:11,750 --> 00:04:14,170
أيعني هذا أنّ بإمكاني المشاركة أيضاً؟

55
00:04:14,170 --> 00:04:15,750
!حتّى لو لم أكن بشريّاً؟

56
00:04:16,000 --> 00:04:17,290
!بالطّبع

57
00:04:17,460 --> 00:04:21,880
.عليك دخول الأدوار التمهيديّة والفوز فحسب، لا يهمّ إذ ما كنت خالداً

58
00:04:22,130 --> 00:04:27,710
.فمهمن يكن من يفوز بالحدث التمهيدي فسينتقل تلقائيّاً للبطولة الرّئيسيّة

59
00:04:28,290 --> 00:04:29,630
!سأشترك إذن

60
00:04:29,960 --> 00:04:31,790
!أين هو مكتب التّسجيل؟

61
00:04:32,290 --> 00:04:34,000
!تمهّل توتا ساما

62
00:04:35,460 --> 00:04:36,710
...مذهل

63
00:04:36,710 --> 00:04:40,000
.كان توتا كن مكتئباً جدّاً قبل قليل لكنّ قد عاد لطبيعته الآن

64
00:04:41,500 --> 00:04:43,960
!ذلك الأبله العاجز سهل الانقياد تماماً

65
00:04:44,710 --> 00:04:47,880
مهلاً، أكان يشعر بالاكتئاب؟ لمَ؟

66
00:04:48,710 --> 00:04:50,710
...حسناً

67
00:04:51,210 --> 00:04:54,210
.إنّه سرٌّ بين الرّجال

68
00:04:55,000 --> 00:04:57,500
!ليس هذا ما ينطق به وجهك

69
00:04:57,500 --> 00:04:58,330
!تمهّلي
!ليس هذا ما ينطق به وجهك

70
00:04:58,330 --> 00:05:01,420
!ما هو! أخبرني

71
00:05:01,420 --> 00:05:04,540
!لا يمكنني، لا يمكنني إخبارك به أبداً

72
00:05:05,170 --> 00:05:07,380
ماذا؟ لا يمكنني التسجيل؟

73
00:05:07,380 --> 00:05:10,790
.تمّ اختيار جميع المتسابقين سلفاً

74
00:05:11,380 --> 00:05:14,130
.لربّما نقدر على القيام بشيء إن لم يحضر شخصٌ ما

75
00:05:14,790 --> 00:05:16,290
...هكذا إذن

76
00:05:17,170 --> 00:05:19,170
.شكراً لك على أيّة حال

77
00:05:20,130 --> 00:05:21,790
.ذلك مؤسف

78
00:05:21,790 --> 00:05:25,330
.وددت لو أمكنني فعل شيء للمساعدة

79
00:05:26,170 --> 00:05:28,080
.أجل، لا باس بذلك

80
00:05:28,670 --> 00:05:32,920
.حسناً، يمكنني على الاقلّ المشاركة في اختيارات حدث العام القادم

81
00:05:32,920 --> 00:05:35,330
!سيمنحني ذلك الوقت لأصبح أقوى

82
00:05:35,330 --> 00:05:36,790
!تلك هي الرّوح

83
00:05:37,330 --> 00:05:40,080
!لذا أنت خطيبي

84
00:05:40,080 --> 00:05:42,630
.لا، لقد أشرت سابقاً لعدم موافقتي على ذلك

85
00:05:43,380 --> 00:05:44,580
.هكذا إذن

86
00:05:44,580 --> 00:05:47,420
.إذن فانت مفتونة بالفعل ميزوري

87
00:05:48,000 --> 00:05:49,420
!جدّتي الكبرى

88
00:05:48,000 --> 00:05:49,420
!والدة جدّتها

89
00:05:49,420 --> 00:05:51,420
ماذا؟ والدة جدّة ميزوري؟

90
00:05:51,960 --> 00:05:54,670
.تشرّفنا توتا كن

91
00:05:54,670 --> 00:05:58,210
.إنّني يوكيهيرو أياكا

92
00:05:59,080 --> 00:06:00,830
.وهذه تشاتشامارو

93
00:06:01,250 --> 00:06:02,920
.إنّني كاراكوري تشاتشامارو

94
00:06:03,420 --> 00:06:07,330
.وهذه صديقة قديمة أخي لي

95
00:06:07,330 --> 00:06:10,420
.إنّها مديرة بطولة الفنون القتاليّة هذه

96
00:06:10,920 --> 00:06:12,460
.أنا تاتسوميا مانا

97
00:06:12,830 --> 00:06:15,460
.إنّني مديرة هذه الأكاديميّة أيضاً

98
00:06:15,630 --> 00:06:18,830
أكاديميّة؟ أهذه مدرسة؟

99
00:06:20,290 --> 00:06:23,710
.لديك في الواقع صلةٌ بسيطة بهذا المكان

100
00:06:24,880 --> 00:06:31,290
.كان جدّك نيغي سبرينغفيلد ذات يومٍ مدرّساً هنا قبل ثمانين عاماً مضت

101
00:06:31,630 --> 00:06:34,130
.وكنا نحن طالباته

102
00:06:35,330 --> 00:06:36,750
.إذن هنا حيث درّس

103
00:06:37,040 --> 00:06:40,670
.ميزوري، سأسرق منك توتا كن لبعض الوقت

104
00:06:40,670 --> 00:06:42,630
.لدينا شيء مهمّ لنناقشه به

105
00:06:42,960 --> 00:06:44,170
ماذا؟

106
00:06:49,710 --> 00:06:51,630
.أظنّ أنّي بمفردي اليوم

107
00:06:52,080 --> 00:06:55,040
...خرجت ميزوري سان والبقيّة رفقة توتا سينباي

108
00:06:55,540 --> 00:06:56,880
...يا لحظّهم

109
00:06:56,880 --> 00:06:58,790
إلى أين أنتِ ذاهبة يوكيهيمي ساما؟

110
00:06:58,960 --> 00:07:00,710
.إلى العاصمة فحسب

111
00:07:01,080 --> 00:07:05,080
.يبدو أنّ بعض صديقاتي القدامى يجتمعن سويّةً لذا فكّرت أن أفاجئهنّ أيضاً

112
00:07:05,250 --> 00:07:08,130
.إذن سأرافقك إلى هناك أيضاً

113
00:07:08,750 --> 00:07:10,170
.ليس عليك فعل ذلك حقّاً

114
00:07:10,460 --> 00:07:12,790
.كونوي توتا ليس هنا اليوم

115
00:07:12,790 --> 00:07:16,000
.لقد مضت فترة مذ أن حظينا بوقتٍ خاصٍّ حميمٍ سويّةً

116
00:07:16,170 --> 00:07:18,790
....رغم أنّنا لم نقم بشيء كهذا أبداً

117
00:07:20,710 --> 00:07:22,920
...الجميع ذاهب إلى العاصمة

118
00:07:23,420 --> 00:07:25,380
.أعتقد أنّني سأذهب أيضاً

119
00:07:31,080 --> 00:07:34,290
.هذه كانت قاعة تدريس جدّي

120
00:07:34,670 --> 00:07:39,880
.انتقل نيغي سينسي إلى هذه المدرسة عندما كان في العاشرة من عمره

121
00:07:39,880 --> 00:07:41,250
!في العاشرة فقط؟

122
00:07:41,630 --> 00:07:43,920
.دعوناه كلّنا بالأستاذ الطفل

123
00:07:44,130 --> 00:07:47,880
.رغم ذلك عمل جاهداً لكسب اعترافنا جميعاً

124
00:07:49,250 --> 00:07:53,330
...أ..أنا....سأكون الساحر الجديد

125
00:07:53,330 --> 00:07:55,790
.معلّمكم الجديد للإنجليزيّة

126
00:07:55,790 --> 00:07:57,380
.أدعى نيغي سبرينغفيلد

127
00:07:58,460 --> 00:08:00,130
!سررت بلقائكنّ

128
00:08:02,960 --> 00:08:05,080
!إذن فأنت حفيد نيغي سينسي

129
00:08:05,080 --> 00:08:06,040
...أجل

130
00:08:06,040 --> 00:08:08,920
...أنا آسفة

131
00:08:08,920 --> 00:08:10,830
.لم أقصد إخافتك

132
00:08:10,830 --> 00:08:13,380
.هذه آيساكا سايو سان

133
00:08:13,380 --> 00:08:15,210
.كانت إحدى زميلاتنا أيضاً

134
00:08:15,380 --> 00:08:17,000
.أدعى آيساكا سايو

135
00:08:17,000 --> 00:08:19,750
!إنّني سعيدة بلقاء حفيد سينسي

136
00:08:19,750 --> 00:08:21,790
.أجل، وأنا أيضاً

137
00:08:22,460 --> 00:08:24,500
.يمكنني أن أرَ من خلال ساقيها

138
00:08:24,500 --> 00:08:27,290
.أظنّ أنّها ما يدعى بالشبح أو شيئاً كهذا

139
00:08:29,380 --> 00:08:31,330
!لا أصدّق أنّها سرقت توتا ساما

140
00:08:31,330 --> 00:08:34,540
!لربّما تكون والدة جدّتي لكنّ ذلك قاسٍ جدّاً

141
00:08:35,040 --> 00:08:36,290
!ميزوري تشان! لقد وجدناكي

142
00:08:36,710 --> 00:08:40,750
.ماذا؟ كنتما هنا أيضاً

143
00:08:40,750 --> 00:08:43,080
!ما كان ذلك التصرّف بالاختفاء؟

144
00:08:43,080 --> 00:08:46,080
.كنّا قلقين من أن تقومي بفعل أمرٍ شاذٍّ مع توتا كن

145
00:08:46,080 --> 00:08:47,540
أمر شاذّ؟

146
00:08:48,290 --> 00:08:50,670
...لا يعقل...أنّ والدة جدّتي

147
00:08:50,670 --> 00:08:54,710
!أيعقل أن تلبّي نزواتها لجدّ توتا ساما الآن؟

148
00:08:55,040 --> 00:08:56,670
!لا

149
00:08:56,670 --> 00:08:58,710
!ماذا؟ ما الذي يجري؟

150
00:08:59,080 --> 00:09:04,670
.لا أصدّق أنّ ثمانين عاماً قد مضت وأنّي أقابل الآن حفيد نيغي سينسي

151
00:09:04,920 --> 00:09:07,420
!إنّني محظوظةٌ لأنّي عشت حياةً طويلة

152
00:09:10,130 --> 00:09:12,040
.إنّه لغريب جدّاً

153
00:09:12,040 --> 00:09:15,710
....شعرك وبشرتك مختلفان عن نيغي سينسي

154
00:09:15,710 --> 00:09:18,170
.كما وانّك نشيط وصعب المراس

155
00:09:18,170 --> 00:09:20,170
.إنّك نقيضه تماماً

156
00:09:20,630 --> 00:09:25,000
.لكنّ التصميم الذي في عينيك مشابه له تماماً

157
00:09:26,250 --> 00:09:28,290
....لكن، حسناً

158
00:09:28,290 --> 00:09:30,210
...إنني في الواقع

159
00:09:30,210 --> 00:09:34,290
....لست الحفيد الحقيقيّ  لجدّي رغم ذلك

160
00:09:34,670 --> 00:09:38,130
حقّاً، أيزعجك أنّك مستنسَخه؟

161
00:09:38,790 --> 00:09:41,130
.هذا الأمر لا يهمّ على الإطلاق

162
00:09:41,330 --> 00:09:42,380
.صحيح

163
00:09:42,380 --> 00:09:49,670
.لو كان نيغي سينسي هنا لأصرّ بسعادة أنّك حفيده

164
00:09:49,670 --> 00:09:53,130
...أجل، إن كان أمراً يخصّ نيغي سينسي فإنّنا جميعاً ندرك هذا

165
00:09:53,330 --> 00:09:55,210
أتظنّنَ هذا حقّاً؟

166
00:09:55,420 --> 00:10:00,750
.يبدو أنّ لديكنّ جميعاً إيماناً كبيراً به

167
00:10:00,750 --> 00:10:02,460
.لقد كان محبوباً جدّاً

168
00:10:02,460 --> 00:10:03,580
.أجل

169
00:10:03,790 --> 00:10:05,630
.ويجدر بك أن تكون فخوراً

170
00:10:06,250 --> 00:10:09,500
.وأنت من نال إرثه ووصيّته

171
00:10:10,420 --> 00:10:13,580
...ذلك لأنّك حفيد نيغي سينسي

172
00:10:15,960 --> 00:10:19,330
!لأنّك كالحفيد لنا جميعاً.....

173
00:10:19,540 --> 00:10:21,670
!هذا ليس عدلاً يا ممثّلة الفصل

174
00:10:21,960 --> 00:10:24,710
!إنّ قلبي يخفق كما عندما كنت شابّة

175
00:10:26,880 --> 00:10:29,670
.ستؤذين نفسك سيّدتي

176
00:10:29,670 --> 00:10:31,130
.سأقوم بذلك نيابةً عنك

177
00:10:31,290 --> 00:10:34,710
.أنا آسفة جدّاً، لقد استرسلت بالأمر تماماً

178
00:10:34,710 --> 00:10:36,170
.ل_لا بأس

179
00:10:36,170 --> 00:10:37,710
.إذن أنا أيضاً

180
00:10:38,330 --> 00:10:40,710
!مهلاً تشاتشامارو سان، هذا ليس عدلاً

181
00:10:42,210 --> 00:10:43,750
!لم يتغيّر شيء حقّاً

182
00:10:46,290 --> 00:10:48,000
إنّها أنا، ماذا هناك؟

183
00:10:48,580 --> 00:10:50,250
ماذا؟ أصيب؟

184
00:10:50,710 --> 00:10:52,830
!ما من وقت كافٍ حتّى بدء البطولة الآن

185
00:10:53,420 --> 00:10:55,880
كم من بديل لدينا؟

186
00:10:57,290 --> 00:11:00,920
