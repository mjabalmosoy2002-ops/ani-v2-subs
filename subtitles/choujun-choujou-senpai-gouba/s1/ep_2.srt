00:08:05,290 --> 00:08:08,300
نعم. إنّها قدرة أحتاج لاستخدامها
.على شخص ما

159
00:08:08,800 --> 00:08:10,170
.التّنويم المغناطيسيّ

160
00:08:08,930 --> 00:08:10,180
"التّنويم المغناطيسيّ"

161
00:08:10,170 --> 00:08:11,920
التّنويم المغناطيسيّ؟

162
00:08:11,920 --> 00:08:14,150
وكيف سيساعد ذلك في العثور على قطّ؟

163
00:08:14,150 --> 00:08:16,930
أليس ذلك مخصّصًا لتنويم
النّاس أو شلّ حركتهم؟

164
00:08:16,930 --> 00:08:18,560
.دعاني أوضّح لكما الأمر أيّتها الهاويتين

165
00:08:18,560 --> 00:08:21,020
جوهر التّنويم المغناطيسيّ
.يكمن في الإيحاء

166
00:08:21,020 --> 00:08:23,310
أنت ببساطة تعزّز اعتقادًا راسخًا
.في العقل الباطن

167
00:08:23,310 --> 00:08:26,400
"التّنويم المغناطيسيّ"

168
00:08:23,700 --> 00:08:27,070
يمكنك جعل شخص ما يعتقد
.أنّ الماء يغلي بشدّة وأنّه سيحرقه

169
00:08:26,400 --> 00:08:27,070
"!ساخن"

170
00:08:27,070 --> 00:08:30,320
أو تنويمه مغناطيسيًّا لدفعه إلى إظهار
.مستويات قوّة تفوق القدرات البشريّة

171
00:08:30,320 --> 00:08:34,150
إنّها تمتلك القدرة على توليد
.طاقة تتحدّى قوانين الفيزياء

172
00:08:35,320 --> 00:08:38,200
من المفترض أن يكون
.ما أرمي إليه واضحًا الآن

173
00:08:39,460 --> 00:08:41,200
...إيبّونغي، أنت

174
00:08:41,200 --> 00:08:42,770
.ستكونين نعناعًا برّيًّا

175
00:08:42,770 --> 00:08:45,080
."لا شيء ممّا قلته للتّوّ "واضح

176
00:08:45,080 --> 00:08:47,330
!فسّر! أطالب بتفسير

177
00:08:47,330 --> 00:08:50,090
"نعناع برّيّ"

178
00:08:47,330 --> 00:08:50,090
النّعناع البرّيّ؟ تقصد تلك النّبتة
الّتي تحبّها القطط؟

179
00:08:50,090 --> 00:08:56,220
.الفكرة هي إقناعك بأنّك نعناع برّيّ

180
00:08:50,090 --> 00:08:51,720
"مرح وعلوم مع البروفيسور الشّرطيّ ذو القدرات الذّهنيّة"

181
00:08:51,720 --> 00:08:57,850
"رائحة نعناع برّيّ"

182
00:08:56,220 --> 00:08:57,850
.أنا نعناع برّيّ

183
00:08:57,850 --> 00:09:02,100
،مع وجود إيحاء قويّ بما يكفي
.ستفوح منك حتّى رائحة النّعناع البرّيّ

184
00:09:02,480 --> 00:09:05,950
سيحوّلك هذا إلى نقطةِ تجمّع
.للقطط الّتي تجذبها الرّائحة

185
00:09:05,950 --> 00:09:08,730
سنتمكّن من الإمساك بالقطّ
.دون أيّ جهد إضافيّ

186
00:09:08,730 --> 00:09:09,750
.باختصار

187
00:09:09,750 --> 00:09:11,480
.مفهوم. ابدأ

188
00:09:11,480 --> 00:09:13,490
هل كان ذلك كافيًا لإقناعك؟

189
00:09:13,490 --> 00:09:17,360
.حسنًا. ركّزي على هذا اليويو فائق النّشاط

190
00:09:17,360 --> 00:09:20,090
.إنّك تصيرين كنعناع برّيّ أكثر فأكثر

191
00:09:20,090 --> 00:09:21,990
.صيري نعناعًا برّيًّا

192
00:09:21,990 --> 00:09:26,250
.أكثر. وأكثر. وأكثر

193
00:09:27,200 --> 00:09:30,280
هل... نجح الأمر؟
هل وقعت تحت تأثير التّنويم؟

194
00:09:30,280 --> 00:09:32,380
نعم. أخبريني، ما اسمك؟

195
00:09:32,380 --> 00:09:34,380
.أنا نعناع برّيّ

196
00:09:32,880 --> 00:09:34,380
"شرطيّة النّعناع البرّيّ: إيبّونغي ناو"

197
00:09:34,380 --> 00:09:35,170
.جيّد

198
00:09:35,170 --> 00:09:37,230
لا يمكن أن يكون الأمر بهذه البساطة، صحيح؟

199
00:09:37,230 --> 00:09:38,960
هل أنت متأكّد أنّ الأمر ينجح حقًّا؟

200
00:09:38,960 --> 00:09:40,850
.لا داعي للقلق بشأن ذلك

201
00:09:40,850 --> 00:09:45,650
مع أمثالها من الحمقى، أخشى أن يكون
.تأثير التّنويم المغناطيسيّ قويًّا للغاية

202
00:09:45,650 --> 00:09:46,770
.أنا نعناع برّيّ

203
00:09:47,890 --> 00:09:50,530
وكيف يمكن لـ"قويّ للغاية" أن يكون مشكلة؟

204
00:09:50,530 --> 00:09:55,150
،إذا كانت التّأثيرات قويّة للغاية
...فالنّتائج تميل أيضًا إلى أن تكون

205
00:09:57,850 --> 00:09:59,160
!نعم، يبدو الأمر قويًّا جدًّا

206
00:09:59,160 --> 00:10:00,630
.نحن محاصرون

207
00:10:00,630 --> 00:10:03,490
.إ-إنّها هائجة للغاية. قد تمزّقنا إربًا

208
00:10:03,490 --> 00:10:06,040
أيّتها الحمقاء! رائحتك تشبه
!النّعناع البرّيّ أكثر من اللاّزم

209
00:10:06,040 --> 00:10:06,880
.أنا نعناع برّيّ

210
00:10:06,880 --> 00:10:09,130
!استيقظي! اعتقدتُ أنّك غوريلاّ

211
00:10:09,130 --> 00:10:09,880
.أنا نعناع برّيّ

212
00:10:09,880 --> 00:10:11,250
!ا-انظر هناك

213
00:10:11,760 --> 00:10:13,750
!ذلك الطّوق. إنّه كوروسكي

214
00:10:13,750 --> 00:10:17,760
،لم أكن أتوقّع كلّ هذا
.لكن علينا مجاراة الوضع

215
00:10:18,170 --> 00:10:20,890
.لا يبدو أنّها ستفيق من غشيتها قريبًا

216
00:10:20,890 --> 00:10:23,700
.علينا صدّ حشد القطط والإمساك بكوروسكي

217
00:10:23,700 --> 00:10:24,770
كيف؟

218
00:10:24,770 --> 00:10:28,020
...تذكّري دائمًا: في مثل هذه الأوقات

219
00:10:28,020 --> 00:10:30,360
!تبذل الشّرطة قصارى جهدها

220
00:10:30,360 --> 00:10:32,480
لا شيء في هذا المشهد يبدو
.وكأنّه عمل لرجال الشّرطة

221
00:10:32,480 --> 00:10:35,220
تُصاب القطط بالنّشوة
.بمجرّد شمّ رائحة النّعناع البرّيّ

222
00:10:35,220 --> 00:10:39,630
يمكنني تدويرها هكذا لنشر الرّائحة
—والدّفاع عن نفسي أيضًا من

223
00:10:39,630 --> 00:10:40,360
!أيّها الشّرطي ذو القدرات

224
00:10:40,360 --> 00:10:41,660
.هذا ليس جيّدًا

225
00:10:41,660 --> 00:10:45,660
الخيار الأفضل هو استخدام رائحة
،النّعناع البرّيّ القويّة لتحييد القطط

226
00:10:45,660 --> 00:10:47,600
.لكن ما تُصدره شرطونغي ليس كافيًا

227
00:10:46,080 --> 00:10:48,210
من النّاحية المثاليّة، يمكنك استخدام رائحة"
"النّعناع البرّيّ لتحييد القطط

228
00:10:47,600 --> 00:10:49,750
،كلّما طال هذا الوضع
!ازداد سوءًا بالنّسبة لنا

229
00:10:48,210 --> 00:10:50,050
"،لكنّ شرطونغي وحدها لا تملك القدرة الكافية"

230
00:10:49,750 --> 00:10:52,380
بدا الأمر وكأنّه مقتبس مباشرة
.من دليل استراتيجيّ

231
00:10:50,050 --> 00:10:52,380
".وكلّما طال الأمر، زاد موقفك سوءًا"

232
00:10:52,380 --> 00:10:57,090
.ليت لدينا مصدرًا آخر للنّعناع البرّيّ
.شخصٌ يصلح تمامًا للتّنويم المغناطيسيّ

233
00:10:57,090 --> 00:11:00,270
شخص بسيط التّفكير وسريع
.الانفعال مثل شرطونغي

234
00:11:00,270 --> 00:11:02,760
!مرحبًا يا سيّد القدرات الذّهنيّة

235
00:11:03,120 --> 00:11:05,530
.لا أصدّق أنّك تركتني وحدي وأنا مخمور

236
00:11:05,530 --> 00:11:08,890
،إذا متُّ من الوحدة
.فستكون أنت المسؤول

237
00:11:08,890 --> 00:11:13,400
إنّها تلك الغيارو. أعتذر عن
.إزعاجي لكِ قبل قليل

238
00:11:13,760 --> 00:11:15,680
...لطالما قيل لي

239
00:11:15,680 --> 00:11:18,650
.أنّني أتحمّس كثيرًا وبسرعة

240
00:11:19,530 --> 00:11:22,280
!والآن، أصبح لدينا ضِعف القوّة

241
00:11:19,530 --> 00:11:22,280
!أنا نعناع برّيّ

242
00:11:24,690 --> 00:11:27,040
حسنًا، أنا سعيدة لأنّ الأمور
.سارت على ما يرام

243
00:11:27,680 --> 00:11:32,320
بفضل مساعدتك كمصدر ثانٍ للنّعناع البرّيّ
.يا سيّد هو، تمكّنّا من تحييد القطط

244
00:11:32,320 --> 00:11:33,790
ماذا قلتِ؟

245
00:11:34,120 --> 00:11:37,220
.لم يكن هناك أيّ منطق فيما قلته للتّوّ

246
00:11:37,220 --> 00:11:38,900
.أنت تبدو كسكّيرٍ يهذي

247
00:11:38,900 --> 00:11:40,920
أليس تلك هي لغتك الأمّ؟

248
00:11:41,380 --> 00:11:43,680
.أنا سعيدة لأنّنا عثرنا على قطّك

249
00:11:44,990 --> 00:11:46,900
.أقترح أن نعود جميعًا الآن

250
00:11:48,740 --> 00:11:50,180
.عـ-عفوًا

251
00:11:50,180 --> 00:11:53,320
.بالمناسبة، قرأتُ أفكار ذلك القطّ قليلاً

252
00:11:54,190 --> 00:11:58,070
قفز ذلك القطّ إلى مؤخّرة شاحنة
.انطلقت به بعيدًا، فضلَّ طريقه

253
00:11:59,940 --> 00:12:03,360
.لكنّه لم يكن قلقًا للغاية

254
00:12:03,360 --> 00:12:06,700
.كان واثقًا بأنّك ستأتين لاستعادته

255
00:12:06,700 --> 00:12:08,580
.كان مرتاح البال بالكامل

256
00:12:10,280 --> 00:12:12,960
أنت تقرأ أفكار القطط أيضًا؟

257
00:12:12,960 --> 00:12:15,080
نعم. أمرٌ مقزّز، أليس كذلك؟

258
00:12:16,800 --> 00:12:19,340
...أنا حقًّا... أنا حقًّا

259
00:12:20,800 --> 00:12:23,340
.أنا حقًّا ممتنّةٌ لك

260
00:12:23,800 --> 00:12:25,470
لماذا تغلّبت عليك المشاعر هكذا؟

261
00:12:25,840 --> 00:12:29,900
قالت أنّها ممتنّة، رغم أنّها فكّرت
.في ذلك مرارًا وتكرارًا

262
00:12:30,740 --> 00:12:32,600
.وهكذا، أُغلق ملف القضيّة

263
00:12:33,210 --> 00:12:36,370
...عادت ليلي لتجتمع بقطّها، ولكن

264
00:12:36,860 --> 00:12:38,860
.جئتُ لأقضي بعض الوقت هنا

265
00:12:38,860 --> 00:12:39,860
.ارحلي

266
00:12:39,860 --> 00:12:42,740
لماذا؟ سمحتَ لذلك العجوز
.كثير الانتقاد بالدّخول

267
00:12:42,740 --> 00:12:47,220
هل تدركين الشّائعات الّتي قد تثيرها فتاة
قاصر تتردّد باستمرار على مركز الشّرطة؟

268
00:12:47,220 --> 00:12:49,490
.لقد واصلتْ المجيء لرؤيتنا

269
00:12:50,190 --> 00:12:53,360
أعلم أنّك سعيد بوجود المزيد
.من الفتيات هنا

270
00:12:53,360 --> 00:12:55,100
أنا محقّة، أليس كذلك؟

271
00:12:56,000 --> 00:12:58,000
...دعيني أُريك

272
00:12:58,000 --> 00:12:59,250
.كيف يكون المرء محقًّا

273
00:12:59,250 --> 00:13:05,760
إذًا فأنت تحبّين إصدار أصوات
القطط عند التّحدّث إليها؟

274
00:13:04,160 --> 00:13:05,760
!لا-لا تختلق الأمور

275
00:13:05,760 --> 00:13:08,610
للأسف، إنّها حقيقة اكتشفتها
.بفضل قدراتي الذّهنيّة

276
00:13:08,610 --> 00:13:10,390
!مهلاً، توقّف عن ذلك

277
00:13:10,700 --> 00:13:14,740
لم يعد هذا المكان مريحًا
.لرجل في منتصف العمر

278
00:13:15,230 --> 00:13:17,980
"!تشوجو: الشّرطيّ ذو القدرات الذّهنيّة"

279
00:13:15,230 --> 00:13:17,980
:الشّرطيّة المبتدئة"
"إيبّونغي ناو

280
00:13:17,980 --> 00:13:19,980
"بعد مرور أيّام"

281
00:13:18,810 --> 00:13:19,980
.مرحبًا يا تشوجو

282
00:13:19,980 --> 00:13:22,480
"مالك متجر كادوتا للهوايات: كادوتا"

283
00:13:20,570 --> 00:13:22,480
هل هذه هي شريكتك الجديدة؟

284
00:13:22,950 --> 00:13:26,740
هذا مثاليّ. كنت آمل أن تتولّى
.مهمّة أمنيّة من أجلي

285
00:13:26,740 --> 00:13:30,550
.لا ​​تستدعني إلى هنا لأمور كهذه يا كادوتا

286
00:13:30,550 --> 00:13:34,620
قلتُ لك ألاّ تتّصل بي إلا عند
."وصول مجموعات "ديب سترايكر

287
00:13:35,120 --> 00:13:38,940
ثمّ، ما الّذي قد يدفع متجر ألعاب
متواضع كهذا إلى الحاجة إلى حراسة؟

288
00:13:38,940 --> 00:13:41,880
.لا يدرك النّاس مدى روعة هذا المكان

289
00:13:42,160 --> 00:13:43,510
.باستثنائي أنا بالطّبع

290
00:13:44,680 --> 00:13:45,510
.يا للقرف

291
00:13:45,860 --> 00:13:50,260
،عادةً ما تكون شخصًا غير محبوب
.لكن يبدو أنّ لديك بعض الأصدقاء

292
00:13:50,260 --> 00:13:51,760
.بل نحن أعزّ الأصدقاء

293
00:13:51,760 --> 00:13:52,860
.أنا أشتري الأشياء

294
00:13:52,860 --> 00:13:53,710
.وأنا أبيع الأشياء

295
00:13:53,710 --> 00:13:55,520
أليس هذا هو حال التّجارة؟

296
00:13:55,520 --> 00:13:57,020
"مشتري | بائع"
"إنّها مجرد أعمال"

297
00:13:55,970 --> 00:13:57,020
.أعمال

298
00:13:57,020 --> 00:14:00,520
.لم أقصد تأمين المتجر يا تشوجو

299
00:14:00,860 --> 00:14:02,940
.الأمر يتعلّق ببطاقات كرسمون

300
00:14:02,940 --> 00:14:06,540
.اللّعنات والوحوش، أو كرسمون باختصار

301
00:14:07,250 --> 00:14:12,950
يستخدم اللاّعبون التّعاويذ والوحوش لخوض
.النّزالات في لعبة بطاقات المبارزة هذه

302
00:14:10,320 --> 00:14:12,950
:الحلقة 2، الجزء ب"
"الضّابط الرّفيع المبارز

303
00:14:13,660 --> 00:14:18,460
إذًا يريد منّا توفير الحماية لبطولة
كرسمون في شينجوكو؟

304
00:14:18,460 --> 00:14:22,090
نعم. سيحضر بعض الزّبائن الدّائمين
.من المتجر، لذا فأنا أعتمد عليك

305
00:14:22,090 --> 00:14:22,960
!حسنًا

306
00:14:22,960 --> 00:14:25,210
.لكنّ الأمر أكبر ممّا توقّعت

307
00:14:25,210 --> 00:14:27,720
وهذا يعني احتمال حدوث
.مشاكل كبيرة أيضًا

308
00:14:28,040 --> 00:14:33,350
سيتولّى المنظّمون زمام المبادرة، ولكن
.إذا آل الوضع إلى العنف، فسيحين دورنا

309
00:14:33,350 --> 00:14:35,720
"الضّابط الرّفيع المبارز: تشوجو ميغورو"

310
00:14:33,680 --> 00:14:34,560
!إنّه دوري

311
00:14:34,560 --> 00:14:35,720
ما الّذي تفعله؟

312
00:14:35,720 --> 00:14:39,370
!كيف ستوفّر الحماية وأنت تشارك في البطولة؟

313
00:14:39,370 --> 00:14:40,730
.يا عزيزتي بون

314
00:14:40,730 --> 00:14:44,960
المتنافسون الأبرياء هم من يدفعون
.الثّمن حين تسوء الأمور في بطولة ما

315
00:14:44,960 --> 00:14:48,670
،بصفتي مبارزًا مثلهم
.فأنا أتفهّم مشاعرهم تمامًا

316
00:14:48,670 --> 00:14:49,620
...ولهذا السّبب

317
00:14:49,620 --> 00:14:53,120
.سأواجه المنافسين الآخرين على قدم المساواة

318
00:14:53,120 --> 00:14:56,240
من الأفضل أن تستسلم
.قبل أن تحرج نفسك يا صغيري

319
00:14:56,240 --> 00:14:57,250
.أنت أوّلاً

320
00:14:57,250 --> 00:14:58,870
.بالغتَ كثيرًا في هذا

321
00:14:58,870 --> 00:15:01,400
أستدعي السلايم الملعون
!في وضع الهجوم

322
00:15:01,400 --> 00:15:03,130
!هجوم مباشر على اللاّعب

323
00:15:03,130 --> 00:15:04,560
!أيّها الأحمق

324
00:15:04,560 --> 00:15:07,510
:فعّلتَ بطاقة الفخّ الخاصّة بي
!إسقاط الدّائرة السّحريّة

325
00:15:08,010 --> 00:15:10,880
.ثمّ أستدعي عفريت من يدي

326
00:15:10,880 --> 00:15:13,850
إنّها تعكس الضّرر، وستكون
.هذه المباراة من نصيبي

327
00:15:15,970 --> 00:15:17,930
"نقاط الحياة"

328
00:15:15,970 --> 00:15:17,930
!لا

329
00:15:18,260 --> 00:15:21,760
بلا شكّ أنّها كانت مجموعة أوراق طفل
.في الابتدائيّة، جُمعت بمال مصروفه

330
00:15:21,760 --> 00:15:25,570
أنفقتُ راتبي بالكامل على مجموعتي
.الخاصّة. إنّها قويّة للغاية

331
00:15:25,570 --> 00:15:31,510
لا شيء يضاهي سحق الأطفال بمجموعة
.أوراق بُنيت بأموال دافعي الضّرائب

332
00:15:31,510 --> 00:15:34,920
لحظات كهذه هي ما يجعل عمل المرء
.كموظّف عامّ أمرًا يستحقّ العناء

333
00:15:34,920 --> 00:15:36,830
.هذا سبب كافٍ للفصل من العمل

334
00:15:36,830 --> 00:15:39,500
إذًا هل عليّ خنق أيّ شخص
يتصرّف بهذه الطّريقة؟

335
00:15:39,500 --> 00:15:42,460
"يا أطفال، لا تجربوا هذا في المنزل"

336
00:15:39,500 --> 00:15:42,460
.بالطّبع. سيكون ذلك رائعًا أيضًا

337
00:15:42,460 --> 00:15:47,590
لكن ما يجب عليكم الحذر منه
.هو آفة شينجوكو، لصّ البطاقات

338
00:15:46,300 --> 00:15:47,590
"لصّ بطاقات"

339
00:15:47,590 --> 00:15:50,120
لصّ"؟ هل هناك من يسرق البطاقات؟"

340
00:15:50,120 --> 00:15:52,090
.الأمر ليس غريبًا جدًّا

341
00:15:52,090 --> 00:15:55,510
فبعض هذه البطاقات
.تُباع بمئات الآلاف من الينّات

342
00:15:55,510 --> 00:15:56,970
ماذا؟ كلّ هذا القدر؟

343
00:15:56,970 --> 00:16:01,420
وبالنّظر إلى أنّ بعض تلك البطاقات
...قد تعود لأطفال صغار

344
00:16:01,420 --> 00:16:03,210
.تبًّا لك أيّها الشّرطيّ ذو القدرات الذّهنيّة

345
00:16:03,210 --> 00:16:05,110
.إنّهم يشكّلون أهدافًا سهلة

346
00:16:05,390 --> 00:16:08,500
ألا يمكنك تعقّب اللّصّ باستخدام
قدرتك على قراءة الأفكار؟

347
00:16:08,500 --> 00:16:11,010
.إنّها ليست بتلك القوّة المطلقة

348
00:16:11,010 --> 00:16:13,740
.أحتاج إلى تركيز شديد لقراءة أسرار النّاس

349
00:16:15,610 --> 00:16:17,930
.إنّه مكان ضخم يعجّ بحشود هائلة

350
00:16:15,950 --> 00:16:16,960
"مساحة شاسعة"

351
00:16:16,960 --> 00:16:19,000
"جمهور غفير"

352
00:16:17,930 --> 00:16:22,000
والجميع في حالة هياج. لا يمكن
.تخيّل ظروف أصعب من هذه

353
00:16:19,000 --> 00:16:22,000
"حالة ذهنيّة متوتّرة"

354
00:16:22,000 --> 00:16:25,060
لا تبدو تلك القوى مفيدةً جدًّا
.في منع الجريمة

355
00:16:25,060 --> 00:16:26,310
.اخرسي

356
00:16:26,310 --> 00:16:28,750
.ما زلتُ أعتمد عليك

357
00:16:28,750 --> 00:16:31,440
،يُشترط وجود أولياء الأمور في هذه البطولة

358
00:16:31,440 --> 00:16:33,760
.لكنّهم لا يفقهون شيئًا في أصول اللّعبة

359
00:16:33,760 --> 00:16:36,520
هل يثير الشّرطيّ ذو القدرات
الذّهنيّة المتاعب مجدّدًا؟

360
00:16:36,520 --> 00:16:38,470
.لا تجعل ابني يبكي

361
00:16:38,810 --> 00:16:40,970
.مهلاً، نحن نناقش أمورًا تتعلّق بالعمل هنا

362
00:16:40,970 --> 00:16:42,830
!يا له من تصرّف

363
00:16:42,830 --> 00:16:46,530
ألا تشعر بالحرج؟
شخص بالغ مثلك يلعب الورق؟

364
00:16:46,530 --> 00:16:47,480
!بالضّبط

365
00:16:47,480 --> 00:16:52,740
ماذا؟ هل هناك قانون يمنع
البالغين من لعب الورق؟

366
00:16:52,740 --> 00:16:56,320
إن وُجد، فما رأيك
أن تذكري نصّه القانونيّ؟

367
00:16:56,320 --> 00:17:00,240
أتظنّ أنّ بإمكانك منازلة شرطيّ
—في مبارزة قانونيّة

368
00:17:01,250 --> 00:17:03,750
!أظهر بعض الاحترام للعامّة

369
00:17:03,750 --> 00:17:04,630
!هذا جزاؤك

370
00:17:04,630 --> 00:17:07,410
على أيّة حال، لا ينبغي أن تغترّ
.كثيرًا بانتصارك علينا

371
00:17:07,410 --> 00:17:09,010
.عندما يأتي، ستكون في عداد الموتى

372
00:17:09,010 --> 00:17:10,270
من سيأتي؟

373
00:17:10,270 --> 00:17:12,630
هل خسرتما؟

374
00:17:12,630 --> 00:17:17,140
أظنّ أنّ هذا يعني أنّ خصمي القادم
.هو الشّرطيّ ذو القدرات الذّهنيّة

375
00:17:17,140 --> 00:17:18,490
.إنّه دوري

376
00:17:17,140 --> 00:17:19,640
"إيناهو داوري: لا أحد في الحيّ بإمكانه هزيمته"

377
00:17:18,490 --> 00:17:19,640
.هـ-هذا داوري

378
00:17:19,640 --> 00:17:20,860
.كنّا بانتظارك

379
00:17:20,860 --> 00:17:23,390
.لا أحد في صفّنا أقوى من داوري

380
00:17:23,390 --> 00:17:26,260
.اعتدتُ على خلط الأوراق بطريقة الشّوتغان

381
00:17:26,260 --> 00:17:27,650
.ستتلف أوراقك هكذا

382
00:17:27,650 --> 00:17:29,840
!نحن نعتمد عليك يا داوري

383
00:17:29,840 --> 00:17:31,400
الأقوى في صفّك؟

384
00:17:31,710 --> 00:17:35,840
عليك أن تعلم أنّني لقّنتُ درسًا قاسيًا
.للكثير من الصّغار الّذين ادّعوا الأمر نفسه

385
00:17:35,840 --> 00:17:38,410
باستخدام مجموعتي الّتي اشتريتها
.من أموال دافعي الضّرائب

386
00:17:38,410 --> 00:17:40,540
.ضابط شرطة. شخص بالغ. مبارز

387
00:17:40,540 --> 00:17:43,410
.إنّه يجلب العار لكلّ ما يرتبط به

388
00:17:43,750 --> 00:17:48,330
من واجب البالغين أن يُذيقوا الأطفال
المغرورين طعم الواقع القاسي، ألا تظنّ؟

389
00:17:48,330 --> 00:17:50,670
.سأضعك عند حدّك بأسلوبي الخاصّ

390
00:17:50,670 --> 00:17:55,670
أسلوبك؟ ممّا أراه، أنت تعتمد فقط
.على القوّة الغاشمة في المبارزات

391
00:17:55,670 --> 00:17:59,730
إنّه أسلوب لعب متواضع يعتمد على
.امتلاك مجموعة بطاقات باهظة الثّمينة

392
00:18:01,000 --> 00:18:02,310
.لقد نال منه

393
00:18:02,650 --> 00:18:06,430
ومع ذلك، لن أتفوّق عليك
.في جودة البطاقات فحسب

394
00:18:06,770 --> 00:18:07,810
.انظر

395
00:18:07,810 --> 00:18:11,310
.أعلى فئة من البطاقات النّادرة
.تيشي، رئيسة الملائكة

396
00:18:11,310 --> 00:18:15,480
مـ-مستحيل! تلك واحدة من
.أندر البطاقات الموجودة

397
00:18:15,480 --> 00:18:17,820
كيف يمتلكها شقيّ مثلك؟

398
00:18:17,820 --> 00:18:19,700
.يبدو وكأنّه قد استسلم للهزيمة بالفعل

399
00:18:19,700 --> 00:18:21,080
!إنّها تيشي

400
00:18:20,410 --> 00:18:22,580
!لم أرَ واحدةً على أرض الواقع من قبل

401
00:18:22,920 --> 00:18:25,830
.ربّما بالغتُ في الحديث

402
00:18:25,830 --> 00:18:27,920
.سنحسم الأمر في مبارزة

403
00:18:27,920 --> 00:18:29,500
.بكلّ تأكيد

404
00:18:29,500 --> 00:18:34,290
لكن عليّ إخبارك مسبقًا بأنّ معدتي
.تؤلمني طوال الصّباح

405
00:18:34,290 --> 00:18:36,590
.لقد سارع باختلاق عذرٍ واهٍ من الآن

406
00:18:36,590 --> 00:18:38,940
.كان الشّرطيّ ذو القدرات الذّهنيّة خائفًا تمامًا

407
00:18:38,940 --> 00:18:40,590
.من المستحيل أن يهزم داوري

408
00:18:40,590 --> 00:18:45,220
بالطّبع. ستكون ورقة تيشي
...الخاصّة بي كافية لـ

409
00:18:46,540 --> 00:18:47,350
داوري؟

410
00:18:47,700 --> 00:18:48,600
.اختفت

411
00:18:48,600 --> 00:18:50,230
!اختفت بطاقة تيشي

412
00:18:50,510 --> 00:18:54,460
لحظة، ألم تُرِها للشّرطيّ
ذي القدرات الذّهنيّة للتّوّ؟

413
00:18:54,460 --> 00:18:55,980
كيف يمكن أن تكون قد اختفت؟

414
00:18:55,980 --> 00:18:58,440
!لـ-لكنّني لا أجدها

415
00:18:58,440 --> 00:18:59,820
...كلاّ

416
00:19:01,840 --> 00:19:03,030
.إنّه هو يا إيبّونغي

417
00:19:05,620 --> 00:19:06,890
.أمسكتُ به

418
00:19:06,890 --> 00:19:10,580
...سنكتفي بفحص حقيبتك هنا، و

419
00:19:10,580 --> 00:19:12,850
!انظروا ماذا وجدنا

420
00:19:12,850 --> 00:19:16,210
هذا الرّجل يتجوّل حاملاً واحدةً من أندر
.البطاقات، ودون أن يملك مجموعة أوراق

421
00:19:16,210 --> 00:19:17,460
.لقد كُشف أمرك

422
00:19:17,460 --> 00:19:19,220
!تـ-تلك بطاقتي

423
00:19:19,220 --> 00:19:22,590
.لـ-لا تختلق الأكاذيب. تلك البطاقة ملكي أنا

424
00:19:22,590 --> 00:19:25,850
.ليس هذا ما تخبرني به الأفكار المتبقّية عليها

425
00:19:24,140 --> 00:19:25,850
"التّكهّن النّفسيّ"

426
00:19:26,250 --> 00:19:29,480
.هذه البطاقة تخصّ ذلك الفتى بالتّأكيد

427
00:19:29,480 --> 00:19:32,850
استعدّ لما هو قادم، فقد حاولت
.انتزاع البطاقة من يد مبارز

428
00:19:33,870 --> 00:19:36,860
.والآن، ستتجرّع أنت مرارة ذلك الألم

429
00:19:36,110 --> 00:19:36,860
"دويّ"

430
00:19:36,860 --> 00:19:41,280
.يستحقّ لصٌّ دنيءٌ يُدنّس روح المبارز العقاب

431
00:19:41,280 --> 00:19:42,740
.عقابٌ لا يُتقنه سواي

432
00:19:42,740 --> 00:19:44,240
"التّكهّن النّفسيّ × التّخاطر الذّهنيّ"

433
00:19:44,240 --> 00:19:45,490
!عقاب الخاسر

434
00:19:46,460 --> 00:19:48,960
.أعدني. أعدني

435
00:19:48,960 --> 00:19:51,680
.أعدني

436
00:19:51,680 --> 00:19:54,640
.أعدني

437
00:19:51,680 --> 00:19:53,890
!أوقف ذلك الصّوت

438
00:19:54,640 --> 00:19:56,850
ألم أرَ هذا المشهد في يو-غي-أو؟

439
00:19:56,850 --> 00:19:59,760
.يـ-يمكنه استعادتها. سأعيد البطاقة

440
00:20:00,170 --> 00:20:01,630
.سررتُ لأجلك يا داوري

441
00:20:01,630 --> 00:20:05,600
:لا بدّ لي أن أسأل
متى كشفتَ أمر اللّصّ؟

442
00:20:05,600 --> 00:20:08,770
في اللّحظة الّتي بدأ فيها ذلك
.الطّفل يستعرض بطاقته النّادرة

443
00:20:08,770 --> 00:20:11,750
.كان لدى اللّصّ ردّ فعلٍ ذهنيّ قويّ تجاه الأمر

444
00:20:11,750 --> 00:20:14,150
.فهمت. إذًا هكذا فعلتَها

445
00:20:14,730 --> 00:20:17,560
.حسنًا، انتهى عملي هنا

446
00:20:17,560 --> 00:20:20,070
.فزتَ تلقائيًّا يا فتى

447
00:20:21,980 --> 00:20:26,210
ساعدتَ طفلاً في استعادة غرضه
.العزيز... أنتَ أشبه بالبطل

448
00:20:26,210 --> 00:20:27,120
ما هذا الغباء؟

449
00:20:27,120 --> 00:20:29,440
،كنتُ أعرف ما الّذي يسعى إليه الجاني

450
00:20:29,440 --> 00:20:32,510
لكنّني لم أتحرّك إلاّ حين تمكّنتُ
.من ضبطه متلبّسًا

451
00:20:32,510 --> 00:20:36,630
"استخدمت ذلك "الشّيء الثّمين
.كطُعم. وهذا لا يجعلني بطلاً

452
00:20:38,000 --> 00:20:39,050
...ذلك

453
00:20:39,050 --> 00:20:41,010
هل تسبّب الشّرطيّ ذو القدرات
الذّهنيّة في المتاعب مجدّدًا؟

454
00:20:41,010 --> 00:20:43,980
.لهذا السّبب أحاول تجنّبه قدر الإمكان

455
00:20:43,980 --> 00:20:46,510
.فتدخّله لا يجلب الخير أبدًا

456
00:20:46,510 --> 00:20:49,600
.أتمنّى لو يبتعد عن الأطفال

457
00:20:49,600 --> 00:20:51,600
.أتّفق معك تمامًا. بكلّ صدق

458
00:20:51,870 --> 00:20:53,130
!أيّها الشّرطيّ ذو القدرات

459
00:20:53,130 --> 00:20:56,130
في المرّة القادمة... في المرّة
!القادمة، سنتواجه في مبارزة

460
00:20:58,480 --> 00:20:59,610
.هذا وعد

461
00:21:02,380 --> 00:21:06,950
،مهما كان شعورك حيال الأمر
...فكلّ أولئك الّذين ساعدتهم

462
00:21:07,470 --> 00:21:11,950
،يدركون مدى طيبتك الحقيقيّة
.حتّى وإن لم تدرك ذلك أنت

463
00:21:12,950 --> 00:21:14,710
"في اليوم التّالي"

464
00:21:13,590 --> 00:21:14,710
!إنّه دوري

465
00:21:15,040 --> 00:21:17,210
!أستدعي أبادون بوضعية الهجوم

466
00:21:17,210 --> 00:21:21,590
وتقوم قدرته الخاصّة بتدمير
.تيشي، رئيسة الملائكة

467
00:21:22,160 --> 00:21:24,820
.يبدو أنّني الفائز

468
00:21:25,590 --> 00:21:29,510
أظنّ أنّك لم تستطع مجاراة الوضع عندما يعتمد
الخصم استراتيجيّة قويّة ومحترفة، أليس كذلك؟

469
00:21:29,510 --> 00:21:34,420
ربّما يعلّمك هذا ألاّ تفتعل المشاكل
!مع البالغين أيّها الأحمق الصّغير

470
00:21:35,230 --> 00:21:40,230
،بغضّ النّظر عمّا قلتُه
.فهو وبشكل عامّ شخص حقير

471
00:21:40,230 --> 00:21:41,970
!كفّ عن ذلك

472
00:21:41,970 --> 00:21:44,990
.لقّنته درسًا حقيقيًّا بعد ذلك

473
00:23:15,030 --> 00:23:16,540
"لمحة عن الحلقة القادمة"

474
00:23:16,000 --> 00:23:16,540
.أنا ناو

475
00:23:16,540 --> 00:23:20,140
يظهر روبوت أزرق من الجيل الجديد
.ويضع تشوجو في مأزق كبير

476
00:23:20,140 --> 00:23:22,040
.لا تجدي قدراته نفعًا على الإطلاق

477
00:23:22,040 --> 00:23:24,790
،ليس هذا فحسب
.بل سيكون هناك سباق أيضًا

478
00:23:24,790 --> 00:23:29,380
،لكنّ الأمور ستكون على ما يرام
.فالشّدائد فرصة للنّموّ الشّخصيّ