1
00:00:00,900 --> 00:00:11,190
...شخير... شخير

2
00:00:12,320 --> 00:00:13,200
.شمّ، شمّ

3
00:00:17,030 --> 00:00:18,580
...تمتمة، تمتمة

4
00:00:20,020 --> 00:00:21,870
...تثاؤب

5
00:00:23,710 --> 00:00:25,620
!لقد نمتُ جيّدًا

6
00:00:26,170 --> 00:00:29,000
.لكن يبدو أنّ الوقت لا يزال ليلاً

7
00:00:29,460 --> 00:00:33,010
...حسنًا، أحضر لي الفطور يا كوماتسو-سان

8
00:00:51,110 --> 00:00:54,280
هل أصبح منزلنا... أصغر؟

9
00:00:56,070 --> 00:00:57,280
!مرحبًا

10
00:00:59,870 --> 00:01:01,990
.حان وقت الفطور

11
00:01:06,170 --> 00:01:09,130
!حتّى كوماتسو-سان أصبح صغيرًا

12
00:02:40,840 --> 00:02:42,300
...موكو

13
00:02:42,300 --> 00:02:44,640
هل كبرتِ أكثر من المعتاد اليوم؟

14
00:02:44,640 --> 00:02:48,180
ماذا؟! ما الّذي تقوله يا كوماتسو-سان؟

15
00:02:49,430 --> 00:02:50,890
...أيعقل أنّ

16
00:02:51,350 --> 00:02:54,230
،ليس كوماتسو-سان والمنزل من أصبحا صغيرين

17
00:02:54,650 --> 00:02:57,110
!بل موكو هي الّتي أصبحت كبيرة؟

18
00:02:57,110 --> 00:03:02,360
...هيّا... هيّا

19
00:03:03,070 --> 00:03:05,660
.كدتُ أنسى، إليك الفطور

20
00:03:09,040 --> 00:03:11,830
!أصبح فطوري كبيرًا أيضًا

21
00:03:13,670 --> 00:03:15,790
.كلي طعامك لتصبحي أكبر بكثير

22
00:03:15,790 --> 00:03:18,380
!ماذا؟! لا أريد أن أكبر أكثر

23
00:03:18,800 --> 00:03:23,970
...لقد حلمتُ بأن أغدو كبيرة مثل كوماتسو-سان يومًا ما

24
00:03:24,260 --> 00:03:26,720
!لكنّ هذا كبير جدًّا

25
00:03:26,720 --> 00:03:29,060
!لم يتحقّق حلمي على الإطلاق

26
00:03:29,060 --> 00:03:30,430
.لكنّك لا زلتِ تأكلين

27
00:03:34,060 --> 00:03:34,980
!عرفت

28
00:03:34,980 --> 00:03:37,730
!لا بدّ أنّي في حلم

29
00:03:39,990 --> 00:03:40,940
!كشفتِ الآمر

30
00:03:40,940 --> 00:03:44,030
!بالطّبع هو حلم! كم هذا مريح

31
00:03:44,660 --> 00:03:49,700
لكن هل عرفتِ أنّ الحلم الّذي يراود الواحد
منّا في ليلة رأس السّنة يتحقّق؟

32
00:03:49,700 --> 00:03:52,710
!ماذا؟! لكنّي لا أريده أن يتحقّق

33
00:03:54,040 --> 00:03:55,210
!إنّها الشّمس

34
00:03:55,210 --> 00:03:57,000
!الشّمس تُشرق

35
00:03:57,000 --> 00:03:59,170
!يجدر بي أن أستيقظ بمجرّد أن تشرق الشّمس

36
00:03:59,170 --> 00:04:01,590
!هيّا! بسرعة

37
00:04:16,610 --> 00:04:19,400
.كانت موكو تُتمتم أثناء نومها كثيرًا هذا الصّباح

38
00:04:19,730 --> 00:04:23,150
...عضّ، عضّ

39
00:04:20,320 --> 00:04:23,150
.يساورني شعور أنّ حلمًا سيّئًا قد راودها

40
00:04:23,320 --> 00:04:26,780
أنت لا تظنّ أنّ ذلك الحلم السّيّئ وكرهها المفاجئ لي

41
00:04:26,780 --> 00:04:27,780
لهما علاقة ببعضهما بطريقة ما؟

42
00:04:28,160 --> 00:04:30,950
...عضّ، عضّ

43
00:04:45,840 --> 00:04:48,430
...لا

44
00:04:49,010 --> 00:04:51,350
!لا، لا، لا، لا، لا

45
00:05:05,530 --> 00:05:07,200
!ثلج

46
00:05:09,910 --> 00:05:10,950
!هذا ممتع للغاية

47
00:05:14,580 --> 00:05:16,080
!ثلج! هذا ممتع

48
00:05:16,500 --> 00:05:18,460
!تحبّ موكو الثّلج

49
00:05:18,880 --> 00:05:19,540
!عضّ

50
00:05:20,210 --> 00:05:22,460
!يصبح فمي باردًا عندما آكُله

51
00:05:22,460 --> 00:05:23,920
!الثّلج أعجوبة غامضة

52
00:05:23,920 --> 00:05:29,590
هزيز  هزيز

53
00:05:24,210 --> 00:05:27,050
.كما أنّ الرّياح تهبّ بينما يتساقط الثّلج

54
00:05:27,050 --> 00:05:28,680
!هذه حقيقة ممتعة أخرى عن الثّلج

55
00:05:29,850 --> 00:05:30,470
ماذا؟

56
00:05:30,800 --> 00:05:36,140
لكن... هذا الشّيء الّذي تحت أقدامي يُسمّى ثلجًا أيضًا؟

57
00:05:37,100 --> 00:05:38,650
.هذا ثلج

58
00:05:38,980 --> 00:05:40,610
.وهذا ثلج أيضًا

59
00:05:40,860 --> 00:05:44,900
.ثلج

60
00:05:46,610 --> 00:05:48,820
!أصبح هذا معقّدًا للغاية

61
00:05:49,490 --> 00:05:50,280
.حسنًا

62
00:05:50,280 --> 00:05:52,950
!تحبّ موكو نوعا الثّلج معًا في كلّ الأحوال

63
00:05:54,700 --> 00:05:57,790
...وما تحبّه موكو بالفعل أكثر من أيّ شيء

64
00:05:58,580 --> 00:06:00,830
!كوماتسو-سان

65
00:06:01,170 --> 00:06:03,420
.يصبح مزاجك جيّدًا بالفعل عندما تُثلج يا موكو

66
00:06:04,500 --> 00:06:06,010
!شدّ

67
00:06:15,470 --> 00:06:18,440
...موكو

68
00:06:19,980 --> 00:06:23,440
.موكو... تعالي إلى هنا

69
00:06:23,770 --> 00:06:26,780
...هذا الصّوت وهذه الرّائحة

70
00:06:27,150 --> 00:06:31,660
!أوشيكو-سان

71
00:06:38,370 --> 00:06:40,540
!هذا أوشيكو-سان؟

72
00:06:40,870 --> 00:06:45,710
.موكو... تحوّلتُ إلى رجل ثلج

73
00:06:45,710 --> 00:06:48,050
!ماذا؟! لماذا؟! لماذا؟

74
00:06:48,050 --> 00:06:50,340
.إنّها غلطة كوماتسو

75
00:06:50,340 --> 00:06:52,140
!إنّها غلطة كوماتسو-سان؟

76
00:06:55,640 --> 00:06:59,020
!تذوّقي غضب كرات الثّلج خاصّتي

77
00:07:05,860 --> 00:07:07,610
هل كانت أوشيكو في الخارج؟

78
00:07:07,900 --> 00:07:09,950
،لستُ واثقة كيف حدث هذا

79
00:07:09,950 --> 00:07:12,240
!لكن أعد أوشيكو-سان إلى طبيعته رجاءً

80
00:07:12,570 --> 00:07:15,870
!تعدك موكو أنّها ستكون كلبة مطيعة

81
00:07:15,870 --> 00:07:20,330
!ستتوقّف موكو عن شدّ منشفتك كعقاب

82
00:07:22,790 --> 00:07:24,460
هل يمكنني أن أدفّئ يديّ هنا؟

83
00:07:24,460 --> 00:07:26,250
!ماذا؟! بهذه السّرعة؟

84
00:07:28,300 --> 00:07:29,800
،في كلّ الأحوال

85
00:07:30,300 --> 00:07:34,390
!مجهودات موكو الجبّارة أصلحت كلّ شيء

86
00:07:34,890 --> 00:07:36,350
!شدّ

87
00:07:39,390 --> 00:07:42,020
بدأ الجوّ يصحو، أتريدين الخروج للتّمشية؟

88
00:07:42,020 --> 00:07:43,810
!أجل! أجل

89
00:07:52,030 --> 00:07:54,950
!يفوق هذا قدرات موكو

90
00:07:58,660 --> 00:07:59,950
!حسنًا، لنذهب

91
00:08:03,250 --> 00:08:05,170
.ها أنا سأبدأ بالرّمي يا موكو

92
00:08:05,170 --> 00:08:05,790
!حسنًا

93
00:08:06,170 --> 00:08:08,670
!أرمها عليّ يا كوماتسو-سان

94
00:08:09,130 --> 00:08:12,090
!إنّ موكو في مزاج جيّد للّعب بالثّلج الآن

95
00:08:12,090 --> 00:08:14,180
!ارمها! ارمها

96
00:08:14,180 --> 00:08:15,220
!خذي

97
00:08:15,430 --> 00:08:18,470
!كلاّ! إنّها باردة! إنّها باردة

98
00:08:19,310 --> 00:08:22,020
!الثّلج بارد، لكنّ موكو ليست باردة

99
00:08:23,190 --> 00:08:25,940
أتسألون لماذا ذلك؟

100
00:08:26,270 --> 00:08:28,190
،لأنّه عندما تلعب موكو مع كوماتسو-سان

101
00:08:28,190 --> 00:08:31,190
!يمتلء قلب موكو بالدّفئ

102
00:08:31,570 --> 00:08:32,280
ماذا؟

103
00:08:32,780 --> 00:08:33,860
انتهينا بهذه السّرعة؟

104
00:08:37,320 --> 00:08:41,450
.حسنًا، ستلعب موكو... بمفردها

105
00:08:48,590 --> 00:08:50,920
...حفر... حفر، حفر، حفر

106
00:08:55,090 --> 00:08:56,180
!بياض

107
00:08:56,180 --> 00:08:58,640
!هنالك بياض حول وجهي بالكامل

108
00:08:58,640 --> 00:08:59,800
!كم هذا مدهش

109
00:09:00,640 --> 00:09:03,430
!أرغب بأن أطلق اسمًا على هذه الظّاهرة المدهشة

110
00:09:03,430 --> 00:09:07,770
...إنّه منفوش ومثير وممتع، لذلك سأسمّيه

111
00:09:12,110 --> 00:09:13,190
!كوماتسو

112
00:09:15,650 --> 00:09:16,660
!كوماتسو

113
00:09:18,280 --> 00:09:20,200
!ستصبح هذه اللّعبة محبوبة بالتّأكيد

114
00:09:20,200 --> 00:09:22,200
!كوماتسو! كوماتسو

115
00:09:22,200 --> 00:09:24,410
.موكو في مزاج جيّد اليوم

116
00:09:25,370 --> 00:09:26,960
!نباح، نباح، نباح

117
00:09:28,040 --> 00:09:28,540
ماذا؟

118
00:09:30,500 --> 00:09:34,800
...هذه... هذه بصمة قدم موكو

119
00:09:35,420 --> 00:09:37,340
...ماذا؟ إذًا

120
00:09:37,340 --> 00:09:39,720
ماذا عن بصمة القدم هذه؟

121
00:09:43,270 --> 00:09:45,310
!إنّهما متشابهتان

122
00:09:45,890 --> 00:09:49,310
!عليّ أن أري هذا لكوماتسو-سان في الحال

123
00:09:51,360 --> 00:09:52,520
ما الأمر؟

124
00:09:52,860 --> 00:09:54,730
.لعبتُ معكِ منذ خمس دقائق فحسب

125
00:09:54,730 --> 00:09:57,860
.أسأتَ الفهم! لا تطلب منك موكو أن تلعب

126
00:09:57,860 --> 00:09:59,570
!لقد حقّقت موكو اكتشافًا كبيرًا

127
00:10:00,650 --> 00:10:02,150
!أسرع! أسرع

128
00:10:02,150 --> 00:10:05,410
!ستحتفظ موكو بهذا سرًّا عن الجميع إلاّ أنت يا كوماتسو-سان

129
00:10:05,710 --> 00:10:06,870
!إنّه هنا

130
00:10:06,870 --> 00:10:09,670
...هنا، بصمة قدم موكو هـ

131
00:10:13,220 --> 00:10:16,270
هل خرجتٍ للترحيب بي يا موكو؟

132
00:10:21,760 --> 00:10:24,600
!عض، عض

133
00:10:25,610 --> 00:10:26,990
...تبدو موكو

134
00:10:26,990 --> 00:10:28,380
هل هي في مزاج سيّئ اليوم؟

135
00:10:29,520 --> 00:10:31,610
.كانت في مزاج جيّد قبل دقائق

136
00:10:32,310 --> 00:10:34,610
ما الّذي جاء بك يا أوشيكو؟

137
00:10:35,530 --> 00:10:37,110
!هذا. إنّه تذكار لك

138
00:10:37,110 --> 00:10:39,570
هل ذهبتَ في عطلة أو ما شابه؟

139
00:10:42,970 --> 00:10:44,940
.نعم، ذهبتُ للينابيع الحارّة في عطلتي

140
00:10:45,280 --> 00:10:47,630
.وعثرتُ على شيء غير عادي هناك

141
00:10:47,630 --> 00:10:48,750
...إنّه

142
00:10:48,750 --> 00:10:52,170
أوسين مانجو ساخن

143
00:10:49,680 --> 00:10:51,130
!أوسين مانجو

144
00:10:51,130 --> 00:10:52,170
!إنّهم يقدّمونه في كلّ مكان

145
00:10:53,270 --> 00:10:56,130
.كلاّ، لا يملك أيّ مكان علبة خاصّة به

146
00:10:56,130 --> 00:10:58,570
!هنالك خاصية للتّسخين الذّاتيّ

147
00:10:58,570 --> 00:11:00,350
...إن سحبتُ هذا الخيط

148
00:11:02,430 --> 00:11:03,760
!أصبحت لعبتي محبوبة بالفعل

149
00:11:06,960 --> 00:11:09,180
.نظّاراتي... يملؤها البخار

150
00:11:59,990 --> 00:12:29,930
في الحلقة القادمة مع موكو

151
00:12:01,700 --> 00:12:04,710
!كوماتسو-سان! ذلك الرّجل الرّائع هنا ثانية

152
00:12:04,710 --> 00:12:06,140
.تبدين سعيدة يا موكو

153
00:12:06,140 --> 00:12:08,020
هل أشعرتك جرّافة الثّلج بالحماسة ثانية؟

154
00:12:08,020 --> 00:12:10,410
!إنّه رائع على الدّوام

155
00:12:10,410 --> 00:12:12,520
...جرّافة الثّلج

156
00:12:12,500 --> 00:12:15,460
...ما يعني أن ذلك الموسم قد اقترب

157
00:12:15,460 --> 00:12:18,340
لماذا عليه أن يأتي كلّ سنة دون دعوة؟

158
00:12:18,340 --> 00:12:20,420
!لماذا هنالك الكثير من أشجار الأَرْز في هذه البلدة؟

159
00:12:20,420 --> 00:12:23,630
!ما القادم؟ ما الخطب يا كوماتسو-سان؟

160
00:12:23,630 --> 00:12:27,220
:في الحلقة القادمة من موكو الجميلة
."تجلب مجرفة الثّلج البؤس"