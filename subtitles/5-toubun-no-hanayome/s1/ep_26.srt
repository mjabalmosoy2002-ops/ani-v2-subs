1
00:00:02,150 --> 00:00:04,920
!أويـ-سو-غي-سان

2
00:00:05,720 --> 00:00:07,250
!يـ-يوتسوبا

3
00:00:07,250 --> 00:00:09,030
.غدًا هو اليوم المنتظر أخيرًا

4
00:00:09,200 --> 00:00:10,090
أي يوم؟

5
00:00:10,090 --> 00:00:12,780
أليس هذا واضحًا؟

6
00:00:13,040 --> 00:00:14,030
!هذا

7
00:00:14,880 --> 00:00:16,740
!مخيم المدرسة

8
00:00:17,200 --> 00:00:19,530
هل قرأت الكتيب؟

9
00:00:19,530 --> 00:00:20,660
.لا

10
00:00:20,870 --> 00:00:23,200
.إنه مليئ بالأحداث الممتعة

11
00:00:23,200 --> 00:00:27,160
،الطبخ في الخارج، والتزلج، وصيد السمك، والتنزه

12
00:00:27,260 --> 00:00:30,380
!وأخيرًا... نار المخيم

13
00:00:30,670 --> 00:00:32,130
!وأسطورة الرقصة

14
00:00:32,710 --> 00:00:39,640
.والثنائيان اللذان يرقصان معًا سيرتبطان في حياتهما للأبد

15
00:00:40,010 --> 00:00:44,270
.سمعت أن ثنائيات كثيرة بدؤوا المواعدة بعدها

16
00:00:44,270 --> 00:00:47,920
.أخبرتك سابقا أن العلاقات بين الطلاب مجرد مضيعة للوقت

17
00:00:47,920 --> 00:00:52,700
لـ-لكن ألن تود مواعدة فتاة تحبها؟

18
00:00:52,700 --> 00:00:53,650
أليس كذلك يا ميكو؟

19
00:00:54,770 --> 00:00:55,610
ميكو؟

20
00:00:57,190 --> 00:00:59,870
لماذا نواعد الأشخاص الذين نحبهم؟

21
00:01:01,760 --> 00:01:06,880
.لأنك تحبينه حبا جما

22
00:01:07,370 --> 00:01:09,540
.أنتِ لديك فكرة عن من يكون يا ميكو

23
00:01:10,390 --> 00:01:12,160
.لـ-لا

24
00:01:12,160 --> 00:01:13,200
.حسنًا

25
00:01:13,200 --> 00:01:15,860
.بما أن الجميع هنا، لندرس

26
00:01:16,560 --> 00:01:17,640
!مجددا؟

27
00:01:17,860 --> 00:01:20,240
.اليوم لدي تصوير لذا لن أحضر

28
00:01:20,240 --> 00:01:22,390
.لقد أخبرتك بذلك في رسالة بالفعل

29
00:01:25,600 --> 00:01:28,840
.وأنا أحتاج للتحضير للغد

30
00:01:28,840 --> 00:01:30,480
!ويحك، انتظري

31
00:01:30,940 --> 00:01:32,150
.يا إلهي

32
00:01:32,150 --> 00:01:33,400
ميكو

33
00:01:33,580 --> 00:01:36,750
.صفِّي لديه اجتماع حول المخيّم

34
00:01:37,790 --> 00:01:39,410
أيمكنك تولِّي المعتاد؟

35
00:01:39,840 --> 00:01:40,990
.حسنا

36
00:01:47,150 --> 00:01:48,170
المعتاد؟

37
00:01:48,700 --> 00:01:51,240
ما الذي تنويه ميكو؟

38
00:01:53,720 --> 00:01:54,540
إيتشيكا؟

39
00:01:54,960 --> 00:01:57,480
ألم تغادر قبل قليل؟

40
00:01:58,470 --> 00:01:59,760
...مستحيل

41
00:02:02,700 --> 00:02:04,640
!ميكو؟

42
00:02:04,640 --> 00:02:05,980
!أخذت دور إيتشيكا

43
00:03:37,010 --> 00:03:39,830
.شكرا لقدومك يا ناكانو-سان

44
00:03:42,300 --> 00:03:44,070
أنت مايدا-كن، صحيح؟

45
00:03:44,440 --> 00:03:46,070
أين باقي الزملاء؟

46
00:03:46,070 --> 00:03:50,070
.آسف، لقد كذبت لكي تأتي إلى هنا

47
00:03:50,070 --> 00:03:50,790
ماذا؟

48
00:03:51,570 --> 00:03:55,950
.أ-أرجوك ارقصي معي في نار المخيم

49
00:03:57,960 --> 00:03:59,960
معي؟ لماذا؟

50
00:03:59,960 --> 00:04:02,210
...حـ-حسنا، لأنني

51
00:04:02,930 --> 00:04:05,090
.لأنني أحبك

52
00:04:07,480 --> 00:04:08,760
هكذا إذن

53
00:04:09,170 --> 00:04:12,430
.إيتشيكا ظريفة. أتساءل إن كان يحصل لها هذا كثيرا

54
00:04:13,400 --> 00:04:14,580
.شكرًا

55
00:04:14,580 --> 00:04:16,310
.سأرد عليك لاحقا

56
00:04:16,560 --> 00:04:18,100
.أريد سماع الإجابة الآن

57
00:04:19,230 --> 00:04:21,090
!أرجوك يا ناكانو-سان

58
00:04:19,760 --> 00:04:22,110
.اكذب كذبة رخصية، وستعاني العواقب

59
00:04:23,200 --> 00:04:25,110
.جنت على نفسها

60
00:04:25,420 --> 00:04:25,980
ماذا؟

61
00:04:25,980 --> 00:04:28,830
.تبدين مختلفة يا ناكانو-سان

62
00:04:29,610 --> 00:04:30,390
أهو شعرك؟

63
00:04:31,190 --> 00:04:32,270
...غريب

64
00:04:32,790 --> 00:04:33,330
...المعذرة

65
00:04:34,320 --> 00:04:36,380
أنتن خمسة توائم، صحيح؟

66
00:04:37,850 --> 00:04:40,740
أيعقل أنك أنتِ وواحدة من أخواتك

67
00:04:40,740 --> 00:04:43,090
تبادلتن الأدوار أو ما شابه، صحيح؟

68
00:04:45,890 --> 00:04:48,260
.إذن أنت هنا يا إيتشيكا

69
00:04:49,310 --> 00:04:51,180
.أخواتكِ ينادينك

70
00:04:51,740 --> 00:04:53,140
.اذهبي لهن

71
00:04:53,510 --> 00:04:54,600
.فوتارو

72
00:04:55,400 --> 00:04:58,650
مهلا، ما الذي أحضرك إلى هنا يا وغد؟

73
00:04:59,280 --> 00:05:02,650
.لا تنادي ناكانو-سان باسمها يا وغد

74
00:05:02,970 --> 00:05:04,860
.امنحها وقتًا لتقرر

75
00:05:04,860 --> 00:05:06,990
.فكر بما يشعر به الناس

76
00:05:08,010 --> 00:05:10,700
.سماع هذا منك لا يبدو مقنعًا

77
00:05:11,040 --> 00:05:13,280
من سمح لك بالتنصت علينا؟

78
00:05:13,900 --> 00:05:15,290
!لا شأن لك بهذا

79
00:05:15,540 --> 00:05:17,340
.لي شأن بذلك تقنيا

80
00:05:17,340 --> 00:05:17,850
المعذرة

81
00:05:17,850 --> 00:05:18,790
ماذا قلت؟

82
00:05:18,960 --> 00:05:20,250
أيها الوغد

83
00:05:21,300 --> 00:05:22,500
!اهدآ

84
00:05:23,360 --> 00:05:24,210
!انقلع

85
00:05:28,020 --> 00:05:31,580
!لقد وعدت بالرقص مع هذا الشخص

86
00:05:34,840 --> 00:05:35,980
...مهلا، لا

87
00:05:35,980 --> 00:05:37,190
!أنتِ تكذبين

88
00:05:37,190 --> 00:05:39,600
!هذا الشخص لا يناسبك

89
00:05:39,600 --> 00:05:41,620
.هذا غير صحيح

90
00:05:42,040 --> 00:05:44,570
...إن فوتارو

91
00:05:46,080 --> 00:05:47,260
.شخص رائع

92
00:05:48,240 --> 00:05:50,660
أ-أتتواعدان؟

93
00:05:50,660 --> 00:05:52,860
!نـ-نحن حبيبان

94
00:05:52,860 --> 00:05:54,710
.لنعد إلى المنزل معًا

95
00:05:54,710 --> 00:05:57,100
.أجل. لنذهب على أي

96
00:05:58,750 --> 00:05:59,840
!مهلا لحظة

97
00:06:00,500 --> 00:06:03,500
إن كنتما حبيبان، فيمكنكما المغادرة ممسكين بيدي بعضكما، صحيح؟

98
00:06:04,080 --> 00:06:05,960
ما هذا؟ ألا تستطيعان؟

99
00:06:05,960 --> 00:06:07,700
.هذا مريب فعلا

100
00:06:08,200 --> 00:06:09,260
يا أخي

101
00:06:09,540 --> 00:06:12,680
.لا يفعل الأحبة هذا بالضرورة

102
00:06:15,690 --> 00:06:16,270
—ميـ

103
00:06:16,840 --> 00:06:17,600
!إيتشيكا

104
00:06:17,820 --> 00:06:20,000
...هذا

105
00:06:20,000 --> 00:06:23,360
...ليس وكأنني أردت أن نمسك يدي بعضنا مجددا، لكن

106
00:06:23,850 --> 00:06:25,610
.اعلم أن هذه ليست مرتنا الأولى

107
00:06:26,410 --> 00:06:27,630
!سحقا

108
00:06:27,630 --> 00:06:29,150
.حاضر، فهمت

109
00:06:31,280 --> 00:06:34,420
،عذرا، قد يكون غريبا أن أسألك هذا الآن

110
00:06:34,420 --> 00:06:37,540
لكن ما الذي جعلك ترغب بالاعتراف للشخص الذي تحب؟

111
00:06:37,540 --> 00:06:39,900
كيف لكِ أن تسأليني هذا يا ناكانو-سان؟

112
00:06:39,900 --> 00:06:40,420
.آسفة

113
00:06:41,740 --> 00:06:43,920
...حسنا

114
00:06:43,920 --> 00:06:46,860
.لأن أي شخصٍ يفعل ذلك يعني أنه يريد أن يحتكر ذلك الشخص لنفسه

115
00:06:46,860 --> 00:06:48,050
.هذا أقوى سبب

116
00:06:49,950 --> 00:06:52,930
تحتكر ذلك الشخص لنفسك؟

117
00:06:53,200 --> 00:06:55,680
.لا أدري ما أقوله بحق

118
00:06:55,680 --> 00:06:56,470
!يا هذا

119
00:06:56,470 --> 00:06:58,430
.الأفضل لك ألا تسبب المتاعب لناكانو-سان

120
00:06:58,760 --> 00:07:02,060
.إنها من تسبب لي المتاعب الآن

121
00:07:02,060 --> 00:07:03,270
ما الذي تقوله؟

122
00:07:03,670 --> 00:07:05,610
.لنذهب يا فوتارو

123
00:07:05,830 --> 00:07:07,810
.لا داعي لأن تلتصقي بي هكذا

124
00:07:08,350 --> 00:07:10,080
.أنا إيتشيكا الآن

125
00:07:10,080 --> 00:07:11,490
.هذا ما كانت ستفعله

126
00:07:12,440 --> 00:07:14,130
.سأكون بخير

127
00:07:15,760 --> 00:07:17,410
...رغم ذلك

128
00:07:17,410 --> 00:07:20,530
أأنتِ متأكدة من رفضه دون سؤالها؟

129
00:07:20,530 --> 00:07:23,460
.قالت إيتشيكا إن الأولوية لعملها

130
00:07:23,760 --> 00:07:26,630
مع ذلك، ماذا عن نار المخيم الآن؟

131
00:07:29,360 --> 00:07:30,980
!ها أنت ذا

132
00:07:32,610 --> 00:07:34,180
.حسنا، لنذهب

133
00:07:35,800 --> 00:07:39,810
.سنختار ملابس لأويسوغي-سان لكي يذهب بها إلى المخيم

134
00:07:40,050 --> 00:07:41,550
.سأبدأ أنا أولا

135
00:07:41,550 --> 00:07:43,920
.اخترت لك لباسًا مبهرجا

136
00:07:43,920 --> 00:07:46,360
.لا يسعني سوى التفكير أنكِ تعبثين

137
00:07:47,160 --> 00:07:50,370
.لمحة من اللباس التقليدي تناسبك كثيرا يا فوتارو

138
00:07:50,370 --> 00:07:51,860
.إنه اللباس التقليدي عينه

139
00:07:52,640 --> 00:07:55,780
.اخترت لباسًا رجوليا يناسبك

140
00:07:55,780 --> 00:07:57,940
من أين أخذت فكرة الرجولة هذه؟

141
00:07:59,560 --> 00:08:01,180
.نينو تختار بجدية

142
00:08:01,180 --> 00:08:02,320
.إنها جادة جدا

143
00:08:02,320 --> 00:08:04,830
!خذن الأمر بجدية يا فتيات

144
00:08:05,700 --> 00:08:07,980
هل أنتن متأكدات من هذا؟

145
00:08:08,470 --> 00:08:09,590
المال

146
00:08:09,830 --> 00:08:11,780
.هذا ليس من أجلك

147
00:08:11,780 --> 00:08:15,050
.ستسبب لنا المتاعب بتسكعك معنا وأنت ترتدي تلك الملابس الرثة

148
00:08:15,400 --> 00:08:20,060
...لكن أتعلمون، اختيار الملابس والتسوق مع فتى

149
00:08:20,350 --> 00:08:22,550
يبدو كموعدٍ، صحيح؟

150
00:08:24,820 --> 00:08:26,810
.هذا مجرد تسوق فحسب

151
00:08:27,150 --> 00:08:29,480
.لا يجدر بالطلبة المواعدة

152
00:08:29,480 --> 00:08:30,820
.فهذا عمل مشين

153
00:08:32,020 --> 00:08:34,140
.تتحدثين كأويسوغي-سان

154
00:08:34,140 --> 00:08:36,070
!لا تشبهيني به رجاءً

155
00:08:36,330 --> 00:08:39,160
.نحن لسنا أكثر من مجرد طلاب وأستاذ

156
00:08:39,160 --> 00:08:41,120
.علينا أن نبقي مسافة بيننا

157
00:08:41,120 --> 00:08:43,120
!رسمت مسافة بيننا بالفعل

158
00:08:43,860 --> 00:08:45,540
!أويسوغي-سان

159
00:08:45,760 --> 00:08:48,960
.تأكد من قراءة الكتيب جيدا

160
00:08:49,270 --> 00:08:50,540
لماذا علي ذلك؟

161
00:08:50,540 --> 00:08:52,920
!الأفضل لك أن تأتي

162
00:08:53,340 --> 00:08:56,620
!لنصنع ذكريات لا تنسى

163
00:08:57,720 --> 00:08:59,220
.تذكرت

164
00:09:00,760 --> 00:09:01,930
...هاتفي

165
00:09:04,320 --> 00:09:05,380
أبي؟

166
00:09:10,700 --> 00:09:12,320
رايها! هل أنتِ بخير؟

167
00:09:13,360 --> 00:09:16,700
.أخي، أعتقد أني أصبت بالحمى

168
00:09:17,520 --> 00:09:20,200
.أعتذر عن إزعاجك بينما أنت بالخارج

169
00:09:22,650 --> 00:09:25,580
.جسدك ضعيف، لذا لا ترهقي نفسك

170
00:09:26,050 --> 00:09:28,830
.لقد اشتريت بعض الأدوية والمشروبات

171
00:09:29,170 --> 00:09:31,370
.إذن أعطني الدواء رجاءً

172
00:09:31,370 --> 00:09:34,060
.حاضر

173
00:09:32,180 --> 00:09:33,320
.امسح عرقي

174
00:09:34,060 --> 00:09:35,610
.حل واجبي المنزلي

175
00:09:35,610 --> 00:09:36,540
.حاضر

176
00:09:36,540 --> 00:09:38,590
.تجعلين مني أدلّلك الآن

177
00:09:40,680 --> 00:09:42,140
.شكرا

178
00:09:42,140 --> 00:09:44,810
.قال أبي إنه سيعود فور أن ينهي عمله

179
00:09:45,400 --> 00:09:46,380
.حقا

180
00:09:48,080 --> 00:09:51,430
أخي، مخيم مدرستك يبدأ غدا، صحيح؟

181
00:09:52,000 --> 00:09:52,690
.نعم

182
00:09:53,070 --> 00:09:55,490
هل أستطيع أن أطلب منك شيئًا أخيرا؟

183
00:09:56,270 --> 00:09:59,700
.قص علي قصصا ممتعة عندما تعود إلى المنزل

184
00:09:59,950 --> 00:10:02,370
.سأكون بخير لوحدي

185
00:10:06,920 --> 00:10:08,420
.فهمت

186
00:10:08,920 --> 00:10:09,920
.نمي جيدًا

187
00:10:14,540 --> 00:10:15,780
.حسنا، اصطفوا رجاءً

188
00:10:15,780 --> 00:10:16,640
.ناكانو

189
00:10:16,640 --> 00:10:17,670
.ناكانو إيتسوكي

190
00:10:18,510 --> 00:10:19,320
نعم؟

191
00:10:18,510 --> 00:10:19,320
!اركبوا

192
00:10:19,320 --> 00:10:23,760
أيمكنك تولي مسؤولية اختبار الشجاعة؟

193
00:10:26,660 --> 00:10:27,640
!رايها

194
00:10:27,840 --> 00:10:28,930
!هل أنتِ حية؟

195
00:10:30,640 --> 00:10:31,760
.فوتارو

196
00:10:33,190 --> 00:10:35,280
.إنها ما تزال نائمة يا أبي

197
00:10:35,280 --> 00:10:36,360
.اهدأ قليلا

198
00:10:37,820 --> 00:10:39,700
أكنت تعتني بها؟

199
00:10:40,190 --> 00:10:43,680
.مهلا، حافلة مخيم المدرسة غادرت بالفعل

200
00:10:43,680 --> 00:10:44,870
حقا؟

201
00:10:45,480 --> 00:10:47,900
.لم أهتم للأمر كثيرا، فنسيته

202
00:10:47,900 --> 00:10:51,720
.الآن أستطيع الدراسة بقدر ما أريده طيلة الأيام الثلاثة

203
00:10:53,440 --> 00:10:55,590
.لقد نسيت شيئا يا فوتارو

204
00:10:56,800 --> 00:10:59,330
.آسف لأني تأخرت في العودة

205
00:11:00,680 --> 00:11:02,500
.إنه حدث لن يتكرر أبدا

206
00:11:03,670 --> 00:11:06,500
.قد تصل إن ذهبت الآن

207
00:11:07,150 --> 00:11:08,600
.الحافلة غادرت

208
00:11:08,600 --> 00:11:09,920
.ولا أهتم للذهاب أبدا

209
00:11:12,400 --> 00:11:14,090
.أنا جائعة

210
00:11:15,210 --> 00:11:16,140
.رايها

211
00:11:16,670 --> 00:11:18,020
ماذا عن الحمّى؟

212
00:11:18,020 --> 00:11:18,740
.شفيت

213
00:11:19,400 --> 00:11:21,120
.شكرا لك يا أخي

214
00:11:21,120 --> 00:11:23,040
.أنا بخير الآن

215
00:11:23,040 --> 00:11:24,490
.لذا اذهب إلى مخيم المدرسة

216
00:11:24,760 --> 00:11:26,150
...لكن الحافلة

217
00:11:26,150 --> 00:11:28,460
.لقد غادرت الحافلة فعلا

