.بالتفكير في السابق، أظنه كان مريضا منذ البداية

216
00:10:55,440 --> 00:10:57,970
.ليتني انتبهت له أكثر

217
00:10:58,580 --> 00:11:01,460
.لقد كنت مركزة على نفسي فقط

218
00:11:03,700 --> 00:11:04,670
.آسفة

219
00:11:06,470 --> 00:11:08,350
.كان علي رفض عرض الرقص معه

220
00:11:08,970 --> 00:11:11,790
.ليتني اكتشفت ذلك سريعًا

221
00:11:12,590 --> 00:11:13,950
بخصوص الأسطورة

222
00:11:14,430 --> 00:11:15,730
وبخصوص مشاعرك

223
00:11:16,980 --> 00:11:19,240
.وبخصوص مشاعري أيضا

224
00:11:26,380 --> 00:11:27,240
ميكو؟

225
00:11:28,010 --> 00:11:29,530
.لطالما انشغلت بهذا

226
00:11:30,080 --> 00:11:34,170
.عن تعاملك أنت ونينو والباقيتين مع فوتارو

227
00:11:35,120 --> 00:11:39,230
.اعتقدت أنه لن يكون من المناصفة أن أكون مميزة

228
00:11:41,110 --> 00:11:42,390
...هذا

229
00:11:42,390 --> 00:11:44,340
.لكنني اكتفيت من هذا

230
00:11:44,930 --> 00:11:46,490
.أريد احتكاره لنفسي

231
00:11:47,100 --> 00:11:49,640
.لا أستطيع الكذب على هذه المشاعر

232
00:11:50,340 --> 00:11:52,820
.لكن ليس الآن

233
00:11:55,240 --> 00:11:57,820
.أنا أحب فوتارو

234
00:11:58,310 --> 00:12:00,240
.لهذا سأفعل ما يحلو لي

235
00:12:01,010 --> 00:12:06,600
.وبالمقابل، أنت والأخريات افعلن ما يحلو لكُن

236
00:12:07,320 --> 00:12:08,400
.فلن أخسر

237
00:12:17,390 --> 00:12:19,250
.إنه مقرف جدا

238
00:12:19,770 --> 00:12:21,250
حقا؟

239
00:12:21,250 --> 00:12:23,220
.لكن مفعوله عظيم

240
00:12:23,550 --> 00:12:24,570
.شكرا لك

241
00:12:25,200 --> 00:12:26,260
.لنذهب

242
00:12:26,840 --> 00:12:27,720
.أجل

243
00:12:29,120 --> 00:12:31,920
...لو أنني لم أتظاهر أني إيتشيكا

244
00:12:34,860 --> 00:12:35,940
.يوتسوبا

245
00:12:35,940 --> 00:12:38,010
هل جمعت أغراض أويسوغي-كن؟

246
00:12:40,570 --> 00:12:41,460
يوتسوبا؟

247
00:12:42,520 --> 00:12:45,210
.هذا كتيب أويسوغي-سان

248
00:12:45,820 --> 00:12:47,490
.مملوء بالتعليمات والمذكرات

249
00:12:48,190 --> 00:12:50,450
.لقد كان متحمسا للرحلة

250
00:12:51,040 --> 00:12:56,460
.لقد أرغمته على مرافقتي بينما هو مريض، وأفسدت الرحلة عليه

251
00:12:57,190 --> 00:12:59,210
.فعلت أمرا أندم عليه

252
00:13:00,150 --> 00:13:03,950
في النهاية، لا سبيل لنا لمعرفة ما شعر به

253
00:13:03,950 --> 00:13:05,920
.أو ما فكر فيه

254
00:13:06,340 --> 00:13:09,180
.إلا إن سألناه

255
00:13:12,000 --> 00:13:15,230
.لكن الأكيد أن هذا لم يضع هباءً

256
00:13:15,620 --> 00:13:17,610
:قصص لرايها

257
00:13:17,610 --> 00:13:19,270
.لعبة التوائم في السيارة

258
00:13:19,840 --> 00:13:22,230
.إختبار الشجاعة التي ساعدتني فيه يوتسوبا

259
00:13:22,640 --> 00:13:26,990
.توقع: التزلج في اليوم الثالث
(من المفترض أن تعلمني يوتسوبا)

260
00:13:27,670 --> 00:13:28,680
.قصص مفاجئة

261
00:13:28,680 --> 00:13:30,530
أتظنين أن هذا صحيح؟

262
00:13:30,530 --> 00:13:34,480
.قالت ميكو أن هذه نهاية بائسة، لكنه استمتع فعلا

263
00:13:35,250 --> 00:13:36,210
من يدري؟

264
00:13:37,220 --> 00:13:39,170
.سأسأل أويسوغي-سان

265
00:13:40,030 --> 00:13:41,310
الآن؟

266
00:13:41,310 --> 00:13:43,670
.لن يتم الإمساك بي إن دخلت خلسة

267
00:13:44,580 --> 00:13:49,470
.صريحة جدا. آمل أن أصير مثلها

268
00:13:59,080 --> 00:14:00,360
.يا رئيس

269
00:14:00,360 --> 00:14:01,510
يا رئيس؟

270
00:14:02,010 --> 00:14:03,610
!ما-ماذا؟

271
00:14:03,940 --> 00:14:06,620
.نار المخيم على وشك الانتهاء

272
00:14:06,620 --> 00:14:08,370
هلا ساعدتني؟

273
00:14:08,370 --> 00:14:09,610
.حسنا

274
00:14:09,960 --> 00:14:11,200
كنت نائما، صحيح؟

275
00:14:14,550 --> 00:14:16,760
،حاولت تقليد يوتسوبا

276
00:14:16,760 --> 00:14:19,250
لكن التسلل بينما الأستاذ نائم

277
00:14:19,890 --> 00:14:22,180
ربما كان أمرا جريئا جدا مني؟

278
00:14:23,640 --> 00:14:27,770
.لكنني لا أستطيع تركه وحيدًا

279
00:14:29,480 --> 00:14:31,510
.علي إشعال الضوء أولا

280
00:14:33,230 --> 00:14:36,390
.متأكدة أن زر إشعال الضوء هنا

281
00:14:47,650 --> 00:14:49,070
!جميعكن هنا؟

282
00:14:49,380 --> 00:14:50,800
.اهدئي

283
00:14:50,800 --> 00:14:52,820
لماذا أنتن هنا؟

284
00:14:53,130 --> 00:14:54,620
لماذا أنت بالضبط هنا؟

285
00:14:55,080 --> 00:14:59,120
.فكرت بإعارته تعويذة الحماية هذه فقط

286
00:14:59,120 --> 00:15:02,680
نحن أتينا لأننا كنا قلقتين بشأنه، صحيح؟

287
00:15:02,680 --> 00:15:03,340
.أجل

288
00:15:05,310 --> 00:15:07,020
.هذا يسعدني قليلا

289
00:15:07,020 --> 00:15:09,730
.جميعنا فكرنا بنفس الشيء

290
00:15:09,730 --> 00:15:12,300
.قلت إنني لست كذلك

291
00:15:12,300 --> 00:15:14,050
.عنيدة جدا

292
00:15:19,610 --> 00:15:24,480
.أويسوغي-كن، جميعنا نتمنى لك الشفاء

293
00:15:25,450 --> 00:15:30,240
،لا أدري أي نوع من الأشخاص أنت بعد

294
00:15:30,510 --> 00:15:34,070
...لذا عندما تستيقظ، هلا

295
00:15:34,910 --> 00:15:36,260
أخبرتني أكثر عنك رجاء؟

296
00:15:41,340 --> 00:15:43,960
.إنها اللحظة الأخيرة من نار المخيم

297
00:15:45,290 --> 00:15:47,450
.جميعكم انضموا معنا في العد التنازلي

298
00:15:48,320 --> 00:15:49,550
...استعداد

299
00:15:49,930 --> 00:15:51,300
عشرة

300
00:15:51,300 --> 00:15:52,340
تسعة

301
00:15:52,750 --> 00:15:53,970
ثمانية

302
00:15:54,220 --> 00:15:55,390
سبعة

303
00:15:55,760 --> 00:15:56,740
ستة

304
00:15:57,210 --> 00:15:58,380
خمسة

305
00:15:58,820 --> 00:15:59,950
أربعة

306
00:16:00,400 --> 00:16:01,310
ثلاثة

307
00:16:01,950 --> 00:16:03,060
اثنان

308
00:16:03,420 --> 00:16:04,600
واحد

309
00:16:05,160 --> 00:16:06,820
!صفر

310
00:16:30,320 --> 00:16:31,280
.مرحبا

311
00:16:36,030 --> 00:16:38,220
!كيف لك أن تنساه؟

312
00:16:38,560 --> 00:16:41,020
...سأحضره، لكن

313
00:16:42,880 --> 00:16:45,230
ماذا؟ هل كان هذا فوتارو؟

314
00:16:45,230 --> 00:16:48,170
.لقد نسي خاتم الزفاف في المنزل

315
00:16:48,170 --> 00:16:50,430
أي عريس قد يفعل هذا؟

316
00:16:50,890 --> 00:16:52,740
.من شابه أباه فما ظلم

317
00:16:52,740 --> 00:16:54,570
!ليس الوحيد؟

318
00:16:57,050 --> 00:16:57,970
.لقد قررت

319
00:16:59,810 --> 00:17:03,860
.سأتزوج شخصا أفضل منكما

320
00:17:03,860 --> 00:17:04,580
!لن أسمح لك

321
00:17:04,940 --> 00:17:07,250
!لا تتركيني وحيدا

322
00:17:07,560 --> 00:17:10,250
ليس لك حبيب بعد، صحيح؟

323
00:17:11,720 --> 00:17:16,220
.وأخي كعادته لا يهتم بشيء آخر غير العمل

324
00:17:16,610 --> 00:17:20,000
لكنه أفضل حالا مما كان عليه لما كان طالبا، صحيح؟

325
00:17:20,000 --> 00:17:21,180
...أجل، ولكن

326
00:17:22,010 --> 00:17:25,390
.قلقة من ألا يصير زوجا يعتمد عليه

327
00:17:28,680 --> 00:17:29,520
...مهلا مهلا

328
00:17:29,520 --> 00:17:31,420
أهذا كل ما لدينا على الفطور؟

329
00:17:31,420 --> 00:17:33,490
ألهذه الدرجة مالنا قليل؟

330
00:17:33,490 --> 00:17:35,240
.أجل، لكن هذا ليس السبب

331
00:17:35,240 --> 00:17:37,690
.سيكون من الإسراف أن نأكل كثيرا الآن

332
00:17:39,070 --> 00:17:42,460
.فغداء اليوم وليمة

333
00:18:00,250 --> 00:18:02,460
.تبدو كقلعة

334
00:18:05,980 --> 00:18:07,880
كيف حدث هذا؟

335
00:18:09,280 --> 00:18:10,810
.فعلا

336
00:18:10,810 --> 00:18:12,290
.ربما كان خطأ

337
00:18:14,920 --> 00:18:17,580
على الواحد أن يغير ثيابه بهذا الكم في يوم واحد؟

338
00:18:20,820 --> 00:18:23,990
.أتساءل هل سيأتي يوم ألبس فيه هذا

339
00:18:25,260 --> 00:18:26,710
.سأعقد شعرك

340
00:18:41,480 --> 00:18:42,760
.ها هو ذا

341
00:18:45,690 --> 00:18:48,770
ألا يعلم أن هذا يوم مميز؟

342
00:18:49,080 --> 00:18:51,370
.أنت على وشك الزواج كما تعلم

343
00:18:51,370 --> 00:18:55,020
.أنت واقعي بالزيادة يا أخي

344
00:18:56,330 --> 00:18:59,540
...ربما هو لا... يهتم

345
00:19:03,470 --> 00:19:04,880
.هذا يعيد الذكريات

346
00:19:05,890 --> 00:19:08,350
.مازال يحمله معه

347
00:19:10,840 --> 00:19:14,120
.مبارك لك الزواج يا أخي

348
00:19:15,880 --> 00:19:18,050
.العريس يدخل

349
00:19:32,160 --> 00:19:33,200
سلام

350
00:19:33,200 --> 00:19:34,690
.أويسوغي-كن

351
00:19:35,380 --> 00:19:36,130
.مرحبا

352
00:19:36,130 --> 00:19:37,370
.مبارك لك

353
00:19:39,840 --> 00:19:42,080
.ماذا؟ إنه أنا

354
00:19:42,080 --> 00:19:43,070
!لا تقل إنك لا تذكرني؟

355
00:19:43,960 --> 00:19:45,560
.بالطبع أذكرك

356
00:19:45,560 --> 00:19:46,490
أنت مايدا، صحيح؟

357
00:19:46,930 --> 00:19:47,980
.كلاكما

358
00:19:50,110 --> 00:19:51,490
.لم يتغير البتة

359
00:19:51,980 --> 00:19:52,750
.فعلا

360
00:19:53,230 --> 00:19:56,730
.لكنه إله الحب الذي جمعنا

361
00:19:57,460 --> 00:19:59,800
أسطورة المخيم المدرسي؟

362
00:20:00,640 --> 00:20:01,600
.هذا يعيد الذكريات

363
00:20:01,600 --> 00:20:03,040
.أ-أجل

364
00:20:03,800 --> 00:20:05,340
بالمناسبة، أتعلمين؟

365
00:20:06,020 --> 00:20:08,850
...في الحقيقة، وقتها أويسوغي وعروسته أيضا

366
00:20:09,600 --> 00:20:13,350
.في الحقيقة لا أذكر جيدا ما حدث ذلك اليوم

367
00:20:13,730 --> 00:20:19,360
.رغم أن المخيم المدرسي كان مليئا بالمصائب إلا أنه أعجبني بشكل غريب

368
00:20:20,140 --> 00:20:22,360
.والآن العروسة تدخل

369
00:20:40,900 --> 00:20:42,480
.أسطورة الارتباط

370
00:20:43,820 --> 00:20:52,290
الاثنان اللذان يظلان ممسكا يدي بعضهما
.في اللحظة الأخيرة من نار المخيم سيرتبطان في حياتهما للأبد

371
00:20:56,520 --> 00:20:59,770
ربما بسبب تواجدهن هناك وقتها، جعل من هذه الذكريات الحلوة المريرة

372
00:20:59,770 --> 00:21:01,630
.تبدو ذكريات سعيدة

373
00:21:20,480 --> 00:21:23,120
لقد صمدت وقتها أيضا، صحيح؟

374
00:21:23,120 --> 00:21:25,690
.لم أعر للأمر أي اهتمام

375
00:21:25,690 --> 00:21:29,760
.توقف عن التكلم بطريقة لا تناسب شخصيتك وعد كما كنت

376
00:21:30,260 --> 00:21:32,910
.خمستنا إلى جانبك

377
00:21:32,910 --> 00:21:35,780
.فلتشفك طاقتي

378
00:21:36,280 --> 00:21:40,270
ما الذي شعرت به في هذا المخيم؟

379
00:21:43,750 --> 00:21:44,780
.لقد استيقظ

380
00:21:44,780 --> 00:21:46,240
أتشعر بالتحسن الآن؟

381
00:21:46,240 --> 00:21:47,950
!أدت التعويذة مفعولها

382
00:21:47,950 --> 00:21:48,780
.عاد للحياة

383
00:21:48,780 --> 00:21:50,160
.لقد أخفتني

384
00:21:50,160 --> 00:21:51,780
.لقد فاجأني

385
00:21:51,780 --> 00:21:52,790
.اخرسن

386
00:21:58,800 --> 00:22:00,200
!اخرسن

387
00:22:00,200 --> 00:22:02,020
!لا أستطيع النوم

388
00:22:03,420 --> 00:22:05,400
.أويسوغي-سان غاضب

389
00:22:05,400 --> 00:22:06,790
.إنه بخير الآن

390
00:22:07,550 --> 00:22:12,260
!انقلعن من هنا حالا

391
00:22:20,690 --> 00:22:22,590
...ربما أستطيع قول هذا الآن

392
00:22:28,160 --> 00:22:30,300
.ما لم أستطع قوله حينها

393
00:22:35,170 --> 00:22:38,720
.شكرا لأنك بقيت بجانبي

394
00:22:49,280 --> 00:22:51,300
.فوتارو-كن

395
00:22:49,280 --> 00:22:51,300
.أويسوغي-سان

396
00:22:52,520 --> 00:22:53,600
.أنتن

397
00:22:53,600 --> 00:22:55,510
.صباح الخير

398
00:22:56,350 --> 00:22:57,100
.أهلا

399
00:22:59,310 --> 00:23:01,070
أتشعر بتحسن الآن؟

400
00:23:01,070 --> 00:23:01,820
.أجل

401
00:23:01,820 --> 00:23:04,520
.علي تعويض الوقت الذي قضيته في المستشفى

402
00:23:05,890 --> 00:23:08,030
.سأعيرها لك لمزيد من الوقت

403
00:23:08,640 --> 00:23:10,040
أقلت شيئا؟

404
00:23:10,040 --> 00:23:11,160
.لا شيء

405
00:23:11,160 --> 00:23:12,920
.أنت تأكلين كثيرا يا إيتسوكي

406
00:23:13,830 --> 00:23:16,410
أشعر بالجوع في الصباح

407
00:23:17,250 --> 00:23:18,410
وجدتها

408
00:23:18,410 --> 00:23:20,440
،للاحتفال بشفاء فوتارو-كن

409
00:23:20,440 --> 00:23:22,290
...لنذهب لمحل الكريب بعد الدوام المدرسي

410
00:23:22,290 --> 00:23:24,160
سندرس بالطبع، صحيح؟

411
00:23:25,300 --> 00:23:29,950
.فوتارو، ساعدنا كثيرا في الدراسة

412
00:23:31,110 --> 00:23:33,220
الدراسة معا؟

413
00:23:33,220 --> 00:23:34,550
.لنبذل ما بوسعنا

414
00:23:34,820 --> 00:23:36,810
.مهلا، أنا لم أوافق

415
00:23:36,810 --> 00:23:39,150
.إذن لندرس جميعا من دون نينو

416
00:23:40,120 --> 00:23:42,320
.لم أقل إنني لن أنضم

417
00:23:42,320 --> 00:23:46,550
.أويسوغي-كن، سنكون تحت رعايتك

418
00:23:48,770 --> 00:23:49,500
.أجل

419
00:23:49,980 --> 00:23:52,990
.الاختبارات النهائية على الأبواب، سأكون صارما معكن

420
00:23:56,330 --> 00:23:58,110
!هل أنتن مستعدات

421
00:23:58,110 --> 00:23:59,160
!اهربن