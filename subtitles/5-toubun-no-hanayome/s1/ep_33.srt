!لنذهب إلى التزلج

181
00:12:55,530 --> 00:12:58,860
!لنتزلج كل المنحذرات

182
00:12:58,860 --> 00:13:01,250
.بردان. دعيني أنام

183
00:13:01,730 --> 00:13:03,780
.كما أنني لا أستطيع التزلج

184
00:13:03,780 --> 00:13:05,790
.النوم مضيعة للوقت

185
00:13:05,790 --> 00:13:09,300
.إذا لا تستطيع التزلج، فسأمسك يديك وأعلمك

186
00:13:11,070 --> 00:13:13,310
!حسنا، لنتمرن

187
00:13:14,620 --> 00:13:16,940
بالمناسبة، أين الغبيات الأربعة؟

188
00:13:17,500 --> 00:13:21,400
.إيتشيكا مريضة وإيتسوكي تعتني بها

189
00:13:21,700 --> 00:13:25,300
.متوقع بعد كل الذي حدث

190
00:13:25,300 --> 00:13:25,900
ماذا؟

191
00:13:26,470 --> 00:13:29,620
.عليك التأكد بمن في المستودع قبل إغلاقه

192
00:13:29,920 --> 00:13:32,320
ماذا؟ عمَّ تتحدث؟

193
00:13:32,320 --> 00:13:33,400
.لا شيء

194
00:13:33,400 --> 00:13:35,800
.نينو تتزلج حاليا

195
00:13:37,480 --> 00:13:38,810
.ها قد وصلت

196
00:13:39,830 --> 00:13:40,660
من أنتِ؟

197
00:13:41,800 --> 00:13:42,560
.ميكو

198
00:13:43,780 --> 00:13:44,750
ميكو؟

199
00:13:45,330 --> 00:13:48,170
.من صعب حقا التفرقة بينكن من الوجوه فقط

200
00:13:55,960 --> 00:13:57,450
.كانت سقطة مثيرة

201
00:13:58,580 --> 00:14:00,300
هل أنت بخير يا ميكو؟

202
00:14:05,120 --> 00:14:07,220
.أجل، أنا بخير

203
00:14:08,890 --> 00:14:12,160
،حسنا! دائما ما كنت الشخص الذي يُدرّس

204
00:14:12,160 --> 00:14:15,100
!لكنني سأكون معلمتكما اليوم

205
00:14:21,230 --> 00:14:23,250
.تبدو خائفا

206
00:14:24,880 --> 00:14:26,090
.مرحبا

207
00:14:26,090 --> 00:14:27,770
.الجو بارد حقا

208
00:14:30,610 --> 00:14:32,160
جديا، من أنتِ؟

209
00:14:34,160 --> 00:14:35,950
.إنها أنا، إيتشيكا

210
00:14:35,950 --> 00:14:37,060
.هذا أنتِ

211
00:14:38,670 --> 00:14:40,400
!إيتشيكا

212
00:14:40,400 --> 00:14:42,400
هل أنتِ بخير حقا؟

213
00:14:45,280 --> 00:14:48,000
.نعم، لكن ليس تماما

214
00:14:48,000 --> 00:14:49,580
صحيح، أين إيتسوكي؟

215
00:14:49,580 --> 00:14:51,390
ألم تكن تعتني بك؟

216
00:14:52,370 --> 00:14:56,540
.إنها تتزلج لوحدها لأنها تواجه صعوبة في مواجهتك

217
00:14:57,860 --> 00:14:59,360
!إيتشيكا

218
00:14:59,360 --> 00:15:02,460
!هذا الاثنان لا يحفظان شيئًا مما أعلمهما إياه

219
00:15:02,460 --> 00:15:05,300
!هذا نفس شعوري عندما أدرسك

220
00:15:07,170 --> 00:15:09,240
.لنتعلم بطريقة أمتع إذن

221
00:15:10,000 --> 00:15:11,550
.لنلعب لعبة المطاردة

222
00:15:11,550 --> 00:15:13,090
.يوتسوبا هي الأفضل في هذا، لذا ستكون المطاردة

223
00:15:13,740 --> 00:15:15,230
.حسنا

224
00:15:15,230 --> 00:15:16,920
ماذا عن نينو وإيتسوكي؟

225
00:15:16,920 --> 00:15:19,610
.سأمسك بهما لحظة أجدهما طبعا

226
00:15:19,610 --> 00:15:24,740
...واحد، اثنان، ثلاثة، أربعة

227
00:15:22,140 --> 00:15:23,150
!مهلا

228
00:15:23,760 --> 00:15:27,150
.سحقا، للتو تعلمت التزلج بشكل مستقيم فقط

229
00:15:28,140 --> 00:15:31,700
.مهلا، قد تكون هذه فرصتي لشرح الأمر لميكو

230
00:15:31,960 --> 00:15:33,820
...ميكو، هل

231
00:15:34,400 --> 00:15:35,330
!مهلا لحظة

232
00:15:35,620 --> 00:15:37,150
!انتظري يا ميكو

233
00:15:39,450 --> 00:15:42,180
متى أصبحت بارعة في التزلج؟

234
00:15:48,800 --> 00:15:50,060
.هذا سيئ

235
00:15:50,510 --> 00:15:53,010
.هنالك أمر أود التأكد منه

236
00:15:53,010 --> 00:15:53,950
.إيتشيكا

237
00:15:54,680 --> 00:15:57,340
لم تخبر أحدا عن الليلة الماضية، صحيح؟

238
00:16:01,140 --> 00:16:03,700
.قد أترك المدرسة

239
00:16:05,380 --> 00:16:07,050
كيف لي أن أخبر أحدا ذلك؟

240
00:16:07,520 --> 00:16:08,540
...أتعني

241
00:16:09,140 --> 00:16:09,860
...إيتشيكا

242
00:16:11,320 --> 00:16:13,320
كيف أتوقف؟

243
00:16:14,660 --> 00:16:15,360
ماذا؟

244
00:16:18,450 --> 00:16:20,350
!أويسوغي-كن

245
00:16:34,590 --> 00:16:35,830
يوتسوبا

246
00:16:35,830 --> 00:16:38,180
.عندما تعلمين أحدا، فعلميه كل شيء

247
00:16:39,010 --> 00:16:41,590
هل أنت بخير؟

248
00:16:41,590 --> 00:16:43,090
هل أنت حي؟

249
00:16:43,090 --> 00:16:45,760
.أ-أنا بخير

250
00:16:45,760 --> 00:16:47,150
.لا تبالوا بي

251
00:16:48,560 --> 00:16:50,650
.لقد لفت الانتباه

252
00:16:51,320 --> 00:16:55,240
،ربما هذا بسبب عدم استعادتي لتعويذة حماية رايها

253
00:16:55,240 --> 00:16:57,530
.حظي تعيس منذ يوم أمس

254
00:17:02,000 --> 00:17:03,680
...هذه الضمادة

255
00:17:04,630 --> 00:17:06,580
أهذا أنت يا كينتارو-كن؟

256
00:17:07,540 --> 00:17:09,540
أنت هو، صحيح؟

257
00:17:11,610 --> 00:17:12,050
ماذا؟

258
00:17:12,050 --> 00:17:13,140
.لا، لست هو

259
00:17:13,140 --> 00:17:15,130
ما هذا الاسم الغريب يا ترى؟

260
00:17:15,130 --> 00:17:16,190
.لا تكذب

261
00:17:16,190 --> 00:17:18,680
.لأنك الوحيد الذي وضعت عليه هذه الضمادة

262
00:17:19,350 --> 00:17:20,390
.هذا سيئ

263
00:17:20,390 --> 00:17:21,640
ماذا أفعل؟

264
00:17:23,570 --> 00:17:25,390
لماذا تهرب؟

265
00:17:26,280 --> 00:17:28,150
هل أخبرها الحقيقة الآن؟

266
00:17:28,800 --> 00:17:31,990
هل أخبرها أنني كذبت عليها البارحة في اختبار الشجاعة؟

267
00:17:33,020 --> 00:17:35,150
!مهلا لحظة

268
00:17:36,320 --> 00:17:39,100
كيف لي إنهاء هذا سلميا؟

269
00:17:40,600 --> 00:17:42,380
!اللعنة! إنها يوتسوبا

270
00:17:43,400 --> 00:17:46,290
!ها قد وجدتك يا أويسوغي-سان

271
00:17:49,680 --> 00:17:51,320
!كينتارو-كن

272
00:17:51,770 --> 00:17:53,670
!أويسوغي-سان

273
00:17:58,200 --> 00:17:59,340
.أحس بالدوار

274
00:18:00,090 --> 00:18:01,720
!كينتارو-كن

275
00:18:00,090 --> 00:18:01,720
!أويسوغي-سان

276
00:18:01,720 --> 00:18:02,600
ماذا؟

277
00:18:03,110 --> 00:18:04,470
.يوتسوبا

278
00:18:04,470 --> 00:18:05,850
.وجدتك يا نينو

279
00:18:06,080 --> 00:18:09,010
أمر عليك فتى أشقر؟

280
00:18:09,010 --> 00:18:11,980
وأنت يا نينو، هل مر عليك أويسوغي-سان؟

281
00:18:12,380 --> 00:18:13,880
.غريب

282
00:18:13,880 --> 00:18:15,780
إلى أين ذهب؟

283
00:18:17,730 --> 00:18:18,690
.ميكو

284
00:18:20,200 --> 00:18:22,940
.كان ذلك وشيكا؛ كادت تمسك بك

285
00:18:24,750 --> 00:18:26,870
أهذا كوخ ثلجي؟

286
00:18:26,870 --> 00:18:28,290
هل أنتِ من بنيته؟

287
00:18:28,290 --> 00:18:31,340
.لا، لقد كان مبنيا

288
00:18:31,850 --> 00:18:32,860
.حقا

289
00:18:34,570 --> 00:18:36,560
.المكان دافئ

290
00:18:38,060 --> 00:18:39,700
...فـ-فوتارو

291
00:18:40,950 --> 00:18:43,680
.المكان ضيق، فلا تتحرك كثيرا

292
00:18:44,510 --> 00:18:45,840
.آسف

293
00:18:46,520 --> 00:18:48,390
.سأخرج الآن إذن

294
00:18:51,960 --> 00:18:53,460
.لا تخرج بعد

295
00:18:55,780 --> 00:18:58,380
.لا أدري ما بي

296
00:18:58,980 --> 00:18:59,950
ميكو؟

297
00:19:05,310 --> 00:19:08,480
.أ-أعني، قد تكون يوتسوبا مازالت عند مدخل الكوخ

298
00:19:08,950 --> 00:19:10,280
.معك حق

299
00:19:10,280 --> 00:19:12,260
.سأبقى لمدة أطول إذن

300
00:19:12,870 --> 00:19:13,540
.أجل

301
00:19:16,020 --> 00:19:19,130
لكن من أين أتت بقدرة الاحتمال اللانهاية تلك يا ترى؟

302
00:19:20,540 --> 00:19:23,540
.لا أكاد أصدق أنها واحدة منكن أنتن التوائم

303
00:19:23,540 --> 00:19:26,930
.كانت لتمسك بي لو أن هذا الكوخ لم يكن هنا أيضا

304
00:19:27,220 --> 00:19:30,190
.توقف الاهتمام بالتزلج في المنتصف

305
00:19:31,040 --> 00:19:33,600
لماذا أفعل هذا؟

306
00:19:34,740 --> 00:19:35,940
...حسنا إذن

307
00:19:36,450 --> 00:19:38,130
كيف سنهرب منها الآن؟

308
00:19:38,730 --> 00:19:39,910
...لنرى

309
00:19:41,200 --> 00:19:42,450
.وجدتها

310
00:19:42,890 --> 00:19:45,310
.لنضع عائقا ليوتسوبا

311
00:19:45,310 --> 00:19:46,200
عائق؟

312
00:19:46,520 --> 00:19:50,740
.لنجعلها تحمل أمتعة لتصبح سرعتها مساوية لنا

313
00:19:51,350 --> 00:19:53,960
.سيصبح الأمر أمتع هكذا فعلا

314
00:19:54,280 --> 00:19:55,640
...-أجل، إذن لـ

315
00:19:55,640 --> 00:19:57,960
.لكنها لا تروقني

316
00:20:02,500 --> 00:20:06,700
أنتن الخمسة كنتن بنفس القدرات الجسدية، صحيح؟

317
00:20:06,700 --> 00:20:07,990
.فأنتن توائم

318
00:20:09,440 --> 00:20:14,190
.مما يعني أن يوتسوبا اكتسبت التفوق بالرياضة بنفسها

319
00:20:16,790 --> 00:20:18,100
.هذا صحيح

320
00:20:18,560 --> 00:20:21,740
...أعلم أن هذه للعبة، لكنني

321
00:20:22,640 --> 00:20:25,030
.لا أريد دحض ذلك المجهود

322
00:20:28,330 --> 00:20:31,230
.لأن أي شخصٍ يفعل ذلك يعني أنه يريد أن يحتكر ذلك الشخص لنفسه

323
00:20:32,070 --> 00:20:33,820
أمتأكدة من قرارك بأن أرقص معه؟

324
00:20:33,820 --> 00:20:36,560
.لن أقلق إن كانت إيتشيكا رفيقته

325
00:20:36,560 --> 00:20:38,000
ماذا كنتما تفعلان هنا؟

326
00:20:38,360 --> 00:20:39,360
.لنجعل الأمر متساويا

327
00:20:39,840 --> 00:20:42,010
.فلتكوني أنتِ شريكته

328
00:20:43,480 --> 00:20:45,470
،أن تكن متساويات لأمر جيد

329
00:20:45,470 --> 00:20:47,850
.لكن لا يمكنك دحض مجهود بذلته إحداكن

330
00:20:48,860 --> 00:20:51,330
.دعينا نكن عادلين، لا متساوين

331
00:21:01,840 --> 00:21:03,400
...مـ-مهلا

332
00:21:03,760 --> 00:21:05,050
.مؤلم

333
00:21:06,060 --> 00:21:07,660
ماذا تفعلين؟

334
00:21:11,380 --> 00:21:13,180
."لنكن عادلين"

335
00:21:16,260 --> 00:21:18,820
ما هذا الذي أقوله يا ترى؟

336
00:21:19,590 --> 00:21:21,420
.الحرارة هنا تجنني

337
00:21:22,160 --> 00:21:23,720
.ذاهب لاستنشاق الهواء في الخارج

338
00:21:36,140 --> 00:21:38,310
!أويسوغي-سان

339
00:21:39,200 --> 00:21:41,420
.سأجدك مهما كلف الأمر

340
00:21:46,530 --> 00:21:49,370
إلى أين ذهب؟

341
00:21:51,320 --> 00:21:52,730
...كينتارو-كن

342
00:22:10,110 --> 00:22:12,190
ما الأمر يا ميكو؟ ماذا تريدين؟

343
00:22:13,480 --> 00:22:15,500
...إيتشيكا

344
00:22:16,440 --> 00:22:18,200
.هناك ما أريد أن أحدثك به إياه

345
00:23:49,990 --> 00:24:05,010
العروسات الخمسة التوائم الحلقة القادمة من

346
00:23:51,300 --> 00:23:52,280
.فوتارو-كن

347
00:23:52,280 --> 00:23:53,960
!استيقظ يا أويسوغي

348
00:23:53,960 --> 00:23:54,990
.فوتارو

349
00:23:54,990 --> 00:23:56,780
!أويسوغي-سان

350
00:23:56,780 --> 00:23:58,300
.استيقظ يا أويسوغي-كن

351
00:23:58,920 --> 00:24:00,040
.فهمت

352
00:24:00,040 --> 00:24:02,210
.لقائي بالتوائم الخمس مجرد حلم إذن

353
00:24:02,210 --> 00:24:03,740
.مستحيل ذلك