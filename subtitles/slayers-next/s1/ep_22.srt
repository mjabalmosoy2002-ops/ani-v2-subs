1
00:00:08,380 --> 00:00:15,050
ســلايــرز

2
00:00:12,300 --> 00:00:15,050
التـــــالي

3
00:00:19,010 --> 00:00:22,000
memagurushii   jikan no mure ga

4
00:00:22,230 --> 00:00:25,570
hashiri nukeru   machi wa SABANNA

5
00:00:25,570 --> 00:00:29,150
mogaku you ni   nukedasu you ni

6
00:00:29,290 --> 00:00:32,540
kono chikara wo   tameshite mitakute

7
00:00:32,680 --> 00:00:36,240
kitto dokoka ni "kotae" aru

8
00:00:36,610 --> 00:00:39,480
umarete-kita kotae ga

9
00:00:40,040 --> 00:00:43,100
hito wa minna, sore wo motome

10
00:00:43,320 --> 00:00:46,520
yarusenai   nogasenai

11
00:00:46,520 --> 00:00:49,140
yume ni mukau no

12
00:00:49,220 --> 00:00:53,100
kizutsuku koto wa kowakunai

13
00:00:53,150 --> 00:00:56,350
dakedo kesshite tsuyokunai

14
00:00:56,480 --> 00:00:59,970
tada, nanimo shinai mama de

15
00:00:59,970 --> 00:01:03,330
kuyandari wa shitakunai

16
00:01:03,410 --> 00:01:06,700
Here we go! go!   hashiri-tsudzukeru

17
00:01:06,700 --> 00:01:10,380
dare ni mo tomerare wa shinai

18
00:01:10,450 --> 00:01:13,640
mirai no jibun e to

19
00:01:13,710 --> 00:01:17,620
Give a reason for life   todoketai

20
00:01:31,500 --> 00:01:33,870
وأخيراً وصلنا إلى إنجيل كليـر الحقيقـي

21
00:01:34,040 --> 00:01:36,940
... وهنالك علمـت بما هيـة الهـدف الأسمـى

22
00:01:37,010 --> 00:01:39,130
! لإلـه الظـلام الذهبـي من آلـهـة الظـلام

23
00:01:39,210 --> 00:01:42,340
! حيـن ذلك هاجمنـا ملك التنيـن الشيطـاني جـاف مـرةً أخـرى

24
00:01:42,680 --> 00:01:46,410
... وبينمـا كـنت قادرةً على قتـل سيجـرام بسيف راجنـا المتقـن

25
00:01:46,480 --> 00:01:49,210
! هُــزم زيلـوس بهجـومِ جــاف

26
00:01:49,290 --> 00:01:53,380
! ليس سيـئاً، جــاف حـان وقـت لتسـوية الأمـور بيـننـا

27
00:01:53,750 --> 00:01:59,500
! سيــفُ النـور المســروق

28
00:01:53,750 --> 00:01:59,500
! نهــايــةُ ملكُ التنيـن الشيطـاني

29
00:02:09,070 --> 00:02:11,630
هجـومٌ عبـر المستـوى النجمــي

30
00:02:11,710 --> 00:02:14,540
قـررتُ إستعمـال هجـومك ضــدك يا زيلــوس

31
00:02:15,550 --> 00:02:18,950
حسـنٌ، حســنٌ، أشعـر بالإطـراء يا عـزيزي جـاف

32
00:02:19,650 --> 00:02:22,810
ومـع ذلك لازلت مدهشـاً كالعادة يا زيلـوس

33
00:02:23,020 --> 00:02:27,820
حتـى بعد تلقيـك لهجـومي، مازلت حياً

34
00:02:28,160 --> 00:02:33,960
بالرغـم من أنـه سيستغـرق وقتـاً للتعافـي ممـا قمـتَ بـه نحـوي

35
00:02:34,830 --> 00:02:36,590
محـق تمـامــاً

36
00:02:39,100 --> 00:02:40,230
... في هـذه الحالـة

37
00:02:40,300 --> 00:02:42,860
لمَ لا تتقبـل هزيمتـك و تخبــرني ؟

38
00:02:42,940 --> 00:02:46,710
مـا هـي خطـة سيد الجحيم؟، وما الذي ينـوي فعـله ؟

39
00:02:48,850 --> 00:02:50,510
...إنه

40
00:02:50,910 --> 00:02:52,510
إنه مـاذا ؟

41
00:02:52,580 --> 00:02:53,550
! زيلــوس

42
00:02:53,620 --> 00:02:55,410
! أخبــرني

43
00:02:59,790 --> 00:03:01,850
إنه سـر

44
00:03:05,430 --> 00:03:06,590
!ماذا ؟

45
00:03:06,700 --> 00:03:08,760
لقــد هــرب ؟

46
00:03:08,830 --> 00:03:12,320
في وقـتٍ كهـذا ؟، ما هـي حدود لامسئـوليـة ذلك الشخـص ؟

47
00:03:17,210 --> 00:03:19,970
في النهايـة، هـذا ما يفعلـه كل الوحوش

48
00:03:20,040 --> 00:03:24,410
لا يهتمـون إذا ما تركـوا رفاقهـم إن كان ذلك سينقـذ حياتهـم

49
00:03:25,450 --> 00:03:27,210
حسـناً، والآن

50
00:03:27,280 --> 00:03:31,850
لا أعلـم تمـاماً ما الذي ينـويـه سيد الجحيم

51
00:03:31,920 --> 00:03:34,950
ولكـن عليّ أن أفـسد خطتـه مهمـا كلفـني

52
00:03:40,800 --> 00:03:42,290
! لينـا

53
00:03:42,370 --> 00:03:46,500
! ياللسـوء، ذلكَ لأننـي إستعمـلتُ سيف راجنـا لأقضـيَ على سيجـرام

54
00:03:46,570 --> 00:03:48,730
لم إستعـد قـوتي بعـد

55
00:03:51,270 --> 00:03:56,910
عليّ القـول أننـي منبهرٌ بتمكنك من إربـاك خططي إلى الآن

56
00:03:56,980 --> 00:03:59,240
! آسـف، لكـن لابـد أن تمـوتي

57
00:04:00,350 --> 00:04:01,680
! لن أسمـحَ لك

58
00:04:02,490 --> 00:04:04,650
! أنـا حامـي هـذه الفتـاة

59
00:04:05,660 --> 00:04:07,560
لا أستطيـع الوقـوف و أدعك تفعـل ما تريـد

60
00:04:08,790 --> 00:04:10,590
! ولا حتـى أنــا

61
00:04:10,660 --> 00:04:12,750
إنهـا صـديقـتي

62
00:04:12,830 --> 00:04:16,660
مهمـا حـدث، لا أستطيـع موافقـتك على ما تخـططه له

63
00:04:17,630 --> 00:04:20,470
ذلك لأننـي بعكـس زيلـوس، أنـا بشــري

64
00:04:21,040 --> 00:04:22,900
جوري، زيــل

65
00:04:24,970 --> 00:04:30,910
شيء مضحـك، تخاطـران بحياتكمـا على الرغـم من أنكمـا ستخسـران

66
00:04:31,550 --> 00:04:35,310
أغلق فمك، نحـن نحـارب لأجـل حياتنـا هنـا

67
00:04:36,120 --> 00:04:38,250
أتظـن حقـاً أننـا سنستسلـم بهـذه السهـولة ؟

68
00:04:38,550 --> 00:04:40,920
لأجـل حياتكـم إذن ؟

69
00:04:40,990 --> 00:04:46,550
فهمت، مثلمـا أقاتـل بحيـاتي ضـد خـطط سيد الجحيم

70
00:04:47,330 --> 00:04:50,090
أنـا و أنتـم لســنا مختلفيـن

71
00:05:01,310 --> 00:05:06,270
لينـا، مهمـا حاولنـا القـول، فلـن نستطيـع هزيمـة ذلكَ الشخـص

72
00:05:06,350 --> 00:05:07,480
...زيــل

73
00:05:07,550 --> 00:05:12,040
أملـنا الوحيـد هـو تلك التعويـذة التي هزمـتي بهـا سيجـرام

74
00:05:12,150 --> 00:05:15,850
سنُكسبـكِ أنا و زيـل الوقـت الكافـي لتستعيـدي قـوتكِ

75
00:05:16,930 --> 00:05:17,890
.. جوري

76
00:05:21,360 --> 00:05:24,490
تحمـل سـلاحاً يثيـر الإهتمـام

77
00:05:26,840 --> 00:05:29,770
حسـنٌ، أعتقـد أننـا متشابهـون كثيـراً

78
00:05:29,840 --> 00:05:33,210
ما يعنـي أن تقبلـكم للمـوت بهـدوء خارج الحسبـان

79
00:05:33,580 --> 00:05:38,710
حسـناً، قاومـوني بقـدر ما تستطيعـون من أجـل حياتكــم

80
00:05:43,020 --> 00:05:44,490
! را تيلــت

81
00:05:52,560 --> 00:05:56,230
! تلكَ التعـويدة لم تؤذينـي بمثـل خـدشـة قطــة

82
00:05:56,470 --> 00:05:59,990
لقـد آلمتنـي، لكـننـي إستطعـتُ حمايـة نفسـي منهـا

83
00:06:03,510 --> 00:06:07,270
حـتى البشـري الذي يحمـل سيـف الضــوء ليس بنـدٍ لي

84
00:06:10,580 --> 00:06:11,510
! جــوري

85
00:06:14,420 --> 00:06:17,320
لا فائـدة ... لا أستطيـعُ الحركـة

86
00:06:17,750 --> 00:06:19,720
! وفي وقــتٍ كهـذا

87
00:06:21,160 --> 00:06:22,990
! داج هــاوت

88
00:06:26,660 --> 00:06:28,290
! أستــرال فايــن

89
00:07:08,100 --> 00:07:11,040
حاولتمـا جهـديكمـا كثيـراً كمجـرد بشـريـيـن

90
00:07:11,110 --> 00:07:12,730
كـان ذلكَ ممتعـاً جـداً

91
00:07:19,650 --> 00:07:22,980
ومع ذلك، فالأمور الجيـدة لابـد لها من نهايـة، أليسَ كذلك ؟

92
00:07:30,690 --> 00:07:31,720
!! سحقــاً لك

93
00:07:37,670 --> 00:07:39,070
جــوري

94
00:07:39,140 --> 00:07:40,330
! زيــل

95
00:07:42,170 --> 00:07:43,730
! دايناســت بــراس

96
00:07:48,940 --> 00:07:50,310
من هـناك ؟

97
00:07:50,380 --> 00:07:53,140
مهمـا قـد تبـدو قوتـك عظيمـة

98
00:07:53,220 --> 00:07:56,650
طالمـا أنها لا تستسلـم و تقاتـل بكـل ما لديهـا من قوة

99
00:07:56,720 --> 00:07:58,350
فالعـدالـة ستكـون المنتصـرة دومـاً

100
00:08:01,890 --> 00:08:04,590
! أميليــا؟؟ -
متــى تعافـت هـذه ؟؟ -

101
00:08:05,960 --> 00:08:07,620
وأنـا من كـنت قلـقاً عليهـا

102
00:08:07,700 --> 00:08:10,930
أميليـا، كيـف لكِ أن تكـوني لا مباليـة بشـأنه ؟

103
00:08:12,470 --> 00:08:16,500
آسـفٌ لتأخـري، سأداويـكِ الآن

104
00:08:19,780 --> 00:08:21,500
كونـي صبـورة لبعـض الوقـت

105
00:08:21,580 --> 00:08:25,450
آسـف كوني تأخـرت، لكـن تلكَ الفتـاة كانت إصابتهـا بغايـة الشـدة

106
00:08:26,380 --> 00:08:27,780
..  ميلجـاسيـا-سان

107
00:08:29,820 --> 00:08:33,760
والآن بما أننـي من تحمـل مهمـة العـدالة، وقـد تعافيـت

108
00:08:34,120 --> 00:08:36,490
! فلـن أدعـكَ تفلـتُ بهـذا

109
00:08:36,560 --> 00:08:38,580
! ما حـدث لي كـان بسـبب أنـني أُخـذتُ على حيـن غــرة

110
00:08:38,660 --> 00:08:40,420
فـوجئـتُ بكَ، يا مـن تنشــر الفوضـى في هـذا العالـم

111
00:08:40,500 --> 00:08:44,190
وقـد حـان الآن وقــت العقـاب، حضــر نفســك

112
00:08:45,530 --> 00:08:49,160
لا تُضحكيـني و إستمعِ جيـداً

113
00:08:49,240 --> 00:08:52,470
طالمـا أن لينـا تساعـد خـططَ سيد الجحيم عالمـةً بذلك

114
00:08:52,540 --> 00:08:55,570
والـتي هـي مصـدر الفوضـى في هـذا العالـم

115
00:08:55,640 --> 00:08:57,200
فصـديقـتكِ الجيـدة هـذه ضمـن الأشـرار

116
00:08:57,650 --> 00:09:00,080
ولكن ... في .. هــذا

117
00:09:00,150 --> 00:09:03,050
وكذلكَ، كونكِ حليفـة لهـا، فأنـتِ كـذلكَ تعتبـرين شـريـرة أيضـاً

118
00:09:03,250 --> 00:09:07,810
أنا شـريـرة ؟، لا !، ولكـن هـذا...

119
00:09:09,560 --> 00:09:11,750
يا إلهي، أظـن أميليـا في ورطـةٍ حقيقـية

120
00:09:11,830 --> 00:09:12,690
... يالســوء

121
00:09:12,760 --> 00:09:15,890
أكـره المنافقيـن الذيـن يتشـدقـون بكلمـة العدالـة هنا و هنـاك

122
00:09:16,000 --> 00:09:17,760
والآن إختفـــي

123
00:09:19,030 --> 00:09:19,690
... را تيـ

124
00:09:19,770 --> 00:09:20,860
! بطيـــئة

125
00:09:31,150 --> 00:09:32,140
... سيـد زيلجـديـس

126
00:09:32,210 --> 00:09:34,180
! ..سيـد زيلجـديس .. تماسـك

127
00:09:44,790 --> 00:09:46,460
أفهمتـم الآن ؟

128
00:09:46,530 --> 00:09:48,830
مهمـا كنتـم تعتقـدون أنكـم بصـف العـدالة

129
00:09:48,900 --> 00:09:51,730
فأمـام القـوة الطاغيــة

130
00:09:51,800 --> 00:09:53,600
أنتـم عاجـزون

131
00:10:10,420 --> 00:10:12,680
"إلـه الأحـلام الذي يرعــب"

132
00:10:12,760 --> 00:10:17,350
"يا سيف القسـوة و الظلام، حـرر نفسـك من أغلال السماوات"

133
00:10:17,430 --> 00:10:19,260
"وتوحـد مع قـوتي، توحـد مع جســدي"

134
00:10:19,330 --> 00:10:21,590
"ولنسلك مســار الدمــار ســويــا"

135
00:10:21,660 --> 00:10:24,790
"قـوةٌ يمكنهـا تدميـر حتى أرواح الآلهـــة"

136
00:10:25,370 --> 00:10:28,200
!  ســــيف راجنـــا

137
00:10:50,960 --> 00:10:55,230
لأسيطـر على السيـف يأخـذ الأمـر كل ذرةٍ من قـوة إرادتـي

138
00:10:59,170 --> 00:11:02,070
قــوة إلـه الكوابيـس إذن ؟

139
00:11:03,140 --> 00:11:08,080
ومع ذلكَ فهـذه التعويدة هـي الوحيدة الباقـية لأستعملهـا أنـا

140
00:11:11,920 --> 00:11:14,440
سأراهــن بكـل شـيء

141
00:11:15,120 --> 00:11:16,880
! على هـذه الهجمـة الواحـدة

142
00:11:22,530 --> 00:11:25,050
! حاولــي !، حاولــي فقـــط

143
00:11:25,430 --> 00:11:26,730
... سيــــف

144
00:11:27,930 --> 00:11:29,870
! ....  الظلمــــات

145
00:12:54,990 --> 00:12:57,950
! إنتصــرت .. لقـد إنتصــرت

146
00:13:08,300 --> 00:13:10,060
.. ميلجاسيــا-سان

147
00:13:15,970 --> 00:13:17,740
... شكـراً لك

148
00:13:22,680 --> 00:13:24,910
... جـوري .. يا رفــاق

149
00:13:28,550 --> 00:13:29,750
! آنسـة ليــنا

150
00:13:30,620 --> 00:13:32,180
... أميليـا

151
00:13:33,220 --> 00:13:35,280
... شكـراً يا إلهي ... أنـتِ بخيــر

152
00:13:41,200 --> 00:13:44,130
أيهـا الصبـي .. مـا الذي حـدث ؟

153
00:13:45,470 --> 00:13:47,770
أيهـا الصبـي ؟

154
00:13:55,780 --> 00:13:58,110
إستريحـي لمـدة أطـول، يا لينـا

155
00:13:58,180 --> 00:13:59,150
... جـوري

156
00:13:59,220 --> 00:14:00,550
لا عليكِ، لا تقـولي أيّ شـيء

157
00:14:04,720 --> 00:14:07,350
إنكِ بالفعـل فـريـدة عن بـقـية البشــر

158
00:14:11,700 --> 00:14:13,820
هــل ملك تنيـن الشيطـا جـاف ... ؟

159
00:14:13,900 --> 00:14:18,160
ما بك، لا يستطيـع أحـد النجـاة من هجـوم مثـل ذاك

160
00:14:18,240 --> 00:14:19,570
أظـن أنـكَ محــق

161
00:14:19,770 --> 00:14:22,470
يا رفاق، حـدث أمـرٌ فظـيع، ذلكَ الفتـى

162
00:14:24,580 --> 00:14:26,300
! لقـد إختفــى

163
00:14:26,380 --> 00:14:29,140
ذلكَ الفتـى ؟، ألم يكـن بصحبتـكِ ؟

164
00:14:29,210 --> 00:14:30,800
لقـد كان بجـواري إلى حتـى لحظـة مضـت

165
00:14:50,430 --> 00:14:54,100
شـيء ممتــع ... شـيء ممتــعٌ حقــاً

166
00:14:54,540 --> 00:14:58,030
يا إلهـي ... حـتى سيـف راجنـا المتقـن لم يؤثــر بـه

167
00:15:00,980 --> 00:15:02,470
! جــوري

168
00:15:03,580 --> 00:15:06,140
سأحـاول أن أمنـح الجميـع فرصـةً مـا

169
00:15:09,650 --> 00:15:11,450
! يا رفاق، أركــضـــوا

170
00:15:11,620 --> 00:15:13,610
!  بأقصـى سرعـة يا مارتينــا

171
00:15:14,690 --> 00:15:17,460
مـاذا ؟ هـل إنتهيتـم ؟

172
00:15:17,530 --> 00:15:19,690
!  إذن إسمحـوا لي بقتلكـم جميعـاً

173
00:15:48,260 --> 00:15:49,850
! ... أيهــا الـ

174
00:15:55,400 --> 00:15:57,630
!متـى أمكـنك؟

175
00:15:59,340 --> 00:16:02,000
كـنتُ هنـا طـوال الوقـت، يا ملك تنـين الشيطـان جــاف

176
00:16:02,440 --> 00:16:03,630
! يا فتــى

177
00:16:03,710 --> 00:16:08,410
ويبـدو أنـه بإستثنـاء زيلـوس، لم يعـرف أحـدٌ عن حقيقـتي على الإطـلاق

178
00:16:08,710 --> 00:16:11,610
لا ليـنا إينفـرس ... ولا حتـى أنـت

179
00:16:14,750 --> 00:16:16,450
مــن تكـون أنـت ؟

180
00:16:17,390 --> 00:16:20,480
آه صحيـح !، لم أخبـركم عن إسمـي قبـل

181
00:16:20,690 --> 00:16:24,890
"إسمـي هـو فيـبريـزو، ويمكـنكم أن تدعـوني بـ"سيد الجحيم

182
00:16:26,060 --> 00:16:30,330
لا يمكن، أنـتَ الوحش؟!، وحش آخــر

183
00:16:31,600 --> 00:16:34,930
أود القـول بأنه في النهايـة سيـد الدمـى قـد ظهـر أخيــراً

184
00:16:35,610 --> 00:16:38,800
لم ألاحـظ أننـا إلتقيـنا منـذ برهـة فحسـب ؟

185
00:16:41,580 --> 00:16:44,710
أو بعبـارةٍ أخـرى، أنـه تـم إستغفـالي بواسطـتك

186
00:16:45,250 --> 00:16:47,240
بواسطتك أنـت و زيلـوس

187
00:16:47,320 --> 00:16:50,290
! أن آخـذ هيئـة طفــلٍ مناســبٌ للغايــة

188
00:16:50,350 --> 00:16:52,080
أنتـم البشــر مضحكـون جداً

189
00:16:52,160 --> 00:16:55,220
فبهـذه الهيئـة لا يمكـنكم الشـكُ بـي مطلقـاً

190
00:17:00,830 --> 00:17:04,490
وأنتـم تصرفتـم كما توقعـتُ منكـم تحـديداً

191
00:17:04,770 --> 00:17:08,430
وحتـى جـاف ظهـرَ بالوقـتِ الذي توقعـتُ ظهـوره فيـه تمـاماً

192
00:17:10,110 --> 00:17:13,200
... وبفضـل كـون جـزءٍ من جسمـك النجمـي قـد قُسـم لهـذه الهيئـة

193
00:17:13,280 --> 00:17:15,800
فلـم تتمكـن من معرفـة ماهيـتي

194
00:17:16,150 --> 00:17:21,050
ظـننـتُ أن بإمكـاني تمزيـق الجـزء البشـري منـك

195
00:17:21,120 --> 00:17:24,710
لكـن يبدو أنكَ لن تكـون وحشاً تامـاً مـرةً أخـرى

196
00:17:25,520 --> 00:17:30,650
وبقـولي هـذا، فأشـك كثيـراً بأنك ستقسـم بالولاء التـام لـي

197
00:17:31,560 --> 00:17:35,730
! ممـا يعنـي أن الطريـق الوحيـد المتبقـي لي هـو قتلكَ على الفـور

198
00:17:35,800 --> 00:17:38,230
! .... أيهـا الـ

199
00:17:52,820 --> 00:17:54,810
! لا ... لا يمكــن

200
00:17:57,320 --> 00:18:00,260
... عـدو الآنسـة ليـنا و الذي لم يُقتــل

201
00:18:00,320 --> 00:18:02,690
! بسيـف رانجـا، و ذلكَ قام بذلك في ثانيـةٍ واحـدة

202
00:18:03,860 --> 00:18:07,060
أظـن بأن هـذا من ضمـن خطـتكَ أيضـاً، صحيـح ؟

203
00:18:07,130 --> 00:18:09,660
حسـنٌ، بشكـل رئيسـي

204
00:18:09,900 --> 00:18:13,170
لقـد أفشيـتُ لخدمـه بأنـنـي كنتُ أخـططُ لشـيء مـا

205
00:18:13,240 --> 00:18:17,040
يتضمـن إستخـدام لينـا إينفـرس، وبهـذا بـدأ الأمـر كلــه

206
00:18:17,510 --> 00:18:20,970
وبعدها، أرسـلت زيلـوس ليوجهـنا نحـو الإتجـاه الصحيـح

207
00:18:21,040 --> 00:18:23,640
وجعلتنـا نفسـد خـطط جـاف كلهـا من أجـلك

208
00:18:23,710 --> 00:18:27,950
وعنـد إذن تأتـي أنت بالنهايـة تقضـي على جـاف بنفسـك

209
00:18:28,320 --> 00:18:31,010
إنهـا مهمـةٌ سهلـة بالنسبـة لك

210
00:18:31,960 --> 00:18:33,150
أظـن هـذا

211
00:18:33,220 --> 00:18:35,820
لحظـة، ماذا ؟

212
00:18:35,890 --> 00:18:40,590
وبعبـارة أخـرى، إستعملـتنا كطعـم لإستـدراج جـاف، الوحش الخـائن

213
00:18:41,230 --> 00:18:43,200
صحيـح، كـان هـذا واحـدٌ من أسـبابي

214
00:18:43,270 --> 00:18:44,230
واحـدٌ منهـم ؟

215
00:18:44,300 --> 00:18:46,170
أتعنـي بأن هناك سبـبـاً آخــر ؟

216
00:18:46,240 --> 00:18:49,400
ظـننـتُ أنكـم عرفتمـوه فعلاً

217
00:18:49,470 --> 00:18:52,500
وخاصـةً لينـا إينفـرس، والتي لامـست إنجيـل كليـر الحقيقـي

218
00:18:54,180 --> 00:18:57,270
تدميــر العالـم، تدميـر كـل شـيء

219
00:18:57,350 --> 00:18:59,370
ليعـود كـل شـيء بإتجـاه الفـوضـى

220
00:18:59,450 --> 00:19:01,920
هـذا هـو الهـدف الأسمـي للعـرق الوحوش

221
00:19:02,750 --> 00:19:06,240
ولأجـل ذلك نحتـاج إليـكِ، ليـنا إينفـرس

222
00:19:07,360 --> 00:19:12,290
كنـتُ آمـل بأن تلعبـي بالورقة الأخيـرة حينمـا تواجهـتي مع جـاف

223
00:19:12,560 --> 00:19:14,390
خــاب أمـلي كثيــراً

224
00:19:15,600 --> 00:19:21,730
على أيّـةِ حال
لسـتِ الآن بحالـة جسديـة تسمح لكِ بتنفيـذ رغبتـي

225
00:19:24,370 --> 00:19:26,310
... حسـنٌ إذن

226
00:19:26,380 --> 00:19:28,870
وحش وحش وحش

227
00:19:29,150 --> 00:19:31,240
! سئمـتُ من كـوني أُخـدع بكـم أيتهـا الأشيــاء

228
00:19:32,720 --> 00:19:35,080
! أنـا محميــة بواسطـة زوميلجاستــر الهائـــل

229
00:19:35,150 --> 00:19:36,520
! مارتيــنا

230
00:19:36,590 --> 00:19:40,180
!والآن أيها الوحش !، كـلُ ما عانيتـه من ألـم سيتـم مسحـه نهائيـاً

231
00:19:44,060 --> 00:19:45,150
! آنسـة مارتـينا

232
00:19:45,860 --> 00:19:50,700
إحتـراماً لـ زوميلجـاسـتر فقـط، سأعفـو عن حيـاتك

233
00:19:51,130 --> 00:19:52,600
يا "أختـي" العـزيــزة

234
00:19:53,770 --> 00:19:56,860
.. أنتَ عديم الرحمة حـتى لمن هـو غيـر إنسـاني

235
00:19:56,940 --> 00:19:59,340
تماديـت كثيــراً يا فتـى

236
00:20:02,610 --> 00:20:05,310
! صحيح، أنـت، أنت تؤدي المطلـوب تمامـاً

237
00:20:13,590 --> 00:20:14,450
! جــوري

238
00:20:17,860 --> 00:20:22,590
!! جـوري، جـوري، جـــوري

239
00:20:23,300 --> 00:20:25,290
! ليــنـا

240
00:20:27,040 --> 00:20:29,340
!! جــوري

241
00:20:36,080 --> 00:20:36,840
! لينـا

242
00:20:36,910 --> 00:20:37,640
! آنسـة ليـنا

243
00:20:37,710 --> 00:20:41,880
إذا أردتِ إستعـادته، فتعـالي إلى مـدينتـي

244
00:20:42,350 --> 00:20:45,050
!  نعـم ... تعـالي إلى سايـراج

245
00:20:45,320 --> 00:20:47,050
!!سـايراج ؟؟

246
00:20:49,260 --> 00:20:52,390
السيد الجحيم فيـبريـزو... سيـد العالـم السُفـلي

247
00:20:52,460 --> 00:20:54,860
والذي يريـد تدميـر كل شـيء و إعادة الفوضـى كليـاً

248
00:20:54,930 --> 00:20:58,490
لا يمكـن أن نتمكـن من هـزيمتـه بإستعمال الطـرق العاديـة

249
00:20:58,670 --> 00:21:01,970
ولكـن كونـي أعـرف الحقيقـة... لا يمكـنني إستعمـالها

250
00:21:02,040 --> 00:21:04,230
! لا يمكـننـي إستعمـال تلك التعـويذة مطلقـاً

251
00:21:14,700 --> 00:21:18,250
Nani ka ni ayatsurareta

252
00:21:18,350 --> 00:21:23,200
jinsei nante yume mo kibou mo nai shi...

253
00:21:23,210 --> 00:21:26,450
Ima no your life manzoku na no?

254
00:21:28,800 --> 00:21:32,540
Seikimatsu ka to

255
00:21:32,550 --> 00:21:36,880
omowaseru mainichi ni sonaete

256
00:21:36,890 --> 00:21:40,050
Sorosoro enjin kakeyou

257
00:21:40,060 --> 00:21:42,350
Sabi-tsuite 'ru joushiki

258
00:21:42,350 --> 00:21:46,900
zenbu nugisutete

259
00:21:46,900 --> 00:21:51,220
Sekai-juu uwasa ni naritai

260
00:21:51,230 --> 00:21:54,390
kagayaku mirai mo te ni iretai

261
00:21:54,400 --> 00:21:56,900
Are mo kore mo honki

262
00:21:56,910 --> 00:22:00,500
no yume dare hitori jama wa sasenai

263
00:22:01,680 --> 00:22:05,670
Sekai-juu uwasa ni naru kurai

264
00:22:05,680 --> 00:22:09,340
tobikiri hajiketa sugoi hito ni

265
00:22:09,350 --> 00:22:11,680
Isshou de ichido no Break

266
00:22:11,690 --> 00:22:14,550
Ijiketa jibun ni Bye-Bye shimashou

267
00:22:14,550 --> 00:22:17,200
It's all right