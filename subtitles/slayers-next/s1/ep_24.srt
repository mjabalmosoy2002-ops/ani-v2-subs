1
00:00:08,380 --> 00:00:15,050
ســلايــرز

2
00:00:12,300 --> 00:00:15,050
التـــــالي

3
00:00:19,010 --> 00:00:22,000
memagurushii   jikan no mure ga

4
00:00:22,230 --> 00:00:25,570
hashiri nukeru   machi wa SABANNA

5
00:00:25,570 --> 00:00:29,150
mogaku you ni   nukedasu you ni

6
00:00:29,290 --> 00:00:32,540
kono chikara wo   tameshite mitakute

7
00:00:32,680 --> 00:00:36,240
kitto dokoka ni "kotae" aru

8
00:00:36,610 --> 00:00:39,480
umarete-kita kotae ga

9
00:00:40,040 --> 00:00:43,100
hito wa minna, sore wo motome

10
00:00:43,320 --> 00:00:46,520
yarusenai   nogasenai

11
00:00:46,520 --> 00:00:49,140
yume ni mukau no

12
00:00:49,220 --> 00:00:53,100
kizutsuku koto wa kowakunai

13
00:00:53,150 --> 00:00:56,350
dakedo kesshite tsuyokunai

14
00:00:56,480 --> 00:00:59,970
tada, nanimo shinai mama de

15
00:00:59,970 --> 00:01:03,330
kuyandari wa shitakunai

16
00:01:03,410 --> 00:01:06,700
Here we go! go!   hashiri-tsudzukeru

17
00:01:06,700 --> 00:01:10,380
dare ni mo tomerare wa shinai

18
00:01:10,450 --> 00:01:13,640
mirai no jibun e to

19
00:01:13,710 --> 00:01:17,620
Give a reason for life   todoketai

20
00:01:35,260 --> 00:01:36,810
!  جــاوري

21
00:01:36,990 --> 00:01:43,000
!مدينـة الأشبـاح الغامضـــة

22
00:01:36,990 --> 00:01:43,000
! فــخ اللئيـــم

23
00:01:44,760 --> 00:01:45,960
! لا يُعقــل

24
00:01:46,800 --> 00:01:48,630
جـوري

25
00:01:49,140 --> 00:01:50,330
! سيلفيــل إيـاكِ

26
00:01:50,400 --> 00:01:51,670
!آنسـة ليـنا ؟

27
00:01:51,740 --> 00:01:54,040
إنـه مُسيطـر عليـه كليـاً من قبـل فيبـريـزو

28
00:01:57,340 --> 00:02:03,440
أجل، عقل ذلك الرجـل يقـع تحـت سيطـرتي كليـاً

29
00:02:04,380 --> 00:02:05,510
... أيهـا الـ

30
00:02:05,590 --> 00:02:07,950
لم أكـن أتخيـل هـذا الصيـد الثميـن الذي وقع بيـن يـدي

31
00:02:08,660 --> 00:02:11,850
! لم أكـن أتخيـل أنـه سيـاف رائـع بهـذا الشكـل

32
00:02:12,230 --> 00:02:15,130
... بالواقـع، كـل ما أحتجـت لفعلـه هـو تحريـر

33
00:02:15,190 --> 00:02:17,320
القـوة الكاملـة لسيـف الضــوء

34
00:02:21,330 --> 00:02:24,700
... بالحقيقـة، التعامـل مع سيـف الضـوء بقـوته الكاملـة

35
00:02:24,770 --> 00:02:27,210
... وجـوري عـديم الرحمـة كليـاً

36
00:02:27,270 --> 00:02:29,500
! لا يعنـي سـوى المتاعـب بشكـل كلـي

37
00:02:29,580 --> 00:02:33,570
! ياله من موقـف مشـوق ! هـذه نوعيـة المواقـف التي أفضلـها

38
00:02:34,150 --> 00:02:35,980
! سـ .. سيـد زانجلـوس، تمهــل

39
00:02:36,050 --> 00:02:39,110
آسـف لقـول هـذا، لكنـكَ لسـت هـدفي المنشـود

40
00:02:39,550 --> 00:02:40,640
!مـاذا ؟

41
00:02:40,720 --> 00:02:44,120
بالنهايـة، الوحيـدة التي أريـدها هـي ليـنا إينفـرس

42
00:02:45,020 --> 00:02:48,150
وآسـف كونكِ تعرفيـن من تجابهـين الآن

43
00:02:54,470 --> 00:02:55,330
! جــوري

44
00:02:57,470 --> 00:02:58,490
! جــوري

45
00:03:01,310 --> 00:03:04,210
جولتنـا الثانيـة ستحمـل مفاجـآت أكثـر بكثيــر

46
00:03:04,280 --> 00:03:06,640
! وآمـل أن تكونـي متطلعــة لهـا

47
00:03:07,910 --> 00:03:09,380
! فيبـريــزو

48
00:03:21,360 --> 00:03:22,990
إذا كـنتُ فهمـت جيــداً

49
00:03:23,060 --> 00:03:27,330
جـوري قـد خُطـف بواسطـة سيد الجحيم فيبـريـزو

50
00:03:27,400 --> 00:03:31,960
صحيح، كمـا ترى فهـو الآن دميـة يحركهـا كما يشـاء

51
00:03:32,470 --> 00:03:34,130
! إنـه لم يأخــذه كرهينـة وحســب

52
00:03:34,210 --> 00:03:37,510
بل أجبر السيد جـوري على التصرف ضد إرادته

53
00:03:37,580 --> 00:03:40,100
!إلى أيّ حـدٍ ستصـل دنـائـة فيبـريـزو ؟

54
00:03:40,910 --> 00:03:42,240
... جـوري

55
00:03:42,320 --> 00:03:45,180
ولكن لمـاذا أخـذ جـوري كرهيـنة ؟

56
00:03:45,890 --> 00:03:47,510
... إذا كـان ذلك الشخـص بالقـوة التي تصفـونها

57
00:03:47,590 --> 00:03:50,490
ألـن يكـون قتلكـم جميعـاً أسهـل بالنسبـة له ؟

58
00:03:51,360 --> 00:03:52,260
... بالواقـع

59
00:03:52,330 --> 00:03:54,820
مـن يسعـى خلفـه هـو أنـا

60
00:03:54,890 --> 00:03:57,590
إنـه يريـدني أن أقـوم بشـيء من أجلـه

61
00:03:57,660 --> 00:03:59,960
في مقابـل حيـاة جـوري ؟

62
00:04:05,770 --> 00:04:08,710
... دعنـي أقـول بأن ما يريـد فيبـريـزو أن أفعلـه

63
00:04:08,780 --> 00:04:10,770
هـو الشـيء الأخيـر الذي أريـد فعلـه

64
00:04:11,210 --> 00:04:14,110
بكل الأحوال، لا تجـد نفسـك مجبـراً على مساعـدتنا

65
00:04:14,180 --> 00:04:16,940
فأنت لسـت متورطـاً بهـذا يا زانجلـوس

66
00:04:18,580 --> 00:04:21,350
... بطبيعـة الحـال، فأنا لسـت أنـوي القـدوم معكـم

67
00:04:22,220 --> 00:04:23,920
سـألحـق بـه وحــدي

68
00:04:23,990 --> 00:04:27,790
أتعنـي أنـك لن تقاتلـه معنـا ؟

69
00:04:27,860 --> 00:04:30,690
... أريـد أن أتواجـه مع جـوري لمـرة أخـرى

70
00:04:30,760 --> 00:04:32,990
! وسأقتـل كل مـن يعتـرض طريقـي

71
00:04:33,070 --> 00:04:35,000
هـذا ما أود قـوله

72
00:04:35,070 --> 00:04:38,630
بالإضافـة، فـأنا بالفعـل لا أستطيـع العمـل جيـداً مع الآخـرين

73
00:04:38,810 --> 00:04:40,970
دعـوني أقـوم بهـذا على طريقـتي

74
00:04:49,450 --> 00:04:51,470
! إنـه رائـع و ثــوري جـداً

75
00:04:52,290 --> 00:04:55,880
تلكَ القبعـة المقلوبـة قليـلاً، وذلك الرداء الأنيـق أيضـاً

76
00:04:56,720 --> 00:05:00,210
! توقفي ! توقفـي ! عاهـدتي نفسـكِ ألا تثقـي بأحـد بعـد الآن

77
00:05:00,530 --> 00:05:05,020
! فكـري فقـط في إعـادة إحيـاء جاوملجـوسـتر، مارتينـا

78
00:05:05,900 --> 00:05:08,390
لكن، لكن لكن

79
00:05:10,070 --> 00:05:13,440
...  دائمـاً ما أتسـاءل عن طبيعـة ذوقهـا

80
00:05:13,510 --> 00:05:15,500
دعيهـا و شـأنها

81
00:05:23,050 --> 00:05:25,420
سايـراج، موطـن سيلفيــل

82
00:05:25,890 --> 00:05:29,620
هـذه هـي المـرة الثانيـة التي نأتـي إليهـا

83
00:05:32,460 --> 00:05:35,330
... المـرة الأولـى .. نعــم

84
00:05:35,390 --> 00:05:39,460
كانت المرة الأولى حيـن تقاتلنـا مع الوحش الشيطـاني زانفـار و مـع نسخة ريـزو

85
00:05:39,530 --> 00:05:43,470
... والمدينـة دُمـرت ذلك الوقـت، لكـن

86
00:05:44,670 --> 00:05:47,160
كل شيء يبـدو كمـا قلتِ يا سيلفيــل

87
00:05:47,240 --> 00:05:50,470
لا أظـن أن بالإمكـان بنـاء مدينـة بهـذه السرعـة

88
00:05:50,540 --> 00:05:51,980
بالفعل

89
00:05:52,040 --> 00:05:55,380
! حسناً، دعـونا نتوقـف عن النقـاش و لنذهـب لنـرى بأنفسـنا

90
00:05:55,450 --> 00:05:57,470
! لن نعلـم أيّ شـيء بالوقـوف في مكـاننا

91
00:05:59,120 --> 00:06:00,240
... فلاجــون

92
00:06:01,120 --> 00:06:06,490
... الشجـرةُ المقدسـة فلاجــون، والتي تُـدعم قلوبنـا، قـد إختفـت

93
00:06:09,360 --> 00:06:11,390
... هنـالك شـيء مـا بهـذا الأمـر

94
00:06:14,600 --> 00:06:17,730
!لماذا علي أنـا الأميرة الملكيـة، أن أركـب في عربـة القش كهـذه ؟

95
00:06:17,800 --> 00:06:21,760
! أخرسي وحسـب، دعيهـا توصلنـا إلى مركـز المدينـة

96
00:06:26,010 --> 00:06:27,070
.. هـذه هـي

97
00:06:27,150 --> 00:06:28,340
ما الخطـب ؟

98
00:06:28,810 --> 00:06:31,510
! هـذه ليـست مدينـة حديثـة البنـاء

99
00:06:31,850 --> 00:06:35,450
! المدينـة التي تدمـرت في المعركـة تبـدو و كأنها تجـددت بالكامـل

100
00:06:35,990 --> 00:06:37,960
ماذا تقـوليـن ؟

101
00:06:46,130 --> 00:06:48,120
رجـاءاً، أنظـروا لهـذه

102
00:06:52,340 --> 00:06:55,000
ماذا هنـاك ؟ -
عندمـا كـنت طفلـةً صغيـرة -

103
00:06:55,110 --> 00:06:57,770
... كـانت تلك العلامـات تُحفر في الشجـرة كل عـام

104
00:06:57,840 --> 00:06:59,400
لتـريني كيـف كـنتُ أكبــر

105
00:07:15,860 --> 00:07:17,830
! أبـــي

106
00:07:22,400 --> 00:07:25,890
هـذه الشجـرة لابـد من أنهـا تحطمـت أثنـاء المعركـة

107
00:07:25,970 --> 00:07:28,100
ومع ذلك فهـي هنـا قـد عادت مرة أخـرى

108
00:07:28,440 --> 00:07:32,380
فهـذا دليل على أن المدينـة قـد تم ترميمهـا بالكامـل

109
00:07:32,450 --> 00:07:35,570
...لا يعقل، عندمـا قاتلنـا نسخة ريـزو في المدينـة كانت

110
00:08:01,240 --> 00:08:02,260
! سيلفيـــل

111
00:08:03,580 --> 00:08:04,740
... أبــي

112
00:08:05,750 --> 00:08:07,240
! ....  أبــي قــد

113
00:08:09,350 --> 00:08:11,150
! لا

114
00:08:15,720 --> 00:08:17,480
إذن، كيــف ذلك ؟

115
00:08:19,530 --> 00:08:21,690
سيلفيــل ؟

116
00:08:25,870 --> 00:08:28,990
! مستحيــل! غيــر معقــول

117
00:08:31,340 --> 00:08:33,100
!أبــي ؟

118
00:08:33,170 --> 00:08:34,200
... سيلفيــل

119
00:08:40,680 --> 00:08:42,670
! أبــــي

120
00:08:43,550 --> 00:08:45,280
! سيلفيــل

121
00:08:46,120 --> 00:08:48,710
! أبــي ! أبــي

122
00:08:51,590 --> 00:08:54,790
! أنت على ما يرام، كـنت واثقـة عندمـا حدث

123
00:08:55,830 --> 00:08:57,420
...في واقـع الأمـر

124
00:08:58,330 --> 00:09:00,800
... آسفـة على قطـع لم الشمل العاطفـي هـذا، ولكـن

125
00:09:00,870 --> 00:09:02,530
! آنسـة لينـا إينفـرس

126
00:09:02,600 --> 00:09:05,130
أيمكنـكَ رجـاءً أن توضـح ما الذي يجـري بالأنحـاء هنـا ؟

127
00:09:05,200 --> 00:09:07,640
كيــف عادت المدينـة لسـابق عهدها ؟

128
00:09:18,380 --> 00:09:24,050
الحقيقـة، هـي أننـي و لا أيّ شخـص في هـذه المدينـة على قيـد الحيـاة

129
00:09:24,220 --> 00:09:25,320
كمـا ظـننـت

130
00:09:25,390 --> 00:09:29,690
السيـد فيبـريـزو إستعمـل قـواه ليعيـد هـذه المدينــة

131
00:09:29,760 --> 00:09:33,220
إنهـا مدينـة ذات أنـاس منحـوا حيـاة مـؤقـتة

132
00:09:35,500 --> 00:09:37,660
...حيـاة مؤقتـة؟، إذن

133
00:09:37,740 --> 00:09:45,340
أنا و كـل من هنـا راقـدون في العالـم السفـلي في هـذه الأثنـاء

134
00:09:50,520 --> 00:09:52,580
... لا يمكــن

135
00:10:02,360 --> 00:10:05,850
! قلبــك، إنـه لا ينبــض

136
00:10:06,470 --> 00:10:07,690
... لا يمكـن

137
00:10:07,770 --> 00:10:10,760
وما هـو غـرض فيبـريـزو ليفعـل كل هـذا ؟

138
00:10:12,170 --> 00:10:16,340
نحـن لم نُخلــق لنجيـب عـن هـذا السـؤال

139
00:10:16,980 --> 00:10:22,570
ما يمكـننـا قـوله فقـط هـي المعلومـات التي سمـح لنـا السيـد فيبـريـزو أن نقـولها

140
00:10:23,350 --> 00:10:28,250
.. السيد فيبـريزو صنعـنا و لذلك من المستحيـل علينـا أن نخبـركم بالسـبب

141
00:10:28,320 --> 00:10:32,980
كمـا هـو من الصعـب على الإنسـان
أن يتنفـس تحت المـاء بـدون إستعمال السحـر

142
00:10:33,930 --> 00:10:36,720
أعـرف كـم يبـدو هـذا تبـريـراً بائـساً كما يبـدو

143
00:10:42,500 --> 00:10:44,800
! سحقـاً ! ذلك الخسيـس

144
00:10:44,870 --> 00:10:50,710
بالنسبـة لنـا، السيـد فيبـريـزو هـو من خلقـنا، ولذلك لا نستطيـع معارضـته

145
00:10:51,210 --> 00:10:54,840
حسناً، سأسـأل سـؤالاً آخـر، أيـن هـو فيبـريـزو الآن ؟

146
00:10:55,950 --> 00:11:00,720
في قلـب هـذه المدينـة، داخـل معبـد السيـد فيبـريـزو

147
00:11:15,670 --> 00:11:18,660
لا يمكـنني رؤيـة أيّ مدخـل في المكـان

148
00:11:18,840 --> 00:11:20,240
! آنسـة ليـنا

149
00:11:22,010 --> 00:11:24,530
لقـد حلقـتُ لأتفحـص المكان من الأعلـى

150
00:11:24,610 --> 00:11:26,700
! لكـننـي لم أعثـر على أيّ مدخــل

151
00:11:26,780 --> 00:11:27,840
ما الذي علينـا فعلـه ؟

152
00:11:27,910 --> 00:11:29,680
الشـيء الوحيـد الذي نجيـده

153
00:11:29,750 --> 00:11:31,810
! إذا لم يكـن هنالكَ مدخـل، فسنصـنع واحـداً بأنفسـنا

154
00:11:31,880 --> 00:11:33,080
! دامـــو بـراس

155
00:11:39,660 --> 00:11:42,820
يبـدو أن هنـاك درعـاً مـا يحميـه

156
00:11:42,900 --> 00:11:45,490
إذن فعليـنا تدميـر الدرع تدميـراً

157
00:11:45,870 --> 00:11:48,930
"الظلمة ما وراء الشفـق، خلـف الدم القرمـزي الذي يتـدفــق"

158
00:11:54,310 --> 00:11:55,470
! آنسـة ليـنا

159
00:11:55,540 --> 00:11:58,670
يبـدو بأنه يريـد إراحتنـا، وصنـع مدخـلاً لأجلـنا

160
00:11:58,980 --> 00:12:01,640
! حسـنٌ، في هـذه الحالـة لننطلـق إلى الداخـل بأفصـى ما لدينـا

161
00:12:07,850 --> 00:12:08,980
! آنسـة ليـنا

162
00:12:09,060 --> 00:12:11,080
ما الذي يجـري ؟ ماذا هناك بالداخـل ؟

163
00:12:12,360 --> 00:12:14,990
إعتقـدت بأننـي دخـلت إلى الداخـل

164
00:12:25,510 --> 00:12:27,370
!مـا الذي تفعليـنه أنـتِ ؟

165
00:12:27,440 --> 00:12:30,100
! آنسـة ليـنا، لا وقـت لدينـا للعب

166
00:12:30,610 --> 00:12:33,910
لسـت كذلك مهمـا حاولـت، فأنا أستمـر بالخـروج دائمـاً

167
00:12:34,710 --> 00:12:36,910
إذا إعتقـدتِ أنني أكـذب، فحاولـي بنفسـك

168
00:12:37,850 --> 00:12:39,840
أيعقـل هـذا ؟

169
00:12:42,890 --> 00:12:45,380
!مـا ... ما الذي يجـري هنـا ؟

170
00:12:45,460 --> 00:12:47,650
يبـدو بأن الفضـاء ملتــو بالداخــل

171
00:12:47,730 --> 00:12:49,960
فمهـما حاولـتِ فعلـه فدائمـاً ما ينتهـي المطاف بـكِ خارجـاً

172
00:12:50,030 --> 00:12:54,160
يبـدو إذن بأننـا لن نتمكـن من الدخـول، على الأقـل بالوقـت الراهـن

173
00:12:58,700 --> 00:13:02,330
ليـس هـذا وقـت اللعـب، دعـونا نبحـث في مكـان آخـر

174
00:13:11,580 --> 00:13:13,750
! إنسـوا الأمــر ! أنا راحلــة

175
00:13:13,820 --> 00:13:15,620
لكـن لمـاذا ؟

176
00:13:15,690 --> 00:13:17,680
لا بأس، لا بأس، هيـا بنا، دعـونا نذهــب

177
00:13:18,360 --> 00:13:20,020
! آنسـة لـينا

178
00:13:29,970 --> 00:13:32,490
... فهمتـم ؟، الأمـر خطـر بعـض الشيء، لكـن دعـونا ننقسـم

179
00:13:32,570 --> 00:13:34,630
وليبحـث كل منـا على طريـق للدخـول -
مفهـوم -

180
00:13:34,710 --> 00:13:39,300
ربما تتواجـد ممـرات أرضيـة متبقيـة حينمـا كانت فلاجـون موجـودة

181
00:13:39,380 --> 00:13:42,110
! حسـناً، سنبحـث في ذلك الإتجـاه

182
00:13:42,180 --> 00:13:43,710
تذكـروا بأن خصمنـا الذي نواجهـه هـو فيبـريـزو

183
00:13:43,780 --> 00:13:46,910
! لا نعلـم بعـد ما الذي يخـططُ له، كونـوا حـذريـن يا رفـاق

184
00:13:47,250 --> 00:13:49,480
! نعم!، دعـي الأمـر لنـا

185
00:13:49,560 --> 00:13:51,850
حسـناً، سـأراكـم جميعـاً فيمـا بعـد

186
00:14:01,700 --> 00:14:04,170
... آسفـة بشـأن هـذا، يا رفـاق

187
00:14:09,840 --> 00:14:11,240
سيلفيــل ؟

188
00:14:12,210 --> 00:14:12,910
! آنسـة ليـنا

189
00:14:13,780 --> 00:14:15,300
!إلى أيـن كـنتِ تنويـن الذهـاب ؟

190
00:14:15,380 --> 00:14:18,320
.. حسنـاً، إلى حيـث .. كـنت سأذهـب .. إلى

191
00:14:18,380 --> 00:14:21,320
كنتِ تنويـن الذهـاب إلى معبـد فيبريـزو بمفـردكِ، أليس كذلك ؟

192
00:14:22,050 --> 00:14:24,350
...بالواقــع ... نعـم

193
00:14:24,420 --> 00:14:27,820
كما توقعـت، لكـنكِ لا تستطيـعين الدخـول هناك

194
00:14:28,630 --> 00:14:33,730
... حسنٌ، ليس بالطرق العاديـة، لكننـي أعتقـد أن سيـف راجنـا

195
00:14:33,800 --> 00:14:37,760
ربمـا يمكنـه الولـوج عبـر ذلكَ الفـراغ الملتـف

196
00:14:38,270 --> 00:14:41,600
إذن، كنتِ تنويـن دائمـاً مجابهتـه بمفـردك

197
00:14:42,170 --> 00:14:45,510
إسمعيني، سـبب خطـف جـوري هـو أنـا

198
00:14:46,250 --> 00:14:49,480
ولسـت أريـد تعريـض الجميـع للخطـرِ بعـد الآن

199
00:14:49,550 --> 00:14:50,570
... ولكـن، نحــن

200
00:14:50,650 --> 00:14:54,140
! فيبـريـزو ليـس مشابهـاً لأيّ مـن الأعـداء الذين واجهنـاهم سابقـاً

201
00:14:54,890 --> 00:14:58,480
! فحتـى زانفـار و نسخة ريـزو لا يمثـلان شيـئاً أمـامـه

202
00:14:58,560 --> 00:15:01,890
آسفـة، لكــنني الوحيـدة التي تملك فرصـة أمـامـه

203
00:15:02,860 --> 00:15:05,960
لهـذا السـبب عليّ الذهـاب بمفـردي

204
00:15:07,070 --> 00:15:11,030
الآنسـة أميليـا و السيـد زيلجـديس سيكونان غاضبيـن إذا علما بهـذا الأمـر

205
00:15:11,100 --> 00:15:14,500
! إذا عـدت على قيـد الحيـاة، يمكنهمـا الغضـب منـي بقـدر ما يريـدان

206
00:15:14,570 --> 00:15:16,870
... وبكل الأحـوال، فهـذا هـو السـبب الذي يمنعـني من أخـذك أيضـاً

207
00:15:16,940 --> 00:15:18,100
! سـآتي معـكِ

208
00:15:18,580 --> 00:15:20,570
! دعينـي آتـي معـكِ

209
00:15:20,650 --> 00:15:22,480
! لحظـة، تمهلـي سيلفيــل

210
00:15:22,550 --> 00:15:28,040
لا يمكنـني مسامحتـه، ليس لأجـل جـوري، ولكـن لأجل أبي

211
00:15:28,120 --> 00:15:33,150
! ولكـل شخـص يتحكـم بـه فيبـريـزو في سـايراج

212
00:15:33,860 --> 00:15:36,050
أعـلم تمـاماً بأنـه لا أحـد منهـم على قيـد الحيـاة

213
00:15:36,130 --> 00:15:39,290
! ولكـن عندمـا رحـب بي أبـي كما كان يفعـل سابقـاً

214
00:15:40,200 --> 00:15:43,660
في ذلك اليـوم، عندمـا حوصـروا في المعركـة و قُتلـوا

215
00:15:43,740 --> 00:15:46,170
إعتقـدتُ أن الأمـر ليـس حقيقيـاً

216
00:15:47,040 --> 00:15:48,800
هـذا ليـس عـدلاً

217
00:15:50,310 --> 00:15:54,340
أنـا، أنـا آسفــة

218
00:15:54,410 --> 00:15:58,250
! على كـل حال، لا أريـد لـ فيبـريـزو أن يعـذب الموتـى بهـذا الشكـل

219
00:15:58,320 --> 00:16:00,180
! على أن أدعـه يتـذوق صنيعـه بكـل ما أوتيت من قـوة

220
00:16:03,660 --> 00:16:05,020
آنسـة ليـنا ؟

221
00:16:05,090 --> 00:16:07,320
أظـن بألا خيـار لـدي، لكـن بالمقابـل

222
00:16:07,390 --> 00:16:10,990
عليكِ أن تضمنـي لي بأن تعـودي على قيـد الحيـاة

223
00:16:11,060 --> 00:16:12,030
! سأفعــل

224
00:16:13,430 --> 00:16:16,230
هـذا يشبـه ما فعلنـاه سـوياً عندمـا كنـا نركـض تحـت الأرض

225
00:16:16,300 --> 00:16:18,100
! تحـت فلاجـون عندمـا قاتلنـا نسخة ريـزو

226
00:16:18,170 --> 00:16:22,610
أنـتِ محقـة، لكـن آنسـة ليـنا، فيبـريـزو

227
00:16:22,680 --> 00:16:28,480
أعلم، بأنه يريـدني أن أستعمـل رقيق جيجا و أن أتركهـا تخرج عن السيطـرة

228
00:16:28,550 --> 00:16:33,210
! وما الذي سنفعلـه إذا ما حـرر جـوري ؟، وإذا نفـذتِ تلكَ التعـويـذة

229
00:16:33,890 --> 00:16:35,880
صراحـةً لسـتُ أعلـم

230
00:16:35,960 --> 00:16:39,480
... قبـل أن أعلـم بالحقيقـة الفعليـة لسيـد الكوابيـس

231
00:16:39,560 --> 00:16:43,050
لكـنتُ أظـن أستطيـع إلقـاء التعـويـذة قبـل أن تخرج عن السيطـرة

232
00:16:43,130 --> 00:16:44,460
ولكـن الآن ؟

233
00:16:44,530 --> 00:16:47,590
لسـت واثقـة من قـدرتي على تمكنـي من التحكـم التـام بالتعويـذة

234
00:16:47,670 --> 00:16:51,230
! وكـذلك لا يمكـنـني ترك جـوري كرهينـة أيضـاً

235
00:16:51,640 --> 00:16:53,260
! أصبــتِ

236
00:16:53,640 --> 00:16:55,070
! إحـذري

237
00:16:56,240 --> 00:16:57,710
!مـن أنـت ؟

238
00:17:03,920 --> 00:17:06,540
هكـذا الآنَ وصـلنا لهـذه المرحلـة

239
00:17:08,550 --> 00:17:09,320
! سيــد زيلجـديس

240
00:17:09,390 --> 00:17:12,410
! تباً، إنهـم جميعـاً تحـت سيطـرة فيبـريـزو

241
00:17:15,760 --> 00:17:18,920
! لا أستطيـع مهاجمـة هـؤلاء النـاس بشكـل أعمـى

242
00:17:19,000 --> 00:17:20,930
! ما يعنـي أن طريقـنا الوحيـد هـو للأعلـى

243
00:17:21,470 --> 00:17:23,400
! آنسـة ليـنا ! أنظـري هنـاك

244
00:17:24,040 --> 00:17:26,500
لا يمكـنـني إستعمـال جنـاح الضـوء للتحليـق

245
00:17:29,280 --> 00:17:31,540
يبـدو بـأننـا محاصـرون كليـاً

246
00:17:31,740 --> 00:17:33,940
تعتقـدون بأن الآنسـة ليـنا كذلك أيضـاً ؟

247
00:17:34,010 --> 00:17:35,280
على الأغلـب

248
00:17:59,940 --> 00:18:05,280
! طـ.. طفلـةٌ صغيـرة ؟؟!  أنـا .. قـد .. قتلتهـا

249
00:18:05,340 --> 00:18:07,400
! .... أنـا قـد ! أنـا قــد

250
00:18:07,480 --> 00:18:12,470
مخطـئة آنسـة ليـنا !، أنتِ لم تقتليهـا !، تلكَ الفتـاة ميتـةٌ بالفعـل

251
00:18:12,550 --> 00:18:15,580
! مـاتت منـذ زمـنٍ طويـل ! أنـتِ لم تقتليـها

252
00:18:15,650 --> 00:18:19,350
! ... أتفهميـن ما أقـوله ؟، أنتِ لم تفعلـي ذلك ! لـذا أرجـوكِ

253
00:18:22,230 --> 00:18:23,960
! سيلفيــل ! أغلقـي عينيكِ

254
00:18:24,030 --> 00:18:24,960
! تعويـذة الضــوء

255
00:18:32,510 --> 00:18:34,270
! لا يمكنـنا الحـراك لأيّ مكـان

256
00:18:34,340 --> 00:18:36,740
! علينـا هـزيمـة فيبـريـزو الذي يحركـهم كالدمـى

257
00:18:36,810 --> 00:18:38,300
... ولكـن، بهـذا المعـدل

258
00:18:42,580 --> 00:18:46,070
! ما خطبـكِ ؟، ليـست هـذه من عـادتك

259
00:18:46,150 --> 00:18:46,950
! زانجلــوس

260
00:18:47,020 --> 00:18:48,990
تأمليـن أن يشعـر العـدو بالأسـف من أجلك ؟

261
00:18:49,190 --> 00:18:53,630
! لا تكـن سخيفـاً !، هـؤلاء النـاس تحـت سيطـرة فيبـريـزو

262
00:18:55,330 --> 00:18:57,820
ومـع ذلك فهـذا ليـس ما يهمنـي

263
00:18:58,560 --> 00:19:00,960
! كـل مـن يعتـرض طريقـي سيمــوت

264
00:19:05,340 --> 00:19:07,770
! والآن، إتبعـانـي سنهاجمهـم بكـل ما لدينـا

265
00:19:09,240 --> 00:19:14,680
أهـذه شجاعـة أم تهـور؟ حسـناً، للآن فقـط

266
00:19:14,750 --> 00:19:16,080
! سيلفيـل، هيـا لنذهـب

267
00:19:16,150 --> 00:19:17,620
! حاضـر

268
00:19:18,280 --> 00:19:20,580
! إذن سآخـذ المخاطــرة

269
00:19:22,420 --> 00:19:23,580
! تعويـذة النـوم

270
00:19:27,660 --> 00:19:29,290
تعـويذة النـوم تعمـل عليهـم ؟

271
00:19:31,030 --> 00:19:34,260
! لا نهايــة لعـددهـم

272
00:19:40,810 --> 00:19:42,500
!ما خطـب هـذا الجـدار ؟

273
00:19:42,580 --> 00:19:46,600
إنـسَ الأمـر، هـذا السيـف المسحـور لن يخـدش هذا الجـدار حتـى

274
00:19:51,620 --> 00:19:54,050
"إلـه الأحــلام الـذي يرعـــب "

275
00:19:54,120 --> 00:19:58,680
"يا سيـف القسـوة و الظلام، حـرر نفسـك من أغلال السمـاوات"

276
00:19:58,760 --> 00:20:00,920
"توحـد مـع قـوتي، توحـد مـع جسـدي"

277
00:20:00,990 --> 00:20:03,150
"ولنسـلك مسـار الظـلام ســويا"

278
00:20:03,230 --> 00:20:06,290
"!قـوة يمكنهـا تدميـر حتى أرواح الآلهـــة"

279
00:20:06,670 --> 00:20:09,290
! ســــيف راجنـــا

280
00:20:37,300 --> 00:20:39,290
حسـنٌ، جـاء موعـد الطبـق الرئيســي

281
00:20:40,730 --> 00:20:43,600
تمكنـتِ من الولـوج إلى المعبـد إذن ؟

282
00:20:43,670 --> 00:20:46,330
كـنتُ آمـل أن أحظـي قليـلاً ببعـض المـرح معـكِ

283
00:20:46,410 --> 00:20:50,570
لكـن يا لينـا إينفـرس وقـت اللهـو قـد إنتهـى

284
00:20:54,010 --> 00:20:57,180
! جـوري، أنـا قادمـة لإنقـاذك

285
00:21:14,700 --> 00:21:18,250
Nani ka ni ayatsurareta

286
00:21:18,350 --> 00:21:23,200
jinsei nante yume mo kibou mo nai shi...

287
00:21:23,210 --> 00:21:26,450
Ima no your life manzoku na no?

288
00:21:28,800 --> 00:21:32,540
Seikimatsu ka to

289
00:21:32,550 --> 00:21:36,880
omowaseru mainichi ni sonaete

290
00:21:36,890 --> 00:21:40,050
Sorosoro enjin kakeyou

291
00:21:40,060 --> 00:21:42,350
Sabi-tsuite 'ru joushiki

292
00:21:42,350 --> 00:21:46,900
zenbu nugisutete

293
00:21:46,900 --> 00:21:51,220
Sekai-juu uwasa ni naritai

294
00:21:51,230 --> 00:21:54,390
kagayaku mirai mo te ni iretai

295
00:21:54,400 --> 00:21:56,900
Are mo kore mo honki

296
00:21:56,910 --> 00:22:00,500
no yume dare hitori jama wa sasenai

297
00:22:01,680 --> 00:22:05,670
Sekai-juu uwasa ni naru kurai

298
00:22:05,680 --> 00:22:09,340
tobikiri hajiketa sugoi hito ni

299
00:22:09,350 --> 00:22:11,680
Isshou de ichido no Break

300
