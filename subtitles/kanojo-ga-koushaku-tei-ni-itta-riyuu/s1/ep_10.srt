1
00:00:12,650 --> 00:00:13,730
!ها هو ذا

2
00:00:17,760 --> 00:00:21,750
!أرفض الاستسلام فقط لأنّ لديه خطيبة الآن

3
00:00:22,980 --> 00:00:26,110
...إذا كان سيأخذ هذا المنديل بين يديه فحسب

4
00:00:45,360 --> 00:00:46,880
!حضرة الدّوق

5
00:00:46,880 --> 00:00:49,760
!أنت تدوس على منديل الآنسة بيلين

6
00:00:51,260 --> 00:00:53,990
بئساً. أعتذر

7
00:00:54,610 --> 00:00:56,650
...سيّد ويسترنبيرغ

8
00:00:59,620 --> 00:01:02,930
اذهب واعتذر من الآنسة بالنيابة عنّي

9
00:01:02,930 --> 00:01:05,380
أخبرها بأنّني سأعوّضها

10
00:01:06,940 --> 00:01:08,690
حسناً

11
00:03:09,330 --> 00:03:10,840
مضى وقت طويل

12
00:03:11,250 --> 00:03:12,510
أجل

13
00:03:14,290 --> 00:03:16,400
إلى ماذا كنت تنظر؟

14
00:03:18,510 --> 00:03:23,520
كنتُ أتلقّى درساً حول عدم لمس
أشياء تنتمي لشخص آخر

15
00:03:23,800 --> 00:03:25,340
لشخص آخر؟

16
00:03:26,590 --> 00:03:27,380
هيّا بنا

17
00:03:28,010 --> 00:03:29,160
...حسناً

18
00:03:30,020 --> 00:03:32,390
يبدو أنّكِ فقدتِ بعض الوزن

19
00:03:34,470 --> 00:03:37,400
أجل... يمكنك القول بأنّني مررتُ ببعض الأمور

20
00:03:47,680 --> 00:03:48,860
...أليس أولئك

21
00:03:49,160 --> 00:03:50,880
الفُرسان المُقدّسين؟

22
00:03:52,950 --> 00:03:56,740
كنتُ قد سمعتُ بأنّني قد أراهم
،ولو لمرّة واحدة في حياتي

23
00:03:56,740 --> 00:04:01,000
لكن ارتأيتُ أنّه كان من النّادر جدّاً
لهم أن يغادروا الأرض المُقدّسة

24
00:04:03,800 --> 00:04:05,120
!ريليانا

25
00:04:06,560 --> 00:04:10,440
قداسته الحبر الأعظم، هيكا ديمينت

26
00:04:21,450 --> 00:04:23,270
...الضّوء برّاق جدّاً

27
00:04:24,680 --> 00:04:29,690
لم يُحضِروا الفُرسان المُقدّسة إلى هنا
فقط للقيام بهذا، أليس كذلك؟

28
00:04:32,120 --> 00:04:35,870
،بدا أنّكِ لم تدركي حجمي

29
00:04:35,870 --> 00:04:40,990
لذا فتحتُ البوّابة إلى الأرض المُقدّسة
وأحضرتُ الفرسان المُقدّسين إلى هنا

30
00:04:43,350 --> 00:04:46,710
ما نظرة عدم الرّضا هذه؟

31
00:04:47,220 --> 00:04:49,720
ما الّذي تعترض عليه بالضبط؟

32
00:04:49,920 --> 00:04:53,720
...بوسعك أن تكون صدوقاً أكثر، أو

33
00:04:54,160 --> 00:04:56,240
...صدوق

34
00:04:56,810 --> 00:05:02,240
لكن عشتُ الـ 150 سنة الماضية
بلا عائلة أو أصدقاء

35
00:05:02,240 --> 00:05:03,730
!وجدتُها

36
00:05:03,730 --> 00:05:09,000
كان هناك عضو في مجلس الشّيوخ التابع
!للأرض المُقدّسة تبجّح بحفيدته

37
00:05:11,890 --> 00:05:13,250
...ريليانا

38
00:05:13,250 --> 00:05:14,200
نعم؟

39
00:05:16,280 --> 00:05:20,030
!سأكون جدّكِ

40
00:05:23,660 --> 00:05:25,890
!"هيّا، ناديني "جدّي

41
00:05:25,890 --> 00:05:30,880
مُحال أن أقول كلاماً وقحاً كهذا لقداستك

42
00:05:30,880 --> 00:05:33,890
!أمنحكِ الإذن بذلك

43
00:05:33,890 --> 00:05:36,930
لستُ بحاجة لهذا النّوع من الإذن حقّاً

44
00:05:36,930 --> 00:05:39,640
...فـ-في حين أنّ ذلك شرف عظيم

45
00:05:40,800 --> 00:05:43,490
قـ-قداستك، هل لي بلحظة؟

46
00:05:43,490 --> 00:05:44,200
ما الأمر؟

47
00:05:44,200 --> 00:05:46,470
المعذرة يا مولاتي

48
00:05:45,380 --> 00:05:46,470
!أيُّها الفظّ

49
00:05:46,470 --> 00:05:48,680
!كيف تجرؤ على سرقة وقتي الثّمين مع حفيدتي؟

50
00:05:49,530 --> 00:05:52,920
!ما معنى تسمية نفسك فجأة بـ"جدّها"؟

51
00:05:52,920 --> 00:05:57,280
لأنّ هناك فارق شاسع في السنّ
بالنسبة لي لأكون أبيها

52
00:05:57,280 --> 00:05:58,640
...صحيح

53
00:05:58,640 --> 00:06:02,240
لكن بالنظر إلى عمرك الحقيقيّ، حتّى
...كلمة "جدّي" هي قليلاً

54
00:06:02,240 --> 00:06:04,290
!لحظة، ليس هنا بيت القصيد

55
00:06:04,290 --> 00:06:10,920
!أسألك ما الّذي تحاول إنجازه باعتبارها حفيدتك فجأة

56
00:06:10,920 --> 00:06:15,080
!أنت من طلب منّي أن أكون ودوداً أكثر

57
00:06:16,180 --> 00:06:19,080
!أعرض أن أكون جدّها

58
00:06:19,080 --> 00:06:21,440
!هل هناك شرف أعظم من ذلك؟

59
00:06:21,440 --> 00:06:23,030
شرف؟

60
00:06:23,870 --> 00:06:25,950
...إ-إنّه

61
00:06:27,920 --> 00:06:30,300
ما الأمر؟ هل أنت تتألّم؟

62
00:06:34,250 --> 00:06:38,450
سيّد ويسترنبيرغ، تبدو مُتعَباً

63
00:06:38,450 --> 00:06:43,440
هل أنت راضٍ عن نفسك بالتضحية بي
من أجل سموّها بيلين؟

64
00:06:43,440 --> 00:06:46,120
هذا خير من التّضحية بك لتنّين، صحيح؟

65
00:06:49,090 --> 00:06:51,750
!كُفّ عن اعتراض طريقي فحسب

66
00:06:50,620 --> 00:06:52,850
!أنا لا أعترض طريقك

67
00:06:51,750 --> 00:06:52,840
...ريليانا

68
00:06:52,840 --> 00:06:55,220
نعم؟

69
00:06:52,840 --> 00:06:55,230
!ابقَ جانباً وأغلِق فمك فحسب

70
00:06:56,050 --> 00:06:57,220
إلى أين أنتِ ذاهبة؟

71
00:06:57,220 --> 00:06:59,730
في الواقع... إلى دورة المياه

72
00:06:59,730 --> 00:07:02,900
أعتقد أنّه في الاتّجاه الآخر

73
00:07:10,110 --> 00:07:11,890
ريليانا، ما هذا؟

74
00:07:13,070 --> 00:07:13,870
ماذا؟

75
00:07:23,580 --> 00:07:24,760
!ريليانا

76
00:07:27,750 --> 00:07:29,080
!لا تتحرّكوا

77
00:07:29,760 --> 00:07:31,100
ابقوا ثابتين

78
00:08:01,480 --> 00:08:03,010
مستحيل

79
00:08:03,010 --> 00:08:07,150
كان من الواضح أنّ ذلك الشّيء
...سينفجر في وجهي مباشرة

80
00:08:11,010 --> 00:08:12,300
...ريليانا

81
00:08:17,720 --> 00:08:18,760
ما رأيك؟

82
00:08:18,760 --> 00:08:21,350
هل ستعتبرينني جدّكِ الآن؟

83
00:08:29,780 --> 00:08:31,850
بذرة بلّوريّة

84
00:08:31,850 --> 00:08:35,170
معدن يُنتَج في الأرض المُقدّسة

85
00:08:35,720 --> 00:08:40,780
لا يمتلكه إلّا قليل من النّاس بسبب
القيود الصّارمة على تصديره

86
00:08:41,490 --> 00:08:43,200
،يبدو جميلاً

87
00:08:43,200 --> 00:08:45,380
...لكن عندما يتعرّض لضوء، فإنّه يمتصّه

88
00:08:46,680 --> 00:08:48,510
وينفجر

89
00:08:52,380 --> 00:08:55,480
لديه نظرة وحش جامح في عينيه

90
00:08:55,480 --> 00:08:57,820
تعلّمتُ في سنواتي الـ 150

91
00:08:57,820 --> 00:09:02,700
أنّ أولئك الّذين لا يكشفون عن عواطفهم
بوضوح هم أكثر المُخادعين

92
00:09:05,240 --> 00:09:08,150
كم هذا كريه

93
00:09:08,970 --> 00:09:11,890
ما هي علاقتك بريليانا خاصّتي؟

94
00:09:13,050 --> 00:09:15,070
ريليانا خاصّتك؟

95
00:09:15,900 --> 00:09:19,060
ماذا؟ هل لديك مشكلة بمناداتها بذلك؟

96
00:09:21,290 --> 00:09:23,040
أنا خطيبها

97
00:09:23,920 --> 00:09:28,540
من الصّعب على النّساء أن يستخدمن
قدراتهن الكاملة حالما يتزوّجن

98
00:09:29,090 --> 00:09:34,040
...إذا تزوّجَتْه وفقدتُ الوصول إلى موهبتها في اللّغات

99
00:09:36,170 --> 00:09:40,780
أتنبّأ بأنّك ستكون مُدمِّراً ذاتيّاً نتيجة
شخصيّتك الازدواجيّة

100
00:09:40,780 --> 00:09:43,030
انفصل عن ريليانا خاصّتي

101
00:09:43,900 --> 00:09:45,980
...هذا الأحمق العجوز

102
00:09:47,280 --> 00:09:48,590
،قداستك

103
00:09:48,590 --> 00:09:54,800
أشكرك من أعماق قلبي على إنقاذ خطيبتي اليوم

104
00:09:55,200 --> 00:09:59,850
سمعتُ بأنّ وضع منظّمتك الماليّ
يعاني كثيراً مؤخّراً

105
00:10:00,420 --> 00:10:03,970
أرغب في توفير دعمي لها

106
00:10:04,870 --> 00:10:08,210
لأنّك أنقذت خطيبتي

107
00:10:08,840 --> 00:10:10,900
أتقول خطيبتك؟

108
00:10:11,690 --> 00:10:15,340
حسناً، إنّها حفيدتي، لذا عليك
القلق بشأنها أبداً

109
00:10:15,340 --> 00:10:17,680
،قد تنصحني بعدم القلق بشأنها

110
00:10:17,680 --> 00:10:21,500
لكن من واجبي الاعتناء بخطيبتي

111
00:10:28,780 --> 00:10:34,850
سموّك، اسمح لي من فضلك أن
أشرح إجراءات الدعم المالي

112
00:10:44,220 --> 00:10:45,430
...آدم

113
00:10:45,430 --> 00:10:46,380
حاضر

114
00:10:46,380 --> 00:10:49,870
اختر أكثر الفُرسان الموهوبين
وأرسلهم إلى قلعة غرينجر

115
00:11:13,490 --> 00:11:15,840
...لو مضتْ بضع ثوانٍ إضافيّة حتّى

116
00:11:15,840 --> 00:11:18,400
...لا، لو لم يكن هيكا هناك

117
00:11:23,380 --> 00:11:28,280
لحظة دخوله لهذه القبّة، كان الموت قدره

118
00:11:36,160 --> 00:11:39,960
...بما أنّ ريليانا ماكميلان هي مجرّد شخصيّة جانبيّة

119
00:11:42,480 --> 00:11:45,460
فرُبّما قدرها هو الموت في النّهاية فعلاً؟

120
00:11:48,440 --> 00:11:51,660
...كسبب لعودة بياتريس إلى الدّيار

121
00:11:55,080 --> 00:11:56,820
!يجب عليّ إيقاف هذا

122
00:11:56,820 --> 00:11:59,950
يُقال بأنّ الأفكار السلبيّة ستُجلب نتائجَ سلبيّة

123
00:11:59,950 --> 00:12:04,690
قبل أن أتثبّط تماماً، يجب عليّ
أن أكتشف من كان يقف وراء ذلك

124
00:12:22,330 --> 00:12:25,080
متى اشتدّ الظّلام هنا؟

125
00:12:28,100 --> 00:12:29,230
!من هناك؟

126
00:12:31,100 --> 00:12:32,450
ريليانا؟

127
00:12:32,450 --> 00:12:34,810
!أخفتَني

128
00:12:34,810 --> 00:12:37,710
!تعرّضتِ لخطر جسيم حقّاً اليوم

129
00:12:39,850 --> 00:12:41,000
...نوه

130
00:12:41,000 --> 00:12:45,180
لا أرى أنّه من اللّباقة المجيء
إلى هنا من دون سابق إنذار

131
00:12:45,180 --> 00:12:49,140
...فرانشيز بروكس وجيك لانغستون ماتا، ومع ذلك

132
00:12:51,290 --> 00:12:55,620
إذاً كذب بشأن إرسالهما إلى سجن جرس القدّيس؟

133
00:12:56,070 --> 00:12:56,970
من يكون؟

134
00:12:58,760 --> 00:13:01,510
لا أفهم شيئاً من سؤالك

135
00:13:03,120 --> 00:13:05,690
يحاول شخصٌ قتلكِ

136
00:13:06,350 --> 00:13:08,800
شخص غير فرانشيز بروكس

137
00:13:10,060 --> 00:13:11,390
من يكون؟

138
00:13:11,390 --> 00:13:13,390
!لا أدري

139
00:13:14,150 --> 00:13:16,440
هل للأمر علاقة بالختم الملكيّ؟

140
00:13:17,120 --> 00:13:19,470
أم أنّ هناك شيء آخر يجري؟

141
00:13:19,470 --> 00:13:21,610
!أخبريني بالحقيقة

142
00:13:25,000 --> 00:13:27,160
سأخبرك غداً

143
00:13:30,160 --> 00:13:31,570
!لا! الآن

144
00:13:32,580 --> 00:13:37,000
لا أريدك أن تتورّطي في مزيد من الظّروف
!الّتي لا أستطيع السّيطرة عليها

145
00:13:37,000 --> 00:13:38,200
!أنت تؤلمني

146
00:13:38,200 --> 00:13:39,490
!أخبريني حالاً

147
00:14:00,110 --> 00:14:03,890
خُذ بعضاً من الوقت لتهدئة ذهنك
يا حضرة الدّوق وينايت

148
00:14:04,890 --> 00:14:07,570
هل تعرف ما هو هذا المكان؟

149
00:14:18,760 --> 00:14:23,340
حجرة التّطهير، والّتي لا يدخلها
إلّا الّذين حصلوا على إذن

150
00:14:24,710 --> 00:14:27,710
لماذا أنا عاجز عن إيقاف نفسي؟

151
00:14:30,680 --> 00:14:33,170
هل أنتِ جادّة بشأن هذا يا آنسة ماكميلان؟

152
00:14:38,110 --> 00:14:40,600
لماذا أنت غاضب جدّاً؟

153
00:14:41,120 --> 00:14:43,880
لأنّني لن أخبرك بالحقيقة؟

154
00:14:46,020 --> 00:14:49,930
من الطبيعي ألّا يصدّقني نوه

155
00:14:49,930 --> 00:14:53,460
نحن معاً فقط بسبب عقدنا في نهاية المطاف

156
00:14:54,700 --> 00:14:58,480
فلماذا هو غاضب جدّاً إذاً؟

157
00:15:14,890 --> 00:15:15,980
...ريليانا

158
00:15:17,290 --> 00:15:18,480
أنا آسف

159
00:15:21,370 --> 00:15:22,800
...كلّ ما في الأمر

160
00:15:23,400 --> 00:15:27,080
...عندما اعتقدتُ بأنّني قد أخسركِ

161
00:15:31,360 --> 00:15:33,410
كدتُ أفقد صوابي

162
00:15:41,700 --> 00:15:43,910
ما... معنى هذا؟

163
00:15:49,310 --> 00:15:51,610
ارتاحي جيّداً من فضلكِ

164
00:16:00,680 --> 00:16:02,610
!ماذا قصد؟

165
00:16:16,980 --> 00:16:18,520
من هنا رجاء

166
00:16:28,950 --> 00:16:30,950
كدتُ أفقد صوابي

167
00:16:32,790 --> 00:16:34,930
في لحظة بدئي بالتفكير في الأمر، خسرت

168
00:16:34,930 --> 00:16:36,800
!أخطأتُ الأمر برمّته

169
00:16:37,340 --> 00:16:39,800
!أجل! كلّ هذا خطأ

170
00:16:50,200 --> 00:16:52,690
في الأحوال العاديّة، يحجم قداسته عن الإشراف

171
00:16:52,690 --> 00:16:57,320
على إشعال النّار المُقدّسة مُراعاة للإنصاف

172
00:16:58,000 --> 00:17:01,980
لا بدّ أنّه مُعجب بالآنسة ماكميلان

173
00:17:03,430 --> 00:17:06,920
ريليانا، أنا جدّكِ

174
00:17:08,000 --> 00:17:09,480
،قداستك

175
00:17:09,480 --> 00:17:14,000
وقاحتي تجاهك قبل أيّام كانت
بلا شكّ غير مقصودة

176
00:17:14,000 --> 00:17:16,480
هيّا. ناديني بذلك

177
00:17:16,480 --> 00:17:18,730
...كنتُ أتعامل مع الأمر كتبادُل عفويّ

178
00:17:19,390 --> 00:17:23,920
لم يتكلّم أحدٌ معي بهذه الطريقة
الهمجيّة من قبل

179
00:17:23,920 --> 00:17:28,680
كانت أوّل مرّة أُصابُ فيها بالأرق
بسبب شيء في سنواتي الـ 150

180
00:17:30,400 --> 00:17:33,340
...يا جدّ ريليانا الحقيقيّ، أينما كنتَ

181
00:17:33,340 --> 00:17:36,480
هذا ليس ما أريده إطلاقاً، لذا سامحني أرجوك

182
00:17:40,450 --> 00:17:44,410
أنا ممتنّة... يا جدّي

183
00:18:27,660 --> 00:18:29,330
!قطعاً لا

184
00:18:29,330 --> 00:18:33,290
!ماذا تقصد بأنّك ذاهب رفقة الآنسة ماكميلان؟

185
00:18:33,290 --> 00:18:35,290
!أنا الحبر الأعظم السّامي

186
00:18:35,290 --> 00:18:37,050
!عندما أقول بأنّني سأذهب، سأذهب

187
00:18:37,050 --> 00:18:38,430
!ما المشكلة؟

188
00:18:38,430 --> 00:18:40,300
!إنّها مشكلة كبيرة

189
00:18:40,300 --> 00:18:44,170
لم أسمع بحبَر أعظم يتجوّل
!في أيّ مكان يحلو له

190
00:18:44,170 --> 00:18:46,480
!ابتعد عن طريقي

191
00:18:46,480 --> 00:18:48,880
!لن أسمح بهذا قطعاً

192
00:18:48,880 --> 00:18:52,060
!هلّا حللت عنّي فحسب؟

193
00:18:52,060 --> 00:18:54,610
تستخدم قوّتك المُفرطة اللّعينة
...تلك الآن من بين كلّ الأوقات

194
00:18:54,610 --> 00:18:58,360
شكراً لك يا رئيس الكهنة

195
00:18:59,490 --> 00:19:01,960
من أعماق قلبي

196
00:19:24,800 --> 00:19:27,810
جاستن، أنت الابن الأكبر لعائلة شامال

197
00:19:27,810 --> 00:19:31,480
لديك واجب خِلافتي في قيادة هذه العائلة

198
00:19:33,280 --> 00:19:35,220
أنت! هل تسمعني؟

199
00:19:35,490 --> 00:19:37,420
أسمعك جيّداً

200
00:19:38,190 --> 00:19:42,950
ألن تتوقّف عن التّركيز على تلك المرأة؟

201
00:19:42,950 --> 00:19:46,010
كنتُ أخطّط لهذه الرّحلة منذ بعض الوقت

202
00:19:46,010 --> 00:19:48,770
لا علاقة للأمر بها

203
00:19:49,960 --> 00:19:52,720
أتظنّني لا أعرف شيئاً؟

204
00:19:52,720 --> 00:19:56,140
لهذا السّبب أخبرتُك أن تبتعد عنها

205
00:19:57,320 --> 00:19:58,970
!جاستن، انتظر

206
00:19:59,530 --> 00:20:00,460
...حسناً إذاً

207
00:20:01,380 --> 00:20:04,240
ابنك الجاحد سينصرف الآن

208
00:20:05,400 --> 00:20:07,910
اذهب واطمئنّ على فيفيان

209
00:20:07,910 --> 00:20:10,340
فهي دائماً ما تصغي إليك

210
00:20:10,810 --> 00:20:12,490
هل حدث شيء؟

211
00:20:13,100 --> 00:20:16,380
يبدو أنّ الآنسة الشابّة ماكميلان

212
00:20:16,380 --> 00:20:19,480
قد تعرّضت لحادث في يوم مراسم الإشعال

213
00:20:21,020 --> 00:20:22,610
حادث؟

214
00:20:23,160 --> 00:20:25,680
،تُفيد إشاعات بأنّ كلّ ذلك كان مُخطَّطاً

215
00:20:25,680 --> 00:20:30,140
لكن عائلة وينايت تلتزم الصّمت الشّديد بشأن ذلك

216
00:20:31,450 --> 00:20:34,630
وما علاقة ذلك الأمر بفيفيان؟

217
00:20:34,630 --> 00:20:40,500
،حسناً، إنّها تسأل نفسها غالباً
"ماذا لو كنتُ أنا؟"

218
00:20:40,810 --> 00:20:45,000
على أيّ حال، ستصبح فيفيان ملِكة يوماً ما

219
00:20:45,000 --> 00:20:49,220
أريدك أن تقنعها بزيارة الملك بشكل متكرّر

220
00:20:50,620 --> 00:20:54,790
إنّه مُستميت على إدخال دماء
ملكيّة إلى سلالة عائلته

221
00:20:55,570 --> 00:20:57,080
حسناً

222
00:20:57,080 --> 00:20:58,460
أعتمد عليك

223
00:21:03,960 --> 00:21:05,720
أعرف فيفيان

224
00:21:05,720 --> 00:21:09,390
غالباً الأمر متعلّق بشأن خطيبة الدّوق وينايت

225
00:21:11,430 --> 00:21:13,370
كيف يجدر بي أن أقنعها؟

226
00:21:15,950 --> 00:21:19,660
!هذه غلطتكِ أنتِ! ماذا ستفعلين بشأن ذلك؟

227
00:21:19,660 --> 00:21:21,980
لا، ليست غلطتي

228
00:21:21,980 --> 00:21:24,080
هذا كان خياركِ يا مولاتي

229
00:21:25,940 --> 00:21:26,970
!فيفيان؟

230
00:21:26,970 --> 00:21:29,060
أخي؟ متى عدت؟

231
00:21:30,350 --> 00:21:32,240
ماذا يجري هنا؟

232
00:21:32,240 --> 00:21:34,240
لا شيء

233
00:21:44,070 --> 00:21:45,760
!سامحيني

234
00:21:45,760 --> 00:21:49,780
كان من الوقاحة منّي أن أتصرّف
!بهذه الطريقة أمام ضيف

235
00:21:53,580 --> 00:21:55,320
لا تهتمّ لذلك

236
00:21:58,960 --> 00:22:02,210
سررتُ بلقائك. اسمي بياتريس