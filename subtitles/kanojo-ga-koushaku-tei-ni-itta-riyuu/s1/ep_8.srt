1
00:00:02,730 --> 00:00:04,480
!سيّدة آنسلي

2
00:00:04,480 --> 00:00:06,330
!استيقظي أرجوكِ

3
00:00:06,330 --> 00:00:08,750
!ماذا تقصدين بـ"جحيم"؟

4
00:00:09,570 --> 00:00:11,440
!ماذا حدث؟

5
00:00:15,740 --> 00:00:18,520
!سيّدة آنسلي! سيّدة آنسلي

6
00:00:20,210 --> 00:00:21,680
حسناً، اهدئي

7
00:00:21,680 --> 00:00:24,690
من الواضح أنّ شيئاً حدثَ لنوه

8
00:00:25,130 --> 00:00:27,860
...عليّ تجهيز فريق بحث فوراً

9
00:00:30,050 --> 00:00:31,490
...ا-الجبل

10
00:00:31,490 --> 00:00:34,130
!تحرّكَ الجبل للتو

11
00:00:34,130 --> 00:00:37,420
!عمّاذا تتكلّمين؟ تمالكي نفسكِ

12
00:00:37,420 --> 00:00:39,130
تحرّكَ الجبل؟

13
00:01:08,740 --> 00:01:10,490
ما هذا؟

14
00:01:25,540 --> 00:01:26,700
!نوه؟

15
00:01:31,770 --> 00:01:33,060
ريليانا

16
00:03:08,500 --> 00:03:11,590
،ربّما لأنّ المطر غسلت كلّ الدّماء

17
00:03:11,590 --> 00:03:14,500
لكن لم أرَ أيّ أثر لتنّين

18
00:03:14,810 --> 00:03:19,640
أعتقد ربّما لا يوجد تنانين في جبال شيكريت

19
00:03:19,640 --> 00:03:22,140
—تنانين؟ لـ-لحظة فقط

20
00:03:22,140 --> 00:03:25,640
اقبلي هذا بدلاً منه من فضلكِ

21
00:03:26,520 --> 00:03:27,690
ما هذا بالضبط؟

22
00:03:27,690 --> 00:03:29,640
لم أرَ شيئاً مثيلاً له

23
00:03:29,640 --> 00:03:32,640
...عـ-عرضَ الدّوق فريسته لـ

24
00:03:33,000 --> 00:03:34,830
الدّوق يُعتمَد عليه حقّاً

25
00:03:34,830 --> 00:03:36,800
...بالنسبة للتنّين الّذي أردتِه

26
00:03:40,080 --> 00:03:44,660
أعِدُكِ بأنّني سأجد واحداً في
سلسلة جبال أخرى يوماً ما

27
00:03:46,760 --> 00:03:50,370
!متى قلتُ بأنّني أريد تنّيناً؟

28
00:03:50,370 --> 00:03:55,680
...لم يسبق أن قدّمَ وحشاً لأحد من قبل

29
00:03:58,420 --> 00:04:01,200
!هـ-هذا... كريودر

30
00:04:01,200 --> 00:04:02,420
!ماذا؟

31
00:04:02,420 --> 00:04:05,250
الّذي أطلقت عليه بسيّد جبال شيكريت؟

32
00:04:05,250 --> 00:04:07,880
!هذا جدير بالمُلاحظة سموّك

33
00:04:07,880 --> 00:04:12,470
يبدو أنّ الآنسة ماكميلان ستكون هي
!من يشعل النّار المُقدّسة هذا العام

34
00:04:16,160 --> 00:04:18,600
!لا أصدّق بأنّك أسقطت كريودر

35
00:04:18,600 --> 00:04:21,260
!لا بدّ أنّه كان جهداً شاقّاً

36
00:04:21,260 --> 00:04:24,600
حسناً، صادفتُه فحسب

37
00:04:33,510 --> 00:04:35,740
...ارتأيتُ أن أقبض عليه بسرعة

38
00:04:36,080 --> 00:04:39,840
وأستخدمه كطعم للقبض على تنّين

39
00:04:39,840 --> 00:04:43,440
...كـ-كم هذا جدير بالملاحظة

40
00:04:46,130 --> 00:04:48,180
...سيّد القلعة المسكين هذا

41
00:04:49,530 --> 00:04:50,750
...ريليانا

42
00:04:51,480 --> 00:04:57,160
أنا آسف حقّاً لأنّه ليس التنّين
الّذي أردتِه بشدّة

43
00:04:57,160 --> 00:04:58,280
ماذا؟

44
00:05:02,780 --> 00:05:04,940
الآنسة ماكميلان أرادت تنّيناً؟

45
00:05:04,940 --> 00:05:06,970
يا إلهي... تنّين؟

46
00:05:06,970 --> 00:05:08,780
تنّين بالتّحديد؟

47
00:05:08,780 --> 00:05:11,140
!جميعكم، أسأتُم الفهم

48
00:05:11,140 --> 00:05:14,290
!لستُ هذا النّوع من الفتيات

49
00:05:15,850 --> 00:05:17,830
ويحك يا دوقي

50
00:05:20,340 --> 00:05:22,830
أنت مُبلّل بالمطر

51
00:05:24,050 --> 00:05:27,840
لا تفوح منكِ رائحة كحول. ما الّذي أراه؟

52
00:05:28,280 --> 00:05:31,100
ليتني كنتُ ثملة بصراحة

53
00:05:33,920 --> 00:05:38,810
لأجلكِ، سأتحمّل المطر كلّ يوم

54
00:05:39,810 --> 00:05:43,810
ا-ادخل بسرعة. ستُصاب بنزلة برد

55
00:05:43,810 --> 00:05:45,630
أنت أيضاً يا سيّد تايلور

56
00:06:10,100 --> 00:06:13,100
!نوه! ما معنى كلّ هذا؟

57
00:06:13,100 --> 00:06:16,360
أرسلتُ آنسلي مسبقاً لإبلاغك

58
00:06:16,870 --> 00:06:21,280
لا بدّ أنّ جهود القبض على تنّين كانت مُروِّعة

59
00:06:21,280 --> 00:06:24,150
"وصفَت السيّدة آنسلي ذلك كـ"جحيم

60
00:06:24,150 --> 00:06:27,370
متى طلبتُ تنّيناً بالضبط؟

61
00:06:27,370 --> 00:06:28,410
...آدم

62
00:06:30,570 --> 00:06:32,190
...رأى ذلك وظنَّ

63
00:06:33,560 --> 00:06:36,480
!ليتني رميتها في النّار

64
00:06:36,480 --> 00:06:38,320
اذهب وبدّل ملابسك أيضاً

65
00:06:41,870 --> 00:06:45,370
سيترتّب عليّ إعطاء آدم منديل مختلف

66
00:06:45,370 --> 00:06:47,490
منديل من دون تنّين بالطبع

67
00:06:47,490 --> 00:06:49,750
لا تشعري بالإحباط

68
00:06:50,600 --> 00:06:53,640
سأجد لكِ تنّيناً في سلسلة جبال أخرى

69
00:06:54,190 --> 00:06:57,640
هل... تستفزّني؟

70
00:06:57,640 --> 00:06:59,680
فهمتِ أخيراً؟

71
00:06:59,690 --> 00:07:01,120
أريد أن أضربه

72
00:07:01,120 --> 00:07:04,720
أتمنّى لو أضرب وسادة لتهدئة نفسي

73
00:07:04,720 --> 00:07:05,960
...على أيّ حال

74
00:07:07,030 --> 00:07:09,040
إلى متى تنوين البقاء؟

75
00:07:14,040 --> 00:07:16,160
أودُّ تغيير ملابسي

76
00:07:17,420 --> 00:07:21,410
!ا-افعل من فضلك! سأغادر الآن

77
00:07:21,410 --> 00:07:25,340
إذا أردتِ أن تريني، بقاؤكِ مُرحَّب به

78
00:07:26,360 --> 00:07:27,770
!مهلك

79
00:07:27,770 --> 00:07:33,580
لأجل عينَي، أحجِم عن القيام
!بمثل هذه الأشياء

80
00:07:33,580 --> 00:07:35,800
تحبّين اختلاس النّظر، صحيح؟

81
00:07:36,040 --> 00:07:38,380
ماذا قال؟

82
00:07:38,380 --> 00:07:42,340
في البداية أنا فتاة ثريّة جاهلة تتوسّل
،للحصول على تنّين في حدَث دُولي

83
00:07:42,340 --> 00:07:44,350
!والآن أنا مُختلِسة نظر؟

84
00:07:44,350 --> 00:07:46,840
بأيّ صورة يحاول أن يصِفني؟

85
00:07:46,840 --> 00:07:50,360
أتمنّى ألّا تستمرّ في قول مثل
هذا الكلام التهكُّمي

86
00:07:50,360 --> 00:07:51,670
تهكُّمي؟

87
00:07:51,670 --> 00:07:54,380
—إذاً عندما كنتِ تُراقبينني وأنا نائم

88
00:07:57,950 --> 00:08:01,610
...لم يكن لأنّني مهتمّة بأيّ شيء من هذا

89
00:08:01,610 --> 00:08:03,680
!على أيّ حال، أنت مخطئ

90
00:08:03,680 --> 00:08:06,460
اعتذرتُ عن ذلك، أليس كذلك؟

91
00:08:06,460 --> 00:08:11,210
!وأيضاً كنت تراقبني عندما كنتُ نائمة

92
00:08:12,000 --> 00:08:13,280
في تلك المرّة؟

93
00:08:15,280 --> 00:08:18,220
،عندما ظننتِ بأننّي سأهاجمكِ أثناء نومكِ

94
00:08:18,490 --> 00:08:22,190
وصحتِ وكأنّها نهاية العالم؟

95
00:08:22,680 --> 00:08:24,680
متى "صحت"؟

96
00:08:24,680 --> 00:08:28,560
!أنت من أعطاني فكرة خاطئة في المقام الأوّل

97
00:08:29,820 --> 00:08:31,010
أنا آسف

98
00:08:31,480 --> 00:08:34,000
!وحتّى أنّك اعتذرت عن ذلك، أليس كذلك؟

99
00:08:34,360 --> 00:08:36,330
!هذا الوغد

100
00:08:39,780 --> 00:08:43,750
نوه، ألم تكن تعلم؟

101
00:08:46,240 --> 00:08:50,750
لا أحد يحبّ الرّجال الّذين يركّزون
على أخطاء الأشخاص الآخرين

102
00:08:54,100 --> 00:08:55,880
مفهوم؟

103
00:09:01,060 --> 00:09:02,800
يتظاهر بالخجل بصورة سيّئة

104
00:09:02,800 --> 00:09:06,900
!عِدني بأنّك لن تتحدّث عن هذا الأمر ثانية

105
00:09:06,900 --> 00:09:08,440
اتّفقنا؟

106
00:09:08,440 --> 00:09:09,670
...حسناً إذاً

107
00:09:09,670 --> 00:09:12,900
أنا متأكّدة بأنّك مُرهَق. ارتح قليلاً من فضلك

108
00:09:28,920 --> 00:09:32,800
كيف لي أن أفعل شيئاً كهذا لدوق؟

109
00:09:32,800 --> 00:09:38,920
أشعر وكأنّني... تقرّبتُ منه قليلاً

110
00:09:39,600 --> 00:09:41,700
هل أنتِ عائدة إلى غرفتكِ؟

111
00:09:42,720 --> 00:09:44,420
اسمحي لي بمُرافقتكِ

112
00:09:47,640 --> 00:09:52,220
الفارِسة الّتي وصلتِ معها قد تعافت

113
00:09:52,220 --> 00:09:54,710
إنّها ترتاح في غرفة منفصلة

114
00:09:55,080 --> 00:09:57,950
...شكراً لك... و

115
00:09:58,130 --> 00:10:00,730
هل سيّد القلعة بخير؟

116
00:10:00,730 --> 00:10:02,040
...أجل

117
00:10:02,040 --> 00:10:06,920
يظلُّ يصيح "كريودر!" بينما يغمر
إحباطه من خلال الشّرب

118
00:10:08,300 --> 00:10:09,640
...سامحيني، لكن

119
00:10:09,640 --> 00:10:10,520
نعم؟

120
00:10:10,960 --> 00:10:15,970
هل صحيح أنّ سموّه كان عازمً
على إيجاد تنّين؟

121
00:10:15,970 --> 00:10:19,350
...في الواقع، كان ذلك سوء فهم

122
00:10:38,860 --> 00:10:42,880
،كنتُ قلقاً عندما تأخّرتَ في العودة

123
00:10:42,880 --> 00:10:44,800
لكن يسرُّني أنّك بأمان

124
00:10:45,740 --> 00:10:47,760
وكأنّك تعني ذلك

125
00:10:48,650 --> 00:10:52,500
من المُطمئن أن أراك بأنّك لم تتغيّر البتّة

126
00:10:54,600 --> 00:10:55,970
ما معنى هذا؟

127
00:10:56,620 --> 00:10:59,580
،أشعر بالشّفقة على ذلك الكريودر
،سيّد الجبال

128
00:10:59,580 --> 00:11:03,610
إذا كنتَ قد قتلته من باب التّرفيه فقط

129
00:11:03,610 --> 00:11:05,290
من باب التّرفيه؟

130
00:11:05,290 --> 00:11:06,390
أجل

131
00:11:06,830 --> 00:11:11,180
هل أنا مخطئ؟ إن كان كذلك، فإنّني
أجد ذلك يبعث على القلق

132
00:11:12,400 --> 00:11:16,630
كانت أوّل مرّة تقبض فيها على
وحش أثناء الصّيد، صحيح؟

133
00:11:16,900 --> 00:11:20,980
كانت أوّل مرّة أعود فيها بواحد

134
00:11:21,960 --> 00:11:23,910
...صحيح. وأيضاً

135
00:11:24,400 --> 00:11:28,910
كانت أوّل مرّة لك تقدّم فيها
وحشاً لآنسة كذلك

136
00:11:29,830 --> 00:11:31,360
ما مقصدك؟

137
00:11:32,160 --> 00:11:35,060
أقصد فقط بأنّ هذا ليس طبعك

138
00:11:36,100 --> 00:11:40,280
بغضّ النّظر، ما المشكلة مع الدّوق بليك؟

139
00:11:41,570 --> 00:11:46,910
هناك إشاعات بأنّه تقرّب كثيراً
من امرأة ما مؤخّراً

140
00:11:46,910 --> 00:11:47,940
امرأة؟

141
00:11:47,940 --> 00:11:52,190
ويتون يبحث حول هويّتها حاليّاً

142
00:11:52,690 --> 00:11:54,330
امرأة؟

143
00:11:55,230 --> 00:11:58,680
آمل ألّا يحطّم نفسه على شيء سخيف

144
00:11:59,960 --> 00:12:02,800
،البعض يقولون بأنّ النّساء وحوش

145
00:12:02,800 --> 00:12:07,460
لكن أحياناً، يمكن أن يكونوا أكثر رُعباً

146
00:12:07,460 --> 00:12:10,550
إذا كان هناك شيء تريدين قوله، قوليه فحسب

147
00:12:12,460 --> 00:12:16,660
نوه، أسألك هذا كصديقك ومُعينك

148
00:12:17,250 --> 00:12:18,470
تفضّل

149
00:12:19,210 --> 00:12:21,960
هل أنت جادّ بشأن الآنسة ماكميلان؟

150
00:12:22,450 --> 00:12:23,560
لا

151
00:12:24,920 --> 00:12:27,220
أهذا ما أردتَ سؤاله؟

152
00:12:27,220 --> 00:12:29,480
أمسيتَ تتصرّف بغرابة مؤخّراً

153
00:12:29,480 --> 00:12:32,290
أعتقد بأنّك الشّخص الّذي يتصرّف بغرابة

154
00:12:35,240 --> 00:12:39,480
،إذاً إن سعيتُ خلف الآنسة ماكميلان

155
00:12:39,480 --> 00:12:41,290
هل سترضى بذلك؟

156
00:12:43,810 --> 00:12:45,600
،ماذا تقول

157
00:12:46,240 --> 00:12:48,950
يا كيث ويستيرنبيرغ؟

158
00:12:52,320 --> 00:12:54,200
تذكَّر مكانتك

159
00:12:59,590 --> 00:13:00,630
حسناً

160
00:13:24,190 --> 00:13:26,420
كلّ شيء مُلكي

161
00:13:27,560 --> 00:13:32,030
كلّ رجل ألتقيه يُمطرني بالعاطفة والهيام

162
00:13:32,030 --> 00:13:35,030
...دُمية فخّارية بعينَين ذهبيّتين متألّقتين

163
00:13:35,680 --> 00:13:39,550
...امرأة جميلة تحمل رائحة وردة زهريّة

164
00:13:40,490 --> 00:13:45,220
الأسنان خلف هاتين الشّفتين الحمراوتين
تتألّقان كما الألماس حسبما يقولون

165
00:13:45,730 --> 00:13:48,670
وهاتان السّاقان الطويلتان اللّتان تبدوان
جميلتين بالجورب الطويل المُخرّم

166
00:13:48,670 --> 00:13:50,850
تفتن كلّ الرّجال كما يقولون

167
00:13:52,350 --> 00:13:55,750
،مهما كنتُ كريهة أو أيّما يقوله الآخرون

168
00:13:55,750 --> 00:13:58,170
لطالما كنتُ الرّابحة

169
00:13:58,710 --> 00:14:03,120
امتلكتُ كلّ شيء، والحصول على
...ما أردتُه كان سهلاً

170
00:14:04,430 --> 00:14:06,630
إلى أن التقيتُ بذلك الرّجل

171
00:14:17,990 --> 00:14:22,090
السّبب الوحيد وراء قبولي بخطوبة
ذلك الملك الأعرج

172
00:14:22,090 --> 00:14:25,600
كان لجعله يندم على رفضي

173
00:14:26,560 --> 00:14:29,360
كان من المُفترَض أن أشعل نارَ المعبد
،المُقدّسة ثانية في هذا العام

174
00:14:29,360 --> 00:14:33,590
بينما أنظر باستخفاف إليه وإلى خطيبته

175
00:14:36,780 --> 00:14:38,080
...ومع ذلك

176
00:14:45,490 --> 00:14:48,790
!لا أتحمّل فكرة عدم كونه لي

177
00:15:09,150 --> 00:15:11,570
ثمّة شيء تريدينه، صحيح؟

178
00:15:13,800 --> 00:15:16,090
سيخدمكِ هذا

179
00:15:31,100 --> 00:15:33,800
ماذا؟ فيفيان شامال تغادر؟

180
00:15:33,800 --> 00:15:37,670
أجل. ستعود إلى قصرها

181
00:15:37,670 --> 00:15:40,640
لن تذهب إلى المعبد إذاً؟

182
00:15:40,640 --> 00:15:42,290
أجل

183
00:15:42,290 --> 00:15:46,880
لكن ألا يذهب الجميع إلى المعبد
بعد الصّيد في كلّ عام؟

184
00:15:46,880 --> 00:15:47,830
،بلى

185
00:15:47,830 --> 00:15:52,670
،لكن لا أحد من السيّدات مُلزَم بالذّهاب سواكِ

186
00:15:52,670 --> 00:15:56,310
باعتباركِ كونكِ من سيشعل النّار المُقدّسة

187
00:15:56,870 --> 00:15:58,850
هكذا إذاً

188
00:15:58,850 --> 00:16:02,190
سوف نغادر إلى المعبد حالما تجهزين

189
00:16:02,190 --> 00:16:03,530
تابعي من فضلكِ

190
00:16:03,540 --> 00:16:04,930
حسناً

191
00:16:07,210 --> 00:16:11,460
أعني، علاوة على أنّها ليست
،من ستشعل النّار المُقدّسة

192
00:16:11,460 --> 00:16:13,480
من سيفعل ذلك هو أنا أيضاً

193
00:16:13,480 --> 00:16:16,570
أعتقد لا يمكنني لومها على
عدم رغبتها في الذّهاب

194
00:16:17,030 --> 00:16:19,370
...لعلِّي تماديتُ قليلاً

195
00:16:24,640 --> 00:16:26,680
،قداستك هيكا

196
00:16:26,680 --> 00:16:30,090
ألا تنوي الذّهاب حقّاً؟

197
00:16:30,090 --> 00:16:32,900
لمَ ينبغي أن أنحرف عن مساري
وأذهب إلى هناك

198
00:16:32,900 --> 00:16:36,090
فقط لأجل مجموعة من النّبلاء التّافهين؟

199
00:16:36,430 --> 00:16:40,280
لكن سيكون الدّوق وينّايت حاضراً هذه المرّة

200
00:16:40,280 --> 00:16:42,570
هذا ما أتيتُ لأخبرك به

201
00:16:44,170 --> 00:16:45,750
...إنّه لا يسمعني حتّى

202
00:16:46,360 --> 00:16:51,700
إنّه يكره النُّبلاء دوماً ويعتبرهم حمقى أنانيّين

203
00:16:52,610 --> 00:16:57,710
!لكن هذه المرّة لا أستطيع الاستسلام

204
00:16:57,710 --> 00:17:02,080
الوضع المالي لمُنظّمتنا يسوء

205
00:17:04,620 --> 00:17:07,550
،التبرُّعات تقلُّ بعد كلّ سنة تمرّ

206
00:17:07,550 --> 00:17:11,590
وعمليّات مُنظّمتنا الداخليّة تعاني

207
00:17:11,960 --> 00:17:17,910
صيد الوحوش هو فرصتنا الأمثل
!للحصول على تبرُّعات من النُّبلاء

208
00:17:18,410 --> 00:17:20,590
وفوق كلّ ذلك، يسكن في المعبد الآن

209
00:17:20,600 --> 00:17:26,390
الكاهن العظيم والأسطورة الّذي
:غيّرَ اللّاهوتيّة كما عرفناها

210
00:17:26,390 --> 00:17:30,490
!العظيم هيكا ديمينت بشخصِه

211
00:17:33,400 --> 00:17:36,490
!من الواضح أنّ هذه هِداية إلهيّة

212
00:17:36,490 --> 00:17:42,040
إذاً مطلوب منّي أن أحضر شخصيّاً
كلّ صغيرة وكبيرة أيّها القمامة اللّعين؟

213
00:17:42,040 --> 00:17:43,430
—لـ-لعيـ

214
00:17:45,230 --> 00:17:47,270
!لن أفقد همّتي الآن

215
00:17:47,630 --> 00:17:50,310
إنّ السّماح للظروف الرّاهنة بالاستمرار ستعيق

216
00:17:50,310 --> 00:17:53,550
!بحثنا اللّاهوتي وتنشئة الجيل المقبل

217
00:17:53,550 --> 00:17:54,920
ماذا؟

218
00:17:54,920 --> 00:17:56,740
—أنت وبصورة مفاجئة

219
00:17:56,740 --> 00:17:58,190
،أقصد

220
00:17:58,190 --> 00:18:00,680
لطالما كان أكثر شيء أردتَه

221
00:18:00,680 --> 00:18:02,930
هو التّربية الأمثل لتلاميذك، أليس كذلك؟

222
00:18:02,930 --> 00:18:06,000
ربّما لو كنتَ تابعاً أذكى

223
00:18:06,000 --> 00:18:08,750
،بوسعه التقدُّم ببحثي يداً بيد معي

224
00:18:08,750 --> 00:18:12,570
!لكان ذلك قد اختذل خمس سنوات من دراساتنا

225
00:18:12,780 --> 00:18:18,570
حينئذ لاستطعنا ادّخار مال يكفي لخمس
!سنوات عوضاً عن إنفاقه بشكلٍ عبثيّ

226
00:18:18,570 --> 00:18:21,950
!هل تريد أن تقنعني بأنّ هذه ليست غلطتك الغبيّة؟

227
00:18:21,950 --> 00:18:24,310
،أنا، ويد ديفيس

228
00:18:24,310 --> 00:18:25,440
،بالرّغم من مظهري

229
00:18:25,440 --> 00:18:29,100
تخرّجتُ وأنا في المركز الأوّل في صفّي
!من مدرسة فيات اللّاهوتيّة الدّوليّة

230
00:18:29,100 --> 00:18:31,400
،قد لا أكون عبقريّاً مثلك

231
00:18:31,400 --> 00:18:34,640
لكن يمكنني وبكلِّ ثقة أن أقول
!بأنّني مُرهَّل لأكون أعجوبة

232
00:18:34,640 --> 00:18:38,220
المدرسة اللّاهوتيّة تقبل أيّ غبيّ
في هذه الأيّام، صحيح؟

233
00:18:38,220 --> 00:18:39,970
!قداستك

234
00:18:40,400 --> 00:18:42,770
،بحسب شخصيّتك

235
00:18:42,770 --> 00:18:47,980
فمك هذا كفمِ الببغّاء كثير الصّياح
!سيكون سبب موتك صغيراً

236
00:18:47,980 --> 00:18:51,910
!ماذا تقول؟! لا يمكنك رؤية شخصيّتي إطلاقاً

237
00:18:51,910 --> 00:18:53,640
!أجل، هذا صحيح

238
00:18:53,640 --> 00:18:58,030
لا يستطيع أحدٌ رؤية شخصيّتك تحت
!هذا القناع الصّلصالي الّذي تسمّيه وجهاً

239
00:18:58,030 --> 00:19:01,080
!لا علاقة لهذا بالشخصيّة
!هذه مجرّد لعنة فحسب

240
00:19:01,080 --> 00:19:02,510
!اصمت

241
00:19:02,510 --> 00:19:07,090
أنصحك أن تصمت فحسب وتعمل
!بجدّ وتعيش حياة رغيدة

242
00:19:07,090 --> 00:19:09,290
!أغلِق فمك واسمع فحسب

243
00:19:13,350 --> 00:19:18,190
يا إلهي، امنحني القوّة أرجوك
لأحقّق النّصر على هذا المُسنّ

244
00:19:18,810 --> 00:19:21,620
قداستك، اسمعني أرجوك

245
00:19:22,130 --> 00:19:24,820
،بالنسبة لأولئك النُّبلاء التّافهين

246
00:19:25,190 --> 00:19:29,510
حتّى مجرّد ظهورك للحظات، بصفتك
،رئيس مُنظّمتنا

247
00:19:29,510 --> 00:19:32,320
يحمل قيمة هائلة لا نظير لها

248
00:19:32,830 --> 00:19:36,710
مجرّد تحيّة من كلمة ومُصافحة منك

249
00:19:36,710 --> 00:19:41,310
ستعود على المعبد بتبرُّعات كافية
للحِفاظ عليه عاماً آخر

250
00:19:41,320 --> 00:19:46,810
قداستك، كلّ ما يتطلّبه الأمر منك
هو الكشف عن وجهك ببساطة

251
00:19:47,400 --> 00:19:50,770
لطالما كان رجلاً مُعتزّاً

252
00:19:50,770 --> 00:19:53,440
!لا يمكن أن يتجاهل طلبي بعد سماع كلّ هذا

253
00:19:53,440 --> 00:19:56,840
،حسناً، ربّما... ويد

254
00:19:56,840 --> 00:19:58,070
تعال إلى هنا

255
00:19:58,070 --> 00:19:59,840
!هل فهمت أخيراً؟

256
00:20:00,990 --> 00:20:02,520
انقلع من هنا

257
00:20:09,350 --> 00:20:14,350
ريليانا، سأتوجّه إلى المعبد أوّلاً

258
00:20:14,350 --> 00:20:16,580
رحلة مُوفّقة

259
00:20:18,830 --> 00:20:23,070
أتطلّع قُدماً للإشعال الشعائريّ للنار المُقدّسة

260
00:20:24,380 --> 00:20:28,070
!يا له من رجل

261
00:20:33,120 --> 00:20:36,460
آنسة ماكميلان، تحيّة لكِ

262
00:20:37,640 --> 00:20:41,560
سأدعو لنجاح الإشعال الشعائريّ

263
00:20:41,920 --> 00:20:44,230
شـ-شكراً لكِ

264
00:21:04,400 --> 00:21:07,510
هل كانت هذه في أمتعتي؟

265
00:21:08,780 --> 00:21:10,520
آنسة ماكميلان

266
00:21:10,910 --> 00:21:13,630
،كان ويتّون في القصر يؤدّي مهاماً ثانويّة

267
00:21:13,630 --> 00:21:15,650
وتركَ غيديون هذه معه

268
00:21:16,510 --> 00:21:17,700
شكراً لكِ

269
00:21:17,700 --> 00:21:20,020
حان وقتُ مُغادرتنا

270
00:21:20,020 --> 00:21:21,410
حسناً

271
00:21:25,570 --> 00:21:27,930
كلّ شيء لي

272
00:22:42,470 --> 00:22:44,780
...مدرسة فيات اللّاهوتيّة الدُّوليّة

273
00:22:45,910 --> 00:22:49,810
أكتُب ردّاً على المسألة الّتي سألت عنها"

274
00:22:50,370 --> 00:22:54,450
...تلميذة باسم بياتريس ترانسيت

275
00:22:56,020 --> 00:22:57,940
"لا تُداوم في هذه المدرسة

276
00:22:59,560 --> 00:23:03,060
بياتريس ليست هناك؟ هل عادت إلى المنزل؟

277
00:23:05,080 --> 00:23:07,960
أم أنّها في مكان مختلف تماماً؟

278
00:23:08,870 --> 00:23:15,900
في الأصل، عادَتْ لأنّني أنا، ريليانا
...ماكميلان، قد متّ

279
00:23:17,380 --> 00:23:19,240
لكنّني نجوت

280
00:23:20,130 --> 00:23:22,290
...لذا بسببي

281
00:23:23,480 --> 00:23:26,680
الأشياء الّتي ستحدث من الآن قد تتغيّر؟

282
00:23:30,000 --> 00:23:31,580
...بياتريس