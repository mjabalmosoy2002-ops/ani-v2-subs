1
00:00:08,560 --> 00:00:12,360
من الّذي يريدني أن أموت؟

2
00:00:14,300 --> 00:00:15,860
مبارزة بالسّيف؟

3
00:00:20,370 --> 00:00:23,830
في العادة، يكون نوه منهمكاً بالمعاملات الورقيّة

4
00:00:23,830 --> 00:00:25,370
،باعتبار أنّ واجبه هو مساعدة الملك

5
00:00:26,000 --> 00:00:27,050
،لكن في الرّواية

6
00:00:27,050 --> 00:00:30,200
تمّ وصفه على أنّه أكثر موهبة
بالسّيف منه بالقلم

7
00:00:30,880 --> 00:00:33,790
!لحظة، لماذا أعيره كلّ هذا الانتباه الآن؟

8
00:00:34,800 --> 00:00:36,130
...ريليانا

9
00:00:38,080 --> 00:00:39,670
هل مللتِ؟

10
00:00:39,670 --> 00:00:43,140
لا. هل انتهى التّدريب؟

11
00:00:43,600 --> 00:00:48,400
كنتِ تحدّقين بي بإمعان فلم أستطع تجاهلكِ

12
00:00:50,570 --> 00:00:52,730
كنتُ أنظر للسيوف فحسب

13
00:00:52,730 --> 00:00:55,160
ارتأيتُ أن أتعلّم المبارزة بالسّيف أيضاً

14
00:00:55,600 --> 00:00:58,040
قد تكون هذه فكرة سديدة

15
00:00:58,040 --> 00:00:59,330
...في هذه الحالة

16
00:01:07,860 --> 00:01:10,800
لمَ لا نفعل شيئاً أكثر تسلية؟

17
00:01:11,480 --> 00:01:13,270
شيء أكثر تسلية"؟"

18
00:02:53,510 --> 00:02:54,520
أنت

19
00:02:54,520 --> 00:02:56,360
استدعِ غريس

20
00:02:56,360 --> 00:02:57,680
بكلِّ سرور

21
00:02:59,030 --> 00:03:00,580
...ارتأيتُ

22
00:03:01,080 --> 00:03:04,780
أن أنتهز هذه الفرصة لتنظيم مجوهراتي

23
00:03:05,280 --> 00:03:06,400
لماذا؟

24
00:03:07,000 --> 00:03:09,910
في الواقع، لديّ خطيبة

25
00:03:09,910 --> 00:03:13,510
تقصد تلك الخطيبة الجميلة، صحيح؟

26
00:03:13,830 --> 00:03:17,280
..."أجل، إنّها الخطيبة "الجميلة حقّاً

27
00:03:17,280 --> 00:03:20,960
لكن لأنّها لا تتمتّع بالاحترام الذّاتي
،وتفتقر لرجاحة العقل

28
00:03:20,960 --> 00:03:23,480
كانت تجلب إلى المنزل كلّ
صغيرة وكبيرة تجدها

29
00:03:23,800 --> 00:03:26,560
...حتّى بعد أن حذّرتُها من ذلك مراراً

30
00:03:29,690 --> 00:03:32,510
هل يقصد بأنّها كانت غلطتي؟

31
00:03:32,510 --> 00:03:37,320
في الحقيقة يا دوقي، لديّ خطيب أيضاً

32
00:03:37,760 --> 00:03:41,330
تقصدين الخطيب ذا الوجه الوسيم جدّاً؟

33
00:03:41,710 --> 00:03:45,440
أجل، وذلك الخطيب بمظهره الجميل نسبيّاً

34
00:03:45,440 --> 00:03:49,120
،لا يحترم ولا يراعي خطيبته

35
00:03:49,120 --> 00:03:51,730
لذا يلتفّ ويدور ليروي أنصاف الحقائق

36
00:03:52,110 --> 00:03:54,960
...حتّى بعد أن حذّرتُه مراراً

37
00:03:58,960 --> 00:04:00,050
تعالي معي

38
00:04:03,850 --> 00:04:06,170
لا يستطيع أن يبعد يديه أيضاً

39
00:04:09,590 --> 00:04:11,560
...نوه

40
00:04:13,980 --> 00:04:16,320
هل ترين هذه المجوهرات؟

41
00:04:17,440 --> 00:04:24,190
أحضرتُ خطيبتي "الجميلة حقّاً" إلى
هنا بدافع احترامها

42
00:04:26,440 --> 00:04:29,730
والآن هل تشعرين بأنّ خطيبكِ ذا

43
00:04:29,730 --> 00:04:32,450
المظهر الجميل نسبيّاً" يراعي مشاعركِ؟"

44
00:04:32,450 --> 00:04:33,360
...مهلاً

45
00:04:33,360 --> 00:04:36,820
الدّوق وينايت، شكراً على الانتظار

46
00:04:37,200 --> 00:04:38,480
غريس

47
00:04:39,140 --> 00:04:40,230
!حسناً، حسناً

48
00:04:40,230 --> 00:04:43,440
لا بدّ أنّ هذه الخطيبة الّتي سمعتُ الكثير عنها

49
00:04:44,810 --> 00:04:48,320
،ظننتُك غير مهتمّ بالنساء

50
00:04:48,320 --> 00:04:52,220
لكن أعتقد لم تُعجَب بواحدة من قبل فحسب

51
00:04:52,220 --> 00:04:54,080
...فـ-في الحقيقة

52
00:04:54,080 --> 00:04:56,030
أحسنتِ صنعاً يا سيّدة غريس

53
00:04:56,030 --> 00:04:57,660
كشفتِني

54
00:04:58,360 --> 00:05:01,130
وصلَتْني بعض القِطع الجميلة مؤخّراً

55
00:05:01,130 --> 00:05:02,730
هل ترغب في رؤيتها؟

56
00:05:03,200 --> 00:05:04,270
من فضلك

57
00:05:05,630 --> 00:05:08,800
"تُدعى هذه بـ"دمعة الحوريّة

58
00:05:08,800 --> 00:05:12,880
حقّقتْ أعلى سعر من بين جميع
المواد في مزاد ديفاسا

59
00:05:12,880 --> 00:05:15,370
ما رأيكِ؟ هل أعجبتكِ؟

60
00:05:15,750 --> 00:05:18,020
!إنّها جميلة فعلاً

61
00:05:18,020 --> 00:05:19,820
يسرّني سماع ذلك

62
00:05:19,820 --> 00:05:23,000
...إنّها جميلة بالطبع، لكن

63
00:05:23,760 --> 00:05:27,000
في هذه الحالة، سآخذ كلّ شيء في المتجر

64
00:05:27,000 --> 00:05:28,250
!ماذا؟

65
00:05:28,250 --> 00:05:30,410
!خيار موفّق، سموّك

66
00:05:30,410 --> 00:05:32,320
سنبدأ بهذه إذاً

67
00:05:34,080 --> 00:05:35,540
سنأخذ هذه الآن

68
00:05:35,540 --> 00:05:37,830
اطلبي إرسال المواد الأخرى إلى قصري

69
00:05:38,770 --> 00:05:40,530
بكلّ سرور

70
00:05:45,130 --> 00:05:48,160
هل يمكنني قبول هذا حقّاً؟

71
00:05:48,680 --> 00:05:51,110
إنّه يلائمكِ كثيراً يا ريليانا

72
00:05:53,360 --> 00:05:55,770
!لـ-لا تفكّري في الأمر

73
00:06:42,850 --> 00:06:44,380
ألستِ مُتعبة؟

74
00:06:45,460 --> 00:06:47,830
لم نكن نمشي كثيراً

75
00:06:48,270 --> 00:06:50,920
سمعتُ بأنّكِ منحتِ الخادمات إجازة

76
00:06:51,720 --> 00:06:52,870
أجل

77
00:06:52,870 --> 00:06:55,380
أليس من القسوة عدم السّماح لهُن

78
00:06:55,380 --> 00:06:57,570
على الأقلّ بقضاء عيد الشّكر مع عائلاتهن؟

79
00:06:57,570 --> 00:06:59,850
بالطبع، هذا مجرّد عذر طرحتُه

80
00:06:59,850 --> 00:07:02,850
!احتجتُ ليوم راحة وسكينة

81
00:07:08,230 --> 00:07:09,480
...مولايّ

82
00:07:16,990 --> 00:07:19,750
ريليانا، ثمّة مشكلة

83
00:07:19,750 --> 00:07:22,120
عليّ أن أغادر حالاً

84
00:07:22,120 --> 00:07:24,400
حسناً. بالتوفيق

85
00:07:34,620 --> 00:07:35,520
نعم؟

86
00:07:35,520 --> 00:07:36,910
...المعذرة

87
00:07:37,640 --> 00:07:39,060
مولاتي

88
00:07:39,060 --> 00:07:40,640
!هيلي

89
00:07:40,640 --> 00:07:42,760
لم تعودي إلى المنزل بعد؟

90
00:07:42,760 --> 00:07:46,830
أشكركِ من أعماق قلبي على منحي وقت إجازة

91
00:07:48,140 --> 00:07:50,770
اذهبي واستمتعي بعيد الشّكر

92
00:07:50,770 --> 00:07:52,120
سأفعل

93
00:07:52,490 --> 00:07:56,030
في الحقيقة، أريد أن أخبركِ بشيء

94
00:07:56,030 --> 00:07:57,880
ما-ما هو؟

95
00:07:57,880 --> 00:07:59,900
،يجب عليكِ، ومهما كانت الظروف

96
00:07:59,900 --> 00:08:02,420
ألّا تنظري للمرآة في الغرفة الخلفيّة
من البناء الغربيّ

97
00:08:02,420 --> 00:08:04,920
مرآة؟ لِمَ لا؟

98
00:08:04,920 --> 00:08:08,580
،تمّ تعيين خادمة كمُناوِبة هناك

99
00:08:08,580 --> 00:08:11,730
وقالتْ بأنّها سمعت صوتاً

100
00:08:11,730 --> 00:08:13,790
ما-ما معنى هذا؟

101
00:08:13,790 --> 00:08:18,560
هناك روح عالقة داخل المرآة في تلك الغرفة

102
00:08:18,980 --> 00:08:21,220
قيل بأنّكِ إذا نظرتِ إلى الرّوح في المرآة

103
00:08:21,220 --> 00:08:23,400
بشكل مباشر، فسوف تتكلّم معكِ

104
00:08:26,430 --> 00:08:28,530
ما-ماذا تقول؟

105
00:08:28,940 --> 00:08:31,930
"سأخبرك بأيّ شيء تريدين معرفته"

106
00:08:32,200 --> 00:08:34,200
أيّ شيء؟

107
00:08:38,080 --> 00:08:40,020
!السّاعة

108
00:08:40,020 --> 00:08:41,600
،حسناً يا مولاتي

109
00:08:41,600 --> 00:08:44,940
ما زال عليّ تحضير أمتعتي من أجل
عودتي إلى المنزل

110
00:08:53,960 --> 00:08:56,680
،إذا كانت هناك مرايا كهذه فعلاً

111
00:08:56,680 --> 00:08:58,960
فليس هناك إلّا شيء واحد أريد معرفته

112
00:08:59,210 --> 00:09:04,870
أين بياتريس، بطلة هذه القصّة الحقيقيّة؟

113
00:09:22,310 --> 00:09:23,830
...هذا مخيف

114
00:09:23,830 --> 00:09:26,950
ينبغي أن أبقى بهدوء في غرفتي فحسب

115
00:09:30,370 --> 00:09:31,690
لا بدّ أنّ هذا هو السّبب، صحيح؟

116
00:09:32,830 --> 00:09:34,760
!هذا مخيف جدّاً

117
00:09:41,120 --> 00:09:43,630
بعض الطيور فحسب

118
00:09:56,440 --> 00:09:58,190
ما-ماذا أفعل؟

119
00:09:58,190 --> 00:10:00,700
هل عليّ حقّاً أن أنظر إليها بشكل مباشر؟

120
00:10:00,700 --> 00:10:03,920
،ماذا لو كانت حقيقة أنّها تخبرني بما أريد كذبة

121
00:10:03,920 --> 00:10:06,790
!وأنّها تلعنني فعليّاً بدلاً من ذلك؟

122
00:10:13,140 --> 00:10:14,530
...صوت

123
00:10:14,530 --> 00:10:19,010
لم أستطع سماعه جيّداً، لكن
أنا متأكّدة بأنّني سمعته

124
00:10:32,610 --> 00:10:33,810
هل أنتِ بخير؟

125
00:10:36,070 --> 00:10:38,700
لماذا تبدين مُرتعدة؟

126
00:10:39,080 --> 00:10:42,450
!لأنّني... رأيتُ ذلك

127
00:10:43,840 --> 00:10:44,740
رأيتِ ماذا؟

128
00:10:45,890 --> 00:10:47,050
شبح

129
00:10:48,660 --> 00:10:50,080
شبح؟

130
00:10:50,490 --> 00:10:54,840
!هل تعتقد بأنّني أُلفّق ذلك؟! إنّها الحقيقة

131
00:10:55,360 --> 00:10:59,360
حسناً إذاً، سنحضر كاهناً إلى هنا غداً

132
00:10:59,670 --> 00:11:02,220
ماذا تفعل هنا على أيّ حال؟

133
00:11:02,220 --> 00:11:05,200
نسيتُ شيئاً هنا

134
00:11:05,600 --> 00:11:07,980
!لأنّك كنت قلقاً عليّ؟

135
00:11:07,980 --> 00:11:10,860
لا، نسيتُ شيئاً

136
00:11:14,800 --> 00:11:17,860
هل ستعود مباشرة إذاً؟

137
00:11:20,860 --> 00:11:22,080
لا

138
00:11:22,080 --> 00:11:24,670
هذا ليس شيئاً لا يمكن تأجيله إلى يوم غد

139
00:11:25,200 --> 00:11:27,120
هل تريدينني أن أوصلكِ إلى غرفتكِ؟

140
00:11:27,520 --> 00:11:29,000
!أجل

141
00:11:37,380 --> 00:11:40,320
لكن... لماذا عدت؟

142
00:11:41,000 --> 00:11:43,210
،يقول بأنّه نسي شيئاً

143
00:11:43,210 --> 00:11:45,210
لكن هل كان ليأتي ويأخذه في هذه السّاعة؟

144
00:11:45,680 --> 00:11:49,260
ربّما كان قلقاً فعلاً عليّ؟

145
00:11:50,030 --> 00:11:50,920
هيّا بنا

146
00:11:51,750 --> 00:11:53,120
حـ-حسناً

147
00:11:53,120 --> 00:11:54,640
لا، غير ممكن

148
00:12:03,700 --> 00:12:05,990
شكراً على اقتطاعك من وقتك للقيام بهذا

149
00:12:06,480 --> 00:12:08,280
تصبح على خير إذاً

150
00:12:09,960 --> 00:12:11,650
ألستِ خائفة؟

151
00:12:11,900 --> 00:12:13,300
من ماذا؟

152
00:12:13,300 --> 00:12:15,580
من الأشباح. رأيتِ واحداً، أليس كذلك؟

153
00:12:16,290 --> 00:12:19,420
...أجل، رأيت، لكن

154
00:12:19,420 --> 00:12:22,180
أنا واثق بأنّكِ ستبقين مُستيقظة
وأنتِ تبكين، أليس كذلك؟

155
00:12:22,180 --> 00:12:23,870
!اذهب الآن فحسب من فضلك

156
00:12:23,870 --> 00:12:25,920
مهلاً، لا تقولي ذلك

157
00:12:26,400 --> 00:12:28,360
!أ-أنت

158
00:12:29,830 --> 00:12:30,920
حسناً

159
00:12:30,920 --> 00:12:32,990
سأبقى معكِ حتّى تنامي

160
00:12:32,990 --> 00:12:34,560
اخلدي إلى النّوم

161
00:12:41,240 --> 00:12:43,660
يمكنك النّوم في السّرير إذاً

162
00:12:43,660 --> 00:12:45,570
سأنام على الكرسيّ

163
00:12:49,620 --> 00:12:52,240
ما-ماذا... نوه؟

164
00:12:52,980 --> 00:12:55,460
!ا-انتظر

165
00:13:12,310 --> 00:13:15,720
.ليست وكأنّها المرّة الأولى لكِ
لماذا تتصرّفين بهذا الشّكل الآن؟

166
00:13:15,720 --> 00:13:17,770
!هـ-هل عليك قولها بهذا الشّكل؟

167
00:13:17,770 --> 00:13:20,730
!إذا سمعك شخصٌ آخر، سيسيء الفهم

168
00:13:20,730 --> 00:13:24,870
لستُ سيّئاً لدرجة أجعل خطيبتي
،تنام على كُرسيّ

169
00:13:24,870 --> 00:13:27,480
لذا نامي بجانبي رجاء

170
00:13:33,130 --> 00:13:35,620
هل يمكنني قراءة هذا؟

171
00:13:35,620 --> 00:13:40,180
قصّة حبّ حول رومانسيّة مُحرّمة
بين فارس وأميرة

172
00:13:40,180 --> 00:13:43,390
لكن لا أظنّك تفضّل مثل هذه القصص

173
00:13:43,390 --> 00:13:46,260
لا مشكلة. لا أبالي للنّوع

174
00:13:59,760 --> 00:14:03,110
!لا جدوى! لا أستطيع النّوم

175
00:14:05,760 --> 00:14:06,800
نوه؟

176
00:14:06,800 --> 00:14:07,880
نعم؟

177
00:14:08,530 --> 00:14:10,240
إلى أين وصلت؟

178
00:14:10,670 --> 00:14:13,670
إلى اللّحظة الّتي يلتقيان بها في قاعة الرّقص

179
00:14:13,670 --> 00:14:15,120
!تلك الجزئيّة

180
00:14:15,120 --> 00:14:17,660
ألا تجعل نبضات قلبك تتسارع؟

181
00:14:17,660 --> 00:14:19,040
بالفعل

182
00:14:19,040 --> 00:14:22,670
إنّها هزليّة جدّاً لدرجة تجعلها دراميّة

183
00:14:23,000 --> 00:14:24,160
هزليّة؟

184
00:14:24,160 --> 00:14:26,600
يلتقيان بالصّدفة ويقعان في
،في الحبّ من أوّل نظرة

185
00:14:26,600 --> 00:14:29,290
لكن يفصلهما حادث مفاجئ

186
00:14:29,290 --> 00:14:33,180
بعد أشهر قليلة، يلتقيان من جديد في قاعة رقص

187
00:14:33,180 --> 00:14:35,880
،بناؤها على سلسلة من المُصادفات هزليّة

188
00:14:35,880 --> 00:14:37,550
وتفتقر للواقعيّة

189
00:14:38,440 --> 00:14:42,070
يقول هذا بطل قصّة رومانسيّة

190
00:14:44,140 --> 00:14:46,180
،إذا كان كلّ همّك هو الواقعيّة

191
00:14:46,180 --> 00:14:48,810
فلن تحظى بأيّ إثارة أو رومانسيّة

192
00:14:49,860 --> 00:14:52,310
هل قرأت الجزئيّة حيث يعترف الفارس بحبّه؟

193
00:14:52,310 --> 00:14:53,080
ليس بعد

194
00:14:53,080 --> 00:14:56,430
!حسناً، اقرأها بسرعة! ستجعل قلبك يخفق

195
00:14:56,430 --> 00:14:59,200
ريليانا... ألن تنامي؟

196
00:14:59,480 --> 00:15:01,080
لماذا تسأل؟

197
00:15:02,160 --> 00:15:03,830
لأنّكِ مصدر إزعاج

198
00:15:05,160 --> 00:15:07,450
حسناً، حسناً

199
00:15:08,180 --> 00:15:10,920
تأخّر الوقت. اخلدي إلى النّوم

200
00:15:10,920 --> 00:15:12,820
فهمت

201
00:15:50,160 --> 00:15:52,100
سأفقد صوابي

202
00:16:11,710 --> 00:16:13,300
الكونت أوبريان

203
00:16:17,090 --> 00:16:21,880
الدّوق وينايت. تسرّني رؤيتك من جديد

204
00:16:23,460 --> 00:16:26,130
سمعتُ بأنّك غبت عن المنزل في مهمّة

205
00:16:27,130 --> 00:16:29,600
أجل، وقد أنجزتُها بأمان

206
00:16:30,470 --> 00:16:33,160
فهمت. هل جلالته في الدّاخل؟

207
00:16:33,160 --> 00:16:35,170
...المعذرة يا حضرة الدّوق

208
00:16:35,170 --> 00:16:37,310
هلّا طلبتُ منك الانتظار قليلاً؟

209
00:17:02,920 --> 00:17:06,540
جلالة الملك سياتري، ناومي أوبريان هنا

210
00:17:10,110 --> 00:17:11,450
!جلالتك

211
00:17:16,860 --> 00:17:18,530
استيقظ من فضلك

212
00:17:19,190 --> 00:17:23,170
ناومي... لماذا أنتِ عديمة الإحساس؟

213
00:17:23,680 --> 00:17:25,850
كان بوسعكِ أن تطرقي على الأقلّ

214
00:17:25,850 --> 00:17:27,240
فعلت

215
00:17:28,720 --> 00:17:30,280
لم أسمع ذلك

216
00:17:30,680 --> 00:17:35,190
لم تسمعني في حياتك عندما أطرق

217
00:17:35,190 --> 00:17:36,710
حقّاً؟

218
00:17:36,710 --> 00:17:40,170
أنصحك بفحص حاسّة السّمع لديك

219
00:17:40,170 --> 00:17:44,700
...فـ-في الواقع، ربّما سمعتُ صوتَ طرق باب

220
00:17:44,700 --> 00:17:47,210
!لا، سمعتُ ذلك بشكل جيّد

221
00:17:47,640 --> 00:17:49,720
يسرّني سماع هذا

222
00:17:51,380 --> 00:17:52,920
تذكّرت

223
00:17:52,920 --> 00:17:55,960
تلك الآنسة الصّغيرة الّتي كنتُ معها
أخبرتني بإشاعة مثيرة للاهتمام

224
00:18:00,380 --> 00:18:02,980
،قالت بينما كنتُ أحوم بين الحياة والموت

225
00:18:02,980 --> 00:18:07,850
خطبَ أخي الصّغير نوه امرأة يحبّها

226
00:18:09,030 --> 00:18:11,400
أعتقد كان اسمها... رالي؟

227
00:18:11,400 --> 00:18:14,670
أعتقد "الحَوم بين الحياة والموت" مُبالَغة

228
00:18:14,670 --> 00:18:16,450
وليست "رالي" أيضاً

229
00:18:16,450 --> 00:18:18,660
إنّها الآنسة ريليانا من عائلة ماكميلان

230
00:18:21,660 --> 00:18:28,410
إذاً حتّى ملك تشاموس الحالي
يناقش مثل هذه الأمور في السّرير؟

231
00:18:29,380 --> 00:18:32,670
كلّ هذا بدافع الحبّ لأخي الصّغير

232
00:18:32,670 --> 00:18:33,960
المعذرة

233
00:18:34,970 --> 00:18:38,070
جلالتك، أرى بأنّ جروحك شُفيت تماماً

234
00:18:38,070 --> 00:18:40,650
كيث! لم أرك منذ وقت

235
00:18:40,650 --> 00:18:42,130
وأين نوه؟

236
00:18:42,130 --> 00:18:43,310
هنا

237
00:18:43,810 --> 00:18:46,620
نوه! كنتَ تقف هناك؟

238
00:18:47,560 --> 00:18:50,680
...يبدو أنّ هناك شخص ناقص. ذو العينين الحمراوتين

239
00:18:51,680 --> 00:18:55,560
لدى السيّد آدم عمل يقوم به ولم يعُد بعد

240
00:18:55,560 --> 00:18:58,570
هذا غير معتاد

241
00:19:01,570 --> 00:19:03,910
،حسناً، الآن بعد أن اجتمع الكلُّ هنا

242
00:19:03,910 --> 00:19:07,180
ما رأيكم أن نشرب نخباً ليوم غد؟

243
00:19:07,180 --> 00:19:09,320
الجلسة الحاليّة ستنتهي أخيراً

244
00:19:14,240 --> 00:19:18,260
لا يمكن اقتراح المشاريع المرفوضة
من جديد إلّا بعد سنوات قليلة

245
00:19:18,260 --> 00:19:22,920
لذا تحاشينا قانون منع النّبلاء
الحديثين في الوقت الرّاهن؟

246
00:19:23,390 --> 00:19:27,950
ما يعني بأنّه لم يعد هناك أي حاجة
لإخفاء الختم الملكي

247
00:19:28,840 --> 00:19:31,060
...بخصوص الحصان الّذي رماك

248
00:19:31,590 --> 00:19:34,840
عُثِر على مُنشّطات في جهازه الهضمي

249
00:19:35,110 --> 00:19:40,850
عرفتُ بأنّ الحصان كان يتصرّف بشكل
غريب على أن تكون تلك الحادثة صدفة

250
00:19:41,350 --> 00:19:42,220
أجل

251
00:19:42,580 --> 00:19:47,860
تمّ تدبير ذلك بواسطة الكونت بينيت
كجزء من مُخطّط لاغتيالك

252
00:19:48,240 --> 00:19:49,800
بينيت؟

253
00:19:49,800 --> 00:19:53,210
لن يكون هناك شخص أسعد منه إذا متُّ

254
00:19:54,640 --> 00:20:00,400
كان الكونت بينيت ليعلّق جثّتك
في السّاحة ويرقص حولها

255
00:20:00,400 --> 00:20:02,380
كان ليغنّي غالباً أيضاً

256
00:20:02,750 --> 00:20:07,260
لا أعرف كيف تقولين هذا الكلام
الفظيع بهذا الهدوء الشّديد

257
00:20:08,390 --> 00:20:10,490
أنت تسيئ الفهم يا جلالتك

258
00:20:11,770 --> 00:20:15,160
على أيّ حال يا نوه، سمعتُ بأنّك خطبت

259
00:20:15,160 --> 00:20:18,070
أعتقد بأنّ اسم الآنسة كان... راليانا؟

260
00:20:18,910 --> 00:20:24,400
كما سبقَ وأخبرتُك، اسمها ريليانا ماكميلان

261
00:20:24,400 --> 00:20:26,650
!أجل! ريليانا

262
00:20:26,650 --> 00:20:32,410
ما الّذي غيّر رأيك بينما كنتُ
تحت تأثير المُسكِّن؟

263
00:20:34,120 --> 00:20:36,960
حدثت أمور عديدة

264
00:20:37,380 --> 00:20:38,600
...الحقيقة هي

265
00:20:44,790 --> 00:20:46,320
المعذرة

266
00:20:50,120 --> 00:20:52,690
سأترك هذه هنا

267
00:20:53,090 --> 00:20:54,800
شكراً يا هيلي

268
00:20:55,440 --> 00:20:58,030
انتهت أمطار الخريف

269
00:20:58,030 --> 00:21:01,470
سيبدأ البرد قريباً

270
00:21:01,850 --> 00:21:03,520
أمطار الخريف؟

271
00:21:03,520 --> 00:21:05,640
أعتقد أنّ هذا قد يحفّز ذكرى

272
00:21:05,970 --> 00:21:07,200
ماذا كانت؟

273
00:21:16,230 --> 00:21:20,460
"تنتهي الجلسة أخيراً. ماذا سيحلّ بالختم الملكيّ؟"

274
00:21:21,510 --> 00:21:22,630
...أيُعقَل

275
00:21:24,840 --> 00:21:26,290
مولاتي؟

276
00:21:27,630 --> 00:21:29,670
!كيف لي أن أنسى؟

277
00:21:37,720 --> 00:21:39,940
،قبل يوم من نهاية الجلسة

278
00:21:39,940 --> 00:21:41,870
...في قبر عائلة وينايت

279
00:21:42,870 --> 00:21:46,400
وفقاً للرواية، ينبغي أن تكون هناك

280
00:21:47,370 --> 00:21:50,360
!الشّقراء، بياتريس

281
00:22:06,110 --> 00:22:10,510
ما يعني بأنّ خطوبتك ستُلغى الآن، صحيح؟