1
00:00:02,170 --> 00:00:05,870
أجني حوالي 60،000 شهريّاً
مُقابل قطع أشجار، أليس كذلك؟

2
00:00:06,570 --> 00:00:11,240
وأيضاً الكِلية التي بعتُها. بثمن 1.2 مليون

3
00:00:11,680 --> 00:00:14,870
كان ثمن عيني اليُمنى 300،000

4
00:00:15,530 --> 00:00:18,130
...بعتُ خصية من خصيتَي

5
00:00:18,130 --> 00:00:22,630
كم كانَ ثمنها؟ أعتقد... ولا حتّى 100،000

6
00:00:23,750 --> 00:00:26,330
...وما زلتُ مَديناً

7
00:00:26,960 --> 00:00:29,330
بحوالي 38،040،000 ين

8
00:00:32,880 --> 00:00:35,720
أفهمك يا بوتشيتا

9
00:00:35,720 --> 00:00:37,730
لنقتل هذا الشّيء حالاً

10
00:00:40,910 --> 00:00:44,400
فصيد الشّياطين هو الكسب السّهل والأكثر ربحاً

11
00:02:24,390 --> 00:02:26,710
لا بُدَّ أنّه شيطان الطماطم

12
00:02:27,040 --> 00:02:29,770
سيُبعَثُ من البذور، لذا يجب حرقها

13
00:02:30,150 --> 00:02:32,210
أحسنت صنعاً يا دينجي

14
00:02:32,210 --> 00:02:36,730
ستُحقّق هذه الجيفة سعراً مُمتازاً في السّوق السّوداء

15
00:02:36,730 --> 00:02:38,600
سأدفع لك 400،000

16
00:02:38,600 --> 00:02:39,500
!شكراً

17
00:02:39,500 --> 00:02:42,760
بطرح ديونك والفائدة، يبقى 170،000

18
00:02:42,760 --> 00:02:45,880
لذا بعد رسم السّمسرة والرّسم الإداري

19
00:02:45,880 --> 00:02:48,230
...وتكاليف الإدارة وما إلى هنالك

20
00:02:48,780 --> 00:02:50,730
بقي معي 70،000

21
00:02:51,160 --> 00:02:57,620
...بعد فاتورة المياه، وبعض الدّيون الأخرى عليّ

22
00:02:58,080 --> 00:02:59,490
كم هذا عجيب

23
00:02:59,850 --> 00:03:02,610
بقي معي 1،800 ين

24
00:03:03,070 --> 00:03:08,880
لا طعام لديّ في المنزل، ويجب أن نعيش
...على هذا المبلغ شهراً، لذا

25
00:03:08,880 --> 00:03:12,970
بوتشيتا، يبدو أنّ العشاء سيكون شريحة خبز

26
00:03:18,800 --> 00:03:22,430
لمَ تستأجر شقيّاً كهذا لصيد الشّياطين؟

27
00:03:22,860 --> 00:03:26,480
يُسدِّد ما هو مَدين لنا به

28
00:03:26,480 --> 00:03:30,310
مع أنّها كانت ديون والده المُتسكِّع من الأساس

29
00:03:30,630 --> 00:03:34,570
وهل يستطيع فتى يرافقُه شيطان حيوانيّ
أليف إنجاز العمل؟

30
00:03:34,950 --> 00:03:37,730
...المسألة تخصُّ صائدي الشّياطين الحقيقيّين

31
00:03:37,730 --> 00:03:42,080
لا يُسلِّمون جِيَفَ الشّياطين للياكوزا

32
00:03:42,430 --> 00:03:46,580
ناهيك عن أنّ أفضل شيء في دينجي
هو أنّه يفعل ما يُملَى عليه

33
00:03:49,760 --> 00:03:51,510
!أيُّها الكلب

34
00:03:52,210 --> 00:03:55,150
سأعطيك 100 ين لتأكل هذه السّيجارة

35
00:03:55,150 --> 00:03:56,340
هل أنت جادّ؟

36
00:03:56,340 --> 00:03:57,820
لا أمانع فعل ذلك

37
00:04:03,440 --> 00:04:05,660
سنتواصل عندما يكون هناك شيطان آخر

38
00:04:05,660 --> 00:04:08,190
إذا حاولتَ الهرب، ستصبح علَفاً للخنازير

39
00:04:22,510 --> 00:04:24,450
سيُعيلنا هذا لثلاثة أيّام أُخَر

40
00:04:27,210 --> 00:04:29,580
...قبل أيّام سمعتُ

41
00:04:29,580 --> 00:04:33,210
أنّ النّاس في العادة يدهنون خبزهم بالمربّى قبل أكله

42
00:04:33,510 --> 00:04:37,330
لكن هذه العادة حلمٌ بالنسبة لنا

43
00:04:37,770 --> 00:04:40,970
أشكُّ في أنّني سأسدِّد هذا الدَّين قبل موتي

44
00:04:44,580 --> 00:04:48,230
غالباً سأموت دون الحصول على حبيبة أيضاً

45
00:04:48,520 --> 00:04:51,790
أساساً لا يمكنني أن أدعو فتاةً إلى هذه المزبلة

46
00:04:51,790 --> 00:04:53,860
ولا مال للخروج في موعد أيضاً

47
00:04:58,090 --> 00:05:00,240
...إذا سنحَتْ لي فُرصة لتحقيق حلم

48
00:05:00,240 --> 00:05:02,930
أريد الحصول على فتاة قبل أن أموت

49
00:05:07,700 --> 00:05:11,960
الحقير شنقَ نفسه دون أن يسدّد
قسط هذا الشّهر أوّلاً

50
00:05:11,960 --> 00:05:15,760
يا فتى، لديك مهلة حتّى يوم غدّ لتجمع 700،000

51
00:05:15,760 --> 00:05:18,460
يمكنك أن تشحذه أو تذلّ نفسك للحصول
عليه... المهمّ أن تؤمّنه لي

52
00:05:18,960 --> 00:05:22,490
وإلّا سنُقطّعك ونبيع أشلاءك

53
00:05:36,490 --> 00:05:38,010
مـ-منشار...؟

54
00:05:42,320 --> 00:05:43,860
شيطان

55
00:05:45,200 --> 00:05:49,280
إن كنت ستقتلني، فاقتلني. أنا ميّتٌ في كلّ الأحوال

56
00:05:58,030 --> 00:05:59,380
هل يؤلمك؟

57
00:06:00,630 --> 00:06:02,760
ستموت أيضاً؟

58
00:06:07,880 --> 00:06:08,850
!عضّني

59
00:06:08,850 --> 00:06:12,480
سمعتُ بأنّ شرب الدّماء يُشفي الشّيطان

60
00:06:12,990 --> 00:06:14,840
!يمكنك عضِّي إذا كنت لا تريد الموت

61
00:06:20,920 --> 00:06:24,950
!لكن دمي ليس مجّانيّاً. هذا عقد بيننا

62
00:06:25,450 --> 00:06:27,200
...سأنقذك

63
00:06:27,830 --> 00:06:29,240
بالمقابل، ستنقذني

64
00:06:32,120 --> 00:06:35,450
لأنّني لا أريد أن أموت أيضاً

65
00:06:44,740 --> 00:06:48,910
ما رأيك أن تستأجرني كصائد شياطين؟

66
00:06:55,140 --> 00:06:57,350
الجوع الشّديد يؤرقني

67
00:06:57,660 --> 00:07:00,010
،عندما يصيبني الأرق، أبدأ بالتفكير في المال

68
00:07:00,010 --> 00:07:01,820
ممّا يزيد النّوم صعوبة

69
00:07:04,230 --> 00:07:07,490
أعرف الحلم الّذي أريد تحقيقه عندما أنام

70
00:07:07,900 --> 00:07:11,540
سوف أضع مربّى على خبزتي وأشاركها معك

71
00:07:11,540 --> 00:07:14,100
...ثمّ سأغازل فتاة

72
00:07:14,100 --> 00:07:17,750
سألعب معها ألعاب الفيديو ثمّ سننام
ونحن نُعانق بعضنا الآخر

73
00:07:18,990 --> 00:07:20,000
حلم جميل، صحيح؟

74
00:07:34,830 --> 00:07:40,150
سمعتُ أنّ أمّي تُوفّيت من مرض في القلب
حيث كانت تكحّ دماً

75
00:07:43,130 --> 00:07:46,850
لدينا شيطان يا دينجي. حان وقت العمل

76
00:07:51,500 --> 00:07:55,690
...ليتهم يدعونني أحلم على الأقلّ

77
00:08:04,180 --> 00:08:06,650
يوجد شيطان هنا، صحيح؟

78
00:08:09,440 --> 00:08:11,410
أتظنُّه يختبئ؟

79
00:08:15,700 --> 00:08:20,690
دينجي، يا بُنيّ... نحن مُمتنّون جدّاً لك

80
00:08:20,690 --> 00:08:22,680
نعم؟

81
00:08:22,680 --> 00:08:24,940
،أنت وفيٌّ كالكِلاب

82
00:08:24,940 --> 00:08:28,870
وتعمل بثمنٍ بخس ككلب أيضاً

83
00:08:30,720 --> 00:08:34,130
مُشكلتي الوحيدة مع الكِلاب هي
أنّني لا أتحمّل رائحتهم النّتنة

84
00:08:41,790 --> 00:08:47,930
حتّى الياكوزا يُفكِّرون في التوسُّع أكثر
وجَني المزيد من المال يا فتى

85
00:08:48,300 --> 00:08:52,540
لذا فعلنا مثلما فعلت، وأبرمنا عقداً مع شيطان

86
00:08:54,350 --> 00:08:58,230
...احتجنا قوّة شيطانيّة

87
00:08:58,550 --> 00:09:01,980
...وأريد صائدي الشّياطين

88
00:09:01,980 --> 00:09:03,480
!أن يموتوا

89
00:09:04,610 --> 00:09:09,460
يا صائد الشّياطين الصّغير، هؤلاء الأشخاص
حمقى بكُل ما تحمله الكلمة من معنى

90
00:09:09,460 --> 00:09:11,020
!مُغفَّلون حرفيّاً

91
00:09:11,020 --> 00:09:17,660
ما إن قدّمتُ لهم قليلاً من القوّة الشّيطانيّة
...حتّى عرَضوا عليّ أن يصبحوا عبيداً لي

92
00:09:17,660 --> 00:09:21,040
رغم أنّ القوّة تحوّلهم إلى زومبي

93
00:09:21,040 --> 00:09:23,670
كما ترى، لأنّني شيطان الزّومبي

94
00:09:24,790 --> 00:09:28,420
وأكره صائدي الشّياطين، لأنّهم يقتلوننا نحن الشّياطين

95
00:09:28,420 --> 00:09:30,970
لذا سوف أقتلك

96
00:09:31,340 --> 00:09:36,680
يا رجال، مزِّقوه وارموه في مكبِّ النّفايات

97
00:09:37,290 --> 00:09:38,390
!اللّعنة

98
00:09:48,780 --> 00:09:52,510
!كُلّ ما أريده هو حياة طبيعيّة

99
00:09:56,900 --> 00:09:59,740
!حتّى هذا لا يمكنني تحقيقه؟

100
00:10:18,740 --> 00:10:19,710
...بوتشيتا

101
00:10:20,160 --> 00:10:21,180
!بوتشيتا

102
00:10:22,310 --> 00:10:24,850
بوتشيتا، حان وقت العمل

103
00:10:34,480 --> 00:10:39,510
بوتشيتا، من المُحتمَل جدّاً أن أموت
بينما أقاتل شيطاناً

104
00:10:40,230 --> 00:10:43,260
ستكون حسرتي الوحيدة هي تركك بمُفردك

105
00:10:43,710 --> 00:10:46,580
...قد ينتهي المطاف بتضوّرك جوعاً

106
00:10:46,840 --> 00:10:50,340
أو قد يقتلك صائد شياطين آخر

107
00:10:55,060 --> 00:10:58,960
سمعتُ أنّ بعض الشّياطين يستطيعون
الاستحواذ على الجثث

108
00:11:00,110 --> 00:11:05,760
إذا كان هناك ما تستطيع فعله... فأريدك
أن تستحوذ على جسدي

109
00:11:06,780 --> 00:11:10,730
لن يُطاردك الياكوزا إذا انتظرت حتّى أُدفَن، صحيح؟

110
00:11:11,420 --> 00:11:15,680
...وحينئذ يمكنك الخروج من هنا... ثمّ

111
00:11:16,840 --> 00:11:17,740
أجل

112
00:11:18,350 --> 00:11:22,510
أريدك أن تعيش حياة طبيعيّة وتموت موتاً طبيعيّاً

113
00:11:26,660 --> 00:11:28,730
عليك أن تحقّق حلمي

114
00:11:53,120 --> 00:11:54,230
بوتشيتا؟

115
00:11:57,070 --> 00:11:59,990
هل استحوذت على جسدي كما قلت؟

116
00:12:02,160 --> 00:12:06,730
لطالما أحببتُ سماعك تتحدّث عن أحلامك يا دينجي

117
00:12:08,420 --> 00:12:12,380
...دعنا نتعاقد. سأعطيك قلبي

118
00:12:12,690 --> 00:12:17,130
وبالمقابل، أريدك أن تُريني حلمك

119
00:12:17,130 --> 00:12:18,270
!بوتشيتا؟

120
00:12:23,680 --> 00:12:24,870
أنا بخير؟

121
00:12:30,730 --> 00:12:32,150
بوتشيتا...؟

122
00:12:35,870 --> 00:12:37,400
ما هذا؟

123
00:12:37,840 --> 00:12:40,020
أنت حيّ رغم تقطيعك إرباً؟

124
00:12:40,020 --> 00:12:41,910
!لماذا؟ هذا مقرف

125
00:12:41,910 --> 00:12:44,910
أكره صائدي الشّياطين كرهاً شديداً

126
00:12:44,910 --> 00:12:48,330
يا رجال، اهجموا عليه وكُلوه

127
00:12:53,110 --> 00:12:58,220
،حصلَ هؤلاء على ما يكفي سلفاً
فلماذا يريدون المزيد؟

128
00:12:59,200 --> 00:13:00,590
هل أنا مثلهم؟

129
00:13:01,460 --> 00:13:04,350
لم أكن راضياً بالسّعادة الّتي قضيتُها مع بوتشيتا

130
00:13:04,940 --> 00:13:07,850
وظللتُ أحلم بحياة أفضل

131
00:13:08,560 --> 00:13:12,480
أعتقد جميعنا نحلم بأمور كهذه، صحيح؟

132
00:13:13,300 --> 00:13:16,010
لا أستطيع لومكم إذاً

133
00:13:16,380 --> 00:13:18,860
...ولن ألومكم، لكن

134
00:13:19,910 --> 00:13:22,570
...إذا اعترضتم طريقي

135
00:13:23,200 --> 00:13:24,510
!ستموتون

136
00:13:28,000 --> 00:13:30,830
سيموت على الأرجح بعد أن يُلتَهم

137
00:13:39,900 --> 00:13:41,910
!ما خطبك بالضبط؟

138
00:13:41,910 --> 00:13:45,470
!هل استحوذ ذلك القزم الشّيطان على جسدك؟

139
00:13:45,930 --> 00:13:47,470
!معنى هذا أنّك واحد منّا

140
00:14:03,660 --> 00:14:05,990
!ابتعد

141
00:14:08,250 --> 00:14:09,400
!ابتعد

142
00:14:09,900 --> 00:14:11,370
!تراجع! ابتعد

143
00:14:11,950 --> 00:14:13,580
!ابتعد! لا تفعلها

144
00:14:13,580 --> 00:14:15,760
!لا تقترب منّي

145
00:14:21,170 --> 00:14:23,260
!فلتمُت

146
00:14:50,250 --> 00:14:55,710
أظنّكم تحوّلتُم إلى شياطين حتّى النُّخاع

147
00:14:56,100 --> 00:14:59,470
استأجرتموني لأصبح صائد شياطين

148
00:14:59,470 --> 00:15:03,590
!لذا حريّ بي أن أقتل كلّ الشّياطين، صحيح؟

149
00:15:05,000 --> 00:15:06,010
!أجل

150
00:15:06,010 --> 00:15:08,970
...حالما تموتون جميعاً

151
00:15:08,970 --> 00:15:11,360
!فلن أكون مَديناً لأحد بشيء

152
00:15:21,430 --> 00:15:23,490
وصلَ أحدهم إلى هنا قبلنا

153
00:15:24,650 --> 00:15:26,490
ما زال هناك شخص واحد على قيد الحياة

154
00:15:38,030 --> 00:15:41,110
تفوح منك رائحة غريبة

155
00:15:41,850 --> 00:15:44,440
لا رائحة بشريّ ولا رائحة شيطان

156
00:15:47,260 --> 00:15:49,260
هل أنت من فعل هذا؟

157
00:15:52,360 --> 00:15:55,680
...عـ-عانقيني

158
00:16:10,150 --> 00:16:11,370
إنّه بشريّ

159
00:16:11,370 --> 00:16:13,910
هل هو ممسوس؟

160
00:16:13,910 --> 00:16:15,500
لا

161
00:16:15,500 --> 00:16:17,890
أستطيع تمييز الممسوس بنظرة واحدة إلى وجهه

162
00:16:20,340 --> 00:16:23,420
أتيتُ إلى هنا لقتل الشّيطان الزّومبي

163
00:16:23,420 --> 00:16:25,750
أنا صائدة شياطين من الأمن العامّ

164
00:16:28,480 --> 00:16:30,830
:أمامك خياران

165
00:16:31,220 --> 00:16:34,490
،يمكنني قتلك كشيطان

166
00:16:34,980 --> 00:16:37,650
أو الاحتفاظ بك كبشريّ

167
00:16:38,560 --> 00:16:41,600
إذا احتفظتُ بك، سأحرص على إطعامك

168
00:16:48,980 --> 00:16:50,600
...إطعامي

169
00:16:51,590 --> 00:16:53,620
ماذا ستُطعمينني على الفطور مثلاً؟

170
00:16:55,830 --> 00:17:01,040
...خبزة مع زبدة ومربّى وسلطة وقهوة

171
00:17:01,040 --> 00:17:05,130
ثمّ ربّما تحلية ما؟

172
00:17:09,030 --> 00:17:11,890
يبدو هذا رائعاً

173
00:17:22,430 --> 00:17:24,150
كان صوت قرقرة معِدتي

174
00:17:25,430 --> 00:17:27,650
ما اسمك؟

175
00:17:28,630 --> 00:17:29,670
!دينجي

176
00:17:30,030 --> 00:17:35,420
.لم نتناول الفطور بعد أيضاً
لنتناول شيئاً ما في الاستراحة

177
00:17:36,440 --> 00:17:39,410
آسف، لكن لا أملك مالاً

178
00:17:39,410 --> 00:17:43,050
اِختر ما تشاء فحسب. على حِسابي

179
00:17:44,420 --> 00:17:47,250
وأنت مُلفِت للأنظار بلا قميص، لذا ارتدِ هذا

180
00:17:48,240 --> 00:17:49,240
خُذ

181
00:17:54,120 --> 00:17:58,340
لطالما كان النّاس يتجنّبونني قائلين
بأنّني قذِر ورائحتي كريهة

182
00:17:58,340 --> 00:18:00,390
لم يُعاملني أحدٌ بلطف يوماً

183
00:18:00,770 --> 00:18:03,440
!ناهيك عن فتاة بهذا الجمال

184
00:18:06,020 --> 00:18:07,450
!أحبُّها

185
00:18:10,430 --> 00:18:12,030
...سأطلب أودون

186
00:18:12,030 --> 00:18:14,780
!أودون... وسجق

187
00:18:14,780 --> 00:18:15,830
هل هذا مناسب؟

188
00:18:15,830 --> 00:18:19,130
بالتأكيد. طلبي هو أودون بالكاري من فضلك

189
00:18:19,130 --> 00:18:20,160
في الحال

190
00:18:20,160 --> 00:18:23,580
...يبدو هذا لذيذاً أيضاً

191
00:18:23,580 --> 00:18:24,730
مهلك

192
00:18:25,720 --> 00:18:27,230
رائحتك عطِرة

193
00:18:27,230 --> 00:18:29,050
هل أنت بخير؟

194
00:18:29,670 --> 00:18:31,040
!آسف بشأن ذلك

195
00:18:29,670 --> 00:18:31,460
ثمنها كلّها 1،100 ين

196
00:18:31,460 --> 00:18:34,180
،جرحَني المنشار أيضاً

197
00:18:34,180 --> 00:18:36,050
هذه 2،000

198
00:18:34,550 --> 00:18:37,430
لذا أظنّني أعاني من نقص في الدّماء الآن

199
00:18:37,430 --> 00:18:40,310
كيف انتهى المطاف بك هكذا؟

200
00:18:40,620 --> 00:18:43,950
كان لديّ شيطان أليف، وقد حلَّ مكان قلبي

201
00:18:44,860 --> 00:18:46,690
تجِدين صعوبة في تصديق ذلك؟

202
00:18:46,690 --> 00:18:49,140
لا أريد تصديق ذلك أيضاً

203
00:18:49,140 --> 00:18:52,280
...موت بوتشيتا لأجلي

204
00:18:56,580 --> 00:18:59,420
،حالتُك نادِرة الحدوث

205
00:18:59,420 --> 00:19:01,450
حتّى من منظور تاريخيّ

206
00:19:02,090 --> 00:19:04,810
إنّها بلا اسم حتّى

207
00:19:06,640 --> 00:19:09,090
أصدّقك

208
00:19:10,280 --> 00:19:13,340
لديّ حاسّة شمّ حادّة

209
00:19:13,740 --> 00:19:15,220
لذا يمكنني أن أميّز

210
00:19:15,640 --> 00:19:18,800
صديقك العزيز حيّ داخلك

211
00:19:18,800 --> 00:19:21,280
ليس من النّاحية العاطفيّة أيضاً

212
00:19:21,280 --> 00:19:25,440
تفوح من جسدك رائحة إنسان وشيطان في نفس الوقت

213
00:19:26,160 --> 00:19:27,360
حقّاً؟

214
00:19:27,360 --> 00:19:28,520
!هذا مُذهل

215
00:19:28,520 --> 00:19:31,270
...مُذهل... حقّاً

216
00:19:38,450 --> 00:19:39,590
!أودون؟

217
00:19:41,310 --> 00:19:42,190
الأودون؟

218
00:19:48,570 --> 00:19:50,840
هل من المناسب أن آكل الأودون خاصّتي؟

219
00:19:52,220 --> 00:19:55,090
هل أنت بخير؟ هل يمكنك الأكل بمفردك؟

220
00:19:55,090 --> 00:19:56,200
...لا

221
00:19:57,700 --> 00:19:59,040
لا أستطيع

222
00:19:59,340 --> 00:20:01,460
"حسناً، قل "آه

223
00:20:04,380 --> 00:20:05,220
لذيذ؟

224
00:20:06,230 --> 00:20:11,480
أنت لطيف حقّاً لاستمتاعك الشّديد بأودون رطِب

225
00:20:11,480 --> 00:20:13,320
مثل كلب تماماً

226
00:20:16,650 --> 00:20:19,360
المعذرة... ما اسمكِ؟

227
00:20:20,660 --> 00:20:21,740
ماكيما

228
00:20:22,030 --> 00:20:26,760
ماكيما-سان... هل هناك نوع مُعيّن من الشّباب تُفضّلينه؟

229
00:20:33,430 --> 00:20:35,920
"أُفضِّل نوع "دينجي

230
00:20:36,740 --> 00:20:37,650
دينجي؟

231
00:20:41,030 --> 00:20:42,140
هذا أنا

232
00:20:46,810 --> 00:20:49,230
دينجي؟ من هنا، هيّا

233
00:20:51,230 --> 00:20:54,270
هذا مقرّ طوكيو الخاصّ بنا نحن صائدو الشّياطين

234
00:20:56,260 --> 00:21:01,500
هناك أكثر من ألف صائد شياطين
،في طوكيو، بمن في ذلك المدنيّين

235
00:21:01,500 --> 00:21:06,060
لكن تحظى مُنظّمة الأمن العامّ بأفضل المزايا
والكثير من الإجازات مدفوعة الأجر

236
00:21:09,220 --> 00:21:12,130
...إذا كانت ماكيما-سان تحبّني

237
00:21:12,400 --> 00:21:16,590
إذاً ربما إن عملنا معاً، قد نرتبط في الأخير؟

238
00:21:17,130 --> 00:21:21,410
إن ارتبطنا... يمكننا أن نرتبط، صحيح؟

239
00:21:21,880 --> 00:21:25,140
!أريد! أريد بشدّة فعل ذلك معها

240
00:21:27,990 --> 00:21:29,270
...دينجي

241
00:21:29,270 --> 00:21:30,520
نعم؟

242
00:21:31,140 --> 00:21:34,020
يُفترَض بنا أن نرتدي زيّاً رسميّاً، لذا ارتدِ هذا

243
00:21:34,440 --> 00:21:37,090
حالما تبدّل لباسك، سأعرّفك على زميل في العمل

244
00:21:44,320 --> 00:21:49,580
هذا آكي هاياكاوا. بدأ قبلك بثلاث سنوات يا دينجي

245
00:21:49,960 --> 00:21:52,380
ستعمل تحت جناحه اليوم

246
00:21:53,370 --> 00:21:56,450
لن أعمل معكِ يا ماكيما-سان؟

247
00:21:56,450 --> 00:21:58,090
ينبغي أن يكون هذا جليّاً

248
00:21:58,090 --> 00:22:00,910
فأنت بعيدٌ كلّ البُعد عن مُستواها

249
00:22:00,910 --> 00:22:02,060
حان وقت الدوريّة

250
00:22:02,060 --> 00:22:04,840
!لا! ماكيما-سان

251
00:22:05,660 --> 00:22:07,260
تبّاً، انهض

252
00:22:07,260 --> 00:22:10,750
!مُحال! أريد العمل مع ماكيما-سان

253
00:22:13,210 --> 00:22:17,710
إذا أبليتَ حسناً، فيمكننا العمل معاً ذات يوم

254
00:22:24,080 --> 00:22:26,450
لذا، اِفعل ذلك، اتّفقنا؟

255
00:22:30,480 --> 00:22:32,420
أيُّها الضّخم

256
00:22:32,420 --> 00:22:35,590
هل لدى ماكيما-سان حبيب؟

257
00:22:38,700 --> 00:22:39,980
هل تسمعني؟

258
00:22:41,800 --> 00:22:42,420
!أنت

259
00:22:43,380 --> 00:22:44,540
تعال معي

260
00:23:09,200 --> 00:23:10,790
عليك أن تعتزل هذا العمل

261
00:23:11,700 --> 00:23:14,070
إذا أتيتَ غداً، فسأوسعك ضرباً ثانية

262
00:23:14,830 --> 00:23:16,040
لكن لماذا؟

263
00:23:17,120 --> 00:23:19,710
اسمع، أحاول أن أكون لطيفاً هنا

264
00:23:20,300 --> 00:23:23,160
النّاس الّذين يبدؤون هذا العمل بلا تفكير
ينتهي المطاف بموتهم

265
00:23:23,160 --> 00:23:27,310
كان لديّ زُملاء مارسوا عمل صيد
،الشّياطين مُقابِل راتب

266
00:23:27,310 --> 00:23:29,720
وقُتِلوا جميعاً على يد الشّياطين

267
00:23:30,150 --> 00:23:34,390
النّاجون هم أصحاب الدّافع الحقيقيّ

268
00:23:35,450 --> 00:23:39,860
هدفُك ماكيما فحسب، صحيح؟ لهذا قبِلتَ بالعمل؟

269
00:23:39,860 --> 00:23:41,770
!أصبت

270
00:23:42,340 --> 00:23:44,630
إذاً يسرّني بأنّني ضربتُك

271
00:23:48,720 --> 00:23:54,210
سأخبرها بأنّك هربت خوفاً من الشّياطين

272
00:24:07,500 --> 00:24:10,610
أنت حقّاً رجل لطيف، صحيح؟

273
00:24:10,610 --> 00:24:14,720
...لأنّني... عندما أقاتل رجلاً

274
00:24:14,720 --> 00:24:17,890
...فإنّني لا أستهدف
!إلّا المنطقة الحسّاسة

275
00:24:25,110 --> 00:24:27,790
تناولتُ أودون لأوّل مرّة اليوم

276
00:24:28,420 --> 00:24:30,300
وسجق أيضاً

277
00:24:30,660 --> 00:24:33,130
تلقّيتُ مُعاملة كائن بشريّ طبيعيّ
،للمرّة الأولى في حياتي

278
00:24:33,130 --> 00:24:35,520
وحتّى أنّ شخصاً سدّد ثمن وجبتي

279
00:24:36,120 --> 00:24:39,040
وكأنّه حلم وتحقّق بالنسبة لي

280
00:24:39,530 --> 00:24:43,790
،لم أفكّر مليّاً عندما بدأتُ بمُمارسة صيد الشّياطين

281
00:24:44,080 --> 00:24:46,990
لكن إذا سنحَتْ لي فُرصة للاستمرار
في حياة من هذا النّوع؟

282
00:24:46,990 --> 00:24:48,830
لا أبالي ولو كلّفني ذلك الموت

283
00:24:50,350 --> 00:24:52,450
في الواقع، أسحب كلامي

284
00:24:53,130 --> 00:24:55,070
لم تعُد حياتي أنا بعد الآن

285
00:24:59,040 --> 00:25:01,020
...ماكيما

286
00:25:01,020 --> 00:25:05,660
ليست من النّساء اللّواتي ينبغي
!لرعاع مثلك أن يُلاحقها

287
00:25:05,660 --> 00:25:07,570
ما الّذي تقوله بالتّحديد؟

288
00:25:07,570 --> 00:25:11,210
!يبدو لي أنّك تحبّها أيضاً

289
00:25:15,480 --> 00:25:18,150
...أنت... فعلاً

290
00:25:19,160 --> 00:25:23,670
...لا تصوّب... إلّا على الخصيتين

291
00:25:28,380 --> 00:25:29,630
تبّاً

292
00:25:31,010 --> 00:25:35,130
هوجِمت خصيتا الضّخم من قبل
!شيطان الخصية يا سيّدتي

293
00:25:35,130 --> 00:25:38,020
هذا كذِب. إنّه يكذب

294
00:25:39,190 --> 00:25:41,820
إذاً هل تظنان أنّكما تستطيعان التّعاون معاً؟

295
00:25:42,470 --> 00:25:43,460
!أبداً

296
00:25:43,460 --> 00:25:45,150
!إنّه حُثالة

297
00:25:45,150 --> 00:25:47,690
يسرّني أنّكما مُنسجمان

298
00:25:48,330 --> 00:25:51,400
دينجي، ستلتحق بوحدة هاياكاوا

299
00:25:51,400 --> 00:25:52,520
وحدة؟

300
00:25:52,520 --> 00:25:54,660
!هذا الرّعاع؟

301
00:25:54,660 --> 00:25:57,900
لديّ ما يكفي من مُثيري الشّغب، أليس كذلك؟

302
00:25:57,900 --> 00:26:00,160
...إضافة آخر... لا أعلم

303
00:26:00,160 --> 00:26:02,790
أخبرتُك عندما أسّستُ الوحدة، صحيح؟

304
00:26:02,790 --> 00:26:06,670
فريقُك تجريبيّ ويعمل بشكل
مختلف عن الطريقة الاعتياديّة

305
00:26:09,520 --> 00:26:11,920
ما يكون بالضّبط يا سيّدتي؟

306
00:26:11,920 --> 00:26:16,090
دينجي بشريّ، لكن يستطيع التحوّل إلى شيطان

307
00:26:16,090 --> 00:26:18,100
أجل! مُمتاز، صحيح؟

308
00:26:18,100 --> 00:26:19,900
وهذه هي الحقيقة؟

309
00:26:19,900 --> 00:26:24,120
لطالما ظننتُ أنّ تلك الرّوايات إشاعات لا أساس لها

310
00:26:24,120 --> 00:26:26,560
دينجي مُميّز

311
00:26:27,050 --> 00:26:31,480
لهذا سوف يتلقّى مُعاملة خاصّة

312
00:26:31,820 --> 00:26:35,820
...إذا حاول الاستقالة، أو تمرّد

313
00:26:35,820 --> 00:26:38,950
فسيتمّ التخلّص من دينجي كشيطان

314
00:26:40,910 --> 00:26:43,830
ما معنى هذا؟

315
00:26:43,830 --> 00:26:47,080
هذا يعني بأنّنا سنعمل معاً حتّى تموت

316
00:26:50,620 --> 00:26:53,840
سوف تعيش معي وذلك كي أراقبك

317
00:26:54,620 --> 00:26:57,850
تذكّر فحسب، قالوا بأنّني أستطيع
قتلك إذا حاولت الهرب

318
00:27:03,630 --> 00:27:06,730
هل ماكيما-سان شخص سيّئ؟

319
00:27:07,130 --> 00:27:09,860
إذا كنتَ تعتقد ذلك، فكُفَّ عنها

320
00:27:10,190 --> 00:27:13,860
إذا كنتَ شيطاناً حقّاً، فيجدر بك أن
تكون مُمتنّاً لأنّها لم تقتلك

321
00:27:14,150 --> 00:27:16,490
نحن صائدو شياطين، مفهوم؟

322
00:27:16,860 --> 00:27:19,110
إذاً هي شخص جيّد؟

323
00:27:19,110 --> 00:27:20,940
هي كذلك بالطبع

324
00:27:21,830 --> 00:27:24,870
فقد أنقذَتْ حياتي

325
00:27:32,500 --> 00:27:34,090
...ماكيما-سان

326
00:27:34,540 --> 00:27:36,880
آمل أن أتمكّن من مُعانقتها ثانية

327
00:27:42,100 --> 00:27:46,100
...مربّى الفراولة، مربّى الخوخ، مربّى البُرتقال

328
00:27:46,100 --> 00:27:49,390
...ثمّ بعض الزبدة والعسل، بالإضافة

329
00:27:49,390 --> 00:27:51,610
سأرشّ بعض القرفة أيضاً

330
00:27:51,610 --> 00:27:54,860
!حصلتُ على أفضل خبز مُحمّص هنا

331
00:27:57,360 --> 00:27:58,990
!شهيّ

332
00:28:00,310 --> 00:28:02,240
!إنّه مُذهل للغاية

333
00:28:05,990 --> 00:28:07,250
!إلى متى ستبقى هناك؟

334
00:28:09,000 --> 00:28:10,420
!لا تنم على المرحاض

335
00:28:20,680 --> 00:28:23,180
تمّ الإبلاغ عن وجود شيطان بشريّ
في بناء كائن في نيريما الشرقيّة

336
00:28:23,920 --> 00:28:27,940
تمّ إخلاء المدنيّين وفرض طوق أمنيّ

337
00:28:28,430 --> 00:28:31,790
الشّيطان البشريّ المذكور مختبئ
في غرفة في الطّابق الثّاني

338
00:28:31,790 --> 00:28:33,920
سندع الأمر لكم أنتم صائدو الشّياطين

339
00:28:33,920 --> 00:28:36,570
هل هذا مُبتدئ جديد يا هاياكاوا؟

340
00:28:40,730 --> 00:28:42,830
ماذا يعني شيطان بشريّ؟

341
00:28:43,900 --> 00:28:46,530
ألم ترتد المدرسة أو ما شابه؟

342
00:28:46,530 --> 00:28:48,330
إطلاقاً

343
00:28:50,360 --> 00:28:53,980
عندما يستحوذ شيطانٌ على جثّة بشريّ
فإنّه يصبح شيطاناً بشريّاً

344
00:28:56,210 --> 00:28:58,900
لحظة، ألا يجعلني هذا شيطاناً بشريّاً؟

345
00:28:58,900 --> 00:29:02,720
لا. الشّياطين البشريّة لديهم دوماً رؤوس مُميّزة

346
00:29:02,720 --> 00:29:05,230
ينبغي أن يكونوا واضحين حالما نراهم

347
00:29:10,980 --> 00:29:15,360
يتحكّم الشّيطان بشخصيّة مَن استحوذَ
عليه. عليك بقتل هذا

348
00:29:15,750 --> 00:29:17,990
تحوّل إلى شيطان وأرِني ما يمكنك فعله

349
00:29:17,990 --> 00:29:20,700
سيُساعدني هذا في معرِفة ما إن كنتَ نافعاً

350
00:29:21,340 --> 00:29:22,740
...لا تنظرا إليّ

351
00:29:22,740 --> 00:29:25,580
!أنتما ميّتان! ميّتان! ميّتان

352
00:29:25,580 --> 00:29:27,660
!صائدا شياطين لعينان

353
00:29:35,450 --> 00:29:39,090
لماذا لم تستخدم قواك الشيطانيّة؟

354
00:29:39,090 --> 00:29:40,440
...في الواقع

355
00:29:41,000 --> 00:29:45,850
عندما أقتل الشّياطين بقوايّ، فإنّهم
يتشوّهون بشكل فظيع

356
00:29:45,850 --> 00:29:52,100
لأنّني... كان يمكن أن أتحوّل إلى شيطان بشريّ مثله، صحيح؟

357
00:29:52,410 --> 00:29:56,360
لذا أردتُ... أن أجعله موتاً بلا ألم بالنسبة له

358
00:29:57,480 --> 00:29:59,820
حسناً. اسمعني

359
00:29:59,820 --> 00:30:01,760
الشّياطين البشريّة هي كأيّ شيطان آخر

360
00:30:02,160 --> 00:30:04,620
إذا أردتَ اصطيادها، فعليك التجرّد من العواطف

361
00:30:05,130 --> 00:30:09,200
قُتِلِت كلّ عائلتي أمامي على يد شيطان

362
00:30:09,770 --> 00:30:12,730
لقد تناولتُ المشروب مع الشّرطة في الأسفل

363
00:30:12,730 --> 00:30:16,710
يُخاطرون بحياتهم لحماية زوجاتهم وأطفالهم

364
00:30:17,010 --> 00:30:19,410
الجميع جادّون حيال هذا فيما عداك

365
00:30:19,820 --> 00:30:23,720
أفضّل جعل أيّ شيطان أقتله
يتكبّد أكبر مُعاناة مُمكنة

366
00:30:23,720 --> 00:30:27,720
ماذا تحاول أن تفعل؟ تشكيل صداقة معهم؟

367
00:30:29,590 --> 00:30:32,230
إذا كان هناك شيطان أستطيع تشكيل
صداقة معه، فأجل، سأفعل

368
00:30:33,360 --> 00:30:35,290
لأنّني لا أملك أيّ صديق

369
00:30:39,550 --> 00:30:42,170
سأتذكّر ذلك

370
00:30:51,190 --> 00:30:53,250
...أظنّني استفززتُه

371
00:30:53,520 --> 00:30:57,340
كنتُ أحاول حماية هذه المجلّات القذِرة
من تطايُر الدّماء عليها

372
00:30:57,340 --> 00:31:01,130
عند تشغيل المنشار، تتطاير الدّماء
في كلّ مكان لتحدث جلبة حقيقيّة

373
00:31:01,470 --> 00:31:05,110
!أعفيتك الألم، لذا سأحتفظ بهذه في المقابل

374
00:31:10,300 --> 00:31:12,520
حسناً، تمّ تأمين الإباحيّات

375
00:31:12,890 --> 00:31:16,060
أريدك أن تُريني حلمك

376
00:31:16,060 --> 00:31:19,320
أنا جادّ تماماً حيال هذا يا بوتشيتا

377
00:31:19,580 --> 00:31:23,050
أنا أعيش الحلم بالفعل، كما اتّفقنا تماماً

378
00:31:23,600 --> 00:31:25,820
سأتذكّر ذلك

379
00:31:26,280 --> 00:31:31,710
لعلَّ حلمي قد تحقّق بالفعل، لكن
لا بُدّ أنّه يطارد حلمه

380
00:31:32,730 --> 00:31:36,290
...أتمكّن من الاستحمام يوميّاً، وآكل طعاماً لذيذاً

381
00:31:36,560 --> 00:31:39,210
...وأتسكّع مع فتاة مُثيرة

382
00:31:39,540 --> 00:31:44,230
حياتي مثاليّة، لكن أشعر بأنّ هناك ما هو ناقص

383
00:31:44,640 --> 00:31:48,220
هل ينقصني شيء؟ شيء ما
يمنحني العلامة الكاملة؟

384
00:31:48,220 --> 00:31:51,150
لا بدّ أنّه يسعى لانتقام ما

385
00:31:51,150 --> 00:31:53,470
يحاولون حماية عائلاتهم

386
00:31:54,510 --> 00:31:56,730
هل تسعى ماكيما-سان لشيء مُشابه؟

387
00:31:57,390 --> 00:31:58,980
...ماكيما-سان

388
00:32:00,070 --> 00:32:03,230
أريد لمس صدرها

389
00:32:08,170 --> 00:32:11,460
لمس الصّدر هو حلم يئستُ منه
،منذ مدّة طويلة

390
00:32:11,460 --> 00:32:15,140
.لكن حصلتُ على عمل حقيقيّ الآن
ربّما يمكنني أن أنجح؟

391
00:32:15,140 --> 00:32:18,070
غالباً لن أستطيع مُمارسة العلاقة مع فتاة بعد

392
00:32:18,700 --> 00:32:20,130
لكن الصّدر؟

393
00:32:21,120 --> 00:32:24,510
إذا رسمتُ الخطّة الصّحيحة وتحلّيتُ
...بقوّة الإرادة، فرُبّما

394
00:32:24,820 --> 00:32:27,220
الجميع جادّون حيال هذا فيما عداك

395
00:32:27,220 --> 00:32:29,700
!إذاً هذا ما قصده

396
00:32:29,700 --> 00:32:32,550
!وجدتُه! وجدتُ شيئاً يستحقّ الجدّية

397
00:32:32,550 --> 00:32:35,810
...هدفي! إنّه

398
00:32:36,090 --> 00:32:37,560
!الصّدر

399
00:32:37,910 --> 00:32:39,060
صدر؟

400
00:32:39,060 --> 00:32:41,500
!ركّز جيّداً أيُّها الأحمق

401
00:32:41,860 --> 00:32:42,770
أركّز على ماذا؟

402
00:32:42,770 --> 00:32:46,630
سأخصّص لك شريكاً ابتداء من اليوم يا دينجي

403
00:32:46,630 --> 00:32:47,830
شريك؟

404
00:32:47,830 --> 00:32:50,910
كإجراء احترازي، تنفّذ منظّمة الأمن العام دوريّات

405
00:32:50,910 --> 00:32:55,410
ومهاماً أصغر بفِرق مؤلّفة من شخصين

406
00:32:59,290 --> 00:33:02,540
كُن حذراً. إنّها شيطانة بشريّة

407
00:33:03,230 --> 00:33:06,460
!اسجدوا أمامي أيُّها البشر

408
00:33:06,460 --> 00:33:08,380
!فأنا باور

409
00:33:08,380 --> 00:33:10,410
!هل أنت شريكي المزعوم؟

410
00:33:11,360 --> 00:33:13,580
!باور! اسمكِ باور؟

411
00:33:13,580 --> 00:33:14,850
!وأنتِ شيطانة بشريّة؟

412
00:33:15,180 --> 00:33:18,110
هل يُسمَح للشياطين البشريّين بالعمل
!كصائدي شياطين؟

413
00:33:18,640 --> 00:33:21,400
!حسناً، أيّاً يكن! سررتُ بلقائكِ

414
00:33:27,110 --> 00:33:30,110
!أيّها البشر! وفّروا لي شيئاً للقتل فوراً

415
00:33:30,110 --> 00:33:32,360
!أنا مُتعطّشة للدماء

416
00:33:35,120 --> 00:33:38,790
يمكنني تحمّل الجنون ما دامت مُثيرة بما يكفي

417
00:33:40,030 --> 00:33:42,780
السّؤال هو كيف ألمس هذا الصّدر بيديّ؟

418
00:33:43,130 --> 00:33:46,380
،الشّياطين البشريّون هم، مثل الشّياطين
أهداف مُباحة للإبادة

419
00:33:46,380 --> 00:33:48,890
،لكن باور سليمة العقل

420
00:33:48,890 --> 00:33:51,330
لذا كانت في فريق هاياكاوا

421
00:33:53,640 --> 00:33:56,540
،قرنا باور بارزان زيادة عن اللّزوم

422
00:33:56,540 --> 00:33:59,850
لذا سيترتّب عليكما إجراء دوريّات
في مناطق عدد المُشاة فيها قليل

423
00:34:00,590 --> 00:34:03,350
،إذا صادفتُما أيّ صائدي شياطين مدنيّين

424
00:34:03,350 --> 00:34:06,610
...أو حاول رجال الشّرطة سؤالكما عمّا تفعلانه

425
00:34:04,180 --> 00:34:06,610
...يوجد هنا شخصان مشبوهان

426
00:34:05,070 --> 00:34:06,610
—المعذرة، اسمحا لي بالسّؤال

427
00:34:06,610 --> 00:34:09,860
نحن من فرع إبادة الشّياطين الخاص 4
التّابع للأمن العام

428
00:34:09,860 --> 00:34:11,820
،قُل ذلك وأرِهم هويّتك

429
00:34:11,820 --> 00:34:13,910
ستعبس وجوههم ثمّ يدعونكما وشأنكما

430
00:34:14,740 --> 00:34:16,460
،سبقَ وذكرتُ هذا

431
00:34:16,460 --> 00:34:20,180
لكن فرع الإبادة الخاصّ 4 التّابع
للأمن العام هو وحدة تجريبيّة

432
00:34:20,180 --> 00:34:23,570
سيعمل المسؤولون الكِبار على حلّ
فريقكم في أسرع وقت

433
00:34:23,570 --> 00:34:25,630
إذا لم تحقّقوا نتائجَ مُرضية

434
00:34:25,880 --> 00:34:29,830
ولستُ بحاجة لشرح ما سيحلّ بكما
إذا حدث ذلك، صحيح؟

435
00:34:30,350 --> 00:34:32,470
!أين الشّياطين بالضّبط؟

436
00:34:32,470 --> 00:34:35,390
!الذّنب ذنبي غالباً

437
00:34:35,390 --> 00:34:39,470
قبل أن أصبح شيطانة بشريّة، كنتُ
!شيطانة يهابها الجميع

438
00:34:39,990 --> 00:34:42,880
غالباً سيلوذ الشّياطين الضّعفاء بالفرار
!حالما يشتمّون رائحتي

439
00:34:42,880 --> 00:34:45,480
!لحظة، كيف سنُنجز شيئاً إذاً؟

440
00:34:46,880 --> 00:34:50,360
إذا كان لديك أيّ سؤال، فاطرحه على هاياكاوا

441
00:34:50,940 --> 00:34:53,110
هو من جمعكما معاً

442
00:34:53,470 --> 00:34:56,490
!ذلك الحقير! أوقعَني في الفخّ

443
00:34:56,830 --> 00:34:59,920
وضعَني مع باور وذلك كي لا أحقّق أيّ نتائج

444
00:34:59,920 --> 00:35:02,060
!يُحاول أن يتسبّب بطردي

445
00:35:05,220 --> 00:35:07,070
!رائحة دماء

446
00:35:08,540 --> 00:35:11,300
!مجنونة، إلى أين أنتِ ذاهبة؟

447
00:35:14,020 --> 00:35:16,180
!اللّعبة جارية

448
00:35:16,180 --> 00:35:17,970
!المعركة قائمة

449
00:35:17,970 --> 00:35:18,890
!تبّاً، إنّها سريعة

450
00:35:22,680 --> 00:35:25,270
نطلب المؤازرة أمام محطّة نيريما

451
00:35:25,540 --> 00:35:26,960
—قلتُ أنّه شيطان خيار البـ

452
00:35:26,960 --> 00:35:28,770
هل تعرف ما هو خيار البحر؟

453
00:35:28,980 --> 00:35:31,370
—اسمع، أحاول أن أقول

454
00:35:35,880 --> 00:35:37,360
ماذا...؟

455
00:35:37,620 --> 00:35:41,330
!هل رأيت؟ الصّيد من نصيبي

456
00:35:48,490 --> 00:35:52,960
إذا قتلَ صائدٌ من الأمن العامّ شيطاناً كان يُلاحقه
صائدٌ مدنيّ، فإنّه يُتَّهم بعرقلة عمله

457
00:35:53,230 --> 00:35:55,510
في العادة، يتمّ اعتقاله على هذا التصرّف

458
00:35:56,090 --> 00:36:00,590
باور، سيترتّب عليكِ التّفكير مليّاً قبل التحرّك

459
00:36:00,590 --> 00:36:03,480
وسيتوجّب عليكِ كبح جماحها يا دينجي

460
00:36:03,480 --> 00:36:05,350
حتّى أنا؟

461
00:36:05,350 --> 00:36:09,220
قبل أن تصبح شيطانة بشريّة، كانت
...باور شيطانة الدّماء

462
00:36:09,220 --> 00:36:12,370
،لذا لديها موهبة في استخدام الدّماء في المعارك

463
00:36:12,370 --> 00:36:14,470
لكنّها سُرعان ما تتحمّس أيضاً

464
00:36:14,920 --> 00:36:17,490
لعلّها غير مؤهّلة لتكون صائدة شياطين في نهاية المطاف

465
00:36:17,490 --> 00:36:18,490
...كـ

466
00:36:19,360 --> 00:36:22,340
!كـ-كان هو من أمرني بالقتل

467
00:36:23,520 --> 00:36:25,010
!لم أفعل

468
00:36:25,830 --> 00:36:28,750
!لم أفعل! كيف أمكنَكِ الكذب هكذا؟

469
00:36:28,750 --> 00:36:31,160
!أنا لا أكذب! كان هو

470
00:36:31,160 --> 00:36:34,950
!أمرني البشريّ بقتل هذا الشّيطان
!هذه هي الحقيقة

471
00:36:34,950 --> 00:36:36,510
!يا لكِ من مُخيفة

472
00:36:36,510 --> 00:36:39,510
!ماكيما-سان، هذه الشّيطانة كذّابة

473
00:36:40,030 --> 00:36:41,380
!عليكِ اعتقالها في الحال

474
00:36:41,380 --> 00:36:44,410
!أنتِ رهن الاعتقال لارتكابكِ جريمة الكذِب بشكل وقح

475
00:36:44,410 --> 00:36:46,770
!غير صحيح! كان ذلك بأمره

476
00:36:47,050 --> 00:36:50,650
!الشّياطين لا يكذبون! الكاذبون هم البشر فقط

477
00:36:50,650 --> 00:36:52,310
!ومن قال ذلك؟

478
00:36:52,310 --> 00:36:55,870
!وأنتِ هي السّبب! يا حمقاء! كاذبة لعينة

479
00:36:55,870 --> 00:36:58,140
!يا لأكاذيبكم الرّخيصة أيُّها البشر

480
00:36:58,140 --> 00:37:00,160
!فعلتُ فقط ما أُمليَ عليّ

481
00:37:00,500 --> 00:37:02,160
هلّا هدأتما؟

482
00:37:04,700 --> 00:37:06,800
حـ-حسناً

483
00:37:09,260 --> 00:37:11,290
ممتاز يا باور

484
00:37:11,750 --> 00:37:15,680
بصراحة، لا يهمّني مَن الّذي اعترض طريق الآخر

485
00:37:15,680 --> 00:37:18,550
أريد أن أراكما تتعاونان جيداً

486
00:37:19,200 --> 00:37:21,720
هل يمكنكما أن تُرياني ذلك؟

487
00:37:21,720 --> 00:37:24,620
أجل... يـ-يمكننا

488
00:37:26,860 --> 00:37:30,330
ربما الوقت غير مناسب حاليّاً للتفكير في لمس ثدي

489
00:37:44,140 --> 00:37:48,560
مجرّد القدرة على ارتشاف شراب
كهذا هو حلم وتحقّق

490
00:37:49,660 --> 00:37:51,750
،لكن إذا استمررنا في ارتكاب الأخطاء

491
00:37:52,220 --> 00:37:55,250
سيصبح العطش غالباً أقل مشاكلي

492
00:37:56,490 --> 00:38:00,220
لكن هذا لا يعني أنّه من السّهل
العمل مع فتاة كاذبة

493
00:38:01,440 --> 00:38:04,540
لا أستمتع إلّا في صُحبة القطط

494
00:38:05,630 --> 00:38:07,760
أكره البشر

495
00:38:07,760 --> 00:38:10,630
لم يفعلوا لي شيئاً بشكل شخصيّ

496
00:38:10,630 --> 00:38:13,310
كرهي نابع عن غريزة شيطانيّة فحسب

497
00:38:13,310 --> 00:38:15,890
وأكره الشّياطين أيضاً

498
00:38:15,890 --> 00:38:19,530
لأنّ أحدهم اختطفَ حيواني الأليف نياكو

499
00:38:20,900 --> 00:38:26,060
،قبل أن أتمكّن من استرجاع نياكو
وقعتُ في قبضة ماكيما

500
00:38:26,060 --> 00:38:30,210
...ربّما تكون نياكو قد ماتت الآن، ومع ذلك
لا يمكنني أن أفقد الأمل

501
00:38:30,800 --> 00:38:33,620
إذا كان ذلك يساعدني في استرجاع
،نياكو من قبضة ذلك الشّيطان

502
00:38:33,620 --> 00:38:36,230
فأنا مستعدّة لتقبُّل البشر أو تقبُّل
أيّ شيء آخر أحتاجه

503
00:38:36,790 --> 00:38:40,550
أشكّ في أنّك ستفهم مثل هذا القلق على قطّة

504
00:38:40,830 --> 00:38:44,220
على قطّة؟ هذا سخيف

505
00:38:44,620 --> 00:38:48,190
لكن أنا مستعدّ لفعل أيّ شيء من أجل
لمس بعض الأثداء

506
00:38:49,750 --> 00:38:52,830
يبدو أنّني لن أستطيع فهم البشر أبداً بالفعل

507
00:38:55,990 --> 00:38:58,820
لكن أظنّني كنتُ لأفهمكِ لو كانت كلباً

508
00:39:01,150 --> 00:39:04,010
ماذا ستكون إجابتك إذا قلتُ لك
بأنّك تستطيع لمس صدري

509
00:39:04,010 --> 00:39:06,110
بعد استعادة نياكو من ذلك الشّيطان؟

510
00:39:10,430 --> 00:39:12,080
...ذلك الشّيطان اللّعين

511
00:39:12,870 --> 00:39:16,120
كيف يجرؤ على اختطاف قطّة مسكينة؟

512
00:39:17,130 --> 00:39:19,710
!هذا لا يُغتفَر على الإطلاق

513
00:39:21,870 --> 00:39:23,800
!كصائد شياطين، هذا مرفوض تماماً

514
00:39:24,800 --> 00:39:28,860
!سأقتل ذلك الشّيطان اللّعين

515
00:39:30,630 --> 00:39:33,630
أمنح الإذن للشيطانة البشريّة باور بالخروج

516
00:39:35,150 --> 00:39:37,520
احرص على إعادتها على 5:00 مساء

517
00:39:37,990 --> 00:39:40,580
لا يُسمَح لكِ بالخروج بمفردكِ حتّى؟

518
00:39:40,580 --> 00:39:44,150
أجل. كان ينتابني الملل الشّديد
بينما أقضي وقتي هنا

519
00:39:49,130 --> 00:39:52,510
أعرف أين يقطن الشّيطان الّذي اختطفَ نياكو

520
00:39:52,510 --> 00:39:55,290
المشكلة هي أنّك الشخص الوحيد
الّذي يستطيع مُقاتلته

521
00:39:56,630 --> 00:40:01,380
غالباً سيستخدم نياكو كدرع عندما يراني

522
00:40:02,060 --> 00:40:04,330
إذا حدث ذلك، فسنكون في ورطة

523
00:40:07,180 --> 00:40:10,280
كان لديّ حيوان أليف يُدعى بوتشيتا

524
00:40:10,710 --> 00:40:14,330
لا أستطيع مُداعبته بعد الآن، لكن هذا مناسب

525
00:40:15,270 --> 00:40:17,490
لأنّه حيّ هنا في الدّاخل

526
00:40:17,830 --> 00:40:20,000
يا لحماقتكم أنتم البشر

527
00:40:20,810 --> 00:40:24,000
ألا يعني هذا أنّ بوتشيتا ميّت؟

528
00:40:24,000 --> 00:40:28,070
الموت هو غياب الحياة. هذا الكلام
الفارغ مثل العَيش داخل قلبك

529
00:40:28,340 --> 00:40:30,400
ما هو إلّا مُواساة ذاتيّة مُثيرة للشفقة

530
00:40:35,900 --> 00:40:38,870
أ-أجل. هذا ما أعتقده

531
00:40:40,490 --> 00:40:45,280
لا أظنّني سوف أنسجم معها أبداً

532
00:40:50,580 --> 00:40:55,810
الحادثة الأمريكيّة قد جعلت طائرات الصّقر
السّوفييتيّة تصدح أكثر من أيّ وقت سبق

533
00:40:55,810 --> 00:40:59,940
تواردت إشاعات عن استخدام الجيش للشياطين كذلك

534
00:40:59,940 --> 00:41:05,280
نأمل أن تبقى الشّياطين هي العدوّ
الوحيد لليابان في المستقبل

535
00:41:05,280 --> 00:41:07,500
ماكيما، كيف أداء كِلاب الصّيد

536
00:41:07,500 --> 00:41:09,700
الّذين أُضيفوا إلى الفرقة؟

537
00:41:09,700 --> 00:41:14,870
هناك كلب يبدو واعداً، وآخر مُثير للاهتمام

538
00:41:15,220 --> 00:41:16,700
مُثير للاهتمام...؟

539
00:41:16,700 --> 00:41:18,870
جرو عثرتُ عليه مؤخّراً فحسب

540
00:41:20,280 --> 00:41:24,730
عملكِ هو تربية كِلاب الصّيد تلك ثمّ توظيفها في العمل

541
00:41:24,730 --> 00:41:27,910
احرصي على ألّا تتعلّقي بها بشدّة

542
00:41:35,350 --> 00:41:38,470
"حسب علمي، دينجي مقرف، وليس "مُثيراً للاهتمام

543
00:41:39,230 --> 00:41:41,600
لماذا تعلّقين آمالاً كبيرة عليه؟

544
00:41:47,020 --> 00:41:50,820
تُولَد كلّ الشّياطين بأسماء

545
00:41:51,120 --> 00:41:54,160
،وكلّما كان الاسم مهيباً أكثر

546
00:41:54,160 --> 00:41:56,750
أصبح الشّيطان أقوى

547
00:41:57,330 --> 00:42:01,930
،فالقهوة لا تُعتبَر مُرعِبة جدّاً

548
00:42:01,930 --> 00:42:05,020
لذا لو كان هناك شيطان قهوة، لوجدته ضعيفاً غالباً

549
00:42:05,790 --> 00:42:09,270
لكن ماذا عن شيطان السيّارة؟

550
00:42:09,640 --> 00:42:13,970
،من السّهل أن تتخيّل بأنّك تُدهَس وتموت
لذا سيكون شيطان السيّارة قويّاً غالباً

551
00:42:15,580 --> 00:42:19,100
ويستطيع دينجي التحوّل إلى شيطان المنشار

552
00:42:20,820 --> 00:42:23,110
يبدو هذا مُثيراً جدّاً بالنسبة لي

553
00:42:26,770 --> 00:42:30,280
قد يكون مُثيراً للاهتمام، لكن لستُ
أدري ما إن كان سينفع

554
00:42:31,050 --> 00:42:35,230
الجميع في الأمن العام لديهم هدف حقيقيّ أو دافع

555
00:42:35,230 --> 00:42:39,540
لكن قال بأنّ كلّ ما يريده هو أن يعيش برخاء

556
00:42:40,000 --> 00:42:42,510
إنّه غير مؤهّل لعمليّاتنا

557
00:42:42,510 --> 00:42:46,030
ليس ذلك فحسب، لكن يعتقد بأنّه يستطيع
أن يصبح صديقاً للشّياطين أيضاً

558
00:42:46,980 --> 00:42:50,130
ما زال طفلاً. طفل شقيّ

559
00:42:50,510 --> 00:42:52,440
!ذلك هو المنزل

560
00:42:52,440 --> 00:42:54,890
نياكو والشّيطان هناك في الدّاخل

561
00:42:57,460 --> 00:42:59,370
حسناً، من الأفضل أن نذهب إذاً

562
00:43:05,080 --> 00:43:06,670
ما الأمر الآن؟

563
00:43:07,040 --> 00:43:10,720
ألن يستخدم القطّة كرهينة إذا رآكِ؟

564
00:43:11,210 --> 00:43:13,570
هل ينبغي لكِ أن تكوني بهذه المسافة القريبة؟

565
00:43:13,570 --> 00:43:17,070
أنا من قال ذلك، صحيح؟

566
00:43:17,070 --> 00:43:18,450
أنتِ من قلتِ...؟

567
00:43:18,450 --> 00:43:21,200
أخطأتُ القول

568
00:43:29,280 --> 00:43:33,730
بقدر ما أنت أحمق، يبدو أنّ غريزتك حادّة

569
00:43:37,090 --> 00:43:41,710
جعلتِني أنتظر طويلاً يا شيطانة الدّماء

570
00:43:41,710 --> 00:43:44,230
ظننتُكِ قد هربتِ

571
00:43:45,560 --> 00:43:49,680
كُفَّ عن الأنين! استغرقتُ كلّ هذا
الوقت لأتمكّن من الخروج

572
00:43:50,140 --> 00:43:53,640
!أحضرتُ بشريّاً كما طلبتَ تماماً أيُّها الخفّاش

573
00:43:54,950 --> 00:43:57,760
...وجبتي الأولى منذ زمن بعيد

574
00:43:57,760 --> 00:44:02,710
شابّ؟ أنا متأكّد بأنّ دمه سيكون مُفعماً بالحيويّة

575
00:44:08,440 --> 00:44:11,560
انظر إلى ذراعي أيّها البشريّ

576
00:44:11,560 --> 00:44:14,550
الجرح الّذي سبّبَه لي بَني جلدتك

577
00:44:14,550 --> 00:44:20,010
!الجرح اللّعين الّذي أجبرَني على الاختفاء

578
00:44:20,780 --> 00:44:22,680
وكأنّني أكترث أيُّها الأحمق

579
00:44:22,680 --> 00:44:24,830
!لا ينبغي للطعام أن يتكلّم

580
00:44:24,830 --> 00:44:30,740
حان وقت شفاء الجروح الّتي سبّبها
!لي البشر بدماء بشريّ

581
00:44:36,900 --> 00:44:38,150
!هذا مُقرف

582
00:44:39,400 --> 00:44:45,210
!تعافيتُ بدماء كريه المذاق

583
00:44:49,170 --> 00:44:52,060
...أشعر بطَعم مقرف داخل فمي

584
00:44:52,060 --> 00:44:55,670
!سأعدّل هذا المذاق ببشريّ آخر الآن

585
00:45:02,800 --> 00:45:05,810
ماذا تحاول أن تفعل؟ تشكيل صداقة معهم؟

586
00:45:08,600 --> 00:45:12,610
أنا مندهشة من تصديقك روايتي

587
00:45:14,730 --> 00:45:17,710
البشر حمقى فعلاً

588
00:45:19,190 --> 00:45:21,360
...رائحة السّجائر الكريهة

589
00:45:21,640 --> 00:45:24,620
...رائحة مُستحضرات التجميل والعقاقير

590
00:45:24,620 --> 00:45:25,460
هل أنتِ جادّة؟

591
00:45:25,460 --> 00:45:26,570
!رائع

592
00:45:27,670 --> 00:45:30,370
هناك رائحة عطِرة

593
00:45:30,730 --> 00:45:33,840
سأعدّل المذاق بطفل ما

594
00:45:33,840 --> 00:45:35,250
!شيطان الخفّاش

595
00:45:36,790 --> 00:45:39,470
!أحضرتُ لك بشريّاً كما وعدت

596
00:45:39,760 --> 00:45:41,720
حرّر نياكو

597
00:45:44,330 --> 00:45:48,480
قلتُ بأنّني سأفعل ذلك، صحيح؟

598
00:45:52,100 --> 00:45:53,230
!نياكو

599
00:45:53,230 --> 00:45:58,610
لكن لم أعاقبكِ على إحضار دماء
بغيض كهذا لي بعد، أليس كذلك؟

600
00:46:03,050 --> 00:46:04,200
نياكو...؟

601
00:46:04,640 --> 00:46:05,950
!نياكو

602
00:46:05,950 --> 00:46:08,140
!سيكون اسمكِ نياكو

603
00:46:08,140 --> 00:46:11,200
رائحتكِ طيّبة رغم كونكِ قطّة

604
00:46:15,210 --> 00:46:17,980
لكن نحيلة للغاية

605
00:46:18,910 --> 00:46:22,060
هيّا نكسو هذه العِظام ببعض اللّحم قبل أكلك

606
00:46:28,710 --> 00:46:30,760
اِكبري وكوني قويّة بسرعة

607
00:46:31,100 --> 00:46:34,450
لا أطيق انتظار قتلكِ يا نياكو

608
00:46:42,790 --> 00:46:46,620
قتلتُ كلّ من رأته عينايّ

609
00:46:47,820 --> 00:46:51,990
أصبح من الغريب سماع صوت لا يصرخ

610
00:46:53,320 --> 00:46:54,980
...غريب جدّاً

611
00:46:58,860 --> 00:47:01,210
...شيطانة الدّماء

612
00:47:01,710 --> 00:47:04,090
أريد دماً

613
00:47:04,580 --> 00:47:10,730
إذا أردتِ إنقاذ هذه القطّة، فأحضري لي بشريّاً

614
00:47:23,720 --> 00:47:26,790
قلتَ بأنّك لم تعد قادراً على مُداعبة
بوتشيتا، أليس كذلك؟

615
00:47:28,140 --> 00:47:30,450
أفهم شعورك الآن

616
00:47:31,340 --> 00:47:33,150
لأنّه شعور فظيع

617
00:47:40,140 --> 00:47:41,710
!مُقرف

618
00:47:41,710 --> 00:47:44,110
!لا شيء سوى دماء مُثير للاشمئزاز هنا

619
00:47:47,890 --> 00:47:50,640
!أشعر بقذارة داخل فمي

620
00:47:50,990 --> 00:47:53,890
!عليّ أن أُغرغر بدم الأطفال

621
00:47:58,650 --> 00:48:03,150
وبعد أن أُغرغر، ينبغي أن تَفي عذراءٌ
بالغرض كنوع من المُقبّلات

622
00:48:03,150 --> 00:48:06,470
...ثمّ رجُل مليء كوجبة رئيسيّة

623
00:48:06,470 --> 00:48:09,350
وامرأة حامل كتحلية

624
00:48:12,640 --> 00:48:15,460
!أعِد إليّ الأثداء خاصّتي

625
00:48:15,460 --> 00:48:19,330
!!أتشرب دمي؟! هذا مُقرف

626
00:48:19,330 --> 00:48:23,000
!لا أشعر حتّى برغبة في شرب دمك

627
00:48:24,980 --> 00:48:27,290
ذات مرّة لم أعُد أرى بوتشيتا

628
00:48:28,120 --> 00:48:30,510
...اختفى عندما استيقظتُ في الصّباح

629
00:48:31,110 --> 00:48:33,420
لذا بحثتُ في كلّ مكان، لكن لم أجده

630
00:48:34,720 --> 00:48:37,390
،خلتُ أنّ شيطاناً قد اِلتهمَه

631
00:48:38,720 --> 00:48:43,150
لكن عندما عدتُ للمنزل، كان يبكي وهو ينتظرني

632
00:48:43,850 --> 00:48:46,790
،أتذكّر الطمأنينة الّتي شعرتُ بها
ثمّ نمتُ وأنا أحضنه

633
00:48:48,140 --> 00:48:54,120
أتساءل كيف كان شعورها عندما حاولت النّوم
وهي تعلم بأنّ نياكو في قبضة هذا الشّيطان

634
00:49:05,000 --> 00:49:07,950
!أنت شيطان؟

635
00:49:14,040 --> 00:49:16,590
!أيّتها الحمقاء! أتريدين أن تُؤكَلي؟

636
00:49:19,190 --> 00:49:21,770
تركتَها تهرب؟

637
00:49:22,180 --> 00:49:26,030
!أنت شيطان! ماذا تظنُّ أنّك تفعل؟

638
00:49:27,620 --> 00:49:29,740
...أظنّني سأنتزع أحشاءك

639
00:49:29,740 --> 00:49:32,740
!ثمّ أتلمّس

640
00:50:06,170 --> 00:50:09,280
...إن كنتَ عازماً على إنقاذ البشر

641
00:50:11,900 --> 00:50:14,200
!فهل يمكنك قطع هذه؟

642
00:50:17,910 --> 00:50:19,700
!اِنكفأ المِنشاران؟

643
00:50:19,700 --> 00:50:22,140
!مثل هذه القوّة الشّرِسة في هذا الجسد الضّئيل

644
00:50:22,140 --> 00:50:25,280
!لماذا تستخدم هذه القوّة لإنقاذ بشريّ؟

645
00:50:27,080 --> 00:50:29,460
أتظنّني أنقذتُه؟

646
00:50:30,750 --> 00:50:34,340
...لا أبالي البتّة

647
00:50:34,340 --> 00:50:36,010
!بشأن إنقاذ شخص لا أعرفه

648
00:51:06,220 --> 00:51:08,240
يجب أن أعالج نفسي الآن

649
00:51:08,240 --> 00:51:11,340
،تفوح من دمك رائحة السّجائر
لكن سأتدبّر أمري بهذا حاليّاً

650
00:51:14,340 --> 00:51:17,640
!كيف لا تزال على قيد الحياة؟

651
00:51:19,350 --> 00:51:22,990
...وسط كلّ هذا الهُراء

652
00:51:24,300 --> 00:51:26,900
تحلّيتُ بالصّبر بأكبر قدر مُمكن

653
00:51:28,400 --> 00:51:31,540
...فكيف لي ألّا أتمكّن من الحصول

654
00:51:31,540 --> 00:51:37,200
!على أيّ لمسة مُثيرة بعد؟

655
00:51:41,420 --> 00:51:44,410
!ا-ابتعد

656
00:52:35,510 --> 00:52:41,510
إذا أردتِ إنقاذ هذه القطّة، فأحضري لي بشريّاً

657
00:52:45,860 --> 00:52:48,140
حياة كلّ الكائنات بلا قيمة

658
00:52:48,790 --> 00:52:50,390
وهذه ليست إلّا قطّة

659
00:52:51,150 --> 00:52:54,650
فلماذا أركض؟ لماذا أبحث عن بشريّ؟

660
00:52:58,080 --> 00:53:00,030
لإنقاذ نياكو؟

661
00:53:04,450 --> 00:53:06,750
يا له من سبب سخيف

662
00:53:11,120 --> 00:53:12,800
أعشق الدّماء

663
00:53:13,240 --> 00:53:17,130
...المذاق، الرّائحة، والشّعور بالفَناء

664
00:53:18,270 --> 00:53:22,780
وأيضاً... ثمّة أمر لم أدركه إلّا مؤخّراً

665
00:53:24,030 --> 00:53:25,970
...الدّماء دافئة

666
00:53:27,100 --> 00:53:28,980
وتُشعِر بالرّاحة

667
00:53:41,640 --> 00:53:43,890
لماذا أنقذتني؟

668
00:53:44,780 --> 00:53:47,120
حاولتُ قتلك

669
00:53:59,040 --> 00:54:01,350
يا له من سبب سخيف

670
00:54:09,000 --> 00:54:11,050
سامحني على خداعك

671
00:54:11,480 --> 00:54:13,980
...بما أنّ نياكو بخير

672
00:54:14,580 --> 00:54:16,560
يمكنك أن تلمس صدري

673
00:54:25,450 --> 00:54:31,000
!أجل

674
00:54:33,500 --> 00:54:37,250
!اللّعنة! هذا مؤلم

675
00:54:38,170 --> 00:54:39,510
!مؤلم

676
00:54:58,110 --> 00:54:59,340
هل يمكنكِ الحركة؟

677
00:54:59,900 --> 00:55:01,740
ولا حتّى أتزحزح عن مكاني

678
00:55:02,140 --> 00:55:04,240
خُذ نياكو واهرب، أرجوك

679
00:55:13,330 --> 00:55:15,960
...اللّعنة، المنشار لا يخرج كفاية

680
00:55:17,660 --> 00:55:19,490
لا بد أنه تنقصني دماء

681
00:55:22,830 --> 00:55:25,720
...وبعد أن وجدتُه أخيراً

682
00:55:26,260 --> 00:55:29,890
إنّه أنت، صحيح؟ من قتلَ خفّاشي

683
00:55:29,890 --> 00:55:32,520
كان حبيبي

684
00:55:34,020 --> 00:55:38,330
لكنّك ظريف جدّاً أيضاً

685
00:55:38,770 --> 00:55:42,400
!أنت نوعي المُفضّل، لذا سأدعك وشأنك

686
00:55:43,390 --> 00:55:44,900
ماذا عنهما؟

687
00:55:48,010 --> 00:55:49,530
سيموتان

688
00:55:54,800 --> 00:55:57,130
يمكنك أن تموت أيضاً إذاً

689
00:56:29,450 --> 00:56:31,900
...يستطيع القتال بهذه الشّراسة

690
00:56:32,720 --> 00:56:34,700
كي يلمس صدراً فقط؟

691
00:56:48,540 --> 00:56:50,260
هل هذه مزحة؟

692
00:56:50,260 --> 00:56:54,270
كيف لجرو مثلك أن يقتل خفّاشي؟

693
00:56:56,770 --> 00:57:02,020
كان بيننا حلم مُشترك: قتل وأكل البشريّة جمعاء

694
00:57:02,440 --> 00:57:05,780
حلم بعيد المنال، لكنّه نبيل ومليء بالمشاعر

695
00:57:05,780 --> 00:57:09,550
فيأتي هذا الكلب الصّغير النبّاح ويُفسده

696
00:57:09,550 --> 00:57:12,410
...أنت ظريف لدرجة تجعلني أتحسّر

697
00:57:13,120 --> 00:57:14,790
لكن هذا لا يعني أنّه لا يجب أن تموت

698
00:57:16,700 --> 00:57:19,040
لن أموت قبل أن ألمس ثدياً

699
00:57:19,040 --> 00:57:20,840
!هذا سخيف

700
00:57:20,840 --> 00:57:24,480
لا أصدّق بأنّه قُتِل على يد شخص
لديه مثل هذا الحلم التّافه

701
00:57:24,480 --> 00:57:27,300
...أسفي عليك يا خفّاشي

702
00:57:28,550 --> 00:57:30,590
يا له من سبب سخيف

703
00:57:31,840 --> 00:57:33,760
الجميع جادّون حيال هذا فيما عداك

704
00:57:54,640 --> 00:57:59,330
...الجميع يستخفّون بقيمة مخطّطاتي

705
00:57:59,330 --> 00:58:00,660
،انتقام من هنا

706
00:58:00,660 --> 00:58:02,330
،وحماية عائلة من هنا

707
00:58:02,330 --> 00:58:03,830
!وإنقاذ قطّة أيضاً

708
00:58:03,830 --> 00:58:05,820
!ثرثرة لا تنتهي

709
00:58:05,820 --> 00:58:08,840
!أعتقد أن أحلامكم الفاخرة تجعل منكم جذابين

710
00:58:08,840 --> 00:58:11,710
ما رأيكِ بخوض معركة أحلام إذاً؟! ما رأيكِ بذلك؟

711
00:58:11,710 --> 00:58:14,600
،إذا قتلتُكِ

712
00:58:14,600 --> 00:58:18,220
!فهذا يعني أنّ حلمكِ أضعف من لمس ثدي

713
00:58:18,220 --> 00:58:20,080
!حتّى عواءك ظريف

714
00:58:20,080 --> 00:58:22,460
!لكن الكِلاب لا تعرف إلّا النُّباح

715
00:58:22,460 --> 00:58:25,730
!حسناً! سوف ألتهِمُك إذاً

716
00:58:26,690 --> 00:58:27,860
...أريني

717
00:58:27,860 --> 00:58:32,380
!ما إن كنتِ تستطيعين هزيمتي في معركة أحلام

718
00:59:04,430 --> 00:59:05,900
...شيطانيّ

719
00:59:43,730 --> 00:59:46,980
...حان وقت الأكل

720
00:59:52,810 --> 00:59:53,750
كون

721
00:59:59,620 --> 01:00:02,160
ما... ماذا؟

722
01:00:02,160 --> 01:00:06,670
يبدو أنّها شيطانة العلَقة. هل يمكنني ابتلاعها؟

723
01:00:06,670 --> 01:00:07,840
أجل

724
01:00:23,190 --> 01:00:25,430
تمّ تأكيد إبادة شيطانة العلَقة

725
01:00:25,770 --> 01:00:28,640
،أريد من المبتدئين أن يتولّوا عمليّات البحث والإنقاذ
بالإضافة إلى المُساهمة في الإخلاء

726
01:00:28,640 --> 01:00:29,770
!حاضر

727
01:00:28,640 --> 01:00:29,770
!حاضرة

728
01:00:29,770 --> 01:00:33,300
هيمينو، أنتِ أقدم، لذا احذري من وجود شياطين أخرى

729
01:00:33,300 --> 01:00:34,330
عُلِم

730
01:00:35,400 --> 01:00:39,530
...معركة أحلام... سوف... معركة حلمي

731
01:00:39,530 --> 01:00:42,450
أنت وشيطانة الدّماء البشريّة يجب
!أن تخضعا لاستجواب

732
01:00:43,790 --> 01:00:45,340
ونياكو؟

733
01:00:49,290 --> 01:00:52,540
أرسلوا القطّة إلى بيطريّ لإجراء فحص شامل

734
01:01:06,110 --> 01:01:09,670
وجدتُ ذِراعك

735
01:01:10,600 --> 01:01:12,770
كانت عملية نقل دماء كلّ ما تطلّبه
الأمر لتلتحِم من جديد

736
01:01:13,460 --> 01:01:15,710
أنت حقّاً أشبه بشيطان

737
01:01:17,000 --> 01:01:20,030
بدوتَ ودوداً جدّاً مع ذلك الشّيطان

738
01:01:20,030 --> 01:01:21,990
رأيتُكما

739
01:01:23,780 --> 01:01:26,160
أنت حقّاً لا تفقه شيئاً

740
01:01:26,160 --> 01:01:30,360
ينشئ صائدو الشّياطين عقوداً مع الشّياطين
وذلك كي يقاتلوا شياطينَ آخرين

741
01:01:31,810 --> 01:01:34,490
لديّ عقد مع شيطان الثّعلب

742
01:01:34,490 --> 01:01:39,190
لأحصل على القوّة، أقدّم قليلاً من جسدي كطعام

743
01:01:39,680 --> 01:01:41,590
كان بعض الجلد هذه المرّة

744
01:01:43,100 --> 01:01:44,390
يبدو هذا مُؤلماً

745
01:01:45,310 --> 01:01:47,930
يتمنّى الشّياطينُ موتَ البشر

746
01:01:48,490 --> 01:01:50,640
ذات الأمر ينطبق على الشّياطين البشر

747
01:01:52,070 --> 01:01:54,270
لكن تبدو باور رائعة

748
01:01:56,890 --> 01:02:01,660
رصدتكما كاميرات المُراقبة وأنتما تتوجّهان
إلى منطقة الدوريّة الخاصّة بكما

749
01:02:02,020 --> 01:02:06,940
والبيت الّذي نعتقد بأنّه كان يأوي شيطان الخفّاش

750
01:02:06,940 --> 01:02:09,100
عُثِر فيه على كثير من دمك المُراق

751
01:02:09,780 --> 01:02:13,460
حاولت شيطانة الدّماء البشريّة قتلك، أليس كذلك؟

752
01:02:13,930 --> 01:02:18,710
لا أعرف السّبب، لكنّك تحاول حماية شيطان من جديد

753
01:02:19,200 --> 01:02:22,450
لا أدري... أهكذا حدث الأمر؟

754
01:02:25,480 --> 01:02:29,250
ترغب ابنتي في مقابلة رجل المنشار

755
01:02:29,250 --> 01:02:30,640
شكراً لك

756
01:02:31,220 --> 01:02:35,160
،بالتفكير في الأمر، عندما هدّد الشّيطانُ بأكلي

757
01:02:35,160 --> 01:02:37,730
كان هو موجوداً ويرتدي الزيّ الخاص بالأمن العام

758
01:02:37,730 --> 01:02:39,390
أودّ أن أشكره

759
01:02:39,980 --> 01:02:42,300
!"قال "لا أبالي بشأن إنقاذ شخص لا أعرفه

760
01:02:42,300 --> 01:02:44,500
!ثمّ رمى الشّيطان سيّارتي وأنا بداخلها

761
01:02:44,500 --> 01:02:46,840
...كان شيطاناً بمنشار منبثق من رأسه

762
01:02:50,260 --> 01:02:53,680
إذا تحرّيتُ أكثر حول هذا الأمر
،وأبلغتُ عنه للمسؤولين

763
01:02:53,680 --> 01:02:57,270
فقد تصدر أوامر بالتخلّص منك ومن شيطانة
الدّماء البشريّة، بما أنّك تستّرتَ عليها

764
01:02:57,920 --> 01:02:59,880
لكن لم يسقط ضحايا

765
01:02:59,880 --> 01:03:04,380
لذا إذا قبلتَ بشَرطي، سأتغاضى عن الأمر

766
01:03:08,630 --> 01:03:11,390
يجب أن تفعل ما أمليه عليك

767
01:03:11,860 --> 01:03:14,650
أنت أحمق وطفل شقيّ لا يميّز بين الصّواب والخطأ

768
01:03:14,650 --> 01:03:19,050
أنا أقدم منك في هذا العمل، لذا لديّ بعض
المعرفة بالأخلاقيّات الاجتماعيّة

769
01:03:19,400 --> 01:03:23,900
كلّ ما عليك فعله لحماية أسلوب
الحياة هذا هو الإصغاء إليّ

770
01:03:26,750 --> 01:03:29,410
ما رأيك؟ إن فهمتَني، أجبني

771
01:03:31,910 --> 01:03:34,920
بالتأكيد. سأضع ذلك بعين الاعتبار

772
01:03:36,410 --> 01:03:38,420
يمكنك أن تسترخي

773
01:03:38,420 --> 01:03:41,840
،قد لا يكون هدفي كبيراً كأهدافكم

774
01:03:41,840 --> 01:03:44,540
وقد يبدو حلمي سخيفاً

775
01:03:45,130 --> 01:03:49,180
لكنّني جادّ حيال هذا الحلم بقدر جدّيتكم أنتم الأوغاد

776
01:03:49,700 --> 01:03:52,130
يمكنك الاعتماد عليّ

777
01:03:56,140 --> 01:03:58,690
حاول أن تتحلّى بالأدب في الوقت الراهن

778
01:03:58,690 --> 01:04:02,170
حسناً، سأفكّر في الأمر

779
01:04:08,460 --> 01:04:11,090
رأيت؟ ألستُ بريئة؟

780
01:04:13,840 --> 01:04:16,920
والآن هلّا تتفضّل بفكّ هذه؟

781
01:04:16,920 --> 01:04:19,590
هل أنت متأكّد من هذا؟

782
01:04:19,590 --> 01:04:22,810
عندما تقتل هذه الشّيطانة البشريّة
،الظّريفة شخصاً ما

783
01:04:22,810 --> 01:04:25,670
ستتحمّل المسؤوليّة لأنّك تركتها على قيد الحياة

784
01:04:25,670 --> 01:04:28,220
نحن صائدو شياطين

785
01:04:28,220 --> 01:04:30,020
،سواء كانوا شياطين أو شياطين بشريّة

786
01:04:30,020 --> 01:04:32,480
ينبغي أن نسخّرهم للعمل إن كانوا نافعين

787
01:04:32,930 --> 01:04:36,650
لكن هذا لا يمنع بأنّهم أعداء. نحن نستغلّهم فحسب

788
01:04:37,380 --> 01:04:39,610
لا نشكّل صداقة معهم

789
01:04:42,940 --> 01:04:45,870
!يا له من منزل بائس

790
01:04:49,200 --> 01:04:53,480
أرغب في وضع باور في إحدى غرفك يا هاياكاوا

791
01:04:53,830 --> 01:04:58,830
أظنّك ستكون لِجاماً جيّداً لكِليهما

792
01:04:58,830 --> 01:05:02,340
هل من سبب يدفعكِ لإرسال هؤلاء
المجانين إليّ يا سيّدتي؟

793
01:04:59,510 --> 01:05:02,340
!توقّفي مكانكِ يا نياكو

794
01:05:02,340 --> 01:05:06,840
لأنّني أثق بك أكثر من أيّ شخص آخر

795
01:05:03,230 --> 01:05:04,870
!يبدو أنّ لديك طعام لذيذ

796
01:05:04,870 --> 01:05:06,840
!اللّعنة، من سمح لك بالدّخول؟

797
01:05:06,840 --> 01:05:08,030
!هذه لي الآن

798
01:05:08,030 --> 01:05:10,090
!أعيدي إليّ شطيرتي

799
01:05:10,620 --> 01:05:12,850
حاضر

800
01:05:13,110 --> 01:05:16,230
سيكون من الغريب قليلاً تركها تُقيم
في المكتب إلى الأبد

801
01:05:19,850 --> 01:05:20,950
حسناً

802
01:05:21,990 --> 01:05:27,110
لا داعي للقلق. قالت باور بأنّها ستكون مُهذّبة

803
01:05:27,400 --> 01:05:28,840
ستكون الأمور بخير

804
01:05:31,110 --> 01:05:32,780
!الخضراوات مُقزِّزة

805
01:05:32,780 --> 01:05:33,580
!ابتعدي

806
01:05:33,580 --> 01:05:34,790
!جزر

807
01:05:34,790 --> 01:05:36,390
!لا ترمي خضراواتكِ

808
01:05:36,390 --> 01:05:37,470
...تبّاً

809
01:05:37,470 --> 01:05:41,780
!احترمي الفلّاحين الّذين زرعوا الخضراوات يا شيطانة

810
01:05:42,380 --> 01:05:44,590
نادراً ما أستحمّ

811
01:05:44,590 --> 01:05:45,420
!ادخلي

812
01:05:45,420 --> 01:05:46,670
!رائحتكِ كريهة

813
01:05:46,670 --> 01:05:47,710
المرحاض؟

814
01:05:47,710 --> 01:05:50,090
نادراً ما أستخدم الشفّاط المائي

815
01:05:50,090 --> 01:05:51,350
!نظّفيه

816
01:05:51,350 --> 01:05:52,550
رائحته نتِنة

817
01:05:52,550 --> 01:05:54,640
عجيب أمركما

818
01:05:54,640 --> 01:05:57,220
البشر حسّاسون حقّاً

819
01:05:57,220 --> 01:05:58,560
أليس كذلك يا نياكو؟

820
01:06:05,570 --> 01:06:09,070
لا أصدّق بأنّها ما إن أتت حتّى بدأت تُثير فوضى

821
01:06:09,070 --> 01:06:11,820
ألا يشطف الشّياطين المرحاض؟

822
01:06:11,820 --> 01:06:13,980
ولم تأكل خضراواتها أيضاً

823
01:06:13,980 --> 01:06:15,330
...أنت

824
01:06:16,340 --> 01:06:21,080
أيّتها الشّيطانة اللّعينة! بِرازكِ عالق
!بالمرحاض اللّعين ولا يزول

825
01:06:27,310 --> 01:06:29,290
بيننا اتّفاق، أليس كذلك؟

826
01:06:29,290 --> 01:06:31,780
يمكنك لمس صدري

827
01:06:31,780 --> 01:06:32,860
!لذا، المس

828
01:06:43,920 --> 01:06:47,030
هيّا، ما خطبك؟ ألست مسروراً؟

829
01:06:47,030 --> 01:06:48,570
ابدأ بمُداعبتك

830
01:06:53,770 --> 01:06:55,570
لكن لديّ شرط

831
01:06:56,750 --> 01:07:00,200
يحقّ لك ثلاث عصرات من صدري فقط

832
01:07:00,780 --> 01:07:02,250
ثلاثة؟

833
01:07:02,960 --> 01:07:05,630
واحدة لإنقاذِك نياكو

834
01:07:05,630 --> 01:07:08,360
والثّانية لقتل شيطان الخفّاش

835
01:07:08,360 --> 01:07:12,970
والثّالثة لحمايتي من ذي تسريحة القُنْزُعة

836
01:07:13,460 --> 01:07:15,970
،لم أكن أنوي السّماح لك بصراحة

837
01:07:16,250 --> 01:07:19,470
لكن جهودك أكسبَتْك هذه العصرات الثّلاث

838
01:07:19,470 --> 01:07:21,510
اعصرها بامتنان

839
01:07:25,230 --> 01:07:26,930
!إنّها ملاك

840
01:07:38,980 --> 01:07:40,770
!يا له من شعور جميل

841
01:07:52,020 --> 01:07:53,170
ما هذا؟

842
01:07:53,170 --> 01:07:55,090
حشوة صدر

843
01:07:55,090 --> 01:07:58,180
اختراع مُدهش يجعل الصّدر يبدو أكبر

844
01:08:01,930 --> 01:08:04,310
والآن! بقي عصرتان

845
01:08:13,830 --> 01:08:15,990
!حسناً! المُداعبة الأخيرة

846
01:08:19,850 --> 01:08:22,200
!انتهيت! اكتمل العدد

847
01:08:22,200 --> 01:08:25,190
ما رأيك؟ ألم يكن ذلك مذهلاً؟

848
01:08:26,660 --> 01:08:29,110
كم أنت محظوظ لقدرتك على إمساك
!مثل هذه الأشياء الرائعة

849
01:08:29,110 --> 01:08:31,210
!بهذا نكون قد تعادلنا

850
01:08:31,210 --> 01:08:35,720
بعد إنقاذ نياكو، لا أملك سبباً فعليّاً
،لاصطياد الشّياطين بعد الآن

851
01:08:32,750 --> 01:08:37,650
في جُعبتي كلام كثير، لكن... ماذا؟

852
01:08:35,720 --> 01:08:38,220
!مع ذلك لا مفرّ من ماكيما

853
01:08:38,220 --> 01:08:40,800
!لذا سأساعدك في أداء واجبك

854
01:08:40,800 --> 01:08:42,620
!أنا متأكّدة بأنّ السّرور يغمرك

855
01:08:44,980 --> 01:08:46,720
!نياكو! لنخلد إلى النّوم

856
01:08:52,940 --> 01:08:54,260
هذا هو؟

857
01:09:01,740 --> 01:09:03,860
!حبّذا لو أحصل على طبقٍ ثانٍ

858
01:09:03,860 --> 01:09:05,030
!سآكل طبقَك إن كنتَ لا تريده

859
01:09:05,030 --> 01:09:05,750
!...أيّتُها

860
01:09:08,410 --> 01:09:11,250
هذا نموذج الاعتذار بخصوص الأضرار الّتي طالت المباني

861
01:09:11,530 --> 01:09:15,060
وهذا للتأكيد على التخلّص من جثث الشّياطين

862
01:09:15,060 --> 01:09:18,560
وهذا من وزارة الإصلاح الزراعي والبُنى
التحتيّة والنقل والسّياحة

863
01:09:18,560 --> 01:09:20,760
عليك أن تضع ختماً هنا وهنا

864
01:09:27,280 --> 01:09:29,820
أكره دفعك لإتمام كلّ هذه المُعاملات الورقيّة

865
01:09:29,820 --> 01:09:33,650
يُشعرك هذا وكأنّ قتلك لشيطان الخفّاش كان عقوبة

866
01:09:35,760 --> 01:09:39,150
هل هناك ما يؤرقك يا دينجي؟

867
01:09:42,110 --> 01:09:43,160
...في الحقيقة

868
01:09:43,490 --> 01:09:47,710
ثمّة أمر كنتُ أسعى له وتمكّنتُ أخيراً من الحصول عليه

869
01:09:48,410 --> 01:09:51,180
...لكن حالما حصلتُ عليه، لم يكن

870
01:09:51,850 --> 01:09:54,930
بالأمر الجلل مثلما ظننتُه

871
01:09:55,420 --> 01:10:01,290
والآن أتساءل، إذا سعيتُ لشيء آخر
،وتمكّنتُ من الحصول عليه

872
01:10:02,340 --> 01:10:07,210
هل سأعتقد بأنّني كنتُ أسعد أثناء عمليّة السّعي؟

873
01:10:09,080 --> 01:10:12,940
هذا... هُراء، أليس كذلك؟

874
01:10:15,380 --> 01:10:18,210
عمّاذا تتكلّم بالتّحديد يا دينجي؟

875
01:10:18,570 --> 01:10:23,450
لمستُ أثداء للمرّة الأولى، لكن
لم يكن ذلك بالأمر العظيم

876
01:10:32,660 --> 01:10:34,010
...دينجي

877
01:10:34,010 --> 01:10:35,630
،أعتقد أنّه عندما يتعلّق الأمر بالجنس

878
01:10:36,060 --> 01:10:42,130
كلّما فهمت الشّريك أكثر، كان الشّعور أجمل

879
01:10:44,580 --> 01:10:49,070
لكن من الصّعب فهم شعور الشّخص الآخر

880
01:10:50,620 --> 01:10:54,150
لذا ابدأ بمُراقبة اليد بإمعان

881
01:10:56,390 --> 01:10:59,250
كم طول أصابعها؟

882
01:11:02,590 --> 01:11:05,760
هل كفّها بارد؟

883
01:11:06,490 --> 01:11:07,840
أم دافئ؟

884
01:11:09,450 --> 01:11:11,070
ما شكل أذنها؟

885
01:11:12,010 --> 01:11:14,420
هل سبقَ وعُضَّتْ إصبعُك؟

886
01:11:14,420 --> 01:11:15,670
عُـ-عُضَّتْ...؟

887
01:11:15,670 --> 01:11:17,090
تذكّرها

888
01:11:17,950 --> 01:11:20,860
،بحيث حتّى لو كنتَ لا ترى

889
01:11:21,800 --> 01:11:26,800
ستتمكّن من تمييزي من خلال قوّة عضّتي

890
01:11:28,360 --> 01:11:29,660
احفظها

891
01:11:40,220 --> 01:11:42,280
حـ... حفظتُها

892
01:12:11,540 --> 01:12:13,020
...دينجي

893
01:12:14,730 --> 01:12:17,020
أودّ أن أطلب منك فعل شيء لأجلي

894
01:12:17,440 --> 01:12:18,650
أيمكنني؟

895
01:12:20,820 --> 01:12:21,900
أجل

896
01:12:27,280 --> 01:12:29,930
أريدك أن تهزم شيطان البُندُقيّة

897
01:12:30,730 --> 01:12:32,540
شيطان البُندُقيّة؟

898
01:12:33,160 --> 01:12:39,290
ظهرَ في أمريكا قبل 13 عاماً، لكن
لا يعرف أحدٌ مكانه الآن

899
01:12:39,900 --> 01:12:45,050
إنّه شيطانٌ قويٌّ جدّاً يريد كلّ الصّائدين قتله

900
01:12:46,650 --> 01:12:51,010
لكن أرى بأنّك تستطيع قتله

901
01:12:51,680 --> 01:12:56,680
لأنّك مختلف عن أيّ صائد شياطين آخر

902
01:12:57,270 --> 01:13:00,690
،وإذا استطعتَ قتل شيطان البُندُقيّة

903
01:13:01,070 --> 01:13:05,500
فسأحقّق لك أيّ أمنية

904
01:13:08,160 --> 01:13:11,180
،تقولين أنّه إذا قتلَ دينجي شيطانَ البُندُقيّة

905
01:13:11,180 --> 01:13:16,200
فستُحقّق ماكيما-سان أيّ أمنية له؟

906
01:13:16,840 --> 01:13:19,680
...لحظة... أيُعقَل

907
01:13:20,350 --> 01:13:22,580
،إذا قتلَ دينجي شيطانَ البُندُقيّة

908
01:13:22,580 --> 01:13:26,460
فستُحقّق ماكيما-سان أيّ أمنية له؟

909
01:13:31,910 --> 01:13:34,410
—أيّ شيء... حتّى الجـ

910
01:13:34,410 --> 01:13:36,720
قلتُ أيّ شيء يا دينجي

911
01:13:36,720 --> 01:13:40,230
!يا للهول! هل هذا مُتاح حتّى؟

912
01:13:41,110 --> 01:13:45,400
مع العلم أنّه مُتاح فقط لأنّ هذا
الشّيطان قويّ جدّاً وشرّير

913
01:13:46,370 --> 01:13:50,190
كان النّاس يحاولون كسب المال من الأسلحة النّاريّة

914
01:13:50,190 --> 01:13:53,850
،كإجراء مُضادّ للشياطين في كلّ أنحاء العالم

915
01:13:53,850 --> 01:13:58,620
ما أفضى إلى زيادة في مُعدّل الجريمة والصّراعات

916
01:13:58,990 --> 01:14:03,460
،كثّفت وسائل الإعلام تركيزها على ذلك لفترة من الزمن

917
01:14:03,880 --> 01:14:08,720
بالتزامن مع ازدياد خوف النّاس
من العنف أكثر من أيّ وقت سبق

918
01:14:09,880 --> 01:14:14,300
ثمّ نُفِّذَ هجوم إرهابيّ مُسلّح ضخم في أمريكا

919
01:14:14,760 --> 01:14:17,730
كان ذلك نفس اليوم الّذي ظهرَ فيه شيطان البُندُقيّة

920
01:14:21,640 --> 01:14:27,360
"قال فأر المدينة "هُنا أقطُن

921
01:14:28,360 --> 01:14:31,860
!وكم كان منزلاً كبيراً

922
01:14:31,860 --> 01:14:33,740
—عائلة فأر المدينة

923
01:14:32,810 --> 01:14:33,740
!أبي

924
01:14:34,170 --> 01:14:35,910
لنلعب التِقاط الكُرة في الخارج

925
01:14:36,280 --> 01:14:40,450
تايو ليس بحالٍ جيّدة. ابحث عن شيء
يمكنك أن تلعبه بمفردك

926
01:14:40,820 --> 01:14:42,590
إنّه هكذا دائماً

927
01:14:42,590 --> 01:14:44,500
لا أتذكّر أنّه كان بحالٍ جيّدة يوماً

928
01:14:44,500 --> 01:14:48,510
أنت الأخ الأكبر. كُن مُهذّباً والعب بمُفردك

929
01:14:50,160 --> 01:14:51,290
...أنا

930
01:14:51,760 --> 01:14:54,760
أريد اللّعب مع أخي

931
01:15:07,310 --> 01:15:08,570
كُفّ عن اللّحاق بي

932
01:15:11,440 --> 01:15:13,950
!أنت مُزعج للغاية... قلتُ كُفّ عن ذلك

933
01:15:17,230 --> 01:15:19,150
سوف ألعب بمُفردي

934
01:15:23,080 --> 01:15:24,490
!خذ هذه

935
01:15:26,250 --> 01:15:28,380
!أحمق! قلتُ توقّف

936
01:15:36,380 --> 01:15:37,510
...هذا بارد

937
01:15:43,120 --> 01:15:46,520
إذا أُصِبتَ بنزلة برد، سأقع في ورطة

938
01:15:48,650 --> 01:15:52,220
لن تبرد يداك إذا لعِبنا لعبة الإمساك بالكُرة، صحيح؟

939
01:15:52,950 --> 01:15:54,760
اذهب وأحضر قفّازاً من المنزل

940
01:15:56,480 --> 01:15:58,150
!مرحى

941
01:16:14,540 --> 01:16:19,180
في أقلّ من خمس دقائق بقليل، قُتِل 1.2 مليون شخص

942
01:16:19,550 --> 01:16:23,430
لم يُرَ شيطان البُندُقيّة منذ ذلك الحين

943
01:16:25,810 --> 01:16:31,330
،ازداد الخوف من الشّياطين نتيجة ذلك بصورة عامّة

944
01:16:31,330 --> 01:16:35,950
وأصبحت جميع الشّياطين أقوى من ذي قبل

945
01:16:37,270 --> 01:16:41,970
أصبح ضبط الأسلحة النّاريّة دوليّاً
،أكثر صرامة

946
01:16:41,970 --> 01:16:48,880
في مُحاولة لإضعاف شيطان البُندُقيّة
إلى جانب الرّقابة المُشدّدة للأخبار

947
01:16:50,520 --> 01:16:52,620
...لستُ أدري إن كنتُ أفهم، لكن

948
01:16:52,620 --> 01:16:55,630
إنّ هذا الشّيطان قويّ جدّاً لدرجة لا يمكن استيعابها

949
01:16:56,090 --> 01:16:58,510
أتظنّ نفسك قادراً على هزيمته يا دينجي؟

950
01:16:59,720 --> 01:17:00,550
...في الواقع

951
01:17:01,060 --> 01:17:04,140
،إذا بذلتُ كلّ طاقتي

952
01:17:04,540 --> 01:17:06,770
فسيكون ذلك أسهل ما يُمكن

953
01:17:07,660 --> 01:17:09,310
...في هذه الحالة

954
01:17:09,310 --> 01:17:11,910
أوّلاً، سيترتّب علينا إيجاد شيطان البُندُقيّة

955
01:17:12,940 --> 01:17:15,570
كيف سنفعل ذلك بالضبط على أيّ حال؟

956
01:17:16,240 --> 01:17:19,820
هذه قِطَعٌ من شيطان البُندُقيّة جمعناها

957
01:17:20,410 --> 01:17:25,760
إنّه سريع جدّاً لدرجة أنّه تتمزّق قِطَعٌ منه من مجرّد الحركة

958
01:17:26,080 --> 01:17:28,500
،إذا أكلَ شيطانٌ بعضاً من هذا

959
01:17:28,500 --> 01:17:33,070
فمهما كانت طبيعته، سيزداد قوّة

960
01:17:33,070 --> 01:17:35,810
...إذا نظرت إلى أشلاء اللّحم هذه

961
01:17:35,810 --> 01:17:37,590
أترى كيف تلتصق ببعضها الآخر؟

962
01:17:39,040 --> 01:17:42,360
،بسبب قوّة شيطان البُندُقيّة الهائلة

963
01:17:42,360 --> 01:17:45,210
،حالما تبلغ قِطَعُه حجماً مُعيّناً

964
01:17:45,210 --> 01:17:48,810
فإنّها تبدأ بالانجذاب للجسم الأصليّ

965
01:17:49,600 --> 01:17:52,840
،لذا إذا كبّرنا هذه القِطعة

966
01:17:53,530 --> 01:17:55,920
فستقودنا إلى شيطان البُندُقيّة

967
01:17:56,460 --> 01:17:57,610
وجدتُ واحدة

968
01:17:58,840 --> 01:18:02,240
كان يتغذّى على قِطعة من شيطان البُندُقيّة إذاً

969
01:18:02,730 --> 01:18:06,240
لا عجب في أن يصبح هذا الشّيطان
الضّعيف قويّاً جدّاً

970
01:18:06,540 --> 01:18:09,430
،لكن هل هو من وجدَ القِطعة
أم هناك من قدّمها له؟

971
01:18:10,990 --> 01:18:13,750
هذا لا يغيّر من جوهر عملنا

972
01:18:14,190 --> 01:18:16,250
،نستمرّ في قتل الشّياطين

973
01:18:16,820 --> 01:18:19,570
وفي نهاية المطاف، سنجده

974
01:18:22,720 --> 01:18:25,010
تلقّى الأمن العام طلباً بإبادة شيطان

975
01:18:25,350 --> 01:18:27,770
رُصِدَ شيطان داخل فندق

976
01:18:27,770 --> 01:18:30,640
لا يوجد ما يؤكّد حالة نُزلاء الفندق

977
01:18:30,640 --> 01:18:38,720
عُثِر على العديد من صائدي الشّياطين
المدنيّين الّذين دخلوا في البداية موتى

978
01:18:38,720 --> 01:18:41,390
يُعتقَد بأنّ الهدف قد التهمَ قِطعة من شيطان البُندُقيّة

979
01:18:42,280 --> 01:18:46,430
سنُرسل ستّة عُملاء من فرع الإبادة
الخاص 4 التّابع للأمن العام

980
01:18:48,550 --> 01:18:51,500
إنّه يختبئ في مكان ما في هذا الفندق

981
01:18:52,110 --> 01:18:54,420
وهذا ليس شيطاناً عاديّاً

982
01:18:54,830 --> 01:18:57,680
،لحم شيطان البندقيّة ينجذب نحوه

983
01:18:58,070 --> 01:19:00,920
ما يعني بأنّ هذا الشّيطان قد أكل قطعة

984
01:19:00,920 --> 01:19:03,680
قد يكون شيطان البُندُقيّة بنفسه؟

985
01:19:04,730 --> 01:19:09,310
.كلّما كانت القِطعة أكبر، كان الجذب أشدّ
هذا الجذب أضعف من أن يكون كذلك

986
01:19:09,310 --> 01:19:11,680
!يبدو مُسلّياً... إليّ به

987
01:19:12,800 --> 01:19:15,190
سبقَ وقلتُ لكما أن تُحسِنا السُّلوك

988
01:19:17,030 --> 01:19:20,570
وهل تريدني أن أتملّق لك بلا سبب؟

989
01:19:17,780 --> 01:19:20,570
!يا لحماقة وغرور البشر

990
01:19:23,700 --> 01:19:25,250
هاياكاوا سينباي

991
01:19:25,250 --> 01:19:26,490
سينباي

992
01:19:26,490 --> 01:19:27,460
جيّد

993
01:19:27,460 --> 01:19:28,700
!رائع

994
01:19:29,600 --> 01:19:30,530
كم هو ليِّن

995
01:19:30,530 --> 01:19:31,580
!هاياكاوا سينباي

996
01:19:32,010 --> 01:19:34,760
...نظراً إلى أنّنا على وشك مُقاتلة بعض الشّياطين

997
01:19:34,760 --> 01:19:37,460
هل يمكننا الوثوق بهذين في حمايتنا من الخلف؟

998
01:19:37,870 --> 01:19:41,070
...إحداهما شيطانة بشريّة والآخر وقح

999
01:19:41,070 --> 01:19:43,030
لستُ مُتيقّناً من هذا

1000
01:19:44,090 --> 01:19:46,470
لا يمكننا أن ندعهما يحمياننا من الخلف

1001
01:19:46,780 --> 01:19:50,340
في مهام الإبادة، سيتمركزان في نقطة مُعيّنة

1002
01:19:50,340 --> 01:19:54,410
إن حاولا الهرب أو التحالف مع الشياطين، سنقتلهما

1003
01:19:54,800 --> 01:19:56,850
!تتعامل معنا كماشية

1004
01:19:56,850 --> 01:19:59,480
لا حقوق لكما

1005
01:20:00,570 --> 01:20:02,730
إنّه غاضب جدّاً

1006
01:20:02,730 --> 01:20:04,230
لا بدّ أنّ السّبب ما حدث صباح اليوم

1007
01:20:04,230 --> 01:20:06,610
لعلّنا تمادينا في المقلب؟

1008
01:20:06,610 --> 01:20:09,710
!أتعتبران هذا مقلباً؟ سأقتلكما

1009
01:20:09,710 --> 01:20:11,950
مُخيف! ماذا حدث؟

1010
01:20:12,390 --> 01:20:16,080
آكي، لا يجوز أن تكون قاسياً طوال الوقت

1011
01:20:16,080 --> 01:20:20,110
معها حقّ! كاد الخفّاش يقتلني، والآن
!هناك المزيد من الأعمال؟

1012
01:20:20,110 --> 01:20:21,210
!أريد مكافأة

1013
01:20:22,710 --> 01:20:25,710
حسناً! سأضحّي من أجل الفريق

1014
01:20:26,220 --> 01:20:29,140
...مَن يقتل هذا الشّيطان يكسب

1015
01:20:29,140 --> 01:20:32,220
!قُبلة على الخدّ منّي شخصيّاً

1016
01:20:33,600 --> 01:20:36,670
!هذا... لا يجدر بكِ فعل ذلك

1017
01:20:36,670 --> 01:20:38,980
!شابّة غير متزوّجة لا ينبغي لها أن تكون... بذيئة

1018
01:20:40,590 --> 01:20:43,280
لكن ألا تمنح المُكافأة حافزاً؟

1019
01:20:43,280 --> 01:20:44,900
أليس كذلك؟

1020
01:20:50,010 --> 01:20:51,780
لا أحتاج هذه القُبلة

1021
01:20:51,780 --> 01:20:54,540
لا تقلقي. أنا مُتحفِّز جدّاً

1022
01:20:54,540 --> 01:20:55,700
ماذا؟

1023
01:20:55,700 --> 01:20:58,880
وضعتُ نُصبَ عينَي على شخص
للحصول على قُبلة أولى بالفعل

1024
01:20:59,430 --> 01:21:03,420
سأجد كلّ هذه القِطع اللّحميّة أو أيّاً كانت لأجلها

1025
01:21:03,420 --> 01:21:06,670
لذا ما لم يمُت شيطان البُندُقيّة، لا قُبلات حارّة لي

1026
01:21:08,900 --> 01:21:11,080
!هذا كلام جريء أمام آكي

1027
01:21:11,080 --> 01:21:13,890
فضلاً عن ذلك، تعلّمتُ شيئاً مهمّاً حقّاً

1028
01:21:14,650 --> 01:21:19,090
يغدو الجنس أفضل عندما يكون بين
شخصين يفهمان بعضهما الآخر

1029
01:21:19,400 --> 01:21:23,150
!لا أعرف اسمكِ حتّى، لذا لستُ مُهتمّاً بشفتيكِ

1030
01:21:27,080 --> 01:21:30,620
...في هذه الحالة، إذا قتلتَ الشّيطان يا دينجي

1031
01:21:31,780 --> 01:21:33,990
سأمنحك قُبلة... لِسان

1032
01:21:41,580 --> 01:21:44,000
!من الخطير أن تتنقّل بمفردك! توقّف

1033
01:21:44,700 --> 01:21:47,880
!أعشق مُمازحة الفتيان حقّاً

1034
01:21:48,170 --> 01:21:50,270
بئساً، ماذا عسانا نفعل؟

1035
01:21:50,270 --> 01:21:51,890
أتعطّش لدِماء

1036
01:21:51,890 --> 01:21:54,810
!هذا خطير! عليك أن تتوقّف

1037
01:21:57,340 --> 01:22:01,350
كانت هيمينو سينباي لطيفة بما يكفي
!لتدريبي في الأشهر الستّة الماضية

1038
01:22:01,350 --> 01:22:04,530
إذا كان البديل هو السّماح لوقح
...مثلك أن يقبّلها

1039
01:22:04,530 --> 01:22:06,570
!فسأتلقّى تلك القُبلة على الخدّ إذاً

1040
01:22:06,570 --> 01:22:07,490
!ابتعد

1041
01:22:07,490 --> 01:22:09,930
!لا أريد أن يضغط رجلٌ عليّ بكامل جسده! هذا مُقرف

1042
01:22:09,930 --> 01:22:10,870
!ماذا تقول؟

1043
01:22:10,870 --> 01:22:13,620
!أريد الانضمام لكما

1044
01:22:10,870 --> 01:22:14,640
!فلتمُت! هدفي أعظم بكثير من هدفك يا رجُل

1045
01:22:14,640 --> 01:22:18,080
!اصمت! لا أريد سماع هذا من شخص أحدث منّي

1046
01:22:15,420 --> 01:22:18,850
هيمينو سينباي، ما رأيكِ بالمبتدئين؟

1047
01:22:18,080 --> 01:22:19,210
!اِخرس يا هذا

1048
01:22:19,210 --> 01:22:20,740
!المزيد من هذا! أجل

1049
01:22:20,740 --> 01:22:24,380
لا يتمتّع آراي بالكفاءة العالية، لكنّه
يعوّض عن ذلك بالحافز

1050
01:22:24,730 --> 01:22:27,910
بينما تمتلك كوبيني الموهبة، لكنّها خجولة جدّاً

1051
01:22:26,420 --> 01:22:27,910
!عليك به، عليك به

1052
01:22:28,460 --> 01:22:32,450
أتعتقد بأنّ أيّاً من الأربعة المُبتدئين
لديه فُرصة للنجاة يا آكي؟

1053
01:22:34,120 --> 01:22:38,180
مُعظم الصّائدين إمّا يموتون أو ينتقلون
،إلى القطّاع الخاص بعد عام

1054
01:22:34,650 --> 01:22:36,480
!إنّه نِزال حتّى الموت

1055
01:22:36,480 --> 01:22:38,180
هل فهمتَ الآن؟

1056
01:22:38,510 --> 01:22:42,190
مهما خمّنتُ درجة قوّتهم

1057
01:22:39,680 --> 01:22:42,190
!لن تُقبّل هيمينو سينباي

1058
01:22:42,830 --> 01:22:45,440
هذه ليست إجابة فعليّاً

1059
01:22:46,870 --> 01:22:48,780
إيّاك أن تموت يا آكي

1060
01:22:57,060 --> 01:22:58,120
...هيمينو

1061
01:22:59,220 --> 01:23:01,520
هذا شريكك الجديد

1062
01:23:02,360 --> 01:23:05,550
إنّه فظّ، لكن درّبتُه ليكون نافعاً بعض الشيء

1063
01:23:05,550 --> 01:23:06,890
حاولا أن تنسجما معاً

1064
01:23:12,380 --> 01:23:13,530
اسمي آكي

1065
01:23:14,010 --> 01:23:15,140
سررتُ بلقائكِ

1066
01:23:20,390 --> 01:23:22,010
هل ستكون نافعاً؟

1067
01:23:23,990 --> 01:23:26,520
لا أدري... رُبّما

1068
01:23:27,500 --> 01:23:30,700
ستكون شريكي السّادس

1069
01:23:30,700 --> 01:23:32,330
مات الآخرون كُلّهم

1070
01:23:33,070 --> 01:23:35,680
ماتوا لأنّهم كانوا عديمي النّفع

1071
01:23:39,340 --> 01:23:41,410
إيّاك أن تموت يا آكي

1072
01:23:42,420 --> 01:23:46,920
على ذكرِ الأمر، لا أرى أيّ شيطان في الأرجاء

1073
01:23:47,290 --> 01:23:50,700
هل قطعة اللّحم خاصّتك تلك تعمل أصلاً؟

1074
01:23:52,920 --> 01:23:54,910
...مُرهَق للغاية

1075
01:23:54,910 --> 01:23:56,140
...آكي

1076
01:23:57,360 --> 01:23:58,430
قادم

1077
01:24:17,840 --> 01:24:18,820
أمسكتُ بك

1078
01:24:19,950 --> 01:24:21,110
!يعوم؟

1079
01:24:21,110 --> 01:24:22,910
!المعركة قائمة

1080
01:24:30,380 --> 01:24:34,190
شيطان لعين! هل رأيتُم
!كيف يعوم خوفاً منّي؟

1081
01:24:35,160 --> 01:24:37,260
لا، لا، هذه قوّتي أنا

1082
01:24:37,260 --> 01:24:38,520
ماذا تقولين؟

1083
01:24:38,520 --> 01:24:41,580
لديّ عقد مع شيطان الشّبح

1084
01:24:41,580 --> 01:24:46,770
قدّمتُ عيني اليُمنى مُقابِل القدرة
على استخدام يد شبح يُمنى

1085
01:24:46,770 --> 01:24:51,160
يدُ شبحي خفيّة وقويّة. مهارة عالية، صحيح؟

1086
01:24:52,150 --> 01:24:55,430
ما رأيك يا آكي؟ هل لديه أيّ قطعة
لحم من شيطان البُندُقيّة؟

1087
01:24:55,430 --> 01:24:58,780
التّفاعل ضعيف. ليس هو

1088
01:24:58,780 --> 01:25:02,240
فهمت... لنستمرّ في الصّعود إذاً

1089
01:25:03,990 --> 01:25:08,850
هل من الحكمة الثّرثرة بشأن قِواكِ في حضوري؟

1090
01:25:08,850 --> 01:25:12,070
ألستُم أنتم البشر هنا لكبح جِماحي؟

1091
01:25:12,070 --> 01:25:14,550
التعرُّف على قِوانا يعزّز تعاوننا كفريق، صحيح؟

1092
01:25:15,130 --> 01:25:18,450
فضلاً عن ذلك، أُخفي المزيد في جُعبتي، لذا لستُ قلقة

1093
01:25:18,450 --> 01:25:20,360
حقّاً؟

1094
01:25:20,360 --> 01:25:23,350
ما أنتِ فاعلة إذاً إن قلتُ بأنّني سأقتلها؟

1095
01:25:24,640 --> 01:25:26,510
أبعِدي سلاحكِ

1096
01:25:26,510 --> 01:25:29,520
إذا أسأتِ التصرُّف، يمكنني خنقكِ حتّى الموت في أيّ وقت

1097
01:25:32,260 --> 01:25:34,020
...لا أستطيع... لمسها

1098
01:25:40,400 --> 01:25:43,090
!حبّذا لو ننسجم معاً. سيكون الأمر أسهل

1099
01:25:45,110 --> 01:25:47,270
!سوف ألتهِمُكِ يوماً ما

1100
01:25:47,270 --> 01:25:49,540
من المُستحسن ألّا تفعلي. أحاول الحصول على قُبلة

1101
01:25:49,890 --> 01:25:54,110
ألا تفهمان بأنّ الشّيطان ما زال موجوداً؟
...ألا يمكنكما أن تخرسا

1102
01:25:56,950 --> 01:25:57,970
ماذا؟

1103
01:26:01,660 --> 01:26:04,430
تبدو أنّها ستكون مُقزّزة وهي نيّئة

1104
01:26:03,830 --> 01:26:04,430
ما الأمر؟

1105
01:26:04,430 --> 01:26:06,730
يبدو هذا انحرافاً

1106
01:26:04,840 --> 01:26:09,810
كنّا... في طريقنا من الطّابق الثّامن إلى التّاسع، صحيح؟

1107
01:26:07,050 --> 01:26:08,710
...ربّما مغليّة أو مقليّة

1108
01:26:08,710 --> 01:26:10,810
عليك بطبخ مؤخّرتك

1109
01:26:09,810 --> 01:26:10,810
أجل

1110
01:26:12,430 --> 01:26:14,200
لكن هذا الطّابق الثّامن

1111
01:26:15,570 --> 01:26:17,320
ربما قرأته بشكل خاطئ

1112
01:26:17,320 --> 01:26:20,000
!الأمر ليس كذلك! ثمّة أمر مُريب هنا

1113
01:26:20,000 --> 01:26:21,070
سوف أتحقّق

1114
01:26:21,070 --> 01:26:23,630
!وجدتُها! مشويّة كشريحة لحم

1115
01:26:23,630 --> 01:26:24,720
!شريحة لحم؟

1116
01:26:24,720 --> 01:26:26,730
!أريد تذوّق شريحة اللّحم

1117
01:26:29,690 --> 01:26:30,700
ماذا؟

1118
01:26:33,460 --> 01:26:37,560
آراي... قبل قليل... كنتَ تنزل للطابق السُّفلي، صحيح؟

1119
01:26:56,070 --> 01:26:57,570
!يا للهول

1120
01:27:01,830 --> 01:27:04,700
آكي... ما الّذي يجري هنا؟

1121
01:27:04,700 --> 01:27:07,500
لا بُدّ أنّها قوّة شيطان

1122
01:27:08,580 --> 01:27:10,430
كوبيني، ابقي مكانكِ

1123
01:27:23,070 --> 01:27:25,440
لماذا هناك غرفة في الجانب الآخر من النّافذة؟

1124
01:27:31,560 --> 01:27:34,190
!لا تؤدّي النّوافذ إلى الخارج

1125
01:27:34,190 --> 01:27:36,080
!إنّها مُتّصلة بالغرفة المقابلة فحسب

1126
01:27:37,050 --> 01:27:38,640
توقّعتُ هذا

1127
01:27:39,390 --> 01:27:43,980
نحن عالِقون في الطّابق الثّامن

1128
01:27:51,790 --> 01:27:53,620
لنُلخّص ظرفنا الحالي

1129
01:27:53,620 --> 01:27:55,870
،غالباً هذا من صنيع شيطان

1130
01:27:55,870 --> 01:27:58,620
،ومهما حاولنا من مرّات الوصول إلى طابق مُختلف

1131
01:27:58,620 --> 01:28:00,250
نعود إلى الطّابق الثّامن

1132
01:28:00,250 --> 01:28:02,630
المصعد لا يعمل لسببٍ ما

1133
01:28:02,980 --> 01:28:05,630
لا يوجد مخرج عبر الغرف أو النّوافذ

1134
01:28:06,040 --> 01:28:09,600
حاولنا الصّعود عبر السّقف، انتهى الحال
بنا إلى الطّابق الثّامن مجدّداً

1135
01:28:10,730 --> 01:28:14,330
ربّما لأنّ باور قتلَتْ ذلك الشّيطان؟

1136
01:28:14,770 --> 01:28:17,640
استخدم ذلك الشيطان قوّته لحبسنا
هنا ثمّ مات دون إلغائها

1137
01:28:17,640 --> 01:28:18,610
—ولهذا السّبب

1138
01:28:18,610 --> 01:28:20,240
!أنت من أمرني بقتله

1139
01:28:20,240 --> 01:28:21,240
!لم أفعل

1140
01:28:21,240 --> 01:28:25,150
يُلغى تأثير قوّة الشّيطان عندما يموت. لذا هذا مستحيل

1141
01:28:25,150 --> 01:28:27,910
هل القطعة اللّحميّة تستجيب يا آكي؟

1142
01:28:28,220 --> 01:28:29,410
...بخصوصها

1143
01:28:29,800 --> 01:28:32,190
توقّفتْ عن الحركة تماماً

1144
01:28:32,830 --> 01:28:37,220
كان ذلك الشّيطان طُعماً، ونحن أكلناه دون تردُّد

1145
01:28:37,220 --> 01:28:40,630
لم أرَ شيطاناً يتصرّف بهذا الدّهاء من قبل

1146
01:28:40,630 --> 01:28:43,880
،لكن إذا لم يسمع أحدٌ أيّ نبأ عنّا لبعض الوقت

1147
01:28:43,880 --> 01:28:47,010
ألن يأتي صائدو الشّياطين الآخرون للمساعدة؟

1148
01:28:48,680 --> 01:28:53,440
نأمل ألّا يقعوا في نفس الفخّ الّذي وقعنا فيه حينها

1149
01:28:55,160 --> 01:28:58,740
جميعنا سنموت هنا

1150
01:28:58,740 --> 01:29:01,400
سنتضوّر جوعاً حتّى الموت

1151
01:29:01,400 --> 01:29:03,800
!تـ-تمالكي نفسكِ يا كوبيني

1152
01:29:03,800 --> 01:29:07,500
ألم تصبحي صائدة شياطين لتُرسلي
!أخاكِ إلى الكلّية؟

1153
01:29:07,500 --> 01:29:09,780
أجبراني على فعل ذلك

1154
01:29:09,780 --> 01:29:12,230
،والدايّ عازمان على التحاق أخي الأكبر بالكلّية

1155
01:29:12,230 --> 01:29:14,190
بما أنّه شخص موهوب

1156
01:29:14,190 --> 01:29:16,290
لذا وفّرا لي عملاً

1157
01:29:16,760 --> 01:29:21,340
كانت خياراتي الوحيدة هي العمل
كصائدة شياطين أو في مجال الجنس

1158
01:29:24,000 --> 01:29:27,800
!أردتُ الالتحاق بكلّية أيضاً

1159
01:29:27,800 --> 01:29:32,080
!وها أنا سأموت هنا

1160
01:29:37,020 --> 01:29:38,430
!...وجهها

1161
01:29:40,150 --> 01:29:41,650
!يكفي

1162
01:29:41,900 --> 01:29:43,260
!كُفّي عن الضّحك

1163
01:29:43,990 --> 01:29:48,370
كوبيني، يحبّ الشّياطين الخوف، مفهوم؟

1164
01:29:48,740 --> 01:29:51,910
إن خفتِ، فكأنّكِ تحقّقين رغبتهم يا عزيزتي

1165
01:29:51,910 --> 01:29:55,090
!لكنّني خائفة جدّاً

1166
01:29:56,190 --> 01:29:58,080
هل هناك ما يؤرقك أيضاً يا آكي؟

1167
01:30:00,580 --> 01:30:01,960
...السّاعة في هذه الغرفة

1168
01:30:02,870 --> 01:30:05,710
عالقة عند 8:18 منذ مدّة

1169
01:30:05,710 --> 01:30:09,470
في كلّ الغرف... السّاعة هي 8:18

1170
01:30:11,750 --> 01:30:17,350
من المُحتمَل أن يكون الزّمن قد توقّف
هنا في الطّابق الثّامن

1171
01:30:17,350 --> 01:30:20,830
وإن كان كذلك، لن يأتي أحد للمساعدة

1172
01:30:21,980 --> 01:30:25,110
مُذهل! إذاً يمكننا أن ننام قدر ما نشاء، صحيح؟

1173
01:30:26,660 --> 01:30:28,790
!يا لحماقتك

1174
01:30:28,790 --> 01:30:33,130
قد نعلق هنا للأبد

1175
01:30:33,130 --> 01:30:36,730
قد نعلق هنا وقد لا نعلق أيضاً، صحيح؟

1176
01:30:36,730 --> 01:30:38,120
أيقظوني عندما تعثرون على حلّ

1177
01:30:38,550 --> 01:30:41,870
هذا السّرير مُريح للغاية. سيكون
من الغباء ألّا أنام فيه

1178
01:30:42,300 --> 01:30:45,130
أنا مَدين للشيطان بهذه القيلولة

1179
01:30:52,860 --> 01:30:54,220
...نامَ بالفعل

1180
01:30:58,200 --> 01:30:59,520
دينجي

1181
01:30:59,520 --> 01:31:02,150
دينجي، استيقظ

1182
01:31:08,750 --> 01:31:11,660
ألم نجد مخرجاً من الطّابق الثّامن بعد؟

1183
01:31:11,660 --> 01:31:13,780
أكره تعكير مزاجك، لكن ليس بعد

1184
01:31:14,260 --> 01:31:18,630
أثناء نومك، اكتشفنا بأنّ الطاقة
الكهربائيّة ما زالت تعمل

1185
01:31:18,630 --> 01:31:23,790
ووجدنا بقايا طعام تركَه النُّزلاء الّذين لاذوا بالفرار

1186
01:31:23,790 --> 01:31:27,670
بصريح العبارة، الجميع مُرهَقون للغاية

1187
01:31:28,190 --> 01:31:31,170
قضى آكي كلّ وقته يبحث عن الشّيطان

1188
01:31:31,620 --> 01:31:34,800
أخبرتُه أن يحظى باستراحة، لكنّه يرفض

1189
01:31:35,180 --> 01:31:38,700
،كان آراي يساعد آكي في البداية

1190
01:31:38,700 --> 01:31:42,310
لكنّه حبسَ نفسه الآن في غرفة
أخرى نتيجة نوبة هلع

1191
01:31:42,660 --> 01:31:47,310
هرعت كوبيني وحاولَتْ أن تشرب من مياه
المرحاض، فضربتُها حتّى أُغمي عليها

1192
01:31:47,630 --> 01:31:49,940
...وبالنسبة للشيطانة البشريّة

1193
01:31:50,320 --> 01:31:52,190
هل حدثَ شيء مع باور؟

1194
01:31:52,190 --> 01:31:55,200
نظراً إلى أنّه لا شيء أفعله، قرّرتُ
الفوز بجائزة نوبّل

1195
01:31:55,200 --> 01:31:59,790
،حالما أكسب مثل هذه الجائزة البهيّة
!سوف يركع البشر أمامي

1196
01:31:59,790 --> 01:32:02,540
،وباستخدامِ جائزة نوبّل كموطئ قدم

1197
01:32:02,540 --> 01:32:04,480
!سوف أعتلي عرش رئيس الوُزراء

1198
01:32:04,480 --> 01:32:07,670
أريد أن أرى البشر يعانون

1199
01:32:08,090 --> 01:32:11,410
أوّل قانون سأسنُّه سيكون فرض
!%ضريبة بيع بنسبة 100

1200
01:32:12,480 --> 01:32:13,790
إنّها هكذا دوماً

1201
01:32:13,790 --> 01:32:16,430
حسناً. هذا جيّد إذاً

1202
01:32:16,840 --> 01:32:19,690
لنتناوب على مراقبة كوبيني وآراي

1203
01:32:19,690 --> 01:32:22,140
لم أستطع استعمال الحمّام
عندما كنتُ أفعل ذلك بمُفردي

1204
01:32:36,880 --> 01:32:39,700
حسناً، هذه سيجارتي الأخيرة

1205
01:32:39,700 --> 01:32:42,490
يُشعرني هدوءكما بالملل

1206
01:32:42,490 --> 01:32:47,460
يمكنني اتّخاذ الأمر برويّة لأنّ آكي يعمل بجدّ

1207
01:32:47,460 --> 01:32:49,840
!بالإضافة إلى أنّها قوّة النّيكوتين

1208
01:32:50,100 --> 01:32:53,590
يتعلّق الغريقُ بقشّة، صحيح؟

1209
01:32:53,840 --> 01:32:57,340
الحياة أجمل عندما يكون هناك ما تُدمن عليه

1210
01:32:57,340 --> 01:32:59,830
إنّها من نفس العلامة التّجاريّة التي يُدخّن منها

1211
01:33:02,870 --> 01:33:06,180
لأنّ آكي تعلّمَ كلّ شيء عن نكهة السّجائر

1212
01:33:06,180 --> 01:33:07,940
!منّي شخصيّاً

1213
01:33:09,400 --> 01:33:11,900
...قال مُعلّمي ذات مرّة

1214
01:33:11,900 --> 01:33:17,560
الشّياطين لا يهابون صائدي الشّياطين الأقوياء أو الشُّجعان

1215
01:33:17,560 --> 01:33:20,410
إنّهم يهابون صائدي الشّياطين المجانين

1216
01:33:20,670 --> 01:33:23,570
لهذا أشعر بأنّك ستصمد لفترة طويلة
في هذا العمل يا آكي

1217
01:33:25,320 --> 01:33:26,680
هل كانت تلك إهانة؟

1218
01:33:26,680 --> 01:33:29,360
وسآكل التّوفو باللّوز خاصّتكِ إن كنتِ لا تُريدينها

1219
01:33:32,210 --> 01:33:33,650
واحدة فقط

1220
01:33:35,210 --> 01:33:37,300
أنا لا أدخّن. التّدخين مُضرٌّ بالعِظام

1221
01:33:38,730 --> 01:33:42,810
آمل أن تفعل. يراودني إحساس بأنّنا
سنبقى معاً لفترة طويلة

1222
01:33:52,170 --> 01:33:54,040
واحدة فقط إذاً

1223
01:33:54,040 --> 01:33:57,280
هذه أوّل وآخر سيجارة سأدخّنها في حياتي

1224
01:33:59,430 --> 01:34:01,990
هيمينو، هل تبقّى لديكِ أيّ سجائر؟

1225
01:34:01,990 --> 01:34:04,990
آسفة. هذه الأخيرة

1226
01:34:04,990 --> 01:34:07,290
أعطيني إيّاها من فضلكِ

1227
01:34:09,260 --> 01:34:11,210
حسناً إذا كنتَ مُلِحّاً

1228
01:34:13,130 --> 01:34:15,550
!هذه قُبلة! ليس عدلاً! هذه قُبلة غير مُباشرة

1229
01:34:15,550 --> 01:34:16,950
!اصمُت

1230
01:34:20,410 --> 01:34:22,140
لديّ نبأ سيّئ

1231
01:34:23,110 --> 01:34:25,180
أتتذكّرون الشّيطان الّذي قتلناه؟

1232
01:34:25,180 --> 01:34:27,180
!الشّيطان الّذي سفكتُ دمَه

1233
01:34:27,470 --> 01:34:30,400
في الحقيقة، إنّه أكبر حجماً بكثير الآن

1234
01:34:40,400 --> 01:34:43,160
هذا الّذي قتلتُه حقّاً

1235
01:34:43,460 --> 01:34:47,570
يحبسنا في فندق... ويتحوّل جسده إلى هذه الهيئة؟

1236
01:34:47,570 --> 01:34:49,340
أيّ شيطان هو هذا بالتّحديد؟

1237
01:34:50,460 --> 01:34:53,310
أيّها البشر. اسمعوني أيّها البشر

1238
01:34:53,310 --> 01:34:57,800
...أيّها البشر الحمقى. أعرض عليكم عقداً

1239
01:34:57,800 --> 01:34:59,300
!لقد نطَق

1240
01:34:59,300 --> 01:35:00,780
عقد؟

1241
01:35:00,780 --> 01:35:04,330
أطعموني البشريّ المعروف باسم دينجي

1242
01:35:04,330 --> 01:35:06,100
حتّى جثّته ستَفي بالغرض

1243
01:35:06,100 --> 01:35:07,680
دعوني آكله

1244
01:35:07,680 --> 01:35:12,310
افعلوا هذا وسأسمح لبقيّتكم بالمُغادرة بسلام

1245
01:35:12,590 --> 01:35:15,980
!ستكون لديكم حرّية المُغادرة! اقبلوا بهذا العقد

1246
01:35:15,980 --> 01:35:20,320
...افعلوها... افعلوها

1247
01:35:26,860 --> 01:35:29,240
دينجي... دعه يأكلك

1248
01:35:49,940 --> 01:35:51,480
كم هذا بغيض

1249
01:35:51,480 --> 01:35:54,900
آكي، ألا يمكنك ابتلاع هذا الشّيء بشيطان الثّعلب؟

1250
01:35:55,450 --> 01:35:56,450
كون

1251
01:35:58,670 --> 01:36:00,890
توقّعتُ ألّا يأتي شيطان الثّعلب

1252
01:36:00,890 --> 01:36:03,310
فنحن معزولون عن العالم

1253
01:36:03,310 --> 01:36:06,110
جسد شيطان الثّعلب في كيوتو، لذا لا عجب

1254
01:36:06,110 --> 01:36:09,130
لنرَ ما الّذي يستطيع شبحي فعله إذاً

1255
01:36:11,140 --> 01:36:12,000
!هذا مؤلم

1256
01:36:12,000 --> 01:36:16,750
!هذا مؤلم! مؤلم! يا للألم

1257
01:36:18,880 --> 01:36:21,800
!هذا مؤلم! هذا مؤلم

1258
01:36:21,800 --> 01:36:23,310
!ازداد حجماً

1259
01:36:24,460 --> 01:36:25,800
!لا جدوى

1260
01:36:25,800 --> 01:36:29,050
...هذا ليس جسدي الرّئيسي

1261
01:36:29,050 --> 01:36:31,810
لن تجدوا قلبي هنا

1262
01:36:31,810 --> 01:36:34,190
...أنتم داخل معدتي

1263
01:36:34,190 --> 01:36:38,060
ولا نقاط ضعف لي في هذا الطّابق الثّامن

1264
01:36:38,060 --> 01:36:42,070
لا وسيلة لنجاتكم في هذا المكان، إلّا بقبول عرضي

1265
01:36:43,370 --> 01:36:47,050
غالباً لن تدعهم وشأنهم حتّى لو مُتُّ أنا

1266
01:36:47,050 --> 01:36:48,570
على العكس

1267
01:36:48,570 --> 01:36:51,900
لفظَ الشّيطان كلمة "عقد"، صحيح؟

1268
01:36:51,900 --> 01:36:56,080
تمتلك كلمة "عقد" قوّة كبيرة عندما
يكون أحد أطرافه شيطان

1269
01:36:56,080 --> 01:37:01,590
عندما يحترم أحدُ الأطراف العقد، فيجب
على الآخر أن يحترمه كذلك

1270
01:37:01,590 --> 01:37:04,210
الطرف الّذي ينتهك العقد ينتهي المطاف بموته

1271
01:37:04,210 --> 01:37:07,400
لذا سنتمكّن من المُغادرة إذا قتلناك يا دينجي

1272
01:37:07,950 --> 01:37:11,350
هيمينو سينباي... ينبغي أن نقتله

1273
01:37:11,830 --> 01:37:15,850
يمكننا رسم خطّة أخرى حالما يموت ونخرج من هنا

1274
01:37:15,850 --> 01:37:18,600
وإلّا سنموت من الجوع

1275
01:37:18,600 --> 01:37:23,230
يسمح القانون لصائدي الشّياطين بإنشاء عقود مع الشّياطين

1276
01:37:23,230 --> 01:37:25,780
!ينبغي أن نقبل بالعرض

1277
01:37:25,780 --> 01:37:28,410
يريد الشّيطانُ دينجي ميّتاً

1278
01:37:28,790 --> 01:37:32,110
،معنى هذا أنّ الموت سينفعه

1279
01:37:32,110 --> 01:37:33,930
ولهذا السّبب لا يجوز أن نقبل

1280
01:37:33,930 --> 01:37:35,540
!أتّفق معه

1281
01:37:35,540 --> 01:37:36,830
...لكن

1282
01:37:36,830 --> 01:37:38,590
!أقترح أن نقتله

1283
01:37:39,420 --> 01:37:44,220
ستبقى جائزة نوبّل بعيدة عن منالي
!إذا لم أستطع مغادرة هذا المكان

1284
01:37:44,220 --> 01:37:46,050
يجب أن تموت لأجل جائزة نوبّل خاصّتي

1285
01:37:46,050 --> 01:37:48,720
لا يستطيع الشّياطين البشر إنشاء عقد مع الشّياطين

1286
01:37:48,720 --> 01:37:52,760
حتّى لو قتلتِه، لن يكون الشّيطان مُلزَماً
بالسّماح لكِ بالخروج

1287
01:37:53,130 --> 01:37:56,960
لن نقتل دينجي. نحن صائدو شياطين

1288
01:37:57,790 --> 01:38:00,020
لا نقتل إلّا الشّياطين

1289
01:38:02,660 --> 01:38:04,380
هل نتصارع لتمضية الوقت إذاً؟

1290
01:38:04,380 --> 01:38:06,530
!كُلّ همّكِ هو قتلي! مُحال

1291
01:38:13,020 --> 01:38:14,470
...أنا جائع جدّاً

1292
01:38:14,470 --> 01:38:18,790
آكي، هل لديك أيّ خطّة لإخراجنا من هنا؟

1293
01:38:18,790 --> 01:38:23,170
إذا كان ما يقوله الشّيطان صحيحاً، لا يمكننا قتله

1294
01:38:23,170 --> 01:38:25,920
لكن لن نقتل دينجي أيضاً

1295
01:38:25,920 --> 01:38:29,130
إذاً هل الخطّة هي التضوّر جوعاً؟

1296
01:38:31,800 --> 01:38:33,970
إذا نفدت خياراتنا، سأستخدم السّيف

1297
01:38:33,970 --> 01:38:35,010
لن تفعل

1298
01:38:36,490 --> 01:38:39,140
،إذا كان استخدام سيفك كفيلاً بإخراجنا

1299
01:38:39,140 --> 01:38:40,610
أفلا ينبغي أن تستخدمه؟

1300
01:38:41,710 --> 01:38:44,650
لا ينبغي أن يستخدمه حتّى لو نفدت خياراتنا

1301
01:38:45,190 --> 01:38:47,010
،عند الشّدائد... آسفة

1302
01:38:47,530 --> 01:38:49,530
!لكن سيترتّب عليك أن تموت يا دينجي

1303
01:38:51,780 --> 01:38:53,530
!اختفى؟

1304
01:38:53,530 --> 01:38:56,530
...اختفى... كلّ الطعام الّذي كان على السّرير

1305
01:38:56,860 --> 01:38:58,290
لا أثر له

1306
01:38:58,810 --> 01:38:59,830
لماذا؟

1307
01:39:04,380 --> 01:39:07,350
أكلتِه كلّه، أليس كذلك؟

1308
01:39:07,350 --> 01:39:09,920
لم أكن أنا. دينجي من فعل ذلك

1309
01:39:09,920 --> 01:39:12,000
...يا لها من كذبة واضحة

1310
01:39:12,000 --> 01:39:13,430
...فهمتُ الآن

1311
01:39:13,430 --> 01:39:16,430
اكتشفتُ الأمر

1312
01:39:16,980 --> 01:39:21,040
!لا يمكننا الخروج من هنا بسبب قوّة هذه الشّيطانة البشريّة

1313
01:39:21,040 --> 01:39:22,810
!هذا مُؤكَّد

1314
01:39:22,810 --> 01:39:23,690
!كلّا

1315
01:39:23,690 --> 01:39:26,150
—هدّئي من روعكِ يا كوبيني! هذه شيطانة الدّماء البشريّة

1316
01:39:26,150 --> 01:39:30,780
!أتقِف في صفّها إذاً؟ رغم أنّنا صائدو شياطين؟

1317
01:39:30,780 --> 01:39:33,880
!أنت في صفِّ الشّيطان يا آراي

1318
01:39:33,880 --> 01:39:35,910
!أنت عميل

1319
01:39:35,910 --> 01:39:37,030
إنّه جميل

1320
01:39:37,030 --> 01:39:39,370
...لستُ... في صفّ الشّيطان

1321
01:39:40,260 --> 01:39:43,920
!أنا متأكّدة بأنّك عميل

1322
01:39:47,170 --> 01:39:48,250
هل كانت صرخة؟

1323
01:39:48,250 --> 01:39:49,720
!سينباي، لنتحرّك

1324
01:39:58,040 --> 01:39:59,680
...اقتلوا دينجي

1325
01:39:59,680 --> 01:40:03,380
!أعطوني قلبه... أعطوني إيّاه

1326
01:40:03,380 --> 01:40:08,510
!أنمو كلّما نما خوفكم... وفي خِضمِّ رُعبكم، سوف آسركم

1327
01:40:09,070 --> 01:40:12,320
!موتكم هو نتيجة محتومة

1328
01:40:12,320 --> 01:40:14,920
!لذا خافوني أكثر

1329
01:40:14,920 --> 01:40:16,890
!فليتملّككم موتكم الوشيك

1330
01:40:16,890 --> 01:40:19,210
خافوا كلّ شيء

1331
01:40:19,210 --> 01:40:22,700
...سأكون أنا من يقتل المنشار

1332
01:40:22,700 --> 01:40:24,540
!سيكون أنا

1333
01:40:24,540 --> 01:40:27,340
!شيطان الخلود

1334
01:40:33,210 --> 01:40:34,720
!الأرض تميل

1335
01:40:50,160 --> 01:40:53,620
!أعطوني قلب دينجي

1336
01:40:53,620 --> 01:40:56,990
!أحدكم، فليقتل أحدُكم دينجي

1337
01:40:56,990 --> 01:40:58,590
!اقتلوه أرجوكم

1338
01:40:58,590 --> 01:41:00,070
!الوقت يُداهمنا

1339
01:41:00,070 --> 01:41:02,290
!لنُطعمه للشيطان فحسب

1340
01:41:04,410 --> 01:41:05,750
سأستخدم السّيف

1341
01:41:05,750 --> 01:41:08,880
هل أنتِ موافقة على ذلك يا هيمينو سينـ...؟

1342
01:41:09,290 --> 01:41:10,710
!هيمينو سينباي؟

1343
01:41:11,500 --> 01:41:14,680
!أنتِ! ما خطبكِ؟

1344
01:41:14,680 --> 01:41:18,130
،لعلّنا نستطيع الخروج من هنا إذا استخدم ذلك السّيف

1345
01:41:18,480 --> 01:41:22,390
لكن بموجب بنود العقد، يستهلك استخدام
السّيف الكثير من السّنوات من عمر آكي

1346
01:41:22,870 --> 01:41:26,590
لديه الكثير ليعيش لأجله

1347
01:41:26,590 --> 01:41:28,860
أنا آسفة يا دينجي

1348
01:41:29,650 --> 01:41:31,400
!اللّعنة

1349
01:41:31,740 --> 01:41:33,270
!ابتعد

1350
01:41:33,270 --> 01:41:34,570
!أفلتني

1351
01:41:38,820 --> 01:41:41,050
!فلتمُت

1352
01:42:06,320 --> 01:42:12,490
...قد يكون قمامة يستحقّ أن يُطعَن مرّة أو مرّتين

1353
01:42:12,990 --> 01:42:15,550
لكنّه يريد قتل شيطان البُندُقيّة

1354
01:42:16,230 --> 01:42:20,210
وأنا... لا أستطيع قتله بمُفردي

1355
01:42:20,760 --> 01:42:25,960
كي أفعل ذلك، أحتاج لصائدي شياطين
لديهم الجرأة لمُقاتلته

1356
01:42:26,320 --> 01:42:28,440
...كلّما كنّا أكثر، كان أفضل

1357
01:42:29,420 --> 01:42:31,630
...حتّى لو كلّفني ذلك بعضاً من حياتي

1358
01:42:32,630 --> 01:42:35,250
لن أدع دينجي يموت

1359
01:42:36,650 --> 01:42:39,010
باور! أنتِ شيطانة الدّماء البشريّة، صحيح؟

1360
01:42:39,010 --> 01:42:41,510
هل يمكنكِ إيقاف نزيفه؟

1361
01:42:41,510 --> 01:42:45,210
لا سيطرة كاملة لديّ إلّا على دمائي

1362
01:42:45,210 --> 01:42:47,430
من الصّعب التحكّم بدماء الآخرين

1363
01:42:49,340 --> 01:42:53,690
لكن أظنّني سأكون بحاجة طبّاخ جديد
إذا مات ذو تسريحة القُنْزُعة

1364
01:42:53,690 --> 01:42:56,070
نظراً إلى ذلك، لا خيار لديّ

1365
01:43:01,760 --> 01:43:03,200
ماذا نفعل؟

1366
01:43:03,200 --> 01:43:04,780
!ماذا نفعل؟

1367
01:43:04,780 --> 01:43:08,240
!آكي... آكي! ماذا نفعل؟

1368
01:43:08,620 --> 01:43:11,410
!هـ-هذا ليس ذنبي

1369
01:43:11,410 --> 01:43:14,380
!أنت! أنت هو السّبب

1370
01:43:14,380 --> 01:43:18,600
!إذا سمحت له بأكلِك فحسب، فسينتهي الأمر برمّته

1371
01:43:19,610 --> 01:43:21,380
أجل، أجل، فهمت

1372
01:43:21,380 --> 01:43:23,750
أعتقد حان وقت الطعام إذاً

1373
01:43:24,280 --> 01:43:26,300
هذا مُطمئن

1374
01:43:27,150 --> 01:43:29,770
لكن لن أدعه يهضمني بسهولة

1375
01:43:30,480 --> 01:43:34,150
...لذا إذا تمكّنتُ من قتل هذا الشّيطان اللّعين

1376
01:43:34,500 --> 01:43:37,720
!ما زلتُ أتأمّل الحصول على تلك القُبلة

1377
01:43:38,650 --> 01:43:40,900
هل لديك أيّ خطّة للفوز؟

1378
01:43:41,270 --> 01:43:44,910
سوف أخرج مناشيري، رغم أنّ ذلك سيُؤلم كثيراً

1379
01:43:45,350 --> 01:43:47,100
مـ-مناشيرك؟

1380
01:43:47,100 --> 01:43:52,360
لا أعرف ما خطب هذا الشّيطان، لكنّه
خائف من مناشيري

1381
01:43:52,810 --> 01:43:57,280
لهذا لم يحاول قتلي، وأرادكم فعل ذلك بدلاً عنه

1382
01:43:58,310 --> 01:44:03,390
وأتذكّر بأنّه كان يبكي من الألم
...عندما تعرّضَ لهجوم

1383
01:44:04,070 --> 01:44:08,430
لذا ارتأيتُ بأنّني إذا مزّقتُه حتّى
،لا يعود قادراً على تحمّل الألم

1384
01:44:08,820 --> 01:44:10,950
!سيرغب في قتل نفسه

1385
01:44:12,970 --> 01:44:14,980
فكرة شيطانيّة بحتة بالفعل

1386
01:44:18,230 --> 01:44:20,980
لا أصدّق بأنّك فعلتَ ذلك لأجلي

1387
01:44:21,290 --> 01:44:24,140
لم يطلب أحدٌ منك ذلك أيُّها الوغد

1388
01:44:24,760 --> 01:44:29,090
سئمتُ من أن أكون مَديناً لأحد بشيء، مفهوم؟

1389
01:44:29,780 --> 01:44:32,390
!لذا حالما نخرج من هنا، سنكون قد تعادلنا

1390
01:44:43,210 --> 01:44:44,600
...انتهى الأمر

1391
01:44:58,040 --> 01:45:02,310
!عرفتُ بأنّك على قيد الحياة أيُّها المنشار

1392
01:45:06,160 --> 01:45:08,940
!يا للألم

1393
01:45:09,350 --> 01:45:11,470
!لقد عُدت

1394
01:45:12,170 --> 01:45:14,100
!لا جدوى أيُّها المنشار

1395
01:45:14,100 --> 01:45:15,120
!الألم

1396
01:45:15,120 --> 01:45:16,620
!هذا مؤلم

1397
01:45:16,620 --> 01:45:19,380
!لن تجد قلبي هنا

1398
01:45:19,380 --> 01:45:21,660
!لا يمكنك قتلي

1399
01:45:31,160 --> 01:45:32,140
!شيطان؟

1400
01:45:32,540 --> 01:45:34,140
هذا غير مُبشِّر

1401
01:45:34,620 --> 01:45:37,070
ينزف دينجي دماً باستمرار

1402
01:45:37,070 --> 01:45:40,520
إذا فقدَ كثيراً من الدّماء، ستنكفئ مناشيره

1403
01:45:46,150 --> 01:45:49,420
أنت أضعف بكثير الآن

1404
01:45:49,420 --> 01:45:51,990
!إلى أيّ درجة انحدرت يا منشار؟

1405
01:45:59,460 --> 01:46:01,580
!انكفأت مناشيري؟

1406
01:46:01,580 --> 01:46:03,460
!أحتاج مزيداً من الدّماء

1407
01:46:03,460 --> 01:46:05,180
!فشِلت

1408
01:46:05,180 --> 01:46:06,070
!فلتمُت

1409
01:46:06,070 --> 01:46:07,590
!يا منشار

1410
01:46:16,760 --> 01:46:19,810
...قد يكون مذاق هذا الدم كمياه المجارير

1411
01:46:19,810 --> 01:46:23,520
...لكن رؤيتك تتلوّع ألماً

1412
01:46:23,520 --> 01:46:27,230
!تجعله حُلواً كمُربّى الفراولة

1413
01:46:27,940 --> 01:46:30,860
الصّائدون الّذين يهابُهم الشّياطين

1414
01:46:34,620 --> 01:46:37,580
هم الصّائدون المجانين

1415
01:46:38,170 --> 01:46:40,830
...كان ساهارا سليم العقل

1416
01:46:41,680 --> 01:46:43,580
لذلك مات

1417
01:46:43,910 --> 01:46:49,220
ذاتُ الأمرِ ينطبق على كينويتشي وسوبارو
وساساكي. كلّهم سليمون

1418
01:46:49,220 --> 01:46:53,050
كانوا عقلانيّين بما يكفي للخوف
،من هجمات شيطان

1419
01:46:53,050 --> 01:46:55,970
وذلك الخوف هو ما جعلَ الشّياطين أقوى

1420
01:46:56,830 --> 01:47:00,450
.مضى على تعاونكِ مع آكي مدّة من الزمن
ما رأيكِ به؟

1421
01:47:01,410 --> 01:47:02,480
هل هو عاقل؟

1422
01:47:02,480 --> 01:47:07,470
أيّ شخص يسعى لقتل شيطان البُندُقيّة
هو حتماً شخص غير عاقل

1423
01:47:07,990 --> 01:47:12,240
ألم تنضمّي للأمن العامّ لأنّ هدفكِ
شيطان البُندُقيّة أيضاً؟

1424
01:47:12,750 --> 01:47:15,550
هل بكِ مسٌّ من الجنون؟

1425
01:47:16,460 --> 01:47:17,870
لا يا سيّدي

1426
01:47:18,180 --> 01:47:19,470
تماماً

1427
01:47:19,470 --> 01:47:25,380
مُعظم الصّائدين، وبمن فيهم أنتِ، تسعون
لإسقاط شيطان البُندُقيّة

1428
01:47:25,630 --> 01:47:28,460
إنّهم جادّون وصادقون وبُسطاء

1429
01:47:28,460 --> 01:47:32,630
وهذا يعني أنّ الشّياطين يعرفون تماماً
كيف يتلاعبون بهم

1430
01:47:33,080 --> 01:47:37,890
لكن لا يستطيع أحد معرِفة ما يفكّر فيه شخصٌ مجنون

1431
01:47:38,150 --> 01:47:41,580
وحتّى الشّياطين يخشون ما لا يفهمونه

1432
01:47:44,200 --> 01:47:46,520
أنت تسرِف في الشّرب ثانية يا مُعلّم

1433
01:47:46,520 --> 01:47:48,630
رأيتِ؟ ردّ عقلانيّ من جديد

1434
01:47:48,630 --> 01:47:51,550
لا يمكن أن تكوني مُختلّة دون فعل ذلك رويداً رويداً

1435
01:47:57,300 --> 01:48:00,340
وإذا كنتِ لا تزالين تزورين قبور
،شركائكِ في كلّ شهر

1436
01:48:00,340 --> 01:48:01,820
فهذا يعني أنّ عقلكِ ما زال مُتماسكاً

1437
01:48:03,100 --> 01:48:04,530
سأعود للمنزل

1438
01:48:04,530 --> 01:48:07,790
لا يزال آكي غِرّاً، لذا احرصي على تمرينه جيّداً

1439
01:48:08,410 --> 01:48:10,170
سأستغرق وقتي في الأمر

1440
01:48:10,860 --> 01:48:12,910
لا يمكنكِ ذلك

1441
01:48:12,910 --> 01:48:16,670
الفتى جادّ بشأن جمع القِطع اللّحميّة، صحيح؟

1442
01:48:16,670 --> 01:48:19,810
سوف يجِد شيطانَ البُندُقيّة إذا فعل

1443
01:48:35,210 --> 01:48:36,200
...لا

1444
01:48:36,480 --> 01:48:39,530
—لا، لا، لا، لا، لا

1445
01:48:41,280 --> 01:48:42,540
لا

1446
01:48:43,130 --> 01:48:47,600
آكي، أتريد الالتحاق بالقطّاع الخاص معي؟

1447
01:48:48,460 --> 01:48:51,110
!تلقّيتُ عرضاً سخيّاً جدّاً

1448
01:48:51,110 --> 01:48:54,570
أن يكون المرء صائداً خاصّاً يعني أن يتعامل
مع شياطين أقلّ خطورة

1449
01:48:54,960 --> 01:48:57,320
،بدلاً من مُطاردة البُندُقيّة

1450
01:48:57,320 --> 01:49:01,810
بوسعنا الخروج لتناول الغداء ومشاهدة
،الأفلام في طريق العودة إلى المنزل

1451
01:49:02,200 --> 01:49:04,190
وقضاء أوقات ممتعة

1452
01:49:05,390 --> 01:49:07,940
إذا أردتِ الخروج لنشرب معاً، فلا مانع لديّ

1453
01:49:07,940 --> 01:49:10,940
لكن لا أنوي الالتحاق بالقطّاع الخاص

1454
01:49:11,410 --> 01:49:13,200
وسآخذ التّوفو باللّوز خاصّتكِ

1455
01:49:14,470 --> 01:49:17,120
إذاً أعطِني سيجارة بالمقابل

1456
01:49:24,420 --> 01:49:28,750
إذا قاتلَ آكي شيطانَ البُندُقيّة، سيموت

1457
01:49:29,660 --> 01:49:32,590
،ليس لأنّنا ضُعفاء جدّاً

1458
01:49:32,590 --> 01:49:36,190
ولا لأنّه من الشّياطين الّذين يستطيعون
قتل المئات في غضون ثوانٍ

1459
01:49:37,190 --> 01:49:42,120
...بل لأنّ آكي هادئ وجادّ ولطيف

1460
01:49:42,910 --> 01:49:45,240
وعاديّ كمُعظم النّاس

1461
01:49:46,510 --> 01:49:47,520
...لكن

1462
01:49:49,360 --> 01:49:50,860
!خذ هذه

1463
01:49:52,090 --> 01:49:54,560
!مؤلم

1464
01:49:59,120 --> 01:50:00,510
...انتهى

1465
01:50:00,510 --> 01:50:02,130
انتهى الأمر

1466
01:50:06,800 --> 01:50:08,210
لكن هو؟

1467
01:50:08,880 --> 01:50:11,140
وجدتُها يا صاح

1468
01:50:11,140 --> 01:50:14,480
أُقطِّعك فتنزُف

1469
01:50:14,480 --> 01:50:17,840
!أشربُ دمَك فأُشْفَى

1470
01:50:17,840 --> 01:50:22,010
!أنا آلة لعينة دائمة الحركة

1471
01:50:22,880 --> 01:50:26,630
!جائزة النوبل مُلكي

1472
01:50:27,840 --> 01:50:30,850
،لم أرَ شخصاً أكثر جنوناً منه

1473
01:50:31,330 --> 01:50:33,860
!لذا لعلّه يستطيع قتل شيطان البُندُقيّة

1474
01:50:46,300 --> 01:50:48,060
...ألم

1475
01:50:53,130 --> 01:50:55,130
...مؤلم

1476
01:50:55,130 --> 01:50:57,130
...هذا مؤلم

1477
01:51:00,270 --> 01:51:02,950
أما زلت حيّاً يا آكي؟

1478
01:51:05,890 --> 01:51:07,230
...كم مضى

1479
01:51:07,850 --> 01:51:09,890
كم مضى من وقت؟

1480
01:51:10,450 --> 01:51:14,020
مضى حوالي ثلاثة أيّام منذ طُعِنتَ على ما أعتقد؟

1481
01:51:14,620 --> 01:51:16,270
...نياكو

1482
01:51:16,610 --> 01:51:19,800
لنخرج جميعاً ونتشارك الشّرب

1483
01:51:20,410 --> 01:51:24,030
بما أنّ الأمر انتهى... سأنام قليلاً

1484
01:51:25,210 --> 01:51:26,680
انتهى الأمر؟

1485
01:51:28,620 --> 01:51:31,290
...هذا هو نقطة ضعفي

1486
01:51:31,290 --> 01:51:32,610
إنّه قلبي

1487
01:51:32,610 --> 01:51:34,310
اقتلني أرجوك. أنا آسف

1488
01:51:34,310 --> 01:51:35,120
أعتذر

1489
01:51:35,120 --> 01:51:36,420
...هذا مؤلم

1490
01:51:36,690 --> 01:51:38,970
!ماذا؟ من الآن؟

1491
01:51:38,970 --> 01:51:43,430
!كنتُ لا أزال أستمتع! كما لو أنّني في مسبح

1492
01:51:51,040 --> 01:51:52,560
خرجنا

1493
01:51:55,700 --> 01:51:59,610
،حصلتُ على قطعة من لحم شيطان البُندُقيّة
...السّماء صافية

1494
01:51:59,610 --> 01:52:02,080
وأشعر بالرّاحة، كما لو أنّني تبرّزتُ بِرازاً كبيراً للتو

1495
01:52:02,450 --> 01:52:04,750
...وكأنّني أعوم

1496
01:52:06,630 --> 01:52:07,650
مهلك

1497
01:52:09,440 --> 01:52:10,750
...غطَّ في النّوم

1498
01:52:11,450 --> 01:52:14,500
لا عجَب، نظراً إلى أنّه كان يقاتل
الشّيطان طوال الوقت بلا نوم

1499
01:52:16,320 --> 01:52:19,750
سوف ننقل آكي ودينجي إلى مشفى

1500
01:52:20,090 --> 01:52:23,280
عودا إلى المكتب وسلّما تقريركما

1501
01:52:30,840 --> 01:52:32,770
حفلة ترحيب؟

1502
01:52:32,770 --> 01:52:33,790
أجل

1503
01:52:33,790 --> 01:52:36,640
،بما أنّ الفرع 4 قد اكتمل أخيراً

1504
01:52:36,640 --> 01:52:38,410
،علينا أن نتعرّف على بعضنا بشكل أفضل

1505
01:52:38,410 --> 01:52:41,550
ونعالج بعض مشاكلنا العالِقة

1506
01:52:41,550 --> 01:52:42,690
أيّ مشاكل؟

1507
01:52:42,690 --> 01:52:48,120
في الحقيقة، كوبيني وآراي يفكّران
في مغادرة الأمن العامّ

1508
01:52:48,120 --> 01:52:51,270
أعتقد ما حدث بخصوص الشّيطان السّابق
سبّب لهما صدمة نفسيّة

1509
01:52:51,910 --> 01:52:54,640
،ليس لأنّهما يخشيان الشّياطين فحسب

1510
01:52:54,640 --> 01:52:57,420
بل لأنّهما يشعران بتأنيب الضّمير
بشأن مُحاولتهما قتل دينجي أيضاً

1511
01:52:58,240 --> 01:53:00,800
ألم تحاولي قتله أيضاً يا هيمينو سينباي؟

1512
01:53:00,800 --> 01:53:02,020
حقّاً؟

1513
01:53:02,020 --> 01:53:05,300
يا لِصغار هذا الجيل! حسّاسون جدّاً

1514
01:53:05,300 --> 01:53:08,300
هل سيضرّهم أن يكونوا أكثر جرأة؟

1515
01:53:09,040 --> 01:53:12,440
على مائدة مشروب، سيتمكّنان
،من الاعتذار من دينجي بسهولة

1516
01:53:12,440 --> 01:53:14,730
وسنتمكّن من إقناعهما بعدم الاستقالة

1517
01:53:14,730 --> 01:53:16,350
كلّ همّكِ هو الشّرب

1518
01:53:18,560 --> 01:53:20,920
وجدتُ قطعة من لحمِه رغم أنّها صغيرة

1519
01:53:21,710 --> 01:53:24,250
إذا أردنا فعل شيء، فيجب أن يكون في هذا الأسبوع

1520
01:53:24,250 --> 01:53:25,950
لماذا؟

1521
01:53:25,950 --> 01:53:29,280
إذا كنّا سنُقيم حفلة شرب، فأريد
أن أستدعي الآنسة ماكيما

1522
01:53:36,340 --> 01:53:39,060
ستذهب في رحلة عمل إلى كيوتو الأسبوع المقبل

1523
01:53:39,060 --> 01:53:43,250
بوجود عدد كبير من الشّياطين الّذين يستهدفون
دينجي، تسعى للحصول على تعزيزات

1524
01:53:43,250 --> 01:53:45,450
لذا يجب أن تُقام الحفلة في هذا الأسبوع

1525
01:53:48,350 --> 01:53:49,760
كُن صادقاً معي

1526
01:53:50,080 --> 01:53:52,380
مَن يكون دينجي؟

1527
01:53:54,140 --> 01:53:57,750
،بدا ذلك الشّيطان يعرفه

1528
01:53:57,750 --> 01:53:59,900
لكن الشّكل الّذي تحوّلَ إليه لم يسبق
أن رأيتُ مثيلاً له

1529
01:53:59,900 --> 01:54:04,650
واللّغز الأكبر هو مدى اهتمام الآنسة ماكيما به

1530
01:54:06,400 --> 01:54:10,480
كانت تسافر طوال الوقت، لكنّها
،بقيَتْ في طوكيو مؤخّراً

1531
01:54:10,480 --> 01:54:12,470
والسّبب غالباً هو دينجي

1532
01:54:13,050 --> 01:54:16,040
هل تعرف سِرَّه يا تُرى؟

1533
01:54:20,090 --> 01:54:22,920
ما رأيك أن ندفعها للثّمالة ونسألها عن ذلك؟

1534
01:55:56,240 --> 01:55:58,320
أيّام رجل المنشار

1535
01:56:07,850 --> 01:56:09,940
يا صاح، لا ترمِ قشور التّفّاح

1536
01:56:09,940 --> 01:56:11,800
إنّها صالحة للأكل

1537
01:56:16,650 --> 01:56:19,080
،إن كنت لن تأكل قشرة البرتقال
فأعطني إيّاها

1538
01:56:19,080 --> 01:56:20,380
سوف آكلها

1539
01:56:25,240 --> 01:56:27,080
أعطني قشرة الجرح

1540
01:56:27,080 --> 01:56:28,620
سآكلها

1541
01:56:30,120 --> 01:56:31,840
ليس هذه المرّة

1542
01:56:31,840 --> 01:56:34,180
!لِمَ لأ؟ إنّها مُغذّية

1543
01:56:34,530 --> 01:56:37,090
أيّ حياة عشتها بالضّبط؟

1544
01:56:39,520 --> 01:56:42,480
دينجي ووصفتي الرّئيسيّة

1545
01:56:42,850 --> 01:56:45,840
الخطوة 1: نشتري بعض الطّحين

1546
01:56:52,860 --> 01:56:56,380
الخطوة 2: نحضر ماء ونخلطه مع الطّحين

1547
01:57:05,280 --> 01:57:08,390
(الخطوة 3: نأكله (طريقة الحساء

1548
01:57:09,960 --> 01:57:11,760
...لكن اليوم

1549
01:57:16,490 --> 01:57:19,040
...لأنّه عيد الكريسماس

1550
01:57:29,120 --> 01:57:30,690
!جاهز

1551
01:57:31,650 --> 01:57:37,130
الخطوة 4: لأنّه عيد الكريسماس، نضيف
(بعض السّكّر قبل الأكل (طريقة الحساء

1552
01:57:37,130 --> 01:57:40,640
!لذيذ للغاية! مذاقه كالكعك

1553
01:57:43,200 --> 01:57:46,560
لم يتناول أحدُنا كعكاً من قبل

1554
01:57:50,000 --> 01:57:51,960
نكهة ناضجة

1555
01:57:53,230 --> 01:57:55,170
القهوة هنا لذيذة

1556
01:57:58,110 --> 01:58:00,110
!لم أحتسِ قهوة من قبل

1557
01:58:01,430 --> 01:58:03,560
!يا صاح، هذا ماء وحليّ

1558
01:58:04,260 --> 01:58:08,010
كم هذا مُثير للشّفقة. مذاق مُعقّد
جدّاً بالنّسبة لطفل

1559
01:58:09,640 --> 01:58:10,920
!وحل

1560
01:58:13,300 --> 01:58:15,470
!لساني يلدعني

1561
01:58:15,470 --> 01:58:17,030
!ما هذا يا صاح؟

1562
01:58:17,030 --> 01:58:19,520
!اصمتا! نحن في مطعم، اهدآ

1563
01:58:19,520 --> 01:58:22,090
!أيّ مزحة مُقرفة هي هذه؟

1564
01:58:22,090 --> 01:58:23,200
!كان طيناً

1565
01:58:23,200 --> 01:58:24,960
!شراباً طينيّاً ما

1566
01:58:27,110 --> 01:58:28,670
القُنزعة

1567
01:58:30,360 --> 01:58:34,340
إذاً، هل هناك سبب وراء تسريحة
الشّعر الغريبة؟

1568
01:58:34,650 --> 01:58:39,090
اتّفاقي مع الثّعلب هو أنّها تطلب
طلبات غير الجلد أحياناً

1569
01:58:39,090 --> 01:58:42,110
وعندما أعطيها القُنزعة، يبدو
أنّها تستمتع بذلك

1570
01:58:44,030 --> 01:58:47,610
!يبدو هذا مناسباً لي! أريد واحدة أيضاً

1571
01:58:47,610 --> 01:58:48,610
لا

1572
01:58:48,610 --> 01:58:50,160
بخيل

1573
01:58:52,720 --> 01:58:55,110
نتناول مشروباً في منزلها
مرّة في الأسبوع تقريباً

1574
01:59:13,900 --> 01:59:16,160
!كنتُ أنا من فعل ذلك وأنا ثملة

1575
01:59:16,160 --> 01:59:18,650
لذا أنا أطلب التّسامح وأنا صاحية

1576
01:59:18,650 --> 01:59:21,210
بربّك. من فضلك يا آكي

