1
00:00:04,760 --> 00:00:06,930
!صوت الانفجار من داخل البرج

2
00:00:06,930 --> 00:00:08,740
...الوحيدون القادرون على ذلك هُم

3
00:00:09,740 --> 00:00:13,240
...أولئك الوحوش العجيبون المُثيرون للسّخط

4
00:00:13,620 --> 00:00:15,270
!الماجيا فيندر

5
00:00:31,010 --> 00:00:35,720
الحلقة 24
قصّة حلم بلا نهاية

6
00:01:50,010 --> 00:01:52,120
نـ-نحن على قيد الحياة

7
00:01:52,120 --> 00:01:54,260
ظننتُ بأنّنا سنموت

8
00:01:54,260 --> 00:01:55,510
!إيلفي

9
00:02:02,660 --> 00:02:04,310
تعادُل إذاً؟

10
00:02:04,660 --> 00:02:07,060
!أعتقد بأنّكِ تستطيعين القتال يا فتاة

11
00:02:07,060 --> 00:02:09,440
!أوجّه نفس الكلام لك

12
00:02:09,440 --> 00:02:12,940
استهلكَ ذلك كُلّ طاقتي السّحريّة

13
00:02:12,940 --> 00:02:16,070
لكن ما زلتِ جاهزة للقتال، صحيح؟

14
00:02:16,070 --> 00:02:17,320
بالطّبع

15
00:02:18,700 --> 00:02:20,450
!لنفعل هذا إذاً

16
00:02:20,720 --> 00:02:22,580
!لن أخسر أمامك

17
00:02:32,210 --> 00:02:33,720
هذا يكفي

18
00:02:37,220 --> 00:02:38,960
!من فضلك، أفسحي لي يا إيلينور

19
00:02:38,960 --> 00:02:41,140
وقتكِ المُخصّص قد انتهى أيّتها الحمقاء

20
00:02:41,140 --> 00:02:44,230
لكان من الأنسب لو قتلتُما بعضكما الآخر بالخطأ

21
00:02:44,230 --> 00:02:46,230
!اغرب عن وجهي أيُّها البغيض

22
00:02:46,230 --> 00:02:48,180
،كنتُ لطيفاً بما يكفي للوقوف والمُراقبة

23
00:02:48,180 --> 00:02:51,910
لكن لم تستطيعا حسم الأمر، لذا
أنت المُلام يا زيو

24
00:02:51,910 --> 00:02:52,660
...فضلاً عن ذلك

25
00:02:52,660 --> 00:02:53,490
ماذا؟

26
00:02:53,490 --> 00:02:57,370
عندما يتكلّم الحاكم، حتّى أنت
يجب أن تصغي

27
00:03:02,580 --> 00:03:04,500
الماجيا فيندر ماستيرياس نوه
أحد العصيّ الخمسة الأسمى، عصا حاكم الضّوء السّحريّة
آرون ماستيرياس أولدكينغ

28
00:03:02,620 --> 00:03:04,120
توقّفا

29
00:03:08,150 --> 00:03:13,130
لن أسمح بمزيد من القتال بين اثنين
من الماجيا فيندر

30
00:03:13,130 --> 00:03:15,010
!لا تتدخّل أيُّها العجوز

31
00:03:19,300 --> 00:03:23,350
ولا توجد وسيلةٌ أُخرى لتحديد هذا
!سِوى بالقتال، صحيح؟

32
00:03:38,260 --> 00:03:40,030
حجر، ورقة، مقصّ

33
00:03:41,370 --> 00:03:43,240
حجر، ورقة، مقصّ؟

34
00:03:48,340 --> 00:03:51,460
،إذا لجأتُما لأيّ وسيلة أُخرى

35
00:03:51,460 --> 00:03:55,510
فسأضع ويل سيرفورت تحت جناحي

36
00:03:56,330 --> 00:03:58,760
...في البداية حجر

37
00:03:59,120 --> 00:03:59,760
حقّاً؟

38
00:03:59,760 --> 00:04:01,260
اللّعنة

39
00:04:01,970 --> 00:04:03,760
!هيّا نفعلها

40
00:04:03,760 --> 00:04:05,640
!سوف أربح

41
00:04:06,090 --> 00:04:08,610
!حجر، ورقة، مقصّ

42
00:04:08,610 --> 00:04:15,050
!من جديد، لكسر التّعادُل

43
00:04:15,050 --> 00:04:19,180
يوليوس؟ بجدّية، ماذا حدث هنا؟

44
00:04:15,050 --> 00:04:23,160
!من جديد لكسر التّعادُل

45
00:04:19,180 --> 00:04:23,160
إذا عدنا إلى البداية، أنت السّبب
الرّئيسيّ لكلّ هذا

46
00:04:23,160 --> 00:04:43,690
!من جديد، لكسر التّعادُل

47
00:04:40,680 --> 00:04:42,050
‏299 مُحاولة، 299 تعادُل

48
00:04:44,890 --> 00:04:48,350
‏300 مُحاولة، 299 تعادُل

49
00:04:51,350 --> 00:04:53,490
!رائع

50
00:04:53,490 --> 00:04:55,360
!صفِّقي له يا أوينزوس

51
00:04:55,360 --> 00:04:56,660
حسناً

52
00:04:57,150 --> 00:04:59,110
زيو يربح بحجر

53
00:04:59,110 --> 00:05:00,830
...إ-إيلفي

54
00:05:01,750 --> 00:05:05,880
والآن أنت تنتمي لي! ولا يحقّ
!لك أن تشتكي

55
00:05:05,880 --> 00:05:07,010
ماذا؟

56
00:05:07,010 --> 00:05:10,250
!لا! أكره هذا! أكرهه، أكرهه، أكرهه

57
00:05:10,250 --> 00:05:12,980
!سأبقى مع ويل

58
00:05:14,170 --> 00:05:18,100
!ويل! لا أريد هذا

59
00:05:18,100 --> 00:05:24,050
هذا صحيح. كان قد ترتّبَ على إيلفي
تَركي وصعود البرج بمُفردها

60
00:05:24,050 --> 00:05:26,390
...انتظرَتْني ستّ سنوات، والآن

61
00:05:26,390 --> 00:05:29,300
!أكره هذا! لا

62
00:05:26,920 --> 00:05:30,520
الحقيقة هي أنّني أريد البقاء
...معها أيضاً، لكن

63
00:05:31,900 --> 00:05:32,770
لا عليكِ

64
00:05:34,020 --> 00:05:35,420
سنرى بعضنا الآخر ثانية

65
00:05:35,840 --> 00:05:37,930
لا، سآتي لرؤيتكِ

66
00:05:39,510 --> 00:05:41,080
...ويل

67
00:05:41,080 --> 00:05:43,410
هيّا. سنذهب

68
00:05:43,410 --> 00:05:45,300
بأمر من آرون-ساما

69
00:05:47,660 --> 00:05:49,270
!ماذا؟ لحظة! لا أستطيع

70
00:05:49,170 --> 00:05:54,320
من فضلكِ لا تُحرجي نفسكِ أكثر
!من ذلك يا إيلفاريا-ساما

71
00:05:49,270 --> 00:05:50,810
!لا أستطيع فعل هذا! لا يمكنني، لا يمكنني

72
00:05:50,810 --> 00:05:53,080
!لا! أكره هذا! لا

73
00:05:53,080 --> 00:05:55,170
!أفلتيني! ويل

74
00:05:55,170 --> 00:05:59,420
!ويل

75
00:06:01,400 --> 00:06:03,640
يبدو أنّك تفهم كيف تسير الأمور

76
00:06:03,640 --> 00:06:06,140
ظننتُك ستهيج كحيوان جامح

77
00:06:07,090 --> 00:06:12,100
إذا قلتُ أيّ كلام أنانيّ، فإيلفي
سوف تُقاتل وتتأذّى من جديد

78
00:06:12,790 --> 00:06:13,770
...لهذا السّبب

79
00:06:14,450 --> 00:06:16,580
هلّا وعدتني بشيء؟

80
00:06:16,580 --> 00:06:19,020
عِدني ألّا تُقاتل إيلفي بعد الآن

81
00:06:19,600 --> 00:06:25,780
إن لم تعدني بذلك، فسأهزمك
!وأُسارع إليها

82
00:06:33,940 --> 00:06:37,290
يروقني عزمك هذا! هذا هو أسلوبي فحسب

83
00:06:51,220 --> 00:06:54,450
ابتداء من اليوم، أنت جزء من فصيل البرق

84
00:07:04,360 --> 00:07:07,950
!أنا لا أرحم. من الأفضل أن تُحضّر نفسك

85
00:07:09,120 --> 00:07:09,910
!حاضر

86
00:07:21,660 --> 00:07:25,260
...والآن، نحن من الصفّ 401، الجيل الرّهيب

87
00:07:25,260 --> 00:07:29,510
!ضُمِمنا جميعاً إلى جماعات! تهانينا

88
00:07:25,510 --> 00:07:29,510
منزل كليري
القاعدة السّرّية للسّاحرات الوحيدات

89
00:07:29,510 --> 00:07:35,020
!بصحّتكم

90
00:07:35,990 --> 00:07:40,150
مهلاً! هل تحسبون أنّه من المُلائم
اللّهو هكذا في البرج؟

91
00:07:40,150 --> 00:07:41,970
وما الضّير من ذلك يا إيما؟

92
00:07:41,970 --> 00:07:45,850
أخبرونا بأنّنا أحرار بفعل ما نشاء
حتّى تبدأ جلسة توجيهنا غداً

93
00:07:45,850 --> 00:07:48,730
كُلّنا في جماعات مُختلفة الآن

94
00:07:48,730 --> 00:07:50,720
لا يجوز أن نحتفل مع مُنافسين

95
00:07:50,720 --> 00:07:54,040
مهلاً، مهلاً يا آنسة إيما، يا عزيزتي
...التّلميذة النّموذجيّة

96
00:07:54,040 --> 00:08:00,250
أنتِ في الواقع سعيدة جدّاً لدرجة أنّكِ
تكادين تنفجرين بهجةً، أليس كذلك؟

97
00:08:00,830 --> 00:08:01,710
...أنا

98
00:08:01,710 --> 00:08:03,230
!أطير فرحاً

99
00:08:03,230 --> 00:08:05,130
تريدين أن يُحتفَل بكِ، صحيح؟

100
00:08:05,130 --> 00:08:07,080
!أريد أن يُحتفَل بي

101
00:08:07,080 --> 00:08:08,260
!إذاً حان وقت الاحتفال

102
00:08:08,260 --> 00:08:14,260
والآن، بصحّة الشّخص الّذي جرّنا نحن
!البقايا معه! بصحّة إيما! نخب آخر

103
00:08:14,260 --> 00:08:15,640
...استعداد، هيّا

104
00:08:15,640 --> 00:08:20,270
!بصحّتكم

105
00:08:32,470 --> 00:08:33,560
ليهانا؟

106
00:08:33,560 --> 00:08:34,540
هل أنتِ بخير؟

107
00:08:36,430 --> 00:08:39,700
...أعتذر. إعياء الأيّام القليلة الماضية قد

108
00:08:40,500 --> 00:08:45,300
ويل، ستفهم قريباً الآن بعد أن
انضممت لفصيل البرق

109
00:08:45,660 --> 00:08:49,360
أصبتِني بفضول كبير، إن لم يكن بالخوف

110
00:08:49,360 --> 00:08:50,300
أتريدين أن تأكلي؟

111
00:08:51,200 --> 00:08:52,460
أجل

112
00:08:56,930 --> 00:09:00,680
كُلّ شيء في حالة فوضى لأنّك
انضممت لفصيل البرق

113
00:09:00,680 --> 00:09:01,310
ماذا؟

114
00:09:01,860 --> 00:09:04,780
ظلّتْ إيلفاريا-ساما تبكي، وعندما
،حاولتُ مُواساتها

115
00:09:04,780 --> 00:09:08,820
"!صرختْ قائلة، "اعتزلتُ كُلّ شيء
!ثمّ حاولت الهرب

116
00:09:08,820 --> 00:09:13,070
بعد ترك الأمور على عاتقنا جميعاً
—لإيقاف إيلفاريا-ساما، أراك

117
00:09:13,070 --> 00:09:15,420
!أ-أنا آسف حقّاً

118
00:09:19,830 --> 00:09:21,200
نسيت هذه

119
00:09:21,200 --> 00:09:22,330
خذها معك

120
00:09:23,040 --> 00:09:24,790
!شكراً لك يا يوليوس

121
00:09:24,790 --> 00:09:26,090
!مهلاً

122
00:09:26,090 --> 00:09:28,990
هل تنسجمان معاً بشكل أفضل
حتّى من السّابق؟

123
00:09:28,990 --> 00:09:31,750
كوليت، لماذا أنتِ غاضبة؟

124
00:09:31,750 --> 00:09:34,090
لـ-لستُ غاضبة

125
00:09:34,480 --> 00:09:36,790
كوليت تشعر بالغيرة

126
00:09:36,790 --> 00:09:41,100
،شكّلتُما رابطاً متيناً في غفلة منها
لذا هي تغار من يوليوس

127
00:09:41,100 --> 00:09:42,220
!و-ويغنال

128
00:09:42,220 --> 00:09:44,650
!لم أشكّل أيّ رابط

129
00:09:44,960 --> 00:09:48,900
لا أنوي الانضمام للعبة الأصدقاء
خاصّتك، مفهوم؟

130
00:09:48,900 --> 00:09:51,650
!ماذا تقصد بـ"لعبة الأصدقاء"؟

131
00:09:51,650 --> 00:09:54,030
بئس الأمر. لا يتفوّه إلّا بكلام قاسٍ

132
00:09:54,030 --> 00:09:58,660
لكن أظنّني بدأتُ أفهم طبيعة لطفه
بشكل أفضل قليلاً

133
00:09:58,660 --> 00:10:00,310
!يا حافظ الكُتُب

134
00:10:00,310 --> 00:10:01,790
!كنّا نبحث عنك

135
00:10:02,250 --> 00:10:05,550
ينبغي أن تخرج إلى هنا. أنت جزء من نادي
العودة الخاصّ بنا، أليس كذلك؟

136
00:10:05,550 --> 00:10:07,670
...ماذا؟ المعذرة

137
00:10:07,670 --> 00:10:09,170
ينبغي أن تذهب

138
00:10:09,170 --> 00:10:11,420
فأنت تستحقّ حفاوةً أكبر بكثير ممّا تتلقّاه

139
00:10:12,270 --> 00:10:13,580
شكراً لك

140
00:10:13,580 --> 00:10:14,680
!سأعود

141
00:10:16,420 --> 00:10:18,660
الجميع يريدون التحدُّث معك

142
00:10:18,660 --> 00:10:19,430
ماذا؟

143
00:10:19,430 --> 00:10:21,180
...كيف بالضّبط

144
00:10:24,200 --> 00:10:27,200
كما قالت إيما تماماً

145
00:10:27,200 --> 00:10:29,940
لا أستطيع احتكار ويل لنفسي بعد الآن

146
00:10:30,910 --> 00:10:32,340
كوليت؟

147
00:10:32,340 --> 00:10:34,410
أشعر بالوحدة فحسب

148
00:10:34,830 --> 00:10:38,410
لم أعُد صديقته الوحيدة

149
00:10:39,540 --> 00:10:42,300
أنا أنانيّة... ومُزعجة

150
00:10:42,770 --> 00:10:45,170
لم أتغيّر إطلاقاً عمّا كنتُ في السّابق

151
00:10:46,000 --> 00:10:48,140
لن تكسبي شيئاً من التّقليل من شأنكِ

152
00:10:49,210 --> 00:10:51,610
قرّرتُ التوقُّف عن الانتظار

153
00:10:51,610 --> 00:10:53,090
...ويغنال

154
00:10:53,090 --> 00:10:55,590
لا أقصد بأنّني استسلمت

155
00:10:55,590 --> 00:11:00,010
سأسخّر قوّتي للاقتراب من الشّخص
الّذي أسعى له

156
00:11:00,800 --> 00:11:02,450
ويل علّمَني ذلك

157
00:11:03,490 --> 00:11:06,230
...جبان يخشى الهرب

158
00:11:06,920 --> 00:11:10,110
يُدعى هذا شجاعة، أليس كذلك يا كوليت؟

159
00:11:12,200 --> 00:11:16,500
...أنا امرأة أنانيّة ومُزعجة

160
00:11:19,330 --> 00:11:21,870
!لكن أريد أن أخبر ويل بشيء

161
00:11:21,870 --> 00:11:23,660
ينبغي أن تذهبي إذاً

162
00:11:25,390 --> 00:11:26,380
حسناً

163
00:11:37,220 --> 00:11:39,990
هل ينبغي أن نُساعدها؟

164
00:11:39,990 --> 00:11:41,910
لنُراقبها فترة أطول

165
00:11:48,090 --> 00:11:49,860
لماذا تبدو مُكتئباً؟

166
00:11:50,810 --> 00:11:54,080
هل أنت وحيد الآن لدرجة أنّه
ليس لديك مَن تتنمّر عليه؟

167
00:11:54,780 --> 00:11:57,430
أنت أولستير عنيد وحقود

168
00:11:57,430 --> 00:12:00,510
الحقيقة هي أنّك تريد أن تضطهده أكثر، صحيح؟

169
00:12:05,440 --> 00:12:08,370
لم يعد هناك حاجة لذلك

170
00:12:09,120 --> 00:12:10,380
لم يعد مُثيراً للشّفقة

171
00:12:10,960 --> 00:12:14,420
إنّه مُثير للغيظ، لكن لا يستفزّني
النّظر إليه في الوضع الرّاهن

172
00:12:15,130 --> 00:12:17,210
لم أتوقّع أن يأتي هذا اليوم أبداً

173
00:12:17,980 --> 00:12:18,760
!شيون

174
00:12:19,410 --> 00:12:21,440
،لم تدعني أقول ذلك من قبل

175
00:12:21,440 --> 00:12:23,770
،لكن بخصوص تيرمينيليا، مراسم التخرُّج

176
00:12:23,770 --> 00:12:25,220
!وأشياء كثيرة أُخرى... شكراً لك

177
00:12:27,330 --> 00:12:28,970
...لذا، في الواقع

178
00:12:28,970 --> 00:12:31,810
هل تسمح لي بالصّعود إليك؟

179
00:12:31,810 --> 00:12:32,900
ما الغاية؟

180
00:12:32,900 --> 00:12:36,650
ماذا؟ في الحقيقة... لأشكرك؟

181
00:12:36,650 --> 00:12:37,530
...في هذه الحالة

182
00:12:37,970 --> 00:12:39,780
قاتلني

183
00:12:39,780 --> 00:12:41,030
ماذا؟

184
00:12:46,040 --> 00:12:49,040
،إنّها الإيماءة المثاليّة البديلة عن الشّكر
أليس كذلك؟

185
00:12:49,040 --> 00:12:50,240
فكرة سديدة

186
00:12:50,240 --> 00:12:51,670
!دعني أنضمّ

187
00:12:55,600 --> 00:12:58,000
بهذا، سأُسامحك على ما أنت
مَدين لي به مُقابل تدريبك

188
00:12:58,000 --> 00:12:59,300
!ماذا؟ لحظة

189
00:13:00,830 --> 00:13:03,550
هيّا. اذهبي الآن يا كوليت لوير

190
00:13:04,700 --> 00:13:05,550
!حسناً

191
00:13:06,440 --> 00:13:07,440
!ويل

192
00:13:08,060 --> 00:13:09,680
!أريد أن أُخبرك بشيء

193
00:13:09,680 --> 00:13:11,810
!هيّا

194
00:13:11,810 --> 00:13:12,560
ماذا؟

195
00:13:21,570 --> 00:13:24,030
ألن تذهبي يا آيريس؟

196
00:13:24,470 --> 00:13:27,540
حتّى لو فعلت، هذا سيُربك الجميع فحسب

197
00:13:27,540 --> 00:13:32,540
فضلاً عن ذلك، سيكشف هويّتي
الحقيقيّة لويل

198
00:13:32,540 --> 00:13:36,170
المُراقبون سرّيون دوماً، أليس كذلك؟

199
00:13:37,140 --> 00:13:39,670
لكن أعتقد بأنّ هذا تصرّف خاطئ

200
00:13:40,700 --> 00:13:43,380
إذا ركّزتِ كثيراً على الحِفاظ
،على صورتك كتلميذ كوهاي

201
00:13:43,380 --> 00:13:45,930
فإنّ شخصاً آخر سوف يخطفه منك

202
00:13:45,930 --> 00:13:48,120
!من فضلك لا تظهر كلّما رغبتَ في ذلك

203
00:13:48,120 --> 00:13:50,640
وأيضاً، لم أطلب نصيحتك

204
00:13:50,640 --> 00:13:54,060
أنا أُشجّعكِ يا آيريس

205
00:13:55,730 --> 00:13:58,190
إنفيس، عِدني من فضلك

206
00:13:58,190 --> 00:14:00,820
إذا ناديتِني بـ فين، فقد أصغي

207
00:14:01,890 --> 00:14:02,820
فين

208
00:14:04,180 --> 00:14:07,450
أصبح ويل عضواً في البرج بشكل رسميّ

209
00:14:07,880 --> 00:14:13,080
لذا... لا تأخذه بعيداً فحسب من فضلك

210
00:14:13,410 --> 00:14:14,960
حسناً

211
00:14:14,960 --> 00:14:19,460
سأحترم أُماني كيريدوين وأتراجع
لمزيد من الوقت

212
00:14:20,030 --> 00:14:23,730
لكن إذا فشلَ السّيفُ في إحراز
،تقدُّم جيّد

213
00:14:23,730 --> 00:14:25,970
فسوف آخذه، وهذا غير قابل للنّقاش

214
00:14:25,970 --> 00:14:27,470
يمكنك فعل ذلك

215
00:14:27,890 --> 00:14:31,350
فكُلّ ما نفعله هو لتجاوز السّماوات

216
00:14:33,350 --> 00:14:35,350
!جميعكم

217
00:14:35,750 --> 00:14:38,480
!ماذا تعتقدون بأنّكم تفعلون بالضّبط؟

218
00:14:40,480 --> 00:14:44,610
صعدتُم إلى البرج، ومع ذلك ما زلتُم
تتصرّفون كتلاميذ؟

219
00:14:44,930 --> 00:14:47,510
!أنتم تفتقرون للوعي كسحَرة رفيعين

220
00:14:48,030 --> 00:14:49,460
...على الأقلّ

221
00:14:49,460 --> 00:14:52,370
هكذا كنتُ لأُوبّخكم منذ مدّة قصيرة

222
00:14:54,370 --> 00:14:56,510
لا تسترخوا كثيراً

223
00:14:56,510 --> 00:14:59,880
،أُسدي إليكم هذه النّصيحة ليس كمُعلّم لكم
بل كساحر سينباي

224
00:14:59,880 --> 00:15:01,880
...الأُستاذ واركنر

225
00:15:02,740 --> 00:15:03,600
ويل

226
00:15:04,730 --> 00:15:06,260
هلّا أخذتُ قليلاً من وقتك؟

227
00:15:06,260 --> 00:15:07,220
ماذا؟

228
00:15:10,830 --> 00:15:14,650
!ويل، تهانينا تجاوز الازدهار الثّاني

229
00:15:14,650 --> 00:15:18,360
هنّأتني العديد من المرّات بعد مراسم
التخرُّج أيضاً

230
00:15:18,360 --> 00:15:20,650
وحتّى أنّك بكيت أكثر ممّا بكيتُ أنا

231
00:15:20,650 --> 00:15:24,900
!لـ-لا تسخر منّي أيّها الأبله
!هكذا هو طبع الأساتذة

232
00:15:24,900 --> 00:15:26,330
...بئس الأمر

233
00:15:26,730 --> 00:15:28,280
الأُستاذ واركنر؟

234
00:15:29,050 --> 00:15:30,590
لديّ طلب

235
00:15:31,210 --> 00:15:32,290
ما هو؟

236
00:15:32,290 --> 00:15:35,240
هل من طريقة أرى فيها إيلفي؟

237
00:15:35,740 --> 00:15:38,790
أريد الذّهاب لرؤيتها أكثر من
أيّ وقت مضى الآن

238
00:15:40,890 --> 00:15:44,720
،بالنّسبة لشخص من فصيل مُختلف
اللّقاء بماجيا فيندر مُستحيل

239
00:15:45,880 --> 00:15:51,210
لكن، على سبيل المُصادفة، هناك
تلميذة تريد رؤيتك أيضاً

240
00:15:51,210 --> 00:15:51,810
ماذا؟

241
00:15:51,810 --> 00:15:53,200
!اذهب وبدّل ملابسك

242
00:15:53,200 --> 00:15:54,620
!سنخرج خِلسة من البرج

243
00:15:54,620 --> 00:15:55,680
ماذا؟

244
00:15:59,650 --> 00:16:02,820
واركنر ذاك... إنّه يُبالغ كثيراً في تحيُّزه

245
00:16:02,820 --> 00:16:05,180
تقصد مُعاملته اللّطيفة؟

246
00:16:05,180 --> 00:16:08,300
،هذا لأنّ ثمّة مُعلّم آخر، مُرعب كأفعى

247
00:16:08,300 --> 00:16:11,700
وبّخه توبيخاً شديداً لدرجة فقد
قدرته على التحمُّل

248
00:16:13,600 --> 00:16:17,850
!يا للشّباب! كما في أيّامنا الخوالي

249
00:16:19,420 --> 00:16:21,620
سأعود إليك على السّاعة الثّانية عشر

250
00:16:21,620 --> 00:16:24,090
إلى ذلك الحين، احرص على أن
تتمكّن من المُغادرة بلا حسرات

251
00:16:34,370 --> 00:16:35,390
!إيلفي

252
00:16:37,730 --> 00:16:38,730
!ويل

253
00:16:39,160 --> 00:16:40,470
—آسف لأنّ ذلك استغرقني وقتاً طويلاً

254
00:16:42,230 --> 00:16:48,280
!لماذا ذهبت إلى زيو؟! هل تكرهني الآن؟

255
00:16:48,280 --> 00:16:48,760
ماذا؟

256
00:16:48,760 --> 00:16:51,570
لا يا إيلفي! خسرتِ في حجر ورقة مقصّ

257
00:16:51,570 --> 00:16:54,240
!أكره هذا! أكرهه، أكرهه

258
00:16:54,240 --> 00:16:57,740
ظننتُ بأنّني سأتمكّن من البقاء
...معك أخيراً يا ويل، والآن

259
00:16:57,740 --> 00:17:01,770
!لا أريدك أن تكون عروسة زيو! أكره ذلك

260
00:17:01,770 --> 00:17:04,960
!ماذا تقصدين بـ"عروسة"؟! لن يحدث هذا

261
00:17:06,670 --> 00:17:10,220
...أردتُ أن نكون معاً أيضاً، لكن بعدها قلتُ لنفسي

262
00:17:10,610 --> 00:17:13,210
هل نحن راضون حقّاً بأن يكون"
"هذا هو الهدف؟

263
00:17:13,210 --> 00:17:14,220
الهدف؟

264
00:17:15,150 --> 00:17:17,970
ماذا كان الوعد الّذي قطعناه؟

265
00:17:18,330 --> 00:17:22,980
أن نصبح ماجيا فيندر ونذهب
لرؤية غروب الشّمس

266
00:17:22,980 --> 00:17:23,910
تماماً

267
00:17:24,410 --> 00:17:27,320
لا أستطيع الوقوف بجانبكِ بعد يا إيلفي

268
00:17:27,810 --> 00:17:29,650
لهذا السّبب أريد أن أصبح أقوى

269
00:17:30,080 --> 00:17:31,940
!رغم ذلك، أكره هذا

270
00:17:31,940 --> 00:17:32,610
!ماذا؟

271
00:17:33,250 --> 00:17:39,880
أريد أن أكون معك يا ويل. أن ألمسك
...وأشعر بدفئك. لكن هذا

272
00:17:39,880 --> 00:17:41,750
...بخصوص ذلك

273
00:17:43,170 --> 00:17:47,250
منذ زمن بعيد، ألم تُحاولي خِداعي وتفعلي هذا؟

274
00:17:47,250 --> 00:17:51,460
ماذا؟! ما-ما-ما هذا الـ-المقلب؟

275
00:17:52,520 --> 00:17:53,910
كقبلة أو ما شابه؟

276
00:17:53,910 --> 00:17:56,510
!لـ-لـ-لـ-لا أملك فكرة عمّا تتكلّم

277
00:17:57,000 --> 00:17:57,930
حقّاً؟

278
00:17:57,930 --> 00:18:01,520
صـ-صدقاً! لستُ كوليت

279
00:18:01,520 --> 00:18:04,010
لِمَ تذكرين كوليت الآن؟

280
00:18:07,480 --> 00:18:08,900
تتذكّر ذلك إذاً؟

281
00:18:09,330 --> 00:18:14,780
أجل، لكن أشعر وكأنّ هناك أشياء
لم أتذكّرها بعد

282
00:18:15,140 --> 00:18:17,230
شرحت كيريدوين الأمور لي

283
00:18:17,230 --> 00:18:22,370
قالت بأنّني سأتمكّن من المضيّ قُدماً
بتذكّثر طُرُق السّحر الّتي سلكتُها

284
00:18:22,790 --> 00:18:26,730
،لهذا السّبب إن كان هناك ما نسيتُه
فأريد استعادته

285
00:18:26,730 --> 00:18:28,550
بما في ذلك ما كان ثميناً بالنّسبة
لنا يا إيلفي

286
00:18:31,060 --> 00:18:33,050
أنت طمّاع جدّاً يا ويل

287
00:18:33,050 --> 00:18:36,300
هذا صحيح. طمّاع بما يكفي لأكون مُناسباً لكِ

288
00:18:36,300 --> 00:18:39,560
حقّاً؟ في هذه الحالة، أُسامحك

289
00:18:39,970 --> 00:18:41,310
...لكن بالمُقابل

290
00:18:41,870 --> 00:18:43,910
!لنذهب ونلقِ نظرة إلى السّماء

291
00:18:50,940 --> 00:18:54,200
يمكننا رؤيتها من مكان أقرب بكثير ممّا فعلنا
!عندما قطعنا ذلك الوعد

292
00:18:58,290 --> 00:19:01,370
هذه السّلالم... النّاس لا يرونها، صحيح؟

293
00:19:01,370 --> 00:19:04,500
أطلقتُ سحرَ وهم عليها. لا تقلق

294
00:19:04,500 --> 00:19:08,130
الأهمّ، يجب علينا أن نُسرع
!قبل أن تُصبح الثّانية عشر

295
00:19:08,130 --> 00:19:08,950
حسناً

296
00:19:11,050 --> 00:19:14,980
ويل، ظهرُك أكبر حجماً بكثير ممّا كان آنذاك

297
00:19:14,980 --> 00:19:16,260
أوتظنّين ذلك؟

298
00:19:16,720 --> 00:19:17,660
أجل

299
00:19:18,090 --> 00:19:20,670
أنت أكبر حجماً بكثير

300
00:19:21,220 --> 00:19:22,310
...لكن

301
00:19:23,410 --> 00:19:25,230
دفئك لم يتغيّر إطلاقاً

302
00:19:33,730 --> 00:19:38,260
،إنّها جميلةٌ جدّاً، لكن هذه السّماء مُزيّفة

303
00:19:38,670 --> 00:19:42,610
والمُضيف السّماويّ يتربّص خلفها

304
00:19:43,240 --> 00:19:44,080
أجل

305
00:19:44,580 --> 00:19:47,080
...الوعد الّذي قطعناه

306
00:19:47,080 --> 00:19:51,000
قد يكون أصعب وعد للوفاء به
في العالم كُلّه

307
00:19:54,170 --> 00:19:55,260
...لكن حتّى لو كان كذلك

308
00:19:55,570 --> 00:19:57,570
...أجل، حتّى لو كان كذلك

309
00:19:58,010 --> 00:19:59,450
يبقى وعداً

310
00:19:59,450 --> 00:20:03,430
!لنذهب أنا وأنت ونرى غروبَ الشّمس معاً

311
00:21:43,070 --> 00:21:45,990
ويستوريا: عصا وسيف

312
00:21:49,040 --> 00:21:52,500
البرج، الطّابق الأوّل: القاعة المُؤقّتة

313
00:21:52,500 --> 00:21:55,570
تحمّستُ زيادة عن اللّزوم في الأمس

314
00:21:55,570 --> 00:21:57,750
أكلتُ وشربتُ بإسراف. هذا فظيع

315
00:21:57,750 --> 00:22:01,010
أتساءل ما الأشياء الّتي سيُعلّموننا
إيّاها في جلسة التّوجيه هذه

316
00:22:01,320 --> 00:22:04,470
غالباً معلومات حول كيفيّة العيش
هنا في البرج

317
00:22:04,470 --> 00:22:06,060
هناك فصائل في نهاية المطاف

318
00:22:06,060 --> 00:22:10,520
بالفعل، يُقال بأنّ الأشياء مُختلفة
هنا عنها في الأكاديميّة

319
00:22:12,020 --> 00:22:18,020
شكراً على الانتظار! وتهانينا لكم جميعاً
!أيُّها الخرّيجون الانضمام للفصائل

320
00:22:18,440 --> 00:22:21,010
!هذا هو الجيل الرّهيب الّذي عهِدناه

321
00:22:21,010 --> 00:22:22,820
حتّى أولئك الّذين لم يتجاوزوا الازدهار الأوّل

322
00:22:22,820 --> 00:22:26,530
تمكّنوا من تحويل المجهول إلى معروف
!وتلقّوا البرَكات

323
00:22:26,530 --> 00:22:30,660
كما هو مُتوقَّع، كافّة إمكانيّاتكم الاستثنائيّة
!تتألّق بشكل مُبهر

324
00:22:31,040 --> 00:22:36,670
،حسناً، لو كنّا في السّنوات السّابقة
...لأعطيتُكم توجيهات حول البرج

325
00:22:36,670 --> 00:22:40,300
لكن بالنّسبة لصفّكم، سأكلّفكم
بأمر سرّي للغاية

326
00:22:40,300 --> 00:22:41,300
ماذا؟

327
00:22:41,300 --> 00:22:45,470
مهمّتكم هي التجسُّس على الفصائل
الّتي انضممتُم إليها

328
00:22:45,470 --> 00:22:48,180
تحادَثوا مع زملائكم الأعضاء، وتعرّفوا
...على سلوكهم وسجلّاتهم

329
00:22:48,180 --> 00:22:50,940
إذا شعرتُم بأيّ شيء مشبوه، تحرّوا بشكل شامل

330
00:22:50,940 --> 00:22:52,120
وأرسلوا تقريراً

331
00:22:52,680 --> 00:22:54,690
ما-ما هذا الّذي تقولينه؟

332
00:22:54,690 --> 00:22:59,240
لا بُدّ أن يكون الهجوم المُباغت في تيرميناليا
ما زال نشِطاً في عقولكم

333
00:22:59,240 --> 00:23:02,320
...بعد التحرّي حول ما يقف خلف الحادث

334
00:23:02,640 --> 00:23:06,820
.أشارت الأدلّة كُلّها إلى شيء واحد
شخص ما من الدّاخل قد ساعدهم

335
00:23:10,310 --> 00:23:11,580
...مُستحيل

336
00:23:11,580 --> 00:23:12,580
هذا صحيح

337
00:23:12,580 --> 00:23:15,330
يوجد خائنٌ في البرج

338
00:23:24,450 --> 00:23:26,030
خائن؟

339
00:23:31,010 --> 00:23:31,510
كسيف واحد

340
00:23:31,510 --> 00:23:32,010
كما لو أنّه مِقدام

341
00:23:32,520 --> 00:23:33,020
عشيّة المهرجان العظيم

342
00:23:33,520 --> 00:23:34,020
ما بين الكبرياء والشّغف

343
00:23:34,020 --> 00:23:34,520
الأسحار الجليديّة السرّية الإثنا عشر، إيل غلاس فروس

344
00:23:35,020 --> 00:23:35,520
التّطبيقات العمليّة تبدأ

345
00:23:35,520 --> 00:23:36,020
حلمنا

346
00:23:36,020 --> 00:23:36,520
الاسم الحقيقيّ للجُبناء

347
00:23:36,520 --> 00:23:37,020
عصا وسيف

348
00:23:37,020 --> 00:23:37,520
يوم الحاجز

349
00:23:37,520 --> 00:23:38,020
حفلة الجحيم تبدأ

350
00:23:38,020 --> 00:23:38,520
تعويذة سحريّة واحدة

351
00:23:38,520 --> 00:23:39,020
وتبدأ القصّة

352
00:23:39,020 --> 00:23:39,520
يوم المُغادرة

353
00:23:39,520 --> 00:23:40,020
الازدهار الأوّل

354
00:23:40,020 --> 00:23:40,520
قال بأنّه لن يحني رأسه بعد الآن

355
00:23:40,520 --> 00:23:41,020
تعاليم السّاحرة

356
00:23:41,020 --> 00:23:41,520
فتح صفحة جديدة

357
00:23:41,520 --> 00:23:42,020
آمِلٌ، مُتفتِّح، راعِد

358
00:23:42,020 --> 00:23:42,530
زئير الجليد والبرق

359
00:23:42,530 --> 00:23:43,110
قصّة حلم بلا نهاية