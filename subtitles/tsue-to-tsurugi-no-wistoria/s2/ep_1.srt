1
00:00:05,700 --> 00:00:10,460
في البرج العظيم، ما هو أكثر شيء ذي قيمة؟

2
00:00:31,090 --> 00:00:34,220
إنّه بالطّبع القدرة السّحريّة

3
00:00:45,660 --> 00:00:48,420
...هل أولئك الّذين بلا قدرة حقيقيّة

4
00:00:49,320 --> 00:00:53,700
لديهم أمل مُلهِم ببلوغ ذروة السّحر؟

5
00:01:05,970 --> 00:01:07,760
...الجواب على ذلك

6
00:01:13,330 --> 00:01:17,170
سوية مع الآخرين، سأستمرّ
!في المضيّ قُدماً

7
00:01:30,550 --> 00:01:34,320
إيلفي، أعدكِ بأنّني سأصل إليكِ

8
00:01:51,010 --> 00:01:55,720
الحلقة 13
يوم الحاجز

9
00:03:06,460 --> 00:03:08,920
أكاديميّة ريغاردين السّحريّة

10
00:03:08,920 --> 00:03:10,550
يوم ما قبل اليوم الأخير من امتحانات التخرُّج
أكاديميّة ريغاردين السّحريّة، غرفة هيئة التّدريس

11
00:03:08,920 --> 00:03:10,550
!علامة تامّة في كلّ مادّة؟

12
00:03:11,000 --> 00:03:14,050
أجل. تفقّدتها عدّة مرّات. لا جدول حولها

13
00:03:14,050 --> 00:03:15,500
!إنّه ويل سيرفورت

14
00:03:15,930 --> 00:03:18,310
ما زلنا نُصحّح، لكنّه لم يرتكب أيّ خطأ

15
00:03:18,310 --> 00:03:21,130
حتّى ليهانا فقدتْ فُرصتها
في تحقيق علامة كاملة

16
00:03:21,130 --> 00:03:23,190
!قد يفعلها

17
00:03:23,440 --> 00:03:24,940
!قد ينجح حافظ الكُتُب

18
00:03:24,940 --> 00:03:27,440
!قد يتخطّى الكتابة والتّطبيق العمليّ بشكل كامل

19
00:03:27,440 --> 00:03:29,360
.إنّه ليس تلميذاً سيّئاً حتّى
!إنّه عديم موهبة

20
00:03:27,900 --> 00:03:31,610
أستاذ في أكاديميّة ريغاردين السّحريّة
إدوارد سيرفينس

21
00:03:29,360 --> 00:03:31,740
!وقد يُحقّق صعوداً غير مسبوق إلى البرج

22
00:03:35,700 --> 00:03:38,080
دراسة المخلوقات الأسطوريّة الخطّيّة
ويل سيرفورت: العلامة التامّة

23
00:03:38,490 --> 00:03:41,000
أستاذ في أكاديميّة ريغاردين السّحريّة
واركنر نورغرام

24
00:03:39,680 --> 00:03:41,000
!ممتاز

25
00:03:42,410 --> 00:03:44,670
هذا رائع يا واركنر

26
00:03:44,750 --> 00:03:48,580
أستاذة في أكاديميّة ريغاردين السّحريّة
إيليزا نوسفيرات

27
00:03:45,150 --> 00:03:48,670
يبدو أنّ التّلميذ الّذي تبنّيته تحت جناحك
على وشك أن يُحقّق حلمه

28
00:03:48,670 --> 00:03:50,560
الأستاذة الإيليزا

29
00:03:50,560 --> 00:03:52,640
ما زال أمامه امتحاناً إضافيّاً

30
00:03:52,640 --> 00:03:55,660
!لا يمكننا أن نجزم قبل النّهاية

31
00:03:55,660 --> 00:03:58,450
وبعد؟ أين هو هذا حافِظ الكُتُب
الّذي يتحدّث عنه الجميع؟

32
00:03:59,310 --> 00:04:00,930
...إنّه، بالطّبع

33
00:04:02,140 --> 00:04:05,520
أكاديميّة ريغاردين السّحريّة
غرفة الدّراسة

34
00:04:07,130 --> 00:04:09,020
ويل، هل أنت بخير؟

35
00:04:09,280 --> 00:04:11,630
لم تنم جيّداً في اللّيلة الماضية أيضاً، صحيح؟

36
00:04:11,630 --> 00:04:13,060
أنا بخير

37
00:04:13,060 --> 00:04:14,530
أقصد بأنّني لستُ كذلك

38
00:04:14,610 --> 00:04:18,660
كائن مُرافق
كيكي

39
00:04:14,610 --> 00:04:18,660
أكاديميّة ريغاردين السّحريّة، السّنة السّادسة
ويل سيرفورت

40
00:04:14,870 --> 00:04:17,820
لكن الامتحان الخطّيّ الأخير غداً

41
00:04:19,860 --> 00:04:22,910
،رغم ذلك... منذ تأجيلهم للتّطبيق العمليّ

42
00:04:20,490 --> 00:04:25,460
أكاديميّة ريغاردين السّحريّة، السّنة السّادسة
كوليت لوير

43
00:04:22,910 --> 00:04:25,790
كان ذلك يحدث أيضاً علاوة
على امتحاناتنا النّهائيّة

44
00:04:26,420 --> 00:04:29,550
هزمتَ نابيروس ذاك في الأمس فحسب

45
00:04:29,550 --> 00:04:30,710
أجل

46
00:04:30,710 --> 00:04:34,050
بفضل ليهانا والآخرين، تمكّنتُ من كسب
كلّ نقاط التّطبيق العمليّ خاصّتي

47
00:04:34,770 --> 00:04:37,800
لن أدع لطف الجميع يذهب سُدى

48
00:04:37,800 --> 00:04:40,180
ليس هذا ما أنا قلقة بشأنه

49
00:04:40,180 --> 00:04:43,620
لم تتلقّ سوى حفنة من نقاط التّعويذ، أليس كذلك؟

50
00:04:40,220 --> 00:04:44,810
أكاديميّة ريغاردين السّحريّة، السّنة السّادسة
روستي نومان

51
00:04:43,620 --> 00:04:45,060
هذا صحيح يا روستي

52
00:04:45,580 --> 00:04:48,550
فقط الخمسة من درسي مع الأستاذ إدوارد

53
00:04:49,060 --> 00:04:51,470
الاختبارات المُتبقّية تُساوي ستّ نقاط

54
00:04:51,470 --> 00:04:54,270
،إذا استطعتُ كسب نقطة إضافيّة فقط
فسأتمكّن من الصّعود إلى البرج

55
00:04:54,270 --> 00:04:55,530
!لا يمكنني أن أرخي دفاعي الآن

56
00:04:55,950 --> 00:04:59,000
...لكن إذا عملت بجدّ

57
00:05:00,490 --> 00:05:01,300
!مُؤلم

58
00:05:01,300 --> 00:05:02,150
رأيت؟

59
00:05:02,150 --> 00:05:03,750
!لديك كثير من الشّعر الرّماديّ

60
00:05:03,750 --> 00:05:05,530
!ماذا تظنّ نفسك أنّك تفعل؟

61
00:05:05,530 --> 00:05:07,640
!ماذا تقصدين؟ أنا أنتف شعراً رماديّاً

62
00:05:07,640 --> 00:05:10,000
دائماً ما أفعل هذا لأجله

63
00:05:10,000 --> 00:05:13,090
آنسة كوليت، هل أردتِ فعلها بدلاً من ذلك؟

64
00:05:13,090 --> 00:05:15,620
...مُـ-مُحال أن

65
00:05:15,620 --> 00:05:16,970
...مُحال أن

66
00:05:16,970 --> 00:05:18,510
مُحال ماذا؟

67
00:05:21,010 --> 00:05:25,940
أكاديميّة ريغاردين السّحريّة
مكتب المُديرة

68
00:05:21,090 --> 00:05:25,890
من المُدهش جدّاً أن تهزم حارسَ
الطّابق في خضمّ جدلك المُزدحم

69
00:05:25,890 --> 00:05:28,040
عمل مُبهر بحقّ

70
00:05:29,400 --> 00:05:33,030
وجدتُ نفسي مُتورّطاً في الأمر فحسب
يا حضرة المُديرة كالدرون

71
00:05:33,340 --> 00:05:37,630
حتّى من دون هزيمة نابيروس ذاك، سأتمكّن
!مع ذلك من الصّعود إلى البرج

72
00:05:34,320 --> 00:05:39,200
أكاديميّة ريغاردين السّحريّة
يوليوس رينبيرغ

73
00:05:37,630 --> 00:05:41,160
...ومع ذلك كوليت والآخرين أقحموني في الأمر

74
00:05:41,160 --> 00:05:44,410
لا أنكر بأنّنا كنّا سنكون بخير من دونك

75
00:05:42,160 --> 00:05:47,040
أكاديميّة ريغاردين السّحريّة
شيون أولستير

76
00:05:44,410 --> 00:05:46,950
ذلك الجليد الّذي أنت فخور جدّاً
به استمرّ في الذّوبان

77
00:05:46,950 --> 00:05:48,870
لم يكن ذلك مُفيداً على الإطلاق

78
00:05:49,430 --> 00:05:50,870
!ماذا قلت للتو؟

79
00:05:50,870 --> 00:05:53,030
!اختبأت في ظلّ عديم الموهبة ذاك

80
00:05:53,030 --> 00:05:55,110
كلّ ما فعلتَه كان اللّعب بالنّار
!بشكل مُثير للشّفقة

81
00:05:55,110 --> 00:05:59,260
!لا تُهِن نيران أولستير! يا رينبيرغ المُتباهي اللّعين

82
00:06:01,640 --> 00:06:06,060
مُديرة أكاديميّة ريغاردين السّحريّة
كالدرون أنوف

83
00:06:02,490 --> 00:06:06,270
يبدو أنّكما لا تستطيعان تحمُّل ترك
ويل بمفرده، أليس كذلك؟

84
00:06:06,270 --> 00:06:07,670
!من لا يستطيع؟

85
00:06:08,390 --> 00:06:13,320
أكاديميّة ريغاردين السّحريّة
ممرّ النّسيم

86
00:06:09,170 --> 00:06:13,800
بهذا، نكون أنا ومجموعة شيون قد أتممنا
كلّ نقاط تطبيقنا العمليّ

87
00:06:13,800 --> 00:06:17,750
أجل. عندما تكون لديك القدرة المُثبَتة
،على هزيمة حارس طابق

88
00:06:17,750 --> 00:06:19,530
فيمكنك أن تتباهى قليلاً أمام البرج

89
00:06:19,570 --> 00:06:24,580
أكاديميّة ريغاردين السّحريّة، سنة سادسة
فيغنال ليندور

90
00:06:19,570 --> 00:06:24,580
أكاديميّة ريغاردين السّحريّة، سنة سادسة
ليهانا أوينزاوس

91
00:06:19,990 --> 00:06:24,550
لكن بعد هزيمة دوق عظيم، بدا
كلّ ذلك مُحبِطاً قليلاً، أليس كذلك؟

92
00:06:25,320 --> 00:06:26,410
لست مُخطئاً

93
00:06:29,010 --> 00:06:30,650
تغيّرتِ يا ليهانا

94
00:06:31,130 --> 00:06:34,350
الآن، أنتِ أكثر ليناً من السّابق

95
00:06:34,670 --> 00:06:38,390
هذا ما تقوله، لكن تبدو وكأنّ ملامحك
الحادّة قد تبدّدت بالنّسبة لي

96
00:06:38,390 --> 00:06:41,680
،في الماضي، كنتَ دائماً ما تبتسم ابتسامة رزينة

97
00:06:41,930 --> 00:06:45,280
مع ذلك كانت الحقيقة هي أنّك
أكثر من يشعر بالضّغط

98
00:06:47,430 --> 00:06:50,690
بالفعل. أعزو الفضل له

99
00:06:51,480 --> 00:06:53,610
لا ضير من الفشل مهما كان عدد المرّات

100
00:06:53,610 --> 00:06:55,940
هذا ما علّمني إيّاه من خلال تلك المُغامرة

101
00:06:56,400 --> 00:06:57,940
تعلّمتُ أشياء أيضاً

102
00:06:58,640 --> 00:07:01,320
...إحساسي بالدّونيّة وقلبي الجبان

103
00:07:01,820 --> 00:07:04,870
تعلّمتُ بأنّه يمكن تحويلهما إلى ذلك
السّحر الّذي يُدعى شجاعة

104
00:07:06,700 --> 00:07:09,570
أتساءل كيف حاله الآن؟

105
00:07:10,250 --> 00:07:11,890
هذا واضح

106
00:07:12,880 --> 00:07:14,900
هذه هي الدَّفعة الأخيرة

107
00:07:14,900 --> 00:07:19,050
وويل مُجدّ بما يكفي لاعتراف
حتّى إيلف بجهوده

108
00:07:21,290 --> 00:07:22,990
الوقت متأخّر هكذا وما زال ينشط؟

109
00:07:22,990 --> 00:07:25,630
أعلم بأنّه يُجهد نفسه كثيراً

110
00:07:25,900 --> 00:07:28,640
!ويل، أحضرتُ لك طعاماً ليليّاً خفيفاً

111
00:07:28,640 --> 00:07:31,430
...تكلّمتُ مع الأستاذ واركنر، وأعطاني

112
00:07:47,570 --> 00:07:48,570
ويل؟

113
00:07:50,620 --> 00:07:51,830
هل أنت نائم؟

114
00:08:06,010 --> 00:08:08,840
ماذا تفعلين يا آنسة كوليت؟

115
00:08:12,470 --> 00:08:14,390
منذ متى كنت هنا؟

116
00:08:14,390 --> 00:08:15,850
!لا، لحظة! أسأتَ الفهم

117
00:08:15,850 --> 00:08:19,440
كـ-كنتُ قلقة على ويل، لذا كنتُ
!أغطّيه بعباءة فحسب

118
00:08:19,440 --> 00:08:21,230
أهذا ما كان إذاً؟

119
00:08:21,230 --> 00:08:25,150
!بدا لي وكأنّكِ كنتِ ستُقبّلينه

120
00:08:25,150 --> 00:08:26,820
آسف لأنّني أسأتُ الفهم

121
00:08:31,240 --> 00:08:33,450
أنا قلقة عليه بالفعل

122
00:08:34,120 --> 00:08:37,960
ويل مُرهَق، لكن مع ذلك يضغط
على نفسك كثيراً

123
00:08:38,330 --> 00:08:39,960
إنّه مليء بالكدمات والجروح

124
00:08:42,380 --> 00:08:46,000
أكره الماجيا فيندر

125
00:08:47,880 --> 00:08:50,760
،بسبب التّعويذة الّتي أطلقتها آلبيس فينا

126
00:08:50,760 --> 00:08:53,010
يُطاردها ويل دائماً

127
00:08:53,010 --> 00:08:58,020
ومع ذلك هي لا تفعل شيئاً. إنّها
...تنتظر في البرج فحسب

128
00:08:59,350 --> 00:09:01,020
أشفق على ويل

129
00:09:03,310 --> 00:09:04,770
هذا صحيح

130
00:09:07,320 --> 00:09:09,070
يُراودني نفس الشّعور

131
00:09:13,160 --> 00:09:16,660
إيلفاريا آلبيس سيرفورت

132
00:09:16,740 --> 00:09:19,290
ضابطة مُرافِقة في جماعة الجليد
ساريسا ألفيلد

133
00:09:19,790 --> 00:09:22,790
إيلفاريا-ساما، هل من مُشكلة؟

134
00:09:24,170 --> 00:09:25,040
لا

135
00:09:26,960 --> 00:09:30,220
هذا نادر يا مُجسّدة الكسل

136
00:09:30,970 --> 00:09:33,680
...أن تخرج مُنعزلة مثلكِ

137
00:09:33,680 --> 00:09:36,850
هل ستُمطر رِماحاً من البرَد غداً؟

138
00:09:33,720 --> 00:09:37,180
إيلينور ليوس آلف

139
00:09:37,180 --> 00:09:38,640
إيلينور

140
00:09:39,100 --> 00:09:43,440
هل كانت الخسارة أمامي في المُنافسة
السّحريّة مُحزنة إلى هذا الحدّ؟

141
00:09:43,440 --> 00:09:46,020
!هذا لأنّها كانت تقتصر على سحر الجليد فقط

142
00:09:46,020 --> 00:09:48,570
!لو سُمِح لي باستخدام سحر آخر، لسحقتُكِ

143
00:09:49,150 --> 00:09:52,400
كنتُ أتساءل ما تلك الضجّة. هذا أنتما

144
00:09:53,610 --> 00:09:55,700
هذا طريقي

145
00:09:55,740 --> 00:09:58,580
زيو ثورزيوس رينبولت

146
00:09:57,160 --> 00:09:58,580
أفسحنَ الطّريق

147
00:09:58,580 --> 00:10:00,370
...أنت من ينبغي أن يغادر من فضلك

148
00:09:58,580 --> 00:10:00,370
...أنت من عليه إفساح الطّريق

149
00:10:00,370 --> 00:10:01,200
أيّها الهمجيّ

150
00:10:02,410 --> 00:10:05,960
ألم تنظرا في المرآة أيّتها المرأتان
المُشاكستان الوقحتان؟

151
00:10:07,040 --> 00:10:08,710
...أنت وإيلينور

152
00:10:09,300 --> 00:10:10,880
ماذا تفعلان هنا؟

153
00:10:10,880 --> 00:10:12,970
لا تسألي

154
00:10:13,470 --> 00:10:15,720
نفس الأمر ينطبق عليكما، صحيح؟

155
00:10:16,090 --> 00:10:17,430
تيرميناليا

156
00:10:17,800 --> 00:10:21,140
يجب عليّ الاستعداد لذلك الطّقس المُزعج

157
00:10:21,140 --> 00:10:23,350
الحاجز على وشك أن يختفي

158
00:10:23,350 --> 00:10:25,020
إنّها نهاية عام

159
00:10:25,480 --> 00:10:29,820
كم ستكون المجموعة التّالية مُفيدة؟
يستحقّ الأمر المُشاهدة

160
00:10:32,070 --> 00:10:33,740
تاريخ امتحان السّحر النّهائيّ

161
00:10:38,370 --> 00:10:42,120
لم أتخيّل أبداً بأن يكون الأستاذ إدوارد
مسؤولاً عن اليوم الأخير

162
00:10:42,120 --> 00:10:45,710
الخضوع لاختبارات الأفعى تلك
لثلاث حصص هو الأسوأ

163
00:10:45,710 --> 00:10:47,880
قد لا أصل إلى البرج

164
00:10:49,090 --> 00:10:50,500
هدوء

165
00:10:52,840 --> 00:10:55,380
سنبدأ الآن بامتحانكم الأخير

166
00:10:55,930 --> 00:10:58,640
...لكن قبل ذلك، دعوني أخبركم

167
00:10:59,050 --> 00:11:02,140
سأطرح عليكم سؤالاً واحداً فقط

168
00:11:02,140 --> 00:11:06,400
أيّ شخص يستطيع الإجابة عن السّؤال
المذكور سيُكافأ بالنّقاط الستّ كلّها

169
00:11:08,900 --> 00:11:11,400
لا أقبل بأيّ سؤال

170
00:11:11,650 --> 00:11:15,610
أروني ثِمار ما زرعتموه في سنواتكم
الستّ هنا في الأكاديميّة

171
00:11:20,120 --> 00:11:21,410
...والآن

172
00:11:21,410 --> 00:11:22,410
!ابدؤوا

173
00:11:23,370 --> 00:11:24,790
ما هو السّحر؟

174
00:11:26,710 --> 00:11:29,250
،بتآلفك السّحريّ الخاص كأساس

175
00:11:29,250 --> 00:11:31,710
:اشرح باستخدام الشّروط التّالية

176
00:11:32,050 --> 00:11:35,050
تيلا، الاتّصال، التجلّي

177
00:11:35,420 --> 00:11:39,550
يتعلّق هذا بشرح تنشيط السّحر
!وشروطه الأساسيّة

178
00:11:40,140 --> 00:11:44,310
إنّها عمليّة نؤدّيها لاشعوريّاً

179
00:11:44,600 --> 00:11:47,940
إنّه يطلب منّا شرح ذلك الإحساس
بالتّعبير عن ذلك بكلمات

180
00:11:47,940 --> 00:11:50,560
...توضيح ذلك صعب، لكن

181
00:11:50,560 --> 00:11:52,570
إن كان هذا كلّ شيء، فقد أتمكّن
!من الإجابة عن هذا

182
00:11:52,570 --> 00:11:56,570
،بالفعل، سواء كنت ساحراً أو إيلفاً
ستتمكّن من إيجاد إجابة

183
00:11:56,570 --> 00:11:59,700
لكن لم يستطع أيّ أحد آخر

184
00:11:59,700 --> 00:12:02,620
إذاً حينها... ماذا عنه؟

185
00:12:06,040 --> 00:12:08,620
لا جدوى. لا أستطيع الإجابة عن هذا

186
00:12:09,250 --> 00:12:11,630
معرفتي عقيمة

187
00:12:11,630 --> 00:12:15,340
.هذا غير وارد في أيّ كتاب
لا يمكن تعليمه

188
00:12:15,340 --> 00:12:18,220
الإحساس تجاه ذلك... الموهبة هي كلّ شيء

189
00:12:18,680 --> 00:12:22,600
لا أستطيع استخدام السّحر، لذا
!لا شأن لي بالإجابة عن هذا السّؤال

190
00:12:23,350 --> 00:12:25,390
!لا أستطيع حلّ هذا بمُفردي

191
00:12:25,390 --> 00:12:27,600
هل هذا يعني بأنّ الأمر انتهى؟
ألن أصل إلى البرج؟

192
00:12:28,440 --> 00:12:30,100
ماذا عن وعدي لإيلفي؟

193
00:12:31,690 --> 00:12:33,190
!لا تستسلم

194
00:12:35,610 --> 00:12:37,570
...بالنّسبة لي، السّحر هو

195
00:12:38,280 --> 00:12:39,360
!إلهام

196
00:12:40,410 --> 00:12:42,910
إنّها مُعجزة لا أستطيع استيعابها
!مهما مددتُ يدي بعيداً

197
00:12:44,410 --> 00:12:46,240
...إنّه جميل جدّاً

198
00:12:46,240 --> 00:12:47,870
!وقاسٍ جدّاً

199
00:12:50,040 --> 00:12:52,290
السّحر هو ما يتواجد في نهاية
كلّ عملنا الدّؤوب

200
00:12:52,630 --> 00:12:54,380
،إذا رفضت الاستسلام يوماً

201
00:12:54,380 --> 00:12:57,340
فأعتقد بأنّ هناك قوّة تستطيع
!التفوُّق حتّى على السّحر

202
00:12:57,340 --> 00:13:00,720
...أنا... بالنّسبة لي، السّحر هو

203
00:13:05,810 --> 00:13:06,930
!إيد

204
00:13:06,930 --> 00:13:08,680
!ماذا كان ذلك الامتحان؟

205
00:13:08,680 --> 00:13:10,270
!ماذا كان ذلك السّؤال؟

206
00:13:10,270 --> 00:13:11,690
ماذا تقصد؟

207
00:13:11,980 --> 00:13:13,770
سألتُ ببساطة مُرشِّحي البرج

208
00:13:13,770 --> 00:13:17,780
عن أهمّ أساس بالنّسبة لساحر

209
00:13:17,780 --> 00:13:20,360
تقريباً 40 بالمئة من التّلاميذ أخطأوا الإجابة

210
00:13:21,200 --> 00:13:23,570
هذا بائس لدرجة مُثيرة للسّخط

211
00:13:23,570 --> 00:13:26,330
!ليس هذا ما أسألك عنه

212
00:13:26,330 --> 00:13:29,200
كان ذلك السّؤال مُوجّهاً بشكل مُباشر
!إلى تلميذ مُحدَّد واحد

213
00:13:29,200 --> 00:13:32,460
كيف أمكنك فعل شيء خاطئ
!كهذا بصفتك مُعلّم؟

214
00:13:34,290 --> 00:13:36,550
!أنتم المُخطئون

215
00:13:40,340 --> 00:13:43,680
ما الّذي ترمون إليه بالسّماح لشخص
لا يُجيد السّحر يدخل إلى البرج؟

216
00:13:44,010 --> 00:13:46,680
ما الّذي يستطيع فعله في مقبرة العِصيّ؟

217
00:13:46,680 --> 00:13:48,850
هل تنوي أن تجعله رعيّة تجارب؟

218
00:13:49,180 --> 00:13:51,690
أيّها الأحمق. هذه ليست نكتة

219
00:13:51,940 --> 00:13:55,810
في عالمنا السّحريّ، لا يمكن
!للسّيف أن يصبح عصا سحريّة

220
00:13:56,820 --> 00:14:01,070
فقدتما صوابكما. أنت والمُديرة

221
00:14:02,950 --> 00:14:06,030
...نزع حلم لا يمكن أن يتحقّق أبداً

222
00:14:03,070 --> 00:14:07,740
قائمة التّلاميذ الرّاسبين

223
00:14:06,030 --> 00:14:09,870
هذا أعظم معروف يمكنني تقديمه له

224
00:14:08,030 --> 00:14:11,200
ويل سيرفورت

225
00:14:12,250 --> 00:14:13,960
...ويل سيرفورت

226
00:14:14,250 --> 00:14:17,460
النّقاط المُكتسبة: 7.199

227
00:14:18,210 --> 00:14:20,210
تمّ إقصاؤه من البرج

228
00:14:36,650 --> 00:14:37,480
ويل

229
00:14:37,940 --> 00:14:40,280
انتهيتُ من إصلاح ناظورك

230
00:14:40,820 --> 00:14:42,240
تركتُه في غرفتنا

231
00:14:44,110 --> 00:14:45,110
...ويل

232
00:14:45,490 --> 00:14:46,870
روستي

233
00:14:47,620 --> 00:14:50,410
الأستاذ إدوارد لئيم حقّاً

234
00:14:50,410 --> 00:14:52,040
...هذا السّؤال

235
00:14:52,040 --> 00:14:54,330
مُحال أن يتمكّن شخصٌ مثلي
من الإجابة عنه

236
00:14:55,290 --> 00:14:58,040
سؤال كهذا كان قاسياً فحسب

237
00:14:59,540 --> 00:15:02,760
!لا يمكن أن يحدث هذا... هذا لا يُصدَّق

238
00:15:05,300 --> 00:15:06,380
...أنا آسف

239
00:15:06,930 --> 00:15:08,760
!أنا آسف يا إيلفي

240
00:15:11,510 --> 00:15:15,690
بوضعك الرّاهن، لا أعتقد بأنّ أيّ كلمة
أقولها سوف تؤثّر بك

241
00:15:16,520 --> 00:15:17,770
لكن سأقولها على أيّ حال

242
00:15:18,810 --> 00:15:21,230
أنا معك هنا دائماً

243
00:15:26,910 --> 00:15:28,070
!ليهانا

244
00:15:28,530 --> 00:15:29,780
هل وجدتِ ويل؟

245
00:15:29,780 --> 00:15:32,200
لا، اختفى تماماً

246
00:15:32,200 --> 00:15:34,370
...فيغنال وأنا بحثنا معاً، لكن

247
00:15:35,040 --> 00:15:37,540
على الأقلّ، إنّه ليس في الحرم الدّراسيّ

248
00:15:37,540 --> 00:15:39,540
غالباً غادر حدود الأكاديميّة

249
00:15:39,830 --> 00:15:40,840
...ويل

250
00:15:40,840 --> 00:15:42,550
إلى أين ذهبت؟

251
00:15:43,000 --> 00:15:47,630
تلميذ لا يستطيع الصّعود إلى البرج يختفي
من الحرم الدّراسيّ مفطور القلب

252
00:15:48,050 --> 00:15:50,550
إنّه حدثٌ شائعٌ في هذه الفترة
من العام، أليس كذلك؟

253
00:15:50,550 --> 00:15:51,390
!يوليوس

254
00:15:52,220 --> 00:15:57,140
الإكراه على البحث عن عديم موهبة
هو أمرٌ مُزعج للغاية

255
00:15:58,020 --> 00:16:00,270
رجل موسوم بالعار قد هرب؟

256
00:16:00,270 --> 00:16:02,150
لا تُزعجوني بشخص كهذا

257
00:16:02,980 --> 00:16:04,650
اسحب كلامك

258
00:16:04,650 --> 00:16:06,950
لا تُهِن صديق إيلف

259
00:16:06,950 --> 00:16:11,530
،يبدو أنّه جعلك مُتعلّقاً به في الدّيماس
أليس كذلك يا سيّدي الإيلف؟

260
00:16:11,530 --> 00:16:14,660
أو ربّما عشرته قد أفسدَتْك فحسب

261
00:16:14,660 --> 00:16:15,830
ماذا قلت؟

262
00:16:18,500 --> 00:16:22,340
...في أكاديميّة السّحر هذه، في هذا العالم

263
00:16:22,340 --> 00:16:24,170
!السّحر هو كلّ شيء

264
00:16:24,800 --> 00:16:29,260
،مهما كان مُؤهّلاً وقويّاً في الدّيماس
!السّيف لا ينتمي لهذا المكان

265
00:16:31,050 --> 00:16:33,560
ما الأمر يا شيون؟ ما هذه النّظرة في عينيك؟

266
00:16:34,010 --> 00:16:38,730
مثلي، لطالما اعتبرت عديم الموهبة
ذاك عدوّاً، أليس كذلك؟

267
00:16:39,230 --> 00:16:45,400
هذا صحيح. إنّه يُثير غضبي، وكنتُ
قد خطّطتُ لهزيمته بنفسي

268
00:16:46,030 --> 00:16:48,150
لكن فُرصة ذلك قد فاتت

269
00:16:48,530 --> 00:16:50,780
ولا أستطيع تحمُّل ذلك. هذا كلُّ ما في الأمر

270
00:16:52,070 --> 00:16:54,370
ماذا تفعلون؟

271
00:16:54,370 --> 00:16:55,870
!الأستاذ واركنر

272
00:16:56,290 --> 00:16:59,080
،كنّا نبحث عن ويل

273
00:16:59,080 --> 00:17:00,790
!لكن لا يمكننا إيجاده في أيّ مكان

274
00:17:02,960 --> 00:17:04,790
سأبحث عن ويل

275
00:17:05,460 --> 00:17:07,210
ينبغي أن تذهبوا جميعاً

276
00:17:07,210 --> 00:17:08,300
...لـ-لكن

277
00:17:08,920 --> 00:17:11,010
إنّها اللّيلة الأخيرة من العام

278
00:17:11,010 --> 00:17:12,430
إنّها تيرميناليا

279
00:17:13,090 --> 00:17:15,390
جميعكم لديكم مُطلَق الحرّيّة
والاستمتاع بوقتكم

280
00:17:19,180 --> 00:17:21,350
!حان وقت المهرجان

281
00:17:22,690 --> 00:17:25,480
!أهلاً بكم في ليلة العام الجديد

282
00:17:25,480 --> 00:17:27,940
آمل أن يكون الجميع بأحسن
!حال في أنحاء العالم

283
00:17:27,940 --> 00:17:30,950
ستُقيم أوربوس ريغاردين من جديد

284
00:17:30,950 --> 00:17:36,200
!أعظم المهرجانات والطّقوس السّنويّة

285
00:17:36,660 --> 00:17:40,870
!في هذا العام، أنا من ستكون مُذيعتكم

286
00:17:39,370 --> 00:17:44,250
كليري سيرا

287
00:17:40,870 --> 00:17:46,210
،أنا ساحرة برج رفيعة، 26 عاماً
!وعزباء! هذه أنا، كليري سيرا

288
00:17:46,210 --> 00:17:51,340
إنّها نهاية العام، ومع ذلك ما زلتُ
!أعمل وأعمل وأعمل اليوم

289
00:17:51,590 --> 00:17:53,840
...رؤية تلك العائلات السّعيدة في الأسفل هناك

290
00:17:53,840 --> 00:17:56,470
الفجوة بيننا تجعلني أرغب في البُكاء

291
00:17:56,470 --> 00:17:57,850
،حتّى إذا دعيتُ نظرائي

292
00:17:57,850 --> 00:18:00,980
دائماً ما ينتهي المطاف بإخبارهم لي
بأنّ تلاميذهم أهمّ

293
00:18:00,980 --> 00:18:02,810
إنّهم رهيبون، أليس كذلك؟

294
00:18:04,730 --> 00:18:08,230
مهلاً! هل تسمعانني؟ واركنر! إيد؟

295
00:18:08,230 --> 00:18:11,650
!عندما كنّا تلاميذ، كنّا نحن الثّلاثة دوماً معاً

296
00:18:11,650 --> 00:18:12,990
!حريّ بكما أن تتذكّرا هذا

297
00:18:12,990 --> 00:18:15,240
قد أكون هناك في الأعلى يوماً ما

298
00:18:15,240 --> 00:18:18,490
أحم! المعذرة، فقدتُ رباطة جأشي

299
00:18:18,490 --> 00:18:21,540
،قبل أن يُبَثّ مزيد من سخافاتي للعالم كلّه

300
00:18:21,540 --> 00:18:24,580
!أنقل إليكم المشهد المُبهر الّذي أمامي

301
00:18:25,000 --> 00:18:28,210
!هذا صحيح! اللّيلة هي تيرميناليا

302
00:18:28,210 --> 00:18:33,510
ونحن نقوم بترميم الحاجز العظيم
!الّذي يحمي السّماء

303
00:18:43,310 --> 00:18:44,770
...منذ زمن بعيد، بعيد جدّاً

304
00:18:46,480 --> 00:18:51,650
لم يكن النّاس يعلمون بالسّماء. كان
هذا العالم محبوساً في الظّلام

305
00:18:52,190 --> 00:18:56,360
دمّرَ المُضيفُ السّماويّ الأرضَ الشّاسعة

306
00:18:56,360 --> 00:18:59,240
وأصبح عدد كبير من الأرواح موكباً جنائزيّاً

307
00:19:00,490 --> 00:19:05,580
،وعندما بدا كلّ شيء قد ضاع
...في تلك اللّحظة بالتّحديد

308
00:19:06,330 --> 00:19:08,330
،تحت مُؤسّسنا، ميرسيديس

309
00:19:08,330 --> 00:19:13,420
ختمَ السّحرةُ العُظماء الخمسة على السّماء
!وأجبروا المُضيف على الانسحاب

310
00:19:13,420 --> 00:19:16,760
!كان ذلك قبل خمسمئة عام

311
00:19:16,760 --> 00:19:21,510
الحاجز العظيم للماجيا فيندر كان قد أُطلِق
،ليؤدّي دور سمائنا في هذا اليوم

312
00:19:21,510 --> 00:19:24,060
!وما زال مستمرّاً في حمايتنا

313
00:19:26,690 --> 00:19:29,690
الحاجز فعّال لمدّة عام واحد

314
00:19:29,690 --> 00:19:34,360
في كلّ عام، في لحظاته الأخيرة، يُنصَب
حاجزٌ عظيمٌ جديد لتغطيتنا

315
00:19:35,320 --> 00:19:39,240
إنّ تفكيك الحاجز العظيم يعني
أن تصبح أساطيرنا حقيقة

316
00:19:35,570 --> 00:19:40,370
مُراقِبة برج السّاحر
آيريس تشرشل

317
00:19:39,700 --> 00:19:41,700
لا يمكن أن تقع أخطاء

318
00:19:41,700 --> 00:19:44,200
.لا شيء غير مألوف على الأرض
كيف حال السّماء

319
00:19:41,780 --> 00:19:44,200
جماعة النّار
روجي هولاند

320
00:19:44,200 --> 00:19:46,040
لا خلل في الجوّ أيضاً

321
00:19:46,040 --> 00:19:48,830
لم تُرصَد ظِلال مشبوهة
أو تفاعُلات مع السّحر

322
00:19:49,250 --> 00:19:51,210
كلّ شيء آمن

323
00:19:51,210 --> 00:19:52,960
...التّحضيرات قد اكتملت

324
00:19:52,960 --> 00:19:54,340
لوغويل-ساما

325
00:19:59,180 --> 00:20:02,180
حان الوقت يا كاريوت-ساما

326
00:20:02,180 --> 00:20:03,680
أعلم

327
00:20:04,060 --> 00:20:07,440
لنبدأ باحتفال الحاجز

328
00:20:08,020 --> 00:20:09,730
!حسناً أيّها النّاس

329
00:20:09,730 --> 00:20:12,520
!من فضلكم رحّبوا بهم بأغنية مجيدة

330
00:20:12,520 --> 00:20:14,900
!وصل الماجيا فيندر

331
00:20:16,990 --> 00:20:18,570
!آرون-ساما

332
00:20:17,280 --> 00:20:18,450
!كاريوت-ساما

333
00:20:18,240 --> 00:20:20,410
!أخي، زيو

334
00:20:18,740 --> 00:20:21,450
!تحيا إيلينور-ساما

335
00:20:19,610 --> 00:20:21,070
!إيلفاريا-ساما

336
00:20:21,450 --> 00:20:24,790
والآن، أنا متأكّدة بأنّ بعضكم
،غارق في إحباط شديد

337
00:20:24,790 --> 00:20:27,540
وأنا متأكّدة بأنّ البعض عالق
بين جدران اليأس

338
00:20:31,420 --> 00:20:32,500
...إيلفي

339
00:20:33,800 --> 00:20:36,300
يجب ألّا ننسى أبداً

340
00:20:36,300 --> 00:20:40,840
حتّى الآن، ما زال المُضيف السّماويّ
!يستهدف عالمَنا

341
00:20:40,840 --> 00:20:44,850
!هذا النّعيم تحت الخطر حتّى الآن

342
00:20:48,850 --> 00:20:51,060
!يجب أن ندحر الشّرور

343
00:20:54,940 --> 00:20:58,610
نحن أيضاً، يجب أن نُساهم من جديد
!في دعم السّماء

344
00:21:04,240 --> 00:21:05,990
!ابدؤوا

345
00:21:05,990 --> 00:21:07,660
!تاج اللّهب

346
00:21:08,620 --> 00:21:10,210
كُرة الماء

347
00:21:10,920 --> 00:21:12,630
عرش البرق

348
00:21:12,960 --> 00:21:14,630
صولجان الرّياح

349
00:21:14,630 --> 00:21:18,130
!أقدّم مذبح الأرض

350
00:21:18,420 --> 00:21:21,470
افتح أيّها الظّلام البدائيّ

351
00:21:21,470 --> 00:21:26,640
ثمّ سيصبح الضّوء الحدّ الّذي يُمثّل
عدوّ السّماويّين

352
00:21:29,730 --> 00:21:35,650
فانديس تيرميناليا
التّعويذة العظمى: حاجز العصيّ الخمسة العظيم الّذي يُقسّم النّعيم

353
00:21:30,600 --> 00:21:32,400
...التّعويذة العظمى

354
00:21:33,100 --> 00:21:35,900
!فينديس تيرميناليا

355
00:21:36,400 --> 00:21:41,200
!خمسة، أربعة، ثلاثة، اثنان، واحد

356
00:21:43,280 --> 00:21:45,990
!عام جديد سعيد

357
00:21:48,750 --> 00:21:51,540
!الوداع للسّنة السّالفة

358
00:21:51,540 --> 00:21:54,290
!وأهلاً بكم في سنة جديدة

359
00:21:54,290 --> 00:21:57,300
!عسى أن يُباركك ميرسيديس

360
00:21:57,960 --> 00:21:59,590
!تهانينا يا ريغاردين

361
00:21:59,590 --> 00:22:02,430
!أهلاً بك في عام جديد كلّياً

362
00:22:13,310 --> 00:22:15,980
!عام جديد سعيد

363
00:22:17,820 --> 00:22:20,320
ماذا كان ذلك؟ مقلَب؟

364
00:22:20,320 --> 00:22:21,440
!كم هذا مُخيف

365
00:22:21,440 --> 00:22:22,820
هل هو أداء مهرجانيّ؟

366
00:22:23,110 --> 00:22:25,780
لا، لم يحدث شيء كهذا في العام الماضي

367
00:22:26,570 --> 00:22:28,910
ما تلك الدّوائر السّحريّة؟

368
00:22:28,910 --> 00:22:30,660
!أسرعوا وحدّدوا السّبب

369
00:22:33,790 --> 00:22:36,750
ماما، ما هذه؟

370
00:23:01,860 --> 00:23:06,530
بتنشيط الحاجز العظيم، استهلك الماجيا
فيندر كلّ سحرهم

371
00:23:06,530 --> 00:23:08,280
إنّهم خارج الخدمة لبعض الوقت

372
00:23:09,240 --> 00:23:11,540
حسناً إذاً، حان الوقت

373
00:23:22,510 --> 00:23:24,720
فلتبدأ حفلة الجحيم

374
00:23:36,520 --> 00:23:39,270
،الحلقة القادمة من ويستوريا: عصا وسيف

375
00:23:39,600 --> 00:23:42,610
"الحلقة 14، "حفلة الجحيم تبدأ

376
00:23:40,940 --> 00:23:45,950
الحلقة 14
حفلة الجحيم تبدأ