1
00:00:16,750 --> 00:00:20,370
أكره الماجيا فيندر

2
00:00:20,740 --> 00:00:23,630
،بسبب التّعويذة الّتي أطلقَتْها آلبيس فينا

3
00:00:23,630 --> 00:00:25,880
سيلحق بها ويل دوماً

4
00:00:25,880 --> 00:00:30,800
ومع ذلك هي لا تفعل شيئاً. إنّها
...تنتظر ببساطة في البرج، وهذا مُجرّد

5
00:00:31,700 --> 00:00:33,440
أشعر بالشّفقة على ويل

6
00:00:34,600 --> 00:00:36,450
أعلم

7
00:00:36,450 --> 00:00:39,140
أعلم بأنّني استخدمتُ تعويذة عليه

8
00:00:40,130 --> 00:00:42,150
...وبسبب ذلك السّحر

9
00:00:42,150 --> 00:00:47,400
بسبب اللّعنة الّتي أطلقتُها، كان
بين يتلقّى جروحاً ويعاني كثيراً

10
00:00:48,570 --> 00:00:50,650
...منذ تلك الدُّموع الّتي بدأتْ كلّ شيء

11
00:00:54,910 --> 00:00:58,660
إلى أيّ درجة جعلتُك تبكي؟

12
00:00:59,910 --> 00:01:02,160
هل كان ينبغي أن أهيج غضباً بدلاً من ذلك؟

13
00:01:02,920 --> 00:01:04,920
هل كان ينبغي أن أهرب؟

14
00:01:05,730 --> 00:01:08,070
هل كان ينبغي أن أتظاهر بعدم معرفة شيء

15
00:01:08,070 --> 00:01:10,930
وأحضنك بين ذِراعَي؟

16
00:01:20,830 --> 00:01:22,350
أنتِ مُخطئة تماماً

17
00:01:25,590 --> 00:01:28,250
أنا لا أكرهكِ يا إيلفي

18
00:01:29,870 --> 00:01:33,700
في الواقع، أنا السّبب وراء وحدتكِ

19
00:01:34,730 --> 00:01:36,760
...إذا كان عليّ أن أكره أحداً

20
00:01:37,330 --> 00:01:41,470
فهو أنا، ويل سيرفورت عديم الموهبة

21
00:01:44,350 --> 00:01:46,180
لهذا يجب أن أسرع

22
00:01:46,630 --> 00:01:48,200
وآتي إلى حيث أنتِ يا إيلفي

23
00:01:49,460 --> 00:01:54,760
...أريد الوقوف بجانبكِ يا إيلفي
والوفاء بوعدنا الثّمين

24
00:01:56,210 --> 00:01:58,400
،لأنّك تقول هذا الكلام

25
00:01:58,940 --> 00:02:02,390
،لأنّك تبتسم لي حتّى عند افتراقنا

26
00:02:03,520 --> 00:02:05,730
قرّرتُ أن أكبت مشاعري وأتحمّل هذا

27
00:02:06,680 --> 00:02:10,630
وذلك كي لا أنكث بوعدنا، وكي
أستطيع القول بأنّني انتظرتُك

28
00:02:10,990 --> 00:02:14,820
!أرجوكِ يا كيري! لا، الأستاذة العظيمة كيريدوين

29
00:02:14,820 --> 00:02:16,990
!أرشدي ويل أرجوكِ

30
00:02:16,990 --> 00:02:18,200
!مهلاً، مهلاً

31
00:02:18,200 --> 00:02:21,370
رغم أنّ هناك بعض الأوقات الّتي
استخدمتُ فيها علاقاتي سرّاً

32
00:02:22,310 --> 00:02:24,370
كنتَ تلحق بي بشكل بإخلاص

33
00:02:25,110 --> 00:02:27,380
ما الّذي يمكنني فعله لأجلك؟

34
00:02:28,040 --> 00:02:31,630
أريد أن أكون مُفيدة لك

35
00:02:32,340 --> 00:02:37,390
أنا متأكّدة بأنّ هذا ما تفكّر فيه الماجيا
!فيندر الّتي يمتلئ رأسها بالأحلام

36
00:02:37,390 --> 00:02:43,680
أريد مُساعدة ويل أيضاً
!يا أُستاذ واركنر

37
00:02:42,110 --> 00:02:46,010
في هذه الحالة، أنا مُتفاجئ من قولكِ
بأنّ أحداً آخر يمتلئ رأسه بالأحلام

38
00:02:46,780 --> 00:02:47,740
،بالنّسبة لبقيّتكم

39
00:02:47,740 --> 00:02:51,530
قُبِلتُم وانضممتُم لجماعات، لكنّكم
تتسلّلون وتخرجون من البرج

40
00:02:51,530 --> 00:02:54,300
لا أريد ترك ويل بعد

41
00:02:54,300 --> 00:02:56,920
أهمّية منصبي ثانويّة

42
00:02:59,690 --> 00:03:02,990
ما خطبكِ؟ تتصرّفين بغرابة

43
00:03:02,990 --> 00:03:04,840
لـ-لا تقلق

44
00:03:04,840 --> 00:03:07,590
هربتُ من الجماعة وحياتي على المحكّ

45
00:03:08,630 --> 00:03:11,050
مهلاً! ما الخطب يا ليهانا؟

46
00:03:12,740 --> 00:03:16,730
الطّنجرة... أقصد، ساحرة المِطرقة
بدأت بالتحرُّك

47
00:03:16,730 --> 00:03:19,550
إذا تركنا الأمور لها، سيكون ويل
ويوليوس بخير فحسب

48
00:03:19,550 --> 00:03:21,210
ساحرة المِطرقة؟

49
00:03:21,210 --> 00:03:24,390
هل تقصد إحدى الأساطير السّبعة للأكاديميّة

50
00:03:24,390 --> 00:03:26,450
!لا يمكننا أن ندع هذا الأمر لشخص آخر فحسب

51
00:03:26,450 --> 00:03:28,160
تعلم بأنّني أفهمك، أليس كذلك؟

52
00:03:28,160 --> 00:03:30,560
الأستاذ واركنر، أنت قلق على ويل

53
00:03:30,910 --> 00:03:33,230
تظلّ تزور البرجَ كزوجة تُقيم في مكانٍ بعيد

54
00:03:33,230 --> 00:03:34,970
حتّى لو رُفِضَ دخولك عند البوّابة

55
00:03:34,970 --> 00:03:37,090
!لا تقوليها بطريقة يُساء فهمها

56
00:03:37,090 --> 00:03:38,820
ما أدراكِ بذلك أصلاً؟

57
00:03:38,820 --> 00:03:40,480
!أخبرَتْني الآنسة كليري

58
00:03:41,340 --> 00:03:43,330
!زميلة الصّفّ الثّرثارة تلك

59
00:03:43,330 --> 00:03:45,740
نريد مُساعدة ويل كذلك

60
00:03:45,740 --> 00:03:47,800
لا حاجة لاتّخاذ أي إجراء

61
00:03:47,800 --> 00:03:48,710
شيون؟

62
00:03:48,710 --> 00:03:50,390
ما الّذي تقوله؟

63
00:03:50,390 --> 00:03:54,340
ألم تأتِ إلى هنا كي تُساهم
في إنقاذ ويل أيضاً؟

64
00:03:54,340 --> 00:03:57,340
أتيتُ للحرص على ألّا تفعلوا
أيّ شيء لا ضرورة له

65
00:03:57,340 --> 00:03:58,840
لمُراقبتكم

66
00:03:59,760 --> 00:04:03,600
،قيل له مِراراً بأنّه لا يمكن القيام بذلك
لكن انظروا إلى أين وصل

67
00:04:03,990 --> 00:04:06,980
حتّى في غفلة منّي، شقَّ
طريقَة بالقوّة بشكل أخرق

68
00:04:06,980 --> 00:04:08,730
وتغلّب على كلّ عقبة

69
00:04:09,410 --> 00:04:11,140
كُلّ ما علينا فعله هو الانتظار

70
00:04:11,140 --> 00:04:13,800
...سيتجاوز هذا أيضاً. فضلاً عن ذلك

71
00:04:14,510 --> 00:04:17,990
إذا ذهبَ أحدٌ إليه فجأة، فلن يتمكّن
من استعراض قدراته، أليس كذلك؟

72
00:04:18,880 --> 00:04:20,850
هل تقصد كساحر؟

73
00:04:23,980 --> 00:04:25,920
كرجُل

74
00:04:42,010 --> 00:04:46,720
الحلقة 22
آمِلٌ، مُتفتِّح، راعِد

75
00:06:17,770 --> 00:06:19,230
،إيما كليفر

76
00:06:19,230 --> 00:06:21,490
أمنحكِ برَكة الرّياح

77
00:06:26,990 --> 00:06:30,490
إيما كليفر
قُبِلَتْ في جماعة الرّياح

78
00:06:29,330 --> 00:06:30,490
!فعلتُها

79
00:06:32,750 --> 00:06:34,250
،مايك مايوس

80
00:06:34,250 --> 00:06:35,990
انضمّ لجماعة الظّلام

81
00:06:36,580 --> 00:06:40,710
مايك مايوس
قُبِلَ في جماعة الظّلام

82
00:06:39,650 --> 00:06:43,010
!حسناً! ها أنا ذا

83
00:06:47,270 --> 00:06:49,850
!ليريل مارس! غوردون فالي

84
00:06:49,850 --> 00:06:52,600
!كلاكما، توجّها إلى جماعة النّار

85
00:06:52,600 --> 00:06:55,600
!أجل! نجحنا

86
00:06:52,680 --> 00:06:55,600
ليريل مارس & غوردون فالي
قُبِلا في جماعة النّار

87
00:06:56,020 --> 00:06:57,600
فعلتُماها أخيراً إذاً؟

88
00:06:59,350 --> 00:07:01,040
!حسناً، تهانينا

89
00:07:00,470 --> 00:07:05,360
!فعلناها! أخيراً

90
00:07:01,040 --> 00:07:04,930
الرّجاء من كلّ شخص تلقّى برَكة
أن يبلغ جماعته المُنتسِب لها

91
00:07:05,970 --> 00:07:08,060
،في حين أنّ زيادة أعدادنا ضروريّة

92
00:07:08,060 --> 00:07:11,110
إلّا أنّ معايير كلّ جماعة للقبول
سهلة أكثر من اللّازم

93
00:07:11,110 --> 00:07:13,370
هؤلاء السّحرة المزعومون تخرّجوا
حديثاً من الأكاديميّة

94
00:07:13,690 --> 00:07:16,500
أيّها الأبله. تعلم بأنّ هذا
ليس اسم اللّعبة هنا

95
00:07:16,500 --> 00:07:19,010
،بعد حادث تيرميناليا

96
00:07:19,010 --> 00:07:22,760
أولئك الّذين تمّ تجاهلهم بواسطة كشّافينا
قد أصبحوا أكثر تكيُّفاً

97
00:07:23,400 --> 00:07:24,910
،لكن من وجهة نظري

98
00:07:24,910 --> 00:07:26,800
ما زالوا من عِرق أدنى

99
00:07:27,510 --> 00:07:30,550
كلّ واحد منهم حوّلَ المجهول إلى معروف

100
00:07:31,380 --> 00:07:33,290
عرفتُ بأنّ دفعهم نحو حافّة
الهاوية كان جيّداً

101
00:07:33,290 --> 00:07:37,060
حتّى الأغرار غير النّاضجين يمكنهم أن يصبحوا
طيوراً مُهاجرة، تُحلِّق في السّماء

102
00:07:37,500 --> 00:07:41,320
ولذا، الازدهار الثّاني على وشك
...أن ينتهي أيضاً، لكن

103
00:07:41,600 --> 00:07:43,570
!ويل ويوليوس لم يصلا بعد

104
00:07:43,880 --> 00:07:46,320
!على هذا المُعدّل، سيتمّ إقصاؤهما

105
00:07:46,880 --> 00:07:49,830
المزيد من الانتظار سيكون مضيَعة للوقت

106
00:07:49,830 --> 00:07:54,580
،على الأغلب فشِلا في رسم خطّة
فسقطا في وحل اليأس وهربا

107
00:07:54,580 --> 00:07:57,330
كيف لك أن تقول ذلك رغم أنّك أنت
من يعترض طريقهما؟

108
00:07:57,870 --> 00:08:02,680
أولئك الّذين يلوذون بالفرار من جحيم
المُثابرة هذا لا يحقّ لهم صعود البرج

109
00:08:02,680 --> 00:08:06,360
نحن، من المُؤسّسة العُليا، سوف
نتولّى الوصاية عليهما

110
00:08:07,070 --> 00:08:09,840
أعتقد بأنّه لا اعتراض لديكِ يا إيلفاريا-ساما؟

111
00:08:16,130 --> 00:08:18,600
!نأسف لتأخُّرنا

112
00:08:20,720 --> 00:08:22,340
!يوليوس رينبيرغ

113
00:08:22,340 --> 00:08:23,730
!ويل سيرفورت

114
00:08:23,730 --> 00:08:25,150
!حاضر

115
00:08:26,990 --> 00:08:28,000
!ويل

116
00:08:28,000 --> 00:08:28,990
!ويوليوس

117
00:08:31,720 --> 00:08:34,240
كيف يجرؤ مُجرّد جرذ اختبار أن يُسبّب
!متاعبَ لا ضرورة لها؟

118
00:08:35,740 --> 00:08:38,500
مُتطلّبات الاختيار هي نفسها
!في المرّة السّابقة

119
00:08:38,880 --> 00:08:40,750
!تأهُّلك كعصا مُشكّك به

120
00:08:43,020 --> 00:08:47,510
...ويل سيرفورت، الماجيا فيندر المُوقَّرون
أعتقد بأنّكم مُوافقون على هذا

121
00:08:51,740 --> 00:08:52,920
لا مانع لديّ

122
00:08:55,710 --> 00:08:56,600
!حاضر

123
00:08:57,800 --> 00:09:00,010
هل سيكون بخير حقّاً؟

124
00:09:00,010 --> 00:09:05,020
بعد كلّ ذلك، ما زلتُ لا أملك أدنى فكرة
فيما إذا كان يستطيع التحكُّم بويس

125
00:09:05,400 --> 00:09:08,530
هل سيكون من الأفضل أن أمدّه بسحري
دون أن ينكشف أمري؟

126
00:09:13,290 --> 00:09:16,260
يوليوس، أمنحك برَكة

127
00:09:16,260 --> 00:09:18,290
لا تُحاول فعل شيء. تعالَ إلى هنا فحسب

128
00:09:18,580 --> 00:09:20,790
...إيلفاريا-ساما! لكن هذا

129
00:09:21,070 --> 00:09:23,950
شكراً لك على مدّ ويل بقوّتك

130
00:09:23,950 --> 00:09:26,550
ينبغي أن تؤمن به أيضاً. ثِق بويل

131
00:09:36,740 --> 00:09:40,310
،إذا أهدرتَ كلّ العمل المُجدّ الّذي بذلتُه
لن أُسامحك أبداً. مفهوم؟

132
00:09:40,730 --> 00:09:42,710
!شكراً لك يا يوليوس

133
00:09:43,630 --> 00:09:45,560
!انتظريني يا إيلفي

134
00:09:48,160 --> 00:09:49,160
ابدأ

135
00:09:49,860 --> 00:09:55,130
من خلال سحري، ينبغي أن يكون
الطّريق إلى ويس مُمهَّداً بالفعل

136
00:09:56,380 --> 00:09:59,570
ينبغي أنّك تفهم الإجراء الآن

137
00:10:02,150 --> 00:10:04,220
لذا أرِني، اتّفقنا؟

138
00:10:04,220 --> 00:10:06,230
أرِني عالَماً جديداً كُلّياً لسيف

139
00:10:07,430 --> 00:10:08,670
تصوّره

140
00:10:09,610 --> 00:10:11,030
كِتاب واحد

141
00:10:15,920 --> 00:10:17,320
تذكّر

142
00:10:19,370 --> 00:10:20,670
جِده

143
00:10:20,980 --> 00:10:22,230
!احفر بعمق

144
00:10:22,970 --> 00:10:25,230
تتبَّع الطّريق الّذي سلكتَه
...للوصول إلى اليوم

145
00:10:27,730 --> 00:10:30,110
!تذكّر الأجزاء الّتي تحتاجها الآن

146
00:10:30,790 --> 00:10:32,620
!اكتمل شحن الذّاكرة

147
00:10:33,110 --> 00:10:36,330
!تياريس ويس: تلقيم

148
00:10:39,490 --> 00:10:40,400
ماذا؟

149
00:10:41,170 --> 00:10:42,500
نصل من ضوء؟

150
00:10:42,500 --> 00:10:45,490
لا، سيف سحر جليديّ؟

151
00:10:45,490 --> 00:10:46,500
مُستحيل

152
00:10:56,300 --> 00:10:57,640
غلاوس ويس

153
00:11:01,260 --> 00:11:02,520
تياريس ويس

154
00:11:06,980 --> 00:11:09,680
أطلقتِ تعويذةً عليّ

155
00:11:10,840 --> 00:11:13,670
لكن لم تكن لعنة

156
00:11:14,600 --> 00:11:16,110
...بدأناها معاً

157
00:11:16,670 --> 00:11:18,640
التّعويذة الّتي تُعرَف بالوعد

158
00:11:19,580 --> 00:11:22,240
الآن، تشعرين وكأنّكِ لم تتمكّني
،من فعل أيّ شيء

159
00:11:22,240 --> 00:11:25,120
لذا لعلّكِ تكرهين نفسكِ

160
00:11:25,810 --> 00:11:27,340
لكن هذا غير صحيح

161
00:11:27,340 --> 00:11:29,130
!غير صحيح إطلاقاً يا إيلفي

162
00:11:29,770 --> 00:11:32,130
منحتِني الكثير جدّاً

163
00:11:32,690 --> 00:11:35,630
منحتِني شجاعة لا محدودة

164
00:11:36,310 --> 00:11:38,460
لذا، هنا في النّهاية، أريدكِ أن تصمدي

165
00:11:39,460 --> 00:11:42,120
هنا في النّهاية، أريد أن أحاول
أن أبدو قويّاً

166
00:11:43,340 --> 00:11:46,050
...إلى يومنا هذا، منحتِني الكثير

167
00:11:48,830 --> 00:11:50,270
والآن أريد أن آتي إليكِ

168
00:12:02,470 --> 00:12:03,540
!إنّه قويّ

169
00:12:03,620 --> 00:12:07,710
ضابط مُرافق من جماعة البرق
غيلفورد زورغاس

170
00:12:03,940 --> 00:12:07,790
يبدو أضعف ممّا هو عندما يشحنه
...من مصدر خارجيّ، لكن

171
00:12:08,190 --> 00:12:11,360
رغم ذلك، قوّته التّدميريّة تتجاوز
قوّة سحر مُتوسّط المُستوى

172
00:12:11,870 --> 00:12:13,550
هذه مُفاجأة

173
00:12:20,530 --> 00:12:22,350
!كرّس مشاعرك فيه

174
00:12:23,950 --> 00:12:25,810
!انقلها إلى داخل سيفك

175
00:12:28,700 --> 00:12:29,600
!ويل

176
00:12:30,190 --> 00:12:32,110
!يروقني هذا

177
00:12:32,410 --> 00:12:35,610
العلامة الكاملة. اكتسبتَ وجهاً
باسماً يا ويل

178
00:12:37,030 --> 00:12:39,120
،بما أنّكِ كنتِ أنتِ من أرسله إلى البرج

179
00:12:39,120 --> 00:12:41,520
احترمتُ أمنياتكِ واكتفيتُ بالمُراقبة

180
00:12:41,890 --> 00:12:44,700
لكن أبليتِ بلاء مُمتازاً يا كيريدوين

181
00:12:45,830 --> 00:12:49,540
أو ينبغي أن أقول... يا مُديرة الأكاديميّة
السّحريّة كالدرون؟

182
00:12:50,280 --> 00:12:54,010
عندما أكون بهذه الهيئة، هلّا ناديتني
كيريدوين من فضلك؟

183
00:12:54,010 --> 00:12:56,900
إطلاق سحر الشّيخوخة على نفسي
مُرهق حقّاً

184
00:12:56,900 --> 00:12:59,070
فالحقيقة هي أنّني ما زلتُ
شابّة ومليئة بالحيويّة

185
00:13:00,300 --> 00:13:04,570
وأيضاً، هذا المكان مُحرَّم على أيّ شخص
غير السّحَرة، تعي ذلك؟

186
00:13:06,120 --> 00:13:08,520
،فات الأوان قليلاً على الإشارة إلى هذا
أليس كذلك أيّتها السّاحرة الّتي لا تشيخ؟

187
00:13:08,520 --> 00:13:12,770
فضلاً عن ذلك، كنتَ تعمل وراء الكواليس أيضاً

188
00:13:13,410 --> 00:13:18,280
كنتَ أنت من أعطى الأقزامَ جوهرة ويست
النّادرة، أليس كذلك؟

189
00:13:18,580 --> 00:13:21,050
إنّه مُستخدم جديد للعنصر الخامس

190
00:13:21,470 --> 00:13:25,280
يمكنكِ أن تغضّي النّظر عن هذه
الهديّة البسيطة، أليس كذلك؟

191
00:13:25,280 --> 00:13:28,540
ما زالت قدراته تتطوّر

192
00:13:28,540 --> 00:13:30,160
،بالنّسبة للتّلقيم بقوّته الخاصّة

193
00:13:30,160 --> 00:13:31,970
تضخيم طاقته ما زال رديئاً

194
00:13:32,870 --> 00:13:36,960
،لكن بالتّعزيز الفضّيّ المضبوط بويست
فهو يعمل بصورة جيّدة

195
00:13:38,010 --> 00:13:40,900
...يصبح شعره أبيض وفقدانه للذّاكرة

196
00:13:40,900 --> 00:13:44,210
،عندما يتعلّق الأمر باستخدام سيف هائل
فإنّ ويل مُبتدئ جدّاً حتّى الآن

197
00:13:44,210 --> 00:13:46,180
دفعَ ثمناً باهظاً

198
00:13:46,450 --> 00:13:49,770
لكن الآن، بعد ستّ سنوات من النموّ
،في الأكاديميّة

199
00:13:50,180 --> 00:13:53,070
أستطيع أخيراً تعليمه مُختلف الأمور

200
00:13:58,540 --> 00:14:03,610
هل ستكونين أنتِ من يُرينا المجهول
الّذي تسعى له كيريدوين؟

201
00:14:09,580 --> 00:14:11,120
لا أطيق الانتظار

202
00:14:12,790 --> 00:14:13,910
مُستحيل...

203
00:14:14,510 --> 00:14:15,130
ماذا؟

204
00:14:15,550 --> 00:14:16,380
هذا مُستحيل

205
00:14:16,850 --> 00:14:23,380
،هذا مُستحيل، مُستحيل، مُستحيل
...مُستحيل، مُستحيل

206
00:14:23,380 --> 00:14:25,640
!هذا مُستحيل

207
00:14:28,280 --> 00:14:29,640
كرويتز-ساما؟

208
00:14:30,510 --> 00:14:32,140
هزمَ الوحوش

209
00:14:34,500 --> 00:14:37,900
ليست شيئاً يستطيع الأقزام فعله

210
00:14:38,490 --> 00:14:42,150
فهمتُم أخيراً إذاً؟ طيشه المُطلَق

211
00:14:53,930 --> 00:14:56,070
عاد إلى شكله الأصليّ

212
00:14:56,850 --> 00:15:01,600
عندما أغذّيه بنفسي، فإنّ الطّاقة تُستنزَف
بشكل أسرع بكثير من شحنة عاديّة

213
00:15:02,090 --> 00:15:03,730
يجب أن أستعمله بحرص

214
00:15:04,170 --> 00:15:05,870
...ليس بعد

215
00:15:05,870 --> 00:15:08,300
!يجب ألّا نعترف به بعد

216
00:15:08,300 --> 00:15:10,180
!لا يمكننا اعتبار شيء كهذا سحراً

217
00:15:10,480 --> 00:15:13,680
كرويتز، أنت نيّقٌ فحسب الآن، أليس كذلك؟

218
00:15:13,680 --> 00:15:16,940
من أيّ ناحية؟ إذا كان هذا المجهول
،لا يمكن تفسيره

219
00:15:16,940 --> 00:15:18,810
!فهل ينبغي أن يُسمَح له بتسمية نفسه ساحراً؟؟

220
00:15:19,280 --> 00:15:23,150
وما احتمال أن يُعَدّ ذلك السّيف أداة سحريّة؟

221
00:15:23,150 --> 00:15:27,070
أثناء الازدهار، أيّ عتاد غير العِصيّ
!السّحريّة ممنوع منعاً باتّاً

222
00:15:27,070 --> 00:15:30,480
،حتّى لو افترضنا بأنّه لم ينتهك القواعد

223
00:15:30,480 --> 00:15:33,830
ما زالت هناك حاجة لتفتيش
!ويل سيرفورت جيّداً

224
00:15:34,320 --> 00:15:36,580
هذا صحيح بالفعل

225
00:15:37,050 --> 00:15:39,830
...لكن إذا اعتبرنا سيفَه هي عصاه

226
00:15:40,110 --> 00:15:43,130
على أيّ حال، لا ننكر بأنّ هذا
حدثٌ غير مسبوق

227
00:15:43,130 --> 00:15:45,590
يجب أن نتوخّى الحذر بينما نتحرّى حول الأمر

228
00:15:46,110 --> 00:15:48,220
قطعَ كلّ هذا الشّوط، وما زالوا يتجادلون؟

229
00:15:48,500 --> 00:15:52,560
هذا يُثبت كم أنّهم يعتبرون
ويل سيرفورت غريباً

230
00:15:52,860 --> 00:15:57,040
حتّى السّحَرة الرّفيعين من كلّ جماعة لا يستطيعون
أن يُحدّدوا كيفيّة التّعامل معه

231
00:15:58,540 --> 00:16:00,840
الوحيدون الّذين يستطيعون إحكام
السّيطرة على هذا المكان

232
00:16:00,840 --> 00:16:04,050
،هم أولئك الّذين يعتلون قمّةَ البرج
الماجيا فيندر

233
00:16:04,050 --> 00:16:09,020
لكن باعتبار أنّ ويل سيرفورت
،وإيلفاريا-ساما كعائلة واحدة

234
00:16:09,020 --> 00:16:12,180
من المُؤكَّد أنّ أيّ شيء تفعله
سيُعتبَر مُحاباة

235
00:16:14,320 --> 00:16:16,980
،قبل أن تنفجر إيلفاريا-ساما

236
00:16:16,980 --> 00:16:20,480
هل من طريقة للتّحالف مع ماجيا فيندر آخر؟

237
00:16:22,580 --> 00:16:24,510
لا جدوى من الكلام

238
00:16:27,470 --> 00:16:31,840
،إذا أردنا رؤية حقيقة هذا الرّجل
فهناك طريقة بسيطة لفعلها، صحيح؟

239
00:16:35,770 --> 00:16:37,020
زيو؟

240
00:16:37,460 --> 00:16:40,270
أيّها الطّفل المُدلّل. ضربة واحدة

241
00:16:41,640 --> 00:16:43,880
أثبِت لي بأنّك تستطيع تحمُّل ضربة واحدة

242
00:16:43,880 --> 00:16:47,290
،إذا استطعتَ الصّمود بعدها
!فسأكون بُرهانك

243
00:16:47,950 --> 00:16:50,490
اِزأر، سقوط البرق

244
00:16:50,490 --> 00:16:52,420
ترتيل مُختصَر جدّاً؟

245
00:16:52,420 --> 00:16:54,240
تعويذة برق مُنخفضة المُستوى؟

246
00:16:54,240 --> 00:16:55,990
!اهرب يا ويل

247
00:16:56,260 --> 00:16:58,280
زالغيا ساغا

248
00:17:02,500 --> 00:17:05,550
لا يمكن التصدّي لها. ولا مُراوغتها

249
00:17:05,550 --> 00:17:07,530
ما يعني بأنّني سأُباد تماماً

250
00:17:07,530 --> 00:17:09,090
...من أجل النّجاة

251
00:17:12,400 --> 00:17:16,510
!ويل

252
00:17:25,020 --> 00:17:27,560
...زالغيا ويس

253
00:17:29,830 --> 00:17:31,850
!المشحونة بالكامل

254
00:17:32,280 --> 00:17:34,550
سـ-سيف برق هائل؟

255
00:17:34,550 --> 00:17:37,290
ما الّذي يجري؟ ماذا فعل؟

256
00:17:37,630 --> 00:17:39,450
!التهمَ السّحر

257
00:17:39,860 --> 00:17:44,220
في لحظة إصابته بالهجمة، شحنَ
سيفه بها لامتصاص وقع الصّدمة

258
00:17:45,030 --> 00:17:47,550
،بالطّبع. لم يستطع امتصاصها كلّها

259
00:17:47,550 --> 00:17:51,360
لذا أحرقَ البرقُ الهائلُ الخاصّ بزيو
،ما بداخل ويل

260
00:17:51,360 --> 00:17:54,970
لكنّه أثبت بأنّه يستطيع تحمُّل طلقة
قاتلة لا يمكن تصدّيها أو مُراوغتها

261
00:18:01,660 --> 00:18:03,480
!فعلتَها ونجوت أيّها الطّفل المُدلَّل

262
00:18:04,260 --> 00:18:05,980
!نجوتَ من ضربتي

263
00:18:06,380 --> 00:18:08,230
!رأيتم ذلك جميعاً، أليس كذلك؟

264
00:18:08,230 --> 00:18:11,730
تلقّى طلقةً من ماجيا فيندر
!وما زال واقفاً

265
00:18:12,240 --> 00:18:14,290
!لا يوجد دليلٌ أفضل من ذلك

266
00:18:14,740 --> 00:18:16,850
أعترف بك

267
00:18:16,850 --> 00:18:19,240
أنت لا تنتمي للقاع

268
00:18:19,710 --> 00:18:22,250
!شُقّ طريقك نحو القمّة يا ويل سيرفورت

269
00:18:22,780 --> 00:18:25,260
!انتظر أرجوك يا زيو-ساما

270
00:18:25,260 --> 00:18:27,690
الازدهار هو حدثٌ وقور حيث يتمّ
تحديد الجماعات

271
00:18:27,690 --> 00:18:30,260
—التأهُّل بطريقةٍ كهذه

272
00:18:31,940 --> 00:18:34,510
إذاً يمكنك أن تتلقّى طلقة
منّي أيضاً، صحيح؟

273
00:18:36,210 --> 00:18:39,760
مُحال أن يستطيع هو فلا تستطيع أنت، صحيح؟

274
00:18:40,210 --> 00:18:42,180
،إن لم تنجُ من هذه

275
00:18:42,180 --> 00:18:45,520
"تنتهي صلاحيّة "قيمتك المُثبَتة
يا ذا النظّارة الحقير

276
00:18:48,960 --> 00:18:53,650
أ-أعترف بحقّ تواجُد ويل سيرفورت هنا

277
00:18:58,320 --> 00:19:00,160
...إ-إذاً هذا يعني

278
00:19:00,880 --> 00:19:02,160
!ويل سيرفورت

279
00:19:02,870 --> 00:19:05,530
!أنت مُؤهَّل رسميّاً ليتمّ ضمّك إلى جماعة

280
00:19:12,540 --> 00:19:13,840
!إيلفاريا-ساما

281
00:19:19,030 --> 00:19:20,850
!إ-إيلفي؟

282
00:19:20,850 --> 00:19:25,100
!أنا مسرورة... مسرورة جدّاً

283
00:19:31,740 --> 00:19:34,110
أنا آسفة لأنّني لم أستطع فعل شيء

284
00:19:34,870 --> 00:19:36,970
لا تعتذري رجاء يا إيلفي

285
00:19:37,510 --> 00:19:38,870
ابتسمي بدلاً من ذلك

286
00:19:42,080 --> 00:19:42,970
أنا هنا

287
00:19:43,420 --> 00:19:45,800
أنا هنا حيث انتظرتِني طوال هذا الوقت

288
00:19:56,940 --> 00:20:00,850
إيلفي! أعدكِ بأنّني سأصل
!إلى البرج أيضاً

289
00:20:00,850 --> 00:20:03,500
!لنذهب ونرَ شروق الشّمس معاً

290
00:20:03,930 --> 00:20:05,080
!سأكون في الانتظار

291
00:20:05,520 --> 00:20:08,230
!مهما طالَ ذلك

292
00:20:10,850 --> 00:20:15,120
كنتُ أنتظرك لمدّة طويلة، وطويلة جدّاً

293
00:21:41,610 --> 00:21:42,990
ويستوريا: عصا وسيف

294
00:21:45,740 --> 00:21:51,250
لا حاجة للكلام حقّاً، لكن ما الجماعة
الّتي ستنضمّ لها يا ويل سيرفورت؟

295
00:21:52,190 --> 00:21:53,420
—سأذهب إلى جماعة إيلـ

296
00:21:53,420 --> 00:21:54,130
لا

297
00:21:56,110 --> 00:21:57,890
سآخذ هذا الفتى

298
00:22:00,910 --> 00:22:04,900
ماذا تقول؟ ألا تفهم الأجواء؟
هل أنت أحمق؟ هل أنت غبيّ؟

299
00:22:04,900 --> 00:22:08,770
هل أنت لصّ؟ هل أنت عشيق؟
هل أنت زنديق؟ هل أنت مُجرم؟

300
00:22:08,130 --> 00:22:10,150
!إيلفي، اهدئي

301
00:22:08,770 --> 00:22:11,030
هل تريد أن تُجمَّد وتُدمَّر؟

302
00:22:11,100 --> 00:22:12,600
—جـ-جماعة إيلفي

303
00:22:13,600 --> 00:22:15,100
...جـ-جماعة

304
00:22:17,650 --> 00:22:18,480
!ويل

305
00:22:20,110 --> 00:22:21,820
حقّاً؟

306
00:22:21,820 --> 00:22:24,120
تريد الانضمام لجماعتي؟

307
00:22:24,120 --> 00:22:25,950
!حُسِم الأمر إذاً

308
00:22:25,950 --> 00:22:27,700
!كفى هُراء

309
00:22:28,030 --> 00:22:29,830
!أطلق سراح ويل

310
00:22:30,210 --> 00:22:33,040
ما-ما معنى هذا؟ ما الّذي يجري؟

311
00:22:33,040 --> 00:22:36,210
أعتقد بأنّه استقطاب لذوي الكفاءة

312
00:22:36,980 --> 00:22:39,340
...روز، إ-إن كان هذا صحيحاً

313
00:22:39,700 --> 00:22:41,920
ألا ينبغي لجماعة الأرض أن تُشارك
!في هذا أيضاً؟

314
00:22:41,920 --> 00:22:43,510
!ويل مُذهل حقّاً

315
00:22:43,510 --> 00:22:46,310
هذا لأنّني أريد أن أكون معه
!في البرج أيضاً

316
00:22:46,310 --> 00:22:47,920
اهدئي، اهدئي

317
00:22:48,650 --> 00:22:50,860
ما الّذي تحاول فعله يا زيو؟

318
00:22:50,860 --> 00:22:54,270
لم تكن من الّذين حاولوا
اختياره أبداً، أليس كذلك؟

319
00:22:54,270 --> 00:22:56,410
قرّرتُ بأنّني أريده

320
00:22:56,410 --> 00:22:58,770
هذا كُلّ شيء. أليس هذا واضحاً؟

321
00:23:00,920 --> 00:23:04,980
لا يمكنك تقييد الرّغبة. هذا
هو قانوني الشّخصيّ

322
00:23:04,980 --> 00:23:08,960
،سواء كانت ثروة، أو كحولاً، أو نساء
أو رجالاً... إن أردتُ شيئاً، أحصل عليه

323
00:23:08,960 --> 00:23:11,740
إن لم أفعل، فلا أكون أنا

324
00:23:11,740 --> 00:23:13,110
همجيّ

325
00:23:13,500 --> 00:23:17,250
!يا له من تفكير منطقيّ وجميل

326
00:23:18,520 --> 00:23:20,000
!يا للمُصادفة

327
00:23:21,940 --> 00:23:25,880
ويل هو الشّيء الوحيد الّذي لا أنوي
التخلّي عنه لصالح أحد

328
00:23:26,800 --> 00:23:30,250
!وإذا اعترضَ أحدٌ طريقي، سأسحقه

329
00:23:36,850 --> 00:23:39,650
،الحلقة القادمة من ويستوريا: عصا وسيف

330
00:23:39,650 --> 00:23:42,810
"الحلقة 23، "زئير الجليد والبرق

331
00:23:40,480 --> 00:23:45,990
الحلقة 23
زئير الجليد والبرق