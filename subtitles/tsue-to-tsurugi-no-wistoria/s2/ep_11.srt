1
00:00:01,660 --> 00:00:02,800
حيوان

2
00:00:03,510 --> 00:00:05,990
مُتغطرس بالنّسبة لهمجيّ

3
00:00:06,630 --> 00:00:09,840
غير مُثقّف، ويخلو من أي جوهر

4
00:00:10,570 --> 00:00:13,490
مُجرّد رؤيته تجعلني أرغب في التقيُّؤ

5
00:00:13,740 --> 00:00:17,950
هذا يكفي يا عجوز. الأقزام مُفيدون

6
00:00:17,950 --> 00:00:21,380
ما السّبب في عدم ضمّهم
كجزء من البرج؟

7
00:00:21,380 --> 00:00:24,250
إنّهم شعبٌ لا يستطيع استخدام السّحر

8
00:00:24,500 --> 00:00:26,880
لكنّهم ليسوا عاجزين

9
00:00:26,880 --> 00:00:28,750
،إذا وثقت بهم بما يكفي لجعلهم يُنقّبون الأرض

10
00:00:28,750 --> 00:00:32,260
فسيكونون أكثر نفعاً بإطلاق
عنانهم في الدّيماس

11
00:00:32,260 --> 00:00:37,770
إذا كان كبرياؤك السّخيف يمنعك
من الاستفادة منهم، فسأفعلها أنا

12
00:00:38,060 --> 00:00:42,690
مُراقبة العالم يتدمّر لأنّنا لم نستخدم ما توفّر
بين أيدينا لن تكون مُمتعة إطلاقاً

13
00:00:43,200 --> 00:00:44,520
...أم

14
00:00:44,900 --> 00:00:47,370
تريد أن تقول لي بأنّه يوجد سبب
آخر وراء ذلك؟

15
00:00:49,900 --> 00:00:51,580
لن أُخبرك

16
00:00:54,030 --> 00:00:55,720
حقّاً؟

17
00:00:57,150 --> 00:00:59,250
ماذا تحاول أن تفعل أيُّها الهمجيّ؟

18
00:00:59,500 --> 00:01:03,380
...تُرخي سِلاحك بهذه السّرعة
هل كان كلّ ذلك كذبة فارغة؟

19
00:01:03,900 --> 00:01:07,380
لم يقل، "لا يوجد سبب"، أو حتّى
"لا أستطيع إخبارك"

20
00:01:07,770 --> 00:01:09,590
"قال، "لن أُخبرك

21
00:01:10,280 --> 00:01:13,660
هذا يعني أنّه لم يحن الوقت لشرح
كُلّ شيء علناً، أليس كذلك؟

22
00:01:15,060 --> 00:01:18,160
لكن أحياناً، غريزته دقيقة بشكل غريب

23
00:01:18,630 --> 00:01:23,480
إذا كان هذا سيُساهم في سحق المُضيف
السّماويّ، فسألتزم الصّمت حوله

24
00:01:24,010 --> 00:01:27,650
،لكن إذا لم نستطع القضاء عليه
فهُنا سوف أضع حدّاً

25
00:01:29,710 --> 00:01:36,160
إنّ لجم ذلك الحيوان مهمّةٌ صعبة
حتّى بالنّسبة للعرش العظيم

26
00:01:39,000 --> 00:01:44,100
سلوكه مُستفزّ جدّاً للعالم السّحريّ

27
00:01:44,920 --> 00:01:47,370
تماديت كثيراً يا زيو

28
00:01:47,370 --> 00:01:50,330
تحدّيك لآرون-ساما يجعلني أُشكّك
بسلامة عقلك

29
00:01:51,390 --> 00:01:53,430
أنا من ينبغي أن يقول لك ذلك

30
00:01:53,430 --> 00:01:57,760
،أنت تعلم بأنّنا إذا استمررنا هكذا
فسوف نخسر، لِذا لِمَ لا تتغيّر؟

31
00:01:57,760 --> 00:02:01,430
إن تصدّوا لك، فإنّ المُمارسات الشّائعة
والنُّظُم المُحدّدة هي مُجرّد عبء

32
00:02:01,880 --> 00:02:05,500
لا سيّما نِظام القِيَم هذا
الّذي يملكه السّحَرة

33
00:02:07,350 --> 00:02:10,470
يجب أن تُذكّر نفسك دوماً بأنّك ماجيا فيندر

34
00:02:10,470 --> 00:02:12,440
شرحتُ الأمر لك مؤخّراً، أليس كذلك؟

35
00:02:12,440 --> 00:02:13,450
أريد هذا

36
00:02:13,740 --> 00:02:14,950
لا أريد هذا

37
00:02:15,380 --> 00:02:17,830
هذا كُل ما تقتصر عليه الحياة

38
00:02:18,630 --> 00:02:24,330
طريقته في الحياة تِرهُقني، لكنّها
تجعلني أشعر بغيرة طفيفة

39
00:02:25,770 --> 00:02:28,840
من الجيّد ألّا يحتاج الأغبياء للتّفكير
في أيّ شيء، أليس كذلك يا زيو؟

40
00:02:28,840 --> 00:02:31,950
كُلّ ما في الأمر هو أنّكم تُفكّرون
زيادة عن اللّزوم، هذا ما في الأمر

41
00:02:31,950 --> 00:02:34,810
سأتحرّك وفق ما تُوجّهني رغباتي

42
00:02:35,220 --> 00:02:39,340
بالفعل. الغبيّ الّذي لا يملك قوّة
هو ببساطة عامّي أحمق

43
00:02:39,340 --> 00:02:42,440
...لكن الأحمق الّذي يملك قوّة

44
00:02:43,230 --> 00:02:44,640
غاية في الخطورة

45
00:02:47,130 --> 00:02:49,740
لا مُشكلة إذا كان حليفاً

46
00:02:49,740 --> 00:02:52,790
...لكن عندما يصبح عدوّاً

47
00:02:52,790 --> 00:02:56,230
،عصا ملِك البرق، ثورزيوس رينبولت

48
00:02:56,230 --> 00:02:58,690
تتحوّل إلى أسوأ أنواع العقبات

49
00:03:00,960 --> 00:03:02,950
سآخذ هذا الفتى

50
00:03:04,300 --> 00:03:05,210
هذا صحيح

51
00:03:06,550 --> 00:03:08,650
!مثلما يفعل الآن

52
00:04:41,060 --> 00:04:42,810
يا لها من صدفة

53
00:04:42,810 --> 00:04:47,020
ويل هو الوحيد الّذي لا أنوي
التّنازل عنه لأحد

54
00:04:47,340 --> 00:04:49,940
!وإذا اعترض أحدٌ طريقي، سأسحقه

55
00:04:51,230 --> 00:04:53,060
!يُلائمني هذا أيّتها الفتاة الجسورة

56
00:04:53,060 --> 00:04:54,260
!لنفعلها

57
00:04:54,260 --> 00:04:57,190
إنّه ينتمي للرّابح. ليس لديك
اعتراض، صحيح؟

58
00:04:57,190 --> 00:04:58,820
!مُوافقة

59
00:04:58,820 --> 00:05:01,390
!أقول لكما بأنّ هذا جنون

60
00:05:01,390 --> 00:05:03,820
!نِزال بين ماجيا فيندر؟

61
00:05:03,820 --> 00:05:06,330
من فضلكما، لِمَ لا تحاولان إيقافهما أيضاً؟

62
00:05:06,330 --> 00:05:08,480
أؤكّد لكِ، لا طائل من ذلك

63
00:05:08,480 --> 00:05:12,960
حتّى لو تدخّلنا، فذلك سيؤخّر
المُشكلة ليس إلّا

64
00:05:13,260 --> 00:05:16,490
إذا حاولت تلك المرأة الكسولة والهمجيّ
،قتل بعضهما الآخر

65
00:05:16,490 --> 00:05:18,310
فذلك سيُخفّف حرقة المعدة لديّ أيضاً

66
00:05:18,310 --> 00:05:19,590
!لا تقولي ذلك

67
00:05:21,590 --> 00:05:24,370
ساريسا، من فضلك اعتني بويل

68
00:05:25,100 --> 00:05:27,040
!ما-ماذا؟ لحظة

69
00:05:31,640 --> 00:05:34,180
لـ-لحظة، هل هما جادّان؟

70
00:05:34,180 --> 00:05:37,730
،رغم أنّهما قدوة العالم السّحريّ
...شيء سخيف كهذا يدفعهما

71
00:05:37,730 --> 00:05:41,320
ما باليد حيلة! هكذا هُم الماجيا فيندر

72
00:05:43,740 --> 00:05:44,870
ما الإشارة؟

73
00:05:44,870 --> 00:05:46,740
!لا حاجة لذلك. تعالي إليّ

74
00:05:46,740 --> 00:05:48,740
!مهلاً! هذا ليس وقت النّوم

75
00:05:49,030 --> 00:05:50,190
!استيقظ

76
00:05:51,660 --> 00:05:53,610
...إيل غلاسي فروسّي

77
00:05:55,240 --> 00:05:56,500
السّابعة

78
00:06:02,440 --> 00:06:04,640
!فريوزيل كاردينيا

79
00:06:13,640 --> 00:06:14,520
...بدأتْ

80
00:06:14,520 --> 00:06:15,560
بكلّ هذا؟

81
00:06:19,170 --> 00:06:20,940
أين تُصوّبين؟

82
00:06:21,380 --> 00:06:22,440
سقوط

83
00:06:26,700 --> 00:06:28,290
!إيلفاريا-ساما

84
00:06:38,210 --> 00:06:39,460
آرس وايس؟

85
00:06:39,740 --> 00:06:41,000
متى أطلقتْ ذلك؟

86
00:06:41,460 --> 00:06:46,030
.في البداية، مع كاردينيا
في اللّحظة الّتي غُشيَتْ فيه عيناه

87
00:06:46,030 --> 00:06:50,600
سرعة تفعيل سحر إيلفاريا-ساما
هي الأفضل في البرج

88
00:06:50,860 --> 00:06:53,850
،وبالنّسبة لاستعمال القسوة مع الأعداء

89
00:06:54,250 --> 00:06:56,040
فهي الأولى بين الماجيا فيندر
في ذلك أيضاً

90
00:06:57,350 --> 00:06:59,800
لن أدعك تحصل على ويل أبداً

91
00:07:00,230 --> 00:07:02,900
أرمينتا آوليسكاس

92
00:07:06,030 --> 00:07:07,610
!نيران سريعة دون تعزيم؟

93
00:07:07,610 --> 00:07:11,120
ولأجل تعويذة رفيعة المُستوى ذات تعزيم
مُؤلّف من أكثر من عشرة مقاطع؟

94
00:07:11,710 --> 00:07:16,080
في الطّابق 11، واجهتُ صعوبة بالغة لإطلاق
...آوليسكاس. لكنّها وبلمح البصر

95
00:07:16,820 --> 00:07:18,630
!هذا غير منطقيّ

96
00:07:21,630 --> 00:07:23,630
ريفيلّي كالانتيبيوم

97
00:07:23,630 --> 00:07:25,260
ستيلّاس ناتيا

98
00:07:28,880 --> 00:07:32,200
وابل غزير من الهجمات بالتّعاون مع نُسخها

99
00:07:32,730 --> 00:07:35,890
يبدو أنّها اليوم تبذل مجهوداً أكبر من المعتاد

100
00:07:35,890 --> 00:07:39,560
تكمُن قوّتها دوماً في سرعة
المقذوف ودقّته

101
00:07:39,970 --> 00:07:44,040
،في معركة إطلاق سحر بعيد المدى
كما هو مُتوقَّع، لدى إيلفاريا الأفضليّة

102
00:07:44,680 --> 00:07:47,150
لكن ثمّة وحش هناك أيضاً

103
00:07:49,630 --> 00:07:51,280
مُرتفعة جدّاً وعظيمة

104
00:07:57,710 --> 00:07:59,670
فالغان فلودي

105
00:08:04,300 --> 00:08:09,050
أهذا كلّ ما لديكِ، أيّتها
المرأة سليطة اللّسان؟

106
00:08:10,190 --> 00:08:11,930
!أنتِ الأخيرة

107
00:08:13,010 --> 00:08:15,110
!زالغيا ساغا

108
00:08:16,020 --> 00:08:18,150
هذه نُسخة أيضاً؟

109
00:08:18,150 --> 00:08:19,790
...الحقيقيّة

110
00:08:19,790 --> 00:08:21,520
!أعلى حتّى

111
00:08:21,520 --> 00:08:25,350
كافّة الهجمات والدّفاع حتّى هذه اللّحظة كانت
للسّماح للحقيقيّة منها للهرب نحو الأعلى

112
00:08:25,350 --> 00:08:28,780
فصل افتتاحيّ للسّماح باستخدام
هجمتها الحقيقيّة

113
00:08:29,130 --> 00:08:33,780
وفعلَتْها أثناء الحفاظ على نسخة دقيقة
جدّاً لدرجة أنّها اعتُبِرَتْ ماجيا فيندر

114
00:08:33,780 --> 00:08:37,540
استخدام الاختباء للبحث التحايُليّ
كان مُجرّد إضافة بسيطة

115
00:08:39,850 --> 00:08:43,850
هل استمتعت بلعبة جمع الدُّمى معي؟

116
00:08:44,660 --> 00:08:47,460
دائرة: أون، اتّصال كامل

117
00:08:48,030 --> 00:08:50,220
!غراند غلاست، دوديكرا

118
00:08:51,620 --> 00:08:53,470
!هذا ممتاز جدّاً

119
00:08:57,220 --> 00:08:58,730
!ا-انصبوا حواجز جداريّة

120
00:09:03,960 --> 00:09:06,020
د-دوائر مغلولة؟

121
00:09:06,020 --> 00:09:10,490
استخدام نُسخها المُدمَّرة لمُضاعفة
...قوّة هجمتها هو

122
00:09:10,810 --> 00:09:14,620
حتّى ماجيا فيندر كان ليُقذَف
بعيداً بواسطة هذا، صحيح؟

123
00:09:15,120 --> 00:09:16,620
لا

124
00:09:17,700 --> 00:09:21,340
اللّعب مع الدُّمى غير مُرضٍ إطلاقاً

125
00:09:27,750 --> 00:09:29,510
!انتبهي

126
00:09:30,380 --> 00:09:31,410
أنتِ

127
00:09:33,030 --> 00:09:34,890
اسقطي أوّلاً

128
00:09:54,280 --> 00:09:55,870
!إيلفاريا-ساما

129
00:10:01,070 --> 00:10:03,250
!سأخطف ذلك الفتى من بين يديك

130
00:10:11,910 --> 00:10:15,140
إنّه ساحر، لكنّه بدأ بإجبارها
على القتال عن كثب

131
00:10:15,420 --> 00:10:19,010
ما هذا؟ ليهانا، هل يمتلك سحرَ قتال
من مسافات قريبة مثلك؟

132
00:10:19,280 --> 00:10:20,420
لا

133
00:10:20,420 --> 00:10:23,820
إنّه ببساطة يسمح لطاقته
السّحريّة تتناثر منه

134
00:10:23,820 --> 00:10:25,540
تماماً

135
00:10:25,540 --> 00:10:27,740
راقبي جيّداً يا أوينزوس

136
00:10:27,740 --> 00:10:32,280
هذا هو المثال الّذي ينبغي لنا نحن
في جماعة البرق أن نحتذي به

137
00:10:32,560 --> 00:10:34,820
،حتّى دون الاعتماد على تقنيّات الإطلاق

138
00:10:34,820 --> 00:10:38,280
بمُجرّد تحرير طاقته السّحريّة، يصبح
كُلّ شيء خلفه مُجرّد أثر بعيد

139
00:10:38,280 --> 00:10:40,860
بالنّسبة لزيو-ساما، هذا ببساطة
شكل من أشكال السّفر

140
00:10:41,540 --> 00:10:45,540
سُمِّي ذلك بسقوط البرق نظراً للرُّعب والذّهول
الّذي يزرعه لدى الآخرين

141
00:10:46,010 --> 00:10:50,740
هجوم برق زيو يتفوّق حتّى
على سرعة سحر إيلفاريا

142
00:10:51,360 --> 00:10:56,380
،لا يمكن قياسها بالمنطق وحده
تلك الموهبة المُطلَقة البالغة

143
00:10:57,150 --> 00:11:01,810
أبغضه! فهذا يرمز إلى كلّ
!شيء لا يمكن قياسه

144
00:11:02,090 --> 00:11:04,560
...هذا هو الماجيا فيندر إذاً

145
00:11:05,550 --> 00:11:10,500
ثورزيوس رينبولت، زيو ثورزيوس رينبولت

146
00:11:22,390 --> 00:11:24,330
!فالغنار دونّر

147
00:11:33,630 --> 00:11:34,340
!فرال

148
00:11:36,470 --> 00:11:38,470
!ابتعدوا عن طريقي

149
00:11:45,680 --> 00:11:48,270
من سيربح برأيك يا فين؟

150
00:11:48,570 --> 00:11:49,650
زيو

151
00:11:51,430 --> 00:11:55,900
إذا كانت إيلفاريا، الّتي أنشأت اِثنَي عشر تعويذة
،جديدة، عبقريّة في التّعويذ

152
00:11:56,240 --> 00:11:58,660
فإنّ زيو شخصيّة عظيمة في التّطبيق العمليّ

153
00:12:00,530 --> 00:12:02,530
إذاً أنتِ نسخة أيضاً؟

154
00:12:02,530 --> 00:12:04,420
!زيلونيا كاوليس

155
00:12:11,960 --> 00:12:14,580
أداء حركات الخفّة هو من الأشياء
الّتي تبرعين فيها

156
00:12:15,250 --> 00:12:17,570
متى تبادلتُما الأماكن؟

157
00:12:22,800 --> 00:12:25,890
هل نسخكِ على وشك أن تنفد أيضاً؟

158
00:12:40,070 --> 00:12:42,240
ستكتفين بالتجوُّل من مكان لآخر؟

159
00:12:47,410 --> 00:12:52,160
أعمق ديماس وصلَ إليه هو الثّاني
بعد آرون، الطّابق 48

160
00:12:52,160 --> 00:12:56,570
قدراته مُختصّة جدّاً في القتال الفعليّ

161
00:13:10,390 --> 00:13:15,100
إنّه عصا سحريّة، لكن حالته الطّبيعيّة
أقرب إلى سيف

162
00:13:15,820 --> 00:13:22,010
بصراحة، أعتقد بأنّ الانضمام لزيو سوف
يخدم ويل بشكل أفضل. مُجرّد رأي

163
00:13:22,660 --> 00:13:24,430
،القتال من مسافات بعيدة هو شيء آخر

164
00:13:24,430 --> 00:13:27,410
لكن في القتال من مسافات قريبة، تُعدّ
إستراتيجيّات زيو في القمّة

165
00:13:27,410 --> 00:13:29,910
هل حُسِمَ هذا الأمر بهذه السّرعة؟

166
00:13:33,720 --> 00:13:34,990
ليفيا

167
00:13:34,990 --> 00:13:38,380
لماذا إيلينور-ساما عابسة هكذا؟

168
00:13:38,850 --> 00:13:40,950
...في الواقع يا آنسة فيلفيس

169
00:13:40,950 --> 00:13:43,920
،في حين أنّه كان في سحر الجليد فقط

170
00:13:43,920 --> 00:13:46,390
مُنيت إيلينور-ساما بهزيمة
،نكراء بواسطة آلبيس فينا

171
00:13:46,390 --> 00:13:49,260
لذا هي لا تريدها أن تربح، لكنّها
أيضاً لا تريدها أن تخسر

172
00:13:49,260 --> 00:13:51,140
إنّها حالة ذهنيّة مُعقّدة

173
00:13:51,610 --> 00:13:52,650
هكذا إذاً

174
00:13:52,650 --> 00:13:54,400
!اصمتا يا فتاتان

175
00:13:59,780 --> 00:14:01,240
...إيلفاريا-ساما

176
00:14:02,490 --> 00:14:04,650
!أنت! استيقظ فحسب

177
00:14:04,650 --> 00:14:07,740
إن استمرّت الأمور هكذا، فإنّ
!إيلفاريا-ساما سوف تُهزَم

178
00:14:08,190 --> 00:14:10,410
،إن كان هناك ما قد يمدّها بالقوّة

179
00:14:10,410 --> 00:14:12,250
!فإنّ صوتك هو الوحيد الّذي لدينا

180
00:14:14,550 --> 00:14:16,880
...إيلفي

181
00:14:22,590 --> 00:14:24,340
هل انتهيتِ؟

182
00:14:24,340 --> 00:14:28,510
إذاً سوف آخذ سيفكِ هذا

183
00:14:38,200 --> 00:14:39,030
ماذا؟

184
00:14:41,050 --> 00:14:43,130
يبدو أنّ الأمر لم ينتهِ بعد يا فين

185
00:14:43,780 --> 00:14:47,410
يبدو أنّ تلك الفتاة مثل ويل تماماً

186
00:14:47,750 --> 00:14:49,160
لن أتخلّى عنه

187
00:14:49,530 --> 00:14:53,040
لن أتخلّى عن ويل الّذي يخصّني
!لشخص مثلك

188
00:14:53,300 --> 00:14:55,250
!يمكنكِ أن تزأري إذاً

189
00:14:55,250 --> 00:14:58,790
!هذه أوّل مرّة أراكِ فيها تغلين هكذا

190
00:14:58,790 --> 00:15:02,300
ما الّذي يدفعكِ إلى هذا الحدّ؟

191
00:15:05,810 --> 00:15:06,660
!الحُبّ

192
00:15:07,710 --> 00:15:08,730
ماذا؟

193
00:15:11,170 --> 00:15:13,810
ويل حماني

194
00:15:14,640 --> 00:15:17,180
ويل لَحِقَ بي

195
00:15:18,430 --> 00:15:23,200
!لطالما وفى ويل بالوعد الّذي قطعه معي

196
00:15:23,690 --> 00:15:25,450
...لهذا السّبب، هذه المرّة

197
00:15:25,450 --> 00:15:26,920
!حان دوري

198
00:15:27,790 --> 00:15:31,080
!حُبّي لويل لن يخسر أمام أحد

199
00:15:32,220 --> 00:15:34,330
هذه هي رغبتكِ إذاً، أليس كذلك؟

200
00:15:37,080 --> 00:15:38,960
في هذه الحالة، أريني

201
00:15:40,320 --> 00:15:42,920
!أريني تلك القوّة السّخيفة

202
00:15:44,920 --> 00:15:47,220
سقوط صاعقة زيو سريعة بشكل خارق

203
00:15:47,220 --> 00:15:49,950
بتمرير التيّارات الكهربائيّة
،عبر جسده بالكامل

204
00:15:49,950 --> 00:15:54,370
،تتعزّز سرعة حركاته واستجابته
...لذا عندما يُهاجم

205
00:15:54,370 --> 00:15:56,480
يعجز السّحرةُ عن مُواكبته بشكل كامل

206
00:15:57,200 --> 00:15:57,980
...لكن

207
00:15:57,980 --> 00:16:00,110
...إيل غلاسي فروسّي

208
00:16:00,370 --> 00:16:01,590
العاشرة

209
00:16:02,420 --> 00:16:05,260
،إذا تجمّدَت كلّ تلك الصّاعقة المُسرَّعة

210
00:16:05,260 --> 00:16:06,960
فلا ينطبق أيّ شيء من ذلك

211
00:16:08,510 --> 00:16:10,700
!ميرداس فريدوليتي

212
00:16:11,620 --> 00:16:13,320
...أنتِ

213
00:16:13,320 --> 00:16:14,490
ما هذا؟

214
00:16:14,830 --> 00:16:19,250
.شروط تفعيلها صعبة للغاية
هذا هو سلاحي السّرّيّ

215
00:16:19,800 --> 00:16:21,440
،ضمن نِطاق تأثيرها

216
00:16:21,440 --> 00:16:25,020
،حالما أبعث نصفَ طاقتي السّحريّة
،أستطيع إنشاءه أخيراً

217
00:16:25,020 --> 00:16:26,970
حاجز الصّقيع والثّلج هذا

218
00:16:27,450 --> 00:16:30,760
حقيقة أنّه يترتّب عليّ إطلاق الكثير
من التّعويذات هي عائق

219
00:16:31,460 --> 00:16:35,220
استُخدِمَ ذلك الوابل من السّحر المُتقدِّم
فقط من أجل تحضير الحاجز؟

220
00:16:35,550 --> 00:16:39,980
كانت تعلم تمام المعرفة بأنّها تكون
في موقف حرِج بينما تُجهّز فخّها الأعظم؟

221
00:16:40,260 --> 00:16:44,860
تلك التقنيّة السرّية لهذه المرأة قد ختمت
على سحري بالكامل أيضاً

222
00:16:45,150 --> 00:16:48,030
كلّما اقترب المُمارِس أكثر، تمكّن
التّجميد منه بشكل أكبر

223
00:16:48,030 --> 00:16:49,810
إنّها تمنع أيّ تحرُّك

224
00:16:50,250 --> 00:16:52,620
سرعة الهمجيّ قد انقلبتْ ضدّه

225
00:16:53,760 --> 00:16:55,370
...الحقيقة هي

226
00:16:55,620 --> 00:17:00,850
أنّ هذا السّحر كانت الغاية منه هي حبس
ويل الخجول ذاك كي أتمكّن من مُعانقته

227
00:17:01,370 --> 00:17:06,630
،لكن الآن بعد أن استخدمتُه
لن أتردّد عن سحقك

228
00:17:06,970 --> 00:17:09,760
!جريئة ماكرة

229
00:17:09,760 --> 00:17:11,180
...إنّ ويل

230
00:17:11,720 --> 00:17:13,840
...لي ولي وحدي

231
00:17:15,250 --> 00:17:17,580
!عروستي

232
00:17:24,520 --> 00:17:25,610
!زيو-ساما

233
00:17:25,610 --> 00:17:27,880
!ردّتْ إيلفاريا-ساما عليه

234
00:17:27,880 --> 00:17:29,150
!انظر

235
00:17:29,150 --> 00:17:31,200
!إيلفاريا-ساما فعلَتْها

236
00:17:31,870 --> 00:17:33,240
إيلفي؟

237
00:17:39,090 --> 00:17:41,680
أتى المُغتصِبون

238
00:17:42,400 --> 00:17:44,600
...أيّتها النُّور البريئة

239
00:17:45,250 --> 00:17:47,620
...أيّتها العينان البريئتان

240
00:17:48,990 --> 00:17:52,660
!يا ذروة المجد الموعود

241
00:17:54,410 --> 00:17:59,280
إنجازاتك العظيمة سيتمّ إسقاطها
!الآن بواسطة هذه الأفاعي السّامّة

242
00:17:59,890 --> 00:18:03,270
يستخدم زيو تعزيماً؟ لا بُدّ أنّه جادّ

243
00:18:03,620 --> 00:18:07,570
حاجز تلك المرأة الغبيّة يُجمّد
،حتّى السّحر. لاختراقه

244
00:18:07,570 --> 00:18:11,140
الخيار الوحيد هو ضربه بقوّة ناريّة
...أعظم حتّى، لكن مع ذلك

245
00:18:11,140 --> 00:18:13,780
ذلك الهمجيّ اللّعين لا يملك
!فكرة عن الثّأر المدروس

246
00:18:14,140 --> 00:18:16,020
!ليفيا! فيلفيس

247
00:18:16,020 --> 00:18:17,440
عُلِم

248
00:18:19,900 --> 00:18:20,870
...هذا

249
00:18:21,290 --> 00:18:24,290
لم أرَ... شيئاً كهذا من قبل

250
00:18:24,580 --> 00:18:27,290
!هذا التّعزيم... مستحيل

251
00:18:27,580 --> 00:18:30,420
سحر أعظم حتّى من السّحر المُتقدِّم

252
00:18:32,950 --> 00:18:35,000
!سحر الصّفوة

253
00:18:35,750 --> 00:18:37,680
الجليد الأبيض يتعاظم ويكتمل

254
00:18:37,680 --> 00:18:39,330
دوّامة من الكوارث العنيفة

255
00:18:39,990 --> 00:18:41,580
درع يُمزَّق إلى قِطَع

256
00:18:42,100 --> 00:18:43,900
نُدَب من مخالب النِّزاع

257
00:18:44,470 --> 00:18:46,120
،مات النّعيم ورحل

258
00:18:46,650 --> 00:18:48,440
مخفيّ بواسطة ثلج فضّي

259
00:18:48,900 --> 00:18:50,120
،بينما تهبّ الرّياح وتزأر

260
00:18:50,690 --> 00:18:53,490
!حزِنَتِ السّاحرةُ على ألف بطل

261
00:18:54,570 --> 00:18:56,540
،هجوم البطلان

262
00:18:56,540 --> 00:18:58,320
،ثمن يُدفَع بلا سبب

263
00:18:58,320 --> 00:19:01,880
!أرسِل وسمَ الخطيئة إلى بحر الدّماء

264
00:19:03,780 --> 00:19:05,580
!هاجمي الآن أيّتها الشّهرة الرّعديّة

265
00:19:06,090 --> 00:19:09,540
الثّناء المُزمجِر قد انقلب فجأة
!ليسفك دماء حُبّك

266
00:19:10,370 --> 00:19:12,670
!تحطّم أيُّها المنطق

267
00:19:12,670 --> 00:19:17,300
...الرّثاء لقناع الوحش المقهور مينوس

268
00:19:22,750 --> 00:19:27,090
هجوم، وانتقال من مكان لآخر، ونشر
تعزيم في نفس الوقت

269
00:19:27,090 --> 00:19:28,690
هذا هو التّعزيم المُتزامن

270
00:19:29,130 --> 00:19:31,630
عجيب أن يسرق حتّى الفنون
...السّرّية من الإيلف

271
00:19:31,630 --> 00:19:33,690
إنّه همجيّ بالفعل

272
00:19:40,250 --> 00:19:41,580
اختفى النّاس

273
00:19:41,580 --> 00:19:42,980
ولم يبقَ للعدوّ الغازي وجود

274
00:19:42,980 --> 00:19:45,210
ولم يبقَ أثر لأيّ شيء آخر

275
00:19:45,210 --> 00:19:47,880
!في حصن من الجليد، تقف السّاحرة لوحدها

276
00:19:48,210 --> 00:19:49,880
تنهمر دموعها على القبور

277
00:19:49,880 --> 00:19:51,370
تتحوّل صلواتها إلى رماد

278
00:19:51,370 --> 00:19:52,890
!ويُحلّق قسمُها إلى ما وراء ذلك

279
00:19:53,500 --> 00:19:56,890
!يُسمّي عرشُها الوحيد نفسَه بالوصيّ الآن

280
00:19:57,870 --> 00:19:59,840
التّعزيم التتّابعيّ

281
00:19:59,840 --> 00:20:03,080
نُسخها تلتقط التّعزيم للحِفاظ
!على استمراريّة التّعويذة

282
00:20:03,510 --> 00:20:08,230
التقنيّة الّتي تعلّمتُها لأجل المعركة مع الدّيوك
...العظيم الّتي تمّ أداؤها بواسطة المُبتكر

283
00:20:08,770 --> 00:20:11,230
ماذا؟ ما كلّ هذا؟

284
00:20:11,860 --> 00:20:14,610
إيلفي، لماذا تُقاتلين؟

285
00:20:16,790 --> 00:20:19,700
إذاً هذه الجرائم الزّائفة ستؤدّي
!إلى فأس الحقيقة

286
00:20:20,110 --> 00:20:21,320
اكتسب القوّة بالقوّة

287
00:20:21,710 --> 00:20:22,950
دُس على كلّ شيء

288
00:20:23,330 --> 00:20:24,700
!اذبح الجميع

289
00:20:25,050 --> 00:20:29,290
،امنح هِبةً للأفاعي السّامِة
!وابدأ بوليمة اليأس

290
00:20:30,960 --> 00:20:32,210
!أجنحة الأرض المُتجمِّدة

291
00:20:32,730 --> 00:20:34,210
!منقار وصيّ

292
00:20:34,620 --> 00:20:35,960
!حقيقة بياض الثّلج

293
00:20:36,390 --> 00:20:39,200
،بالفعل، سيقطع الجنازير
!ملِك السّماوات المُتجمِّدة هذا

294
00:20:40,630 --> 00:20:42,560
!يضحك ملكُ الشّياطين

295
00:20:42,560 --> 00:20:43,970
!يحتفل الحُكماء

296
00:20:44,350 --> 00:20:48,350
،لأجل الزّهور العابرة الّتي تُبطل الحدود
!أغنية أبديّة من الإطراء

297
00:20:52,070 --> 00:20:53,980
!الفَناء لكِ يا مملكة الرّعد

298
00:20:53,980 --> 00:20:56,400
!التقي بمصيركِ السّخيف هنا

299
00:20:56,740 --> 00:20:58,390
!تعال الآن يا عالم الثّلج الفضّيّ

300
00:20:58,390 --> 00:21:00,860
!فلتكُن هنا سماء خالية من النّزاع

301
00:21:00,860 --> 00:21:01,780
—إيلفي! انتـ

302
00:21:28,230 --> 00:21:31,390
!فيراغس آرغو ثورزيوس

303
00:21:31,850 --> 00:21:34,600
!غلاسيا لاست آلبيس

304
00:21:43,030 --> 00:21:44,530
!ديو غريل

305
00:23:28,090 --> 00:23:31,060
ويستوريا: عصا وسحر

306
00:23:36,730 --> 00:23:39,190
،الحلقة القادمة من ويستوريا: عصا وسيف

307
00:23:39,620 --> 00:23:42,960
"الحلقة 24، "قصّة حلم بلا نهاية