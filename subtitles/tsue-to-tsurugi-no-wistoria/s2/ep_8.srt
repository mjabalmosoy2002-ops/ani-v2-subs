1
00:00:00,000 --> 00:00:02,980
قصر رينبيرغ، الحديقة

2
00:00:03,470 --> 00:00:06,860
آنّا، هل تُحبّينني هكذا؟

3
00:00:07,610 --> 00:00:08,610
!أجل

4
00:00:08,980 --> 00:00:10,680
أنا والجميع أيضاً

5
00:00:11,320 --> 00:00:15,320
جميعنا نُحبّ مولانا الصّغير طيّب
القلب يوليوس حُبّاً جمّاً

6
00:00:32,010 --> 00:00:36,720
الحلقة 20
تعاليم السّاحرة

7
00:01:47,380 --> 00:01:51,010
البرج، الطّابق الأوّل، النّهاية الشّرقيّة: حقول العزلة

8
00:01:58,930 --> 00:02:00,560
كم مرّة صاروا؟

9
00:02:01,100 --> 00:02:03,160
دمّرتَ حارساً آخر

10
00:02:03,160 --> 00:02:05,480
!لم تُحرز ولو تقدُّماً طفيفاً

11
00:02:05,480 --> 00:02:07,940
كم من طاقتي السّحريّة تنوي أن تهدر بالضّبط؟

12
00:02:07,940 --> 00:02:09,780
!أ-أنا آسف

13
00:02:13,500 --> 00:02:16,230
بعد ذلك، تتبدّد الطّاقة السّحريّة

14
00:02:16,230 --> 00:02:21,980
والأسوأ، عندما أطلق ويس، فإنّ كلّ
!لياقتي تُستنزَف منّي دُفعة واحدة

15
00:02:21,980 --> 00:02:24,500
!لم أدرِك أبداً بأنّ لها جانب سلبيّ كهذا

16
00:02:24,500 --> 00:02:27,960
على هذا المُعدّل، سيكون كلّ
هذا مُجرّد مضيعة للوقت

17
00:02:28,230 --> 00:02:29,090
!من جديد

18
00:02:33,620 --> 00:02:34,970
!يوليوس

19
00:02:34,970 --> 00:02:39,390
أعتقد سيكون من الأفضل لو نتعلّم
أكثر عن ويس أوّلاً في نهاية المطاف

20
00:02:39,390 --> 00:02:42,960
أقصد، حتّى أنا لا أفهم ماهيّة هذه القوّة

21
00:02:44,060 --> 00:02:46,660
تفقّدتُ كلَّ كتاب في مكتبة الأكاديميّة

22
00:02:46,660 --> 00:02:49,000
لكن لم أستطع إيجاد أيّ شيء ذي صِلة

23
00:02:49,000 --> 00:02:51,840
،بدا أنّ الأستاذ واركنر لديه فكرة

24
00:02:51,840 --> 00:02:54,110
لكن قال بأنّه لا يعرف التّفاصيل

25
00:02:55,090 --> 00:02:57,900
سيستغرق ذلك وقتاً، لكن رُبّما ينبغي
أن أستأذن السّحَرة الرّفيعين

26
00:02:57,900 --> 00:03:00,120
بالسّماح لي بالبحث في مكتبات البرج

27
00:03:00,120 --> 00:03:02,620
!أو رُبّما يمكنني إيجاد شخص يعرف شيئاً

28
00:03:02,620 --> 00:03:04,910
!أنا أفعل كلّ ذلك بالفعل

29
00:03:05,220 --> 00:03:06,120
ماذا؟

30
00:03:06,760 --> 00:03:10,000
أرسلتُ نسخةً إلى مكتبات المُؤسّسة العُليا

31
00:03:10,400 --> 00:03:12,690
ونسخة أُخرى تطلب من الأستاذة إيليزا المُساعدة

32
00:03:12,690 --> 00:03:17,580
،في إيجاد فين من شعب النُّور
!والّذي بدا أنّه يعرف شيئاً

33
00:03:18,180 --> 00:03:20,490
تتحكّم بآرس وايس عن بُعد؟

34
00:03:20,490 --> 00:03:22,260
منذ متى تستطيع فعل ذلك بنفسك؟

35
00:03:22,260 --> 00:03:24,460
!الوقت يُداهمنا الآن

36
00:03:24,460 --> 00:03:28,840
لا أملك خياراً سوى الالتزام بالتّدريب
!وجمع المعلومات في نفس الوقت

37
00:03:31,520 --> 00:03:36,900
اللّعنة. رأسي مُشوّش من رؤية
ثلاثة مشاهد في آن واحد

38
00:03:36,900 --> 00:03:38,910
!لهذا أكره تعدُّد المهام

39
00:03:39,830 --> 00:03:42,450
لماذا تفعل كلّ هذا لأجلي؟

40
00:03:43,790 --> 00:03:46,340
!بدافع المصلحة الذّاتيّة بالطّبع

41
00:03:46,340 --> 00:03:47,540
!ألا تفهم؟

42
00:03:48,010 --> 00:03:52,040
كساحر من عائلة رينبيرغ، سوف
!أرتقي نحو القمّة بلا فشل

43
00:03:52,040 --> 00:03:54,640
!أنا أستغلّك لتحقيق تلك الغاية! لا أكثر

44
00:03:54,640 --> 00:03:59,150
!والنُّبلاء دائماً ما يلتزمون بكلامهم

45
00:03:59,150 --> 00:04:00,180
!هذا كلّ ما في الأمر

46
00:04:02,180 --> 00:04:05,830
هذا صحيح. وفى يوليوس بوعده بعد
مهرجان السّحر العظيم

47
00:04:05,830 --> 00:04:09,660
حتّى للمُعلّم دونّان والأقزام الآخرين

48
00:04:12,560 --> 00:04:15,950
يوليوس... أنت لطيفٌ حقّاً، أليس كذلك؟

49
00:04:16,550 --> 00:04:17,570
ماذا؟

50
00:04:18,020 --> 00:04:21,570
أعتقد بأنّ اللّطف يتّخذ أشكالاً مُختلفة
بين شخص وآخر

51
00:04:22,290 --> 00:04:24,950
،لطف كوليت، والّتي تُنقذني دوماً

52
00:04:24,950 --> 00:04:28,460
ولطف الأستاذ واركنر، الّذي يُوبّخني، مُختلفان

53
00:04:28,840 --> 00:04:31,960
وشيون في داخله لطف أيضاً

54
00:04:32,830 --> 00:04:36,090
،حتّى لو كان واجب النّبالة فحسب

55
00:04:36,090 --> 00:04:40,440
!يوليوس، أعتقد بأنّك مُذهل ولطيف

56
00:04:41,340 --> 00:04:44,850
مولايّ الصّغير يوليوس، أنت لطيفٌ جدّاً، أليس كذلك؟

57
00:04:46,920 --> 00:04:48,600
!ما الّذي تقوله فجأة؟

58
00:04:48,980 --> 00:04:50,600
أنت مُريب، أتعلم ذلك؟

59
00:04:51,560 --> 00:04:53,360
سأرتاح قليلاً

60
00:04:53,360 --> 00:04:56,360
!حسناً! سأستمرّ في العمل فترة أطول قليلاً

61
00:04:56,990 --> 00:04:58,690
!شكراً لك يا يوليوس

62
00:05:01,960 --> 00:05:04,120
ماذا يقصد بـ"لطيف"؟

63
00:05:04,700 --> 00:05:07,620
اللّطف غير مُهمّ

64
00:05:08,000 --> 00:05:10,870
لايسنو
قطّة ثلجيّة

65
00:05:09,470 --> 00:05:10,870
أنتِ بخير الآن

66
00:05:17,460 --> 00:05:21,430
آنّا إيلس

67
00:05:18,570 --> 00:05:21,630
مولايّ الصّغير يوليوس، أنت
لطيفٌ جدّاً، أليس كذلك؟

68
00:05:21,630 --> 00:05:23,220
!أنا كذلك بالطّبع

69
00:05:23,220 --> 00:05:26,730
!مُساعدة الضّعفاء هو من واجب النُّبلاء

70
00:05:36,000 --> 00:05:39,150
آنّا، هل تُحبّينني هكذا؟

71
00:05:39,880 --> 00:05:40,900
!أجل

72
00:05:41,270 --> 00:05:43,280
أنا والجميع أيضاً

73
00:05:43,280 --> 00:05:47,470
جميعنا نُحبّ مولانا الصّغير طيّب
القلب يوليوس حُبّاً جمّاً

74
00:05:52,550 --> 00:05:54,000
لا تكذبي

75
00:05:55,630 --> 00:05:58,030
مهما كنتُ لطيفاً

76
00:05:58,030 --> 00:06:02,130
فقدتُك في النّهاية، أليس كذلك؟

77
00:06:09,500 --> 00:06:12,020
لذا نبذتُ اللّطف

78
00:06:12,760 --> 00:06:14,720
الأنانيّة منافعها أكبر، صحيح؟

79
00:06:15,460 --> 00:06:19,290
سأتباهى بمواهبي وأستغلّ الآخرين
من أجل مصلحتي

80
00:06:19,290 --> 00:06:22,500
سأسخر من الضّعيف وأشمت به

81
00:06:23,490 --> 00:06:27,120
البرج، الطّابق الأوّل: المنطقة السّكنيّة

82
00:06:23,650 --> 00:06:27,120
!يوليوس، أعتقد بأنّك مُذهل ولطيف

83
00:06:29,390 --> 00:06:32,910
لا تنظر إليّ بنفس الطّريقة الّتي فعلتْ
آنّا وتتحدّث عن اللّطف

84
00:06:33,550 --> 00:06:35,960
لستُ بحاجة للّطف

85
00:06:36,800 --> 00:06:41,840
...يوليوس رينبيرغ الّذي كان لطيفاً لا أكثر
قتلتُه منذ زمن بعيد

86
00:06:47,680 --> 00:06:50,510
البرج، الطّابق الأوّل، القلعة العائمة رقم 1: فالني

87
00:06:50,560 --> 00:06:53,520
مُختبر كرويتز

88
00:06:50,930 --> 00:06:52,790
يا لها من مُقاومة عقيمة

89
00:06:53,520 --> 00:06:57,180
تشارليز، اتّصل بزملائنا عديمي اللّون

90
00:06:57,180 --> 00:06:58,020
!حاضر

91
00:06:58,020 --> 00:07:00,270
مُدير المُؤسّسة العُليا
ورئيس الجماعة عديمة اللّون
كرويتز هارلون

92
00:07:06,910 --> 00:07:10,410
اللّعنة! هل هذا هو الدّيماس أو أيّاً كان؟

93
00:07:13,260 --> 00:07:14,210
!فرال

94
00:07:18,640 --> 00:07:20,040
من أنتم؟

95
00:07:20,400 --> 00:07:22,110
سحَرة من المُؤسّسة العُليا؟

96
00:07:22,110 --> 00:07:24,050
بأمر من المسؤولين الكبار

97
00:07:24,320 --> 00:07:29,300
سنُعاقب المُجرمين الّذين يعيثون
الفساد في حديقتنا

98
00:07:24,320 --> 00:07:29,300
توني هارفي

99
00:07:29,340 --> 00:07:32,310
ماري لو

100
00:07:29,340 --> 00:07:32,310
أورون تشيك

101
00:07:29,690 --> 00:07:32,310
!ونضع حدّاً لتدريبكم الشّنيع

102
00:07:32,910 --> 00:07:35,340
أتقصد اعتراض طريقنا؟

103
00:07:35,340 --> 00:07:38,560
!كلّ هذا كي لا نملك فُرصة في الازدهار المُقبل؟

104
00:07:38,560 --> 00:07:40,770
!يُفترَض أن تكونوا أعضاء في البرج

105
00:07:44,430 --> 00:07:46,210
!ليتك تفهم

106
00:07:46,210 --> 00:07:48,490
وصلنا إلى البرج، لكن لا نستطيع
!الوصول إلى أيّ مكان آخر

107
00:07:48,490 --> 00:07:51,240
!أنت لا تفقه شيئاً عن ذلّنا كعديمي اللّون

108
00:07:52,610 --> 00:07:55,370
أرفُض البقاء مُجرّد عجلة مُسنّنات
!في البرج للأبد

109
00:07:56,320 --> 00:07:58,370
!وعدَنا كرويتز-ساما

110
00:07:58,370 --> 00:08:02,880
أنّنا إذا سحقناكم، فسوف يُرسِل رسائلَ
!توصية بنا لكلّ جماعة لأجلنا

111
00:08:05,600 --> 00:08:07,940
إذاً هذه هي نتيجة المُنافسة القاسية
داخل البرج

112
00:08:08,300 --> 00:08:10,340
،للخروج من المقبرة باستماتة

113
00:08:10,340 --> 00:08:12,640
!هذه العصيّ السّحريّة تخلّتْ حتّى عن كرامتها

114
00:08:13,160 --> 00:08:15,640
لكن الفساد الأكبر حتّى هو أنّهم
ما زالوا سحَرة رفيعين

115
00:08:18,010 --> 00:08:23,110
كنتُ أفرط في استخدام حُرّاسي وآرس
وايس، لذا لم يبقَ لديّ الكثير من السّحر

116
00:08:23,490 --> 00:08:25,860
بالإضافة إلى ذلك، هُم أكثر منّي عدداً

117
00:08:26,750 --> 00:08:27,800
...في هذه الحالة

118
00:08:29,660 --> 00:08:32,160
...توني، سينباي أقدم منّي بعام

119
00:08:32,550 --> 00:08:34,280
...وماري المُتعجرفة

120
00:08:34,710 --> 00:08:37,410
وأورون، الّذي كان مغروراً بالرّغم
من كونه زميلي الكوهاي

121
00:08:37,990 --> 00:08:41,780
بعد تطوير سحر جديد والصّعود
،إلى البرج بهذه السّرعة

122
00:08:41,780 --> 00:08:45,420
يبدو أنّكم أصبحتُم فاشلين تماماً، أليس
!كذلك أيّها العباقرة السّابقون؟

123
00:08:45,420 --> 00:08:47,300
!يا له من مشهد مُثير للشّفقة

124
00:08:47,300 --> 00:08:49,700
...مُقيّدين بإحكام بواسطة المُؤسّسة العُليا

125
00:08:49,700 --> 00:08:53,930
أُفضّل الموت على أن ينتهي المطاف
!بي حُثالة مُقيّدة مثلكم

126
00:08:53,930 --> 00:08:56,680
!لم يتمّ اختيارك أيضاً! أنت عديم اللّون كذلك

127
00:08:57,890 --> 00:08:59,600
هل أنت أعمى؟

128
00:09:00,230 --> 00:09:03,190
!أنا يوليوس رينبيرغ

129
00:09:03,190 --> 00:09:07,290
سأستغلّ عديم الموهبة العاجز سحريّاً
!ذاك وأيّ شخص آخر أحتاجه

130
00:09:07,290 --> 00:09:10,990
!سأصعد هذا البرج وأصبح خليفة إيلفاريا-ساما

131
00:09:12,060 --> 00:09:13,270
...ثمّ

132
00:09:16,370 --> 00:09:18,180
،من قمم البرج العُظمى

133
00:09:18,180 --> 00:09:21,000
!سأستحقر كلّ شخص تخلّى عنّي

134
00:09:21,000 --> 00:09:24,000
لتحقيق تلك الغاية، سأستغلّ
!حتّى الماجيا فيندر

135
00:09:24,000 --> 00:09:28,580
رغم أنّه يؤسفني القول بأنّكم لا تستحقّون
!الاستغلال حتّى

136
00:09:28,580 --> 00:09:29,630
!يوليوس

137
00:09:29,630 --> 00:09:32,360
!حتّى في المدرسة، لم أكن أتحمّلك أبداً

138
00:09:32,360 --> 00:09:33,510
!سوف أقتلك

139
00:09:35,350 --> 00:09:38,270
هذا صحيح. لستُ لطيفاً

140
00:09:38,700 --> 00:09:43,020
الآن، هؤلاء الأشخاص الّذين أمامي ويكرهونني
هُم دليلٌ حيّ على ذلك

141
00:09:43,990 --> 00:09:45,720
أترين يا آنّا؟

142
00:09:45,720 --> 00:09:48,340
لم أعُد لطيفاً

143
00:09:56,860 --> 00:09:58,290
هل أنت بخير يا يوليوس؟

144
00:09:58,550 --> 00:10:00,230
!آسف لتأخُّري

145
00:10:03,700 --> 00:10:05,890
...لماذا أنت

146
00:10:05,890 --> 00:10:08,140
،هوجِمتُ فجأة بواسطة سحَرة رفيعين

147
00:10:08,140 --> 00:10:10,920
لذا ارتأيتُ بأنّك قد تكون في خطر
أيضاً! فأتيتُ أنا وكيكي للتفقُّد

148
00:10:12,910 --> 00:10:15,180
لماذا أنقذتني؟

149
00:10:15,180 --> 00:10:16,120
ماذا؟

150
00:10:16,120 --> 00:10:19,780
أنقذنا بعضنا الآخر كثيراً في الدّيماس
،أثناء التّطبيق العمليّ لكافّة التّلاميذ

151
00:10:19,780 --> 00:10:22,180
...وأنت ما زلت تُساعدني حتّى الآن، لذا

152
00:10:22,460 --> 00:10:25,940
هل تعي حتّى كم جعلتُك تبدو غبيّاً
في مهرجان السّحر العظيم؟

153
00:10:25,940 --> 00:10:30,620
!أخبرتُك بأنّ كلّ هذا مصلحة ذاتيّة
...أنا أستغلّك فحسب، ومع ذلك أنت

154
00:10:30,940 --> 00:10:33,200
!هل أنت غبيّ؟

155
00:10:33,910 --> 00:10:35,270
أجل، أنا كذلك

156
00:10:35,270 --> 00:10:38,460
،عندما يكون النّاس لطيفين معي
لا يسعني سوى أن أُحبّهم

157
00:10:38,460 --> 00:10:39,830
أنا أحمق بكُل معنى الكلمة

158
00:10:40,120 --> 00:10:42,120
أنا والجميع أيضاً

159
00:10:42,120 --> 00:10:47,020
جميعنا نُحبّ مولانا الصّغير طيّب
القلب يوليوس حُبّاً جمّاً

160
00:10:48,290 --> 00:10:49,590
!بو

161
00:10:49,590 --> 00:10:53,000
!لـ-لماذا لكمتني؟

162
00:10:54,330 --> 00:10:55,470
!أكرهك

163
00:10:55,470 --> 00:10:58,260
!أبغضك جدّاً

164
00:10:58,520 --> 00:11:00,580
ماذا يفعلان؟

165
00:11:00,580 --> 00:11:03,480
!هذا غير مُهمّ! لنُسرع ونسحقهما

166
00:11:04,020 --> 00:11:05,460
!يوليوس، تراجع

167
00:11:05,460 --> 00:11:07,100
!لا تُوجّه الأوامر إليّ

168
00:11:08,770 --> 00:11:09,360
ماذا؟

169
00:11:13,410 --> 00:11:18,370
لا نستخدم السّحر هكذا. ألم تتعلّموا
ذلك في الأكاديميّة؟

170
00:11:22,050 --> 00:11:23,520
من أنتِ؟

171
00:11:24,410 --> 00:11:26,200
اسمي كيريدوين

172
00:11:25,120 --> 00:11:29,000
كيريدوين

173
00:11:26,430 --> 00:11:29,000
...لِقاء استعراض عنفوان الشّباب الرّائع ذاك

174
00:11:29,290 --> 00:11:32,090
اسمحا لي أن أصبح مُعلّمتكما

175
00:11:33,260 --> 00:11:34,650
عصا قِدر الفوضى

176
00:11:33,300 --> 00:11:34,770
مكنسة غوفيون

177
00:11:34,670 --> 00:11:38,050
كيريدوين
العِرق: ريزانث
العمر: "20 خالدة" وفقاً لها
الطّول: 175 سم
يوم الميلاد: السّابع من كارنسمون
تُحبّ: الأطفال الّذين يطمحون للمُستقبل
تكره: البالغين الّذين يُحاولون طمس المُستقبل

178
00:11:34,670 --> 00:11:38,050
الحُبّ الأوّل: صديق عزيز أخرق جدّاً
لم يستطع التخلّي عن لطفه وظرافته
أعمق طابق ديماس تمّ بلوغه: الطّابق 40
العتاد: عصا قِدر الفوضى، مكنسة غوفيون
المهارات: تقريباً مهارة من كلّ العناصر الستّة غير النُّور
الباقي سرّ

179
00:11:38,300 --> 00:11:39,550
عصا لوندارك

180
00:11:39,680 --> 00:11:43,060
تشارليز لاوير
العرق: ريزانث   العمر:22   الطّول: 173 سم
يوم الميلاد: 31 من كارنسمون
يُحبّ: كرويتز، الحيلة والخِداع
يكره: أصوات الغضب العالية والعنف والهيستيريا
شخص يُحبّه: ومنيكا أورفين
أعمق طابق ديماس تمّ بلوغه: الطّابق 28
العتاد: عصا لوندارك
المهارات: تعويذات ظلاميّة بمستويات مُتوسّطة

181
00:11:39,680 --> 00:11:43,060
.ساحر يعمل كضابط مُساعد لجماعة عديمي اللّون
كحِرفيّ، إنّه ماهر بما يكفي لدرجة حتّى كرويتز
.يعترف به على أنّه يده اليمنى
لكن في نفس الوقت، شخصيّته الخجولة غالباً
.ما تعني بأنّه يتورّط في المتاعب حوله
إنّه الشّخص الّذي يبذل جهداً
.كبيراً وأكثر من يعاني في جماعة عديمي اللّون

182
00:11:43,450 --> 00:11:45,500
أنا كيريدوين

183
00:11:45,500 --> 00:11:48,060
...لِقاء استعراض عنفوان الشّباب الرّائع ذاك

184
00:11:48,490 --> 00:11:51,050
اسمحا لي أن أصبح مُعلّمتكما

185
00:11:51,960 --> 00:11:53,550
كيريدوين؟

186
00:11:53,550 --> 00:11:56,320
...مهلاً. هذا الاسم

187
00:11:56,650 --> 00:12:00,420
مثل المُراقبين تماماً، إنّها إحدى
أساطير الأكاديميّة السّبعة

188
00:12:00,420 --> 00:12:04,030
ليلة تِلو اللّيلة، تختطفُ تلاميذَ
وتجري تجاربَ عليهم

189
00:12:04,030 --> 00:12:05,380
!ساحرة المِطرقة

190
00:12:06,290 --> 00:12:09,130
لا أفعل أشياء مُخيفة كهذه

191
00:12:09,130 --> 00:12:13,840
،عندما أجد تلاميذَ يُثيرون اهتمامي
أدرّبهم وأُرشدهم. هذا كلّ ما في الأمر

192
00:12:14,270 --> 00:12:17,340
مثلكما أنتما الماثلان أمامي

193
00:12:17,340 --> 00:12:21,470
تدريبنا... وإرشادنا؟

194
00:12:21,470 --> 00:12:22,420
!تماماً

195
00:12:22,420 --> 00:12:27,230
لا أعتقد بأنّكما تعلمان هذا، لكن
كنتُ أُراقبكما منذ زمن بعيد

196
00:12:27,690 --> 00:12:29,990
كانت تُراقبنا؟

197
00:12:29,990 --> 00:12:32,440
لم ألتقِ بهذه السّاحرة من قبل

198
00:12:37,150 --> 00:12:39,310
يمكننا مُناقشة التّفاصيل لاحقاً

199
00:12:39,310 --> 00:12:40,610
أوّلاً، لنذهب إلى مكان آخر

200
00:12:41,140 --> 00:12:44,120
إذا بقينا هنا، الآخرون من المُؤسّسة
العُليا سوف يعثرون علينا

201
00:12:44,820 --> 00:12:47,870
حاليّاً، تماشيا معي واسمحا لي
بالإمساك بكما، اتّفقنا؟

202
00:12:51,080 --> 00:12:53,630
ميرسيديس كاوليس
برج السّاحر

203
00:12:51,480 --> 00:12:57,130
لماذا لم تمنحي بركَتكِ ليوليوس رينبيرغ
يا إيلفاريا-ساما؟

204
00:12:54,090 --> 00:12:57,130
الغرف الخاصّة بإيلفاريا

205
00:12:57,130 --> 00:12:59,890
عندما يقبع شخصٌ موهوبٌ مثله
،في الظُّلُمات

206
00:12:57,800 --> 00:13:02,340
مُراقِبة لدى وكالة الاستكشاف
آيريس تشرشل

207
00:12:59,890 --> 00:13:03,140
كمُراقبة، لا أستطيع تجاهل ذلك

208
00:13:03,610 --> 00:13:08,360
لكن قال مثل هذا الكلام البذيء كما
لو أنّه كان سيُعرّيني

209
00:13:08,360 --> 00:13:11,510
بالإضافة إلى ذلك، تنمّرَ على ويل كثيراً

210
00:13:11,510 --> 00:13:12,900
...و

211
00:13:12,900 --> 00:13:16,650
!كشفَ عن ماضيّي الأسود للأكاديميّة برمّتها

212
00:13:18,250 --> 00:13:21,040
إذاً هذه مُجرّد أحقاد شخصيّة؟

213
00:13:21,040 --> 00:13:24,380
فضلاً عن ذلك، كان ويل من كشفَ ذلك
في حقيقة الأمر، صحيح؟

214
00:13:24,380 --> 00:13:25,380
!لا أُبالي

215
00:13:27,830 --> 00:13:29,500
...آيريس

216
00:13:29,500 --> 00:13:33,540
ما الّذي سيفعله آرون-ساما بويل؟

217
00:13:34,020 --> 00:13:37,220
"قال، "دعوا الأمور تسير كما هي

218
00:13:37,550 --> 00:13:40,890
آرون-ساما يختلف عن المُديرة كالدرون

219
00:13:40,890 --> 00:13:45,550
إنّه لا يُرحّب بفكرة انضمام سيف للعصيّ السّحريّة

220
00:13:46,000 --> 00:13:49,320
لكن، إذا كان السّيف سيشقُّ طريقه
،الخاصّ بالقوّة

221
00:13:49,320 --> 00:13:53,100
.فسيحترم تلك الإرادة والقوّة
يبدو أنّ هذا هو موقفه

222
00:13:53,560 --> 00:13:55,620
...ويل سيرفورت

223
00:13:55,620 --> 00:13:59,320
مع ظهور ويس، باتَ البرجُ مُنقسماً
حول كيفيّة المُتابعة

224
00:13:59,320 --> 00:14:02,500
في المقام الأوّل، ما هو "ويس"؟

225
00:14:02,500 --> 00:14:05,070
أنا بحدّ ذاتي لا أستوعبه تماماً

226
00:14:05,390 --> 00:14:07,920
قوّة يمكنها قلب العالم بأكمله
...رأساً على عقب

227
00:14:07,920 --> 00:14:09,830
بكل مُعنى الكلمة، إنّها غير عاديّة

228
00:14:10,420 --> 00:14:12,640
،ولو كان هذا يُقلّل من احترام إيلفاريا-ساما

229
00:14:12,640 --> 00:14:15,400
لم أقرّر بعد كيف ينبغي أن نُراقبه أيضاً

230
00:14:15,710 --> 00:14:19,300
على أيّ حال، إذا أصبحتْ مُعالجة
،ويل موضِع شكّ

231
00:14:19,300 --> 00:14:23,590
!كمُراقبة، سأتولّى وصايته، لذا لا تقلقي رجاء

232
00:14:23,590 --> 00:14:26,430
لا ينبغي لكِ أن تتكلّمي أثناء
نومكِ ما لم تكوني نائمة فعلاً

233
00:14:26,430 --> 00:14:27,720
أيّتها القطّة اللّصّة

234
00:14:31,150 --> 00:14:36,480
بسبب ذلك الشّابّ... قد يتحطّم البرج حقّاً

235
00:14:36,480 --> 00:14:38,820
!وها نحن أولاء

236
00:14:36,860 --> 00:14:40,480
في مكانٍ ما في الطّابق الأوّل من البرج

237
00:14:45,060 --> 00:14:47,740
أهلاً بكما في قصر السّاحرة

238
00:14:50,290 --> 00:14:54,000
منزل كليري
قاعدة سرّيّة للسّاحرات الوحيدات

239
00:14:50,360 --> 00:14:52,140
اجلسا حيث تشاءان

240
00:15:10,550 --> 00:15:12,640
!والآن، لنتناول العشاء

241
00:15:13,280 --> 00:15:15,020
!أعددتُه كلّه بنفسي

242
00:15:15,270 --> 00:15:17,580
—مُحال أن نأكل ما أعدّتْه ساحرة مشبوهة

243
00:15:17,580 --> 00:15:19,370
!شكراً على الطّعام

244
00:15:19,370 --> 00:15:21,060
!لا تأكل هذا

245
00:15:21,060 --> 00:15:23,850
تقول كيكي أنّه لا مُشكلة. لا تقلق

246
00:15:25,680 --> 00:15:27,220
...قبل أيّ شيء

247
00:15:27,220 --> 00:15:28,910
ما هذا المكان أصلاً؟

248
00:15:29,750 --> 00:15:33,910
مخبأ شيّدَتْه كليري سرّاً في الطّابق الأوّل

249
00:15:34,350 --> 00:15:36,530
أستخدمه ببرَكةٍ منها

250
00:15:37,230 --> 00:15:38,920
هذا منزل الآنسة كليري؟

251
00:15:38,920 --> 00:15:41,920
هذا صحيح! فهي تلميذتي

252
00:15:41,920 --> 00:15:44,090
هي؟

253
00:15:44,090 --> 00:15:46,680
رغم أنّه لسببٍ ما، هذا منطقيّ تماماً

254
00:15:46,680 --> 00:15:50,550
إذاً استمدّتْ سلوك الاستهتار ذاك من مُعلّمتها؟

255
00:15:50,550 --> 00:15:55,230
حسناً، ما الّذي تُخطّطين استخدام
هذا الأبله لأجله؟

256
00:15:56,220 --> 00:16:01,310
يوليوس، أنقذَتْنا كِلينا، وتقول
بأنّها مُعلّمة الآنسة كليري

257
00:16:02,000 --> 00:16:04,820
!عليك أن تتعلّم الحذر أكثر من النّاس

258
00:16:05,150 --> 00:16:09,070
قد تكون مُغتالة من المُؤسّسة العُليا
!وتدّعي عكس ذلك فحسب

259
00:16:09,070 --> 00:16:10,990
،وحتّى لو لم تكن كذلك

260
00:16:10,990 --> 00:16:14,330
السّاحر الّذي يُتقن حِرفته مُحال
!أن يُوفّر خدماته مجّاناً

261
00:16:14,710 --> 00:16:16,800
،كما تُفيد الأساطير السّبعة فحسب

262
00:16:16,800 --> 00:16:19,580
!لعلّ هدفها هو استخدامنا كمواد اختبار

263
00:16:20,670 --> 00:16:23,550
حسناً، هذه مُشكلة بالفعل

264
00:16:23,550 --> 00:16:27,840
...اليقظة هي دلالةٌ على ساحر مُتألّق، لكن

265
00:16:27,840 --> 00:16:29,470
...حسناً، في هذه الحالة

266
00:16:34,670 --> 00:16:37,260
!وابل سحريّ هائل؟

267
00:16:37,260 --> 00:16:40,380
!أطلقَتْ كلّ هذا فوراً ومن دون ترتيل؟

268
00:16:40,380 --> 00:16:41,980
!لم أرَها تُشعل فتيلَ أيّ شيء

269
00:16:42,420 --> 00:16:45,100
...سِهام من كلّ عنصر غير النُّور

270
00:16:45,100 --> 00:16:48,490
هذه المرأة هي مولتوس! لديها
!تآلُفات عنصريّة عديدة

271
00:16:48,950 --> 00:16:54,990
لو رغبتُ في ذلك، لهيمنتُ عليكما
في غضون ثانيتين فقط

272
00:16:56,590 --> 00:17:00,620
،هذا ليس دليلاً على أيّ شيء
لكن آمل أن يكون كفيلاً بإقناعكما

273
00:17:01,270 --> 00:17:06,500
لو كانت لديّ ذرّة نوايا خبيثة، لكنتُما قد التُهِمتُما
بواسطة هذه السّاحرة المُخيفة بالفعل

274
00:17:09,880 --> 00:17:11,990
أوّلاً، أخبرينا ما الّذي تُخطّطين له فعلاً

275
00:17:11,990 --> 00:17:13,890
ما هي غايتكِ؟

276
00:17:14,180 --> 00:17:17,890
خِلاف ذلك، لن أسمح لكِ أبداً
!بأن تكوني مُعلّمة هذا الأحمق

277
00:17:18,310 --> 00:17:19,770
!يوليوس

278
00:17:19,770 --> 00:17:23,650
لا تُسئ فهمي! أنا الوحيد الّذي
!يحقُّ له أن يستخدمك

279
00:17:23,650 --> 00:17:26,120
!لن أدع شخصاً آخر يتدخّل ويخطفك

280
00:17:26,120 --> 00:17:27,650
!هذا ما أعترض عليه

281
00:17:27,650 --> 00:17:31,650
!لستُ لطيفاً! ولا بأيّ شكل من الأشكال
!هل تسمعني؟

282
00:17:32,870 --> 00:17:34,280
فهمت

283
00:17:35,910 --> 00:17:37,160
...أوّلاً

284
00:17:37,630 --> 00:17:40,540
أعرف كلّ تفصيل عن ويس

285
00:17:42,820 --> 00:17:45,580
قد أتمكّن من مُساعدتكما

286
00:17:45,580 --> 00:17:48,800
هذا هو أوّل سبب جعلَني أكشف
عن نفسي أمامكما

287
00:17:49,090 --> 00:17:50,550
...بالنّسبة للسّبب الثّاني

288
00:17:50,870 --> 00:17:52,840
هو خطأ المُؤسّسة العُليا

289
00:17:52,840 --> 00:17:55,550
...نهجهم ليس الأفضل، لكن

290
00:17:55,550 --> 00:17:59,600
ويل، هناك قِوى تحاول تقييدك

291
00:17:59,600 --> 00:18:00,860
المُؤسّسة العُليا؟

292
00:18:01,700 --> 00:18:02,560
...هل يُعقَل

293
00:18:03,060 --> 00:18:04,440
تقصدين ذلك الرّجل؟

294
00:18:06,010 --> 00:18:08,560
ويل سيرفورت قد اختفى؟

295
00:18:08,560 --> 00:18:11,620
أجل، مع يوليوس رينبيرغ

296
00:18:11,620 --> 00:18:14,700
وفقاً للتّقارير، يبدو أنّ شخصاً قد تدخّل

297
00:18:14,700 --> 00:18:17,080
!ابدؤوا ببحث شامل

298
00:18:17,080 --> 00:18:21,240
لا توجد دلالات سحريّة على أنّ شخصاً
قد غادر الطّابقَ الأوّل

299
00:18:21,240 --> 00:18:23,330
لا بُدّ أنّهما يختبئان هنا في مكانٍ ما

300
00:18:23,670 --> 00:18:26,580
مُساعد مُدير المُؤسّسة العُليا
تشارليز لاوير

301
00:18:24,330 --> 00:18:26,580
هلّا طرحتُ سؤالاً؟

302
00:18:27,350 --> 00:18:33,040
لماذا تُخاطر بمُعاداة إيلفاريا-ساما
فقط لتحبس ويل سيرفورت؟

303
00:18:33,040 --> 00:18:37,600
لِمَ أُسلّم مادّةً ممتازة كهذه لتلك
الجماعات المهووسة بالحروب؟

304
00:18:37,600 --> 00:18:43,560
ينبغي استخدام "ويس" بكفاءة وفعاليّة

305
00:18:46,280 --> 00:18:49,070
مثل سفّاح السّحرة هذا

306
00:18:49,610 --> 00:18:55,110
لا أعرف أيّ مُنظّمة أنشأتْه، لكن
إمكانيّاته عظيمة

307
00:18:58,870 --> 00:19:02,690
قد يُحوّل سلاحٌ كهذا حتّى سحَرة
غير كفؤين إلى جنود قيّمين

308
00:19:03,040 --> 00:19:05,930
هنا ينبغي أن يكمن إلهامنا

309
00:19:06,750 --> 00:19:10,420
القوّة تنبع من الأعداد. حتّى الكفاءة
تُحدَّد بواسطة الأعداد

310
00:19:11,320 --> 00:19:13,630
،بالسّيوف الأقوى الخمسة فقط

311
00:19:13,630 --> 00:19:16,430
كان المُضيف السّماويّ لا يُقهَر تقريباً

312
00:19:16,820 --> 00:19:21,930
لا ينبغي أن نسعى للدّرجات العُليا الفرديّة، بل
نسعى للسّيادة القياسيّة

313
00:19:22,500 --> 00:19:26,080
تحويل ويس إلى قوّة يستطيع
...أيّ شخص استخدامها

314
00:19:26,080 --> 00:19:29,060
هذا هو، دون أدنى شكّ، التحدّي
الّذي تخوضه المُؤسّسة العُليا

315
00:19:30,270 --> 00:19:32,320
...ولحلّه، أوّلاً

316
00:19:32,590 --> 00:19:34,760
...جسد ويل سيرفورت

317
00:19:36,400 --> 00:19:38,520
!يجب تشريحه

318
00:19:43,520 --> 00:19:47,490
لا أحد من الجماعات، ولا حتّى الماجيا
فيندر، يعلمون بهذا

319
00:19:47,490 --> 00:19:49,440
...الجانب الخفيّ لكرويتز-ساما

320
00:19:50,310 --> 00:19:52,170
!المُشرِّح المجنون

321
00:19:52,170 --> 00:19:55,170
،إذا كشفت إيلفاريا-ساما الأمر

322
00:19:55,170 --> 00:19:57,270
!فسيُقضى على المُؤسّسة العُليا

323
00:20:09,300 --> 00:20:10,190
تشارليز

324
00:20:11,420 --> 00:20:15,660
أخبر الجماعات بأنّنا سنتّخذ قريباً
إجراءات مُضادّة ضدّ سفّاحي السّحرة

325
00:20:15,660 --> 00:20:17,700
فهمتُ المبدأ خلفهم

326
00:20:18,350 --> 00:20:22,260
الشّيء المُقبل الّذي سأُحلّله هو ويس

327
00:20:25,160 --> 00:20:26,770
...في الحقيقة

328
00:20:28,030 --> 00:20:33,650
أردتُ مُراقبتك بينما تستمرّ في
،استخدام قوّتك الخاصّة

329
00:20:36,210 --> 00:20:38,350
لكن لا أستطيع الجلوس مكتوفة
اليدين فترة أطول

330
00:20:39,000 --> 00:20:42,470
إذ أنّني لا أريدك قطعاً أن تصبح مادّة تجربة

331
00:20:43,110 --> 00:20:46,980
لهذا السّبب قرّرتُ مدّ يد العون لك

332
00:20:47,350 --> 00:20:50,730
بالإضافة إلى ذلك، عزيزتي إيلفاريا
الصّغيرة توسّلَتْ لي

333
00:20:51,710 --> 00:20:52,980
إيلفي فعلتْ ذلك؟

334
00:20:52,980 --> 00:20:57,740
وهذا كلّ شيء بالنّسبة لي. وما تختارانه
هو أمر يعود لكما في النّهاية

335
00:21:01,690 --> 00:21:02,870
يوليوس

336
00:21:03,990 --> 00:21:05,870
أريد الوثوق بها

337
00:21:08,360 --> 00:21:10,580
أشعر بأنّها لا تكذب

338
00:21:10,580 --> 00:21:12,880
...وهذا غريب، لكن

339
00:21:13,250 --> 00:21:16,930
أشعر وكأنّني أعرفها منذ فترة طويلة

340
00:21:20,630 --> 00:21:22,640
افعل ما يحلو لك

341
00:21:22,940 --> 00:21:24,390
!يوليوس

342
00:21:24,390 --> 00:21:27,260
يمكنك أن تنتقل إلى شخص تستطيع
!أن تستفيد منه أكثر

343
00:21:27,260 --> 00:21:30,620
هذا هو سبب عرضي المُساعدة
!عليك من الأساس

344
00:21:30,620 --> 00:21:34,220
!لحظة، أنتقل؟! ليس هذا ما أفعله

345
00:21:34,220 --> 00:21:37,800
!أنا آسف حقّاً! أشكرك على لطفك معي

346
00:21:35,690 --> 00:21:38,030
إنّهما مُنسجمان جيّداً الآن

347
00:21:37,800 --> 00:21:44,030
أخبرتُك! لستُ لطيفاً! ما يهمّني
!هو الكفاءة! هذا كلُّ شيء

348
00:21:38,300 --> 00:21:40,510
أعتقد بأنّهما سيُشكّلان فريقاً رائعاً

349
00:21:44,030 --> 00:21:45,030
!حسناً إذاً

350
00:21:45,560 --> 00:21:47,100
،الآن بعد أن توصّلنا إلى اتّفاق

351
00:21:47,100 --> 00:21:51,290
ستُخضعكما الأستاذة كيريدوين
!لتدريب لتعزيز قوّتكما

352
00:21:51,830 --> 00:21:54,130
...والآن، أعلم بأنّ هذا مُفاجئ، لكن

353
00:21:55,310 --> 00:21:56,630
اخلع ملابسك

354
00:21:59,050 --> 00:22:00,260
عفواً؟

355
00:23:28,050 --> 00:23:31,010
ويستوريا: عصا وسيف

356
00:23:36,720 --> 00:23:39,630
،الحلقة القادمة من ويستوريا: عصا وسيف

357
00:23:39,630 --> 00:23:42,900
"الحلقة 21، "فتح صفحة جديدة

358
00:23:40,480 --> 00:23:45,990
الحلقة 21
فتح صفحة جديدة