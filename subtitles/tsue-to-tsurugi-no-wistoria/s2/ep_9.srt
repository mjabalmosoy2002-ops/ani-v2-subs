1
00:00:00,350 --> 00:00:03,980
البرج، الطّابق الأوّل: الحديقة عديمة اللّون

2
00:00:07,820 --> 00:00:11,410
منزل كليري
القاعدة السّريّة للسّاحرات الوحيدات

3
00:00:12,960 --> 00:00:14,690
...ا-المعذرة

4
00:00:16,130 --> 00:00:20,120
لماذا أنا نصف عارٍ الآن؟

5
00:00:16,830 --> 00:00:20,120
ويل سيرفورت

6
00:00:20,380 --> 00:00:24,880
لا تقلق، لا تقلق! لن أفعل أيّ شيء سيّئ

7
00:00:25,220 --> 00:00:29,260
!أنتِ... إذاً لديكِ ميول مُريعة

8
00:00:25,340 --> 00:00:29,090
يوليوس رينبيرغ

9
00:00:29,620 --> 00:00:33,030
أنت تُسيئ فهمي! هذا ضروريّ

10
00:00:33,030 --> 00:00:36,110
إذاً لنُنزل هاتين اليدين، من فضلك يا ويل؟

11
00:00:36,640 --> 00:00:38,020
حـ-حسناً

12
00:00:38,280 --> 00:00:42,050
كيف لهذا أن يكون هذا سوء فهم؟
!أنتِ ساحرة مُنحرفة بكُل معنى الكلمة

13
00:00:45,660 --> 00:00:48,280
ما هذه النُّدَب؟

14
00:00:49,340 --> 00:00:51,510
...سمعتُ إشاعات، لكن

15
00:00:51,510 --> 00:00:55,420
أيّ مُعاناة جنونيّة كبّد نفسه بها
للصّعود إلى البرج؟

16
00:00:55,910 --> 00:00:57,990
أجل، بالفعل

17
00:00:58,590 --> 00:00:59,410
ويل

18
00:01:00,760 --> 00:01:04,420
أين وكيف حصلت على هذه
النّدبة في ظهرك؟

19
00:01:04,890 --> 00:01:09,420
في الواقع، أعتقد بأنّني حصلتُ عليها
أثناء حماية إيلفي عندما كنّا صغيرين

20
00:01:09,860 --> 00:01:11,650
هكذا إذاً

21
00:01:11,650 --> 00:01:12,950
هذا هو غالباً إذاً

22
00:01:12,950 --> 00:01:13,920
!مُؤلم

23
00:01:14,520 --> 00:01:17,700
المعذرة، ماذا تفعلين؟

24
00:01:22,440 --> 00:01:26,190
كيريدوين

25
00:01:23,190 --> 00:01:26,190
كنتُ أراقبكما تتدرّبان

26
00:01:27,060 --> 00:01:30,850
كان التّركيز على "التّثبيت" خياراً ذكيّاً جدّاً

27
00:01:30,850 --> 00:01:35,210
إذا كان ويل قادراً على التحكُّم بالطّاقة السّحريّة
الّتي يُثبّتها، فسيقوده ذلك إلى ويس

28
00:01:35,210 --> 00:01:37,070
مسار التّفكير هذا صحيح

29
00:01:38,060 --> 00:01:41,280
رغم أنّني أعتقد بأنّه سيكون من الأفضل
أن تكون صادقاً أكثر مع نفسك

30
00:01:41,880 --> 00:01:44,710
أنت مُتألّق حقّاً، أليس كذلك يا يوليوس؟

31
00:01:44,710 --> 00:01:47,300
لستُ بحاجة مُجاملاتكِ الفارغة

32
00:01:47,300 --> 00:01:49,960
كنتُ مُخطئاً، أليس كذلك؟

33
00:01:50,390 --> 00:01:52,340
لم تكن مُخطئاً

34
00:01:52,340 --> 00:01:54,900
ويل هو التّجسيد الحرفيّ للتّثبيت

35
00:01:54,900 --> 00:01:58,670
الحقيقة هي أنّه تخطّى بالفعل عقبة
تخزين الطّاقة السّحريّة

36
00:01:59,290 --> 00:02:03,640
لأنّ دماء سحَرة العصيّ السّحريّة
تجري في عروق ويل

37
00:02:05,190 --> 00:02:07,980
لكن جسد ويل مُميّز قليلاً

38
00:02:08,370 --> 00:02:10,820
لا يستطيع إطلاق الطّاقة السّحريّة من نفسه

39
00:02:10,820 --> 00:02:13,830
بدلاً من ذلك، يختزنها بجشع في أعماقه

40
00:02:14,340 --> 00:02:17,100
،مهما صرخَ جسدُه

41
00:02:17,100 --> 00:02:20,580
يستهلك طاقةً سحريّة من الخارج ويُخزّنها

42
00:02:20,850 --> 00:02:22,000
أُخزّنها؟

43
00:02:22,500 --> 00:02:25,200
مهمّتك الآن هي تعلُّم

44
00:02:25,200 --> 00:02:28,360
كيفيّة سحب تلك الطّاقة المُخزّنة بإرادتك

45
00:02:28,360 --> 00:02:32,440
بصيغة أُخرى، شحن نفسك من تلقاء نفسك

46
00:02:32,860 --> 00:02:36,030
هذه هي المرحلة التّالية الّتي
ينبغي أن تحاول الوصول إليها

47
00:02:36,030 --> 00:02:37,860
مـ-مهلاً لحظة

48
00:02:37,860 --> 00:02:42,520
ظننتُ بأنّني أحتاج الآخرين، والتّعويذات
الخارجيّة، من أجل الشّحن

49
00:02:42,520 --> 00:02:45,270
صحيح، لكن هذا ليس كلّ شيء

50
00:02:45,860 --> 00:02:47,660
كدليل، فعّلتَ قِوى

51
00:02:47,660 --> 00:02:51,750
غير التّعويذات الّتي شحنتَ نفسك بها، أليس كذلك؟

52
00:02:54,030 --> 00:02:56,530
ما ستفعله الآن هو تسخير ذلك للاستعمال

53
00:02:57,750 --> 00:03:01,900
بتذكُّر رواية هذا السّحر المُرتبط
،عبر دمك وذكرياتك

54
00:03:01,900 --> 00:03:05,040
ستتمكّن من الشّحن من تلقاء نفسك

55
00:03:05,650 --> 00:03:09,790
،من دون الاعتماد على سحر الآخرين
سيكون نوعاً جديداً من الشّحن

56
00:03:10,570 --> 00:03:12,800
نوع جديد من الشّحن؟

57
00:03:13,420 --> 00:03:15,300
إنّها قوّة العواطف

58
00:03:19,230 --> 00:03:22,720
ابتداء من الآن، سأصبّ قوّتي في القفل

59
00:03:22,720 --> 00:03:25,060
وأرشدك إلى مكان مُعيّن

60
00:03:25,550 --> 00:03:29,560
هناك، يجب أن تتذكّر. تذكّر جذورك

61
00:03:29,950 --> 00:03:34,520
ثمّ احفرها في جسدك. احفر
السُّبُلَ الّتي تقودك لتذكّرها

62
00:03:35,530 --> 00:03:37,220
هنا يكمن القسَم

63
00:03:37,710 --> 00:03:40,820
أخفِ الاسم الحقيقيّ المُحرَّم للنّصل
وتعقّب السُّلالة المُوقَّرة

64
00:03:41,490 --> 00:03:43,410
هنا يكمن ثقب المفتاح

65
00:03:43,410 --> 00:03:47,080
،استعِر اسمَ السّاحرة المُكرَّم
والآن افتح الرّواية

66
00:03:50,990 --> 00:03:52,040
فكّ القفل

67
00:03:54,510 --> 00:03:56,210
!توارف هيستوريا

68
00:03:58,640 --> 00:04:00,480
عُد بأمان يا ويل

69
00:04:11,810 --> 00:04:13,110
...هذه

70
00:04:14,050 --> 00:04:15,870
!كلّ ذكرياتي

71
00:04:36,260 --> 00:04:37,800
...مُؤلم

72
00:04:38,310 --> 00:04:39,540
ماذا حدث للتو؟

73
00:04:39,540 --> 00:04:40,760
!ويل

74
00:04:41,150 --> 00:04:43,210
!هل أنت بخير؟

75
00:04:43,870 --> 00:04:44,760
!هاتها

76
00:04:45,470 --> 00:04:47,810
الغابة خطيرة، لذا لنُمسك أيدي بعضنا الآخر

77
00:04:49,650 --> 00:04:51,970
إيلفي؟

78
00:04:52,580 --> 00:04:56,190
!سأحميك يا ويل

79
00:05:12,040 --> 00:05:16,750
الحلقة 21
فتح صفحة جديدة

80
00:06:28,350 --> 00:06:30,450
مهلاً! ما الّذي يجري؟

81
00:06:30,790 --> 00:06:34,870
منزل كليري
القاعدة السّرّيّة للسّاحرات الوحيدات، غرفة النّوم

82
00:06:30,950 --> 00:06:33,100
،مضى أربعة أيّام منذ فقدانه للوعي

83
00:06:33,100 --> 00:06:34,960
!ولم يفتح عينيه ولو لمرّة

84
00:06:35,430 --> 00:06:38,710
إنّه يغوص في أعماق أحلامه

85
00:06:39,700 --> 00:06:42,290
منحَه سحري فُرصة

86
00:06:42,290 --> 00:06:44,720
إنّه في خِضمّ تذكُّر ماضيه

87
00:06:44,720 --> 00:06:47,460
أحلام؟ ماضيه؟

88
00:06:47,460 --> 00:06:52,980
هل تذكُّر أشياء كهذه سيُساعده حقّاً
في اكتساب هذه القوّة الجديدة؟

89
00:06:53,680 --> 00:06:56,760
أنا بحدّ ذاتي غير مُتيقّنة من ذلك

90
00:06:56,760 --> 00:06:58,780
فأساساً، السّيوف هي من اختصاص فين

91
00:06:58,780 --> 00:06:59,480
!بجدّية؟

92
00:07:01,190 --> 00:07:03,880
لا أنوي الدّخول في جِدال حول طُرُق فين

93
00:07:04,240 --> 00:07:05,410
...لكن

94
00:07:05,410 --> 00:07:10,240
،عندما يتعلّق الأمر بقيادة السّماوات
فأعتقد أنّ هناك طُرُقاً أُخرى

95
00:07:11,630 --> 00:07:13,000
عمّاذا تتكلّمين؟

96
00:07:13,860 --> 00:07:16,630
يملأ التّاريخُ جسدَك

97
00:07:17,320 --> 00:07:20,750
آثار العلاقات المُستديمة بين عصا
...السّحر والسّيف

98
00:07:21,180 --> 00:07:23,390
...تتبّعْها بينما تعود بالزّمن

99
00:07:23,390 --> 00:07:25,010
وصولاً إلى أصولك

100
00:07:25,680 --> 00:07:27,430
...وإن أمكن

101
00:07:28,010 --> 00:07:32,060
آمل أن تصل يوماً ما إلى المصدر

102
00:07:35,870 --> 00:07:39,150
يدايّ وقدمايّ صغيرة

103
00:07:39,620 --> 00:07:40,670
...و

104
00:07:42,170 --> 00:07:43,780
!إيلفي أيضاً

105
00:07:43,780 --> 00:07:45,410
ما الأمر يا ويل؟

106
00:07:46,340 --> 00:07:49,610
وكأنّني رجعتُ بالزّمن

107
00:07:51,100 --> 00:07:54,910
هل أنا في الماضي حقّاً؟

108
00:07:55,240 --> 00:07:58,420
هل سحرُها يعكس الزّمن؟

109
00:07:58,420 --> 00:08:03,670
لا. مهما كانت قِواها مُذهلة، لا أحد
يستطيع السّفر إلى الماضي

110
00:08:04,230 --> 00:08:07,290
...في هذه الحالة، هل هذا

111
00:08:04,520 --> 00:08:05,440
أنت

112
00:08:05,440 --> 00:08:06,330
!أنت

113
00:08:06,330 --> 00:08:07,430
ويل؟

114
00:08:07,290 --> 00:08:10,720
هل يُعرَض عليّ الماضي من خلال
شيء أشبه بحلم؟

115
00:08:07,460 --> 00:08:09,720
أنت! ويل؟

116
00:08:11,960 --> 00:08:14,200
!انظر إليّ

117
00:08:15,490 --> 00:08:19,980
ويل، كنتَ تُفكّر في فتاة أُخرى، أليس كذلك؟

118
00:08:19,980 --> 00:08:21,460
!ماذا؟ لا، لم أكن كذلك

119
00:08:21,460 --> 00:08:25,700
لكن في المنزل، أنت لطيفٌ دوماً
!مع كليري والأُخريات

120
00:08:25,700 --> 00:08:28,960
!هذا فقط لأنّني أُساعد أبي

121
00:08:28,960 --> 00:08:30,360
!لا يمكنك

122
00:08:30,360 --> 00:08:33,420
!لن أُسامحك إذا خنتني

123
00:08:31,780 --> 00:08:33,550
،الآن بينما أُفكّر في الأمر

124
00:08:33,420 --> 00:08:39,080
!لا يجوز لك! إطلاقاً يا ويل
!لا أريدك أن تخونني

125
00:08:33,550 --> 00:08:38,080
كانت إيلفاريا أكثر أنانيّة
ممّا هي الآن آنذاك

126
00:08:38,640 --> 00:08:41,920
إيلفي، ما الّذي يمكنني فعله
وذلك كي تُسامحيني؟

127
00:08:39,080 --> 00:08:41,920
!أكره هذا

128
00:08:43,090 --> 00:08:44,770
!احضنّي

129
00:08:52,320 --> 00:08:54,240
!واربت على رأسي أيضاً

130
00:08:54,240 --> 00:08:55,440
حسناً، حسناً

131
00:09:01,310 --> 00:09:03,380
هذا يبعث على الحنين

132
00:09:03,380 --> 00:09:07,730
في ذلك الوقت، كانت دائماً ما تدعني
أُواسيها بهذه الطّريقة

133
00:09:10,430 --> 00:09:15,770
حسناً! تغذّيتُ بقوّة ويل، لذا لنذهب
!ونهزم بعض الوحوش

134
00:09:16,280 --> 00:09:19,250
إ-إيلفي! هل قلتِ هزيمة وحوش؟

135
00:09:19,830 --> 00:09:22,580
يُقال بأنّه يوجد وحشٌ غريبٌ في الغابة

136
00:09:22,580 --> 00:09:26,500
إنّه يُسبّب المشاكل لأبي، لذا
!دعنا لنُسقطه أنا وأنت معاً يا ويل

137
00:09:26,500 --> 00:09:29,460
!ماذا؟ لكن هذا خطير

138
00:09:30,200 --> 00:09:34,760
إيلفي، أنتِ مُذهلة، لكن أنا
لا أستطيع استخدام سحر إطلاقاً

139
00:09:35,380 --> 00:09:36,940
!صوتي يخرج من تلقاء نفسه

140
00:09:37,340 --> 00:09:41,020
لأنّ هذا هو الماضي، هل أتّبع
ما قلتُه في ذلك الزّمان؟

141
00:09:43,590 --> 00:09:48,360
!لا تقلق! أحضرتُ الكتابَ الّذي نُحبّه

142
00:09:48,970 --> 00:09:52,530
مُجرّد امتلاك هذا يمدّنا بالشّجاعة، أليس كذلك؟

143
00:09:53,060 --> 00:09:54,830
!مثل هذا

144
00:09:54,830 --> 00:09:56,660
!لذا سنكون بخير

145
00:09:57,510 --> 00:09:59,880
!سأحميك يا ويل

146
00:10:01,410 --> 00:10:02,770
هذا صحيح

147
00:10:03,450 --> 00:10:07,070
كنتُ في ذلك الزّمان جباناً ورعديداً

148
00:10:07,070 --> 00:10:10,200
ولأنّني كنتُ كذلك، كانت إيلفي تحميني دوماً

149
00:10:15,060 --> 00:10:19,810
متى كانت قد بدأت تعتمد عليّ؟

150
00:10:31,990 --> 00:10:33,170
!حان وقت الاستراحة

151
00:10:33,790 --> 00:10:35,690
...والآن

152
00:10:35,690 --> 00:10:38,330
!سحر مُذهل ما ابتكرتُه بنفسي

153
00:10:38,810 --> 00:10:40,680
!إسنومي لاسلي

154
00:10:45,390 --> 00:10:47,580
!تفضّل يا ويل! هذه لك

155
00:10:49,020 --> 00:10:50,750
!شكراً يا إيلفي

156
00:10:53,550 --> 00:10:56,780
...السّحر السّرّي الثّاني الّذي اخترعَتْه إيلفاريا

157
00:10:56,780 --> 00:11:00,350
كان تعويذة رقيقة تُنشئ سكاكرَ ثلجيّة

158
00:11:03,590 --> 00:11:06,100
أحببتُ هذه السّكاكر الثّلجيّة

159
00:11:06,830 --> 00:11:08,860
احتفظ بهذا سرّاً عن كليري والآخرين

160
00:11:09,210 --> 00:11:10,060
!حسناً

161
00:11:11,510 --> 00:11:15,670
إيلفي، لماذا تعطينني كلّ هذا العدد
الكثير من السّكاكر الثّلجيّة؟

162
00:11:15,670 --> 00:11:21,070
لأنّك تُشارك طعامك دوماً مع الجميع في الميتم

163
00:11:21,550 --> 00:11:22,620
...و

164
00:11:23,140 --> 00:11:27,620
إذا أكلت الكثير منها، فسوف
تشبع منّي، أليس كذلك؟

165
00:11:28,470 --> 00:11:29,480
!أجل

166
00:11:29,480 --> 00:11:30,630
هذا صحيح

167
00:11:31,260 --> 00:11:35,840
والآن، قبل مُغامرتنا، لنُزوّد أنفسنا
!بطاقة قويّة

168
00:11:35,840 --> 00:11:37,930
سأقرأ ثانية اليوم

169
00:11:38,510 --> 00:11:41,890
أنا آسف لأنّني لا أجيد القراءة بعد

170
00:11:41,890 --> 00:11:43,640
!لا، لا عليك

171
00:11:46,180 --> 00:11:47,740
مُغامرات ديمني.

172
00:11:48,230 --> 00:11:50,120
أحبّتْها إيلفي

173
00:11:50,120 --> 00:11:52,840
كانت السّبب في قطعنا وعداً
بأن نرى غروبَ الشّمس معاً

174
00:11:52,840 --> 00:11:54,100
كان ذلك الكتاب ثميناً بالنّسبة لنا

175
00:11:54,730 --> 00:11:56,480
كم يُثير هذا حنيني

176
00:11:56,480 --> 00:11:58,840
،قالت السّاحرة اللّئيمة

177
00:11:59,180 --> 00:12:00,180
"رأيت؟"

178
00:12:00,180 --> 00:12:04,290
هذا الكنز القرمزيّ، أجمل من أيّ كنز آخر"
"!في العالم، غير موجود

179
00:12:04,780 --> 00:12:07,040
"!كلّ ذلك كان من أكاذيبك السّمِجة"

180
00:12:07,760 --> 00:12:10,290
،ردّ البطلُ الجسور

181
00:12:10,290 --> 00:12:13,780
"يبدو أنّ السّماء بمزاج عكِر اليوم"

182
00:12:13,780 --> 00:12:17,300
انتظري قليلاً فحسب. سأذهب"
"وأتكلّم على انفراد

183
00:12:17,700 --> 00:12:21,790
عندما أشهر البطلُ سيفَه، انشقّت
،السّماءُ الرّماديّة

184
00:12:21,790 --> 00:12:25,560
لتكشف عن أجمل قُرمُز في العالم

185
00:12:26,070 --> 00:12:28,260
...لحظة. هذا الرّسم

186
00:12:28,260 --> 00:12:32,240
...لم ألحظ من قبل، لكن يُشبه بعض الشّيء
السّيّد فين...

187
00:12:33,090 --> 00:12:39,230
مفتونة بغروب شمس لا يُنافسه
أيّ كنز، بكَتِ السّاحرة

188
00:12:40,150 --> 00:12:41,820
ثمّ ماذا حدث؟

189
00:12:45,470 --> 00:12:47,830
رُبّما أتخيّل ذلك

190
00:12:48,340 --> 00:12:52,940
،بعد رحلة طويلة، قالت السّاحرة

191
00:12:52,940 --> 00:12:56,360
"...من أجل رؤية غروب الشّمس ذاك ثانية"

192
00:12:57,710 --> 00:12:58,810
ويل؟

193
00:12:59,970 --> 00:13:01,550
هل غلبك النُّعاس؟

194
00:13:01,550 --> 00:13:03,340
أجل. آسف

195
00:13:03,340 --> 00:13:04,220
!لا تقلق

196
00:13:04,680 --> 00:13:07,870
أنا آسفة لإيقاظك باكراً جدّاً

197
00:13:11,340 --> 00:13:13,690
!اليوم، سأدعك تستخدم حضني كوِسادة

198
00:13:15,480 --> 00:13:16,940
هيّا. استلقِ

199
00:13:19,580 --> 00:13:24,700
هذه الحياة اليوميّة الهادئة بوجودنا نحن
الاثنين فقط... أريد العودة إليها

200
00:13:25,270 --> 00:13:28,560
أتساءل ما إن كان من الخطأ الشّعور بذلك

201
00:13:44,640 --> 00:13:45,470
ماذا؟

202
00:13:45,470 --> 00:13:47,350
ماذا؟ إيلفي؟

203
00:13:47,350 --> 00:13:48,270
!آنسة إيلفي؟

204
00:13:48,270 --> 00:13:49,680
!ماذا تحاولين أن تفعلي؟

205
00:13:49,680 --> 00:13:51,230
!مهلاً! انتظري

206
00:13:53,910 --> 00:13:55,980
صباح الخير يا إيلفي

207
00:13:56,460 --> 00:13:57,680
ماذا كنتِ تفعلين؟

208
00:13:57,680 --> 00:13:59,370
!لـ-لـ-لا شيء

209
00:13:59,370 --> 00:14:03,240
،لم ألحظ من قبل، لكن يُشبه بعض الشّيء
لذا كنتُ سأزيله عنك

210
00:14:03,600 --> 00:14:05,030
هذا كلّ ما في الأمر

211
00:14:05,030 --> 00:14:07,280
لماذا تتكلّمين بطريقة غريبة؟

212
00:14:07,760 --> 00:14:09,340
!هـ-هيّا بنا نذهب

213
00:14:09,340 --> 00:14:11,870
!حان وقت حماية سلام الغابة

214
00:14:10,680 --> 00:14:11,870
!إ-إيلفي

215
00:14:12,510 --> 00:14:16,960
في المرّة المُقبلة الّتي أرى فيها
إيلفي، لا أعرف كيف أُواجهها

216
00:14:30,530 --> 00:14:33,600
ثمّة حرب تندلع في هذا
،المكان الّذي يُدعى ريغاردين

217
00:14:33,600 --> 00:14:36,560
ويُقال بأنّ الأشرار والوحوش يهربون من هناك

218
00:14:36,560 --> 00:14:38,120
حقّاً؟

219
00:14:38,120 --> 00:14:40,990
أجل. لهذا السّبب أتى الوحوشُ

220
00:14:40,990 --> 00:14:44,070
!إلى الغابة من ريغاردين ويفعلون أشياء سيّئة

221
00:14:44,710 --> 00:14:46,050
وحوش؟

222
00:14:46,660 --> 00:14:48,410
بدأتُ أتذكّر

223
00:14:48,410 --> 00:14:51,330
...قبل عشر سنوات، أتيتُ أنا وإيلفي إلى هنا

224
00:14:51,780 --> 00:14:54,880
،أتينا إلى هذه الغابة خلف الميتم
نحن الاثنان فقط

225
00:14:55,390 --> 00:14:58,570
لكن قال أبي بأنّنا لا ينبغي
أن نذهب إلى هناك

226
00:15:00,210 --> 00:15:02,620
لـ-لكن ستكونين بخير، أليس كذلك يا إيلفي؟

227
00:15:02,620 --> 00:15:04,190
!اعتمد عليّ

228
00:15:04,850 --> 00:15:07,190
أنا متأكّد بأنّنا خضنا هذه المُحادثة

229
00:15:07,710 --> 00:15:10,890
لكن ذاكرتي بما يحدث لاحقاً ضبابيّة

230
00:15:11,540 --> 00:15:14,660
ماذا حدث فحسب عقب هذا؟

231
00:15:31,070 --> 00:15:31,870
...هذا

232
00:15:38,670 --> 00:15:41,880
ويل في شبابه
طيّب القلب ومُجدّ في العمل، إنّه الطّفل الأكبر في الميتم وغالباً
.ما يُطلب منه التمرُّن على ضبط النّفس، لكن لم يُبدِ ذرّة استياء يوماً
من ناحية، هذا نافع جدّاً، لكن من ناحية أُخرى، هذا يجعلني أشعر
وكأنّه فاشل كبالغ. يبدو أنّه نشأت لديه عقدة بخصوص عدم
القدرة على استخدام السّحر. لكن أشعر بالشّفقة على ويل لقولي هذا، ببساطة
،لا أعتقد بأنّه يمتلك تلك القوّة الخاصّة. ذلك الفتى مُختلف تماماً
.لو كان بالإمكان، أرغب في البقاء بجانبه لرعايته للأبد
.عسى أن تُلازمه بركةُ ملِكة السّحرة
مُقتطفات من مُفكّرة آشلي سيرفورت، الأب المُتبنِّي-

233
00:15:43,670 --> 00:15:46,880
إيلفاريا في شبابها
قائدة بالفطرة وشقيّة ومفتونة بويل، لا يمكنني
أبداً توقُّع ما قد تفعله في أيّ لحظة. علاوة على ذلك، مهارتها السّحريّة
.تتجاوز بسهولة مهارتي، لذا لا أستطيع التحكُّم بها بإرادتي
أعتقد بأنّ إيلفاريا ستُسبّب ثورة في عالمنا السّحريّ، لكن في حال
.لم يكن ويل معها، حينها... سوف تجعل العالمَ كُلّه عدوّها. لا أشكّ بذلك أبداً
.ويل، اعتنِ بها من فضلك. أتوسّل إليك. أنا آسف لكوني أباً مُتبنّياً عاجزاً
مُقتطفات من مُفكّرة آشلي سيرفورت، الأب المُتبنِّي-

234
00:15:47,800 --> 00:15:49,030
ذئب؟

235
00:15:49,390 --> 00:15:52,640
لا... وحش كريستاليّ؟

236
00:15:53,510 --> 00:15:54,890
هذا ليس وحشاً

237
00:15:55,190 --> 00:15:56,390
أعرف ما هو الآن

238
00:15:57,080 --> 00:15:59,900
!هذا وحشٌ مصنوع بالسّحر

239
00:16:00,220 --> 00:16:01,820
إنّه جريح؟

240
00:16:02,260 --> 00:16:04,740
هل هو حقّاً وحدةٌ فرديّة فرّتْ من الحرب؟

241
00:16:07,470 --> 00:16:08,860
!ويل، ابقَ هنا

242
00:16:08,860 --> 00:16:09,820
!إيلفي

243
00:16:10,550 --> 00:16:12,580
!سأقتل هذا الشّيء

244
00:16:15,300 --> 00:16:18,490
!ابتكرتُ سحراً مُذهلاً

245
00:16:23,520 --> 00:16:25,090
!آرس وايس

246
00:16:25,090 --> 00:16:29,090
!أنا ومجموعة كاملة أُخرى من "أنا" سوف نسحقك

247
00:16:31,070 --> 00:16:33,550
!إنّها تُطلق العديد من آرس وايس

248
00:16:33,550 --> 00:16:36,080
كان لديها هذا المُستوى من التحكُّم
!منذ كانت طفلة

249
00:16:36,080 --> 00:16:38,100
!إيلفي مُبهرة حقّاً

250
00:16:39,280 --> 00:16:41,100
...لكن لحظة

251
00:16:41,380 --> 00:16:44,360
لماذا أشعر بقلق شديد؟

252
00:16:45,370 --> 00:16:47,220
!ها نحن أولاء

253
00:16:47,220 --> 00:16:49,110
!تياريس نونو

254
00:16:52,370 --> 00:16:54,280
!إيلفي! اهربي

255
00:16:54,870 --> 00:16:55,620
ماذا؟

256
00:16:58,170 --> 00:16:59,870
—إيلفي! إيلـ

257
00:17:03,900 --> 00:17:07,380
يمتلك ذلك المخلوق القدرةَ الخاصّة
!الّتي عكس السّحر

258
00:17:08,350 --> 00:17:10,970
!اهربي! اهربي يا إيلفي

259
00:17:10,970 --> 00:17:12,790
هذا غير مُؤلم

260
00:17:12,790 --> 00:17:15,140
!أنا لستُ خائفة

261
00:17:15,140 --> 00:17:18,390
!لأنّني سوف أُسقطك

262
00:17:19,640 --> 00:17:22,900
!لأنّني سوف أحمي ويل

263
00:17:26,460 --> 00:17:27,760
لا أستطيع الحركة

264
00:17:28,830 --> 00:17:31,700
...أنا السّبب في أنّ إيلفي قد

265
00:17:32,770 --> 00:17:37,290
!هذا ليس مُمكناً! تحرّك! أسرع
!اخرج من هناك

266
00:17:37,880 --> 00:17:40,950
نسختك الّتي تُنقَذ فيها دوماً بواسطة إيلفي

267
00:17:40,950 --> 00:17:42,790
!هي أكثر ما تكرهه أنت

268
00:17:43,550 --> 00:17:46,040
!هيّا! تحرّك حالاً

269
00:17:46,330 --> 00:17:47,680
!تحرّك

270
00:18:03,350 --> 00:18:06,630
...ماذا؟ ويل

271
00:18:09,140 --> 00:18:11,610
!لا

272
00:18:11,980 --> 00:18:13,860
!ويل؟ ويل؟

273
00:18:13,860 --> 00:18:16,300
!ابقَ معي! ويل! ويل

274
00:18:16,300 --> 00:18:17,480
هذا صحيح

275
00:18:17,950 --> 00:18:20,600
...حميتُ إيلفي

276
00:18:21,150 --> 00:18:23,800
ثمّ فقدتُ الوعي

277
00:18:25,460 --> 00:18:27,840
ماذا حدث بعد ذلك؟

278
00:18:27,840 --> 00:18:29,890
هل أنقذ أحدٌ إيلفي؟

279
00:18:32,180 --> 00:18:34,290
لكن مَن؟

280
00:18:42,630 --> 00:18:43,770
استيقظ

281
00:18:49,870 --> 00:18:52,390
أشعر بحرارة... في جسدي

282
00:18:52,390 --> 00:18:54,780
!سوف أنفجر

283
00:18:54,780 --> 00:18:58,030
!أتحوّل إلى سيف

284
00:18:59,090 --> 00:19:00,290
ويل؟

285
00:19:01,320 --> 00:19:03,040
هذا صحيح

286
00:19:05,880 --> 00:19:08,040
هناك تتمّة لهذه الرّواية

287
00:19:08,460 --> 00:19:09,880
...هذه المُغامرة

288
00:19:11,750 --> 00:19:14,810
كانت بداية السّيف

289
00:19:19,910 --> 00:19:21,640
...تياريس ويس

290
00:19:26,310 --> 00:19:27,990
!المشحونة بالكامل

291
00:19:38,430 --> 00:19:40,280
فهمتُ أخيراً

292
00:19:40,750 --> 00:19:45,160
أعرف سبب ظنّي بأنّ هذه القوّة
كانت لا تُقهَر آنذاك

293
00:19:46,370 --> 00:19:48,290
!هذا لأنّني كنتُ أعلم

294
00:19:48,830 --> 00:19:51,170
...كنتُ أعلم ما صنعَتْه قوّةُ إيلفي

295
00:19:51,820 --> 00:19:53,050
!كنتُ أعرف هذا السّيف الهائل

296
00:19:57,630 --> 00:19:58,380
!ويل

297
00:20:24,990 --> 00:20:26,970
هذا ما حدث إذاً

298
00:20:27,670 --> 00:20:31,320
هذا هو سحرك يا ويل

299
00:20:35,190 --> 00:20:38,030
تِلك كانت بدايتي

300
00:20:38,700 --> 00:20:40,380
...هذه المشاعر الثّمينة

301
00:20:42,440 --> 00:20:43,990
لن أنساها ثانية

302
00:20:45,470 --> 00:20:48,920
سأتذكّر دوماً هذا الرّابط
!الّذي يجمعني بإيلفي

303
00:20:49,430 --> 00:20:51,890
شكراً لك يا ويل

304
00:20:58,990 --> 00:21:01,850
أنت! هل استيقظت؟

305
00:21:01,850 --> 00:21:03,120
يوليوس؟

306
00:21:03,400 --> 00:21:06,310
!بسرعة! كنتَ نائماً لستّة أيّام

307
00:21:06,310 --> 00:21:08,400
!الازدهار الثّاني على وشك البدء

308
00:21:10,320 --> 00:21:12,550
أنت! هل تسمعني؟

309
00:21:12,550 --> 00:21:14,130
!بسرعة

310
00:21:14,860 --> 00:21:17,220
...الطّاقة السّحريّة الّتي ثبتَّها

311
00:21:17,220 --> 00:21:19,630
هل تمكّنتَ من فهم طبيعة ما بداخلك؟

312
00:21:21,450 --> 00:21:22,890
أجل، تمكّنت

313
00:21:23,580 --> 00:21:26,890
هل تعتقد بأنّك ستتمكّن من تذكُّر
الطّرُق الّتي سلكتَها؟

314
00:21:27,760 --> 00:21:29,140
!في أيّ وقت

315
00:21:38,650 --> 00:21:40,440
اذهب إذاً

316
00:21:40,440 --> 00:21:43,010
!اذهب وألّف روايةً جديدة

317
00:21:43,010 --> 00:21:43,920
!حاضر

318
00:23:27,970 --> 00:23:30,930
ويستوريأ: عصا وسيف

319
00:23:36,670 --> 00:23:39,110
،الحلقة القادمة من ويستوريا: عصا وسيف

320
00:23:39,490 --> 00:23:44,280
،الحلقة 22
"آمِلٌ، مُتفتِّح، راعِد"

321
00:23:40,400 --> 00:23:45,900
الحلقة 22
آمل، مُتفتِّح، راعِد