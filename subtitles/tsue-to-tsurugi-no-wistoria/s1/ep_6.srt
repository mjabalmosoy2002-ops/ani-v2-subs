1
00:00:09,030 --> 00:00:13,570
تلميذ في الأكاديميّة السّحريّة ريغاردين، سنة سادسة
ويل سيرفورت

2
00:00:09,090 --> 00:00:11,180
ماذا حدث للتو؟

3
00:00:11,180 --> 00:00:13,200
هل تلقّيتُ ضربة؟

4
00:00:16,770 --> 00:00:18,300
...بحر الأشجار قد

5
00:00:23,080 --> 00:00:26,000
تلميذ في الأكاديميّة السّحريّة ريغاردين، سنة سادسة
شيون ألستير

6
00:00:23,210 --> 00:00:26,000
غادر يا يوليوس. أنت تعترض طريقي

7
00:00:28,040 --> 00:00:29,500
...كان يُصوّب نحو يوليوس

8
00:00:29,770 --> 00:00:33,050
لا، نحو يوليوس وويل

9
00:00:33,880 --> 00:00:36,260
تلميذة في الأكاديميّة السّحريّة ريغاردين، سنة سادسة
كوليت لوير

10
00:00:34,240 --> 00:00:36,260
!ما الّذي تفكِّر فيه يا شيون؟

11
00:00:36,260 --> 00:00:40,260
بقيتُ هادئاً وتماشيتُ مع خديعتكما
حتّى الآن، أليس كذلك يا كوليت؟

12
00:00:40,790 --> 00:00:43,070
لذا أطالب الآن بحقّي

13
00:00:44,120 --> 00:00:47,020
قاتلني أيُّها البليد

14
00:00:48,710 --> 00:00:51,390
عمّاذا يتكلّم؟

15
00:00:52,220 --> 00:00:54,900
هنا؟ الآن؟ أنت وأنا يا شيون؟

16
00:00:54,900 --> 00:00:55,820
لماذا؟

17
00:00:59,980 --> 00:01:05,540
أنت مُزعج للعين والأذن! لستُ
!بحاجة سبب لسحقك حتّى

18
00:01:06,220 --> 00:01:07,710
لِمَ يفعل هذا؟

19
00:01:08,170 --> 00:01:09,660
!توقّف يا شيون

20
00:01:17,740 --> 00:01:19,710
يوليوس؟

21
00:01:18,430 --> 00:01:22,560
تلميذ في الأكاديميّة السّحريّة ريغاردين، سنة سادسة
يوليوس رينبيرغ

22
00:01:19,710 --> 00:01:22,180
مستحيل! كيف نجا من ذلك القصف؟

23
00:01:22,680 --> 00:01:23,680
انتشار الجليد

24
00:01:25,470 --> 00:01:26,330
!كوليت

25
00:01:36,990 --> 00:01:40,870
شيون، كُفّ عن هذا من فضلك! هذا
!ليس وقت الاقتتال بيننا

26
00:01:43,660 --> 00:01:46,970
أمسِك بسيفك بسرعة أيُّها البليد

27
00:03:31,270 --> 00:03:35,360
الحلقة 6
ما بين الكبرياء والشّغف

28
00:03:43,490 --> 00:03:48,120
"أنا عديم الموهبة بلا قيمة"

29
00:03:44,530 --> 00:03:48,120
كان مُثيراً للشّفقة منذ البداية

30
00:03:48,950 --> 00:03:52,220
مُثيراً للشّفقة لدرجة تجعلك تحزن

31
00:03:54,170 --> 00:03:58,630
لهذا قرّرتُ أن أجعله النّظر إليه
يغدو أقلّ إيلاماً

32
00:03:59,330 --> 00:04:00,270
شيون؟

33
00:04:08,360 --> 00:04:10,640
سأدعك تصبح أحد أتباعي

34
00:04:11,020 --> 00:04:14,140
...بهذا الشّكل، لن تشعر نفسك تعيساً

35
00:04:18,390 --> 00:04:19,310
!أنت

36
00:04:20,510 --> 00:04:22,490
!لا تتجاهلني

37
00:04:27,980 --> 00:04:29,240
اغرب عن وجهي من فضلك

38
00:04:43,540 --> 00:04:45,260
...لكنّه

39
00:04:46,200 --> 00:04:50,620
لم ينظر إلينا نظرة احتقار يوماً

40
00:05:05,240 --> 00:05:07,060
...منذ ذلك اليوم

41
00:05:08,030 --> 00:05:11,040
مقتُّه تماماً

42
00:05:16,970 --> 00:05:17,750
!لانسار

43
00:05:24,920 --> 00:05:27,470
!تشابكي يا ورود اللّهب البرّية

44
00:05:36,190 --> 00:05:37,880
!أيُّها اللّهب، أطِعني

45
00:05:37,880 --> 00:05:39,360
!إغنيس روكس

46
00:05:45,780 --> 00:05:49,070
تقفز كالحيوان... هل أنت مهتمّ بالبقاء فقط؟

47
00:05:49,360 --> 00:05:51,080
!تعال وهاجمني

48
00:05:53,270 --> 00:05:54,330
!لا أستطيع فعل ذلك

49
00:05:54,330 --> 00:05:55,790
!قاتلني

50
00:05:56,520 --> 00:05:59,610
نحن في نفس الفريق

51
00:05:59,610 --> 00:06:01,130
...فضلاً عن ذلك

52
00:06:01,130 --> 00:06:04,040
إذا كنتُ سأفي بوعدي للسيّد
،دونّان والآخرين

53
00:06:04,040 --> 00:06:06,250
!فلا أستطيع فعل هذا معك الآن

54
00:06:06,250 --> 00:06:07,660
!لا تعبث معي

55
00:06:07,660 --> 00:06:11,050
إذا كنتَ لن تُقاتل، فسوف أحرقك
!حتّى تُصبِح رماداً

56
00:06:12,620 --> 00:06:15,270
هل مُقاتلته هي خياري الوحيد حقّاً؟

57
00:06:15,980 --> 00:06:19,870
ما هذا؟! ما الّذي يجري هناك؟

58
00:06:19,270 --> 00:06:22,520
تلميذ في الأكاديميّة السّحريّة ريغاردين، سنة سادسة
روستي ناومان

59
00:06:19,870 --> 00:06:22,520
،كانت الفرقة 6 تُحرِز تقدُّماً ثابتاً

60
00:06:22,830 --> 00:06:27,680
لكن الآن الزّميلان في الفريق ويل
!وشيون يتقاتلان فيما بينهما

61
00:06:26,490 --> 00:06:29,530
أستاذ في الأكاديميّة السّحريّة ريغاردين
واركنر نورغرام

62
00:06:27,680 --> 00:06:29,530
!يا له من شِجار غير مُتوقَّع

63
00:06:29,850 --> 00:06:33,300
تلميذ سنة سادسة في أكاديميّة ريغاردين السّحريّة
مايك مايوس

64
00:06:29,850 --> 00:06:34,300
ما رأيك حول الموضوع؟
!نوِّرنا يا حضرة الأستاذ إدوارد

65
00:06:35,610 --> 00:06:40,220
مهما كان السّبب، القتال بين أعضاء
الفريق أمر مرفوض تماماً

66
00:06:35,870 --> 00:06:40,580
أستاذ في أكاديميّة ريغاردين السّحريّة
إدوارد سيرفينس

67
00:06:40,220 --> 00:06:42,840
حتّى بوضع مبادئ هجوم التّاج
،بعين الاعتبار

68
00:06:42,840 --> 00:06:47,800
يمكننا أن نفترض بأنّ كشّافي البرج سوف
يرون هذا كعلامة بارزة ضدّهم

69
00:06:48,600 --> 00:06:52,940
أجل، هذا بائسٌ بالفعل

70
00:06:54,340 --> 00:06:56,600
هـ-هكذا إذاً

71
00:06:56,600 --> 00:06:59,390
!يبدو سعيداً جدّاً وهو يقول ذلك

72
00:07:00,060 --> 00:07:01,830
...شيون ألستير

73
00:07:02,230 --> 00:07:06,070
حتّى اللّحظة، كان يتقدّم بتألُّق مُلفِت

74
00:07:06,360 --> 00:07:08,800
في النّهاية، يبقى مجرّد فتى مدرسة

75
00:07:08,800 --> 00:07:12,220
بالنّقاط الّتي اكتسبَها، مركزه هو
،الرّابع في عامه

76
00:07:12,220 --> 00:07:14,070
لكن هذه المُشكلة تغطّي على ذلك

77
00:07:14,430 --> 00:07:16,400
ما الّذي يفعله شيون؟

78
00:07:14,620 --> 00:07:19,200
الكائن المُرافِق
كيكي

79
00:07:16,400 --> 00:07:19,000
لم أرَ زميلين في فريق يتقاتلان من قبل

80
00:07:22,140 --> 00:07:24,660
بالفعل. أنا قلقٌ أيضاً

81
00:07:26,260 --> 00:07:28,100
أتساءل ما الّذي سيحدث

82
00:07:28,100 --> 00:07:29,880
هل يمكنني الجلوس هنا؟

83
00:07:30,930 --> 00:07:33,150
أنتِ... آيريس، صحيح؟

84
00:07:33,150 --> 00:07:37,350
هذا صحيح! أنا آيريس، الكوهاي
!الّتي تستطيع الانسجام مع أيّ شخص

85
00:07:37,470 --> 00:07:41,480
تلميذة سنة رابعة في أكاديميّة ريغاردين السّحريّة
آيريس تشرشل

86
00:07:37,810 --> 00:07:40,840
مضى وقت طويل، أليس كذلك يا روستي سينباي؟

87
00:07:42,270 --> 00:07:44,340
وبعد، هل يمكنني الجلوس بجانبك؟

88
00:07:44,340 --> 00:07:46,890
!كنتُ أقف طوال هذا الوقت

89
00:07:47,500 --> 00:07:48,400
تفضّلي

90
00:07:48,400 --> 00:07:49,900
!شكراً لك

91
00:07:50,680 --> 00:07:54,540
!ويل سينباي! يمكنك فعلها

92
00:07:55,190 --> 00:08:00,100
هذا غير مُتوقّع. لم أتوقّعكِ أن تُشجّعي
شخصاً مُحدّداً يا آيريس

93
00:08:00,100 --> 00:08:03,000
توقّعتُكِ من النّوع الّذي يتبع الجمهور

94
00:08:03,530 --> 00:08:08,570
لأصدِقك القول، سمعتُ عن ويل
من شخصٍ مُعيّن

95
00:08:08,570 --> 00:08:11,510
...في البداية، لم أكن مهتمّة تماماً

96
00:08:13,790 --> 00:08:16,430
!لكنّني الآن مهووسة

97
00:08:17,290 --> 00:08:18,760
حقّاً؟

98
00:08:23,050 --> 00:08:27,390
...هناك شيون، الّذي يُقاتله الآن، وأنتِ
ويل ذو شعبيّة حقّاً

99
00:08:27,390 --> 00:08:30,030
وأنت كذلك، صحيح يا روستي سينباي؟

100
00:08:30,710 --> 00:08:32,190
بكلّ تأكيد

101
00:08:32,190 --> 00:08:35,080
فأساساً، أحبُّ ويل لأكثر من أيّ شيء آخر

102
00:08:35,980 --> 00:08:38,780
الحُبّ عبء ثقي، صحيح؟

103
00:08:39,120 --> 00:08:41,290
هذا لأنّه زميلي في الغرفة

104
00:08:42,140 --> 00:08:46,510
وهناك أيضاً الآنسة كوليت بكلِّ تأكيد

105
00:08:51,550 --> 00:08:54,300
...عليّ أن أسرع وأوقفهما، لكن

106
00:08:55,050 --> 00:08:56,300
!هناك يوليوس

107
00:08:57,000 --> 00:08:58,730
ما الخطب يا كوليت؟

108
00:08:59,420 --> 00:09:02,810
إذا ظللتِ تركضين، فلن يعتبركِ أحدٌ
جديرة بلقب أميرة الأرض

109
00:09:03,450 --> 00:09:05,310
!لا تنادِني بهذا

110
00:09:05,310 --> 00:09:08,310
!إذا كرّرتها، فسوف أوسعك ضرباً مُبرِحاً

111
00:09:10,060 --> 00:09:11,570
!هذا يكفي

112
00:09:17,270 --> 00:09:19,520
استخدم الانفجار لتحريض فخّ؟

113
00:09:27,460 --> 00:09:31,090
تلميذ سنة سادسة في أكاديميّة ريغاردين السّحريّة
فليب مارتيو

114
00:09:27,460 --> 00:09:31,090
تلميذ سنة سادسة في أكاديميّة ريغاردين السّحريّة
بالم سنوك

115
00:09:27,560 --> 00:09:30,430
هذا غريبٌ بعض الشّيء، أليس كذلك؟

116
00:09:30,430 --> 00:09:31,090
ماذا؟

117
00:09:32,230 --> 00:09:34,990
...معك حقّ. لـ-لماذا

118
00:09:34,990 --> 00:09:37,090
!لماذا هناك الكثير من يوليوس؟

119
00:09:38,990 --> 00:09:42,550
يوليوس؟ ماذا تفعل هنا؟

120
00:09:40,470 --> 00:09:43,100
تلميذة في أكاديميّة ريغاردين السّحريّة، سنة سادسة
إيما كليفر

121
00:09:49,570 --> 00:09:51,390
يوليوس

122
00:09:49,730 --> 00:09:54,190
تلميذة في أكاديميّة ريغاردين السّحريّة، سنة سادسة
فيغنال ليندور

123
00:09:51,390 --> 00:09:54,610
هل أتيتَ لمُقابلتي مثلما أعلنت بأنّك ستفعل؟

124
00:09:55,070 --> 00:09:58,290
أجل. قلتُ لك بأنّني أعلنتُ الحرب، أليس كذلك؟

125
00:09:58,290 --> 00:10:01,710
وبأنّني سأستخدم سلاحي السرّي لسحقكم جميعاً

126
00:10:01,710 --> 00:10:02,870
هكذا إذاً

127
00:10:03,230 --> 00:10:06,120
حسناً، قبل ذلك، اسمح لي أن أُعيد
إليك هديّة الزّهرة

128
00:10:19,670 --> 00:10:22,210
شكراً لك يا فيغنال-ساما

129
00:10:19,760 --> 00:10:24,350
تلميذة في أكاديميّة ريغاردين السّحريّة، سنة سادسة
كارين مايني

130
00:10:19,760 --> 00:10:24,350
تلميذة في أكاديميّة ريغاردين السّحريّة، سنة سادسة
تيري فورو

131
00:10:22,210 --> 00:10:27,770
ما الّذي يجري؟ لِمَ يتكبّد يوليوس
عناء الخروج إلى هنا؟

132
00:10:28,610 --> 00:10:30,780
كان ذلك مُتقَناً يا يوليوس

133
00:10:32,550 --> 00:10:35,780
من كان يتوقّع أن يُخفي خدعة
كهذه في جعبته؟

134
00:10:37,460 --> 00:10:40,170
...هذه من الماجيا فيندر

135
00:10:40,890 --> 00:10:43,870
،لا أملك فكرة عمّا يجري

136
00:10:43,870 --> 00:10:47,790
لكن ظهرَ يوليوس فجأة ليتمّ
!إسقاطه بواسطة الفرقة 12

137
00:10:48,110 --> 00:10:51,650
!لا نتوقّع أقلّ من هذا من الإيلف
!هذا هو فيغنال-ساما الّذي عهِدناه

138
00:10:51,650 --> 00:10:53,790
!واصلي في القتال يا مدّخراتي في القتال

139
00:10:54,610 --> 00:10:59,300
ما تقييمك لنسيبنا في الأكاديميّة؟

140
00:11:00,150 --> 00:11:03,920
مُتوسِّطة. لا يتفوّق ولا يفشل
في الارتقاء للتوقُّعات

141
00:11:00,300 --> 00:11:05,140
ضابِطة مُرافِقة في جماعة الإيلف
فيلفيس كاليا

142
00:11:03,920 --> 00:11:05,820
هذا قاسٍ جدّاً

143
00:11:05,820 --> 00:11:08,820
الأهمّ يا ليفيا، أريد العودة فوراً

144
00:11:09,250 --> 00:11:12,560
بالنّسبة لانطوائيّة مثلي، أجواء
هذا المهرجان لا تُحتمَل

145
00:11:12,560 --> 00:11:13,470
أريد أن أموت

146
00:11:13,470 --> 00:11:14,600
لا يمكنك

147
00:11:13,560 --> 00:11:18,320
ضابِطة مُرافِقة في جماعة الإيلف
ليفيا فيريديس

148
00:11:14,600 --> 00:11:18,430
هذا مهرجان لسكّان الجنّة، الرّيزانث

149
00:11:19,540 --> 00:11:24,150
والآن كيف سنُبلِغ عن هذا لإيلينور-ساما؟

150
00:11:25,130 --> 00:11:29,440
أتساءل ما إن كان الفائز سينحصر
بين يوليوس وفيغنال-ساما

151
00:11:29,440 --> 00:11:33,730
كانت الفرقة 6 قريبة جدّاً. لو لم يفعل
...شيون ذلك، لكان

152
00:11:33,730 --> 00:11:39,920
،أقصد بأنّني لا أريد عديم الموهبة أن يفوز
لكن هذا غير مسبوق، صحيح؟

153
00:11:38,170 --> 00:11:42,340
تلميذ في الأكاديميّة السّحريّة ريغاردين، سنة سادسة
غوردون فالي

154
00:11:40,530 --> 00:11:43,220
ما الّذي أصاب شيون؟

155
00:11:43,630 --> 00:11:47,010
،أعلم بأنّه يكره البليد

156
00:11:47,660 --> 00:11:50,460
...لكن أن يفعل هذا في مهرجان السّحر العظيم

157
00:11:51,220 --> 00:11:53,580
ما الّذي هو غاضب منه؟

158
00:11:54,670 --> 00:11:58,940
أتفهّم شعور شيون بعض الشّيء

159
00:11:54,810 --> 00:11:59,150
تلميذ في الأكاديميّة السّحريّة ريغاردين، سنة سادسة
ليريل مارس

160
00:11:58,940 --> 00:11:59,730
ماذا؟

161
00:11:59,730 --> 00:12:01,920
إنّ محاولة دفع الأمور لطرده من الأكاديميّة

162
00:12:01,920 --> 00:12:05,560
،لأنّه لم يرقه فقط قد تكون مُبالَغة

163
00:12:07,300 --> 00:12:09,560
...لكن أنا متأكّد بأنّ شيون

164
00:12:15,510 --> 00:12:18,900
لماذا يركّز شيون عليّ؟

165
00:12:20,420 --> 00:12:21,630
عصا هالكون

166
00:12:21,970 --> 00:12:25,050
شيون ألستير
العِرق: ريزانث
العمر: 16
الطّول: 171 سم
:يوم الميلاد
اليوم 13 من نالسمون
يحبّ: المارشملّو المليئة بالعسل
(لم يخبر أحداً بهذا)
يكره: عديمو الموهبة الّذين لا ينظرون إليه حتّى
الحُبّ الأوّل: كوليت لوير قبل خمس سنوات
أعمق طابق وصل إليه في الدّيماس: السّادس
العتاد: عصا هالكون، قميص وجزمة جلديّة
من العلامة التّجاريّة الخاصّة بالنُّبلاء، ليسايل
،المهارات: سحر النّار، معظمها تعويذات برتبة متوسّطة ومنخفضة
بالإضافة إلى تعويذة تلّة الحريق الهائل
(إفلامي بارديليون)
.وريث عائلة ألستير، أسياد اللّهب السّحريّ
لديه أخت صغرى واحدة. ثمّة حادثة وقعت عندما كان في السّنة
،الأولى جعلَتْه يُراقب ويل بشدّة
.والّذي يعتبره عدوّاً

167
00:12:27,300 --> 00:12:30,060
ميرسيديس كاوليس، برج السّاحر
".هذا شبيه بالقصبة الّتي قد تنكسر في أي لحظة"
ملِكة ساحرة ما تسخر من نفسها-

168
00:12:41,240 --> 00:12:43,200
لماذا تُعرقِلون عملي؟

169
00:12:46,360 --> 00:12:48,430
لماذا تتنمّرون عليّ؟

170
00:12:50,870 --> 00:12:53,120
لم أفعل شيئاً لكم، أليس كذلك؟

171
00:12:55,980 --> 00:13:00,590
أنا خير من يعلم بأنّني فاشل

172
00:13:03,290 --> 00:13:05,370
لن أطلب منكم أن تقبلوني

173
00:13:06,520 --> 00:13:08,500
لم أطلب طلباً أنانيّاً كهذا

174
00:13:10,070 --> 00:13:10,850
...لذا

175
00:13:12,210 --> 00:13:13,850
دعوني وشأني فحسب أرجوكم

176
00:13:16,780 --> 00:13:18,030
اغرب عن وجهي رجاء

177
00:13:29,780 --> 00:13:31,320
لا أملك الوقت

178
00:13:31,900 --> 00:13:33,870
لا يسعنى الإشاحة بنظري عن هدفي

179
00:13:36,470 --> 00:13:38,240
يجب أن أذهب

180
00:13:38,910 --> 00:13:40,600
!يجب أن أصل إلى إيلفي

181
00:13:58,520 --> 00:14:01,440
!احترِق، ابكِ، اغضب، حلِّق

182
00:14:01,760 --> 00:14:03,630
!تنتمي هذه السّماوات إلى أجنحتك

183
00:14:04,380 --> 00:14:07,610
...أنادي باسمك، أيّها الباز النّاري الحارس

184
00:14:11,150 --> 00:14:13,200
!هالكون غارديناس

185
00:14:16,260 --> 00:14:19,210
!باز من لهب؟ هل هذا حارس؟

186
00:14:19,630 --> 00:14:20,580
!انطلِق

187
00:14:25,410 --> 00:14:27,220
!الحارس يُهاجم

188
00:14:30,040 --> 00:14:32,050
...إذا استطعتُ قصّ جناحيه

189
00:14:32,980 --> 00:14:34,550
!هذه فُرصي للنّيل من شيون

190
00:14:38,510 --> 00:14:39,690
تجدُّد عالي السّرعة؟

191
00:14:40,980 --> 00:14:44,070
يجب أن أحرص على تدمير نُواته
!وإلّا فلن يتوقّف هذا

192
00:14:44,070 --> 00:14:45,970
!نَلْ منه يا هالكون

193
00:14:55,370 --> 00:14:59,040
يُستخدَم الحارس بشكل رئيسي للدّفاع
وكسب الوقت من أجل تعزيم ما

194
00:14:59,040 --> 00:15:02,420
!لكن هذا الحارس يُهاجم من كافّة الاتِّجاهات

195
00:15:19,650 --> 00:15:21,780
يا لها من براعة هائلة

196
00:15:21,780 --> 00:15:25,050
تخطّى مستوى التّلميذ بالفعل

197
00:15:25,050 --> 00:15:27,280
...إفلامي بارديليون

198
00:15:27,280 --> 00:15:30,610
لا يستطيع استخدام تعويذة ناريّة رفيعة
المستوى فحسب، بل استدعى حارساً أيضاً

199
00:15:30,610 --> 00:15:34,140
أن يتمكّن من تنفيذ سيطرة سحريّة دقيقة
...كهذه من تلقاء نفسه

200
00:15:34,450 --> 00:15:36,250
ما المعلومات التّي لدينا حول هذا التّلميذ؟

201
00:15:34,950 --> 00:15:39,250
كشّاف جماعة النّار
رودج هولّاند

202
00:15:36,250 --> 00:15:42,330
اسمه شيون ألستير يا سيّدي. إنّه وريث
عائلة ألستير، أسياد سحر اللّهب

203
00:15:42,610 --> 00:15:45,780
،وفقاً لتقارير المُراقبين، لديه إمكانيّات

204
00:15:45,780 --> 00:15:50,430
لكن يُصنَّف خلف ليهانا أوينزوس وبقيّة
الثّلاثة الأفضل

205
00:15:51,130 --> 00:15:54,100
إذاً كان لديه حافز للتقدُّم والاختراق، صحيح؟

206
00:15:55,290 --> 00:15:57,350
لهذا السّبب لا أحد يستطيع
أن يتوقّع تصرُّفات التّلاميذ

207
00:15:57,860 --> 00:16:00,240
في الوقت الّذي تعتقد فيه بأنّهم
،مجرّد صيصان حديثة الولادة

208
00:16:00,240 --> 00:16:02,940
يظهر أحدهم ويتحوّل إلى صقر

209
00:16:02,940 --> 00:16:05,420
مهرجان السّحر العظيم مُفيد حقّاً، أليس كذلك؟

210
00:16:06,340 --> 00:16:11,370
أبلغ كاريوت-ساما. قُل له بأنّ هناك
محصول جيّد غير مُتوقَّع

211
00:16:12,150 --> 00:16:14,820
عصا إمبراطور اللّهب
كاريوت إنشينديا وايزمان

212
00:16:23,470 --> 00:16:24,660
...شيون

213
00:16:25,530 --> 00:16:27,030
!أصبح أقوى

214
00:16:27,720 --> 00:16:30,040
أهذا كلّ ما لديك أيُّها البليد؟

215
00:16:30,740 --> 00:16:35,090
كنتَ أفضل من ذلك عندما
!هزمتَ الخفير الشرّير ذاك

216
00:16:36,600 --> 00:16:40,720
لستُ أفهم يا شيون. لماذا تفعل هذا؟

217
00:16:41,240 --> 00:16:43,600
!لا سبب يدفعك لمُقاتلتي

218
00:16:46,190 --> 00:16:48,480
أتقول ذلك بجدّية؟

219
00:16:49,240 --> 00:16:53,360
،بعد تعرّضك لكلّ هذا الاستهزاء
!ومُعاناتك من مثل هذه الإهانات

220
00:16:53,860 --> 00:16:57,490
بعد كلّ شيء مررتَ به، تقول
!لي بأنّك لا تكرهني؟

221
00:16:57,490 --> 00:17:01,170
!أنا أكرهك! وأنا أستشيط غضباً

222
00:17:01,170 --> 00:17:04,250
لم أعُد أحصي عدد المرّات الّتي
!تخيّلتُ فيها نفسي أنتقم منك

223
00:17:04,620 --> 00:17:08,340
!لكن الآن، عليّ أن أهزم يوليوس

224
00:17:08,340 --> 00:17:10,380
!لذا لا أملك الوقت لمُقاتلتك

225
00:17:08,920 --> 00:17:10,380
يوليوس؟

226
00:17:10,790 --> 00:17:12,880
أتُمازحني؟

227
00:17:13,410 --> 00:17:17,010
مجرّد رؤيتك تستفزّني لدرجة
!لا أستطيع فيها التحمُّل

228
00:17:17,010 --> 00:17:22,270
إنَّ رؤيتك ترفض الاستسلام رغم أنّك
!عديم الموهبة تُثير غضبي

229
00:17:22,270 --> 00:17:27,020
ومع ذلك أنت... لماذا تتجاهلني
!دوماً ولا تنظر إليّ؟

230
00:17:27,020 --> 00:17:28,900
!لا تتجاهلني

231
00:17:30,650 --> 00:17:32,670
!انظر إليّ

232
00:17:39,420 --> 00:17:43,820
شيون... أهكذا هي نظرتك لي؟

233
00:17:44,910 --> 00:17:47,790
!لا أبالي لوضعك

234
00:17:47,790 --> 00:17:52,670
،إذا أخبرتني بمزيد من هذا الهُراء
!فسوف أسحقك هنا حالاً

235
00:17:56,800 --> 00:17:58,880
لن أطلب منك أن تقبلني

236
00:17:59,680 --> 00:18:01,610
لن أطلب شيئاً أنانيّاً كهذا

237
00:18:02,550 --> 00:18:07,150
لكن إذا أردتَ الصّدق، في مكانٍ ما
في قلبي، هذا ما أردتُه

238
00:18:07,910 --> 00:18:12,570
...إذاً إن كنتَ تقول بأنّك ستعترف بي يا شيون

239
00:18:13,990 --> 00:18:17,480
فيجب عليّ إذاً أن أقبل بتحدّيك
!بكلّ ما أوتيت من قوّة

240
00:18:19,530 --> 00:18:23,580
،أخيراً وضعتَ نُصب عينيك عليّ
أليس كذلك أيُّها البليد؟

241
00:18:24,550 --> 00:18:25,930
!يا حجر السّماء

242
00:18:25,930 --> 00:18:27,550
!يا إرادة أدراس

243
00:18:28,120 --> 00:18:31,160
،غطِّي نفسكِ بالعاصفة، تغنّي بالكارثة النّاريّة

244
00:18:31,160 --> 00:18:33,590
!أمطِري باسم قاتل التنّين

245
00:18:34,300 --> 00:18:37,220
سيتصدّى الحارسُ لأي مُحاولات
غير مُتقَنة للاقتراب

246
00:18:42,520 --> 00:18:44,060
!حلِّق يا هالكون

247
00:18:44,060 --> 00:18:46,060
!دراغوس ناول

248
00:18:46,520 --> 00:18:49,560
سحر تدميريّ واسع النّطاق وهجوم حارس؟

249
00:18:50,040 --> 00:18:51,440
!هجومان في آن واحد

250
00:18:55,530 --> 00:18:56,320
...رغم ذلك

251
00:18:56,680 --> 00:18:59,570
!رأيتُ مسارَه بالفعل

252
00:19:09,340 --> 00:19:11,750
...فقدَ الأمل من الدّفاع ضدّ سحري التّدميريّ

253
00:19:13,230 --> 00:19:16,380
!وقطعَ نُواة الحارس؟

254
00:19:20,270 --> 00:19:23,300
!لم ينتهِ الأمر بعد

255
00:19:27,310 --> 00:19:30,810
!توقّفا حالاً

256
00:19:30,810 --> 00:19:31,830
!ماذا؟ لحظة

257
00:19:36,150 --> 00:19:37,430
...مؤلم

258
00:19:41,030 --> 00:19:42,820
كوليت؟

259
00:19:43,300 --> 00:19:44,950
لحظة، أين يوليوس؟

260
00:19:45,530 --> 00:19:48,700
ركلتُ مؤخّرته! لكنّه اختفى فجأة

261
00:19:49,270 --> 00:19:50,440
اختفى؟

262
00:19:52,920 --> 00:19:55,960
كوليت! هل رأيتِ نفسكِ؟

263
00:19:55,960 --> 00:19:59,710
أن تكشف ابنة عائلة نبيلة غير مُتزوّجة

264
00:20:00,330 --> 00:20:02,610
...عن نفسها بهذا الشّكل غير المحتشِم لَهو

265
00:20:02,610 --> 00:20:03,810
أنا غير مُحتشِمة؟

266
00:20:03,810 --> 00:20:06,970
أنت السّبب من الأساس لأنّك
!افتعلتَ القِتال

267
00:20:09,940 --> 00:20:11,480
ويل، اسبقني أنت

268
00:20:11,740 --> 00:20:12,480
ماذا؟

269
00:20:13,290 --> 00:20:15,770
عليك حسم الأمور مع يوليوس، صحيح؟

270
00:20:15,770 --> 00:20:17,480
يمكنني تولّي زمام الأمور هنا

271
00:20:17,760 --> 00:20:21,990
ما هذا الهُراء يا كوليت؟! لن أدع
...أحداً يعترض طريقي، ولا حتّى

272
00:20:22,280 --> 00:20:24,530
!أنت من اعترض طريقي

273
00:20:24,530 --> 00:20:28,060
!كانت هذه فُرصة ويل ليُلفِت أنظار البرج

274
00:20:32,370 --> 00:20:34,200
شكراً لكِ يا كوليت

275
00:20:38,910 --> 00:20:40,660
!أ-أنت! انتظر

276
00:20:40,660 --> 00:20:43,510
آسف يا شيون! لنخُض معركةً
حقيقيّة في المرّة المُقبِلة

277
00:20:43,510 --> 00:20:44,820
!أنت

278
00:20:48,220 --> 00:20:53,780
!هذا غير معقول! قاتلني

279
00:20:55,680 --> 00:20:58,440
بعد لحظاتٍ من الآن، بعد كلّ العقبات
،الّتي تجاوزوها

280
00:20:58,440 --> 00:21:01,850
!ستدخل الفِرق الرّئيسيّة الملعب

281
00:21:02,640 --> 00:21:07,200
والآن، من سيكون أوّل من يظهر؟

282
00:21:11,910 --> 00:21:17,000
!إنّها الفرقة 9، بقيادة يوليوس رينبيرغ

283
00:21:19,000 --> 00:21:25,590
لا أحد هنا لإيقافهم. التّاج
...المجيد هو في قبضة

284
00:21:25,930 --> 00:21:26,630
ماذا؟

285
00:21:37,620 --> 00:21:39,610
...هـ-هذا

286
00:21:47,410 --> 00:21:48,360
!ويل

287
00:21:52,380 --> 00:21:54,700
أتحدّاك يا يوليوس

288
00:23:37,770 --> 00:23:40,610
،الحلقة القادمة من ويستوريا: عصا السّحر والسّيف

289
00:23:40,610 --> 00:23:43,700
الحلقة 7، "الأسحار الجليديّة السرّية
"الإثنا عشر، إيل غلاس فروس

290
00:23:41,810 --> 00:23:46,070
الحلقة 7
الأسحار الجليديّة السرّية الإثنا عشر، إيل غلاس فروش