1
00:00:03,690 --> 00:00:09,620
!لا شيء يمكنك فعله... لا أقدر عليه

2
00:00:09,620 --> 00:00:13,450
!إفلامي بارديليون

3
00:00:26,920 --> 00:00:27,920
!شيون

4
00:00:30,260 --> 00:00:33,420
هذا مستحيل... لم يكن ذلك كافياً
لهزيمته أيضاً؟

5
00:00:33,850 --> 00:00:36,800
تلقّى تعويذة مُتقدِّمة من مسافة
...قريبة، ومع ذلك

6
00:00:36,800 --> 00:00:38,450
!يا له من وحش

7
00:00:39,080 --> 00:00:41,930
العصا غير كافية لهزيمته

8
00:00:42,250 --> 00:00:45,190
ولا يستطيع السّيف قتله

9
00:00:48,760 --> 00:00:49,690
ماذا؟

10
00:00:50,430 --> 00:00:51,940
...هذا

11
00:00:58,250 --> 00:01:00,030
تذكّر يا ويل

12
00:01:00,980 --> 00:01:03,640
إنّها عصا سحريّة وسيف

13
00:01:14,290 --> 00:01:16,090
هل أنتِ متأكِّدة من هذا؟

14
00:01:16,090 --> 00:01:19,350
كفّي عن السُّؤال. اتّخذتُ قراري

15
00:01:20,050 --> 00:01:23,080
لأجل حماية هذا العالم

16
00:01:25,060 --> 00:01:28,480
...ذات يوم، العصا السّحريّة والسّيف

17
00:01:28,850 --> 00:01:30,860
سيلتقيان وينضمّان لبعضهما

18
00:01:37,080 --> 00:01:39,990
...عصا سحريّة وسيف

19
00:01:44,040 --> 00:01:45,250
!شيون

20
00:01:45,710 --> 00:01:46,660
!سحر

21
00:01:46,660 --> 00:01:48,170
!عصا سحريّة وسيف

22
00:01:53,460 --> 00:01:55,510
!إغنيس روكس

23
00:02:04,400 --> 00:02:05,320
...هل هذا

24
00:02:05,730 --> 00:02:06,350
مستحيل

25
00:02:10,350 --> 00:02:11,270
!ويس

26
00:02:11,880 --> 00:02:13,860
ما-ما هذا؟

27
00:02:14,240 --> 00:02:16,760
السّيف مُطوّق بلهب؟

28
00:02:16,760 --> 00:02:18,100
سحر تعزيميّ؟

29
00:02:18,100 --> 00:02:19,610
لا... إنّه شيء آخر

30
00:02:19,950 --> 00:02:22,370
السّيفُ التهمَ التّعويذة؟

31
00:02:23,030 --> 00:02:25,490
...أيُّها البليد، أنت

32
00:02:34,040 --> 00:02:35,880
كان مجال رؤيتي أحمر

33
00:02:36,290 --> 00:02:37,920
تراكمت القوّة في داخلي

34
00:02:38,350 --> 00:02:41,490
شعرتُ وكأنّ سيلاً من القوّة يتدفّق
في داخلي ويحفّزني

35
00:02:41,890 --> 00:02:44,940
وسرعان ما وجدتُ نفسي أمنحه اسماً

36
00:02:45,880 --> 00:02:47,760
...إغنيس ويس

37
00:03:03,230 --> 00:03:05,180
!المشحون بالكامل

38
00:04:39,250 --> 00:04:43,340
الحلقة 12
عصا سحريّة وسيف

39
00:05:18,380 --> 00:05:20,780
القوّة... تغادرني

40
00:05:22,670 --> 00:05:24,860
يعود سيفي إلى طبيعته

41
00:05:26,680 --> 00:05:29,390
ماذا كان ذلك للتو؟

42
00:05:29,980 --> 00:05:32,390
هزمَ ديوكاً عظيماً

43
00:05:32,390 --> 00:05:33,520
!ويل

44
00:05:40,200 --> 00:05:42,520
قطيع من وحوش الخفير والحرَس؟

45
00:05:43,080 --> 00:05:46,530
هل يُعقَل أنّهم سمعوا سكرات
موت ديوك العظيم؟

46
00:05:47,020 --> 00:05:48,360
...مستحيل

47
00:05:49,010 --> 00:05:52,790
!لم تبقَ فينا ذرّة قوّة للقتال

48
00:05:53,280 --> 00:05:54,270
اللّعنة

49
00:05:57,330 --> 00:05:59,170
!بسرعة يا واركنر

50
00:05:59,620 --> 00:06:01,290
!ا-ابتعد

51
00:06:02,670 --> 00:06:04,800
!لا جدوى! لن نصل في الوقت

52
00:06:05,150 --> 00:06:06,300
!يوليوس

53
00:06:13,900 --> 00:06:17,730
،أنزِل حكمك، أيّها الملِك الحكيم
يا قاهر الشرّ

54
00:06:19,800 --> 00:06:22,600
!لوا إيلوزا

55
00:06:29,590 --> 00:06:31,880
تعويذة إبادة ذات مستوى رفيع؟

56
00:06:31,880 --> 00:06:33,290
لكن من يُمكن أن يكون قد أطلقها؟

57
00:06:38,910 --> 00:06:41,420
...تلك العصا السّحريّة... أيُعقَل

58
00:06:45,560 --> 00:06:47,170
...أنت

59
00:06:49,380 --> 00:06:54,100
عصا حاكم الضّوء السّحريّة
آرون ماستيرياس أولدكينغ

60
00:06:49,570 --> 00:06:53,030
!آرون ماستيرياس أولدكينغ

61
00:06:56,780 --> 00:07:00,880
ملِك الماجيا فيندر وأقوى عصا
سحريّة من بين الجميع

62
00:07:01,930 --> 00:07:03,420
ماذا يفعل هنا؟

63
00:07:04,680 --> 00:07:06,940
عتاد للغوص في أعماق الدّيماس؟

64
00:07:07,430 --> 00:07:09,360
هل هو عائد من حملة؟

65
00:07:12,490 --> 00:07:16,250
،أولئك الّذين يتحدّون ظلامَ الدّيماس

66
00:07:16,250 --> 00:07:18,950
أمنحهم بركةَ النُّور

67
00:07:19,390 --> 00:07:24,460
قاتلتم ببسالة يا أبناء السّحر

68
00:07:29,740 --> 00:07:30,970
!مرحى

69
00:07:32,460 --> 00:07:38,970
حتّى الإيلف يرتعشون فرحاً
في حضرته. الجميع يعبدونه

70
00:07:39,440 --> 00:07:43,480
وبينما كانت عيون الجميع مُركّزة
،نحو الحاكم الأوحد

71
00:07:44,490 --> 00:07:45,740
...عينايّ

72
00:07:46,820 --> 00:07:48,960
كانتا منجذبتين نحو هو

73
00:07:54,760 --> 00:07:56,070
هذه مُفاجأة

74
00:07:57,020 --> 00:07:59,320
إذاً السّيف لا يزال حيّاً، أليس كذلك؟

75
00:08:01,010 --> 00:08:02,660
ما اسمك؟

76
00:08:07,370 --> 00:08:10,170
ويل سيرفورت

77
00:08:11,030 --> 00:08:12,420
من أنت؟

78
00:08:15,730 --> 00:08:19,050
اسمي فين. فقط فين

79
00:08:29,820 --> 00:08:34,320
كان التحرّك لنقل البضاعة القرار الصّائب

80
00:08:34,810 --> 00:08:39,690
لو تعرّضنا لهجوم، لما كانت قد سنحت
الفُرصة لنا لاستعادة هذا

81
00:08:41,070 --> 00:08:44,460
وحبّذا ألّا أصطدم بأولئك الأشخاص

82
00:08:45,330 --> 00:08:48,210
لكن أنجزنا مهمّتنا

83
00:08:50,180 --> 00:08:53,180
!والآن يمكننا إقامة حفلة جنونيّة

84
00:09:02,090 --> 00:09:05,830
وهكذا انتهى التّطبيق العمليّ لكافّة
التّلاميذ بصورة غير مسبوقة

85
00:09:06,660 --> 00:09:11,000
كانت هناك أحد عشر ضحيّة. جميعهم
من أساتذة الأكاديميّة

86
00:09:11,650 --> 00:09:14,410
،بفضل جهود طاقم التّدريس النّاجي

87
00:09:14,410 --> 00:09:16,340
لم يقع أي ضحيّة في صفوف التّلاميذ

88
00:09:17,090 --> 00:09:22,170
سعت المدرسة للحصول على أيّ معلومات
،حول المسؤولين عن الحادثة

89
00:09:22,170 --> 00:09:24,100
لكن لم تتوصّل إلى أي طرف خيط بعد

90
00:09:25,210 --> 00:09:27,870
،رغم أنّهم ما زالوا مصدومين بسبب ما حدث

91
00:09:27,870 --> 00:09:31,920
بدأ النّاجون باستراحتهم

92
00:09:38,730 --> 00:09:42,640
من كان ذلك الثّنائي المشؤوم على أيّ حال؟

93
00:09:43,170 --> 00:09:44,680
لا أملك فكرة

94
00:09:44,680 --> 00:09:48,370
إنّهما مُنحرِفان يملكان القوّة الكافية
،لقتل أساتذة الأكاديميّة

95
00:09:48,370 --> 00:09:50,520
لكن عدا عن ذلك، لا نعرف شيئاً

96
00:09:51,000 --> 00:09:55,790
الأستاذ برونو والآخرون... لا أصدّق
بأنّهم ماتوا حقّاً

97
00:09:56,730 --> 00:09:57,880
...كوليت

98
00:09:59,940 --> 00:10:02,960
،لولا وجود فرقة ماستيرياس نوه هناك

99
00:10:02,960 --> 00:10:05,260
فلا أعلم ماذا كان ليحلّ بنا

100
00:10:05,990 --> 00:10:08,290
رغم ذلك، نحن على قيد الحياة

101
00:10:08,920 --> 00:10:13,180
،في وجه قسوة مُرعبة كهذه
لم نخسر أي فرد من فريقنا

102
00:10:13,600 --> 00:10:16,730
لم أكن أؤدّي المهمّة بداعي الشّهامة

103
00:10:18,010 --> 00:10:21,410
أسّستُ فريقنا لكسب الاعتراف من البرج

104
00:10:21,410 --> 00:10:24,810
وإذا بي أتمتّع بعين ثاقبة على ما يبدو

105
00:10:26,350 --> 00:10:27,880
شكّلنا فريقاً جيّداً

106
00:10:28,420 --> 00:10:33,630
بصفتي الأصغر سنّاً في سلالة الفُرسان
الطوّيلة، أنا ممتنّة لكم

107
00:10:46,280 --> 00:10:48,400
هل أنتِ جائعة يا ليهانا؟

108
00:10:50,840 --> 00:10:51,960
!افتحي فمكِ

109
00:10:55,380 --> 00:10:56,240
لذيذة؟

110
00:10:57,050 --> 00:10:59,720
أجل. قطعة أخرى من فضلكِ

111
00:11:00,110 --> 00:11:01,190
!بكلِّ تأكيد

112
00:11:04,580 --> 00:11:05,600
أخرى

113
00:11:05,600 --> 00:11:06,470
!بكلِّ تأكيد

114
00:11:07,600 --> 00:11:08,650
أخرى

115
00:11:08,650 --> 00:11:10,020
تريدين أكل المزيد؟

116
00:11:11,320 --> 00:11:12,270
أخرى

117
00:11:12,270 --> 00:11:13,190
!انتظري

118
00:11:14,250 --> 00:11:15,090
أخرى

119
00:11:15,090 --> 00:11:16,480
!كم واحدة ستأكلين؟

120
00:11:16,480 --> 00:11:18,810
!لم يبقَ شيء لويل الآن

121
00:11:18,810 --> 00:11:20,830
لم أكن أعلم بأنّكِ تحبّين الطّعام
!إلى هذه الدّرجة

122
00:11:20,830 --> 00:11:21,990
!ا-الأمر ليس كذلك

123
00:11:22,490 --> 00:11:25,710
سحر القتال من مسافات قريبة الّذي
،أستخدمه لا يستهلك سحراً فحسب

124
00:11:25,710 --> 00:11:27,580
يستهلك لياقة عالية أيضاً

125
00:11:27,580 --> 00:11:30,770
من الطّبيعيّ أن ألتهم طاقة
أكبر من معظم السّحرة

126
00:11:30,770 --> 00:11:35,050
لذا كما ترين، لستُ شرِهة. آمل
ألّا تسيئي الفهم

127
00:11:35,050 --> 00:11:36,750
أنا لا أكذب. صدّقيني

128
00:11:41,210 --> 00:11:42,580
إنّها الحقيقة فعلاً

129
00:11:42,580 --> 00:11:45,640
،حتّى لو قلتِها بطريقة ظريفة
!يبقى ذلك غير مُقنِع

130
00:11:45,640 --> 00:11:48,040
أنتِ مجرّد فارسة عاديّة
تتضوّر جوعاً، أليس كذلك؟

131
00:11:48,040 --> 00:11:49,980
!لـ-لستُ كذلك! أنتِ مُخطئة

132
00:11:50,300 --> 00:11:53,600
هكذا هي طبيعة الآنسة مثاليّة إذاً؟

133
00:11:53,900 --> 00:11:59,110
أجل. تفاجأتُ كذلك عندما رأيتُها
أوّل مرّة تأكل بشراهة

134
00:11:59,410 --> 00:12:03,490
كنتُ شرِهاً أيضاً، لكن أعتقد بأنّ ليهانا
قد تكون أكثر إبهاراً

135
00:12:03,490 --> 00:12:06,620
بئساً! هذه هي الأخيرة، مفهوم؟

136
00:12:08,110 --> 00:12:12,120
،بالعودة إلى المسألة الّتي بمتناول اليد
...في خضمّ تلك المعركة، ويل

137
00:12:12,620 --> 00:12:15,220
،لولا حكمك وشجاعتك

138
00:12:15,220 --> 00:12:17,500
لما نجا أحدٌ منّا على الأغلب

139
00:12:17,500 --> 00:12:20,020
!هـ-هذا غير صحيح

140
00:12:20,020 --> 00:12:22,410
كان كلّ ذلك بفضل تحالفنا وتكاتفنا

141
00:12:22,410 --> 00:12:24,540
هذا ما جعلنا نشقّ طريقنا بنجاح

142
00:12:24,540 --> 00:12:25,760
لم أفعل شيئاً مُميّزاً

143
00:12:25,760 --> 00:12:30,520
هذا صحيح! كدنا نموت في مرحلة ما
!بسبب هذا البليد

144
00:12:30,520 --> 00:12:32,890
!كان خائفاً جدّاً لدرجة الارتجاف

145
00:12:33,170 --> 00:12:37,000
ناهيكِ عن رسمه خطّة أتحمّل
!مُعظم خطورتها بنفسي

146
00:12:37,000 --> 00:12:38,060
—لم أرَ أوقح

147
00:12:38,060 --> 00:12:39,270
!يكفي

148
00:12:39,270 --> 00:12:41,780
!كُل هذه وتوقّف عن الكلام

149
00:12:42,490 --> 00:12:45,780
!تـ-توقّفي! لا تفعلي هذا الآن
!سأموت! سوف أموت

150
00:12:46,770 --> 00:12:48,530
...الأهمّ أيُّها البليد

151
00:12:49,360 --> 00:12:53,040
...تلك القوّة الّتي التهمَتْ سحري
ماذا كانت؟

152
00:12:54,350 --> 00:12:56,280
أجل، كان ذلك مُدهشاً

153
00:12:56,280 --> 00:12:59,800
كانت برّاقة جدّاً وقويّة لدرجة حبسَتْ أنفاسي

154
00:13:00,270 --> 00:13:03,300
امتصّت التّعويذة بطريقة ما

155
00:13:03,800 --> 00:13:06,520
لم يكن سحراً تعزيميّاً حتّى

156
00:13:06,990 --> 00:13:10,810
ليس من الواضح حتّى فيما إذا كان
ينبغي لنا أن نسمّيها سحراً أم لا

157
00:13:12,340 --> 00:13:14,160
!هـ-هذا صحيح

158
00:13:14,160 --> 00:13:16,560
!كان ينبغي أن تخبرنا بأنّك تمتلك قوّة كهذه

159
00:13:16,560 --> 00:13:19,940
!أنت السّبب في تعرّضنا لخطر جسيم

160
00:13:20,740 --> 00:13:23,480
!توقّف عن هذا أيُّها الكائن
!لا تخدشني

161
00:13:24,370 --> 00:13:26,200
أجبنا أيُّها البليد

162
00:13:30,180 --> 00:13:33,820
لستُ أفهم ماذا كان بحدِّ ذاتي

163
00:13:33,820 --> 00:13:35,960
توقّف تفكيري تماماً

164
00:13:36,730 --> 00:13:37,880
...ثمّ

165
00:13:42,700 --> 00:13:46,210
ربّما الأستاذ واركنر والآخرون
قد يعلمون شيئاً

166
00:13:46,210 --> 00:13:50,350
من الأفضل أن نسألهم ونكتشف
ماذا كانت تلك الظّاهرة

167
00:13:51,340 --> 00:13:53,470
يراودني إحساس بأنّها كانت شيئاً مُميّزاً

168
00:13:54,870 --> 00:13:56,170
مُميّز؟

169
00:13:57,860 --> 00:14:03,380
المعذرة، كان هناك فتى صغيراً
مع فريق البعثة ذاك

170
00:14:03,380 --> 00:14:04,860
هل تعرفون من يكون؟

171
00:14:05,280 --> 00:14:07,160
فتى صغير؟

172
00:14:07,800 --> 00:14:11,370
تقصد ذلك المُسانِد؟

173
00:14:11,370 --> 00:14:14,370
لا بدّ أنّه جزء من قبيلة فين

174
00:14:14,370 --> 00:14:16,370
قبيلة فين؟

175
00:14:17,150 --> 00:14:21,130
قرأتُ عنهم في الوثائق الّتي تمتلكها
عائلة أوينزوس

176
00:14:22,130 --> 00:14:26,440
رغم أنّ بني جنسهم لا يستطيع استخدام
،السّحر، إلّا أنّهم عبر أجيال عديدة

177
00:14:26,440 --> 00:14:29,440
اكتسبَ الصّغار معرفة واسعة عن الدّيماس

178
00:14:29,940 --> 00:14:33,150
أبرموا عقداً مع البرج منذ عصر ملِكة السّحرة

179
00:14:33,150 --> 00:14:36,720
يُعينوننا كمُرشدين، ويساعدوننا في تغطية
أرضيّة جديدة في ديماس المتاهة

180
00:14:36,720 --> 00:14:41,270
قيل بأنّ لولا مساعدتهم، لما استطعنا
الوصول إلى الطّوابق السّفليّة

181
00:14:44,030 --> 00:14:46,300
...مُرشِدو المتاهة

182
00:14:46,710 --> 00:14:48,390
قبيلة فين

183
00:14:50,290 --> 00:14:53,100
يراودني فضول بالطّبع حيال القوّة
الّتي قتلت الدّيوك العظيم

184
00:14:53,710 --> 00:14:57,360
لكن يراودني فضول أيضاً بشأن الشّعور
الّذي انتابني عندما التقيتُ بذلك الصّبيّ

185
00:14:59,960 --> 00:15:03,040
آرون ماستيرياس أولدكينغ
"السّاحر الأقوى؟ إنّه مجرّد مُخادع عجوز ماكر"
تبجّح من شخص ضئيل-

186
00:15:04,960 --> 00:15:08,050
فين
العِرق: ؟؟؟
العمر: ؟؟؟
(يُزعَم بأنّ عمره هو 7 سنوات للأبد)
الطّول: ؟؟؟
(حاول أن تقيسه وسوف يُسقطك أرضاً)
يوم الميلاد: الأوّل من سيرزامون
يُحبّ: ؟؟؟
يكره: ؟؟؟
وجود الحُبّ الأوّل: ؟؟؟
أعمق طابق في الدّيماس وصل إليه: 49
الهوايات: صيد سمك السّلمون
فرد من أفراد شعب الضّوء والّذين يعملون
كدليل في الدّيماس. لديه علاقة مُباشرة
،مع الأكاديميّة ومع سحرة العصيّ الرّفيعة الخمسة
الماجيا فيندر. سواء كان "فين" هو اسمه الحقيقيّ
أو لقباً توارثه عن أجداده
هو أمر مجهول تماماً. سُمِع عصا حاكم الضّوء السّحريّة يقول
"لا يوجد طفل بعمر 7 سنوات مثلك"

187
00:15:14,700 --> 00:15:16,380
مرحباً يا كالدرون

188
00:15:15,240 --> 00:15:18,560
فين

189
00:15:16,380 --> 00:15:18,560
عُدت

190
00:15:18,940 --> 00:15:21,140
لم أرك منذ وقت طويل يا فين

191
00:15:19,390 --> 00:15:24,400
مديرة أكاديميّة ريغاردين السّحريّة
كالدرون أنوف

192
00:15:21,550 --> 00:15:24,800
بعثة طويلة أخرى هذه المرّة، صحيح؟

193
00:15:24,800 --> 00:15:27,190
إلى أي طابق وصلتُم

194
00:15:27,980 --> 00:15:29,570
الطّابق 49

195
00:15:29,840 --> 00:15:33,210
آرون ذاك مُشرفٌ صارم

196
00:15:33,820 --> 00:15:35,080
...ولأدخل صلب الموضوع

197
00:15:35,770 --> 00:15:37,480
تفضّلي. أحضرتُ لكِ هدية

198
00:15:38,840 --> 00:15:43,080
،هل هذا السّلاح الوارد في التّقرير
قاتل السّحرة؟

199
00:15:43,390 --> 00:15:44,410
أجل

200
00:15:44,410 --> 00:15:48,380
واجهنا مجموعة بغيضة في الطّابق 40
وسرعان ما اشتبكنا

201
00:15:48,380 --> 00:15:52,090
قتلوا قرابة العشرين من السّحرة
الرّفيعين في البعثة

202
00:15:54,260 --> 00:15:57,850
...لم نستطع التحفُّظ، لذا تولّينا أمرهم، لكن

203
00:15:57,850 --> 00:16:03,310
أراهن بأنّ قاتل السّحرة هذا لم يُصنَع
بواسطة الدّيماس بصورة طبيعيّة

204
00:16:04,240 --> 00:16:07,740
غالباً يجرون تجاربَ هناك في الأسفل

205
00:16:08,900 --> 00:16:11,790
،بدؤوا بجمع مواد في أعماق الدّيماس

206
00:16:11,790 --> 00:16:16,490
ثمّ بدمج قطع مختلفة، صنعوا هذا
هذا السّلاح. هذا ما تقصده؟

207
00:16:19,870 --> 00:16:23,490
أمرني آرون بالعودة إلى الدّيماس للتحرّي

208
00:16:23,490 --> 00:16:25,660
سأدع تحليل هذا الشّيء لكِ

209
00:16:26,210 --> 00:16:28,560
آسفة لأنّني أثقل عليك

210
00:16:29,370 --> 00:16:34,010
لا أمانع. يبدو أنّ بعض الأشرار يتحرّكون
،وراء الكواليس

211
00:16:34,300 --> 00:16:36,270
لذا آمل أن تتوخّوا الحذر جميعاً أيضاً

212
00:16:37,020 --> 00:16:39,010
...حسناً، سأدخل صلبَ الموضوع

213
00:16:41,980 --> 00:16:47,080
كالدرون، لماذا لم تخبريني بشيء
عن ذلك الصبيّ؟

214
00:16:47,860 --> 00:16:49,360
جميعكم تهتمّون بالعصيّ السّحريّة

215
00:16:49,680 --> 00:16:52,660
يُفترَض أن تكون السّيوف موطِن اختصاصي

216
00:16:54,850 --> 00:16:58,080
ويل هو تلميذ في أكاديميّتي

217
00:16:58,080 --> 00:17:01,040
والأهمّ، يتوق لعصا سحريّة

218
00:17:01,510 --> 00:17:06,490
ينوي صعود البرج ليصبح ماجيا فيندر

219
00:17:20,880 --> 00:17:23,930
لم أسمع بسيف يطمح ليصبح عصا سحريّة

220
00:17:24,390 --> 00:17:27,260
بالفعل. هذا غير مسبوق

221
00:17:27,260 --> 00:17:32,440
لكن لعلّه الشّيء الّذي سيُشكّل
تأثيراً كبيراً لم نشهد مثيلاً له من قبل

222
00:17:33,230 --> 00:17:34,350
أيّتها السّاحرة

223
00:17:34,690 --> 00:17:37,700
ليس وكأنّني أكره مثل هذه الألعاب

224
00:17:38,630 --> 00:17:39,820
حسنٌ إذاً

225
00:17:40,580 --> 00:17:43,700
سوف أأتمنكم عليه جميعاً لبعض الوقت

226
00:17:43,980 --> 00:17:47,590
لكن سوف أتدخّل من الآن فصاعداً

227
00:17:48,030 --> 00:17:49,960
أجل، يمكنك فعل ذلك متى شئت

228
00:17:50,810 --> 00:17:53,840
كلّ هذا من أجل التفوُّق على السّماوات

229
00:18:02,580 --> 00:18:03,720
أشعر باليأس أحياناً

230
00:18:04,140 --> 00:18:06,730
جميعنا جرحى بدرجات مُتفاوتة

231
00:18:06,730 --> 00:18:08,980
فكيف أنت الوحيد المُستيقظ؟

232
00:18:10,740 --> 00:18:13,860
لسببٍ ما، لم أستطع تحمُّل
الوقوف مكتوف اليدين

233
00:18:15,250 --> 00:18:17,930
هناك أمور كثيرة لستُ أفهمها

234
00:18:17,930 --> 00:18:20,300
لكن يجب أن أستمرّ في المضيّ قُدماً

235
00:18:21,830 --> 00:18:23,870
فأساساً، هناك مكان أريد بلوغه

236
00:18:25,800 --> 00:18:29,750
بجدّية، ممّا يتكوّن جسده بالضّبط؟

237
00:18:30,080 --> 00:18:34,000
لا يمكن أن يكون ساحراً. إنّه غالباً
قزم من الدّاخل أو ما شابه

238
00:18:34,000 --> 00:18:38,810
آمل ألّا تشمل صديقاً للإيلف
مع همجيّين مثل الأقزام

239
00:18:38,810 --> 00:18:41,260
إنّه مُحاربٌ يستحقُّ الاحترام

240
00:18:42,180 --> 00:18:48,390
على العكس، لعلّ صراحته البسيطة
وصدقه هما نقاط قوّته

241
00:18:53,730 --> 00:18:55,190
!أيُّها البليد

242
00:18:55,190 --> 00:18:57,110
!قاتلني

243
00:18:57,110 --> 00:18:58,070
ماذا؟

244
00:19:02,170 --> 00:19:04,000
ماذا تفعل يا شيون؟

245
00:19:04,000 --> 00:19:06,450
!أنت في حالة يُرثى لها. لا يجوز أن تفعل ذلك

246
00:19:07,220 --> 00:19:10,600
،إذا كان يستطيع هو فعل هذا
فأنا أستطيع أيضاً

247
00:19:11,210 --> 00:19:14,660
شـ-شيون، لا تضغط على نفسك كثيراً

248
00:19:14,660 --> 00:19:17,210
...فضلاً عن ذلك، حتّى لو تحدّيتني فجأة

249
00:19:17,560 --> 00:19:18,460
تماماً

250
00:19:18,800 --> 00:19:19,470
ماذا؟

251
00:19:20,090 --> 00:19:22,060
،آنذاك في مهرجان السّحر العظيم

252
00:19:22,060 --> 00:19:25,470
قلتَ، "لنخُض معركة حقيقيّة
!في المرّة المُقبلة، أليس كذلك؟

253
00:19:27,880 --> 00:19:29,480
!عليك أن تفي بوعدك

254
00:19:29,730 --> 00:19:31,080
!انظر جيّداً

255
00:19:31,080 --> 00:19:34,980
شخص لا يستطيع هزيمتي لن يتمكّن
!من الوصول إلى البرج

256
00:19:36,710 --> 00:19:38,110
حسناً

257
00:19:38,370 --> 00:19:40,360
!لنفعل هذا يا شيون

258
00:19:40,360 --> 00:19:42,490
!سنستأنف ما بدأناه آنذاك

259
00:19:42,900 --> 00:19:45,240
!انتظرا! ويل! شيون

260
00:19:45,240 --> 00:19:46,410
!بئس الأمر

261
00:19:46,410 --> 00:19:47,800
!ها أنا ذا

262
00:19:50,910 --> 00:19:51,760
!حسناً

263
00:21:15,180 --> 00:21:18,330
فيما يخصُّ الحادثة في التّطبيق
...العمليّ قبل شهرين

264
00:21:18,690 --> 00:21:21,930
أنا متأكّد بأنّ بعضكم ما زال
...لم يستوعب صدمة ما حصل

265
00:21:21,930 --> 00:21:26,700
رغم ذلك، لا يمكننا أن نسمح ببقائكم خاملين

266
00:21:27,600 --> 00:21:31,100
عقب ذلك، فعلتُ كلّ ما باستطاعتي فعله

267
00:21:31,530 --> 00:21:36,350
سينتهي العام المدرسيّ من جديد

268
00:21:36,350 --> 00:21:39,530
،بالنّسبة لكم يا طلّاب السّنة السّادسة
هذه هي امتحاناتكم الأخيرة فعلاً

269
00:21:40,120 --> 00:21:41,730
سأتمكّن من رؤيتها قريباً

270
00:21:42,140 --> 00:21:45,790
سوف نبدأ الآن باليوم الأوّل
!من امتحانات تخرّجكم

271
00:21:46,540 --> 00:21:47,240
!ابدؤوا

272
00:21:48,990 --> 00:21:50,280
!سأرى إيلفي

273
00:23:31,050 --> 00:23:31,930
الحلقة 1
كسيف وحيد

274
00:23:31,930 --> 00:23:32,840
الحلقة 2
كما لو أنّه مِقدام

275
00:23:32,840 --> 00:23:33,760
الحلقة 3
طلب ومُراقِب

276
00:23:33,760 --> 00:23:34,680
الحلقة 4
عشيّة المهرجان العظيم

277
00:23:35,680 --> 00:23:36,600
الحلقة 6
ما بين الكبرياء والشّغف

278
00:23:36,600 --> 00:23:37,520
الحلقة 7
الأسحار الجليديّة السرّية الإثنا عشر، إيل غلاس فروس

279
00:23:37,520 --> 00:23:38,520
الحلقة 8
هل نتواعد؟

280
00:23:38,520 --> 00:23:39,520
الحلقة 9
التّطبيقات العمليّة تبدأ

281
00:23:39,520 --> 00:23:40,440
الحلقة 10
حلمنا

282
00:23:40,440 --> 00:23:41,440
الحلقة 11
الاسم الحقيقيّ للجُبناء

283
00:23:41,440 --> 00:23:42,230
الحلقة 12
عصا سحريّة وسيف