1
00:00:02,710 --> 00:00:05,820
أكاديميّة ريغاردين السّحريّة

2
00:00:06,530 --> 00:00:11,830
ما هو أكثر شيء قيِّم في أكاديميّة
ريغاردين السّحريّة المرموقة؟

3
00:00:15,530 --> 00:00:18,670
بالطّبع، إنّها موهبة السّحر

4
00:00:19,940 --> 00:00:22,330
إذاً ماذا عن أولئك الّذين لا يملكون موهبة فيه؟

5
00:00:22,680 --> 00:00:25,940
هل من وسيلة ليتقدّم عديمو الموهبة
في هذه الأكاديميّة؟

6
00:00:27,840 --> 00:00:30,340
الدّيماس، الطّابق 7

7
00:00:34,540 --> 00:00:36,550
...للإجابة عن هذا السّؤال

8
00:00:40,730 --> 00:00:44,310
!آتي إلى الدّيماس لقتل الوحوش

9
00:00:59,010 --> 00:00:59,950
...حتّى أنا

10
00:01:01,050 --> 00:01:02,960
!حتّى أنا أستطيع فعلها بالمحاولة

11
00:01:03,940 --> 00:01:05,990
!حتّى لو كنتُ لا أستطيع استخدام السّحر

12
00:01:06,960 --> 00:01:11,960
الحلقة 1
كسيف وحيد

13
00:01:13,670 --> 00:01:17,970
أوربوس ريغاردين
عاصمة السّحر

14
00:01:17,970 --> 00:01:20,970
أكاديميّة ريغاردين السّحريّة

15
00:01:21,490 --> 00:01:26,230
إنَّ نقل كمّية قليلة من السّحر
إلى خام بالكا أو غُبار أغني

16
00:01:26,230 --> 00:01:28,280
ينشئ كتلة من الكبريت

17
00:01:28,280 --> 00:01:31,480
بالتّالي، من الممكن تحفيز نار برّاقة

18
00:01:32,210 --> 00:01:33,550
صحيح

19
00:01:33,110 --> 00:01:37,490
أستاذ في أكاديميّة ريغاردين السّحريّة
إدوارد سيرفينس

20
00:01:33,550 --> 00:01:35,360
...حسناً، لنرَ

21
00:01:35,800 --> 00:01:37,490
أطلب منك التقدُّم

22
00:01:38,350 --> 00:01:39,190
ويل

23
00:01:39,490 --> 00:01:42,250
كائن مُرافق
كيكي

24
00:01:40,110 --> 00:01:41,580
ويل سيرفورت

25
00:01:42,590 --> 00:01:43,870
!ويل سيرفورت

26
00:01:45,500 --> 00:01:49,630
حـ-حاضر! ما الأمر يا أستاذ إدوارد؟

27
00:01:46,460 --> 00:01:49,630
تلميذ في أكاديميّة ريغاردين السّحريّة، سنة سادسة
ويل سيرفورت

28
00:01:49,880 --> 00:01:52,300
طلبتُ منك النّزول إلى مُقدِّمة الصفّ

29
00:01:53,300 --> 00:01:54,910
هذا من جديد؟

30
00:01:55,470 --> 00:01:56,760
عُلِم

31
00:02:03,570 --> 00:02:06,270
ما الأمر؟ إنّه تمرين عملي بسيط

32
00:02:06,740 --> 00:02:10,880
كما تعلم، عليك فقط استخدام
المُحفِّز لاستحضار النّار

33
00:02:13,530 --> 00:02:14,830
...أيّتها النّيران

34
00:02:16,300 --> 00:02:17,910
!تعالي

35
00:02:32,210 --> 00:02:33,670
...ويل

36
00:02:34,870 --> 00:02:36,170
اصمتوا

37
00:02:38,960 --> 00:02:43,930
لا أصدِّق بأنّ تلميذاً في مؤسّستنا عاجز
...عن استخدام حتّى أساسيّات السّحر

38
00:02:44,370 --> 00:02:46,380
كما هو مُتوقَّع من دارِس كتُب

39
00:02:46,380 --> 00:02:49,940
لا عجب عندما يقولون بأنّك تلميذ ممتاز
فقط عندما يتعلّق الأمر بتدوين مُلاحظات

40
00:02:50,620 --> 00:02:53,190
أنت ميئوس منك حقّاً

41
00:02:54,590 --> 00:02:55,820
...أيّتها النّيران

42
00:02:56,110 --> 00:02:57,360
أطيعيني

43
00:03:07,450 --> 00:03:10,120
،كُفّ عن الاستعراض دون إذن

44
00:03:10,120 --> 00:03:11,840
يا شيون ألستير

45
00:03:10,960 --> 00:03:17,170
تلميذ في أكاديميّة ريغاردين السّحريّة، سنة سادسة
شيون ألستير

46
00:03:12,260 --> 00:03:15,440
أنا آسف يا أستاذ إدوارد

47
00:03:15,440 --> 00:03:18,380
،يبدو أنّ ويل ليس في أحسن حالاته

48
00:03:18,720 --> 00:03:21,380
لذا ارتأيتُ أن أساعده

49
00:03:22,890 --> 00:03:24,640
حسناً، سيَفي هذا بالغرض

50
00:03:24,900 --> 00:03:27,260
...كما رأيتم جميعاً للتو

51
00:03:29,890 --> 00:03:32,900
في هذا العالم، سيادة السّحر هي المُطلَقة

52
00:03:33,430 --> 00:03:35,270
السّحر هو السّلطة

53
00:03:35,540 --> 00:03:37,400
السّحر هو القوّة

54
00:03:37,400 --> 00:03:39,400
!أبطالنا سحَرة

55
00:03:40,010 --> 00:03:44,090
وهنا في هذه الأكاديميّة، موهبتكم في السّحر
هي الّتي تجعلكم تكتسبون الاحترام

56
00:03:44,930 --> 00:03:49,000
،عديم الموهبة الّذي يمتلك معرفةً نظريّة
،لكن لا يستطيع استخدام ذرّة سحر

57
00:03:49,000 --> 00:03:52,100
غير مؤهّل بالتّواجد بين هذه الجدران
الّتي ترتقي بالحُكماء

58
00:03:52,970 --> 00:03:56,000
حمقى يحلمون بما هو خارج متناول أيديهم

59
00:03:56,000 --> 00:03:59,680
ينبغي أن ينسحبوا من هذه الأكاديميّة فوراً

60
00:04:09,830 --> 00:04:13,270
،تتباهى بفشلك اليوم ثانية
أليس كذلك أيّها البليد؟

61
00:04:13,270 --> 00:04:14,900
...شيون

62
00:04:13,270 --> 00:04:17,020
تلميذ في أكاديميّة ريغاردين السّحريّة، سنة سادسة
ليريل مارزي

63
00:04:13,270 --> 00:04:17,070
تلميذ في أكاديميّة ريغاردين السّحريّة، سنة سادسة
غوردون باريت

64
00:04:14,900 --> 00:04:17,530
سمعتُ بأنّك ذهبت إلى الدّيماس ثانية أيضاً

65
00:04:18,020 --> 00:04:20,280
...القضاء على الضُّعفاء لكسب بعض النقاط

66
00:04:20,690 --> 00:04:22,070
ألا تخجل من نفسك؟

67
00:04:23,780 --> 00:04:25,780
!يكفي يا فتيان

68
00:04:25,780 --> 00:04:27,450
حسناً يا كوليت

69
00:04:27,450 --> 00:04:33,160
أن تدافع تلميذة شرف حقيقيّة مثلكِ
—عن فاشل مثله، لستُ أفهم

70
00:04:33,160 --> 00:04:36,210
ويل ألطف منك بكثير ويعمل
!بجدّ أكثر من أيّ شخص

71
00:04:36,210 --> 00:04:38,670
تلميذ في أكاديميّة ريغاردين السّحريّة، سنة سادسة
كوليت لوير

72
00:04:36,480 --> 00:04:38,670
!لن أسمح لك بإهانة صديقي

73
00:04:40,580 --> 00:04:42,050
...كوليت

74
00:04:47,130 --> 00:04:51,310
إنَّ اللّطف والعمل الدّؤوب وحده
لن يصنعا ساحراً عظيماً

75
00:04:51,840 --> 00:04:53,190
...ناهيك عن ذلك

76
00:04:53,550 --> 00:04:56,920
أن تصبح ماجيا فيندر لهو حلم مستحيل

77
00:04:57,720 --> 00:05:02,700
حسناً إذاً، إنّ قضاء مزيد من الوقت مع عديم
الموهبة مضيعة للوقت

78
00:05:02,700 --> 00:05:07,690
كما قال الأستاذ إدوارد، ينبغي أن تسرع
وتغادر هذه المدرسة فوراً

79
00:05:12,690 --> 00:05:14,460
لا تدعهم يؤثِّرون بك

80
00:05:14,760 --> 00:05:17,080
ما فعله الأستاذ إدوارد خاطئ أيضاً

81
00:05:17,080 --> 00:05:19,630
!بجعلك أضحوكة هكذا

82
00:05:19,630 --> 00:05:21,160
لا مشكلة يا كوليت

83
00:05:21,460 --> 00:05:24,590
فأساساً، عدم قدرتي على استخدام
السّحر هو حقيقة

84
00:05:25,270 --> 00:05:26,550
...ويل

85
00:05:28,060 --> 00:05:32,290
بالإضافة إلى ذلك، إذا كانت فتاة ظريفة
،مثلكِ تقلق عليّ

86
00:05:32,290 --> 00:05:33,850
فأعتبر نفسي محظوظاً إذاً

87
00:05:37,200 --> 00:05:38,900
!مـ-ما هذا الكلام فجأة؟

88
00:05:38,900 --> 00:05:39,510
ماذا؟

89
00:05:38,900 --> 00:05:41,820
تقول هذا الكلام الآن ومن جديد
!بهذه التّعابير الوديعة

90
00:05:41,820 --> 00:05:43,410
ما هدفك؟

91
00:05:43,410 --> 00:05:45,900
لن توصلك المُغازلة إلى مكان، مفهوم؟

92
00:05:45,900 --> 00:05:49,870
لحظة، أنت لا تستخدم هذه العبارات
على أيّ شخص، أليس كذلك؟

93
00:05:49,870 --> 00:05:51,540
أ-أنا آسف

94
00:05:51,540 --> 00:05:54,870
منذ كنتُ صغيراً، عُلِّمتُ أن أمدح الفتيات

95
00:05:55,130 --> 00:05:58,090
،لكن حتّى من النّاحية الموضوعيّة
أنتِ ظريفة يا كوليت

96
00:05:57,540 --> 00:06:01,420
ظريفة ظريفة ظريفة ظريفة ظريفة ظريفة

97
00:05:58,090 --> 00:05:59,840
لذا كنتُ أقول الحقيقة فحسب

98
00:05:59,840 --> 00:06:00,810
—لم أقصد شيئاً

99
00:06:00,810 --> 00:06:02,180
!يكفي

100
00:06:02,340 --> 00:06:04,930
!ليس عليك قول مزيد من الكلام

101
00:06:04,930 --> 00:06:06,480
حـ-حسناً

102
00:06:09,570 --> 00:06:11,280
فقدتُ صوابي لبُرهة

103
00:06:11,280 --> 00:06:13,050
،أنا كوليت لوير

104
00:06:13,050 --> 00:06:15,340
ابنة عائلة نبيلة، ولو كان ذلك بالاسم فقط

105
00:06:15,340 --> 00:06:16,920
يجب أن أحافظ على هدوئي

106
00:06:19,370 --> 00:06:21,030
هل من مُشكلة يا ويل؟

107
00:06:23,000 --> 00:06:23,930
لا

108
00:06:25,000 --> 00:06:25,950
...كنتُ فقط

109
00:06:26,860 --> 00:06:28,920
أفكِّر بجمال هذا من جديد اليوم

110
00:06:31,680 --> 00:06:33,540
بالفعل

111
00:06:35,050 --> 00:06:37,130
يا له من ضوء دافئ

112
00:06:37,130 --> 00:06:43,220
،أقوى السّحرة على الإطلاق، ماجيا فيندر
يستمرّون في حمل السّماء

113
00:06:50,500 --> 00:06:54,670
منذ زمن بعيد، لم يكن النّاس
يعرفون شيئاً عن السّماء

114
00:06:55,150 --> 00:06:57,070
كانوا قابعين في الظّلام

115
00:06:57,880 --> 00:07:02,110
كان العالم خائفاً من الجُند السّماويّين

116
00:07:03,260 --> 00:07:07,040
حتّى انتفض خمسة سحَرة ضدّهم

117
00:07:12,340 --> 00:07:15,890
ردع هؤلاء السّحرة الغُزاة

118
00:07:15,890 --> 00:07:18,000
...استخدموا ختماً على السّماء

119
00:07:18,450 --> 00:07:20,680
ونشروا السّلام في عالمنا

120
00:07:26,150 --> 00:07:27,760
...ماجيا فيندر

121
00:07:28,430 --> 00:07:32,200
انتقل هذا اللّقب من جيل لآخر منذ ذلك
الحين ولا يُمنَح إلّا للأقوى

122
00:07:32,990 --> 00:07:37,280
.الجميع يحلمون به مرّة على الأقلّ
يحلمون بشرف أن يصبحوا سحَرة

123
00:07:39,770 --> 00:07:45,980
،أتعتقد بأنّ عصا عذراء الجليد السّحريّة
آلبيس فينا، تحرسنا اليوم أيضاً؟

124
00:07:46,280 --> 00:07:47,400
أجل

125
00:07:47,400 --> 00:07:48,160
ماذا؟

126
00:07:52,380 --> 00:07:54,160
...إنّها تجلس عند نافذة في الأعلى

127
00:07:56,420 --> 00:07:58,160
تنظر تجاهنا

128
00:08:00,470 --> 00:08:02,060
الشّمس والقمر؟

129
00:08:03,580 --> 00:08:04,680
!هذا صحيح

130
00:08:04,680 --> 00:08:08,920
يُقال بأنّ الشّمس والقمر يعومان
هناك في السّماء الحقيقيّة

131
00:08:08,920 --> 00:08:11,430
أحقّاً يا إيلفاريا؟

132
00:08:11,430 --> 00:08:15,930
،وبالإضافة إلى ذلك، في الجانب الآخر من السّماء
!هناك غروب شمس جميل

133
00:08:16,650 --> 00:08:19,410
يجعل كلّ شيء أحمر برّاقاً

134
00:08:19,410 --> 00:08:21,930
!سمعتُ بأنّه أجمل شيء في الوجود

135
00:08:23,330 --> 00:08:26,690
،إذا اقتربنا قدر المستطاع من السّماء
...في قمّة البرج

136
00:08:27,220 --> 00:08:31,720
إذا أصبحنا ماجيا فيندر، فربّما
يمكننا رؤية غروب الشّمس

137
00:08:33,720 --> 00:08:36,330
!إذاً لنذهب ونره معاً

138
00:08:40,280 --> 00:08:42,150
!أجل! هذا وعد

139
00:08:44,430 --> 00:08:48,250
لم يكن أكثر من مجرّد وعد طفولي بريء

140
00:08:49,560 --> 00:08:52,670
لكنّها كانت حقيقيّة

141
00:08:53,560 --> 00:08:57,860
بموهبتها، أصبحتْ أصغر شخص
،يكسب لقب ماجيا فيندر

142
00:08:57,860 --> 00:08:59,740
وغادرتْ إلى قمّة البرج

143
00:09:01,240 --> 00:09:02,520
...بالنّسبة لي

144
00:09:03,480 --> 00:09:05,980
كوني عديم الموهبة، فأنا أقلّ
حتّى من مُتوسّط

145
00:09:06,820 --> 00:09:09,820
لكن لأنّني أرفض التخلّي عن الوعد
،الّذي قطعناه في ذلك اليوم

146
00:09:10,360 --> 00:09:15,420
،ما زلتُ أسعى جاهداً، حتّى الآن
لتحقيق حلمي بالوقوف بجانبها

147
00:09:16,380 --> 00:09:17,870
...أنت

148
00:09:17,870 --> 00:09:19,120
!أحمق

149
00:09:21,370 --> 00:09:24,370
!أ-أستاذ واركنر، اهدأ من فضلك

150
00:09:24,370 --> 00:09:26,930
دخلت الدّيماس دون إذن من جديد، أليس كذلك؟

151
00:09:25,580 --> 00:09:31,260
أستاذ في أكاديميّة ريغاردين السّحريّة
واركنر نورغرام

152
00:09:26,930 --> 00:09:29,210
ووصلت إلى الطّابق السّابع بمفردك؟

153
00:09:29,210 --> 00:09:31,630
!سوف تُقتَل حقّاً يوماً ما

154
00:09:32,380 --> 00:09:36,140
!أ-أنا آسف يا أستاذ واركنر

155
00:09:38,920 --> 00:09:41,300
...لكن، المعذرة

156
00:09:41,300 --> 00:09:43,020
...بخصوص نقاطي

157
00:09:43,020 --> 00:09:45,180
!تحديق

158
00:09:48,670 --> 00:09:51,070
تأكيد قتل حارس شرّير واحد

159
00:09:51,620 --> 00:09:54,280
اكتسبت ذلك نقطتين

160
00:09:54,970 --> 00:09:56,030
!رائع

161
00:10:07,130 --> 00:10:10,170
إذاً لم تتخلّ بعد عن رغبتك
في أن تصبح ماجيا فيندر؟

162
00:10:11,950 --> 00:10:14,020
وهل هذا... خطأ؟

163
00:10:18,690 --> 00:10:24,910
اسمع، قبل أن تصعد البرج، عليك
أن تتأهّل للمؤسّسة العليا

164
00:10:24,910 --> 00:10:27,220
،وكي تفعل ذلك، تحتاج للكتابة

165
00:10:27,220 --> 00:10:27,810
،والتّعويذ

166
00:10:28,170 --> 00:10:29,210
والتّطبيق العمليّ

167
00:10:29,660 --> 00:10:32,430
تحتاج مقداراً هائلاً من النّقاط
من المناهج الثّلاثة

168
00:10:32,430 --> 00:10:36,970
،وبما أنّك لا تستطيع استخدام السّحر
فلن تتمكّن من اكتساب نقاط تعويذ أبداً

169
00:10:37,320 --> 00:10:38,300
!أعلم

170
00:10:38,300 --> 00:10:41,490
لهذا أركِّز على التّطبيق العمليّ
—بجمع النّقاط في الدّيـ

171
00:10:41,490 --> 00:10:44,080
،ويل، أخبرتُك بهذا كثيراً

172
00:10:44,540 --> 00:10:48,960
لكن التقدُّم من خلال التّطبيق العمليّ
وحده مستحيل فعليّاً

173
00:10:51,310 --> 00:10:54,090
لا سيّما بالنّسبة لشخص
لا يُجيد استخدام السّحر

174
00:10:55,990 --> 00:10:59,220
