1
00:00:01,450 --> 00:00:06,890
يُقام حفل للتّطبيقات العمليّة لكافّة التّلاميذ
ثانية في هذا العام يا كاريوت-ساما

2
00:00:06,890 --> 00:00:10,520
لا حاجة لإبلاغي عن كلّ تفصيل يا لوغويل

3
00:00:10,520 --> 00:00:14,360
رغم أنّ هذا قد يبدو مؤقّتاً، تمثيل
العصيّ السّحريّة لا يُلائمني إطلاقاً

4
00:00:14,640 --> 00:00:20,270
البرق مُنغمِسون في الملذّات، والإيلف
مُتغطرسون، والجليد بليدون

5
00:00:20,840 --> 00:00:26,560
لا يوجد أنسب منك، عصا إمبراطور
اللّهب، إنشينديا بارهام

6
00:00:29,050 --> 00:00:33,010
عصا إمبراطور اللّهب
كاريوت إنشينديا وايزمان

7
00:00:29,470 --> 00:00:33,010
ألم يعُد حاكم الضّوء الخاصّ بنا بعد؟

8
00:00:33,010 --> 00:00:35,510
ضابط مُرافِق في جماعة النّار
لوغويل

9
00:00:33,310 --> 00:00:35,510
ما زال في حملته مع الأسف

10
00:00:36,620 --> 00:00:42,080
بئسَ الأمر... كلّ هذا عندما يبدو أنَّ
الحاجز على وشك الانهيار

11
00:00:44,610 --> 00:00:48,400
!والآن تبدأ التّطبيقات العمليّة لكافّة التّلاميذ

12
00:00:57,610 --> 00:01:01,740
سأحقّق نتائجَ حقيقيّة هنا وأشقّ
!طريقي لرؤية إيلفي

13
00:01:01,740 --> 00:01:03,400
فيغنال، أعتمد عليك

14
00:01:03,400 --> 00:01:03,790
ماذا؟

15
00:01:05,160 --> 00:01:06,380
ميلفينت

16
00:01:19,410 --> 00:01:20,810
لنتابع طريقنا

17
00:01:21,180 --> 00:01:22,320
هل أنت بخير؟

18
00:01:22,320 --> 00:01:23,350
...مؤلم

19
00:01:26,950 --> 00:01:29,440
!هذه نملة قرمزيّة

20
00:01:31,010 --> 00:01:33,440
!ظهر سربٌ كاملٌ منهم فجأة

21
00:01:33,770 --> 00:01:38,490
.السّحرة ضعفاء من مسافات قريبة
بصفتي طليعهم، سأكون درعهم

22
00:01:38,490 --> 00:01:39,660
لا تُتعِب نفسك

23
00:01:39,660 --> 00:01:40,320
ماذا؟

24
00:01:40,840 --> 00:01:42,720
...ليهانا أوينزوس

25
00:01:43,370 --> 00:01:47,710
ألا تُدرِك سُمعة عائلتها؟

26
00:01:51,900 --> 00:01:53,210
،اِصهَل يا عفريت البرق

27
00:01:53,690 --> 00:01:55,590
ورافقني في مهمّتي

28
00:01:56,520 --> 00:01:57,840
...أوين سيكي

29
00:01:59,320 --> 00:02:00,840
!ليزولدي ديوا

30
00:02:02,010 --> 00:02:03,420
سحر تعزيميّ؟

31
00:02:04,020 --> 00:02:06,730
عائلة أوينزوس هي سُلالة من الفُرسان

32
00:02:07,220 --> 00:02:12,830
ليهانا نادرة بين السّحرة. إنّها مختصّة
في القتال من مسافات قريبة

33
00:02:17,010 --> 00:02:19,860
إنَّ المُنافسة على النّقاط ستكون
مُزعجة للغاية

34
00:02:20,700 --> 00:02:23,120
يجب أن نتقدّم بشكل أسرع
من أيّ فريق آخر

35
00:02:23,540 --> 00:02:24,660
لنواصل التحرّك

36
00:03:47,280 --> 00:03:51,370
الحلقة 9
التّطبيقات العمليّة تبدأ

37
00:03:56,900 --> 00:04:00,820
هل تعرف ما هو أكثر سحر حيويّ
في الدّيماس يا ويل؟

38
00:04:01,870 --> 00:04:05,640
سحر الهجوم؟ سحر الدّفاع؟ لا

39
00:04:06,770 --> 00:04:08,580
،الجواب هو البحث

40
00:04:08,580 --> 00:04:12,770
تعويذة عاديّة تُحدّد مكان الأعداء ونقاط الخلل

41
00:04:13,420 --> 00:04:16,570
إنّه شيء لا غنى عنه بالنّسبة للسّحرة
الّذين يعبرون الدّيماس

42
00:04:16,570 --> 00:04:18,500
إنّه أساس كلّ الأساسيّات

43
00:04:25,960 --> 00:04:27,660
!أنت تعترض طريقي أيّها البليد

44
00:04:28,030 --> 00:04:29,870
!لا أستطيع الشُّعور بالأعداء بسرعة كافية

45
00:04:29,870 --> 00:04:32,240
لا، يستخدم يوليوس والآخرون سحر البحث

46
00:04:32,240 --> 00:04:34,670
لتغطية منطقة أوسع ممّا تستطيع
حواسي أن تغطّيه

47
00:04:35,140 --> 00:04:40,420
على هذا المُعدّل، سيُطهِّرون كافّة
الوحوش قبل أن أعترض أيّاً منهم

48
00:04:41,070 --> 00:04:42,570
!قضيتُ على واحد أخيراً

49
00:04:42,570 --> 00:04:44,220
مِخلب زيفروس

50
00:04:49,060 --> 00:04:52,960
أ-أبادهم جميعاً دُفعة واحدة؟

51
00:04:53,830 --> 00:04:56,540
أنت عقبة أكثر ممّا توقّعتُ أن تكون

52
00:04:56,540 --> 00:04:59,270
لم تؤدِّ دورك كدرع حتّى

53
00:04:59,270 --> 00:05:04,070
ربّما هذا يعني بأنّني ينبغي أن أشكّك
بحكمكِ يا ليهانا

54
00:05:05,020 --> 00:05:07,950
لتحرّي الدقّة، لم يمتلك الوقت
للعمل كدرع ببساطة

55
00:05:08,500 --> 00:05:12,700
سيُظهِر قوّته الحقيقيّة ضدّ
الأعداء فوق الخمسة

56
00:05:12,700 --> 00:05:13,630
غالباً

57
00:05:13,500 --> 00:05:19,460
"غالباً"

58
00:05:14,460 --> 00:05:16,820
لذا لا بأس إذا كان عبئاً حاليّاً

59
00:05:16,820 --> 00:05:17,830
غالباً

60
00:05:18,170 --> 00:05:19,460
أنا متأكّدة بأنّه قويّ

61
00:05:19,840 --> 00:05:20,830
غالباً

62
00:05:21,660 --> 00:05:23,460
أخبرتُك، أليس كذلك؟

63
00:05:23,890 --> 00:05:27,270
الشّخص الّذي لا يستطيع حتّى استخدام
البحث سوف يُعيقنا

64
00:05:29,700 --> 00:05:33,070
يستخدم السّحرةُ عصيّهم السّحريّة
لامتصاص آثار السّحر

65
00:05:33,070 --> 00:05:35,230
الّتي تصدر عن الوحوش السّاقطة

66
00:05:35,700 --> 00:05:38,840
بهذا الشّكل، تعمل عصيّهم كمُسجِّل

67
00:05:38,840 --> 00:05:44,160
تستطيع الأكاديميّة تفقُّد عدد الأهداف
الّتي هزمها تلميذ

68
00:05:44,540 --> 00:05:45,660
!مهلاً لحظة

69
00:05:45,660 --> 00:05:48,080
!لم ننتهِ من جمع الغنائم

70
00:05:48,080 --> 00:05:52,610
لا جدوى من حمل غنائم
لا قيمة تُذكَر لها، صحيح؟

71
00:05:52,610 --> 00:05:55,120
آسف! أنا جاهز للانطلاق الآن

72
00:05:55,380 --> 00:05:59,000
لهذا السّبب، دون وجود وسيلة
،لديّ لامتصاص آثار السّحر

73
00:05:59,000 --> 00:06:02,400
،عليّ جرّ بقايا الوحوش من أجل كسب نقاطي

74
00:06:02,400 --> 00:06:04,630
الأمر الّذي يُحبِط باقي أعضاء فريقي

75
00:06:05,070 --> 00:06:08,790
بما أنّك انضممت معنا، فحاول
ألّا تفضحنا أيّها البليد

76
00:06:10,220 --> 00:06:11,870
ويل، هل أنت بخير؟

77
00:06:13,960 --> 00:06:16,640
عرفتُ بأنّ الأمر سيكون هكذا منذ البداية

78
00:06:17,510 --> 00:06:21,620
سوف أبذل قصارى جهدي لأكون
مُفيداً لهم في لحظة ما

79
00:06:22,360 --> 00:06:24,320
...هذا ما أقوله، لكن

80
00:06:28,760 --> 00:06:30,910
!لا شيء يمكنني فعله

81
00:06:31,460 --> 00:06:34,030
...توقّعتُ هذا! توقّعت، لكن رغم ذلك

82
00:06:34,410 --> 00:06:37,540
الجميع ماهرون جدّاً لدرجة أنّه لا تسنح
لي أي فُرصة للتدخُّل

83
00:06:37,540 --> 00:06:41,140
على هذا المُعدّل، لستُ أكثر
من مجرّد بغل يجرّ عربة

84
00:06:43,000 --> 00:06:46,430
مضى يوم بالفعل منذ بدء التّطبيقات
العمليّة لكافّة التّلاميذ

85
00:06:46,430 --> 00:06:48,300
أرغب في أخذ استراحة قصيرة قريباً

86
00:06:48,560 --> 00:06:50,530
في مكانٍ كهذا؟

87
00:06:50,530 --> 00:06:52,700
،أنا لا أطلب نُزُلاً نخب أوّل

88
00:06:52,700 --> 00:06:56,040
لكن أرغب في الشّعور بأمان بما يكفي
للشّعور بالاسترخاء

89
00:06:56,040 --> 00:06:59,260
إذاً نحتاج ربّما حصناً من اللّهب

90
00:06:59,820 --> 00:07:00,990
ناردريا

91
00:07:04,360 --> 00:07:07,690
مُبهر. هل هذا سحر وهم إيلفيّ؟

92
00:07:08,010 --> 00:07:09,990
أجل، هكذا يبدو

93
00:07:09,990 --> 00:07:12,570
،اللّهب بحدّ ذاته وهميّ

94
00:07:13,070 --> 00:07:17,200
لكن الوحوش تحتاط من رؤية
اللّهب الّذي يظهر فجأة

95
00:07:17,730 --> 00:07:19,080
لن يقتربوا

96
00:07:19,710 --> 00:07:21,180
سيرفورت

97
00:07:21,180 --> 00:07:24,080
من فضلك وزِّع الحصص الّتي
أعطيتُك إيّاها من قبل

98
00:07:24,080 --> 00:07:25,260
حسناً

99
00:07:27,510 --> 00:07:29,340
هذه لك يا يوليوس

100
00:07:29,640 --> 00:07:30,760
هذه لك يا شيون

101
00:07:32,030 --> 00:07:33,770
فيغنال، هذه لك

102
00:07:33,770 --> 00:07:36,740
لا تقترب أكثر. ضعه في الأرض

103
00:07:36,740 --> 00:07:37,650
ماذا؟

104
00:07:37,650 --> 00:07:40,600
الإيلف لا يسمحون لأحد بلمسهم
إلّا الّذين يعتبرونهم جديرين

105
00:07:41,170 --> 00:07:43,600
لا أريد أن ألمسك بالخطأ

106
00:07:43,600 --> 00:07:47,480
مهلاً! جميعنا في نفس الفريق، أليس كذلك؟
لماذا تقول كلاماً كهذا؟

107
00:07:47,480 --> 00:07:51,360
جميعكم سحرة، وأنا إيلف

108
00:07:51,360 --> 00:07:52,860
هكذا الأمر باختصار

109
00:07:52,860 --> 00:07:57,240
الشّخص الوحيد في هذا الفريق الّذي
أعتبره جديراً هو ليهانا

110
00:07:58,540 --> 00:08:00,580
كوليت، لا نريد أن نتشاجر

111
00:08:00,580 --> 00:08:01,630
...لكن

112
00:08:01,630 --> 00:08:04,880
لا مُشكلة. الثّقافة والعادات
الإيلفيّة تختلف عن عاداتنا

113
00:08:05,580 --> 00:08:07,180
أنا بخير

114
00:08:08,440 --> 00:08:09,320
...الإيلف

115
00:08:09,850 --> 00:08:13,140
مثل الأقزام، ينحدرون من عالم آخر

116
00:08:13,140 --> 00:08:17,890
إنّهم مُستخدِمو سحر، عرق مُوقَّر وموهوب

117
00:08:18,440 --> 00:08:21,560
يعطون أنفسهم قيمة أكبر من الآخرين
،وتصرّفاتهم لا تُطاق

118
00:08:22,030 --> 00:08:25,560
لكن مواهبهم تتفوّق على مُعظم السّحرة

119
00:08:26,390 --> 00:08:30,110
...تترأس إحدى جماعات ماجيا فيندر

120
00:08:30,510 --> 00:08:31,990
ملِكة الإيلف

121
00:08:37,590 --> 00:08:39,790
سأراجع الآن خُطواتنا التّالية

122
00:08:43,790 --> 00:08:47,410
هدفنا الأهمّ هو لومينوس نابيروس

123
00:08:47,410 --> 00:08:51,360
،قيمته 110 نقطة ويوجد واحد فقط

124
00:08:51,360 --> 00:08:53,780
لذا سوف نقتل المسؤول عن الطّابق 10

125
00:08:53,780 --> 00:08:57,600
مئة وعشرة؟ هذا أعلى عدد نقاط
!في هذه التّطبيقات العمليّة

126
00:08:57,600 --> 00:09:01,260
من المعروف والشّائع بأنّ أيّ شخص
يتحدّاه يدفع الثّمن

127
00:09:01,260 --> 00:09:04,430
إنّه، بلا شكّ، الزّعيم النّهائي
في التّطبيقات العمليّة لكافّة التّلاميذ

128
00:09:04,930 --> 00:09:09,690
يمكنكم القول بأنّني أسّستُ هذا الفريق
بهدف قتل نابيروس

129
00:09:10,080 --> 00:09:13,630
نحن نمتلك المهارة الكافية
لإسقاط وحش قيمته 110 نقاط

130
00:09:14,220 --> 00:09:15,850
سوف أثبِت ذلك للبرج

131
00:09:16,530 --> 00:09:20,260
.حسناً، قد أبحرتْ هذه السّفينة بالفعل
لا أنوي التخلّي عنها في منتصف الطّريق

132
00:09:20,840 --> 00:09:25,740
لكن هل سنتجاهل المُقبِّلات ونذهب
مباشرة نحو الطّبق الرّئيسيّ؟

133
00:09:26,140 --> 00:09:29,700
أريد تحدّيه ونحن بكامل قِوانا
ومؤوناتنا السّحريّة سليمة

134
00:09:29,700 --> 00:09:31,700
يمكننا القضاء على الوحوش الآخرين لاحقاً

135
00:09:32,440 --> 00:09:36,580
،إن لم يكن هناك أي اعتراض
فسنسلك الطّريق الأقصر إلى الطّابق 10

136
00:09:37,590 --> 00:09:40,650
كلّ ما تمكّنتُ من تحقيقه اليوم
هو مجرّد خمس نقاط تافهة

137
00:09:41,100 --> 00:09:42,510
هذا ليس جيّداً بما يكفي

138
00:09:43,160 --> 00:09:45,200
...قتل مسؤول عن طابق

139
00:09:45,660 --> 00:09:48,120
...أكذب إذا قلتُ بأنّني لم أكن خائفاً، لكن

140
00:09:48,840 --> 00:09:50,640
سأذهب يا إيلفي

141
00:09:55,330 --> 00:09:58,360
ماذا تفعل يا عديم الرّأس؟

142
00:09:58,730 --> 00:10:01,790
اذهب واقتل الّذين في الطّوابق العلويّة؟

143
00:10:05,300 --> 00:10:07,370
كنتُ قد سئمتُ من هذا

144
00:10:07,370 --> 00:10:08,330
ماذا؟

145
00:10:08,700 --> 00:10:11,780
لذا أذقتُهم عذاب الجحيم

146
00:10:23,580 --> 00:10:25,220
ما كلّ هذا؟

147
00:10:25,620 --> 00:10:29,460
هناك جثث وحوش مُنتشرة في كلّ مكان

148
00:10:30,740 --> 00:10:32,730
هل هذا من صنيع فريق آخر؟

149
00:10:31,650 --> 00:10:35,900
الدّيماس، الطّابق 10

150
00:10:32,980 --> 00:10:35,110
لا، هذا غير مُمكن

151
00:10:35,690 --> 00:10:39,110
،سلكنا الطّريق الأقصر إلى هنا
وحتّى أنّنا تجاوزنا مُعسكرات القاعدة

152
00:10:39,690 --> 00:10:43,530
مُحال أن يكون قد سبقنا أيّ تلميذ

153
00:10:44,870 --> 00:10:47,100
ماذا تفعل يا ويل؟

154
00:10:47,620 --> 00:10:50,130
لا يوجد دليلٌ على سحر هنا

155
00:10:50,130 --> 00:10:52,880
مُزِّقوا بالقوّة الخالصة وحدها

156
00:10:53,700 --> 00:10:56,970
الغرفة الّتي يظهر فيها نابيروس أمامنا

157
00:11:08,290 --> 00:11:11,210
الدّيماس هادئ جدّاً لدرجة
يبدو فيها مُزيّفاً

158
00:11:13,170 --> 00:11:14,020
...هل يُعقَل أنّ

159
00:11:19,780 --> 00:11:20,900
!ابحثوا جميعاً

160
00:11:22,660 --> 00:11:23,780
ما الّذي يجري؟

161
00:11:24,110 --> 00:11:25,910
آثاره السّحريّة ليست مُستنزفة تماماً

162
00:11:25,910 --> 00:11:27,540
قُتِلَ ببساطة فحسب

163
00:11:27,820 --> 00:11:29,660
قُتِل المسؤول عن الطّابق؟

164
00:11:29,960 --> 00:11:31,420
من استطاع فعل هذا؟

165
00:11:32,470 --> 00:11:34,170
،البحث هو تعويذة متعدّدة الأغراض

166
00:11:34,520 --> 00:11:36,430
لكنّها ليست قويّة

167
00:11:36,430 --> 00:11:39,010
من الصّعب كشف الفِخاخ الذّكيّة به

168
00:11:39,010 --> 00:11:42,950
