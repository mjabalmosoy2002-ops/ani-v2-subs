1
00:00:03,590 --> 00:00:08,940
...أنت هناك إذاً... يا زعيم

2
00:00:08,940 --> 00:00:12,410
...ذلك المكان... الذي كنت فيه إذاً

3
00:00:13,490 --> 00:00:16,170
وذلك الجسد... الذي تستخدمه

4
00:00:16,170 --> 00:00:21,100
في اللّحظةِ التي تعبتُ فيها وشعرتُ
،بأنّ روحي تُنتزَع منّي

5
00:00:22,010 --> 00:00:26,880
قلتَ أنّه عليك الذهاب لأنّ الأمور
...بدأت تتّخذ منحى سيّئاً

6
00:00:27,230 --> 00:00:28,760
...هذا صحيح

7
00:00:28,760 --> 00:00:31,930
...إن كنتَ هناك يا زعيم

8
00:00:32,990 --> 00:00:35,530
...فسوف ننتصر حتماً

9
00:00:38,810 --> 00:00:40,350
...لكن

10
00:00:40,910 --> 00:00:43,250
...أشعر بالوحدة الشّديدة

11
00:00:43,250 --> 00:00:46,290
...هلّا... اتّصلت بي من جديد

12
00:00:47,020 --> 00:00:49,820
كما كنتَ تفعل دوماً؟

13
00:00:50,500 --> 00:00:52,440
...زعيم

14
00:02:54,340 --> 00:02:58,900
ميستا! أسرع واطعن الستاند الخاص بك
!بهذا السّهم

15
00:02:58,790 --> 00:03:01,870
ما الذي يجري؟ يتوجّه ريكويم نحونا فجأة

16
00:03:02,410 --> 00:03:04,700
!جورنو! أوقف ريكويم

17
00:03:04,700 --> 00:03:05,950
!لا أستطيع! إنّه بعيد جدّاً

18
00:03:08,580 --> 00:03:10,080
—ما

19
00:03:10,080 --> 00:03:11,670
...مُسدّسي

20
00:03:11,670 --> 00:03:13,230
!ماذا تفعل يا ميستا؟

21
00:03:13,230 --> 00:03:14,630
!هذا لأنّك تلمس السّهم

22
00:03:14,630 --> 00:03:17,260
...مستحيل! لماذا هذا

23
00:03:17,260 --> 00:03:18,880
!أفلته يا سيّد بولناريف

24
00:03:18,880 --> 00:03:20,760
!أفلِت السّهم

25
00:03:26,190 --> 00:03:30,690
يسرّني أنّني أخذتُ مُسدّس بيريتا
الخاص بذلك الشرطيّ تحسُّباً

26
00:03:30,690 --> 00:03:32,610
لكن ما القصّة أيّتها الرّصاصات؟

27
00:03:32,610 --> 00:03:35,270
لماذا انكسر مُسدّسي الدوّار فجأة؟

28
00:03:35,270 --> 00:03:38,850
ر-ربّما اقترب الزعيم؟

29
00:03:39,780 --> 00:03:43,230
!أحمق! فكّر قبل أن تتكلّم يا رقم 5

30
00:03:43,230 --> 00:03:48,650
هل تعني أنّك رأيت شخصاً يدنو منّا
في هذه المساحة الواسعة المفتوحة؟

31
00:03:48,650 --> 00:03:51,500
لم نرَ أحداً في اللّحظة التي انكسر
فيها المُسدّس الدوّار

32
00:03:51,500 --> 00:03:53,030
إنّه كلال المعادن

33
00:03:53,030 --> 00:03:55,840
هذا لأنّه يستخدم المُسدّسَ بإفراط

34
00:03:55,840 --> 00:03:57,910
مِحور الأسطوانة قد انكسر

35
00:03:57,910 --> 00:04:01,470
!لم تسنح لنا أي فرصة لإجراء صيانة أو فحص

36
00:04:01,470 --> 00:04:02,930
!مـ-مهلاً

37
00:04:12,140 --> 00:04:16,670
ما مشكلة هذا الشيء بالضبط؟ إنّه
!يتوجّه نحوي

38
00:04:16,670 --> 00:04:19,680
لا يا ميستا. إنّه يتوجّه نحوي

39
00:04:19,680 --> 00:04:22,360
...رغم أنّه استعاد السّهم

40
00:04:22,360 --> 00:04:23,910
!غولدن إكسبيريانس

41
00:04:29,510 --> 00:04:34,500
ينوي ريكويم أن يقضي عليّ لأنّني
لمستُ السّهم

42
00:04:34,500 --> 00:04:35,380
!ميستا، اهرب

43
00:04:36,830 --> 00:04:39,550
!لقّموا يا رصاصات! لقّموا المُسدّس

44
00:04:39,550 --> 00:04:42,940
هذا ليس مُسدّساً دوّاراً! نحتاج
!لخرطوشة أخرى

45
00:04:42,940 --> 00:04:45,050
!سيستغرق وقتاً حتّى يُلقَّم

46
00:04:47,390 --> 00:04:49,190
...لـ-لا جدوى

47
00:04:49,190 --> 00:04:50,180
...قُضي عليّ

48
00:04:56,930 --> 00:04:59,230
!سأرميها! أمسكها يا جورنو

49
00:04:59,600 --> 00:05:02,190
!سأرمي السّلحفاة نحوك

50
00:05:07,580 --> 00:05:08,830
!سيّد بولناريف

51
00:05:23,040 --> 00:05:24,760
هل أنت بخير يا سيّد بولناريف؟

52
00:05:24,760 --> 00:05:28,100
إنّه بخير. لـ-لكن... كيف؟

53
00:05:28,670 --> 00:05:33,150
ميستا، هل تتذكّر ما قلتُه في المُدرّج؟

54
00:05:34,190 --> 00:05:38,860
ما زال هناك المزيد من قدراتِ ريكويم
التي لا أعرف عنها شيئاً

55
00:05:39,350 --> 00:05:41,250
لكن بدأتُ أفهم

56
00:05:41,250 --> 00:05:44,760
توقّف ريكويم لأنّ وقت البداية قد حان

57
00:05:44,760 --> 00:05:46,950
وقت البداية؟

58
00:05:46,950 --> 00:05:48,110
أجل

59
00:05:48,110 --> 00:05:50,160
هذا لأنّ

60
00:05:50,160 --> 00:05:52,050
!جسدي قد بدأ يتغيّر

61
00:05:52,050 --> 00:05:54,660
!لهذا توقّف عن محاولةِ قتلي

62
00:05:56,260 --> 00:05:59,870
هذا هو دافع ريكويم الحقيقيّ الآن
بعد أن هاج وخرج عن السّيطرة

63
00:05:59,870 --> 00:06:07,510
،القدرة على جعلِ الكائنات تتبادل أرواحها
تعني القدرة التي تجعلهم يبدؤون بالتحوّل إلى شيء آخر

64
00:06:08,040 --> 00:06:10,970
الموسيقى الافتتاحيّة قد انتهت، والمقطوعة
،الحقيقيّة قد بدأت تُعزَف

65
00:06:11,290 --> 00:06:14,390
لهذا توقّف عن قتلي

66
00:06:14,390 --> 00:06:19,590
مخلوقات هذا العالم الذي دام عمره 4.5 مليار
سنة قد بدأت تتغيّر

67
00:06:19,590 --> 00:06:22,730
إلى شيء آخر في غضون ساعات

68
00:06:22,730 --> 00:06:23,860
!المخلوقات جمعاء

69
00:06:23,860 --> 00:06:25,500
...هكذا إذاً

70
00:06:25,500 --> 00:06:29,070
هذا ما يجعل ريكويم مرعباً حقّاً إذاً

71
00:06:29,070 --> 00:06:30,320
...لكن

72
00:06:31,230 --> 00:06:34,220
بفضلهم، تمكّنتُ من فهمها

73
00:06:34,220 --> 00:06:36,790
بدأتُ أفهم الإجابة

74
00:06:37,350 --> 00:06:41,210
اقتربتُ من معرفة كيفيّة الحصول على
!ذلك السّهم من ريكويم

75
00:06:41,210 --> 00:06:43,170
!بدأتُ أعرف الطريقة

76
00:06:43,520 --> 00:06:46,840
ما-ما الذي يجري بالضبط؟

77
00:06:46,840 --> 00:06:48,930
ما سرّ هذه القدرة؟

78
00:06:48,930 --> 00:06:51,880
إلى أي حدٍّ ينتشر هذا الشيء اللّعين؟

79
00:06:51,880 --> 00:06:55,350
...لا يبدو أنّهم يحتضرون للموت أو يتألّمون

80
00:06:55,350 --> 00:06:58,170
الجميع ينظرون بعيونٍ تبدو فارغة فحسب

81
00:06:58,170 --> 00:07:02,990
لكن هنالك هذا الخوف من التحوُّل
إلى شيء مختلف

82
00:07:02,990 --> 00:07:08,920
الخوف من زوال جسدي وروحي بشكل
بطيء لكن مُؤكَّد

83
00:07:10,020 --> 00:07:10,610
!تريش

84
00:07:10,610 --> 00:07:13,160
...أ-أنا بخير. لكن

85
00:07:13,510 --> 00:07:16,200
وقت البداية وشيك

86
00:07:16,200 --> 00:07:20,370
سيحدث ذلك بشكلٍ مختلف لكلِّ منّا، لكن
سيبدأ قريباً، بالنسبة لنا جميعاً

87
00:07:20,370 --> 00:07:24,340
الوقتُ يُداهمنا... أهذا ما تعنيه؟

88
00:07:24,340 --> 00:07:27,530
!بولناريف! يحدث هذا لأنّك أحضرت السّهم

89
00:07:27,530 --> 00:07:30,110
،قلتَ أنّه يمتلك القوّةَ لهزيمةِ الزعيم

90
00:07:30,110 --> 00:07:31,850
!لكن بدلاً من ذلك، قضيتَ علينا

91
00:07:31,850 --> 00:07:35,320
توقّف! يفوق هذا توقُّعات أي شخص

92
00:07:35,320 --> 00:07:38,430
الأهمّ الآن هو أن نجد طريقةً لهزيمةِ ريكويم

93
00:07:43,690 --> 00:07:46,230
هذا صحيح. جيّد. اقتربوا

94
00:07:46,230 --> 00:07:47,990
!اقتربوا أكثر من ريكويم

95
00:07:48,460 --> 00:07:54,220
إذا اقتربنا أكثر فسأتمكّن من رؤية أسرار
ريكويم بشكلٍ كامل، لأنّني هنا

96
00:07:54,220 --> 00:07:58,950
ستصبح قوّة السّهم ملكي وسيركع
!العالم تحت قدميّ

97
00:07:58,950 --> 00:08:00,120
!خلفه

98
00:08:00,120 --> 00:08:00,930
!جيّد

99
00:08:00,930 --> 00:08:02,750
!لا تتحرّك يا ميستا

100
00:08:03,440 --> 00:08:05,370
تريش، بوتشاراتي! ابقيا حيث أنتما

101
00:08:05,370 --> 00:08:06,340
!لا تتحرّكا

102
00:08:06,340 --> 00:08:07,240
—ما

103
00:08:07,780 --> 00:08:09,720
!قلتُ لك لا تتحرّك فحسب يا ميستا

104
00:08:09,720 --> 00:08:12,130
!يمكننا اللّحاق بريكويم خلال لحظات

105
00:08:12,130 --> 00:08:14,430
!ما قصّتك؟ اصمت أيُّها الأحمق

106
00:08:14,430 --> 00:08:16,930
!جسدي يتلاشى من الآن

107
00:08:17,270 --> 00:08:19,730
التقطتُ مُسدّسك الدوّار

108
00:08:19,730 --> 00:08:22,730
المُسدّس الذي قلت أنّه انكسر قبل قليل

109
00:08:23,190 --> 00:08:27,300
هذا الجزء المكسور لا يتطابق جيّداً
مع ما تبقّى منه

110
00:08:27,300 --> 00:08:30,950
،لو كان قد انكسر فقط بسببِ كلال المعادن
فينبغي أن يتّسع في مكانه فحسب

111
00:08:30,950 --> 00:08:33,910
جورنو، ما الذي تلمّح له؟

112
00:08:34,270 --> 00:08:36,130
!بوتشاراتي، أريدك أن تلزم مكانك أيضاً

113
00:08:36,130 --> 00:08:38,160
!علينا أن نبقى بعيدين عن بعضِنا الآخر

114
00:08:38,160 --> 00:08:40,790
!أيّها الأحمق! ريكويم يبتعد

115
00:08:40,790 --> 00:08:45,690
،قالت الرّصاصات أنّه كان كلال المعادن
!يعني أنّه كلال المعادن

116
00:08:45,690 --> 00:08:47,890
!لديّ مُسدّس بيريتا جديد أيضاً

117
00:08:47,890 --> 00:08:52,160
الخرطوش الدوّار لا يتّسع في مكانه
!لأنّ هناك قطعة قد طارت

118
00:08:52,160 --> 00:08:53,680
...هذا مُمكن

119
00:08:54,210 --> 00:08:56,830
لكن قد يكون هناك سبب آخر

120
00:08:56,830 --> 00:09:00,330
سنتمكّن من معرفةِ ذلك قريباً حالما نرى
هذه القطعة المفقودة

121
00:09:01,020 --> 00:09:03,440
غولدن إكسبيريانس

122
00:09:03,440 --> 00:09:06,170
منحتُ جزءاً من المُسدّسِ حياةً وتركته طليقاً

123
00:09:06,170 --> 00:09:10,900
الخلد أعمى جوهريّاً، لكن حاسّة الشمّ
لديه لا نظير لها

124
00:09:11,670 --> 00:09:15,780
يبدو أنّه عاد وعثر على قطعتِه المفقودة

125
00:09:21,200 --> 00:09:23,630
!انتظر لحظة

126
00:09:23,630 --> 00:09:27,540
هل تعني أنّ شخصاً استخدم قوّة ضغط
هائلة ما لتدمير المُسدّس؟

127
00:09:27,540 --> 00:09:31,640
اسمع! أنا والرّصاصات يقظون جدّاً لهذا الأمر

128
00:09:31,640 --> 00:09:34,270
...لم يقترب أحدٌ منّي في هذه السّاحة

129
00:09:34,270 --> 00:09:36,830
كلامك صحيح. لم يقترب أحد

130
00:09:36,830 --> 00:09:38,650
،لهذا علينا أن نبقى بعيدين عن بعضِنا الآخر

131
00:09:38,650 --> 00:09:40,950
!لأنّ نطاقه هو بضعة أمتار فقط

132
00:09:42,200 --> 00:09:44,150
...جورنو، أنت

133
00:09:44,150 --> 00:09:48,390
لم يقترب أحدٌ من نارانتشا عندما هوجِم أيضاً

134
00:09:48,390 --> 00:09:51,110
لا أحد... غيرنا

135
00:09:52,290 --> 00:09:58,740
سيّد بولناريف، إذا كان تخمينك صحيحاً
،وكان للزعيمِ شخصيّتان

136
00:09:58,740 --> 00:10:01,580
فينبغي أن يتمكّن من الدّخول والخروج
من عقلِ شخص آخر بحرّية

137
00:10:02,330 --> 00:10:05,540
ديافولو قد سكنَ في واحدٍ منّا

138
00:10:05,540 --> 00:10:06,310
—ما

139
00:10:07,940 --> 00:10:12,180
إذا بقي مخفيّاً، لن تتمكّن تريش من الشّعور به

140
00:10:12,180 --> 00:10:16,790
سبب بقائه مخفيّاً الآن هو لأنّه ينتظرنا حتّى
نحصل على السّهم بشكل نهائي

141
00:10:16,790 --> 00:10:20,220
لهذا ظهر لبُرهةٍ أيضاً لتدمير المُسدَّس

142
00:10:23,330 --> 00:10:24,920
!ا-انتظر لحظة

143
00:10:24,920 --> 00:10:27,930
أعلم أنّني أقول هذا مراراً، لكن ابقَ
!بعيداً عنّي يا ميستا

144
00:10:27,930 --> 00:10:29,610
!ابتعد عن نِطاقه

145
00:10:29,610 --> 00:10:32,190
!دُمِّر مُسدّسي

146
00:10:32,890 --> 00:10:36,360
أنت الأقرب من المُسدّس

147
00:10:36,360 --> 00:10:37,570
...لـ-ليس

148
00:10:37,890 --> 00:10:39,430
!ليس أنا

149
00:10:39,430 --> 00:10:42,920
...تذكّرت. عندما هوجِم نارانتشا

150
00:10:42,920 --> 00:10:45,540
...كان الأقرب منه هو

151
00:10:50,290 --> 00:10:53,250
تبّاً. يجب أن أفعل شيئاً

152
00:10:53,840 --> 00:10:56,760
ريكويم يبتعد أكثر فأكثر

153
00:10:56,760 --> 00:11:00,710
...هذا المبتدئ، جورنو جوفانا

154
00:11:00,710 --> 00:11:03,830
إنّه يختبئ في واحد منّا

155
00:11:04,430 --> 00:11:08,020
لكن بالرّغم من ذلك، لدينا أفضليّة واحدة

156
00:11:08,640 --> 00:11:11,610
،يستطيع ديافولو أن يُظهِر كينج كريمزن

157
00:11:11,610 --> 00:11:14,900
لكنّه لا يمتلك السّيطرة الكاملة على الجسد
الذي يسكنه الآن

158
00:11:16,340 --> 00:11:23,290
لو كان يمتلك السّيطرة الكاملة على الجسمِ
الذي يسكنه حاليّاً، لما ظلّ مختبئاً بهدوء

159
00:11:23,290 --> 00:11:28,160
كوننا ما زلنا أحياء ولم يُقضَ علينا يعني
أنّه لا يستطيع الظهور والتحرُّك بحرّية

160
00:11:28,880 --> 00:11:31,880
إذا ما نظرنا للأمر من منظور مختلف، لقد حاصرناه

161
00:11:33,210 --> 00:11:34,850
!إنّه السُّلحفاة

162
00:11:34,850 --> 00:11:37,710
!كانت الأقرب من مُسدّسي الدوّار

163
00:11:37,710 --> 00:11:39,830
!بولناريف هو الشّخص المُستحوَذ

164
00:11:39,830 --> 00:11:41,050
هذا غير مُمكن

165
00:11:41,050 --> 00:11:44,830
كاد السيّد بولناريف يُقتَل بواسطة ريكويم
،قبل قليل

166
00:11:44,830 --> 00:11:47,210
لأنّ الزعيم دمّر المُسدّس الدوّار

167
00:11:47,850 --> 00:11:51,520
لن يدع الزعيم الجسدَ الذي يسكنُه
يتعرّض لخطر

168
00:11:51,850 --> 00:11:53,020
...بالإضافةِ إلى ذلك

169
00:11:54,490 --> 00:11:57,140
لا أشعر إلّا بطاقةِ حياة كائن واحد

170
00:11:57,140 --> 00:11:59,780
في داخل هذه السُّلحفاة روح واحدة فقط

171
00:11:59,780 --> 00:12:02,730
أيمكنك تمييز ذلك يا جورنو؟

172
00:12:02,730 --> 00:12:07,750
فقط في حال اقتربتُ ولمستُ الجسد

173
00:12:07,750 --> 00:12:09,610
وكيف لك أن تكون متيقّناً؟

174
00:12:09,610 --> 00:12:11,870
طاقة الحياة هي كتلة

175
00:12:11,870 --> 00:12:14,960
إذا لمستُ شخصاً، يمكنني تحديد
عدد الكتل الموجودة

176
00:12:15,660 --> 00:12:17,440
لا توجد وسيلة أخرى

177
00:12:17,440 --> 00:12:20,200
يجب عليّ لمس كلّ واحد منكم وأكتشف

178
00:12:20,200 --> 00:12:24,640
لكن كيف ستقترب ضمن نطاق كينج كريمزن؟

179
00:12:28,220 --> 00:12:32,830
تعلّمتُ كيفيّة كشف كينج كريمزن
من السيّد بولناريف

180
00:12:32,830 --> 00:12:37,440
اللّحظة التي تزداد فيها القطرات الصّغيرة فجأة
تشير إلى أنّه قد تمّ القفز فوق الزمن

181
00:12:38,360 --> 00:12:39,840
صحيح

182
00:12:39,840 --> 00:12:43,130
لكن قدرتك على تفادي هجمته من عدمِها
،ستكون مسألة حظّ

183
00:12:43,690 --> 00:12:47,620
إذ ستكون المدّة بالكاد كافية لتفاديها

184
00:12:53,330 --> 00:12:55,490
ليس أنا بالتأكيد

185
00:12:55,490 --> 00:12:59,540
عندما قُتِل نارانتشا، كنتُ الأبعد

186
00:13:00,090 --> 00:13:03,520
إذاً سأفحصك أوّلاً وذلك كي نكون
مرتاحي البال

187
00:13:03,520 --> 00:13:04,220
!أنت

188
00:13:04,550 --> 00:13:07,680
!توقّف مكانك! ابتعد عنّي

189
00:13:08,120 --> 00:13:10,640
!لـ-لا تقترب أكثر

190
00:13:12,980 --> 00:13:16,890
إذا كان ديافولو في داخلك، فماذا سيحلُّ بي؟

191
00:13:17,870 --> 00:13:21,490
عندما مات نارانتشا، كان جسده فارغاً

192
00:13:22,460 --> 00:13:27,570
تمكّنت روحي من الانتقال من جسدِ نارنتشا
إلى جسدي، لكن كان فارغاً

193
00:13:29,590 --> 00:13:32,060
لا يمكن أن يكون في داخلي

194
00:13:33,890 --> 00:13:35,120
حقّاً؟

195
00:13:35,120 --> 00:13:37,640
هذا ما تقوله أنت فقط

196
00:13:37,640 --> 00:13:40,710
ليس لديّ طريقة للتأكُّد من قدرتك

197
00:13:41,390 --> 00:13:42,830
وأيضاً يا جورنو

198
00:13:42,830 --> 00:13:46,430
هل لديك طريقة تؤكِّد فيها بشكلٍ يقيني
أنّ لديك روح واحدة فقط؟

199
00:13:46,430 --> 00:13:50,330
لا يمكنك فحص نفسك بقدرتِك، أليس كذلك؟

200
00:13:50,330 --> 00:13:53,770
ميستا، لا يمكننا اللّحاق بالسّهم ما لم
!نتمكّن من معرفةِ ذلك

201
00:13:53,770 --> 00:13:55,980
!اقترب أكثر وسأفجّر أطرافك

202
00:14:01,360 --> 00:14:02,510
!توقّفا

203
00:14:05,510 --> 00:14:07,780
افحصني أولاً يا جورنو

204
00:14:10,150 --> 00:14:11,450
!افعلها بسرعة

205
00:14:11,450 --> 00:14:14,160
نحن نخسر المزيد والمزيد من الوقت

206
00:14:14,160 --> 00:14:19,420
كما قلتَ تماماً، إذا ما نظرنا للأمر
من زاوية أخرى، لقد حاصرنا الزعيم

207
00:14:19,420 --> 00:14:21,270
لا توجد وسيلةٌ أخرى

208
00:14:21,270 --> 00:14:22,380
...نعم

209
00:14:22,380 --> 00:14:24,510
علينا أن نفعل هذا في الحال

210
00:14:34,000 --> 00:14:36,220
...سوف يُهاجَم شخص ما

211
00:14:36,220 --> 00:14:38,580
...إذا اقتربنا من بعضِنا الآخر

212
00:14:55,650 --> 00:14:56,770
!جورنو

213
00:14:56,770 --> 00:14:57,790
!إنّه ميستا

214
00:14:57,790 --> 00:14:59,630
!كان هو المسكون

215
00:14:59,630 --> 00:15:00,630
—سبايس غيرل

216
00:15:00,630 --> 00:15:01,670
!لا يا تريش

217
00:15:01,670 --> 00:15:02,630
!إنّه أنت

218
00:15:03,810 --> 00:15:08,010
اقتربَ فوراً بواسطة تحريك جسدكِ نحوه

219
00:15:09,050 --> 00:15:13,370
...لقد كنتُ أنتظر هذه اللّحظة يا ابنتي

220
00:15:13,370 --> 00:15:16,610
!اللّحظة التي أطلقتِ فيها عنان الستاند الخاص بكِ

221
00:15:24,700 --> 00:15:26,280
...ابنتي

222
00:15:26,280 --> 00:15:33,080
لو لم تكشفي عن الستاند الخاص بكِ
...لكنتُ قد حوصِرتُ فعلاً

223
00:15:33,080 --> 00:15:34,990
!ستيكي فيينقرز

224
00:15:38,830 --> 00:15:42,290
إذا استطعتُ الإمساك بالستاند، أستطيع
تحريك الجسد أيضاً

225
00:15:42,770 --> 00:15:46,630
والآن أستطيع أن أدع هذا الجسد يركض
على الأقلّ

226
00:15:46,630 --> 00:15:49,400
!سوف نُهاجَم! حضّروا أنفسكم

227
00:15:49,400 --> 00:15:50,670
—سيستخدم القفز فوق الزمن

228
00:15:52,900 --> 00:15:53,530
—ما

229
00:15:53,530 --> 00:15:54,970
...هـ-هل يُعقَل

230
00:15:56,060 --> 00:15:59,430
لماذا يهرب من دون مُهاجمتنا؟

231
00:15:59,430 --> 00:16:05,110
من خلال الرّصد والمُراقبة، اكتشفَ طريقة
!لانتزاعِ السّهم من ريكويم

232
00:16:05,430 --> 00:16:08,440
!الوقت يُداهمنا! هناك أولويّات

233
00:16:08,440 --> 00:16:09,770
!أطلق يا ميستا

234
00:16:09,770 --> 00:16:11,780
!لا تدعه يصل إلى هناك قبلنا مهما كلّفَ الأمر

235
00:16:14,450 --> 00:16:16,250
!كفّ عن إضاعةِ الوقت

236
00:16:16,250 --> 00:16:19,000
لا وقت للتردُّد بسبب أنّ الهدف هو جسدك

237
00:16:19,000 --> 00:16:20,620
...الأمر ليس كذلك

238
00:16:20,620 --> 00:16:22,830
لقد أطلقتُ بالفعل يا بوتشاراتي

239
00:16:24,240 --> 00:16:27,420
يبدو أنّني... أطلقتُ ستّ طلقات سلفاً

240
00:16:37,560 --> 00:16:40,180
!إنّه يركض ويستخدم القفز فوق الزمن

241
00:16:40,520 --> 00:16:43,520
!تنبّأ بمسارِ الرّصاصات

242
00:16:43,840 --> 00:16:47,440
!لنلحق به! إذا حصل على السّهم، قُضي علينا

243
00:16:54,040 --> 00:16:55,700
...ذلك الظلّ

244
00:16:55,700 --> 00:16:58,740
...سبب عدم قدرة أحد على لمسِ السّهم

245
00:16:58,740 --> 00:17:02,040
...إن لم يخب ظنّي

246
00:17:10,690 --> 00:17:12,090
...معنى هذا

247
00:17:12,490 --> 00:17:17,220
بالنسبة إلى ذلك الرّجل، ينبغي أن يبدو وكأنّ
الظلّ يمتدُّ تجاهي

248
00:17:17,220 --> 00:17:22,070
في نظرِ بوتشاراتي، الظلُّ يمتدُّ أمام ريكويم

249
00:17:22,070 --> 00:17:22,890
...بالتالي

250
00:17:22,890 --> 00:17:27,510
يختلِف مكان هذا الظلّ بين ناظر وآخر

251
00:17:27,510 --> 00:17:29,650
!هذا هو لغزُ ريكويم

252
00:17:29,650 --> 00:17:34,150
!لهذا يستطيع التحكُّم بأرواح الجميع

253
00:17:34,150 --> 00:17:36,650
هذا الشيء هو ظلُّ روح شخص

254
00:17:36,650 --> 00:17:40,450
ريكويم بحدِّ ذاته هو ظلُّ روحي

255
00:17:40,450 --> 00:17:44,750
!لهذا مهاجمته تعني مهاجمة نفسك

256
00:17:45,130 --> 00:17:48,410
إذا استطعنا التخلُّص من هذا الظلّ، يمكنني
!الحصول على السّهم

257
00:17:48,410 --> 00:17:49,500
...و

258
00:17:49,500 --> 00:17:54,170
إذا كان لديه ظلّ فإنَّ نوري ينبغي
!أن يكون في مكانٍ ما كذلك

259
00:17:54,170 --> 00:17:56,210
!لم يحصل على السّهم بعد

260
00:17:56,210 --> 00:17:57,550
!بأقصى سرعة يا ميستا

261
00:17:58,280 --> 00:18:02,060
!النّور موجود خلف عقلي

262
00:18:05,750 --> 00:18:09,400
!دمّرَ شيئاً خلف رأسه للتو

263
00:18:09,400 --> 00:18:11,160
ماذا فعلَ بالضبط؟

264
00:18:12,260 --> 00:18:13,940
...الآن قد حصلتُ عليه

265
00:18:13,940 --> 00:18:18,070
!أنا، ديافولو، قد حصلتُ على السّهم

266
00:18:18,070 --> 00:18:24,870
إذا اكتشفَ ديافولو طريقةً للإمساكِ بالسّهم
فينبغي أن نستفيد من ذلك

267
00:18:25,190 --> 00:18:31,960
لأنّ الذراع التي بترَها منّي وقطرات
الدم هذه هي مجرّد جزيئات

268
00:18:33,420 --> 00:18:35,720
غولدن إكسبيريانس سوف

269
00:18:37,690 --> 00:18:39,490
!يظهر الآن

270
00:18:39,490 --> 00:18:40,600
!هذا النّمل

271
00:18:40,600 --> 00:18:42,510
ماذا حدث للتو؟

272
00:18:44,570 --> 00:18:46,190
الأمور بخير إلى الآن

273
00:18:46,190 --> 00:18:47,620
...هيّا بنا

274
00:18:47,620 --> 00:18:49,650
علينا أن نسرع

275
00:18:51,480 --> 00:18:54,180
اقذف السّهمَ بعيداً عنه! لا تدعه
!يمسكه يا ميستا

276
00:18:54,180 --> 00:18:55,690
!أنا أطلِق بالفعل

277
00:18:58,350 --> 00:18:59,340
!لقد شقّوا طريقهم

278
00:18:59,340 --> 00:19:01,720
بالرّغمِ من تنبُّؤه بحركتها، المسافة
بعيدة بيننا

279
00:19:01,720 --> 00:19:06,040
يستطيع فقط أن يزيح الرّصاصات القادمة
!نحوه عن مسارها

280
00:19:06,040 --> 00:19:09,960
أمّا بقيّتكم أيّتها الرّصاصات فاقذفي
!السّهم نحوي

281
00:19:16,340 --> 00:19:18,310
...لـ-لقد رمى

282
00:19:18,310 --> 00:19:19,950
!مدنيّاً في الهواء

283
00:19:19,950 --> 00:19:24,260
عَلِمَ أنّ الرّصاصات ستصيب السّهم
!وتعيده إلى مكانه

284
00:19:24,260 --> 00:19:27,030
...قدرة تافِهة لتابع

285
00:19:27,030 --> 00:19:32,840
مُحال لعقلِك الضعيف أن يتفوّق على تنبّؤات
كينج كريمزن

286
00:19:32,840 --> 00:19:35,050
لن تتمكّنوا من المرور

287
00:19:35,050 --> 00:19:37,340
ما زلتم مجرّد قمامة

288
00:19:37,340 --> 00:19:39,070
،لكن أعترف يا بوتشاراتي

289
00:19:39,070 --> 00:19:43,660
سبّبَ فريقك لي عناء كبيراً

290
00:19:43,660 --> 00:19:48,600
لم أتصوّر يوماً أن تكون أحمق بما يكفي
،لخيانة المُنظّمة

291
00:19:48,600 --> 00:19:52,790
!ولم أتخيّل لحظة أنّك ستكتشف هويّتي الحقيقيّة

292
00:19:52,790 --> 00:19:58,990
لكن حقيقة تمكُّني من اكتشافِ القوّة الحقيقيّة
!لهذا السّهم هي نعمة

293
00:19:58,990 --> 00:20:02,940
إنّها هِبة منحها القدرُ لي لأنّني
!تمكّنتُ من هزيمةِ ماضيّي

294
00:20:02,940 --> 00:20:04,720
!أحتاج لذخيرةٍ أيّتها الرّصاصات

295
00:20:04,720 --> 00:20:06,480
!قلنا لك يا ميستا

296
00:20:06,480 --> 00:20:10,520
!يستغرق تلقيم هذه الخرطوشة وقتاً

297
00:20:10,520 --> 00:20:13,820
!جاء أجلُنا

298
00:20:20,090 --> 00:20:21,740
!ما-ما هذا؟

299
00:20:22,130 --> 00:20:24,910
...سبايسي... ليدي

300
00:20:25,550 --> 00:20:29,770
لم تقم بإزاحةِ رصاصات ميستا

301
00:20:29,770 --> 00:20:32,810
أنا من جعلَها ليّنة فحسب

302
00:20:32,810 --> 00:20:37,500
،امتدّت الرّصاصات كما العلكة وعلِقت في يدك

303
00:20:38,010 --> 00:20:41,300
وجعلتها تستخدم قوّتها المرِنة للعودة
مُخترِقةً يدك

304
00:20:41,300 --> 00:20:44,220
!تريش... ما زلتِ صاحية

305
00:20:44,220 --> 00:20:47,140
سوف أتغلّب على هذا

306
00:20:47,140 --> 00:20:52,870
لن أعيش خائفة وأهرب من القدَر
الذي رسمتَه لي

307
00:20:52,870 --> 00:20:57,400
!إذا اعترضت هذه العقبة طريقي، فسأتجاوزها

308
00:20:57,850 --> 00:21:01,110
!السّهم يطير نحوي

309
00:21:01,880 --> 00:21:03,530
!أنا الأقرب

310
00:21:03,530 --> 00:21:05,490
!لا يمكنه أن يتخطّاني

311
00:21:05,850 --> 00:21:09,200
حتّى لو تنبّأ بالمكان الذي سيسقط
،فيه السّهم وحذفَ الزمن

312
00:21:09,200 --> 00:21:11,660
!أبقى أقرب من السّهم إليه

313
00:21:11,660 --> 00:21:14,660
،ليتك... يا ابنتي

314
00:21:14,660 --> 00:21:17,580
...ليتكِ لم تولدي

315
00:21:17,580 --> 00:21:21,280
ينبع الخوف حقّاً من الماضي

316
00:21:21,280 --> 00:21:25,990
!لقد أثرتِ غضبي فعلاً

317
00:21:31,410 --> 00:21:33,310
ماذا؟

318
00:21:38,020 --> 00:21:40,370
قلتِ أنّكِ ستتغلّبين على هذا، أليس كذلك؟

319
00:21:40,370 --> 00:21:45,370
كنتِ محقّة يا تريش. والآن لن تتغلّبي
...على الماضي فقط

320
00:21:45,990 --> 00:21:48,120
بل على عقولهم

321
00:21:50,330 --> 00:21:53,550
!تريش