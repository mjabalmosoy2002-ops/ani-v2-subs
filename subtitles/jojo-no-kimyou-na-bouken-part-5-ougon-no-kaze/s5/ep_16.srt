1
00:01:36,320 --> 00:01:39,150
!بيشّي! ماذا تفعل بالضبط؟

2
00:01:39,150 --> 00:01:40,900
!بيشّي

3
00:01:40,900 --> 00:01:42,780
!أسرِع وأوقِف القِطار

4
00:01:42,780 --> 00:01:44,450
!بيشّي

5
00:01:46,830 --> 00:01:48,830
!أ-أنيكي

6
00:01:49,330 --> 00:01:51,660
!أوقِف القطار

7
00:01:54,380 --> 00:01:56,500
!أنيكي

8
00:01:56,500 --> 00:01:59,510
!لـ-لا أعرف كيف أوقفه

9
00:01:59,880 --> 00:02:03,220
الآن أنت وقدرة الشّيخوخة خاصّتك ستزولان

10
00:02:03,220 --> 00:02:07,310
حينئذ سيعودُ طاقمي إلى طبيعتِه وستكون تريش بأمان

11
00:02:08,260 --> 00:02:09,640
...أيُّها الحقير

12
00:02:09,640 --> 00:02:11,850
!بوتشاراتي

13
00:02:11,850 --> 00:02:14,520
!أنيكي

14
00:02:17,860 --> 00:02:18,570
!ماذا؟

15
00:02:20,110 --> 00:02:23,320
!بروشوتّو أنيكي

16
00:02:26,200 --> 00:02:28,990
!أ-أحسنتَ صنعاً يا بيشّي

17
00:02:28,990 --> 00:02:31,950
!عـ-عمل ممتاز! كانت سرعة بديهة منك

18
00:02:31,950 --> 00:02:34,000
...كان ذلك وشيكاً

19
00:02:34,000 --> 00:02:37,290
كدتُ أفشل في فعلِها، لكن حالفَني الحظُّ
!وتمكّنتُ من اصطياده

20
00:02:37,290 --> 00:02:40,000
!والآن خطّافي لن يفلته أبداً

21
00:02:40,550 --> 00:02:44,680
!لـ-لكن من الواضِح بأنّ هذا وزن شخصَين

22
00:02:44,680 --> 00:02:48,300
!لا بدّ وأنّ بوتشاراتي مُعلَّق أيضاً

23
00:02:50,350 --> 00:02:56,020
حسبتُ نفسي هالكاً حقّاً يا بوتشاراتي

24
00:02:56,020 --> 00:03:01,280
نعتُّك بالزعيمِ الفرعيّ الفاشِل، لكن أسحب كلامي الآن

25
00:03:01,280 --> 00:03:03,400
أعتذِر على وقاحتي

26
00:03:03,860 --> 00:03:07,910
أنت قادرٌ على اتّخاذ القرارات بحياديّة

27
00:03:07,910 --> 00:03:10,700
وحتّى أنّك تستطيع المُخاطرة بحياتك

28
00:03:10,700 --> 00:03:16,790
اتّخذ الزعيمُ القرارَ الصّائب بتركِ تريش بين يديك

29
00:03:16,790 --> 00:03:19,630
أنا مدهوشٌ في الواقع

30
00:03:19,630 --> 00:03:22,260
...ولكن يا بوتشاراتي

31
00:03:22,260 --> 00:03:24,630
!أنتَ زعيمٌ فرعيّ عاثر الحظّ

32
00:03:25,550 --> 00:03:30,930
!والآن اسقط في جحيمِ الـ150 كيلومتر في السّاعة

33
00:03:30,930 --> 00:03:33,020
!ستيكي فينقرز

34
00:03:33,520 --> 00:03:34,930
هل نسيت؟

35
00:03:34,930 --> 00:03:39,230
!ما زلتَ تشيخ في لحظةِ تكلّمنا هذه

36
00:03:39,230 --> 00:03:41,110
!بطيء للغاية

37
00:03:42,190 --> 00:03:47,860
أتعلم؟ أنقذتْني تلك السنّارة التي أرسلَها
أخوك الصّغير ذاك

38
00:03:48,860 --> 00:03:51,160
لم يكن يصوِّب نحوي

39
00:03:51,160 --> 00:03:54,330
هل يُعقَل أن أكون أنا عاثر الحظّ هنا؟

40
00:03:54,330 --> 00:03:58,540
!ما كان ينبغي لميستا أن يكون حيّاً على الإطلاق

41
00:03:58,540 --> 00:04:02,170
أطلقتُ ثلاث رصاصات في رأسه

42
00:04:02,170 --> 00:04:09,760
حقيقة بقائه على قيدِ الحياة هي بمثل غرابة أن
!يأتي شخصٌ ويقول أنّ الشّمس تشرق من الغرب

43
00:04:10,300 --> 00:04:12,720
استطعتُ أن أبلغه

44
00:04:12,720 --> 00:04:15,140
بأنّ الطّاقة النّاجِمة عن هجمةٍ على السنّارة

45
00:04:15,140 --> 00:04:17,980
!تُرَدُّ إلى الشّخص المُعلَّق بها

46
00:04:19,980 --> 00:04:21,810
!مستحيل

47
00:04:23,980 --> 00:04:26,610
!بوتشاراتي

48
00:04:28,400 --> 00:04:30,660
!خفَّ وزنٌ بحجم شخص الآن

49
00:04:30,660 --> 00:04:33,030
!لا بدَّ وأنّنا تمكّنّا من إسقاط بوتشاراتي

50
00:04:33,030 --> 00:04:36,000
!نجحنا يا بروشوتّو أنيكي

51
00:04:38,870 --> 00:04:41,580
يبدو أنّ تأثير الشّيخوخة يزول

52
00:04:41,580 --> 00:04:43,920
والآن كلّ ما علينا هو تولّي أمر حامل
سنّارة الصّيد

53
00:04:43,920 --> 00:04:45,050
أجل

54
00:04:49,840 --> 00:04:56,850
في وقتٍ سابق، أنا متأكّدٌ من أنّ خطّاف فيشر
مان غرسَ في يدِ أنيكي اليُمنى

55
00:04:58,770 --> 00:05:02,150
...كان خنصره على الطرف الأيمن من الخطّاف

56
00:05:05,480 --> 00:05:07,150
...لكن الآن

57
00:05:07,820 --> 00:05:11,530
...الخنصر على الطرف الأيسر من الخطّاف

58
00:05:11,530 --> 00:05:13,370
!هذه يدُ شخصٍ يُسرى

59
00:05:13,370 --> 00:05:16,330
ما الذي يجري بالضبط؟

60
00:05:16,330 --> 00:05:20,670
يدُ مَن تتواجد في النّاحية الأخرى؟

61
00:05:20,670 --> 00:05:25,170
!كيف انتقلَتْ يدُ أنيكي اليمنى إلى يساره؟

62
00:05:25,170 --> 00:05:31,010
...و-والآن بدأتُ ألاحظ... يبدو أنيكي أثقل قليلاً أيضاً

63
00:05:28,380 --> 00:05:31,010
!أ-أنت

64
00:05:31,010 --> 00:05:35,640
اطلبْ منهم أن يوقفوا القطار! أعتقد أنّ
!الجميع في القطار مرضى

65
00:05:35,640 --> 00:05:39,480
...بدأتُ أشعر بتحسُّن كبير، لكن

66
00:05:39,480 --> 00:05:42,350
!خسرتُ بعض الأسنان

67
00:05:39,480 --> 00:05:42,350
!لـ-لقد توقّفت الشّيخوخة

68
00:05:42,350 --> 00:05:44,020
!هل تسمعني؟

69
00:05:44,020 --> 00:05:46,230
!اطلبْ من السّائق إيقاف القِطار بسرعة

70
00:05:46,230 --> 00:05:47,570
...مستحيل

71
00:05:47,570 --> 00:05:52,450
هل يُعقَل أن يكون الوزن الذي زالَ
...عن السنّارة كان

72
00:05:52,450 --> 00:05:53,530
!مستحيل

73
00:05:53,530 --> 00:05:55,490
!مستحيل! مستحيل

74
00:05:55,740 --> 00:05:57,620
...هل يُعقَل أن يكون أنيكي قد

75
00:05:57,620 --> 00:05:59,250
!هل تسمعني أيُّها الأحمق؟

76
00:05:59,250 --> 00:06:01,580
!أتكلّم معك! أنت، هناك

77
00:06:01,580 --> 00:06:04,460
!عزيزي بروشوتّو أنيكي

78
00:06:04,460 --> 00:06:06,840
ماذا ينبغي أن أفعل؟ ماذا ينبغي أن أفعل؟

79
00:06:06,840 --> 00:06:08,920
ماذا يُفترض بي أن أفعل؟

80
00:06:10,050 --> 00:06:14,390
مستحيل! الأشخاص الذين بداخل السّلحفاة
!سوف يخرجون أيضاً

81
00:06:14,390 --> 00:06:18,430
...ما-ماذا يجدر بي أن أفعل؟ ماذا يجدر بي

82
00:06:16,510 --> 00:06:18,430
!ما الذي تقوله بالضبط؟

83
00:06:18,430 --> 00:06:20,310
!قلتُ لك أخبرهم أن يوقفوا القطار

84
00:06:20,310 --> 00:06:22,140
!اِخرس! اِخرس! اِخرس

85
00:06:22,140 --> 00:06:25,100
!اِخرس، تبّاً

86
00:06:23,270 --> 00:06:25,100
!هل أنت فتى مُدلَّل؟

87
00:06:25,100 --> 00:06:29,400
—حسناً. بدأتُ أشعر بتحسّن، لذا سأخبرهم بـ

88
00:06:34,450 --> 00:06:36,450
ما-ما الذي يجري؟

89
00:06:38,330 --> 00:06:39,870
!الشّيخوخة لم تتوقّف

90
00:06:40,490 --> 00:06:43,120
...بـ-بوتشاراتي، أنت

91
00:06:43,120 --> 00:06:44,460
...مستحيل

92
00:06:44,460 --> 00:06:47,040
...هل يُعقَل أنّه... هل يُعقَل أنّه

93
00:06:53,630 --> 00:06:55,510
!ماذا؟

94
00:06:56,140 --> 00:06:59,470
...غريتفول... ديث

95
00:06:59,470 --> 00:07:03,640
!أنيكي

96
00:07:07,560 --> 00:07:12,900
كنتَ محقّاً، أنيكي... كنتَ محقّاً تماماً

97
00:07:12,900 --> 00:07:17,700
قلتَ أنّنا لا ينبغي أبداً أن نلغي

98
00:07:17,700 --> 00:07:22,830
قدرة الستاند خاصّتنا حالما نحكم القبض
...عليهم، حتّى لو خسرنا طرفاً من أطرافنا

99
00:07:22,830 --> 00:07:24,870
...أنيكي

100
00:07:25,160 --> 00:07:30,040
بحالته الجسديّة الفوضويّة هذه، مـ-من المُحال
...أن يتمكّن من النجاة

101
00:07:30,040 --> 00:07:33,130
،سيموت في أي لحظة الآن

102
00:07:33,130 --> 00:07:38,470
!ومع ذلك لا يلغي قدرةَ الستاند خاصّته

103
00:07:42,810 --> 00:07:48,600
يجب علينا أن نُمسِك بتريش مهما كلّف
الأمر، أليس كذلك يا أنيكي؟

104
00:07:49,150 --> 00:07:52,610
...لا يمكننا التّراجُع الآن

105
00:07:53,480 --> 00:07:57,490
...عُلِم يا بروشوتّو أنيـ

106
00:07:57,910 --> 00:07:59,950
فهمتُ عزيمتَك يا أنيكي

107
00:08:00,530 --> 00:08:05,290
ليس كمجرّد كلمات بل حفظتُها عن ظهر قلب

108
00:08:05,660 --> 00:08:08,500
،عندما نفكّر في قتل شخص يا أنيكي

109
00:08:10,170 --> 00:08:13,210
!يكون العملُ قد أُنجِزَ بالفعل

110
00:08:23,680 --> 00:08:28,730
هذه هي أوّل مرّة أقضي فيها على شخصٍ ما

111
00:08:28,730 --> 00:08:32,520
لكن لم يكن ذلك الأمر الجلل كما توقّعتُ أن يكون

112
00:08:32,520 --> 00:08:41,530
والآن، لم يبقَ أحد يناديني بالمُدلَّل

113
00:08:45,420 --> 00:08:47,920
:اسم المالِك

114
00:08:45,460 --> 00:08:47,920
:اسم الستاند

115
00:08:45,830 --> 00:08:47,920
بيتش بوي

116
00:08:50,220 --> 00:08:52,850
سأحسم هذا الأمر بشكلٍ نهائي

117
00:08:52,850 --> 00:08:55,720
!قبل أن تزول قدرةُ أنيكي

118
00:08:55,720 --> 00:08:59,890
بوتشاراتي! عليك أن تسرع وتزيل
!هذا الخطّاف

119
00:08:59,890 --> 00:09:00,890
أجل

120
00:09:02,230 --> 00:09:04,400
تمكّنتَ من فتحِ يدك بسحّاب

121
00:09:06,690 --> 00:09:10,240
يستطيع أن يعرف ما أحاول فعله؟

122
00:09:10,490 --> 00:09:12,610
!سأقرأ كلّ تحرّكاتك

123
00:09:13,120 --> 00:09:19,120
سأدع الخطّاف يتنقّل من يده إلى معصمِه
!ثمّ إلى زنده

124
00:09:19,120 --> 00:09:22,460
!الخطّاف يتعمّق أكثر في ذِراعك

125
00:09:24,080 --> 00:09:26,000
!خرجَ الخطّاف مجدّداً

126
00:09:32,800 --> 00:09:33,800
،لا جدوى. كلّما حاولتُ إخراج الخطّاف منّي

127
00:09:33,800 --> 00:09:38,560
يقرأ تحرُّكاتي ضمن بضع سنتيمترات

128
00:09:38,560 --> 00:09:40,270
!وهو قويّ

129
00:09:40,600 --> 00:09:43,900
!لن أفقد أثرَ جسدك

130
00:09:44,270 --> 00:09:49,490
حينئذ سأقبض على تريش وأحرص
!على تحقيقِ إرادة بروشوتّو

131
00:09:49,490 --> 00:09:52,490
!بوتشاراتي! الحقير هناك في الأسفل

132
00:09:52,490 --> 00:09:58,830
إذا قضينا عليه بشكلٍ نهائي، سيزول تأثير الشّيخوخة عن
!جورنو والآخرين ونقضي على حامِل السنّارة الوغد

133
00:09:58,830 --> 00:10:02,620
!أعلم، لكن تنفيذ هذا صعبٌ جدّاً أيضاً

134
00:10:02,620 --> 00:10:07,000
سأدعك تعاني نفس مُعاناة أنيكي

135
00:10:10,710 --> 00:10:12,590
!بوتشاراتي

136
00:10:13,470 --> 00:10:15,470
إنّه يتعلّقُ بشيء ما

137
00:10:15,470 --> 00:10:18,810
!في هذه الحالة... يمكنك أن تصعد فحسب

138
00:10:21,730 --> 00:10:23,480
!أنت تتوجّه نحو الأسلاك الكهربائيّة

139
00:10:23,480 --> 00:10:25,940
!فلتُقطَع إلى نصفين

140
00:10:32,990 --> 00:10:38,410
شعرتُ بصدمة، لكن لم يُقطَع
إلى نصفين أو يسقط

141
00:10:38,410 --> 00:10:40,620
أشعر بنبضِ قلبٍ عبر السنّارة

142
00:10:40,620 --> 00:10:42,790
بوتشاراتي ما زال على قيدِ الحياة

143
00:10:43,660 --> 00:10:46,380
!دخلَ القِطار

144
00:10:46,710 --> 00:10:49,460
!كان ذلك وشيكاً يا بوتشاراتي

145
00:10:49,460 --> 00:10:53,720
على هذا المنوال، سوف نواجهه بشكلٍ مُباشَر

146
00:10:53,720 --> 00:10:57,890
أجل... لكن سيكون ذلك صعباً كذلك

147
00:10:57,890 --> 00:10:59,510
لن نصِل في الوقت

148
00:10:59,510 --> 00:11:02,640
!لقد دخلَ الخطّافُ صَدري

149
00:11:02,640 --> 00:11:03,640
!ماذا؟

150
00:11:04,100 --> 00:11:07,940
باتَتِ المسافةُ بين الخطّاف وقلبك الآن
...هي 12 سنتيمتر

151
00:11:07,940 --> 00:11:09,480
...‏‏11 سنتيمتر

152
00:11:09,480 --> 00:11:11,400
استخففتُ بالوضع

153
00:11:11,400 --> 00:11:17,320
العدوّ الذي شكّل تهديداً أكبر على متنِ هذا القطار لم يكن
الشّخص الذي استخدم قدرةَ الشّيخوخة على الجميع

154
00:11:17,320 --> 00:11:19,530
الشّخص الأكثر رُعباً منه حتّى

155
00:11:19,530 --> 00:11:22,080
!هو حامِل سنّارة صيد السّمك هذا

156
00:11:22,080 --> 00:11:24,460
!إذاً ماذا ستفعل؟

157
00:11:24,460 --> 00:11:26,830
!سيغرس الخطّافُ في قلبِك عمّا قريب

158
00:11:26,830 --> 00:11:29,880
...‏‏9 سنتيمتر، 8 سنتيمتر

159
00:11:29,880 --> 00:11:32,050
إذاً سأريه مما أنا مصنوع منه

160
00:11:32,050 --> 00:11:34,550
،لأغلب قدرته

161
00:11:35,170 --> 00:11:40,350
عليّ أن أثبت له أنّ عزيمتي
!أقوى من عزيمته

162
00:11:40,350 --> 00:11:42,560
!ستيكي فينقرز

163
00:11:44,390 --> 00:11:46,100
!ماذا تفعل بالضبط؟

164
00:11:54,070 --> 00:11:56,110
!بوتشاراتي

165
00:11:57,030 --> 00:11:58,410
!اختفى

166
00:11:58,410 --> 00:12:02,370
...لا أحسّ بنبضه أو اهتزازات أنفاسه

167
00:12:02,370 --> 00:12:04,160
!لماذا؟

168
00:12:04,160 --> 00:12:07,210
كيف لم أعد أشعر بوجوده؟

169
00:12:07,210 --> 00:12:08,750
!كيف؟

170
00:12:08,750 --> 00:12:11,670
!كيف تفعل أمراً جنونيّاً كهذا يا بوتشاراتي؟

171
00:12:11,670 --> 00:12:14,630
...أعلم أنّه لا توجد طريقةٌ أخرى

172
00:12:14,630 --> 00:12:18,180
!لكن هل ستكون بخير حقّاً؟

173
00:12:18,180 --> 00:12:20,970
اصـ... مت

174
00:12:20,970 --> 00:12:23,470
...انتظر حتى يبتعد

175
00:12:24,010 --> 00:12:28,850
هذا ما يعنيه أن تمتلك عزيمة... أيُّها الرّقم ستّة

176
00:12:28,850 --> 00:12:30,940
!اللّعنة، لا أستطيع إيجاده

177
00:12:30,940 --> 00:12:33,570
!يستطيع بوتشاراتي الذّهاب إلى أي مكان بسحّابه

178
00:12:33,940 --> 00:12:38,280
هـ-هل يُعقَل أن يكون قادماً إلى هنا من جهةٍ ما؟

179
00:12:38,280 --> 00:12:41,120
...لا، لحظة. اهدأ

180
00:12:41,120 --> 00:12:43,660
!الخوف الشّديد هو علامةُ ضعف

181
00:12:43,660 --> 00:12:46,540
!هذا ما كان ليقوله بروشوتّو لي

182
00:12:46,540 --> 00:12:48,960
تحلَّ بثِقةٍ أكبر يا بيشّي

183
00:12:48,960 --> 00:12:54,800
لا يهمّ إن كنّا في قطارٍ متحرِّك أنا متأكّدٌ أنّك
تستطيع إيجاده بواسطة تحسُّس نبضات قلبه

184
00:12:54,800 --> 00:12:56,050
!هذا ما كان ليقوله

185
00:12:56,420 --> 00:13:00,590
من المُحال أن يتمكَّن بوتشاراتي
!من التحرُّك بسرعة الآن

186
00:13:00,590 --> 00:13:05,720
!لا بدَّ وأنّه موجود في مكانٍ قريب من الخطّاف

187
00:13:08,020 --> 00:13:11,350
!إ-إنّه يمدُّ السنّارة لنقطةٍ أبعد حتّى

188
00:13:11,350 --> 00:13:14,480
!أسرِع ولملم نفسك واهرب

189
00:13:15,230 --> 00:13:16,730
...حاليّاً

190
00:13:17,610 --> 00:13:20,070
...لم يعُد يراني

191
00:13:20,450 --> 00:13:24,780
...يمكنني النّجاة من هذا ما دمتُ لا أتحرّك

192
00:13:25,330 --> 00:13:27,950
حقيقة عدم قيامي بأيّ شيء الآن

193
00:13:28,540 --> 00:13:30,500
تُثبِت عزيمتي

194
00:13:30,500 --> 00:13:36,210
...نبضات قلبه، نبضات جسده، ابحث عن هذين الشيئين

195
00:13:39,050 --> 00:13:41,930
!أمسكتُه! لكن ليس هو

196
00:13:41,930 --> 00:13:43,390
وزنه مختلِف

197
00:13:43,390 --> 00:13:45,350
!لا بدّ وأنّه راكب آخر

198
00:13:50,480 --> 00:13:54,150
!هذا هو... إنّه ضعيف، لكنّه صوت قلب

199
00:13:54,480 --> 00:13:57,480
!لـ-لا! سيجِد قلبك

200
00:13:58,230 --> 00:13:59,690
!لماذا فعل هذا؟

201
00:13:59,690 --> 00:14:01,530
،قال أنّه لم يكن سيفعل شيئاً

202
00:14:01,530 --> 00:14:05,660
لكن قطعَ قلبه إلى نصفين وأوقفه

203
00:14:05,990 --> 00:14:07,330
!هذا جنون

204
00:14:07,330 --> 00:14:12,710
كم من المدّة يستطيع البشريّ العيش
عندما يتوقّف قلبُه وأنفاسه؟

205
00:14:18,250 --> 00:14:20,460
!ا-اللّعنة! إنّه ليس هناك

206
00:14:20,460 --> 00:14:24,180
لا أشعر بأي شيء آخر يتحرّك
!في تِلك الغرفة

207
00:14:24,180 --> 00:14:27,850
هـ-هل انتقل إلى مكانٍ آخر باستخدام سحّابه إذاً؟

208
00:14:36,230 --> 00:14:38,070
!بلغتَ أقصى حدٍّ لديك

209
00:14:41,150 --> 00:14:44,280
!إلى أين ذهب بحقّ الجحيم؟

210
00:14:44,910 --> 00:14:47,490
هل يُعقَل أن يكون بوتشاراتي

211
00:14:47,490 --> 00:14:50,450
...قد تمكّنَ من القضاء على بروشوتّو

212
00:14:50,870 --> 00:14:54,920
حالما تتوقّف قدرةُ الشّيخوخة، سيخرج رجال
!بوتشاراتي من تلك السّلحفاة

213
00:14:54,920 --> 00:14:57,880
!اللّعنة

214
00:14:57,880 --> 00:15:02,380
!لن أسمح بحدوث ذلك

215
00:15:03,760 --> 00:15:06,430
!نـ-نجحنا! تخلّى عن هذه المقصورة

216
00:15:06,760 --> 00:15:10,220
!عزيمتُك دفعَتْه للبحث في مكانٍ آخر

217
00:15:10,640 --> 00:15:12,390
!تمكّنت من النّجاة

218
00:15:12,390 --> 00:15:17,310
!لملِم واجمع جسدك من جديد! بسرعة

219
00:15:28,740 --> 00:15:30,660
...غـ... غير معقول

220
00:15:31,490 --> 00:15:33,250
...يا لسوء الحظّ

221
00:15:33,250 --> 00:15:35,790
!بوتشاراتي! تماسك

222
00:15:36,960 --> 00:15:39,790
!اختصاصي الوحيد هو التحكُّم بالرّصاص

223
00:15:39,790 --> 00:15:45,630
لا أملك طاقةً كافيةً لتحريك أشياء
!أكبر منّي حجماً

224
00:15:40,210 --> 00:15:43,510
...كان أعند ممّا توقّعت

225
00:15:44,300 --> 00:15:46,720
...لقد... انتصر

226
00:15:48,970 --> 00:15:52,060
!توقّف أيّها القطار اللّعين

227
00:15:54,480 --> 00:15:56,270
!ماذا؟

228
00:16:10,780 --> 00:16:13,950
!أ-أنيكي

229
00:16:17,080 --> 00:16:19,500
كان هذا طريقاً وعِراً فعلاً

230
00:16:20,080 --> 00:16:23,380
ما كنتُ لأستطيع عبوره بلا حظّ

231
00:16:25,460 --> 00:16:28,550
أعني الطّريق للاقترابِ منك

232
00:16:33,350 --> 00:16:36,930
...سوف تدفع الثّمن يا بوتشاراتي

233
00:16:36,930 --> 00:16:40,940
!اقتربتَ منه! ربِحَتْ عزيمتك يا بوتشاراتي

234
00:16:41,560 --> 00:16:46,900
...من أمام أنيكي، قبل أن يرحل بشكلٍ نهائي

235
00:16:53,450 --> 00:16:54,410
!ماذا؟

236
00:16:54,410 --> 00:16:58,080
أنا متفاجئ من قدرتِك على رؤية
!تلك الهجمة

237
00:16:58,080 --> 00:17:00,500
...عيناه ووجهه

238
00:17:00,500 --> 00:17:03,380
تُشعرني بأنّه عاش عشر سنوات من إراقة
...دماءٍ متواصل

239
00:17:03,380 --> 00:17:05,750
أشعر بحِدّةٍ وهدوءٍ من عينيه

240
00:17:06,420 --> 00:17:08,760
لن يفلح التّحايُل معه

241
00:17:08,760 --> 00:17:14,680
...افعلها... النّصرُ بين يديك... يا بيشّي

242
00:17:14,680 --> 00:17:22,020
...اِفعلْها... أنا... أراقبك وأرعاك

243
00:17:27,530 --> 00:17:29,900
!سوف أقتلك

244
00:17:32,910 --> 00:17:34,780
!ماذا؟

245
00:17:34,780 --> 00:17:36,620
!عرفتُ أنّك ستفعل ذلك

246
00:17:41,330 --> 00:17:49,920
استهداف ذِراع شخص للوصولِ إلى قلبه كان خطّة مضمونة اعتدتُ
!استخدامها بسبب قلّة ثِقتي وظنّي بأنّني سأخفق إذا فعلتُ خلاف ذلك

247
00:17:49,920 --> 00:17:53,760
!عندما أكون واثِقاً فلا أخفق وأستهدف القلبَ مباشرة

248
00:17:53,760 --> 00:17:57,930
!الآن، سوف أستهدف كلّ شيء بشكلٍ مُباشَر

249
00:17:57,930 --> 00:18:02,190
!سوف أقتلك! سوف أقتلع قلبك يا بوتشاراتي

250
00:18:15,870 --> 00:18:20,500
يجدر بك أن تقول ذلك بعد أن تنفّذ ما تريد فعلاً

251
00:18:20,500 --> 00:18:22,790
هكذا هو الأمر في عالم العصابات

252
00:18:25,790 --> 00:18:28,090
هل... خسِرت؟

253
00:18:28,960 --> 00:18:31,630
هل... سأموت؟

254
00:18:31,630 --> 00:18:36,680
!لكن... أنا لن... أموت بهذه البساطة

255
00:18:38,140 --> 00:18:42,060
...هيّا... خذها... واهرب

256
00:18:42,060 --> 00:18:44,850
...سأدع تريش على قيدِ الحياة

257
00:18:44,850 --> 00:18:46,650
!السّلحفاة بحوزته

258
00:18:46,650 --> 00:18:47,820
أ-أين أنا؟

259
00:18:47,820 --> 00:18:49,730
...لكن قبل أن أموت

260
00:18:49,730 --> 00:18:53,610
!سأغرِق قلبَك في اليأس

261
00:18:53,610 --> 00:18:57,200
!يأس خسارة طاقمك

262
00:18:57,200 --> 00:19:00,790
!سأحطّم هذه السّلحفاة تحطيماً

263
00:19:00,790 --> 00:19:02,830
!يا للهول! هذه مصيبة

264
00:19:03,410 --> 00:19:10,210
في وقتٍ سبق، لمستُ كرامةً وعزيمةً
صلبة كالألماس تبرقان في عينيك

265
00:19:10,210 --> 00:19:12,710
لكنّك سقطتَ الآن

266
00:19:13,050 --> 00:19:15,430
صرتَ الآن مجرّد قمامة

267
00:19:15,430 --> 00:19:18,640
!سقطت؟ أتقول سقطت؟

268
00:19:18,640 --> 00:19:23,180
الوحيدون الذين سيسقطون ويُسحَقون
!هم هؤلاء الأوغاد

269
00:19:23,180 --> 00:19:27,730
لن تلحق في الوقت المناسب! آمل أن تستمتع
!بالجحيم يا بوتشاراتي

270
00:19:33,070 --> 00:19:37,570
ستفشل مهما فعلت عندما تكون قمامة

271
00:19:43,250 --> 00:19:47,960
!أرّي! أرّي! أرّي

272
00:19:47,960 --> 00:19:49,330
!أرّي

273
00:19:53,050 --> 00:19:54,800
أرّيفيديرشي

274
00:20:25,000 --> 00:20:28,420
كما توقّعت، لن نتمكّن من الاستمرار
في ركوبِ هذا القطار

275
00:20:28,420 --> 00:20:30,210
أجل

276
00:20:30,210 --> 00:20:33,000
من المُحال ألّا يكونا قد اتّصلا ببقيّة طاقمهما

277
00:20:33,000 --> 00:20:37,010
أنا متأكّدٌ بأنّهما أخبرا الآخرين عن وجهتِنا
وعن السّلحفاة

278
00:20:37,800 --> 00:20:40,970
يتوجّب علينا البحث عن وسيلةِ نقل أخرى
من هنا

279
00:20:43,180 --> 00:20:45,770
أودُّ أن أطرح عليك سؤالاً

280
00:20:45,770 --> 00:20:47,430
هل أنت مستعدٌّ لإجابتي؟

281
00:20:47,850 --> 00:20:51,940
لم أتلقَّ إذناً للإجابة على أي سؤال
من أسئلتكِ

282
00:20:51,940 --> 00:20:54,940
مهمّتُنا هي أن نكون حرّاسكِ الشخصيّين فقط لا غير

283
00:20:54,940 --> 00:20:57,280
سوف تجيبني مهما كلّف الأمر

284
00:20:57,280 --> 00:20:59,780
مَن أكون؟

285
00:21:00,240 --> 00:21:01,990
ما يكون هذا بالضبط؟

286
00:21:01,990 --> 00:21:03,530
ما هذا الذي على الأرض؟

287
00:21:03,530 --> 00:21:07,370
لماذا أرى مثل هذه الأشياء الغريبة فجأة؟

288
00:21:08,500 --> 00:21:13,250
لماذا حياتي في خطر بسببِ أبٍ
!لا أعرفه حتّى؟

289
00:21:13,250 --> 00:21:17,630
كما توقّعت... ابنة الزعيم هي مُستخدِمة ستاند

290
00:21:18,090 --> 00:21:19,470
!أجبني

291
00:21:23,880 --> 00:21:26,380
:اسم المالِك

292
00:21:23,920 --> 00:21:26,380
:اسم الستاند

293
00:21:24,290 --> 00:21:26,380
ستيكي فينقرز

294
00:21:27,460 --> 00:21:30,260
السّاعة حاليّاً 6:34 صباحاً

295
00:21:30,260 --> 00:21:34,100
وصلتُ إلى هنا بعد عشرين دقيقة
من توقُّف القِطار

296
00:21:34,510 --> 00:21:37,020
بروشوتّو ميّت بجانب السّكك

297
00:21:37,390 --> 00:21:41,390
أجزاء من جثّةِ بيشّي والذي مُزِّقَ إرباً
موجودة على ضفّةِ النّهر

298
00:21:41,390 --> 00:21:46,780
بحسبِ المشهد، يبدو أنّ من قضى عليهما
هو ستيكي فينقرز الخاص ببوتشاراتي

299
00:21:46,780 --> 00:21:49,440
هكذا إذاً. أين هم والفتاة؟

300
00:21:49,440 --> 00:21:50,530
رحلوا منذ زمن

301
00:21:50,530 --> 00:21:53,280
هل ستتمكّن من تعقُّبِهم يا ميلوني؟

302
00:21:53,280 --> 00:21:54,240
أجل

303
00:21:54,240 --> 00:21:59,330
كلّ ما فعله الاِثنان اللّذان سقطا
سيجعل عمليّة تعقُّبهم مُمكِنة

304
00:22:00,910 --> 00:22:03,380
استطعتُ جمع عيّنة دماء

305
00:22:04,750 --> 00:22:06,380
دماء بوتشاراتي