1
00:00:01,900 --> 00:00:03,370
.كنوز

2
00:00:03,370 --> 00:00:05,170
.أشياء لا غنى عنها

3
00:00:05,170 --> 00:00:06,700
.أشياء ثمينة

4
00:00:10,490 --> 00:00:15,490
.حدث الأمر فجأةً في يوم عاديّ

5
00:00:17,960 --> 00:00:19,750
...دازاي-سان وأنا

6
00:00:28,760 --> 00:00:30,990
!تبادلنا جسدنا

7
00:00:44,250 --> 00:00:47,920
يا أيّتها الرّياح، ماذا ترغبين منّي؟

8
00:00:54,060 --> 00:00:55,290
دازاي-سان؟

9
00:00:55,290 --> 00:00:56,070
.أجل

10
00:00:56,830 --> 00:00:59,130
!سأذهب للعبث مع كونيكيدا-كن

11
00:00:58,410 --> 00:00:59,130
!مهلًا

12
00:00:59,130 --> 00:01:00,570
!لا تقم بمقلب على أيّ أحد رجاءً

13
00:01:00,570 --> 00:01:02,670
.لنظلّ ثابتين إلى أن نعود لطبيعتنا

14
00:01:02,670 --> 00:01:05,950
.حسنًا

15
00:01:05,950 --> 00:01:08,660
!أخبرتك أن تظلّ ثابتًا فحسب! لا تخرج جسدي من لفائف الموت

16
00:01:09,220 --> 00:01:12,010
.ربّما سأذهب لمغازلة آنسات جميلات

17
00:01:12,010 --> 00:01:13,150
!لا تفعل رجاءً

18
00:01:13,150 --> 00:01:15,810
،إن كنت لا تستطيع أن تظلّ ثابتًا
أيمكنك أن تقوم ببعض الأعمال على الأقلّ؟

19
00:01:18,420 --> 00:01:21,270
...دازاي يخبر أتسوشي أن يقوم بعمل

20
00:01:21,270 --> 00:01:22,930
.بدأ يصبح هذا مؤرقًا

21
00:01:22,930 --> 00:01:24,910
!يا كونيكيدا-كن

22
00:01:24,910 --> 00:01:27,020
.كنت أبحث عنك

23
00:01:27,470 --> 00:01:28,680
أتسوشي، هذا أنت، صحيح؟

24
00:01:29,520 --> 00:01:33,160
...أيّتها الرّياح، ما الّذي

25
00:01:33,160 --> 00:01:36,190
!ما هذا؟

26
00:01:36,200 --> 00:01:39,090
!مرحى! لديّ جسد كونيكيدا-كن

27
00:01:39,090 --> 00:01:40,160
إذًا؟ كيف أبدو؟

28
00:01:40,160 --> 00:01:41,970
!دازاي أوسامو في كونيكيدا-كن

29
00:01:41,970 --> 00:01:43,200
.هذا مخيف

30
00:01:43,200 --> 00:01:46,190
!مرحى! سأذهب لتناول الشّواء بمال كونيكيدا-كن

31
00:01:46,410 --> 00:01:47,700
!انتظر

32
00:01:48,760 --> 00:01:50,630
هل أنت بخير يا رامبو-سان؟

33
00:01:50,630 --> 00:01:52,080
...جسدي

34
00:01:52,080 --> 00:01:55,090
أنا بخير، لكن ما كان ذلك؟

35
00:01:55,090 --> 00:01:55,980
.يا إلهي

36
00:01:56,260 --> 00:01:57,520
أنا؟

37
00:01:57,520 --> 00:01:59,460
.تبادلا جسديهما أيضًا

38
00:02:02,840 --> 00:02:06,220
.رامبو، باستنتاجه المطلق، عرف ما يجري على الفور

39
00:02:06,220 --> 00:02:07,460
!هذا ممتع حقًّا

40
00:02:07,460 --> 00:02:09,010
.سأذهب لأري الزّعيم

41
00:02:08,150 --> 00:02:10,280
!لا تفعل ذلك رجاءً

42
00:02:10,280 --> 00:02:11,730
.هذا هو رامبو-سان

43
00:02:11,730 --> 00:02:14,370
...أيّتها الرّيح

44
00:02:21,740 --> 00:02:23,940
.ما زلت لا تبدو مثله يا أتسوشي-كن

45
00:02:23,940 --> 00:02:25,030
.عليك أن تبدو مسترخيًا أكثر

46
00:02:25,030 --> 00:02:26,190
.ابتسم أكثر

47
00:02:26,190 --> 00:02:27,580
.لا أستطيع

48
00:02:27,580 --> 00:02:29,180
.لا أستطيع التصرّف كدازاي-سان

49
00:02:29,180 --> 00:02:31,490
.أنت من قال أنّه لا يجب أن يكشف أمرك

50
00:02:31,490 --> 00:02:33,740
أم تريد أن ينتهي بك المطاف مثله؟

51
00:02:33,740 --> 00:02:35,540
.لا، لا أفضّل ذلك

52
00:02:35,540 --> 00:02:36,990
.أخيف نفسي

53
00:02:37,280 --> 00:02:39,330
.رامبو-سان يتصرّف وفق طبيعته أيضًا

54
00:02:39,330 --> 00:02:41,500
.رؤية كونيكيدا-كن هكذا تخيفني

55
00:02:41,940 --> 00:02:44,780
لمَ لا تعودوا إلى أجسادكم فحسب إذًا؟

56
00:02:44,780 --> 00:02:45,910
يمكنني ذلك؟

57
00:02:45,910 --> 00:02:46,450
!يمكنني؟

58
00:02:46,450 --> 00:02:47,760
سنعود؟

59
00:02:47,940 --> 00:02:51,710
.تبادلتما جسديكما عندما تناطحتما، لذا تناطحا ثانيةً

60
00:02:51,710 --> 00:02:53,030
.بكلّ بساطة

61
00:02:57,210 --> 00:02:58,310
...عذرًا

62
00:02:58,310 --> 00:03:01,220
...أوّلًا، نتبادل أنا وكونيكيدا-سان، ثمّ

63
00:03:01,220 --> 00:03:01,920
.مهلًا

64
00:03:01,920 --> 00:03:03,930
.دازاي، عد لجسدك أوّلًا

65
00:03:03,930 --> 00:03:05,850
.تعرف أنّني لا أحبّ الألم

66
00:03:05,850 --> 00:03:08,040
بدأ هذا يتعقّد؟

67
00:03:10,990 --> 00:03:12,040
.مياو

68
00:03:21,240 --> 00:03:22,560
.وقت الأكل

69
00:03:22,940 --> 00:03:24,080
.إنّه لذيذ

70
00:03:24,080 --> 00:03:24,700
.أجل

71
00:03:25,230 --> 00:03:26,870
.شكرًا على فعل هذا طوال الوقت

72
00:03:26,870 --> 00:03:27,510
.أجل

73
00:03:30,210 --> 00:03:32,560
هل بدأت تعتادين على الوكالة يا كيوكا-تشان؟

74
00:03:32,560 --> 00:03:33,460
.أجل

75
00:03:33,970 --> 00:03:35,410
أهناك ما يزعجك؟

76
00:03:35,410 --> 00:03:36,180
.لا

77
00:03:36,450 --> 00:03:38,200
.لا أستطيع مواصلة محادثة معها

78
00:03:38,450 --> 00:03:39,690
.شكرًا

79
00:03:40,960 --> 00:03:42,450
.كان ذلك لذيذًا

80
00:03:44,740 --> 00:03:47,960
.صباح الخير

81
00:03:47,960 --> 00:03:51,630
.أتساءل إن كنت سأتصرّف هكذا إن كان لديّ أشقّاء

82
00:03:48,380 --> 00:03:49,820
ما الأخبار؟

83
00:03:51,630 --> 00:03:54,550
.أوني-ساما، قميصك ملطّخ

84
00:03:54,550 --> 00:03:57,580
!توقّفي! نـ-نحن في مكان عامّ يا ناومي

85
00:03:57,580 --> 00:03:59,730
.لا أستطيع فعل ذلك

86
00:03:59,730 --> 00:04:01,720
.انظر، لديك بقعة هنا أيضًا

87
00:04:01,720 --> 00:04:02,850
!ناومي

88
00:04:02,850 --> 00:04:04,410
.لا أظنّني سأفعل

89
00:04:07,830 --> 00:04:09,780
.هاناكو اثنان. صباح الخير

90
00:04:11,100 --> 00:04:13,020
.مرحبًا، صباح الخير

91
00:04:13,020 --> 00:04:14,360
.آسف للحديث معك من الأعلى

92
00:04:14,680 --> 00:04:17,810
.طلب منّي كونيكيدا-سان أن أزيل هذه

93
00:04:17,810 --> 00:04:20,360
.لا أستطيع الوصول لها

94
00:04:21,860 --> 00:04:23,110
!مذهل

95
00:04:23,110 --> 00:04:25,360
.فتيات المدينة مبهرات بحقّ

96
00:04:25,360 --> 00:04:26,870
!شكرًا

97
00:04:26,870 --> 00:04:28,980
.لندع الأمر هناك فحسب

98
00:04:33,520 --> 00:04:34,700
.هنا

99
00:04:35,430 --> 00:04:36,140
.خذي

100
00:04:36,320 --> 00:04:40,800
امزجي هذا المسحوق المشبوه في الماء
.واعجنيه، وستحصلين على حلوى السّوشي

101
00:04:40,800 --> 00:04:43,060
!لنصنعها معًا

102
00:04:43,060 --> 00:04:44,130
.لا أدري بشأن هذا

103
00:04:44,350 --> 00:04:46,260
...عجن، عجن، عجن، عجن

104
00:04:46,260 --> 00:04:48,090
...كلّما عجنت

105
00:04:52,460 --> 00:04:54,190
.اجتزت الاختبار

106
00:04:55,600 --> 00:04:56,960
!انتهى

107
00:04:59,960 --> 00:05:03,580
.شكرًا لك أيّها المحقّق الّذي يكشف كلّ شيء

108
00:05:05,670 --> 00:05:07,890
.هذا ليس بجرح حتّى

109
00:05:07,890 --> 00:05:10,570
.لا تخجل، سأصلحه من أجلك

110
00:05:10,570 --> 00:05:13,850
.لا... جرحته بمستندات فحسب

111
00:05:13,850 --> 00:05:14,780
.أنا بخير

112
00:05:14,780 --> 00:05:17,110
.إيّاك والاستهانة بالجراح

113
00:05:17,110 --> 00:05:20,310
.إن تفاقم، قد تضطرّ لبتره في الأخير

114
00:05:20,310 --> 00:05:22,590
.لا تريد أن تصاب بالكزاز

115
00:05:23,640 --> 00:05:25,690
.اعتني به رجاءً

116
00:05:26,280 --> 00:05:27,430
.هكذا أفضل

117
00:05:28,030 --> 00:05:31,820
.أمّ الجميع وطبيبة طيّبة القلب

118
00:05:34,270 --> 00:05:35,560
.ادخلي

119
00:05:36,490 --> 00:05:37,820
.المعذرة

120
00:05:39,200 --> 00:05:40,930
عذرًا، ماذا تحتاج منّي؟

121
00:05:40,930 --> 00:05:42,150
.لا شيء

122
00:05:42,150 --> 00:05:43,450
هل كلّ شيء بخير؟

123
00:05:43,450 --> 00:05:44,350
.أجل

124
00:05:44,350 --> 00:05:45,650
.اعتني بنفسك

125
00:05:45,650 --> 00:05:47,120
.لا تتحاملي على نفسك

126
00:05:47,120 --> 00:05:47,820
.حسنًا

127
00:05:48,080 --> 00:05:51,820
.أبلغيني إن كنت بحاجة لأيّ شيء

128
00:05:52,360 --> 00:05:53,190
.حسنًا

129
00:05:53,580 --> 00:05:55,860
.تلقّيت بعض كعك الأرزّ

130
00:05:55,860 --> 00:05:56,730
أتريدين بعضها؟

131
00:06:00,240 --> 00:06:02,220
.مرحبًا بعودتك يا كيوكا-تشان

132
00:06:07,400 --> 00:06:10,920
مرحبًا يا كيوكا-تشان، كيف تجدين حياة القسم؟

133
00:06:10,920 --> 00:06:13,960
قد يكون ضيّقًا بعض الشّيء على
شخصين، لكنّك اعتدت عليه، أليس كذلك؟

134
00:06:13,960 --> 00:06:16,260
.حتّى أنّ لديك نمر كحارس شخصيّ في النّهاية

135
00:06:16,260 --> 00:06:19,250
.مع أنّ هذا النّمر لا يستطيع التّعامل مع آنسة على الأغلب

136
00:06:19,250 --> 00:06:21,240
!سمعت كلّ شيء

137
00:06:21,240 --> 00:06:22,240
.يا له من شخص غريب

138
00:06:23,510 --> 00:06:24,860
.أنا في مأزق

139
00:06:23,530 --> 00:06:25,900
زميل غرفة؟ حارس؟

140
00:06:24,860 --> 00:06:26,450
!تفعل هذا عمدًا

141
00:06:26,450 --> 00:06:27,490
.على الإطلاق

142
00:06:26,560 --> 00:06:29,070
...لا، إنّه

143
00:06:27,490 --> 00:06:29,010
!تتصرّف بشكل غير منطقيّ

144
00:06:29,010 --> 00:06:29,860
.آسف

145
00:06:29,410 --> 00:06:31,390
...بالنّسبة لي، هو

146
00:06:29,860 --> 00:06:31,570
!أرأيت! عرفتها

147
00:06:32,480 --> 00:06:34,700
...تحديـــق

148
00:06:33,420 --> 00:06:35,980
.مـ-ماذا؟ كيوكا-تشان

149
00:06:37,350 --> 00:06:40,050
.تبدو متألّقًا يا كونيكيدا-كن

150
00:06:40,050 --> 00:06:41,310
.انتهى كلّ شيء

151
00:06:41,310 --> 00:06:43,640
.تعال إن جُرحت ثانيةً

152
00:06:43,640 --> 00:06:45,690
.يجب أن تُفحَص أيضًا

153
00:06:45,690 --> 00:06:47,260
.لا، أعفي نفسي

154
00:06:47,260 --> 00:06:48,670
.إنّه وقت الغداء

155
00:06:48,670 --> 00:06:50,010
.أنا أتضوّر جوعًا

156
00:06:50,010 --> 00:06:52,260
أتريد بعض السّوشي إن كنت جائعًا؟

157
00:06:52,560 --> 00:06:54,010
حقًّا؟

158
00:06:54,010 --> 00:06:54,910
.أكيد

159
00:06:55,390 --> 00:06:57,430
يوم مسالم آخر إذًا؟

160
00:06:57,430 --> 00:07:00,350
.أظنّ أنّ المكان جميل ونابض لوجود مختلف الأشخاص

161
00:07:00,350 --> 00:07:01,650
!هذا كلام بالغ جدًّا

162
00:07:04,130 --> 00:07:06,410
وان! قصص قصيرة

163
00:07:11,810 --> 00:07:14,140
.تـ-تشويا-سان. مرحبًا

164
00:07:14,140 --> 00:07:15,330
كيف حالك؟

165
00:07:15,650 --> 00:07:16,960
!مـ-من أنت بالضّبط؟

166
00:07:21,730 --> 00:07:24,000
.اسمي ناكاجيما أتسوشي

167
00:07:24,000 --> 00:07:28,010
تورّطت في شتّى الحوادث منذ
.انضمامي إلى وكالة التّحقيق المسلّحة

168
00:07:28,010 --> 00:07:31,370
في نفس الوقت، أنا مصدوم بالأشياء
.العديدة الّتي يفعلها دازاي-سان

169
00:07:31,680 --> 00:07:33,670
:لذا، اتّخذتُ قرارًا

170
00:07:33,670 --> 00:07:38,420
أنا، ناكاجيما أتسوشي، سأثبت أنّني
.أستطيع فعل أيّ شيء عندما أعقد عزمي

171
00:07:41,610 --> 00:07:43,470
:خطّتي كالآتي

172
00:07:43,470 --> 00:07:45,530
.افعل شيئًا صادمًا

173
00:07:45,530 --> 00:07:47,310
.فاجئ دازاي-سان

174
00:07:47,730 --> 00:07:51,790
.المشكلة هي أنّني لا أدري ما أفعل بالضّبط

175
00:07:52,630 --> 00:07:53,800
...لنسأل

176
00:07:54,970 --> 00:07:56,070
.هذه مضيعة للوقت

177
00:07:56,260 --> 00:08:00,330
لـ-لكن ألا تريد أن ترى وجه دازاي-سان المتفاجئ؟

178
00:07:57,260 --> 00:07:58,660
!عجبًا

179
00:08:00,530 --> 00:08:03,440
.لا أريد حتّى رؤية وجهه إطلاقًا

180
00:08:04,010 --> 00:08:07,000
لمَ لا تضع بعض السّمّ في طعامه؟

181
00:08:07,000 --> 00:08:08,350
.شيء قويّ حقًّا، رجاءً

182
00:08:09,010 --> 00:08:11,120
ألن يموت؟

183
00:08:11,120 --> 00:08:12,460
.قد يموت فعلًا

184
00:08:12,460 --> 00:08:16,210
.لن تستفيد بشيء من كونيكيدا-كن بطبيعة الحال

185
00:08:16,210 --> 00:08:18,590
هل لديك أيّة أفكار يا رامبو-سان؟

186
00:08:18,590 --> 00:08:21,180
ماذا قد يصدم دازاي-سان؟

187
00:08:21,180 --> 00:08:22,570
.حسنًا

188
00:08:22,570 --> 00:08:25,920
.سأسدي زميلي الأصغر بعض النّصح

189
00:08:25,920 --> 00:08:26,990
!حقًّا؟

190
00:08:27,210 --> 00:08:30,480
الشّيء الّذي قد يصدم دازاي-سان هو
.عدم تفاجئك بما يفعله دازاي-سان

191
00:08:31,440 --> 00:08:33,510
،في تلك الحالة، لن تحبط بعد الآن

192
00:08:33,510 --> 00:08:36,560
.ولن تكون بحاجة لمفاجأة دازاي-سان

193
00:08:36,560 --> 00:08:37,610
...فـ-فهمت

194
00:08:37,830 --> 00:08:40,670
.احظ ببال هادئ، كسطح الماء

195
00:08:40,670 --> 00:08:41,330
.حسنًا

196
00:08:41,330 --> 00:08:42,510
.لكن أشكّ أنّك تستطيع ذلك

197
00:08:43,990 --> 00:08:45,830
.يمكنك أن تشتري لي راموني من أجل رسوم الاستشارة

198
00:08:45,830 --> 00:08:46,860
.خصم خاصّ

199
00:08:46,860 --> 00:08:50,380
.لا أظنّ أنّ ذلك يحلّ أيّ شيء جوهريًّا

200
00:08:50,380 --> 00:08:52,370
.لا تقم بعمل ناقص

201
00:08:52,370 --> 00:08:54,020
.احرص أنّه يكاد يموت

202
00:08:54,020 --> 00:08:55,660
!يـ-يوسانو-سينسي؟

203
00:08:55,660 --> 00:08:58,260
ستثأر من دازاي، أليس كذلك؟

204
00:08:58,260 --> 00:08:59,230
!لا، لن أفعل

205
00:08:59,230 --> 00:09:00,820
.أريد أن أفاجئه فحسب

206
00:09:00,820 --> 00:09:03,110
.سأترك غرفة العلاج شاغرة

207
00:09:04,400 --> 00:09:06,900
.لا أريد الانتقام أو أيّ شيء كذلك

208
00:09:07,170 --> 00:09:09,270
..لكن بالتّفكير في الأمر

209
00:09:10,330 --> 00:09:12,640
،غادرت الميتم

210
00:09:13,270 --> 00:09:18,740
وقابلت دازاي-سان في النّهر، ثمّ
...انضممت إلى وكالة التّحقيق المسلّحة

211
00:09:18,740 --> 00:09:21,280
ماذا أريد أن أفعل له؟

212
00:09:29,620 --> 00:09:30,890
.دازاي-سان

213
00:09:30,890 --> 00:09:32,260
.أتسوشي-كن

214
00:09:32,860 --> 00:09:33,630
...اسمع

215
00:09:33,630 --> 00:09:34,810
ماذا هناك؟

216
00:09:35,090 --> 00:09:36,090
.خذ

217
00:09:36,090 --> 00:09:37,300
.لأجلك

218
00:09:41,150 --> 00:09:43,420
.هذا مقابل كلّ ما فعلته من أجلي

219
00:09:43,750 --> 00:09:45,810
.ليس بالكثير، لكنّها من أجلك

220
00:09:46,090 --> 00:09:48,770
.شكرًا على كلّ شيء يا دازاي-سان

221
00:09:53,040 --> 00:09:53,930
ماذا؟

222
00:09:54,160 --> 00:09:55,240
!نجحت يا أتسوشي

223
00:09:55,240 --> 00:09:56,770
هل فعلتها؟ هل سمّمته؟

224
00:09:57,640 --> 00:09:59,510
.لا بأس بك يا أتسوشي-كن

225
00:10:00,290 --> 00:10:03,030
...لم أفعل أيّ شيء خارج المعتاد

226
00:10:46,740 --> 00:10:49,630
.يوكوهاما مسالمة حقًّا هذه الأيّام

227
00:10:49,630 --> 00:10:52,100
.هذه ثمار أعمالكم

228
00:10:52,100 --> 00:10:54,040
.ليس وكأنّنا فعلنا أيّ شيء

229
00:10:55,240 --> 00:10:57,920
،منذ اليوم الّذي أسّسنا فيه أنا وأنت وكالة التّحقيق المسلّحة

230
00:10:57,920 --> 00:11:02,760
قمنا بزيادة أعدادنا تدريجيًّا ووصلنا
.إلى المجموعة الّتي نحن عليها اليوم

231
00:11:05,090 --> 00:11:08,370
أهكذا يجب أن ننهيه حقًّا؟

232
00:11:08,370 --> 00:11:09,590
لمَ لا؟

233
00:11:09,590 --> 00:11:11,430
.نحن كلاب ضالّة

234
00:11:11,430 --> 00:11:13,620
.جُل بفخر يا بنيّ

235
00:11:13,620 --> 00:11:16,350
.تريد أن تختم بقول مبتذل فحسب

236
00:12:18,510 --> 00:12:19,850
.خلتُ أنّني متّ