1
00:00:22,470 --> 00:00:24,790
تريدني أن أحجز مكانًا لمشاهدة الزّهور؟

2
00:00:25,930 --> 00:00:26,710
.أجل

3
00:00:26,710 --> 00:00:29,230
،أريد أن آخذ الوكالة لمشاهدة الزّهور ثانيةً

4
00:00:29,230 --> 00:00:31,510
.لكنّ المكان القريب يصبح مكتظًّا للغاية

5
00:00:31,510 --> 00:00:32,380
هلّا فعلت ذلك؟

6
00:00:32,380 --> 00:00:33,130
.أكيد

7
00:00:33,130 --> 00:00:35,110
.سأجد لنا مكانًا جيّدًا

8
00:00:35,110 --> 00:00:36,170
.ممتاز. شكرًا

9
00:00:36,490 --> 00:00:38,240
.سأتحمّل إلى أن يذبل جسدي

10
00:00:38,240 --> 00:00:39,390
.هذا متجهّم

11
00:00:43,270 --> 00:00:46,310
.أتيت إلى هنا مبكّرًا لأقوم بالأمر بشكل صائب

12
00:00:46,310 --> 00:00:48,000
.انظروا إليّ أنا بحدّ من أجل الوكالة

13
00:00:48,000 --> 00:00:50,180
.سأحصل على الكثير من الثّناء على هذا

14
00:00:50,180 --> 00:00:51,640
!أحسنت يا أتسوشي

15
00:00:51,640 --> 00:00:54,220
!شكرًا على عرض الزّهور الجميل يا أتسوشي-كن

16
00:00:52,270 --> 00:00:56,920
!مرحى! مرحى

17
00:00:54,220 --> 00:00:56,530
!أتسوشي-كن هو نجم اليوم

18
00:00:57,030 --> 00:01:00,150
.لكنّه مكتظّ كثيرًا بالفعل

19
00:01:00,520 --> 00:01:02,380
أين المكان الجيّد؟

20
00:01:04,340 --> 00:01:05,630
!كيوكا-تشان؟

21
00:01:06,190 --> 00:01:07,760
لـ-لمَ أنت هنا؟

22
00:01:07,760 --> 00:01:10,960
.سمعت البارحة أنّ علينا حجز مكان لمشاهدة الزّهور

23
00:01:10,960 --> 00:01:13,950
!إذًا، لا بدّ أنّك سمعت أنّ المهمّة موكّلة لي، أليس كذلك؟

24
00:01:13,950 --> 00:01:15,340
.لا بأس

25
00:01:17,020 --> 00:01:19,130
.أنا أجيد الانتظار

26
00:01:19,130 --> 00:01:21,600
!هذا ليس جيّدًا على الإطلاق

27
00:01:22,150 --> 00:01:24,720
بالمناسبة، متى أتيت إلى هنا؟

28
00:01:25,510 --> 00:01:27,100
.مساء البارحة

29
00:01:27,380 --> 00:01:32,600
.سأحصل على الكثير من الثّناء من أجل هذا

30
00:01:33,360 --> 00:01:36,080
.يفترض بي أن أكون الزّميل الأكبر هنا

31
00:01:36,900 --> 00:01:38,160
ما ذلك؟

32
00:01:39,570 --> 00:01:41,690
.أعددت الكثير من الغداء المعلّب

33
00:01:41,690 --> 00:01:42,860
!لمَ هو ممتاز هكذا؟

34
00:01:43,900 --> 00:01:45,460
!برج الطّعام

35
00:01:46,550 --> 00:01:48,010
.برج الطّعام

36
00:01:48,010 --> 00:01:49,750
لمَ تكرّرين قولك؟

37
00:01:50,850 --> 00:01:53,690
—"إنّه تلاعب لفظيّ لـ"برج الإلـ

38
00:01:54,000 --> 00:01:55,860
!حسنًا، مفهوم! توقّفي

39
00:01:57,880 --> 00:01:59,630
.كنت متطلّعة لذلك

40
00:02:03,120 --> 00:02:06,010
.كنت متطلّعة لمشاهدة الزّهور

41
00:02:10,920 --> 00:02:11,990
.كيوكا-تشان

42
00:02:13,250 --> 00:02:14,410
.شكرًا

43
00:02:16,230 --> 00:02:21,720
في ذلك اليوم، استمتعنا بمشاهدة
.الزّهور لفترة، قبل مجيء البقيّة

44
00:02:28,860 --> 00:02:32,250
!لمَ علينا أن نجلس بجانب هؤلاء؟

45
00:02:32,250 --> 00:02:35,160
.إنّها مسألة بالفعل

46
00:02:35,160 --> 00:02:38,080
.لا سيّما عندما أرى كيوكا تحظى بالكثير من المرح

47
00:02:38,080 --> 00:02:41,160
.عزيزتي كيوكا

48
00:02:41,850 --> 00:02:44,900
!كيوكا، ألذّ وجبة خفيفة على الإطلاق

49
00:02:44,900 --> 00:02:47,690
.تبًّا، فقدت صوابها تمامًا

50
00:02:48,440 --> 00:02:51,350
!أنت من حجز مكاننا، أليس كذلك؟

51
00:02:51,350 --> 00:02:54,180
!أ-أنا آسف! لم أعرف

52
00:02:54,180 --> 00:02:58,210
مع أنّني ظننتُ أنّي سمعتُ أحدًا
"!يقول "دازاي-سان! دازاي-سان

53
00:02:58,210 --> 00:02:59,700
!هذه هبة ميّتة

54
00:02:59,700 --> 00:03:03,950
.سحقًا، هذا الوغد الخبيث سيفسد شرابي

55
00:03:03,950 --> 00:03:04,690
.أجل

56
00:03:04,690 --> 00:03:07,270
.لا تحتمل الشّراب بتاتًا

57
00:03:07,270 --> 00:03:08,740
ماذا؟! ماذا قلت؟

58
00:03:08,740 --> 00:03:09,710
!يمكنني أن أشرب

59
00:03:10,590 --> 00:03:13,060
لمَ تشاهد الزّهور على أيّ حال؟

60
00:03:13,060 --> 00:03:15,920
!حيثما أذهب ليس من شأنك

61
00:03:13,900 --> 00:03:16,730
!ستتحوّل رحلة مشاهدة الزّهور إلى حرب

62
00:03:16,730 --> 00:03:18,770
!افعلي شيئًا رجاءً

63
00:03:16,730 --> 00:03:20,330
!اليوم هو اليوم الّذي أقتلك فيه يا دازاي! واجهني

64
00:03:20,700 --> 00:03:22,720
...ا-المعذرة

65
00:03:23,690 --> 00:03:26,710
،بـ-بما أنّنا هنا جميعًا لمشاهدة الزّهور

66
00:03:26,710 --> 00:03:30,940
لمَ لا نجعله حدثًا مشتركًا بين الوكالة ومافيا الميناء؟

67
00:03:30,940 --> 00:03:32,500
.أمزح فحسب

68
00:03:33,040 --> 00:03:34,210
!مهلًا لحظة

69
00:03:34,210 --> 00:03:36,310
!يبدو أكوتاغاوا-سان سعيدًا

70
00:03:36,310 --> 00:03:37,320
!مهلًا

71
00:03:37,720 --> 00:03:40,230
!من قد يريد حدثًا مشتركًا مع هذا؟

72
00:03:40,710 --> 00:03:42,930
!سنخرج من هنا

73
00:03:42,930 --> 00:03:45,230
!إنّه مستاء بشكل صارخ

74
00:03:45,530 --> 00:03:47,530
!احزموا الآن

75
00:03:48,980 --> 00:03:50,560
!سنذهب

76
00:03:55,140 --> 00:03:57,780
!أُغمي على تشويا-سان

77
00:03:57,780 --> 00:04:00,120
.لا بدّ أنّه كان يستمتع بوقته

78
00:04:00,420 --> 00:04:03,660
.لدينا بعض الهدوء أخيرًا

79
00:04:03,660 --> 00:04:07,370
ما رأيكم أن نستمتع بمأدبتنا على شرف أزهار الكرز؟

80
00:04:08,910 --> 00:04:10,860
.بربّك

81
00:04:15,510 --> 00:04:18,450
.وهكذا استمرّت الحفلة

82
00:04:28,970 --> 00:04:32,070
،بعد أن أصبح خمار ناكاهارا تشويا مؤكّدًا

83
00:04:32,070 --> 00:04:33,770
!سينباي

84
00:04:33,770 --> 00:04:34,650
!اخرسي يا إيتشيو

85
00:04:34,660 --> 00:04:37,270
.احتفلنا طوال اللّيل

86
00:04:39,710 --> 00:04:42,340
.وان! قصص قصيرة

87
00:04:45,760 --> 00:04:47,630
!علينا أن نوقفهما بسرعة

88
00:04:47,630 --> 00:04:49,300
!كيوكا-تشان، لنوقفهما معًا

89
00:04:49,300 --> 00:04:50,620
لكن كيف؟

90
00:04:50,620 --> 00:04:54,080
سمعت أنّه يمكن فضّ الشّجار بين
.الحيوانات البريّة عبر حجب رؤيتها

91
00:04:54,080 --> 00:04:55,480
أهذا كلّ ما يتطلّب؟

92
00:05:00,210 --> 00:05:01,450
.جميل

93
00:05:07,870 --> 00:05:11,340
،انكسر حوض استحمام الوكالة

94
00:05:11,340 --> 00:05:13,510
.ما دفع الأعضاء للذّهاب إلى الحمّامات العموميّة

95
00:05:13,510 --> 00:05:14,620
!يا له من تفسير سيّئ

96
00:05:18,780 --> 00:05:22,000
أهي فكرة جيّدة حقًّا أن نذهب كلّنا إلى الحمّام معًا؟

97
00:05:22,000 --> 00:05:24,900
.ثمّة شيء علينا أن نعمل سويًّا على إيقافه

98
00:05:24,900 --> 00:05:26,740
أكانت هناك حادثة أو ما شابه؟

99
00:05:28,390 --> 00:05:30,720
!مرحى! وقت الاستحمام في الحمّامات الكبيرة

100
00:05:30,720 --> 00:05:32,590
!هذا ما علينا إيقافه

101
00:05:32,590 --> 00:05:35,780
يا كينجي-كن، هل تريد أن نقوم بسباق زحف في الأحواض؟

102
00:05:35,780 --> 00:05:37,700
.يبدو ذلك رائعًا. لنفعل

103
00:05:37,700 --> 00:05:38,410
!كينجي-كن

104
00:05:37,700 --> 00:05:38,410
!كينجي

105
00:05:38,650 --> 00:05:41,040
.نحن هنا لإيقاف رامبو-سان

106
00:05:41,040 --> 00:05:42,520
.أجل

107
00:05:42,520 --> 00:05:43,410
.تمالك نفسك

108
00:05:43,410 --> 00:05:46,270
.يعتبر الزّحف إزعاجًا لباقي الزّبائن

109
00:05:46,270 --> 00:05:47,770
.لا يمكننا فعل ذلك

110
00:05:48,300 --> 00:05:50,610
.لنُجرِ سباقًا في سباحة الصّدر إذًا

111
00:05:50,610 --> 00:05:51,830
.أكيد، يمكننا ذلك

112
00:05:51,830 --> 00:05:52,660
!كينجي-كن

113
00:05:51,830 --> 00:05:52,660
!كينجي

114
00:05:52,660 --> 00:05:54,940
!مرحى

115
00:05:52,850 --> 00:05:54,120
.يا إلهي

116
00:05:54,120 --> 00:05:55,730
ماذا نفعل مع زملائنا الأكبر؟

117
00:05:55,730 --> 00:05:56,740
أليس كذلك يا كيوكا-تشان؟

118
00:05:57,600 --> 00:06:00,320
هل تنوي كيوكا-تشان اللّعب في أحواض الاستحمام أيضًا؟

119
00:06:00,320 --> 00:06:03,160
.بمثابتي زميلها الأكبر، عليّ أن أحذّرها

120
00:06:03,160 --> 00:06:04,990
.أعطاني رامبو-سان هذه

121
00:06:05,910 --> 00:06:08,640
.سننفصل إلى حمّامات رجاليّة ونسائيّة

122
00:06:08,640 --> 00:06:10,000
.كم هذا محزن

123
00:06:10,000 --> 00:06:13,070
.أريد أن أذهب معك يا أوني-ساما

124
00:06:13,070 --> 00:06:14,430
.هـ-هذا ليس خيارًا يا ناومي

125
00:06:15,150 --> 00:06:20,240
.في تلك الحالة، عليك أن تأتي معي إلى الحمّام النّسائيّ

126
00:06:20,240 --> 00:06:21,560
!هـ-هذا أسوأ حتّى

127
00:06:21,560 --> 00:06:22,320
!لا

128
00:06:22,320 --> 00:06:24,290
!علاج الوقوف باليدين في حوض الاستحمام

129
00:06:24,650 --> 00:06:27,510
.الوقوف على يديك في حوض الاستحمام يحسّن من صحّتك

130
00:06:28,230 --> 00:06:29,480
!لا تهزأ يا دازاي

131
00:06:29,480 --> 00:06:30,560
!كفّ عن مضايقتي بالهراء

132
00:06:30,560 --> 00:06:33,150
!علاج الانتحار غرقًا في الحمّام السّاخن

133
00:06:33,560 --> 00:06:36,450
.ارتكاب الانتحار غرقًا في الحمّام السّاخن يحسّن من صحّتك

134
00:06:37,300 --> 00:06:38,130
!لا تهزأ يا دازاي

135
00:06:38,130 --> 00:06:39,260
!ستموت

136
00:06:39,260 --> 00:06:41,350
!علاج الحمّام البارد في السّاونا

137
00:06:41,350 --> 00:06:44,760
!التّغيير بين السّاونا والحمّام البارد يحسّن من صحّتك

138
00:06:45,450 --> 00:06:46,510
!لا تهزأ

139
00:06:46,510 --> 00:06:48,500
!يستحيل أنّ هذا العلاج موجود

140
00:06:48,500 --> 00:06:49,390
.بلى

141
00:06:50,910 --> 00:06:51,800
حقًّا؟

142
00:06:52,780 --> 00:06:53,760
.لا أدري

143
00:06:53,760 --> 00:06:54,790
...أنت

144
00:06:56,840 --> 00:06:58,530
ألم تحضر أيّ شيء يا دازاي؟

145
00:06:58,530 --> 00:07:00,710
.سؤال وجيه يا أتسوشي-كن

146
00:07:00,710 --> 00:07:02,720
.أخطّط لاستعارة كلّ شيء

147
00:07:01,870 --> 00:07:03,770
.لا أملك ما أعيرك

148
00:07:04,320 --> 00:07:08,840
!لا تغضب منّي يا كونيكيدا-كن

149
00:07:06,950 --> 00:07:08,840
.إليك عنّي. أنت مزعج

150
00:07:08,840 --> 00:07:09,460
...عذرًا

151
00:07:09,460 --> 00:07:11,510
هل تودّ استعارة خاصّتي؟

152
00:07:11,960 --> 00:07:14,110
!شكرًا لك يا أتسوشي-كن

153
00:07:14,110 --> 00:07:14,870
...لكن

154
00:07:15,520 --> 00:07:18,910
.أغسل جسدي بقطعة صابون فقط، بما في ذلك شعري

155
00:07:18,910 --> 00:07:20,670
.هكذا كنّا نفعل في الميتم

156
00:07:21,180 --> 00:07:24,090
.تكون جامحًا جدًّا أحيانًا

157
00:07:25,670 --> 00:07:27,110
.أظنّني سأمتنع

158
00:07:31,400 --> 00:07:34,840
،بعد انكسار حوض الاستحمام في مقرّ مافيا الميناء

159
00:07:34,840 --> 00:07:38,570
باتت الطّريقة الوحيدة للاستحمام
.هيّ الذّهاب إلى الحمّامات العموميّة

160
00:07:38,570 --> 00:07:40,720
!كيف يختلف ذلك عن الوكالة؟

161
00:07:41,460 --> 00:07:44,070
.لا أمانع

162
00:07:44,070 --> 00:07:47,420
.من الجيّد الاستحمام من حين لآخر في حمّام كبير

163
00:07:47,420 --> 00:07:49,130
أليس كذلك يا إليس-تشان؟

164
00:07:49,780 --> 00:07:52,110
،هذا ما قاله الزّعيم على الأقلّ

165
00:07:52,110 --> 00:07:55,340
.لكن يستحيل أن تدخل المافيا حمّامًا عموميًّا بكلّ بساطة

166
00:07:55,340 --> 00:07:55,920
أليس كذلك؟

167
00:07:59,190 --> 00:08:02,430
...فقط لو أنّ تشويا-سان كان معنا

168
00:08:03,260 --> 00:08:04,950
هل أنت هنا؟

169
00:08:04,950 --> 00:08:07,330
...أقصد، بقدرتك

170
00:08:08,480 --> 00:08:10,880
!القدرة الخاصّة: وزن الجسد المثاليّ

171
00:08:11,210 --> 00:08:13,800
.يمكنني التحكّم بوزن جسدي كما أشاء

172
00:08:14,260 --> 00:08:18,300
.لكن، أحتاج منك أن تأتي معي إلى حمّام النّساء لفعل ذلك

173
00:08:18,300 --> 00:08:19,600
هل أنت حمقاء؟

174
00:08:19,890 --> 00:08:21,620
.أمزح

175
00:08:22,190 --> 00:08:23,740
الحمّام؟

176
00:08:23,740 --> 00:08:27,720
.ما دام ذلك الأهوج غير موجود

177
00:08:28,160 --> 00:08:29,550
.أظنّني سأذهب

178
00:08:29,550 --> 00:08:33,100
.تشويا-سان، نسيت قبّعة الاستحمام خاصّتك

179
00:08:33,100 --> 00:08:34,620
عمّاذا تتحدّثين؟

180
00:08:35,360 --> 00:08:35,910
.هكذا

181
00:08:35,910 --> 00:08:37,110
.قبّعتك الفاخرة

182
00:08:38,960 --> 00:08:40,570
.تبدو بمظهر رائع

183
00:08:40,570 --> 00:08:41,460
!سحقًا لك

184
00:08:41,920 --> 00:08:43,000
!لا أحتاج إلى هذه

185
00:08:43,000 --> 00:08:44,730
...وبالنّسبة لك يا أكوتاغاوا-سينباي

186
00:08:44,730 --> 00:08:45,120
.سعال

187
00:08:45,640 --> 00:08:47,240
.خذ هذه

188
00:08:48,410 --> 00:08:52,980
.غسول مرطّب وكريم للجسم وزيوت معطّرة ومكمّلات

189
00:08:52,980 --> 00:08:55,220
.واحذر كي لا تصاب بالبرد عندما تخرج

190
00:08:55,220 --> 00:08:55,620
.لا

191
00:08:56,730 --> 00:08:58,630
!سينباي

192
00:08:58,630 --> 00:08:59,150
.لا

193
00:08:59,150 --> 00:09:02,130
!ماذا تقصد بـ"لا"؟

194
00:09:02,580 --> 00:09:04,390
...بالمناسبة، كنت أفكّر

195
00:09:04,390 --> 00:09:07,930
تعرفان كيف أنّ قدرة أكوتاغاوا-سان تجعل معطفه يتغيّر؟

196
00:09:07,930 --> 00:09:11,040
هل تظنّان أنّه سيصبح مفضوحًا للغاية عند الاستحمام؟

197
00:09:17,450 --> 00:09:20,780
!أنتم، كيف تجرؤون؟

198
00:09:20,990 --> 00:09:23,380
.آسف، كنت أمزح فحسب

199
00:09:23,380 --> 00:09:27,080
!أكوتاغاوا-سينباي قويّ، حتّى إن كان عاريًا

200
00:09:27,080 --> 00:09:31,610
!حتّى إن كان عاريًا

201
00:09:31,960 --> 00:09:35,200
.لـ-لنتوقّف قبل أن نقع في المشاكل

202
00:09:39,590 --> 00:09:44,020
.أنا هنا مع غين، لكن أتساءل إن كانت امرأة حقًّا

203
00:09:45,230 --> 00:09:47,300
.يجب أن أتأكّد بأمّ عينيّ

204
00:09:50,210 --> 00:09:52,630
هل نتبادل؟

205
00:09:56,800 --> 00:10:02,330
!إنّها فتاة

206
00:09:58,200 --> 00:09:59,250
!أكثر ممّا كنتُ أريدها أن تكون

207
00:10:10,250 --> 00:10:11,760
!علينا أن نوقفهما

208
00:10:11,760 --> 00:10:14,560
.يا أكوتاغاوا، دعنا نأخذ زميلينا الأكبر إلى البيت

209
00:10:14,560 --> 00:10:17,840
.لستَ زميل دازاي-سان الأصغر

210
00:10:17,840 --> 00:10:20,640
!هذا لا يهمّ! علينا أن نوقفهما

211
00:10:20,640 --> 00:10:21,810
!بل يهمّ

212
00:10:22,720 --> 00:10:23,850
.سأعود إلى البيت