1
00:00:19,580 --> 00:00:21,890
.انظر إلى كلّ زينتك

2
00:00:21,890 --> 00:00:23,380
هل تظنّ أنّك تبدو رائعًا؟

3
00:00:23,990 --> 00:00:27,490
وهل تظنّ أنّك تبدو رائعًا وأنت مغلّف بكلّ تلك الضمّادات؟

4
00:00:30,830 --> 00:00:32,700
.إنّه شرس للغاية

5
00:00:33,130 --> 00:00:36,620
هل ترتدي رقعة العين للضّرورة حقًّا؟
أم أنّك تبتغي الانتباه بشدّة؟

6
00:00:37,550 --> 00:00:40,360
.أعاني من ودقة

7
00:00:41,570 --> 00:00:44,020
.قمت بحكّ عيني بيديّ المتّسختين

8
00:00:44,020 --> 00:00:46,220
!هذا قذر! اغسل يديك

9
00:00:46,430 --> 00:00:50,140
و-وماذا إذًا؟ هل ترتدي ضمّادات
حول جسدك بسبب جرح كبير أيضًا؟

10
00:00:50,480 --> 00:00:53,880
.كلّا، هذه لكبح قواي

11
00:00:53,880 --> 00:00:55,640
.تفعل هذا إذًا

12
00:00:55,900 --> 00:00:58,930
.تبًّا، جعلتني أقلق

13
00:00:56,070 --> 00:00:59,160
.أنا إعادة تجسيد لساحر من ردحٍ طويل

14
00:00:59,160 --> 00:01:02,600
،أملك ميثاقًا مع عنصر النّار والرّيح والماء والضّوء والظّلام

15
00:01:02,600 --> 00:01:07,550
.ما يخوّل لي التّحكّم بكلّ هذه العناصر كما أشاء

16
00:01:07,550 --> 00:01:09,080
.حقًّا؟ مذهل

17
00:01:09,080 --> 00:01:11,420
.في الواقع، هذا مقلق نوعًا ما

18
00:01:11,420 --> 00:01:16,920
.وهذه قناة أستطيع من خلالها توجيه قوّة الأثير اللّامتناهية

19
00:01:17,320 --> 00:01:21,940
.وهذه التّعويذة الّتي تختم الشّيطان الكامن بداخلي

20
00:01:23,360 --> 00:01:24,290
!هذا سيّئ

21
00:01:24,290 --> 00:01:26,330
!الشّيطان يستيقظ

22
00:01:26,330 --> 00:01:27,870
.هذا كثير

23
00:01:27,870 --> 00:01:29,240
.أنت آخر من يتكلّم

24
00:01:30,020 --> 00:01:32,700
.أنت تتباهى كثيرًا بلا سبب

25
00:01:32,700 --> 00:01:34,950
هل تعوّض عن قامتك؟

26
00:01:34,950 --> 00:01:37,860
!اخرس

27
00:01:38,300 --> 00:01:39,320
.لا يهمّ

28
00:01:39,720 --> 00:01:41,070
.دعني أريك

29
00:01:41,590 --> 00:01:46,090
معدّات مصنوعة حسب الطّلب، تزن كلّ منها
!عشرين كيلوغرامًا، ومجموع وزنها ثمانين كيلوغرامًا

30
00:01:46,090 --> 00:01:47,070
.وثمّة المزيد

31
00:01:47,290 --> 00:01:49,640
،إن نزعتُ حذائيّ، كلّ منهما يزن خمسين كيلوغرام

32
00:01:49,640 --> 00:01:51,590
!يمكنني التحرّك بأربعة أضعاف سرعتي العاديّة

33
00:01:51,920 --> 00:01:54,960
أبدو كأربعة أشخاص لك، أليس كذلك؟

34
00:01:55,290 --> 00:01:56,580
.واجهني يا دازاي

35
00:01:56,580 --> 00:01:58,130
!أشعر بخفّة كبيرة

36
00:01:58,130 --> 00:01:59,630
.حقًّا؟ طوبى لك

37
00:01:59,630 --> 00:02:00,380
!أنت

38
00:02:00,380 --> 00:02:02,590
!ألا تظنّ أنّني رائع؟

39
00:02:02,590 --> 00:02:03,630
!أهذا هذا حلم كلّ صبيّ؟

40
00:02:03,630 --> 00:02:06,740
.هذا خانق جدًّا بالنّسبة لي

41
00:02:06,740 --> 00:02:08,260
.أفضّل قراءة الكتب

42
00:02:08,260 --> 00:02:09,680
إحدى "تلك" الكتب؟

43
00:02:09,950 --> 00:02:14,130
عقلي نشط أكثر من السّابق لأنّني أمضي
.الكثير من وقتي في الدّراسة مؤّخرًا

44
00:02:14,130 --> 00:02:16,640
.إنّه الوقت الأمثل لقراءة الكتب المتطوّرة والمعقّدة

45
00:02:16,640 --> 00:02:18,710
.أقررت للتّوّ أنّك لا تفهمها

46
00:02:18,980 --> 00:02:21,200
.خذ، يمكنك الاحتفاظ بهذه

47
00:02:21,430 --> 00:02:23,460
.بئسًا، هذا صعب

48
00:02:23,460 --> 00:02:27,040
.لم أعلم أنّ دازاي كان يفعل مثل هذه الأشياء أيضًا

49
00:02:27,040 --> 00:02:28,460
...لنرَ

50
00:02:28,460 --> 00:02:31,660
.ومرّة أخرى، يأبى تشويا أن يغرب عن وجهي اليوم"

51
00:02:31,660 --> 00:02:33,220
.يا ليته يغرب عن وجهي

52
00:02:33,220 --> 00:02:38,340
".بصراحة، لا أريد أن أشيح بناظري أوّلًا

53
00:02:38,600 --> 00:02:39,850
ما هذه؟

54
00:02:39,850 --> 00:02:42,220
.مفكّرة عن شكاويّ عنك

55
00:02:42,220 --> 00:02:43,210
.هذا أكثر من هوس

56
00:02:43,210 --> 00:02:45,990
.كما أملك 26 مجلّدًا آخر في البيت

57
00:02:45,990 --> 00:02:48,110
!يمكنك الاشتكاء في وجهي فحسب

58
00:02:48,230 --> 00:02:52,040
".وضع تشويا اللّيمون على الكاراغي دون إذن. حياتي بائسة"

59
00:02:52,040 --> 00:02:53,100
!يا للشّفقة

60
00:02:57,110 --> 00:02:58,390
!ما همّك؟

61
00:02:58,670 --> 00:03:02,010
!ستندم على هذا عندما أصبح أطول

62
00:03:02,010 --> 00:03:05,160
ماذا؟ أليس هذا مجرّد افتراض عن وضع مستحيل؟

63
00:03:05,390 --> 00:03:07,320
.يكفي أنتما الاثنان

64
00:03:07,320 --> 00:03:09,150
أنتما صديقان صدوقان بحقّ، أليس كذلك؟

65
00:03:09,150 --> 00:03:10,790
!كلّا، لسنا كذلك

66
00:03:11,430 --> 00:03:12,580
...موري-سينسي

67
00:03:12,580 --> 00:03:14,210
...راندو-سينسي

68
00:03:14,610 --> 00:03:16,940
هل تشعر بالبرد يا راندو-سينسي؟

69
00:03:16,940 --> 00:03:22,200
...أسلوب شجارهما ينمّ عن طالبين من الإعداديّة حقًّا

70
00:03:22,200 --> 00:03:25,490
.من المحرج مشاهدة ذلك

71
00:03:25,970 --> 00:03:27,880
...يصيبانني بالقشعريرة

72
00:03:27,880 --> 00:03:29,540
!هل كنتما تشاهدان طوال هذا الوقت؟

73
00:03:29,540 --> 00:03:30,650
!هذا مريب جدًّا

74
00:03:30,650 --> 00:03:32,720
.اهدأ يا تشويا-كن

75
00:03:32,720 --> 00:03:34,570
،إن كنت تريد أن تصبح أطول

76
00:03:34,570 --> 00:03:37,370
.سأزيل وتر عرقوبك وأمدّدك

77
00:03:37,370 --> 00:03:39,040
عمّاذا يتحدّث هذا الطّبيب؟

78
00:03:39,340 --> 00:03:41,200
.وأنت أيضًا يا دازاي-كن

79
00:03:41,200 --> 00:03:43,170
.سأعطيك غطاء الأذنين هذا

80
00:03:43,170 --> 00:03:44,170
.لا، شكرًا

81
00:03:44,170 --> 00:03:45,610
.حمدًا لله

82
00:03:45,610 --> 00:03:49,160
.بدونها، أشعر ببرد قارس في أذنيّ لدرجة أنّهما تكادان تسقطان

83
00:03:49,160 --> 00:03:50,780
لمَ عرضته عليّ إذًا؟

84
00:03:51,010 --> 00:03:54,100
.رنّ جرس المدرسة قبل فترة بالفعل

85
00:03:54,440 --> 00:03:56,270
.ينبغي لكما أن تذهبا للفصل

86
00:03:56,270 --> 00:03:58,440
.ستتناولان البودينغ على الغداء اليوم

87
00:03:59,810 --> 00:04:01,260
.اذهبا الآن

88
00:04:03,400 --> 00:04:06,000
موري-سينسي، هل تعتقد حقًّا أنّ ذلكما الاثنين

89
00:04:06,000 --> 00:04:08,380
سيحافظان على السّلام بينهما حتّى وقت الغداء؟

90
00:04:09,210 --> 00:04:11,880
.ربّما لستُ ملائمًا كمعلّم

91
00:04:17,530 --> 00:04:19,310
.كنتُ منتظرًا اليوم كلّه من أجل هذا البودينغ

92
00:04:19,310 --> 00:04:21,750
.سأذهب للسّطح وأستمتع به مع النّسيم

93
00:04:23,680 --> 00:04:25,740
!أيّها الوغد! حاذر خطاك

94
00:04:25,740 --> 00:04:27,190
!أنت من اصطدم بي

95
00:04:27,190 --> 00:04:28,850
!هذا خطؤك لا خطئي

96
00:04:27,790 --> 00:04:30,270
،ربّما إن تجادلت بهذه القوّة

97
00:04:28,850 --> 00:04:31,710
!كنت سأذهب لأكله في السّطح

98
00:04:30,270 --> 00:04:34,290
.سترتفع درجة حرارة جسدك، وستُعالج من القشعريرة

99
00:04:31,710 --> 00:04:34,320
!كانت تلك خطّتي! كفّ عن تقليدي

100
00:04:34,290 --> 00:04:38,040
.أقدّر نصيحتك، لكنّي سأرفض

101
00:04:45,260 --> 00:04:48,070
.يا إلهي، هذا النّبيذ باهظ

102
00:04:48,070 --> 00:04:51,840
.لا أفهم لمَ قد يصرف أحد كلّ هذا المال على شراب

103
00:04:52,290 --> 00:04:54,910
،أحبذ بعض الشّراب الطّيّب

104
00:04:54,910 --> 00:04:58,580
.لكنّ لا شراب يضاهي الشّراب الّذي تحتسيه بصحبة حسناء

105
00:04:59,350 --> 00:05:01,830
.اليوم هو يوم مناسب للتسوّق

106
00:05:01,830 --> 00:05:03,630
أين أذهب؟

107
00:05:04,500 --> 00:05:06,980
خصم على الضمّادات؟

108
00:05:06,980 --> 00:05:08,770
.يا للسّخف

109
00:05:08,770 --> 00:05:11,610
ما حاجتك للضمّادات أساسًا إن لم تكن جريحًا؟

110
00:05:11,860 --> 00:05:15,260
.فقط الجبان يشتري مثل هذه الأشياء

111
00:05:15,260 --> 00:05:16,380
.مثير للشّفقة

112
00:05:17,030 --> 00:05:19,860
.هذا ليس ما أريد

113
00:05:23,130 --> 00:05:25,730
.يا له من تصميم سخيف لقبّعة

114
00:05:25,730 --> 00:05:27,150
من عساه يشتريها؟

115
00:05:27,530 --> 00:05:30,320
لا أظنّني أستطيع كبح الضّحك

116
00:05:30,320 --> 00:05:32,880
.إن سار شخص أمامي وهو يرتدي إحدى هذه

117
00:05:32,880 --> 00:05:35,220
.آمل أنّي لن أقابل شخصًا كهذا

118
00:05:40,010 --> 00:05:43,580
عشرة مسترد حديثة الولادة"

119
00:05:43,580 --> 00:05:45,520
".تبحث عن بيت

120
00:05:45,520 --> 00:05:47,560
تبنّي الجراء؟

121
00:05:47,560 --> 00:05:51,660
.لو أنّي أستطيع لتبنّيت تسعة منها

122
00:05:51,660 --> 00:05:54,120
.لكنّي لست واثقًا من الأخير

123
00:05:59,840 --> 00:06:02,350
عشرة مسترد حديثة الولادة"

124
00:06:02,350 --> 00:06:04,800
."تبحث عن بيت

125
00:06:06,450 --> 00:06:10,800
.لا أريد الاعتناء بكلب وإن كان مقابل راتب

126
00:06:11,060 --> 00:06:13,310
.لكنّ الأخير يبدو ظريفًا

127
00:06:15,760 --> 00:06:16,560
!انظر

128
00:06:16,560 --> 00:06:18,390
!أحتاج لهذه

129
00:06:18,390 --> 00:06:19,790
!إنّها رخيصة جدًّا

130
00:06:19,790 --> 00:06:21,450
!سأشتريها كلّها! أجل

131
00:06:21,810 --> 00:06:26,580
.يا إلهي، أزدري أيّ أحد مرّ منها ولم يشتريها

132
00:06:29,290 --> 00:06:30,900
!هـ-هذه القبّعات

133
00:06:30,900 --> 00:06:32,170
!يا إلهي

134
00:06:32,170 --> 00:06:34,180
.لم أرَ مثل هذا التّصميم الرّائع قطّ

135
00:06:34,180 --> 00:06:34,820
!سأشتريها

136
00:06:35,090 --> 00:06:37,840
.يمكنني تخيّل كلّ الإطراء

137
00:06:39,770 --> 00:06:41,260
ما ذلك هناك؟

138
00:06:41,260 --> 00:06:43,330
!لطالما أردت أن أتذوّق هذا النّبيذ

139
00:06:43,580 --> 00:06:45,870
!لم أتخيّل أن أجده هنا

140
00:06:45,870 --> 00:06:47,050
.إنّه نادر

141
00:06:47,050 --> 00:06:48,080
!عليّ شراؤه

142
00:06:48,270 --> 00:06:50,980
.كانت هذه رحلة تسوّق جيّدة

143
00:06:50,980 --> 00:06:53,960
.لم أحظ بهكذا يوم مرضٍ منذ فترة

144
00:06:57,010 --> 00:07:00,420
.انظر لكلّ تلك الخردة المبتذلة الّتي اشتراها

145
00:07:00,420 --> 00:07:01,480
.لا يهمّ

146
00:07:01,480 --> 00:07:05,130
.ستشعر بالغيرة إن أخبرتك ما اشتريت اليوم

147
00:07:05,130 --> 00:07:06,670
.سأعفي عنك اليوم

148
00:07:06,670 --> 00:07:08,110
.هذا ما أريد قوله

149
00:07:08,110 --> 00:07:10,780
.ستبكي إن رأيت ما اشتريت

150
00:07:10,780 --> 00:07:11,930
...انظر. أوّلًا

151
00:07:11,930 --> 00:07:12,590
.لستُ مهتمًّا

152
00:07:12,590 --> 00:07:14,230
.يجب أن أقتلك

153
00:07:14,230 --> 00:07:15,810
.لا تتبعني

154
00:07:15,810 --> 00:07:17,240
.اخرس. أنت من يتبعني

155
00:07:19,690 --> 00:07:20,830
!سحقًا

156
00:07:20,830 --> 00:07:22,750
!رأيتها أليس كذلك؟ قل شيئًا

157
00:07:38,970 --> 00:07:42,680
.كانت الولد والجرو معزوفة جيّدة

158
00:07:44,020 --> 00:07:47,550
.التقى ولدٌ بجرو متروك في يوم ممطر

159
00:07:48,070 --> 00:07:51,430
.كبير الاثنان معًا

160
00:07:52,150 --> 00:07:55,290
...الجرو بظرافته الآسرة، ساعد الولد

161
00:07:56,010 --> 00:07:58,750
.كانت رائعة حقًّا

162
00:07:58,750 --> 00:08:01,450
...إن صادفتُ جروًا متروكًا

163
00:08:02,640 --> 00:08:03,460
.نباح

164
00:08:04,390 --> 00:08:05,280
!نباح

165
00:08:05,280 --> 00:08:06,530
هل تحقّقت أمنيّتي؟

166
00:08:07,840 --> 00:08:08,820
.نباح

167
00:08:09,230 --> 00:08:10,780
.إنّه تشويا فحسب

168
00:08:15,290 --> 00:08:16,440
.لم أر شيئًا

169
00:08:16,440 --> 00:08:18,620
.لم أر شيئًا على الإطلاق

170
00:08:30,210 --> 00:08:31,260
.يا إلهي

171
00:08:31,260 --> 00:08:33,490
.لا أصدّق أنّني علقت هكذا

172
00:08:33,490 --> 00:08:35,990
.هذا يعدّ اعتداءً على الحيوان يا تشويا

173
00:08:35,990 --> 00:08:39,430
.ما رأيتُه شيء غريب أكثر منه حيوان

174
00:08:39,430 --> 00:08:41,060
ما مشكلتك؟

175
00:08:41,060 --> 00:08:44,570
.سألتي أتسوشي-كن سابقًا إن كنت لا أحبّ الكلاب

176
00:08:44,570 --> 00:08:46,280
.صحيح أنّها عدوّي اللّدود

177
00:08:46,280 --> 00:08:49,250
.لذا من أجل أن أفهم عقل كلب، حاولتُ أن أصبح كلبًا

178
00:08:49,880 --> 00:08:52,580
.واتّضح أنّ هذا يناسبني أكثر بكثير ممّا توقّعت

179
00:08:52,580 --> 00:08:54,020
.بدوت مرتاحًا للغاية فعلًا

180
00:08:54,020 --> 00:08:57,290
.أفترض أنّني ملائم أكثر لأكون كلبًا ضالًّا

181
00:08:57,290 --> 00:08:59,150
.أريد أن أمزّق أنفك ذاك

182
00:09:01,080 --> 00:09:03,810
.أظنّك مهتمّ بالكلاب أيضًا

183
00:09:03,810 --> 00:09:05,320
هل تريد تبنّي كلبًا؟

184
00:09:05,320 --> 00:09:07,480
مع أنّك ككلب نوعًا ما؟

185
00:09:07,480 --> 00:09:08,890
!ما الّذي ترمي إليه؟

186
00:09:09,310 --> 00:09:13,310
تريد كلبًا مطيعًا يفعل كما يأمره سيّده؟

187
00:09:13,310 --> 00:09:14,540
!فهمت! تبًّا

188
00:09:14,820 --> 00:09:18,510
،لستُ أبحث عن كلب بالخصوص

189
00:09:18,510 --> 00:09:20,990
...لكن إن رأيت كلبًا يرتعش أمامي

190
00:09:20,990 --> 00:09:22,610
.فسأعتني به إلى الأبد

191
00:09:22,610 --> 00:09:24,660
.ذلك الشّيء لا يحدث في الواقع

192
00:09:24,660 --> 00:09:27,210
هل أنت واثق أنّك تستطيع الاعتناء بكلب حقًّا؟

193
00:09:27,210 --> 00:09:28,170
.بالطّبع

194
00:09:28,170 --> 00:09:31,470
!إن كان لديّ كلب فسأطعمه شريحة لحم كلّ يوم

195
00:09:31,470 --> 00:09:33,540
!وسأشتري له أيّ ما يريد

196
00:09:33,760 --> 00:09:36,800
.يا إلهي، سيكون تشويا فظيعًا في الاعتناء بالكلاب

197
00:09:37,160 --> 00:09:38,220
ماذا؟

198
00:09:38,220 --> 00:09:40,540
.لا مهدرة للوقت أكثر من الحديث معك

199
00:09:40,540 --> 00:09:41,300
.وداعًا

200
00:09:41,660 --> 00:09:42,780
.انتظر يا تشويا

201
00:09:42,780 --> 00:09:43,480
ماذا؟

202
00:09:43,870 --> 00:09:47,450
.يمكنك التدرّب على الاعتناء بالكلب معي

203
00:09:47,450 --> 00:09:48,930
هل تريد تبنيّ؟

204
00:09:49,240 --> 00:09:51,230
!تريد لحمًا فحسب

205
00:09:51,490 --> 00:09:53,160
.كلّا، أنا أمزح

206
00:09:53,160 --> 00:09:55,700
.أخشى من فكرة العيش مع كسول مثلك

207
00:09:56,370 --> 00:09:59,510
.على أيّ حال، لا أظنّك مستعدًّا لإيواء كلب بعد

208
00:09:59,510 --> 00:10:00,670
!اخرس

209
00:10:02,510 --> 00:10:04,440
كيف تربّي الجراء"؟"

210
00:10:04,440 --> 00:10:05,870
!ماذا؟

211
00:10:05,870 --> 00:10:07,900
هل من الخاطئ أن أقرأ هذا الكتاب؟

212
00:10:07,900 --> 00:10:09,410
.لم أقل ذلك

213
00:10:39,450 --> 00:10:41,600
ماذا تفعل يا دازاي؟

214
00:10:41,600 --> 00:10:43,620
.تعوّدتُ على أسلوب الحياة هذا نوعًا ما

215
00:10:44,010 --> 00:10:45,440
.بل أدمنتُ عليه