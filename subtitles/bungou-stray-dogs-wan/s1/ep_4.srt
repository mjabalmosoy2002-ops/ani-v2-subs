1
00:00:10,940 --> 00:00:15,300
،نصيحة اتّخاذ الحياة بجدّيّة أقلّ
،الممنوحة لشخص يتّخذ الحياة بجدّيّة

2
00:00:15,300 --> 00:00:19,640
.قد تكون أحيانًا ضروريّة أو غير ضروريّة

3
00:00:33,170 --> 00:00:35,010
!إنّه د-دازاي-سان

4
00:00:35,340 --> 00:00:37,040
.مرحبًا؟ هذا أنا

5
00:00:37,040 --> 00:00:38,270
أكوتاغاوا-كن؟

6
00:00:38,270 --> 00:00:39,740
.جيّد، وصلتُ لك أخيرًا

7
00:00:39,740 --> 00:00:42,810
.ثمّة ما أردت أن أطلبه منك

8
00:00:42,810 --> 00:00:46,520
.من أجلك يا دازاي، أنا مستعدّ للقفز من منطاد

9
00:00:46,520 --> 00:00:49,590
.قولك ذلك لا يبدو كمزحة

10
00:00:49,590 --> 00:00:51,930
هلّا ذهبت للتسوّق من أجلي؟

11
00:00:51,930 --> 00:00:55,040
.لا تقلق. سيكون من السّهل إيجاده، حتّى بالنّسبة لك

12
00:00:55,690 --> 00:00:57,690
!دازاي-سان طلب منّي أن أفعل شيئًا

13
00:00:57,690 --> 00:01:00,360
!دازاي-سان يعتمد عليّ

14
00:01:00,360 --> 00:01:02,120
هل ديك مذكّرة يدويّة؟

15
00:01:02,120 --> 00:01:03,180
...أوّلًا

16
00:01:04,480 --> 00:01:07,870
!سأتمّ هذه المأموريّة

17
00:01:07,870 --> 00:01:09,670
!وإن كلّفتني كلّ شيء

18
00:01:10,760 --> 00:01:11,710
ماذا؟

19
00:01:12,670 --> 00:01:14,650
.أكوتاغاوا-سينباي

20
00:01:14,650 --> 00:01:17,020
.لم أتوقّع مصادفتك هنا

21
00:01:17,020 --> 00:01:18,170
.هيغوتشي

22
00:01:18,170 --> 00:01:19,700
ما تلك الملاحظة؟

23
00:01:19,700 --> 00:01:21,020
أتلك لائحة للتسوّق؟

24
00:01:21,020 --> 00:01:22,940
لمَ تفعل ذلك يا سينباي؟

25
00:01:22,940 --> 00:01:24,560
.سأتسوّق عنك

26
00:01:24,560 --> 00:01:26,060
.يمكنك العودة

27
00:01:26,060 --> 00:01:26,990
!لا تلمسيها

28
00:01:26,990 --> 00:01:28,570
!هذه مأموريّتي

29
00:01:28,570 --> 00:01:29,800
.حـ-حسنًا

30
00:01:29,800 --> 00:01:31,040
.آسفة

31
00:01:31,040 --> 00:01:32,790
مأموريّة؟

32
00:01:42,060 --> 00:01:44,400
أحاديّ؟ مزدوج؟

33
00:01:44,400 --> 00:01:45,470
ما هذا؟

34
00:01:45,810 --> 00:01:47,290
ألا يوجد ثلاثيّ؟

35
00:01:47,700 --> 00:01:49,420
للمستنجآة؟

36
00:01:49,860 --> 00:01:52,410
هل دازاي-سان يستنجي؟

37
00:01:53,270 --> 00:01:56,730
.يجب أن أختار ورقًا يتناسب مع مؤخّرة دازاي-سان

38
00:01:59,850 --> 00:02:01,800
.حسنًا، التّالي

39
00:02:03,340 --> 00:02:04,700
.أكوتاغاوا

40
00:02:04,700 --> 00:02:06,130
.لا شأن لي معك أيّها المستنمر

41
00:02:06,130 --> 00:02:07,380
.انقلع من هنا

42
00:02:07,380 --> 00:02:09,780
.لديّ عمل هنا

43
00:02:09,780 --> 00:02:13,070
.لا أملك وقتًا أضيّعه معك

44
00:02:13,070 --> 00:02:16,810
!اعمل خيرًا لنفسك واغرب عن وجهي

45
00:02:16,810 --> 00:02:19,120
.حسنًا، حسنًا. فهمت

46
00:02:19,120 --> 00:02:20,420
.فهمت. يا إلهي

47
00:02:22,020 --> 00:02:25,330
.أكمل أكوتاغاوا مأموريّته باجتهاد

48
00:02:25,580 --> 00:02:27,680
.يجب أن أختار أكثر حليب طازج

49
00:02:29,020 --> 00:02:31,190
.كان المتجر الآخر أرخص

50
00:02:31,190 --> 00:02:32,260
.لنعد

51
00:02:33,840 --> 00:02:35,890
.ثمّة مكافأة النّقاط في ثلاثة اليوم

52
00:02:36,270 --> 00:02:37,590
لديّ بطاقة عضويّة

53
00:02:37,940 --> 00:02:39,460
.باسم دازاي-سان

54
00:02:40,240 --> 00:02:41,350
...وأيضًا

55
00:02:46,000 --> 00:02:48,980
.أتمّ كلّ مأموريّاته

56
00:02:54,070 --> 00:02:55,370
مرحبًا؟

57
00:02:55,370 --> 00:02:58,070
.هـ-هذا أنا. أكوتاغاوا

58
00:02:58,070 --> 00:03:00,030
.أكملت كلّ شيء حسب التّعليمات

59
00:03:00,030 --> 00:03:02,520
.شكرًا يا صاح! أنت رائع

60
00:03:02,520 --> 00:03:05,360
.فعلت ما كان متوقّعًا فحسب

61
00:03:05,360 --> 00:03:08,990
أخيرًا، هلّا أعطيت تلك الأشياء لأتسوشي-كن؟

62
00:03:10,020 --> 00:03:12,160
.إنّها مؤونة من أجل الوكالة

63
00:03:12,160 --> 00:03:13,280
!شكرًا

64
00:03:18,400 --> 00:03:20,860
.اليوم كارثة

65
00:03:20,860 --> 00:03:23,170
.سحقًا... كلّ هذا خطأ أكوتاغاوا

66
00:03:23,170 --> 00:03:25,180
لمَ عليّ التّعامل مع هذا؟

67
00:03:25,910 --> 00:03:27,190
!ها أنت ذا

68
00:03:27,190 --> 00:03:28,010
!أكوتاغاوا

69
00:03:28,280 --> 00:03:29,630
مـ-ما الّذي...؟

70
00:03:29,630 --> 00:03:31,380
ما كلّ تلك الأغراض؟

71
00:03:31,380 --> 00:03:32,270
...أيّها المستنمر

72
00:03:32,490 --> 00:03:33,970
!كنت أبحث عنك

73
00:03:33,970 --> 00:03:35,860
!إلى أين ذهبت؟

74
00:03:38,890 --> 00:03:42,460
.ماذا؟ غربتُ عن وجهك كما أردت

75
00:03:48,640 --> 00:03:53,380
.أحبّ الأودن بالكاري، لكنّه عدوّ مهلك لهذه القمصان البيض

76
00:03:53,380 --> 00:03:55,810
.سمعت أنّك في مأزق يا أتسوشي-كن

77
00:03:56,310 --> 00:03:59,300
!سأعتني بالأودن بالكاري

78
00:03:59,560 --> 00:04:01,960
!مرحبًا! أنا دازاي أوسامو

79
00:04:01,960 --> 00:04:03,580
.معك حقّ

80
00:04:03,580 --> 00:04:05,610
.أنت ترتدي معطفًا بلون الكاري بالأودن

81
00:04:05,610 --> 00:04:09,300
إذًا، هلّي بزلابيّة الأودن بالكاري هذه؟

82
00:04:10,030 --> 00:04:11,250
.أكيد

83
00:04:11,250 --> 00:04:12,980
هل كنت جائعًا؟

84
00:04:12,980 --> 00:04:14,710
!شكرًا لك

85
00:04:14,710 --> 00:04:16,030
!انتظر رجاءً يا دازاي-سان

86
00:04:16,880 --> 00:04:20,070
!أرجوك لا تتناول أيّ أودن بالكاري أعدّه ذلك المستنمر

87
00:04:20,070 --> 00:04:23,740
!سأتناوله كلّه من أجلك

88
00:04:23,740 --> 00:04:25,750
.ثيابك ليست آمنة أيضًا

89
00:04:25,750 --> 00:04:27,170
كيف صعدت إلى النّافذة أساسًا؟

90
00:04:27,170 --> 00:04:29,120
ألديك أدنى فكرة في أيّ طابق نحن؟

91
00:04:29,420 --> 00:04:30,820
.لذيذ

92
00:04:30,820 --> 00:04:32,160
!دازاي-سان

93
00:04:43,380 --> 00:04:46,600
.يقال أنّ الحمقى والدّخان ينجذبون إلى الأماكن العالية

94
00:04:46,600 --> 00:04:48,960
!مهلًا! سمعت كلامك يا أكوتاغاوا

95
00:04:48,960 --> 00:04:50,750
.سيحصل على بالون

96
00:04:50,750 --> 00:04:53,730
.أعطوني واحدًا في السّوق، لكنّي طيّرته

97
00:04:55,410 --> 00:04:56,620
.تفضّلي

98
00:04:56,620 --> 00:04:57,910
.استعدته

99
00:04:58,660 --> 00:05:01,490
.أترين؟ بالون نمر ظريف

100
00:05:03,200 --> 00:05:04,270
!راشومون

101
00:05:07,750 --> 00:05:10,360
!يا صاح

102
00:05:10,360 --> 00:05:11,870
.لقد أغضبني

103
00:05:11,870 --> 00:05:14,210
!ما أنت؟ صبيّ ذو طباع حادّ؟

104
00:05:14,210 --> 00:05:16,250
وأنت لست كذلك؟

105
00:05:16,620 --> 00:05:17,620
.سحقًا

106
00:05:17,620 --> 00:05:20,390
.من الأفضل لك أن تحافظ على وعدك بألّا تقتُل

107
00:05:20,390 --> 00:05:23,670
.إن نكثته، لن أتحدّاك ثانيةً

108
00:05:23,670 --> 00:05:25,170
.هذا لا يحتسب

109
00:05:27,730 --> 00:05:29,940
...تبًّا يا أكوتاغاوا

110
00:05:29,940 --> 00:05:30,880
...البالون

111
00:05:30,880 --> 00:05:32,450
!نمري

112
00:05:32,450 --> 00:05:33,520
...أقصد

113
00:05:33,980 --> 00:05:36,030
ما خطبه؟

114
00:05:41,200 --> 00:05:42,400
.كوني حذرة

115
00:05:42,650 --> 00:05:44,390
!إنّه لطيف

116
00:05:44,390 --> 00:05:46,530
...لا، لا بدّ أنّ ذلك

117
00:05:50,730 --> 00:05:52,540
.مسيرة نمل

118
00:05:54,060 --> 00:05:56,040
.لن ينتهي هذا على خير

119
00:06:00,200 --> 00:06:02,930
!إنّه يعيد توجيه النّمل بالسّكّر

120
00:06:02,930 --> 00:06:07,550
.لا، لا بدّ أنّ هذا فخّ لإغواء النّمل إلى درب الشّيطان

121
00:06:09,740 --> 00:06:13,110
.زرع زور النّباتات وسقيها وتنميتها

122
00:06:13,110 --> 00:06:15,240
.يجدر بهذا أن يساعد الحشرات في المستقبل

123
00:06:15,650 --> 00:06:17,070
.شيء ما ليس في محلّه

124
00:06:17,510 --> 00:06:21,580
.لا بدّ أنّه ينوي القبض على الحشرات

125
00:06:22,390 --> 00:06:24,070
!بعوضة على يدي

126
00:06:26,890 --> 00:06:28,120
.ما باليد حيلة

127
00:06:28,570 --> 00:06:29,410
.تغذّي

128
00:06:29,410 --> 00:06:32,820
.يبدو أكوتاغاوا وكأنّه يئس من كلّ شيء

129
00:06:33,180 --> 00:06:34,940
،بربّك يا أكوتاغاوا

130
00:06:34,940 --> 00:06:39,070
.عندما نقول "لا يستطيع قتل حتّى حشرة"، فهو ما إلّا تعبير مجازيّ

131
00:06:39,450 --> 00:06:42,830
.مع ذلك، لا بأس إن كان كان سيكون لطيفًا مع الحشرات أيضًا

132
00:06:47,060 --> 00:06:48,130
!أنت

133
00:06:49,550 --> 00:06:51,950
.أنت تبلي بشكل رائع

134
00:06:51,950 --> 00:06:53,450
.اشتريت بعض فطائر لحم الخنزير

135
00:06:53,450 --> 00:06:54,220
.تفضّل

136
00:06:54,530 --> 00:06:55,550
.تناولها

137
00:06:56,030 --> 00:06:57,760
.كنتُ أشكّ فيك نوعًا ما

138
00:06:57,760 --> 00:06:58,630
...أنا

139
00:06:59,220 --> 00:07:00,450
.آسف

140
00:07:01,920 --> 00:07:02,760
!راشومون

141
00:07:03,920 --> 00:07:05,220
!خنزير

142
00:07:05,220 --> 00:07:06,980
!ما خطبك؟

143
00:07:08,870 --> 00:07:11,620
!ما زلت لا أثق بك

144
00:07:16,340 --> 00:07:18,290
.لن تحصل على أيّ من هذا

145
00:07:24,320 --> 00:07:25,730
...دازاي-سان

146
00:07:28,750 --> 00:07:30,640
!وجدته على الأرض

147
00:07:32,580 --> 00:07:34,150
.أريد أن أصبح حلوى خِطميّة

148
00:07:34,150 --> 00:07:35,290
!دازاي-سان

149
00:07:35,690 --> 00:07:37,380
.أفضّل السمورز

150
00:07:38,140 --> 00:07:39,890
!حلوى خِطميّة؟

151
00:07:39,890 --> 00:07:41,110
أيّ تعبير مجازيّ هذا؟

152
00:07:41,110 --> 00:07:44,740
ألا أستطيع فهم عمليّة تفكيره ولو قليلًا؟

153
00:07:45,240 --> 00:07:46,660
.هذا أنت

154
00:07:46,660 --> 00:07:49,260
.أنا أحاول تحقيق حلمي الآن

155
00:07:49,260 --> 00:07:50,200
حلمك؟

156
00:07:50,530 --> 00:07:54,370
.رجلٌ بصمودي سيودّ في الأخير أن يصبح حلوى خطميّة

157
00:07:55,370 --> 00:07:56,590
.فهمت

158
00:07:56,590 --> 00:07:57,380
أترى؟

159
00:07:57,380 --> 00:07:59,340
.بدأتُ أبدو كحلوى خطميّة

160
00:07:59,340 --> 00:08:01,100
.أترى؟ ضغط

161
00:08:01,100 --> 00:08:02,600
.ضغط

162
00:08:04,780 --> 00:08:05,880
!أرى ذلك

163
00:08:05,880 --> 00:08:07,370
!مرحى

164
00:08:07,370 --> 00:08:09,470
!يمكنك أن تصبح أيّ شيء إن حاولت

165
00:08:09,470 --> 00:08:10,700
!ماذا؟ مستحيل

166
00:08:10,700 --> 00:08:12,030
!أكوتاغاوا، أيّها الغبيّ

167
00:08:12,030 --> 00:08:14,490
!لا يتحوّل النّاس إلى حلوى خطميّة

168
00:08:14,710 --> 00:08:16,940
...هذه المناقشة جعلت من الواضح

169
00:08:16,940 --> 00:08:19,360
.أنّ أتسوشي-كن متفوّق عليك بمراحل

170
00:08:19,360 --> 00:08:22,480
!كيف كان ذلك النّقاش أدنى من نقاش مع المستنمر؟

171
00:08:22,730 --> 00:08:25,750
!لا تعرف النّقد

172
00:08:27,530 --> 00:08:28,740
نقد؟

173
00:08:29,060 --> 00:08:32,040
إنّها مهارة مرعبة، تمنح صاحبها القدرة على التّحكّم بالغرفة

174
00:08:32,040 --> 00:08:34,240
.استجابة لاتّخاذ قرار ظرفيّ ذكيّ

175
00:08:34,630 --> 00:08:37,240
.ولهذا أحضرت أتسوشي-كن إلى هنا

176
00:08:37,240 --> 00:08:38,610
!أكوتاغاوا

177
00:08:39,010 --> 00:08:42,180
.أتيت لأنّه وعدني بوجبة خفيفة حلوة

178
00:08:42,180 --> 00:08:44,480
.كنتُ أتحدّث عن نفسي

179
00:08:45,820 --> 00:08:49,190
...بساط نمر حقير، وقح بلا هوادة مع دازاي-سان

180
00:08:49,190 --> 00:08:51,890
!عليّ أن أمزّقه إربًا الآن

181
00:08:53,700 --> 00:08:55,530
!أنت! لم فعلت ذلك؟

182
00:08:55,530 --> 00:08:56,380
!خدعتني

183
00:08:56,690 --> 00:08:58,420
.أنا أتمرّن على النّقد

184
00:08:58,420 --> 00:09:01,260
!كانت تلك طعنة قاتلة أكثر من كونه نقدًا

185
00:09:01,260 --> 00:09:04,970
.أكوتاغاوا-كن يتمرّن على النّقد الآن

186
00:09:04,970 --> 00:09:07,250
أنت تعبث معه ثانيةً، أليس كذلك؟

187
00:09:07,910 --> 00:09:10,850
.ستتورّط في مشاكل على تضييع الوقت ثانيةً

188
00:09:10,850 --> 00:09:12,170
.لست أضيّع الوقت

189
00:09:12,170 --> 00:09:14,460
.بل أندفع نحو هدفي

190
00:09:14,780 --> 00:09:15,780
!راشومون

191
00:09:15,980 --> 00:09:17,380
!توقّف! اللّعنة

192
00:09:17,380 --> 00:09:18,690
!انتقد بكلامك

193
00:09:18,690 --> 00:09:20,490
.جبان

194
00:09:20,490 --> 00:09:21,680
!لن أقتُل

195
00:09:21,680 --> 00:09:23,930
.أنت لا تجيد فعل أيّ شيء عدا القتل

196
00:09:25,030 --> 00:09:27,320
،عندما تنتقد

197
00:09:27,320 --> 00:09:30,180
!"يفترض أن تصفع أحدًا بيدك وتقول "بربّك

198
00:09:30,180 --> 00:09:32,950
.سأحاول أن أصبح كعكة بخاريّة محمّصة هذه المرّة

199
00:09:32,950 --> 00:09:34,940
.كما اختصاص غونما

200
00:09:34,940 --> 00:09:37,540
.سأصبح محمّصًا. اقلبني

201
00:09:37,540 --> 00:09:38,300
.حاضر

202
00:09:38,300 --> 00:09:39,500
.هكذا

203
00:09:39,500 --> 00:09:41,480
.احرص على طبخه بالتّساوي

204
00:09:41,480 --> 00:09:43,810
.ولا تنس صلصة الميسو

205
00:09:43,810 --> 00:09:45,100
!بربّك

206
00:09:46,110 --> 00:09:47,100
!هكذا

207
00:09:47,100 --> 00:09:48,290
!عرفتها

208
00:09:48,290 --> 00:09:50,560
،أكوتاغاوا-كن، الغبيّ طبيعيًّا

209
00:09:50,560 --> 00:09:53,040
!والرّجل المستقيم أتسوشي-كن ذي النّقد الفائق

210
00:09:53,040 --> 00:09:56,320
!ستفوزان أنتما الاثنان بمسابقة كوميديا معًا

211
00:09:56,320 --> 00:09:57,690
!مرحبًا جميعًا

212
00:09:57,690 --> 00:10:00,400
.كنتُ مولعًا بالطّبخ مؤخّرًا

213
00:10:00,400 --> 00:10:02,920
.أفكّر في إعداد شيء من أجلك أيضًا

214
00:10:02,920 --> 00:10:03,960
أهناك ما تريد؟

215
00:10:03,960 --> 00:10:05,840
.لا أملك ما أقوله لك

216
00:10:05,840 --> 00:10:09,010
!يجب أن نتحدّث، وإلّا لن نستطيع إضحاك النّاس

217
00:10:40,200 --> 00:10:43,420
.في الواقع، أنا من جعل ذلكما الاثنين كما هما الآن

218
00:10:44,040 --> 00:10:45,460
!بربّك