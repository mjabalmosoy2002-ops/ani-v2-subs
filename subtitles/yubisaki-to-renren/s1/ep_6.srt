1
00:00:03,310 --> 00:00:06,230
إ... إتسومي-سان

2
00:00:06,230 --> 00:00:09,260
لا مانع إذا كنتُ أنا؟
ما الأشياء الّتي لا مانع لديكِ أن أفعلها؟

3
00:00:10,080 --> 00:00:11,490
كلّ شيء

4
00:00:14,000 --> 00:00:18,790
ماذا تعني تلك القبلة باليدّ؟

5
00:01:51,250 --> 00:01:52,500
يوكي؟

6
00:01:56,200 --> 00:01:57,350
هل أنتِ بخير؟

7
00:01:59,960 --> 00:02:01,190
اهدئي

8
00:02:01,400 --> 00:02:04,280
هاتفي... أين هاتفي؟

9
00:02:04,280 --> 00:02:07,050
!كان في جيبي

10
00:02:09,830 --> 00:02:11,620
...لا

11
00:02:21,350 --> 00:02:23,310
أرتبك كثيراً

12
00:02:23,310 --> 00:02:26,750
...لكن نظراً إلى ما فعلَه للتو

13
00:02:27,910 --> 00:02:31,250
!مفهومه عن المساحة الشّخصيّة معدوم

14
00:02:37,460 --> 00:02:38,510
ماذا؟

15
00:02:39,120 --> 00:02:41,480
أجل

16
00:02:42,450 --> 00:02:43,700
"كلّ شيء"

17
00:02:46,530 --> 00:02:47,770
حقّاً؟

18
00:02:48,280 --> 00:02:51,780
لا بدّ أنّ ذلك وضّح مشاعري له

19
00:02:52,200 --> 00:02:55,180
...إنّه شديد المُلاحظة

20
00:02:56,150 --> 00:02:58,740
!إنّه يحملق بي

21
00:03:17,360 --> 00:03:20,790
حسناً، يعلم غالباً

22
00:03:29,830 --> 00:03:30,940
رأيت؟

23
00:03:32,630 --> 00:03:33,690
...لكن

24
00:03:34,200 --> 00:03:37,960
أنا واثقة بأنّه لا يعرف درجة مشاعري

25
00:03:39,440 --> 00:03:46,470
أو كيف أنّ اكتشاف هذه المشاعر
الموازية للحبّ في داخلي

26
00:03:46,870 --> 00:03:50,890
جعلني أدرك كم كان أمامي الكثير لأتعلّمه

27
00:04:00,210 --> 00:04:01,370
أعلم

28
00:04:01,370 --> 00:04:03,020
أجل، أجل

29
00:04:03,020 --> 00:04:04,890
!لم يكن ينظر

30
00:04:04,890 --> 00:04:06,100
آسف

31
00:04:06,460 --> 00:04:09,630
،حُجِزَت الحانة لحفلة خاصّة اللّيلة

32
00:04:09,630 --> 00:04:10,870
لذا ينبغي أن أذهب باكراً

33
00:04:10,870 --> 00:04:11,680
ماذا؟

34
00:04:11,950 --> 00:04:15,020
أيضاً، سأسافر إلى خارج البلاد
ثانية في يوم الاثنين

35
00:04:16,050 --> 00:04:18,440
سأعود مع نهاية استراحة الرّبيع تقريباً

36
00:04:18,440 --> 00:04:20,110
...هل هذا يعني

37
00:04:20,410 --> 00:04:23,160
سيغيب لمدّة شهر تقريباً؟

38
00:04:24,080 --> 00:04:25,770
...هكذا إذاً

39
00:04:40,720 --> 00:04:42,130
،حالما أعود

40
00:04:42,780 --> 00:04:44,130
سأحرص

41
00:04:44,760 --> 00:04:45,880
على قضاء وقت

42
00:04:46,590 --> 00:04:47,610
معاً

43
00:04:54,790 --> 00:04:56,360
ما الأمر؟

44
00:04:59,480 --> 00:05:01,030
...لماذا"

45
00:05:02,320 --> 00:05:03,910
"...قمتَ قبل قليل بـ"

46
00:05:06,550 --> 00:05:07,910
تذكّرت

47
00:05:13,550 --> 00:05:18,470
علّمتُه ما الّذي يعنيه الرّبت
على الرأس بالإشارة من قبل

48
00:05:35,940 --> 00:05:37,050
صحيح

49
00:05:46,650 --> 00:05:52,180
تنفُّس الهواء المنعش والبارد يهدّئني

50
00:05:52,180 --> 00:05:53,040
ماذا؟

51
00:05:53,310 --> 00:05:55,290
!يوكي

52
00:06:02,200 --> 00:06:03,360
ماذا؟

53
00:06:03,360 --> 00:06:05,050
!ما الأمر؟

54
00:06:05,600 --> 00:06:07,950
،التقينا لفترة قصيرة فقط

55
00:06:07,950 --> 00:06:14,020
لكن أنا سعيدة لأنّه فعلَ لأجلي ما أفكّر
في فعله للنّاس الّذين يهمّني أمرهم

56
00:06:14,550 --> 00:06:16,280
لدرجة أنّني بدأتُ أتحمّس

57
00:06:18,800 --> 00:06:20,560
البرد قارس

58
00:06:21,780 --> 00:06:25,170
قد تتساقط الثّلوجُ قريباً

59
00:06:25,170 --> 00:06:26,400
أوشي-كن؟

60
00:06:27,400 --> 00:06:29,120
أمُّ يوكي

61
00:06:29,120 --> 00:06:30,660
مساء الخير

62
00:06:30,660 --> 00:06:33,150
تمشي مع مينت-تشان؟

63
00:06:33,150 --> 00:06:36,960
،إيزومي وعائلتها في رحلة الآن
لذا أعتني بمينت

64
00:06:36,960 --> 00:06:39,160
إيزومي-تشان المحظوظة

65
00:06:39,630 --> 00:06:41,770
أتشعرين برغبة في قضاء رحلة؟

66
00:06:41,770 --> 00:06:46,670
لا أقصد ذلك. قصدتُ أنّها محظوظة
لأنّ لديها صديق لطيف

67
00:06:46,940 --> 00:06:47,820
...أجل

68
00:06:47,820 --> 00:06:52,070
أنا متأكّدة بأنّ يوكي مُطمئنّة جدّاً
لأنّكما سترتادان نفس الكلّية أيضاً

69
00:06:52,540 --> 00:06:57,180
مع الأسف، لا أظنّ أنّ الشّعور نفسه يراودها

70
00:06:57,180 --> 00:07:02,440
!بل يراودها! وحتّى أنّك تُتقن لغة الإشارة

71
00:07:03,760 --> 00:07:08,170
إذا واجهتْ مشكلة في الكلّية، فأنا موجود

72
00:07:08,170 --> 00:07:08,940
ماذا؟

73
00:07:09,260 --> 00:07:12,550
يمكنكِ دوماً ائتماني عليها

74
00:07:13,230 --> 00:07:14,810
شكراً

75
00:07:15,380 --> 00:07:17,760
هل يوكي-سان بخير في هذه الأيّام؟

76
00:07:17,760 --> 00:07:23,130
راسلَتْني للتو قائلة بأنّها ستقيم
اللّيلة في منزل أحد الأصدقاء

77
00:07:23,130 --> 00:07:23,830
ماذا؟

78
00:07:23,830 --> 00:07:26,410
اتّصلَتْ رين-تشان بي بعد ذلك مباشرة أيضاً

79
00:07:27,310 --> 00:07:32,280
أشعر بأنّها لم تمكث في منزل صديقة
منذ أيّام المدرسة الابتدائيّة

80
00:07:32,930 --> 00:07:36,090
فهمت. وداعاً

81
00:07:36,090 --> 00:07:37,560
!حسناً، تمّ تأمين الحجّة

82
00:07:37,560 --> 00:07:39,140
شكراً يا رين

83
00:07:39,700 --> 00:07:41,600
مستحيل

84
00:07:42,510 --> 00:07:45,560
...في الواقع

85
00:07:45,560 --> 00:07:46,860
ماذا؟

86
00:07:47,640 --> 00:07:52,010
هل تمانعين إعطائي معلومات
الاتّصال بيوكي-سان؟

87
00:07:52,630 --> 00:07:54,360
شكراً لعملك

88
00:07:54,670 --> 00:07:56,060
أنت أيضاً

89
00:07:56,060 --> 00:08:00,620
أنا ممتنٌّ جدّاً لأنّهم اختاروا إقامة
حفلة ما بعد الزّفاف خاصّتهم هنا

90
00:08:01,330 --> 00:08:05,980
يمكن لمثل هذه الحفلات أن تكون
وقتاً مناسباً أيضاً للعلاقات الحميميّة

91
00:08:05,980 --> 00:08:09,130
لكنّك خطفتَ الأضواء. شفقتُ على الشّابّين

92
00:08:10,400 --> 00:08:16,640
هل تتذكّر عندما قلتَ بأنّك لم تكن تبحث
عن حبيبة منذ مدّة ليست ببعيدة؟

93
00:08:17,250 --> 00:08:22,060
.عندما قلتَ ذلك، صدّقتُك تماماً
فأنت تسافر إلى خارج البلاد كثيراً

94
00:08:22,490 --> 00:08:25,400
ستذهب إلى مكان ما في يوم
الاثنين أيضاً، أليس كذلك؟

95
00:08:26,020 --> 00:08:29,530
إتسو، إلى أين توصل الأمور برأيك مع يوكي-تشان؟

96
00:08:31,760 --> 00:08:34,070
لماذا تبدو قلقاً؟

97
00:08:34,070 --> 00:08:36,660
!لأنّك تُقلقني للغاية

98
00:08:36,660 --> 00:08:39,150
كأنّك فقدتَ صوابك يا رجل

99
00:08:39,150 --> 00:08:42,120
فأنت لا تحجز غرفة أبداً قبل
السّفر إلى مكان ما

100
00:08:42,120 --> 00:08:46,080
وأشعر وكأنّك ستسقط في بركان
نشِط ما خارج البلاد وتموت

101
00:08:46,080 --> 00:08:48,200
!لا تنفكّ تزور تلك الأماكن

102
00:08:48,200 --> 00:08:51,090
أجل، البراكين ليسَتْ مُسوّرة
دوماً كما في اليابان

103
00:08:51,090 --> 00:08:52,920
!لا تحاول تشتيتي

104
00:08:53,390 --> 00:08:56,380
!ما هو شعورك تجاه يوكي-تشان؟

105
00:08:56,380 --> 00:08:58,750
أراك مستمتعاً حقّاً بدردشة
عن علاقات عاطفيّة

106
00:08:58,750 --> 00:09:02,680
بالتّأكيد! فأنا أحبُّ قراءة الإشاعات
!عن قصص المشاهير العاطفيّة وما شابه

107
00:09:03,410 --> 00:09:05,990
لكن ليس هذا مقصدي

108
00:09:07,020 --> 00:09:10,580
...هذا رأيي فحسب، لكن

109
00:09:12,690 --> 00:09:14,740
يوكي واضحة وشفّافة تماماً

110
00:09:15,350 --> 00:09:19,370
ولعلّ عدم سماعها أي كلام سيّئ
بحقّها لعِبَ دوراً في ذلك

111
00:09:21,660 --> 00:09:25,450
يكون النّاس عبارة عن كؤوس فارغة في البداية

112
00:09:26,010 --> 00:09:31,930
والآخرون إمّا يشوّهونهم أو يساهمون في تلميعهم

113
00:09:33,200 --> 00:09:40,020
ارتأيتُ بأنّني أريد أن أراقبها للأبد

114
00:09:40,540 --> 00:09:44,460
عيناها ويداها وتعابير وجهها كلّها جميلة

115
00:09:45,920 --> 00:09:48,230
والآن لم أعد "أراقبها" فحسب

116
00:09:50,280 --> 00:09:54,010
أنا مفتونٌ بها

117
00:09:54,860 --> 00:09:59,480
إنّه غارقٌ للحضيض! ألا يعي ذلك؟

118
00:10:01,180 --> 00:10:03,620
هل ستغلقان الحانة؟

119
00:10:03,620 --> 00:10:05,900
رين-تشان، يوكي-تشان

120
00:10:05,900 --> 00:10:06,870
لا، تفضّلا

121
00:10:06,870 --> 00:10:07,920
اجلسا

122
00:10:07,920 --> 00:10:09,210
!مرحى

123
00:10:16,240 --> 00:10:18,600
ستقضي اللّيلة في منزلي

124
00:10:18,600 --> 00:10:21,960
جميل. هذه هي حياة الكلّية

125
00:10:28,020 --> 00:10:29,230
هل يمكنني استعارتها قليلاً؟

126
00:10:29,230 --> 00:10:31,100
!ماذا؟ ماذا؟

127
00:10:33,510 --> 00:10:34,360
ماذا؟

128
00:10:35,000 --> 00:10:39,900
متى بدأت الثُّلوج تتساقط؟ كان
الجوّ صحواً في النّهار أيضاً

129
00:10:43,410 --> 00:10:44,810
لا

130
00:10:59,200 --> 00:11:00,580
دافئ للغاية

131
00:11:03,290 --> 00:11:08,260
بدت السّماء تشبه السّماء عندما
أتيتِ إلى هنا أوّل مرّة أيضاً، صحيح؟

132
00:11:21,160 --> 00:11:22,910
،عندما أريها هذا

133
00:11:23,520 --> 00:11:24,980
ستنظر إليّ

134
00:11:59,650 --> 00:12:03,560
هل يدرك ما يقوله بتلك الإشارة؟

135
00:12:04,050 --> 00:12:07,240
لحظة، لم أعلّمه ذلك حتّى

136
00:12:10,820 --> 00:12:11,740
يوكي

137
00:12:15,720 --> 00:12:17,130
...ما رأيك

138
00:12:19,080 --> 00:12:20,390
أن نصبح زوجين؟

139
00:12:28,480 --> 00:12:31,640
ما رأيك أن نصبح زوجين؟

140
00:12:44,320 --> 00:12:45,940
لماذا"؟"

141
00:12:46,480 --> 00:12:48,830
لأنّني أرغب في الخروج معكِ

142
00:12:56,200 --> 00:12:58,500
لم أكن أتوقّع كلّ هذا أيضاً

143
00:12:59,330 --> 00:13:01,930
سأظلّ غالباً أسافر إلى أماكن

144
00:13:02,360 --> 00:13:05,030
وألتقي بمختلف أنواع النّاس في سفري

145
00:13:05,030 --> 00:13:09,830
لكن أنتِ غير موجودة في تلك الأماكن

146
00:13:12,760 --> 00:13:14,470
أصبحت رؤيتي ضبابيّة

147
00:13:15,760 --> 00:13:19,420
...لا أميّز سوى الملامح فقط

148
00:13:23,330 --> 00:13:25,110
هل ما زلتِ تستطيعين قراءة شفتَي؟

149
00:13:27,270 --> 00:13:29,190
ليس كلّ شيء

150
00:13:36,070 --> 00:13:39,130
أريدكِ يا يوكي

151
00:13:45,730 --> 00:13:47,780
هل جوابكِ سيكون "أجل"؟

152
00:13:52,120 --> 00:13:53,740
...إتسومي-سان

153
00:14:04,680 --> 00:14:05,640
أجل؟

154
00:14:08,680 --> 00:14:09,800
فهمت

155
00:14:09,800 --> 00:14:10,620
ماذا؟

156
00:14:10,620 --> 00:14:12,390
إنّه هادئ جدّاً بشأن ذلك

157
00:14:12,390 --> 00:14:17,620
ما هذا؟ نفس أجواء لعبة باحة المدرسة تلك؟

158
00:14:18,980 --> 00:14:23,500
سأتعلّم... مزيداً... من لغة الإشارة

159
00:14:34,500 --> 00:14:36,600
لماذا تلفّ ذراعك حولها؟

160
00:14:36,600 --> 00:14:40,690
في الواقع... سوف نخرج معاً

161
00:14:42,690 --> 00:14:44,940
!مـ-مـ-ما هذا الكلام فجأة؟

162
00:14:44,940 --> 00:14:46,200
!ماذا؟ حقّاً؟

163
00:14:46,200 --> 00:14:47,480
!ستخرجان معاً؟

164
00:14:47,480 --> 00:14:48,620
!بجدّية؟

165
00:14:48,620 --> 00:14:51,200
شفاههما تتحرّكان بسرعة لدرجة
يصعب عليّ القراءة

166
00:14:52,000 --> 00:14:52,820
ماذا؟

167
00:14:53,130 --> 00:14:55,790
مهلاً! نفس النّظرة تماماً فيكم أنتم الثّلاثة

168
00:14:55,790 --> 00:14:57,330
!هذا بديهيّ

169
00:14:57,330 --> 00:14:59,540
هكذا إذاً

170
00:15:00,980 --> 00:15:02,970
هذا رهيب يا يوكي

171
00:15:02,970 --> 00:15:05,080
لا تخفي شفتيكِ يا رين

172
00:15:05,670 --> 00:15:08,300
إتسو تحديداً؟

173
00:15:08,300 --> 00:15:10,300
كيويا، أحضر لي بيرة

174
00:15:10,300 --> 00:15:11,680
على الفور

175
00:15:12,010 --> 00:15:16,080
حسناً، كيف تكون عندما تواعد
فتاة يا إتسومي-سان؟

176
00:15:16,080 --> 00:15:17,450
طبيعيّ؟

177
00:15:17,450 --> 00:15:20,360
!وأريد ماذا يعني "طبيعيّ" بالنّسبة لك

178
00:15:21,440 --> 00:15:26,440
!رائع، رائع! بدا أنّك بدأتَ تُعجب بيوكي

179
00:15:27,050 --> 00:15:30,840
!أنا مسرورةٌ جدّاً لأجلكِ يا يوكي

180
00:15:27,050 --> 00:15:33,570
بدأ فرح رين-تشان يجعل هذا الأمر واضحاً

181
00:15:34,290 --> 00:15:38,080
إنّه حقّاً غامض

182
00:15:39,950 --> 00:15:40,750
لنغادر

183
00:15:40,750 --> 00:15:44,040
ماذا؟ ما زال هناك الكثير لنتكلّم عنه

184
00:15:44,040 --> 00:15:47,690
حظر التجوّل بالنّسبة ليوكي يبدأ
على العاشرة مساء، صحيح؟ تجاوزت العاشرة

185
00:15:48,090 --> 00:15:51,390
كما قلنا، سوف تمكث عندي اللّيلة

186
00:15:51,390 --> 00:15:54,090
أجل، لكن عائلتها لا تعلم
بأنّكِ في الخارج الآن، صحيح؟

187
00:15:54,090 --> 00:15:55,950
صحيح

188
00:15:55,950 --> 00:15:57,690
سأوصلها إلى منزلكِ

189
00:15:57,690 --> 00:15:58,850
سأذهب أيضاً

190
00:15:59,240 --> 00:16:01,310
ما رأيكِ أن تبقي وتشربي المزيد؟

191
00:16:02,290 --> 00:16:04,900
أوصلها لاحقاً يا كيويا

192
00:16:05,300 --> 00:16:08,240
حسناً. ابقي هنا فترة أطول يا رين-تشان

193
00:16:08,240 --> 00:16:09,070
!حسناً

194
00:16:09,810 --> 00:16:11,820
هذا هو مفتاح منزلي

195
00:16:12,360 --> 00:16:14,090
تذكّرت

196
00:16:14,090 --> 00:16:18,810
رأت يوكي فتاةً تُسلّمك مفتاح فشعرَتْ بالقلق

197
00:16:18,810 --> 00:16:22,180
أجل، تلك

198
00:16:22,180 --> 00:16:23,160
فهمت

199
00:16:23,970 --> 00:16:24,830
هيّا بنا

200
00:16:24,830 --> 00:16:28,090
ماذا؟ لن تأتي رين-تشان معنا؟

201
00:16:38,550 --> 00:16:43,730
ألستِ مسرورة لأنّكما تمكّنتُما من المشي إلى المنزل معاً؟
سأعود بعد فترة

202
00:16:44,090 --> 00:16:48,120
فهمت. تقضي بعضَ الوقت
لوحدها مع المدير أيضاً

203
00:16:49,480 --> 00:16:51,940
ماذا؟ إتسومي-سان؟

204
00:16:59,460 --> 00:17:02,820
لستُ أفهم معنى "تستعير شقّة" بالضّبط

205
00:17:10,520 --> 00:17:15,500
لا أدري ماذا أقول بشأن صداقاته

206
00:17:16,750 --> 00:17:19,190
لا أريد أن أسبّب أي مشكلة

207
00:17:19,770 --> 00:17:25,240
ولا أريد حتماً أن أجعل عالمه أضيق

208
00:17:27,410 --> 00:17:28,250
ماذا؟

209
00:17:29,080 --> 00:17:31,280
لديّ بعض الرّسائل الأخرى

210
00:17:31,280 --> 00:17:32,520
أوشي-كن؟

211
00:17:35,480 --> 00:17:38,530
ماذا؟ لماذا الآن؟

212
00:17:39,250 --> 00:17:44,260
تذكّرت. لماذا عبسَ هو وإتسومي-سان
في وجه بعضهما الآخر قبل أيّام؟

213
00:17:45,480 --> 00:17:47,370
سأضيفه لاحقاً

214
00:18:01,860 --> 00:18:05,390
إنّه يشبك يده بيدي

215
00:18:05,800 --> 00:18:09,060
كان يمسكها فحسب من قبل

216
00:18:09,600 --> 00:18:12,400
...هذا ما يعنيه إذاً

217
00:18:13,110 --> 00:18:15,300
اشتباك اليدين

218
00:18:16,950 --> 00:18:20,950
طريقة تحريك يديه آنذاك كانت حازمة

219
00:18:23,760 --> 00:18:28,060
لا أشعر حتّى بأنّني أمشي
إلى المنزل الآن

220
00:18:30,570 --> 00:18:33,550
كاد ذلك يسبّب لي نوبة قلبيّة

221
00:18:33,550 --> 00:18:37,530
لم أتوقّعهما أن يبدآ بالخروج معاً اللّيلة

222
00:18:37,530 --> 00:18:39,050
بالفعل

223
00:18:39,050 --> 00:18:45,020
لكن لم يتغيّر إتسومي-سان، أليس كذلك؟

224
00:18:45,020 --> 00:18:46,840
...أنا قلقة

225
00:18:48,080 --> 00:18:51,310
أعتقد كان يطير فرحاً

226
00:18:51,310 --> 00:18:54,800
ماذا؟ تقصد بأنّه كان يتظاهر بالثّبات؟

227
00:18:54,800 --> 00:18:57,840
لا أظنّه كان يخفي ذلك

228
00:18:57,840 --> 00:19:01,600
ربّما لم تستطيعي رؤية ذلك، لكن بالنّسبة
لي، كان ذلك واضحاً في محياه

229
00:19:01,600 --> 00:19:02,820
أنا مسرور لأجله

230
00:19:02,820 --> 00:19:06,460
أجل. أتمنّى التّوفيق لهما

231
00:19:08,910 --> 00:19:10,470
شين

232
00:19:12,040 --> 00:19:13,330
أين إتسو-كن؟

233
00:19:13,690 --> 00:19:15,920
انتهى دوامه. لقد غادر

234
00:19:15,920 --> 00:19:17,400
هكذا إذاً

235
00:19:17,880 --> 00:19:18,840
ستغادر؟

236
00:19:19,340 --> 00:19:20,470
أمتأكّد بأنّك لا تريد شراباً؟

237
00:19:23,280 --> 00:19:25,980
لا، لا أريد أن أكون شخصاً زائداً

238
00:20:05,890 --> 00:20:09,640
يمكنني الذّهاب معه؟

239
00:20:20,050 --> 00:20:20,970
إلى اللّقاء

240
00:20:45,840 --> 00:20:46,790
يوكي

241
00:21:28,150 --> 00:21:33,300
،تلكما اليدان اللّتان أمسكتا بي
...تلكما العينان اللّتان تحدّقان بي

242
00:21:34,420 --> 00:21:37,880
ستريان عالماً مجهولاً جديداً آخر

243
00:21:39,520 --> 00:21:44,180
لا أريدك أن تعتقد بأنّني لا أرى
سوى ما هو حولي، لذا لن أقولها لك

244
00:21:45,300 --> 00:21:49,820
لكن وقعتُ حتّى في حبِّ النّظر
إلى وجهك بهذا الشّكل

245
00:21:50,880 --> 00:21:56,150
كلّ تعبير تُريني إيّاه يغمرني بنور ساطع

246
00:21:57,040 --> 00:21:59,720
،في هذا اليوم، 21 فبراير

247
00:21:59,720 --> 00:22:03,880
اتّحدَ عالمانا وأصبحا واحداً

248
00:22:49,990 --> 00:22:53,220
حسناً، لماذا اخترتَ الآن؟

249
00:22:53,660 --> 00:22:54,920
ماذا تقصد؟

250
00:22:54,920 --> 00:22:56,860
ستسافر في يوم الاثنين

251
00:22:57,720 --> 00:23:01,170
ستسافر بعد بدئكما في المواعدة
مباشرة؟ هذا سيّئ بالنّسبة لها

252
00:23:01,170 --> 00:23:05,440
لم أرد أن أتحسّر على شيء، كأن
"أقول لنفسي، "ليتني سألتُها قبلاً

253
00:23:06,480 --> 00:23:09,790
...كما تعلم، بدأنا في المواعدة للتو

254
00:23:09,790 --> 00:23:10,520
وبعد؟

255
00:23:11,810 --> 00:23:14,740
لكن لا أرى فُراقاً بيني وبين يوكي

256
00:23:17,040 --> 00:23:18,670
لِمَ الصّمت؟

257
00:23:18,670 --> 00:23:20,750
بدوتَ صغيراً جدّاً وبريئاً

258
00:23:21,080 --> 00:23:26,540
لا أقصد انتقاد ما تقوله. أشجّعكما من كلّ قلبي

259
00:23:26,540 --> 00:23:27,770
أشكرك

260
00:23:27,770 --> 00:23:28,760
وداعاً

261
00:23:32,740 --> 00:23:35,010
،اللّعنة

262
00:23:35,350 --> 00:23:37,670
إنّه يطير فرحاً فعلاً