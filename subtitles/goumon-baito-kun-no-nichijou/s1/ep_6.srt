1
00:00:08,080 --> 00:00:11,900
هذا يفتقر للتّأثير

2
00:00:12,420 --> 00:00:16,030
هل أستخدم تقنيّة التّعذيب المُدمجة العظمى؟

3
00:00:19,070 --> 00:00:23,000
،هذه الفكرة الّتي أرسلتها لي للتو
!تقنيّة التّعذيب المُدمجة، مُذهلة

4
00:00:23,530 --> 00:00:26,300
استلهمتُها من أساتذتي في العمل

5
00:00:26,300 --> 00:00:29,000
أيوجد أشخاص كهؤلاء فعلاً؟

6
00:00:29,000 --> 00:00:30,760
أجل

7
00:00:30,930 --> 00:00:32,970
!ينبغي أن نعمل على هذه الفكرة حتماً

8
00:00:33,200 --> 00:00:34,360
!أجل

9
00:00:54,700 --> 00:00:57,540
!تنظيف، تنظيف

10
00:00:57,740 --> 00:00:59,990
ميكي، أنت تحبّ التّنظيف حقّاً، أليس كذلك؟

11
00:01:01,580 --> 00:01:05,280
من المُمتع رؤية الماء في الدّلو
!وهو يتحوّل للّون الأحمر

12
00:01:05,280 --> 00:01:06,540
!أفهمك تماماً

13
00:01:06,980 --> 00:01:09,000
لكن يمكنك تركه هناك اليوم

14
00:01:09,220 --> 00:01:09,800
ماذا؟

15
00:01:13,470 --> 00:01:15,320
جاء المُنظِّف

16
00:02:49,500 --> 00:02:52,130
ماذا؟ لم تلتقيا بعد؟

17
00:02:52,350 --> 00:02:54,690
هذه هي المرّة الأولى

18
00:02:54,690 --> 00:02:56,970
هذا ريشي، المُنظِّف

19
00:02:57,350 --> 00:03:00,360
تُنظَّفُ غرف التّعذيب لدينا
على أساس دوريّ

20
00:03:00,900 --> 00:03:03,120
هكذا إذاً

21
00:03:06,880 --> 00:03:09,500
...همس، همس، همس

22
00:03:09,500 --> 00:03:10,500
بكلّ تأكيد

23
00:03:10,690 --> 00:03:12,360
طُلِب منك اسمك

24
00:03:12,890 --> 00:03:15,530
!أ-أ-أنا ميكي

25
00:03:17,990 --> 00:03:20,680
طلب الاسم نادر جدّاً

26
00:03:20,920 --> 00:03:21,600
ماذا؟

27
00:03:22,360 --> 00:03:24,600
ميكي، ربّما أنت النّوع المُفضّل لها

28
00:03:24,600 --> 00:03:26,140
!إنّها امرأة؟

29
00:03:26,360 --> 00:03:27,970
إذا اعترفتْ، فهل ستُواعدها؟

30
00:03:27,970 --> 00:03:31,120
شخصيّاً، أنا أبلي حسناً
من دون كلّ هذا

31
00:03:31,120 --> 00:03:33,440
...لديّ ثلاث أخوات أكبر منّي

32
00:03:33,920 --> 00:03:35,620
أنا الّتي على حقّ هنا، صحيح؟

33
00:03:35,620 --> 00:03:36,470
!لا بل أنا

34
00:03:36,470 --> 00:03:37,650
!لا، إنّها أنا

35
00:03:37,650 --> 00:03:41,560
أشعرَني ذلك بأنّ النّساء لا يُحتمَلن

36
00:03:41,840 --> 00:03:43,650
!يا للإسراف

37
00:03:43,950 --> 00:03:45,200
ماذا عنك يا سيرو-سان؟

38
00:03:45,200 --> 00:03:47,560
ألم تنفصل عن حبيبتك؟

39
00:03:47,910 --> 00:03:50,740
انفصلنا، لكن أحببتُ أُخرى ثمّ انفصلتُ عنها

40
00:03:50,960 --> 00:03:53,590
كأنّك تلعب بهن على أصابعك

41
00:03:53,590 --> 00:03:55,030
!يا للوقاحة

42
00:03:55,030 --> 00:03:57,340
هُنّ من يأتين إليّ ثمّ يُغادرن

43
00:03:57,340 --> 00:03:59,630
وأنا أواعد واحدة فقط في كلّ مرّة

44
00:03:59,630 --> 00:04:01,810
شعبيّتك كبيرة حقّاً، أليس كذلك؟

45
00:04:05,760 --> 00:04:08,220
سيرو، انتهيت. وقّع من فضلك

46
00:04:09,310 --> 00:04:10,020
!حسناً

47
00:04:11,350 --> 00:04:14,850
.كانت تلك الغرفة مُتّسخة جدّاً
سأضيف أجراً إضافيّاً

48
00:04:15,070 --> 00:04:16,750
بربّكِ. امنحينا حسماً

49
00:04:16,750 --> 00:04:17,530
غير مُمكن

50
00:04:17,710 --> 00:04:18,630
بخيلة

51
00:04:18,630 --> 00:04:19,170
ماذا؟

52
00:04:19,190 --> 00:04:20,250
لستُ بخيلة

53
00:04:20,530 --> 00:04:22,040
!فتاة صغيرة جميلة؟

54
00:04:24,670 --> 00:04:28,450
لديها هذا الوجه الجميل تحت ذلك القناع؟

55
00:04:31,650 --> 00:04:33,320
...المعذرة يا ميكي-تشان

56
00:04:33,580 --> 00:04:35,320
نـ-نعم؟

57
00:04:36,150 --> 00:04:40,430
ميكي-تشان، هل أنت رصاصة
التّعذيب ميكي-تشان؟

58
00:04:41,720 --> 00:04:43,710
ماذا يعني "رصاصة التّعذيب"؟

59
00:04:44,120 --> 00:04:45,960
رواية. إنّها مُمتعة

60
00:04:46,340 --> 00:04:47,050
حقّاً؟

61
00:04:49,690 --> 00:04:53,260
الشّخصيّات الرّئيسيّة هم مُعذّبون عبقريّون
ولديهم تلاميذ

62
00:04:53,260 --> 00:04:55,730
!ماذا؟! مثل سيو-سان وأنا

63
00:04:56,720 --> 00:04:59,440
...اسم المُؤلّف هو نفسه، لذا ارتأيتُ بأنّه

64
00:04:59,440 --> 00:05:01,010
أنا

65
00:05:01,820 --> 00:05:03,740
،أنا من يكتبها

66
00:05:03,740 --> 00:05:06,440
وسيرو-سان والآخرون هم
!من منحوني الإلهام لذلك

67
00:05:06,630 --> 00:05:08,660
!حقّاً؟ رائع

68
00:05:08,660 --> 00:05:10,810
!أشعر بإحراج غريب

69
00:05:11,170 --> 00:05:15,630
سيرو-سان، حصلتُ على إذن
منك ومن الجميع

70
00:05:12,310 --> 00:05:14,640
هل يمكنني تصميم شخصيّات
تيّمناً بكما؟

71
00:05:14,640 --> 00:05:15,630
!أجل، يمكنك ذلك

72
00:05:15,630 --> 00:05:16,590
بكلّ تأكيد

73
00:05:15,630 --> 00:05:18,330
صحيح. قلتَ شيئاً من هذا القبيل

74
00:05:18,440 --> 00:05:21,400
!أحبّ تلك الرّواية حقّاً

75
00:05:21,400 --> 00:05:22,540
شكراً لكِ

76
00:05:22,540 --> 00:05:25,320
لم أتوقّع أبداً أن ألتقي بالمُؤلّف

77
00:05:25,320 --> 00:05:26,920
...أو أنّك كنت

78
00:05:27,730 --> 00:05:30,160
فتاة ظريفة هكذا

79
00:05:30,160 --> 00:05:30,790
ماذا؟

80
00:05:31,390 --> 00:05:33,610
هل يمكننا تبادُل معلومات الاتّصال؟

81
00:05:33,610 --> 00:05:35,560
ما رأيك بالخروج والتنزّه يوماً ما؟

82
00:05:36,110 --> 00:05:38,580
ريشي، لديكِ فكرة خاطئة حول أمر

83
00:05:39,360 --> 00:05:40,960
ميكي هو ذكَر

84
00:05:41,600 --> 00:05:42,360
ماذا؟

85
00:05:45,560 --> 00:05:48,990
إذاً، معلومات الاتّصال فقط

86
00:05:48,990 --> 00:05:51,610
من فضلك استمرّ في العمل
بجدّ في كتابتك

87
00:05:51,610 --> 00:05:52,280
بالطّبع

88
00:05:52,430 --> 00:05:55,240
شعرتُ بأنّها كانت مُبادِرة إلى حدّ غير معتاد

89
00:05:55,460 --> 00:05:58,270
شـ-شكراً لك

90
00:06:02,550 --> 00:06:03,210
ماذا؟

91
00:06:03,520 --> 00:06:05,420
التقيت بريتشي بعد ذلك؟

92
00:06:05,420 --> 00:06:07,310
أجل، بضع مرّات

93
00:06:07,310 --> 00:06:10,380
رغم أنّها كانت خائبة جدّاً لأنّك رجل

94
00:06:10,600 --> 00:06:13,360
إنّها تدعني أطرح عليها أسئلة
حول كونها مُنظِّفة

95
00:06:13,640 --> 00:06:16,600
سأقابلها ثانية لجمع مزيد من المعلومات

96
00:06:16,600 --> 00:06:18,030
هكذا إذاً

97
00:06:18,400 --> 00:06:21,060
لكن لم أتخيّل أبداً أن تعتقدك امرأة

98
00:06:21,200 --> 00:06:23,020
يحدث هذا أحياناً

99
00:06:23,740 --> 00:06:26,000
،لكن لو كنتُ أكثر رجوليّة

100
00:06:26,000 --> 00:06:29,200
.لما دلّلني النّاس مثلما يفعلون
لذا لا أُمانع

101
00:06:29,200 --> 00:06:31,240
حسناً، ظرافتك هي سلاح في نهاية المطاف

102
00:06:31,440 --> 00:06:36,580
وذاتي الظّريفة تودّ أكل شريحة
!لحم لذيذة اليوم

103
00:06:36,580 --> 00:06:37,540
حسناً

104
00:06:37,540 --> 00:06:39,460
أخوك الكبير هنا سيعزمك على واحدة

105
00:06:39,600 --> 00:06:41,150
!مرحى

106
00:06:45,080 --> 00:06:47,760
هذا... غير منطقيّ حتماً

107
00:06:48,620 --> 00:06:50,700
لا بُدّ أنّها مُؤامرة من نوع ما

108
00:06:51,540 --> 00:06:54,160
!إنّها ظريفة جدّاً

109
00:07:00,000 --> 00:07:01,340
آتي إلى هنا أحياناً

110
00:07:01,980 --> 00:07:06,460
،منذ بدأتُ العمل في سبيريتوس
توقّفتُ عن الذّهاب إلى مقاهي القطط

111
00:07:06,460 --> 00:07:09,070
القطط حسّاسة للرّوائح

112
00:07:09,320 --> 00:07:12,320
،بعد أن جرّبتُ المُعقِّم الّذي أوصيتِ به

113
00:07:12,320 --> 00:07:15,000
لم تعُد مُشكلة. تحسّن الوضع كثيراً

114
00:07:15,750 --> 00:07:17,580
لكنّه باهظ الثّمن قليلاً

115
00:07:18,540 --> 00:07:21,200
شكراً على دعمك

116
00:07:27,310 --> 00:07:28,580
هل هذا جيّد؟

117
00:07:29,120 --> 00:07:29,820
!أجل

118
00:07:31,080 --> 00:07:33,240
شكراً لك! سأحتفظ به

119
00:07:35,260 --> 00:07:37,550
سأشتري علبة مُضادّة للبكتيريا وأحتفظ به

120
00:07:37,910 --> 00:07:39,310
هذا فريد

121
00:07:41,480 --> 00:07:44,770
ميكي-تشان، ألن تُركّز على رواياتك فقط؟

122
00:07:44,900 --> 00:07:47,230
طلب منّي ناشري نفس الأمر

123
00:07:47,410 --> 00:07:50,220
،أحياناً يزدحم جدول أعمالي

124
00:07:50,220 --> 00:07:52,700
لكن أشعر بأنّني لا ينبغي أن أستقيل

125
00:07:53,360 --> 00:07:56,650
،منذ بدأتُ التّعذيب، تحسّنتْ كتابتي

126
00:07:56,900 --> 00:07:59,300
لذا أعتقد بأنّني بحاجة للأمرين

127
00:08:00,880 --> 00:08:02,850
إنّهما معاً بمثابة مهنة لك

128
00:08:06,340 --> 00:08:09,180
عملنا الرّئيسيّ هو التّعذيب

129
00:08:09,180 --> 00:08:11,590
أعمالي الأُخرى كلّها طلبات مُفاجئة

130
00:08:11,720 --> 00:08:12,880
هكذا إذاً

131
00:08:13,220 --> 00:08:16,250
وقد قبلتُ أعمالَ تنظيف عاديّة أيضاً

132
00:08:16,250 --> 00:08:17,670
كتنظيف ما بعد نِزاع مثلاً

133
00:08:17,670 --> 00:08:19,400
!نِزاع؟

134
00:08:19,400 --> 00:08:22,370
المُنظِّفون... يبدو أنّ هناك المزيد
ممّا هو مخفيّ

135
00:08:22,370 --> 00:08:24,800
لكن العمل بحدّ ذاته مُملٌّ جدّاً

136
00:08:24,800 --> 00:08:27,860
هل أطلب من رئيسنا ما إن كنتَ
تستطيع مُرافقتي والمُشاهدة؟

137
00:08:28,230 --> 00:08:30,310
!أجل، من فضلكِ

138
00:08:33,290 --> 00:08:35,410
،على ذكر الأمر، عندما التقينا أوّل مرّة

139
00:08:35,710 --> 00:08:38,300
حسبتِني فتاة، أليس كذلك؟

140
00:08:38,540 --> 00:08:39,750
آسفة

141
00:08:39,750 --> 00:08:41,630
!هذا لا يُزعجني

142
00:08:41,780 --> 00:08:45,200
.بدا وكأنّكِ كنتِ خائبة الظّنّ
هل تكرهين الرّجال؟

143
00:08:45,370 --> 00:08:47,840
،ليست مسألة أنّني أكرههم

144
00:08:47,840 --> 00:08:50,110
لكن من الأسهل الانفتاح على
نفس الجنس، صحيح؟

145
00:08:50,110 --> 00:08:51,090
هكذا إذاً

146
00:08:51,090 --> 00:08:54,590
الفتيات ظريفات، ورائحتهن
جميلة. أحبّهن

147
00:08:55,340 --> 00:08:57,780
هل كنتِ لتُفضّلين أن أكون فتاة أيضاً؟

148
00:08:58,160 --> 00:08:59,000
!لا

149
00:08:59,000 --> 00:09:01,850
ميكي-تشان، أعتقد بأنّك مناسب كما أنت

150
00:09:04,040 --> 00:09:06,370
أنت ظريف، ورائحتك جميلة

151
00:09:07,690 --> 00:09:08,430
...لكن

152
00:09:08,740 --> 00:09:10,530
!يمكن لرائحتك أن تكون أجمل

153
00:09:12,410 --> 00:09:14,040
!مُذهل! يا لها من رائحة جميلة

154
00:09:14,240 --> 00:09:16,990
هل ترغب في تجربة مُطهّر
الأقمشة الخاص بنا؟

155
00:09:17,540 --> 00:09:19,580
أنتِ ماهرة في البيع

156
00:09:21,880 --> 00:09:22,830
!ميكي

157
00:09:23,640 --> 00:09:25,890
كيف كان موعدك مع ريشي؟

158
00:09:26,400 --> 00:09:29,500
أخبرتُك، خرجنا للتنزُّه فقط

159
00:09:31,140 --> 00:09:32,750
اشتريتُ مُطهّرَ أقمشة

160
00:09:32,750 --> 00:09:34,720
يبدو وكأنّها تعتبرك ضحيّة

161
00:09:34,950 --> 00:09:37,920
تقول ذلك، لكنّك تستخدمه أيضاً، أليس كذلك؟

162
00:09:37,920 --> 00:09:40,210
!هذا لأنّ مُنتجاتهم ممتازة فحسب

163
00:09:40,210 --> 00:09:41,060
هذا صحيح

164
00:09:41,880 --> 00:09:44,370
إنّها جيّدة، لذا لا يسعني
!فعل شيء سوى شرائها

165
00:09:44,370 --> 00:09:44,990
نصر

166
00:09:57,220 --> 00:09:59,680
هل تعملان في سبيريتوس؟

167
00:09:59,680 --> 00:10:00,480
ماذا؟

168
00:10:01,440 --> 00:10:02,450
أجل

169
00:10:02,600 --> 00:10:04,550
ثمّة رجل هناك يُدعى دوبّيل، صحيح؟

170
00:10:04,550 --> 00:10:05,910
هلّا أخذتُماني إليه؟

171
00:10:06,120 --> 00:10:08,000
...دوبّيل هو اليوم

172
00:10:08,000 --> 00:10:10,060
الشّخص المسؤول عنه سيرو-سان، صحيح؟

173
00:10:10,060 --> 00:10:11,760
خذاني إلى هناك بسرعة

174
00:10:11,760 --> 00:10:13,840
وضّحتُ الأمر بالفعل مع رئيسكم

175
00:10:13,840 --> 00:10:15,600
هل لي أن أسأل من تكونين؟

176
00:10:16,280 --> 00:10:18,760
أنا مانيكا، قاتلة بالعقد

177
00:10:18,990 --> 00:10:19,970
ماذا؟

178
00:10:22,630 --> 00:10:23,940
قاتلة بالعقد؟

179
00:10:23,940 --> 00:10:25,800
تتشابك العقود مع بعضها

180
00:10:25,800 --> 00:10:27,600
ماذا تقصد؟

181
00:10:27,820 --> 00:10:29,850
أحياناً، نفس الشّخص يتلقّى

182
00:10:29,850 --> 00:10:32,120
طلبَ تعذيب وطلبَ قتل في نفس الوقت

183
00:10:32,340 --> 00:10:34,160
جوهريّاً، حجر مُزدوج

184
00:10:36,640 --> 00:10:37,620
!أنا آسف

185
00:10:38,000 --> 00:10:40,400
لم ننتهِ تماماً بعد، لذا
—إن أردت الانتظار

186
00:10:39,530 --> 00:10:40,390
سيرو

187
00:10:40,610 --> 00:10:41,600
لم أرك منذ وقت

188
00:10:41,860 --> 00:10:43,030
مانيكا، أهذه أنتِ؟

189
00:10:44,820 --> 00:10:46,750
!حبيبة سيرو-سان؟

190
00:10:46,750 --> 00:10:48,140
السّابقة

191
00:10:50,750 --> 00:10:53,370
ظننتُكِ كنتِ مسؤولة عن منطقة
مُختلفة، أليس كذلك؟

192
00:10:53,760 --> 00:10:55,490
تغيّرتْ مؤخّراً

193
00:10:55,490 --> 00:10:56,600
هكذا إذاً

194
00:10:56,760 --> 00:10:59,350
في الواقع، سلّم ذلك الرّجل بسرعة

195
00:10:59,350 --> 00:11:01,440
أنا في استراحة الآن

196
00:11:01,440 --> 00:11:04,270
كيف التقيتُما؟

197
00:11:05,960 --> 00:11:07,210
مُضيف وزبونة

198
00:11:07,540 --> 00:11:08,840
!كان ذلك العمل؟

199
00:11:09,350 --> 00:11:12,140
لكن تواعدنا بعد أن اعتزل كمُضيف

200
00:11:12,310 --> 00:11:14,520
كنتُ قد انضممتُ لسبيريتوس
بالفعل، وصادفنا

201
00:11:14,520 --> 00:11:16,540
بعضنا الآخر في حانة، صحيح؟

202
00:11:16,860 --> 00:11:18,280
حقّاً؟

203
00:11:18,280 --> 00:11:22,070
كم مدّة استراحتك؟ أريد
العودة إلى المنزل بسرعة

204
00:11:22,070 --> 00:11:23,280
مهلاً، مهلاً

205
00:11:23,280 --> 00:11:25,850
كلاهما عفويّان حيال هذا الأمر

206
00:11:25,850 --> 00:11:28,530
لا بُدّ أنّهما يكنّان مشاعر
طويلة الأمد تجاه بعضهما

207
00:11:29,670 --> 00:11:33,380
هدف كذلك الهدف يرتعد أكثر
عند تركه وحيداً

208
00:11:33,820 --> 00:11:35,570
سأهزمه بسرعة. انتظري فحسب

209
00:11:36,970 --> 00:11:37,860
ماذا؟

210
00:11:38,360 --> 00:11:42,010
مانيكا-سان، هل يُعقَل أنّكِ ما زلتِ
تكنّين مشاعرَ تجاه سيرو-سان؟

211
00:11:42,010 --> 00:11:42,960
!ماذا؟

212
00:11:43,670 --> 00:11:45,570
!لا، لا، لا

213
00:11:45,570 --> 00:11:48,880
أقصد بأنّ هذا الشّخص يتمتّع
،بمظهر جميل، وهو لطيف

214
00:11:48,880 --> 00:11:51,300
وواسع الحيلة، ويتذكّر
،كلّ ذكرى سنويّة

215
00:11:51,300 --> 00:11:53,720
!وكان يختار الهدايا المثاليّة

216
00:11:53,720 --> 00:11:55,640
لكنّه من الرّجال الّذين لا ينفكّون يستخدمون

217
00:11:55,640 --> 00:11:57,480
الأشياء الّتي أعطته إيّاه حبيباته
!السّابقات وكأنّه ليس بالأمر الجلل

218
00:11:57,480 --> 00:11:58,850
لا مانع من ذلك، أليس كذلك؟

219
00:11:58,850 --> 00:11:59,900
!على العكس

220
00:12:00,120 --> 00:12:03,830
ما زلتُ أستخدم المِحفظة الّتي
أعطيتِني إيّاها. هل هذا سيّئ؟

221
00:12:06,050 --> 00:12:07,010
إنّه ليس كذلك

222
00:12:07,010 --> 00:12:08,470
هل أتخلّص منها؟

223
00:12:08,920 --> 00:12:10,280
لا تفعل من فضلك

224
00:12:10,280 --> 00:12:11,040
عُلِم

225
00:12:15,760 --> 00:12:16,960
حسناً

226
00:12:17,130 --> 00:12:18,690
الجولة الثّانية

227
00:12:19,080 --> 00:12:22,220
هذه المرّة، سوف تكون صادقاً
تماماً، أليس كذلك؟

228
00:12:20,320 --> 00:12:23,060
ألن يكون من الأفضل أن
تكوني أكثر صدقاً؟

229
00:12:23,060 --> 00:12:24,590
لم يطلب أحدٌ منك التدخُّل

230
00:12:25,340 --> 00:12:29,280
والمُشكلة الّتي أدّتْ إلى انفصالنا
لم تتغيّر غالباً

231
00:12:29,750 --> 00:12:30,600
ماذا تقصدين؟

232
00:12:30,820 --> 00:12:32,010
...كانت

233
00:12:33,310 --> 00:12:35,950
سمعتُ بأنّ القاتلة بالعقود الّتي تستهدف
ضحايا سيرو حبيبة سابقة

234
00:12:36,750 --> 00:12:38,430
!هذا هو السّبب رقم واحد

235
00:12:37,950 --> 00:12:39,080
صوتكِ مُرتفع

236
00:12:39,620 --> 00:12:42,320
أعرفكِ

237
00:12:42,680 --> 00:12:44,600
أنتِ الفتاة الوحيدة الّتي تركها سيرو

238
00:12:47,720 --> 00:12:49,490
،عندما يفتح فمه

239
00:12:49,490 --> 00:12:52,090
!كان كلّ ما يتحدّث عنه هو العمل وسيو-سان

240
00:12:52,090 --> 00:12:54,340
كلّ هذا بسببك وبسبب عمله

241
00:12:54,590 --> 00:12:57,040
قلتِ الكلام الخاطئ وهُجِرتِ. هذا كلّ شيء

242
00:12:57,190 --> 00:12:59,270
!تماديتُ قليلاً فحسب

243
00:12:59,270 --> 00:13:00,920
قالت كلاماً خاطئاً؟

244
00:13:00,920 --> 00:13:03,030
يبدو سيرو-سان لئيما قليلاً، أليس كذلك؟

245
00:13:04,280 --> 00:13:04,930
...في الواقع، كان

246
00:13:05,600 --> 00:13:07,640
!بئس الأمر

247
00:13:07,640 --> 00:13:10,870
!حبيساً في غرفة صغيرة وتتنمّر على الأشرار

248
00:13:10,870 --> 00:13:13,950
لماذا تحبّ هذا العمل الكئيب أصلاً؟

249
00:13:16,510 --> 00:13:17,840
أعتقد ينبغي أن ننفصل

250
00:13:20,130 --> 00:13:22,900
أشعر بأنّ ذلك كان الشّيء
الوحيد الّذي استطاع فعله

251
00:13:22,900 --> 00:13:25,360
القتَلة بالعقود همجيّون جدّاً

252
00:13:25,610 --> 00:13:27,070
أنت من جلب ذلك لنفسه

253
00:13:27,240 --> 00:13:29,360
!هذه هي مُشكلة المُعذّبين

254
00:13:31,760 --> 00:13:35,040
فضلاً عن ذلك، لم أُجبره أبداً

255
00:13:35,050 --> 00:13:37,370
لا بُدّ أنّكِ لم تكوني من ضمن أولويّاته

256
00:13:37,370 --> 00:13:38,920
!أعلم ذلك

257
00:13:38,920 --> 00:13:41,330
!أولويّات سيرو هي على الشّكل الآتي

258
00:13:42,390 --> 00:13:45,180
أخوه الأصغر ذو أولويّة أعلى

259
00:13:45,880 --> 00:13:47,350
...رغم ذلك

260
00:13:47,680 --> 00:13:49,740
،حتّى بمعرفة رجل كهذا

261
00:13:49,740 --> 00:13:51,360
ما زلتُ أريد أن أصبح الأُولى
!ضمن أولويّاته

262
00:13:51,360 --> 00:13:54,560
!لأنّني أحببتُه حُبّاً جمّاً
—حتّى الآن، أنا

263
00:13:53,420 --> 00:13:54,560
انتهيت

264
00:13:57,050 --> 00:13:58,560
هـ-هل سمعت ذلك؟

265
00:13:58,960 --> 00:13:59,830
بعضاً منه

266
00:14:03,990 --> 00:14:08,900
أخبرني يا سيرو، ألا يمكننا البدء من جديد؟

267
00:14:09,220 --> 00:14:11,520
...مانيكا، أنتِ

268
00:14:12,680 --> 00:14:14,400
أنتِ جميلة ولديكِ قوام رائع

269
00:14:14,400 --> 00:14:16,010
شخصيّتكِ رائعة أيضاً

270
00:14:14,400 --> 00:14:16,020
عليكِ دماء

271
00:14:16,010 --> 00:14:18,560
!ماذا؟ سيرو، عليك بعض الدّماء أيضاً

272
00:14:16,610 --> 00:14:18,560
،وبما أنّ كلينا لدينا عمل دمويّ

273
00:14:18,560 --> 00:14:21,160
كانت هناك الكثير من الأمور الّتي
تفاهمنا عليها. كان ذلك مُمتعاً

274
00:14:22,480 --> 00:14:25,380
كانت أطول علاقة قضيتُها
هي معكِ يا مانيكا

275
00:14:25,380 --> 00:14:28,000
وأعلم بأنّكِ لم تقصدي ما قلتِه

276
00:14:28,000 --> 00:14:29,530
...سيرو

277
00:14:30,930 --> 00:14:32,330
!لكن هذا مُستحيل

278
00:14:32,330 --> 00:14:34,880
!التّعذيب أهمّ بالنّسبة لي من حبيبة

279
00:14:36,750 --> 00:14:39,860
!سيرو، أيُّها الأحمق

280
00:14:51,390 --> 00:14:52,910
أنتِ مانيكا، صحيح؟

281
00:14:52,910 --> 00:14:56,070
!سيرو! يا لها من صدفة! مضى وقت طويل

282
00:14:58,370 --> 00:15:02,830
أهتمّ بحبيباتي، لكن الأولويّة لي ولعملي

283
00:15:03,080 --> 00:15:04,400
كذلك أنا

284
00:15:04,400 --> 00:15:06,630
لهذا لا يفلح الأمر أبداً

285
00:15:06,630 --> 00:15:09,250
!ربّما نحن نُلائم بعضنا الآخر إذاً

286
00:15:09,600 --> 00:15:10,770
أجل، ربّما

287
00:15:15,480 --> 00:15:17,980
كنتَ جادّاً بشأن ما قلتَه آنذاك؟

288
00:15:19,630 --> 00:15:22,760
كنتُ جادّة، لكن ماذا عنك يا سيرو؟

289
00:15:22,760 --> 00:15:23,980
أتريد تجربة المُواعدة؟

290
00:15:25,600 --> 00:15:27,110
كنتُ جادّاً أيضاً

291
00:15:27,550 --> 00:15:28,810
حسناً إذاً، ما رأيكِ بتجربتها؟

292
00:15:28,980 --> 00:15:30,810
ماذا تقصد بـ"حسناً إذاً"؟

293
00:15:31,270 --> 00:15:32,840
يعني حسناً إذاً، صحيح؟

294
00:15:45,040 --> 00:15:47,840
آسف. كُلّفتُ بعمل، لذا سأذهب

295
00:15:48,100 --> 00:15:49,320
حسناً

296
00:15:50,000 --> 00:15:52,260
آسف، لن أتمكّن من تخصيص وقت
لفترة من الزّمن

297
00:15:53,010 --> 00:15:53,660
حسناً

298
00:15:54,960 --> 00:15:57,950
آسف، سيو-سان طلبَني، لذا سأذهب

299
00:15:59,980 --> 00:16:01,490
—آسف، اليوم

300
00:16:00,500 --> 00:16:01,490
!مهلاً

301
00:16:03,800 --> 00:16:05,620
من فضلك لا تذهب اليوم

302
00:16:15,050 --> 00:16:18,270
يجب أن أذهب. أنا آسف يا مانيكا

303
00:16:21,370 --> 00:16:22,320
أنا آسف

304
00:16:28,020 --> 00:16:31,320
أعرف تماماً سبب تخلّيه عنّي

305
00:16:31,920 --> 00:16:33,200
...لكن رغم ذلك

306
00:16:34,040 --> 00:16:38,610
أحبّه، مفهوم؟

307
00:16:41,710 --> 00:16:42,970
!سيرو-سان

308
00:16:43,490 --> 00:16:46,390
هل كان ينبغي أن ترفضها هكذا؟

309
00:16:47,630 --> 00:16:49,130
لا مُشكلة

310
00:16:49,560 --> 00:16:51,520
حقيقة أنّ عملي وهذا المكان هما

311
00:16:51,520 --> 00:16:53,360
أهمّ شيء بالنّسبة لي لم تتغيّر

312
00:16:54,050 --> 00:16:59,570
فضلاً عن ذلك، هناك فتيات كُثُر، لكن
لا يحظى المرء إلّا بواحدة

313
00:16:59,890 --> 00:17:00,680
!يا إلهي

314
00:17:10,240 --> 00:17:12,980
مانيكا-تشان، أنتِ غاضبة

315
00:17:12,980 --> 00:17:14,080
هل حدث شيء؟

316
00:17:14,080 --> 00:17:15,110
!اصمت

317
00:17:19,680 --> 00:17:22,640
نوي-سان! هل يمكننا القيام بوضعيّة رائعة؟

318
00:17:22,920 --> 00:17:24,190
أيّ شيء يفي بالغرض

319
00:17:25,580 --> 00:17:27,880
سيو-سان، أنت كسول جدّاً على هذا

320
00:17:27,880 --> 00:17:29,040
كذلك أنت

321
00:17:31,280 --> 00:17:32,810
هذا مُناسب

322
00:17:33,180 --> 00:17:35,440
ما الغاية من هذه الصّور؟

323
00:17:35,440 --> 00:17:38,920
أنوي استخدامها للتّعريف عن موظّفينا

324
00:17:38,920 --> 00:17:40,140
ماذا؟

325
00:17:40,140 --> 00:17:41,610
انتظر لحظة

326
00:17:44,780 --> 00:17:47,080
لكن كان ذلك للاستعراض فقط

327
00:17:47,230 --> 00:17:49,170
،الآن بعد أن انضمّ إلينا مُبتدئون واعدون

328
00:17:49,160 --> 00:17:51,040
!قال بأنّنا واعدون

329
00:17:49,170 --> 00:17:51,040
هناك مزيد من الأعمال يمكننا قبولها

330
00:17:50,340 --> 00:17:51,040
!أجل

331
00:17:51,280 --> 00:17:54,370
هذه هي الفُرصة المثاليّة لاستقطاب
!أولئك الّذين يبحثون عن عمل

332
00:17:54,370 --> 00:17:56,280
وأريدكم جميعا أن تُساعدوني

333
00:17:56,670 --> 00:17:57,540
!بالطّبع

334
00:17:57,540 --> 00:17:59,340
!نوي-سان، لنفعلها

335
00:17:59,340 --> 00:18:00,340
شكراً لكما

336
00:18:00,600 --> 00:18:02,320
!كم هذا مُزعج

337
00:18:02,320 --> 00:18:03,800
لن تفعلها إذاً؟

338
00:18:03,800 --> 00:18:05,120
سأفعلها. سأفعلها

339
00:18:06,440 --> 00:18:07,480
...إذاً، أوّلاً

340
00:18:07,730 --> 00:18:10,270
هلّا أخبرتني من فضلك ثانية
عن سبب تقدّمك إلى هذا العمل

341
00:18:10,480 --> 00:18:14,730
أعجبتني فكرة عدم وجود أسباب كثيرة
للّقاء بالأشخاص وجهاً لوجه

342
00:18:14,930 --> 00:18:17,620
!ساعات قصيرة، أجر عالٍ، وفضول

343
00:18:18,490 --> 00:18:20,070
من السّهل فهم هذا. أعجبني ذلك

344
00:18:20,070 --> 00:18:22,340
إنّه من الأعمال الّتي لم أمارسها من قبل

345
00:18:22,340 --> 00:18:23,780
!هذا سبب وجيه

346
00:18:23,960 --> 00:18:26,390
أصفّ مجموعة منهم وأرمي
سِهاماً كي أُقرّر

347
00:18:26,740 --> 00:18:28,210
كفاك عبثاً

348
00:18:28,210 --> 00:18:30,780
تقرّب منّي شخصٌ مشبوه في زقاق خلفيّ

349
00:18:31,250 --> 00:18:32,480
...هيلا-سان

350
00:18:33,920 --> 00:18:36,350
،سببا ميكي وهيو جيّدان

351
00:18:36,350 --> 00:18:38,640
لكن هل هناك طريقة لإبراز
سبب شخصيّ أكثر؟

352
00:18:38,640 --> 00:18:39,700
ماذا عن سببي؟

353
00:18:39,700 --> 00:18:40,650
إنّه الأسوأ

354
00:18:40,650 --> 00:18:41,130
أنت

355
00:18:41,300 --> 00:18:43,840
مُعظم المُعذّبين يبدؤون بنزوة

356
00:18:44,810 --> 00:18:46,150
هذا صحيح

357
00:18:46,800 --> 00:18:49,310
أما من سبب أكثر إقناعاً؟

358
00:18:49,310 --> 00:18:51,250
،مثلاً، لطالما أحببت فكرةَ التّعذيب

359
00:18:51,250 --> 00:18:53,170
أو أردتَ أن تعذّب لدرجة لم
تستطع تحمُّل ذلك؟

360
00:18:54,200 --> 00:18:56,610
لكن لا أحد يرغب أُناساً كهؤلاء، صحيح؟

361
00:18:59,360 --> 00:19:00,580
هذا صحيح

362
00:19:02,240 --> 00:19:04,740
إذاً لماذا تستمرّون في مُمارسة هذا العمل؟

363
00:19:04,930 --> 00:19:06,420
لأنّني أمتلك موهبةً فيه

364
00:19:06,420 --> 00:19:07,780
هذان الاثنان سيّئان

365
00:19:08,160 --> 00:19:13,180
"أشياء مثل "الجسم البشريّ متين؟
"هذا الجزء ينثني أيضاً؟"

366
00:19:13,180 --> 00:19:15,920
كلّ يوم مليء بأعاجيب الجسد البشريّ

367
00:19:15,920 --> 00:19:18,600
!إنّه عملٌ حماسيّ ومُبهِج

368
00:19:18,600 --> 00:19:20,460
يبدو وكأنّه يستمتع، لكنّه مُخيف

369
00:19:20,460 --> 00:19:24,420
انتزاع الحقيقة من وحوش قذِرة
...والمُساهمة في المُجتمع

370
00:19:24,420 --> 00:19:26,680
!إنّه عملٌ قيّم جدّاً

371
00:19:27,050 --> 00:19:28,860
!تبدو إجابة جيّدة، لكنّه مُخيف

372
00:19:29,340 --> 00:19:31,080
مهلاً، لا تستخدمها كما هي

373
00:19:31,080 --> 00:19:33,620
سوف أُخفّفها قدر المستطاع قبل استخدامها

374
00:19:33,620 --> 00:19:34,600
خيار حكيم

375
00:19:36,220 --> 00:19:39,190
إذاً أنت تلتقط صوراً داخل
غرف التّعذيب أيضاً؟

376
00:19:39,190 --> 00:19:41,520
قد أتمكّن من استخدامها لغرض ما

377
00:19:42,040 --> 00:19:46,120
،ظننتُ أنّ نوي-سان أكثر رُعباً
لكنّه شخصٌ طيّب، أليس كذلك؟

378
00:19:46,120 --> 00:19:46,620
أجل

379
00:19:47,580 --> 00:19:49,080
ينبغي أن يكون هذا كافياً

380
00:19:49,640 --> 00:19:52,030
!شكراً لكما. نفعتماني كثيراً

381
00:19:56,760 --> 00:19:57,590
سيو-سان؟

382
00:19:58,150 --> 00:20:00,110
تبدو مُتحمّساً جدّاً حيال هذا

383
00:20:00,350 --> 00:20:01,430
ليس تماماً

384
00:20:01,660 --> 00:20:04,390
كلّ ما في الأمر أنّ هذا كلّ
ما يمكنني فعله

385
00:20:04,690 --> 00:20:08,180
وأسّسنا هذه الشّركة بوجودنا
،نحن الثّلاثة فقط

386
00:20:08,180 --> 00:20:10,370
لكن انضمّ مزيدٌ من النّاس الآن

387
00:20:10,650 --> 00:20:13,160
هذا... يُسعدني بعض الشّيء

388
00:20:15,440 --> 00:20:16,920
سيو-سان؟

389
00:20:18,840 --> 00:20:20,040
!سيو-سان؟

390
00:20:26,320 --> 00:20:27,960
انتهيت؟

391
00:20:27,960 --> 00:20:29,220
حاليّاً

392
00:20:30,520 --> 00:20:31,990
إذاً، يمكنك تناول هذا

393
00:20:32,540 --> 00:20:33,510
لماذا؟

394
00:20:33,770 --> 00:20:36,130
...لماذا؟ في الواقع

395
00:20:36,130 --> 00:20:37,190
رشوة؟

396
00:20:37,190 --> 00:20:40,250
اكتب "سيرو-ساما عبقريّ" في صفحة
التّعريف عنّي

397
00:20:40,480 --> 00:20:41,710
مُحال أن أكتب ذلك

398
00:20:43,360 --> 00:20:46,120
بالمناسبة، لا أحبّ قهوتي سوداء

399
00:20:46,120 --> 00:20:48,650
لا يمكنك شربها؟ يا لك من طفل

400
00:20:48,650 --> 00:20:50,120
!أ-أستطيع شربها

401
00:20:56,630 --> 00:20:57,410
نوي؟

402
00:20:57,690 --> 00:20:58,960
ما زلت مُستيقظاً؟

403
00:20:59,160 --> 00:21:00,110
أجل

404
00:21:00,410 --> 00:21:03,030
كان الجميع لطيفين بما يكفي
،للإجابة عن أسئلتي

405
00:21:03,030 --> 00:21:05,070
لذا أردتُ كتابة كلّ شيء اليوم

406
00:21:06,560 --> 00:21:07,890
لا تضغط على نفسك كثيراً

407
00:21:08,570 --> 00:21:10,280
!شكراً لك

408
00:21:10,280 --> 00:21:12,570
نوي، بدوت وكأنّك كنتَ مُستمتعاً مع الجميع

409
00:21:12,570 --> 00:21:13,660
أراحني ذلك

410
00:21:14,210 --> 00:21:16,480
من الجيّد امتلاك مكان تنتمي إليه، صحيح؟

411
00:21:18,650 --> 00:21:21,620
إذا كان مكاناً أنتمي إليه، فكان
لديّ واحد طوال هذا الوقت

412
00:21:22,110 --> 00:21:23,960
المكان الّذي أنتمي إليه
هو معك يا هيلا-سان

413
00:21:24,510 --> 00:21:25,320
لذيذ؟

414
00:21:25,490 --> 00:21:26,370
أجل

415
00:21:27,890 --> 00:21:31,160
تعال معي. لنُشكّل عائلة

416
00:21:34,390 --> 00:21:35,640
يا لك من غبيّ

417
00:21:36,080 --> 00:21:38,190
يمكنك أن تحظى بما تشاء
من أماكن تنتمي لها

418
00:21:39,320 --> 00:21:43,510
وسبيريتوس ليس مكاناً سلّمتُه لك فحسب

419
00:21:44,130 --> 00:21:46,090
نوي، أنت من بناه بنفسك

420
00:21:46,370 --> 00:21:47,440
...هيلا-سان

421
00:21:48,270 --> 00:21:52,240
والآن، استمرّ في بناء الكثير
من الأماكن المُريحة لنفسك

422
00:21:53,480 --> 00:21:54,560
سأفعل

423
00:22:00,480 --> 00:22:02,840
أنت! نوي! تعال إلى هنا قليلاً

424
00:22:03,100 --> 00:22:06,390
،المكان غير مُريح بوجود هذا هنا
هل يمكنني التخلُّص منه؟

425
00:22:06,390 --> 00:22:07,780
ماذا قلتَ للتو؟

426
00:22:07,780 --> 00:22:08,930
لا يمكنك ذلك