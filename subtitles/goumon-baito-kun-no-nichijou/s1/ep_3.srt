1
00:00:01,110 --> 00:00:02,760
خبيرات تعذيب؟

2
00:00:03,240 --> 00:00:04,440
قلّما تجد منهن

3
00:00:04,800 --> 00:00:07,400
إنّه عمل قذر يعتمد على القوّة الجسديّة

4
00:00:07,600 --> 00:00:08,910
حقّاً؟

5
00:00:09,610 --> 00:00:10,560
...في هذه الحالة

6
00:00:10,560 --> 00:00:13,520
رئيسة شركتنا نادرة، صحيح؟

7
00:00:14,080 --> 00:00:14,560
ماذا؟

8
00:00:15,160 --> 00:00:15,840
تقصد هيلا-سان؟

9
00:00:16,440 --> 00:00:17,780
إنّه ذكر

10
00:00:17,780 --> 00:00:18,750
!ماذا؟

11
00:00:18,750 --> 00:00:22,400
بتلك الرّموش الطّويلة والزّركشة
!وطريقة الكلام الأنثويّة؟

12
00:00:22,400 --> 00:00:26,210
إنّه عجوز يتكلّم بطريقة أنثويّة
مُزركش طويل الرّموش

13
00:00:27,360 --> 00:00:28,520
حسناً، كيف الأمور؟

14
00:00:29,340 --> 00:00:31,960
ميكي وهيو، هل تؤدّيان العمل
بصورة جيّدة؟

15
00:00:34,840 --> 00:00:36,210
يسير على ما يُرام، صحيح؟

16
00:00:36,560 --> 00:00:37,630
!أ-أجل

17
00:00:37,820 --> 00:00:38,600
أجل

18
00:00:42,920 --> 00:00:46,030
لكن ما زلتُ أراه كامرأة

19
00:00:49,520 --> 00:00:50,720
مهلاً لحظة من فضلكم

20
00:00:51,000 --> 00:00:51,600
مرحباً؟

21
00:00:52,780 --> 00:00:53,640
ماذا؟

22
00:00:53,640 --> 00:00:57,080
أتعتقد بأنّني سأدع موظّفيّي الأحبّاء
يقومون بعمل كهذا؟

23
00:00:57,080 --> 00:00:59,230
لا تستهن بشركة عظيمة
!أيّها الأبله التّافه

24
00:00:59,230 --> 00:01:00,700
إنّه ذكَر

25
00:02:36,170 --> 00:02:39,630
انظر. إنّهما خائفان

26
00:02:39,630 --> 00:02:42,270
هيلا-سان، كلّ هذا لأنّك انتقلت
لوضع الرّجل العجوز

27
00:02:42,830 --> 00:02:45,060
"أطلِق عليه بـ"وضع رئيس الشّركة

28
00:02:45,340 --> 00:02:47,710
هل كان طلباً آخر لتعذيب شخص عاديّ؟

29
00:02:47,920 --> 00:02:49,110
أجل، صحيح

30
00:02:49,110 --> 00:02:50,480
شخص عاديّ؟

31
00:02:50,710 --> 00:02:51,380
أجل

32
00:02:51,720 --> 00:02:53,510
في العادة، الوحيدون الّذين
يُسمَح بتعذيبهم

33
00:02:53,510 --> 00:02:55,600
هم أشرار مُعترَف بهم، صحيح؟

34
00:02:55,600 --> 00:02:59,450
لكن هناك أعضاء فاسدون في المجال
يعذّبون أشخاص عاديّين

35
00:02:59,660 --> 00:03:03,160
لا نقبل إلّا طلبات من جهات
نثق بها ضمنيّاً

36
00:03:03,570 --> 00:03:06,920
ما يجعلنا شركة التّعذيب الأكثر نقاء
في هذا المجال

37
00:03:07,160 --> 00:03:10,120
ومعنى هذا أنّنا نستطيع التّعذيب
!بملء إرادتنا

38
00:03:10,450 --> 00:03:12,000
مُذهل

39
00:03:13,490 --> 00:03:14,700
...إذاً، المعذرة

40
00:03:14,890 --> 00:03:15,630
تفضّل؟

41
00:03:16,280 --> 00:03:19,020
حضرة الرّئيس، لماذا تلبس كامرأة؟

42
00:03:19,020 --> 00:03:21,250
لا تطرح أسئلة لست بحاجة لمعرفتها

43
00:03:21,250 --> 00:03:22,440
لكن لماذا؟

44
00:03:22,440 --> 00:03:25,110
كيف له أن يكون شيئاً
لا أحتاج لمعرفته؟

45
00:03:27,140 --> 00:03:29,850
أعتقد... بأنّ هذا قدري

46
00:03:32,350 --> 00:03:35,850
يجب عليّ أن ألبس بهذه الطّريقة حتماً

47
00:03:37,120 --> 00:03:39,320
!لا بُدّ من وجود سبب عميق

48
00:03:40,250 --> 00:03:44,290
!أقصد، انظر إلى جمالي

49
00:03:47,100 --> 00:03:47,830
فهمت؟

50
00:03:47,830 --> 00:03:49,320
لم تكن بحاجة لسماع ذلك، صحيح؟

51
00:03:51,980 --> 00:03:53,000
هيلا

52
00:03:54,680 --> 00:03:57,190
هذه قائمة بالمؤونات الّتي
أريدك أن تشتري بديلاً لها

53
00:03:57,550 --> 00:03:58,560
شكراً لك

54
00:03:59,110 --> 00:04:02,680
إذاً إحدى الكراسي الكهربائيّة
توقّفت عن العمل، صحيح؟

55
00:04:03,010 --> 00:04:05,480
أعتقد سأشتري كراسي جديدة
وأستبدلها جميعها

56
00:04:06,050 --> 00:04:07,450
لا تشترِ أشياء لا نحتاجها

57
00:04:07,690 --> 00:04:09,300
ما هو مُدرَج في القائمة يكفي

58
00:04:09,300 --> 00:04:11,760
ماذا؟ لكن هذا مُملّ

59
00:04:11,760 --> 00:04:13,470
هذا هدرٌ لميزانيّتنا

60
00:04:13,470 --> 00:04:15,240
...ربّما معك حقّ، لكن

61
00:04:18,780 --> 00:04:22,360
لماذا يتكلّم سيو-سان بشكل
عفويّ مع رئيس الشّركة؟

62
00:04:23,930 --> 00:04:25,960
يعرفان بعضهما الآخر منذ زمن طويل

63
00:04:26,490 --> 00:04:29,920
قال بأنّ كليهما كانا يعملان كمُعذّبين
مُستقلّين منذ فترة طويلة

64
00:04:29,920 --> 00:04:30,920
مُستقلّان؟

65
00:04:31,460 --> 00:04:34,710
يبدو أنّ سمعتهما كانت حديث النّاس

66
00:04:34,710 --> 00:04:37,390
"لذا منحوهما لقب "سبيريتوس

67
00:04:37,720 --> 00:04:39,920
!من هنا استُمِدّ اسم الشّركة

68
00:04:40,330 --> 00:04:42,520
إنّه مُعلّم سيو-سان

69
00:04:42,840 --> 00:04:43,680
ماذا؟

70
00:04:44,070 --> 00:04:46,130
يبدو أنّه تواصل معه بطريقة ما

71
00:04:49,270 --> 00:04:49,920
!أنت

72
00:04:51,480 --> 00:04:55,480
هل أنت مهتمّ بالتّعذيب؟

73
00:04:55,680 --> 00:04:57,400
وكان مضرجاً بالدّماء آنذاك

74
00:04:57,400 --> 00:05:00,100
!هذا سيجعله مُريباً جدّاً

75
00:05:00,100 --> 00:05:01,380
هذا؟

76
00:05:01,380 --> 00:05:04,180
!لا عليك! يحدث هذا طوال الوقت

77
00:05:04,830 --> 00:05:08,570
لكن سمعتُ بأنّه عندما رأى
سيو-سان ذلك، اهتمّ به

78
00:05:09,120 --> 00:05:11,200
أعتقد بأنّ كليهما بنفس الطّبع

79
00:05:13,820 --> 00:05:16,220
من الجيّد أن نحظى بمزيد
من الفتيان النّافعين، أليس كذلك؟

80
00:05:17,000 --> 00:05:19,490
حسناً، ربّما هذا بسبب توجيهاتي

81
00:05:20,000 --> 00:05:22,960
أرغب في توجيه الفتيان الجدُد أيضاً

82
00:05:23,130 --> 00:05:25,530
لا داعي. أنا أكفي وأكثر

83
00:05:26,040 --> 00:05:26,890
ماذا؟

84
00:05:26,890 --> 00:05:29,530
لكن أعلم بأنّك تُعلّمهما التّعذيب
الّذي يعتمد على الألم فقط، صحيح؟

85
00:05:29,780 --> 00:05:33,640
.هناك أساليب أفضل من الألم
يجب أن يتعلّما ذلك

86
00:05:33,850 --> 00:05:35,780
لا تفعل. سيسيء ذلك لتربيتهما

87
00:05:36,200 --> 00:05:39,960
هل نسيت وجه سيرو عندما
حاولتَ تعليمه؟

88
00:05:39,960 --> 00:05:43,000
!بصراحة! هذا فعّال جدّاً

89
00:05:47,000 --> 00:05:49,450
...مؤلم

90
00:05:49,450 --> 00:05:51,630
ما زال هذا يؤلمني حقّاً

91
00:05:55,310 --> 00:05:57,950
لعلّي تحمّستُ زيادة عن اللّزوم

92
00:05:58,330 --> 00:05:59,860
ربّما حان الوقت

93
00:06:02,000 --> 00:06:03,110
هل ستستقيل؟

94
00:06:03,380 --> 00:06:04,520
مستحيل

95
00:06:05,850 --> 00:06:08,390
...بينما كنتَ نائماً، كنتُ أفكّر

96
00:06:09,280 --> 00:06:12,300
قد أؤسّس شركة

97
00:06:12,300 --> 00:06:12,930
ماذا؟

98
00:06:17,120 --> 00:06:18,130
!تأخّرت

99
00:06:18,570 --> 00:06:21,260
احرص على الالتزام بأوقات المُناوبة
المُشار إليها

100
00:06:21,570 --> 00:06:23,760
أنا آسف يا نوي-سان

101
00:06:23,940 --> 00:06:26,690
إذا تأخّر شخص، فهذا يُسبّب
مُشكلة للجميع

102
00:06:29,190 --> 00:06:31,920
،لتلبية طلبات الجميع بأحسن صورة

103
00:06:29,200 --> 00:06:31,920
يتلقّى هيو توبيخاً من نوي-سان

104
00:06:32,320 --> 00:06:34,450
!عليك الاحتفاظ بهذه الأدوات

105
00:06:32,320 --> 00:06:34,450
موظّف الشّركة يتّخذ الأمور بجدّية

106
00:06:34,590 --> 00:06:35,980
احرص على تذكُّر ذلك

107
00:06:36,720 --> 00:06:38,830
حسناً، حسناً، حسناً

108
00:06:38,830 --> 00:06:40,830
!انضمّ سيرو-سان للشّجار

109
00:06:41,160 --> 00:06:42,730
سأبرحك ضرباً أيّها الغبيّ

110
00:06:42,730 --> 00:06:43,840
يبدو كرجل عصابة

111
00:06:43,840 --> 00:06:47,800
تتكلّم بفوقيّة... لا تتنمّر على تلميذي

112
00:06:47,800 --> 00:06:50,590
!كُفّ عن اتّهاماتك الباطلة
كيف لهذا أن يكون تنمُّراً؟

113
00:06:50,590 --> 00:06:53,180
كلّ ما فعلتُه كان توجيه
!إنذار منطقيّ

114
00:06:53,840 --> 00:06:57,160
!سيرو-سان يغضب كثيراً لأجل هيو

115
00:06:57,160 --> 00:06:57,960
لا

116
00:06:58,190 --> 00:07:01,030
هيو قد تأخّر وسلّم أوراق العمل
بنفسه. قام بعمله

117
00:07:01,030 --> 00:07:02,520
متى ستُسلّم أوراقك؟

118
00:07:04,950 --> 00:07:06,620
سأفعلها الآن

119
00:07:07,150 --> 00:07:09,630
لم يُسلّم أوراق مُناوبته فحسب

120
00:07:16,640 --> 00:07:18,220
وما هذا؟

121
00:07:18,220 --> 00:07:19,870
يمكنك أن ترى بنفسك، أليس كذلك؟

122
00:07:20,000 --> 00:07:21,920
!سأستخدم هذا في الواقع

123
00:07:22,200 --> 00:07:24,640
قلتُ لا مُشكلة، أليس كذلك؟ انقلع الآن

124
00:07:25,120 --> 00:07:28,710
ليس وكأنّ لديّ أحد أريد تفضيله
عملي كما تعلم

125
00:07:30,730 --> 00:07:33,380
أنت شخص وحيد حقّاً، أليس كذلك؟

126
00:07:33,380 --> 00:07:34,710
كلّ ما تفعله هو التّعذيب

127
00:07:34,710 --> 00:07:35,840
اصمت

128
00:07:39,040 --> 00:07:42,550
لا يبدو أنّ نوي-سان
،مهتمّ بالتّعذيب

129
00:07:42,550 --> 00:07:44,810
لذا أتساءل عن سبب عمله هنا

130
00:07:44,980 --> 00:07:48,460
اختاره هيلا واعتنى به

131
00:07:48,460 --> 00:07:49,080
!ماذا؟

132
00:07:50,480 --> 00:07:51,850
!انظر! انظر

133
00:07:52,280 --> 00:07:54,160
!اخترتُ فتى ظريفاً

134
00:07:54,620 --> 00:07:56,920
من فضلك أعده إلى حيث وجدتَه

135
00:07:58,640 --> 00:08:02,270
سبب حميميّته هذه هو لأنّه
مُتعلّق بهيلا

136
00:08:07,140 --> 00:08:09,120
هل تجادلت مع سيرو مُجدّداً؟

137
00:08:10,280 --> 00:08:12,710
هو من يُثير الأمور ويهاجمني

138
00:08:13,520 --> 00:08:16,190
يفعل ذلك فقط كي يزعجك، صحيح؟

139
00:08:16,510 --> 00:08:18,880
!لا، هذه ليست... ليست غلطتي

140
00:08:18,880 --> 00:08:20,090
لا تفقد التّركيز

141
00:08:20,090 --> 00:08:21,450
حـ-حسناً

142
00:08:26,050 --> 00:08:27,760
هيلا، انتهيت

143
00:08:29,830 --> 00:08:31,500
كان ذلك سريعاً، أليس كذلك؟

144
00:08:32,230 --> 00:08:34,450
لا أستطيع الاعتياد على ذلك
إطلاقاً. أنا مُثير للشّفقة

145
00:08:32,690 --> 00:08:34,960
لأنّ الشّخص الجديد أبلى حسناً

146
00:08:36,080 --> 00:08:36,910
...لكن

147
00:08:37,290 --> 00:08:39,280
،أتولّى كثيراً من أوراق العمل

148
00:08:39,280 --> 00:08:41,410
!وقال هيلا-سان بأنّني مُفيدٌ جدّاً

149
00:08:42,230 --> 00:08:43,590
لا أستطيع القيام بالتّعذيب

150
00:08:44,010 --> 00:08:46,860
لكن أنا متأكّد بأنّني أكثر شخص
!يعتمد عليه هيلا-سان

151
00:08:47,670 --> 00:08:51,400
!أنت موثوق جدّاً يا سيرو
!مع أنّك وافد جديد

152
00:08:51,400 --> 00:08:53,370
حسناً، هذا سهل كما ترى

153
00:08:57,950 --> 00:09:00,240
...فقط لأنّه جيّد قليلاً في التّعذيب

154
00:09:00,530 --> 00:09:02,610
من يعتقد ذلك الجديد نفسه؟

155
00:09:07,430 --> 00:09:09,450
مرحباً

156
00:09:11,920 --> 00:09:14,670
!هذا الشّخص... لا يروقني

157
00:09:15,610 --> 00:09:17,360
أنت! أتبحث عن شِجار؟

158
00:09:17,360 --> 00:09:18,830
لم أفعل شيئاً، أليس كذلك؟

159
00:09:24,250 --> 00:09:28,720
هيلا-سان، لا أعتقد أنّه من المُمكن لي
أن أنسجم معه في نهاية المطاف

160
00:09:30,640 --> 00:09:33,170
،إنّه علاقة، "كلّما تشاجرتُما أكثر
انسجمتُما أكثر" صحيح؟

161
00:09:38,120 --> 00:09:38,840
...لكن

162
00:09:40,440 --> 00:09:44,150
لو كنتُ أستطيع التّعذيب مثل
...سيو-سان... أو سيرو

163
00:09:44,150 --> 00:09:45,380
أتساءل أحياناً

164
00:09:46,870 --> 00:09:50,360
ربّما سأكون حينها أكثر نفعاً
لك يا هيلا-سان

165
00:09:50,360 --> 00:09:52,080
عمّاذا تتكلّم؟

166
00:09:52,080 --> 00:09:54,950
نوي، لم أفكّر يوماً بأنّني أريدك
أن تعمل كمُعذِّب

167
00:09:55,960 --> 00:09:58,860
أنت الوحيد الّذي يمكنني الوثوق به
في العمل الّذي تؤدّيه الآن

168
00:09:58,860 --> 00:10:01,370
وأنت بجانبي مُباشرة وتدعمني، صحيح؟

169
00:10:01,630 --> 00:10:02,960
أعتمد عليك

170
00:10:09,540 --> 00:10:11,750
!نوي! تغيّر ضوء الإشارة

171
00:10:11,750 --> 00:10:12,900
!قُد

172
00:10:16,900 --> 00:10:18,660
فهمت بالفعل، صحيح؟

173
00:10:19,730 --> 00:10:22,100
يشعر نوي بدونيّة أمامك

174
00:10:22,100 --> 00:10:23,640
لا تستفزّه كثيراً

175
00:10:24,930 --> 00:10:28,940
قال كلّ ذلك، لكن ليس وكأنّ
للأمر علاقة بي

176
00:10:34,550 --> 00:10:35,810
تفضّل

177
00:10:37,080 --> 00:10:39,950
ما هذا؟ هل تريد منّي شيئاً؟

178
00:10:40,150 --> 00:10:42,400
!هذا سيّئ. لسبب ما، أشعر بالغضب

179
00:10:42,400 --> 00:10:43,910
لِمَ تقول هذا؟

180
00:10:46,430 --> 00:10:47,930
خذ. تقريري

181
00:10:48,480 --> 00:10:50,450
.لا أستطيع قراءة خطّ يدك
!اكتبه من جديد

182
00:10:52,370 --> 00:10:54,480
...كما توقّعت. هذا الشّخص وأنا

183
00:10:54,480 --> 00:10:56,270
!لن ننسجم أبداً

184
00:10:56,460 --> 00:10:58,650
!حسناً، انتهينا

185
00:10:59,450 --> 00:11:01,270
!اشرع في العمل أيّها الأبله

186
00:11:10,520 --> 00:11:13,850
متى سنحظى بمزيد من الموظّفين؟

187
00:11:14,220 --> 00:11:17,940
في الواقع، يمكنك غسل وجهك
أوّلاً على الأقلّ

188
00:11:18,100 --> 00:11:21,040
كم قضيّة أتولّى بمفردي هنا برأيك؟

189
00:11:21,470 --> 00:11:22,400
مهلاً، مهلاً

190
00:11:22,880 --> 00:11:24,630
سينضمّ أشخاص جدُد غداً

191
00:11:24,960 --> 00:11:26,790
سيكون شخصاً عديم الجدوى ثانية، صحيح؟

192
00:11:27,320 --> 00:11:29,540
في الواقع، نادراً ما يثبت شخص
في هذا العمل كما تعلم

193
00:11:29,540 --> 00:11:32,010
كم شخصاً لدينا استقال هذا العام؟

194
00:11:32,270 --> 00:11:33,840
ثمانية وستّون

195
00:11:39,030 --> 00:11:42,510
أنا مُندهش من أنّكم تقدّمتُم للعمل حتّى

196
00:11:46,430 --> 00:11:47,760
وأنت، هناك

197
00:11:47,760 --> 00:11:50,270
،إذا كان عليك تحمُّل الوضع على مضض
فينبغي أن تعود إلى المنزل

198
00:11:51,240 --> 00:11:53,310
...لا، أنا

199
00:11:54,930 --> 00:11:58,360
أنا قلق بشأن كيفيّة إزالة لطخات الدّماء

200
00:11:58,680 --> 00:11:59,920
أهذا ما هو قلق بشأنه؟

201
00:12:00,760 --> 00:12:03,320
اغسل نفسك بماء فاتر بدرجة
حرارة أقلّ من 30 سيلزيوس

202
00:12:03,320 --> 00:12:04,240
حقّاً؟

203
00:12:04,240 --> 00:12:05,590
!شكراً

204
00:12:08,580 --> 00:12:10,520
!تكلّم بسرعة

205
00:12:10,830 --> 00:12:13,920
أعتقد بأنّ التكلُّم سيُسهّل
!المسألة بالنّسبة لي ولك

206
00:12:17,480 --> 00:12:19,920
أنت لا تتحفّظ إطلاقاً بشأن هذا العمل

207
00:12:20,110 --> 00:12:20,990
هل أنت مُنحرف؟

208
00:12:21,160 --> 00:12:24,370
...لا، أشعر فقط بأنّه عمل ضروريّ، لذا

209
00:12:24,720 --> 00:12:26,010
أنا طبيعيّ تماماً

210
00:12:27,110 --> 00:12:30,320
لكن مُعظم النّاس كانوا ليخافوا ويهربوا

211
00:12:30,800 --> 00:12:33,570
لا يراودني ذلك الشّعور إطلاقاً

212
00:12:34,110 --> 00:12:36,270
هل هذا يعني بأنّني مُلائم
لهذا العمل؟ التّعذيب؟

213
00:12:38,200 --> 00:12:40,120
لا تكُن سعيداً لأنّك مُلائم لهذا العمل

214
00:12:45,200 --> 00:12:46,860
!صباح الخير

215
00:12:47,060 --> 00:12:48,070
صبغته؟

216
00:12:49,400 --> 00:12:51,680
تبرز اللّطخات أكثر عندما
يكون اللّون فاحتاً

217
00:12:52,610 --> 00:12:54,080
تنوي الاستمرار إذاً؟

218
00:12:54,080 --> 00:12:56,380
ماذا؟ هل تريدني أن أستقيل؟

219
00:12:56,380 --> 00:12:57,620
لا، لستُ كذلك

220
00:12:58,080 --> 00:12:59,610
،أتولّى مُختلف الأعمال القذرة

221
00:12:59,610 --> 00:13:01,570
،والتّعامل مع هذه الحثالة تُثير غضبي

222
00:13:01,570 --> 00:13:04,000
لكن القيام بأشياء لم أفعلها
!من قبل مُمتعة

223
00:13:05,040 --> 00:13:06,680
أعتقد سأثبت في هذا العمل

224
00:13:08,860 --> 00:13:12,050
في هذه الحالة، هل أدعك تخضع
لتدريب حقيقيّ؟

225
00:13:12,050 --> 00:13:13,030
حقّاً؟

226
00:13:13,500 --> 00:13:14,520
!رائع

227
00:13:15,230 --> 00:13:17,100
أتعتقد بأنّ هذا سيجعلهم
يفشون عن شيء؟

228
00:13:17,240 --> 00:13:19,480
يجدر بك أن تدع ضعيفاً كهذا
!يتكلّم بضربة واحدة

229
00:13:20,440 --> 00:13:22,690
متى ستتمكّن من فعلها بشكل صحيح؟

230
00:13:25,120 --> 00:13:26,120
تعلّم هذا في يومين

231
00:13:26,440 --> 00:13:27,690
...يـ-يومان

232
00:13:27,690 --> 00:13:29,240
!هذا الكتاب ضخم

233
00:13:29,240 --> 00:13:29,850
افعلها

234
00:13:30,420 --> 00:13:33,410
،ا-المعذرة، ليس وكأنّني سيّئ في الحفظ

235
00:13:33,410 --> 00:13:35,550
لكن أعتقد بأنّ المعلومات اختصاصيّة بحتة

236
00:13:36,310 --> 00:13:38,680
!هل ستفعلها أم لا؟ اختر

237
00:13:38,680 --> 00:13:39,620
!مُؤلم

238
00:13:39,620 --> 00:13:42,230
حـ-حسناً، في هذه الحالة، سأفعل
!المستحيل للقيام بذلك

239
00:13:42,230 --> 00:13:44,040
...وإذا نجحتُ

240
00:13:46,240 --> 00:13:47,830
...إذا نجحتُ

241
00:13:48,450 --> 00:13:50,390
فامنحني مكافأة من فضلك، اتّفقنا؟

242
00:13:50,980 --> 00:13:54,220
حسناً، حسناً. سأمنحك ما تريد

243
00:13:56,010 --> 00:13:57,190
...رغم ذلك

244
00:13:58,590 --> 00:14:01,770
هذه هي طبيعة الأمر بالنّسبة للأشخاص
الّذين يقومون بالتّعذيب، صحيح؟

245
00:14:02,370 --> 00:14:04,700
إنّها مُجرّد مودّة بدنيّة من مُعلّمك اللّطيف

246
00:14:27,730 --> 00:14:28,650
!نوي

247
00:14:29,450 --> 00:14:31,270
أين الدّليل الّذي كان هنا؟

248
00:14:32,130 --> 00:14:34,270
...لم ألمسه

249
00:14:34,460 --> 00:14:36,520
لكن ربّما أخذه سيرو معه

250
00:14:36,770 --> 00:14:37,430
ماذا؟

251
00:14:40,000 --> 00:14:42,790
رائحة الدّم واللّحم تُثير اشمئزازي

252
00:14:43,440 --> 00:14:46,150
،أعقد كنتُ أحاول جاهداً
بالعمل على كلّ تلك القضايا

253
00:14:46,860 --> 00:14:49,280
أخذتُ بعضاً من أعمال سوي دون استئذان

254
00:14:49,280 --> 00:14:50,770
أتساءل ما إن كان ذلك سيّئاً

255
00:14:51,240 --> 00:14:53,640
...لكن يبدو مشغولاً حقّاً، لذا

256
00:14:56,600 --> 00:14:58,360
هذا ليس وقت الاستراحة

257
00:14:59,000 --> 00:15:00,750
عليّ أن أدرس

258
00:15:07,960 --> 00:15:10,270
منحته مهمّة مُستحيلة أُخرى حسبما أرى

259
00:15:11,240 --> 00:15:13,960
،إن لم يكن هذا مُمكناً له
فهذه هي حدود قدراته

260
00:15:14,180 --> 00:15:15,400
أنت مُلحّ جدّاً

261
00:15:16,090 --> 00:15:17,980
إنّه يُحبّ التعلُّم، ولديه مهارات جيّدة

262
00:15:17,980 --> 00:15:20,520
الأهمّ، هو أنّه يُقدّسك

263
00:15:21,470 --> 00:15:23,480
ينبغي أن تُقدّر فتياناً أمثاله

264
00:15:24,180 --> 00:15:27,580
،كشخص لديه تلميذ جيّد
ما أقوله لا يمكن أن يكون خاطئاً

265
00:15:32,220 --> 00:15:33,520
...على ذكر الأمر، الاختبار

266
00:15:34,510 --> 00:15:35,500
كان اليوم، صحيح؟

267
00:15:40,260 --> 00:15:41,540
هذا مُخيف

268
00:15:41,540 --> 00:15:42,800
!أيّها اللّئيم

269
00:15:43,020 --> 00:15:45,260
لم تنسَ مُكافأتي، صحيح؟

270
00:15:45,440 --> 00:15:47,340
أجل. أخبرني بما تريد

271
00:15:47,550 --> 00:15:48,180
سيرو

272
00:15:50,550 --> 00:15:51,490
هذا

273
00:15:51,490 --> 00:15:52,040
ماذا؟

274
00:15:53,080 --> 00:15:57,970
.أريدك أن تناديني باسمي
هذا ما كنتُ سأطلبه

275
00:15:57,970 --> 00:16:00,130
ماذا؟ هل أنت عذراء مُتيّمة؟

276
00:16:00,510 --> 00:16:02,700
!الأمر ليس كذلك

277
00:16:02,700 --> 00:16:06,370
أخبرني هيلا-سان بأنّ بسبب استقالة
،الموظّفين بدوام جزئيّ السّريعة

278
00:16:06,370 --> 00:16:08,710
لا تتذكّر أسماءهم أبداً يا سيو-سان

279
00:16:09,650 --> 00:16:12,500
لكن أعتقد بأنّك تتذكّر اسمي

280
00:16:14,550 --> 00:16:15,560
...أنت

281
00:16:15,910 --> 00:16:16,530
!مؤلم

282
00:16:16,530 --> 00:16:18,950
هل حسبتني ساذجاً أو ما شابه؟

283
00:16:19,490 --> 00:16:20,990
أتذكّر شيئاً كهذا بالطّبع

284
00:16:22,140 --> 00:16:25,450
هذه ليست مُكافأة. اختر شيئاً آخر

285
00:16:26,710 --> 00:16:27,680
...إذاً

286
00:16:28,220 --> 00:16:30,680
سيو-سان، اجعلني تلميذك من فضلك

287
00:16:33,970 --> 00:16:35,760
لن أكون ألطف فقط لأنّك تلميذي

288
00:16:36,040 --> 00:16:36,830
!حاضر

289
00:16:38,240 --> 00:16:39,500
...ما أعنيه

290
00:16:39,720 --> 00:16:40,830
!لا تتردّد

291
00:16:40,830 --> 00:16:42,480
إلغاء عقدك غير مسموح

292
00:16:42,790 --> 00:16:44,650
!لا أنوي فعل ذلك

293
00:16:46,680 --> 00:16:49,020
السّجائر الّتي تُدخّنها؟

294
00:16:49,240 --> 00:16:49,890
أجل

295
00:16:50,260 --> 00:16:53,290
في السّابق، شعرتَ بوعكة
لعملك لساعات طويلة، صحيح؟

296
00:16:53,840 --> 00:16:56,240
،عندما تحدث مثل هذه الأمور
فاستخدم هذه كي تصمد

297
00:16:57,890 --> 00:16:59,420
لا تقبل الكثير من الأعمال لوحدك

298
00:17:01,310 --> 00:17:03,440
إذا رحلت، فهذا سيُصعّب الأمور عليّ

299
00:17:03,440 --> 00:17:05,080
تذكّر ذلك يا سيرو

300
00:17:06,090 --> 00:17:07,380
!حاضر

301
00:17:14,760 --> 00:17:18,700
مع ذلك، من المُدهش أن تتحمّل
البقاء في العمل هذه الفترة الطّويلة

302
00:17:18,700 --> 00:17:20,000
...في الواقع، هذا

303
00:17:22,090 --> 00:17:25,390
بفضل حقيقة أنّ لديّ مُعلّم جيّد، صحيح؟

304
00:17:25,580 --> 00:17:26,490
أجل، أجل

305
00:17:34,640 --> 00:17:37,910
وأنا سعيد لحصولي على تلميذ جيّد

306
00:17:39,400 --> 00:17:41,960
من المؤكّد أنّك لا تعتقد
ذلك إطلاقاً، صحيح؟

307
00:17:42,200 --> 00:17:45,050
لكن أصبحتُ يداً يمنى مُفيدة، ألستُ كذلك؟

308
00:17:45,230 --> 00:17:47,130
بالكاد تمكّنتَ من أن تصبح يداً يمنى

309
00:17:47,130 --> 00:17:48,680
أنت مُلحٌّ جدّاً

310
00:17:52,420 --> 00:17:53,440
!أعمال كثيرة

311
00:17:53,440 --> 00:17:56,220
سيو-سان، ماذا ينبغي أن أفعل تالياً؟

312
00:17:57,070 --> 00:17:58,590
هذا كلّ ما تبقّى

313
00:17:58,590 --> 00:18:00,280
!ما زال هناك كلّ هذه الأعمال؟

314
00:18:00,720 --> 00:18:03,610
الأمر صعب حقّاً عندما لا يكون
سيرو-سان موجوداً

315
00:18:03,790 --> 00:18:05,670
هل هو غائب اليوم أيضاً؟

316
00:18:06,200 --> 00:18:07,030
أجل

317
00:18:07,030 --> 00:18:08,440
يبدو أنّه سيغيب لفترة

318
00:18:08,440 --> 00:18:09,150
ماذا؟

319
00:18:12,400 --> 00:18:13,810
أنا مُرهَق

320
00:18:14,560 --> 00:18:15,650
أجل

321
00:18:15,650 --> 00:18:16,870
أحسنت صنعاً

322
00:18:17,110 --> 00:18:19,100
أنفق هذا لأكل طعام لذيذ ما
في الطّريق إلى المنزل

323
00:18:19,100 --> 00:18:20,640
!لا! لا أستطيع

324
00:18:20,990 --> 00:18:22,070
...ا-المعذرة

325
00:18:22,400 --> 00:18:25,290
لماذا يأخذ سيرو إجازة؟

326
00:18:26,930 --> 00:18:30,120
هل يمكنني أخذ إجازة طويلة
في نهاية الشّهر؟

327
00:18:30,730 --> 00:18:31,600
هل هناك شيء ما يجري؟

328
00:18:32,300 --> 00:18:34,500
...في الحقيقة

329
00:18:35,170 --> 00:18:37,770
لم يقدّم سبباً فعليّاً

330
00:18:37,770 --> 00:18:40,670
لكن هذا نمط سلوكيّ لشخص
!يريد أن يستقيل

331
00:18:40,670 --> 00:18:42,320
ما هذا الكلام الّذي تتفوّه به؟

332
00:18:42,630 --> 00:18:44,230
اهدأ وفكّر في الأمر

333
00:18:44,640 --> 00:18:47,360
لا سبب يدفعه لاعتزال هذا العمل، صحيح؟

334
00:18:47,960 --> 00:18:49,450
سبب؟

335
00:18:50,310 --> 00:18:52,360
!هذا سيّئ! هناك الكثير

336
00:18:52,560 --> 00:18:53,600
حقّاً؟

337
00:18:53,600 --> 00:18:54,580
هناك الكثير؟

338
00:18:56,750 --> 00:19:00,140
!سيو-سان، هذا لأنّك لستَ لطيفاً معه

339
00:19:00,140 --> 00:19:01,080
!توقّف

340
00:19:01,080 --> 00:19:03,370
...لكن، لكن

341
00:19:03,930 --> 00:19:05,040
توقّف

342
00:19:05,380 --> 00:19:06,000
حاضر

343
00:19:07,840 --> 00:19:09,160
لكن أعتقد بأنّنا ربّما اعتمدنا

344
00:19:09,160 --> 00:19:12,360
على سيرو-سان كثيراً وشكّلنا
عبئاً كبيراً عليه

345
00:19:13,880 --> 00:19:17,320
سيو-سان، لنكُن ألطف معه، اتّفقنا؟

346
00:19:17,320 --> 00:19:19,340
نكون ألطف معه؟

347
00:19:19,540 --> 00:19:21,420
ما الّذي يمكنني فعله أكثر
ممّا فعلتُه حقّاً؟

348
00:19:21,720 --> 00:19:22,340
ماذا؟

349
00:19:26,340 --> 00:19:28,760
!آسف لأنّني أخذتُ إجازة لبعض الوقت

350
00:19:29,020 --> 00:19:31,240
!سيرو-سان

351
00:19:32,010 --> 00:19:34,480
!سأعمل بجدّ حقّاً في هذا العمل

352
00:19:34,480 --> 00:19:38,660
سأسرع وأصبح مُعذّباً مُتكاملاً
!كي لا أشكّل عبئاً عليك

353
00:19:38,170 --> 00:19:39,400
حـ-حسناً

354
00:19:39,670 --> 00:19:42,590
وأنا سأعمل بجدّ... وذلك كي أكون
على ما يُرام عند رؤية دماء

355
00:19:42,900 --> 00:19:44,870
!سيرو-سان

356
00:19:44,870 --> 00:19:46,680
ماذا حدث لهما؟

357
00:19:49,090 --> 00:19:51,810
المعذرة، ألا يبدوان غريبي أطوار؟

358
00:19:53,470 --> 00:19:56,000
!سيو-سان، كُن لطيفاً

359
00:19:56,000 --> 00:19:57,760
!لنستمع إلى همومه

360
00:19:57,960 --> 00:20:01,510
...وبخصوص سبب طلبي لإجازة

361
00:20:02,000 --> 00:20:02,800
ما هو؟

362
00:20:03,090 --> 00:20:05,400
،إن كنتَ قلقاً بشأن شيء
فيمكنك أن تخبرني

363
00:20:08,560 --> 00:20:10,570
!هذا مُخيف! مُخيف! مُخيف

364
00:20:11,800 --> 00:20:13,140
أنا؟ أستقيل؟

365
00:20:13,140 --> 00:20:14,710
!لا، مستحيل

366
00:20:14,710 --> 00:20:17,920
،لكن أقصد بأنّه عمل قذر
...وهو بدنيّ حقّاً

367
00:20:18,230 --> 00:20:20,540
ويا سيرو-سان، أنت ضحيّة مُضايقة سلطويّة

368
00:20:20,540 --> 00:20:21,180
أنت

369
00:20:21,590 --> 00:20:24,450
ونحن الاثنان ما زلنا عديمي الخبرة

370
00:20:25,120 --> 00:20:27,340
لذا كنّا نتساءل ما إن كنّا عقبة

371
00:20:28,190 --> 00:20:30,630
!إطلاقاً

372
00:20:30,850 --> 00:20:34,080
،عندما كنتُ أنا وسيو-سان فقط
كان العمل مُرهقاً جدّاً

373
00:20:34,320 --> 00:20:36,540
إذاً لماذا أخذت إجازة؟

374
00:20:38,040 --> 00:20:40,170
!في الواقع، يسرّني أنّك سألت

375
00:20:40,500 --> 00:20:41,760
!مُفاجأة

376
00:20:42,160 --> 00:20:44,120
!مُدرّب تعذيب، الدّرجة الأولى

377
00:20:44,370 --> 00:20:46,680
أريد الخضوع لهذا الامتحان

378
00:20:47,010 --> 00:20:49,840
!بهذا، أستطيع تعليمك كلّ شيء

379
00:20:50,660 --> 00:20:53,350
ميكي، هيو، إذا كان هذا يُساهم في توسيع
،عدد الأشياء الّتي يمكنكما فعلها

380
00:20:53,350 --> 00:20:55,350
فهذا سيُسهّل الأمور على سيو-سان أيضاً

381
00:20:55,530 --> 00:20:59,190
ظننتُ أنّ هذا قد يُفاجئك، لذا
رحتُ وتقدّمتُ له سرّاً

382
00:21:01,230 --> 00:21:03,140
!أنت

383
00:21:04,120 --> 00:21:05,150
ماذا؟

384
00:21:05,330 --> 00:21:08,860
!لكن يسرّني أنّك لن تستقيل

385
00:21:09,770 --> 00:21:12,040
لِمَ أستقيل أصلاً؟

386
00:21:12,260 --> 00:21:13,780
...لديّ تلميذان ظريفان

387
00:21:14,280 --> 00:21:16,370
...وسينباي مُخيف جدّاً

388
00:21:16,790 --> 00:21:19,930
وهناك أيضاً ذلك الرّئيس غريب
الأطوار ومُوظّف بدوام كامل مُزعج

389
00:21:20,560 --> 00:21:24,600
!أعشق كلّ شيء يخصّ هذا العمل

390
00:21:25,450 --> 00:21:27,100
!سيرو-سان

391
00:21:27,930 --> 00:21:29,320
!إذاً، لنبدأ

392
00:21:29,520 --> 00:21:32,220
هناك بعض أساليب التّعذيب الّتي
أريدك أن تُعلّمني إيّاها

393
00:21:32,450 --> 00:21:34,910
!أنتم ظُرفاء حقّاً

394
00:21:38,450 --> 00:21:42,190
سيو-سان، هل كنت قلقاً
من استقالتي أيضاً؟

395
00:21:42,560 --> 00:21:43,930
لم أكن كذلك أيّها الأبله

396
00:21:44,120 --> 00:21:46,850
لا أتخيّلك حتّى تؤدّي أيّ عمل آخر

397
00:21:46,850 --> 00:21:49,690
!سيو-سان، من فضلك. لستُ مثلك

398
00:21:49,690 --> 00:21:52,040
تعلم بأنّني أدّيتُ كثيراً من
الأعمال الأُخرى، صحيح؟

399
00:21:52,040 --> 00:21:52,890
ماذا؟

400
00:21:52,890 --> 00:21:55,210
سيرو-سان، ما العمل الّذي قمتَ به؟

401
00:21:55,320 --> 00:21:57,050
أريد أن أعرف أيضاً

402
00:21:57,540 --> 00:21:58,960
حسناً، لنرَ

403
00:22:02,920 --> 00:22:05,180
أجل، أجل. لنبدأ بالعمل

404
00:22:05,660 --> 00:22:07,180
!بكلّ تأكيد

405
00:22:05,660 --> 00:22:07,180
!حاضر