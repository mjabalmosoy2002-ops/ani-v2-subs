هذا يعني أنّ الأخوين أوكومورا
.نفليم يحملان دماء عزازيل

177
00:12:22,240 --> 00:12:24,700
...آسيا وجهنّم

178
00:12:25,010 --> 00:12:26,860
...إنّ هذا العالم

179
00:12:27,180 --> 00:12:28,260
.ريوجي

180
00:12:29,020 --> 00:12:30,540
.عليك أن ترتاح قليلاً

181
00:12:31,340 --> 00:12:33,560
.سأتولّى أمر الباقي

182
00:12:33,940 --> 00:12:35,440
!مهلاً لحظة

183
00:12:36,400 --> 00:12:39,880
!كلّ ما فعلتَه منذ عودتنا هو الأكل والنّوم

184
00:12:40,020 --> 00:12:41,240
!قم ببعض التّحرّيّات

185
00:12:41,400 --> 00:12:44,640
.عندما أجد نفسي عالقًا، أنام

186
00:12:44,820 --> 00:12:46,830
.سيكون هذا حالي لبعض الوقت

187
00:12:47,600 --> 00:12:51,640
يقيم أصدقائي من المدرسة الخاصّة
.حفلة ميلاد مجيد غدًا

188
00:12:51,820 --> 00:12:52,980
أيمكنني الذّهاب؟

189
00:12:53,180 --> 00:12:54,860
.يبدو ذلك جيّدًا. اذهب

190
00:12:55,940 --> 00:13:01,380
،اسمع، حتّى إن أعطيتك أمرًا
.فلستَ مضطرًّا لاتّباعه

191
00:13:02,140 --> 00:13:04,400
.عليك أن تعرف متى عليك أن تتكاسل

192
00:13:04,660 --> 00:13:07,980
إنّ أخذ كلّ شيء على محمل الجدّ
.سيؤدّي بك إلى الجنون

193
00:13:10,580 --> 00:13:11,820
.مفهوم

194
00:13:12,980 --> 00:13:15,180
.سأرتاح لبقيّة اليوم

195
00:13:15,500 --> 00:13:17,020
.تُصبح على خير

196
00:13:19,920 --> 00:13:21,570
.جهّزتُ الشّجرة سلفًا

197
00:13:23,280 --> 00:13:25,160
.إنّ ني-تشان أسفلها

198
00:13:25,340 --> 00:13:26,620
.إنّها شجرة حقيقيّة

199
00:13:27,740 --> 00:13:29,320
.أنت بارع في هذا يا سوغورو-كُن

200
00:13:29,640 --> 00:13:33,380
.اعتدنا صنع هذه عندما كنّا أطفالاً

201
00:13:33,820 --> 00:13:35,090
.يُشعرني هذا بالحنين

202
00:13:36,080 --> 00:13:40,040
،لم نكن أنا وأخي بارعين في ذلك

203
00:13:40,240 --> 00:13:42,090
.لكنّ والدنا كان يعلّقها في كلّ الأحوال

204
00:13:42,680 --> 00:13:44,600
."كان يقول "الكمّيّة خير من الجودة

205
00:13:45,260 --> 00:13:48,200
.لذلك السّبب لم نتحسّن في صنعها أبدًا

206
00:13:51,420 --> 00:13:52,540
ما الخطب؟

207
00:13:53,350 --> 00:13:56,280
.لا شيء. بدت قصّة مؤثّرة فحسب

208
00:13:56,720 --> 00:13:59,300
.سأعلّق هذه على الشّجرة

209
00:14:00,740 --> 00:14:01,860
.أبي

210
00:14:02,400 --> 00:14:06,540
أبي. أين هما والدانا الحقيقيّين؟

211
00:14:07,680 --> 00:14:12,030
.هكذا إذًا. جاء هذا اليوم أخيرًا

212
00:14:15,680 --> 00:14:20,780
وجدتُكما تحت جسر في صباح
.الـ27 من ديسمبر

213
00:14:21,140 --> 00:14:23,260
.لا أعرف من هما والداكما

214
00:14:24,480 --> 00:14:28,460
.ولكن لا يوجد ما يدعو للقلق ما دمتنا معي

215
00:14:28,660 --> 00:14:30,600
.اغسلا أسنانكما واخلدا للنّوم

216
00:14:32,840 --> 00:14:34,060
.إنّها كذبة

217
00:14:34,400 --> 00:14:36,310
.لا بدّ أنّه يعرف

218
00:14:36,520 --> 00:14:38,000
لماذا لا يُخبرنا؟

219
00:14:38,320 --> 00:14:41,280
.إن قال أنّه لا يعرف، فإنّه لا يعرف

220
00:14:42,620 --> 00:14:44,360
.لستُ بحاجة لأعرفهما

221
00:14:45,580 --> 00:14:46,840
لماذا؟

222
00:14:47,460 --> 00:14:50,200
لماذا لا يريد أخي أن يعرف من يكونان؟

223
00:14:53,860 --> 00:14:57,500
.أريد أن أعرف

224
00:15:07,880 --> 00:15:09,800
.أنا أوّل الواصلين

225
00:15:10,680 --> 00:15:12,600
.شكرًا يا ني-تشان

226
00:15:12,980 --> 00:15:14,620
.سأقدّم لك بعض الماء الآن

227
00:15:31,260 --> 00:15:32,460
!احذروا

228
00:15:35,060 --> 00:15:36,700
!شيمي –
ماذا حدث؟ –

229
00:15:36,840 --> 00:15:37,860
حريق؟

230
00:15:39,060 --> 00:15:41,260
.الكعكة؟ إنّها بخير

231
00:15:46,180 --> 00:15:48,320
!إيزومو-تشان

232
00:15:53,060 --> 00:15:57,100
.ني-تشان كائن حيّ

233
00:15:58,180 --> 00:16:01,160
.لذلك من الطّبيعيّ أن يستدير أثناء نومه

234
00:16:01,860 --> 00:16:03,280
...ني-تشان

235
00:16:07,520 --> 00:16:11,680
.لا أصدّق هذا
.اختفى كلّ شيء في رمشة عين

236
00:16:12,680 --> 00:16:15,060
كيف؟ كيف؟

237
00:16:16,400 --> 00:16:18,360
.لا فائدة من الصّبية أبدًا

238
00:16:17,500 --> 00:16:20,040
.كما أنّ هنالك الكثير من غزلان الرّنّة هنا

239
00:16:18,560 --> 00:16:20,040
هل أنت بخير؟

240
00:16:20,240 --> 00:16:22,320
.إنّها تُكلّف 300 ينّ فحسب

241
00:16:22,440 --> 00:16:24,550
.حسنًا، ما زال هنالك طعام

242
00:16:24,800 --> 00:16:26,550
.سنقيم حفلة يخنة

243
00:16:26,860 --> 00:16:30,380
!عيد ميلاد مجيد وأعياد مولد سعيدة لي

244
00:16:30,580 --> 00:16:32,050
أليس المفروض "لنا"؟

245
00:16:52,900 --> 00:16:56,410
.سنُرزق أنا وماموشي بمولود

246
00:16:56,620 --> 00:16:58,240
!فعلاً؟ تهانينا لكما

247
00:16:58,420 --> 00:16:59,940
!تهانينا لكما

248
00:17:00,080 --> 00:17:01,300
.مرحبًا بالجميع

249
00:17:01,780 --> 00:17:02,780
!نوري-تشان

250
00:17:02,940 --> 00:17:04,280
!من معك؟

251
00:17:05,600 --> 00:17:07,900
!إلى اللّقاء –
.تصبحون على خير –

252
00:17:08,160 --> 00:17:09,630
.كدتُ أنسى

253
00:17:09,880 --> 00:17:11,940
.لديّ هدايا للجميع

254
00:17:12,120 --> 00:17:14,130
.قطفتُها البارحة ولا تزال نضرة

255
00:17:14,900 --> 00:17:17,390
.تميمة نبتة نفل رباعيّة

256
00:17:17,620 --> 00:17:19,890
.واثقة أنّها ستكون مفيدة لكم

257
00:17:20,080 --> 00:17:22,150
.حظًّا سعيدًا لكم في الامتحانات

258
00:17:22,920 --> 00:17:24,180
ما هذا؟

259
00:17:24,880 --> 00:17:26,720
هديّة وداع؟

260
00:17:27,640 --> 00:17:30,740
،لطالما قلتِ أنّك تريدين أن تصيري طاردة أرواح

261
00:17:30,980 --> 00:17:32,610
ولكنّك ستموتين الآن؟

262
00:17:33,000 --> 00:17:35,420
!أ-أنا لن أموت

263
00:17:36,000 --> 00:17:38,030
.آسفة لأنّي لم أشرح لكم الوضع

264
00:17:38,320 --> 00:17:40,900
.لكنّي لن أموت ولن أرحل

265
00:17:41,300 --> 00:17:42,860
.سأظلّ هنا

266
00:17:43,700 --> 00:17:45,880
،لن أستطيع القتال إلى جانبكم

267
00:17:46,040 --> 00:17:48,040
.لكنّي سأدعمكم من متجر فوتسومايا

268
00:17:51,080 --> 00:17:54,820
.إنّ شيمي تُقلقني، لكنّي استمتعت

269
00:17:55,400 --> 00:17:56,620
.لكنّي متعب

270
00:17:56,980 --> 00:17:59,660
لكنّ إقامة حفلات كهذه
.من وقت لآخر ليس سيّئًا

271
00:18:00,400 --> 00:18:01,520
.معك حقّ

272
00:18:02,120 --> 00:18:05,400
.لقد شربتُ الكثير ثانية

273
00:18:05,560 --> 00:18:06,820
.أريد بعض الماء

274
00:18:08,540 --> 00:18:11,080
.إنّكما في السّادسة عشرة الآن

275
00:18:11,260 --> 00:18:16,860
،بما أنّي أرتدي هذا الزّيّ
ألا تريدان هديّة من ماما نويل؟

276
00:18:17,860 --> 00:18:20,100
.لا أقصد أيّ شيء منحرف بالطّبع

277
00:18:22,780 --> 00:18:26,750
.في الحقيقة، لقد قابلتُ والدتكما من قبل

278
00:18:27,260 --> 00:18:28,750
.لمرّة فحسب

279
00:18:29,640 --> 00:18:31,520
.اسمها يوري إغين

280
00:18:33,580 --> 00:18:34,600
!أتقولين الحقيقة؟

281
00:18:35,260 --> 00:18:38,300
،لا أردي ما الّذي تتوقّعانه
.لكنّه لم يكن بالأمر المهمّ

282
00:18:38,560 --> 00:18:40,280
.كنتُ مجرّد طفلة أنا أيضًا

283
00:18:40,500 --> 00:18:41,660
أتريدان أن أخبركما؟

284
00:18:41,820 --> 00:18:45,320
.بالطّبع. لا يعرف الكثيرون من هي والدتنا

285
00:18:46,140 --> 00:18:47,200
.نعم

286
00:18:48,040 --> 00:18:49,580
،قبل 18 سنة

287
00:18:49,820 --> 00:18:52,840
لم يعرف شيرو ماذا يفعل بي
.بعد إنقاذي من هاتشيرو

288
00:18:53,060 --> 00:18:55,560
لذلك كان أوّل شيء قام به
.هو أخذي إلى يوري

289
00:18:55,960 --> 00:18:58,000
.يوري، أحتاج خدمة منك

290
00:19:00,180 --> 00:19:01,720
.فقط إن أسديتني خدمة لاحقًا

291
00:19:02,660 --> 00:19:05,580
.أيمكنك فعل شيء حيال هذه الشّقيّة المتّسخة

292
00:19:05,860 --> 00:19:08,320
.لا أعرف ماذا أفعل بها

293
00:19:08,500 --> 00:19:09,720
...يا إلهي

294
00:19:11,420 --> 00:19:12,500
.شكرًا لك

295
00:19:12,660 --> 00:19:13,660
.العفو

296
00:19:13,820 --> 00:19:17,210
،كنتُ سآخذ حمّامًا أنا أيضًا
.لا مشكلة في ذلك

297
00:19:18,480 --> 00:19:21,380
.يا لجمال شعرك الأحمر

298
00:19:35,800 --> 00:19:37,020
أكان لذيذًا؟

299
00:19:38,460 --> 00:19:39,480
.يوري

300
00:19:40,080 --> 00:19:42,760
هل يمكنك الاعتناء بها؟

301
00:19:43,480 --> 00:19:45,830
أنا لا يمكنني ذلك. تفهمين، صحيح؟

302
00:19:46,140 --> 00:19:49,020
.إن لم تستطيعي، سيكون عليّ تركها في ملجأ

303
00:19:49,300 --> 00:19:51,020
...فلا أريد أن –
!كلاّ –

304
00:19:51,180 --> 00:19:52,330
.اتركيني يا شقيّة

305
00:19:53,500 --> 00:19:55,080
.إنّها تفضّلك أنت

306
00:19:55,380 --> 00:19:57,270
.ستغضب عليّ كثيرًا أن فرّقتُكما

307
00:19:58,620 --> 00:20:00,890
أتريد العيش معي هنا؟

308
00:20:02,580 --> 00:20:06,390
.ستكون الأب، وسأكون أنا الأمّ

309
00:20:06,620 --> 00:20:07,920
.يبدو هذا ممتعًا

310
00:20:09,660 --> 00:20:11,500
.قطعًا لا

311
00:20:12,400 --> 00:20:14,960
.حتّى وإن كان مزاحًا أيّتها المنحرفة

312
00:20:15,540 --> 00:20:16,880
...هكذا إذًا

313
00:20:17,600 --> 00:20:19,360
.واثقة أنّ ذلك سيكون رائعًا

314
00:20:20,780 --> 00:20:25,620
.كانت أمّكما مليئة بالحياة ولطيفة وجميلة

315
00:20:26,420 --> 00:20:29,380
.ظننتُ أنّي مستحيل أن أصير من مستواها

316
00:20:30,720 --> 00:20:32,840
.كانت عيناها تشبهان عينا رين

317
00:20:33,620 --> 00:20:36,630
.وكانت لها شامات على وجهها مثلك يا يوكيو

318
00:20:37,100 --> 00:20:39,380
.هذا كلّ ما لديّ لأخبركما به

319
00:20:40,840 --> 00:20:44,400
.عيد مولد سعيد لكما يا رين ويوكيو

320
00:20:47,220 --> 00:20:48,840
أخي، هل أنت مستيقظ؟

321
00:20:51,100 --> 00:20:53,920
ما رأيك فيما عرفناه عن أمّنا؟

322
00:20:54,100 --> 00:20:55,620
ما رأيي؟

323
00:20:56,140 --> 00:20:59,080
.لم أكن أعرف حتّى اسم أمّنا

324
00:20:59,380 --> 00:21:03,320
أنا مسرور لمعرفة أنّها موجودة
.بالفعل على الأقلّ

325
00:21:05,120 --> 00:21:09,280
أخي، هل تريد أن تعرف كيف
أتينا إلى هذا العالم؟

326
00:21:11,720 --> 00:21:15,680
يعتبرها التّنظيم مجرمة
،لأنّها أنجبت أطفالاً مع ساتان

327
00:21:15,860 --> 00:21:18,200
.ومعظم المعلومات عن ذلك سرّيّة

328
00:21:18,880 --> 00:21:24,240
أريد أن أعرف ظروف ولادتنا
.ولماذا الأمر سرّيّ

329
00:21:25,820 --> 00:21:28,550
هل ما زلت تعتقد أنّ لا ضرورة من ذلك؟

330
00:21:30,280 --> 00:21:31,660
.ذلك صحيح

331
00:21:31,840 --> 00:21:34,400
.واثق أنّها لن تكون قصّة لطيفة

332
00:21:34,600 --> 00:21:37,040
.لن نكتسب أيّ شيء إن عرفناها

333
00:21:37,300 --> 00:21:41,200
عرفنا في عيد مولدنا أنّ أمّنا
...كانت جميلة ولطيفة

334
00:21:41,340 --> 00:21:42,740
.ذلك كافٍ بالنّسبة لي

335
00:21:44,040 --> 00:21:45,240
إلى أين ستذهب؟

336
00:21:45,820 --> 00:21:46,830
.للحمّام

337
00:21:47,080 --> 00:21:48,340
!لا تعبث معي

338
00:21:48,780 --> 00:21:50,260
عيد مولدنا؟

339
00:21:50,520 --> 00:21:53,020
!لا نعرف حتّى في أيّ يوم وُلدنا

340
00:21:53,960 --> 00:21:57,210
إنّك تندفع لمعرفة مثل هذه الأشياء
!بدون تفكير مسبق في العادة

341
00:21:57,560 --> 00:22:00,010
لماذا لا أرى أيّ حماسة منك
حيال هذا الأمر؟

342
00:22:00,220 --> 00:22:02,000
!من الجبان بيننا الآن؟