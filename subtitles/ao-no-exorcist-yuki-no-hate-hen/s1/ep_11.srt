1
00:01:30,390 --> 00:01:34,490
!هذا مذهل! شكرًا على حسن الضّيافة

2
00:01:34,730 --> 00:01:39,280
!حتّى أنّكم كبّلتموني بمُلغي سحر
!أشعر أنّي مجرم حقيقيّ الآن

3
00:01:39,280 --> 00:01:40,950
!هذا مذهل

4
00:01:40,950 --> 00:01:44,910
سيُقام الاجتماع غدًا. ابق هنا بدون
.إحداث أيّ جلبة حتّى ذلك الحين

5
00:01:44,910 --> 00:01:47,290
ماذا؟ أستغادر يا أوسيولا؟

6
00:01:45,000 --> 00:01:51,000
الحلقة 11   [ما وراء الثّلج]

7
00:01:47,290 --> 00:01:51,000
،ظهر دولاهان في روما
.والمدينة في حالة هلع

8
00:01:51,790 --> 00:01:53,880
.سأذهب إلى هناك لتولّي القيادة

9
00:01:54,330 --> 00:01:58,130
ذهبت يانغ لطرد حشود الغريملين
في لوس أنجلوس

10
00:01:58,130 --> 00:02:03,900
بينما ذهب الفارس المقدّس إلى مخيّم مراقبة بوّابة
.جهنّم الاصطناعيّة الّذي يتعرّض للهجوم من اليتّي

11
00:02:04,310 --> 00:02:08,020
وحتّى الآن، لم تظهر هذه الشّياطين
...عالية المستوى من قبل

12
00:02:08,020 --> 00:02:09,650
.في الأماكن ذات الكثافة السّكّانيّة العالية

13
00:02:09,970 --> 00:02:11,070
.نعم

14
00:02:11,350 --> 00:02:15,160
كان تاريخ انتهاء صلاحية حاجز
مفيستو في شهر فبراير، أليس كذلك؟

15
00:02:15,480 --> 00:02:19,160
ألا يضع إينجل نفسه في خطر بتواجده
أمام بوّابة جهنّم الاصطناعيّة؟

16
00:02:21,020 --> 00:02:24,170
.آمل فقط ألاّ يحدث أمر لم نشهد له مثيلاً من قبل

17
00:02:25,040 --> 00:02:28,540
محلّ إقامة رئيس وزراء اليابان — 1/2 00:35

18
00:02:29,160 --> 00:02:31,210
ما الّذي سيحدث؟

19
00:02:31,210 --> 00:02:36,050
واضح تمامًا أنّ تولّي مثل هذه الأمور قبل
!أن تصيرَ أزماتٍ حقيقيّة من واجبك أنت

20
00:02:36,050 --> 00:02:41,550
لم تتحوّل إلى أزمات أبدًا لأنّ البشر
.لا يستطيعون رؤية الشّياطين في العادة

21
00:02:41,960 --> 00:02:43,680
...ذلك لأنّ عدد البشر

22
00:02:43,680 --> 00:02:47,270
القادرين على رؤيتها بوضوح كان دائمًا
.أقلّ من 1% من إجماليّ السّكان

23
00:02:47,270 --> 00:02:49,060
.لكنّ ذلك سيتغيّر من الآن فصاعدًا

24
00:02:49,060 --> 00:02:53,280
وقريبًا، سنعيش في عالم حيث
.يستطيع كلّ البشر رؤية الشّياطين

25
00:02:54,430 --> 00:02:59,620
قرأتَ خطّة التّدابير المضادّة
للشّياطين الّتي وضعتُها، صحيح؟

26
00:02:59,850 --> 00:03:04,670
سبق وحذّرنا هذه اللّجنة عدّة مرّات
.من خطورة الوضع الّذي نحن فيه

27
00:03:05,070 --> 00:03:08,580
...إنّ قصّة سخيفة كهذه
!ما كان أيّ أحد ليصدّقها بالفعل

28
00:03:08,740 --> 00:03:10,410
ألا تفهم؟

29
00:03:10,410 --> 00:03:13,750
في الوقت الحاضر، فإنّ الغموض
...بشأن وجود الشّياطين

30
00:03:13,750 --> 00:03:15,840
!هو ما يسمح لنا بالحفاظ على النّظام الاجتماعيّ

31
00:03:15,840 --> 00:03:20,670
إن كشفنا عن كلّ شيء، فسنعود
!مباشرة إلى العصور المظلمة

32
00:03:20,670 --> 00:03:22,720
.نحن في طريقنا إليها سلفًا

33
00:03:22,720 --> 00:03:23,590
...ما

34
00:03:23,790 --> 00:03:26,220
...عليك التّوقّف عن نكران الأمر

35
00:03:26,220 --> 00:03:29,480
.وتبدأ في تعزيز التّدابير المناهضة للشّياطين الآن

36
00:03:32,050 --> 00:03:34,980
.اتّخذ قرارك رجاءً يا سيّدي رئيس الوزراء

37
00:03:35,180 --> 00:03:39,700
،إنّنا في تنظيم الصّليب الحقيقيّ
.سندعمك بكلّ قوّتنا

38
00:03:40,490 --> 00:03:45,160
أمام مسكن الفتيان لأكاديميّة الصّليب الحقيقيّ — 1/2 09:20

39
00:03:45,160 --> 00:03:48,660
ماذا؟ سيُلقي السّيّد فيليس كلمة
في مؤتمر صحفيّ بعد الظّهر؟

40
00:03:48,660 --> 00:03:54,040
تخطّط الحكومة لتقديم إعلان يخصّ"
"حادثة حريق وإغلاق محطّة إيكبوكورو

41
00:03:48,940 --> 00:03:54,040
هل يعني ذلك أنّه سيكشف للعلن عن وجود الشّياطين؟

42
00:03:54,870 --> 00:03:55,920
!صباح الخير

43
00:03:55,920 --> 00:03:59,000
...ماذا؟ حـ-حتّى يوكيو، إنّ ذلك

44
00:03:59,160 --> 00:04:00,760
.أنا لا أكذب

45
00:04:00,760 --> 00:04:03,260
!لقد هدّدني أوكومورا-سينسي بمسدّس

46
00:04:03,500 --> 00:04:07,300
"ما الّذي تعرفه بشأن ولادتنا أنا وأخي؟"

47
00:04:07,300 --> 00:04:10,270
"ما البحوث الّتي تقوم بها مع لايتنينغ؟"

48
00:04:11,050 --> 00:04:14,150
.لم يبدُ على طبيعته إطلاقًا

49
00:04:15,640 --> 00:04:16,520
...أخي

50
00:04:17,430 --> 00:04:20,240
هل تريد أن تعرف كيف أتينا إلى هذا العالم؟

51
00:04:20,810 --> 00:04:22,700
.أريد أن أعرف

52
00:04:22,940 --> 00:04:24,570
...يوكي-تشان

53
00:04:24,570 --> 00:04:26,710
.أخبَرني أنّه وحيدٌ تمامًا

54
00:04:27,020 --> 00:04:29,580
.وأنّ لا عائلة أو أصدقاء له

55
00:04:30,030 --> 00:04:31,660
...وأنا

56
00:04:31,660 --> 00:04:33,130
!غضبتُ عليه

57
00:04:33,990 --> 00:04:36,580
!قلتُ له أنّ ذلك ليس صحيحًا

58
00:04:37,280 --> 00:04:39,180
!لقد أفسدتُ الأمر

59
00:04:39,840 --> 00:04:42,760
لا يجب أن تلومي نفسك كثيرًا
!لا مورياما-سان

60
00:04:44,430 --> 00:04:46,140
!أوكومورا! إلى أين تذهب؟

61
00:04:46,800 --> 00:04:50,100
"مسكن الفتيان لأكاديميّة الصّليب الحقيقيّ"

62
00:04:47,090 --> 00:04:49,480
!مهلاً يا أوكومورا رين

63
00:04:50,630 --> 00:04:53,480
!يوكيو

64
00:04:53,730 --> 00:04:56,730
!ذلك الوغد

65
00:04:57,390 --> 00:04:59,020
...سنبدأ الآن

66
00:04:59,020 --> 00:05:02,150
محلّ إقامة رئيس وزراء اليابان — 1/2 13:30

67
00:04:59,020 --> 00:05:02,150
.بالمؤتمر الصّحفيّ مع رئيس الوزراء ماتودو

68
00:05:03,020 --> 00:05:04,570
،وبعد خطاب رئيس الوزراء

69
00:05:04,570 --> 00:05:08,710
سيقدّم لنا مدير فرع اليابان لفرسان
.الصّليب الحقيقيّ تفسيرًا أيضًا

70
00:05:09,580 --> 00:05:13,550
.سنستمع للأسئلة من الصّحفيّين بعد ذلك

71
00:05:14,460 --> 00:05:18,080
والآن، أرجو منك تقديم تعليقاتك بشأن
.هذه المسألة أيّها السّيّد رئيس الوزراء

72
00:05:18,080 --> 00:05:20,090
!لقد بدؤوا

73
00:05:22,250 --> 00:05:27,090
وقع انفجار واسع النّطاق
.في إيكبوكورو اللّيلة الماضية

74
00:05:27,460 --> 00:05:29,680
...وكان التّأخير في عقد هذا المؤتمر الصّحفي

75
00:05:29,680 --> 00:05:32,350
.لسبب معيّن أيضًا

76
00:05:32,920 --> 00:05:37,350
وهذا لأنّني أريد أن أبلغكم جميعًا
.أيّها المواطنون بشيء بالغ الأهمّيّة

77
00:05:38,100 --> 00:05:40,240
.استعدّوا من فضلكم واستمعوا

78
00:05:41,470 --> 00:05:43,490
...وقعت هذه الحادثة

79
00:05:44,560 --> 00:05:47,240
.بسبب كائنات معادية للمجتمع

80
00:05:47,240 --> 00:05:48,450
ماذا؟

81
00:05:48,450 --> 00:05:53,450
تعترف الحكومة اليابانيّة بموجب
.هذا بوجود كائنات معادية للمجتمع

82
00:05:53,610 --> 00:05:54,660
!مستحيل

83
00:05:54,660 --> 00:05:56,210
!كلاّ، لقد قالها

84
00:05:58,200 --> 00:06:00,330
!"كائنات معادية للمجتمع"

85
00:06:00,330 --> 00:06:01,590
!كم هذا مضحك

86
00:06:01,590 --> 00:06:04,840
هل يعني هذا أنّكم تعترفون بوجود الشّياطين؟

87
00:06:02,120 --> 00:06:04,090
!إنّ البشر ظريفين حقًّا

88
00:06:04,090 --> 00:06:04,840
نعم؟

89
00:06:04,840 --> 00:06:06,140
شيما-كُن؟

90
00:06:06,370 --> 00:06:10,840
.لديّ ما أبلغك به
.فقد أوكومورا-سينسي رشده

91
00:06:10,840 --> 00:06:14,720
!هذا يؤلم يا أوكومورا-سينسي! توقّف

92
00:06:11,340 --> 00:06:14,720
،كلّ ما فعلتُه هو الحديث معه
.لكنّه ردّ عليّ بالعنف

93
00:06:14,880 --> 00:06:17,690
أتلك هي قوى ساتان؟

94
00:06:18,300 --> 00:06:21,900
،أتقن أوكومورا-سينسي كلّ أنواع الفنون القتاليّة

95
00:06:21,900 --> 00:06:24,480
.لذلك ربّما أنت بحاجة للمزيد من التّدريب فحسب

96
00:06:24,810 --> 00:06:27,610
،يبدو أنّه حان دوري للحديث
.لذلك سأغلق الخطّ الآن

97
00:06:27,610 --> 00:06:28,540
ماذا؟

98
00:06:30,190 --> 00:06:33,740
من سيقوم بالاعتراف بها؟

99
00:06:32,480 --> 00:06:34,410
...أوكومورا-سينسي

100
00:06:33,740 --> 00:06:38,160
.الحكومة اليابانيّة والخبراء من كلّ مجال

101
00:06:34,410 --> 00:06:36,800
كيف استطعت الدّخول إلى هنا؟

102
00:06:38,160 --> 00:06:41,250
من هم هؤلاء الخبراء بالتّحديد؟

103
00:06:38,910 --> 00:06:41,250
"أوكومورا يوكيو"
"طارد أرواح شرّيرة متوسّط من المستوى الأوّل"
"فرع اليابان لأكاديميّة الصّليب الحقيقيّ"

104
00:06:39,160 --> 00:06:41,250
.ثمّة طريقة دائمًا

105
00:06:41,410 --> 00:06:43,170
أنت تعلم، صحيح؟

106
00:06:43,170 --> 00:06:44,670
.تعلم كلّ شيء

107
00:06:44,670 --> 00:06:46,260
ما الّذي تتحدّث عنه؟

108
00:06:46,260 --> 00:06:48,510
!أنا أتحدّث عن هذه العين

109
00:06:48,750 --> 00:06:50,510
!انظر

110
00:06:50,750 --> 00:06:52,760
!كم هي جميلة

111
00:06:52,760 --> 00:06:54,260
.إنّه لون ساتان

112
00:06:55,630 --> 00:06:57,270
ما الّذي يجري؟

113
00:06:57,800 --> 00:06:59,270
...هل

114
00:06:59,640 --> 00:07:02,310
ورثتُ نفس قوى أخي؟

115
00:07:01,470 --> 00:07:03,270
!اهدؤوا رجاءً

116
00:07:02,310 --> 00:07:03,270
!أجبني

117
00:07:03,270 --> 00:07:06,360
هل يعني هذا أنّ هنالك شياطين
في هذا العالم سلفًا يا سيّدي؟

118
00:07:06,360 --> 00:07:08,280
!أخبرنا بكلّ شيء

119
00:07:06,600 --> 00:07:08,280
!أنا أرفض بكلّ احترام

120
00:07:08,600 --> 00:07:10,530
!توقّفوا عن طرح المزيد من الأسئلة رجاءً

121
00:07:11,900 --> 00:07:15,530
والآن، سنرحّب بمدير فرع اليابان
...لفرسان الصّليب الحقيقيّ

122
00:07:15,530 --> 00:07:19,330
.يوهان فاوست لشرح الوضع لكم

123
00:07:19,330 --> 00:07:21,220
!إنّه دوري

124
00:07:21,870 --> 00:07:24,790
...ليس لديّ أيّ وقت لأضيّعه عليك

125
00:07:24,790 --> 00:07:26,850
.وعلى بحثك الطّفوليّ عن نفسك

126
00:07:31,500 --> 00:07:33,890
!مساء الخير أيّها المراسلون

127
00:07:33,890 --> 00:07:39,060
أنا يوهان فاوست من فرع
!اليابان لفرسان الصّليب الحقيقيّ

128
00:07:40,260 --> 00:07:42,060
!سررت بلقائكم جميعًا

129
00:07:43,510 --> 00:07:46,900
،بصفتي خبيرًا في مجالي
...فسأقدّم لكم الآن

130
00:07:46,900 --> 00:07:50,780
توضيحي التّكميليّ لهذه
...الكائنات المعادية للمجتمع

131
00:07:50,980 --> 00:07:54,070
.الّتي أشار إليها رئيس الوزراء للتّوّ

132
00:07:54,440 --> 00:07:56,580
ماذا؟ يوكيو؟

133
00:08:17,340 --> 00:08:19,350
!إنّه هو! معه مسدّس

134
00:08:19,510 --> 00:08:20,520
!أمسكوا به

135
00:08:20,520 --> 00:08:21,350
!مهلاً

136
00:08:21,510 --> 00:08:22,730
...ذلك الفتى

137
00:08:23,180 --> 00:08:25,270
.تمهّلي

138
00:08:25,270 --> 00:08:27,480
ألا يفترض بك أن تكوني حارستي؟

139
00:08:27,480 --> 00:08:29,610
.قومي بعملك رجاءً

140
00:08:29,610 --> 00:08:32,610
!أنت شيطان، لذلك ستكون بخير

141
00:08:32,610 --> 00:08:35,250
.صحيح، أعترف بصحّة ذلك

142
00:08:36,610 --> 00:08:38,460
—هذه الإصابة التّافهة

143
00:08:39,820 --> 00:08:41,040
ما هذا؟

144
00:08:42,200 --> 00:08:44,250
...مستحيل

145
00:08:44,250 --> 00:08:47,130
أخبار عاجلة: حادثة إطلاق نار"
"في محلّ إقامة رئيس وزراء اليابان

146
00:08:44,410 --> 00:08:45,580
!حادثة إطلاق نار

147
00:08:45,580 --> 00:08:49,130
وقعت حادثة إطلاق نار داخل
!مكان إقامة المؤتمر الصّحفيّ

148
00:08:49,130 --> 00:08:51,000
!تمّ إطلاق النّار على السّيّد فيليس

149
00:08:51,000 --> 00:08:53,010
ماذا؟ تعرّضوا جميعًا لإطلاق نار؟

150
00:08:53,330 --> 00:08:57,010
لا، بل كان مدير تنظيم الصّليب
.الحقيقيّ الشّبيه بالمهرّج فحسب

151
00:08:57,010 --> 00:08:59,510
"مباشر: تمّ إطلاق النّار خلال المؤتمر الصّحفيّ"
"الجاني رهن الاعتقال"

152
00:08:57,010 --> 00:08:59,510
!ماذا؟ لكنّه رجل بارز في هذه المدينة

153
00:09:00,710 --> 00:09:01,640
!يوكيو

154
00:09:01,640 --> 00:09:03,640
أيّها الفتى! ما الّذي تفعله؟
!انزل عن الطّاولة

155
00:09:03,640 --> 00:09:05,230
أخبروني، أين يحدث هذا؟

156
00:09:05,230 --> 00:09:06,900
.لا بدّ أنّه محلّ إقامة رئيس الوزراء

157
00:09:06,900 --> 00:09:09,070
...محلّ إقامة رئيس الوزراء

158
00:09:09,390 --> 00:09:11,570
!مفهوم! شكرًا لكم

159
00:09:12,030 --> 00:09:13,400
...يوكيو

160
00:09:13,400 --> 00:09:15,750
ما الّذي دهاك؟

161
00:09:16,530 --> 00:09:18,280
!مفيستو! تمالك نفسك

162
00:09:19,150 --> 00:09:21,410
...يبدو أنّي ضعفت

163
00:09:21,410 --> 00:09:24,040
...أكثر ممّا توقّعت

164
00:09:24,040 --> 00:09:25,590
.فهمت

165
00:09:26,780 --> 00:09:28,790
...كيريغاكوري-سينسي

166
00:09:29,120 --> 00:09:30,960
...على هذا المعدّل

167
00:09:30,960 --> 00:09:35,130
...سيتلاشى الحاجز مع جسدي

168
00:09:35,130 --> 00:09:37,090
...وبوّابة جهنّم الاصطناعيّة

169
00:09:37,090 --> 00:09:39,560
.ستُفتح ثانية

170
00:09:40,090 --> 00:09:42,230
.يجب أن أتجنّب أن أسقط هكذا

171
00:09:44,050 --> 00:09:49,700
.لا يمكنني التّخلّي عن هذا الجسد بعد

172
00:09:50,010 --> 00:09:52,360
.سيكون عليّ ترك الحاجز يتلاشى

173
00:09:52,930 --> 00:09:55,610
!مفهوم! سأبلغ الفاتكان في الحال

174
00:09:57,440 --> 00:09:58,960
...هذا السّيناريو

175
00:09:59,310 --> 00:10:02,580
.لم يحدث من قبل

176
00:10:03,900 --> 00:10:08,120
.لا يمكن توقّع ما قد يفعله البشر

177
00:10:08,450 --> 00:10:12,220
.وذلك ما يجعلهم ممتعين للغاية

178
00:10:22,890 --> 00:10:26,730
في مكان ما من القطب الشّماليّ   مخيّم مراقبة بوّابة جهنّم الاصطناعيّة

179
00:10:30,150 --> 00:10:33,020
!أيّها الفارس المقدّس
!لدينا مكالمة طارئة من الفاتيكان

180
00:10:33,020 --> 00:10:34,110
.أوصلهم بي

181
00:10:34,110 --> 00:10:35,030
!حاضر

182
00:10:36,980 --> 00:10:38,080
...ما

183
00:11:31,660 --> 00:11:34,960
!أخلوا المكان

184
00:11:35,090 --> 00:11:38,460
محلّ إقامة رئيس وزراء اليابان — 1/2 15:50

185
00:11:38,460 --> 00:11:40,970
!يبدو أنّ نتيجة اختبار تعقّب البارود كان سلبيّة

186
00:11:40,970 --> 00:11:44,340
كما أنّ نقطة الاصطدام لم تتطابق مع
!المكان الّذي كان يقف فيه إطلاقًا

187
00:11:44,340 --> 00:11:46,350
ألا يعني ذلك أنّه لم يكن من أطلق النّار؟

188
00:11:46,630 --> 00:11:48,930
إلى متى تنوون إبقاءه رهن الاعتقال؟

189
00:11:48,930 --> 00:11:51,850
!إنّ الجاني الحقيقيّ قد هرب سلفًا

190
00:11:51,850 --> 00:11:54,860
!إنّنا نجري تحقيقًا الآن، لذلك التزمي بالإجراءات

191
00:11:55,060 --> 00:11:58,480
!سُحقًا! لديّ جبل من الأسئلة لأطرحها عليه أيضًا

192
00:11:59,060 --> 00:12:02,280
!بصراحة، ليس لدينا وقت لهذا بالفعل

193
00:12:02,280 --> 00:12:04,750
!لا تأتوا إليّ متوسّلين إن ندمتم على هذا

194
00:12:04,980 --> 00:12:06,040
...أيّها الرّئيس

195
00:12:07,110 --> 00:12:10,130
.حصلنا على الموافقة
.يمكنك أخذه في الوقت الحاليّ

196
00:12:10,450 --> 00:12:14,120
.لكنّنا سنحقّق معه ثانية غدًا

197
00:12:19,160 --> 00:12:20,380
...أيّتها القائدة كيريغاكوري

198
00:12:20,620 --> 00:12:21,840
كيف حال مفيستو؟

199
00:12:21,840 --> 00:12:24,380
استطعنا نقله إلى محل إقامة
...يوهان فاوست

200
00:12:24,670 --> 00:12:27,510
.لكنّ الأمر سيأخذ وقتًا قبل أن يستعيد عافيته

201
00:12:27,710 --> 00:12:28,940
.مفهوم

202
00:12:29,210 --> 00:12:30,390
!يوكيو! قف

203
00:12:30,630 --> 00:12:32,190
!سنعود إلى التّنظيم

204
00:12:35,220 --> 00:12:38,020
أنت! هل تدرك ما مدى المشاكل
الّتي أنت فيها الآن؟

205
00:12:43,400 --> 00:12:44,830
...يوكيو

206
00:12:45,520 --> 00:12:46,660
...أنت

207
00:12:47,270 --> 00:12:48,880
...تلك العين

208
00:12:50,040 --> 00:12:53,160
(في مكان ما من القطب الشّماليّ   مخيّم مراقبة بوّابة جهنّم الاصطناعيّة   (بعد ساعتين

209
00:12:50,240 --> 00:12:51,370
!أخلوا المكان بسرعة

210
00:12:51,900 --> 00:12:53,920
!اهربوا إلى أقرب باب

211
00:12:57,170 --> 00:12:59,880
!فُتح الحاجز بالكامل

212
00:12:59,880 --> 00:13:01,210
ولكن لماذا؟

213
00:13:01,210 --> 00:13:04,670
أصيب مفيستو بطلق ناريّ
.وتعرّض لضرر خطير

214
00:13:05,080 --> 00:13:08,180
وبسبب ذلك، يبدو أنّه ما عاد
.بإمكانه الحفاظ على الحاجز

215
00:13:08,670 --> 00:13:12,100
بهدف إبقاء الزّمن متوقّفًا
...حول البوّابة، أنا أيضًا

216
00:13:12,100 --> 00:13:15,390
.أضع جسدي على المحكّ

217
00:13:15,390 --> 00:13:17,400
!لكنّ هذا مفاجئ جدًّا

218
00:13:17,680 --> 00:13:20,770
لقد جعل الأمر يبدو وكأنّ
!لدينا شهرًا آخر أو ما شابه

219
00:13:20,770 --> 00:13:22,240
!سُحقًا لك يا مفيستو

220
00:13:22,560 --> 00:13:23,660
...بتعبير آخر

221
00:13:24,310 --> 00:13:27,410
ستُفتح بوّابة جهنّم الاصطناعيّة ثانية؟

222
00:13:27,650 --> 00:13:29,540
أذلك ما سيحدث؟

223
00:13:30,110 --> 00:13:33,500
...أيمكن لشيء كهذا حقًّا أن

224
00:13:37,240 --> 00:13:40,710
أيّها الفارس المقدّس! ما الّذي سيحدث
للباب إن ابتلعه ذلك؟

225
00:13:40,910 --> 00:13:42,300
!أسرع رجاءً

226
00:14:17,410 --> 00:14:18,510
ما هذا؟

227
00:14:19,160 --> 00:14:20,430
!هذا غريب

228
00:14:20,700 --> 00:14:22,750
تغيّر الهواء في لمح البصر؟

229
00:14:26,760 --> 00:14:27,720
!حادثة

230
00:14:27,720 --> 00:14:29,380
!اتّصلوا بالطّوارئ

231
00:14:29,380 --> 00:14:30,680
!وحش

232
00:14:30,680 --> 00:14:32,140
وحش؟ –
ماذا؟ –

233
00:14:32,140 --> 00:14:34,390
ماذا يحدث؟

234
00:14:47,820 --> 00:14:51,490
بلدة أكاديميّة الصّليب الحقيقيّ — 1/2 15:47

235
00:14:49,100 --> 00:14:51,670
!تشعرني هذه الرّائحة بالحنين

236
00:14:53,900 --> 00:14:55,410
...على هذا المعدّل

237
00:14:55,410 --> 00:14:59,160
.سيستطيع الجميع في العالم أن يروا الشّياطين

238
00:14:59,160 --> 00:15:03,590
.قد يؤدي هذا ليصير العالم جحيمًا فعليًّا

239
00:14:59,160 --> 00:15:03,670
مقرّ الفاتيكان الرّئيسيّ   فرسان الصّليب الحقيقيّ — 1/2 14:10

240
00:15:04,540 --> 00:15:06,130
!هذا لا يُعقل

241
00:15:06,710 --> 00:15:09,720
!لا يُعقل أن أقبل بنتيجة كهذه

242
00:15:09,720 --> 00:15:13,390
أمام محلّ إقامة رئيس وزراء اليابان — 1/2 16:40

243
00:15:13,390 --> 00:15:16,720
انتهى بهم الأمر إلى تأخيرنا
!بالمعاملات الورقيّة على أيّ حال

244
00:15:16,720 --> 00:15:19,770
،بسبب وسائل الإعلام والمتظاهرين
،إضافة لهذه الضّجّة حول الشّياطين

245
00:15:19,770 --> 00:15:21,990
.أصبحت شبكة النّقل غير قابلة للاستعمال

246
00:15:22,980 --> 00:15:24,060
!رين

247
00:15:24,060 --> 00:15:24,860
شورا؟

248
00:15:25,140 --> 00:15:26,610
ما الّذي تفعله هنا؟

249
00:15:26,610 --> 00:15:28,610
رأيتُ الأخبار! أين هو يوكيو؟

250
00:15:29,390 --> 00:15:31,240
ما الّذي حدث ليوكيو؟

251
00:15:31,240 --> 00:15:34,620
...أرجوك! دعيني أراه! أنا –
!رين –

252
00:15:36,570 --> 00:15:38,370
!اهدأ واستمع لي

253
00:15:46,040 --> 00:15:46,970
ماذا؟

254
00:15:47,580 --> 00:15:49,380
.لن يعود يوكيو في الوقت الحاليّ

255
00:15:49,620 --> 00:15:52,560
لاحظتَ بنفسك كيف تغيّر العالم، صحيح؟

256
00:15:52,830 --> 00:15:56,640
أُمر الجميع فيما عدا طاردي الأرواح
.بالبقاء في منازلهم

257
00:15:56,840 --> 00:15:58,190
.عد للمنزل يا رين

258
00:15:58,420 --> 00:16:00,890
.أعلم أنّ هذا صعب، لكن عليك الانتظار

259
00:16:01,090 --> 00:16:02,440
مفهوم؟

260
00:16:20,610 --> 00:16:21,710
...أخي

261
00:16:22,200 --> 00:16:25,050
هل تريد أن تعرف كيف أتينا إلى هذا العالم؟

262
00:16:25,660 --> 00:16:26,920
.أريد أن أعرف

263
00:16:28,330 --> 00:16:31,770
.لن نكتسب أيّ شيء إن عرفنا

264
00:16:32,750 --> 00:16:34,810
لماذا أنت عازم بشدّة على معرفة ذلك؟

265
00:16:36,180 --> 00:16:39,180
"أكاديميّة الصّليب الحقيقيّ"

266
00:16:45,140 --> 00:16:46,440
!أوكومورا

267
00:16:46,440 --> 00:16:48,310
!مرحبًا بعودتك يا رين

268
00:16:48,470 --> 00:16:51,570
.أوكومورا... يبدو أنّ الأمور قد ساءت كثيرًا

269
00:16:51,570 --> 00:16:53,120
...يا رفاق

270
00:16:54,150 --> 00:16:55,620
...إنّ يوكيو

271
00:16:56,150 --> 00:17:00,410
قالوا أنّ يوكيو ربّما يكون
.قد ورث قوى ساتان

272
00:17:03,410 --> 00:17:04,410
...قالت شورا

273
00:17:04,910 --> 00:17:08,930
.أنّهم سيجرون عليه اختبارات
.لذلك قد لا يعود إلاّ بعد مدّة

274
00:17:09,660 --> 00:17:11,920
...لذلك فهو

275
00:17:13,420 --> 00:17:14,850
...لماذا

276
00:17:16,170 --> 00:17:17,550
...لم أستمع

277
00:17:17,550 --> 00:17:19,180
...له أكثر

278
00:17:19,380 --> 00:17:20,980
في ذلك اليوم؟

279
00:17:22,670 --> 00:17:24,560
!سأذهب لإنقاذ يوكيو

280
00:17:24,560 --> 00:17:25,980
!مهلاً! انتظر

281
00:17:26,800 --> 00:17:28,270
!عد إلى هنا

282
00:17:28,270 --> 00:17:30,190
لم تتغيّر على الإطلاق، صحيح؟

283
00:17:30,190 --> 00:17:33,190
!عليّ أن أتحدّث مع يوكيو

284
00:17:33,190 --> 00:17:35,740
!أراهن أنّك لم تفكّر في الأمر مليًّا حتّى

285
00:17:35,740 --> 00:17:38,450
سيتمّ طرد كليكما من التّنظيم، أتفهم ذلك؟

286
00:17:38,770 --> 00:17:41,830
!سأغادر التّنظيم إذًا! سأهرب مع يوكيو

287
00:17:42,280 --> 00:17:44,700
!أعلم أنّ بمقدورنا العيش إن ساعدنا بعضنا

288
00:17:44,860 --> 00:17:47,580
أتدري ما الّذي تقوله بالفعل؟
!هذا تهوّر واضح

289
00:17:47,580 --> 00:17:49,880
إنّها محقّة! كيف يمكنكما أن تعيشا كهاربين؟

290
00:17:49,880 --> 00:17:52,850
سيكون من الأفضل له أن يتمّ
!اختباره بشكل مناسب

291
00:17:54,790 --> 00:17:55,810
.اسمعوا

292
00:17:56,290 --> 00:17:57,430
...هل يوكيو

293
00:17:57,790 --> 00:18:00,140
سيعود إلينا ثانية سالمًا؟

294
00:18:02,090 --> 00:18:05,070
،لقد تمّ وقف تنفيذ إعدامي
ولكن ماذا عنه هو؟

295
00:18:05,380 --> 00:18:09,950
كم عدد الأشخاص الّذين إلى جانبه الآن؟

296
00:18:10,650 --> 00:18:13,150
!لا يجب أن يدوم الأمر طويلاً

297
00:18:13,150 --> 00:18:15,490
،إن كانوا سيمسكون به
...فيمكن أن يمسكوا بكلينا

298
00:18:15,490 --> 00:18:17,900
!وسأخضع للاختبارات مثل يوكيو

299
00:18:18,610 --> 00:18:21,030
!لن أدعه يظلّ وحيدًا

300
00:18:24,780 --> 00:18:28,340
.شكرًا يا رفاق على قلقكم عليّ

301
00:18:28,620 --> 00:18:30,220
!لكنّي ذاهب

302
00:18:30,830 --> 00:18:32,170
.لذلك استمعوا

303
00:18:33,290 --> 00:18:37,800
أتعرفون أين يحتفظون بيوكيو؟

304
00:18:39,470 --> 00:18:42,050
!يا لك من غبيّ يا رين

305
00:18:42,300 --> 00:18:45,610
!لنبدأ بالبحث عن مكان أوكومورا-سينسي

306
00:18:45,880 --> 00:18:47,680
...حتّى إن عرفنا ذلك

307
00:18:47,680 --> 00:18:49,890
!علينا إيجاد طريقة ما فحسب

308
00:18:49,890 --> 00:18:51,150
!صحيح

309
00:18:51,150 --> 00:18:53,310
!لنجد طريقة ما

310
00:18:53,850 --> 00:18:55,230
...يا رفاق

311
00:18:55,230 --> 00:18:58,790
.لنقل أنّنا عثرنا على مكانه بالفعل
ما الّذي ستفعله حينها؟

312
00:18:59,770 --> 00:19:07,170
هل يمكننا التّفكير في خطّة يصير فيها
أوكومورا-سينسي مضطرًّا للهرب؟

313
00:19:07,650 --> 00:19:09,540
...هذه الخطّة الّتي تتحدّث عنها

314
00:19:11,740 --> 00:19:15,550
.دع ملك الوقت سامائيل يتولاّها

315
00:19:24,300 --> 00:19:25,310
...يوكيو

316
00:19:25,710 --> 00:19:28,190
لماذا لم تخبرني بشأن تلك العين؟

317
00:19:29,510 --> 00:19:31,530
منذ متى وهي على ذلك الشّكل؟

318
00:19:33,100 --> 00:19:34,450
!أجبني

319
00:19:40,100 --> 00:19:41,360
...يوكيو

320
00:19:41,360 --> 00:19:43,160
!أنا أريد مساعدتك

321
00:21:29,750 --> 00:21:30,930
!يوكيو! قف

322
00:21:31,550 --> 00:21:33,150
!سنعود إلى التّنظيم

323
00:21:34,340 --> 00:21:35,940
سنعود؟

324
00:21:36,260 --> 00:21:38,400
!أريد مساعدتك

325
00:21:39,350 --> 00:21:40,740
...مساعدتي

326
00:21:41,390 --> 00:21:42,690
أنا؟

327
00:21:52,360 --> 00:21:55,370
.انتهى وقتي في التّنظيم الآن

328
00:21:55,910 --> 00:21:57,620
.أتساءل ما الّذي سيحدث لي

329
00:21:58,200 --> 00:22:00,840
...تحقيقات وتجارب بشريّة

330
00:22:00,840 --> 00:22:02,640
.وفي أسوأ الاحتمالات، الإعدام

331
00:22:03,040 --> 00:22:04,760
.وعلى الأرجح الثّلاثة معًا

332
00:22:05,920 --> 00:22:10,640
صحيح، سيكون من الصّعب
.بالنّسبة لي ألاّ أتمكّن من استخدامك

333
00:22:10,640 --> 00:22:13,400
أتريدني أن أساعدك على الهرب؟

334
00:22:17,470 --> 00:22:18,640
.لا أريد

335
00:22:19,550 --> 00:22:22,190
.لا نيّة لديّ بأن أكون تحت إمرتك أيضًا

336
00:22:22,190 --> 00:22:24,410
.سأعثر على طريقة ما في النّهاية

337
00:22:25,640 --> 00:22:27,040
...كلّ ما عليّ فعله

338
00:22:27,310 --> 00:22:28,650
.هو الانتظار

339
00:22:32,110 --> 00:22:33,710
...هكذا كان الأمر دائمًا

340
00:22:34,110 --> 00:22:35,880
.مذ كنتُ طفلاً

341
00:22:40,370 --> 00:22:41,170
أرأيت؟

342
00:22:49,180 --> 00:22:50,340
!يوكيو

343
00:22:50,340 --> 00:22:51,890
!أنا هنا لإنقاذك

344
00:22:52,430 --> 00:22:53,560
!هيّا

345
00:22:56,340 --> 00:22:59,320
انفجار ناجم عن قوّة سحريّة؟
—لماذا قد يحدث ذلك هنا

346
00:22:57,800 --> 00:23:00,230
!ليساعدني أحد ما

347
00:23:00,510 --> 00:23:03,110
!ثمّة شيطان يهاجمنا

348
00:23:06,930 --> 00:23:09,240
...يا لكم من بشر حمقى

349
00:23:09,240 --> 00:23:10,530
أتشعرون بهذا؟

350
00:23:10,530 --> 00:23:12,990
...إنّ الهواء يمتلئ به

351
00:23:12,990 --> 00:23:14,830
جنون جهنّم؟

352
00:23:14,830 --> 00:23:16,990
أ-أمايمون! ملك الأرض؟

353
00:23:16,990 --> 00:23:20,500
...بما أنّ أخي الأكبر في حالة ضعيفة الآن

354
00:23:20,500 --> 00:23:22,000
...فأنا ملك الأرض

355
00:23:22,330 --> 00:23:25,720
!سأجلب الفوضى لأسيا

356
00:23:34,930 --> 00:23:39,890
الحلقة القادمة
[فراق]