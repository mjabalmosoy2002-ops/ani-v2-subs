1
00:00:01,970 --> 00:00:05,480
!كم أنا مسرورة لأنّي وجدت أحدًا أعرفه

2
00:00:05,480 --> 00:00:07,150
...أ-أنت

3
00:00:08,990 --> 00:00:13,920
،انتقلتُ إلى طوكيو اليوم
!لكنّي لا أستطيع إيجاد منزلي

4
00:00:13,920 --> 00:00:16,430
!الشّوارع معقّدة للغاية

5
00:00:16,430 --> 00:00:19,180
.صحيح، شوارع طوكيو قد تشكّل تحدّيًا

6
00:00:19,180 --> 00:00:20,960
هل تعرفين العنوان؟

7
00:00:22,820 --> 00:00:24,000
!ها هو

8
00:00:24,820 --> 00:00:28,760
...سوميدا، هيكيفوني، 1-2

9
00:00:30,510 --> 00:00:36,390
!ماذا؟! شقّتي في المبنى المجاور لمبناك؟

10
00:00:36,390 --> 00:00:38,090
.ذلك ما يبدو

11
00:00:38,090 --> 00:00:39,610
!هذا مذهل

12
00:00:39,610 --> 00:00:42,360
!ريكا-سان، تعيشين في مبنى جميل

13
00:00:42,360 --> 00:00:43,850
.إنّه عاديّ

14
00:00:43,850 --> 00:00:47,300
!شكرًا لك، لقد أنقذتني

15
00:00:47,300 --> 00:00:48,780
.العفو

16
00:00:48,780 --> 00:00:51,610
.هذه هي الورشة حيث أعمل

17
00:00:51,610 --> 00:00:53,480
.مرّي عليّ إن أردت

18
00:00:53,960 --> 00:00:55,130
.حسنًا

19
00:00:56,960 --> 00:00:59,980
...استوديو زجاج الشّهب

20
00:02:34,760 --> 00:02:37,370
.كانت مبتهجة للغاية

21
00:02:37,370 --> 00:02:38,280
...عفوًا

22
00:02:39,010 --> 00:02:41,390
.لديّ عمل خارج المكتب

23
00:02:41,390 --> 00:02:42,930
.صحيح

24
00:02:42,930 --> 00:02:46,060
ربّما عليّ إخبار أوهارا-كُن
.أنّي التقيتُ بمياما-سان

25
00:02:46,880 --> 00:02:48,060
.أو لا

26
00:02:48,060 --> 00:02:50,520
.واثقة أنّه يعلم في كلّ الأحوال

27
00:03:07,460 --> 00:03:09,840
صانعة زجاج؟

28
00:03:17,230 --> 00:03:19,720
.أتساءل أيّ نوع من النّاس تكون مياما-سان

29
00:03:30,400 --> 00:03:33,900
.إذًا فهذا المكان ورشة زجاج

30
00:03:43,170 --> 00:03:44,170
!معلّمتي

31
00:03:44,750 --> 00:03:45,780
.سأبدأ

32
00:03:57,430 --> 00:03:58,970
.سرّعي من وتيرتك

33
00:03:58,970 --> 00:04:00,400
.حا-حاضرة

34
00:05:08,830 --> 00:05:10,210
!أجل

35
00:05:14,210 --> 00:05:16,620
.لا يزال غير جيّد كفاية

36
00:05:16,620 --> 00:05:18,200
!ماذا؟

37
00:05:18,200 --> 00:05:20,420
.كم هذا شديد

38
00:05:23,140 --> 00:05:24,470
!ريكا-سان

39
00:05:25,330 --> 00:05:27,420
!أرى أنّك مررت عليّ

40
00:05:27,420 --> 00:05:30,090
!كان عليك إلقاء التّحيّة

41
00:05:30,090 --> 00:05:33,310
.عفوًا. ظننتُ أنّي سأشتّت انتباهك

42
00:05:33,310 --> 00:05:35,150
!على الإطلاق

43
00:05:35,150 --> 00:05:39,150
صحيح. أتريدين إقامة حفلة شرب لاحقًا؟

44
00:05:39,710 --> 00:05:41,780
—حفلة شرب؟ لا، أنا

45
00:05:41,780 --> 00:05:45,130
اسمعي، أيمكننا إقامتها في منزلك؟

46
00:05:45,130 --> 00:05:47,030
!لنشرب معًا

47
00:05:47,360 --> 00:05:50,660
.منزلي؟ لم أستضف أيّ أحد من قبل

48
00:05:50,660 --> 00:05:53,920
.كنتُ توّاقة للحديث معك

49
00:05:54,270 --> 00:05:57,340
صحيح! سأحضر معي بعض
!الأغراض من كوماموتو

50
00:05:57,340 --> 00:05:58,820
...لا

51
00:05:58,820 --> 00:06:00,170
!رجاءً

52
00:06:00,640 --> 00:06:04,890
!لم أعش في مدينة كبيرة كهذه من قبل
!أنا متوتّرة للغاية

53
00:06:06,500 --> 00:06:10,600
.حسنًا، ما دمت أملك الوقت للتّنظيف أوّلاً

54
00:06:11,520 --> 00:06:13,280
!مرحى

55
00:06:13,280 --> 00:06:15,620
.سأحضر بعض جذور خردل اللّوتس

56
00:06:18,840 --> 00:06:20,820
!بصحّتك

57
00:06:23,070 --> 00:06:24,680
!لذيذ

58
00:06:24,680 --> 00:06:26,340
...يا لها من قوّة

59
00:06:28,770 --> 00:06:31,670
إذًا فهذه هي شقّتك؟

60
00:06:31,670 --> 00:06:34,420
.لم أدخل أيّ أحد إلى شقّتي من قبل

61
00:06:33,610 --> 00:06:35,040
!مذهل

62
00:06:34,420 --> 00:06:36,250
.أجد هذا غير عاديّ

63
00:06:35,040 --> 00:06:36,630
!لديك صخور كثيرة

64
00:06:36,630 --> 00:06:40,410
هل تذكرين عندما أخبرتك
أنّي أريد أن نصير صديقتين؟

65
00:06:41,170 --> 00:06:45,380
ثمّ التقيتُ بك بالصّدفة في اليوم الّذي
!انتقلت فيه لطوكيو! كان هذا مقدّرًا

66
00:06:45,840 --> 00:06:49,720
!لنحتفل بشدّة اليوم

67
00:06:49,720 --> 00:06:51,260
.الكثير من البيرة

68
00:06:51,260 --> 00:06:52,710
!أهذه طريقة كيوشو للاحتفال؟

69
00:06:52,710 --> 00:06:56,050
.أنا من صنعتُ كؤوس البيرة هذه

70
00:06:56,050 --> 00:06:57,600
.هذا مذهل

71
00:06:58,120 --> 00:07:01,820
.إنّها ألوان تثير الفضول، بين الأزرق والأخضر

72
00:07:01,820 --> 00:07:03,380
فهمتِ إذًا؟

73
00:07:03,380 --> 00:07:05,860
.تمّ مزج حجر مع هذا

74
00:07:06,170 --> 00:07:07,720
حجر؟

75
00:07:08,050 --> 00:07:10,330
.هذا صحيح. الحجارة من آسو

76
00:07:14,670 --> 00:07:19,130
في صغري، قضيتُ معظم
.وقت لعبي في الجبال والأنهار

77
00:07:19,710 --> 00:07:21,750
،لم يكن هنالك أيّ أماكن أخرى للّعب

78
00:07:22,190 --> 00:07:24,330
.وكنتُ لا أعرف الخوف

79
00:07:24,330 --> 00:07:27,070
وكنتُ أرى إلى أيّ مدى يمكنني
.أن أتبع مجرى النّهر

80
00:07:29,420 --> 00:07:35,140
وكانت تلك هي الطّريقة الوحيدة
.للوصول إلى مسبح معيّن

81
00:07:42,270 --> 00:07:44,370
.كان مخبئي الصّغير

82
00:07:44,370 --> 00:07:48,040
اعتدتُ قضاء الكثير من الوقت
.هناك بعد انتهاء المدرسة

83
00:07:48,720 --> 00:07:50,090
.يبدو ذلك لطيفًا

84
00:07:50,420 --> 00:07:54,080
مثل أحد تلك الأماكن
.الّتي قد يظهر فيها توتورو

85
00:07:54,080 --> 00:07:55,780
!بالتّأكيد

86
00:07:56,790 --> 00:08:00,540
لكن ما ظهر هي طيور البلشون
.الرّماديّة وليس توتورو

87
00:08:01,330 --> 00:08:05,170
يمكن سماع أصوات من كلّ
.الأنواع عند التّواجد هناك

88
00:08:05,170 --> 00:08:07,660
.مياه النّهر، تغريد الطّيور

89
00:08:07,660 --> 00:08:09,890
.تمايل أوراق الأشجار

90
00:08:11,260 --> 00:08:15,350
استعملتُ حجارة من ذلك
.الجدول في الجبل

91
00:08:15,350 --> 00:08:18,850
.فعلاً؟ إنّه جميل جدًّا

92
00:08:18,850 --> 00:08:21,090
.ما زال الطّريق أمامي طويلاً

93
00:08:21,600 --> 00:08:24,110
.إنّ الزّجاج لا ينطاع بين يديّ كما أريد

94
00:08:24,780 --> 00:08:27,590
.معلّمتي الشّبيهة بالمشعوذة غاضبة دائمًا

95
00:08:27,590 --> 00:08:29,950
.لا فكرة لديّ ما الطّريق الّذي أسلكه

96
00:08:30,480 --> 00:08:33,410
.كنتُ محبطة للغاية منذ اليوم الأوّل

97
00:08:34,530 --> 00:08:36,080
!لكن ما باليد حيلة

98
00:08:36,080 --> 00:08:38,540
!أنا هنا بهدف التّدريب لأنّي سيّئة

99
00:08:40,390 --> 00:08:42,790
.إنّها فتاة مبتهجة بالفعل

100
00:08:43,070 --> 00:08:45,970
.وظريفة جدًّا كما لاحظتُ في آسو

101
00:08:46,380 --> 00:08:49,950
هل هنالك ما أزعجك اليوم يا ريكا-سان؟

102
00:08:50,380 --> 00:08:54,190
هل هناك أيّ شيء يمكن أن يزعجك؟

103
00:08:54,190 --> 00:08:57,090
...لـ-لنرَ

104
00:08:57,770 --> 00:09:01,120
.كانت زاوية خريطة اشتريتُها البارحة مطويّة

105
00:09:01,120 --> 00:09:02,190
.هذا أزعجني

106
00:09:02,190 --> 00:09:03,960
هذا كلّ شيء؟

107
00:09:04,320 --> 00:09:06,910
.أحاول ألاّ أركّز على الأشياء كثيرًا

108
00:09:06,910 --> 00:09:09,730
!هذا تصرّف راشد جدًّا منك

109
00:09:10,160 --> 00:09:15,700
إضافة لذلك، لا يملك ذلك المتجر الكثير
.من الخرائط في مخزنه من الأساس

110
00:09:15,700 --> 00:09:19,320
أنا لا أقول أنّ عليهم أن يحبّوا
...الخرائط، ولكن

111
00:09:20,410 --> 00:09:24,310
.كما أنّ برنامج السّفر الّذي أحبّه انتهى

112
00:09:24,310 --> 00:09:26,460
.بسبب فضيحة أحد أعضاء فريقه

113
00:09:26,460 --> 00:09:28,630
.ذلك فظيع فحسب

114
00:09:29,950 --> 00:09:34,180
،وعدما أخرج للسّير
.هنالك كلب يضايقني دائمًا

115
00:09:34,180 --> 00:09:35,970
.وذلك مخيف للغاية

116
00:09:35,970 --> 00:09:37,090
...وأيضًا

117
00:09:37,090 --> 00:09:39,600
!ما من شيء سيوقفك الآن

118
00:09:41,030 --> 00:09:42,480
.لقد تذكّرت شيئًا

119
00:09:42,850 --> 00:09:46,060
.أنت وتاكو-تشان لن تتزوّجا

120
00:09:46,470 --> 00:09:48,850
.أخبرتني عائلته بذلك

121
00:09:49,400 --> 00:09:53,320
قالوا أنّ تاكو-تشان وريكا-سان
.اتّفقا على زواج مزيّف

122
00:09:53,650 --> 00:09:57,370
.هذا صحيح. نحن مجرّد متآمران في ذلك

123
00:09:57,870 --> 00:10:00,330
إذًا لا تجمعكما أيّ علاقة بالفعل؟

124
00:10:00,860 --> 00:10:02,530
!ذلك ما أودّ معرفته

125
00:10:03,260 --> 00:10:06,050
.أودّ أن يكون أوهارا-كُن واضحًا

126
00:10:09,590 --> 00:10:11,210
ريكا-سان؟

127
00:10:13,220 --> 00:10:16,600
.إنّه يقول أمورًا ذات تلميحات غامضة

128
00:10:17,350 --> 00:10:21,060
ومع ذلك كنتُ أجهل أنّه كان
.مقرّبًا من شخص بهذه الظّرافة

129
00:10:21,600 --> 00:10:24,810
.أنا لا أفهم مشاعر البشر على الإطلاق

130
00:10:25,160 --> 00:10:27,990
.لأنّي لم أتقرّب لأيّ أحد من قبل

131
00:10:28,570 --> 00:10:33,070
،إن لم يكن هنالك أيّ شيء
.أودّ منه أن يخبرني بذلك

132
00:10:38,330 --> 00:10:42,150
...قبل كلّ شيء، هل أنت وأوهارا-كُن

133
00:10:44,010 --> 00:10:47,390
ما-ما الّذي أحاول قوله؟

134
00:10:50,170 --> 00:10:52,800
.الزّواج خطّة مزيّفة في كلّ الأحوال

135
00:10:52,800 --> 00:10:54,970
.لسنا في علاقة حتّى

136
00:10:54,970 --> 00:10:57,350
لذلك إن سألتُ مياما-سان
وأنا مجرّد زميلة عمل

137
00:10:57,350 --> 00:11:02,430
عمّا إذا كان أوهارا-كُن مجرّد
...صديق طفولة فحسب سيكون

138
00:11:02,730 --> 00:11:05,410
ريكا-سان؟ ريكا-سان؟

139
00:11:08,110 --> 00:11:10,440
.لا يوجد أيّ شيء

140
00:11:12,930 --> 00:11:17,560
هل كان أوهارا-كُن غامضًا هكذا دائمًا؟

141
00:11:18,550 --> 00:11:20,580
.بالطّبع لا

142
00:11:20,940 --> 00:11:25,500
في إحدى المرّات، أتى تاكو-تشان
.إلى مكاني السّرّيّ الّذي أخبرتك عنه

143
00:11:26,090 --> 00:11:29,250
،انغمسنا في اللّعب طوال اليوم

144
00:11:29,700 --> 00:11:32,220
.وحلّ الظّلام قبل أن ندرك ذلك

145
00:11:32,630 --> 00:11:37,630
،لم أعرف كيف أعود للمنزل
.وكنتُ أوشك على البكاء

146
00:11:39,260 --> 00:11:44,520
.وحينها أمسك تاكو-تشان بيراعة وأراني إيّاها

147
00:11:44,850 --> 00:11:46,520
.أسعدني ذلك كثيرًا

148
00:11:55,570 --> 00:11:59,850
.وبفضله، عدنا إلى المنزل بسلام

149
00:12:00,520 --> 00:12:03,950
،كان والداي غاضبان بشدّة بعد ذلك

150
00:12:04,310 --> 00:12:06,930
.لكنّ تاكو-تشان دافع عنّي

151
00:12:08,170 --> 00:12:09,960
فعلاً؟

152
00:12:09,960 --> 00:12:14,530
.من الصّعب تصديق ذلك عن أوهارا-كُن اليوم

153
00:12:14,530 --> 00:12:18,130
.لكن أظنّ أنّ ذلك لا يهمّ

154
00:12:18,590 --> 00:12:21,430
...في تلك الحالة

155
00:12:22,350 --> 00:12:25,680
!لنسأله مباشرة عمّا كنتِ تقولينه

156
00:12:25,680 --> 00:12:26,560
ماذا؟

157
00:12:26,560 --> 00:12:29,100
تريدينه أن يكون واضحًا، صحيح؟

158
00:12:29,100 --> 00:12:30,890
!هذا صحيح

159
00:12:30,890 --> 00:12:32,840
.من الأفضل أن نسأله هو عن ذلك إذًا

160
00:12:35,370 --> 00:12:39,720
مرحبًا، معك ناو. أهذا تاكو-تشان؟

161
00:12:39,720 --> 00:12:40,910
!ماذا؟

162
00:12:40,910 --> 00:12:43,150
أراهن أنّك متفاجئ، صحيح؟

163
00:12:43,150 --> 00:12:46,040
.أنا في منزل ريكا-سان الآن وأشرب معها

164
00:12:46,040 --> 00:12:50,370
ماذا؟ ألم أخبرك أنّي آتية لطوكيو؟

165
00:12:50,800 --> 00:12:53,710
!تاكو-تشان، تعال إلى هنا في الحال

166
00:12:54,070 --> 00:12:56,610
!ثمّة أمر تودّ ريكا-سان أن توضّحه لها

167
00:12:57,090 --> 00:12:59,220
تعال إلى هنا بسرعة البرق، مفهوم؟

168
00:12:59,220 --> 00:13:00,470
...عـ-عفوًا

169
00:13:00,470 --> 00:13:02,310
ماذا؟ العنوان؟

170
00:13:02,310 --> 00:13:03,890
.اكتشف ذلك بنفسك

171
00:13:03,890 --> 00:13:07,480
!يا ريكا، تاكو-تشان قادم إلى هنا

172
00:13:07,480 --> 00:13:08,960
!هذا مفاجئ للغاية

173
00:13:09,980 --> 00:13:11,600
!مـ-مياما-سان؟

174
00:13:14,080 --> 00:13:15,230
.استيقظي رجاءً

175
00:13:15,230 --> 00:13:17,970
!اتّصلتِ بأوهارا-كُن، صحيح؟

176
00:13:21,370 --> 00:13:25,330
.إذًا فأوهارا-كُن قادم إلى هنا

177
00:13:46,860 --> 00:13:48,770
ماذا يحدث؟

178
00:13:51,770 --> 00:13:54,210
.عفوًا، أنا أوهارا

179
00:13:54,210 --> 00:13:55,950
—وصلتني مكالمة غريبة من

180
00:13:55,950 --> 00:13:57,570
...مرحبًا

181
00:13:57,570 --> 00:13:59,980
.كنت في انتظارك يا أوهارا-كُن

182
00:14:00,470 --> 00:14:03,320
.ثمّة خطب ما بها بالتّأكيد

183
00:14:03,720 --> 00:14:05,940
هل هونجوجي-سان ثملة؟

184
00:14:08,740 --> 00:14:09,770
!ناو؟

185
00:14:10,100 --> 00:14:11,600
!يا ناو، استيقظي

186
00:14:11,600 --> 00:14:13,130
!ما الّذي تفعلينه؟

187
00:14:13,130 --> 00:14:14,580
!هيّا، استيقظي

188
00:14:15,710 --> 00:14:18,510
.دعنا وشأنها! إنّها نائمة

189
00:14:18,510 --> 00:14:19,340
.حاضر

190
00:14:19,690 --> 00:14:24,090
.تفضّل بالجلوس رجاءً
.لديّ أمر أودّ سؤالك عنه

191
00:14:24,090 --> 00:14:26,720
أ-أكيد. ما هو؟

192
00:14:28,380 --> 00:14:32,560
،في تلك اللّيلة في آسو
ما الّذي كنت توشك أن تقوله لي؟

193
00:14:34,060 --> 00:14:35,850
عمّ تتكلّمين؟

194
00:14:35,850 --> 00:14:37,400
!ألا تتذكّر؟

195
00:14:37,400 --> 00:14:40,190
.تلك الجملة الّتي لم تُكملها

196
00:14:40,940 --> 00:14:43,270
...عفوًا، لذلك السّبب

197
00:14:44,220 --> 00:14:46,030
—أنا يا هونجوجي-سان

198
00:14:46,450 --> 00:14:48,450
.تقصدين ذلك

199
00:14:49,360 --> 00:14:51,930
!أيمكنك تذكّر ما كنت ستقوله؟

200
00:14:51,930 --> 00:14:54,580
...عـ-عفوًا

201
00:14:58,080 --> 00:15:01,930
أنا يا هونجوجي-سان مسرور"
".لأنّه تمكّنّا من المشي معًا

202
00:15:03,230 --> 00:15:04,990
هذا كلّ شيء؟

203
00:15:04,990 --> 00:15:05,980
.نعم

204
00:15:10,430 --> 00:15:12,600
.أنا مغفّلة

205
00:15:12,980 --> 00:15:15,470
.تخيّلتُ أمورًا كثيرة

206
00:15:15,980 --> 00:15:18,500
.أمورًا أردتُ أن تكون حقيقة

207
00:15:18,500 --> 00:15:22,980
عفوًا، هل كنتِ غاضبة مؤخّرًا بسببي؟

208
00:15:23,580 --> 00:15:25,490
.ما كنتُ لأقول أنّي غاضبة

209
00:15:25,860 --> 00:15:30,500
.آسف، أنا لا أجيد الحديث كثيرًا

210
00:15:30,920 --> 00:15:34,370
.لطالما اعتقدتُ أنّي كنتُ توّاقًا لأكبر

211
00:15:35,520 --> 00:15:37,070
،عندما كنتُ طفلاً

212
00:15:37,070 --> 00:15:41,590
ظننتُ أنّي سأصير بارعًا في التّعامل
.مع أمور كثيرة عندما أكبر

213
00:15:42,150 --> 00:15:47,340
،لكن كلّما تقدّمت في مرحلة الرّشد
.بدا لي العالم أقلّ منطقيّة أكثر فأكثر

214
00:15:47,880 --> 00:15:49,510
.ذلك صحيح

215
00:15:49,900 --> 00:15:52,300
.أنا لا أفهم المشاعر البشريّة أيضًا

216
00:15:52,980 --> 00:15:54,980
.نفس الشّيء مع والداي

217
00:15:56,020 --> 00:15:58,640
وذلك الشّيء الّذي ظننتُ أنّه يلمع نورًا

218
00:15:59,420 --> 00:16:02,020
.صار ظلامًا حالكًا فجأة

219
00:16:02,020 --> 00:16:06,530
ريكا-سان، سنعيش أنا وأنت
.فقط ابتداءً من اليوم

220
00:16:10,310 --> 00:16:13,690
.لم أشأ أن يمرّ هيديو-كُن بنفس ما مررتُ به

221
00:16:14,350 --> 00:16:17,980
.مع أنّه لا يوجد ما يمكنني فعله حيال ذلك

222
00:16:19,200 --> 00:16:21,240
.لذلك السّبب قرّرتُ إطفاءها

223
00:16:21,630 --> 00:16:26,670
.إن أطفأتُ مشاعري، فلن يخيب ظنّي أبدًا

224
00:16:28,420 --> 00:16:30,590
!ومع ذلك يبدو أنّي لا أستطيع ذلك

225
00:16:30,590 --> 00:16:34,350
!وهذا خطؤك أنت يا أوهارا-كُن
!لماذا يجب أن تكون الأمور هكذا؟

226
00:16:35,440 --> 00:16:40,050
،تقول أمورًا غريبة وغير واضحة
.لذلك لا أستطيع إطفاء مشاعري

227
00:16:40,050 --> 00:16:42,240
.لا أستطيع على الإطلاق

228
00:16:42,240 --> 00:16:44,440
!أنا وأنت مجرّد متآمرين

229
00:16:44,840 --> 00:16:47,820
!أليس كذلك؟ كن واضحًا بشأن ذلك

230
00:16:47,820 --> 00:16:50,410
!أريد إطفاءها

231
00:16:50,410 --> 00:16:52,980
!ما الّذي تريد فعله أنت؟

232
00:17:10,350 --> 00:17:11,680
...أنا

233
00:17:16,800 --> 00:17:18,930
.أريد أن أواعدك

234
00:17:20,560 --> 00:17:22,810
.صيري حبيبتي رجاءً

235
00:17:28,940 --> 00:17:29,820
—ما

236
00:17:30,050 --> 00:17:31,050
!ماذا؟

237
00:17:36,700 --> 00:17:39,580
!ما-ما الّذي حدث؟

238
00:17:39,580 --> 00:17:41,330
.خرجت الأمور عن السّيطرة بالكامل

239
00:17:41,330 --> 00:17:45,090
!كـ-كـ-كلّ ما أردته هو أن أشتكي قليلاً

240
00:17:45,090 --> 00:17:47,090
!وها هو يتحدّث عن المواعدة فجأة

241
00:17:47,090 --> 00:17:49,590
!لا-لا أستطيع! لا أستطيع إطلاقًا

242
00:17:49,590 --> 00:17:52,670
!لقد فتحت فمي وتفوّهت بالجنون

243
00:17:52,670 --> 00:17:55,950
،إنّها تكرهني سلفًا هذه الأيّام
!فلماذا قلتُ كلّ ذلك؟

244
00:17:55,950 --> 00:17:57,620
.ستنتهي هذه الخطّة بالكامل الآن

245
00:17:57,620 --> 00:18:01,130
وما زال عليّ الجلوس أمامها
!في العمل من الآن فصاعدًا

246
00:18:01,130 --> 00:18:02,350
!هذا فظيع

247
00:18:02,350 --> 00:18:04,880
.لا، من المستحيل أن يحدث أمر كهذا

248
00:18:04,880 --> 00:18:05,980
.هذه هلوسة

249
00:18:05,980 --> 00:18:08,360
.إنّه حلم بسبب شربي للبيرة

250
00:18:08,360 --> 00:18:10,980
.صار الوضع محرجًا للغاية

251
00:18:10,980 --> 00:18:12,860
.ربّما يمكنني التّظاهر أنّي لم أقل ذلك أبدًا

252
00:18:13,180 --> 00:18:15,820
.بإمكاني أن أقول أنّي كنتُ أمزح

253
00:18:17,540 --> 00:18:20,260
.أعتقد أنّ ذلك كان غير واقعيًّا

254
00:18:20,680 --> 00:18:22,620
.لا يمكنني سحب كلامي الآن

255
00:18:22,620 --> 00:18:25,250
.لا هروب من هذا، إنّه الواقع

256
00:18:29,380 --> 00:18:32,830
.كلاّ. هونجوجي-سان غاضبة

257
00:18:32,830 --> 00:18:34,260
.بشكل قاتل

258
00:18:34,260 --> 00:18:37,400
لماذا يريد مواعدة فتاة مثلي؟

259
00:18:37,400 --> 00:18:39,230
.لا فكرة لديّ

260
00:18:39,830 --> 00:18:44,140
.لديّ خبرة محدودة بأشياء مثل الحبّ والمواعدة

261
00:18:44,140 --> 00:18:47,320
.لا يمكنني تخيّل كيف قد يكون الأمر

262
00:18:47,320 --> 00:18:49,080
...أنا والحبّ

263
00:18:53,150 --> 00:18:54,400
.هونجوجي

264
00:18:54,660 --> 00:18:56,290
ما الّذي تنظرين إليه؟

265
00:18:56,290 --> 00:18:57,830
.كوكورا

266
00:18:57,830 --> 00:18:59,530
أيمكنني أن أنظر؟

267
00:18:59,530 --> 00:19:00,870
.لا بأس

268
00:19:06,740 --> 00:19:09,370
.سأذهب للّعب في الخارج
.مع السّلامة

269
00:19:09,370 --> 00:19:11,080
.مع السّلامة

270
00:19:12,930 --> 00:19:16,170
هونجوجي-سان، هل أنهيت
نشرة مساعد المكتبة؟

271
00:19:16,170 --> 00:19:17,340
.نعم

272
00:19:21,600 --> 00:19:22,930
.كلاّ

273
00:19:23,490 --> 00:19:25,550
،مهما راجعتُ حياتي

274
00:19:25,550 --> 00:19:28,550
لا يمكنني العثور على أيّ محادثة
.حقيقيّة مع الجنس الآخر

275
00:19:28,550 --> 00:19:30,610
.وكانت تقلّ مع مرور الوقت فحسب

276
00:19:31,120 --> 00:19:33,810
.لم أمانع ذلك على الإطلاق

277
00:19:33,810 --> 00:19:38,570
أنا إنسانة، لذلك فالأمر ليس
.وكأنّي لم أتخيّل الحبّ وما إلى ذلك

278
00:19:39,490 --> 00:19:44,480
،لكنّ ظهوره الآن فجأة
...بهذه الضّخامة وفي العلن

279
00:19:44,870 --> 00:19:48,540
!إنّه ليس شيئًا بإمكاني تحمّله

280
00:19:50,710 --> 00:19:55,230
.أوهارا-كُن، أنا بالفعل شخص مملّ

281
00:19:55,230 --> 00:19:57,800
.واثقة أنّ تواجدك معي سيخيّب آمالك

282
00:19:57,800 --> 00:20:00,510
هيّا، إلى متى ستظلّ صامتة؟

283
00:20:00,510 --> 00:20:02,010
ما الّذي تنتظره؟

284
00:20:02,530 --> 00:20:05,850
.لم تتحرّك هونجوجي-سان منذ عشرة دقائق

285
00:20:05,850 --> 00:20:08,140
لماذا لا تردّ؟

286
00:20:08,140 --> 00:20:11,510
هل ستتجاهل ما قلتُه فحسب؟

287
00:20:11,510 --> 00:20:14,400
.لا بدّ أنّ هذا هو رفضها

288
00:20:14,400 --> 00:20:17,900
.لا يمكنني القيام بذلك. أنا خائف جدًّا

289
00:20:17,900 --> 00:20:20,710
ماذا إن كان لديها حبيب سلفًا أو ما شابه؟

290
00:20:20,710 --> 00:20:23,250
.لم أفكّر في تلك الاحتماليّة

291
00:20:23,250 --> 00:20:25,640
.ربّما ستستيقظ مياما-سان

292
00:20:25,640 --> 00:20:27,760
ألا يوجد مخرج من هذا الوضع؟

293
00:20:27,760 --> 00:20:29,670
!لا يمكنني تحمّل التّوتّر

294
00:20:29,960 --> 00:20:33,140
!استيقظي يا ناو
!سيكون ذلك هو عُذري للمغادرة

295
00:20:33,140 --> 00:20:34,920
!لا يمكنني تحمّل التّوتّر

296
00:20:34,920 --> 00:20:39,010
ولكن هل هي فكرة جيّدة؟
أذلك فعلاً هو ما أريده؟

297
00:20:39,430 --> 00:20:44,100
نظر إليّ بكلّ جدّيّة
.عندما قال تلك الكلمات

298
00:20:44,650 --> 00:20:48,770
.قد لا أختبر مثل هذه اللّحظة ثانية

299
00:20:49,680 --> 00:20:54,690
.وها أنا ذي ثملة للغاية
.يا لها من عدم المسؤوليّة

300
00:20:55,230 --> 00:20:59,950
أفترض أنّي أضعتُ فرصًا كثيرة
.على هذا الشّكل

301
00:21:01,320 --> 00:21:03,980
.سأذهب للّعب في الخارج
.مع السّلامة

302
00:21:03,980 --> 00:21:05,410
.مع السّلامة

303
00:21:05,730 --> 00:21:08,520
.عليّ قول شيء ما. أيّ شيء

304
00:21:08,520 --> 00:21:10,920
.لا يجب أن ينتهي هذا دون قولي لأيّ شيء

305
00:21:11,250 --> 00:21:13,540
...هيّا، هيّا

306
00:21:13,900 --> 00:21:15,420
!ماذا أقول؟

307
00:21:15,880 --> 00:21:18,670
!قولي شيئًا! أيّ شيء

308
00:21:18,670 --> 00:21:21,590
!قولي أيّ شيء رجاءً

309
00:21:21,590 --> 00:21:23,930
!كم مرّ من وقت منذ أن سألتها؟

310
00:21:24,270 --> 00:21:25,420
.بلغتُ حدودي

311
00:21:25,420 --> 00:21:28,680
!إن كانت سترفض، فلتقلها فحسب

312
00:21:29,070 --> 00:21:32,190
!قولي أيّ شيء، أنا أتوسّل إليك

313
00:21:44,420 --> 00:21:47,210
.لم أستطع تناول قضمة أخرى

314
00:22:03,110 --> 00:22:05,730
.أفسدتُ كلّ شيء بالفعل الآن