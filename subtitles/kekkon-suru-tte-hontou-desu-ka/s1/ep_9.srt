00:14:52,030 --> 00:14:55,130
.لا أملك أيّ أحلام جامحة أو أصدقاء

183
00:14:55,770 --> 00:14:58,450
.ومجرّد النّظر للخرائط كافٍ لجعلي سعيدة

184
00:14:59,090 --> 00:15:00,050
.وراضية

185
00:15:00,760 --> 00:15:05,270
لا يمكنني أن أصير الشّخص
.الّذي تريد منّي أن أصيره

186
00:15:06,900 --> 00:15:08,010
.بالمناسبة يا ريكا-سان

187
00:15:08,010 --> 00:15:09,780
ألن تتزوّجي؟

188
00:15:13,630 --> 00:15:17,900
.أخشى أنّه لا توجد علامات على حدوث ذلك

189
00:15:17,900 --> 00:15:19,300
فعلاً؟

190
00:15:19,300 --> 00:15:21,840
ظننتُ أنّه ربّما هنالك شخص
.في حياتك بالفعل

191
00:15:22,860 --> 00:15:27,800
لقد فشلتُ في زواجي
.وتسبّبت لك بالكثير من المشاقّ

192
00:15:27,800 --> 00:15:28,990
،لذلك السّبب

193
00:15:29,320 --> 00:15:33,160
.لا يمكنك إساءة اختيار شريك حياتك

194
00:15:33,420 --> 00:15:35,790
.لا يمكن إساءة الاختيار. لا يمكن إساءة الاختيار

195
00:15:35,790 --> 00:15:37,290
.لا يمكن إساءة الاختيار

196
00:15:38,590 --> 00:15:39,920
.لكن لا تعيريني اهتمامًا

197
00:15:39,920 --> 00:15:43,280
.واثقة أنّ اختيارك لشريك حياتك سيكون رائعًا

198
00:15:43,280 --> 00:15:47,150
احرصي على تقديمه لي إن عثرت
.على شخص مثله

199
00:15:47,150 --> 00:15:49,040
!وإيّاك أن تنسي

200
00:15:49,040 --> 00:15:50,800
.صحيح يا ريكا-سان

201
00:15:50,800 --> 00:15:53,310
ألا تعتقدين أنّ هذه الأريكة
والطّاولة في غاية الرّوعة؟

202
00:15:53,310 --> 00:15:54,390
—إنّ شقّتك بحاجة لـ

203
00:16:00,400 --> 00:16:02,740
.لم تردّ كما توقّعت

204
00:16:02,740 --> 00:16:04,190
لماذا؟

205
00:16:04,630 --> 00:16:06,680
.أريد أن أواعدك

206
00:16:07,300 --> 00:16:09,560
مهلاً، كيف يمكنني أن أسأل عن السّبب حتّى؟

207
00:16:09,560 --> 00:16:11,820
!بالطّبع لا تريد أن تردّ

208
00:16:11,820 --> 00:16:15,040
،أنا من تسبّب في هذا
!لذلك فما الّذي أقوله؟

209
00:16:17,830 --> 00:16:23,050
أتساءل إن كانت تأخذ إجازة
.في أيّام عملي عن قصد كي لا تراني

210
00:16:23,420 --> 00:16:25,980
،لكنّ طلبات الإجازة تُقدّم في نهاية الشّهر

211
00:16:25,980 --> 00:16:28,560
.ومثل هذه المصادفات واردة الحدوث

212
00:16:29,050 --> 00:16:33,280
.سأبدو مزعجًا إن حاولتُ الاتّصال بها ثانية

213
00:16:33,930 --> 00:16:37,680
.إضافة لتلقّينا لتلك الاتّصالات المشبوهة أيضًا

214
00:16:48,960 --> 00:16:50,100
!مرحبًا

215
00:16:50,940 --> 00:16:52,780
.الطّبيبة

216
00:16:52,780 --> 00:16:54,550
.شكرًا على اتّصالك

217
00:16:55,030 --> 00:16:56,880
تطعيمات كاما؟

218
00:16:57,440 --> 00:17:00,000
ماذا نفعل؟

219
00:17:00,000 --> 00:17:03,500
.نعم، صحيح. نعم

220
00:17:04,380 --> 00:17:06,600
.شكرًا على اليوم يا ريكا-سان

221
00:17:06,600 --> 00:17:08,630
.اعتني بنفسك يا أمّي

222
00:17:08,630 --> 00:17:10,480
.سأكون على اتّصال

223
00:17:10,480 --> 00:17:12,330
.احرصي على الإيمان بنفسك

224
00:17:12,330 --> 00:17:14,990
!بإمكانك القيام بما ترغبين فيه

225
00:17:14,990 --> 00:17:16,510
.نـ-نعم

226
00:17:16,510 --> 00:17:17,520
.مع السّلامة

227
00:17:22,700 --> 00:17:26,520
مرّ وقت طويل مذ أن غمرتني
.قوّة أمّي هكذا

228
00:17:30,160 --> 00:17:31,530
مرحبًا؟

229
00:17:31,530 --> 00:17:34,390
.قالت ابنتي أنّه لا يوجد أيّ شيء

230
00:17:34,390 --> 00:17:38,120
هل تلك القصّة عن زواجها صحيحة بالفعل؟

231
00:17:42,670 --> 00:17:45,750
.حاول أوهارا-كُن الاتّصال بي

232
00:17:45,750 --> 00:17:47,390
.واتّصل مرّتان

233
00:17:47,830 --> 00:17:52,090
.كنتُ مشغولة مع أمّي ولم ألاحظ

234
00:17:53,970 --> 00:17:58,630
.لـ-لكنّي لم أعتقد أنّه قد يتّصل بي

235
00:17:58,630 --> 00:18:02,870
سبق واقتحمت شقّته عندما
.لم ألحظ رسالته أيضًا

236
00:18:03,310 --> 00:18:04,940
.والأمر يتكرّر ثانية

237
00:18:05,630 --> 00:18:08,150
.يجب على الأقلّ أن أتّصل به

238
00:18:08,150 --> 00:18:09,810
ماذا أقول؟

239
00:18:09,810 --> 00:18:11,780
آسفة لأنّي لم ألحظ اتّصالك"؟"

240
00:18:11,780 --> 00:18:15,490
أم أقول "آسفة لأنّي لم أردّ
على طلبك تلك اللّيلة"؟

241
00:18:16,340 --> 00:18:17,620
...أو

242
00:18:17,950 --> 00:18:21,200
!لقد فكّرتِ في الأمر، ذلك هو ما يهمّ

243
00:18:21,200 --> 00:18:23,070
.أنت فتاة ذكيّة للغاية

244
00:18:23,070 --> 00:18:25,970
.فتاة ذكيّة. فتاة ذكيّة

245
00:18:26,470 --> 00:18:31,700
."أو ربّما أقول "آسفة لأنّي بهذه الحماقة

246
00:18:36,970 --> 00:18:41,350
.لكنّي أتساءل ما الّذي يراه فيّ أوهارا-كُن

247
00:18:42,060 --> 00:18:44,850
.واثقة أنّه أساء الفهم فحسب

248
00:18:44,850 --> 00:18:49,150
أي بتعبير آخر، مسألة الزّواج
المزيّف غير العاديّة هذه

249
00:18:49,150 --> 00:18:51,530
.تجعله يرى صورة خاطئة للوضع

250
00:18:51,530 --> 00:18:53,790
.نعم، إنّها إثارة ناجمة عن سوء فهم

251
00:18:53,790 --> 00:18:56,440
.أكيهابارا، أكيهابارا

252
00:18:54,530 --> 00:18:58,690
واثقة أنّ أمله سيخيب بمجرّد
.أن يتعرّف عليّ بالفعل

253
00:18:56,440 --> 00:18:59,120
.شكرًا على ركوبك

254
00:18:59,120 --> 00:19:00,620
.هذه أكيهابارا

255
00:18:59,350 --> 00:19:03,620
.ما أقصد أنّي لستُ شخصًا مميّزًا

256
00:19:00,620 --> 00:19:03,620
.يتوقّف هذا القطار في كلّ محطّة

257
00:19:04,370 --> 00:19:07,130
لذلك ما الّذي رآه فيّ على أيّ حال؟

258
00:19:12,360 --> 00:19:14,220
.حدث نفس الأمر وقتها

259
00:19:14,720 --> 00:19:18,720
.كنّا زملاء فصل، لكنّنا لم نتكلّم معًا أبدًا

260
00:19:19,560 --> 00:19:22,160
لماذا قد يرسل لي رسالة كهذه؟

261
00:19:22,160 --> 00:19:25,390
هل فعلتُ شيئًا يستحقّ أن يطلب لقائي؟

262
00:19:29,690 --> 00:19:32,620
!لا يُعقل أنّه سيقول أنّه معجب بي؟

263
00:19:32,620 --> 00:19:34,490
.لا، ذلك مستحيل

264
00:19:34,490 --> 00:19:37,780
.لا توجد ولو حتّى فرصة صغيرة لحدوث ذلك

265
00:19:39,050 --> 00:19:41,760
!ولكن في تلك الحالة، هل هذا مقلب؟

266
00:19:41,760 --> 00:19:43,290
!أهي مزحة ما؟

267
00:19:43,290 --> 00:19:46,990
!ربّما هو نوع جديد من الاحتيال

268
00:19:51,750 --> 00:19:55,760
كنتُ خائفة جدًّا لدرجة
.أنّي لم أغادر المنزل لثلاثة أيّام

269
00:20:20,260 --> 00:20:22,240
.لم تتوقّف المكالمات

270
00:20:22,780 --> 00:20:26,250
.انزويتُ وحدي ولم أتناول أيّ شيء حتّى

271
00:20:32,860 --> 00:20:35,280
...وبعد انتهاء العطلة

272
00:20:36,050 --> 00:20:38,340
انتظر الفتى الّذي طلب لقائي

273
00:20:38,340 --> 00:20:41,760
،لساعات طوال ثلاثة أيّام رغم حرارة الأجواء

274
00:20:42,100 --> 00:20:46,160
ثمّ فقد وعيه في النّهاية بسبب
.نوبة سيّئة من فقر الدّم

275
00:20:46,940 --> 00:20:49,400
.لم يكن مقلبًا أو مزحة

276
00:20:49,400 --> 00:20:51,850
.وبالطّبع ليس احتيالاً

277
00:20:53,810 --> 00:20:54,940
.ذلك صحيح

278
00:20:54,940 --> 00:20:57,520
.أساكوساهاشي، أساكوساهاشي

279
00:20:55,450 --> 00:20:58,190
.أنا حمقاء لهذه الدّرجة

280
00:20:58,690 --> 00:21:00,410
.لا يمكنني اتّخاذ القرارات لنفسي

281
00:21:00,410 --> 00:21:03,440
.لا أتأمّل في أيّ شيء، ولا أتوقّع أيّ شيء

282
00:21:04,720 --> 00:21:09,290
ولكن لماذا عليّ التّأكّد من مثل
هذه الأشياء في وقت متأخّر هكذا؟

283
00:21:09,680 --> 00:21:13,670
!أنا أعرف منذ مدّة قيمتي

284
00:21:15,680 --> 00:21:18,260
،لقد تقبّلتُ ذلك

285
00:21:18,260 --> 00:21:21,640
لذلك لماذا على كلّ هذه الأفكار
أن تخطر ببالي يومًا بعد يوم؟

286
00:21:21,640 --> 00:21:24,930
!لماذا على أوهارا-كُن تكبّد عناء الاتّصال بي؟

287
00:21:24,930 --> 00:21:28,180
!لماذا قد يقول أنّه مهتمّ لأمري؟

288
00:21:29,000 --> 00:21:33,940
هذا الكلام السّخيف عن الحبّ
!والزّواج يضايقني

289
00:21:35,660 --> 00:21:39,740
!عليّ كسر سلاسل الحبّ هذه في الحال

290
00:21:48,200 --> 00:21:49,810
!هـ-هونجوجي-سان؟

291
00:21:49,810 --> 00:21:53,270
...لـ-لماذا؟ أنا

292
00:21:56,600 --> 00:22:00,010
!أوهارا-كُن! علينا الخروج في موعد

293
00:22:01,360 --> 00:22:02,360
ماذا؟