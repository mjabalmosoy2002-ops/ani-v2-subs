1
00:00:00,470 --> 00:00:05,390
في فترة كانت فيها دول العالم تشنّ حرب
،معلومات حامية بعيدًا عن الأنظار

2
00:00:05,390 --> 00:00:09,310
ومن أجل مراقبة أفعال شخصيّة
،قياديّة في حكومة أوستانيا

3
00:00:09,310 --> 00:00:11,930
.بدأت وستاليس العمل بعمليّة ستريكس

4
00:00:11,930 --> 00:00:14,910
،العميل البارع الشّفق، الّذي أُوكلت له هذه العمليّة

5
00:00:14,910 --> 00:00:17,770
نجح في إتمام المرحلة الأولى
،الّتي تنصّ على إنشاء عائلة مزيّفة

6
00:00:17,780 --> 00:00:21,100
.وسجّل ابنته في مدرسة إيدن المرموقة

7
00:00:21,460 --> 00:00:26,000
حاليًّا، نجحت ابنته في الحصول على نجمة ستيلاّ

8
00:00:26,000 --> 00:00:28,670
،من بين ثماني نجوم تحتاجها لتصير عالِمًا ملكيّة

9
00:00:28,670 --> 00:00:30,500
،تدخل المهمّة مرحلتها الثّانية

10
00:00:30,500 --> 00:00:36,690
حضور اللّقاء الاجتماعيّ الّذي سيحضره
.أيضًا هدفهم دزموند

11
00:02:15,000 --> 00:02:17,310
واجب دراساتكم الاجتماعيّة التّالي سيكون

12
00:02:17,310 --> 00:02:20,060
.القيامَ ببحث عن المهنة الّتي أنتم مهتمّون بها

13
00:02:20,570 --> 00:02:26,570
يمكنكم زيارة مقرّ عمل آبائكم أو الذّهاب
.للقيام بلقاءات في المحلاّت والشّركات المحلّيّة

14
00:02:26,760 --> 00:02:30,120
يمكنكم أيضًا أن تجروا مقابلات
.مع أشخاص مشهورين من معارف آبائكم

15
00:02:30,120 --> 00:02:34,750
وبالطّبع، يمكنكم إجراء مقابلات معي أيضًا
.إن كنتم تريدون معرفة المزيد عن المدرّسين

16
00:02:34,750 --> 00:02:37,760
.سأخبركم بكلّ سرور عن مهنتنا المقدّسة

17
00:02:37,760 --> 00:02:42,350
.اجمعوا نتائجكم في تقرير
.ستقومون بتقديمه يوم الجمعة

18
00:02:42,780 --> 00:02:44,900
هل ستجري مقابلة مع والدك يا سيّد داميان؟

19
00:02:45,390 --> 00:02:46,620
.إن كان ذلك بالإمكان

20
00:02:47,480 --> 00:02:51,170
.أعتقد أنّ بإمكاني الإسراع إن سألت أبي فحسب

21
00:02:51,540 --> 00:02:53,010
ماذا عنك يا آنيا؟

22
00:02:57,370 --> 00:02:59,370
تحقيق عن الوظائف؟

23
00:02:59,810 --> 00:03:05,360
قيل أن أسأل عن السّبب الّذي دفعك
.لاختيار مهنتك وكيف يمكنني الحصول عليها

24
00:03:05,360 --> 00:03:08,290
.ويُفترض بي مراقبتك وأنت تقومين بعملك أيضًا

25
00:03:08,290 --> 00:03:10,860
ماذا؟ عملي؟

26
00:03:10,860 --> 00:03:14,370
ما-ماذا عليّ إخبارها؟ مهنتي؟

27
00:03:14,370 --> 00:03:15,540
أيّ واحدة؟

28
00:03:16,580 --> 00:03:18,480
.استمعي جيّدًا يا آنسة آنيا

29
00:03:18,480 --> 00:03:21,160
.سأريك الآن طريقة القيام بعملي

30
00:03:21,160 --> 00:03:21,880
.حسنًا

31
00:03:24,080 --> 00:03:27,820
،في البداية، بدأت هذا العمل لأستطيع العناية بأخي

32
00:03:27,820 --> 00:03:29,950
.ولكنّني الآن فخورة جدًّا به

33
00:03:29,950 --> 00:03:34,620
حتّى أنّ صاحب المحلّ قال أنّ هذا
،العمل مشابه لكوني في الجيش

34
00:03:34,620 --> 00:03:37,410
وهو مهمّ جدًّا لأنّنا نضع أرواحنا
.على المحكّ من أجل بلادنا

35
00:03:38,100 --> 00:03:40,590
إنّ صاحب المحلّ يتّصل بي
.من أجل عملي التّالي

36
00:03:41,150 --> 00:03:52,410
معلومات عن الزّبون

37
00:03:41,940 --> 00:03:44,400
.لا بدّ أنّ هذا هو الزّبون

38
00:03:44,400 --> 00:03:46,810
!إنّه خنزير خائن بالفعل

39
00:03:47,110 --> 00:03:51,580
يبدو أنّه اقترف الكثير من الأشياء
.الفظيعة لا أستطيع حتّى إخبارك بها

40
00:03:53,270 --> 00:03:55,630
.حسنًا، سنبدأ بالمراقبة

41
00:03:55,630 --> 00:03:57,340
أيمكنك مجاراتي يا آنسة آنيا؟

42
00:03:57,340 --> 00:03:57,930
.نعم

43
00:03:58,240 --> 00:04:03,050
سيُعلمني المحلّ بعدد الأعداء
،الموجودين وحالة الأمن هناك

44
00:04:03,050 --> 00:04:04,930
.لذلك كلّ ما عليّ فعله هو الدّخول

45
00:04:05,210 --> 00:04:07,230
،سأقتل أيّ عدوّ أراه في العادة

46
00:04:07,230 --> 00:04:09,920
،لكن لا يجب عليّ قتل الشّخص الخطأ أبدًا

47
00:04:09,920 --> 00:04:11,930
.لذا يجب قراءة وثائق التّوجيهات بعناية فائقة

48
00:04:12,320 --> 00:04:15,010
،لا يوجد أيّ شيء مخجل في هذا العمل
.لذلك يمكنني أن أكون واثقة

49
00:04:15,400 --> 00:04:16,780
!دخيلة

50
00:04:17,200 --> 00:04:18,920
أعتقد أنّ ما يجعل هذا العمل جديرًا

51
00:04:18,920 --> 00:04:22,110
هو أنّني أشعر فعلاً أنّني أنظّف
.الأوساخ من هذه البلاد

52
00:04:22,460 --> 00:04:26,600
،عندما أفكّر في كلّ الأرواح الّتي حماها عملي

53
00:04:26,600 --> 00:04:28,460
.أشعر بقوّة إضافيّة تتدفّق في كلّ حركة

54
00:04:28,950 --> 00:04:33,110
المهمّ في هذا العمل هو صقل جسدي
.وتقنياتي لأقصى الحدود

55
00:04:33,110 --> 00:04:36,320
.كما أنّ من المهمّ دراسة الجسم البشريّ

56
00:04:36,320 --> 00:04:38,240
،بما أنّني أتعامل مع البشر

57
00:04:38,240 --> 00:04:41,820
فإنّ أقلّ ما يمكنني فعله هو إنهاء
.بؤسهم بأقلّ قدر من الألم

58
00:04:41,820 --> 00:04:43,730
.أستسمحك عذرًا، لكنّني سأسلبك حياتك

59
00:04:46,350 --> 00:04:50,810
■■■■■ على سبيل المثال، إن
.الـ■■■■■ من عنق أحدهم

60
00:04:50,810 --> 00:04:53,050
.فسيموت بطريقة أسرع

61
00:04:53,450 --> 00:04:57,640
بإمكانك أيضًا مهاجمة نقاط المرء
.الحيويّة بدقّة مثل دماغه أو قلبه

62
00:04:58,130 --> 00:05:00,200
!هل أنت بخير يا آنسة آنيا؟

63
00:05:00,200 --> 00:05:04,340
!لنخبر لويد أنّنا ذهبنا لمهرجان الطّماطم فحسب

64
00:05:07,240 --> 00:05:10,120
.أعتقد أنّني سأقوم بتحقيق عن عمل بابا

65
00:05:10,120 --> 00:05:13,300
.هـ-هكذا إذًا... هذا خيار أفضل على الأرجح

66
00:05:13,300 --> 00:05:17,940
،العمل في مجلس المدينة جيّد
.لكنّه قد يكون مملاًّ نوعًا ما

67
00:05:17,940 --> 00:05:19,160
.لقد عدت

68
00:05:19,510 --> 00:05:22,300
.بابا، بلا بلا، إلخ إلخ

69
00:05:22,300 --> 00:05:23,880
.ماذا؟ مفهوم

70
00:05:25,680 --> 00:05:28,750
.أنا أعمل في قسم الطّبّ النّفسيّ في هذا المستشفى

71
00:05:29,270 --> 00:05:33,250
،أعلمتهم بمجيئك مسبقًا
لكن لا تسبّبي المشاكل لأيّ أحد، مفهوم؟

72
00:05:33,250 --> 00:05:34,000
.نعم

73
00:05:35,340 --> 00:05:36,650
.إنّه ضخم

74
00:05:36,650 --> 00:05:39,520
.هذا أقدم مستشفى في العاصمة

75
00:05:40,220 --> 00:05:43,420
،ربّما كان من الأسهل التّظاهر بأنّني طبيب عامّ

76
00:05:43,420 --> 00:05:47,240
لكن تتوافد العديد من الشّخصيّات البارزة
.في السّياسة والأعمال على هذا المستشفى

77
00:05:47,240 --> 00:05:51,510
يسمح لي هذا بالتّسلّل لدوائرهم الاجتماعيّة
.وسرقة الكثير من المعلومات

78
00:05:53,210 --> 00:05:56,030
.لم أقل أيّ شيء يتطلّب أخذك للملاحظات بعد

79
00:05:56,750 --> 00:05:58,910
بالمناسبة، لماذا ترتدين هذه الملابس؟

80
00:05:58,910 --> 00:06:01,590
.هذه هي ملابس المحقّق التّقليديّة

81
00:06:01,590 --> 00:06:02,530
.فهمت

82
00:06:10,140 --> 00:06:12,880
،لا يرتدي معظم الأطبّاء النّفسيّين معاطف بيضاء

83
00:06:12,880 --> 00:06:15,550
.لكنّه على الأرجح يجعلني أبدو كطبيب بارتدائه

84
00:06:16,330 --> 00:06:18,560
ما الّذي تحقّقين في أمره؟

85
00:06:19,080 --> 00:06:23,560
أوّلاً، لماذا اخترت هذا العمل؟

86
00:06:23,910 --> 00:06:25,940
لماذا اخترت هذا العمل؟

87
00:06:25,940 --> 00:06:27,940
...حسنًا، لنرَ

88
00:06:28,940 --> 00:06:31,310
يصاب الجميع بالزّكام أحيانًا، صحيح؟

89
00:06:31,710 --> 00:06:33,950
.الجسد ليس الوحيد الّذي يحتاج لعلاج
.يمرض العقل أيضًا

90
00:06:34,810 --> 00:06:38,400
ثمّة الكثير من الأشخاص الّذين
.يصابون بـ"الزّكام"، لكن في عقولهم

91
00:06:38,960 --> 00:06:43,190
لكنّ الابن الثّاني قال لي
.لن أصاب بالزّكام لأنّني غبيّة

92
00:06:43,190 --> 00:06:45,900
.فهمت... حافظي على علاقة جيّدة معه

93
00:06:46,470 --> 00:06:50,650
.لكن على أيّ حال، أردت مساعدة مثل هؤلاء الأشخاص

94
00:06:51,080 --> 00:06:56,530
ما زال هنالك الكثير من الجنود القدامى
.الّذين ما زالوا يعانون وإن انتهت الحرب

95
00:06:58,200 --> 00:07:03,660
،بما أنّ دزموند شخص منعزل
،أدركت أنّني إن أسعفني الحظّ

96
00:07:03,660 --> 00:07:07,440
قد يمنحني كوني طبيبًا فرصة
.للتّقرّب منه إن مرض

97
00:07:07,770 --> 00:07:10,230
.اتّخذت قراري عندما كنت في الجامعة

98
00:07:10,850 --> 00:07:14,990
عفوًا، سؤالي التّالي هو "ما هو الجرو
"العامّ في مكان عملك؟

99
00:07:14,990 --> 00:07:16,470
."تقصدين "الجوّ العامّ

100
00:07:16,470 --> 00:07:18,490
.إنّه الطّبيب فورجر

101
00:07:18,730 --> 00:07:21,610
أهذه هي ابنتك أيّها الطّبيب؟

102
00:07:21,920 --> 00:07:24,980
.هؤلاء هم زملاء عملي. ألقي التّحيّة

103
00:07:24,980 --> 00:07:27,140
.سووت بالتّعوّف عليكم

104
00:07:27,140 --> 00:07:28,910
!يا لظرافتها

105
00:07:28,910 --> 00:07:30,910
!تقومين بواجب مدرسيّ؟ يا لك من فتاة مجدّة

106
00:07:30,910 --> 00:07:33,890
!عيناها كبيرتان جدًّا! تبدو مثل أميرة

107
00:07:33,890 --> 00:07:35,130
.تفضّلي بعض الوجبات الخفيفة

108
00:07:36,060 --> 00:07:38,820
".مكان عمل بابا جنّة على الأرض"

109
00:07:38,820 --> 00:07:39,960
.أحسنت

110
00:07:40,730 --> 00:07:43,600
كيف هو بابا في العمل؟

111
00:07:43,810 --> 00:07:46,380
.إنّه يقوم بكلّ شيء بأسلوب مميّز

112
00:07:46,380 --> 00:07:48,950
.إنّه حريص وطيّب للغاية مع المرضى أيضًا

113
00:07:48,950 --> 00:07:51,670
.والدك شخص مذهل يا صغيرة

114
00:07:51,670 --> 00:07:55,230
.صار جزءًا مهمًّا من فريقنا بمجرّد انتقاله

115
00:07:55,230 --> 00:07:58,620
.ومع ذلك، هو رجل متواضع جدًّا ويحترمه الجميع

116
00:07:58,620 --> 00:08:04,330
بالمناسبة، كان صديقي طبيب الأعصاب يأمل
.في قدومك لاجتماعنا التّالي أيّها الطّبيب فورجر

117
00:08:04,330 --> 00:08:06,310
.أرادك المدير أيضًا أن تأتي للعب الغولف

118
00:08:06,310 --> 00:08:07,960
بابا محبوب؟

119
00:08:07,960 --> 00:08:11,290
.حسنًا... أنا حريص أن أكون اجتماعيًّا

120
00:08:11,530 --> 00:08:13,500
...حسنًا، سأتكلّم مع المدير

121
00:08:12,490 --> 00:08:15,020
.من الجيّد دائمًا أنّ أوسّع دائرة معارفي

122
00:08:15,400 --> 00:08:17,650
يسهّل ذلك من الحصول على
،المعلومات والمزيد من العلاقات

123
00:08:17,650 --> 00:08:20,760
وأهمّ شيء للجاسوس هو أنّ ذلك يجعل
".النّاس يقولون، "ماذا؟ مستحيل أنّه جاسوس

124
00:08:20,760 --> 00:08:23,650
من الضّروريّ تجسيد كيف أريد للنّاس
.أن يروا هذا الشّخص بالكامل

125
00:08:23,990 --> 00:08:26,310
عليّ أن أحاول ألاّ أجلب الانتباه
.إليّ كثيرًا، مع البقاء اجتماعيًّا

126
00:08:27,330 --> 00:08:29,280
"...ماذا؟ مستحيل أنّه"

127
00:08:29,280 --> 00:08:32,820
لماذا تأخذين ملاحظات في أكثر
الأوقات غرابة يا ترى؟

128
00:08:32,820 --> 00:08:36,000
"ما الصّعب بشأن هذا العمل؟"

129
00:08:36,000 --> 00:08:37,980
.هذا سؤال جيّد يا صغيرة

130
00:08:37,980 --> 00:08:39,390
...لنرَ

131
00:08:39,390 --> 00:08:43,300
سأقول أنّه حقيقة أنّنا نتعامل
.مع قلوب النّاس، والّتي لا يمكننا رؤيتها

132
00:08:43,680 --> 00:08:46,090
.فالأطبّاء ليسوا سحرة

133
00:08:46,090 --> 00:08:48,370
.لا يمكننا قراءة أفكار النّاس

134
00:08:49,760 --> 00:08:51,290
ما سبب هذه النّظرة المتعجرفة؟

135
00:08:51,680 --> 00:08:55,070
،ولأنّنا لا نستطيع قراءة الأفكار
،علينا التّخلّي عن تصوّراتنا المسبقة

136
00:08:55,070 --> 00:08:58,430
.والتّطرّق لهم بجدّيّة وحرص تامّ

137
00:08:58,430 --> 00:09:01,550
.كما يتعامل الجاسوس مع هدف

138
00:09:01,550 --> 00:09:05,040
.أهمّ شيء هو بناء الثّقة مع المريض

139
00:09:01,780 --> 00:09:04,090
إنّ أكبر فرق سيكون هو حقيقة

140
00:09:04,090 --> 00:09:07,180
...أنّ الجواسيس يخونون تلك الثّقة في النّهاية

141
00:09:05,040 --> 00:09:07,200
...كيّ شيء هشّ وينطوي على المخاطر

142
00:09:07,340 --> 00:09:09,060
.وجبات خفيفة. لذيذة، لذيذة

143
00:09:09,060 --> 00:09:11,140
أتريدين المزيد؟

144
00:09:11,140 --> 00:09:12,410
ماذا عن بعض العصير؟

145
00:09:12,410 --> 00:09:14,030
أتريدين القيام بفحص نفسيّ؟

146
00:09:14,030 --> 00:09:15,450
.لا يهمّ. لن أجيب على أسئلة أخرى

147
00:09:15,940 --> 00:09:17,330
.بابا، أنت جدّيّ للغاية

148
00:09:17,330 --> 00:09:19,740
.ولكنّ ذلك هو ما يجعله ممتازًا

149
00:09:19,740 --> 00:09:23,940
إنّنا نأمل أن يواصل صقل مهاراته
.ليتمكّن من فتح عيادته الخاصّة يومًا ما

150
00:09:24,240 --> 00:09:27,510
.المعذرة، أنا مشغول جدًّا ببحثي فحسب

151
00:09:27,510 --> 00:09:32,210
أعتقد أنّ أصعب جزء هو التّعامل
.مع مهمّتي وعملي الجانبيّ أيضًا

152
00:09:32,520 --> 00:09:34,990
.سنعود الآن لأعمالنا

153
00:09:34,990 --> 00:09:36,700
!إلى اللّقاء يا آنيا

154
00:09:37,110 --> 00:09:39,290
.أريد أن أراك تقوم بعملك

155
00:09:39,290 --> 00:09:40,750
تريدين رؤية استشارات نفسيّة؟

156
00:09:40,750 --> 00:09:44,450
.لا يمكنني السّماح بذلك لأنّه ينتهك خصوصيّة المريض

157
00:09:44,450 --> 00:09:47,740
.لا يمكنني أن أري الكثير من بحثي للغرباء أيضًا

158
00:09:48,330 --> 00:09:51,560
أعتقد أنّ بإمكاني على الأقلّ
.أن أريك غرفة استشاراتي النّفسيّة

159
00:09:52,950 --> 00:09:55,470
.لا أخطّط لاستعمال هذه الغرفة اليوم على أيّ حال

160
00:09:55,470 --> 00:09:57,370
.إنّها مختلفة عن غرفة العمليّات

161
00:09:57,370 --> 00:09:59,070
.تبدو مثل غرفة عاديّة

162
00:09:59,070 --> 00:10:01,730
.إنّنا نحاول ألاّ نثير قلق المريض قدر الإمكان

163
00:10:02,620 --> 00:10:05,140
أين آلة تعديل الدّماغ؟

164
00:10:05,140 --> 00:10:07,640
ما الّذي أمارسه هنا بالضّبط في رأيك؟

165
00:10:08,250 --> 00:10:11,390
.كفاك من هذا الهراء. لننته من الأسئلة الأخرى

166
00:10:11,390 --> 00:10:13,760
يا إلهي، تعلّمتِ هذا من أيّ رسوم متحرّكة؟

167
00:10:14,010 --> 00:10:16,510
.انتهت آنيا الآن. وأصابها الملل أيضًا

168
00:10:16,510 --> 00:10:18,470
!مهلاً! لا تلمسي الأشياء بدون إذن

169
00:10:18,470 --> 00:10:20,270
.سأغضب إن تسبّبت في الفوضى

170
00:10:20,270 --> 00:10:22,060
ثمّة ممرّ هرب سرّيّ

171
00:10:22,060 --> 00:10:25,310
خلف رفّ الكتب في حالة وجود
.حالة طوارئ تتعلّق بالمهمّة

172
00:10:25,310 --> 00:10:27,260
.سيُفتح إن سحبت الرّافعة

173
00:10:27,260 --> 00:10:29,660
!ممرّ سرّيّ! رافعة

174
00:10:32,190 --> 00:10:33,910
.لا بدّ أنّه عميل مع وايز

175
00:10:33,910 --> 00:10:36,140
.آسف، طرأ أمر ما

176
00:10:36,140 --> 00:10:39,310
،إن انتهيت من واجبك المدرسيّ
فهل نتّصل بيور لتأتي لاصطحابك؟

177
00:10:41,350 --> 00:10:43,900
.سأنتظر حتّى تنتهي من عملك يا بابا

178
00:10:43,900 --> 00:10:45,350
.من الصّعب أن يكون المرء جاسوسًا

179
00:10:45,350 --> 00:10:49,910
.حسنًا. في تلك الحالة، أشغلي نفسك بهذا

180
00:10:50,230 --> 00:10:52,360
.نستعمل هذه في عملنا

181
00:10:52,360 --> 00:10:56,370
نطلب من مرضانا وضع الألعاب والأغراض
.الأخرى حسبما يريدون في هذا الصّندوق

182
00:10:56,370 --> 00:10:57,810
.هذا ممتع جدًّا

183
00:10:57,810 --> 00:10:59,250
.يبدو مملاًّ لي

184
00:10:59,500 --> 00:11:02,430
.تذكّري، لا تلمسي أيّ شيء

185
00:11:02,430 --> 00:11:03,710
.نعم

186
00:11:03,710 --> 00:11:05,240
.سأعود بعد 10 دقائق

187
00:11:15,510 --> 00:11:20,080
يُفترض أن نحصل على وثائق للدّليل التّشخيصيّ
.والإحصائيّ المُراجَع في نهاية الأسبوع

188
00:11:20,080 --> 00:11:21,060
.شكرًا لك

189
00:11:21,840 --> 00:11:23,620
،وبالطّبع تماشيًا مع هذه الشّخصيّة الزّائفة

190
00:11:23,620 --> 00:11:27,030
تسلّل العديد من زملائي في العمل
.إلى هذا المستشفى

191
00:11:27,260 --> 00:11:29,420
.مهمّة منفصلة أخرى

192
00:11:29,420 --> 00:11:31,720
ماذا عن التّعديلات في جدول المستشفى؟

193
00:11:31,720 --> 00:11:32,790
.تمّت سلفًا

194
00:11:33,270 --> 00:11:35,970
هل كانت تلك الطّفلة هي آنيا فورجر؟

195
00:11:35,970 --> 00:11:37,690
.تبدو متعلّقة بك كثيرًا

196
00:11:37,690 --> 00:11:39,880
.إنّها صعبة المراس لأنّه لا يمكن توقّعها

197
00:11:40,490 --> 00:11:44,050
.أنا متفاجئة لأنّها تجاوزت توقّعاتك أيّها الطّبيب

198
00:11:49,590 --> 00:11:51,140
!أجل

199
00:11:51,880 --> 00:11:54,060
!الاستكشاف حماسيّ

200
00:11:54,460 --> 00:11:57,750
...الممرّ السّرّيّ ضيّق

201
00:11:57,100 --> 00:12:01,570
سيكون نقاشنا اليوم عن الظّواهر
.النّفسيّة وعلم الأعصاب

202
00:12:01,820 --> 00:12:03,490
اجتماع جادّ؟

203
00:12:03,490 --> 00:12:07,460
حوالي 5% من القضايا المبلّغ عنها
—لا تملك أيّ تفسير

204
00:12:07,460 --> 00:12:09,170
ما هذا الهراء؟

205
00:12:09,170 --> 00:12:12,590
إنّ كلّ من يدّعون رؤية الأشباح وما شابه
.يعانون من سلوك الكذب القهريّ

206
00:12:12,590 --> 00:12:16,080
أو قد تكون أوهامًا يسبّبها
.خلل في وظيفة الدّماغ

207
00:12:16,260 --> 00:12:18,300
.لا أساس علميّ لكلّ هذا

208
00:12:18,300 --> 00:12:21,100
!يتحدّثون عن الأشباح؟ يا للحماسة

209
00:12:25,320 --> 00:12:27,070
أسمعتم شيئًا ما؟

210
00:12:27,070 --> 00:12:29,700
.لكن لا توجد غرف فوقنا

211
00:12:29,700 --> 00:12:32,360
!كلاّ! سيكتشفون أمر الممرّ السّرّيّ

212
00:12:33,210 --> 00:12:35,350
.أ-أنا واثق أنّك تتخيّل فحسب

213
00:12:36,540 --> 00:12:40,480
،على أيّ حال، بالنّسبة لعلاج هذه الحالات

214
00:12:40,480 --> 00:12:42,490
—بإمكاننا اتّباع نهج حذر

215
00:12:42,490 --> 00:12:45,860
.لا فائدة من مناقشة هذا
.لننه هذا الاجتماع فحسب

216
00:12:46,880 --> 00:12:50,260
.عليّ العودة. سيعود بابا قريبًا

217
00:12:52,380 --> 00:12:54,820
!علقت ساقي ولا أستطيع إخراجها

218
00:12:55,890 --> 00:12:58,010
!آنيا في ورطة

219
00:13:05,030 --> 00:13:07,010
!ماذا؟! ثمّة شيء ما هناك

220
00:13:07,010 --> 00:13:08,600
!أهذا طفل يبكي؟

221
00:13:08,600 --> 00:13:11,430
!إنّه شبح! إنّه شبح بكلّ تأكيد

222
00:13:12,930 --> 00:13:15,680
!أخرجتها! عليّ العودة بسرعة

223
00:13:21,570 --> 00:13:22,650
اختفى؟

224
00:13:22,650 --> 00:13:24,250
!الأمر صحيح

225
00:13:24,250 --> 00:13:28,450
الإشاعات عن شبح طفل مات بسبب
!إهمال طبّيّ كانت صحيحة

226
00:13:28,720 --> 00:13:31,440
.أ-أيّها السّادة، لنواصل اجتماعنا

227
00:13:31,440 --> 00:13:32,550
!بالفعل

228
00:13:32,550 --> 00:13:36,960
من الآن فصاعدًا، لنأخذ المرضى
!الّذين يتكلّمون عن الأشباح بجدّيّة

229
00:13:41,950 --> 00:13:45,680
.والآن... أتساءل كيف سيكون صندوقها

230
00:13:45,680 --> 00:13:47,100
!عاد بابا

231
00:13:47,410 --> 00:13:49,870
.عليّ الإسراع والقيام بشيء ما

232
00:13:52,450 --> 00:13:53,590
.لقد عدت

233
00:13:53,590 --> 00:13:56,700
.ا-اللّعب بالدّمى ممتع للغاية

234
00:13:56,700 --> 00:13:57,950
.لنلق نظرة

235
00:13:58,150 --> 00:14:03,190
.أتعلمين؟ يمنحنا هذا نظرة أعمق لنفسيّة المريض

236
00:14:03,930 --> 00:14:05,940
...يبدو أنّ عقلك مليء بـ

237
00:14:06,320 --> 00:14:07,450
!الفوضى

238
00:14:08,160 --> 00:14:12,000
!ما-ما كلّ هذا؟ لم أر أيّ شيء كهذا من قبل

239
00:14:12,000 --> 00:14:13,900
.سكبت كلّ شيء في الصّندوق فحسب

240
00:14:14,360 --> 00:14:17,670
لـ-لماذا هنالك الكثير من الدّمى نصف المدفونة والمبعثرة؟

241
00:14:17,670 --> 00:14:23,450
.إنّها... هُزمت جميعها بهجوم الشّرّير المتدحرج السّاحق

242
00:14:23,450 --> 00:14:27,590
،لا أصدّق. لا أعرف كيف أفسّر هذا
!لكن واضح تمامًا أنّه كارثيّ

243
00:14:27,820 --> 00:14:30,170
لم أستطع حتّى رؤية الإشارات
.لأنّني كنت مشغولاً جدًّا

244
00:14:30,170 --> 00:14:33,710
.سُحبت من الميتم من طرف رجل لا تعرفه

245
00:14:33,710 --> 00:14:36,120
.من الطّبيعيّ أن تكون تحت ضغط كبير

246
00:14:36,120 --> 00:14:38,110
...لا يا بابا، هذا مجرّد

247
00:14:38,110 --> 00:14:41,630
أنا واثق أنّها فعلت أفضل ما يمكن
.لأيّ طفل فعله لتحمّل الأمر

248
00:14:41,630 --> 00:14:45,360
لكن لا أصدّق أنّ الظّلمة بداخل
...قلبها قد نمت لهذا الحدّ

249
00:14:45,360 --> 00:14:48,100
.لا، ربّما تظاهرت أنّني لم ألحظ الأمر فحسب

250
00:14:48,100 --> 00:14:51,600
.نعم، هذا نتيجة لضعفي الخاصّ
.أنا جاسوس فاشل

251
00:14:51,810 --> 00:14:53,320
!عليّ القيام بشيء ما في الحال

252
00:14:53,940 --> 00:14:55,950
لماذا لا نعود للمنزل فحسب؟

253
00:14:55,950 --> 00:14:58,930
سنمرّ على متجر الكتب ونشتري
.المجلّد الجديد لحروب الجواسيس

254
00:14:58,930 --> 00:15:00,510
...مـ-مرحى

255
00:15:00,820 --> 00:15:03,920
وما رأيك أن نجهّز تقريرك معًا بعد العشاء؟

256
00:15:03,920 --> 00:15:05,460
هل دوّنتِ ملاحظات جيّدة؟

257
00:15:05,460 --> 00:15:06,750
—بابا، ذلك

258
00:15:07,180 --> 00:15:08,750
!سيرى ما كتبت عن الجواسيس

259
00:15:11,040 --> 00:15:12,270
—هذا

260
00:15:12,930 --> 00:15:14,210
!لا يمكنني قراءة أيّ شيء

261
00:15:15,240 --> 00:15:17,370
.إنّ هذا... نعم

262
00:15:17,970 --> 00:15:21,110
.ستبذل آنيا جهدها لإعداد التّقرير بنفسها

263
00:15:21,110 --> 00:15:25,220
!نعم. أحسنت! أنت هي الأفضل

264
00:15:25,940 --> 00:15:27,860
.ماما، لقد عدنا

265
00:15:27,860 --> 00:15:29,570
.مرحبًا بكما

266
00:15:30,050 --> 00:15:33,780
هل تمكّنت من رؤية طريقة
لويد للعلاج الارتجاجيّ في العمل؟

267
00:15:33,780 --> 00:15:34,750
الارتجاجيّ؟

268
00:15:34,750 --> 00:15:37,120
لا، ذلك يا يور... كان للحالات الطّارئة
—القصوى فحسب

269
00:15:37,120 --> 00:15:39,620
!لقد لكم وركل مرضاه بقوّة كبيرة

270
00:15:39,620 --> 00:15:41,410
!كان من الرّائع أن أشهد على ذلك

271
00:15:41,410 --> 00:15:43,040
.بابا مليء بالعنف

272
00:15:43,630 --> 00:15:44,980
!يور

273
00:15:48,000 --> 00:15:49,970
غرفة الدّروس

274
00:15:48,860 --> 00:15:52,860
.أدركت أنّني أيضًا أريد السّير في طريق هذه المهنة

275
00:15:52,860 --> 00:15:53,480
.النّهاية

276
00:15:54,960 --> 00:15:58,510
.تقرير أنيق أبلغنا بمشاعرك خير تبليغ

277
00:15:59,330 --> 00:16:02,300
.حان دور آنيا فورجر الآن

278
00:16:03,890 --> 00:16:08,720
بابا جا— اختثاثيّ في الصّحّة
.النّفسيّة. وهو بارع في ذلك

279
00:16:08,990 --> 00:16:12,160
يعمل بابا بجدّ كلّ يوم ولا ينام

280
00:16:12,160 --> 00:16:16,730
أو يأخذ أدوية لألم المعدة ليتمكّن
.مرضاه من العشب بسلام

281
00:16:16,730 --> 00:16:21,240
كما قال أنّه يرغب بمساعدة النّاس الّذين
.يعانون بسبب ما عاشوه في الحرب

282
00:16:20,400 --> 00:16:22,010
.كم هو رائع

283
00:16:22,590 --> 00:16:24,930
.أحسنت يا لويد فورجر

284
00:16:24,930 --> 00:16:30,960
،وبهدف بناء الثّقة مع أهدافه
.يحدّثهم بأبجديّة وحذر

285
00:16:30,960 --> 00:16:31,830
أهداف؟

286
00:16:31,830 --> 00:16:34,820
.بابا حريص على الحصول على حلاقات

287
00:16:34,820 --> 00:16:38,340
لذلك يلعب الغولف في مكان عمله
.ولديه طُرق سرّيّة مشبوهة

288
00:16:38,340 --> 00:16:40,560
.كما أنّهم أعطوني وجبات خفيفة

289
00:16:40,560 --> 00:16:43,350
!وجبات خفيفة؟! أذلك وصف سرّيّ للرّشاوي؟

290
00:16:43,350 --> 00:16:47,180
.كما يبدو أنّه يضرب مرضاه من وقت لآخر

291
00:16:47,180 --> 00:16:49,660
!لويد فورجر؟

292
00:16:51,090 --> 00:16:52,760
!ما الخطب أيّها الشّفق؟

293
00:16:52,760 --> 00:16:55,290
.لا شيء، يراودني شعور سيّئ فحسب

294
00:16:55,290 --> 00:16:58,130
،استُدعي لويد للمدرسة بعد بضعة أيّام

295
00:16:58,130 --> 00:17:01,170
لكنّه تمكّن من الخروج من الورطة
.ببلاغته منقطعة النّظير

296
00:17:02,770 --> 00:17:06,200
."كُتب هنا "سرّيّ للغاية
.لا بدّ أنّها مهمّة بالغة السّرّيّة

297
00:17:07,830 --> 00:17:08,970
.إنّه رمز

298
00:17:10,060 --> 00:17:15,330
.الثّامنة صباحًا يوم السّبت، عند الجسر

299
00:17:20,950 --> 00:17:25,740
عجبًا، أنت بكلّ تأكيد من النّخبة كما
.يُقال إن استطعتَ حلّ تلك الشّيفرة

300
00:17:26,000 --> 00:17:28,010
!ستصنع آنيا شيفرة أيضًا

301
00:17:28,010 --> 00:17:30,150
.ها هي تلعب لعبة الجواسيس ثانية

302
00:17:33,860 --> 00:17:34,770
...آنيا

303
00:17:35,110 --> 00:17:36,590
!هذا بالغ السّرّيّة

304
00:17:37,610 --> 00:17:41,370
،لن يتمكّن أيّ أحد من قراءة ذلك
.ناهيك عن فكّ شيفرة الرّمز

305
00:17:45,410 --> 00:17:50,170
،من المستحيل قراءة خطّ يدها
.حتّى بمهاراتي الخارقة في فكّ الشّيفرات

306
00:17:50,370 --> 00:17:51,200
!صدمة

307
00:17:51,800 --> 00:17:53,690
.لديّ دورية ليليّة في العمل وعليّ الذّهاب

308
00:17:54,420 --> 00:17:56,270
.احرصي أن تدرسي

309
00:18:02,660 --> 00:18:05,410
.رائحته رائعة وهو نظيف الآن

310
00:18:05,410 --> 00:18:07,680
.ماما، لديّ طلب لو سمحت

311
00:18:07,680 --> 00:18:09,450
ما هو يا آنسة آنيا؟

312
00:18:09,740 --> 00:18:13,340
أيمكنك كتابة شيء ما لي كما طلبت؟

313
00:18:23,030 --> 00:18:24,830
.انتهى وضع الشّيفرة

314
00:18:25,890 --> 00:18:30,450
.اسمع جيّدًا ولا تخبر أحدًا. هذه مهمّة بالغة السّرّيّة

315
00:18:33,140 --> 00:18:34,620
.لديّ بريد لكم

316
00:18:36,460 --> 00:18:37,600
يا آنسة؟

317
00:18:38,990 --> 00:18:41,970
عليك وضع طوابع بريديّة على الرّسائل
ووضعها في صناديق البريد، مفهوم؟

318
00:18:41,970 --> 00:18:45,260
!صدمة! رفض الشّيفرة

319
00:18:45,260 --> 00:18:47,200
.لا يجب أن تفعلي ذلك يا آنسة آنيا

320
00:18:54,510 --> 00:18:56,580
ما هذه؟

321
00:18:58,150 --> 00:19:01,190
.يا لها من كتابات غريبة
أهذا مقلب من نوع ما؟

322
00:19:01,190 --> 00:19:05,240
.بالتّفكير في الأمر، كتب ابني شيئًا مماثلاً

323
00:19:05,240 --> 00:19:07,540
.كان يقلّد رسومًا متحرّكة عن الجواسيس أو ما شابه

324
00:19:07,540 --> 00:19:09,510
.هكذا إذًا

325
00:19:09,510 --> 00:19:12,810
أعتقد أنّ تلك الفتاة الصّغيرة
.تتظاهر دائمًا أنّها جاسوسة

326
00:19:14,720 --> 00:19:17,230
مرحبًا. ما الّذي تفعلينه هناك؟

327
00:19:17,550 --> 00:19:19,060
.أشعث الشّعر

328
00:19:19,060 --> 00:19:20,270
هل لويد هنا؟

329
00:19:23,760 --> 00:19:28,610
.ليس في المنزل؟ لا بأس
.أفترض أنّني سأعود في وقت لاحق

330
00:19:32,440 --> 00:19:35,270
ما هذه؟ رسالة من لويد؟

331
00:19:35,270 --> 00:19:37,290
.لا، لا، لا

332
00:19:37,690 --> 00:19:39,390
.إنّها بالغة السّرّيّة

333
00:19:46,610 --> 00:19:48,640
.صباح الخير يا آنيا

334
00:19:51,550 --> 00:19:54,300
ماذا؟ ما هذه؟ رسالة؟

335
00:19:56,670 --> 00:19:58,100
ليست رسالة؟

336
00:19:58,460 --> 00:20:01,290
عرفت! إنّه ذلك اللّغز
.الّذي يتحدّث الجميع عنه مؤخّرًا

337
00:20:02,920 --> 00:20:04,800
.إنّها بالغة السّرّيّة

338
00:20:06,850 --> 00:20:09,530
.يا إلهي... أنت لئيمة يا آنيا

339
00:20:09,530 --> 00:20:12,720
!أخبريني بالإجابة فحسب

340
00:20:18,450 --> 00:20:19,900
!إنّها بالغة السّرّيّة

341
00:20:20,490 --> 00:20:22,440
ماذا؟ ما هذه؟

342
00:20:23,560 --> 00:20:26,560
.إنّها شيفرة سرّيّة. حاول أن تفكّها

343
00:20:28,650 --> 00:20:31,580
!لماذا عليّ أن أفكّها؟

344
00:20:32,160 --> 00:20:33,710
!قومي بذلك بنفسك

345
00:20:44,570 --> 00:20:47,360
.آنيا متحمّسة لتعرف من سيأتي غدًا

346
00:20:50,560 --> 00:20:52,740
.هذا متوقّع

347
00:20:54,000 --> 00:20:56,320
.تمكّنت من فكّ الشّيفرة بالفعل

348
00:21:02,210 --> 00:21:04,430
.نعم، هذه رسالة البارحة

349
00:21:06,140 --> 00:21:09,670
،واضح لي أنّها شيفرة من نوع ما
ولكن ما هي بالضّبط؟

350
00:21:10,190 --> 00:21:14,290
إنّه خطّ يد جميل... أيعقل أنّه لامرأة؟

351
00:21:14,290 --> 00:21:16,720
.رائحته زكيّة أيضًا، مثل الصّابون

352
00:21:18,910 --> 00:21:22,120
!أهذه رسالة حبّ؟

353
00:21:24,980 --> 00:21:27,240
هل تستطيعين إعطاءه هذه من أجلي؟

354
00:21:27,600 --> 00:21:28,880
لا تخبري أيّ أحد، مفهوم؟

355
00:21:30,200 --> 00:21:32,530
.إنّها رومانسيّة بالغة السّرّيّة

356
00:21:37,870 --> 00:21:42,870
".الثّامنة صباحًا يوم السّبت، عند الجسر"

357
00:21:44,570 --> 00:21:49,010
إيّاكم والاستهانة بأفضل مخبر
!في الشّرق والغرب

358
00:21:49,010 --> 00:21:53,530
!فكّ شيفرة أو شيفرتين أسهل من شربة ماء عندي

359
00:21:53,780 --> 00:21:56,710
!مع أنّني لم أستطع النّوم إطلاقًا بسبب حماستي

360
00:21:56,710 --> 00:21:59,280
!أشعّة الشّمس ساطعة جدًّا

361
00:21:59,970 --> 00:22:02,520
.لا أصدّق أنّها طلبت منّي المجيء باستعمال شيفرة

362
00:22:02,520 --> 00:22:04,380
.أتساءل أين تعمل هذه العميلة

363
00:22:04,760 --> 00:22:07,130
!مهلاً، ربّما تكون مهوسة بالغموض فحسب

364
00:22:07,130 --> 00:22:12,000
"!فكّ شيفرة الحبّ هذه وتعال لرؤيتي"

365
00:22:25,810 --> 00:22:28,320
...بالغة السّرّيّة

366
00:23:59,950 --> 00:24:00,710
المهمّة × التّالية