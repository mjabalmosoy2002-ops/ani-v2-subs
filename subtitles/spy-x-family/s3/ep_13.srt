1
00:00:00,470 --> 00:00:04,560
،إن كنت لا تريدين أن يموت
فهلاّ وضعتِ المسدّس أرضًا؟

2
00:01:48,370 --> 00:01:50,250
!مهلاً، ماذا؟

3
00:01:50,250 --> 00:01:51,670
.قف على قدميك بسرعة

4
00:01:51,670 --> 00:01:54,260
ماذا؟ ما الّذي... ماذا؟

5
00:01:54,670 --> 00:01:55,840
...بالنّسبة للبشر

6
00:01:55,840 --> 00:01:59,300
يضع الدّماغ عادة ومن دون وعي حدًّا للقوّة

7
00:01:59,300 --> 00:02:02,390
الّتي يمكن استخدامها حتّى
.لا يطلق الإنسان كامل طاقته

8
00:02:02,390 --> 00:02:05,180
،والسّبب في ذلك أنّه لو حرّروا 100% من قوّتهم

9
00:02:05,180 --> 00:02:08,480
لتعرّضت العضلات والعظام
.لأضرار لا يمكن إصلاحها

10
00:02:09,060 --> 00:02:13,070
أمّا هذه المرأة... فقد حطّمتْ
.المحدّداتُ داخل دماغها بالكامل

11
00:02:13,070 --> 00:02:15,230
.وبعبارة أخرى، إنّها غاضبة

12
00:02:15,230 --> 00:02:16,900
.كم أنت ضعيف

13
00:02:17,610 --> 00:02:19,780
.أنت خائف من الموت

14
00:02:19,780 --> 00:02:21,740
.أنت خائف من التّعرّض للخيانة

15
00:02:21,740 --> 00:02:24,330
خائف كثيرًا لدرجة أنّك عاجز
.عن الوثوق بأيّ أحد

16
00:02:24,330 --> 00:02:27,370
لا تكلّف نفسك حتّى عناء التّمعّن في الآخرين

17
00:02:27,370 --> 00:02:30,920
،لتعرف إن كانوا جديرين بالثّقة أم لا
.بل وألقيتَ بكلّ تفكيرك جانبًا

18
00:02:30,920 --> 00:02:35,750
أنت رجل تافه قرّر التّدخّل في هذه
.الأمور لمجرّد تسلية نفسه فحسب

19
00:02:36,130 --> 00:02:40,090
.أنا لا أخافك. أنا أثق به

20
00:02:40,090 --> 00:02:45,430
،أنا أفكّر فيه دائمًا، دائمًا، دائمًا
.دائمًا، دائمًا

21
00:02:45,680 --> 00:02:47,890
!ولهذا السّبب أنا قويّة

22
00:02:48,270 --> 00:02:50,730
.لن تتمكّن من هزيمتي

23
00:02:50,730 --> 00:02:52,810
.اعفيني من هرائك

24
00:02:59,700 --> 00:03:03,070
.لكنّك الآن، فقدت يديك وقدميك بالكامل

25
00:03:03,070 --> 00:03:05,990
،إن ابتعدتُ بما يكفي
...لن تتمكّني من مهاجمتي

26
00:03:06,580 --> 00:03:07,750
!لكنّ ذراعها خُلعت من مفصلها

27
00:03:26,810 --> 00:03:28,060
.توقّفي

28
00:03:28,470 --> 00:03:32,520
.لا داعي لقتله، ولا داعي لتموتي

29
00:03:32,520 --> 00:03:33,980
—لو

30
00:03:33,980 --> 00:03:36,520
!أيّها الشّفق! هل أنت بخير؟

31
00:03:37,020 --> 00:03:38,940
.أنا في حالة أفضل منك على الأقلّ

32
00:03:39,280 --> 00:03:41,950
.الأهمّ الآن هو أنّنا بحاجة لربطه أوّلاً

33
00:03:43,740 --> 00:03:46,620
ألن يكون من الخطير تركه حيًّا؟

34
00:03:46,620 --> 00:03:49,700
ثمّة أطنان من المعلومات بإمكاننا
،الحصول عليها منه

35
00:03:49,700 --> 00:03:53,330
وإن وضعناه خلف القضبان، قد يكون
.أداة مفاوضات إن احتجنا إليه

36
00:03:53,330 --> 00:03:55,580
سنترك للمقرّ الرّئيسيّ قرار
.ما الّذي يجب فعله به

37
00:03:55,580 --> 00:04:00,510
بالمناسبة، لا أصدّق أنّه تغلّب
.عليك أيّها الشّفق

38
00:04:00,800 --> 00:04:04,010
والأهمّ من ذلك كلّه هو متى
!استعاد الشّفق وعيه؟

39
00:04:04,010 --> 00:04:06,760
!كلاّ! هل سمع ما قلتُه؟

40
00:04:06,760 --> 00:04:08,510
!لا، لا، لا، ذلك مستحيل

41
00:04:08,510 --> 00:04:10,470
كان الشّفق فاقدًا للوعي تمامًا
!عندما قلتُ كلّ ذلك

42
00:04:10,470 --> 00:04:12,020
!لا بدّ أنّه كان كذلك

43
00:04:12,020 --> 00:04:14,900
.أتمنّى ألاّ يكون قد سمعني
.أتمنّى ألاّ يكون قد سمعني

44
00:04:14,900 --> 00:04:17,770
إن سمعني بالفعل، فربّما يمكنني
...التّخلّص منه وثمّ سأواصل

45
00:04:17,360 --> 00:04:21,110
ماذا؟! المساء غاضبة جدًّا
!لدرجة أنّ وجهها صار أحمرًا؟

46
00:04:17,770 --> 00:04:19,650
!مهلاً، ما الّذي أقوله؟

47
00:04:21,900 --> 00:04:23,780
.أعرف ما تريدين قوله

48
00:04:24,200 --> 00:04:28,330
.ربّما فقدتُ حدّتي كما قلتِ من قبل

49
00:04:28,330 --> 00:04:30,700
.هذا صحيح أيّها الشّفق. فقدت حدّتك

50
00:04:30,700 --> 00:04:32,120
ما أنت الآن إلاّ سكّين لعبة
.بشفرة قابلة للطّيّ

51
00:04:32,120 --> 00:04:33,540
!آه، طيّ، طيّ

52
00:04:34,040 --> 00:04:35,870
هل إصابة ذراعك من ويلر أيضًا؟

53
00:04:36,290 --> 00:04:38,840
.لا، بل من يوري براير

54
00:04:38,840 --> 00:04:41,170
.طاردني إلى هنا وجرى قتال بيننا

55
00:04:41,170 --> 00:04:43,010
هل قضيتَ عليه؟

56
00:04:43,300 --> 00:04:48,300
.إنّ سبب زواج يور بي هو ليطمئنّ أخوها عليها

57
00:04:48,930 --> 00:04:50,430
،إن فقدته

58
00:04:50,430 --> 00:04:54,230
فستضيع تلك الأهمّيّة، ما سيؤدّي
.إلى عرقلة العمليّة ستريكس

59
00:04:57,230 --> 00:04:59,770
"إنّ حقيقة أنّه لا يناديها بـ"يور براير

60
00:04:59,770 --> 00:05:02,780
تجعل هذا يبدو لي
.أنّه مجرّد واجهة فحسب

61
00:05:03,280 --> 00:05:05,400
.لكنّ مشاعره صحيحة

62
00:05:05,400 --> 00:05:09,450
عندما يقول أنّه فعل شيئًا ما
.لأجل المهمّة، فلا يمكنني رفض ذلك

63
00:05:10,490 --> 00:05:12,160
.لا تلعبُ بإنصاف أيّها الشّفق

64
00:05:12,830 --> 00:05:14,710
.أنت... محقّ

65
00:05:15,660 --> 00:05:18,580
.سيأتي جهاز أمن الدّولة في أيّ وقت

66
00:05:18,580 --> 00:05:22,090
أريد مغادرة هذا المكان
...في أسرع وقت ممكن، لكن

67
00:05:23,340 --> 00:05:25,300
!لماذا أنتما مسترخيان هكذا؟

68
00:05:25,300 --> 00:05:26,760
!علينا الهرب في الحال

69
00:05:26,760 --> 00:05:29,180
!رجال جهاز أمن الدّولة في كلّ مكان هنا

70
00:05:29,180 --> 00:05:30,720
.شكرًا يا سيّدي

71
00:05:30,720 --> 00:05:34,310
أعرف أنّه ثقيل، لكن هلاّ حملتَه بدلاً منّا؟

72
00:05:34,310 --> 00:05:35,430
!أكيد

73
00:05:35,430 --> 00:05:38,100
.أيّتها المساء، سأعيد كتفك الأيسر إلى مكانه

74
00:05:44,780 --> 00:05:48,160
.لا بأس أيّها الشّفق. بإمكاني المشي وحدي

75
00:05:48,160 --> 00:05:50,530
كسرتُ أصابع قدمي وعظمة
.الشّظيّة في ساقي اليسرى فحسب

76
00:05:50,530 --> 00:05:53,240
.لا تكوني سخيفة
.سيلحقون بنا على هذا المعدّل

77
00:05:53,580 --> 00:05:56,120
.إنّك تضغطين على نفسك كثيرًا دائمًا

78
00:05:56,120 --> 00:05:58,210
.أنت آخر شخص أريد سماع ذلك منه

79
00:05:58,210 --> 00:06:00,250
.أنت عنيدة جدًّا

80
00:06:00,250 --> 00:06:02,210
.إن واصلتِ ذلك، فستموتين قريبًا

81
00:06:02,460 --> 00:06:03,670
.حسنًا إذًا

82
00:06:03,670 --> 00:06:05,880
.سأستسلم لمصيري وأقبل هذه الذّلّ

83
00:06:05,880 --> 00:06:08,510
.لكن أسرع رجاءً، أسرع بالصّعود للسّطح

84
00:06:08,510 --> 00:06:10,680
...ماذا؟ حسنًا

85
00:06:10,680 --> 00:06:12,390
.سأموت. سأموت الآن

86
00:06:12,390 --> 00:06:16,140
،إن لم يُنزلني قريبًا، سينفجر قلبي
.سأموت بالفعل هكذا

87
00:06:25,860 --> 00:06:31,200
كنّا محظوظين لأنّهم لم يملكوا عددًا كافيًا من
.الرّجال لإقامة نقاط تفتيش متعدّدة في المنطقة

88
00:06:31,200 --> 00:06:34,370
.لم يتعاونوا من الشّرطة المحلّيّة من الأساس

89
00:06:34,370 --> 00:06:36,700
واثق أنّ لهم أسبابهم لعدم
.التّمكّن من التّحرّك بحرّيّة

90
00:06:37,000 --> 00:06:40,420
على هذا المعدّل، سنتمكّن
.من العودة إلى برلينت بأمان

91
00:06:40,750 --> 00:06:45,380
بعد كلّ شيء، تمكّنّا في النّهاية
.من حماية حياة رفاقنا في الشّرق

92
00:06:45,380 --> 00:06:48,300
لكن يبدو أنّ الفريق الأزرق تلقّى رسالة

93
00:06:48,300 --> 00:06:51,680
تفيد بأنّ عميلنا المزروع داخل جهاز
.أمن الدّولة قد تمّت تصفيته

94
00:06:52,140 --> 00:06:55,560
،مع أنّنا أمسكنا بويلر
.خرجنا من هذا بلا أيّ مكسب

95
00:06:55,560 --> 00:06:57,100
.ذهبت كلّ جهودنا سُدى

96
00:06:57,100 --> 00:07:00,810
.كم أنا منهك اليوم

97
00:07:00,810 --> 00:07:03,400
أيّها الفتى الشّفق، ستذهب للشّرب
.معنا عندما نعود

98
00:07:03,400 --> 00:07:05,570
.ماذا؟! لا أستطيع

99
00:07:05,570 --> 00:07:08,030
أتيتُ إلى هنا بذريعة أنّ هنالك
.مسألة طارئة في العمل

100
00:07:08,030 --> 00:07:10,240
.إن لم أعد للمنزل، فسأجلب الشّبهات لي

101
00:07:10,240 --> 00:07:13,740
يا إلهي. تستعمل عُذر كونك رجلَ
.عائلةٍ متى ما كان ذلك مناسبًا لك

102
00:07:13,740 --> 00:07:16,540
.وكوني رجلَ عائلةٍ هو مهمّتي بالضّبط

103
00:07:16,830 --> 00:07:18,950
...ناهيكم عن ذكر

104
00:07:18,950 --> 00:07:20,790
ماذا؟ أتشاجرت مع زوجتك أو ما شابه؟

105
00:07:20,790 --> 00:07:21,500
!فعلاً؟

106
00:07:21,870 --> 00:07:25,460
لا، لا أدري إن كان يمكننا وصف
...ذلك بشجار من الأساس

107
00:07:25,460 --> 00:07:28,010
!أنا غير مسرورة بأيّ من هذا

108
00:07:28,010 --> 00:07:31,010
كـ-كيف تجرؤ؟! تتخلّى عن عائلتك
!حتّى في أيّام عطلتك؟

109
00:07:31,010 --> 00:07:34,430
بل الأمر أقرب لجهلي ما الّذي
.تفكّر به زوجتي الآن

110
00:07:34,430 --> 00:07:37,060
أعتقد أنّ ذلك قد يحدث حتّى
.لشخص مثلك إذًا

111
00:07:37,060 --> 00:07:40,730
هل يعني هذا أنّ لديّ فرصة لأكون
!الزّوجة الجديدة في العمليّة ستريكس؟

112
00:07:40,730 --> 00:07:44,400
.يبدو أنّ العمليّة ستريكس ما زالت في خطر

113
00:07:44,400 --> 00:07:48,440
بعد هذا، لنذهب إلى منزلك
.ونكتشف السّبب وراء هذا الشّجار

114
00:07:48,780 --> 00:07:53,410
ثمّ سأقوم بتوسيع هذا الصّدع
.الّذي بينهما أكثر

115
00:07:53,410 --> 00:07:56,410
لا تكوني سخيفة. عليك الذّهاب
.للمستشفى في أسرع وقت ممكن

116
00:07:56,410 --> 00:08:00,290
كفّي عن ذلك. الطّريقة الوحيدة للمساعدة
.في المشاكل الزوّجيّة هي بعدم التّدخّل فيها

117
00:08:00,290 --> 00:08:02,290
!آخر شيء أحاول فعله هنا هو المساعدة

118
00:08:13,130 --> 00:08:15,550
لستُ واثقًا إن كان هذا بسبب
،يومي الطّويل

119
00:08:15,550 --> 00:08:18,390
.لكن أشعر وكأنّي لم أعد للمنزل منذ مدّة

120
00:08:19,220 --> 00:08:23,440
،لو لم نتمكّن من إيقاف ويلر
.لما استطعتُ العودة إلى هنا إطلاقًا

121
00:08:23,440 --> 00:08:26,400
يشبه الحفاظ على استمرار عائلة
.فورجر السّير على حبل مشدود

122
00:08:26,810 --> 00:08:30,940
لهذا السّبب أحتاج إلى معرفة سبب
.شكوى يور الغامضة وغير المفهومة

123
00:08:31,360 --> 00:08:33,860
كيف تجرؤ على البقاء
!في العمل لوقت متأخّر؟

124
00:08:35,860 --> 00:08:37,030
.لقد عدت

125
00:08:37,450 --> 00:08:39,490
.مرحبًا بعودتك يا لويد

126
00:08:39,490 --> 00:08:41,250
.لا بدّ أنّك منهك بعد عملك حتّى هذه السّاعة

127
00:08:42,450 --> 00:08:43,410
—ما

128
00:08:44,210 --> 00:08:46,580
...ما الّذي... وكأنّ كلّ قواي خارت فجأة

129
00:08:46,580 --> 00:08:47,630
!لويد؟

130
00:08:47,630 --> 00:08:50,340
!إنّك تفقد حدّتك بالفعل أيّها الشّفق؟

131
00:08:50,340 --> 00:08:51,710
.لا ترخي دفاعك

132
00:08:51,710 --> 00:08:55,800
ربّما تُخفي تلك الابتسامة
.مقدارًا هائلاً من الكراهية

133
00:08:55,800 --> 00:08:58,680
يا إلهي. ما الّذي حدث لوجهك؟

134
00:08:58,680 --> 00:09:03,180
هذا... إنّ الحالة الطّارئة كانت تتعلّق
.بمصارع محترف لا يحبّ الإبر كثيرًا

135
00:09:03,180 --> 00:09:04,850
.كان الأمر صعبًا بالفعل

136
00:09:04,850 --> 00:09:06,650
ولكن أين آنيا؟

137
00:09:06,650 --> 00:09:08,480
يبدو أنّها كانت متعبة من اللّعب

138
00:09:07,270 --> 00:09:11,110
تريد آنيا ارتداء عُرف السّيّد
...أسد النّاعم أيضًا

139
00:09:08,480 --> 00:09:10,520
.لدرجة أنّها خلدت للنّوم بمجرّد وصولها

140
00:09:11,360 --> 00:09:13,820
عليك الخلود للنّوم أيضًا
.إن كنت متعبًا يا لويد

141
00:09:13,820 --> 00:09:15,110
،الأهمّ من ذلك يا يور

142
00:09:15,110 --> 00:09:17,070
...بخصوص هذا الصّباح

143
00:09:17,070 --> 00:09:20,410
أنا جدّ آسف لأنّه لم تتسنّى لي
.فرصة سماع ما لديك لتقولينه

144
00:09:20,830 --> 00:09:24,450
تسبّبتُ لك بالكثير من القلق
...بسبب عدم كفاءتي

145
00:09:24,450 --> 00:09:26,790
.كـ-كلاّ، الأمر ليس كذلك على الإطلاق

146
00:09:26,790 --> 00:09:28,830
.بل... أنا من عليها الاعتذار

147
00:09:28,830 --> 00:09:31,800
كان كلّ ذلك بسبب حديثي
...مع كاميلا والأخريات

148
00:09:33,670 --> 00:09:35,300
...ولهذا

149
00:09:35,300 --> 00:09:39,090
أريد أن أكون طبيعيّة قدر الإمكان، لذلك
.كنت أحاول إيجاد شيء ما لنتشاجر بشأنه

150
00:09:39,090 --> 00:09:41,720
.آسفة لأنّي جعلتك تقلق من لا شيء

151
00:09:42,260 --> 00:09:44,640
ماذا؟

152
00:09:46,230 --> 00:09:48,440
!لويد؟

153
00:09:48,730 --> 00:09:50,940
.لا يمكنني التّحرّك ولو شبرًا واحدًا

154
00:09:50,940 --> 00:09:54,940
لا يمكنني النّهوض. لا أملك
.الطّاقة حتّى للتّفكير بعد الآن

155
00:09:52,360 --> 00:09:54,320
!هل أنت بخير يا لويد؟

156
00:09:54,320 --> 00:09:55,900
!هل أتّصل بالإسعاف؟

157
00:09:56,450 --> 00:09:58,780
...لا، ما يهمّ الآن هو

158
00:09:58,780 --> 00:10:03,700
.قد يمنحك هذا شيئًا للشّجار بشأنه الآن

159
00:10:03,700 --> 00:10:07,290
ولكن هل يمكنني أن أسألك أن تتولّي
أعمال اليوم المنزليّة

160
00:10:07,290 --> 00:10:10,250
وتجهيز أشياء مختلفة للغد؟

161
00:10:11,500 --> 00:10:12,880
!سيسرّني ذلك كثيرًا

162
00:10:15,170 --> 00:10:18,050
لـ-لماذا تبدين سعيدة جدًّا هكذا؟

163
00:10:18,340 --> 00:10:23,010
حسنًا... ربّما لم أكن أبحث عن
.شيء ما للشّجار بشأنه بالتّحديد

164
00:10:23,010 --> 00:10:25,720
...ربّما أردتُ في الحقيقة أن أعتني بك أو ربّما

165
00:10:25,720 --> 00:10:28,020
.أردتك أن تعتمد عليّ

166
00:10:28,690 --> 00:10:32,020
لويد، إنّك قادر على القيام
...بكلّ شيء بنفسك

167
00:10:32,020 --> 00:10:35,570
ونادرًا ما تُظهر أنّك تواجه أوقاتًا صعبة
.حتّى عندما يكون ذلك صحيحًا

168
00:10:36,030 --> 00:10:39,950
لكنّي لا أعتقد أنّ عليك أن تكون
.مثاليًّا لذلك الحدّ بالفعل

169
00:10:40,280 --> 00:10:44,990
لذلك فإنّ قدرتك على إظهار بعض الضّعف
.أمامي جعلتني أشعر بقليل من السّعادة

170
00:10:45,910 --> 00:10:49,750
مع أنّه لا يمكن وصفي بشخص
.يُعتمد عليه بالضّبط

171
00:10:50,750 --> 00:10:52,670
.شكرًا لك يا يور

172
00:10:52,670 --> 00:10:56,210
إنّ سماعك تقولين هذا
.جعلني أشعر ببعض التّحسّن

173
00:10:56,920 --> 00:10:58,260
...ولكن يا يور

174
00:10:58,760 --> 00:11:02,470
.أُجبرتُ على إدراك كم أنّي ضعيف بشكل مؤلم

175
00:11:02,970 --> 00:11:05,600
،عندما نظرتُ إلى عينيه

176
00:11:05,600 --> 00:11:09,560
تذكّرتُ أنّه لا يمكنني النّجاة
.في هذا العالم ما لم أكن مثاليًّا

177
00:11:10,140 --> 00:11:10,980
...لذلك

178
00:11:11,980 --> 00:11:14,150
!اسمعيني يا أختي

179
00:11:14,150 --> 00:11:14,980
!يوري؟

180
00:11:15,360 --> 00:11:18,070
ما هذه الإصابات؟
!الجميع في حالة يُرثى لها اليوم

181
00:11:18,070 --> 00:11:20,280
...ماذا؟ إنّ هذه بسبب

182
00:11:20,700 --> 00:11:23,320
التّقرير الّذي كتبتُه بسرعة
كان مليئًا بالأخطاء

183
00:11:23,320 --> 00:11:25,490
.لذلك قام رئيسي بطرحي أرضًا

184
00:11:25,490 --> 00:11:26,410
ماذا؟

185
00:11:26,410 --> 00:11:28,080
مهلاً، أقلت الجميع؟

186
00:11:28,370 --> 00:11:31,330
.نعم... خضتُ شجارًا خفيفًا مع مصارع محترف

187
00:11:31,330 --> 00:11:34,540
جهّزتُ مريضًا مزيّفًا وعذر غياب موثوق

188
00:11:34,540 --> 00:11:36,670
لكي لا يتمكّن من اكتشاف أيّ
.شيء حتّى إن بحث في الأمر

189
00:11:37,250 --> 00:11:38,670
هل أعدّ بعض الشّاي؟

190
00:11:38,670 --> 00:11:40,470
!لا، لا بأس يا لويد

191
00:11:40,470 --> 00:11:42,130
.سأقوم أنا بكلّ شيء

192
00:11:42,130 --> 00:11:45,720
.اجلس واسترح قليلاً رجاءً يا لويد

193
00:11:47,260 --> 00:11:49,470
هل ذراعه اليمنى مصابة أيضًا؟

194
00:11:53,100 --> 00:11:54,560
.هذا مستحيل

195
00:12:02,820 --> 00:12:04,700
عفوًا... كيف أساعدك؟

196
00:12:04,700 --> 00:12:06,830
!مهلاً، ما الّذي تفعله يا يوري؟

197
00:12:06,830 --> 00:12:07,990
...لا-لا شيء

198
00:12:11,910 --> 00:12:13,250
.كم أنت لطيف

199
00:12:13,790 --> 00:12:15,380
.بالطّبع ليس هو

200
00:12:15,380 --> 00:12:18,710
بالتّفكير في الأمر، استطاع الشّفق
التّنكّر بهيئة ويلر

201
00:12:18,710 --> 00:12:21,880
ووزير الدّاخليّة الغربيّ وآخرين
.لا علاقة له بهم على الإطلاق

202
00:12:21,880 --> 00:12:23,800
.إنّه بارع لتلك الدّرجة

203
00:12:24,050 --> 00:12:25,260
!على أيّ حال

204
00:12:25,260 --> 00:12:29,220
،إن كنت قلقًا على لويد
.عد للمنزل اليوم لو سمحت

205
00:12:29,220 --> 00:12:30,560
!إنّه متعب للغاية

206
00:12:29,930 --> 00:12:32,560
!ماذا؟! هذا قاس يا أختي

207
00:12:32,560 --> 00:12:36,690
،مع أنّني تسلّلتُ قبل إنهاء تقريري
.لذلك سأكون في ورطة إن لم أعد

208
00:12:39,270 --> 00:12:42,030
.خذ حمّامًا رجاءً واحصل على راحة كافية

209
00:12:42,030 --> 00:12:43,610
.شكرًا لك

210
00:12:52,290 --> 00:12:55,460
أنا مسرور لأنّي غطّيتُ ذراعي
.تحسّبًا لأيّ طارئ

211
00:12:55,460 --> 00:12:58,960
استطاع ملاحظة تلك الغرابة المؤقّتة
.أثناء استعمال ذراعي في الحال

212
00:12:58,960 --> 00:13:00,590
.لا يجب أن أرخي دفاعاتي حوله

213
00:13:01,210 --> 00:13:05,430
لا أيّها الشّفق. هذا بالضّبط
.ما كنتَ تتحدّث عنه

214
00:13:05,720 --> 00:13:09,890
سأخسر في اللّحظة الّتي يشكّ
.فيها أيّ أحد بي ولو قليلاً

215
00:13:10,810 --> 00:13:12,520
!تمالك نفسك

216
00:13:17,520 --> 00:13:19,560
!ما رائحة الحريق هذه؟

217
00:13:19,560 --> 00:13:22,820
...لا يُعقل أنّ يوري براير عاد لأنّه يشكّ بي

218
00:13:22,820 --> 00:13:24,740
!لا ترخي دفاعك أيّها الشّفق

219
00:13:24,740 --> 00:13:25,650
!يور؟

220
00:13:25,650 --> 00:13:27,450
!كلاّ! أنا آسفة

221
00:13:27,450 --> 00:13:31,910
كنتُ أحاول كيّ قميصك الّذي سترتديه
!غدًا، فأشعلت فيه النّيران

222
00:13:31,910 --> 00:13:33,950
!أنا أطفئها! أنا أطفئها الآن

223
00:13:34,580 --> 00:13:36,460
...يبدو أنّ الأمر ميؤوس منه فعلاً

224
00:13:36,870 --> 00:13:39,670
!لويد؟

225
00:13:42,300 --> 00:13:44,760
هل أنت بخير يا فيونا؟

226
00:13:44,760 --> 00:13:48,840
سمعتُ أنّك سقطت في درج المستشفى
.من الطّابع الرّابع حتّى الأوّل

227
00:13:48,840 --> 00:13:51,810
،يا إلهي، قد تكونين خرقاء
!لكنّك لا تزالين ظريفة في نظري

228
00:13:51,810 --> 00:13:54,560
.أنا بخير، لذلك يمكنك المغادر أيّها المدير

229
00:13:54,560 --> 00:13:57,940
.كم أنت قاسية! لكنّني حضّرتُ لك غرفة خاصّة

230
00:13:57,940 --> 00:14:01,060
.أنا ممتنّة لذلك. شكرًا جزيلاً لك
.لكن غادر لو سمحت

231
00:14:01,860 --> 00:14:03,480
.إنّها غير مهتمّة على الإطلاق

232
00:14:03,480 --> 00:14:04,990
!مهلاً أيّها المدير

233
00:14:04,990 --> 00:14:08,530
،هذه المريضة مصابة بشدّة
!لذلك لا تسبّب لها قلقًا أكثر رجاءً

234
00:14:08,530 --> 00:14:10,160
!غادر في الحال

235
00:14:10,160 --> 00:14:12,990
!حسنًا! خذي هذه على الأقلّ
.أتيتُ لأقدّمها لك

236
00:14:12,990 --> 00:14:16,160
الملفّات الطّبّيّة للمرضى المهمّين
.الّذين سيتولاّهم الدّكتور فورجر

237
00:14:16,160 --> 00:14:18,000
هلاّ قدّمتِها له؟

238
00:14:18,000 --> 00:14:20,500
لماذا لا تقدّمها له بنفسك أيّها المدير؟

239
00:14:21,170 --> 00:14:26,420
حسنًا، سيكون ذلك مزعجًا
.وسأخسر فرصتي للحديث معك

240
00:14:26,420 --> 00:14:30,390
كما تعلمين... الدّكتور فورجر
.في إجازة اليوم أيضًا

241
00:14:30,390 --> 00:14:33,310
!ألم أخبرك ألاّ تجعل المريضة تقلق أكثر؟

242
00:14:33,310 --> 00:14:35,270
.سأقدّم له الملفّات غدًا

243
00:14:35,270 --> 00:14:38,890
!كلاّ! فيونا

244
00:14:40,900 --> 00:14:43,110
...ما الّذي تفعلينه هنا

245
00:14:43,980 --> 00:14:45,150
أيّتها المديرة؟

246
00:14:45,900 --> 00:14:49,150
أهكذا تتحدّثين إلى مديرتك
الّتي أتت للاطمئنان عليك؟

247
00:14:49,950 --> 00:14:51,620
أهنالك أيّ أجهزة تنصّت في هذه الغرفة؟

248
00:14:51,620 --> 00:14:53,490
.كلاّ. تحقّقت بنفسي

249
00:14:53,830 --> 00:14:57,000
.يبدو أنّ عمليّانا تسير جيّدًا هنا

250
00:14:57,000 --> 00:14:59,040
.غادري رجاءً إن لم يكن لك أيّ عمل هنا

251
00:14:59,370 --> 00:15:03,000
أنا هنا لتحمّل المسؤوليّة عنكما لأنّه
!لا أنت ولا الشّفق بإمكانكما التّحرّك

252
00:15:03,000 --> 00:15:04,630
!أتدرين كم أنّ أعدادنا قليلة؟

253
00:15:04,630 --> 00:15:06,170
!سأقوم بهذا لليوم فقط، مفهوم؟

254
00:15:06,170 --> 00:15:09,300
.هذا مؤلم. توقّفي رجاءً
.لا تجعليني أستدعي ممرّضة

255
00:15:10,260 --> 00:15:12,890
.كما أنّي أردتُ ارتداء زيّ الممرّضة أيضًا

256
00:15:13,430 --> 00:15:16,310
لا تتسلّلي إلى المستشفى
.وكأنّها لعبة لو سمحت

257
00:15:16,850 --> 00:15:18,640
.هذه نتائج فحوصاتك

258
00:15:18,640 --> 00:15:21,100
مع أنّ ذراعك مكسورة في عدّة
أماكن، إلاّ أنّها كسور كاملة

259
00:15:21,100 --> 00:15:23,770
والأضرار الّتي تكبّدتها في ألياف عضلاتك
.ليست سيّئة بالقدر الّذي خشيناه

260
00:15:24,270 --> 00:15:26,610
.يجب أن تكوني ممتنّة. ستتعافين سريعًا

261
00:15:26,610 --> 00:15:28,030
.ثمّ بإمكانك العودة للعمل

262
00:15:28,990 --> 00:15:33,070
كلّ ذلك بفضل اعتكافي في الجبال
.أتدرّب لمباراة الانتقام من تلك المرأة

263
00:15:34,490 --> 00:15:36,950
...يا لسخرية القدر

264
00:15:36,950 --> 00:15:39,540
.أحسنتم عملاً في القبض على ويلر

265
00:15:39,540 --> 00:15:42,710
،أدرك أنّي وضعتكم في وضع خطير
.حتّى لو كانت تلك مهمّتكم

266
00:15:45,670 --> 00:15:48,630
.لا تقومي بأيّ شيء قد يعجّل في موتك

267
00:15:49,460 --> 00:15:52,470
.أنت أيضًا واحدة من عملائي الظّريفين

268
00:15:55,640 --> 00:16:00,930
بقولك لظريفين، تقصدين أيضًا الّذين
.يعملون بجدّ ويطيعونك طاعة عمياء

269
00:16:00,930 --> 00:16:05,310
لن أنكر ذلك. على أيّ حال، واصلي
.الضّغط على نفسك، ولكن ليس كثيرًا

270
00:16:05,860 --> 00:16:08,270
.حتّى إن كان ذلك من أجله

271
00:16:08,270 --> 00:16:10,610
.إلى اللّقاء. احرصي على أن ترتاحي كثيرًا

272
00:16:16,280 --> 00:16:20,910
ماذا؟! هل تعرف المديرة
!بمشاعري تجاه الشّفق؟

273
00:16:23,620 --> 00:16:24,960
.إنّها ظريفة جدًّا

274
00:16:27,040 --> 00:16:28,550
!مستحيل

275
00:16:28,550 --> 00:16:31,920
!فطور ماما لذيذ نوعًا ما

276
00:16:31,920 --> 00:16:33,470
.وإن كان ذلك قليلاً فقط

277
00:16:33,470 --> 00:16:38,050
استيقظتُ في الخامسة صباحًا وعملت
.بجدّ لإعداده من كتاب وصفات

278
00:16:38,050 --> 00:16:41,020
.يور، ليس عليك الضّغط كثيرًا على نفسك

279
00:16:41,020 --> 00:16:43,230
.تبدين في حالة أسوأ من حالتي

280
00:16:43,230 --> 00:16:45,560
.كلاّ! أنا بخير يا لويد

281
00:16:45,560 --> 00:16:50,190
.ارتح اليوم فقط رجاءً
!سأعوّض عن إخفاقاتي من البارحة

282
00:16:50,190 --> 00:16:51,740
...شكرًا لك

283
00:16:51,740 --> 00:16:55,110
عليّ أن أتعافى من إصاباتي
.من مهمّة البارحة بسرعة

284
00:16:56,450 --> 00:17:00,200
!خاض بابا معركة جواسيس البارحة؟
!وتعرض لطلق ناريّ؟

285
00:17:00,660 --> 00:17:02,620
إذًا لن نخرج في لُزهة اليوم؟

286
00:17:02,620 --> 00:17:05,710
.أنا آسف، سأستريح في غرفتي اليوم

287
00:17:05,710 --> 00:17:08,630
.لديّ أطنان من التّقارير لكتابتها أيضًا

288
00:17:08,960 --> 00:17:12,050
.لنلعب في المنزل بصمت يا آنسة آنيا

289
00:17:12,590 --> 00:17:14,550
إن كان هنالك جزء من واجبك
،المدرسيّ لا تفهمينه

290
00:17:14,550 --> 00:17:16,050
.بإمكانك طلب المساعدة منّي في أيّ وقت

291
00:17:16,050 --> 00:17:18,050
.لا بأس! ركّز أنت على الرّاحة

292
00:17:20,970 --> 00:17:23,890
هل استمتعت بوقتك في حديقة
الحيوانات البارحة؟

293
00:17:23,890 --> 00:17:25,640
!كان ذلك ممتعًا جدًّا

294
00:17:25,640 --> 00:17:28,480
كان هنالك سيّد فيل وسيّد زرافة
!وسيّد فرس النّهر

295
00:17:28,480 --> 00:17:32,030
صحيح. هل نظّفت حقيبة ظهرك؟

296
00:17:32,030 --> 00:17:34,940
احرصي على إخراج منديل
.يدك حتّى أغسله

297
00:17:34,940 --> 00:17:36,910
.صحيح، لقد نسيت

298
00:17:43,370 --> 00:17:46,830
انظري! هذا السّيّد أسد
!الّذي أمسكت به آنيا البارحة

299
00:17:46,830 --> 00:17:48,670
.كم هذا رائع

300
00:17:48,670 --> 00:17:51,170
.لم ترَ آنيا السّيّد أسد من قبل

301
00:17:51,670 --> 00:17:55,630
!ملك الباغة اسم رائع جدًّا

302
00:17:55,630 --> 00:17:59,260
إنّه يشبه السّيّد كيميرا
.لذلك سأضعه إلى جانبه

303
00:17:59,260 --> 00:18:02,430
أنا مسرورة لأنّه صار
.للسّيّد كيميرا صديق جديد

304
00:18:00,600 --> 00:18:02,010
...غيرة

305
00:18:07,390 --> 00:18:08,770
!عجبًا

306
00:18:08,770 --> 00:18:11,900
!ملك الباغة بوند! أنت رائع جدًّا

307
00:18:13,360 --> 00:18:17,240
يا إلهي! لقد حرصتُ على تمشيطه
!جيّدًا هذا الصّباح

308
00:18:17,240 --> 00:18:19,910
!هذا رائع جدًّا يا بوند
أيمكنك تقليد السّيّد فيل أيضًا؟

309
00:18:19,910 --> 00:18:21,450
!إنّ لديه أنفًا طويلاً جدًّا

310
00:18:26,910 --> 00:18:28,000
!مذهل

311
00:18:32,540 --> 00:18:33,920
!حسنًا، قلّد السّيّد زرافة

312
00:18:33,920 --> 00:18:35,380
!لديه عنق طويل جدًّا

313
00:18:36,880 --> 00:18:41,140
.إنّه لا يستطيع يا آنسة آنيا
.سيؤذي بوند عنقه هكذا

314
00:18:41,720 --> 00:18:43,350
.للأسف

315
00:18:43,890 --> 00:18:45,060
!وجدتُها

316
00:18:45,060 --> 00:18:49,440
بإمكاننا تبليل عنقه وأقدامه لتبدو
.أنحف وسيفي ذلك بالغرض

317
00:18:54,480 --> 00:18:55,860
.تحوّلَ إلى السّيّد ألباكا الآن

318
00:18:56,690 --> 00:18:59,990
!أنا آسفة جدًّا يا بوند
.أعد أنّي سأمشّطك ثانية

319
00:19:02,990 --> 00:19:06,160
.يكون بوند الأفضل في حالته هذه

320
00:19:07,910 --> 00:19:10,080
.يبدو مريحًا جدًّا

321
00:19:11,460 --> 00:19:16,840
فرو بوند ناعم جدًّا الآن مقارنة بما
.كان عليها عندما تبنّيناه في البداية

322
00:19:16,840 --> 00:19:20,430
!آنيا أيضًا! تريد آنيا أن تصير ناعمة مثله

323
00:19:20,430 --> 00:19:21,680
...يا إلهي

324
00:19:28,680 --> 00:19:30,480
هل صار شعر آنيا ناعمًا أيضًا؟

325
00:19:30,480 --> 00:19:34,060
!نعم! صار حريريًّا وناعمًا جدًّا يا آنسة آنيا

326
00:19:34,060 --> 00:19:35,320
.تبدين ظريفة جدًّا

327
00:19:36,940 --> 00:19:40,610
.يا لويد. أحضرتُ الأشياء الّتي طلبتها

328
00:19:41,530 --> 00:19:42,700
.عمّي الأشعث

329
00:19:42,700 --> 00:19:44,530
.مرحبًا يا فرانكي

330
00:19:44,530 --> 00:19:47,370
.يا إلهي، إنّه يحبّ أن يُتعبني بالفعل

331
00:19:46,620 --> 00:19:47,660
!انظر

332
00:19:48,910 --> 00:19:51,580
!شعر آنيا يبدو حريريًّا وناعمًا جدًّا

333
00:19:54,040 --> 00:19:56,920
!ماما! لنمشّط عمّي الأشعث أيضًا

334
00:19:56,920 --> 00:19:58,500
ماذا؟

335
00:19:58,500 --> 00:20:01,260
سنجعل شعر عمّي الأشعث
!حريريًّا وناعمًا أيضًا

336
00:20:01,260 --> 00:20:02,260
...ناعم

337
00:20:03,010 --> 00:20:05,180
.مهلاً! ما الّذي تظنّين أنّك فاعلة؟ توقّفي

338
00:20:05,180 --> 00:20:07,060
!لا تفعلي يا آنسة آنيا

339
00:20:07,060 --> 00:20:09,640
!إن فعلتِ ذلك، لن نتعرّف عليه بعدها

340
00:20:09,640 --> 00:20:11,560
!ذلك قاس جدًّا يا أختاه

341
00:20:11,560 --> 00:20:14,560
!حسنًا! لنبدأ عمليّة النّعومة الحريريّة

342
00:20:14,560 --> 00:20:15,650
!لن يحدث ذلك

343
00:20:15,650 --> 00:20:17,480
!لن أسمح لك أن تسلبيني هويّتي

344
00:20:18,110 --> 00:20:22,570
أيّها الخائن بوباح! كيف تتخلّى عن
!رابطنا الرّجوليّ بهذه السّهولة؟

345
00:20:22,570 --> 00:20:23,740
!هذا مؤلم

346
00:20:22,570 --> 00:20:23,740
!كلاّ! المزهريّة

347
00:20:23,740 --> 00:20:25,490
!هذا مؤلم! كفّي عن سحبي

348
00:22:01,880 --> 00:22:04,590
!أجل، سيّد بوند الزّرافة

349
00:22:10,930 --> 00:22:12,930
!سيّد بوند الفيل

350
00:22:37,620 --> 00:22:39,420
!الكثير من بوند الصّغيرة

351
00:22:41,330 --> 00:22:43,500
!أجل! إنّه يطير

352
00:22:47,510 --> 00:22:50,840
!الكثير من بوند! هذا حماسيّ