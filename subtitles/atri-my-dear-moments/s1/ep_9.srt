1
00:00:03,350 --> 00:00:04,520
كذبتِ عليّ إذاً؟

2
00:00:05,270 --> 00:00:06,910
ما الأمر؟

3
00:00:07,900 --> 00:00:10,320
--هل شاهدت حلماً سيّئاً آخر

4
00:00:10,320 --> 00:00:11,190
!اصمتي

5
00:00:16,660 --> 00:00:18,740
تظاهرتِ بأنّ لديكِ قلب إذاً؟

6
00:00:19,370 --> 00:00:22,200
--تظاهرت؟ ماذا تقصد بـ

7
00:00:22,200 --> 00:00:23,710
!هذا يعني بأنّكِ كنتِ تكذبين

8
00:00:23,710 --> 00:00:26,500
هذا يعني بأنّكِ كنتِ تقولين
!كلاماً لم تقصديه فعليّاً

9
00:00:29,300 --> 00:00:30,880
لستُ أفهم

10
00:00:31,300 --> 00:00:35,720
عملي هو أن أكون مُفيدة لك
وأن أُسعدك يا ناتسكي

11
00:00:36,050 --> 00:00:38,760
هذا هو سبب تصرُّفاتي هذه

12
00:00:41,020 --> 00:00:44,690
هل قصدتِ ذلك عندما قلتِ
بأنّكِ قد تملكين قلباً؟

13
00:00:45,690 --> 00:00:50,860
هل قلتِ ذلك لأنّكِ تؤمنين
بأنّكِ تملكين قلباً فعلاً؟

14
00:00:55,320 --> 00:00:55,780
...لا

15
00:00:56,160 --> 00:00:57,740
!آمركِ إذاً

16
00:00:57,740 --> 00:00:59,410
!لا تتصرّفي وكأنّكِ لديكِ قلب

17
00:00:59,410 --> 00:01:01,290
!لا تُحاولي إسعادي

18
00:01:06,250 --> 00:01:06,830
حاضرة

19
00:01:10,880 --> 00:01:12,460
لماذا كذبتِ عليّ؟

20
00:01:12,460 --> 00:01:15,260
أجبتُ عن هذا السّؤال بالفعل

21
00:01:15,800 --> 00:01:17,340
هل تحبّينني؟

22
00:01:18,800 --> 00:01:20,850
...بوضعك الرّاهن الآن

23
00:01:23,930 --> 00:01:25,230
أكرهك

24
00:01:37,860 --> 00:01:38,950
!لا تتبعيني

25
00:03:28,640 --> 00:03:30,430
!أنا ذات أداءٍ عالٍ في النّهاية

26
00:03:31,980 --> 00:03:33,770
كانت كلّها كذبة إذاً؟

27
00:03:34,400 --> 00:03:36,440
...هذا... وهذا

28
00:03:37,110 --> 00:03:40,780
وهذا، وهذا، وهذا... كلّ شيء

29
00:03:40,780 --> 00:03:42,030
كلّها كانت أكاذيب؟

30
00:04:16,440 --> 00:04:20,360
هل أنتِ متأكّدة بأنّه بخير؟
يبدو وضعه خطيراً

31
00:04:20,360 --> 00:04:23,740
أجل. عندما وجدتُ ناتسكي-سينسي
،مغميّاً عليه في الأرض

32
00:04:23,740 --> 00:04:26,030
ظننتُ أنّ قلبي كان سيتوقّف

33
00:04:29,580 --> 00:04:34,160
شكراً لكما. سأتكلّم معه
لذا يمكنكما الذّهاب

34
00:04:34,160 --> 00:04:35,170
هل أنت متأكِّدة من هذا؟

35
00:04:35,170 --> 00:04:36,170
أجل

36
00:04:36,170 --> 00:04:38,880
حسناً، سنترك الباقي لكِ

37
00:04:55,440 --> 00:04:57,150
هل تشاجرتما؟

38
00:05:00,650 --> 00:05:01,820
...مينامو

39
00:05:02,740 --> 00:05:04,450
هل كنتِ تعلمين؟

40
00:05:07,280 --> 00:05:08,320
نعلم ماذا؟

41
00:05:09,070 --> 00:05:13,830
أقصد... كنتُ أعلم. إنّها بشريّة
آليّة في نهاية المطاف

42
00:05:15,160 --> 00:05:18,580
مُحال أن يكون لديها قلب

43
00:05:20,170 --> 00:05:24,300
كلّ ما تفعله أتري هو اختيار السُّلوك الأمثل

44
00:05:24,300 --> 00:05:27,130
بمُقارنة وضعها وردود أفعال الآخرين

45
00:05:27,130 --> 00:05:29,680
مع كمّ هائل من البيانات المُتجانِسة

46
00:05:30,220 --> 00:05:31,970
،عندما يكون الموقف يستدعي البسمة
فإنّها تبتسم

47
00:05:32,430 --> 00:05:33,770
وعندما يستدعي الغضب، فإنّها تغضب

48
00:05:34,480 --> 00:05:36,690
إنّها تنفِّذ برنامجها

49
00:05:36,690 --> 00:05:39,980
وتتّخذ التّعبير الملائم وتختار
وتنتقي الكلمات المناسبة

50
00:05:42,270 --> 00:05:45,610
هذا ما يفعله الإنسان الآليّ

51
00:05:56,120 --> 00:05:57,410
أتعلم؟

52
00:05:57,960 --> 00:06:02,630
أعتقد بأنّ البشر هم كذلك

53
00:06:03,000 --> 00:06:04,960
هكذا هي أنا

54
00:06:04,960 --> 00:06:09,890
أراقب مَن أتكلّم معه وأفكِّر كيف
ينبغي أن أستجيب لهم

55
00:06:10,390 --> 00:06:14,430
أراقب ردود أفعالهم وتعابيرهم
وأفكّر فيما يجب أن أقوله تالياً

56
00:06:15,430 --> 00:06:18,390
ما هو القلب أصلاً؟

57
00:06:19,600 --> 00:06:25,360
،حتّى لو علمنا بأنّنا على خطأ
،حتّى لو لم يكن هناك ما يُكسَب

58
00:06:25,360 --> 00:06:28,950
ينتهي المطاف بنا مع ذلك بفعل
شيء أو قول شيء

59
00:06:30,780 --> 00:06:38,080
كما قلت يا ناتسو-كن، أعتقد
بأنّ أتري لديها قلب

60
00:06:38,750 --> 00:06:43,170
أعتقد بأنّ كلّ ما في الأمر هو أنّ أتري
غير مُتيقّنة ممّا ينبغي أن تفعله

61
00:06:44,040 --> 00:06:47,800
إنّها قلقة من امتلاكها قلب

62
00:06:52,680 --> 00:06:53,600
...ساخن

63
00:06:53,600 --> 00:06:56,350
...آسفة، ارتأيتُ بأنّك قد تكون مُصاباً بنزلة برد

64
00:06:56,350 --> 00:06:58,890
هل أبرّده قليلاً؟

65
00:06:58,890 --> 00:07:00,100
لا مُشكلة

66
00:07:02,270 --> 00:07:04,360
هذا مثاليّ

67
00:07:11,910 --> 00:07:12,910
!صباح الخير

68
00:07:13,490 --> 00:07:17,410
،ذهبتُ لتفقّد أتري في هذا الصّباح
لكن كانت تتصرّف كما تتصرّف في العادة

69
00:07:17,950 --> 00:07:19,500
قالت بأنّها مُتوجِّهة إلى المدرسة

70
00:07:20,330 --> 00:07:21,620
هكذا إذاً

71
00:07:22,170 --> 00:07:27,050
سأخبر أتري والآخرين في المدرسة بأنّك
أُصِبت بنزلة برد، لذا لن تأتي اليوم

72
00:07:27,050 --> 00:07:29,340
لا، سأذهب أيضاً

73
00:07:29,340 --> 00:07:30,130
ماذا؟

74
00:07:30,130 --> 00:07:34,180
إذا لم أعطِ درساً، فهذا سيُزعج
الجميع في المدرسة

75
00:07:34,180 --> 00:07:35,300
...لكن

76
00:07:35,300 --> 00:07:36,510
...ناهيكِ عن ذلك

77
00:07:37,510 --> 00:07:40,890
لا أستطيع تجاهل أتري للأبد

78
00:07:42,230 --> 00:07:46,770
عرفتُ بأنّك ستقول ذلك... لذا
أحضرتُ زيّك الرّسميّ

79
00:07:50,440 --> 00:07:51,820
الأمطار لا تتوقّف

80
00:07:51,820 --> 00:07:52,740
أجل

81
00:07:54,360 --> 00:07:56,200
!ناتسكي-سينسي

82
00:07:57,990 --> 00:07:58,950
ماذا؟

83
00:07:58,950 --> 00:08:00,830
أين أترين؟

84
00:08:01,620 --> 00:08:02,960
ليست هنا؟

85
00:08:02,960 --> 00:08:05,170
...لكن قالت بأنّها ستأتي

86
00:08:11,010 --> 00:08:12,260
ما هذا؟

87
00:08:12,260 --> 00:08:14,430
لا عرف من أرسلها

88
00:08:14,430 --> 00:08:19,310
لكن تحتوي على تقرير حول سحب نماذج
الجيل الرّابع لمصنع ياماساكي

89
00:08:19,770 --> 00:08:21,600
...مصنع ياماساكي

90
00:08:22,600 --> 00:08:23,980
أي نموذج أتري؟

91
00:08:23,980 --> 00:08:29,780
أجل. أفترض بأنّ شخصاً عَلِمَ بأنّها
هنا قد أرسل هذه

92
00:08:31,610 --> 00:08:32,740
خرجَ نموذج عن السّيطرة؟

93
00:08:33,200 --> 00:08:37,280
،الوحدة المذكورة تجاهلت أوامر سيّدها

94
00:08:37,280 --> 00:08:39,870
وتسلّلت إلى داخل مدرسة وأذت طفلة

95
00:08:39,870 --> 00:08:40,790
أتري فعلت ذلك؟

96
00:08:40,790 --> 00:08:44,410
لا أدري ما إن كانت هي نفسها
الّتي سبّبت تلك الحادثة

97
00:08:44,830 --> 00:08:49,550
لكن العدد الإجمالي من هذا النّموذج
الّذي تمّ بيعه هو 58

98
00:08:49,550 --> 00:08:52,130
جميعهم تمّ استرجاعهم فيما عدا واحدة

99
00:08:52,130 --> 00:08:57,180
النّموذج الّذي سبّبَ الحادثة هرب وفُقِد تماماً

100
00:08:57,720 --> 00:09:01,470
لكن مصنع ياماساكي أخفى تلك المعلومات

101
00:09:01,470 --> 00:09:03,680
،في نفس وقت مُشكلة السّحب

102
00:09:03,680 --> 00:09:06,770
انخفض الطّلب على البشر الآليّين
وتمّ تفكيك الشّركة

103
00:09:06,770 --> 00:09:09,310
لم يتمكّنوا من استرجاع النّموذج الأخير

104
00:09:09,860 --> 00:09:12,280
هل تقصدين بأنّه أتري؟

105
00:09:12,280 --> 00:09:13,860
لا أملك أي دليل

106
00:09:14,360 --> 00:09:17,110
من المُحتمل جدّاً أن يكون هذا
التّقرير مُزيّفاً أيضاً

107
00:09:17,700 --> 00:09:21,910
،لكن بما أنّني أهتمّ بالأطفال
لا أستطيع تجاهُل هذا ببساطة

108
00:09:22,870 --> 00:09:29,250
تكلّمتُ معها بنفسي. "أنا آسفة، لكن
"لا أستطيع السّماح لكِ بدخول المدرسة

109
00:09:32,210 --> 00:09:35,670
اذهب. أنا مَدينة لك على أيّ حال

110
00:09:35,670 --> 00:09:38,390
سأهتمّ بالمدرسة

111
00:09:39,970 --> 00:09:41,140
شكراً

112
00:09:50,690 --> 00:09:53,650
أتري... خرجتْ عن السّيطرة؟

113
00:09:54,690 --> 00:09:57,110
ألهذا السّبب مُسِحت ذكرياتها؟

114
00:09:57,650 --> 00:10:00,530
...لا... ربّما كانت تتظاهر فحسب و

115
00:10:01,070 --> 00:10:02,410
...أيُعقَل

116
00:10:19,380 --> 00:10:20,430
من أنت؟

117
00:10:20,430 --> 00:10:22,140
اسمي ياسودا

118
00:10:22,390 --> 00:10:26,350
كنتُ في قسم التّطوير
...في مصنع ياماساكي

119
00:10:26,350 --> 00:10:27,850
للبشر الآليّين

120
00:10:29,060 --> 00:10:31,860
أنا آسف لإزعاجك بينما أنت
...على عجلة من أمرك

121
00:10:31,860 --> 00:10:34,650
لكن هل تمانع أن نجري مُحادثة بسيطة؟

122
00:10:38,360 --> 00:10:40,860
الأمطار لا تهدأ حقّاً

123
00:10:41,490 --> 00:10:43,780
لا بدّ أنّه من الصّعب التحرّك بهذه السّاق

124
00:10:43,780 --> 00:10:47,200
أنا لا أختلف عنك. أتفهّم ذلك تماماً

125
00:10:47,200 --> 00:10:50,170
لا داعي للالتفاف. أخبرني فحسب

126
00:10:50,710 --> 00:10:53,170
هل الشّخص الّذي خرج عن السّيطرة
وسبّب تلك الحادثة هو أتري؟

127
00:11:13,230 --> 00:11:17,230
أنا متأكّد بأنّ خطّ اليد هذا يبدو مألوفاً

128
00:11:17,570 --> 00:11:19,570
...سجلّ أتري

129
00:11:22,570 --> 00:11:25,660
ي هـ ن 0 4 ب 0 0 9

130
00:11:25,660 --> 00:11:28,910
هذا هو الرّقم التّسلسليّ الرّسميّ لتلك الوحدة

131
00:11:32,580 --> 00:11:36,750
هو تأسيس طريقة تعلُّم وذاكرة
أقرب إلى البشر

132
00:11:36,750 --> 00:11:39,260
لذا جعلناهم ينشئون سجلّات بالقراءة والكتابة

133
00:11:40,380 --> 00:11:43,720
اليوم هو اليوم الّذي ألتقي فيه"
"بسيّدي الأوّل

134
00:11:44,590 --> 00:11:46,350
"...اسم سيّدي هو"

135
00:11:48,970 --> 00:11:50,310
"شينا"

136
00:11:51,140 --> 00:11:52,600
ما رأيك؟

137
00:11:55,610 --> 00:11:58,360
!لا... لا يمكن أن يكون هذا صحيحاً

138
00:12:06,660 --> 00:12:10,120
...إنَّ صنع نُسخ منّا نحن البشر

139
00:12:10,120 --> 00:12:13,370
هل هذه إحدى أهداف العلم البشريّ النّهائيّة؟

140
00:12:13,370 --> 00:12:16,420
أم أنّها مُحرّمات لا يجوز أن نرتكبها؟

141
00:12:16,420 --> 00:12:20,630
هذا ما كان الأستاذ كونيشي يحاول معرفته

142
00:12:22,170 --> 00:12:23,380
...كونيشي

143
00:12:24,010 --> 00:12:28,430
هذا مُعلّمي. الشّخص الّذي صنع
تلك البشريّة الآليّة

144
00:12:28,430 --> 00:12:30,560
،نظراً إلى هيَجان تلك البشريّة الآليّة

145
00:12:30,560 --> 00:12:33,270
فقدَ مُختبر أبحاثه ومات

146
00:12:34,560 --> 00:12:39,270
عليّ أن أسترجع تلك الوحدة
،الّتي كنّا لا نزال نجري تجاربنا عليها

147
00:12:39,270 --> 00:12:41,360
والتخلّص منها

148
00:12:42,150 --> 00:12:46,740
أعتقد هذه هي الطّريقة الوحيدة الّتي يمكنني
بها تصحيح الأمور مع المُجتمع والأستاذ

149
00:12:47,990 --> 00:12:51,040
هل ستُساعدني في استعادتها؟

150
00:12:55,960 --> 00:12:57,790
لم يبقَ إلّا واحدة

151
00:12:57,790 --> 00:13:01,550
حالما تُدمَّر تلك الوحدة، ينتهي عملي

152
00:13:02,630 --> 00:13:04,510
أتفهّم شعورك

153
00:13:04,510 --> 00:13:07,800
نماذج الحيل الرّابع تلك مُتقنة الصّنع

154
00:13:07,800 --> 00:13:10,680
إنّها تُراقب خوارزميّة عواطف البشر

155
00:13:10,680 --> 00:13:14,730
وتتصرّف بنجاح كما لو أنّها تمتلك مشاعر

156
00:13:15,230 --> 00:13:19,230
لكن ليس وكأنّها تمتلك قلباً

157
00:13:21,320 --> 00:13:23,610
أنا متأكّد بأنّك أدركت ذلك أيضاً

158
00:13:23,610 --> 00:13:26,990
،مهما عبّرتَ لهم عن مشاعرك
فهي لا تبلغهم أبداً

159
00:13:27,450 --> 00:13:29,830
...أصغِ جيّداً. الشّيء الوحيد الّذي سينكسر

160
00:13:30,410 --> 00:13:32,790
هو قلبك أنت...

161
00:13:38,210 --> 00:13:42,090
...دعني أفكِّر في الأمر قليلاً

162
00:14:04,190 --> 00:14:05,320
عُدت

163
00:14:05,820 --> 00:14:07,490
أهلاً بعودتك

164
00:14:10,740 --> 00:14:12,950
تتصرّفين بشكل مختلف

165
00:14:12,950 --> 00:14:15,700
بما أنّك أمرتني بذلك

166
00:14:15,700 --> 00:14:19,830
إذاً إن طلبتُ متكِ التكلّم معكِ كما تفعلين
في العادة، فهل ستفعلين؟

167
00:14:20,250 --> 00:14:21,920
إن أمرتني بفعل ذلك، أجل

168
00:14:24,800 --> 00:14:25,920
...إذاً آمركِ

169
00:14:25,920 --> 00:14:28,170
تكلّمي معي كما تفعلين في العادة

170
00:14:30,510 --> 00:14:32,550
!أهلاً بعودتك يا ناتسكي

171
00:14:32,550 --> 00:14:34,600
هل أنت جائع؟

172
00:14:36,760 --> 00:14:39,730
أجل. على ذكر الأمر، لم آكل شيئاً

173
00:14:39,730 --> 00:14:41,690
!يا للهول! هذا فظيع

174
00:14:41,690 --> 00:14:47,240
لحظة واحدة فحسب! سأذهب
!لتسخين بعض من ماما 2

175
00:14:47,500 --> 00:14:48,360
تقصدين الكاري

176
00:14:48,820 --> 00:14:51,450
!كـ-كيف عرفت؟

177
00:14:51,450 --> 00:14:54,660
من الشّائع تناول الكاري بعد يوم
من تناولنا لحم وبطاطا

178
00:14:55,490 --> 00:14:57,290
لأنّهما لديهما نفس المُكوّنات

179
00:14:57,290 --> 00:15:00,710
!حقّاً؟ هذا مذهل يا ناتسكي

180
00:15:05,460 --> 00:15:06,250
أتري

181
00:15:06,250 --> 00:15:07,210
نعم؟

182
00:15:07,920 --> 00:15:09,970
لا تتصرّفي وكأنّ لديكِ قلب

183
00:15:18,100 --> 00:15:19,020
حاضرة

184
00:15:25,640 --> 00:15:26,860
تفضّل

185
00:15:45,420 --> 00:15:47,130
هل هو لذيذ؟

186
00:15:47,880 --> 00:15:52,130
هل يُسعدكِ عندما أقول بأنّه شهيّ؟

187
00:15:54,180 --> 00:15:54,760
أجل

188
00:15:54,760 --> 00:15:55,800
!كفِّي عن الكذب عليّ

189
00:15:55,800 --> 00:15:57,310
!هذا لا يجعلكِ سعيدة

190
00:15:57,310 --> 00:16:00,730
ذكاؤكِ الاصطناعيّ سيتذكّر ذلك
!فقط على أنّه الردّ الصّحيح

191
00:16:02,390 --> 00:16:04,150
أجل

192
00:16:04,980 --> 00:16:06,900
لأنّني بشريّة آليّة

193
00:16:08,230 --> 00:16:09,650
أنا آسفة

194
00:16:11,150 --> 00:16:12,150
...لا

195
00:16:13,110 --> 00:16:14,700
ينبغي أن أكون أنا من يعتذر

196
00:16:15,370 --> 00:16:19,240
أنا متأكّد بأنّكِ لا تعرفين
ما يجب فعله في وضع كهذا

197
00:16:19,240 --> 00:16:20,120
هذا صحيح

198
00:16:22,290 --> 00:16:24,040
هل ستخرج؟

199
00:16:24,040 --> 00:16:27,090
أريد أن أكون لوحدي. لا تتبعيني

200
00:16:48,060 --> 00:16:49,400
ماذا يجدر بنا أن نفعل؟

201
00:16:53,490 --> 00:16:56,610
الضّغط الجوّيّ الآخذ في الانخفاض
،سيُعزّز من سرعة رياحه

202
00:16:56,610 --> 00:16:58,580
لذا الرّجاء الحذر من الأمطار الغزيرة

203
00:16:59,160 --> 00:17:03,710
ستكون المناطق السّاحليّة شديدة
...الرّياح، لذا فالسُّفُن

204
00:17:21,930 --> 00:17:23,100
ما هذا؟

205
00:17:27,480 --> 00:17:28,860
أنا أنجرف؟

206
00:17:28,860 --> 00:17:30,270
!تبّاً

207
00:17:37,410 --> 00:17:38,530
ما هذا؟

208
00:17:45,290 --> 00:17:46,370
!أتري

209
00:18:08,350 --> 00:18:15,280
جاءت ريريكا وقالت بأنّ المدرسة"
"في ورطة لذا سوف أرافقها

210
00:18:17,780 --> 00:18:18,990
...المفكّرة

211
00:18:19,530 --> 00:18:20,820
!تبّاً

212
00:18:36,800 --> 00:18:40,590
...بـ-بالطّبع

213
00:18:41,590 --> 00:18:43,560
...لماذا لم أدرك

214
00:18:43,970 --> 00:18:44,850
...أنا

215
00:18:49,060 --> 00:18:49,850
...أتري

216
00:18:51,100 --> 00:18:51,900
!أتري

217
00:19:01,990 --> 00:19:03,620
...هانا-تشان-سينسي

218
00:19:03,620 --> 00:19:06,120
كيف يُطاوعك قلبك على أسر أطفال كرهائن؟

219
00:19:06,120 --> 00:19:08,040
لا سبب يدعو للقلق

220
00:19:08,040 --> 00:19:11,290
،حالما تصل الوحدة إلى هنا
سوف نُطلق سراحهم فوراً

221
00:19:13,750 --> 00:19:15,960
اصبرا فترة أطول قليلاً فحسب

222
00:19:15,960 --> 00:19:19,050
ألم تذهب ريريكا لإحضار أتري؟

223
00:19:19,050 --> 00:19:21,840
أجل. ينبغي أن تصلا في أيّ لحظة

224
00:19:29,180 --> 00:19:30,350
ها هي ذي

225
00:19:33,100 --> 00:19:35,190
أين سيّدكِ؟

226
00:19:35,520 --> 00:19:36,520
أين ناتسو؟

227
00:19:36,520 --> 00:19:38,900
لم أستطع... لم أستطع إيجاده

228
00:19:40,240 --> 00:19:41,490
...ناتسو-كن

229
00:19:41,860 --> 00:19:43,110
هذ غير مهمّ

230
00:19:43,570 --> 00:19:44,990
تعالي إلى هنا

231
00:19:56,210 --> 00:19:57,380
...أتري

232
00:19:58,420 --> 00:20:00,590
!هانا-تشان-سينسي

233
00:20:01,840 --> 00:20:05,600
اهدآ، اهدآ. أنتما بأمان الآن

234
00:20:06,180 --> 00:20:09,180
ماذا تنوي أن تفعل بأتري؟

235
00:20:19,780 --> 00:20:20,650
!أتري

236
00:20:25,280 --> 00:20:28,200
!حسناً إذاً. فليبدأ العرض الحقيقيّ

237
00:20:28,200 --> 00:20:32,160
أريدكم جميعاً أن تحفروا هذا
المشهد في ذاكرتكم

238
00:20:32,160 --> 00:20:35,500
!انظروا كم هي هذه البشريّة الآليّة خطيرة

239
00:20:40,550 --> 00:20:41,800
!أتري

240
00:20:42,300 --> 00:20:43,300
!أيّها الوغد

241
00:20:46,760 --> 00:20:48,470
اصمتوا وراقبوا

242
00:20:50,810 --> 00:20:52,480
...بئساً

243
00:20:54,270 --> 00:20:58,060
هجتِ وسبّبتِ تلك الحادثة، وأفسدتِ
،مصداقيّة الأستاذ

244
00:20:58,060 --> 00:21:00,190
وتجرّأتِ حتّى على الهرب

245
00:21:00,190 --> 00:21:04,490
كم من المُعاناة ستُسبّبينها للنّاس فحسب؟

246
00:21:07,450 --> 00:21:09,950
...صنعَكِ الأستاذ

247
00:21:11,080 --> 00:21:14,080
ومع ذلك تريدين أذيّته إلى هذه الدّرجة؟

248
00:21:20,500 --> 00:21:22,010
!أتري

249
00:21:30,850 --> 00:21:31,970
...اللّعنة

250
00:21:44,900 --> 00:21:46,150
...هيّا

251
00:21:46,950 --> 00:21:48,070
أرجوكِ

252
00:21:48,700 --> 00:21:51,280
...أحتاج

253
00:21:51,280 --> 00:21:53,080
...قطعة الخردة تلك

254
00:21:53,450 --> 00:21:58,080
!أحتاج... لرؤيتها

255
00:21:59,330 --> 00:22:01,880
...إنّها وقحة رغم أنّها روبوت

256
00:22:03,550 --> 00:22:06,720
،تظلّ تقول بأنّها عالية الأداء
...لكن لا تنفكّ ترتكب الأخطاء

257
00:22:10,430 --> 00:22:15,390
إنّها لا تصمت أبداً، وتفعل كلّ الأشياء
الخاطئة في أحلك الظّروف

258
00:22:16,520 --> 00:22:19,600
!لكن لديها قلب أجمل من قلب أيّ بشريّ

259
00:22:19,600 --> 00:22:23,190
!يجب أن أرى تلك البشريّة الآليّة الخردة

260
00:22:27,780 --> 00:22:29,990
!أيّتها القمامة المعيبة

261
00:22:29,990 --> 00:22:32,580
...بسببكِ الأستاذ قد

262
00:22:32,580 --> 00:22:35,080
...الأستاذ قد... الأستاذ قد

263
00:22:35,080 --> 00:22:37,540
!الأستاذ

264
00:22:41,560 --> 00:22:45,760
...ليتكِ... ليتكِ لم تُصنَعي أبداً

265
00:22:54,890 --> 00:22:55,770
!أتري؟

266
00:22:56,060 --> 00:22:57,180
!توقّف

267
00:22:58,060 --> 00:22:59,770
هذا يكفي

268
00:22:59,770 --> 00:23:02,650
ماذا؟ عمّاذا تتكلّمين؟

269
00:23:02,650 --> 00:23:07,150
هذه بشريّة آليّة. إنّها نكرة

270
00:23:08,400 --> 00:23:10,490
أليس هذا صحيحاً؟

271
00:23:10,910 --> 00:23:12,160
!توقّف

272
00:23:12,160 --> 00:23:17,700
على الأقلّ، أعتقد بأنّكِ برعتِ في خِداع
النّاس ودفعهم للشّفقة عليكِ

273
00:23:17,700 --> 00:23:20,670
أنتِ حقّاً بشريّ آليّ مُرعب

274
00:23:20,670 --> 00:23:22,460
لا يوجد ما ينقذكِ

275
00:23:22,460 --> 00:23:24,710
!أيّتها الوحش

276
00:23:26,750 --> 00:23:27,920
!أتري

277
00:23:34,800 --> 00:23:37,350
...ناتسكي