1
00:00:05,350 --> 00:00:08,860
!هـ-هذا... هذا مؤلم

2
00:00:14,260 --> 00:00:17,830
...النّجدة... البرد قارس

3
00:00:23,660 --> 00:00:26,830
!لا... لا

4
00:00:32,550 --> 00:00:34,840
!تبّاً! تبّاً

5
00:00:36,250 --> 00:00:37,330
...أمّي

6
00:00:40,880 --> 00:00:42,330
!أمّي

7
00:00:51,060 --> 00:00:52,330
...هذا من جديد

8
00:00:52,330 --> 00:00:53,850
استيقظت؟

9
00:00:54,690 --> 00:00:56,590
ماذا تفعلين هنا؟

10
00:00:58,250 --> 00:01:01,150
عجباً، لا تكُن مُخيفاً هكذا

11
00:01:03,320 --> 00:01:07,250
فقد أحضرتُ لك شيئاً يجعلك تُصبح فاحش الثّراء

12
00:01:09,100 --> 00:01:12,790
ابتعدي عن طريقي. وإغواؤكِ لن يفلح معي

13
00:01:12,790 --> 00:01:14,970
تحاول أن تتصرّف كشخصٍ ناضج

14
00:01:16,040 --> 00:01:18,790
!ستفلح الأمور هذه المرّة فعلاً

15
00:01:18,790 --> 00:01:23,140
أحد معارفي الموثوقين أخبرني بأنّها
ناجحة وباعني إيّاها

16
00:01:23,140 --> 00:01:25,970
وكم مرّة انخدعتِ من قبل؟

17
00:01:29,190 --> 00:01:31,710
ستموتين ميتة بشِعة إذا لم تتّخذي
الحياة بصورة جدّية

18
00:01:31,710 --> 00:01:33,820
!اصمت وجرّبها فحسب

19
00:01:33,820 --> 00:01:35,730
!مرّة واحدة فقط! مرّة فقط

20
00:01:36,170 --> 00:01:37,020
خُذ

21
00:01:39,090 --> 00:01:42,230
حسناً، تبدو هذه حتماً أفضل من الأُخرى

22
00:01:42,230 --> 00:01:43,990
!حقّاً؟

23
00:01:45,750 --> 00:01:47,870
...لا مانع لديّ

24
00:01:52,170 --> 00:01:54,520
...ليس وكأنّ لديّ شيء آخر أفعله

25
00:01:59,010 --> 00:02:00,760
في عالمٍ كهذا...

26
00:02:14,280 --> 00:02:19,190
من المُتوقَّع أن يكون مشروع أماتيراسو
مصدر طاقة جديد على نِطاق واسع

27
00:02:19,620 --> 00:02:25,120
بخصوص إطلاق الصّاروخ الّذي سيكون
،الخطوة الأولى من تنفيذ هذه الخطّة

28
00:02:25,120 --> 00:02:26,970
،هناك مُواطِنون يُعارضون الإطلاق بشدّة

29
00:02:26,970 --> 00:02:29,220
والّذي سيؤدّي غالباً إلى مزيد من الجِدالات

30
00:02:26,970 --> 00:02:29,220
هل سيحلِّق هذه المرّة حقّاً؟

31
00:02:29,220 --> 00:02:30,510
أجل

32
00:02:31,000 --> 00:02:34,560
أقصد إذا كان لديهم الوقت والمال
،لإطلاق صاروخ عملاق

33
00:02:34,560 --> 00:02:37,950
يمكنهم على الأقلّ إيجاد حلّ لمعيشتنا

34
00:02:38,950 --> 00:02:41,700
حتّى لو كنّا نتدبّر أنفسنا الآن، سينهار
كلّ شيء يوماً ما

35
00:02:42,200 --> 00:02:44,150
علينا أن نبني مستقبلنا

36
00:02:44,150 --> 00:02:46,580
لكن انظر إلى كومة القمامة هذه

37
00:02:46,580 --> 00:02:48,690
هل ستنجو هذه تحت الماء فعلاً؟

38
00:02:48,690 --> 00:02:50,810
أنتِ من طلب منّي النّزول، أتذكرين
أيّتها الآنسة العجوز؟

39
00:02:50,810 --> 00:02:52,140
!اسمي كاثرين

40
00:02:52,140 --> 00:02:54,940
نادِني بـ"الآنسة العجوز" وسوف
!أقذفك إلى الأعماق بنفسي

41
00:02:54,940 --> 00:02:57,770
كاثرين ليس اسمكِ الحقيقيّ حتّى، صحيح؟

42
00:02:57,770 --> 00:02:59,130
ما الفرق؟

43
00:02:59,130 --> 00:03:02,780
اصمت! لدى النّاس أسبابهم

44
00:03:02,780 --> 00:03:05,210
!ناتسو-كن

45
00:03:09,500 --> 00:03:11,970
ناتسو-كن، هيّا بنا إلى المدرسة

46
00:03:14,050 --> 00:03:15,220
يبدو أنّها تتكلّم معك

47
00:03:15,580 --> 00:03:17,630
إذا تجاهلتِها طويلاً بما يكفي، فستستسلم

48
00:03:17,950 --> 00:03:19,340
يبدو أنّكِ رُفِضتِ

49
00:03:19,340 --> 00:03:21,070
عليكِ أن تعرفي متى تستسلمين
عندما يتعلّق الأمر بالحُبّ

50
00:03:21,920 --> 00:03:24,100
!هـ-هذا ليس ما يجري هنا

51
00:03:27,190 --> 00:03:30,390
وأنا الّتي ظننتُكِ قد اختفيتِ أخيراً

52
00:03:30,390 --> 00:03:33,490
...لا تُصوّريني وكأنّني وباء أو ما شابه

53
00:03:33,620 --> 00:03:37,440
!أنا شريكة ناتسكي إيكاروغا الموثوقة في النّهاية

54
00:03:38,100 --> 00:03:39,490
!شريكة؟

55
00:03:39,840 --> 00:03:41,540
كفّي عن تلفيق الأمور

56
00:03:41,540 --> 00:03:43,990
أنتِ مُجرّد محتالة ظهرَتْ لتطرح
بعض العروض المُريبة

57
00:03:43,990 --> 00:03:45,440
!إنّها ليست مُريبة

58
00:03:45,440 --> 00:03:50,030
حقيقة وجود كنز في الأعماق
!في بيت جدّتك مُطلَقة

59
00:03:50,030 --> 00:03:52,050
جدّة ناتسو-كن؟

60
00:03:52,050 --> 00:03:54,260
تلك الجيو أو لا أدري ما اسمها؟

61
00:03:54,260 --> 00:03:57,750
الجيولوجيّة البحريّة الأستاذة نونكو ياتشيغوسا

62
00:03:57,750 --> 00:04:04,250
الاتّفاق هو استخدام هذا الشّيء لسحب
الكنز من منزل جدّتي وتقاسمه

63
00:04:04,250 --> 00:04:06,070
...هـ-هذا مُريب

64
00:04:06,070 --> 00:04:07,180
!هذا يكفي

65
00:04:07,180 --> 00:04:09,170
حسناً، هل هي جاهزة؟

66
00:04:09,170 --> 00:04:10,340
أجل

67
00:04:10,340 --> 00:04:12,680
ما دامت تلك القطعة الّتي أحضرتِها
ستنجح كما ينبغي

68
00:04:13,610 --> 00:04:15,260
!حقّاً؟

69
00:04:15,260 --> 00:04:18,680
لـ-لحظة! ستدخل المُحيط بهذا الشّيء؟

70
00:04:18,680 --> 00:04:19,350
أجل

71
00:04:19,350 --> 00:04:23,380
لا ينبغي لك ذلك حقّاً! ينبغي
!أن تُقدِّر حياتك أكثر

72
00:04:23,380 --> 00:04:24,990
كفِّي عن التدخُّل

73
00:04:24,990 --> 00:04:28,840
كِلانا نحتاج المال مهما كلّف الأمر

74
00:04:28,840 --> 00:04:31,720
وإلّا كيف سننجو في عالمٍ كهذا؟

75
00:04:34,590 --> 00:04:36,670
هل ستكون بخير حقّاً؟

76
00:04:36,670 --> 00:04:39,710
هل أنت متأكّد من أنّها لن ترميك في المُحيط

77
00:04:39,710 --> 00:04:42,370
بعد أن تشكرك على إيجاد الكنز فحسب؟

78
00:04:42,370 --> 00:04:43,270
مُمكن

79
00:04:43,270 --> 00:04:44,790
!مُمكن؟

80
00:04:44,790 --> 00:04:46,830
!لا تقل كلاماً كهذا

81
00:04:47,290 --> 00:04:49,920
إذاً هل ستأتين معي يا مينامو؟

82
00:04:49,920 --> 00:04:50,750
ماذا؟

83
00:04:51,470 --> 00:04:54,920
مضى سنوات منذ دخل هذا
الشّيء المُحيط

84
00:04:55,260 --> 00:04:57,210
أحتاج لأكبر قدر مُمكن من المُساعدة

85
00:04:58,890 --> 00:05:00,320
هذا ليس عدلاً

86
00:05:00,930 --> 00:05:02,000
ماذا تقصدين؟

87
00:05:03,370 --> 00:05:04,580
اِنسَ الأمر

88
00:05:06,650 --> 00:05:10,020
كان هناك ارتفاع مفاجئ في منسوب
البحر حصل في أنحاء المعمورة

89
00:05:10,500 --> 00:05:14,570
البلدات السّاحليّة القريبة من مستوى
البحر مُطوَّقة بواسطة المُحيط

90
00:05:14,570 --> 00:05:16,250
لا يزال السّبب مجهولاً

91
00:05:16,250 --> 00:05:18,930
توسُّع ماء البحر بسبب الاحتباس الحراريّ

92
00:05:18,930 --> 00:05:21,750
تبدُّل واسع النّطاق في قاع البحر
بسبب تغيُّر في قشرة الأرض

93
00:05:22,300 --> 00:05:26,330
،هناك عددٌ من النّظريّات المُشابهة
لكن لم يتمّ تأكيد أي واحدة منها

94
00:05:26,330 --> 00:05:29,590
بعد ارتفاع منسوب البحر، لم يعُد
،كما كان من قبل

95
00:05:29,590 --> 00:05:32,200
ليُسبِّب فقدان الكثير من المُدُن والبُنى التّحتيّة

96
00:05:32,200 --> 00:05:33,310
،وحتّى اللّحظة

97
00:05:33,310 --> 00:05:36,000
ما زال يلتهِم المزيد والمزيد من اليابِسة

98
00:05:37,240 --> 00:05:39,190
...المعذرة

99
00:05:39,190 --> 00:05:43,150
،بعد أن أدخل وأغلِق الكوّة
أريدكِ أن تحرّري هذه الخطّافات

100
00:05:43,150 --> 00:05:46,230
خطّافات؟ هل هي هذه الذِّراع؟

101
00:05:46,230 --> 00:05:48,780
كاثرين، أريدكِ أن تتحكّمي بالرّافعة

102
00:05:54,870 --> 00:05:55,980
...حسناً إذاً

103
00:06:01,630 --> 00:06:03,290
!اشتغلت بالفعل

104
00:06:04,700 --> 00:06:07,440
هل سيكون هذا الشّيء بخير حقّاً؟

105
00:06:07,440 --> 00:06:11,000
أسرعي وحرّري الخطّافات! فنحن
!لا نملك وقوداً لا نهائيّ

106
00:06:11,000 --> 00:06:12,140
...بئساً

107
00:06:14,910 --> 00:06:16,780
تنفيس خزّانات الصّابورة

108
00:06:17,600 --> 00:06:20,170
ربّما لا ينبغي أن تفعل هذا حقّاً

109
00:06:20,170 --> 00:06:23,800
،أنا أغوص في مكان ضحل
وأعرف بالضّبط إلى أين أذهب

110
00:06:23,800 --> 00:06:24,840
سأكون بخير

111
00:06:25,300 --> 00:06:28,050
ناهيكِ عن أنّني أحتاج للذّهاب مرّة على الأقلّ

112
00:06:28,050 --> 00:06:28,920
ماذا؟

113
00:06:29,590 --> 00:06:33,870
إذا لم ينزل أحدٌ إلى هناك، فقد
تضيع في البحر للأبد

114
00:06:34,370 --> 00:06:36,550
رغم أنّها المدينة الّتي عشنا فيها جميعنا

115
00:06:41,670 --> 00:06:43,020
...ناتسو-كن

116
00:06:49,480 --> 00:06:50,620
أهذه هي؟

117
00:06:56,640 --> 00:07:01,000
لا أصدِّق أنّه ما زال الكثير منها سليماً

118
00:07:06,040 --> 00:07:07,910
ناتسو-كن، أين أنت؟

119
00:07:09,030 --> 00:07:11,180
!مينامو، سآخذ الأسبقيّة

120
00:07:11,920 --> 00:07:12,900
!إلى اللّقاء

121
00:07:13,910 --> 00:07:16,860
!انتظرني يا ناتسو-كن

122
00:07:18,900 --> 00:07:20,250
هل وجدتها؟

123
00:07:21,610 --> 00:07:22,680
أجل

124
00:07:28,870 --> 00:07:30,050
ها هو

125
00:07:44,020 --> 00:07:45,520
ما هذا الشّيء؟

126
00:07:46,080 --> 00:07:48,570
ماذا؟ هل وجدت بعض الذّهب
!في الأسفل هناك؟

127
00:07:48,570 --> 00:07:52,200
بالطّبع لا. ليس وكأنّه يوجد
حُطام سفينة في الأسفل هنا

128
00:08:05,040 --> 00:08:07,380
...كبسولة؟ لا، لحظة

129
00:08:11,830 --> 00:08:13,200
إنّها فتاة

130
00:08:16,850 --> 00:08:18,030
دُمية؟

131
00:08:19,710 --> 00:08:21,550
لا بدّ أنّها بشريّة آليّة

132
00:08:22,440 --> 00:08:25,320
سوف أسحبها للأعلى. إليّ بخطّاف الرّافعة

133
00:08:25,320 --> 00:08:26,050
عُلِم

134
00:08:26,370 --> 00:08:29,080
من الواضح أنّها لا تبدو دُمية

135
00:08:29,080 --> 00:08:32,570
لا أصدِّق بأنّهم تمكّنوا من صنعها
...بهذا الإتقان

136
00:08:33,040 --> 00:08:34,620
لم أرَ شيئاً مثيلاً كهذا من قبل

137
00:08:48,650 --> 00:08:51,330
!ناتسو-كن! ناتسو-كن، ما الأمر؟

138
00:08:56,360 --> 00:08:58,800
...لا... لا

139
00:08:59,710 --> 00:09:00,930
!لا

140
00:09:00,930 --> 00:09:03,280
!ناتسو-كن! ناتسو-كن

141
00:09:03,280 --> 00:09:05,850
!لا

142
00:09:16,840 --> 00:09:19,650
أ... ت... ري؟

143
00:09:32,630 --> 00:09:33,530
...ذِراع التّدوير

144
00:09:33,530 --> 00:09:34,420
ماذا؟

145
00:09:35,080 --> 00:09:36,820
!فقط اسحبي ذِراع التّدوير

146
00:09:43,220 --> 00:09:44,490
!ناتسو-كن

147
00:09:52,610 --> 00:09:53,660
!ها هي ذي

148
00:10:00,210 --> 00:10:01,830
!ماذا؟

149
00:10:09,800 --> 00:10:10,930
...ساق

150
00:10:12,560 --> 00:10:14,230
إنّها ساقي الاصطناعيّة

151
00:10:15,950 --> 00:10:17,210
...لا جدوى

152
00:10:19,460 --> 00:10:20,990
لكن هذا جميل جدّاً

153
00:10:20,990 --> 00:10:25,190
...الضّوء... إنّه حقّاً

154
00:10:26,370 --> 00:10:27,710
جميل...

155
00:11:00,850 --> 00:11:02,910
...بشريّة آليّة

156
00:11:02,910 --> 00:11:04,670
إنّها روبوت إذاً؟

157
00:11:04,670 --> 00:11:07,530
أنتمي بالفعل لمجموعة من الآلات الدّقيقة
الّتي تُشيرون إليها

158
00:11:07,530 --> 00:11:09,980
،أنتم البشر بهذا الاسم العام

159
00:11:09,980 --> 00:11:13,530
لكن أعتقد أنّ ندائي بهذا غير دقيق

160
00:11:13,530 --> 00:11:18,490
مذهل... لم أرَ بشريّة آليّة تشبه
البشر إلى هذا الحدّ من قبل

161
00:11:18,490 --> 00:11:19,490
!بالطّبع

162
00:11:19,490 --> 00:11:21,530
!فأنا عالية الأداء

163
00:11:22,980 --> 00:11:26,680
أتعجّب من امتلاكها شيئاً كهذا يختبئ
...في الأسفل طوال هذا الوقت

164
00:11:31,870 --> 00:11:34,760
!إنّها غالباً تساوي الكثير من المال -
ماذا؟! ستبيعينها؟ -

165
00:11:34,760 --> 00:11:38,180
!بالطّبع! لهذا استخرجناها

166
00:11:38,180 --> 00:11:41,080
لكن لا ينبغي أن تفعلي ذلك
من دون إذن، صحيح؟

167
00:11:41,080 --> 00:11:43,000
!بالضّبط! يجب عليكِ ألّا تفعلي

168
00:11:43,000 --> 00:11:46,550
سيكون من غير القانونيّ بيعي
!من دون إذن سيّدتي

169
00:11:46,550 --> 00:11:48,010
سيّدتك؟

170
00:11:48,010 --> 00:11:50,160
!الأستاذة نونكو ياتشيغوسا

171
00:11:55,010 --> 00:11:56,940
...سيّدتك

172
00:11:57,890 --> 00:12:00,570
تُوفِّيت قبل شهر نتيجة مرض...

173
00:12:00,940 --> 00:12:03,830
ماذا؟ نونكو تُوفّيت؟

174
00:12:03,830 --> 00:12:05,560
...هكذا إذاً

175
00:12:05,980 --> 00:12:08,150
...المعذرة

176
00:12:08,150 --> 00:12:10,650
لقد ماتت إذاً

177
00:12:10,650 --> 00:12:12,580
هذا مؤسف جدّاً

178
00:12:12,580 --> 00:12:13,590
فلترقد بسلام

179
00:12:13,910 --> 00:12:15,700
...إ-إنّها تأخذ هذا الأمر ببساطة

180
00:12:15,700 --> 00:12:17,730
هذا طبيعيّ

181
00:12:17,730 --> 00:12:21,460
كلّ ما تقوله وتفعله هو
ما بُرمِجَتْ على فعله

182
00:12:21,460 --> 00:12:26,060
،لذا أجل. سيّدكِ الجديد هو حفيدها
أي هذا الفتى هنا

183
00:12:26,060 --> 00:12:28,050
عليكِ أن تصغي لأوامره الآن

184
00:12:30,690 --> 00:12:33,420
"أتطلّع قُدماً للعمل معك يا "هذا الفتى

185
00:12:33,420 --> 00:12:36,190
هل ينبغي أن أستمرّ في مُناداتك "هذا الفتى"؟

186
00:12:36,190 --> 00:12:41,050
،يمكنني أن أناديك أيضاً بابا، أخي الكبير
!أو الأخ الأكبر

187
00:12:41,720 --> 00:12:44,600
اسمي ليس "هذا الفتى". إنّه ناتسكي

188
00:12:46,050 --> 00:12:47,760
ناتسكي إيكاروغا

189
00:12:47,760 --> 00:12:49,860
ناتسكي؟

190
00:12:49,860 --> 00:12:51,700
ماذا ينبغي أن أناديكِ؟

191
00:12:51,700 --> 00:12:53,250
تقصد رقم نموذجي؟

192
00:12:53,650 --> 00:12:56,400
لا، اسمكِ. أليس لديكِ اسم؟

193
00:12:56,400 --> 00:12:57,210
...بلى

194
00:12:58,960 --> 00:12:59,900
إنّه أتري

195
00:13:01,510 --> 00:13:03,070
اسمي أتري

196
00:13:03,070 --> 00:13:07,140
!أ-ت-ر-ي. أتري

197
00:13:07,530 --> 00:13:08,550
...أتري

198
00:13:09,140 --> 00:13:12,120
أجل! عندما يُمنَح شيء مثل روبوت
،اسم مناسب

199
00:13:12,120 --> 00:13:16,130
فهذا دليل على أنّه تمّ الاعتراف
!به ككائن حيّ

200
00:13:16,130 --> 00:13:19,150
إنّها إحدى العلامات المُقدّرة الّتي
تمتلكها نفسي عالية الأداء

201
00:13:19,150 --> 00:13:23,110
لكن أعتقد بأنّ ناتسكي هو
اسم جيّد كذلك

202
00:13:23,110 --> 00:13:25,140
لماذا تنظرين إليّ بفوقيّة؟

203
00:13:25,140 --> 00:13:27,600
!ماذا؟ لكن أنظر إليك من الأسفل

204
00:13:29,690 --> 00:13:31,120
أظنّكِ لن تفهمي

205
00:13:35,060 --> 00:13:38,750
لحظة، هل سخر منّي... للتو؟

206
00:13:43,670 --> 00:13:48,080
احرصا على ألّا تبيعاها قبل أن أعود
من المدرسة، حسناً؟

207
00:13:48,080 --> 00:13:49,500
أجل، أعلم

208
00:13:50,730 --> 00:13:53,790
!لا تفعلي ذلك! أتسمعينني؟

209
00:13:57,570 --> 00:13:59,180
والآن ماذا سنفعل؟

210
00:14:02,040 --> 00:14:05,400
لا أملك الموارد الكافية لإبقاء
بشريّة آليّة معي

211
00:14:05,820 --> 00:14:08,700
ناهيكِ عن أنّني أحتاج لفعل
شيء بشأن هذه السّاق

212
00:14:08,700 --> 00:14:10,020
هذا يُرضيني أكثر

213
00:14:11,970 --> 00:14:12,770
أتري

214
00:14:12,770 --> 00:14:14,050
!حاضرة

215
00:14:14,770 --> 00:14:15,850
لنذهب

216
00:14:15,850 --> 00:14:18,380
هل سنتمشّى يا سيّدي؟

217
00:14:18,380 --> 00:14:19,800
ستعلمين قريباً

218
00:14:26,690 --> 00:14:30,300
إنّها بطيئة. هل أنت متأكّد من أنّها لن تهرب؟

219
00:14:30,300 --> 00:14:34,580
إنّها بشريّة آليّة. مُحال أن تعصي
أوامر سيّدها

220
00:14:35,020 --> 00:14:36,690
هل هذا المكان غريب؟

221
00:14:36,690 --> 00:14:40,100
أجل. كلّ شيء هنا جديد تماماً
بالنّسبة لي

222
00:14:40,560 --> 00:14:43,730
تغيّر هذا المكان كثيراً في السّنوات
القليلة الماضية

223
00:14:44,370 --> 00:14:45,860
كم مضى على نومكِ؟

224
00:14:46,250 --> 00:14:49,530
هل كنتُ نائمة كلّ هذه المدّة الطّويلة؟

225
00:14:49,530 --> 00:14:51,710
لا تعلمين حتّى؟

226
00:14:51,710 --> 00:14:56,020
لا أعلم. يبدو وكأنّ كافّة ذكرياتي قد فُقِدت

227
00:15:03,260 --> 00:15:04,490
اتبعيني

228
00:15:04,490 --> 00:15:05,500
!مهلاً

229
00:15:10,520 --> 00:15:11,800
اختاري الحذاء الّذي تريدينه

230
00:15:11,800 --> 00:15:13,700
ماذا؟ ستشتري لها حذاء؟

231
00:15:13,700 --> 00:15:16,920
هذا سيمنع انخفاض سعرها، صحيح؟

232
00:15:16,920 --> 00:15:18,510
...هكذا إذاً

233
00:15:18,510 --> 00:15:19,210
ماذا؟

234
00:15:19,210 --> 00:15:24,990
،هذا الحذاء مناسب من حيث المقاس
لكن هذا مناسب من حيث الجماليّة

235
00:15:26,120 --> 00:15:28,090
سيستغرق هذا وقتاً طويلاً

236
00:15:28,090 --> 00:15:29,650
اختر حذاء لها فحسب

237
00:15:36,590 --> 00:15:37,930
ما رأيكِ؟

238
00:15:37,930 --> 00:15:39,830
!قياسه مثاليّ

239
00:15:42,370 --> 00:15:44,560
هل أنتِ سعيدة إلى هذا الحدّ بشأن حذاء؟

240
00:15:44,560 --> 00:15:45,570
!أجل

241
00:15:46,890 --> 00:15:48,660
...لأنّك كنت لطيفاً بما يكفي

242
00:15:49,690 --> 00:15:52,560
!لمنحي شيئاً يا سيّدي

243
00:15:57,220 --> 00:15:59,890
هل من الغريب أن أكون بهذه السّعادة؟

244
00:16:00,390 --> 00:16:03,650
لا. ليس غريباً

245
00:16:05,840 --> 00:16:09,230
لا يمكنك أن تميّز حتّى بأنّها غير بشريّة

246
00:16:09,230 --> 00:16:13,000
حسناً، ربّما لهذا توقّفوا عن صنعهم

247
00:16:17,570 --> 00:16:19,090
هل أنت بخير؟

248
00:16:21,460 --> 00:16:24,430
...خُلِعت قبل مدّة

249
00:16:24,430 --> 00:16:27,920
ناهيكِ عن أنّ هذه السّاق الاصطناعيّة
هي نموذج أقدم

250
00:16:27,920 --> 00:16:30,530
لذا هي ليست ذات أداء عالٍ إذاً

251
00:16:31,380 --> 00:16:33,330
حسناً، شيء من هذا القبيل

252
00:16:50,640 --> 00:16:55,240
...هكذا إذاً

253
00:16:55,240 --> 00:16:58,330
إنّها نموذج مصنع ياماساكي جيل رابع

254
00:16:58,780 --> 00:17:01,790
إنّها أحدث بجيلين من هذا

255
00:17:01,790 --> 00:17:03,350
جيلان؟

256
00:17:03,350 --> 00:17:06,400
أصبحوا يشبهون البشر كثيراً في ذلك الوقت

257
00:17:06,400 --> 00:17:09,940
أجل، أمست رائجة عندما ظهرت أوّل مرّة

258
00:17:09,940 --> 00:17:12,590
لكن بعدها سُحِبت جميعها

259
00:17:12,590 --> 00:17:15,140
!سُحِبت؟! ماذا سيكون سعرها في هذه الحالة؟

260
00:17:17,980 --> 00:17:20,520
!ابتعد عن الطّريق! دعني أرى

261
00:17:23,380 --> 00:17:26,050
سنتمكّن من اقتسام هذا المبلغ
!بيننا نحن الاثنين؟

262
00:17:26,050 --> 00:17:29,400
!ر-ربحت! ربحتُ في لعبة الحياة للتو

263
00:17:29,830 --> 00:17:32,170
لا بدّ من وجود مشكلة ما بما أنّها
قد سُحِبت، أليس كذلك؟

264
00:17:32,170 --> 00:17:33,600
هل أنت متأكّد من أنّ هذا السّعر مناسب؟

265
00:17:33,600 --> 00:17:36,900
يعشق هُواة الجمع أشياء كهذه

266
00:17:36,900 --> 00:17:40,760
معنى هذا أنّني سُعِّرتُ بسعر يُرضيك

267
00:17:40,760 --> 00:17:42,940
!كما هو مُتوقَّع من نفسي عالية الأداء

268
00:17:42,940 --> 00:17:45,870
وبعد؟ أتريدانني أن أبحث عن شخص
يشتريها فوراً؟

269
00:17:45,870 --> 00:17:47,090
!بكلِّ تأكيد

270
00:17:47,370 --> 00:17:48,240
المعذرة

271
00:17:48,690 --> 00:17:49,920
ماذا؟

272
00:17:49,920 --> 00:17:54,750
هلّا انتظرتُما قليلاً قبل بيعي؟

273
00:17:54,750 --> 00:17:56,670
...سيّدتي السّابقة

274
00:17:56,670 --> 00:18:00,680
بالأحرى، نونكو، أمرتني أمراً

275
00:18:01,250 --> 00:18:02,760
قبل أن أنام

276
00:18:03,250 --> 00:18:05,850
!أريد أن تنتظرا حتّى أنفِّذ ذلك الأمر

277
00:18:06,410 --> 00:18:07,890
جدّتي أمرتكِ أمراً؟

278
00:18:07,890 --> 00:18:08,730
ما هو؟

279
00:18:08,730 --> 00:18:09,600
...هذا

280
00:18:16,040 --> 00:18:17,320
البيانات قد فُقِدت...

281
00:18:17,320 --> 00:18:18,580
!ماذا؟

282
00:18:18,580 --> 00:18:21,630
!ماذا؟ ماذا كان ثانية؟

283
00:18:21,630 --> 00:18:24,710
...المعذرة... المعذرة

284
00:18:24,900 --> 00:18:28,270
نسيتِ؟ رغم أنّكِ روبوت؟

285
00:18:28,270 --> 00:18:30,600
من أجل الحرص على جعل نمط
،تفكيري شبه بنمط البشر

286
00:18:30,600 --> 00:18:33,330
!أنسى الأشياء كالبشر أيضاً

287
00:18:33,330 --> 00:18:36,730
المعذرة... ماذا كان يا تُرى؟

288
00:18:36,730 --> 00:18:38,660
هل تتذكّر يا سيّدي؟

289
00:18:38,660 --> 00:18:40,710
كيف لي أن أتذكّر بالضّبط؟

290
00:18:40,710 --> 00:18:43,120
!أنت عديم الجدوى

291
00:18:43,120 --> 00:18:45,180
ماذا أفعل؟

292
00:18:45,610 --> 00:18:47,070
...بئساً

293
00:18:54,360 --> 00:18:57,270
،لا أصدِّق بأنّني فقدتُ شيئاً بهذه الأهمّية

294
00:18:57,270 --> 00:18:59,790
لا سيّما بما أنّني عالية الأداء

295
00:18:59,790 --> 00:19:02,110
حسناً، أعتقد نعرف سبب سحبها الآن

296
00:19:03,360 --> 00:19:05,020
أنا متفاجئ من أنّه حدّد لنا ذلك السّعر

297
00:19:05,410 --> 00:19:07,130
على قطعة خردة

298
00:19:13,740 --> 00:19:18,280
إنَّ  نعت روبوت بالخردة مُخالف لقانون
!مُكافحة العنصريّة ضدّ الرّوبوتات

299
00:19:18,280 --> 00:19:19,910
!اسحب هذا فوراً من فضلك

300
00:19:19,910 --> 00:19:22,580
!أين كنتِ تخفين هذه حتّى؟

301
00:19:23,720 --> 00:19:25,930
المهمّ، هلّا تذكّرتِ بسرعة؟

302
00:19:25,930 --> 00:19:27,400
!يا للعجب

303
00:19:27,790 --> 00:19:30,300
سأضعها عندي اليوم

304
00:19:30,300 --> 00:19:31,080
ماذا؟

305
00:19:31,080 --> 00:19:32,810
لماذا أنت متفاجئ؟

306
00:19:32,810 --> 00:19:35,540
يمكن بيعها ما دمنا نحصل
على إذن سيّدها، صحيح؟

307
00:19:35,540 --> 00:19:38,590
لا أستطيع تركها معك لأنّك
قد تأخذها وتهرب فحسب

308
00:19:38,650 --> 00:19:39,320
سنبيعها؟

309
00:19:39,590 --> 00:19:40,680
تقصد بأنّك لن تفعل؟

310
00:19:43,410 --> 00:19:47,570
ما الفرق الّذي يُشكّله تذكّرها
أوامر سيّدتها من عدمه؟

311
00:19:47,570 --> 00:19:51,580
فضلاً عن أنّه على هذا المنوال، أشكّ في أنّها
ستكون قادرة على تنفيذ الأمر حتّى

312
00:19:52,150 --> 00:19:55,010
تريد ساقاً جديدة، أليس كذلك؟

313
00:19:56,820 --> 00:19:57,890
أتري

314
00:19:57,890 --> 00:19:58,750
!حاضرة

315
00:20:01,790 --> 00:20:03,310
اذهبي مع كاثرين

316
00:20:04,680 --> 00:20:05,530
حاضرة

317
00:20:14,630 --> 00:20:17,440
على أيّ حال، سأتّصل بك عندما أجد مُشترياً

318
00:20:17,800 --> 00:20:18,570
حسناً

319
00:20:22,580 --> 00:20:23,420
هيّا بنا

320
00:20:23,420 --> 00:20:24,470
حاضرة

321
00:20:27,680 --> 00:20:29,460
...مـ-مهلاً

322
00:20:31,620 --> 00:20:32,540
انتظري

323
00:20:36,050 --> 00:20:37,200
!انتظري

324
00:20:43,530 --> 00:20:45,840
!ماذا؟! هل هو عطل؟

325
00:20:45,840 --> 00:20:48,540
عرفتُ بأنّني ما كان ينبغي
!أن أشتري درّاجة رخيصة

326
00:20:53,130 --> 00:20:53,920
المعذرة

327
00:20:53,920 --> 00:20:54,920
!ماذا؟

328
00:20:56,550 --> 00:20:58,010
!تبّاً

329
00:20:58,010 --> 00:21:02,890
!أريني ما لديكِ أيّتها الخردة

330
00:21:05,850 --> 00:21:07,550
!انتظري

331
00:21:08,600 --> 00:21:09,660
!انتظري أرجوكِ

332
00:21:11,110 --> 00:21:12,150
...انتظري

333
00:21:21,060 --> 00:21:22,420
...سيّدي

334
00:21:35,020 --> 00:21:36,140
ناتسو-كن

335
00:21:39,970 --> 00:21:43,900
جرحتَ مِرفقك. سأحضر حقيبة
...الإسعافات الأوّلية

336
00:21:43,900 --> 00:21:47,160
آسف، هلّا تركتِني لوحدي لبعض الوقت؟

337
00:21:49,240 --> 00:21:50,040
...حسناً

338
00:22:04,100 --> 00:22:09,030
وحتّى أنّني أرسلتُك إلى الأكاديميّة
فتجرؤ على العودة مُسرِعاً؟

339
00:22:09,030 --> 00:22:10,250
كم أنت مُثير للشّفقة

340
00:22:17,020 --> 00:22:18,570
ماذا كان من المُفترض أن أفعل؟

341
00:22:22,740 --> 00:22:24,020
...حتّى أنا

342
00:22:28,530 --> 00:22:30,570
!تبّاً! تبّاً

343
00:22:31,420 --> 00:22:34,310
...لا... لا

344
00:22:44,820 --> 00:22:45,840
أتري

345
00:22:47,790 --> 00:22:49,320
ناتسكي

346
00:22:52,870 --> 00:22:56,640
!سأكون ساقك يا سيّدي