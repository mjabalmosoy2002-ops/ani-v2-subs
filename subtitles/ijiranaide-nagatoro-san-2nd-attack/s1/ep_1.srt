204
00:13:42,600 --> 00:13:45,000
!تعتمد أزياء الفتيات كلّها على العزيمة والتّصميم

205
00:13:45,470 --> 00:13:48,330
...في الأيّام العاصِفة، في الأيّام المُثلِجة

206
00:13:48,330 --> 00:13:51,160
!يجب ارتداء التّنانير بقوّة الإرادة

207
00:13:51,160 --> 00:13:53,550
هذا صعب حقّاً

208
00:13:54,510 --> 00:13:58,510
لكن أحياناً نحتاج للدفء أيضاً

209
00:14:08,520 --> 00:14:09,900
...هكذا إذاً

210
00:14:09,900 --> 00:14:11,180
جورب نسائي لاصق؟

211
00:14:11,650 --> 00:14:14,530
تفعلين ما تُريدين فعله

212
00:14:18,030 --> 00:14:19,530
تفعلين ما تُريدين فعله"؟"

213
00:14:24,920 --> 00:14:28,160
ماذا تقصد بـ"تفعلين ما تُريدين فعله"؟

214
00:14:31,840 --> 00:14:35,300
تقصد أنّ أملَك قد خاب، أليس كذلك؟

215
00:14:35,610 --> 00:14:40,300
خابَ أملُك لأنّك لن تتمكّن من رؤية
ساقَي العاريّتين بعد الآن، أليس كذلك؟

216
00:14:40,300 --> 00:14:41,710
!لـ-لا

217
00:14:41,710 --> 00:14:45,310
!سينباي مهووس بساقَي العاريتَين

218
00:14:45,310 --> 00:14:46,420
!يا للهول! مُخيف

219
00:14:46,420 --> 00:14:47,690
!لستُ كذلك

220
00:14:48,960 --> 00:14:52,490
حسناً، ألبِسني هذه إذاً يا سينباي

221
00:14:52,490 --> 00:14:53,070
!ماذا؟

222
00:14:53,600 --> 00:14:55,720
لـ-لماذا أفعل ذلك؟

223
00:14:55,720 --> 00:15:00,450
كي أستطيع مُراقبتك عن كثب وأرى
ما إن كنتَ مهووساً بساقي العاريتَين

224
00:15:04,380 --> 00:15:06,290
هيّا يا سينباي

225
00:15:06,290 --> 00:15:09,350
ألبِسني إيّاها بسرعة

226
00:15:17,540 --> 00:15:20,600
تستغرق وقتاً طويلاً يا سينباي

227
00:15:20,600 --> 00:15:23,130
ألا يمكنك أن تكون أسرع قليلاً؟

228
00:15:23,130 --> 00:15:26,720
صحيح، لا تستطيع. فأنت أعزب

229
00:15:28,010 --> 00:15:29,560
...اللّعنة

230
00:15:29,560 --> 00:15:33,440
تخيّل بأنّك تعبّئ فِجل دايكون
في كيس وأنجز الأمر بسرعة

231
00:15:38,610 --> 00:15:40,070
ناعمة جدّاً

232
00:15:40,640 --> 00:15:42,950
مُختلِفة تماماً عن فِجل

233
00:15:43,250 --> 00:15:47,830
ناعمة وملساء، مع ذلك متينة وليّنة

234
00:15:48,500 --> 00:15:49,470
...ساق فتاة

235
00:15:50,260 --> 00:15:52,280
!ساق ناغاتورو

236
00:16:00,730 --> 00:16:02,310
!لمَ أنت مُتوتّر هكذا؟

237
00:16:02,310 --> 00:16:04,260
!أسرِع وألبسني إيّاه من فضلِك

238
00:16:06,600 --> 00:16:07,520
...صفِّ ذهنك

239
00:16:10,520 --> 00:16:12,210
!ناعمة للغاية

240
00:16:12,210 --> 00:16:13,190
!لا

241
00:16:13,190 --> 00:16:14,400
...صفِّ ذهنك

242
00:16:15,120 --> 00:16:16,650
!ناعمة للغاية

243
00:16:16,920 --> 00:16:18,280
...صفِّ ذهنك

244
00:16:23,910 --> 00:16:25,660
!هذا يكفي

245
00:16:25,660 --> 00:16:28,570
!سأكمِل ارتداءها بنفسي

246
00:16:28,570 --> 00:16:29,530
!حسناً

247
00:16:29,530 --> 00:16:30,920
!حسناً، فهمت

248
00:16:30,920 --> 00:16:34,540
!حركة يدك انحرافيّة جدّاً

249
00:16:34,540 --> 00:16:35,700
...لم أكن أحاول

250
00:16:35,700 --> 00:16:38,050
!مؤلم

251
00:16:40,330 --> 00:16:41,660
ما رأيك؟

252
00:16:43,480 --> 00:16:46,680
فـ-في الواقع، تبدو جميلة على ما أعتقد

253
00:16:48,180 --> 00:16:51,140
سينباي، هل لديك ولَع بالجوارب اللّاصقة؟

254
00:16:51,700 --> 00:16:53,170
!لـ-لا

255
00:16:56,820 --> 00:16:59,140
تقول غامو-تشان بأنّهن جاهزات للذّهاب

256
00:17:04,160 --> 00:17:06,890
لا أحمل كثيراً من المال

257
00:17:06,890 --> 00:17:08,320
لا تقلق

258
00:17:08,320 --> 00:17:10,600
لدينا ما يكفي من مال

259
00:17:10,600 --> 00:17:12,720
يمكنك أن تأكل ما تشاء

260
00:17:12,720 --> 00:17:14,540
حـ-حقّاً؟

261
00:17:14,790 --> 00:17:17,550
ستكون اللّقمة الأولى تونا، صحيح؟

262
00:17:17,550 --> 00:17:18,670
!تونا

263
00:17:19,850 --> 00:17:21,600
السّلمون المُدخّن لذيذ

264
00:17:21,600 --> 00:17:22,800
!سلمون

265
00:17:22,800 --> 00:17:24,720
هذا شهيّ

266
00:17:24,720 --> 00:17:26,640
لم أتناول سوشي منذ زمن بعيد

267
00:17:26,640 --> 00:17:28,060
!سوشي

268
00:17:28,060 --> 00:17:31,060
أشعر نفسي منبوذاً هنا

269
00:17:32,020 --> 00:17:34,560
أظنّني سأركّز على الأكل

270
00:17:34,560 --> 00:17:37,080
سينباي، أعطِني نيغي تورو

271
00:17:37,080 --> 00:17:38,390
حـ-حسناً

272
00:17:39,820 --> 00:17:41,450
قنفذ بحر لي

273
00:17:41,450 --> 00:17:43,290
بطاطا مقليّة لي

274
00:17:45,820 --> 00:17:46,990
بونيتو

275
00:17:47,990 --> 00:17:49,120
كاراغي

276
00:17:50,080 --> 00:17:51,500
أنقليس

277
00:17:53,130 --> 00:17:54,080
!تبّاً

278
00:17:54,080 --> 00:17:55,560
!هذا المقعد فخّ

279
00:17:55,560 --> 00:17:56,960
!تونا

280
00:17:56,410 --> 00:17:59,710
!هذا مقعد العبد

281
00:17:56,960 --> 00:17:58,510
أودون

282
00:18:00,550 --> 00:18:02,600
!اِعمَل

283
00:18:03,480 --> 00:18:07,470
!دعينَني وذلك كي يُشغّلنني بكثافة

284
00:18:10,480 --> 00:18:13,020
سينباي، ماذا ستأكل تالياً؟

285
00:18:13,520 --> 00:18:15,280
أمبرجاك، ربّما؟

286
00:18:22,830 --> 00:18:25,140
حسناً، أمبرجاك. كم ثمنه؟

287
00:18:25,140 --> 00:18:26,960
شكراً

288
00:18:29,080 --> 00:18:31,370
سوف أعزمك على حسابي اليوم

289
00:18:32,680 --> 00:18:33,870
...أعني

290
00:18:35,230 --> 00:18:39,860
كنتَ أكثر من عَمِلَ في مهرجان المدرسة يا سينباي

291
00:18:41,140 --> 00:18:44,130
لذا أنت نجم العرض اللّيلة

292
00:18:44,130 --> 00:18:45,350
!نجم هنا

293
00:18:45,350 --> 00:18:47,930
عاملنه باحترام، فقط لهذا اليوم

294
00:18:48,440 --> 00:18:49,200
حسناً

295
00:18:49,200 --> 00:18:50,140
عُلِم

296
00:18:50,640 --> 00:18:52,630
"عطايا لـ"بايزن

297
00:18:52,630 --> 00:18:55,150
كُل إذا شئت

298
00:18:55,150 --> 00:18:56,230
كاراغي

299
00:18:56,230 --> 00:18:58,340
تناول بعض السّلطة أيضاً

300
00:18:58,340 --> 00:19:00,150
شـ-شكراً

301
00:19:00,850 --> 00:19:04,340
سينباي يميل إلى السّمك، ألا تُلاحظن؟

302
00:19:04,340 --> 00:19:05,630
أو آكل أعشاب

303
00:19:05,630 --> 00:19:06,650
خروف؟

304
00:19:06,650 --> 00:19:09,750
ينبغي أن تأكل كثيراً من الطعام الدّسم

305
00:19:09,750 --> 00:19:11,740
يا لك من هزيل

306
00:19:12,360 --> 00:19:15,180
أظنّني أخذتُ الفكرة الخاطئة عنهن

307
00:19:15,680 --> 00:19:18,010
يبدو أنّني أستطيع الاسترخاء لهذا اليوم

308
00:19:18,010 --> 00:19:19,170
!حسناً

309
00:19:19,170 --> 00:19:21,920
"خدمة خاصّة لـ "بايزن

310
00:19:21,920 --> 00:19:25,170
...ضع بعض بيوض السّلمون فوق السّلمون

311
00:19:25,520 --> 00:19:26,580
ما رأيك؟

312
00:19:26,580 --> 00:19:29,680
!كافيار السّلمون الأحمر أوياكو سوشي

313
00:19:31,130 --> 00:19:33,260
جرّبه يا بايزن

314
00:19:37,330 --> 00:19:39,000
لا بأس به

315
00:19:39,000 --> 00:19:41,560
إنّها من نفس النّوع، لذا هذا منطقيّ

316
00:19:41,890 --> 00:19:43,010
ليس كذلك؟

317
00:19:46,600 --> 00:19:48,570
!سأفعل المثل أيضاً

318
00:19:49,380 --> 00:19:52,540
وضعتُ ذُرة المايونيز فوق
شريحة سوشي هامبرغر

319
00:19:52,540 --> 00:19:54,450
جرّبها

320
00:19:57,880 --> 00:20:01,400
إنّها تافهة، لكنّها لذيذة

321
00:20:02,310 --> 00:20:04,250
!أنا أيضاً! أنا أيضً

322
00:20:04,710 --> 00:20:07,480
وضعتُ قنفذَ بحر فوق سوشي قريدس

323
00:20:07,480 --> 00:20:09,510
!أطلِق عليها بنيغيري المُبهرة

324
00:20:13,180 --> 00:20:14,370
!لذيذة

325
00:20:19,690 --> 00:20:21,310
!سينباي

326
00:20:21,310 --> 00:20:24,750
سأعدّ لك طبقاً خاصّاً أيضاً

327
00:20:26,280 --> 00:20:28,620
نأخذ نصفَ بيضة سمك القُدّ

328
00:20:28,620 --> 00:20:31,070
ونضع بيضة سمك ناعمة فوقها

329
00:20:32,570 --> 00:20:36,330
يُشكّل بيض سمك القُدّ وبيض
السّمك النّاعم لِقاءً إعجازيّاً في معدتك

330
00:20:36,330 --> 00:20:38,600
!السّوشي الحامل

331
00:20:38,600 --> 00:20:41,850
!قد تحبل يا سينباي

332
00:20:48,920 --> 00:20:49,980
بغيضة

333
00:20:50,590 --> 00:20:51,920
...أجل

334
00:20:51,920 --> 00:20:54,720
من يمزح مُزاحاً سيّئاً بالطعام؟

335
00:20:54,720 --> 00:20:57,090
إنّه انتهاك للسوشي

336
00:20:57,090 --> 00:20:58,160
هذه مُبالَغة

337
00:20:58,160 --> 00:20:59,490
!تدنيس مُقدّسات

338
00:20:59,490 --> 00:21:02,600
تفعل هاياتشي ذلك أحياناً

339
00:21:04,020 --> 00:21:06,150
...بيض سمك قُدّ وبيض سمك ناعم

340
00:21:06,150 --> 00:21:07,860
حامل؟

341
00:21:15,110 --> 00:21:16,430
!فعلَها بايزن

342
00:21:18,590 --> 00:21:20,620
لحظة، هذا سيّئ

343
00:21:21,130 --> 00:21:24,140
يتماشى بيض سمك القُدّ مع
البيض النّاعم جيّداً

344
00:21:24,630 --> 00:21:26,100
إنّها لذيذة

345
00:21:28,720 --> 00:21:30,220
رأيت؟

346
00:21:30,630 --> 00:21:32,440
هذا هو سينباي الّذي أعرفه

347
00:21:32,440 --> 00:21:35,640
إنّه مُخيف مُريب، لكن ذوقه رفيع

348
00:21:35,640 --> 00:21:38,920
!حصلتُ على موافقة نجم اليوم

349
00:21:38,920 --> 00:21:40,360
!مرحى

350
00:21:40,360 --> 00:21:42,190
تبّاً، أنتِ مُزعجة

351
00:21:42,190 --> 00:21:43,800
سأعدُّ بعضاً أيضاً

352
00:21:43,800 --> 00:21:46,900
يوشي، بيض سمك قُدّ وبيض ناعم من فضلكِ

353
00:21:46,900 --> 00:21:48,900
!لا تُقلّديني

354
00:21:48,900 --> 00:21:54,010
حسناً، سأستخدم بيض السّمك النّاعم مع بيض
القُدّ لإعداد سوشي مُخيف مُريب