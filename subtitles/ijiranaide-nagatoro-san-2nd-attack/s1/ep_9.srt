1
00:00:27,180 --> 00:00:29,560
آمل أن نتمكّن من الفوز ولو لمرّة

2
00:00:30,320 --> 00:00:34,520
لا سيّما بما أنّني مَدين لناغاتورو على
مساعدتي في التّمرين

3
00:00:46,620 --> 00:00:50,060
هذا في الماضي على أيّ حال

4
00:02:41,120 --> 00:02:42,060
!نقطة كاملة

5
00:02:44,640 --> 00:02:46,330
...مُدهش

6
00:02:46,330 --> 00:02:48,090
كانت رمية سلِسة حقّاً

7
00:02:49,640 --> 00:02:52,650
مخطّط بطولة الجودو للإناث

8
00:02:53,020 --> 00:02:53,960
!ابدآ

9
00:02:54,400 --> 00:02:56,210
!حسناً

10
00:02:58,210 --> 00:02:59,780
...مـ-مهلاً

11
00:02:59,780 --> 00:03:01,220
...المعذرة

12
00:03:03,220 --> 00:03:04,280
!توقّفي

13
00:03:04,780 --> 00:03:05,780
!تحذير

14
00:03:16,200 --> 00:03:21,300
...كنتُ لأقضي عليكِ لو كنتِ رجلاً

15
00:03:27,730 --> 00:03:29,810
مُبارز الفوز في الجولة الأولى

16
00:03:29,810 --> 00:03:31,060
شكراً

17
00:03:31,450 --> 00:03:33,310
أبليتِ بلاء ممتازاً هناك

18
00:03:33,310 --> 00:03:34,810
أنتِ في أحسن حالاتكِ اليوم، صحيح؟

19
00:03:34,810 --> 00:03:36,700
أيّاً يكن

20
00:03:37,730 --> 00:03:40,850
آمل أن نستطيع ربح الجولة الأولى على الأقلّ

21
00:03:40,850 --> 00:03:43,900
شعري في حالة فوضويّة

22
00:03:43,900 --> 00:03:44,980
أنا مُرهَقة

23
00:03:44,980 --> 00:03:47,080
مرحباً

24
00:03:50,080 --> 00:03:52,630
أراك مُتحمّساً بشكل فظيع اليوم يا ناو-كن

25
00:03:52,630 --> 00:03:56,000
كانت عيناك ميتّتين تماماً في العام الماضي

26
00:03:56,000 --> 00:03:58,240
حـ-حقّاً؟

27
00:03:58,240 --> 00:04:00,590
لا أظنّني مختلفاً إلى هذا الحدّ

28
00:04:00,590 --> 00:04:02,680
لا، أنت تتحوّل إلى أحد الفتيان المشاهير

29
00:04:02,680 --> 00:04:04,330
خائن

30
00:04:04,330 --> 00:04:05,970
!لستُ كذلك

31
00:04:05,970 --> 00:04:08,720
كلّ ما في الأمر أنّني اعتدتُ على هذا
بما أنّها المرّة الثّانية لي

32
00:04:08,720 --> 00:04:12,110
أوريهارا من الصفّ ب سينضمّ لنا

33
00:04:12,730 --> 00:04:14,300
مُذهل

34
00:04:14,300 --> 00:04:16,060
ستواجه الفتيات وقتاً عصيباً

35
00:04:16,730 --> 00:04:18,240
بجدّية؟

36
00:04:18,240 --> 00:04:19,540
هل هذا مُنصِف حتّى؟

37
00:04:19,540 --> 00:04:22,580
إنّها مُرشّحة لتمثيل اليابان، أليس كذلك؟

38
00:04:24,740 --> 00:04:28,610
وأيضاً، جولتي الأولى ضدّها

39
00:04:28,610 --> 00:04:30,610
عزائي

40
00:04:30,610 --> 00:04:32,250
!لا تستسلمي

41
00:04:43,270 --> 00:04:44,260
!ابدآ

42
00:04:46,090 --> 00:04:47,260
!ها نحن ذا

43
00:04:49,770 --> 00:04:51,680
لا أظنّني سوف أربح على أيّ حال

44
00:04:51,680 --> 00:04:53,520
ربّما ينبغي أن أغشّ

45
00:04:53,520 --> 00:04:54,940
ماذا؟ حقّاً؟

46
00:04:55,520 --> 00:04:57,400
!أمزح

47
00:05:04,110 --> 00:05:05,900
!لم أنتهِ بعد

48
00:05:08,950 --> 00:05:09,980
!نقطة كاملة

49
00:05:11,160 --> 00:05:13,340
أحسنتِ

50
00:05:13,340 --> 00:05:14,570
قتال جيّد

51
00:05:14,570 --> 00:05:15,660
...بصراحة

52
00:05:16,330 --> 00:05:18,230
إنّها فطِنة حقّاً

53
00:05:18,960 --> 00:05:22,190
أصبحت أقوى من السّابق حتّى

54
00:05:22,990 --> 00:05:26,170
قاتلتِها من قبل يا غامو-تشان؟

55
00:05:26,170 --> 00:05:27,730
لا، لم أفعل

56
00:05:27,730 --> 00:05:30,030
أنا أخمّن فقط بحسب ما رأيتُه

57
00:05:30,680 --> 00:05:33,750
ليس عليكِ إعطائي تقريراً

58
00:05:33,750 --> 00:05:35,830
هذه ليست مُشكلتي

59
00:05:35,830 --> 00:05:37,310
لا تقولي ذلك

60
00:05:38,440 --> 00:05:41,320
ستواجهينها تالياً يا هاياتشي

61
00:05:41,320 --> 00:05:43,860
!الآن فُرصتكِ لردّ الاعتبار

62
00:05:43,860 --> 00:05:44,960
!اربحي

63
00:05:44,960 --> 00:05:46,350
!عليكِ بها

64
00:05:47,820 --> 00:05:50,820
لستُ مهتمّة بمثل هذه الأشياء

65
00:05:50,820 --> 00:05:53,450
مُملّة للغاية

66
00:05:53,450 --> 00:05:55,330
عابرة

67
00:05:55,700 --> 00:05:59,470
لكن ألا تُريدين إثارة إعجاب بايزن؟

68
00:05:59,470 --> 00:06:02,340
!ماذا؟ سينباي لا صِلة له بالأمر

69
00:06:02,760 --> 00:06:07,440
نحيل مثل بايزن يحبّ الفتيات القويّات

70
00:06:07,440 --> 00:06:09,340
!أخبرتُكِ، لا صِلة له بالأمر

71
00:06:11,660 --> 00:06:13,170
!هاياتشي

72
00:06:14,850 --> 00:06:16,260
مرحباً

73
00:06:16,260 --> 00:06:17,730
مـ-مرحباً

74
00:06:18,100 --> 00:06:20,590
لم أقاتلكِ منذ مدّة طويلة

75
00:06:20,590 --> 00:06:22,970
أ-أجل، صحيح

76
00:06:22,970 --> 00:06:25,220
!آمل أن يكون نِزالاً جيّداً

77
00:06:25,220 --> 00:06:27,360
!لن تهزميني

78
00:06:28,240 --> 00:06:29,300
!وداعاً

79
00:06:30,340 --> 00:06:33,010
...تحديق

80
00:06:33,660 --> 00:06:35,320
كم هذا مُزعج

81
00:06:36,140 --> 00:06:38,490
ربّما ينبغي أن أغشّ

82
00:06:39,620 --> 00:06:41,280
إلى أين أنتِ ذاهبة؟

83
00:06:41,280 --> 00:06:42,610
أين؟

84
00:06:42,610 --> 00:06:44,430
!لأخذ استراحة

85
00:06:56,620 --> 00:06:58,100
ماذا؟

86
00:07:00,590 --> 00:07:02,030
سينباي

87
00:07:03,520 --> 00:07:05,750
...فـ-في الحقيقة، أنا

88
00:07:05,750 --> 00:07:08,530
تـ-تبدو قويّة جدّاً

89
00:07:10,270 --> 00:07:13,530
لم تكن كذلك من قبل

90
00:07:13,530 --> 00:07:15,340
من قبل؟

91
00:07:16,420 --> 00:07:19,320
هذا ليس من شأنك يا سينباي

92
00:07:20,040 --> 00:07:22,540
مـ-معكِ حقّ

93
00:07:27,750 --> 00:07:31,910
...ليس وكأنّ الأمر يهمّك

94
00:07:31,910 --> 00:07:33,550
نـ-نعم؟

95
00:07:34,490 --> 00:07:38,710
لكن كنتُ أمارس الجودو منذ صغري

96
00:07:40,940 --> 00:07:47,070
كانت لديّ موهبة فيه، لذا ربحتُ
بضع بطولات وما شابه أيضاً

97
00:07:48,460 --> 00:07:52,070
كنتُ في نفس الدّوجو الّذي كانت فيه

98
00:07:54,270 --> 00:07:58,000
،لم تكن تمتلك موهبة خامّة فيه

99
00:07:58,000 --> 00:08:01,540
وكنتُ دائماً ما أهزمها

100
00:08:03,540 --> 00:08:07,790
لكن كانت دائماً ما تنزعج عندما تخسر

101
00:08:08,950 --> 00:08:13,090
كلّما تقاتلنا، كانت تتحسّن شيئاً فشيئاً

102
00:08:16,680 --> 00:08:20,310
...وبعد نِزالات كثيرة

103
00:08:25,120 --> 00:08:27,170
لم يكن هناك مقارنة حتّى

104
00:08:27,170 --> 00:08:29,640
دمّرَتْني

105
00:08:30,860 --> 00:08:35,590
بصراحة، لم أعد أشعر أنّ بوسعي الفوز بعد الآن

106
00:08:37,940 --> 00:08:42,280
،كنتُ كلّما فكّرتُ في هزيمتي في كلّ مرّة

107
00:08:43,160 --> 00:08:46,770
أفقد الاهتمام أكثر

108
00:08:49,040 --> 00:08:52,250
ثمّ انتهى المطاف بي باعتزال الجودو

109
00:08:54,160 --> 00:08:57,340
في هذه الأثناء، إنّها مُرشّحة لتمثيل اليابان

110
00:08:57,340 --> 00:09:01,600
نحن في عالمَين مختلفَين تماماً الآن

111
00:09:02,220 --> 00:09:06,540
،حسناً، بما أنّني أعلم بأنّني سأخسر
سوف أتجاوز الأمر فحسب

112
00:09:09,120 --> 00:09:11,230
هذا ليس من طباعكِ يا ناغاتورو

113
00:09:14,790 --> 00:09:15,730
ماذا؟

114
00:09:17,040 --> 00:09:21,990
من أعطاك الحقّ في التكلّم كما لو أنّك تعرفني

115
00:09:28,210 --> 00:09:29,150
لا

116
00:09:30,250 --> 00:09:33,510
لا تعلمين إن كنتِ ستفوزين أم لا ما لم تحاولي

117
00:09:35,370 --> 00:09:37,690
هل كنت تستمع لي حتّى؟

118
00:09:37,690 --> 00:09:40,420
بوسعها تمثيل اليابان

119
00:09:40,420 --> 00:09:42,390
لا أملك فُرصة حتّى

120
00:09:42,390 --> 00:09:44,350
!أنتِ قويّة أيضاً

121
00:09:45,230 --> 00:09:47,580
!أنتِ قويّة جدّاً أيضاً

122
00:09:52,330 --> 00:09:54,020
!سـ-سحقاً

123
00:09:54,020 --> 00:09:56,360
بدا ذلك كنوع من المُواساة

124
00:09:56,360 --> 00:09:57,900
...سينباي

125
00:09:57,900 --> 00:10:01,000
كانت مُواساة واضحة

126
00:10:01,450 --> 00:10:04,870
لـ-لا، أقول فقط ما قصدتُه فحسب

127
00:10:05,710 --> 00:10:08,370
سأبذل قصارى جهدي إذاً

128
00:10:11,880 --> 00:10:16,610
هذا إذا فزتَ مرّة واحدة على الأقلّ يا سينباي

129
00:10:16,610 --> 00:10:17,380
ماذا؟

130
00:10:17,380 --> 00:10:19,470
...هـ-هذا مستحيل

131
00:10:19,470 --> 00:10:20,510
ماذا؟

132
00:10:20,510 --> 00:10:24,660
قلتَ لي لن أعلم ما لم أحاول

133
00:10:25,390 --> 00:10:27,100
بالمناسبة

134
00:10:27,100 --> 00:10:30,650
...إذا حقّقتَ فوزاً واحداً

135
00:10:33,130 --> 00:10:35,240
سأمنحك قبلة

136
00:10:35,900 --> 00:10:38,450
!لـ-ليس إلى هذه الدّرجة

137
00:10:39,250 --> 00:10:41,570
لا تتحلّى بالثّقة، صحيح؟

138
00:10:42,020 --> 00:10:43,900
الثّقة؟

139
00:10:43,900 --> 00:10:46,080
في الواقع... لا، لا أتحلّى بها

140
00:10:47,200 --> 00:10:51,920
لكن تمرّنتُ مع ناغاتورو أيضاً

141
00:10:52,950 --> 00:10:54,650
أنا متأكّد أنّ بوسعي تحقيق فوز واحد

142
00:11:25,140 --> 00:11:25,950
!ابدآ

143
00:11:28,230 --> 00:11:29,450
...كم هذا مؤلم

144
00:11:31,710 --> 00:11:34,350
جسده جميل

145
00:11:34,350 --> 00:11:36,210
قُضي على بايزن

146
00:11:36,210 --> 00:11:37,910
النّهاية

147
00:11:40,110 --> 00:11:41,430
!هيّا

148
00:11:41,430 --> 00:11:43,310
لا تمُت يا ناو-كن

149
00:11:43,890 --> 00:11:46,470
قد يتمّ سحقي

150
00:11:46,470 --> 00:11:49,320
!حسناً، حان وقت إنهاء هذا

151
00:11:51,010 --> 00:11:53,020
!كُفّ عن الهرب

152
00:12:03,300 --> 00:12:05,450
لقد سقط

153
00:12:07,340 --> 00:12:08,830
...ناو-كن

154
00:12:09,430 --> 00:12:10,350
!نصف نقطة

155
00:12:11,380 --> 00:12:12,830
!ألم تكن نقطة كاملة؟

156
00:12:12,830 --> 00:12:14,420
كانت رمية سيّئة

157
00:12:14,420 --> 00:12:15,160
إنّه سيّئ

158
00:12:15,160 --> 00:12:17,830
رماه بالقوّة الخالصة فحسب إذاً؟

159
00:12:17,830 --> 00:12:20,620
وأيضاً لمَ لا تشجّعين بايزن؟

160
00:12:20,620 --> 00:12:23,090
ماذا؟ لمَ يجدر بي ذلك؟

161
00:12:25,230 --> 00:12:26,170
!ابدآ

162
00:12:33,360 --> 00:12:36,970
!يرميه بالقوّة الخالصة من جديد

163
00:12:36,970 --> 00:12:38,740
لا أتحمّل المشاهدة

164
00:12:38,740 --> 00:12:40,140
!لا تستسلم أبداً

165
00:12:41,930 --> 00:12:44,680
!ساساي، ثبّته فحسب

166
00:12:44,680 --> 00:12:46,110
!حسناً

167
00:12:47,370 --> 00:12:49,390
!بايزن، اهرب

168
00:12:49,390 --> 00:12:50,740
!اهرب

169
00:12:50,740 --> 00:12:53,750
...لستُ مهتمّاً بمُعانقة شابّ، لكن

170
00:12:55,770 --> 00:12:57,750
...إنّه قويّ جدّاً

171
00:12:57,750 --> 00:12:59,900
تثبيت

172
00:13:00,670 --> 00:13:02,650
!رجلان يتعانقان

173
00:13:02,650 --> 00:13:04,310
قُضي عليه بالتأكيد هذه المرّة

174
00:13:04,310 --> 00:13:06,380
النّهاية الأخيرة

175
00:13:10,030 --> 00:13:14,940
من أعطاك الحقّ في التكلّم كما لو أنّك تعرفني

176
00:13:16,750 --> 00:13:18,300
معها حقّ

177
00:13:18,300 --> 00:13:20,720
لديّ الحقّ

178
00:13:20,720 --> 00:13:26,800
منحتُ نفسي الحقّ في أن أقرّر

179
00:13:29,070 --> 00:13:32,700
!لا أريد أن تبدو ناغاتورو بهذا الشّكل

180
00:13:38,410 --> 00:13:41,960
هناك بضعة طرق للتخلّص من مسكة الوشاح

181
00:13:43,830 --> 00:13:48,070
أوّلاً، ادفع الخصم للأمام

182
00:13:48,920 --> 00:13:51,460
أو تحرّر منها في الجهة المعاكسة

183
00:13:52,350 --> 00:13:58,030
كما ترى، يمكن دوماً الإفلات
من تثبيت سيّئ كتثبيتك

184
00:14:01,110 --> 00:14:05,610
إنّه يثبّتني بالقوّة الخالصة فحسب

185
00:14:06,180 --> 00:14:08,610
...مقارنة بناغاتورو

186
00:14:10,610 --> 00:14:13,120
!إنّه خفيف كما الرّيشة

187
00:14:13,120 --> 00:14:14,780
!لقد تحرّر

188
00:14:16,120 --> 00:14:17,520
!مُذهل

189
00:14:17,520 --> 00:14:18,970
!أحسنت

190
00:14:18,970 --> 00:14:20,130
!انتقام

191
00:14:25,630 --> 00:14:27,280
معقول؟

192
00:14:27,280 --> 00:14:28,760
!ثبّته! حالاً

193
00:14:29,860 --> 00:14:31,770
!افعلها يا بايزن

194
00:14:31,770 --> 00:14:33,640
!عليك به

195
00:14:37,300 --> 00:14:39,640
!ابتعد عنّي

196
00:14:41,200 --> 00:14:43,200
إنّه قويّ فعلاً

197
00:14:43,750 --> 00:14:45,650
أقوى منّي بكثير

198
00:14:46,280 --> 00:14:49,020
وعليّ الحفاظ على هذا للأبد

199
00:14:50,660 --> 00:14:53,470
لا أستطيع المتابعة أكثر

200
00:14:55,160 --> 00:14:58,660
!سينباي! تماسك

201
00:14:59,170 --> 00:15:00,420
!ناغاتورو

202
00:15:05,670 --> 00:15:06,800
!حرّر ساقك

203
00:15:15,370 --> 00:15:16,440
!توقّفا

204
00:15:23,310 --> 00:15:25,740
انتهى الوقت

205
00:15:25,740 --> 00:15:27,030
خَسِر هو؟

206
00:15:27,030 --> 00:15:30,200
كان ينجح في التثبيت

207
00:15:30,200 --> 00:15:34,910
لحظة، ظننتُ أنّكِ لم تكوني تشجّعينه

208
00:15:38,410 --> 00:15:40,600
الرّابح بقرار الحكم: ساساي

209
00:15:42,030 --> 00:15:43,660
أفسدتُ الأمر

210
00:15:44,640 --> 00:15:45,380
أنت

211
00:15:47,030 --> 00:15:48,700
إنّك ماهر جدّاً

212
00:15:48,700 --> 00:15:51,340
شكراً

213
00:15:51,710 --> 00:15:52,830
خسرتُ

214
00:15:52,830 --> 00:15:54,340
أحسنت

215
00:15:54,340 --> 00:15:56,370
!أبليتَ حسناً

216
00:15:56,370 --> 00:15:58,500
