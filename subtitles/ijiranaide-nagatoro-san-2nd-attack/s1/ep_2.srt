213
00:15:08,490 --> 00:15:09,280
هل تعرفه؟

214
00:15:09,280 --> 00:15:10,010
لا

215
00:15:10,010 --> 00:15:11,940
شخص يعرف شخصاً أعرفه

216
00:15:11,940 --> 00:15:14,050
!اغرب عن وجهي فحسب

217
00:15:14,640 --> 00:15:15,560
ما هذا؟

218
00:15:17,360 --> 00:15:18,810
هل ترسم؟

219
00:15:18,810 --> 00:15:20,040
حقّاً؟

220
00:15:20,040 --> 00:15:21,920
أيرسم في حديقة الحيوانات؟

221
00:15:21,920 --> 00:15:23,520
عمل للنادي ربّما؟

222
00:15:25,160 --> 00:15:31,000
يستلزم هذا تصفية العقل والصّبر
حتّى تهبّ العاصفة

223
00:15:32,080 --> 00:15:34,490
لحظة، هذه رسمة مُتقَنة، أليس كذلك؟

224
00:15:34,490 --> 00:15:35,680
ماذا؟

225
00:15:35,680 --> 00:15:38,970
رغم أنّ هذه سيّئة جدّاً

226
00:15:41,460 --> 00:15:42,600
حقّاً؟

227
00:15:42,600 --> 00:15:43,670
حقّاً

228
00:15:44,630 --> 00:15:46,650
يا للهول، هذه مضحكة للغاية

229
00:15:46,650 --> 00:15:47,530
صحيح؟

230
00:15:47,530 --> 00:15:49,420
كانت تلك سيّئة للغاية

231
00:15:51,620 --> 00:15:54,430
لا بدّ أنّها وظيفة طفل في مدرسة إعداديّة

232
00:16:00,680 --> 00:16:07,200
لـ-لا تضحكا على رسم عَملَ
!عليه شخص بجدّ

233
00:16:18,610 --> 00:16:21,610
أنت، ماذا قلتَ للتو؟

234
00:16:21,610 --> 00:16:22,900
أخبرني

235
00:16:23,330 --> 00:16:25,930
أخبرني ماذا قلتَ للتو

236
00:16:27,340 --> 00:16:29,460
عُدتُ يا سينباي

237
00:16:41,490 --> 00:16:43,230
مرحباً؟

238
00:16:43,230 --> 00:16:46,290
أنتِ هنا

239
00:16:46,290 --> 00:16:47,860
مرحباً

240
00:16:48,250 --> 00:16:52,520
أنا رسمتُ هذه

241
00:16:52,520 --> 00:16:53,490
حقّاً؟

242
00:16:54,260 --> 00:16:55,690
أنتِ؟

243
00:16:56,580 --> 00:16:59,740
ليست بذلك السّوء، صحيح؟

244
00:16:59,740 --> 00:17:01,040
صحيح؟

245
00:17:01,040 --> 00:17:03,750
يبدو كرسم تمائم جالبة للحظّ، صحيح؟

246
00:17:03,750 --> 00:17:08,180
لا، كان من المُفترَض أن يكون
هذا رسماً جدّياً

247
00:17:08,180 --> 00:17:09,470
حقّاً؟

248
00:17:09,470 --> 00:17:11,000
هذا مُضحك للغاية

249
00:17:11,000 --> 00:17:13,840
...على أيّ حال، بغضّ النّظر عن ذلك

250
00:17:13,840 --> 00:17:15,770
بغضّ النّظر عن ذلك...؟

251
00:17:19,350 --> 00:17:22,890
هل أردتُما شيئاً من سينباي؟

252
00:17:26,520 --> 00:17:27,920
!لا، لا

253
00:17:27,920 --> 00:17:30,420
أردنا فقط مدح رسمه، صحيح؟

254
00:17:30,420 --> 00:17:32,280
أجل، بالضبط

255
00:17:32,280 --> 00:17:38,520
ورسمكِ جيّد أيضاً يا هياتشي، لكن
رسم سينباي من مستوى آخر، صحيح؟

256
00:17:38,520 --> 00:17:39,940
أجل، أجل

257
00:17:39,940 --> 00:17:41,200
إنّه محترف، صحيح؟

258
00:17:41,200 --> 00:17:44,650
!كنّا نتأمّل رسومه الرّهيبة فحسب

259
00:17:45,950 --> 00:17:47,840
كلاكما صحيح

260
00:17:49,370 --> 00:17:50,520
لا، صدّقيني

261
00:17:50,520 --> 00:17:51,790
إنّها رائعة

262
00:17:51,790 --> 00:17:53,280
بجدّية

263
00:17:53,280 --> 00:17:56,050
على أيّ حال، حريّ بنا الذّهاب

264
00:17:56,500 --> 00:17:57,320
إلى اللّقاء

265
00:17:57,320 --> 00:17:58,780
!وداعاً

266
00:18:01,760 --> 00:18:03,810
شـ-شكراً

267
00:18:03,810 --> 00:18:05,600
لا داعي للقلق

268
00:18:05,600 --> 00:18:07,940
أنت جبان ضعيف يا سينباي

269
00:18:08,400 --> 00:18:13,190
!جبان ضعيف

270
00:18:14,020 --> 00:18:14,880
...لكن

271
00:18:16,210 --> 00:18:18,700
عليّ أن أبلي بلاء أفضل

272
00:18:27,130 --> 00:18:31,760
لـ-لا تضحكا على رسم عَملَ
!عليه شخص بجدّ

273
00:18:43,140 --> 00:18:48,360
لا، أعتقد كنتَ لائقاً يا سينباي

274
00:18:48,360 --> 00:18:49,950
كنتَ لائقاً

275
00:18:52,480 --> 00:18:53,540
حسناً

276
00:18:53,540 --> 00:18:54,640
هكذا إذاً

277
00:18:54,640 --> 00:18:56,750
أجل، أجل

278
00:19:02,530 --> 00:19:04,960
حسناً، بدأ الوقت يتأخّر

279
00:19:04,960 --> 00:19:07,230
ما رأيكِ أن نرسم واحدة أخيرة ونكتفي؟

280
00:19:07,230 --> 00:19:08,750
حسناً

281
00:19:09,110 --> 00:19:10,620
ماذا ينبغي أن نرسم؟

282
00:19:11,840 --> 00:19:13,750
...لنرَ

283
00:19:14,000 --> 00:19:17,510
حيوانكِ المُفضّل إذاً

284
00:19:18,030 --> 00:19:20,080
...حيوان

285
00:19:24,440 --> 00:19:25,870
ما رأيكِ؟

286
00:19:25,870 --> 00:19:27,520
ذاك

287
00:19:31,520 --> 00:19:33,400
تحبّين حيوان الكسلان؟

288
00:19:33,400 --> 00:19:36,870
لا، أيّ شيء ينفع في الواقع

289
00:19:36,870 --> 00:19:38,280
...أجل

290
00:19:38,960 --> 00:19:40,260
!هيّا يا سينباي

291
00:19:40,260 --> 00:19:43,220
!لا تقِف مكانك فحسب! ابدأ بالرّسم

292
00:19:43,220 --> 00:19:45,530
!حسناً، حسناً

293
00:19:52,510 --> 00:19:55,040
لماذا ترسم من بعيد؟

294
00:20:15,680 --> 00:20:17,820
!ماذا تفعل بالنّظر بعيداً؟

295
00:20:17,820 --> 00:20:20,290
!ركّز نظرك عليه وارسم

296
00:20:20,290 --> 00:20:21,820
حـ-حاضر

297
00:20:27,330 --> 00:20:28,120
حسناً

298
00:20:28,120 --> 00:20:30,700
تبدو مُمتازة

299
00:20:31,150 --> 00:20:35,210
انتهيت

300
00:20:32,730 --> 00:20:33,680
ماذا عنكِ؟

301
00:20:35,590 --> 00:20:38,940
بالمناسبة، هل يمكنك تخمين ما رسمت؟

302
00:20:38,940 --> 00:20:41,210
الكسلان، صحيح؟

303
00:20:41,770 --> 00:20:44,080
هذا صحيح، كسلان

304
00:20:44,080 --> 00:20:47,220
لكن نوع معيّن من الكسلان يعيش في اليابان

305
00:20:48,100 --> 00:20:51,220
!كسلان خُماسي الأصابع

306
00:20:51,540 --> 00:20:55,110
إنّه كسول وضعيف جدّاً لدرجة أنّه سينقرض

307
00:20:55,110 --> 00:20:59,270
ولديه حضور باهت لدرجة أنّه
من النّادر جدّاً مُلاحظته

308
00:21:00,280 --> 00:21:03,530
!ها هي ذي من جديد، ترسمني فقط لتعبث معي

309
00:21:07,680 --> 00:21:11,490
إنّها ليست جيّدة، لكن رُسِمت بحرص حقّاً

310
00:21:11,990 --> 00:21:13,500
...و

311
00:21:14,080 --> 00:21:15,350
...هذا

312
00:21:15,890 --> 00:21:20,090
هل تتذكّر ما قلتُه حول الجانب
الأبرز لصنع الفنّ؟

313
00:21:20,520 --> 00:21:21,880
الحُبّ

314
00:21:26,400 --> 00:21:27,370
!لا، لا، لا

315
00:21:27,370 --> 00:21:28,890
ما الّذي أفكّر فيه؟

316
00:21:32,130 --> 00:21:34,890
لماذا تتأمّلها طويلاً؟

317
00:21:34,890 --> 00:21:36,370
!أيّها المُخيف

318
00:21:36,370 --> 00:21:38,710
هل تنتهك رسمتي بعينيك؟

319
00:21:38,710 --> 00:21:39,400
!لـ-لا

320
00:21:39,400 --> 00:21:42,700
أراك بوضوح كيف تنتهك رسمتي

321
00:21:42,700 --> 00:21:44,400
يا لك من مُنحرف

322
00:21:44,400 --> 00:21:45,900
!لا

323
00:21:45,900 --> 00:21:50,750
!بئساً يا سينباي، أنت مُخيف

324
00:23:25,510 --> 00:23:27,150
نقاط التحسُّن لليوم

325
00:23:27,150 --> 00:23:29,350
أظنّكِ الوحيدة الّتي تحسّنتِ اليوم

326
00:23:29,350 --> 00:23:31,780
!ماذا؟! ماذا فعلت؟

327
00:23:31,780 --> 00:23:33,720
أظنّكِ أسأتِ الفهم

328
00:23:34,080 --> 00:23:36,180
أسأتُ الفهم بين ماذا وماذا؟

329
00:23:36,180 --> 00:23:38,310
أخبرني، أخبرني يا سينباي

330
00:23:38,310 --> 00:23:39,930
!أ-أنا آسف