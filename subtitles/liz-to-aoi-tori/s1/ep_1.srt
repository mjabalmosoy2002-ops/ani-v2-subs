.نوزومي أعطتني إياها

441
00:43:38,490 --> 00:43:41,270
.تربطكما علاقة جيدة

442
00:43:41,270 --> 00:43:43,270
.كم أحسدكما

443
00:43:45,770 --> 00:43:47,230
.ميزو-سينباي

444
00:43:47,230 --> 00:43:52,360
.سنقيم حفل ريشة مزدوجة آخر قبل تجارب الأداء

445
00:43:52,360 --> 00:43:57,450
ميزو-سينباي، إذا لم يكن لديك مانع، هل ترافقيننا؟

446
00:44:00,740 --> 00:44:03,080
.ذهابي لن يجعل الحفل ممتعًا

447
00:44:03,330 --> 00:44:06,620
!هذا ليس صحيحًا

448
00:44:09,380 --> 00:44:10,670
.في وقت آخر

449
00:44:12,630 --> 00:44:14,550
...حسنًا

450
00:44:17,590 --> 00:44:18,300
...عذرًا

451
00:44:19,760 --> 00:44:22,350
.كان موعد إعادته قبل شهر

452
00:44:22,760 --> 00:44:26,140
.أنا واثقة من أن هناك من يرغب في استعارته

453
00:44:26,440 --> 00:44:29,060
.الكتب في المكتبة من حق جميع الطلاب

454
00:44:29,060 --> 00:44:31,190
!حسنًا، حسنًا، فهمنا

455
00:44:31,570 --> 00:44:33,980
.سنتذكر هذا

456
00:44:35,360 --> 00:44:36,190
.لنذهب

457
00:44:38,110 --> 00:44:40,990
.ما كان يجدر بها أن تتذمر

458
00:44:40,990 --> 00:44:41,780
.أجل

459
00:44:42,030 --> 00:44:44,870
نسيان إعادة الكتب أمر وارد الحدوث، أليس كذلك؟

460
00:44:44,870 --> 00:44:45,580
.بلى

461
00:44:49,120 --> 00:44:51,920
.إذا كنتِ تريدين قراءة قصة ليز، بإمكاني إعارتك الكتاب الذي استعرته

462
00:44:54,460 --> 00:44:56,590
.هذا غير نظامي

463
00:44:57,840 --> 00:45:00,180
.ستكون هذه إعارة جانبية

464
00:45:00,680 --> 00:45:02,550
ما القصة، ميزوري؟

465
00:45:02,550 --> 00:45:05,970
-لا ينبغي أن تعيري كتب المكتبة إلى شخص آخر

466
00:45:05,970 --> 00:45:08,690
!حسنًا، حسنًا، فهمت

467
00:45:29,160 --> 00:45:30,170
.ميزو-سينباي

468
00:45:32,710 --> 00:45:36,340
هل تصنعين ريشاتك بنفسك؟

469
00:45:37,380 --> 00:45:39,340
نصفها تقريبًا؟

470
00:45:39,340 --> 00:45:41,680
إذن تقشطينها وحسب؟

471
00:45:42,010 --> 00:45:43,680
.وأخيطها أيضًا

472
00:45:46,140 --> 00:45:48,140
هل تعتقدين أنني أستطيع فعل هذا أنا أيضًا؟

473
00:45:49,060 --> 00:45:50,640
.بإمكاني تعليمك لاحقًا

474
00:45:52,350 --> 00:45:54,650
هل أنتِ جادة؟

475
00:45:54,650 --> 00:45:55,320
.نعم

476
00:45:56,930 --> 00:45:58,820
.يا لسعادتي

477
00:45:59,070 --> 00:46:01,320
.شكرًا جزيلاً

478
00:46:10,620 --> 00:46:11,790
ماذا هناك؟

479
00:46:17,000 --> 00:46:21,340
!فشلتُ في تجربة الأداء

480
00:46:23,590 --> 00:46:30,600
!أردت أن أعزف على المسرح معك

481
00:46:38,940 --> 00:46:40,860
.هابي آيسكريم

482
00:46:40,860 --> 00:46:41,900
ما معنى هذا؟

483
00:46:41,900 --> 00:46:43,990
ماذا؟ ألا تعلمين؟

484
00:46:43,990 --> 00:46:48,700
قلنا نفس الكلام لتونا، أليس كذلك؟

485
00:46:48,700 --> 00:46:50,500
.نعم، فعلنا

486
00:46:50,500 --> 00:46:52,210
.أنا جائعة

487
00:46:52,210 --> 00:46:55,000
.أريد تناول طعام حلو

488
00:46:55,290 --> 00:46:59,500
".عندما يحدث هذا، تقولين مباشرة "هابي آيسكريم

489
00:46:59,500 --> 00:47:00,670
.حسنًا

490
00:47:00,670 --> 00:47:05,470
.التي تقولها أولاً ستجبر الأخرى على شراء الآيسكريم لها

491
00:47:05,470 --> 00:47:09,810
مهلاً، هل هذا يعني أنه يجب أن أشتري لك الآيسكريم الآن؟

492
00:47:09,810 --> 00:47:10,970
.نعم

493
00:47:10,970 --> 00:47:12,930
.شكرًا لك، هادزوكي-تشان

494
00:47:14,190 --> 00:47:16,940
!ما هذا؟ لم أسمع بهذا من قبل

495
00:47:16,940 --> 00:47:18,020
.ميزوري

496
00:47:19,400 --> 00:47:21,440
هل أستطيع وضع الكراسي هنا؟

497
00:47:21,440 --> 00:47:22,280
.نعم

498
00:47:23,440 --> 00:47:26,320
.ها نحن

499
00:47:33,540 --> 00:47:34,710
!حل فصل الصيف

500
00:47:35,920 --> 00:47:38,210
!كم أتمنى السباحة الآن

501
00:47:39,460 --> 00:47:40,880
،أخبريني، ميزوري

502
00:47:40,880 --> 00:47:43,260
هل لديك التزامات في العطلة القادمة؟

503
00:47:44,170 --> 00:47:45,800
.لا شيء محدد

504
00:47:45,800 --> 00:47:49,010
حقًا؟ لنذهب إلى المسبح إذن

505
00:47:52,930 --> 00:47:53,680
.سأذهب

506
00:47:55,140 --> 00:47:56,690
.تقرر الأمر إذن

507
00:47:58,770 --> 00:48:00,270
.اسمعي، نوزومي

508
00:48:02,860 --> 00:48:05,400
هل أستطيع دعوة إحداهن؟

509
00:48:09,540 --> 00:48:10,530
ما هذا؟

510
00:48:10,530 --> 00:48:13,200
.ليس من العادة أن تقولي كلامًا كهذا

511
00:48:13,200 --> 00:48:15,290
لا بأس، من تكون؟

512
00:48:27,720 --> 00:48:29,050
...خلسة

513
00:48:32,350 --> 00:48:34,060
.صورة من المسبح

514
00:48:34,560 --> 00:48:39,060
.كنت متوترة جدًا، فقد كان هناك الكثير من الطلاب الأكبر سنًا

515
00:48:40,650 --> 00:48:41,560
...لكن

516
00:48:41,560 --> 00:48:45,570
.كنت سعيدة جدًا لأنك دعوتني

517
00:48:48,820 --> 00:48:51,370
.أصبح لدي الآن ذكرى صيفية عزيزة

518
00:48:51,370 --> 00:48:52,160
.أجل

519
00:48:53,570 --> 00:48:55,660
هل أرسل لك الصورة؟

520
00:48:55,660 --> 00:48:56,370
.نعم

521
00:48:58,790 --> 00:49:02,290
.سأبذل جهدي في المنافسة العام القادم

522
00:49:08,340 --> 00:49:09,470
.أجل

523
00:49:10,300 --> 00:49:12,970
صحيح، هلا اطّلعتِ على ريشتي؟

524
00:50:26,790 --> 00:50:30,260
كاساكي-سان، هل تنصتين إلى المزمار؟

525
00:50:30,840 --> 00:50:32,550
،أداؤك ليس سيئًا

526
00:50:32,550 --> 00:50:36,010
.لكن عزفك عاطفي أكثر من اللازم

527
00:50:36,720 --> 00:50:41,020
.في هذا الجزء، الأمر الهم هو الإنصات إلى نوتات الشريك

528
00:50:41,520 --> 00:50:45,770
.يجب أن تهمسي بهدوء إلى يورويزيكا-سان، لا أن تطغي عليها

529
00:50:46,480 --> 00:50:47,940
هل تستطيعين فعل هذا؟

530
00:50:47,940 --> 00:50:48,770
.نعم

531
00:50:49,480 --> 00:50:50,780
.يورويزيكا-سان

532
00:50:51,030 --> 00:50:54,780
.تذكري أن هذا حوار بين المزمار والناي

533
00:50:55,280 --> 00:50:59,490
.لا يفترض أن يكون عزفًا من طرف واحد، يجب أن تجيبي عن استفهامات الناي

534
00:51:00,660 --> 00:51:04,290
.تحتوي الموسيقى أحيانًا على جوانب يصعب التعبير عنها

535
00:51:04,920 --> 00:51:08,540
.أرجو أن تتعلمي قراءة ما لم يدون على الأوراق

536
00:51:09,000 --> 00:51:10,800
.وأن تُشركي مشاعرك

537
00:51:11,340 --> 00:51:12,380
هل تستطيعين فعل هذا؟

538
00:51:13,760 --> 00:51:15,050
.نعم

539
00:51:16,590 --> 00:51:17,930
تقشطين ريشة؟

540
00:51:18,760 --> 00:51:21,180
.نعم، لـ ريريكا-تشان

541
00:51:21,930 --> 00:51:22,930
.هكذا إذن

542
00:51:25,850 --> 00:51:28,400
ميزوري، ستسجلين في كلية الموسيقى، أليس كذلك؟

543
00:51:28,400 --> 00:51:29,400
.بلى

544
00:51:29,690 --> 00:51:32,110
يوكو، هل يسعدك هذا؟

545
00:51:32,110 --> 00:51:35,240
.بالطبع، أنا سعيدة حقًا

546
00:51:35,240 --> 00:51:37,320
.ستُقبلين بكل تأكيد

547
00:51:39,580 --> 00:51:40,620
.هذا جيد

548
00:51:42,450 --> 00:51:44,000
...أخبريني، ميزوري

549
00:51:45,290 --> 00:51:49,130
هل ستسجلين في كلية الموسيقى من أجل نوزومي وحسب؟

550
00:51:51,840 --> 00:51:52,460
هل هذا غريب؟

551
00:51:53,550 --> 00:51:54,590
.لا

552
00:51:58,970 --> 00:52:01,640
ميزوري، ألا بأس في هذا؟

553
00:52:06,640 --> 00:52:10,730
.القرار الذي تتخذه نوزومي، سأتخذه أنا

554
00:52:11,820 --> 00:52:13,320
.هكذا إذن

555
00:52:13,320 --> 00:52:14,650
.يوكو-سينباي

556
00:52:15,110 --> 00:52:17,030
.اجتمع عازفو الأبواق

557
00:52:17,950 --> 00:52:19,990
.حسنًا، سآتي في الحال

558
00:52:25,200 --> 00:52:26,330
ماذا هناك؟

559
00:52:27,040 --> 00:52:29,500
عذرًا... هل تسمحان لي ببعض الوقت؟

560
00:52:30,670 --> 00:52:32,000
.المعذرة

561
00:52:32,000 --> 00:52:35,460
.كنت أتساءل بشأن عزف المزمار في المقطوعة الاختيارية

562
00:52:36,880 --> 00:52:38,300
،سينباي

563
00:52:38,300 --> 00:52:40,680
ألا تعتقدين أنك و نوزومي-سينباي غير متكافئتين؟

564
00:52:42,010 --> 00:52:42,890
كوساكا؟

565
00:52:44,850 --> 00:52:46,140
.هذا ليس صحيحًا

566
00:52:47,020 --> 00:52:52,900
.أشعر كما لو أن نوتاتك مقيدة

567
00:52:54,190 --> 00:52:57,030
.وكأنك تقيدينها عن قصد

568
00:52:57,780 --> 00:53:02,030
.ربما لأنك تعلمين أن نوزومي-سينباي غير قادرة على مجاراتك

569
00:53:02,030 --> 00:53:03,200
!كوساكا

570
00:53:05,240 --> 00:53:06,660
...كلا

571
00:53:12,630 --> 00:53:14,050
.أرجو المعذرة

572
00:53:14,050 --> 00:53:16,130
.أنا لا أحاول الضغط عليكِ

573
00:53:17,880 --> 00:53:18,880
...لكن

574
00:53:19,720 --> 00:53:22,890
.أريد أن أسمعكِ تعزفين بكل ما أوتيت

575
00:53:27,480 --> 00:53:28,850
.أستأذن

576
00:53:31,310 --> 00:53:32,690
...تبًا

577
00:53:33,360 --> 00:53:34,730
ميزوري، هل أنتِ على ما يرام؟

578
00:53:34,730 --> 00:53:37,440
.كلا، هذه ليست غلطة نوزومي

579
00:53:40,490 --> 00:53:45,530
.تبدو مقيدة لأنني لا أريد التخلي عن العصفورة الزرقاء

580
00:53:46,990 --> 00:53:51,790
.فأنا لا أعلم متى ستتركني نوزومي مرة أخرى

581
00:53:52,040 --> 00:53:54,000
.لا أريد أن أبعدها

582
00:53:54,630 --> 00:53:56,460
.ليس بملء إرادتي

583
00:53:56,920 --> 00:53:59,720
.لن أتمكن من تحريرها بنفسي

584
00:54:01,010 --> 00:54:02,470
.لن يحدث هذا

585
00:54:03,930 --> 00:54:05,220
،لو كنت ليز

586
00:54:06,260 --> 00:54:09,020
.لأبقيت العصفورة الزرقاء محبوسة إلى الأبد

587
00:54:11,020 --> 00:54:13,480
ناتسوكي، هل ستخوضين امتحانًا؟

588
00:54:13,480 --> 00:54:16,690
.نعم، ثلاثة امتحانات على الأقل

589
00:54:19,400 --> 00:54:20,650
و ميزوري؟

590
00:54:20,950 --> 00:54:22,150
.واحد

591
00:54:22,150 --> 00:54:23,950
مهلاً، ألم تخبرك؟

592
00:54:24,660 --> 00:54:26,160
...لا

593
00:54:26,160 --> 00:54:28,700
رغم أنكما ستسجلان في نفس الكلية؟

594
00:54:28,700 --> 00:54:30,290
...أعلم

595
00:54:33,670 --> 00:54:35,710
هل قالت ميزوري شيئًا؟

596
00:54:35,710 --> 00:54:36,790
عن ماذا؟

597
00:54:36,790 --> 00:54:38,710
...أقصد... تعلمين

598
00:54:40,630 --> 00:54:41,670
.لا شيء مهم

599
00:54:42,630 --> 00:54:45,260
.لكن بما أن لديها هدفًا الآن فهي تبذل ما بوسعها

600
00:54:45,260 --> 00:54:47,850
.أقصد أن تكون في نفس الكلية معك

601
00:54:47,850 --> 00:54:51,480
ألا تعتقدين أن هناك فارقًا كبيرًا بيننا؟

602
00:54:51,480 --> 00:54:54,310
.كيف هذا؟ تعلمين أن هذا غير صحيح

603
00:54:54,770 --> 00:54:58,860
سبق أن تركت الفرقة مرة في السنة الأولى، تذكرين؟

604
00:54:58,860 --> 00:55:02,280
،أشعر كما لو أن هذا حدث منذ زمن بعيد

605
00:55:02,280 --> 00:55:06,200
لكن هل تعتقدين أنها ما زالت تحمل الضغينة لهذا السبب؟

606
00:55:06,740 --> 00:55:11,250
.ميزوري لا تتحدث عما يجول في خاطرها كما تعلمين

607
00:55:11,250 --> 00:55:13,210
.لا أستطيع أن أؤكد هذا

608
00:55:14,580 --> 00:55:17,250
.كما أننا لسنا متكافئتين في العزف المنفرد

609
00:55:18,340 --> 00:55:20,000
،إذا أردتِ رأيي

610
00:55:20,000 --> 00:55:24,590
.صادف أن تصبحا ورقتين رابحتين في الناي والمزمار، وهذا رائع

611
00:55:24,590 --> 00:55:25,890
حقًا؟

612
00:55:29,010 --> 00:55:31,890
،أتعلمين؟ بشأن العصفورة التي أطلقتها ليز

613
00:55:32,390 --> 00:55:36,020
.أعتقد أن باستطاعتها العودة لرؤيتها متى ما أرادت

614
00:55:36,840 --> 00:55:39,610
.هذا سيضيع مجهود ليز

615
00:55:42,820 --> 00:55:45,150
لكنها ستكون نهاية سعيدة، أليس كذلك؟

616
00:55:46,360 --> 00:55:48,410
،من أجل مساعدتنا في الاستعداد لمنافسة هذا العام

617
00:55:49,030 --> 00:55:51,450
،ها هما هاشيموتو-سينسي و نياما-سينسي

618
00:55:51,450 --> 00:55:54,330
.واللذان سيشرفان على التمارين أيضًا لبعض الوقت

619
00:55:54,330 --> 00:55:59,210
.مرحبًا، مضى وقت طويل، يا طلاب السنتين الثانية والثالثة

620
00:55:59,210 --> 00:56:02,170
.وبالنسبة لطلاب السنة الأولى، سعيد بلقائكم، أنا هاشيموتو

621
00:56:02,590 --> 00:56:05,970
.سأشرف على تمارينكم لبعض الوقت

622
00:56:05,970 --> 00:56:07,300
.لنبذل جهدنا

623
00:56:27,860 --> 00:56:29,410
.ميزوري

624
00:56:29,820 --> 00:56:34,200
هل نتمرن على العزف المنفرد لاحقًا؟

625
00:56:34,200 --> 00:56:35,370
.نعم

626
00:56:40,500 --> 00:56:42,380
.نياما-سينسي

627
00:56:42,750 --> 00:56:43,630
!عجبًا

628
00:56:45,710 --> 00:56:47,130
.مضى وقت طويل

629
00:56:47,130 --> 00:56:48,680
كاساكي-سان؟

630
00:56:48,680 --> 00:56:52,600
.شكرًا لك على تدريس العزف على آلات النفخ هذه السنة أيضًا

631
00:56:52,600 --> 00:56:55,930
نجحت في الوصول إلى الفرقة الموسيقية المشاركة في المنافسة، أليس كذلك؟

632
00:56:55,930 --> 00:56:57,180
.لنبذل ما بوسعنا

633
00:56:57,180 --> 00:56:58,230
.حسنًا

634
00:57:01,900 --> 00:57:05,690
.أفكر في التسجيل في كلية الموسيقى

635
00:57:05,690 --> 00:57:07,860
عجبًا! حقًا؟

636
00:57:09,530 --> 00:57:11,070
.حظًا طيبًا

637
00:57:11,070 --> 00:57:14,030
.تستطيعين طلب النصح مني متى ما أردتِ

638
00:57:15,740 --> 00:57:16,620
.حسنًا

639
00:57:18,750 --> 00:57:19,540
.أراكِ لاحقًا

640
00:57:21,210 --> 00:57:22,210
.حسنًا

641
00:57:29,880 --> 00:57:33,930
...في الحقيقة، ما زلتُ أفكر منذ أن سمعتهما في ذلك الوقت

642
00:57:34,260 --> 00:57:35,060
...أنا

643
00:57:35,350 --> 00:57:39,810
أتساءل، هل سيكون حوار الناي والمزمار على ما يرام؟

644
00:57:40,060 --> 00:57:44,060
