199
00:13:22,590 --> 00:13:24,930
في المرّة القادمة التي نتقابل فيها
. فلتشربي معي بعض الشراب

200
00:13:25,050 --> 00:13:25,720
حسناً ؟

201
00:13:49,740 --> 00:13:51,330
ماذا سنفعل بشأن هذا ؟

202
00:13:53,000 --> 00:13:55,330
،  سيأتي اصدقائه لإنقاذه

203
00:13:55,370 --> 00:13:57,080
.  لذا إستمتع قليلاً الآن

204
00:13:57,880 --> 00:13:59,500
.  هذا يبدو رائعاً

205
00:13:59,920 --> 00:14:02,500
.  كنتُ مرهق جداً مؤخراً

206
00:14:09,800 --> 00:14:11,350
.  يجب ان تطرقي الباب قبل الدخول

207
00:14:11,470 --> 00:14:13,810
.  هذا لأنني لم اتعلّم حسن التصرّف

208
00:14:15,600 --> 00:14:16,430
.  إخرسي

209
00:14:16,730 --> 00:14:17,900
.  سنسمع ما تقوله المرأة

210
00:14:19,980 --> 00:14:21,440
أنت القائد ،  صحيح ؟

211
00:14:22,360 --> 00:14:23,190
.  بلاك

212
00:14:23,860 --> 00:14:24,650
. . . بلاك

213
00:14:25,570 --> 00:14:28,150
أنتم تبيعون الاسلحة صحيح ؟

214
00:14:29,240 --> 00:14:31,700
هل ستعطوني البعض مقابل هذا ؟

215
00:14:34,710 --> 00:14:37,120
.  نحن مجرّد طلّاب

216
00:14:37,500 --> 00:14:38,670
.  أنتم من مدرسة جيّدة

217
00:14:39,040 --> 00:14:41,380
.  أغنياء و أذكياء

218
00:14:42,170 --> 00:14:43,170
.  مشاهير

219
00:14:43,540 --> 00:14:44,840
.  يقولون بأنّكم تستطيعون فِعل آي شيئ

220
00:14:47,220 --> 00:14:48,760
عليكِ أن تعرفي

221
00:14:48,970 --> 00:14:52,180
.  بأننا لا نهتم بمثل هذهِ الأشياء

222
00:14:56,640 --> 00:14:57,430
.  لا بأس

223
00:14:58,730 --> 00:14:59,650
!  تعالي

224
00:15:04,440 --> 00:15:05,610
!  إنّ هذهِ مذهلة

225
00:15:06,360 --> 00:15:08,400
آه ،  هل يمكنني تجربة واحدة من هذهِ ؟

226
00:15:09,780 --> 00:15:11,070
. . . قبل ذلك

227
00:15:12,490 --> 00:15:13,780
.  أريد أن اختبركِ قليلاً

228
00:15:14,240 --> 00:15:17,540
.  أريد أن أعرف أنّكِ لستِ من أصدقائه

229
00:15:18,620 --> 00:15:20,170
.  أطلقي عليه

230
00:15:30,050 --> 00:15:30,970
. . . كوراو

231
00:15:33,470 --> 00:15:35,100
.  عودي بسرعة

232
00:15:42,980 --> 00:15:43,690
.  حسناً

233
00:15:48,740 --> 00:15:50,240
.  هيه ،  هذا ليس جيّداً

234
00:15:51,030 --> 00:15:52,410
ما هو الشيئ الغير جيّد ؟

235
00:16:05,460 --> 00:16:06,210
هل هناك مشكلة ؟

236
00:16:11,090 --> 00:16:12,180
.  أنا معجب بكِ

237
00:16:12,340 --> 00:16:13,470
هل تريدين أن تنضمّي إلينا ؟

238
00:16:14,350 --> 00:16:15,720
.  هذا جيّد بالنسبة ليّ

239
00:16:16,560 --> 00:16:17,140
.  لنذهب إذاً

240
00:16:20,930 --> 00:16:21,310
.  جين

241
00:16:21,980 --> 00:16:23,770
.  إرمي ذلك الشخص في القبو

242
00:16:30,070 --> 00:16:31,990
.  لقد قلت بأنني لا أهتم

243
00:16:32,030 --> 00:16:33,990
. . . لكنني موافق أيّها العجوز

244
00:16:35,070 --> 00:16:35,870
أين الحمّام ؟

245
00:16:42,330 --> 00:16:43,790
الأمور تجري معي بسلاسة

246
00:16:45,330 --> 00:16:46,290
! هناك شيئ غير صحيح

247
00:16:48,170 --> 00:16:48,750
!  سام

248
00:16:49,210 --> 00:16:49,880
هل أنت بخير ؟

249
00:16:52,470 --> 00:16:53,180
.  لــ نُسرع

250
00:16:53,670 --> 00:16:55,470
.  إنّهم يخططون لشيئ ما

251
00:16:56,600 --> 00:16:57,600
.  كما توقعت

252
00:16:58,260 --> 00:17:00,560
.  لكنني ،  سأُنهي الأمر هنا

253
00:17:03,060 --> 00:17:03,810
وحدك ؟

254
00:17:05,230 --> 00:17:07,020
ألن يغضب بلاك ؟

255
00:17:09,270 --> 00:17:10,900
من أنتِ ؟

256
00:17:11,690 --> 00:17:15,360
.  لقد إستعملتِ خدعة مع الزناد في الوقت السابق

257
00:17:15,780 --> 00:17:16,990
. . . لهذا أعتقد

258
00:17:17,950 --> 00:17:18,990
. . . بأنّكِ

259
00:17:19,790 --> 00:17:21,200
!  غير طبيعيّة

260
00:17:23,120 --> 00:17:24,370
.  هذهِ وقاحة

261
00:17:28,460 --> 00:17:30,710
!  واو ،  أنتِ مذهلة

262
00:17:30,880 --> 00:17:31,590
.  هيا نذهب

263
00:17:40,470 --> 00:17:41,720
.  صباح الخير ،  غو

264
00:17:42,350 --> 00:17:43,730
كيف تشعر ؟

265
00:17:44,930 --> 00:17:46,690
. من الخطأ أن تسعى خلف فتاة من دوننا

266
00:17:47,270 --> 00:17:48,730
هل رفضتك ؟

267
00:17:48,980 --> 00:17:49,520
!  اصمتوا

268
00:17:52,440 --> 00:17:52,990
،  غو

269
00:17:53,490 --> 00:17:56,360
.  شاهد كيف يتم العمل الحقيقي

270
00:18:03,870 --> 00:18:05,160
!  هيّا ّ هيّا

271
00:18:06,620 --> 00:18:08,290
!  أهربوا !  أهربوا

272
00:18:16,010 --> 00:18:16,720
!  إبتعد من هناك

273
00:18:20,890 --> 00:18:21,600
!  كوراو

274
00:19:06,140 --> 00:19:07,230
.  إستمرّي في الهرب

275
00:19:30,920 --> 00:19:32,080
!  اسرعو ،  أطفئوا النيران

276
00:19:32,380 --> 00:19:33,210
.  هذا سيّئ

277
00:19:33,250 --> 00:19:34,750
!  يجب ان نهرب من هنا

278
00:19:39,930 --> 00:19:43,050
لما أنا متعبة هكذا ؟

279
00:19:45,140 --> 00:19:48,850
. . . . كوراو

280
00:19:53,440 --> 00:19:55,190
!  لم ننتهي بعد

281
00:19:59,940 --> 00:20:01,910
! كيف تجرؤين على جعلي أضحوكة ؟

282
00:20:02,320 --> 00:20:03,870
!  إذهبي للجحيم

283
00:20:52,660 --> 00:20:55,040
مالذي يحدث ليّ ؟

284
00:20:58,170 --> 00:20:59,170
. . . كريسماس

285
00:21:12,060 --> 00:21:12,980
كوراو ؟

286
00:21:14,850 --> 00:21:15,650
!  كوراو

287
00:21:19,440 --> 00:21:22,030
.  لقد تأخرت قليلاً

288
00:21:22,780 --> 00:21:23,700
. . . كوراو

289
00:21:24,950 --> 00:21:25,950
.  حمداً لله

290
00:21:27,570 --> 00:21:29,790
.  حمداً لله أنّكِ عدتِ للمنزل

291
00:21:37,160 --> 00:21:39,860
يتبع

292
00:23:09,970 --> 00:23:11,970
الحلقة القادمة

293
00:23:12,140 --> 00:23:12,680
. . . لـ

294
00:23:13,140 --> 00:23:15,600
! لا

295
00:23:17,060 --> 00:23:18,850
!  كريسماس

296
00:23:22,020 --> 00:23:24,980
الطفلة الضائعة