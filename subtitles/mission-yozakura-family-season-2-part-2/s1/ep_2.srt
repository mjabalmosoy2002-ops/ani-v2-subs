1
00:00:15,890 --> 00:00:20,020
&rlm;أتذكر كيف كنت أدربك بلعبة المطاردة
يا "كيويتشيرو"؟

2
00:00:20,100 --> 00:00:23,480
&rlm;تدمع عيناي من فرط الحنين والفرح!

3
00:00:23,560 --> 00:00:27,480
&rlm;مع ابني البكر الحبيب،
حضر صهري الذي يُعتمد عليه أيضاً!

4
00:00:27,560 --> 00:00:29,230
&rlm;أي سعادة تضاهي سعادتي؟

5
00:00:29,780 --> 00:00:32,570
&rlm;أتوق لأن أريك هذا أيضاً.

6
00:00:32,650 --> 00:00:33,900
&rlm;يا "راي"!

7
00:00:33,990 --> 00:00:37,700
&rlm;حين يجتمع شملنا، سنخيّم معاً،
ونقصد الينابيع الحارة،

8
00:00:37,780 --> 00:00:40,830
&rlm;ونلعب ونأكل في البوفيهات،
ونرتاد السينما ونلعب كرة الطاولة،

9
00:00:40,910 --> 00:00:42,790
&rlm;ونذهب إلى الملاهي ونلعب الورق!

10
00:00:42,870 --> 00:00:44,960
&rlm;سنستمتع بكل ما يخطر ببالنا!

11
00:00:45,540 --> 00:00:48,340
&rlm;يا "تايو"، سنخضع ذلك الرجل الآن.

12
00:00:49,130 --> 00:00:51,260
&rlm;لا تجدي معه الهجمات الجسدية.

13
00:00:51,340 --> 00:00:52,340
&rlm;لكن…

14
00:00:52,420 --> 00:00:56,510
&rlm;حين تشبعت خيوطي بالمواد الزهرية من جسمك،

15
00:00:56,590 --> 00:00:58,100
&rlm;استطاعت أن تشقّ جسده.

16
00:00:58,180 --> 00:01:00,720
&rlm;ستصيبه قبضتاك.

17
00:01:03,810 --> 00:01:06,770
&rlm;ما الأمر؟ هل استسلمتما بهذه السرعة؟

18
00:01:06,850 --> 00:01:09,860
&rlm;إن كنتما بهذا الفتور،
فأظن أنني سأُضطر إلى توديع…

19
00:01:28,920 --> 00:01:33,840
&rlm;مهمة الكشف عن عائلة "يوزاكورا"

20
00:02:52,170 --> 00:02:55,130
&rlm;يا له من منظر يثلج الصدر!

21
00:02:55,880 --> 00:02:58,260
&rlm;أي صهر يلكم حماه؟

22
00:02:59,090 --> 00:03:00,840
&rlm;يا لك من فتى مشاغب!

23
00:03:00,930 --> 00:03:02,760
&rlm;أحسنت يا "تايو".

24
00:03:02,840 --> 00:03:04,680
&rlm;سألاعبك قليلاً.

25
00:03:06,180 --> 00:03:07,180
&rlm;يا لسرعته!

26
00:03:07,770 --> 00:03:09,230
&rlm;ردود فعلك بطيئة جداً.

27
00:03:09,310 --> 00:03:10,690
&rlm;أخصم 10 نقاط.

28
00:03:14,820 --> 00:03:17,030
&rlm;وحركاتك التمهيدية مكشوفة تماماً.

29
00:03:17,110 --> 00:03:18,940
&rlm;أخصم 15 نقطة.

30
00:03:24,280 --> 00:03:26,580
&rlm;لا يجدي "ياي" من مسافة قريبة.

31
00:03:26,660 --> 00:03:28,330
&rlm;أخصم 25 نقطة.

32
00:03:36,290 --> 00:03:39,210
&rlm;أخفيت سكينك في موضع مكشوف.

33
00:03:39,300 --> 00:03:40,720
&rlm;أخصم 10 نقاط.

34
00:03:41,220 --> 00:03:43,470
&rlm;وحركاتك في الهواء بطيئة أيضاً.

35
00:03:43,550 --> 00:03:45,180
&rlm;أخصم 10 نقاط.

36
00:03:45,260 --> 00:03:48,390
&rlm;ما دمت ستسحب "ياي"،
فكان عليك اختيار السيف.

37
00:03:48,470 --> 00:03:50,850
&rlm;إن أردت إسقاط من يفوقك قوة،

38
00:03:50,930 --> 00:03:53,850
&rlm;فعليك أن تتقبل احتمال قتله.

39
00:03:53,940 --> 00:03:55,690
&rlm;أخصم 30 نقطة.

40
00:03:56,270 --> 00:04:00,070
&rlm;درجتك صفر من 100.

41
00:04:00,150 --> 00:04:02,490
&rlm;ما زال ينقصك الكثير من التدريب.

42
00:04:07,910 --> 00:04:10,660
&rlm;والآن قيّمني أنا أيضاً يا أبي.

43
00:04:12,460 --> 00:04:17,590
&rlm;أنت تكاد تبلغ الكمال دائماً،
لذا أريد تقييمك بدقة.

44
00:04:17,670 --> 00:04:18,840
&rlm;ولذلك…

45
00:04:18,920 --> 00:04:21,050
&rlm;سأتفرغ لك على مهل في يوم آخر.

46
00:04:33,350 --> 00:04:35,350
&rlm;تلك الوحوش مجدداً!

47
00:04:35,440 --> 00:04:37,650
&rlm;أنا عبقري.

48
00:04:37,730 --> 00:04:41,360
&rlm;فضلاً عن براعتي القتالية وذكائي،
أنا محظوظ جداً أيضاً.

49
00:04:41,440 --> 00:04:43,900
&rlm;ومع أنني قادر
على إنجاز معظم الأمور بمفردي،

50
00:04:43,990 --> 00:04:47,280
&rlm;فكلما زاد عدد بيادقي،
ازدادت الأمور يسراً عليّ.

51
00:04:47,780 --> 00:04:49,870
&rlm;ولهذا صنعت هؤلاء الصغار.

52
00:04:49,950 --> 00:04:54,290
&rlm;استعنت بجسد "تسوبومي"
وجعلتها تلدهم بأعداد غفيرة…

53
00:04:54,370 --> 00:04:56,000
&rlm;إخوتي الصغار المطيعون.

54
00:04:56,080 --> 00:04:59,960
&rlm;أقوياء وليّنون ونضرون، يفيضون بالثمار،

55
00:05:00,050 --> 00:05:02,670
&rlm;ونفيسون لدرجة أنني سميتهم…

56
00:05:02,760 --> 00:05:05,010
&rlm;"الكرز الأسود".

57
00:05:05,510 --> 00:05:06,890
&rlm;اسم مثالي، أليس كذلك؟

58
00:05:10,390 --> 00:05:13,520
&rlm;والمزيد من "الكرز الأسود" قادم.

59
00:05:13,600 --> 00:05:16,770
&rlm;سأجمع المزيد من "سوميناين" النقي.

60
00:05:17,270 --> 00:05:21,780
&rlm;ستعود "راي" إلى الحياة،
وتتجدد عائلة "يوزاكور".

61
00:05:22,480 --> 00:05:27,110
&rlm;عشتم كل هذا الوقت في ألم وحزن يا أبنائي.

62
00:05:27,860 --> 00:05:31,280
&rlm;ولهذا سأريكم، بصفتي أباكم…

63
00:05:34,960 --> 00:05:37,420
&rlm;أن الحب ينتصر دائماً!

64
00:05:38,710 --> 00:05:40,460
&rlm;يا له من هراء.

65
00:05:42,210 --> 00:05:43,420
&rlm;"تايو"!

66
00:05:50,510 --> 00:05:53,560
&rlm;فهمت. استغللت أن "الكرز الأسود"

67
00:05:53,640 --> 00:05:56,270
&rlm;هاج وفتّت الأرض،

68
00:05:56,350 --> 00:05:59,980
&rlm;واستخدمت "التصلب" لتهاجمني مباشرةً؟

69
00:06:03,860 --> 00:06:05,190
&rlm;مثير للاهتمام.

70
00:06:09,530 --> 00:06:14,120
&rlm;عزمت "موتسومي" على قتالك لتحمي العائلة.

71
00:06:14,620 --> 00:06:15,910
&rlm;ولهذا فأنا أيضاً…

72
00:06:16,000 --> 00:06:20,000
&rlm;سأقاتلك لحماية العائلة!

73
00:06:21,330 --> 00:06:23,750
&rlm;شجاعتك هي حسنتك الوحيدة، أليس كذلك؟

74
00:06:23,840 --> 00:06:25,460
&rlm;سأمنحك خمس نقاط.

75
00:06:25,550 --> 00:06:28,340
&rlm;استمر وازدد قوة فوق قوتك!

76
00:06:29,930 --> 00:06:32,180
&rlm;يا ابني الحبيب!

77
00:06:37,520 --> 00:06:39,520
&rlm;يثير غيظي كلما رأيته.

78
00:06:40,020 --> 00:06:42,520
&rlm;يبدو أن "فوتابا" والبقية
سحقوا وحوشهم أيضاً.

79
00:06:43,150 --> 00:06:46,230
&rlm;يبدو أنها تعود إلى الحياة
ما دامت نواة تجددها سليمة.

80
00:06:46,320 --> 00:06:50,070
&rlm;لكن إن تبددت تماماً،
فالنتيجة واحدة في النهاية.

81
00:06:53,410 --> 00:06:55,790
&rlm;لنلحق بـ"موتسومي" والبقية فوراً.

82
00:06:59,080 --> 00:07:00,330
&rlm;"كاي".

83
00:07:00,420 --> 00:07:03,210
&rlm;أنا الآن على بُعد أكثر من 10 دقائق
من "موتسومي"،

84
00:07:03,290 --> 00:07:04,750
&rlm;ولذا فأنا في غاية الضيق.

85
00:07:04,840 --> 00:07:05,840
&rlm;سأغلق الخط.

86
00:07:05,920 --> 00:07:09,300
&rlm;"كاي"؟ رئيس رابطة الجواسيس؟

87
00:07:09,380 --> 00:07:12,550
&rlm;يا "كيويتشيرو"، لا أدري من أين أبدأ

88
00:07:12,640 --> 00:07:14,890
&rlm;لأبيّن لك مدى سخافة منطقك هذا.

89
00:07:15,890 --> 00:07:17,850
&rlm;أطلعتني "شيون" على المستجدات.

90
00:07:18,520 --> 00:07:21,980
&rlm;أريد أن أحدثك بشأنها،
فتعال إلى الرابطة حالاً.

91
00:07:22,060 --> 00:07:24,400
&rlm;هل الأمر متعلق بـ"موتسومي"؟

92
00:07:24,480 --> 00:07:27,900
&rlm;حقاً، كل ما يعنيك هو "موتسومي"!

93
00:07:29,030 --> 00:07:31,530
&rlm;الأمر متعلق بها. وبشدة أيضاً.

94
00:07:32,030 --> 00:07:33,370
&rlm;سآتي حالاً.

95
00:07:35,990 --> 00:07:40,830
&rlm;"جدة الحلوى الرخيصة"

96
00:07:42,420 --> 00:07:43,830
&rlm;ها قد أتيتما.

97
00:07:43,920 --> 00:07:46,290
&rlm;أنت تجرّني!

98
00:07:50,760 --> 00:07:52,970
&rlm;لا علاقة لي بهذا، صحيح؟

99
00:07:53,050 --> 00:07:55,100
&rlm;أنا من طلب حضورك.

100
00:07:55,180 --> 00:07:56,180
&rlm;ماذا؟

101
00:07:56,260 --> 00:07:57,720
&rlm;أأنتما بخير؟

102
00:07:57,810 --> 00:08:01,100
&rlm;بخير، عدا أنه أفلت منا.
كيف حال "موتسومي" والبقية؟

103
00:08:01,180 --> 00:08:02,190
&rlm;إنهم بخير.

104
00:08:02,270 --> 00:08:04,850
&rlm;قالوا إنهم عادوا إلى المنزل للتو.

105
00:08:04,940 --> 00:08:06,980
&rlm;ما رأيكم في أن ندخل الآن؟

106
00:08:07,070 --> 00:08:10,320
&rlm;مع أننا ما زلنا ننتظر اثنين
من ذوي الرتبة الذهبية.

107
00:08:14,530 --> 00:08:16,570
&rlm;محيط الصدر، 135 سنتيمتراً.

108
00:08:16,660 --> 00:08:18,620
&rlm;أراك تكبر بسرعة مذهلة.

109
00:08:20,870 --> 00:08:22,540
&rlm;أرجوك لا تلمسني!

110
00:08:22,620 --> 00:08:24,750
&rlm;سيد "ريو"!

111
00:08:27,040 --> 00:08:29,500
&rlm;يا لك من شابّ قوي مفعم بالحيوية.

112
00:08:29,590 --> 00:08:31,670
&rlm;أنت بحق درة عالم التجسس.

113
00:08:31,760 --> 00:08:33,880
&rlm;هذا تصريح جريء حقاً. قل لي يا "شين"…

114
00:08:33,970 --> 00:08:35,680
&rlm;"(ألكساندريو)، رئيس تحرير"

115
00:08:35,760 --> 00:08:37,640
&rlm;تودّ الظهور على صفحتي المجلة الوسطيتين؟

116
00:08:37,720 --> 00:08:39,890
&rlm;لن أفعل مهما كررت طلبك!

117
00:08:39,970 --> 00:08:43,350
&rlm;أمطره الأخ الأكبر "شينزو"
بالرصاص ولم يُصب بخدش؟

118
00:08:44,020 --> 00:08:47,190
&rlm;"فوتابا" الصغيرة!

119
00:08:47,270 --> 00:08:50,230
&rlm;لماذا تهربين مني؟

120
00:08:50,320 --> 00:08:52,030
&rlm;لست دمية، كما تعلمين.

121
00:08:52,110 --> 00:08:54,400
&rlm;لن أعانقك في كل مناسبة يا "شورا".

122
00:08:54,490 --> 00:08:55,860
&rlm;لكننا التقينا أخيراً،

123
00:08:55,950 --> 00:08:57,160
&rlm;"(شورا)، رئيسة (أشورا)"

124
00:08:57,240 --> 00:08:59,620
&rlm;فلنتعانق بقوة لأجل الأيام الخوالي!

125
00:08:59,700 --> 00:09:00,990
&rlm;كفّي عن هذا العبث.

126
00:09:01,080 --> 00:09:03,080
&rlm;هيا بنا إلى الاجتماع.

127
00:09:04,580 --> 00:09:06,420
&rlm;أنا مستاءة.

128
00:09:09,380 --> 00:09:11,500
&rlm;حسناً، كما تشائين.

129
00:09:11,590 --> 00:09:14,510
&rlm;يا لك من صديقة طفولة صعبة الإرضاء.

130
00:09:16,130 --> 00:09:18,930
&rlm;يا "فوتابا" الصغيرة! أيمكنني حملك؟

131
00:09:19,010 --> 00:09:20,010
&rlm;لا.

132
00:09:20,100 --> 00:09:22,680
&rlm;ماذا؟ ما المانع؟

133
00:09:22,770 --> 00:09:24,520
&rlm;أنت "تايو" الصغير إذاً؟

134
00:09:24,600 --> 00:09:26,140
&rlm;سُررت بلقائك!

135
00:09:26,230 --> 00:09:28,770
&rlm;أتستهويك النزوات أو الخيانة الزوجية؟

136
00:09:28,860 --> 00:09:29,980
&rlm;ماذا؟ خيانة…

137
00:09:31,230 --> 00:09:33,900
&rlm;نادراً ما نجتمع نحن الـ10 هنا.

138
00:09:33,990 --> 00:09:35,610
&rlm;صحيح، إنها أشبه بمعجزة.

139
00:09:36,280 --> 00:09:39,200
&rlm;حسناً، يبدأ الآن اجتماع الرتبة الذهبية.

140
00:09:40,030 --> 00:09:42,240
&rlm;بدايةً، أرجو أن تشاهدوا هذا الفيديو.

141
00:09:42,740 --> 00:09:45,540
&rlm;هذا "دارك تيوب"،
موقع فيديوهات على الشبكة المظلمة.

142
00:09:45,620 --> 00:09:46,750
&rlm;"امتصصت جواسيس مزعجين"

143
00:09:46,830 --> 00:09:48,540
&rlm;رُفع هذا قبل بضع ساعات.

144
00:09:48,630 --> 00:09:49,630
&rlm;"قناة (مومو)"

145
00:09:49,710 --> 00:09:51,420
&rlm;كيف حالكم يا أبنائي؟

146
00:09:51,500 --> 00:09:53,000
&rlm;أنا أبوكم!

147
00:09:54,300 --> 00:09:57,470
&rlm;أردت أن تروا جميعاً كم أجدّ في عملي،

148
00:09:57,550 --> 00:10:00,180
&rlm;لذا أنشأت لنفسي قناة!

149
00:10:00,260 --> 00:10:01,930
&rlm;سماد اليوم

150
00:10:02,010 --> 00:10:06,390
&rlm;يتألف من 100 جاسوس من الرتبتين الفضية
والبرونزية في رابطة الجواسيس!

151
00:10:06,480 --> 00:10:08,690
&rlm;لن يحزن أحد على أهل العالم السفلي،

152
00:10:08,770 --> 00:10:10,400
&rlm;مهما بلغ عدد من يُستهلكون منهم.

153
00:10:10,480 --> 00:10:12,230
&rlm;أليس هذا صديقاً للبيئة؟

154
00:10:13,270 --> 00:10:16,950
&rlm;سأكثّف نشاطي لأعيد أمكم إلى الحياة.

155
00:10:17,030 --> 00:10:18,030
&rlm;"المشاهدات"

156
00:10:18,110 --> 00:10:19,200
&rlm;اشتركوا الآن!

157
00:10:19,280 --> 00:10:20,660
&rlm;"إعادة التشغيل"

158
00:10:23,740 --> 00:10:28,210
&rlm;يختفي أناس من كل مكان، ومن رابطتنا أيضاً.

159
00:10:28,290 --> 00:10:29,290
&rlm;"اقتلوهم جميعاً!"

160
00:10:29,370 --> 00:10:32,090
&rlm;ويُضاف إلى ذلك سلوك الجاني الغريب،

161
00:10:32,170 --> 00:10:33,920
&rlm;إذ يبث جريمته ودافعه لارتكابها.

162
00:10:34,500 --> 00:10:36,970
&rlm;وبهذا سيعرفه أهل العالم السفلي،

163
00:10:37,050 --> 00:10:39,630
&rlm;وكذلك كبار المسؤولين
في المجتمع العلني أيضاً.

164
00:10:39,720 --> 00:10:41,180
&rlm;"مقزز. مت، بالضبط"

165
00:10:41,260 --> 00:10:44,760
&rlm;وهذا الهياج من صنع الزوج الشهير
لزعيمة عائلة "يوزاكورا" التاسعة.

166
00:10:44,850 --> 00:10:45,850
&rlm;"تلك العائلة وبال"

167
00:10:46,560 --> 00:10:48,690
&rlm;لقد تشوهت سمعة عائلة "يوزاكورا"،

168
00:10:48,770 --> 00:10:50,600
&rlm;وانتشر الأمر كالنار في الهشيم.

169
00:10:51,150 --> 00:10:54,440
&rlm;والآن قُدّم هذا الطلب الخطي المشترك

170
00:10:54,520 --> 00:10:58,150
&rlm;من الحكومة والشرطة وبعض أعضاء هذه الرابطة.

171
00:10:58,240 --> 00:10:59,740
&rlm;"مقترح إبعاد عائلة (يوزاكورا)"

172
00:11:02,320 --> 00:11:04,990
&rlm;طرد عائلة "يوزاكورا" من الرابطة.

173
00:11:06,790 --> 00:11:08,910
&rlm;هذا ما سنناقشه اليوم.

174
00:11:09,000 --> 00:11:10,750
&rlm;طرد؟

175
00:11:10,830 --> 00:11:12,880
&rlm;أجل. المسألة بسيطة.

176
00:11:13,880 --> 00:11:17,260
&rlm;من الواضح أن هذا الأب
يعيث فساداً من أجل عائلته.

177
00:11:17,340 --> 00:11:19,090
&rlm;وكل تعامل مع عائلة "يوزاكورا"

178
00:11:19,170 --> 00:11:21,260
&rlm;ينطوي دائماً على الخطر
الذي يمثله هذا الرجل.

179
00:11:22,010 --> 00:11:24,850
&rlm;عائلة "يوزاكورا" منظمة تجسس،
إن جاز التعبير.

180
00:11:25,720 --> 00:11:29,020
&rlm;"على العائلة معالجة
تجاوزات منظمتها بنفسها."

181
00:11:29,100 --> 00:11:30,980
&rlm;تلك هي قواعدنا.

182
00:11:31,560 --> 00:11:34,400
&rlm;فور تصويت الأغلبية بالموافقة،

183
00:11:34,480 --> 00:11:38,690
&rlm;سنجمّد كل الأصول المشتركة،
ونصادر كل الأسلحة المستأجرة.

184
00:11:38,780 --> 00:11:40,240
&rlm;مهلاً، بهذه البساطة؟

185
00:11:40,320 --> 00:11:41,320
&rlm;يا للعجب.

186
00:11:41,400 --> 00:11:44,450
&rlm;يا للمتعة. أنا أصوّت بالموافقة على الطرد.

187
00:11:44,530 --> 00:11:45,620
&rlm;سيد "ريو"!

188
00:11:45,700 --> 00:11:47,740
&rlm;سامحني يا "شين".

189
00:11:47,830 --> 00:11:50,290
&rlm;أعشقكم جميعاً، بالطبع.

190
00:11:50,370 --> 00:11:53,040
&rlm;لكن المعلومات جوهر عمل الجاسوس.

191
00:11:53,120 --> 00:11:55,670
&rlm;فضيحة تحيط بعائلة تجسس مرموقة،

192
00:11:55,750 --> 00:11:58,550
&rlm;وخلافات عائلية، إنه سبق صحفي ثمين.

193
00:11:58,630 --> 00:12:02,930
&rlm;بصفتي رئيس تحرير مجلة الفضائح الأولى
في عالم التجسس،

194
00:12:03,010 --> 00:12:07,350
&rlm;وبصفتي جاسوساً من الرتبة الذهبية،
فأنا في نشوة لا تُوصف.

195
00:12:07,430 --> 00:12:09,180
&rlm;لا تقلقوا بتاتاً!

196
00:12:09,270 --> 00:12:12,770
&rlm;يمكن لعائلة "يوزاكورا"
تدبر أمورها من دون الرابطة،

197
00:12:12,850 --> 00:12:15,940
&rlm;وحتى إن واجهتم متاعب، فهذا بحدّ ذاته مادة…

198
00:12:16,610 --> 00:12:20,320
&rlm;إن آذيت "فوتابا" وعائلتها، فسأقتلك.

199
00:12:20,400 --> 00:12:22,450
&rlm;أليس "مومو يوزاكورا" هو المذنب؟

200
00:12:23,030 --> 00:12:25,320
&rlm;لا علاقة لـ"فوتابا" والبقية بهذا.

201
00:12:25,410 --> 00:12:27,580
&rlm;طلب مجحف كهذا…

202
00:12:27,660 --> 00:12:29,290
&rlm;أرفضه تماماً!

203
00:12:29,370 --> 00:12:33,370
&rlm;يا للانفعال.
أتتناولين ما يكفي من الفيتامينات؟

204
00:12:33,460 --> 00:12:35,120
&rlm;كفى يا "شورا".

205
00:12:35,210 --> 00:12:36,710
&rlm;نحن في اجتماع.

206
00:12:36,790 --> 00:12:39,960
&rlm;وصحيح أننا نجرّكم جميعاً إلى هذا.

207
00:12:40,050 --> 00:12:42,090
&rlm;إن افتعلت المشاكل، فلن…

208
00:12:42,170 --> 00:12:43,970
&rlm;اخرسي أنت يا "فوتابا".

209
00:12:44,050 --> 00:12:47,050
&rlm;أفعل كل ما يحلو لي.

210
00:12:47,140 --> 00:12:48,300
&rlm;كل ما يحلو لي.

211
00:12:48,810 --> 00:12:51,680
&rlm;ولن أسمح لأحد باعتراضي،
حتى أنت يا "فوتابا".

212
00:12:51,770 --> 00:12:54,640
&rlm;ها قد عدت إلى عادتك السيئة.

213
00:12:54,730 --> 00:12:56,020
&rlm;حسناً، كما تشائين.

214
00:12:56,100 --> 00:12:58,610
&rlm;مضى وقت طويل. فلنتواجه.

215
00:12:58,690 --> 00:13:00,400
&rlm;تحوّل الاجتماع إلى نزال؟

216
00:13:00,480 --> 00:13:02,490
&rlm;تراجعي يا أختي الكبرى، أرجوك.

217
00:13:02,570 --> 00:13:04,650
&rlm;علمت أن هذا سيحدث.

218
00:13:05,240 --> 00:13:06,950
&rlm;لكن هذه مجرد البداية.

219
00:13:07,030 --> 00:13:10,700
&rlm;إنهم من أعقل جواسيس الرتبة الذهبية.

220
00:13:11,200 --> 00:13:13,200
&rlm;لم يفسدوا الاجتماع تماماً بعد.

221
00:13:13,750 --> 00:13:15,870
&rlm;المشكلة في هذا الرجل.

222
00:13:15,960 --> 00:13:19,590
&rlm;رابطة الجواسيس
تقرر كيف تتصرف مع عائلة "يوزاكورا"؟

223
00:13:20,630 --> 00:13:22,170
&rlm;يا لها من طرفة عجيبة.

224
00:13:23,130 --> 00:13:28,760
&rlm;من الحماقة المطلقة
مساواة عائلة "يوزاكورا" بذلك الرجل.

225
00:13:28,850 --> 00:13:32,180
&rlm;لا شك عندي أنكم تتسلّون بهذا كله،

226
00:13:32,270 --> 00:13:34,430
&rlm;لكنني لا أنوي مجاراتكم.

227
00:13:35,020 --> 00:13:38,020
&rlm;إن أيدتم طرد عائلة "يوزاكورا" بلا مبرر،

228
00:13:38,100 --> 00:13:40,860
&rlm;فسأجعلكم تدفعون الثمن الذي تستحقونه.

229
00:13:41,480 --> 00:13:43,570
&rlm;لا مانع عندي.

230
00:13:43,650 --> 00:13:45,530
&rlm;لكن إن أفسدت هذا الاجتماع الآن،

231
00:13:45,610 --> 00:13:48,240
&rlm;فلن تضرّ إلا بموقف عائلة "يوزاكورا".

232
00:13:48,320 --> 00:13:50,450
&rlm;لا أبالي مطلقاً.

233
00:13:50,530 --> 00:13:54,200
&rlm;لن تتزعزع عائلة "يوزاكورا"
حتى لو تركت منظمة.

234
00:13:54,290 --> 00:13:56,370
&rlm;كفّ عن هذا يا "كيويتشيرو".

235
00:13:56,960 --> 00:13:58,330
&rlm;أخي الأكبر.

236
00:14:00,630 --> 00:14:02,630
&rlm;توقف يا "كيويتشيرو".

237
00:14:08,260 --> 00:14:10,890
&rlm;أتفهم سبب غضبك يا "كيويتشيرو".

238
00:14:10,970 --> 00:14:12,890
&rlm;ولهذا بالضبط أريدك أن تهدأ.

239
00:14:12,970 --> 00:14:16,640
&rlm;قطع خيوط أخي الأكبر بهذه السهولة.

240
00:14:16,730 --> 00:14:18,100
&rlm;كلها، من دون استثناء!

241
00:14:18,190 --> 00:14:19,810
&rlm;لا يسعني إلا الإقرار ببراعتك.

242
00:14:20,400 --> 00:14:23,400
&rlm;لقد فككت ألياف "العنكبوت الفولاذي"…

243
00:14:23,980 --> 00:14:25,280
&rlm;بضربة واحدة.

244
00:14:25,900 --> 00:14:28,030
&rlm;تلك براعة نادرة تتمتع بها

245
00:14:28,110 --> 00:14:30,360
&rlm;بفضل حدة إدراكك الفائقة.

246
00:14:31,030 --> 00:14:33,410
&rlm;ما دمت ثاقب البصيرة إلى هذا الحدّ،

247
00:14:33,490 --> 00:14:36,080
&rlm;فلا بدّ أنك تدرك مدى جور هذا الاجتماع.

248
00:14:36,830 --> 00:14:39,500
&rlm;إن كنت ستعترضني وأنت تعلم ذلك،

249
00:14:39,580 --> 00:14:42,960
&rlm;فلن أرحمك حتى أنت يا "كاي".

250
00:14:54,850 --> 00:14:56,220
&rlm;مهلاً يا "كاي"!

251
00:14:56,310 --> 00:14:57,520
&rlm;يداك متشققتان.

252
00:14:58,850 --> 00:15:00,900
&rlm;آثار خيوطك أعمق من المعتاد…

253
00:15:01,440 --> 00:15:05,610
&rlm;دليل على رفقك في استخدامها
من أجل عائلتك التي قاتلت بجانبك.

254
00:15:06,690 --> 00:15:09,400
&rlm;وتعطّرت قبل المهمة أكثر من عادتك…

255
00:15:09,490 --> 00:15:12,530
&rlm;ماء كولونيا البرغموت الذي تحبه "موتسومي"…

256
00:15:13,030 --> 00:15:15,580
&rlm;والذي أنت تستخدمه لتطمئنها.

257
00:15:16,410 --> 00:15:20,210
&rlm;ومررت يديك في شعرك أكثر من المعتاد…

258
00:15:20,290 --> 00:15:24,590
&rlm;لعزمك، بصفتك الابن البكر،
على ألّا تزعزعك متاعب عائلتك.

259
00:15:27,840 --> 00:15:29,880
&rlm;أتفهّم غضبك من هذا الظلم.

260
00:15:30,590 --> 00:15:33,970
&rlm;وأعلم أن أمراً كهذا
لن يُضعف عائلة "يوزاكورا".

261
00:15:34,050 --> 00:15:36,350
&rlm;لكن إن خلّفت وراءك كارثة بلا داع،

262
00:15:37,060 --> 00:15:40,940
&rlm;فستذهب كل جهودك سدى يا "كيويتشيرو"،
وهذا ما لا أريده.

263
00:15:52,610 --> 00:15:55,660
&rlm;يا مفسد المتعة. فلنستأنف الاجتماع.

264
00:15:55,740 --> 00:15:56,870
&rlm;شكراً.

265
00:15:59,660 --> 00:16:04,130
&rlm;مذهل. لا أحد يستطيع إيقاف أخي "كيويتشيرو"
إذا اندفع،

266
00:16:04,210 --> 00:16:06,290
&rlm;لكنه هدّأه بالكلام وحده!

267
00:16:08,170 --> 00:16:11,010
&rlm;سأقدم تنازلاً وأقترح أمراً.

268
00:16:11,670 --> 00:16:14,050
&rlm;كنا نعتزم القبض على "مومو" أصلاً،

269
00:16:14,140 --> 00:16:16,470
&rlm;لكنني أريد إسكات كل التدخلات الخارجية.

270
00:16:17,220 --> 00:16:19,850
&rlm;سنقبض على "مومو" في أقصر وقت ممكن.

271
00:16:19,930 --> 00:16:24,060
&rlm;وعندها لن يتدخل أحد
في شؤون عائلة "يوزاكورا" مجدداً.

272
00:16:24,150 --> 00:16:28,020
&rlm;أقصر وقت؟ كم بالتحديد؟

273
00:16:29,320 --> 00:16:31,780
&rlm;ثلاثة أشهر؟
فلا شك أنكم ستحتاجون على الأقل إلى…

274
00:16:31,860 --> 00:16:33,610
&rlm;بل ثلاثة أيام.

275
00:16:34,200 --> 00:16:37,620
&rlm;سنقبض على "مومو يوزاكورا" خلال ثلاثة أيام.

276
00:16:37,700 --> 00:16:39,580
&rlm;لا اعتراض لديكم على ذلك بالتأكيد؟

277
00:16:39,660 --> 00:16:43,000
&rlm;يا أخي، من أي زاوية نظرت إلى الأمر،
فالمهلة قصيرة جداً…

278
00:16:43,080 --> 00:16:44,670
&rlm;هذا مشوق!

279
00:16:44,750 --> 00:16:46,460
&rlm;هيا، أرونا ما عندكم!

280
00:16:46,540 --> 00:16:48,500
&rlm;إن نجحتم، فسيكون ذلك رائعاً،

281
00:16:48,590 --> 00:16:50,300
&rlm;وإن أخفقتم، فسنطردكم،

282
00:16:50,380 --> 00:16:51,380
&rlm;"دينو دايماو جي"

283
00:16:51,460 --> 00:16:53,720
&rlm;وعندها سأبدأ
في اختراق أقراص "شيون" الصلبة!

284
00:16:53,800 --> 00:16:55,010
&rlm;أعجبتني الفكرة!

285
00:16:55,090 --> 00:16:56,090
&rlm;"الدكتورة (موزو)"

286
00:16:56,180 --> 00:16:59,260
&rlm;واسرق بيانات أبحاث "ناناو" أيضاً.

287
00:16:59,350 --> 00:17:02,180
&rlm;فقد قطع كل صلاته بي…

288
00:17:03,020 --> 00:17:07,650
&rlm;لا بدّ أنك ارتحت يا "فوران"
لنجاة عائلة "يوزاكورا" من العقاب.

289
00:17:07,730 --> 00:17:09,820
&rlm;فقد سمعت أنك توليت تدريب "كينغو".

290
00:17:09,900 --> 00:17:10,980
&rlm;"فوران"

291
00:17:11,070 --> 00:17:13,240
&rlm;لن أسمح لمشاعري الشخصية بالتدخل.

292
00:17:13,320 --> 00:17:16,200
&rlm;"كوسوموسو أكيزاكورا"

293
00:17:16,280 --> 00:17:18,620
&rlm;يا "فوتابا"، أأنت راضية بهذا حقاً؟

294
00:17:18,700 --> 00:17:20,120
&rlm;لا أمانع.

295
00:17:20,200 --> 00:17:21,540
&rlm;وأنا لا أمانع أيضاً، إذاً.

296
00:17:22,540 --> 00:17:25,620
&rlm;رائع! اتفقنا إذاً، صحيح؟

297
00:17:26,370 --> 00:17:28,750
&rlm;سأعلّق البتّ في الطلب

298
00:17:28,830 --> 00:17:31,840
&rlm;حتى انتهاء مهلة القبض
على "مومو يوزاكورا" بعد ثلاثة أيام.

299
00:17:32,340 --> 00:17:33,550
&rlm;"رسالة جديدة"

300
00:17:33,630 --> 00:17:36,510
&rlm;يا لحظكم السعيد!

301
00:17:36,590 --> 00:17:39,800
&rlm;يتلطف علينا بالمبادرة إلى التواصل.

302
00:17:39,890 --> 00:17:43,220
&rlm;إنها رسالة خاصة بنا،
نحن جواسيس الرتبة الذهبية.

303
00:17:43,310 --> 00:17:44,310
&rlm;"اعتذار إلى عائلتي"

304
00:17:44,390 --> 00:17:46,270
&rlm;إلى أفراد عائلتي الحبيبة…

305
00:17:46,350 --> 00:17:49,690
&rlm;أعتذر بصدق عما فعلته.

306
00:17:50,440 --> 00:17:54,690
&rlm;أردت فقط إيصال حبي لعائلتي عبر البث،

307
00:17:54,780 --> 00:17:57,660
&rlm;لكن من توقع أن ينقلب الناس
على عائلة "يوزاكورا" كلها؟

308
00:17:57,740 --> 00:17:59,200
&rlm;إنه يبكي.

309
00:17:59,280 --> 00:18:01,700
&rlm;مجنون كعادته.

310
00:18:01,780 --> 00:18:03,950
&rlm;بعض الجواسيس الذين خنقتهم

311
00:18:04,040 --> 00:18:07,540
&rlm;أخبروني بطلب طرد عائلة "يوزاكورا".

312
00:18:09,960 --> 00:18:12,960
&rlm;أفعل كل هذا لأجل عائلتي،

313
00:18:13,050 --> 00:18:16,800
&rlm;فإن سببت لها المتاعب، انقلبت خطتي عليّ.

314
00:18:16,880 --> 00:18:21,180
&rlm;يا جواسيس الرتبة الذهبية،
أنا شيء وأبنائي شيء آخر.

315
00:18:21,260 --> 00:18:25,640
&rlm;أوقفوا فوراً هذه الحملة الظالمة
على أفراد "يوزاكورا" الحاليين، رجاءً!

316
00:18:28,020 --> 00:18:30,310
&rlm;وإلا فسأقتلكم.

317
00:18:31,860 --> 00:18:34,230
&rlm;لطالما وُجد

318
00:18:34,320 --> 00:18:37,400
&rlm;من يسعون إلى عرقلة عائلة "يوزاكورا".

319
00:18:38,070 --> 00:18:39,570
&rlm;حتى في هذه اللحظة،

320
00:18:39,660 --> 00:18:42,410
&rlm;لعلكم تظنون أنكم تشاهدون هذا من مكان آمن،

321
00:18:42,490 --> 00:18:45,160
&rlm;لكنني أستطيع رؤيتكم أيضاً.

322
00:18:45,240 --> 00:18:48,660
&rlm;في ذلك اليوم، وُلدت من جديد.

323
00:18:48,750 --> 00:18:53,250
&rlm;لم يعد لأي منكم ملاذ آمن.

324
00:18:55,050 --> 00:18:58,010
&rlm;لن أسمح لكم بإيذاء

325
00:18:58,090 --> 00:19:00,550
&rlm;أبنائي، مهما حدث.

326
00:19:10,480 --> 00:19:12,810
&rlm;"إخوتي الصغار" الغنيون بـ"سوميناين"

327
00:19:12,900 --> 00:19:15,900
&rlm;كثفوا أجسادهم إلى كرة من الطاقة.

328
00:19:15,980 --> 00:19:17,440
&rlm;بعبارة أخرى، إلى قنبلة.

329
00:19:18,440 --> 00:19:22,950
&rlm;عقاباً لرابطة الجواسيس
على تدبير طرد عائلة "يوزاكورا"،

330
00:19:23,030 --> 00:19:25,700
&rlm;وضعت هذه داخل مقر الرابطة.

331
00:19:25,790 --> 00:19:28,580
&rlm;ستنفجر بعد نحو ساعة من الآن.

332
00:19:28,660 --> 00:19:31,670
&rlm;بهذا الحجم، كل ما يقع
في دائرة نصف قطرها 100 متر

333
00:19:31,750 --> 00:19:34,000
&rlm;سيُنسف بلا أثر. هذا كل ما في الأمر.

334
00:19:35,170 --> 00:19:39,550
&rlm;سأفجر هذه هنا لأريكم.

335
00:19:40,050 --> 00:19:41,680
&rlm;بحلول موعد بثي هذا الفيديو،

336
00:19:41,760 --> 00:19:45,390
&rlm;ستكون قنابل مماثلة
قد وُضعت بالفعل داخل الرابطة.

337
00:19:45,470 --> 00:19:47,520
&rlm;وُضعت بالفعل داخل الرابطة؟

338
00:19:47,600 --> 00:19:50,640
&rlm;أنا المتكلم. هل من مشكلة أمنية؟

339
00:19:50,730 --> 00:19:52,060
&rlm;ماذا يجري يا سيدي الرئيس؟

340
00:19:52,600 --> 00:19:55,360
&rlm;كل شيء يبدو طبيعياً هنا.

341
00:19:55,440 --> 00:19:56,440
&rlm;"الرئيس"

342
00:19:56,520 --> 00:19:59,320
&rlm;بالمناسبة، أريدك أن تصحبني
للشرب مجدداً ذات يوم!

343
00:20:00,860 --> 00:20:04,030
&rlm;إخوتي الصغار أكفاء.

344
00:20:04,120 --> 00:20:08,370
&rlm;أتساءل إن كان مجرد جواسيس
من الرتبة الذهبية قادرين على ردعهم.

345
00:20:11,540 --> 00:20:15,250
&rlm;والآن، ترقبوا اتصالي القادم.

346
00:20:15,330 --> 00:20:16,840
&rlm;إلى اللقاء.

347
00:20:20,800 --> 00:20:21,920
&rlm;"إعادة التشغيل"

348
00:20:22,010 --> 00:20:25,510
&rlm;هذا تهديد، لا اعتذار!

349
00:20:27,140 --> 00:20:29,430
&rlm;"مجرد جواسيس من الرتبة الذهبية"؟

350
00:20:29,520 --> 00:20:32,270
&rlm;أودّ تمزيقه إرباً إرباً في الحال.

351
00:20:32,350 --> 00:20:36,440
&rlm;يا للمصادفة.
وأنا أودّ إظهار شيء من حبي له.

352
00:20:36,520 --> 00:20:39,360
&rlm;فلنمزقه، بل لنقطعه إلى 100 قطعة!

353
00:20:39,440 --> 00:20:41,530
&rlm;تماشياً مع اسمه.

354
00:20:41,610 --> 00:20:44,240
&rlm;كيف تقولين شيئاً بهذه الفظاعة يا "شورا"؟

355
00:20:44,320 --> 00:20:46,410
&rlm;فقد أعجبني.

356
00:20:47,070 --> 00:20:48,370
&rlm;اهدؤوا جميعاً.

357
00:20:49,160 --> 00:20:51,910
&rlm;أولويتنا القصوى ضمان سلامة الرابطة.

358
00:20:52,540 --> 00:20:54,420
&rlm;فلنكتم أمر هذا الوضع

359
00:20:54,500 --> 00:20:56,630
&rlm;كي لا يستغل العدو أي فوضى.

360
00:21:00,630 --> 00:21:01,630
&rlm;حفرة؟

361
00:21:01,710 --> 00:21:04,760
&rlm;تنتشر مداخل الرابطة في كل أنحاء المدينة.

362
00:21:06,260 --> 00:21:08,430
&rlm;سأدخل أولاً، اتفقنا؟

363
00:21:11,310 --> 00:21:14,390
&rlm;تمتد الرابطة على مساحة شاسعة تحت المدينة.

364
00:21:14,480 --> 00:21:16,270
&rlm;خلف جدار في محطة المترو.

365
00:21:16,350 --> 00:21:17,350
&rlm;"عيادة الجواسيس"

366
00:21:17,440 --> 00:21:20,190
&rlm;أسفل مصعد المتجر مباشرةً.

367
00:21:20,270 --> 00:21:21,820
&rlm;وبالوعات في كل مكان.

368
00:21:22,860 --> 00:21:26,610
&rlm;أي أن الرابطة
تقع مباشرةً تحت المجتمع العادي.

369
00:21:27,280 --> 00:21:30,120
&rlm;إن وضع قنابل داخل الرابطة…

370
00:21:30,700 --> 00:21:34,210
&rlm;فهذا هجوم عشوائي يطال المجتمع كله.

371
00:21:34,290 --> 00:21:37,170
&rlm;إن لم نوقفه، فلن يسقط ضحايا فحسب…

372
00:21:37,250 --> 00:21:39,420
&rlm;بل ستتضرر سمعة مهنتنا،

373
00:21:40,090 --> 00:21:42,300
&rlm;ويصبح وجود الرابطة في خطر.

374
00:21:42,380 --> 00:21:44,970
&rlm;فهذا هو العقاب الذي يقصده.

375
00:21:45,050 --> 00:21:47,010
&rlm;يا له من حقير.

376
00:21:47,090 --> 00:21:48,970
&rlm;لا عجب أنه أبوك يا "كيو".

377
00:21:49,050 --> 00:21:50,050
&rlm;أتريد الموت؟

378
00:21:50,140 --> 00:21:52,520
&rlm;لم يُبلّغ عن أي متسللين.

379
00:21:53,390 --> 00:21:57,270
&rlm;إن لم يلاحظهم أحد رغم مظهرهم،

380
00:21:57,350 --> 00:21:58,980
&rlm;فهذا يعني أنهم يغيرون هيئاتهم.

381
00:21:59,810 --> 00:22:02,820
&rlm;إن تنكروا في هيئة موظفين أو جواسيس
ليحموا القنابل،

382
00:22:02,900 --> 00:22:05,740
&rlm;فسيسهل القبض عليهم
إن تركنا لهم حرية الحركة.

383
00:22:06,280 --> 00:22:09,030
&rlm;لذا سأدعهم يأتون ويذهبون كما يشاؤون.

384
00:22:09,110 --> 00:22:12,740
&rlm;إن رأيتم أي شخص مريب،
فهاجموه فوراً ثم اقبضوا عليه.

385
00:22:23,800 --> 00:22:26,550
&rlm;"ترتيب مكافأة هذا الشهر"

386
00:22:35,220 --> 00:22:37,230
&rlm;تبقت 57 دقيقة.

387
00:22:37,310 --> 00:22:40,060
&rlm;عملية التسلل إلى الرابطة تبدأ الآن.

388
00:24:16,910 --> 00:24:18,910
&rlm;ترجمة "محمود عبية"