1
00:00:06,310 --> 00:00:07,650
...ريتشل

2
00:00:08,250 --> 00:00:13,570
لا يليق شيء بمجرم أكثر
.من التلوي بألم

3
00:00:18,010 --> 00:00:20,330
.أشعر بأنّ عقلي مشوّش

4
00:00:21,800 --> 00:00:23,500
.لا يمكنني التنفس

5
00:00:24,020 --> 00:00:26,710
...إن متّ هنا

6
00:00:27,730 --> 00:00:29,550
فماذا سيحدث؟

7
00:00:32,560 --> 00:00:33,380
.أنت

8
00:00:33,550 --> 00:00:35,300
.ما زال الوقت باكرًا على موتك

9
00:00:36,590 --> 00:00:37,590
...زاك

10
00:00:38,780 --> 00:00:41,320
سنخرج من هنا أحياء، أليس كذلك؟

11
00:00:41,840 --> 00:00:44,770
أليس لديك هدف؟

12
00:00:46,160 --> 00:00:46,940
.نعم

13
00:00:50,570 --> 00:00:52,480
.يفترض أن تكون الآليّة قد حُلّت

14
00:00:58,010 --> 00:00:59,530
.هذه لم تكن موجودة من قبل

15
00:01:00,960 --> 00:01:01,910
.هناك

16
00:01:03,160 --> 00:01:04,000
ماذا؟

17
00:01:04,710 --> 00:01:06,840
.فُتحت قناة في السقف

18
00:01:07,350 --> 00:01:08,960
—ولكن حتّى أنت لا يمكنك الوصول

19
00:01:08,960 --> 00:01:10,460
هل يمكنك الحراك جيّدًا الآن؟

20
00:01:12,370 --> 00:01:14,770
!اذهبي إذًا

21
00:02:45,570 --> 00:02:47,400
لماذا تقفين ساكنة؟

22
00:02:47,400 --> 00:02:49,230
!تحققي ما إن كان يوجد شيء

23
00:02:53,480 --> 00:02:54,320
.حسنًا

24
00:03:00,480 --> 00:03:01,850
...هل هذا

25
00:03:08,000 --> 00:03:09,380
أوجدتِ شيئًا؟

26
00:03:13,300 --> 00:03:15,510
.علينا فتح الباب بسرعة

27
00:03:15,510 --> 00:03:17,900
هل يخترق السم جسدك؟

28
00:03:17,900 --> 00:03:18,630
!أعطيني

29
00:03:21,010 --> 00:03:23,550
!سحقًا! لِمَ لا تدخل

30
00:03:25,190 --> 00:03:26,260
...زاك

31
00:03:27,130 --> 00:03:28,580
...البطاقة

32
00:03:29,560 --> 00:03:30,980
.انطوت...

33
00:03:33,820 --> 00:03:35,290
!لا أصدّق هذا

34
00:03:35,290 --> 00:03:38,100
هذا مضحك للغاية لدرجة أنّي
!لا أستطيع التوقف عن الضحك

35
00:03:39,400 --> 00:03:41,710
!يجدر أن يفتح بما أنّنا وصلنا إلى هنا

36
00:03:41,710 --> 00:03:42,320
!افتحيه

37
00:03:42,520 --> 00:03:44,970
!لا يمكن ذلك بالطبع

38
00:03:44,970 --> 00:03:47,690
.على المجرمون أن يطيعوا القوانين

39
00:03:47,690 --> 00:03:49,290
أليس كذلك يا زاك؟

40
00:03:53,210 --> 00:03:56,190
.والآن... انتهى الوقت

41
00:03:56,190 --> 00:03:59,070
!حسنًا! انتهى الانتظار

42
00:03:59,070 --> 00:04:00,800
!حانت اللحظة التي كنتم جميعًا بانتظارها

43
00:04:00,800 --> 00:04:04,890
!وقت غاز كاثي السام الخاص

44
00:04:06,980 --> 00:04:10,270
!والآن، فلتموتا

45
00:04:13,870 --> 00:04:15,890
!تلك الوغدة

46
00:04:16,310 --> 00:04:17,050
...زاك

47
00:04:17,050 --> 00:04:17,940
ماذا؟

48
00:04:18,310 --> 00:04:22,900
لا يمكن تحقيق الوعد الذي قطعناه
إلّم نخرج من هنا، صحيح؟

49
00:04:23,060 --> 00:04:25,610
ماذا تقولين في هذا الوقت؟

50
00:04:25,900 --> 00:04:26,940
.أجبني

51
00:04:27,500 --> 00:04:31,600
وصولي إلى السطح هو
!الشرط الأدنى

52
00:04:32,120 --> 00:04:34,890
.حسنًا، سأحاول

53
00:04:34,890 --> 00:04:37,930
!أهناك طريقة للمحاولة في هذا الوضع؟

54
00:04:37,930 --> 00:04:39,590
.لا أدري ما إن كنّا سننجو

55
00:04:40,600 --> 00:04:42,170
ألا بأس بهذا مع ذلك؟

56
00:04:42,350 --> 00:04:44,380
!لا يهم. افعليها

57
00:04:45,770 --> 00:04:48,350
...إن كان الغاز قابلًا للاشتعال، فهذا

58
00:04:51,180 --> 00:04:51,720
!سحقًا

59
00:05:09,740 --> 00:05:12,370
.قمتِ بتفجيره وتطييره

60
00:05:12,370 --> 00:05:14,640
!أريناها الويل

61
00:05:14,640 --> 00:05:16,460
!فلتمت بغيظها

62
00:05:19,980 --> 00:05:21,420
.أنتِ، تماسكي

63
00:05:22,670 --> 00:05:25,010
هل كنت ذات فائدة لك؟

64
00:05:25,160 --> 00:05:26,130
.نعم

65
00:05:26,130 --> 00:05:29,850
كنت سأموت من غاز تلك
.المرأة الوغدة السام لولاك

66
00:05:31,470 --> 00:05:32,390
.فهمت

67
00:05:32,670 --> 00:05:35,040
.لا تموتي هنا

68
00:05:35,570 --> 00:05:36,250
.حسنًا

69
00:05:36,680 --> 00:05:37,900
.أنا بخير

70
00:05:39,820 --> 00:05:43,680
أنتما حيّان بعد كل ذلك؟
.هذا مفاجئ نوعًا ما

71
00:05:43,680 --> 00:05:45,150
.أثني لكما على ذلك

72
00:05:45,600 --> 00:05:48,780
.فتحت الباب لكما كهديّة مميّزة

73
00:05:49,100 --> 00:05:51,390
!هذا طبيعي، فقد خرجنا

74
00:05:51,390 --> 00:05:53,370
!أيّتها المتعالية

75
00:05:56,470 --> 00:05:59,450
.لنستمر... بالتقدم

76
00:06:08,360 --> 00:06:11,270
ألا يمكنك المشي أسرع؟

77
00:06:24,010 --> 00:06:26,070
!أتتوقعين أن أمشي بهذه الوتيرة؟

78
00:06:27,010 --> 00:06:30,240
.يمكنك... التقدم إن أردت

79
00:06:30,680 --> 00:06:32,890
!كنت لأفعل لو كان يمكنني

80
00:06:32,890 --> 00:06:36,390
!ولكنّي سأعلق فحسب إن كنت لوحدي

81
00:06:36,850 --> 00:06:37,660
.سأحاول

82
00:06:37,660 --> 00:06:39,110
!ماذا تعنين بسأحاول؟

83
00:06:39,110 --> 00:06:40,990
سواءً حاولتِ أم لا، فستموتين
!حين تموتين

84
00:06:40,990 --> 00:06:42,930
،ربما هذا ما تريدينه

85
00:06:42,930 --> 00:06:45,860
!ولكن ماذا سيحدث لما أريده عندما تموتين؟

86
00:06:47,880 --> 00:06:50,120
.صـ...ـحيح

87
00:06:50,800 --> 00:06:53,930
.عليّ أن أحاول بجد أكبر إذًا

88
00:06:55,030 --> 00:06:59,640
إنّك ذكية، ولكنك تعيدين
.قول الشيء نفسه كالدمية

89
00:07:00,560 --> 00:07:02,150
ما يفترض أن أفعل؟

90
00:07:02,150 --> 00:07:04,610
!فكري بنفسك إن كنتِ إنسانة

91
00:07:06,730 --> 00:07:09,380
،أعتقد أنّه إن انتظرت بضع دقائق

92
00:07:09,380 --> 00:07:11,690
.فسأتمكن من المشي باستقامة ثانيةً

93
00:07:11,690 --> 00:07:13,060
حقًّا؟

94
00:07:17,760 --> 00:07:19,980
.لن تصطادنا الكاميرات هنا

95
00:07:19,980 --> 00:07:21,540
.ارتاحي قليلًا

96
00:07:22,240 --> 00:07:23,030
.نعم

97
00:07:27,240 --> 00:07:29,970
...كدمية ناصعة البياض

98
00:07:33,050 --> 00:07:34,650
!هذا ممل

99
00:07:34,650 --> 00:07:38,190
لِمَ أنا منزعج؟

100
00:07:42,300 --> 00:07:43,020
!سحقًا

101
00:07:44,000 --> 00:07:45,400
.هذا ممل

102
00:07:53,000 --> 00:07:54,870
،وصل أطفال هذا الشهر

103
00:07:55,060 --> 00:07:58,190
ولكنّي لاحظت رائحة نتنة
.وعرفت أنّهم ميّتون بالفعل

104
00:07:58,190 --> 00:08:00,600
.ادفنيهم في الفناء إذًا

105
00:08:00,600 --> 00:08:02,400
هل يمكننا ذلك حقًّا؟

106
00:08:02,400 --> 00:08:07,040
لن يأتي أحد لرؤية بضعة
.أطفال رُموا هنا مقابل القليل من المال

107
00:08:07,440 --> 00:08:10,390
.مللت من دفن الجثث

108
00:08:10,390 --> 00:08:13,030
ما هذه الأنانيّة؟

109
00:08:13,560 --> 00:08:16,720
.صحيح، دعي ذلك الطفل يقوم بذلك

110
00:08:16,980 --> 00:08:20,440
لا شيء أفضل من التخلص
.من طفل بواسطة طفل آخر

111
00:08:27,440 --> 00:08:29,940
زاك؟

112
00:08:30,600 --> 00:08:31,480
ماذا؟

113
00:08:32,180 --> 00:08:33,030
هل استيقظت؟

114
00:08:35,240 --> 00:08:37,490
هل يمكنك التحرك الآن؟

115
00:08:38,290 --> 00:08:38,950
.نعم

116
00:08:38,950 --> 00:08:40,410
!لنذهب إذًا

117
00:08:41,950 --> 00:08:45,250
.حلمت حلمًا أغضبني بسببك

118
00:08:52,520 --> 00:08:55,130
ياه! أين كنتما؟

119
00:08:55,350 --> 00:08:56,390
!اصمتي

120
00:08:56,790 --> 00:08:58,330
.حسنًا، لا يهم

121
00:08:58,330 --> 00:09:00,760
...اسمع، سأقدّم لك العرض ثانيةً

122
00:09:01,150 --> 00:09:03,610
ألا تريد قضاء بقيّة
حياتك في زنزانة؟

123
00:09:03,610 --> 00:09:06,700
!أخبرتك أنّي لن أفعل ذلك

124
00:09:06,700 --> 00:09:08,420
.ياه، إنّك ممل

125
00:09:08,420 --> 00:09:12,980
لن صبح أداة أستغلها لمتعتي إذًا؟

126
00:09:12,980 --> 00:09:13,820
ماذا؟

127
00:09:13,970 --> 00:09:18,160
.سمعت أنّكما قطعتما وعدًا سخيفًا

128
00:09:18,390 --> 00:09:21,620
وعد تلقيان فيه رغباتكما
.على بعضيكما بكلّ أنانيّة

129
00:09:21,940 --> 00:09:24,170
يبدو وكأنّ كلاكما تريدان
،الشيء نفسه

130
00:09:24,170 --> 00:09:27,080
ولكن ألستما أداتان لبعضيكما فحسب؟

131
00:09:27,440 --> 00:09:32,050
ولكنّي أتساءل من منكما
.هو الأداة الحقيقيّة

132
00:09:32,270 --> 00:09:35,740
ماذا؟ ماذا تقصدين؟

133
00:09:35,740 --> 00:09:38,090
يا إلهي! ألا تعلم؟

134
00:09:40,960 --> 00:09:44,160
.ولكن لا بأس. أجد الأغبياء ظريفين أيضًا

135
00:09:45,540 --> 00:09:47,600
حسنًا، أرجوكما استمرا

136
00:09:47,600 --> 00:09:48,950
!بالاستمتاع بعقابكما

137
00:09:50,440 --> 00:09:51,650
!سحقًا لها

138
00:09:53,350 --> 00:09:54,420
زاك؟

139
00:10:01,890 --> 00:10:04,120
.دسته فحسب وحدث هذا

140
00:10:04,440 --> 00:10:08,490
هناك أشخاص أغبى مني
.لاختيارهم للزنزانة

141
00:10:09,730 --> 00:10:10,690
.لنذهب

142
00:10:14,130 --> 00:10:15,440
.لا تلقي له بالًا

143
00:10:15,960 --> 00:10:17,420
.سيموت على أيّ حال

144
00:10:19,300 --> 00:10:21,430
.إنّه ميّت بالفعل

145
00:10:21,660 --> 00:10:22,720
ماذا؟

146
00:10:22,720 --> 00:10:24,890
.فهمت. لنذهب

147
00:10:26,240 --> 00:10:27,050
.نعم

148
00:10:54,710 --> 00:10:55,840
!مرحبًا

149
00:10:55,840 --> 00:10:59,130
أهلًا بكم، ومبارك على
!وصولكما إلى هنا

150
00:10:59,130 --> 00:11:02,970
ما هذا؟ يبدو أنّك مفتون
.بمنزل الدمى يا زاك

151
00:11:03,420 --> 00:11:05,140
...وغدة

152
00:11:05,140 --> 00:11:07,480
كن ولدًا مطيعًا يا زاك، حسنًا؟

153
00:11:07,480 --> 00:11:11,850
لن تخرج من هنا إلى الأبد
!إن استمررت بالعنف

154
00:11:13,430 --> 00:11:17,360
،سأجعل أحدكما المدير
.بينما الآخر سيكون العامل

155
00:11:17,360 --> 00:11:20,740
أحدكما سيحل اللغز
.والآخر سيطيع ما أقوله

156
00:11:20,740 --> 00:11:21,820
هذا سهل، أليس كذلك؟

157
00:11:22,800 --> 00:11:24,800
إلى أين ينبغي أن نذهب؟

158
00:11:30,420 --> 00:11:33,750
.سأذهب إلى هنا. أنت ابق هناك

159
00:11:34,910 --> 00:11:36,990
.حسنًا، لنبدأ اللعبة

160
00:11:36,990 --> 00:11:38,760
.نهاية الوقت هي لحظة موتكما

161
00:11:38,920 --> 00:11:40,200
!ابدآ

162
00:11:47,730 --> 00:11:48,890
مسألة حسابيّة؟

163
00:11:53,090 --> 00:11:54,880
.ك هي 24

164
00:11:54,880 --> 00:11:56,460
.س هي 12

165
00:11:56,930 --> 00:11:58,780
.ص هي 266

166
00:11:58,780 --> 00:12:01,280
ماذا ينبغي أن أفعل؟

167
00:12:02,180 --> 00:12:03,610
.انتظر قليلًا

168
00:12:11,600 --> 00:12:15,790
ص" تشير للصفحة، و"س" للسطر"
...و"ك" للكلمة

169
00:12:16,180 --> 00:12:19,690
،الصفحة 266، السطر 24

170
00:12:19,690 --> 00:12:21,670
...والكلمة الثانية عشر

171
00:12:23,320 --> 00:12:24,380
".رجل"

172
00:12:27,470 --> 00:12:28,470
".يعيش"

173
00:12:31,010 --> 00:12:31,680
".أريكة"

174
00:12:31,680 --> 00:12:33,080
!ألم تنتهي؟

175
00:12:33,080 --> 00:12:36,540
ضع دمية الرجل على
.الأريكة في غرفة المعيشة

176
00:12:47,450 --> 00:12:49,580
!يا له من فيلم بغيض

177
00:12:49,580 --> 00:12:50,740
ما رأيك يا زاك؟

178
00:12:50,740 --> 00:12:52,300
!لا تتحدثي معي

179
00:12:52,300 --> 00:12:54,300
...هذا ممل

180
00:12:59,490 --> 00:13:02,840
.ضع دمية المرأة إلى يمين دمية الرجل

181
00:13:07,740 --> 00:13:09,140
.ليس إلى يساره، بل يمينه

182
00:13:09,140 --> 00:13:12,310
اليد اليمنى تمسك بها السكين
واليد اليسرى تمسك بها الشوكة، أليس كذلك؟

183
00:13:13,360 --> 00:13:15,510
!أغلقي فمك

184
00:13:18,360 --> 00:13:19,940
—زاك! يمكنك فعلها إن

185
00:13:19,940 --> 00:13:21,900
!قلت لك لا تتحدثي معي

186
00:13:24,540 --> 00:13:27,950
ضع الدمية ذات الضمادات
.أمام دمية المرأة

187
00:13:29,630 --> 00:13:30,980
أتسمع يا زاك؟

188
00:13:30,980 --> 00:13:32,240
!ماذا؟

189
00:13:32,900 --> 00:13:34,710
.الدمية ذات الضمادات

190
00:13:40,520 --> 00:13:44,980
.ضعها أمام دمية المرأة

191
00:13:52,140 --> 00:13:53,060
...ياه

192
00:13:53,060 --> 00:13:56,020
.إنّك تنجز ما يقولونه لك
!أحسنت يا زاك

193
00:13:59,910 --> 00:14:03,410
أعطِ الكيس البلاستيكي الأسود
.إلى الدمية المضمدة

194
00:14:06,150 --> 00:14:08,030
ما الخطب يا زاك؟

195
00:14:09,110 --> 00:14:11,320
.عليك فعل ما يملى عليك فحسب

196
00:14:11,320 --> 00:14:14,080
هذا ليس صعبًا، أليس كذلك يا زاك؟

197
00:14:15,000 --> 00:14:16,790
!مرأة وغدة

198
00:14:16,960 --> 00:14:17,500
!توقف

199
00:14:19,750 --> 00:14:22,790
لن تتمكن من الخروج من هنا
.أبدًا إن كسرته يا زاك

200
00:14:24,130 --> 00:14:25,740
—ضع الكيس في

201
00:14:25,740 --> 00:14:27,570
!أعلم

202
00:14:39,510 --> 00:14:42,060
.أعطِ المجرفة للدمية المضمدة

203
00:14:43,420 --> 00:14:46,100
.لا حاجة للتفكير

204
00:14:48,340 --> 00:14:51,320
.افعل ما أقوله يا زاك

205
00:15:09,140 --> 00:15:11,190
مـ-ما هذه النظرات؟

206
00:15:16,540 --> 00:15:17,640
.صحيح

207
00:15:17,640 --> 00:15:19,500
.هذا ما يفترض أن تفعله

208
00:15:21,460 --> 00:15:23,660
أتشاهد هذا الفيلم ثانية؟

209
00:15:23,660 --> 00:15:28,020
أحب رؤية الهانئين الأوغاد
.هؤلاء يُقتلون فحسب

210
00:15:28,020 --> 00:15:29,530
...يا لذوقك الكريه

211
00:15:29,530 --> 00:15:30,770
.اصمتي

212
00:15:30,770 --> 00:15:32,730
المهم، ماذا حدث لذلك الطفل؟

213
00:15:33,890 --> 00:15:35,500
،لم يرد فعلها في البداية

214
00:15:35,500 --> 00:15:37,790
.ولكنّه صمت وفعلها حين أمرته

215
00:15:37,790 --> 00:15:43,160
حتّى وحش كذاك يمكنه أن
.يكون أداة مفيدة إن تركتيه يعيش

216
00:15:43,160 --> 00:15:44,520
.فهمت

217
00:15:44,520 --> 00:15:46,210
.هذا مفيد بحق

218
00:15:46,360 --> 00:15:48,120
.ذاك الشيء أداة

219
00:15:48,120 --> 00:15:49,650
!إنّه أداة

220
00:15:53,720 --> 00:15:58,870
...أنا

221
00:16:00,900 --> 00:16:03,220
!حسنًا، هذا جيّد

222
00:16:03,220 --> 00:16:05,510
!يمكنك القيام بالأمر فعلًا يا زاك

223
00:16:05,510 --> 00:16:08,730
!كأداة مفيدة

224
00:16:08,940 --> 00:16:12,280
!اصمتي! لستُ أداة

225
00:16:13,410 --> 00:16:14,450
...زاك

226
00:16:14,450 --> 00:16:15,990
!هذا سيّئ

227
00:16:15,990 --> 00:16:18,420
...بعد أن بذلت جهدي وصنعته

228
00:16:18,420 --> 00:16:21,360
.ولكن لا بأس، لم أعد أحتاجه

229
00:16:21,360 --> 00:16:24,290
.تقدما إلى الغرفة التالية

230
00:16:26,270 --> 00:16:27,320
...زاك

231
00:16:31,950 --> 00:16:33,300
.إنّه منزعج

232
00:16:33,840 --> 00:16:37,720
ولكن كلّ ما فعلته كان اختيار
.الطريقة الأكفأ لحل اللغز

233
00:16:50,290 --> 00:16:52,860
!يسرني مقابلتكما شخصيًّا أخيرًا

234
00:16:54,570 --> 00:16:57,050
!أنتِ، أيّتها المرأة الساديّة الوغدة

235
00:16:57,050 --> 00:16:58,200
!ماذا تريدين الآن؟

236
00:16:58,570 --> 00:17:01,710
كيف لك أن تتحدث مع آنسة
جميلة مثلي هكذا؟

237
00:17:01,710 --> 00:17:02,910
.لا تتغيّر أبدًا

238
00:17:03,270 --> 00:17:05,960
ماذا علينا أن نفعل تاليًا؟

239
00:17:06,110 --> 00:17:10,330
.احقنا نفسكما وسيفتح الباب

240
00:17:11,360 --> 00:17:13,470
،واحدة تحتوي على فيتامينات

241
00:17:13,470 --> 00:17:17,740
!والأخرى تحتوي دواءً خطيرًا للغاية

242
00:17:17,740 --> 00:17:20,350
أيّ واحدة هي الفيتامينات؟

243
00:17:22,650 --> 00:17:25,310
.لن أخبرك. بل نسيت في الواقع

244
00:17:25,870 --> 00:17:30,240
،ضخّاها حتّى آخر قطرة
!ثم سأفتح الباب لكما

245
00:17:30,240 --> 00:17:34,490
!حسنًا إذًا، أتمنى لكما حظًّا موفقًا

246
00:17:43,380 --> 00:17:45,870
هل يمكنك معرفة أيّهما الخطيرة؟

247
00:17:45,870 --> 00:17:46,830
...لا

248
00:17:47,460 --> 00:17:49,830
.توقعت. أنا أيضًا لا أعرف

249
00:17:50,880 --> 00:17:52,800
هل أحقن نفسي بكلاهما؟

250
00:17:52,950 --> 00:17:53,850
!ماذا؟

251
00:17:53,850 --> 00:17:56,800
!أتعتقدين أنّك ستكونين بخير إن فعلتِ؟

252
00:17:57,890 --> 00:17:58,790
.لا أدري

253
00:17:59,390 --> 00:18:01,550
أم هل تريد أخذها بدلًا من ذلك؟

254
00:18:02,370 --> 00:18:04,930
!لن أفعل بالطبع

255
00:18:06,270 --> 00:18:08,680
.أنا سأفعل إلّم ترد

256
00:18:09,320 --> 00:18:11,150
.لكنّي لا أعرف ما سيحدث

257
00:18:11,150 --> 00:18:14,380
!وماذا سيحدث إن مُتِّ؟

258
00:18:14,380 --> 00:18:17,060
.لن يتحقق الوعد الذي قطعته لي

259
00:18:17,060 --> 00:18:19,810
.ولكن لا أعرف شيئًا عدا ذلك

260
00:18:21,590 --> 00:18:23,030
.آسفة

261
00:18:26,680 --> 00:18:30,440
.صحيح، نسيت. كنتِ تريدين الموت

262
00:18:30,440 --> 00:18:32,750
.يا لي من بليد لسؤالي هذا

263
00:18:33,440 --> 00:18:36,460
...بليد

264
00:18:36,630 --> 00:18:38,440
.تلك الوغدة كانت محقة

265
00:18:38,440 --> 00:18:41,850
.كلانا كالأدوات

266
00:18:42,070 --> 00:18:44,930
،لا أدري ما أقسمت به للرب

267
00:18:44,930 --> 00:18:48,940
،وأنتِ سترضين طالما مُتِّ
...ولكن بالنسبة لي

268
00:18:49,700 --> 00:18:51,670
...أخبريني

269
00:18:52,650 --> 00:18:57,360
هل يمكن أن تعلو محيّاك
تعابير جيّدة حين تودين الموت؟

270
00:19:03,100 --> 00:19:07,610
!رؤية تعابيرك الميّتة هذه تغضبني

271
00:19:07,610 --> 00:19:11,370
فكرة استغلالي كأداة من
!قِبل دمية مملة للغاية

272
00:19:12,790 --> 00:19:14,960
...ولكن الآن

273
00:19:16,410 --> 00:19:19,130
.سأدعك تستغلينني كما تريدين

274
00:19:19,130 --> 00:19:19,720
!توقف

275
00:19:26,010 --> 00:19:27,110
.لنذهب

276
00:19:34,470 --> 00:19:35,480
...زاك

277
00:19:42,490 --> 00:19:46,440
.سحقًا... رأسي يدور

278
00:19:48,420 --> 00:19:51,860
!فلتتوقف عن الظهور في ذهني

279
00:20:06,640 --> 00:20:07,350
...زاك

280
00:20:08,500 --> 00:20:09,650
هل أنت بخير؟

281
00:20:20,370 --> 00:20:22,030
...أريد قتلك

282
00:20:22,030 --> 00:20:24,720
!أريد قتلك! أريد قتلك
!أريد قتلك

283
00:20:24,720 --> 00:20:27,980
!أريد ذلك لدرجة أنّي أشعر أنّي سأجن

284
00:20:31,200 --> 00:20:33,000
.لا أمانع ذلك

285
00:20:33,000 --> 00:20:34,790
!حقًّا؟

286
00:20:35,850 --> 00:20:38,880
ولكن... ألا تمانع ذلك؟

287
00:20:38,880 --> 00:20:40,040
!ماذا؟

288
00:20:40,590 --> 00:20:43,830
.لم تخرج من هنا بعد

289
00:20:44,230 --> 00:20:45,160
...وأيضًا

290
00:20:46,440 --> 00:20:49,640
ما زال وجهي مملًا، أليس كذلك؟

291
00:20:49,640 --> 00:20:52,180
!أتحاولين تهديدي الآن؟

292
00:20:52,660 --> 00:20:53,650
.لا

293
00:20:54,300 --> 00:20:57,770
،أنت من أقسم للرب من أجلي

294
00:20:57,770 --> 00:21:01,070
.لذا فإنّه وعدك أيضًا

295
00:21:01,950 --> 00:21:03,720
.لن ألقي عليك أوامرًا الآن

296
00:21:04,180 --> 00:21:05,320
.لن أطلب معروفًا أيضًا

297
00:21:05,870 --> 00:21:08,160
...سأسألك هذا فحسب

298
00:21:09,450 --> 00:21:11,870
ألا تمانع هذا؟

299
00:21:23,780 --> 00:21:27,910
،مهما كان وجهك مملًا

300
00:21:28,470 --> 00:21:31,510
.يصعب عليّ كبح نفسي

301
00:21:31,760 --> 00:21:34,140
،لأنّي إن استطعت كبح نفسي

302
00:21:34,400 --> 00:21:38,150
.لما كنت في هذا الوضع منذ البداية

303
00:21:39,830 --> 00:21:43,670
.ولكنّي أكره الكذب

304
00:21:44,790 --> 00:21:47,280
تفهمين ما أعنيه، أليس كذلك؟

305
00:21:50,330 --> 00:21:52,090
أيّتها الفتاة المطيعة؟

306
00:21:53,040 --> 00:21:55,830
...لذا أرجوك

307
00:21:57,520 --> 00:22:01,080
.لا تتركيني أقتلك بعد