1
00:00:44,480 --> 00:00:45,440
!وجدناه

2
00:00:47,110 --> 00:00:49,150
!تعالوا! أسرِعوا

3
00:00:49,410 --> 00:00:51,320
!هيَّا لِنُسرِع

4
00:01:00,000 --> 00:01:01,370
...دكتور آنو

5
00:01:01,750 --> 00:01:03,190
.نعم، لا شكَّ في ذلك

6
00:01:04,130 --> 00:01:07,880
.يعني هذا أنَّ توقُّعاتِنَا بدأت بِالتحقُّق

7
00:01:08,300 --> 00:01:09,930
.يَجِبُ أن نُسرِع

8
00:01:09,930 --> 00:01:13,220
.ستكونُ هذِهِ حربًا لأجلِ استِمرَارِ البشريَّةِ

9
00:01:16,310 --> 00:01:22,310
لَهِيبُ الثُّريَا

10
00:01:16,310 --> 00:01:22,310
الفصل الثاني

11
00:01:37,160 --> 00:01:39,000
...مهلًا يا كي

12
00:01:40,400 --> 00:01:43,040
أتسمَعُنِي يا كي؟

13
00:01:43,970 --> 00:01:46,920
.ما الأمرُ؟ هذِهِ فُرصَتُكِ إِن أردتِ العودَةَ

14
00:01:47,310 --> 00:01:49,040
...ليس هذا مقصدي

15
00:01:49,040 --> 00:01:51,800
...أعجزُ عن التعبير

16
00:01:52,310 --> 00:01:54,550
ألا تُشارِكُني الشُّعُورَ أيضًا؟

17
00:01:55,950 --> 00:01:58,640
أيُّ شُعُورٍ؟

18
00:01:59,650 --> 00:02:03,270
...إحساسٌ غَريبٌ يعتري الجسد

19
00:02:03,990 --> 00:02:08,980
.أعجزُ عن وصفِه، وكأنهُ إتِصالٌ جِنسيٌ

20
00:02:08,990 --> 00:02:13,240
!وألم يُطلِعونا على كُلِّ هذا قبلَ أن نبدأ؟

21
00:02:13,230 --> 00:02:17,740
...لم أفهم ما قالوهُ بِشأنِ الهرمونات والاِقتران

22
00:02:17,740 --> 00:02:21,080
!ولم يتكلَّم أحدٌ عن هكذا شعور

23
00:02:23,340 --> 00:02:27,000
!لِهَذَا أخبرتُكِ بِألَّا تركبِ الديفاداسي

24
00:02:29,750 --> 00:02:32,220
.انظُرِي لِما آلت إليهِ آمالا

25
00:02:32,220 --> 00:02:36,640
!وهُناكَ فتياتٌ أُخرياتٌ في الاِحتياط، لم يكُن عليكِ فِعلُ هذا

26
00:02:36,650 --> 00:02:37,710
!لا تهزأ بي

27
00:02:39,090 --> 00:02:42,270
!لا أستطيعُ السماحَ لكَ بِرُكوبِ هذا الشَّيء مع بقيَّةِ الفتيات

28
00:02:42,530 --> 00:02:44,980
!لن يُرافِقُكَ سوايَ بعد الآن

29
00:02:46,860 --> 00:02:49,830
.تلقيتُ نفسَ تدريبِ بقيَّةِ الفتياتِ

30
00:02:49,830 --> 00:02:51,730
.لن أُنكِرَ ذَلِكَ

31
00:02:52,100 --> 00:02:54,490
!أرغبُ بِحمايةِ الأرضِ أيضًا

32
00:02:54,490 --> 00:02:55,740
!ألستَ كذلِكَ يا كي؟

33
00:02:57,870 --> 00:03:01,680
أيُعقلُ أنَّكَ فقط تُريدُ الاِختِلاءَ بِآمالا؟

34
00:03:01,680 --> 00:03:04,120
!طبعًا لا

35
00:03:05,350 --> 00:03:07,750
الاِتِّصَالُ المجدول، أَيصِلُكُم صوتي؟

36
00:03:07,750 --> 00:03:08,450
.أجل

37
00:03:08,450 --> 00:03:09,750
.نَسمَعُكِ

38
00:03:09,960 --> 00:03:12,460
.ينبغي أن نصِلَ وجهتنا خِلال ثلاثِ ساعاتٍ

39
00:03:13,220 --> 00:03:16,130
الوضعُ هُنا مُستتِبٌّ، ماذا عنكُم؟

40
00:03:16,130 --> 00:03:17,050
بِخير؟

41
00:03:17,160 --> 00:03:18,430
.بِخير

42
00:03:18,430 --> 00:03:20,100
...حتى أنا

43
00:03:20,100 --> 00:03:25,020
لِمَ لم تُنبِهِينَنِي بِغرابةِ شعورِ رُكُوبِ الديفاداسي؟

44
00:03:25,020 --> 00:03:25,770
ماذا؟

45
00:03:26,800 --> 00:03:30,110
أكُنتِ تُراقِبيننا طوالَ حديثِنَا؟

46
00:03:30,110 --> 00:03:31,270
.أ-أجل

47
00:03:31,880 --> 00:03:33,280
.ما أوقَحَكِ

48
00:03:33,540 --> 00:03:35,320
.حسنًا، اِنتهينا

49
00:03:38,380 --> 00:03:42,990
ألم يَكُن الأفضل أن تُصارِحُهُمَا مِن البداية؟

50
00:03:43,590 --> 00:03:47,370
أتقصِدِينَ اِعتِمادَ الديفاداسي على النَّشاطِ الجِنسي؟

51
00:03:48,500 --> 00:03:52,330
.حتى نحنُ نجهَلُ كيفيةِ نشاطِهِ حتَّى الآن

52
00:03:53,250 --> 00:03:56,840
.مَازالَ الأمرُ غامِضًا، سواءً الديفاداسي أو العدو

53
00:03:57,440 --> 00:04:03,350
.وَلَكِن هَذِهِ هي الطريقة الوحيدة لإنقاذ العالم، لا خيار آخر بيدِنا

54
00:04:04,010 --> 00:04:06,100
ما هذا؟

55
00:04:06,110 --> 00:04:09,060
.أسلِحتُنا ليست بِندٍّ لِهذا الشَّيء

56
00:04:09,080 --> 00:04:11,110
ألم يَصِل الديفاداسي بعد؟

57
00:04:11,110 --> 00:04:14,320
.يَستعيدُ العدو قُوَّتَهُ بينما نتحدثُ

58
00:04:14,320 --> 00:04:16,030
.ما لنا إلَّا الاِنتِظار

59
00:04:16,320 --> 00:04:19,290
!لِمَ لا نلجأُ إلى الأسلِحَةِ النووِيَّةِ؟

60
00:04:19,290 --> 00:04:20,320
!مرفُوض

61
00:04:21,260 --> 00:04:23,830
أترغَبُ بِأن يُفضيَ بِنا الحالُ كَبَقِيَّةِ الدُّوَلِ؟

62
00:04:23,830 --> 00:04:28,710
.السَّبِيلُ الوَحِيدُ في هزيمتِهِم هو استِخدامُ الديفاداسي

63
00:05:02,330 --> 00:05:04,530
ما كانَ هذا؟

64
00:05:05,500 --> 00:05:06,870
...آ-آمالا

65
00:05:09,340 --> 00:05:10,410
...مهلًا

66
00:05:10,410 --> 00:05:11,310
!غَيرُ مُمكِنٍ

67
00:05:13,680 --> 00:05:14,710
ما المُشكلة؟

68
00:05:16,480 --> 00:05:17,710
.آسِفة

69
00:05:18,520 --> 00:05:20,720
.مازِلتُ عاجزِةً

70
00:05:25,160 --> 00:05:26,060
.لقد وصلنا

71
00:05:27,350 --> 00:05:29,310
!القاعِدة جاهزة

72
00:05:28,560 --> 00:05:30,500
!سَنَخلَعُ الغِطَاءَ

73
00:05:30,500 --> 00:05:31,690
!أنزِلُوا المِرساة

74
00:05:31,690 --> 00:05:32,850
جاهِزُونَ يا رِفَاق؟

75
00:05:33,270 --> 00:05:35,130
سَنُكمِلُ طريقنا مَشيًا؟

76
00:05:35,130 --> 00:05:36,610
أمازِلنا بعيدين؟

77
00:05:36,770 --> 00:05:39,780
.أنتَ أقرب محطتينِ مِن آخِرِ مرَّةٍ

78
00:05:39,780 --> 00:05:41,830
.أوقِف شكواكَ وأسرِع

79
00:05:42,310 --> 00:05:42,860
.تبًا

80
00:05:43,710 --> 00:05:45,370
أجاهزةٌ يا ناوكي؟

81
00:05:53,720 --> 00:05:54,810
...مهلًا يا كي

82
00:05:55,320 --> 00:05:57,170
ألا تعلمينَ أنَّهُم يتنصَّتُونَ؟

83
00:05:57,170 --> 00:05:58,880
.لا يهمُّنِي

84
00:05:59,130 --> 00:06:02,720
أتعتقِدُ أنَّهُم أخبرونا بِكُلِّ ما يخُصُّ الديفاداسي؟

85
00:06:03,760 --> 00:06:06,640
.أعتقِدُ أنَّهُم يدسُونَ شيئًا عنَّا

86
00:06:06,640 --> 00:06:08,310
ماذا تقولين؟

87
00:06:09,350 --> 00:06:13,830
.التبت منطقة مرتفعة مُحتلة من الصين

88
00:06:09,350 --> 00:06:16,610
،قبل عِشرينَ عامٍ، أُكتُشِف الديفاداسي في التبت
.وأُسِّست السبيريت لِتبحثَ في شأنِهِ وتُصلِّحَهُ سِرًّا

89
00:06:17,340 --> 00:06:20,940
.أبرزُ شخصيَّةٍ كانتِ الرَّاحِلَ دكتور آنو

90
00:06:22,080 --> 00:06:24,450
...أجل، صُدِمنا أيضًا

91
00:06:24,450 --> 00:06:27,660
.كان الدكتور جدَّكَ يا كي

92
00:06:28,200 --> 00:06:28,740
!معقول؟

93
00:06:29,290 --> 00:06:30,870
.مُصادفةٌ مُذهِلة

94
00:06:31,200 --> 00:06:34,120
هذا مُذهِل يا كي، ألم تعرِف؟

95
00:06:34,130 --> 00:06:35,330
.أبدًا

96
00:06:35,710 --> 00:06:36,730
.انظُر هُنا

97
00:06:36,730 --> 00:06:40,210
.أُكتُشِفَ هذا أيضًا بِالمُوازاةِ مع استِخراجِ الديفاداسي

98
00:06:40,460 --> 00:06:44,380
.يُساوي حجمَ النِّظامِ الشَّمسيِّ ويتجِهُّ نحوَ الأرضِ

99
00:06:44,370 --> 00:06:47,220
.علميًّا يُعتبرُ ثقبًا أسودًا

100
00:06:47,610 --> 00:06:51,220
.وكما تعلمون جميعًا، إنَّه منشأُ العدُوِّ

101
00:06:52,640 --> 00:06:53,680
أَأَنتَ بِخير؟

102
00:06:53,680 --> 00:06:55,480
.أجل، ليست بِمُشكِلة

103
00:06:55,850 --> 00:07:04,030
اكتشف الدكتور آنو نبوءاتٍ وكتاباتٍ تُوضِّحُ
.ما سيجلِبُهُ هَذا المُجِسَّم الأسود مِن مصائِبٍ لِلأرض

104
00:07:04,030 --> 00:07:09,950
.وتمَّ إيجادُ الديفاداسي واستِخَراجُهُ لِحمَايَةِ كوكبِنَا مِنَ الغَزوِ

105
00:07:09,950 --> 00:07:15,330
.يتمتَّعُ الديفاداسي بنظامٍ مِجهرِيٍّ يَستنسِخُ وحِداتٍ صغيرة

106
00:07:15,330 --> 00:07:21,800
.مِمَّا يُتِيحُ لهُ إعادةَ إِنشاءِ قِطعَةٍ منَ جسدِكَ لِيُوفِّرُ لهُ مَصدرَ طاقةٍ عضويَّةٍ لوظائِفَه

107
00:07:21,810 --> 00:07:30,470
،يَحتاجُ العدوُّ أيضًا هَذِهِ الطَّاقَةَ العضويَّةَ من الإنس
.وأُثبِتَ ذَلِكَ بِأبحاثٍ أُجرِيت على مواقعٍ عديدةٍ

108
00:07:30,680 --> 00:07:33,180
...مع أنَّ كُلَّ نوعٍ يبدُو مُختلِفًا

109
00:07:33,180 --> 00:07:37,810
.إلَّا أنَّها تنتمي جميعُها لِنفسِ الفَصِيلَةِ وَتَعتَمِدُ على ذاتِ الطَّاقَةِ العُضوِيَّةِ

110
00:07:37,810 --> 00:07:43,780
.حُوِّل عديدٌ مِنَ النَّاسِ إلى مَصادِرِ طَاقَةٍ بِواسِطَةِ المِجهَرِيَّات الَّتي يُفرِزُونَهَا

111
00:07:43,790 --> 00:07:48,160
.وعلى هذا المُعدل سَتُستَهلَكُ البشرِيَّةُ أَجمع

112
00:07:48,160 --> 00:07:52,580
.لِهذا نَحتَاجُ مِنكُم استِعمَالَ الديفاداسي لإقصاءِ العدوِّ

113
00:07:53,120 --> 00:07:56,500
.كما سَمِعتُم، مَصيرُ الأرضِ يَعتمِدُ عَليكُم

114
00:08:03,210 --> 00:08:04,880
ماذا أصابها؟

115
00:08:04,880 --> 00:08:05,840
!مُصيبة

116
00:08:05,820 --> 00:08:06,750
أَهِيَّ بِخيرٍ؟

117
00:08:07,790 --> 00:08:08,650
...سَأَخُذُها

118
00:08:08,650 --> 00:08:10,340
!آمالا

119
00:08:12,590 --> 00:08:14,390
...م-مُحال

120
00:08:16,460 --> 00:08:18,640
.قالُوا أنَّهُ مُجرَّدُ إعياءٍ

121
00:08:20,130 --> 00:08:23,520
قُل، أَستركبُ الديفاداسي فِعلًا؟

122
00:08:23,520 --> 00:08:24,090
.أجل

123
00:08:24,700 --> 00:08:26,030
.فَهِمت

124
00:08:26,030 --> 00:08:29,610
.كونُهُ اكتِشَافُ جَدِّكَ يُعدُ سببًا إضافيًّا

125
00:08:32,140 --> 00:08:35,700
لكن ألا تظنُّ أنَّ الوضعَ باتَ غريبًا قليلًا؟

126
00:08:35,700 --> 00:08:38,830
...وكأنَّ الجميع... لا أدري

127
00:08:38,820 --> 00:08:42,040
...أتساءل إن كانت تِلكَ الفتاةُ أُغميَ عليها فحسب

128
00:08:42,690 --> 00:08:45,460
!ولِمَ تُخبِرِينَنِي بِهَذَا؟

129
00:08:45,840 --> 00:08:48,630
!لا داعيَ لِكُلِّ هذا الصُّراخ

130
00:08:48,630 --> 00:08:51,010
!حتى أنتَ بتَّ غريبًا يا كي

131
00:08:53,560 --> 00:08:54,760
!لا؟

132
00:08:55,270 --> 00:08:56,520
!ماذا دهاك؟

133
00:08:56,890 --> 00:08:58,800
!مهلًا، توقَّف

134
00:08:58,800 --> 00:08:59,850
!يا كي

135
00:09:02,970 --> 00:09:04,230
!لا

136
00:09:08,280 --> 00:09:08,780
!تمهَّلِي

137
00:09:08,780 --> 00:09:10,030
!إحذَرِي

138
00:09:10,980 --> 00:09:13,160
.ما مِن مشاكل، أشكُرُكُم

139
00:09:13,580 --> 00:09:15,370
.عودوا إلى مواقِعِكُم

140
00:09:15,370 --> 00:09:16,410
.عُلِم

141
00:09:21,630 --> 00:09:28,010
...واحد اثنان، واحد اثنان، واحد اثنان

142
00:09:31,720 --> 00:09:32,890
صُداع مُجددًا؟

143
00:09:34,610 --> 00:09:35,510
.أجل

144
00:09:35,510 --> 00:09:36,640
.رافِقنِي لِلحظة

145
00:09:37,740 --> 00:09:38,810
.إستلقِ هُنا

146
00:09:39,740 --> 00:09:41,190
.لا داعيَ لِكُلِّ هذا

147
00:09:41,190 --> 00:09:42,060
.لا تقلق

148
00:09:42,850 --> 00:09:44,440
.أودُّ فحصكَ

149
00:09:45,520 --> 00:09:46,440
.رجاءً

150
00:09:51,560 --> 00:09:53,360
...ع-عُذرًا

151
00:09:53,610 --> 00:09:54,780
.لا بأس

152
00:09:55,370 --> 00:09:56,780
.اعتَمِد عليَّ

153
00:10:13,580 --> 00:10:15,720
!أنتِ سريعةٌ جدًّا يا ناوكي

154
00:10:15,720 --> 00:10:17,680
.حتى أنتُنَّ سريعات

155
00:10:19,080 --> 00:10:20,640
.أعتذُر عَنِ البارحة

156
00:10:22,560 --> 00:10:24,270
أَكُنتَ فِي المُستوصِفِ؟

157
00:10:25,400 --> 00:10:26,560
.أ-أجل

158
00:10:27,260 --> 00:10:28,820
صُداعٌ مُجدَّدًا؟

159
00:10:29,070 --> 00:10:30,820
.صحيح

160
00:10:31,150 --> 00:10:32,890
.أعطَتنِي تاكاشينا-سان بَعضَ الدَّواءِ

161
00:10:33,960 --> 00:10:35,820
.استلقيتُ وَارتحتُ قليلًا

162
00:10:36,030 --> 00:10:37,200
.أشكُرك

163
00:10:37,780 --> 00:10:40,200
.أشعُرُ بِتحسُنٍ الآن

164
00:10:40,200 --> 00:10:41,450
.يَسُرُّنِي ذلك

165
00:10:43,040 --> 00:10:44,750
.لم أعُد مُستاءَةً

166
00:10:45,480 --> 00:10:46,530
!أراكَ لاحِقًا

167
00:10:49,610 --> 00:10:51,010
!أنا حقًّا أسِفٌ

168
00:10:53,380 --> 00:10:58,470
.مَنيُّ كي لم يتأثَّر مِن مِجهريَّاتِ الديفاداسي

169
00:10:59,160 --> 00:11:02,290
.يرى كي كَفردٍ مُميَّزٍ

170
00:11:02,290 --> 00:11:03,730
.كما توقَّعت

171
00:11:04,760 --> 00:11:09,900
