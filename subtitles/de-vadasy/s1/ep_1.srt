269
00:18:29,960 --> 00:18:31,590
لِمَ لا تُحضِر الديفاداسي؟

270
00:18:31,590 --> 00:18:33,430
ألم تُصلِح الذِّراع بالفعل؟

271
00:18:33,430 --> 00:18:35,840
...صحيح، ولكنَّ الطيَّارانِ لم يجهَّزَا

272
00:18:35,840 --> 00:18:38,180
!كانَ ينبغي علينا إيقافه المرَّةِ الماضية

273
00:18:38,180 --> 00:18:39,350
...لا لا، هذا لن

274
00:18:39,350 --> 00:18:42,810
!أسمحُوا لي بقيادةِ الديفاداسي بدلًا عن آمالا

275
00:18:44,480 --> 00:18:45,480
.مِن فضلِكُم

276
00:18:54,950 --> 00:18:56,320
أمُتيقنةٌ مِن هذا؟

277
00:18:57,070 --> 00:18:58,410
أجل

278
00:19:03,620 --> 00:19:06,330
.قد ينتهِي بِكِ الحالُ كَآمالا

279
00:19:09,710 --> 00:19:11,170
.أعرِفُ العواقِبَ

280
00:19:11,170 --> 00:19:11,840
!لا

281
00:19:12,550 --> 00:19:14,260
...قد تَمُوتينَ حتَّى

282
00:19:14,260 --> 00:19:15,840
.سأكُونُ بِخيرٍ

283
00:19:16,650 --> 00:19:19,970
.أساسًا أنتَ من سيتحكم بالديفاداسي يا كي

284
00:19:21,220 --> 00:19:22,970
...لِذَلِكَ أثِقُ بِأنِّي

285
00:19:22,970 --> 00:19:24,730
.سأكُونُ بِخيرٍ

286
00:19:27,900 --> 00:19:29,480
.تمَّ إدخالُ ب-2

287
00:19:32,820 --> 00:19:34,990
.اِكتملَ إدخَالُ ب-1

288
00:19:39,450 --> 00:19:41,950
ب-1، أَتسمَعُنِي يا كي؟

289
00:19:41,950 --> 00:19:42,490
.أجل

290
00:19:43,200 --> 00:19:45,620
.لكَ أن تبدأ الفحصَ الحِسِّيَّ

291
00:19:45,620 --> 00:19:46,870
.حسنًا

292
00:19:56,970 --> 00:19:59,180
.نتائِجُ الفحصِ الحسِّي والجسدي سليمة

293
00:19:59,180 --> 00:20:00,930
.نتائِجُ استِجابةِ الأعضَاءِ الداخِلِيَّةِ سليمة

294
00:20:04,890 --> 00:20:07,360
...كي

295
00:20:09,520 --> 00:20:10,230
...كي

296
00:20:10,230 --> 00:20:11,150
ناوكي؟

297
00:20:11,690 --> 00:20:13,360
أَتسمَعُني يا كي؟

298
00:20:13,360 --> 00:20:14,480
.أجل

299
00:20:14,480 --> 00:20:15,900
أَأَنتِ بِخير؟

300
00:20:15,900 --> 00:20:17,150
أ-أجل

301
00:20:18,030 --> 00:20:22,160
...ولكِن هذا الشُّعُور

302
00:20:35,420 --> 00:20:38,010
!ب-1 جاهِزٌ لِلإقلاع

303
00:20:38,010 --> 00:20:40,220
!فَضلًا فَعِّلَ الديفاداسي

304
00:20:44,140 --> 00:20:46,070
!ب-1، عُلِم

305
00:22:37,920 --> 00:22:41,760
.ظلَّ الديفاداسي يَنتَظِرُ

306
00:22:41,760 --> 00:22:43,880
.مُنذُ أَمَدٍ بَعِيد

307
00:22:43,880 --> 00:22:46,800
.مِن قَبلِ أن يبدَأَ أَيُّ شيءٍ

308
00:22:46,800 --> 00:22:49,890
.صَبَرَ لِلِقَاءِكَ

309
00:22:49,890 --> 00:22:52,390
.اِنتظرَ مُستقبلًا بَعِيدًا

310
00:22:52,390 --> 00:22:56,350
.اِنتظركَ كي تَقُودَنَا لِعَالمٍ جديد

311
00:22:56,350 --> 00:23:00,940
.اِنتظرَ بِجَانِبِي

312
00:23:00,940 --> 00:23:06,950
لَهِيبُ الثّريَا

313
00:23:00,940 --> 00:23:06,950
الفصل الثاني

314
00:23:01,400 --> 00:23:04,950
