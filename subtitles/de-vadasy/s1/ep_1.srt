190
00:12:50,870 --> 00:12:51,380
!مهلًا

191
00:13:19,280 --> 00:13:27,450
أعشاش ومواقِع نشر الآلات المِجَهريَّة

192
00:13:20,110 --> 00:13:25,280
...كما تعلمون جميعًا، مُنذُ ظهورِهِم على الأرضِ قبلَ عامٍ

193
00:13:25,280 --> 00:13:27,450
.أُحدِثت أضرارٌ واسعةٌ

194
00:13:27,570 --> 00:13:31,460
...واحد اثنين، واحد اثنين، واحد اثنين

195
00:13:31,540 --> 00:13:37,210
تفاصيلُ اليابان

196
00:13:31,960 --> 00:13:37,210
.مَازِلنا مُحاصرينَ كما كثيرٌ مِن مناطقِ الأرضِ

197
00:13:38,760 --> 00:13:40,130
!كُل

198
00:13:40,550 --> 00:13:45,260
.إلَّا أنَّنا مازِلنا نَجهلُ الكَثيرَ عن ماهيَّتِهِم

199
00:13:45,260 --> 00:13:48,270
رياضيات

200
00:13:45,390 --> 00:13:47,390
.إجباريٌّ، الدراسة إجباريَّةٌ

201
00:13:49,140 --> 00:13:52,560
.ما نعرِفَهُ هو أَنَّهم مِن خارِجِ الكوكب

202
00:13:53,150 --> 00:13:56,570
.ولاحظنا مُمارستهُم لِسلُوكٍ ما للتكاثُرِ

203
00:13:56,610 --> 00:13:58,480
.أداؤه رائِعٌ

204
00:13:58,480 --> 00:14:02,070
.يبدو أنَّ هرموناتِ كُلِّ البناتِ تأثَّرت

205
00:14:02,070 --> 00:14:03,700
.زادت مُعدلاتُ الاِستمناء

206
00:14:05,740 --> 00:14:08,120
أليسَ هذا ممنُوعًا؟

207
00:14:08,120 --> 00:14:12,580
ظاهِرَةُ وينتون وظاهِرَةُ فاندربيرج، وماذا أيضًا؟

208
00:14:08,120 --> 00:14:12,580
.كُلُّها تأثيراتٌ جِنسيَّةٌ مُختبرَةٌ على الفئِران، اقرأوا عنها في ويكيبيديا إن أردتُم

209
00:14:12,920 --> 00:14:15,170
.ظَاهِرَةُ كوليدج

210
00:14:15,170 --> 00:14:18,210
.لا أظُنُّ أنَّهم كالفِئرانِ والقِرَدَةِ

211
00:14:18,210 --> 00:14:20,960
.أتسائلُ إن تأثَّرتُ أيضًا

212
00:14:23,800 --> 00:14:27,550
!ي-يَجِب أن نُعطِيَ كي شيئًا مِثلَ المُكافأةِ

213
00:14:29,260 --> 00:14:31,980
...لا فارِقَ بين هذا والمدرسة

214
00:14:31,980 --> 00:14:33,810
!تمهَّل قليلًا

215
00:14:33,810 --> 00:14:35,810
.لا تأتِ إن لم ترغبي

216
00:14:37,820 --> 00:14:38,900
ما هذا؟

217
00:14:49,160 --> 00:14:50,870
...مفتوح

218
00:14:53,750 --> 00:14:55,620
.أحدهم هنا

219
00:15:08,970 --> 00:15:10,140
...مُستحيل

220
00:15:11,100 --> 00:15:12,140
ميتة؟

221
00:15:28,820 --> 00:15:30,990
من أنتِ؟

222
00:15:31,870 --> 00:15:32,790
...أنا

223
00:15:39,000 --> 00:15:42,590
!صباح الخير

224
00:15:48,760 --> 00:15:50,680
ألم ترحل؟

225
00:15:50,680 --> 00:15:51,910
.غيَّرتُ رأيي

226
00:15:53,680 --> 00:15:54,930
ما هذا؟

227
00:15:54,930 --> 00:15:56,390
.رَأسِي مُصدِّعٌ

228
00:15:56,390 --> 00:15:58,100
أأنت بخير؟

229
00:15:58,100 --> 00:15:59,060
.أجل

230
00:16:00,190 --> 00:16:03,480
.لقد قُرِرَ موقِعُكَ

231
00:16:03,530 --> 00:16:06,490
.رَافِقنِي إلى مقرِّ القِيَادَةِ

232
00:16:07,910 --> 00:16:09,490
...ليلةُ أمسٍ

233
00:16:10,280 --> 00:16:14,490
.أشعُرُ أنِّي حَلِمتُ بِشَخصٍ ما

234
00:16:15,500 --> 00:16:16,500
!ما هذا؟

235
00:16:17,580 --> 00:16:22,000
.يُمكِنُكُم إعتبارُهَا غِلافًا ضخمًا مُفرغًا

236
00:16:22,420 --> 00:16:25,010
ألا يجب أن نرتدي مِثلَهُم أيضًا؟

237
00:16:25,260 --> 00:16:28,010
.أُحضِرَ العُمَّالُ من الخارج

238
00:16:28,590 --> 00:16:31,010
.فَنحنُ المَعزولونَ لا هُم

239
00:16:31,800 --> 00:16:35,020
.لا تقلقا فمِنَ المُحالِ أن نتعرضَ لِلإشعَاعَات

240
00:16:38,100 --> 00:16:40,020
.هذا هو الديفاداسي

241
00:16:40,600 --> 00:16:42,520
...هذا

242
00:16:43,110 --> 00:16:46,440
.إنَّهُ روبوتٌ مُميَّزٌ تَدخُلانِ كِليكُما فيه

243
00:16:46,440 --> 00:16:47,280
كيف؟

244
00:16:47,280 --> 00:16:48,530
...أتعنينَ

245
00:16:48,900 --> 00:16:51,030
أنَّكِ ترغبينَ مِنَّا مُجابهةَ الأعداءِ بِهذا الشيء؟

246
00:16:51,620 --> 00:16:52,620
.صحيح

247
00:16:52,620 --> 00:16:53,530
...ولكن

248
00:16:53,530 --> 00:16:55,040
.مِثلَ الأنمي

249
00:16:55,910 --> 00:16:59,620
.صُمِمَ هذا الديفاداسي لِشريكين، أُنثى وذكر

250
