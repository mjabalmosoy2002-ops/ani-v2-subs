1
00:00:00,420 --> 00:00:03,340
!كانّا-سان، أتيتُ للّعب

2
00:00:05,190 --> 00:00:07,060
!سايكاوا هنا

3
00:00:08,040 --> 00:00:09,910
مرحباً يا سايكاوا

4
00:00:09,910 --> 00:00:11,190
!أهلاً بكِ

5
00:00:11,190 --> 00:00:13,870
!شكراً، يسرّني أنّني هنا

6
00:00:13,870 --> 00:00:14,600
ماذا؟

7
00:00:15,030 --> 00:00:16,860
أين أمّكِ يا كانّا-سان؟

8
00:00:17,220 --> 00:00:18,960
تتسوّق مع تورو-ساما

9
00:00:21,390 --> 00:00:23,090
...معنى هذا

10
00:00:23,090 --> 00:00:24,640
!لا يوجد سوانا؟

11
00:00:25,040 --> 00:00:29,240
ماذا؟ ماذا أفعل؟

12
00:00:29,240 --> 00:00:30,840
سأصعد سُلّم البلوغ

13
00:00:29,670 --> 00:00:30,840
سايكاوا؟

14
00:00:31,030 --> 00:00:33,340
!أهذه حكاية سندريلّا خاصّتي؟

15
00:00:33,340 --> 00:00:36,260
كـ-كانّا-سان، هل يمكنني استعمال دورة مياهكِ؟

16
00:00:36,260 --> 00:00:37,730
من هنا ثمّ على يمينك

17
00:00:44,630 --> 00:00:46,730
أنا متوتّرة جداً

18
00:00:49,880 --> 00:00:51,850
أنا آسفة

19
00:00:56,240 --> 00:00:57,870
!من تلك المرأة؟

20
00:00:57,870 --> 00:01:00,030
إيلولو. صديقة

21
00:01:03,330 --> 00:01:05,950
"إذاً ليس "نحن الاثنتان فقط

22
00:02:37,750 --> 00:02:39,710
منذ متى تعرفان بعضكما الآخر؟

23
00:02:39,710 --> 00:02:41,600
أعرفها منذ مدّة طويلة

24
00:02:41,600 --> 00:02:43,130
لكنّها لم تأتِ إلى هنا إلّا مؤخراً

25
00:02:43,130 --> 00:02:44,920
وهي تقيم هنا الآن

26
00:02:44,920 --> 00:02:46,400
!تقيم هنا؟

27
00:02:49,270 --> 00:02:50,540
،بالتفكير في الأمر الآن

28
00:02:50,540 --> 00:02:52,550
هناك كثير من الغموض يحيط بكانّا-سان

29
00:02:52,550 --> 00:02:55,530
،تناديها أمّها بكنيتِها، كوباياشي

30
00:02:55,530 --> 00:02:57,510
"وتنادي الخادمة بـ"ساما

31
00:02:57,750 --> 00:02:59,540
،أحياناً أشعر أنها شاردة

32
00:02:59,540 --> 00:03:02,370
لكنني أتفاجأ بذكائها وحماسها الرياضي

33
00:03:01,140 --> 00:03:04,800
سايكاوا، لنلعب بسرعة

34
00:03:05,940 --> 00:03:08,030
!أياً يكن! تبقى ظريفة

35
00:03:08,330 --> 00:03:11,070
أحضرتُ ورقاً معي

36
00:03:16,580 --> 00:03:17,970
...إيلولو-سان، هلّا

37
00:03:17,970 --> 00:03:19,420
انضممتِ لنا؟

38
00:03:19,420 --> 00:03:20,310
!انضمّي لنا

39
00:03:22,130 --> 00:03:23,650
لا داعي

40
00:03:28,740 --> 00:03:32,200
هل قلتُ كلاماً أزعجها؟

41
00:03:32,530 --> 00:03:34,220
خسرت

42
00:03:34,410 --> 00:03:36,480
سايكاوا، تعابير وجهكِ تكشف ذلك

43
00:03:38,110 --> 00:03:39,350
لعبة جزائية

44
00:03:39,620 --> 00:03:41,460
افركي بطني

45
00:03:49,130 --> 00:03:51,840
أليست هذه أقرب إلى مكافأة؟

46
00:03:54,720 --> 00:03:57,890
مرحباً، صادف وجودي في المنطقة

47
00:03:57,890 --> 00:03:59,680
أحضرتُ أكلات خفيفة

48
00:04:00,000 --> 00:04:01,690
كوباياشي وتورو ليستا في المنزل

49
00:04:01,690 --> 00:04:04,380
بئساً. أظنني سأنتظرهما إذاً

50
00:04:04,830 --> 00:04:07,060
يمكنكما تقاسم الأكلات الخفيفة مع سايكاوا-سان

51
00:04:07,060 --> 00:04:08,300
!مرحى

52
00:04:13,520 --> 00:04:14,540
مرحباً

53
00:04:15,520 --> 00:04:18,060
ألن تلعبي معهما؟

54
00:04:20,010 --> 00:04:21,280
لا يحقّ لي ذلك

55
00:04:22,810 --> 00:04:26,230
حاولتُ تدمير هذه المدينة

56
00:04:27,920 --> 00:04:30,100
لم أسامح نفسي بعد

57
00:04:31,420 --> 00:04:34,870
هل تتمنّين الرّجوع بالزمن إذاً وتجعلين
الأمر وكأنّه لم يحدث؟

58
00:04:35,410 --> 00:04:37,600
بمقدوري فعل هذا لكِ

59
00:04:39,410 --> 00:04:40,360
لا داعي

60
00:04:40,360 --> 00:04:41,870
لن يكون هذا تصرّفاً سليماً

61
00:04:42,400 --> 00:04:46,610
لا يمكنني مسح ما قالته كوباياشي لي

62
00:04:46,960 --> 00:04:48,870
هكذا إذاً

63
00:04:48,870 --> 00:04:50,300
لكن لا يحقّ لنا ذلك، صحيح؟

64
00:04:50,670 --> 00:04:52,880
،إذا أردتِ النظر للأمر من هذه الزاوية

65
00:04:52,880 --> 00:04:56,880
لا يوجد أي تنّين لديه الحقّ في التفاعل مع البشر

66
00:05:01,150 --> 00:05:03,910
لا يفلح الأمر كما فلح مع كوباياشي-سان

67
00:05:04,600 --> 00:05:07,510
حسناً، سأحاول التكلّم معهما قليلاً

68
00:05:08,650 --> 00:05:11,780
يمكنكِ أن تذهبي وتنتظري في دورة المياه

69
00:05:15,930 --> 00:05:18,310
ما أعنيه بصراحة هو أنّني أريد اللّعب

70
00:05:18,700 --> 00:05:21,650
،لن أكذب بشأن هذه المشاعر بعد الآن

71
00:05:22,260 --> 00:05:24,490
لكن ما فعلتُه كان حكاية مختلفة

72
00:05:25,250 --> 00:05:28,020
أريد تجنّب سؤال كوباياشي عن الأمر أيضاً

73
00:05:28,020 --> 00:05:30,920
لأنّها ستحلّ الأمر بسهولة غالباً

74
00:05:31,150 --> 00:05:34,430
خسرتُ من جديد

75
00:05:34,430 --> 00:05:35,450
،سايكاوا

76
00:05:35,450 --> 00:05:37,100
هل تخسرين عمداً؟

77
00:05:37,420 --> 00:05:40,160
!إطلاقاً

78
00:05:40,160 --> 00:05:42,740
لكن مللتُ من لعب الورق بمفردنا الآن

79
00:05:42,970 --> 00:05:45,790
أجل، لا يوجد سوانا

80
00:05:45,010 --> 00:05:47,880
!شعاع عليّ أن أتبوّل

81
00:05:52,010 --> 00:05:53,810
كانّا-سان، سأذهب إلى دورة المياه

82
00:05:53,810 --> 00:05:54,810
ثانية؟

83
00:05:55,670 --> 00:05:59,280
لماذا أرغب في الذهاب إلى دورة
المياه كثيراً اليوم؟

84
00:05:59,980 --> 00:06:01,000
!ماذا؟

85
00:06:01,000 --> 00:06:03,200
!أ-أنا آسفة

86
00:06:04,190 --> 00:06:06,080
!ماذا؟ لماذا؟

87
00:06:06,080 --> 00:06:07,890
...ماذا؟

88
00:06:07,020 --> 00:06:09,210
ما اسمكِ؟

89
00:06:10,470 --> 00:06:13,200
سايكاوا

90
00:06:13,940 --> 00:06:16,930
في الواقع، أردتُ اللّعب معكما قبل قليل

91
00:06:18,320 --> 00:06:21,010
،لكن كنتُ شخصية عنيفة

92
00:06:21,550 --> 00:06:23,270
لذا شعرتُ أنّ الأمر غير مناسب

93
00:06:23,270 --> 00:06:24,860
شخصية عنيفة؟

94
00:06:26,390 --> 00:06:28,500
حاولتُ تحطيم مُختلف الأشياء

95
00:06:29,580 --> 00:06:31,320
جانحة

96
00:06:32,980 --> 00:06:36,120
لا تحبّين الأشخاص العنيفين، صحيح؟

97
00:06:40,550 --> 00:06:42,910
في الواقع، أنا شخص عنيف بحدّ ذاتي

98
00:06:44,500 --> 00:06:45,660
حقّاً؟

99
00:06:45,660 --> 00:06:46,550
أجل

100
00:06:46,550 --> 00:06:49,070
غالباً ما أسيئ التصرّف عندما لا يعجبني شيئاً

101
00:06:50,050 --> 00:06:52,510
،في البداية لم أحبّ كانّا-سان أيضاً

102
00:06:52,510 --> 00:06:54,550
لذا فكّرتُ في قتلها

103
00:06:54,550 --> 00:06:55,880
...إ-إنّها

104
00:06:56,590 --> 00:07:01,640
لكنّها ظريفة، فقرّرتُ أن نكون صديقتين

105
00:07:01,640 --> 00:07:02,740
...إنّها

106
00:07:03,110 --> 00:07:05,320
،أنتِ ظريفة جداً يا إيلولو-سان

107
00:07:05,990 --> 00:07:07,650
لذا أتريدين أن نكون صديقتين؟

108
00:07:07,650 --> 00:07:09,780
!إنّها لا تفكّر إطلاقاً

109
00:07:10,880 --> 00:07:15,690
الأطفال ما زالوا في منتصف مرحلة
تعلّم تولّي المسؤوليّة

110
00:07:15,690 --> 00:07:18,910
بشكل سليم وتحمّل أعباء خطاياهم

111
00:07:19,450 --> 00:07:23,210
لكن بيئة إيلولو لم تُتِح لها هذه الفرصة أبداً

112
00:07:23,570 --> 00:07:26,650
كان عليها أن تغيّر ذلك أو ستنخدع

113
00:07:26,650 --> 00:07:30,570
كان عليها أن تتغيّر أو لن تتمكّن من
القتال إلى جانب البالغين

114
00:07:31,130 --> 00:07:35,040
لكن حالياً يمكنها نسيان كلّ ذلك والعودة

115
00:07:35,040 --> 00:07:38,210
لأنّ هناك بالغة ستخدعها بشكل عطوف هنا

116
00:07:38,500 --> 00:07:42,940
ينبغي أن تعود إلى كونها طفلة عديمة
المسؤوليّة لا تميّز الصّحيح من الخطأ

117
00:08:14,050 --> 00:08:15,590
عدنا

118
00:08:15,590 --> 00:08:17,740
لوكاو-سان هنا؟

119
00:08:17,740 --> 00:08:20,480
آسفة، اصطدمنا بإلما

120
00:08:20,850 --> 00:08:22,070
صه

121
00:08:27,850 --> 00:08:29,340
هل ينبغي أن أوقظهن؟

122
00:08:29,920 --> 00:08:32,160
لا، اذهبي وأحضري بطّانية

123
00:08:32,790 --> 00:08:35,690
يجدر بي الاتّصال بوالديّ سايكاوا-سان

124
00:08:38,410 --> 00:08:41,000
الحلقة 3

125
00:08:44,690 --> 00:08:47,170
كوباياشي-سان تراقبني

126
00:08:47,890 --> 00:08:50,050
إنّها تحدّق بي

127
00:08:50,420 --> 00:08:53,100
!يمكنني الشّعور بالشغف وراء نظرتها

128
00:08:53,360 --> 00:08:58,040
إذا ظلّت تحدّق بي كما لو أنّها
...تلعقني كلّي، فأنا سوف

129
00:08:58,040 --> 00:09:00,060
...سوف

130
00:09:00,060 --> 00:09:01,510
!تنهيدة؟

131
00:09:02,020 --> 00:09:03,900
ليس لكِ

132
00:09:03,900 --> 00:09:05,260
بل لزيّ الخادمة هذا

133
00:09:05,600 --> 00:09:07,090
زيّ الخادمة؟

134
00:09:07,090 --> 00:09:07,810
أجل

135
00:09:09,180 --> 00:09:13,100
،اشتريتُ زيّاً مشابهاً عندما كنتُ في الثانوية

136
00:09:13,580 --> 00:09:15,530
بإنفاق المال من راتبي الأوّل

137
00:09:16,070 --> 00:09:18,380
أردتُ التّباهي بذلك أمام عائلتي

138
00:09:18,800 --> 00:09:19,750
...ثمّ

139
00:09:20,060 --> 00:09:21,320
ثمّ؟

140
00:09:21,550 --> 00:09:23,130
قالوا أنّني لم أبدُ جميلة به

141
00:09:24,530 --> 00:09:26,670
كرِهَه الجميع وأخبروني بذلك

142
00:09:27,310 --> 00:09:30,630
منذ ذلك الحين أصبحتُ مجرّد مُتفرِّجة

143
00:09:31,270 --> 00:09:34,000
لذا بعد تلك المُحادثة بيني وبينها

144
00:09:34,280 --> 00:09:36,490
،قلتُ لنفسي

145
00:09:37,090 --> 00:09:40,750
لمَ لا نحاول تطريز زيّ خادمة يجعل"
"كوباياشي-سان جميلة؟

146
00:09:41,230 --> 00:09:44,490
لذا آمل لو أستفيد من حكمتكم جميعاً

147
00:09:45,330 --> 00:09:49,020
دائماً ما تكونين هائجة عندما يتعلّق
الأمر بكوباياشي-سان

148
00:09:49,340 --> 00:09:51,650
يسرّني أنّكم أتيتم جميعاً

149
00:09:52,020 --> 00:09:52,640
!لحظة

150
00:09:52,850 --> 00:09:55,020
!لم أستدعكِ أنتِ

151
00:09:55,480 --> 00:09:57,280
دعاني تاكيا-سان

152
00:09:57,500 --> 00:09:59,450
!تاكيا-سان

153
00:09:59,450 --> 00:10:01,690
لم يطاوعني قلبي أن أتركها لوحدها

154
00:10:02,020 --> 00:10:06,880
لديكِ عادة سيّئة وهي إخفاء إحراجكِ
بغضب وعدائيّة مزيّفين

155
00:10:06,880 --> 00:10:09,180
!لـ-لا لستُ كذلك

156
00:10:09,180 --> 00:10:11,370
أنا آسفة حقّاً

157
00:10:12,060 --> 00:10:15,200
ما إن استيقظتُ حتّى وجدتُ تورو قد جمعت الجميع

158
00:10:15,550 --> 00:10:18,050
هذا لؤم منكِ يا كوباياشي-سان

159
00:10:18,050 --> 00:10:19,770
نحن زميلتان

160
00:10:19,770 --> 00:10:23,550
كيف لي أن أتردّد في تفريغ وقتي لزميلة؟

161
00:10:23,880 --> 00:10:25,300
جورجي-سان

162
00:10:25,300 --> 00:10:27,840
!نعم، نعم. حسناً، سوف نبدأ

163
00:10:27,840 --> 00:10:30,680
في الوقت الحالي، هلّا رسمتُم أفكاركم؟

164
00:10:30,920 --> 00:10:32,180
!حسناً

165
00:10:38,000 --> 00:10:39,950
!هذا مدهش يا كانّا-سان

166
00:10:39,950 --> 00:10:43,230
!إذا اشتريتِ ملكيّة إضافيّة، فسوف تحتكرين المنطقة

167
00:10:43,720 --> 00:10:44,840
أحتكر؟

168
00:10:45,070 --> 00:10:46,860
!ستكونين ملِكة لها

169
00:10:47,160 --> 00:10:49,870
ستكونين قادرة على فعل ما تشائين
!بتلك المنطقة

170
00:10:53,010 --> 00:10:56,060
!يوجد بيت كبير في منطقة كانّا

171
00:10:56,980 --> 00:10:59,250
أعتذر، لكن هذه منافسة

172
00:10:59,460 --> 00:11:00,470
!شيطان

173
00:11:00,470 --> 00:11:02,210
!أنت عديم الرّحمة

174
00:11:00,690 --> 00:11:04,470
لستُ أفهم، لكنّها لعبة تستخرج أقذر ما فيهم

175
00:11:05,930 --> 00:11:06,480
!انتهيت

176
00:11:06,480 --> 00:11:08,570
كان هذا سريعاً يا إلما

177
00:11:08,570 --> 00:11:12,690
كوباياشي-سان رصينة وسريعة
،في إنهاء عملها في الشركة

178
00:11:12,970 --> 00:11:14,490
!لذا توصلتُ لهذه الفكرة

179
00:11:14,490 --> 00:11:17,520
حقيقة إدمانكِ على الدايفوكو تتجلّى بقوّة هنا

180
00:11:18,560 --> 00:11:20,240
ماذا؟ ليست جيّدة؟

181
00:11:20,240 --> 00:11:23,200
لكنّها سريعة الأكل ومليئة بالمكوّنات الغذائيّة

182
00:11:23,200 --> 00:11:27,450
من فضلكِ اذهبي والعبي مع الأطفال
في الغرفة الأخرى فحسب

183
00:11:27,740 --> 00:11:29,340
إنّه دوري تالياً

184
00:11:29,590 --> 00:11:32,460
هذا ظريف جداً، أليس كذلك؟

185
00:11:32,460 --> 00:11:35,180
لا أعتقد أنّ شيئاً كهذا سيليق بي، صحيح؟

186
00:11:35,180 --> 00:11:39,560
لم أكن أتخيّلكِ ترتدينه

187
00:11:39,560 --> 00:11:40,170
افعل ذلك

188
00:11:40,640 --> 00:11:41,620
تبّاً

189
00:11:41,620 --> 00:11:43,370
!انتهيتُ أيضاً

190
00:11:43,370 --> 00:11:44,350
!مُتعرٍّ كثيراً

191
00:11:44,540 --> 00:11:47,340
هذا ما يرتديه خدمُنا المحلّيون

192
00:11:47,590 --> 00:11:49,240
!إنّه عرقيّ للغاية

193
00:11:49,480 --> 00:11:50,390
هنا

194
00:11:51,040 --> 00:11:51,970
جورجي-سان

195
00:11:51,970 --> 00:11:55,730
أملي الحقيقيّ. ماذا ستقترح يا تُرى؟

196
00:11:56,020 --> 00:11:57,490
كوباياشي-سان

197
00:11:57,490 --> 00:11:58,600
نعم؟

198
00:11:59,900 --> 00:12:01,350
،نمط فُستان طويل

199
00:12:01,350 --> 00:12:05,810
ببضعة زخارف ولمسة دماثة بالرغم من البساطة

200
00:12:06,200 --> 00:12:08,740
أعتقد أنّ هذا نوعكِ المُفضّل؟

201
00:12:08,740 --> 00:12:10,410
أجل، هو كذلك

202
00:12:10,760 --> 00:12:13,780
لكن، ما هو زيّ الخادمة؟

203
00:12:14,750 --> 00:12:18,290
،صحيح أنّ التصاميم تغيّرت مع اختلاف العادات والعصور

204
00:12:18,290 --> 00:12:22,360
وأنّ الناس يستمرّون في صقل تلك التصاميم
كلّ يوم مع تغيّر زيّ الخادمات

205
00:12:22,780 --> 00:12:26,370
لكن لا يرتديها إلّا الخادمة

206
00:12:26,870 --> 00:12:30,640
فمن ليسَت خادمة لا تصبح خادمة
إذا ارتدت هذا الزيّ

207
00:12:32,060 --> 00:12:36,440
يصبح زيّ خادمة لأنّ خادمة ترتدي هذا الزيّ

208
00:12:37,490 --> 00:12:38,660
كوباياشي-سان

209
00:12:39,160 --> 00:12:40,830
أنا تلميذة أيضاً

210
00:12:41,430 --> 00:12:45,710
لا أستطيع ارتداء زيّ الخادمة الخاص
بي في كلّ الأوقات

211
00:12:45,910 --> 00:12:48,380
،لكن، مهما ارتديت

212
00:12:48,380 --> 00:12:51,780
،أجل، حتّى لو ارتديتُ زيّ المدرسة الخاص بي

213
00:12:51,780 --> 00:12:53,950
،ما دمتُ خادمة

214
00:12:54,260 --> 00:12:58,590
فحتّى ذلك الزيّ المدرسيّ يمكن أن يصبح
زيّ خادمة، ألا توافقينني؟

215
00:12:58,830 --> 00:13:01,470
أجل، هذا يعني أنّ زيّ الخادمة

216
00:13:01,470 --> 00:13:02,430
!يُرتدى بالقلب

217
00:13:02,790 --> 00:13:04,120
!إنّها روح الخدمة

218
00:13:05,930 --> 00:13:07,940
!نحن ننحرف عن المسار

219
00:13:07,940 --> 00:13:08,890
!تورو

220
00:13:08,890 --> 00:13:10,880
ليس عليكِ العودة

221
00:13:10,880 --> 00:13:12,390
!أنهينا جولة

222
00:13:12,790 --> 00:13:16,040
،بغضّ النظر، كنتِ تستهزئين بنا

223
00:13:16,040 --> 00:13:17,960
لنرَ ما الزيّ الّذي رسمتِه

224
00:13:18,360 --> 00:13:19,730
...في الحقيقة

225
00:13:19,730 --> 00:13:21,010
هذا مُريب بعض الشيء

226
00:13:21,510 --> 00:13:22,420
!أرينا

227
00:13:21,680 --> 00:13:23,820
!توقّفي يا منحرفة

228
00:13:24,920 --> 00:13:27,520
ماذا؟ إنّها فارغة تماماً

229
00:13:27,520 --> 00:13:29,530
لم تستطيعي التوصّل لأي فكرة؟

230
00:13:31,090 --> 00:13:32,140
...لا

231
00:13:32,620 --> 00:13:37,220
كنتُ أقول لنفسي حبّذا لو ترتدي كوباياشي-سان
زيّ الخادمة الخاص بي

232
00:13:40,580 --> 00:13:44,410
زيّكِ ظريف زيادة عن اللّزوم على أن أرتديه أنا

233
00:13:44,410 --> 00:13:46,090
حسناً

234
00:13:46,860 --> 00:13:48,710
لكن لا مشكلة

235
00:13:50,090 --> 00:13:53,800
استدعيتِ الجميع لأجلي

236
00:13:54,790 --> 00:13:55,490
سأرتديه

237
00:13:56,330 --> 00:13:57,990
...كوباياشي-سان

238
00:13:59,330 --> 00:14:01,940
!حسناً، ارتديتُه

239
00:14:04,470 --> 00:14:05,610
إنّه يليق بكِ

240
00:14:05,810 --> 00:14:07,580
أنتِ ظريفة يا كوباياشي-سان

241
00:14:07,840 --> 00:14:11,590
حسناً، حسناً، شكراً على الإطراء

242
00:14:11,590 --> 00:14:13,340
!لنلتقط صورة

243
00:14:13,340 --> 00:14:16,650
!صورة لكِ ولي كخادمتين مزدوجتين

244
00:14:17,240 --> 00:14:19,600
لنجمع الجميع معاً إذا كنّا سنلتقط صورة

245
00:14:19,600 --> 00:14:20,410
!ماذا؟

246
00:14:20,910 --> 00:14:23,070
حسناً جميعاً، اصطفّوا رجاء

247
00:14:23,070 --> 00:14:25,200
أنا بجانب كوباياشي-سان

248
00:14:25,200 --> 00:14:26,460
!هذا ليس عدلاً

249
00:14:26,460 --> 00:14:29,700
!أنتنّ، أنا قبلكُن

250
00:14:31,250 --> 00:14:32,430
تورو

251
00:14:32,620 --> 00:14:33,540
نعم؟

252
00:14:34,250 --> 00:14:36,540
أدركتُ شيئاً اليوم

253
00:14:36,540 --> 00:14:37,980
ما هو؟

254
00:14:37,980 --> 00:14:40,830
هل تتذكّرين ما قالته جورجي-سان؟

255
00:14:41,020 --> 00:14:42,000
أجل

256
00:14:42,000 --> 00:14:44,990
يصبح زيّ خادمة لأنّ خادمة ترتديه

257
00:14:44,990 --> 00:14:46,140
هذا يعني أيضاً

258
00:14:46,710 --> 00:14:50,220
مهما كان الزيّ الّذي يرتدونه، لا يكون زيّ خادمة
إذا لم يُرتدَ بواسطة خادمة

259
00:14:50,220 --> 00:14:51,820
يكون مجرّد كوسبلاي

260
00:14:52,410 --> 00:14:57,000
،لطالما كنتُ أرفض زيّكِ، لكن بعد ارتدائه غيّرتُ رأيي

261
00:14:57,000 --> 00:14:58,840
على الرّغم من أنّ الأمر كان محرجاً

262
00:14:59,710 --> 00:15:01,280
كان لا بأس به

263
00:15:02,090 --> 00:15:05,580
قلتُ لنفسي "يا للهول! هذا ما أردتُ
"ارتداءه إذاً، أليس كذلك؟

264
00:15:06,410 --> 00:15:11,690
لطالما ظننتُ أنّ الملابس الظريفة لن تليق
بي، لذلك كنتُ دائماً أرتدي ثياباً ذكوريّاً

265
00:15:12,030 --> 00:15:14,590
كنتُ أقلق بشأن ما إن ستليق بي أم لا

266
00:15:15,140 --> 00:15:18,890
لكن إذا أردتُ ارتداء زيّ خادمة، فينبغي إذاً
أن أرتديه دون أدنى اكتراث

267
00:15:18,890 --> 00:15:20,720
حينئذ تذكّرتُ شيئاً

268
00:15:21,390 --> 00:15:23,920
ما أردتُه هو الكوسبلاي

269
00:15:24,530 --> 00:15:27,340
،لكن لم أستطع أن أظهر بمظهر ظريف

270
00:15:27,340 --> 00:15:33,440
لذا لجأتُ للأناقة والدّماثة وأصبحتُ
أوتاكو خادمات مزعجة

271
00:15:33,910 --> 00:15:35,650
كوباياشي-سان

272
00:15:36,680 --> 00:15:38,100
لكن أتعلمين؟

273
00:15:38,100 --> 00:15:42,530
رؤيتكِ وعملكِ كخادمة

274
00:15:42,530 --> 00:15:47,740
جعلني أدرك أنّ الزيّ الذي ترتدينه
هو زيّ خادمات حقيقيّ

275
00:15:49,770 --> 00:15:53,490
دائماً ما تكونين صادقة عندما تتراجعين
عن الكلام الّذي قلتِه

276
00:15:53,490 --> 00:15:56,130
يُعجبني هذا الجانب غير المُنصف منكِ يا كوباياشي-سان

277
00:15:56,510 --> 00:16:01,130
لكن مُحال أن أتمكّن من قول هذا لكِ عندما
أتيتِ إلى هنا أوّل مرّة

278
00:16:01,570 --> 00:16:05,140
من فضلكِ استمرّي في القيام بالأعمال
المنزليّة يا تورو

279
00:16:05,450 --> 00:16:08,530
!ينبغي أن تناديني بـ"خادمة" هنا

280
00:16:12,680 --> 00:16:15,150
نفد مالي

281
00:16:15,150 --> 00:16:17,610
إيلولو، أنتِ تسرفين

282
00:16:17,610 --> 00:16:18,960
لا مشكلة

283
00:16:18,960 --> 00:16:23,380
ستمرّين من البنك قريباً، لذا ستحصلين
على مال أكثر حينها

284
00:16:23,560 --> 00:16:24,960
!حقّاً؟

285
00:16:25,310 --> 00:16:28,800
لكن رغم ذلك، يوجد شارع شوتا بعده

286
00:16:28,800 --> 00:16:32,600
أينما توقّفت سيتوجّب عليّ تسديد رسوم
الإيجار الباهظة

287
00:16:32,600 --> 00:16:35,780
اطمئنّي وتابعي برمي النّرد

288
00:16:36,470 --> 00:16:37,760
!شيطان

289
00:16:39,380 --> 00:16:41,300
فقدت إيلولو وعيها

290
00:16:42,350 --> 00:16:44,510
تورو-تشان، هل لديكِ أي هواية؟

291
00:16:44,720 --> 00:16:47,770
هواية؟ أنا خادمة

292
00:16:47,980 --> 00:16:51,450
لديّ... الكثير من وقت الفراغ

293
00:16:53,120 --> 00:16:55,470
ما هي هواياتكِ يا ساساكيبي-سان؟

294
00:16:55,470 --> 00:16:58,230
بتُّ مهتمّة بصنع الحلويات مؤخراً

295
00:16:58,510 --> 00:17:01,130
هل كان هذا سبب ذلك الصّوت الثّاقب؟

296
00:17:01,320 --> 00:17:03,830
!ماذا؟! أنا آسفة، هل كان مزعجاً إلى هذا الحدّ؟

297
00:17:04,570 --> 00:17:08,030
مع ذلك، لا أستطيع التفكير بأي شيء

298
00:17:08,330 --> 00:17:11,630
كنتُ مهتمّة بالسفر في الماضي

299
00:17:12,760 --> 00:17:14,040
الموسيقى؟

300
00:17:14,490 --> 00:17:17,070
إنها مشهورة بين البشر

301
00:17:18,320 --> 00:17:20,980
على ذكر الموسيقى، هُناك العدَميّ يانا-سان

302
00:17:21,490 --> 00:17:23,940
إذاً أتيتِ لتسأليني عن ذلك؟

303
00:17:24,190 --> 00:17:26,550
من فضلك علّمني ما الّذي يجعل الموسيقى ممتعة

304
00:17:26,750 --> 00:17:30,310
غالباً لأنّها تُشعل روحك وتجعل قلبك ينفجر

305
00:17:30,690 --> 00:17:32,450
تجعل قلبي ينفجر؟

306
00:17:31,260 --> 00:17:32,450
!انفجار

307
00:17:33,360 --> 00:17:36,520
سأعلّمكِ القليل، لذا يمكنك التجربة

308
00:17:36,520 --> 00:17:37,160
حسناً

309
00:17:46,010 --> 00:17:49,030
لستُ أفهم حقاً

310
00:17:49,030 --> 00:17:49,580
ماذا؟

311
00:17:49,580 --> 00:17:51,030
ما الأمر؟

312
00:17:51,030 --> 00:17:53,330
إنها جارحة. موهبتكِ جارحة

313
00:17:53,580 --> 00:17:55,570
جعلتُه يكتئب لسبب ما

314
00:17:55,570 --> 00:17:57,150
هذا أنت يا سوني-سان؟

315
00:17:57,650 --> 00:18:00,340
صنعتُ قطعة أخرى وأحضرتها

316
00:18:00,340 --> 00:18:03,150
!إنها متقنة الصنع أيضاً

317
00:18:03,670 --> 00:18:06,220
هل تستمتع بصنع أشياء كهذه؟

318
00:18:06,530 --> 00:18:08,010
أتريدين تجربة صنع واحدة؟

319
00:18:10,270 --> 00:18:11,510
انتهيت

320
00:18:13,950 --> 00:18:16,660
إنه تصميم احترافيّ مُتقن

321
00:18:16,660 --> 00:18:19,980
قلّما نجد من الناس يستطيعون صنع
شيء بهذه الجودة

322
00:18:19,980 --> 00:18:23,080
لكن لا أفهم ما الذي يجعلها ممتعة

323
00:18:23,360 --> 00:18:26,090
...جربتُ عزف الموسيقى أيضاً، لكن

324
00:18:26,530 --> 00:18:29,390
،صادف سماعي ذلك

325
00:18:34,280 --> 00:18:36,250
استطعت سماعها؟

326
00:18:36,530 --> 00:18:39,360
،غالباً لأنها كانت سهلة جداً بالنسبة لك

327
00:18:39,360 --> 00:18:41,760
لذا لم تكن هناك أي مساحة لصبّ مشاعركِ فيها

328
00:18:42,320 --> 00:18:47,590
من دون فضول وعاطفة لن ترضيكِ تلك الهواية

329
00:18:48,630 --> 00:18:50,530
هكذا هو الأمر إذاً؟

330
00:18:51,060 --> 00:18:52,170
عُدت

331
00:18:52,170 --> 00:18:53,390
أهلاً بعودتك

332
00:18:55,400 --> 00:18:58,010
كانّا، هل لديكِ أي هوايات؟

333
00:18:58,280 --> 00:18:59,320
هوايات؟

334
00:18:59,640 --> 00:19:01,810
المشي على هذا الخطّ الأبيض

335
00:19:02,200 --> 00:19:04,200
ما الممتع في ذلك؟

336
00:19:04,360 --> 00:19:05,450
أموت إذا سقطت

337
00:19:06,920 --> 00:19:11,010
هكذا إذاً. إنّه التدريب على القتال في أماكن ضيّقة

338
00:19:11,370 --> 00:19:14,330
!استخففتُ بغريزة كانّا كتنّينة

339
00:19:14,330 --> 00:19:16,010
يتوقّف هنا

340
00:19:19,100 --> 00:19:20,490
!هكذا! هكذا

341
00:19:20,490 --> 00:19:22,230
لا أستطيع الابتعاد هكذا

342
00:19:23,090 --> 00:19:26,570
لكن لا يمكن اعتبارها هواية

343
00:19:26,570 --> 00:19:28,890
إنها ممتعة عندما أفعلها مع سايكاوا

344
00:19:29,420 --> 00:19:31,090
أهلاً بعودتكما

345
00:19:31,090 --> 00:19:33,020
!هذا ليس عدلاً يا كانّا

346
00:19:33,020 --> 00:19:34,610
!أعطني بعض الدونات أيضاً

347
00:19:34,610 --> 00:19:35,840
لا

348
00:19:35,840 --> 00:19:37,440
!تورو

349
00:19:37,440 --> 00:19:39,360
تتكاسلين كلّ يوم

350
00:19:39,360 --> 00:19:41,410
من لا يعمل، لا يأكل

351
00:19:41,870 --> 00:19:44,830
إيلولو، هل لديكِ أي هوايات؟

352
00:19:44,830 --> 00:19:47,170
هوايات؟ النوم؟

353
00:19:47,440 --> 00:19:50,160
هذه ليست هواية بل أسلوب حياة

354
00:19:50,160 --> 00:19:51,410
أنتِ لئيمة

355
00:19:51,900 --> 00:19:53,310
لذيذة

356
00:19:54,530 --> 00:19:55,810
ما النكهة؟

357
00:19:55,780 --> 00:19:58,710
الهوايات صعبة

358
00:19:55,810 --> 00:19:57,430
شوكولاتة. وقطعتك؟

359
00:19:57,430 --> 00:19:58,700
قرفة

360
00:19:58,980 --> 00:20:01,470
نجمات الجماهير مشهورات في المدرسة

361
00:20:01,470 --> 00:20:03,690
تقديس نجمات الجماهير؟

362
00:20:03,690 --> 00:20:06,730
لكن لستُ مهتمّة بمثل هذه الأمور

363
00:20:09,590 --> 00:20:10,650
لا، لحظة

364
00:20:10,650 --> 00:20:11,740
!وجدتُها

365
00:20:19,400 --> 00:20:22,320
!كلّ ما أحتاجه هو أن تصبح كوباياشي-سان نجمة جماهير

366
00:20:27,160 --> 00:20:29,320
شكراً لعملك

367
00:20:30,000 --> 00:20:31,330
نعم، مرحباً؟

368
00:20:31,330 --> 00:20:32,590
!كوباياشي، كوباياشي

369
00:20:32,590 --> 00:20:33,930
!تعالي للمنزل بسرعة

370
00:20:33,930 --> 00:20:35,350
!فقدت تورو-ساما صوابها

371
00:20:35,350 --> 00:20:35,920
!ماذا؟

372
00:20:35,920 --> 00:20:37,050
!ماذا حدث؟

373
00:20:37,050 --> 00:20:40,540
،قبلة الحبّ، قبلة اللّعق

374
00:20:40,540 --> 00:20:43,520
!أحبّ كوباياشي-سان

375
00:20:43,770 --> 00:20:47,010
،قبلة الحبّ، قبلة اللّعق

376
00:20:47,010 --> 00:20:50,510
!أحبّ كوباياشي-سان

377
00:20:50,510 --> 00:20:52,270
!قبلة الحبّ اللّعق

378
00:20:53,220 --> 00:20:54,310
ما هذا؟

379
00:20:55,170 --> 00:20:59,180
ظلّت تورو-ساما تُنتج بضاعة كوباياشي وتستعرضها لنا

380
00:20:59,180 --> 00:21:02,070
كانت تغنّي لنا أيضاً

381
00:21:02,070 --> 00:21:04,990
!كوباياشي-سان! الهوايات ممتعة

382
00:21:06,750 --> 00:21:11,210
،كوباياشي-سان، كوباياشي-سان، كوباياشي-سان
!كوباياشي-سان، معاً للأبد

383
00:21:07,160 --> 00:21:11,200
لستُ أفضل بكثير عندما أثمل، لذا
لا يحقّ لي توبيخها هنا

384
00:21:14,690 --> 00:21:16,840
حقّقتُ المكاسب المستهدفة

385
00:21:16,840 --> 00:21:18,720
!كلّ ما عليّ الآن هو بلوغ الهدف

386
00:21:19,210 --> 00:21:21,330
سايكاوا، ماذا نفعل؟

387
00:21:27,500 --> 00:21:28,320
!ماذا؟

388
00:21:28,570 --> 00:21:29,880
!مستحيل

389
00:21:29,400 --> 00:21:30,540
هدف

390
00:21:29,880 --> 00:21:31,470
!هذه كانّا-سان التي عهدتها

391
00:21:31,470 --> 00:21:33,180
!كيف؟

392
00:21:33,880 --> 00:21:37,320
!نقلتُ كلّ ممتلكاتي إلى كانّا-سان

393
00:21:37,540 --> 00:21:39,820
!ماذا؟! هذا ليس منصفاً

394
00:21:39,820 --> 00:21:41,840
!كلّ شيء لي هو ملك لكانّا-سان

395
00:21:41,840 --> 00:21:43,980
!قلبي وجسدي وكلّ شيء

396
00:21:43,980 --> 00:21:45,840
!يا ملكتي

397
00:21:45,840 --> 00:21:47,330
!قدّسيني

398
00:23:19,920 --> 00:23:22,420
الحلقة القادمة

399
00:23:21,410 --> 00:23:23,430
ما هوايتكِ يا لوكوا-سان؟

400
00:23:23,430 --> 00:23:24,920
شوتا على ما أعتقد؟

401
00:23:24,920 --> 00:23:26,170
توقّعت

402
00:23:26,170 --> 00:23:27,920
وهوايتك ألعاب الفيديو، أليس كذلك يا فافنير-سان؟

403
00:23:27,920 --> 00:23:30,350
لا

404
00:23:28,510 --> 00:23:29,700
ألعاب الفيديو، صحيح؟

405
00:23:30,350 --> 00:23:31,540
بربّك

406
00:23:31,540 --> 00:23:33,240
قلتُ لا

407
00:23:31,970 --> 00:23:34,930
الحلقة 4

