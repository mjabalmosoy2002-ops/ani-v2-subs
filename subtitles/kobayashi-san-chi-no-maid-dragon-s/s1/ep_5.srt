1
00:00:06,380 --> 00:00:09,740
هلّا توقّفتُما عن الغضب من بعضكما الآخر
حالما تلتقيان؟

2
00:00:09,740 --> 00:00:12,230
!الذنب ذنبها لأنها رمقتني بنظرات غاضبة

3
00:00:12,230 --> 00:00:14,650
!ماذا؟! فطيرة التوفو المقلية لذيذة

4
00:00:14,840 --> 00:00:19,860
أعتقد لا يمكن إيقافكما وأنتما اللّتان حاولتما
قتل بعضكما الآخر حالما التقيتما

5
00:00:21,100 --> 00:00:24,040
لا، لم نحاول قتل بعضنا الآخر في البداية

6
00:00:24,330 --> 00:00:25,790
هذا صحيح

7
00:00:25,790 --> 00:00:27,390
لم نبدأ بذلك عندما التقينا أوّل مرّة

8
00:00:27,680 --> 00:00:31,380
كيف كان لقاؤكما الأوّل إذاً؟

9
00:02:05,030 --> 00:02:08,430
سمعتُ أنه قد تنشب حرب أهلية قريباً

10
00:02:08,430 --> 00:02:09,760
هكذا يبدو

11
00:02:09,980 --> 00:02:12,640
سيؤدّي النّزاع على الخلافة الملكيّة إلى أزمة أخيراً

12
00:02:12,940 --> 00:02:16,080
في هذه الحالة، سوف يستفيد البلد
المجاور من هذا الأمر

13
00:02:17,380 --> 00:02:19,320
!ما أحمق البشر

14
00:02:19,320 --> 00:02:22,060
كلّما فتحوا أفواههم، لا يتحدّثون سوى عن الصّراعات

15
00:02:19,960 --> 00:02:21,450
!هذه لي

16
00:02:21,450 --> 00:02:23,750
!وجدتها قبلك

17
00:02:22,490 --> 00:02:25,040
ألا ينوون الاستمتاع بحياتهم التافهة؟

18
00:02:25,040 --> 00:02:26,150
!إنها هنا

19
00:02:26,150 --> 00:02:28,670
!إنها كاهنة البحار المقدّسة

20
00:02:28,670 --> 00:02:29,460
كاهنة؟

21
00:02:29,460 --> 00:02:32,280
!أتت إلى بلدتنا أيضاً

22
00:02:32,280 --> 00:02:35,620
!أجل، نجونا الآن

23
00:02:35,850 --> 00:02:37,540
كاهنة البحار المقدّسة؟

24
00:02:37,540 --> 00:02:38,650
سمعتُ عنها

25
00:02:38,650 --> 00:02:43,600
باتت تتدخّل في الصراعات البشريّة وتحلّها مؤخراً

26
00:02:44,070 --> 00:02:46,740
،إذا كان الصّراع على ماء أو طعام

27
00:02:46,740 --> 00:02:48,460
فإنّها تنشئ بحيرات وتسبّب حصاداً وفيراً

28
00:02:48,460 --> 00:02:50,020
،وإذا كان الصّراع على نفوذ

29
00:02:50,020 --> 00:02:53,390
فإنها تُفقدهم رغبة القتال بقوّتها الإعجازية

30
00:02:53,720 --> 00:02:57,060
...لا بدّ وأنها إله أو شيء نظير له

31
00:02:57,060 --> 00:03:01,800
في كلّ الأحوال، تدخّلهم بالمجتمع البشري مُنافٍ للقواعد

32
00:03:06,160 --> 00:03:08,250
حسناً، لنرَ من تكون

33
00:03:21,390 --> 00:03:22,440
!تلك المرأة

34
00:03:22,770 --> 00:03:25,080
!لا هي إلهة ولا هي رسولة قدسيّة

35
00:03:25,080 --> 00:03:26,210
...أيُعقل أنّها

36
00:03:26,670 --> 00:03:28,680
!لكن إن كان كذلك، فهل تتحايل؟

37
00:03:38,530 --> 00:03:39,850
ماذا تعتقدين نفسكِ أنك تفعلين؟

38
00:03:40,370 --> 00:03:42,630
تنّينة تتنكّر بهيئة كاهنة إعجازيّة؟

39
00:03:43,230 --> 00:03:44,360
أنتِ تثيرينني على الضحك

40
00:03:44,870 --> 00:03:47,070
أوجّه نفس السؤال لكِ

41
00:03:47,070 --> 00:03:50,120
ماذا تفعل ابنة إمبراطور الزوال في قرية بشر؟

42
00:03:51,930 --> 00:03:54,990
اسمكِ تورو حسبما أذكر؟

43
00:03:55,680 --> 00:03:59,590
،أؤمن فحسب أنّ البشر لا ينبغي أن يقاتلوا بعضهم

44
00:03:59,590 --> 00:04:02,420
ومن الحماقة إراقة دماء بلا ضرورة

45
00:04:02,730 --> 00:04:05,330
لديّ القوّة لمنع ذلك، ولذا هذا ما أفعله

46
00:04:05,330 --> 00:04:09,630
إذاً أنتِ تؤدّين عملكِ بخلاف تنانين
الانسجام الكسولين الآخرين

47
00:04:11,140 --> 00:04:14,180
أنا واثقة أنّه قُدّم لكِ الكثير من الأعمدة البشريّة

48
00:04:14,590 --> 00:04:16,970
لستُ بحاجة لأي عمود بشريّ

49
00:04:17,200 --> 00:04:18,990
ماذا؟ لمَ لا؟

50
00:04:19,540 --> 00:04:22,850
لماذا يقول الجميع أنّ البشر طيّبو المذاق؟

51
00:04:23,250 --> 00:04:26,940
أنا متأكّدة أنّ هناك أشياء أشهى
بكثير في هذا العالم

52
00:04:27,240 --> 00:04:30,820
وأنا مؤمنة أنّ البشر هم من سيصنع هذه الأشياء

53
00:04:31,530 --> 00:04:32,670
هكذا إذاً

54
00:04:32,670 --> 00:04:35,160
إنّها غريبة الأطوار التي ذكرتها كيتزالكوتل

55
00:04:35,160 --> 00:04:36,760
هل أنتِ إلما إذاً؟

56
00:04:37,260 --> 00:04:40,090
وماذا يعني؟ أتطلبين الطعام كمقابل؟

57
00:04:41,510 --> 00:04:44,500
أأنتِ متأكّدة أنكِ لستِ مناسبة أكثر لفرقة الفوضى؟

58
00:04:44,770 --> 00:04:48,010
تبدين غريبة الأطوار بحدّ ذاتكِ

59
00:04:48,520 --> 00:04:54,100
لا أحد من تنانين الفوضى الذين التقيتهم
إلى الآن لديه الرّغبة في الحوار

60
00:04:55,730 --> 00:04:59,570
كنتُ أقيّمكِ فحسب قبل أن أدمّركِ

61
00:04:59,570 --> 00:05:01,920
تقيّمينني؟

62
00:05:02,540 --> 00:05:05,450
هلّا رافقتِني لبعض الوقت إذاً؟

63
00:05:05,640 --> 00:05:06,620
ماذا؟

64
00:05:08,020 --> 00:05:11,940
لنقيّم عالم البشر معاً

65
00:05:14,470 --> 00:05:17,450
إذاً سافرتما معاً لبعض الوقت؟

66
00:05:17,450 --> 00:05:18,990
...أجل، في الواقع

67
00:05:19,800 --> 00:05:22,590
سايرتُ صلاحها الذّاتي قليلاً

68
00:05:22,900 --> 00:05:25,500
لا بدّ وأنّني جُننتُ آنذاك

69
00:05:25,720 --> 00:05:28,800
إذاً كلتاكما كنتما تفحصان بعضكما الآخر حينها؟

70
00:05:29,140 --> 00:05:33,380
تتماشيان معاً دون أن تضغطا على نفسيكما
كشخصين يمتلكان معايير قِيم مختلفة

71
00:05:34,220 --> 00:05:37,270
أعتقد شيء من هذا القبيل؟

72
00:05:37,700 --> 00:05:40,970
كنتُ مهتمّة بإلما أكثر

73
00:05:40,970 --> 00:05:44,580
من أهداف بَني جلدتنا، بما أنّها كانت تفعل ما يحلو لها

74
00:05:45,210 --> 00:05:47,710
على الأقلّ، أعتقد هكذا كان الأمر في ذلك الزمان

75
00:05:47,710 --> 00:05:49,530
ثمّ ماذا حدث؟

76
00:05:49,950 --> 00:05:51,720
ببساطة

77
00:05:51,720 --> 00:05:53,830
...تفهّمنا بعضنا الآخر، لذا

78
00:05:53,830 --> 00:05:57,160
لم نستطع الاتّفاق تماماً، لذا بعد بضعة
...عقود، بطبيعة الحال

79
00:05:57,160 --> 00:05:58,530
حاولنا قتل بعضنا الآخر

80
00:06:00,290 --> 00:06:02,580
هذا غير طبيعيّ بالمرّة

81
00:06:09,360 --> 00:06:10,670
!لماذا؟

82
00:06:10,890 --> 00:06:13,450
!لماذا دمّرتِ القصر؟

83
00:06:13,450 --> 00:06:16,180
!كان من المُفترض أن يكون رمز السّلام

84
00:06:16,570 --> 00:06:18,180
سلام؟

85
00:06:18,450 --> 00:06:21,730
لأنّني لا أحبّ سلاماً يتطلّبكِ أنتِ

86
00:06:21,730 --> 00:06:22,840
!ماذا؟

87
00:06:23,350 --> 00:06:28,810
شُيّد هذا القصر لعبادتكِ كإله

88
00:06:29,160 --> 00:06:31,940
منه، نشأ دين يتمحور حولكِ

89
00:06:31,940 --> 00:06:36,230
وتبنّى مجتمعاً طبقيّاً مليئاً بالمفارقات

90
00:06:36,730 --> 00:06:41,390
مع الوقت سيؤدّي ذلك إلى صراع مع
أولئك الّذين يرفضون قبولكِ

91
00:06:42,020 --> 00:06:44,010
!كنتُ لأحرم ذلك

92
00:06:44,010 --> 00:06:47,270
أنتِ لا تصغين إلى ما أحاول قوله

93
00:06:47,910 --> 00:06:51,960
هل تنوين البقاء هنا مع هؤلاء البشر للأبد؟

94
00:06:52,430 --> 00:06:57,420
تحقّقين رغبات الآخرين وتتصرّفين كرمز عبادة للأبد؟

95
00:06:58,210 --> 00:07:02,190
أسألكِ عمّا إذا أردتِ أن تنجرّي نحو إطار عمل أولئك البشر

96
00:07:02,990 --> 00:07:07,990
في الوقت الّذي تعتقدين فيه أنّهم يعملون تحت إطاركِ

97
00:07:08,640 --> 00:07:11,340
!لقد انحرفتِ عن نواياكِ الأصليّة يا إلما

98
00:07:11,340 --> 00:07:12,730
!خاب أملي بكِ

99
00:07:13,140 --> 00:07:15,200
لا أتحمّل الخزيّ الّذي وصلتِ إليه

100
00:07:15,200 --> 00:07:18,450
لذا سأقتلكِ وأوقظ أولئك البشر من حلمهم

101
00:07:18,700 --> 00:07:20,870
!فليكن ذلك

102
00:07:20,870 --> 00:07:23,040
!حاولي أن تقتليني، إذا استطعتِ

103
00:07:27,300 --> 00:07:29,500
توقعتُ ذلك أيضاً

104
00:07:29,500 --> 00:07:31,750
أنّ الأمور لن تسير بسلاسة

105
00:07:32,270 --> 00:07:34,020
لكن هل كان بيدي حيلة؟

106
00:07:34,360 --> 00:07:38,780
!الطعام الّذي قدّموه لي كان لذيذاً جدّاً

107
00:07:45,580 --> 00:07:46,080
!...إنّها

108
00:07:48,570 --> 00:07:49,370
!...إنّها

109
00:07:49,370 --> 00:07:50,080
!قويّة

110
00:08:11,480 --> 00:08:15,570
وهكذا تفرّقنا بشكل نهائي

111
00:08:16,680 --> 00:08:19,600
يبدو هذا عظيماً وتافهاً في نفس الوقت

112
00:08:19,600 --> 00:08:24,260
في النهاية، عدتُ إلى قاعدة فرقة الانسجام

113
00:08:24,260 --> 00:08:26,060
ولم أعد أتدخّل بشؤون البشر ثانية

114
00:08:26,330 --> 00:08:29,050
وبالتالي انسجمتُما معاً جيّداً لدرجة الشّجار

115
00:08:29,940 --> 00:08:32,670
كوباياشي-سان، هل كنتِ تصغين لروايتنا للتو حقّاً؟

116
00:08:32,670 --> 00:08:33,930
!معها حقّ يا كوباياشي-سان

117
00:08:33,930 --> 00:08:35,780
!نحن على خلاف واضح

118
00:08:35,780 --> 00:08:37,440
حقّاً؟

119
00:08:37,440 --> 00:08:40,010
،كانت تورو سهلة الانقياد هنا

120
00:08:40,010 --> 00:08:44,040
وأنتِ كنتِ مشغولة تماماً بالعمل
على محاولة توجيه البشريّة

121
00:08:44,530 --> 00:08:47,080
ألا يعني ذلك أنّه لا يوجد سبب يدفعكما للقتال هنا؟

122
00:08:48,800 --> 00:08:50,610
كوباياشي-سان؟

123
00:08:50,610 --> 00:08:53,250
ألا تفهمين لمَ تجري هذه الأمور هكذا هنا؟

124
00:08:54,230 --> 00:08:56,750
!لأنّ الطعام لذيذ هنا

125
00:08:56,750 --> 00:08:59,180
!تورو وأنا شرِهتان

126
00:08:59,560 --> 00:09:01,280
!لن أنسجم معكِ أبداً حقّاً

127
00:09:01,280 --> 00:09:01,970
!ماذا؟

128
00:09:02,180 --> 00:09:04,180
!يُفتنكِ الطعام بسهولة دوماً

129
00:09:04,180 --> 00:09:08,520
!لأنّ تذوّق ثقافة البشر هو أفضل طريقة لفهم البشر

130
00:09:08,520 --> 00:09:11,140
!كلّ ما تريدينه هو حشو فمكِ

131
00:09:11,140 --> 00:09:14,590
!أنتِ بحدّ ذاتكِ مدمنة على طعام البشر

132
00:09:14,100 --> 00:09:17,780
إنّهما متقاربتان جدّاً لدرجة أنّهما يفهمان
،أفكار بعضهما الداخليّة

133
00:09:14,590 --> 00:09:16,300
!تطبخين طعاماً كلّ يوم

134
00:09:16,300 --> 00:09:17,780
وبزيّ الخادمة دوماً دون كلل أو ملل

135
00:09:17,780 --> 00:09:21,070
!وأنتِ دائماً بزيّكِ المكتبيّ حتّى في أيّام عطلتك

136
00:09:18,570 --> 00:09:21,790
ويتشاجران لطمس الأشياء التي لا يستطيعان قبولها

137
00:09:21,070 --> 00:09:23,520
!أنتِ بالذات لا يحقّ لكِ الكلام حول ذلك

138
00:09:23,520 --> 00:09:25,610
!هذا طبيعيّ بالنسبة لي

139
00:09:23,770 --> 00:09:27,040
لطالما أردتُ أصدقاء كهؤلاء

140
00:09:25,610 --> 00:09:27,050
!كيف له أن يكون طبيعيّاً؟

141
00:10:04,620 --> 00:10:07,000
الحلقة 5

142
00:10:33,810 --> 00:10:35,580
سأقتلكِ

143
00:10:35,580 --> 00:10:37,140
!ماذا؟

144
00:10:37,140 --> 00:10:38,890
!تتكاسلين كلّ يوم

145
00:10:38,890 --> 00:10:40,950
!لمَ لا تذهبين وتعملين قليلاً؟

146
00:10:41,200 --> 00:10:43,850
كنتُ أفكّر بمستقبلي

147
00:10:43,850 --> 00:10:44,760
أمهليني قرناً آخر فحسب

148
00:10:44,760 --> 00:10:45,950
!لا تفكّري في شيء بنطاق تنّين

149
00:10:48,170 --> 00:10:51,450
سأعينكِ في أعمالكِ حالياً إذاً

150
00:10:51,450 --> 00:10:53,130
!ماذا؟

151
00:10:53,130 --> 00:10:56,190
!مُحال أن تتمكّني من القيام بأعمال خادمة

152
00:10:56,190 --> 00:10:57,680
!لا تستهيني بالخادمات رجاء

153
00:10:57,680 --> 00:11:00,300
هذا ما تقوله كوباياشي لكِ دوماً

154
00:11:00,710 --> 00:11:02,890
لكن... عمل؟

155
00:11:02,890 --> 00:11:04,260
كوباياشي تفعل ذلك، صحيح؟

156
00:11:04,600 --> 00:11:05,800
أجل

157
00:11:05,800 --> 00:11:08,460
إنها تتقاضى أجراً لتغطية تكاليف طعامكِ أيضاً

158
00:11:08,460 --> 00:11:10,620
حسناً، سأعمل

159
00:11:10,620 --> 00:11:12,820
في نفس مكان كوباياشي إذاً

160
00:11:12,820 --> 00:11:14,030
!سأمحوكِ

161
00:11:14,260 --> 00:11:15,890
ماذا؟ أنتِ تخيفينني

162
00:11:15,890 --> 00:11:17,360
!سأمحو إلما أيضاً

163
00:11:17,360 --> 00:11:18,540
لماذا تتحدّثين عن إلما؟

164
00:11:21,060 --> 00:11:23,620
هل ترغبين في البحث عن مكان يوظّفكِ إذاً؟

165
00:11:23,970 --> 00:11:26,230
باستخدام الحاسب الشخصي أو قراءة إعلانات الصّحف؟

166
00:11:26,230 --> 00:11:29,580
لا، سأبحث وأقرّر بنفسي

167
00:11:31,260 --> 00:11:32,960
هل نذهب ونبحث؟

168
00:11:33,180 --> 00:11:35,510
هذه أوّل مرّة أمرّ فيها من هنا

169
00:11:35,510 --> 00:11:37,960
كنتُ دائماً ما أصعد من فوق السّطوح

170
00:11:37,960 --> 00:11:39,370
أنتِ كقطّة

171
00:11:40,040 --> 00:11:42,510
أرى أنّه من الأفضل أن تعيشي في البرّ

172
00:11:42,730 --> 00:11:46,650
حسناً، أعرف أنّكِ أمسيتِ تبذلين جهداً مؤخراً

173
00:11:46,990 --> 00:11:49,300
...تعلّمتِ حجب الإدراك

174
00:11:49,300 --> 00:11:52,450
وفي لحظة ما تمكّنتِ من إنشاء أيدٍ مناسبة

175
00:11:53,200 --> 00:11:54,470
بذلتِ مجهوداً طيّباً

176
00:11:54,880 --> 00:11:56,980
تروقينني بهذا الشكل بعض الشيء

177
00:11:57,320 --> 00:11:58,240
أحبّكِ

178
00:11:58,570 --> 00:12:01,370
لا تقولي كلاماً كهذا فجأة

179
00:12:01,580 --> 00:12:03,470
لكن ما زلتُ أحبّ كوباياشي أكثر

180
00:12:03,470 --> 00:12:04,620
!...حقيرة

181
00:12:04,620 --> 00:12:06,130
هيّا، هيّا

182
00:12:06,130 --> 00:12:07,980
ألم تجدي شيئاً تودّين تجربته؟

183
00:12:11,070 --> 00:12:13,780
اللّحم والسمك يحثّان رغبتي على التهامهم

184
00:12:13,780 --> 00:12:15,410
كما هو متوقّع من تنّينة فوضى زميلة

185
00:12:15,410 --> 00:12:17,430
الزهور تحثّ رغبتي على دوسها

186
00:12:17,430 --> 00:12:19,310
قدرنا هو أن ندمّر

187
00:12:19,540 --> 00:12:21,040
الكتُب تحثّ رغبتي على حرقها

188
00:12:21,040 --> 00:12:22,810
!تنّينة فوضى أصليّة

189
00:12:23,050 --> 00:12:25,480
لكن يُحرم علينا فعل كلّ هذه الأشياء هنا

190
00:12:25,480 --> 00:12:27,300
...صحيح

191
00:12:27,300 --> 00:12:30,040
أكره مثل هذه الأشياء الغريزيّة

192
00:12:30,040 --> 00:12:33,520
حسناً، نحن هنا لأنّنا رفضناها

193
00:12:33,520 --> 00:12:35,070
يمكنكِ فعل ذلك؟

194
00:12:35,070 --> 00:12:36,630
!بالطبع

195
00:12:36,630 --> 00:12:40,150
لكن هذا يعني أنّه لا يوجد مكان
تستطيعين العمل فيه

196
00:12:38,870 --> 00:12:41,260
!لنلعب

197
00:12:42,100 --> 00:12:43,980
!حسناً، لنلعب

198
00:12:43,980 --> 00:12:45,370
أتريدين أن نذهب معاً؟

199
00:12:45,370 --> 00:12:46,370
إلى أين؟

200
00:12:46,370 --> 00:12:47,460
!إلى التسوّق

201
00:12:47,460 --> 00:12:48,530
!هيّا بنا

202
00:12:48,530 --> 00:12:49,730
!هناك

203
00:12:51,150 --> 00:12:52,000
!أجل

204
00:12:52,420 --> 00:12:53,910
كان ذلك وشيكاً

205
00:12:52,680 --> 00:12:55,160
!مرحى! كانّا-تشان، سايكاوا-سان

206
00:12:55,500 --> 00:12:56,550
أنتما هنا

207
00:12:56,950 --> 00:12:58,910
تورو-ساما، إيلّولو

208
00:12:58,910 --> 00:13:01,210
ماذا؟ ما الّذي جاء بكما إلى هنا؟

209
00:13:01,210 --> 00:13:03,240
هذا سؤالي أنا. لماذا أنتما هنا؟

210
00:13:03,240 --> 00:13:05,870
هذا مكان مُلتقانا

211
00:13:06,080 --> 00:13:09,680
إذاً هاتان الفتاتان هما صديقتاكِ يا كانّا-تشان؟

212
00:13:09,680 --> 00:13:10,880
اسمي تورو

213
00:13:10,880 --> 00:13:12,270
وهذه إيلولو

214
00:13:12,530 --> 00:13:15,020
...كنّا نبحث عن عمل بدوام جزئي، لكن

215
00:13:19,220 --> 00:13:20,650
ماذا ينبغي أن نختار؟

216
00:13:20,650 --> 00:13:22,240
كلّها مذاقها واحد

217
00:13:22,560 --> 00:13:23,350
!حسناً

218
00:13:23,350 --> 00:13:25,620
كانّا-تشان، سيبدو هذا رائعاً عليكِ

219
00:13:25,620 --> 00:13:27,110
أنتِ أيضاً يا سايكاوا-سان

220
00:13:31,280 --> 00:13:32,480
متماثلتان

221
00:13:34,390 --> 00:13:36,100
لم أركِ من قبل

222
00:13:36,710 --> 00:13:38,370
هل أنتِ الأخت الصغرى للخادمة؟

223
00:13:38,880 --> 00:13:41,420
هذا متجركِ إذاً يا سيّدة آيدا؟

224
00:13:41,710 --> 00:13:44,250
إيلولو، هذه السيّدة آيدا

225
00:13:44,250 --> 00:13:47,500
كنّا كثيراً ما نلتقي في اجتماع رابطة الحيّ

226
00:13:47,810 --> 00:13:50,390
ماذا حدث لساقكِ؟

227
00:13:50,600 --> 00:13:53,320
أصيبت أثناء الهرولة

228
00:13:53,320 --> 00:13:56,710
كبرتُ الآن، لذا كنتُ أفكّر بإغلاق المتجر

229
00:13:56,710 --> 00:13:57,680
!مستحيل

230
00:13:59,370 --> 00:14:01,820
لكن كما ترون، لا أستطيع فحسب

231
00:14:03,920 --> 00:14:05,310
يوجد كثير من الأطفال هنا

232
00:14:05,790 --> 00:14:07,950
هذا لأنّنا محلّ حلويّات

233
00:14:07,950 --> 00:14:11,810
يأتي مُختلف الأطفال إلى هنا منذ عقود

234
00:14:12,210 --> 00:14:13,840
!هل يمكنني العمل هنا؟

235
00:14:15,190 --> 00:14:16,710
كم عمركِ؟

236
00:14:17,000 --> 00:14:18,720
إنّها في مثل سنّي

237
00:14:18,720 --> 00:14:19,950
مثل سنّك؟

238
00:14:20,560 --> 00:14:23,480
ماذا يجدر بي أن أفعل؟

239
00:14:23,480 --> 00:14:26,350
،كنتُ أفكّر في ترك حفيدي يدير المتجر

240
00:14:26,630 --> 00:14:28,430
لكن أعتقد سيكون من الأفضل توظيف شخص

241
00:14:28,430 --> 00:14:31,510
متحمّس للأمر عوضاً عن شخص متردّد

242
00:14:31,510 --> 00:14:33,250
ألتمس منكِ السّماح لها بالعمل كذلك

243
00:14:46,160 --> 00:14:47,400
!موافقة

244
00:14:48,470 --> 00:14:50,150
العمل بدوام جزئي في متجر حلويّات؟

245
00:14:50,780 --> 00:14:52,370
إنّه متجر أوبورو

246
00:14:52,730 --> 00:14:54,480
هل سمعتِ عنه يا كوباياشي؟

247
00:14:54,480 --> 00:14:56,880
إنّه في آخر حيّ التسوّق، صحيح؟

248
00:14:57,120 --> 00:15:01,480
تمّ توظيفها بفضل تأثيري

249
00:15:01,480 --> 00:15:03,450
،استعرضت عواطفها بمهارة عالية

250
00:15:03,450 --> 00:15:05,580
لدرجة شعرتُ أنّها مخيفة

251
00:15:05,580 --> 00:15:06,890
أطري عليّ أكثر

252
00:15:06,890 --> 00:15:08,560
هل هذا إطراء حقّاً؟

253
00:15:11,940 --> 00:15:14,550
هل ستكون الأمور بخير؟

254
00:15:16,510 --> 00:15:17,500
قلقة؟

255
00:15:18,110 --> 00:15:20,440
اخترتِه لأنكِ كنتِ مهتمّة به، صحيح؟

256
00:15:28,490 --> 00:15:32,450
بدأتُ عملي بمشاعر متردّدة ووجدتُ أشياء
تجعله عملاً مُرضياً أيضاً

257
00:15:33,160 --> 00:15:36,470
لذا أعتقد أنها طريقة ملائمة للبدء بعمل

258
00:15:38,600 --> 00:15:40,210
هكذا إذاً

259
00:15:41,270 --> 00:15:44,710
أنا خادمة لأنني مهتمّة بذلك أيضاً، وهو
!عمل مُرضٍ جدّاً

260
00:15:44,710 --> 00:15:46,490
!لذا اربتي عليّ

261
00:15:46,770 --> 00:15:48,020
إيلولو

262
00:15:48,020 --> 00:15:52,340
احرصي على الإصغاء للآخرين وتعلّمي مهامكِ جيّداً

263
00:15:52,930 --> 00:15:55,610
لا تكوني مثل هذه الخادمة

264
00:15:56,390 --> 00:15:59,310
!كـ-كوباياشي-سان

265
00:16:34,410 --> 00:16:35,930
ما الأمر يا تاكي؟

266
00:16:35,930 --> 00:16:38,940
أصابت جدّتي ساقها

267
00:16:38,940 --> 00:16:40,180
وترتّب عليك مساعدتها؟

268
00:16:40,180 --> 00:16:44,800
لا. يبدو أنّها وظّفت شخصاً، لذا طلبت منّي
أن أدعم هذا الشّخص كبداية فقط

269
00:16:45,110 --> 00:16:48,690
تلك العجوز العنيدة وظّفت شخصاً من خارج العائلة

270
00:16:48,690 --> 00:16:51,960
،أخذتُ معي زيّاً اليوم

271
00:16:52,300 --> 00:16:53,870
لكن انظر إليه

272
00:16:54,200 --> 00:16:56,190
مقاسه لرجل بالغ

273
00:16:56,580 --> 00:16:59,170
هل استأجرتْ رجلاً إذاً؟

274
00:16:59,170 --> 00:17:01,050
لا أدري أين التقت به

275
00:17:01,050 --> 00:17:03,060
إذا كان غريب الأطوار، سوف أطرده

276
00:17:03,290 --> 00:17:05,270
أنت رائع جداً يا تاكيتو-كن

277
00:17:05,270 --> 00:17:05,960
اصمت

278
00:17:07,060 --> 00:17:07,930
تبّاً

279
00:17:07,930 --> 00:17:09,840
كيف هو شكله يا ترى؟

280
00:17:10,810 --> 00:17:11,680
مرحباً

281
00:17:12,370 --> 00:17:13,850
!حـ-حجم بالغ

282
00:17:13,850 --> 00:17:14,980
!هذا جنون

283
00:17:16,790 --> 00:17:18,440
حفيد آيدا؟

284
00:17:18,750 --> 00:17:20,250
اسمي آيدا تاكيتو

285
00:17:20,250 --> 00:17:22,540
اسمي إيلولو. 16 عاماً

286
00:17:22,540 --> 00:17:24,080
هذا ما نقوله للناس

287
00:17:24,080 --> 00:17:25,310
نفس العمر؟

288
00:17:25,310 --> 00:17:28,090
بحسب الاسم... أنتِ أجنبيّة؟

289
00:17:28,090 --> 00:17:29,700
كيف التقيتِ بجدّتي؟

290
00:17:30,150 --> 00:17:31,240
،التقيتُها هنا

291
00:17:31,240 --> 00:17:33,690
طلبتُ منها أن تسمح لي بالعمل، فوظّفتني

292
00:17:33,690 --> 00:17:35,340
تقرّر الأمر بسهولة بالغة

293
00:17:36,080 --> 00:17:37,500
هذا مُريب

294
00:17:37,500 --> 00:17:40,850
لا بدّ وأنّ لديها دافع خفيّ للرغبة
في العمل هنا هكذا فجأة

295
00:17:40,850 --> 00:17:42,850
حسناً، ما سبب وجودك هنا؟

296
00:17:42,850 --> 00:17:45,320
أجل، زيّكِ

297
00:17:45,320 --> 00:17:46,860
مئزر وقميص أبيض

298
00:17:46,860 --> 00:17:48,250
ملابس؟

299
00:17:48,250 --> 00:17:49,170
حسناً

300
00:17:50,700 --> 00:17:53,590
!منحرفة؟! هل أنتِ منحرفة؟

301
00:17:53,590 --> 00:17:54,390
تذكّرت

302
00:17:54,390 --> 00:17:55,290
هذا معيب

303
00:17:55,290 --> 00:17:56,320
نسيت

304
00:17:56,320 --> 00:17:57,360
ولد مشاكس

305
00:18:00,130 --> 00:18:01,830
!بدّلي ملابسكِ في الخلف! في الخلف

306
00:18:01,830 --> 00:18:03,520
هكذا هو الأمر إذاً

307
00:18:04,230 --> 00:18:05,750
ماذا كان ذلك؟

308
00:18:05,750 --> 00:18:07,630
هل أتت من بلد يتّبعون هذه الثقافة؟

309
00:18:07,630 --> 00:18:08,960
!أريد الذهاب إلى هناك

310
00:18:08,960 --> 00:18:10,440
اسمع يا تاكيتو

311
00:18:10,440 --> 00:18:11,650
يكفي أن تناديني تاكي

312
00:18:12,020 --> 00:18:12,950
ما الأمر؟

313
00:18:13,220 --> 00:18:15,770
لا أستطيع إغلاق الأزرار

314
00:18:16,120 --> 00:18:18,200
أ-أنتِ مناسبة هكذا

315
00:18:18,440 --> 00:18:19,910
حسناً إذاً

316
00:18:20,190 --> 00:18:21,740
أنت منحرف، أليس كذلك؟

317
00:18:21,740 --> 00:18:23,360
!ماذا؟! ماذا تقولين؟

318
00:18:23,580 --> 00:18:24,600
أنت تحدّق

319
00:18:24,600 --> 00:18:26,720
!أ-أنا لا أحدّق

320
00:18:27,890 --> 00:18:31,130
سأعود إلى هنا، لذا اسأليني إن كان هناك
أيّ شيء لم تفهميه

321
00:18:33,820 --> 00:18:36,220
!إنّها غريبة أطوار من ناحية مختلفة

322
00:18:37,110 --> 00:18:41,140
أنا متفاجئ من أنّ جدّتي قرّرت توظيف
شخص غامض كهذا

323
00:18:41,430 --> 00:18:44,650
تبدو أغرب حتّى من شخص لديه دوافع
خفيّة وهذا ما يخيفني

324
00:18:45,270 --> 00:18:47,150
هل يمكنها أداء العمل أصلاً؟

325
00:18:47,150 --> 00:18:48,600
هذه من فضلك

326
00:18:48,600 --> 00:18:49,310
حسناً

327
00:18:49,540 --> 00:18:50,820
أعطيني تلك

328
00:18:51,530 --> 00:18:52,490
هذه؟

329
00:18:52,490 --> 00:18:53,310
أجل

330
00:18:53,740 --> 00:18:55,690
هل نبيع هذه بشكل مفرد؟

331
00:18:55,970 --> 00:18:57,440
أجل، هذا صحيح

332
00:18:58,000 --> 00:19:01,190
تحاول في الواقع أن تؤدّي عملها بأمانة

333
00:18:59,420 --> 00:19:00,900
!مرحى

334
00:19:01,990 --> 00:19:04,230
لحظة. حتّى أكثر ممّا كنتُ سأفعل؟

335
00:19:04,500 --> 00:19:07,030
ألهذا وظّفتها جدّتي؟

336
00:19:04,510 --> 00:19:08,010
مذهل! لمَ لديكِ صدر كبير كهذا؟

337
00:19:08,010 --> 00:19:10,960
رمية مُلتهبة سريعة من مضايقة جنسية
بريئة لطالبة ابتدائيّة

338
00:19:10,960 --> 00:19:11,890
كيف ستردّين عليها؟

339
00:19:11,890 --> 00:19:15,560
هذه أكياسي الناريّة. إنّها كبيرة وذلك
كي تحتوي النّار

340
00:19:15,560 --> 00:19:16,800
هكذا إذاً

341
00:19:16,800 --> 00:19:18,800
!أي ردّ تافه هو هذا؟

342
00:19:19,040 --> 00:19:20,830
هل هما ثقيلان؟

343
00:19:20,830 --> 00:19:21,760
ألا يسبّبان ألماً لكتفيكِ؟

344
00:19:22,060 --> 00:19:24,970
هل تريدين إمساكهما؟

345
00:19:25,220 --> 00:19:26,780
!انتظري! انتظري! انتظري

346
00:19:26,780 --> 00:19:28,140
!لا تفعلي أي شيء غريب

347
00:19:34,280 --> 00:19:36,310
هل أنت بخير يا تاكي؟

348
00:19:37,220 --> 00:19:38,310
!آ-آ-آسف

349
00:19:39,360 --> 00:19:41,820
صحيح

350
00:19:41,820 --> 00:19:42,910
فتى مشاكس

351
00:19:43,100 --> 00:19:45,170
!لماذا جاءت ردّة فعلكِ متأخّرة جداً؟

352
00:19:46,920 --> 00:19:48,280
!وداعاً

353
00:19:48,280 --> 00:19:49,280
!مع السلامة

354
00:19:49,660 --> 00:19:51,190
!إلى اللقاء

355
00:19:57,380 --> 00:19:58,850
أتعلم؟

356
00:19:58,850 --> 00:19:59,980
أحبّ الأطفال

357
00:20:00,420 --> 00:20:02,310
أحبّ اللّعب معهم

358
00:20:03,920 --> 00:20:06,470
لكن لا أستطيع اللّعب أثناء العمل

359
00:20:06,930 --> 00:20:10,270
لذا أردتُ العمل في مكان حيث يستمتع الأطفال

360
00:20:15,570 --> 00:20:17,510
حان وقت إغلاق المتجر

361
00:20:18,020 --> 00:20:19,110
حسناً

362
00:20:19,110 --> 00:20:20,740
أتريدين اللّعب قليلاً؟

363
00:20:20,740 --> 00:20:23,120
سأريكِ كيف تدوّرين اللّولب

364
00:20:23,120 --> 00:20:24,470
!ذاك الشيء

365
00:20:24,470 --> 00:20:25,690
!علّمني! علّمني

366
00:20:25,690 --> 00:20:26,800
!سوف أحضره

367
00:20:27,110 --> 00:20:28,750
إنها فتاة لطيفة

368
00:20:29,030 --> 00:20:31,080
يبدو أنّه لا حاجة للقلق بشأن جدّتي

369
00:20:32,660 --> 00:20:34,700
تاكي، أحبّك

370
00:20:34,700 --> 00:20:36,620
ماذا؟ أنا من ينبغي أن أقول لكِ ذلك

371
00:20:36,030 --> 00:20:37,820
من بعد كوباياشي

372
00:20:38,220 --> 00:20:40,750
من كوباياشي؟

373
00:20:41,390 --> 00:20:42,850
أحضرتُه

374
00:20:43,480 --> 00:20:44,900
راقبي جيّداً

375
00:20:51,230 --> 00:20:52,770
هل تعلمين؟

376
00:20:52,770 --> 00:20:56,070
يبدو أنّ البشر يتمنّون الأمنيات عند رؤية النجوم

377
00:20:58,030 --> 00:21:00,640
،يبدو أنّهم يصلّون للنجوم طلباً للسلام

378
00:21:00,640 --> 00:21:05,020
والحصاد الوفير، والسّعادة لأنفسهم ولعائلاتهم

379
00:21:05,550 --> 00:21:09,850
إذاً لا يهمّهم من يحقّق لهم الأمنيات
ما دامت تتحقّق؟

380
00:21:10,520 --> 00:21:12,780
يا لها من أنواع متدنّية حقّاً

381
00:21:13,530 --> 00:21:15,680
ماذا ستكون أمنيتكِ؟

382
00:21:15,680 --> 00:21:17,780
لو أنّه بالإمكان تحقيقها

383
00:21:21,800 --> 00:21:23,270
لا شيء في الواقع

384
00:21:26,190 --> 00:21:27,410
...بالنسبة لي

385
00:21:27,410 --> 00:21:30,700
ستتمنّين غالباً أن يتوفّر لكِ كثير من الطعام للأكل، صحيح؟

386
00:21:31,770 --> 00:21:33,550
تعرفينني خير معرفة

387
00:21:34,750 --> 00:21:36,980
لكن هذا ليس كلّ شيء

388
00:21:37,280 --> 00:21:37,980
ماذا إذاً؟

389
00:21:38,490 --> 00:21:41,900
سأتمنّى مشاركة طعامكِ اللّذيذ أيضاً

390
00:21:46,740 --> 00:21:48,230
افعلي ما يحلو لكِ

391
00:23:20,000 --> 00:23:23,040
الحلقة القادمة

392
00:23:20,750 --> 00:23:23,130
!استراحة غدائنا قصيرة جداً

393
00:23:23,130 --> 00:23:25,170
!ألا توافقينني يا كوباياشي-سان؟

394
00:23:25,170 --> 00:23:26,170
أتعتقدين ذلك؟

395
00:23:26,170 --> 00:23:29,130
،مؤخراً هناك خمسة أماكن أريد زيارتها للغداء

396
00:23:29,130 --> 00:23:31,100
!لكن يمكنني زيارة اثنين منهم فقط

397
00:23:31,100 --> 00:23:32,180
!الناس العاديّون لا يذهبون إلى عدّة أماكن

398
00:23:32,010 --> 00:23:35,010
الحلقة 6

399
00:23:32,180 --> 00:23:34,150
!أنا جائعة

400
00:23:35,720 --> 00:23:38,670
من الفاسد؟" لهذا الأسبوع"

401
00:23:38,670 --> 00:23:39,670
الجدي