1
00:00:24,610 --> 00:00:27,040
يا له من أمر قاسي الذي حدث هنا

2
00:02:15,880 --> 00:02:18,210
تسوكيتو" ، فالتنضم للشينسينغومي"

3
00:02:18,540 --> 00:02:21,440
أنضم إلينا للتكفير عن ذنوبك ولتعش

4
00:02:21,440 --> 00:02:23,090
لا تفقد الأمل في نفسك

5
00:02:23,090 --> 00:02:25,830
هنا حتى المجرم
بأمكانه أن يبدأ من جديد

6
00:02:25,830 --> 00:02:28,930
ويوجد هناك رفاق ، لن تكون لوحدك

7
00:02:30,470 --> 00:02:32,890
لا بأس يا أمي

8
00:02:33,450 --> 00:02:36,640
قريباً ستجتمع عائلتنا معاً مجدداً

9
00:02:38,390 --> 00:02:39,340
من هنا

10
00:02:39,940 --> 00:02:41,480
جميعاً لا داعي للفزع

11
00:02:41,480 --> 00:02:42,580
لا تقلقوا

12
00:02:42,580 --> 00:02:46,280
سوف نقوم نحن الشينسينغومي بحماية هذه المدينة

13
00:02:53,490 --> 00:02:55,660
هل أستيقظت؟

14
00:02:57,090 --> 00:02:59,960
يبدو بأني فشلت مرة أخرى في الموت

15
00:02:59,960 --> 00:03:06,570
تودو هيسكي" ، الناجي الوحيد"
من الشينسينغومي يأسف على كونه لا يزال حياً

16
00:03:07,580 --> 00:03:09,850
"هذا ما قاله لي "سوزوران-دونو

17
00:03:11,500 --> 00:03:12,670
ربما هذا صحيح

18
00:03:15,060 --> 00:03:16,470
المكان هادئ

19
00:03:16,470 --> 00:03:18,650
الجميع في الخارج

20
00:03:18,970 --> 00:03:22,080
"لقد كانت أوامر "إيشيبانبوشي

21
00:03:22,080 --> 00:03:26,880
بأن حماية هذه المدينة
هو عملنا كشينسينغومي

22
00:03:27,780 --> 00:03:28,570
هكذا إذن

23
00:03:33,040 --> 00:03:34,210
!مذهل

24
00:03:34,210 --> 00:03:35,200
!أنه مثل مصارع السومو

25
00:03:38,320 --> 00:03:42,390
شكراً لكم ، الآن سنتمكن من بناء
منزل جديد على الفور

26
00:03:42,390 --> 00:03:43,890
إنه لا شيء

27
00:03:43,890 --> 00:03:46,750
كل ما فعلناه هو التحطيم

28
00:03:46,750 --> 00:03:50,890
بناء الأشياء الجديدة هو عملكم أنتم النجارين

29
00:03:50,890 --> 00:03:53,760
أيها الرئيس ، الباقي متروك عليكم

30
00:03:53,760 --> 00:03:56,430
نعم ، سوف نبذل قصارى جهدنا

31
00:03:56,430 --> 00:03:58,310
شكراً على العمل

32
00:03:58,310 --> 00:04:01,120
قياتا-ني" ، سوف نساعد نحن أيضاً"

33
00:04:01,120 --> 00:04:02,900
أوه ، سوف يساعدنا هذا كثيراً

34
00:04:03,420 --> 00:04:08,260
فالتقوموا بتنظيف المنطقة هنا
وإن وجدتم شيئاً ذا قيمة

35
00:04:08,260 --> 00:04:10,660
سنقوم بإعادته للأشخاص
الذين أحترقت منازلهم

36
00:04:10,660 --> 00:04:13,530
فقط القذرين هم الذين يسرقون بعد الحريق

37
00:04:13,530 --> 00:04:18,370
نعم ، هذا صحيح
هذا ما كنت أفكر فيه أيضاً

38
00:04:18,370 --> 00:04:19,830
هيا ، فالنذهب

39
00:04:19,830 --> 00:04:20,930
!نعم

40
00:04:20,930 --> 00:04:24,340
ذالك "التوميكيشي" لقد اصبح رئيساً حقاً

41
00:04:31,310 --> 00:04:33,460
أليس هؤلاء من قاموا بإشعال النار؟

42
00:04:33,460 --> 00:04:35,140
لماذا علينا حفر قبور لهم؟

43
00:04:35,140 --> 00:04:41,050
لأن عقيدتي تخبرني بأنه يجب علي أن أساعد
الأرواح التي تحتاج للصلاة و الحزن

44
00:04:46,780 --> 00:04:48,480
هذه الرسمه مرة أخرى

45
00:04:48,480 --> 00:04:50,060
رمز (البونجي) هذا

46
00:04:53,660 --> 00:04:55,830
لا يزال هنالك المزيد

47
00:04:55,830 --> 00:04:58,810
لا داعي للقلق
وحتى وإن لم تكن الأول في الصف

48
00:04:59,130 --> 00:05:00,410
شكراً جزيلاً

49
00:05:00,820 --> 00:05:01,420
خذ

50
00:05:01,640 --> 00:05:03,590
لدينا أيضاً دواءاً للجرحى

51
00:05:03,590 --> 00:05:05,150
لا داعي للتراجع وقوموا بإخبارنا

52
00:05:05,560 --> 00:05:06,670
...أنت

53
00:05:07,900 --> 00:05:09,570
!"هيجيكاتا-ساما"

54
00:05:09,570 --> 00:05:10,740
!أنه وسيم جداً

55
00:05:09,990 --> 00:05:11,410
لماذا يحدث هذا؟

56
00:05:10,740 --> 00:05:12,510
!أريد البعض ، من فضلك

57
00:05:11,410 --> 00:05:12,510
لا أعلم

58
00:05:12,510 --> 00:05:13,870
تباً

59
00:05:13,870 --> 00:05:14,970
!أيها القائد

60
00:05:15,720 --> 00:05:18,220
"أوه ، أنها "أوكايو-سان

61
00:05:18,620 --> 00:05:21,660
مهلاً ، ألم تهربي إلى (أوساكا)؟

62
00:05:21,660 --> 00:05:25,110
لا ، لم أستطع فعل ذلك بعد كل ما حدث

63
00:05:25,660 --> 00:05:28,630
دعني أقوم بالمساعدة أيضاً

64
00:05:28,630 --> 00:05:30,780
نعم ، سيساعدنا هذا كثيراً

65
00:05:34,220 --> 00:05:37,120
من كان يعلم بأن هذا كان ما سيحدث

66
00:05:39,900 --> 00:05:40,730
...أيها

67
00:05:43,840 --> 00:05:46,740
كيف يقوم سياف ماهر
بعمل كهذا

68
00:05:47,050 --> 00:05:48,840
أنت ، منذ متى و أنت هنا

69
00:05:48,840 --> 00:05:50,320
مهلاً

70
00:05:50,320 --> 00:05:52,980
لقد كدت أفقد أنفي

71
00:05:53,760 --> 00:05:54,650
دعنا نرى

72
00:05:55,180 --> 00:05:56,480
لا تعترض طريقي

73
00:05:59,230 --> 00:06:00,790
أنت جيد في هذا

74
00:06:00,790 --> 00:06:05,330
عندما كنت طفلاً ، تم تربيتي للتبني و أضطررت
للتنقل من المنزل عدة مرات

75
00:06:05,830 --> 00:06:09,900
وبسبب ذلك ، تعلمت الطبخ والتنظيف
والقيام بالأعمال الأخرى

76
00:06:10,510 --> 00:06:12,170
وبهذا أنتهيت

77
00:06:12,560 --> 00:06:14,690
حسناً ، هل نتمشى قليلاً؟

78
00:06:18,420 --> 00:06:21,220
لقد جئت اليوم لمناقشة جادة

79
00:06:22,230 --> 00:06:25,620
كلما قلت هذا
يكون الأمر سخيفاً

80
00:06:26,380 --> 00:06:28,000
أريد منك ِ أن تصبحي زوجتي

81
00:06:28,300 --> 00:06:31,570
أنظر! تتكلم عن الزواج مرة أخرى

82
00:06:32,030 --> 00:06:33,630
تـ ـ تتزوجني؟

83
00:06:34,050 --> 00:06:35,340
ماذا!؟

84
00:06:35,340 --> 00:06:37,460
هل هو أمر يستحق أن تتفاجئي منه؟

85
00:06:37,990 --> 00:06:41,330
أعتقد بأننا قد قمنا بالعقد بالفعل
بالقبلة في الأمس

86
00:06:43,760 --> 00:06:45,350
!هـ-هذا

87
00:06:45,350 --> 00:06:48,610
هذا سخيف ، ما الذي تتحدث عنه فجأة
أنا ـــ

88
00:06:48,610 --> 00:06:50,730
لماذا أمرأة مثلك

89
00:06:51,040 --> 00:06:55,450
ترتدي كرجل في الشينسينغومي
وتطلق على نفسها "أوكتا سوجي"؟

90
00:06:56,940 --> 00:06:58,410
...هذا

91
00:06:58,790 --> 00:07:00,080
لا داعي لإخباري

92
00:07:00,810 --> 00:07:03,130
لا أهتم بمن تكوني

93
00:07:03,130 --> 00:07:05,870
ولا أهتم بماضيكِ مهما كان

94
00:07:05,870 --> 00:07:09,620
أنا الآن ، أحب المرأة الواقفة بجانبي

95
00:07:10,010 --> 00:07:11,310
هذا هو كل شيء

96
00:07:12,640 --> 00:07:15,050
هل يمكنك أخباري بشيء واحد فقط

97
00:07:15,750 --> 00:07:18,750
ما هو أسمك الحقيقي؟

98
00:07:24,570 --> 00:07:25,570
أكيرا

99
00:07:28,000 --> 00:07:31,570
تكتب كالون الأبيض
"آكيرا"

100
00:07:33,040 --> 00:07:34,070
..."آكيرا"

101
00:07:35,820 --> 00:07:38,860
أنه يناسبك ، ياله من أسم جميل

102
00:07:42,480 --> 00:07:44,980
هذا جعلني سعيداً

103
00:07:45,510 --> 00:07:46,580
هاه؟

104
00:07:46,580 --> 00:07:51,790
أنها المرة الأولى في حياتي
التي أحصل فيها على كل هذا المدح

105
00:07:52,750 --> 00:07:54,200
حقاً؟

106
00:07:54,200 --> 00:07:57,700
أنا سعيد لأنني أنضممت للشينسينغومي

107
00:07:59,070 --> 00:08:01,970
أنا سعيد لأنني أصبحت بديلاً

108
00:08:02,490 --> 00:08:03,930
أنا أيضاً

109
00:08:03,930 --> 00:08:06,140
بديل في الشينسينغومي

110
00:08:08,050 --> 00:08:11,090
بعد التفكير في الأمر ، إنها فكرة مجنونة

111
00:08:11,090 --> 00:08:11,980
نعم

112
00:08:12,420 --> 00:08:17,230
لقد ظننت بأنني وافقت فقط لكي
...أتجنب أن يتم إعدامي، ولكن

113
00:08:17,930 --> 00:08:24,100
سحقاً ، اليوم ولمرة واحدة
أشعر في الرغبة بشكر "تودو" على هذا

114
00:08:24,100 --> 00:08:26,370
!نعم

115
00:08:29,790 --> 00:08:31,980
لا أصدق بإنني قد نمت

116
00:08:32,990 --> 00:08:34,800
هل تشعر بالبرد؟

117
00:08:35,030 --> 00:08:38,260
لا أنا بخير ، آسف على إيقاظك

118
00:08:38,260 --> 00:08:42,220
منذ البارحة لم تستريح ولو للحظة
وكنت تعتني بي

119
00:08:42,560 --> 00:08:44,320
يجدر بك أخذ قسط من الراحة

120
00:08:49,770 --> 00:08:53,740
أنا متأكد بأن أحدهم
قد تكلم عني بسوء مجدداً

121
00:08:54,630 --> 00:08:58,110
من الصعب لعب دور الشرير

122
00:09:03,070 --> 00:09:04,950
!مهلاً ، مهلاً

123
00:09:04,950 --> 00:09:06,580
!لا تقم بدفنه

124
00:09:11,550 --> 00:09:13,330
كما ظننت

125
00:09:16,470 --> 00:09:19,620
أكيرا يبدو كأسم رجولي ، أليس كذلك؟

126
00:09:19,620 --> 00:09:22,060
يمكن أستخدامه للرجل و المرأة

127
00:09:23,270 --> 00:09:29,220
إنه الأسم الذي أختاره والداي
للأبن الذي سيتولى رعاية دوجو الأسرة

128
00:09:31,660 --> 00:09:38,150
عندما علمت ذلك ، أعتقدت بأن والداي
كانا يريدان طفلاً ماهراً في فن المبارزة

129
00:09:38,500 --> 00:09:41,410
لهذا ، كرست نفسي للتدريب بالمبارزة

130
00:09:41,410 --> 00:09:44,870
كنت يائسة لإسعاد والداي

131
00:09:45,230 --> 00:09:49,950
أثناء تدريبي ، لم
يحظ أي أحد في الدوجو بفرصة ضدي

132
00:09:49,950 --> 00:09:52,200
لذلك أصحبت مدربة

133
00:09:52,200 --> 00:09:55,290
هنا عندما أدركت شيئاً أخيراً

134
00:09:55,790 --> 00:10:00,410
ما كان يريده والداي
لم يكن أبنة قوية

135
00:10:00,410 --> 00:10:04,760
بل أبن لتولي الدوجو

136
00:10:05,060 --> 00:10:08,220
لقد عشتِ حياة وحيدة في طريق السيف

137
00:10:08,220 --> 00:10:11,930
لا يمكنني سوى العيش
بهذه الطريقة

138
00:10:11,930 --> 00:10:15,650
لابد أنه كان صعباً ، ولكنني أعرفك

139
00:10:15,650 --> 00:10:18,620
رفضتِ فكرة الشعور بهذا الألم

140
00:10:18,620 --> 00:10:21,010
وقمت بأرجحت سيفك الخشبي كل يوم

141
00:10:21,010 --> 00:10:22,730
ربما

142
00:10:23,050 --> 00:10:24,860
وهذه الوحدة ستنتهي

143
00:10:26,690 --> 00:10:28,480
إذا قمتِ بزواج مني

144
00:10:29,380 --> 00:10:33,700
أنت هذا ما تفعله طوال الوقت
تقوم بالخداع واللعب في قلوب الناس

145
00:10:33,700 --> 00:10:36,880
لن أقوم بالخداع
في أمر كالزواج

146
00:10:36,880 --> 00:10:39,590
حسناً ، لا داعي للأستعجال في  إعطائي إجابتك

147
00:10:39,910 --> 00:10:41,610
لنأخذ الأمر ببطء

148
00:10:41,610 --> 00:10:46,050
علاقتنا قد بدأت للتو

149
00:10:47,250 --> 00:10:49,520
آآه ، لقد تعبت

150
00:10:50,020 --> 00:10:51,470
"غبيبوشي"

151
00:10:51,860 --> 00:10:52,660
فالتأكل

152
00:10:53,170 --> 00:10:55,520
أوه ، شكراً لك

153
00:10:58,470 --> 00:11:00,980
أنت أيضاً لم تأكل منذ الصباح ، أليس كذلك

154
00:11:00,980 --> 00:11:02,550
..لا ، أنا بخير

155
00:11:05,130 --> 00:11:07,240
لا داعي لتجبر نفسك

156
00:11:08,880 --> 00:11:10,370
..تعرف...عائلتي

157
00:11:11,190 --> 00:11:14,200
كنا نعيش في عمق الريف وكنا فقراء

158
00:11:14,570 --> 00:11:15,980
ما الذي تتحدث عنه؟

159
00:11:16,880 --> 00:11:18,670
..أتسائل متى كان ذلك

160
00:11:18,670 --> 00:11:21,370
كان هناك مهرجان في القرية المجاورة

161
00:11:22,290 --> 00:11:25,190
لقد حصلت على بعض من المصروف
وقمت بشراء كعكة مانجو واحدة

162
00:11:25,190 --> 00:11:27,970
وقمت بإعطائها "لتسوكيتو" ، ولكن

163
00:11:27,970 --> 00:11:29,090
خذ

164
00:11:29,090 --> 00:11:32,430
كما قلت ، أن هذه لك

165
00:11:33,270 --> 00:11:36,160
عندما تأكل مع شخص آخر
يكون مذاق الطعام ألذ

166
00:11:38,850 --> 00:11:40,610
حسناً إذاً

167
00:11:42,850 --> 00:11:44,860
أنه شخص لطيف

168
00:11:45,730 --> 00:11:47,870
كان يتظاهر بأنه صارم

169
00:11:48,480 --> 00:11:52,380
أنه عندما يكذب يرتفع حاجبة الأيمن

170
00:11:53,490 --> 00:11:54,870
أستطيع معرفة ذلك على الفور

171
00:11:55,460 --> 00:11:57,790
تسوكيتو" أصبح "راشومارو" الآن"

172
00:11:58,250 --> 00:12:03,860
"نعم، ولكن "تسوكيتو
القديم لا يزال حياً بداخله

173
00:12:04,420 --> 00:12:05,760
أستطيع معرفة ذلك

174
00:12:05,760 --> 00:12:10,240
هل تعتقد بأن "تسوكيتو" سيعود
إذا قمت بتغيير هذا العالم القذر؟

175
00:12:10,770 --> 00:12:11,720
نعم

176
00:12:12,080 --> 00:12:14,060
قد تضطر لقتله

177
00:12:14,810 --> 00:12:17,050
عندما يحين ذلك الوقت سأفعل ذلك

178
00:12:19,360 --> 00:12:21,730
لقد قتلت والدي

179
00:12:23,110 --> 00:12:25,040
لقد ولدت في عائلة ساموراي

180
00:12:25,040 --> 00:12:28,820
..كان لدينا المكانة والثروة ، ولكن

181
00:12:29,240 --> 00:12:31,360
كان والدي من أسوأ أنواع البشر

182
00:12:32,600 --> 00:12:37,290
لقد أستغل منصبه
وكان طاغية لمن هم أضعف منه

183
00:12:37,760 --> 00:12:40,750
لقد تحملت أمي فقط كل عنف والدي

184
00:12:42,590 --> 00:12:46,820
لأن طاعة الزوج كانت
من واجبات  زوجة الساموراي

185
00:12:50,060 --> 00:12:52,680
ذات ليلة ، أصبح والدي
أكثر عنفاً من المعتاد

186
00:12:52,680 --> 00:12:57,890
لو لم أقم بقتله في ذلك الوقت ، لكانت
ستقتل والدتي ، لذلك قمت

187
00:12:59,250 --> 00:13:02,440
إذاً فعلت ذلك لحماية والدتك؟

188
00:13:04,340 --> 00:13:07,650
في الليلة التي قتلت فيها والدي
قامت والدتي بقتل نفسها

189
00:13:09,650 --> 00:13:13,020
لقد قتلت والدي الذي كان
تجسيداً للعالم القذر هذا

190
00:13:13,470 --> 00:13:20,220
ولكنني قمت بذلك بقتل والدتي التي
لاتستطيع العيش سوى بمجتمع الساموراي هذا

191
00:13:27,750 --> 00:13:29,590
