1
00:00:07,850 --> 00:00:10,760
درجة الحرارة العالية اليوم هي 19 مئويّة

2
00:00:11,400 --> 00:00:13,990
لن نحتاج أكثر من سترة واحدة

3
00:00:17,580 --> 00:00:21,580
جاء الرّبيع أخيراً بعد شتاء طويل

4
00:00:27,090 --> 00:00:30,890
...لا بدّ أنّ هذا ما كان جدّي يتحدّث عنه

5
00:00:31,720 --> 00:00:35,260
لن تعرفي بما أنّكِ حصلتِ
،على رخصتكِ مؤخّراً

6
00:00:35,780 --> 00:00:38,970
لكن أفضل وقت للقيام بجولة هي
عندما تتبدّل المواسم

7
00:00:38,970 --> 00:00:41,080
هناك فترة قصيرة

8
00:00:41,080 --> 00:00:44,350
عندما تتبدّل المواسم؟ أي في أبريل تقريباً؟

9
00:00:44,840 --> 00:00:47,180
أجل. يعتمد الأمر على وجهتكِ أيضاً

10
00:00:47,670 --> 00:00:50,740
في هذه الأوقات تقريباً، أبكر
قليلاً من شهر أبريل

11
00:00:51,130 --> 00:00:56,920
في الفترة الّتي لا تتعرّقين فيها وأنتِ ترتدين
سترة ولا تشعرين ببرد

12
00:00:57,700 --> 00:01:00,510
يتعرّق المرء كثيراً في أبريل

13
00:01:00,510 --> 00:01:02,880
إنّها لفترة قصيرة جدّاً حقّاً

14
00:01:04,390 --> 00:01:07,880
هذه هي الفترة القصيرة الآن

15
00:01:11,290 --> 00:01:13,890
هذه أوّل رحلة تخييم فرديّة لي منذ زمن

16
00:02:45,190 --> 00:02:51,110
الحلقة 9   الموسم الثّالث
التّجوال وتفقّد أزهار الكرز

17
00:02:58,560 --> 00:03:00,910
إنّه شديد الانحدار

18
00:03:00,910 --> 00:03:02,490
مُخيف

19
00:03:14,210 --> 00:03:16,280
...المزيد نحو الأسفل

20
00:03:27,130 --> 00:03:32,040
إنّه صغير، لكنّه لطيف مع إطلالة
على أزهار الكرز

21
00:03:35,360 --> 00:03:39,410
.سمعتُ أنّه لم يعلم أحدٌ بشأن هذا المكان
لكن مُذهل. لا يوجد أحدٌ هنا حقّاً

22
00:03:39,740 --> 00:03:42,260
المدخل ضيّق، وهو مُنحدِر

23
00:03:42,260 --> 00:03:44,680
لا بدّ أنَّ النّزول إلى هنا صعب
على مُعظم النّاس

24
00:03:45,830 --> 00:03:48,920
لكن بفضل ذلك، المكان كلّه مُلكي

25
00:03:49,250 --> 00:03:50,350
—مرحـ

26
00:03:54,670 --> 00:03:55,960
حسناً، لا يهمّ

27
00:03:55,960 --> 00:03:58,510
ينبغي أن أنصب خيمة وأسترخي

28
00:03:59,760 --> 00:04:01,140
انتهيت

29
00:04:03,920 --> 00:04:07,290
يبدو أنّه تخييم سيّارة

30
00:04:08,010 --> 00:04:11,040
أريد تجربة ذلك يوماً ما

31
00:04:11,040 --> 00:04:13,070
لا بدّ أنّ التّفكيك أسهل بكثير

32
00:04:24,830 --> 00:04:28,540
‏‏‏‏31 مارس
مدينة فوجيكاوا

33
00:04:25,600 --> 00:04:28,540
غادرتُ بعد الظّهر فحسب والآن
هي السّاعة الواحدة فقط

34
00:04:29,730 --> 00:04:31,530
أظنّني سأذهب لأتمشّى

35
00:04:33,820 --> 00:04:36,130
أتعتقدين بأنّها طالبة مدرسة إعداديّة؟

36
00:04:36,580 --> 00:04:41,970
صيحة التّخييم تنتشر حقّاً إذا كان طلّاب مدرسة
إعداديّة يخرجون للتّخييم

37
00:04:41,970 --> 00:04:44,820
لا، مُحال أن تركب طالبة مدرسة
إعداديّة درّاجة ناريّة

38
00:04:44,820 --> 00:04:46,390
إنّها طالبة ثانويّة إذاً؟

39
00:04:49,350 --> 00:04:53,190
الصّيحة ليست جنونيّة بما يكفي لإقناع
طالبة ثانويّة بالذّهاب للتّخييم

40
00:04:53,530 --> 00:04:54,980
تلميذة كلّية إذاً؟

41
00:04:54,980 --> 00:04:58,240
حسناً. لنعتمد تلميذة كلّية سنة أولى

42
00:04:58,240 --> 00:05:00,950
تفضّلي. أرزّ مقليّ مع القريدس

43
00:05:00,950 --> 00:05:01,780
!شكراً

44
00:05:02,150 --> 00:05:03,850
!حان وقت الأكل

45
00:05:09,080 --> 00:05:14,800
إنّ التّخييم رهيب حقّاً إذا كان يجعل
طبخك لذيذاً يا كوتاني-كن

46
00:05:14,800 --> 00:05:17,480
ماذا؟ أتريدين العيش هنا لفترة إذاً؟

47
00:05:31,060 --> 00:05:33,810
جسر ريوجينكيو

48
00:05:31,060 --> 00:05:33,810
جسر ريومونكيو

49
00:05:42,070 --> 00:05:44,070
جسر
ريومونكيو

50
00:06:08,770 --> 00:06:10,960
هذا جسر غريب

51
00:06:11,350 --> 00:06:13,850
جسر
ريوجينكيو

52
00:06:19,410 --> 00:06:23,360
يؤدّي هذا الطّريق إلى النّبع
السّاخن الّذي في القمّة

53
00:06:27,250 --> 00:06:29,980
ليس وكأنّني سأذهب. يبدو هذا شاقّاً للغاية

54
00:06:45,890 --> 00:06:47,780
هذا فظيع

55
00:06:47,780 --> 00:06:50,140
لا يوجد مُدير لهذا المكان أيضاً

56
00:06:50,990 --> 00:06:52,640
!بئس الأمر

57
00:06:58,560 --> 00:07:00,930
ماذا تنوي أن تفعل برأيك؟

58
00:07:04,010 --> 00:07:07,410
كيس النّفايات الّذي أحضرتُه
لا يتّسع لكلّ شيء

59
00:07:07,410 --> 00:07:11,570
ولا أعتقد بأنّني أستطيع حمله
...بدرّاجتي الصّغيرة

60
00:07:12,380 --> 00:07:14,540
مرحباً. ماذا تفعلين؟

61
00:07:15,400 --> 00:07:16,390
مرحباً

62
00:07:16,390 --> 00:07:20,190
أحدهم ترك نِفاياته دون إزالتها

63
00:07:20,190 --> 00:07:22,540
أتيتِ بدرّاجة صغيرة، صحيح؟

64
00:07:22,540 --> 00:07:24,780
أتريديننا أن نأخذ هذا إلى المنزل؟

65
00:07:25,450 --> 00:07:26,550
حقّاً؟

66
00:07:26,550 --> 00:07:28,860
أجل، بالطّبع. أتينا إلى هنا بسيّارة

67
00:07:28,860 --> 00:07:31,610
ولدينا نفاياتنا على أيّ حال

68
00:07:37,090 --> 00:07:42,900
أليس من الواضح بأنّه سوف يُغلَق في النّهاية
إذا ظلّ النّاسُ يرمون نِفاياتهم؟

69
00:07:43,160 --> 00:07:45,600
،ربّما لا يكون هذا واضحاً إذا كنتِ مُبتدئة

70
00:07:45,600 --> 00:07:50,250
ما لم يكن هناك شخص معكِ يُعلّمكِ

71
00:07:50,250 --> 00:07:52,090
مثلاً حول ما يجب فعله بنار التّخييم

72
00:07:52,090 --> 00:07:54,160
لكن كان ذلك سيّئاً للغاية

73
00:07:56,070 --> 00:07:59,540
إنّها تُبالغ، فنحن في حقيقة الأمر
مُخيِّمان جديدان بحدِّ ذاتنا

74
00:07:59,540 --> 00:08:01,670
لم نُمارس التّخييم إلّا منذ عام

75
00:08:01,670 --> 00:08:03,500
حقّاً؟

76
00:08:03,900 --> 00:08:09,510
أعتقد نحن محظوظان لأنّنا عَلِمنا بوجود
مُخيِّم مُتحمِّس راغِب في تعليمنا

77
00:08:09,510 --> 00:08:15,020
علّمنا مقولة أيضاً

78
00:08:15,020 --> 00:08:20,580
لا تترُك أثراً عندما ترحل. تظاهر"
"بأنّك مُلاحَق بواسطة قاتل مأجور

79
00:08:20,580 --> 00:08:22,400
قاتل مأجور؟

80
00:08:22,730 --> 00:08:25,390
لكن هذا مُقنِع جدّاً

81
00:08:27,050 --> 00:08:30,660
بالمناسبة، هل ترتادين كلّية هنا؟

82
00:08:30,660 --> 00:08:32,900
لا، أنا في المدرسة الثّانويّة

83
00:08:32,900 --> 00:08:34,890
لكن أعيش في مكان قريب

84
00:08:34,890 --> 00:08:36,830
ماذا؟ أنتِ تلميذة ثانويّة؟

85
00:08:38,260 --> 00:08:43,710
كنّا نقول بأنّكِ في الكلّية بما أنّكِ
تبدين معتادة على التّخييم

86
00:08:44,000 --> 00:08:45,840
حقّاً؟

87
00:08:49,420 --> 00:08:50,720
...مُرّة

88
00:08:49,720 --> 00:08:50,720
قهوة
(مُرّة)

89
00:08:50,720 --> 00:08:53,250
آسف، أهي مُرّة للغاية؟

90
00:08:53,250 --> 00:08:54,570
لديّ سُكَّر

91
00:08:54,570 --> 00:08:56,060
شـ-شكراً

92
00:08:56,060 --> 00:08:59,460
سمعتُ بأنّ المرء يبدأ بتقدير الطّعام
المُرّ أكثر كلّما كبر

93
00:08:59,460 --> 00:09:02,870
وتتأقلم حاسّة الذّوق مع المرارة

94
00:09:02,870 --> 00:09:04,780
أعتقد هذا يعني بأنّكِ صغيرة

95
00:09:07,530 --> 00:09:10,650
لحظة يا أوغاوا-سان، ظننتُكِ تُفضِّلين السّوداء

96
00:09:16,040 --> 00:09:17,830
،على ذكر الأمر

97
00:09:18,440 --> 00:09:24,330
علّمني جدّي أن آخذ كلّ شيء
معي إلى المنزل

98
00:09:24,760 --> 00:09:27,090
عندما بدأتُ بالتّخييم أوّل مرّة أيضاً

99
00:09:27,930 --> 00:09:32,160
آمل أن يفكّر مزيدٌ من المُخيّمين بهذه الطّريقة

100
00:09:33,340 --> 00:09:36,350
على أيّ حال، أعتقد سأعدّ بعض طعام التّخييم

101
00:09:37,490 --> 00:09:44,100
غداء اليوم هو باستا مع سبانغ وكثير
من الطّماطم على موقِد أُحادي الرّأس

102
00:09:45,610 --> 00:09:47,360
!مرحباً

103
00:09:48,520 --> 00:09:51,630
رين، لدينا بعض الهدايا تعود لوقت
تخييمنا في ميزوغاكي

104
00:09:51,630 --> 00:09:55,740
البيتزا والأشياء الّتي أعددناها بواسطة
هذه الطّماطم كانت لذيذة حقّاً

105
00:09:56,190 --> 00:09:58,050
حـ-حسناً

106
00:09:58,050 --> 00:09:59,770
وهكذا بدأ الطّبخ

107
00:09:59,770 --> 00:10:04,810
أوّلاً، نضع لحماً مُقدّداً على الموقِد
ونقليه حتّى يتقرمش

108
00:10:05,450 --> 00:10:09,540
ثمّ نضيف مِلعقة مائدة من زيت
الزّيتون وثوماً مفروماً

109
00:10:09,540 --> 00:10:15,890
وفليفلة حارّة مُقطَّعة وطماطم مُتوسِّطة
الحجم على شكل أرباع

110
00:10:15,890 --> 00:10:18,890
نفتّتها وندعها تغلي ببطء

111
00:10:18,890 --> 00:10:20,140
ثوم مفروم

112
00:10:20,500 --> 00:10:21,700
!غارل

113
00:10:21,700 --> 00:10:23,160
!غارلز

114
00:10:24,990 --> 00:10:27,150
!غارلِك

115
00:10:28,690 --> 00:10:31,620
،على أي حال، حالما تتفتّت الطّماطم

116
00:10:31,620 --> 00:10:37,160
نضيف السّبانغ و 200 سنتيمتر مُكعّب
من الماء وملح عشبيّ. ثمّ نغليهم

117
00:10:38,660 --> 00:10:44,630
نكسر 100 غرام من الباستا
إلى نصفين ونغليها

118
00:10:45,060 --> 00:10:47,440
الإيطاليّون لا يُشاهدوننا، صحيح؟

119
00:10:49,020 --> 00:10:54,970
قبل أن تنتهي الباستا من الغليان، نضيف
حبّتَي طماطم مُقطَّعة لأحجام متوسّطة

120
00:10:54,970 --> 00:10:58,520
ندعها حتّى تصبح طريّة قليلاً
على نار قوية

121
00:10:58,520 --> 00:11:01,720
ثلاث حبّات من الطّماطم تبدو كثيرة

122
00:11:02,090 --> 00:11:09,840
أخيراً، نُنكِّه بمِلعقة مائدة من زيت
الزّيتون وملح عشبيّ، وينتهي الأمر

123
00:11:02,430 --> 00:11:10,730
باستا على موقِد أُحادي الرّأس مع سبانغ وكثير من الطّماطم

124
00:11:09,840 --> 00:11:10,730
انتهيت

125
00:11:10,730 --> 00:11:15,360
أفضل مئة وجبة في الهواء الطّلق

126
00:11:10,730 --> 00:11:15,360
‏‏‏‏100 وصفة سهلة

127
00:11:11,020 --> 00:11:15,360
!مرحباً

128
00:11:12,330 --> 00:11:15,360
لم أستخدم كِتاب الوصفات هذا منذ مدّة

129
00:11:16,610 --> 00:11:17,630
...حسناً

130
00:11:17,630 --> 00:11:18,990
لنأكل

131
00:11:36,000 --> 00:11:42,100
الطّماطم المطبوخة جيّداً وتلك الشّبه
نيّئة تغمر الباستا

132
00:11:42,100 --> 00:11:45,110
أجل. شهيّة للغاية

133
00:11:45,110 --> 00:11:46,560
طماطم لذيذة

134
00:12:08,170 --> 00:12:10,290
ينبغي أن تكون في موسمها الآن

135
00:12:21,180 --> 00:12:23,150
ماذا تفعلين؟

136
00:12:23,860 --> 00:12:25,810
...لم ألحظ حتّى الأمس

137
00:12:26,430 --> 00:12:30,310
لكن هناك سحابة كبيرة من أزهار
!الكرز فقط في تلك البقعة

138
00:12:30,310 --> 00:12:31,710
معكِ حقّ

139
00:12:31,710 --> 00:12:34,230
أتساءل ماذا يوجد هناك في الأعلى

140
00:12:34,230 --> 00:12:37,350
أعتقد كان يوجد مزار أو معبد أو ما شابه

141
00:12:39,130 --> 00:12:41,300
يراودني فضول حقّاً

142
00:12:41,300 --> 00:12:43,950
ربّما سأقود الدرّاجة إلى هناك غداً

143
00:12:43,950 --> 00:12:46,580
هل أنتِ مُتفرِّغة غداً يا ناديشيكو؟

144
00:12:46,580 --> 00:12:47,400
أجل

145
00:12:47,400 --> 00:12:49,460
ليس لديّ عمل أيضاً

146
00:12:49,940 --> 00:12:52,960
ما رأيكِ أن نذهب بالسيّارة ونشاهد
بعض أزهار الكرز؟

147
00:12:54,450 --> 00:12:56,340
!أجل! هيّا بنا

148
00:12:57,340 --> 00:13:01,250
!أنا ذاهبة لرؤية أزهار الكرز
!أنا ذاهبة لرؤية أزهار الكرز

149
00:13:01,250 --> 00:13:02,750
،بسيّارة اليوم

150
00:13:02,750 --> 00:13:04,370
...لنخيّم غداً

151
00:13:04,370 --> 00:13:06,680
!كلّ شيء أزهار كرز في هذا الأسبوع

152
00:13:09,730 --> 00:13:11,770
بقيتُ أنا

153
00:13:18,900 --> 00:13:19,910
—لذيذة

154
00:13:20,340 --> 00:13:22,100
لننطلق

155
00:13:22,540 --> 00:13:23,840
لذيذة

156
00:13:29,870 --> 00:13:32,710
!أونيه-تشان، سوف أصعد الدّرج

157
00:13:52,310 --> 00:13:53,560
!ها قد وصلت

158
00:13:54,350 --> 00:13:57,230
تتمتّعين بقوّة ولياقة عاليتين حقّاً

159
00:14:07,870 --> 00:14:10,370
حديقة أوتسوبونا

160
00:14:07,870 --> 00:14:10,370
الزنبق اليابانيّ ينمو هنا

161
00:14:07,870 --> 00:14:10,370
غولف

162
00:14:19,300 --> 00:14:21,380
!إنّها بكامل تفتّحها يا أونيه-تشان

163
00:14:21,380 --> 00:14:24,380
!لا بدّ أنّ هذا ما كنّا نراه من المنزل

164
00:14:24,850 --> 00:14:27,510
لم أكن أعلم بوجود حديقة هنا

165
00:14:29,820 --> 00:14:31,270
أعتقد أنّ النّاس لا يعلمون بها

166
00:14:31,680 --> 00:14:35,970
هذا أكيد. يبدو من الصّعب الوصول
إليها بسيّارة أيضاً

167
00:14:38,090 --> 00:14:40,280
حسناً، التقطتُ صورة جميلة

168
00:14:40,280 --> 00:14:42,030
حسناً، لنواصل التقدّم

169
00:14:42,030 --> 00:14:43,690
!حاضرة

170
00:14:46,170 --> 00:14:51,700
بالمناسبة، قالت آكي-تشان بأنّ جبل مينوبو هو المكان
المناسب في الأرجاء لمشاهدة أزهار الكرز

171
00:14:52,050 --> 00:14:55,150
يبدو أنّه مشهور بأشجّار شيداريزاكورا الكبيرة

172
00:14:56,710 --> 00:14:58,210
جبل مينوبو كونجي

173
00:15:02,200 --> 00:15:03,970
إنّها ضخمة

174
00:15:05,970 --> 00:15:08,550
المرآب ممتلئ

175
00:15:14,560 --> 00:15:16,510
ماذا نفعل يا أونيه-تشان؟

176
00:15:16,510 --> 00:15:17,690
فهمت

177
00:15:17,690 --> 00:15:19,400
سوف ننعطف يميناً من هناك

178
00:15:21,960 --> 00:15:25,400
ظننتُ بأنّنا أتينا لرؤية أشجار شيداريزاكورا
...في جبل مينوبو

179
00:15:25,400 --> 00:15:28,490
لا يسعنا فعل شيء إذا لم يكن
هناك مكان لركن السيّارة

180
00:15:28,490 --> 00:15:29,890
لا حاجة للوصول إلى القمّة

181
00:15:29,890 --> 00:15:32,850
هناك الكثير في الطّريق هنا

182
00:15:32,850 --> 00:15:34,980
سوف نراها بينما نقود

183
00:15:34,980 --> 00:15:36,670
حسناً، فهمت

184
00:15:50,970 --> 00:15:54,720
ليس علينا الوصول إلى القمّة
للاستمتاع بذلك إذاً؟

185
00:16:14,330 --> 00:16:16,830
‏‏‏‏1 أبريل
مدينة فوجيكاوا

186
00:16:20,780 --> 00:16:24,340
أونيه-تشان وأنا نتجوّل بالسيّارة
!لمشاهدة أزهار الكرز

187
00:16:24,680 --> 00:16:28,250
...بالسيّارة... لمشاهدة أزهار الكرز

188
00:17:13,530 --> 00:17:16,010
إنّها أفضل من هنا

189
00:17:29,740 --> 00:17:31,530
!غلبني النُّعاس

190
00:17:31,530 --> 00:17:33,830
أعتقد سأحزم أمتعتي وأذهب للنّبع السّاخن

191
00:17:34,150 --> 00:17:36,410
ساعات الزّيارة تنتهي على الثّانية

192
00:17:38,080 --> 00:17:39,440
حسناً

193
00:17:40,880 --> 00:17:43,920
أعتقد بأنّهما غادرا بالفعل

194
00:17:44,260 --> 00:17:47,920
مضى وقت منذ خرجتُ في رحلة
تخييم فرديّة بطيئة

195
00:17:49,200 --> 00:17:51,930
ينبغي أن أعود عندما أخوض رحلة
تخييم فرديّة ثانية

196
00:17:55,680 --> 00:18:00,170
!إ-إنّه شديد الانحدار

197
00:18:03,750 --> 00:18:07,670
توجد كثير من التِّلال المُنحدِرة هنا

198
00:18:15,780 --> 00:18:18,540
نبع الميلانتريت الشّهير
توغي-نو-يو

199
00:18:15,780 --> 00:18:18,540
نبع توغي-نو-يو السّاخن

200
00:18:15,780 --> 00:18:18,540
ينابيع ساخنة
نُزُل &

201
00:18:15,780 --> 00:18:18,540
مفتوح

202
00:18:18,990 --> 00:18:21,320
تمكّنتُ من الوصول

203
00:18:24,420 --> 00:18:26,370
أجل

204
00:18:28,420 --> 00:18:29,590
حسناً

205
00:18:32,720 --> 00:18:33,840
شكراً

206
00:18:39,850 --> 00:18:42,100
ناغامي-نو-يو

207
00:18:42,100 --> 00:18:45,820
يبدو هذا المكان كالنّبع السّاخن الجبليّ

208
00:18:53,820 --> 00:18:56,780
إنّه مكان مذهل أيضاً

209
00:18:57,220 --> 00:19:00,490
أنا متأكّدة أنّ الإطلالة أفضل
حتّى عند الفجر والغسق

210
00:19:07,080 --> 00:19:09,720
على الأقلّ لديهم سياج

211
00:19:09,720 --> 00:19:12,550
لكن مع ذلك يتأذّى الشّخص إذا سقط

212
00:19:14,360 --> 00:19:17,490
سأذهب لتخييم أزهار الكرز غداً
مع تشياكي والأخريات

213
00:19:17,990 --> 00:19:20,210
يبدو أنّ الطّقس سيثبت لبعض الوقت

214
00:19:20,210 --> 00:19:21,510
جيّد، جيّد

215
00:19:28,510 --> 00:19:32,570
لكن مَرِضَتْ ناديشيكو ولم نستطع فعل ذلك

216
00:19:33,450 --> 00:19:37,160
ألم يكن ذلك عندما ذهبتُ إلى جبل جيمباغاتا؟

217
00:19:37,160 --> 00:19:39,820
...إذاً كان ذلك قبل أربعة أشهر

218
00:19:43,690 --> 00:19:46,360
سأدعوكِ في المرّة المقبلة

219
00:19:47,820 --> 00:19:52,760
خيّمنا كثيراً معاً، لكن لم أكن
أنا الّتي دعوتُها لذلك

220
00:19:52,760 --> 00:19:55,630
...لا أظنّها تُبالي، لكن

221
00:19:56,750 --> 00:20:00,780
عند تفويت الوقت المناسب، يصبح
الأمر مُحرِجاً بعض الشّيء

222
00:20:02,720 --> 00:20:04,770
...اقترب شهر أبريل

223
00:20:04,770 --> 00:20:07,190
لحظة، اليوم هو بداية أبريل

224
00:20:12,770 --> 00:20:16,720
إذاً أنتِ في رحلة لمشاهدة أزهار الكرز الآن

225
00:20:16,720 --> 00:20:17,710
أجل

226
00:20:17,710 --> 00:20:19,820
أفكِّر في التجوّل حول الحوض

227
00:20:19,820 --> 00:20:23,990
في هذه الحالة، قد ترغبين في تجربة
القيام بدورة حول الحدود

228
00:20:23,990 --> 00:20:27,120
ياماناشي

229
00:20:23,990 --> 00:20:28,010
مررتُ بها عندما قدتُ درّاجة الطُّرُقات الهوائيّة
من شيميزو إلى سايتاما في العام الماضي

230
00:20:28,010 --> 00:20:29,190
إنّه طريق جميل

231
00:20:29,190 --> 00:20:30,970
كانت هناك مواقع أزهار كرز أيضاً

232
00:20:30,970 --> 00:20:32,000
بدرّاجة طُرُقات هوائيّة؟

233
00:20:32,460 --> 00:20:34,490
أجل، الدرّاجة العاديّة

234
00:20:34,490 --> 00:20:35,770
درّاجة رياضيّة

235
00:20:35,770 --> 00:20:37,580
بمِقبضي قيادة كهذين

236
00:20:38,230 --> 00:20:40,300
!قطعتِ كلّ هذه المسافة بدرّاجة هوائيّة؟

237
00:20:40,300 --> 00:20:42,000
هذا ليس بالأمر الصّعب

238
00:20:42,000 --> 00:20:45,290
يستغرق وقتاً، لكن ستتفاجئين ببُعد
المسافة الّتي يمكنكِ قطعها

239
00:20:46,120 --> 00:20:48,150
حالما تعتادين على درّاجة الطُّرقات
ستجدين بأنّها سريعة وسلِسة

240
00:20:48,150 --> 00:20:50,310
أهكذا هو الأمر إذاً؟

241
00:20:50,630 --> 00:20:54,580
ذهبتُ للتّخييم عبر موتوسو على درّاجتي
...الهوائيّة حتّى العام المقبل

242
00:20:54,580 --> 00:20:59,070
لكن الآن أنا معتادة جدّاً على درّاجتي النّاريّة
الصّغيرة لدرجة لا أتمنّى فعل ذلك ثانية

243
00:20:59,070 --> 00:21:00,830
!اركبيني ولو لمرّة

244
00:21:01,900 --> 00:21:03,480
لكن درّاجة طُرُقات؟

245
00:21:03,480 --> 00:21:06,150
أنا واثقة بأنّ ناديشيكو ستكون سريعة

246
00:21:05,740 --> 00:21:10,460
المُحرِّك
النّموذج: كاغاميهارا ناديشيكو
المُخرجات القصوى: 43 رطل لكلّ بوصة مُربّعة
عزم الدّوران الأقصى: 45.3 نيوتن متر
فئة الوقود: فطائر مينوبو
كفاءة الوقود: 20 متراً لكلّ واحدة
يعتمد تخمين كفاءة الوقود *
على عمليّة الوضع الرّياضيّ

247
00:21:06,820 --> 00:21:09,490
عشرون متراً لكلّ فطيرة مينوبو؟

248
00:21:09,490 --> 00:21:10,460
يا له من إسراف للوقود

249
00:21:13,100 --> 00:21:15,370
يا له من نبع ساخن جميل

250
00:21:15,370 --> 00:21:17,280
أليس كذلك؟

251
00:21:18,700 --> 00:21:20,730
حسناً، ربّما نلتقي بكِ لاحقاً

252
00:21:22,800 --> 00:21:24,010
مفتوح

253
00:21:22,800 --> 00:21:24,010
حسناً

254
00:21:32,020 --> 00:21:35,090
نتوجّه شمالاً في جولة مشاهدة
!أزهار الكرز عبر السيّارة

255
00:21:44,950 --> 00:21:48,450
ينبغي أن أخوض جولتي الخاصّة
!بأزهار الكرز أيضاً

256
00:23:26,510 --> 00:23:35,770
الحلقة القادمة

257
00:23:26,510 --> 00:23:35,770
تشيكووا، قطارات، رحلة تخييم تشياكي الفرديّة

258
00:23:35,240 --> 00:23:41,500
...عند التّخييم

259
00:23:35,240 --> 00:23:41,500
.قد تتغيّر درجة الحرارة فجأة
احرص على تفقُّد تنبّؤات الطّقس
.ودفّئ نفسك إن لزم الأمر