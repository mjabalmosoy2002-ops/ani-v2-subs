!ستبتاعه فعلًا

188
00:13:52,720 --> 00:13:56,250
.سمعتُ حيال جراد البحر من سايتو-سان

189
00:13:59,400 --> 00:14:01,040
.لستِ سيئة يا إينا

190
00:14:01,040 --> 00:14:04,250
.بالأحرى، كان علينا أن نطلب منها بطريقةٍ عادية من البداية

191
00:14:06,580 --> 00:14:08,970
.شارفنا على الوصول إلى خليج تسوميكي

192
00:14:10,220 --> 00:14:12,890
يُعدّ واحدًا من المواقع الجيولوجية أيضًا، صح؟

193
00:14:12,890 --> 00:14:13,850
‫نعم.

194
00:14:13,850 --> 00:14:17,390
في الماضي، اعتدتُ التخييم هنا في الشتاء رُفقة عائلتي
.في العديد من المرات

195
00:14:17,870 --> 00:14:21,440
.ولكن، لا وجود لأيّ مخيّمٍ هنا يا معلمتي

196
00:14:21,440 --> 00:14:23,400
.سنُخيّم قُرب الشاطئ

197
00:14:23,690 --> 00:14:27,860
يُحظر التخييم قُرب شواطئ إيزو

198
00:14:27,860 --> 00:14:30,660
.من شهر يونيو إلى غاية أكتوبر

199
00:14:35,700 --> 00:14:37,290
هكذا إذن؟

200
00:14:37,290 --> 00:14:39,620
.كما هو معهودٌ من معلّمة العلوم الاجتماعية

201
00:14:39,620 --> 00:14:40,960
.صحيح

202
00:14:41,770 --> 00:14:44,040
.التخييم ممنوعٌ هنا

203
00:14:44,040 --> 00:14:44,850
ماذا؟

204
00:14:45,720 --> 00:14:47,280
...عذرًا

205
00:14:47,760 --> 00:14:50,380
تحقّقتُ من الأمر في قاعة البلدية

206
00:14:50,380 --> 00:14:53,510
.وأخبروني أنّه لا ضير في التخييم خلال الشتاء

207
00:14:53,510 --> 00:14:54,550
...بخصوص هذا

208
00:14:54,780 --> 00:14:59,810
.منذ بضع سنوات، قرّر مالك المدينة أن يحظر التخييم في الشتاء أيضًا

209
00:15:00,590 --> 00:15:03,020
مـ-ماذا عسانا نفعل؟

210
00:15:07,820 --> 00:15:11,900
.خليجٌ يقع جنوب شرق مدينة شيمودا في شبه جزيرة سوزاكي

211
00:15:11,900 --> 00:15:15,820
.تشتهر المنطقة بحقول النرجس

212
00:15:23,620 --> 00:15:26,090
.أهوى البحر بحق

213
00:15:26,690 --> 00:15:28,420
.بالفعل

214
00:15:28,420 --> 00:15:31,800
—مشاهدتي للبحر تُصفّي كينونتي

215
00:15:40,530 --> 00:15:42,850
.يا له من جرفٍ غريب

216
00:15:43,600 --> 00:15:45,850
.أحد ألغاز الطبيعة

217
00:15:57,470 --> 00:16:02,040
.أعتذر. أنا في خضمّ البحث عن مخيّمٍ لنمكث فيه في الوقت الرّاهن

218
00:16:03,570 --> 00:16:06,420
.لا تدعي هذا يُحبطك يا معلمتي

219
00:16:06,420 --> 00:16:11,630
...ظننتُ أخيرًا أنّ بوسعي الشُّرب خارجًا بعد كلّ هذه المدّة

220
00:16:11,630 --> 00:16:15,300
لربما في المخيمات أماكن خاوية اليوم

221
00:16:15,300 --> 00:16:16,510
.فنحن في الشتاء حاليًا

222
00:16:16,800 --> 00:16:22,480
.لكن إذا لم نجد مكانًا بسرعة، فسيعود صاحب المخيّم أدراجه ليلًا

223
00:16:22,480 --> 00:16:24,850
هذا ما حدث في بحيرة ياماناكا، صح؟

224
00:16:26,780 --> 00:16:30,020
!سيكون لزامًا علينا أن ننام سويًا داخل السيارة

225
00:16:30,450 --> 00:16:32,030
...النوم داخل السيارة

226
00:16:37,910 --> 00:16:39,320
~أنا بالأعلى إذن

227
00:16:39,870 --> 00:16:42,290
ما رأيكنّ أن نسأل إيدا-سان؟

228
00:16:42,920 --> 00:16:45,870
.فهو مخيِّم متمرّس ويقطن في نفس المكان أيضًا

229
00:16:45,870 --> 00:16:47,040
‫بالفعل!

230
00:16:50,550 --> 00:16:52,420
.مرحبًا، إيدا للكحوليات

231
00:16:52,840 --> 00:16:55,300
!عجبًا، تلك التي من بحيرة ياماناكا

232
00:16:55,590 --> 00:16:56,850
ما الخطب؟

233
00:17:03,530 --> 00:17:05,640
لدى إيدا-سان أحدٌ من معارفه الذي يدير مخيّمًا

234
00:17:05,640 --> 00:17:07,690
.وسيدعنا نبيت فيه الليلة

235
00:17:07,950 --> 00:17:09,270
!مرحى

236
00:17:09,270 --> 00:17:11,360
أين يقع هذا المخيّم؟

237
00:17:11,360 --> 00:17:13,940
.قرب شاطئ مدينة نيشيزو

238
00:17:14,870 --> 00:17:18,320
.يبدو قريبًا من دوغاشيما التي سنذهب صوبها بعد غد

239
00:17:18,520 --> 00:17:21,990
.إذن، لنسترخِ في الوقت الراهن ونشدّ رحالنا غدًا

240
00:17:21,990 --> 00:17:25,500
لكن إذا فعلنا هذا، سيتوجّب علينا أن ننعطف

241
00:17:28,330 --> 00:17:29,080
.صدقتِ

242
00:17:29,770 --> 00:17:31,090
أيُمكنني إلقاء نظرة؟

243
00:17:35,630 --> 00:17:38,590
.ثم نشقّ طريقنا بروية بحلول يوم غد

244
00:17:38,590 --> 00:17:41,100
بعدها، ما رأيكنّ أن نتوقف في إيتو خلال عودتنا بعد غد؟

245
00:17:42,010 --> 00:17:43,850
!مسارٌ مثالي

246
00:17:43,850 --> 00:17:45,600
!أنتِ مذهلة يا رين-تشان

247
00:17:45,600 --> 00:17:48,350
.كما عهدته من رحّالةٍ مثلكِ يا شيما-سان

248
00:17:48,790 --> 00:17:50,560
.حسنٌ، لنهُمّ بالذهاب في الحال

249
00:17:50,560 --> 00:17:51,860
!أجل

250
00:17:53,160 --> 00:17:58,100
.سيُكسبنا هذا وقتًا إضافيًا لنُحضّر حيال ليلة يوم غد

251
00:17:58,100 --> 00:17:59,610
."عملية القريدس"

252
00:17:59,770 --> 00:18:00,820
.فهمت

253
00:18:00,820 --> 00:18:02,370
.لا يستهان بك يا رين

254
00:18:02,620 --> 00:18:03,870
هل من خطب؟

255
00:18:05,810 --> 00:18:08,300
.علينا أن نُطلع إينوكو الصغيرة على الأمر أيضًا

256
00:18:47,760 --> 00:18:48,910
!أبصرته

257
00:18:51,450 --> 00:18:52,380
!مذهل

258
00:18:52,380 --> 00:18:54,360
!يبدو مكانًا مبهرًا

259
00:18:58,880 --> 00:19:05,560
نجدٌ شاسع في إيناتوري بمدينة هيغاشيزو
.والمعروف بكثرة سهوله من الحشائش الفضية

260
00:19:06,110 --> 00:19:08,390
يبدو أنّنا فوّتنا الموسم

261
00:19:08,390 --> 00:19:10,560
.مثل نرجس خليج تسوميكي

262
00:19:10,560 --> 00:19:12,560
.ما باليد حيلة

263
00:19:25,690 --> 00:19:27,780
...منظرٌ خلّاب

264
00:19:29,840 --> 00:19:32,310
.سعيدةٌ لقدومي إلى هنا على متن الدراجة

265
00:19:41,790 --> 00:19:43,470
.وصلنا أخيرًا

266
00:19:43,740 --> 00:19:46,680
.مكتوبٌ هنا أنّ الوصول إلى القمة يتطلّب رُبع ساعة

267
00:19:47,420 --> 00:19:48,880
.كتسلّق جبلٍ صغير

268
00:19:48,880 --> 00:19:49,670
.نعم

269
00:19:50,120 --> 00:19:51,520
!ناديشكو-تشان

270
00:19:51,520 --> 00:19:53,140
!لنتسابق حتى القمة

271
00:19:53,140 --> 00:19:55,730
!حسنًا! أقبل تحدّيك

272
00:19:55,960 --> 00:19:58,650
.على الخاسر أن يشتري عصيرًا للفائز

273
00:19:58,650 --> 00:19:59,650
!حسنٌ

274
00:19:59,650 --> 00:20:01,490
...مهلًا، مهلًا، مهلًا

275
00:20:03,540 --> 00:20:05,240
!سأقوم بهذا أيضًا

276
00:20:06,590 --> 00:20:08,200
.مفعماتٌ بالحيوية

277
00:20:08,200 --> 00:20:09,620
.بالفعل

278
00:20:10,360 --> 00:20:12,960
.حسنًا، سنسبقكنّ إلى هناك

279
00:20:13,250 --> 00:20:14,210
.أجل

280
00:20:14,210 --> 00:20:16,250
.سنأخذ وقتنا في الصعود

281
00:20:16,820 --> 00:20:18,380
أأنتِ متأكدة يا أكي؟

282
00:20:18,380 --> 00:20:20,690
.فخصمك هو ناديشكو-تشان

283
00:20:21,600 --> 00:20:23,490
.دعي الأمر لي

284
00:20:25,430 --> 00:20:29,510
.فلم أعُد نفس الفتاة التي ترنّحت في أعلى تل فويفوكي

285
00:20:30,140 --> 00:20:34,460
.صقلتُ عضلات ساقاي بعد العمل الجزئي الذي قمتُ به في عطلة رأس السنة

286
00:20:35,100 --> 00:20:37,150
.حسنٌ، سيكون هذا خط البداية

287
00:20:37,150 --> 00:20:38,690
...استعداد

288
00:20:38,690 --> 00:20:42,670
!هذه هي اللحظة التي ستشهدان فيها تطوّري

289
00:20:42,970 --> 00:20:43,970
!انطلاق

290
00:20:43,970 --> 00:20:45,860
!لأرينّكم

291
00:21:00,630 --> 00:21:02,660
.يا له من منظر خلّاب

292
00:21:02,660 --> 00:21:03,790
.نعم

293
00:21:03,790 --> 00:21:07,050
.من الجيّد أن نتسلّق الجبال بين الفينة والأخرى

294
00:21:07,050 --> 00:21:08,290
.بالفعل

295
00:21:08,710 --> 00:21:12,090
ألا يثير تسلّق الجبال اهتمامكِ يا رين-تشان؟

296
00:21:12,620 --> 00:21:13,920
...تسلق الجبال

297
00:21:14,840 --> 00:21:19,000
لا أظنّ أنّ بوسعي الانضمام مع هؤلاء المتسلّقين
.الذين يحملون مجموعةً ضخمةً من الأغراض

298
00:21:19,750 --> 00:21:23,470
.ولكني أودّ أنّ أبيت في مخيّمٍ خاصٍ بالمتسلّقين يومًا

299
00:21:28,160 --> 00:21:30,880
.عندما يصير الجو دافئًا

300
00:21:31,840 --> 00:21:34,270
.منظرٌ بديعٌ بحق

301
00:21:34,270 --> 00:21:37,190
.أودّ أن آتي مجدّدًا عند حلول موسم العشب الفضي

302
00:21:37,190 --> 00:21:38,670
.هذا صحيح

303
00:21:44,460 --> 00:21:47,430
والآن، هل نذهب؟

304
00:21:47,430 --> 00:21:48,930
.لنهُمّ بالذهاب

305
00:21:53,510 --> 00:21:55,310
.أكي-تشان ميتة

306
00:23:34,930 --> 00:23:40,940
. . . أثـــــــــــنــــــــــــــــاء الـــــــــــتـــــــــــــــخــــــــــــــــــيـــــــــــيـــــــــــــم

307
00:23:34,930 --> 00:23:40,940
نادي نشاطات الهواء الطلق

308
00:23:34,930 --> 00:23:40,940
ضع قواعد المخيّم والمرافق نصب عينيك

309
00:23:34,930 --> 00:23:40,940
!لا تنسَ إخماد النّار ورمي نفاياتك

310
00:23:34,930 --> 00:23:40,940
!يُصبح الجو قارسًا خلال الشتاء، لذا تدفّأ وأعدّ العُدّة

311
00:23:34,930 --> 00:23:40,940
. . . أثـــــــــــنــــــــــــــــاء الـــــــــــتـــــــــــــــخــــــــــــــــــيـــــــــــيـــــــــــــم

312
00:23:34,930 --> 00:23:40,940
نادي نشاطات الهواء الطلق

313
00:23:34,930 --> 00:23:40,940
ضع قواعد المخيّم والمرافق نصب عينيك

314
00:23:34,930 --> 00:23:40,940
!لا تنسَ إخماد النّار ورمي نفاياتك

315
00:23:34,930 --> 00:23:40,940
!يُصبح الجو قارسًا خلال الشتاء، لذا تدفّأ وأعدّ العُدّة