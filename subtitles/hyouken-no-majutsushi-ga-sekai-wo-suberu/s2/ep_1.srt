1
00:00:16,990 --> 00:00:19,290
انظرن، صديقة أُخرى لكُن

2
00:00:19,540 --> 00:00:23,430
ستتصرّفن بشكل مُهذّب الآن، حتّى يوم غد

3
00:00:27,700 --> 00:00:30,670
المعذرة، هل أنتِ بخير؟

4
00:00:30,670 --> 00:00:31,790
أجل

5
00:00:32,330 --> 00:00:34,300
شكراً جزيلاً

6
00:00:35,420 --> 00:00:37,360
المعذرة

7
00:00:43,340 --> 00:00:44,690
لنرَ

8
00:00:51,680 --> 00:00:53,950
هيّا، لنذهب

9
00:00:56,380 --> 00:00:57,520
...حسناً

10
00:01:06,970 --> 00:01:09,340
انتظرنَ هنا قليلاً

11
00:01:11,720 --> 00:01:13,150
مساء الخير

12
00:01:13,150 --> 00:01:14,510
!...أ-أنتِ

13
00:01:15,210 --> 00:01:16,970
!كيف تجرئين؟

14
00:01:17,110 --> 00:01:18,980
!مؤلم

15
00:01:21,650 --> 00:01:23,480
شكراً على الانتظار

16
00:01:24,330 --> 00:01:25,950
والآن، لنذهب

17
00:01:25,950 --> 00:01:27,490
...حـ-حسناً

18
00:01:31,680 --> 00:01:33,230
ما هذا؟

19
00:01:33,230 --> 00:01:35,230
إلى أين تعتقدن أنّكن ذاهبات؟

20
00:01:37,090 --> 00:01:39,990
—لا أعرف كيف خرجتُن، لكن

21
00:01:52,060 --> 00:01:53,500
آسفة بشأن ذلك

22
00:01:53,760 --> 00:01:55,440
أنتن بأمان الآن

23
00:02:11,430 --> 00:02:13,030
!كنّا خائفات للغاية

24
00:02:13,030 --> 00:02:14,250
!شكراً لكِ

25
00:02:14,250 --> 00:02:18,730
!شكراً جزيلاً لكِ

26
00:02:18,730 --> 00:02:20,030
!شكراً لكِ

27
00:02:21,380 --> 00:02:24,300
اهدئي من فضلكِ يا سموّ الأميرة أوليفيا

28
00:02:25,030 --> 00:02:27,540
كيف... كيف عرفتِ اسمي؟

29
00:02:27,870 --> 00:02:29,820
يسرّني أنّكِ بأمان

30
00:02:29,820 --> 00:02:32,230
أوليفيا آرنولد، الوريثة الثّانية
للعرش تسلسليّاً

31
00:02:33,720 --> 00:02:36,290
...المعذرة، أنتِ

32
00:02:36,290 --> 00:02:39,310
أنا نجميّة من جيش آرنولد

33
00:02:39,310 --> 00:02:40,890
اسمي هو ليلي

34
00:02:45,190 --> 00:02:50,090
كان ذلك عندما التقيتُ
براي أوّل مرّة

35
00:03:03,740 --> 00:03:06,280
أحتاج لمزيد من راي في حياتي

36
00:03:34,110 --> 00:03:35,630
صباح الخير يا راي

37
00:03:35,630 --> 00:03:36,740
صباح الخير يا إيليسا

38
00:03:36,740 --> 00:03:38,680
هل كُلّ شيء على ما يُرام؟

39
00:03:38,680 --> 00:03:41,690
أجل. تبدين مُختلفة عن المعتاد

40
00:03:41,690 --> 00:03:42,840
حقّاً؟

41
00:03:42,840 --> 00:03:45,430
لكن نفس الأمر ينطبق عليك

42
00:03:45,430 --> 00:03:46,370
أوتظنّين ذلك؟

43
00:04:05,850 --> 00:04:07,950
بخصوص الحادثة قبل أيّام

44
00:04:07,950 --> 00:04:11,420
تقلنَ بأنّ إيفان بيرنشتاين تصرّفَ
من تلقاء نفسه؟

45
00:04:11,420 --> 00:04:15,120
لا تحرُّكات من قوّات اليوجينيّين
،الرّئيسيّة حتّى الآن

46
00:04:15,120 --> 00:04:17,080
لذا هذا افتراضٌ مقبول

47
00:04:17,080 --> 00:04:21,220
وباراتروغو الّذي أعانه مُحتجز
بأمان في سجن خاصّ

48
00:04:21,870 --> 00:04:23,330
...إيفان قد

49
00:04:23,700 --> 00:04:25,920
مات...

50
00:04:26,690 --> 00:04:30,210
تولّتْ عشيرةُ هيل المُخلّفات

51
00:04:32,000 --> 00:04:35,700
بالمُناسبة يا ليديا، كيف حاله؟

52
00:04:36,490 --> 00:04:37,680
هو؟

53
00:04:37,680 --> 00:04:39,290
إنّه بخير

54
00:04:39,290 --> 00:04:41,720
يعيش حياته المدرسيّة هو وأصدقاؤه

55
00:04:42,600 --> 00:04:47,850
أعتقد بأنّ تلك البيئة تؤثِّر إيجابيّاً عليه الآن

56
00:04:48,780 --> 00:04:53,250
قد يحدث ذلك في وقت أقرب من المُتوقَّع

57
00:04:54,660 --> 00:04:56,170
هل سمعتُن؟

58
00:04:56,170 --> 00:04:57,480
تقصدين ذلك الشّيء؟

59
00:04:57,480 --> 00:04:59,600
...إنّه بخصوص وايت، إذاً

60
00:04:59,600 --> 00:05:00,570
!ماذا؟

61
00:05:01,320 --> 00:05:04,280
!لا! أتحدّث عن حرب ماجيكس

62
00:05:01,320 --> 00:05:04,940
...ذلك الشّيء... ذلك الشّيء

63
00:05:04,940 --> 00:05:10,500
معركة الفِرق الجديدة كُلّياً الّتي
لا تقتصر على مدرسة أو عام؟

64
00:05:10,740 --> 00:05:13,690
سمعتُ بأنّها ستُقام قبل حدث الجوقة

65
00:05:13,990 --> 00:05:15,890
...الشّيء المُتعلِّق بوايت

66
00:05:15,890 --> 00:05:16,850
ويحكِ

67
00:05:17,700 --> 00:05:20,260
ثلاثة أشخاص لكلّ فريق، أليس كذلك؟

68
00:05:20,260 --> 00:05:22,500
أنا واثقة بأنّ آل يريد المُشاركة، صحيح؟

69
00:05:22,500 --> 00:05:27,650
،أجل، لكن إذا كان وايزل وأنا
فسنُشكّل عقبةً في وجه آل، صحيح؟

70
00:05:27,880 --> 00:05:32,760
تعلم بأنّ هذا يعني بأنّكم ستُقصَون
بشكل فوريّ، صحيح؟

71
00:05:32,760 --> 00:05:34,020
صحيح؟

72
00:05:34,020 --> 00:05:38,270
سبب ذهابه إلى مكانٍ ما مع إيفي
...مؤخّراً هو

73
00:05:40,080 --> 00:05:42,560
...واسعا الصّدر ذلكما

74
00:05:42,560 --> 00:05:43,450
!صخب

75
00:05:43,450 --> 00:05:44,520
!عضل

76
00:05:45,480 --> 00:05:46,780
أنتم

77
00:05:47,380 --> 00:05:50,280
ماذا سيحدث يا تُرى إذاً؟

78
00:05:50,280 --> 00:05:53,830
أقصد بأنّ أميليا هي البطلة الجديدة
للفروسيّة السّحريّة

79
00:05:55,140 --> 00:05:57,990
لا أظنّها مهتمّة كثيراً

80
00:05:57,990 --> 00:05:59,660
أعتقد بأنّ هذا منطقيّ

81
00:05:59,660 --> 00:06:02,550
لا تملك سبباً غالباً للمُشاركة
في المُنافسة

82
00:06:02,550 --> 00:06:03,880
أجل

83
00:06:10,940 --> 00:06:12,990
...مشاعري

84
00:06:13,520 --> 00:06:18,840
بدأتُ أقرأ رواية الحُبّ هذه من تأليف
...لونا إيثر لأنّ راي كان يقرأها

85
00:06:20,050 --> 00:06:23,320
لم أتوقّع أبداً أن تخترق روحي هكذا

86
00:06:24,190 --> 00:06:25,250
—لا ستا

87
00:06:27,540 --> 00:06:29,010
من الطّارق؟

88
00:06:29,010 --> 00:06:33,570
أميليا، أريدكِ أن تُنافسي في
حرب ماجيكس" معي"

89
00:06:33,970 --> 00:06:36,390
أميليا، افتحي من فضلكِ

90
00:06:36,390 --> 00:06:37,570
!أميليا؟

91
00:06:37,920 --> 00:06:39,460
قادمة

92
00:06:39,460 --> 00:06:44,190
أميليا، هل ستُشاركين في حرب
ماجيكس... معنا؟

93
00:06:53,200 --> 00:06:55,230
إنّه ذلك الشّيء غالباً، صحيح؟

94
00:06:56,340 --> 00:06:57,600
!بالفعل

95
00:06:58,730 --> 00:07:00,580
ماذا عنك يا راي؟

96
00:07:00,580 --> 00:07:04,110
،سأتكلّم مع مُعلّمتي بشأن ذلك
لكن أرغب في المُشاركة

97
00:07:04,900 --> 00:07:06,360
هل أنت مُهيّأ؟

98
00:07:06,360 --> 00:07:09,740
،هذا رأيي الشّخصيّ فحسب
لكن وضعي مقبول

99
00:07:09,740 --> 00:07:10,850
هكذا إذاً

100
00:07:12,660 --> 00:07:16,110
المعذرة، هل تُواجه مُشكلة يا راي؟

101
00:07:16,940 --> 00:07:20,450
،اسمع، إن كنّا سنُشكّل فريقاً

102
00:07:20,450 --> 00:07:23,480
ألا ينبغي أن تشرح لآرياني
ما سيحدث فعليّاً؟

103
00:07:23,480 --> 00:07:25,000
معكِ حقّ

104
00:07:25,000 --> 00:07:27,530
ينبغي أن أقدّم لها شرحاً واضحاً

105
00:07:27,980 --> 00:07:29,870
عمّاذا تتكلّمان؟

106
00:07:29,870 --> 00:07:34,390
آرياني، أنا ساحر نصل الجليد

107
00:07:36,090 --> 00:07:36,960
ماذا؟

108
00:07:37,500 --> 00:07:39,410
انتظر لحظة من فضلك

109
00:07:39,410 --> 00:07:43,920
،أنا متأكّدة بأنّني لم أسمع جيّداً
لذا هلّا كرّرت ذلك من فضلك؟

110
00:07:44,580 --> 00:07:46,910
،أنا أحد السّحرة العُظماء السّبعة

111
00:07:47,410 --> 00:07:49,280
ساحر نصل الجليد

112
00:07:50,930 --> 00:07:52,030
!أميليا؟

113
00:07:53,130 --> 00:07:54,200
أجل

114
00:07:54,200 --> 00:07:56,280
منذ متى تعرفين؟

115
00:07:56,280 --> 00:08:01,150
منذ ما قبل الفروسيّة السّحريّة على ما أعتقد

116
00:08:02,570 --> 00:08:03,810
هذا ليس مُنصِفاً

117
00:08:04,800 --> 00:08:06,270
!هذا ليس مُنصِفاً على الإطلاق

118
00:08:06,790 --> 00:08:10,090
سمعتُ بأنّكما كنتُما تتدرّبان معاً

119
00:08:10,090 --> 00:08:13,090
لكن لم أفهم أبداً لِمَ كنتِ
تتدرّبين مع راي

120
00:08:13,090 --> 00:08:15,790
!لطالما أزعجني ذلك

121
00:08:16,040 --> 00:08:18,550
!هذا ما كان يجري إذاً

122
00:08:18,880 --> 00:08:20,650
...سأقولها ثانية

123
00:08:21,430 --> 00:08:22,680
!هذا ليس مُنصِفاً على الإطلاق

124
00:08:22,680 --> 00:08:24,560
!حظيتِ بتدريب فرديّ

125
00:08:24,560 --> 00:08:26,850
!من شخص مُذهل كهذا

126
00:08:27,690 --> 00:08:31,810
المعذرة، أنا آسفة

127
00:08:33,190 --> 00:08:36,310
آرياني، أنتِ تُصدّقينني إذاً؟

128
00:08:37,880 --> 00:08:40,690
هذا يُفسِّر حتماً كثيراً من الغموض

129
00:08:40,690 --> 00:08:42,320
...آرياني

130
00:08:42,510 --> 00:08:44,590
لذا... أجل

131
00:08:45,670 --> 00:08:49,190
إذاً لنتكلّم عن الماضي قليلاً

132
00:08:51,190 --> 00:08:53,750
حسناً، ماذا ستفعلنَ عقب هذا؟

133
00:08:53,750 --> 00:08:54,860
أتُرِدنَ الشّرب؟

134
00:08:54,860 --> 00:08:57,470
لِمَ لا؟ ماذا عنكِ يا ليديا؟

135
00:08:57,470 --> 00:08:59,620
أعتقد لا ضير من ذلك بين الحين والآخر

136
00:08:59,620 --> 00:09:00,840
ما رأيكِ يا كارلا؟

137
00:09:00,840 --> 00:09:03,040
أجل، سأنضمّ

138
00:09:03,040 --> 00:09:04,530
ليديا-سينباي

139
00:09:05,470 --> 00:09:07,230
أريد التكلُّم معكِ

140
00:09:07,230 --> 00:09:09,140
!هذا يعني بأنّكِ ستأتين أيضاً إذاً

141
00:09:09,140 --> 00:09:10,220
عفواً؟

142
00:09:15,100 --> 00:09:18,510
وهكذا أصبحتُ هنا الآن

143
00:09:21,470 --> 00:09:23,620
!كم هذا فظيع

144
00:09:24,660 --> 00:09:29,590
حرب الشّرق الأقصى كانت أوّل حرب
...استُخدِمَ فيها سحر في معارك حقيقيّة

145
00:09:29,590 --> 00:09:32,970
سمعتُ بأنّها كانت أسوأ حرب على الإطلاق

146
00:09:33,560 --> 00:09:37,230
وكنتَ في خطوط الجبهة هناك
...عن عمر صغير كهذا

147
00:09:40,370 --> 00:09:43,830
لكن هناك التقيتُ بمُعلّمتي والآخرين

148
00:09:43,830 --> 00:09:45,760
وها أنا هنا الآن

149
00:09:45,760 --> 00:09:50,020
إذاً تلك المُعلِّمة هي الّتي منحَتْك لقبَ
نصل الجليد بعد انتهاء الحرب؟

150
00:09:50,020 --> 00:09:51,100
أجل

151
00:09:51,100 --> 00:09:54,880
الحماوة الزّائدة تعني بأنّني ما زلتُ
،لا أستطيع تحرير قوّتها الكاملة

152
00:09:55,350 --> 00:09:58,080
لكن ورثتُ الاسم والمركز من مُعلّمتي

153
00:09:59,980 --> 00:10:01,020
...راي

154
00:10:03,540 --> 00:10:05,030
!أتحدّاك

155
00:10:05,030 --> 00:10:06,850
لحظة، ماذا؟

156
00:10:06,850 --> 00:10:08,510
لماذا تفعلين هذا؟

157
00:10:08,510 --> 00:10:11,790
!أميليا، هذا قدَري كعذراء

158
00:10:11,790 --> 00:10:14,290
قدَركِ كماذا الآن؟

159
00:10:16,780 --> 00:10:17,910
ما الشّروط؟

160
00:10:17,910 --> 00:10:20,690
من يقول "أستسلم" يخسر

161
00:10:21,110 --> 00:10:22,440
عُلِم

162
00:10:23,400 --> 00:10:25,550
لم نكن قد حظينا بفُرصة منذ المرّة الماضية

163
00:10:25,820 --> 00:10:26,860
هذا صحيح

164
00:10:26,860 --> 00:10:27,690
...في الواقع

165
00:10:27,690 --> 00:10:30,190
كانت الأمور مُختلفة قليلاً آنذاك

166
00:10:31,020 --> 00:10:33,680
أميليا، هلّا أدّيتِ دور الحكم؟

167
00:10:33,960 --> 00:10:34,990
حسناً

168
00:10:34,990 --> 00:10:36,690
لكن هل أنت متأكّدٌ من هذا؟

169
00:10:36,690 --> 00:10:39,940
انتهى المطاف باستخدامِك قِواك
مع ريبيكا-سينباي أيضاً

170
00:10:41,210 --> 00:10:42,270
أجل

171
00:10:42,270 --> 00:10:44,600
لكن هذه المرّة، لن أستخدمها

172
00:10:44,600 --> 00:10:47,090
وتعتقد بأنّك ستهزم آرياني بهذا الشّكل؟

173
00:10:47,090 --> 00:10:49,820
حسناً، سأحاول

174
00:10:50,160 --> 00:10:52,830
!إذاً، فلنبدأ

175
00:10:52,830 --> 00:10:54,080
!غول

176
00:11:07,880 --> 00:11:10,610
أ... أستسلم

177
00:11:11,660 --> 00:11:13,920
هل استخدمت سحراً من نوع خاصّ؟

178
00:11:13,920 --> 00:11:14,950
لا

179
00:11:14,950 --> 00:11:17,650
مُجرّد شفرة داخليّة لتعزيز جسدي

180
00:11:17,980 --> 00:11:19,510
!لا بُدّ أنّك تكذب

181
00:11:19,510 --> 00:11:23,300
"مُحال أن تتمكّن من هزيمة "غول
!خاصّتي بشفرة داخليّة فقط

182
00:11:23,730 --> 00:11:26,240
لا توجد أكاذيب هنا

183
00:11:28,040 --> 00:11:30,990
...إذاً هذه هي قوّة أحد العظماء السّبعة

184
00:11:31,310 --> 00:11:33,500
،حتّى وأنت لست بكامل قوّتك

185
00:11:33,500 --> 00:11:35,840
هزمتَني هزيمة نكراء

186
00:11:35,840 --> 00:11:36,950
آرياني

187
00:11:37,580 --> 00:11:41,830
كان هذا النّصر مُمكناً فقط
لأنّني كشفتُ نقطةَ ضعفكِ

188
00:11:41,830 --> 00:11:43,500
نقطة ضعفي؟

189
00:11:43,500 --> 00:11:46,010
!لديكِ إمكانيّة كبيرة للتحسُّن

190
00:11:47,000 --> 00:11:50,140
آرياني، هل تريدين أن تُصبحي أقوى؟

191
00:11:51,740 --> 00:11:53,310
!بالطّبع

192
00:11:53,310 --> 00:11:54,770
هكذا تكون المعنويّات

193
00:11:54,950 --> 00:11:56,700
!حسناً إذاً يا آرياني ألغرين

194
00:11:57,190 --> 00:12:01,270
