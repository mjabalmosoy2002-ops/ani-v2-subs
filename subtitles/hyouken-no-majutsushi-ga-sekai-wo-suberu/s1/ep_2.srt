1
00:00:06,540 --> 00:00:08,770
ها أنا ذا، هل أنت جاهز يا راي؟

2
00:00:08,770 --> 00:00:10,730
!أجل، أنا جاهز. هيّا

3
00:00:31,010 --> 00:00:32,510
...بعد التّدريب

4
00:00:32,510 --> 00:00:34,270
!يأتي دور البروتين

5
00:00:36,030 --> 00:00:38,110
إذاً أنت في ناديّين في آن واحد؟

6
00:00:38,630 --> 00:00:39,520
أجل

7
00:00:39,830 --> 00:00:41,890
أخيراً نحن هنا في هذه الأكاديميّة

8
00:00:41,890 --> 00:00:44,020
أريد فعل كلّ ما أستطيع فعله

9
00:00:44,020 --> 00:00:46,880
هكذا إذاً، لكن سيكون ذلك صعباً

10
00:00:46,880 --> 00:00:48,460
لا تقلق بشأني

11
00:00:48,460 --> 00:00:50,890
لديّ هذه

12
00:00:51,540 --> 00:00:54,030
هل أنت جادّ؟

13
00:02:28,500 --> 00:02:29,720
!المعذرة

14
00:02:38,950 --> 00:02:39,930
أتيت إذاً

15
00:02:40,590 --> 00:02:42,260
!اسمي راي وايت

16
00:02:42,750 --> 00:02:45,770
يبدو أنّك تريد الانضمام لنادي البحث البيئي

17
00:02:45,770 --> 00:02:47,220
!نادي البحث البيئي

18
00:02:47,220 --> 00:02:49,340
،معنى هذا بأنّنا نستكشف الغابات

19
00:02:49,340 --> 00:02:52,550
!والأنهار، وصولاً للمناطق الجليديّة

20
00:02:52,550 --> 00:02:55,310
!أولئك الّذين يجرون بحثاً بيئيّاً لا يهابون شيئاً

21
00:02:55,310 --> 00:02:56,330
...يلقّبنا النّاس

22
00:02:56,330 --> 00:02:57,580
!بالصيّادين...

23
00:02:57,580 --> 00:03:01,070
نحن غير عنصريّين تجاه العاديّين

24
00:03:01,310 --> 00:03:04,160
غير أنّ الشّخص ذا الجسد الهزيل
أو العقل الضّعيف

25
00:03:04,160 --> 00:03:06,010
لا يستطيع تحمُّل نادي البحث البيئي

26
00:03:06,010 --> 00:03:07,590
هزيل بعض الشّيء

27
00:03:07,590 --> 00:03:09,350
...لا عضلات كافية

28
00:03:13,430 --> 00:03:14,810
!اخلع ملابسك أوّلاً

29
00:03:14,810 --> 00:03:16,010
!حينئذ سنتكلّم

30
00:03:16,350 --> 00:03:17,930
!حاضر

31
00:03:17,930 --> 00:03:19,510
!عضلات

32
00:03:26,800 --> 00:03:29,200
!انظروا إلى هذه العضلات

33
00:03:27,550 --> 00:03:30,410
!أعتقد يبدو نحيلاً بالملابس فقط

34
00:03:30,410 --> 00:03:33,960
إنّه ضخم! إنّه ضخم لدرجة أنّه
!عليه غالباً دفع ضريبة مُمتلكات

35
00:03:33,960 --> 00:03:35,490
عضلات جميلة

36
00:03:35,490 --> 00:03:36,850
،إنّها ليست للاستعراض فقط أيضاً

37
00:03:36,850 --> 00:03:39,770
حصلتَ عليها باستخدام جسدك في الواقع

38
00:03:41,820 --> 00:03:43,610
تدرّبتُ في الغابات الخلفيّة

39
00:03:44,400 --> 00:03:45,920
راي إذاً؟

40
00:03:45,920 --> 00:03:48,330
لديك واحدة من هذه، صحيح؟

41
00:03:49,120 --> 00:03:52,010
لديك بصيرة حادّة يا سيّد

42
00:03:53,830 --> 00:03:57,350
رخصة صائد ذهبيّ؟

43
00:03:56,160 --> 00:03:58,780
!عاديّ يملك ذهبيّة؟

44
00:03:57,920 --> 00:03:59,310
،حتّى بين الصيّادين

45
00:03:59,310 --> 00:04:01,830
!الصّائد الذهبيّ بمستوى آخر

46
00:04:02,160 --> 00:04:04,090
لكن هذا منطقيّ إذاً

47
00:04:04,090 --> 00:04:06,380
!فالعضلات أمر مهيب

48
00:04:07,190 --> 00:04:09,110
إمكانيّة بارزة

49
00:04:15,340 --> 00:04:18,340
راي، كُن عموداً لنادي البحث البيئي

50
00:04:18,850 --> 00:04:20,720
سيكون هذا من دواعي سروري

51
00:04:30,450 --> 00:04:31,330
!المعذرة

52
00:04:38,510 --> 00:04:40,830
يا إلهي. راي؟

53
00:04:41,750 --> 00:04:43,830
أنت... ترغب في الانضمام؟

54
00:04:43,830 --> 00:04:44,610
أجل

55
00:04:44,610 --> 00:04:47,590
أنا مهتمّ بالنّباتات الّتي تعيش بحيويّة شديدة

56
00:04:48,400 --> 00:04:50,310
،حتّى في أفظع بيئة مُمكنة

57
00:04:50,720 --> 00:04:52,750
يمكنكِ أن تجدي زهرة

58
00:04:53,880 --> 00:04:56,230
ولو كانت في ساحة معركة

59
00:04:57,440 --> 00:04:59,270
تحبّ الزّهور إذاً

60
00:05:00,280 --> 00:05:01,280
أجل

61
00:05:01,600 --> 00:05:04,100
لكن ليس لدينا أيّ أعضاء ذكور آخرين

62
00:05:04,100 --> 00:05:06,040
هل أنت راضٍ عن هذا؟

63
00:05:06,040 --> 00:05:08,860
لا مشكلة لديّ في التّواصل مع النّساء

64
00:05:08,860 --> 00:05:09,970
...حسناً، في هذه الحالة

65
00:05:10,300 --> 00:05:11,520
!أعترض

66
00:05:12,860 --> 00:05:14,400
دينا؟

67
00:05:14,400 --> 00:05:17,410
!من الواضح أنّه يضع نُصب عينيه عليكِ

68
00:05:17,410 --> 00:05:20,310
لا يمكننا السّماح لذكر بالدّخول إلى حديقة الزّهور

69
00:05:20,310 --> 00:05:22,180
ستذبل الزّهور

70
00:05:22,180 --> 00:05:24,860
ناهيكِ عن أنّ هذا الشّخص عاديّ

71
00:05:28,110 --> 00:05:29,730
إذاً لنفعل هذا

72
00:05:29,730 --> 00:05:32,530
سأوكل قضيّة راي إلى دينا

73
00:05:32,530 --> 00:05:33,680
!أنا؟

74
00:05:33,680 --> 00:05:34,680
هذا صحيح

75
00:05:34,680 --> 00:05:37,100
،إذا وجدتِ بأنّه غير جدير بعد تقييمكِ

76
00:05:37,100 --> 00:05:39,120
يمكنكِ رفض طلب انتسابه

77
00:05:39,120 --> 00:05:41,200
عـُ-عُلِم

78
00:05:41,200 --> 00:05:42,600
!شكراً جزيلاً لكِ

79
00:05:43,100 --> 00:05:44,190
...المعذرة

80
00:05:45,130 --> 00:05:47,650
اسمي دينا سيرا. أنا سنة ثالثة

81
00:05:47,650 --> 00:05:49,830
أتطلّع قُدماً للعمل معك يا سيرا سينباي

82
00:05:50,750 --> 00:05:53,780
!من الواضح أنّك ستكشف نواياك الحقيقيّة قريبباً

83
00:05:56,260 --> 00:05:58,700
ستحضّر هذه المساحة

84
00:05:58,700 --> 00:06:01,490
سنبني حديقة جديدة إذاً

85
00:06:01,490 --> 00:06:02,600
هذا صحيح

86
00:06:02,600 --> 00:06:05,220
من الرّائع أن تسمح لنا الأكاديميّة
،باستخدام هذه المساحة

87
00:06:05,220 --> 00:06:08,020
لكنّها مليئة بالأعشب والتّربة
غير صالحة بعد أيضاً

88
00:06:08,020 --> 00:06:09,220
أمامنا طريق طويل

89
00:06:09,610 --> 00:06:11,530
إذاً هذا اختبار دخولي للنّادي؟

90
00:06:11,530 --> 00:06:12,980
أمامك أسبوع واحد

91
00:06:12,980 --> 00:06:14,410
وعليك فعلها بمفردك

92
00:06:14,410 --> 00:06:15,550
عُلِم

93
00:06:15,550 --> 00:06:17,200
حظّاً سعيداً إذاً

94
00:06:17,200 --> 00:06:18,890
مع أنّ الحظّ لن ينفعك

95
00:06:20,550 --> 00:06:21,460
حسناً

96
00:06:21,460 --> 00:06:22,460
هل نبدأ؟

97
00:07:11,230 --> 00:07:13,490
يبدو هذا جيّداً

98
00:07:13,490 --> 00:07:15,240
عملتَ بجدّ حقّاً

99
00:07:21,920 --> 00:07:23,010
!هذا شهيّ

100
00:07:23,010 --> 00:07:24,290
يسرّني هذا

101
00:07:24,290 --> 00:07:27,110
،أحبّ حقّاً شطائر الفاكهة هذه

102
00:07:27,110 --> 00:07:30,080
لذا تفاوضتُ مع المدرسة وذلك كي نحصل عليها

103
00:07:30,080 --> 00:07:32,090
هل من الممكن فعل شيء كهذا؟

104
00:07:32,090 --> 00:07:34,910
هذا لأنّني رئيسة مجلس الطّلبة

105
00:07:36,240 --> 00:07:39,020
أنتِ من أبرز ثلاث عائلات ورئيسة مجلس الطّلبة

106
00:07:39,020 --> 00:07:41,380
أنتِ مُذهلة حقّاً

107
00:07:41,820 --> 00:07:43,780
إذا كان لديك أيّ سؤال، يمكنك اللّجوء إليّ

108
00:07:50,840 --> 00:07:53,430
صحيح، اقتربت الفروسيّة السحريّة

109
00:07:53,430 --> 00:07:55,270
فروسيّة السحريّة؟

110
00:07:55,270 --> 00:07:59,790
إنّها مُنافسة على أفضل مُقاتل بالسّيف السحريّ

111
00:07:59,790 --> 00:08:01,530
الأقوى... قلتِ؟

112
00:08:01,910 --> 00:08:04,220
لن تشارك؟

113
00:08:05,030 --> 00:08:06,570
سأفكّر في الأمر

114
00:08:13,820 --> 00:08:15,430
ريبيكا؟

115
00:08:15,430 --> 00:08:17,850
هل تمانع أن ألمسها قليلاً؟

116
00:08:19,660 --> 00:08:20,520
تفضّلي

117
00:08:21,000 --> 00:08:21,900
حسناً

118
00:08:25,130 --> 00:08:26,320
!رائع

119
00:08:26,320 --> 00:08:27,190
!قاسية جدّاً

120
00:08:27,470 --> 00:08:30,240
!عضلة العضد لها قوام وملمس ممتاز

121
00:08:30,970 --> 00:08:33,190
تدرّبتُ في الغابات الخلفيّة

122
00:08:33,190 --> 00:08:34,580
!هذا مُذهل

123
00:08:34,880 --> 00:08:37,480
هذه أوّل مرّة ألمس فيها عضلات رجل

124
00:08:37,480 --> 00:08:38,580
!هذا من باب التعلّم

125
00:08:38,580 --> 00:08:40,550
أليس هو ذلك السّافر؟

126
00:08:40,550 --> 00:08:42,310
،أتساءل إن كانت أميليا وحدها غير كافية

127
00:08:42,310 --> 00:08:45,230
لهذا يحاول أن يتودّد إلى ريبيكا
من أبرز العائلات النّبيلة الثّلاث

128
00:08:45,230 --> 00:08:48,670
هذه هي العقليّة المُنحرفة الطبيعيّة لشخص عاديّ

129
00:08:56,510 --> 00:08:58,710
كيف وجدتِني يا سيرا سينباي؟

130
00:08:59,300 --> 00:09:00,490
ـحت...

131
00:09:01,280 --> 00:09:02,560
!نجحت

132
00:09:03,630 --> 00:09:05,070
!شكراً جزيلاً لكِ

133
00:09:05,810 --> 00:09:08,690
إذاً لنزرع زهوراً جديدة هنا

134
00:09:08,960 --> 00:09:09,850
!حسناً

135
00:09:17,130 --> 00:09:20,080
راي. لديّ شيء أودّ منك أن تفعله

136
00:09:21,480 --> 00:09:22,870
دعيني ألقي نظرة

137
00:09:25,480 --> 00:09:28,970
جاسوس من الإمبراطوريّة داخل المملكة؟

138
00:09:28,970 --> 00:09:30,020
هذا صحيح

139
00:09:30,020 --> 00:09:32,800
هناك احتمال بأنّ حتّى هذه الأكاديميّة مُخترَقة

140
00:09:32,800 --> 00:09:35,280
،تمّ إبلاغ الطاقم كذلك

141
00:09:35,280 --> 00:09:37,880
لكن إذا توصّلت لأيّ شيء، أخبرني

142
00:09:38,350 --> 00:09:39,590
عُلِم

143
00:09:39,590 --> 00:09:40,810
أعتذر

144
00:09:40,810 --> 00:09:44,100
لكن الأوضاع في المملكة فوضويّة جدّاً الآن

145
00:09:44,100 --> 00:09:46,830
حبّذا لو تحلّ هذه المُشكلة سرّاً إن أمكن

146
00:09:49,980 --> 00:09:51,090
كلاريس؟

147
00:09:53,850 --> 00:09:55,170
راي؟

148
00:09:55,170 --> 00:09:58,480
!لماذا تتكلّم معي فجأة هكذا؟ أفزعتني

149
00:09:58,480 --> 00:10:00,030
أعتذر على ذلك

150
00:10:00,030 --> 00:10:02,860
لكن ماذا تفعلين جاثمة هكذا هنا؟

151
00:10:04,900 --> 00:10:06,700
كنتُ أراقب بعض قمل الخشب

152
00:10:06,700 --> 00:10:07,510
قمل الخشب؟

153
00:10:08,230 --> 00:10:11,930
أعلم أنّه من الغريب لابنة عائلة نبيلة
رفيعة المستوى أن تحبّ الحشرات

154
00:10:12,300 --> 00:10:16,960
الآخرون يحبّون الكلاب أو القطط
أو نوعاً آخر من الحيوانات الظريفة

155
00:10:16,960 --> 00:10:19,460
لهذا لا أملك كثيراً من الأصدقاء

156
00:10:19,460 --> 00:10:21,840
لكن هذا جزء من طبيعتكِ

157
00:10:21,840 --> 00:10:23,490
أرى هذا أمراً مُبهراً

158
00:10:24,990 --> 00:10:26,130
لا تعتبر هذا غريباً؟

159
00:10:26,130 --> 00:10:27,110
!قلتُ بأنّني أحبُّ الحشرات

160
00:10:27,460 --> 00:10:29,320
أحبُّ الحشرات أيضاً

161
00:10:29,320 --> 00:10:31,590
شرف لي أن أكون صديقكِ

162
00:10:32,100 --> 00:10:33,570
صـ-صديقي؟

163
00:10:33,570 --> 00:10:38,370
!هـ-هـ-هـ-هل قلت أن نكون صـ-صـ-صديقين؟

164
00:10:38,370 --> 00:10:39,700
أنا آسف

165
00:10:39,700 --> 00:10:43,140
،بدا لسبب ما أنّنا نستطيع أن نتكلّم بأريحيّة

166
00:10:43,140 --> 00:10:45,090
لذا ربّما أكون قد بالغتُ في التّقدير

167
00:10:45,090 --> 00:10:46,590
هل أهنتُكِ؟

168
00:10:46,590 --> 00:10:49,170
...صديقان؟ لم أحصل أبداً

169
00:10:49,940 --> 00:10:51,870
أعني حسناً إذا كان هذا ما تريده

170
00:10:51,870 --> 00:10:53,620
حقّاً؟ يسرّني هذا

171
00:10:54,080 --> 00:10:56,740
!مرحى! صديقي الأوّل على الإطلاق

172
00:10:56,740 --> 00:10:58,540
!تعرّفتُ على صديق فعلاً

173
00:10:58,540 --> 00:10:59,630
ما المُشكلة؟

174
00:10:59,930 --> 00:11:01,490
!لا أبداً

175
00:11:01,490 --> 00:11:02,460
هكذا إذاً

176
00:11:02,460 --> 00:11:04,470
،بدأت الشّمس تغرب

177
00:11:04,470 --> 00:11:08,940
لكن حبّذا لو أتكلّم عن الحشرات المُتنوّعة
الّتي رأيتُها في الأدغال ذات يوم

178
00:11:08,940 --> 00:11:10,570
!بالتفصيل المُملّ

179
00:11:10,570 --> 00:11:11,640
!عِدني

180
00:11:11,640 --> 00:11:13,340
أجل، أعِدُكِ

181
00:11:13,340 --> 00:11:15,930
بالإضافة إلى ذلك، التكلّم معكِ مُمتع للغاية

182
00:11:17,310 --> 00:11:19,490
أعتقد لا أملك خياراً

183
00:11:19,490 --> 00:11:22,370
بما أنّك مُصرّ، سأتماشى معك

184
00:11:22,370 --> 00:11:23,530
إلى اللّقاء

185
00:11:26,010 --> 00:11:27,970
أتطلّع قُدماً لذلك

186
00:11:30,630 --> 00:11:33,950
اليوم، سنتحدّث عن مُشتقّات السّحر

187
00:11:34,320 --> 00:11:36,750
،هذا الموضوع تِقنيّ بحت

188
00:11:36,750 --> 00:11:38,620
لكن هل هناك أيّ شخص يستطيع تقديم شرح؟

189
00:11:39,110 --> 00:11:40,130
راي وايت

190
00:11:40,130 --> 00:11:41,410
ما رأيك بتجربة ذلك؟

191
00:11:41,410 --> 00:11:42,540
حاضر

192
00:11:42,540 --> 00:11:44,990
السّحر مُصنَّف بصورة رئيسيّة إلى درجة مُنخفضة

193
00:11:44,990 --> 00:11:47,390
ومُتوسّطة وعالية ومُقدّسة

194
00:11:48,420 --> 00:11:51,080
،بالإضافة إلى سريعة

195
00:11:52,490 --> 00:11:53,460
،وعن بُعد

196
00:11:55,550 --> 00:11:56,390
،وتسلسليّة

197
00:11:59,730 --> 00:12:00,610
،تأخيريّة

198
00:12:02,990 --> 00:12:04,170
،تغيير مادّي

199
00:12:06,020 --> 00:12:07,170
،توسّعيّة

200
00:12:10,350 --> 00:12:12,160
تسلسليّة توسّعيّة

201
00:12:12,160 --> 00:12:15,170
آنِفة الذّكر هي المُشتقّات السّبعة

202
00:12:15,170 --> 00:12:17,020
وايت على حقّ تماماً

203
00:12:17,020 --> 00:12:18,520
درستَ بجدّ حقّاً

204
00:12:18,520 --> 00:12:19,530
شكراً

205
00:12:28,380 --> 00:12:30,060
هذا كلّ شيء لليوم

206
00:12:30,060 --> 00:12:34,220
وأيضاً سنؤدّي تمريننا العمليّ في غابة كافكا

207
00:12:37,750 --> 00:12:41,640
أريدكم أن تُشكّلوا مجموعات من أربعة قبل ذلك الحين

208
00:12:41,640 --> 00:12:42,400
هذا كلّ شيء

209
00:12:43,870 --> 00:12:45,630
!أجل! بالنسبة لنا هذا سهل

210
00:12:45,630 --> 00:12:47,000
أليس كذلك يا آل؟

211
00:12:47,000 --> 00:12:49,770
روز-ساما، هلّا انضممتِ لمجموعتنا؟

212
00:12:49,770 --> 00:12:51,390
أرجوكِ، أتوسّل إليكِ

213
00:12:51,390 --> 00:12:52,490
ما رأيكِ بمجموعتنا؟

214
00:12:54,830 --> 00:12:56,470
ماذا يجدر بي أن أفعل؟

215
00:12:56,470 --> 00:12:58,010
لنُنظّم صفوفنا يا راي

216
00:12:58,750 --> 00:12:59,930
هل هذا مقبول؟

217
00:12:59,930 --> 00:13:02,940
من المعروف شيوعاً بأنّني لستُ ماهراً في السّحر

218
00:13:02,940 --> 00:13:04,990
أنت ماهر في استخدام جسدك، صحيح؟

219
00:13:04,990 --> 00:13:08,580
فضلاً عن ذلك، الصيّاد الذهبيّ يُساوي 100 شخص

220
00:13:08,580 --> 00:13:10,660
حقّاً؟ حسناً، شكراً لك

221
00:13:10,660 --> 00:13:13,060
لكن ماذا عن الشّواغر الأخرى؟

222
00:13:21,400 --> 00:13:22,500
راي؟

223
00:13:22,500 --> 00:13:24,250
إليسا، أتريدين الانضمام لمجموعتنا؟

224
00:13:28,270 --> 00:13:29,910
...لكن... أعني

225
00:13:30,190 --> 00:13:35,880
أنا سعيدة، لكن أنا ضعيفة جسديّاً
لدرجة أنّني سأكون عبئاً

226
00:13:35,880 --> 00:13:36,910
...إليسا

227
00:13:39,390 --> 00:13:42,290
إليسا، لنبذل قصارى جهدنا معاً

228
00:13:42,290 --> 00:13:43,820
نحن نحتاجكِ

229
00:13:43,820 --> 00:13:45,000
راي

230
00:13:45,610 --> 00:13:47,470
سأدعمكِ أيضاً

231
00:13:51,040 --> 00:13:54,090
حسناً. شكراً لكما

232
00:13:55,000 --> 00:13:57,460
هل ما زال لديكم شاغر؟

233
00:14:03,660 --> 00:14:05,020
بالطبع

234
00:14:05,020 --> 00:14:07,160
كان الشّاغر مُتاحاً لكِ من البداية

235
00:14:20,820 --> 00:14:23,920
لنُراجع تفاصيل هذا التّمرين مرّة أخرى

236
00:14:24,510 --> 00:14:28,570
الغاية من هذا التّمرين هي بلوغ
الهدف في وسط الغابة

237
00:14:29,080 --> 00:14:33,130
لا تنسوا إصابة كلّ نقطة حفظ
مُنتشرة في أرجاء المنطقة

238
00:14:33,780 --> 00:14:37,190
عدد الأختام الّتي تجمعونها ستؤثّر
على علاماتكم النّهائيّة

239
00:14:37,670 --> 00:14:39,830
أمامكم 24 ساعة

240
00:14:39,830 --> 00:14:41,490
أيّ شيء بعد ذلك لن يُحسَب

241
00:14:42,340 --> 00:14:47,380
غابة كافكا مليئة بالوحوش الّتي
غذّتها هذه البيئة الفريدة

242
00:14:47,380 --> 00:14:49,390
تأهّبوا فالقتال سيكون ضروريّاً

243
00:14:50,150 --> 00:14:54,740
،سيكون هذا أوّل تمرين عمليّ
لكن لا تطلبوا المساعدة

244
00:14:54,740 --> 00:14:56,750
قد يؤدّي هذا للرجوع عاماً

245
00:14:57,400 --> 00:14:58,360
هذا كلّ ما في الأمر

246
00:14:58,360 --> 00:15:01,920
انتظروا في المكان المُحدَّد حتّى نُعطي الإشارة

247
00:15:06,700 --> 00:15:08,060
أنا متوتّرة للغاية

248
00:15:08,060 --> 00:15:09,670
لا تقلقي يا إليسا

249
00:15:09,670 --> 00:15:11,120
جميعنا هنا معكِ

250
00:15:11,120 --> 00:15:13,140
أنتِ لطيفة جدّاً

251
00:15:13,740 --> 00:15:15,610
لا تبدو مُتوتّراً إطلاقاً

252
00:15:15,610 --> 00:15:16,670
بالتأكيد

253
00:15:16,670 --> 00:15:18,800
على العكس، إنّه شعور حنينيّ

254
00:15:18,800 --> 00:15:19,880
حنينيّ؟

255
00:15:19,880 --> 00:15:21,690
،أتيتُ من مكان ناءٍ

256
00:15:21,690 --> 00:15:23,890
لذا أنا معتاد على الجري في الغابات والجبال

257
00:15:25,210 --> 00:15:27,730
ماذا يجدر بنا أن نفعل بشأن ترتيبنا؟

258
00:15:27,730 --> 00:15:29,570
صحيح، لم نقرّر ذلك بعد

259
00:15:29,570 --> 00:15:31,910
ربّما راي وأنت ينبغي أن تكونا في الطّليعة

260
00:15:31,910 --> 00:15:34,930
سأكون أنا في الوسط وستتولّى إليسا الخطّ الخلفي

261
00:15:34,930 --> 00:15:36,290
يبدو هذا مُناسباً

262
00:15:36,290 --> 00:15:39,420
لا، حبّذا لو أتولّى الوسط والكمائن

263
00:15:39,420 --> 00:15:40,290
ماذا؟

264
00:15:40,290 --> 00:15:42,570
،أنا معتاد على هذه الأنواع من التّمارين

265
00:15:42,570 --> 00:15:45,590
لذا أودُّ منكِ ومن أيفي أن تكونا في الطّليعة

266
00:15:45,590 --> 00:15:50,880
لا مشكلة، لكن ماذا تقصد بأنّك مُعتاد
على هذا النّوع من التّمارين؟

267
00:15:51,230 --> 00:15:53,180
لنقل أنّني تعلّمتُ الكثير في تلك الغابات الخلفيّة

268
00:15:54,860 --> 00:15:56,430
حان الوقت

269
00:15:56,880 --> 00:15:59,040
سيبدأ الآن التّمرين العمليّ

270
00:15:59,720 --> 00:16:01,730
هل أنتم جاهزون جميعاً؟

271
00:16:01,730 --> 00:16:02,470
!بالتأكيد

272
00:16:02,470 --> 00:16:03,350
!بلا شكّ

273
00:16:04,200 --> 00:16:05,730
سأبذل قصارى جهدي

274
00:16:05,730 --> 00:16:06,610
!سأبذل قصارى جهدي

275
00:16:08,040 --> 00:16:08,980
!يبدأ التّمرين الآن

276
00:16:34,400 --> 00:16:35,880
إليسا، هل أنتِ بخير؟

277
00:16:35,880 --> 00:16:36,780
!راي

278
00:16:36,780 --> 00:16:37,490
!حسناً

279
00:16:37,490 --> 00:16:39,220
هذا أحد تلك الوحوش إذاً

280
00:16:45,690 --> 00:16:46,900
مُذهل

281
00:16:46,900 --> 00:16:48,670
...شطرَها إلى نصفين بضربة وحدة

282
00:16:48,670 --> 00:16:50,760
!هذا مُبهر يا راي

283
00:16:51,240 --> 00:16:52,600
هيّا بنا

284
00:16:54,050 --> 00:16:55,810
!عثرنا على ختم

285
00:16:56,230 --> 00:16:57,580
!اضرب الختم

286
00:16:59,270 --> 00:17:00,480
!رائع

287
00:17:00,480 --> 00:17:01,550
نحن نُبلي حسناً

288
00:17:05,210 --> 00:17:06,860
هل نسلك الطريق الصّحيح أصلاً؟

289
00:17:06,860 --> 00:17:08,590
...أجل، على ما أعتقد

290
00:17:08,590 --> 00:17:10,250
هل أنتِ متأكّدة؟

291
00:17:13,130 --> 00:17:14,990
!هذا ضخم للغاية

292
00:17:21,500 --> 00:17:23,280
نحن نُحرز تقدّماً سريعاً حقّاً

293
00:17:23,280 --> 00:17:25,600
على هذا المُعدّل، بوسعنا
أن نكون أوّل من يعود

294
00:17:25,600 --> 00:17:27,910
كان راي مُذهلاً حقّاً

295
00:17:27,910 --> 00:17:28,610
أجل

296
00:17:29,070 --> 00:17:30,850
قدراته القتاليّة استثنائيّة

297
00:17:31,140 --> 00:17:34,270
وحتّى أنّه لديه معرفة واسعة حول مهارات البقاء

298
00:17:34,270 --> 00:17:36,670
هذا ما تأمّلتُه من صيّاد ذهبيّ

299
00:17:36,670 --> 00:17:39,520
صادفتُ كثيراً من الوحوش في
تلك الغابات الخلفيّة

300
00:17:40,010 --> 00:17:42,130
لذا أنا معتاد على مثل هذه الظّروف

301
00:17:42,130 --> 00:17:44,540
غابات خلفيّة؟

302
00:17:45,320 --> 00:17:48,400
إنّها تُشكّك بـ"نظريّة الغابة الخلفيّة
المُطبّقَة عالميّاً"؟

303
00:17:48,400 --> 00:17:50,280
...مُعلّمة، وعدتِ بشيء آخر

304
00:17:51,250 --> 00:17:53,090
أنت مختلف حقّاً يا راي

305
00:17:53,090 --> 00:17:55,390
وكذلك أنتِ

306
00:17:55,390 --> 00:17:57,080
ما كنتُ لأتوقّع أبداً من الابنة الكبرى

307
00:17:57,080 --> 00:17:58,810
لعائلة روز أن تضع نفسها في سويّة واحدة مع عاديّ

308
00:17:58,810 --> 00:18:00,300
هذا غريب للغاية

309
00:18:00,300 --> 00:18:04,090
لا أحبّ أمور النّسل والدّرجات الاجتماعيّة

310
00:18:04,090 --> 00:18:06,800
عائلة روز هي قائدة العائلات النّبيلة
الكبرى الثّلاث، أليس كذلك؟

311
00:18:06,800 --> 00:18:08,090
ألستِ فخورة بذلك؟

312
00:18:08,950 --> 00:18:11,160
أكره كلّ تلك الرّسميّات

313
00:18:12,070 --> 00:18:15,560
أقصد بأنّني بذلتُ جهداً كبيراً
لأصبح مَن أنا عليه لآن

314
00:18:16,400 --> 00:18:17,820
أميليا؟

315
00:18:17,820 --> 00:18:20,380
لا مُشكلة

316
00:18:20,380 --> 00:18:24,130
أنا مُستمتعة حقّاً بالتنزّه معكم لأنّكم تتفاعلون معي

317
00:18:24,130 --> 00:18:25,680
دون كلّ تلك الرّسميّات

318
00:18:25,680 --> 00:18:28,830
أنا سعيدة جدّاً لقدرتنا على معرفة بعضنا الآخر

319
00:18:29,940 --> 00:18:33,490
أنتِ غاية في الظّرافة

320
00:18:34,370 --> 00:18:37,000
!ظريفة من كلّ النّواحي

321
00:18:35,840 --> 00:18:38,850
أميليا، يغدو الأمر غريباً

322
00:18:37,980 --> 00:18:43,580
نعتمد عليك يا راي

323
00:18:45,160 --> 00:18:47,310
،مقارنة بساحة المعركة

324
00:18:47,310 --> 00:18:49,060
هذه الغابة هي جنّة

325
00:18:52,050 --> 00:18:55,360
هل من المناسب حقّاً أن أكون هنا؟

326
00:18:56,010 --> 00:18:59,350
هل أملك الحقّ في التمتّع بهكذا حياة؟

327
00:18:59,760 --> 00:19:00,770
راي؟

328
00:19:02,530 --> 00:19:03,880
هل من مُشكلة؟

329
00:19:07,370 --> 00:19:08,500
لا

330
00:19:08,500 --> 00:19:10,170
لنستعدّ ليوم غد ونخلد إلى النّوم

331
00:19:24,450 --> 00:19:28,800
راي، لن أطلب منك إبقاء هويّتك
مخفيّة مهما كلّف الأمر للأبد

332
00:19:29,310 --> 00:19:32,180
لكن وضعك حالة خاصّة

333
00:19:32,180 --> 00:19:34,770
،إذا أردت التمتّع بحياة طبيعيّة في المدرسة

334
00:19:34,770 --> 00:19:37,150
فسيكون من الأفضل غالباً التستّر عليها

335
00:19:38,120 --> 00:19:43,250
لكن إذا وجدتَ بعض الأصدقاء الّذين
...يمكنك الوثوق بهم

336
00:19:44,210 --> 00:19:46,570
ماذا يجدر بي أن أفعل؟

337
00:19:47,100 --> 00:19:48,240
...يا مُعلّمة

338
00:19:54,740 --> 00:19:55,640
ماذا كان ذلك؟

339
00:19:55,640 --> 00:19:56,860
صرخة؟

340
00:19:57,690 --> 00:19:58,610
!مهلاً

341
00:19:58,610 --> 00:19:59,410
!انتظر يا راي

342
00:19:59,410 --> 00:20:00,880
!أنا آسف، سأسبقكم

343
00:20:05,280 --> 00:20:07,650
تلك الصّرخة قبل قليل. ينتابني إحساس سيّئ

344
00:20:14,350 --> 00:20:15,840
!النّجدة

345
00:20:15,840 --> 00:20:17,350
!تراجع

346
00:20:17,350 --> 00:20:18,940
ا-اللّعنة

347
00:20:18,940 --> 00:20:20,050
!ماذا يجري بالضبط؟

348
00:20:20,050 --> 00:20:21,230
!السيّد آليوم

349
00:20:21,230 --> 00:20:22,590
!اسمح لي أن أقدِّم المساعدة

350
00:20:23,400 --> 00:20:24,540
السّافر؟

351
00:20:24,910 --> 00:20:26,850
!الشّفرة الداخليّة، التحكّم العطاليّ

352
00:20:29,370 --> 00:20:31,240
كيف يتحرّك بهذا الشّكل؟

353
00:20:53,510 --> 00:20:55,930
هل يمكنك النّهوض يا سيّد آليوم؟

354
00:20:58,090 --> 00:21:00,240
!كيف تجرؤ على الاستخفاف بي؟

355
00:21:00,540 --> 00:21:02,750
!أنت مجرّد عاديّ

356
00:21:02,750 --> 00:21:04,900
!كان بوسعي فعل كلّ ذلك بمُفردي

357
00:21:05,280 --> 00:21:06,720
هكذا إذاً

358
00:21:06,720 --> 00:21:07,910
هل كان لديك استراتيجيّة سرّية ما؟

359
00:21:09,050 --> 00:21:10,820
!أيّها الوغد

360
00:21:10,820 --> 00:21:11,790
!راي

361
00:21:14,730 --> 00:21:16,080
ما هذا؟

362
00:21:16,080 --> 00:21:17,610
!يا له من وحش ضخم

363
00:21:17,610 --> 00:21:20,500
هوجِمَ فريق السيّد آليوم

364
00:21:21,110 --> 00:21:24,290
هلّا أسرعتُم وأنزلتموها من هنا؟

365
00:21:24,600 --> 00:21:26,430
!هذا مؤلم

366
00:21:26,430 --> 00:21:27,970
!بسرعة

367
00:21:27,970 --> 00:21:31,050
إليسا، هلّا طلبتُ منكِ الاعتناء بهم؟

368
00:21:31,050 --> 00:21:33,050
!حسناً، لك ذلك

369
00:21:33,050 --> 00:21:34,320
سأقدّم المساعدة أيضاً

370
00:21:36,990 --> 00:21:39,160
هل هزمته بمفردك؟

371
00:21:40,620 --> 00:21:41,570
أجل، لماذا؟

372
00:21:42,480 --> 00:21:44,730
راي... من تكون؟

373
00:22:01,760 --> 00:22:03,080
...مهلاً، مهلاً

374
00:22:04,020 --> 00:22:05,040
هذا مستحيل

375
00:22:05,040 --> 00:22:06,370
...ماذا

376
00:23:50,110 --> 00:23:52,260
إنّها مُقتطفات من الحلقة القادمة

377
00:23:52,260 --> 00:23:55,000
!"لـ"ساحر نصل الجليد سيحكم العالم

378
00:23:55,000 --> 00:23:57,070
!راي يواجه هذا الوحش الهائل

379
00:23:57,070 --> 00:24:01,970
هل يمكنه هزيمته ويُنهي هذا
!التّمرين العمليّ سليماً؟

380
00:24:01,970 --> 00:24:06,070
الفتى الّذي أصبح السّاحر الأقوى
!في العالم يستمتع بيوم إجازة

381
00:24:07,100 --> 00:24:08,990
!أيفي آرمسترونغ، خِتام الرّسالة