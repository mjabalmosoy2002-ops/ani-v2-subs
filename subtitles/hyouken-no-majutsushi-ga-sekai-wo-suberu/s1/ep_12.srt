1
00:00:01,770 --> 00:00:02,870
...أختي

2
00:00:11,070 --> 00:00:12,990
التقينا أخيراً

3
00:00:15,220 --> 00:00:17,490
مضى وقت طويل

4
00:00:17,940 --> 00:00:20,490
اسمك مورس الآن، صحيح؟

5
00:00:21,050 --> 00:00:22,920
إيفان بيرنشتاين

6
00:00:24,400 --> 00:00:27,710
مضى عشر سنوات، صحيح يا ليسي؟

7
00:00:31,200 --> 00:00:33,670
الآنسة البيضاء؟

8
00:00:38,380 --> 00:00:41,100
عند وجودكِ، أتشوّش

9
00:00:41,100 --> 00:00:43,770
لا أستطيع التّفكير سوى فيكِ

10
00:00:43,770 --> 00:00:47,020
مجرّد وجودك يستفزّني

11
00:00:47,020 --> 00:00:49,040
!لذا فلتموتي فحسب

12
00:00:49,760 --> 00:00:51,570
فعلتِ ذلك نكاية بي، صحيح؟

13
00:00:51,570 --> 00:00:56,880
متظاهرة بأنّني أنا وتاركة عائلة بيرنشتاين
عائمة في السّنوات العشر الماضية

14
00:00:56,880 --> 00:00:58,630
هذا غير صحيح يا إيفان

15
00:00:58,630 --> 00:00:59,270
...أنا

16
00:00:59,270 --> 00:01:01,790
سأنهي هذا هنا والآن

17
00:01:01,790 --> 00:01:06,330
!ثمّ سأصل إلى آكاشا

18
00:01:06,330 --> 00:01:12,050
!لأجل ذلك، أحتاج كرويز ذاك

19
00:01:12,600 --> 00:01:14,090
!أختي

20
00:01:21,120 --> 00:01:23,150
لن أدعك تحصل عليها

21
00:01:44,660 --> 00:01:46,990
هكذا الأمر إذاً

22
00:01:46,990 --> 00:01:49,650
،أنتما دوماً

23
00:01:49,650 --> 00:01:52,500
!تسبقانني بخطوة دوماً

24
00:01:55,360 --> 00:01:57,090
ماريا برادلي

25
00:01:57,090 --> 00:02:01,700
بما أنّك هنا، هل أفهم أنّ هذا يعني
أنّكِ اتّخذتِ قراركِ؟

26
00:02:03,420 --> 00:02:05,360
إنّها فرصة مؤاتية

27
00:02:05,360 --> 00:02:06,570
لا تقلقي

28
00:02:06,570 --> 00:02:08,970
أنا متأكّدة أنّ هناك الكثير من الكلام تريدين قوله

29
00:02:09,560 --> 00:02:12,550
بعد ذلك، دعي راي وايت يعالج هذا

30
00:02:13,160 --> 00:02:15,300
راي؟ لماذا؟

31
00:02:15,300 --> 00:02:16,240
ها هو ذا

32
00:02:17,790 --> 00:02:18,950
!راي

33
00:02:19,560 --> 00:02:21,150
!ها أنت ذا

34
00:03:56,250 --> 00:03:59,100
أجل. وأنت نصل الجليد الحاليّ، صحيح؟

35
00:03:59,100 --> 00:04:02,570
وأنت الشّرِه باراتروغو

36
00:04:02,570 --> 00:04:05,350
!تعرفني! هذا شرف لي

37
00:04:05,350 --> 00:04:08,180
أنت ساحر يأكل الإنغرام الخاصّة بالسّحرة الآخرين

38
00:04:08,450 --> 00:04:10,060
تيقّنتُ من ذلك قبل قليل

39
00:04:11,260 --> 00:04:12,700
!لقد حمّستَني

40
00:04:12,700 --> 00:04:16,070
!سيكون نصل الجليد هذا التّحلية الأفضل

41
00:04:19,230 --> 00:04:20,640
ما هذا بالتّحديد؟

42
00:04:20,640 --> 00:04:21,580
!اللّعنة

43
00:04:20,740 --> 00:04:24,240
ألا يمكنك أن تهدأ قليلاً أيّها الخنزير غير المُثقّف؟

44
00:04:24,240 --> 00:04:26,610
ثمّة شي مهمّ أحتاج مُناقشته معه

45
00:04:26,820 --> 00:04:28,320
!ماذا قلتِ؟

46
00:04:28,320 --> 00:04:31,000
سررتُ بلقائك يا راي وايت

47
00:04:31,340 --> 00:04:32,440
من تكونين؟

48
00:04:32,440 --> 00:04:34,180
ليسيلوت أيدين

49
00:04:34,180 --> 00:04:36,910
أم يصحّ القول، ساحرة التّلفيق

50
00:04:37,220 --> 00:04:38,380
...التّلفيق

51
00:04:39,060 --> 00:04:40,670
أنتِ من خطّط لكلّ هذا إذاً؟

52
00:04:41,040 --> 00:04:44,910
أعتقد أنّ ليديا والآخرين لديهم فكرة
سريعة عن الأمر بالفعل

53
00:04:44,910 --> 00:04:46,680
سأختصر الأمر

54
00:04:46,680 --> 00:04:49,630
سأجعل حرارتها تزداد زيادة عن اللّزوم

55
00:04:49,630 --> 00:04:52,840
ثمّ أريدك أن تختم عليها

56
00:04:52,840 --> 00:04:54,460
لديك خبرة في ذلك سلفاً، صحيح؟

57
00:04:54,460 --> 00:04:55,160
ماذا؟

58
00:04:55,750 --> 00:04:57,390
قفل كرونوس

59
00:04:57,830 --> 00:05:01,060
،أنت الوحيد القادر على فعلها
بما أنّك تتناغم معها

60
00:05:01,060 --> 00:05:03,890
أنا... أتناغم معها؟

61
00:05:04,330 --> 00:05:05,940
تتذكّر، أليس كذلك؟

62
00:05:09,060 --> 00:05:11,210
،إذا كان هذا لإنقاذها

63
00:05:11,210 --> 00:05:13,810
فيمكنني استخدام أيّ وسيلة ضروريّة

64
00:05:13,810 --> 00:05:17,000
هذا ما ينصّه عقدي مع برونو برادلي

65
00:05:17,540 --> 00:05:21,630
نظراً للمخاطر، لا تبدين قلقة جدّاً

66
00:05:21,630 --> 00:05:23,880
لديّ هدفي الخاص

67
00:05:23,880 --> 00:05:27,090
ولأجل ذلك، لا يمكنني استبعاد أيّ خيار

68
00:05:28,680 --> 00:05:29,900
،المعذرة

69
00:05:29,900 --> 00:05:32,330
لكن هلّا اهتممتَ بأمر ذلك المُهرّج المُزعج؟

70
00:05:34,340 --> 00:05:36,340
!راه

71
00:05:37,410 --> 00:05:39,310
أنت تستفزّني

72
00:05:41,760 --> 00:05:44,480
قفل كرونوس، تحرير

73
00:05:47,700 --> 00:05:48,650
ها أنا قادم

74
00:05:48,890 --> 00:05:53,870
!سوف آكل كلّ جزء منك

75
00:06:06,960 --> 00:06:09,590
!إذاً يمكنك تعديل نفسك فوراً، صحيح؟

76
00:06:09,590 --> 00:06:11,220
لا أتوقّع أقلّ من ذلك منك

77
00:06:18,960 --> 00:06:20,810
...ليسي

78
00:06:21,620 --> 00:06:23,770
إيفان، فهمت، أليس كذلك؟

79
00:06:23,770 --> 00:06:26,060
لا يمكنك لمسي

80
00:06:26,720 --> 00:06:27,950
!لم أعُد أبالي

81
00:06:28,400 --> 00:06:29,830
!لا يهمّني

82
00:06:29,830 --> 00:06:31,370
...لا اليوجينيّين

83
00:06:31,370 --> 00:06:32,420
...ولا آكاشا

84
00:06:32,420 --> 00:06:33,580
...ولا كرويز

85
00:06:33,580 --> 00:06:37,590
!ما دمتُ أستطيع قتلكِ بهاتين اليدين

86
00:06:37,820 --> 00:06:40,470
يبدو أنّ صوتي لا يستطيع الوصول إليك أيضاً

87
00:06:41,680 --> 00:06:45,830
!نِظام الثّالوث الظّلامي، تفعيل

88
00:06:48,120 --> 00:06:51,250
أعرف كلّ ذلك يا إيفان

89
00:06:51,250 --> 00:06:53,100
،تقنيّة مُحرّمة تحفّز الدماغ

90
00:06:53,100 --> 00:06:55,490
لتُضخّم بذلك جانباً مُظلماً للبشر

91
00:06:55,490 --> 00:07:01,470
ينمو الإنغرام بشكل مؤقّت ويسبّب حماوة زائدة

92
00:07:03,470 --> 00:07:05,770
!فلتموتي

93
00:07:09,280 --> 00:07:11,020
!ما هذا؟

94
00:07:11,020 --> 00:07:12,650
;تشفير بريما ماتيريا

95
00:07:12,650 --> 00:07:15,290
،شفرة المادّة، شفرة المادّة، فكّ تشفير

96
00:07:13,390 --> 00:07:15,730
،شفرة المادّة، مُعالجة، حسّ مُواكب

97
00:07:15,130 --> 00:07:17,030
تجسيد، ظاهرة

98
00:07:17,030 --> 00:07:18,670
تمجيد

99
00:07:23,920 --> 00:07:28,800
العامل التّدميري الّذي أمتلكه
يجعل الإنغرام خاصّتك تتدمّر ذاتيّاً

100
00:07:29,330 --> 00:07:31,330
انتهى الأمر يا إيفان

101
00:07:33,800 --> 00:07:36,920
!ليسي

102
00:07:43,060 --> 00:07:46,160
أهذه هي... قوّة الأقوى...؟

103
00:07:46,160 --> 00:07:49,570
ساحرة التّلفيق؟

104
00:07:50,720 --> 00:07:52,000
لا

105
00:07:52,000 --> 00:07:53,800
الأقوى هو نصل الجليد

106
00:07:54,250 --> 00:07:56,780
راي وايت بمستوٍ مختلف تماماً

107
00:07:56,780 --> 00:07:59,820
يمكنك القول أنّه في بُعد مختلف كلّياً

108
00:08:00,080 --> 00:08:01,710
ماذا؟

109
00:08:01,710 --> 00:08:05,460
لنفترض أنّ هناك ساحر بوسعه
السّيطرة على العالم كلّه

110
00:08:07,080 --> 00:08:09,690
الوحيد القادر على فعل ذلك... هو

111
00:08:11,140 --> 00:08:12,530
...بصيغة أخرى

112
00:08:13,060 --> 00:08:17,010
ساحر نصل الجليد سوف يسيطر على العالم

113
00:08:24,980 --> 00:08:26,790
هل... انتهى الأمر؟

114
00:08:26,790 --> 00:08:28,560
!لا أستطيع التحمّل أكثر

115
00:08:30,030 --> 00:08:31,480
!فعلناها

116
00:08:31,480 --> 00:08:34,930
رغم أنّنا لم نستطع فعل شيء
في تمرين غابة كافكا

117
00:08:34,930 --> 00:08:37,410
هذا يُثبت كم تطوّرنا جميعاً

118
00:08:37,410 --> 00:08:39,580
ويعزو الفضل لراي، صحيح؟

119
00:08:39,580 --> 00:08:40,470
أجل

120
00:08:40,470 --> 00:08:43,240
ما كنّا لنصل إلى هنا لولاه

121
00:08:44,110 --> 00:08:46,570
لا سيّما أنت يا آلبيرت

122
00:08:46,570 --> 00:08:47,500
حقّاً؟

123
00:08:47,500 --> 00:08:48,690
حقّاً

124
00:08:53,510 --> 00:08:54,590
...هذا غير ممكن

125
00:08:54,590 --> 00:08:55,810
...هذا

126
00:08:55,810 --> 00:08:57,710
!نفس الشّيء في غابة كافكا؟

127
00:09:00,180 --> 00:09:01,400
!لنهرب

128
00:09:01,760 --> 00:09:03,040
!اللّعنة

129
00:09:06,020 --> 00:09:06,990
...ماذا

130
00:09:08,350 --> 00:09:10,640
!أبليتُم حسناً جميعاً

131
00:09:11,230 --> 00:09:12,830
أعتذر لو تأخّرنا

132
00:09:13,270 --> 00:09:16,370
!كنتِ تُقاتلين بلباسكِ أيضاً

133
00:09:16,640 --> 00:09:19,300
تستحقّين أفضل علامة على هذا

134
00:09:18,570 --> 00:09:20,780
سوف نتولّى زمام الأمور من هنا

135
00:09:24,630 --> 00:09:26,620
لنقضِ على آخر المُتبقّيين

136
00:09:26,620 --> 00:09:27,460
آخر المُتبقّيين؟

137
00:09:27,460 --> 00:09:28,190
ماذا تقصدين؟

138
00:09:28,190 --> 00:09:29,470
!آسفة بشأن ذلك

139
00:09:29,470 --> 00:09:32,800
كان هؤلاء الرّجال في كلّ مكان

140
00:09:32,800 --> 00:09:36,560
الرّجال المُتحرّشون والحشرات مُزعجون على حدّ سوا

141
00:09:37,880 --> 00:09:39,600
...سخيف للغاية

142
00:09:39,980 --> 00:09:42,280
...أولئك السّحرة العظماء السّبعة

143
00:09:45,960 --> 00:09:47,060
حسناً إذاً

144
00:09:47,060 --> 00:09:49,490
!هيّا بنا يا رجال

145
00:09:49,490 --> 00:09:51,600
لكن كاروكارو ليست رجلاً

146
00:09:51,600 --> 00:09:52,540
أجل، أجل

147
00:09:58,230 --> 00:09:59,860
!وميض البرق

148
00:10:03,520 --> 00:10:07,050
!تُدعى هذه بضربة البرق الجارحة

149
00:10:17,020 --> 00:10:18,500
!فيبريس دراكو

150
00:10:19,000 --> 00:10:20,750
!ياماتا أوروتشي

151
00:10:27,030 --> 00:10:28,750
أهذا معقول؟

152
00:10:28,750 --> 00:10:30,330
هذا ما أعتقده

153
00:10:30,330 --> 00:10:31,380
هذا حقيقيّ إذاً؟

154
00:10:32,020 --> 00:10:33,370
!حسناً إذاً

155
00:10:33,370 --> 00:10:36,020
لا يمكن أن أخسر أمام تلاميذي

156
00:10:36,020 --> 00:10:38,030
،كارول في بلاد العجائب

157
00:10:38,030 --> 00:10:39,700
!من خلال المرآة

158
00:10:40,090 --> 00:10:42,540
!هيّا، هيّا، هيّا، هيّا

159
00:10:45,440 --> 00:10:47,760
وصلنا للنهاية أخيراً

160
00:10:48,180 --> 00:10:52,110
