161
00:10:52,110 --> 00:10:56,960
لكن كاروكارو تعدكم ألّا تنسى كلّ مُعجبيها
!حتّى يوم النّسيان

162
00:10:58,250 --> 00:11:01,360
!والآن استمعوا إلى أغنيتي الأخيرة رجا

163
00:11:01,360 --> 00:11:02,090
-عالٍ

164
00:11:05,640 --> 00:11:06,850
!كيابي

165
00:11:07,110 --> 00:11:09,360
ما المقصود بـ"النّهاية"؟

166
00:11:09,600 --> 00:11:12,150
!حريّ بكم أن تستعدّوا جميعاً

167
00:11:12,440 --> 00:11:14,100
!الأنصال الجليديّة

168
00:11:14,540 --> 00:11:15,730
!راغناروك

169
00:11:17,260 --> 00:11:20,960
!خذوا هذا السّحر الرّفيع

170
00:11:26,150 --> 00:11:28,720
بئس الأمر. يا له من إسراف

171
00:11:28,990 --> 00:11:32,190
ليديا، أنتِ عنيفة كالعادة

172
00:11:31,450 --> 00:11:33,160
لا أريد سماع ذلك منكم

173
00:11:33,160 --> 00:11:36,370
وضعتُ المنطقة المُحيطة بعين الاعتبار كما ينبغي

174
00:11:36,370 --> 00:11:37,950
...مُحال يا مُفتعل الحرائق

175
00:11:37,950 --> 00:11:40,500
كان مظهر مسرحي مؤثّراً جدّاً

176
00:11:38,770 --> 00:11:39,580
....مُذهل

177
00:11:39,580 --> 00:11:40,680
تعجز الكلمات عن الوصف

178
00:11:40,680 --> 00:11:41,670
...مذهل

179
00:11:41,670 --> 00:11:44,260
حسناً يا إليسا، لماذا تبكين؟

180
00:11:44,260 --> 00:11:46,490
...سحر ليديا الحيّ

181
00:11:46,490 --> 00:11:48,810
بصِفتي أينزر، أنا مُبارَكة جدّاً

182
00:11:49,610 --> 00:11:50,500
...راي

183
00:11:51,520 --> 00:11:53,360
يعتمد الأمر عليك الآن

184
00:11:53,830 --> 00:11:55,810
!هل هذا كلّ ما يستطيع نصل الجليد فعله؟

185
00:11:56,050 --> 00:11:57,300
كفى كلاماً

186
00:11:57,300 --> 00:11:58,560
تعال إليّ بكامل قوّتي الآن

187
00:11:58,890 --> 00:12:02,470
!حينها لن أتحفّظ بعد الآن

188
00:12:02,470 --> 00:12:04,400
!هذه قوّتي الكاملة

189
00:12:04,660 --> 00:12:09,200
!تعويذتي الأصليّة الّتي توفّر التّعزيز الجسدي المُطلَق

190
00:12:12,830 --> 00:12:15,280
!آكل البشر

191
00:12:17,800 --> 00:12:18,990
!راي

192
00:12:19,820 --> 00:12:21,830
هذه غلطتك

193
00:12:21,830 --> 00:12:22,770
ماذا؟

194
00:12:22,770 --> 00:12:26,730
!كلّ هذا لأنّك لم تستطع فتح فمك اللّعين

195
00:12:28,230 --> 00:12:30,110
،لأنّ راي بهذا الوضع

196
00:12:30,110 --> 00:12:32,400
،أصبحتُ هكذا

197
00:12:32,400 --> 00:12:34,030
!بهذا الظرف برمّته

198
00:12:34,030 --> 00:12:36,880
!كلّ هذا لأنّكِ لا تتكلّمين أبداً عن الأمور المهمّة

199
00:12:43,980 --> 00:12:46,490
!أعتقد حان الوقت لأكلك الآن

200
00:12:50,980 --> 00:12:51,830
!راي

201
00:12:54,910 --> 00:12:59,420
!سوف أستلذّ بك يا نصل الجليد

202
00:12:59,680 --> 00:13:01,010
،بريما ماتيريا، تشفير

203
00:13:00,510 --> 00:13:01,970
،شفرة المادّة، فكّ تشفير

204
00:13:01,470 --> 00:13:03,120
،مُعالجة، تباطؤ

205
00:13:02,430 --> 00:13:03,290
،قفل

206
00:13:02,760 --> 00:13:04,100
،استعادة، ضغط

207
00:13:03,320 --> 00:13:04,500
،تجسيد

208
00:13:04,500 --> 00:13:05,310
المادّة

209
00:13:05,310 --> 00:13:06,450
ما هذا؟

210
00:13:06,450 --> 00:13:08,750
تريدني أن أسحق هذا أيضاً؟

211
00:13:11,830 --> 00:13:12,850
ماذا؟

212
00:13:12,850 --> 00:13:14,310
!أيّها الحقير

213
00:13:16,290 --> 00:13:19,520
!هذا مؤلم حقّاً

214
00:13:23,710 --> 00:13:24,870
ماذا؟

215
00:13:25,280 --> 00:13:27,280
!لم ينكسر؟

216
00:13:28,810 --> 00:13:30,860
انتهى الأمر يا باراتروغو

217
00:13:31,160 --> 00:13:32,420
!باندورا

218
00:13:36,070 --> 00:13:37,900
هكذا إذاً

219
00:13:37,900 --> 00:13:42,140
الآن أفهم ما تكون

220
00:13:42,140 --> 00:13:46,640
!نصل الجليد، أنت مُبهر

221
00:13:52,320 --> 00:13:55,650
قفل كرونوس، تفعيل

222
00:13:58,950 --> 00:13:59,870
!راي

223
00:14:01,220 --> 00:14:02,370
...ماريا

224
00:14:02,370 --> 00:14:04,550
دعيني أذهب. عليّ مُساعدته

225
00:14:04,550 --> 00:14:06,160
!قلتُ لكِ أنّ كلّ هذا غلطتكِ

226
00:14:06,520 --> 00:14:08,690
!طبعكِ دائماً التّظاهر بأنّكِ الفتاة الطيّبة

227
00:14:08,690 --> 00:14:11,030
!تتّخذين الأمور بسيطة، دون علم بمشاعر الآخرين

228
00:14:11,510 --> 00:14:12,820
لا بدّ أن هذا لطيف

229
00:14:12,820 --> 00:14:14,580
،تبقين هادئة وتبدين حزينة

230
00:14:14,580 --> 00:14:16,910
ثمّ يفهمك جميع من حولك

231
00:14:17,700 --> 00:14:19,140
...أنت

232
00:14:21,930 --> 00:14:23,130
...أنت

233
00:14:23,890 --> 00:14:27,530
!لا تملكين فكرة عمّا مررتُ به

234
00:14:27,530 --> 00:14:31,300
!عانيتُ كثيراً لأجلكِ كذلك

235
00:14:32,970 --> 00:14:34,440
!أيّتها الحمقاء

236
00:14:34,440 --> 00:14:36,550
!فعلتِ ذلك بمفردكِ للتو

237
00:14:36,550 --> 00:14:38,230
!لم أطلب منكِ أيّاً من ذلك

238
00:14:38,230 --> 00:14:40,800
،لأنّكِ حنونة دوماً بصورة غير ضروريّة

239
00:14:40,800 --> 00:14:44,310
!دائماً ما أُقارَن بأختي الكبرى الرّائعة

240
00:14:44,310 --> 00:14:46,440
!وأنا مجرّد أخت فاشلة

241
00:14:48,550 --> 00:14:51,720
!لا أملك خياراً سوى تحمّل ذلك على الدّوام

242
00:14:51,720 --> 00:14:53,440
!الآن وللأبد

243
00:14:53,440 --> 00:14:54,760
!لماذا؟

244
00:14:54,760 --> 00:14:57,510
إن كنتِ ستصبحين كئيبة لأنّكِ
تشفقين عليّ، فكُفّي عن ذلك فحسب

245
00:14:57,510 --> 00:14:58,200
!هذا مُزعج

246
00:14:58,200 --> 00:14:59,410
!اصمتي

247
00:15:00,430 --> 00:15:02,650
!اصمتي، اصمتي

248
00:15:02,650 --> 00:15:04,550
لهذا أكرهكِ

249
00:15:04,550 --> 00:15:05,510
!أكرهكِ

250
00:15:06,110 --> 00:15:08,140
تتظاهرين بأنّكِ بطلة في تمثيليّة دراميّة

251
00:15:08,140 --> 00:15:11,030
!تتمرّدين على والدينا وتفعلين ما يحلو لكِ

252
00:15:11,030 --> 00:15:12,840
!أكرهكِ كرهاً شديداً يا ماريا

253
00:15:14,420 --> 00:15:16,290
!إذاً قولي ذلك من البداية فحسب

254
00:15:16,290 --> 00:15:17,940
!بأنّني ينبغي أن أختفي

255
00:15:17,940 --> 00:15:19,780
بأنّكِ لا تحتاجيني

256
00:15:19,780 --> 00:15:21,950
بأنّكِ تتمنّين لو أنّني لم أُولَد يوماً

257
00:15:25,250 --> 00:15:27,330
لماذا تقولين ذلك؟

258
00:15:28,070 --> 00:15:31,690
لم أتمنّ ألّا تُولَدي أبداً

259
00:15:32,430 --> 00:15:34,670
،هناك أشياء لا تروقني فيكِ

260
00:15:34,670 --> 00:15:36,580
لكنّكِ أختي الصّغيرة العزيزة

261
00:15:37,730 --> 00:15:39,160
أحبّكِ

262
00:15:42,690 --> 00:15:43,980
...أختي

263
00:15:45,550 --> 00:15:49,310
!لا تقولي ذلك

264
00:15:55,290 --> 00:15:57,360
!أختي! أختي

265
00:15:57,360 --> 00:15:58,930
...ماريا

266
00:16:00,270 --> 00:16:01,340
!أختي

267
00:16:15,620 --> 00:16:17,850
هل كان مهمّاً بالنسبة لكِ؟

268
00:16:18,830 --> 00:16:19,840
من يدري؟

269
00:16:20,240 --> 00:16:23,080
تمّ إغواؤه بواسطة شيطان وشعر بالغيرة

270
00:16:23,080 --> 00:16:25,090
كان قد تخلّى عن بشريّته

271
00:16:25,090 --> 00:16:26,630
رجل أحمق

272
00:16:29,050 --> 00:16:31,390
الأمور لا تسير كما يحلو لك

273
00:16:31,390 --> 00:16:33,670
أقصد في الحقيقة

274
00:16:35,930 --> 00:16:38,090
بسرعة. اذهب إليها

275
00:16:40,320 --> 00:16:41,720
ما هذا؟

276
00:16:41,720 --> 00:16:42,740
...هذا

277
00:16:42,740 --> 00:16:44,020
!تراجعوا

278
00:16:44,640 --> 00:16:46,970
ستبدأ الحرارة الزّائدة

279
00:16:53,130 --> 00:16:56,140
ماريا، تراجعي وانتظري

280
00:16:56,480 --> 00:16:59,040
ساعدها من فضلك

281
00:16:59,040 --> 00:16:59,840
سأفعل

282
00:17:02,010 --> 00:17:02,980
...ريبيكا سينباي

283
00:17:05,290 --> 00:17:10,400
راي، قلتُ كلاماً فظيعاً بحقّ ماريا

284
00:17:11,420 --> 00:17:13,960
لا بدّ أنّ أملك خائب بي

285
00:17:13,960 --> 00:17:14,880
لا

286
00:17:16,360 --> 00:17:20,190
لا أحد حرّ من الصّراعات أو الهموم

287
00:17:20,560 --> 00:17:23,640
أحترمكِ احتراماً شديداً يا سينباي

288
00:17:23,850 --> 00:17:25,090
...و

289
00:17:25,090 --> 00:17:27,630
ماريا تحبّكِ أيضاً

290
00:17:28,090 --> 00:17:29,380
...راي

291
00:17:52,200 --> 00:17:53,670
قفل كرونوس

292
00:18:04,580 --> 00:18:07,470
،إذاً ابنتايّ

293
00:18:07,470 --> 00:18:10,090
ريبيكا وماريا بأمان

294
00:18:10,090 --> 00:18:10,900
أجل

295
00:18:11,430 --> 00:18:14,480
نصل الجليد، راي، كان هو من فعلَ ذلك

296
00:18:15,010 --> 00:18:18,510
هلّا بلّغته شكري وامتناني من فضلك؟

297
00:18:28,000 --> 00:18:29,140
!راي

298
00:18:29,970 --> 00:18:33,590
آسف لكوني أنا، لا راي

299
00:18:33,590 --> 00:18:35,240
لا أبداً

300
00:18:35,700 --> 00:18:40,000
...لكن حان الوقت تقريباً لي ولراي

301
00:18:40,000 --> 00:18:40,640
ماذا؟

302
00:18:40,640 --> 00:18:43,720
أنتما مُقرّبتان حقّاً

303
00:18:44,070 --> 00:18:45,560
إطلاقاً

304
00:18:45,560 --> 00:18:48,480
ما زلتُ لستُ بنفس مستواك

305
00:18:48,480 --> 00:18:51,630
لا داعي للتّواضع

306
00:18:51,630 --> 00:18:55,940
أنا آسفة، لكن ننوي قضاء اللّيلة معاً

307
00:18:55,940 --> 00:18:56,370
ماذا؟

308
00:18:56,600 --> 00:18:58,350
ستُشاهدان الألعاب النّاريّة معاً، صحيح؟

309
00:18:58,350 --> 00:18:59,480
لا

310
00:18:59,730 --> 00:19:02,340
أحتاج أن أشكره كما ينبغي لليوم

311
00:19:02,340 --> 00:19:05,970
لقد... لقد أظهرتُ له امتناني أيضاً
!بعد الفروسيّة السحريّة

312
00:19:05,970 --> 00:19:09,930
!وضمّني بقوّة وأخبرني بأنّه أرادنا أن نبقى معاً دوماً

313
00:19:09,930 --> 00:19:11,430
فهمت، فهمت

314
00:19:11,430 --> 00:19:14,500
حسناً، تبدو هذه كصداقة رائعة

315
00:19:14,500 --> 00:19:17,590
لكن حياتي الآن مرتبطة بهذا للأبد

316
00:19:17,820 --> 00:19:21,060
لن يكون من الخطأ القول أنّ أرواحنا مرتبطة ببعضها

317
00:19:21,060 --> 00:19:22,700
سوف تواجهين وقتاً عصيباً

318
00:19:22,700 --> 00:19:24,180
راي ذو شعبيّة كبيرة بين الفتيات

319
00:19:24,180 --> 00:19:25,070
تماماً

320
00:19:25,070 --> 00:19:27,650
ولديّ القدرة لتقبّل هذه الحقيقة

321
00:19:28,040 --> 00:19:30,240
في النّهاية، الحبّ يربح دوماً

322
00:19:36,020 --> 00:19:37,360
لن أخسر

323
00:19:38,590 --> 00:19:40,000
ولا أنا

324
00:19:40,000 --> 00:19:42,070
قد لا تعتقدين ذلك، لكن أكره الخسارة

325
00:19:43,010 --> 00:19:46,130
لمَ تحتكران كلّ المرح لنفسيكما؟

326
00:19:47,140 --> 00:19:47,940
هذا غير مُنصف

327
00:19:47,940 --> 00:19:49,300
!ماذا؟ مهلاً

328
00:19:51,280 --> 00:19:54,160
لديّ القدرة

329
00:19:54,160 --> 00:19:55,940
أنا آسف لو تأخّرت

330
00:19:57,000 --> 00:19:58,790
جميعكن هنا؟

331
00:19:58,790 --> 00:20:02,570
!راي

332
00:20:12,670 --> 00:20:14,640
مضى وقت طويل يا هاوارد

333
00:20:15,010 --> 00:20:17,460
أنا طالب الآن

334
00:20:17,460 --> 00:20:18,800
هل تتخيّل ذلك؟

335
00:20:18,800 --> 00:20:20,650
أنا، تلميذ

336
00:20:21,830 --> 00:20:25,100
،بعد زهق الكثير من الأرواح في الحرب

337
00:20:25,100 --> 00:20:28,500
لم أجد أنّ لديّ الحقّ في أن أكون واحداً

338
00:20:29,040 --> 00:20:32,380
،بعد أن خسرتُك آنذاك

339
00:20:32,380 --> 00:20:34,320
شعرتُ نفسي هائماً

340
00:20:35,260 --> 00:20:39,760
كنتُ مُضرجاً بالدّماء لدرجة أنّني لا أملك
فكرة أين قد يكون مكاني المناسب

341
00:20:41,180 --> 00:20:45,270
وكانت مُعلّمتي من هدتني إلى الطريق الصّواب

342
00:20:46,440 --> 00:20:52,340
العالم الّذي كان عاديّاً بالنسبة لي
انفصل تماماً عن العالم الحقيقيّ

343
00:20:52,820 --> 00:20:54,090
،رغم ذلك

344
00:20:54,090 --> 00:20:57,680
كان هناك أشخاص كثُر مستعدّين
لقبول شخص مثلي على أيّ حال

345
00:21:00,090 --> 00:21:01,190
،هاوارد

346
00:21:02,480 --> 00:21:05,460
!لديّ أصدقاء الآن

347
00:21:11,750 --> 00:21:14,710
ريبيكا برادلي
واكي أزومي

348
00:21:13,140 --> 00:21:15,740
يمكنكِ أن تكوني سعيدة الآن يا ليديا

349
00:21:15,250 --> 00:21:18,210
إليسا غريفيث
هارومورا نانا

350
00:21:15,740 --> 00:21:18,200
أليس ذلك هو راي الّذي أردت رؤيته؟

351
00:21:18,670 --> 00:21:19,570
أجل

352
00:21:18,750 --> 00:21:21,710
كلاريس كليفلاند
هوندو كايدي

353
00:21:21,080 --> 00:21:23,610
!ليديا تبكي

354
00:21:22,260 --> 00:21:25,220
أيفي آرمسترونغ
أوميهارا يويتشيرو

355
00:21:23,610 --> 00:21:25,210
!كذلك أنت إذاً

356
00:21:25,210 --> 00:21:27,420
!ليديا

357
00:21:25,760 --> 00:21:28,720
آبي غارنيت
موري ناناكو *

358
00:21:27,420 --> 00:21:29,350
!الورديّة الحمقاء

359
00:21:29,260 --> 00:21:32,220
كارول كارولين
أوتشيدا مايا

360
00:21:31,830 --> 00:21:34,120
!راي

361
00:21:32,770 --> 00:21:35,730
ليديا أينزورث
تانيزاكي أتسومي

362
00:21:36,310 --> 00:21:41,230
راي وايت
إينوكي جونيا

363
00:21:37,820 --> 00:21:39,430
!يا للفوضى

364
00:21:44,530 --> 00:21:46,910
كنتُ أنتظرك يا راي

365
00:21:48,120 --> 00:21:49,290
آرياني؟

366
00:21:49,720 --> 00:21:53,490
أريدك أن تنضمّ معي في حرب ماجيكس

367
00:21:54,880 --> 00:21:56,590
حرب ماجيكس؟

368
00:23:46,110 --> 00:23:48,940
!هذا مُملّ للغاية

369
00:23:48,940 --> 00:23:52,460
آمل أن يعود أخي الكبير إلى المنزل قريباً