1
00:00:00,930 --> 00:00:01,980
!حضّر نفسك

2
00:00:03,180 --> 00:00:05,230
!هجوم البرق

3
00:00:08,820 --> 00:00:09,820
!انتهى الأمر

4
00:00:09,820 --> 00:00:11,930
الرّابحة هي آرياني أولغرين

5
00:00:51,850 --> 00:00:52,960
سيّدي؟

6
00:00:57,810 --> 00:00:59,260
المُعلّمة؟

7
00:00:59,260 --> 00:01:00,230
آبي؟

8
00:01:00,230 --> 00:01:01,410
!راي

9
00:01:02,080 --> 00:01:05,460
ومن هؤلاء الّذين يحيطون حولكم؟

10
00:01:05,460 --> 00:01:07,180
لاحاظت إذاً

11
00:01:07,180 --> 00:01:09,580
دعني أحدّثك عن عائلة هيل

12
00:01:10,120 --> 00:01:11,580
عائلة هيل؟

13
00:01:11,830 --> 00:01:16,010
لطالما كانت سُلالتهم مسؤولة عن استخبارات المملكة

14
00:01:16,390 --> 00:01:18,940
الخادمة المُخلِصة لمُعلّمتك الحسناء

15
00:01:18,940 --> 00:01:23,090
هي في الواقع واحدة من خيرة عُملاء الاستخبارات

16
00:01:23,090 --> 00:01:25,150
الآنسة كارلا هي عميلة استخباراتيّة؟

17
00:01:25,800 --> 00:01:30,220
!لا أصدّق أنكِ وصفتِ نفسكِ بالحسناء يا ليديا

18
00:01:26,130 --> 00:01:29,700
شكراً على الاعتناء بأخي الصّغير يا راي

19
00:01:29,700 --> 00:01:30,990
أخوك الصّغير؟

20
00:01:30,990 --> 00:01:31,770
هذا أنا

21
00:01:32,750 --> 00:01:36,080
!قائد نادينا هو أخو كارلا الصّغير؟

22
00:01:36,080 --> 00:01:37,820
اسمي ليكس هيل

23
00:01:37,820 --> 00:01:40,720
،بعد الكشف عن ذلك، سررتُ بلقائك ثانية

24
00:01:40,720 --> 00:01:42,390
كـ-كذلك أنا

25
00:01:42,390 --> 00:01:43,660
لندخُل صلب الموضوع

26
00:01:44,100 --> 00:01:47,490
حاصدو الموتى قد اخترقوا الفروسيّة السحريّة

27
00:01:44,360 --> 00:01:46,340
...أيّتها الورديّة الحمقاء

28
00:01:47,490 --> 00:01:52,670
هدفهم هو اختطاف بنات العائلات
النّبيلة النّخبة أو قتلهن

29
00:01:52,670 --> 00:01:53,500
هنا يأتي دورك

30
00:01:53,840 --> 00:01:55,890
أريدك أن تكون يقِظاً كذلك

31
00:01:55,890 --> 00:01:58,620
،بما أنّهم يستهدفون التّلاميذ

32
00:01:58,620 --> 00:02:01,160
فإنّ احتماليّة مواجهتك لهم كبيرة

33
00:02:01,160 --> 00:02:02,510
عُلِم

34
00:02:02,510 --> 00:02:03,510
أعتذر عن هذا

35
00:02:03,900 --> 00:02:06,150
ليكس مسؤول عن أمن التّلاميذ

36
00:02:06,610 --> 00:02:09,140
إذا حدث أي شيء، يستطيع مُساعدتك

37
00:02:09,480 --> 00:02:11,650
أعتمد عليك يا راي

38
00:02:12,970 --> 00:02:14,640
لا تُرخِ دفاعك

39
00:02:14,640 --> 00:02:17,860
إذا ضاقت الأمور، يمكنك استخدام هذا أيضاً

40
00:02:15,250 --> 00:02:17,290
!ليديا

41
00:02:18,290 --> 00:02:19,580
!بئساً

42
00:02:18,620 --> 00:02:19,580
!عُلِم

43
00:02:22,050 --> 00:02:23,630
إمبراطوريّة أيويل

44
00:02:25,080 --> 00:02:26,450
حاصدو الموتى

45
00:02:27,870 --> 00:02:30,250
لن تعترضوا طريق آميليا والآخرين

46
00:02:30,990 --> 00:02:33,640
سأضع اسمي على المحكّ كساحر نصل الجليد

47
00:04:08,830 --> 00:04:10,960
!انتهت المُباراة

48
00:04:10,960 --> 00:04:13,510
،بهذا، الإلاهة الحسناء ريبيكا برادلي

49
00:04:13,530 --> 00:04:15,590
،تلميذة سنة ثالثة من أكاديميّة السّحر آرنولد

50
00:04:15,590 --> 00:04:19,060
!تأهّلَتْ للتو إلى الجولة الأخيرة من الفئة الرّئيسيّة

51
00:04:19,060 --> 00:04:22,320
!أثبتت لنا بطلةُ العام الماضي ما يمكنها فعله حقّاً

52
00:04:22,320 --> 00:04:24,050
!إنّها قويّة جدّاً! قويّة جدّاً

53
00:04:24,050 --> 00:04:26,030
!وجميلة جدّاً

54
00:04:26,030 --> 00:04:28,620
!إنّها مُقاتِلة السّيف السّحري المُطلَق

55
00:04:28,620 --> 00:04:31,460
!ستكون ريبيكا-ساما غالباً البطلة هذا العام ثانية

56
00:04:31,460 --> 00:04:33,540
!في الواقع، أيّ نتيجة أخرى ستكون غير منطقيّة

57
00:04:33,900 --> 00:04:39,050
ستكون المُباراة المُقبلة بين لوريو فوتشيا
من أكاديميّة السّحر آرنولد

58
00:04:36,650 --> 00:04:39,050
ريبيكا مُذهلة حقّاً

59
00:04:39,050 --> 00:04:42,760
!ضدّ لوكاس فورست من أكاديميّة السّحر ميركروس

60
00:04:39,280 --> 00:04:40,240
بالفعل

61
00:04:40,740 --> 00:04:41,950
راي؟

62
00:04:43,020 --> 00:04:44,000
ما الخطب؟

63
00:04:45,850 --> 00:04:48,770
...في الواقع... إنّ آميليا

64
00:04:49,080 --> 00:04:50,750
هل أصابَها مكروه؟

65
00:04:51,040 --> 00:04:53,240
لا تخرج من غرفتها

66
00:04:53,240 --> 00:04:56,340
...تقول أنّه إعياء من الأمس، لكن

67
00:04:56,730 --> 00:04:59,690
...يبدو من صوتها أنّها تُعاني

68
00:04:59,690 --> 00:05:02,850
...آميليا لا تُخبرنا بشيء

69
00:05:02,850 --> 00:05:05,080
نحن قلقتان عليها

70
00:05:05,850 --> 00:05:07,120
...هكذا إذاً

71
00:05:07,120 --> 00:05:08,010
راي

72
00:05:08,460 --> 00:05:10,400
!انتهت المُباراة

73
00:05:10,400 --> 00:05:11,740
!المُباراة انتهت

74
00:05:11,740 --> 00:05:14,490
!ويا له من سجلّ لا يُصدَّق

75
00:05:14,490 --> 00:05:16,870
!الرّابح هو لوكاس فورست

76
00:05:16,870 --> 00:05:19,770
!استغرقت المُباراة ثانيتين فقط

77
00:05:19,770 --> 00:05:23,130
!هذا رقم قياسي هنا في الفروسيّة السّحريّة

78
00:05:23,510 --> 00:05:26,530
!كشفَ حصان أسود مُبهر للتو عن نفسه

79
00:05:26,530 --> 00:05:28,450
!ثـ-ثانيتان؟

80
00:05:28,450 --> 00:05:30,550
...لوكاس فورست

81
00:05:30,980 --> 00:05:33,060
إنّه سنة ثانية من ميركروس

82
00:05:42,990 --> 00:05:45,500
يوجد أشخاص مجانين فعلاً

83
00:06:08,590 --> 00:06:10,850
هكذا تكون المعنويّات

84
00:06:10,850 --> 00:06:13,010
!أنتِ مُذهلة

85
00:06:13,010 --> 00:06:15,250
أبي، تيانا

86
00:06:15,250 --> 00:06:16,350
خُذي

87
00:06:16,350 --> 00:06:18,150
شكراً لكِ يا تيانا

88
00:06:18,150 --> 00:06:20,220
سوف نُصلح هذا ثانية

89
00:06:20,650 --> 00:06:23,120
أنا آسفة جدّاً يا أبي

90
00:06:24,040 --> 00:06:25,640
!لا تقلقي بشأن هذا

91
00:06:25,640 --> 00:06:27,900
أتطلّع قُدماً لمُنافسة الغد

92
00:06:28,770 --> 00:06:30,560
سوف أربح حتماً

93
00:06:41,130 --> 00:06:42,460
لمَ لا تذهب؟

94
00:06:49,890 --> 00:06:51,630
إليسا. كلاريس

95
00:06:52,540 --> 00:06:53,710
راي

96
00:06:54,410 --> 00:06:57,250
من فضلِك أنقذ آميليا

97
00:06:57,250 --> 00:07:00,700
أنت الوحيد الّذي يستطيع مُساعدتها الآن

98
00:07:00,700 --> 00:07:01,690
أجل

99
00:07:02,140 --> 00:07:05,400
سأذهب وأخبرها بما أفكّر فيه

100
00:07:11,000 --> 00:07:12,080
!آميليا

101
00:07:12,360 --> 00:07:14,820
!هذا أنا، راي وايت

102
00:07:15,660 --> 00:07:17,720
ليس عليكِ الخروج. اسمعيني فحسب

103
00:07:19,860 --> 00:07:23,310
كنتُ... خائفاً

104
00:07:25,080 --> 00:07:27,310
خائفاً من الولوج إلى قلبكِ

105
00:07:28,110 --> 00:07:30,180
،قلقتُ من أنّني إذا اقتربتُ كثيراً من قلبكِ

106
00:07:30,700 --> 00:07:34,430
فقد أكسره بالخطأ

107
00:07:36,120 --> 00:07:38,670
ظللتُ أسأل نفسي ما إن كان قراري صحيحاً

108
00:07:39,160 --> 00:07:45,070
لذا ظللتُ أهرب من مُواجهتك في الحقيقة

109
00:07:46,520 --> 00:07:49,400
آميليا، أريدكِ أن تخبريني

110
00:07:49,840 --> 00:07:51,860
!أريد أن أعرف قلبكِ

111
00:07:51,860 --> 00:07:53,040
...قلبكِ

112
00:07:53,570 --> 00:07:54,970
أريد أن ألمسه

113
00:08:05,070 --> 00:08:06,120
ادخل

114
00:08:11,430 --> 00:08:15,730
أنا حقّاً بائسة

115
00:08:16,600 --> 00:08:19,670
كما ترى، كلّ ما فعلتُه طوال هذا الوقت

116
00:08:19,670 --> 00:08:22,990
هو الارتقاء لتأمّلات الجميع ونظرتهم لآميليا روز

117
00:08:23,470 --> 00:08:26,770
،بمحض إرادتي، تخيّلتُ انطباع الجميع عنّي

118
00:08:26,770 --> 00:08:28,060
ولعبتُ الدّور

119
00:08:28,590 --> 00:08:32,120
كلّ ذلك كي أصبح شخصاً جديراً
ليكون الابنة الأكبر لعائلة روز

120
00:08:32,920 --> 00:08:38,790
،وحاولتُ وحاولتُ وحاولتث وحاولت

121
00:08:38,790 --> 00:08:40,720
فوصلتُ إلى هذه النقطة

122
00:08:42,370 --> 00:08:46,520
،لكن مُقارنة بكلّ شيء رأيتَه أنت

123
00:08:46,520 --> 00:08:48,910
يبقى هذا كومة رُكام فارغة، أليس كذلك؟

124
00:08:49,650 --> 00:08:54,020
لا جدوى من مُقارنة ماضي النّاس أو مُعاناتهم

125
00:08:54,020 --> 00:09:00,010
لكن من المؤكّد أنّكِ كنتِ تبذلين
جهدكِ رغم كلّ المُعاناة

126
00:09:00,010 --> 00:09:00,870
أليس كذلك؟

127
00:09:02,370 --> 00:09:05,510
أجل. معك حقّ

128
00:09:06,130 --> 00:09:07,340
...لفترة طويلة

129
00:09:08,080 --> 00:09:09,740
...كنتُ أتأذّى لفترة طويلة

130
00:09:10,340 --> 00:09:11,690
لقد عانيت

131
00:09:12,350 --> 00:09:19,290
لطالما تساءلتُ لماذا ظللتُ أعيش
رغم أنّ الحياة مؤذية جدّاً

132
00:09:20,180 --> 00:09:23,800
!ثمّ التقيتُ بالجميع، والتقيتُ بك

133
00:09:23,800 --> 00:09:25,990
!ظننتُ أنّني قد أكسب شيئاً في الواقع

134
00:09:26,920 --> 00:09:31,810
،وبأنّني إذا ربحتُ هذه المُنافسة
بوسعي أن أكون شخصاً أخيراً

135
00:09:31,810 --> 00:09:33,390
...هذا ما كنتُ أعتقده، ومع ذلك

136
00:09:37,160 --> 00:09:40,430
لا يمكنني هزيمة آرياني

137
00:09:42,810 --> 00:09:45,040
،مهما مضى من وقت

138
00:09:45,730 --> 00:09:48,080
لن أكون إلّا مجرّد طائر في قفص

139
00:09:48,760 --> 00:09:50,130
!لماذا؟

140
00:09:50,130 --> 00:09:52,010
!لماذا أنا حيّة؟

141
00:09:52,440 --> 00:09:55,140
"أتظاهر وألعب دور "أنا

142
00:09:55,140 --> 00:09:57,450
،مُحاولة أن أُبلوِرَ النّسخة المثاليّة من نفسي

143
00:09:57,450 --> 00:10:00,020
!لكن ما زلتُ لا أستطيع بلوغ مُستواها

144
00:10:00,020 --> 00:10:03,330
هل لدى هذا النّوع من الحياة أي معنى؟

145
00:10:03,330 --> 00:10:05,600
!أخبرني يا راي

146
00:10:05,600 --> 00:10:09,600
لماذا أنا حيّة؟

147
00:10:11,730 --> 00:10:14,420
،آميليا، كونكِ على قيد الحياة

148
00:10:15,730 --> 00:10:17,690
هذا بحدّ ذاته لا معنى له

149
00:10:19,170 --> 00:10:22,630
لا معنى من وجودنا

150
00:10:26,470 --> 00:10:27,600
!لكن رغم ذلك

151
00:10:31,210 --> 00:10:35,360
!لكن نحن، البشر، يمكننا إيجاد سبب للعيش

152
00:10:35,930 --> 00:10:39,210
يمكنكِ خلق سببكِ الخاص لوجودكِ على قيد الحياة

153
00:10:40,860 --> 00:10:43,690
خلق... سبب؟

154
00:10:44,000 --> 00:10:45,460
،بُكاء وضحك

155
00:10:45,890 --> 00:10:47,920
،أحزن وأفراح

156
00:10:47,920 --> 00:10:51,170
مُشاركة كلّ هذا مع أصدقائكِ ودعم
بعضكم الآخر في الحياة

157
00:10:52,200 --> 00:10:54,900
ألا يكفي هذا كسبب للعيش؟

158
00:11:00,400 --> 00:11:04,520
أريد الاستمرار في العيش، بجانبكِ

159
00:11:06,110 --> 00:11:07,140
حقّاً؟

160
00:11:07,650 --> 00:11:09,870
،لا تُمانع وجودي

161
00:11:10,610 --> 00:11:13,030
حتّى وأنا ضعيفة هكذا؟

162
00:11:13,030 --> 00:11:13,970
لا أمانع

163
00:11:14,730 --> 00:11:17,520
هذه هي آميليا روز الحقيقيّة، أليس كذلك؟

164
00:11:40,920 --> 00:11:42,040
...حسناً إذاً

165
00:11:43,540 --> 00:11:44,590
آميليا؟

166
00:12:15,370 --> 00:12:18,260
لا تقلقي يا آميليا

167
00:12:18,260 --> 00:12:20,160
أنا أؤمن بكِ

168
00:12:20,160 --> 00:12:21,510
أعلم بأنّكِ تستطيعين الفوز

169
00:12:23,260 --> 00:12:25,450
تصبحين على خير يا آميليا

170
00:12:29,020 --> 00:12:30,500
اليوم سوف نشهد

171
00:12:30,500 --> 00:12:33,260
المُباراة الأخيرة لفئة الصّاعدين
!من الفروسيّة السّحريّة

172
00:12:34,000 --> 00:12:38,900
!المُتنافِسان بالسّيف هما آرياني أولغرين وآميليا روز

173
00:12:39,390 --> 00:12:42,880
والمُثير، ستكون هذه مُباراة بين ابنتَي
!عائلتين نبيلتين عظيمتين

174
00:12:42,880 --> 00:12:45,290
من منهما سينتصر يا تُرى؟

175
00:12:46,150 --> 00:12:50,510
!الحلبة مُشتعلة قبل أن تبدأ المُباراة حتّى

176
00:12:51,580 --> 00:12:52,820
آسف لتأخُّري

177
00:12:52,820 --> 00:12:53,670
راي

178
00:12:53,670 --> 00:12:56,250
راي، أين آميليا؟

179
00:12:56,520 --> 00:12:57,910
إنّها بخير الآن

180
00:12:57,910 --> 00:12:58,740
حقّاً؟

181
00:12:59,000 --> 00:13:00,450
!فعلتَها يا راي

182
00:13:00,450 --> 00:13:02,870
هذا بفضل دعمكم

183
00:13:02,870 --> 00:13:05,760
لا، أنت من فعل ذلك

184
00:13:05,760 --> 00:13:07,090
أين كلاريس؟

185
00:13:07,090 --> 00:13:09,270
قالت أنّ لديها بعض الأعمال التنظيميّة

186
00:13:09,270 --> 00:13:12,270
أظنّها ستعود قريباً

187
00:13:12,270 --> 00:13:16,130
فهمت. سأشكرها لاحقاً أيضاً

188
00:13:16,520 --> 00:13:19,470
لكن أنا سعيدة حقّاً أنّ كلّ شيء سارَ بسلاسة

189
00:13:19,470 --> 00:13:24,080
كنتُ قلقة فيما إذا كانت آميليا
ستحظى بنوم كافٍ

190
00:13:24,080 --> 00:13:26,390
ليس عليكِ القلق بشأن ذلك

191
00:13:26,390 --> 00:13:27,060
ماذا؟

192
00:13:27,060 --> 00:13:30,380
قضيتُ اللّيل كلّه معها

193
00:13:30,380 --> 00:13:31,550
!ماذا؟

194
00:13:31,550 --> 00:13:33,660
اللّيل... كلّه؟

195
00:13:33,660 --> 00:13:36,610
أجل. حصلَتْ على نوم كافٍ

196
00:13:36,610 --> 00:13:38,740
!إذاً كنت هناك حتّى الصّباح؟

197
00:13:38,740 --> 00:13:39,990
أجل

198
00:13:41,140 --> 00:13:44,260
على أيّ حال، سأذهب لإعطاء آميليا وردتها الآن

199
00:13:45,480 --> 00:13:50,030
...لا أصدّق بأنّ راي يصعد سلالم البلوغ بهذه العفويّة

200
00:13:50,030 --> 00:13:52,040
لا أعتقد أنّ هذا ما حدث يا أيفي

201
00:13:52,040 --> 00:13:52,760
ماذا؟

202
00:13:53,090 --> 00:13:55,110
!الأمر كما في كلّ مرّة

203
00:13:55,110 --> 00:13:57,120
!أقصد، نتحدّث عن راي هنا

204
00:13:57,120 --> 00:14:00,960
!بئساً، يصدمني بشكل دائم

205
00:14:00,960 --> 00:14:02,280
ماذا؟

206
00:14:04,770 --> 00:14:09,030
لا أصدّق بأنّ الأعمال التنظيميّة
!استهلكت كلّ هذا الوقت

207
00:14:09,030 --> 00:14:11,800
!لن ألحق مُباراة آميليا

208
00:14:21,360 --> 00:14:22,670
اقتربَ الوقت

209
00:14:23,380 --> 00:14:24,180
أجل

210
00:14:29,250 --> 00:14:30,960
أنتِ بخير الآن

211
00:14:31,470 --> 00:14:35,010
...راي، المعذرة... في الواقع

212
00:14:35,980 --> 00:14:43,240
هل يمكنني... الحصول على عِناق آخر؟

213
00:14:43,490 --> 00:14:45,230
بالطبع

214
00:14:49,190 --> 00:14:50,440
أنا ذاهبة إذاً

215
00:14:52,090 --> 00:14:53,210
حسناً

216
00:14:53,210 --> 00:14:55,400
إن كان هناك من يستطيع الفوز، فهو أنتِ يا آميليا

217
00:14:55,830 --> 00:14:56,590
أجل

218
00:15:00,920 --> 00:15:02,210
المعذرة يا سيرا

219
00:15:02,210 --> 00:15:02,950
ماذا؟

220
00:15:02,950 --> 00:15:04,570
حدث أمر طارئ للتو

221
00:15:04,570 --> 00:15:07,200
الآن؟ لكن المُباراة على وشك أن تبدأ

222
00:15:07,200 --> 00:15:08,410
أعتذر حقّاً

223
00:15:08,680 --> 00:15:09,890
أعتمد عليكِ

224
00:15:09,890 --> 00:15:11,670
!انتظر

225
00:15:19,830 --> 00:15:20,560
سيّدي

226
00:15:20,840 --> 00:15:24,350
،كلاريس كليفلاند، ابنة عائلة نبيلة رفيعة

227
00:15:24,350 --> 00:15:27,080
مع ثمانية تلاميذ نُبلاء آخرين قد اختفوا

228
00:15:27,440 --> 00:15:29,570
سوف أتوجّه للأسفل

229
00:15:29,570 --> 00:15:30,580
الأسفل؟

230
00:15:30,580 --> 00:15:33,310
أشعر بشيء مشؤوم من هناك

231
00:15:33,310 --> 00:15:34,360
هكذا إذاً

232
00:15:34,360 --> 00:15:38,120
إذاً سأطمئنّ على ليدي والآخرين قبل الانضمام لك

233
00:15:38,120 --> 00:15:39,380
عُلِم

234
00:15:40,130 --> 00:15:42,820
!كارو كارو

235
00:15:42,820 --> 00:15:44,370
!آسفة لو تأخّرت عليكِ

236
00:15:44,370 --> 00:15:47,080
مُعلّمة كارول، أين كنتِ؟

237
00:15:47,400 --> 00:15:49,300
في موعد غرامي

238
00:15:51,250 --> 00:15:52,790
!وها قد عدنا

239
00:15:52,790 --> 00:15:54,340
!مرحباً، رائع

240
00:15:54,340 --> 00:15:57,490
!سوف نبدأ الآن المُباراة النّهائية من فئة الصّاعدين

241
00:15:58,860 --> 00:16:01,850
حان الوقت أخيراً يا آميليا

242
00:16:01,850 --> 00:16:02,870
أجل

243
00:16:03,720 --> 00:16:05,860
سوف أربح هذه

244
00:16:05,860 --> 00:16:08,040
لا، أنا من سيربح

245
00:16:08,590 --> 00:16:11,110
!لنحسم هذا الأمر إذاً

246
00:16:11,110 --> 00:16:12,110
!لنحسمه

247
00:16:12,110 --> 00:16:13,910
!وقد بدأت المُباراة

248
00:16:16,430 --> 00:16:19,670
!يبدو وكأنّ المُتنافِسة أولغين رمت سيفها بعيداً

249
00:16:23,110 --> 00:16:24,160
!أوغر

250
00:16:27,180 --> 00:16:29,910
لمَ لا نبدأ بأقصى قوّة؟

251
00:16:38,690 --> 00:16:39,940
...هذه

252
00:16:39,940 --> 00:16:41,560
نفس الحركة الّتي استخدمَتْها لهزيمة آلبيرت...

253
00:16:41,790 --> 00:16:43,630
!استعراض عجيب للسّرعة

254
00:16:43,630 --> 00:16:45,980
أيّ نوع من السّحرب هو هذا؟

255
00:16:45,980 --> 00:16:50,080
هذه إحدى تعويذاتها الأصليّة

256
00:16:50,510 --> 00:16:54,020
من المُدهش قليلاً أن تختصّ إلى هذا
القدر على الصّعيد الجسدي

257
00:16:55,330 --> 00:16:58,610
!لم أنتهِ بعد يا آميليا

258
00:17:10,570 --> 00:17:11,680
!أختي

259
00:17:18,860 --> 00:17:21,310
هذا... أهو حقّاً...؟

260
00:17:25,080 --> 00:17:26,440
...لن

261
00:17:27,500 --> 00:17:29,280
!أخسر أبداً

262
00:17:34,040 --> 00:17:35,080
!كلاريس

263
00:17:37,470 --> 00:17:39,300
هل أنتِ بخير؟

264
00:17:45,470 --> 00:17:47,380
!خُنفساء أيل ضخمة

265
00:17:47,800 --> 00:17:50,140
كلاريس، هل تأذّيتِ؟

266
00:17:50,140 --> 00:17:51,580
ماذا؟

267
00:17:52,370 --> 00:17:55,200
كيف وصلتُ إلى هنا؟

268
00:17:56,370 --> 00:17:57,740
ما هذا؟

269
00:17:57,740 --> 00:17:59,870
إنّها تعويذة تشويش ذات نطاق واسع

270
00:17:59,870 --> 00:18:00,960
لقد بدؤوا

271
00:18:00,960 --> 00:18:02,470
تشويش ذات نِطاق واسع؟

272
00:18:02,810 --> 00:18:03,650
هذا صحيح

273
00:18:04,140 --> 00:18:06,770
هذه المنطقة معزولة عن العالم الخارجي

274
00:18:08,210 --> 00:18:10,030
لا بدّ أنّهم حاصدو الأرواح

275
00:18:10,030 --> 00:18:12,290
!من هؤلاء؟

276
00:18:12,290 --> 00:18:13,760
كلاريس، أنا آسف

277
00:18:13,760 --> 00:18:15,290
!ماذا؟

278
00:18:15,290 --> 00:18:17,600
!انتظر يا راي. راي

279
00:18:17,600 --> 00:18:19,900
لا تتكلّمي لبعض الوقت

280
00:18:19,900 --> 00:18:23,740
!تـ-تـ-تنّورتي

281
00:18:22,110 --> 00:18:24,460
!قفل كرونوس، تحرير

282
00:18:25,440 --> 00:18:27,160
!لا

283
00:18:27,470 --> 00:18:28,810
!الأنصال الجليديّة

284
00:18:28,810 --> 00:18:30,520
!ماذا؟

285
00:18:30,520 --> 00:18:32,180
...هذا غير ممكن

286
00:18:32,180 --> 00:18:34,700
!لا

287
00:18:35,180 --> 00:18:37,270
!كلاريس، حذارِ من عضّ لسانكِ

288
00:18:37,270 --> 00:18:39,760
!لكن... لكن

289
00:18:43,510 --> 00:18:45,060
الآن ماذا؟

290
00:18:46,780 --> 00:18:47,980
راي؟

291
00:18:47,980 --> 00:18:49,050
لا عليكِ

292
00:19:05,920 --> 00:19:09,800
ماذا حدث بالضبط للتو؟

293
00:19:09,800 --> 00:19:12,060
ماذا؟

294
00:19:12,060 --> 00:19:14,260
حقل مُضادّ للمادّة

295
00:19:14,260 --> 00:19:15,460
راي

296
00:19:17,070 --> 00:19:18,510
!لن تفلت

297
00:19:18,510 --> 00:19:19,880
!غُبار الألماس

298
00:19:27,690 --> 00:19:29,650
!مُذهل

299
00:19:29,650 --> 00:19:32,040
كأنّه عالم من الجليد

300
00:19:32,480 --> 00:19:34,410
راي، هل انتهى الأمر؟

301
00:19:34,410 --> 00:19:36,900
أجل. لم أقتلهم

302
00:19:37,180 --> 00:19:38,810
فهمت

303
00:19:38,810 --> 00:19:40,440
يمكنك ترك ما تبقّى لنا

304
00:19:40,880 --> 00:19:43,120
أليس هناك شخصاً ينتظرك؟

305
00:19:43,120 --> 00:19:44,580
شكراً لك

306
00:19:44,580 --> 00:19:45,700
!مهلاً

307
00:19:45,700 --> 00:19:49,700
!أنزلني أوّلاً

308
00:19:50,010 --> 00:19:53,350
المُباراة الأخيرة في فئة الصّاعدين، أولغرين ضدّ روز

309
00:19:53,350 --> 00:19:56,530
،لا يرضى كِلا المُتنافسين أن يتراجعا
!ولا ينفكّان يتبادلان الضّربات

310
00:19:58,170 --> 00:20:01,560
!سأستخدم ورقتي الرّابحة

311
00:20:02,660 --> 00:20:06,620
!أوغر شينتيلا

312
00:20:08,960 --> 00:20:13,340
!المُتنافسة أولغرين تتلألأ إلى درجة غير مسبوقة

313
00:20:13,340 --> 00:20:14,730
...أبي

314
00:20:14,730 --> 00:20:17,800
!أطلقَتْ عنان كلّ صاعقتها

315
00:20:17,800 --> 00:20:19,500
!آرياني

316
00:20:21,480 --> 00:20:26,070
!ازدادت المُتنافِسة أولغرين بريقاً حتّى

317
00:20:26,790 --> 00:20:30,090
هذا هو إذاً الشّكل الحقيقي للتعويذة الأصليّة لآرياني

318
00:20:30,090 --> 00:20:32,870
!غير معقول. أصبحت أقوى حتّى؟

319
00:20:33,430 --> 00:20:35,370
!ها أنا قادمة

320
00:20:41,070 --> 00:20:42,210
أنتِ بطيئة جدّاً

321
00:20:47,030 --> 00:20:50,190
!الانفجارات لا تعني شيئاً

322
00:20:50,190 --> 00:20:52,410
!إذا كانت لا تُصيبني

323
00:21:10,380 --> 00:21:12,990
!سـ-سقطت المُتنافِسة روز

324
00:21:12,990 --> 00:21:15,180
!هل ستكون هذه هي النّهاية؟

325
00:21:15,180 --> 00:21:18,290
انتهى الأمر يا آميليا

326
00:21:19,820 --> 00:21:22,600
هكذا إذاً

327
00:21:23,170 --> 00:21:25,920
سوف أخسر

328
00:21:27,030 --> 00:21:29,520
،أنا حقّاً لا أريد الخسارة

329
00:21:30,110 --> 00:21:34,380
لكن جسدي لا يتحرّك

330
00:21:34,680 --> 00:21:35,890
!آميليا

331
00:21:35,120 --> 00:21:37,310
آميليا

332
00:21:38,210 --> 00:21:41,970
أريد الاستمرار في العيش بجانبكِ

333
00:21:44,360 --> 00:21:46,610
!آميليا

334
00:21:46,960 --> 00:21:49,410
!انهضي

335
00:21:52,370 --> 00:21:54,380
تشفير بريما ماتيريا

336
00:21:53,160 --> 00:21:55,350
فكّ تشفير شفرة المادّة

337
00:21:54,670 --> 00:21:56,500
مُعالجة شفرة المادّة

338
00:21:54,900 --> 00:21:57,110
تجسيد تيلوس الفعّال

339
00:21:57,110 --> 00:21:57,880
السّببيّة

340
00:22:01,010 --> 00:22:01,880
ما هذا؟

341
00:22:02,570 --> 00:22:03,720
...هذا

342
00:22:05,210 --> 00:22:10,400
آرياني، لم تعودي قادرة على بلوغي

343
00:22:12,380 --> 00:22:13,750
...آميليا

344
00:22:16,990 --> 00:22:18,690
تأثير الفراشة

345
00:23:50,230 --> 00:23:51,630
هذه مُقتطفات من الحلقة القادمة

346
00:23:51,630 --> 00:23:54,110
!من ساحر نصل الجليد سوف يحكم العالم

347
00:23:55,000 --> 00:23:58,370
تتراقص الفراشات القرمزيّة، ويتدفّق
البرق الأزرق السّماويّ، وتستعرّ المعركة

348
00:23:58,370 --> 00:24:02,460
الرّوحان اللّتان افترقتا في ذلك اليوم تُخاطِبان
بعضهما الآخر بتعنّت بواسطة قبضاتهما

349
00:24:02,460 --> 00:24:06,570
الفتى الّذي أصبح السّاحر الأقوى"
"في العالم يُحرِّر القيود

350
00:24:06,570 --> 00:24:08,880
كانت معكم آميليا روز