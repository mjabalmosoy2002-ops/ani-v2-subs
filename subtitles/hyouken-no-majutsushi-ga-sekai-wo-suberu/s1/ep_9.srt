1
00:00:00,670 --> 00:00:03,600
!سنبدأ الآن بالمُباراة النّهائيّة من فئة الصّاعدين

2
00:00:03,990 --> 00:00:05,980
سوف أربح بهذا

3
00:00:06,250 --> 00:00:08,020
لا، أنا من سيربح

4
00:00:08,310 --> 00:00:10,530
!إذاً لنحسم هذا الأمر

5
00:00:10,780 --> 00:00:11,870
!لنحسمه

6
00:00:12,920 --> 00:00:16,150
!سوف لن... أخسر أبداً

7
00:00:16,550 --> 00:00:18,860
!أوغر شينتيلا

8
00:00:27,640 --> 00:00:30,170
!آميليا

9
00:00:30,170 --> 00:00:32,590
!انهضي

10
00:00:34,380 --> 00:00:36,390
تشفير بريما ماتيريا

11
00:00:35,180 --> 00:00:37,390
فكّ تشفير شفرة المادّة

12
00:00:36,680 --> 00:00:38,510
مُعالجة شفرة المادّة

13
00:00:36,930 --> 00:00:39,140
تجسيد تيلوس فعّال

14
00:00:39,140 --> 00:00:39,890
السّببيّة

15
00:00:53,810 --> 00:00:55,460
أثر الفراشة

16
00:01:05,460 --> 00:01:07,150
ماذا؟

17
00:01:07,150 --> 00:01:09,060
!مـ-مهلاً لحظة

18
00:01:18,680 --> 00:01:20,880
آرياني، أخبرتُكِ

19
00:01:21,330 --> 00:01:23,280
لم تعودي قادرة على بلوغي

20
00:01:23,940 --> 00:01:26,860
راي، ما الّذي يجري هناك؟

21
00:01:26,860 --> 00:01:27,970
...هذا

22
00:01:28,550 --> 00:01:32,410
هذا غالباً مفهوم التّداخل الأصليّ

23
00:01:32,410 --> 00:01:33,500
!مفهوم؟

24
00:01:33,500 --> 00:01:37,180
أعتقد يستمدّ مصدره من أثر
الفراشة الخاص بنظريّة الفوضى

25
00:01:37,180 --> 00:01:41,400
سحر خاص جدّاً بالكاد يستطيع
أيّ شخص في هذا العالم استخدامه

26
00:01:41,730 --> 00:01:43,570
...التحكّم بالسببيّة

27
00:01:44,190 --> 00:01:48,870
التّداخل بالعلاقات السببيّة الّتي
،كان من المُفترض أن تحدث

28
00:01:48,870 --> 00:01:49,990
،ليجعلها تنهار

29
00:01:49,990 --> 00:01:52,100
،ثمّ ربطها بالسببيّات الأخرى

30
00:01:52,100 --> 00:01:53,610
...وبالتالي طمسها

31
00:01:55,510 --> 00:01:58,850
،لهذا مهما حاولت آرياني جاهدة

32
00:01:58,850 --> 00:02:01,440
هجماتها لن تُصيب آميليا

33
00:02:01,440 --> 00:02:07,560
هل هذا يعني إذاً أنّ آميليا لا تُقهَر الآن؟

34
00:02:08,230 --> 00:02:11,780
لستُ متأكّدة من هذه النّاحية

35
00:02:14,330 --> 00:02:17,370
آياني، لنكتفِ بهذا القدر

36
00:02:17,840 --> 00:02:19,110
...لا

37
00:02:19,110 --> 00:02:23,150
!لن... لن أخسر أبداً

38
00:02:24,110 --> 00:02:26,090
!أثر الفراشة

39
00:04:09,780 --> 00:04:12,220
!أبي! أختي

40
00:04:12,220 --> 00:04:13,220
...آرياني

41
00:04:13,220 --> 00:04:14,230
!هيّا

42
00:04:14,230 --> 00:04:15,770
!افعليها يا آميليا

43
00:04:27,360 --> 00:04:31,200
هذا مُرهِق جدّاً على الإنغرام الخاص بآميليا

44
00:04:32,110 --> 00:04:35,120
إنّها قريبة جدّاً من السّخونة الزّائدة

45
00:04:35,120 --> 00:04:35,670
!ماذا؟

46
00:04:40,510 --> 00:04:41,790
!آميليا

47
00:04:44,390 --> 00:04:47,290
!لن... أخسر... أبداً

48
00:04:48,720 --> 00:04:50,230
!ولا أنا

49
00:05:15,990 --> 00:05:17,320
!آرياني

50
00:05:17,320 --> 00:05:18,710
!أختي

51
00:05:19,660 --> 00:05:21,840
!آميليا

52
00:05:26,710 --> 00:05:28,920
!استمرّي في القتال يا آميليا

53
00:05:39,380 --> 00:05:41,910
!آميليا

54
00:05:41,910 --> 00:05:45,290
!آرياني

55
00:06:05,610 --> 00:06:06,830
...آرياني

56
00:06:08,860 --> 00:06:10,210
...آميليا

57
00:06:11,830 --> 00:06:14,300
يبدو وجهك في حالة يُرثى لها

58
00:06:14,300 --> 00:06:16,690
جسدكِ مليء بالحروق أيضاً

59
00:06:16,690 --> 00:06:19,760
ذات الأمر ينطبق عليك أيضاً يا آرياني

60
00:06:21,120 --> 00:06:22,630
معكِ حقّ

61
00:06:23,620 --> 00:06:25,500
آميليا

62
00:06:25,500 --> 00:06:26,030
نعم؟

63
00:06:26,590 --> 00:06:31,140
أصبحتِ... قويّة جدّاً

64
00:06:33,770 --> 00:06:34,650
أجل

65
00:06:36,060 --> 00:06:41,330
!صبحتُ... قويّة

66
00:06:42,380 --> 00:06:43,380
أجل

67
00:06:43,380 --> 00:06:45,320
هذا مُذهل حقّاً

68
00:06:46,000 --> 00:06:48,280
!أجل... أجل

69
00:06:50,180 --> 00:06:53,020
لماذا تبكين؟

70
00:06:53,020 --> 00:06:55,700
هزمتِني، أليس كذلك؟

71
00:06:55,700 --> 00:06:58,310
عليكِ أن تكوني فخورة، صحيح؟

72
00:06:59,410 --> 00:07:03,700
وصلتُ إلى هنا بفضل مساعدة الجميع

73
00:07:04,560 --> 00:07:06,810
...الأصدقاء الّذين شكّلتُهم في المدرسة

74
00:07:06,810 --> 00:07:10,610
وراي ساعدني كثيراً

75
00:07:12,310 --> 00:07:13,830
...لكن أتعلمين

76
00:07:13,830 --> 00:07:16,990
السّبب الّذي جعلني أصبح قويّة

77
00:07:18,970 --> 00:07:20,640
كان أنتِ يا آرياني

78
00:07:24,130 --> 00:07:26,810
،لأنّكِ كنتِ هناك دوماً

79
00:07:26,810 --> 00:07:29,120
أمامي، تمكّنتُ من الوصول إلى هنا

80
00:07:31,550 --> 00:07:34,600
لذا... شكراً لكِ

81
00:07:37,000 --> 00:07:38,570
شكراً لكِ أيضاً

82
00:07:40,760 --> 00:07:44,990
تمكّنتُ من أن أصبح أرستقراطيّة فخورة فقط

83
00:07:44,990 --> 00:07:48,650
كي أصبح مِثالاً تحتذين به

84
00:07:48,650 --> 00:07:49,530
ماذا؟

85
00:07:50,610 --> 00:07:52,020
عرفتُ أنّه كانت تراودكِ شكوك

86
00:07:52,640 --> 00:07:55,130
،شكوك حول كيف ينبغي أن يكون الأرستقراطي

87
00:07:55,130 --> 00:07:57,860
كيف ينبغي أن تكوني

88
00:07:58,630 --> 00:08:02,770
لكن لم أعرف كيف أتكلّم معكِ بشأن ذلك

89
00:08:03,470 --> 00:08:08,000
لهذا قرّرتُ أنّني سأكون دوماً
شخصاً لا تشعرين بالخجل بسببه

90
00:08:10,850 --> 00:08:13,300
آميليا، أنا آسفة حقّاً

91
00:08:17,370 --> 00:08:18,750
آميليا

92
00:08:18,750 --> 00:08:22,010
سنكون دوماً صديقتين

93
00:08:23,850 --> 00:08:25,020
أجل

94
00:08:25,020 --> 00:08:27,150
دوماً، دوماً

95
00:08:27,150 --> 00:08:29,260
دوماً، دوماً، دوماً

96
00:08:35,860 --> 00:08:38,690
!آرياني

97
00:08:38,690 --> 00:08:43,150
بذلتُ كلّ ما تعلّمتُه في هذه المعركة

98
00:08:43,590 --> 00:08:46,170
وخسرت

99
00:08:48,500 --> 00:08:50,740
!مُبارك يا آميليا

100
00:08:51,500 --> 00:08:53,550
!أنتِ البطلة

101
00:08:56,050 --> 00:08:59,270
!شكراً لكِ... يا آرياني

102
00:09:00,090 --> 00:09:03,380
!ا-انتهت المُباراة

103
00:09:03,380 --> 00:09:07,410
!بطلة فئة الصّاعدين هي آميليا روز

104
00:09:07,410 --> 00:09:09,630
!كانت معركة مُبهرة

105
00:09:09,630 --> 00:09:12,020
!كلتاكما كنتما رائعتين

106
00:09:12,020 --> 00:09:13,570
!هذا صحيح

107
00:09:13,570 --> 00:09:14,930
،عزيزي الجمهور

108
00:09:14,930 --> 00:09:18,460
من فضلكم صفّقوا لهما بحرارة لقتالهما
!ببسالة حتّى آخر لحظة

109
00:09:19,030 --> 00:09:20,470
!مرحى

110
00:09:19,460 --> 00:09:21,530
!بليتِ بلاء ممتازاً يا آميليا

111
00:09:23,020 --> 00:09:25,540
!كانتا رائعتين للغاية

112
00:09:25,540 --> 00:09:27,060
!أجل

113
00:09:46,990 --> 00:09:48,830
!العمّ كلود

114
00:09:49,430 --> 00:09:50,860
!العمّ

115
00:09:50,860 --> 00:09:52,010
هذه أنتِ يا تيانا

116
00:09:52,010 --> 00:09:53,700
!مرحباً يا كلود

117
00:09:53,980 --> 00:09:56,300
كانت آميليا مُذهلة

118
00:09:56,860 --> 00:09:58,190
لم تصل للمستوى المطلوب بعد

119
00:09:58,190 --> 00:10:00,270
بئساً، كُن سعيداً ولو لمرّة فقط

120
00:10:00,710 --> 00:10:02,230
،خسِرت هذه المرّة

121
00:10:02,230 --> 00:10:04,440
لكن آرياني ستصبح أقوى حتّى

122
00:10:04,440 --> 00:10:05,190
!أجل

123
00:10:05,760 --> 00:10:09,230
...إذاً آميليا ستصبح أقوى حتّى

124
00:10:12,130 --> 00:10:15,930
!كم من الرّائع امتلاك صديق طفولة ومُنافس

125
00:10:23,020 --> 00:10:23,940
!راي

126
00:10:23,940 --> 00:10:26,220
آميليا، كيف حالكِ؟

127
00:10:26,220 --> 00:10:28,650
أنا بخير الآن

128
00:10:28,650 --> 00:10:30,980
مع أنّني بهذا المظهر

129
00:10:30,980 --> 00:10:32,320
ستتعافين قريباً

130
00:10:32,750 --> 00:10:33,550
أجل

131
00:10:34,780 --> 00:10:38,110
الآن بعد أن انتهى ذلك، أشعر وكأنّه
مضى بلمح البصر

132
00:10:38,650 --> 00:10:40,710
،كانت هناك بعض الفترات القاسية

133
00:10:41,070 --> 00:10:43,210
لكن لم أكره ذلك إطلاقاً

134
00:10:43,930 --> 00:10:47,740
أريد الاستمرار في العيش، بجانبك

135
00:10:49,240 --> 00:10:52,110
!لا... فهمت

136
00:10:52,110 --> 00:10:55,840
...قصدتَ كصديق، لكن مع ذلك

137
00:10:55,840 --> 00:10:57,170
ماذا حدث؟

138
00:10:57,660 --> 00:10:59,220
!لا شيء

139
00:11:00,520 --> 00:11:04,970
بالمناسبة، هل كنت تعرف ما هي قوّتي؟

140
00:11:05,240 --> 00:11:08,470
لا، ليس بالتفصيل

141
00:11:08,870 --> 00:11:10,220
،لكن أثناء تدريبنا

142
00:11:10,700 --> 00:11:13,680
شعرتُ بأنّكِ تمتلكين موهبة هائلة

143
00:11:15,060 --> 00:11:17,700
هكذا إذاً

144
00:11:18,140 --> 00:11:21,440
،قد تكون الموهبة وراثيّة

145
00:11:21,440 --> 00:11:23,070
—لكن كانت معركة اليوم

146
00:11:23,070 --> 00:11:25,230
...لأنّني حاولتُ جاهدة

147
00:11:26,320 --> 00:11:27,360
صحيح؟

148
00:11:28,550 --> 00:11:29,840
بالطبع

149
00:11:30,270 --> 00:11:33,670
التّعويذات الأصليّة ليست شيئاً
يكسبه المرء دون أيّ جهد

150
00:11:34,040 --> 00:11:37,900
كان دليلاً على أنّكِ عملتِ بجدّ لفترة طويلة

151
00:11:39,780 --> 00:11:40,920
تهانينا

152
00:11:40,920 --> 00:11:44,270
من جديد، من أعماق قلبي

153
00:11:44,560 --> 00:11:46,530
!شكراً لك يا راي

154
00:11:46,530 --> 00:11:48,510
—أشكرك حقّاً، أشكرك جزيل الشّـ

155
00:11:57,310 --> 00:11:59,400
،لو لم ألتقِ براي

156
00:11:59,400 --> 00:12:02,830
أظنّني كنتُ سأبقى ذلك الطائر في قفص

157
00:12:03,440 --> 00:12:05,880
،أقيّد نفسي بدلاً من بذل قصارى جهدي

158
00:12:05,880 --> 00:12:08,260
وأشتكي أنيناً برأس مُطأطئ

159
00:12:17,630 --> 00:12:19,460
!آميليا

160
00:12:19,900 --> 00:12:22,100
!أجل! قادمة

161
00:12:24,810 --> 00:12:27,350
!اليوم هو المُواجهة الأخيرة من الفئة الرّئيسيّة

162
00:12:27,870 --> 00:12:30,640
لنُشجّع ريبيكا من أعماق قلبنا

163
00:12:30,640 --> 00:12:31,350
!أجل

164
00:12:32,570 --> 00:12:35,310
،أنا، آميليا روز

165
00:12:35,310 --> 00:12:38,000
لم أعُد عصفوراً حبيساً في قفص النُّبلاء

166
00:12:43,600 --> 00:12:48,510
سأعيش في هذا العالم بأكمله
!إلى جانب الآخرين جميعهم

167
00:12:52,810 --> 00:12:56,080
!حان الوقت أخيراً لذروة الفروسيّة السحريّة

168
00:12:56,080 --> 00:12:58,960
...المُرشّحة لنَيل لقب البطل هي ريبيكا-ساما

169
00:12:59,510 --> 00:13:02,410
أقصد ريبيكا برادلي

170
00:13:02,420 --> 00:13:06,140
ويُواجهها الحصان الأسود الّذي شقّ طريقه عبر
!سلّم التّرقيات سريعاً، لوكاس فورست

171
00:13:12,850 --> 00:13:14,440
...هذا

172
00:13:18,690 --> 00:13:23,980
!من ستبتسم له إلاهة النّصر في هذه المُباراة الأخيرة؟

173
00:13:25,920 --> 00:13:27,580
أتطلّع قدماً لمعركتنا

174
00:13:29,840 --> 00:13:31,370
!وتبدأ المعركة

175
00:13:51,020 --> 00:13:52,390
التقنيّة السرّية الثّامنة

176
00:14:01,350 --> 00:14:03,090
تعتيم الوهج

177
00:14:14,670 --> 00:14:16,240
شكراً لك

178
00:14:19,260 --> 00:14:20,960
!ا-انتهت

179
00:14:20,960 --> 00:14:23,030
استغرقَ ذلك لحظة فقط

180
00:14:23,640 --> 00:14:28,040
بطل الفئة الرئيسيّة من الفروسيّة
!السحريّة هو لوكاس فورست

181
00:14:28,620 --> 00:14:33,800
الحصان الأسود لهذه البطولة قد
!حصلَ على أفضل لقب أخيراً

182
00:14:33,800 --> 00:14:36,550
!جميعكم، صفّقوا له بحرارة رجاء

183
00:14:45,090 --> 00:14:48,060
أنت نصل الجليد الحالي، صحيح؟

184
00:14:48,350 --> 00:14:52,280
"لم أكن أعلم أنّ "ساحر النّصل الّذي لا نظير له
قد تمّ توارثه أيضاً

185
00:14:52,630 --> 00:14:54,010
عرفت؟

186
00:14:54,010 --> 00:14:57,250
كيف لي ألّا أعرف، بعد رؤيتي تلك التقنيّة السرّية؟

187
00:14:58,470 --> 00:14:59,580
توقّعت

188
00:15:00,220 --> 00:15:02,610
توقّعتُ أن تعرف

189
00:15:03,810 --> 00:15:05,230
لماذا؟

190
00:15:05,230 --> 00:15:07,920
"لا أفهم سبب مُشاركة "ساحر السّيف الّذي لا نظير له

191
00:15:07,920 --> 00:15:11,050
في الفروسيّة السحريّة والّتي هي مُنافسة للتلاميذ

192
00:15:11,640 --> 00:15:15,180
أردتُ أن أريك

193
00:15:17,270 --> 00:15:19,690
أريد مقاتلة نصل الجليد

194
00:15:21,310 --> 00:15:26,710
أردتُك أن ترى أنّ السّاحر الأقوى
هو النّصل الّذي لا نظير له

195
00:15:29,560 --> 00:15:33,580
لكن أوّلاً، عالِج السّخونة الزائدة بشكل كامل

196
00:15:34,300 --> 00:15:37,330
وإلّا فلا أستطيع مواجهتك بكامل قوّتي

197
00:15:38,180 --> 00:15:39,670
أراك في العام المُقبل

198
00:15:39,670 --> 00:15:41,040
سأكون في الانتظار هنا

199
00:15:46,210 --> 00:15:47,680
العام المُقبل...؟

200
00:15:50,840 --> 00:15:53,910
إذاً المُنافسة انتهت من الآن

201
00:15:53,910 --> 00:15:55,960
هذا مُحزِن بعض الشّيء

202
00:15:55,960 --> 00:15:58,340
حدث ذلك بسرعة فائقة

203
00:15:58,340 --> 00:16:00,470
هذه الورديّة الحمقاء مزعجة للغاية

204
00:16:00,820 --> 00:16:02,830
!لا أصدّق بأنّك استأجرتها

205
00:16:02,830 --> 00:16:03,980
!بئساً

206
00:16:03,980 --> 00:16:07,400
ليديا، أنتِ لئيمة جدّاً دوماً

207
00:16:07,400 --> 00:16:10,940
!لكن أعلم بأنّكِ تحبّينني في حقيقة الأمر

208
00:16:10,940 --> 00:16:12,280
!أنتِ تسونديري

209
00:16:12,280 --> 00:16:15,110
آبي، بجدّية، هل يمكنني أذيّتها؟

210
00:16:15,540 --> 00:16:17,060
اضبطي نفسكِ يا ليديا

211
00:16:17,060 --> 00:16:19,070
الوقت غير مناسب لذلك الآن

212
00:16:19,760 --> 00:16:20,910
أجل، أجل

213
00:16:24,330 --> 00:16:26,150
افعليها من فضلكِ يا كارول

214
00:16:26,930 --> 00:16:28,090
!لكِ ذلك

215
00:16:28,090 --> 00:16:29,180
!اسمعوا

216
00:16:29,180 --> 00:16:31,110
!سيكون كلّ شيء على ما يُرام قريباً

217
00:16:31,110 --> 00:16:33,750
!انظروا هنا جميعاً

218
00:16:34,090 --> 00:16:35,810
!لنتحرّك

219
00:16:36,720 --> 00:16:39,090
!كارول في بلاد العجائب

220
00:16:51,930 --> 00:16:53,280
!يمين

221
00:16:53,800 --> 00:16:55,240
!يسار

222
00:16:55,770 --> 00:16:57,710
!والآن دوران

223
00:16:58,280 --> 00:16:59,630
!قفز إلى اليسار

224
00:16:59,630 --> 00:17:01,460
!خطوة إلى اليمين

225
00:17:01,700 --> 00:17:03,150
!اليدان على الورك

226
00:17:03,150 --> 00:17:07,160
!ضمّ الرّكبتين وهزّ الورك

227
00:17:07,160 --> 00:17:09,960
"إنّها حقّاً "ساحرة التّعويذات المُقيّدة

228
00:17:07,160 --> 00:17:11,410
هزّ، هزّ، هزّ

229
00:17:09,960 --> 00:17:11,410
يا لذوقها المُنحدر

230
00:17:11,410 --> 00:17:12,860
!ومرّة أخرى

231
00:17:12,860 --> 00:17:15,750
!أيّتها الورديّة الحمقاء! كفى لعِباً وافعليها فحسب

232
00:17:16,400 --> 00:17:17,760
!حسناً

233
00:17:18,070 --> 00:17:21,270
والآن لنشرع في ذلك

234
00:17:21,840 --> 00:17:28,770
!أفشوا بكلّ شيء عن زعمائكم ومخطّطاتكم المستقبليّة

235
00:17:29,070 --> 00:17:34,020
!هيّا، حرّروا كلّ مخاوفكم اليافعة

236
00:17:41,120 --> 00:17:41,990
...مؤلم

237
00:17:43,200 --> 00:17:45,500
هكذا تفعلها الإمبراطوريّة إذاً

238
00:17:45,500 --> 00:17:46,600
كم هذا خسيس

239
00:17:46,600 --> 00:17:49,130
!هذا يخلو من الذّوق

240
00:17:49,880 --> 00:17:52,070
إنّها مراسم اختتام مُنافسة الفروسيّة السحريّة

241
00:17:52,070 --> 00:17:54,370
!واجتمع كلّ المُتنافسين هنا

242
00:17:54,970 --> 00:17:57,890
يصفّق لهم الجمهور بحرارة

243
00:17:57,890 --> 00:18:00,560
!لتحمّلهم أربعة أيّام من القتال العنيف

244
00:18:04,700 --> 00:18:07,410
!تهانينا يا آميليا

245
00:18:07,410 --> 00:18:08,890
!تهانينا

246
00:18:11,820 --> 00:18:13,940
!وصلت في الوقت

247
00:18:13,940 --> 00:18:17,090
!كارول سينسي، أين كنتِ؟

248
00:18:17,610 --> 00:18:20,600
!لكلّ فتاة أسرارها

249
00:18:20,600 --> 00:18:24,020
أجل... ومن هذه الّتي بجانبكِ؟

250
00:18:25,410 --> 00:18:26,560
لا تقلقي بشأني

251
00:18:26,560 --> 00:18:28,100
مجرّد فتاة حسناء عابرة

252
00:18:28,100 --> 00:18:28,880
ماذا؟

253
00:18:28,880 --> 00:18:31,400
!دينا، عبارتكِ التّالية

254
00:18:31,820 --> 00:18:36,030
والآن الخِطاب الاختتامي من رئيسة
،مُنظّمي البطولة

255
00:18:36,030 --> 00:18:39,550
!مُديرة أكاديميّة السّحر آرنولد، آبي غارنيت

256
00:18:40,090 --> 00:18:44,390
!انتهت الفروسيّة السحريّة بصورة آمنة لهذا العام

257
00:18:44,670 --> 00:18:46,870
،رغم أنّ جميعكم تلاميذ

258
00:18:46,870 --> 00:18:50,380
جميعكم أظهرتُم لنا معاركَ على مستوى رفيع جدّاً

259
00:18:50,710 --> 00:18:55,600
وأوجّه الشّكر الجزيل لجمهورنا وطاقمنا
على تشجيع الجميع كذلك

260
00:18:55,600 --> 00:18:59,660
أتطلّع قُدماً لرؤيتكم هنا في هذه
!الحلبة من جديد في العام المقبل

261
00:18:59,660 --> 00:19:00,900
!هذا كلّ شيء

262
00:19:08,120 --> 00:19:09,910
،للمهرجان الثّقافي لهذا العام

263
00:19:09,910 --> 00:19:12,830
أقترح أن يدير صفُّنا

264
00:19:12,830 --> 00:19:14,880
!مقهى خادمات

265
00:19:16,800 --> 00:19:18,770
!ما معنى هذا؟

266
00:19:18,770 --> 00:19:20,790
!لمَ علينا أن نتظاهر بأنّنا خدم؟

267
00:19:20,790 --> 00:19:22,240
!نحن نُبلاء

268
00:19:22,240 --> 00:19:23,290
!مقهى خادمات؟

269
00:19:23,290 --> 00:19:24,660
والخادمات يقدّمن الشّاي؟

270
00:19:24,290 --> 00:19:25,220
على الأغلب

271
00:19:24,660 --> 00:19:27,160
!لا يمكن أن أكون خادمة

272
00:19:29,530 --> 00:19:35,060
على الصّفوف والنّوادي الحصول على
مُوافقة للمشاركة في المهرجان الثّقافي

273
00:19:35,060 --> 00:19:36,180
،لذا للبدء

274
00:19:36,180 --> 00:19:39,920
علينا الحصول على موافقة أثناء الاقتراع يوم غد

275
00:19:39,920 --> 00:19:42,570
فهمتُ فحوى الأمر

276
00:19:42,570 --> 00:19:47,860
لكن ما الّذي تريدين فعله بإلحاح لدرجة
أنّكِ ترغبين في أن تكوني مُنظِّمة؟

277
00:19:48,910 --> 00:19:49,820
هذا

278
00:19:51,880 --> 00:19:53,160
مقهى خادمات؟

279
00:19:54,370 --> 00:19:55,970
هذا مُقترَح ممتاز

280
00:19:55,970 --> 00:19:59,670
ألن يجذب هذا دعم الجميع إذا سلّمتِه فحسب؟

281
00:20:00,330 --> 00:20:03,670
لدينا كثير من الفتيات رفيعي النّسب
في صفّنا، أليس كذلك؟

282
00:20:03,880 --> 00:20:06,830
هل تعتقد أنّهن سيقبلن بأن يُصبحن
خادمات بهذه البساطة؟

283
00:20:06,830 --> 00:20:08,420
...معكِ حقّ

284
00:20:08,420 --> 00:20:11,190
مُجرّد اقتراح هذا لن يفلح

285
00:20:11,190 --> 00:20:14,150
لهذا أردتُ طلب مساعدتك

286
00:20:14,440 --> 00:20:17,210
—لكن كيف لي، كرجل، أن

287
00:20:17,210 --> 00:20:18,790
!راي! اسمع

288
00:20:18,790 --> 00:20:19,290
نعم؟

289
00:20:19,510 --> 00:20:21,610
،في وجه روعة الخادمات

290
00:20:21,610 --> 00:20:25,070
!ذكر أو أنثى... هذا لا يهمّ

291
00:20:26,460 --> 00:20:27,530
!خادمات

292
00:20:27,530 --> 00:20:30,610
!وجودهن بحدّ ذاته جذّاب بالفعل

293
00:20:30,900 --> 00:20:33,450
،عندما تتذكّر أنّهن دوماً مُخلصات لسيّدهن

294
00:20:33,450 --> 00:20:36,180
!تشعر بأنّ تعابير وجههن الأخّاذة هي تعابير إلاهة

295
00:20:36,180 --> 00:20:38,160
!وذلك الزيّ الرّسمي مُبهر كذلك

296
00:20:38,160 --> 00:20:39,340
،في حين أنّه ليس مُبهرجاً

297
00:20:39,340 --> 00:20:42,130
!إلّا أنّه يتمتّع بجمال ونُبل وتواضُع في نفس الوقت

298
00:20:44,650 --> 00:20:45,800
!هذا صحيح

299
00:20:45,800 --> 00:20:48,060
!قطعاً ليس شخصاً يُستخفّ به

300
00:20:48,060 --> 00:20:49,020
!خادمة في الجنّة

301
00:20:49,020 --> 00:20:50,760
!أهلاً بكِ في قدري

302
00:20:50,760 --> 00:20:52,540
!تفهمني، صحيح؟ صحيح؟

303
00:20:52,540 --> 00:20:53,240
!أجل

304
00:20:53,900 --> 00:20:59,700
اقتراحي هو أنّ زيّ الخادمة في المهرجان
الثّقافي ستكون تنّورته أقصر

305
00:20:59,930 --> 00:21:01,580
،إنّها مُغادرة لما هو معياري

306
00:21:01,580 --> 00:21:04,840
لكن أعتقد سيكون من المثالي الإغارة
!العفويّة على مهنة الخادمات

307
00:21:04,840 --> 00:21:06,980
طول التنّورة يُحدِث فرقاً؟

308
00:21:06,980 --> 00:21:09,130
!أجل! بالطبع

309
00:21:09,900 --> 00:21:10,820
،في الواقع

310
00:21:10,820 --> 00:21:13,690
علينا أن نبذل جهداً لنجعل هذا
!النّمط هو الرّائج

311
00:21:14,220 --> 00:21:17,320
الخادمات اللّواتي كُنّ يعشن في ظلّ سيّدهن

312
00:21:17,320 --> 00:21:19,560
!يصرّحن عن وجودهن أخيراً

313
00:21:19,560 --> 00:21:21,330
!ألا تعتقدون أنّ هذه فكرة ثوريّة؟

314
00:21:22,440 --> 00:21:24,590
!أعتقد أنّ هذه فكرة جيّدة

315
00:21:24,590 --> 00:21:29,280
!ترى كاروكارو أنّكن ستُشكّلن خادمات ظريفات جدّاً

316
00:21:30,210 --> 00:21:31,270
!فلتشهدوا

317
00:21:32,070 --> 00:21:33,090
!مفاجأة

318
00:21:42,710 --> 00:21:44,890
أنا مسرورة جدّاً لأنّ الأمور سارت على ما يُرام

319
00:21:44,890 --> 00:21:47,860
آمل ألّا نكون قد فرضنا عليهم ذلك بالقوّة

320
00:21:47,860 --> 00:21:49,580
!لا مُشكلة، لا مُشكلة

321
00:21:49,580 --> 00:21:51,810
كان خطابك المليء بالشّغف مؤثّراً جدّاً

322
00:21:51,810 --> 00:21:52,750
مُبهر

323
00:21:53,010 --> 00:21:54,550
،إن كنّا نتحدّث عن الإبهار

324
00:21:54,550 --> 00:21:58,140
فأعتقد هذا ينطبق عليكِ أكثر
لإشراككِ كارول من قبل كذلك

325
00:21:58,140 --> 00:21:59,180
!راي

326
00:22:00,690 --> 00:22:02,090
آنسة سيرا؟

327
00:22:02,090 --> 00:22:03,530
هل حدث شيء؟

328
00:22:03,530 --> 00:22:06,340
...ريبيكا... إنّها

329
00:22:06,340 --> 00:22:07,780
هل أصابَها مكروه؟

330
00:22:08,180 --> 00:22:10,020
!"يبدو أنّها "خُطِبَتْ

331
00:23:50,400 --> 00:23:51,890
هذه مُقتطفات من الحلقة القادمة

332
00:23:51,890 --> 00:23:54,260
!من ساحر نصل الجليد سوف يحكم العالم

333
00:23:55,000 --> 00:23:56,630
!المهرجان الثّقافي هو حدث لا يُفوَّت

334
00:23:56,630 --> 00:23:59,120
يجتمع الجميع في حبّهم المُشترك للزركشة الأنيقة

335
00:23:59,120 --> 00:24:02,490
يُقال بأنّ هذا الزيّ جذّاب جدّاً
لدرجة أنّه لا يستطيع أحد المُقاومة

336
00:24:02,490 --> 00:24:06,210
الفتى الّذي أصبح السّاحر الأقوى"
!"يفتتح مقهى خادمات

337
00:24:06,690 --> 00:24:09,300
كانت معكم آرياني آلغرين