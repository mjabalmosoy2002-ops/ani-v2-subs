1
00:00:11,280 --> 00:00:12,640
.مرحبًا يا تيرو-تشان

2
00:00:12,640 --> 00:00:14,140
!صباح الخير

3
00:00:14,140 --> 00:00:16,370
!"عليكما مناداتي "سينسي

4
00:00:16,840 --> 00:00:18,240
.صباح الخير يا تيرو-تشان

5
00:00:18,600 --> 00:00:21,440
!"قلتُ نادوني "سينسي

6
00:00:28,090 --> 00:00:28,960
!سأكون الأولى

7
00:00:28,960 --> 00:00:30,200
!انتظري

8
00:00:32,610 --> 00:00:34,000
هل أنت بخير؟

9
00:00:34,000 --> 00:00:35,470
.كوني حذرة

10
00:00:35,770 --> 00:00:37,290
.أنت جانحة

11
00:00:38,030 --> 00:00:39,390
!أنت جانحة

12
00:00:39,630 --> 00:00:41,800
!إنّها جانحة، جانحة

13
00:00:41,800 --> 00:00:43,560
...مهلاً

14
00:00:46,850 --> 00:00:47,880
!بلع

15
00:00:49,320 --> 00:00:52,000
!صـ-صباح الخير يا سوناو-سان

16
00:00:52,430 --> 00:00:55,850
.هذه أنت يا سينسي، صباح الخير

17
00:00:55,850 --> 00:00:57,240
سـ-سينسي؟

18
00:00:57,240 --> 00:01:01,340
!مستحيل! تبدو عبارة "سينسي" متعجرفة

19
00:01:01,340 --> 00:01:04,500
."يـ-يمكنك مناداتي... "أوشيي

20
00:01:05,920 --> 00:01:07,120
.لكنّ ذلك ليس مناسبًا

21
00:01:08,590 --> 00:01:11,890
!أنا آسفة

22
00:02:55,600 --> 00:02:58,680
.لا أرى أيّ شيء غريب

23
00:02:58,680 --> 00:02:59,450
أخبريني يا بوتشي؟

24
00:02:59,760 --> 00:03:08,260
.أريد مغادرة المدرسة مع هونشو-سان

25
00:03:08,260 --> 00:03:09,240
.على رسلك

26
00:03:09,240 --> 00:03:13,170
سيكون حلمًا قد تحقّق إذا غادرنا
!نحن الثّلاثة المدرسة معًا

27
00:03:13,880 --> 00:03:17,190
إذًا فهذا ليس الوقت المناسب
لتتمتمي بذلك لنفسك، صحيح؟

28
00:03:17,800 --> 00:03:18,940
!ناكو-تشان؟

29
00:03:18,940 --> 00:03:20,550
.عليك دعوتها في البداية

30
00:03:23,270 --> 00:03:24,160
!نعم

31
00:03:24,160 --> 00:03:26,140
.تبدين واثقة من نفسك

32
00:03:26,140 --> 00:03:28,090
.نحن في ورطة إذًا

33
00:03:28,090 --> 00:03:29,010
!سأبذل جهدي

34
00:03:30,510 --> 00:03:31,770
!حسنًا، أنا ذاهبة الآن

35
00:03:46,410 --> 00:03:47,360
.لقد عدت

36
00:03:47,360 --> 00:03:48,660
لم تفعلي أيّ شيء، صحيح؟

37
00:03:49,120 --> 00:03:50,400
...لكن

38
00:03:50,400 --> 00:03:52,080
.لا تقلقي كثيرًا

39
00:03:52,080 --> 00:03:54,120
.أنتما صديقتان سلفًا

40
00:03:54,380 --> 00:03:56,830
لكن ماذا إن كرهَتني؟

41
00:03:57,480 --> 00:04:00,410
إنّ فكرة عدم كونها صديقتي
...بعد الآن

42
00:04:00,410 --> 00:04:02,970
...صدمة كاي-تشان

43
00:04:04,750 --> 00:04:08,720
لم تكرهكِ كاي-تشان، صحيح؟

44
00:04:08,720 --> 00:04:10,420
.هيّا. اذهبي إليها

45
00:04:13,700 --> 00:04:19,840
.هونشو-سان، لنعد للمنزل معًا

46
00:04:20,470 --> 00:04:22,070
.جيّد. جيّد

47
00:04:28,560 --> 00:04:29,030
—هونشو

48
00:04:29,500 --> 00:04:31,870
!أرو، دعيني أرى ملاحظاتك

49
00:04:32,370 --> 00:04:34,340
يا إلهي، ثانية؟

50
00:04:34,340 --> 00:04:37,330
ستواجهين المشاكل إن لم تبدئي
.في تدويني ملاحظاتك الخاصّة

51
00:04:42,200 --> 00:04:43,160
.هيّا، هيّا

52
00:04:43,160 --> 00:04:45,340
.لكن هنالك أشخاص أكثر الآن

53
00:04:46,730 --> 00:04:47,810
.ذلك غير مهمّ

54
00:04:47,810 --> 00:04:49,050
.واصلي

55
00:04:49,050 --> 00:04:50,510
أواصل؟

56
00:04:50,510 --> 00:04:51,400
.اذهبي

57
00:04:55,040 --> 00:04:59,730
—هو-هونشو-سان

58
00:04:57,150 --> 00:04:58,150
!أرو

59
00:05:00,020 --> 00:05:01,070
!أرو

60
00:05:01,480 --> 00:05:02,400
—هو-هونشو-سان

61
00:05:02,980 --> 00:05:03,670
—هونشو

62
00:05:03,670 --> 00:05:04,830
—هو-هونـ

63
00:05:04,830 --> 00:05:05,510
—هونشـ

64
00:05:05,510 --> 00:05:13,190
—هو

65
00:05:06,200 --> 00:05:11,630
—هونـ

66
00:05:11,630 --> 00:05:12,410
—هونشو

67
00:05:14,940 --> 00:05:16,300
...هونشو-سان

68
00:05:16,300 --> 00:05:18,080
ماذا تفعلين؟

69
00:05:18,080 --> 00:05:21,380
.إنّ لدى هونشو-سان شعبيّة كبيرة

70
00:05:21,850 --> 00:05:26,530
ظننتُ أنّنا سنكون برفقة بعضنا دائمًا
،بمجرّد أن أصبحنا صديقات

71
00:05:26,530 --> 00:05:28,340
.لكنّني كنت مخطئة. النّهاية

72
00:05:30,010 --> 00:05:31,860
أهذا وقت مناسب لتدوين الملاحظات؟

73
00:05:32,280 --> 00:05:34,480
.هيّا. اتبعيني

74
00:05:34,480 --> 00:05:35,930
—ناكو-تشان، هذا

75
00:05:36,280 --> 00:05:37,390
.أيّتها الغبيّة

76
00:05:37,640 --> 00:05:38,870
!لماذا؟

77
00:05:40,400 --> 00:05:41,680
!هيتوري-سان

78
00:05:44,560 --> 00:05:45,950
نذهب للمنزل معًا؟

79
00:05:46,490 --> 00:05:47,490
.نعم

80
00:05:48,020 --> 00:05:49,940
!حسنًا، لا مانع

81
00:05:52,710 --> 00:05:55,700
لماذا ضربتني على رأسي؟

82
00:05:58,680 --> 00:05:59,580
.بدون أيّ سبب

83
00:05:59,580 --> 00:06:01,890
!ماذا تقصدين؟

84
00:06:02,830 --> 00:06:06,580
.أنت شخص مختلف تمامًا خارج الفصل

85
00:06:06,580 --> 00:06:08,270
.لديّ اسم

86
00:06:08,270 --> 00:06:09,880
.لكنّني سعيدة

87
00:06:09,880 --> 00:06:13,160
.كنتُ أتساءل لماذا لم تحدّثاني

88
00:06:13,860 --> 00:06:16,450
أذلك ما ظننته أيضًا يا هونشو-سان؟

89
00:06:16,450 --> 00:06:17,770
.بالطّبع

90
00:06:18,180 --> 00:06:21,610
.أنتما الوحيدتان اللّتان تعرفان كم أنا مؤسِفة

91
00:06:22,220 --> 00:06:23,770
.صحيح، أنت مؤسِفة

92
00:06:23,770 --> 00:06:25,750
!من تنعتينها بالمؤسِفة؟

93
00:06:25,750 --> 00:06:27,570
أنت من قالت ذلك، صحيح؟

94
00:06:29,840 --> 00:06:34,900
حسنًا، سأراك ثانية بعد المدرسة
.يا هيتوري-سان— أقصد يا بوتشي

95
00:06:36,000 --> 00:06:36,970
!نعم

96
00:06:36,970 --> 00:06:39,160
!لكن ليس عليك المجيء يا ناكو

97
00:06:39,160 --> 00:06:41,000
.سأكون هناك للأسف

98
00:06:41,000 --> 00:06:42,040
!"لا تنطقي بعبارة "الأسف

99
00:06:42,720 --> 00:06:45,750
!سأغادر المدرسة مع صديقتين

100
00:06:48,740 --> 00:06:51,370
.حسنًا، بهذا ينتهي يومنا

101
00:06:51,370 --> 00:06:52,930
.إلى التّلميذ المسؤول، وقت الوداع

102
00:06:53,560 --> 00:06:54,600
.قيام

103
00:06:59,020 --> 00:06:59,600
.انحناء

104
00:07:00,330 --> 00:07:02,310
!شكرًا جزيلاً

105
00:07:08,690 --> 00:07:10,550
!حسنًا، لنذهب للمنزل

106
00:07:10,550 --> 00:07:11,220
.نعم

107
00:07:11,750 --> 00:07:13,370
...لكنّ بوتشي

108
00:07:13,580 --> 00:07:15,710
.قد فقدت وعيها بسبب الحماس والتّرقّب

109
00:07:15,710 --> 00:07:17,580
!استيقظي

110
00:07:18,220 --> 00:07:21,480
هل تفقدين وعيك دائمًا عندما تكونين سعيدة؟

111
00:07:21,480 --> 00:07:22,160
.نعم

112
00:07:22,160 --> 00:07:24,620
حدثت مؤخّرًا أمور كثيرة تدفعني
،لفقدان وعيي

113
00:07:24,620 --> 00:07:26,150
.لذلك أنا جدّ سعيدة

114
00:07:26,150 --> 00:07:31,800
لا أدري إن كان عليّ أن أشعر بالسّعادة
.من أجلك أو أقلق عليك

115
00:07:34,100 --> 00:07:37,130
أحضرت بعض الحلويّات؟

116
00:07:37,130 --> 00:07:39,060
.هذا مفاجئ بالنّظر كم تبدين مجتهدة

117
00:07:39,610 --> 00:07:41,910
.تعطيني إيّاها ناكو-تشان دائمًا

118
00:07:41,910 --> 00:07:43,750
.لا عجب في ذلك

119
00:07:44,160 --> 00:07:45,740
ماذا عن حصّتي؟

120
00:07:45,740 --> 00:07:47,270
ألن تحذّرينا؟

121
00:07:47,980 --> 00:07:51,400
،اشتريت ما يكفي لاثنتين
.لذلك لم يبق شيء لك يا أنت

122
00:07:52,480 --> 00:07:53,690
.قمتِ بذلك عن قصد

123
00:07:53,690 --> 00:07:55,650
!كما أنّ لديّ اسم

124
00:07:55,650 --> 00:07:57,910
.يبدو الأمر مناسبًا أكثر هكذا

125
00:07:57,910 --> 00:07:59,850
!اخرسي أيّتها الجانحة المزيّفة

126
00:07:59,850 --> 00:08:01,540
!ماذا تقصدين بـ"الجانحة المزيّفة"؟

127
00:08:06,730 --> 00:08:07,610
.إنّكما على وفاق تامّ

128
00:08:07,610 --> 00:08:08,840
!كيف ذلك؟

129
00:08:09,350 --> 00:08:10,780
.لسنا متوافقتان على الإطلاق

130
00:08:10,780 --> 00:08:12,470
.صحيح. على الإطلاق

131
00:08:12,470 --> 00:08:14,840
ماذا؟ لستما على وفاق؟

132
00:08:15,400 --> 00:08:16,300
...أنا

133
00:08:16,690 --> 00:08:18,860
...كنتُ السّعيدة الوحيدة

134
00:08:18,860 --> 00:08:21,450
ولم تكونا سعيدتين؟

135
00:08:21,450 --> 00:08:23,220
...مهلاً، ليس

136
00:08:23,220 --> 00:08:25,310
...انتظري. ما هنالك هو

137
00:08:26,250 --> 00:08:29,650
ماذا أفعل؟

138
00:08:30,100 --> 00:08:32,400
.كـ-كنّا نمزح، نمزح فحسب

139
00:08:32,400 --> 00:08:34,110
.نحن متوافقتان تمامًا

140
00:08:34,110 --> 00:08:36,020
فـ-فعلاً؟

141
00:08:36,020 --> 00:08:37,240
.فعلاً، فعلاً

142
00:08:38,050 --> 00:08:40,700
.أنا سعيدة لأنّكما كنتما تمزحان

143
00:08:46,600 --> 00:08:47,650
.أرو

144
00:08:47,650 --> 00:08:49,500
ما-ماذا؟

145
00:08:50,600 --> 00:08:51,420
.إليك واحدة

146
00:08:52,240 --> 00:08:53,450
...ناكو

147
00:08:53,970 --> 00:08:56,090
!مهلاً. كانت لديك واحدة لي من البداية إذًا

148
00:08:57,040 --> 00:09:01,110
لم أكذب عندما قلت أنّني أحضرت
.ما يكفي لاثنتين، فتلك عادتي

149
00:09:01,630 --> 00:09:03,100
.لذلك خذي خاصّتي

150
00:09:03,390 --> 00:09:04,880
فـ-فعلاً؟

151
00:09:07,320 --> 00:09:08,560
...شكرًا

152
00:09:08,800 --> 00:09:11,250
.آسفة لأنّني نعتّك بالجانحة المزيّفة

153
00:09:11,250 --> 00:09:13,010
.لا بأس. لا مانع لديّ

154
00:09:14,460 --> 00:09:16,490
.إنّكما تجيدان المزاح

155
00:09:16,970 --> 00:09:18,970
.هذا لأنّنا لم نكن نمزح للتّوّ

156
00:09:20,930 --> 00:09:23,000
.هيّا. تأخّر الوقت

157
00:09:26,180 --> 00:09:31,300
.لا أهتمّ كم تأخّر الوقت إن كنتُ برفقتكما

158
00:09:32,270 --> 00:09:34,760
تعرفين أنّ ذلك ليس مقبولاً، صحيح؟

159
00:09:34,760 --> 00:09:38,820
لماذا لا نذهب لمنزل بوتشي
في المرّة القادمة إذًا؟

160
00:09:39,540 --> 00:09:40,890
.هذه ليست فكرة سيّئة

161
00:09:42,090 --> 00:09:44,600
ناكو-تشان وهونشو-سان في منزلي؟

162
00:09:44,780 --> 00:09:47,760
.بإمكانك استعمال اسمي الشّخصيّ أيضًا

163
00:09:51,720 --> 00:09:52,670
.بوتشي

164
00:09:53,260 --> 00:09:54,110
.دورك

165
00:09:54,790 --> 00:09:58,780
...أ-أ-أ-أرو-تشان

166
00:09:59,420 --> 00:10:00,160
!أرو-تشان

167
00:10:00,570 --> 00:10:01,330
!أجل

168
00:10:09,480 --> 00:10:12,040
!أنت مؤسِفة بالفعل

169
00:10:12,040 --> 00:10:14,000
!لديّ اسم

170
00:10:14,670 --> 00:10:17,190
!ستأتيان كلتاهما لمنزلي

171
00:10:24,010 --> 00:10:25,720
.لن تأتيا

172
00:10:26,220 --> 00:10:28,760
،تجاوزنا الوقت الّذي اتّفقنا فيه على اللّقاء

173
00:10:28,760 --> 00:10:30,600
.لكنّهما لم تتّصلا بي من الأساس

174
00:10:31,080 --> 00:10:35,220
.كاي-تشان، لم يعد لي صديقات ثانية

175
00:10:42,260 --> 00:10:44,310
!آ-آسفة على التّأخير

176
00:10:44,310 --> 00:10:45,340
.لا بأس

177
00:10:45,340 --> 00:10:48,370
!مهلاً. ما ذلك الزّيّ؟

178
00:10:49,160 --> 00:10:50,810
،لم تعطيانني أيّة تعليمات

179
00:10:50,810 --> 00:10:53,260
.لذلك لم أعرف ما العمل إن لم تأتيا

180
00:10:53,260 --> 00:10:56,340
بالكاد مرّت دقيقة على موعد لقائنا
الّذي اتّفقنا عليه، صحيح؟

181
00:10:56,690 --> 00:11:00,090
هل هذه ملابسك العاديّة؟
أم هي مجرّد ملابس مريحة لك؟

182
00:11:00,390 --> 00:11:01,790
.تفضّلي. تفضّلي

183
00:11:01,790 --> 00:11:03,650
.من الأفضل أن نتحدّث في الدّاخل

184
00:11:03,650 --> 00:11:05,970
.هذه الغبيّة لا تصغي

185
00:11:06,660 --> 00:11:08,060
.ما باليد حيلة

186
00:11:08,540 --> 00:11:10,060
.أستأذن

187
00:11:13,860 --> 00:11:15,820
!مرحبًا بكنّ في منزلي

188
00:11:16,210 --> 00:11:18,820
هل تسمعينني؟

189
00:11:19,370 --> 00:11:20,640
هل عرفتِ المنزل بسرعة؟

190
00:11:21,100 --> 00:11:24,870
نعم، سبق ومررت من هنا من قبل
في طريقنا للمنزل من المدرسة، أتذكرين؟

191
00:11:25,350 --> 00:11:29,370
دعك من ذلك يا بوتشي، ألا تلاحظين
أيّ شيء مختلف فيّ اليوم؟

192
00:11:29,860 --> 00:11:31,990
.غرفتي في الطّابق العلويّ

193
00:11:31,990 --> 00:11:33,580
!إنّها لا تُصغي ثانية

194
00:11:33,960 --> 00:11:35,520
.ذلك لا يهمّ

195
00:11:35,520 --> 00:11:37,200
سنصعد للطّابق العلويّ فحسب؟

196
00:11:37,910 --> 00:11:39,830
!لقد نسيت

197
00:11:39,830 --> 00:11:41,050
!لننزل! لننزل

198
00:11:43,570 --> 00:11:45,390
!مرحبًا بك في منزلي

199
00:11:46,970 --> 00:11:48,350
!تفضّلي بالدّخول

200
00:11:49,330 --> 00:11:53,020
—هنالك درج هنا، لذلك احذري من أن

201
00:11:53,820 --> 00:11:55,600
ماذا؟ أين هي أرو-تشان؟

202
00:11:55,600 --> 00:11:56,980
!لاحظتِ ذلك للتّوّ؟

203
00:11:56,980 --> 00:11:58,360
...وأيضًا يا ناكو-تشان

204
00:11:58,640 --> 00:12:00,290
.أنت ترتدين نظّارات

205
00:12:00,290 --> 00:12:01,780
.أنت بطيئة الاستيعاب

206
00:12:01,780 --> 00:12:03,430
هل نظرك سيّئ؟

207
00:12:04,140 --> 00:12:05,680
.إنّها نظّارات مزيّفة

208
00:12:05,680 --> 00:12:06,830
.كنت أحاول تحسين مظهري

209
00:12:07,380 --> 00:12:09,870
