1
00:00:33,270 --> 00:00:34,390
.ها أنا ذاهبة

2
00:00:41,440 --> 00:00:43,910
.انظرن! إنّها سوتوكا-سان من الفصل 1

3
00:00:43,910 --> 00:00:46,350
.يمكن الإحساس بتألّقها حتّى من الخلف

4
00:00:49,840 --> 00:00:52,530
أتردن هذه؟

5
00:02:27,680 --> 00:02:29,300
،صنعتُ الكثير منها

6
00:02:29,300 --> 00:02:31,070
.لذلك سيأخذ الجميع منها

7
00:02:31,070 --> 00:02:32,510
!شكرًا لك

8
00:02:32,510 --> 00:02:33,880
.هذه سوتوكا-سان

9
00:02:34,180 --> 00:02:36,560
ماذا؟ إنّها توزّع الأوريغامي؟

10
00:02:36,560 --> 00:02:37,720
!كم هذا ظريف

11
00:02:37,720 --> 00:02:40,180
!مذهل! ظريف جدًّا

12
00:02:41,190 --> 00:02:43,170
.هنالك الكثير منهنّ

13
00:02:43,170 --> 00:02:45,100
.إنّها محبوبة جدًّا

14
00:02:45,340 --> 00:02:47,900
!الشّوريكن محبوبة جدًّا

15
00:02:55,230 --> 00:02:56,590
.صباح الخير يا سوتوكا

16
00:02:57,030 --> 00:02:58,330
تصنعين الشّوريكن ثانية؟

17
00:02:58,330 --> 00:02:59,340
.صباح الخير

18
00:02:59,750 --> 00:03:01,410
هل تريدين واحدة أيضًا يا ناكو؟

19
00:03:04,220 --> 00:03:05,700
.حسنًا، أظنّني سآخذ واحدة

20
00:03:07,020 --> 00:03:08,700
ما بيدك حيلة، صحيح؟

21
00:03:09,200 --> 00:03:10,920
.عرفتُ أنّ الشّوريكن ستكون محبوبة

22
00:03:11,390 --> 00:03:13,950
ما الّذي تقصدينه بأنّه عرفت ذلك؟

23
00:03:13,950 --> 00:03:15,590
—إنّ معلّمتي

24
00:03:45,440 --> 00:03:46,270
!ماذا؟

25
00:03:55,820 --> 00:03:56,570
—صـ

26
00:03:57,530 --> 00:03:59,950
—صديـ

27
00:04:00,410 --> 00:04:01,540
...صـ

28
00:04:01,540 --> 00:04:02,470
—ديـ

29
00:04:03,600 --> 00:04:04,530
معلّمتي؟

30
00:04:05,280 --> 00:04:07,880
رُفضتِ في بداية الدّورة الثّانية،صحيح؟

31
00:04:07,880 --> 00:04:09,310
ماذا حدث لها؟

32
00:04:09,690 --> 00:04:13,770
لا بدّ أنّها بدأت بتكوين صداقات ثانية
.بما أنّ الدّورة الثّانية قد بدأت

33
00:04:14,010 --> 00:04:15,350
...صداقات

34
00:04:16,380 --> 00:04:17,770
.يا بوتشي

35
00:04:19,210 --> 00:04:21,480
.أصبحت جبهتك حمراء جدًّا

36
00:04:21,480 --> 00:04:23,200
!...لكن

37
00:04:23,550 --> 00:04:28,280
إنّ أملتِ أن يصبح الجميع أصدقاء لك
،بسرعة لهي عقبة كبيرة

38
00:04:28,280 --> 00:04:29,910
لهذا أعتقد أنّ الأمور لا تسري
.على ما يرام بالنّسبة لك

39
00:04:31,050 --> 00:04:32,150
عقبة كبيرة؟

40
00:04:32,740 --> 00:04:36,110
.حاولي تخطّي عقبات صغيرة أوّلاً

41
00:04:36,580 --> 00:04:38,060
...عقبات صغيرة

42
00:04:39,520 --> 00:04:40,650
.سأنضمّ لنادٍ

43
00:04:40,650 --> 00:04:41,850
.نادي سباق القفز على الحواجز

44
00:04:41,850 --> 00:04:43,590
!لا أقصد عقبات فعليّة

45
00:04:44,130 --> 00:04:48,820
لكن يا معلّمتي، لماذا تحاولين
تكوين صداقة مع كوراي-سان؟

46
00:04:49,490 --> 00:04:50,060
.حسنًا

47
00:04:50,300 --> 00:04:55,140
بصراحة، أعارتني كوراي-سان شريطها
.في الدّورة الأولى

48
00:04:55,600 --> 00:04:58,000
.لا خيار آخر، سأعيرك هذا إذًا

49
00:04:58,760 --> 00:05:03,280
فكّرت في إعادته لها خلال عطلة
.الصّيف، لكنّني لم أستطع

50
00:05:03,740 --> 00:05:09,180
إذًا فليكن هدفك لهذا اليوم هو الحديث
.مع كوراي-سان فحسب

51
00:05:09,180 --> 00:05:10,100
الحديث معها؟

52
00:05:10,580 --> 00:05:13,000
يمكنك  بذل كلّ جهدك لتحقيق
ذلك الهدف، صحيح؟

53
00:05:13,230 --> 00:05:16,650
هل تعتقدين أنّ كوراي-سان قد تنضمّ
لنادي سباق القفز على الحواجز؟

54
00:05:17,100 --> 00:05:18,460
.أعتقد أنّ ذلك مستحيل

55
00:05:23,760 --> 00:05:24,790
هل أنت ذاهبة؟

56
00:05:26,420 --> 00:05:28,630
.تحدّثي معها أوّلاً فحسب

57
00:05:28,630 --> 00:05:30,670
ليس عليك حتّى النّظر إلى عينها
.في أسوأ الحالات

58
00:05:30,670 --> 00:05:33,140
تحدّثي معها فقط حتّى إن لم
.تنظري إليها مباشرة

59
00:05:34,010 --> 00:05:36,890
!يا معلّمتي! أعلم أنّك قادرة على ذلك

60
00:05:37,510 --> 00:05:38,310
.نعم

61
00:05:45,890 --> 00:05:46,810
.لا أستطيع

62
00:05:46,810 --> 00:05:49,280
.سيجعل هذا ساقي تتشنّج

63
00:05:49,280 --> 00:05:50,200
!تمارين شدّ

64
00:05:53,290 --> 00:05:54,350
!الشّجاعة

65
00:05:54,350 --> 00:05:55,990
!اعثري على شجاعتك

66
00:05:55,990 --> 00:05:58,230
!أظهريها! وتحدّثي

67
00:05:58,230 --> 00:05:59,580
!الـ-العفو

68
00:06:01,480 --> 00:06:03,300
.نجحت

69
00:06:06,690 --> 00:06:07,970
.هيتوري-سان

70
00:06:09,070 --> 00:06:10,880
!هل تسخرين منّي؟

71
00:06:12,700 --> 00:06:14,980
...أ-أنا

72
00:06:17,090 --> 00:06:18,940
!انتظري، مهلاً لحظة

73
00:06:23,840 --> 00:06:24,610
!انتظري

74
00:06:26,000 --> 00:06:27,070
.صحيح

75
00:06:32,600 --> 00:06:33,750
.انتظري

76
00:06:33,750 --> 00:06:35,740
!كيف يمكنك الرّكض هكذا؟

77
00:06:36,320 --> 00:06:39,120
.إنّها تقفز فوق العقبات

78
00:06:39,120 --> 00:06:41,860
!هذا مذهل، يا لها من فنون نينجا رائعة

79
00:06:44,620 --> 00:06:45,920
.لقد حاصرتك الآن

80
00:06:48,740 --> 00:06:53,090
حسنًا يا هيتوري-سان، اشرحي لي
.ما الّذي تعتقدين نفسك فاعلة

81
00:06:56,670 --> 00:06:57,640
شريط؟

82
00:06:58,080 --> 00:07:01,080
هل كنت تحاولين إعادته لي؟

83
00:07:03,880 --> 00:07:06,820
.في تلك الحالة، كان عليك قول ذلك باكرًا

84
00:07:07,420 --> 00:07:12,190
ظنّي بك حسن دائمًا بما أنّك تحافظين
.على هندامك بشكل دائم

85
00:07:13,930 --> 00:07:14,950
دائمًا؟

86
00:07:15,510 --> 00:07:18,790
.لذلك خاب ظنّي عندما لم أرك ترتدين شريطًا

87
00:07:19,440 --> 00:07:21,080
.إنّها تعير انتباهًا لي

88
00:07:21,080 --> 00:07:22,870
...دائمًا ما كانت

89
00:07:23,780 --> 00:07:26,300
.شـ-شكرًا جزيلاً لك

90
00:07:26,300 --> 00:07:27,710
.أنا لا أثني عليك

91
00:07:30,170 --> 00:07:31,320
!إنّهما تتحدّثان

92
00:07:31,320 --> 00:07:32,910
!إنّهما تتحدّثان معًا

93
00:07:32,910 --> 00:07:33,640
!صه

94
00:07:33,940 --> 00:07:36,150
.قوليها بشكل صائب

95
00:07:36,150 --> 00:07:40,360
قولي لها أنّك خلعت شريطك
.لتتمكّني من الحديث معها

96
00:07:42,430 --> 00:07:43,400
.لا أستطيع

97
00:07:44,580 --> 00:07:49,400
بالتّفكير في الأمر، كان هنالك دائمًا شخص آخر عندما
.جرّبت الحديث مع أرو-تشان أو سوتوكا-سان

98
00:07:49,400 --> 00:07:51,230
.لذلك السّبب تمكّنت من بذل كلّ جهدي

99
00:07:51,230 --> 00:07:53,950
.وعندما أكون وحدي، يغلبني البكاء

100
00:07:54,950 --> 00:07:56,920
ماذا؟ مهلاً، هل أنت بخير؟

101
00:07:58,480 --> 00:07:59,450
ناكو؟

102
00:08:01,090 --> 00:08:04,080
.اهدئي

103
00:08:06,480 --> 00:08:07,380
!إنّها لا تراني

104
00:08:08,500 --> 00:08:10,510
ماذا تفعلين يا سوناو-سان؟

105
00:08:11,940 --> 00:08:13,410
.اهدئي يا بوتشي

106
00:08:13,410 --> 00:08:14,390
.لا بأس

107
00:08:14,910 --> 00:08:15,680
.ناكو-تشان

108
00:08:16,000 --> 00:08:17,200
!معلّمتي

109
00:08:17,200 --> 00:08:18,460
سوتوكا-سان أيضًا؟

110
00:08:18,890 --> 00:08:20,810
قفزت فوق الكثير من العقبات، صحيح؟

111
00:08:20,810 --> 00:08:23,310
!هذا صحيح! أسلوب النّينجا الأقوى

112
00:08:24,030 --> 00:08:24,770
.نعم

113
00:08:25,540 --> 00:08:26,390
...المعذرة

114
00:08:27,360 --> 00:08:31,130
.في ذلك اليوم، خلعت شريطي عن قصد

115
00:08:32,940 --> 00:08:37,610
ظننتُ أنّك قد تلاحظين الأمر
.إن خلعتُ شريطي

116
00:08:37,610 --> 00:08:39,240
لماذا قد تفعلين ذلك؟

117
00:08:39,600 --> 00:08:42,200
!لأنّني كنت أريد التّحدّث معك

118
00:08:47,360 --> 00:08:52,300
لـ-لذلك هلاّ تحدّثتِ معي أيضًا
من الآن فصاعدًا؟

119
00:08:54,060 --> 00:08:55,890
...إن كان الأمر كذلك

120
00:08:55,890 --> 00:08:58,050
.فلا أمانع الحديث معك

121
00:08:59,130 --> 00:09:00,080
فعلاً؟

122
00:09:00,510 --> 00:09:02,560
هل ذلك كلّ ما أردتِ قوله؟

123
00:09:02,560 --> 00:09:03,620
...إذًا

124
00:09:03,620 --> 00:09:05,940
هـ-هلاّ انضممت لنادي سباق الحواجز أيضًا؟

125
00:09:06,480 --> 00:09:07,730
سباق الحواجز؟

126
00:09:07,730 --> 00:09:09,150
.انسي ذلك

127
00:09:10,100 --> 00:09:12,400
دعيني أخبرك بأمر، موافقة؟

128
00:09:13,720 --> 00:09:17,070
لديّ سياسة لا تخوّلني أن أكوّن
.أيّة صداقات لعدّة أسباب

129
00:09:17,830 --> 00:09:19,530
لا تنسي ذلك فحسب، موافقة؟

130
00:09:24,730 --> 00:09:26,210
.يا لها من سياسة غريبة

131
00:09:37,880 --> 00:09:40,010
سياسة ضدّ تكوين الصّداقات؟

132
00:09:40,230 --> 00:09:41,000
.نعم

133
00:09:42,220 --> 00:09:45,790
...حسنًا، كوراي-سان وحيدة دائمًا، لكن

134
00:09:45,790 --> 00:09:46,640
صحيح؟

135
00:09:46,640 --> 00:09:51,100
.لذلك فهي لم تقل أنّها تكرهك أو ما شابه

136
00:09:51,100 --> 00:09:53,690
حتّى أنّها قالت سوف تتحدّث معك، صحيح؟

137
00:09:53,690 --> 00:09:55,530
.لكنّها لن تصبح  صديقتي

138
00:09:55,920 --> 00:10:00,870
حسنًا، لا يمكننا الجزم بذلك إلى
،أن نسألها لماذا قالت شيئًا كذلك

139
00:10:00,870 --> 00:10:02,460
.لكن أعتقد أنّ فرصك وافرة

140
00:10:03,730 --> 00:10:08,330
لأنّ كون المرء وحده بلا أيّ أصدقاء
.يبعث على الشّعور بالوحدة

141
00:10:10,340 --> 00:10:11,540
أتظنّين ذلك؟

142
00:10:11,990 --> 00:10:15,520
حاليًّا، لماذا لا تصادقين شخصًا آخر أوّلاً؟

143
00:10:15,520 --> 00:10:16,540
...لكن

144
00:10:16,540 --> 00:10:18,100
.لا بأس بذلك

145
00:10:19,030 --> 00:10:22,990
،أردت أن تصبحي صديقة لكوراي-سان
صحيح يا معلّمتي؟

146
00:10:22,990 --> 00:10:23,670
.نعم

147
00:10:24,310 --> 00:10:25,970
لم تريدي مصادقة أيٍّ كان فقط
.ليكون لديك صديقة جديدة

148
00:10:25,970 --> 00:10:28,600
بل أردت أن تصبحي صديقة
لكوراي-سان، صحيح؟

149
00:10:29,220 --> 00:10:31,800
.واثقة أنّ مشاعرك تلك ستصلها

150
00:10:32,210 --> 00:10:33,230
...سوتوكا-سان

151
00:10:38,540 --> 00:10:40,490
.شكرًا لكنّ جميعًا لمرافقتي للمنزل

152
00:10:40,490 --> 00:10:42,580
.لا ضير من إطالة الطّريق من وقت لآخر

153
00:10:42,580 --> 00:10:44,460
.حسنًا، ابتهجي قليلاً

154
00:10:44,460 --> 00:10:46,080
.حسنًا. إلى اللّقاء

155
00:10:46,890 --> 00:10:52,970
ومع ذلك، يمكن أن تحدث أمور عدّة عندما
.يحاول المرء مصادقة كلّ من في الفصل

156
00:10:52,970 --> 00:10:56,090
.ليت كان الجميع متفهّمًا بسهولة مثلك أنت

157
00:10:56,090 --> 00:10:57,840
.لا تتحدّثي وكأنّك تفهمينني

158
00:11:00,360 --> 00:11:02,510
.أتساءل متى ستلاحظ ذلك

159
00:11:02,880 --> 00:11:04,320
بالمناسبة، هل سألتها؟

160
00:11:05,130 --> 00:11:08,600
كنتِ ستسألين بوتشي إن كان بإمكانك
أن تصبحي صديقتها وتلميذتها، صحيح؟

161
00:11:09,780 --> 00:11:10,570
.لا

162
00:11:11,050 --> 00:11:12,440
لم تسأليها بعد؟

163
00:11:12,440 --> 00:11:14,820
.لأنّني أعتقد أنّها قد تغضب منّي

164
00:11:15,510 --> 00:11:18,280
.لن يحدث ذلك في حالة بوتشي

165
00:11:18,520 --> 00:11:19,760
...إضافة لذلك

166
00:11:19,760 --> 00:11:21,980
إن فعلتُ ذلك، هل سأكون تلميذتها؟

167
00:11:22,430 --> 00:11:24,450
أم صديقتها؟

168
00:11:33,870 --> 00:11:38,460
غادرتُ باكرًا لأنّني أخذت الكثير
.من الوقت البارحة وكدت أتأخّر

169
00:11:39,500 --> 00:11:42,470
،لكن لم يكن هنالك أيّ جيران اليوم

170
00:11:42,800 --> 00:11:44,680
،وعبرت الشّارع مباشرة

171
00:11:48,080 --> 00:11:50,140
.لذلك وصلتُ إلى هنا باكرًا

172
00:11:52,550 --> 00:11:56,280
.ربّما لم يُفتح فصلنا بعد

173
00:11:56,280 --> 00:11:59,190
.المفتاح في قاعة المدرّسين

174
00:11:59,940 --> 00:12:02,640
.قاعة المدرّسين مخيفة جدًّا

175
00:12:02,640 --> 00:12:05,700
.أتمنّى أن يكون مفتوحًا

176
00:12:06,140 --> 00:12:07,050
...أتمنّى أن

177
00:12:08,210 --> 00:12:10,450
.هذا جيّد، إنّه مفتوح

178
00:12:11,250 --> 00:12:12,420
.كوراي-سان

179
00:12:14,900 --> 00:12:16,700
.ا-اختبأت

180
00:12:16,700 --> 00:12:18,000
ماذا أفعل؟

181
00:12:18,000 --> 00:12:20,110
،سيكون الأمر غريبًا إن غادرتُ فحسب

182
00:12:20,110 --> 00:12:24,300
لكنّها أخبرتي أنّ بإمكاننا الحديث
.معًا في ذلك اليوم

183
00:12:27,700 --> 00:12:28,720
!ماذا؟

184
00:12:29,560 --> 00:12:31,080
...مـ-مهلاً

185
00:12:31,810 --> 00:12:32,770
...عـ-عفوًا

186
00:12:34,260 --> 00:12:34,980
.صباح الخير

187
00:12:35,280 --> 00:12:36,780
—صـ-صباح

188
00:12:36,780 --> 00:12:37,450
!ظهرك مقوّس

189
00:12:37,450 --> 00:12:38,190
!الخير

190
00:12:38,560 --> 00:12:40,800
الوقوف بوضعيّة غير مستقيمة
.لهو تصرّف سيّئ

191
00:12:40,800 --> 00:12:42,610
.قفي باعتدال

192
00:12:42,610 --> 00:12:43,750
!حا-حاضرة

193
00:12:48,480 --> 00:12:50,590
ما-ما الّذي تفعلينه؟

194
00:12:51,040 --> 00:12:52,330
.أقوم بمسح الطّاولات

195
