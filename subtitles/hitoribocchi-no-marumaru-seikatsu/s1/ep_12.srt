203
00:11:50,240 --> 00:11:52,330
.نعم. كنتِ تبتسمين

204
00:11:53,620 --> 00:11:55,120
.لا أتذكّر وقوع ذلك

205
00:11:55,120 --> 00:11:56,770
.انسين ذلك رجاءً

206
00:11:59,910 --> 00:12:01,320
.المعذرة

207
00:12:01,880 --> 00:12:03,090
!لقد اكتملت

208
00:12:04,870 --> 00:12:06,230
!أنت من صنعها؟

209
00:12:06,230 --> 00:12:08,190
.يا فتيات، هذا يكفي

210
00:12:08,940 --> 00:12:10,670
.قد تصابون بالعدوى منّي

211
00:12:11,330 --> 00:12:12,000
...ولكن

212
00:12:12,420 --> 00:12:14,210
.أنا بخير الآن

213
00:12:15,710 --> 00:12:16,670
.بوتشي

214
00:12:18,210 --> 00:12:18,920
.حسنًا

215
00:12:20,550 --> 00:12:23,040
.اهتمّي بـ-بنفسك إذًا

216
00:12:26,830 --> 00:12:29,850
،حسنًا، أفهم أنّك قلقة

217
00:12:29,850 --> 00:12:31,950
.لكن يبدو أنّ الأمور مستقرّة الآن

218
00:12:31,950 --> 00:12:34,700
.صحيح. الممرّضة معها أيضًا

219
00:12:35,170 --> 00:12:37,860
هل تعتقدن أنّها ستكون قادرة
على حضور مراسم التّخرّج؟

220
00:12:38,480 --> 00:12:40,380
مراسم التّخرّج؟

221
00:12:40,380 --> 00:12:42,420
تقصدين لتلاميذ السّنة الثّالثة؟

222
00:12:42,420 --> 00:12:43,600
إنّها الأسبوع القادم، صحيح؟

223
00:12:43,600 --> 00:12:46,110
حسنًا، سيكون الأمر مختلفًا
،لو كان الحدث لنا نحن

224
00:12:46,110 --> 00:12:48,830
لكن ليس هنالك ما يسعنا فعله
.بما أنّنا تلميذات من السّنة الأولى

225
00:12:49,190 --> 00:12:55,620
لكنّ ذلك سيكون آخر يوم سيجتمع
.فيه كلّ تلاميذ الفصل معًا

226
00:13:03,100 --> 00:13:04,170
.بوتشي، سترانا

227
00:13:07,690 --> 00:13:08,850
!لقد عدت

228
00:13:12,040 --> 00:13:13,370
أأنت راضية الآن؟

229
00:13:13,370 --> 00:13:16,190
.أنا سعيدة لأنّها وصلت للمنزل

230
00:13:16,670 --> 00:13:18,820
.يبدو أنّها تشعر بتحسّن أكثر ممّا توقّعت

231
00:13:43,420 --> 00:13:45,340
.لم تلاحظنا

232
00:13:46,160 --> 00:13:47,550
!كما هو متوقّع من معلّمتي

233
00:13:48,330 --> 00:13:50,600
.بالطّبع لاحظت وجودنا

234
00:13:55,740 --> 00:13:57,770
.لـ-لقد أوقعتِ هذا

235
00:13:57,770 --> 00:13:59,490
.كلاّ، لم توقعه

236
00:13:59,490 --> 00:14:01,900
ذكرت هذا الصّباح أنّها ستعيرك فيلمًا، صحيح؟

237
00:14:01,900 --> 00:14:02,650
.صحيح

238
00:14:03,280 --> 00:14:05,610
.كاكو كاذبة

239
00:14:05,880 --> 00:14:09,200
ماذا؟ كوراي-سان كاذبة؟

240
00:14:09,200 --> 00:14:11,740
.نعم. قالت أنّها لم تتذكّر أيّ شيء

241
00:14:12,110 --> 00:14:15,000
!ر-ربّما تذكّرت للتّوّ

242
00:14:15,000 --> 00:14:17,250
!أنا لا أقصد أيّ شيء لئيم بذلك

243
00:14:18,490 --> 00:14:19,350
!حسنًا

244
00:14:20,360 --> 00:14:22,140
،لقد أخذتُ حمّامي

245
00:14:22,140 --> 00:14:25,210
يمكنني الآن مشاهدة الفيلم
.الّذي أعارتني إيّاه كوراي-سان

246
00:14:28,870 --> 00:14:29,580
...إنّه فارغ

247
00:14:37,180 --> 00:14:41,270
.وهكذا حلّ يوم مراسم التّخرّج

248
00:14:58,610 --> 00:15:02,700
.هنالك وسام لكلّ واحد منكم على طاولاتكم

249
00:15:02,700 --> 00:15:06,210
.امنحوها رجاءً لتلاميذ السّنة الثّالثة قبل المراسم

250
00:15:06,640 --> 00:15:10,680
،بمجرّد وضع الوسام عليهم
.هنّئوهم بتخرّجهم لو سمحتم

251
00:15:11,120 --> 00:15:14,890
حسنًا، بإمكانكم الحديث جميعًا
.إلى حين سماع الإعلان

252
00:15:15,650 --> 00:15:16,710
.كوراي-سان

253
00:15:17,810 --> 00:15:19,850
.قالت أنّ علينا أن نضعها عليهم

254
00:15:19,850 --> 00:15:21,980
...نـ-نعم، لكن

255
00:15:22,800 --> 00:15:25,130
ماذا إن طعنّاهم بها؟

256
00:15:25,130 --> 00:15:26,360
.قد تفعل ذلك

257
00:15:27,120 --> 00:15:28,860
أتريدين أن تجرّبي ذلك عليّ؟

258
00:15:29,400 --> 00:15:30,290
ألا تمانعين؟

259
00:15:30,290 --> 00:15:31,620
.نعم، تفضّلي

260
00:15:32,160 --> 00:15:33,370
.حسنًا

261
00:15:36,010 --> 00:15:38,220
.مهلاً، هذه مجرّد تجربة

262
00:15:38,220 --> 00:15:39,080
.لا تتوتّري كثيرًا

263
00:15:41,890 --> 00:15:43,370
.إنّها مجرّد تجربة

264
00:15:43,370 --> 00:15:45,380
.لا حاجة لترتعشي هكذا

265
00:15:48,970 --> 00:15:50,270
هل أنت بخير؟

266
00:15:50,270 --> 00:15:51,510
!هل أنت بخير؟

267
00:15:58,520 --> 00:16:00,700
.لقد وضعته

268
00:16:03,150 --> 00:16:07,190
مطلوب من تلاميذ السّنة الأولى والمتخرّجين
.الذّهاب إلى المواقع المشار إلها

269
00:16:07,840 --> 00:16:09,660
.حان وقت الذّهاب يا بوتشي

270
00:16:09,660 --> 00:16:10,610
!لنذهب

271
00:16:13,430 --> 00:16:17,800
.يبدو الأمر وكأنّك ستتخرّجين يا ناكو-تشان

272
00:16:19,780 --> 00:16:23,040
حسنًا. هل الجميع هنا؟

273
00:16:24,560 --> 00:16:28,750
.أتمنّى ألاّ أحصل على شخص مخيف

274
00:16:29,200 --> 00:16:34,840
حسنًا يا تلاميذ السّنة الأولى، ضعوا الآن
.الأوسمة على صدور المتخرّجين أمامكم

275
00:16:46,860 --> 00:16:49,830
!أ-أنا هيتوري بوتشي من الفصل 1-1

276
00:16:49,830 --> 00:16:51,850
!النّاتو هو طعامي المفضّل

277
00:16:51,850 --> 00:16:53,500
!أحبّ تناول النّاتو المسحوق أو المخمّر

278
00:16:53,500 --> 00:16:55,990
!لا تحتاجين لتلك التّحيّة! توقّفي

279
00:17:05,340 --> 00:17:07,100
.يا لها من شخص لطيف

280
00:17:07,100 --> 00:17:08,700
.أسرعي يا بوتشي

281
00:17:14,120 --> 00:17:15,760
!ما...؟ نـ-نعم

282
00:17:24,720 --> 00:17:26,440
.لقد أنهيتُ تثبيته

283
00:17:27,200 --> 00:17:30,070
!تـ-تـ-تهانيّ على مولودك

284
00:17:30,560 --> 00:17:31,730
!هل أنت حبلى؟

285
00:17:31,730 --> 00:17:33,460
!ناكاناي، أأنت حبلى؟

286
00:17:38,110 --> 00:17:40,540
.يستطيع المتخرّجون المغادرة

287
00:17:42,890 --> 00:17:46,760
...لقد تخرّجت ناكاناي-سينباي

288
00:17:46,760 --> 00:17:48,630
.تتعلّقين بالآخرين بسرعة كبيرة

289
00:17:51,900 --> 00:17:55,170
.أحسنتم في مراسم التّخرّج

290
00:17:55,170 --> 00:17:57,050
.هذا كلّ شيء لهذا اليوم

291
00:18:01,600 --> 00:18:02,790
.كوراي-سان

292
00:18:03,740 --> 00:18:04,930
.لقد أتت

293
00:18:05,330 --> 00:18:08,220
.سوف نودّع هذا الفصل اليوم

294
00:18:08,770 --> 00:18:11,510
ستكونون تلاميذًا في السّنة الثّانية
.عندما نلتقي ثانية

295
00:18:11,510 --> 00:18:13,150
.وسيكون لديكم زملاء أصغر منكم

296
00:18:13,150 --> 00:18:14,900
.إضافة إلى فصول استشاريّة مهنيّة

297
00:18:15,600 --> 00:18:17,370
،أمامكم طريق طويل

298
00:18:17,370 --> 00:18:22,240
لكنّني آمل أن تواصلوا كونكم
.هذا الفصل المتألّق كما أنتم الآن

299
00:18:22,240 --> 00:18:23,660
.أتطلّع قُدمًا للقائكم ثانية

300
00:18:24,910 --> 00:18:26,440
!تيرو-تشان

301
00:18:26,440 --> 00:18:28,890
!شكرًا يا تيرو-تشان

302
00:18:28,890 --> 00:18:30,250
.شكرًا لكم

303
00:18:30,710 --> 00:18:32,380
.حسنًا أيّها التّلميذ المسؤول

304
00:18:33,090 --> 00:18:33,880
.حاضرة

305
00:18:38,170 --> 00:18:38,840
.انحناء

306
00:18:39,300 --> 00:18:41,800
!شكرًا جزيلاً لك

307
00:18:43,590 --> 00:18:45,030
!يا معلّمتي

308
00:18:45,030 --> 00:18:47,370
!لنتدرّب في طريقنا للمنزل

309
00:18:47,370 --> 00:18:49,730
.سوتوكا-تشان، ناكو-تشان

310
00:18:50,560 --> 00:18:54,530
.أريد الذّهاب للمنزل اليوم مع كلّ صديقاتي

311
00:18:55,050 --> 00:18:56,690
.جميعنا معًا

312
00:19:00,290 --> 00:19:01,690
.اطلبي منهنّ ذلك إذًا

313
00:19:01,690 --> 00:19:02,700
.حسنًا

314
00:19:03,850 --> 00:19:04,860
.كوراي-سان

315
00:19:05,920 --> 00:19:09,250
...أ-أنا اليوم وكلّ صديقاتي سوف

316
00:19:09,660 --> 00:19:11,600
!لستُ صديقتك، مفهوم؟

317
00:19:13,760 --> 00:19:16,670
ولمعلوماتك فحسب، لم أعطك
.قرص الفيلم عن قصد

318
00:19:16,670 --> 00:19:19,040
كنتُ أرغب بإخبارك بذلك أنّني لم
،أكن أريد إعارته لك

319
00:19:19,040 --> 00:19:21,570
وليس أنّني نسيت وضعه
!في علبته بكلّ تأكيد

320
00:19:21,570 --> 00:19:22,890
!لذلك لا تسيئي الفهم

321
00:19:27,110 --> 00:19:30,560
حسنًا، من الجيّد أن يكون لديك
.منافس صعب واحد على الأقلّ

322
00:19:30,560 --> 00:19:31,970
منافس؟

323
00:19:31,970 --> 00:19:33,960
.كوراي-سان ليست عدوّتي

324
00:19:33,960 --> 00:19:35,320
.أعلم ذلك

325
00:19:37,600 --> 00:19:40,900
عليك العمل بجدّ أكبر عندما تصبحين
.تلميذة في السّنة الثّانية أيضًا يا بوتشي

326
00:19:47,990 --> 00:19:48,680
!نعم

327
00:19:55,500 --> 00:19:57,170
.هنالك الكثير منّا بالفعل

328
00:19:57,470 --> 00:20:00,360
!هذا وقت لحفلة فطائر مقليّة

329
00:20:00,360 --> 00:20:02,470
.تبدو فكرة جيّدة

330
00:20:02,960 --> 00:20:05,540
.أصبح لديّ ستّ صديقات الآن

331
00:20:06,100 --> 00:20:07,930
...ستّة في سنة واحدة

332
00:20:08,790 --> 00:20:11,350
،هنالك تسعة وعشرون تلميذًا في فصلنا

333
00:20:11,350 --> 00:20:13,990
إذًا كم صديقًا يجب أن يصبح لديها
في الدّورة الأولى من سنتنا الثّانية؟

334
00:20:14,770 --> 00:20:18,310
،حسنًا، على أيّ حال
.لا يجب عليها المواصلة بهذه الوتيرة

335
00:20:18,310 --> 00:20:19,060
...ولكن

336
00:20:20,120 --> 00:20:23,110
.هذا أشبه بحلم

337
00:20:23,560 --> 00:20:24,540
.صحيح

338
00:20:25,120 --> 00:20:28,480
.كلّ هذا بفضل لحاقك بي يا ناكو-تشان

339
00:20:32,900 --> 00:20:36,390
،في بداية دورتنا الأولى

340
00:20:36,390 --> 00:20:39,750
.كنتُ قد تخلّيتُ عن سعيي لأكون صديقتك

341
00:20:40,990 --> 00:20:44,860
.لكنّك لحقتِ بي في ذلك اليوم

342
00:20:45,430 --> 00:20:47,640
.وأصبحتِ صديقتي

343
00:20:48,220 --> 00:20:50,060
.رغم أنّك لا تحبّين الحركة

344
00:20:50,500 --> 00:20:52,810
.كفّي عن قول أنّني لا أحبّ الحركة

345
00:20:52,810 --> 00:20:53,780
.ناكو-تشان

346
00:20:53,780 --> 00:20:54,480
ماذا؟

347
00:20:55,360 --> 00:20:58,440
.شكرًا لأنّك أصبحتِ صديقتي

348
00:21:02,830 --> 00:21:05,470
ستقومين بدعوتي لتناول
الفطائر المقليّة إذًا، صحيح؟

349
00:21:12,700 --> 00:21:15,290
.لديّ صديقة مفضّلة

350
00:21:15,920 --> 00:21:17,320
،أنا خجولة

351
00:21:17,320 --> 00:21:20,080
،ولست جيّدة في التّقرّب من الآخرين

352
00:21:20,080 --> 00:21:25,920
وظننتُ أنّه من الأفضل ألاّ أمتلك أيّ
.أصدقاء على أن أواجه تلك الأمور المؤلمة

353
00:21:25,920 --> 00:21:28,140
...لكنّ صديقتي المفضّلة الوحيدة

354
00:21:31,670 --> 00:21:34,680
أخبرتني صديقتي المفضّلة ذات يوم

355
00:21:35,250 --> 00:21:37,650
.أنّه ليس عليّ البقاء كما أنا

356
00:21:38,000 --> 00:21:40,720
،لذلك قالت أنّه لا يجب أن نظلّ صديقتين

357
00:21:40,720 --> 00:21:43,860
إلاّ إن صادقت كلّ تلاميذ فصلي

358
00:21:43,860 --> 00:21:45,410
.قبل أن أتخرّج من المدرسة الإعداديّة

359
00:21:48,390 --> 00:21:50,850
،كان ذلك صعبًا

360
00:21:50,850 --> 00:21:52,240
.ظننتُ أنّ الأمر مستحيل

361
00:21:52,240 --> 00:21:56,310
،لم أعرف حتّى من أين أبدأ

362
00:21:58,640 --> 00:21:59,510
...لكن

363
00:22:06,880 --> 00:22:07,670
...لكن

364
00:22:10,320 --> 00:22:11,670
...ربّما

365
00:22:29,650 --> 00:22:31,560
!صباح الخير جميعًا

366
00:22:31,560 --> 00:22:33,160
!ستبدؤون اليوم سنتكم الثّانية

367
00:22:33,510 --> 00:22:36,310
.سأكون أنا مُدرّستكم الأساسيّة لهذه السّنة

368
00:22:36,310 --> 00:22:39,120
سأكون صارمة على عكس
!ما كنتُه في السّنة الأولى

369
00:22:39,740 --> 00:22:44,500
تيرو-تشان، كفّي عن محاولة الدّخول في بداية
!جديدة في السّنة الثّانية بينما أنت راشدة

370
00:22:46,210 --> 00:22:47,470
لا يمكنني ذلك؟

371
00:22:47,940 --> 00:22:49,030
...يا إلهي

372
00:22:49,030 --> 00:22:51,520
،حسنًا، لن يتغيّر أيّ شيء إذًا

373
00:22:51,520 --> 00:22:54,930
.لكن لنبدأ العمل ونقدّم أنفسنا

374
00:22:56,090 --> 00:22:59,890
لكن لن يكون الأمر ممتعًا
.إن بدأنا من البداية ثانية

375
00:23:00,390 --> 00:23:04,860
،بما أنّ اليوم هو الخامس من الشّهر
.فسنبدأ من الطّاولة الخامسة

376
00:23:05,310 --> 00:23:08,270
...الخامسة؟ أنا الرّابعة، أي

377
00:23:12,740 --> 00:23:13,980
.لا تقلقي

378
00:23:13,980 --> 00:23:15,420
!يمكنك أن تنجحي يا معلّمتي

379
00:23:17,390 --> 00:23:18,320
.حسنًا

380
00:23:18,320 --> 00:23:20,600
!حان الوقت لأظهر للجميع أنّني نضجت

381
00:23:20,600 --> 00:23:21,870
!وأنّني متألّقة

382
00:23:24,150 --> 00:23:29,330
—أ-أ-أ-أ-أنا