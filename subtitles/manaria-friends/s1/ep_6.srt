1
00:00:12,190 --> 00:00:15,480
.لن أتساهل معك فقط لأنّك زميلتي الأصغر

2
00:00:18,960 --> 00:00:21,150
.عندما ألعب، فأنا ألعب لأفوز

3
00:00:21,150 --> 00:00:23,000
!لن نخسر

4
00:00:28,270 --> 00:00:30,240
!حسنًا. لنبدأ

5
00:00:39,380 --> 00:00:41,350
يا غريا؟

6
00:00:41,640 --> 00:00:43,630
هل سنقوم بهذا بالفعل؟

7
00:00:44,350 --> 00:00:47,250
بالفعل بالفعل؟

8
00:01:05,840 --> 00:01:08,460
!يا له من منظر

9
00:01:10,190 --> 00:01:11,590
.إنّه جميل للغاية

10
00:01:14,620 --> 00:01:19,200
التّواجد في مكان جميل كهذا وحدي
!معك لهو أمر رومانسيّ للغاية

11
00:01:19,200 --> 00:01:21,790
عـ-عمّ تتحدّثين يا آن؟

12
00:01:22,240 --> 00:01:26,140
،بما أنّنا رأينا المناظر الجميلة الآن
.أعتقد أنّ الوقت قد حان للعودة

13
00:01:26,470 --> 00:01:27,430
.ليس بعد

14
00:01:29,070 --> 00:01:31,270
.وجهتنا الأخيرة ما زالت بعيدة قليلاً من هنا

15
00:01:34,210 --> 00:01:35,710
.هيّا، لنذهب

16
00:01:35,710 --> 00:01:37,110
...يا إلهي

17
00:01:51,870 --> 00:01:53,400
...انتظري فحسب

18
00:01:57,670 --> 00:01:59,390
يا غريا؟

19
00:01:59,810 --> 00:02:01,940
لنعد فحسب، موافقة؟

20
00:02:01,940 --> 00:02:03,890
.لقد سلكنا كلّ هذه المسافة سلفًا

21
00:02:04,390 --> 00:02:08,140
.بصراحة، أحبّ التّواجد وحدي معك

22
00:02:08,610 --> 00:02:11,110
...هذا جميل جدًّا، ولكن

23
00:02:12,750 --> 00:02:14,250
.نكاد نصل

24
00:02:16,050 --> 00:02:17,490
.هيّا، هيّا، هيّا

25
00:02:17,490 --> 00:02:18,950
.هيّا، هيّا

26
00:02:18,950 --> 00:02:21,240
.آن، تجعلين السّير صعبًا

27
00:02:21,240 --> 00:02:23,200
!هذا لأنّني أريد العودة

28
00:02:24,770 --> 00:02:27,160
أواثقة أنّك تريدين التّراجع؟

29
00:02:35,380 --> 00:02:37,260
لماذا تلمسيني هناك؟

30
00:02:37,260 --> 00:02:39,520
!أنا لا ألمسك على الإطلاق

31
00:02:41,120 --> 00:02:44,310
!يا إلهي، أنت من فكّر بهذا يا آن

32
00:02:47,740 --> 00:02:50,270
.حسنًا إذًا، لنقضِ اللّيلة معًا أيضًا

33
00:02:50,270 --> 00:02:51,530
.أكيد، أكيد

34
00:02:51,530 --> 00:02:53,600
.يُقال إنّ النّجوم جميلة جدًّا هنا في الخارج

35
00:02:53,600 --> 00:02:55,330
.لنحدّق بها معًا

36
00:02:55,330 --> 00:02:59,450
.أكيد، أكيد

37
00:02:56,460 --> 00:02:57,940
!بإمكاننا إشعال بعض الألعاب النّاريّة أيضًا

38
00:02:59,450 --> 00:03:01,370
.والمبيت معًا

39
00:03:01,370 --> 00:03:02,510
...أكيد، أكيـ

40
00:03:04,910 --> 00:03:07,290
!أحضرت منامتينا المتشابهتين

41
00:03:07,980 --> 00:03:09,410
!مستحيل، قطعًا لا

42
00:03:09,410 --> 00:03:11,460
!فات الأوان، حُدّد الأمر

43
00:03:15,220 --> 00:03:16,880
.سأسبقك

44
00:03:30,890 --> 00:03:32,070
...يا للجمال

45
00:03:33,980 --> 00:03:35,520
إنّها بقعة جميلة، أليس كذلك؟

46
00:03:47,420 --> 00:03:49,430
!مذهلة

47
00:03:56,350 --> 00:03:58,700
!أنت تعرفين كلّ الأماكن الجيّدة يا غريا

48
00:03:58,700 --> 00:04:01,050
.لن يزعجنا أحد هنا

49
00:04:12,860 --> 00:04:14,900
إذًا، هل أنت جاهزة للبدء؟

50
00:04:20,550 --> 00:04:22,010
ماذا تفعلين؟

51
00:04:22,010 --> 00:04:23,550
!أبني قلعة رمال

52
00:04:23,550 --> 00:04:25,550
أتريدين الانضمام لي يا غريا؟

53
00:04:30,970 --> 00:04:32,690
.آن، أسرعي واخلعي ملابسك

54
00:04:34,160 --> 00:04:35,600
.هيّا، تحرّكي

55
00:04:36,840 --> 00:04:38,200
...لكن

56
00:04:39,290 --> 00:04:41,150
!بدون لكن

57
00:04:41,150 --> 00:04:43,830
.حسنًا، اخلعيها من أجلي إذًا

58
00:04:43,830 --> 00:04:45,200
!هل أنت جادّة؟

59
00:05:02,240 --> 00:05:03,690
.لستِ سيّئة

60
00:05:03,990 --> 00:05:05,790
!لم ننتهِ بعد

61
00:05:12,920 --> 00:05:15,390
.حسنًا، لنبدأ بالفعل الآن

62
00:05:15,390 --> 00:05:16,920
نبدأ بماذا؟

63
00:05:17,640 --> 00:05:19,940
التّدريب. هذا ما أردته، صحيح؟

64
00:05:22,320 --> 00:05:25,090
أخبرتني أنّك ستُحرجين
.إن عرف أيّ أحد بالأمر

65
00:05:25,090 --> 00:05:26,930
.هذا هو سبب مجيئنا إلى هنا

66
00:05:30,860 --> 00:05:33,180
.هيّا، اخلعي ملابسك

67
00:05:36,770 --> 00:05:37,850
.اخلعيها

68
00:05:42,380 --> 00:05:43,780
...لا بأس

69
00:06:19,560 --> 00:06:20,650
ما رأيك؟

70
00:06:20,650 --> 00:06:23,370
.آن، لا يفترض بك استعمال السّحر

71
00:06:23,370 --> 00:06:27,900
لكن لماذا؟ لا يجدر بي أن أعاني لأسبح
!إن كان بإمكاني السّير على الماء فحسب

72
00:06:28,770 --> 00:06:29,660
.السّحر ممنوع

73
00:06:42,650 --> 00:06:48,950
!...ها نحن أولاء

74
00:07:02,260 --> 00:07:05,190
.لا بأس. أنا هنا من أجلك

75
00:07:05,540 --> 00:07:08,150
لكن لا تستطيع قدما حتّى
!لمس قاع البحر هنا

76
00:07:08,620 --> 00:07:09,780
.اهدئي فحسب

77
00:07:10,830 --> 00:07:12,870
.لنبدأ بجعلك تطفين فوق الماء

78
00:07:12,870 --> 00:07:14,140
!أطفو؟

79
00:07:14,140 --> 00:07:16,870
!لم يُخلق البشر لكي يطفون

80
00:07:16,870 --> 00:07:19,050
.لا بأس، جرّبي فحسب

81
00:07:19,780 --> 00:07:22,670
.موافقة يا آن؟ شهيق ببطء

82
00:07:24,320 --> 00:07:25,390
.ثمّ زفير

83
00:07:26,770 --> 00:07:28,120
.شهيق

84
00:07:29,440 --> 00:07:30,740
.زفير

85
00:07:36,310 --> 00:07:37,970
.عليك أن تسترخي أكثر

86
00:08:01,330 --> 00:08:02,570
.لا بأس

87
00:08:04,010 --> 00:08:07,040
.لا تتوتّري. دعي جسدي يسترخي فحسب

88
00:08:10,120 --> 00:08:11,620
.ليس عليك أن تقلقي

89
00:08:22,850 --> 00:08:25,370
.حسنًا، انظري للسّماء الآن

90
00:08:25,370 --> 00:08:27,230
.أرخي ذراعيك وساقيك

91
00:08:32,520 --> 00:08:34,050
.لا تدعي جسدك يتصلّب هكذا

92
00:08:35,050 --> 00:08:37,320
.أرخي ذراعيك وساقيك

93
00:08:37,820 --> 00:08:43,240
...استرخي... استرخي... استرخي

94
00:08:45,670 --> 00:08:47,070
.افتحي عينيك الآن

95
00:10:20,750 --> 00:10:24,190
.هذا هو شعور الطّفو على الماء إذًا

96
00:10:24,190 --> 00:10:25,030
.نعم

97
00:10:33,490 --> 00:10:35,880
.شكرًا لك يا غريا

98
00:11:36,470 --> 00:11:41,010
:"في الحلقة السّابعة من "صديقات ميستيريا
."الغمّيضة"

99
00:11:41,010 --> 00:11:46,010
رسم: إنارين

100
00:11:50,590 --> 00:11:54,010
هل يفترض بنا فعلاً حمل
هذه الألعاب النّارية في أيدينا؟

101
00:11:54,660 --> 00:11:56,860
.واضح أنّها من بلاد أخرى في الشّرق

102
00:11:56,860 --> 00:11:59,860
.طلبتها المديرة ميرا لنا خصّيصًا

103
00:12:00,270 --> 00:12:02,640
أليس هذا خطير؟

104
00:12:02,640 --> 00:12:04,570
.ماذا؟ لا بأس، لا تقلقي

105
00:12:04,900 --> 00:12:09,330
.كلما قلت ذلك يحدث شيء خطير بالفعل

106
00:12:10,740 --> 00:12:13,320
،يمكننا مشاهدة النّجوم الآن
لكنّك ما زلت ستطلقين الألعاب النّاريّة؟

107
00:12:13,790 --> 00:12:17,540
ألا يقومون بذلك في بلادك يا غريا؟

108
00:12:17,980 --> 00:12:19,810
،سمعتُ أنّه منذ غابر الأزمان

109
00:12:19,810 --> 00:12:22,720
كانت تُستعمل الألعاب النّاريّة بشكل
.أساسيّ في أوقات الاحتفالات

110
00:12:22,720 --> 00:12:24,550
!لا أطيق الانتظار حتّى أراها

111
00:12:24,550 --> 00:12:29,390
الألعاب النّاريّة ممتعة أكثر إذا صوّبتها
.على شخص من عند إطلاقها

112
00:12:32,300 --> 00:12:34,530
!حسنًا، لنبدأ

113
00:12:57,170 --> 00:12:59,940
لا تجرّبوا هذا

114
00:13:28,040 --> 00:13:30,370
ما الّذي تريدين فعله بعد هذا يا غريا؟

115
00:13:31,550 --> 00:13:33,370
.نفدت منّا الألعاب النّارية

116
00:13:33,850 --> 00:13:35,860
كانت ممتعة جدًّا، صحيح؟

117
00:13:36,140 --> 00:13:36,820
.نعم

118
00:13:37,170 --> 00:13:41,090
من المؤسف نوعًا ما
.أنّنا مضطرّون للعودة غدًا

119
00:13:41,570 --> 00:13:42,940
.أعتقد ذلك أيضًا

120
00:13:42,940 --> 00:13:46,680
لكنّنا تمكّنّا من القيام
.بكلّ ما أردنا القيام به

121
00:13:46,680 --> 00:13:48,650
!كلّ ما بقي هو المبيت معًا

122
00:13:50,040 --> 00:13:52,250
!لقد بذلت جهدًا كبيرًا اليوم بالفعل

123
00:13:53,290 --> 00:13:55,740
!تطلّب منّا الوصول إلى هنا الكثير من العمل

124
00:13:56,830 --> 00:13:59,440
لكنّ الآن هو الوقت المناسب
!لمنامتينا المتشابهتين أخيرًا

125
00:13:59,440 --> 00:14:00,560
!مهلاً لحظة

126
00:14:01,080 --> 00:14:04,030
!أنا متحمّسة للغاية للنّوم بقربك

127
00:14:04,730 --> 00:14:05,880
...مستحيل

128
00:14:06,530 --> 00:14:08,310
.لا يمكننا ذلك على الإطلاق

129
00:14:08,310 --> 00:14:09,200
...آن

130
00:14:09,200 --> 00:14:12,010
!شمس الصّباح بانتظارنا

131
00:14:12,010 --> 00:14:16,240
!لا أنفكّ عن إخبارك... مستحيل