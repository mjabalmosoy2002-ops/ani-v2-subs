1
00:00:12,430 --> 00:00:14,030
مرحباً يا أختي العزيزة

2
00:00:14,600 --> 00:00:16,170
كيف حالكِ؟

3
00:00:16,990 --> 00:00:20,920
اختُطِفتِ بواسطة الخادمة الّتي
اعتنيتِ بها... أيّتها المسكينة

4
00:00:22,680 --> 00:00:24,820
لماذا تفعلون شيئاً كهذا؟

5
00:00:25,250 --> 00:00:28,390
لإغضاب أخي العزيز بالطّبع

6
00:00:30,310 --> 00:00:33,560
حتّى اللّحظة، لم يُعِرني أخي أي انتباه

7
00:00:33,560 --> 00:00:37,090
لم ينظر إليّ إلّا عندما تفاعلتُ معكِ

8
00:00:37,560 --> 00:00:41,560
عندما يغضب أخي، فإنّ مشاعره تُصوَّب نحوي

9
00:00:42,000 --> 00:00:44,690
منحَني ذلك الإدراك إحساساً
بالسّلام في أعماق قلبي

10
00:00:47,430 --> 00:00:50,230
،تريد أن تكون أقرب إلى أخيك الأكبر
أليس كذلك سموّك؟

11
00:00:52,000 --> 00:00:52,730
ماذا؟

12
00:00:54,130 --> 00:00:55,380
هذا سخيف

13
00:00:55,860 --> 00:00:58,260
سأذهب لألعب مع أخي الأكبر الآن

14
00:00:58,990 --> 00:01:01,150
تصرّفي بسلوكٍ حسن

15
00:01:11,000 --> 00:01:12,050
!مولاتي ريشي

16
00:01:12,540 --> 00:01:13,550
هل أنتِ بخير؟

17
00:01:14,200 --> 00:01:15,890
لا تقلقي من فضلكِ

18
00:01:15,890 --> 00:01:19,460
مهما حدث، أعِدُكِ بأنّني سوف أحميكِ

19
00:01:19,460 --> 00:01:20,630
!أعِدُكِ

20
00:01:20,630 --> 00:01:22,980
مولاي ريشي، أقسم بأنّني سوف أساعدكِ

21
00:01:24,840 --> 00:01:29,060
أمرَكما الأمير تيودور بفعل شيء، أليس كذلك؟

22
00:01:30,350 --> 00:01:32,440
كيف عرفتِ؟

23
00:01:32,910 --> 00:01:36,800
الرّسالة الّتي تلقّيتُها من الأمير
...تيودور قبل أيّام

24
00:01:36,800 --> 00:01:37,950
كان أنتِ يا إلزي، أليس كذلك؟

25
00:01:39,710 --> 00:01:43,120
أنتِ الخادمة الوحيدة هنا
المُنحدِرة من الأحياء الفقيرة

26
00:01:43,610 --> 00:01:45,580
سيّد كاميل، أنت من هناك أيضاً

27
00:01:46,760 --> 00:01:52,400
ولسنواتٍ عديدة، كان الأمير تيودور
يدعم الأحياء الفقيرة بشكلٍ سرّي

28
00:01:54,970 --> 00:01:58,760
مولاتي ريشي، أُمِرنا بحبسكِ

29
00:01:58,760 --> 00:02:01,970
لكن طُلِبَ منّا الحرص على ألّا تتأذّي

30
00:02:02,240 --> 00:02:05,530
فهمت. يمكنكما إخباري بالتّفاصيل لاحقاً

31
00:02:06,240 --> 00:02:07,880
حاليّاً، ينبغي أن ننصرف

32
00:02:08,410 --> 00:02:09,850
أن ننصرف؟

33
00:02:10,110 --> 00:02:11,220
بالطّبع

34
00:02:11,220 --> 00:02:15,610
سأسلّم نفسي للسّجن، تماماً
كما أمر الأمير تيودور

35
00:02:15,610 --> 00:02:16,360
ماذا؟

36
00:02:32,620 --> 00:02:34,190
!هذا يُسعدني للغاية

37
00:02:34,190 --> 00:02:37,510
!لا أصدّق بأنّك قطعتَ كلّ هذه المسافة لرؤيتي

38
00:02:38,380 --> 00:02:42,120
كم سنة مضت منذ تكلّمنا هكذا يا أخي العزيز؟

39
00:02:42,120 --> 00:02:44,140
!لحظة، هذه هي المرّة الأولى

40
00:02:49,790 --> 00:02:53,400
حسناً، إذا كان لأجلها، ستفعل ما أمليه عليك

41
00:02:53,790 --> 00:02:55,770
ادخل صلبَ الموضوع

42
00:02:56,930 --> 00:02:59,070
...ما أريده هو

43
00:02:59,070 --> 00:03:01,110
أن أكون الخليفة التّالية للعرش

44
00:03:01,800 --> 00:03:03,960
،إذا أردت إعادة أختي الكبرى العزيزة إليك

45
00:03:03,960 --> 00:03:06,330
فأعلِن تخلّيك عن العرش

46
00:03:06,750 --> 00:03:10,200
إن لم تذعن لمطلبي، فلا أعلم
ما الّذي يمكن أن يصيبها

47
00:03:10,200 --> 00:03:12,790
لا تريد أن يحدث ذلك، صحيح؟

48
00:03:14,790 --> 00:03:18,250
،من تعابير وجهك تبدو غير قلِق
لكنّك قلِق، أليس كذلك؟

49
00:03:18,250 --> 00:03:20,410
أنت شديد القلق

50
00:03:20,410 --> 00:03:23,550
لأنّها مهمّةٌ جدّاً بالنّسبة لك، صحيح؟

51
00:03:23,870 --> 00:03:25,550
!أنت تعزُّها

52
00:03:25,550 --> 00:03:27,620
!تُظهِر اهتماماً وقلقاً عليها

53
00:03:27,620 --> 00:03:30,200
!تريد أن تُبقيها إلى جانبك

54
00:03:30,200 --> 00:03:33,280
!بخلافي أنا! لا تريد حتّى رؤية وجهي

55
00:03:34,790 --> 00:03:36,440
هذا واضح وضوح الشّمس

56
00:03:37,590 --> 00:03:38,480
...فأساساً

57
00:03:39,390 --> 00:03:43,270
كنتُ أراقبك طوال هذا الوقت

58
00:03:44,900 --> 00:03:47,430
هيّا يا أخي. قُلها

59
00:03:47,870 --> 00:03:49,450
"قُل "أنت الرّابح

60
00:03:49,870 --> 00:03:51,990
"قُل "هذه المرّة، هزمتني

61
00:03:53,300 --> 00:03:55,460
...إذا فعلتَ ذلك فحسب

62
00:03:56,630 --> 00:03:57,870
ستكتمل حياتي

63
00:04:01,270 --> 00:04:02,340
تيودور

64
00:04:03,290 --> 00:04:05,640
،قلتَ بأنّك حبستَها

65
00:04:05,640 --> 00:04:07,650
لكن هل زججتَ بها في سجن؟

66
00:04:09,190 --> 00:04:11,570
وضعتُها في غرفة تشبه السّجن

67
00:04:11,570 --> 00:04:13,290
والباب مُقفَل بالطّبع

68
00:04:13,790 --> 00:04:16,270
مُقفَل؟ ماذا أيضاً؟

69
00:04:16,270 --> 00:04:19,300
هناك بعض الأشخاص يحرسونها

70
00:04:19,300 --> 00:04:21,020
،الغرفة في طابقٍ علويّ

71
00:04:21,020 --> 00:04:23,080
لذا لن تتمكّن من الهرب عبر النّافذة

72
00:04:23,080 --> 00:04:25,680
فهمت. هناك نافذةٌ أيضاً إذاً

73
00:04:26,400 --> 00:04:28,320
ما الّذي ترمي إليه؟

74
00:04:28,320 --> 00:04:30,370
!لا يستطيع أحدٌ الهرب

75
00:04:30,680 --> 00:04:32,370
ليس في العادة، لا

76
00:04:32,870 --> 00:04:36,170
،دعني أحذّرك، بإشارة واحدة منّي فقط

77
00:04:36,170 --> 00:04:38,750
سيكون من السّهل عليّ أذيّة أختي العزيزة

78
00:04:39,150 --> 00:04:40,500
أخي الصّغير الأحمق

79
00:04:42,010 --> 00:04:44,490
لا مجال لك للفوز هنا

80
00:04:45,050 --> 00:04:48,590
ليس منذ اللّحظة الّتي ظننتَ فيها
بأنّك أسرتَ تلك الفتاة

81
00:04:48,590 --> 00:04:52,520
ماذا؟ أخي، أنت لا تتصرّف على طبيعتك

82
00:04:52,520 --> 00:04:54,640
—إذا كان لديك ما تقوله، فإذاً

83
00:04:54,170 --> 00:04:54,640
اسمع

84
00:04:55,080 --> 00:04:55,890
ها هي ذي

85
00:04:56,560 --> 00:04:58,100
—عمّاذا تتكلّم

86
00:05:06,390 --> 00:05:07,330
هذا لا يُصدَّق

87
00:05:09,920 --> 00:05:13,790
أتيتُ لحسم الأمور بيننا أيُّها الأمير تيودور

88
00:05:16,040 --> 00:05:17,720
هذا غير ممكن

89
00:05:18,520 --> 00:05:21,790
"سمعتُ بأنّكِ حُبِستُ في غرفة "تشبه السّجن

90
00:05:22,150 --> 00:05:23,900
هل غادرتِ عبر النّافذة؟

91
00:05:23,900 --> 00:05:26,420
أم أنّكِ لكمتِ الجِدار ودخلتِ من الفتحة؟

92
00:05:27,610 --> 00:05:29,800
!غادرتُ عبر الباب كأي شخص عاديّ

93
00:05:30,760 --> 00:05:34,370
عبر باب مُقفَل يراقبُه حُرّاس. هذا عاديّ؟

94
00:05:34,370 --> 00:05:37,580
كيف فعلتِها؟ هل خانَني أحدُهم؟

95
00:05:37,580 --> 00:05:38,970
الأمير تيودور

96
00:05:40,090 --> 00:05:42,270
أوجِّه إليك النّصيحة التّالية وبكلّ احترام

97
00:05:42,470 --> 00:05:43,780
نصيحة؟

98
00:05:45,500 --> 00:05:47,150
...قبل كلّ شيء

99
00:05:48,400 --> 00:05:49,910
...عندما تأسر شخصاً

100
00:05:49,910 --> 00:05:52,420
يجب أن تكون حريصاً على ألّا تشيح بنظرك عنه

101
00:05:53,640 --> 00:05:56,660
،حتّى لو حبسته في غرفة بمفرده

102
00:05:56,660 --> 00:05:59,250
لا يجوز إطلاقاً أن تتركه لوحده

103
00:05:59,250 --> 00:06:03,710
يجدر بك أن تترك على الأقلّ
حارسَين في الغرفة معه

104
00:06:07,360 --> 00:06:09,220
...وثانياً

105
00:06:09,810 --> 00:06:13,600
ينبغي أن يتمّ تفتيش السّجين بواسطة
أكثر من شخص واحد

106
00:06:13,930 --> 00:06:15,980
لا تسمح له بإبقاء ملابسه على جسده

107
00:06:15,980 --> 00:06:18,730
تفتيشه أثناء تعرّيه بشكلٍ كامل هو الأكثر فاعليّة

108
00:06:18,730 --> 00:06:22,320
بهذه الطّريقة، لن يتمكّن من إخفاء
أسلحة أو أدوات للهرب

109
00:06:24,670 --> 00:06:26,330
...وثالثاً

110
00:06:26,860 --> 00:06:29,800
،بعد أن تقيّد أيديه خلف ظهره

111
00:06:29,800 --> 00:06:33,110
أفضل شيء تفعله هو تقييده
،بعمود أو سرير

112
00:06:33,110 --> 00:06:35,050
لكن يبقى هذا تساهُلاً

113
00:06:35,640 --> 00:06:39,540
هل تعرف ما هو الشّيء الّذي
أن يجب أن تفعله قطعاً؟

114
00:06:41,890 --> 00:06:44,880
اكسر ذراعيه وساقيه معاً

115
00:06:46,260 --> 00:06:48,500
،قيّد أطرافه المكسورة

116
00:06:48,500 --> 00:06:51,300
خذ كلَّ ما لديه، ومُر مجموعة بحراسته

117
00:06:52,010 --> 00:06:56,430
هذا ما يعنيه أن تأسر شخصاً

118
00:07:01,020 --> 00:07:04,610
لماذا تعطين تعليمات للشّخص الّذي أسرَكِ؟

119
00:07:04,610 --> 00:07:07,340
!سموّك! أنا بخير تماماً

120
00:07:07,340 --> 00:07:09,470
لا عليكِ. ارتديه فحسب

121
00:07:09,470 --> 00:07:11,030
...لكن رقبتك سوف

122
00:07:12,110 --> 00:07:14,440
ما هذه النّدبة؟

123
00:07:15,130 --> 00:07:16,620
لا أعرف شيئاً عنها

124
00:07:20,220 --> 00:07:22,760
توقّعت. لستُ جيّداً بما يكفي في النّهاية

125
00:07:24,750 --> 00:07:26,290
الأمير تيودور

126
00:07:26,930 --> 00:07:30,490
أجبني أرجوك. ما هدفك من هذا؟

127
00:07:31,990 --> 00:07:34,410
أن أكون الخليفة التّالية للعرش

128
00:07:34,410 --> 00:07:38,640
لا سبب آخر يتشاجر عليه شخصان
مُرشّحان للخِلافة، صحيح؟

129
00:07:38,640 --> 00:07:41,060
لا أعتقد أنّ هذا صحيح

130
00:07:41,630 --> 00:07:43,140
بل أرى العكس تماماً

131
00:07:45,130 --> 00:07:51,280
هدفك هو التخلّي عن حقّك في الخِلافة، صحيح؟

132
00:07:52,250 --> 00:07:53,490
عمّاذا تتكلّمين؟

133
00:07:53,490 --> 00:07:57,480
لم أفهم سبب استهدافك لي

134
00:07:57,480 --> 00:08:00,930
!أخبرتُكِ! كي أجعل أخي يعاني

135
00:08:00,930 --> 00:08:05,130
إذا لم يستطع حماية خطيبته، حينئذ
ستنهار سمعته بشكلٍ كامل

136
00:08:05,130 --> 00:08:08,250
...تستخدم شخصاً تافهاً مثلي لسرقة العرش

137
00:08:08,250 --> 00:08:10,850
أنت لا تعتقد فعليّاً بأنّ ذلك سينجح، صحيح؟

138
00:08:12,000 --> 00:08:14,360
،بتنفيذِ عمليّة الاختطاف السّخيفة هذه

139
00:08:14,360 --> 00:08:18,550
أردتَ أن تُحدِث جلبة وتلطّخ
سمعتك كمُجرم، أليس كذلك؟

140
00:08:19,480 --> 00:08:20,460
مُخطئة

141
00:08:21,300 --> 00:08:23,530
كانت هناك فترة معيّنة علّقتَ فيها

142
00:08:23,530 --> 00:08:27,100
أعمالك العامّة في الأحياء الفقيرة، أليس كذلك؟

143
00:08:27,910 --> 00:08:30,360
تعِبتُ من تلك الأعمال الخيريّة التّافهة

144
00:08:30,360 --> 00:08:31,860
هذا كذِب

145
00:08:32,340 --> 00:08:36,660
حتّى الآونة الأخيرة، كنتَ تُرسِل
دعماً للأحياء الفقيرة، أليس كذلك؟

146
00:08:37,270 --> 00:08:39,660
،لا يوجد أي دليل على استخدام أموال العامّة

147
00:08:39,660 --> 00:08:42,020
لذا لا بدّ أنّك تنفق من مالك الخاصّ

148
00:08:43,900 --> 00:08:48,490
تقلق على النّاس في الأحياء الفقيرة
،أكثر من أي شخص آخر

149
00:08:48,490 --> 00:08:50,810
وقد تعاملتَ معهم بلطف وحنان

150
00:08:52,010 --> 00:08:55,090
لكنّك تعمّدتَ إهمال واجباتك العامّة

151
00:08:55,830 --> 00:08:59,080
أريد فقط هزيمة أخي، هذا كلُّ شيء

152
00:08:59,080 --> 00:09:03,160
لو كان كذلك، لهاجمتَ الأمير آرنولد مباشرة

153
00:09:03,160 --> 00:09:04,210
أنتِ مُخطِئة

154
00:09:04,210 --> 00:09:06,390
لكن لم تستطع فعل ذلك

155
00:09:06,390 --> 00:09:09,230
هذا لأنّ كلّ شيء تفعله هو
—لأجل أخيك الأكبر

156
00:09:09,230 --> 00:09:10,230
!مُخطِئة

157
00:09:10,230 --> 00:09:12,720
!مُخطِئة! مُخطِئة، مُخطِئة، مُخطِئة

158
00:09:12,720 --> 00:09:16,000
بئساً، ما هذا الهُراء الّذي تتفوّهين به؟

159
00:09:16,000 --> 00:09:20,970
!أريد أن يكرهني أخي! أن يمقتني
!أن ينبذني

160
00:09:20,970 --> 00:09:25,370
إذا لم يقبلني أبداً، فمقتلي بواسطته
!سيكون أفضل بكثير

161
00:09:25,370 --> 00:09:27,370
هذا يكفي. تتوقّف الأمور عند هذا الحدّ

162
00:09:27,630 --> 00:09:29,300
الأمير آرنولد

163
00:09:29,300 --> 00:09:30,990
أخبرتُكِ يا ريشي

164
00:09:30,990 --> 00:09:32,940
لا تتفاعلي معه

165
00:09:32,940 --> 00:09:35,970
انتظر من فضلك. المشاعر الحقيقيّة
—لأخيك الصّغير

166
00:09:35,970 --> 00:09:38,050
لا أبالي

167
00:09:39,170 --> 00:09:41,790
،بغضّ النّظر عن رغباته

168
00:09:41,790 --> 00:09:43,970
لا علاقة لها بي

169
00:09:45,720 --> 00:09:49,060
أعرف ذلك جيّداً سلفاً

170
00:09:52,130 --> 00:09:53,730
!الأمير تيودور

171
00:09:53,730 --> 00:09:54,890
دعيه

172
00:09:56,830 --> 00:10:01,240
لماذا تحاول ترك مسافة بينك وبين أخيك؟

173
00:10:01,460 --> 00:10:04,240
أخبرتُكِ. إنّه لا يهمّني

174
00:10:04,480 --> 00:10:06,800
،لو كان هذا شعورك فعلاً

175
00:10:06,800 --> 00:10:09,870
لما أمرتني بالابتعاد عنه، أليس كذلك؟

176
00:10:10,940 --> 00:10:13,630
قلتَ شيئاً قبل أيّام

177
00:10:13,630 --> 00:10:16,830
قلتَ، "العزيمة لتكوني زوجتي؟
"لا حاجة لذلك

178
00:10:17,640 --> 00:10:21,640
كنتُ أحاول طوال هذا الوقت
أن أفهم معنى كلماتك

179
00:10:22,770 --> 00:10:27,980
أنت تنظر للمستقبل الّذي ينبغي أن يكون لك

180
00:10:27,980 --> 00:10:30,670
بنيّة التخلُّص منه بالكامل، أليس كذلك؟

181
00:10:32,600 --> 00:10:36,270
هذا ما يخشاه أخوك الأصغر، أليس كذلك؟

182
00:10:36,730 --> 00:10:41,080
لهذا يتظاهر بكونه الأمير الثّاني
،الّذي لا يطمع بالعرش إطلاقاً

183
00:10:41,080 --> 00:10:44,280
بكونه شخصاً ينبغي أن يختفي
عن مُستقبل هذه الإمبراطوريّة

184
00:10:44,960 --> 00:10:49,760
لكن ألا يوجد طريق آخر لكما أنتما الأخوان؟

185
00:10:51,480 --> 00:10:53,940
من فضلك أخبرني ما الّذي تفكِّر فيه

186
00:11:06,150 --> 00:11:08,180
هكذا إذاً

187
00:11:12,840 --> 00:11:16,650
تحقّقتُ من ذلك أخيراً

188
00:11:22,040 --> 00:11:24,870
أنتِ ظريفةٌ للغاية

189
00:11:25,080 --> 00:11:26,290
...ما الّذي

190
00:11:26,290 --> 00:11:28,890
،لا تستطيعين فهم نواياي

191
00:11:28,890 --> 00:11:30,560
لذا تشعرين بحيرة، صحيح؟

192
00:11:31,250 --> 00:11:33,360
لكن من الأفضل ألّا تفهمي

193
00:11:34,620 --> 00:11:38,760
سأكرّر كلامي، اتركي تيودور وحده

194
00:11:44,600 --> 00:11:48,470
لا ينبغي أن يتورّط مع شخصٍ مثلي

195
00:11:51,700 --> 00:11:54,210
أنت مُتيّم بأخيك، أليس كذلك؟

196
00:11:54,690 --> 00:11:55,800
ماذا؟

197
00:11:55,800 --> 00:11:57,710
،لو لم يكن عزيزاً عليك

198
00:11:57,710 --> 00:12:00,150
لما قلتَ مثل هذا الكلام أبداً

199
00:12:00,390 --> 00:12:05,740
سموّك، هل سبقَ وفكّرت بمُستقبل
مُعاكِس للمُستقبل الّذي تختفي فيه؟

200
00:12:06,500 --> 00:12:07,820
مُعاكِس؟

201
00:12:08,490 --> 00:12:10,710
مُستقبل يختفي فيه أخوك

202
00:12:10,710 --> 00:12:13,250
قد يتواجد مُستقبلٌ كهذا

203
00:12:13,250 --> 00:12:17,030
من فضلك عِش حياتك بطريقة لا تتحسّر
فيها إذا ما حدثَ ذلك

204
00:12:18,150 --> 00:12:21,760
ولو حقّقتُ أمنيتي، سأفعل المثل

205
00:12:22,050 --> 00:12:25,380
...ذلك حتّى لو كانت هذه الحياة هي الأخيرة لي

206
00:12:28,710 --> 00:12:35,020
وأنوي عيش حياتي كزوجة لك بلا حسرات

207
00:12:43,090 --> 00:12:43,930
تبّاً

208
00:12:50,400 --> 00:12:52,710
هذه هي حدودي

209
00:12:53,490 --> 00:12:54,380
...لكن

210
00:13:02,030 --> 00:13:05,440
ما زلتُ أستطيع تذكُّر ما حدث في ساحة المعركة

211
00:13:06,010 --> 00:13:09,350
!تمالك نفسك! سيصل الدّواء قريباً

212
00:13:09,350 --> 00:13:11,750
شكراً لك

213
00:13:12,600 --> 00:13:13,770
!نتعرّض لهجوم

214
00:13:22,620 --> 00:13:25,690
لم يكن هناك أي شيء يستطيع شخصٌ
عديم الجدوى مثلي فعله

215
00:13:25,690 --> 00:13:27,580
...رغم علمي بذلك، لكن

216
00:13:38,290 --> 00:13:39,420
أخي؟

217
00:13:43,400 --> 00:13:46,200
،كعضو في العائلة الإمبراطوريّة
لا أستطيع الإطراء على تصرُّفاتك

218
00:13:47,620 --> 00:13:50,420
في المرّة المُقبِلة، لا تُعرِّض حياتك لخطر

219
00:13:51,720 --> 00:13:55,270
...لكن حقيقة تحرّكك لحماية خادمك

220
00:13:55,270 --> 00:13:57,130
هذا أمرٌ يستحقُّ الاعتزاز بالنّفس

221
00:13:59,010 --> 00:14:00,050
أحسنت صنعاً

222
00:14:08,260 --> 00:14:09,730
الأمير تيودور

223
00:14:11,980 --> 00:14:16,000
هل تنوين أن تلقي عليّ محاضرة أخرى
عن الهرب بعد محاضرتكِ عن السّجن؟

224
00:14:16,280 --> 00:14:18,750
لكن لم تكن تنوي الهرب، أليس كذلك؟

225
00:14:21,230 --> 00:14:25,510
أخي كما ترين لا يُظهِر إنجازاته
أمام العالم الخارجيّ

226
00:14:26,080 --> 00:14:30,260
من النّاحية الأخرى، تنتشر شهرتُه
إلى البلدان الأخرى بسرعة غير طبيعيّة

227
00:14:30,260 --> 00:14:31,640
لماذا ذلك برأيكِ؟

228
00:14:32,370 --> 00:14:36,770
الأمير آرنولد هو من يتعمّد نشرها، صحيح؟

229
00:14:37,170 --> 00:14:39,790
أعلم لأنّني كنتُ أراقبه طوال هذا الوقت

230
00:14:39,790 --> 00:14:44,250
أراه وأقول لنفسي، "يتصرّف بطريقة
"تجعله يختفي في أيّ لحظة

231
00:14:45,360 --> 00:14:49,130
...لكن أن يختفي شخصٌ رائع مثله

232
00:14:50,040 --> 00:14:51,600
هذا ليس عدلاً

233
00:14:54,170 --> 00:14:57,350
إذا كان ينوي أن يأتمنني
،على الإمبراطوريّة ويختفي

234
00:14:57,350 --> 00:14:59,290
فحينئذ سوف أختفي قبله فحسب

235
00:15:00,050 --> 00:15:03,920
إذا فعلتُ ذلك، فلن يتمكّن أخي
من الإقدام على أي حماقة بعدها

236
00:15:04,230 --> 00:15:09,530
إنّها الطّريقة الوحيدة الّتي يمكنني
من خلالها أن أكون مفيداً لأخي

237
00:15:11,960 --> 00:15:17,320
أنا متأكّدة بأنّ أخاك الأكبر ينوي
فعل شيء غير منطقيّ بالمرّة

238
00:15:18,160 --> 00:15:20,810
لهذا أخطِّط لفعل المستحيل كي أمنعه

239
00:15:21,360 --> 00:15:24,020
،إذا كان هناك أي أشخاص ذوي نفوذ وقوّة
سأعمل على دعوتهم أيضاً

240
00:15:24,020 --> 00:15:26,320
...ويا سموّ الأمير تيودور

241
00:15:26,660 --> 00:15:29,060
أحتاج قوّتك أيضاً

242
00:15:32,100 --> 00:15:35,200
شخص مثلي لن يشكِّل قوّةً بالنّسبة لكِ

243
00:15:35,200 --> 00:15:38,380
لا، هذا غير صحيح

244
00:15:38,380 --> 00:15:39,170
...فأساساً

245
00:15:39,910 --> 00:15:44,060
فأنت الأخ الصّغير الوحيد الّذي لديه
في هذا العالم كلّه، أليس كذلك؟

246
00:15:58,800 --> 00:16:02,720
أردتُ مساعدة أخي يوماً ما

247
00:16:04,610 --> 00:16:06,030
شكراً لكِ يا أختي

248
00:16:06,890 --> 00:16:11,310
أن تقولي لي بأنّكِ تحتاجينني لَهو
أمر غير مُتوقَّع، لكن هذا يُسعدني

249
00:16:12,280 --> 00:16:16,780
لكن سأقرّر كيف يمكن الاستفادة
منّي بأفضل طريقة

250
00:16:19,740 --> 00:16:23,290
كان ينبغي أن أفعل هذا منذ مدّة طويلة

251
00:16:24,030 --> 00:16:24,870
...أيُعقَل أنّه

252
00:16:25,090 --> 00:16:28,130
كلّ ما فعلتُه باء بالفشل، أليس كذلك؟

253
00:16:28,130 --> 00:16:29,340
!سموّك

254
00:16:59,760 --> 00:17:00,900
أخي؟

255
00:17:20,560 --> 00:17:23,390
ما الّذي كنتَ تفكِّر فيه؟

256
00:17:24,290 --> 00:17:25,190
...لكن

257
00:17:25,810 --> 00:17:31,870
لكن... هذه هي الطّريقة الوحيدة الّتي
يمكنني من خلالها أن أكون نافعاً لك

258
00:17:32,520 --> 00:17:37,170
لم أفعل شيئاً في حياتي يجعلني
أكون أخاً كبيراً بالنّسبة لك

259
00:17:37,170 --> 00:17:39,660
أي أحمق يخاطر بحياته لأجل شخص كهذا؟

260
00:17:44,630 --> 00:17:48,900
الخيار الّذي اختاره أخوك الصّغير
،قد لا يكون الخيار الصّائب

261
00:17:49,420 --> 00:17:55,860
لكن رغبته في أن يصبح قوّة
لأجلك ليست خاطئة، صحيح؟

262
00:17:57,550 --> 00:18:00,180
كما تقول تماماً

263
00:18:00,670 --> 00:18:02,900
سأتمنّى هذا مراراً وتكراراً

264
00:18:03,680 --> 00:18:05,910
!أريد أن أمثِّل قوّةً لك

265
00:18:05,910 --> 00:18:07,570
!أريد أن أكون مُفيداً لك

266
00:18:07,570 --> 00:18:09,670
،إذا استطعتُ أن أكون مُفيداً لك
!حينئذ سوف أفعل أي شيء

267
00:18:10,200 --> 00:18:15,310
،لأنّك أخي الكبير الوحيد في العالم كلّه

268
00:18:15,310 --> 00:18:17,220
!وأطمح لأكون مثلك بشدّة

269
00:18:22,820 --> 00:18:26,580
لا تُقدِم على هذا التصرُّف الطّائش ثانية

270
00:18:29,080 --> 00:18:30,460
أخبرتُك

271
00:18:32,370 --> 00:18:35,840
لا تعرِّض حياتك لخطر ثانية أبداً

272
00:18:40,060 --> 00:18:41,190
أتتذكّر؟

273
00:18:41,900 --> 00:18:43,050
أتذكّر بالطّبع

274
00:18:48,870 --> 00:18:50,630
!أنا آسف

275
00:18:51,060 --> 00:18:53,480
!أنا آسف يا أخي

276
00:18:53,480 --> 00:18:55,680
!أنا آسف يا أختي

277
00:18:55,680 --> 00:18:56,860
...أنا آسف

278
00:18:57,730 --> 00:18:59,340
فهمت، لذا توقّف عن البُكاء

279
00:18:59,920 --> 00:19:01,080
...لكن هذا

280
00:19:09,400 --> 00:19:10,430
ريشي

281
00:19:10,430 --> 00:19:12,500
أتيت لأجله، أليس كذلك؟

282
00:19:13,040 --> 00:19:15,220
لأنّكِ قلتِ شيئاً حيّرني

283
00:19:16,090 --> 00:19:19,510
يسرّني أنّكما تمكّنتُما من مُعالجة الأمور بينكما

284
00:19:19,880 --> 00:19:21,980
...أنا مسرورةٌ للغاية

285
00:19:22,440 --> 00:19:23,220
ريشي؟

286
00:19:25,070 --> 00:19:28,200
!أختي! ماذا أفعل؟ هذه غلطتي

287
00:19:28,200 --> 00:19:29,270
ليست كذلك

288
00:19:29,270 --> 00:19:29,770
اذا؟

289
00:19:31,540 --> 00:19:33,060
إنّها نائمة فحسب

290
00:19:34,160 --> 00:19:36,710
غير ممكن. في هذه الظّروف؟

291
00:19:44,520 --> 00:19:47,320
تيودور، لديك عربة جاهزة، أليس كذلك؟

292
00:19:48,040 --> 00:19:49,970
!لـ-لديّ بالطّبع

293
00:19:49,970 --> 00:19:51,290
سأستدعيها حالاً

294
00:19:51,590 --> 00:19:52,570
أعتمد عليك

295
00:20:01,720 --> 00:20:03,430
"قال "أعتمد عليك

296
00:20:04,090 --> 00:20:07,160
قالها أخي الكبير. لي أنا

297
00:20:28,800 --> 00:20:30,580
استيقظتِ من الآن؟

298
00:20:30,580 --> 00:20:33,240
هل بقيت معي طوال هذا الوقت؟

299
00:20:33,240 --> 00:20:35,080
!أنا آسفة جدّاً

300
00:20:35,610 --> 00:20:36,760
كيف حالُكِ؟

301
00:20:36,760 --> 00:20:38,370
أنا بخير الآن

302
00:20:38,840 --> 00:20:39,710
جيّد

303
00:20:45,020 --> 00:20:46,180
،إلى أختي

304
00:20:46,690 --> 00:20:49,580
أنا آسف لأنّني فعلتُ كلّ تلك
الأشياء الفظيعة بحقّكِ

305
00:20:49,580 --> 00:20:54,850
،هناك أمور كثيرة أريد قولها، لكن أوّلاً
أعِدُكِ بردّ الجميل الّذي صنعتِه لي

306
00:20:55,800 --> 00:21:00,040
وقلتِ بأنّكِ ستمنعين أخي من مُحاولة
الإقدام على أي عمل، أليس كذلك؟

307
00:21:00,560 --> 00:21:04,150
نظراً للأوضاع الرّاهنة، أرغب
في مساعدتكِ بشأن ذلك

308
00:21:05,060 --> 00:21:08,240
لتحقيق تلك الغاية، سأسمح لكِ
باستعارة شعبي في الأحياء الفقيرة

309
00:21:08,510 --> 00:21:10,860
هذا ما يُشير إليه النّاس بالجبهة المُتّحدة، صحيح؟

310
00:21:10,860 --> 00:21:12,920
تعالي إليّ طلباً للمساعدة في أيّ وقت

311
00:21:12,920 --> 00:21:15,000
مع فائق الامتنان لي بالطّبع

312
00:21:16,480 --> 00:21:17,500
...أخيراً

313
00:21:18,230 --> 00:21:20,330
شكراً لكِ يا أختي الكبرى

314
00:21:21,250 --> 00:21:24,640
أنت والأمير تيودور قد تكلّمتُما، أليس كذلك؟

315
00:21:25,110 --> 00:21:27,910
لماذا تبتسمين هكذا؟

316
00:21:27,910 --> 00:21:30,010
لأنّني سعيدةٌ بالطّبع

317
00:21:34,120 --> 00:21:37,040
فكّري في شيء آخر تريدينه

318
00:21:38,570 --> 00:21:41,100
وعدي بعدم لمسكِ

319
00:21:41,100 --> 00:21:43,400
انتهكتُه ثانية، أليس كذلك؟

320
00:21:51,230 --> 00:21:53,370
!لـ-لا أحتاج شيئاً

321
00:21:53,370 --> 00:21:56,550
الأهمّ من ذلك، سبب قيام
—سموّك بشيء كهذا

322
00:21:56,550 --> 00:21:57,460
هل تريدين معرفة السّبب؟

323
00:21:57,460 --> 00:21:58,920
!لا أريد

324
00:22:01,630 --> 00:22:02,460
ريشي

325
00:22:02,460 --> 00:22:04,110
ما الأمر الآن؟

326
00:22:05,240 --> 00:22:08,050
شكراً لكِ على الاعتناء بأخي الصّغير

327
00:22:10,020 --> 00:22:10,960
لا شكر على واجب

328
00:22:11,510 --> 00:22:15,300
سيكون أخي الصّغير أيضاً في النّهاية

329
00:22:18,620 --> 00:22:19,630
هكذا إذاً