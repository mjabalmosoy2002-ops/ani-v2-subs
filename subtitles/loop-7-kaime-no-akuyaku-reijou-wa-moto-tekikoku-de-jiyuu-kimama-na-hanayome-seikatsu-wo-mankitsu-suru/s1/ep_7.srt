1
00:00:02,800 --> 00:00:04,020
شكراً لك

2
00:00:05,650 --> 00:00:09,520
سمعتُ أنّ السيّد كاميل وإلزي
لن يتلقّيا عقوبة

3
00:00:10,270 --> 00:00:12,900
إنّه ليس شيئاً يدعو لشكري

4
00:00:13,210 --> 00:00:16,600
بينما أفكّر في الأمر، سمعتُ بأنّ
سياسات تحسين الأحياء الفقيرة

5
00:00:16,600 --> 00:00:20,540
ستسير على قدمٍ وساق تحت
قيادتك يا سموّ الأمير تيودور

6
00:00:22,160 --> 00:00:25,000
سألني أخي ما إن كنتُ أرغب في فعل ذلك

7
00:00:25,000 --> 00:00:29,290
إذاً، هل هذا يعني بأنّكما سوف
تهتمّان بالأمور الرّسميّة؟

8
00:00:30,490 --> 00:00:33,030
أجل، هذا ما أفترضه

9
00:00:33,780 --> 00:00:37,550
حسناً، لم تتكبّدي عناء المجيء إلى هنا
فقط كي تقولي ذلك، صحيح؟

10
00:00:38,390 --> 00:00:41,430
في الحقيقة، أريد أن أطلب منك معروفاً

11
00:00:44,020 --> 00:00:44,670
ماذا؟

12
00:00:45,310 --> 00:00:49,190
هذا شيء سيكون جوهريّاً
بالنّسبة لأخيك كذلك

13
00:00:49,650 --> 00:00:54,190
ماذا أفعل؟ لا أملك فكرة
عمّا تقوله خطيبة أخي

14
00:00:54,600 --> 00:00:57,130
أرجوك يا سموّ الأمير تيودور

15
00:02:31,560 --> 00:02:33,350
اكتملت التّحضيرات

16
00:02:35,580 --> 00:02:37,510
سأغادر الآن

17
00:02:37,780 --> 00:02:38,720
!عُلِم

18
00:02:43,230 --> 00:02:46,070
وصلَتْ رسالةٌ رسميّةٌ من مملكة كويوليس

19
00:02:58,870 --> 00:02:59,710
ادخل

20
00:03:02,200 --> 00:03:04,930
كيف حالُك يا سموّ الأمير آرنولد؟

21
00:03:04,930 --> 00:03:08,790
شكراً لك على الاقتطاع من وقتِك
من أجلي على الرُّغم من انشغالك

22
00:03:09,080 --> 00:03:11,290
ما طبيعة العمل الّتي جلبَتْكِ إلى هنا؟

23
00:03:11,290 --> 00:03:15,280
تبدين متوتّرة جدّاً لدرجة تجعلني أعتقد
بأنّكِ لم تأتي إلى هنا لرؤية وجه خطيبكِ

24
00:03:21,620 --> 00:03:24,800
تمّ تحضير غرفة لك في القصر، سموّك

25
00:03:25,160 --> 00:03:25,950
ماذا؟

26
00:03:26,690 --> 00:03:30,280
إذا كان لديك الوقت، هل يمكنني
أن أدلّك إلى الغرفة الآن؟

27
00:03:30,280 --> 00:03:33,310
لِمَ تجعلكِ هذه المهمّة متوتّرة؟

28
00:03:33,610 --> 00:03:37,060
عَمِلَتْ خادماتي عليها بشغف واجتهاد

29
00:03:37,060 --> 00:03:39,910
إنّه أشبه بامتحان تخرُّج بالنّسبة لهُن

30
00:03:40,570 --> 00:03:45,280
لكن يمكنني أن أطمئنك بأنّ الغرفة
الّتي حضّرنَها جميلة جدّاً

31
00:03:46,360 --> 00:03:50,790
كنتُ قد ظننتُ بأنّ أمنيتكِ كانت
أن تعيشي في ذاك القصر بمفردكِ

32
00:03:50,790 --> 00:03:52,400
!بالطّبع لا

33
00:03:52,400 --> 00:03:56,170
أريد العيش هناك معك يا سموّ الأمير آرنولد

34
00:03:57,520 --> 00:03:58,730
هكذا إذاً

35
00:03:59,400 --> 00:04:02,300
يبدو أنّكِ تخطِّطين لشيء مُسلٍّ ما ثانية

36
00:04:02,300 --> 00:04:04,590
!تجعلني أبدو سيّئة

37
00:04:05,030 --> 00:04:06,050
حسناً

38
00:04:06,400 --> 00:04:08,510
سأتماشى مع مخطّطكِ

39
00:04:08,510 --> 00:04:10,680
بفضلك، تحسّن مزاجي

40
00:04:11,590 --> 00:04:13,430
مزاجك؟

41
00:04:13,430 --> 00:04:14,480
هيّا بنا

42
00:04:20,520 --> 00:04:22,190
شكراً لكِ

43
00:04:26,390 --> 00:04:28,530
هذه غرفتك الخاصّة، سموّك

44
00:04:29,080 --> 00:04:32,050
ما رأيك؟ إنّها غرفة مُبهرة، أليس كذلك؟

45
00:04:32,050 --> 00:04:33,830
مُبهرة جدّاً

46
00:04:34,060 --> 00:04:37,710
تُرِك هذا القصر مهجوراً لسنوات عديدة

47
00:04:37,960 --> 00:04:40,170
قضيتِ ثلاثة أسابيع فقط هنا

48
00:04:40,170 --> 00:04:41,910
لا أصدِّق بأنّكِ حسّنتِه إلى هذه الدّرجة

49
00:04:41,910 --> 00:04:43,580
!شكراً لك

50
00:04:43,580 --> 00:04:45,840
علّمتِ المُبتدئات من الصّفر، أليس كذلك؟

51
00:04:45,840 --> 00:04:49,970
أجل. حالما يتعلّمن مهنة، سيتمكنَّ
من توفير قوت يومهن في أيّ مكان

52
00:04:49,970 --> 00:04:51,990
وسيكتسبن شيئاً آخر أيضاً

53
00:04:53,480 --> 00:04:54,480
الفخر

54
00:04:55,010 --> 00:04:58,550
عندما يُنجِزن عملهن ويكسبن
،إطراء شخص آخر

55
00:04:58,550 --> 00:04:59,880
سيمنحهن هذا إحساساً بالفخر

56
00:05:00,510 --> 00:05:03,190
يستطيع هذا الفخر أن يساعد الشّخص
في تسخير كافّة إمكانيّاته

57
00:05:03,700 --> 00:05:07,570
لديكِ موهبة في منح النّاس
إحساساً بالاحترام الذّاتيّ

58
00:05:11,280 --> 00:05:13,980
هذا هو التّعبير الّذي يظهر
في وجهكِ عندما أمدحكِ؟

59
00:05:15,270 --> 00:05:18,320
تسخر منّي، أليس كذلك؟

60
00:05:18,320 --> 00:05:20,420
قد لا يبدو كذلك، لكنّه إطراء من أعماق قلبي

61
00:05:20,910 --> 00:05:22,570
حسناً، لسوء حظّك

62
00:05:22,570 --> 00:05:26,970
حتّى لو كانت كذبة، إنَّ تلقِّي مديحاً
منك يجعلني سعيدة للغاية

63
00:05:29,650 --> 00:05:33,620
من بين كلّ غرف القصر، تتمتّع
هذه الغرفة بالإضاءة الأفضل

64
00:05:39,080 --> 00:05:41,590
،تهبُّ نسمةٌ رائعة عند فتح النّافذة

65
00:05:41,590 --> 00:05:43,820
لذا هذا مثاليّ لقيلولة ما بعد
الظّهر، ألا تعتقد ذلك؟

66
00:05:44,180 --> 00:05:46,580
لا أعود أبداً إلى غرفتي الخاصّة أثناء النّهار

67
00:05:47,140 --> 00:05:49,450
هذه الغرفة بجانب غرفتكِ، أليس كذلك؟

68
00:05:49,450 --> 00:05:53,580
أجل. ارتأيتُ أنّ هذا سيُسهّل
الأمر بالنّسبة للحرّاس

69
00:05:53,800 --> 00:05:55,000
وبالنّسبة لي

70
00:05:55,000 --> 00:05:55,770
ماذا؟

71
00:05:55,770 --> 00:05:58,700
لأنّني سأعلم بسلوككِ الطّائش سلفاً

72
00:05:58,700 --> 00:06:02,460
أنوي قضاء وقتي مُتكاسِلة، لذا
لن أقوم بأي عمل طائش

73
00:06:03,960 --> 00:06:05,460
ليس كثيراً على أيّ حال

74
00:06:05,460 --> 00:06:06,630
حمقاء

75
00:06:07,140 --> 00:06:08,750
،أنتِ حُرّة للقيام بما تشائين

76
00:06:08,750 --> 00:06:11,320
لكن لا تقومي بأيّ عمل طائش
مثلما فعلتِ قبل أيّام

77
00:06:11,320 --> 00:06:12,930
أنا آسفة جدّاً

78
00:06:14,010 --> 00:06:18,050
على ذكرِ الأمر، هل تتذكّر ما تكلّمنا
عنه في الحفلة في ذلك المساء؟

79
00:06:18,050 --> 00:06:18,850
ماذا تقصدين؟

80
00:06:19,420 --> 00:06:22,480
عندما قلتَ بأنّك تريد المُبارزة معي

81
00:06:24,470 --> 00:06:27,790
قد يكون من الجدير أن أحاول
مُبارزتكِ يوماً ما

82
00:06:27,790 --> 00:06:30,280
!أرغب في ذلك بشدّة

83
00:06:30,940 --> 00:06:33,240
أجل، قلنا ذلك

84
00:06:33,240 --> 00:06:34,750
مرّة واحدة فقط ستكون كافية

85
00:06:34,750 --> 00:06:36,620
هلّا علّمتني؟

86
00:06:36,620 --> 00:06:41,370
علّمني باستخدام طُرُق التّدريب الخاصّة الّتي
تستخدمها سموُّك والفُرسان الإمبراطوريّون

87
00:06:42,340 --> 00:06:44,630
ما الّذي يجعلكِ تقولين بأنّها خاصّة؟

88
00:06:45,330 --> 00:06:49,800
منذ المجيء إلى هذا القصر، راقبتُ
،الجميع بينما يتدرّبون مرّات عدّة

89
00:06:49,800 --> 00:06:54,510
لكن حركة سموّك والفُرسان الإمبراطوريّين
مختلفة عن الباقي بشكلٍ واضح

90
00:06:57,680 --> 00:06:58,680
حسناً

91
00:06:58,680 --> 00:07:01,350
ماذا؟ هل أنتِ متأكِّدة؟

92
00:07:01,970 --> 00:07:06,110
وعدتُ أن أفعل أيّ شيء تمنّيتِه في نهاية المطاف

93
00:07:06,110 --> 00:07:09,320
المعذرة... شكراً لك

94
00:07:09,880 --> 00:07:11,860
هذا يُسعدني للغاية

95
00:07:12,400 --> 00:07:13,740
يُسعدكِ؟

96
00:07:14,220 --> 00:07:21,750
حسب معلوماتي، حركتك بالسّيف
هي الأجمل والأقوى في العالم

97
00:07:23,030 --> 00:07:24,990
في العالم؟

98
00:07:25,760 --> 00:07:28,000
!هـ-هذا مجرّد تعبير مجازي

99
00:07:28,590 --> 00:07:33,320
مهارة الغاية منها فقط قتل النّاس
لا يمكن أن تكون جميلة

100
00:07:33,770 --> 00:07:34,890
...سموّك

101
00:07:36,480 --> 00:07:38,670
سأسبقكِ إلى ساحة التّمرين

102
00:07:38,670 --> 00:07:40,500
بدّلي ملابسكِ بملابس يمكنكِ التحرُّك بها

103
00:07:44,370 --> 00:07:47,600
أهذا تتمرّن دوماً؟

104
00:07:47,600 --> 00:07:49,400
ليس دوماً

105
00:07:49,400 --> 00:07:53,150
،حال يكتسب المرءُ عادة غير صحّية
يفوت الأوان على فعل شيء بشأنها

106
00:07:53,150 --> 00:07:57,960
قيود الذّراع والسّاق الغاية منها المساعدة
،في مُحاكاة ظروف ساحة المعركة بدقّة

107
00:07:57,960 --> 00:08:00,660
وذلك كي تتمكّن من القتال حتّى
لو خسرت طرفاً من أطرافك

108
00:08:01,210 --> 00:08:03,290
هذه هي الغاية من التّدريب، أليس كذلك؟

109
00:08:04,330 --> 00:08:07,290
كالعادة، مُلاحظاتكِ مُبهرة

110
00:08:07,740 --> 00:08:10,300
حتّى لو مُزِّقت ذراعي، سأظلُّ ألوِّح بسيفي

111
00:08:10,300 --> 00:08:13,050
حتّى لو تحطّمَتْ ساقي، سأستمرُّ في التقدُّم

112
00:08:13,050 --> 00:08:15,330
،وحتّى لو خسرتُ كلتا عينَي

113
00:08:15,330 --> 00:08:18,550
،سأظلُّ أبحث، حتّى الرّمق الأخير
عن طريق لقطع عدوّي

114
00:08:19,000 --> 00:08:22,360
إنَّ القيام بذلك سيؤدّي إلى طريقة أنجو بها

115
00:08:22,960 --> 00:08:27,770
سمعتُ بأنّ طريق الفارس مليء بالنُّبل والجمال

116
00:08:28,530 --> 00:08:32,380
غير أنّ الفارس عليه أن يبحث عن طريقة
للبقاء، مهما قاوم بصورة بشعة

117
00:08:32,380 --> 00:08:34,460
يقتل أعداءه من أجل البقاء

118
00:08:35,110 --> 00:08:37,950
طريقة التّفكير هذه مُستمدّة من سموّك، أليس كذلك؟

119
00:08:39,100 --> 00:08:41,450
لا عجب في أنّني لم أكن ندّة له

120
00:08:41,450 --> 00:08:43,110
لا تقلقي

121
00:08:43,110 --> 00:08:47,960
لا أنوي جرح شخص يتحضّر
لمراسم الزّفاف خاصّته

122
00:08:50,500 --> 00:08:55,090
إذا ربحتُ، فهل ستمنحني إجابة
على سؤالٍ واحد مهما كان؟

123
00:08:56,010 --> 00:09:02,350
بالمُقابل، إذا خسرتُ أنا، سأمنح
أمنيةً من أمنيات سموّك مهما كانت

124
00:09:03,870 --> 00:09:05,100
مُوافق

125
00:09:05,300 --> 00:09:07,820
حسناً، لو سمحت

126
00:09:08,350 --> 00:09:09,500
!ابدآ

127
00:09:12,540 --> 00:09:15,260
،كلّما دام تبادُل ضرباتنا فترة أطول
ازداد موقفي الحرِج أكثر

128
00:09:21,080 --> 00:09:22,560
!هجمة أماميّة

129
00:09:27,970 --> 00:09:30,370
ما الخطب؟ أهذا كلُّ ما لديكِ؟

130
00:09:31,540 --> 00:09:33,750
مركز توازني غير مستقرّ

131
00:09:33,750 --> 00:09:37,260
تحاول غريزتي أن تجعلني أتحرّك بالطّريقة الّتي أتحرّكها
عندما أستطيع استخدام ذراعي اليسرى

132
00:09:37,920 --> 00:09:41,760
...إذا عدّلتُ مركزَ توازني فحسب
سوف أبلغ مدى أبعد

133
00:09:42,700 --> 00:09:44,430
!عليّ أن أقترب خطوة

134
00:09:46,600 --> 00:09:48,850
ضَعُفَتْ حركتُك! لا تعتمدي
!على القوّة وحدها

135
00:09:49,450 --> 00:09:50,860
!حركة قدميكِ تزداد استهتاراً

136
00:09:51,230 --> 00:09:52,860
استفيدي من رشاقتكِ

137
00:09:53,270 --> 00:09:54,440
!تقدّمي أكثر

138
00:09:55,360 --> 00:09:56,490
خطوة أخرى

139
00:09:56,490 --> 00:09:57,110
المزيد

140
00:09:57,110 --> 00:09:58,110
أترين؟

141
00:10:00,820 --> 00:10:02,810
إنّه مُبهرٌ حقّاً

142
00:10:02,810 --> 00:10:04,720
،في تبادُل الضّربات القصير هذا

143
00:10:04,720 --> 00:10:07,830
يحدّد لي بالضّبط النّقاط الّتي
يجب أن أعمل على تحسينها

144
00:10:10,830 --> 00:10:15,810
لم يمضِ إلّا وقت قصير على مُبارزة
...مولاتي ريشي مع سموّه بالسّيف، لكن

145
00:10:15,810 --> 00:10:19,590
معك حقّ. بلمح البصر، تحسّنَتْ تحرُّكاتها بالفعل

146
00:10:27,220 --> 00:10:28,740
!والآن، سيهاجم من الأعلى

147
00:10:35,650 --> 00:10:38,390
نفس الحركة آنذاك

148
00:10:39,000 --> 00:10:43,140
،لكن حتّى لو فهمتُ ما يجري
لا يستطيع جسدي مُجاراته

149
00:10:44,370 --> 00:10:48,280
قبل قليل، قلتِ بأنّ سيفي هو الأقوى، أليس كذلك؟

150
00:10:48,880 --> 00:10:53,670
لكن تلك الحركة للتوّ كانت حركة
شخص يعرف أحداً أقوى منّي

151
00:10:54,600 --> 00:10:58,990
حتّى وأنتِ تتبارزين معي، تفكّرين
في ذلك الشّخص، أليس كذلك؟

152
00:11:00,700 --> 00:11:01,910
كم أحسده

153
00:11:03,720 --> 00:11:05,960
أنا على وشك أن أصبح غيُّوراً

154
00:11:07,160 --> 00:11:08,640
تمزح بالتّأكيد

155
00:11:09,110 --> 00:11:15,560
كما أخبرتُك، أنت أقوى شخص
أعرفه يا سموّ الأمير آرنولد

156
00:11:16,480 --> 00:11:21,580
هذا صحيح. الأمير بعد خمس سنوات
من الآن كان أقوى ممّا هو الآن

157
00:11:21,580 --> 00:11:23,720
كان قاسياً وقويّاً إلى حدٍّ كبير

158
00:11:26,230 --> 00:11:27,100
تعالي إليّ

159
00:11:28,300 --> 00:11:30,290
ركّزي عليّ أكثر قليلاً

160
00:11:49,780 --> 00:11:50,520
!لم أنتهِ بعد

161
00:12:05,680 --> 00:12:07,310
مُبهر جدّاً

162
00:12:07,310 --> 00:12:09,830
لم أكن أنوي التحرُّك خطوة واحدة

163
00:12:11,010 --> 00:12:15,080
يبدو أنّك تحفّظتَ قليلاً من أجلي

164
00:12:15,580 --> 00:12:18,590
لكن يبدو أنّني استهنتُ بكِ بشكل كبير

165
00:12:19,700 --> 00:12:22,120
شكراً على تعليماتك

166
00:12:23,560 --> 00:12:27,340
ستفعلين أي شيء أريده، صحيح؟

167
00:12:27,340 --> 00:12:29,840
أجل. اطلب ما تشاء منّي

168
00:12:29,840 --> 00:12:31,350
لن أتراجع عن كلمتي

169
00:12:32,560 --> 00:12:35,720
إذاً تفرّغي بعد يومين من الآن ظهراً

170
00:12:35,720 --> 00:12:36,980
سندخل البلدة

171
00:12:36,980 --> 00:12:40,770
ندخل البلدة؟ لماذا؟

172
00:12:40,770 --> 00:12:42,260
سأخبركِ عندما يحين الوقت

173
00:12:45,010 --> 00:12:47,110
ما المُشكلة؟ انهضي

174
00:12:50,990 --> 00:12:52,620
...المعذرة

175
00:12:53,220 --> 00:12:55,970
سأبقى هكذا فترة أطول قليلاً

176
00:12:55,970 --> 00:12:58,250
من فضلك عُد من دوني

177
00:12:58,250 --> 00:12:59,160
لماذا؟

178
00:13:01,480 --> 00:13:06,880
،الحقيقة هي... بسبب مُبارزتنا اللتوّ
ذراعايّ وساقايّ ترتجفان

179
00:13:07,360 --> 00:13:08,530
ماذا؟

180
00:13:08,530 --> 00:13:11,140
يبدو أنّ جسدي لم يستطع مُجاراتك

181
00:13:11,570 --> 00:13:14,070
لذا سأستريح قليلاً

182
00:13:16,090 --> 00:13:17,270
سموّك؟

183
00:13:17,900 --> 00:13:21,400
سألمسكِ فقط عبر قفّازاتي، لذا
لن تكون مُشكلة، أليس كذلك؟

184
00:13:22,030 --> 00:13:22,480
ماذا؟

185
00:13:22,480 --> 00:13:23,980
!ماذا؟ لحظة، سموّك

186
00:13:32,030 --> 00:13:33,640
كفّي عن المُقاومة، ستسقطين

187
00:13:33,640 --> 00:13:35,490
...المعذرة، كلّ ما في الأمر أنّ هذا

188
00:13:35,490 --> 00:13:36,410
لا يمكنكِ الوقوف، صحيح؟

189
00:13:36,410 --> 00:13:39,290
!يمكنني الوقوف! سوف أقف! أنزلني أرجوك

190
00:13:39,290 --> 00:13:41,890
لا أستطيع العودة وترك خطيبتي
خلفي فحسب، صحيح؟

191
00:13:41,890 --> 00:13:44,630
...قد يكون ذلك صحيحاً، لكن

192
00:13:46,520 --> 00:13:49,740
بالمناسبة، ما الّذي أردتِ أن تطلبيه منّي؟

193
00:13:49,740 --> 00:13:50,260
ماذا؟

194
00:13:50,660 --> 00:13:55,110
قلتِ بأنّكِ إذا ربحتِ، فسيترتّب عليّ
الإجابة عن سؤال واحد، صحيح؟

195
00:13:55,110 --> 00:13:57,270
هل تعتقد بأنّني أستطيع
أن أسألك بهذا الشّكل؟

196
00:13:58,310 --> 00:13:59,270
تضحك؟

197
00:13:59,580 --> 00:14:03,020
توقّعت! أنت تستمتع برؤية ردود فعلي، صحيح؟

198
00:14:03,020 --> 00:14:04,180
أنا كذلك؟

199
00:14:04,780 --> 00:14:06,910
حسناً، متى يوم ميلادك؟

200
00:14:06,910 --> 00:14:09,030
الثّامن والعشرون من الشّهر الثّاني عشر

201
00:14:09,030 --> 00:14:11,970
،وُلِدتَ في الشّتاء إذاً! التّالي
ما هي اهتماماتك؟

202
00:14:11,970 --> 00:14:13,160
لا أملك أي اهتمامات

203
00:14:13,160 --> 00:14:15,250
ما الأشياء الّتي تحبّها، سموّك؟

204
00:14:15,250 --> 00:14:17,050
لم أفكِّر في الأمر بصراحة

205
00:14:17,050 --> 00:14:18,840
ما نوع المرأة الّتي تفضِّلها؟

206
00:14:18,840 --> 00:14:21,270
وما الفائدة الّتي ستجنينها بسؤال كهذا؟

207
00:14:33,490 --> 00:14:34,850
سيّد أوليفر

208
00:14:35,330 --> 00:14:37,170
مولاتي ريشي

209
00:14:37,170 --> 00:14:39,320
هل تنقل المكتب الآن؟

210
00:14:39,320 --> 00:14:43,860
أجل. شكراً لكِ على تحضير مثل هذه
الغرفة الرّائعة من أجل سموّه

211
00:14:44,200 --> 00:14:45,180
العفو

212
00:14:45,650 --> 00:14:47,480
بالمناسبة، أين الأمير؟

213
00:14:48,030 --> 00:14:51,790
في الحقيقة، ترتّبَ عليه في اللّيلة
،الماضية فجأة قيادة الحرس اللّيليّ

214
00:14:51,790 --> 00:14:53,120
لذا لم ينم بعد

215
00:14:53,120 --> 00:14:54,170
ماذا؟

216
00:14:54,170 --> 00:14:58,200
توسّلتُ إليه أن يأخذ قيلولة، لكن
لديه واجباته الرّسميّة

217
00:14:58,200 --> 00:15:00,520
إنّه لا ينوي الرّاحة إطلاقاً

218
00:15:04,910 --> 00:15:07,380
ارتح من فضلك، سموّك

219
00:15:07,380 --> 00:15:10,040
قالَ أوليفر كلاماً لا ضرورة له، أليس كذلك؟

220
00:15:10,040 --> 00:15:12,130
السّهر طوال اللّيل سيُرهِق جسدَك

221
00:15:12,540 --> 00:15:14,140
لن أتمكّن من النّوم على أي حال

222
00:15:14,610 --> 00:15:18,950
أثناء النّهار، يمكنني الشُّعور بوجود
مُختلَف أشكال النّاس في القصر

223
00:15:21,350 --> 00:15:22,520
حسناً

224
00:15:25,050 --> 00:15:28,840
إذاً سوف أغنّي لك تهويدة النّوم
يا سموّ الأمير آرنولد

225
00:15:29,720 --> 00:15:30,500
ماذا؟

226
00:15:37,960 --> 00:15:43,490
والآن، سوف أبقى بجانبك، لذا
من فضلك لا تقلق، ارتح فحسب

227
00:15:45,130 --> 00:15:49,340
أحياناً تقولين كلاماً غير منطقيّ إطلاقاً

228
00:15:49,340 --> 00:15:54,540
بوجودي هنا، فلا أظنُّك سوف تُشتَّت
بمرور أشخاص بعيدين

229
00:15:54,540 --> 00:15:56,080
أنتِ مُحِقّة حول ذلك

230
00:15:56,080 --> 00:15:58,890
إذاً من فضلك، نَل قسطاً من الرّاحة

231
00:16:24,600 --> 00:16:26,430
لا يبدو أنّ هذا ينجح

232
00:16:30,070 --> 00:16:31,800
هلّا استلقيتُ بجانبك؟

233
00:16:39,990 --> 00:16:41,460
المعذرة على الإزعاج

234
00:16:54,800 --> 00:16:57,440
ماذا تفعلين؟

235
00:16:57,980 --> 00:17:02,890
إنَّ تقليد نبضات القلب هكذا هو
تقنيّة لتهدئة القلب والذّهن

236
00:17:04,520 --> 00:17:09,140
في حياتي كخادمة، كنتُ كثيراً
ما أفعل هذا لأجل مولاتي

237
00:17:09,840 --> 00:17:13,960
إذا فعلت هذا لطفل، سرعان ما سينام

238
00:17:14,450 --> 00:17:15,970
طفل؟

239
00:17:19,030 --> 00:17:22,810
أنتِ الشّخص الوحيد الّذي
يعاملني بهذا الشّكل

240
00:17:45,410 --> 00:17:47,270
،إن كان ينتابكِ فضول حياله
فافعلي ما يحلو لكِ

241
00:18:03,390 --> 00:18:04,520
توقّفي

242
00:18:05,370 --> 00:18:06,680
...أنتِ حقّاً

243
00:18:06,680 --> 00:18:10,270
أ-أنا آسفة. لا بدّ أنّ ذلك كان مُدغدِغاً

244
00:18:12,020 --> 00:18:15,220
إذا كنّا سنفعل هذا، فينبغي
أن أرتدي قفّازاً

245
00:18:15,730 --> 00:18:19,560
لو فعلتُ، فبوسعي حينها تنفيذ ضربة مرتدّة

246
00:18:19,560 --> 00:18:24,370
ليس وكأنّ لمسي بقفّازات أو من خلال
!قماش يجعل الأمر مُباحاً

247
00:18:25,310 --> 00:18:26,400
كانت مزحة

248
00:18:33,480 --> 00:18:37,400
سموّه صادقٌ جدّاً وحريص لدرجة غريبة

249
00:18:39,680 --> 00:18:42,410
...بينما أنا، في الجانب الآخر

250
00:18:47,600 --> 00:18:48,640
افعل من فضلك

251
00:18:50,840 --> 00:18:51,860
أفعل ماذا؟

252
00:18:52,710 --> 00:18:54,690
شعرتُ بأنّني لم أكن مُنصِفة

253
00:18:55,390 --> 00:18:57,860
،إذا كان هذا سيجعل سموّك تشعر براحة

254
00:18:57,860 --> 00:19:00,950
—فحينها ينبغي أن تلمسني وتأخذ بثأر

255
00:19:00,950 --> 00:19:03,540
هل تفعلين هذا عمداً؟

256
00:19:03,540 --> 00:19:04,870
!بئساً لك، سموّك

257
00:19:09,010 --> 00:19:13,300
من أجل ثأري... سأكون رحيماً
وأكتفي بتعبير وجهكِ هذا

258
00:19:15,800 --> 00:19:17,290
أنتِ غريبة

259
00:19:17,290 --> 00:19:19,640
،النّوم بجانبي لا يُقلقكِ

260
00:19:19,640 --> 00:19:22,650
لكن النّظر في عينَي من هذه
المسافة يجعلكِ ترتبكين

261
00:19:24,290 --> 00:19:26,600
أردتُ استخدام سحر عليك

262
00:19:26,600 --> 00:19:27,470
سحر؟

263
00:19:27,900 --> 00:19:30,610
هذا القصر ليس ساحة معركة

264
00:19:30,610 --> 00:19:32,480
إنّه منزل سموّك، أليس كذلك؟

265
00:19:32,480 --> 00:19:37,860
لهذا تمنّيتُ أن تشعر ولو براحة أكبر
قليلاً وذلك كي تتمكّن من النّوم

266
00:19:38,450 --> 00:19:41,780
إذاً ابقي هنا حتّى أنام

267
00:19:43,110 --> 00:19:46,610
هذا أكثر إمتاعاً من غرفة فارغة

268
00:19:49,080 --> 00:19:50,420
حسناً

269
00:20:05,680 --> 00:20:06,980
استيقظتِ؟

270
00:20:12,560 --> 00:20:14,900
...سموّك

271
00:20:17,960 --> 00:20:20,150
الأمير آرنولد، لماذا أنت هنا؟

272
00:20:20,150 --> 00:20:23,530
ألا تتذكّرين صعودكِ إلى هذا السّرير بنفسكِ؟

273
00:20:25,100 --> 00:20:27,550
هـ-هل تمكّنت من النّوم؟

274
00:20:27,550 --> 00:20:30,180
أهذا أوّل شيء تريدين معرفته؟

275
00:20:31,530 --> 00:20:33,400
على أيّ حال، أستميحك عذراً

276
00:20:33,400 --> 00:20:35,790
سأغادر غرفتك حالاً. لا تقلق من فضلك

277
00:20:35,210 --> 00:20:35,790
انتظري

278
00:20:36,020 --> 00:20:36,630
ماذا؟

279
00:20:37,030 --> 00:20:37,740
—ما

280
00:20:40,040 --> 00:20:41,300
!المعذرة، سموّك

281
00:20:41,790 --> 00:20:44,400
ابقي هادئة لقليل من الوقت

282
00:20:48,050 --> 00:20:48,820
ادخل

283
00:20:51,660 --> 00:20:52,680
ما الأمر؟

284
00:20:53,100 --> 00:20:57,190
تلقّينا بعض التّقارير. هل كنتَ نائماً؟

285
00:20:57,190 --> 00:21:00,430
تكلّمَتْ معك مولاتي ريشي إذاً

286
00:21:00,430 --> 00:21:04,200
بما أنّك استطعت قضاء وقت
،بأريحيّة في غرفتك الجديدة

287
00:21:04,200 --> 00:21:05,450
فهذا رائع إذاً

288
00:21:05,450 --> 00:21:08,320
اختصر. سأستمع للتّقرير هنا

289
00:21:08,870 --> 00:21:10,500
أمرك

290
00:21:13,830 --> 00:21:16,120
حسناً، سأعود إلى العمل

291
00:21:16,120 --> 00:21:18,110
احرص على الرَّاحة جيّداً من فضلك

292
00:21:18,110 --> 00:21:19,580
كُفّ عن الإلحاح

293
00:21:19,580 --> 00:21:21,350
فهمت، لذا انصرف بسرعة

294
00:21:21,350 --> 00:21:22,340
حاضر، حاضر

295
00:21:22,840 --> 00:21:24,590
حسناً، تصبح على خير

296
00:21:30,820 --> 00:21:31,840
أنتِ بأمان الآن

297
00:21:32,270 --> 00:21:34,350
أ-أعلم

298
00:21:34,800 --> 00:21:36,820
...أعلم، لكن

299
00:21:45,980 --> 00:21:48,290
أهلاً بعودتكِ، مولاتي ريشي

300
00:21:48,290 --> 00:21:50,120
شكراً لكِ يا إلزي

301
00:21:50,380 --> 00:21:53,090
وصلَ طردٌ من شركة آريا التّجاريّة

302
00:21:53,920 --> 00:21:55,060
شكراً لكِ

303
00:22:02,920 --> 00:22:05,660
ابتداءً من الغد، سأكون مشغولة جدّاً

304
00:22:08,600 --> 00:22:13,390
سيكون هذا اليوم العاشر في جدول التّدريب
لكم جميعاً يا مُرشّحي الفُرسان

305
00:22:14,040 --> 00:22:16,140
آعلِّق آمالاً كبيرة على تقدُّمكم

306
00:22:16,390 --> 00:22:17,520
!حاضر