1
00:00:01,450 --> 00:00:02,930
!احموا القلعة

2
00:01:12,730 --> 00:01:14,930
ألم يهرب وليُّ العهدِ بعد؟

3
00:01:14,930 --> 00:01:18,050
المسألة ليست بتلك البساطة! الأمراء
!صِغار جدّاً على أن يهربوا بسرعة

4
00:01:21,820 --> 00:01:23,560
!على أي حال، نحن ندافع عن هذا المكان حتّى الموت

5
00:01:23,560 --> 00:01:25,390
!اصمدوا حتّى يقرع جرس الإشارة

6
00:01:43,640 --> 00:01:46,760
،هذا هو الرّجل الّذي أشعل هذه الحرب

7
00:01:48,650 --> 00:01:50,820
:إمبراطور غالكهاين

8
00:01:51,290 --> 00:01:53,040
آرنولد هاين

9
00:02:07,390 --> 00:02:08,280
!انطلقوا

10
00:02:08,280 --> 00:02:09,290
!حاضر

11
00:03:38,400 --> 00:03:41,700
عشتُ هذه الحياة بحلوها ومرّها أيضاً

12
00:03:46,070 --> 00:03:47,320
...لكن

13
00:03:48,290 --> 00:03:52,000
...في المرّة المقبلة... في المرّة المقبلة، سوف

14
00:04:17,030 --> 00:04:19,500
!ريشي إرماغارد فيتزنير

15
00:04:19,500 --> 00:04:23,390
أنتِ امرأةٌ مُخادِعة غير جديرة
!بأن تكوني خطيبة وليّ عهد

16
00:04:23,390 --> 00:04:27,710
!اليوم، اعتباراً من هذه اللّحظة، أفسخ خطوبتي منكِ

17
00:04:29,800 --> 00:04:31,660
حسناً. فهمت

18
00:04:31,660 --> 00:04:32,720
ماذا؟

19
00:04:32,720 --> 00:04:34,780
لحظة. أنا أفسخ خطوبتنا

20
00:04:34,780 --> 00:04:37,670
يجب أن تقلقلي بشأن ما سيحدث لكِ الآن

21
00:04:37,670 --> 00:04:39,140
لا، على الإطلاق

22
00:04:39,420 --> 00:04:40,570
ماذا؟

23
00:04:41,780 --> 00:04:43,080
أستأذن بالانصراف

24
00:04:43,080 --> 00:04:44,730
!ماذا؟ ا-انتظري

25
00:04:44,730 --> 00:04:46,680
ريشي؟ إلى أين أنتِ ذاهبة؟

26
00:04:46,680 --> 00:04:48,390
!اسمعيني

27
00:04:47,340 --> 00:04:49,440
من جديد، عدتُ

28
00:04:48,390 --> 00:04:52,150
قضيتُ أسبوعاً كاملاً وأنا أفكّر في كيفيّة
!قراءة قائمة جرائمكِ

29
00:04:52,150 --> 00:04:55,420
!اسمعي! أنتِ! عودي إلى هنا

30
00:04:54,290 --> 00:04:57,190
أعرف سلفاً كيف ستتمّ مُعاملتي

31
00:04:55,420 --> 00:04:59,310
!توقّفي يا ريشي! اسمعيني عندما أخاطبكِ

32
00:04:58,350 --> 00:04:59,530
،ففي نهاية المطاف

33
00:05:00,820 --> 00:05:04,470
هذه هي المرّة السّابعة الّتي أعيش
فيها حياتي من جديد

34
00:05:13,690 --> 00:05:16,350
...حتّى الآن، أستطيع تذكّرها بوضوح

35
00:05:16,350 --> 00:05:18,660
حياتي الأولى

36
00:05:19,150 --> 00:05:21,750
!ريشي إرماغارد فيتزنير

37
00:05:21,750 --> 00:05:25,480
أنتِ امرأةٌ مُخادِعة غير جديرة
!بأن تكوني خطيبة وليّ عهد

38
00:05:25,480 --> 00:05:29,640
!اليوم، اعتباراً من هذه اللّحظة، أفسخ خطوبتي منكِ

39
00:05:29,640 --> 00:05:32,640
ما-ماذا؟ ستفسخ خطوبتنا؟

40
00:05:32,640 --> 00:05:34,760
لكن... لماذا؟

41
00:05:34,760 --> 00:05:37,140
سوف تُنفَين من هذه المملكة

42
00:05:37,490 --> 00:05:39,310
...وليّ العهد ديتريخ

43
00:05:39,310 --> 00:05:41,400
هل تعني ما تقوله حقّاً؟

44
00:05:41,400 --> 00:05:44,350
سأتلو جرائمكِ الآن

45
00:05:44,350 --> 00:05:45,770
!جرائم؟

46
00:05:47,290 --> 00:05:50,910
نحن عائلة دوقيّة أقسمنا الولاء للتّاج

47
00:05:50,910 --> 00:05:54,040
لا أصدّق أنّكِ، ابنتي الوحيدة، تخونين ذلك القسَم

48
00:05:54,040 --> 00:05:56,540
ينبغي أن تخجلي من نفسكِ يا ريشي

49
00:05:56,540 --> 00:05:59,420
!إنّها اتِّهامات باطلة! اسمعاني أرجوكما

50
00:05:59,420 --> 00:06:01,930
!أبي! أمّي

51
00:06:04,260 --> 00:06:06,130
فُسِخت خطوبتي

52
00:06:06,130 --> 00:06:07,940
تخلَّتْ عنّي عائلتي

53
00:06:08,420 --> 00:06:11,690
همتُ بلا وجهة ولا أملك سوى
ملابسي الّتي أرتديها

54
00:06:22,790 --> 00:06:25,150
ماذا أفعل الآن؟

55
00:06:29,050 --> 00:06:31,470
،هل من المُسلِّي التّحديق بالأرض هكذا

56
00:06:31,470 --> 00:06:32,700
أيّتها الآنسة الصّغيرة؟

57
00:06:33,530 --> 00:06:35,200
حينئذ حدثَ ذلك

58
00:06:35,200 --> 00:06:38,090
حينئذ التقيتُ بمجموعة التجّار المُتنقّلين تلك

59
00:06:39,320 --> 00:06:41,860
تبدين وكأنّكِ تمرّين بفترة عصيبة

60
00:06:41,860 --> 00:06:44,710
.هذه العربة مُتوجِّهة إلى البلد التّالي
أتريدين توصيلة؟

61
00:06:44,710 --> 00:06:46,530
هل أنت متأكّد من هذا يا رئيس؟

62
00:06:46,530 --> 00:06:49,620
أنت ليّنٌ جدّاً عندما يتعلّق الأمر بحسناوات مثلها

63
00:06:50,540 --> 00:06:53,190
هل هؤلاء تُجّار؟

64
00:06:51,270 --> 00:06:53,190
!هذا صحيح

65
00:06:53,770 --> 00:06:57,350
حمقى. عيني ثاقبة تجاه النّاس
أكثر ممّا تعتقدون

66
00:07:00,050 --> 00:07:04,050
حتّى تحت ضوء القمر، يتألّق ذلك
الحرير ببريق مُبهر

67
00:07:04,730 --> 00:07:06,480
إنّه من صنع فيشكولها، أليس كذلك؟

68
00:07:07,900 --> 00:07:12,230
إذاً أنتِ من العائلة الملكيّة، أو ربّما عائلة دوقيّة

69
00:07:12,230 --> 00:07:14,260
آنسة صغيرة نبيلة مثلكِ في الخارج
—في هذا الوقت المتأخِّر

70
00:07:14,260 --> 00:07:15,370
!المعذرة

71
00:07:16,520 --> 00:07:19,450
هلّا اشتريت هذا الخاتم منّي؟

72
00:07:27,520 --> 00:07:30,590
نحن لا نشتري ونبيع الأشياء

73
00:07:31,200 --> 00:07:35,260
،نحن نبحث عن بضاعة تُلهِب قلوبنا
،تُشعل نار شغفنا

74
00:07:35,260 --> 00:07:38,260
ونبيعها للنّاس المُتحمّسين مثلنا تجاهها فحسب

75
00:07:38,260 --> 00:07:43,540
،الشّاري والبائع على حدٍّ سواء يحبّان السّلع
وهذا ما يصنع الرّبح في التّجارة

76
00:07:44,580 --> 00:07:48,020
هذه هي عقيدتنا، عقيدة شركة آريا التّجاريّة

77
00:07:50,400 --> 00:07:53,550
،هذا الوجه... قلتِ لنفسكِ للتو
يبدو هذا مُسلّياً"، أليس كذلك؟"

78
00:07:53,550 --> 00:07:55,190
...أ-أنا

79
00:07:55,190 --> 00:07:58,790
وصلتْ حياتكِ إلى طريق مسدود الآن، صحيح؟

80
00:07:59,540 --> 00:08:03,080
لِمَ لا تنتهزين هذه الفُرصة لتشرعي
في طريق التّجارة؟

81
00:08:03,370 --> 00:08:07,540
أنا؟ لم أفكِّر في الأمر حتّى

82
00:08:07,540 --> 00:08:11,970
تحرّرتِ من قدركِ الخانق كزوجة وليّ عهد

83
00:08:12,450 --> 00:08:15,390
يمكنكِ الذّهاب إلى أي مكان

84
00:08:15,860 --> 00:08:17,550
أنتِ حُرّة في القيام بما تريدين

85
00:08:21,170 --> 00:08:24,220
...حُرّة... في القيام بما أريد

86
00:08:25,700 --> 00:08:27,960
لديك عين ثاقبة

87
00:08:27,960 --> 00:08:29,070
...و

88
00:08:29,390 --> 00:08:35,070
!تمتلكين حظّاً رائعاً أوصلكِ إلى قافلة لطيفة كقافلتنا

89
00:08:35,070 --> 00:08:39,080
إذا أصبحتِ تاجرة، فأعتقد بأنّ الأمور
ستغدو مثيرة للاهتمام

90
00:08:42,180 --> 00:08:43,600
ما رأيكِ؟ هل أنتِ موافقة؟

91
00:08:43,600 --> 00:08:47,080
!أجل، من فضلك! علّمني كيف أصبح تاجرة

92
00:08:48,480 --> 00:08:50,170
حياتي الأولى

93
00:08:50,720 --> 00:08:54,100
تعلّمتُ كيف أتاجر تحت جناح الرّئيس تالي

94
00:08:54,620 --> 00:08:57,690
ثمّ سلكتُ دربي الخاص كتاجرة

95
00:08:57,690 --> 00:09:02,370
سافرتُ حول العالم، سعياً نحو تحقيق حلمي
الجديد بزيارة كلّ بلد فيه

96
00:09:03,110 --> 00:09:05,820
،ثمّ ببقاء بلد واحدة في قائمتي

97
00:09:05,820 --> 00:09:08,450
...جُرِرتُ نحو حرب

98
00:09:08,840 --> 00:09:11,500
وانتهى المطاف بفقداني حياتي

99
00:09:33,410 --> 00:09:34,510
ماذا؟

100
00:09:33,610 --> 00:09:36,200
!ريشي إرماغارد فيتزنير

101
00:09:36,200 --> 00:09:39,960
أنتِ امرأةٌ مُخادِعة غير جديرة
!بأن تكوني خطيبة وليّ عهد

102
00:09:39,960 --> 00:09:44,060
!اليوم، اعتباراً من هذه اللّحظة، أفسخ خطوبتي منكِ

103
00:09:44,310 --> 00:09:47,000
وليّ العهد ديتريخ؟

104
00:09:48,990 --> 00:09:50,610
ما كلُّ هذا؟

105
00:09:51,450 --> 00:09:54,220
فستاني وخاتمي كما كانا في ذلك اليوم

106
00:09:54,890 --> 00:09:57,570
هل هذا... حلم؟

107
00:09:57,690 --> 00:10:00,820
سوف تُنفَين من هذه المملكة

108
00:10:03,560 --> 00:10:04,830
هذا مؤلم

109
00:10:05,750 --> 00:10:08,580
هل أحزنَكِ فسخ خطوبتنا إلى هذه الدّرجة؟

110
00:10:08,580 --> 00:10:09,970
...إن لم يكن هذا حلماً

111
00:10:08,800 --> 00:10:10,680
فهمت. فهمت

112
00:10:09,970 --> 00:10:11,830
!فلا أملك لحظة أدّخرها إذاً

113
00:10:11,830 --> 00:10:14,590
!قريباً، سيمنعونني من دخول القصر

114
00:10:15,140 --> 00:10:16,290
أستأذن بالانصراف

115
00:10:16,290 --> 00:10:17,840
!ماذا؟ لـ-لحظة

116
00:10:17,840 --> 00:10:19,470
ريشي؟ إلى أين أنتِ ذاهبة؟

117
00:10:19,470 --> 00:10:20,710
!اسمعيني

118
00:10:19,970 --> 00:10:22,200
!شكراً لكِ أيّتها الآلهة

119
00:10:20,710 --> 00:10:24,500
قضيتُ أسبوعاً كاملاً وأنا أفكّر في كيفيّة
!قراءة قائمة جرائمكِ

120
00:10:22,200 --> 00:10:25,950
!لا أعلم كيف، لكن مُنِحتُ فُرصة ثانية في الحياة

121
00:10:24,500 --> 00:10:26,600
!اسمعي! أنتِ! عودي إلى هنا

122
00:10:26,600 --> 00:10:29,140
...الحسرة الوحيدة الّتي أضمرتُها في تلك اللّيلة

123
00:10:29,140 --> 00:10:32,110
هي أنّني لم أستطع إحضار مزيد
من أمتعتي الشّخصيّة معي

124
00:10:32,110 --> 00:10:34,070
،لو كنتُ أمتلك رأسمالاً ابتدائيّاً أكبر كتاجرة

125
00:10:34,070 --> 00:10:36,560
لتمكّنتُ من توسيع مشروعي بسرعة أكبر

126
00:10:37,590 --> 00:10:41,950
الآن كلّ ما أحتاجه هو اللّقاء بالرّئيس تالي
!والجميع من شركة آريا التّجاريّة

127
00:10:43,480 --> 00:10:48,250
لكن عندما وصلتُ، كانت عربات
الشّركة قد عبرت سلفاً

128
00:10:48,830 --> 00:10:53,000
مستحيل. هل السّبب هو أنّني عدتُ
إلى المنزل وجمعتُ أغراضي؟

129
00:10:59,210 --> 00:11:02,990
"مجلّد "النّباتات الطبّية الغريبة المُصوّرة
...الّذي تركَتْه لي جدّتي

130
00:11:04,010 --> 00:11:06,630
بخلاف المرّة السّابقة، أملك مالاً

131
00:11:06,630 --> 00:11:09,530
في هذه الحالة، أحتاج فقط لأقرّر
ماذا يجب أن أفعل به

132
00:11:11,290 --> 00:11:15,590
،في حياتي الثّانية، بعتُ ممتلكاتي
،واستخدمتُ العائدات لعبور البحر

133
00:11:15,590 --> 00:11:17,800
واخترتُ دراسة الطبّ

134
00:11:18,560 --> 00:11:21,350
بامتلاكي معلومات حول مكان
،نموّ النّباتات الطبّية

135
00:11:23,700 --> 00:11:28,200
تمكّنتُ من تسخير الخبرة الّتي اكتسبتُها
من حياتي الأولى للخير

136
00:11:29,270 --> 00:11:31,750
ذات يوم، سافرتُ إلى مملكة في الشّمال

137
00:11:31,750 --> 00:11:34,410
وأنقذتُ أميراً مريضاً

138
00:11:35,040 --> 00:11:38,000
بشرتك تتحسّن كثيراً يا كايل

139
00:11:38,470 --> 00:11:40,300
شكراً لك يا فيتزنير

140
00:11:40,300 --> 00:11:43,510
أشعر بتحسُّن كبير اليوم لدرجة
حتّى تفاجأتُ من نفسي

141
00:11:43,510 --> 00:11:45,510
يعزو كلّ الفضل لأدويتكِ

142
00:11:45,710 --> 00:11:47,260
يسرُّني هذا

143
00:11:47,260 --> 00:11:51,790
حياتي كاختصاصيّة أعشاب كانت
مُرضية ومُجزية جدّاً

144
00:11:52,320 --> 00:11:56,020
،لكن من جديد في حياتي الثّانية
...مثلما حدث في حياتي الأولى

145
00:11:56,020 --> 00:11:59,350
أُقحِمتُ في حرب ومتُّ

146
00:12:08,690 --> 00:12:11,290
!ريشي إرماغارد فيتزنير

147
00:12:11,290 --> 00:12:15,130
أنتِ امرأةٌ مُخادِعة غير جديرة
!بأن تكوني خطيبة وليّ عهد

148
00:12:15,130 --> 00:12:18,590
—اليوم، اعتباراً من هذه اللّحظة، أفسخ خطوبتي

149
00:12:18,590 --> 00:12:19,840
أفهم وأمتثل لذلك

150
00:12:19,840 --> 00:12:21,240
!تفهمين ماذا؟

151
00:12:21,990 --> 00:12:24,800
في حياتي الثّالثة، وضعتُ نُصب
:عينَي على شيء آخر

152
00:12:24,800 --> 00:12:29,040
فرع دراسيّ تخصُّصي كنتُ قد تعلّمتُه
،في حياتي السّابقة

153
00:12:29,830 --> 00:12:32,750
وعالم عبقريّ مختصّ فيه

154
00:12:33,310 --> 00:12:37,880
بالنّسبة لي، كان الوجه المألوف لأحد
،معارفي في حياتي الثّانية

155
00:12:37,880 --> 00:12:39,760
الطبيب ميتشيل إيفان

156
00:12:40,910 --> 00:12:43,440
،مهما اعتقدتِ أنّ نظريّتكِ مثاليّة

157
00:12:43,440 --> 00:12:48,360
من خلال التّجربة المكرِّرة فقط تتمكّنين
من الوصول إلى خاتمة صحيحة

158
00:12:48,360 --> 00:12:49,830
!أجل يا طبيب

159
00:12:49,830 --> 00:12:53,150
يبدو أنّكِ تستمتعين ببحثكِ

160
00:12:53,150 --> 00:12:56,330
!إنَّ تعلُّمَ أشياء جديدة حماسيّ للغاية

161
00:12:56,330 --> 00:12:58,170
،إنّه يوسِّع آفاقي

162
00:12:58,170 --> 00:13:01,210
ويدفعني لرؤية مشاهد الأمس
!من منظور جديد تماماً

163
00:13:02,950 --> 00:13:05,080
،عقب ذلك، الطبيب الطيّب وأنا قد افترقنا

164
00:13:05,080 --> 00:13:09,100
...وبينما أستمرّ في بحثي بمفردي، من جديد

165
00:13:09,470 --> 00:13:12,390
جُرِرتُ نحو حرب ومتُّ

166
00:13:13,870 --> 00:13:17,980
من العمل كخادمة في عائلة دوق
،في حياتي الرّابعة

167
00:13:17,980 --> 00:13:21,410
إلى التنكُّر كرجل والقتال كفارس
...في حياتي السّادسة

168
00:13:21,990 --> 00:13:24,540
،في كلّ حياة، حقّقتُ إنجازاً

169
00:13:24,540 --> 00:13:26,210
واستمتعتُ بها جميعها

170
00:13:26,870 --> 00:13:27,810
...لكن

171
00:13:30,430 --> 00:13:33,050
في كلّ حياة جديدة لي، حالما
،تمضي خمس سنوات

172
00:13:33,050 --> 00:13:35,380
أموت لا محالة

173
00:13:36,250 --> 00:13:39,330
،حتّى عندما لا أموت بسبب إقحامي في الحرب

174
00:13:39,330 --> 00:13:42,180
أقضي أيّامي بانشغال شديد لدرجة
!أكاد أموت فيها من الإجهاد في العمل

175
00:13:42,630 --> 00:13:45,340
وها أنا الآن أجد نفسي أعيش حياتي
من جديد للمرّة السّابعة

176
00:13:45,650 --> 00:13:49,340
أريد أن أعيش هذه المرّة برويّة

177
00:13:49,340 --> 00:13:51,130
،والأهمّ من أي شيء

178
00:13:51,910 --> 00:13:54,750
!أقسم بأنّني سأعيش حياة طويلة هذه المرّة

179
00:13:55,820 --> 00:13:57,270
،الآن بالتّفكير في الأمر

180
00:13:57,270 --> 00:13:59,900
حتّى هذه اللّحظة، كنتُ دوماً أعبر
من خلال المدخل الرّئيسي

181
00:14:02,550 --> 00:14:06,070
—لكن بوضعي الرّاهن، سيكون هذا الطّريق أسرع

182
00:14:10,760 --> 00:14:14,190
...أنا آسفة... جدّاً

183
00:14:22,680 --> 00:14:24,550
—اندفعتِ بعجالة عند تلك الزّاوية

184
00:14:27,460 --> 00:14:29,570
!الإمبراطور آرنولد هاين

185
00:14:29,990 --> 00:14:31,590
تعرفين من أكون؟

186
00:14:32,050 --> 00:14:34,680
هذه أوّل مرّة آي فيها إلى هذه المملكة

187
00:14:37,040 --> 00:14:41,170
اسمي ريشي إرماغارد فيتزنير

188
00:14:41,930 --> 00:14:44,330
،رغم أنّ هذه أوّل مرّة نلتقي فيها

189
00:14:44,330 --> 00:14:46,690
إلّا أنّني أعترف بأنّ سمعتك تسبقك

190
00:14:46,690 --> 00:14:49,950
قبل لحظات، ناديتني بـ"الإمبراطور"، أليس كذلك؟

191
00:14:51,560 --> 00:14:56,410
والدي، الإمبراطور، لا يزال حيّاً وأنا
...لستُ أكثر من مجرّد وليّ عهد. ومع ذلك

192
00:14:56,410 --> 00:14:58,690
...في الواقع

193
00:15:01,390 --> 00:15:04,240
أعتذر بشدّة، سموّك

194
00:15:04,650 --> 00:15:09,050
بسبب ارتباكي، يبدو أنّني أسأتُ
القول وتلفّظتُ بألفاظ غير محترمة

195
00:15:09,510 --> 00:15:13,280
لكن فُسِخت خطوبتي للتو، لذلك
أنا على عجلةٍ من أمري

196
00:15:13,280 --> 00:15:15,020
يجب أن أغادر حالاً

197
00:15:17,610 --> 00:15:19,020
فسخ خطوبة؟

198
00:15:33,070 --> 00:15:34,150
انتظري

199
00:16:02,420 --> 00:16:03,470
حسناً

200
00:16:13,420 --> 00:16:15,200
هل حدث شيء؟

201
00:16:15,360 --> 00:16:17,900
أوليفر، جهّز حصاني

202
00:16:17,900 --> 00:16:19,420
أمرك

203
00:16:19,420 --> 00:16:21,200
ما الّذي تخطِّط لفعله؟

204
00:16:34,720 --> 00:16:37,850
تحمُّل هذا الجسد ضعيف جدّاً

205
00:16:37,850 --> 00:16:40,060
سأضطرّ للتدرُّب من جديد

206
00:16:41,840 --> 00:16:42,770
ماذا؟

207
00:16:45,480 --> 00:16:47,730
قضيتُ أسبوعاً وأنا أخطّط لذلك—تحفتي الفنّية

208
00:16:48,040 --> 00:16:50,270
!الأمير ديتريخ! إنّها الآنسة ريشي

209
00:16:50,270 --> 00:16:51,230
ماذا؟

210
00:16:51,230 --> 00:16:53,990
!ابتعدوا عن الطريق! دعوني أعبر

211
00:16:54,210 --> 00:16:55,890
استغرقتِ وقتكِ يا ريشي

212
00:16:55,890 --> 00:16:57,990
،لا تريدين أن تسمعي محبوبكِ

213
00:16:57,990 --> 00:17:01,250
أي أنا، يتلفّظ بمزيد من كلمات الإدانة. فهمت

214
00:17:01,250 --> 00:17:03,400
لكن لن يسير الأمر كما تشائين

215
00:17:03,400 --> 00:17:06,340
إنزال مِطرقة العدالة على امرأة شرّيرة مثلكِ

216
00:17:06,340 --> 00:17:09,250
!هو أحد واجباتي كملِك مستقبليّ لهذه البلاد

217
00:17:07,450 --> 00:17:09,250
،لم أفشل في الوصول في الوقت فحسب

218
00:17:12,510 --> 00:17:14,780
ليتني فقط وصلتُ متأخِّرة أكثر
،ممّا وصلتُ في حياتي الأولى

219
00:17:14,780 --> 00:17:17,430
لتجنّبتُ ربّما رؤية وجهه من جديد

220
00:17:15,510 --> 00:17:17,430
عمّا تهمسين؟

221
00:17:18,330 --> 00:17:19,540
كما توقّعتُ تماماً

222
00:17:20,260 --> 00:17:22,770
في الحفلة السّاهرة، تصرّفتِ
،بشكلٍ مختلف مع تصريحي

223
00:17:22,770 --> 00:17:25,570
لكن يبدو لي أنّ حزنكِ عميق جدّاً

224
00:17:25,570 --> 00:17:26,270
عفواً؟

225
00:17:26,270 --> 00:17:30,790
إنَّ فسخ خطوبتي منكِ قد أغرقكِ في اليأس
لدرجة لا تعرفين ماذا تفعلين

226
00:17:30,790 --> 00:17:33,530
صرتِ تمشين وتهيمين مفطورة القلب

227
00:17:33,530 --> 00:17:36,150
!هذا واضح بنظرة واحدة فحسب

228
00:17:36,150 --> 00:17:39,660
فستانكِ مغطّى بالوحل، ولديكِ
جروح في كلّ أنحاء جسدكِ

229
00:17:39,660 --> 00:17:42,790
لا أصدِّق أنّ الحزن من فسخ خطوبة
—قد أوصلكِ إلى هذا الحال

230
00:17:42,790 --> 00:17:44,290
هل أنت أحمق؟

231
00:17:44,290 --> 00:17:45,070
ماذا؟

232
00:17:45,070 --> 00:17:47,370
الحزن لا يوسّخ فستاناً

233
00:17:47,370 --> 00:17:51,710
والأهمّ، لستُ حزينة لأنّك فسختَ خطوبتنا

234
00:17:51,710 --> 00:17:53,250
!ما-ماذا؟

235
00:17:53,630 --> 00:17:57,130
هل صُدَّ وليّ العهد بواسطة الآنسة ريشي؟

236
00:17:57,130 --> 00:18:01,200
لكن لم تكن الآنسة ريشي من فسخ
الخطوبة، أليس كذلك؟

237
00:18:01,200 --> 00:18:05,280
رغم ذلك، يبدو وليّ العهد متأذّياً
أكثر منها بالنّسبة لي

238
00:18:06,040 --> 00:18:07,390
!معكِ حقّ

239
00:18:07,390 --> 00:18:09,350
!أنتم! كفى تقليلاً من احترامي

240
00:18:09,350 --> 00:18:10,400
!يا لوقاحتكم أنتم الفلّاحون

241
00:18:10,400 --> 00:18:15,350
أنا مسرورةٌ حقّاً لأنّني لم أقضِ أي حياة
من حيواتي مُتزوِّجة من هذا الشّخص

242
00:18:16,050 --> 00:18:20,640
سموّك، هدفك هو حماية وتقدير شعبك

243
00:18:20,640 --> 00:18:22,960
لا يجوز أن تتكلّم مثلما فعلتَ للتو

244
00:18:22,960 --> 00:18:25,310
أنتِ من عليه تصحيح سلوكه

245
00:18:25,310 --> 00:18:27,800
ألا تملكين ذرّة نيّة لطلب غفراني؟

246
00:18:27,800 --> 00:18:29,180
لا. البتّة

247
00:18:29,180 --> 00:18:32,660
في الحقيقة، أنا ممتنّة كلّ الامتنان
لك لأنّك فسخت خطوبتنا

248
00:18:32,660 --> 00:18:33,670
!ماذا؟

249
00:18:34,430 --> 00:18:37,010
!لا تضحكوا عليّ

250
00:18:37,010 --> 00:18:40,010
!هذا صحيح! أنتِ لئيمةٌ جدّاً يا آنسة ريشي

251
00:18:40,010 --> 00:18:45,060
من فضلكِ، لا تجرحي أميري العزيز
!ديتريخ أكثر ممّا جرحتِه بالفعل

252
00:18:45,060 --> 00:18:46,520
آنسة ماري؟

253
00:18:46,520 --> 00:18:50,810
ريشي، تنمّرتِ على حبيبتي ماري
وأبكيتِها، أليس كذلك؟

254
00:18:50,810 --> 00:18:52,400
!سمعتُ كلّ شيء

255
00:18:52,400 --> 00:18:57,650
هل ظننتِ أنّ امرأة مُنحرفة مثلكِ
بوسعها أن تصبح ملِكة؟

256
00:18:59,690 --> 00:19:02,160
من فضلكما، اطمئنّا

257
00:19:02,450 --> 00:19:05,510
سأطيع قرارك فيما يخصُّ فسخ خطوبتنا

258
00:19:05,950 --> 00:19:10,320
لن أكشف عن نفسي أمامكما ثانية أبداً

259
00:19:10,320 --> 00:19:11,170
!ماذا؟

260
00:19:12,190 --> 00:19:16,400
منذ كنتُ طفلة، اعتقدتُ بأنّ مركزي
كخطيبة لوليّ العهد

261
00:19:16,400 --> 00:19:18,530
كان هو ما أعطى حياتي قيمة

262
00:19:19,210 --> 00:19:20,930
لكن كنتُ مخطئة

263
00:19:21,270 --> 00:19:23,990
يمكنني إيجاد قيمتي بنفسي

264
00:19:23,990 --> 00:19:26,430
الآن بعد أن عرفتُ ذلك، لديّ كلّ ما أحتاجه

265
00:19:26,430 --> 00:19:29,020
ماذا؟ عمّاذا تتكلّمين؟

266
00:19:32,070 --> 00:19:35,710
وجودك في حياتي غير مطلوب

267
00:19:38,940 --> 00:19:40,370
!الأمير ديتريخ

268
00:19:40,880 --> 00:19:42,910
!أنتِ لئيمة جدّاً يا آنسة ريشي

269
00:19:42,910 --> 00:19:44,100
آنسة ماري

270
00:19:44,650 --> 00:19:49,300
،مهما كذبتِ من أكاذيب لإلباسي التّهم
لا أضمر أي ضغينة تجاهكِ

271
00:19:50,270 --> 00:19:53,540
زواجكِ من سموّه يصبُّ في صالح
عائلتكِ، أليس كذلك؟

272
00:19:53,540 --> 00:19:55,600
ما أدراكِ بذلك؟

273
00:19:56,220 --> 00:19:58,290
لكن من فضلكِ لا تنسي

274
00:19:58,290 --> 00:20:02,220
إذا لم يكن مستقبلكِ هو الّذي تتمنّينه
لنفسكِ، فلا جدوى من ذلك

275
00:20:02,500 --> 00:20:05,360
مستقبل أتمنّاه لنفسي؟

276
00:20:05,890 --> 00:20:10,500
،إيجاد السّعادة لعائلتكِ
...وإيجاد السّعادة لنفسكِ

277
00:20:10,500 --> 00:20:12,230
يجدر بكِ أن تتمكّني من تحقيقهما
معاً في آن واحد

278
00:20:12,660 --> 00:20:17,860
من فضلكِ عيشي حياة حيث تستطيعين
أنتِ وعائلتكِ الاستمرار في الابتسام

279
00:20:22,630 --> 00:20:25,600
والآن ستزيح مصدرُ الإزعاج نفسها بنفسها

280
00:20:26,280 --> 00:20:27,490
!آنسة ريشي

281
00:20:27,490 --> 00:20:31,370
،كلّ ما لديّ هو الملابس الّتي أرتديها
مثلما حدث معي في حياتي الأولى

282
00:20:28,130 --> 00:20:29,440
!توقّفي يا ريشي

283
00:20:29,440 --> 00:20:31,880
!يا فُرسان! اعتقلوا ريشي

284
00:20:31,370 --> 00:20:34,000
والآن، إلى أين أذهب من هنا؟

285
00:20:31,880 --> 00:20:32,890
!حاضر

286
00:20:34,000 --> 00:20:38,090
المعذرة يا آنسة ريشي، لو سمحتِ
...انتظري قليلاً فحسب

287
00:20:48,600 --> 00:20:50,950
كما توقّعتُ. يبدو أنّكِ خبيرة في السّيف

288
00:20:51,590 --> 00:20:55,080
أين تعلّمتِ مهارات السّيف هذه؟

289
00:20:55,080 --> 00:20:56,900
آرنولد هاين

290
00:20:57,950 --> 00:20:59,360
هذا سرّ

291
00:20:59,360 --> 00:21:02,510
ومهاراتي ليست ممتازة لدرجة
تستحقُّ إطراء منك

292
00:21:03,330 --> 00:21:07,340
كنتَ تتحفّظ بتلك الهجمة، أليس كذلك؟

293
00:21:09,160 --> 00:21:12,410
!من تكون؟ ابتعد عن ريشي

294
00:21:12,410 --> 00:21:14,430
!جميعكم، ابقوا حيث أنتم

295
00:21:14,430 --> 00:21:18,750
يجب علينا ألّا نستخدم العنف ضدّ
وليّ عهد غالكهاين

296
00:21:18,750 --> 00:21:21,420
!وليّ عهد غالكهاين؟

297
00:21:21,790 --> 00:21:26,410
الأمير الوحش الّذي قيلَ بأنّه أباد
فصيلاً من الفرسان بمفرده؟

298
00:21:26,410 --> 00:21:29,180
!توقّف! سوف تُقتَل أيضاً

299
00:21:29,730 --> 00:21:33,590
الأمير آرنولد، هلّا سألتُك ما الّذي
جاء بك إلى هنا؟

300
00:21:33,590 --> 00:21:37,260
أعتقد لم تشهر سيفك للتّسلية فقط

301
00:21:37,260 --> 00:21:38,190
هذا صحيح

302
00:21:39,340 --> 00:21:42,650
انتهَتْ حياتي السّادسة على يد هذا الرّجل

303
00:21:43,270 --> 00:21:46,860
ذات يوم، سوف يُشعِل حرباً
سوف تطوِّق العالمَ بأسره

304
00:21:47,490 --> 00:21:51,040
الحرب الّذي تؤدِّي إلى موتي

305
00:21:58,130 --> 00:21:58,990
ماذا؟

306
00:21:59,840 --> 00:22:02,590
ماذا تفعل؟

307
00:22:05,050 --> 00:22:07,610
أعتذر على فظاظتي المُفاجئة

308
00:22:08,620 --> 00:22:10,350
أريد أن أطلب منكِ أمراً

309
00:22:10,350 --> 00:22:11,650
...هلّا

310
00:22:13,630 --> 00:22:16,610
صنعتِ لي معروفاً وأصبحتِ زوجتي؟

311
00:22:18,310 --> 00:22:19,340
ماذا؟