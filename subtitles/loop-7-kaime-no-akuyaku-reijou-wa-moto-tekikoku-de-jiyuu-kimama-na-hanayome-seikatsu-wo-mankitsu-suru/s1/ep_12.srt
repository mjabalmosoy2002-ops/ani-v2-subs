1
00:00:07,150 --> 00:00:09,980
أريد أن أساعدكِ في رؤية
أي شيء تريدين رؤيته

2
00:00:10,990 --> 00:00:13,960
إذا كان هناك ما لا تعرفينه، فسأعلّمكِ

3
00:00:13,960 --> 00:00:18,130
لكن عندما تريدين إنجاز شيء فقط
من خلال جهودكِ، فلن أتدخّل

4
00:00:19,570 --> 00:00:21,980
أي نوع من العُلماء سوف تصبحين؟

5
00:00:21,980 --> 00:00:24,790
أتطلّع قُدماً لأكتشف ذلك

6
00:00:25,480 --> 00:00:28,420
لِمَ تعتني بي هذا الاعتناء؟

7
00:00:31,840 --> 00:00:36,710
ربّما لأنّ هذا قد يكون الشّيء الجيّد
الوحيد الّذي أستطيع فعله في حياتي

8
00:00:46,890 --> 00:00:48,040
!أستاذ

9
00:00:48,730 --> 00:00:50,310
مرحباً يا ريشي

10
00:00:54,160 --> 00:00:55,520
!تراجعي من فضلكِ

11
00:00:56,160 --> 00:00:58,190
أعلن هذا الشّخص المشبوه

12
00:00:58,190 --> 00:01:00,910
بأنّه سوف يسبّب أعمال عنف في البلدة
!على السّاعة السّادسة من مساء اليوم

13
00:01:00,910 --> 00:01:02,740
كما يقول تماماً

14
00:01:03,170 --> 00:01:07,580
وتعتقد أنّ بقيامك ذلك، سوف يسمع
الأمير آرنولد بقوّة المسحوق الأسود؟

15
00:01:09,640 --> 00:01:10,840
هذا صحيح

16
00:01:10,840 --> 00:01:14,280
إنَّ مثل هذا التصرُّف سوف يؤثّر على أشخاص
!لا صِلة لهم بهذه المسألة

17
00:01:14,280 --> 00:01:16,310
أجل، أعي ذلك

18
00:01:16,310 --> 00:01:17,220
!أستاذ

19
00:01:21,940 --> 00:01:24,170
...باعتباره شيء ابتكرتُه

20
00:01:24,690 --> 00:01:27,480
يجب أن أتحمّل مسؤوليّته

21
00:01:28,330 --> 00:01:32,860
ولو كلّف ذلك التسبُّب ببليّة لشخص آخر

22
00:01:35,510 --> 00:01:38,910
ينطبق هذا على وجودي بحدِّ ذاته

23
00:01:39,360 --> 00:01:41,320
أنا آسف يا ريشي

24
00:02:00,140 --> 00:02:04,610
إنَّ كلمات شخص مثلي... لا ينبغي
أن تؤخَذ على ظاهرها

25
00:02:06,470 --> 00:02:10,810
إنّ اتّخاذكِ تلميذة لي لم يكن
أكثر من مجرّد نزوة منّي

26
00:02:15,230 --> 00:02:16,250
!أختي

27
00:02:23,130 --> 00:02:27,080
...سألتُ الأستاذ ذات مرّة

28
00:02:27,470 --> 00:02:32,290
هل من المستحيل حقّاً لسُمٍّ
أن يحقّق السّعادة لشخص؟

29
00:02:34,460 --> 00:02:37,550
...لكن بدلاً من السُّؤال

30
00:02:38,870 --> 00:02:43,300
،أستاذ، لعلّي كنتُ تلميذتك لفترة قصيرة فقط

31
00:02:44,360 --> 00:02:47,680
...لكن يمكنني القول وكلّي يقين

32
00:02:48,980 --> 00:02:53,120
حتّى السُّمّ يستطيع تحقيق السّعادة لشخص

33
00:02:56,600 --> 00:03:00,740
،أخبرني مُعلّمي في الخيمياء ذات مرّة

34
00:03:01,280 --> 00:03:06,160
إذا فَشِلَ المرء في وضع كلّ المُتغيّرات"
"في الحسبان، فسوف تفشل التّجربة

35
00:03:07,830 --> 00:03:11,410
،مهما كان الخيميائيّ عظيماً

36
00:03:11,410 --> 00:03:14,660
لن تكون نتائجك عظيمة كما توقّعتها دوماً

37
00:03:16,180 --> 00:03:17,210
...هذا لأنّ

38
00:03:17,210 --> 00:03:22,090
كان من المستحيل بالنّسبة لك
استيعاب المُتغيّر الّذي هو أنا

39
00:03:22,760 --> 00:03:23,940
ماذا تقولين؟

40
00:03:36,020 --> 00:03:36,930
ما هذا؟

41
00:03:39,190 --> 00:03:42,990
أستاذ، الأشياء الّتي تصنعها
ليست سموماً فقط

42
00:03:43,420 --> 00:03:48,090
حتّى ولو كنتَ لا تراها سوى أشياء
،تجلب المصائب للآخرين

43
00:03:48,090 --> 00:03:51,870
إذا تغيّرَتْ طريقةُ استعمالها، تظهر
أنواع كثيرة أخرى من القيمة

44
00:04:11,640 --> 00:04:13,560
نيران مُلوَّنة؟

45
00:04:15,000 --> 00:04:17,180
انفجر المسحوقُ الأسود في السّماء؟

46
00:04:18,300 --> 00:04:19,740
ما كلّ هذا؟

47
00:04:21,210 --> 00:04:26,660
بحثتُ في السّابق عن طريقة بسيطة
للتّفريق بين أنواع المعادن

48
00:04:27,360 --> 00:04:32,950
في ذلك الوقت، أظهرَ لي شخصٌ الشّفق
...القطبيّ الجميل، فتذكّرتُ

49
00:04:33,480 --> 00:04:37,680
،عندما تُستخدَم النّار على المعدن
فإنّه يُظهِر ضوءاً جميلاً

50
00:04:39,400 --> 00:04:40,820
هذا صحيح

51
00:04:40,820 --> 00:04:44,770
عندما تُحرَق المعادن، تُخرِج
النّيران ألواناً مختلفة

52
00:04:44,770 --> 00:04:45,540
أجل

53
00:04:46,040 --> 00:04:48,810
لكن لم يكن ذلك كلّ شيء

54
00:04:49,640 --> 00:04:51,270
،برؤية جديدة

55
00:04:51,270 --> 00:04:54,890
حصلتُ على طريقة لتغيير ألوان النّار

56
00:04:56,310 --> 00:04:58,970
...أضواء صغيرة، عائمة في الظّلام

57
00:04:58,970 --> 00:05:03,550
قد تبدو كشعلات حرب، أو كأضواء يراعات

58
00:05:03,550 --> 00:05:08,320
كلّ مادّة وظاهرة تحمل أكثر من معنى واحد

59
00:05:08,650 --> 00:05:11,330
وكذلك المسحوق الأسود، وكذلك
أنت أيّها الأستاذ ميتشيل

60
00:05:11,330 --> 00:05:16,330
لا شيء وُجِدَ فقط لإنزال المصائب على الآخرين

61
00:05:17,570 --> 00:05:21,630
وخطّطتِ لكلّ هذا لجعلي أفهم ذلك؟

62
00:05:22,460 --> 00:05:24,210
لِمَ تفعلين كلّ هذا؟

63
00:05:24,670 --> 00:05:27,720
لأنّني تلميذتك

64
00:05:30,120 --> 00:05:32,650
،إذا أردتِ إنكار بحث شخص ما

65
00:05:32,650 --> 00:05:35,380
فيجب أن تُظهري نتائجَ كدليل مُضادّ

66
00:05:36,120 --> 00:05:39,020
هذا إن كنتِ خيميائيّة

67
00:05:39,580 --> 00:05:43,600
من دون إثبات، لن يغيّر الأستاذ تفكيره أبداً

68
00:05:44,400 --> 00:05:45,300
...لهذا السّبب

69
00:05:46,820 --> 00:05:50,100
سأكرّس كلّ نفسي لمحاولة إقناعك

70
00:05:50,700 --> 00:05:52,950
راقب بأمّ عينك

71
00:05:53,390 --> 00:05:55,370
...شيئاً صنعتَه بيدك

72
00:05:55,370 --> 00:05:57,770
يُظهِر قيمةً لم تكن تعلم بها

73
00:05:57,770 --> 00:05:59,070
!انظر إليها فحسب

74
00:06:04,900 --> 00:06:09,780
أعرف التّفاعلات النّاريّة وتأثير
...المسحوق الأسود، ومع ذلك

75
00:06:10,720 --> 00:06:13,260
لم أتخيّل وجود استعمال كهذا

76
00:06:45,430 --> 00:06:47,830
أنتِ مذهلة يا ريشي

77
00:06:48,250 --> 00:06:50,900
لا، أنت المذهل يا أستاذ

78
00:06:51,770 --> 00:06:56,230
أنا متأكّدةٌ بأنّ هناك أشياء أخرى ظننتَ
بأنّها ليست إلّا سموم

79
00:06:56,230 --> 00:06:58,720
لديها استعمالات رائعة أخرى

80
00:06:59,330 --> 00:07:04,880
فأساساً، أنت الخيميائيّ الأكثر
!تألُّقاً في العالم كلّه

81
00:07:11,720 --> 00:07:13,210
هكذا إذاً

82
00:07:13,970 --> 00:07:20,240
إذاً، كنتُ قادراً على صنع مصدر
شيء بهذا الجمال

83
00:07:27,720 --> 00:07:29,820
يبدو أنّها أُطلِقَتْ كلّها بأمان

84
00:07:36,490 --> 00:07:38,180
شكراً لك

85
00:07:38,180 --> 00:07:40,580
كان عملاً مُجهِداً حقّاً

86
00:07:41,780 --> 00:07:44,350
هلّا أعطيت هذا للجميع لأجلي؟

87
00:07:44,910 --> 00:07:47,020
هذا؟ ما هو؟

88
00:07:47,480 --> 00:07:49,900
...كمّية المسحوق الأسود ومكان إعداده

89
00:07:49,900 --> 00:07:53,250
،لأنّني رأيتُ مُخطِّطَ تجاربه في حياتي الثّالثة

90
00:07:53,250 --> 00:07:56,260
استطعتُ تقليص الاحتمالات حتّى
في هذه المدينة العاصمة الكبيرة

91
00:07:57,240 --> 00:07:59,580
،عقب ذلك، تناولتُ مجال نشاط الأستاذ

92
00:07:59,580 --> 00:08:02,800
وبحثتُ عن أماكن تستوفي الشّروط الصّحيحة

93
00:08:03,740 --> 00:08:09,870
والباقي كان يعزو لأداء جميع المعنيّين
في هذه المسألة عملهم بصورة مثاليّة

94
00:08:11,480 --> 00:08:14,900
خدمُ سموّك استثنائيّون حقّاً، أليس كذلك؟

95
00:08:19,330 --> 00:08:21,010
سيّد لوفاين؟

96
00:08:21,990 --> 00:08:23,620
كما أمرت

97
00:08:23,620 --> 00:08:24,590
أحسنت عملاً

98
00:08:25,140 --> 00:08:26,440
ميتشيل هيفان

99
00:08:26,440 --> 00:08:29,320
عليك أن تفسّر هذه الحادثة

100
00:08:29,320 --> 00:08:31,160
!انتظر يا لوفاين

101
00:08:31,160 --> 00:08:33,570
سأتولّى مسؤوليّة هذا الشّخص

102
00:08:33,570 --> 00:08:34,870
لا أستطيع السّماح بذلك

103
00:08:34,870 --> 00:08:35,820
ماذا؟

104
00:08:35,820 --> 00:08:39,020
،صرّح هذا الشّخص بأنّه سيُسبّب حادثة هنا

105
00:08:39,020 --> 00:08:41,730
في أرض يحكمها جلالته، الإمبراطور

106
00:08:41,730 --> 00:08:44,940
،رغم أنّ الأمر صدر عنك يا سموّ الأمير تيودور

107
00:08:44,940 --> 00:08:47,460
إلّا أنّني لا أستطيع تسليمه لك

108
00:08:55,250 --> 00:08:57,630
ما هذه الجلبة يا لوفاين؟

109
00:08:59,550 --> 00:09:01,040
سموّ الأمير آرنولد

110
00:09:02,260 --> 00:09:05,640
تلقّيتُ تقريراً عن شخص يطلق تصريحات شائنة

111
00:09:05,640 --> 00:09:09,900
معتقداً بأنّه ذو صلة بالنّيران الهائلة
،الّتي شوهدت في الجوّ قبل قليل

112
00:09:09,900 --> 00:09:12,800
قبضتُ عليه وأنوي استجوابه

113
00:09:13,240 --> 00:09:14,780
هكذا إذاً

114
00:09:14,780 --> 00:09:16,540
—الأمير آرنولد، قبل قليل، أولئك

115
00:09:16,540 --> 00:09:17,390
ريشي

116
00:09:17,910 --> 00:09:19,280
لا ضرورة لهذا

117
00:09:22,590 --> 00:09:24,040
...تلك الظّاهرة للتو

118
00:09:24,040 --> 00:09:28,170
لم تكن أكثر من مجرّد استعراض عالِم
من كويولو لتقنيّة جديدة

119
00:09:40,280 --> 00:09:44,470
ستنشئ إمبراطوريّتنا شراكة تكنولوجيّة مع كويولو

120
00:10:00,490 --> 00:10:03,190
،مقابل توفير التّوجيه العسكريّ لكويولو

121
00:10:03,190 --> 00:10:07,830
سوف نستعير تقنيّات الآلات الدّقيقة
خاصّتهم ومعرفتهم الأكاديميّة

122
00:10:07,830 --> 00:10:09,800
...زهور النّار الّتي رأيناها قبل قليل

123
00:10:09,800 --> 00:10:14,250
كانت برهاناً على أنّ كويولو تمتلك
تقنيّات تجهلها إمبراطوريّتنا

124
00:10:15,130 --> 00:10:16,460
هل تفهم؟

125
00:10:19,700 --> 00:10:20,760
انصرف

126
00:10:21,350 --> 00:10:22,180
حاضر

127
00:10:23,120 --> 00:10:24,470
سيّد لوفاين

128
00:10:25,140 --> 00:10:29,140
أعتذر على إخفاء هويّتي طوال هذا الوقت

129
00:10:35,200 --> 00:10:36,280
!ميتشيل

130
00:10:36,280 --> 00:10:40,450
أنا سعيدٌ لمساهمتك في تشكيل هذا
!الحلف، لكن هذا فاجأني تماماً

131
00:10:40,450 --> 00:10:41,340
كايل

132
00:10:44,880 --> 00:10:48,200
فلا بدّ من وجود طُرُق لا تسبّب
المتاعب للآخرين هكذا

133
00:10:48,200 --> 00:10:49,310
أنت مخطئ

134
00:10:49,870 --> 00:10:51,790
—حقيقة أنّ الأرواح كانت

135
00:10:51,790 --> 00:10:53,150
أستاذ ميتشيل

136
00:10:53,580 --> 00:10:56,710
حاليّاً، لا تتكلّم واتركه غاضباً
منك فحسب من فضلك

137
00:11:01,430 --> 00:11:03,470
أنا آسف يا كايل

138
00:11:03,470 --> 00:11:05,280
أنا آسف يا ريشي

139
00:11:05,770 --> 00:11:06,580
ميتشيل؟

140
00:11:07,310 --> 00:11:08,720
لن أفعلها بعد الآن

141
00:11:09,400 --> 00:11:12,520
كانت نظريّتي مليئة بالعيوب

142
00:11:12,520 --> 00:11:13,900
فهمتُ هذا الآن

143
00:11:16,620 --> 00:11:19,400
أعِدكما بأنّني لن أكرّرها

144
00:11:22,150 --> 00:11:24,640
حسناً، سوف أقوم بالتّرتيبات المناسبة

145
00:11:31,480 --> 00:11:34,920
اسمحي لي بقول هذا، أنا لا أتصرّف
من باب اللّطف تجاههما

146
00:11:35,320 --> 00:11:38,920
من الواضح وضوح الشّمس بأنّه
كان يخطّط لشيء بغيض

147
00:11:39,180 --> 00:11:42,360
،لكن إذا تمَّ التّعامل معه كمُجرم علناً

148
00:11:42,360 --> 00:11:44,380
فسوف يسمع أبي، الإمبراطور، بذلك

149
00:11:44,380 --> 00:11:46,950
لهذا استفدتُ من خطّتك

150
00:11:46,950 --> 00:11:49,460
أجل. شكراً لك

151
00:11:49,940 --> 00:11:53,500
،بعد أن أشرح التّفاصيل المُتعلّقة بالأستاذ

152
00:11:53,500 --> 00:11:55,380
أتطلّع قُدماً لحكمك حول المسألة

153
00:11:56,130 --> 00:11:57,690
كم أنتِ جديرة بالثّناء

154
00:11:57,690 --> 00:12:00,640
،لو اخترتُ قتله والتخلّص منه سرّاً

155
00:12:00,640 --> 00:12:03,200
فلن أسمع شكوى منكِ

156
00:12:07,620 --> 00:12:09,200
الأمير آرنولد

157
00:12:11,050 --> 00:12:12,200
نعم؟

158
00:12:13,130 --> 00:12:18,090
الحقيقة هي أنّ الشّخص الّذي اخترع
ساعة الجيب كان الأستاذ ميتشيل

159
00:12:21,860 --> 00:12:24,610
،إذا كنّا سنجري بحثاً مُشتركاً مع كويولو

160
00:12:24,610 --> 00:12:28,350
ألن تكون معرفة الأستاذ ميتشيل مطلوبة؟

161
00:12:30,350 --> 00:12:31,830
ماذا ستفعل؟

162
00:12:32,350 --> 00:12:33,720
...أنتِ

163
00:12:36,110 --> 00:12:38,310
كيفما نظرتُ إلى الأمر، كنتِ واثقة

164
00:12:38,310 --> 00:12:40,730
بأنّكِ تستطيعين إقناعي منذ البداية

165
00:12:40,730 --> 00:12:42,120
كيف لي أن أكون كذلك؟

166
00:12:42,120 --> 00:12:45,080
الشّيء الوحيد الّذي كنتُ واثقة منه كان

167
00:12:45,080 --> 00:12:48,550
أنّ سموّك ستكون مهتمّاً بالأستاذ

168
00:12:50,740 --> 00:12:54,870
النّاس في البلدة سيرون تلك الألعاب النّاريّة

169
00:12:54,870 --> 00:12:57,130
،عندما يدرك النّاس بأنّها من كويولو

170
00:12:57,130 --> 00:12:59,620
فأعتقد سيؤيّدون الحلف أيضاً

171
00:13:00,430 --> 00:13:02,070
غالباً سيفعلون

172
00:13:02,070 --> 00:13:02,930
أجل

173
00:13:04,750 --> 00:13:07,440
إذاً تُدعى هذه بالألعاب النّاريّة؟

174
00:13:07,440 --> 00:13:10,050
أجل، هذا هو الاسم الّذي منحتُهم إيّاه

175
00:13:11,570 --> 00:13:16,160
أردتُك أن ترى تلك الألعاب النّاريّة، سموّك

176
00:13:18,250 --> 00:13:23,030
المسحوق الأسود المُستخدَم في الألعاب
النّاريّة هو مادّة خطيرة

177
00:13:23,030 --> 00:13:25,790
،لكن اعتماداً على طريقة استخدامه

178
00:13:25,790 --> 00:13:29,670
يمكنه أيضاً أن يخلق مشهداً جميلاً
لم يسبق أن رآه أحد

179
00:13:30,760 --> 00:13:36,090
إذا تعلّمت ذلك، فحينئذ سوف تمهّد
طريقاً لاحتمالات أكبر

180
00:13:36,600 --> 00:13:38,580
هذا هو رأيي حول الأمر

181
00:13:40,660 --> 00:13:47,780
حاليّاً، لعلّه ما زال يؤمن بأنّ كافّة
،قدراته مُكرّسة للحرب فقط

182
00:13:48,680 --> 00:13:51,490
...لكن ذات يوم، أنا متيقّنة

183
00:13:56,920 --> 00:14:01,650
هذا الدّواء سيخفّف من دُوار البحر
في رحلة عودتك إلى الدّيار

184
00:14:01,650 --> 00:14:04,100
لكن النّكهة سيّئة كالمعتاد

185
00:14:04,100 --> 00:14:07,780
مُقارنة بمُعاناة دُوار البحر، فهذا بسيط

186
00:14:09,230 --> 00:14:10,290
سموّكِ ريشي

187
00:14:11,320 --> 00:14:13,230
شكراً جزيلاً لكِ من القلب

188
00:14:13,680 --> 00:14:16,200
لأنّكِ مددتِنا بدعمكِ

189
00:14:16,200 --> 00:14:19,670
شكّلَ الأمير آرنولد حلفاً مع مملكتنا

190
00:14:19,670 --> 00:14:25,170
لا، كان الفضل يعزو لقدرات كويولو التّكنولوجيّة
ودعم البحث الأكاديميّ

191
00:14:25,170 --> 00:14:28,920
هذا نتاج سعيك لبذل قصارى
جهدك يا سموّ الأمير كايل

192
00:14:34,580 --> 00:14:37,680
أعتقد بأنّ زوجكِ كريم زيادة عن اللّزوم

193
00:14:38,290 --> 00:14:39,940
إطلاقاً يا أستاذ

194
00:14:39,940 --> 00:14:42,160
،يقول لك أنّ في هذه المشروع المُشترك

195
00:14:42,160 --> 00:14:45,690
يجدر بك أن تستمرّ في تحقيق أفضل النّتائج

196
00:14:45,690 --> 00:14:49,760
إنّها عقوبة شديدة ما كان الشّخص
العاديّ ليتمكّن من تحمّلها

197
00:14:49,760 --> 00:14:52,770
أجل، أفترض ذلك

198
00:14:54,260 --> 00:14:57,380
"صنع أشياء تجعل العالم أكثر روعة"

199
00:14:57,380 --> 00:15:00,980
لم أجرِ أي بحث في هذا الصّدد من قبل

200
00:15:02,800 --> 00:15:03,970
لكن سأبذل قصارى جهدي

201
00:15:09,000 --> 00:15:10,900
أردتُ الاعتذار منكِ

202
00:15:12,270 --> 00:15:16,750
كنتُ مخطئاً عندما قلتُ بأنّكِ لم تكوني
مناسبة لأن تكوني إمبراطورة

203
00:15:17,220 --> 00:15:19,260
أنتِ مناسبة وأكثر لذلك

204
00:15:20,870 --> 00:15:24,070
لكن أرى هذه خسارة بالفعل

205
00:15:25,660 --> 00:15:27,350
لن تندمي على ذلك؟

206
00:15:27,350 --> 00:15:30,610
حياة كعروس لآرنولد هاين

207
00:15:31,000 --> 00:15:36,670
حاليّاً، أكثر ما أريده هو أن أتعرّف أكثر
على الرّجل الّذي سوف يصبح زوجي

208
00:15:36,670 --> 00:15:40,000
أريد أن أعرفه أكثر من رغبتي في معرفة
نتيجة بحث أو نظريّة

209
00:15:42,020 --> 00:15:44,380
سنفترق لبعض الوقت

210
00:15:45,530 --> 00:15:48,960
لنلتقِ ثانية يا تلميذتي

211
00:15:51,480 --> 00:15:52,340
!حسناً

212
00:15:58,230 --> 00:16:01,100
اندهشَ الأستاذ ميتشيل

213
00:16:01,100 --> 00:16:03,560
"قال بأنّ الأمير آرنولد "كريم زيادة عن اللّزوم

214
00:16:06,410 --> 00:16:09,380
عوضاً عن إحداث جلبة على شيء
،انتهى بالفشل

215
00:16:09,380 --> 00:16:12,860
.الاستفادة منه تصرّف منطقيّ أكثر
هذا كلّ ما في الأمر

216
00:16:13,400 --> 00:16:14,930
شكراً لك

217
00:16:23,420 --> 00:16:26,500
لديّ شيء آخر أبلغ عنه

218
00:16:31,760 --> 00:16:33,040
انتهت؟

219
00:16:33,040 --> 00:16:33,950
أجل

220
00:16:34,760 --> 00:16:37,700
،أردتُ رؤية القطعة المنتهية معك، سموّك

221
00:16:37,700 --> 00:16:39,460
لذا لم أفتحها بعد

222
00:16:39,960 --> 00:16:41,390
أنا متأكّدة بأنّها جميلة

223
00:16:40,510 --> 00:16:41,390
ريشي

224
00:16:43,060 --> 00:16:45,770
لا ضرورة أن تُريني بأنّكِ سترتدين هذا الخاتم

225
00:16:51,070 --> 00:16:53,780
...تقصد بذلك

226
00:16:53,780 --> 00:16:55,320
أخبرتُك

227
00:16:55,320 --> 00:17:00,560
الشّيء الوحيد الّذي طلبتُه منكِ كان
هو السّماح لي بأن أقدّم لكِ خاتماً

228
00:17:03,480 --> 00:17:08,290
لا يحقّ لي أن أتمنّى أكثر من ذلك

229
00:17:10,290 --> 00:17:12,690
،لعلّكِ سمحتِ لي بأن أهديكِ إيّاه

230
00:17:12,690 --> 00:17:15,800
لكن لستِ بحاجة لارتداء شيء
لا يتوافق مع معاييركِ

231
00:17:16,280 --> 00:17:19,400
،ينبغي أن ترتدي ما يُعجبكِ فحسب

232
00:17:19,400 --> 00:17:21,310
دون اعتبار لنظرات الآخرين

233
00:17:21,310 --> 00:17:22,800
اختاري بحرّية

234
00:17:28,520 --> 00:17:29,310
لا

235
00:17:30,000 --> 00:17:31,070
ماذا؟

236
00:17:31,500 --> 00:17:33,400
،عندما كانوا يسجّلون قياسي

237
00:17:33,400 --> 00:17:36,400
اخترتُ الإصبع الثّالث في يدي
اليسرى، أليس كذلك؟

238
00:17:36,910 --> 00:17:37,960
أجل

239
00:17:37,960 --> 00:17:43,980
في بلدي، عندما يتزوّج النّاس، يضع
الزّوجُ خاتماً على الإصبع الثّالثة للزّوجة

240
00:17:47,000 --> 00:17:51,590
أتوق لتجربة مثل هذه الطّقوس

241
00:17:54,460 --> 00:17:57,070
،أريد ارتداء هذا الخاتم لمراسم الزواج

242
00:17:57,070 --> 00:17:59,220
!وسأختار فُستاني بما يتوافق مع ذلك

243
00:17:59,220 --> 00:18:01,320
،تقول بأنّ لا ضرورة لذلك

244
00:18:01,320 --> 00:18:04,100
!لكن سأرتدي هذا الخاتم في كلّ مكان

245
00:18:04,100 --> 00:18:04,720
ريشي

246
00:18:04,720 --> 00:18:09,230
على العكس، كنتُ أكبح نفسي
من ارتدائه بشكل فوريّ

247
00:18:10,220 --> 00:18:14,320
لذا يا سموّ الأمير آرنولد، من فضلك
ضعه على إصبعي

248
00:18:14,320 --> 00:18:16,660
لن أرتدي قفّازاً الآن

249
00:18:19,990 --> 00:18:23,030
لا مشكلة، حتّى من دونه

250
00:18:27,200 --> 00:18:30,180
أريد أن يحدث ذلك حالاً

251
00:18:30,710 --> 00:18:31,660
...لذا

252
00:18:33,230 --> 00:18:35,070
أرجوك، سموّك

253
00:19:13,390 --> 00:19:14,380
ريشي

254
00:19:19,990 --> 00:19:21,340
هل يمكنني لمسكِ؟

255
00:19:27,390 --> 00:19:28,270
أجل

256
00:19:34,740 --> 00:19:36,960
لا تحبسي أنفسكِ

257
00:19:36,960 --> 00:19:38,730
!أنا لا أحبس أنفاسي

258
00:19:39,500 --> 00:19:42,400
نسيتُ كيف أتنفّس فحسب، هذا كلّ شيء

259
00:19:43,780 --> 00:19:44,980
!لقد ضَحِك

260
00:20:05,560 --> 00:20:07,830
هل تذكّرتِ كيف تتنفّسين؟

261
00:20:07,830 --> 00:20:09,420
أجل، بشكل ما

262
00:20:19,280 --> 00:20:20,280
ريشي

263
00:20:24,020 --> 00:20:25,060
تمّ الأمر

264
00:20:36,330 --> 00:20:40,440
إنّه حقّاً بنفس لون عينَي سموّك

265
00:20:41,920 --> 00:20:46,010
مجرّد ارتداء هذا الخاتم يُشعرني
وكأنّني أستطيع إنجاز أيّ شيء

266
00:20:49,760 --> 00:20:51,700
ما رأيك؟

267
00:20:52,440 --> 00:20:53,170
أجل

268
00:21:00,360 --> 00:21:03,570
يجعل مزاجي أفضل ممّا أتخيّل

269
00:21:08,760 --> 00:21:09,930
...سموّك

270
00:21:09,930 --> 00:21:10,780
ما الأمر؟

271
00:21:11,490 --> 00:21:14,990
عدد الأشياء الّتي أريد أن أطلبها منك قد زادت

272
00:21:14,990 --> 00:21:18,460
أخبريني. الآن سوف ألبّي لكِ أيّ شيء

273
00:21:20,890 --> 00:21:23,380
أريد أن أخوض رحلة معك، سموّك

274
00:21:23,380 --> 00:21:24,390
رحلة؟

275
00:21:24,390 --> 00:21:29,340
أجل. رحلة لرؤية كلّ الأشياء الجميلة
في هذا العالم

276
00:21:29,340 --> 00:21:31,760
...ليس مجرّد يراعات وألعاب ناريّة

277
00:21:31,760 --> 00:21:38,440
أريد الذّهاب والبحث عن أشياء أكثر
تعتقد بأنّها جميلة ورائعة

278
00:21:39,500 --> 00:21:42,480
بفضلكِ، عثرتُ على شيء إضافيّ
من تلك الأشياء

279
00:21:42,480 --> 00:21:43,080
ماذا؟

280
00:21:43,550 --> 00:21:45,110
ما قد يكون؟

281
00:21:46,530 --> 00:21:47,510
ما هو بالفعل؟

282
00:21:47,990 --> 00:21:51,690
إن كنتِ لا تعلمين، فلن أخبركِ

283
00:21:51,690 --> 00:21:53,160
!هـ-هذا ليس عدلاً

284
00:21:53,160 --> 00:21:56,080
هل تعتقد حقّاً بأنّ الشّخص العاديّ يستطيع
حلّ أحجية من أحجياتك؟

285
00:21:56,080 --> 00:21:58,730
الشّخص العاديّ لا يفجّر

286
00:21:58,730 --> 00:22:01,900
مُركَّباً غامضاً في السّماء فوق منزل خطيبه

287
00:22:10,570 --> 00:22:15,140
لكن لا أعتقد بأنّ هذه الأحجية صعبة الحلّ

288
00:22:23,040 --> 00:22:25,770
...حاليّاً، قد لا تكون أكثر من مجرّد تغييرات طفيفة

289
00:22:26,680 --> 00:22:31,470
لكن عندما تتراكم بعضها فوق بعض، شيئاً
فشيئاً ينبغي للمستقبل أن يتغيّر أيضاً

290
00:22:32,600 --> 00:22:37,500
آمل أن أرى مستقبلاً مشرقاً مع الأمير آرنولد

291
00:22:39,970 --> 00:22:45,030
في هذه الحياة، هذا هو الهدف
النّبيل الّذي وجدتُه لنفسي